open Set
noncomputable section

theorem score_on_piece {p : Piece} (hp : p∈pieces) {x : ℝ} (hx : x∈Icc (p.lo:ℝ) p.hi) :
    score x=p.value x :=
  select_mem data_chain _ Knot.y start_value end_value hp hx

theorem primitive_on_piece {p : Piece} (hp : p∈pieces) {x : ℝ} (hx : x∈Icc (p.lo:ℝ) p.hi) :
    primitive x=p.primitiveValue x :=
  select_mem data_chain _ Knot.j start_primitive end_primitive hp hx

theorem score_continuous : ContinuousOn score (Icc 0 1) := by
  simpa [score,startKnot,endKnot] using data_chain.continuous_score

theorem score_antitone : AntitoneOn score (Icc 0 1) := by
  have hm := data_chain.antitone_scoreOn 0 0 (by
    intro p hp
    have hh := p.antitone_score (data_valid p hp)
    simpa using hh.mono (Icc_subset_Icc_left (le_max_right _ _)))
  simpa [score,startKnot,endKnot] using hm

theorem score_central {x : ℝ} (hx : x∈Icc rc zdep) : score x=lam-x := by
  obtain ⟨hl,hr,hc⟩ := central_data
  have hx' : x∈Icc (centralPiece.lo:ℝ) centralPiece.hi := by simpa [hl,hr,rc,zdep] using hx
  rw [score_on_piece central_mem hx',centralPiece.linear_value (by rwa [hl])]

theorem J_score {x : ℝ} (hx : x∈Icc 0 1) : J score x=primitive x := by
  have h := data_chain.integral_score (x:=x) (by simpa [startKnot,endKnot] using hx)
  simpa [J,score,primitive,startKnot,endKnot] using h

theorem score_add_antitone : AntitoneOn (fun x => score x + x) (Icc lam 1) := by
  have hm := data_chain.antitone_scoreOn lam 1 (by
    intro p hp
    rcases (data_valid p hp).2.2 with ⟨hr,_,_⟩|⟨_,_,hc⟩|⟨_,hd,_⟩
    · intro x hx y hy _
      have hrl : rc < lam := by norm_num [rc,rcQ,lam,lamQ]
      have HH : (p.hi:ℝ) ≤ rc := by unfold rc; exact_mod_cast hr
      exact False.elim (hrl.not_ge ((le_max_left _ _).trans (hx.1.trans (hx.2.trans HH))))
    · simp only [one_mul,p.linear_value hc,sub_add_cancel]
      exact antitoneOn_const
    · simpa using (p.antitone_score_add hd).mono (Icc_subset_Icc_left (le_max_right _ _)))
  simpa [score,startKnot,endKnot,show (0:ℝ) ≤ lam by norm_num [lam,lamQ],max_eq_left] using hm

theorem score_isScoreFunction : IsScoreFunction lam score := by
  refine ⟨by norm_num [lam,lamQ],score_continuous,score_antitone,?_,?_,?_,?_⟩
  · change J score 1 = 0
    rw [J_score (by norm_num)]
    have h := data_chain.select_end_primitive
    simpa [primitive,endKnot] using h
  · simpa [score,endKnot] using data_chain.select_end_score
  · intro x hx
    have hbounds : (0:ℝ) ≤ rc ∧ rc < lam ∧ lam < zdep ∧ zdep ≤ 1 := by
      norm_num [lam,lamQ,rc,rcQ,zdep,zdepQ]
    by_cases hrc : rc ≤ x
    · rw [score_central ⟨hrc,hx.2.le.trans hbounds.2.2.1.le⟩]; linarith [hx.2]
    · have hh := score_antitone ⟨hx.1,hx.2.le.trans (hbounds.2.2.1.le.trans hbounds.2.2.2)⟩
          ⟨hbounds.1,hbounds.2.1.le.trans (hbounds.2.2.1.le.trans hbounds.2.2.2)⟩ (le_of_not_ge hrc)
      rw [score_central ⟨le_rfl,hbounds.2.1.le.trans hbounds.2.2.1.le⟩] at hh
      linarith [hbounds.2.1]
  · intro x hx
    obtain ⟨p,hp,hx'⟩ := data_chain.exists_piece (x:=x) (by simpa [startKnot] using hx.1)
      (by simpa [endKnot] using hx.2) data_nonempty
    rw [score_on_piece hp hx']
    exact p.ceiling (data_valid p hp) hx'

end
end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperBox

/-- Exact rational endpoints for all interval replays. -/
structure Bounds where
  lo : ℚ
  hi : ℚ
deriving DecidableEq, Repr

namespace Bounds
def Holds (i : Bounds) (x : ℝ) : Prop := (i.lo:ℝ) ≤ x ∧ x ≤ (i.hi:ℝ)

def point (q : ℚ) : Bounds := ⟨q,q⟩
def plus (i j : Bounds) : Bounds := ⟨i.lo+j.lo,i.hi+j.hi⟩
def neg (i : Bounds) : Bounds := ⟨-i.hi,-i.lo⟩
def minus (i j : Bounds) : Bounds := i.plus j.neg
def hull (i j : Bounds) : Bounds := ⟨min i.lo j.lo,max i.hi j.hi⟩
def meet (i j : Bounds) : Bounds := ⟨max i.lo j.lo,min i.hi j.hi⟩
def times (i j : Bounds) : Bounds :=
  ⟨min (min (i.lo*j.lo) (i.hi*j.lo)) (min (i.lo*j.hi) (i.hi*j.hi)),
   max (max (i.lo*j.lo) (i.hi*j.lo)) (max (i.lo*j.hi) (i.hi*j.hi))⟩
def reciprocal (i : Bounds) : Bounds := ⟨i.hi⁻¹,i.lo⁻¹⟩
def posPart (i : Bounds) : Bounds := ⟨max i.lo 0,max i.hi 0⟩

theorem point_holds (q : ℚ) : (point q).Holds (q:ℝ) := ⟨le_rfl,le_rfl⟩
theorem plus_holds {i j : Bounds} {x y : ℝ} (hx : i.Holds x) (hy : j.Holds y) :
    (i.plus j).Holds (x+y) := by
  simpa only [Holds, plus, Rat.cast_add] using And.intro (add_le_add hx.1 hy.1) (add_le_add hx.2 hy.2)
theorem neg_holds {i : Bounds} {x : ℝ} (hx : i.Holds x) : i.neg.Holds (-x) := by
  simpa only [Holds, neg, Rat.cast_neg] using And.intro (neg_le_neg hx.2) (neg_le_neg hx.1)
theorem minus_holds {i j : Bounds} {x y : ℝ} (hx : i.Holds x) (hy : j.Holds y) :
    (i.minus j).Holds (x-y) := plus_holds hx (neg_holds hy)
theorem hull_left (i j : Bounds) {x : ℝ} (h : i.Holds x) : (i.hull j).Holds x := by
  simp only [Holds,hull,Rat.cast_min,Rat.cast_max]
  exact ⟨(min_le_left _ _).trans h.1, h.2.trans (le_max_left _ _)⟩
theorem hull_right (i j : Bounds) {x : ℝ} (h : j.Holds x) : (i.hull j).Holds x := by
  simpa only [hull,min_comm,max_comm] using hull_left j i h
theorem meet_holds {i j : Bounds} {x : ℝ} (h : i.Holds x) (h' : j.Holds x) :
    (i.meet j).Holds x := by
  simp only [Holds,meet,Rat.cast_min,Rat.cast_max]
  exact ⟨max_le h.1 h'.1, le_min h.2 h'.2⟩

private theorem upper_mul {l u x t k : ℝ} (h : l ≤ x ∧ x ≤ u)
    (hl : l*t ≤ k) (hu : u*t ≤ k) : x*t ≤ k := by
  rcases le_total 0 t with ht|ht
  · exact (mul_le_mul_of_nonneg_right h.2 ht).trans hu
  · exact (mul_le_mul_of_nonpos_right h.1 ht).trans hl

private theorem lower_mul {l u x t k : ℝ} (h : l ≤ x ∧ x ≤ u)
    (hl : k ≤ l*t) (hu : k ≤ u*t) : k ≤ x*t := by
  rcases le_total 0 t with ht|ht
  · exact hl.trans (mul_le_mul_of_nonneg_right h.1 ht)
  · exact hu.trans (mul_le_mul_of_nonpos_right h.2 ht)

theorem times_holds {i j : Bounds} {x y : ℝ} (hx : i.Holds x) (hy : j.Holds y) :
    (i.times j).Holds (x*y) := by
  simp only [Holds,times,Rat.cast_min,Rat.cast_max,Rat.cast_mul]
  constructor
  · rw [mul_comm x y]; apply lower_mul hy
    · rw [mul_comm (j.lo:ℝ) x]; apply lower_mul hx <;> exact (min_le_left _ _).trans (by first | apply min_le_left | apply min_le_right)
    · rw [mul_comm (j.hi:ℝ) x]; apply lower_mul hx <;> exact (min_le_right _ _).trans (by first | apply min_le_left | apply min_le_right)
  · rw [mul_comm x y]; apply upper_mul hy
    · rw [mul_comm]; apply upper_mul hx <;> exact (by first | apply le_max_left | apply le_max_right : _ ≤ max _ _) |>.trans (le_max_left _ _)
    · rw [mul_comm]; apply upper_mul hx <;> exact (by first | apply le_max_left | apply le_max_right : _ ≤ max _ _) |>.trans (le_max_right _ _)

theorem posPart_holds {i : Bounds} {x : ℝ} (hx : i.Holds x) :
    i.posPart.Holds (max x 0) := by
  simpa only [Holds,posPart,Rat.cast_max,Rat.cast_zero] using
    And.intro (max_le_max hx.1 (le_refl 0)) (max_le_max hx.2 (le_refl 0))

theorem reciprocal_holds {i : Bounds} {x : ℝ} (hx : i.Holds x) (hd : 0 < i.lo ∨ i.hi < 0) :
    i.reciprocal.Holds x⁻¹ := by
  simp only [Holds,reciprocal,Rat.cast_inv]
  rcases hd with hp|hn
  · have hp' : 0 < (i.lo:ℝ) := by exact_mod_cast hp
    exact ⟨inv_anti₀ (hp'.trans_le hx.1) hx.2, inv_anti₀ hp' hx.1⟩
  · have hn' : (i.hi:ℝ) < 0 := by exact_mod_cast hn
    have f {a b : ℝ} (h : a ≤ b) (hb : b < 0) : b⁻¹ ≤ a⁻¹ := by
      have := inv_anti₀ (neg_pos.mpr hb) (neg_le_neg h)
      simpa using this
    exact ⟨f hx.2 hn', f hx.1 (hx.2.trans_lt hn')⟩

/-- An exact interval extension of a polynomial in local coordinates. -/
def horner (coeff : List ℚ) (i : Bounds) : Bounds :=
  coeff.foldr (fun a acc => (point a).plus (i.times acc)) (point 0)

theorem horner_holds (coeff : List ℚ) {i : Bounds} {x : ℝ} (hx : i.Holds x) :
    (horner coeff i).Holds (coeff.foldr (fun a acc => (a:ℝ) + x * acc) 0) := by
  induction coeff with
  | nil => simpa [horner,Holds,point]
  | cons a as ih => exact plus_holds (point_holds a) (times_holds hx ih)

end Bounds
end StableVotingDistortion.PaperBox
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperBox
open Bounds Set

/-- Endpoint enclosures suffice for a decreasing curve; first clip the input to
its justified domain (dependency overestimates may give larger endpoints). -/
def decreasingRange (atPoint : ℚ → Bounds) (i : Bounds) : Bounds :=
  ⟨(atPoint i.hi).lo,(atPoint i.lo).hi⟩

theorem decreasingRange_sound {f : ℝ → ℝ} {atPoint : ℚ → Bounds} {l h : ℚ}
    (hm : AntitoneOn f (Icc (l:ℝ) h)) (vals : ∀ q, l ≤ q → q ≤ h → (atPoint q).Holds (f q))
    {i : Bounds} {x : ℝ} (hx : i.Holds x) (hd : x ∈ Icc (l:ℝ) h) :
    (decreasingRange atPoint (i.meet ⟨l,h⟩)).Holds (f x) := by
  let k := i.meet ⟨l,h⟩
  have hk : k.Holds x := meet_holds hx hd
  have hl : l ≤ k.lo := le_max_right _ _
  have hu : k.hi ≤ h := min_le_right _ _
  have hh : k.lo ≤ k.hi := by exact_mod_cast hk.1.trans hk.2
  have h₁ := vals k.lo hl (hh.trans hu)
  have h₂ := vals k.hi (hl.trans hh) hu
  have hlo : (k.lo:ℝ) ∈ Icc (l:ℝ) h := ⟨by exact_mod_cast hl,by exact_mod_cast hh.trans hu⟩
  have hhi : (k.hi:ℝ) ∈ Icc (l:ℝ) h := ⟨by exact_mod_cast hl.trans hh,by exact_mod_cast hu⟩
  exact ⟨h₂.1.trans (hm hd hhi hk.2),(hm hlo hd hk.1).trans h₁.2⟩

/-- No floating-point approximation to the location of the maximum is needed. -/
def unimodalRange (atPoint : ℚ → Bounds) (t : ℚ) (i : Bounds) : Bounds :=
  if i.hi ≤ t then ⟨(atPoint i.lo).lo,(atPoint i.hi).hi⟩
  else if t ≤ i.lo then decreasingRange atPoint i
  else ⟨min (atPoint i.lo).lo (atPoint i.hi).lo,(atPoint t).hi⟩

theorem unimodalRange_sound {f : ℝ → ℝ} {atPoint : ℚ → Bounds} {l t h : ℚ}
    (inc : MonotoneOn f (Icc (l:ℝ) t)) (dec : AntitoneOn f (Icc (t:ℝ) h))
    (vals : ∀ q, l ≤ q → q ≤ h → (atPoint q).Holds (f q))
    {i : Bounds} {x : ℝ} (hx : i.Holds x) (hd : x ∈ Icc (l:ℝ) h) :
    (unimodalRange atPoint t (i.meet ⟨l,h⟩)).Holds (f x) := by
  let k := i.meet ⟨l,h⟩
  have hk : k.Holds x := meet_holds hx hd
  have hl : l ≤ k.lo := le_max_right _ _
  have hu : k.hi ≤ h := min_le_right _ _
  have hh : k.lo ≤ k.hi := by exact_mod_cast hk.1.trans hk.2
  have v₁ := vals k.lo hl (hh.trans hu)
  have v₂ := vals k.hi (hl.trans hh) hu
  have hl' : (l:ℝ) ≤ k.lo := by exact_mod_cast hl
  have hu' : (k.hi:ℝ) ≤ h := by exact_mod_cast hu
  change (unimodalRange atPoint t k).Holds (f x)
  unfold unimodalRange
  split_ifs with below above
  · have hb : (k.hi:ℝ) ≤ t := by exact_mod_cast below
    have hx' : x∈Icc (l:ℝ) t := ⟨hd.1,hk.2.trans hb⟩
    exact ⟨v₁.1.trans (inc ⟨hl',hk.1.trans hx'.2⟩ hx' hk.1),
      (inc hx' ⟨hd.1.trans hk.2,hb⟩ hk.2).trans v₂.2⟩
  · have ha : (t:ℝ) ≤ k.lo := by exact_mod_cast above
    have hx' : x∈Icc (t:ℝ) h := ⟨ha.trans hk.1,hd.2⟩
    exact ⟨v₂.1.trans (dec hx' ⟨hx'.1.trans hk.2,hu'⟩ hk.2),
      (dec ⟨ha,hk.1.trans hd.2⟩ hx' hk.1).trans v₁.2⟩
  · have ht₁ : (k.lo:ℝ) ≤ t := by exact_mod_cast le_of_not_ge above
    have ht₂ : (t:ℝ) ≤ k.hi := by exact_mod_cast le_of_not_ge below
    have vt := vals t (by exact_mod_cast hl'.trans ht₁) (by exact_mod_cast ht₂.trans hu')
    simp only [Holds,Rat.cast_min]
    by_cases hxt : x ≤ (t:ℝ)
    · exact ⟨(min_le_left _ _).trans (v₁.1.trans (inc ⟨hl',ht₁⟩ ⟨hd.1,hxt⟩ hk.1)),
        (inc ⟨hd.1,hxt⟩ ⟨hl'.trans ht₁,le_rfl⟩ hxt).trans vt.2⟩
    · have htx := le_of_not_ge hxt
      exact ⟨(min_le_right _ _).trans (v₂.1.trans (dec ⟨htx,hd.2⟩ ⟨ht₂,hu'⟩ hk.2)),
        (dec ⟨le_rfl,ht₂.trans hu'⟩ ⟨htx,hd.2⟩ htx).trans vt.2⟩

end StableVotingDistortion.PaperBox
end

section
set_option autoImplicit true
namespace StableVotingDistortion
open Set MeasureTheory

theorem primitive_sandwich {lam : ℝ} {ϕ : ℝ → ℝ} (h : IsScoreFunction lam ϕ)
    {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ 1) :
    (b-a)*ϕ b ≤ J ϕ b - J ϕ a ∧ J ϕ b - J ϕ a ≤ (b-a)*ϕ a := by
  have hi {x y : ℝ} (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1) : IntervalIntegrable ϕ volume x y :=
    (h.continuousOn.mono (Icc_subset_Icc hx hy)).intervalIntegrable_of_Icc hxy
  have hdiff : J ϕ b - J ϕ a = ∫ r in a..b, ϕ r := by
    have hs := intervalIntegral.integral_add_adjacent_intervals (hi (le_refl 0) ha (hab.trans hb)) (hi ha hab hb)
    unfold J
    linarith
  rw [hdiff]
  have hlow := intervalIntegral.integral_mono_on hab (intervalIntegrable_const (c := ϕ b)) (hi ha hab hb)
    (fun r hr => h.antitoneOn ⟨ha.trans hr.1, hr.2.trans hb⟩ ⟨ha.trans hab, hb⟩ hr.2)
  have hhi := intervalIntegral.integral_mono_on hab (hi ha hab hb) (intervalIntegrable_const (c := ϕ a))
    (fun r hr => h.antitoneOn ⟨ha, hab.trans hb⟩ ⟨ha.trans hr.1, hr.2.trans hb⟩ hr.1)
  simpa [intervalIntegral.integral_const, smul_eq_mul] using And.intro hlow hhi

theorem eq_43_44 {lam : ℝ} {ϕ : ℝ → ℝ} (hϕ : IsScoreFunction lam ϕ) :
    (∀ p q, 0 ≤ q → q ≤ p → p ≤ 1 →
      deltaP ϕ p q ≤ p - q ∧ deltaP ϕ p q ≤ (1 - p) * ϕ q ∧ q * ϕ q ≤ J ϕ q) ∧
      ∀ p q z, 0 ≤ q → q ≤ p → p ≤ z → z ≤ 1 → KP ϕ p q z ≤ -(p - q) * ϕ z - J ϕ q := by
  have h0 : J ϕ 0 = 0 := by simp [J]
  have h1 : J ϕ 1 = 0 := hϕ.integral_eq_zero
  have hleft (r : ℝ) (hr : r ∈ Icc 0 1) := (primitive_sandwich hϕ (le_refl 0) hr.1 hr.2).1
  have hright (r : ℝ) (hr : r ∈ Icc 0 1) := primitive_sandwich hϕ hr.1 hr.2 (le_refl 1)
  simp only [h0,h1,hϕ.at_one,sub_zero,zero_sub] at hleft hright
  have hJ (r : ℝ) (hr : r ∈ Icc 0 1) : 0 ≤ J ϕ r := by
    by_cases hp : 0 ≤ ϕ r
    · exact (mul_nonneg hr.1 hp).trans (hleft r hr)
    · have := mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.mpr hr.2) (le_of_not_ge hp)
      linarith [(hright r hr).2]
  constructor
  · intro p q hq hqp hp
    let r := 1-p+q
    have hr : r ∈ Icc 0 1 := ⟨by dsimp [r]; linarith,by dsimp [r]; linarith⟩
    have hs := primitive_sandwich hϕ hq (show q≤r by dsimp [r]; linarith) hr.2
    have he : r-q=1-p := by dsimp [r]; ring
    rw [he] at hs
    change J ϕ r - J ϕ q ≤ _ ∧ J ϕ r - J ϕ q ≤ _ ∧ _
    refine ⟨?_,hs.2,hleft q ⟨hq,hqp.trans hp⟩⟩
    have hh := (hright r hr).1
    dsimp [r] at hh ⊢
    linarith [hJ q ⟨hq,hqp.trans hp⟩]
  · intro p q z hq hqp hpz hz
    have h := (primitive_sandwich hϕ (show 0≤z-p+q by linarith) (show z-p+q≤z by linarith) hz).1
    have he : z-(z-p+q)=p-q := by ring
    rw [he] at h
    unfold KP
    linarith

end StableVotingDistortion
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open Set PaperBox PaperBox.Bounds
noncomputable section

def qselect (v : Piece → ℚ → ℚ) (ending : ℚ) : List Piece → ℚ → ℚ
  | [], _ => ending
  | p::ps,x => if x≤p.hi then v p x else qselect v ending ps x

theorem cast_qselect (qv : Piece → ℚ → ℚ) (v : Piece → ℝ → ℝ)
    (h : ∀ p x, (qv p x:ℝ)=v p (x:ℝ)) (ending : ℚ) (ps : List Piece) (x : ℚ) :
    (qselect qv ending ps x : ℝ) = select v ending ps (x:ℝ) := by
  induction ps with
  | nil => rfl
  | cons p ps ih =>
    by_cases hx : x≤p.hi
    · simpa only [qselect,select,if_pos hx,if_pos (by exact_mod_cast hx : (x:ℝ)≤p.hi)] using h p x
    · simpa only [qselect,select,if_neg hx,if_neg (by exact_mod_cast hx : ¬(x:ℝ)≤p.hi)] using ih

def qscore (x : ℚ) : ℚ := qselect Piece.qvalue endKnot.y pieces x
def qprimitive (x : ℚ) : ℚ := qselect Piece.qprimitive endKnot.j pieces x

theorem qscore_exact (x : ℚ) : (qscore x:ℝ) = score x :=
  cast_qselect _ _ Piece.cast_qvalue _ _ x
theorem qprimitive_exact (x : ℚ) : (qprimitive x:ℝ)=primitive x :=
  cast_qselect _ _ Piece.cast_qprimitive _ _ x

private theorem bounds_lam : (0:ℝ)<lam ∧ lam<1 := score_isScoreFunction.lam_mem

theorem primitive_increases : MonotoneOn (J score) (Icc 0 lam) := by
  intro x hx y hy hxy
  have hh := (primitive_sandwich score_isScoreFunction hx.1 hxy (hy.2.trans bounds_lam.2.le)).1
  have hs : 0 ≤ score y := by
    rcases hy.2.lt_or_eq with hl|rfl
    · exact (score_isScoreFunction.pos _ ⟨hy.1,hl⟩).le
    · rw [score_central (x:=lam) (by norm_num [lam,lamQ,rc,rcQ,zdep,zdepQ])];simp
  linarith [mul_nonneg (sub_nonneg.mpr hxy) hs]

theorem primitive_decreases : AntitoneOn (J score) (Icc lam 1) := by
  intro x hx y hy hxy
  have hh := (primitive_sandwich score_isScoreFunction (bounds_lam.1.le.trans hx.1) hxy hy.2).2
  have hc := score_isScoreFunction.le_lam_sub x ⟨bounds_lam.1.le.trans hx.1,hx.2⟩
  have hs : score x≤0 := by linarith [hx.1]
  linarith [mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.mpr hxy) hs]

def scoreBox (i : Bounds) : Bounds :=
  decreasingRange (fun q => Bounds.point (qscore q)) (i.meet ⟨0,1⟩)
def primitiveBox (i : Bounds) : Bounds :=
  unimodalRange (fun q => Bounds.point (qprimitive q)) lamQ (i.meet ⟨0,1⟩)

theorem scoreBox_holds {i : Bounds} {x : ℝ} (hi : i.Holds x) (hx : x ∈ Icc 0 1) :
    (scoreBox i).Holds (score x) := by
  apply decreasingRange_sound (l:=0) (h:=1) (by simpa using score_antitone) _ hi (by simpa using hx)
  intro q _ _
  simp [Bounds.Holds,Bounds.point,qscore_exact]

theorem primitiveBox_holds {i : Bounds} {x : ℝ} (hi : i.Holds x) (hx : x ∈ Icc 0 1) :
    (primitiveBox i).Holds (J score x) := by
  apply unimodalRange_sound (l:=0) (t:=lamQ) (h:=1) (by simpa [lam] using primitive_increases)
    (by simpa [lam] using primitive_decreases) _ hi (by simpa using hx)
  intro q hq hq'
  have hj := J_score (x:=(q:ℝ)) (by constructor <;> exact_mod_cast ‹_›)
  simp [Bounds.Holds,Bounds.point,qprimitive_exact,hj]

end
end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperBox
open Bounds

/-- A slope certificate along one coordinate. Secants also handle clipping at a kink. -/
def Secants (f : ℝ → ℝ) (x y : ℝ) (s : Bounds) : Prop :=
  ∃ m : ℝ, s.Holds m ∧ f y-f x = m*(y-x)

theorem secant_identity (x y : ℝ) : Secants id x y (point 1) :=
  ⟨1,by simpa using point_holds 1,by simp⟩
theorem secant_const (x y k : ℝ) : Secants (fun _ => k) x y (point 0) :=
  ⟨0,by simpa using point_holds 0,by simp⟩

theorem secant_add {f g : ℝ → ℝ} {x y : ℝ} {s t : Bounds}
    (hf : Secants f x y s) (hg : Secants g x y t) :
    Secants (fun u => f u+g u) x y (s.plus t) := by
  obtain ⟨m,hm,em⟩ := hf; obtain ⟨n,hn,en⟩ := hg
  exact ⟨m+n,plus_holds hm hn,by dsimp; linear_combination em + en⟩

theorem secant_neg {f : ℝ → ℝ} {x y : ℝ} {s : Bounds} (hf : Secants f x y s) :
    Secants (fun u => -f u) x y s.neg := by
  obtain ⟨m,hm,em⟩ := hf
  exact ⟨-m,neg_holds hm,by dsimp; linear_combination -em⟩

theorem secant_mul {f g : ℝ → ℝ} {x y : ℝ} {s t a b : Bounds}
    (hf : Secants f x y s) (hg : Secants g x y t) (hy : a.Holds (f y)) (hx : b.Holds (g x)) :
    Secants (fun u => f u*g u) x y ((s.times b).plus (a.times t)) := by
  obtain ⟨m,hm,em⟩ := hf; obtain ⟨n,hn,en⟩ := hg
  refine ⟨m*g x+f y*n,plus_holds (times_holds hm hx) (times_holds hy hn),?_⟩
  dsimp; linear_combination g x * em + f y * en

theorem secant_comp {f g : ℝ → ℝ} {x y : ℝ} {s t : Bounds}
    (hf : Secants f x y s) (hg : Secants g (f x) (f y) t) :
    Secants (g ∘ f) x y (t.times s) := by
  obtain ⟨m,hm,em⟩ := hf; obtain ⟨n,hn,en⟩ := hg
  refine ⟨n*m,times_holds hn hm,?_⟩
  simp only [Function.comp_apply,en,em,mul_assoc]

/-- Every secant slope of the positive part lies between zero and one. -/
theorem clip_secants (x y : ℝ) : Secants (fun t : ℝ => max t 0) x y ⟨0,1⟩ := by
  have forward (u v : ℝ) (h : u ≤ v) :
      ∃ m : ℝ, (0 ≤ m ∧ m ≤ 1) ∧ max v 0-max u 0 = m*(v-u) := by
    by_cases hv : v ≤ 0
    · exact ⟨0,⟨le_rfl,zero_le_one⟩,by simp [max_eq_right hv,max_eq_right (h.trans hv)]⟩
    by_cases hu : 0 ≤ u
    · exact ⟨1,⟨zero_le_one,le_rfl⟩,by simp [max_eq_left hu,max_eq_left (hu.trans h)]⟩
    have hpos : 0 < v-u := by linarith
    refine ⟨v/(v-u),⟨div_nonneg (by linarith) hpos.le,(div_le_one hpos).mpr (by linarith)⟩,?_⟩
    rw [max_eq_left (by linarith : 0 ≤ v),max_eq_right (by linarith : u ≤ 0),div_mul_cancel₀ _ hpos.ne',sub_zero]
  rcases le_total x y with h|h
  · obtain ⟨m,hm,em⟩ := forward x y h
    exact ⟨m,by simpa [Holds] using hm,em⟩
  · obtain ⟨m,hm,em⟩ := forward y x h
    exact ⟨m,by simpa [Holds] using hm,by dsimp; linear_combination -em⟩

/-- Componentwise finite telescoping, with separate gradient intervals. This justifies
a second bound centered at the midpoint even when the score crosses a polynomial knot. -/
theorem centered_range {d : ℕ} (f : (Fin d → ℝ) → ℝ) (center x : Fin d → ℝ)
    (s : Fin d → Bounds) (slope : ∀ (i : Fin d) (z : Fin d → ℝ),
      (∀ k, z k = center k ∨ z k = x k) → z i = center i →
      Secants (fun t => f (Function.update z i t)) (center i) (x i) (s i)) :
    ∃ m : Fin d → ℝ, (∀ i, (s i).Holds (m i)) ∧ f x-f center = ∑ i, m i*(x i-center i) := by
  let path (j : ℕ) (k : Fin d) := if k.val < j then x k else center k
  have hpath (i : Fin d) : ∀ k, path i.val k = center k ∨ path i.val k = x k := by
    intro k; simp only [path]; split <;> simp
  have entry (i : Fin d) : path i.val i = center i := by simp [path]
  have step (i : Fin d) : Function.update (path i.val) i (x i) = path (i.val+1) := by
    funext k; by_cases hk : k=i
    · subst k; simp [path]
    · have hne : k.val ≠ i.val := fun e => hk (Fin.ext e)
      have hlt : k.val < i.val+1 ↔ k.val < i.val := by omega
      simp [path,Function.update_of_ne hk,hlt]
  have each (i : Fin d) : ∃ m : ℝ, (s i).Holds m ∧ f (path (i.val+1))-f (path i.val) = m*(x i-center i) := by
    obtain ⟨m,hm,em⟩ := slope i (path i.val) (hpath i) (entry i)
    exact ⟨m,hm,by simpa only [step,← entry i,Function.update_eq_self] using em⟩
  choose m hm he using each
  refine ⟨m,hm,?_⟩
  have first : path 0 = center := by funext k; simp [path]
  have last : path d = x := by funext k; simp [path,k.isLt]
  calc
    f x-f center = f (path d)-f (path 0) := by rw [last,first]
    _ = ∑ i : Fin d, (f (path (i.val+1))-f (path i.val)) := by
      rw [Fin.sum_univ_eq_sum_range (fun n => f (path (n+1))-f (path n))]
      exact (Finset.sum_range_sub (fun n => f (path n)) d).symm
    _ = _ := Finset.sum_congr rfl (fun i _ => he i)

end StableVotingDistortion.PaperBox
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open Set PaperBox PaperBox.Bounds

/-- A secant of the printed primitive lies between the two endpoint scores,
including across all knots of the published piecewise polynomial. -/
theorem primitive_secant {i : Bounds} {x y : ℝ} (hx : i.Holds x) (hy : i.Holds y)
    (dx : x∈Icc 0 1) (dy : y∈Icc 0 1) : Secants (J score) x y (scoreBox i) := by
  have forward {u v : ℝ} (hu : i.Holds u) (hv : i.Holds v)
      (du : u∈Icc 0 1) (dv : v∈Icc 0 1) (h : u<v) : Secants (J score) u v (scoreBox i) := by
    have hs := primitive_sandwich score_isScoreFunction du.1 h.le dv.2
    have sl := scoreBox_holds hu du
    have sr := scoreBox_holds hv dv
    have hd := sub_pos.mpr h
    let m := (J score v-J score u)/(v-u)
    refine ⟨m,⟨sr.1.trans ?_, le_trans ?_ sl.2⟩,?_⟩
    · exact (le_div_iff₀ hd).mpr (by simpa [mul_comm] using hs.1)
    · exact (div_le_iff₀ hd).mpr (by simpa [mul_comm] using hs.2)
    · exact (div_mul_cancel₀ _ hd.ne').symm
  rcases lt_trichotomy x y with h|rfl|h
  · exact forward hx hy dx dy h
  · exact ⟨score x,scoreBox_holds hx dx,by simp⟩
  · obtain ⟨m,hm,he⟩ := forward hy hx dy dx h
    exact ⟨m,hm,by linear_combination -he⟩

end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperBox
open Bounds
/-- Arithmetic syntax common to the six checker's families. Nonpolynomial atoms
are the score, its primitive, the two interpolation tables, and the clipped potential. -/
inductive Expr (d : ℕ) where
  | const (k : ℚ)
  | coord (j : Fin d)
  | add (a b : Expr d)
  | neg (a : Expr d)
  | mul (a b : Expr d)
  | inv (a : Expr d)
  | pos (a : Expr d)
  | atom (f : Fin 4) (a : Expr d)
  | potential (r y : Expr d)
deriving Repr

abbrev Box (d : ℕ) := Fin d → Bounds
def Inside {d : ℕ} (b : Box d) (x : Fin d → ℝ) : Prop := ∀ j, (b j).Holds (x j)

noncomputable def Expr.value {d : ℕ} (fs : Fin 4 → ℝ → ℝ) (pot : ℝ → ℝ → ℝ)
    (x : Fin d → ℝ) : Expr d → ℝ
  | .const k => k
  | .coord j => x j
  | .add a b => a.value fs pot x + b.value fs pot x
  | .neg a => -a.value fs pot x
  | .mul a b => a.value fs pot x * b.value fs pot x
  | .inv a => (a.value fs pot x)⁻¹
  | .pos a => max (a.value fs pot x) 0
  | .atom f a => fs f (a.value fs pot x)
  | .potential r y => pot (r.value fs pot x) (y.value fs pot x)

inductive Cover (d : ℕ) where
  | leaf
  | split (axis : Fin d) (cut : ℚ) (left right : Cover d)

def lowerBox {d : ℕ} (b : Box d) (j : Fin d) (c : ℚ) : Box d :=
  Function.update b j ⟨(b j).lo,c⟩
def upperBox {d : ℕ} (b : Box d) (j : Fin d) (c : ℚ) : Box d :=
  Function.update b j ⟨c,(b j).hi⟩

def Cover.verify {d : ℕ} (ok : Box d → Bool) (b : Box d) : Cover d → Bool
  | .leaf => ok b
  | .split j c l r => l.verify ok (lowerBox b j c) && r.verify ok (upperBox b j c)

/-- Tree verification covers all the original inputs, including points on a split. -/
theorem cover_sound {d : ℕ} {ok : Box d → Bool} {P : (Fin d → ℝ) → Prop}
    (leaf : ∀ b, ok b = true → ∀ x, Inside b x → P x) (tree : Cover d) :
    ∀ b, tree.verify ok b = true → ∀ x, Inside b x → P x := by
  induction tree with
  | leaf => exact leaf
  | split j c _ _ hl hr =>
    intro b h x hx
    obtain ⟨h₁,h₂⟩ := Bool.and_eq_true_iff.mp h
    by_cases hh : x j ≤ (c:ℝ)
    · apply hl _ h₁ x; intro k
      by_cases he : k=j
      · subst k; simpa [lowerBox,Holds] using And.intro (hx j).1 hh
      · simpa [lowerBox,Function.update_of_ne he] using hx k
    · apply hr _ h₂ x; intro k
      by_cases he : k=j
      · subst k; simpa [upperBox,Holds] using And.intro (le_of_not_ge hh) (hx j).2
      · simpa [upperBox,Function.update_of_ne he] using hx k

end StableVotingDistortion.PaperBox
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperBox
open Bounds

def clipSlope (i : Bounds) : Bounds :=
  if i.hi≤0 then point 0 else if 0 ≤ i.lo then point 1 else ⟨0,1⟩

theorem clipSlope_sound {i : Bounds} {x y : ℝ} (hx : i.Holds x) (hy : i.Holds y) :
    Secants (fun z : ℝ => max z 0) x y (clipSlope i) := by
  unfold clipSlope
  split_ifs with h0 h1
  · have hn : (i.hi:ℝ)≤0 := by exact_mod_cast h0
    refine ⟨0,by simpa using point_holds 0,?_⟩
    simp [max_eq_right (hx.2.trans hn),max_eq_right (hy.2.trans hn)]
  · have hn : (0:ℝ) ≤ i.lo := by exact_mod_cast h1
    refine ⟨1,by simpa using point_holds 1,?_⟩
    simp [max_eq_left (hn.trans hx.1),max_eq_left (hn.trans hy.1)]
  · exact clip_secants x y

end StableVotingDistortion.PaperBox
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperBox
open Bounds

def midpoint (b : Bounds) : ℚ := (b.lo+b.hi)/2

def radius (b : Bounds) : ℚ := (b.hi-b.lo)/2

theorem midpoint_inside {b : Bounds} {x : ℝ} (hx : b.Holds x) : b.Holds (midpoint b) := by
  have ho := hx.1.trans hx.2
  simp only [midpoint,Holds,Rat.cast_div,Rat.cast_add,Rat.cast_ofNat]
  constructor <;> linarith

theorem centered_deviation {b s : Bounds} {x m : ℝ} (hx : b.Holds x) (hm : s.Holds m) :
    m*(x-(midpoint b:ℝ)) ≤ (((radius b)*max (-s.lo) s.hi:ℚ):ℝ) := by
  have da : |x-(midpoint b:ℝ)| ≤ (radius b:ℝ) := by
    simp only [midpoint,radius,Rat.cast_div,Rat.cast_add,Rat.cast_sub,Rat.cast_ofNat,abs_le]
    constructor <;> linarith only [hx.1,hx.2]
  have ma : |m| ≤ ((max (-s.lo) s.hi:ℚ):ℝ) := by
    rw [Rat.cast_max,Rat.cast_neg,abs_le]
    exact ⟨(neg_le_neg (le_max_left _ _)).trans (by simpa using hm.1),hm.2.trans (le_max_right _ _)⟩
  rw [Rat.cast_mul,mul_comm (radius b:ℝ)]
  exact (le_abs_self _).trans ((abs_mul _ _).le.trans
    (mul_le_mul ma da (abs_nonneg _) ((abs_nonneg _).trans ma)))

end StableVotingDistortion.PaperBox
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open PaperBox PaperBox.Bounds Set
noncomputable section

def massE : ℚ := 1+1/20000
def baseResidual (p q : ℝ) : ℝ :=
  (massE:ℝ)*p*(J score (1-p+q)-J score q)-(lam-q)*J score p

def rankArg (b c : Bounds) : Bounds := ((point 1).minus b).plus c
def slopeP (b c : Bounds) : Bounds :=
  let x := rankArg b c
  (((point massE).times ((primitiveBox x).minus (primitiveBox c))).minus
     (((point massE).times b).times (scoreBox x))).minus (((point lamQ).minus c).times (scoreBox b))
def slopeQ (b c : Bounds) : Bounds :=
  (((point massE).times b).times ((scoreBox (rankArg b c)).minus (scoreBox c))).plus (primitiveBox b)

def validRectangle (b c : Bounds) : Prop :=
  (16/25:ℚ) ≤ b.lo ∧ b.hi ≤ (99/100:ℚ) ∧ 0 ≤ c.lo ∧ c.hi ≤ lamQ
  deriving Decidable

private theorem domains {b c : Bounds} (d : validRectangle b c)
    {p q : ℝ} (hp : b.Holds p) (hq : c.Holds q) :
    p∈Icc 0 1 ∧ q∈Icc 0 1 ∧ 1-p+q∈Icc 0 1 := by
  obtain ⟨pl,ph,ql,qh⟩ := d
  have h₁ : (16/25:ℝ) ≤ b.lo := by simpa only [Rat.cast_div,Rat.cast_ofNat] using (Rat.cast_le (K:=ℝ)).mpr pl
  have h₂ : (b.hi:ℝ) ≤ 99/100 := by simpa only [Rat.cast_div,Rat.cast_ofNat] using (Rat.cast_le (K:=ℝ)).mpr ph
  have h₃ : (0:ℝ) ≤ c.lo := by exact_mod_cast ql
  have h₄ : (c.hi:ℝ) ≤ 703/1250 := by simpa only [lamQ,Rat.cast_div,Rat.cast_ofNat] using (Rat.cast_le (K:=ℝ)).mpr qh
  exact ⟨⟨by linarith [hp.1],by linarith [hp.2]⟩,⟨by linarith [hq.1],by linarith [hq.2]⟩,
    ⟨by linarith [hp.2,hq.1],by linarith [hp.1,hq.2]⟩⟩

private theorem arg_holds {b c : Bounds} {p q : ℝ} (hp : b.Holds p) (hq : c.Holds q) :
    (rankArg b c).Holds (1-p+q) := by
  simpa only [rankArg,Rat.cast_one] using plus_holds (minus_holds (point_holds 1) hp) hq

theorem slopeP_sound {b c : Bounds} (d : validRectangle b c)
    {p t q : ℝ} (hp : b.Holds p) (ht : b.Holds t) (hq : c.Holds q) :
    Secants (fun u => baseResidual u q) p t (slopeP b c) := by
  obtain ⟨pd,qd,xd⟩ := domains d hp hq
  obtain ⟨td,_,yd⟩ := domains d ht hq
  obtain ⟨a,ha,ea⟩ := primitive_secant (arg_holds hp hq) (arg_holds ht hq) xd yd
  obtain ⟨k,hk,ek⟩ := primitive_secant hp ht pd td
  let Δ := J score (1-p+q)-J score q
  have hΔ := minus_holds (primitiveBox_holds (arg_holds hp hq) xd) (primitiveBox_holds hq qd)
  have hL : ((point lamQ).minus c).Holds (lam-q) := minus_holds (point_holds _) hq
  refine ⟨(massE:ℝ)*Δ-(massE:ℝ)*t*a-(lam-q)*k,minus_holds (minus_holds
    (times_holds (point_holds massE) hΔ) (times_holds (times_holds (point_holds massE) ht) ha))
    (times_holds hL hk),?_⟩
  dsimp [baseResidual,Δ]
  linear_combination (massE:ℝ)*t*ea-(lam-q)*ek

theorem slopeQ_sound {b c : Bounds} (d : validRectangle b c)
    {p q t : ℝ} (hp : b.Holds p) (hq : c.Holds q) (ht : c.Holds t) :
    Secants (baseResidual p) q t (slopeQ b c) := by
  obtain ⟨pd,qd,xd⟩ := domains d hp hq
  obtain ⟨_,td,yd⟩ := domains d hp ht
  obtain ⟨a,ha,ea⟩ := primitive_secant (arg_holds hp hq) (arg_holds hp ht) xd yd
  obtain ⟨k,hk,ek⟩ := primitive_secant hq ht qd td
  refine ⟨(massE:ℝ)*p*(a-k)+J score p,plus_holds
    (times_holds (times_holds (point_holds massE) hp) (minus_holds ha hk)) (primitiveBox_holds hp pd),?_⟩
  unfold baseResidual
  linear_combination (massE:ℝ)*p*(ea-ek)

def anchor (b s : Bounds) : ℚ :=
  if 0 ≤ s.lo then b.hi else if s.hi ≤ 0 then b.lo else midpoint b
def deviation (b s : Bounds) : ℚ :=
  if 0 ≤ s.lo ∨ s.hi ≤ 0 then 0 else radius b * max (-s.lo) s.hi

private theorem anchor_spec {b s : Bounds} {x m : ℝ} (hx : b.Holds x) (hm : s.Holds m) :
    b.Holds (anchor b s) ∧ m*(x-(anchor b s:ℝ)) ≤ (deviation b s:ℝ) := by
  have ord := hx.1.trans hx.2
  by_cases h : 0 ≤ s.lo
  · have h0 : (0:ℝ) ≤ s.lo := by exact_mod_cast h
    simpa [anchor,deviation,h,Holds] using And.intro (And.intro ord (le_refl (b.hi:ℝ)))
      (mul_nonpos_of_nonneg_of_nonpos (h0.trans hm.1) (sub_nonpos.mpr hx.2))
  by_cases n : s.hi ≤ 0
  · have h0 : (s.hi:ℝ) ≤ 0 := by exact_mod_cast n
    simpa [anchor,deviation,n,h,Holds] using And.intro (And.intro (le_refl (b.lo:ℝ)) ord)
      (mul_nonpos_of_nonpos_of_nonneg (hm.2.trans h0) (sub_nonneg.mpr hx.1))
  exact ⟨by simpa [anchor,h,n] using midpoint_inside hx,by simpa [anchor,deviation,h,n] using centered_deviation hx hm⟩

def qResidual (p q : ℚ) : ℚ :=
  massE*p*(qprimitive (1-p+q)-qprimitive q)-(lamQ-q)*qprimitive p

private theorem qResidual_cast {p q : ℚ} (hp : (p:ℝ)∈Icc 0 1)
    (hq : (q:ℝ)∈Icc 0 1) (hx : 1-(p:ℝ)+(q:ℝ)∈Icc 0 1) :
    (qResidual p q:ℝ)=baseResidual p q := by
  simp [qResidual,baseResidual,qprimitive_exact,← J_score hp,← J_score hq,← J_score hx,lam]

def boxAccept (b c : Bounds) : Bool :=
  let s := slopeP b c
  let t := slopeQ b c
  decide (validRectangle b c ∧ qResidual (anchor b s) (anchor c t)+deviation b s+deviation c t ≤ 0)

theorem boxAccept_sound {b c : Bounds} (yes : boxAccept b c = true) {p q : ℝ}
    (hp : b.Holds p) (hq : c.Holds q) : baseResidual p q ≤ 0 := by
  let s := slopeP b c
  let t := slopeQ b c
  let a := anchor b s
  let k := anchor c t
  have h : validRectangle b c ∧ qResidual a k+deviation b s+deviation c t ≤ 0 := of_decide_eq_true yes
  have anchor_in {i : Bounds} {x : ℝ} (hi : i.Holds x) (z : Bounds) : i.Holds (anchor i z) := by
    unfold anchor;split_ifs
    · exact ⟨hi.1.trans hi.2,le_rfl⟩
    · exact ⟨le_rfl,hi.1.trans hi.2⟩
    · exact midpoint_inside hi
  have ha : b.Holds (a:ℝ) := anchor_in hp s
  have hk : c.Holds (k:ℝ) := anchor_in hq t
  obtain ⟨m,hm,he⟩ := slopeP_sound h.1 ha hp hk
  obtain ⟨v,hv,ve⟩ := slopeQ_sound h.1 hp hk hq
  have h₁ := (anchor_spec hp hm).2
  have h₂ := (anchor_spec hq hv).2
  obtain ⟨ad,kd,xd⟩ := domains h.1 ha hk
  have top : (qResidual a k:ℝ)+(deviation b s:ℝ)+(deviation c t:ℝ) ≤ 0 := by exact_mod_cast h.2
  rw [qResidual_cast ad kd xd] at top
  dsimp only at he ve
  change m*(p-(a:ℝ)) ≤ (deviation b s:ℝ) at h₁
  change v*(q-(k:ℝ)) ≤ (deviation c t:ℝ) at h₂
  linarith only [h₁,h₂,he,ve,top]

end
end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
/-! Exact original STOC LP table. The knot abscissas use units of 1/1000, and the
two coefficient columns use units of 1/1000000. Regenerate with
`python3 generate_middle_coefficients.py` from the pinned paper certificate. -/
namespace StableVotingDistortion.PaperMiddle

set_option maxRecDepth 65536
set_option maxHeartbeats 2000000

theorem knot_count : knots.length=213 := by decide +kernel
theorem knot_order : (knots.map Knot.position).IsChain (· < ·) := by decide +kernel
theorem knot_endpoints : (knots.head!).position=60 ∧ (knots.getLast!).position=640 := by decide +kernel
theorem knot_beta_pos : ∀ t ∈ knots,0<t.beta := by decide +kernel

end StableVotingDistortion.PaperMiddle
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperBox
open Set
noncomputable section


def ratio (lam : ℝ) (φ : ℝ → ℝ) (x : ℝ) : ℝ := (lam-x)/φ x


def lowSecond (lam : ℝ) (φ : ℝ → ℝ) (β a b p q x : ℝ) : ℝ :=
  q + β * KP φ p q x + correction lam φ a b x

def highFirst (lam : ℝ) (φ : ℝ → ℝ) (β a b p q r : ℝ) : ℝ :=
  q + β * deltaP φ p q + potential lam φ r q - lam -
    max (-φ q) 0 * max (a*r+b) 0


theorem affine_parameter {lo hi x : ℝ} (hx : x ∈ Icc lo hi) :
    ∃ u ∈ Icc (0:ℝ) 1, x = lo + u * (hi-lo) := by
  rcases eq_or_lt_of_le (hx.1.trans hx.2) with h|h
  · exact ⟨0, ⟨le_rfl,zero_le_one⟩, by simpa using le_antisymm (hx.2.trans h.ge) hx.1⟩
  · have hp : 0 < hi-lo := sub_pos.mpr h
    refine ⟨(x-lo)/(hi-lo), ⟨div_nonneg (sub_nonneg.mpr hx.1) hp.le, (div_le_one hp).mpr (by linarith [hx.2])⟩, ?_⟩
    rw [div_mul_cancel₀ _ hp.ne']; ring

private theorem scaled (lam : ℝ) (φ : ℝ → ℝ) (a b x : ℝ) (h : 0 < φ x) :
    φ x * max (a * ratio lam φ x + b) 0 = correction lam φ a b x := by
  have hc : φ x * (a * ratio lam φ x + b) = a * (lam-x) + b * φ x := by
    unfold ratio
    field_simp
  simp only [mul_max_of_nonneg _ _ h.le, mul_zero, hc, correction]


structure CubeBounds (lam rc : ℝ) (φ : ℝ → ℝ) (β a b p : ℝ) : Prop where
  L1 : ∀ u ∈ Icc (0:ℝ) 1, ∀ w ∈ Icc (0:ℝ) 1,
    let q := u * min p lam
    lowFirst lam φ β a b p q (q+w*(lam-q)) ≤ 0
  L2 : p ≤ lam → ∀ u ∈ Icc (0:ℝ) 1, ∀ w ∈ Icc (0:ℝ) 1,
    lowSecond lam φ β a b p (u*p) (p+w*(lam-p)) ≤ 0
  L3 : ∀ u ∈ Icc (0:ℝ) 1, ∀ w ∈ Icc (0:ℝ) 1,
    highFirst lam φ β a b p (u*p) (ratio lam φ (w*rc)) ≤ 0
  L3id : ∀ u ∈ Icc (0:ℝ) 1, highFirst lam φ β a b p (u*p) 1 ≤ 0
  L4 : ∀ u ∈ Icc (0:ℝ) 1, ∀ v ∈ Icc (0:ℝ) 1, ∀ w ∈ Icc (0:ℝ) 1,
    highSecond lam φ β a b p (u*p) (p+v*(1-p)) (ratio lam φ (w*rc)) ≤ 0
  L4id : ∀ u ∈ Icc (0:ℝ) 1, ∀ v ∈ Icc (0:ℝ) 1,
    highSecond lam φ β a b p (u*p) (p+v*(1-p)) 1 ≤ 0


theorem cubes_imply_eq37_eq38 {lam rc p : ℝ} {φ β a b : ℝ → ℝ}
    (hpos : ∀ x ∈ Ico (0:ℝ) lam, 0 < φ x)
    (hid : ∀ x ∈ Icc rc lam, φ x = lam-x) (h : CubeBounds lam rc φ (β p) (a p) (b p) p) :
    Eq37 lam φ β (fun s => correction lam φ (a s) (b s)) p ∧
    Eq38 lam φ β (fun s => correction lam φ (a s) (b s)) p := by
  constructor
  · intro x hx
    constructor
    · intro q hq hqpx
      have hp := (le_min_iff.mp hqpx).1
      have hqx := (le_min_iff.mp hqpx).2
      obtain ⟨u,hu,eu⟩ := affine_parameter (lo:=0) (hi:=min p lam) (x:=q)
        ⟨hq,le_min hp (hqx.trans hx.2.le)⟩
      obtain ⟨w,hw,ew⟩ := affine_parameter (lo:=q) (hi:=lam) (x:=x) ⟨hqx,hx.2.le⟩
      simp only [sub_zero, zero_add] at eu
      have hh := h.L1 u hu w hw
      dsimp only at hh
      rw [← eu, ← ew] at hh
      exact sub_nonpos.mp hh
    · intro q hq hqp hpx
      obtain ⟨u,hu,eu⟩ := affine_parameter (lo:=0) (hi:=p) (x:=q) ⟨hq,hqp⟩
      obtain ⟨w,hw,ew⟩ := affine_parameter (lo:=p) (hi:=lam) (x:=x) ⟨hpx,hx.2.le⟩
      simp only [sub_zero,zero_add] at eu
      simpa only [← eu, ← ew,lowSecond] using h.L2 (hpx.trans hx.2.le) u hu w hw
  · intro x hx
    have hs := scaled lam φ (a p) (b p) x (hpos x hx)
    have hr : ∀ (F : ℝ → Prop), (∀ w ∈ Icc (0:ℝ) 1, F (ratio lam φ (w*rc))) →
        F 1 → F (ratio lam φ x) := by
      intro F ha hb
      by_cases hl : x ≤ rc
      · obtain ⟨w,hw,ew⟩ := affine_parameter (lo:=0) (hi:=rc) (x:=x) ⟨hx.1,hl⟩
        simp only [zero_add,sub_zero] at ew
        simpa only [← ew] using ha w hw
      · have he : ratio lam φ x = 1 := by
          rw [ratio,hid x ⟨le_of_not_ge hl,hx.2.le⟩,div_self (sub_pos.mpr hx.2).ne']
        simpa only [he] using hb
    have clear (v t : ℝ) (hv : v - t * max (a p * ratio lam φ x + b p) 0 ≤ 0) :
        φ x * v ≤ t * correction lam φ (a p) (b p) x := by
      calc
        _ ≤ φ x * (t * max (a p * ratio lam φ x + b p) 0) :=
          mul_le_mul_of_nonneg_left (sub_nonpos.mp hv) (hpos x hx).le
        _ = _ := by rw [← hs]; ring
    constructor
    · intro q hq hqp
      obtain ⟨u,hu,eu⟩ := affine_parameter (lo:=0) (hi:=p) (x:=q) ⟨hq,hqp⟩
      simp only [sub_zero,zero_add] at eu
      apply clear
      apply hr (fun r => highFirst lam φ (β p) (a p) (b p) p q r ≤ 0)
      · intro w hw; simpa only [← eu] using h.L3 u hu w hw
      · simpa only [← eu] using h.L3id u hu
    · intro q z hq hqp hpz hz
      obtain ⟨u,hu,eu⟩ := affine_parameter (lo:=0) (hi:=p) (x:=q) ⟨hq,hqp⟩
      obtain ⟨v,hv,ev⟩ := affine_parameter (lo:=p) (hi:=1) (x:=z) ⟨hpz,hz⟩
      simp only [sub_zero,zero_add] at eu
      apply clear
      apply hr (fun r => highSecond lam φ (β p) (a p) (b p) p q z r ≤ 0)
      · intro w hw; simpa only [← eu, ← ev] using h.L4 u hu v hv w hw
      · simpa only [← eu, ← ev] using h.L4id u hu v hv

end
end StableVotingDistortion.PaperBox
end

section
set_option autoImplicit true
/-! Literal coefficient functions of the STOC JSON. The checker visits both closed
regimes at each switch. We select the constant formula at p_a, the LP formula at
p_c, and the exact analytic endpoint formulas for masses above p_1. -/
namespace StableVotingDistortion.PaperMiddle
open Set
noncomputable section

def rc : ℝ := 4356751/12500000
def p0 : ℝ := 1/100

theorem interpolate_eq (col : Knot → ℕ) (k l : Knot) (x : ℝ)
    (hkl : rank k<rank l) (hx : x∈Icc (rank k) (rank l)) :
    interpolate col k l x=value col k+
      ((value col l-value col k)/(rank l-rank k))*(x-rank k) := by
  have hpos := sub_pos.mpr hkl
  have ht : 0≤(x-rank k)/(rank l-rank k) := div_nonneg (sub_nonneg.mpr hx.1) hpos.le
  have ho : (x-rank k)/(rank l-rank k)≤1 := (div_le_one hpos).mpr (by linarith [hx.2])
  simp only [interpolate,fraction,min_eq_right ho,max_eq_right ht]
  ring

private theorem lookup_nonneg (col : Knot → ℕ) (x : ℝ) (k : Knot) (ks : List Knot) :
    0≤lookup col x k ks := by
  induction ks generalizing k with
  | nil => dsimp [lookup,value];positivity
  | cons l tail ih =>
    rw [lookup];split_ifs
    · have h0 : 0≤fraction x (rank k) (rank l) := le_max_left _ _
      have h1 : fraction x (rank k) (rank l)≤1 := max_le zero_le_one (min_le_left _ _)
      exact add_nonneg (mul_nonneg (sub_nonneg.mpr h1) (by unfold value;positivity))
        (mul_nonneg h0 (by unfold value;positivity))
    · exact ih l

theorem entry_nonneg (col : Knot → ℕ) (p : ℝ) : 0≤entry col p := lookup_nonneg _ _ _ _


theorem lookup_cell (col : Knot → ℕ) (x : ℝ) (k : Knot) (pre post : List Knot) (l r : Knot)
    (hskip : ∀ j ∈ pre,rank j < x) (hl : rank l < x) (hr : x≤rank r) :
    lookup col x k (pre++l::r::post)=interpolate col l r x := by
  induction pre generalizing k with
  | nil => simp [lookup,not_le.mpr hl,hr]
  | cons b rest ih =>
    simp only [List.cons_append,lookup,if_neg (not_le.mpr (hskip b (by simp)))]
    exact ih b (fun j hj => hskip j (by simp [hj]))


private theorem find_cell (p : ℝ) (k l : Knot) (tail : List Knot)
    (h : (k::l::tail).IsChain (fun x y => x.position<y.position))
    (hlo : rank k≤p) (hhi : p≤rank ((k::l::tail).getLast!)) :
    ∃ c d : Knot, (c,d)∈(k::l::tail).zip (l::tail) ∧
      rank c<rank d ∧ p∈Icc (rank c) (rank d) ∧
      ∀ col : Knot → ℕ,lookup col p k (l::tail)=interpolate col c d p := by
  by_cases hpl : p≤rank l
  · refine ⟨k,l,by simp,?_,⟨hlo,hpl⟩,fun col => by simp [lookup,hpl]⟩
    have hlt := h.rel
    exact div_lt_div_of_pos_right (by exact_mod_cast hlt) (by norm_num)
  · cases tail with
    | nil => simp at hhi;exact (hpl hhi).elim
    | cons m rest =>
      obtain ⟨c,d,hm,hcd,hmem,he⟩ := find_cell p l m rest h.tail (le_of_not_ge hpl) (by simpa using hhi)
      exact ⟨c,d,by simpa only [List.zip_cons_cons,List.mem_cons] using Or.inr hm,hcd,hmem,
        fun col => by simpa only [lookup,if_neg hpl] using he col⟩
termination_by tail.length

theorem lp_cell {p : ℝ} (hp : p∈Icc pA pC) :
    ∃ c d : Knot,(c,d)∈adjacentCells ∧ rank c<rank d ∧ p∈Icc (rank c) (rank d) ∧
      ∀ col : Knot → ℕ,entry col p=interpolate col c d p := by
  have hchain : knots.IsChain (fun x y => x.position<y.position) := (List.isChain_map Knot.position).mp knot_order
  have sn : knots.head!::knots.tail.head!::knots.tail.tail=knots := by rfl
  have hlast : rank knots.getLast! = pC := by change (knots.getLast!.position:ℝ)/1000=_; rw [knot_endpoints.2];norm_num [pC]
  have hfirst : rank knots.head! = pA := by change (knots.head!.position:ℝ)/1000=_;rw [knot_endpoints.1];norm_num [pA]
  have hl : p≤rank ((knots.head!::knots.tail.head!::knots.tail.tail).getLast!) := by rw [sn,hlast];exact hp.2
  have h := find_cell p knots.head! knots.tail.head! knots.tail.tail (by rw [sn];exact hchain) (by rw [hfirst];exact hp.1) hl
  exact h


structure RegimeBounds (φ : ℝ → ℝ) : Prop where
  constant : ∀ p ∈ Icc p0 pA,PaperBox.CubeBounds lam rc φ beta0 (-1) (1+beta0*p) p
  lpBelow : ∀ p ∈ Icc pA lam,PaperBox.CubeBounds lam rc φ (entry Knot.beta p) (-1) (entry Knot.eta p) p
  lpAbove : ∀ p ∈ Icc lam pC,PaperBox.CubeBounds lam rc φ (entry Knot.beta p) (-1) (entry Knot.eta p) p
  canon : ∀ p ∈ Icc pC p1,PaperBox.CubeBounds lam rc φ (canonical φ p) 1 (-(canonical φ p*(1-p))) p

theorem cube_coverage {φ : ℝ → ℝ} (h : RegimeBounds φ) {p : ℝ} (hp : p∈Icc p0 p1) :
    PaperBox.CubeBounds lam rc φ (beta φ p) (a p) (b φ p) p := by
  by_cases hA : p≤pA
  · have hC : p≤pC := hA.trans (by norm_num [pA,pC])
    simpa [beta,a,b,hA,hC] using h.constant p ⟨hp.1,hA⟩
  by_cases hC : p≤pC
  · by_cases hL : p≤lam
    · simpa [beta,a,b,hA,hC] using h.lpBelow p ⟨le_of_not_ge hA,hL⟩
    · simpa [beta,a,b,hA,hC] using h.lpAbove p ⟨le_of_not_ge hL,hC⟩
  · simpa [beta,a,b,hA,hC,hp.2] using h.canon p ⟨le_of_not_ge hC,hp.2⟩


theorem lp_cubes_of_cells {φ : ℝ → ℝ} {lo hi : ℝ} (hlo : pA≤lo) (hhi : hi≤pC)
    (hc : ∀ c d,(c,d)∈adjacentCells → ∀ p∈Icc lo hi,p∈Icc (rank c) (rank d) →
      PaperBox.CubeBounds lam rc φ
        (value Knot.beta c+(value Knot.beta d-value Knot.beta c)/(rank d-rank c)*(p-rank c)) (-1)
        (value Knot.eta c+(value Knot.eta d-value Knot.eta c)/(rank d-rank c)*(p-rank c)) p) :
    ∀ p∈Icc lo hi,PaperBox.CubeBounds lam rc φ (entry Knot.beta p) (-1) (entry Knot.eta p) p := by
  intro p hp
  obtain ⟨c,d,hpair,hcd,hp',he⟩ := lp_cell ⟨hlo.trans hp.1,hp.2.trans hhi⟩
  simp only [he,interpolate_eq _ _ _ _ hcd hp']
  exact hc c d hpair p hp hp'

theorem beta_nonneg {φ : ℝ → ℝ} (hs : IsScoreFunction lam φ) {p : ℝ} (hp : p∈Ioo 0 1) : 0≤beta φ p := by
  have hJ : 0≤J φ p := by
    by_cases hφ : 0≤φ p
    · have h := (primitive_sandwich hs (le_refl 0) hp.1.le hp.2.le).1
      simp only [J,intervalIntegral.integral_same,sub_zero] at h
      exact (mul_nonneg hp.1.le hφ).trans h
    · have h := (primitive_sandwich hs hp.1.le hp.2.le (le_refl 1)).2
      rw [show J φ 1=0 from hs.integral_eq_zero,zero_sub] at h
      linarith [mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.mpr hp.2.le) (le_of_not_ge hφ)]
  unfold beta
  split_ifs
  · norm_num [beta0]
  · exact entry_nonneg _ _
  · exact mul_nonneg (div_nonneg hp.1.le hJ) (by norm_num [eps])
  · exact div_nonneg hp.1.le hJ

end
end StableVotingDistortion.PaperMiddle
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open PaperBox PaperBox.Bounds Set
noncomputable section

def rectTest (b : Box 2) : Bool := boxAccept (b 0) (b 1)

theorem rect_cover_sound (tree : Cover 2) (b c : Bounds) (ok : tree.verify rectTest ![b,c]=true)
    (p q : ℝ) (hp : b.Holds p) (hq : c.Holds q) : baseResidual p q ≤ 0 := by
  have h := cover_sound (P:=fun x => baseResidual (x 0) (x 1) ≤ 0)
    (ok:=rectTest) (fun _ yes _ hx => boxAccept_sound yes (hx 0) (hx 1)) tree ![b,c] ok
  exact h ![p,q] (by intro i; fin_cases i <;> first | exact hp | exact hq)

theorem base_canonical {p q : ℝ} (hp : p∈Icc (16/25:ℝ) (99/100))
    (hq : q∈Icc (0:ℝ) lam) (hR : baseResidual p q ≤ 0) :
    q + PaperMiddle.canonical score p * deltaP score p q ≤ lam := by
  have hp0 : 0 < p := by linarith only [hp.1]
  have hp1 : p < 1 := by linarith only [hp.2]
  have hpos : 0 < J score p := by
    have hL : lam ≤ p := by unfold lam lamQ; norm_num; linarith only [hp.1]
    have hb := (primitive_sandwich score_isScoreFunction hp0.le hp1.le le_rfl).2
    rw [show J score 1=0 from score_isScoreFunction.integral_eq_zero] at hb
    have hscore := score_isScoreFunction.le_lam_sub p ⟨hp0.le,hp1.le⟩
    have hpL : lam < p := by unfold lam lamQ; norm_num; linarith only [hp.1]
    have hneg : score p<0 := by linarith only [hscore,hpL]
    linarith only [hb,mul_neg_of_pos_of_neg (sub_pos.mpr hp1) hneg]
  change (massE:ℝ)*p*deltaP score p q-(lam-q)*J score p ≤ 0 at hR
  unfold PaperMiddle.canonical
  apply (mul_le_mul_iff_left₀ hpos).mp
  change (q+p / J score p*(1+PaperMiddle.eps)*deltaP score p q) * J score p ≤ lam * J score p
  rw [show (1+PaperMiddle.eps:ℝ)=(massE:ℝ) by norm_num [PaperMiddle.eps,massE]]
  calc
    _ = q*J score p + (massE:ℝ)*p*deltaP score p q := by field_simp
    _ ≤ _ := by nlinarith only [hR]

end
end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open Set

/-- Each internal pivot is the exact shared endpoint of its two children. -/
inductive RowTree
  | leaf (p : Piece)
  | branch (pivot : ℚ) (left right : RowTree)

def RowTree.lookup (x : ℚ) : RowTree → Piece
  | .leaf p => p
  | .branch t l r => if x≤t then l.lookup x else r.lookup x

/-- Simultaneously checks source order, complete interval coverage and the
identity of each stored row. Subdivision affects only the cost of lookup. -/
def RowTree.covers (inside : Piece → Prop) : RowTree → ℚ → ℚ → Prop
  | .leaf p, a, b => inside p ∧ p.lo=a ∧ p.hi=b
  | .branch t l r,a,b => l.covers inside a t ∧ r.covers inside t b

theorem RowTree.lookup_correct (inside : Piece → Prop) (tree : RowTree) {a b x : ℚ}
    (ok : tree.covers inside a b) (ha : a≤x) (hb : x≤b) :
    inside (tree.lookup x) ∧ (tree.lookup x).lo≤x ∧ x≤(tree.lookup x).hi := by
  induction tree generalizing a b with
  | leaf p =>
    obtain ⟨hp,le,re⟩ := ok
    exact ⟨hp,le ▸ ha,re ▸ hb⟩
  | branch pivot left right ihL ihR =>
    by_cases e : x≤pivot
    · simpa only [lookup,if_pos e] using ihL ok.1 ha e
    · simpa only [lookup,if_neg e] using ihR ok.2 (le_of_not_ge e) hb

theorem tree_score_eq {tree : RowTree} (h : tree.covers (· ∈ pieces) 0 1) {x : ℚ}
    (hx : x∈Icc 0 1) : (tree.lookup x).qvalue x=qscore x := by
  obtain ⟨hp,l,r⟩ := tree.lookup_correct _ h hx.1 hx.2
  apply Rat.cast_injective (α:=ℝ)
  rw [Piece.cast_qvalue,qscore_exact,score_on_piece hp ⟨by exact_mod_cast l,by exact_mod_cast r⟩]

theorem tree_primitive_eq {tree : RowTree} (h : tree.covers (· ∈ pieces) 0 1) {x : ℚ}
    (hx : x∈Icc 0 1) : (tree.lookup x).qprimitive x=qprimitive x := by
  obtain ⟨hp,l,r⟩ := tree.lookup_correct _ h hx.1 hx.2
  apply Rat.cast_injective (α:=ℝ)
  rw [Piece.cast_qprimitive,qprimitive_exact,primitive_on_piece hp ⟨by exact_mod_cast l,by exact_mod_cast r⟩]

end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperEndpoint
open Set PaperCurve

/-- Integrate a two-sided derivative comparison over a finite chain of polynomial pieces.
A knot may have unequal one-sided derivatives. The predicate is tested only at open
points of each traversed piece. -/
theorem chain_slope_lower {ps : List Piece} {a b : Knot} (chain : Chain a ps b)
    {f : ℝ → ℝ} (values : ∀ row ∈ ps,∀ x ∈ Icc (row.lo:ℝ) row.hi,f x=row.value x)
    {x y v : ℝ} (hx : (a.x:ℝ) ≤ x) (hy : y ≤ (b.x:ℝ)) (hxy : x ≤ y)
    (bound : ∀ row ∈ ps,∀ t ∈ Ioo (row.lo:ℝ) row.hi, x<t → t<y → v ≤ row.slope t) :
    v*(y-x) ≤ f y-f x := by
  induction ps generalizing a x y with
  | nil =>
    have ha : a=b := chain
    have he : x=y := by rw [ha] at hx;linarith
    simp [he]
  | cons row ps ih =>
    rcases chain with ⟨rfl,hh,chain⟩
    change (row.lo:ℝ) ≤ x at hx
    have hw : (row.lo:ℝ)<row.hi := by exact_mod_cast hh
    have one {s t : ℝ} (hs : row.lo ≤ s) (hst : s ≤ t) (ht : t ≤ row.hi) (hxs : x ≤ s) (hty : t ≤ y) :
        v*(t-s) ≤ f t-f s := by
      rw [values row (by simp) t ⟨hs.trans hst,ht⟩,values row (by simp) s ⟨hs,hst.trans ht⟩]
      apply (convex_Icc s t).mul_sub_le_image_sub_of_le_deriv row.continuous_value.continuousOn
        (fun z _ => (row.hasDeriv_value z).differentiableAt.differentiableWithinAt) _ s ⟨le_rfl,hst⟩ t ⟨hst,le_rfl⟩ hst
      intro z hz
      rw [interior_Icc] at hz
      rw [(row.hasDeriv_value z).deriv]
      exact bound row (by simp) z ⟨hs.trans_lt hz.1,hz.2.trans_le ht⟩ (hxs.trans_lt hz.1) (hz.2.trans_le hty)
    by_cases h : y ≤ row.hi
    · exact one hx hxy h le_rfl le_rfl
    have tail (s : ℝ) (hs : row.hi ≤ s) (hxs : x ≤ s) (hsy : s ≤ y) : v*(y-s) ≤ f y-f s := by
      apply ih chain (fun r hr => values r (by simp [hr])) hs hy hsy
      intro r hr t ht hst hty
      exact bound r (by simp [hr]) t ht (hxs.trans_lt hst) hty
    by_cases hx' : row.hi ≤ x
    · exact tail x hx' le_rfl hxy
    have left := one hx (le_of_not_ge hx') le_rfl le_rfl (le_of_not_ge h)
    have right := tail row.hi le_rfl (le_of_not_ge hx') (le_of_not_ge h)
    linarith only [left,right]

/-- Upper half of the same piecewise secant comparison. -/
theorem chain_slope_upper {ps : List Piece} {a b : Knot} (chain : Chain a ps b)
    {f : ℝ → ℝ} (values : ∀ row ∈ ps,∀ x ∈ Icc (row.lo:ℝ) row.hi,f x=row.value x)
    {x y v : ℝ} (hx : (a.x:ℝ) ≤ x) (hy : y ≤ (b.x:ℝ)) (hxy : x ≤ y)
    (bound : ∀ row ∈ ps,∀ t ∈ Ioo (row.lo:ℝ) row.hi, x<t → t<y → row.slope t ≤ v) :
    f y-f x ≤ v*(y-x) := by
  induction ps generalizing a x y with
  | nil =>
    have ha : a=b := chain
    have he : x=y := by rw [ha] at hx;linarith
    simp [he]
  | cons row ps ih =>
    rcases chain with ⟨rfl,hh,chain⟩
    change (row.lo:ℝ) ≤ x at hx
    have one {s t : ℝ} (hs : row.lo ≤ s) (hst : s ≤ t) (ht : t ≤ row.hi) (hxs : x ≤ s) (hty : t ≤ y) :
        f t-f s ≤ v*(t-s) := by
      rw [values row (by simp) t ⟨hs.trans hst,ht⟩,values row (by simp) s ⟨hs,hst.trans ht⟩]
      apply (convex_Icc s t).image_sub_le_mul_sub_of_deriv_le row.continuous_value.continuousOn
        (fun z _ => (row.hasDeriv_value z).differentiableAt.differentiableWithinAt) _ s ⟨le_rfl,hst⟩ t ⟨hst,le_rfl⟩ hst
      intro z hz
      rw [interior_Icc] at hz
      rw [(row.hasDeriv_value z).deriv]
      exact bound row (by simp) z ⟨hs.trans_lt hz.1,hz.2.trans_le ht⟩ (hxs.trans_lt hz.1) (hz.2.trans_le hty)
    by_cases h : y ≤ row.hi
    · exact one hx hxy h le_rfl le_rfl
    have tail (s : ℝ) (hs : row.hi ≤ s) (hxs : x ≤ s) (hsy : s ≤ y) : f y-f s ≤ v*(y-s) := by
      apply ih chain (fun r hr => values r (by simp [hr])) hs hy hsy
      intro r hr t ht hst hty
      exact bound r (by simp [hr]) t ht (hxs.trans_lt hst) hty
    by_cases hx' : row.hi ≤ x
    · exact tail x hx' le_rfl hxy
    have left := one hx (le_of_not_ge hx') le_rfl le_rfl (le_of_not_ge h)
    have right := tail row.hi le_rfl (le_of_not_ge hx') (le_of_not_ge h)
    linarith only [left,right]

theorem exists_covering_piece {ps : List Piece} {a b : Knot} (chain : Chain a ps b)
    {x : ℝ} (hx : (a.x:ℝ) ≤ x) (hy : x<(b.x:ℝ)) : ∃ r∈ps,x∈Icc (r.lo:ℝ) r.hi := by
  induction ps generalizing a with
  | nil => rw [show a=b from chain] at hx;exact (hy.not_ge hx).elim
  | cons p ps ih =>
    rcases chain with ⟨rfl,_,chain⟩
    by_cases hh : x ≤ p.hi
    · exact ⟨p,by simp,⟨hx,hh⟩⟩
    · obtain ⟨r,hr,hw⟩ := ih chain (le_of_not_ge hh)
      exact ⟨r,by simp [hr],hw⟩

/-- A globally decreasing system of one-sided slopes implies concavity, including knots. -/
theorem chain_concave {ps : List Piece} {a b : Knot} (chain : Chain a ps b)
    {f : ℝ → ℝ} (values : ∀ row ∈ ps,∀ x ∈ Icc (row.lo:ℝ) row.hi,f x=row.value x)
    {l u : ℝ} (hl : (a.x:ℝ) ≤ l) (hu : u ≤ (b.x:ℝ))
    (decreasing : ∀ r∈ps,∀ s∈ps,∀ t∈Icc (r.lo:ℝ) r.hi,∀ z∈Icc (s.lo:ℝ) s.hi,
      l<t → t<z → z ≤ u → s.slope z ≤ r.slope t) : ConcaveOn ℝ (Icc l u) f := by
  apply concaveOn_of_slope_anti_adjacent (convex_Icc _ _)
  intro x y z hx hz hxy hyz
  obtain ⟨r,hr,hy⟩ := exists_covering_piece chain ((hl.trans hx.1).trans hxy.le) ((hyz.trans_le hz.2).trans_le hu)
  have hleft := chain_slope_lower chain values (hl.trans hx.1) ((hyz.le.trans hz.2).trans hu) hxy.le
    (v:=r.slope y) (fun row hrow t ht hxt hty => decreasing row hrow r hr t ⟨ht.1.le,ht.2.le⟩ y hy
      (hx.1.trans_lt hxt) hty (hyz.le.trans hz.2))
  have hright := chain_slope_upper chain values ((hl.trans hx.1).trans hxy.le) (hz.2.trans hu) hyz.le
    (v:=r.slope y) (fun row hrow t ht hyt htz => decreasing r hr row hrow y hy t ⟨ht.1.le,ht.2.le⟩
      (hx.1.trans_lt hxy) hyt (htz.le.trans hz.2))
  exact ((div_le_iff₀ (sub_pos.mpr hyz)).mpr hright).trans ((le_div_iff₀ (sub_pos.mpr hxy)).mpr hleft)

end StableVotingDistortion.PaperEndpoint
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open Set PaperBox PaperBox.Bounds
noncomputable section

/-- Evaluate the derivative polynomial on the part of the query interval in a single row. -/
def localSlopeBox (i : Bounds) (p : Piece) : Bounds :=
  Bounds.horner p.slopeCoeffs ((i.meet ⟨p.lo,p.hi⟩).minus (point p.lo))

/-- Take the hull over exactly the overlapping rows. The terminal value is used only if no
row meets the query interval, which cannot occur at an actual score argument in [0,1]. -/
def slopeBounds (i : Bounds) : List Piece → Option Bounds
  | [] => none
  | p::ps =>
    if i.lo ≤ p.hi ∧ p.lo ≤ i.hi then
      match slopeBounds i ps with
      | none => some (localSlopeBox i p)
      | some t => some ((localSlopeBox i p).hull t)
    else slopeBounds i ps

def slopeBox (i : Bounds) : Bounds := (slopeBounds i pieces).getD (point 0)

private theorem rowSlopeBox_sound {ps : List Piece} {p : Piece} {i : Bounds} {x : ℝ}
    (hp : p∈ps) (hx : i.Holds x) (hr : x∈Icc (p.lo:ℝ) p.hi) :
    ∃ box, slopeBounds i ps=some box ∧ box.Holds (p.slope x) := by
  induction ps with
  | nil => cases hp
  | cons q qs ih =>
    rcases List.mem_cons.mp hp with rfl|hp
    · have overlap : i.lo ≤ p.hi ∧ p.lo ≤ i.hi := by
        constructor
        · exact_mod_cast hx.1.trans hr.2
        · exact_mod_cast hr.1.trans hx.2
      have hv : (localSlopeBox i p).Holds (p.slope x) :=
        Bounds.horner_holds p.slopeCoeffs (minus_holds (meet_holds hx hr) (point_holds _))
      simp only [slopeBounds,if_pos overlap]
      cases h : slopeBounds i qs with
      | none => exact ⟨_,rfl,hv⟩
      | some t => exact ⟨_,rfl,hull_left _ _ hv⟩
    · obtain ⟨b,hb,hh⟩ := ih hp
      unfold slopeBounds
      split
      · rw [hb]
        exact ⟨_,rfl,hull_right _ _ hh⟩
      · exact ⟨b,hb,hh⟩

theorem slopeBox_local {i : Bounds} {p : Piece} (hp : p∈pieces) {x : ℝ}
    (hx : i.Holds x) (hr : x∈Icc (p.lo:ℝ) p.hi) : (slopeBox i).Holds (p.slope x) := by
  obtain ⟨b,hb,he⟩ := rowSlopeBox_sound hp hx hr
  simpa [slopeBox,hb] using he

theorem score_secant {i : Bounds} {x y : ℝ} (hx : i.Holds x) (hy : i.Holds y)
    (dx : x∈Icc 0 1) (dy : y∈Icc 0 1) : Secants score x y (slopeBox i) := by
  have order {u v : ℝ} (hu : i.Holds u) (hv : i.Holds v) (du : u∈Icc 0 1)
      (dv : v∈Icc 0 1) (huv : u<v) : Secants score u v (slopeBox i) := by
    let k := slopeBox i
    have hrow (r : Piece) (hr : r∈pieces) (t : ℝ) (ht : t∈Ioo (r.lo:ℝ) r.hi)
        (h₁ : u<t) (h₂ : t<v) : k.Holds (r.slope t) :=
      slopeBox_local hr ⟨hu.1.trans h₁.le,h₂.le.trans hv.2⟩ ⟨ht.1.le,ht.2.le⟩
    have lo := PaperEndpoint.chain_slope_lower data_chain (f:=score) (fun _ hm _ hx => score_on_piece hm hx)
      (x:=u) (y:=v) (by simpa [startKnot] using du.1) (by simpa [endKnot] using dv.2) huv.le
      (fun r hr t ht h₁ h₂ => (hrow r hr t ht h₁ h₂).1)
    have hi := PaperEndpoint.chain_slope_upper data_chain (f:=score) (fun _ hm _ hx => score_on_piece hm hx)
      (x:=u) (y:=v) (by simpa [startKnot] using du.1) (by simpa [endKnot] using dv.2) huv.le
      (fun r hr t ht h₁ h₂ => (hrow r hr t ht h₁ h₂).2)
    exact ⟨(score v-score u)/(v-u),⟨(le_div_iff₀ (sub_pos.mpr huv)).mpr lo,
      (div_le_iff₀ (sub_pos.mpr huv)).mpr hi⟩,(div_mul_cancel₀ _ (sub_pos.mpr huv).ne').symm⟩
  rcases lt_trichotomy x y with h|rfl|h
  · exact order hx hy dx dy h
  · obtain ⟨p,hp,hr⟩ := data_chain.exists_piece (x:=x) (by simpa [startKnot] using dx.1)
      (by simpa [endKnot] using dx.2) data_nonempty
    exact ⟨p.slope x,slopeBox_local hp hx hr,by simp⟩
  · obtain ⟨m,hm,he⟩ := order hy hx dy dx h
    exact ⟨m,hm,by linear_combination -he⟩

end
end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open Set PaperBox PaperBox.Bounds
noncomputable section

def qclamp (x : ℚ) : ℚ := max 0 (min 1 x)
def clampBox (i : Bounds) : Bounds := ⟨qclamp i.lo,qclamp i.hi⟩
def clampSlopeBox (i : Bounds) : Bounds :=
  if 0 ≤ i.lo ∧ i.hi ≤ 1 then point 1 else if i.hi ≤ 0 ∨ 1 ≤ i.lo then point 0 else ⟨0,1⟩

theorem clamp_mem (x : ℝ) : clamp x ∈ Icc 0 1 :=
  ⟨le_max_left _ _,max_le zero_le_one (min_le_left _ _)⟩
theorem clamp_eq {x : ℝ} (hx : x∈Icc 0 1) : clamp x=x := by simp [clamp,min_eq_right hx.2,max_eq_right hx.1]
private theorem cast_qclamp (q : ℚ) : (qclamp q:ℝ)=clamp q := by simp [qclamp,clamp]
private theorem clamp_mono : Monotone clamp :=
  fun _ _ h => max_le_max_left _ (min_le_min_left _ h)
theorem clampBox_holds {i : Bounds} {x : ℝ} (h : i.Holds x) : (clampBox i).Holds (clamp x) := by
  simpa [Holds,clampBox,cast_qclamp] using show
    clamp i.lo ≤ clamp x ∧ clamp x ≤ clamp i.hi from ⟨clamp_mono h.1,clamp_mono h.2⟩

theorem clamp_secant {i : Bounds} {x y : ℝ} (hx : i.Holds x) (hy : i.Holds y) :
    Secants clamp x y (clampSlopeBox i) := by
  unfold clampSlopeBox
  split_ifs with inside outside
  · obtain ⟨h0,h1⟩ := inside
    have h₀ : (0:ℝ) ≤ i.lo := by exact_mod_cast h0
    have h₁ : (i.hi:ℝ) ≤ 1 := by exact_mod_cast h1
    refine ⟨1,by simpa using point_holds 1,?_⟩
    rw [clamp_eq ⟨h₀.trans hx.1,hx.2.trans h₁⟩,clamp_eq ⟨h₀.trans hy.1,hy.2.trans h₁⟩,one_mul]
  · refine ⟨0,by simpa using point_holds 0,?_⟩
    rcases outside with hl|hr
    · have h : (i.hi:ℝ) ≤ 0 := by exact_mod_cast hl
      have he {z : ℝ} (hz : z ≤ 0) : clamp z=0 := by
        simp [clamp,min_eq_right (hz.trans zero_le_one),max_eq_left hz]
      rw [he (hx.2.trans h),he (hy.2.trans h)];ring
    · have h : (1:ℝ) ≤ i.lo := by exact_mod_cast hr
      have he {z : ℝ} (hz : 1 ≤ z) : clamp z=1 := by simp [clamp,min_eq_left hz]
      rw [he (h.trans hx.1),he (h.trans hy.1)];ring
  · have order {u v : ℝ} (h : u<v) : Secants clamp u v ⟨0,1⟩ := by
      have hlo := sub_nonneg.mpr (clamp_mono h.le)
      have hhi : clamp v-clamp u ≤ v-u := by simp only [clamp,max_def,min_def]; split_ifs <;> linarith
      exact ⟨(clamp v-clamp u)/(v-u),⟨by simpa using div_nonneg hlo (sub_nonneg.mpr h.le),
        by simpa using (div_le_one (sub_pos.mpr h)).mpr hhi⟩,(div_mul_cancel₀ _ (sub_pos.mpr h).ne').symm⟩
    rcases lt_trichotomy x y with h|rfl|h
    · exact order h
    · exact ⟨0,by norm_num [Holds],by simp⟩
    · obtain ⟨m,hm,he⟩ := order h
      exact ⟨m,hm,by linear_combination -he⟩

def totalScoreBox (i : Bounds) : Bounds := scoreBox (clampBox i)
def totalPrimitiveBox (i : Bounds) : Bounds := primitiveBox (clampBox i)
def totalScoreSlope (i : Bounds) : Bounds := (slopeBox (clampBox i)).times (clampSlopeBox i)
def totalPrimitiveSlope (i : Bounds) : Bounds := (scoreBox (clampBox i)).times (clampSlopeBox i)

theorem totalScoreBox_holds {i : Bounds} {x : ℝ} (h : i.Holds x) : (totalScoreBox i).Holds (totalScore x) :=
  scoreBox_holds (clampBox_holds h) (clamp_mem x)
theorem totalPrimitiveBox_holds {i : Bounds} {x : ℝ} (h : i.Holds x) :
    (totalPrimitiveBox i).Holds (totalPrimitive x) := primitiveBox_holds (clampBox_holds h) (clamp_mem x)
theorem totalScore_secant {i : Bounds} {x y : ℝ} (hx : i.Holds x) (hy : i.Holds y) :
    Secants totalScore x y (totalScoreSlope i) :=
  secant_comp (clamp_secant hx hy) (score_secant (clampBox_holds hx) (clampBox_holds hy) (clamp_mem _) (clamp_mem _))
theorem totalPrimitive_secant {i : Bounds} {x y : ℝ} (hx : i.Holds x) (hy : i.Holds y) :
    Secants totalPrimitive x y (totalPrimitiveSlope i) :=
  secant_comp (clamp_secant hx hy) (primitive_secant (clampBox_holds hx) (clampBox_holds hy) (clamp_mem _) (clamp_mem _))

end
end StableVotingDistortion.PaperCurve
end

