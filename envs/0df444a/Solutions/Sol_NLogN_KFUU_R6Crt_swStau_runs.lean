section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## Moving and dropping a fixed number of items -/

theorem mvK_runs {X Y : Fin HS} (hXY : X ≠ Y) {Z : ℕ} :
    ∀ (L : List ℤ) (t : IState HS) (RX : List Item), t.G X = ints L ++ RX → Bnd Z L →
    IRuns I iprog (mvK X Y L.length) t ((t.upd X RX).upd Y (ints L.reverse ++ t.G Y))
      (L.length * cU Z + 1)
  | [], t, RX, h, _ => by
    refine (IRuns.skip t).mono' ?_ (by simp)
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases h1 : j = Y
    · subst h1; simp
    · by_cases h2 : j = X
      · subst h2; simp [h1, h]
      · simp [h1, h2]
  | a :: L, t, RX, h, hb => by
    have h1 := IRuns.mv (I := I) (iprog := iprog) (s := t) (a := a) (L := ints L ++ RX) hXY
      (by rw [h]; simp)
    have h2 := mvK_runs hXY L ((t.upd X (ints L ++ RX)).upd Y (.int a :: t.G Y)) RX
      (by simp [hXY, Ne.symm hXY]) (fun x hx => hb x (List.mem_cons_of_mem _ hx))
    refine (h1.seq h2).mono' ?_ ?_
    · refine IState.ext' (fun j => ?_) rfl rfl
      by_cases e1 : j = Y
      · subst e1; simp [Ne.symm hXY, ints]
      · by_cases e2 : j = X
        · subst e2; simp [e1]
        · simp [e1, e2]
    · have := mv_le_cU (hb a (by simp)); simp only [List.length_cons]; nlinarith

theorem dropK_runs {X : Fin HS} {Z : ℕ} :
    ∀ (L : List ℤ) (t : IState HS) (RX : List Item), t.G X = ints L ++ RX → Bnd Z L →
    IRuns I iprog (dropK X L.length) t (t.upd X RX) (L.length * cU Z + 1)
  | [], t, RX, h, _ => by
    refine (IRuns.skip t).mono' ?_ (by simp)
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases h2 : j = X
    · subst h2; simp [h]
    · simp [h2]
  | a :: L, t, RX, h, hb => by
    have h1 := IRuns.drop (I := I) (iprog := iprog) (s := t) (a := a) (L := ints L ++ RX)
      (by rw [h]; simp)
    have h2 := dropK_runs (X := X) L (t.upd X (ints L ++ RX)) RX (by simp)
      (fun x hx => hb x (List.mem_cons_of_mem _ hx))
    refine (h1.seq h2).mono' (by simp) ?_
    have := drop_le_cU (hb a (by simp)); simp only [List.length_cons]; nlinarith

/-! ## Pushing a list of register values and constants -/

theorem pushOK_upd {t : IState HS} {D : Fin HS} {L' : List Item} {o : Fin HS ⊕ ℤ} {v : ℤ}
    (h : PushOK t D o v) : PushOK (t.upd D L') D o v := by
  cases o with
  | inl X => obtain ⟨h1, L, h2⟩ := h; exact ⟨h1, L, by simp [h1, h2]⟩
  | inr c => exact h

theorem pushL_runs {D : Fin HS} {Z : ℕ} :
    ∀ (os : List (Fin HS ⊕ ℤ)) (vs : List ℤ) (t : IState HS), List.Forall₂ (PushOK t D) os vs →
    Bnd Z vs → IRuns I iprog (pushL D os) t (t.upd D (ints vs.reverse ++ t.G D))
      (os.length * cU Z + 1)
  | [], [], t, _, _ => by
    refine (IRuns.skip t).mono' ?_ (by simp)
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases h2 : j = D
    · subst h2; simp
    · simp [h2]
  | o :: os, v :: vs, t, .cons ho hr, hb => by
    have hv : zsz v ≤ Z := hb v (by simp)
    have h1 : IRuns I iprog (pushOp D o) t (t.upd D (.int v :: t.G D)) (cU Z) := by
      cases o with
      | inl X =>
        obtain ⟨hXD, L, hX⟩ := ho
        exact (IRuns.dup (I := I) (iprog := iprog) hXD hX).mono (dup_le_cU hv)
      | inr c =>
        have e : c = v := ho
        subst e
        exact (IRuns.const (I := I) (iprog := iprog) (s := t) D c).mono (const_le_cU hv)
    have h2 := pushL_runs os vs (t.upd D (.int v :: t.G D))
      (hr.imp (fun _ _ h => pushOK_upd h)) (fun x hx => hb x (List.mem_cons_of_mem _ hx))
    refine (h1.seq h2).mono' ?_ (by simp only [List.length_cons]; nlinarith)
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases e2 : j = D
    · subst e2; simp [ints]
    · simp [e2]

/-! ## One swap through the entry -/

theorem zsz_small {z : ℤ} (h0 : 0 ≤ z) (h : z ≤ 5) : zsz z ≤ 3 :=
  zsz_le_of_lt (by omega)

end Gen

end NLogN.KFUU

