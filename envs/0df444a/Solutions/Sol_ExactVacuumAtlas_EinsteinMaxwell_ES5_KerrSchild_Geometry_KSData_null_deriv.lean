theorem pd_quad {T : Metric 5} {X : Pt 5 → Fin 5 → ℝ} {x : Pt 5}
    (hT : ∀ p q, DifferentiableAt ℝ (T p q) x) (hX : ∀ p, DifferentiableAt ℝ (fun y => X y p) x)
