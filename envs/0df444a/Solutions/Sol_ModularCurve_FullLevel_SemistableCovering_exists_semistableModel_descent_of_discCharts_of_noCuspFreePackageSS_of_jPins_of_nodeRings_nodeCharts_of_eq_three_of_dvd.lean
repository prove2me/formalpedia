theorem exists_mul_mem_valuationSubring {L : Type*} [Field L] (A : ValuationSubring L) (c : L) :
    ∃ d : ↥A, (d : L) ≠ 0 ∧ c * (d : L) ∈ A := by
  rcases ValuationSubring.mem_or_inv_mem A c with h | h
  · exact ⟨1, by simp, by simpa using h⟩
  · by_cases hc : c = 0
    · exact ⟨1, by simp, by simp [hc, A.zero_mem]⟩
    · exact ⟨⟨c⁻¹, h⟩, by simp [hc], by simp [mul_inv_cancel₀ hc, A.one_mem]⟩

theorem exists_frac_of_span {L F : Type*} [Field L] [Field F] [Algebra L F] (A : ValuationSubring L)
    (N₀ : Subring F) (T : Subring F)
    (hT : T = Subring.closure ((N₀ : Set F) ∪ Set.range (fun a : ↥A => algebraMap L F (a : L))))
    (f : F) (n : ℕ) (c : Fin n → L) (a : Fin n → ↥N₀) (b : ↥N₀) (hb : (b : F) ≠ 0)
    (hf : f * (b : F) = ∑ i, c i • ((a i : ↥N₀) : F)) :
    ∃ b' c' : ↥T, (c' : F) ≠ 0 ∧ f * (c' : F) = (b' : F) := by
  classical
  have hd := fun i => exists_mul_mem_valuationSubring A (c i)
  choose d hd0 hdA using hd
  set D : ↥A := ∏ i, d i with hD
  have hDL : (D : L) = ∏ i, (d i : L) := by
    simp [hD]
  have hD0 : (D : L) ≠ 0 := by
    rw [hDL]; exact Finset.prod_ne_zero_iff.mpr (fun i _ => hd0 i)
  have hcD : ∀ i, c i * (D : L) ∈ A := by
    intro i
    have : (D : L) = (d i : L) * ∏ j ∈ Finset.univ.erase i, (d j : L) := by
      rw [hDL]; exact (Finset.mul_prod_erase Finset.univ (fun j => ((d j : ↥A) : L)) (Finset.mem_univ i)).symm
    rw [this, ← mul_assoc]
    refine A.mul_mem _ _ (hdA i) ?_
    have : (∏ j ∈ Finset.univ.erase i, (d j : L)) = ((∏ j ∈ Finset.univ.erase i, d j : ↥A) : L) := by
      simp
    rw [this]; exact SetLike.coe_mem _
  have hNT : ∀ x : F, x ∈ N₀ → x ∈ T := fun x hx => by
    rw [hT]; exact Subring.subset_closure (Or.inl hx)
  have hAT : ∀ y : L, y ∈ A → algebraMap L F y ∈ T := fun y hy => by
    rw [hT]; exact Subring.subset_closure (Or.inr ⟨⟨y, hy⟩, rfl⟩)
  refine ⟨⟨∑ i, algebraMap L F (c i * (D : L)) * ((a i : ↥N₀) : F), ?_⟩,
    ⟨(b : F) * algebraMap L F (D : L), T.mul_mem (hNT _ b.2) (hAT _ D.2)⟩, ?_, ?_⟩
  · exact T.sum_mem (fun i _ => T.mul_mem (hAT _ (hcD i)) (hNT _ (a i).2))
  · exact mul_ne_zero hb (by simpa using hD0)
  · show f * ((b : F) * algebraMap L F (D : L)) = ∑ i, algebraMap L F (c i * (D : L)) * ((a i : ↥N₀) : F)
    rw [← mul_assoc, hf, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Algebra.smul_def, map_mul]; ring

theorem ord_nonneg_of_mem' {K F : Type*} [Field K] [Field F] [Algebra K F] (v : Place K F) {f : F}
    (hf : f ∈ v.toValuationSubring) : 0 ≤ v.ord f := by
  rcases eq_or_ne f 0 with rfl | hf0
  · simp
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible v.toValuationSubring
  obtain ⟨n, u, hu⟩ :=
    IsDiscreteValuationRing.eq_unit_mul_pow_irreducible
      (x := (⟨f, hf⟩ : v.toValuationSubring)) (by simpa [Subtype.ext_iff] using hf0) hπ
  have hcoe : f = ((u : v.toValuationSubring) : F) * ((π : F) ^ (n : ℤ)) := by
    have h := congrArg (Subtype.val) hu
    push_cast at h
    rw [zpow_natCast]
    exact h
  rw [hcoe, v.ord_unit_smul_zpow u hπ (n : ℤ)]
  exact Int.natCast_nonneg n

theorem mem_of_package_of_mem_or_inv_mem {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]
    {Fbar : Type*} [Field Fbar] [Algebra (ResidueField ↥A) Fbar]
    (R : RegularProlongation A F Fbar) (Q : Place (ResidueField ↥A) Fbar) (S : Subring F) (χ₀ : ↥S →+* ResidueField ↥A)
    (D : Set (Place L F))
    (h8 : ∀ f : ↥S, ∃ hR : (f : F) ∈ R.integers, ∃ hm : R.residue ⟨(f : F), hR⟩ ∈ Q.toValuationSubring,
        IsLocalRing.residue ↥Q.toValuationSubring ⟨R.residue ⟨(f : F), hR⟩, hm⟩ =
          algebraMap (ResidueField ↥A) Q.ResidueField (χ₀ f))
    (h10 : ∀ P, P ∈ D ↔ (P.IsRational ∧ (∀ f : ↥S, (f : F) ∈ P.toValuationSubring ∧ P.evalAt (f : F) ∈ A) ∧
        (∀ f : ↥S, A.valuation (P.evalAt (f : F)) < 1 ↔ χ₀ f = 0)))
    (g : F) (hgR : g ∈ R.integers) (hu : R.residue ⟨g, hgR⟩ ∈ Q.toValuationSubring)
    (hgS : g ∈ S ∨ g⁻¹ ∈ S) :
    ∀ P ∈ D, g ∈ P.toValuationSubring := by
  intro P hP
  obtain ⟨-, hmemA, hval⟩ := (h10 P).mp hP
  rcases hgS with hgS | hinvS
  · exact (hmemA ⟨g, hgS⟩).1
  · by_contra hg
    have hg0 : g ≠ 0 := by rintro rfl; exact hg (zero_mem _)
    have hinvP : g⁻¹ ∈ P.toValuationSubring := by
      rcases ValuationSubring.mem_or_inv_mem P.toValuationSubring g with h | h
      · exact absurd h hg
      · exact h

    have hnu : ¬ IsUnit (⟨g⁻¹, hinvP⟩ : P.toValuationSubring) := by
      intro hunit
      obtain ⟨w, hw⟩ := hunit.exists_right_inv
      have h1 : (g⁻¹ : F) * (w : F) = 1 := by
        have := congrArg Subtype.val hw
        simpa using this
      have hw' : (w : F) = g := by
        calc (w : F) = g * (g⁻¹ * (w : F)) := by rw [← mul_assoc, mul_inv_cancel₀ hg0, one_mul]
          _ = g := by rw [h1, mul_one]
      exact hg (hw' ▸ w.2)
    have hres0 : IsLocalRing.residue ↥P.toValuationSubring ⟨g⁻¹, hinvP⟩ = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
    have hev : P.evalAt g⁻¹ = 0 := by
      rw [P.evalAt_of_mem hinvP, hres0, ← map_zero (algebraMap L P.ResidueField), P.residueInv_algebraMap]
    have hχ : χ₀ ⟨g⁻¹, hinvS⟩ = 0 := (hval ⟨g⁻¹, hinvS⟩).mp (by
      show A.valuation (P.evalAt g⁻¹) < 1
      rw [hev, map_zero]; exact zero_lt_one)
    obtain ⟨hRinv, hm, hread⟩ := h8 ⟨g⁻¹, hinvS⟩
    rw [hχ, map_zero] at hread

    have hmul : (⟨R.residue ⟨g⁻¹, hRinv⟩, hm⟩ : Q.toValuationSubring) * ⟨R.residue ⟨g, hgR⟩, hu⟩ = 1 := by
      apply Subtype.ext
      change R.residue ⟨g⁻¹, hRinv⟩ * R.residue ⟨g, hgR⟩ = 1
      rw [← map_mul, ← map_one R.residue]
      congr 1
      exact Subtype.ext (by simp [hg0])
    have hunit : IsUnit (⟨R.residue ⟨g⁻¹, hRinv⟩, hm⟩ : Q.toValuationSubring) := IsUnit.of_mul_eq_one _ hmul
    exact (IsLocalRing.residue_ne_zero_iff_isUnit _ |>.mpr hunit) hread

theorem incl_sub_algebraMap (q M' : ℕ) [Fact q.Prime] [NeZero M'] (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (x : ↥(modularFunctionFieldBar M')) (a : AlgebraicClosure ℚ) :
    (IntermediateField.inclusion hle (x - algebraMap (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M') a) : ↥(fieldBar q M')) =
      IntermediateField.inclusion hle x - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') a := by
  rw [map_sub]
  congr 1

theorem hrk_of_liesOverPrime (q : ℕ) [Fact q.Prime] (A : ValuationSubring (AlgebraicClosure ℚ))
    (hA : A.LiesOverPrime q) :
    ∀ a b : ↥A, a ∈ maximalIdeal ↥A → b ≠ 0 → ∃ n : ℕ, b ∣ a ^ n := by
  intro a b ha hb
  by_cases ha0 : a = 0
  · exact ⟨1, by simp [ha0]⟩
  · exact ValuationSubring.exists_dvd_pow_of_mem_maximalIdeal A (q := q) hA b hb a ha ha0

theorem coe_ne_univ_of_liesOverPrime (q : ℕ) [Fact q.Prime] (A : ValuationSubring (AlgebraicClosure ℚ))
    (hA : A.LiesOverPrime q) : (A : Set (AlgebraicClosure ℚ)) ≠ Set.univ := by
  intro h
  have hq0 : ((q : ℕ) : AlgebraicClosure ℚ) ≠ 0 := by
    exact_mod_cast (Fact.out : q.Prime).ne_zero
  have hmem : ((q : ℕ) : AlgebraicClosure ℚ)⁻¹ ∈ A := by
    have : ((q : ℕ) : AlgebraicClosure ℚ)⁻¹ ∈ (A : Set (AlgebraicClosure ℚ)) := by rw [h]; trivial
    exact this
  have hqA : ((q : ℕ) : AlgebraicClosure ℚ) ∈ A := by
    have : ((q : ℕ) : AlgebraicClosure ℚ) ∈ (A : Set (AlgebraicClosure ℚ)) := by rw [h]; trivial
    exact this
  have hmax : (⟨((q : ℕ) : AlgebraicClosure ℚ), hqA⟩ : ↥A) ∈ maximalIdeal ↥A :=
    (ValuationSubring.coe_mem_nonunits_iff (a := ⟨((q : ℕ) : AlgebraicClosure ℚ), hqA⟩)).mp hA
  apply (IsLocalRing.mem_maximalIdeal _).mp hmax
  refine ⟨⟨⟨_, hqA⟩, ⟨_, hmem⟩, ?_, ?_⟩, rfl⟩
  · exact Subtype.ext (mul_inv_cancel₀ hq0)
  · exact Subtype.ext (inv_mul_cancel₀ hq0)

