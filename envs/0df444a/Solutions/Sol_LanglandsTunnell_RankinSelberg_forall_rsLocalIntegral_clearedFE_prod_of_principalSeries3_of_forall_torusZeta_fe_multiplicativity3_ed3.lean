theorem exists_eq_coefficientFn_of_mem_gl3CyclicSubspace {lam : Fin 3 → ((p.adicCompletion ℚ)ˣ →* ℂˣ)}
    (Λ : ↥(principalSeries3 p lam) →ₗ[ℂ] ℂ) (f : ↥(principalSeries3 p lam))
    (W : LocalGL3 p → ℂ) (hW : W ∈ gl3CyclicSubspace (coefficientFn Λ f)) :
    ∃ f' : ↥(principalSeries3 p lam), W = coefficientFn Λ f' := by
  induction hW using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨h, rfl⟩ := hx
    refine ⟨⟨gl3AmbientRightTranslate (R := ℂ) h f, rightTranslate_mem_principalSeries3 f.2 h⟩, ?_⟩
    funext g
    show coefficientFn Λ f (g * h) = _
    simp only [coefficientFn]
    congr 1
    apply Subtype.ext
    funext k
    simp [gl3AmbientRightTranslate, mul_assoc]
  | zero =>
    refine ⟨0, ?_⟩
    funext g
    simp only [coefficientFn, Pi.zero_apply]
    rw [← map_zero Λ]
    congr 1
  | add x y _ _ hx hy =>
    obtain ⟨f₁, rfl⟩ := hx
    obtain ⟨f₂, rfl⟩ := hy
    refine ⟨f₁ + f₂, ?_⟩
    funext g
    simp only [coefficientFn, Pi.add_apply]
    rw [← map_add Λ]
    congr 1
  | smul a x _ hx =>
    obtain ⟨f₁, rfl⟩ := hx
    refine ⟨a • f₁, ?_⟩
    funext g
    simp only [coefficientFn, Pi.smul_apply, smul_eq_mul]
    rw [← smul_eq_mul, ← map_smul Λ]
    congr 1

theorem dualWhittakerFn3_sum {n : ℕ} (κ : Fin n → ℂ) (W : Fin n → LocalGL3 p → ℂ) (g : LocalGL3 p) :
    dualWhittakerFn3 (fun h => ∑ j, κ j * W j h) g = ∑ j, κ j * dualWhittakerFn3 (W j) g := by
  simp only [dualWhittakerFn3_apply]

theorem rsLocalIntegral_sum {G : Type} [Group G] [TopologicalSpace G] [MeasurableSpace G]
    (μ : Measure G) (H : Subgroup G) (μH : Measure H) (δ : G → ℝ) (s : ℂ)
    {n : ℕ} (κ : Fin n → ℂ) (W : Fin n → G → ℂ) (F : G → ℂ)
    (hint : ∀ j, Integrable (fun g : G => (W j g * F g) * ((δ g : ℝ) : ℂ) ^ (s - 1 / 2))
      (μ.withDensity (HaarQuotient.density H μH))) :
    RSCarrier.rsLocalIntegral μ H μH δ s (fun g => ∑ j, κ j * W j g) F =
      ∑ j, κ j * RSCarrier.rsLocalIntegral μ H μH δ s (W j) F := by
  simp only [RSCarrier.rsLocalIntegral]
  have : (fun g : G => ((∑ j, κ j * W j g) * F g) * ((δ g : ℝ) : ℂ) ^ (s - 1 / 2)) =
      fun g : G => ∑ j, κ j * ((W j g * F g) * ((δ g : ℝ) : ℂ) ^ (s - 1 / 2)) := by
    funext g
    rw [Finset.sum_mul, Finset.sum_mul]
    exact Finset.sum_congr rfl fun j _ => by ring
  rw [this, integral_finsetSum _ (fun j _ => (hint j).const_mul (κ j))]
  exact Finset.sum_congr rfl fun j _ => integral_const_mul _ _

