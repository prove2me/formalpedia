namespace QHNet

variable {R : Type*} [CommRing R] {W T m : ℕ}

lemma sum_histMS (h : List (ℕ × ℕ)) : (Cx.histMS h).sum = histRankSum h := by
  have := Cx.histMS_sum_map h (fun w => w)
  simp only [Multiset.map_id'] at this
  rw [this, histRankSum]
  congr 1
  refine List.map_congr_left fun p _ => ?_
  simp [mul_comm]

lemma sum_histMS_hist (C : QHNet R W T m) : (Cx.histMS C.hist).sum = C.widths.sum := by
  rw [sum_histMS, histRankSum, hist, List.map_map]
  simp [Function.comp_def]

end QHNet

/-- **No single-label network has Jain's round-six bit histogram**: its rank sum
`78410006675 = W m − 1344189` is below `W m`. -/
theorem no_bitR6_labels_sol_aux {R : Type*} [CommRing R] [Nontrivial R] {T : ℕ}
    (C : QHNet R 148225616 T 529) (hh : Cx.histMS C.hist = Cx.histMS Jain.bitR6) {q : ℕ}
    (hq : q.Prime) (hE : C.EdgesOK q) (hlab : C.LabOK q) : ¬ C.ScalarOK := by
  intro hsc
  have h1 := QHNet.widths_sum_ge C hq hE hlab hsc
  rw [← QHNet.sum_histMS_hist, hh, QHNet.sum_histMS] at h1
  revert h1
  decide

end IntMul.Kappa.R6.Bit

end

