noncomputable def weight (i k m : ℕ) : ℤ :=
  (Nat.choose k m:ℤ)*((2*i+1:ℕ):ℤ)^(k-m)

noncomputable def panelRe (i k : ℕ) : ℤ :=
  ∑ m ∈ range (k+1), weight i k m * (gamma i m).1
noncomputable def panelIm (i k : ℕ) : ℤ :=
  ∑ m ∈ range (k+1), weight i k m * (gamma i m).2

noncomputable def numeratorRe (k : ℕ) : ℤ :=
  ∑ i ∈ range 16,
    ((phaseData.getD i (0,0)).1*panelRe i k-(phaseData.getD i (0,0)).2*panelIm i k)
noncomputable def numeratorIm (k : ℕ) : ℤ :=
  ∑ i ∈ range 16,
    ((phaseData.getD i (0,0)).1*panelIm i k+(phaseData.getD i (0,0)).2*panelRe i k)

noncomputable def denominator (k : ℕ) : ℕ :=
  16*10^200*CertifiedFixedPoint.scale310*RHNextMomentInteger.weightDenominator*
    8^183*(183:ℕ).factorial*16^k*k.factorial

noncomputable def value (k : ℕ) : ℂ :=
  (3^(k+1):ℂ)*((numeratorRe k:ℂ)+Complex.I*(numeratorIm k:ℂ))/(denominator k:ℂ)

