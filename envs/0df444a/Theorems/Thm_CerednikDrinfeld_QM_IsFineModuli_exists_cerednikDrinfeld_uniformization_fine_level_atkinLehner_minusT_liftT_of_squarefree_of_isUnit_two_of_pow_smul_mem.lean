              (Scheme.nilpPoints.mapHom fMℓ (g ℓ) pℓ hpℓg).app B (Θfℓ B hB (x, (1 : G))) = ΘT ℓ B hB x)) ∧

      (∀ (ℓ : HeckeTower.AwayPrime r rbar) (B : Type) [CommRing B] [Algebra 𝒪 B] (hB : IsNilpotent (algebraMap 𝒪 B π)) (x : (AlgFunctor.prod (AlgFunctor.corep Onr) (Omega K₀ π)).obj B),
        (Scheme.nilpPoints.mapHom (g ℓ) f (d₀ ℓ) (hd₀f ℓ)).app B (ΘT ℓ B hB x) = (Scheme.nilpPoints.mapHom fM f p hp).app B (Θf B hB (x, (1 : G)))) ∧

