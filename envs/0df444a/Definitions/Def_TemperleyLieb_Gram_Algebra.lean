-- title:
--   §1–2, pp. 1–3 — Temperley–Lieb algebra, tableaux and Murphy elements
-- statement:
--   Let $S$ be a commutative ring and $\delta\in S$. The Temperley–Lieb algebra $A_n(\delta)$ is generated by $e_1,\ldots,e_{n-1}$ with
--
--   $$e_i^2=\delta e_i,\qquad e_ie_{i\pm1}e_i=e_i,\qquad e_ie_j=e_je_i\quad(|i-j|\ge2).$$
--
--   A shape $(f,n-2f)$ is represented by its cup count $f$. A standard tableau is its whole path of cup counts, starting at zero and ending at $f$, increasing by zero or one at each step while $2f_k\le k$. The definitions give the page's ordered products $w_{i,j}$, $v_t$, $v_t^*$, the shape element $m_\lambda$, and the Murphy element $m_{uv}=v_u^*m_\lambda v_v$. They also define the exact condition that a cellular datum has this family as its basis. These objects are shared by every theorem in the mission.
--
--   **Formalization Note** The quotient uses both adjacent relations. Generators have one-based indices and return zero outside $1\le i<n$; every theorem guards the range. The printed endpoint $e_{2f+1}$ in $m_\lambda$ is corrected to $e_{2f-1}$, so $m_{(0,n)}=1$. The recursive $v$ products are unrolled in the printed multiplication order. Cup-count paths use pointwise order.
-- source:
--   Enyang, Representations of Temperley–Lieb Algebras, arXiv:0710.3218v1, pp. 1–3, §§1–2, Eqs. (1.1)–(1.3), definitions of tableaux, w, v, m_lambda

import Mathlib
import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P08

noncomputable section
open scoped BigOperators

namespace TemperleyLieb.Gram

open QAlgorithms.Papers.Independent.Support21.P08
open QAlgorithms.Papers.Independent.Renew46.P16 (CellIndex)

/-- The three defining relation families (1.1)–(1.3), with both adjacent directions. -/
inductive Rel (S : Type*) [CommRing S] (δ : S) (n : ℕ) :
    FreeAlgebra S (Fin (n - 1)) → FreeAlgebra S (Fin (n - 1)) → Prop
  | sq (i : Fin (n - 1)) : Rel S δ n
      (FreeAlgebra.ι S i * FreeAlgebra.ι S i) (δ • FreeAlgebra.ι S i)
  | up (i j : Fin (n - 1)) (h : j.val = i.val + 1) : Rel S δ n
      (FreeAlgebra.ι S i * FreeAlgebra.ι S j * FreeAlgebra.ι S i) (FreeAlgebra.ι S i)
  | down (i j : Fin (n - 1)) (h : i.val = j.val + 1) : Rel S δ n
      (FreeAlgebra.ι S i * FreeAlgebra.ι S j * FreeAlgebra.ι S i) (FreeAlgebra.ι S i)
  | far (i j : Fin (n - 1)) (h : i.val + 2 ≤ j.val ∨ j.val + 2 ≤ i.val) : Rel S δ n
      (FreeAlgebra.ι S i * FreeAlgebra.ι S j) (FreeAlgebra.ι S j * FreeAlgebra.ι S i)

abbrev TL (S : Type*) [CommRing S] (δ : S) (n : ℕ) :=
  RingQuot (Rel S δ n)

/-- The one-based generator, with value zero outside its stated domain. -/
def e (S : Type*) [CommRing S] (δ : S) (n i : ℕ) : TL S δ n :=
  if h : 1 ≤ i ∧ i < n then
    RingQuot.mkAlgHom S (Rel S δ n) (FreeAlgebra.ι S ⟨i - 1, by omega⟩)
  else 0

/-- Shape `(f,n-2f)` is recorded by its cup count `f`. -/
def Tab (n : ℕ) (f : Fin (n / 2 + 1)) : Type :=
  {c : Fin (n + 1) → Fin (n / 2 + 1) //
    c 0 = 0 ∧ c (Fin.last n) = f ∧
    ∀ k : Fin n,
      (c k.succ = c k.castSucc ∨ (c k.succ : ℕ) = (c k.castSucc : ℕ) + 1) ∧
      2 * (c k.succ : ℕ) ≤ (k : ℕ) + 1}

instance (n : ℕ) (f : Fin (n / 2 + 1)) : Fintype (Tab n f) := by
  unfold Tab
  infer_instance
instance (n : ℕ) (f : Fin (n / 2 + 1)) : PartialOrder (Tab n f) := by
  unfold Tab
  infer_instance

/-- The cup count at an integer stage. The stage is guarded in all paper statements. -/
def cups {n : ℕ} {f : Fin (n / 2 + 1)} (t : Tab n f) (k : ℕ) : ℕ :=
  if h : k ≤ n then (t.1 ⟨k, by omega⟩ : ℕ) else 0

/-- `w_{i,j}` of p. 2; products follow the printed left-to-right order. -/
def w (S : Type*) [CommRing S] (δ : S) (n i j : ℕ) : TL S δ n :=
  if i < j then ((List.range' i (j - i)).map (e S δ n)).prod
  else if j < i then (((List.range' j (i - j)).reverse).map (e S δ n)).prod
  else 1

/-- Corrected p. 2 product `e₁e₃⋯e_{2f−1}` with `f` factors. -/
def mLam (S : Type*) [CommRing S] (δ : S) (n f : ℕ) : TL S δ n :=
  ((List.range f).map (fun j => e S δ n (2 * j + 1))).prod

def cupStep {n : ℕ} {f : Fin (n / 2 + 1)} (t : Tab n f) (k : ℕ) : Bool :=
  decide (cups t k = cups t (k - 1) + 1)

/-- The left factor introduced when stage `k` adds a cup. -/
def stepW (S : Type*) [CommRing S] (δ : S) {n : ℕ} {f : Fin (n / 2 + 1)}
    (t : Tab n f) (k : ℕ) : TL S δ n :=
  if cupStep t k then w S δ n (2 * cups t k) k else 1

/-- The right factor introduced when stage `k` adds a cup. -/
def stepWStar (S : Type*) [CommRing S] (δ : S) {n : ℕ} {f : Fin (n / 2 + 1)}
    (t : Tab n f) (k : ℕ) : TL S δ n :=
  if cupStep t k then w S δ n k (2 * cups t k) else 1

/-- The p. 2 recursion for `v_t`, unrolled from stage `n` to stage `1`. -/
def vElt (S : Type*) [CommRing S] (δ : S) {n : ℕ} {f : Fin (n / 2 + 1)}
    (t : Tab n f) : TL S δ n :=
  ((List.range n).reverse.map (fun j => stepW S δ t (j + 1))).prod

/-- The p. 2 recursion for `v_t*`, unrolled from stage `1` to stage `n`. -/
def vStar (S : Type*) [CommRing S] (δ : S) {n : ℕ} {f : Fin (n / 2 + 1)}
    (t : Tab n f) : TL S δ n :=
  ((List.range n).map (fun j => stepWStar S δ t (j + 1))).prod

/-- The displayed Murphy element `m_uv = v*_u m_λ v_v`. -/
def murphy (S : Type*) [CommRing S] (δ : S) (n : ℕ)
    (z : CellIndex (Fin (n / 2 + 1)) (Tab n)) : TL S δ n :=
  vStar S δ z.2.1 * mLam S δ n z.1 * vElt S δ z.2.2

/-- A cellular datum whose basis is the displayed Murphy family. -/
def IsMurphyDatum (S : Type*) [CommRing S] (δ : S) (n : ℕ)
    (D : CellDatum (R := S) (A := TL S δ n) (T := Tab n)) : Prop :=
  ∀ z, D.basis z = murphy S δ n z

/-- The number of standard up–down tableaux of shape `(f,n−2f)`. -/
def dimShape (n : ℕ) (f : Fin (n / 2 + 1)) : ℕ := Fintype.card (Tab n f)

end TemperleyLieb.Gram


