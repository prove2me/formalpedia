variable {G : Type*} [CommGroup G]

private theorem iterate_apply_mem_mul_of_mem (H : Subgroup G) (φ : G →* G) (hH : ∀ x ∈ H, φ x ∈ H) {z : G}
    (hz : φ z = z)
    {c : G} (hc : ∃ x ∈ H, c = z * x) (i : ℕ) : ∃ x ∈ H, (⇑φ)^[i] c = z * x := by
  induction i with
  | zero => simpa using hc
  | succ i ih =>
    obtain ⟨x, hx, hix⟩ := ih
    exact ⟨φ x, hH x hx, by rw [Function.iterate_succ_apply', hix, map_mul, hz]⟩

private theorem sigmaNormPow_eq_pow_mul_of_mem (H : Subgroup G) (φ : G →* G) (hH : ∀ x ∈ H, φ x ∈ H) {z : G}
    (hz : φ z = z)
    {c : G} (hc : ∃ x ∈ H, c = z * x) (n : ℕ) : ∃ y ∈ H, sigmaNormPow φ n c = z ^ n * y := by
  rw [sigmaNormPow_def, sigmaPartialNorm_eq_prod_range]
  induction n with
  | zero => exact ⟨1, H.one_mem, by simp⟩
  | succ n ih =>
    obtain ⟨y, hy, hny⟩ := ih
    obtain ⟨x, hx, hnx⟩ := iterate_apply_mem_mul_of_mem H φ hH hz hc n
    exact ⟨y * x, H.mul_mem hy hx, by rw [Finset.prod_range_succ, hny, hnx, mul_mul_mul_comm, ← pow_succ]⟩

end LT.TwistedNorm
