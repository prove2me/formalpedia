theorem solution.{u_1, u_2} : type_of% @OAI.KadisonKastler.exists_minimal_familyRowFamily_oai.{u_1, u_2} := @OAI.KadisonKastler.exists_minimal_familyRowFamily_oai.{u_1, u_2}
