-- Source module: Solutions.R6SLib
/-!
# Round-six setup, part 2: register-program lemmas on managed states

All setup states are `encK s f` (`KIL`): the lists `f j` of integers pushed over the state `s`
after the reads. A step is a `Sp p s t c` (ok, run, cost). Every cost is a multiple of the unit
`kU Bb = 10^7 (Bb+2)^2` for a uniform bit bound `Bb`.

* `sp_push`, `sp_asg`, `sp_pop`: single steps.
* `sp_rep`: a counted loop `rep C (reg R) b` through a family of managed states.
* **`sp_cnt`** (`cntR`): `#{x ∈ [1, N] : Pr x}` by a test expression.
* **`sp_sum`** (`sumR`): `Σ_{y=1}^{c} y · [y g ≡ 1 (mod c)]`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFM RS Finset Function

/-- The cost unit. -/
def kU (Bb : ℕ) : ℕ := 10 ^ 7 * (Bb + 2) ^ 2

/-! ## Single steps -/

/-! ## Counted loops -/

/-! ## Counting -/

/-- `rd := #{x ∈ [1, N] : tst(x) < 0}` (`N` on `R`, the candidate `x` on the counter `C`). -/
def cntR (C rd R : Fin HS) (tst : Ex HS) : RS :=
  .seq (.push rd (.lit 0)) (.rep C (.reg R) (.asg rd (.add (.reg rd) (.sel tst (.lit 1) (.lit 0)))))

/-! ## The inverse sum -/

/-- `[y g mod c = 1]` (`c` on `Rc`, `g` on `Rg`, `y` on `Cy`). -/
def indR (Cy Rc Rg : Fin HS) : Ex HS :=
  .ndiv (.add (.reg Rc) (.neg (.nmod (.add (.nmod (.mul (.reg Cy) (.reg Rg)) (.reg Rc))
    (.add (.reg Rc) (.lit (-1)))) (.reg Rc)))) (.reg Rc)

/-- `Rm := Rm + Σ_{y=1}^{c} y [y g ≡ 1]`. -/
def sumR (Cy Rc Rg Rm : Fin HS) : RS :=
  .rep Cy (.reg Rc) (.asg Rm (.add (.reg Rm) (.mul (.reg Cy) (indR Cy Rc Rg))))

/-- The summand. -/
def sumT (c g : ℕ) (y : ℕ) : ℤ := (y : ℤ) * (if ((y : ℤ) * (g : ℤ)) % (c : ℤ) = 1 then 1 else 0)

end IntMul.Kappa.R6

end

