  rw [show ((2 : ℂ) ^ k).re = 2 ^ k by exact_mod_cast (ofReal_pow (2 : ℝ) k).symm ▸ ofReal_re _,
    show ((2 : ℂ) ^ k).im = 0 by exact_mod_cast (ofReal_pow (2 : ℝ) k).symm ▸ ofReal_im _]
  field_simp
  ring

