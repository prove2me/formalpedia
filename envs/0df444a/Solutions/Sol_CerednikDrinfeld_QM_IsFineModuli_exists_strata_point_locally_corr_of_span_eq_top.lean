theorem finrank_act_rpow_eq_of_isPullbackVia_id {S : Type} [CommRing S] (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    (r : ℕ) [Fact r.Prime] (E E' : FakeEllipticCurve Λ N S) (uA : E'.A ⟶ E.A)
    (huA : FakeEllipticCurve.IsPullbackVia (RingHom.id S) E E' uA) (k : ℕ) (y' : ↥E'.A) :
