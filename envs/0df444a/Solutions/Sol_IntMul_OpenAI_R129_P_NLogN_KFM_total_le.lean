  have : 1 ≤ b0 := b0_ge 0 (by norm_num)
  exact max_eq_left (by omega)

lemma n_le {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : n ≤ 2 ^ bP n := by
  rw [bP_eq hn]; exact Nat.le_pow_clog (by norm_num) n

lemma n_gt {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : 2 ^ (bP n - 1) < n := by
  have h2 : 2 ≤ n0 := by
    have : 2 ^ 1 ≤ 2 ^ b0 := Nat.pow_le_pow_right (by norm_num) (b0_ge 0 (by norm_num))
    simpa [IntMul.OpenAI.Glue.n0] using this
  rw [bP_eq hn]
  have := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) (show 1 < n by omega)
  simpa [Nat.pred_eq_sub_one] using this

/-- Facts about `L` and `T` (`b ≥ 16`). -/
lemma L_facts {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) :
    4 * n ≤ IntMul.OpenAI.Glue.TP n * bP n ∧ IntMul.OpenAI.Glue.TP n * bP n < 8 * n ∧ IntMul.OpenAI.Glue.LP n < bP n ∧ bP n ≤ 2 * IntMul.OpenAI.Glue.LP n := by
  have hb : 2 ^ 4 ≤ bP n := (b0_ge 4 (by norm_num)).trans (b_ge hn)
  have hb' : 16 ≤ bP n := by simpa using hb
  have hle := n_le hn
  have hgt := n_gt hn
  set b := bP n with hbdef
  have hpow : 2 ^ b = 2 * 2 ^ (b - 1) := by
    rw [← pow_succ']; congr 1; omega
  have spec : 4 * n ≤ 2 ^ IntMul.OpenAI.Glue.LP n * b := Nat.find_spec (LP_exists n)
  -- `L < b`
  have hLb : IntMul.OpenAI.Glue.LP n ≤ b - 1 := by
    apply Nat.find_min' (LP_exists n)
    show 4 * n ≤ 2 ^ (b - 1) * b
    have : 4 * n ≤ 8 * 2 ^ (b - 1) := by omega
    nlinarith
  -- `b ≤ 2L`
  have h2L : b ≤ 2 * IntMul.OpenAI.Glue.LP n := by
    by_contra hcon
    push Not at hcon
    have hhalf : IntMul.OpenAI.Glue.LP n + b / 2 ≤ b := by omega
    have h1 : b < 2 ^ (b / 2) := lin_lt_pow_half b hb'
    have h3 : 2 ^ IntMul.OpenAI.Glue.LP n * b < 2 ^ IntMul.OpenAI.Glue.LP n * 2 ^ (b / 2) := Nat.mul_lt_mul_of_pos_left h1 (by positivity)
    have h4 : 2 ^ IntMul.OpenAI.Glue.LP n * 2 ^ (b / 2) ≤ 2 ^ b := by
      rw [← pow_add]; exact Nat.pow_le_pow_right (by norm_num) hhalf
    omega
  -- `T b < 8n`
  have hTb : IntMul.OpenAI.Glue.TP n * b < 8 * n := by
    have hL1 : 1 ≤ IntMul.OpenAI.Glue.LP n := by omega
    have hmin : ¬ 4 * n ≤ 2 ^ (IntMul.OpenAI.Glue.LP n - 1) * b := Nat.find_min (LP_exists n) (m := IntMul.OpenAI.Glue.LP n - 1)
      (by show IntMul.OpenAI.Glue.LP n - 1 < IntMul.OpenAI.Glue.LP n; omega)
    have : IntMul.OpenAI.Glue.TP n = 2 * 2 ^ (IntMul.OpenAI.Glue.LP n - 1) := by
      rw [IntMul.OpenAI.Glue.TP, ← pow_succ']; congr 1; omega
    rw [this]; push Not at hmin; nlinarith
  exact ⟨spec, hTb, by omega, h2L⟩

end
end IntMul.OpenAI.Glue
