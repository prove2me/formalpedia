variable {v : HeightOneSpectrum (𝓞 ℚ)}

private theorem modulus_coe_inv_eq_one
    {u : (v.adicCompletion ℚ)ˣ} (hu : TateLocal.modulus (u : v.adicCompletion ℚ) = 1) :
    TateLocal.modulus ((u⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = 1 := by
  have h := TateLocal.modulus_mul (u : v.adicCompletion ℚ) ((u⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)
  rw [Units.mul_inv, TateLocal.modulus_one, hu, one_mul] at h
  exact h.symm

private theorem modulus_coe_pow_eq_one
    {u : (v.adicCompletion ℚ)ˣ} (hu : TateLocal.modulus (u : v.adicCompletion ℚ) = 1)
    (n : ℕ) : TateLocal.modulus ((u ^ n : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = 1 := by
  induction n with
  | zero => simp
  | succ n ih => rw [pow_succ, Units.val_mul, TateLocal.modulus_mul, ih, hu, one_mul]

end
