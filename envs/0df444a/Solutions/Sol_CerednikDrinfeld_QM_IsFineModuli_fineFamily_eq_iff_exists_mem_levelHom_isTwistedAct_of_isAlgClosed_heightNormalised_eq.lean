theorem frobTwist_apply (n : ℤ) {B : Type} [CommRing B] [Algebra 𝒪 B] (ψ : Onr →ₐ[𝒪] B) (y : Onr) :
    frobTwist Onr Fr n ψ y = ψ ((Fr ^ n) y) := rfl

