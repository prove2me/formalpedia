variable {K : UQ} (B : InvAlg K)

theorem GlobalTheory.UnitLemma.OrthBasis.repr_mul {n : ℕ} (e : Module.Basis (Fin n) K.E B.A) (g z : B.A) (i : Fin n) :
    e.repr (g * z) i = ∑ j, e.repr z j * e.repr (g * e j) i := by sorry
