private theorem contDiff_slice_line_c_of_continuous {χ₁ χ₂ : 𝔸ˣ →* ℂˣ} {φ : AdelicGL2 (𝓞 F) F → ℂ}
    (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (hφc : Continuous φ) (hK : IsArchKFiniteAt F w φ)
    (x : AdelicGL2 (𝓞 F) F) (a : 𝔸) (θ : ℝ) :
    ContDiff ℝ ∞ fun t : ℝ =>
      φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + mkAdele F (archDirCθ hw θ t) 0) * x) := by
  by_cases h0 : φ = 0
  · subst h0
    simpa only [Pi.zero_apply] using contDiff_const
  obtain ⟨g₀, hg₀⟩ := Function.ne_iff.1 h0
  have hc := continuous_chi_complexIdeleAt_of_apply_ne_zero hw hφ hφc hg₀
  exact contDiff_slice_line_c hw hφ hφc hK hc.1 hc.2 (fun θ' t => mkAdele F (archDirCθ hw θ' t) 0)
    (fun θ' t => by rw [fst_mkAdele]; exact archDirCθ_apply_self hw θ' t)
    (fun θ' t v hvw => by rw [fst_mkAdele]; exact archDirCθ_apply_of_ne hw θ' t hvw) (fun _ _ => rfl) x a θ

private theorem exists_iteratedDeriv_slice_le_rpow_Dy_line_c
    (α : 𝔸ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ)) (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    (μ ν : 𝔸ˣ →* ℂˣ) (hμ : IsUnitaryChar (𝓞 F) F μ) (hν : IsUnitaryChar (𝓞 F) F ν)
    (s : ℂ) (hσ : 0 ≤ s.re + 1 / 2)
    (φ : AdelicGL2 (𝓞 F) F → ℂ) (hφ : IsInducedSection (𝓞 F) F (etaFst μ α hα s) (etaSnd ν α hα s) φ)
    (hφc : Continuous φ) (hK : IsArchKFiniteAt F w φ) (S : Set (AdelicGL2 (𝓞 F) F)) (hS : IsCompact S)
    (n : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ S, ∀ (a : 𝔸) (θ y : ℝ),
      ‖iteratedDeriv n
          (fun y => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + mkAdele F (archDirCθ hw θ y) 0) * x)) y‖
        ≤ C * Dy F (a + mkAdele F (archDirCθ hw θ y) 0) ^ (-(2 * s.re + 1)) := by
  by_cases h0 : φ = 0
  · subst h0
    exact ⟨0, le_rfl, fun x _ a θ y => by simp⟩
  obtain ⟨g₀, hg₀⟩ := Function.ne_iff.1 h0
  have hc := continuous_chi_complexIdeleAt_of_apply_ne_zero hw hφ hφc hg₀
  have hτ : (0 : ℝ) ≤ 2 * s.re + 1 := by linarith
  obtain ⟨m, kv, -, hD3⟩ := exists_slice_iteratedDeriv_bound_c hw hφ hφc hK hτ hc.1 hc.2
    (fun r => (norm_etaFst_complexIdeleAt hw α hα hαΔ hμ s r).le)
    (fun r => (norm_etaSnd_complexIdeleAt hw α hα hαΔ hν s r).le)
    (fun θ' t => mkAdele F (archDirCθ hw θ' t) 0)
    (fun θ' t => by rw [fst_mkAdele]; exact archDirCθ_apply_self hw θ' t)
    (fun θ' t v hvw => by rw [fst_mkAdele]; exact archDirCθ_apply_of_ne hw θ' t hvw)
    (fun _ _ => rfl)
  obtain ⟨C₃, hC₃, hle⟩ := hD3 S hS n

  have hKc : IsCompact (⋃ i : Fin m, (fun x => reshapeAt F w x * kv i) '' S) :=
    isCompact_iUnion fun i => hS.image ((continuous_reshapeAt F w).mul continuous_const)
  obtain ⟨B, hB0, hB⟩ := norm_apply_weyl_unipotent_le_uniform F α hα μ ν s φ hμ hν hφ hφc hKc
  rw [adelicWeyl_inv' F] at hB
  refine ⟨C₃ * ((m : ℝ) * B), mul_nonneg hC₃ (mul_nonneg (Nat.cast_nonneg _) hB0), fun x hx a θ y => ?_⟩
  have hmult : w.mult = 2 := NumberField.InfinitePlace.mult_isComplex ⟨w, hw⟩
  have hi : ∀ i : Fin m, ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖
      ≤ B * Dy F (zeroAt F w a) ^ (-(2 * s.re + 1)) := fun i => by
    have hmem : reshapeAt F w x * kv i ∈ ⋃ i : Fin m, (fun x => reshapeAt F w x * kv i) '' S :=
      Set.mem_iUnion.2 ⟨i, Set.mem_image_of_mem (fun x => reshapeAt F w x * kv i) hx⟩
    have h := hB _ hmem (zeroAt F w a)
    rw [hαΔ] at h
    change _ ≤ B * Dy F (zeroAt F w a) ^ (-(2 * s.re + 1)) at h
    rw [awayFrom_weyl_unipotent_eq_reshapeAt F w x a]
    simpa only [mul_assoc] using h
  have hsum : ∑ i, ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖
      ≤ (m : ℝ) * (B * Dy F (zeroAt F w a) ^ (-(2 * s.re + 1))) := by
    have h := Finset.sum_le_card_nsmul (Finset.univ : Finset (Fin m))
      (fun i => ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖) _ fun i _ => hi i
    rwa [Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at h

  have h1' : ∀ v, v ≠ w → (zeroAt F w a).1 v = (a + mkAdele F (archDirCθ hw θ y) 0).1 v := fun v hvw => by
    rw [zeroAt_fst_of_ne F a hvw]
    show a.1 v = a.1 v + (mkAdele F (archDirCθ hw θ y) 0).1 v
    rw [fst_mkAdele, archDirCθ_apply_of_ne hw θ y hvw, add_zero]
  have h3' : (zeroAt F w a).2 = (a + mkAdele F (archDirCθ hw θ y) 0).2 := by
    show a.2 = a.2 + (mkAdele F (archDirCθ hw θ y) 0).2
    exact (add_zero a.2).symm
  have hsplit : Dy F (a + mkAdele F (archDirCθ hw θ y) 0)
      = max 1 ‖(a + mkAdele F (archDirCθ hw θ y) 0).1 w‖ ^ 2 * Dy F (zeroAt F w a) := by
    rw [Dy_eq_max_mul_Dy_of_agree F w h1' (zeroAt_fst_self F w a) h3', hmult]
  have hM0 : (0 : ℝ) ≤ max 1 ‖(a + mkAdele F (archDirCθ hw θ y) 0).1 w‖ := zero_le_one.trans (le_max_left _ _)
  have hD0 : (0 : ℝ) ≤ Dy F (zeroAt F w a) := (Dy_pos F _).le
  have hD := hle x hx a θ y
  have hexp : max 1 ‖(a + mkAdele F (archDirCθ hw θ y) 0).1 w‖ ^ (-(2 * (2 * s.re + 1)))
      = (max 1 ‖(a + mkAdele F (archDirCθ hw θ y) 0).1 w‖ ^ 2) ^ (-(2 * s.re + 1)) := by
    rw [← Real.rpow_natCast (max 1 ‖(a + mkAdele F (archDirCθ hw θ y) 0).1 w‖) 2, ← Real.rpow_mul hM0]
    congr 1
    push_cast
    ring
  calc ‖iteratedDeriv n
          (fun y => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + mkAdele F (archDirCθ hw θ y) 0) * x)) y‖
      ≤ C₃ * max 1 ‖(a + mkAdele F (archDirCθ hw θ y) 0).1 w‖ ^ (-(2 * (2 * s.re + 1)))
          * ∑ i, ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖ := hD
    _ ≤ C₃ * max 1 ‖(a + mkAdele F (archDirCθ hw θ y) 0).1 w‖ ^ (-(2 * (2 * s.re + 1)))
          * ((m : ℝ) * (B * Dy F (zeroAt F w a) ^ (-(2 * s.re + 1)))) :=
        mul_le_mul_of_nonneg_left hsum (mul_nonneg hC₃ (Real.rpow_nonneg hM0 _))
    _ = C₃ * ((m : ℝ) * B)
          * ((max 1 ‖(a + mkAdele F (archDirCθ hw θ y) 0).1 w‖ ^ 2 * Dy F (zeroAt F w a)) ^ (-(2 * s.re + 1))) := by
        rw [Real.mul_rpow (pow_nonneg hM0 2) hD0, hexp]; ring
    _ = C₃ * ((m : ℝ) * B) * Dy F (a + mkAdele F (archDirCθ hw θ y) 0) ^ (-(2 * s.re + 1)) := by rw [hsplit]

private theorem exists_summable_slice_majorant_line_c
    (α : 𝔸ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ)) (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    (μ ν : 𝔸ˣ →* ℂˣ) (hμ : IsUnitaryChar (𝓞 F) F μ) (hν : IsUnitaryChar (𝓞 F) F ν)
    (s : ℂ) (hσ : 0 ≤ s.re + 1 / 2)
    (φ : AdelicGL2 (𝓞 F) F → ℂ) (hφ : IsInducedSection (𝓞 F) F (etaFst μ α hα s) (etaSnd ν α hα s) φ)
    (hφc : Continuous φ) (hK : IsArchKFiniteAt F w φ)
    {z : F → 𝔸} (hz : Summable fun ξ : F => Dy F (z ξ) ^ (-(2 * s.re + 1))) (x : AdelicGL2 (𝓞 F) F) (θ : ℝ)
    (k : ℕ) (R : ℝ) (hR : 0 ≤ R) :
    ∃ M : F → ℝ, Summable M ∧ ∀ (ξ : F) (y : ℝ), |y| ≤ R →
      ‖iteratedDeriv k
          (fun y => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (z ξ + mkAdele F (archDirCθ hw θ y) 0) * x)) y‖
        ≤ M ξ := by
  obtain ⟨C, hC, hle⟩ := exists_iteratedDeriv_slice_le_rpow_Dy_line_c hw α hα hαΔ μ ν hμ hν s hσ φ hφ hφc hK
    {x} isCompact_singleton k
  have he : (0 : ℝ) ≤ 2 * s.re + 1 := by linarith
  refine ⟨fun ξ => C * (((1 + R) ^ (∑ v : InfinitePlace F, v.mult)) ^ (2 * s.re + 1)
      * Dy F (z ξ) ^ (-(2 * s.re + 1))),
    (hz.mul_left _).mul_left C, fun ξ y hy => (hle x (Set.mem_singleton x) (z ξ) θ y).trans
      (mul_le_mul_of_nonneg_left ?_ hC)⟩
  have hu1 : ∀ v, ‖(-(mkAdele F (archDirCθ hw θ y) 0)).1 v‖ ≤ R := fun v => by
    show ‖-((mkAdele F (archDirCθ hw θ y) 0).1 v)‖ ≤ R
    rw [norm_neg, fst_mkAdele]
    by_cases hvw : v = w
    · rw [hvw, archDirCθ_apply_self hw θ y, norm_ringEquivComplexOfIsComplex_symm hw, norm_mul,
        Complex.norm_exp_ofReal_mul_I, mul_one, Complex.norm_real, Real.norm_eq_abs]
      exact hy
    · rw [archDirCθ_apply_of_ne hw θ y hvw, norm_zero]
      exact hR
  have hu2 : (-(mkAdele F (archDirCθ hw θ y) 0)).2 ∈ AdelicBox.integralFiniteAdeles (𝓞 F) F := by
    show -((mkAdele F (archDirCθ hw θ y) 0).2) ∈ AdelicBox.integralFiniteAdeles (𝓞 F) F
    rw [show (mkAdele F (archDirCθ hw θ y) 0).2 = 0 from rfl, neg_zero]
    exact fun v => (v.adicCompletionIntegers F).zero_mem
  have h := rpow_Dy_le_translate_of_le F (z ξ + mkAdele F (archDirCθ hw θ y) 0)
    (-(mkAdele F (archDirCθ hw θ y) 0)) hu1 hu2 he
  rwa [add_neg_cancel_right] at h

private theorem bigCellArch_flow_eq_line_c (φ : AdelicGL2 (𝓞 F) F → ℂ) (z : F → 𝔸) (x : AdelicGL2 (𝓞 F) F)
    (u : InfiniteAdeleRing F) (θ : ℝ) :
    (fun r : ℝ => bigCellArch φ z x (u + archDirCθ hw θ r))
      = fun r : ℝ => ∑' ξ : F,
          φ (adelicWeyl (𝓞 F) F * unipotentGL2 (transFamily z u ξ + mkAdele F (archDirCθ hw θ r) 0) * x) := by
  funext r
  simp only [bigCellArch_apply, transFamily_apply]
  refine tsum_congr fun ξ => ?_
  rw [add_assoc, mkAdele_add, add_zero]

private theorem contDiff_bigCellArch_flow_line_c
    (α : 𝔸ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ)) (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    (μ ν : 𝔸ˣ →* ℂˣ) (hμ : IsUnitaryChar (𝓞 F) F μ) (hν : IsUnitaryChar (𝓞 F) F ν)
    (s : ℂ) (hσ : 0 ≤ s.re + 1 / 2)
    (φ : AdelicGL2 (𝓞 F) F → ℂ) (hφ : IsInducedSection (𝓞 F) F (etaFst μ α hα s) (etaSnd ν α hα s) φ)
    (hφc : Continuous φ) (hK : IsArchKFiniteAt F w φ)
    {z : F → 𝔸} (hz : Summable fun ξ : F => Dy F (z ξ) ^ (-(2 * s.re + 1))) (x : AdelicGL2 (𝓞 F) F)
    (u : InfiniteAdeleRing F) (θ : ℝ) :
    ContDiff ℝ ∞ fun r : ℝ => bigCellArch φ z x (u + archDirCθ hw θ r) := by
  rw [bigCellArch_flow_eq_line_c hw φ z x u θ]
  have hz' := summable_rpow_Dy_transFamily (F := F) (by linarith) hz u
  exact M4aP3B.SliceSum.contDiff_tsum_of_local_bound
    (fun ξ r => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (transFamily z u ξ + mkAdele F (archDirCθ hw θ r) 0) * x))
    (fun ξ => contDiff_slice_line_c_of_continuous hw hφ hφc hK x (transFamily z u ξ) θ)
    (fun j R hR => exists_summable_slice_majorant_line_c hw α hα hαΔ μ ν hμ hν s hσ φ hφ hφc hK hz' x θ j R hR)

private theorem norm_iteratedDeriv_bigCellArch_flow_le_line_c
    (α : 𝔸ˣ →* ℝˣ) (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ)) (hαΔ : ∀ x, ((α x : ℝˣ) : ℝ) = (distribHaarChar 𝔸 x : ℝ))
    (μ ν : 𝔸ˣ →* ℂˣ) (hμ : IsUnitaryChar (𝓞 F) F μ) (hν : IsUnitaryChar (𝓞 F) F ν)
    (s : ℂ) (hσ : 0 ≤ s.re + 1 / 2)
    (φ : AdelicGL2 (𝓞 F) F → ℂ) (hφ : IsInducedSection (𝓞 F) F (etaFst μ α hα s) (etaSnd ν α hα s) φ)
    (hφc : Continuous φ) (hK : IsArchKFiniteAt F w φ) (S : Set (AdelicGL2 (𝓞 F) F)) (hS : IsCompact S)
    (k : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ S, ∀ (z : F → 𝔸) (_ : Summable fun ξ : F => Dy F (z ξ) ^ (-(2 * s.re + 1)))
      (u : InfiniteAdeleRing F) (θ : ℝ),
      ‖iteratedDeriv k (fun r : ℝ => bigCellArch φ z x (u + archDirCθ hw θ r)) 0‖
        ≤ C * ∑' ξ : F, Dy F (transFamily z u ξ) ^ (-(2 * s.re + 1)) := by
  obtain ⟨C, hC0, hC⟩ :=
    exists_iteratedDeriv_slice_le_rpow_Dy_line_c hw α hα hαΔ μ ν hμ hν s hσ φ hφ hφc hK S hS k
  refine ⟨C, hC0, fun x hx z hz u θ => ?_⟩
  have hz' := summable_rpow_Dy_transFamily (F := F) (by linarith) hz u
  have hloc : ∀ (j : ℕ) (R : ℝ), 0 ≤ R → ∃ M : F → ℝ, Summable M ∧ ∀ (ξ : F) (y : ℝ), |y| ≤ R →
      ‖iteratedDeriv j (fun y => φ (adelicWeyl (𝓞 F) F
        * unipotentGL2 (transFamily z u ξ + mkAdele F (archDirCθ hw θ y) 0) * x)) y‖ ≤ M ξ :=
    fun j R hR => exists_summable_slice_majorant_line_c hw α hα hαΔ μ ν hμ hν s hσ φ hφ hφc hK hz' x θ j R hR
  have hexch : iteratedDeriv k (fun r : ℝ => ∑' ξ : F,
        φ (adelicWeyl (𝓞 F) F * unipotentGL2 (transFamily z u ξ + mkAdele F (archDirCθ hw θ r) 0) * x)) 0
      = ∑' ξ : F, iteratedDeriv k (fun r : ℝ =>
          φ (adelicWeyl (𝓞 F) F * unipotentGL2 (transFamily z u ξ + mkAdele F (archDirCθ hw θ r) 0) * x)) 0 :=
    M4aP3B.SliceSum.iteratedDeriv_tsum_of_local_bound
      (fun ξ r => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (transFamily z u ξ + mkAdele F (archDirCθ hw θ r) 0) * x))
      (fun ξ => contDiff_slice_line_c_of_continuous hw hφ hφc hK x (transFamily z u ξ) θ) hloc k 0
  have hsum : Summable fun ξ : F => iteratedDeriv k (fun r : ℝ =>
      φ (adelicWeyl (𝓞 F) F * unipotentGL2 (transFamily z u ξ + mkAdele F (archDirCθ hw θ r) 0) * x)) 0 :=
    M4aP3B.SliceSum.summable_iteratedDeriv_apply_of_local_bound
      (fun ξ r => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (transFamily z u ξ + mkAdele F (archDirCθ hw θ r) 0) * x))
      k (hloc k) 0
  have hterm : ∀ ξ : F, ‖iteratedDeriv k (fun r : ℝ =>
      φ (adelicWeyl (𝓞 F) F * unipotentGL2 (transFamily z u ξ + mkAdele F (archDirCθ hw θ r) 0) * x)) 0‖
        ≤ C * Dy F (transFamily z u ξ) ^ (-(2 * s.re + 1)) := fun ξ => by
    have h := hC x hx (transFamily z u ξ) θ 0
    rwa [map_zero, show mkAdele F (0 : InfiniteAdeleRing F) (0 : FiniteAdeleRing (𝓞 F) F) = (0 : 𝔸) from rfl,
      add_zero] at h
  rw [bigCellArch_flow_eq_line_c hw φ z x u θ, hexch]
  refine (norm_tsum_le_tsum_norm hsum.norm).trans ?_
  rw [← tsum_mul_left]
  exact hsum.norm.tsum_le_tsum hterm (hz'.mul_left C)

