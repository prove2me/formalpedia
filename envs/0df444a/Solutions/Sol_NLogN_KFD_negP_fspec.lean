  · refine H.ok hC5 hnc hno ?_
    intro k hk
    rw [hN] at hk ⊢
    rw [withCtr_encK C s _ _ (hC 0) (hC k)]
    exact (hb k hk).1
  · rw [H.run, hN]
  · have := fcost_rep_le H c (by
      intro k hk
      rw [hN] at hk ⊢
      rw [withCtr_encK C s _ _ (hC 0) (hC k)]
      exact (hb k hk).2.2)
    rw [hN] at this
    exact this

