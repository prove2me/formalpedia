theorem length_cycZ (F : ℤ) (K : ℕ) (A B : List ℤ) : (cycZ F K A B).length = K := by
  simp [cycZ]

theorem length_pmulZ (F : ℤ) : ∀ (A B : List ℤ), A.length = B.length →
    (pmulZ F A B).length = A.length
  | [], [], _ => rfl
  | a :: A, b :: B, h => by
    simp only [pmulZ, List.length_cons, add_left_inj] at h ⊢; exact length_pmulZ F A B h
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h

theorem pmulZ_getD (F : ℤ) : ∀ (A B : List ℤ) (i : ℕ), i < A.length → A.length = B.length →
    (pmulZ F A B).getD i 0 = (A.getD i 0 * B.getD i 0) % F
  | a :: A, b :: B, 0, _, _ => by simp [pmulZ]
  | a :: A, b :: B, i + 1, hi, hl => by
    simp only [pmulZ, List.getD_cons_succ]
    exact pmulZ_getD F A B i (by simpa using hi) (by simpa using hl)
  | [], _, _, hi, _ => by simp at hi
  | _ :: _, [], _, _, hl => by simp at hl

theorem canon_cycZ {F : ℤ} (hF : 0 < F) (K : ℕ) (A B : List ℤ) : Canon F (cycZ F K A B) := by
  intro x hx
  simp only [cycZ, List.mem_map, List.mem_range] at hx
  obtain ⟨m, _, rfl⟩ := hx
  exact ⟨Int.emod_nonneg _ hF.ne', Int.emod_lt_of_pos _ hF⟩

theorem canon_pmulZ {F : ℤ} (hF : 0 < F) : ∀ A B : List ℤ, Canon F (pmulZ F A B)
  | a :: A, b :: B => by
    intro x hx; simp only [pmulZ, List.mem_cons] at hx
    rcases hx with rfl | hx
    · exact ⟨Int.emod_nonneg _ hF.ne', Int.emod_lt_of_pos _ hF⟩
    · exact canon_pmulZ hF A B x hx
  | [], _ => by intro x hx; simp [pmulZ] at hx
  | _ :: _, [] => by intro x hx; simp [pmulZ] at hx

/-- Canonical lists with equal images in `ℤ/F` are equal. -/
theorem canon_ext {n : ℕ} {A B : List ℤ} (hA : Canon (2 ^ n + 1) A) (hB : Canon (2 ^ n + 1) B)
    (hl : A.length = B.length)
    (h : ∀ i < A.length, ((A.getD i 0 : ℤ) : ZMod (2 ^ n + 1)) = ((B.getD i 0 : ℤ) : ZMod (2 ^ n + 1))) :
    A = B := by
  apply List.ext_getElem hl
  intro i h1 h2
  have e := h i h1
  rw [ZMod.intCast_eq_intCast_iff'] at e
  push_cast at e
  simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h1,
    List.getElem?_eq_getElem h2, Option.getD_some] at e
  have ha := hA _ (List.getElem_mem h1)
  have hb := hB _ (List.getElem_mem h2)
  rwa [Int.emod_eq_of_lt ha.1 ha.2, Int.emod_eq_of_lt hb.1 hb.2] at e

