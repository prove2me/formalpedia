          Set ↥(pullback (ModularCurve.TwoChart.modelTo A (↥K) j) (specMap A (Localization.Away f)))))
      (_ : Pairwise fun i j => Disjoint (Set.range (z i).base) (Set.range (z j).base))
      (_ : ∀ (k : Type) [Field k] [IsAlgClosed k] (s : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of (Localization.Away f)))
        (i : Fin Mb),
