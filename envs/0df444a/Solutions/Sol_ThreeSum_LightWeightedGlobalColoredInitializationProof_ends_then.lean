private theorem budgeted_segment {μ ν : ℕ → ℤ} {seed constants K bDigit n J nO : ℕ} {xs : List ℤ}
    (hlen : xs.length = 48) (H : Seg μ seed xs) (HB : Seg ν (seed + 41) (budgetValues K bDigit n J nO))
    (HK : ∀ x, (x < seed + 41 ∨ seed + 47 ≤ x) → (x < constants ∨ constants + 3 ≤ x) → ν x = μ x)
    (hconstants : seed + 48 ≤ constants) : Seg ν seed (budgetedValues xs K bDigit n J nO) :=
  by
  intro i hi
  have hii : i < 48 := by simpa only [budgetedValues, List.length_ofFn] using hi
  simp only [budgetedValues, List.getElem_ofFn]
  split_ifs with hb
  · have hj : i - 41 < (budgetValues K bDigit n J nO).length := by
      simp only [budgetValues, List.length_cons, List.length_nil]; omega
    have hh := HB.getD hj 0
    rw [show seed + i = seed + 41 + (i - 41) by omega]
    exact hh
  · rw [HK _ (by omega) (Or.inl (by omega))]
    exact (H.getD (by omega) 0)
private theorem template_call {lim : Limits} {radix D E K bDigit a b scaleBase p R F U af q depth : ℕ} (raws : List ℤ)
    (words maps : List ℕ) (xl yl zl xr yr zr : List ℤ) (inputs : List ℤ) (hlen : inputs.length = 23) (μ : ℕ → ℤ)
    (hU : inputs.getD 0 0 = (U : ℤ)) (hFree : inputs.getD 1 0 = (af : ℤ)) (hq : inputs.getD 16 0 = (q : ℤ))
    (hw : (lim.space : ℤ) ≤ lim.word) (hend : finish af (capacity D E U) ≤ lim.space) (hUW : (U : ℤ) + 1 ≤ lim.word)
    (hEW : (E : ℤ) ≤ lim.word) (hqC : q * q ≤ capacity D E U) (hd : depth < lim.depth) :
    Meets lim (libraries radix D E K bDigit a b scaleBase p R F raws words maps xl yl zl xr yr zr) 52 depth inputs μ
      (LightWeightedGlobalArenaTemplate.time E)
      (fun r ν =>
        r = (af : ℤ) ∧
          Seg ν (addr af (capacity D E U) 0)
              (LightWeightedGlobalArenaTemplate.hostValues (frame inputs) af (capacity D E U)) ∧
            Seg ν (addr af (capacity D E U) 2)
                (LightWeightedGlobalArenaTemplate.seedValues (frame inputs) af (capacity D E U)) ∧
              Kept μ ν af) :=
  by
  have ht :=
    ReportingHostRelocation.meets
      (LightWeightedGlobalArenaTemplate.program_meets inputs hlen μ hU hFree hq hw hend hUW hEW hqC hd)
      (LightWeightedGlobalColorPreparation.program radix)
  have hh :=
    ht.append
      ((LightTernaryInitialBudgets.program K bDigit a b scaleBase).map (ReportingHostRelocation.relocate 53) ++
        (LightWeightedGlobalPrefixLoop.program p R F K raws words maps xl yl zl xr yr zr).map
          (ReportingHostRelocation.relocate 55))
  convert hh using 1
  all_goals try simp only [libraries, ReportingHostRelocation.program, budgetLibrary_length]
  all_goals try simp only [budgetLibrary, ReportingHostRelocation.program, prepArena_length]
  all_goals
    try
      simp only [prepArena, ReportingHostRelocation.program, LightWeightedGlobalColorPreparation.program_length,
        List.append_assoc]
private theorem budgets_call {lim : Limits} {radix D E K bDigit a b scaleBase p R F n J nO seed constants depth : ℕ}
    (raws : List ℤ) (words maps : List ℕ) (xl yl zl xr yr zr : List ℤ) (μ : ℕ → ℤ) (hn : 1 ≤ n) (hbDigit : 1 ≤ bDigit)
    (hw : (lim.space : ℤ) ≤ lim.word) (hseed : seed + 47 ≤ constants) (hspace : constants + 3 ≤ lim.space)
    (hword : (LightTernaryInitialBudgets.word K bDigit a b scaleBase n J nO : ℤ) ≤ lim.word) (hd : depth < lim.depth) :
    Meets lim (libraries radix D E K bDigit a b scaleBase p R F raws words maps xl yl zl xr yr zr) 54 depth
      [n, J, nO, seed, constants] μ (LightTernaryInitialBudgets.time K)
      (fun r ν =>
        r = (LightTernaryInitialBudgets.initial K bDigit n J nO : ℤ) ∧
          Seg ν (seed + 41) (budgetValues K bDigit n J nO) ∧
            Seg ν constants [(a : ℤ), b, scaleBase] ∧
              ∀ x, (x < seed + 41 ∨ seed + 47 ≤ x) → (x < constants ∨ constants + 3 ≤ x) → ν x = μ x) :=
  by
  have hb :=
    ReportingHostRelocation.meets (LightTernaryInitialBudgets.program_meets μ hn hbDigit hw hseed hspace hword hd)
      (prepArena radix D E)
  have hh :=
    hb.append
      ((LightWeightedGlobalPrefixLoop.program p R F K raws words maps xl yl zl xr yr zr).map
        (ReportingHostRelocation.relocate 55))
  convert hh using 1
  all_goals try simp only [libraries, ReportingHostRelocation.program, budgetLibrary_length]
  all_goals try simp only [budgetLibrary, ReportingHostRelocation.program, prepArena_length, List.append_assoc]
  all_goals rfl
end ThreeSum.LightWeightedGlobalColoredInitializationProof
