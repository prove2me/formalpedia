theorem nleaves_eq : PT.nleaves tree = 2425 := by decide +kernel

theorem leaves_length : tree.leaves.length = 2425 := by
  rw [PT.length_leaves]; exact nleaves_eq

/-- Coverage: every mean/entropy triple of the transition domain (`a + b ≤ 1`, `1/2 ≤ b`,
`1/50 ≤ b - a`, `E ≤ 11/200`, `4E ≤ b - a ≤ 8E`) lies in the image `InExy` of some leaf. -/
theorem cover {a b E : ℝ} (hsum : a + b ≤ 1) (hb : 1 / 2 ≤ b) (hd : 1 / 50 ≤ b - a)
    (hE : E ≤ 11 / 200) (h4 : 4 * E ≤ b - a) (h8 : b - a ≤ 8 * E) :
    ∃ q ∈ tree.leaves, InExy (root.ofPath q.1) a b E := by
  obtain ⟨r1, r2, r3, r4, r5, r6⟩ := exy_mem_root hsum hb hd hE h4 h8
  apply exy_cover root tree
  · simp only [root]; push_cast; exact r1
  · simp only [root]; push_cast; exact r2
  · simp only [root]; push_cast; exact r3
  · simp only [root]; push_cast; exact r4
  · simp only [root]; push_cast; exact r5
  · simp only [root]; push_cast; exact r6

/-- Coverage for laws (hypotheses of `CKLaneN1.SR_Transition`). -/
theorem cover_law {k : ℕ} (μ : InteriorLaw (Fin k)) (hsum : μ.a + μ.b ≤ 1) (hb : 1 / 2 ≤ μ.b)
    (hd : 1 / 50 ≤ μ.b - μ.a) (hE : μ.meanEntropy ≤ 11 / 200) (h4 : 4 * μ.meanEntropy ≤ μ.b - μ.a)
    (h8 : μ.b - μ.a ≤ 8 * μ.meanEntropy) :
    ∃ q ∈ tree.leaves, InExy (root.ofPath q.1) μ.a μ.b μ.meanEntropy :=
  cover hsum hb hd hE h4 h8

theorem noutside_eq : PT.nlabel 0 tree = 226 := by decide +kernel

theorem outside_check : PT.checkB (trOutOK 0) tree root = true := by decide +kernel

/-- Every archived `outside` leaf image carries no triple with `q ≤ d`, `1/10 ≤ a`, `1/50 ≤ d`. -/
theorem outside_irrelevant : ∀ q ∈ tree.leaves, q.2 = 0 →
    ∀ a b E : ℝ, InExy (root.ofPath q.1) a b E → 0 < E →
      ¬ (1 - a - b ≤ b - a ∧ 1 / 10 ≤ a ∧ 1 / 50 ≤ b - a) :=
  exy_outside outside_check

/-- No point of the transition domain (`1/10 ≤ a`, `1/2 ≤ b`, `1/50 ≤ b - a ≤ 8E`) lies in an `outside` leaf. -/
theorem outside_empty : ∀ q ∈ tree.leaves, q.2 = 0 → ∀ a b E : ℝ, 1 / 10 ≤ a → 1 / 2 ≤ b →
    1 / 50 ≤ b - a → b - a ≤ 8 * E → ¬ InExy (root.ofPath q.1) a b E := by
  intro q hq hl a b E ha hb hd h8 hin
  exact outside_irrelevant q hq hl a b E hin (by linarith) ⟨by linarith, ha, hd⟩

theorem ncollar_eq : PT.nlabel 3 tree = 4 := by decide +kernel

theorem collar_check : PT.checkB (trCollarOK 3) tree root = true := by decide +kernel

/-- Every archived `prior_collar` leaf image lies in one of the archived collars
`q ≤ E ∧ 5E ≤ d`, `q ≤ 2E ∧ 6E ≤ d`, `q ≤ 4E ∧ 8E ≤ d`. -/
theorem collar_region : ∀ q ∈ tree.leaves, q.2 = 3 → ∀ a b E : ℝ, InExy (root.ofPath q.1) a b E → 0 < E →
    (1 - a - b ≤ E ∧ 5 * E ≤ b - a) ∨ (1 - a - b ≤ 2 * E ∧ 6 * E ≤ b - a) ∨
      (1 - a - b ≤ 4 * E ∧ 8 * E ≤ b - a) :=
  exy_collar collar_check

