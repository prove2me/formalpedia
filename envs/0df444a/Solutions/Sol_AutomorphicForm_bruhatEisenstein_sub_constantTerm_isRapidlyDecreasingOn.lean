section DySum

variable (F : Type) [Field F] [NumberField F]

local notation "𝔸" => AdeleRing (𝓞 F) F
local notation "ι" => algebraMap F (AdeleRing (𝓞 F) F)

private def boxRadius : ℝ := max (Classical.choose (exists_forall_norm_apply_le_of_mem_infiniteBox F)) 0

private theorem boxRadius_nonneg : 0 ≤ boxRadius F := le_max_right _ _

private theorem norm_apply_le_boxRadius {x : InfiniteAdeleRing F} (hx : x ∈ infiniteBox F) (v : InfinitePlace F) :
    ‖x v‖ ≤ boxRadius F :=
  (Classical.choose_spec (exists_forall_norm_apply_le_of_mem_infiniteBox F) x hx v).trans (le_max_left _ _)

private theorem exists_eq_algebraMap_add (y : 𝔸) :
    ∃ (k : F) (u : 𝔸), y = ι k + u ∧ (∀ v : InfinitePlace F, ‖u.1 v‖ ≤ boxRadius F) ∧
      u.2 ∈ AdelicBox.integralFiniteAdeles (𝓞 F) F := by
  obtain ⟨k, hk, -⟩ := existsUnique_algebraMap_add_mem_adelicBox F y
  exact ⟨-k, ι k + y, by rw [map_neg, neg_add_cancel_left], fun v => norm_apply_le_boxRadius F hk.1 v, hk.2⟩

private def frameConst (a : ℝ) : ℝ := ((1 + boxRadius F) ^ (∑ w : InfinitePlace F, w.mult)) ^ a * ∑' ξ : F, Dy F (ι ξ) ^ (-a)

private theorem frameConst_nonneg (a : ℝ) : 0 ≤ frameConst F a :=
  mul_nonneg (Real.rpow_nonneg (by have := boxRadius_nonneg F; positivity) a)
    (tsum_nonneg fun ξ => Real.rpow_nonneg (Dy_pos F _).le _)

private theorem norm_inv_fst_apply {αb : 𝔸ˣ} {t : ℝ} (hαba : ∀ v : InfinitePlace F, ‖(αb : 𝔸).1 v‖ = t) (v : InfinitePlace F) :
    ‖((αb⁻¹ : 𝔸ˣ) : 𝔸).1 v‖ = t⁻¹ := by
  have h : ((αb⁻¹ : 𝔸ˣ) : 𝔸).1 v * (αb : 𝔸).1 v = 1 := congrArg (fun z : 𝔸 => z.1 v) αb.inv_mul
  have h' : ‖((αb⁻¹ : 𝔸ˣ) : 𝔸).1 v‖ * t = 1 := by rw [← hαba v, ← norm_mul, h, norm_one]
  exact eq_inv_of_mul_eq_one_left h'

private theorem inv_snd_eq_one {αb : 𝔸ˣ} (hαbf : (αb : 𝔸).2 = 1) : ((αb⁻¹ : 𝔸ˣ) : 𝔸).2 = 1 := by
  have h : ((αb⁻¹ : 𝔸ˣ) : 𝔸).2 * (αb : 𝔸).2 = 1 := congrArg (fun z : 𝔸 => z.2) αb.inv_mul
  rwa [hαbf, mul_one] at h

private theorem summable_and_tsum_rpow_Dy_frame_le {a : ℝ} (ha : 2 < a) {αb : 𝔸ˣ} {t : ℝ} (ht : 1 ≤ t)
    (hαbf : (αb : 𝔸).2 = 1) (hαba : ∀ v : InfinitePlace F, ‖(αb : 𝔸).1 v‖ = t) (q : Fˣ) (y : 𝔸) :
    Summable (fun ξ : F => Dy F (((αb⁻¹ * Units.map (ι : F →* 𝔸) q : 𝔸ˣ) : 𝔸) * (ι ξ + y)) ^ (-a)) ∧
    ∑' ξ : F, Dy F (((αb⁻¹ * Units.map (ι : F →* 𝔸) q : 𝔸ˣ) : 𝔸) * (ι ξ + y)) ^ (-a)
      ≤ (t ^ Module.finrank ℚ F) ^ a * frameConst F a := by
  have ha0 : 0 ≤ a := by linarith
  have ht0 : 0 < t := one_pos.trans_le ht
  obtain ⟨k₀, u₀, hy, hu1, hu2⟩ := exists_eq_algebraMap_add F (ι (q : F) * y)

  set f : F → ℝ := fun ξ' => Dy F (((αb⁻¹ : 𝔸ˣ) : 𝔸) * (ι ξ' + u₀)) ^ (-a) with hf
  set e : F ≃ F := (Equiv.mulLeft₀ (q : F) q.ne_zero).trans (Equiv.addRight k₀) with he
  have he' : ∀ ξ, e ξ = (q : F) * ξ + k₀ := fun ξ => rfl
  have hXY : ∀ ξ, ((αb⁻¹ * Units.map (ι : F →* 𝔸) q : 𝔸ˣ) : 𝔸) * (ι ξ + y)
      = ((αb⁻¹ : 𝔸ˣ) : 𝔸) * (ι (e ξ) + u₀) := by
    intro ξ
    rw [he', Units.val_mul, Units.coe_map, MonoidHom.coe_coe, map_add, map_mul, mul_assoc, mul_add (ι (q : F)), hy]
    ring
  have hfe : (fun ξ : F => Dy F (((αb⁻¹ * Units.map (ι : F →* 𝔸) q : 𝔸ˣ) : 𝔸) * (ι ξ + y)) ^ (-a)) = f ∘ e := by
    funext ξ; rw [hXY ξ]; rfl

  have hz1 : ∀ (ξ' : F) (w : InfinitePlace F),
      ‖((((αb⁻¹ : 𝔸ˣ) : 𝔸) * (ι ξ' + u₀)).1 w)‖ = ‖(ι ξ' + u₀).1 w‖ / t := fun ξ' w => by
    show ‖((αb⁻¹ : 𝔸ˣ) : 𝔸).1 w * (ι ξ' + u₀).1 w‖ = _
    rw [norm_mul, norm_inv_fst_apply F hαba w, inv_mul_eq_div]
  have hz2 : ∀ ξ' : F, (((αb⁻¹ : 𝔸ˣ) : 𝔸) * (ι ξ' + u₀)).2 = (ι ξ' + u₀).2 := fun ξ' => by
    show ((αb⁻¹ : 𝔸ˣ) : 𝔸).2 * (ι ξ' + u₀).2 = _
    rw [inv_snd_eq_one F hαbf, one_mul]
  have hsum : Summable f :=
    summable_rpow_Dy_archScale_translate F ha (fun _ => t) (fun _ => ht0) (boxRadius_nonneg F) u₀ hu1 hu2
      (fun ξ' => ((αb⁻¹ : 𝔸ˣ) : 𝔸) * (ι ξ' + u₀)) hz1 hz2
  have hprod : ∏ w : InfinitePlace F, max 1 t ^ w.mult = t ^ Module.finrank ℚ F := by
    rw [max_eq_right ht, Finset.prod_pow_eq_pow_sum, sum_mult_eq]
  have hle : ∀ ξ' : F, f ξ' ≤ (t ^ Module.finrank ℚ F) ^ a *
      (((1 + boxRadius F) ^ (∑ w : InfinitePlace F, w.mult)) ^ a * Dy F (ι ξ') ^ (-a)) := fun ξ' => by
    have h := rpow_Dy_le_archScale_translate F ha0 ξ' (fun _ => t) (fun _ => ht0) (boxRadius_nonneg F) u₀ hu1 hu2
      (((αb⁻¹ : 𝔸ˣ) : 𝔸) * (ι ξ' + u₀)) (hz1 ξ') (hz2 ξ')
    rw [hprod] at h
    simpa only [hf, mul_assoc] using h
  have hsumR : Summable fun ξ' : F => (t ^ Module.finrank ℚ F) ^ a *
      (((1 + boxRadius F) ^ (∑ w : InfinitePlace F, w.mult)) ^ a * Dy F (ι ξ') ^ (-a)) :=
    ((summable_rpow_Dy_algebraMap F ha).mul_left _).mul_left _
  refine ⟨?_, ?_⟩
  · rw [hfe]; exact (Equiv.summable_iff e).mpr hsum
  · rw [hfe, show (∑' ξ : F, (f ∘ e) ξ) = ∑' ξ : F, f ξ from Equiv.tsum_eq e f]
    calc ∑' ξ : F, f ξ ≤ ∑' ξ' : F, (t ^ Module.finrank ℚ F) ^ a *
          (((1 + boxRadius F) ^ (∑ w : InfinitePlace F, w.mult)) ^ a * Dy F (ι ξ') ^ (-a)) := hsum.tsum_le_tsum hle hsumR
      _ = (t ^ Module.finrank ℚ F) ^ a * frameConst F a := by
          rw [tsum_mul_left, tsum_mul_left]; rfl

end DySum
