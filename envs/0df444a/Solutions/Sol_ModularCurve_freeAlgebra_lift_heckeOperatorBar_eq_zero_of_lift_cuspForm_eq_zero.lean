theorem solution
    (N : ℕ) [NeZero N] (p : FreeAlgebra ℤ Nat.Primes)
    (hp : FreeAlgebra.lift ℤ (fun ℓ : Nat.Primes =>
        (if h : (ℓ : ℕ) ∣ N then CuspForm.heckeULin 2 h else CuspForm.heckeTLin 2 ℓ.2 h :
          Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) 2))) p = 0) :
    FreeAlgebra.lift ℤ (fun ℓ : Nat.Primes => ModularCurve.heckeOperatorBar N ℓ) p = 0 := by
  classical

  have hin : ModularCurve.HeckeInputsAll N := ModularCurve.heckeInputsAll N
  have hst : ModularCurve.PeriodLatticeHeckeStable N := ModularCurve.periodLatticeHeckeStable N

  obtain ⟨u, hu_inj, -, hu⟩ :=
    ModularCurve.exists_injective_heckeEquivariant_addMonoidHom_jZero_quotient_periodLattice N hin hst

  have hD := W9GD64B.dualHeckeRep_sym_eq_zero N p hp
  refine LinearMap.ext fun x => ?_
  obtain ⟨φ, hφ⟩ := Submodule.Quotient.mk_surjective (ModularCurve.periodLattice N) (u x)
  apply hu_inj
  rw [LinearMap.zero_apply, map_zero, W9GD64B.uniformization_lift u hu p x φ hφ.symm, hD,
    LinearMap.zero_apply, Submodule.Quotient.mk_zero]

end S_ModularCurve_freeAlgebra_lift_heckeOperatorBar_eq_zero_of_lift_cuspForm_eq_zero
