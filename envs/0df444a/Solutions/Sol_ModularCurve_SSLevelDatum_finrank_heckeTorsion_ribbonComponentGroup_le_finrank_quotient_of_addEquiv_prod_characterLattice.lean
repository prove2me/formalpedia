  · subst h'; rw [tX, tX, if_pos rfl, if_neg h]; exact (Q.compS_diag_comm ℓ x).symm
  · rw [tX, tX, if_neg h, if_neg h']
    apply Prod.ext
    · exact Q.tV_comm ℓ ℓ' x.1
    · exact Q.tV_comm ℓ ℓ' x.2
