theorem foldl_mvF_len (c : ℕ) : ∀ (ts : List ℕ) (g : ℕ → ℕ),
    (ts.foldl (mvF c) (g, [])).2.length ≤ ts.length
  | [], g => le_refl _
  | w :: ts, g => by
    rw [foldl_mvF_cons]
    split_ifs
    · exact (foldl_mvF_len c ts g).trans (by simp)
    · simp only [List.length_append, List.length_singleton, List.length_cons]
      exact Nat.add_le_add_right (foldl_mvF_len c ts _) 1

theorem shl1 (n : ℕ) : Nat.shiftLeft 1 n = 2 ^ n := by
  rw [show Nat.shiftLeft 1 n = 1 <<< n from rfl, Nat.one_shiftLeft]

theorem cntF_eq (cs : List LChunk) : cntF cs = ((mvRanks cs).map fun r => 2 ^ (32 * r)).sum := by
  have inner : ∀ (l : List (ℕ × ℕ)) (c a : ℕ), l.foldl (fun a m =>
      Nat.add a (Nat.shiftLeft 1 (Nat.mul 32 (let a1 := dimCF m.2; let b1 := dimCF c;
        cond (Nat.blt a1 b1) (Nat.sub b1 a1) (Nat.sub a1 b1))))) a =
        a + ((l.map fun m => rkC m.2 c).map fun r => 2 ^ (32 * r)).sum := by
    intro l c
    induction l with
    | nil => intro a; simp
    | cons m l ih =>
      intro a
      rw [List.foldl_cons, ih]
      simp only [List.map_cons, List.sum_cons, shl1, rkC, Nat.add_eq, Nat.mul_eq]
      ring
  have outer : ∀ (cs : List LChunk) (a : ℕ), cs.foldl (fun acc ch => ch.2.1.foldl (fun a m =>
      Nat.add a (Nat.shiftLeft 1 (Nat.mul 32 (let a1 := dimCF m.2; let b1 := dimCF ch.1;
        cond (Nat.blt a1 b1) (Nat.sub b1 a1) (Nat.sub a1 b1))))) acc) a =
        a + ((mvRanks cs).map fun r => 2 ^ (32 * r)).sum := by
    intro cs
    induction cs with
    | nil => intro a; simp [mvRanks]
    | cons ch cs ih =>
      intro a
      rw [List.foldl_cons, ih, inner]
      simp only [mvRanks, List.flatMap_cons, List.map_append, List.sum_append]
      ring
  rw [cntF, outer, zero_add]

theorem touchCnt_eq (W : List LInstr) : touchCnt W = (W.map fun i => i.2.1.length).sum := by
  have : ∀ (W : List LInstr) (a : ℕ), W.foldl (fun a i => Nat.add a i.2.1.length) a =
      a + (W.map fun i => i.2.1.length).sum := by
    intro W
    induction W with
    | nil => intro a; simp
    | cons i W ih => intro a; rw [List.foldl_cons, ih]; simp [Nat.add_eq]; ring
  rw [touchCnt, this, zero_add]

theorem mvRanks_len : ∀ (W : List LInstr) (f : ℕ → ℕ), (mvRanks (genF f W).2).length ≤ touchCnt W
  | [], f => by simp [genF_nil, mvRanks, touchCnt]
  | i :: W, f => by
    rw [genF_cons, touchCnt_eq, List.map_cons, List.sum_cons, ← touchCnt_eq]
    simp only [mvRanks, List.flatMap_cons, List.length_append, List.length_map, List.length_reverse]
    exact Nat.add_le_add (foldl_mvF_len _ _ _) (mvRanks_len W _)

