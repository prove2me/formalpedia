theorem twCU_cost (n k j : ℕ) (tc : ℕ) (hc : tc ≤ twiddleCost n (zsz (j : ℤ)) (zsz (k : ℤ)))
    (hm1 : 2 * moveCost (zsz (HvdH.twiddle n k j).2) + 19 ≤ 110 * (n + 3))
    (hm2 : 2 * moveCost (zsz (HvdH.twiddle n k j).1) + 19 ≤ 110 * (n + 3)) :
    dupCost (zsz (n : ℤ)) + 17 + (dupCost (zsz (k : ℤ)) + 17 + (dupCost (zsz (j : ℤ)) + 17 +
      (tc + (2 * zsz (j : ℤ) + 2 + (2 * zsz (k : ℤ) + 2 + (2 * zsz (n : ℤ) + 2 +
      (2 * moveCost (zsz (HvdH.twiddle n k j).2) + 19 +
        (2 * moveCost (zsz (HvdH.twiddle n k j).1) + 19)))))))) ≤ cTwU n k j := by
  unfold cTwU cCnt
  have q1 := dupCost_mono' (zsz_natCast_le (show n ≤ n + k + j by omega))
  have q2 := dupCost_mono' (zsz_natCast_le (show k ≤ n + k + j by omega))
  have q3 := dupCost_mono' (zsz_natCast_le (show j ≤ n + k + j by omega))
  have hsq := Nat.le_self_pow (n := 2) two_ne_zero (zsz (n : ℤ) + zsz (k : ℤ) + zsz (j : ℤ) + 2)
  unfold cTw
  generalize twiddleCost n (zsz (j : ℤ)) (zsz (k : ℤ)) = T at hc ⊢
  generalize (zsz (n : ℤ) + zsz (k : ℤ) + zsz (j : ℤ) + 2) ^ 2 = Q at hsq ⊢
  omega

end IL

