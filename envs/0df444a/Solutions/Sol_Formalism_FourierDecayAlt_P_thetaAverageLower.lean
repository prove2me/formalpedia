  refine ⟨V, hV, ?_⟩
  intro t τ cr ht hcr hsh z₁ hz₁ a

  set F' : Finset (Point K × Kˣ) := F ×ˢ Sg.image τ with hF'
  have hmemF' : ∀ h ∈ F, ∀ ρ ∈ D.A, ∀ b ∈ D.B, (h, τ (ρ + b)) ∈ F' := by
