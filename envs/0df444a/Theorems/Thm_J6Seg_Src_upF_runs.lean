theorem J6Seg.Src.upF_runs {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} {dA Z Z1 Cm : Fin HS}
    (hP : ParkOK dA Z Z1 Cm) {body : IStmt HS Pp} {m : ℕ} {ρ : Fin m → Fin HS}
    (s : IState HS) (F : Fin HS → List ℤ)
    (hF : ∀ j, j ≠ 0 → j ≠ sZ → j ≠ dA → (∀ i, ρS i ≠ j) → F j = [])
    {k pre post sv t p α d W : ℕ} (hdA : F dA = dsc k pre post sv t p α d)
    (hW : parBig 0 0 0 0 k pre post sv t p α d < 2 ^ W) (hW3 : 3 ≤ W)
    (V : Fin 7 → List ℤ) {cB : ℕ}
    (hB : ∀ v, ParV 0 0 0 0 pre post sv t p α d v → BV W v →
