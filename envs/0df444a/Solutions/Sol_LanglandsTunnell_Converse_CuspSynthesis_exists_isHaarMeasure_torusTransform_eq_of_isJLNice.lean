        (ω (d004 v (uniformizerUnit K v))) hpi n
      rw [t0384 hv, div_one, hsplit, map_mul, mul_assoc, map_mul, map_zpow, Units.val_mul,
        mul_assoc, ← map_zpow]
      have hu := hunit _ (t0076 hv he he') y
