set_option maxHeartbeats 1000000

set_option linter.unusedSectionVars false
open Synth
open AModel AModelL12
variable (D ℓ K : ℕ) (long : Fin D → Bool)

theorem Synth.paper_layout (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    ∃ ops : List LOp,
      (ops.filter LOp.isMv).length = (lstL D ℓ K long).length ∧
      (lstL D ℓ K long).length ≤ D * (bb ℓ K + 1) ∧
      (ops.filter fun o => !o.isMv).length ≤ D * qq ℓ K - 1 ∧
      (∀ o ∈ ops, o.WF (initL D ℓ long).length) ∧
      applyN ops (initL D ℓ long) = tgtL D ℓ K long ∧
      ∀ {α : Type} (d : α) (xs : List α), xs.length = 2 ^ (initL D ℓ long).length →
        runArr (initL D ℓ long).length d ops xs =
          pull (binSh (initL D ℓ long).length) (binSh (initL D ℓ long).length)
            (relabel (initL D ℓ long) (tgtL D ℓ K long)) d xs := by sorry
