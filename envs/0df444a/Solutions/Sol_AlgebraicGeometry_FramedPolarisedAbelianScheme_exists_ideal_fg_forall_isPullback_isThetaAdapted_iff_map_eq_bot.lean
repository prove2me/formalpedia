open CategoryTheory CategoryTheory.Limits AlgebraicGeometry NeronModelInfra GoodReductionJacobian AlgebraicGeometry.Polarisation
open scoped BigOperators TensorProduct

theorem solution
    {g N n : ℕ} (δ : Fin g → ℕ) [hδ : ∀ i, NeZero (δ i)] (e : Fin (N + 1) ≃ ((i : Fin g) → ZMod (δ i)))
    {S : Type} [CommRing S] (ζ : S) (hζ : ζ ^ (N + 1) = 1) (hζu : ∀ j : ℕ, 0 < j → j < N + 1 → IsUnit (1 - ζ ^ j))
    (X : FramedPolarisedAbelianScheme g N n S) :
    ∃ J : Ideal S, J.FG ∧ ∀ (T : Type) [CommRing T] (φ : S →+* T) (Y : FramedPolarisedAbelianScheme g N n T),
      FramedPolarisedAbelianScheme.IsPullback φ X Y → (Y.IsThetaAdapted δ e ↔ J.map φ = ⊥) := by
  classical

  let π : ((i : Fin g) → ZMod (δ i)) → Equiv.Perm (Fin (N + 1)) := fun h => (e.trans (Equiv.addLeft h)).trans e.symm
  have hπ : ∀ h i, π h i = e.symm (h + e i) := fun h i => rfl
  let P : ((i : Fin g) → ZMod (δ i)) → Matrix (Fin (N + 1)) (Fin (N + 1)) S := fun h => (π h).permMatrix S
  have hP : ∀ h i j, P h i j = if j = e.symm (h + e i) then 1 else 0 := by
    intro h i j
    simp only [P, Equiv.Perm.permMatrix, PEquiv.toMatrix_apply, Equiv.toPEquiv_apply, Option.mem_def, Option.some.injEq, hπ]
    simp only [eq_comm]
  have hPU : ∀ h, IsUnit (P h) := by
    intro h
    have : P h = Matrix.permMatrixHom (R := S) (π h)⁻¹ := by simp [P, Matrix.permMatrixHom]
    rw [this]; exact (Group.isUnit _).map _
  let D : (((i : Fin g) → ZMod (δ i)) →+ ZMod (N + 1)) → Matrix (Fin (N + 1)) (Fin (N + 1)) S :=
    fun c => Matrix.diagonal fun i => ζ ^ (c (e i)).val
  have hζU : IsUnit ζ := IsUnit.of_pow_eq_one hζ (Nat.succ_ne_zero N)
  have hDU : ∀ c, IsUnit (D c) := by
    intro c
    rw [Matrix.isUnit_iff_isUnit_det, Matrix.det_diagonal]
    exact IsUnit.prod_univ_iff.mpr fun i => hζU.pow _

  choose Jp hJp using fun h => AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_ideal_fg_forall_isPullback_exists_translate_comp_eq_iff_map_eq_bot X (P h) (hPU h)
  choose Jd hJd using fun c => AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_ideal_fg_forall_isPullback_exists_translate_comp_eq_iff_map_eq_bot X (D c) (hDU c)
  haveI : Finite (((i : Fin g) → ZMod (δ i)) →+ ZMod (N + 1)) :=
    Finite.of_injective (fun c : ((i : Fin g) → ZMod (δ i)) →+ ZMod (N + 1) => (c : ((i : Fin g) → ZMod (δ i)) → ZMod (N + 1)))
      (fun a b hab => DFunLike.coe_injective hab)
  refine ⟨(⨆ h, Jp h) ⊔ ⨆ c, Jd c, ?_, ?_⟩
  · exact Submodule.FG.sup (Submodule.fg_iSup _ fun h => (hJp h).1) (Submodule.fg_iSup _ fun c => (hJd c).1)
  intro T _ φ Y hY

  have hζT : (φ ζ) ^ (N + 1) = 1 := by rw [← map_pow, hζ, map_one]
  have hζuT : ∀ j : ℕ, 0 < j → j < N + 1 → IsUnit (1 - (φ ζ) ^ j) := by
    intro j hj hj'; have := (hζu j hj hj').map φ; simpa using this
  let σ' : ((i : Fin g) → ZMod (δ i)) →
      Γ((Scheme.Modules.pullback (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T))))).obj Y.pol, ⊤) :=
    fun hh => (Scheme.Modules.pullbackLocalSection (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T)))) (Y.frame.σ (e.symm hh)) :
      Γ((Scheme.Modules.pullback (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T))))).obj Y.pol,
        (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T)))) ⁻¹ᵁ ⊤))
  have hσ' : ∀ i : Fin (N + 1), σ' (e i) =
      (Scheme.Modules.pullbackLocalSection (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T)))) (Y.frame.σ i) :
        Γ((Scheme.Modules.pullback (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T))))).obj Y.pol,
          (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T)))) ⁻¹ᵁ ⊤)) := by
    intro i; simp only [σ', Equiv.symm_apply_apply]
  rw [AlgebraicGeometry.FramedPolarisedAbelianScheme.isThetaAdapted_iff_forall_exists_thetaPt_act_eq δ e (φ ζ) hζT hζuT Y σ' hσ',
    Ideal.map_sup, Ideal.map_iSup, Ideal.map_iSup, sup_eq_bot_iff, iSup_eq_bot, iSup_eq_bot]

  have hscal : ∀ r : T,
      (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T)))).app ⊤
          ((Y.f.appLE ⊤ ⊤ le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of T)).inv.hom r)) =
        Polarisation.baseScalar Y.f (𝟙 (Spec (CommRingCat.of T))) r := by
    intro r
    have h1 : Y.f.appLE ⊤ ⊤ le_top = Y.f.appTop := by simp [Scheme.Hom.appLE, Scheme.Hom.appTop]
    rw [h1]
    show (Y.f.appTop ≫ (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T)))).appTop).hom _ =
      (pullback.snd Y.f (𝟙 (Spec (CommRingCat.of T)))).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of T)).inv.hom r)
    rw [← Scheme.Hom.comp_appTop, pullback.condition, Category.comp_id]
  refine and_congr (forall_congr' fun h => ?_) (forall_congr' fun c => ?_)
  ·
    obtain ⟨XU, hXU⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isReframe Y ((P h).map φ)
      ((hPU h).map φ.mapMatrix)
    obtain ⟨P', h1, h2, hXUeq, hP'σ⟩ := hXU
    rw [← (hJp h).2 T φ Y hY P' (fun i => by rw [hP'σ i]; rfl)]
    rw [← AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_thetaPt_act_eq_iff_exists_translate_comp_toProj_eq Y P']
    have hP'i : ∀ i, P'.σ i = Y.frame.σ (e.symm (h + e i)) := by
      intro i
      rw [hP'σ i, Finset.sum_eq_single (e.symm (h + e i))]
      · rw [Matrix.map_apply, hP, if_pos rfl, map_one, map_one, map_one, one_smul]
      · intro j _ hj
        rw [Matrix.map_apply, hP, if_neg hj, map_zero, map_zero, map_zero, zero_smul]
      · intro hh; exact absurd (Finset.mem_univ _) hh
    refine exists_congr fun θ => ⟨fun H i => ?_, fun H h' => ?_⟩
    · have := H (e i)
      rw [hσ' i] at this
      rw [hP'i]
      exact this
    · obtain ⟨i, rfl⟩ := e.surjective h'
      have := H i
      rw [hP'i] at this
      rw [hσ' i]
      exact this
  ·
    obtain ⟨XU, hXU⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isReframe Y ((D c).map φ)
      ((hDU c).map φ.mapMatrix)
    obtain ⟨P', h1, h2, hXUeq, hP'σ⟩ := hXU
    rw [← (hJd c).2 T φ Y hY P' (fun i => by rw [hP'σ i]; rfl)]
    rw [← AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_thetaPt_act_eq_iff_exists_translate_comp_toProj_eq Y P']
    have hP'i : ∀ i, P'.σ i =
        ((Y.f.appLE ⊤ ⊤ le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of T)).inv.hom (φ (ζ ^ (c (e i)).val)))) • Y.frame.σ i := by
      intro i
      rw [hP'σ i, Finset.sum_eq_single i]
      · rw [Matrix.map_apply]
        simp only [D, Matrix.diagonal_apply_eq]
      · intro j _ hj
        rw [Matrix.map_apply]
        simp only [D, Matrix.diagonal_apply_ne _ (Ne.symm hj), map_zero, zero_smul]
      · intro hh; exact absurd (Finset.mem_univ _) hh
    have hrhs : ∀ i,
        (Scheme.Modules.pullbackLocalSection (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T)))) (P'.σ i) :
          Γ((Scheme.Modules.pullback (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T))))).obj Y.pol,
            (pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T)))) ⁻¹ᵁ ⊤)) =
        Polarisation.baseScalar Y.f (𝟙 (Spec (CommRingCat.of T))) ((φ ζ) ^ (c (e i)).val) • σ' (e i) := by
      intro i
      rw [hP'i, Scheme.Modules.pullbackLocalSection_smul, hscal, map_pow, hσ' i]
      rfl
    refine exists_congr fun θ => ⟨fun H i => ?_, fun H hh => ?_⟩
    · exact ((congrArg θ.act (hσ' i)).symm.trans (H (e i))).trans (hrhs i).symm
    · obtain ⟨i, rfl⟩ := e.surjective hh
      exact (congrArg θ.act (hσ' i)).trans ((H i).trans (hrhs i))

end S_AlgebraicGeometry_FramedPolarisedAbelianScheme_exists_ideal_fg_forall_isPullback_isThetaAdapted_iff_map_eq_bot
