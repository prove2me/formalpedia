theorem bc_eq_self_of_sub_mem (W Vt : Submodule K V) (hbot : W ⊓ Vt = ⊥) (g : Module.End K V)
    (hgW : ∀ w ∈ W, g w ∈ W) (hech : ∀ v : V, g v - v ∈ Vt) : ∀ w ∈ W, g w = w := by
  intro w hw
  have h : g w - w ∈ W ⊓ Vt := ⟨W.sub_mem (hgW w hw) hw, hech w⟩
  rw [hbot, Submodule.mem_bot, sub_eq_zero] at h
