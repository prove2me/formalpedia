      simp [Expr.Gives, Expr.Safe, Expr.val, Op.eval, Light.frame, Limits.Addr, hrI, hrJ, hrA, abs_le]
      generalize (a : ℤ) * (n : ℤ) = P at *
      omega

end Light.Filter
