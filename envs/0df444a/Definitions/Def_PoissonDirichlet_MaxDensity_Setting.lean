-- title:
--   Definition 1 and (2), p. 857 — stick-breaking (4), ranked values, the PD(α, θ) law, size-biased pick and permutation
-- statement:
--   Fix parameters $0 \le \alpha < 1$ and $\theta > -\alpha$. For a sequence $y = (y_1, y_2, \dots)$ of numbers in $(0,1)$, the **stick-breaking** map (4) produces the pieces
--   $$\tilde V_1 = y_1, \qquad \tilde V_n = (1-y_1)\cdots(1-y_{n-1})\,y_n \quad (n \ge 2).$$
--   The **ranked values** $V_1 \ge V_2 \ge \cdots$ of a nonnegative sequence $x$ are its terms in decreasing order, counted with multiplicity: $V_{k+1}$ is the least $t \ge 0$ such that at most $k$ terms of $x$ exceed $t$.
--
--   **Definition 1.** Let $\tilde Y_1, \tilde Y_2, \dots$ be independent, with $\tilde Y_n$ distributed as $\mathrm{beta}(1-\alpha, \theta + n\alpha)$, the law with density $\frac{\Gamma(a+b)}{\Gamma(a)\Gamma(b)} x^{a-1}(1-x)^{b-1}$ on $(0,1)$. Let $\tilde V$ be the stick-breaking sequence of $\tilde Y$ and $V$ its ranked values. The **two-parameter Poisson–Dirichlet distribution** $\mathrm{PD}(\alpha,\theta)$ is the law of $V$. A random sequence $(V_n)$ on a probability space $(\Omega, P)$ *has the* $\mathrm{PD}(\alpha,\theta)$ *distribution* if $P(V \in S)$ equals the probability that the ranked stick-breaking sequence of such a $\tilde Y$ lies in $S$, for every measurable set $S$ of sequences.
--
--   **Size-biased pick, (2).** A random variable $\tilde V_1$ is a size-biased pick from $(V_n)$ if
--   $$P(\tilde V_1 = V_n \mid V_1, V_2, \dots) = V_n \qquad (n = 1, 2, \dots).$$
--   **Size-biased permutation.** $(\tilde V_1, \tilde V_2, \dots)$ is a size-biased permutation of $(V_n)$ if $\tilde V_1$ is a size-biased pick and, for all $n, j \ge 1$,
--   $$P(\tilde V_{n+1} = V_j \mid \tilde V_1, \dots, \tilde V_n; V_1, V_2, \dots) = \frac{V_j\, 1(V_j \ne \tilde V_i \text{ for all } 1 \le i \le n)}{1 - \tilde V_1 - \cdots - \tilde V_n}.$$
--
--   These are the objects of every statement in this mission: the law $\mathrm{PD}(\alpha,\theta)$ of the ranked frequencies, and the size-biased order in which a random sample discovers them.
--
--   **Formalization Note.** Sequences are 0-based: `V ω k` is $V_{k+1}$ and `stick y k` is $\tilde V_{k+1}$. `ranked` counts with `Set.encard` (values in $\mathbb N \cup \{\infty\}$), never `Set.ncard`. `IsStickLaw α θ μ` says $\mu$ is a probability measure on sequences with independent coordinates, the $k$-th distributed as $\mathrm{beta}(1-\alpha, \theta+(k+1)\alpha)$; this determines $\mu$. `HasPD` is stated through measures of preimages, never through `Measure.map` of `ranked ∘ stick`, so no measurability of that map is presupposed. Conditional probabilities are conditional expectations of indicators given the σ-algebra generated by the conditioning variables; `IsSizeBiasedPick` and `IsSizeBiasedPerm` require the variables to be measurable (they are random variables on the page), which also makes the conditional expectation meaningful.
-- source:
--   Pitman and Yor, The two-parameter Poisson–Dirichlet distribution derived from a stable subordinator, Ann. Probab. 25 (1997), p. 857, (2), (3), (4), Definition 1, size-biased permutation

import Mathlib
import Definitions.Def_PoissonDirichlet_Ratio_Setting
open MeasureTheory ProbabilityTheory Filter Topology

namespace PoissonDirichlet.MaxDensity

/-- Size-biased pick, (2), p. 857: `W` is a size-biased pick from `(Vₙ)` if
`P(W = Vₙ | V₁, V₂, …) = Vₙ` for every `n`. 0-based: `V ω k` is `V_{k+1}`. Both `V` and `W`
are random variables (measurable), as the page presupposes; the conditional probability is
the conditional expectation of the indicator of `{W = V_{k+1}}` given `σ(V)`. -/
def IsSizeBiasedPick {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (V : Ω → ℕ → ℝ)
    (W : Ω → ℝ) : Prop :=
  Measurable V ∧ Measurable W ∧
    ∀ k : ℕ, P[(fun ω => if W ω = V ω k then (1 : ℝ) else 0) | MeasurableSpace.comap V inferInstance]
      =ᵐ[P] fun ω => V ω k

/-- Size-biased permutation, p. 857: `W 0` (paper `Ṽ₁`) is a size-biased pick from `(Vₙ)` and,
for every `m` and `j` (paper `n = m + 1`, `j + 1`),
`P(Ṽ_{n+1} = V_j | Ṽ₁, …, Ṽₙ; V₁, V₂, …) = V_j 1(V_j ≠ Ṽ_i for all i ≤ n) / (1 - Ṽ₁ - ⋯ - Ṽₙ)`. -/
def IsSizeBiasedPerm {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (V W : Ω → ℕ → ℝ) : Prop :=
  Measurable W ∧ IsSizeBiasedPick P V (fun ω => W ω 0) ∧
    ∀ m j : ℕ,
      P[(fun ω => if W ω (m + 1) = V ω j then (1 : ℝ) else 0) |
          MeasurableSpace.comap (fun ω => ((fun i : Fin (m + 1) => W ω i), V ω)) inferInstance]
        =ᵐ[P] fun ω =>
          (if ∀ i ≤ m, V ω j ≠ W ω i then V ω j else 0) /
            (1 - ∑ i ∈ Finset.range (m + 1), W ω i)

end PoissonDirichlet.MaxDensity


