private theorem adicCompletion_congr {R : Type} [CommRing R] {I J : Ideal R} (h : I = J) :
    ∃ f : AdicCompletion I R ≃+* AdicCompletion J R,
      ∀ r : R, f (algebraMap R (AdicCompletion I R) r) = algebraMap R (AdicCompletion J R) r := by
  subst h
  exact ⟨RingEquiv.refl _, fun _ => rfl⟩

private theorem adicCompletion_maximalIdeal_ringEquiv {R S : Type} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (e : R ≃+* S) :
    ∃ ê : AdicCompletion (maximalIdeal R) R ≃+* AdicCompletion (maximalIdeal S) S,
      ∀ r : R, ê (algebraMap R (AdicCompletion (maximalIdeal R) R) r) =
        algebraMap S (AdicCompletion (maximalIdeal S) S) (e r) := by
  obtain ⟨ê₁, hê₁⟩ := AdicCompletion.exists_ringEquiv_map_of_ringEquiv (maximalIdeal R) e
  have hmax : (maximalIdeal R).map e = maximalIdeal S := by
    haveI : (maximalIdeal R).IsMaximal := maximalIdeal.isMaximal R
    exact eq_maximalIdeal (Ideal.map_isMaximal_of_equiv e)
  obtain ⟨f, hf⟩ := adicCompletion_congr (R := S) hmax
  exact ⟨ê₁.trans f, fun r => by rw [RingEquiv.trans_apply, hê₁, hf]⟩

private noncomputable def mvPowerSeriesMapEquiv {σ R S : Type} [CommRing R] [CommRing S] (e : R ≃+* S) :
    MvPowerSeries σ R ≃+* MvPowerSeries σ S :=
  RingEquiv.ofRingHom (MvPowerSeries.map (σ := σ) (e : R →+* S)) (MvPowerSeries.map (σ := σ) (e.symm : S →+* R))
    (RingHom.ext fun φ => MvPowerSeries.ext fun n => by simp)
    (RingHom.ext fun φ => MvPowerSeries.ext fun n => by simp)

private theorem mvPowerSeriesMapEquiv_apply {σ R S : Type} [CommRing R] [CommRing S] (e : R ≃+* S)
    (φ : MvPowerSeries σ R) : mvPowerSeriesMapEquiv (σ := σ) e φ = MvPowerSeries.map (σ := σ) (e : R →+* S) φ := rfl

private theorem crossing_rebase {W₀ W₁ : Type} [CommRing W₀] [CommRing W₁] (f : W₀ ≃+* W₁) (c : W₀) (d : W₁)
    (hd : f c = d) :
    ∃ q : (MvPowerSeries (Fin 2) W₁ ⧸
            Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) W₁) * MvPowerSeries.X 1 - MvPowerSeries.C d}) ≃+*
          (MvPowerSeries (Fin 2) W₀ ⧸
            Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) W₀) * MvPowerSeries.X 1 - MvPowerSeries.C c}),
      ∀ w : W₀, q (Ideal.Quotient.mk _ (MvPowerSeries.C (f w))) = Ideal.Quotient.mk _ (MvPowerSeries.C w) := by
  subst hd
  set I : Ideal (MvPowerSeries (Fin 2) W₀) :=
    Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) W₀) * MvPowerSeries.X 1 - MvPowerSeries.C c} with hI
  set J : Ideal (MvPowerSeries (Fin 2) W₁) :=
    Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) W₁) * MvPowerSeries.X 1 - MvPowerSeries.C (f c)} with hJ
  have hIJ : J = I.map (mvPowerSeriesMapEquiv (σ := Fin 2) f : MvPowerSeries (Fin 2) W₀ →+* MvPowerSeries (Fin 2) W₁) := by
    rw [hI, Ideal.map_span, Set.image_singleton]
    simp only [RingHom.coe_coe, mvPowerSeriesMapEquiv_apply, map_sub, map_mul, MvPowerSeries.map_X,
      MvPowerSeries.map_C, RingHom.coe_coe]
    exact hJ
  refine ⟨(Ideal.quotientEquiv I J (mvPowerSeriesMapEquiv (σ := Fin 2) f) hIJ).symm, fun w => ?_⟩
  rw [RingEquiv.symm_apply_eq, Ideal.quotientEquiv_mk]
  simp only [mvPowerSeriesMapEquiv_apply, MvPowerSeries.map_C, RingHom.coe_coe]

theorem crossing_transport
    (A₀ : Type) [CommRing A₀] [IsLocalRing A₀] (ϖ₀ : A₀)
    (A₁ : Type) [CommRing A₁] [IsLocalRing A₁] (e₁ : A₀ ≃+* A₁) (π₁ : A₁) (hπ₁ : e₁ ϖ₀ = π₁)
    {F : Type} [Field F]
    (O : Subring F) [IsLocalRing ↥O] [IsNoetherianRing ↥O]
    (cO : A₀ →+* ↥O) (E₀ : ℕ)
    (ι : AdicCompletion (maximalIdeal ↥O) ↥O ≃+*
      ModularCurve.UVCrossingModel (AdicCompletion (maximalIdeal A₁) A₁)
        ((algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) π₁) ^ E₀))
    (hι : ∀ a : A₀, ι (algebraMap ↥O (AdicCompletion (maximalIdeal ↥O) ↥O) (cO a)) =
      ModularCurve.UVCrossingModel.const ((algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) π₁) ^ E₀)
        (algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) (e₁ a)))
    (R : Type) [CommRing R] [IsLocalRing R] (eR : R ≃+* ↥O) (jR : A₀ →+* R) (hjR : ∀ a : A₀, eR (jR a) = cO a) :
    IsNoetherianRing R ∧
    ∃ e : AdicCompletion (maximalIdeal R) R ≃+*
        (MvPowerSeries (Fin 2) (AdicCompletion (maximalIdeal A₀) A₀) ⧸
          Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) (AdicCompletion (maximalIdeal A₀) A₀)) * MvPowerSeries.X 1 -
            MvPowerSeries.C ((algebraMap A₀ (AdicCompletion (maximalIdeal A₀) A₀) ϖ₀) ^ E₀)}),
      ∀ a : A₀, e (algebraMap R (AdicCompletion (maximalIdeal R) R) (jR a)) =
        Ideal.Quotient.mk _ (MvPowerSeries.C (algebraMap A₀ (AdicCompletion (maximalIdeal A₀) A₀) a)) := by
  classical
  have hR : IsNoetherianRing R := isNoetherianRing_of_ringEquiv ↥O eR.symm
  refine ⟨hR, ?_⟩
  obtain ⟨êR, hêR⟩ := adicCompletion_maximalIdeal_ringEquiv eR
  obtain ⟨ê₁, hê₁⟩ := adicCompletion_maximalIdeal_ringEquiv e₁
  have hd : ê₁ ((algebraMap A₀ (AdicCompletion (maximalIdeal A₀) A₀) ϖ₀) ^ E₀) =
      (algebraMap A₁ (AdicCompletion (maximalIdeal A₁) A₁) π₁) ^ E₀ := by
    rw [map_pow, hê₁, hπ₁]
