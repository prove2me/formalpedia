variable {d : Type*} [Fintype d]

private theorem hasSum_mFourier_off_zero (f : C(UnitAddTorus d, ℂ)) (hf : Summable (mFourierCoeff f)) (x : UnitAddTorus d) :
    HasSum (fun m : {m : d → ℤ // m ≠ 0} => mFourierCoeff f m * mFourier m x) (f x - mFourierCoeff f 0) := by
  have h := hasSum_mFourier_series_apply_of_summable hf x
  have key : HasSum (fun m : {m : d → ℤ // m ∉ ({0} : Finset (d → ℤ))} => mFourierCoeff f m • mFourier m x)
      (f x - mFourierCoeff f 0) := by
    refine (Finset.hasSum_compl_iff (f := fun i : d → ℤ => mFourierCoeff f i • mFourier i x) {0}).mpr ?_
    rwa [Finset.sum_singleton, mFourier_zero, ContinuousMap.one_apply, smul_eq_mul, mul_one, sub_add_cancel]
  let e : {m : d → ℤ // m ∉ ({0} : Finset (d → ℤ))} ≃ {m : d → ℤ // m ≠ 0} :=
    Equiv.subtypeEquivRight fun m => not_congr Finset.mem_singleton
  have key2 : HasSum ((fun m : {m : d → ℤ // m ≠ 0} => mFourierCoeff f m * mFourier m x) ∘ e) (f x - mFourierCoeff f 0) := by
    convert key using 1
    all_goals try rfl
  exact e.hasSum_iff.mp key2

private theorem summable_norm_mFourierCoeff_off_zero {f : UnitAddTorus d → ℂ} (hf : Summable (mFourierCoeff f)) :
    Summable fun m : {m : d → ℤ // m ≠ 0} => ‖mFourierCoeff f m‖ :=
  (hf.subtype {m : d → ℤ | m ≠ 0}).norm

private theorem norm_sub_mFourierCoeff_zero_le (f : C(UnitAddTorus d, ℂ)) (hf : Summable (mFourierCoeff f)) (x : UnitAddTorus d) :
    ‖f x - mFourierCoeff f 0‖ ≤ ∑' m : {m : d → ℤ // m ≠ 0}, ‖mFourierCoeff f m‖ := by
  rw [← (hasSum_mFourier_off_zero f hf x).tsum_eq]
  have h1 := summable_norm_mFourierCoeff_off_zero hf
  have h2 : ∀ m : {m : d → ℤ // m ≠ 0}, ‖mFourierCoeff f m * mFourier m x‖ ≤ ‖mFourierCoeff f m‖ := fun m => by
    rw [norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) (norm_mFourier_apply_le_one _ _)
  have h3 : Summable fun m : {m : d → ℤ // m ≠ 0} => ‖mFourierCoeff f m * mFourier m x‖ :=
    Summable.of_nonneg_of_le (fun _ => norm_nonneg _) h2 h1
  exact (norm_tsum_le_tsum_norm h3).trans (h3.tsum_le_tsum h2 h1)

