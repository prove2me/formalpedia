theorem GlobalTheory.SatakeBound.card_hermIdx (hp : Irreducible p) (a : Fin n → ℕ) :
    Nat.card (HermIdx p a) = ∏ i : Fin n, (resCard k ^ (n - 1 - (i : ℕ))) ^ a i := by sorry
