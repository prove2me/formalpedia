    have h2 := costL_le cost dw bd hmono l (fun b hb => h b (List.mem_cons_of_mem _ hb)) (w + dw a)
    have e : w + dw a + (l.map dw).sum = w + (dw a + (l.map dw).sum) := by ring
    rw [e] at h2
