theorem NLogN.exp_inv_all (n : ℕ) (x y : ℤ) (s : IState HS) (L5 L6 L7 : List Item)
    (h5 : s.G 5 = .int n :: L5) (h6 : s.G 6 = .int x :: L6) (h7 : s.G 7 = .int y :: L7) :
    ∀ k ≤ 2 * n + 13, expInv (2 * n + 9) (2 * n + 13) (x * 2 ^ (n + 9)) (y * 2 ^ (n + 9)) s k
      (NLogN.RS.repSt 39 eKE expBody (expPre.run s) k) := by sorry
