    Classical.choice (TypeDensity.cell_assignment_exists _ m.s (m.shape.valid m.ha) c.1.1 c.1.2 c.2.1 c.2.2)
  have key : ∀ j : m.toMeasured.childIdx c,
      ∃ cm : TypeDensity.ChildMember m (m.toMeasured.childDelta c j) (m.toMeasured.childState c j),
      ∃ Eq : TypeDensity.divisorLocalRing m.R m.S.t m.S.x e c.2.1 hinf (asg.point j) ≃+* cm.mc.R,
        Eq (TypeDensity.divisorException m.R m.S.t m.S.x e c.2.1 hinf (asg.point j)) = cm.mc.S.t ∧
        ((asg.pt j = TypeDensity.infinityDirection (IsLocalRing.ResidueField m.R) ∨
          asg.pt j = TypeDensity.zeroDirection (IsLocalRing.ResidueField m.R)) →
          Eq (TypeDensity.divisorBoundary m.R m.S.t m.S.x e c.2.1 hinf (asg.point j)) = cm.mc.S.x) ∧
        ∀ r : m.O, Eq (TypeDensity.divisorFromSurface m.R m.S.t m.S.x e c.2.1 hinf (asg.point j)
          (algebraMap m.O m.R r)) = algebraMap cm.mc.O cm.mc.R (algebraMap m.O cm.mc.O r) := by
    intro j
    have hP := c.1.2
    have hDv := c.2.2
    have hpos : 0 < c.2.1 (asg.pt j) := (asg.supp _).mpr ⟨j, rfl⟩
    have hb : (asg.point j).val = TypeDensity.infinityDirection (IsLocalRing.ResidueField m.R) →
        c.1.1.d.val < TypeDensity.stateContactT m.s := by
      intro hQ
      have hQ' : asg.pt j = TypeDensity.infinityDirection _ := hQ
      rw [hQ'] at hpos
      exact TypeDensity.pattern_d_lt_contactT m.s c.1.1 hP (hDv.2.1 ▸ hpos)
    have hz : (asg.point j).val = TypeDensity.zeroDirection (IsLocalRing.ResidueField m.R) →
        ∀ h : ℕ, TypeDensity.stateContactX m.s = some h → c.1.1.d.val < h := by
      intro hQ h hh
      have hQ' : asg.pt j = TypeDensity.zeroDirection _ := hQ
      rw [hQ'] at hpos
      exact TypeDensity.pattern_d_lt_contactX _ m.s c.1.1 hP c.2.1 hDv hpos h hh
    have := TypeDensity.direction_child_member_exists m e he heZ hinf c.2.1 c.1.1.d.val (asg.point j) hb hz
    have h1 : m.toMeasured.childDelta c j = TypeDensity.directionDegree _ (asg.point j).val := (asg.deg j).symm
    have h2 : m.toMeasured.childState c j = TypeDensity.pointChildState _ m.s c.1.1.d.val c.2.1
        (asg.point j).val :=
      asg.state j
    rwa [h1, h2]
  choose child Eq hEq_e hEq_b hEq_c using key
  exact ⟨⟨e, he, heZ, hinf, asg, child, Eq, hEq_e, hEq_b, hEq_c⟩⟩
