/-- `rrJTerm` agrees with the summand in the finite `rrJ`. -/
theorem rrJTerm_eq (x q : ℂ) (n : ℕ) :
    rrJTerm x q n = x ^ n * q ^ (n * n) / qPochhammer q n := rfl

