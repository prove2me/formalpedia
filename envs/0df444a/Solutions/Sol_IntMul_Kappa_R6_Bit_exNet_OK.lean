theorem h50i_runArr {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {α : Type*} (d : α) :
    ∀ (steps : List (Step n Q)) (xs : List α), xs.length = vol sh →
    (∀ s ∈ steps, ∀ a, Valid sh a → Valid sh (s.inv Λ a)) →
    runArr Λ d steps xs = pull sh sh (invChain Λ steps) d xs
  | [], xs, hx, _ => by
    show xs = pull sh sh id d xs
    rw [h50i_pull_id d xs hx]
  | s :: ss, xs, hx, h => by
    show runArr Λ d ss (pull sh sh (s.inv Λ) d xs) = pull sh sh (s.inv Λ ∘ invChain Λ ss) d xs
    rw [h50i_runArr Λ d ss _ (h50i_length_pull _ _ _ _) (fun t ht => h t (by simp [ht])),
      h50i_pull_pull _ _ _ _ (h50i_invChain_valid Λ ss (fun t ht => h t (by simp [ht])))]

