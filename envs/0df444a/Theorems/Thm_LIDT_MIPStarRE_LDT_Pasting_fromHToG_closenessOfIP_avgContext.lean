    (γ : _root_.LIDT.MIPStarRE.LDT.Error)
    (hAB : _root_.LIDT.MIPStarRE.LDT.avgOver 𝒟 (fun q => _root_.LIDT.MIPStarRE.LDT.qSDDCore ψ (A q) (B q)) ≤ γ)
    (hC : _root_.LIDT.MIPStarRE.LDT.avgOver 𝒟 (fun q =>
