variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem J6Seg.Slab.slabOut_runs {pM : Fin P} (hMul : MulOK I iprog pM NLogN.KFUU.MS) (s : IState HS)
    (F : Fin HS → List ℤ) {N post pre : ℕ} (hnp : 0 < N * post) (p P' s' t α : ℕ)
    (Y Y₂ : List GI) (l l₂ : List ℤ) (hY : Y.length = pre * (N * post))
    (hY₂ : Y₂.length = pre * (N * post)) {Bu Ba : ℕ} (hBa : 1 ≤ Ba)
    (hBu : ∀ u ∈ gflat Y, zsz u ≤ Bu) (hBu₂ : ∀ u ∈ gflat Y₂, zsz u ≤ Bu)
    (harg : ∀ l, zsz (argO p s' t α l) ≤ Ba)
    (hF0 : F 0 = gflat Y ++ l) (hFZ : F rZ = gflat Y₂ ++ l₂)
    {l1 l2 : List ℤ} (hK1 : F rK1 = (2 : ℤ) ^ (P' - p) :: l1) (hK2 : F rK2 = (2 : ℤ) ^ p :: l2)
    (hA : F lA = []) (hC : F lC = []) (hD : F lD = []) (RC : List ℤ)
    (hFC : F rC = flatC (ctlOf N N (fun l => some l) (argO p s' t α)) ++ RC) (hACC : F rACC = [])
    {LM : List ℤ} (hM : F rM = ((2 * post : ℕ) : ℤ) :: LM) {LN : List ℤ}
    (hN : F rNC = ((ctlOf N N (fun l => some l) (argO p s' t α)).length : ℤ) :: LN) {LB : List ℤ}
    (hB : F rNB = (pre : ℤ) :: LB) {LT : List ℤ}
    (hT : F rTOT = ((pre * (N * (2 * post)) : ℕ) : ℤ) :: LT) :
    IRuns I iprog (J6Seg.Slab.passP drP rdP (itO pM) bkP) (encK s F)
      (encK s (update (update F 0
        (gflat (slabPass N N post (fun l => some l) (J6Seg.outH p P' s' t α) (List.zip Y Y₂)) ++ l))
        rZ l₂))
      (passC pre (ctlOf N N (fun l => some l) (argO p s' t α)).length (2 * post) Ba
        (2 * (2 * Bu + 2) + 2 * (2 * moveCost Bu + 19) + cItO (Bu + Ba + 2) (P' - p) p +
          2 * (2 * moveCost Bu + 19))
        (pre * (N * (2 * post))) (Bu + Ba + 1)) := by sorry
