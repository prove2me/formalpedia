/-- A vertex is its own ancestor. Further steps follow the returned parent
array from a parent to a child, and remain in the finite vertex set. -/
inductive ParentPath (g : Graph) (parent : Seq) : Int → Int → Prop where
  | refl {u : Int} : Vertex g u → ParentPath g parent u u
  | step {u v w : Int} :
      ParentPath g parent u v → Vertex g w → parent w = v →
      ParentPath g parent u w

/-- A path whose vertices all belong to a specified set. The zero-edge path
also requires membership, so it is exactly induced-subgraph reachability. -/
inductive AllowedWalk (g : Graph) (allowed : Int → Prop) : Int → Int → Prop where
  | refl {u : Int} : Vertex g u → allowed u → AllowedWalk g allowed u u
  | step {u v w : Int} :
      Edge g u v → allowed u → AllowedWalk g allowed v w →
      AllowedWalk g allowed u w

/-- The root of a vertex's returned predecessor tree. -/
def RootOf (g : Graph) (parent : Seq) (root vertex : Int) : Prop :=
  Vertex g root ∧ parent root = -1 ∧ ParentPath g parent root vertex

/-- The ordered DFS forest, its event times, and the information needed to
reuse DFS in the two-pass strongly connected components algorithm.
`order` is the output in increasing finish time. `inputOrder` is the initial
outer-loop priority, and `component` numbers predecessor trees from zero.
These labels are not asserted to identify strongly connected components. -/
structure Forest (g : Graph)
    (inputOrder parent discover finish order component : Seq)
    (count : Nat) : Prop where
  parentEdges : ∀ v : Int, Vertex g v →
    parent v = -1 ∨ Edge g (parent v) v
  times : ∀ v : Int, Vertex g v →
    1 ≤ discover v ∧ discover v < finish v ∧ finish v ≤ 2 * (g.size : Int)
  discoveryDistinct : ∀ u v : Int, Vertex g u → Vertex g v →
    discover u = discover v → u = v
  finishDistinct : ∀ u v : Int, Vertex g u → Vertex g v →
    finish u = finish v → u = v
  eventDistinct : ∀ u v : Int, Vertex g u → Vertex g v →
    discover u ≠ finish v
  parentheses : ∀ u v : Int, Vertex g u → Vertex g v →
    finish u < discover v ∨ finish v < discover u ∨
      (discover u ≤ discover v ∧ finish v ≤ finish u) ∨
      (discover v ≤ discover u ∧ finish u ≤ finish v)
  ancestors : ∀ u v : Int, Vertex g u → Vertex g v →
    (ParentPath g parent u v ↔ discover u ≤ discover v ∧ finish v ≤ finish u)
  whitePaths : ∀ u v : Int, Vertex g u → Vertex g v →
    (ParentPath g parent u v ↔
      AllowedWalk g (fun w => discover u ≤ discover w) u v)
  rootPriority : ∀ i : Nat, i < g.size →
    parent (inputOrder (i : Int)) = -1 →
    ∀ j : Nat, j < i →
      finish (inputOrder (j : Int)) < discover (inputOrder (i : Int))
  finishOrder : VertexOrder g order
  finishIncreasing : ∀ i j : Nat, i < j → j < g.size →
    finish (order (i : Int)) < finish (order (j : Int))
  componentRange : ∀ v : Int, Vertex g v →
    0 ≤ component v ∧ component v < (count : Int)
  componentCoverage : ∀ label : Nat, label < count →
    ∃ v : Int, Vertex g v ∧ component v = (label : Int)
  componentTrees : ∀ u v : Int, Vertex g u → Vertex g v →
    (component u = component v ↔
      ∃ root : Int, RootOf g parent root u ∧ RootOf g parent root v)
  componentOrder : ∀ u v : Int, Vertex g u → Vertex g v →
    parent u = -1 → parent v = -1 →
    (component u < component v ↔ discover u < discover v)

/-- A fresh result object with six distinct fresh arrays, preserving every
initially allocated caller sequence, object, and collection. Every valid vertex
is black, all discovery/finish events have occurred, and the mathematical
forest contract uses the caller's original root-order sequence. Contents
outside the vertex prefixes are deliberately unspecified. -/
def Post (before after : Heap) (result : ObjectRef) (g : Graph)
    (inputOrder : Seq) : Prop :=
  Algo.dfs.Algo2LeanGenerated.is_DFSResult after result ∧
  FreshObject before after result ∧
  Preserves before after ∧
  ∃ color parent discover finish order component : SeqRef,
    Algo.dfs.Algo2LeanGenerated.field_DFSResult_color after result = some color ∧
    Algo.dfs.Algo2LeanGenerated.field_DFSResult_parent after result = some parent ∧
    Algo.dfs.Algo2LeanGenerated.field_DFSResult_discover after result = some discover ∧
    Algo.dfs.Algo2LeanGenerated.field_DFSResult_finish after result = some finish ∧
    Algo.dfs.Algo2LeanGenerated.field_DFSResult_order after result = some order ∧
    Algo.dfs.Algo2LeanGenerated.field_DFSResult_component after result = some component ∧
    FreshArrays before after [color, parent, discover, finish, order, component] ∧
    Algo.dfs.Algo2LeanGenerated.field_DFSResult_clock after result = some (2 * (g.size : Int)) ∧
    Algo.dfs.Algo2LeanGenerated.field_DFSResult_finished after result = some (g.size : Int) ∧
    (∀ v : Int, Vertex g v → after.read color v = 2) ∧
    ∃ count : Nat,
      Algo.dfs.Algo2LeanGenerated.field_DFSResult_components after result = some (count : Int) ∧
      count ≤ g.size ∧
      Forest g inputOrder (after.read parent) (after.read discover)
        (after.read finish) (after.read order) (after.read component) count

end CLRS.DFS


