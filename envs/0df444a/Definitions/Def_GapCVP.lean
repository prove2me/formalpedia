        paperVariableArityReverseNameEquality_false]
theorem paperVariableAritySignedClauseStreamFirstOccurrence
    (clauses : List ThreeClause) (seen suffix : List ℕ) :
    (seen ++ formulaVariables clauses ++ suffix).eraseDups =
      (seen ++
