theorem isIso_specMap_ringEquiv {S S' : Type} [CommRing S] [CommRing S'] (e : S ≃+* S') :
    IsIso (Spec.map (CommRingCat.ofHom e.toRingHom)) := by
  refine ⟨⟨Spec.map (CommRingCat.ofHom e.symm.toRingHom), ?_, ?_⟩⟩
  · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have : e.toRingHom.comp e.symm.toRingHom = RingHom.id _ := by ext x; simp
    rw [this, CommRingCat.ofHom_id, Spec.map_id]
  · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have : e.symm.toRingHom.comp e.toRingHom = RingHom.id _ := by ext x; simp
    rw [this, CommRingCat.ofHom_id, Spec.map_id]

theorem specMap_symm_comp {S S' : Type} [CommRing S] [CommRing S'] (e : S ≃+* S') :
    Spec.map (CommRingCat.ofHom e.symm.toRingHom) ≫ Spec.map (CommRingCat.ofHom e.toRingHom) = 𝟙 _ := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have : e.symm.toRingHom.comp e.toRingHom = RingHom.id _ := by ext x; simp
  rw [this, CommRingCat.ofHom_id, Spec.map_id]

theorem mul_val_congr {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (h : t₁ = t₂)
    (P Q : SchemeHomOver t₁ f) (P' Q' : SchemeHomOver t₂ f) (hP : P.1 = P'.1) (hQ : Q.1 = Q'.1) :
    (L.mul t₁ P Q).1 = (L.mul t₂ P' Q').1 := by
  subst h
  obtain rfl : P = P' := Subtype.ext hP
  obtain rfl : Q = Q' := Subtype.ext hQ
  rfl

theorem isPullbackVia_inv {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ}
    {S S' : Type} [CommRing S] [CommRing S'] (e : S ≃+* S')
    (E : FakeEllipticCurve Λ N S) (E' : FakeEllipticCurve Λ N S') (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia e.toRingHom E E' g)
    (hlev' : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (P : SchemeHomOver t' E'.f),
      (∃ P₀ : T ⟶ E.C, P₀ ≫ E.lev = P.1 ≫ g) → FactorsThrough E'.lev P)
    [IsIso g] :
    FakeEllipticCurve.IsPullbackVia e.symm.toRingHom E' E (inv g) := by
  obtain ⟨sq, hmul, hact, hlev⟩ := hg
  haveI := isIso_specMap_ringEquiv e

  have hw : inv g ≫ E'.f = E.f ≫ Spec.map (CommRingCat.ofHom e.symm.toRingHom) := by
    rw [IsIso.inv_comp_eq, ← Category.assoc, sq.w, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have : e.toRingHom.comp e.symm.toRingHom = RingHom.id _ := by ext x; simp
    rw [this, CommRingCat.ofHom_id, Spec.map_id, Category.comp_id]
  haveI : IsIso (Spec.map (CommRingCat.ofHom e.symm.toRingHom)) := by
    have := isIso_specMap_ringEquiv e.symm
    simpa using this
  have sq' : IsPullback (inv g) E.f E'.f (Spec.map (CommRingCat.ofHom e.symm.toRingHom)) :=
    IsPullback.of_horiz_isIso ⟨hw⟩
  refine ⟨sq', ?_, ?_, ?_⟩
  · intro T t' P Q

    rw [IsIso.comp_inv_eq]
    have key := hmul (t' ≫ Spec.map (CommRingCat.ofHom e.symm.toRingHom))
      ⟨P.1 ≫ inv g, by rw [Category.assoc, hw, ← Category.assoc, P.2]⟩
      ⟨Q.1 ≫ inv g, by rw [Category.assoc, hw, ← Category.assoc, Q.2]⟩
    rw [key]
    symm
    apply mul_val_congr
    · rw [Category.assoc, specMap_symm_comp, Category.comp_id]
    · simp
    · simp
  · intro x
    rw [IsIso.comp_inv_eq, Category.assoc, IsIso.eq_inv_comp, hact]
  · intro T t' P hP
    have := hlev' (t' ≫ Spec.map (CommRingCat.ofHom e.symm.toRingHom))
      ⟨P.1 ≫ inv g, by rw [Category.assoc, hw, ← Category.assoc, P.2]⟩
      (by obtain ⟨P₀, hP₀⟩ := hP; exact ⟨P₀, by rw [hP₀, Category.assoc, IsIso.inv_hom_id, Category.comp_id]⟩)
    exact this

