theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) {N : ℕ}
    {S : Type u} [CommRing S] {m : ℕ} (hm : 3 ≤ m) (hmS : IsUnit ((m : ℕ) : S))
    (u : FakeEllipticCurve.WithFullLevel Λ N m S)
    (e : u.1.A ≅ u.1.A) (he : e.hom ≫ u.1.f = u.1.f)
    (hmul : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t u.1.f),
      mapPt e.hom he (u.1.L.mul t P Q) = u.1.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q))
    (hact : ∀ x : ↥Λ, u.1.act x ≫ e.hom = e.hom ≫ u.1.act x)
    (hP : mapPt e.hom he u.2.P = u.2.P) :
    e = Iso.refl u.1.A := by
  obtain ⟨E, P⟩ := u

  suffices h : e.hom = 𝟙 E.A from Iso.ext h
  have hP1 : P.P.1 ≫ e.hom = P.P.1 := by simpa [mapPt] using congrArg Subtype.val hP
  have heinv : e.inv ≫ E.f = E.f := by rw [Iso.inv_comp_eq, he]
  refine GoodReductionJacobian.AbelianSchemePropertyBundle.eq_id_of_one_comp_eq_of_forall_comp_eq_of_isAlgClosed
    E.bundle E.L e.hom he ?_ ?_
  ·
    letI := E.L.pointGroup (𝟙 (Spec (CommRingCat.of S)))
    have h := hmul (𝟙 _) (E.L.one _) (E.L.one _)
    rw [E.L.one_mul] at h
    have h1 : mapPt e.hom he (E.L.one (𝟙 _)) = E.L.one (𝟙 _) :=
      mul_left_cancel (a := mapPt e.hom he (E.L.one (𝟙 _))) (h.symm.trans (mul_one _).symm)
    simpa [mapPt] using congrArg Subtype.val h1
  ·
    intro k _ _ x

    obtain ⟨ψ, hψ⟩ := Spec.map_surjective (x ≫ E.f)
    set φ : S →+* k := ψ.hom with hφ_def
    have hx : x ≫ E.f = Spec.map (CommRingCat.ofHom φ) := by rw [hφ_def, CommRingCat.ofHom_hom, hψ]

    obtain ⟨E', g, hg, hgmul, hgact, -, -⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff φ E

    have w₁ : (g ≫ e.hom) ≫ E.f = E'.f ≫ Spec.map (CommRingCat.ofHom φ) := by rw [Category.assoc, he, hg.w]
    have w₂ : (g ≫ e.inv) ≫ E.f = E'.f ≫ Spec.map (CommRingCat.ofHom φ) := by rw [Category.assoc, heinv, hg.w]
    let e' : E'.A ≅ E'.A :=
      { hom := hg.lift (g ≫ e.hom) E'.f w₁
        inv := hg.lift (g ≫ e.inv) E'.f w₂
        hom_inv_id := by
          apply hg.hom_ext
          · rw [Category.assoc, hg.lift_fst, ← Category.assoc, hg.lift_fst, Category.assoc, e.hom_inv_id,
              Category.comp_id, Category.id_comp]
          · rw [Category.assoc, hg.lift_snd, hg.lift_snd, Category.id_comp]
        inv_hom_id := by
          apply hg.hom_ext
          · rw [Category.assoc, hg.lift_fst, ← Category.assoc, hg.lift_fst, Category.assoc, e.inv_hom_id,
              Category.comp_id, Category.id_comp]
          · rw [Category.assoc, hg.lift_snd, hg.lift_snd, Category.id_comp] }
    have he'g : e'.hom ≫ g = g ≫ e.hom := hg.lift_fst _ _ _
    have he' : e'.hom ≫ E'.f = E'.f := hg.lift_snd _ _ _

    have hmk : (m : k) ≠ 0 := by
      have := hmS.map φ
