theorem isComm_map {B B' : Type} [CommRing B] [CommRing B'] (φ : B →+* B') (F : MvFormalGroup 2 B) [hF : F.IsComm] :
    (F.map φ).IsComm := by
  constructor
  intro i
  have key := congrArg (MvPowerSeries.map φ) (hF.comm i)
  have hS : MvPowerSeries.HasSubst (Sum.elim
      (fun j => (MvPowerSeries.X (Sum.inr j) : MvPowerSeries (Fin 2 ⊕ Fin 2) B))
      fun j => MvPowerSeries.X (Sum.inl j)) := by
    apply MvPowerSeries.hasSubst_of_constantCoeff_zero
    rintro (j | j) <;> exact MvPowerSeries.constantCoeff_X _
  rw [MvPowerSeries.map_subst hS] at key
  have hfam : (fun s => MvPowerSeries.map φ (Sum.elim
      (fun j => (MvPowerSeries.X (Sum.inr j) : MvPowerSeries (Fin 2 ⊕ Fin 2) B))
      (fun j => MvPowerSeries.X (Sum.inl j)) s))
      = Sum.elim
        (fun j => (MvPowerSeries.X (Sum.inr j) : MvPowerSeries (Fin 2 ⊕ Fin 2) B'))
        fun j => MvPowerSeries.X (Sum.inl j) := by
    funext s
    rcases s with j | j <;> simp only [Sum.elim_inl, Sum.elim_inr, MvPowerSeries.map_X]
  rw [hfam] at key
  exact key

theorem coe_mul_eq_of_eq {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {S : Scheme.{0}} {t t' : S ⟶ Spec (CommRingCat.of R)} (h : t = t')
    (P Q : SchemeHomOver t f) (P' Q' : SchemeHomOver t' f) (hP : P.1 = P'.1) (hQ : Q.1 = Q'.1) :
    (L.mul t P Q).1 = (L.mul t' P' Q').1 := by
  subst h
  obtain rfl : P = P' := Subtype.ext hP
  obtain rfl : Q = Q' := Subtype.ext hQ
  rfl

def Concl (B B₀ : Type) [CommRing B] [CommRing B₀] [Algebra B B₀]
    {A₀ : Scheme.{0}} (f₀ : A₀ ⟶ Spec (CommRingCat.of B₀)) (L₀ : RelativeGroupLaw B₀ f₀)
    (F : MvFormalGroup 2 B) (θ₀ : RelativeGroupLaw.FormalCoordinates f₀ 2) : Prop :=
  ∃ (D : BareDeformation f₀ L₀ B) (θ : RelativeGroupLaw.FormalCoordinates D.f 2),
    D.L.IsFormalCoordinates F θ ∧ D.LiftsCoordinates θ₀ θ

theorem step {q : ℕ} [Fact q.Prime] (n : ℕ) : ∀ (B : Type) [CommRing B] [IsLocalRing B] [IsArtinianRing B]
    [IsAlgClosed (ResidueField B)] (B₀ : Type) [CommRing B₀] [Algebra B B₀]
    (_hπ : Function.Surjective (algebraMap B B₀)) (_hker : IsNilpotent (RingHom.ker (algebraMap B B₀)))
    (_hn : RingHom.ker (algebraMap B B₀) * maximalIdeal B ^ n = ⊥)
    (_hq : IsNilpotent ((q : ℕ) : B))
    {A₀ : Scheme.{0}} (f₀ : A₀ ⟶ Spec (CommRingCat.of B₀)) (L₀ : RelativeGroupLaw B₀ f₀) (_hc₀ : L₀.IsCommutative)
    (_h₀ : AbelianSchemePropertyBundle B₀ f₀)
    (F : MvFormalGroup 2 B) [F.IsComm]
    (θ₀ : RelativeGroupLaw.FormalCoordinates f₀ 2) (_hθ₀ : L₀.IsFormalCoordinates (F.map (algebraMap B B₀)) θ₀)
    (_hinf₀ : ∀ (C : Type) [CommRing C] [Algebra B₀ C] (m : ℕ) (P : SchemeHomOver (Scheme.specOver (𝒪 := B₀) C) f₀),
      nsmulPt L₀ (Scheme.specOver (𝒪 := B₀) C) (q ^ m) P = L₀.one (Scheme.specOver (𝒪 := B₀) C) →
        ∃ J : Ideal C, IsNilpotent J ∧ L₀.IsInfinitesimal J P)
    (_hheight : ∀ (k : Type) [Field k] (ρ : B →+* k), Function.Surjective ρ →
      Module.finrank k (MvPowerSeries (Fin 2) k ⧸ Ideal.span (Set.range ((F.map ρ).nthSeries q))) = q ^ 4),
    Concl B B₀ f₀ L₀ F θ₀ := by
  induction n with
  | zero =>
    intro B _ _ _ _ B₀ _ _ hπ hker hn hq A₀ f₀ L₀ hc₀ h₀ F _ θ₀ hθ₀ hinf₀ hheight
    have hsmall : RingHom.ker (algebraMap B B₀) * maximalIdeal B = ⊥ := by
      rw [pow_zero, Ideal.one_eq_top, Ideal.mul_top] at hn
      rw [hn, Ideal.bot_mul]
    exact BareDeformation.exists_isFormalCoordinates_liftsCoordinates_of_ker_mul_maximalIdeal_eq_bot
      B B₀ hπ hker hsmall hq f₀ L₀ hc₀ h₀ F θ₀ hθ₀ hinf₀ hheight
  | succ n ih =>
    intro B _ _ _ _ B₀ _ _ hπ hker hn hq A₀ f₀ L₀ hc₀ h₀ F _ θ₀ hθ₀ hinf₀ hheight
    set π : B →+* B₀ := algebraMap B B₀ with hπdef

    have hkertop : RingHom.ker π ≠ ⊤ := by
      intro h
      obtain ⟨k, hk⟩ := hker
      rw [h, ← Ideal.one_eq_top, one_pow, Ideal.one_eq_top, Ideal.zero_eq_bot] at hk
      exact top_ne_bot hk

    set J : Ideal B := RingHom.ker π * maximalIdeal B ^ n with hJ
    have hJle : J ≤ RingHom.ker π := Ideal.mul_le_left
    have hJm : J * maximalIdeal B = ⊥ := by rw [hJ, mul_assoc, ← pow_succ, hn]
    have hJne : J ≠ ⊤ := ne_top_of_le_ne_top hkertop hJle
    have hJlem : J ≤ maximalIdeal B := le_maximalIdeal hJne
    haveI : Nontrivial (B ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJne
    haveI : IsLocalRing (B ⧸ J) := IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    haveI : IsLocalHom (Ideal.Quotient.mk J) := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    have hm₁ : (maximalIdeal B).map (Ideal.Quotient.mk J) = maximalIdeal (B ⧸ J) := by
      refine (Ideal.map_eq_top_or_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
        (maximalIdeal.isMaximal B)).resolve_left ?_ |> IsLocalRing.eq_maximalIdeal
      intro htop
      have := Ideal.comap_map_of_surjective (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective (maximalIdeal B)
      rw [htop, Ideal.comap_top, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hJlem] at this
      exact (maximalIdeal.isMaximal B).ne_top this.symm
    haveI : IsAlgClosed (ResidueField (B ⧸ J)) := by
      have hsurj : Function.Surjective (ResidueField.map (Ideal.Quotient.mk J)) := by
        intro y
        obtain ⟨x, rfl⟩ := residue_surjective y
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact ⟨residue B x, ResidueField.map_residue _ x⟩
      exact IsAlgClosed.of_ringEquiv (ResidueField B) (ResidueField (B ⧸ J))
        (RingEquiv.ofBijective _ ⟨(ResidueField.map (Ideal.Quotient.mk J)).injective, hsurj⟩)

    set π₂ : B ⧸ J →+* B₀ := Ideal.Quotient.lift J π (fun a ha => hJle ha) with hπ₂
    letI : Algebra (B ⧸ J) B₀ := π₂.toAlgebra
    have hπ₁ : algebraMap B (B ⧸ J) = Ideal.Quotient.mk J := rfl
    have hπ₂a : algebraMap (B ⧸ J) B₀ = π₂ := rfl
    have hcomp : π₂.comp (Ideal.Quotient.mk J) = π := RingHom.ext fun x => by simp [π₂]
    have hcomp' : (algebraMap (B ⧸ J) B₀).comp (algebraMap B (B ⧸ J)) = algebraMap B B₀ := by
      rw [hπ₂a, hπ₁, hcomp]
    have hπ₂s : Function.Surjective π₂ := fun y => by
      obtain ⟨x, rfl⟩ := hπ y
      exact ⟨Ideal.Quotient.mk J x, by simp [π₂]⟩
    have hker₂le : RingHom.ker π₂ ≤ (RingHom.ker π).map (Ideal.Quotient.mk J) := by
      intro y hy
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      refine Ideal.mem_map_of_mem _ ?_
      rw [RingHom.mem_ker] at hy ⊢
      simpa [π₂] using hy
    have hker₂ : IsNilpotent (RingHom.ker (algebraMap (B ⧸ J) B₀)) := by
      rw [hπ₂a]
      obtain ⟨k, hk⟩ := hker
      refine ⟨k, ?_⟩
      rw [Ideal.zero_eq_bot] at hk ⊢
      exact le_bot_iff.mp ((Ideal.pow_right_mono hker₂le k).trans
        (by rw [← Ideal.map_pow, hk, Ideal.map_bot]))
    have hn₂ : RingHom.ker (algebraMap (B ⧸ J) B₀) * maximalIdeal (B ⧸ J) ^ n = ⊥ := by
      rw [hπ₂a]
      refine le_bot_iff.mp ((Ideal.mul_mono hker₂le le_rfl).trans ?_)
      rw [← hm₁, ← Ideal.map_pow, ← Ideal.map_mul, ← hJ]
      simp [Ideal.map_quotient_self]
    have hq₁ : IsNilpotent ((q : ℕ) : B ⧸ J) := by
      obtain ⟨k, hk⟩ := hq
      exact ⟨k, by rw [← map_natCast (Ideal.Quotient.mk J), ← map_pow, hk, map_zero]⟩

    haveI : (F.map (algebraMap B (B ⧸ J))).IsComm := isComm_map _ F
    have hθ₀' : L₀.IsFormalCoordinates ((F.map (algebraMap B (B ⧸ J))).map (algebraMap (B ⧸ J) B₀)) θ₀ := by
      rw [MvFormalGroup.map_map', hcomp']; exact hθ₀
    have hheight₁ : ∀ (k : Type) [Field k] (ρ : B ⧸ J →+* k), Function.Surjective ρ →
        Module.finrank k (MvPowerSeries (Fin 2) k ⧸
          Ideal.span (Set.range (((F.map (algebraMap B (B ⧸ J))).map ρ).nthSeries q))) = q ^ 4 := by
      intro k _ ρ hρ
      rw [MvFormalGroup.map_map']
      exact hheight k (ρ.comp (algebraMap B (B ⧸ J))) (hρ.comp Ideal.Quotient.mk_surjective)

    obtain ⟨D₁, θ₁, hθ₁, hlift₁⟩ := ih (B ⧸ J) B₀ hπ₂s hker₂ hn₂ hq₁ f₀ L₀ hc₀ h₀
      (F.map (algebraMap B (B ⧸ J))) θ₀ hθ₀' hinf₀ hheight₁

    have hker₁ : RingHom.ker (algebraMap B (B ⧸ J)) = J := by rw [hπ₁]; exact Ideal.mk_ker
    have hnil₁ : IsNilpotent (RingHom.ker (algebraMap B (B ⧸ J))) :=
      ⟨2, by rw [hker₁, pow_two, Ideal.zero_eq_bot]; exact le_bot_iff.mp ((Ideal.mul_mono_right hJlem).trans hJm.le)⟩
    have hsmall₁ : RingHom.ker (algebraMap B (B ⧸ J)) * maximalIdeal B = ⊥ := by rw [hker₁]; exact hJm
    have hinf₁ := RelativeGroupLaw.exists_isNilpotent_isInfinitesimal_of_isPullback_of_isNilpotent_ker
      q (B ⧸ J) B₀ hπ₂s hker₂ D₁.f D₁.L f₀ L₀ D₁.g D₁.cart D₁.hom hinf₀
    obtain ⟨D, θ, hθ, hlift⟩ :=
      BareDeformation.exists_isFormalCoordinates_liftsCoordinates_of_ker_mul_maximalIdeal_eq_bot
        B (B ⧸ J) Ideal.Quotient.mk_surjective hnil₁ hsmall₁ hq D₁.f D₁.L D₁.comm D₁.bundle F θ₁ hθ₁ hinf₁ hheight

    have hSpec : Spec.map (CommRingCat.ofHom (algebraMap B B₀)) =
        Spec.map (CommRingCat.ofHom (algebraMap (B ⧸ J) B₀)) ≫ Spec.map (CommRingCat.ofHom (algebraMap B (B ⧸ J))) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp']
    have hg : IsPullback (D₁.g ≫ D.g) f₀ D.f (Spec.map (CommRingCat.ofHom (algebraMap B B₀))) := by
      rw [hSpec]; exact D₁.cart.paste_horiz D.cart
    let D' : BareDeformation f₀ L₀ B :=
      { A := D.A, f := D.f, L := D.L, comm := D.comm, bundle := D.bundle, g := D₁.g ≫ D.g, cart := hg,
        hom := by
          intro S t P Q
          rw [← Category.assoc, D₁.hom, D.hom]
          exact coe_mul_eq_of_eq D.L (by rw [hSpec, Category.assoc]) _ _ _ _
            (by simp only [Category.assoc]) (by simp only [Category.assoc]) }
    refine ⟨D', θ, hθ, ?_⟩

    intro B'' _ _ _ _ s hs
    letI algB₁ : Algebra (B ⧸ J) B'' := ((algebraMap B₀ B'').comp (algebraMap (B ⧸ J) B₀)).toAlgebra
    haveI : IsScalarTower (B ⧸ J) B₀ B'' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower B (B ⧸ J) B'' := IsScalarTower.of_algebraMap_eq (fun x => by
      show algebraMap B B'' x = algebraMap B₀ B'' (algebraMap (B ⧸ J) B₀ (algebraMap B (B ⧸ J) x))
      rw [IsScalarTower.algebraMap_apply B B₀ B'' x, ← hcomp']; rfl)
    show (θ₀ B'' s).1 ≫ (D₁.g ≫ D.g) = (θ B'' s).1
    rw [← Category.assoc, hlift₁ B'' s hs, hlift B'' s hs]

end GoodReductionJacobian.P2mBareStArt

open GoodReductionJacobian.P2mBareStArt in
theorem solution
    {q : ℕ} [Fact q.Prime]
    (B B₀ : Type) [CommRing B] [IsLocalRing B] [IsArtinianRing B] [IsAlgClosed (ResidueField B)]
    [CommRing B₀] [Algebra B B₀]
    (hπ : Function.Surjective (algebraMap B B₀)) (hker : IsNilpotent (RingHom.ker (algebraMap B B₀)))
    (hq : IsNilpotent ((q : ℕ) : B))
    {A₀ : Scheme.{0}} (f₀ : A₀ ⟶ Spec (CommRingCat.of B₀)) (L₀ : RelativeGroupLaw B₀ f₀) (hc₀ : L₀.IsCommutative)
    (h₀ : AbelianSchemePropertyBundle B₀ f₀)
    (F : MvFormalGroup 2 B) [F.IsComm]
    (θ₀ : RelativeGroupLaw.FormalCoordinates f₀ 2) (hθ₀ : L₀.IsFormalCoordinates (F.map (algebraMap B B₀)) θ₀)
    (hinf₀ : ∀ (C : Type) [CommRing C] [Algebra B₀ C] (m : ℕ) (P : SchemeHomOver (Scheme.specOver (𝒪 := B₀) C) f₀),
      nsmulPt L₀ (Scheme.specOver (𝒪 := B₀) C) (q ^ m) P = L₀.one (Scheme.specOver (𝒪 := B₀) C) →
        ∃ J : Ideal C, IsNilpotent J ∧ L₀.IsInfinitesimal J P)
    (hheight : ∀ (k : Type) [Field k] (ρ : B →+* k), Function.Surjective ρ →
      Module.finrank k (MvPowerSeries (Fin 2) k ⧸ Ideal.span (Set.range ((F.map ρ).nthSeries q))) = q ^ 4) :
    ∃ (D : BareDeformation f₀ L₀ B) (θ : RelativeGroupLaw.FormalCoordinates D.f 2),
      D.L.IsFormalCoordinates F θ ∧ D.LiftsCoordinates θ₀ θ := by
  obtain ⟨n, hn⟩ := IsArtinianRing.isNilpotent_jacobson_bot (R := B)
  rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, Ideal.zero_eq_bot] at hn
  have hn' : RingHom.ker (algebraMap B B₀) * maximalIdeal B ^ n = ⊥ :=
    le_bot_iff.mp ((Ideal.mul_le_right).trans hn.le)
  exact step n B B₀ hπ hker hn' hq f₀ L₀ hc₀ h₀ F θ₀ hθ₀ hinf₀ hheight

end S_GoodReductionJacobian_BareDeformation_exists_isFormalCoordinates_liftsCoordinates_of_isArtinianRing_of_isAlgClosed
end P2MW
