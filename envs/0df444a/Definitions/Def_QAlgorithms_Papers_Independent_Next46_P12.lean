-- title:
--   Definitions for Canonical idempotents of multiplicity-free families of algebras
-- statement:
--   The objects the formalized statements of *Canonical idempotents of multiplicity-free families of algebras* (arXiv:1606.08900) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `SplitPresentation`: A split Wedderburn presentation, source PDF pp. 2–3, (1.1). Labels enumerate all simple blocks, and no zero-size block is permitted.
--   - `SimpleSpace`: Actual simple left module of a matrix block.
--   - `simpleAction`: Representation on the actual simple block.
--   - `blockElement`: Insert a matrix in one block and transport back through (1.1).
--   - `centralIdempotent`: Primitive central projector: identity on one simple, zero on all others.
--   - `centralSpectrum`: Scalar of a central element on a simple. On a noncentral element this is only an entry, and no scalar-action assertion is inferred.
--   - `simpleCharacter`: Actual irreducible trace character, source pp. 9, 32.
--   - `GeneratesCenter`: Generation of the full center as a unital k-algebra.
--   - `interpolationFactor`: One scalar Lagrange factor in the commutative polynomial ring.
--   - `centralPolynomial`: Central Lagrange polynomial; its product is commutative.
--   - `finiteGeneratorProbability`: Uniform counting fraction, used only with finite-field hypotheses.
--   - `generatorFraction`: Numerical function of q with m fixed, Remark 2.2(b). Its finite-field application always has q ≥ 2.
--   - `leftRegularAction`: Left regular action, Appendix A.
--   - `regularCharacter`: Trace character of the actual left regular module.
--   - `traceMatrix`: Rows b', columns b, with product bb', exactly as in Appendix A (5).
--   - `restrictionHom`: Actual intertwiner space from a lower simple to a restricted upper simple.
--   - `MultiplicityFreeRestriction`: Hom-space dimension is restriction multiplicity over split semisimple algebras.
--   - `Tower`: Definition 1.1: split levels, scalar base, coherent unital embeddings, and multiplicity-free restriction. Maps at distant levels are the coherent composites.
--   - `Branch`: Edges are detected by intertwiners of actual simple modules.
--   - `TowerPath`: A path of n edges has n+1 vertices. A_0 ≅ k forces its unique possible root.
--   - `towerVertex`: Vertex at level i, including root and terminal vertex.
--   - `towerTerminal`: Terminal simple type.
--   - `towerPrefix`: Prefix of length m (m edges).
--   - `TowerPathsTo`: Paths with fixed terminal simple type.
--   - `pathIdempotent`: Definition 1.3: ordered product of embedded central projectors.
--   - `towerGTAlgebra`: Algebra generated by embedded centers. Including level zero also specifies X_0=k.
--   - `gtLine`: Canonical line, constructed as the image of the central product on the actual simple.
--   - `cyclicSpan`: Submodule generated by the canonical line under the lower algebra A_i.
--   - `tailProjector`: Product ε(λ_i)···ε(λ_n), source p. 4.
--   - `IsGTChoice`: Choose an arbitrary nonzero vector from each constructed canonical line.
--   - `gtMatrixUnit`: Matrix units transported from endomorphisms of the chosen GT basis.
--   - `pathScalar`: Coefficient in aε_T=cε_T when a solution exists. Its default outside X_n is not used to infer any eigenvalue assertion; ε_T itself was defined independently.
--   - `embeddedSequence`: Embed the finite positive-level sequence J_1,...,J_n into A_n.
--   - `contentVector`: Content vector at final level n; Fin coordinate zero means J_1.
--   - `contentWeights`: Set of distinct weights at coordinate i over paths at final level n.
--   - `multivariateInterpolant`: Explicit formula (3.4), using distinct weights, not repeated paths.
--   - `initialSequence`: Initial finite sequence of an infinite positive-level sequence.
--   - `towerPartialSum`: Partial sum after embedding each term into A_n.
--   - `IsAdditivelyCentral`: Additive centrality includes membership J_k∈X_k and imposes no separation.
--   - `IsSeparating`: Separation at every level, with no additive centrality hypothesis.
--   - `IsJMSequence`: Definition 3.1: separating and additively central.
--   - `lastContent`: Last eigenvalue on a path of positive length.
--   - `siblingPolynomial`: Definition 3.7: only paths with the same full prefix compete.
--   - `edgeContent`: Edge content from the difference of actual central partial-sum scalars.
--   - `edgePolynomial`: Only OTHER OUTGOING edges of the fixed predecessor occur in this polynomial.
--   - `PrimitiveIdempotent`: Primitive in the full algebra, not only in a commutative subalgebra.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, https://arxiv.org/abs/1606.08900v5

import Mathlib

/-! Statements from Doty–Lauve–Seelinger, arXiv:1606.08900v5.
Central projectors are constructed from simple blocks, independently of JM eigenvalues.
Application-specific constructions deferred in HARD.md are not assumed as hypotheses. -/

noncomputable section

open scoped BigOperators Classical
open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

/-- A split Wedderburn presentation, source PDF pp. 2–3, (1.1).
Labels enumerate all simple blocks, and no zero-size block is permitted. -/
structure SplitPresentation (k : Type u) (A : Type v)
    [Field k] [Ring A] [Algebra k A] where
  Label : Type v
  labels : Fintype Label
  size : Label → ℕ
  positive : ∀ i, 0 < size i
  equiv : A ≃ₐ[k] ((i : Label) → Matrix (Fin (size i)) (Fin (size i)) k)

attribute [instance] SplitPresentation.labels

variable {k : Type u} [Field k]
variable {A : Type v} [Ring A] [Algebra k A]

/-- Actual simple left module of a matrix block. -/
abbrev SimpleSpace (D : SplitPresentation k A) (i : D.Label) := Fin (D.size i) → k

/-- Representation on the actual simple block. -/
def simpleAction (D : SplitPresentation k A) (i : D.Label) (a : A) :
    SimpleSpace D i →ₗ[k] SimpleSpace D i := Matrix.toLin' (D.equiv a i)

/-- Insert a matrix in one block and transport back through (1.1). -/
def blockElement (D : SplitPresentation k A) (i : D.Label)
    (M : Matrix (Fin (D.size i)) (Fin (D.size i)) k) : A :=
  D.equiv.symm (Pi.single i M)

/-- Primitive central projector: identity on one simple, zero on all others. -/
def centralIdempotent (D : SplitPresentation k A) (i : D.Label) : A := blockElement D i 1

/-- Scalar of a central element on a simple. On a noncentral element this is only
an entry, and no scalar-action assertion is inferred. -/
def centralSpectrum (D : SplitPresentation k A) (a : A) (i : D.Label) : k :=
  D.equiv a i ⟨0, D.positive i⟩ ⟨0, D.positive i⟩

/-- Actual irreducible trace character, source pp. 9, 32. -/
def simpleCharacter (D : SplitPresentation k A) (i : D.Label) (a : A) : k :=
  Matrix.trace (D.equiv a i)

/-- Generation of the full center as a unital k-algebra. -/
def GeneratesCenter (z : A) : Prop :=
  Algebra.adjoin k ({z} : Set A) = Subalgebra.center k A

/-- One scalar Lagrange factor in the commutative polynomial ring. -/
def interpolationFactor (a b : k) : Polynomial k :=
  Polynomial.C ((a - b)⁻¹) * (Polynomial.X - Polynomial.C b)

/-- Central Lagrange polynomial; its product is commutative. -/
def centralPolynomial (D : SplitPresentation k A) (z : A) (i : D.Label) : Polynomial k :=
  ∏ j ∈ Finset.univ.erase i,
    interpolationFactor (centralSpectrum D z i) (centralSpectrum D z j)

/-- Uniform counting fraction, used only with finite-field hypotheses. -/
def finiteGeneratorProbability (D : SplitPresentation k A) : ℝ :=
  (Nat.card {z : Subalgebra.center k A // GeneratesCenter (k := k) (z : A)} : ℝ) /
    (Nat.card (Subalgebra.center k A) : ℝ)

/-- Numerical function of q with m fixed, Remark 2.2(b).
Its finite-field application always has q ≥ 2. -/
def generatorFraction (m q : ℕ) : ℝ :=
  ∏ i ∈ Finset.range m, (1 - (i : ℝ) / (q : ℝ))

/-- Left regular action, Appendix A. -/
def leftRegularAction (a : A) : A →ₗ[k] A where
  toFun x := a * x
  map_add' x y := mul_add a x y
  map_smul' c x := by simp only [RingHom.id_apply, Algebra.mul_smul_comm]

/-- Trace character of the actual left regular module. -/
def regularCharacter (a : A) : k := LinearMap.trace k A (leftRegularAction (k := k) a)

/-- Rows b', columns b, with product bb', exactly as in Appendix A (5). -/
def traceMatrix {I : Type w} [Fintype I] (b : Module.Basis I k A) : Matrix I I k :=
  fun i j => regularCharacter (k := k) (b j * b i)

/-- Actual intertwiner space from a lower simple to a restricted upper simple. -/
def restrictionHom {B : Type w} [Ring B] [Algebra k B]
    (DB : SplitPresentation k B) (DA : SplitPresentation k A) (inc : B →ₐ[k] A)
    (mu : DB.Label) (lam : DA.Label) :
    Submodule k (SimpleSpace DB mu →ₗ[k] SimpleSpace DA lam) where
  carrier := {f | ∀ b v, f (simpleAction DB mu b v) = simpleAction DA lam (inc b) (f v)}
  zero_mem' := by intro b v; simp
  add_mem' := by
    intro f g hf hg b v
    simp only [LinearMap.add_apply, map_add, hf b v, hg b v]
  smul_mem' := by
    intro c f hf b v
    simp only [LinearMap.smul_apply, map_smul, hf b v]

/-- Hom-space dimension is restriction multiplicity over split semisimple algebras. -/
def MultiplicityFreeRestriction {B : Type w} [Ring B] [Algebra k B]
    (DB : SplitPresentation k B) (DA : SplitPresentation k A) (inc : B →ₐ[k] A) : Prop :=
  ∀ mu lam, Module.finrank k (restrictionHom DB DA inc mu lam) ≤ 1

/-- Definition 1.1: split levels, scalar base, coherent unital embeddings, and
multiplicity-free restriction. Maps at distant levels are the coherent composites. -/
structure Tower (k : Type u) (A : ℕ → Type v) [Field k]
    [∀ n, Ring (A n)] [∀ n, Algebra k (A n)] where
  split : ∀ n, SplitPresentation k (A n)
  base : A 0 ≃ₐ[k] k
  inc : ∀ i j, i ≤ j → A i →ₐ[k] A j
  inc_injective : ∀ i j h, Function.Injective (inc i j h)
  inc_self : ∀ i h, inc i i h = AlgHom.id k (A i)
  inc_comp : ∀ i j l hij hjl, (inc j l hjl).comp (inc i j hij) = inc i l (hij.trans hjl)
  branching : ∀ n, MultiplicityFreeRestriction (split n) (split (n + 1))
    (inc n (n + 1) (Nat.le_succ n))

section TowerDefinitions

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]
variable (D : Tower k AA)

/-- Edges are detected by intertwiners of actual simple modules. -/
def Branch (n : ℕ) (mu : (D.split n).Label) (lam : (D.split (n + 1)).Label) : Prop :=
  0 < Module.finrank k
    (restrictionHom (D.split n) (D.split (n + 1)) (D.inc n (n + 1) (Nat.le_succ n)) mu lam)

/-- A path of n edges has n+1 vertices. A_0 ≅ k forces its unique possible root. -/
def TowerPath (n : ℕ) :=
  {t : (i : Fin (n + 1)) → (D.split i.val).Label //
    ∀ i : Fin n, Branch D i.val (t ⟨i.val, by omega⟩) (t ⟨i.val + 1, by omega⟩)}

instance pathFintype (n : ℕ) : Fintype (TowerPath D n) := by
  unfold TowerPath
  infer_instance

/-- Vertex at level i, including root and terminal vertex. -/
def towerVertex {n : ℕ} (t : TowerPath D n) (i : ℕ) (hi : i ≤ n) : (D.split i).Label :=
  t.val ⟨i, by omega⟩

/-- Terminal simple type. -/
def towerTerminal {n : ℕ} (t : TowerPath D n) : (D.split n).Label := towerVertex D t n le_rfl

/-- Prefix of length m (m edges). -/
def towerPrefix {n : ℕ} (t : TowerPath D n) (m : ℕ) (hm : m ≤ n) : TowerPath D m :=
  ⟨fun i => t.val ⟨i.val, by omega⟩, fun i => t.property ⟨i.val, by omega⟩⟩

/-- Paths with fixed terminal simple type. -/
def TowerPathsTo (n : ℕ) (lam : (D.split n).Label) := {t : TowerPath D n // towerTerminal D t = lam}

instance pathsToFintype (n : ℕ) (lam : (D.split n).Label) : Fintype (TowerPathsTo D n lam) := by
  unfold TowerPathsTo
  infer_instance

/-- Definition 1.3: ordered product of embedded central projectors. -/
def pathIdempotent {n : ℕ} (t : TowerPath D n) : AA n :=
  (List.ofFn fun i : Fin n => D.inc (i.val + 1) n (by omega)
    (centralIdempotent (D.split (i.val + 1)) (towerVertex D t (i.val + 1) (by omega)))).prod

/-- Algebra generated by embedded centers. Including level zero also specifies X_0=k. -/
def towerGTAlgebra (n : ℕ) : Subalgebra k (AA n) :=
  Algebra.adjoin k {a | ∃ i, ∃ hi : i ≤ n, ∃ z : Subalgebra.center k (AA i),
    D.inc i n hi z = a}

/-- Canonical line, constructed as the image of the central product on the actual simple. -/
def gtLine {n : ℕ} (lam : (D.split n).Label) (t : TowerPath D n) :
    Submodule k (SimpleSpace (D.split n) lam) :=
  LinearMap.range (simpleAction (D.split n) lam (pathIdempotent D t))

/-- Submodule generated by the canonical line under the lower algebra A_i. -/
def cyclicSpan {n : ℕ} (lam : (D.split n).Label) (t : TowerPath D n) (i : ℕ) (hi : i ≤ n) :
    Submodule k (SimpleSpace (D.split n) lam) :=
  Submodule.span k {x | ∃ a : AA i, ∃ v : SimpleSpace (D.split n) lam,
    v ∈ gtLine D lam t ∧ x = simpleAction (D.split n) lam (D.inc i n hi a) v}

/-- Product ε(λ_i)···ε(λ_n), source p. 4. -/
def tailProjector {n : ℕ} (t : TowerPath D n) (i : ℕ) (hi : i ≤ n) : AA n :=
  (List.ofFn fun j : Fin (n + 1 - i) => D.inc (i + j.val) n (by omega)
    (centralIdempotent (D.split (i + j.val)) (towerVertex D t (i + j.val) (by omega)))).prod

/-- Choose an arbitrary nonzero vector from each constructed canonical line. -/
def IsGTChoice {n : ℕ} (lam : (D.split n).Label)
    (v : TowerPathsTo D n lam → SimpleSpace (D.split n) lam) : Prop :=
  ∀ t, v t ∈ gtLine D lam t.val ∧ v t ≠ 0

/-- Matrix units transported from endomorphisms of the chosen GT basis. -/
def gtMatrixUnit {n : ℕ} (lam : (D.split n).Label)
    (b : Module.Basis (TowerPathsTo D n lam) k (SimpleSpace (D.split n) lam))
    (s t : TowerPathsTo D n lam) : AA n :=
  blockElement (D.split n) lam (LinearMap.toMatrix' ((b.coord t).smulRight (b s)))

/-- Coefficient in aε_T=cε_T when a solution exists. Its default outside X_n is
not used to infer any eigenvalue assertion; ε_T itself was defined independently. -/
def pathScalar {n : ℕ} (t : TowerPath D n) (a : AA n) : k :=
  if h : ∃ c : k, a * pathIdempotent D t = c • pathIdempotent D t then Classical.choose h else 0

/-- Embed the finite positive-level sequence J_1,...,J_n into A_n. -/
def embeddedSequence (n : ℕ) (J : (i : Fin n) → AA (i.val + 1)) (i : Fin n) : AA n :=
  D.inc (i.val + 1) n (by omega) (J i)

/-- Content vector at final level n; Fin coordinate zero means J_1. -/
def contentVector {n : ℕ} (J : (i : Fin n) → AA (i.val + 1)) (t : TowerPath D n) : Fin n → k :=
  fun i => pathScalar D t (embeddedSequence D n J i)

/-- Set of distinct weights at coordinate i over paths at final level n. -/
def contentWeights {n : ℕ} (J : (i : Fin n) → AA (i.val + 1)) (i : Fin n) : Finset k :=
  Finset.univ.image (fun t : TowerPath D n => contentVector D J t i)

/-- Explicit formula (3.4), using distinct weights, not repeated paths. -/
def multivariateInterpolant {n : ℕ} (J : (i : Fin n) → AA (i.val + 1)) (t : TowerPath D n) : AA n :=
  (List.ofFn fun i : Fin n => Polynomial.aeval (embeddedSequence D n J i)
    (∏ c ∈ (contentWeights D J i).erase (contentVector D J t i),
      interpolationFactor (contentVector D J t i) c)).prod

/-- Initial finite sequence of an infinite positive-level sequence. -/
def initialSequence (J : (i : ℕ) → AA (i + 1)) (n : ℕ) :
    (i : Fin n) → AA (i.val + 1) := fun i => J i.val

/-- Partial sum after embedding each term into A_n. -/
def towerPartialSum (J : (i : ℕ) → AA (i + 1)) (n : ℕ) : AA n :=
  (List.ofFn fun i : Fin n => embeddedSequence D n (initialSequence J n) i).sum

/-- Additive centrality includes membership J_k∈X_k and imposes no separation. -/
def IsAdditivelyCentral (J : (i : ℕ) → AA (i + 1)) : Prop :=
  (∀ i, J i ∈ towerGTAlgebra D (i + 1)) ∧ ∀ n, towerPartialSum D J n ∈ Subalgebra.center k (AA n)

/-- Separation at every level, with no additive centrality hypothesis. -/
def IsSeparating (J : (i : ℕ) → AA (i + 1)) : Prop :=
  (∀ i, J i ∈ towerGTAlgebra D (i + 1)) ∧ ∀ n,
    Algebra.adjoin k (Set.range (embeddedSequence D n (initialSequence J n))) = towerGTAlgebra D n

/-- Definition 3.1: separating and additively central. -/
def IsJMSequence (J : (i : ℕ) → AA (i + 1)) : Prop := IsSeparating D J ∧ IsAdditivelyCentral D J

/-- Last eigenvalue on a path of positive length. -/
def lastContent (J : (i : ℕ) → AA (i + 1)) {n : ℕ} (t : TowerPath D (n + 1)) : k :=
  contentVector D (initialSequence J (n + 1)) t ⟨n, by omega⟩

/-- Definition 3.7: only paths with the same full prefix compete. -/
def siblingPolynomial (J : (i : ℕ) → AA (i + 1)) {n : ℕ} (t : TowerPath D (n + 1)) : Polynomial k :=
  ∏ s ∈ Finset.univ.filter (fun s : TowerPath D (n + 1) =>
    towerPrefix D s n (by omega) = towerPrefix D t n (by omega) ∧ s ≠ t),
    interpolationFactor (lastContent D J t) (lastContent D J s)

/-- Edge content from the difference of actual central partial-sum scalars. -/
def edgeContent (J : (i : ℕ) → AA (i + 1)) (n : ℕ)
    (mu : (D.split n).Label) (lam : (D.split (n + 1)).Label) : k :=
  centralSpectrum (D.split (n + 1)) (towerPartialSum D J (n + 1)) lam -
    centralSpectrum (D.split n) (towerPartialSum D J n) mu

/-- Only OTHER OUTGOING edges of the fixed predecessor occur in this polynomial. -/
def edgePolynomial (J : (i : ℕ) → AA (i + 1)) (n : ℕ)
    (mu : (D.split n).Label) (lam : (D.split (n + 1)).Label) : Polynomial k :=
  ∏ nu ∈ Finset.univ.filter (fun nu => Branch D n mu nu ∧ nu ≠ lam),
    interpolationFactor (edgeContent D J n mu lam) (edgeContent D J n mu nu)

/-- Empty-path sanity check, independent of the root encoding. -/
example (t : TowerPath D 0) : pathIdempotent D t = 1 := by simp [pathIdempotent]

/-- Empty partial-sum sanity check. -/
example (J : (i : ℕ) → AA (i + 1)) : towerPartialSum D J 0 = 0 := by simp [towerPartialSum]

end TowerDefinitions

/-- Primitive in the full algebra, not only in a commutative subalgebra. -/
def PrimitiveIdempotent (e : A) : Prop :=
  e * e = e ∧ e ≠ 0 ∧ ∀ f g : A, f * f = f → g * g = g → f * g = 0 → g * f = 0 →
    e = f + g → f = 0 ∨ g = 0

/-- Zero block insertion sanity check. -/
example (D : SplitPresentation k A) (i : D.Label) : blockElement D i 0 = 0 := by
  simp [blockElement]

/-- Character normalization sanity check at zero. -/
example (D : SplitPresentation k A) (i : D.Label) : simpleCharacter D i 0 = 0 := by
  simp [simpleCharacter]

/-- Empty-label numerical sanity check. -/
example (q : ℕ) : generatorFraction 0 q = 1 := by simp [generatorFraction]

/-- The excluded value is a root of its Lagrange factor. -/
example (a b : k) : (interpolationFactor a b).eval b = 0 := by
  simp [interpolationFactor]

/-- The target value has Lagrange factor one when the scalar gap is nonzero. -/
example (a b : k) (hab : a ≠ b) : (interpolationFactor a b).eval a = 1 := by
  simp [interpolationFactor, sub_ne_zero.mpr hab]

/-- Prefixing to the same level preserves its terminal type. -/
example {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]
    (D : Tower k AA) (n : ℕ) (t : TowerPath D n) :
    towerTerminal D (towerPrefix D t n le_rfl) = towerTerminal D t := by rfl

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]
variable [∀ n, FiniteDimensional k (AA n)]

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12


