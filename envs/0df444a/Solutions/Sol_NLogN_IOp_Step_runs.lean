    · simp [nbits_zero]
    · rw [nbits_pos hx.ne', List.drop_succ_cons, ih, pow_succ, Nat.div_div_eq_div_mul,
        mul_comm 2]

theorem wval_take_drop (l : List Bool) (m : ℕ) :
    wval l = wval (l.take m) + 2 ^ m * wval (l.drop m) := by
  conv_lhs => rw [← List.take_append_drop m l]
  rw [wval_append]
  by_cases h : m ≤ l.length
  · rw [List.length_take_of_le h]
  · rw [List.drop_eq_nil_of_le (by omega)]; simp [wval]

theorem wval_take_lt (l : List Bool) (m : ℕ) : wval (l.take m) < 2 ^ m :=
  lt_of_lt_of_le (wval_lt_pow _) (Nat.pow_le_pow_right (by norm_num) (List.length_take_le _ _))

theorem wval_take_eq (l : List Bool) (m : ℕ) : wval (l.take m) = wval l % 2 ^ m := by
  rw [wval_take_drop l m, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (wval_take_lt l m)]

theorem trimL_take_nbits (x m : ℕ) : trimL ((nbits x).take m) = nbits (x % 2 ^ m) := by
  rw [← nbits_wval, wval_take_eq, wval_nbits]

theorem zbits_sg (z : ℤ) (n : ℕ) : zbits (sg z n) = nbits n := by
  unfold sg zbits; split_ifs <;> simp

theorem hdOf_sg (z : ℤ) (n : ℕ) : hdOf (sg z n) = if n = 0 then hdPos else hdOf z := by
  unfold sg hdOf; split_ifs <;> first | rfl | omega

theorem natAbs_mul_two_pow (z : ℤ) (m : ℕ) : (z * 2 ^ m).natAbs = z.natAbs * 2 ^ m := by
  rw [Int.natAbs_mul]; simp

theorem zbits_mul_two_pow {z : ℤ} (hz : z ≠ 0) (m : ℕ) :
    zbits (z * 2 ^ m) = List.replicate m false ++ zbits z := by
  rw [zbits, natAbs_mul_two_pow, nbits_mul_two_pow (by omega)]; rfl

theorem hdOf_mul_two_pow (z : ℤ) (m : ℕ) : hdOf (z * 2 ^ m) = hdOf z := by
  unfold hdOf
  have : (0 : ℤ) < 2 ^ m := by positivity
  by_cases hz : z < 0
  · rw [if_pos hz, if_pos (by nlinarith)]
  · rw [if_neg hz, if_neg (by nlinarith)]

theorem codeBit_false : codeBit false = 0 := rfl
theorem codeBit_true : codeBit true = 1 := rfl

theorem filterMap_g0 (m : ℕ) : (List.replicate m (0 : Sym)).filterMap g0 = List.replicate m 0 := by
  induction m with
  | zero => rfl
  | succ m ih => simp [List.replicate_succ, List.filterMap_cons, g0, ih]

theorem codeBit_replicate (m : ℕ) : (List.replicate m false).map codeBit = List.replicate m 0 := by
  rw [List.map_replicate]; rfl

theorem ruler_enc (m : ℕ) (R : List Sym) :
    (Item.int ((2 : ℤ) ^ m)).enc ++ R = hdPos :: (List.replicate m 0 ++ 1 :: R) := by
  have : ((2 : ℤ) ^ m) = ((2 ^ m : ℕ) : ℤ) := by push_cast; rfl
  rw [this]
  simp only [Item.enc, zbits_two_pow, List.map_append, codeBit_replicate, List.map_cons,
    List.map_nil, List.cons_append, List.append_assoc, List.singleton_append]
  have : hdOf ((2 ^ m : ℕ) : ℤ) = hdPos := by unfold hdOf; rw [if_neg (not_lt.mpr (by positivity))]
  rw [this]; rfl

end NLogN

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

theorem g0_isSome_rep (m : ℕ) : ∀ a ∈ List.replicate m (0 : Sym), (g0 a).isSome := by
  intro a ha; rw [List.eq_of_mem_replicate ha]; rfl

theorem g0_one (R : List Sym) : ((1 : Sym) :: R).head?.bind g0 = none := rfl

theorem Runs.shlR {q i j t1 t2 : Fin S} (hqi : q ≠ i) (hqj : q ≠ j) (hqt1 : q ≠ t1)
    (hqt2 : q ≠ t2) (hij : i ≠ j) (hit1 : i ≠ t1) (hit2 : i ≠ t2) (hjt1 : j ≠ t1) (hjt2 : j ≠ t2)
    (ht12 : t1 ≠ t2) (σ : St S) (z : ℤ) (m : ℕ) (Ri Rj : List Sym)
    (hi : σ.stk i = (Item.int z).enc ++ Ri) (hj : σ.stk j = (Item.int ((2 : ℤ) ^ m)).enc ++ Rj)
    (hRi : bitOf Ri.head? = none) (ht1 : bitOf (σ.stk t1).head? = none)
    (ht2 : bitOf (σ.stk t2).head? = none) :
    NLogN.Runs I prog (NLogN.shlR q i j t1 t2 : Stmt S P) σ
      (σ.set i ((Item.int (z * 2 ^ m)).enc ++ Ri)) (shlCost m) := by
  unfold NLogN.shlR
  have htop : σ.top i = some (hdOf z) := by simp [St.top_eq, hi, Item.enc]
  refine (Runs.caseTop (c := shlCost m - 17) ?_).mono (by simp only [shlCost]; omega)
  rw [htop]
  simp only [hdOf_sel]
  set B := zbits z
  have h1 := Runs.pop (I := I) (prog := prog) σ i
  have hp : (σ.pop i).stk i = B.map codeBit ++ Ri := by simp [hi, Item.enc, B]
  by_cases hz : z = 0
  · have hB : B = [] := by simp [B, hz, zbits, nbits_zero]
    have hb : isBitT ((σ.pop i).top i) = false := by
      rw [St.top_eq, hp, top_bits_isBit hRi, hB]; rfl
    refine Runs.mono' (Runs.seq h1 (Runs.iteF hb (Runs.push _ i (hdOf z)))) ?_
      (by simp only [shlCost]; omega)
    rw [St.push_eq_set, St.pop_eq_set, St.set_set_same]
    congr 1
    simp [hi, Item.enc, hz, B, hB, zbits, nbits_zero]
  have hb : isBitT ((σ.pop i).top i) = true := by
    rw [St.top_eq, hp, top_bits_isBit hRi]; simp [B, zbits_eq_nil, hz]
  set σ1 := σ.pop i
  have h2 := Runs.pop (I := I) (prog := prog) σ1 j
  set σ2 := σ1.pop j
  have h3 := Runs.move (I := I) (prog := prog) (g := g0) hqj hqt2 hjt2 σ2
    (List.replicate m 0) (1 :: Rj)
    (by simp [σ2, σ1, Ne.symm hij, hj, ruler_enc]) (g0_isSome_rep m) (g0_one Rj)
  rw [filterMap_g0, List.reverse_replicate, List.length_replicate] at h3
  set σ3 := (σ2.set j (1 :: Rj)).set t2 (List.replicate m 0 ++ σ2.stk t2)
  have h4 := Runs.zip (I := I) (prog := prog) (q := q) (a := t1) (b := t2) (d := i) (e := j)
    hqt1 hqt2 hqi hqj ht12 (Ne.symm hit1) (Ne.symm hjt1) (Ne.symm hit2) (Ne.symm hjt2) hij
    true fCopy finNone (σ.stk t1) (σ.stk t2) ht1 ht2 0 (fun _ => le_rfl) σ3 []
    (List.replicate m false) false
    (by simp [σ3, σ2, σ1, Ne.symm hit1, Ne.symm hjt1, ht12])
    (by simp [σ3, σ2, σ1, codeBit_replicate, Ne.symm hit2, Ne.symm hjt2, codeBit_false])
  rw [zipL_copy false [] _ rfl] at h4
  set σ4 := (((σ3.set t1 (σ.stk t1)).set t2 (σ.stk t2)).set i
    (pushAll (finNone (zipL fCopy false [] (List.replicate m false)).2)
      (((List.replicate m false).map codeBit).reverse ++ σ3.stk i))).set j
    (if true = true then ((List.replicate m false).map codeBit).reverse ++ σ3.stk j
      else σ3.stk j)
  have h5 := Runs.push (I := I) (prog := prog) σ4 j hdPos
  have h6 := Runs.push (I := I) (prog := prog) (σ4.push j hdPos) i (hdOf z)
  refine Runs.mono' (Runs.seq h1 (Runs.iteT hb (Runs.seq h2 (Runs.seq h3 (Runs.seq h4
    (Runs.seq h5 h6)))))) ?_ ?_
  · clear h1 h2 h3 h4 h5 h6
    rw [St.ext_iff']; refine ⟨fun x => ?_, rfl, rfl⟩
    by_cases hxi : x = i
    · subst hxi
      simp [σ4, σ3, σ2, σ1, Item.enc, hij, hit1, hit2, hi, finNone, pushAll, codeBit_replicate,
        zbits_mul_two_pow hz, hdOf_mul_two_pow, B, codeBit_false]
    by_cases hxj : x = j
    · subst hxj
      simp [σ4, σ3, σ2, σ1, Ne.symm hij, hjt1, hjt2, hj, ruler_enc, codeBit_replicate, codeBit_false]
    simp only [σ4, σ3, σ2, σ1, St.push_stk, St.pop_stk, St.set_stk, hxj, hxi, if_false]
    split_ifs <;> simp_all
  · simp only [shlCost, List.length_nil, max_eq_right (Nat.zero_le _), List.length_replicate]
    omega

theorem enc_sg (z : ℤ) (n : ℕ) (R : List Sym) :
    (Item.int (sg z n)).enc ++ R = (if n = 0 then hdPos else hdOf z) :: ((nbits n).map codeBit ++ R) := by
  simp [Item.enc, zbits_sg, hdOf_sg]

theorem isBitT_nbits (n : ℕ) (R : List Sym) (hR : bitOf R.head? = none) :
    isBitT (((nbits n).map codeBit ++ R).head?) = decide (n ≠ 0) := by
  rw [top_bits_isBit hR]
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [nbits_zero]
  · rw [nbits_pos hn.ne']; simp [hn.ne']

theorem Runs.splitR {q i j k t1 t2 : Fin S} (hqi : q ≠ i) (hqj : q ≠ j) (hqk : q ≠ k)
    (hqt1 : q ≠ t1) (hqt2 : q ≠ t2) (hij : i ≠ j) (hik : i ≠ k) (hit1 : i ≠ t1) (hit2 : i ≠ t2)
    (hjk : j ≠ k) (hjt1 : j ≠ t1) (hjt2 : j ≠ t2) (hkt1 : k ≠ t1) (hkt2 : k ≠ t2)
    (ht12 : t1 ≠ t2) (σ : St S) (z : ℤ) (m : ℕ) (Ri Rj : List Sym)
    (hi : σ.stk i = (Item.int z).enc ++ Ri) (hj : σ.stk j = (Item.int ((2 : ℤ) ^ m)).enc ++ Rj)
    (hRi : bitOf Ri.head? = none) (hk : bitOf (σ.stk k).head? = none)
    (ht1 : bitOf (σ.stk t1).head? = none) (ht2 : bitOf (σ.stk t2).head? = none) :
    NLogN.Runs I prog (NLogN.splitR q i j k t1 t2 : Stmt S P) σ
      ((σ.set i ((Item.int (sg z (z.natAbs / 2 ^ m))).enc ++ Ri)).set k
        ((Item.int (sg z (z.natAbs % 2 ^ m))).enc ++ σ.stk k)) (splitCost m + 17) := by
  unfold NLogN.splitR
  have htop : σ.top i = some (hdOf z) := by simp [St.top_eq, hi, Item.enc]
  refine Runs.caseTop ?_
  rw [htop]
  simp only [hdOf_sel]
  set B := zbits z with hBdef
  have h1 := Runs.pop (I := I) (prog := prog) σ i
  set σ1 := σ.pop i
  have h2 := Runs.pop (I := I) (prog := prog) σ1 j
  set σ2 := σ1.pop j
  have h3 := Runs.move (I := I) (prog := prog) (g := g0) hqj hqt2 hjt2 σ2
    (List.replicate m 0) (1 :: Rj)
    (by simp [σ2, σ1, Ne.symm hij, hj, ruler_enc]) (g0_isSome_rep m) (g0_one Rj)
  rw [filterMap_g0, List.reverse_replicate, List.length_replicate] at h3
  set σ3 := (σ2.set j (1 :: Rj)).set t2 (List.replicate m 0 ++ σ2.stk t2)
  have h4 := Runs.take (I := I) (prog := prog) (q := q) (a := i) (b := t2) (d := t1) (e := j)
    hqi hqt2 hqt1 hqj hit2 hit1 hij (Ne.symm ht12) (Ne.symm hjt2) (Ne.symm hjt1) σ3
    B (List.replicate m false) Ri (σ.stk t2)
    (by simp [σ3, σ2, σ1, hit2, hij, hi, Item.enc, B])
    (by simp [σ3, σ2, σ1, codeBit_replicate, Ne.symm hit2, Ne.symm hjt2, codeBit_false]) hRi ht2
  rw [List.length_replicate] at h4
  set σ4 := (((σ3.set i ((B.drop m).map codeBit ++ Ri)).set t2 (σ.stk t2)).set t1
    (((B.take m).map codeBit).reverse ++ σ3.stk t1)).set j
    (((List.replicate m false).map codeBit).reverse ++ σ3.stk j)
  have h5 := Runs.push (I := I) (prog := prog) σ4 j hdPos
  set σ5 := σ4.push j hdPos
  have h6 := Runs.trimTop (I := I) (prog := prog) (t := t1) σ5 (B.take m) (σ.stk t1)
    (by simp [σ5, σ4, σ3, σ2, σ1, Ne.symm hjt1, Ne.symm hit1, ht12]) ht1
  set σ6 := σ5.set t1 (((trimL (B.take m)).map codeBit).reverse ++ σ.stk t1)
  have h7 := Runs.moveBits (I := I) (prog := prog) hqt1 hqk (Ne.symm hkt1) σ6
    (trimL (B.take m)).reverse (σ.stk t1) (by simp [σ6, List.map_reverse]) ht1
  set σ7 := (σ6.set t1 (σ.stk t1)).set k
    (((trimL (B.take m)).reverse.map codeBit).reverse ++ σ6.stk k)
  have hlow : trimL (B.take m) = nbits (z.natAbs % 2 ^ m) := by
    rw [hBdef, zbits, trimL_take_nbits]
  have hhigh : B.drop m = nbits (z.natAbs / 2 ^ m) := by rw [hBdef, zbits, nbits_drop]
  have hk7 : σ7.stk k = (nbits (z.natAbs % 2 ^ m)).map codeBit ++ σ.stk k := by
    simp [σ7, σ6, σ5, σ4, σ3, σ2, σ1, hkt1, hjk, Ne.symm hjk, hkt2, Ne.symm hik, hlow,
      List.map_reverse]
  have hi7 : σ7.stk i = (nbits (z.natAbs / 2 ^ m)).map codeBit ++ Ri := by
    simp [σ7, σ6, σ5, σ4, σ3, σ2, σ1, hit1, hij, hik, hit2, hhigh]
  have hlowc : (if z.natAbs % 2 ^ m = 0 then hdPos else hdOf z) =
      if isBitT (σ7.top k) then hdOf z else hdPos := by
    rw [St.top_eq, hk7, isBitT_nbits _ _ hk]; split_ifs <;> simp_all
  have hhighc : (if z.natAbs / 2 ^ m = 0 then hdPos else hdOf z) =
      if isBitT ((σ7.push k (if z.natAbs % 2 ^ m = 0 then hdPos else hdOf z)).top i)
        then hdOf z else hdPos := by
    rw [St.top_eq, St.push_stk, if_neg hik, hi7, isBitT_nbits _ _ hRi]; split_ifs <;> simp_all
  have h8 : NLogN.Runs I prog (Stmt.ite k isBitT (.push k (hdOf z)) (.push k hdPos) : Stmt S P) σ7
      (σ7.push k (if z.natAbs % 2 ^ m = 0 then hdPos else hdOf z)) 2 := by
    rw [hlowc]
    by_cases hc : isBitT (σ7.top k)
    · rw [if_pos hc]; exact Runs.iteT hc (Runs.push _ _ _)
    · rw [if_neg hc]; exact Runs.iteF (by simpa using hc) (Runs.push _ _ _)
  set σ8 := σ7.push k (if z.natAbs % 2 ^ m = 0 then hdPos else hdOf z)
  have h9 : NLogN.Runs I prog (Stmt.ite i isBitT (.push i (hdOf z)) (.push i hdPos) : Stmt S P) σ8
      (σ8.push i (if z.natAbs / 2 ^ m = 0 then hdPos else hdOf z)) 2 := by
    rw [hhighc]
    by_cases hc : isBitT (σ8.top i)
    · rw [if_pos hc]; exact Runs.iteT hc (Runs.push _ _ _)
    · rw [if_neg hc]; exact Runs.iteF (by simpa using hc) (Runs.push _ _ _)
  refine Runs.mono' (Runs.seq h1 (Runs.seq h2 (Runs.seq h3 (Runs.seq h4 (Runs.seq h5
    (Runs.seq h6 (Runs.seq h7 (Runs.seq h8 h9)))))))) ?_ ?_
  · clear h1 h2 h3 h4 h5 h6 h7 h8 h9 hlowc hhighc
    rw [St.ext_iff']; refine ⟨fun x => ?_, rfl, rfl⟩
    by_cases hxi : x = i
    · subst hxi
      have e8 : σ8.stk x = σ7.stk x := by simp [σ8, hik]
      simp only [St.push_stk, St.set_stk, if_pos rfl, if_neg hik, e8, hi7, enc_sg, if_true]
    by_cases hxk : x = k
    · subst hxk
      simp only [St.push_stk, if_neg (Ne.symm hik), σ8, if_true, hk7, St.set_stk, if_pos rfl, enc_sg]
    by_cases hxj : x = j
    · subst hxj
      simp [σ8, σ7, σ6, σ5, σ4, σ3, σ2, σ1, Ne.symm hij, hjt1, hjt2, hjk, hj, ruler_enc,
        codeBit_replicate, codeBit_false, hik]
    simp only [σ8, σ7, σ6, σ5, σ4, σ3, σ2, σ1, St.push_stk, St.pop_stk, St.set_stk, hxj, hxi, hxk,
      if_false]
    split_ifs <;> simp_all
  · have : (trimL (B.take m)).length ≤ m :=
      (length_trimL_le _).trans (List.length_take_le _ _)
    have : (B.take m).length ≤ m := List.length_take_le _ _
    simp only [splitCost, moveCost, List.length_reverse] at *
    nlinarith

end NLogN

