      ↥(Submodule.torsionBy ℤ J ((p : ℤ) ^ k)) := torsionAction p J k
  letI qA : DistribMulAction (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
