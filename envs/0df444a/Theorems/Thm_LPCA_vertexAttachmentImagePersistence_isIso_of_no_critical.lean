open LPCA

open CategoryTheory

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k]

theorem LPCA.vertexAttachmentImagePersistence_isIso_of_no_critical (rank : V ↪ ℕ)
    (K : Complex V) (f : Finset V → ℝ) (hf : FiltrationMonotone K f)
    (i : V) (b : {v : V // v ≠ i} → ℤ) (q : ℕ) {s t : ℝ} (hst : s ≤ t)
    (h : ∀ r ∈ filtrationCriticalValues K f, ¬ (s < r ∧ r ≤ t)) :
    IsIso ((vertexAttachmentImagePersistence k rank K f hf i b q).map
      (homOfLE (show OrderDual.toDual t ≤ OrderDual.toDual s from hst))) := by sorry
