def tailSt (Q kJ s lam w : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (a9 a10 wd pre post : ℤ) (c : Cs) : Cs :=
  let m := L.length
  let FS := fsOf Q L (lam + w) (s - lam - w) A
  let BS := bsOf Q L (lam + w) (s - lam - w) A
  let FB := JK.flatT FS ++ JK.flatB kJ BS
  let bl : ℤ := (FB.length : ℤ) + m * (2 * (w : ℤ) + 2)
  let c3 := update (update c 14 (matL (Mseq Q (bandS (lam + w) (s - lam - w)) L A m) m)) 41
    (FB ++ c 41)
  let c4 := update (update c3 sOut (hdrL a9 a10 ((2 ^ kJ : ℕ) : ℤ) (JK.nBd BS) w bl m ++ c3 sOut))
    sLn ((bl + 9) :: c3 sLn)
  update (update (update (update (update c4 sX
    (jVs wd pre post ((2 ^ Nat.clog 2 m : ℕ) : ℤ) (Nat.clog 2 m) ++ c4 sX)) sSt []) 30 []) 31 [])
