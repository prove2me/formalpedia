-- Source module: Solutions.KFMBig10
/-!
# KFM Big10: one run of `bigE`

`bigP = setP; mulP; finP`. From the state after the reads (`readSt x y`) it outputs
`bin(2n, val x · val y)`, given the context `BigCtx` of `n = |x| = |y|`.

* **`big_run`**: the run and its cost (setup cost `setC x y` as computed, plus `kMul`, `kFin`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFM

open Finset AModel AModelL12 IntMul KIL KFB KFT KFU RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

variable {E : ℕ} {ix : Ix (7 + E)} {Isym : List Sym} {extM : Fin E → IStmt HS (7 + E)} {n D : ℕ}
  [instS : ∀ i, NeZero (sBD n D i)] [instT : ∀ i, NeZero (tBD n D i)]

/-- **The program `bigE`.** -/
def bigP (ix : Ix (7 + E)) : IStmt HS (7 + E) := .seq setP (.seq (mulP ix) (finP ix))

/-- The setup cost as computed. -/
def setC (x y : List Bool) : ℕ :=
  cStart x.length + 12 * 10 ^ 15 * (bP x.length + 1) ^ 4 +
    parS.cost (setupSt x.length (stA x y)) +
    parQ.cost ((setupSt x.length (stA x y)).upd NLogN.KFM.rS (.int (sCmp x.length : ℤ) ::
      (setupSt x.length (stA x y)).G NLogN.KFM.rS)) + (3 + 2 * shlCost x.length)

end

end NLogN.KFM

end

