-- title:
--   Characteristic polynomial of a torus element on K[P¹(mathbb F_q)]
-- statement:
--   Let $q$ be a prime, let $K$ be a field, and let $\alpha$ be a unit of the field $\mathrm{GaloisField}\,q\,2$ with $q^2$ elements. Write $t_\alpha :=$ `torus q α` for the element of $GL_2(\mathbb Z/q) =$ `GL2 q` obtained by expressing multiplication by $\alpha$ on $\mathbb F_{q^2}$ as a matrix in the fixed $\mathbb Z/q$-basis `quadBasis q` of $\mathbb F_{q^2}$ of size $2$ (the unit group map induced by the algebra homomorphism sending $\alpha$ to the matrix of the $\mathbb Z/q$-linear map $x \mapsto \alpha x$). Let `ind q K` be the representation of $GL_2(\mathbb Z/q)$ on the space of finitely supported $K$-valued functions on the projective line $\mathbb P(\mathbb Z/q, (\mathbb Z/q)^2) =$ `ProjLine q`, where a group element acts by pushing forward supports along its action on $\mathbb P^1$. Let $m$ be the order of the permutation of `ProjLine q` induced by $t_\alpha$, that is the order of the image of $t_\alpha$ under `MulAction.toPermHom`. The assertion is that the characteristic polynomial of the $K$-linear endomorphism `ind q K (torus q α)` equals $(X^{m} - 1)^{(q+1)/m}$, the exponent being natural-number division.
--
--   This is the standard computation of the action of a (possibly split or central) element of the non-split torus $\mathbb F_{q^2}^\times \subset GL_2(\mathbb F_q)$ on the permutation representation $K[\mathbb P^1(\mathbb F_q)]$: the cyclic group generated by the induced permutation acts with all orbits of the same size $m$, whence the eigenvalue pattern $(X^m-1)^{(q+1)/m}$. It feeds the characteristic-polynomial criteria for a representation to be cuspidal of a given type, and through them the vanishing of a twisted intertwining map for the Drinfeld curve.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspidalType_charpoly_ind_torus_eq_X_pow_orderOf_sub_one_pow.lean

import Mathlib
import Definitions.Def_CuspidalType_IsCuspidalOfType

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open Polynomial CuspidalType

theorem CuspidalType.charpoly_ind_torus_eq_X_pow_orderOf_sub_one_pow
    (q : ℕ) [Fact q.Prime] (K : Type*) [Field K] (α : (GaloisField q 2)ˣ) :
    LinearMap.charpoly (ind q K (torus q α)) =
      (X ^ orderOf (MulAction.toPermHom (GL2 q) (ProjLine q) (torus q α)) - 1) ^
        ((q + 1) / orderOf (MulAction.toPermHom (GL2 q) (ProjLine q) (torus q α))) := by sorry
