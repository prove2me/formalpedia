open NLogN
open NLogN.KIL
open IntMul AModel
variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}
theorem solution (scode : AModel.Step n Q → NLogN.IStmt NLogN.HS Pp) (jOf : Fin n → Fin n → Fin Pp)
    (child : Fin n → Fin n → List ℤ → List ℤ) (t : NLogN.IState NLogN.HS) (R : List NLogN.Item) (Bb cS : ℕ)
    (cC : Fin n → Fin n → ℕ) (steps : List (AModel.Step n Q))
    (hS : ∀ i u c, AModel.Step.shift i u c ∈ steps → ∀ ys, NLogN.KIL.DOK sh Bb ys →
      NLogN.IRuns I iprog (scode (.shift i u c)) (t.upd 0 (NLogN.ints ys ++ R))
        (t.upd 0 (NLogN.ints ((AModel.Step.shift i u c).arr Λ 0 ys) ++ R)) cS)
    (hC : ∀ a b, AModel.Step.swap a b ∈ steps → ∀ ys, NLogN.KIL.DOK sh Bb ys →
      NLogN.IRuns I iprog (iprog (jOf a b)) (t.upd 0 (NLogN.ints ys ++ R))
        (t.upd 0 (NLogN.ints (child a b ys) ++ R)) (cC a b) ∧
      child a b ys = (AModel.Step.swap a b).arr Λ 0 ys)
    (xs : List ℤ) (hx : NLogN.KIL.DOK sh Bb xs) :
    NLogN.IRuns I iprog (NLogN.KIL.runCode scode jOf steps) (t.upd 0 (NLogN.ints xs ++ R))
      (t.upd 0 (NLogN.ints (AModel.runArr Λ 0 steps xs) ++ R)) (NLogN.KIL.runCostI cS cC steps) := by
  have H := NLogN.KIL.runCode_spec Λ scode jOf child t R Bb cS cC steps hS
    (fun a b h ys hy => ⟨(hC a b h ys hy).1, by rw [(hC a b h ys hy).2]; exact NLogN.KIL.DOK_arr Λ _ hy⟩)
    xs hx
  rwa [NLogN.KIL.runC_eq_runArr_dok Λ child Bb steps (fun a b h ys hy => (hC a b h ys hy).2) xs hx] at H
end
