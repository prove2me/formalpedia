  refine ⟨Jpt ⊔ J₂, Submodule.FG.sup hJptfg ⟨s.image lift, rfl⟩, ?_⟩

  have factor : ∀ {T : Type} [CommRing T] (φ : S →+* T), Jpt.map φ = ⊥ →
      ∃ φbar : S ⧸ Jpt →+* T, φbar.comp φ₁ = φ := by
