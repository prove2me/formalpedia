variable {A : Type*} [Fintype A] [TopologicalSpace A] [DiscreteTopology A]
  [MeasurableSpace A] [BorelSpace A] {X : ShiftSpace A}
namespace BalanceSpecification
theorem _root_.solution (μ : ProbabilityMeasure X.carrier) (n : ℕ) :
    blockEntropy μ n ≤ Real.log (wordCount (language X) n) := by
  rw [blockEntropy_eq_shannon]
  have h := FiniteEntropy.shannon_le_log_card
    (p := blockDistribution μ n) (fun _ => measureReal_nonneg) (blockDistribution_sum μ n)
  simpa only [Fintype.card_coe, wordCount] using h
end BalanceSpecification
