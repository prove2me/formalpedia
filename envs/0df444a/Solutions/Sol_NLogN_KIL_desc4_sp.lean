  intro i hi
  obtain ⟨L, hL⟩ := h i hi
  exact ⟨ints L ++ s.G i, by simp [hL, ints]⟩

theorem Sp.asgN (s : IState HS) (f : Fin HS → List ℤ) {i : Fin HS} (e : NE) (v : Fin HS → ℕ)
    {a : ℤ} {l : List ℤ} {M B : ℕ} (hi : i.val < 56) (hf : f i = a :: l) (ha : zsz a ≤ B)
