    have hinv0 : ϖ⁻¹ ≠ 0 := inv_ne_zero hϖ0
    have hfeq : (algebraMap (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H) ϖ⁻¹)⁻¹ * hϖ' = h := by
      rw [hhϖ', map_inv₀, inv_inv, ← mul_assoc, mul_inv_cancel₀ ((map_ne_zero _).mpr hϖ0), one_mul]
    have hhb : (algebraMap (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H) ϖ⁻¹)⁻¹ * hϖ' ∈ Rpd.R₁.integers := by
      rw [hfeq]; exact hh₁
    have hresb' : Rpd.R₁.residue ⟨_, hhb⟩ ≠ 0 := (residue_congr Rpd.R₁ hfeq hhb hh₁) ▸ hhr₁
    have hordϖ' : ∀ P : Place (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H), P.ord hϖ' = P.ord h := by
      intro P
      rw [hhϖ', ← map_inv₀, P.ord_mul ((map_ne_zero _).mpr hinv0) hh0,
        AlgebraicCurve.ConstantReduction.ord_algebraMap P hinv0, zero_add]
    have hDh' : ∀ P ∈ (An s).dom, Hs s P = P.ord hϖ' := by
      intro P hP; rw [hHs_apply s P hP, hordϖ']
    obtain ⟨hz₂', hxa, hslope_a⟩ := hatt₂ s
    obtain ⟨hzb, hxb, hslope_b⟩ := hatt₁ s
    obtain ⟨-, hprod⟩ :=
      AlgebraicCurve.Annulus.sum_eq_ord_add_ord_and_prod_valuation_evalAt_zpow_eq_of_regularProlongation
        (An s) (hmod0 s) Rpd.R₂ s.1.2 hz₂' hxa hslope_a Rpd.R₁ s.1.1 hzb hxb hslope_b (hwide s)
        hϖ' hϖ'0 hh₂ hhr₂ ϖ⁻¹ hinv0 hhb hresb' (Hs s) (hHs_supp s) hDh'
    exact ⟨_, hprod⟩
  choose b hb using hkey_h

  have hclear : ∀ s : ↥SS, ∃ (φ : ↥(xHFunctionFieldBar M H)) (c : AlgebraicClosure ℚ), φ ≠ 0 ∧
      (∀ V : Place (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H),
        (∃ t ∈ SS, Psp.reduceFst α hα V = t.1) → ¬ Psp.IsStrictFst α (θ.toAlgHom.comp α) hα hβ δ V →
          ¬ Psp.IsStrictSnd α (θ.toAlgHom.comp α) hα hβ δ V → V.ord φ = (Es s - Hs s) V) ∧
      (∀ V : Place (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H),
        V.ord φ ≠ 0 → ¬ Psp.IsStrictFst α (θ.toAlgHom.comp α) hα hβ δ V →
          ¬ Psp.IsStrictSnd α (θ.toAlgHom.comp α) hα hβ δ V → ∃ t ∈ SS, Psp.reduceFst α hα V = t.1) ∧
      (∃ hc₁ : c • φ ∈ Rpd.R₁.integers, Rpd.R₁.residue ⟨c • φ, hc₁⟩ ≠ 0) ∧
      (∃ hc₂ : c • φ ∈ Rpd.R₂.integers, Rpd.R₂.residue ⟨c • φ, hc₂⟩ ≠ 0) := by
    intro s
    set X : Place (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H) →₀ ℤ := Es s - Hs s with hX
    have hXsupp : ∀ V, X V ≠ 0 → V ∈ (An s).dom := by
      intro V hV
      by_contra hVd
      apply hV
      rw [hX, Finsupp.sub_apply]
      have hE0 : Es s V = 0 := by rw [hEs]; exact Finsupp.filter_apply_neg _ _ hVd
      have hH0 : Hs s V = 0 := by rw [hHs]; exact Finsupp.filter_apply_neg _ _ hVd
      rw [hE0, hH0, sub_zero]

    set S : Finset (Place (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H)) := (Es s).support ∪ (Hs s).support with hSdef
    have hSdom : ∀ V ∈ S, V ∈ (An s).dom := by
      intro V hV
      rcases Finset.mem_union.mp hV with h | h
      · exact hEs_supp s V h
      · exact hHs_supp s V h
    have hXsuppS : X.support ⊆ S := by
      intro V hV
      rw [hX] at hV
      exact Finsupp.support_sub hV
    set q : AlgebraicClosure ℚ := X.prod (fun V m => (-(V.evalAt (An s).param)) ^ m) with hq
    have hvq : A.valuation q = ((Es s).prod fun P m => A.valuation (P.evalAt (An s).param) ^ m) *
        ((Hs s).prod fun P m => A.valuation (P.evalAt (An s).param) ^ m)⁻¹ := by
      rw [hq, valuation_finsupp_prod_zpow]
      have h1 : (X.prod fun P m => A.valuation (-(P.evalAt (An s).param)) ^ m) =
          ∏ V ∈ S, A.valuation (V.evalAt (An s).param) ^ (X V) := by
        rw [Finsupp.prod_of_support_subset X hXsuppS _ (fun V _ => zpow_zero _)]
        refine Finset.prod_congr rfl fun V _ => ?_
        rw [Valuation.map_neg]
      have h2 : ((Es s).prod fun P m => A.valuation (P.evalAt (An s).param) ^ m) =
          ∏ V ∈ S, A.valuation (V.evalAt (An s).param) ^ (Es s V) :=
        Finsupp.prod_of_support_subset _ Finset.subset_union_left _ (fun V _ => zpow_zero _)
      have h3 : ((Hs s).prod fun P m => A.valuation (P.evalAt (An s).param) ^ m) =
          ∏ V ∈ S, A.valuation (V.evalAt (An s).param) ^ (Hs s V) :=
        Finsupp.prod_of_support_subset _ Finset.subset_union_right _ (fun V _ => zpow_zero _)
      rw [h1, h2, h3, ← Finset.prod_inv_distrib, ← Finset.prod_mul_distrib]
      refine Finset.prod_congr rfl fun V hV => ?_
      rw [hX, Finsupp.sub_apply, zpow_sub₀ (hvz0 s V (hSdom V hV)), div_eq_mul_inv]

    have hvq' : A.valuation q = A.valuation ((((An s).modulus : ↥A) : AlgebraicClosure ℚ)) ^ (k s - b s) := by
      rw [hvq, hb s, map_inv₀]
      have hkey := hbalance_key s

      set PE := ((Es s).prod fun P m => A.valuation (P.evalAt (An s).param) ^ m) with hPE
      set vπ := A.valuation ((((An s).modulus : ↥A) : AlgebraicClosure ℚ)) with hvπ
      have hvϖ0 : A.valuation ϖ ≠ 0 := (map_ne_zero _).mpr hϖ0
      have hvπ0' : vπ ≠ 0 := hvπ0 s

      have hPE' : PE = vπ ^ (k s) * (A.valuation ϖ)⁻¹ := by
        have h1 : PE * vπ ^ (-(k s)) * A.valuation ϖ = 1 := hkey
        have h2 : PE = (vπ ^ (-(k s)) * A.valuation ϖ)⁻¹ :=
          eq_inv_of_mul_eq_one_left (by rw [← mul_assoc]; exact h1)
        rw [h2, mul_inv, ← zpow_neg, neg_neg]
      rw [hPE', zpow_sub₀ hvπ0', mul_inv, inv_inv, div_eq_mul_inv,
        show vπ ^ (k s) * (A.valuation ϖ)⁻¹ * (A.valuation ϖ * (vπ ^ (b s))⁻¹) =
          vπ ^ (k s) * (vπ ^ (b s))⁻¹ * ((A.valuation ϖ)⁻¹ * A.valuation ϖ) by ac_rfl,
        inv_mul_cancel₀ hvϖ0, mul_one]

    set d : ℤ := k s - b s with hd
    have hunit : A.valuation (q * ((((An s).modulus : ↥A) : AlgebraicClosure ℚ)) ^ (-d)) = 1 := by
      rw [map_mul, map_zpow₀, hvq', ← zpow_add₀ (hvπ0 s), hd, add_neg_cancel, zpow_zero]
    obtain ⟨huA, hu⟩ := isUnit_of_valuation_eq_one hunit
    have hbal : (((⟨_, huA⟩ : ↥A) : ↥A) : AlgebraicClosure ℚ) * ((((An s).modulus : ↥A) : AlgebraicClosure ℚ)) ^ d =
        X.prod (fun V m => (-(V.evalAt (An s).param)) ^ m) := by
      show q * ((((An s).modulus : ↥A) : AlgebraicClosure ℚ)) ^ (-d) * ((((An s).modulus : ↥A) : AlgebraicClosure ℚ)) ^ d = q
