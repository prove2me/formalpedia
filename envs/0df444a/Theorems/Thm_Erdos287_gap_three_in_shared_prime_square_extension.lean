-- title:
--   Erdős 287 finite extension with a shared prime square
-- statement:
--   Let M be the maximum denominator of a strictly increasing exact unit-fraction representation of one. For M in the given interval, from one beyond the previous continuous endpoint to approximately 1.8307388200 times 10^970, a consecutive gap is at least three.
-- source:
--   Erdős #287, bounded cofactor omissions and Pocklington certificates.

import Mathlib

theorem Erdos287.gap_three_in_shared_prime_square_extension (k : ℕ) (hk : 2 ≤ k) (f : ℕ → ℕ)
    (hf1 : ∀ i, i < k → 1 < f i)
    (hmono : ∀ i j, i < j → j < k → f i < f j)
    (hsum : ∑ i ∈ Finset.range k, (1 : ℚ) / f i = 1)
    (hlo :  < f (k - 1)) (hhi : f (k - 1) ≤ ) :
    ∃ i, i + 1 < k ∧ 3 ≤ f (i + 1) - f i := by sorry
