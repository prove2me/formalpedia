    rw [hl, alphaSq_eq_frame w p a (hP.nf _ hx.1) (hP.nm _ hx.1) (hP.nN _ hx.1)]
  apply frameInv_injective w x
  rw [frameInv_raise hE hx, principalCoord, frameInv_esFrame_mulVec, frameInv_smul,
    frameInv_esFrame_mulVec]
  exact frameZ_principal_of_sq hB hD hH _ _ _ lam hl'

