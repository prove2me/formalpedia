namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

namespace E

def fmE (x y : E) : E := .dv (.add (.mul (.k 2) (.mul x y)) (.r 9)) (.r 10)
def fdE (x y : E) : E := .dv (.add (.mul (.k 2) (.mul x (.r 9))) y) (.mul (.k 2) y)
def mx0E (x : E) : E := .sel x (.k 0) x

/-- `bOf s t l = t l - s ((2 t l + s) / (2 s))`. -/
def bOfE (l : E) : E :=
  .sub (.mul (.r 23) l) (.mul (.r 22) (.dv (.add (.mul (.k 2) (.mul (.r 23) l)) (.r 22))
    (.mul (.k 2) (.r 22))))
/-- `1` if `x < y` else `0`. -/
def ltE (x y : E) : E := .sel (.sub x y) (.k 1) (.k 0)
/-- `1` if `x = y` else `0`. -/
def eqE (x y : E) : E := .sub (.sub (.k 1) (ltE x y)) (ltE y x)

end E

open E

