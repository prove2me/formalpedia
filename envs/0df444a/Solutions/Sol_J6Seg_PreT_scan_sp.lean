/-!
# B-line IL, pre-tables (B5), part 10: the block-length scan

`scan Cs`: with the block start `st` on `1`, sets `2 := 1 + enF s t λ st` (the block length) and
`5 := 1`, by `λ` rounds (counter `Cs`) of `if flag = 0 then (if g(st + n) > 0 then n++ else flag := 1)`,
where `g(j) = (j mod λ)·[b_j - b_{j-1} = t - s]·[j < s]` is positive iff `j` is not a cut
(`gV_spec`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

theorem gV_spec {s t lam : ℕ} (hl : 0 < lam) {j : ℕ} (hj : 1 ≤ j) :
    0 ≤ gV s t lam j ∧ (gV s t lam j = 0 ↔ J6Seg.cutP s t lam j ∨ s ≤ j) := by
  have hm : 0 ≤ (j : ℤ) % (lam : ℤ) := Int.emod_nonneg _ (by exact_mod_cast hl.ne')
  have hm0 : (j : ℤ) % (lam : ℤ) = 0 ↔ j % lam = 0 := by
    rw [← Int.natCast_mod]; exact_mod_cast Iff.rfl
  have ej : (((j - 1 : ℕ) : ℤ)) = (j : ℤ) + -1 := by push_cast [Nat.cast_sub hj]; ring
  have ej1 : (((j - 1 : ℕ) : ℤ)) + 1 = (j : ℤ) := by rw [ej]; ring
  unfold gV
  set D := bOf s t j + -bOf s t ((j : ℤ) + -1) + -((t : ℤ) + -(s : ℤ))
  have hst : J6Seg.stepOK s t (j - 1) ↔ D = 0 := by
    unfold J6Seg.stepOK; rw [ej1, ej]; constructor <;> intro h <;> linarith
  have hz : zI D = 0 ∨ zI D = 1 := by unfold zI; split_ifs <;> simp
  have hz0 : zI D = 0 ↔ D ≠ 0 := by unfold zI; split_ifs <;> simp <;> omega
  constructor
  · have : 0 ≤ zI D := by rcases hz with h | h <;> rw [h] <;> norm_num
    split_ifs <;> positivity
  · unfold J6Seg.cutP
    rw [hst]
    split_ifs with h
    · simp only [mul_one, mul_eq_zero, hm0, hz0]
      constructor
      · rintro (h1 | h1)
        · exact Or.inl (Or.inr (Or.inl h1))
        · exact Or.inl (Or.inr (Or.inr h1))
      · rintro ((h1 | h1 | h1) | h1)
        · omega
        · exact Or.inl h1
        · exact Or.inr h1
        · omega
    · simp only [mul_zero, true_iff]; right; omega

