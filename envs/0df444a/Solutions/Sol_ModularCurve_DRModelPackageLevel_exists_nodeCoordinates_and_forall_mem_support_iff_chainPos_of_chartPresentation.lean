  obtain ⟨z, hz⟩ := AlgebraicGeometry.exists_over_hom_base_closedPoint_eq_of_isClosed_singleton κ
    (𝔓.Mfib κ (toκ.comp ρO)).toBase _ (mem_closedPoints_iff.mp hcl)
