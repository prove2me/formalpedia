section run
variable {P k K G Xb Bc : ℕ} {fs : List (List ℤ)} {bs : List (List ℤ × List ℤ × ℤ × ℤ)}
  {cc : List (List ℤ)}

theorem wOut_length (v : List ℤ) : (wOut P k K fs bs cc v).length = fs.length := by simp [wOut]

theorem wOut_bnd {v : List ℤ} {Bx : ℕ} (hD : PartD P k K G Xb Bc fs bs cc v)
    (hB : 2 * Xb + P + Bc + 2 ≤ Bx) : Bnd Bx (wOut P k K fs bs cc v) := by
  intro a ha
  simp only [wOut, List.mem_map, List.mem_range] at ha
  obtain ⟨r, hr, rfl⟩ := ha
  have hzB : Bnd Xb (bwdS P bs (fA P fs v fs.length) fs.length).1 := by
    have := hD.bwd.bz bs.length le_rfl; rwa [hD.lb] at this
  have hze : Bnd Xb (zext K (bwdS P bs (fA P fs v fs.length) fs.length).1) := by
    simp only [zext]; exact bnd_append (bnd_drop hzB _) (bnd_append hzB (bnd_take hzB _))
  have hrc : r < cc.length := by rw [hD.lc]; exact hr
  have hcB : Bnd Xb (cc.getD r []) := by rw [List.getD_eq_getElem _ _ hrc]; exact hD.bc r hrc
  have hcl : (cc.getD r []).length < 2 ^ Bc := by
    rw [List.getD_eq_getElem _ _ hrc]; have := hD.wc r hrc; have := hD.cnts; omega
  have := dotF_take_zsz P Xb Bc hcB (bnd_drop hze r) hcl (cc.getD r []).length
  rw [List.take_length] at this
  apply zsz_le_of_lt
  have : 2 ^ (2 * Xb + P + Bc + 2) ≤ 2 ^ Bx := Nat.pow_le_pow_right (by norm_num) hB
  simp only [wF]; omega

theorem jB_empty {F0 : Fin HS → List ℤ} (hF0 : ∀ j, j ≠ 0 → j ≠ dTJ → F0 j = []) {j : Fin HS}
