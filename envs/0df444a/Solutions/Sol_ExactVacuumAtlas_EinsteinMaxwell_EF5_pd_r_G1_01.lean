variable (mu beta : ℝ)
theorem solution {x : Pt 5} (hx : x ∈ domU5) :
    pd 1 (christoffel (gEF5 mu beta) (giEF5 mu beta) 1 0 1) x =
    3 * mu / x 1 ^ 4 - 10 * beta / x 1 ^ 6 := by
  have hr := domU5_r hx
  rw [pd_congr_of_eqOn isOpen_domU5 hx (eqOn_G1_01 mu beta), pd]
  have hslice : (fun t : ℝ => -(mu / (Function.update x 1 t) 1 ^ 3 - 2 * beta / (Function.update x 1 t) 1 ^ 5))
    = fun t => -(mu / t ^ 3 - 2 * beta / t ^ 5) := by
    funext t; simp [Function.update_apply]
  rw [hslice]
  have hd3 : HasDerivAt (fun t : ℝ => mu / t ^ 3) (-3 * mu / x 1 ^ 4) (x 1) :=
    ((hasDerivAt_const (x 1) mu).fun_div ((hasDerivAt_id' (x 1)).fun_pow 3) (pow_ne_zero 3 hr)).congr_deriv
      (by field_simp; ring)
  have hd5 : HasDerivAt (fun t : ℝ => 2 * beta / t ^ 5) (-10 * beta / x 1 ^ 6) (x 1) :=
    ((hasDerivAt_const (x 1) (2 * beta)).fun_div ((hasDerivAt_id' (x 1)).fun_pow 5) (pow_ne_zero 5 hr)).congr_deriv
      (by field_simp; ring)
  have hg : HasDerivAt (fun t : ℝ => mu / t ^ 3 - 2 * beta / t ^ 5)
      (-3 * mu / x 1 ^ 4 + 10 * beta / x 1 ^ 6) (x 1) :=
    (hd3.sub hd5).congr_deriv (by ring)
  exact hg.neg.congr_deriv (by ring) |>.deriv
