noncomputable section

theorem encK_f0 (x y : List Bool) :
    encK (readSt x y) (f0S x.length (lg x.length)) =
      (((readSt x y).upd zN [.int (x.length : ℤ)]).upd zB [.int (lg x.length : ℤ)]) := by
  refine IState.ext' (fun j => ?_) rfl rfl
  simp only [encK_G, IState.upd_G, f0S]
  by_cases h24 : j = 24
  · subst h24; simp [ints]; rfl
  by_cases h23 : j = 23
  · subst h23
    simp only [update_apply, if_neg (show (23 : Fin HS) ≠ 24 by decide), if_true]
    simp [ints]
    rw [readSt_G x y 23 (by decide) (by decide) (by decide)]
  · simp only [update_apply, if_neg h24, if_neg h23, ints, List.map_nil, List.nil_append]

set_option maxHeartbeats 4000000 in
theorem setupNeed6_sol_aux (P : Prm) (hP : P.Ok) : SetupNeed6 P := by
  rintro ⟨q, hq⟩ tab
  obtain ⟨hεq, hden⟩ := ε_rat P hP q hq
  set a := q.num.toNat
  set c := q.den
  obtain ⟨n₀, hG⟩ := params6_ok P hP
  obtain ⟨n₁, hW⟩ := winOK_eventually P hP
  obtain ⟨n₂, hE⟩ := ell_big P hP 2
  obtain ⟨n₃, hC⟩ := setCost_le P hP a c
  refine ⟨1, fun _ => setupI a c P.x, ⟨7, by omega⟩, fun n => src6 P n, 10 ^ 9, 0,
    max (max n₀ n₁) (max n₂ (max n₃ 8)), by positivity, fun n hn => ?_⟩
  have G := hG n (by omega)
  have hW' := hW n (by omega)
  have hl2 : 2 ≤ ℓP6 P n := by
    have := hE n (by omega)
    have : 1 ≤ (Nat.log 2 (bP6 n) + 1) ^ 2 := Nat.one_le_pow _ _ (by omega)
    nlinarith
  have hC' := hC n (by omega)
  have hd1 : 1 ≤ dP6 P n := G.d_pos
  refine ⟨src6_ok P n hd1 (by omega) hW', fun Isym x y hx hy => ?_⟩
  have hn8 : 8 ≤ n := by omega
  -- the three pieces
  have r1 := startP_runs (I := Isym) (iprog := IL.kTableP tab (fun _ : Fin 1 => setupI a c P.x))
    x y (by omega)
  rw [← encK_f0, hx] at r1
  have hbn : lg n = bP6 n := rfl
  rw [hbn] at r1
  obtain ⟨g, hS, hOK⟩ := sp_setup P hP n G hW' hl2 a c hden hεq (readSt x y)
  obtain ⟨c2, hc2, r2⟩ := hS.irun (I := Isym) (iprog := IL.kTableP tab (fun _ : Fin 1 => setupI a c P.x))
  have hT1 : (encK (readSt x y) g).G kT1 = .int ((2 : ℤ) ^ n) :: [] := by
    simp only [encK_G, hOK.h20, ints, List.map_nil, List.nil_append]
    simp [readSt, hx, show kT1 ≠ ARGM by decide]
  have r3 := oP_runs (I := Isym) (iprog := IL.kTableP tab (fun _ : Fin 1 => setupI a c P.x))
    (encK (readSt x y) g) n [] hT1
  have hk : IL.kTableP tab (fun _ : Fin 1 => setupI a c P.x) ⟨7, by omega⟩ = setupI a c P.x := by
    simp [IL.kTableP]
  have R := IRuns.call (I := Isym) (iprog := IL.kTableP tab (fun _ : Fin 1 => setupI a c P.x))
    (j := (⟨7, by omega⟩ : Fin (7 + 1))) (by rw [hk]; exact r1.seq (r2.seq r3))
  have h0G : ∀ j : Fin HS, j ≠ ARGM → j ≠ kT1 → j ≠ kT2 → (readSt x y).G j = [] :=
    fun j h1 h2 h3 => readSt_G x y j h1 h2 h3
  refine ⟨_, _, R, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · obtain ⟨⟨L1, e1⟩, ⟨L2, e2⟩, ⟨L3, e3⟩, ⟨L4, e4⟩, ⟨L5, e5⟩, ⟨L6, e6⟩, ⟨L7, e7⟩, ⟨L8, e8⟩,
      ⟨L9, e9⟩, ⟨L10, e10⟩, ⟨L11, e11⟩, ⟨L12, e12⟩, ⟨L13, e13⟩, ⟨L14, e14⟩, ⟨L15, e15⟩,
      ⟨L16, e16⟩, ⟨L17, e17⟩, -, -, -, -, -⟩ := hOK
    exact
      { hS := ⟨_, by simp [e1, ints]; rfl⟩
        hT := ⟨_, by simp [e2, ints]; rfl⟩
        hT2 := ⟨_, by simp [e3, ints]; rfl⟩
        hM := ⟨_, by simp [e4, ints]; rfl⟩
        hP2 := ⟨_, by simp [e5, ints]; rfl⟩
        hG := ⟨_, by simp [e6, ints]; rfl⟩
        hE2 := ⟨_, by simp [e7, ints]; rfl⟩
        hB2 := ⟨_, by simp [e8, ints]; rfl⟩
        hZ := ⟨_, by simp [e9, ints]; rfl⟩
        hH := ⟨_, by simp [e10, ints]; rfl⟩
        hF := ⟨_, by simp [e11, ints]; rfl⟩
        hO := ⟨_, by simp <;> rfl⟩
        hPw := ⟨_, by simp [e12, ints]; rfl⟩
        hOne := ⟨_, by simp [e13, ints]; rfl⟩
        hD := ⟨_, by simp [e14, ints]; rfl⟩
        hPh := ⟨_, by simp (config := {decide := true}) [e15, KFM.ints_append] <;> rfl⟩
        hCh := ⟨_, by simp (config := {decide := true}) [e16, KFM.ints_append] <;> rfl⟩
        hLn := ⟨_, by simp (config := {decide := true}) [e17, KFM.ints_append] <;> rfl⟩ }
  · simp (config := {decide := true}) [hOK.h0, h0G 0 (by decide) (by decide) (by decide), ints]
  · simp (config := {decide := true}) [hOK.h43, h0G 43 (by decide) (by decide) (by decide), ints]
  · simp (config := {decide := true}) [hOK.h55, ints]
  · simp (config := {decide := true}) [readSt]
  · -- cost
    have c3 : cStart n ≤ 10 ^ 7 * (n + 1) := by
      unfold cStart
      rw [NLogN.zsz_two_pow]
      have := zsz_natCast_le_self' (lg n)
      have : lg n ≤ n := by
        show bP6 n ≤ n
        have h1 := two_pow_b_lt (n := n) (by omega)
        have h2 : bP6 n - 1 < 2 ^ (bP6 n - 1) := Nat.lt_two_pow_self
        omega
      simp only [dupCost, zipCost, moveCost]; omega
    have c4 : shlCost n ≤ 200 * (n + 1) := by simp only [shlCost, moveCost, zipCost]; omega
    have hTl := G.T_lo
    have hTp : 24 * n ≤ 2 ^ LP6 P n * pP6 P n := by
      have : pP6 P n = 6 * b'P6 P n := rfl
      rw [this]; unfold TP6 at hTl; nlinarith
    have hc2' : c2 ≤ 2 ^ LP6 P n * pP6 P n := le_trans hc2 hC'
    have hN : (cStart n + (c2 + (3 + 2 * shlCost n)) + 2 : ℕ) ≤
        10 ^ 9 * (2 ^ LP6 P n * pP6 P n) := by omega
    have hN1 := Ncost6_ge_one P hP n
    have hV : ((2 ^ LP6 P n * pP6 P n : ℕ) : ℝ) ≤ cU6 P n 0 := by
      unfold cU6 VP6 TP6
      rw [pow_zero, mul_one]
      push_cast
      have h0 : (0 : ℝ) ≤ (2 : ℝ) ^ LP6 P n * (pP6 P n : ℝ) := by positivity
      nlinarith
    calc ((cStart n + (c2 + (3 + 2 * shlCost n)) + 2 : ℕ) : ℝ)
        ≤ ((10 ^ 9 * (2 ^ LP6 P n * pP6 P n) : ℕ) : ℝ) := by exact_mod_cast hN
      _ = 10 ^ 9 * ((2 ^ LP6 P n * pP6 P n : ℕ) : ℝ) := by push_cast; ring
      _ ≤ 10 ^ 9 * cU6 P n 0 := by gcongr

end

