import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Definitions.Def_RepGQML_commutant
import Definitions.Def_RepGQML_groupAlgebra

/-!
An endomorphism commutes with the algebra generated by a group representation
if and only if it commutes with each representing operator.

Source Ragone et al., Definition 17 and preceding paragraph.
https://arxiv.org/pdf/2210.07980v2#page=28

Target https://prove2.me/theorems/2c221f96-47ff-45e4-8770-181e69701dc1
-/

set_option autoImplicit false

open RepGQML

theorem solution {k G H : Type*} [Field k] [Group G] [AddCommGroup H]
    [Module k H] (U : Representation k G H) (T : Module.End k H) :
    T ∈ commutant (groupAlgebra U) ↔ ∀ g : G, T * U g = U g * T := by
  rw [commutant, groupAlgebra, Subalgebra.mem_centralizer_iff]
  constructor
  · intro h g
    exact (h (U g) (Algebra.subset_adjoin (Set.mem_range_self g))).symm
  · intro h x hx
    exact (Algebra.commute_of_mem_adjoin_of_forall_mem_commute hx (by
      rintro _ ⟨g, rfl⟩
      exact h g)).eq.symm
