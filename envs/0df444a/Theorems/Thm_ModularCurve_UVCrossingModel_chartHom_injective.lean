theorem ModularCurve.UVCrossingModel.chartHom_injective {W : Type*} [CommRing W] {π : W} (hπ : π ∈ nonZeroDivisors W) (hsep : ∀ x : W, (∀ n : ℕ, π ^ n ∣ x) → x = 0) : Function.Injective (chartHom π) := by sorry
