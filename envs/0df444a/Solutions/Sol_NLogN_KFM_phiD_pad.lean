section
-- Source module: Solutions.KFUPhiMath
/-!
# KFU §10: what `Φ` and `Φ⁻¹` compute (against `RCRT.upd`)

For a valid address `b` of `S_r` (`shR (sP)`), viewed as the function `fnL b j = b_j`:

* `fn_gRotF`: the forward step `gRot (csF) i` is `RCRT.updInv i` (subtract `μ_i Σ_{j<i} b_j P_j`),
* `fn_gRotB`: the inverse step `gRot (csB) i` is `RCRT.upd i`,

so `Gf d` undoes the `RCRT` shift chain `foldr upd (range d)` and `Gb d` is that chain.  With
`(42)` (`RCRT.coord_formula`) the shift chain sends the digit address of `k < P_d` to
`Φ(k) = (μ_j k mod s_j)_j`.  End results (`phiAddr k c = [μ_0 k mod s_0, …, μ_{d-1} k mod s_{d-1}, c]`):

* `PhiD_at`: `(PhiD xs)[enc_{T_r} (phiAddr k c)] = xs[2k + c]`,
* `PhiD_zero`: `PhiD xs` is `0` at every `T_r`-address that is not an `S_r`-address,
* `PhiInvD_at`: `(PhiInvD ys)[2k + c] = ys[enc_{T_r} (phiAddr k c)]`.

Hypotheses: `0 < s_j` and `μ_j P_j ≡ 1 (mod s_j)` for `j < d`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFU

open IntMul KFC AModel AModelL12

theorem fnL_inj {a b : List ℕ} (hl : a.length = b.length) (h : fnL a = fnL b) : a = b := by
  apply List.ext_getElem hl
  intro j h1 h2
  have := congrFun h j
  simp only [fnL] at this
  rwa [List.getD_eq_getElem _ _ h1, List.getD_eq_getElem _ _ h2] at this

theorem fnL_rotG (n Q : ℕ) (f : List ℕ → ℕ) (b : List ℕ) (hn : n < b.length) :
    fnL (rotG n Q f b) = Function.update (fnL b) n ((b.getD n 0 + Q - f (b.take n)) % Q) := by
  have e : rotG n Q f b = b.set n ((b.getD n 0 + Q - f (b.take n)) % Q) := by
    rw [List.set_eq_take_append_cons_drop, if_pos hn]; rfl
  rw [e]
  funext j
  simp only [fnL]
  by_cases hj : j = n
  · subst hj; simp [List.getD_eq_getElem?_getD, List.getElem?_set, hn]
  · rw [Function.update_of_ne hj]
    simp only [fnL]
    simp [List.getD_eq_getElem?_getD, List.getElem?_set, Ne.symm hj]

theorem shR_range (d : ℕ) (f : ℕ → ℕ) : shR d f = (List.range (d + 1)).map f := by
  simp [shR, List.range_succ]

theorem valid_shR_lt {d : ℕ} {f : ℕ → ℕ} {b : List ℕ} (hb : Valid (shR d f) b) :
    b.length = d + 1 ∧ ∀ j < d + 1, fnL b j < f j := by
  rw [shR_range] at hb
  obtain ⟨hl, hlt⟩ := (valid_iff _ _).1 hb
  simp only [List.length_map, List.length_range] at hl
  refine ⟨hl, fun j hj => ?_⟩
  have := hlt j (by omega) (by simpa using hj)
  simp only [List.getElem_map, List.getElem_range] at this
  simp only [fnL]; rwa [List.getD_eq_getElem _ _ (by omega)]

theorem valid_shR_of {d : ℕ} {f : ℕ → ℕ} {b : List ℕ} (hl : b.length = d + 1)
    (h : ∀ j < d + 1, fnL b j < f j) : Valid (shR d f) b := by
  rw [shR_range]
  refine (valid_iff _ _).2 ⟨by simpa using hl, fun j h1 h2 => ?_⟩
  have := h j (by omega)
  simp only [fnL] at this
  rw [List.getD_eq_getElem _ _ h1] at this
  simpa using this

section Shift

variable {d : ℕ} {sF μ : ℕ → ℕ}

theorem lf_cast (cs b : List ℕ) (i : ℕ) (hcs : cs.length = i) (hb : i ≤ b.length) (s : ℕ) :
    ((KIL.lf cs (b.take i) : ℕ) : ZMod s) =
      ∑ k ∈ Finset.range i, ((cs.getD k 0 : ℕ) : ZMod s) * (fnL b k : ZMod s) := by
  rw [KIL.lf_eq_sum _ _ (by simp; omega), hcs]
  push_cast
  refine Finset.sum_congr rfl fun k hk => ?_
  simp only [Finset.mem_range] at hk
  congr 2
  simp only [fnL, List.getD_eq_getElem?_getD, List.getElem?_take, if_pos hk]

theorem csF_getD (i k : ℕ) (hk : k < i) :
    (csF sF μ i).getD k 0 = μ i * OpenAI.RCRT.Ppre sF k % sF i := by
  simp [csF, List.getD_eq_getElem?_getD, hk]

theorem offset_cast (x : ℕ → ℕ) (i s : ℕ) :
    ((OpenAI.RCRT.offset sF μ x i : ℕ) : ZMod s) =
      ∑ k ∈ Finset.range i, ((μ i * OpenAI.RCRT.Ppre sF k : ℕ) : ZMod s) * (x k : ZMod s) := by
  unfold OpenAI.RCRT.offset
  push_cast
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  ring

theorem validUpTo_of (_hs : ∀ j < d, 1 ≤ sF j) {b : List ℕ} (hb : Valid (shR d (sP d sF)) b)
    {i : ℕ} (hi : i < d) : OpenAI.RCRT.validUpTo sF (fnL b) i := by
  intro j hj
  have := (valid_shR_lt hb).2 j (by omega)
  simpa [sP, show j < d by omega] using this

/-- The forward step is `RCRT.updInv`. -/
theorem fn_gRotF (hs : ∀ j < d, 1 ≤ sF j) {b : List ℕ} (hb : Valid (shR d (sP d sF)) b)
    {i : ℕ} (hi : i < d) :
    fnL (gRot sF (csF sF μ) i b) = OpenAI.RCRT.updInv sF μ i (fnL b) := by
  have hl := (valid_shR_lt hb).1
  unfold gRot
  rw [fnL_rotG _ _ _ _ (by omega)]
  unfold OpenAI.RCRT.updInv
  rw [if_pos (validUpTo_of hs hb hi)]
  congr 1
  have hsi := hs i hi
  set s := sF i
  set f := KIL.lf (csF sF μ i) (b.take i) % s
  set o := OpenAI.RCRT.offset sF μ (fnL b) i
  have hf : f ≤ s := (Nat.mod_lt _ (by omega)).le
  have ho : o % s ≤ s := (Nat.mod_lt _ (by omega)).le
  rw [Nat.add_sub_assoc hf]
  apply (ZMod.natCast_eq_natCast_iff' _ _ s).1
  have hL := lf_cast (csF sF μ i) b i (by simp [csF]) (by omega) s
  push_cast [Nat.cast_sub hf, Nat.cast_sub ho]
  simp only [f, o, ZMod.natCast_mod, ZMod.natCast_self, hL, offset_cast]
  have : ∀ k ∈ Finset.range i, ((((csF sF μ i).getD k 0 : ℕ) : ZMod s)) * (fnL b k : ZMod s) =
      ((μ i * OpenAI.RCRT.Ppre sF k : ℕ) : ZMod s) * (fnL b k : ZMod s) := by
    intro k hk
    rw [csF_getD i k (by simpa using hk), ZMod.natCast_mod]
  rw [Finset.sum_congr rfl this]
  rfl

theorem fn_Gf (hs : ∀ j < d, 1 ≤ sF j) :
    ∀ k ≤ d, ∀ b, Valid (shR d (sP d sF)) b → fnL (Gf sF (csF sF μ) k b) = updInvs sF μ k (fnL b)
  | 0, _, b, _ => rfl
  | k + 1, hk, b, hb => by
    simp only [Gf, Function.comp_apply, updInvs]
    rw [fn_gRotF hs (valid_Gf d sF hs _ k (by omega) b hb) (by omega), fn_Gf hs k (by omega) b hb]

theorem updInvs_foldr (x : ℕ → ℕ) :
    ∀ k ≤ d, updInvs sF μ k ((List.range d).foldr (OpenAI.RCRT.upd sF μ) x) =
      (List.range' k (d - k)).foldr (OpenAI.RCRT.upd sF μ) x
  | 0, _ => by simp [updInvs, List.range_eq_range']
  | k + 1, hk => by
    rw [updInvs, updInvs_foldr x k (by omega)]
    have e : List.range' k (d - k) = k :: List.range' (k + 1) (d - (k + 1)) := by
      rw [show d - k = (d - (k + 1)) + 1 by omega, List.range'_succ]
    rw [e, List.foldr_cons, OpenAI.RCRT.upd_inv]

end Shift

/-! ## Digit addresses and `Φ`-addresses -/

theorem fnL_app (d : ℕ) (g : ℕ → ℕ) (c j : ℕ) :
    fnL ((List.range d).map g ++ [c]) j = if j < d then g j else if j = d then c else 0 := by
  simp only [fnL, List.getD_eq_getElem?_getD]
  by_cases h1 : j < d
  · rw [List.getElem?_append_left (by simpa using h1)]; simp [h1]
  · rw [List.getElem?_append_right (by simpa using h1)]
    simp only [List.length_map, List.length_range, if_neg h1]
    by_cases h2 : j = d
    · subst h2; simp
    · rw [if_neg h2]
      have : 1 ≤ j - d := by omega
      rw [List.getElem?_eq_none (by simpa using this)]; rfl

theorem valid_digAddr {d : ℕ} {sF : ℕ → ℕ} (hs : ∀ j < d, 1 ≤ sF j) (k : ℕ) {c : ℕ} (hc : c < 2) :
    Valid (shR d (sP d sF)) (digAddr d sF k c) := by
  refine valid_shR_of (by simp [digAddr]) fun j hj => ?_
  unfold digAddr; rw [fnL_app]
  by_cases h1 : j < d
  · simp only [if_pos h1, sP]; exact Nat.mod_lt _ (hs j h1)
  · rw [if_neg h1, if_pos (by omega)]; simp [sP, show j = d by omega, hc]

theorem valid_phiAddr {d : ℕ} {sF : ℕ → ℕ} (hs : ∀ j < d, 1 ≤ sF j) (μ : ℕ → ℕ) (k : ℕ) {c : ℕ}
    (hc : c < 2) : Valid (shR d (sP d sF)) (phiAddr d sF μ k c) := by
  refine valid_shR_of (by simp [phiAddr]) fun j hj => ?_
  unfold phiAddr; rw [fnL_app]
  by_cases h1 : j < d
  · simp only [if_pos h1, sP]; exact Nat.mod_lt _ (hs j h1)
  · rw [if_neg h1, if_pos (by omega)]; simp [sP, show j = d by omega, hc]

/-- **(42)**: the `RCRT` shift chain sends the digit address to the `Φ`-address. -/
theorem foldr_digAddr {d : ℕ} {sF μ : ℕ → ℕ} (hs : ∀ j < d, 1 ≤ sF j)
    (hμ : ∀ j < d, ((μ j * OpenAI.RCRT.Ppre sF j : ℕ) : ZMod (sF j)) = 1) (k c : ℕ) :
    (List.range d).foldr (OpenAI.RCRT.upd sF μ) (fnL (digAddr d sF k c)) =
      fnL (phiAddr d sF μ k c) := by
  have ha : ∀ j < d, fnL (digAddr d sF k c) j < sF j := by
    intro j hj; unfold digAddr; rw [fnL_app, if_pos hj]; exact Nat.mod_lt _ (hs j hj)
  rw [OpenAI.RCRT.shifts_realize sF μ d _ ha]
  funext j
  by_cases hj : j < d
  · rw [if_pos hj]
    unfold phiAddr; rw [fnL_app, if_pos hj]
    have hoff : OpenAI.RCRT.offset sF μ (fnL (digAddr d sF k c)) j =
        μ j * ∑ i ∈ Finset.range j, OpenAI.RCRT.digit sF k i * OpenAI.RCRT.Ppre sF i := by
      unfold OpenAI.RCRT.offset
      congr 1
      refine Finset.sum_congr rfl fun i hi => ?_
      simp only [Finset.mem_range] at hi
      unfold digAddr; rw [fnL_app, if_pos (by omega)]
    rw [hoff]
    unfold digAddr; rw [fnL_app, if_pos hj]
    have := OpenAI.RCRT.coord_formula sF μ j k (hμ j hj)
    rw [ZMod.natCast_eq_natCast_iff'] at this
    exact this.symm
  · rw [if_neg hj]
    unfold digAddr phiAddr; rw [fnL_app, fnL_app, if_neg hj, if_neg hj]

/-! ## Encoding the k-order address -/

theorem encode_rev (s x : ℕ → ℕ) : ∀ n,
    encode ((List.range n).map s).reverse ((List.range n).map x).reverse =
      ∑ j ∈ Finset.range n, x j * OpenAI.RCRT.Ppre s j
  | 0 => by simp [encode]
  | n + 1 => by
    rw [List.range_succ, List.map_append, List.map_append, List.reverse_append,
      List.reverse_append]
    simp only [List.map_cons, List.map_nil, List.reverse_cons, List.reverse_nil, List.nil_append]
    rw [List.singleton_append, List.singleton_append]
    simp only [encode, List.headD_cons, List.tail_cons]
    rw [encode_rev s x n, Finset.sum_range_succ]
    have : vol ((List.range n).map s).reverse = OpenAI.RCRT.Ppre s n := by
      rw [vol, List.prod_reverse, ← vol, vol_rangeMap]; rfl
    rw [this]; ring

theorem revH_digAddr (d : ℕ) (sF : ℕ → ℕ) (k c : ℕ) :
    revH d (digAddr d sF k c) = ((List.range d).map (OpenAI.RCRT.digit sF k)).reverse ++ [c] := by
  unfold revH digAddr
  rw [List.take_append_of_le_length (by simp), List.take_of_length_le (by simp),
    List.drop_append_of_le_length (by simp), List.drop_of_length_le (by simp)]
  simp

theorem encode_digAddr {d : ℕ} {sF : ℕ → ℕ} (_hs : ∀ j < d, 1 ≤ sF j) (k c : ℕ)
    (hk : k < OpenAI.RCRT.Ppre sF d) :
    encode (shK d (sP d sF)) (revH d (digAddr d sF k c)) = 2 * k + c := by
  rw [revH_digAddr, shK_eq_app, encode_append_len _ _ (by simp)]
  have e : (List.range d).map (sP d sF) = (List.range d).map sF :=
    List.map_congr_left fun j hj => by simp [sP, List.mem_range.1 hj]
  rw [e, encode_rev, ← OpenAI.RCRT.mixed_radix sF k d hk]
  simp [encode, vol, sP]; ring

/-! ## Pointwise results -/

theorem getD_pull {S S' : Shape} (g : List ℕ → List ℕ) (xs : List ℤ) {j : ℕ} (hj : j < vol S') :
    (pull S S' g 0 xs).getD j 0 = xs.getD (encode S (g (decode S' j))) 0 := by
  rw [List.getD_eq_getElem _ _ (by simpa using hj), getElem_pull]

open Classical in
theorem getD_embed {S T : Shape} (xs : List ℤ) {j : ℕ} (hj : j < vol T) :
    (embed S T 0 xs).getD j 0 =
      if Valid S (decode T j) then xs.getD (encode S (decode T j)) 0 else 0 := by
  classical
  rw [List.getD_eq_getElem _ _ (by simpa using hj)]
  simp only [embed, List.getElem_map, List.getElem_range]

theorem Gf_phiAddr {d : ℕ} {sF μ : ℕ → ℕ} (hs : ∀ j < d, 1 ≤ sF j)
    (hμ : ∀ j < d, ((μ j * OpenAI.RCRT.Ppre sF j : ℕ) : ZMod (sF j)) = 1) (k : ℕ) {c : ℕ}
    (hc : c < 2) : Gf sF (csF sF μ) d (phiAddr d sF μ k c) = digAddr d sF k c := by
  have hv := valid_phiAddr hs μ k hc
  apply fnL_inj
  · rw [(valid_shR_lt (valid_Gf d sF hs _ d le_rfl _ hv)).1]; simp [digAddr]
  · rw [fn_Gf hs d le_rfl _ hv, ← foldr_digAddr hs hμ k c, updInvs_foldr _ d le_rfl]
    simp

end NLogN.KFU

end

section
-- Source module: Solutions.KFU2Cover
/-!
# KFU2 §1: coverage of the `Φ`-addresses and whole-array denotations

Hypotheses (`RCRT` side): `1 ≤ s_j`, pairwise coprime `s_j` (`j < d`), `μ_j P_j ≡ 1 (mod s_j)`.

* `cover`: every valid `S_r`-address `b` is `phiAddr (kOf b) (b_d)` with `kOf b < P_d`
  (CRT via `RCRT.PhiEquiv`).
* `phiAddr_eq_Phi`: the first `d` coordinates of `phiAddr k c` are the `RCRT.Phi` residues of `k`.
* **`PhiD_eq`**: `PhiD xs` at padded address `b` is `xs[2·kOf b + b_d]` if `b` is a source
  address, `0` otherwise (`RCRT` `Φ` on whole arrays, zero padded).
* **`PhiInvD_eq`**: `(PhiInvD ys)[m] = ys[enc_{T_r} (phiAddr (m/2) (m%2))]` (`Φ⁻¹` on whole arrays).
* **`PhiInvD_PhiD`**: `Φ⁻¹ ∘ Φ = id`; **`PhiD_PhiInvD`**: `Φ ∘ Φ⁻¹ = id` on arrays vanishing on the padding.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFU

open IntMul KFC AModel AModelL12

section Cover

variable {d : ℕ} {sF μ : ℕ → ℕ}

theorem Ppre_eq_prod (d : ℕ) (sF : ℕ → ℕ) :
    ∏ i : Fin d, sF i = OpenAI.RCRT.Ppre sF d := by
  rw [Fin.prod_univ_eq_prod_range (fun j => sF j) d]; rfl

end Cover

end NLogN.KFU

end

section
-- Source module: Solutions.KFMPhiW
/-!
# KFM: `Φ` / `Φ⁻¹` with `s_j ≤ t_j`, and as arrays of the chain

KFU states the pointwise denotations of `Φ`/`Φ⁻¹` under `s_j ≤ 2^h`; the parameters have
`s_j ≤ t_j = 2^{h+b_j}` (`PhiNeed`, as corrected). The proofs only use `sP ≤ tP`:

* `sP_le_tPW`, `le_SRW`, **`PhiD_atW`**, **`PhiInvD_atW`**, **`PhiD_eqW`** (copies with the weak
  hypothesis `hsw : ∀ j < d, sF j ≤ tP d h bL j`).

As arrays of the chain (box `t_i = tP d h bL i`, source `s_i = sF i`, last axis = component):

* `encode_snoc2`: `enc (sh ++ [2]) (v ++ [c]) = 2·enc sh v + c`.
* `pairL ys`: the Gaussian items of an integer list; `gflat (pairL ys) = ys` for even length.
* **`phiD_pad`**: `pairL (PhiD xs)` vanishes off the source points (`PadZ`) and holds the item
  `(xs[2κ], xs[2κ+1])`, `κ = (Φ⁻¹ k).val`, at source point `k`.
* **`phiInvD_read`**: `(PhiInvD (gflat ws))[2m + c]` is component `c` of `ws` at the point
  `Φ(m)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul AModel AModelL12 NLogN.KFU KFB

noncomputable section

variable {d : ℕ}

theorem sP_le_tPW (d h : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) (hs : ∀ j < d, sF j ≤ tP d h bL j)
    (j : ℕ) : sP d sF j ≤ tP d h bL j := by
  unfold sP; split_ifs with h1
  · exact hs j h1
  · rw [tP_eq, if_neg h1]

theorem le_SRW (d h : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) (hs : ∀ j < d, sF j ≤ tP d h bL j) :
    List.Forall₂ (· ≤ ·) (shR d (sP d sF)) (shR d (tP d h bL)) :=
  forall₂_map_le (fun j _ => sP_le_tPW d h bL sF hs j)

theorem PhiD_atW (h d : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j)
    (hsw : ∀ j < d, sF j ≤ tP d h bL j)
    (hμ : ∀ j < d, ((μ j * OpenAI.RCRT.Ppre sF j : ℕ) : ZMod (sF j)) = 1) (xs : List ℤ) (k c : ℕ)
    (hk : k < OpenAI.RCRT.Ppre sF d) (hc : c < 2) :
    (PhiD h d bL sF μ xs).getD (encode (shR d (tP d h bL)) (phiAddr d sF μ k c)) 0 =
      xs.getD (2 * k + c) 0 := by
  have hv := valid_phiAddr hs μ k hc
  have hvT := (shapeLE_of_forall₂ (le_SRW d h bL sF hsw)).valid hv
  have hda := valid_digAddr hs k hc
  unfold PhiD
  rw [getD_embed _ (encode_lt hvT), decode_encode hvT, if_pos hv, getD_pull _ _ (encode_lt hv),
    decode_encode hv, Gf_phiAddr hs hμ k hc, getD_pull _ _ (encode_lt hda), decode_encode hda,
    encode_digAddr hs k c hk]

/-! ## Arrays -/

theorem encode_snoc2 : ∀ (sh v : List ℕ), v.length = sh.length → ∀ c,
    encode (sh ++ [2]) (v ++ [c]) = 2 * encode sh v + c
  | [], [], _, c => by simp [encode]
  | [], _ :: _, h, _ => by simp at h
  | _ :: _, [], h, _ => by simp at h
  | q :: sh, a :: v, h, c => by
    simp only [List.cons_append, encode, List.headD_cons, List.tail_cons, vol_cons]
    rw [encode_snoc2 sh v (by simpa using h) c]
    simp only [vol, List.prod_append, List.prod_cons, List.prod_nil]; ring

theorem shR_eq (d : ℕ) (f : ℕ → ℕ) :
    shR d f = List.ofFn (fun i : Fin d => f i) ++ [f d] := by
  simp [shR, List.map_append, List.ofFn_eq_map, List.map_map]
  rw [← List.map_coe_finRange_eq_range, List.map_map]; rfl

theorem gflat_getD_even : ∀ (zs : List GI) (x : ℕ), (gflat zs).getD (2 * x) 0 = (zs.getD x 0).1
  | [], x => by simp
  | z :: zs, 0 => by simp
  | z :: zs, x + 1 => by
    rw [gflat_cons, show 2 * (x + 1) = 2 * x + 1 + 1 by ring, List.getD_cons_succ,
      List.getD_cons_succ, gflat_getD_even zs x, List.getD_cons_succ]

theorem gflat_getD_odd : ∀ (zs : List GI) (x : ℕ), (gflat zs).getD (2 * x + 1) 0 = (zs.getD x 0).2
  | [], x => by simp
  | z :: zs, 0 => by simp
  | z :: zs, x + 1 => by
    rw [gflat_cons, show 2 * (x + 1) + 1 = 2 * x + 1 + 1 + 1 by ring, List.getD_cons_succ,
      List.getD_cons_succ, gflat_getD_odd zs x, List.getD_cons_succ]

theorem getD_of_gflat {zs : List GI} {ys : List ℤ} (h : gflat zs = ys) (x : ℕ) :
    zs.getD x 0 = (ys.getD (2 * x) 0, ys.getD (2 * x + 1) 0) := by
  rw [← h, gflat_getD_even, gflat_getD_odd]

section Arr

variable (h : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) (H : CrtOK d sF μ)

theorem shR_tBox : shR d (tP d h bL) = List.ofFn (tBox d h bL) ++ [2] := by
  rw [shR_eq, tP_eq, if_neg (lt_irrefl d)]; rfl

theorem phiAddr_kL (m c : ℕ) :
    haveI := sBox_ne sF μ H
    phiAddr d sF μ m c = kL (eB sF μ H (m : ZMod (∏ i, sBox d sF i))) ++ [c] := by
  haveI := sBox_ne sF μ H
  unfold phiAddr
  congr 1
  apply List.ext_getElem (by simp [kL])
  intro i h1 h2
  simp only [List.length_map, List.length_range] at h1
  have e := phiAddr_eq_Phi H m c ⟨i, h1⟩
  have e1 : (phiAddr d sF μ m c).getD i 0 = μ i * m % sF i := by
    unfold phiAddr
    rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by simpa using h1)]
    simp [h1]
  simp only at e
  rw [e1] at e
  rw [List.getElem_map, List.getElem_range, e]
  simp only [kL, List.getElem_ofFn, eB, IntMul.OpenAI.RCRT.PhiEquiv_apply]
  rfl

theorem encode_phiAddr (m c : ℕ) :
    haveI := sBox_ne sF μ H
    encode (shR d (tP d h bL)) (phiAddr d sF μ m c) =
      2 * encode (List.ofFn (tBox d h bL)) (kL (eB sF μ H (m : ZMod (∏ i, sBox d sF i)))) + c := by
  haveI := sBox_ne sF μ H
  rw [phiAddr_kL sF μ H, shR_tBox, encode_snoc2 _ _ (by simp [kL]) c]

theorem Ppre_eq : (∏ i, sBox d sF i) = OpenAI.RCRT.Ppre sF d := Ppre_eq_prod d sF

/-- **`Φ` as a padded array.** -/
theorem phiD_pad_sol_aux (hsw : ∀ j < d, sF j ≤ tP d h bL j) (xs : List ℤ) {zs : List GI}
    (hz : gflat zs = PhiD h d bL sF μ xs) :
    haveI := sBox_ne sF μ H
    zs.length = (List.ofFn (tBox d h bL)).prod ∧ PadZ (sBox d sF) (tBox d h bL) zs ∧
    ∀ k : (i : Fin d) → ZMod (sBox d sF i),
      zs.getD (encode (List.ofFn (tBox d h bL)) (kL k)) 0 =
        (xs.getD (2 * ((eB sF μ H).symm k).val) 0, xs.getD (2 * ((eB sF μ H).symm k).val + 1) 0) := by
  haveI := sBox_ne sF μ H
  refine ⟨?_, ?_, ?_⟩
  · have := congrArg List.length hz
    rw [length_gflat, PhiD, length_embed, shR_tBox, vol, List.prod_append] at this
    simp at this; omega
  · intro x hx hn
    have hlen : (decode (List.ofFn (tBox d h bL)) x).length = (List.ofFn (tBox d h bL)).length :=
      length_decode _ _
    have hval : ∀ c < 2, (PhiD h d bL sF μ xs).getD (2 * x + c) 0 = 0 := by
      intro c hc
      have e : 2 * x + c = encode (shR d (tP d h bL)) (decode (List.ofFn (tBox d h bL)) x ++ [c]) := by
        rw [shR_tBox, encode_snoc2 _ _ hlen c, encode_decode hx]
      rw [e]
      apply PhiD_zero
      · rw [shR_tBox]
        have hv := valid_decode hx
        exact List.rel_append hv (List.Forall₂.cons hc List.Forall₂.nil)
      · intro hvS
        apply hn
        intro i
        obtain ⟨-, hlt⟩ := valid_shR_lt hvS
        have := hlt i (by omega)
        rw [decode_ofFn] at this
        simpa [fnL, sP, List.getD_eq_getElem?_getD, List.getElem?_append_left, i.2, sBox] using this
    have h0' := hval 0 (by norm_num)
    rw [add_zero] at h0'
    rw [getD_of_gflat hz x, h0', hval 1 (by norm_num)]; rfl
  · intro k
    haveI : NeZero (∏ i, sBox d sF i) :=
      ⟨Finset.prod_ne_zero_iff.2 (fun i _ => (sBox_ne sF μ H i).out)⟩
    set κ := ((eB sF μ H).symm k).val
    have hk : (κ : ZMod (∏ i, sBox d sF i)) = (eB sF μ H).symm k := ZMod.natCast_zmod_val _
    have hκ : κ < OpenAI.RCRT.Ppre sF d := by rw [← Ppre_eq]; exact ZMod.val_lt _
    have hs : ∀ j < d, 1 ≤ sF j := H.pos
    rw [getD_of_gflat hz]
    have e : ∀ c, 2 * encode (List.ofFn (tBox d h bL)) (kL k) + c =
        encode (shR d (tP d h bL)) (phiAddr d sF μ κ c) := by
      intro c; rw [encode_phiAddr h bL sF μ H, hk, AddEquiv.apply_symm_apply]
    have e0 : 2 * encode (List.ofFn (tBox d h bL)) (kL k) =
        encode (shR d (tP d h bL)) (phiAddr d sF μ κ 0) := by
      have := e 0; rwa [add_zero] at this
    rw [e 1, e0, PhiD_atW h d bL sF μ hs hsw H.inv xs κ 0 hκ (by norm_num),
      PhiD_atW h d bL sF μ hs hsw H.inv xs κ 1 hκ (by norm_num), add_zero]

end Arr

end

end NLogN.KFM

end

theorem solution : type_of% @NLogN.KFM.phiD_pad_sol_aux := @NLogN.KFM.phiD_pad_sol_aux
