theorem blk_ints (A : List ℤ) (R : List Item) : NLogN.KFY.blk (ints A ++ .mark :: R) = ints A := by
  induction A with
  | nil => simp [NLogN.KFY.blk, ints]
  | cons a A ih =>
    simp only [NLogN.KFY.blk, ints, List.map_cons, List.cons_append] at ih ⊢
    rw [List.takeWhile_cons_of_pos (by simp), ih]

theorem aft_ints (A : List ℤ) (R : List Item) : aft (ints A ++ .mark :: R) = R := by
  induction A with
  | nil => simp [aft, ints]
  | cons a A ih =>
    simp only [aft, ints, List.map_cons, List.cons_append] at ih ⊢
    rw [List.dropWhile_cons_of_pos (by simp), ih]

theorem descTr_items (w h : ℕ) (bs : List Bool) :
    ints (descTr w h bs) = .int (w : ℤ) :: .int (h : ℤ) :: .int (bs.length : ℤ) ::
      ints (bs.map fun b => if b then (1 : ℤ) else 0) := rfl

theorem hOf_descTr (w h : ℕ) (bs : List Bool) : hOf (ints (descTr w h bs)) = h := by
  simp [hOf, descTr_items, itZ]

theorem wOfD_descTr (w h : ℕ) (bs : List Bool) : wOfD (ints (descTr w h bs)) = w := by
  simp [wOfD, descTr_items, itZ]

theorem bsOf_descTr (w h : ℕ) (bs : List Bool) : bsOf (ints (descTr w h bs)) = bs := by
  rw [descTr_items]
  simp only [bsOf, ints, List.drop_succ_cons, List.drop_zero, List.map_map]
  conv_rhs => rw [← List.map_id bs]
  apply List.map_congr_left
  intro b _
  cases b <;> simp

theorem pairsOf_gflat (zs : List GI) (l : List Item) :
    pairsOf zs.length (ints (gflat zs) ++ l) = zs := by
  induction zs with
  | nil => rfl
  | cons z zs ih =>
    simp only [List.length_cons, gflat, List.flatMap_cons, ints, List.map_append,
      List.map_cons, List.map_nil, List.cons_append, List.nil_append, List.append_assoc] at ih ⊢
    simp only [pairsOf, itZ]
    rw [ih]

theorem drop_gflat (zs : List GI) (l : List Item) :
    (ints (gflat zs) ++ l).drop (2 * zs.length) = l := by
  have : (ints (gflat zs)).length = 2 * zs.length := by
    induction zs with
    | nil => rfl
    | cons z zs ih =>
      simp only [ints, gflat, List.flatMap_cons, List.map_append, List.length_append,
        List.length_map, List.length_cons, List.length_nil] at ih ⊢
      omega
  rw [← this, List.drop_left]

section node

variable (X dT : Fin HS) (Kc : ℝ)

theorem trF_eq (w h : ℕ) (bs : List Bool) (zs : List GI) (l R : List Item) (u : IState HS)
    (hX : u.G X = ints (descTr w h bs) ++ .mark :: R) (h0 : u.G 0 = ints (gflat zs) ++ l)
    (hz : zs.length = vol (shPad h bs)) (hX0 : X ≠ 0) :
    trF X u = (u.upd X R).upd 0
      (ints (gflat (transposeL ((shPad h bs).headD 1) (vol (shPad h bs).tail) zs)) ++ l) := by
  have hb : NLogN.KFY.blk (u.G X) = ints (descTr w h bs) := by rw [hX, blk_ints]
  have hsh : trSh X u = shPad h bs := by
    simp only [trSh, hb, hOf_descTr, bsOf_descTr]
  simp only [trF, hsh, hX, aft_ints, h0]
  rw [← hz, pairsOf_gflat, drop_gflat]

theorem trC_eq (w h : ℕ) (bs : List Bool) (R : List Item) (u : IState HS)
    (hX : u.G X = ints (descTr w h bs) ++ .mark :: R) :
    trC X Kc u = ⌈trBound Kc w h bs.length (vol (shPad h bs))⌉₊ + trOver w h bs.length := by
  have hb : NLogN.KFY.blk (u.G X) = ints (descTr w h bs) := by rw [hX, blk_ints]
  have hsh : trSh X u = shPad h bs := by
    simp only [trSh, hb, hOf_descTr, bsOf_descTr]
  simp only [trC, hsh, hb, hOf_descTr, bsOf_descTr, wOfD_descTr]

end node

theorem descTr_bnd (w h : ℕ) (bs : List Bool) :
    ∀ x ∈ descTr w h bs, zsz x ≤ trB w h bs.length := by
  intro x hx
  simp only [descTr, List.mem_cons, List.mem_map] at hx
  have zw := zsz_natCast_le_self' w
  have zh := zsz_natCast_le_self' h
  have zk := zsz_natCast_le_self' bs.length
  unfold trB
  rcases hx with rfl | rfl | rfl | ⟨b, -, rfl⟩
  · omega
  · omega
  · omega
  · have : zsz (if b then (1 : ℤ) else 0) ≤ 1 := by
      split_ifs
      · exact zsz_le_of_lt (by norm_num)
      · exact zsz_le_of_lt (by norm_num)
    omega

theorem descTr_length (w h : ℕ) (bs : List Bool) : (descTr w h bs).length = bs.length + 3 := by
  simp [descTr]

/-- A state as `encK`: `f 0 = gflat zs`, `f dT = descTr`, the rest unmanaged. -/
theorem encK_split (dT : Fin HS) (hdT : dT ≠ 0) (u : IState HS) (A Bv : List ℤ) (l r : List Item)
    (h0 : u.G 0 = ints A ++ l) (hD : u.G dT = ints Bv ++ r) :
    u = NLogN.KIL.encK { u with G := fun j => if j = 0 then l else if j = dT then r else u.G j }
      (fun j => if j = 0 then A else if j = dT then Bv else []) := by
  refine IState.ext' ?_ rfl rfl
  intro j
  simp only [encK_G]
  by_cases j0 : j = 0
  · subst j0; simp [h0]
  · by_cases jd : j = dT
    · subst jd; simp [j0, hD]
    · simp [j0, jd, ints]

theorem trW_runs {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {jT : Fin P}
    {X Y dT : Fin HS} {Kc : ℝ} (hT : TrHyp I iprog jT dT Kc) (hdT : dT ≠ 0) (hXY : X ≠ Y)
