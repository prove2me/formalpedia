        rw [lt_div_iff₀ hD] at hlt_top
        push_cast at hlt_top; linarith
      refine ⟨p, hp_lt, ?_, ?_⟩
      · have hfl := Nat.floor_le hnum_nn
        rw [le_div_iff₀ hstep_r] at hfl
        rw [div_le_iff₀ hD]; push_cast; linarith
