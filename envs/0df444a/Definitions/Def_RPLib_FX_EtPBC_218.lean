-- ===== S4.Def_RP_EtPBC_A_PBCStkb =====
section

/-!
# S4-EtPBC-A, L1g part 2: degree `0` (`pbcEquivZero`) and **`pbc_of_germs`** (all degrees; see `PBCStk` for the
statement in words)
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact

universe u

variable (Λ : Type u) [CommRing Λ] {P S : Scheme.{u}} (g : P ⟶ S) (s : GeomPt S)

/-- **Proper base change on stalks from the germ conditions** (all degrees). -/
theorem pbc_of_germs (h0 : ∀ G, BCInj Λ g s 0 G) (hS : ∀ q G, BCSurj Λ g s q G) (F : EtSh Λ P) :
    ∀ q, Nonempty (ToType ((s.stalkF Λ).obj (((push g Λ).rightDerived q).obj F)) ≃+
      H Λ ((pull (fibι g s) Λ).obj F) q)
  | 0 => ⟨pbcEquivZero Λ g s F (h0 F) (hS 0 F)⟩
  | p + 1 => ⟨pbcEquivSucc Λ g s (injectiveResolution F) p
      (Delta.injAt_all (bcUnit_comp Λ g s) h0 hS (p + 1) F) (hS (p + 1) F)⟩

end RamanujanPetersson.EtPBC

end

end

-- ===== S4.Def_RP_EtPBC_A_O2Gen2 =====
section

/-!
# S4-EtPBC-A, O2 Gen2: one-point classes on `P¹` are sums of point classes

* `genT Λ hN hΛ T`: the subgroup generated by point classes `PtCls Λ c hN hΛ T` over all charts `c : A¹ ⟶ P¹`;
* `comp_mem_genT`: `genT` is stable under `x ↦ x ∘ Λ[r]`;
* `good_mem_genT`: an `IsLoc` class at a point of generic degree lies in `genT` (`isLoc_free_good`);
* `isLoc_comp_mem`: for `R` affine, every `IsLoc` class `β'` of `Λ[R]` has `β' ∘ Λ[r] ∈ genT` (`pp_isLoc` over a
  moved chart `chartM c₀` missing a generic-degree point);
* `isLoc_mem_genT`: every `IsLoc` class of `Λ[T]` lies in `genT` (`isLoc_free_res`);
* **`gen_free`**: with `N = l ^ m`, every class in `Ext² (Λ, Λ[T])` lies in `genT` (`mem_locSpan_P1`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtKum

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.EtMV
  RamanujanPetersson.EtPBC.EtShap RamanujanPetersson.EtPBC.EtDeg RamanujanPetersson.EtCompact.Pur
  RamanujanPetersson.EtPi1 RamanujanPetersson.Kummer RamanujanPetersson.EtCompact.GalTrE
  RamanujanPetersson.EtCompact.CurveHn RamanujanPetersson.EtCompact.PushStk RamanujanPetersson.EtCompact.PushBC

section Gen

variable {k : Type} [Field k] [IsAlgClosed k] (Λ : Type) [CommRing Λ] {N : ℕ} [NeZero N] (hN : (N : k) ≠ 0)
  (hΛ : ∀ x : Λ, N • x = 0)

set_option maxHeartbeats 1000000 in
/-- **Every one-point class of `Λ[T]` on `P¹` is a sum of point classes.** -/
theorem isLoc_mem_genT (T : (P1 k).Etale) [IsSeparated T.hom] (hTa : IsAffineHom T.hom)
    (hTf : ∀ x : P1 k, Finite ((geomPtAt x).point.fiber.obj T)) (z : P1 k)
    (β : Ext.{0} (freeSh Λ (etId (P1 k))) (freeSh Λ T) 2) (hβ : IsLoc Λ (freeSh Λ T) z β) :
    β ∈ genT Λ hN hΛ T := by
  obtain ⟨a, ha⟩ := exists_A1pt_of_mem_range (p1Chart k z) z (isClosed_of_isLoc hβ) ⟨_, p1Chart_p1Pt k z⟩
  have hβ' : IsLoc Λ (freeSh Λ T) (p1Chart k z (A1pt k a)) β := by rw [ha]; exact hβ
  have := hTf (p1Chart k z (A1pt k a))
  obtain ⟨R, r, β', hR, -, hRa, hdiff⟩ := isLoc_free_res (p1Chart k z) a hN hΛ (chart_hGal _ a) hβ'
  have : IsAffine R.left := hRa hTa
  have h1 : β - β'.comp (Ext.mk₀ (freeMap Λ r)) (add_zero 2) ∈ genT Λ hN hΛ T :=
    (AddSubgroup.closure_le _).2 (fun x hx => mem_genT_of_ptCls Λ hN hΛ (p1Chart k z) hx) hdiff
  have h2 := (mem_compSub r _ β').1 (isLoc_comp_mem Λ hN hΛ R T r _ β' hR)
  have h3 := add_mem h1 h2
  rwa [sub_add_cancel] at h3

end Gen

section Free

end Free

end RamanujanPetersson.EtPBC.EtKum

end

