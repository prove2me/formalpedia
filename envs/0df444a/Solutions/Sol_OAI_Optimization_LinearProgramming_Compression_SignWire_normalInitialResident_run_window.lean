theorem mono (h : Footprint B s) (hBC : B ≤ C) : Footprint C s :=
  ⟨fun i => (h.address i).trans hBC, fun i hi => h.data_zero i (hBC.trans_lt hi),
    fun i hi => h.index_zero i (hBC.trans_lt hi)⟩

