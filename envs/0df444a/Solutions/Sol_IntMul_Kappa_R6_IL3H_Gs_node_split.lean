/-- The node inequality, split: `X = A (mF)^p` with `2 ∑ Gs(sF) ≤ X`, `2A ≤ X`,
`X + E mod m ≤ Gs E`. -/
theorem Gs_node_split_sol_aux {A p m E : ℕ} (ws : List ℕ) (hm : 1 ≤ m) (hp : 1 ≤ p) (hA1 : 1 ≤ A)
    (hE : 2 * m ≤ E) (hws : 2 * (ws.map fun s => (2 * s + 1) ^ p).sum ≤ (2 * m) ^ p) :
    ∃ X, 2 * (ws.map fun s => Gs A p m (s * (E / m))).sum ≤ X ∧ 2 * A ≤ X ∧
      X + E % m ≤ Gs A p m E := by
  set F := E / m with hF
  set r := E % m with hr
  have hF2 : 2 ≤ F := by rw [hF, Nat.le_div_iff_mul_le (by omega)]; linarith
  have hEq : E = m * F + r := (Nat.div_add_mod E m).symm
  rw [Gs_ge hE]
  have hch : ∀ s, 2 ^ p * Gs A p m (s * F) ≤ A * ((2 * s + 1) ^ p * F ^ p) := by
    intro s
    have h1 := Gs_le (m := m) (x := s * F) hA1 hp
    have h2 := child_pow (s := s) (p := p) hF2
    calc 2 ^ p * Gs A p m (s * F) ≤ 2 ^ p * (A * ((s * F + 1) ^ p - 1)) := Nat.mul_le_mul_left _ h1
      _ ≤ 2 ^ p * (A * (s * F + 1) ^ p) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.sub_le _ _))
      _ = A * (2 ^ p * (s * F + 1) ^ p) := by ring
      _ ≤ A * ((2 * s + 1) ^ p * F ^ p) := Nat.mul_le_mul_left _ h2
  have hsum : 2 ^ p * (ws.map fun s => Gs A p m (s * F)).sum ≤
      A * (ws.map fun s => (2 * s + 1) ^ p).sum * F ^ p := by
    rw [← List.sum_map_mul_left]
    calc (ws.map fun s => 2 ^ p * Gs A p m (s * F)).sum
        ≤ (ws.map fun s => A * ((2 * s + 1) ^ p * F ^ p)).sum := List.sum_le_sum (fun s _ => hch s)
      _ = A * ((ws.map fun s => (2 * s + 1) ^ p).sum * F ^ p) := by
          rw [List.sum_map_mul_left, List.sum_map_mul_right]
      _ = _ := by ring
  have hpos : 0 < 2 ^ p := by positivity
  have key : 2 * (ws.map fun s => Gs A p m (s * F)).sum ≤ A * (m * F) ^ p := by
    have h1 : 2 ^ p * (2 * (ws.map fun s => Gs A p m (s * F)).sum) ≤ 2 ^ p * (A * (m * F) ^ p) := by
      calc 2 ^ p * (2 * (ws.map fun s => Gs A p m (s * F)).sum)
          = 2 * (2 ^ p * (ws.map fun s => Gs A p m (s * F)).sum) := by ring
        _ ≤ 2 * (A * (ws.map fun s => (2 * s + 1) ^ p).sum * F ^ p) := Nat.mul_le_mul_left _ hsum
        _ = A * (2 * (ws.map fun s => (2 * s + 1) ^ p).sum) * F ^ p := by ring
        _ ≤ A * (2 * m) ^ p * F ^ p := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hws)
        _ = 2 ^ p * (A * (m * F) ^ p) := by rw [mul_pow, mul_pow]; ring
    exact Nat.le_of_mul_le_mul_left h1 hpos
  have hmF2 : 2 ≤ (m * F) ^ p := by
    have : 2 ≤ m * F := by nlinarith
    exact le_trans this (Nat.le_self_pow (by omega) _)
  have hsup := add_pow_ge (m * F) (r + 1) p hp
  rw [show m * F + (r + 1) = E + 1 by omega] at hsup
  have hr1 := le_Ap (A := A) (x := r) hA1 hp
  have hrp : 1 ≤ (r + 1) ^ p := Nat.one_le_pow _ _ (by omega)
  refine ⟨A * (m * F) ^ p, key, ?_, ?_⟩
  · have := Nat.mul_le_mul_left A hmF2; linarith
  · have e1 : A * ((E + 1) ^ p - 1) ≥ A * (m * F) ^ p + A * ((r + 1) ^ p - 1) := by
      have : (m * F) ^ p + ((r + 1) ^ p - 1) ≤ (E + 1) ^ p - 1 := by omega
      calc A * (m * F) ^ p + A * ((r + 1) ^ p - 1) = A * ((m * F) ^ p + ((r + 1) ^ p - 1)) := by
            ring
        _ ≤ A * ((E + 1) ^ p - 1) := Nat.mul_le_mul_left _ this
    omega

