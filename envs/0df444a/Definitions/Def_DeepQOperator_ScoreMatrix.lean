-- title:
--   Cosine-squared densities, score matrices, and the boundary matrix (22)
-- statement:
--   1. The **cosine-squared density** of radius $r>0$ is $f_r(x)=\frac1r\cos^2\!\big(\frac{\pi x}{2r}\big)\mathbf 1\{|x|\le r\}$, with score $s_r(x)=-\frac{\pi}{r}\tan\!\big(\frac{\pi x}{2r}\big)$ on $|x|<r$; a **product density** with radii $(r_i)$ is $\rho(x)=\prod_i f_{r_i}(x_i)$ (92).
--   2. For a density $\rho$ on $\mathbb R^d$, the **score** is $s(x)=\nabla\rho(x)/\rho(x)$ where $\rho(x)>0$ and $s(x)=0$ otherwise, and the **score matrix** is $I=\mathbb E[s(X)s(X)^{\mathsf T}]$ for $X\sim\rho\,dx$. It is finite when every $s_j^2\rho$ is integrable.
--   3. $\mathbb E\,\mathrm{Var}(n^{\mathsf T}X\mid CX)=\mathbb E\big[(n^{\mathsf T}X-\mathbb E[n^{\mathsf T}X\mid CX])^2\big]$ for a real matrix $C$.
--   4. For two decisions with contrast $g=t_+-t_-$, the loss of $+$ is $\max(0,-g)$ and that of $-$ is $\max(0,g)$.
--   5. The **boundary matrix** (22) of labels with probabilities $p_l$, multipliers $c_l$, widths $R_l$ and normals $n_l$ is
--   $$B=I^{-1/2}\Big(\sum_l\frac{p_lc_l}{4R_l}n_ln_l^{\mathsf T}\Big)I^{-1/2}.$$
--
--   These objects carry the spectral lower bound (Theorem 6) behind the lower bounds of Theorem 2.
--
--   **Formalization Note** Partial derivatives are `fderiv` applied to basis vectors. The conditional expectation is taken under $\rho\,dx$ with respect to the σ-algebra generated by $x\mapsto Cx$. `boundaryMatrix` takes the matrix playing $I^{-1/2}$ as an argument; the theorems require it to be the positive definite $S$ with $S^2=I^{-1}$. A lemma records that $B$ is symmetric.
-- source:
--   Qi, Deep Q-Operator: Fixed-Accuracy Adaptive Information and Shared Bellman Decisions, STOC 2027 submission (manuscript sha256 9f8f3285…), Theorem 6 eq. (22) p.8, Appendix K.1 p.39, Appendix N.1 eq. (92) p.55 (PDF pp.11, 42, 58)

import Mathlib

open MeasureTheory Matrix

namespace DeepQOperator

/-!
# Densities, score matrices, and the decision-boundary matrix (22)

Q. Qi, *Deep Q-Operator: Fixed-Accuracy Adaptive Information and Shared Bellman Decisions*,
STOC 2027 submission (manuscript sha256 9f8f3285…), §5 Theorem 6 and eq. (22) p.8 (PDF p.11),
Appendix K.1 p.39 (PDF p.42), Appendix N.1 eq. (92) p.55 (PDF p.58).

* The cosine-squared density (92): `f_r(x) = (1/r) cos²(πx/(2r)) 1{|x| ≤ r}`, its score
  `s_r(x) = -(π/r) tan(πx/(2r))` on `|x| < r`, and products `ρ(x) = Π_i f_{r_i}(x_i)`.
* For a density `ρ` on `ℝ^ι`: the score `s(x) = ∇ρ(x)/ρ(x)` where `ρ(x) > 0` and `s(x) = 0`
  otherwise (K.1), the score matrix `I = E[s(X)s(X)ᵀ]`, and the law `ρ dx`.
* `E Var(nᵀX | CX)` for `X ∼ ρ dx` and a real matrix `C`.
* For a binary decision with contrast `g = t₊ - t₋`, the loss of `+` is `max(0, -g)` and that of `-`
  is `max(0, g)` (this is (3) with two decisions).
* The boundary matrix (22): `B = I^{-1/2} (Σ_l (p_l c_l/(4R_l)) n_l n_lᵀ) I^{-1/2}`.

**Formalization Note.**
* `scoreVec ρ x j` uses the partial derivative `fderiv ℝ ρ x (Pi.single j 1)`. "Finite score
  matrix" is `FiniteFisher ρ`: every `s_j² ρ` is Lebesgue integrable (then every `s_j s_k ρ` is).
* `condVarExp ρ C n` is `∫ (nᵀx - E[nᵀX | σ(CX)](x))² ρ(x) dx`, with the conditional expectation
  taken under `ρ dx` with respect to the σ-algebra generated by `x ↦ Cx`.
* `boundaryMatrix S p c R nv` takes the matrix `S` that plays `I^{-1/2}` as an argument; the theorems
  that use it require `S` positive definite with `S * S = I⁻¹`, which determines `S` uniquely.
-/

/-- The cosine-squared density (92) of radius `r`. -/
noncomputable def cosSqDensity (r x : ℝ) : ℝ :=
  if |x| ≤ r then (1 / r) * Real.cos (Real.pi * x / (2 * r)) ^ 2 else 0

/-- Its score `s_r(x) = -(π/r) tan(πx/(2r))`, used on `|x| < r`. -/
noncomputable def cosSqScore (r x : ℝ) : ℝ := -(Real.pi / r) * Real.tan (Real.pi * x / (2 * r))

/-- The product density `ρ(x) = Π_i f_{r_i}(x_i)` with radii `rad`. -/
noncomputable def productDensity {ι : Type} [Fintype ι] (rad : ι → ℝ) (x : ι → ℝ) : ℝ :=
  ∏ i, cosSqDensity (rad i) (x i)

/-- The score `s(x) = ∇ρ(x)/ρ(x)` where `ρ(x) > 0`, and `0` elsewhere. -/
noncomputable def scoreVec {ι : Type} [Fintype ι] [DecidableEq ι] (ρ : (ι → ℝ) → ℝ) (x : ι → ℝ)
    (j : ι) : ℝ :=
  if 0 < ρ x then fderiv ℝ ρ x (Pi.single j 1) / ρ x else 0

/-- The score matrix is finite: every `s_j² ρ` is integrable. -/
def FiniteFisher {ι : Type} [Fintype ι] [DecidableEq ι] (ρ : (ι → ℝ) → ℝ) : Prop :=
  ∀ j, Integrable (fun x => scoreVec ρ x j ^ 2 * ρ x)

/-- The score matrix `I = E[s(X)s(X)ᵀ]` for `X ∼ ρ dx`. -/
noncomputable def fisherMatrix {ι : Type} [Fintype ι] [DecidableEq ι] (ρ : (ι → ℝ) → ℝ) :
    Matrix ι ι ℝ :=
  fun j k => ∫ x, scoreVec ρ x j * scoreVec ρ x k * ρ x

/-- The law `ρ dx` of `X`. -/
noncomputable def densityMeasure {ι : Type} [Fintype ι] (ρ : (ι → ℝ) → ℝ) : Measure (ι → ℝ) :=
  volume.withDensity (fun x => ENNReal.ofReal (ρ x))

/-- `E Var(nᵀX | CX)` for `X ∼ ρ dx`. -/
noncomputable def condVarExp {ι : Type} [Fintype ι] {k : ℕ} (ρ : (ι → ℝ) → ℝ)
    (C : Matrix (Fin k) ι ℝ) (n : ι → ℝ) : ℝ :=
  ∫ x, (n ⬝ᵥ x - (densityMeasure ρ)[fun y => n ⬝ᵥ y |
      MeasurableSpace.comap (fun y => C *ᵥ y) inferInstance] x) ^ 2 ∂(densityMeasure ρ)

/-- The loss of a binary decision with contrast `g`: `max(0, -g)` for `+` (`true`) and
`max(0, g)` for `-`. -/
noncomputable def binLoss {ι : Type} (g : (ι → ℝ) → ℝ) (a : Bool) (x : ι → ℝ) : ℝ :=
  if a then max 0 (-g x) else max 0 (g x)

/-- The boundary matrix (22) `S (Σ_l (p_l c_l/(4R_l)) n_l n_lᵀ) S`, with `S` in the role of
`I^{-1/2}`. -/
noncomputable def boundaryMatrix {ι L : Type} [Fintype ι] [Fintype L] (S : Matrix ι ι ℝ)
    (p c R : L → ℝ) (nv : L → ι → ℝ) : Matrix ι ι ℝ :=
  S * (∑ l, (p l * c l / (4 * R l)) • vecMulVec (nv l) (nv l)) * S

lemma boundaryMatrix_isHermitian {ι L : Type} [Fintype ι] [Fintype L] {S : Matrix ι ι ℝ}
    (hS : S.IsHermitian) (p c R : L → ℝ) (nv : L → ι → ℝ) :
    (boundaryMatrix S p c R nv).IsHermitian := by
  have hM : (∑ l, (p l * c l / (4 * R l)) • vecMulVec (nv l) (nv l)).IsHermitian := by
    ext i j
    simp [Matrix.conjTranspose_apply, Matrix.sum_apply, vecMulVec_apply, mul_comm]
  unfold boundaryMatrix
  unfold Matrix.IsHermitian
  rw [Matrix.conjTranspose_mul, Matrix.conjTranspose_mul, hS.eq, hM.eq, Matrix.mul_assoc]

end DeepQOperator


