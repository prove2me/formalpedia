  | 0, r, hr, c, hc, hpos, _, _ => by
    simp only [allCfg, List.mem_singleton] at hc
    subst hc; omega
  | f + 1, r, hr, c, hc, hpos, a, b => by
    simp only [allCfg, List.mem_cons, List.mem_flatMap, List.mem_finRange, true_and] at hc ⊢
    rcases hc with rfl | ⟨a', b', hc⟩
    · exact Or.inr ⟨a, b, self_mem_allCfg m W q f _⟩
    · refine Or.inr ⟨a', b', child_mem_allCfg m W q f _ ?_ c hc hpos a b⟩
      simp [childCfg, hr]

