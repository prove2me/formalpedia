  LanglandsTunnell.TateLocal.localBorel LanglandsTunnell.TateLocal.borelSpace_localBorel
  LocalHaar.isAddHaarMeasure_selfDualHaarAt in

private theorem integral_xLine_eq_integral_xLine_partAt_mul_prod (T : Finset (HeightOneSpectrum (𝓞 ℚ)))
    (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ) (Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ)
    (g : AdelicGL 3 (𝓞 ℚ) ℚ) {ψloc : (v : HeightOneSpectrum (𝓞 ℚ)) → AddChar (v.adicCompletion ℚ) ℂ}
    (hWψ : ∀ v ∉ T, IsGL3PsiWhittakerFn (ψloc v) (dualWhittakerFn3 (Wloc v)))
    (hWK : ∀ v ∉ T, IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 (Wloc v)))
    (hW1 : ∀ v ∉ T, dualWhittakerFn3 (Wloc v) 1 = 1)
    (hψloc : ∀ v ∉ T, ∀ y₀ ∉ v.adicCompletionIntegers ℚ,
      ∃ y : v.adicCompletion ℚ, Valued.v (y * y₀⁻¹) ≤ 1 ∧ ψloc v y ≠ 1)
    (hg : ∀ v ∉ T, componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v)
    (τ : HeightOneSpectrum (𝓞 ℚ) → ℤ → ℂ)
    (hτ : ∀ v ∉ T, ∀ a : (AdeleRing (𝓞 ℚ) ℚ)ˣ,
      ((selfDualHaarAt ℚ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℂ)⁻¹ *
          ∫ y : v.adicCompletion ℚ, LineIntegral.xLineAt Wloc a g v y ∂(selfDualHaarAt ℚ v) =
        τ v (Idele.ord ℚ v a))
    (hτ0 : ∀ v ∉ T, τ v 0 = 1) :
    ∀ L : List (HeightOneSpectrum (𝓞 ℚ)), (∀ v ∈ L, v ∉ T) → L.Nodup →
      ∀ a ∈ AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ ((T : Set (HeightOneSpectrum (𝓞 ℚ))) ∪ {v | v ∈ L}),
        ((NumberField.AdelicHaar.adelicAddHaar (𝓞 ℚ) ℚ (AdelicBox.adelicBox ℚ)).toReal : ℂ)⁻¹ *
            ∫ x : AdeleRing (𝓞 ℚ) ℚ, LineIntegral.xLine Warch Wloc a g x
