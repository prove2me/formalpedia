  have hres_f₀ : Rpd.R₁.residue ⟨f₀, hf₀₁⟩ = Rpd.R₁.residue ⟨f, h₁⟩ * Rpd.R₁.residue ⟨u₀, hc₀mem⟩ ^ n := by
    have : (⟨f₀, hf₀₁⟩ : Rpd.R₁.integers) = ⟨f, h₁⟩ * ⟨u₀, hc₀mem⟩ ^ n := by
      apply Subtype.ext
      simp [hf₀_def]
    rw [this, map_mul, map_pow]
  have hroot₀ : ∀ s ∈ SS, (n : ℤ) ∣ s.1.ord (Rpd.R₁.residue ⟨f₀, hf₀₁⟩) := by
    intro s hs
    have hres_u₀0 : Rpd.R₁.residue ⟨u₀, hc₀mem⟩ ≠ 0 := hc₀res
    rw [hres_f₀, Place.ord_mul _ hr₁ (pow_ne_zero _ hres_u₀0), ← zpow_natCast, Place.ord_zpow]
    exact dvd_add (hroot s hs) (dvd_mul_right _ _)

  choose An hdom hmodulus hinert hz₁ hz₂ hatt₂ hatt₁ using hAnn
  have hpm : ∀ s : ↥SS, ((p : ℕ) : ↥A) ∈ maximalIdeal ↥A := by
    intro s
    obtain ⟨u, hu, hmod⟩ := hmodulus s
    have hm : (An s).modulus ∈ maximalIdeal ↥A := (An s).modulus_mem
    rw [hmod] at hm
    have hpe : ((p : ℕ) : ↥A) ^ (e s) ∈ maximalIdeal ↥A := by
