    unfold cSw1F
    have a : r + 1 ≤ (W + 1) * (Kp + 1) := by nlinarith
    have b1 : (r + 1) * ((4 * q + 136) * 276 * Vq) ≤ (W + 1) * ((4 * q + 136) * 276) * (q ^ 2 * Z) := by
      calc (r + 1) * ((4 * q + 136) * 276 * Vq) ≤ ((W + 1) * (Kp + 1)) * ((4 * q + 136) * 276 * (q ^ 2 * Vb)) :=
            Nat.mul_le_mul a (Nat.mul_le_mul_left _ h3)
        _ ≤ ((W + 1) * (Kp + 1)) * ((4 * q + 136) * 276 * (q ^ 2 * (Vb + 1))) :=
            Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.le_succ _)))
        _ = (W + 1) * ((4 * q + 136) * 276) * (q ^ 2 * Z) := by rw [hZ]; ring
    have b2 : (r + 1) * (10 ^ 9 * X + 10 ^ 4 * (B + 2)) ≤ (W + 1) * (10 ^ 9 + 10 ^ 4) * U := by
      calc (r + 1) * (10 ^ 9 * X + 10 ^ 4 * (B + 2)) ≤ ((W + 1) * (Kp + 1)) * ((10 ^ 9 + 10 ^ 4) * X) :=
            Nat.mul_le_mul a (by nlinarith)
        _ ≤ ((W + 1) * (u + 1)) * ((10 ^ 9 + 10 ^ 4) * X) :=
            Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ (by omega))
        _ = (W + 1) * (10 ^ 9 + 10 ^ 4) * U := by rw [hU]; ring
    have e : (r + 1) * ((4 * q + 136) * 276 * Vq + 10 ^ 9 * X + 10 ^ 4 * (B + 2)) =
        (r + 1) * ((4 * q + 136) * 276 * Vq) + (r + 1) * (10 ^ 9 * X + 10 ^ 4 * (B + 2)) := by ring
    rw [e]; exact Nat.add_le_add b1 b2
  -- 4. the middle part
  have T4 : (if n = 0 then 0 else cMidF Kp V' m n cO B) + 26 ≤
      (3 * 10 ^ 9 + 4000 + (3 * m + 7) * 10 ^ 9 + 26) * U + 80000 * (q ^ 2 * Z) + D := by
    split_ifs with hn
    · nlinarith
    · unfold cMidF cPadF
      have hL := digits_len_le hm (show 1 ≤ n by omega)
      have hP := cPcs_le m n cO B hm
      rw [← hDd] at hP
      have hV' := h6 hn
      have a : 10 ^ 9 * (Kp + 3) * X ≤ 3 * 10 ^ 9 * U := by
        calc 10 ^ 9 * (Kp + 3) * X ≤ 10 ^ 9 * (3 * (u + 1)) * X :=
              Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ (by omega))
          _ = 3 * 10 ^ 9 * U := by rw [hU]; ring
      have b : 40000 * V' ≤ 80000 * (q ^ 2 * Z) := by
        have := Nat.mul_le_mul_left 2 hVqZ
        omega
      have c : ((3 * m + 3) * (Nat.digits m n).length + 2 * (n + 2)) * 10 ^ 9 * X ≤
          (3 * m + 7) * 10 ^ 9 * U := by
        have c1 : (3 * m + 3) * (Nat.digits m n).length + 2 * (n + 2) ≤ (3 * m + 7) * (u + 1) := by
          nlinarith
        calc ((3 * m + 3) * (Nat.digits m n).length + 2 * (n + 2)) * 10 ^ 9 * X
            ≤ ((3 * m + 7) * (u + 1)) * 10 ^ 9 * X :=
              Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ c1)
          _ = (3 * m + 7) * 10 ^ 9 * U := by rw [hU]; ring
      have d : 2 * (2000 * (B + 2)) ≤ 4000 * U := by
        have := le_trans hBX hXU
        linarith
      generalize cPcs m n cO B = CP at hP ⊢
      rw [← hXd] at hP ⊢
      nlinarith
  have T5 : 25 * (2 * B + 2) + 1 ≤ 51 * U := by
    have : B + 2 ≤ U := le_trans hBX hXU
    omega
  -- the constants
  have hA : 80000 * q ^ 2 + (W + 1) * ((4 * q + 136) * 276) * q ^ 2 + 80000 * q ^ 2 ≤ Av q W := by
    unfold Av
    have e1 : q ^ 2 ≤ (q + 1) ^ 3 := by nlinarith
    have e2 : (4 * q + 136) * 276 * q ^ 2 ≤ 37536 * (q + 1) ^ 3 := by nlinarith
    have e3 : 1 ≤ W + 1 := by omega
    have := Nat.mul_le_mul_left (W + 1) e2
    nlinarith
  have hO : 7 * 10 ^ 9 + (4 * 10 ^ 9 + 8008) + (W + 1) * (10 ^ 9 + 10 ^ 4) +
      (3 * 10 ^ 9 + 4000 + (3 * m + 7) * 10 ^ 9 + 26) + 51 ≤ Ao m W := by
    unfold Ao
    nlinarith
  unfold cL12F
  have hZ0 : 0 ≤ Z := Nat.zero_le _
  calc _ ≤ 7 * 10 ^ 9 * U + ((4 * 10 ^ 9 + 8008) * U + 80000 * (q ^ 2 * Z)) +
        ((W + 1) * ((4 * q + 136) * 276) * (q ^ 2 * Z) + (W + 1) * (10 ^ 9 + 10 ^ 4) * U) +
        ((3 * 10 ^ 9 + 4000 + (3 * m + 7) * 10 ^ 9 + 26) * U + 80000 * (q ^ 2 * Z) + D) +
        51 * U := by
          have := Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add T1 T2) T3) T4) T5
          simpa only [add_assoc] using this
    _ = (80000 * q ^ 2 + (W + 1) * ((4 * q + 136) * 276) * q ^ 2 + 80000 * q ^ 2) * Z +
        (7 * 10 ^ 9 + (4 * 10 ^ 9 + 8008) + (W + 1) * (10 ^ 9 + 10 ^ 4) +
          (3 * 10 ^ 9 + 4000 + (3 * m + 7) * 10 ^ 9 + 26) + 51) * U + D := by ring
    _ ≤ Av q W * Z + Ao m W * U + D :=
        Nat.add_le_add_right (Nat.add_le_add (Nat.mul_le_mul_right _ hA) (Nat.mul_le_mul_right _ hO)) _

end NLogN.KFE

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFE
open IntMul RS AModel AModelL12 Finset KIL KFD
set_option maxHeartbeats 4000000
theorem solution {m W S : ℕ} (Kc Kb Kd q : ℕ) (hm : 2 ≤ m) (hW : 1 ≤ W) (hq : 2 ≤ q) {τ : ℝ}
    (hτ : 0 < τ ∧ τ < 1) (hs : (S : ℝ) / W < (m : ℝ) ^ τ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (u : ℕ) (Pre G Suf : AModel.Shape) (Bb e Kp : ℕ), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      e = Nat.clog q (2 ^ u) → Kp = Nat.clog m e →
      (NLogN.KFE.cL12F u e (min (W * Kp) e) Kp (e - min (W * Kp) e) (AModel.vol (AModelL12.qShape Pre G Suf q e))
        (AModel.vol (AModelL12.rowShape (AModel.vol Pre) (AModelL12.padRows W Kp (q ^ min (W * Kp) e))
          (G ++ List.replicate (min (W * Kp) e) q) Suf q (e - min (W * Kp) e))) m q
        (fun j => NLogN.KFD.ilCostF W Kc Kb Kd S q Bb j
          (AModel.vol (AModelL12.rowShape (AModel.vol Pre) (AModelL12.padRows W Kp (q ^ min (W * Kp) e))
            (G ++ List.replicate (min (W * Kp) e) q) Suf q (e - min (W * Kp) e)))) Bb : ℝ) ≤
        K * (((AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) : ℝ) + 1) * (u : ℝ) ^ τ +
          ((u : ℝ) + 1) ^ (Nat.clog m (S + 1) + 1) * ((Bb : ℝ) + 2) ^ 2) := by
  obtain ⟨K₀, hK₀, hK₀b⟩ := NLogN.KFD.ilCostF_le (S := S) Kc Kb Kd q hm hW hτ hs
  obtain ⟨K', hK', hK'b⟩ := AModel.arbitrary_width_sum m τ hm hτ.1
  obtain ⟨Ck, hCk, hCkb⟩ := AModelL12.clog_le_rpow hm hτ.1
  set Kov : ℝ := (Kb : ℝ) + (S : ℝ) * Kd with hKov
  have hKov0 : 0 ≤ Kov := by positivity
  set c := Nat.clog m (S + 1) with hc
  refine ⟨(NLogN.KFE.Av q W : ℝ) * (Ck + 1) + 4 * (q : ℝ) ^ 2 * K₀ * K' + NLogN.KFE.Ao m W + Kov * m, by positivity, ?_⟩
  intro u Pre G Suf Bb e Kp hu hPre hG hS he hKp
  set r := min (W * Kp) e with hr
  set n := e - r with hn
  set Vb := AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) with hVb
  set Vq := AModel.vol (AModelL12.qShape Pre G Suf q e) with hVq
  set R' := AModelL12.padRows W Kp (q ^ r) with hR'
  set V' := AModel.vol (AModelL12.rowShape (AModel.vol Pre) R' (G ++ List.replicate r q) Suf q n) with hV'
  set cO := fun j => NLogN.KFD.ilCostF W Kc Kb Kd S q Bb j V' with hcO
  have he1 : 1 ≤ e := by rw [he]; exact NLogN.KIL.one_le_e hq hu
  have heu : e ≤ u := by rw [he]; exact NLogN.KIL.e_le_u hq
  have hVqb : Vq ≤ q ^ 2 * Vb := by rw [hVq, he]; exact NLogN.KIL.vq_le_vb hq hu Pre G Suf
  have hKe : e ≤ m ^ Kp := by rw [hKp]; exact Nat.le_pow_clog (by omega) e
  have hKpu : Kp ≤ u := le_trans (by rw [hKp]; exact NLogN.KIL.clog_le_self hm e) heu
  have hV'2 : n ≠ 0 → V' ≤ 2 * Vq := fun hn0 => by
    have hrW : r = W * Kp := by rw [hr]; apply min_eq_left; omega
    have h := NLogN.KIL.rowVol_le (n := n) hq hW Pre G Suf (show W ^ Kp ≤ q ^ r by
      rw [hrW]; exact NLogN.KIL.pow_le_q_pow hq)
    rwa [show r + n = e by omega] at h
  -- the linear part
  have hlin := NLogN.KFE.cL12F_lin (q := q) (m := m) (W := W) (u := u) (e := e) (Kp := Kp) (r := r) (n := n)
    (Vb := Vb) (Vq := Vq) (V' := V') cO Bb hm hq heu hVqb (min_le_left _ _) (by omega) hV'2 hKpu
  -- the oracle part
  have hWV : n ≠ 0 → ∀ j < (Nat.digits m n).length, W ^ j ≤ V' := by
    intro hn0 j hj
    have h1 := NLogN.KIL.pow_le_of_lt_len hm (by omega) hj
    have hjK : j ≤ Kp := (Nat.pow_le_pow_iff_right (by omega)).1
      (le_trans h1 (le_trans (by omega : n ≤ e) hKe))
    have hR1 : W ^ Kp ≤ R' := by
      rw [hR', AModelL12.padRows]
      have hpos : 0 < W ^ Kp := Nat.pos_of_ne_zero (pow_ne_zero _ (by omega))
      have : 1 ≤ (q ^ r + W ^ Kp - 1) / W ^ Kp := by
        rw [Nat.le_div_iff_mul_le hpos]
        have := Nat.one_le_pow r q (by omega)
        omega
      calc W ^ Kp = W ^ Kp * 1 := (mul_one _).symm
        _ ≤ _ := Nat.mul_le_mul_left _ this
    have hRV : R' ≤ V' := by
      rw [hV', AModelL12.vol_rowShape]
      have h1 := NLogN.KIL.one_le_vol hPre
      have h2 : 1 ≤ AModel.vol (AModelL12.restShape (G ++ List.replicate r q) Suf q n) := by
        rw [NLogN.KIL.vol_restShape']
        have h3 : 1 ≤ AModel.vol (G ++ List.replicate r q) := by
          rw [AModel.vol_append, AModel.vol_replicate]
          exact Nat.mul_pos (NLogN.KIL.one_le_vol hG) (Nat.one_le_pow _ _ (by omega))
        have h4 : 1 ≤ q ^ n := Nat.one_le_pow _ _ (by omega)
        exact Nat.mul_pos h4 (Nat.mul_pos h3 (Nat.mul_pos h4 (NLogN.KIL.one_le_vol hS)))
      calc R' = 1 * R' * 1 := by ring
        _ ≤ _ := Nat.mul_le_mul (Nat.mul_le_mul_right _ h1) h2
    exact le_trans (Nat.pow_le_pow_right (by omega) hjK) (le_trans hR1 hRV)
  set X : ℝ := ((Bb : ℝ) + 2) ^ 2 with hX
  have hX0 : 0 ≤ X := by positivity
  have hτ0 : 0 ≤ τ := hτ.1.le
  have huτ : 1 ≤ (u : ℝ) ^ τ := Real.one_le_rpow (by exact_mod_cast hu) hτ0
  have hu1 : (1 : ℝ) ≤ (u : ℝ) + 1 := by have : (0 : ℝ) ≤ u := Nat.cast_nonneg u; linarith
  have hUc : (u : ℝ) + 1 ≤ ((u : ℝ) + 1) ^ (c + 1) := by
    calc (u : ℝ) + 1 = ((u : ℝ) + 1) ^ 1 := (pow_one _).symm
      _ ≤ ((u : ℝ) + 1) ^ (c + 1) := pow_le_pow_right₀ hu1 (by omega)
  set D := ∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * cO j with hD
  have hDb : (D : ℝ) ≤ 4 * (q : ℝ) ^ 2 * K₀ * K' * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) +
      Kov * m * (((u : ℝ) + 1) ^ (c + 1) * X) := by
    by_cases hn0 : n = 0
    · have : D = 0 := by rw [hD, hn0]; simp
      rw [this]; push_cast; positivity
    · have hn1 : 1 ≤ n := by omega
      have step1 : (D : ℝ) ≤ ∑ j ∈ range (Nat.digits m n).length,
          ((AModel.digit m n j : ℝ) * (2 * K₀ * V') * ((m : ℝ) ^ j) ^ τ +
            Kov * X * ((n / m ^ j % m * (S + 1) ^ j : ℕ) : ℝ)) := by
        rw [hD]; push_cast
        apply sum_le_sum
        intro j hj
        rw [mem_range] at hj
        rw [NLogN.KIL.digit_eq hm]
        have hc := hK₀b Bb j V'
        have hWj : ((W : ℝ) ^ j) ≤ V' := by exact_mod_cast hWV hn0 j hj
        have hd0 : (0 : ℝ) ≤ ((n / m ^ j % m : ℕ) : ℝ) := Nat.cast_nonneg _
        have hmj : 0 ≤ ((m : ℝ) ^ j) ^ τ := by positivity
        have : (cO j : ℝ) ≤ 2 * K₀ * V' * ((m : ℝ) ^ j) ^ τ + Kov * ((S : ℝ) + 1) ^ j * X := by
          refine le_trans hc ?_
          rw [← hX]
          have : K₀ * ((V' : ℝ) + (W : ℝ) ^ j) ≤ K₀ * (2 * V') := by
            apply mul_le_mul_of_nonneg_left _ hK₀; linarith
          nlinarith
        calc ((n / m ^ j % m : ℕ) : ℝ) * (cO j : ℝ)
            ≤ ((n / m ^ j % m : ℕ) : ℝ) * (2 * K₀ * V' * ((m : ℝ) ^ j) ^ τ +
              Kov * ((S : ℝ) + 1) ^ j * X) := mul_le_mul_of_nonneg_left this hd0
          _ = _ := by push_cast; ring
      have step2 : ∑ j ∈ range (Nat.digits m n).length,
          ((AModel.digit m n j : ℝ) * (2 * K₀ * V') * ((m : ℝ) ^ j) ^ τ +
            Kov * X * ((n / m ^ j % m * (S + 1) ^ j : ℕ) : ℝ)) =
          (2 * K₀ * V') * ∑ j ∈ range (Nat.digits m n).length,
            (AModel.digit m n j : ℝ) * ((m : ℝ) ^ j) ^ τ +
          Kov * X * ((∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * (S + 1) ^ j : ℕ) : ℝ) := by
        rw [sum_add_distrib, mul_sum]
        congr 1
        · apply sum_congr rfl; intro j _; ring
        · push_cast; rw [mul_sum]
      have step3 := hK'b n hn1
      have hnτ : (n : ℝ) ^ τ ≤ (u : ℝ) ^ τ :=
        Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast (show n ≤ u by omega)) hτ0
      have hV'r : (V' : ℝ) ≤ 2 * (q : ℝ) ^ 2 * Vb := by
        have := le_trans (hV'2 hn0) (Nat.mul_le_mul_left 2 hVqb)
        have h' : (V' : ℝ) ≤ ((2 * (q ^ 2 * Vb) : ℕ) : ℝ) := by exact_mod_cast this
        push_cast at h'; linarith
      have hcalls : ((∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * (S + 1) ^ j : ℕ) : ℝ) ≤
          (m : ℝ) * ((u : ℝ) + 1) ^ (c + 1) := by
        have h1 := NLogN.KFE.calls_le S hm hn1
        have h2 : n ^ (c + 1) ≤ (u + 1) ^ (c + 1) := Nat.pow_le_pow_left (by omega) _
        have h3 : ((∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * (S + 1) ^ j : ℕ) : ℝ) ≤
            ((m * (u + 1) ^ (c + 1) : ℕ) : ℝ) := by
          exact_mod_cast le_trans h1 (Nat.mul_le_mul_left _ h2)
        refine le_trans h3 (le_of_eq ?_)
        push_cast; ring
      have hsum0 : 0 ≤ ∑ j ∈ range (Nat.digits m n).length, (AModel.digit m n j : ℝ) * ((m : ℝ) ^ j) ^ τ :=
        sum_nonneg fun j _ => by positivity
      have hKX : 0 ≤ Kov * X := by positivity
      calc (D : ℝ) ≤ _ := step1
        _ = _ := step2
        _ ≤ (2 * K₀ * V') * (K' * (n : ℝ) ^ τ) + Kov * X * ((m : ℝ) * ((u : ℝ) + 1) ^ (c + 1)) :=
            add_le_add (mul_le_mul_of_nonneg_left step3 (by positivity))
              (mul_le_mul_of_nonneg_left hcalls hKX)
        _ ≤ (2 * K₀ * (2 * (q : ℝ) ^ 2 * Vb)) * (K' * (u : ℝ) ^ τ) +
              Kov * X * ((m : ℝ) * ((u : ℝ) + 1) ^ (c + 1)) := by
            gcongr
        _ ≤ 4 * (q : ℝ) ^ 2 * K₀ * K' * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) +
              Kov * m * (((u : ℝ) + 1) ^ (c + 1) * X) := by
            have h0 : (0 : ℝ) ≤ 4 * (q : ℝ) ^ 2 * K₀ * K' * (u : ℝ) ^ τ := by positivity
            have h1 : (4 * (q : ℝ) ^ 2 * K₀ * K' * (u : ℝ) ^ τ) * Vb ≤
                (4 * (q : ℝ) ^ 2 * K₀ * K' * (u : ℝ) ^ τ) * (Vb + 1) :=
              mul_le_mul_of_nonneg_left (by linarith) h0
            have e1 : (2 * K₀ * (2 * (q : ℝ) ^ 2 * Vb)) * (K' * (u : ℝ) ^ τ) =
                (4 * (q : ℝ) ^ 2 * K₀ * K' * (u : ℝ) ^ τ) * Vb := by ring
            have e2 : 4 * (q : ℝ) ^ 2 * K₀ * K' * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) =
                (4 * (q : ℝ) ^ 2 * K₀ * K' * (u : ℝ) ^ τ) * (Vb + 1) := by ring
            have e3 : Kov * X * ((m : ℝ) * ((u : ℝ) + 1) ^ (c + 1)) =
                Kov * m * (((u : ℝ) + 1) ^ (c + 1) * X) := by ring
            rw [e1, e2, e3]
            linarith
  -- `Kp + 1 ≤ (Ck + 1) u^τ`
  have hKpb : (Kp : ℝ) + 1 ≤ (Ck + 1) * (u : ℝ) ^ τ := by
    have h1 := hCkb e he1
    rw [← hKp] at h1
    have h2 : (e : ℝ) ^ τ ≤ (u : ℝ) ^ τ :=
      Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast heu) hτ0
    have h3 : Ck * (e : ℝ) ^ τ ≤ Ck * (u : ℝ) ^ τ := mul_le_mul_of_nonneg_left h2 hCk
    have e4 : (Ck + 1) * (u : ℝ) ^ τ = Ck * (u : ℝ) ^ τ + (u : ℝ) ^ τ := by ring
    rw [e4]
    linarith
  have hlinR : (NLogN.KFE.cL12F u e r Kp n Vq V' m q cO Bb : ℝ) ≤
      (NLogN.KFE.Av q W : ℝ) * (((Vb : ℝ) + 1) * ((Kp : ℝ) + 1)) + (NLogN.KFE.Ao m W : ℝ) * (X * ((u : ℝ) + 1)) + D := by
    have h' : ((NLogN.KFE.cL12F u e r Kp n Vq V' m q cO Bb : ℕ) : ℝ) ≤
        ((NLogN.KFE.Av q W * ((Vb + 1) * (Kp + 1)) + NLogN.KFE.Ao m W * ((Bb + 2) ^ 2 * (u + 1)) + D : ℕ) : ℝ) := by
      exact_mod_cast hlin
    push_cast at h'
    rw [hX]; linarith
  have hAv : (0 : ℝ) ≤ NLogN.KFE.Av q W := Nat.cast_nonneg _
  have hAo : (0 : ℝ) ≤ NLogN.KFE.Ao m W := Nat.cast_nonneg _
  generalize (NLogN.KFE.Av q W : ℝ) = A at hlinR hAv ⊢
  generalize (NLogN.KFE.Ao m W : ℝ) = A' at hlinR hAo ⊢
  have hVb0 : (0 : ℝ) ≤ (Vb : ℝ) + 1 := by positivity
  have hP : 0 ≤ ((u : ℝ) + 1) ^ (c + 1) * X := by positivity
  have hQ : 0 ≤ ((Vb : ℝ) + 1) * (u : ℝ) ^ τ := by positivity
  calc (NLogN.KFE.cL12F u e r Kp n Vq V' m q cO Bb : ℝ)
      ≤ A * (((Vb : ℝ) + 1) * ((Kp : ℝ) + 1)) + A' * (X * ((u : ℝ) + 1)) + D :=
        hlinR
    _ ≤ A * (((Vb : ℝ) + 1) * ((Ck + 1) * (u : ℝ) ^ τ)) +
        A' * (((u : ℝ) + 1) ^ (c + 1) * X) +
        (4 * (q : ℝ) ^ 2 * K₀ * K' * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) +
          Kov * m * (((u : ℝ) + 1) ^ (c + 1) * X)) := by
        have a1 := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hKpb hVb0) hAv
        have a2 : A' * (X * ((u : ℝ) + 1)) ≤ A' * (((u : ℝ) + 1) ^ (c + 1) * X) :=
          mul_le_mul_of_nonneg_left (by rw [mul_comm X]; exact mul_le_mul_of_nonneg_right hUc hX0) hAo
        exact add_le_add (add_le_add a1 a2) hDb
    _ = (A * (Ck + 1) + 4 * (q : ℝ) ^ 2 * K₀ * K') * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) +
        (A' + Kov * m) * (((u : ℝ) + 1) ^ (c + 1) * X) := by ring
    _ ≤ (A * (Ck + 1) + 4 * (q : ℝ) ^ 2 * K₀ * K' + A' + Kov * m) * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) +
        (A * (Ck + 1) + 4 * (q : ℝ) ^ 2 * K₀ * K' + A' + Kov * m) * (((u : ℝ) + 1) ^ (c + 1) * X) := by
        have h1 : A * (Ck + 1) + 4 * (q : ℝ) ^ 2 * K₀ * K' ≤
            A * (Ck + 1) + 4 * (q : ℝ) ^ 2 * K₀ * K' + A' + Kov * m := by
          have : (0 : ℝ) ≤ Kov * m := by positivity
          linarith
        have h2 : A' + Kov * m ≤ A * (Ck + 1) + 4 * (q : ℝ) ^ 2 * K₀ * K' + A' + Kov * m := by
          have : (0 : ℝ) ≤ A * (Ck + 1) + 4 * (q : ℝ) ^ 2 * K₀ * K' := by positivity
          linarith
        exact add_le_add (mul_le_mul_of_nonneg_right h1 hQ) (mul_le_mul_of_nonneg_right h2 hP)
    _ = _ := by ring
end
