  simp only [List.map_append, List.map_cons, List.map_nil, List.reverse_cons, List.reverse_nil,
    List.nil_append, List.cons_append, List.singleton_append, chain, labG, MinL, MoutL, NetScalar.wX,
    NetProp7.time, τo, NetProp7.pj_zero, NetProp7.cj_zero, NetProp7.pj_one, NetProp7.cj_one, NetProp7.pj_two, NetProp7.cj_two, Fin.isValue, Fin.reduceEq,
    if_true, if_false, Fin.coe_ofNat_eq_mod, Nat.reduceMod, Nat.reduceSub, Fin.val_zero,
    Fin.val_one, Fin.val_two]
  have e0 := (srel ind hcard 0 (a.2.1, a.2.2)).chainX0 (AM_zero_eq _ _) a.1 (-NetProp7.uA ind a) 0 0
    (by rw [NetProp7.uA, ← source_X]) 0
  have e1 := (srel ind hcard 1 (a.1, a.2.2)).chainX a.2.1
    (labK (αM 0 (ind a.2.1) (ind a.2.2)) (AM 0 (ind a.2.1) (ind a.2.2)) (τM 0 (ind a.1)) 7) 0 0
    (by simp only [labK]; exact boundX01 _ _ _) 0
  have e2 := (srel ind hcard 2 (a.1, a.2.1)).chainX a.2.2
    (labK (αM 1 (ind a.1) (ind a.2.2)) (AM 1 (ind a.1) (ind a.2.2)) (τM 1 (ind a.2.1)) 7) 0 0
    (by simp only [labK]; exact boundX12 _ _ _) 0
  have ef : rk (1 - labK (αM 2 (ind a.1) (ind a.2.1)) (AM 2 (ind a.1) (ind a.2.1))
      (τM 2 (ind a.2.2)) 7) = 0 := by
    simp only [labK, sink_X, sub_self, rk_zero]
  simp only [Fin.isValue, Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero, pow_one] at e0 e1 e2
  linear_combination e0 + e1 + e2 + ef

lemma chain_Y (a : T × T × T) :
    chain rk (MinL ind (NetScalar.wY a)) (labelsOn (NetScalar.wY a) (gatesL ind)) (MoutL ind (NetScalar.wY a)) =
      (h : ℚ) ^ 3 - 1 := by
  rw [gatesL, NetProp7.labelsOn_labelled, NetProp7.names_Y]
  simp only [List.map_append, List.map_cons, List.map_nil, List.reverse_cons, List.reverse_nil,
    List.nil_append, List.cons_append, List.singleton_append, chain, labG, MinL, MoutL, NetScalar.wY,
    NetProp7.time, τo, NetProp7.pj_zero, NetProp7.cj_zero, NetProp7.pj_one, NetProp7.cj_one, NetProp7.pj_two, NetProp7.cj_two, Fin.isValue, Fin.reduceEq,
    if_true, if_false, Fin.coe_ofNat_eq_mod, Nat.reduceMod, Nat.reduceSub, Fin.val_zero,
    Fin.val_one, Fin.val_two]
  have e0 := (srel ind hcard 0 (a.2.1, a.2.2)).chainY a.1 0 0 0 (source_Y _ _ _) 0
  have e1 := (srel ind hcard 1 (a.1, a.2.2)).chainY a.2.1
    (labK (αM 0 (ind a.2.1) (ind a.2.2)) (AM 0 (ind a.2.1) (ind a.2.2)) (τM 0 (ind a.1)) 5) 0 0
    (by simp only [labK]; exact boundY01 _ _ _) 0
  have e2 := (srel ind hcard 2 (a.1, a.2.1)).chainY a.2.2
    (labK (αM 1 (ind a.1) (ind a.2.2)) (AM 1 (ind a.1) (ind a.2.2)) (τM 1 (ind a.2.1)) 5) 0 0
    (by simp only [labK]; exact boundY12 _ _ _) 0
  have ef : rk (1 - NetProp7.uA ind a - labK (αM 2 (ind a.1) (ind a.2.1)) (AM 2 (ind a.1) (ind a.2.1))
      (τM 2 (ind a.2.2)) 5) = 0 := by
    simp only [labK, sink_Y, NetProp7.uA, sub_self, rk_zero]
  simp only [Fin.isValue, Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero, pow_one] at e0 e1 e2
  linear_combination e0 + e1 + e2 + ef

lemma chain_C (j : Fin 3) (p : T × T) (i : Fin h) :
    chain rk (MinL ind (NetScalar.wC j p i)) (labelsOn (NetScalar.wC j p i) (gatesL ind)) (MoutL ind (NetScalar.wC j p i)) =
      (h : ℚ) ^ 3 + 2 * h := by
  rw [gatesL, NetProp7.labelsOn_labelled, NetProp7.names_C, ← card_cube (h := h)]
  fin_cases j <;>
  simp only [List.map_append, List.map_cons, List.map_nil, List.reverse_cons, List.reverse_nil,
    List.nil_append, List.cons_append, List.singleton_append, chain, labG, MinL, MoutL, NetScalar.wC,
    NetProp7.time, τo, Fin.isValue, Fin.reduceEq, if_true, if_false, Fin.coe_ofNat_eq_mod, Nat.reduceMod,
    Nat.reduceSub, Fin.val_zero, Fin.val_one, Fin.val_two, Fin.zero_eta, Fin.mk_one,
    Fin.reduceFinMk] <;>
  exact (srel ind hcard _ p).chainC 0

