theorem chunkP_states (X RB D C : Fin HS) (n : Ex HS) (s : IState HS) (b x : ℕ)
    (LX LR : List Item) (hXR : X ≠ RB) (hXD : X ≠ D) (hRD : RB ≠ D) (hCX : C ≠ X) (hCR : C ≠ RB)
    (hCD : C ≠ D) (hX : s.G X = .int (x : ℤ) :: LX) (hR : s.G RB = .int (2 ^ b) :: LR)
    (hn : 0 ≤ n.eval s) :
    RM.RepStates C n (.op (.split X RB D)) s (chunkSt X D s b x LX) where
  nonneg := hn
  hw := by simp [RM.writes, IOp.stks, hCX, hCR, hCD]
  h0 := by
    simp only [chunkSt, mul_zero, pow_zero, Nat.div_one]
    have : chunksL b 0 x = [] := rfl
    rw [this]; simp only [List.reverse_nil, ints_nil, List.nil_append, IState.upd_self]
    rw [← hX, IState.upd_self, IState.upd_self]
  hG := fun k => by simp [chunkSt, IState.upd_G, hCX, hCD]
  step := fun k _ => by
    simp only [RM.run, IOp.run, withCtr, chunkSt]
    have e1 : ((((s.upd X (.int ((x / 2 ^ (b * k) : ℕ) : ℤ) :: LX)).upd D
        (ints (chunksL b k x).reverse ++ s.G D)).upd C
        (.int ((n.eval s).toNat - k : ℤ) :: s.G C)).G X) =
        .int ((x / 2 ^ (b * k) : ℕ) : ℤ) :: LX := by simp [IState.upd_G, hCX.symm, hXD]
    have e2 : ((((s.upd X (.int ((x / 2 ^ (b * k) : ℕ) : ℤ) :: LX)).upd D
        (ints (chunksL b k x).reverse ++ s.G D)).upd C
        (.int ((n.eval s).toNat - k : ℤ) :: s.G C)).G RB) = .int (2 ^ b) :: LR := by
      simp [IState.upd_G, hCR.symm, hRD, hXR.symm, hR]
    rw [e1, e2]
    simp only [rulerExp_two_pow, hXR, hXD, hRD, or_self, if_false, Int.natAbs_natCast,
      sg_natCast]
    have hd : x / 2 ^ (b * k) / 2 ^ b = x / 2 ^ (b * (k + 1)) := by
      rw [Nat.div_div_eq_div_mul, ← pow_add]; ring_nf
    rw [hd, chunksL_succ]
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all [ints]

theorem chunkP_run (X RB D C : Fin HS) (n : Ex HS) (s : IState HS) (b x : ℕ)
    (LX LR : List Item) (hXR : X ≠ RB) (hXD : X ≠ D) (hRD : RB ≠ D) (hCX : C ≠ X) (hCR : C ≠ RB)
    (hCD : C ≠ D) (hX : s.G X = .int (x : ℤ) :: LX) (hR : s.G RB = .int (2 ^ b) :: LR)
    (hn : 0 ≤ n.eval s) :
    (chunkP X RB D C n).run s = chunkSt X D s b x LX (n.eval s).toNat :=
  (chunkP_states X RB D C n s b x LX LR hXR hXD hRD hCX hCR hCD hX hR hn).run

theorem chunkP_ok (M : MulSpec) (X RB D C : Fin HS) (n : Ex HS) (s : IState HS) (b x : ℕ)
    (LX LR : List Item) (hXR : X ≠ RB) (hXD : X ≠ D) (hRD : RB ≠ D) (hCX : C ≠ X) (hCR : C ≠ RB)
    (hCD : C ≠ D) (hX : s.G X = .int (x : ℤ) :: LX) (hR : s.G RB = .int (2 ^ b) :: LR)
    (hn : 0 ≤ n.eval s) (hC : C.val < 56) (hc : n.Clean) (hno : n.ok s) :
    (chunkP X RB D C n).ok M s := by
  refine (chunkP_states X RB D C n s b x LX LR hXR hXD hRD hCX hCR hCD hX hR hn).ok hC hc hno ?_
  intro k _
  simp [RM.ok, IOp.run, withCtr, chunkSt, IState.upd_G, hCX.symm, hXD, hCR.symm, hRD,
    hXR.symm, hR, hXR, rulerExp_two_pow]

end NLogN

end

