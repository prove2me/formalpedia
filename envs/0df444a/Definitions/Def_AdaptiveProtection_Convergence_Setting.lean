-- title:
--   §1–§2, pp. 762–764 — fill events (2), ratios r_{i+1}, demand laws, H_i, h_i, interim levels (7), step sizes A/(n+B), the recursion (4)
-- statement:
--   This file fixes the model of van Ryzin and McGill's adaptive protection-level algorithm for a single flight leg with $k+1$ nested fare classes.
--
--   **Fares and demands.** Fare classes are numbered $1, \dots, k+1$ from the highest fare down; $f_i$ is the fare of class $i$ and $r_i = f_i / f_1$ its **discount ratio**. A demand vector is $x = (x_1, x_2, \dots)$, where $x_i$ is the demand $X_i$ of class $i$; the partial sum $X_1 + \cdots + X_i$ is written $S_i(x)$. For a family of laws $(\nu_i)_{i \ge 1}$ on $\mathbb R$, the **flight law** is the product measure $\bigotimes_i \nu_i$ on demand vectors (independent classes), and the **path law** is the product of countably many copies of the flight law: a sample path $\omega = (\omega_0, \omega_1, \dots)$ lists the demand vectors of successive, independent and identically distributed flights, $\omega_n$ being the paper's $X^{n+1}$.
--
--   **Fill events (2).** For protection levels $\theta = (\theta_1, \theta_2, \dots)$ and $i \ge 1$,
--   $$A_i(\theta, X) = \{X_1 > \theta_1,\ X_1 + X_2 > \theta_2,\ \dots,\ X_1 + \cdots + X_i > \theta_i\}.$$
--
--   **Adjustments.** For $1 \le i \le k$, $H_i(\theta, X) = r_{i+1} - \mathbf 1(A_i(\theta, X))$, and $H_i = 0$ for every other index $i$. The mean adjustment is $h_i(\theta) = r_{i+1} - P(A_i(\theta, X))$, with $P$ the flight law.
--
--   **Interim protection levels (7).** $p_i(\theta) = \max\{\theta_j : 1 \le j \le i\}$ for $i \ge 1$.
--
--   **Step sizes.** $\gamma_n = A/(n + B)$, read at $n \ge 1$.
--
--   **The recursion (4).** Starting from an arbitrary deterministic vector $\theta^1$, along a sample path $\omega$,
--   $$\theta^{n+1} = \theta^n - \gamma_n H(\theta^n, X^n), \qquad n = 1, 2, \dots,$$
--   where the step size sequence $\gamma$ is a parameter.
--
--   **Past σ-fields.** For $m \ge 0$, $\mathcal F_m$ is the σ-field generated by the demand vectors $\omega_0, \dots, \omega_{m-1}$ of the first $m$ flights.
--
--   These are the objects of Theorem 1 of the paper and of every lemma of its convergence proof.
--
--   **Formalization Note** Lean's `iterate f k γ θ₁ ω n` is the paper's $\theta^{n+1}$: `iterate … 0 = θ₁` and the step from index $n$ to $n+1$ uses `γ (n + 1)` and `ω n`. The fill event is the published `NestedSeatAlloc.ProbCond.nestEvent` applied to the coordinate projections. Indices $0$ and above $k+1$ are never read by any statement. `interim θ 0` returns $\theta_1$ (unused). `pastField m` is the paper's $F_{m+1}$, the σ-field with respect to which Lean's `iterate … m` is measurable.
-- source:
--   van Ryzin & McGill, Management Science 46(6), 2000, pp. 762–764, (2), (4), (5), (7), the definitions of H and h on p. 763, and γ_n of Lemma 4, p. 764

import Mathlib
import Definitions.Def_NestedSeatAlloc_ProbCond_Model

namespace AdaptiveProtection.Convergence

open MeasureTheory

/-- The fill event `A_i(θ, X)` of (2) (van Ryzin–McGill 2000, p. 762):
`X_1 > θ_1, X_1 + X_2 > θ_2, …, X_1 + ⋯ + X_i > θ_i`, as a set of demand vectors `x : ℕ → ℝ`
(`x j` is the demand `X_j` of fare class `j`, classes numbered from `1`). It is the published
`NestedSeatAlloc.ProbCond.nestEvent` with the coordinate projections as random variables. -/
def fillEvent (θ : ℕ → ℝ) (i : ℕ) : Set (ℕ → ℝ) :=
  NestedSeatAlloc.ProbCond.nestEvent (fun j (x : ℕ → ℝ) => x j) θ i

/-- The partial sum `X_1 + ⋯ + X_i` of a demand vector (Assumption A3, p. 765). -/
def partialSum (x : ℕ → ℝ) (i : ℕ) : ℝ :=
  ∑ j ∈ Finset.Icc 1 i, x j

/-- The discount ratio `r_i = f_i / f_1` (p. 762). -/
noncomputable def ratio (f : ℕ → ℝ) (i : ℕ) : ℝ :=
  f i / f 1

/-- The law of one flight's demand vector: the classes are mutually independent and class `i` has
law `ν i` (§1, p. 762). -/
noncomputable def flightLaw (ν : ℕ → Measure ℝ) : Measure (ℕ → ℝ) :=
  Measure.infinitePi ν

/-- The law of the demand vectors of successive flights, which are independent and identically
distributed (p. 762–763). A sample path is `ω : ℕ → ℕ → ℝ`; `ω n` is the demand vector of the
paper's flight `n + 1`, i.e. `X^{n+1}`. -/
noncomputable def pathLaw (ν : ℕ → Measure ℝ) : Measure (ℕ → ℕ → ℝ) :=
  Measure.infinitePi (fun _ : ℕ => flightLaw ν)

/-- The adjustment `H_i(θ, X) = r_{i+1} − 1(A_i(θ, X))` for `i = 1, …, k` (p. 763); it is `0` for
the indices `i` outside `1, …, k`, which carry no protection level. -/
noncomputable def adj (f : ℕ → ℝ) (k : ℕ) (θ x : ℕ → ℝ) (i : ℕ) : ℝ :=
  if 1 ≤ i ∧ i ≤ k then ratio f (i + 1) - (fillEvent θ i).indicator (fun _ => (1 : ℝ)) x else 0

/-- The mean adjustment `h_i(θ) = r_{i+1} − P(A_i(θ, X))` (p. 763), for one flight's demand law. -/
noncomputable def meanAdj (f : ℕ → ℝ) (ν : ℕ → Measure ℝ) (θ : ℕ → ℝ) (i : ℕ) : ℝ :=
  ratio f (i + 1) - (flightLaw ν).real (fillEvent θ i)

/-- The interim protection level `p_i(θ) = max{θ_j : 1 ≤ j ≤ i}` of (7) (p. 764), for `i ≥ 1`
(at `i = 0` it returns `θ_1`, a value no statement reads). -/
noncomputable def interim (θ : ℕ → ℝ) (i : ℕ) : ℝ :=
  (Finset.Icc 1 (max i 1)).sup' (Finset.nonempty_Icc.mpr (le_max_right i 1)) θ

/-- The step size `γ_n = A / (n + B)` of Lemma 4 (p. 764), read at `n ≥ 1`. -/
noncomputable def stepSize (A B : ℝ) (n : ℕ) : ℝ :=
  A / ((n : ℝ) + B)

/-- The Robbins–Monro recursion (4) (p. 763), `θ^{n+1} = θ^n − γ_n H(θ^n, X^n)`, on the sample path
`ω`. Lean's `iterate f k γ θ₁ ω n` is the paper's `θ^{n+1}`: `iterate … 0 = θ₁` is the arbitrary
initial vector `θ^1`, and the step from `θ^{n+1}` to `θ^{n+2}` uses the step size `γ (n + 1)` and the
demand vector `ω n = X^{n+1}`. -/
noncomputable def iterate (f : ℕ → ℝ) (k : ℕ) (γ : ℕ → ℝ) (θ₁ : ℕ → ℝ) (ω : ℕ → ℕ → ℝ) :
    ℕ → ℕ → ℝ
  | 0 => θ₁
  | n + 1 => fun i => iterate f k γ θ₁ ω n i - γ (n + 1) * adj f k (iterate f k γ θ₁ ω n) (ω n) i

@[simp] theorem iterate_zero (f : ℕ → ℝ) (k : ℕ) (γ : ℕ → ℝ) (θ₁ : ℕ → ℝ) (ω : ℕ → ℕ → ℝ) :
    iterate f k γ θ₁ ω 0 = θ₁ := rfl

theorem iterate_succ (f : ℕ → ℝ) (k : ℕ) (γ : ℕ → ℝ) (θ₁ : ℕ → ℝ) (ω : ℕ → ℕ → ℝ) (n i : ℕ) :
    iterate f k γ θ₁ ω (n + 1) i =
      iterate f k γ θ₁ ω n i - γ (n + 1) * adj f k (iterate f k γ θ₁ ω n) (ω n) i := rfl

/-- The σ-field `F` of the demands of the flights observed before Lean's step `m`, i.e. generated
by `ω 0, …, ω (m − 1)` (the paper's `X^1, …, X^m`). Lean's `iterate … m` (the paper's `θ^{m+1}`) is
measurable with respect to it, and `ω m` is independent of it. -/
abbrev pastField (m : ℕ) : MeasurableSpace (ℕ → ℕ → ℝ) :=
  MeasurableSpace.comap (fun (ω : ℕ → ℕ → ℝ) (j : Fin m) => ω j) inferInstance

end AdaptiveProtection.Convergence


