variable (B D A H W : ℝ → ℝ)
theorem solution {R : Set ℝ} (hB : ContDiffOn ℝ ∞ B R) (hD : ContDiffOn ℝ ∞ D R)
    (hA : ContDiffOn ℝ ∞ A R) (hH : ContDiffOn ℝ ∞ H R) (hW : ContDiffOn ℝ ∞ W R) (i j : Fin 5) :
    ContDiffOn ℝ ∞ (esMetric B D A H W i j) (esDomain R) := by
  have b := cd_radial hB; have d := cd_radial hD; have a := cd_radial hA
  have h := cd_radial hH; have w := cd_radial hW; have u := cd_u R; have v := cd_v R
  have huv : ∀ x ∈ esDomain R, 4 * x 2 * (1 - x 2) ≠ 0 := fun x hx => by
    have := hx.2.1; have : 0 < 1 - x 2 := by linarith [hx.2.2]
    positivity
  fin_cases i <;> fin_cases j
  all_goals first
    | exact contDiffOn_const
    | exact b.neg.add (h.mul (w.pow 2))
    | exact (h.mul w |>.mul u).neg
    | exact (h.mul w |>.mul v).neg
    | exact d
    | exact a.div ((contDiffOn_const.mul u).mul v) huv
    | exact ((a.mul u).mul v).add (h.mul (u.pow 2))
    | exact ((h.sub a).mul u).mul v
    | exact ((a.mul u).mul v).add (h.mul (v.pow 2))
