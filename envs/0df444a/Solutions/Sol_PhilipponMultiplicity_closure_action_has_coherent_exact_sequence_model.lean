section

set_option autoImplicit false
noncomputable section

namespace PhilipponMultiplicity.ConnectedEuler

variable {L C B : Type*} [AddCommGroup L]

def twist (σ : Multiplicative L →* Equiv.Perm C) (l : L) (a : C) : C :=
  σ (Multiplicative.ofAdd l) a

@[simp] theorem twist_zero (σ : Multiplicative L →* Equiv.Perm C) (a : C) :
    twist σ 0 a = a := by
  simp [twist]

theorem twist_add (σ : Multiplicative L →* Equiv.Perm C) (l m : L) (a : C) :
    twist σ (l + m) a = twist σ l (twist σ m a) := by
  simp [twist, map_mul]

@[simp] theorem twist_neg_cancel (σ : Multiplicative L →* Equiv.Perm C) (l : L)
    (a : C) : twist σ l (twist σ (-l) a) = a := by
  rw [← twist_add, add_neg_cancel, twist_zero]

/-- Twists preserving all evaluations form an additive subgroup. -/
def invarianceSubgroup (σ : Multiplicative L →* Equiv.Perm C) (e : C → B) :
    AddSubgroup L where
  carrier := {l | ∀ a, e (twist σ l a) = e a}
  zero_mem' := by intro a; rw [twist_zero]
  add_mem' := by
    intro l m hl hm a
    rw [twist_add, hl, hm]
  neg_mem' := by
    intro l hl a
    have h := hl (twist σ (-l) a)
    rw [twist_neg_cancel] at h
    exact h.symm

/-- The same invariant twists form a submodule for any integer module structure. -/
def invarianceSubmodule [hM : Module ℤ L] (σ : Multiplicative L →* Equiv.Perm C)
    (e : C → B) : Submodule ℤ L :=
  { (invarianceSubgroup σ e).toAddSubmonoid with
    smul_mem' := by
      intro n l hl
      have hM_eq : hM = AddCommGroup.toIntModule L :=
        (AddCommGroup.uniqueIntModule (M := L)).uniq hM
      cases hM_eq
      exact (invarianceSubgroup σ e).zsmul_mem hl n }

/-- Invariance under a family of twists extends to their integer span. -/
theorem invariant_of_mem_span [Module ℤ L] (σ : Multiplicative L →* Equiv.Perm C) (e : C → B)
    (s : Set L) (hs : ∀ l ∈ s, ∀ a, e (twist σ l a) = e a)
    (l : L) (hl : l ∈ Submodule.span ℤ s) : ∀ a, e (twist σ l a) = e a := by
  exact (Submodule.span_le.mpr hs :
    Submodule.span ℤ s ≤ invarianceSubmodule σ e) hl

/-- Compare two fibers after twisting the test object by the inverse first fiber. -/
theorem family_difference_invariant (σ : Multiplicative L →* Equiv.Perm C)
    (e : C → B) {X : Type*} [TopologicalSpace X] [PreconnectedSpace X]
    (p : X → L) (hlocal : ∀ a, IsLocallyConstant (fun x => e (twist σ (p x) a)))
    (s t : X) (a : C) : e (twist σ (p t - p s) a) = e a := by
  have h := (hlocal (twist σ (-p s) a)).apply_eq_of_preconnectedSpace t s
  simpa only [sub_eq_add_neg, twist_add, twist_neg_cancel] using h

/-- A kernel generated by connected-family differences acts trivially on evaluations. -/
theorem kernel_invariant_of_families [Module ℤ L]
    (σ : Multiplicative L →* Equiv.Perm C) (e : C → B)
    {A : Type*} [AddCommGroup A] [Module ℤ A] (q : L →ₗ[ℤ] A)
    {ι : Type*} (X : ι → Type*) (top : ∀ i, TopologicalSpace (X i))
    (s t : ∀ i, X i) (p : ∀ i, X i → L)
    (hconn : ∀ i, @ConnectedSpace (X i) (top i))
    (hlocal : ∀ i a, @IsLocallyConstant (X i) B (top i)
      (fun x => e (twist σ (p i x) a)))
    (hspan : LinearMap.ker q ≤ Submodule.span ℤ (Set.range (fun i => p i (t i) - p i (s i))))
    (l : L) (hl : q l = 0) : ∀ a, e (twist σ l a) = e a := by
  apply invariant_of_mem_span σ e _ ?_ l (hspan hl)
  rintro m ⟨i, rfl⟩ a
  let : TopologicalSpace (X i) := top i
  let : ConnectedSpace (X i) := hconn i
  exact family_difference_invariant σ e (p i) (hlocal i) (s i) (t i) a

end PhilipponMultiplicity.ConnectedEuler
