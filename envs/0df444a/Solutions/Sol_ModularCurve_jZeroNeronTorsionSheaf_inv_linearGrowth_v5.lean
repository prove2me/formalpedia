theorem le_of_pow_le_pow {q a b : ℕ} (hq : 1 < q) (h : q ^ a ≤ q ^ b) : a ≤ b := by
  by_contra hc
  push Not at hc
  exact absurd h (not_le.mpr (Nat.pow_lt_pow_right hq hc))

theorem slope_le {q a b c : ℕ} (hq : 1 < q) (h : ∀ m : ℕ, q ^ (m * a) ≤ q ^ (m * b + c)) : a ≤ b := by
  by_contra hc
  push Not at hc
  have h1 := le_of_pow_le_pow hq (h (c + 1))

  have : (c + 1) * (b + 1) ≤ (c + 1) * a := Nat.mul_le_mul_left _ hc
  nlinarith

theorem core (q : ℕ) (hq : 1 < q)
    (J T L δ α : ℕ → ℕ)
    (hδ : ∀ m, J m = q ^ δ m * T m)
    (e C1 : ℕ) (hJ : ∀ m, J m ≤ q ^ (m * e + C1) ∧ q ^ (m * e) ≤ J m * q ^ C1)
    (eT C2 : ℕ) (hT : ∀ m, T m ≤ q ^ (m * eT + C2) ∧ q ^ (m * eT) ≤ T m * q ^ C2)
    (e0 C0 : ℕ) (hL : ∀ m, L m ≤ q ^ (m * e0 + C0) ∧ q ^ (m * e0) ≤ L m * q ^ C0)
    (C5 : ℕ) (hW2 : ∀ m, J m ≤ L m ^ 2 * q ^ C5)
    (C3 : ℕ) (hC5 : ∀ m, J m ≤ T m ^ 2 * q ^ C3)
    (C4 : ℕ) (hα : ∀ m, L m ≤ q ^ (α m) * q ^ C4)
    (hTJ : ∀ m, T m ≤ J m) :
    ∃ g : ℕ, ∃ C : ℤ, ∀ m : ℕ,
      (δ m : ℤ) ≤ (m : ℤ) * (g : ℤ) + C ∧ (m : ℤ) * (g : ℤ) ≤ (α m : ℤ) + C := by
  have hq0 : 0 < q := by omega
  have hpow_pos : ∀ k, 0 < q ^ k := fun k => pow_pos hq0 k

  have h1 : eT ≤ e := by
    refine slope_le (c := C1 + C2) hq fun m => ?_
    calc q ^ (m * eT) ≤ T m * q ^ C2 := (hT m).2
      _ ≤ J m * q ^ C2 := Nat.mul_le_mul_right _ (hTJ m)
      _ ≤ q ^ (m * e + C1) * q ^ C2 := Nat.mul_le_mul_right _ (hJ m).1
      _ = q ^ (m * e + (C1 + C2)) := by rw [← pow_add]; ring_nf

  have h2 : e ≤ 2 * e0 := by
    refine slope_le (c := 2 * C0 + C5 + C1) hq fun m => ?_
    calc q ^ (m * e) ≤ J m * q ^ C1 := (hJ m).2
      _ ≤ L m ^ 2 * q ^ C5 * q ^ C1 := Nat.mul_le_mul_right _ (hW2 m)
      _ ≤ (q ^ (m * e0 + C0)) ^ 2 * q ^ C5 * q ^ C1 :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.pow_le_pow_left (hL m).1 2))
      _ = q ^ (m * (2 * e0) + (2 * C0 + C5 + C1)) := by rw [← pow_mul, ← pow_add, ← pow_add]; ring_nf

  have h3 : e ≤ 2 * eT := by
    refine slope_le (c := 2 * C2 + C3 + C1) hq fun m => ?_
    calc q ^ (m * e) ≤ J m * q ^ C1 := (hJ m).2
      _ ≤ T m ^ 2 * q ^ C3 * q ^ C1 := Nat.mul_le_mul_right _ (hC5 m)
      _ ≤ (q ^ (m * eT + C2)) ^ 2 * q ^ C3 * q ^ C1 :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.pow_le_pow_left (hT m).1 2))
      _ = q ^ (m * (2 * eT) + (2 * C2 + C3 + C1)) := by rw [← pow_mul, ← pow_add, ← pow_add]; ring_nf
  refine ⟨e - eT, (C1 + C2 + C4 + C0 : ℕ), fun m => ⟨?_, ?_⟩⟩
  ·
    have key : q ^ (δ m + m * eT) ≤ q ^ (m * e + (C1 + C2)) := by
      calc q ^ (δ m + m * eT) = q ^ δ m * q ^ (m * eT) := pow_add _ _ _
        _ ≤ q ^ δ m * (T m * q ^ C2) := Nat.mul_le_mul_left _ (hT m).2
        _ = J m * q ^ C2 := by rw [hδ m]; ring
        _ ≤ q ^ (m * e + C1) * q ^ C2 := Nat.mul_le_mul_right _ (hJ m).1
        _ = q ^ (m * e + (C1 + C2)) := by rw [← pow_add]; ring_nf
    have k2 := le_of_pow_le_pow hq key
    have k3 : m * eT ≤ m * e := Nat.mul_le_mul_left _ h1
    have k4 : (((e - eT : ℕ) : ℤ)) = (e : ℤ) - (eT : ℤ) := by push_cast [Nat.cast_sub h1]; ring
    rw [k4]
    push_cast
    have : (δ m : ℤ) + (m : ℤ) * eT ≤ (m : ℤ) * e + (C1 + C2) := by exact_mod_cast k2
    nlinarith
  ·
    have key : q ^ (m * e0) ≤ q ^ (α m + (C4 + C0)) := by
      calc q ^ (m * e0) ≤ L m * q ^ C0 := (hL m).2
        _ ≤ q ^ (α m) * q ^ C4 * q ^ C0 := Nat.mul_le_mul_right _ (hα m)
        _ = q ^ (α m + (C4 + C0)) := by rw [← pow_add, ← pow_add]; ring_nf
    have k2 := le_of_pow_le_pow hq key
    have hg : e - eT ≤ e0 := by omega
    have k3 : m * (e - eT) ≤ m * e0 := Nat.mul_le_mul_left _ hg
    have : (m : ℤ) * ((e - eT : ℕ) : ℤ) ≤ (α m : ℤ) + (C4 + C0) := by exact_mod_cast k3.trans k2
    push_cast at this ⊢
    linarith

end P2MHybrid

