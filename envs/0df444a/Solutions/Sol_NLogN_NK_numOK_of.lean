    rw [e3] at h1
    have : |r - 2 ^ k| ≤ ((2 ^ k : ℕ) : ℤ) := by
      rw [hc, abs_le]; constructor <;> linarith
    rw [Int.abs_eq_natAbs] at this
    exact_mod_cast this

