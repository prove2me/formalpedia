/-- The function field is formally smooth over the polynomial algebra of the retained parameters,
with its actual evaluation map. -/
lemma formallySmooth_parameter_evaluation
    (K F : Type u) [Field K] [Field F] [Algebra K F]
    (S T : Finset F) (x : S)
    (hb : IsTranscendenceBasis K ((↑) : S → F))
    (hT : (T : Set F) = (S : Set F) \ {x.val})
    [Algebra.IsSeparable (IntermediateField.adjoin K (S : Set F)) F] :
    letI : Algebra (MvPolynomial T K) F :=
      (MvPolynomial.aeval (R := K) ((↑) : T → F)).toRingHom.toAlgebra
    Algebra.FormallySmooth (MvPolynomial T K) F := by
  classical
  let R := MvPolynomial T K
  letI : Algebra R F := (MvPolynomial.aeval (R := K) ((↑) : T → F)).toRingHom.toAlgebra
  let L := IntermediateField.adjoin K (T : Set F)
  have hTS : (T : Set F) ⊆ S := by rw [hT]; exact Set.diff_subset
  let j : T → S := fun z => ⟨z.val, hTS z.property⟩
  have hj : Function.Injective j := by
    intro z w h
    apply Subtype.ext
    exact congrArg (fun y : S => y.val) h
  have hTind : AlgebraicIndependent K ((↑) : T → F) := hb.1.comp j hj
  have hrange : Set.range ((↑) : T → F) = (T : Set F) := by ext y; simp
  let e : FractionRing R ≃ₐ[K] L := hTind.aevalEquivField.trans
    (IntermediateField.equivOfEq (congrArg (IntermediateField.adjoin K) hrange))
  letI : Algebra R L := (e.toRingHom.comp (algebraMap R (FractionRing R))).toAlgebra
  let eR : FractionRing R ≃ₐ[R] L :=
    { e.toRingEquiv with commutes' := fun _ => rfl }
  letI : IsFractionRing R L := IsFractionRing.of_algEquiv eR
  have he : ∀ p : R, (algebraMap L F) (algebraMap R L p) = algebraMap R F p := by
    intro p
    change (hTind.aevalEquivField (algebraMap R (FractionRing R) p) : F) =
      MvPolynomial.aeval ((↑) : T → F) p
    exact hTind.aevalEquivField_algebraMap_apply_coe p
  letI : IsScalarTower R L F := IsScalarTower.of_algebraMap_eq (fun p => (he p).symm)
  letI : Algebra.FormallySmooth R L := Algebra.FormallySmooth.of_isLocalization (nonZeroDivisors R)
  letI : Algebra.FormallySmooth L F := formallySmooth_of_one_parameter_basis K F S T x hb hT
  exact Algebra.FormallySmooth.comp R L F

end PhilipponAlterationProjection



