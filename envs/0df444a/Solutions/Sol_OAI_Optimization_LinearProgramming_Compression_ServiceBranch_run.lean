    (hH : 3 ≤ H) :
    ∃ t, (Fragment.ofBlock (mark accepted)).Run (fun q => ratBits q ≤ H) s 2 t ∧
      tag t=(if accepted then 0 else 1) ∧ t.index=s.index ∧
