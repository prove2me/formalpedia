  · have hi' : 𝔛.ξinf A hA ρ hρ ρ (IsLocalRing.residue ↥A) rfl ∈ bcOA ⁻¹ᵁ V := by
      show bcOA.base _ ∈ V; rw [← hξi]; exact hi
    obtain ⟨h₁, ⟨hg₀', hres⟩, hunit⟩ := key.1 hi'
    have hg₀ : genericPoint (𝔛.Mfib A hA ρ hρ).C ∈ (𝔛.efib A hA ρ hρ ≫ 𝔛.comp A hA ρ hρ 0 ≫ bcMap (ΓM M H) hj ρO toκ htoκ) ⁻¹ᵁ V := by
      rw [E20]; exact hg₀'
    refine ⟨h₁, ⟨hg₀, hres.trans (congrArg _ (germ_app_congr_aux E20.symm V _ hg₀' hg₀ g))⟩, fun hu => hunit ?_⟩
    have hu' := (isUnit_germ_congr_aux V hξi hi hi' g hu).map (bcOA.stalkMap _).hom
