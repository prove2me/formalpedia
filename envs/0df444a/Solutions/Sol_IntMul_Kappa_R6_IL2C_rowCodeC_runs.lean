  have st4 : t4.G kST = .int ((l.QC * l.sU : ℕ) : ℤ) :: t3.G kST := by
    rw [T4 kST (.mul (.reg kQC) eSU) (by simp [hdrC]), eST3.ev]
  have k24 : t4.G kK2 = .int ((2 ^ K : ℕ) : ℤ) :: t3.G kK2 := by
