theorem dropN_runs (X : Fin HS) (hX : NC X) (L : List ℤ) (B : ℕ)
    (hB : ∀ x ∈ L, zsz x ≤ B) (s : IState HS) (RX : List Item) (h0 : s.G X = ints L ++ RX) :
    IRuns I iprog (rpt pA pC pD L.length (.op (.drop X))) s (s.upd X RX)
