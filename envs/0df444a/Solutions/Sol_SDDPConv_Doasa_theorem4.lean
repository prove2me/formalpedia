/-- Finite linear-inequality KKT, proved by separating the active-normal cone. -/
theorem finite_kkt {ι E : Type*} [Fintype ι]
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [FiniteDimensional ℝ E]
    (a : ι → E) (b : ι → ℝ) (c x : E)
    (hx : ∀ i, inner ℝ (a i) x ≤ b i)
    (hopt : ∀ y : E, (∀ i, inner ℝ (a i) y ≤ b i) →
      inner ℝ c x ≤ inner ℝ c y) :
    ∃ lam : ι → ℝ, (∀ i, 0 ≤ lam i) ∧
      c + ∑ i, lam i • a i = 0 ∧
      ∀ i, lam i * (b i - inner ℝ (a i) x) = 0 := by
  classical
  let s : Finset ι := Finset.univ.filter (fun i => inner ℝ (a i) x = b i)
  let C : ProperCone ℝ E :=
    { carrier := {z | ∃ w : s → ℝ, (∀ i, 0 ≤ w i) ∧ ∑ i, w i • a i = z}
      zero_mem' := ⟨0, by simp, by simp⟩
      add_mem' := by
        rintro z z' ⟨w, hw, rfl⟩ ⟨w', hw', rfl⟩
        exact ⟨w + w', fun i => add_nonneg (hw i) (hw' i), by
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]⟩
      smul_mem' := by
        rintro r z ⟨w, hw, rfl⟩
        refine ⟨fun i => (r : ℝ) * w i, fun i => mul_nonneg r.2 (hw i), ?_⟩
        simp only [mul_smul, ← Finset.smul_sum]
        rfl
      isClosed' := finite_cone_isClosed (fun i : s => a i) }
  have hc : -c ∈ C := by
    by_contra hn
    obtain ⟨y, hy, hcy⟩ := C.hyperplane_separation' hn
    have hactive (i : ι) (hi : inner ℝ (a i) x = b i) :
        inner ℝ (a i) (-y) ≤ 0 := by
      have his : i ∈ s := by simp [s, hi]
      have hai : a i ∈ C := by
        refine ⟨Pi.single ⟨i, his⟩ 1, ?_, ?_⟩
        · intro j
          simp only [Pi.single_apply]
          split_ifs <;> norm_num
        · change Fintype.linearCombination ℝ (fun j : s => a j) (Pi.single ⟨i, his⟩ 1) = a i
          rw [Fintype.linearCombination_apply_single, one_smul]
      simpa only [inner_neg_right] using neg_nonpos.mpr (hy (a i) hai)
    obtain ⟨e, he, hfeas⟩ := finite_feasible_step
      (fun i => innerₗ E (a i)) b x (-y) hx hactive
    have ho := hopt (x + e • (-y)) (hfeas e he.le le_rfl)
    have hncy : inner ℝ c (-y) < 0 := by
      simpa only [inner_neg_left, inner_neg_right] using hcy
    have hneg := mul_neg_of_pos_of_neg he hncy
    rw [inner_add_right, inner_smul_right] at ho
    linarith
  obtain ⟨w, hw, hsum⟩ := hc
  let lam : ι → ℝ := fun i => if hi : i ∈ s then w ⟨i, hi⟩ else 0
  have hsum' : (∑ i, lam i • a i) = -c := by
    calc
      (∑ i, lam i • a i) = ∑ i ∈ s, lam i • a i := by
        symm
        exact Finset.sum_subset (Finset.subset_univ _) (fun i _ hi => by simp [lam, hi])
      _ = ∑ i : s, w i • a i := by
        rw [← Finset.sum_coe_sort]
        apply Finset.sum_congr rfl
        intro i _
        simp [lam, i.2]
      _ = -c := hsum
  refine ⟨lam, ?_, by rw [hsum']; exact add_neg_cancel c, ?_⟩
  · intro i
    dsimp [lam]
    split_ifs with hi
    · exact hw ⟨i, hi⟩
    · exact le_rfl
  · intro i
    by_cases hi : i ∈ s
    · have heq := (Finset.mem_filter.mp hi).2
      rw [heq, sub_self, mul_zero]
    · simp [lam, hi]

end DOASAProof

