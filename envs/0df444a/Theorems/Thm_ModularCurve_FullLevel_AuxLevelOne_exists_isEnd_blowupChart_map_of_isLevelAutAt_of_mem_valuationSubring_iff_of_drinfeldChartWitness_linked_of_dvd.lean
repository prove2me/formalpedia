          ∀ f : ↥K, f ∈ W ↔ τ f ∈ W))
    (O : Subring ↥K)
    (hO : ∃ (a : ↥(chartAlgFin A (↥K) j)) (_ : a ∈ J) (_ : ((a : ↥(chartAlgFin A (↥K) j)) : ↥K) ≠ 0),
