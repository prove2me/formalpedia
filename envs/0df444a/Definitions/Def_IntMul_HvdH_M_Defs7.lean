/-- The `E` weight table builder: pushes `ints (eTab p s t α).flatten` on `BW`
(needs `TRI = 2m+1`, `TS = s` and the scalar parameters). -/
def eTabBP : RS := tabP NLogN.Rsp.BW TCI TCK TRI TS eWP

end NLogN.Rsp

