    have hβunit : IsUnit β := by
      have hmul : ρ.ρ σ * ρ.ρ σ⁻¹ = 1 := by
        rw [← ρ.ρ.map_mul, mul_inv_cancel, map_one]
      have hff' : ∀ x : ρ.V, ρ.ρ σ (ρ.ρ σ⁻¹ x) = x := fun x => by
        rw [← Module.End.mul_apply, hmul, Module.End.one_apply]
      have h1 : π (b 1) = β * π (ρ.ρ σ⁻¹ (b 1)) := by
        conv_lhs => rw [← hff' (b 1)]
        exact hπf _
      rw [hπb1] at h1
      exact IsUnit.of_mul_eq_one (π (ρ.ρ σ⁻¹ (b 1))) h1.symm

    have hα₀' : algebraMap O' O'' α₀ * algebraMap O' O'' α₀ - t' * algebraMap O' O'' α₀
        + (lam : O'') = 0 := by
      have h := congrArg (algebraMap O' O'') hα₀eq
      rwa [map_add, map_sub, map_mul, map_mul, map_natCast, map_zero] at h
    have hβα : β = algebraMap O' O'' α₀ := by
      by_contra hne
      have hsum : β + algebraMap O' O'' α₀ = t' := by
        have hprod : (β - algebraMap O' O'' α₀) * (β + algebraMap O' O'' α₀ - t') = 0 := by
