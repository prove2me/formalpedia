theorem solution {R : ℝ} (hR : 3 ≤ R) : Y R = 1 + T Y R := by
  -- `SN (N+1) R → Y R`
  have hSN : Tendsto (fun N => SN (N + 1) R) atTop (𝓝 (Y R)) := by
    have hbound : ∀ N, |Y R - SN (N + 1) R| ≤ tail (N + 1) R :=
      fun N => abs_Y_sub_SN_le hR le_rfl
    have htail : Tendsto (fun N => tail (N + 1) R) atTop (𝓝 0) :=
      (tail_tendsto R).comp (tendsto_add_atTop_nat 1)
    have hnorm : Tendsto (fun N => |Y R - SN (N + 1) R|) atTop (𝓝 0) :=
      tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds htail
        (fun N => abs_nonneg _) hbound
    rw [tendsto_iff_norm_sub_tendsto_zero] at hnorm ⊢
    simpa [Real.norm_eq_abs, abs_sub_comm] using hnorm
  have hT : Tendsto (fun N => T (SN N) R) atTop (𝓝 (T Y R)) := T_SN_tendsto hR
  -- `T (SN N) R = SN (N+1) R - 1`
  have hEq : ∀ N, T (SN N) R = SN (N + 1) R - 1 := fun N => T_partial N hR
  have hT' : Tendsto (fun N => SN (N + 1) R - 1) atTop (𝓝 (T Y R)) := by
    have := hT
    refine this.congr (fun N => ?_)
    exact hEq N
  have hlim : Tendsto (fun N => SN (N + 1) R - 1) atTop (𝓝 (Y R - 1)) :=
    hSN.sub tendsto_const_nhds
  have := tendsto_nhds_unique hT' hlim
  linarith
