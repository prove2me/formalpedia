  have h_sat := List.mem_takeWhile_imp (List.getElem_mem (l := l.takeWhile p) hi)
  rw [h_pfx.getElem hi] at h_sat
  simp only [l, List.getElem_range] at h_sat
  simpa [p] using h_sat

private theorem topStaircase_stop {S : Finset Nat} (hne : S.Nonempty)
