theorem safeWrite {P : K → Prop} {m : Memory K} {i : ℕ} {x : K} (hm : Good P m) (hx : P x) :
    Good P (m.putData i x) := by
  intro j
  by_cases h : j=i
  · simpa [h] using hx
  · simpa [h] using hm j

