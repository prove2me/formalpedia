-- Source module: NLogN.HReg
/-!
# Register programs

`RS` is a small structured language over the register stacks `0 … 55`: assignments of
expressions, pushes and pops, conditionals and counted loops.  `RS.run` is its functional
semantics on `IState`s, and `RS.code_runs` shows that the compiled `IStmt` realises it with cost
`RS.cost`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

namespace RS

/-! ## Frame -/

/-! ## Compilation -/

/-! ## Sequences and reasoning lemmas -/

theorem repSt_ip_out (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (k : ℕ) :
    (repSt i n b s k).ip = s.ip ∧ (repSt i n b s k).out = s.out := by
  have := iter_ip (fun t => decSt i (b.run t))
    (fun t => by simp only [decSt, IState.upd_ip, IState.upd_out]; exact run_ip_out b t)
    k (s.upd i (.int (n.eval s) :: s.G i))
  simpa [repSt] using this

/-! ## Cost bounds -/

@[simp] theorem run_asg_G (i : Fin HS) (e : Ex HS) (s : IState HS) (j : Fin HS) :
    ((asg i e).run s).G j = if j = i then .int (e.eval s) :: (s.G i).tail else s.G j := by
  simp [run, IState.upd_G]

/-- Invariant reasoning for counted loops. -/
theorem repSt_inv (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (Inv : ℕ → IState HS → Prop)
    (h0 : Inv 0 (s.upd i (.int (n.eval s) :: s.G i)))
    (hs : ∀ k < (n.eval s).toNat, Inv k (repSt i n b s k) →
      Inv (k + 1) (decSt i (b.run (repSt i n b s k)))) :
    ∀ k ≤ (n.eval s).toNat, Inv k (repSt i n b s k) := by
  intro k; induction k with
  | zero => intro _; exact h0
  | succ k ih =>
    intro hk
    have := hs k (by omega) (ih (by omega))
    simpa [repSt, Function.iterate_succ_apply'] using this

@[simp] theorem decSt_G (i : Fin HS) (t : IState HS) (j : Fin HS) :
    (decSt i t).G j = if j = i then .int (t.top i - 1) :: (t.G i).tail else t.G j := by
  simp [decSt, IState.upd_G]

end RS

end NLogN

