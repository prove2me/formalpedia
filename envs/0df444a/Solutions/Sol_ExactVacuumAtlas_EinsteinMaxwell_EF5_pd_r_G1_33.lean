variable (mu beta : ℝ)
theorem solution {x : Pt 5} (hx : x ∈ domU5) :
    pd 1 (christoffel (gEF5 mu beta) (giEF5 mu beta) 1 3 3) x =
    -(1 + mu / x 1 ^ 2 - 3 * beta / x 1 ^ 4) * x 2 := by
  have hr := domU5_r hx
  rw [pd_congr_of_eqOn isOpen_domU5 hx (eqOn_G1_33 mu beta), pd]
  have hslice : (fun t : ℝ =>
      -(1 - mu / (Function.update x 1 t) 1 ^ 2 + beta / (Function.update x 1 t) 1 ^ 4) *
        (Function.update x 1 t) 1 * (Function.update x 1 t) 2)
    = fun t => -((1 - mu / t ^ 2 + beta / t ^ 4) * t) * x 2 := by
    funext t
    have ha : (Function.update x 1 t) 1 = t := by simp [Function.update_apply]
    have hb : (Function.update x 1 t) 2 = x 2 := by
      simp [Function.update_apply, show (1:Fin 5) ≠ 2 from by decide]
    rw [ha, hb]; ring
  rw [hslice]
  have hd2 : HasDerivAt (fun t : ℝ => mu / t ^ 2) (-2 * mu / x 1 ^ 3) (x 1) :=
    ((hasDerivAt_const (x 1) mu).fun_div ((hasDerivAt_id' (x 1)).fun_pow 2) (pow_ne_zero 2 hr)).congr_deriv
      (by field_simp; ring)
  have hd3 : HasDerivAt (fun t : ℝ => beta / t ^ 4) (-4 * beta / x 1 ^ 5) (x 1) :=
    ((hasDerivAt_const (x 1) beta).fun_div ((hasDerivAt_id' (x 1)).fun_pow 4) (pow_ne_zero 4 hr)).congr_deriv
      (by field_simp; ring)
  have hf : HasDerivAt (fun t : ℝ => 1 - mu / t ^ 2 + beta / t ^ 4)
      (2 * mu / x 1 ^ 3 - 4 * beta / x 1 ^ 5) (x 1) :=
    ((hasDerivAt_const (x 1) (1:ℝ)).sub hd2).add hd3 |>.congr_deriv (by ring)
  have hprod : HasDerivAt (fun t : ℝ => (1 - mu / t ^ 2 + beta / t ^ 4) * t)
      (1 + mu / x 1 ^ 2 - 3 * beta / x 1 ^ 4) (x 1) :=
    (hf.mul (hasDerivAt_id' (x 1))).congr_deriv (by field_simp; ring)
  exact (hprod.neg.mul_const (x 2)).congr_deriv (by ring) |>.deriv
