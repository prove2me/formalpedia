    have h := hzd1 hpos s hs
    rw [hV, Complex.ofReal_one, inv_one, one_mul] at h
    rw [h, hω1, hχTdef,
      LanglandsTunnell.CubicInduction.DualEulerMatch.inducedEulerPoly_inv_inducedCoeff_mul_comp_idelicNorm_eq_one μ χ
        v (LanglandsTunnell.CubicInduction.BadPlaceBridges.isUnramifiedCharAt_of_not_isBadPlace K μ v hbad)
        (LanglandsTunnell.CubicInduction.BadPlaceBridges.ramificationIdx_under_eq_one_of_not_isBadPlace K μ v hbad)
        (NumberField.TateGlobal.continuous_localChar χ hχc v) hram,
      Polynomial.eval_one, inv_one, Nat.cast_mul, Nat.cast_ofNat]
    ring

private theorem lside_dual
    (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    {uR : ∀ w : InfinitePlace K, w.IsReal → ℂ} {aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2}
    {uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ} {kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ}
    (D : LDatum (HeightOneSpectrum (𝓞 K))) (hDdef : D = LanglandsTunnell.HeckeTate.heckeDatum K χT uR aR uC kC)
    (hconv : D.Converges) (Λd : ℂ → ℂ)
    (hEulD : ∀ s : ℂ, D.abscissa < s.re → Λd s = 1 * D.archFactorDual s * D.LFunDual s) :
    ∀ s : ℂ, (1 : ℝ) < s.re →
    HasProd (fun v : HeightOneSpectrum (𝓞 ℚ) =>
      ((inducedEulerPoly ℚ (fun 𝔓 => (inducedCoeff K χT 𝔓)⁻¹) v).eval
        ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹) (D.LFunDual s) ∧
    Λd s = D.archFactorDual s * D.LFunDual s := by
  intro s hs
  have hs' : D.abscissa < s.re := by
    rw [hDdef]
    exact hs
  refine ⟨?_, by simpa only [one_mul] using hEulD s hs'⟩
  have hnorm : ∀ 𝔓 : HeightOneSpectrum (𝓞 K), (D.norm 𝔓 : ℂ) = ((Ideal.absNorm 𝔓.asIdeal : ℕ) : ℂ) := by
    intro 𝔓
    rw [hDdef]
    rfl
  have hfun : (fun 𝔓 : HeightOneSpectrum (𝓞 K) => ((D.dual 𝔓).eval ((D.norm 𝔓 : ℂ) ^ (-s)))⁻¹) =
      fun 𝔓 : HeightOneSpectrum (𝓞 K) =>
        (1 - (inducedCoeff K χT 𝔓)⁻¹ * ((Ideal.absNorm 𝔓.asIdeal : ℕ) : ℂ) ^ (-s))⁻¹ := by
    funext 𝔓
    rw [hnorm, hDdef, DualEulerMatch.eval_dual_heckeDatum]
  have hK := EulerHasProd.hasProd_inv_eval_dual_lFunDual D hconv hs'
  rw [hfun] at hK
  exact RankinSelberg.hasProd_inv_eval_inducedEulerPoly_of_hasProd ℚ K (fun 𝔓 => (inducedCoeff K χT 𝔓)⁻¹) s
    (D.LFunDual s) hK

