variable {O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ} (F : O.NeronExtension)

theorem ptsN_coe (x : JZero (N₀ * p)) : (F.ptsN x).1 = (Λ.shGenLift (O.pts x)).1 ≫ F.openImm.1 := rfl

private theorem _root_.ModularCurve.JZeroNeronObjectAtP.NeronExtension.ptsN_add (x y : JZero (N₀ * p)) :
    F.ptsN (x + y) = F.LN.mul (barPt A ≫ shPt A) (F.ptsN x) (F.ptsN y) := by
  change NeronModelInfra.schemeHomOverComp (Λ.shGenLift (O.pts (x + y))) F.openImm = _
  rw [O.pts_add, Λ.shGenLift_mul, F.openImm_mul]

p2m_export "ModularCurve.JZeroNeronObjectAtP.NeronExtension" "ptsN_add"

theorem extN_iff (x : JZero (N₀ * p)) :
    F.ExtN x ↔ ∃ s : SchemeHomOver (shPt A) F.gN,
      F.ptsN x = GoodReductionJacobian.schemeHomOverComp (barPt A) rfl s :=
  ⟨fun ⟨s, hs⟩ => ⟨s, Subtype.ext hs⟩, fun ⟨s, hs⟩ => ⟨s, congrArg Subtype.val hs⟩⟩

theorem ptsN_zero : F.ptsN 0 = F.LN.one (barPt A ≫ shPt A) := by
  apply law_eq_one_of_mul_self
  rw [← F.ptsN_add, add_zero]

theorem ptsN_neg (x : JZero (N₀ * p)) : F.ptsN (-x) = F.LN.inv (barPt A ≫ shPt A) (F.ptsN x) := by
  apply law_eq_inv_of_mul_eq_one
  rw [← F.ptsN_add, add_neg_cancel, ptsN_zero]

private def _root_.ModularCurve.JZeroNeronObjectAtP.NeronExtension.extPts : AddSubgroup (JZero (N₀ * p)) where
  carrier := {x | F.ExtN x}
  zero_mem' := by
    change F.ExtN 0
    rw [extN_iff]
    exact ⟨F.LN.one (shPt A), by rw [ptsN_zero, F.LN.one_natural]⟩
  add_mem' := by
    intro x y hx hy
    change F.ExtN _ at hx hy ⊢
    rw [extN_iff] at hx hy ⊢
    obtain ⟨s, hs⟩ := hx
    obtain ⟨s', hs'⟩ := hy
    exact ⟨F.LN.mul (shPt A) s s', by rw [F.ptsN_add, hs, hs', F.LN.mul_natural]⟩
  neg_mem' := by
    intro x hx
    change F.ExtN _ at hx ⊢
    rw [extN_iff] at hx ⊢
    obtain ⟨s, hs⟩ := hx
    exact ⟨F.LN.inv (shPt A) s, by rw [ptsN_neg, hs, law_inv_natural]⟩

