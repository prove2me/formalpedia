lemma gsw_append (a b : List GI) : gsw (a ++ b) = gsw a ++ gsw b := by simp [gsw]

lemma gflat_reverse (u : List GI) : (gflat u).reverse = gsw u.reverse := by
  induction u with
  | nil => rfl
  | cons z u ih => simp [ih, gsw_append]

