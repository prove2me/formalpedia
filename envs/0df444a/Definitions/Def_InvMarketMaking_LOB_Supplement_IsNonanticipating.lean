-- title:
--   The algorithms of the lower bound: prices from private randomness and past valuations
-- statement:
--   A pair of price processes $(B_t,A_t)_{t\in[T]}$ is **non-anticipating** when $0\le B_t<A_t\le1$ for every $t$, and some σ-algebra $\mathcal G$ exists with the following properties. It represents the algorithm's internal randomness and is independent of the whole valuation sequence. Each $B_t$ and $A_t$ is measurable with respect to
--   $$
--   \mathcal G\vee\sigma\big((V^{\mathrm{sell}}_s,V^{\mathrm{buy}}_s):1\le s<t\big).
--   $$
--   So the prices of round $t$ may depend on private randomness and on all past valuations, and may use full knowledge of $F$ and $S$, but never on round $t$'s valuations.
--
--   This is the class of algorithms in the lower bound of Theorem 6.20. It contains every algorithm of the paper under two-bit, limit-order-book or full feedback (p. 50: "stronger even than full feedback").
-- source:
--   Maran, Restelli, Stradi, No-Regret Revenue Maximization in Sequential Market Making Under Inventory Constraints, arXiv:2610.24562v1, Sec. 3, p. 14; Sec. 6.4, pp. 50–54

import Mathlib
import Definitions.Def_InvMarketMaking_LOB_IsRoundModel

namespace InvMarketMaking.LOB.Supplement

open MeasureTheory ProbabilityTheory

/-- The σ-algebra generated by all the valuation pairs `(V^sell_s, V^buy_s)`, `s ∈ ℕ`. -/
@[instance_reducible]
noncomputable def valSigma {Ω : Type*} (M : Market Ω) : MeasurableSpace Ω :=
  ⨆ s, MeasurableSpace.comap (fun ω => (M.Vs s ω, M.Vb s ω)) inferInstance

/-- The σ-algebra generated by the valuation pairs of the rounds `1, …, t − 1` before round `t`. -/
@[instance_reducible]
noncomputable def pastSigma {Ω : Type*} (M : Market Ω) (t : ℕ) : MeasurableSpace Ω :=
  ⨆ s ∈ Finset.Ico 1 t, MeasurableSpace.comap (fun ω => (M.Vs s ω, M.Vb s ω)) inferInstance

/-- The class of algorithms of Theorem 6.20 (Maran, Restelli, Stradi, No-Regret Revenue Maximization
in Sequential Market Making Under Inventory Constraints, arXiv:2610.24562v1, Sec. 6.4, pp. 50–54):
the posted prices `(B_t, A_t)`, `t ∈ [T]`, satisfy `0 ≤ B_t < A_t ≤ 1` (Sec. 3, p. 14) and are chosen
before round `t`'s valuations are drawn, from the algorithm's own randomness and everything that
happened before: there is a σ-algebra `𝒢 ⊆ ℱ` (the internal randomness), independent of the whole
valuation sequence, such that `B_t` and `A_t` are measurable for `𝒢 ⊔ σ((V^sell_s, V^buy_s) : s < t)`.

**Formalization Note** The algorithm may use the full past valuations and may know `F` and `S`
(p. 50: "stronger even than full feedback"); every feedback model of the paper is a special case. -/
def IsNonanticipating {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) (M : Market Ω)
    (bid ask : ℕ → Ω → ℝ) (T : ℕ) : Prop :=
  ∃ 𝒢 : MeasurableSpace Ω, 𝒢 ≤ mΩ ∧ Indep 𝒢 (valSigma M) P ∧
    ∀ t ∈ Finset.Icc 1 T,
      Measurable[𝒢 ⊔ pastSigma M t] (bid t) ∧ Measurable[𝒢 ⊔ pastSigma M t] (ask t) ∧
      ∀ ω, 0 ≤ bid t ω ∧ bid t ω < ask t ω ∧ ask t ω ≤ 1

end InvMarketMaking.LOB.Supplement


