    |(fmul P (fmul P (T.gi u) (T.gi v)) (TsumI P T a n u v) : ℝ) / 2 ^ P -
      TinvF α σ b n u v| ≤ 7 * (((n : ℝ) + 1) * E + 1) / 2 ^ P := by
  have h := h4_tinvd hα hσ hx hb hT hE hP hu hv
  have hN : (0 : ℝ) < 2 ^ P := by positivity
  have e : (fmul P (fmul P (T.gi u) (T.gi v)) (TsumI P T a n u v) : ℝ) / 2 ^ P - TinvF α σ b n u v
      = ((fmul P (fmul P (T.gi u) (T.gi v)) (TsumI P T a n u v) : ℝ) - 2 ^ P * TinvF α σ b n u v) / 2 ^ P := by
    field_simp
  rw [e, abs_div, abs_of_pos hN]
  exact div_le_div_of_nonneg_right h hN.le

