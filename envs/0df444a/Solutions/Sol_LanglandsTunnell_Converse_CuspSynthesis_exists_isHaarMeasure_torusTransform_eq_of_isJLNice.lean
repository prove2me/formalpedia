  unfold d015 realCoord
  rw [dif_pos hw, t0538, t0540, abs_mul, Real.sqrt_mul (abs_nonneg _),
    Complex.ofReal_mul, mul_inv, mul_assoc]

private theorem t0543 (w : InfinitePlace K) (hw : w.IsComplex)
    (a : (AdeleRing (𝓞 K) K)ˣ) (g : AdelicGL2 (𝓞 K) K) :
    d015 archR archC dR dC w (diagOne a * g) =
      (dC w hw).W (ArchC.diagOne (d049 hw a) * complexComponent w hw g) *
        ((‖d049 hw a‖ : ℝ) : ℂ)⁻¹ * ((‖(complexComponent w hw g).det‖ : ℝ) : ℂ)⁻¹ := by
  have hw' : ¬ w.IsReal := not_isReal_iff_isComplex.mpr hw
  unfold d015 d049
  rw [dif_neg hw', t0539, t0541, norm_mul, Complex.ofReal_mul, mul_inv,
    mul_assoc]

