section
-- Source module: Solutions.KFCBase
/-!
# KFC base: fine-cost item-language loops

Item-language (`IStmt`) building blocks whose per-element cost is `O(1 + zsz a)` for the moved
entry `a`, with **no** binary loop counter per element:

* `mvW X Y`   : move integers from `X` to `Y` until the top of `X` is not an integer
                (delimiter-driven, cost `(76 w + 131)` per entry of bit size `≤ w`);
* `uloop C D b`: run `b` once per mark on the *unary counter* `C` (the marks are moved to `D`
                and then moved back, so the counter is restored); overhead `64` per iteration;
* `mvB X Y C D`: move exactly `n` integers, `n` = number of marks on `C`;
* `toU A X K K2`: push `n` marks on `X`, where `n ≥ 0` is the integer on top of `A`
                (binary counter, cost `O((n+1)(zsz n + 2))`; superseded by the linear
                `KFCUnary.toUL`, which the programs use);
* `clrM X`    : drop all marks on top of `X`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

namespace KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Classes and item lists -/

theorem marks_succ (n : ℕ) : marks (n + 1) = .mark :: marks n := rfl

theorem NI_mark (L : List Item) : NI (.mark :: L) := by intro a; simp

theorem isIn_int (a : ℤ) (L : List Item) : isIn (cls (Item.int a :: L).head?) = true := by
  simp only [List.head?_cons, cls, isIn]; split_ifs <;> simp

theorem isIn_NI {L : List Item} (h : NI L) : isIn (cls L.head?) = false := by
  unfold isIn
  rcases L with _ | ⟨x, L⟩
  · simp [cls]
  · rcases x with a | _
    · exact absurd rfl (h a)
    · simp [cls]

theorem enc_cons (g : List ℤ) (gs : List (List ℤ)) :
    enc (g :: gs) = ints g ++ .mark :: enc gs := by simp [enc]
theorem enc_append (a b : List (List ℤ)) : enc (a ++ b) = enc a ++ enc b := by simp [enc]

/-! ## `mvW`: move integers until a delimiter -/

theorem mv_cost_le {a : ℤ} {w : ℕ} (h : zsz a ≤ w) : 2 * moveCost (zsz a) + 19 ≤ 76 * w + 101 := by
  simp only [moveCost]; omega

theorem mvW_runs {X Y : Fin HS} (hXY : X ≠ Y) (s : IState HS) (l : List ℤ) (R : List Item)
    (w : ℕ) (hX : s.G X = ints l ++ R) (hR : NI R) (hl : Bnd w l) :
    IRuns I iprog (mvW X Y) s ((s.upd X R).upd Y (ints l.reverse ++ s.G Y))
      (l.length * kap w + 30) := by
  let St : List ℤ → List ℤ → IState HS := fun D Rm =>
    (s.upd X (ints Rm ++ R)).upd Y (ints D.reverse ++ s.G Y)
  have h := IRuns.loopList (I := I) (iprog := iprog) (i := X) (f := isIn)
    (p := .op (.mv X Y)) l St (76 * w + 101)
    (by
      intro D x Rm _
      simp only [St, IState.cl_def, IState.upd_G, hXY, if_false, if_true, ints_cons,
        List.cons_append]
      exact isIn_int _ _)
    (by
      simp only [St, IState.cl_def, IState.upd_G, hXY, if_false, if_true, ints_nil,
        List.nil_append]
      exact isIn_NI hR)
    (by
      intro D x Rm hD
      have hx : zsz x ≤ w := hl x (by rw [← hD]; simp)
      refine (IRuns.mv (I := I) (iprog := iprog) (a := x) (L := ints Rm ++ R) hXY
        (by simp [St, hXY])).mono' ?_ (mv_cost_le hx)
      simp only [St]
      apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
        split_ifs <;> simp_all [ints_append])
  have e0 : St [] l = s := by
    simp only [St]
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all
  have e1 : St l [] = (s.upd X R).upd Y (ints l.reverse ++ s.G Y) := by simp [St]
  rw [e0, e1] at h
  refine h.mono ?_
  simp only [kap]; nlinarith

/-! ## Unary counted loops -/

/-! ## `mvB`: move a counted block -/

theorem mvB_runs {X Y C D : Fin HS} (hXY : X ≠ Y) (hCD : C ≠ D) (hXC : X ≠ C) (hXD : X ≠ D)
    (hYC : Y ≠ C) (hYD : Y ≠ D) (s : IState HS) (l : List ℤ) (R LC LD : List Item) (w : ℕ)
    (hX : s.G X = ints l ++ R) (hC : s.G C = marks l.length ++ LC) (hD : s.G D = LD)
    (hLC : NM LC) (hLD : NM LD) (hl : Bnd w l) :
    IRuns I iprog (mvB X Y C D) s ((s.upd X R).upd Y (ints l.reverse ++ s.G Y))
      (l.length * kap w + 60) := by
  let T : ℕ → IState HS := fun k =>
    (s.upd X (ints (l.drop k) ++ R)).upd Y (ints (l.take k).reverse ++ s.G Y)
  have h := uloop_runs (I := I) (iprog := iprog) hCD l.length T LC LD hLC hLD (76 * w + 101)
    (.op (.mv X Y)) (by
      intro k hk LC' LD'
      have hd : l.drop k = l[k] :: l.drop (k + 1) := List.drop_eq_getElem_cons hk
      have ht : l.take (k + 1) = l.take k ++ [l[k]] := by
        rw [List.take_add_one, List.getElem?_eq_getElem hk]; rfl
      have hx : zsz l[k] ≤ w := hl _ (List.getElem_mem hk)
      refine (IRuns.mv (I := I) (iprog := iprog) (a := l[k]) (L := ints (l.drop (k + 1)) ++ R) hXY
        (by simp only [T, cf, IState.upd_G, hXC, hXD, hXY, if_false, if_true]; rw [hd]; rfl)).mono' ?_
        (mv_cost_le hx)
      clear hd
      have ht' : ints (l.take (k + 1)).reverse = .int l[k] :: ints (l.take k).reverse := by
        rw [ht, List.reverse_append, ints_append]; rfl
      simp only [T, cf, ht']
      clear ht ht'
      apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
        split_ifs <;> simp_all [ints_append])
  have e0 : cf (T 0) C D (marks l.length ++ LC) LD = s := by
    simp only [T, cf, List.drop_zero, List.take_zero, List.reverse_nil, ints_nil, List.nil_append]
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all
  have e1 : cf (T l.length) C D (marks l.length ++ LC) LD =
      (s.upd X R).upd Y (ints l.reverse ++ s.G Y) := by
    simp only [T, cf, List.drop_length, List.take_length, ints_nil, List.nil_append]
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all
  rw [e0, e1] at h
  refine h.mono ?_
  simp only [kap]; nlinarith

/-! ## `clrM`: drop the marks on top of a stack -/

/-! ## `toU`: binary to unary (prologue only) -/

end KFC

end NLogN

