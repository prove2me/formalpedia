variable {d : ℕ}
variable {D : ℕ}

theorem NLogN.KFM.chirp_exact (s t : Fin d → ℕ) [∀ i, NeZero (t i)] (ht : ∀ i, Even (t i))
    (x : ((i : Fin d) → ZMod (t i)) → ℂ) :
    (fun j => (starRingEnd ℂ) (chirp s t j)) *
      (fun j => (∏ i, (t i : ℂ))⁻¹ * cconv t (chirp s t)
        ((fun j => (starRingEnd ℂ) (chirp s t j)) * x) j) = Qperm s t (dftM t x) := by sorry
