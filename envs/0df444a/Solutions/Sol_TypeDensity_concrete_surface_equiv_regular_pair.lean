theorem solution (S : Type) [CommRing S] (O' : Type) [CommRing O']
    [IsDomain O'] [IsDiscreteValuationRing O'] (pi' : O') (hpi' : Irreducible pi')
    (u' : (TypeDensity.TwoSeries O')ˣ) (a' b' : ℕ) (ha' : 0 < a') (Eq : S ≃+* TypeDensity.ConcreteSurface O' pi' u' a' b') :
    TypeDensity.RegularParameterPair S (Eq.symm (TypeDensity.surfaceT O' pi' u' a' b'))
      (Eq.symm (TypeDensity.surfaceX O' pi' u' a' b')) ∧ TypeDensity.RegularParameterPair S
      (Eq.symm (TypeDensity.surfaceX O' pi' u' a' b')) (Eq.symm (TypeDensity.surfaceT O' pi' u' a' b')) ∧ Function.Injective
      (fun y : S ↦ Eq.symm (TypeDensity.surfaceT O' pi' u' a' b') * y) := by
