    · left; exact hne
  have hZF2' : D₂.geomMorph P ≠ -L ∨ 0 < v := by
    rcases eq_or_ne (D₂.geomMorph P) (-L) with heq | hne
    · right
      rw [hQ2eq, hnegL] at heq
