  parts_sum := by decide

/-- Partition `[3, 3, 3]` of 9. -/
def partitionNineThreeThreeThree : Nat.Partition 9 where
  parts := {3, 3, 3}
  parts_pos := by intro a ha; fin_cases ha <;> omega
  parts_sum := by decide

