-- title:
--   Definitions 2.1 and 2.4 — standard free semicircular family, pencils, covariance map, upper edge, slice map, resolvent moments, subsolutions, fixed-point iteration
-- statement:
--   Let $H$ be a complex Hilbert space and $\omega\in H$ a unit vector, with the vector state $\tau(a)=\langle\omega,a\omega\rangle$ on bounded operators. A family $(s_\gamma)_{\gamma\in J}$ of bounded operators, $J$ finite, is a **standard free semicircular family** (`IsStdFreeSemicircular s ω`) when each $s_\gamma$ is self-adjoint with the semicircle moments
--   $$\tau(s_\gamma^k)=\frac1{2\pi}\int_{-2}^{2}t^k\sqrt{4-t^2}\,dt\qquad(k\ge0),$$
--   the family is free for $\tau$ (for $k\ge1$, indices $\gamma_1,\dots,\gamma_k$ with consecutive ones distinct and polynomials $p_j$ with $\tau(p_j(s_{\gamma_j}))=0$, one has $\tau(p_1(s_{\gamma_1})\cdots p_k(s_{\gamma_k}))=0$), and $\tau$ is a faithful tracial state on the unital $C^*$-algebra $A$ generated by the family (the norm closure of the unital $*$-algebra it generates).
--
--   A **pencil** (Definition 2.1) over the coordinates $\iota$ ($D=|\iota|$) has a mean $V$ and coefficients $K_\gamma$, $D\times D$ complex matrices, Hermitian (`Pencil.IsHerm`); it is the operator $\mathcal Y=V\otimes I+\sum_\gamma K_\gamma\otimes s_\gamma$ on $\mathbb C^D\otimes H$, encoded as the $D\times D$ matrix of operators with entries $V_{kl}I+\sum_\gamma (K_\gamma)_{kl}s_\gamma$ (`Pencil.op`, a `CStarMatrix`). Its covariance map is $\Omega(M)=\sum_\gamma K_\gamma MK_\gamma$ (`cov`), its matrix variance $\sigma_\Omega^2=\|\Omega(I)\|$ (`varSq`), its upper edge $\lambda_+(\mathcal Y)=\sup\operatorname{spec}\mathcal Y$ (`upperEdge`, real spectrum). For a real threshold $z$ the resolvent moments are $G_j=(\mathrm{id}\otimes\tau)((zI-\mathcal Y)^{-j})$ (`resMoment`), where $(\mathrm{id}\otimes\tau)(T)$ is the matrix $(\langle\omega,T_{kl}\omega\rangle)_{k,l}$ (`slice`); `stieltjes` is $G(w)=(\mathrm{id}\otimes\tau)(wI-\mathcal Y)^{-1}$ at complex $w$. A positive definite $Z$ is a **subsolution** at $z$ (Definition 2.4) if $Z^{-1}\preceq zI-V-\Omega(Z)$. `fpIter` is the iteration (2.7): $\Theta^{(0)}=zI-V$, $\Theta^{(d+1)}=zI-V-\Omega((\Theta^{(d)})^{-1})$. `opNorm` is the $\ell^2$ operator norm of a complex matrix and `lamMax` the supremum of its real spectrum ($\lambda_{\max}$ for a Hermitian matrix).
--
--   **Formalization Note** Inverses are `Ring.inverse` and the matrix inverse; they are used only where the paper's hypotheses make the operator invertible.
-- source:
--   Kathuria, A Walk From Free Probability to Matrix Discrepancy II, arXiv:2609.18913 (version dated November 3, 2026; sha256 c06bf728…), pp. 12–15, §1.4, §2.1, Definitions 2.1 and 2.4, (2.7)

import Mathlib

namespace FreeWeaver.Walk

open scoped InnerProductSpace ComplexOrder

noncomputable section

/-!
# Pencils over a standard free semicircular family

Kathuria, *A Walk From Free Probability to Matrix Discrepancy II*, arXiv:2609.18913 (version dated
November 3, 2026; sha256 c06bf728…), §1.4 (notation) and §2.1, pp. 12–14, Definitions 2.1 and 2.4.

**Formalization Note** The `C*`-probability space `(A, τ)` of §2.1 is realized, as the paper does,
on a complex Hilbert space `H` with a unit vector `ω` and `τ(a) = ⟪ω, a ω⟫`; `A` is the unital
`C*`-algebra generated by the family (the norm closure of the unital `*`-algebra it generates).
`ℂ^D ⊗ H` is encoded as `D × D` matrices of bounded operators on `H` (Mathlib's `CStarMatrix`, whose
`C*`-norm is the operator norm on `H^D`), with the coordinates of `ℂ^D` indexed by a finite type
`ι` (`D = card ι`). The slice map `id ⊗ τ` takes a matrix `T` of operators to the scalar matrix
`(⟪ω, T k l ω⟫)_{k,l}`, which is `ι* T ι` for the isometry `ι v = v ⊗ ω`. Traces are unnormalized;
the norm of a complex matrix is the operator norm for the Euclidean norm (Mathlib's
`Matrix.Norms.L2Operator`); `λ₊` is the supremum of the real spectrum.
-/

/-- The operator norm (Euclidean, `ℓ²` operator norm) of a complex square matrix. -/
def opNorm {ι : Type*} [Fintype ι] [DecidableEq ι] (M : Matrix ι ι ℂ) : ℝ :=
  open scoped Matrix.Norms.L2Operator in ‖M‖

/-- `λmax`: the supremum of the real spectrum of a square complex matrix. For a Hermitian matrix this
is its largest eigenvalue (§1.4: "for a Hermitian matrix, it is `λmax`"). -/
def lamMax {ι : Type*} [Fintype ι] [DecidableEq ι] (M : Matrix ι ι ℂ) : ℝ :=
  sSup (spectrum ℝ M)

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- The vector state `τ(a) = ⟪ω, a ω⟫` of a vector `ω` of `H`. -/
def vecState (ω : H) (a : H →L[ℂ] H) : ℂ := ⟪ω, a ω⟫_ℂ

/-- The unital `C*`-algebra generated by a family of bounded operators: the norm closure of the unital
`*`-subalgebra of `B(H)` that the family generates. -/
def genCStar {J : Type*} (s : J → H →L[ℂ] H) : StarSubalgebra ℂ (H →L[ℂ] H) :=
  (StarAlgebra.adjoin ℂ (Set.range s)).topologicalClosure

/-- The `k`-th moment of the semicircle law `(2π)⁻¹ √(4 − t²) dt` on `[−2, 2]`. -/
def semicircleMoment (k : ℕ) : ℝ :=
  (2 * Real.pi)⁻¹ * ∫ t in (-2 : ℝ)..2, t ^ k * Real.sqrt (4 - t ^ 2)

/-- A **standard free semicircular family** `(s_γ)_{γ ∈ J}` on `H` with the unit vector `ω`
(§2.1, p. 13): each `s_γ` is self-adjoint with the semicircle moments
`τ(s_γ^k) = (2π)⁻¹ ∫_{−2}^{2} t^k √(4 − t²) dt`, the family is free with respect to `τ`, and `τ` is a
faithful tracial state on the unital `C*`-algebra `A` that the family generates.

Freeness: for every `k ≥ 1`, indices `γ_1, …, γ_k` with consecutive indices distinct, and elements
`a_j = p_j(s_{γ_j})` of the unital algebras generated by the single `s_{γ_j}` (polynomials, which
are the whole unital `*`-algebra generated by a self-adjoint element) with `τ(a_j) = 0`, the product
`a_1 ⋯ a_k` has `τ(a_1 ⋯ a_k) = 0`. -/
structure IsStdFreeSemicircular {J : Type*} (s : J → H →L[ℂ] H) (ω : H) : Prop where
  norm_ω : ‖ω‖ = 1
  selfAdjoint : ∀ γ, IsSelfAdjoint (s γ)
  tracial : ∀ a ∈ genCStar s, ∀ b ∈ genCStar s, vecState ω (a * b) = vecState ω (b * a)
  faithful : ∀ a ∈ genCStar s, vecState ω (star a * a) = 0 → a = 0
  moments : ∀ (γ : J) (k : ℕ), vecState ω (s γ ^ k) = (semicircleMoment k : ℂ)
  free : ∀ (k : ℕ) (γ : Fin (k + 1) → J) (p : Fin (k + 1) → Polynomial ℂ),
    (∀ j : Fin k, γ j.castSucc ≠ γ j.succ) →
    (∀ j, vecState ω (Polynomial.aeval (s (γ j)) (p j)) = 0) →
    vecState ω (List.ofFn fun j => Polynomial.aeval (s (γ j)) (p j)).prod = 0

/-- The data of a pencil (Definition 2.1, p. 14): the mean `V` and the coefficients `K_γ`, `γ ∈ J`,
`ι × ι` complex matrices. -/
structure Pencil (ι J : Type*) where
  V : Matrix ι ι ℂ
  K : J → Matrix ι ι ℂ

namespace Pencil

variable {ι J : Type*} [Fintype ι] [DecidableEq ι] [Fintype J]

/-- Definition 2.1 requires the mean and the coefficients to be Hermitian. -/
def IsHerm (Y : Pencil ι J) : Prop := Y.V.IsHermitian ∧ ∀ γ, (Y.K γ).IsHermitian

/-- The covariance map `Ω(M) = Σ_γ K_γ M K_γ`. -/
def cov (Y : Pencil ι J) (M : Matrix ι ι ℂ) : Matrix ι ι ℂ := ∑ γ, Y.K γ * M * Y.K γ

/-- The matrix variance `σ_Ω² = ‖Ω(I)‖`. -/
def varSq (Y : Pencil ι J) : ℝ := opNorm (Y.cov 1)

/-- The pencil `Y = V ⊗ I + Σ_γ K_γ ⊗ s_γ` as an operator on `ℂ^ι ⊗ H`: the matrix of operators
whose `(k, l)` entry is `V_{kl} I + Σ_γ (K_γ)_{kl} s_γ`. -/
def op (Y : Pencil ι J) (s : J → H →L[ℂ] H) : CStarMatrix ι ι (H →L[ℂ] H) :=
  CStarMatrix.ofMatrix fun k l => Y.V k l • (1 : H →L[ℂ] H) + ∑ γ, Y.K γ k l • s γ

end Pencil

/-- The upper edge `λ₊(T) = sup spec T` of an operator on `ℂ^ι ⊗ H` (real spectrum). -/
def upperEdge {ι : Type*} [Fintype ι] [DecidableEq ι] (T : CStarMatrix ι ι (H →L[ℂ] H)) : ℝ :=
  sSup (spectrum ℝ T)

/-- The slice map `id ⊗ τ` by the vector state of `ω`: `(id ⊗ τ)(T) = ι* T ι`, the matrix with
entries `⟪ω, T_{kl} ω⟫`. -/
def slice {ι : Type*} (ω : H) (T : CStarMatrix ι ι (H →L[ℂ] H)) : Matrix ι ι ℂ :=
  fun k l => vecState ω (CStarMatrix.ofMatrix.symm T k l)

/-- The resolvent `(w I − T)⁻¹` at a complex number `w` (the inverse in the algebra of operators on
`ℂ^ι ⊗ H`; used where `w I − T` is invertible). -/
def resolventAt {ι : Type*} [Fintype ι] [DecidableEq ι] (T : CStarMatrix ι ι (H →L[ℂ] H)) (w : ℂ) :
    CStarMatrix ι ι (H →L[ℂ] H) :=
  Ring.inverse (w • (1 : CStarMatrix ι ι (H →L[ℂ] H)) - T)

namespace Pencil

variable {ι J : Type*} [Fintype ι] [DecidableEq ι] [Fintype J]

/-- `G(w) = (id ⊗ τ)(w I − Y)⁻¹`, the matrix-valued Stieltjes transform at a complex `w`. -/
def stieltjes (Y : Pencil ι J) (s : J → H →L[ℂ] H) (ω : H) (w : ℂ) : Matrix ι ι ℂ :=
  slice ω (resolventAt (Y.op s) w)

/-- The resolvent moments `G_j = (id ⊗ τ)(R^j)`, `R = (z I − Y)⁻¹`, at a real threshold `z`
(Definition 2.1). `G_1` is the matrix resolvent and `Tr G_2` the energy. -/
def resMoment (Y : Pencil ι J) (s : J → H →L[ℂ] H) (ω : H) (z : ℝ) (j : ℕ) : Matrix ι ι ℂ :=
  slice ω (resolventAt (Y.op s) (z : ℂ) ^ j)

/-- Definition 2.4: a positive definite matrix `Z` is a subsolution of the matrix Dyson equation of
`Y` at the threshold `z` if `Z⁻¹ ⪯ z I − V − Ω(Z)`. -/
def IsSubsolution (Y : Pencil ι J) (z : ℝ) (Z : Matrix ι ι ℂ) : Prop :=
  Z.PosDef ∧ ((z : ℂ) • (1 : Matrix ι ι ℂ) - Y.V - Y.cov Z - Z⁻¹).PosSemidef

/-- The fixed-point iteration (2.7): `Θ(0) = z I − V`, `Θ(d+1) = z I − V − Ω((Θ(d))⁻¹)`. -/
def fpIter (Y : Pencil ι J) (z : ℝ) : ℕ → Matrix ι ι ℂ
  | 0 => (z : ℂ) • (1 : Matrix ι ι ℂ) - Y.V
  | d + 1 => (z : ℂ) • (1 : Matrix ι ι ℂ) - Y.V - Y.cov (fpIter Y z d)⁻¹

end Pencil

end

end FreeWeaver.Walk


