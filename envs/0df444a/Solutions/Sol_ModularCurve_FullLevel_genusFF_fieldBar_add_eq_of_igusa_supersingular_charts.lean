variable {q : ℕ} [Fact q.Prime] {M' : ℕ} [NeZero M'] {A : ValuationSubring (AlgebraicClosure ℚ)}
variable {SS : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M'))}

set_option synthInstance.maxHeartbeats 1600000 in

theorem genusClause_iff (𝒞 : SemistableCovering q M' A SS) :
    𝒞.GenusClause ↔
      haveI : Fintype (CuspidalType.ProjLine q) := Fintype.ofFinite _
      AlgebraicCurve.genusFF (AlgebraicClosure ℚ) ↥(fieldBar q M') + (q + 1) + SS.card =
        ∑ ℓ : CuspidalType.ProjLine q, AlgebraicCurve.genusFF (ResidueField A) (𝒞.FIg ℓ) +
          ∑ s : ↥SS, AlgebraicCurve.genusFF (ResidueField A) (𝒞.FSS s) + (q + 1) * SS.card + 1 := by
  haveI : Fintype (CuspidalType.ProjLine q) := Fintype.ofFinite _
  simp only [SemistableCovering.GenusClause, CuspidalType.card_projLine, finsum_eq_sum_of_fintype,
    ← Finset.univ_eq_attach, add_assoc]
  exact Iff.of_eq (by congr!)

