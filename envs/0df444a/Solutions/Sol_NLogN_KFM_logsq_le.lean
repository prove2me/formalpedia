theorem sq_le_exp (g x : ℝ) (hg : 0 < g) (hx : 0 ≤ x) :
    (x + 1) ^ 2 ≤ (4 / g ^ 2 + 2) * Real.exp (g * x) := by
  have he := Real.quadratic_le_exp_of_nonneg (mul_nonneg hg.le hx)
  have he1 : 1 ≤ Real.exp (g * x) := Real.one_le_exp (mul_nonneg hg.le hx)
  have hgx : (g * x) ^ 2 ≤ 2 * Real.exp (g * x) := by nlinarith [sq_nonneg (g * x)]
  have hx2 : x ^ 2 = (g * x) ^ 2 / g ^ 2 := by field_simp
  have h4 : x ^ 2 ≤ 2 / g ^ 2 * Real.exp (g * x) := by
    rw [hx2, div_le_iff₀ (by positivity)]
    have : 2 / g ^ 2 * Real.exp (g * x) * g ^ 2 = 2 * Real.exp (g * x) := by field_simp
    rw [this]; exact hgx
  have : (x + 1) ^ 2 ≤ 2 * x ^ 2 + 2 := by nlinarith [sq_nonneg (x - 1)]
  have h5 : (0 : ℝ) ≤ 4 / g ^ 2 := by positivity
  have h6 : 2 * x ^ 2 ≤ 4 / g ^ 2 * Real.exp (g * x) := by
    have : 4 / g ^ 2 * Real.exp (g * x) = 2 * (2 / g ^ 2 * Real.exp (g * x)) := by ring
    rw [this]; linarith
  nlinarith

theorem natlog_le_log (D : ℕ) (hD : 1 ≤ D) :
    (Nat.log (100 ^ 3) D : ℝ) ≤ Real.log D := by
  have hp := Nat.pow_log_le_self (100 ^ 3) (by omega : D ≠ 0)
  have hpR : ((100 ^ 3 : ℕ) : ℝ) ^ (Nat.log (100 ^ 3) D) ≤ D := by exact_mod_cast hp
  have hl := Real.log_le_log (by positivity) hpR
  rw [Real.log_pow] at hl
  have hM : (1 : ℝ) ≤ Real.log ((100 ^ 3 : ℕ) : ℝ) := by
    rw [Real.le_log_iff_exp_le (by norm_num)]
    have := Real.exp_one_lt_d9; push_cast; linarith
  have hk : (0 : ℝ) ≤ Nat.log (100 ^ 3) D := Nat.cast_nonneg _
  nlinarith

