variable {k : Type} [CommRing k] {d : ℕ}

theorem GlobalTheory.QuadDeriv.pderiv_ev {l m : ℕ} (a : Fin l → Pt k m d) (ha : ∀ j, GP (a j)) (f : PS k l d)
    (s : Fin m × Fin d) :
    pderiv k s (ev a f) = ∑ j, ∑ i, ev a (pderiv k (j, i) f) * pderiv k s (a j i) := by sorry
