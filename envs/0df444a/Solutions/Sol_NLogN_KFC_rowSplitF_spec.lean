open NLogN
open IntMul AModel
open NLogN.KFC
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution (t : NLogN.IState NLogN.HS) (xs : List ℤ) (P W L : ℕ) (rest : AModel.Shape) (w : ℕ)
    (R L1 L2 L3 L4 : List NLogN.Item)
    (hlen : xs.length = AModel.vol (P :: W * L :: rest)) (hb : NLogN.Bnd w xs)
    (hB1 : 1 ≤ AModel.vol rest) (hPL : 1 ≤ P * L) (hW : 1 ≤ W)
    (h0 : t.G 0 = NLogN.ints xs ++ R) (h1 : t.G 1 = .int ((1 : ℕ) : ℤ) :: L1)
    (h2 : t.G 2 = .int (W : ℤ) :: L2) (h3 : t.G 3 = .int ((P * L : ℕ) : ℤ) :: L3)
    (h4 : t.G 4 = .int (AModel.vol rest : ℤ) :: L4) :
    NLogN.IRuns I iprog NLogN.KFC.bwdF t (t.upd 0 (NLogN.ints ((List.finRange W).flatMap
        (fun w => AModel.rowSplit P W L rest w 0 xs)) ++ R)) (NLogN.KFC.cBwdF 1 W (P * L) (AModel.vol rest) w) := by
  rw [NLogN.KIL.rowSplit_all_eq]
  exact NLogN.KFC.bwdF_spec t xs 1 W (P * L) (AModel.vol rest) w R L1 L2 L3 L4
    (by rw [hlen]; simp [AModel.vol]; ring) hb hB1 hPL hW le_rfl h0 h1 h2 h3 h4
end
