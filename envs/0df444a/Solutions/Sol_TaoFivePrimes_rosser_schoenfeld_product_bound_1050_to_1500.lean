theorem rs_pden_0 : ∏ p ∈ Nat.primesLE 1049, ((p : ℕ) - 1) = rsPden 0 :=
  primorial_certificate_1049.right

theorem rs_step_1 : Nat.primesLE 1051 = insert 1051 (Nat.primesLE 1049) :=
  primesLE_insert_next 1049 1051 (by norm_num) (by norm_num)
    (by intro m hm1 hm2; interval_cases m <;> norm_num)
theorem rs_pnum_1 : ∏ p ∈ Nat.primesLE 1051, (p : ℕ) = rsPnum 1 := by
  rw [rs_step_1]
  exact rs_pnum_step_gen (Nat.primesLE 1049) 1051
    (fun h => absurd ((Nat.mem_primesLE.mp h).1) (by omega)) rs_pnum_0
theorem rs_pden_1 : ∏ p ∈ Nat.primesLE 1051, ((p : ℕ) - 1) = rsPden 1 := by
