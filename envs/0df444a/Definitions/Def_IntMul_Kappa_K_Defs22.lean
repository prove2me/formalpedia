-- Source module: Solutions.KFMU3
/-!
# KFM U3: uniform digits in and carries out

`UNIFORM.md`: KFT's `digI b e M S` and `carI b N` push the literals `2^b`, `2^e` and use the
literal counts `M`, `2(S − M)`, `N`. The uniform codes copy them from registers:

| stack | value |
|---|---|
| `uB2 = 24` | `2^b` |
| `uM = 25` | `M` (digits) / `N` (carries) |
| `uZ = 32` | `2(S − M)` |
| `uE = 33` | `2^e` |

(the same stacks as the table registers of KFMU2; the two are used in different phases).
The bodies (`cutB`, `zB`, `putB`, `c1B`, `c2B`) and the scratch stacks 56–62 are KFT's, unchanged.
The proofs are KFT's with each `rpt` converted by `rptX_of_rpt` and each `const` by a `dup`.

* **`digIU_spec`**: as `digI_spec`, cost `cDigU = cDig + O(b + e) + O(log M + log S)`.
* **`carIU_spec`**: as `carI_spec`, cost `cCarU = cCar + O(b + log N)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFM

open IntMul KFC KFB KFT

abbrev uB2 : Fin HS := 24
abbrev uM : Fin HS := 25
abbrev uZ : Fin HS := 32
abbrev uE : Fin HS := 33

section IL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- **Uniform digits in.** -/
def digIU : IStmt HS P :=
  .seq (.op (.dup uB2 tR)) (.seq (rptX uM tA tC tD cutB) (.seq (.op (.drop tX))
    (.seq (rptX uZ tA tC tD NLogN.KFT.zB) (.seq (.op (.dup uE KFT.tE))
    (.seq (rptX uM tA tC tD putB) (.seq (.op (.drop KFT.tE)) (.op (.drop tR))))))))

def cDigU (b e M S : ℕ) : ℕ :=
  cDig b e M S + (dupCost (b + 1) + 17) + (dupCost (e + 1) + 17) + 2 * cCnt M + cCnt (2 * (S - M))

/-- **Uniform carries out.** -/
def carIU : IStmt HS P :=
  .seq (.op (.dup uB2 tR)) (.seq (.op (.const tY 0)) (.seq (rptX uM tA tC tD c1B)
    (.seq (.op (.const NLogN.KFT.tP 1)) (.seq (.op (.add tY NLogN.KFT.tP tY)) (.seq (.op (.const NLogN.KFT.tP 1))
    (.seq (rptX uM tA tC tD c2B) (.seq (.op (.neg NLogN.KFT.tP)) (.seq (.op (.add tY NLogN.KFT.tP 0))
    (.op (.drop tR))))))))))

def cCarU (b B N : ℕ) : ℕ := cCar b B N + (dupCost (b + 1) + 17) + 2 * cCnt N

end IL

end NLogN.KFM

end

