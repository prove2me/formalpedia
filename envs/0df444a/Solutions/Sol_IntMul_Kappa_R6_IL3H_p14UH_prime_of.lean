  have hCB := cbRec_of hc (aK := fun _ : ℕ => Kc * ((Gv czH (Zl c P K D S r w) : ℕ) + 2) + 1)
    (K := K) (haK K) hτ0 hτθ Cc (10 ^ 14 * (2 * c.m + 1)) hCc0 rfl hCc
  have hWr := h.Wr_le_Zc
  have hZcZ := h.Zc_lt_Z
  have hZl := h.Zl_le_Z hc
  have hGz : zsz ((Gv czH (Zl c P K D S r w) : ℕ) : ℤ) ≤ 3 * Z :=
    le_trans (zsz_natCast_le_self _) (h.G_le_Z hc)
  have hZr : 3 * Z + 2 ≤ r := by
