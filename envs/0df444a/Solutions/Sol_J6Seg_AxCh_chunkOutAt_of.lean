set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.AxCh
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function J6Seg J6Seg.KR J6Seg.Ax

theorem AB_chunkB (P : ℕ) {A : ℤ} {di gi gam dd : List ℤ} :
    ∀ (ds : List (ℕ × List ℤ × List ℤ)) (z : List GI),
      chunkOK P A di gi gam dd ds z → AB A (chunkB P di gi gam dd ds z)
  | [], _, _ => by intro w hw; simp [chunkB] at hw
  | (n, am, ap) :: ds, z, h => by
    intro w hw
    simp only [chunkB, List.mem_append] at hw
    rcases hw with hw | hw
    · exact h.1.2.2.2.2.2.2.2 w hw
    · exact AB_chunkB P ds _ h.2 w hw

theorem AB_chunkG2 (P : ℕ) {A : ℤ} (hA : 0 ≤ A) {di gi gam dd : List ℤ}
    (ds : List (ℕ × List ℤ × List ℤ)) (z : List GI)
    (h : chunkOK P A di gi gam dd ds z) : AB A (chunkG2 P di gi gam dd ds z) := by
  intro w hw
  simp only [chunkG2, List.mem_append, List.mem_map] at hw
  rcases hw with hw | ⟨_, _, rfl⟩
  · exact AB_chunkB P ds z h w hw
  · simp [hA]

theorem Xs_le_pow {K X : ℤ} {a : ℕ} (hK0 : 0 ≤ K) (hK : K ≤ 2 ^ a) (hX : 1 ≤ X) :
    ∀ i, Xs K X i ≤ 2 ^ ((a + 1) * i) * X
  | 0 => by simp [Xs]
  | i + 1 => by
    have ih := Xs_le_pow hK0 hK hX i
    have h0 := Xs_nonneg hK0 (by omega : (0 : ℤ) ≤ X) i
    have hB : (1 : ℤ) ≤ 2 ^ ((a + 1) * i) * X := by
      have : (1 : ℤ) ≤ 2 ^ ((a + 1) * i) := one_le_pow₀ (by norm_num)
      nlinarith
    have e : (2 : ℤ) ^ ((a + 1) * (i + 1)) * X = 2 ^ a * (2 ^ ((a + 1) * i) * X) +
        2 ^ a * (2 ^ ((a + 1) * i) * X) := by
      rw [show (a + 1) * (i + 1) = a + 1 + (a + 1) * i by ring, pow_add, pow_succ]; ring
    have hpa : (1 : ℤ) ≤ 2 ^ a := one_le_pow₀ (by norm_num)
    simp only [Xs]; rw [e]
    have : K * Xs K X i ≤ 2 ^ a * (2 ^ ((a + 1) * i) * X) :=
      mul_le_mul hK ih h0 (by positivity)
    nlinarith

section ax
variable (P : Prm) (ap : AxPlan6) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ)

/-- The three value facts of `AxBudgetAt` that the chunk kernel needs, from `ChunkPlan6`. -/
theorem chunkPlan_facts (hc : ChunkPlan6 ap) :
    (2 : ℤ) ^ axQ6 P n src k * 2 ^ (axR6 P n + 2) ≤ 2 ^ axpk6 P n src k ap ∧
    KR.Xs ((((axl6 P n : ℕ) : ℤ) + 1) * 2 ^ (axR6 P n + 2) + 1) (axX6 P n src k ap) 7 ≤
      2 ^ axpk6 P n src k ap ∧
    axpk6 P n src k ap + 1 ≤ axwd6 P n src k ap := by
  obtain ⟨c1, c2, c3, c4⟩ := hc
  set Q := axQ6 P n src k with hQ
  set R := axR6 P n with hR
  have hl : Nat.log 2 (lamF (axd6 P n)) < Q := Val.log_lam_lt_Q _ _ _
  have h7 : 7 * (R + 2) ≤ Q + 13 := Val.sevenR_le_Q (axp6 P n) (axd6 P n) (axs6 src k)
  have hlam : axl6 P n + 1 ≤ 2 ^ Q := by
    have : axl6 P n < 2 ^ Q := by
      unfold axl6 lamP; exact Nat.pow_lt_pow_right (by norm_num) hl
    omega
  have hpk : axpk6 P n src k ap = ap.pl.pkA * Q + ap.pl.pkC := rfl
  have hwd : axwd6 P n src k ap = ap.pl.wA * Q + ap.pl.wC := rfl
  have m1 : (ap.xA + 8) * Q ≤ ap.pl.pkA * Q := Nat.mul_le_mul_right _ c1
  have m2 : ap.pl.pkA * Q ≤ ap.pl.wA * Q := Nat.mul_le_mul_right _ c3
  have two : (1 : ℤ) < 2 := by norm_num
  refine ⟨?_, ?_, by rw [hpk, hwd]; omega⟩
  · rw [← pow_add]; apply pow_le_pow_right₀ (by norm_num); rw [hpk]
    have : (ap.xA + 8) * Q = ap.xA * Q + 8 * Q := by ring
    omega
  · have hK : (((axl6 P n : ℕ) : ℤ) + 1) * 2 ^ (R + 2) + 1 ≤ 2 ^ (Q + R + 3) := by
      have h1 : (((axl6 P n : ℕ) : ℤ) + 1) ≤ 2 ^ Q := by exact_mod_cast hlam
      have h2 : (1 : ℤ) ≤ 2 ^ Q * 2 ^ (R + 2) := one_le_mul_of_one_le_of_one_le
        (one_le_pow₀ (by norm_num)) (one_le_pow₀ (by norm_num))
      have e : (2 : ℤ) ^ (Q + R + 3) = 2 ^ Q * 2 ^ (R + 2) + 2 ^ Q * 2 ^ (R + 2) := by
        rw [show Q + R + 3 = Q + (R + 2) + 1 by ring, pow_succ, pow_add]; ring
      rw [e]; nlinarith [pow_pos (by norm_num : (0 : ℤ) < 2) (R + 2)]
    have hX : (1 : ℤ) ≤ axX6 P n src k ap := by unfold axX6; exact one_le_pow₀ (by norm_num)
    refine (Xs_le_pow (by positivity) hK hX 7).trans ?_
    unfold axX6; rw [← pow_add]; apply pow_le_pow_right₀ (by norm_num); rw [hpk]
    have : (ap.xA + 8) * Q = ap.xA * Q + 8 * Q := by ring
    rw [← hQ]; omega

/-- **The chunk output bound at one axis.** -/
theorem chunkOutAt_of_sol_aux (hT : TabAt P n src k) (hc : ChunkPlan6 ap) : ChunkOutAt P ap n src k := by
  obtain ⟨f1, f2, f3⟩ := chunkPlan_facts P ap n src k hc
  intro q _ x hx hAB
  set Q := axQ6 P n src k
  set R := axR6 P n
  set s := axs6 src k
  set t := axt6 P n k
  set lam := axl6 P n
  set α := axα6 P n
  have hlam : 1 ≤ lam := Nat.one_le_two_pow
  have hKt : (0 : ℤ) ≤ 2 ^ (R + 2) := by positivity
  have hX0 : (0 : ℤ) ≤ axX6 P n src k ap := by unfold axX6; positivity
  have hT' : ∀ u < lam, |(TT Q R s t α).di u| ≤ 2 ^ Q * 2 ^ (R + 2) ∧
      |(TT Q R s t α).gi u| ≤ 2 ^ Q * 2 ^ (R + 2) ∧ |(TT Q R s t α).gam u| ≤ 2 ^ Q * 2 ^ (R + 2) ∧
      |(TT Q R s t α).dd u| ≤ 2 ^ Q * 2 ^ (R + 2) ∧
      ∀ c, |(TT Q R s t α).am c u| ≤ 2 ^ Q * 2 ^ (R + 2) ∧
        |(TT Q R s t α).ap c u| ≤ 2 ^ Q * 2 ^ (R + 2) := by
    intro u hu
    have e : (2 : ℤ) ^ Q * 2 ^ (R + 2) = 2 ^ (Q + R + 2) := by rw [← pow_add]; ring_nf
    rw [e]; exact hT u hu
  have TBL : ∀ (f : ℕ → ℤ), (∀ u < lam, |f u| ≤ 2 ^ Q * 2 ^ (R + 2)) →
      TB (2 ^ Q * 2 ^ (R + 2)) ((List.range lam).map f) := by
    intro f hf v hv
    obtain ⟨u, hu, rfl⟩ := List.mem_map.1 hv
    exact hf u (List.mem_range.1 hu)
  have hds := descsOf_ok (s := s) (t := t) hlam (TT Q R s t α) q
  have hok := chunkOK_of Q hKt hX0 (TBL _ fun u hu => (hT' u hu).1)
    (TBL _ fun u hu => (hT' u hu).2.1) (TBL _ fun u hu => (hT' u hu).2.2.1)
    (TBL _ fun u hu => (hT' u hu).2.2.2.1)
    (by simp [diL]) (by simp [giL]) (by simp [gamL]) (by simp [ddL]) f2
    (descsOf s t lam (TT Q R s t α) q) x
    (fun d hd => by
      obtain ⟨h1, h2, h3, h4, h5, h6⟩ := hds d hd
      refine ⟨h4, by omega, by omega, ?_, ?_⟩
      · intro v hv
        obtain ⟨h, hh, c', rfl⟩ := h5 v hv
        exact ((hT' h (by omega)).2.2.2.2 c').1
      · intro v hv
        obtain ⟨h, hh, c', rfl⟩ := h6 v hv
        exact ((hT' h (by omega)).2.2.2.2 c').2)
    (by rw [hx]; exact sumN_descsOf hlam _ q) hAB
  have e : liftG (chunkK Q R s t lam α q) x =
      chunkG2 Q (diL Q R s t lam α) (giL Q R s t lam α) (gamL Q R s t lam α)
        (ddL Q R s t lam α) (descsOf s t lam (TT Q R s t α) q) x := by
    unfold chunkK
    apply liftG_chunkL2
    intro d hd
    obtain ⟨h1, h2, h3, h4, -⟩ := hds d hd
    simp [diL, giL, gamL, ddL]; omega
  rw [e]
  exact gb_AB (AB_chunkG2 Q (by positivity) _ x hok) f3

end ax

