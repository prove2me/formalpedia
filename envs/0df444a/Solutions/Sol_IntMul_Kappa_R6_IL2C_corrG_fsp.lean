  -- pass 1
  have SP1 := p1G_fsp hB hB2 hbig hκ hw recs hlen hbits s hkp Gn rfl (fun _ _ => rfl) rfl
  have g3 : KFL.P1 κ recs M Gn M rm = (M : ℤ) :: [] := by simp +decide [KFL.P1, Function.update_apply, Gn]
  have S3 := Sp.pop s (KFL.P1 κ recs M Gn M) (B := Bb) (by decide) g3 (hW _ (by omega))
  set G3 := Function.update (KFL.P1 κ recs M Gn M) rm []
  -- the sort
  set E := ent0 κ M recs
  have hE : ∀ e ∈ E, e.2.length = B ∧ Bnd 1 e.2 ∧ e.1 ≤ 4 * V := by
    intro e he
    simp only [E, ent0, List.mem_map] at he
    obtain ⟨m, hm, rfl⟩ := he
    have hmM := (mem_mvL.1 hm).1
    refine ⟨by simp [hlen], fun a ha => hbits m a (by simpa using ha), ?_⟩
    have := hκ m hmM; simp only; omega
  have hEl : E.length = nMv κ M := length_ent0 κ recs M
  have hEM : E.length ≤ M := by rw [hEl]; exact nMv_le κ M
  have hEW : (E.length + 1) * (B + 1) ≤ 4 * V := by nlinarith
  have hK0 : E.map (kh 0) = stkK (mvP κ) (fun m => (κ m : ℤ)) M := (stkK_ent0 κ recs M).symm
  have hB0 : E.flatMap Prod.snd = stkF (mvP κ) (fun m => (recs m).reverse) M :=
    (stkF_ent0 κ recs M).symm
  have SR := radix_fsp hB2 hW hAW s G3 E hE hEW (kk0 := []) (kb0 := []) (lnb := [])
    (by rw [hK0]; simp +decide [G3, KFL.P1, Function.update_apply, Gn])
    (by rw [hB0]; simp +decide [G3, KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, KFL.P1, Function.update_apply, Gn]) (by simp +decide [G3, KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, KFL.P1, Function.update_apply, Gn]) (by simp +decide [G3, KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, KFL.P1, Function.update_apply, Gn]) (by simp +decide [G3, KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, KFL.P1, Function.update_apply, Gn, hEl])
  rw [sort_moved hγκ hκγ hκ hγ (le_of_lt (lt_of_le_of_lt hMV hV)) recs, hEl] at SR
  set Gn' := Function.update Gn rNB [(nMv κ M : ℤ)]
  have e4 : Function.update (Function.update G3 sKK ((ent1 κ γ M recs).map (kh A) ++ []))
      sKB ((ent1 κ γ M recs).flatMap Prod.snd ++ []) = P3 κ γ recs M A Gn' M := by
    rw [← stkK_ent1 κ γ recs M A, ← stkF_ent1 κ γ recs M]
    funext r
    simp only [G3, KFL.P1, P3, Gn', Gn]
    by_cases a1 : r = sKB
    · subst a1; simp +decide
    by_cases a2 : r = sKK
    · subst a2; simp +decide
    by_cases a3 : r = rm
    · subst a3; simp +decide
    by_cases a4 : r = rNB
    · subst a4; simp +decide
    by_cases a5 : r = sFL
    · subst a5; simp +decide
    by_cases a6 : r = sT
    · subst a6; simp +decide
    by_cases a7 : r = 0
    · subst a7; simp +decide [restR_full]
    simp [Function.update_apply, a1, a2, a3, a4, a5, a6, a7]
  rw [e4] at SR
  -- pass 3
  have SP3 := p3_fsp (A := A) (M := M) hγκ hB2 hlen hbits (hW _ (by omega))
    (fun d hd => hW _ (le_trans (Nat.div_le_self _ _) (by omega))) (hW _ (by omega)) s Gn' rfl
  have g5 : P3 κ γ recs M A Gn' 0 rNB = (nMv κ M : ℤ) :: [] := by
    simp +decide [P3, Function.update_apply, Gn', Gn]
  have S5 := Sp.pop s (P3 κ γ recs M A Gn' 0) (B := Bb) (by decide) g5
    (hW _ (by have := nMv_le κ M; omega))
  have e5 : Function.update (P3 κ γ recs M A Gn' 0) rNB [] =
      Function.update (fun _ => []) 0 (flR (fun d => recs (γ d)) M) := by
    funext r
    simp only [P3, Gn', Gn]
    by_cases a1 : r = rNB
    · subst a1; simp +decide
    by_cases a7 : r = 0
    · subst a7; simp +decide [restR_zero]
    simp +decide [Function.update_apply, a1, a7, stkF, stkK, flL]
  rw [e5] at S5
  have H := (FSp.of_norep rfl S1).seq ((FSp.of_norep rfl S2).seq (SP1.seq ((FSp.of_norep rfl S3).seq
    (SR.seq (SP3.seq (FSp.of_norep rfl S5))))))
  refine H.mono ?_
  clear H S1 S2 SP1 S3 SR SP3 S5
  simp only [cCorrG, Ex.size]
  omega

end IntMul.Kappa.R6.IL2C

