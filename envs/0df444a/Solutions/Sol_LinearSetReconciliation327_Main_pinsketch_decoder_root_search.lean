      (MemoryFrame.update_allowed _ _ 90 0 (by left; dsimp [rootSeedMeta]; omega))
  obtain ⟨hCopySourceAt, hRest1⟩ := At.seqStmt hAt
  obtain ⟨hCopyBaseAt, hRest2⟩ := At.seqStmt hRest1
  obtain ⟨hZeroAt, hRest3⟩ := At.seqStmt hRest2
  obtain ⟨hKeepAt, hRest4⟩ := At.seqStmt hRest3
  obtain ⟨hCountAt, hRestoreAt⟩ := At.seqStmt hRest4
  have hCopySource : Sem P E pc (pc + 22) (boundaryState pc m)
