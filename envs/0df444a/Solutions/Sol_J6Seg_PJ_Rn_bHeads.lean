namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

section pieces
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ} {u : Vr} {c : Cs}

theorem BdS.two (h : BdS W m L Mf) : (2 : ℕ) ≤ 2 ^ W :=
  calc 2 = 2 ^ 1 := by norm_num
    _ ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) h.1

theorem BdS.Lb (h : BdS W m L Mf) : ∀ y ∈ L.map (fun j : ℕ => (j : ℤ)), |y| ≤ 2 ^ W := by
  intro y hy; simp only [List.mem_map] at hy; obtain ⟨j, hj, rfl⟩ := hy
  simp only [Nat.abs_cast]; exact_mod_cast h.2.2.1 j hj

theorem BdS.Mb (h : BdS W m L Mf) : ∀ y ∈ matL Mf m, |y| ≤ 2 ^ W := matL_mem_bnd h.2.2.2

/-- **Head of a backward record.** -/
theorem Rn.bHeads_sol_aux (hF : Fx Q kk m mw cB u) (hS : StS m L Mf c) (hB : BdS W m L Mf)
    (hLm : L.length = m) (hv : BV W u) {r n : ℕ} (h1 : u 1 = r) (hr : r < m) (h22 : u 22 = n)
    (hn : n + 1 ≤ 2 ^ W) :
    Rn (progL bHead) u c (fun u' => u' 4 = Lg L r ∧ u' 22 = (n : ℤ) + flg cB L r ∧ u' 3 = 0 ∧
      (∀ i ∉ ([3, 4, 5, 6, 22, 29] : List (Fin HS)), u' i = u i) ∧ BV W u')
      (update c 41 (Mf r r :: 2 ^ kk / (2 * Mf r r) :: flg cB L r :: c 41))
      (costL W (m * m + m) bHead) := by
  obtain ⟨f9, f10, f11, f12, f21, f28⟩ := hF
  obtain ⟨hM, hL⟩ := hS
  have h2W := hB.two
  have ei : (r : ℤ) * m + r = ((r * m + r : ℕ) : ℤ) := by push_cast; ring
  have g1 : (matL Mf m).getD (r * m + r) 0 = Mf r r := matL_get2 Mf hr hr
  have hfl : (1 : ℤ) - (if (Lg L r : ℤ) < cB then 1 else 0) = flg cB L r := by
    simp only [flg]; split_ifs <;> omega
  have hok : OkL W (m * m + m) bHead (u, c) := by
    simp (disch := decide) only [bHead, OkL, runL, Ins.run, Ins.ok, E.den, update_of_ne,
      update_self, h1, h22, f12, f21, f28, hM, hL, ei, Int.toNat_natCast, castL_getD, g1,
      matL_length, List.length_map, hLm, den_ltE]
    have h2W' : (2 : ℤ) ≤ 2 ^ W := by exact_mod_cast h2W
    have hn' : (n : ℤ) + 1 ≤ 2 ^ W := by exact_mod_cast hn
    have hn0 : (0 : ℤ) ≤ n := by positivity
    and_intros
    all_goals (first | assumption | assumption_mod_cast | (push_cast; omega) | positivity | decide | (refine le_trans (b := 2) (by decide) ?_; assumption) | (rw [abs_le]; split_ifs <;> constructor <;> linarith) | skip)
    all_goals first | exact hB.Mb | exact hB.Lb | exact_mod_cast idx_lt hr hr | (simp only [flg]; split_ifs <;> (rw [abs_le]; constructor <;> push_cast <;> omega)) | skip
    done
  have h := Rn.insL hB.2.1 bHead hv hok
  have hc : (runL bHead (u, c)).2 =
      update c 41 (Mf r r :: 2 ^ kk / (2 * Mf r r) :: flg cB L r :: c 41) := by
    simp (disch := decide) only [bHead, runL, Ins.run, E.den, update_of_ne, update_self, update_idem,
      h1, h22, f12, f21, f28, hM, hL, ei, Int.toNat_natCast, castL_getD, g1, den_ltE, hfl]
  rw [hc] at h
  refine h.mono (fun u' hu => ?_) le_rfl
  obtain ⟨e, hb⟩ := hu
  subst e
  refine ⟨?_, ?_, ?_, ?_, hb⟩
  · simp (disch := decide) only [bHead, runL, Ins.run, E.den, update_of_ne, update_self, h1,
      hL, Int.toNat_natCast, castL_getD]
  · simp (disch := decide) only [bHead, runL, Ins.run, E.den, update_of_ne, update_self, h1,
      h22, f12, hL, Int.toNat_natCast, castL_getD, den_ltE, hfl]
  · simp (disch := decide) only [bHead, runL, Ins.run, E.den, update_of_ne, update_self]
  · intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    obtain ⟨i3, i4, i5, i6, i22, i29⟩ := hi
    simp only [bHead, runL, Ins.run, update_apply, i3, i4, i5, i6, i22, i29, if_false]

end pieces

