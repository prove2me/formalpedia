theorem liesOverPrime_of_charP (A : ValuationSubring (AlgebraicClosure ℚ)) (p : ℕ)
    [CharP (ResidueField ↥A) p] : A.LiesOverPrime p := by
  rw [ValuationSubring.LiesOverPrime, ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal]
  refine ⟨natCast_mem A p, ?_⟩
  rw [← IsLocalRing.residue_eq_zero_iff]
  have h : (⟨((p : ℕ) : AlgebraicClosure ℚ), natCast_mem A p⟩ : ↥A) = ((p : ℕ) : ↥A) :=
    Subtype.ext (by push_cast; rfl)
  rw [h, map_natCast, CharP.cast_eq_zero]

theorem exists_place_of_correspondence_single_ne_zero {K F F' : Type*} [Field K] [Field F] [Field F']
    [Algebra K F] [Algebra K F'] [HasPrincipalDivisors K F'] (φ ψ : F →ₐ[K] F')
    (hφ : φ.toRingHom.IsIntegral) (hψ : ψ.toRingHom.IsIntegral) (v u : Place K F)
    (h : Divisor.correspondence φ ψ hφ hψ (Finsupp.single v 1) u ≠ 0) :
    ∃ Y : Place K F', Y.restrictAlong φ hφ = v ∧ Y.restrictAlong ψ hψ = u := by
  classical
  rw [Divisor.correspondence_apply, Divisor.pullbackAlong_single, map_sum,
    Finsupp.finsetSum_apply] at h
  obtain ⟨W, hW, hne⟩ := Finset.exists_ne_zero_of_sum_ne_zero h
  rw [Divisor.pushforwardAlong_single, Finsupp.single_apply] at hne
  split_ifs at hne with hu
  · exact ⟨W, Place.mem_fiberAlong.mp hW, hu⟩
  · exact (hne rfl).elim

theorem ramificationIndexAlong_pos {K F F' : Type*} [Field K] [Field F] [Field F']
    [Algebra K F] [Algebra K F'] (φ : F →ₐ[K] F') (hφ : φ.toRingHom.IsIntegral) (w : Place K F') :
    0 < Place.ramificationIndexAlong φ w := by
  letI := algebraAlong φ
  haveI := isScalarTower_along φ
  haveI := isIntegral_along φ hφ
  exact w.ramificationIndex_pos (F := F)

section Roof

theorem coe_equivOfEq_apply {F E : Type*} [Field F] [Field E] [Algebra F E] {S T : IntermediateField F E}
    (h : S = T) (x : S) : ((IntermediateField.equivOfEq h x : T) : E) = x := by
  simp only [IntermediateField.equivOfEq_apply]

theorem coe_equivOfEq_symm_apply {F E : Type*} [Field F] [Field E] [Algebra F E]
    {S T : IntermediateField F E} (h : S = T) (x : T) :
    (((IntermediateField.equivOfEq h).symm x : S) : E) = x := by
  simp only [IntermediateField.equivOfEq_symm, IntermediateField.equivOfEq_apply]

theorem mem_congrRingEquiv_iff {K F F' : Type*} [Field K] [Field F] [Field F'] [Algebra K F] [Algebra K F']
    (e : F ≃+* F') (he : ∀ a : K, e (algebraMap K F a) = algebraMap K F' a) (v : Place K F) (y : F') :
    y ∈ (Place.congrRingEquiv e he v).toValuationSubring ↔ e.symm y ∈ v.toValuationSubring :=
  Iff.rfl

theorem mem_restrictAlong_iff' {K F F' : Type*} [Field K] [Field F] [Field F'] [Algebra K F]
    [Algebra K F'] (φ : F →ₐ[K] F') (hφ : φ.toRingHom.IsIntegral) (w : Place K F') (x : F) :
    x ∈ (w.restrictAlong φ hφ).toValuationSubring ↔ φ x ∈ w.toValuationSubring :=
  Iff.rfl

variable {K : Type*} [Field K] [DecidableEq K] {p : ℕ} [Fact p.Prime] [CharP K p]
  {M s : ℕ} [NeZero M] [NeZero s]

theorem roof_eq (X : SSLevelDatum p K M s) : charLDegeneracyRoof K M s = modularFunctionFieldC K (M * s) := by
  apply le_antisymm
  · unfold charLDegeneracyRoof
    rw [IntermediateField.adjoin_le_iff]
    rintro x (rfl | rfl | rfl | hx)
    · exact jqModC_mem K (M * s)
    · exact X.mem_M
    · exact X.mem_s
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact jqNModC_mem K (M * s)
  · show IntermediateField.adjoin K {jqModC K, jqNModC K (M * s)} ≤ _
    unfold charLDegeneracyRoof
    apply IntermediateField.adjoin.mono
    rintro x (rfl | hx)
    · exact Or.inl rfl
    · rw [Set.mem_singleton_iff] at hx
      subst hx
      exact Or.inr (Or.inr (Or.inr rfl))

noncomputable def roofEquiv (X : SSLevelDatum p K M s) :
    ↥(charLDegeneracyRoof K M s) ≃ₐ[K] ↥(modularFunctionFieldC K (M * s)) :=
  IntermediateField.equivOfEq (roof_eq X)

theorem coe_roofEquiv (X : SSLevelDatum p K M s) (x : ↥(charLDegeneracyRoof K M s)) :
    ((roofEquiv X x : ↥(modularFunctionFieldC K (M * s))) : LaurentSeries K) = x :=
  coe_equivOfEq_apply (roof_eq X) x

theorem coe_roofEquiv_symm (X : SSLevelDatum p K M s) (x : ↥(modularFunctionFieldC K (M * s))) :
    (((roofEquiv X).symm x : ↥(charLDegeneracyRoof K M s)) : LaurentSeries K) = x :=
  coe_equivOfEq_symm_apply (roof_eq X) x

noncomputable def roofRingEquiv (X : SSLevelDatum p K M s) :
    ↥(charLDegeneracyRoof K M s) ≃+* ↥(modularFunctionFieldC K (M * s)) :=
  (roofEquiv X).toRingEquiv

theorem roofRingEquiv_apply (X : SSLevelDatum p K M s) (y : ↥(charLDegeneracyRoof K M s)) :
    roofRingEquiv X y = roofEquiv X y :=
  congrFun (roofEquiv X).coe_ringEquiv' y

theorem roofRingEquiv_symm_apply (X : SSLevelDatum p K M s) (x : ↥(modularFunctionFieldC K (M * s))) :
    (roofRingEquiv X).symm x = (roofEquiv X).symm x := by
  show (roofEquiv X).toRingEquiv.symm x = _
  rw [AlgEquiv.toRingEquiv_symm, AlgEquiv.coe_ringEquiv]

theorem roofRingEquiv_commutes (X : SSLevelDatum p K M s) (a : K) :
    roofRingEquiv X (algebraMap K _ a) = algebraMap K _ a := by
  rw [roofRingEquiv_apply]
  exact (roofEquiv X).commutes a

theorem roofEquiv_symm_levelAlphaC (X : SSLevelDatum p K M s) (x : ↥(modularFunctionFieldC K M)) :
    (roofEquiv X).symm (levelAlphaC K M s X.mem_M x) = heckeAlphaC K M s x :=
  Subtype.ext (by rw [coe_roofEquiv_symm, coe_levelAlphaC, coe_heckeAlphaC])

theorem roofEquiv_symm_levelBetaC (X : SSLevelDatum p K M s) (x : ↥(modularFunctionFieldC K M)) :
    (roofEquiv X).symm (levelBetaC K M s X.mem_s x) = heckeBetaC K M s x :=
  Subtype.ext (by rw [coe_roofEquiv_symm, coe_levelBetaC, coe_heckeBetaC])

theorem roofEquiv_symm_jGeomGen (X : SSLevelDatum p K M s) :
    (roofEquiv X).symm (jGeomGen K (M * s)) = heckeAlphaC K M s (jGeomGen K M) :=
  Subtype.ext (by rw [coe_roofEquiv_symm, coe_heckeAlphaC, coe_jGeomGen, coe_jGeomGen])

theorem roofEquiv_symm_jNGeomGen (X : SSLevelDatum p K M s) :
    (roofEquiv X).symm (jNGeomGen K (M * s)) = heckeBetaC K M s (jNGeomGen K M) := by
  apply Subtype.ext
  rw [coe_roofEquiv_symm, coe_heckeBetaC, coe_jNGeomGen, coe_jNGeomGen]
  unfold jqNModC
  rw [qExpand_qExpand]
  simp only [Nat.mul_comm s M]

theorem roofRingEquiv_heckeAlphaC (X : SSLevelDatum p K M s) (x : ↥(modularFunctionFieldC K M)) :
    roofRingEquiv X (heckeAlphaC K M s x) = levelAlphaC K M s X.mem_M x :=
  Subtype.ext (by rw [roofRingEquiv_apply, coe_roofEquiv, coe_levelAlphaC, coe_heckeAlphaC])

noncomputable def roofPlace (X : SSLevelDatum p K M s) (Y : Place K ↥(charLDegeneracyRoof K M s)) :
    Place K ↥(modularFunctionFieldC K (M * s)) :=
  Place.congrRingEquiv (roofRingEquiv X) (roofRingEquiv_commutes X) Y

theorem mem_roofPlace_iff (X : SSLevelDatum p K M s) (Y : Place K ↥(charLDegeneracyRoof K M s))
    (x : ↥(modularFunctionFieldC K (M * s))) :
    x ∈ (roofPlace X Y).toValuationSubring ↔ (roofEquiv X).symm x ∈ Y.toValuationSubring := by
  rw [roofPlace, mem_congrRingEquiv_iff, roofRingEquiv_symm_apply]

theorem restrictAlong_levelAlphaC_roofPlace (X : SSLevelDatum p K M s)
    (Y : Place K ↥(charLDegeneracyRoof K M s)) :
    Place.restrictAlong (levelAlphaC K M s X.mem_M) X.fstIntegral (roofPlace X Y) =
      Y.restrictAlong (heckeAlphaC K M s) (X.legsIntegral M s).1 := by
  apply Place.ext
  ext x
  rw [mem_restrictAlong_iff', mem_restrictAlong_iff', mem_roofPlace_iff, roofEquiv_symm_levelAlphaC]

theorem restrictAlong_levelBetaC_roofPlace (X : SSLevelDatum p K M s)
    (Y : Place K ↥(charLDegeneracyRoof K M s)) :
    Place.restrictAlong (levelBetaC K M s X.mem_s) X.sndIntegral (roofPlace X Y) =
      Y.restrictAlong (heckeBetaC K M s) (X.legsIntegral M s).2 := by
  apply Place.ext
  ext x
  rw [mem_restrictAlong_iff', mem_restrictAlong_iff', mem_roofPlace_iff, roofEquiv_symm_levelBetaC]

theorem roofPlace_mem_ssPlaces [IsAlgClosed K] (X : SSLevelDatum p K M s)
    (Y : Place K ↥(charLDegeneracyRoof K M s))
    (hYa : Y.restrictAlong (heckeAlphaC K M s) (X.legsIntegral M s).1 ∈ ssPlaces p M K)
    (hYb : Y.restrictAlong (heckeBetaC K M s) (X.legsIntegral M s).2 ∈ ssPlaces p M K) :
    roofPlace X Y ∈ ssPlaces p (M * s) K := by
  have hjM : jGeomGen K (M * s) ∈ (roofPlace X Y).toValuationSubring := by
    rw [mem_roofPlace_iff, roofEquiv_symm_jGeomGen, ← mem_restrictAlong_iff']
    exact hYa.2.1.1
  refine ⟨?_, ⟨hjM, ?_⟩, ?_⟩
  ·
    haveI := isCurveOver_modularFunctionFieldC_of_perfectField K (M * s)
    haveI : Module.Finite K (roofPlace X Y).ResidueField := IsCurveOver.finiteResidue _
    exact (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K)
      (K := (roofPlace X Y).ResidueField)).2
  · rw [mem_roofPlace_iff, roofEquiv_symm_jNGeomGen, ← mem_restrictAlong_iff']
    exact hYb.2.1.2
  ·
    set b := Y.restrictAlong (heckeAlphaC K M s) (X.legsIntegral M s).1 with hb
    set c : K := b.evalAt (jGeomGen K M) with hc
    have hcss : c ∈ ssJSet p K := hYa.2.2
    have h1 : 0 < b.ord (jGeomGen K M - algebraMap K _ c) :=
      ord_sub_evalAt_pos_of_isRational hYa.1 hYa.2.1.1 (jGeomGen_sub_algebraMap_ne_zero K M c)
    have h2 : 0 < Y.ord (heckeAlphaC K M s (jGeomGen K M - algebraMap K _ c)) := by
      rw [Place.ord_restrictAlong (heckeAlphaC K M s) (X.legsIntegral M s).1, ← hb]
      exact mul_pos (Int.natCast_pos.mpr
        (ramificationIndexAlong_pos (heckeAlphaC K M s) (X.legsIntegral M s).1 Y)) h1
    have h3 : (roofPlace X Y).ord
        (roofRingEquiv X (heckeAlphaC K M s (jGeomGen K M - algebraMap K _ c))) =
          Y.ord (heckeAlphaC K M s (jGeomGen K M - algebraMap K _ c)) :=
      Place.ord_congrRingEquiv _ (roofRingEquiv_commutes X) Y _
    have h4 : roofRingEquiv X (heckeAlphaC K M s (jGeomGen K M - algebraMap K _ c)) =
        jGeomGen K (M * s) - algebraMap K _ c := by
      rw [map_sub, map_sub, AlgHom.commutes, roofRingEquiv_commutes, roofRingEquiv_heckeAlphaC]
      rfl
    rw [h4] at h3
    have h5 : 0 < (roofPlace X Y).ord (jGeomGen K (M * s) - algebraMap K _ c) := by
      rw [h3]; exact h2
    have h6 : (roofPlace X Y).evalAt (jGeomGen K (M * s)) = c := by
      rw [Place.evalAt_congr (roofPlace X Y) hjM ((roofPlace X Y).algebraMap_mem' c) (Or.inr h5)]
      exact Place.evalAt_algebraMap _ c
    rw [h6]
    exact hcss

end Roof

theorem nodeUnit_apply_eq_of_eq_zero (A : ValuationSubring (AlgebraicClosure ℚ)) (N : ℕ) [NeZero N]
    (S : Finset (Place (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) N) ×
      Place (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) N)))
    (w : ↥S → Additive (ResidueField ↥A)ˣ) (h : GluedPic0.nodeUnit S w = 0) (t t' : ↥S) :
    w t = w t' := by
  rw [GluedPic0.nodeUnit_apply, GluedPic0.mk_eq_zero_iff] at h
  obtain ⟨g₁, g₂, a, b, -, -, hd₁, hd₂, hv, hw⟩ := h
  have hconst : ∀ g : ↥(modularFunctionFieldC (ResidueField ↥A) N),
      (∀ v : Place (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) N), v.ord g = 0) →
        ∃ c : ResidueField ↥A, g = algebraMap _ _ c := by
    intro g hg
    haveI := finiteDimensional_adjoin_jqModC (N := N) A
    have hj : Transcendental (ResidueField ↥A)
        ((⟨jqModC (ResidueField ↥A), jqModC_mem (ResidueField ↥A) N⟩ :
          modularFunctionFieldC (ResidueField ↥A) N) :
            ↥(modularFunctionFieldC (ResidueField ↥A) N)) := by
      rw [← transcendental_algebraMap_iff (R := ResidueField ↥A)
        (S := ↥(modularFunctionFieldC (ResidueField ↥A) N)) (A := LaurentSeries (ResidueField ↥A))
        (algebraMap (↥(modularFunctionFieldC (ResidueField ↥A) N)) (LaurentSeries (ResidueField ↥A))).injective]
      exact transcendental_jqModC (ResidueField ↥A)
    obtain ⟨c, hc⟩ := Place.mem_range_algebraMap_of_forall_ord_eq_zero_of_isAlgClosed _ hj hg
    exact ⟨c, hc.symm⟩
  obtain ⟨c₁, rfl⟩ := hconst g₁ (fun v => by simpa using (hd₁ v).symm)
  obtain ⟨c₂, rfl⟩ := hconst g₂ (fun v => by simpa using (hd₂ v).symm)
  have ha : ∀ r : ↥S, ((a r : (ResidueField ↥A)ˣ) : ResidueField ↥A) = c₁ := fun r => by
    obtain ⟨hmem, hres⟩ := (hv r).1
    apply (algebraMap (ResidueField ↥A) (r.1.1).ResidueField).injective
    rw [← hres]
    exact ((r.1.1).residue_algebraMap c₁).symm
  have hb : ∀ r : ↥S, ((b r : (ResidueField ↥A)ˣ) : ResidueField ↥A) = c₂ := fun r => by
    obtain ⟨hmem, hres⟩ := (hv r).2
    apply (algebraMap (ResidueField ↥A) (r.1.2).ResidueField).injective
    rw [← hres]
    exact ((r.1.2).residue_algebraMap c₂).symm
  have hat : a t = a t' := Units.val_injective ((ha t).trans (ha t').symm)
  have hbt : b t = b t' := Units.val_injective ((hb t).trans (hb t').symm)
  have hw' : w = fun r => Additive.ofMul (a r / b r) := hw
  rw [hw']
  simp only [hat, hbt]

theorem mem_iff_mem_of_entry_ne_zero {K : Type*} [Field K] [DecidableEq K] [IsAlgClosed K]
    {p : ℕ} [Fact p.Prime] [CharP K p] {M s : ℕ} [NeZero M] [NeZero s]
    (X : SSLevelDatum p K M s) [HasPrincipalDivisors K ↥(charLDegeneracyRoof K M s)]
    (S : Finset (Place K ↥(modularFunctionFieldC K M) × Place K ↥(modularFunctionFieldC K M)))
    (e₂ : ↥(ssPlaces p M K) ≃ ↥S) (hnode : ∀ b : ↥S, b.1.1 = (e₂.symm b).1)
    (T : Matrix ↥S ↥S ℤ)
    (hTab : ∀ a b : ↥S, T a b = Divisor.correspondence (heckeAlphaC K M s) (heckeBetaC K M s)
      (X.legsIntegral M s).1 (X.legsIntegral M s).2 (Finsupp.single b.1.1 1) a.1.1)
    (P : Set ↥(ssPlaces p M K)) (hP : ∀ W : ↥(ssPlaces p (M * s) K), X.fst W ∈ P ↔ X.snd W ∈ P)
    (a b : ↥S) (hab0 : T a b ≠ 0) : e₂.symm b ∈ P ↔ e₂.symm a ∈ P := by
  rw [hTab a b] at hab0
  obtain ⟨Y, hYa, hYb⟩ := exists_place_of_correspondence_single_ne_zero _ _ _ _ _ _ hab0
  have hYa' : Y.restrictAlong (heckeAlphaC K M s) (X.legsIntegral M s).1 ∈ ssPlaces p M K := by
    rw [hYa, hnode b]; exact (e₂.symm b).2
  have hYb' : Y.restrictAlong (heckeBetaC K M s) (X.legsIntegral M s).2 ∈ ssPlaces p M K := by
    rw [hYb, hnode a]; exact (e₂.symm a).2
  have hW := roofPlace_mem_ssPlaces X Y hYa' hYb'
  have key := hP ⟨roofPlace X Y, hW⟩
  have hfst : X.fst ⟨roofPlace X Y, hW⟩ = e₂.symm b := by
    apply Subtype.ext
    show Place.restrictAlong (levelAlphaC K M s X.mem_M) X.fstIntegral (roofPlace X Y) = _
    rw [restrictAlong_levelAlphaC_roofPlace, hYa, hnode b]
  have hsnd : X.snd ⟨roofPlace X Y, hW⟩ = e₂.symm a := by
    apply Subtype.ext
    show Place.restrictAlong (levelBetaC K M s X.mem_s) X.sndIntegral (roofPlace X Y) = _
    rw [restrictAlong_levelBetaC_roofPlace, hYb, hnode a]
  rwa [hfst, hsnd] at key

theorem sum_mul_indicator_eq {ι : Type*} [Fintype ι] (T : Matrix ι ι ℤ) (c : ℤ)
    (hcol : ∀ t, ∑ r, T r t = c) (Q : ι → Prop) [DecidablePred Q]
    (hedge : ∀ a b, T a b ≠ 0 → (Q b ↔ Q a)) (t : ι) :
    ∑ r, T r t * (if Q r then 1 else 0) = c * (if Q t then 1 else 0) := by
  by_cases ht : Q t
  · have hrt : ∀ r, T r t * (if Q r then 1 else 0) = T r t := fun r => by
      by_cases h0 : T r t = 0
      · rw [h0, zero_mul]
      · rw [if_pos ((hedge r t h0).mp ht), mul_one]
    rw [Finset.sum_congr rfl (fun r _ => hrt r), hcol t, if_pos ht, mul_one]
  · have hrt : ∀ r, T r t * (if Q r then 1 else 0) = 0 := fun r => by
      by_cases h0 : T r t = 0
      · rw [h0, zero_mul]
      · rw [if_neg (fun hr => ht ((hedge r t h0).mpr hr)), mul_zero]
    rw [Finset.sum_congr rfl (fun r _ => hrt r), Finset.sum_const_zero, if_neg ht, mul_zero]

set_option maxHeartbeats 32000000 in

theorem infinite_setOf_heckeGen_sub_C_smul_eq_zero
    (A : ValuationSubring (AlgebraicClosure ℚ)) (N q' : ℕ) [NeZero N] (hq' : q'.Prime)
    [CharP (ResidueField ↥A) q'] [Module HeckeAlg (JZero (N * q'))]
    (S : Finset (Place (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) N) ×
      Place (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) N)))
    {C : Type*} [AddCommGroup C] (comp : ↥(inertiaInvariants A (N * q')) →+ C)
    (sp : ↥(inertiaInvariants A (N * q')) →+
      GluedPic0 (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) N) S)
    (comp_hecke : ∀ (τ : HeckeAlg) (x : ↥(inertiaInvariants A (N * q')))
      (hx : τ • (x : JZero (N * q')) ∈ inertiaInvariants A (N * q')), comp x = 0 → comp ⟨τ • x, hx⟩ = 0)
    (sp_injective : ∀ x : ↥(inertiaInvariants A (N * q')),
      PrimeToTorsion q' (x : JZero (N * q')) → comp x = 0 → sp x = 0 → x = 0)
    (hlift : ∀ m : ℕ, m.Coprime q' →
      ∀ g : GluedPic0 (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) N) S,
        (m : ℤ) • g = 0 → ∃ x : ↥(inertiaInvariants A (N * q')),
          (m : ℤ) • (x : JZero (N * q')) = 0 ∧ comp x = 0 ∧ sp x = g)
    (ℓ : Nat.Primes) (T : Matrix ↥S ↥S ℤ)
    (htrans : ∀ (x : ↥(inertiaInvariants A (N * q')))
      (hx : heckeGen ℓ • (x : JZero (N * q')) ∈ inertiaInvariants A (N * q')),
      comp x = 0 → ∀ w : ↥S → Additive (ResidueField ↥A)ˣ, sp x = GluedPic0.nodeUnit S w →
        sp ⟨heckeGen ℓ • (x : JZero (N * q')), hx⟩ = GluedPic0.nodeUnit S (fun t => ∑ r, T r t • w r))
    (hgal : ∀ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (y : JZero (N * q')),
      heckeGen ℓ • (σ • y) = σ • (heckeGen ℓ • y))
    (hleft : ∀ w : ↥S → Additive (ResidueField ↥A)ˣ, GluedPic0.nodeUnit S w = 0 → ∀ t t' : ↥S, w t = w t')
    (c : ℤ) (u : ↥S → ℤ) (hu : ∀ t, ∑ r, T r t * u r = c * u t)
    (t₁ t₀ : ↥S) (hu₁ : u t₁ = 1) (hu₀ : u t₀ = 0)
    (r : ℕ) (hr : r.Prime) (hrq : r ≠ q') :
    Set.Infinite {y : JZero (N * q') | (heckeGen ℓ - MvPolynomial.C c) • y = 0} := by
  have sum_zsmul_const : ∀ (f : ↥S → ℤ) (z : Additive (ResidueField ↥A)ˣ),
      ∑ i, f i • z = (∑ i, f i) • z := fun f z =>
    (Finset.sum_smul (R := ℤ) (M := Additive (ResidueField ↥A)ˣ) (s := Finset.univ) (f := f) (x := z)).symm

  have hrκ : (r : ResidueField ↥A) ≠ 0 := by
    rw [Ne, CharP.cast_eq_zero_iff (ResidueField ↥A) q' r]
    intro h
    exact hrq ((Nat.prime_dvd_prime_iff_eq hq' hr).mp h).symm
  haveI : NeZero ((r : ℕ) : ResidueField ↥A) := ⟨hrκ⟩
  have hcop : ∀ n : ℕ, (r ^ n).Coprime q' := fun n =>
    Nat.Coprime.pow_left n ((Nat.coprime_primes hr hq').mpr hrq)
  have hprim : ∀ n : ℕ, ∃ ζ : (ResidueField ↥A)ˣ, IsPrimitiveRoot ζ (r ^ n) := fun n => by
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (ResidueField ↥A) (r ^ n)
    have hζu : IsUnit ζ := hζ.isUnit (pow_ne_zero n hr.ne_zero)
    refine ⟨hζu.unit, IsPrimitiveRoot.coe_units_iff.mp ?_⟩
    rw [IsUnit.unit_spec]
    exact hζ
  choose ζ hζ using hprim

  obtain ⟨wn, hwn_def⟩ : ∃ wn : ℕ → (↥S → Additive (ResidueField ↥A)ˣ),
      wn = fun n t => u t • Additive.ofMul (ζ n) := ⟨_, rfl⟩
  have hwn_tors : ∀ n, ((r ^ n : ℕ) : ℤ) • GluedPic0.nodeUnit S (wn n) = 0 := by
    intro n
    have hz : ((r ^ n : ℕ) : ℤ) • wn n = 0 := by
      funext t
      rw [Pi.smul_apply, Pi.zero_apply, hwn_def]
      show ((r ^ n : ℕ) : ℤ) • (u t • Additive.ofMul (ζ n)) = 0
      rw [smul_smul, mul_comm, ← smul_smul, natCast_zsmul, ← ofMul_pow, (hζ n).pow_eq_one, ofMul_one,
        smul_zero]
    rw [← map_zsmul (GluedPic0.nodeUnit S) ((r ^ n : ℕ) : ℤ) (wn n), hz, map_zero]

  choose x hx0 hxc hxs using fun n => hlift (r ^ n) (hcop n) (GluedPic0.nodeUnit S (wn n)) (hwn_tors n)
  have hxT : ∀ n, heckeGen ℓ • ((x n : JZero (N * q'))) ∈ inertiaInvariants A (N * q') := by
    intro n
    rw [mem_inertiaInvariants]
    intro σ hσ
    rw [← hgal, (mem_inertiaInvariants.mp (x n).2) σ hσ]

  have hxeig : ∀ n, (heckeGen ℓ - MvPolynomial.C c) • ((x n : JZero (N * q'))) = 0 := by
    intro n
    have ht := htrans (x n) (hxT n) (hxc n) (wn n) (hxs n)
    have hfun : (fun t => ∑ r, T r t • wn n r) = fun t => c • wn n t := by
      funext t
      rw [hwn_def]
      show ∑ r, T r t • (u r • Additive.ofMul (ζ n)) = c • (u t • Additive.ofMul (ζ n))
      simp only [smul_smul]
      rw [sum_zsmul_const, hu t]
    have ht' : sp ⟨heckeGen ℓ • (x n : JZero (N * q')), hxT n⟩ = sp (c • x n) := by
      rw [ht, hfun, map_zsmul sp c (x n), hxs]
      exact map_zsmul (GluedPic0.nodeUnit S) c (wn n)
    have hPT : PrimeToTorsion q' (x n : JZero (N * q')) := by
      refine ⟨r ^ n, pow_pos hr.pos n, ?_, ?_⟩
      · intro h
        exact hrq ((Nat.prime_dvd_prime_iff_eq hq' hr).mp (hq'.dvd_of_dvd_pow h)).symm
      · rw [← natCast_zsmul]
        exact hx0 n
    have hy0 : (⟨heckeGen ℓ • (x n : JZero (N * q')), hxT n⟩ : ↥(inertiaInvariants A (N * q')))
        - c • x n = 0 := by
      apply sp_injective
      · have e : (((⟨heckeGen ℓ • (x n : JZero (N * q')), hxT n⟩ : ↥(inertiaInvariants A (N * q')))
            - c • x n : ↥(inertiaInvariants A (N * q'))) : JZero (N * q')) =
              heckeGen ℓ • (x n : JZero (N * q')) + -(c • (x n : JZero (N * q'))) := by
          rw [AddSubgroupClass.coe_sub, AddSubgroupClass.coe_zsmul, sub_eq_add_neg]
        rw [e]
        exact PrimeToTorsion.add hq'
          (PrimeToTorsion.map (DistribSMul.toAddMonoidHom (JZero (N * q')) (heckeGen ℓ)) hPT)
          (PrimeToTorsion.neg (PrimeToTorsion.map (zsmulAddGroupHom c : JZero (N * q') →+ JZero (N * q')) hPT))
      · rw [map_sub comp, map_zsmul comp, comp_hecke _ (x n) (hxT n) (hxc n), hxc n, smul_zero, sub_zero]
      · rw [map_sub sp, ht', sub_self]
    have hval := congrArg (fun z : ↥(inertiaInvariants A (N * q')) => (z : JZero (N * q'))) hy0
    simp only [AddSubgroupClass.coe_sub, AddSubgroupClass.coe_zsmul, ZeroMemClass.coe_zero] at hval
    have hC : (MvPolynomial.C c : HeckeAlg) = (c : HeckeAlg) := eq_intCast MvPolynomial.C c
    rw [sub_smul, hC, Int.cast_smul_eq_zsmul]
    exact hval

  have hinj : Function.Injective (fun n => (x n : JZero (N * q'))) := by
    intro n n' hnn'
    have hxx : x n = x n' := Subtype.ext hnn'
    have h1 : GluedPic0.nodeUnit S (wn n) = GluedPic0.nodeUnit S (wn n') := by
      rw [← hxs, ← hxs, hxx]
    have h2 : GluedPic0.nodeUnit S (wn n - wn n') = 0 := by
      rw [map_sub, h1, sub_self]
    have h3 := hleft (wn n - wn n') h2 t₁ t₀
    rw [Pi.sub_apply, Pi.sub_apply, hwn_def] at h3
    change u t₁ • Additive.ofMul (ζ n) - u t₁ • Additive.ofMul (ζ n') =
      u t₀ • Additive.ofMul (ζ n) - u t₀ • Additive.ofMul (ζ n') at h3
    rw [hu₁, hu₀, one_smul, one_smul, zero_smul, zero_smul, sub_zero, sub_eq_zero] at h3
    have h4 : ζ n = ζ n' := Additive.ofMul.injective h3
    have h5 : r ^ n = r ^ n' := by
      rw [(hζ n).eq_orderOf, (hζ n').eq_orderOf, h4]
    exact Nat.pow_right_injective hr.two_le h5
  have hsub : Set.range (fun n => (x n : JZero (N * q'))) ⊆
      {y : JZero (N * q') | (heckeGen ℓ - MvPolynomial.C c) • y = 0} := by
    rintro _ ⟨n, rfl⟩
    exact hxeig n
  exact (Set.infinite_range_of_injective hinj).mono hsub

theorem connected
    (M s q' : ℕ) [NeZero M] [NeZero s] [Fact q'.Prime] (hs : s.Prime)
    (hsq' : s ≠ q') (hq'M : ¬ q' ∣ M) (hsM : ¬ s ∣ M)
    (A : ValuationSubring (AlgebraicClosure ℚ))
    [DecidableEq (IsLocalRing.ResidueField ↥A)] [CharP (IsLocalRing.ResidueField ↥A) q']
    (X : SSLevelDatum q' (IsLocalRing.ResidueField ↥A) M s)
    (P : Set ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)))
    (hP : ∀ W : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)), X.fst W ∈ P ↔ X.snd W ∈ P) :
    P = ∅ ∨ P = Set.univ := by
  classical
  by_contra hcon
  rw [not_or] at hcon
  obtain ⟨hne, hnu⟩ := hcon
  obtain ⟨v₁, hv₁⟩ := Set.nonempty_iff_ne_empty.mpr hne
  obtain ⟨v₀, hv₀⟩ := (Set.ne_univ_iff_exists_notMem P).mp hnu

  have hq' : q'.Prime := Fact.out
  haveI : Fact s.Prime := ⟨hs⟩
  have hsMq' : ¬ ((⟨s, hs⟩ : Nat.Primes) : ℕ) ∣ M * q' := by
    intro h
    rcases (Nat.Prime.dvd_mul hs).mp h with h | h
    · exact hsM h
    · exact hsq' ((Nat.prime_dvd_prime_iff_eq hs hq').mp h)
  have hMκ : (M : ResidueField ↥A) ≠ 0 := by
    rw [Ne, CharP.cast_eq_zero_iff (ResidueField ↥A) q' M]
    exact hq'M
  have hsκ : (s : ResidueField ↥A) ≠ 0 := by
    rw [Ne, CharP.cast_eq_zero_iff (ResidueField ↥A) q' s]
    intro h
    exact hsq' ((Nat.prime_dvd_prime_iff_eq hq' hs).mp h).symm
  have hA : A.LiesOverPrime q' := liesOverPrime_of_charP A q'
  haveI : Fintype ↥(ssPlaces q' (M * s) (ResidueField ↥A)) :=
    (ssPlaces_finite q' (M * s) (ResidueField ↥A)).fintype
  haveI : Fintype ↥(ssPlaces q' M (ResidueField ↥A)) :=
    (ssPlaces_finite q' M (ResidueField ↥A)).fintype
  haveI : HasPrincipalDivisors (ResidueField ↥A) ↥(charLDegeneracyRoof (ResidueField ↥A) M s) :=
    hasPrincipalDivisors_charLDegeneracyRoof (ResidueField ↥A) M s hMκ hsκ
  letI := heckeModuleBar (M * q')
  letI := heckeModuleBar M
  letI := heckeModuleBar ((M * s) * q')
  letI := heckeModuleBar (M * s)

  obtain ⟨instMs, instM, D₁, D₂, ab, e₁, e₂, w, wV, m, dpair, Φ, -, -, -, h4, -, -, -, -, -, -, -, -,
    -, -, -, hpack2, -, hT2, -, -, -, -⟩ :=
    CerednikDrinfeld.exists_twoLevelSemistableSpecialization_jointConstruction_ssPlaces_heckeTransport_correspondence_restrictAlong_degeneracyComp_placeWidthChar
      M s q' hs hq' hsq' hq'M hsM A hA
  obtain ⟨-, hlift, -⟩ := hpack2
  obtain ⟨T, nT, hcol, hid, htrans⟩ := hT2 ⟨s, hs⟩
  obtain ⟨hnT, hTab⟩ := hid hsq'

  have hnT' : nT = (s : ℤ) + 1 := by
    rw [hnT, finrankAlong_heckeAlphaC_residueField_eq_add_one M q' hq' hq'M A hA s hsq' hsM]
    push_cast
    rfl
  have hcol' : ∀ t : ↥D₂.nodes, ∑ r, T r t = (s : ℤ) + 1 := fun t => (hcol t).trans hnT'

  have hnode : ∀ b : ↥D₂.nodes, b.1.1 = (e₂.symm b).1 := fun b => by
    simpa using h4 (e₂.symm b)
  have hedge : ∀ a b : ↥D₂.nodes, T a b ≠ 0 → (e₂.symm b ∈ P ↔ e₂.symm a ∈ P) :=
    mem_iff_mem_of_entry_ne_zero X D₂.nodes e₂ hnode T
      (hTab (X.legsIntegral M s).1 (X.legsIntegral M s).2) P hP
  have hu := sum_mul_indicator_eq T ((s : ℤ) + 1) hcol' (fun t => e₂.symm t ∈ P) hedge
  have hu₁ : (if e₂.symm (e₂ v₁) ∈ P then (1 : ℤ) else 0) = 1 := by
    rw [Equiv.symm_apply_apply, if_pos hv₁]
  have hu₀ : (if e₂.symm (e₂ v₀) ∈ P then (1 : ℤ) else 0) = 0 := by
    rw [Equiv.symm_apply_apply, if_neg hv₀]

  have hinf := infinite_setOf_heckeGen_sub_C_smul_eq_zero A M q' hq' D₂.nodes D₂.comp D₂.sp
    D₂.comp_hecke_of_comp_eq_zero D₂.sp_injective hlift ⟨s, hs⟩ T htrans
    (fun σ y => heckeGen_smul_galois_smul (M * q') σ ⟨s, hs⟩ y)
    (nodeUnit_apply_eq_of_eq_zero A M D₂.nodes) ((s : ℤ) + 1)
    (fun t => if e₂.symm t ∈ P then 1 else 0) hu (e₂ v₁) (e₂ v₀) hu₁ hu₀ s hs hsq'

  have hfin := finite_setOf_heckeGen_sub_smul_eq_zero_of_not_dvd (M * q') ⟨s, hs⟩ hsMq'
  exact hinf hfin

