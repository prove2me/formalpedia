          ((eX (heckeGen ⟨s, hs⟩ • x)).2 : ↥(ssPlaces c M K) → ℤ) = ((s : ℕ) : ℤ) • ((eX x).1 : ↥(ssPlaces c M K) → ℤ))) := by
  classical
  refine ⟨?_, ?_⟩
  ·
    let g : Nat.Primes → Module.End ℤ ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData) :=
      fun ℓ => CerednikDrinfeld.heckeKernelMap X.heckeData ℓ
    have hg : ∀ a b, g a * g b = g b * g a := by
      intro a b
      refine LinearMap.ext fun x => Subtype.ext ?_
      show ((CerednikDrinfeld.heckeKernelMap X.heckeData a (CerednikDrinfeld.heckeKernelMap X.heckeData b x) :
          ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData)) : ↥(ssPlaces c (M * s) K) → ℤ) =
        ((CerednikDrinfeld.heckeKernelMap X.heckeData b (CerednikDrinfeld.heckeKernelMap X.heckeData a x) :
          ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData)) : ↥(ssPlaces c (M * s) K) → ℤ)
      rw [sw5_heckeKernelMap_coe, sw5_heckeKernelMap_coe, sw5_heckeKernelMap_coe, sw5_heckeKernelMap_coe,
        Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, (X.heckeData.comm a b).eq]
    letI := jg2_module g hg
    exact ⟨↥(CerednikDrinfeld.ribbonKernel X.degeneracyData), inferInstance, inferInstance, sw5_finite_sub _,
      AddEquiv.refl _, fun ℓ m => jg2_heckeGen_smul g hg ℓ m⟩
  ·
    let P := ↥(characterLattice ↥(ssPlaces c M K))
    let T : Nat.Primes → (P →ₗ[ℤ] P) := fun ℓ =>
      (heckeCharacterAction (X.vertexHecke ℓ).transpose (hcolV ℓ)).toAddMonoidHom.toIntLinearMap
    have hTcoe : ∀ (ℓ : Nat.Primes) (x : P), ((T ℓ x : P) : ↥(ssPlaces c M K) → ℤ) = (X.vertexHecke ℓ).mulVec (x : ↥(ssPlaces c M K) → ℤ) :=
      fun ℓ x => sw5_hca_coe (X.vertexHecke ℓ) (hcolV ℓ) x
    have hTT : ∀ (a b : Nat.Primes) (x : P), T a (T b x) = T b (T a x) := by
      intro a b x
      apply Subtype.ext
      rw [hTcoe, hTcoe, hTcoe, hTcoe, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, (hlaws.2.1 a b).eq]
    let C : (P × P) →ₗ[ℤ] (P × P) :=
      LinearMap.prod ((T ⟨s, hs⟩).comp (LinearMap.fst ℤ P P) - LinearMap.snd ℤ P P) (((s : ℕ) : ℤ) • LinearMap.fst ℤ P P)
    have hC : ∀ x : P × P, C x = (T ⟨s, hs⟩ x.1 - x.2, ((s : ℕ) : ℤ) • x.1) := fun x => rfl
    let g : Nat.Primes → Module.End ℤ (P × P) := fun ℓ => if (ℓ : ℕ) = s then C else LinearMap.prodMap (T ℓ) (T ℓ)
