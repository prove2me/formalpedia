theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] (pi : O) (hpi : Irreducible pi) (u : (TypeDensity.TwoSeries O)ˣ) (a b : ℕ)
    (hb : 0 < b) :
    ∃ q : (TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span {TypeDensity.surfaceX O pi u a b}) ≃+* PowerSeries
    (IsLocalRing.ResidueField O), ∀ s : TypeDensity.TwoSeries O, q
    (Ideal.Quotient.mk (Ideal.span {TypeDensity.surfaceX O pi u a b}) (TypeDensity.surfaceMk O pi u a b s)) =
    TypeDensity.residueKillX O s := by
  obtain ⟨-, -, -, hsurj, hker, -⟩ := TypeDensity.residueKillX_apply_ker O pi hpi
  set I := TypeDensity.surfaceIdeal O pi u a b
  set J : Ideal (TypeDensity.TwoSeries O) := Ideal.span {TypeDensity.axisX O}
  have h1 : Ideal.span {TypeDensity.surfaceX O pi u a b} = J.map (Ideal.Quotient.mk I) := by
    rw [Ideal.map_span, Set.image_singleton]; rfl
  have hdiff : TypeDensity.surfaceRelation O pi u a b - MvPowerSeries.C pi ∈ J := by
    obtain ⟨b', rfl⟩ : ∃ b', b = b' + 1 := ⟨b - 1, by omega⟩
    have : TypeDensity.surfaceRelation O pi u a (b'+1) - MvPowerSeries.C pi
        = TypeDensity.axisX O * (-(u : TypeDensity.TwoSeries O) * TypeDensity.axisT O ^ a * TypeDensity.axisX O ^ b') := by
      unfold TypeDensity.surfaceRelation; ring
    rw [this]; exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
  have hX : TypeDensity.axisX O ∈ J := Ideal.subset_span rfl
  have h2 : I ⊔ J = RingHom.ker (TypeDensity.residueKillX O) := by
    rw [hker]
    apply le_antisymm
    · refine sup_le ?_ ?_
      · refine Ideal.span_le.2 ?_
        rintro _ rfl
        have : TypeDensity.surfaceRelation O pi u a b =
            (TypeDensity.surfaceRelation O pi u a b - MvPowerSeries.C pi) + MvPowerSeries.C pi := by ring
        change _ ∈ _
        rw [this]
        refine Ideal.add_mem _ ?_ (Ideal.subset_span (by simp))
        exact (Ideal.span_mono (by simp) : J ≤ _) hdiff
      · exact Ideal.span_mono (by simp)
    · refine Ideal.span_le.2 ?_
      rintro _ (rfl | rfl)
      · have : (MvPowerSeries.C pi : TypeDensity.TwoSeries O) = TypeDensity.surfaceRelation O pi u a b -
          (TypeDensity.surfaceRelation O pi u a b - MvPowerSeries.C pi) := by ring
        rw [SetLike.mem_coe, this]
        exact Ideal.sub_mem _ (Ideal.mem_sup_left (Ideal.subset_span rfl))
            (Ideal.mem_sup_right hdiff)
      · exact Ideal.mem_sup_right hX
  refine ⟨((Ideal.quotEquivOfEq h1).trans (DoubleQuot.quotQuotEquivQuotSup I J)).trans
    ((Ideal.quotEquivOfEq h2).trans (RingHom.quotientKerEquivOfSurjective hsurj)), fun _ ↦ rfl⟩
