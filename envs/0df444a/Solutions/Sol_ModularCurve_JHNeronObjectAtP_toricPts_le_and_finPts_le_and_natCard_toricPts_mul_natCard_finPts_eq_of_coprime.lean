  obtain ⟨e, -⟩ := ModularCurve.JHNeronObjectAtP.exists_addEquiv_toricPts_characterLattice_hom_of_ptsSp_nodeUnit
    p M H hpM A hA Λ O m hm hmp (hker_of O hpM2)
