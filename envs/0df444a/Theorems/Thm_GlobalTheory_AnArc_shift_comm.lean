variable {O : Type} [CommRing O] [StarRing O] (A : AnArc O)
variable (k : ℕ) [NeZero k]

theorem GlobalTheory.AnArc.shift_comm (la la' : A.La) (α : A.X) (th : (Fin A.gB → ℂ) → ℂ) :
    A.shift k la (α + la'.y) (A.shift k la' α th) =
      eTwoPi (-(A.EF la la' / k)) • A.shift k la' (α + la.y) (A.shift k la α th) := by sorry
