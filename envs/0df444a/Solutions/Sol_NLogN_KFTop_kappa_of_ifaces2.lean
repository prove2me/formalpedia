  show _ ∧ _; exact ⟨ha, hb⟩

theorem prcOK_ite {c : Ex HS} {a b : RM} (ha : RM.PrcOK I iprog pc a) (hb : RM.PrcOK I iprog pc b) :
    RM.PrcOK I iprog pc (.ite c a b) := by
  show _ ∧ _; exact ⟨ha, hb⟩

theorem prcOK_rs (q : RS) : RM.PrcOK I iprog pc (.rs q) := by show True; trivial

theorem prcOK_op (o : IOp HS) : RM.PrcOK I iprog pc (.op o) := by show True; trivial

theorem prcOK_mul (k i j : Fin HS) : RM.PrcOK I iprog pc (.mul k i j) := by show True; trivial

theorem prcOK_rep {i : Fin HS} {e : Ex HS} {b : RM} (h : RM.PrcOK I iprog pc b) :
    RM.PrcOK I iprog pc (.rep i e b) := h

theorem prcOK_brk (l : List (Fin HS × Ex HS)) {Q : RM} (h : RM.PrcOK I iprog pc Q) :
    RM.PrcOK I iprog pc (brk l Q) :=
  prcOK_seq pc (prcOK_rs pc _) (prcOK_seq pc h (prcOK_rs pc _))

end basic

theorem prcOK_of_noPrc {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} (pc : ℕ → Fin P) :
    ∀ p : RM, noPrc p = true → RM.PrcOK I iprog pc p
  | .rs q, _ => prcOK_rs pc q
  | .mul k i j, _ => prcOK_mul pc k i j
  | .op o, _ => prcOK_op pc o
  | .seq a b, h => by
    simp only [noPrc, Bool.and_eq_true] at h
    exact prcOK_seq pc (prcOK_of_noPrc pc a h.1) (prcOK_of_noPrc pc b h.2)
  | .ite _ a b, h => by
    simp only [noPrc, Bool.and_eq_true] at h
    exact prcOK_ite pc (prcOK_of_noPrc pc a h.1) (prcOK_of_noPrc pc b h.2)
  | .rep _ _ b, h => prcOK_rep pc (prcOK_of_noPrc pc b h)
  | .prc .., h => by simp [noPrc] at h

theorem noPrc_sap : noPrc sapAxQ = true := by decide

theorem noPrc_bap : noPrc bap0AxQ = true := by decide

section prc

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {jT : Fin P}
  {X Y dT : Fin HS} {Kc : ℝ} (hT : TrHyp I iprog jT dT Kc) (hdT : dT ≠ 0) (hXY : X ≠ Y)
  (hXD : X ≠ dT) (hYD : Y ≠ dT) (hX0 : X ≠ 0) (pc : ℕ → Fin P)
  (hW : iprog (pc 1) = trW X Y dT jT)
include hT hdT hXY hXD hYD hX0 hW

theorem prcOK_trBlk (rw rm : Fin HS) : RM.PrcOK I iprog pc (trBlk X Kc rw rm) :=
  prcOK_seq pc (prcOK_op pc _) (prcOK_seq pc (prcOK_rs pc _) (trPrc_ok hT hdT hXY hXD hYD hX0 pc hW))

theorem prcOK_progA : RM.PrcOK I iprog pc (progA X Kc) := by
  have h1 := prcOK_trBlk hT hdT hXY hXD hYD hX0 pc hW zw zm
  have h2 := prcOK_of_noPrc (I := I) (iprog := iprog) pc _ noPrc_sap
  refine prcOK_seq pc (prcOK_rs pc _) (prcOK_seq pc (prcOK_rep pc ?_) (prcOK_rs pc _))
  exact prcOK_seq pc (prcOK_rs pc _) (prcOK_brk pc _ (prcOK_brk pc _
    (prcOK_seq pc (prcOK_brk pc _ h1) (prcOK_brk pc _ h2))))

theorem prcOK_progB : RM.PrcOK I iprog pc (progB X Kc) := by
  have h1 := prcOK_trBlk hT hdT hXY hXD hYD hX0 pc hW zw zm
  have h2 := prcOK_of_noPrc (I := I) (iprog := iprog) pc _ noPrc_bap
  refine prcOK_seq pc (prcOK_rs pc _) (prcOK_seq pc (prcOK_rep pc ?_) (prcOK_rs pc _))
  exact prcOK_seq pc (prcOK_rs pc _) (prcOK_brk pc _ (prcOK_brk pc _
    (prcOK_seq pc (prcOK_rs pc _) (prcOK_seq pc (prcOK_seq pc (prcOK_brk pc _ h1)
      (prcOK_brk pc _ h2)) (prcOK_rs pc _)))))

end prc

theorem descLineN_eq (n : ℕ) :
    KFM.descLineN n = NLogN.KFY.descL (pP n) (αP n) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (KFM.dpN n) (srcsN n) := by
  simp [KFM.descLineN, KFM.descLine, NLogN.KFY.descL, KFM.bitsZ, bitL, KFM.bLn, srcsN]

theorem discL_of_getD {p : ℕ} {L : List GI} (h : ∀ x, ‖IntMul.HvdH.gC (L.getD x 0)‖ ≤ 2 ^ p) : DiscL p L := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
  have := h i
  rwa [List.getD_eq_getElem _ _ hi] at this

theorem encK_upd0 (s : IState HS) (f : Fin HS → List ℤ) (L l : List ℤ) :
    (NLogN.KIL.encK s f).upd 0 (ints L ++ (ints l ++ s.G 0)) = NLogN.KIL.encK s (Function.update f 0 (L ++ l)) := by
  apply IState.ext' _ (by rfl) (by rfl)
  intro j
  by_cases hj : j = 0
  · subst hj; simp [ints]
  · simp [hj]

theorem encK_G0 (s : IState HS) (f : Fin HS → List ℤ) (L l : List ℤ) (h : f 0 = L ++ l) :
    (NLogN.KIL.encK s f).G 0 = ints L ++ (ints l ++ s.G 0) := by
  simp [h, ints]

theorem axA_writes_eq (X : Fin HS) (K K' : ℝ) : (axA X K).writes = (axA X K').writes := by
  simp only [axA, brk, trBlk, trPrc, RM.writes]

theorem axB_writes_eq (X : Fin HS) (K K' : ℝ) : (NLogN.KFY.axB X K).writes = (NLogN.KFY.axB X K').writes := by
  simp only [NLogN.KFY.axB, brk, trBlk, trPrc, RM.writes]

theorem cX_axA (X : Fin HS) (K : ℝ) (hX : X = 2 ∨ X = 4) : cX ∉ (axA X K).writes := by
  rw [axA_writes_eq X K 0]
  rcases hX with rfl | rfl <;> decide +kernel

theorem cX_axB (X : Fin HS) (K : ℝ) (hX : X = 2 ∨ X = 4) : cX ∉ (NLogN.KFY.axB X K).writes := by
  rw [axB_writes_eq X K 0]
  rcases hX with rfl | rfl <;> decide +kernel

theorem tB_tN {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (i : Fin (IntMul.OpenAI.Glue.dP n)) : KFM.tB n i = tN n i := by
  have e := tB_eq hn i.val i.isLt
  simp only [Fin.eta] at e
  rw [e]; rfl

/-- **`TransNeed → LineNeed`.** -/
theorem lineNeed_of_transNeed (hTN : KFM.TransNeed) : KFM.LineNeed := by
  obtain ⟨E₁, ext₁, entry, dT, K, hdT, hK, HT⟩ := hTN
  obtain ⟨X, Y, hX, hY, hXY, hXD, hYD⟩ : ∃ X Y : Fin HS, (X = 2 ∨ X = 4) ∧ (Y = 3 ∨ Y = 4) ∧
      X ≠ Y ∧ X ≠ dT ∧ Y ≠ dT := by
    by_cases h2 : dT = 2
    · subst h2; exact ⟨4, 3, Or.inr rfl, Or.inl rfl, by decide, by decide, by decide⟩
    by_cases h3 : dT = 3
    · subst h3; exact ⟨2, 4, Or.inl rfl, Or.inr rfl, by decide, by decide, by decide⟩
    by_cases h4 : dT = 4
    · subst h4; exact ⟨2, 3, Or.inl rfl, Or.inl rfl, by decide, by decide, by decide⟩
    exact ⟨2, 3, Or.inl rfl, Or.inl rfl, by decide, fun e => h2 e.symm, fun e => h3 e.symm⟩
  have hX0 : X ≠ 0 := by rcases hX with rfl | rfl <;> decide
  have hXok : KFM.TrOk X zw zm := by
    rcases hX with rfl | rfl <;> exact ⟨by decide, by decide, by decide, by decide, by decide⟩
  have hwA := cX_axA X K hX
  have hwB := cX_axB X K hX
  -- the table
  let jT : Fin (7 + (E₁ + 0 + 0 + 3)) := KFM.gI E₁ (E₁ + 0 + 0 + 3) 0 (by omega) entry
  let pc : ℕ → Fin (7 + (E₁ + 0 + 0 + 3)) := fun _ => KFM.gO E₁ 0 0 3 0
  let pM : Fin (7 + (E₁ + 0 + 0 + 3)) := KFM.pMul (E₁ + 0 + 0 + 3)
  let own : Fin 3 → IStmt HS (7 + (E₁ + 0 + 0 + 3)) :=
    ![trW X Y dT jT, (progA X K).code pM pc, (progB X K).code pM pc]
  let e₀ : Fin 0 → IStmt HS (7 + 0) := Fin.elim0
  let ext := KFM.mExt ext₁ e₀ e₀ own
  have hW0 : KFM.kTable ext (pc 1) = trW X Y dT jT := KFM.mTable_own ext₁ e₀ e₀ own 0
  have hWA : KFM.kTable ext (KFM.gO E₁ 0 0 3 1) = (progA X K).code pM pc :=
    KFM.mTable_own ext₁ e₀ e₀ own 1
  have hWB : KFM.kTable ext (KFM.gO E₁ 0 0 3 2) = (progB X K).code pM pc :=
    KFM.mTable_own ext₁ e₀ e₀ own 2
  obtain ⟨nG, hNG⟩ := ng_exists
  obtain ⟨nC, hAx⟩ := axisMaps_ex
  have hC0 : 0 ≤ C0 K := by unfold C0; positivity
  refine ⟨E₁ + 0 + 0 + 3, ext, KFM.gO E₁ 0 0 3 1, KFM.gO E₁ 0 0 3 2, NLogN.KFY.dS, C0 K, 6, max nG nC,
    by decide, hC0, ?_⟩
  intro Isym n hn hn₁ _ _ s f l hf hfD
  have h := hNG n hn (le_of_max_le_left hn₁)
  obtain ⟨Mx⟩ := hAx n hn (le_of_max_le_right hn₁)
  -- the transpose hypothesis in the merged table
  have hTr : TrHyp Isym (KFM.kTable ext) jT dT K := by
    intro w hh bs h1 hbs s' f' zs' l' hf' hfd' h0' hz' hB'
    obtain ⟨c, hc, hcb⟩ := HT Isym w hh bs h1 hbs s' f' zs' l' hf' hfd' h0' hz' hB'
    exact ⟨c, KFM.IRuns.relabel (KFM.mTable_g1 ext₁ e₀ e₀ own) hc, hcb⟩
  have hMul : MulOK Isym (KFM.kTable ext) pM MS := KFM.kTable_mulOK ext
  have hPA : RM.PrcOK Isym (KFM.kTable ext) pc (progA X K) :=
    prcOK_progA hTr hdT hXY hXD hYD hX0 pc hW0
  have hPB : RM.PrcOK Isym (KFM.kTable ext) pc (progB X K) :=
    prcOK_progB hTr hdT hXY hXD hYD hX0 pc hW0
  -- the state
  have hstD : (NLogN.KIL.encK s f).G NLogN.KFY.dS = ints (NLogN.KFY.descL (pP n) (αP n) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (KFM.dpN n)
      (srcsN n)) ++ s.G dS := by
    rw [encK_G, hfD, descLineN_eq]
  have hst : ∀ i : Fin (IntMul.OpenAI.Glue.dP n), KFM.sB n i ≤ KFM.tB n i := fun i => by
    rw [tB_tN hn i]; exact (NLogN.KFY.axF h.nf i i.isLt).st.le
  have hslt : ∀ k < IntMul.OpenAI.Glue.dP n, KFM.srcN n k < tN n k := fun k hk => (NLogN.KFY.axF h.nf k hk).st
  set Ctr := ⌈trBound K (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) ((List.ofFn (KFM.tB n)).prod)⌉₊ +
    trOver (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) with hCtr
  have hCtr' : Ctr = ⌈trBound K (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (2 ^ IntMul.OpenAI.Glue.LP n)⌉₊ +
      trOver (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) := by rw [hCtr, prod_tB hn]
  refine ⟨fun zs u h0 hrep hu => ?_, fun ys y h0 hrep hy => ?_⟩
  · -- the `A` pass
    have hst0 := encK_G0 s f (gflat zs) l h0
    have hzs : ArrInv n zs := ⟨hrep.1, discL_of_getD
      (repPad_disc (p := pP n) (s := KFM.sB n) (t := KFM.tB n) hrep (by linarith))⟩
    have H := passA_all NLogN.KFY.MS X K hXok hX0 hwA hn Mx (NLogN.KIL.encK s f) zs (ints l ++ s.G 0) (s.G NLogN.KFY.dS) hst0
      hstD hzs (BoN n) (mmN n) (ΦN n) (BaccN n) (QN n) (BqN n) (mulBndN n)
      (fun k hk => ⟨sapHypN h.nf k hk, tabHypN h.nf k hk, axQAN h.nf k hk⟩)
      (AN n) (NLogN.KFY.BN n) (axBndN h.nf) (hWBN h.nf) (hlAN h.nf) (hdlAN h.nf)
      (Ctr + mainA n + overN n) (fun k hk => h.axA_le hk K Ctr)
    have R := RM.code_runs NLogN.KFY.MS pM pc hMul (progA X K) hPA (NLogN.KIL.encK s f) H.2.1
    rw [← hWA, H.1, encK_upd0] at R
    have R2 := IRuns.call R
    set zs' := tensorGo (mapsA (pP n) (αP n) (KFM.sB n) (KFM.tB n)) (List.ofFn (KFM.tB n)) zs
    have PA := passA (pP n) (αP n) (KFM.sB n) (KFM.tB n) hst zs u hrep hu Mx
    refine ⟨zs', wOf (pP n) (KFM.tB n) zs', _, R2, PA.1, GB_of_disc PA.2.1,
      fun M => (passA (pP n) (αP n) (KFM.sB n) (KFM.tB n) hst zs u hrep hu M).2.2, ?_⟩
    have hP := h.passC_le ((pP n + 1) * 29 * 10 ^ 7 * (NLogN.KFY.BN n + 2) ^ 2 + 4 * 10 ^ 7 * (NLogN.KFY.BN n + 2) ^ 2)
      Ctr (mainA n) (by gcongr <;> norm_num)
    have hc : RM.cost NLogN.KFY.MS (progA X K) (NLogN.KIL.encK s f) + 2 ≤
        IntMul.OpenAI.Glue.dP n * (⌈trBound K (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (2 ^ IntMul.OpenAI.Glue.LP n)⌉₊ +
          trOver (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n)) + IntMul.OpenAI.Glue.dP n * mainA n + (2 * IntMul.OpenAI.Glue.dP n + 1) * overN n + 2 := by
      rw [← hCtr']; omega
    have hm : mainA n ≤ (216 * 10 ^ 14) * (SN n * αP n) * 2 ^ IntMul.OpenAI.Glue.LP n * ZN n :=
      le_trans h.mainA_le (by gcongr <;> norm_num)
    exact h.cost_real K hK (216 * 10 ^ 14) (mainA n) hm _ hc
  · -- the `B₀` pass
    have hst0 := encK_G0 s f (gflat ys) l h0
    have hzs : ArrInv n ys := ⟨hrep.1, discL_of_getD
      (repFull_disc (p := pP n) (t := KFM.tB n) hrep hy)⟩
    have H := passB_all NLogN.KFY.MS X K hXok hX0 hwB hn Mx (NLogN.KIL.encK s f) ys (ints l ++ s.G 0) (s.G NLogN.KFY.dS) hst0
      hstD hzs hslt (BoN n) (mmN n) (ΦN n) (BaccN n) (QN n) (BqN n) (mulBndN n)
      (fun k hk => ⟨bapHypN h.nf k hk, tabHypBN h.nf k hk, axQAN h.nf k hk⟩)
      (AN n) (NLogN.KFY.BN n) (axBndBN h.nf) (hWBN h.nf) (hlAN h.nf) (hdlAN h.nf)
      (Ctr + mainB n + overN n) (fun k hk => h.axB_le hk K Ctr)
    have R := RM.code_runs NLogN.KFY.MS pM pc hMul (progB X K) hPB (NLogN.KIL.encK s f) H.2.1
    rw [← hWB, H.1, encK_upd0] at R
    have R2 := IRuns.call R
    set ys' := tensorGo (mapsB (pP n) (αP n) (KFM.sB n) (KFM.tB n)) (List.ofFn (KFM.tB n)) ys
    have PB := passB (pP n) (αP n) (KFM.sB n) (KFM.tB n) hst ys y hrep hy Mx
    refine ⟨ys', NLogN.KFY.vOf (pP n) (KFM.sB n) (KFM.tB n) ys', _, R2, PB.1, GB_of_disc PB.2.1,
      fun M => (passB (pP n) (αP n) (KFM.sB n) (KFM.tB n) hst ys y hrep hy M).2.2, ?_⟩
    have hP := h.passC_le ((pP n + 1) * 29 * 10 ^ 7 * (NLogN.KFY.BN n + 2) ^ 2 + 10 * 10 ^ 7 * (NLogN.KFY.BN n + 2) ^ 2)
      Ctr (mainB n) le_rfl
    have hc : RM.cost NLogN.KFY.MS (progB X K) (NLogN.KIL.encK s f) + 2 ≤
        IntMul.OpenAI.Glue.dP n * (⌈trBound K (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (2 ^ IntMul.OpenAI.Glue.LP n)⌉₊ +
          trOver (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n)) + IntMul.OpenAI.Glue.dP n * mainB n + (2 * IntMul.OpenAI.Glue.dP n + 1) * overN n + 2 := by
      rw [← hCtr']; omega
    exact h.cost_real K hK (216 * 10 ^ 14) (mainB n) h.mainB_le _ hc

end

end NLogN.KFY

end

section
open NLogN
open NLogN.KFTop
theorem solution (hΦ : NLogN.KFM.PhiNeed) (hT : NLogN.KFM.TransNeed) (h18 : NLogN.KFM.P18IL) :
    IntMul.KappaBound (1 / 2 ^ 182) :=
  NLogN.KFTop.kappa_of_ifaces hΦ (NLogN.KFY.lineNeed_of_transNeed hT) h18
end
