-- title:
--   (72) — for $\alpha>3$ and $\sum k\|g_k\|<\infty$, $\sup_k k\|x_{k+1}-x_k\|<+\infty$
-- statement:
--   Let $\mathcal H$ be a real Hilbert space, let $\Phi:\mathcal H\to\mathbb R\cup\{+\infty\}$ be proper, lower semicontinuous and convex, and let $\Psi:\mathcal H\to\mathbb R$ be convex and continuously differentiable with $L$-Lipschitz continuous gradient; write $\Theta=\Phi+\Psi$. Let $s>0$ with $sL<1$, let $(g_k)_{k\ge 0}$ be a sequence of perturbations in $\mathcal H$, and let $(x_k)_{k\ge0},(y_k)_{k\ge0}$ be generated by the perturbed inertial forward-backward algorithm (55):
--
--   $$y_k = x_k + \frac{k-1}{k+\alpha-1}(x_k-x_{k-1})\ (k\ge 1),\qquad x_{k+1}=\operatorname{prox}_{s\Phi}\big(y_k-s(\nabla\Psi(y_k)-g_k)\big)\ (k\ge 0),$$
--
--   with $y_0\in\mathcal H$ arbitrary.
--
--   Assume $\alpha>3$, $\sum_k k\|g_k\|<+\infty$ and $\operatorname{argmin}\Theta\neq\emptyset$ (the hypotheses of Theorem 5.3). Then
--
--   $$\sup_{k\ge 0}\,k\,\|x_{k+1}-x_k\|<+\infty .$$
--
--   This velocity bound gives item ii) of Theorem 5.3 and, with (68), the boundedness of $(x_k)$ used in the final step.
--
--   **Formalization Note.** $\Phi$ is `EReal`-valued with `IsProperClosedConvex`; $\operatorname{prox}_{s\Phi}$ is a map $P$ with `IsProx s Φ P`; $\Theta$ is the published `NesterovFB.Rates.theta Φ Ψ` (whose argument names are swapped relative to this paper: its first argument is the nonsmooth part). $L$ is a nonnegative real and "$0<s<1/L$" is written $0<s$, $sL<1$, so $L=0$ is allowed. The run is `IsPerturbedRun`. The supremum is stated as `BddAbove` of the range of $k\mapsto k\|x_{k+1}-x_k\|$, a set of nonnegative reals.
-- source:
--   Attouch, Chbani, Peypouquet, Redont, Fast convergence of inertial dynamics and algorithms with asymptotic vanishing damping, Optimization Online preprint 5179 (Oct. 2015), p. 22, (72)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm
import Definitions.Def_InertialAVD_Algo_PerturbedRun

open Filter Topology NesterovFB.Rates

namespace InertialAVD.Algo

/-- (72), p. 22: under the hypotheses of Theorem 5.3 (`α > 3`), `sup_k k‖x_{k+1} − x_k‖ < +∞`. -/
theorem eq_72 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Φ : H → EReal) (Ψ : H → ℝ) (L : NNReal) (s α : ℝ) (P : H → H) (g : ℕ → H) (x y : ℕ → H)
    (hΦ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Φ)
    (hΨc : ConvexOn ℝ Set.univ Ψ) (hΨd : ContDiff ℝ 1 Ψ)
    (hL : LipschitzWith L (gradient Ψ))
    (hs : 0 < s) (hsL : s * (L : ℝ) < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Φ P)
    (hrun : IsPerturbedRun Ψ P α s g x y)
    (hα : 3 < α)
    (hg : Summable (fun k : ℕ => (k : ℝ) * ‖g k‖))
    (hS : ∃ xstar : H, ∀ v : H, theta Φ Ψ xstar ≤ theta Φ Ψ v) :
    BddAbove (Set.range fun k : ℕ => (k : ℝ) * ‖x (k + 1) - x k‖) := by sorry

end InertialAVD.Algo
