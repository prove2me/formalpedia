noncomputable def threeCNFSatisfiable (φ : ThreeCNF) : Bool :=
  @decide (
  (∀ c ∈ φ, clauseHasDistinctVariables c) ∧
    ∃ assignment : ℕ → Bool, ∀ c ∈ φ, clauseSatisfied assignment c
  ) (Classical.propDecidable _)
