theorem buffer_loop {α β C : Type} (step : C → Option C)
    (cfg : List α → List β → C) (done : List β → C) (encode : α → List β)
    (hstep : ∀ symbol word acc,step (cfg (symbol::word) acc)=some (cfg word ((encode symbol).reverse++acc)))
    (hdone : ∀ acc,step (cfg [] acc)=some (done acc))
    (word : List α) (acc : List β) :
    ((flip bind step)^[word.length+1]) (some (cfg word acc))=
      some (done ((word.flatMap encode).reverse++acc)) := by
  change ((fun state : Option C => state.bind step)^[word.length+1]) (some (cfg word acc))=
    some (done ((word.flatMap encode).reverse++acc))
  induction word generalizing acc with
  | nil => simpa using hdone acc
  | cons symbol word ih =>
    simp only [List.length_cons]
    rw [Function.iterate_succ_apply,Option.bind_some,hstep,ih]
    simp only [List.flatMap_cons,List.reverse_append,List.append_assoc]

theorem flatMap_singleton_map {α β : Type} (f : α → β) (word : List α) :
    word.flatMap (fun symbol => [f symbol])=word.map f := by
  induction word with
  | nil => rfl
  | cons symbol word ih => simp only [List.flatMap_cons,List.map_cons,List.singleton_append,ih]

