        ∃ z, z ≡ (a ^ R) ^ (F / f) [MOD q] ∧ Nat.Coprime (z + q - 1) q := by
      intro g hg hgf
      subst hgf
      exact ⟨pw6 q y (F / g), hpow _ hFf, Nat.eq_of_beq_eq_true hg⟩
    rw [← hPF'] at hfF
