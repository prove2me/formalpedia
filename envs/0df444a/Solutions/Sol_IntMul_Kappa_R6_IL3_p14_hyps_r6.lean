namespace NLogN

theorem two_pow_zsz_pred_le (m : ℕ) (hm : 1 ≤ m) : 2 ^ (zsz (m : ℤ) - 1) ≤ m := by
  by_contra h
  rw [not_le] at h
  have h1 : zsz (m : ℤ) ≤ zsz (m : ℤ) - 1 := zsz_le_of_lt (by simpa using h)
  have h0 : zsz (m : ℤ) = 0 := by omega
  have h2 := natAbs_lt_zsz (m : ℤ)
  rw [h0] at h2
  simp at h2
  omega

end NLogN

