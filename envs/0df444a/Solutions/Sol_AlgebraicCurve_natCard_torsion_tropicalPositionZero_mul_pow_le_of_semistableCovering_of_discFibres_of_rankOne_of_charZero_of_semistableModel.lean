  have hΦinj : Function.Injective Φ := by
    rintro ⟨c, hcS⟩ ⟨c', hcS'⟩ hcc
    obtain ⟨hdomc, hdegc, hdeg0, hmkc⟩ := hDc c hcS
    obtain ⟨hdomc', hdegc', hdeg0', hmkc'⟩ := hDc c' hcS'
    have h1 : NodalPic0.mk src tgt xs xt ⟨_, hadm (Dc c hcS) hdomc hdegc⟩ =
        NodalPic0.mk src tgt xs xt ⟨_, hadm (Dc c' hcS') hdomc' hdegc'⟩ := congrArg Subtype.val hcc
    rw [← sub_eq_zero, ← map_sub, NodalPic0.mk_eq_zero_iff] at h1
    have hred : NodalData.IsNodalPrincipal (K := ResidueField A) (Fbar := Fbar) src tgt xs xt
        (fun i => Finsupp.mapDomain (C i).placeMap (Dc c hcS i - Dc c' hcS' i)) := by
      have hcoe : ((((⟨_, hadm (Dc c hcS) hdomc hdegc⟩ : ↥(NodalData.admissible (K := ResidueField A) (Fbar := Fbar) src tgt xs xt)) -
          ⟨_, hadm (Dc c' hcS') hdomc' hdegc'⟩ :
            ↥(NodalData.admissible (K := ResidueField A) (Fbar := Fbar) src tgt xs xt)) : NodalData (ResidueField A) Fbar)) =
          fun i => Finsupp.mapDomain (C i).placeMap (Dc c hcS i - Dc c' hcS' i) := by
        rw [AddSubgroupClass.coe_sub]
        funext i
        show Finsupp.mapDomain (C i).placeMap (Dc c hcS i) - Finsupp.mapDomain (C i).placeMap (Dc c' hcS' i) =
          Finsupp.mapDomain.addMonoidHom (C i).placeMap (Dc c hcS i - Dc c' hcS' i)
        rw [map_sub]; rfl
      rw [hcoe] at h1; exact h1

    have hc0 : ((ℓ ^ K : ℕ) : ℤ) • c = 0 := by have h := hcS; rw [hS] at h; exact h.1
    have hc0' : ((ℓ ^ K : ℕ) : ℤ) • c' = 0 := by have h := hcS'; rw [hS] at h; exact h.1
    have hkD : (((ℓ ^ K : ℕ) : ℕ) : ℤ) • (∑ i, (Dc c hcS i - Dc c' hcS' i)) ∈ Divisor.principal (K := L) (F := F) := by
      have hdz : (∑ i, (Dc c hcS i - Dc c' hcS' i)) ∈ Divisor.degZero (K := L) (F := F) := by
        rw [Finset.sum_sub_distrib]; exact sub_mem hdeg0 hdeg0'
      have h0 : Pic0.mk (((ℓ ^ K : ℕ) : ℤ) • (⟨_, hdz⟩ : Divisor.degZero (K := L) (F := F))) = 0 := by
        have : (⟨_, hdz⟩ : Divisor.degZero (K := L) (F := F)) = ⟨_, hdeg0⟩ - ⟨_, hdeg0'⟩ :=
          Subtype.ext (by push_cast; rw [Finset.sum_sub_distrib])
        rw [this, Pic0.mk, ← QuotientAddGroup.mk'_apply, map_zsmul, map_sub, QuotientAddGroup.mk'_apply,
          QuotientAddGroup.mk'_apply, ← Pic0.mk, ← Pic0.mk, hmkc, hmkc']
        have hss : ((ℓ ^ K : ℕ) : ℤ) • (c - c') = ((ℓ ^ K : ℕ) : ℤ) • c - ((ℓ ^ K : ℕ) : ℤ) • c' := zsmul_sub _ _ _
        rw [hss, hc0, hc0', sub_zero]
      rw [Pic0.mk, QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_addSubgroupOf] at h0
      exact h0
    have hP := AlgebraicCurve.sum_mem_principal_of_zsmul_mem_principal_of_isNodalPrincipal_mapDomain_placeMap_of_semistableModel_of_descent
      A π hπ hπ0 hrk F n m Fbar hratBar C hratF An An' src tgt xs xt w hpair hw hatt hnodes hcover hdisc hgenus M D (ℓ ^ K) hℓKunit
      (fun i => Dc c hcS i - Dc c' hcS' i)
      (fun i P hP => by
        have := Finsupp.support_sub hP
        rcases Finset.mem_union.mp this with h | h
        · exact hdomc i P h
        · exact hdomc' i P h)
      (fun i => by
        show Divisor.degree (Dc c hcS i - Dc c' hcS' i) = 0
        rw [map_sub, hdegc i, hdegc' i, sub_zero]) hred hkD

    apply Subtype.ext
    show c = c'
    rw [← hmkc, ← hmkc']
    show QuotientAddGroup.mk _ = QuotientAddGroup.mk _
    rw [QuotientAddGroup.eq_iff_sub_mem, AddSubgroup.mem_addSubgroupOf]
    show ((⟨_, hdeg0⟩ - ⟨_, hdeg0'⟩ : Divisor.degZero (K := L) (F := F)) : Divisor L F) ∈ Divisor.principal (K := L) (F := F)
    push_cast
    rw [← Finset.sum_sub_distrib]
    exact hP

  haveI : Finite T := hTfin
  have hSfin : Finite ↥S := Finite.of_injective Φ hΦinj
  refine ⟨hSfin, ?_⟩
  have hcardle : Nat.card ↥S ≤ Nat.card T := Nat.card_le_card_of_injective Φ hΦinj

  have hconn : Nat.card (Quot fun i j : Fin n => ∃ e : Fin m, src e = i ∧ tgt e = j) = 1 := by

    have hn : 0 < n := by
      obtain ⟨t, ht, hfin, hsep⟩ := AlgebraicCurve.IsCurveOver.exists_separating_transcendental (K := L) (F := F)
      haveI := hsep
      obtain ⟨P⟩ := AlgebraicCurve.nonempty_place_of_transcendental_of_finiteDimensional L t ht hfin
      rcases hcover P with ⟨i, -⟩ | ⟨e, -⟩
      · exact i.pos
      · exact (src e).pos
    let r : Fin n → Fin n → Prop := fun i j => ∃ e : Fin m, src e = i ∧ tgt e = j
    have hcut := AlgebraicCurve.SemistableCovering.exists_src_mem_iff_tgt_notMem_of_discFibres_of_rankOne A π hπ hπ0 hrk F n m
      Fbar hratBar C hratF An An' src tgt xs xt w hpair hw hatt hnodes hcover hdisc hgenus
    have hall : ∀ i j : Fin n, Quot.mk r i = Quot.mk r j := by
      intro i j
      by_contra hne
      let Sset : Finset (Fin n) := Finset.univ.filter (fun l => Quot.mk r l = Quot.mk r i)
      have hi : i ∈ Sset := Finset.mem_filter.mpr ⟨Finset.mem_univ i, rfl⟩
      have hj : j ∈ Ssetᶜ := by
        rw [Finset.mem_compl]; intro h; exact hne (Finset.mem_filter.mp h).2.symm
      obtain ⟨e, he⟩ := hcut Sset ⟨i, hi⟩ ⟨j, hj⟩
      have hst : Quot.mk r (src e) = Quot.mk r (tgt e) := Quot.sound ⟨e, rfl, rfl⟩
      have this : src e ∈ Sset ↔ tgt e ∈ Sset := by
        simp only [Sset, Finset.mem_filter, Finset.mem_univ, true_and, hst]
      exact iff_not_self (this.symm.trans he)
    haveI : Nonempty (Quot r) := ⟨Quot.mk r ⟨0, hn⟩⟩
    haveI : Subsingleton (Quot r) := ⟨by
      intro a b
      induction a using Quot.ind with | _ i =>
      induction b using Quot.ind with | _ j =>
      exact hall i j⟩
    exact Nat.card_unique
