variable {F : Type} [Field F] [NumberField F]

theorem GlobalTheory.HilbertRecip.exists_coords {p : Place F} {a δ b : Fˣ} (hb : b ∉ sqr p)
    (h : ∀ q, q ≠ p → a ∈ nrm q δ) : ∃ x₀ x₁ y₀ y₁ : F,
      (a : F) = x₀ ^ 2 - δ * y₀ ^ 2 + b * (x₁ ^ 2 - δ * y₁ ^ 2) ∧ x₀ * x₁ - δ * (y₀ * y₁) = 0 := by sorry
