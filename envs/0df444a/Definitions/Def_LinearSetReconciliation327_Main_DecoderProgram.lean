section PowerSums

variable {F : Type} [Field F] [Algebra (ZMod 2) F]

variable {N : ℕ}

end PowerSums

/-- Bit `p` of the payload `y`, as a natural number. -/
def payloadBit {M : ℕ} (y : Fin M → ZMod 2) (p : ℕ) : ℕ := (payloadAt y p).val

/-- The **dual locator** of a support: `∏_{v ∈ D} (1 − v X)`.  Its roots are the inverses `v⁻¹`,
which is why the machine inverts a root before looking up its position (`detInvBase`). -/
noncomputable def locDual {F : Type} [Field F] (D : Finset F) : F[X] :=
  ∏ v ∈ D, (1 - C v * X)

/-- The numerator of the partial-fraction form, `Σ_{v∈D} v·∏_{w ∈ D.erase v} (1 − wX)`; it has
degree `< #D`. -/
noncomputable def omegaD {F : Type} [Field F] [DecidableEq F] (D : Finset F) : F[X] :=
  ∑ v ∈ D, C v * ∏ w ∈ D.erase v, (1 - C w * X)

/-- `S = Σ_{j<N} s_j X^j` with `s_j = P_{j+1}`: the syndrome polynomial of the support `D`,
truncated at `N` coefficients.  Coefficient `0` is `P_1`, so no power sum of index `0` is involved. -/
noncomputable def synP {F : Type} [Field F] (D : Finset F) (N : ℕ) : F[X] :=
  ∑ j ∈ Finset.range N, C (∑ v ∈ D, v ^ (j + 1)) * X ^ j

/-- **A solution of the key equation**: `σ S ≡ ω (mod X^(2t))` with `deg σ ≤ t`, `deg ω < t`. -/
def KeySol {F : Type} [Field F] (D : Finset F) (t : ℕ) (σ ω : F[X]) : Prop :=
  σ ≠ 0 ∧ σ.natDegree ≤ t ∧ ω.natDegree < t ∧ X ^ (2 * t) ∣ σ * synP D (2 * t) - ω

/-- The same key equation, stated against the stored power sums `e j = s_j = P_{j+1}` instead of a
support: this is the form in which the machine's Berlekamp–Massey output is verified. -/
def KeySolE {F : Type} [Field F] (e : ℕ → F) (t : ℕ) (σ ω : F[X]) : Prop :=
  σ ≠ 0 ∧ σ.natDegree ≤ t ∧ ω.natDegree < t ∧
    X ^ (2 * t) ∣ σ * (∑ j ∈ Finset.range (2 * t), C (e j) * X ^ j) - ω

/-- The binary vector whose support is the candidate set `D`. -/
noncomputable def vecOf {F : Type} [Field F] [DecidableEq F] (N : ℕ) (ι : ℕ → F)
    (D : Finset F) : Fin N → ZMod 2 :=
  fun i => if ι i.val ∈ D then 1 else 0

/-- A **minimum-degree** solution of the key equation: Berlekamp–Massey's defining property, and
what makes the *reject* branch complete (`decoder_reject`).  Note that the *accept* branch does not
need it: the verification test itself certifies the answer. -/
def KeySolEMin {F : Type} [Field F] (e : ℕ → F) (t : ℕ) (σ ω : F[X]) : Prop :=
  KeySolE e t σ ω ∧ ∀ σ' ω' : F[X], KeySolE e t σ' ω' → σ.natDegree ≤ σ'.natDegree

/-- The algebraic part of a two-row Euclidean state.  Bounds on degrees and
machine storage are proved separately from this invariant. -/
def PadeBasis {F : Type} [Field F] (S M τ ν σ ω : F[X]) : Prop :=
  M ∣ τ * S - ν ∧ M ∣ σ * S - ω ∧ ν * σ - τ * ω = M

/-- Two consecutive rows of the extended Euclidean algorithm. -/
structure PadeState (F : Type) [Field F] where
  prevR : F[X]
  prevC : F[X]
  rem : F[X]
  curC : F[X]

noncomputable def padeInitial {F : Type} [Field F] (e : ℕ → F) (t : ℕ) : PadeState F :=
  ⟨X ^ (2 * t), 0, syndromePoly e t, 1⟩

noncomputable def padeNext {F : Type} [Field F] (s : PadeState F) : PadeState F :=
  let q := s.prevR / s.rem
  ⟨s.rem, s.curC, s.prevR % s.rem, s.prevC - q * s.curC⟩

/-- Fuel bounds only the number of quotient iterations; each quotient is
implemented by a separate coefficient loop in the machine refinement. -/
noncomputable def padeRun {F : Type} [Field F] (t : ℕ) : ℕ → PadeState F → PadeState F
  | 0, s => s
  | fuel + 1, s =>
      if s.rem.natDegree < t then s else padeRun t fuel (padeNext s)

/-- The degree balance complements the two-row congruence certificate. -/
structure PadeInv {F : Type} [Field F] (e : ℕ → F) (t : ℕ) (s : PadeState F) : Prop where
  basis : PadeBasis (syndromePoly e t) (X ^ (2 * t)) s.prevC s.prevR s.curC s.rem
  prev_ne : s.prevR ≠ 0
  cur_ne : s.curC ≠ 0
  balance : s.prevR.natDegree + s.curC.natDegree = 2 * t
  prev_large : t ≤ s.prevR.natDegree
  prev_small : s.prevC.natDegree ≤ s.curC.natDegree
  rem_small : s.rem.natDegree < s.prevR.natDegree

noncomputable def padeSolve {F : Type} [Field F] (e : ℕ → F) (t : ℕ) : PadeState F :=
  padeRun t (2 * t + 1) (padeInitial e t)

/-- Absolute-trace evaluation by repeated squaring, without enumeration. -/
def traceValue {F : Type} [Field F] : ℕ → F → F
  | 0, _ => 0
  | n + 1, z => traceValue n z ^ 2 + z

noncomputable def linearRoot {F : Type} [Field F] (f : F[X]) : F :=
  -f.coeff 0 / f.coeff 1

/-- A list of bit-valued splitters separates the roots of `f`. -/
def SeparatesRoots {F : Type} [Field F] (ps : List F[X]) (f : F[X]) : Prop :=
  ∀ u v : F, f.eval u = 0 → f.eval v = 0 → u ≠ v →
    ∃ p ∈ ps, p.eval u ≠ p.eval v

/-- Descend only through nonconstant factors.  At each level the two branches
are gcds with a bit-valued splitter and with that splitter minus one. -/
noncomputable def rootSearch {F : Type} [Field F] [DecidableEq F] :
    List F[X] → F[X] → List F
  | [], f => if f.natDegree = 1 then [linearRoot f] else []
  | p :: ps, f =>
      if f.natDegree = 0 then []
      else rootSearch ps (EuclideanDomain.gcd f p) ++
        rootSearch ps (EuclideanDomain.gcd f (p - 1))

/-- The actual splitter list uses only `w` basis vectors. -/
noncomputable def traceSplitters {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) : List F[X] :=
  List.ofFn (fun j : Fin w => tracePolynomial (b j) w)

/-- Evaluate the trace polynomial modulo the current factor, retaining only
coefficients below its degree after every squaring. -/
noncomputable def traceRemainder {F : Type} [Field F] (a : F) (f : F[X]) : ℕ → F[X]
  | 0 => 0
  | n + 1 => (traceRemainder a f n ^ 2 + C a * X) % f

/-- The computational root search builds no polynomial of degree `2^w`.
There are exactly `w` modular squarings per splitter evaluation. -/
noncomputable def traceRootSearch {F : Type} [Field F] [DecidableEq F] (w : ℕ) :
    List F → F[X] → List F
  | [], f => if f.natDegree = 1 then [linearRoot f] else []
  | a :: as, f =>
      if f.natDegree = 0 then [] else
      let p := traceRemainder a f w
      traceRootSearch w as (EuclideanDomain.gcd f p) ++
        traceRootSearch w as (EuclideanDomain.gcd f (p - 1))

/-- The polynomial-time root algorithm, instantiated by the basis. -/
noncomputable def rootsByBasis {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (f : F[X]) : List F :=
  traceRootSearch w (List.ofFn b) f

/-- The actual root-to-support conversion: roots must be inverted. -/
noncomputable def supportCandidate {F : Type} [Field F] [DecidableEq F]
    [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (σ : F[X]) : Finset F :=
  ((rootsByBasis b σ).map (fun u => u⁻¹)).toFinset

/-- The verifier checks the cardinality, legal positions, and all expanded
power sums.  Every check ranges over the candidate, never over the universe. -/
def CandidateVerified {F : Type} [Field F] (N t : ℕ) (ι : ℕ → F)
    (e : ℕ → F) (D : Finset F) : Prop :=
  D.card ≤ t ∧ (∀ v ∈ D, ∃ i : Fin N, ι i.val = v) ∧
    ∀ a ∈ Finset.Icc 1 (2 * t), ∑ v ∈ D, v ^ a = e (a - 1)

/-- The mathematical meaning of a test. -/
def Cond.eval : Cond → RAMState → Prop
  | .neqz r, s => s.regs r ≠ 0
  | .lt _ a b, s => s.regs a < s.regs b

