  set V := AModel.vol ((LA ++ LF ++ [b] ++ LC).map (asz mz))
  have hc := cBwdF_le (AModel.vol (LA.map (asz mz))) 2 (AModel.vol (LF.map (asz mz)))
    (AModel.vol (LC.map (asz mz))) w p4 p2 (by omega) p1
  rw [← e] at hc
  have hk := cK4_le a1 a3 a2 a4
  have hkap : 200 ≤ kap w := by simp [kap]
  unfold NLogN.KFU.cMv
  nlinarith

