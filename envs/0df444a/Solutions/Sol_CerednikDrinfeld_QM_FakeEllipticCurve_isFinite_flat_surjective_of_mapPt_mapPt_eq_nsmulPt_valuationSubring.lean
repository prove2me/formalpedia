theorem surjective_of_forall_surjective_pullback_snd_fiberι
    {S X Y : Scheme.{u}} (pY : Y ⟶ S) (g : X ⟶ Y)
    (hfib : ∀ s : S, Surjective (pullback.snd g (pY.fiberι s))) : Surjective g := by
  refine ⟨fun y => ?_⟩
  obtain ⟨y', hy'⟩ : y ∈ Set.range (pY.fiberι (pY.base y)) := by
    rw [Scheme.Hom.range_fiberι]; exact rfl
  obtain ⟨x', hx'⟩ := (hfib (pY.base y)).surj y'
  refine ⟨(pullback.fst g (pY.fiberι (pY.base y))).base x', ?_⟩
  have hc : (pullback.fst g (pY.fiberι (pY.base y)) ≫ g).base x' =
      (pullback.snd g (pY.fiberι (pY.base y)) ≫ pY.fiberι (pY.base y)).base x' := by
    rw [pullback.condition]
  change g.base ((pullback.fst g (pY.fiberι (pY.base y))).base x') = y
  change g.base ((pullback.fst g (pY.fiberι (pY.base y))).base x') =
    (pY.fiberι (pY.base y)).base ((pullback.snd g (pY.fiberι (pY.base y))).base x') at hc
  rw [hc]
  change (pY.fiberι (pY.base y)).base ((pullback.snd g (pY.fiberι (pY.base y))).base x') = y
  have hx'' : (pullback.snd g (pY.fiberι (pY.base y))).base x' = y' := hx'
  rw [hx'']
  exact hy'

theorem locallyQuasiFinite_of_forall_isFinite_pullback_snd_fiberι
    {S X Y : Scheme.{u}} (pY : Y ⟶ S) (g : X ⟶ Y)
    (hfib : ∀ s : S, IsFinite (pullback.snd g (pY.fiberι s))) : LocallyQuasiFinite g := by
  apply LocallyQuasiFinite.of_fiberToSpecResidueField
  intro y

  let s : S := pY.base y
  let y' : Spec (Y.residueField y) ⟶ pY.fiber s :=
    pullback.lift (Y.fromSpecResidueField y) (Spec.map (pY.residueFieldMap y))
      (Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField pY y).symm
  have hy' : y' ≫ pY.fiberι s = Y.fromSpecResidueField y := pullback.lift_fst _ _ _

  haveI : IsFinite (pullback.snd (pullback.snd g (pY.fiberι s)) y') := inferInstance
  let e₁ : pullback (pullback.snd g (pY.fiberι s)) y' ≅ pullback g (y' ≫ pY.fiberι s) :=
    pullbackLeftPullbackSndIso g (pY.fiberι s) y'
  have he₁ : e₁.hom ≫ pullback.snd g (y' ≫ pY.fiberι s) = pullback.snd (pullback.snd g (pY.fiberι s)) y' :=
    pullbackLeftPullbackSndIso_hom_snd _ _ _
  have hsnd : pullback.snd g (y' ≫ pY.fiberι s) = e₁.inv ≫ pullback.snd (pullback.snd g (pY.fiberι s)) y' := by
    rw [← he₁, Iso.inv_hom_id_assoc]
  haveI : IsFinite (pullback.snd g (y' ≫ pY.fiberι s)) := by
    rw [hsnd]; infer_instance

  have key : ∀ (z : Spec (Y.residueField y) ⟶ Y), z = y' ≫ pY.fiberι s → IsFinite (pullback.snd g z) := by
    rintro z rfl; infer_instance
  haveI : IsFinite (g.fiberToSpecResidueField y) := key (Y.fromSpecResidueField y) hy'.symm
  infer_instance

end K1vAux

