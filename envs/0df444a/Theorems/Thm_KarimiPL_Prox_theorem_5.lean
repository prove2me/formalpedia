-- title:
--   Theorem 5, p. 8 — under the proximal-PL inequality, proximal gradient with step $1/L$ gives $F(x_k) - F^* \le (1 - \mu/L)^k [F(x_0) - F^*]$
-- statement:
--   Consider problem (11), minimizing $F(x) = f(x) + g(x)$ over $x \in \mathbb R^d$, where:
--
--   1. $f : \mathbb R^d \to \mathbb R$ is differentiable and its gradient is $L$-Lipschitz continuous, $\|\nabla f(x) - \nabla f(y)\| \le L\|x - y\|$, with $L > 0$;
--   2. $g : \mathbb R^d \to \mathbb R$ is convex;
--   3. $F$ has a non-empty solution set: there is $x^*$ with $F(x^*) \le F(y)$ for all $y$; write $F^* = F(x^*)$;
--   4. $F$ satisfies the proximal-PL inequality (12) with some $\mu > 0$: $\tfrac12\mathcal D_g(x, L) \ge \mu(F(x) - F^*)$ for all $x$, where
--   $$
--   \mathcal D_g(x, \alpha) = -2\alpha \min_y \Bigl[\langle \nabla f(x), y - x\rangle + \frac{\alpha}{2}\|y - x\|^2 + g(y) - g(x)\Bigr].
--   $$
--
--   Let $(x_k)_{k \ge 0}$ be generated by the proximal-gradient method with step size $1/L$ from an arbitrary $x_0$:
--   $$
--   x_{k+1} \in \operatorname*{argmin}_y \Bigl[\langle \nabla f(x_k), y - x_k\rangle + \frac L2\|y - x_k\|^2 + g(y) - g(x_k)\Bigr]. \tag{14}
--   $$
--   Then for every $k \ge 0$,
--   $$
--   F(x_k) - F^* \le \Bigl(1 - \frac{\mu}{L}\Bigr)^k \bigl[F(x_0) - F^*\bigr].
--   $$
--
--   This is the paper's linear convergence result for the proximal-gradient method without strong convexity. When $g$ is constant it reduces to Theorem 1 for gradient descent under the PL inequality.
--
--   **Formalization Note** $g$ is real-valued, so the indicator functions mentioned on p. 8 as examples of $g$ are outside the formal scope. The update (14) is encoded by requiring each $x_{k+1}$ to be a minimizer; the minimizer is unique for convex $g$, but uniqueness is not used. No relation between $\mu$ and $L$ is assumed, as on the page.
-- source:
--   Karimi, Nutini, Schmidt, arXiv:1608.04636v4, Theorem 5, p. 8

import Mathlib
import Definitions.Def_KarimiPL_Prox_Setting

open InnerProductSpace

namespace KarimiPL.Prox

theorem theorem_5 {d : ℕ} (f g : EuclideanSpace ℝ (Fin d) → ℝ)
    (hdiff : Differentiable ℝ f) (L : ℝ) (hL : 0 < L)
    (hLip : ∀ x y, ‖gradient f x - gradient f y‖ ≤ L * ‖x - y‖)
    (hg : ConvexOn ℝ Set.univ g)
    (xstar : EuclideanSpace ℝ (Fin d)) (hxstar : ∀ y, f xstar + g xstar ≤ f y + g y)
    (μ : ℝ) (hμ : 0 < μ) (hPPL : ProxPL f g L μ (f xstar + g xstar))
    (x : ℕ → EuclideanSpace ℝ (Fin d)) (hrun : IsProxGradRun f g L x) :
    ∀ k : ℕ, (f (x k) + g (x k)) - (f xstar + g xstar)
      ≤ (1 - μ / L) ^ k * ((f (x 0) + g (x 0)) - (f xstar + g xstar)) := by sorry

end KarimiPL.Prox
