/-- Block replacement: a step list built block by block has the composite denotation. -/
lemma denListH_flatMap {ι : Type*} (ch : Finset (Fin m) → Op (Fin m × κ)) (L : List ι)
    (F : ι → List (HStep R m)) :
    denListH ch (L.flatMap F) = (L.map fun i => denListH ch (F i)).reverse.prod := by
  induction L with
  | nil => simp
  | cons i L ih =>
