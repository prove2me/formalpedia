open NLogN
open NLogN.KFH
open IntMul RS AModel KIL KFD KFB Complex
theorem solution {r p Δ : ℕ} {zs : List NLogN.KFB.GI} {xs : List (Fin r → ℂ)}
    (h : NLogN.KFH.RecRep r (p + Δ) zs xs) : NLogN.KFH.RecRep r p (zs.map (NLogN.KFH.gtr Δ)) (Butterfly.QpArr p xs) := by
  refine ⟨by simp [Butterfly.QpArr, h.1], fun j c hj => ?_⟩
  simp only [Butterfly.QpArr, List.length_map] at hj
  have hjr : j * r + c < zs.length := by
    rw [h.1]; have := c.isLt
    calc j * r + c < j * r + r := by omega
      _ = (j + 1) * r := by ring
      _ ≤ xs.length * r := Nat.mul_le_mul_right _ hj
  rw [List.getD_eq_getElem _ _ (by simpa using hjr), List.getElem_map]
  have hq : (Butterfly.QpArr p xs).getD j 0 c = Butterfly.Qp p (xs[j] c) := by
    simp [Butterfly.QpArr, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj]
  have e := h.2 j c hj
  rw [List.getD_eq_getElem _ _ hjr, List.getD_eq_getElem _ _ hj] at e
  have hx : xs[j] c = NLogN.KFB.toC zs[j * r + ↑c] / 2 ^ (p + Δ) := by
    rw [e]; field_simp
  rw [hq, hx, NLogN.KFH.Qp_toC]; field_simp
end
