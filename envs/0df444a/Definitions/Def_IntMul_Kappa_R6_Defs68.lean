-- Source module: Solutions.J6SegAxA5
/-!
# `A`-line axis program (`AxisUA6`), part 5: the eight steps of one axis

**`axA_pass`**: the program
`axAProg dup (fx f=5 fwd) (fx f=5 back) (gather slab) (fx f=3 fwd) (fx f=3 back) (kernel) (compress slab)`
is a `PassOK` step for `J6A.pipeAL p s t α H pre post` on arrays of length `pre · t · post` with
`GB w`, from:

* the fine exposure `FineBody6` on `dF` and four `SetupS` pairs putting `descFine …` on `dF`;
* two slab `SetupS` pairs (`ρS`) for the gather (`srcG`) and compress (`srcC`) slab passes;
* the copy step (`dupL 32`) as a `PassOK` step;
* the `A` kernel (`tbl e = aKprog2 pM`, `J6AIL4b`) with its register set-up `SetupBody6` (`kerRegs`,
  as `PreA6` provides it) and the numeric side conditions **`AKCond`** (those of `aK_row` and of
  `kpass_ok`, `J6SegAxis2`).

The cost is **`axACost`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function J6Seg.KR.AK
open J6Seg.Slab
open NLogN.KFUU (lA lC lD)

/-- The table of block `q` of the `A` kernel. -/
def aTabG (p s t α H pk b : ℕ) (q : ℕ) : List ℤ :=
  aKTab2 (2 * J6A.WA p α H) (2 * H) (8 * H) (J6A.QA p) pk b (J6A.aTabA p s t α H q)
    (J6A.rTabA p s t α H q) (J6A.cTabA p s t α H q)

/-- **The numeric side conditions of the `A` kernel pass** (`aK_row` and `kpass_ok`), with the
kernel output bound `w' = pk + 1`, the input bound `w` and `nc = t / 16H · 8` blocks. -/
structure AKCond (p s t α H pk b w f pre post : ℕ) (φ1 φ2 B BH Bk Lmax : ℕ) (Ka Kr Kc X0 : ℤ) :
    Prop where
  Φ1 : ∀ x y : ℤ, zsz x ≤ B → zsz y ≤ B → NLogN.KFUU.MS.Φ x y ≤ φ1
  Φ2 : ∀ x y : ℤ, zsz x ≤ b * (2 * (2 * J6A.WA p α H + 2 * H)) + 2 →
    zsz y ≤ b * (2 * (2 * J6A.WA p α H + 2 * H)) + 2 → NLogN.KFUU.MS.Φ x y ≤ φ2
  b1 : 1 ≤ b
  n1 : 1 ≤ 2 * J6A.WA p α H + 2 * H
  big : 2 * (2 * (2 * J6A.WA p α H + 2 * H)) * 2 ^ (2 * pk) < 2 ^ (b - 1)
  w2 : 2 * J6A.WA p α H ≤ 8 * H
  bk : 2 * H ≤ 8 * H
  rl : ∀ q, (J6A.rTabA p s t α H q).length = 2 * J6A.WA p α H + 2 * H
  Ka0 : 0 ≤ Ka
  Kr0 : 0 ≤ Kr
  Kc0 : 0 ≤ Kc
  X00 : 0 ≤ X0
  ta : ∀ q, KR.TB (2 ^ J6A.QA p * Ka) (J6A.aTabA p s t α H q)
  tr : ∀ q, KR.TB (2 ^ J6A.QA p * Kr) (J6A.rTabA p s t α H q)
  tc : ∀ q, KR.TB (2 ^ J6A.QA p * Kc) (J6A.cTabA p s t α H q)
  ea : 2 ^ J6A.QA p * Ka ≤ 2 ^ pk
  er : 2 ^ J6A.QA p * Kr ≤ 2 ^ pk
  ec : 2 ^ J6A.QA p * Kc ≤ 2 ^ pk
  e0 : X0 ≤ 2 ^ pk
  e1 : Ka * X0 + 1 ≤ 2 ^ pk
  e2 : ((2 * J6A.WA p α H + 2 * H : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1 ≤ 2 ^ pk
  e3 : Kc * (((2 * J6A.WA p α H + 2 * H : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1) + 1 ≤ 2 ^ pk
  Bz : 2 * (pk + 1) + 2 ≤ B
  Bb : b + 4 ≤ B
  PB : J6A.QA p + 3 ≤ B
  Bc : zsz ((2 * (8 * H) + 2 * (2 * J6A.WA p α H + 2 * H) : ℕ) : ℤ) ≤ B
  BH' : ∀ v ∈ aHdr2 (2 * J6A.WA p α H) (2 * H) (8 * H) (J6A.QA p) pk b, zsz v ≤ BH
  kB : 1 ≤ Bk
  zw : zsz (w : ℤ) ≤ Bk
  zw' : zsz ((pk + 1 : ℕ) : ℤ) ≤ Bk
  zf : zsz (f : ℤ) ≤ Bk
  zA : zsz ((pre * (t / (16 * H) * 8) : ℕ) : ℤ) ≤ Bk
  zp : zsz (post : ℤ) ≤ Bk
  zpre : zsz (pre : ℤ) ≤ Bk
  znc : zsz ((t / (16 * H) * 8 : ℕ) : ℤ) ≤ Bk
  zm : zsz ((2 * 2 ^ f : ℕ) : ℤ) ≤ Bk
  zN : zsz ((2 * (pre * (t / (16 * H) * 8) * post * 2 ^ f) : ℕ) : ℤ) ≤ Bk
  zT : zsz ((tabsT (aTabG p s t α H pk b) (t / (16 * H) * 8)).length : ℤ) ≤ Bk
  zL : zsz (Lmax : ℤ) ≤ Bk
  w'B : pk + 1 ≤ Bk
  TBk : ∀ q < t / (16 * H) * 8, Bnd Bk (aTabG p s t α H pk b q)
  TL : ∀ q < t / (16 * H) * 8, (aTabG p s t α H pk b q).length ≤ Lmax
  /-- input entries are kernel inputs -/
  AB : ∀ x : List GI, GB w x → KR.AB X0 x

/-- The cost of one gather / compress slab pass (`slabId_ok`). -/
def cSlabA (n n' post pre Bu : ℕ) (src : ℕ → Option ℕ) : ℕ :=
  passC pre (ctlOf n n' src (fun _ => 0)).length (2 * post) 1
    (2 * Bu + 2 + (2 * moveCost Bu + 19) + 300 * (Bu + 1) + (2 * moveCost Bu + 19))
    (pre * (n' * (2 * post))) Bu

/-- **The cost of one `A` axis** (`Cs`: a set-up, `C₀`: the fine-exposure constant, `Cp`: the
kernel set-up, `C1`: the copy step). -/
def axACost (C₀ Cs Cp C1 : ℝ) (p s t α H pk b w f pre post : ℕ) (φ1 φ2 B BH Bk Lmax : ℕ) : ℝ :=
  C1 + (2 * Cs + C₀ * cFine w 5 1 (pre * (t * post))) +
    (2 * Cs + C₀ * cFine w 5 pre (t * post)) +
    (2 * Cs + (cSlabA (32 * t) (8 * (t / (16 * H) * (8 * H))) post pre w
      (J6A.srcG s t H (J6A.WA p α H) (t / (16 * H)) (8 * H)) : ℝ)) +
    (2 * Cs + C₀ * cFine w 3 pre (t / (16 * H) * (8 * H) * post)) +
    (2 * Cs + C₀ * cFine w 3 (pre * (t / (16 * H))) (8 * H * post)) +
    (2 * Cp + (C₀ * cFine w f (pre * (t / (16 * H) * 8)) post +
      C₀ * cFine (pk + 1) f (pre * (t / (16 * H) * 8)) post +
      (kerC ⌊((cAK2 (2 * J6A.WA p α H) (2 * H) (8 * H) pk b φ1 φ2 B BH : ℕ) : ℝ) + 2⌋₊ Bk
        (2 ^ f) post Lmax (t / (16 * H) * 8)
        (tabsT (aTabG p s t α H pk b) (t / (16 * H) * 8)).length pre
        (2 * (pre * (t / (16 * H) * 8) * post * 2 ^ f)) : ℝ))) +
    (2 * Cs + (cSlabA (t / (16 * H) * 8 * (8 * H)) t post pre (pk + 1) (J6A.srcC H (8 * H)) : ℝ))

end J6Seg.Ax

end

end

section
-- Source module: Solutions.J6SegAxA6
/-!
# `A`-line axis program (`AxisUA6`), part 6: the leaf contract `AStepNeed6`

**`AStepNeed6 P`** (A worker): for every descriptor stack `dA ∈ {30, 31}` (slab-free) and every
fine stack `dF ∉ {0, dA}` there is a procedure family, uniform in the table (as
`SlabNeed6`), with

* `eDup`: the copy step `dupL 32` as a `PassOK` step (descriptor `descAx6 P n src D k` on `dA`,
  precondition `|L| = pre · t · post ∧ GB (p + 2) L`);
* four `SetupS` pairs (`![dF]`) for the fine descriptors of the four exposures of `pipeAL`:
  `descFine (p+2) 5 1 (pre·t·post)`, `descFine (p+2) 5 pre (t·post)`,
  `descFine (p+2) 3 pre (M·8H·post)`, `descFine (p+2) 3 (pre·M) (8H·post)`;
* two `SetupS` pairs (`ρS`) for the gather (`srcG`) and compress (`srcC`) slab passes,

each at cost `Cs · cU6 P n A / (D + 1)`. Here `p = pP6 P n`, `s = src k`, `t = tF6 P n k`,
`α = αN6 P n`, `H = HA6 P n`, `M = t / 16H`, `pre = preT P n D k`, `post = postT P n D k`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab

/-- The gather control of axis `k`. -/
def ctlGA (P : Prm) (n : ℕ) (src : ℕ → ℕ) (k : ℕ) : List (ℤ × ℤ) :=
  let t := tF6 P n k; let H := HA6 P n
  ctlOf (32 * t) (8 * (t / (16 * H) * (8 * H)))
    (J6A.srcG (src k) t H (J6A.WA (pP6 P n) (αN6 P n) H) (t / (16 * H)) (8 * H)) (fun _ => 0)

/-- The compress control of axis `k`. -/
def ctlCA (P : Prm) (n : ℕ) (k : ℕ) : List (ℤ × ℤ) :=
  let t := tF6 P n k; let H := HA6 P n
  ctlOf (t / (16 * H) * 8 * (8 * H)) t (J6A.srcC H (8 * H)) (fun _ => 0)

/-- **`AStepNeed6 P`** (the `A`-side IL leaves of the axis program). -/
def AStepNeed6 (P : Prm) : Prop :=
  ∀ dA dF : Fin HS, SlabFree dA → 30 ≤ dA.val → dA.val ≤ 31 → dF ≠ 0 → dF ≠ dA →
  ∃ (nS : ℕ) (US : Fam nS) (eDup e2u e2d e3u e3d e4u e4d e5u e5d e6u e6d e8u e8d : Fin nS)
    (Cs : ℝ) (A n₁ : ℕ), 0 ≤ Cs ∧
  ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D,
  ∀ (tab : Fin 1 → IStmt HS 1) (E : ℕ) (ext : Fin E → IStmt HS (7 + E))
    (idx : Fin nS → Fin (7 + E)), (∀ i, IL.kTableP tab ext (idx i) = US E idx i) →
    ∀ Isym : List Sym,
      let C := Cs * cU6 P n A / (D + 1)
      let tbl := IL.kTableP tab ext
      let desc := descAx6 P n src D k
      let p := pP6 P n; let t := tF6 P n k; let H := HA6 P n; let M := t / (16 * H)
      let pre := preT P n D k; let post := postT P n D k
      PassOK Isym tbl (.call (idx eDup)) dA desc
        (fun L => L.length = pre * (t * post) ∧ GB (p + 2) L) (J6A.dupL 32) C ∧
      SetupS Isym tbl (.call (idx e2u)) (.call (idx e2d)) ![dF] dA desc
        ![descFine (p + 2) 5 1 (pre * (t * post))] C ∧
      SetupS Isym tbl (.call (idx e3u)) (.call (idx e3d)) ![dF] dA desc
        ![descFine (p + 2) 5 pre (t * post)] C ∧
      SetupS Isym tbl (.call (idx e4u)) (.call (idx e4d)) ρS dA desc
        (slabV (ctlGA P n src k) pre post (8 * (M * (8 * H))) [] []) C ∧
      SetupS Isym tbl (.call (idx e5u)) (.call (idx e5d)) ![dF] dA desc
        ![descFine (p + 2) 3 pre (M * (8 * H) * post)] C ∧
      SetupS Isym tbl (.call (idx e6u)) (.call (idx e6d)) ![dF] dA desc
        ![descFine (p + 2) 3 (pre * M) (8 * H * post)] C ∧
      SetupS Isym tbl (.call (idx e8u)) (.call (idx e8d)) ρS dA desc
        (slabV (ctlCA P n k) pre post t [] []) C

end J6Seg.Ax

end

end

section
-- Source module: Solutions.J6SegAxSide
/-!
# B-line axis: the side-component cost budget (statement only)

`SideCost6 P ap`: the fine passes, the four slab passes and the `0 → rZ` copy and `0 ↔ rZ` swap
(at the small register bound `axBcp6 = wd + size(2·prod) + 2`) each cost `≤ C · cU6 P n A / (D+1)`
on every axis of the round-six regime. (Target for the value worker: `P.Ok → ValCond6 ap →
ChunkPlan6 ap → SideCost6 P ap`, or under whatever plan inequalities are needed.)
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- The side costs of axis `k` against `Cc`. -/
def SideCostAt (P : Prm) (ap : AxPlan6) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) (Cc : ℝ) : Prop :=
  let p := axp6 P n; let Q := axQ6 P n src k; let lam := axl6 P n
  let wd := axwd6 P n src k ap; let nc := axnc6 P n k; let G := axG6 P n src k
  let pre := axpre6 P n D k; let post := axpost6 P n D k
  let fC := axfC6 P n; let fJ := axfJ6 P n src k
  let N := 2 * (List.ofFn (tD6 P n D)).prod; let B := axBcp6 P ap n src D k
  cFine wd fC (pre * nc) post ≤ Cc ∧ cFine wd fJ (pre * 1) post ≤ Cc ∧
  (cSlabSc pre (nc * lam) post (p + 2) (Q - p - 1) : ℝ) ≤ Cc ∧
  (cSlabId pre (nc * lam) G post wd : ℝ) ≤ Cc ∧
  (cSlabId pre G (nc * lam) post wd : ℝ) ≤ Cc ∧
  (cSlabOut pre (nc * lam) post wd (2 * p + 6) (Q - p) p : ℝ) ≤ Cc ∧
  (cCopy N B : ℝ) ≤ Cc ∧ (cSwap N B : ℝ) ≤ Cc

/-- **`SideCost6 P ap`**. -/
def SideCost6 (P : Prm) (ap : AxPlan6) : Prop :=
  ∃ (C : ℝ) (A n₁ : ℕ), 0 ≤ C ∧ ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src →
    ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D, SideCostAt P ap n src D k (C * cU6 P n A / (D + 1))

end J6Seg
end

end

section
-- Source module: Solutions.J6SegSideCost2
/-!
# Side costs 2: the sizes of one round-six axis

`AxNum P n src D k`: the natural-number facts the side costs need, on axis `k`
(`T = TP6`, `p = pP6`, `β = log₂ lg n`):
`pre · t · post = T`, `pre, post ≥ 1`, `p ≤ T`, `size (2T) ≤ p`, `Q ≤ 3p`, `log₂ λ ≤ 2β + 2`,
`pre · nc · λ · post ≤ T`, **`d · (pre · G · post) ≤ 99 T`**, `log₂ G ≤ ℓ ≤ p`, `G ≤ 3t`,
`d ≤ T`, `lg n < 2^(β+1)`.
`axNum_ev`: all of them for large `n`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

/-- The numerical facts of axis `k`. -/
structure AxNum (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) : Prop where
  tot : axpre6 P n D k * axt6 P n k * axpost6 P n D k = TP6 P n
  prodT : (List.ofFn (tD6 P n D)).prod = TP6 P n
  pre1 : 1 ≤ axpre6 P n D k
  post1 : 1 ≤ axpost6 P n D k
  t1 : 1 ≤ axt6 P n k
  p1 : 1 ≤ pP6 P n
  pT : pP6 P n ≤ TP6 P n
  sizeT : Nat.size (2 * TP6 P n) ≤ pP6 P n
  Qp : axQ6 P n src k ≤ 3 * pP6 P n
  pQ : axp6 P n + 1 ≤ axQ6 P n src k
  fC : axfC6 P n ≤ 2 * Nat.log 2 (bP6 n) + 2
  lamC : axl6 P n = 2 ^ axfC6 P n
  VC : axpre6 P n D k * axnc6 P n k * axl6 P n * axpost6 P n D k ≤ TP6 P n
  ncl : axnc6 P n k * axl6 P n ≤ axt6 P n k
  VJ : dP6 P n * (axpre6 P n D k * axG6 P n src k * axpost6 P n D k) ≤ 99 * TP6 P n
  Gt : axG6 P n src k ≤ 3 * axt6 P n k
  GJ : axG6 P n src k = 2 ^ axfJ6 P n src k
  fJ : axfJ6 P n src k ≤ ℓP6 P n
  ℓp : ℓP6 P n ≤ pP6 P n
  dT : dP6 P n ≤ TP6 P n
  d1 : 1 ≤ dP6 P n
  βp : Nat.log 2 (bP6 n) ≤ pP6 P n
  bβ : bP6 n < 2 ^ (Nat.log 2 (bP6 n) + 1)

/-! ## Pure helpers -/

end J6Seg.Side
end

end

section
-- Source module: Solutions.J6SegSideCost4
/-!
# Side costs 4: the eight side costs of one axis, as natural-number polynomials

With `W = 3 wA + wC` (so `wd ≤ W p`), `T = TP6`, `p = pP6`, `β = log₂ lg n`, on an axis with
`AxNum`:
* `n1`: chunk fine exposure `≤ 7 (W+9)² · T p (β+1)`;
* `n2`: `d ·` (`J` fine exposure) `≤ 101 (W+12)² · T p (d + ℓ)`;
* `n3`–`n5`: the selection and the two identity slab passes `≤ 10^10 (W+1) · T p`;
* `n6`: the output slab pass `≤ 10^11 (W+11) · T p + 10^7 · T · fmB(2Z)`, `Z = wd + 2p + 8`;
* `n7`, `n8`: the copy and the swap `≤ 10^9 (W+5)² · T p`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

/-- The width constant of a plan. -/
def Wc (ap : AxPlan6) : ℕ := 3 * ap.pl.wA + ap.pl.wC

end J6Seg.Side
end

