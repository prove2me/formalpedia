/-- The reflection move is an involution on quadruples. -/
theorem qk_move (a b c d : ℤ) :
    qk (a - qk a b c d) (b - qk a b c d) (c - qk a b c d) (d - qk a b c d) = -qk a b c d := by
  unfold qk; ring















