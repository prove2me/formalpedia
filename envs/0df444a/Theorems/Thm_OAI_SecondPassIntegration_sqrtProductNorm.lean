theorem OAI.SecondPassIntegration.sqrtProductNorm {ι : Type*} (p : ι → O) (S : Finset ι) :
    Real.sqrt (primeProductNorm p S) = ‖ConcreteTraceCRT.eisEmbedding (∏ i ∈ S, p i)‖ := by sorry
