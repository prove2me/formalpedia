theorem solution (U : TypeDensity.SurfaceUniverse) (a c : ℕ) (ha : 0 < a) (hc : 2 ≤ c) (k : ℕ) :
    ∀ i : U.ι, (U.M i).s = TypeDensity.State.single a c →
    (U.M i).μ (U.returnEvent k i) = TypeDensity.densityValue ((TypeDensity.returnWeight c).pow k) (U.M i).q * (U.M i).μ
        (U.M i).stateSet ∧
    MeasurableSet (U.returnEvent k i) := by
  have hvalid : (TypeDensity.State.single a c).Valid := ⟨ha, by omega⟩
  induction k with
  | zero =>
    intro i hs
    obtain ⟨hq, -, -, -, -⟩ := TypeDensity.universe_basic_facts U i
    refine ⟨?_, U.stateSet_measurable i⟩
    simp only [TypeDensity.SurfaceUniverse.returnEvent, TypeDensity.Expr.pow]
    rw [(TypeDensity.density_value_arith (U.M i).q hq (.const 1) (.const 1) (by norm_num [TypeDensity.Expr.eval])
      (by norm_num [TypeDensity.Expr.eval]) 0 _ hvalid).2.2.2.1, one_mul]
  | succ k ih =>
    intro i hs
    obtain ⟨hq, -, -, -, -⟩ := TypeDensity.universe_basic_facts U i
    obtain ⟨hmass, hmeas⟩ := TypeDensity.self_cells_union_mass U ha hc i hs (U.returnEvent k)
      (TypeDensity.densityValue ((TypeDensity.returnWeight c).pow k) (U.M i).q) fun i' hs' hq' ↦ by
        rw [← hq']; exact ih i' hs'
    refine ⟨hmass.trans ?_, hmeas⟩
    have hy := (TypeDensity.return_weight_bounds _ c hq hc).1.le
    rw [TypeDensity.Expr.pow, (TypeDensity.density_value_arith (U.M i).q hq _ _ (TypeDensity.eval_pow_nonneg _ _ hy k) hy 0 _
      hvalid).1]
    ring
