section
-- Source module: Solutions.R6MCost
/-!
# Round-six machine: the cost of `bigE` in the unit `ZU6`

The frozen `KFMCost` at the round-six parameters. `ZU6 Q = T (p + 1 + fmB (8p)) + (b + 1)^6 + n`.
Every cost of `bigE` other than the interface calls is `O(ZU6 Q)`, and the descriptor parts of a
call are `O((b+1)^2)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open Finset IntMul NLogN NLogN.KIL KFB KFT KFU RS IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM

noncomputable section

section Passes

variable {Q : Q6} (hQ : QOk Q) {D : ℕ} (hD : Q.d = D + 1)
include hQ hD

theorem γ_eq6 : 2 * (D + 1) * Q.α ^ 2 = Q.γ := by rw [← hD]

theorem wU_le6 : wU6 Q D ≤ 2 * Q.p := by
  have h := hQ.hγ
  rw [← γ_eq6 hQ hD] at h
  have hb := hQ.hb
  have hp : Q.p = 6 * Q.b := Q.p_eq
  unfold wU6; omega

theorem wFR_le6 : wFR6 Q D ≤ 3 * Q.p := by
  have := wU_le6 hQ hD
  have hb := hQ.hb
  have hp : Q.p = 6 * Q.b := Q.p_eq
  unfold wFR6; omega

theorem eT2_6 : 2 ^ (Q.L + 1) = 2 * Q.T := by rw [pow_succ]; show _ = 2 * 2 ^ Q.L; ring

theorem fmB_le8_6 {m : ℕ} (hm : m ≤ 8 * Q.p) : KFM.fmB m ≤ KFM.fmB (8 * Q.p) := fmB_mono hm

theorem kCj_le6 {B : ℕ} (hB : B ≤ 3 * Q.p) :
    kCj6 Q B ≤ 10 ^ 6 * (Q.T * (Q.p + 1) + Q.p + 1) := by
  unfold kCj6
  have c1 := cConj_le (2 ^ Q.L) B
  have c4 := cW_nat (2 * 2 ^ Q.L)
  have c5 := cW_nat (2 ^ Q.L)
  have eT : 2 ^ Q.L = Q.T := rfl
  rw [eT] at c1 c4 c5 ⊢
  set T := Q.T
  set p := Q.p
  have m2 := Nat.mul_le_mul_left (T + 1) hB
  have e1 : (T + 1) * (3 * p) = 3 * (T * p) + 3 * p := by ring
  have e2 : T * (p + 1) = T * p + T := by ring
  have e3 : 10000 * (T + 1) * (B + 2) = 10000 * ((T + 1) * B) + 20000 * T + 20000 := by ring
  rw [e3] at c1; rw [e1] at m2; rw [e2]
  omega

set_option maxHeartbeats 2000000 in
theorem kFinA_le6_sol_aux : kFinA6 Q D ≤ 10 ^ 9 * (Q.T * (Q.p + 1 + KFM.fmB (8 * Q.p)) + Q.p + 1) := by
  have hW := wU_le6 hQ hD
  have hR := wFR_le6 hQ hD
  have hb := hQ.hb
  have hF := fmB_le8_6 hQ hD (m := 2 * wFR6 Q D) (by omega)
  have k1 := kCj_le6 hQ hD (B := wU6 Q D) (by omega)
  unfold kFinA6 kSm6 kShF6 kRd6
  have i1 := cItem_le (2 ^ (Q.L + 1)) (KFM.fmB (2 * wFR6 Q D) + 5000 * (wFR6 Q D + 0 + 3))
    (2 * wFR6 Q D)
  have i2 := cItem_le (2 ^ (Q.L + 1)) (1000 * (wFR6 Q D + (2 * Q.b + 4) + 2))
    (wFR6 Q D + (2 * Q.b + 4) + 1)
  have i3 := cItem_le (2 ^ (Q.L + 1)) (3000 * (wFR6 Q D + Q.p + 3)) (2 * wFR6 Q D + 1)
  have c2 := cCnt_le (2 ^ (Q.L + 1))
  have w1 := cW_nat Q.S
  have w2 := cW_pow 0
  have w3 := cW_nat (2 ^ (Q.L + 1))
  have w4 := cW_pow (2 * Q.b + 4)
  have w5 := cW_pow (Q.p - 1)
  have w6 := cW_pow Q.p
  have hS := hQ.S_le_T hD
  rw [eT2_6 hQ hD] at i1 i2 i3 c2 w3 ⊢
  set T := Q.T
  have hS' : Q.S ≤ T := hS
  set F := KFM.fmB (8 * Q.p)
  set R := wFR6 Q D
  have m1 := Nat.mul_le_mul_left T hF
  have m2 := Nat.mul_le_mul_left T hR
  have hbp : Q.b ≤ Q.p := by rw [Q.p_eq]; omega
  have m4 := Nat.mul_le_mul_left T hbp
  have hp1 : Q.p - 1 ≤ Q.p := Nat.sub_le _ _
  clear_value T F R
  generalize kCj6 Q (wU6 Q D) = K at k1 ⊢
  generalize Q.p - 1 = q at hp1 w5 ⊢
  generalize KFM.fmB (2 * R) = F' at i1 hF m1 ⊢
  generalize Q.S = S at w1 hS' ⊢
  set p := Q.p
  set b := Q.b
  have e1 : 2 * T * (F' + 5000 * (R + 0 + 3)) + 5000 * (2 * T + 1) * (2 * R + 2) =
      2 * (T * F') + 30000 * (T * R) + 50000 * T + 10000 * R + 10000 := by ring
  have e2 : 2 * T * (1000 * (R + (2 * b + 4) + 2)) + 5000 * (2 * T + 1) * (R + (2 * b + 4) + 1 + 2) =
      12000 * (T * R) + 24000 * (T * b) + 82000 * T + 5000 * R + 10000 * b + 35000 := by ring
  have e3 : 2 * T * (3000 * (R + p + 3)) + 5000 * (2 * T + 1) * (2 * R + 1 + 2) =
      26000 * (T * R) + 6000 * (T * p) + 48000 * T + 10000 * R + 15000 := by ring
  have e4 : T * (p + 1) = T * p + T := by ring
  have e5 : T * (3 * p) = 3 * (T * p) := by ring
  have e6 : T * (p + 1 + F) = T * p + T + T * F := by ring
  rw [e1] at i1; rw [e2] at i2; rw [e3] at i3; rw [e4] at k1; rw [e5] at m2; rw [e6]
  omega

end Passes

/-! ## Descriptors -/

end

end IntMul.Kappa.R6

end

theorem solution : type_of% @IntMul.Kappa.R6.kFinA_le6_sol_aux := @IntMul.Kappa.R6.kFinA_le6_sol_aux
