-- title:
--   Theorem 2.5
-- statement:
--   For $n\geq1$, write $Z(n)$ for the center of $\mathbb C[S_n]$, with $Z(n-1)$ embedded by fixing the last letter. Put $X_n=\sum_{j<n}(j,n)$. Then
--
--   $$Z(n)\subseteq\langle Z(n-1),X_n\rangle.$$
--
--   The brackets denote the generated unital complex subalgebra. This controls every central element, not merely selected class sums.
-- source:
--   A New Approach to the Representation Thoery of the Symmetric Groups. 2, arXiv:math/0503040v3, PDF p. 10, Theorem 2.5

import Definitions.Def_QAlgorithms_Papers_Independent_Renew46_P26

noncomputable section

namespace QAlgorithms.Papers.Independent.Renew46.P26

open scoped BigOperators

attribute [local instance] Classical.propDecidable

/-- Theorem 2.5 (PDF pp.10–11), inclusion of the full center into the algebra
generated by the previous center and the last YJM element. -/
theorem theorem_2_5 (n : ℕ) :
    Subalgebra.center ℂ (SymmetricAlgebra (n + 1)) ≤
      Algebra.adjoin ℂ ((prefixCenter (Nat.le_succ n) : Set (SymmetricAlgebra (n + 1))) ∪
        {yjm (Fin.last n)}) := by sorry

end QAlgorithms.Papers.Independent.Renew46.P26

end
