  | .sel c x y, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.eval, eval_congr c (fun i hi => h i (Or.inl (Or.inl hi))),
      eval_congr x (fun i hi => h i (Or.inl (Or.inr hi))),
