open MvPowerSeries

variable {B : Type} [CommRing B]

theorem map_nilEval {σ : Type} [Fintype σ] [DecidableEq σ] {C C' : Type} [CommRing C] [Algebra B C]
    [CommRing C'] [Algebra B C'] (g : C →ₐ[B] C') (n : ℕ) (φ : MvPowerSeries σ B)
    (a : σ → C) : g (MvFormalGroup.nilEval n φ a) = MvFormalGroup.nilEval n φ (fun i => g (a i)) := by
  unfold MvFormalGroup.nilEval
  rw [← AlgHom.comp_apply, MvPolynomial.comp_aeval]
  all_goals rfl

theorem constantCoeff_trunc' {σ : Type} [Fintype σ] [DecidableEq σ]
    (n : σ →₀ ℕ) (φ : MvPowerSeries σ B) :
    MvPolynomial.constantCoeff (MvPowerSeries.trunc' B n φ) = MvPowerSeries.constantCoeff φ := by
  show MvPolynomial.coeff 0 (MvPowerSeries.trunc' B n φ) = MvPowerSeries.coeff 0 φ
  rw [MvPowerSeries.coeff_trunc']
  simp

theorem nilEval_zero {σ : Type} [Fintype σ] [DecidableEq σ]
    {B' : Type} [CommRing B'] [Algebra B B'] (k : ℕ) (φ : MvPowerSeries σ B) :
    MvFormalGroup.nilEval k φ (0 : σ → B') = algebraMap B B' (MvPowerSeries.constantCoeff φ) := by
  unfold MvFormalGroup.nilEval
  rw [MvPolynomial.aeval_zero, constantCoeff_trunc']

theorem nilMul_zero_zero {g : ℕ} (F : MvFormalGroup g B)
    {B' : Type} [CommRing B'] [Algebra B B'] (k : ℕ) :
    F.nilMul k (0 : Fin g → B') 0 = 0 := by
  funext i
  show MvFormalGroup.nilEval k (F.toPowerSeries i) (Sum.elim (0 : Fin g → B') 0) = 0
  have : (Sum.elim (0 : Fin g → B') (0 : Fin g → B')) = 0 := by
    funext x; cases x <;> rfl
  rw [this, nilEval_zero, F.constantCoeff_eq_zero i, map_zero]

theorem nilEval_mem {σ : Type} [Fintype σ] [DecidableEq σ]
    {B' : Type} [CommRing B'] [Algebra B B'] (J : Ideal B') (k : ℕ)
    (φ : MvPowerSeries σ B) (hφ : MvPowerSeries.constantCoeff φ = 0) (a : σ → B') (ha : ∀ j, a j ∈ J) :
    MvFormalGroup.nilEval k φ a ∈ J := by
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  unfold MvFormalGroup.nilEval
  have hz : (fun j => (Ideal.Quotient.mk J) (a j)) = 0 :=
    funext fun j => Ideal.Quotient.eq_zero_iff_mem.mpr (ha j)
  have h := congrArg (fun ψ => ψ (MvPowerSeries.trunc' B (Finsupp.equivFunOnFinite.symm fun _ => k) φ))
    (MvPolynomial.comp_aeval a (Ideal.Quotient.mkₐ B J))
  simp only [AlgHom.comp_apply] at h
  rw [Ideal.Quotient.mkₐ_eq_mk] at h
  rw [h, hz, MvPolynomial.aeval_zero, constantCoeff_trunc', hφ, map_zero]

theorem nilMul_mem {g : ℕ} (F : MvFormalGroup g B)
    {B' : Type} [CommRing B'] [Algebra B B'] (J : Ideal B') (k : ℕ) (s t : Fin g → B')
    (hs : ∀ i, s i ∈ J) (ht : ∀ i, t i ∈ J) : ∀ i, F.nilMul k s t i ∈ J := by
  intro i
  show MvFormalGroup.nilEval k (F.toPowerSeries i) (Sum.elim s t) ∈ J
  refine nilEval_mem J k _ (F.constantCoeff_eq_zero i) _ ?_
  rintro (j | j)
  · exact hs j
  · exact ht j

theorem nsmulPt_eq_nsmul {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (n : ℕ) (P : SchemeHomOver t f) :
    nsmulPt L t n P = L.nsmul t n P := by
  induction n with
  | zero => rfl
  | succ n ih =>
    show L.mul t (nsmulPt L t n P) P = L.mul t (L.nsmul t n P) P
    rw [ih]

theorem theta_zero {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of B)} (L : RelativeGroupLaw B f)
    {g : ℕ} (F : MvFormalGroup g B) (θ : RelativeGroupLaw.FormalCoordinates f g) (hθ : L.IsFormalCoordinates F θ)
    (B' : Type) [CommRing B'] [Algebra B B'] :
    θ B' (0 : Fin g → B') = L.one (Scheme.specOver (𝒪 := B) B') := by
  obtain ⟨-, -, -, hhom⟩ := hθ.2 B' (⊥ : Ideal B') 0 (by simp)
  letI := L.pointGroup (Scheme.specOver (𝒪 := B) B')
  have h := hhom 0 0 (fun _ => (⊥ : Ideal B').zero_mem) (fun _ => (⊥ : Ideal B').zero_mem)
  rw [nilMul_zero_zero] at h
  have h' : (θ B' 0 : SchemeHomOver (Scheme.specOver (𝒪 := B) B') f) * θ B' 0 = θ B' 0 * 1 := by
    rw [mul_one]; exact h.symm
  exact mul_left_cancel h'

theorem sup_pow_eq_bot {C : Type} [CommRing C] (J₁ J₂ : Ideal C) (n₁ n₂ : ℕ)
    (h₁ : J₁ ^ (n₁ + 1) = ⊥) (h₂ : J₂ ^ (n₂ + 1) = ⊥) :
    (J₁ ⊔ J₂) ^ ((n₁ + n₂ + 1) + 1) = ⊥ := by
  have h := Ideal.sup_pow_add_le_pow_sup_pow (I := J₁) (J := J₂) (m := n₂ + 1) (n := n₁ + 1)
  rw [h₁, h₂, bot_sup_eq, le_bot_iff] at h
  rw [show n₁ + n₂ + 1 + 1 = (n₁ + 1) + (n₂ + 1) by omega]
  exact h

theorem isNilpotent_of_mem {C : Type} [CommRing C] (I : Ideal C) (m : ℕ) (hI : I ^ (m + 1) = ⊥) (x : C)
    (hx : x ∈ I) : IsNilpotent x :=
  ⟨m + 1, by have := Ideal.pow_mem_pow hx (m + 1); rwa [hI, Ideal.mem_bot] at this⟩

theorem isIndefiniteRamifiedExactlyAt_symm {a b : ℚ} {q q' : ℕ} (h : IsIndefiniteRamifiedExactlyAt a b q q') :
    IsIndefiniteRamifiedExactlyAt a b q' q :=
  ⟨h.1, fun v => (h.2 v).trans or_comm⟩

