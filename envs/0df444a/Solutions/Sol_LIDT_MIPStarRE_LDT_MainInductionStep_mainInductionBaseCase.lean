# Section 6 — Ordinary Self-Improvement Data

Core public API for the ordinary self-improvement data: constructors for
`SelfImprovementData`, the induction-section theorem
`selfImprovementInInductionSection`, the monotone-witness cleanup
`mainInductionOfWitness`, and the source-facing pasting theorem
`ldPastingInInductionSection`.

The answer-valued slice-transport constructors are separated into
`SelfImprovementAssembly.AnswerSlice`.

## References

- `blueprint/src/chapter/ch10_induction.tex`
-/

@[expose] public section

namespace MIPStarRE.LDT.MainInductionStep

open MIPStarRE.LDT
open scoped MatrixOrder

universe uι

variable {ι : Type uι} [Fintype ι] [DecidableEq ι]

/-- Monotone postprocessing of an explicit witness for the main-induction conclusion.

This helper is the final `error ≤ mainInductionError` cleanup step only; the
actual Section 6 construction is carried by `mainInductionBaseCase`,
`mainInduction`, and their predecessor, self-improvement, and pasting
construction lemmas. -/
theorem mainInductionOfWitness
    (params : Parameters)
    [FieldModel params.q]
    (strategy : SymStrat params ι)
    (eps delta gamma : Error)
    (k : ℕ)
    (hwitness :
      ∃ error : Error, ∃ G : Measurement (Polynomial params) ι,
        ConsRel strategy.state (uniformDistribution (Point params))
          (IdxProjMeas.toIdxSubMeas strategy.pointMeasurement)
          (polynomialEvaluationFamily params G.toSubMeas)
          error ∧
        error ≤ mainInductionError params k eps delta gamma) :
    ∃ G : Measurement (Polynomial params) ι,
      ConsRel strategy.state (uniformDistribution (Point params))
        (IdxProjMeas.toIdxSubMeas strategy.pointMeasurement)
        (polynomialEvaluationFamily params G.toSubMeas)
        (mainInductionError params k eps delta gamma) := by
  rcases hwitness with ⟨error, G, hG, herror⟩
  refine ⟨G, ?_⟩
  exact ⟨le_trans hG.offDiagonalBound herror⟩




























end MIPStarRE.LDT.MainInductionStep

end

end LIDT

open LIDT
/-!
# Section 6 — Main Induction Theorems: Base and Large-Error Branches

This module contains the base cases and the trivial large-error branches for the
ordinary and answer-valued main induction statements.
-/

@[expose] public section

open LIDT.MIPStarRE.LDT.MainInductionStep

open MIPStarRE.LDT
open scoped MatrixOrder

universe uι

variable {ι : Type uι} [Fintype ι] [DecidableEq ι]

theorem solution
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters)
    [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (strategy : _root_.LIDT.MIPStarRE.LDT.SymStrat params ι)
    (eps delta gamma : _root_.LIDT.MIPStarRE.LDT.Error)
    (k : ℕ)
    (hm1 : params.m = 1)
    (hgood : strategy.IsGood eps delta gamma) :
    ∃ G : _root_.LIDT.MIPStarRE.LDT.Measurement (_root_.LIDT.MIPStarRE.LDT.Polynomial params) ι,
      _root_.LIDT.MIPStarRE.LDT.ConsRel strategy.state (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Point params))
        (_root_.LIDT.MIPStarRE.LDT.IdxProjMeas.toIdxSubMeas strategy.pointMeasurement)
        (_root_.LIDT.MIPStarRE.LDT.polynomialEvaluationFamily params G.toSubMeas)
        (_root_.LIDT.MIPStarRE.LDT.MainInductionStep.mainInductionError params k eps delta gamma) := by
  classical
  have hsub : Subsingleton (Fin params.m) := by
    rw [hm1]
    infer_instance
  let i0 : Fin params.m := ⟨0, by simp [hm1]⟩
  let eSample : _root_.LIDT.MIPStarRE.LDT.AxisParallelTestSample params ≃ _root_.LIDT.MIPStarRE.LDT.Point params :=
    { toFun := fun s => s.1
      invFun := fun u => (u, i0)
      left_inv := fun s => Prod.ext rfl (Subsingleton.elim _ _)
      right_inv := fun _ => rfl }
  let canonicalLine : _root_.LIDT.MIPStarRE.LDT.AxisParallelLine params :=
    _root_.LIDT.MIPStarRE.LDT.AxisParallelLine.throughPoint (params := params) _root_.LIDT.MIPStarRE.LDT.zeroPoint i0
  let G : _root_.LIDT.MIPStarRE.LDT.Measurement (_root_.LIDT.MIPStarRE.LDT.Polynomial params) ι :=
    { toSubMeas :=
        _root_.LIDT.MIPStarRE.LDT.postprocess ((strategy.axisParallelMeasurement canonicalLine).toSubMeas)
          (_root_.LIDT.MIPStarRE.LDT.axisLinePolynomialToPolynomial params i0)
      total_eq_one := (strategy.axisParallelMeasurement canonicalLine).total_eq_one }
  have haxisRaw :
      _root_.LIDT.MIPStarRE.LDT.ConsRel strategy.state (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.AxisParallelTestSample params))
        (_root_.LIDT.MIPStarRE.LDT.axisParallelPointAnswerFamily strategy)
        (_root_.LIDT.MIPStarRE.LDT.axisParallelLineAnswerFamily strategy)
        strategy.axisParallelFailureProbability := by
    exact ⟨le_rfl⟩
  have haxisPoint :
      _root_.LIDT.MIPStarRE.LDT.ConsRel strategy.state (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Point params))
        (_root_.LIDT.MIPStarRE.LDT.IdxProjMeas.toIdxSubMeas strategy.pointMeasurement)
        (fun u =>
          _root_.LIDT.MIPStarRE.LDT.postprocess
            ((strategy.axisParallelMeasurement { base := u, direction := i0 }).toSubMeas)
            (· _root_.LIDT.MIPStarRE.LDT.zeroCoord))
        strategy.axisParallelFailureProbability := by
    change _root_.LIDT.MIPStarRE.LDT.ConsRel strategy.state (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Point params))
      (fun b => (strategy.pointMeasurement b).toSubMeas)
      (fun u =>
        _root_.LIDT.MIPStarRE.LDT.postprocess
          ((strategy.axisParallelMeasurement { base := u, direction := i0 }).toSubMeas)
          (· _root_.LIDT.MIPStarRE.LDT.zeroCoord))
      strategy.axisParallelFailureProbability
    simpa [_root_.LIDT.MIPStarRE.LDT.axisParallelPointAnswerFamily, _root_.LIDT.MIPStarRE.LDT.axisParallelLineAnswerFamily,
      _root_.LIDT.MIPStarRE.LDT.axisParallelPointAnswerFamilyOf, _root_.LIDT.MIPStarRE.LDT.axisParallelLineAnswerFamilyOf, eSample, i0] using
      ((_root_.LIDT.MIPStarRE.LDT.Preliminaries.consRel_uniform_equiv
        (e := eSample)
        (ψ := strategy.state)
        (A := _root_.LIDT.MIPStarRE.LDT.axisParallelPointAnswerFamily strategy)
        (B := _root_.LIDT.MIPStarRE.LDT.axisParallelLineAnswerFamily strategy)
        (δ := strategy.axisParallelFailureProbability)).mp haxisRaw)
  have hfamily :
      (fun u =>
        _root_.LIDT.MIPStarRE.LDT.postprocess
          ((strategy.axisParallelMeasurement { base := u, direction := i0 }).toSubMeas)
          (· _root_.LIDT.MIPStarRE.LDT.zeroCoord)) =
        _root_.LIDT.MIPStarRE.LDT.polynomialEvaluationFamily params G.toSubMeas := by
    funext u
    apply _root_.LIDT.MIPStarRE.LDT.SubMeas.ext
    · intro a
      calc
        (_root_.LIDT.MIPStarRE.LDT.postprocess
            ((strategy.axisParallelMeasurement { base := u, direction := i0 }).toSubMeas)
            (· _root_.LIDT.MIPStarRE.LDT.zeroCoord)).outcome a
          = (_root_.LIDT.MIPStarRE.LDT.postprocess
              ((strategy.axisParallelMeasurement
                (_root_.LIDT.MIPStarRE.LDT.AxisParallelLine.rebaseAt
                  (_root_.LIDT.MIPStarRE.LDT.AxisParallelLine.throughPoint (params := params) u i0)
                  (_root_.LIDT.MIPStarRE.LDT.AxisParallelLine.sampleParameter (params := params) u i0))).toSubMeas)
              (· _root_.LIDT.MIPStarRE.LDT.zeroCoord)).outcome a := by
                simp [_root_.LIDT.MIPStarRE.LDT.AxisParallelLine.rebaseAt_throughPoint_sampleParameter]
        _ = (_root_.LIDT.MIPStarRE.LDT.postprocess
              ((strategy.axisParallelMeasurement
                (_root_.LIDT.MIPStarRE.LDT.AxisParallelLine.throughPoint (params := params) u i0)).toSubMeas)
              (fun f =>
                f (_root_.LIDT.MIPStarRE.LDT.AxisParallelLine.sampleParameter (params := params) u i0))).outcome a := by
                exact
                  (_root_.LIDT.MIPStarRE.LDT.AxisParallelCovariantMeasurement.reparamInvariant
                    strategy.axisParallelMeasurement) _ _ _
        _ = (_root_.LIDT.MIPStarRE.LDT.postprocess
              ((strategy.axisParallelMeasurement canonicalLine).toSubMeas)
              (fun f => f (u i0))).outcome a := by
                have hthrough :
                    _root_.LIDT.MIPStarRE.LDT.AxisParallelLine.throughPoint (params := params) u i0 = canonicalLine := by
                  simpa [canonicalLine] using
                    _root_.LIDT.MIPStarRE.LDT.MainInductionStep.throughPoint_eq_zeroPoint_of_m_eq_one params hm1 u i0
                simp [hthrough, _root_.LIDT.MIPStarRE.LDT.AxisParallelLine.sampleParameter]
        _ = (_root_.LIDT.MIPStarRE.LDT.polynomialEvaluationFamily params G.toSubMeas u).outcome a := by
              simp [_root_.LIDT.MIPStarRE.LDT.polynomialEvaluationFamily, _root_.LIDT.MIPStarRE.LDT.evaluateAt, G,
                _root_.LIDT.MIPStarRE.LDT.axisLinePolynomialToPolynomial_apply]
    · change
          (_root_.LIDT.MIPStarRE.LDT.postprocess
              ((strategy.axisParallelMeasurement { base := u, direction := i0 }).toSubMeas)
              (· _root_.LIDT.MIPStarRE.LDT.zeroCoord)).total =
            (_root_.LIDT.MIPStarRE.LDT.postprocess ((strategy.axisParallelMeasurement canonicalLine).toSubMeas)
              (fun f => f (u i0))).total
      rw [show
          (_root_.LIDT.MIPStarRE.LDT.postprocess
              ((strategy.axisParallelMeasurement { base := u, direction := i0 }).toSubMeas)
              (· _root_.LIDT.MIPStarRE.LDT.zeroCoord)).total =
            (strategy.axisParallelMeasurement { base := u, direction := i0 }).total by rfl]
      rw [show
          (_root_.LIDT.MIPStarRE.LDT.postprocess ((strategy.axisParallelMeasurement canonicalLine).toSubMeas)
              (fun f => f (u i0))).total =
            (strategy.axisParallelMeasurement canonicalLine).total by rfl]
      rw [(strategy.axisParallelMeasurement { base := u, direction := i0 }).total_eq_one,
        (strategy.axisParallelMeasurement canonicalLine).total_eq_one]
  have hconsG :
      _root_.LIDT.MIPStarRE.LDT.ConsRel strategy.state (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Point params))
        (_root_.LIDT.MIPStarRE.LDT.IdxProjMeas.toIdxSubMeas strategy.pointMeasurement)
        (_root_.LIDT.MIPStarRE.LDT.polynomialEvaluationFamily params G.toSubMeas)
        strategy.axisParallelFailureProbability := by
    simpa [hfamily] using haxisPoint
  have heps_nonneg : 0 ≤ eps := by
    exact le_trans
      (_root_.LIDT.MIPStarRE.LDT.bipartiteConsError_nonneg strategy.state
        (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.AxisParallelTestSample params))
        (_root_.LIDT.MIPStarRE.LDT.axisParallelPointAnswerFamily strategy)
        (_root_.LIDT.MIPStarRE.LDT.axisParallelLineAnswerFamily strategy))
      hgood.axisParallelTest
  have hdelta_nonneg : 0 ≤ delta := by
    exact le_trans
      (_root_.LIDT.MIPStarRE.LDT.bipartiteSSCError_nonneg strategy.state
        (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Point params))
        (_root_.LIDT.MIPStarRE.LDT.IdxProjMeas.toIdxSubMeas strategy.pointMeasurement))
      hgood.selfConsistencyTest
  have hdiag_nonneg : 0 ≤ strategy.diagonalFailureProbability :=
    _root_.LIDT.MIPStarRE.LDT.diagonalFailureProbability_nonneg params strategy
  have hgamma_nonneg : 0 ≤ gamma := le_trans hdiag_nonneg hgood.diagonalLineTest
  have haxis_le_one : strategy.axisParallelFailureProbability ≤ 1 := by
    simpa [_root_.LIDT.MIPStarRE.LDT.SymStrat.axisParallelFailureProbability] using
      _root_.LIDT.MIPStarRE.LDT.bipartiteConsError_uniform_le_one
        strategy.state strategy.isNormalized
        (_root_.LIDT.MIPStarRE.LDT.axisParallelPointAnswerFamily strategy)
        (_root_.LIDT.MIPStarRE.LDT.axisParallelLineAnswerFamily strategy)
  have herror_le :
      strategy.axisParallelFailureProbability ≤ _root_.LIDT.MIPStarRE.LDT.MainInductionStep.mainInductionError params k eps delta gamma := by
    exact le_trans
      (le_min hgood.axisParallelTest haxis_le_one)
      (_root_.LIDT.MIPStarRE.LDT.MainInductionStep.min_eps_one_le_mainInductionError_of_m_eq_one
        params k eps delta gamma hm1 heps_nonneg hdelta_nonneg hgamma_nonneg)
  exact
    _root_.LIDT.MIPStarRE.LDT.MainInductionStep.mainInductionOfWitness params strategy eps delta gamma k
      ⟨strategy.axisParallelFailureProbability, G, hconsG, herror_le⟩
