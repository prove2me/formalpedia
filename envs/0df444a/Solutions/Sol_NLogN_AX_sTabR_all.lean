open IntMul.HvdH IntMul.HvdH.Ref

theorem geo9 (K : ℕ) : ∀ B : ℕ, ∑ k ∈ Finset.range K, B / 9 ^ k ≤ B + B / 8 := by
  induction K with
  | zero => intro B; simp
  | succ K ih =>
    intro B
    rw [Finset.sum_range_succ']
    have e : ∀ k, B / 9 ^ (k + 1) = B / 9 / 9 ^ k := by
      intro k; rw [Nat.div_div_eq_div_mul, pow_succ']
    simp only [e, pow_zero, Nat.div_one]
    have := ih (B / 9)
    omega

theorem atanh3_le (N K : ℕ) :
    ∑ k ∈ Finset.range K, 2 ^ N / ((2 * k + 1) * 3 ^ (2 * k + 1)) ≤
      2 ^ N / 3 + 2 ^ N / 3 / 8 := by
  refine le_trans (Finset.sum_le_sum fun k _ => ?_) (geo9 K (2 ^ N / 3))
  rw [Nat.div_div_eq_div_mul]
  apply Nat.div_le_div_left _ (by positivity)
  rw [pow_succ, pow_mul]
  norm_num
  nlinarith [Nat.one_le_pow k 9 (by norm_num)]

theorem log2Bits_le_pow (M : ℕ) : log2Bits M ≤ 2 ^ M := by
  have hA := atanh3_le (2 * M + 9) (2 * M + 9)
  set S := ∑ k ∈ Finset.range (2 * M + 9), 2 ^ (2 * M + 9) / ((2 * k + 1) * 3 ^ (2 * k + 1))
  have hlog : log2Approx (2 * M + 9) = 2 * (S : ℤ) := by
    simp only [log2Approx, atanhInv, S]; push_cast; ring
  have hZ : (2 : ℕ) ^ (2 * M + 9) = 4 * (2 ^ M * 2 ^ (M + 7)) := by
    rw [show 2 * M + 9 = 2 + (M + (M + 7)) by omega, pow_add, pow_add]; norm_num
  rw [hZ] at hA
  set Z := 2 ^ M
  set Y := 2 ^ (M + 7)
  have hS2 : 2 * S ≤ 3 * (Z * Y) := by omega
  simp only [log2Bits]
  rw [hlog]
  have hY8 : (2 : ℤ) ^ (M + 8) = 2 * (Y : ℤ) := by
    simp only [Y]; push_cast; rw [pow_succ]; ring
  have hY9 : (2 : ℤ) ^ (M + 9) = 4 * (Y : ℤ) := by
    simp only [Y]; push_cast; rw [show M + 9 = M + 7 + 2 by omega, pow_add]; ring
  have hZ' : (2 : ℤ) ^ M = (Z : ℤ) := by simp [Z]
  rw [hY8, hY9, hZ']
  have hY1 : (1 : ℤ) ≤ Y := by simp only [Y]; exact_mod_cast Nat.one_le_two_pow
  have hZ1 : (1 : ℤ) ≤ Z := by simp only [Z]; exact_mod_cast Nat.one_le_two_pow
  have hlt : 2 * (S : ℤ) + 2 * Y < ((Z : ℤ) + 1) * (4 * Y) := by
    have : (2 * S : ℤ) ≤ 3 * (Z * Y) := by exact_mod_cast hS2
    nlinarith
  have := Int.ediv_lt_of_lt_mul (by positivity) hlt
  omega

theorem expTerm_real_bnd (N : ℕ) (x : ℤ) (hx : |x| ≤ 2 ^ N) :
    ∀ j, (expTerm N x 0 j).2 = 0 ∧ |(expTerm N x 0 j).1| ≤ 2 ^ N := by
  intro j
  induction j with
  | zero => simp [expTerm]
  | succ j ih =>
    obtain ⟨h2, h1⟩ := ih
    have hd : (0 : ℤ) < ((j : ℤ) + 1) * 2 ^ N := by positivity
    have e : expTerm N x 0 (j + 1) =
        (((expTerm N x 0 j).1 * x - (expTerm N x 0 j).2 * 0) / (((j : ℤ) + 1) * 2 ^ N),
          ((expTerm N x 0 j).1 * 0 + (expTerm N x 0 j).2 * x) / (((j : ℤ) + 1) * 2 ^ N)) := by
      simp [expTerm]
    rw [e, h2]
    simp only [mul_zero, sub_zero, zero_mul, add_zero, Int.zero_ediv, true_and]
    apply NLogN.abs_ediv_le_of _ _ _ hd
    rw [abs_mul]
    have h0 : (0 : ℤ) ≤ 2 ^ N := by positivity
    have hj : (1 : ℤ) ≤ (j : ℤ) + 1 := by linarith [(Nat.cast_nonneg j : (0 : ℤ) ≤ j)]
    calc |(expTerm N x 0 j).1| * |x| ≤ 2 ^ N * 2 ^ N :=
          mul_le_mul h1 hx (abs_nonneg _) h0
      _ ≤ 2 ^ N * (((j : ℤ) + 1) * 2 ^ N) := by nlinarith

theorem expApprox_real_bnd (N K : ℕ) (x : ℤ) (hx : |x| ≤ 2 ^ N) :
    |(expApprox N K x 0).1| ≤ K * 2 ^ N := by
  induction K with
  | zero => simp [expApprox]
  | succ K ih =>
    rw [NLogN.expApprox_succ]
    have := (expTerm_real_bnd N x hx K).2
    refine (abs_add_le _ _).trans ?_
    push_cast; linarith

theorem expBits_real_bnd (M : ℕ) (z : ℤ) (hz : |z| ≤ 2 ^ M) :
    |(expBits M z 0).1| ≤ (2 * M + 14) * 2 ^ M := by
  simp only [expBits, zero_mul]
  have hx : |z * 2 ^ (M + 9)| ≤ 2 ^ (2 * M + 9) := by
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℤ) < 2 ^ (M + 9)),
      show (2 : ℤ) ^ (2 * M + 9) = 2 ^ M * 2 ^ (M + 9) by rw [← pow_add]; ring_nf]
    exact mul_le_mul_of_nonneg_right hz (by positivity : (0 : ℤ) ≤ 2 ^ (M + 9))
  have he := expApprox_real_bnd (2 * M + 9) (2 * M + 13) _ hx
  apply NLogN.abs_ediv_le_of _ _ _ (by positivity)
  have e1 : (2 : ℤ) ^ (2 * M + 9) = 2 ^ M * 2 ^ (M + 9) := by rw [← pow_add]; ring_nf
  have e2 : (2 : ℤ) ^ (M + 9) = 2 * 2 ^ (M + 8) := by rw [pow_succ]; ring
  have h8 : (2 : ℤ) ^ (M + 8) ≤ 2 ^ M * 2 ^ (M + 9) := by
    rw [e2]; have : (1 : ℤ) ≤ 2 ^ M := one_le_pow₀ (by norm_num)
    have : (0 : ℤ) ≤ 2 ^ (M + 8) := by positivity
    nlinarith
  refine (abs_add_le _ _).trans ?_
  rw [abs_of_pos (by positivity : (0 : ℤ) < 2 ^ (M + 8))]
  rw [e1] at he
  push_cast at he ⊢
  nlinarith

theorem expNegFix_abs_le (n M : ℕ) (X : ℤ) : |expNegFix n M X| ≤ (2 * M + 15) * 2 ^ n := by
  have hL0 := NLogN.log2Bits_pos M
  have hLM := log2Bits_le_pow M
  simp only [expNegFix]
  generalize log2Bits M = L at *
  set τ := -X / L
  have hr0 := Int.emod_nonneg (-X) (show L ≠ 0 by omega)
  have hr1 := Int.emod_lt_of_pos (-X) hL0
  have hed := Int.emod_def (-X) L
  have hz : |X + τ * L| ≤ 2 ^ M := by
    have : X + τ * L = -((-X) % L) := by simp only [τ]; rw [hed]; ring
    rw [this, abs_neg, abs_of_nonneg hr0]; linarith
  have hu := expBits_real_bnd M _ hz
  generalize (expBits M (X + τ * L) 0).1 = u at *
  set s := M - n - 1 + τ.toNat
  apply NLogN.abs_ediv_le_of _ _ _ (by positivity)
  have hM : (2 : ℤ) ^ M ≤ 2 ^ n * 2 ^ (s + 1) := by
    rw [← pow_add]; exact pow_le_pow_right₀ (by norm_num) (by omega)
  have hs : (2 : ℤ) ^ s ≤ 2 ^ n * 2 ^ (s + 1) := by
    rw [← pow_add]; exact pow_le_pow_right₀ (by norm_num) (by omega)
  refine (abs_add_le _ _).trans ?_
  rw [abs_of_pos (by positivity : (0 : ℤ) < 2 ^ s)]
  have hc : (0 : ℤ) ≤ 2 * (M : ℤ) + 14 := by positivity
  have := mul_le_mul_of_nonneg_left hM hc
  nlinarith

theorem expNegFix_natAbs_le (n M : ℕ) (X : ℤ) :
    (expNegFix n M X).natAbs ≤ (2 * M + 15) * 2 ^ n := by
  have h := expNegFix_abs_le n M X
  rw [Int.abs_eq_natAbs] at h
  exact_mod_cast h

/-- The exponential weights: `|expNeg n k j| ≤ (4n+35) 2^n`. -/
theorem expNeg_natAbs_le (n k j : ℕ) : (expNeg n k j).natAbs ≤ (4 * n + 35) * 2 ^ n := by
  unfold expNeg
  split_ifs
  · simp
  · have := expNegFix_natAbs_le n (2 * n + 10) (-(piBits (2 * n + 10) * j / k))
    rw [show 2 * (2 * n + 10) + 15 = 4 * n + 35 by ring] at this; exact this

theorem betaT_natAbs_le (p α : ℕ) : (betaT p α).natAbs ≤ 2 ^ p := by
  simp only [betaT, Int.natAbs_natCast]; exact Nat.div_le_self _ _

