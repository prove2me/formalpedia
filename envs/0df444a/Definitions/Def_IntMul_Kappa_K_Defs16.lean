-- Source module: Solutions.KFMR19
/-!
# Item 12 (math side): Lemma 19/20 with the base witnesses and a permutation-free `B̃₀`

The resampling identities of `Resample19`/`ResampleTensor`/`ResampleFinal` are existential in
the maps `A`, `B₀`. The machine computes the base thread's fixed-point maps `Sapprox` and
`Bapprox`. This file pins the witnesses to those maps.

* `lemma19_base`: for one axis, the base maps `A`, `B` of Proposition 4.7 give
  `P_s F_s = 2^{2α²} B₀ P_t F_t A` with `B₀ := P_s ∘ B ∘ P_t⁻¹` (`reidx` maps), and the
  **permutation-free** procedure `B0approx = D̃' ∘ J̃' ∘ C̃` approximates `2^p B₀`. The error
  bound is the base `Bapprox` bound, because `Bapprox = P̃_s⁻¹ ∘ B0approx ∘ P̃_t`.
* `tensor_of_lines_expl`: `tensor_of_lines` with the explicit witnesses `tensCLM (kerA A)` and
  `tensCLM (kerB B)`.
* `lemma19_fp`: the same in the `FPApprox`/`SupLip` form of base `prop_4_7_fp`, with the
  periodic read-out `B0P` (index mod `s`) and the `ℕ`-lifts `liftL`.
* `lemma20_base`, `source_transform_base`: Lemma 20 and the chirp form of the source transform,
  with tensor witnesses built from per-axis maps whose `Sapprox` / `B0approx` bounds hold.

The §9 glue does not consume the existential forms (only `ResampleAll` prints their axioms),
so no bridge lemma is needed.
-/

open Complex

namespace NLogN.KFM

open IntMul.OpenAI.RT

/-! ### Reindexing contractions -/

/-- `(reidx σ u)_j = u_{σ j}`. -/
noncomputable def reidx {α β : Type} [Fintype α] [Fintype β] (σ : β → α) :
    (α → ℂ) →L[ℂ] (β → ℂ) :=
  ContinuousLinearMap.pi fun j => ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : α => ℂ) (σ j)

@[simp] lemma reidx_apply {α β : Type} [Fintype α] [Fintype β] (σ : β → α) (u : α → ℂ) (j : β) :
    NLogN.KFM.reidx σ u j = u (σ j) := rfl

/-! ### The permutation-free procedure and the single-axis statement -/

/-- `P_t⁻¹` as an index map: `k ↦ -(s⁻¹ k)`. -/
noncomputable def tauT (s t : ℕ) (k : ZMod t) : ZMod t := -((s : ZMod t)⁻¹ * k)

/-- `B₀ = P_s ∘ B ∘ P_t⁻¹`. -/
noncomputable def B0of (s t : ℕ) [NeZero s] [NeZero t] (B : (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ)) :
    (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ) :=
  (NLogN.KFM.reidx (fun l : ZMod s => (t : ZMod s) * l)).comp (B.comp (NLogN.KFM.reidx (tauT s t)))

/-- `W ∘ P_t⁻¹` on `ℕ` indices: `(unPt W)_i = W_{-(s⁻¹ i) mod t}`. -/
noncomputable def unPt (s t : ℕ) (W : ℕ → ℤ × ℤ) : ℕ → ℤ × ℤ :=
  fun i => W (tauT s t (i : ZMod t)).val

/-! ### The `FPApprox` form (base Proposition 4.7, `prop_4_7_fp`) -/

/-- A line map on `ℤ/a` lifted to `ℕ`-indexed arrays (reads `[0,a)`, periodic output). -/
noncomputable def liftL {a b : ℕ} (L : (ZMod a → ℂ) →L[ℂ] (ZMod b → ℂ)) :
    (ℕ → ℂ) → (ℕ → ℂ) :=
  fun x j => L (fun k => x k.val) (j : ZMod b)

/-! ### Explicit tensor witnesses -/

variable {d : ℕ}

/-- Kernel of a family of line maps `A i : ℂ^{s_i} → ℂ^{t_i}`. -/
noncomputable def kerA {s t : Fin d → ℕ} [∀ i, NeZero (s i)] [∀ i, NeZero (t i)]
    (A : (i : Fin d) → (ZMod (s i) → ℂ) →L[ℂ] (ZMod (t i) → ℂ)) :
    (i : Fin d) → ZMod (t i) → ZMod (s i) → ℂ :=
  fun i l j => A i (Pi.single j 1) l

/-- Kernel of a family of line maps `B i : ℂ^{t_i} → ℂ^{s_i}`. -/
noncomputable def kerB {s t : Fin d → ℕ} [∀ i, NeZero (s i)] [∀ i, NeZero (t i)]
    (B : (i : Fin d) → (ZMod (t i) → ℂ) →L[ℂ] (ZMod (s i) → ℂ)) :
    (i : Fin d) → ZMod (s i) → ZMod (t i) → ℂ :=
  fun i k m => B i (Pi.single m 1) k

/-- Per-axis base data: the maps of `lemma19_fp` with their identities, `FPApprox` bounds and
Lipschitz facts. -/
structure AxisMaps (p α : ℕ) (s t : Fin d → ℕ) [∀ i, NeZero (s i)] [∀ i, NeZero (t i)] where
  A : (i : Fin d) → (ZMod (s i) → ℂ) →L[ℂ] (ZMod (t i) → ℂ)
  B : (i : Fin d) → (ZMod (t i) → ℂ) →L[ℂ] (ZMod (s i) → ℂ)
  hA : ∀ i, ‖A i‖ ≤ 1
  hB : ∀ i, ‖B i‖ ≤ 1
  hid : ∀ i u, IntMul.OpenAI.RH.permS (s i) (t i) ((s i : ℂ)⁻¹ • ZMod.dft u) =
    (2 : ℂ) ^ (2 * α ^ 2) • B i (IntMul.OpenAI.RH.permT (s i) (t i) ((t i : ℂ)⁻¹ • ZMod.dft (A i u)))
  hS : ∀ i, IntMul.HvdH.FPApprox p (IntMul.HvdH.Sapprox p (s i) (t i) α) (NLogN.KFM.liftL (A i))
    (6 * IntMul.HvdH.sWidth p α + 4)
  hB0 : ∀ i, IntMul.HvdH.FPApprox p (B0P p (s i) (t i) α) (NLogN.KFM.liftL (B i))
    (IntMul.HvdH.jIter p (s i) (t i) α * (10 * IntMul.HvdH.eWidth p α + 12) + 4)
  hLA : ∀ i, IntMul.HvdH.SupLip (NLogN.KFM.liftL (A i))
  hLB : ∀ i, IntMul.HvdH.SupLip (NLogN.KFM.liftL (B i))

end NLogN.KFM

