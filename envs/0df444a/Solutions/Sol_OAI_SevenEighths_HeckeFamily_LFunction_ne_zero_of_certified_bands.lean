    (∀s : ℂ,7/8<s.re→‖sourceCorrection η S s-1‖≤1/2) := by
  exact ⟨excludePrimes_mask η S hS.prime,
    (sourceCorrection_differentiable η S hS).analyticOnNhd (Complex.isOpen_re_gt _),
