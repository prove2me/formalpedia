-- title:
--   Denominators of the minimal polynomial of λ(q^q) over ℚ(λ)
-- statement:
--   Let $q$ be a prime and $k$ a natural number. Write $\lambda =$ `lambdaModC ℚ` for the Laurent series over $\mathbb Q$ obtained by applying the coefficientwise map $\mathbb Z \to \mathbb Q$ to `lambdaInt`, the product of the monomial $\mathfrak q$ with `etaProd`$^{8}$, with the series `etaProd`$^{16}$ after substituting $\mathfrak q \mapsto \mathfrak q^{4}$, and with `dedekindEtaUnitInv` after substituting $\mathfrak q \mapsto \mathfrak q^{2}$; and write $\lambda_q =$ `lambdaNModC ℚ q` for the image of $\lambda$ under `qExpand ℚ q`, the ring endomorphism of `LaurentSeries ℚ` that multiplies all exponents by $q$. Inside the field `LaurentSeries ℚ` consider the intermediate field $\mathbb Q(\lambda)$ generated by $\lambda$ over $\mathbb Q$, and let $m$ be the minimal polynomial of $\lambda_q$ over $\mathbb Q(\lambda)$. The assertion is that for each $k$ there exists a natural number $N$ such that
--   $$\bigl(\lambda\,(1-16\lambda)^{4}\bigr)^{N}\cdot m_k \in \mathbb Q[\lambda],$$
--   where $m_k$ denotes the $k$-th coefficient of $m$, viewed in `LaurentSeries ℚ`, and $\mathbb Q[\lambda]$ is the $\mathbb Q$-subalgebra `Algebra.adjoin ℚ {lambdaModC ℚ}`. The exponent $N$ is allowed to depend on $k$ (and on $q$).
--
--   This is the pole-control step for the level-$q$ modular equation in the Legendre-type parameter $\lambda$: the coefficients of the minimal polynomial of $\lambda(\mathfrak q^{q})$ over $\mathbb Q(\lambda)$ have denominators supported on $\lambda$ and $1-16\lambda$, so that they lie in $\mathbb Q[\lambda][(\lambda(1-16\lambda)^{4})^{-1}]$. It feeds [`ModularCurve.minpoly_lambdaNModC_coeff_mem_adjoin`](thm.html#ModularCurve.minpoly_lambdaNModC_coeff_mem_adjoin), and its proof draws on the transcendence of $\lambda$ over $\mathbb Q$, the relation $j\,\lambda(1-16\lambda)^{4} = (1+224\lambda+256\lambda^{2})^{3}$, and the family of level-one modular polynomials.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_exists_pow_mul_minpoly_lambdaNModC_coeff_mem_adjoin.lean

import Mathlib
import Definitions.Def_ModularCurve_LambdaSeries

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option synthInstance.maxHeartbeats 400000
set_option autoImplicit false

open ModularCurve

theorem ModularCurve.exists_pow_mul_minpoly_lambdaNModC_coeff_mem_adjoin (q : ℕ) [Fact q.Prime] (k : ℕ) :
    ∃ N : ℕ, (lambdaModC ℚ * (1 - 16 * lambdaModC ℚ) ^ 4) ^ N *
        ((minpoly (↥(IntermediateField.adjoin ℚ ({lambdaModC ℚ} : Set (LaurentSeries ℚ)))) (lambdaNModC ℚ q)).coeff k
          : LaurentSeries ℚ) ∈ Algebra.adjoin ℚ ({lambdaModC ℚ} : Set (LaurentSeries ℚ)) := by sorry
