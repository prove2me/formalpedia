section R05Seg1
/-! # Equal-spin D = 5 ansatz: notation layer and generic identities (ATLAS-VI-02/02)

B3 class-B layer (`mission/PHYSICS_BOUNDARY.md` §VI-02). Coordinates `x = (t, r, u, φ, ψ) =
(x 0, …, x 4)`, total dimension 5, on `esDomain R = {x | x 1 ∈ R ∧ 0 < x 2 ∧ x 2 < 1}` for a set
of radii `R`. With `σ = u dφ + (1-u) dψ`, `χ = dφ - dψ`, `h = du²/(4u(1-u)) + u(1-u) χ²`:

* `esMetric B D A H W = -B dt² + D dr² + A h + H (σ - W dt)²` (components written out);
* `esInverse` = `Σ_A η_A⁻¹ E_A ⊗ E_A`, frame `E_A` dual to `(dt, dr, du, σ - W dt, χ)`,
  `η = (-B, D, A/(4u(1-u)), H, A u(1-u))`;
* `esPotential Φ Ψ = Φ dt + Ψ σ`, and `esFaraday Φ Ψ = extD (esPotential Φ Ψ)` (`F = d𝒜`).

Nothing here is a manifold statement; the geometric objects are the registered class-A
`christoffel`/`ricciOf` and the D-generic Einstein–Maxwell layer, unchanged. Proved here, for
arbitrary radial functions: symmetry, `g⁻¹ g = 1` where `B, D, A, H ≠ 0`, Lorentz signature
`(-,+,+,+,+)` where `A > 0`, `H > 0`, `B D > 0`, and `C^∞` transfer from the radial functions. -/

set_option maxHeartbeats 8000000

open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5

@[simp] theorem liftRU_apply (F : ℝ → ℝ → ℝ) (x : Pt 5) : liftRU F x = F (x 1) (x 2) := rfl

theorem isOpen_esDomain {R : Set ℝ} (hR : IsOpen R) : IsOpen (esDomain R) :=
  (hR.preimage (continuous_apply 1)).inter
    ((isOpen_lt continuous_const (continuous_apply 2)).inter
      (isOpen_lt (continuous_apply 2) continuous_const))

variable (B D A H W : ℝ → ℝ)

theorem esMetric_symm (x : Pt 5) (i j : Fin 5) :
    esMetric B D A H W i j x = esMetric B D A H W j i x := by
  fin_cases i <;> fin_cases j <;> rfl

theorem esFaraday_antisymm (Φ Ψ : ℝ → ℝ) (x : Pt 5) (i j : Fin 5) :
    esFaraday Φ Ψ i j x = -esFaraday Φ Ψ j i x := by
  simp only [esFaraday, extD]; ring

/-! ## Smoothness transfer from the radial functions -/

theorem cd_radial {R : Set ℝ} {f : ℝ → ℝ} (hf : ContDiffOn ℝ ∞ f R) :
    ContDiffOn ℝ ∞ (fun x : Pt 5 => f (x 1)) (esDomain R) :=
  hf.comp (contDiff_apply ℝ ℝ (1 : Fin 5)).contDiffOn fun _ hx => hx.1

theorem cd_u (R : Set ℝ) : ContDiffOn ℝ ∞ (fun x : Pt 5 => x 2) (esDomain R) :=
  (contDiff_apply ℝ ℝ (2 : Fin 5)).contDiffOn

theorem cd_v (R : Set ℝ) : ContDiffOn ℝ ∞ (fun x : Pt 5 => 1 - x 2) (esDomain R) :=
  contDiffOn_const.sub (cd_u R)

theorem esPotential_smooth {R : Set ℝ} {Φ Ψ : ℝ → ℝ} (hΦ : ContDiffOn ℝ ∞ Φ R)
    (hΨ : ContDiffOn ℝ ∞ Ψ R) (i : Fin 5) :
    ContDiffOn ℝ ∞ (esPotential Φ Ψ i) (esDomain R) := by
  have p := cd_radial hΦ; have q := cd_radial hΨ; have u := cd_u R; have v := cd_v R
  fin_cases i
  all_goals first | exact contDiffOn_const | exact p | exact q.mul u | exact q.mul v

theorem esFaraday_smooth {R : Set ℝ} (hR : IsOpen R) {Φ Ψ : ℝ → ℝ}
    (hΦ : ContDiffOn ℝ ∞ Φ R) (hΨ : ContDiffOn ℝ ∞ Ψ R) (i j : Fin 5) :
    ContDiffOn ℝ ∞ (esFaraday Φ Ψ i j) (esDomain R) :=
  (contDiffOn_pd (isOpen_esDomain hR) (esPotential_smooth hΦ hΨ j) i).sub
    (contDiffOn_pd (isOpen_esDomain hR) (esPotential_smooth hΦ hΨ i) j)

end ExactVacuumAtlas.EinsteinMaxwell.ES5
end R05Seg1

