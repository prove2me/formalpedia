-- Source module: Solutions.J6LineTop2
/-!
# `LineNeed6` top level, part 2: registers, size bounds and the sweep cost

* `sgm dS dA`: nineteen registers in `1..22`, avoiding `0`, `dS`, `dA` (`sgm_ok : SwOK`).
* `swB_of`: with `QOk ⟨P, n, src⟩` the bound `B = 8 b' + 8` meets `SwB`.
* `sweep_cost_le`: the sweep overhead `10^9 (B+2)^2 (2D+3) + 2 ≤ 10^12 · cU6 P n A`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-! ## The registers -/

/-- Skip the value `a`. -/
def skp (a y : ℕ) : ℕ := if y < a then y else y + 1

/-- The register values. -/
def sgV (a b x : ℕ) : ℕ := skp (max a b) (skp (min a b) (x + 1))

theorem sgV_lt (a b x : ℕ) : sgV a b x ≤ x + 3 := by
  unfold sgV skp; split_ifs <;> omega

/-- The nineteen sweep registers. -/
def sgm (dS dA : Fin HS) (i : Fin 19) : Fin HS :=
  ⟨sgV dS.val dA.val i.val, by
    have := sgV_lt dS.val dA.val i.val; have := i.isLt; show sgV dS.val dA.val i.val < 64; omega⟩

/-! ## The size bound -/

/-- The bound of the sweep. -/
def bSw (P : Prm) (n : ℕ) : ℕ := 8 * b'P6 P n + 8

/-! ## The cost -/

end J6Seg

end

