/-! ## 2. Depth recurrence and the chain -/

/-! ## 3. Dyadic depth invariant -/

lemma DyGood.mono {p ℓ ℓ' : ℕ} {z : ℂ} (h : DyGood p ℓ z) (hl : ℓ ≤ ℓ') : DyGood p ℓ' z := by
  obtain ⟨⟨a, b, rfl⟩, hn⟩ := h
  refine ⟨⟨a * 2 ^ (ℓ' - ℓ), b * 2 ^ (ℓ' - ℓ), ?_⟩, hn.trans (pow_le_pow_right₀ (by norm_num) hl)⟩
  have : (2 : ℂ) ^ (p + ℓ') = 2 ^ (p + ℓ) * 2 ^ (ℓ' - ℓ) := by
    rw [← pow_add]; congr 1; omega
  rw [this]; push_cast
  field_simp

lemma DyGood.add {p ℓ ℓ' : ℕ} {z w : ℂ} (hz : DyGood p ℓ z) (hw : DyGood p ℓ' w) :
    DyGood p (max ℓ ℓ' + 1) (z + w) := by
  obtain ⟨⟨a, b, ha⟩, hz'⟩ := hz.mono (le_max_left ℓ ℓ')
  obtain ⟨⟨c, e, hc⟩, hw'⟩ := hw.mono (le_max_right ℓ ℓ')
  refine ⟨⟨(a + c) * 2, (b + e) * 2, ?_⟩, ?_⟩
  · rw [ha, hc, ← add_assoc p, pow_succ]; push_cast; field_simp; ring
  · calc ‖z + w‖ ≤ ‖z‖ + ‖w‖ := norm_add_le _ _
      _ ≤ 2 ^ max ℓ ℓ' + 2 ^ max ℓ ℓ' := add_le_add hz' hw'
      _ = 2 ^ (max ℓ ℓ' + 1) := by ring

