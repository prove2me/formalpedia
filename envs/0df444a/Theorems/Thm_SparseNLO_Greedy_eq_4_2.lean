-- title:
--   §4.2.1, proof of Theorem 3.3, (4.2) — if ‖x*‖₀ < s then f(x*) ≤ min_t f(x* + teᵢ) for every i ∈ I₁(x*)
-- statement:
--   Let $f:\mathbb R^n\to\mathbb R$ be continuously differentiable and bounded below (Assumption 1), let $0<s<n$ be an integer, and let $(x^k)$ be a sequence generated by the greedy sparse-simplex method for (P). Let $x^*$ be an accumulation point of $(x^k)$ with $\|x^*\|_0<s$, and let $i\in I_1(x^*)$. Then
--   $$f(x^*)\le f(x^*+te_i)\qquad\text{for all } t\in\mathbb R,$$
--   that is, $f(x^*)\le\min_{t\in\mathbb R}f(x^*+te_i)$ (4.2).
--
--   This is the support half of the case $\|x^*\|_0<s$ in the proof of Theorem 3.3; the same argument also yields Lemma 3.3 for the partial sparse-simplex method.
--
--   **Formalization Note** "Accumulation point" is `MapClusterPt xstar atTop x`. Indices are $0,\dots,n-1$ and $te_i$ is `EuclideanSpace.single i t`. The minimum in (4.2) is attained (at $t=0$, by the inequality itself), so "$\le$ the minimum" is written as "$\le$ every value". Assumption 1 is the paper's standing assumption.
-- source:
--   Beck, Eldar, Sparsity Constrained Nonlinear Optimization: Optimality Conditions and Algorithms, SIAM J. Optim. (2013), doi:10.1137/120869778 (source: arXiv:1203.4580v1), p. 29, §4.2.1, proof of Theorem 3.3, (4.2)

import Definitions.Def_SparseNLO_Greedy_Method

open Filter Topology

namespace SparseNLO.Greedy

/-- §4.2.1, proof of Theorem 3.3, (4.2) (p. 29): if `x*` is an accumulation point of a run of
the greedy sparse-simplex method with `‖x*‖₀ < s`, then for every `i ∈ I₁(x*)`,
`f(x*) ≤ f(x* + t eᵢ)` for all `t ∈ ℝ`, i.e. `f(x*) ≤ min_t f(x* + t eᵢ)`. -/
theorem eq_4_2
    {n s : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f)
    (hbdd : ∃ γ : ℝ, ∀ x, γ ≤ f x) (hs : 0 < s) (hsn : s < n)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hrun : IsGreedyRun f s x)
    (xstar : EuclideanSpace ℝ (Fin n)) (hacc : MapClusterPt xstar atTop x)
    (hstar : SparseNLO.CWOpt.l0 xstar < s) (i : Fin n) (hi : i ∈ SparseNLO.CWOpt.I1 xstar) :
    ∀ t : ℝ, f xstar ≤ f (xstar + EuclideanSpace.single i t) := by sorry

end SparseNLO.Greedy
