    (hBD : 0 < B (x 1) * D (x 1)) (hu : 0 < x 2) (hv : x 2 < 1) :
    IsLorentzian (metricMatrix (esMetric B D A H W) x) := by
  have hu' : x 2 ≠ 0 := hu.ne'
  have hv0 : 0 < 1 - x 2 := by linarith
  have hv' : 1 - x 2 ≠ 0 := hv0.ne'
  have huv : 0 < x 2 * (1 - x 2) := mul_pos hu hv0
  have h22 : 0 < A (x 1) / (4 * x 2 * (1 - x 2)) := by positivity
  have h44 : 0 < A (x 1) * x 2 * (1 - x 2) := by positivity
  rcases lt_or_gt_of_ne (show B (x 1) ≠ 0 by rintro h; simp [h] at hBD) with hB | hB
  · have hD : D (x 1) < 0 := by nlinarith
    refine isLorentzian_of_diag _ _ (esFrameSwap_spec B D A H W x hu' hv') (by simpa using hD) ?_
    intro i hi
    fin_cases i
    · exact absurd rfl hi
    all_goals simp <;> first | linarith | positivity
