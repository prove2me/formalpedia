theorem coe_mem_of_mem_chartAlg {K' : Type*} {E : Type u} [Field K'] [Field E] [Algebra K' E]
    (S : IntermediateField K' E) {R : Type u} [CommRing R] [Algebra R ↥S] (O : ValuationSubring E)
