  have hU : IsClopen (U : Set ↥(E'.L.schemeKer N)) := ⟨hUc, U.isOpen⟩
  have hV : IsClopen (V : Set ↥(E'.L.schemeKer N)) := ⟨hVc, V.isOpen⟩
  refine IsClopen.inter (IsClopen.inter (IsClopen.inter (IsClopen.inter (IsClopen.inter (IsClopen.inter ?_ ?_) ?_) ?_) ?_) ?_) ?_
  · exact Loci.isClopen_locOne _ N _ hU
  · exact Loci.isClopen_locInv _ E'.comm N _ hU
  · exact Loci.isClopen_locMul _ E'.comm N _ hU
  · exact Set.Finite.isClopen_biInter (Finset.finite_toSet s)
      (fun x _ => Loci.isClopen_locEnd _ N _ _ (isHomPt_act _ x) _ hU)
  · exact isClopen_rankLoc _ _ hUc _
  · exact Set.Finite.isClopen_biInter (Finset.finite_toSet _)
      (fun d _ => isClopen_rankLoc _ (U ⊓ Td E'.L E'.comm N d)
        (by rw [TopologicalSpace.Opens.coe_inf]; exact hUc.inter (Td_closed _ E'.comm N d)) _)
  · exact isClopen_locDisj _ N _ _ hU hV

theorem hMC : IsUnit ((N * N₀ : ℕ) : C D.ζ₀) := isUnit_mapM (S := S) (N := N) (N₀ := N₀) (algebraMap S (C D.ζ₀))

abbrev admSet (s : Finset ↥Λ) : Set ↥(Spec (CommRingCat.of (C D.ζ₀))) :=
  admOf (N := N) (EC E D.ζ₀) s (𝒰 D) (VC (N := N) (EC E D.ζ₀) (hMC (N₀ := N₀) D))

theorem isClopen_admSet (s : Finset ↥Λ) : IsClopen (admSet D s) :=
  isClopen_admOf _ s _ _ (𝒰_closed D) (VC_closed (N := N) _ _)

def Zsub (s : Finset ↥Λ) : (Spec (CommRingCat.of (C D.ζ₀))).Opens := ⟨admSet D s, (isClopen_admSet D s).2⟩

theorem Zsub_closed (s : Finset ↥Λ) : IsClosed (Zsub D s : Set ↥(Spec (CommRingCat.of (C D.ζ₀)))) :=
