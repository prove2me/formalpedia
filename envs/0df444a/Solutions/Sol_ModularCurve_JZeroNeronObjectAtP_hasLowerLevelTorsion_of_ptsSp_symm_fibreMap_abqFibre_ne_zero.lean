theorem Tbar_ptsSp_symm (φ' : SchemeHomOver Λ.f Λ.f) (w : SchemeHomOver (resPt A ≫ Λ.σA) Λ.f) :
    Tbar Λ φ' (Λ.ptsSp.symm w) = Λ.ptsSp.symm (NeronModelInfra.schemeHomOverComp w φ') := by
  unfold Tbar
  rw [Equiv.apply_symm_apply]

