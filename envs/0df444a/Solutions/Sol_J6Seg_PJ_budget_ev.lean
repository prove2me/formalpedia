/-!
# Round six: the parameter map `n ↦ (b, b', p, L, T, d, ℓ, r, K, α², V)` and the cost `Ncost6`

Stack parameters (Colkitt/Jain, `stack-notes.tex` §1 Idea D, Idea C):

* `b = lg n` (`bP6`), `b' = b^(1+x)` (`b'P6`; `x : ℕ` so `⌈b^(1+x)⌉ = b^(1+x)`), `p = 6 b'` (`pP6`);
* `L` (`LP6`) = least `L` with `4n ≤ 2^L b'`, `T = 2^L` (`TP6`), so `4n ≤ T b' < 8n`;
* `d = ⌊b^ε⌋` (`dP6`), `ℓ = ⌈L/d⌉ = (L + d - 1)/d` (`ℓP6`), `r = 2^ℓ` (`rP6`),
  `K = ℓ - 1` (`KP6`, one chunk per axis);
* `α² = ⌊p/(48d)⌋ = ⌊b'/(8d)⌋` (`α2P6`, a natural number), `α = √(α²)` (`αP6`),
  `γ = 2 d α²` (`γP6`);
* bit volume `V = T p` (`VP6`), with `24 n ≤ V ≤ 48 n`.

## Normalization (same as OpenAI's `RCost.Ncost`)
`Ncost6` is the **per-bit** cost: the Table-1 cost divided by `V = T p`.  The machine time is
`C₀ (V · Ncost6 · polylog + n)`; since `V ≤ 48 n`, a bound `Ncost6 ≤ C b^(1-gap) polylog`
gives time `O(n lg^(1-gap) polylog)`.

`Ncost6 P n = d + ℓ d^λ' + d p^δ + (ℓ + log₂ p) + p^δ + ℓ (d ln p)^τ + 1`
(rows: prefix moves `1-ε`; butterflies `ε(1-λ')`; fine exposures/Gaussian/chirps/reserved axes
`1-ε-poly`; pointwise products `ε`; precision `p^δ = b^poly`; CRT reversal
`ε(1-τ) = max(ε,1-ε)(1-τ)` as `ε ≥ 1/2`).  Note `ℓ ≈ b^(1-ε)` and `p^δ ≤ 6 b^poly`.
-/

open Real

namespace IntMul.Kappa.R6

noncomputable section

/-! ## 1. The parameter map -/

/-! ## 2. Elementary facts about `lg` -/

lemma lg_ge (B : ℕ) {n : ℕ} (hn : 2 ^ B ≤ n) : B ≤ bP6 n := by
  have h := Nat.clog_mono_right 2 hn
  rw [Nat.clog_pow 2 B (by norm_num)] at h
  exact h.trans (le_max_left _ _)

/-- Eventually `B ≤ lg n`. -/
lemma eventually_b_ge (B : ℕ) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → B ≤ bP6 n :=
  ⟨2 ^ B, fun _ hn => lg_ge B hn⟩

lemma two_pow_b_lt {n : ℕ} (hn : 2 ≤ n) : 2 ^ (bP6 n - 1) < n := by
  have hc : 1 ≤ Nat.clog 2 n := by
    have := Nat.clog_mono_right 2 (show 2 ^ 1 ≤ n by simpa using hn)
    rwa [Nat.clog_pow 2 1 (by norm_num)] at this
  have hb : bP6 n = Nat.clog 2 n := max_eq_left hc
  rw [hb]
  have := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) (show 1 < n by omega)
  simpa [Nat.pred_eq_sub_one] using this

/-- `b^k` is eventually below `2^(b/2)/8`. -/
lemma poly_le_two_pow_half (k : ℕ) : ∃ B₀ : ℕ, ∀ b : ℕ, B₀ ≤ b → 8 * b ^ k ≤ 2 ^ (b / 2) := by
  have ht := tendsto_pow_const_div_const_pow_of_one_lt k (r := (2 : ℝ)) (by norm_num)
  have hpos : (0 : ℝ) < 1 / (8 * 3 ^ k) := by positivity
  obtain ⟨M, hM⟩ := Filter.eventually_atTop.1 (ht.eventually (gt_mem_nhds hpos))
  refine ⟨2 * (M + 1), fun b hb => ?_⟩
  set m := b / 2 with hm
  have hmM : M ≤ m := by omega
  have hm1 : 1 ≤ m := by omega
  have hb3 : b ≤ 3 * m := by omega
  have h := hM m hmM
  have h2 : (0 : ℝ) < 2 ^ m := by positivity
  rw [div_lt_iff₀ h2] at h
  have hreal : (8 : ℝ) * (b : ℝ) ^ k ≤ 2 ^ m := by
    have hb3r : (b : ℝ) ≤ 3 * m := by exact_mod_cast hb3
    have : (b : ℝ) ^ k ≤ (3 * (m : ℝ)) ^ k := pow_le_pow_left₀ (Nat.cast_nonneg _) hb3r k
    rw [mul_pow] at this
    have h3 : (0 : ℝ) < 3 ^ k := by positivity
    have : (m : ℝ) ^ k * (8 * 3 ^ k) ≤ 2 ^ m := by
      have := mul_lt_mul_of_pos_right h (by positivity : (0 : ℝ) < 8 * 3 ^ k)
      rw [show 1 / (8 * 3 ^ k) * (2 : ℝ) ^ m * (8 * 3 ^ k) = 2 ^ m by field_simp] at this
      linarith
    nlinarith
  exact_mod_cast hreal

