open scoped BigOperators ENNReal

theorem solution (k : Type) [Field k] (n : ℕ) (G : Polynomial k) (hG : G.Monic)
    (hn : G.natDegree = n) :
    ∃! D : TypeDensity.ExceptionalDivisor k, TypeDensity.AffineDivisor k n D ∧ TypeDensity.divisorAffinePolynomial k D = G := by
  classical
  set N := UniqueFactorizationMonoid.normalizedFactors G with hN
  have hG0 : G ≠ 0 := hG.ne_zero
  have hNmi : ∀ p ∈ N, p.Monic ∧ Irreducible p := fun p hp =>
    ⟨by rw [← UniqueFactorizationMonoid.normalize_normalized_factor p hp]; exact
        Polynomial.monic_normalize (UniqueFactorizationMonoid.ne_zero_of_mem_normalizedFactors hp),
     UniqueFactorizationMonoid.irreducible_of_normalized_factor p hp⟩
  have hNprod : N.prod = G := by
    have := Polynomial.eq_of_monic_of_associated
      (Polynomial.monic_multiset_prod_of_monic N id (fun p hp => (hNmi p hp).1)) hG
    simp only [Multiset.map_id] at this
    apply this
    exact UniqueFactorizationMonoid.prod_normalizedFactors hG0
  have hNg : (N.map TypeDensity.directionOfPoly).map TypeDensity.directionPoly = N := by
    rw [Multiset.map_map]
    conv_rhs => rw [← Multiset.map_id N]
    exact Multiset.map_congr rfl (fun p hp => TypeDensity.directionPoly_directionOfPoly p (hNmi p hp))
  refine ⟨Multiset.toFinsupp (N.map TypeDensity.directionOfPoly), ⟨⟨?_, ?_⟩, ?_⟩, ?_⟩
  · change Multiset.toFinsupp (N.map TypeDensity.directionOfPoly) none = 0
    rw [Multiset.toFinsupp_apply, Multiset.count_eq_zero, Multiset.mem_map]
    rintro ⟨p, hp, hgp⟩
    simp [TypeDensity.directionOfPoly, hNmi p hp] at hgp
  · unfold TypeDensity.exceptionalDegree
    rw [TypeDensity.toFinsupp_sum_directionDegree, Multiset.map_map, ← hn, ← hNprod,
      Polynomial.natDegree_multiset_prod_of_monic _ (fun p hp => (hNmi p hp).1)]
    congr 1
    exact Multiset.map_congr rfl (fun p hp => by simp [TypeDensity.directionOfPoly, hNmi p hp, TypeDensity.directionDegree])
  · rw [TypeDensity.divisorAffinePolynomial_eq_prod, TypeDensity.toFinsupp_prod_directionPoly, hNg, hNprod]
  · rintro D ⟨⟨hinf, hdeg⟩, hprod⟩
    set S := Finsupp.toMultiset D with hS
    have hDS : D = Multiset.toFinsupp S := (Multiset.toFinsupp_eq_iff.2 rfl).symm
    have hnone : none ∉ S := by
      rw [hS, Finsupp.mem_toMultiset]
      simpa [Finsupp.mem_support_iff, TypeDensity.infinityDirection] using hinf
    have hSmi : ∀ p ∈ S.map TypeDensity.directionPoly, p.Monic ∧ Irreducible p := by
      intro p hp
      obtain ⟨a, ha, rfl⟩ := Multiset.mem_map.1 hp
      cases a with
      | none => exact absurd ha hnone
      | some φ => exact φ.2
    have hSprod : (S.map TypeDensity.directionPoly).prod = G := by
      rw [← hprod, TypeDensity.divisorAffinePolynomial_eq_prod, hDS, TypeDensity.toFinsupp_prod_directionPoly]
    have hrel : Multiset.Rel Associated (S.map TypeDensity.directionPoly) N := by
      apply UniqueFactorizationMonoid.factors_unique (fun p hp => (hSmi p hp).2)
        (fun p hp => UniqueFactorizationMonoid.irreducible_of_normalized_factor p hp)
      rw [hSprod, hNprod]
      exact Associated.refl G
    have hEq : S.map TypeDensity.directionPoly = N := by
      rw [← Multiset.rel_eq]
      refine hrel.mono ?_
      intro a ha b hb hab
      exact Polynomial.eq_of_monic_of_associated (hSmi a ha).1 (hNmi b hb).1 hab
    rw [hDS, ← hEq, Multiset.map_map]
    congr 1
    conv_lhs => rw [← Multiset.map_id S]
    refine Multiset.map_congr rfl (fun a ha => ?_)
    cases a with
    | none => exact absurd ha hnone
    | some φ => exact (TypeDensity.directionOfPoly_directionPoly φ).symm
