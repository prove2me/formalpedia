theorem _root_.solution (t : ℝ) : Real.sqrt (Real.exp t) = Real.exp (t / 2) := by
  rw [Real.sqrt_eq_iff_eq_sq (le_of_lt (Real.exp_pos _)) (le_of_lt (Real.exp_pos _))]
  rw [← Real.exp_nat_mul]
  congr 1
  ring
