    ⟨Bnd_mono s hB a h.1, Bnd_mono s hB b h.2.1, le_trans h.2.2 hB⟩
  | quo a b, h | rem a b, h => ⟨Bnd_mono s hB a h.1, Bnd_mono s hB b h.2⟩
  | neg a, h => Bnd_mono s hB a h
  | pow2 a, h => ⟨Bnd_mono s hB a h.1, le_trans h.2 hB⟩
