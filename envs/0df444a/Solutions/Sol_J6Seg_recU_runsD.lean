section
-- Source module: Solutions.KFV8Sim
/-!
# KFV §12: literal-to-register simulation of item-language code

`ISim π c c'`: `c'` is `c` with some literal pushes `.const j v` replaced by copies `.dup i j` of a
parameter stack `i` holding `v` (`π i = some v`). It is the `IStmt`-level analogue of
`KIL.RSim` and covers compiled register programs (`Ex.code` compiles `.lit v` to `.const` and
`.reg i` to `.dup`) as well as hand-written codes such as KFT's `carI`/`digI`.

**`ISim.runs`**: if `c` does not write any parameter stack and makes no calls (`NW π c`), every
run of `c` from a state with the parameters on top (`PV π s`) is matched by a run of `c'` with
the same final state and at most `2000 ×` the cost. This turns old codes whose *shape* does not
depend on `n` into uniform codes reading their sizes from stacks.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KIL

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- **Simulation of runs.** -/
theorem ISim.runs {π : PMap} {c c' : IStmt HS Pp} (hc : ISim I iprog π c c') (hw : NW π c)
    {s t : IState HS} (hs : PV π s) {n : ℕ} (h : IRuns I iprog c s t n) :
    IRuns I iprog c' s t (2000 * n) := by
  obtain ⟨m, hm, e⟩ := h
  obtain ⟨m', hm', e'⟩ := ISim.exec e hc hw hs
  exact ⟨m', by nlinarith, e'⟩

/-! ## Compiled register programs -/

end NLogN.KFV

end

section
-- Source module: Solutions.KFV9Gen
/-!
# KFV §13: generalized literal substitution and the write analysis

* `wl c` (stacks written, calls ignored) and `nc c` (no calls): `NW_of` gives `NW π c` when no
  parameter stack is written. `wl_ecode`: compiled expressions write only the scratch `56…63`;
  `wl_fcode`: compiled register programs write `p.writes`, the scratch, and the `toUL` stacks.
* `EG π e e'`: `e'` is `e` with literals `v` replaced by any clean expression over the parameters
  that evaluates to `v` at cost `≤ 2000 (zsz v + 2)` (e.g. `2r = r + r`, `-K`, `B / 2`).
  `GSim` is the register-program version. **`ISim.fcodeG`**: `GSim π p p'` gives
  `ISim π (fcode p) (fcode p')`. **`ISim.pushE`**: a literal push `const j v` on any stack
  `j ≠ 56` may be replaced by `e.code; mv 56 j`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open IntMul KIL KFD

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Write analysis -/

theorem NW_of {π : PMap} (c : IStmt HS Pp) (hc : nc c = true) (h : ∀ i ∈ wl c, π i = none) :
    NW π c := by
  induction c with
  | skip => trivial
  | op o => exact h
  | seq a b iha ihb =>
    simp only [nc, Bool.and_eq_true] at hc
    exact ⟨iha hc.1 fun i hi => h i (by simp [wl, hi]), ihb hc.2 fun i hi => h i (by simp [wl, hi])⟩
  | ite _ _ a b iha ihb =>
    simp only [nc, Bool.and_eq_true] at hc
    exact ⟨iha hc.1 fun i hi => h i (by simp [wl, hi]), ihb hc.2 fun i hi => h i (by simp [wl, hi])⟩
  | loop _ _ a ih => exact ih hc h
  | call _ => simp [nc] at hc

theorem allHi_ecode (e : Ex HS) : allHi (wl (e.code NLogN.zX : IStmt HS Pp)) = true := by
  induction e <;> simp_all +decide [allHi, wl, Ex.code, pow2Code, ldivCode, ldFlag, ldUp, ldDown, smul, smulBody, opW, NLogN.zX]

theorem gW_of_hi {L : List (Fin HS)} (h : allHi L = true) (W) : L.all (gW W) = true := by
  simp only [allHi, List.all_eq_true, decide_eq_true_eq] at h
  simp only [List.all_eq_true]; intro i hi; simp [gW, h i hi]
theorem gW_mono {L W W' : List (Fin HS)} (h : L.all (gW W) = true) (hW : ∀ i ∈ W, i ∈ W') :
    L.all (gW W') = true := by
  simp only [List.all_eq_true] at h ⊢
  intro i hi; have := h i hi; simp only [gW, Bool.or_eq_true, decide_eq_true_eq] at this ⊢
  rcases this with (h1 | h1) | h1
  · exact Or.inl (Or.inl (hW i h1))
  · exact Or.inl (Or.inr h1)
  · exact Or.inr h1
theorem wl_toUL (j : Fin HS) : (wl (KFC.toUL j j : IStmt HS Pp)).all (gW [j]) = true := by
  simp +decide [wl, KFC.toUL, KFC.splitL, KFC.bld, KFC.dbl, opW, gW]
theorem wl_fcode (p : RS) : (wl (fcode p : IStmt HS Pp)).all (gW p.writes) = true := by
  induction p with
  | skip => rfl
  | asg i e =>
    simp only [fcode, RS.code, wl, List.all_append, gW_of_hi (allHi_ecode e), Bool.true_and]
    simp +decide [opW, gW, RS.writes]
  | push i e =>
    simp only [fcode, RS.code, wl, List.all_append, gW_of_hi (allHi_ecode e), Bool.true_and]
    simp +decide [opW, gW, RS.writes]
  | pop i => simp +decide [fcode, wl, opW, gW, RS.writes]
  | seq a b iha ihb =>
    simp only [fcode, wl, List.all_append, Bool.and_eq_true]
    exact ⟨gW_mono iha (by simp [RS.writes]; tauto), gW_mono ihb (by simp [RS.writes]; tauto)⟩
  | ite c a b iha ihb =>
    refine List.all_eq_true.2 fun x hx => ?_
    simp only [fcode, wl, List.mem_append, or_assoc] at hx
    rcases hx with h | h | h | h | h | h
    · exact List.all_eq_true.1 (gW_of_hi (allHi_ecode c) _) x h
    · revert x; simp +decide [opW, gW]
    · revert x; simp +decide [opW, gW]
    · exact List.all_eq_true.1 (gW_mono iha (by simp [RS.writes]; tauto)) x h
    · revert x; simp +decide [opW, gW]
    · exact List.all_eq_true.1 (gW_mono ihb (by simp [RS.writes]; tauto)) x h
  | rep i n b ih =>
    refine List.all_eq_true.2 fun x hx => ?_
    simp only [fcode, RS.code, wl, List.mem_append, or_assoc] at hx
    rcases hx with h | h | h | h | h | h
    · exact List.all_eq_true.1 (gW_of_hi (allHi_ecode n) _) x h
    · revert x; simp +decide [opW, gW, RS.writes]
    · exact List.all_eq_true.1 (gW_mono (wl_toUL i) (by simp [RS.writes])) x h
    · revert x; simp +decide [opW, gW, RS.writes]
    · exact List.all_eq_true.1 (gW_mono ih (by simp [RS.writes]; tauto)) x h
    · revert x; simp +decide [opW, gW, RS.writes]

theorem nc_ecode : ∀ e : Ex HS, nc (e.code NLogN.zX : IStmt HS Pp) = true := by
  intro e
  induction e <;> simp_all [Ex.code, nc, pow2Code, ldivCode, ldFlag, ldUp, ldDown, smul, smulBody]

theorem nc_toUL (j : Fin HS) : nc (KFC.toUL j j : IStmt HS Pp) = true := by
  simp [nc, KFC.toUL, KFC.splitL, KFC.bld, KFC.dbl]

theorem nc_fcode : ∀ p : RS, nc (fcode p : IStmt HS Pp) = true
  | .skip => rfl
  | .asg i e => by simp [fcode, RS.code, nc, nc_ecode]
  | .push i e => by simp [fcode, RS.code, nc, nc_ecode]
  | .pop i => rfl
  | .seq a b => by simp [fcode, nc, nc_fcode a, nc_fcode b]
  | .ite c a b => by simp [fcode, nc, nc_fcode a, nc_fcode b, nc_ecode]
  | .rep i n b => by simp [fcode, RS.code, nc, nc_fcode b, nc_ecode, nc_toUL]

/-- **`NW` for compiled register programs**: parameters are low, not written, not `toUL` scratch. -/
theorem NW_fcode {π : PMap} {p : RS}
    (h : ∀ i v, π i = some v → i ∉ p.writes ∧ i.val < 56 ∧ ¬ ulS i) :
    NW π (fcode p : IStmt HS Pp) := by
  refine NW_of _ (nc_fcode p) fun i hi => ?_
  rcases hπ : π i with _ | v
  · rfl
  · exfalso
    obtain ⟨h1, h2, h3⟩ := h i v hπ
    have := List.all_eq_true.1 (wl_fcode (Pp := Pp) p) i hi
    simp only [gW, Bool.or_eq_true, decide_eq_true_eq] at this
    rcases this with (h' | h') | h'
    · exact h1 h'
    · omega
    · exact h3 h'

/-! ## Generalized substitution -/

theorem ISim.ecodeG {π : PMap} {e e' : Ex HS} (h : EG π e e') :
    ISim I iprog π (e.code NLogN.zX : IStmt HS Pp) (e'.code NLogN.zX) := by
  induction h with
  | refl e => exact ISim.refl π _
  | lit hok =>
    rename_i v e'
    refine .parC fun s hs => ?_
    obtain ⟨hc, H⟩ := hok
    obtain ⟨h1, h2, h3⟩ := H s hs
    have := Ex.code_runs (I := I) (iprog := iprog) e' s hc h1
    rw [h2] at this
    exact this.mono (by omega)
  | add _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | neg _ ih => exact .seq ih (.op _)
  | mul _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | shl _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | quo _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | rem _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | pow2 _ ih => exact .seq ih (ISim.refl π _)
  | sel _ _ _ ih1 ih2 ih3 =>
    exact .seq ih1 (.seq (.op _) (.ite (.seq (.op _) ih2) (.seq (.op _) ih3)))
  | ndiv _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | nmod _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))

/-- **Compiled register programs** under generalized substitution. -/
theorem ISim.fcodeG {π : PMap} {p p' : RS} (h : GSim π p p') :
    ISim I iprog π (KFD.fcode p : IStmt HS Pp) (KFD.fcode p') := by
  induction h with
  | skip => exact .skip
  | asg i he => exact .seq (ISim.ecodeG he) (ISim.refl π _)
  | push i he => exact .seq (ISim.ecodeG he) (ISim.refl π _)
  | pop i => exact .op _
  | seq _ _ ih1 ih2 => exact .seq ih1 ih2
  | ite hc _ _ ih1 ih2 =>
    exact .seq (ISim.ecodeG hc) (.seq (.op _) (.ite (.seq (.op _) ih1) (.seq (.op _) ih2)))
  | rep i hn _ ih =>
    exact .seq (.seq (ISim.ecodeG hn) (.op _)) (.seq (ISim.refl π _)
      (.seq (.loop (.seq (.op _) ih)) (.op _)))

end NLogN.KFV

end

