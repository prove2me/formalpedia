-- title:
--   Lemma 5.30
-- statement:
--   Let $R$ be a commutative unital ring with units $\lambda,\delta$ and $z\in R$ satisfying $\lambda^{-1}-\lambda=z(\delta-1)$. For the affine algebra specify arbitrary scalars $q_s$ for every positive integer $s$, with no admissibility or cyclotomic condition. Write $W_n$ and $\widehat W_n$ for the ordinary and affine BMW presentations of Definitions 3.1 and 3.6. Lower levels denote their canonical generator images; products of subspaces denote their $R$-linear spans.
--
--   Let $n,k\ge0$ with $2k\le n$ and set $r=n-2k$. Let $W_n^{(r)}$ be the two-sided ideal generated by $e_1e_3\cdots e_{2k-1}$ and let $f_k$ be the recursive element of Definition 5.22, with $f_0=1$. Then
--   $$W_n^{(r)}=W_nf_kW_n.$$
--   If $2k<n$, one also has $W_n^{(r)}=W_nS(f_k)W_n$, where $S$ shifts generator indices by one. Products mean spans of products, so these are ideal equalities. This identifies alternative generators of each rank ideal.
-- source:
--   Affine Birman-Wenzl-Murakami Algebras and Tangles in the Solid Torus, arXiv:math/0411155v2, PDF p. 44, Lemma 5.30

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P55

noncomputable section

open scoped Classical

namespace QAlgorithms.Papers.Independent.Intake100.P55

section Statements

variable {R : Type*} [CommRing R] (P : Ground R) (q : ℕ → R)

/-- Lemma 5.30(1),(2), PDF pp.44--45. W_n^(n-2k) is the two-sided
span generated by the odd contraction word. The index is encoded by n,k,
so no natural subtraction is used to interpret a negative filtration bmwLevel. -/
theorem lemma_5_30 (n k : ℕ) (hn : 2*k ≤ n) :
    sandwichSpan (R := R) (Set.univ : Set (OrdinaryAffineBMW P q false n)) (oddContractions P q n k) =
      sandwichSpan (R := R) (Set.univ : Set (OrdinaryAffineBMW P q false n)) (fElement P q n 0 k) ∧
    (2*k < n →
      sandwichSpan (R := R) (Set.univ : Set (OrdinaryAffineBMW P q false n)) (oddContractions P q n k) =
        sandwichSpan (R := R) (Set.univ : Set (OrdinaryAffineBMW P q false n)) (fElement P q n 1 k)) := by sorry

end Statements

end QAlgorithms.Papers.Independent.Intake100.P55

end
