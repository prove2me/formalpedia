  · have e : Function.update f 0 (gflat zs ++ l) = f := by
      rw [← h0]; exact Function.update_eq_self 0 f
    rw [e]; exact IRuns.skip _

/-- An implementation with the restricted strides implements the operator on the subfamily. -/
theorem sImpl_subOp {κ : Type*} [Fintype κ] [DecidableEq κ] {g : κ → ι} (hg : Function.Injective g)
    {T : Matrix (κ → Fin 2) (κ → Fin 2) ℂ} {code : ℕ → IStmt HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
    (h : SImplI Isym iprog r (st ∘ g) n T code e dw cost) :
