section steps
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {dA : Fin HS}
  {P : Prm} {ap : AxPlan6} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} {Cs Cc : ℝ}

theorem axQ_ge (P : Prm) (n : ℕ) (src : ℕ → ℕ) (k : ℕ) : axp6 P n + 1 ≤ axQ6 P n src k := by
  unfold axQ6 Q6 segPF; omega

theorem axN_pos (h : AxReg P n src D k) : 0 < axnc6 P n k * axl6 P n * axpost6 P n D k :=
  Nat.mul_pos (Nat.mul_pos h.hnc h.hl) h.hp

/-- **Pass 1.** -/
theorem step1 {u d : IStmt HS Pp} (hfree : SlabFree dA) (hReg : AxReg P n src D k)
    (hS : SetupS Isym tbl u d ρS dA (descAx6 P n src D k) (slabV1 P n src D k) Cs)
    (hBud : AxBudgetAt P ap n src D k Cc) :
    PassOK Isym tbl (slSt u d bodySc) dA (descAx6 P n src D k)
      (fun L => L.length = axpre6 P n D k * (axnc6 P n k * axl6 P n * axpost6 P n D k) ∧
        ∀ u ∈ gflat L, zsz u ≤ axp6 P n + 2)
      (arrS6 P n src D k) (2 * Cs + Cc) := by
  obtain ⟨BI, BH, Bk, Lc, Ck, BkJ, Lj, Bx, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, j0, j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, j11, j12, j13, j14, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, d1, d2, d3, d4, d5, d6, d7⟩ := hBud
  have hs : MonoSrc (axnc6 P n k * axl6 P n) (axnc6 P n k * axl6 P n)
      (selSrc (axs6 src k) (axt6 P n k)) := monoSrc_sel hReg.hst (by rw [hReg.hN])
  have hnp : 0 < axnc6 P n k * axl6 P n * axpost6 P n D k := axN_pos hReg
  have H := slabSc_ok (Isym := Isym) (tbl := tbl) (Bu := axp6 P n + 2) (axp6 P n) (axQ6 P n src k)
    hfree hs hnp hS
  refine H.mono ?_
  have hQ := axQ_ge P n src k
  have hc : passC (axpre6 P n D k) (ctlOf (axnc6 P n k * axl6 P n) (axnc6 P n k * axl6 P n)
      (selSrc (axs6 src k) (axt6 P n k)) (fun _ => 2 ^ (axQ6 P n src k - axp6 P n - 1))).length
      (2 * axpost6 P n D k) (axQ6 P n src k - axp6 P n + 1)
      (2 * (axp6 P n + 2) + 2 + (2 * moveCost (axp6 P n + 2) + 19) +
        (300 * (axp6 P n + 2 + 1) + 200 * (axQ6 P n src k - axp6 P n - 1 + 1)) +
        (2 * moveCost (axp6 P n + 2) + 19))
      (axpre6 P n D k * (axnc6 P n k * axl6 P n * (2 * axpost6 P n D k)))
      (axp6 P n + 2 + (axQ6 P n src k - axp6 P n + 1)) ≤
      cSlabSc (axpre6 P n D k) (axnc6 P n k * axl6 P n) (axpost6 P n D k) (axp6 P n + 2)
        (axQ6 P n src k - axp6 P n - 1) := by
    unfold cSlabSc
    rw [show axQ6 P n src k - axp6 P n + 1 = axQ6 P n src k - axp6 P n - 1 + 2 by omega]
    exact passC_mono_L (length_ctlOf_le hs _)
  have hc' : (passC (axpre6 P n D k) (ctlOf (axnc6 P n k * axl6 P n) (axnc6 P n k * axl6 P n)
      (selSrc (axs6 src k) (axt6 P n k)) (fun _ => 2 ^ (axQ6 P n src k - axp6 P n - 1))).length
      (2 * axpost6 P n D k) (axQ6 P n src k - axp6 P n + 1)
      (2 * (axp6 P n + 2) + 2 + (2 * moveCost (axp6 P n + 2) + 19) +
        (300 * (axp6 P n + 2 + 1) + 200 * (axQ6 P n src k - axp6 P n - 1 + 1)) +
        (2 * moveCost (axp6 P n + 2) + 19))
      (axpre6 P n D k * (axnc6 P n k * axl6 P n * (2 * axpost6 P n D k)))
      (axp6 P n + 2 + (axQ6 P n src k - axp6 P n + 1)) : ℝ) ≤ Cc :=
    le_trans (by exact_mod_cast hc) q5
  linarith

/-- **Pass 3** (gather). -/
theorem step3 {u d : IStmt HS Pp} (hfree : SlabFree dA) (hReg : AxReg P n src D k)
    (hS : SetupS Isym tbl u d ρS dA (descAx6 P n src D k) (slabV3 P n src D k) Cs)
    (hBud : AxBudgetAt P ap n src D k Cc) :
    PassOK Isym tbl (slSt u d bodyId) dA (descAx6 P n src D k)
      (fun L => L.length = axpre6 P n D k * (axnc6 P n k * axl6 P n * axpost6 P n D k) ∧
        ∀ u ∈ gflat L, zsz u ≤ axwd6 P n src k ap)
      (gJ6 P n src D k) (2 * Cs + Cc) := by
  obtain ⟨BI, BH, Bk, Lc, Ck, BkJ, Lj, Bx, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, j0, j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, j11, j12, j13, j14, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, d1, d2, d3, d4, d5, d6, d7⟩ := hBud
  have hs : MonoSrc (axnc6 P n k * axl6 P n) (axG6 P n src k)
      (jSrc (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)) :=
    monoSrc_j (by rw [hReg.hN]; exact hReg.hst)
  have H := slabId_ok (Isym := Isym) (tbl := tbl) (Bu := axwd6 P n src k ap) hfree hs (axN_pos hReg) hS
  refine H.mono ?_
  have hc := passC_mono_L (pre := axpre6 P n D k) (m := 2 * axpost6 P n D k) (Ba := 1)
    (cu := 2 * axwd6 P n src k ap + 2 + (2 * moveCost (axwd6 P n src k ap) + 19) +
      300 * (axwd6 P n src k ap + 1) + (2 * moveCost (axwd6 P n src k ap) + 19))
    (T := axpre6 P n D k * (axG6 P n src k * (2 * axpost6 P n D k))) (Bo := axwd6 P n src k ap)
    (length_ctlOf_le hs (fun _ => 0))
  have hc2 : _ ≤ cSlabId (axpre6 P n D k) (axnc6 P n k * axl6 P n) (axG6 P n src k)
    (axpost6 P n D k) (axwd6 P n src k ap) := hc
  have hc' := ((Nat.cast_le (α := ℝ)).2 hc2).trans q6
  linarith

/-- **Pass 5** (scatter). -/
theorem step5 {u d : IStmt HS Pp} (hfree : SlabFree dA) (hReg : AxReg P n src D k)
    (hS : SetupS Isym tbl u d ρS dA (descAx6 P n src D k) (slabV5 P n src D k) Cs)
    (hBud : AxBudgetAt P ap n src D k Cc) :
    PassOK Isym tbl (slSt u d bodyId) dA (descAx6 P n src D k)
      (fun L => L.length = axpre6 P n D k * (axG6 P n src k * axpost6 P n D k) ∧
        ∀ u ∈ gflat L, zsz u ≤ axwd6 P n src k ap)
      (gWp6 P n src D k) (2 * Cs + Cc) := by
  obtain ⟨BI, BH, Bk, Lc, Ck, BkJ, Lj, Bx, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, j0, j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, j11, j12, j13, j14, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, d1, d2, d3, d4, d5, d6, d7⟩ := hBud
  have hs : MonoSrc (axG6 P n src k) (axnc6 P n k * axl6 P n)
      (scSrc (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)) := monoSrc_sc (axG_ge P n src k)
  have H := slabId_ok (Isym := Isym) (tbl := tbl) (Bu := axwd6 P n src k ap) hfree hs
    (Nat.mul_pos (axG_pos P n src k) hReg.hp) hS
  refine H.mono ?_
  have hc := passC_mono_L (pre := axpre6 P n D k) (m := 2 * axpost6 P n D k) (Ba := 1)
    (cu := 2 * axwd6 P n src k ap + 2 + (2 * moveCost (axwd6 P n src k ap) + 19) +
      300 * (axwd6 P n src k ap + 1) + (2 * moveCost (axwd6 P n src k ap) + 19))
    (T := axpre6 P n D k * (axnc6 P n k * axl6 P n * (2 * axpost6 P n D k)))
    (Bo := axwd6 P n src k ap) (length_ctlOf_le hs (fun _ => 0))
  have hc2 : _ ≤ cSlabId (axpre6 P n D k) (axG6 P n src k) (axnc6 P n k * axl6 P n)
    (axpost6 P n D k) (axwd6 P n src k ap) := hc
  have hc' := ((Nat.cast_le (α := ℝ)).2 hc2).trans q7
  linarith

/-- **Pass 7** (output). -/
theorem step7 {u d : IStmt HS Pp} {pM : Fin Pp} (hMul : MulOK Isym tbl pM NLogN.KFUU.MS)
    (hfree : SlabFree dA) (hReg : AxReg P n src D k)
    (hS : SetupS Isym tbl u d ρS dA (descAx6 P n src D k) (slabV7 P n src D k) Cs)
    (hBud : AxBudgetAt P ap n src D k Cc) :
    Pass2OK Isym tbl (slSt u d (passP drP rdP (itO pM) bkP)) dA (descAx6 P n src D k)
      (fun Y Y₂ => Y.length = axpre6 P n D k * (axnc6 P n k * axl6 P n * axpost6 P n D k) ∧
        Y₂.length = axpre6 P n D k * (axnc6 P n k * axl6 P n * axpost6 P n D k) ∧
        (∀ u ∈ gflat Y, zsz u ≤ axwd6 P n src k ap) ∧ ∀ u ∈ gflat Y₂, zsz u ≤ axwd6 P n src k ap)
      (fun A B => (gO6 P n src D k A B, [])) (2 * Cs + Cc) := by
  obtain ⟨BI, BH, Bk, Lc, Ck, BkJ, Lj, Bx, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, j0, j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, j11, j12, j13, j14, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, d1, d2, d3, d4, d5, d6, d7⟩ := hBud
  have H := slabOut_ok (Isym := Isym) (tbl := tbl) hMul (Bu := axwd6 P n src k ap)
    (Ba := 2 * axp6 P n + 6) (axp6 P n) (axQ6 P n src k) (axs6 src k) (axt6 P n k) (axα6 P n)
    hfree (axN_pos hReg) (by omega) (fun l => zsz_argO_le _ _ _ _ l) hS
  refine H.mono ?_
  have hc := passC_mono_L (pre := axpre6 P n D k) (m := 2 * axpost6 P n D k)
    (Ba := 2 * axp6 P n + 6)
    (cu := 2 * (2 * axwd6 P n src k ap + 2) + 2 * (2 * moveCost (axwd6 P n src k ap) + 19) +
      cItO (axwd6 P n src k ap + (2 * axp6 P n + 6) + 2) (axQ6 P n src k - axp6 P n) (axp6 P n) +
      2 * (2 * moveCost (axwd6 P n src k ap) + 19))
    (T := axpre6 P n D k * (axnc6 P n k * axl6 P n * (2 * axpost6 P n D k)))
    (Bo := axwd6 P n src k ap + (2 * axp6 P n + 6) + 1)
    (length_ctlOf_le (monoSrc_some (axnc6 P n k * axl6 P n))
      (argO (axp6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)))
  have hc2 : _ ≤ cSlabOut (axpre6 P n D k) (axnc6 P n k * axl6 P n) (axpost6 P n D k)
    (axwd6 P n src k ap) (2 * axp6 P n + 6) (axQ6 P n src k - axp6 P n) (axp6 P n) := hc
  have hc' := ((Nat.cast_le (α := ℝ)).2 hc2).trans q8
  linarith

/-- The descriptor bounds of the copy / swap from the budget. -/
theorem descB_of (hBud : AxBudgetAt P ap n src D k Cc) :
    ∃ B, AxC.DescB P n src D k B ∧ axwd6 P n src k ap ≤ B ∧
      (cCopy (2 * (List.ofFn (tD6 P n D)).prod) B : ℝ) ≤ Cc ∧
      (cSwap (2 * (List.ofFn (tD6 P n D)).prod) B : ℝ) ≤ Cc := by
  obtain ⟨BI, BH, Bk, Lc, Ck, BkJ, Lj, Bx, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, j0, j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, j11, j12, j13, j14, q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, d1, d2, d3, d4, d5, d6, d7⟩ := hBud
  have hall : ∀ x ∈ List.ofFn (tD6 P n D), 0 < x := by
    intro x hx
    rw [List.mem_ofFn] at hx
    obtain ⟨i, rfl⟩ := hx
    unfold tD6 tF6; split_ifs <;> positivity
  have ht : 0 < tF6 P n k := by unfold tF6; split_ifs <;> positivity
  have hpo : 0 < postT P n D k := List.prod_pos (fun x hx => hall x (List.mem_of_mem_drop hx))
  have hpr : 0 < preT P n D k := List.prod_pos (fun x hx => hall x (List.mem_of_mem_take hx))
  have htp : 1 ≤ tF6 P n k * postT P n D k := Nat.mul_pos ht hpo
  have bpost : zsz ((postT P n D k : ℕ) : ℤ) ≤ axBcp6 P ap n src D k := le_trans (zsz_mono (by
    rw [Int.natAbs_mul]; simp only [Int.natAbs_natCast, axt6, axpost6, axpre6]; nlinarith)) d5
  have bpre : zsz ((preT P n D k : ℕ) : ℤ) ≤ axBcp6 P ap n src D k := le_trans (zsz_mono (by
    rw [Int.natAbs_mul, Int.natAbs_mul]; simp only [Int.natAbs_natCast, axt6, axpost6, axpre6]; nlinarith)) d6
  have hwd : axwd6 P n src k ap ≤ axBcp6 P ap n src D k := by unfold axBcp6; omega
  exact ⟨axBcp6 P ap n src D k, ⟨d1, d2, bpre, bpost, d3, d4, d5, d6, d7⟩, hwd, q9, q10⟩

end steps

end J6Seg.Ax

