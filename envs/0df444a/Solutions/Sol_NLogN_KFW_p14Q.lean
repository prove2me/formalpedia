    · simp [hBd, hf0, hj]
  have hAg : NLogN.KFW.Agree (NLogN.KFW.σD P K D S ρ r w) (NLogN.KIL.encK st B) := by
    apply NLogN.KFW.agree_σD
    intro q hq
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp [hBd, hF1, NLogN.KFW.fIn, Function.update_apply, hreg]
  have hC0 : NLogN.KFW.Clean0 f0 := fun j hj => by simp [hf0, hj]
  have h00 : f0 0 = NLogN.KFB.gflat zs ++ l := by simp [hf0, h0]
  have CH := NLogN.KFW.chainQ jG jE jT jL jW rowC hG hEc hT hW hL hk hq hBp hH LV hρ hK hS hP hr hD hZ32
    hVt hVl hMb hM hEZ (NLogN.KFW.descR_σD P K D S ρ r w) f0 zs l xs p hC0 h00 hx hl hb hdisk hex
  have R2 := CH (NLogN.KIL.encK st B) hAg
  have hjoin : NLogN.KIL.encK (NLogN.KIL.encK st B) (Function.update f0 0 X) = NLogN.KIL.encK st (Function.update F1 0 X) := by
    rw [NLogN.KFW.encK_encK']
    congr 1
    funext j
    by_cases hj : j = 0
    · subst hj; simp [hBd]
    · simp [hBd, hf0, hj]
  rw [← hsplit, hjoin] at R2
  have R3 := NLogN.KFW.dOut_run (Isym := Isym) (tbl := tbl) (Pp := Pp) st f P K D S ρ r p w [(Z : ℤ)] X
    h36 hreg hB
  exact R1.seq (R2.seq R3)
end
