theorem four_affine_form_implies_affine (m : ℕ) (S T : Finset (ZMod (2*m)))
    (h : FourAffineForm m S T) : AffineEquivalent S T := by
  obtain ⟨q,hq,hN,u,v,c,d,hc,hd,hS,hT⟩ := h
  have he : AffineEquivalent (S.image (fun z => (u : ZMod (2*m))*z+v))
      (T.image (fun z => (u : ZMod (2*m))*z+v)) := by
    rw [hS,hT]
    exact reflection_affine (2*m) q hN c d hc hd
  exact (common_affine_equivalent_iff S T u v).mp he



/-- The unilateral half-turn is removed by the received affine transport theorem. -/
theorem p2m_local_nonaffine_collision_two_form (m : ℕ) (hm : 0 < m)
    (S T : Finset (ZMod (2*m))) (hS : S.card=4) (hT : T.card=4)
    (hsq : ∀ z, orderedSquare S z=orderedSquare T z)
    (hnaff : ¬ AffineEquivalent S T) :
    ∃ t : ZMod (2*m), (t=0 ∨ t=m) ∧ TwoControlledForm m S (T.image (fun x => x+t)) := by
  obtain ⟨t,ht,ho⟩ := collision_controlled_affine_forms m hm S T hS hT hsq hnaff
  rcases ho with htwo|hfour
  · exact ⟨t,ht,htwo⟩
  · have ha := four_affine_form_implies_affine m S (T.image (fun x => x+t)) hfour
    exact False.elim (hnaff ((unilateral_translation_equivalent_iff S T t).mp ha))

end Couret.InterIA.Catalogue.Eighth

