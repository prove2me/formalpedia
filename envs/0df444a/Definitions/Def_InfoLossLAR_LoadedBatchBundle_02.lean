  let index := _root_.Integration9_9.LARPlatformEncoding.readB word
  let guess := _root_.Integration9_9.LARPlatformEncoding.readB index.1
  ((index.2,guess.2),(_root_.Integration9_9.LARPlatformEncoding.readObservedInput guess.1).2)
