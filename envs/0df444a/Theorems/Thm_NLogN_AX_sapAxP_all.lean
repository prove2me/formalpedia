theorem NLogN.AX.sapAxP_all (M : MulSpec) (p s t α m kb Bi Bo mm Φ Bacc Q Bq : ℕ) (rest : List ℕ)
    (hM : MulBnd M mm Φ) (H : SapHyp p s t α Bi Bo mm Bacc Q) (HT : TabHyp p s t α Bq)
    (HQ : AxQ s t m kb Bi Bo Q) (hmr : m = rest.prod)
    (st : IState HS) (L : List (ℤ × ℤ)) (Rest : List Item) (hR : SapRegs p s t α m kb st)
    (hD : st.G gD = gints L ++ Rest) (hL : L.length = s * m) (hLB : GB Bi L) :
    sapAxP.run st = st.upd gD (gints (tensorGo [(t, sapL p s t α)] (s :: rest) L) ++ Rest) ∧
      sapAxP.ok M st ∧ sapAxP.cost M st ≤ sapAxCost p s t α m kb Bi mm Φ Bacc Q Bq ∧
      (tensorGo [(t, sapL p s t α)] (s :: rest) L).length = m * t ∧
      GB Bo (tensorGo [(t, sapL p s t α)] (s :: rest) L) := by sorry
