theorem rmSub_lt : ∀ (ts : List ℕ), (∀ t ∈ ts, 0 < t) → ∀ j k, rmSub ts j k < ts.prod
  | [], _, _, _ => by simp [rmSub]
  | t :: ts, h, j, k => by
    have ht : 0 < t := h t (by simp)
    have h' : ∀ u ∈ ts, 0 < u := fun u hu => h u (by simp [hu])
    have ih := rmSub_lt ts h' (j % ts.prod) (k % ts.prod)
    simp only [rmSub, List.prod_cons]
    have hq : (j / ts.prod % t + t - k / ts.prod % t) % t ≤ t - 1 :=
      Nat.le_sub_one_of_lt (Nat.mod_lt _ ht)
    calc _ < (j / ts.prod % t + t - k / ts.prod % t) % t * ts.prod + ts.prod := by omega
      _ ≤ (t - 1) * ts.prod + ts.prod := by gcongr
      _ = t * ts.prod := by
        rcases t with _ | t
        · omega
        · simp [Nat.succ_mul]

lemma div_mod_split {R t q s : ℕ} (hR : 0 < R) (hq : q < t) (hs : s < R) :
    (q * R + s) / R % t = q ∧ (q * R + s) % R = s := by
  constructor
  · rw [Nat.add_comm, Nat.add_mul_div_right _ _ hR, Nat.div_eq_of_lt hs, zero_add,
      Nat.mod_eq_of_lt hq]
  · rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hs]

theorem digL_rmSub : ∀ (ts : List ℕ), (∀ t ∈ ts, 0 < t) → ∀ j k i (hi : i < ts.length),
    digL ts (rmSub ts j k) i = (digL ts j i + ts[i] - digL ts k i) % ts[i]
  | [], _, _, _, _, hi => by simp at hi
  | t :: ts, h, j, k, i, hi => by
    have ht : 0 < t := h t (by simp)
    have h' : ∀ u ∈ ts, 0 < u := fun u hu => h u (by simp [hu])
    have hR := prod_pos_of h'
    have hs := rmSub_lt ts h' (j % ts.prod) (k % ts.prod)
    have hq := Nat.mod_lt (j / ts.prod % t + t - k / ts.prod % t) ht
    obtain ⟨e1, e2⟩ := div_mod_split hR hq hs
    rcases i with _ | i
    · simp only [digL, rmSub, List.getElem_cons_zero]
      rw [e1]
    · simp only [digL, rmSub, List.getElem_cons_succ]
      rw [e2]
      exact digL_rmSub ts h' _ _ i (by simpa using hi)

variable {D : ℕ}

lemma fullIdx_last (t : Fin (D + 1) → ℕ) (j c : ℕ) :
    fullIdx t j c (Fin.last D) = ((c : ℕ) : ZMod (t (Fin.last D))) := by
  simp [fullIdx]

lemma recL_length (t : Fin (D + 1) → ℕ) (f) : (recL t f).length = (tsOf t).prod := by simp [recL]

lemma recL_getD (t : Fin (D + 1) → ℕ) (f) {j : ℕ} (hj : j < (tsOf t).prod) :
    (recL t f).getD j 0 = fun c : Fin (t (Fin.last D)) => f (fullIdx t j c) := by
  simp [recL, List.getD_eq_getElem?_getD, hj]

lemma cast_sub_mod {m x y : ℕ} (hy : y < m) :
    (((x + m - y) % m : ℕ) : ZMod m) = (x : ZMod m) - (y : ZMod m) := by
  rw [ZMod.natCast_mod, Nat.cast_sub (by omega), Nat.cast_add, ZMod.natCast_self, add_zero]

/-- The negacyclic product with the inner sum collapsed. -/
theorem ncm_eq {r : ℕ} [NeZero r] (u v : Fin r → ℂ) (c : Fin r) :
    ncm u v c = ∑ a : Fin r, u a * v ⟨(c.val + r - a.val) % r, Nat.mod_lt _ (Nat.pos_of_ne_zero (NeZero.ne r))⟩ *
      (if a.val ≤ c.val then 1 else -1) := by
  unfold ncm
  refine Finset.sum_congr rfl fun a _ => ?_
  have hr : 0 < r := Nat.pos_of_ne_zero (NeZero.ne r)
  set b0 : Fin r := ⟨(c.val + r - a.val) % r, Nat.mod_lt _ hr⟩
  have ha := a.2
  have hc := c.2
  have hb0 : b0.val = if a.val ≤ c.val then c.val - a.val else c.val + r - a.val := by
    simp only [b0]
    split_ifs with h
    · rw [show c.val + r - a.val = (c.val - a.val) + r by omega, Nat.add_mod_right,
        Nat.mod_eq_of_lt (by omega)]
    · rw [Nat.mod_eq_of_lt (by omega)]
  have hX : (∑ b : Fin r, if b = b0 then u a * v b0 * (if a.val ≤ c.val then (1 : ℂ) else -1) else 0) =
      u a * v b0 * (if a.val ≤ c.val then 1 else -1) := by simp
  rw [← hX]
  refine Finset.sum_congr rfl fun b _ => ?_
  have hb := b.2
  have hv : b ≠ b0 → b.val ≠ b0.val := fun h e => h (Fin.ext e)
  by_cases hac : a.val ≤ c.val
  · rw [if_pos hac] at hb0
    by_cases hbb : b = b0
    · rw [if_pos hbb]; subst hbb
      rw [if_pos (show a.val + b0.val = c.val by omega)]; simp [hac]
    · rw [if_neg hbb]; have := hv hbb
      rw [if_neg (by omega), if_neg (by omega)]
  · rw [if_neg hac] at hb0
    by_cases hbb : b = b0
    · rw [if_pos hbb]; subst hbb
      rw [if_neg (by omega), if_pos (by omega)]; simp [hac]
    · rw [if_neg hbb]; have := hv hbb
      rw [if_neg (by omega), if_neg (by omega)]

