open NLogN
open NLogN.KFS
open IntMul KIL KFB KFL AModel AModelL12
variable {α β : Type*}
theorem solution (sh : AModel.Shape) (g : List ℕ → List ℕ) (hg : ∀ a, AModel.Valid sh a → AModel.Valid sh (g a))
    (f : α → List β) (B : ℕ) (hf : ∀ x, (f x).length = B) (d : α) (d' : β)
    (xs : List α) (hxs : xs.length = AModel.vol sh) :
    (AModel.pull sh sh g d xs).flatMap f =
      AModel.pull (sh ++ [B]) (sh ++ [B]) (fun a => g (a.take sh.length) ++ a.drop sh.length) d'
        (xs.flatMap f) := by
  rcases Nat.eq_zero_or_pos B with hB | hB
  · subst hB
    have h1 : ∀ ys : List α, ys.flatMap f = [] := fun ys => by
      rw [← List.length_eq_zero_iff, NLogN.KFS.length_flatMap_const f 0 hf]; simp
    rw [h1]; simp [AModel.pull, AModel.vol_append]
  apply List.ext_getElem?
  intro j
  by_cases hj : j < AModel.vol sh * B
  · rw [NLogN.KFS.getElem?_flatMap_const f B hf hB]
    have hjB : j / B < AModel.vol sh := (Nat.div_lt_iff_lt_mul hB).2 hj
    have hv := hg _ (AModel.valid_decode hjB)
    have hl : (g (AModel.decode sh (j / B))).length = sh.length := hv.length_eq
    have he := AModel.encode_lt hv
    have hm : j % B < B := Nat.mod_lt _ hB
    have hlt : AModel.encode sh (g (AModel.decode sh (j / B))) * B + j % B < xs.length * B := by
      rw [hxs]; nlinarith
    rw [List.getElem?_eq_getElem (by simp; exact hjB), List.getElem?_eq_getElem
      (by simp [AModel.vol_append]; exact hj)]
    simp only [Option.bind_some, AModel.getElem_pull]
    rw [NLogN.KFS.decode_snoc sh B hj]
    have hdl : (AModel.decode sh (j / B)).length = sh.length := AModel.length_decode _ _
    rw [List.take_append_of_le_length (by omega), List.take_of_length_le (by omega),
      List.drop_append_of_le_length (by omega), List.drop_of_length_le (by omega), List.nil_append,
      NLogN.KFS.encode_snoc sh B hl, List.getD_eq_getElem _ _ (by rw [hxs]; exact he),
      List.getD_eq_getElem _ _ (by rw [NLogN.KFS.length_flatMap_const f B hf]; exact hlt)]
    set e := AModel.encode sh (g (AModel.decode sh (j / B)))
    have k1 : (e * B + j % B) / B = e := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hB, Nat.div_eq_of_lt hm, zero_add]
    have k2 : (e * B + j % B) % B = j % B := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hm]
    have he' : e < xs.length := by omega
    rw [← List.getElem?_eq_getElem, NLogN.KFS.getElem?_flatMap_const f B hf hB, k1, k2,
      List.getElem?_eq_getElem he']
    rfl
  · rw [List.getElem?_eq_none, List.getElem?_eq_none]
    · simp [AModel.vol_append]; omega
    · rw [NLogN.KFS.length_flatMap_const f B hf]; simp; omega
end
