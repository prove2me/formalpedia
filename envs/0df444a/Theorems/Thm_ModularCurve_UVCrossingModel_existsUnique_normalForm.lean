-- title:
--   Unique normal form a(U)+b(V) in the crossing model
-- statement:
--   Let $W$ be a commutative ring, let $\varpi \in W$, and assume $W$ is complete and Hausdorff (separated) for the adic topology of the ideal $(\varpi)$, i.e. `IsAdicComplete (Ideal.span {ϖ}) W`. Let $e$ be a natural number with $1 \le e$. Form the crossing model $\mathrm{UVCrossingModel}\,W\,(\varpi^e)$, the quotient of the two-variable formal power series ring $\mathrm{MvPowerSeries}\,(\mathrm{Fin}\ 2)\,W$ by the principal ideal generated by $X_0X_1 - \varpi^e$, with $\mathrm{mk}(\varpi^e)$ the quotient ring homomorphism. Then for every element $x$ of this quotient there is exactly one pair $(a,b)$ of one-variable power series over $W$ such that the constant coefficient of $b$ vanishes and $\mathrm{mk}(\varpi^e)\bigl(\mathrm{inU}\,a + \mathrm{inV}\,b\bigr) = x$; here $\mathrm{inU}\,a$ is the two-variable series whose coefficient at a multidegree $d$ is the $d_0$-th coefficient of $a$ when $d_1 = 0$ and $0$ otherwise (that is, $a(X_0)$), and $\mathrm{inV}\,b$ is the series whose coefficient at $d$ is the $d_1$-th coefficient of $b$ when $d_0 = 0$ and $0$ otherwise (that is, $b(X_1)$). Thus every class in $W[[U,V]]/(UV-\varpi^e)$ is represented by $a(U)+b(V)$ with $b(0)=0$, uniquely so.
--
--   This is the normal-form (or coordinate) description of the crossing model $W[[U,V]]/(UV-\varpi^e)$ used as the local ring at a node of a semistable curve: the $W$-module of classes is identified with $W[[U]] \oplus V\,W[[V]]$. It is the coordinate system in which the node-annulus engine reads off Gauss orders and dominant indices, and it is invoked by the lemmas of `AlgebraicCurve.NodeAnnulusEngine` that compute orders of residues along the layers of such a model.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_UVCrossingModel_existsUnique_normalForm.lean

import Mathlib
import Definitions.Def_ModularCurve_UVCrossingModel
import Definitions.Def_ModularCurve_UVCrossingGaussOrder

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open ModularCurve ModularCurve.UVCrossingModel

theorem ModularCurve.UVCrossingModel.existsUnique_normalForm
    {W : Type u} [CommRing W] (ϖ : W) [IsAdicComplete (Ideal.span {ϖ}) W] (e : ℕ) (he : 1 ≤ e)
    (x : UVCrossingModel W (ϖ ^ e)) :
    ∃! ab : PowerSeries W × PowerSeries W,
      PowerSeries.constantCoeff ab.2 = 0 ∧ mk (ϖ ^ e) (inU ab.1 + inV ab.2) = x := by sorry
