-- Source module: Solutions.KFWC2
/-!
# KFW C-layer tools 2: natural-number frames and register tests

* `vOf σ`: the natural view of an assignment; **`exV_NE`**: an `NE` expression over natural
  registers of `σ` has its natural value (`NE.good`).
* `fr l`, `frV σ l`: a frame of `NE` pushes and its values; **`pushSeq_NE`**, **`sImplQ_fr`**,
  **`runQ_fr`**: frames around `SImplQ` / `RunQ` statements.
* **`sImplQ_testT/F`**, **`runQ_testT/F`**: push a test value, branch on it being `0`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-! ## Natural values of expressions -/

theorem vOf_eq {σ : Fin HS → Option ℤ} {i : Fin HS} {n : ℕ} (h : σ i = some (n : ℤ)) :
    vOf σ i = n := by simp [vOf, h]

theorem exV_NE {σ : Fin HS → Option ℤ} {e : NE} (hn : NatR σ e) {M B : ℕ}
    (hM : zsz (M : ℤ) ≤ B) (hok : e.OK (vOf σ) M) :
    ExV σ e.toEx ((e.val (vOf σ) : ℕ) : ℤ) B := by
  intro t ht
  have hh : NE.Holds t (vOf σ) e := by
    intro i hi
    obtain ⟨n, hn⟩ := hn i hi
    obtain ⟨L, hL⟩ := ht i _ hn
    exact ⟨L, by rw [hL, vOf_eq hn]⟩
  obtain ⟨a, b, c⟩ := NE.good hM e hh hok
  exact ⟨a, c, b⟩

/-! ## Frames of natural pushes -/

theorem noRd_of_N (σ : Fin HS → Option ℤ) :
    ∀ (pre : List (Fin HS)) (l : List (Fin HS × NE)), NoRdN pre l →
      NoRd pre (l.map fun x => (x.1, x.2.toEx, ((x.2.val (vOf σ) : ℕ) : ℤ)))
  | _, [], _ => trivial
  | pre, x :: l, h => ⟨fun j hj => h.1 j (by rw [NE.regs_toEx] at hj; exact hj),
      noRd_of_N σ (x.1 :: pre) l h.2⟩

theorem pushSeq_NE (σ : Fin HS → Option ℤ) (M B sz : ℕ) (hM : zsz (M : ℤ) ≤ B)
    (l : List (Fin HS × NE)) (h : FrOK σ M sz l) (hn : NoRdN [] l) :
    PushSeq σ (fr l) (frV σ l) (cFrame l.length sz B) := by
  have H := pushSeq_of σ B sz [] (l.map fun x => (x.1, x.2.toEx, ((x.2.val (vOf σ) : ℕ) : ℤ))) σ
    (fun j _ => rfl) (fun x hx => by
      obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
      obtain ⟨h1, h2, h3, h4, h5⟩ := h y hy
      exact ⟨h1, NE.clean h2, by rw [NE.size_toEx]; exact h3, exV_NE h4 hM h5⟩)
    (noRd_of_N σ [] l hn)
  simp only [List.map_map, List.length_map] at H
  exact H

theorem frV_length (σ : Fin HS → Option ℤ) (l : List (Fin HS × NE)) :
    (frV σ l).length = l.length := by simp [frV]

theorem frV_zsz {σ : Fin HS → Option ℤ} {M B sz : ℕ} (hM : zsz (M : ℤ) ≤ B)
    {l : List (Fin HS × NE)} (h : FrOK σ M sz l) : ∀ p ∈ frV σ l, zsz p.2 ≤ B := by
  intro p hp
  obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hp
  exact le_trans (zsz_natCast_le (NE.le_of_OK _ (h y hy).2.2.2.2)) hM

theorem frV_keys (σ : Fin HS → Option ℤ) (l : List (Fin HS × NE)) :
    (frV σ l).map Prod.fst = l.map Prod.fst := by simp [frV, List.map_map, Function.comp_def]

theorem fr_keys (l : List (Fin HS × NE)) : (fr l).map Prod.fst = l.map Prod.fst := by
  simp [fr, List.map_map, Function.comp_def]

section Frames

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {ι : Type*} [Fintype ι] [DecidableEq ι] {lo hi r : ℕ} {st : ι → ℕ} {n : ℕ}

/-- **A natural frame** around an `SImplQ` statement. -/
theorem sImplQ_fr {σ : Fin HS → Option ℤ} (hσ0 : σ 0 = none) (l : List (Fin HS × NE))
    (M B sz : ℕ) (hM : zsz (M : ℤ) ≤ B) (h : FrOK σ M sz l) (hn : NoRdN [] l)
    (h0 : ∀ x ∈ l, x.1 ≠ 0) {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ} {U : IStmt HS Pp}
    {e dw : ℕ} {cost : ℕ → ℕ}
    (H : SImplQ I iprog (fun s => Agree (σPush σ (frV σ l)) s) lo hi r st n T U e dw cost) :
    SImplQ I iprog (fun s => Agree σ s) lo hi r st n T (withPushI (fr l) U) e dw
      (fun w => cFrame l.length sz B + cost w + (l.length * (2 * B + 2) + 1)) := by
  have := sImplQ_push σ hσ0 (fun s h => h) (fr l) (frV σ l) _ B (pushSeq_NE σ M B sz hM l h hn)
    (by
      rw [fr_keys]; intro hm
      obtain ⟨x, hx, e⟩ := List.mem_map.1 hm
      exact h0 x hx e)
    (frV_zsz hM h) (fun s hs => agree_pushSt' _ hs) H
  rw [frV_length] at this
  exact this

/-! ## Register tests -/

theorem isZ_agree {σ : Fin HS → Option ℤ} {s : IState HS} (h : Agree σ s) {x : Fin HS} {v : ℕ}
    (hv : σ x = some (v : ℤ)) : isZ (s.cl x) = decide (v = 0) := by
  rw [cl_agree h hv]
  by_cases hv0 : v = 0
  · subst hv0; simp [isZ, NLogN.cls]
  · have : (v : ℤ) ≠ 0 := by exact_mod_cast hv0
    have h2 : ¬ (v : ℤ) < 0 := by omega
    simp [isZ, NLogN.cls, this, h2, hv0]

theorem σPush_one (σ : Fin HS → Option ℤ) (x : Fin HS) (v : ℤ) :
    σPush σ [(x, v)] x = some v := by simp [σPush]

/-- The test frame. -/
theorem sImplQ_test {σ : Fin HS → Option ℤ} (hσ0 : σ 0 = none) (x : Fin HS) (hx : x.val < 56)
    (hx0 : x ≠ 0) (c : NE) (M B sz : ℕ) (hM : zsz (M : ℤ) ≤ B) (hc : c.RegsLt)
    (hsz : c.size ≤ sz) (hnat : NatR σ c) (hok : c.OK (vOf σ) M)
    {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ} {p q : IStmt HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
    (H : SImplQ I iprog (fun s => Agree (σPush σ [(x, ((c.val (vOf σ) : ℕ) : ℤ))]) s) lo hi r st n T
      (if c.val (vOf σ) = 0 then p else q) e dw cost) :
    SImplQ I iprog (fun s => Agree σ s) lo hi r st n T (testC x c p q) e dw
      (fun w => cFrame 1 sz B + (cost w + 25) + (1 * (2 * B + 2) + 1)) := by
  have hl : FrOK σ M sz [(x, c)] := by
    intro y hy
    simp only [List.mem_singleton] at hy
    subst hy
    exact ⟨hx, hc, hsz, hnat, hok⟩
  have := sImplQ_fr (I := I) (iprog := iprog) (lo := lo) (hi := hi) (r := r) (st := st) (n := n)
    hσ0 [(x, c)] M B sz hM hl ⟨fun j _ h => by simp at h, trivial⟩
    (fun y hy => by simp only [List.mem_singleton] at hy; subst hy; exact hx0)
    (T := T) (U := .ite x isZ p q) (e := e) (dw := dw)
    (sImplQ_ite hx0 (decide (c.val (vOf σ) = 0))
      (fun s hs => isZ_agree hs (σPush_one σ x _)) (by
        by_cases h0 : c.val (vOf σ) = 0
        · rw [if_pos h0] at H; simp only [h0, decide_true, if_true]; exact H
        · rw [if_neg h0] at H; simp only [h0, decide_false]; exact H))
  simp only [List.length_singleton] at this
  exact this

end Frames

end NLogN.KFW

