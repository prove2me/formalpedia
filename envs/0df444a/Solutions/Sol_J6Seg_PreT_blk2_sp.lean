-- Source module: Solutions.J6SegILPre22
/-!
# B-line IL, pre-tables (B5′, `tabK2` layout), part 22: the new block header and one block

* `hdrP2 K Cs` pushes `blkHdr2 n b = [n, 2n, clog₂(2n), 2nb]` (reading order, i.e. `K` gains its
  reverse) for `n` on `2`, `b` on `28`. `clog₂(2n)` is computed by `λ` rounds (counter `Cs`) of
  `if p < 2n then (p := 2p; j := j + 1)` with `j` on `3`, `p` on `4`. Everything is at width `BW A`
  (needs `4λ ≤ 2^A`, since `p = 2^j < 4n`).
* `blkB2 K Cs` is `blkB K Cs` with `hdrP2` in place of `hdrP`; `blk2_sp` needs no `M`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-! ## The header -/

/-! ## One block -/

/-- **One block (new header).** -/
theorem blk2_sp_sol_aux (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {K Cs : Fin HS}
    (hK : K ∉ rg) (hK5 : K.val < 56) (hKC : K ≠ Cu) (hCs : Cs ∉ rg) (hCs5 : Cs.val < 56)
    (hKs : K ≠ Cs) (hcs : c Cs = []) (hcu : c Cu = []) {P R sN tN lam aN A b st nb sn : ℕ}
    (hi : StIn2 v P R sN tN lam aN A) (hPA : P ≤ A) (TB : TabB P R sN tN aN lam A)
    (h28 : v 28 = b) (h4l : 4 * lam ≤ 2 ^ A)
    (h1 : v 1 = st) (h7 : v 7 = nb) (h8 : v 8 = sn) (hl : 1 ≤ lam)
    (hst : st + (1 + J6Seg.enF sN tN lam st) ≤ 2 ^ A) (hnb : nb + 1 ≤ 2 ^ A)
    (hsn : sn + (1 + J6Seg.enF sN tN lam st) ≤ 2 ^ A) :
    Sp (blkB2 K Cs) (encK s (RF v c))
      (encK s (RF (zr (Function.update (Function.update (Function.update v 1
          ((st + (1 + J6Seg.enF sN tN lam st) : ℕ) : ℤ)) 7 ((nb + 1 : ℕ) : ℤ)) 8
          ((sn + (1 + J6Seg.enF sN tN lam st) : ℕ) : ℤ)))
        (Function.update c K ((J6Seg.KR.encD2 b (dscOf P R sN tN lam aN st)).reverse ++ c K))))
      (cBlk2 A lam) := by
  have hA := hi.A2
  set n := 1 + J6Seg.enF sN tN lam st with hn
  have hnl : n ≤ lam := by have := J6Seg.en_le_lam (s := sN) (t := tN) hl st; omega
  set T := mkTables P R sN tN aN
  -- scan
  have H1 := scan_sp s v c hCs hCs5 hcs hA hi.vb h1 hi.h22 hi.h23 hi.h24 hl hi.lam
  set v1 := Function.update (Function.update v 2 ((n : ℕ) : ℤ)) 5 1
  have hv1 : VB v1 A := VB_upd (VB_upd hi.vb 2 (by
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast (show n ≤ 2 ^ A by omega))) 5
    (by simp; exact one_le_pow₀ (by norm_num))
  have a1 : ∀ j, ¬ Wk j → v1 j = v j := by
    intro j hj; unfold Wk at hj; push Not at hj
    simp only [v1]; rw [upd_ne hj.2.2.2.1, upd_ne hj.1]
  have v12 : v1 2 = n := by simp [v1]
  -- header
  obtain ⟨vh, ah, hvh, H2⟩ := hdr2_sp s v1 c hK hK5 hCs hCs5 hKs hcs hA hv1 v12
    (by rw [a1 24 (by unfold Wk; decide), hi.h24]) (by rw [a1 28 (by unfold Wk; decide), h28])
    (by omega) hnl h4l
  have ah' : ∀ j, ¬ Wk j → vh j = v j := by
    intro j hj; have hj' := hj; unfold Wk at hj'; push Not at hj'
    rw [ah j hj'.2.1 hj'.2.2.1, a1 j hj]
  have ih : StIn2 vh P R sN tN lam aN A := hi.of hvh ah'
  have vh2 : vh 2 = n := by rw [ah 2 (by decide) (by decide), v12]
  set c2 := Function.update c K ((J6Seg.KR.blkHdr2 n b).reverse ++ c K)
  have c2u : c2 Cu = [] := by simp only [c2]; rw [Function.update_of_ne (Ne.symm hKC), hcu]
  -- am
  obtain ⟨v2, a2, hv2, H3⟩ := amP_sp s vh c2 hK hK5 hKC c2u ih hPA
    (cN := st) (nN := n) (by rw [ah' 1 (by unfold Wk; decide), h1]) vh2 hnl
    (fun k _ => TB.en _) (fun k hk => TB.am st k (by omega)) (fun k _ => TB.en _) TB.gam
  have a2' : ∀ j, ¬ Wk j → v2 j = v j := by
    intro j hj; have hj' := hj; unfold Wk at hj'; push Not at hj'
    rw [a2 j hj'.2.1 hj'.2.2.1 hj'.2.2.2.1 hj'.2.2.2.2.1 hj'.2.2.2.2.2, ah' j hj]
  have i2 : StIn2 v2 P R sN tN lam aN A := hi.of hv2 a2'
  have v22 : v2 2 = n := by rw [a2 2 (by decide) (by decide) (by decide) (by decide) (by decide), vh2]
  set c3 := Function.update c2 K (((List.range n).map (T.am st)).reverse ++ c2 K)
  have c3u : c3 Cu = [] := by simp only [c3]; rw [Function.update_of_ne (Ne.symm hKC), c2u]
  -- ap
  obtain ⟨v3, a3, hv3, H4⟩ := apP_sp s v2 c3 hK hK5 hKC c3u i2 hPA
    (cN := st) (nN := n) (by rw [a2' 1 (by unfold Wk; decide), h1]) v22 hnl
    (fun k _ => TB.en _) (fun k hk => TB.ap st k (by omega)) (fun k _ => TB.en _) TB.gam
  have a3' : ∀ j, ¬ Wk j → v3 j = v j := by
    intro j hj; have hj' := hj; unfold Wk at hj'; push Not at hj'
    rw [a3 j hj'.2.1 hj'.2.2.1 hj'.2.2.2.1 hj'.2.2.2.2.1 hj'.2.2.2.2.2, a2' j hj]
  have v32 : v3 2 = n := by rw [a3 2 (by decide) (by decide) (by decide) (by decide) (by decide), v22]
  set c4 := Function.update c3 K (((List.range n).map (T.ap st)).reverse ++ c3 K)
  -- counters
  have H5 := spA' s v3 c4 hA hv3 (i := 7) (by decide) (e := e7) (inRg_of (by decide)) (by decide)
    (by decide) (by decide)
  have q5 : e7.eval (encK s (RF v3 c4)) = ((nb + 1 : ℕ) : ℤ) := by
    simp only [e7, Ex.eval, top_RF (show (7 : Fin HS) ∈ rg by decide),
      a3' 7 (by unfold Wk; decide), h7]; push_cast; ring
  rw [q5] at H5
  set v4 := Function.update v3 7 ((nb + 1 : ℕ) : ℤ)
  have hv4 : VB v4 A := VB_upd hv3 7 (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast hnb)
  have H6 := spA' s v4 c4 hA hv4 (i := 8) (by decide) (e := e8) (inRg_of (by decide)) (by decide)
    (by decide) (by decide)
  have q6 : e8.eval (encK s (RF v4 c4)) = ((sn + n : ℕ) : ℤ) := by
    simp only [e8, Ex.eval, top_RF (show (8 : Fin HS) ∈ rg by decide),
      top_RF (show (2 : Fin HS) ∈ rg by decide), v4, upd_ne (show (8 : Fin HS) ≠ 7 by decide),
      upd_ne (show (2 : Fin HS) ≠ 7 by decide), a3' 8 (by unfold Wk; decide), h8, v32]
    push_cast; ring
  rw [q6] at H6
  set v5 := Function.update v4 8 ((sn + n : ℕ) : ℤ)
  have hv5 : VB v5 A := VB_upd hv4 8 (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast hsn)
  have H7 := spA' s v5 c4 hA hv5 (i := 1) (by decide) (e := e1) (inRg_of (by decide)) (by decide)
    (by decide) (by decide)
  have q7 : e1.eval (encK s (RF v5 c4)) = ((st + n : ℕ) : ℤ) := by
    simp only [e1, Ex.eval, top_RF (show (1 : Fin HS) ∈ rg by decide),
      top_RF (show (2 : Fin HS) ∈ rg by decide), v5, v4, upd_ne (show (1 : Fin HS) ≠ 7 by decide),
      upd_ne (show (2 : Fin HS) ≠ 7 by decide), upd_ne (show (1 : Fin HS) ≠ 8 by decide),
      upd_ne (show (2 : Fin HS) ≠ 8 by decide), a3' 1 (by unfold Wk; decide), h1, v32]
    push_cast; ring
  rw [q7] at H7
  set v6 := Function.update v5 1 ((st + n : ℕ) : ℤ)
  have hv6 : VB v6 A := VB_upd hv5 1 (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast hst)
  have H8 := clr_sp s v6 c4 hA hv6
  have T8 := H1.seq (H2.seq (H3.seq (H4.seq (H5.seq (H6.seq (H7.seq H8))))))
  refine (T8.congr ?_).mono (le_of_eq rfl)
  congr 2
  · apply zr_congr
    intro j hj
    by_cases b1 : j = 1
    · subst b1; simp [v6]
    by_cases b7 : j = 7
    · subst b7; simp [v6, v5, v4]
    by_cases b8 : j = 8
    · subst b8; simp [v6, v5]
    simp only [v6, v5, v4]
    rw [upd_ne b1, upd_ne b8, upd_ne b7, a3' j hj, upd_ne b8, upd_ne b7, upd_ne b1]
  · simp only [c4, c3, c2, Function.update_self, Function.update_idem, J6Seg.KR.encD2, dscOf,
      List.reverse_append, List.append_assoc]
    rfl

end J6Seg.PreT

