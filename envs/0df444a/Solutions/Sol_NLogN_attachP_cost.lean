  generalize ht : withCtr 43 S0 N0 i (outerSt s D Rest n m d i) = t
  have tG : ∀ x, x ≠ 43 → t.G x = (outerSt s D Rest n m d i).G x := fun x hx => by
    rw [← ht, withCtr_G_ne _ _ _ _ hx]
  have t42 : t.G 42 = .int (i : ℤ) :: s.G 42 := by rw [tG 42 (by decide)]; simp [outerSt]
  set u := (push 41 (.reg 42)).run t with hu
  have u1 : u.G 1 = .int n :: L1 := by
    rw [hu, run_push_G, if_neg (by decide), tG 1 (by decide),
      outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
  have u2 : u.G 2 = .int m :: L2 := by
    rw [hu, run_push_G, if_neg (by decide), tG 2 (by decide),
      outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h2]
  have hz : innerSt s u D Rest n m d i 0 = u := by
    apply IState.ext' _ (by simp [innerSt]) (by simp [innerSt])
    intro x
    simp only [innerSt, IState.upd_G]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [hu, tG 0 (by decide), outerSt]
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true}) [hu, tG 40 (by decide), outerSt]
    by_cases x41 : x = 41
    · subst x41; simp (config := {decide := true}) [hu, Ex.eval, IState.top_eq t42, tG 41 (by decide), outerSt]
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [hu, tG 45 (by decide), outerSt]
    by_cases x54 : x = 54
    · subst x54; simp (config := {decide := true}) [hu, tG 54 (by decide), outerSt]
    simp [x0, x40, x41, x45, x54]
  have H := inner_states d n m i D Rest s u hD hDw hi L1 L2 u1 u2 hz
  have e2 : (Ex.reg (S := HS) 2).eval u = m := by simp [Ex.eval, IState.top_eq u2]
  have hin : (innerLoop d).run u = innerSt s u D Rest n m d i m := by
    rw [innerLoop, H.run, e2, Int.toNat_natCast]
  set v := innerSt s u D Rest n m d i m with hv
  have v41 : v.G 41 = .int ((m * n + i : ℕ) : ℤ) :: s.G 41 := by simp [hv, innerSt]
  have v42' : v.G 42 = .int (i : ℤ) :: s.G 42 := by
    simp only [hv, innerSt, IState.upd_G]
    simp (config := {decide := true}) [hu, t42]
  have v42 : ((pop 41).run v).G 42 = .int (i : ℤ) :: s.G 42 := by
    simp only [run_pop_G]; simp (config := {decide := true}) [v42']
  have hrun : (rowBody d).run t = (asg 42 (.add (.reg 42) (.lit 1))).run ((pop 41).run v) := by
    simp only [rowBody, run_seq, ← hu, hin]
  refine ⟨?_, ?_⟩
  · refine ⟨⟨by decide, clean_of_lt (by decide), IState.isInt_of t42⟩, ?_, ?_⟩
    · refine H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of u2) ?_
      intro j hj
      rw [e2, Int.toNat_natCast] at hj ⊢
      exact (elem_step d n m i D Rest s u hD hDw hi j hj L1 u1 _).1
    rw [hin]
    refine ⟨⟨by decide, IState.isInt_of v41⟩, by decide, ?_, ⟨IState.isInt_of v42, trivial⟩,
      IState.isInt_of v42⟩
    intro x hx; simp [Ex.regs] at hx; subst hx; decide
  · rw [hrun]
    apply run_ext _ (by simp [hv, innerSt, hu]; rw [← ht]; simp [withCtr, outerSt])
      (by simp [hv, innerSt, hu]; rw [← ht]; simp [withCtr, outerSt])
    intro x
    simp only [run_asg_G, run_pop_G, Ex.eval, IState.top_eq v42]
    by_cases x43 : x = 43
    · subst x43
      simp (config := {decide := true}) [hv, innerSt, hu]
      rw [← ht]; simp [withCtr]
    rw [withCtr_G_ne _ _ _ _ x43]
    by_cases x42 : x = 42
    · subst x42; simp [outerSt, v42']
    by_cases x41 : x = 41
    · subst x41; simp (config := {decide := true}) [v41, outerSt]
    simp only [if_neg x42, if_neg x41]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [hv, innerSt, outerSt]; ring_nf
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true}) [hv, innerSt, outerSt]; ring_nf
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [hv, innerSt, outerSt]; left; ring
    by_cases x54 : x = 54
    · subst x54; simp (config := {decide := true}) [hv, innerSt, outerSt]; ring_nf
    rw [hv, innerSt_G_other _ _ _ _ _ _ _ _ _ _ x0 x40 x41 x45 x54, hu, run_push_G, if_neg x41,
      tG x x43, outerSt_G_other _ _ _ _ _ _ _ _ x0 x40 x42 x45 x54,
      outerSt_G_other _ _ _ _ _ _ _ _ x0 x40 x42 x45 x54]

theorem kflat_length (n m d : ℕ) (D : List (List ℤ)) (hDw : ∀ r ∈ D, r.length = d) :
    ∀ p, p ≤ D.length → (kflat n m D p).length = p * (d + 1)
  | 0, _ => by simp [kflat]
  | p + 1, h => by
    rw [kflat_succ, List.length_append, kflat_length n m d D hDw p (by omega)]
    simp only [keyRec, List.length_cons, List.getD_eq_getElem _ _ (by omega : p < D.length),
      hDw _ (List.getElem_mem _)]
    ring

theorem outer_states (d n m : ℕ) (D : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hD : D.length = n * m) (hDw : ∀ r ∈ D, r.length = d)
    (L1 L2 : List Item) (h1 : s.G 1 = .int n :: L1) (h2 : s.G 2 = .int m :: L2) :
    RepStates 43 (.reg 1) (rowBody d) (outerSt s D Rest n m d 0) (outerSt s D Rest n m d) where
  nonneg := by
    have g1 : (outerSt s D Rest n m d 0).G 1 = .int n :: L1 := by
      rw [outerSt_G_other s D Rest n m d 0 1 (by decide) (by decide) (by decide) (by decide)
        (by decide), h1]
    simp [Ex.eval, IState.top_eq g1]
  hw := by simp (config := {decide := true}) [rowBody, innerLoop, elemBody, mvK, RS.writes]
  h0 := rfl
  hG := fun j => by
    rw [outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide),
      outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)]
  step := by
    intro i hi
    have g1 : (outerSt s D Rest n m d 0).G 1 = .int n :: L1 := by
      rw [outerSt_G_other s D Rest n m d 0 1 (by decide) (by decide) (by decide) (by decide)
        (by decide), h1]
    have e : (Ex.reg (S := HS) 1).eval (outerSt s D Rest n m d 0) = n := by
      simp [Ex.eval, IState.top_eq g1]
    rw [e, Int.toNat_natCast] at hi ⊢
    exact (row_step d n m D Rest s hD hDw L1 L2 h1 h2 _ _ i hi).2

theorem zsz_le_of_nat_le {a b : ℕ} {X : ℕ} (h : a ≤ b) (hb : zsz (b : ℤ) ≤ X) : zsz (a : ℤ) ≤ X :=
  le_trans (zsz_nat_mono h) hb

theorem elem_cost (d n m i : ℕ) (D : List (List ℤ)) (Rest : List Item) (s u : IState HS)
    (hD : D.length = n * m) (hDw : ∀ r ∈ D, r.length = d) (hi : i < n) (j : ℕ) (hj : j < m)
    (L1 : List Item) (h1 : u.G 1 = .int n :: L1) (N0 : ℕ) (X : ℕ) (hDB : ∀ r ∈ D, Bnd X r)
    (hX1 : zsz ((n * m + n : ℕ) : ℤ) ≤ X) (hX2 : zsz ((n * m * (d + 1) : ℕ) : ℤ) ≤ X)
    (hXd : zsz ((d + 1 : ℕ) : ℤ) ≤ X) :
    (elemBody d).cost (withCtr 44 u N0 j (innerSt s u D Rest n m d i j)) ≤
      33000 * (d + 1) * (X + 2) := by
  have hp : i * m + j < D.length := by
    rw [hD]
    calc i * m + j < i * m + m := by omega
      _ = (i + 1) * m := by ring
      _ ≤ n * m := Nat.mul_le_mul_right _ hi
  have hp' : i * m + j + 1 ≤ n * m := by omega
  have hdrop : D.drop (i * m + j) = D[i * m + j] :: D.drop (i * m + j + 1) :=
    List.drop_eq_getElem_cons hp
  have hlen : D[i * m + j].length = d := hDw _ (List.getElem_mem hp)
  have hBr : Bnd X D[i * m + j] := hDB _ (List.getElem_mem hp)
  have hkey : j * n + i + n ≤ n * m + n := by
    have : (j + 1) * n ≤ m * n := Nat.mul_le_mul_right _ hj
    nlinarith
  have q1 : zsz ((j * n + i : ℕ) : ℤ) ≤ X := zsz_le_of_nat_le (by omega) hX1
  have q2 : zsz ((j * n + i : ℕ) + (n : ℤ)) ≤ X := by
    have := zsz_le_of_nat_le (a := j * n + i + n) hkey hX1; exact_mod_cast this
  have q3 : zsz (n : ℤ) ≤ X := zsz_le_of_nat_le (by omega) hX1
  have hpd : (i * m + j) * (d + 1) + (d + 1) ≤ n * m * (d + 1) := by
    have := Nat.mul_le_mul_right (d + 1) hp'; nlinarith
  have q4 : zsz (((i * m + j) * (d + 1) : ℕ) : ℤ) ≤ X := zsz_le_of_nat_le (by omega) hX2
  have q5 : zsz ((((i * m + j) * (d + 1) : ℕ) : ℤ) + ((d + 1 : ℕ) : ℤ)) ≤ X := by
    have := zsz_le_of_nat_le hpd hX2; exact_mod_cast this
  have hNd : n * m ≤ n * m * (d + 1) := Nat.le_mul_of_pos_right _ (by omega)
  have q6 : zsz ((i * m + j : ℕ) : ℤ) ≤ X := zsz_le_of_nat_le (by omega) hX2
  have q7 : zsz (((i * m + j : ℕ) : ℤ) + 1) ≤ X := by
    have := zsz_le_of_nat_le (a := i * m + j + 1) (by omega) hX2; exact_mod_cast this
  have q8 : zsz (1 : ℤ) ≤ X := by
    have := zsz_le_of_nat_le (a := 1) (by omega) hXd; exact_mod_cast this
  have q9 : zsz (d : ℤ) ≤ X := zsz_le_of_nat_le (by omega) hXd
  generalize ht : withCtr 44 u N0 j (innerSt s u D Rest n m d i j) = t
  have tG : ∀ x, x ≠ 44 → t.G x = (innerSt s u D Rest n m d i j).G x := fun x hx => by
    rw [← ht, withCtr_G_ne _ _ _ _ hx]
  have t41 : t.G 41 = .int ((j * n + i : ℕ) : ℤ) :: s.G 41 := by
    rw [tG 41 (by decide)]; simp [innerSt]
  have t1 : t.G 1 = .int n :: L1 := by
    rw [tG 1 (by decide), innerSt_G_other _ _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide)
      (by decide) (by decide), h1]
  set t1' := (push 40 (.reg 41)).run t with ht1'
  have u0 : t1'.G 0 = ints D[i * m + j] ++ (ints (D.drop (i * m + j + 1)).flatten ++ Rest) := by
    rw [ht1', run_push_G, if_neg (by decide), tG 0 (by decide)]
    simp only [innerSt, IState.upd_G]
    simp (config := {decide := true})
    rw [hdrop, List.flatten_cons, ints_append, List.append_assoc]
  have hm := mvK_spec (X := 0) (Y := 40) (C := 51) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.lit d) (by intro x hx; simp [Ex.regs] at hx) t1'
    D[i * m + j] _ u0 trivial (by simp [Ex.eval, hlen])
  have cm := mvK_cost (X := 0) (Y := 40) (C := 51) (by decide) (by decide) (by decide) (.lit d) t1'
    D[i * m + j] _ u0 (by simp [Ex.eval, hlen]) X hBr trivial (by simpa [Ex.Bnd] using q9)
  set t2 := (t1'.upd 0 (ints (D.drop (i * m + j + 1)).flatten ++ Rest)).upd 40
    ((ints D[i * m + j]).reverse ++ t1'.G 40) with ht2
  have v41 : t2.G 41 = .int ((j * n + i : ℕ) : ℤ) :: s.G 41 := by
    simp only [ht2, ht1', IState.upd_G, run_push_G]; simp (config := {decide := true}) [t41]
  have v1 : t2.G 1 = .int n :: L1 := by
    simp only [ht2, ht1', IState.upd_G, run_push_G]; simp (config := {decide := true}) [t1]
  have v45 : t2.G 45 = .int (((i * m + j) * (d + 1) : ℕ) : ℤ) :: s.G 45 := by
    simp only [ht2, ht1', IState.upd_G, run_push_G]
    simp (config := {decide := true}) [tG 45 (by decide), innerSt]
  have v54 : t2.G 54 = .int ((i * m + j : ℕ) : ℤ) :: s.G 54 := by
    simp only [ht2, ht1', IState.upd_G, run_push_G]
    simp (config := {decide := true}) [tG 54 (by decide), innerSt]
  set t3 := (asg 41 (.add (.reg 41) (.reg 1))).run t2 with ht3
  have w45 : t3.G 45 = .int (((i * m + j) * (d + 1) : ℕ) : ℤ) :: s.G 45 := by
    simp only [ht3, run_asg_G]; simp (config := {decide := true}) [v45]
  have w54 : t3.G 54 = .int ((i * m + j : ℕ) : ℤ) :: s.G 54 := by
    simp only [ht3, run_asg_G]; simp (config := {decide := true}) [v54]
  set t4 := (asg 45 (.add (.reg 45) (.lit (d + 1)))).run t3 with ht4
  have x54 : t4.G 54 = .int ((i * m + j : ℕ) : ℤ) :: s.G 54 := by
    simp only [ht4, run_asg_G]; simp (config := {decide := true}) [w54]
  have c1 := pushCost_le_lin (.reg 41) t X (by simp [Ex.Lin])
    (by simp only [Ex.Bnd, IState.top_eq t41]; exact q1)
  have c3 := asgCost_le_lin 41 (.add (.reg 41) (.reg 1)) t2 X (by simp [Ex.Lin])
    (by simp only [Ex.Bnd, Ex.eval, IState.top_eq v41, IState.top_eq v1]; exact ⟨q1, q3, q2⟩)
    (by rw [IState.top_eq v41]; exact q1)
  have c4 := asgCost_le_lin 45 (.add (.reg 45) (.lit (d + 1))) t3 X (by simp [Ex.Lin])
    (by
      simp only [Ex.Bnd, Ex.eval, IState.top_eq w45]
      refine ⟨q4, by exact_mod_cast hXd, by exact_mod_cast q5⟩)
    (by rw [IState.top_eq w45]; exact q4)
  have c5 := asgCost_le_lin 54 (.add (.reg 54) (.lit 1)) t4 X (by simp [Ex.Lin])
    (by simp only [Ex.Bnd, Ex.eval, IState.top_eq x54]; exact ⟨q6, q8, q7⟩)
    (by rw [IState.top_eq x54]; exact q6)
  have hs1 : (Ex.reg (S := HS) 41).size = 1 := rfl
  have hs3 : ∀ a b : Ex HS, a.size = 1 → b.size = 1 → (Ex.add a b).size = 3 := by
    intro a b ha hb; simp [Ex.size, ha, hb]
  rw [hs1] at c1
  rw [hs3 _ _ rfl rfl] at c3 c4 c5
  have hsl : (Ex.lit (S := HS) (d : ℤ)).size = 1 := rfl
  rw [hsl, hlen] at cm
  simp only [elemBody, cost_seq]
  rw [← ht1', hm.2, ← ht3, ← ht4]
  simp only [RS.cost]
  nlinarith

theorem row_cost (d n m : ℕ) (D : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hD : D.length = n * m) (hDw : ∀ r ∈ D, r.length = d)
    (L1 L2 : List Item) (h1 : s.G 1 = .int n :: L1) (h2 : s.G 2 = .int m :: L2)
    (S0 : IState HS) (N0 i : ℕ) (hi : i < n) (X : ℕ) (hDB : ∀ r ∈ D, Bnd X r)
    (hX1 : zsz ((n * m + n : ℕ) : ℤ) ≤ X) (hX2 : zsz ((n * m * (d + 1) : ℕ) : ℤ) ≤ X)
    (hXd : zsz ((d + 1 : ℕ) : ℤ) ≤ X) :
    (rowBody d).cost (withCtr 43 S0 N0 i (outerSt s D Rest n m d i)) ≤
      m * (33000 * (d + 1) * (X + 2) + 8000 * (X + 2) + 30) + 17000 * (X + 2) := by
  have q1 : zsz (i : ℤ) ≤ X := zsz_le_of_nat_le (by omega) hX1
  have q2 : zsz ((i : ℤ) + 1) ≤ X := by
    have := zsz_le_of_nat_le (a := i + 1) (by omega) hX1; exact_mod_cast this
  have q3 : zsz (1 : ℤ) ≤ X := by
    have := zsz_le_of_nat_le (a := 1) (by omega) hXd; exact_mod_cast this
  have hmn : m ≤ n * m := Nat.le_mul_of_pos_left _ (by omega)
  have q4 : zsz (m : ℤ) ≤ X := zsz_le_of_nat_le (by omega) hX1
  have hmi : m * n + i ≤ n * m + n := by rw [Nat.mul_comm]; omega
  have q5 : zsz ((m * n + i : ℕ) : ℤ) ≤ X := zsz_le_of_nat_le hmi hX1
  generalize ht : withCtr 43 S0 N0 i (outerSt s D Rest n m d i) = t
  have tG : ∀ x, x ≠ 43 → t.G x = (outerSt s D Rest n m d i).G x := fun x hx => by
    rw [← ht, withCtr_G_ne _ _ _ _ hx]
  have t42 : t.G 42 = .int (i : ℤ) :: s.G 42 := by rw [tG 42 (by decide)]; simp [outerSt]
  set u := (push 41 (.reg 42)).run t with hu
  have u1 : u.G 1 = .int n :: L1 := by
    rw [hu, run_push_G, if_neg (by decide), tG 1 (by decide),
      outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
  have u2 : u.G 2 = .int m :: L2 := by
    rw [hu, run_push_G, if_neg (by decide), tG 2 (by decide),
      outerSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h2]
  have hz : innerSt s u D Rest n m d i 0 = u := by
    apply IState.ext' _ (by simp [innerSt]) (by simp [innerSt])
    intro x
    simp only [innerSt, IState.upd_G]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [hu, tG 0 (by decide), outerSt]
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true}) [hu, tG 40 (by decide), outerSt]
    by_cases x41 : x = 41
    · subst x41; simp (config := {decide := true}) [hu, Ex.eval, IState.top_eq t42, tG 41 (by decide), outerSt]
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [hu, tG 45 (by decide), outerSt]
    by_cases x54 : x = 54
    · subst x54; simp (config := {decide := true}) [hu, tG 54 (by decide), outerSt]
    simp [x0, x40, x41, x45, x54]
  have H := inner_states d n m i D Rest s u hD hDw hi L1 L2 u1 u2 hz
  have e2 : (Ex.reg (S := HS) 2).eval u = m := by simp [Ex.eval, IState.top_eq u2]
  have hin : (innerLoop d).run u = innerSt s u D Rest n m d i m := by
    rw [innerLoop, H.run, e2, Int.toNat_natCast]
  have cin := H.cost_le_lin X (33000 * (d + 1) * (X + 2)) (by simp [Ex.Lin])
    (by simp only [Ex.Bnd]; rw [← Ex.eval, e2]; exact q4) (by
      intro j hj
      rw [e2, Int.toNat_natCast] at hj ⊢
      exact elem_cost d n m i D Rest s u hD hDw hi j hj L1 u1 _ X hDB hX1 hX2 hXd)
  rw [e2, Int.toNat_natCast] at cin
  have cin' : (innerLoop d).cost u ≤ (1 + 1) * 2000 * (X + 2) +
      m * (33000 * (d + 1) * (X + 2) + 8000 * (X + 2) + 30) + 32 := cin
  set v := innerSt s u D Rest n m d i m with hv
  have v41 : v.G 41 = .int ((m * n + i : ℕ) : ℤ) :: s.G 41 := by simp [hv, innerSt]
  have v42' : v.G 42 = .int (i : ℤ) :: s.G 42 := by
    simp only [hv, innerSt, IState.upd_G]
    simp (config := {decide := true}) [hu, t42]
  have v42 : ((pop 41).run v).G 42 = .int (i : ℤ) :: s.G 42 := by
    simp only [run_pop_G]; simp (config := {decide := true}) [v42']
  have c1 := pushCost_le_lin (.reg 42) t X (by simp [Ex.Lin])
    (by simp only [Ex.Bnd, IState.top_eq t42]; exact q1)
  have c4 := asgCost_le_lin 42 (.add (.reg 42) (.lit 1)) ((pop 41).run v) X (by simp [Ex.Lin])
    (by simp only [Ex.Bnd, Ex.eval, IState.top_eq v42]; exact ⟨q1, q3, q2⟩)
    (by rw [IState.top_eq v42]; exact q1)
  have hs1 : (Ex.reg (S := HS) 42).size = 1 := rfl
  have hs3 : (Ex.add (S := HS) (.reg 42) (.lit 1)).size = 3 := rfl
  rw [hs1] at c1
  rw [hs3] at c4
  have c1' : (push 41 (.reg 42)).cost t ≤ (1 + 1) * 2000 * (X + 2) := c1
  have c4' : (asg 42 (.add (.reg 42) (.lit 1))).cost ((pop 41).run v) ≤ (3 + 1) * 2000 * (X + 2) :=
    c4
  simp only [rowBody, cost_seq, cost_pop]
  rw [← hu, hin, IState.top_eq v41]
  omega

end NLogN

