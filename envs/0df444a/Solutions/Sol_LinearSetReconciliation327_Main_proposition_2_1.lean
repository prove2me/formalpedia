section PinBits

variable {F : Type} [Field F] [Algebra (ZMod 2) F]

/-- **Proposition 2.1, second conjunct**: the bit encoding of a syndrome in the basis `b` is a
bijection; it uses exactly `t·w` bits. -/
theorem pinBits_bijective {w t : ℕ} (b : Module.Basis (Fin w) (ZMod 2) F) :
    Function.Bijective (pinBits (t := t) b) := by
  constructor
  · intro s s' h
    funext j
    apply b.repr.injective
    refine Finsupp.ext (fun k => ?_)
    have h1 := congrFun h (finProdFinEquiv (j, k))
    simpa [pinBits] using h1
  · intro y
    refine ⟨fun j =>
      b.repr.symm (Finsupp.equivFunOnFinite.symm (fun k => y (finProdFinEquiv (j, k)))), ?_⟩
    funext p
    have hp : finProdFinEquiv ((finProdFinEquiv.symm p).1, (finProdFinEquiv.symm p).2) = p := by
      simpa using Equiv.apply_symm_apply finProdFinEquiv p
    simp only [pinBits]
    rw [LinearEquiv.apply_symm_apply]
    simp only [Finsupp.coe_equivFunOnFinite_symm, hp]

/-- **Proposition 2.1, prefix consistency**, as in the paper: every prefix of the syndrome is the
shorter syndrome. -/
theorem pin_prefix (ι : ℕ → F) {N t a : ℕ} (ha : a ≤ t) (x : Fin N → ZMod 2) (j : Fin a) :
    pin ι t x (Fin.castLE ha j) = pin ι a x j := rfl

/-- **Proposition 2.1, update locality**, as in the paper: toggling one coordinate changes at most
`t·w` bits of the stored sketch. -/
theorem pin_update_card (ι : ℕ → F) {N t w : ℕ} (b : Module.Basis (Fin w) (ZMod 2) F)
    (x : Fin N → ZMod 2) (i : Fin N) :
    (univ.filter fun p =>
      pinBits b (pin ι t (x + Pi.single i 1)) p ≠ pinBits b (pin ι t x) p).card ≤ t * w := by
  calc (univ.filter fun p =>
      pinBits b (pin ι t (x + Pi.single i 1)) p ≠ pinBits b (pin ι t x) p).card
      ≤ (univ : Finset (Fin (t * w))).card := Finset.card_filter_le _ _
    _ = t * w := by simp

end PinBits

