-- title:
--   CSS code: parity checks $H_X,H_Z$, stabilizers, stabilizer algebras $\mathcal A_X,\mathcal A_Z,\mathcal A$, component codes, syndromes
-- statement:
--   A **CSS code** on $n$ qubits is given by parity-check matrices $H_X\in\mathbb F_2^{m_X\times n}$ and $H_Z\in\mathbb F_2^{m_Z\times n}$ with
--   $$H_XH_Z^{\mathsf T}=0 .$$
--   The rows may be linearly dependent. From these data:
--
--   1. the **X-type stabilizers** $S^X_a=X^{(\text{row } a\text{ of }H_X)}$ and **Z-type stabilizers** $S^Z_b=Z^{(\text{row } b\text{ of }H_Z)}$;
--   2. the **stabilizer algebras** $\mathcal A_X=\mathrm{Alg}(S_X)$, $\mathcal A_Z=\mathrm{Alg}(S_Z)$ and $\mathcal A=\mathrm{Alg}(S_X\cup S_Z)$ (complex subalgebras generated by the stabilizers);
--   3. the **classical component codes** $C_X=\ker H_X$ and $C_Z=\ker H_Z$;
--   4. the **valid syndromes** $\Sigma_X=\operatorname{im}H_X$ and $\Sigma_Z=\operatorname{im}H_Z$.
--
--   The X sector tracks the logical $X$ and is flipped by physical $Z$ errors, which the X-type stabilizers detect; symmetrically for Z.
--
--   **Formalization Note** The generator $S^X_a$ is the X-type Pauli string on the support of row $a$ of $H_X$, without phase (the paper calls the generating sets the ones "defined by" $H_X,H_Z$). $\Sigma_X$ is stored as a finite set.
-- source:
--   Drechsler, Oreg, Aharonov, Autonomous Quantum Memories from Classical Stochastic Processes, arXiv:2610.05589 (PDF of 2026-11-03), Definition 2.1, eqs. (2)–(3), p. 13 (PDF p. 15); Definition 2.2, eq. (4), p. 14 (PDF p. 16)

import Mathlib
import Definitions.Def_AutoQMem_Lindblad_pauliX
import Definitions.Def_AutoQMem_Lindblad_pauliZ
open Matrix

namespace AutoQMem.Lindblad

/-- **CSS code given by parity-check matrices.** Drechsler, Oreg, Aharonov, *Autonomous Quantum Memories from Classical Stochastic Processes*,
arXiv:2610.05589 (PDF of 2026-11-03), Definition 2.1, p. 13 (PDF 15):
"Let H_X ∈ 𝔽₂^{m_X×n} and H_Z ∈ 𝔽₂^{m_Z×n} be parity-check matrices satisfying the CSS compatibility
condition H_X H_Zᵀ = 0 … The rows of these matrices are permitted to be linearly dependent."

**Formalization Note.** No rank condition is imposed; rows may be dependent or zero. -/
structure CSSCode (n mX mZ : ℕ) : Type where
  /-- The X parity-check matrix `H_X` (its rows give the X-type stabilizers). -/
  HX : Matrix (Fin mX) (Fin n) (ZMod 2)
  /-- The Z parity-check matrix `H_Z` (its rows give the Z-type stabilizers). -/
  HZ : Matrix (Fin mZ) (Fin n) (ZMod 2)
  /-- The CSS compatibility condition `H_X H_Zᵀ = 0`. -/
  css : HX * HZᵀ = 0

namespace CSSCode

variable {n mX mZ : ℕ}

/-- The X-type stabilizer generator `S^X_a = X^{(row a of H_X)}` (Definition 2.1, eq. (2)).

**Formalization Note.** The paper names the generating set `S_X = {S^X_1, …, S^X_{m_X}}` of the
code "defined by" `H_X`; the generator `S^X_a` is the X-type Pauli string on the support of row
`a` of `H_X`, with no phase. -/
def stabX (C : CSSCode n mX mZ) (a : Fin mX) : Op n := pauliX (C.HX a)

/-- The Z-type stabilizer generator `S^Z_b = Z^{(row b of H_Z)}` (Definition 2.1, eq. (2)). -/
noncomputable def stabZ (C : CSSCode n mX mZ) (b : Fin mZ) : Op n := pauliZ (C.HZ b)

/-- The X stabilizer algebra `A_X := Alg(S_X)` (Definition 2.1). -/
def algX (C : CSSCode n mX mZ) : Subalgebra ℂ (Op n) := Algebra.adjoin ℂ (Set.range C.stabX)

/-- The Z stabilizer algebra `A_Z := Alg(S_Z)` (Definition 2.1). -/
noncomputable def algZ (C : CSSCode n mX mZ) : Subalgebra ℂ (Op n) :=
  Algebra.adjoin ℂ (Set.range C.stabZ)

/-- The full stabilizer algebra `A := Alg(S_X ∪ S_Z)` (Definition 2.1). -/
noncomputable def alg (C : CSSCode n mX mZ) : Subalgebra ℂ (Op n) :=
  Algebra.adjoin ℂ (Set.range C.stabX ∪ Set.range C.stabZ)

/-- The classical component code `C_X := ker H_X` (Definition 2.1). -/
def codeX (C : CSSCode n mX mZ) : Submodule (ZMod 2) (Fin n → ZMod 2) :=
  LinearMap.ker (Matrix.toLin' C.HX)

/-- The classical component code `C_Z := ker H_Z` (Definition 2.1). -/
def codeZ (C : CSSCode n mX mZ) : Submodule (ZMod 2) (Fin n → ZMod 2) :=
  LinearMap.ker (Matrix.toLin' C.HZ)

/-- The valid X-syndromes `Σ_X := im H_X` (Definition 2.2, p. 14), as a finite set. -/
def synX (C : CSSCode n mX mZ) : Finset (Fin mX → ZMod 2) :=
  Finset.univ.image C.HX.mulVec

/-- The valid Z-syndromes `Σ_Z := im H_Z` (Definition 2.2, p. 14), as a finite set. -/
def synZ (C : CSSCode n mX mZ) : Finset (Fin mZ → ZMod 2) :=
  Finset.univ.image C.HZ.mulVec

end CSSCode

end AutoQMem.Lindblad


