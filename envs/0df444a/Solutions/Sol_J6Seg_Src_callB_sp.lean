section
-- Source module: Solutions.KFDBase
/-!
# KFD base: fine compilation of register programs

The register programs `RS` of KIL1–KIL6 are compiled by `RS.code`, whose counted loop
`rep i n b` keeps a *binary* counter on `i` and decrements it in every iteration (cost
`Θ(zsz n)` per iteration).  `fcode` compiles the same program with a *unary* counter instead:

* `rep i n b ↦ push i n; toUL i i; loop i isMk (unmark i; fcode b); drop i`

(the value `n` stays below the `n` marks as a sentinel; `toUL` is the linear binary → unary
conversion of `KFCUnary`).  Everything else is compiled as by `RS.code`.

`fcode_runs` (**simulation**): if `p.ok s` and every loop body leaves its counter alone
(`FOK p`: the counter is not *touched* — read or written — by the body, and avoids the
`toUL` scratch stacks `26 … 29`), then `fcode p` realises `p.run` with the cost `fcost p s`.
The run is proved relative to a set of *ghost* stacks (the counters of the enclosing loops,
which hold marks in the fine run and the binary count in the `RS` semantics).

`fcost_le_cost`: `fcost p s ≤ 100 · p.cost s` (coarse transfer of every `KIL` cost bound).
The point of `fcost` is the loop: per iteration it charges `fcost b + 31` plus the amortised
`toUL` cost, i.e. `O(1)` overhead per iteration, independent of the size of the count.

`FSp p s t c` is the fine analogue of `KIL.Sp`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KFC (marks marks_zero isMk NM toUL cUL uK uR uY uB)

/-! ## Expression congruence -/

theorem top_congr {s t : IState HS} {i : Fin HS} (h : s.G i = t.G i) : s.top i = t.top i := by
  simp [IState.top, h]

theorem isInt_congr {s t : IState HS} {i : Fin HS} (h : s.G i = t.G i) :
    s.IsInt i ↔ t.IsInt i := by
  simp [IState.IsInt, top_congr h, h]

theorem eval_congr {s t : IState HS} : ∀ (e : Ex HS), (∀ i ∈ e.regs, s.G i = t.G i) →
    e.eval s = e.eval t
  | .reg i, h => top_congr (h i (by simp [Ex.regs]))
  | .lit _, _ => rfl
  | .add a b, h | .mul a b, h | .shl a b, h | .quo a b, h | .rem a b, h | .ndiv a b, h
  | .nmod a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.eval, eval_congr a (fun i hi => h i (Or.inl hi)),
      eval_congr b (fun i hi => h i (Or.inr hi))]
  | .neg a, h | .pow2 a, h => by
    simp only [Ex.regs] at h
    simp only [Ex.eval, eval_congr a h]
  | .sel c x y, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.eval, eval_congr c (fun i hi => h i (Or.inl (Or.inl hi))),
      eval_congr x (fun i hi => h i (Or.inl (Or.inr hi))),
      eval_congr y (fun i hi => h i (Or.inr hi))]

theorem ok_congr {s t : IState HS} : ∀ (e : Ex HS), (∀ i ∈ e.regs, s.G i = t.G i) →
    (e.ok s ↔ e.ok t)
  | .reg i, h => isInt_congr (h i (by simp [Ex.regs]))
  | .lit _, _ => Iff.rfl
  | .add a b, h | .mul a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.ok, ok_congr a (fun i hi => h i (Or.inl hi)),
      ok_congr b (fun i hi => h i (Or.inr hi))]
  | .shl a b, h | .quo a b, h | .rem a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.ok, ok_congr a (fun i hi => h i (Or.inl hi)),
      ok_congr b (fun i hi => h i (Or.inr hi)), eval_congr b (fun i hi => h i (Or.inr hi))]
  | .ndiv a b, h | .nmod a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.ok, ok_congr a (fun i hi => h i (Or.inl hi)),
      ok_congr b (fun i hi => h i (Or.inr hi)), eval_congr a (fun i hi => h i (Or.inl hi)),
      eval_congr b (fun i hi => h i (Or.inr hi))]
  | .neg a, h => by
    simp only [Ex.regs] at h
    simp only [Ex.ok, ok_congr a h]
  | .pow2 a, h => by
    simp only [Ex.regs] at h
    simp only [Ex.ok, ok_congr a h, eval_congr a h]
  | .sel c x y, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.ok, ok_congr c (fun i hi => h i (Or.inl (Or.inl hi))),
      ok_congr x (fun i hi => h i (Or.inl (Or.inr hi))),
      ok_congr y (fun i hi => h i (Or.inr hi)),
      eval_congr c (fun i hi => h i (Or.inl (Or.inl hi)))]

/-! ## Touched stacks, fine compilability -/

/-! ## The fine compilation and its cost -/

