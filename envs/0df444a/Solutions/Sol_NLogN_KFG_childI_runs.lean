      (L.length * (250 * w + 2600) + 2000) := by
  refine (FSp.mvR hXY hXC hYC hX5 hY5 hC5 hr5 s f L l hX hr w (zsz (L.length : ℤ)) hL le_rfl).mono ?_
  have := cLp_self L.length (250 * (w + 2))
