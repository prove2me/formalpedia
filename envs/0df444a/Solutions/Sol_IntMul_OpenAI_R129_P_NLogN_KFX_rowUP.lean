  unfold swapPos
  rw [KFH.encode_set sh _ q _ (by simpa using hq) (by simpa using hl),
    KFH.encode_set sh a p _ hp hl]
  have : (a.set p (a.getD q 0)).getD q 0 = a.getD q 0 := by
    simp [List.getD_eq_getElem?_getD, List.getElem?_set, hpq]
