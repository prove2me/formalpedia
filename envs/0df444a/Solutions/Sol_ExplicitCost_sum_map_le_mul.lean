open ExplicitCost
open Groundwork QueryMachines Printed
variable {Q A A' α β : Type}
namespace ExplicitCost
theorem _root_.solution {w w' : Q → ℕ} {k : ℕ} (h : ∀ x, w' x ≤ k * w x) (L : List Q) : (L.map w').sum ≤ k * (L.map w).sum := by
  induction L with
  | nil => simp
  | cons x L ih =>
    have := h x
    simp only [List.map_cons, List.sum_cons, Nat.mul_add]
    omega
end ExplicitCost
