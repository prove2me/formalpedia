variable {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

omit [NumberField K] in

private theorem norm_coeff_prod_inducedFactor_le
    (c : HeightOneSpectrum (𝓞 K) → ℂ) {s : Finset (HeightOneSpectrum (𝓞 K))}
    (hc : ∀ 𝔓 ∈ s, ‖c 𝔓‖ ≤ 1) (i : ℕ) : ‖(∏ 𝔓 ∈ s, inducedFactor ℚ c 𝔓).coeff i‖ ≤ (2 : ℝ) ^ s.card := by
  classical
  induction s using Finset.induction_on generalizing i with
  | empty =>
    simp only [Finset.prod_empty, Polynomial.coeff_one, Finset.card_empty, pow_zero]
    split_ifs <;> simp
  | insert 𝔓 s h𝔓 ih =>
    have hc𝔓 : ‖c 𝔓‖ ≤ 1 := hc 𝔓 (Finset.mem_insert_self 𝔓 s)
    have ih' : ∀ j : ℕ, ‖(∏ 𝔔 ∈ s, inducedFactor ℚ c 𝔔).coeff j‖ ≤ (2 : ℝ) ^ s.card :=
      fun j => ih (fun 𝔔 h𝔔 => hc 𝔔 (Finset.mem_insert_of_mem h𝔔)) j
    rw [Finset.prod_insert h𝔓, Finset.card_insert_of_notMem h𝔓, pow_succ, inducedFactor, sub_mul,
      Polynomial.coeff_sub, mul_assoc, Polynomial.coeff_C_mul, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_mul',
      one_mul]
    have h2 : (0 : ℝ) ≤ 2 ^ s.card := by positivity
    split_ifs with hfi
    · refine (norm_sub_le _ _).trans ?_
      rw [norm_mul]
      refine (add_le_add (ih' i) (mul_le_mul hc𝔓 (ih' _) (norm_nonneg _) zero_le_one)).trans ?_
      linarith
    · rw [mul_zero, sub_zero]
      linarith [ih' i]

omit [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] in

private theorem norm_inducedCoeff_le_one
    {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} (hμ : AutomorphicForm.IsUnitaryChar (𝓞 K) K μ)
    (𝔓 : HeightOneSpectrum (𝓞 K)) : ‖inducedCoeff K μ 𝔓‖ ≤ 1 := by
  unfold inducedCoeff
  split_ifs
  · exact (hμ _).le
  · simp

end
