theorem solution (A : Type) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] (L : ℕ) :
    ∃ E : (TypeDensity.LocalCompletion A ⧸ ((IsLocalRing.maximalIdeal A).map (TypeDensity.localCompletionMap A))^L) ≃ₐ[A]
      (A ⧸ (IsLocalRing.maximalIdeal A)^L), ∀ a : A,
      E (Ideal.Quotient.mk (((IsLocalRing.maximalIdeal A).map (TypeDensity.localCompletionMap A))^L)
