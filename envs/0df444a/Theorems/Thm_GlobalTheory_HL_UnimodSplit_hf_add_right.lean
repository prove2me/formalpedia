theorem GlobalTheory.HL.UnimodSplit.hf_add_right (L : LocE F E) {n : ℕ} (Hm : Matrix (Fin n) (Fin n) E) (x y y' : Fin n → E) :
    hf L Hm x (y + y') = hf L Hm x y + hf L Hm x y' := by sorry
