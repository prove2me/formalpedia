/-- Same-label mismatch, not a minimum matching; repetitions are allowed. -/
def mismatch {n k : ℕ} (d : RationalMetric n) (u s : Configuration n k) : ℝ :=
  ∑ j, (d.distance (u j) (s j) : ℝ)

