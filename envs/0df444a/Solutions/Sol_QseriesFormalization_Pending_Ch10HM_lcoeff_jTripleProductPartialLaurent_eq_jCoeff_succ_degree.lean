      Qpow (e * (-(n + 1 : ℕ) : ℤ))
    rw [zpow_neg]
    change ((Qpow e) ^ (n + 1))⁻¹ =
      Qpow (e * (-(n + 1 : ℕ) : ℤ))
    rw [Qpow_pow_nat, Qpow_inv]
    congr 1
    ring

