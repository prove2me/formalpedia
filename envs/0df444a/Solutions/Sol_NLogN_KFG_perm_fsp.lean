  have hjL : j * L + L = (j + 1) * L := by ring
  have hiL : i * L + L = (i + 1) * L := by ring
  have hgL : (i + 1) * L + (j - i - 1) * L = j * L := by
    rw [← Nat.add_mul]; congr 1; omega
