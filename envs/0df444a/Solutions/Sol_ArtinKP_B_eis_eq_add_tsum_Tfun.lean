/-! ### The term at the class of `(0, 1)` -/

theorem Row.norm_inf : (Row.inf 𝔪).norm = 1 := by
  unfold Row.norm
  rw [Row.inf_c, Row.inf_d]
  change normS 𝔪 (0 : F) (1 : F) = 1
  rw [normS_zero_left, absS_one]

theorem tildeC_inf (Ψ : TSection ι 𝔪) (s : ℂ) : tildeC Ψ s (RowClass.inf 𝔪) = Ψ s (Row.inf 𝔪) := by
  rw [RowClass.inf, tildeC_mk, TSection.tilde, Row.norm_inf, Complex.ofReal_one, Complex.one_cpow,
    mul_one]

section inf

variable [IsTotallyComplex F]

theorem RowClass.ht_inf (h𝔪 : 𝔪 ≠ ⊥) (Q : X F) : (RowClass.inf 𝔪).ht Q = X.ht Q := by
  rw [RowClass.inf, RowClass.ht_mk h𝔪, sHt_row, Row.norm_inf, div_one]
  exact X.pairHt_zero_one Q

/-- The term of the series at the class of `(0, 1)`: `Ψ_s(0,1) · ht(Q)^s`. -/
theorem term_out_inf (h𝔪 : 𝔪 ≠ ⊥) (Ψ : TSection ι 𝔪) (s : ℂ) (Q : X F) :
    term (Ψ s) s Q (RowClass.inf 𝔪).out = Ψ s (Row.inf 𝔪) * ((X.ht Q : ℝ) : ℂ) ^ s := by
  rw [term_out_eq, tildeC_inf, RowClass.ht_inf h𝔪]

open scoped Classical in
/-- **MATH2 §0.2**: `E_Ψ(Q, s) = Ψ_s(0,1) ht(Q)^s + ∑_{q ≠ ∞} Ψ̃_s(q) ht_q(Q)^s` for `Re s > 2`. -/
theorem eis_eq_add (h𝔪 : 𝔪 ≠ ⊥) (Ψ : TSection ι 𝔪) {s : ℂ} (hs : 2 < s.re) (Q : X F) :
    eis Ψ s Q = Ψ s (Row.inf 𝔪) * ((X.ht Q : ℝ) : ℂ) ^ s
      + ∑' q : {q : RowClass 𝔪 // q ≠ RowClass.inf 𝔪},
          tildeC Ψ s q.1 * ((q.1.ht Q : ℝ) : ℂ) ^ s := by
  have hsum := summable_term h𝔪 Ψ hs Q
  rw [eis_def, hsum.tsum_eq_add_tsum_ite (RowClass.inf 𝔪), term_out_inf h𝔪]
  congr 1
  refine Eq.trans ?_ (tsum_subtype {q : RowClass 𝔪 | q ≠ RowClass.inf 𝔪}
    (fun q => tildeC Ψ s q * ((q.ht Q : ℝ) : ℂ) ^ s)).symm
  refine tsum_congr fun q => ?_
  by_cases h : q = RowClass.inf 𝔪
  · simp [h]
  · simp [h, term_out_eq]

end inf

end ArtinKP.B
end
end

section
-- module Solutions.Artin.KP.B_FourRows
attribute [-instance] _root_.ArtinKP.X.instContinuousConstSMulSubgroup _root_.ArtinKP.X.instIsFiniteMeasureOnCompactsXVol _root_.ArtinKP.X.instIsFiniteMeasureXRestrictVolBox
attribute [-simp] _root_.ArtinKP.RO.rowClassEquiv_mk _root_.ArtinKP.RO.rowPair_c _root_.ArtinKP.RO.rowPair_d _root_.ArtinKP.X.chart_apply _root_.ArtinKP.X.chart_symm_apply
/-!
# WP-B, part 5: the Eisenstein series as a sum over `(c mod units, d ∈ R)`

`Tfun Φ s Q c d = (d/c)⁻¹ Φ_s(c, d) I_{(c,d)}(Q)^s` for all `c, d ∈ R` (zero unless `d` is prime
to `c`).  For `Re s > 2`:

`eis (twist Φ) s Q = Φ_s(0, 1) ht(Q)^s + ∑_{(a, d) ∈ (R∖0)/Rˣ × R} Tfun Φ s Q c_a d`
(`eis_eq_add_tsum_Tfun`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open scoped MatrixGroups ComplexConjugate
open NumberField IsDedekindDomain ArtinPrimitiveRoots

noncomputable section

namespace ArtinKP.B

open ArtinKP.A ArtinKP.S ArtinKP.X ArtinKP.B1 ArtinKP.E

variable {F : Type*} [Field F] [NumberField F] {𝔪 : Ideal (𝓞 F)}
  {ι : F →+* ℂ} {P : CubicPkg F}

section

variable (hG : Good 𝔪) {z6 : 𝓞 F} (hz6 : IsPrimitiveRoot z6 6) (Φ : GSection ι P 𝔪)

theorem Tfun_row (s : ℂ) (Q : X F) (p : Row 𝔪) (hc : p.c ≠ 0) :
    Tfun Φ s Q p.c p.d = term (Φ.twist hG hz6 s) s Q p := by
  rw [term, GSection.twist_apply, kappaRow, if_neg hc]
  rfl

include hG hz6 in
theorem Tfun_eq_zero (s : ℂ) (Q : X F) {c d : SInt 𝔪} (hc : c ≠ 0) (h : ¬ IsCoprime d c) :
    Tfun Φ s Q c d = 0 := by
  rw [Tfun, (S2.cubicExt_eq_zero_iff ι P hG hz6 d c hc).mpr h]
  simp

theorem jFun_spec (q : {q : RowClass 𝔪 // q ≠ RowClass.inf 𝔪}) :
    ∃ ε : (SInt 𝔪)ˣ, (ε • q.1.out).c = rp (jFun q).1.1 ∧ (ε • q.1.out).d = (jFun q).2 :=
  ⟨(exists_unit_mul_eq_rp q.1.out.c).choose, (exists_unit_mul_eq_rp q.1.out.c).choose_spec, rfl⟩

theorem jFun_injective : Function.Injective (jFun (𝔪 := 𝔪)) := by
  intro q q' h
  obtain ⟨ε, h1, h2⟩ := jFun_spec q
  obtain ⟨ε', h1', h2'⟩ := jFun_spec q'
  have e : ε • q.1.out = ε' • q'.1.out := Row.ext (by rw [h1, h1', h]) (by rw [h2, h2', h])
  apply Subtype.ext
  rw [← RowClass.mk_out q.1, ← RowClass.mk_out q'.1, ← RowClass.mk_smul ε, e, RowClass.mk_smul]

include hG hz6 in
theorem Tfun_jFun [IsTotallyComplex F] (s : ℂ) (Q : X F)
    (q : {q : RowClass 𝔪 // q ≠ RowClass.inf 𝔪}) :
    Tfun Φ s Q (rp (jFun q).1.1) (jFun q).2 = term (Φ.twist hG hz6 s) s Q q.1.out := by
  obtain ⟨ε, h1, h2⟩ := jFun_spec q
  have hc : (ε • q.1.out).c ≠ 0 := by
    rw [h1]
    exact rp_ne_zero (jFun q).1.2
  rw [← h1, ← h2, Tfun_row hG hz6 Φ s Q _ hc]
  exact term_smul hG.ne_bot ((Φ.twist hG hz6).isHom s) ε _ Q

include hG hz6 in
theorem support_Tfun_subset (s : ℂ) (Q : X F) :
    Function.support (fun x : Cls (SInt 𝔪) × SInt 𝔪 => Tfun Φ s Q (rp x.1.1) x.2)
      ⊆ Set.range (jFun (𝔪 := 𝔪)) := by
  rintro ⟨a, d⟩ hx
  have ha := rp_ne_zero a.2
  have hcop : IsCoprime (rp a.1) d := by
    by_contra hn
    exact hx (Tfun_eq_zero hG hz6 Φ s Q ha fun h => hn h.symm)
  set p₀ : Row 𝔪 := ⟨(rp a.1, d), hcop⟩ with hp₀
  have hq : RowClass.mk p₀ ≠ RowClass.inf 𝔪 := by
    intro h
    obtain ⟨ε, hε⟩ := RowClass.mk_eq_mk_iff.mp h
    have : p₀.c = 0 := by rw [hε]; simp
    exact ha this
  refine ⟨⟨RowClass.mk p₀, hq⟩, ?_⟩
  obtain ⟨ε, hε⟩ := RowClass.exists_out_eq_smul p₀
  obtain ⟨u, h1, h2⟩ := jFun_spec ⟨RowClass.mk p₀, hq⟩
  have hc : (RowClass.mk p₀).out.c = (ε : SInt 𝔪) * rp a.1 := by rw [hε]; rfl
  have hd : (RowClass.mk p₀).out.d = (ε : SInt 𝔪) * d := by rw [hε]; rfl
  have hfst : (jFun ⟨RowClass.mk p₀, hq⟩).1 = a := by
    apply Subtype.ext
    change Associates.mk (RowClass.mk p₀).out.c = a.1
    rw [hc]
    conv_rhs => rw [← mk_rp a.1]
    exact Associates.mk_eq_mk_iff_associated.mpr
      ⟨ε⁻¹, by rw [mul_comm, ← mul_assoc, Units.inv_mul, one_mul]⟩
  have hu : (u : SInt 𝔪) * (ε : SInt 𝔪) = 1 := by
    have h3 : (u : SInt 𝔪) * ((ε : SInt 𝔪) * rp a.1) = rp a.1 := by
      have := h1
      rw [hfst] at this
      rw [← hc]
      exact this
    have h4 : ((u : SInt 𝔪) * (ε : SInt 𝔪)) * rp a.1 = 1 * rp a.1 := by
      rw [one_mul, mul_assoc, h3]
    exact mul_right_cancel₀ ha h4
  refine Prod.ext hfst ?_
  rw [← h2]
  change (u : SInt 𝔪) * (RowClass.mk p₀).out.d = d
  rw [hd, ← mul_assoc, hu, one_mul]

include hG hz6 in
/-- The sum over the classes of rows with `c ≠ 0`, as a sum over `(R∖0)/Rˣ × R`. -/
theorem tsum_ne_inf_eq [IsTotallyComplex F] (s : ℂ) (Q : X F) :
    ∑' q : {q : RowClass 𝔪 // q ≠ RowClass.inf 𝔪}, term (Φ.twist hG hz6 s) s Q q.1.out
      = ∑' x : Cls (SInt 𝔪) × SInt 𝔪, Tfun Φ s Q (rp x.1.1) x.2 := by
  rw [← jFun_injective.tsum_eq (support_Tfun_subset hG hz6 Φ s Q)]
  exact tsum_congr fun q => (Tfun_jFun hG hz6 Φ s Q q).symm

include hG hz6 in
/-- `E(Q) = Φ_s(0,1) ht(Q)^s + ∑_{(a,d)} Tfun`. -/
theorem eis_eq_add_tsum_Tfun_oai [IsTotallyComplex F] {s : ℂ} (hs : 2 < s.re) (Q : X F) :
    eis (Φ.twist hG hz6) s Q = Φ s 0 1 * ((X.ht Q : ℝ) : ℂ) ^ s
      + ∑' x : Cls (SInt 𝔪) × SInt 𝔪, Tfun Φ s Q (rp x.1.1) x.2 := by
  rw [eis_eq_add hG.ne_bot _ hs Q, ← tsum_ne_inf_eq hG hz6 Φ s Q]
  congr 1
  · rw [GSection.twist_apply, kappaRow, if_pos (Row.inf_c)]
    simp
  · exact tsum_congr fun q => (term_out_eq _ s Q q.1).symm

end

end ArtinKP.B
end
end

theorem solution.{u_1} : type_of% @ArtinKP.B.eis_eq_add_tsum_Tfun_oai.{u_1} := @ArtinKP.B.eis_eq_add_tsum_Tfun_oai.{u_1}
