    simp only [G]; rw [upd_ne (by decide), segFR_rA]
  have gU : G rU = (u / ru ^ k) :: (F rU).tail := by
    simp only [G]; rw [upd_ne (by decide), segFR_rU]
  have gV : G rV = (v / rv ^ k) :: (F rV).tail := by
    simp only [G]; rw [upd_ne (by decide), segFR_rV]
  have gW : G rW = (w * rw ^ k) :: (F rW).tail := by
