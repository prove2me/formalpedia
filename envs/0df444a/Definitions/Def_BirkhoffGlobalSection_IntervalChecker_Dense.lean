-- title:
--   Dyadic scalars and centred-form enclosures of dense polynomials
-- statement:
--   Instantiates the checker of `BirkhoffGlobalSection_IntervalChecker`. Scalars `Dy` are dyadic rationals $m\cdot 2^{-e}$ ($m\in\mathbb Z$, $e\in\mathbb N$) with exact arithmetic, so interval operations are exact and computable in the kernel. Polynomials `NP n` are stored densely (nested coefficient lists in $n$ variables); `ofFlat` converts a list of monomials. The centred-form enclosure `centredEnc` shifts a polynomial to the midpoint of the box (Taylor shift) and bounds each shifted monomial by interval arithmetic on the half-widths. Includes `eval_ofFlat` (dense and flat evaluation agree) and `centredEnc_sound` (the enclosure is sound).
-- source:
--   Joung–van Koert, https://arxiv.org/abs/2407.19159v3, Proposition 4.4 (the radial-derivative part of the convexity argument, verified there by interval arithmetic); certificate generated by numerics/phase3/cert_to_lean.py.

import Definitions.Def_BirkhoffGlobalSection_IntervalChecker

/-!
# Scalar instances for the checker: `ℚ` and dyadic numbers

* `ℚ`: exact rationals (every operation normalizes by a `gcd`).
* `Dy`: dyadic numbers `m / 2^e` with `m : ℤ`, `e : ℕ`. Addition aligns exponents, multiplication
  adds them; no `gcd` and no normalization. Powers of two are computed with `Nat.pow`, which
  the kernel evaluates with GMP.
-/

namespace BirkhoffGlobalSection.TangentialHessian.Checker

/-! ## Rationals -/

noncomputable instance : CNum ℚ where
  add := (· + ·)
  mul := (· * ·)
  neg := (- ·)
  zero := 0
  one := 1
  natCast := fun n => n
  half := fun q => q / 2
  ble := fun a b => decide (a ≤ b)
  toReal := fun q => q
  toReal_add := fun a b => Rat.cast_add a b
  toReal_mul := fun a b => Rat.cast_mul a b
  toReal_neg := fun a => Rat.cast_neg a
  toReal_zero := Rat.cast_zero
  toReal_one := Rat.cast_one
  toReal_natCast := fun n => Rat.cast_natCast n
  toReal_half := fun a => by push_cast; ring
  ble_iff := fun a b => by simp [Rat.cast_le]

/-! ## Dyadic numbers -/

/-- The dyadic number `m / 2^e`. -/
structure Dy where
  m : ℤ
  e : ℕ

namespace Dy

/-- `2^k` as an integer, via `Nat.pow` (GMP-accelerated in the kernel). -/
def two (k : ℕ) : ℤ := ((2 ^ k : ℕ) : ℤ)

theorem two_cast (k : ℕ) : ((two k : ℤ) : ℝ) = (2 : ℝ) ^ k := by simp [two]

noncomputable def toReal (a : Dy) : ℝ := (a.m : ℝ) / (2 : ℝ) ^ a.e

def add (a b : Dy) : Dy :=
  if a.e ≤ b.e then ⟨a.m * two (b.e - a.e) + b.m, b.e⟩ else ⟨a.m + b.m * two (a.e - b.e), a.e⟩

def mul (a b : Dy) : Dy := ⟨a.m * b.m, a.e + b.e⟩

def neg (a : Dy) : Dy := ⟨-a.m, a.e⟩

def ble (a b : Dy) : Bool :=
  if a.e ≤ b.e then decide (a.m * two (b.e - a.e) ≤ b.m) else decide (a.m ≤ b.m * two (a.e - b.e))

theorem toReal_add (a b : Dy) : toReal (add a b) = toReal a + toReal b := by
  unfold add toReal
  split
  · rename_i h
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le h
    simp only [hk, Nat.add_sub_cancel_left, Int.cast_add, Int.cast_mul, two_cast, pow_add]
    field_simp
  · rename_i h
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le (le_of_lt (not_le.mp h))
    simp only [hk, Nat.add_sub_cancel_left, Int.cast_add, Int.cast_mul, two_cast, pow_add]
    field_simp

theorem toReal_mul (a b : Dy) : toReal (mul a b) = toReal a * toReal b := by
  unfold mul toReal; push_cast; rw [pow_add]; field_simp

theorem ble_iff (a b : Dy) : ble a b = true ↔ toReal a ≤ toReal b := by
  unfold ble toReal
  split
  · rename_i h
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le h
    simp only [hk, Nat.add_sub_cancel_left, decide_eq_true_eq, pow_add]
    rw [div_le_div_iff₀ (by positivity) (by positivity), ← Int.cast_le (R := ℝ)]
    push_cast [two_cast]
    constructor
    · intro h'; nlinarith [pow_pos (two_pos : (0 : ℝ) < 2) a.e]
    · intro h'
      have hpos : (0 : ℝ) < 2 ^ a.e := by positivity
      nlinarith
  · rename_i h
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le (le_of_lt (not_le.mp h))
    simp only [hk, Nat.add_sub_cancel_left, decide_eq_true_eq, pow_add]
    rw [div_le_div_iff₀ (by positivity) (by positivity), ← Int.cast_le (R := ℝ)]
    push_cast [two_cast]
    constructor
    · intro h'; nlinarith [pow_pos (two_pos : (0 : ℝ) < 2) b.e]
    · intro h'
      have hpos : (0 : ℝ) < 2 ^ b.e := by positivity
      nlinarith

end Dy

noncomputable instance : CNum Dy where
  add := Dy.add
  mul := Dy.mul
  neg := Dy.neg
  zero := ⟨0, 0⟩
  one := ⟨1, 0⟩
  natCast := fun n => ⟨n, 0⟩
  half := fun a => ⟨a.m, a.e + 1⟩
  ble := Dy.ble
  toReal := Dy.toReal
  toReal_add := Dy.toReal_add
  toReal_mul := Dy.toReal_mul
  toReal_neg := fun a => by simp [Dy.neg, Dy.toReal, neg_div]
  toReal_zero := by simp [Dy.toReal]
  toReal_one := by simp [Dy.toReal]
  toReal_natCast := fun n => by simp [Dy.toReal]
  toReal_half := fun a => by simp [Dy.toReal, pow_succ]; field_simp
  ble_iff := Dy.ble_iff

end BirkhoffGlobalSection.TangentialHessian.Checker

namespace BirkhoffGlobalSection.TangentialHessian.Checker

/-- Dyadic literals as reals (for linking certificate data to explicit polynomials). -/
@[simp] theorem Dy.cnum_toReal_mk (m : ℤ) (e : ℕ) :
    CNum.toReal (⟨m, e⟩ : Dy) = (m : ℝ) / 2 ^ e := rfl

end BirkhoffGlobalSection.TangentialHessian.Checker

/-!
# Dense recursive polynomials and the centred-form enclosure

`NP α n` is a polynomial in `n` variables: a scalar for `n = 0`, and for `n + 1` the list of
its coefficients `[c₀, c₁, …]` in the first variable (`Σ cₖ x₀ᵏ`), each in `NP α n`.

The **centred-form enclosure** of `p` over a box `B` with midpoints `m` re-expands `p` exactly
around `m` (Taylor shift, variable by variable, via `c + (m + t) q(t)`; no binomials and no
merging of monomials) and evaluates the result on the centred box `B - m` in the power basis,
with the exact even-power rule. Constant and linear Taylor coefficients are therefore exact;
only terms of order `≥ 2` in the half-widths are overestimated.
-/

namespace BirkhoffGlobalSection.TangentialHessian.Checker

open CNum

variable {α : Type} [CNum α]

/-- Dense recursive polynomials in `n` variables. -/
def NP (α : Type) : ℕ → Type
  | 0 => α
  | n + 1 => List (NP α n)

/-- Pointwise sum of two coefficient lists (the shorter one is padded with zeros). -/
def addList {β : Type} (f : β → β → β) : List β → List β → List β
  | a :: as, b :: bs => f a b :: addList f as bs
  | [], bs => bs
  | as, [] => as

namespace NP

/-- Literal constructors (used by generated certificate data). -/
def ofScalar (a : α) : NP α 0 := a

def ofList (n : ℕ) (l : List (NP α n)) : NP α (n + 1) := l

def zero : (n : ℕ) → NP α n
  | 0 => (CNum.zero : α)
  | _ + 1 => ([] : List _)

def add : (n : ℕ) → NP α n → NP α n → NP α n
  | 0, a, b => CNum.add (α := α) a b
  | n + 1, as, bs => addList (add n) (as : List (NP α n)) bs

def scale : (n : ℕ) → α → NP α n → NP α n
  | 0, c, a => CNum.mul (α := α) c a
  | n + 1, c, as => (as : List (NP α n)).map (scale n c)

/-- `(m + t) ↦` Taylor shift of a univariate polynomial with coefficients in `NP α n`:
`c + (m + t) q(t)` where `q` is the shift of the tail. -/
def shift1 (n : ℕ) (m : α) : List (NP α n) → List (NP α n)
  | [] => []
  | c :: cs =>
    let q := shift1 n m cs
    addList (add n) [c] (addList (add n) (q.map (scale n m)) (zero n :: q))

/-- Shift every variable: `p(x) ↦ p(m + t)` as a polynomial in `t`. -/
def shift : (n : ℕ) → List α → NP α n → NP α n
  | 0, _, c => c
  | n + 1, m :: ms, cs => shift1 n m ((cs : List (NP α n)).map (shift n ms))
  | _ + 1, [], cs => cs

/-- `Σₖ vₖ xᵏ⁺ʲ` (power basis, starting at exponent `j`). -/
def sumPowR (x : ℝ) : ℕ → List ℝ → ℝ
  | _, [] => 0
  | j, v :: vs => v * x ^ j + sumPowR x (j + 1) vs

/-- Real evaluation. -/
noncomputable def eval : (n : ℕ) → NP α n → List ℝ → ℝ
  | 0, c, _ => toReal (α := α) c
  | n + 1, cs, x :: xs => sumPowR x 0 ((cs : List (NP α n)).map (fun c => eval n c xs))
  | _ + 1, _, [] => 0

/-- Interval version of `sumPowR`. -/
def iSumPow (I : Iv α) : ℕ → List (Iv α) → Iv α
  | _, [] => (CNum.zero, CNum.zero)
  | j, v :: vs => iadd (imul v (ipow I j)) (iSumPow I (j + 1) vs)

/-- Interval evaluation in the power basis. -/
def ieval : (n : ℕ) → NP α n → List (Iv α) → Iv α
  | 0, c, _ => ((c : α), (c : α))
  | n + 1, cs, I :: Is => iSumPow I 0 ((cs : List (NP α n)).map (fun c => ieval n c Is))
  | _ + 1, _, [] => (CNum.zero, CNum.zero)

/-! ### Soundness of the evaluation -/

theorem sumPowR_succ (x : ℝ) (j : ℕ) (vs : List ℝ) :
    sumPowR x (j + 1) vs = x * sumPowR x j vs := by
  induction vs generalizing j with
  | nil => simp [sumPowR]
  | cons v vs ih => simp only [sumPowR, ih, pow_succ]; ring

theorem mem_iSumPow {x : ℝ} {I : Iv α} (hx : Mem x I) :
    ∀ (j : ℕ) (vs : List ℝ) (Is : List (Iv α)), List.Forall₂ Mem vs Is →
      Mem (sumPowR x j vs) (iSumPow I j Is)
  | _, [], [], _ => by simp [sumPowR, iSumPow, Mem]
  | j, v :: vs, J :: Js, .cons hv hrest =>
    mem_iadd (mem_imul hv (mem_ipow hx j)) (mem_iSumPow hx (j + 1) vs Js hrest)

theorem mem_ieval : ∀ (n : ℕ) (p : NP α n) (x : List ℝ) (B : List (Iv α)), InBox x B →
    Mem (eval n p x) (ieval n p B)
  | 0, c, _, _, _ => ⟨le_refl (toReal (α := α) c), le_refl (toReal (α := α) c)⟩
  | _ + 1, _, [], [], _ => by simp [eval, ieval, Mem]
  | n + 1, cs, x :: xs, I :: Is, .cons hx hrest => by
    simp only [eval, ieval]
    refine mem_iSumPow hx 0 _ _ ?_
    induction (cs : List (NP α n)) with
    | nil => exact List.Forall₂.nil
    | cons c cs ih => exact List.Forall₂.cons (mem_ieval n c xs Is hrest) ih

/-! ### Algebra of the evaluation -/

/-- Evaluation of a coefficient list in the first variable. -/
noncomputable def evalList (n : ℕ) (cs : List (NP α n)) (x : ℝ) (xs : List ℝ) : ℝ :=
  sumPowR x 0 (cs.map (fun c => eval n c xs))

theorem eval_succ (n : ℕ) (cs : NP α (n + 1)) (x : ℝ) (xs : List ℝ) :
    eval (n + 1) cs (x :: xs) = evalList n cs x xs := rfl

theorem evalList_nil (n : ℕ) (x : ℝ) (xs : List ℝ) : evalList (α := α) n [] x xs = 0 := rfl

theorem evalList_cons (n : ℕ) (c : NP α n) (cs : List (NP α n)) (x : ℝ) (xs : List ℝ) :
    evalList n (c :: cs) x xs = eval n c xs + x * evalList n cs x xs := by
  simp [evalList, sumPowR, sumPowR_succ]

theorem eval_zero : ∀ (n : ℕ) (xs : List ℝ), eval n (zero (α := α) n) xs = 0
  | 0, _ => CNum.toReal_zero (α := α)
  | _ + 1, [] => rfl
  | _ + 1, _ :: _ => rfl

theorem eval_add : ∀ (n : ℕ) (a b : NP α n) (xs : List ℝ),
    eval n (add n a b) xs = eval n a xs + eval n b xs
  | 0, a, b, _ => CNum.toReal_add (α := α) a b
  | _ + 1, _, _, [] => by simp [eval]
  | n + 1, as, bs, x :: xs => by
    show evalList n (addList (add n) as bs) x xs = evalList n as x xs + evalList n bs x xs
    induction (as : List (NP α n)) generalizing bs with
    | nil => cases bs <;> simp [addList, evalList_nil]
    | cons a as ih =>
      cases bs with
      | nil => simp [addList, evalList_nil]
      | cons b bs =>
        simp only [addList, evalList_cons, eval_add n a b xs, ih bs]
        ring

theorem evalList_addList (n : ℕ) (as bs : List (NP α n)) (x : ℝ) (xs : List ℝ) :
    evalList n (addList (add n) as bs) x xs = evalList n as x xs + evalList n bs x xs :=
  eval_add (n + 1) as bs (x :: xs)

theorem eval_scale : ∀ (n : ℕ) (c : α) (a : NP α n) (xs : List ℝ),
    eval n (scale n c a) xs = toReal c * eval n a xs
  | 0, c, a, _ => CNum.toReal_mul (α := α) c a
  | _ + 1, _, _, [] => by simp [eval]
  | n + 1, c, as, x :: xs => by
    show evalList n ((as : List (NP α n)).map (scale n c)) x xs = toReal c * evalList n as x xs
    induction (as : List (NP α n)) with
    | nil => simp [evalList_nil]
    | cons a as ih =>
      simp only [List.map_cons, evalList_cons, eval_scale n c a xs, ih]
      ring

theorem evalList_shift1 (n : ℕ) (m : α) (cs : List (NP α n)) (t : ℝ) (xs : List ℝ) :
    evalList n (shift1 n m cs) t xs = evalList n cs (toReal m + t) xs := by
  induction cs with
  | nil => simp [shift1, evalList_nil]
  | cons c cs ih =>
    have hscale : ∀ q : List (NP α n),
        evalList n (q.map (scale n m)) t xs = toReal m * evalList n q t xs := fun q =>
      eval_scale (n + 1) m q (t :: xs)
    simp only [shift1, evalList_addList, hscale, evalList_cons, evalList_nil, eval_zero, ih]
    ring

/-- Pointwise `m + t`. -/
noncomputable def addPt : List α → List ℝ → List ℝ
  | m :: ms, t :: ts => (toReal m + t) :: addPt ms ts
  | _, _ => []

theorem eval_shift : ∀ (n : ℕ) (ms : List α) (p : NP α n) (ts : List ℝ),
    ms.length = n → ts.length = n → eval n (shift n ms p) ts = eval n p (addPt ms ts)
  | 0, _, _, _, _, _ => by simp [shift, eval]
  | _ + 1, [], _, _, h, _ => by simp at h
  | _ + 1, _ :: _, _, [], _, h => by simp at h
  | n + 1, m :: ms, cs, t :: ts, hm, ht => by
    simp only [List.length_cons, Nat.add_right_cancel_iff] at hm ht
    show evalList n (shift1 n m ((cs : List (NP α n)).map (shift n ms))) t ts =
      evalList n cs (toReal m + t) (addPt ms ts)
    rw [evalList_shift1]
    unfold evalList
    have hL : ∀ L : List (NP α n), (L.map (shift n ms)).map (fun c => eval n c ts) =
        L.map (fun c => eval n c (addPt ms ts)) := fun L => by
      rw [List.map_map]; exact List.map_congr_left fun c _ => eval_shift n ms c ts hm ht
    exact congrArg (sumPowR _ 0) (hL cs)

/-! ### Conversion from flat polynomials -/

/-- The dense form of the monomial `c · ∏ xᵢ^eᵢ` (missing exponents count as `0`,
surplus exponents are ignored, as in `monoR`). -/
def mono : (n : ℕ) → α → List ℕ → NP α n
  | 0, c, _ => (c : α)
  | n + 1, c, e :: es => List.replicate e (zero n) ++ [mono n c es]
  | n + 1, c, [] => ([mono n c []] : List (NP α n))

/-- Dense form of a flat polynomial. -/
def ofFlat (n : ℕ) : Poly α → NP α n
  | [] => zero n
  | (c, es) :: p => add n (mono n c es) (ofFlat n p)

theorem sumPowR_replicate (x : ℝ) (v : ℝ) :
    ∀ (e j : ℕ), sumPowR x j (List.replicate e 0 ++ [v]) = v * x ^ (j + e)
  | 0, j => by simp [sumPowR]
  | e + 1, j => by
    simp only [List.replicate_succ, List.cons_append, sumPowR, zero_mul, zero_add]
    rw [sumPowR_replicate x v e (j + 1)]; ring_nf

theorem eval_mono : ∀ (n : ℕ) (c : α) (es : List ℕ) (x : List ℝ), x.length = n →
    eval n (mono n c es) x = toReal c * monoR es x
  | 0, c, es, [], _ => by cases es <;> simp [eval, mono, monoR]
  | 0, _, _, _ :: _, h => by simp at h
  | _ + 1, _, _, [], h => by simp at h
  | n + 1, c, e :: es, x :: xs, h => by
    simp only [List.length_cons, Nat.add_right_cancel_iff] at h
    show evalList n (List.replicate e (zero n) ++ [mono n c es]) x xs = _
    unfold evalList
    rw [List.map_append, List.map_replicate, eval_zero, List.map_singleton,
      sumPowR_replicate, eval_mono n c es xs h]
    simp [monoR]; ring
  | n + 1, c, [], x :: xs, h => by
    simp only [List.length_cons, Nat.add_right_cancel_iff] at h
    show evalList n [mono n c []] x xs = _
    rw [evalList_cons, evalList_nil, eval_mono n c [] xs h]
    simp [monoR]

theorem eval_ofFlat (n : ℕ) (p : Poly α) (x : List ℝ) (h : x.length = n) :
    eval n (ofFlat n p) x = evalR p x := by
  induction p with
  | nil => simp [ofFlat, eval_zero, evalR]
  | cons m p ih =>
    obtain ⟨c, es⟩ := m
    simp [ofFlat, eval_add, eval_mono n c es x h, ih, evalR]

/-! ### The centred-form enclosure -/

/-- A dense polynomial together with its number of variables. -/
structure DPoly (α : Type) where
  n : ℕ
  p : NP α n

noncomputable def DPoly.eval (q : DPoly α) (x : List ℝ) : ℝ := NP.eval q.n q.p x

/-- Centred box `B - mid B`. -/
def centre (B : List (Iv α)) : List (Iv α) :=
  B.map fun I => (sub I.1 (mid I), sub I.2 (mid I))

/-- The centred-form enclosure; `none` if the box has the wrong dimension. -/
def centredEnc (q : DPoly α) (B : List (Iv α)) : Option (Iv α) :=
  if B.length = q.n then some (ieval q.n (shift q.n (B.map mid) q.p) (centre B)) else none

/-- The centred offsets `x - mid B`. -/
noncomputable def offsets : List ℝ → List (Iv α) → List ℝ
  | x :: xs, I :: Is => (x - toReal (mid I)) :: offsets xs Is
  | _, _ => []

theorem offsets_spec : ∀ (x : List ℝ) (B : List (Iv α)), InBox x B →
    InBox (offsets x B) (centre B) ∧ addPt (B.map mid) (offsets x B) = x ∧
      (offsets x B).length = B.length
  | [], [], _ => by simp [offsets, centre, addPt, InBox]
  | x :: xs, I :: Is, .cons hx hrest => by
    obtain ⟨h1, h2, h3⟩ := offsets_spec xs Is hrest
    refine ⟨List.Forall₂.cons ?_ h1, ?_, by simp [offsets, h3]⟩
    · unfold Mem at hx ⊢; simp only [toReal_sub]; constructor <;> linarith [hx.1, hx.2]
    · simp only [offsets, List.map_cons, addPt, h2]; congr 1; ring

theorem centredEnc_sound : EnclSound (α := α) DPoly.eval centredEnc := by
  intro q x B I hx h
  unfold centredEnc at h
  split at h
  · rename_i hlen
    simp only [Option.some.injEq] at h
    subst h
    obtain ⟨hoff, hadd, hlen'⟩ := offsets_spec x B hx
    have hm := mem_ieval q.n (shift q.n (B.map mid) q.p) _ _ hoff
    rw [eval_shift q.n _ q.p _ (by simp [hlen]) (by rw [hlen', hlen]), hadd] at hm
    exact hm
  · simp at h

end NP

end BirkhoffGlobalSection.TangentialHessian.Checker


