      rw [row_prefix a ha p,row_prefix b hb p]
      exact Finset.sum_congr rfl (fun k _ => hx _)

def index {m : ℕ} [NeZero m] (i : ZMod m) : Fin m := ⟨i.val,i.val_lt⟩

lemma index_cast {m : ℕ} [NeZero m] (i : Fin m) : index ((i.val : ℕ) : ZMod m) = i := by
  apply Fin.ext
  exact ZMod.val_cast_of_lt i.isLt

def permutationState {m : ℕ} [NeZero m] (σ : Equiv.Perm (Fin m)) (p : ZMod m × ZMod m) : GridState :=
  ⟨(if σ (index p.1) = index p.2 then 1 else 0,
      if (σ.symm (index p.2)).val < p.1.val then 1 else 0,
      if (σ (index p.1)).val < p.2.val then 1 else 0),by
    by_cases hx : σ (index p.1) = index p.2
    · right
      have hinv : σ.symm (index p.2) = index p.1 := by rw [← hx,Equiv.symm_apply_apply]
      rw [if_pos hx,hinv,hx]
      simp only [index,lt_self_iff_false,if_false]
    · left; simp [hx]⟩

lemma val_bit (p : Prop) [Decidable p] : (if p then (1 : Fin 2) else 0).val = if p then 1 else 0 := by
  split_ifs <;> rfl

lemma permutationState_x {m : ℕ} [NeZero m] (σ : Equiv.Perm (Fin m)) (p : ZMod m × ZMod m) :
    (permutationState σ p).1.1.val = if (σ (index p.1)).val = p.2.val then 1 else 0 := by
  change (if σ (index p.1) = index p.2 then (1 : Fin 2) else 0).val = _
  rw [val_bit]
  congr 1
  exact propext Fin.ext_iff

lemma permutationState_x_inv {m : ℕ} [NeZero m] (σ : Equiv.Perm (Fin m)) (p : ZMod m × ZMod m) :
    (permutationState σ p).1.1.val = if (σ.symm (index p.2)).val = p.1.val then 1 else 0 := by
  change (if σ (index p.1) = index p.2 then (1 : Fin 2) else 0).val = _
  rw [val_bit]
  have he : σ (index p.1) = index p.2 ↔ σ.symm (index p.2) = index p.1 := by
    rw [Equiv.symm_apply_eq]
    exact eq_comm
  simp only [he]
  congr 1
  exact propext Fin.ext_iff

lemma permutationState_p {m : ℕ} [NeZero m] (σ : Equiv.Perm (Fin m)) (p : ZMod m × ZMod m) :
    (permutationState σ p).1.2.1.val = if (σ.symm (index p.2)).val < p.1.val then 1 else 0 := by
  exact val_bit _

lemma permutationState_q {m : ℕ} [NeZero m] (σ : Equiv.Perm (Fin m)) (p : ZMod m × ZMod m) :
    (permutationState σ p).1.2.2.val = if (σ (index p.1)).val < p.2.val then 1 else 0 := by
  exact val_bit _

lemma indicator_succ (t k : ℕ) :
    (if t < k+1 then (1 : ℕ) else 0) = (if t < k then 1 else 0) + (if t = k then 1 else 0) := by
  split_ifs <;> omega

lemma indicator_last (m t : ℕ) (ht : t < m) :
    (if t < m-1 then (1 : ℕ) else 0) + (if t = m-1 then 1 else 0) = 1 := by
  split_ifs <;> omega

lemma val_next {m : ℕ} [NeZero m] (i : ZMod m) (hi : i.val < m-1) :
    (i+1).val = i.val+1 := by
  have h := ZMod.val_cast_of_lt (n := m) (a := i.val+1) (by omega)
  simpa only [Nat.cast_add,Nat.cast_one,ZMod.natCast_zmod_val] using h

theorem permutationState_valid {m : ℕ} [NeZero m] (σ : Equiv.Perm (Fin m)) :
    Valid (permutationState σ) := by
  intro p
  refine ⟨?_,?_,?_,?_,?_,?_⟩
  · intro h
    rw [permutationState_p,h]
    simp
  · intro h
    rw [permutationState_q,h]
    simp
  · intro h
    rw [permutationState_p,permutationState_p,permutationState_x_inv]
    simpa only [gridRight,val_next p.1 h] using
      indicator_succ (σ.symm (index p.2)).val p.1.val
  · intro h
    rw [permutationState_q,permutationState_q,permutationState_x]
    simpa only [gridDown,val_next p.2 h] using
      indicator_succ (σ (index p.1)).val p.2.val
  · intro h
    rw [permutationState_p,permutationState_x_inv,h]
    exact indicator_last m _ (σ.symm (index p.2)).isLt
  · intro h
    rw [permutationState_q,permutationState_x,h]
    exact indicator_last m _ (σ (index p.1)).isLt

lemma permutationState_x_fin {m : ℕ} [NeZero m] (σ : Equiv.Perm (Fin m)) (i j : Fin m) :
    (permutationState σ ((i.val : ZMod m),(j.val : ZMod m))).1.1.val =
      if σ i = j then 1 else 0 := by
  change (if σ (index (i.val : ZMod m)) = index (j.val : ZMod m) then (1 : Fin 2) else 0).val = _
  rw [index_cast,index_cast,val_bit]

theorem permutationState_bijective {m : ℕ} [NeZero m] :
    Function.Bijective (fun σ : Equiv.Perm (Fin m) =>
      (⟨permutationState σ,permutationState_valid σ⟩ : {a // Valid a})) := by
  constructor
  · intro σ τ h
    apply Equiv.ext
    intro i
    have hx := congrArg (fun a : {a : (ZMod m × ZMod m) → GridState // Valid a} =>
      (a.val ((i.val : ZMod m),((σ i).val : ZMod m))).1.1.val) h
    simp only [permutationState_x_fin,if_pos rfl] at hx
    by_contra hn
    simp [Ne.symm hn] at hx
  · intro a
    obtain ⟨σ,hσ⟩ := valid_permutation a.val a.property
    refine ⟨σ,?_⟩
    apply Subtype.ext
    apply valid_eq_of_selection_eq _ _ (permutationState_valid σ) a.property
    intro p
    have h := hσ (index p.1) (index p.2)
    have hcast (i : ZMod m) : ((index i).val : ZMod m) = i := ZMod.natCast_zmod_val i
    simp only [hcast] at h
    change (if σ (index p.1) = index p.2 then (1 : Fin 2) else 0).val = _
    rw [val_bit]
    exact h.symm

noncomputable def permutationEquiv (m : ℕ) [NeZero m] :
    Equiv.Perm (Fin m) ≃ {a : (ZMod m × ZMod m) → GridState // Valid a} :=
  Equiv.ofBijective _ permutationState_bijective

def stateAssignmentEquiv (m : ℕ) :
    (∀ p,{α : GridIdx m // α.1 = p}) ≃ ((ZMod m × ZMod m) → GridState) where
  toFun ν p := (ν p).val.2
  invFun a p := ⟨(p,a p),rfl⟩
  left_inv ν := by
    funext p
    apply Subtype.ext
    exact Prod.ext (ν p).property.symm rfl
  right_inv _ := rfl

end GridStateBijection

-- Helpers from Solutions/GridPolynomial.lean
open ResultantVNP GridConstruction GridStateBijection Finset MvPolynomial
open scoped Classical

namespace GridPolynomial

def indexEquiv (m : ℕ) [NeZero m] : ZMod m ≃ Fin m where
  toFun := index
  invFun i := (i.val : ZMod m)
  left_inv i := ZMod.natCast_zmod_val i
  right_inv := index_cast

noncomputable def stateWeight {m : ℕ} [NeZero m] {R : Type} [CommMonoid R]
    (w : ZMod m × ZMod m → R) (a : (ZMod m × ZMod m) → GridState) : R :=
  ∏ p,if (a p).1.1 = 1 then w p else 1

lemma permutation_weight {m : ℕ} [NeZero m] {R : Type} [CommMonoid R]
    (w : ZMod m × ZMod m → R) (σ : Equiv.Perm (Fin m)) :
    stateWeight w (permutationState σ) = ∏ i,w ((i.val : ZMod m),((σ i).val : ZMod m)) := by
  unfold stateWeight
  rw [← Equiv.prod_comp ((indexEquiv m).symm.prodCongr (indexEquiv m).symm)
    (fun p => if (permutationState σ p).1.1 = 1 then w p else 1)]
  change (∏ p : Fin m × Fin m,if (permutationState σ ((p.1.val : ZMod m),(p.2.val : ZMod m))).1.1 = 1
    then w ((p.1.val : ZMod m),(p.2.val : ZMod m)) else 1) = _
  rw [Fintype.prod_prod_type]
  apply Finset.prod_congr rfl
  intro i _
  have ht (j : Fin m) :
      (if (permutationState σ ((i.val : ZMod m),(j.val : ZMod m))).1.1 = 1
        then w ((i.val : ZMod m),(j.val : ZMod m)) else 1) =
      if σ i = j then w ((i.val : ZMod m),(j.val : ZMod m)) else 1 := by
    change (if (if σ (index (i.val : ZMod m)) = index (j.val : ZMod m) then (1 : Fin 2) else 0) = 1
      then _ else _) = _
    rw [index_cast,index_cast]
    split_ifs <;> simp_all
  simp_rw [ht]
  simp

lemma gridSum_states (n : ℕ) :
    gridSum (fun α : GridIdx (gridSide n) => α.1) (gridTensor n) =
      ∑ a : (ZMod (gridSide n) × ZMod (gridSide n)) → GridState,
        ∏ p,if gridTest (gridSide n) p (a p) (a (gridRight p)) (a (gridDown p)) then
          (if (a p).1.1 = 1 then paddedEntry n (gridSide n) p else 1) else 0 := by
  unfold gridSum
  rw [← Equiv.sum_comp (stateAssignmentEquiv (gridSide n)).symm
    (fun ν => ∏ p,gridTensor n (assignTriple (fun α => α.1) ν p))]
  apply Finset.sum_congr rfl
  intro a _
  apply Finset.prod_congr rfl
  intro p _
  exact encoding_entry n p (a p) (a (gridRight p)) (a (gridDown p))

lemma gridSum_valid (n : ℕ) :
    gridSum (fun α : GridIdx (gridSide n) => α.1) (gridTensor n) =
      ∑ a : {a : (ZMod (gridSide n) × ZMod (gridSide n)) → GridState // Valid a},
        stateWeight (paddedEntry n (gridSide n)) a.val := by
  rw [gridSum_states]
  rw [← Finset.sum_subtype (Finset.univ.filter (fun a => Valid a)) (by simp)
    (stateWeight (paddedEntry n (gridSide n))),Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro a _
  by_cases ha : Valid a
  · rw [if_pos ha]
    apply Finset.prod_congr rfl
    intro p _
    rw [if_pos (ha p)]
  · rw [if_neg ha]
    obtain ⟨p,hp⟩ : ∃ p,¬ gridTest (gridSide n) p (a p) (a (gridRight p)) (a (gridDown p)) := by
      simpa only [Valid,not_forall] using ha
    exact Finset.prod_eq_zero (Finset.mem_univ p) (if_neg hp)

theorem gridSum_permutations (n : ℕ) :
    gridSum (fun α : GridIdx (gridSide n) => α.1) (gridTensor n) =
      ∑ σ : Equiv.Perm (Fin (gridSide n)),∏ i,
        paddedEntry n (gridSide n) ((i.val : ZMod (gridSide n)),((σ i).val : ZMod (gridSide n))) := by
  rw [gridSum_valid,← Equiv.sum_comp (permutationEquiv (gridSide n))
    (fun a => stateWeight (paddedEntry n (gridSide n)) a.val)]
  apply Finset.sum_congr rfl
  intro σ _
  exact permutation_weight _ σ

end GridPolynomial

-- Helpers from Solutions/PermanentPadding.lean
open ResultantVNP GridConstruction GridStateBijection GridPolynomial Finset MvPolynomial
open scoped Classical

namespace PermanentPadding

def initialEquiv {n m : ℕ} (hnm : n ≤ m) : Fin n ≃ {i : Fin m // i.val < n} where
  toFun i := ⟨⟨i.val,lt_of_lt_of_le i.isLt hnm⟩,i.isLt⟩
  invFun i := ⟨i.val.val,i.property⟩
  left_inv _ := rfl
  right_inv _ := rfl

lemma fixed_complement_preserves {n m : ℕ} (τ : Equiv.Perm (Fin m))
    (hτ : ∀ i,¬ i.val < n → τ i = i) : ∀ i,(τ i).val < n ↔ i.val < n := by
  intro i
  constructor
  · intro hi
    by_contra hn
    rw [hτ i hn] at hi
    exact hn hi
  · intro hi
    by_contra hn
    have he := τ.injective (hτ (τ i) hn)
    rw [he] at hn
    exact hn hi

lemma fixed_complement_extension {n m : ℕ} (hnm : n ≤ m) (τ : Equiv.Perm (Fin m))
    (hτ : ∀ i,¬ i.val < n → τ i = i) :
    ∃ σ : Equiv.Perm (Fin n),σ.extendDomain (initialEquiv hnm) = τ := by
  let hp := fixed_complement_preserves τ hτ
  let σ := (initialEquiv hnm).trans ((τ.subtypePerm hp).trans (initialEquiv hnm).symm)
  refine ⟨σ,?_⟩
  apply Equiv.ext
  intro i
  by_cases hi : i.val < n
  · rw [Equiv.Perm.extendDomain_apply_subtype σ (initialEquiv hnm) hi]
    simp [σ]
  · rw [Equiv.Perm.extendDomain_apply_not_subtype σ (initialEquiv hnm) hi]
    exact (hτ i hi).symm

lemma cast_eq_iff {m : ℕ} [NeZero m] (i j : Fin m) :
    (i.val : ZMod m) = (j.val : ZMod m) ↔ i = j := by
  constructor
  · intro h
    apply Fin.ext
    have hh := congrArg ZMod.val h
    simpa only [ZMod.val_cast_of_lt i.isLt,ZMod.val_cast_of_lt j.isLt] using hh
  · intro h; rw [h]

noncomputable def entry (n m : ℕ) [NeZero m] (i j : Fin m) : MvPolynomial (Fin n × Fin n) ℤ :=
  paddedEntry n m ((i.val : ZMod m),(j.val : ZMod m))

lemma entry_outside {n m : ℕ} [NeZero m] (i j : Fin m) (hi : ¬ i.val < n) :
    entry n m i j = if i = j then 1 else 0 := by
  simp [entry,paddedEntry,ZMod.val_cast_of_lt i.isLt,ZMod.val_cast_of_lt j.isLt,hi,cast_eq_iff]

lemma entry_initial {n m : ℕ} [NeZero m] (hnm : n ≤ m) (i j : Fin n) :
    entry n m (initialEquiv hnm i).val (initialEquiv hnm j).val = X (i,j) := by
  simp [entry,paddedEntry,initialEquiv,ZMod.val_cast_of_lt (lt_of_lt_of_le i.isLt hnm),
    ZMod.val_cast_of_lt (lt_of_lt_of_le j.isLt hnm),i.isLt,j.isLt]

lemma product_nonzero_fixed {n m : ℕ} [NeZero m] (τ : Equiv.Perm (Fin m))
    (hτ : (∏ i,entry n m i (τ i)) ≠ 0) : ∀ i,¬ i.val < n → τ i = i := by
  intro i hi
  have hne := (Finset.prod_ne_zero_iff.mp hτ) i (Finset.mem_univ i)
  rw [entry_outside i (τ i) hi] at hne
  by_contra hn
  simp [Ne.symm hn] at hne

lemma extended_product {n m : ℕ} [NeZero m] (hnm : n ≤ m) (σ : Equiv.Perm (Fin n)) :
    (∏ i,entry n m i (σ.extendDomain (initialEquiv hnm) i)) = ∏ i,X (i,σ i) := by
  rw [← Fintype.prod_subtype_mul_prod_subtype (fun i : Fin m => i.val < n)
    (fun i => entry n m i (σ.extendDomain (initialEquiv hnm) i))]
  have hout : (∏ i : {i : Fin m // ¬ i.val < n},
      entry n m i.val (σ.extendDomain (initialEquiv hnm) i.val)) = 1 := by
    apply Finset.prod_eq_one
    intro i _
    rw [Equiv.Perm.extendDomain_apply_not_subtype σ (initialEquiv hnm) i.property,
      entry_outside _ _ i.property,if_pos rfl]
  rw [hout,mul_one,← Equiv.prod_comp (initialEquiv hnm)
    (fun i => entry n m i.val (σ.extendDomain (initialEquiv hnm) i.val))]
  apply Finset.prod_congr rfl
  intro i _
  rw [Equiv.Perm.extendDomain_apply_image,entry_initial]

theorem sum_padding {n m : ℕ} [NeZero m] (hnm : n ≤ m) :
    (∑ τ : Equiv.Perm (Fin m),∏ i,entry n m i (τ i)) =
      ∑ σ : Equiv.Perm (Fin n),∏ i,(X (i,σ i) : MvPolynomial (Fin n × Fin n) ℤ) := by
  let extend : Equiv.Perm (Fin n) → Equiv.Perm (Fin m) := fun σ => σ.extendDomain (initialEquiv hnm)
  have hinj : Function.Injective extend := Equiv.Perm.extendDomainHom_injective (initialEquiv hnm)
  let S := Finset.univ.image extend
  have hz (τ : Equiv.Perm (Fin m)) (_ : τ ∈ Finset.univ) (hτ : τ ∉ S) :
      (∏ i,entry n m i (τ i)) = 0 := by
    by_contra hne
    obtain ⟨σ,hσ⟩ := fixed_complement_extension hnm τ (product_nonzero_fixed τ hne)
    exact hτ (Finset.mem_image.mpr ⟨σ,Finset.mem_univ _,hσ⟩)
  rw [← Finset.sum_subset (Finset.subset_univ S) hz]
  rw [show S = Finset.univ.image extend from rfl,Finset.sum_image hinj.injOn]
  apply Finset.sum_congr rfl
  intro σ _
  exact extended_product hnm σ

theorem grid_permanent_identity (n : ℕ) :
    gridSum (fun α : GridIdx (gridSide n) => α.1) (gridTensor n) =
      (Matrix.of fun i j : Fin n => (X (i,j) : MvPolynomial (Fin n × Fin n) ℤ)).permanent := by
  rw [GridPolynomial.gridSum_permutations]
  change (∑ τ : Equiv.Perm (Fin (gridSide n)),∏ i,entry n (gridSide n) i (τ i)) = _
  rw [sum_padding (side_gt n).le]
  rw [← Matrix.permanent_transpose,Matrix.permanent]
  rfl

end PermanentPadding

theorem solution (n : ℕ) :
    ResultantVNP.gridSum (fun α : ResultantVNP.GridIdx (ResultantVNP.gridSide n) => α.1)
      (ResultantVNP.gridTensor n) =
      (Matrix.of fun i j : Fin n => (MvPolynomial.X (i,j) : MvPolynomial (Fin n × Fin n) ℤ)).permanent :=
  PermanentPadding.grid_permanent_identity n

#print axioms solution
