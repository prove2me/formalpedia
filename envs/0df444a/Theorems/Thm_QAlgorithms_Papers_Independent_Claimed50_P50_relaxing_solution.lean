-- title:
--   The relaxing evolution uniquely solves the no-jump equation
-- statement:
--   Let $H,H_0$ be complex Hilbert spaces and $D\subset H$ a dense complex linear subspace. Let $L:D\to H\otimes H_0$ and $K:D\to H$ be linear, with $L=0$, $\|L\psi\|^2\le2\operatorname{Re}\langle\psi,K\psi\rangle$ on $D$, and $K$ closable with maximal accretive closure. There exists a strongly continuous contraction semigroup $T_t$ on $H$ whose entire generator is $-\overline K$, characterized by its Hilbert-norm right derivative at zero. There is a normal subunital completely positive dynamical semigroup $\widehat\Phi$ on $\mathcal B(H)$, with weak-star continuous orbits, given by
--
--   $$\widehat\Phi_t(X)=T_t^*XT_t.$$
--
--   It starts at the identity and satisfies, for all bounded $X$ and $\psi,\phi\in D$,
--
--   $$\frac{d}{dt}\langle\psi,\widehat\Phi_t(X)\phi\rangle=-\langle K\psi,\widehat\Phi_t(X)\phi\rangle-\langle\psi,\widehat\Phi_t(X)K\phi\rangle.$$
--
--   It is the unique dynamical-semigroup solution of this equation with those initial data. The derivative at zero is one-sided. This specifies the actual no-jump evolution even when $K$ is unbounded; the notation $e^{-t\overline K}$ denotes $T_t$.
-- source:
--   Covariant Quantum Dynamical Semigroups: Unbounded generators, arXiv:quant-ph/9701037v1, PDF p. 5, §2: the relaxing semigroup uniquely solves the no-jump equation

import Definitions.Def_QAlgorithms_Papers_Independent_Claimed50_P50

noncomputable section

namespace QAlgorithms.Papers.Independent.Claimed50.P50

open scoped TensorProduct BigOperators

variable {H N : Type*}

variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

variable [NormedAddCommGroup N] [InnerProductSpace ℂ N] [CompleteSpace N]

/-- Holevo, arXiv:quant-ph/9701037v1, PDF p.5: the relaxing semigroup
T_t adjoint X T_t is the unique solution when the jump term vanishes.
T is the C0 contraction semigroup generated by minus closure(K), with its
actual full right-derivative generator graph, not a formal exponential. -/
theorem relaxing_solution {D : Submodule ℂ H}
    (hDense : Dense (D : Set H)) (S : StandardData (N := N) D)
    (hZeroJump : S.L = 0) (hDiss : IsDissipative S)
    (hK : HasMaximalAccretiveClosure S) :
    ∃ (T : ContractionSemigroup H) (Phi : DynamicalSemigroup H),
      IsGeneratedByNegativeClosure S T ∧ IsRelaxingEvolution T Phi ∧
      SolvesBackward S Phi ∧
      (∀ Psi : DynamicalSemigroup H, SolvesBackward S Psi →
        ∀ (t : NNReal) (X : H →L[ℂ] H), Psi.maps t X = Phi.maps t X) := by sorry

end QAlgorithms.Papers.Independent.Claimed50.P50

end
