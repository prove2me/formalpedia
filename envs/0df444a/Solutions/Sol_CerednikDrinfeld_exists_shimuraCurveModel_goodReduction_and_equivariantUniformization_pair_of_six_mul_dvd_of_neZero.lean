section euTransport
variable {E₁ V₁ E₂ V₂ : Type} [Fintype E₁] [DecidableEq V₁] [Fintype E₂] [DecidableEq V₂]
  {r : ℕ} [Fact r.Prime] {D₁ : DegeneracyData E₁ V₁} {D₂ : DegeneracyData E₂ V₂}
  {A : ValuationSubring (AlgebraicClosure ℚ)} {hA : A.LiesOverPrime r}
  {T : Type} [AddCommGroup T]
  {S : Type} [Group S] {scalar : S →* ↥(A.decompositionSubgroup ℚ)}
  {actZ₁ : S →* (↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₁))} {gal : S →* AddAut T}

def euTransport (𝒰 : EquivariantUniformization r D₁ A hA T S scalar actZ₁ gal)
    (e : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₂))
    (hiso : ∀ x y : ↥(ribbonKernel D₁), ribbonGram D₂ (e x) (e y) = ribbonGram D₁ x y)
    (actZ₂ : S →* (↥(ribbonKernel D₂) ≃ₗ[ℤ] ↥(ribbonKernel D₂)))
    (hact : ∀ (σ : S) (x : ↥(ribbonKernel D₁)), e (actZ₁ σ x) = actZ₂ σ (e x)) :
    EquivariantUniformization r D₂ A hA T S scalar actZ₂ gal where
  K := 𝒰.K
  ord := 𝒰.ord
  ord_spec := 𝒰.ord_spec
  inertia_K := 𝒰.inertia_K
  hensel_K := 𝒰.hensel_K
  P := pdTransport 𝒰.P e hiso
  eFull := 𝒰.eFull.comp (torusPull 𝒰.P e hiso).toAddMonoidHom
  eFull_surjective t := by
    obtain ⟨u, hu⟩ := 𝒰.eFull_surjective t
    refine ⟨u ∘ₗ e.symm.toLinearMap, ?_⟩
    show 𝒰.eFull (torusPull 𝒰.P e hiso (u ∘ₗ e.symm.toLinearMap)) = t
    convert hu using 2
    ext z; simp
  eFull_ker u := by
    show 𝒰.eFull (torusPull 𝒰.P e hiso u) = 0 ↔ _
    rw [𝒰.eFull_ker]
    simp only [PeriodDatum.periodLattice, LinearMap.mem_range]
    constructor
    · rintro ⟨x, hx⟩
      refine ⟨e x, LinearMap.ext fun z => ?_⟩
      have := congrArg (fun f : 𝒰.P.TorusPoints => f (e.symm z)) hx
      simpa [PeriodDatum.QL_apply] using this
    · rintro ⟨x, hx⟩
      refine ⟨e.symm x, LinearMap.ext fun z => ?_⟩
      have := congrArg (fun f : (pdTransport 𝒰.P e hiso).TorusPoints => f (e z)) hx
      simpa [PeriodDatum.QL_apply] using this
  Q_equiv σ s hs x y := by
    have h := 𝒰.Q_equiv σ s hs (e.symm x) (e.symm y)
    have hx : e.symm (actZ₂ σ x) = actZ₁ σ (e.symm x) := by
      apply e.injective; rw [hact, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]
    have hy : e.symm (actZ₂ σ y) = actZ₁ σ (e.symm y) := by
      apply e.injective; rw [hact, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]
    simp only [pdTransport_Q, hx, hy]
    exact h
  eFull_equiv σ s hs u := by
    show 𝒰.eFull (torusPull 𝒰.P e hiso _) = gal σ (𝒰.eFull (torusPull 𝒰.P e hiso u))
    rw [← 𝒰.eFull_equiv σ s hs (torusPull 𝒰.P e hiso u)]
    congr 1
    refine LinearMap.ext fun z => ?_
    have key : (((actZ₂ σ)⁻¹ : ↥(ribbonKernel D₂) ≃ₗ[ℤ] ↥(ribbonKernel D₂)) : ↥(ribbonKernel D₂) →ₗ[ℤ] ↥(ribbonKernel D₂))
        (e z) = e ((((actZ₁ σ)⁻¹ : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₁)) :
          ↥(ribbonKernel D₁) →ₗ[ℤ] ↥(ribbonKernel D₁)) z) := by
      rw [LinearEquiv.coe_coe, LinearEquiv.coe_coe, ← map_inv, ← map_inv, hact]
    simp only [torusPull_apply, PeriodDatum.coeffMap_apply, PeriodDatum.precomp_apply, key]

@[scoped simp] theorem euTransport_P (𝒰 : EquivariantUniformization r D₁ A hA T S scalar actZ₁ gal)
    (e : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₂))
    (hiso : ∀ x y : ↥(ribbonKernel D₁), ribbonGram D₂ (e x) (e y) = ribbonGram D₁ x y)
    (actZ₂ : S →* (↥(ribbonKernel D₂) ≃ₗ[ℤ] ↥(ribbonKernel D₂)))
    (hact : ∀ (σ : S) (x : ↥(ribbonKernel D₁)), e (actZ₁ σ x) = actZ₂ σ (e x)) :
    (euTransport 𝒰 e hiso actZ₂ hact).P = pdTransport 𝒰.P e hiso := rfl

theorem euTransport_eFull (𝒰 : EquivariantUniformization r D₁ A hA T S scalar actZ₁ gal)
    (e : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₂))
    (hiso : ∀ x y : ↥(ribbonKernel D₁), ribbonGram D₂ (e x) (e y) = ribbonGram D₁ x y)
    (actZ₂ : S →* (↥(ribbonKernel D₂) ≃ₗ[ℤ] ↥(ribbonKernel D₂)))
    (hact : ∀ (σ : S) (x : ↥(ribbonKernel D₁)), e (actZ₁ σ x) = actZ₂ σ (e x))
    (u : (pdTransport 𝒰.P e hiso).TorusPoints) :
    (euTransport 𝒰 e hiso actZ₂ hact).eFull u = 𝒰.eFull (torusPull 𝒰.P e hiso u) := rfl

end euTransport
