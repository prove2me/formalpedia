theorem OAI.SixthPowerAverage.averagingRows_power_norm (Y : ℝ) (hY : 1≤Y)
    {z : ActualEisensteinCubic.O} (hz : z∈(averagingRows Y).image (fun b=>b^6)) :
    z≠0 ∧ (Ideal.absNorm (Ideal.span {z}):ℝ)≤Y^6 := by sorry
