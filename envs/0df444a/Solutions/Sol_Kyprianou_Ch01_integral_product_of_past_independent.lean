import Mathlib
open MeasureTheory ProbabilityTheory Filter
open scoped NNReal ENNReal
set_option autoImplicit false

theorem solution
    {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (mPast : MeasurableSpace Ω)
    (hmPast : mPast ≤ (inferInstance : MeasurableSpace Ω))
    (G : Ω → ℝ) (hG : Measurable G)
    (hIndep : Indep (MeasurableSpace.comap G inferInstance) mPast P)
    (F : Ω → ℂ)
    (hF : @Measurable Ω ℂ mPast inferInstance F)
    (phi : ℝ → ℂ) (hphi : Measurable phi) :
    (∫ ω, phi (G ω) * F ω ∂P) =
      (∫ ω, phi (G ω) ∂P) * (∫ ω, F ω ∂P) := by
  -- In this statement `hG` is measurability with respect to `mPast`, so the
  -- σ-algebra generated by `G` is independent of itself and `G` is a.s. constant.
  have hle : MeasurableSpace.comap G inferInstance ≤ mPast := hG.comap_le
  have h01 : ∀ U : Set ℝ, MeasurableSet U →
      (∀ᵐ ω ∂P, G ω ∈ U) ∨ (∀ᵐ ω ∂P, G ω ∉ U) := by
    intro U hU
    have hA : MeasurableSet[MeasurableSpace.comap G inferInstance] (G ⁻¹' U) := ⟨U, hU, rfl⟩
    have hB : MeasurableSet[mPast] (G ⁻¹' Uᶜ) := hle _ ⟨Uᶜ, hU.compl, rfl⟩
    have h := (Indep_iff _ _ P).1 hIndep _ _ hA hB
    have hempty : G ⁻¹' U ∩ G ⁻¹' Uᶜ = ∅ := by
      ext ω; simp
    rw [hempty, measure_empty] at h
    rcases mul_eq_zero.1 h.symm with h1 | h1
    · right
      exact (measure_eq_zero_iff_ae_notMem).1 h1
    · left
      filter_upwards [(measure_eq_zero_iff_ae_notMem).1 h1] with ω hω
      simpa using hω
  obtain ⟨c, hc⟩ : ∃ c : ℝ, G =ᵐ[P] Function.const Ω c :=
    exists_eventuallyEq_const_of_eventually_mem_of_forall_separating MeasurableSet
      (s := Set.univ) (Eventually.of_forall fun _ => Set.mem_univ _) h01
  have h1 : (∫ ω, phi (G ω) * F ω ∂P) = ∫ ω, phi c * F ω ∂P := by
    refine integral_congr_ae ?_
    filter_upwards [hc] with ω hω
    simp [hω]
  have h2 : (∫ ω, phi (G ω) ∂P) = ∫ _ω, phi c ∂P := by
    refine integral_congr_ae ?_
    filter_upwards [hc] with ω hω
    simp [hω]
  rw [h1, h2, integral_const_mul, integral_const]
  simp
