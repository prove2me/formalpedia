    GOKN (I.scatG ℂ (σ : ℂ)).1 := by
  refine egM_GOKN _ _ _ _ (fun q => σ * (match q.1 with | none => (-1 : ℤ) | some _ => 1))
    (fun _ => 1) (fun q _ => ?_) (fun q _ => ?_) (fun _ _ => le_rfl)
    (fun x _ y _ => hG.tc _ _) (fun x _ y _ hr hc => Prod.ext (hG.cen_inj hc) (hG.tgt_inj hr))
  · rw [kS_eq]; rcases q with ⟨_ | _, _⟩ <;> simp <;> ring
