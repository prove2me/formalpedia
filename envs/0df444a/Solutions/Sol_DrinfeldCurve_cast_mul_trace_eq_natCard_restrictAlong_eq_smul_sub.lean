    (h : Divisor.IsPrincipal (D : Divisor K F)) : Pic0.mk D = 0 := by
  change (QuotientAddGroup.mk _ : Pic0 K F) = 0
  rw [QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_addSubgroupOf]
