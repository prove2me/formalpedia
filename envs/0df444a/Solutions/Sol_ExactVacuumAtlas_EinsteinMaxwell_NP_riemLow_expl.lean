section metric

variable {g gi : Metric n} {U : Set (Pt n)}

theorem g_gi_apply (hm : MetricData g gi U) {x : Pt n} (hx : x ∈ U) (a b : Fin n) :
    ∑ e, g a e x * gi e b x = (1 : Matrix (Fin n) (Fin n) ℝ) a b := by
  have := congrFun (congrFun (hm.mul_inv hx) a) b
  simpa [Matrix.mul_apply, metricMatrix] using this

/-- `Σ_e g_{ae} Γ^e_{ij} = Γ_{a,ij}`. -/
theorem sum_g_christoffel (hm : MetricData g gi U) {y : Pt n} (hy : y ∈ U) (a i j : Fin n) :
    ∑ e, g a e y * christoffel g gi e i j y = chr1 g a i j y := by
  simp only [christoffel_eq_sum_chr1, Finset.mul_sum]
  rw [Finset.sum_comm]
  have h : ∀ l, ∑ e, g a e y * (gi e l y * chr1 g l i j y) = (1 : Matrix (Fin n) (Fin n) ℝ) a l * chr1 g l i j y := by
    intro l
    rw [← g_gi_apply hm hy a l, Finset.sum_mul]
    exact Finset.sum_congr rfl fun e _ => by ring
  simp only [h, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]

