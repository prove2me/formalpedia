    ((_root_.Integration9_9.TM2NativeTupleEnumeration.tuples k (List.range pool)).map f).sum=
      ∑word : Fin k→Fin pool,f (List.ofFn (fun i => (word i).val)) := by
  induction k generalizing f with
  | zero => simp only [_root_.Integration9_9.TM2NativeTupleEnumeration.tuples,List.map_singleton,List.sum_cons,List.sum_nil,add_zero,Fintype.sum_unique,List.ofFn_zero]
  | succ k ih =>
    simp only [_root_.Integration9_9.TM2NativeTupleEnumeration.tuples,List.map_flatMap,_root_.Integration9_9.TM2NativeProfile.sum_flatMap,List.map_map,Function.comp_def]
    rw [_root_.Integration9_9.TM2NativeProfile.sum_range]
    simp_rw [ih]
    simpa only [Fintype.sum_prod_type,Fin.consEquiv,Equiv.coe_fn_mk,List.ofFn_succ,Fin.cons_zero,Fin.cons_succ] using
      (Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (k+1) => Fin pool))
