theorem pmB_step (u : IState HS) (d' Q Mh Mf i s : ℕ) (h : SrcRegs u d' Q Mh Mf)
    (LS LP : List Item) (hS : u.G mS = .int (s : ℤ) :: LS) (hs : 2 ≤ s)
    (hj : ∀ j < i, (j < d' → j ≤ Mh) ∧ (d' ≤ j → j - d' ≤ Mf)) :
    ∀ k < i, pmB.ok (lpSt u mIc mP LP i k (accSeq (fun k c =>
        (c * (srcV d' Q Mh Mf (i - 1 - k) : ℤ)) % (s : ℤ)) 1 k)) ∧
      pmB.run (lpSt u mIc mP LP i k (accSeq (fun k c =>
        (c * (srcV d' Q Mh Mf (i - 1 - k) : ℤ)) % (s : ℤ)) 1 k)) =
      (lpSt u mIc mP LP i k (accSeq (fun k c =>
        (c * (srcV d' Q Mh Mf (i - 1 - k) : ℤ)) % (s : ℤ)) 1 k)).upd mP
        (.int ((fun k c => (c * (srcV d' Q Mh Mf (i - 1 - k) : ℤ)) % (s : ℤ)) k
          (accSeq (fun k c => (c * (srcV d' Q Mh Mf (i - 1 - k) : ℤ)) % (s : ℤ)) 1 k)) :: LP) := by
  set g := srcV d' Q Mh Mf with hg
  intro k hk
  rw [accSeq_pm s (fun t => g (i - 1 - t)) k]
  set c := pmSeq s (fun t => g (i - 1 - t)) k with hc
  set t := lpSt u mIc mP LP i k (c : ℤ) with ht
  have tI : t.G mIc = .int ((i : ℤ) - k) :: u.G mIc := by
    simp (config := {decide := true}) [ht, lpSt, IState.upd_G]
  have tP : t.G mP = .int (c : ℤ) :: LP := by simp [ht, lpSt]
  have tS : t.G mS = .int (s : ℤ) :: LS := by
    simp (config := {decide := true}) [ht, lpSt, IState.upd_G, hS]
  have hR := h.lp mP (by decide) LP i k (c : ℤ)
  have hjx : ixI.eval t = ((i - 1 - k : ℕ) : ℤ) := by
    simp only [ixI, Ex.eval, IState.top_eq tI]; omega
  obtain ⟨sok, sev⟩ := srcE_spec t ixI d' Q Mh Mf (i - 1 - k) hR hjx
    ⟨IState.isInt_of tI, trivial⟩ (hj _ (by omega))
  refine ⟨⟨by decide, NLogN.KFM.clean_of_regs _ (by decide), ⟨⟨IState.isInt_of tP, sok⟩,
    IState.isInt_of tS, ?_, ?_⟩, IState.isInt_of tP⟩, ?_⟩
  · simp only [Ex.eval, IState.top_eq tP, sev]; positivity
  · simp only [Ex.eval, IState.top_eq tS]; omega
  · simp only [pmB, RS.run, Ex.eval, IState.top_eq tP, IState.top_eq tS, sev, tP,
      List.tail_cons]; rfl

