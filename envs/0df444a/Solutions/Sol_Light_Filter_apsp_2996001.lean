/-- The context of the oracle, in the assembled program with anything appended to it. -/
theorem oracleCtx_assembled {P₀ : Program} {pS : ℕ} {Tn : List ℕ → ℕ} {need : List ℕ → Light.Need}
    (hsol : SolvesN lopCountTask P₀ pS Tn need) (R : Program) :
    OracleCtx P₀ (oracleProcs pS P₀.length ++ R) (oNumsAt pS P₀.length) Tn need := by
  have L : ∀ {i : ℕ} {body : Stmt}, (oracleProcs pS P₀.length)[i]? = some body →
      (P₀ ++ (oracleProcs pS P₀.length ++ R))[P₀.length + i]? = some body :=
    fun h => getElem?_append_append R h
  exact
    { core :=
        { loop := ⟨hsol, L rfl, L rfl, L rfl⟩
          hLoop := L rfl
          hDbl := L rfl
          hResid := L rfl
          hResidues := L rfl
          hClasses := L rfl
          hChunks := L rfl }
      hCore := L rfl
      hCeil := L (i := 0) rfl
      hBitLen := L rfl }

