-- title:
--   Theorem 4.6, 2 ⇒ 1 — a certificate $f+g^2+h=0$ shows that (4.4) is empty
-- statement:
--   Let $(f_j)_{j=1,\dots,s}$, $(g_k)_{k=1,\dots,t}$, $(h_\ell)_{\ell=1,\dots,u}$ be finite families of polynomials in $\mathbb R[x_1,\dots,x_n]$, each possibly empty. Let $P$ be the cone generated by the $f_j$, $M$ the multiplicative monoid generated by the $g_k$, and $I$ the ideal generated by the $h_\ell$. If there exist $f\in P$, $g\in M$, $h\in I$ with
--   $$
--   f+g^2+h=0,
--   $$
--   then the set
--   $$
--   \left\{x\in\mathbb R^n \;\middle|\; f_j(x)\ge 0,\ j=1,\dots,s;\ g_k(x)\ne 0,\ k=1,\dots,t;\ h_\ell(x)=0,\ \ell=1,\dots,u\right\}\qquad(4.4)
--   $$
--   is empty.
--
--   This is the direction of the Positivstellensatz proved in the paper: an algebraic identity of this form is a certificate of infeasibility of the real polynomial system.
--
--   **Formalization Note** This item formalizes only the implication 2 ⇒ 1 of Theorem 4.6; the converse is a separate item.
-- source:
--   Parrilo, Semidefinite programming relaxations for semialgebraic problems, Math. Program. Ser. B 96 (2003) 293–320, p. 305, Theorem 4.6 (2 ⇒ 1)

import Mathlib
import Definitions.Def_SemialgebraicSDP_Psatz_Cone

namespace SemialgebraicSDP.Psatz

open MvPolynomial

theorem theorem_4_6_sufficiency {n s t u : ℕ} (f : Fin s → MvPolynomial (Fin n) ℝ)
    (g : Fin t → MvPolynomial (Fin n) ℝ) (h : Fin u → MvPolynomial (Fin n) ℝ)
    (hcert : ∃ F ∈ cone (Set.range f), ∃ G ∈ Submonoid.closure (Set.range g),
      ∃ H ∈ Ideal.span (Set.range h), F + G ^ 2 + H = 0) :
    psatzSet f g h = ∅ := by sorry

end SemialgebraicSDP.Psatz
