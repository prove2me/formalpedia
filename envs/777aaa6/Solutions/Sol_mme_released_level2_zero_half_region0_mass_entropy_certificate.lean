  | node : KT → ℕ → ℕ × ℕ × ℕ → KT → KT

def KT.find : KT → ℕ → Option (ℕ × ℕ × ℕ)
  | .leaf, _ => none
  | .node l k v r, d =>
    if Nat.blt d k then l.find d else if Nat.beq d k then some v else r.find d

def KT.toList : KT → List (ℕ × ℕ × ℕ × ℕ)
  | .leaf => []
  | .node l k v r => l.toList ++ (k, v) :: r.toList

theorem KT.find_mem : ∀ (t : KT) (d : ℕ) (v : ℕ × ℕ × ℕ), t.find d = some v → (d, v) ∈ t.toList
  | .leaf, d, v, h => by simp [KT.find] at h
  | .node l k v' r, d, v, h => by
    simp only [KT.find] at h
    split_ifs at h with h1 h2
    · exact List.mem_append_left _ (KT.find_mem l d v h)
    · have hdk : d = k := Nat.eq_of_beq_eq_true h2
      subst hdk
      simp only [Option.some.injEq] at h
      subst h
      simp [KT.toList]
    · simp [KT.toList, KT.find_mem r d v h]

