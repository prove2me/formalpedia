/-- Internal datum. -/ def DivisionEvalCertificate (d n : ℚ) : Prop :=
  ((MazurTorsion.Kubert.orderSevenQuotient d).preΨ' 7).eval n =
    (MazurTorsion.Kubert.OrderSevenBacktrackingCertificate.Internal.dualKernelPolynomial d * MazurTorsion.Kubert.OrderSevenBacktrackingCertificate.divisionCofactor0 d *
      MazurTorsion.Kubert.OrderSevenBacktrackingCertificate.divisionCofactor1 d * MazurTorsion.Kubert.OrderSevenBacktrackingCertificate.divisionCofactor2 d).eval n

end Internal

