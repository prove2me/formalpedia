-- Source module: NLogN.HGl2
/-!
# Gaussian list primitives, part 2: stacks, encodings, cost lemmas, Gaussian zip products

Fixed stacks of the list pipeline (namespace `NLogN.GL`):

* `gD = 0` data, `gZA = 4` second operand of zips, `gZB = 5` reversed outputs, `gZT = 6` temp,
* counters `gC1 = 7` (element loops), `gCV = 8` (moves), `gCC = 9` (chunk loop),
* scratch registers `gR1 … gR4 = 10 … 13`, `gP1 … gP4 = 14 … 17`, dummies `gU1 = 18`, `gU2 = 19`,
* read-only parameters `gPP = 20` (`2^p`), `gPT = 21` (`2^(p+logT)`), `gPS = 22` (`2^(p-b)`),
  `gPQ = 23` (`S^2`), `gPC = 24` (`2^(2b+6Kα²+1)`), `gPR = 25` (`2^(p+1)`), `gPN = 26` (`T`),
  `gPM = 27` (`S`).

`zipP σ`: `gD : gints U ++ R₂`, `gZA : gints A ++ R₁` ↦ `gD : gints (zipWith (gzF σ p) A U) ++ R₂`,
`gZA : R₁` with `gzF σ p a z = ((z₁a₁ ± z₂a₂) tdiv 2^p, (±z₂a₁ ± z₁a₂) tdiv 2^p)`; four
multiplication calls per element.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.GL

open IntMul NLogN

abbrev gD : Fin HS := 0
abbrev gZA : Fin HS := 4
abbrev gZB : Fin HS := 5
abbrev gZT : Fin HS := 6
abbrev gC1 : Fin HS := 7
abbrev gCV : Fin HS := 8
abbrev gCC : Fin HS := 9
abbrev gR1 : Fin HS := 10
abbrev gR2 : Fin HS := 11
abbrev gR3 : Fin HS := 12
abbrev gR4 : Fin HS := 13
abbrev gP1 : Fin HS := 14
abbrev gP2 : Fin HS := 15
abbrev gP3 : Fin HS := 16
abbrev gP4 : Fin HS := 17
abbrev gU1 : Fin HS := 18
abbrev gU2 : Fin HS := 19
abbrev gPP : Fin HS := 20
abbrev gPT : Fin HS := 21
abbrev gPS : Fin HS := 22
abbrev gPQ : Fin HS := 23
abbrev gPC : Fin HS := 24
abbrev gPR : Fin HS := 25
abbrev gPN : Fin HS := 26
abbrev gPM : Fin HS := 27

/-! ## Encodings -/

def genc (z : ℤ × ℤ) : List Item := [.int z.1, .int z.2]
def ienc (x : ℤ) : List Item := [.int x]

/-- Bounded Gaussian entries. -/
def GB (B : ℕ) (L : List (ℤ × ℤ)) : Prop := ∀ z ∈ L, zsz z.1 ≤ B ∧ zsz z.2 ≤ B

/-! ## Instruction cost lemmas -/

/-! ## The Gaussian zip product -/

def sgE (b : Bool) (e : Ex HS) : Ex HS := if b then .neg e else e
def sgZ (b : Bool) (x : ℤ) : ℤ := if b then -x else x

def reE (σ1 : Bool) : Ex HS := .quo (.add (.reg gP1) (sgE σ1 (.reg gP2))) (.reg gPP)
def imE (σ2 σ3 : Bool) : Ex HS := .quo (.add (sgE σ2 (.reg gP3)) (sgE σ3 (.reg gP4))) (.reg gPP)

/-- Signs `(σ1, σ2, σ3)`. -/
abbrev Sg := Bool × Bool × Bool

def zipBody (σ : Sg) : RM := RM.seqL [
  .rs (.push gR1 (.reg gZA)), .rs (.pop gZA), .rs (.push gR2 (.reg gZA)), .rs (.pop gZA),
  .rs (.push gR3 (.reg gD)), .rs (.pop gD), .rs (.push gR4 (.reg gD)), .rs (.pop gD),
  .mul gP1 gR1 gR3, .mul gP2 gR2 gR4, .mul gP3 gR1 gR4, .mul gP4 gR2 gR3,
  .rs (.push gZB (NLogN.GL.reE σ.1)), .rs (.push gZB (NLogN.GL.imE σ.2.1 σ.2.2)),
  .rs (.pop gP4), .rs (.pop gP3), .rs (.pop gP2), .rs (.pop gP1),
  .rs (.pop gR4), .rs (.pop gR3), .rs (.pop gR2), .rs (.pop gR1)]

/-- The element function of `zipBody σ`. -/
def gzF (σ : Sg) (p : ℕ) (a z : ℤ × ℤ) : ℤ × ℤ :=
  ((z.1 * a.1 + sgZ σ.1 (z.2 * a.2)).tdiv (2 ^ p),
    (sgZ σ.2.1 (z.2 * a.1) + sgZ σ.2.2 (z.1 * a.2)).tdiv (2 ^ p))

/-- `mulZ p (conjZ a) z`. -/
abbrev sgConjMul : Sg := (false, false, true)
/-- `conjZ (mulZ p a b)`. -/
abbrev sgMulConj : Sg := (true, true, true)

end NLogN.GL

end

