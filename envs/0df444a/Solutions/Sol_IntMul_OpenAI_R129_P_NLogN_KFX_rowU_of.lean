theorem rowCodeU_runs {q : ℕ} {Kc : ℝ} (H13 : L13U q Kc) {I : List Sym}
    {k K e T S0 B r H : ℕ} {i j : Fin mC} (hij : (i : ℕ) ≠ j) (hK : 6 ≤ K)
    (hp : PF k K e T S0 B r) {u : IState HS} (hA : Agree (rowσ k K e T S0 B r H i j) u)
    (zs : List GI) (R0 : List Item) (hg0 : u.G 0 = ints (gflat zs) ++ R0)
    (hl : zs.length = B * 2 ^ T * S0 * r) (hGB : NLogN.KFB.GB H zs) :
    ∃ c, IRuns I l12prog (rowCodeU q) u
        (u.upd 0 (ints (gflat (permRecs (rect (N0R k K e T B i j) (N1R k K e i j) (N2R k K e i j)
          (N3R k K e S0 i j) (mC ^ k * K)) (rowAddAddr K (e % K) (mC ^ k) (pxR i j) (pyR i j)) r zs))
          ++ R0)) c ∧
      (c : ℝ) ≤ IntMul.OpenAI.R129.P.NLogN.KFR.bnd Kc K (mC ^ k) (B * 2 ^ T * S0) r H +
        (cHd (zsz ((VbR T S0 B r H : ℕ) : ℤ)) : ℝ) := by
  set Bb := zsz ((VbR T S0 B r H : ℕ) : ℤ) with hBbd
  have hBb : zsz ((VbR T S0 B r H : ℕ) : ℤ) ≤ Bb := le_rfl
  have hTB := TB hp hBb
  set N0 := N0R k K e T B i j
  set N1 := N1R k K e i j
  set N2 := N2R k K e i j
  set N3 := N3R k K e S0 i j
  have hvol := vol_rowRect hij hp
  -- the header pushes
  have hE : ∀ p ∈ hdrL, ∃ v, ESp p.2 u Bb v := by
    intro p hm
    simp only [hdrL, List.mem_cons, List.not_mem_nil, or_false] at hm
    rcases hm with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    exacts [⟨_, xW hp hA hBb⟩, ⟨_, xNt hp hA hBb⟩, ⟨_, xFa hp hA hBb hij⟩, ⟨_, xFb hp hA hBb hij⟩,
      ⟨_, xQ hp hA hBb⟩, ⟨_, xBp hp hA hBb⟩, ⟨_, xR2 hp hA hBb⟩, ⟨_, xGx hp hA hBb hij⟩,
      ⟨_, xN0 hp hA hBb hij⟩, ⟨_, xN1 hp hA hBb hij⟩, ⟨_, xN2 hp hA hBb hij⟩,
      ⟨_, xN3 hp hA hBb hij⟩, ⟨_, xK2 hp hA hBb⟩]
  have hOK1 : NLogN.KIL.PushOK u Bb hdrL := pushOK_of hdrL_low hdrL_regs hE
  set t1 := pushSt u (evalP u hdrL) with ht1
  have T1 : ∀ x ex, (x, ex) ∈ hdrL → t1.G x = .int (ex.eval u) :: u.G x := fun x ex hm =>
    pushSt_G_mem u _ (by rw [evalP_fst']; exact hdrL_nodup)
      (by rw [evalP_eq]; exact List.mem_map.2 ⟨(x, ex), hm, rfl⟩)
  have T1' : ∀ x, x ∉ hdrL.map Prod.fst → t1.G x = u.G x := fun x hx =>
    pushSt_G_of_not_mem u x _ (by rwa [evalP_fst'])
  -- the bit-length pushes
  set V := VbR T S0 B r H with hV
  have gNt := T1 mNt eNtp (by simp [hdrL])
  rw [(xNt hp hA hBb).ev] at gNt
  have gW := T1 mW (NLogN.KFX.pr 7) (by simp [hdrL])
  rw [(xW hp hA hBb).ev] at gW
  have hVge := (VbR_ge (H := H) hp)
  have hNtV : 2 * (B * 2 ^ T * S0 * r) ≤ V := by
    rw [hV]; unfold VbR
    calc 2 * (B * 2 ^ T * S0 * r) = 2 * (B * 2 ^ T * S0) * r * 1 := by ring
      _ ≤ _ := Nat.mul_le_mul_left _ (by omega)
  have eVv : ESp eVx t1 Bb ((V : ℕ) : ℤ) := by
    have a := ESp.ofG gNt (by decide) (zVn hBb hNtV)
    have b := ESp.ofG gW (by decide) (zVn hBb (by omega))
    have c := ESp.add b (ESp.lit (c := 1) (by rw [zsz_one]; omega))
      (by have := zVn hBb (show H + 1 ≤ V by omega); push_cast at this; exact this)
    exact ESp.of_eq (ESp.mul a c (by
      have : ((2 * (B * 2 ^ T * S0 * r) : ℕ) : ℤ) * ((H : ℤ) + 1) = ((V : ℕ) : ℤ) := by
        rw [hV]; unfold VbR; push_cast; ring
      rw [this])) (by rw [hV]; unfold VbR; push_cast; ring)
  have hE2 : ∀ p ∈ NLogN.KFX.zL, ∃ v, ESp p.2 t1 Bb v := by
    intro p hm
    simp only [NLogN.KFX.zL, List.mem_cons, List.not_mem_nil, or_false] at hm
    rcases hm with rfl | rfl
    exacts [⟨_, ESp.lit (by rw [zsz_zero]; omega)⟩, ⟨_, eVv⟩]
  have S2 := (Sp.pushes Bb NLogN.KFX.zL t1 (pushOK_of (by decide) zL_regs hE2)).toIRuns
    (I := I) (iprog := l12prog)
  have e2 : pushSt t1 (NLogN.KFX.zL.map fun p => (p.1, p.2.eval t1)) = ssZ t1 V 0 := by
    simp only [NLogN.KFX.zL, List.map_cons, List.map_nil, pushSt, eVv.ev, Ex.eval]
    apply IState.ext' <;> intros <;> simp [ssZ, IState.upd_G, mA_ne_rX, Ne.symm mA_ne_rX]
  rw [e2] at S2
  -- the loop
  have hV2 : 2 ≤ Bb := by have := hp.mCT; have := mC_eq; omega
  have S3 := loopZ_runs (I := I) (iprog := l12prog) t1 V Bb le_rfl hV2
  set M := zsz ((V : ℕ) : ℤ)
  set t3 := ssZ t1 V M
  have t3G : ∀ x, x ≠ mA → x ≠ rX → t3.G x = t1.G x := fun x h1 h2 => by simp [t3, ssZ, h1, h2]
  -- the masters
  have hVg : (NLogN.KFX.gB N0 N1 N2 N3 K (mC ^ k) r H).V = V := by
    rw [NLogN.KFX.gB, geoB_V, hvol, hV]; unfold VbR; ring
  have hAg : Agree (σMR N0 N1 N2 N3 K (mC ^ k) (e % K) r H (pxR i j) (pyR i j)) t3 := by
    unfold σMR
    have gx : ∀ x ex v, (x, ex) ∈ hdrL → x ≠ mA → x ≠ rX → ESp ex u Bb v →
        ∃ L, t3.G x = .int v :: L := fun x ex v hm h1 h2 hs =>
      ⟨u.G x, by rw [t3G x h1 h2, T1 x ex hm, hs.ev]⟩
    obtain ⟨LF, hLF⟩ := hA (KFW.rowR 0) _ (rowσ_at k K e T S0 B r H i j 0)
    obtain ⟨LK, hLK⟩ := hA (KFW.rowR 1) _ (rowσ_at k K e T S0 B r H i j 1)
    apply agree_σM
    · exact gx _ _ _ (by simp [hdrL]) (by decide) (by decide) (xW hp hA hBb)
    · rw [hvol]
