section Npow
variable {B X : Scheme.{u}} {f : X ⟶ B}

theorem npow_add (β : SchemeHomOver f f) (a b : ℕ) :
    schemeHomOverNpow β (a + b) = NeronModelInfra.schemeHomOverComp (schemeHomOverNpow β a) (schemeHomOverNpow β b) := by
  induction b with
  | zero => simp
  | succ b ih => rw [Nat.add_succ, schemeHomOverNpow_succ, ih, schemeHomOverNpow_succ, schemeHomOverComp_assoc]

theorem npow_mul (β : SchemeHomOver f f) (a b : ℕ) :
    schemeHomOverNpow β (a * b) = schemeHomOverNpow (schemeHomOverNpow β a) b := by
  induction b with
  | zero => simp
  | succ b ih => rw [Nat.mul_succ, npow_add, ih, schemeHomOverNpow_succ]

theorem npow_one_eq (β : SchemeHomOver f f) (a : ℕ) (h : schemeHomOverNpow β a = schemeHomOverId f) (b : ℕ) :
    schemeHomOverNpow β (a * b) = schemeHomOverId f := by
  rw [npow_mul, h]
  induction b with
  | zero => simp
  | succ b ih => rw [schemeHomOverNpow_succ, ih, schemeHomOverComp_id_left]

theorem npow_comp_eq {X' : Scheme.{u}} {B' : Scheme.{u}} {f' : X' ⟶ B'} (gA : X' ⟶ X)
    (β : SchemeHomOver f f) (β' : SchemeHomOver f' f') (h : β'.1 ≫ gA = gA ≫ β.1) (i : ℕ) :
    (schemeHomOverNpow β' i).1 ≫ gA = gA ≫ (schemeHomOverNpow β i).1 := by
  induction i with
  | zero => simp
  | succ i ih =>
    simp only [schemeHomOverNpow_succ, NeronModelInfra.schemeHomOverComp_coe, Category.assoc, h]
    rw [← Category.assoc, ih, Category.assoc]

end Npow

section Hom
variable {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f)

def IsHom (σ : SchemeHomOver f f) : Prop :=
  ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (x y : SchemeHomOver t f),
    NeronModelInfra.schemeHomOverComp (L.mul t x y) σ =
      L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ)

theorem IsHom.one {σ : SchemeHomOver f f} (hσ : IsHom L σ) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    NeronModelInfra.schemeHomOverComp (L.one t) σ = L.one t := by
  letI := L.pointGroup t
  have h := hσ t 1 1
  change NeronModelInfra.schemeHomOverComp ((1 : SchemeHomOver t f) * 1) σ =
    NeronModelInfra.schemeHomOverComp 1 σ * NeronModelInfra.schemeHomOverComp 1 σ at h
  rw [mul_one] at h
  exact mul_left_cancel (h.symm.trans (mul_one _).symm)

theorem IsHom.id : IsHom L (schemeHomOverId f) := by
  intro T t x y; simp

theorem IsHom.comp {σ τ : SchemeHomOver f f} (hσ : IsHom L σ) (hτ : IsHom L τ) :
    IsHom L (NeronModelInfra.schemeHomOverComp σ τ) := by
  intro T t x y
  rw [← schemeHomOverComp_assoc, hσ, hτ, schemeHomOverComp_assoc, schemeHomOverComp_assoc]

theorem IsHom.npow {σ : SchemeHomOver f f} (hσ : IsHom L σ) (i : ℕ) : IsHom L (schemeHomOverNpow σ i) := by
  induction i with
  | zero => exact IsHom.id L
  | succ i ih => rw [schemeHomOverNpow_succ]; exact ih.comp L hσ

theorem IsHom.nsmul {σ : SchemeHomOver f f} (hσ : IsHom L σ) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R))
    (m : ℕ) (x : SchemeHomOver t f) :
    NeronModelInfra.schemeHomOverComp (L.nsmul t m x) σ = L.nsmul t m (NeronModelInfra.schemeHomOverComp x σ) := by
  induction m with
  | zero => simp [hσ.one L t]
  | succ m ih => rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, hσ, ih]

end Hom

theorem exists_unit_three_le_four (k : Type u) [Field k] :
    ∃ ℓ : ℕ, 3 ≤ ℓ ∧ ℓ ≤ 4 ∧ IsUnit ((ℓ : ℕ) : k) := by
  by_cases h3 : ((3 : ℕ) : k) = 0
  · refine ⟨4, by norm_num, le_rfl, ?_⟩
    rw [isUnit_iff_ne_zero]
    intro h4
    have h1 : (1 : k) = ((4 : ℕ) : k) - ((3 : ℕ) : k) := by push_cast; norm_num
    rw [h3, h4, sub_zero] at h1
    exact one_ne_zero h1
  · exact ⟨3, le_rfl, by norm_num, isUnit_iff_ne_zero.mpr h3⟩

theorem iterate_factorial_eq_self {α : Type u} (S : Set α) (hS : S.Finite) (B : ℕ) (hB : S.ncard ≤ B)
    (P : α → α) (hPS : ∀ z ∈ S, P z ∈ S) (hPinj : ∀ z ∈ S, ∀ z' ∈ S, P z = P z' → z = z')
    (z : α) (hz : z ∈ S) : P^[Nat.factorial B] z = z := by
  classical
  haveI : Fintype ↥S := hS.fintype
  let Q : ↥S → ↥S := fun x => ⟨P x.1, hPS x.1 x.2⟩
  have hQinj : Function.Injective Q := fun x y hxy => Subtype.ext (hPinj x.1 x.2 y.1 y.2 (congrArg Subtype.val hxy))
  have hQbij : Function.Bijective Q := Finite.injective_iff_bijective.mp hQinj
  let e : Equiv.Perm ↥S := Equiv.ofBijective Q hQbij
  have hcard : Fintype.card ↥S ≤ B := by
    have : S.ncard = Fintype.card ↥S := by rw [Set.ncard_eq_toFinset_card' S, Set.toFinset_card]
    omega
  have hpow : e ^ Nat.factorial B = 1 := by
    have h1 : e ^ Fintype.card (Equiv.Perm ↥S) = 1 := pow_card_eq_one
    rw [Fintype.card_perm] at h1
    obtain ⟨c, hc⟩ := Nat.factorial_dvd_factorial hcard
    rw [hc, pow_mul, h1, one_pow]
  have hiter : ∀ (m : ℕ) (x : ↥S), ((e ^ m) x).1 = P^[m] x.1 := by
    intro m
    induction m with
    | zero => intro x; simp
    | succ m ih =>
      intro x
      rw [pow_succ', Equiv.Perm.mul_apply, Function.iterate_succ_apply']
      change P ((e ^ m) x).1 = P (P^[m] x.1)
      rw [ih]
  have := hiter (Nat.factorial B) ⟨z, hz⟩
  rw [hpow] at this
  exact this.symm

section Transport
variable {g d n : ℕ} {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
  (u : PolarisedAbelianScheme g d n S) (u' : PolarisedAbelianScheme g d n S')
  (gA : u'.A ⟶ u.A) (hg : CategoryTheory.IsPullback gA u'.f u.f (Spec.map (CommRingCat.ofHom φ)))
  (hgmul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (x y : SchemeHomOver t' u'.f),
    (u'.L.mul t' x y).1 ≫ gA =
      (u.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
        ⟨x.1 ≫ gA, by rw [Category.assoc, hg.w, ← Category.assoc, x.2]⟩
        ⟨y.1 ≫ gA, by rw [Category.assoc, hg.w, ← Category.assoc, y.2]⟩).1)

def push {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (x : SchemeHomOver t' u'.f) :
    SchemeHomOver (t' ≫ Spec.map (CommRingCat.ofHom φ)) u.f :=
  ⟨x.1 ≫ gA, by rw [Category.assoc, hg.w, ← Category.assoc, x.2]⟩

include hgmul in
theorem push_one {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) :
    push φ u u' gA hg t' (u'.L.one t') = u.L.one (t' ≫ Spec.map (CommRingCat.ofHom φ)) := by
  letI := u'.L.pointGroup t'
  letI := u.L.pointGroup (t' ≫ Spec.map (CommRingCat.ofHom φ))
  have hmul : ∀ x y : SchemeHomOver t' u'.f, push φ u u' gA hg t' (x * y) = push φ u u' gA hg t' x * push φ u u' gA hg t' y :=
    fun x y => Subtype.ext (hgmul t' x y)
  exact (MonoidHom.mk' (push φ u u' gA hg t') hmul).map_one

include hgmul in
theorem push_nsmul {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (m : ℕ) (x : SchemeHomOver t' u'.f) :
    push φ u u' gA hg t' (u'.L.nsmul t' m x) = u.L.nsmul (t' ≫ Spec.map (CommRingCat.ofHom φ)) m (push φ u u' gA hg t' x) := by
  induction m with
  | zero => simpa using push_one φ u u' gA hg hgmul t'
  | succ m ih =>
    rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, ← ih]
    exact Subtype.ext (hgmul t' _ _)

end Transport

section Kbar

theorem comp_npow_eq_iterate {B X T : Scheme.{0}} {f : X ⟶ B} {t : T ⟶ B} (τ : SchemeHomOver f f)
    (z : SchemeHomOver t f) (i : ℕ) :
    NeronModelInfra.schemeHomOverComp z (schemeHomOverNpow τ i) =
      (fun w : SchemeHomOver t f => NeronModelInfra.schemeHomOverComp w τ)^[i] z := by
  induction i with
  | zero => simp
  | succ i ih =>
    rw [Function.iterate_succ_apply', ← ih, schemeHomOverNpow_succ, ← schemeHomOverComp_assoc]

theorem npow_factorial_eq_id_of_isAlgClosed {g d n : ℕ} {k : Type} [Field k] [IsAlgClosed k]
    (v : PolarisedAbelianScheme g d n k) (τ : SchemeHomOver v.f v.f) (hτiso : IsIso τ.1) (hτ : IsHom v.L τ)
    (hpol : ∀ s : ↥(Spec (CommRingCat.of k)), ∃ U : (Spec (CommRingCat.of k)).Opens, s ∈ U ∧
      Nonempty ((Scheme.Modules.pullback (v.f ⁻¹ᵁ U).ι).obj ((Scheme.Modules.pullback τ.1).obj v.pol) ≅
        (Scheme.Modules.pullback (v.f ⁻¹ᵁ U).ι).obj v.pol)) :
    schemeHomOverNpow τ (Nat.factorial (4 ^ (2 * g))) = schemeHomOverId v.f := by
  have hfin := AlgebraicGeometry.PolarisedAbelianScheme.exists_schemeHomOverNpow_eq_schemeHomOverId_of_isIso_of_pullback_pol_iso_of_isAlgClosed
    v τ hτiso hτ hpol
  obtain ⟨m, hm, hordm⟩ := hfin
  obtain ⟨ℓ, h3ℓ, hℓ4, hℓu⟩ := exists_unit_three_le_four k
  refine GoodReductionJacobian.AbelianSchemePropertyBundle.eq_schemeHomOverId_of_schemeHomOverNpow_eq_of_forall_isTorsionPoint_of_isUnit_of_three_le
    v.bundle v.L ℓ h3ℓ hℓu (schemeHomOverNpow τ (Nat.factorial (4 ^ (2 * g)))) (hτ.npow v.L _) m hm ?_ ?_
  · rw [← npow_mul, mul_comm, npow_one_eq τ m hordm]
  · intro K _ _ ι y hy
    obtain ⟨φK, rfl⟩ : ∃ φK : k →+* K, ι = Spec.map (CommRingCat.ofHom φK) :=
      ⟨(Spec.preimage ι).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
    have hbc := AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback φK v
    obtain ⟨vK, gK, hgK, hgKmul, -, hgKpol⟩ := hbc
    have haut := AlgebraicGeometry.PolarisedAbelianScheme.exists_schemeHomOver_comp_eq_comp_of_isPullback
      φK v vK gK hgK hgKmul hgKpol τ hτiso hτ hpol
    obtain ⟨τK, hτKiso, hτK, -, hcomm⟩ := haut
    have hτK' : IsHom vK.L τK := hτK

    have wy : y.1 ≫ v.f = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom φK) := by rw [y.2, Category.id_comp]
    let yK : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) vK.f := ⟨hgK.lift y.1 (𝟙 _) wy, hgK.lift_snd _ _ _⟩
    have hyK : yK.1 ≫ gK = y.1 := hgK.lift_fst _ _ _

    have hyKt : vK.L.IsTorsionPoint (𝟙 _) ℓ yK := by
      have hpush : push φK v vK gK hgK (𝟙 _) yK =
          GoodReductionJacobian.schemeHomOverComp (𝟙 _) rfl y := Subtype.ext (by simp [push, hyK])
      have hyt' := v.L.isTorsionPoint_schemeHomOverComp (Spec.map (CommRingCat.ofHom φK))
        (𝟙 _ ≫ Spec.map (CommRingCat.ofHom φK)) (𝟙 _) rfl ℓ hy
      have h1 := push_nsmul φK v vK gK hgK hgKmul (𝟙 _) ℓ yK
      rw [hpush] at h1
      unfold RelativeGroupLaw.IsTorsionPoint at hyt' ⊢
      rw [hyt', ← push_one φK v vK gK hgK hgKmul (𝟙 _)] at h1

      apply Subtype.ext
      refine hgK.hom_ext (congrArg Subtype.val h1) ?_
      rw [(vK.L.nsmul _ ℓ yK).2, (vK.L.one _).2]

    have hℓuK : IsUnit ((ℓ : ℕ) : K) := by simpa using hℓu.map φK
    have hℓ0 : ℓ ≠ 0 := by omega
    have htb := AlgebraicGeometry.PolarisedAbelianScheme.finite_and_ncard_le_setOf_isTorsionPoint_of_isAlgClosed vK ℓ hℓuK hℓ0
    obtain ⟨hTfin, hTcard⟩ := htb
    have hB : {x : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) vK.f | vK.L.IsTorsionPoint (𝟙 _) ℓ x}.ncard ≤ 4 ^ (2 * g) :=
      hTcard.trans (Nat.pow_le_pow_left hℓ4 _)
    haveI := hτKiso
    have key := iterate_factorial_eq_self _ hTfin (4 ^ (2 * g)) hB
      (fun w => NeronModelInfra.schemeHomOverComp w τK)
      (fun z hz => by
        change vK.L.IsTorsionPoint (𝟙 _) ℓ (NeronModelInfra.schemeHomOverComp z τK)
        unfold RelativeGroupLaw.IsTorsionPoint
        rw [← hτK'.nsmul vK.L, show vK.L.nsmul (𝟙 _) ℓ z = vK.L.one (𝟙 _) from hz, hτK'.one vK.L])
      (fun z _ z' _ hzz => by
        apply Subtype.ext
        have := congrArg Subtype.val hzz
        simp only [NeronModelInfra.schemeHomOverComp_coe] at this
        exact (cancel_mono τK.1).mp this)
      yK hyKt
    rw [← comp_npow_eq_iterate] at key

    apply Subtype.ext
    change y.1 ≫ (schemeHomOverNpow τ (Nat.factorial (4 ^ (2 * g)))).1 = y.1
    rw [← hyK, Category.assoc, ← npow_comp_eq gK τ τK hcomm, ← Category.assoc]
    exact congrArg (· ≫ gK) (congrArg Subtype.val key)

end Kbar

theorem main
    {g d n : ℕ} {S : Type} [CommRing S] (u : PolarisedAbelianScheme g d n S)
    (σ : SchemeHomOver u.f u.f) (hσiso : IsIso σ.1)
    (hσ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (x y : SchemeHomOver t u.f),
      NeronModelInfra.schemeHomOverComp (u.L.mul t x y) σ =
        u.L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ))
    (hpol : ∀ s : ↥(Spec (CommRingCat.of S)), ∃ U : (Spec (CommRingCat.of S)).Opens, s ∈ U ∧
      Nonempty ((Scheme.Modules.pullback (u.f ⁻¹ᵁ U).ι).obj ((Scheme.Modules.pullback σ.1).obj u.pol) ≅
        (Scheme.Modules.pullback (u.f ⁻¹ᵁ U).ι).obj u.pol)) :
    ∃ m : ℕ, m ≠ 0 ∧ NeronModelInfra.schemeHomOverNpow σ m = NeronModelInfra.schemeHomOverId u.f := by
  have hσ' : IsHom u.L σ := hσ
  refine ⟨Nat.factorial (4 ^ (2 * g)), Nat.factorial_ne_zero _, ?_⟩
  apply Subtype.ext
  rw [schemeHomOverId_coe]
  refine GoodReductionJacobian.AbelianSchemePropertyBundle.eq_of_one_comp_eq_one_comp_of_forall_comp_eq_comp_of_isAlgClosed
    u.bundle u.L _ (𝟙 _) (schemeHomOverNpow σ _).2 (Category.id_comp _) ?_ ?_
  · rw [Category.comp_id]
    exact congrArg Subtype.val (IsHom.one u.L (IsHom.npow u.L hσ' _) (𝟙 _))
  · intro k _ _ x
    rw [Category.comp_id]
    obtain ⟨φk, hφk⟩ : ∃ φk : S →+* k, x ≫ u.f = Spec.map (CommRingCat.ofHom φk) :=
      ⟨(Spec.preimage (x ≫ u.f)).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
    have hbc := AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback φk u
    obtain ⟨uk, gA, hg, hgmul, -, hgpol⟩ := hbc
    have haut := AlgebraicGeometry.PolarisedAbelianScheme.exists_schemeHomOver_comp_eq_comp_of_isPullback
      φk u uk gA hg hgmul hgpol σ hσiso hσ hpol
    obtain ⟨σk, hσkiso, hσk, hσkpol, hcomm⟩ := haut
    have hk := npow_factorial_eq_id_of_isAlgClosed uk σk hσkiso hσk hσkpol
    have wx : x ≫ u.f = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom φk) := by rw [hφk, Category.id_comp]
    have hxk : hg.lift x (𝟙 _) wx ≫ gA = x := hg.lift_fst _ _ _
    rw [← hxk, Category.assoc, ← npow_comp_eq gA σ σk hcomm, hk, schemeHomOverId_coe, Category.id_comp]

end FinOrd

theorem solution
    {g d n : ℕ} {S : Type} [CommRing S] (u : PolarisedAbelianScheme g d n S)
    (σ : SchemeHomOver u.f u.f) (hσiso : IsIso σ.1)
    (hσ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (x y : SchemeHomOver t u.f),
      NeronModelInfra.schemeHomOverComp (u.L.mul t x y) σ =
        u.L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ))
    (hpol : ∀ s : ↥(Spec (CommRingCat.of S)), ∃ U : (Spec (CommRingCat.of S)).Opens, s ∈ U ∧
      Nonempty ((Scheme.Modules.pullback (u.f ⁻¹ᵁ U).ι).obj ((Scheme.Modules.pullback σ.1).obj u.pol) ≅
        (Scheme.Modules.pullback (u.f ⁻¹ᵁ U).ι).obj u.pol)) :
    ∃ m : ℕ, m ≠ 0 ∧ NeronModelInfra.schemeHomOverNpow σ m = NeronModelInfra.schemeHomOverId u.f :=
  FinOrd.main u σ hσiso hσ hpol

end S_AlgebraicGeometry_PolarisedAbelianScheme_exists_schemeHomOverNpow_eq_schemeHomOverId_of_isIso_of_pullback_pol_iso_of_small
