lemma foldl_mat (gs : List (SGate W)) (A : Matrix W W (ZMod 2)) :
    gs.foldl (fun M g => g.1 * M) A = NetScalar.runMat gs * A := by
  induction gs generalizing A with
  | nil => simp [NetScalar.runMat]
  | cons g gs ih =>
    simp only [List.foldl_cons, NetScalar.runMat]
    rw [ih, ih (g.1 * 1), mul_one, mul_assoc]

lemma runMat_append (l₁ l₂ : List (SGate W)) : NetScalar.runMat (l₁ ++ l₂) = NetScalar.runMat l₂ * NetScalar.runMat l₁ := by
  simp only [NetScalar.runMat, List.foldl_append]
  exact NetScalar.foldl_mat _ _

lemma runMat_cons (g : SGate W) (l : List (SGate W)) : NetScalar.runMat (g :: l) = NetScalar.runMat l * g.1 := by
  rw [show g :: l = [g] ++ l from rfl, NetScalar.runMat_append]
  simp [NetScalar.runMat]

lemma sRun_eq (gs : List (SGate W)) (v : W → ZMod 2) : NetScalar.sRun gs v = NetScalar.runMat gs *ᵥ v := by
  induction gs generalizing v with
  | nil => simp [NetScalar.sRun, NetScalar.runMat]
  | cons g gs ih =>
    simp only [NetScalar.sRun, List.foldl_cons] at ih ⊢
    rw [ih, NetScalar.runMat_cons, ← Matrix.mulVec_mulVec]

lemma scalarRun_labelled {N M : Type*} (lab : N → M) (gs : List (N × SGate W)) (v : W → ZMod 2) :
    scalarRun (NetScalar.labelled lab gs) v = NetScalar.sRun (gs.map Prod.snd) v := by
  induction gs generalizing v with
  | nil => rfl
  | cons g gs ih =>
    simp only [NetScalar.labelled, List.map_cons, scalarRun, NetScalar.sRun, List.foldl_cons] at ih ⊢
    exact ih _

lemma ok_labelled {N M : Type*} [AddGroup M] (lab : N → M) (gs : List (N × SGate W))
    (h : ∀ g ∈ gs, NetScalar.SOK g.2) : ∀ g ∈ NetScalar.labelled lab gs, g.OK := by
  intro g hg
  simp only [NetScalar.labelled, List.mem_map] at hg
  obtain ⟨g', hg', rfl⟩ := hg
  exact h g' hg'

lemma egM_apply {ι : Type*} (A : Finset ι) (r c : ι → W) (w w' : W) :
    NetScalar.egM A r c w w' = ∑ x ∈ A, if r x = w ∧ c x = w' then 1 else 0 := by
  simp [NetScalar.egM, Matrix.sum_apply, single_apply]

lemma egM_mulVec {ι : Type*} (A : Finset ι) (r c : ι → W) (v : W → ZMod 2) (w : W) :
    (NetScalar.egM A r c *ᵥ v) w = ∑ x ∈ A, if r x = w then v (c x) else 0 := by
  simp only [mulVec, dotProduct, NetScalar.egM_apply, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun x _ => ?_
  by_cases h : r x = w <;> simp [h]

lemma egM_ok {ι : Type*} (A : Finset ι) (r c : ι → W) (K : Finset W)
    (hK : ∀ x ∈ A, r x ∈ K ∧ c x ∈ K) : NetScalar.SOK ((1 + NetScalar.egM A r c, K) : SGate W) := by
  intro w w'
  refine ⟨fun hw => ?_, fun hw hw' => ?_⟩
  · simp only [Matrix.add_apply, one_apply, NetScalar.egM_apply]
    rw [Finset.sum_eq_zero, add_zero]
    intro x hx
    have : r x ≠ w := fun h => hw (h ▸ (hK x hx).1)
    simp [this]
  · simp only [Matrix.add_apply, one_apply, NetScalar.egM_apply]
    have hne : w ≠ w' := fun h => hw' (h ▸ hw)
    rw [Finset.sum_eq_zero]
    · simp [hne]
    intro x hx
    have : c x ≠ w' := fun h => hw' (h ▸ (hK x hx).2)
    simp [this]

lemma egM_mul {ι κ : Type*} (A : Finset ι) (r c : ι → W) (B : Finset κ) (r' c' : κ → W) :
    NetScalar.egM A r c * NetScalar.egM B r' c' =
      ∑ x ∈ A, ∑ y ∈ B, if c x = r' y then (single (r x) (c' y) (1 : ZMod 2) : Matrix W W (ZMod 2)) else 0 := by
  simp only [NetScalar.egM, Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun x _ => ?_
  refine Finset.sum_congr rfl fun y _ => ?_
  by_cases h : c x = r' y
  · simp [h]
  · simp [h]

lemma egM_mul_zero {ι κ : Type*} (A : Finset ι) (r c : ι → W) (B : Finset κ) (r' c' : κ → W)
    (h : ∀ x y, c x ≠ r' y) : NetScalar.egM A r c * NetScalar.egM B r' c' = 0 := by
  rw [NetScalar.egM_mul]
  exact Finset.sum_eq_zero fun x _ => Finset.sum_eq_zero fun y _ => by simp [h x y]

/-- Blocks whose net effects `1 + f i` pairwise compose to zero products run as `1 + ∑ f`. -/
lemma runMat_flatMap {ι : Type*} (L : List ι) (blk : ι → List (SGate W))
    (f : ι → Matrix W W (ZMod 2)) (hb : ∀ i ∈ L, NetScalar.runMat (blk i) = 1 + f i)
    (hz : ∀ i ∈ L, ∀ j ∈ L, f i * f j = 0) :
    NetScalar.runMat (L.flatMap blk) = 1 + (L.map f).sum := by
  induction L with
  | nil => simp [NetScalar.runMat]
  | cons i L ih =>
    rw [List.flatMap_cons, NetScalar.runMat_append, ih (fun j hj => hb j (List.mem_cons_of_mem _ hj))
      (fun a ha b hb' => hz a (List.mem_cons_of_mem _ ha) b (List.mem_cons_of_mem _ hb')),
      hb i List.mem_cons_self]
    have : (L.map f).sum * f i = 0 := by
      rw [← List.sum_map_mul_right]
      exact List.sum_eq_zero fun x hx => by
        obtain ⟨j, hj, rfl⟩ := List.mem_map.1 hx
        exact hz j (List.mem_cons_of_mem _ hj) i List.mem_cons_self
    rw [List.map_cons, List.sum_cons]
    simp only [mul_add, add_mul, one_mul, mul_one, this]
    abel

lemma runMat_map {ι : Type*} (L : List ι) (g : ι → SGate W)
    (f : ι → Matrix W W (ZMod 2)) (hb : ∀ i ∈ L, (g i).1 = 1 + f i)
    (hz : ∀ i ∈ L, ∀ j ∈ L, f i * f j = 0) :
    NetScalar.runMat (L.map g) = 1 + (L.map f).sum := by
  rw [show L.map g = L.flatMap fun i => [g i] by induction L <;> simp_all]
  exact NetScalar.runMat_flatMap L _ f (fun i hi => by simp [NetScalar.runMat, hb i hi]) hz

