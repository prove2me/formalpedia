                                                                                                                                                | ((ring_nf); (omega)))))
  have hw := wrote_succ (μ := μ) (dst := x.out) (f := fun q => Light.Sec3.bit (aeHit x.n x.AB x.BC x.AC q))
    (j := a * x.n + b)
  simp only [aeWrote] at hw ⊢
