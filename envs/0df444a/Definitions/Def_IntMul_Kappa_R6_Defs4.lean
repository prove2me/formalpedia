section
-- Source module: Solutions.R6BitNBPiv
/-!
# Round six, bit network: pivots from ranks, and edges from pivots

* `rk q X Y`: rank of the rows `< X`, columns `≥ Y` of `q`; `IsPiv q i j`: the
  inclusion–exclusion of `rk` at `(i, j)` is one.
* `isPiv_iff`: for a Bruhat factorization `E₁ P E₂`, `IsPiv` is exactly `P i j = 1`.
* `edge_of_pivs`: for an idempotent `q` over `ℚ` and runs whose positions are pivots of `q`, there
  is an edge (lower triangular `E₁, E₂`, nonzero diagonals) with runs `rs ++ rs'`, `rs'` singletons,
  `|rs| + |rs'| = rank q`, and frame `E₁ σ E₂ = pswQ q` (the partial swap of `q`).
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset

section Piv

variable {K : Type*} [Field K] {n a b : ℕ}

/-- Rank of the rows `< X` and columns `≥ Y`. -/
noncomputable def rk (q : Matrix (Fin a) (Fin b) K) (X Y : ℕ) : ℕ :=
  (q.submatrix (fun r : {r : Fin a // r.val < X} => r.1)
    (fun c : {c : Fin b // Y ≤ c.val} => c.1)).rank

/-- `(i, j)` is a pivot: the rank inclusion–exclusion at `(i, j)` is one. -/
def IsPiv (q : Matrix (Fin a) (Fin b) K) (i j : ℕ) : Prop :=
  rk q (i + 1) j + rk q i (j + 1) = rk q i j + rk q (i + 1) (j + 1) + 1

end Piv

/-! ## Products of disjoint transpositions -/

section Swaps

variable {α : Type*} [DecidableEq α]

/-- Pairwise disjoint pairs. -/
def PDisj (p q : α × α) : Prop := p.1 ≠ q.1 ∧ p.1 ≠ q.2 ∧ p.2 ≠ q.1 ∧ p.2 ≠ q.2

end Swaps

/-! ## Edges from pivots -/

section Edge

variable {m : ℕ}

/-- The partial swap `[[1 - q, q], [q, 1 - q]]` over `ℚ`. -/
def pswQ (q : Matrix (Fin m) (Fin m) ℚ) : QMat2 m :=
  (Matrix.fromBlocks (1 - q) q q (1 - q)).submatrix finSumFinEquiv.symm finSumFinEquiv.symm

/-- Positions of a list of runs. -/
def runPairs (rs : List (ℕ × ℕ × ℕ)) : List (ℕ × ℕ) :=
  rs.flatMap fun ρ => (List.range ρ.2.2).map fun k => (ρ.1 + k, ρ.2.1 + k)

/-- A position as a pair of frame fields. -/
def finPair (m : ℕ) (x : ℕ × ℕ) : Option (Fin (m + m) × Fin (m + m)) :=
  if h : x.1 < m ∧ x.2 < m then some (Fin.castAdd m ⟨x.1, h.1⟩, Fin.natAdd m ⟨x.2, h.2⟩) else none

end Edge

end IntMul.Kappa.R6.Bit.NB

end

section
-- Source module: Solutions.R6BitNBFlag
/-!
# Round six, bit network: the flag basis

The edge projectors are `q = S X S⁻¹` with `X` a Kronecker product on pairs `Fin n × Fin n`
(`n = h + 4`), `S = Π T K`, `K = Uᵀ ⊗ Vᵀ`. Here `T` is a unipotent change of coordinates on pairs
and `Π` an ordering of the pairs (`flagEquiv`) such that the first `k = 2n - 1` rows of `Π T` are
the sparse vectors `λ_β, ν_δ` (`Lterms`) and the last `k` columns of `T⁻¹ Πᵀ` are `ω_ε, μ_γ`
(`Rterms`). Everything here is for a pair matrix `M` (later `M = K X K⁻¹`):
`qM M = (T M T⁻¹)` reordered by `flagEquiv`.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset

section Flag

variable {h : ℕ}

/-- Pairs. -/
abbrev Pr (n : ℕ) := Fin n × Fin n

/-- A sparse vector on pairs. -/
def sv {n : ℕ} (l : List (ℚ × Pr n)) (u : Pr n) : ℚ :=
  (l.map fun s => if s.2 = u then s.1 else 0).sum

/-- Rows `λ_β` (`i < n`) and `ν_δ` (`i = n + δ`) of `S₀`. -/
def Lterms (i : ℕ) : List (ℚ × Pr (h + 4)) :=
  if h1 : i < h + 3 then [(1, (⟨i, by omega⟩, ⟨i, by omega⟩))]
  else if i = h + 3 then [(1, (⟨h + 3, by omega⟩, ⟨0, by omega⟩)),
    (-1, (⟨0, by omega⟩, ⟨h + 3, by omega⟩))]
  else if h2 : i < 2 * h + 6 then [(1, (⟨i - (h + 4), by omega⟩, ⟨i - (h + 4) + 1, by omega⟩))]
  else if i = 2 * h + 6 then [(1, (⟨h + 3, by omega⟩, ⟨1, by omega⟩)),
    (-1, (⟨1, by omega⟩, ⟨h + 3, by omega⟩))]
  else []

/-- Columns `ω_ε` (`j < n - 1`) and `μ_γ` (`j = n - 1 + γ`) of `S₀⁻¹`. -/
def Rterms (j : ℕ) : List (ℚ × Pr (h + 4)) :=
  if h1 : j < h + 2 then [(1, (⟨j + 1, by omega⟩, ⟨j, by omega⟩))]
  else if j = h + 2 then [(1, (⟨0, by omega⟩, ⟨h + 2, by omega⟩))]
  else if h2 : j < 2 * h + 6 then [(1, (⟨j - (h + 3), by omega⟩, ⟨h + 3, by omega⟩)),
    (1, (⟨h + 3, by omega⟩, ⟨j - (h + 3), by omega⟩))]
  else if j = 2 * h + 6 then [(1, (⟨h + 3, by omega⟩, ⟨h + 3, by omega⟩))]
  else []

/-- The coordinate carrying row `i`. -/
def aL (i : ℕ) : Pr (h + 4) :=
  if h1 : i < h + 3 then (⟨i, by omega⟩, ⟨i, by omega⟩)
  else if i = h + 3 then (⟨h + 3, by omega⟩, ⟨0, by omega⟩)
  else if h2 : i < 2 * h + 6 then (⟨i - (h + 4), by omega⟩, ⟨i - (h + 4) + 1, by omega⟩)
  else (⟨h + 3, by omega⟩, ⟨1, by omega⟩)

/-- The coordinate carrying column `j` (counted from `m - k`). -/
def bL (j : ℕ) : Pr (h + 4) :=
  if h1 : j < h + 2 then (⟨j + 1, by omega⟩, ⟨j, by omega⟩)
  else if j = h + 2 then (⟨0, by omega⟩, ⟨h + 2, by omega⟩)
  else if h2 : j < 2 * h + 6 then (⟨j - (h + 3), by omega⟩, ⟨h + 3, by omega⟩)
  else (⟨h + 3, by omega⟩, ⟨h + 3, by omega⟩)

/-- The nilpotent part of `T`. -/
def Nm : Matrix (Pr (h + 4)) (Pr (h + 4)) ℚ := Matrix.of fun u v =>
  if u.1.val = h + 3 ∧ u.2.val < h + 3 ∧ v.1 = u.2 ∧ v.2.val = h + 3 then 1 else 0

/-- `T = 1 - Nm`, `T⁻¹ = 1 + Nm`. -/
def Tm : Matrix (Pr (h + 4)) (Pr (h + 4)) ℚ := 1 - Nm
def Ti : Matrix (Pr (h + 4)) (Pr (h + 4)) ℚ := 1 + Nm

lemma pr_eq_iff {a b c d : Fin (h + 4)} : ((a, b) : Pr (h + 4)) = (c, d) ↔
    a.val = c.val ∧ b.val = d.val := by
  simp [Prod.ext_iff, Fin.ext_iff]

lemma aL_inj {i i' : ℕ} (hi : i < 2 * h + 7) (hi' : i' < 2 * h + 7) (e : aL (h := h) i = aL i') :
    i = i' := by
  simp only [aL] at e
  split_ifs at e <;> simp only [pr_eq_iff] at e <;> omega

lemma bL_inj {j j' : ℕ} (hj : j < 2 * h + 7) (hj' : j' < 2 * h + 7) (e : bL (h := h) j = bL j') :
    j = j' := by
  simp only [bL] at e
  split_ifs at e <;> simp only [pr_eq_iff] at e <;> omega

lemma aL_ne_bL {i j : ℕ} (hi : i < 2 * h + 7) (hj : j < 2 * h + 7) : aL (h := h) i ≠ bL j := by
  intro e
  simp only [aL, bL] at e
  split_ifs at e <;> simp only [pr_eq_iff] at e <;> omega

lemma two_k_le : 2 * (2 * h + 7) ≤ (h + 4) * (h + 4) := by nlinarith

lemma exists_flagEquiv : ∃ e : Fin ((h + 4) * (h + 4)) ≃ Pr (h + 4),
    (∀ i (hi : i < 2 * h + 7), e ⟨i, by have := two_k_le (h := h); omega⟩ = aL i) ∧
    (∀ j (hj : j < 2 * h + 7),
      e ⟨(h + 4) * (h + 4) - (2 * h + 7) + j, by have := two_k_le (h := h); omega⟩ = bL j) := by
  classical
  have hk := two_k_le (h := h)
  let φ : Fin (2 * h + 7) ⊕ Fin (2 * h + 7) → Pr (h + 4) := Sum.elim (fun i => aL i) (fun j => bL j)
  let ψ : Fin (2 * h + 7) ⊕ Fin (2 * h + 7) → Fin ((h + 4) * (h + 4)) :=
    Sum.elim (fun i => ⟨i.val, by omega⟩) (fun j => ⟨(h + 4) * (h + 4) - (2 * h + 7) + j.val, by omega⟩)
  have hφ : Function.Injective φ := by
    rintro (i | i) (j | j) e <;> simp only [φ, Sum.elim_inl, Sum.elim_inr] at e
    · exact congrArg Sum.inl (Fin.ext (aL_inj i.isLt j.isLt e))
    · exact absurd e (aL_ne_bL i.isLt j.isLt)
    · exact absurd e.symm (aL_ne_bL j.isLt i.isLt)
    · exact congrArg Sum.inr (Fin.ext (bL_inj i.isLt j.isLt e))
  let F₀ : Fin ((h + 4) * (h + 4)) ≃ Pr (h + 4) := finProdFinEquiv.symm
  have hψ : Function.Injective (F₀ ∘ ψ) := by
    refine F₀.injective.comp ?_
    rintro (i | i) (j | j) e <;> simp only [ψ, Sum.elim_inl, Sum.elim_inr, Fin.mk.injEq] at e
    · exact congrArg Sum.inl (Fin.ext e)
    · have := i.isLt; omega
    · have := j.isLt; omega
    · exact congrArg Sum.inr (Fin.ext (by omega))
  let E : {x // x ∈ Set.range (F₀ ∘ ψ)} ≃ {x // x ∈ Set.range φ} :=
    (Equiv.ofInjective _ hψ).symm.trans (Equiv.ofInjective _ hφ)
  let σ := E.extendSubtype
  have key : ∀ s, F₀.trans σ (ψ s) = φ s := by
    intro s
    simp only [Equiv.trans_apply, σ]
    rw [Equiv.extendSubtype_apply_of_mem E (F₀ (ψ s)) ⟨s, rfl⟩]
    have h1 : (Equiv.ofInjective _ hψ).symm ⟨F₀ (ψ s), ⟨s, rfl⟩⟩ = s := by
      apply hψ
      exact Equiv.apply_ofInjective_symm hψ _
    simp only [E, Equiv.trans_apply, h1]
    rfl
  exact ⟨F₀.trans σ, fun i hi => key (Sum.inl ⟨i, hi⟩), fun j hj => key (Sum.inr ⟨j, hj⟩)⟩

/-- The ordering of the pairs. -/
noncomputable def flagEquiv : Fin ((h + 4) * (h + 4)) ≃ Pr (h + 4) :=
  Classical.choose (exists_flagEquiv (h := h))

/-- The edge projector of a pair matrix `M`, in the flag basis. -/
noncomputable def qM (M : Matrix (Pr (h + 4)) (Pr (h + 4)) ℚ) :
    Matrix (Fin ((h + 4) * (h + 4))) (Fin ((h + 4) * (h + 4))) ℚ :=
  (Tm * M * Ti).submatrix flagEquiv flagEquiv

/-- The corner entries. -/
def cor (M : Matrix (Pr (h + 4)) (Pr (h + 4)) ℚ) (i j : ℕ) : ℚ :=
  ((Rterms j).map fun t => ((Lterms i).map fun s => s.1 * M s.2 t.2).sum * t.1).sum

end Flag

end IntMul.Kappa.R6.Bit.NB

end

section
-- Source module: Solutions.R6BitNBCert
/-!
# Round six, bit network: kernel certificate for the data corner (`h = 23`)

At the witness labels `x₁ = 1`, `y₁ = (-21, 1, …, 1)`, `x₂ = (1, 2, …, 2)`,
`y₂ = (-41, 1, …, 1, 0)` (both pairs with `y ⬝ x = 1`) the `45 × 45` corner of the data-entrance
projector is invertible: modulo `p = 2³¹ - 1` it has the explicit inverse `certCols`
(checked by the kernel with list arithmetic, `decide +kernel`).
-/

set_option Elab.async false

namespace IntMul.Kappa.R6.Bit.NB

open Matrix
open scoped Kronecker

section Cert

/-- Integer versions of `Lterms`, `Rterms`. -/
def LtermsZ (h i : ℕ) : List (ℤ × Pr (h + 4)) :=
  if h1 : i < h + 3 then [(1, (⟨i, by omega⟩, ⟨i, by omega⟩))]
  else if i = h + 3 then [(1, (⟨h + 3, by omega⟩, ⟨0, by omega⟩)),
    (-1, (⟨0, by omega⟩, ⟨h + 3, by omega⟩))]
  else if h2 : i < 2 * h + 6 then [(1, (⟨i - (h + 4), by omega⟩, ⟨i - (h + 4) + 1, by omega⟩))]
  else if i = 2 * h + 6 then [(1, (⟨h + 3, by omega⟩, ⟨1, by omega⟩)),
    (-1, (⟨1, by omega⟩, ⟨h + 3, by omega⟩))]
  else []

def RtermsZ (h j : ℕ) : List (ℤ × Pr (h + 4)) :=
  if h1 : j < h + 2 then [(1, (⟨j + 1, by omega⟩, ⟨j, by omega⟩))]
  else if j = h + 2 then [(1, (⟨0, by omega⟩, ⟨h + 2, by omega⟩))]
  else if h2 : j < 2 * h + 6 then [(1, (⟨j - (h + 3), by omega⟩, ⟨h + 3, by omega⟩)),
    (1, (⟨h + 3, by omega⟩, ⟨j - (h + 3), by omega⟩))]
  else if j = 2 * h + 6 then [(1, (⟨h + 3, by omega⟩, ⟨h + 3, by omega⟩))]
  else []

/-- Integer corner entries. -/
def corZ {h : ℕ} (M : Matrix (Pr (h + 4)) (Pr (h + 4)) ℤ) (i j : ℕ) : ℤ :=
  ((RtermsZ h j).map fun t => ((LtermsZ h i).map fun s => s.1 * M s.2 t.2).sum * t.1).sum

/-! ## List arithmetic -/

def dotL : List ℕ → List ℕ → ℕ
  | a :: as, b :: bs => a * b + dotL as bs
  | _, _ => 0

/-- The product check: `rows · cols ≡ 1 (mod p)`. -/
def certChk (rows cols : List (List ℕ)) (k p : ℕ) : Bool :=
  (rows.length == k) && (cols.length == k) && rows.all (fun r => r.length == k) &&
    cols.all (fun c => c.length == k) &&
    (List.range k).all fun i => (List.range k).all fun j =>
      dotL (rows.getD i []) (cols.getD j []) % p == if i = j then 1 else 0

