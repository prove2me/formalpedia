  have hKap : (d / 2 + 1) * (68 * kap (p + 2) * (2 * T)) ≤ 28696 * ((d + 1) * T * p) :=
    calc (d / 2 + 1) * (68 * kap (p + 2) * (2 * T)) ≤ (d + 1) * (68 * (211 * p) * (2 * T)) :=
