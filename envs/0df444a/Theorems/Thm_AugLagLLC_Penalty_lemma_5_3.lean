-- name    : AugLagLLC.Penalty.lemma_5_3
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T09:38:22.544316+00:00
-- url     : https://prove2.me/theorems/1a35f0d0-25e3-4f4b-9cc7-fed0abc63190
-- title:
--   Lemma 5.3, pp. 11–12 — if ρₖ ≥ ρ̄ eventually, ‖xₖ − x_*‖ and ‖λₖ₊₁ − λ_*‖ are O(max{‖λ̄ₖ − λ_*‖∞/ρₖ, ‖αₖ‖, ‖βₖ‖}) for k large
-- statement:
--   Consider problem (5.1) and a sequence $\{x_k\}$ generated by Algorithm 3.1 with the safeguard of §5.1. Suppose Assumptions 1–5 hold: $x_k\to x_*$, $x_*$ is feasible, the constraint gradients at $x_*$ are linearly independent, $f,h_1,h_2$ are twice continuously differentiable near $x_*$, and the second-order sufficient condition holds at $x_*$ with multipliers $\lambda_*,v_*$. Let $\bar\rho>0$ be as in Lemma 5.2 (the matrix of Lemma 5.2 is nonsingular for every $\pi\in[0,1/\bar\rho]$), and suppose there is $k_0$ with $\rho_k\ge\bar\rho$ for all $k\ge k_0$. Define
--   $$\alpha_k=\nabla L(x_k,\bar\lambda_k,\rho_k)+\nabla h_2(x_k)v_k,\qquad \beta_k=h_2(x_k). \tag{5.2–5.3}$$
--   Then there are $M>0$ and $k_1$ such that, for all $k\ge k_1$,
--   $$\|x_k-x_*\|\le M\max\Big\{\frac{\|\bar\lambda_k-\lambda_*\|_\infty}{\rho_k},\|\alpha_k\|,\|\beta_k\|\Big\}, \tag{5.4}$$
--   $$\|\lambda_{k+1}-\lambda_*\|\le M\max\Big\{\frac{\|\bar\lambda_k-\lambda_*\|_\infty}{\rho_k},\|\alpha_k\|,\|\beta_k\|\Big\}. \tag{5.5}$$
--
--   These are the error bounds that drive the proof of Theorem 5.4: (5.4) yields (5.10), and (5.5) bounds $\|\lambda_k-\lambda_*\|_\infty$ by $3M\|h_1(x_{k-1})\|_\infty$.
--
--   **Formalization Note** The page states (5.4)–(5.5) "for all $k\in\mathbb N$". That is false at early iterations: with $n=1$, $h_1(x)=x$, $f(x)=-x+\psi(x)$, $\psi=0$ near $0$ and $\psi'(5)=-5\rho_1$, and $\bar\lambda_1=\lambda_*=1$, the point $x_1=5$ is an exact stationary point of the first subproblem, so $\alpha_1=\beta_1=0$ and $\bar\lambda_1-\lambda_*=0$, while $\|x_1-x_*\|=5$. The proof's implicit-function argument is local around $(x_*,\lambda_*,v_*)$, and Theorem 5.4 uses the bounds only for $k$ large, so the conclusion is stated for $k\ge k_1$. The norm on $x$ and on $\alpha_k$ is Euclidean; the norm on $\lambda$ and on $\beta_k$ is the sup norm (the page's norm is arbitrary, and $M$ absorbs the change). $\lambda_{k+1}$ is `P.lamNext x ρ lamBar k`. "Let $\bar\rho$ be as in Lemma 5.2" is the hypothesis that $\bar\rho>0$ has Lemma 5.2's property.
-- source:
--   Andreani, Birgin, Martínez & Schuverdt, On augmented Lagrangian methods with general lower-level constraints, HAL hal-01295437v1, pp. 11–12, Lemma 5.3, (5.2)–(5.5)

import Mathlib
import Definitions.Def_AugLagLLC_Penalty_SecondOrder

open Filter
open scoped Topology

namespace AugLagLLC.Penalty

/-- Lemma 5.3, pp. 11–12, for `k` large: under Assumptions 1–5, if `ρ̄ > 0` has the property of
Lemma 5.2 and `ρₖ ≥ ρ̄` for all `k ≥ k₀`, then with
`αₖ = ∇L(xₖ, λ̄ₖ, ρₖ) + ∇h₂(xₖ) vₖ` (5.2) and `βₖ = h₂(xₖ)` (5.3) there are `M > 0` and `k₁`
such that for all `k ≥ k₁`
(5.4) `‖xₖ − x_*‖ ≤ M max{‖λ̄ₖ − λ_*‖∞ / ρₖ, ‖αₖ‖, ‖βₖ‖}` and
(5.5) `‖λₖ₊₁ − λ_*‖∞ ≤ M max{‖λ̄ₖ − λ_*‖∞ / ρₖ, ‖αₖ‖, ‖βₖ‖}`.
The page says "for all `k ∈ ℕ`"; the conclusion is stated for `k ≥ k₁`, because the bound can
fail at early iterations (the proof's implicit-function argument is local around `x_*`). -/
theorem lemma_5_3
    {n m1 m2 : ℕ} (P : Problem n m1 0 m2 0) (hP : P.IsC1)
    {τ γ ρ1 : ℝ} {lamMin lamMax : Fin m1 → ℝ} {muMax : Fin 0 → ℝ} {ε : ℕ → ℝ}
    (hpar : Problem.IsParams τ γ ρ1 lamMin lamMax muMax ε)
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {ρ : ℕ → ℝ} {lamBar : ℕ → Fin m1 → ℝ}
    {muBar : ℕ → Fin 0 → ℝ} {v : ℕ → Fin m2 → ℝ} {u : ℕ → Fin 0 → ℝ}
    -- Assumption 1: a run of Algorithm 3.1 on (5.1), with the safeguard Definition of §5.1
    (hrun : P.IsProjRun τ γ ρ1 lamMin lamMax muMax ε x ρ lamBar muBar v u)
    {xs : EuclideanSpace ℝ (Fin n)} (hlim : Tendsto x atTop (𝓝 xs))
    -- Assumption 2
    (hfeas : xs ∈ P.Omega1 ∩ P.Omega2)
    -- Assumption 3
    (hLI : LinearIndependent ℝ
      (Sum.elim (fun i => gradient (P.h1 i) xs) (fun i => gradient (P.h2 i) xs)))
    -- Assumption 4
    (hC2 : P.IsC2At xs)
    -- Assumption 5
    (lamS : Fin m1 → ℝ) (vS : Fin m2 → ℝ) (hSOSC : P.SOSC0 lamS vS xs)
    -- `ρ̄` as in Lemma 5.2
    (ρbar : ℝ) (hρbar : 0 < ρbar)
    (hρbar_inj : ∀ π ∈ Set.Icc (0 : ℝ) (1 / ρbar), Function.Injective (P.kktMap lamS vS xs π))
    (hk0 : ∃ k0 : ℕ, ∀ k, k0 ≤ k → ρbar ≤ ρ k) :
    ∃ M : ℝ, 0 < M ∧ ∃ k1 : ℕ, ∀ k, k1 ≤ k →
      -- (5.4)
      ‖x k - xs‖ ≤ M * max (‖lamBar k - lamS‖ / ρ k)
        (max ‖gradient (fun y => P.augLag y (lamBar k) (muBar k) (ρ k)) (x k)
              + ∑ i, v k i • gradient (P.h2 i) (x k)‖
          ‖P.h2vec (x k)‖) ∧
      -- (5.5)
      ‖P.lamNext x ρ lamBar k - lamS‖ ≤ M * max (‖lamBar k - lamS‖ / ρ k)
        (max ‖gradient (fun y => P.augLag y (lamBar k) (muBar k) (ρ k)) (x k)
              + ∑ i, v k i • gradient (P.h2 i) (x k)‖
          ‖P.h2vec (x k)‖) := by sorry

end AugLagLLC.Penalty
