      (fun v => v 20 = ((2 * (pre * (t * post)) : ℕ) : ℤ) ∧ BV W v) c
      (cRdK 1 W + (cRdK 2 W + (cRdK 4 W + J6Seg.PJ.cT nE W))) := by
