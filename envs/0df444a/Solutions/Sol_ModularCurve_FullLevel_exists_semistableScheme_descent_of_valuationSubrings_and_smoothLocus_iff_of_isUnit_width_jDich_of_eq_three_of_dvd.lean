    obtain ⟨i, hi, huniq⟩ := huniq₀ (pr.base x) hx₀ hxcl₀ hxnd₀
    refine ⟨i, (hspec_iff (gen i) x (hgen_sp i) hx).mpr (by rw [hgen]; exact hi), fun j hj => huniq j ?_⟩
    show gen₀ j ⤳ pr.base x
    rw [← hgen j]; exact (hspec_iff (gen j) x (hgen_sp j) hx).mp hj
  ·
    intro x hx hxcl a
    set ĵ : ↥(fieldBar q M') := (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) with hĵ
    set c : ↥(fieldBar q M') := algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (a : AlgebraicClosure ℚ) with hc

    have hx₀ : toBase₀.base (pr.base x) = closedPoint A₀ := (hsp_iff x).mp hx
    have hxcl₀ : ∀ y : X₀, pr.base x ⤳ y → y = pr.base x := by
      intro y₀ hy₀
      obtain ⟨y, hy⟩ := hsp_surj y₀ (hsp₀ _ _ hx₀ hy₀)
      have hysp : toBase.base y = closedPoint ↥A := (hsp_iff y).mpr (by rw [hy]; exact hsp₀ _ _ hx₀ hy₀)
      have hxy : x ⤳ y := (hspec_iff x y hx hysp).mpr (by rw [hy]; exact hy₀)
      rw [← hy, hxcl y hxy]

    have hconst : ∀ b : ↥A, algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (b : AlgebraicClosure ℚ) ∈
        SemistableModel.localRing X φ x := by
      intro b
      refine ⟨(X.presheaf.germ ⊤ x trivial).hom (toBase.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of ↥A)).inv.hom b)), ?_⟩
      show φ.symm (algebraMap _ _ _) = _
      rw [RingEquiv.symm_apply_eq, hφM]
      change (X.presheaf.stalkSpecializes (genericPoint_specializes x)).hom ((X.presheaf.germ ⊤ x trivial).hom _) =
        (X.presheaf.germ ⊤ (genericPoint X) trivial).hom _
      rw [TopCat.Presheaf.germ_stalkSpecializes_apply]
      rfl

    have hloc : ∀ u ∈ SemistableModel.localRing X φ x,
        (∃ w ∈ SemistableModel.localRing X φ x, u * w = 1) ∨ (∃ w ∈ SemistableModel.localRing X φ x, (1 - u) * w = 1) := by
      rintro u ⟨z, rfl⟩
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self z with hz | hz
      · obtain ⟨w, hw⟩ := hz.exists_right_inv
        left
        exact ⟨_, ⟨w, rfl⟩, by rw [← map_mul, hw, map_one]⟩
      · obtain ⟨w, hw⟩ := hz.exists_right_inv
        right
        refine ⟨_, ⟨w, rfl⟩, ?_⟩
        rw [show (1 : ↥(fieldBar q M')) - (φ.symm.toRingHom.comp (algebraMap (X.presheaf.stalk x) X.functionField)) z =
          (φ.symm.toRingHom.comp (algebraMap (X.presheaf.stalk x) X.functionField)) (1 - z) by rw [map_sub, map_one],
          ← map_mul, hw, map_one]

    have hJx : ĵ ∈ SemistableModel.localRing X φ x ∨ ĵ⁻¹ ∈ SemistableModel.localRing X φ x := by
      rcases hJ₀ hjF₀ (pr.base x) hx₀ hxcl₀ with h | h
      · exact Or.inl (htransport x _ h)
      · exact Or.inr (by simpa using htransport x _ h)

