theorem BianchiIX.projectiveOriginalField_fderiv {y : ProjectiveState}
    (hD : projectiveStateDenom y ≠ 0) (xi : ProjectiveState) :
    fderiv ℝ projectiveOriginalField y xi =
      (6 / projectiveStateDenom y) • fderiv ℝ projectiveField y xi -
      (6 * fderiv ℝ projectiveStateDenom y xi / projectiveStateDenom y ^ 2) • projectiveField y := by sorry
