-- Source module: Solutions.J6SegAxA7
/-!
# `A`-line axis program (`AxisUA6`), part 7: assembly

**`AKerNeedA6 P`** (the numeric leaf of the `A` axis): eventually, for every axis, kernel
parameters satisfying `AKCond` (`J6SegAxA5`; `pk = 8p + 16`, `b = 17p + 40`, input bound
`p + 2`, `2^f = 8H`) and the nine non-set-up cost terms of `axACost` (six fine exposures, two
slab passes, the kernel run) each `≤ Cb · cU6 P n A / (D + 1)`.

**`axisUA6_of`**: `AxisUA6 P tab` from `FineU6 tab`, `PreA6 P 8 16 17 40 tab` (B4, the kernel
register set-up), `AStepNeed6 P` (A worker, the copy step and the descriptor set-ups) and
`AKerNeedA6 P`. The descriptor stack is `dA = 31` (`30` when the fine stack is `31`), the kernel
registers `ρK dF` (`10 … 29` without `dF`), the kernel `aKprog2` and the axis body are the
machine's own two procedures.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab

theorem dAA6_cases (dF : Fin HS) : (dAA6 dF = 30 ∧ dF = 31) ∨ (dAA6 dF = 31 ∧ dF ≠ 31) := by
  unfold dAA6; by_cases h : dF = 31 <;> simp [h]

theorem dAA6_free (dF : Fin HS) : SlabFree (dAA6 dF) := by
  rcases dAA6_cases dF with ⟨h, -⟩ | ⟨h, -⟩ <;> rw [h] <;>
  · refine ⟨by decide, by decide, fun i => ?_, by decide, by decide, by decide, by decide⟩
    fin_cases i <;> decide

theorem AxisBodyA6.mono {Pp : ℕ} {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D : ℕ} {Isym : List Sym}
    {tbl : Fin Pp → IStmt HS Pp} {eX : Fin Pp} {dA : Fin HS} {C C' : ℝ}
    (h : AxisBodyA6 P n src D Isym tbl eX dA C) (hC : C ≤ C') :
    AxisBodyA6 P n src D Isym tbl eX dA C' := fun k hk s F L l h1 h2 h3 h4 h5 => by
  obtain ⟨c, r, kc⟩ := h k hk s F L l h1 h2 h3 h4 h5; exact ⟨c, r, kc.trans hC⟩

set_option maxHeartbeats 8000000 in
/-- **`AxisUA6` from the `A`-line components.** -/
theorem axisUA6_of_sol_aux (P : Prm) (hP : P.Ok) (hStep : AStepNeed6 P) (hKer : AKerNeedA6 P)
    (tab : Fin 1 → IStmt HS 1) (hFU : FineU6 tab) (hPre : PreA6 P 8 16 17 40 tab) :
    AxisUA6 P tab := by
  obtain ⟨nF, UF, eF, eB, dF, CF, hdF0, hCF, HF⟩ := hFU
  set dA := dAA6 dF with hdAd
  have hfree : SlabFree dA := dAA6_free dF
  have hA0 : dA ≠ 0 := hfree.1
  have hdv : 30 ≤ dA.val ∧ dA.val ≤ 31 := by
    rcases dAA6_cases dF with ⟨h, -⟩ | ⟨h, -⟩ <;> rw [hdAd, h] <;> decide
  have hFA : dF ≠ dA := by
    rcases dAA6_cases dF with ⟨h, h'⟩ | ⟨h, h'⟩ <;> rw [hdAd, h]
    · rw [h']; decide
    · exact h'
  have hρA : ∀ i, ρK dF i ≠ dA := fun i => ρK_ne (Or.inr hdv.1) i
  have hTA : KR.dT ≠ dA := by
    rcases dAA6_cases dF with ⟨h, -⟩ | ⟨h, -⟩ <;> rw [hdAd, h] <;> decide
  obtain ⟨nP, UP, eA, eAd, Cp, AP, nPr, hCp, HP⟩ :=
    hPre (ρK dF) dA (ρK_inj dF) hρA (fun i => ρK_ne (by left; decide) i)
      (fun i => ρK_ne (by right; decide) i) hA0 (fun h => hTA h.symm) (ρK_lt dF) (by omega)
  obtain ⟨nS, US, eDup, e2u, e2d, e3u, e3d, e4u, e4d, e5u, e5d, e6u, e6d, e8u, e8d, Cs, AS, nSl,
    hCs, HSl⟩ := hStep dA dF hfree hdv.1 hdv.2 hdF0 hFA
  obtain ⟨Cb, AB, nB, hCb, HB⟩ := hKer
  obtain ⟨nG, HG⟩ := axA_geom P hP
  obtain ⟨nE, HE⟩ := pipeA6_eq_r6 P hP
  obtain ⟨nQ, HQ⟩ := qok_of P hP
  set A := max AP (max AS AB) with hAd
  set C₀ : ℝ := 13 * Cs + 2 * Cp + (6 * CF + 3) * Cb + 2 with hC₀
  refine ⟨nF + (nP + nS) + 2, famOwn (famApp UF (famApp UP US))
      (ownA nF nP nS eF eB eA eAd eDup e2u e2d e3u e3d e4u e4d e5u e5d e6u e6d e8u e8d dF),
    Fin.natAdd _ 1, dA, C₀, A, max nPr (max nSl (max nB (max nG (max nE nQ)))),
    hA0, by positivity, ?_⟩
  intro n hn src hsrc D hD E ext idx hidx Isym
  have hnP : nPr ≤ n := by omega
  have hnS : nSl ≤ n := by omega
  have hnB : nB ≤ n := by omega
  have hnG : nG ≤ n := by omega
  have hnE : nE ≤ n := by omega
  have hnQ : nQ ≤ n := by omega
  set tbl := IL.kTableP tab ext with htbl
  have hO := famOwn_right hidx
  have hBase := famOwn_left hidx
  have hFi := famApp_left hBase
  have hPS := famApp_right hBase
  have hPi := famApp_left hPS
  have hSi := famApp_right hPS
  have hFine := HF E ext _ hFi Isym
  have hMul : MulOK Isym tbl (NLogN.KFM.pMul E) NLogN.KFUU.MS := IL.kTableP_mulOK tab ext
  have hK : tbl (idx (Fin.natAdd _ 0)) = KR.AK.aKprog2 (NLogN.KFM.pMul E) := by
    rw [hO]; rfl
  have hX := hO 1
  -- the cost unit
  have hQ := HQ n hnQ src hsrc
  have hcU0 : 0 ≤ cU6 P n A := le_trans (by positivity) (T_le_cU6 P hP n A)
  have hD1 : (0 : ℝ) < D + 1 := by positivity
  have hK1 : 1 ≤ cU6 P n A / (D + 1) := by
    rw [le_div_iff₀ hD1, one_mul]
    have hdb : dP6 P n + 4 ≤ b'P6 P n := hQ.hdb
    have hb6 : b'P6 P n ^ 6 ≤ TP6 P n := hQ.hb6
    have h1 : D + 1 ≤ TP6 P n := by
      have : b'P6 P n ≤ b'P6 P n ^ 6 := Nat.le_self_pow (by norm_num) _
      omega
    have h2 : ((D + 1 : ℕ) : ℝ) ≤ TP6 P n := by exact_mod_cast h1
    push_cast at h2
    linarith [T_le_cU6 P hP n A]
  have hmono : ∀ (Cx : ℝ) (A' : ℕ), 0 ≤ Cx → A' ≤ A →
      Cx * cU6 P n A' / (D + 1) ≤ Cx * (cU6 P n A / (D + 1)) := by
    intro Cx A' hCx hA'
    rw [mul_div_assoc]
    exact mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right (cU6_mono P hP n hA') hD1.le) hCx
  set KS := Cs * cU6 P n AS / (D + 1) with hKS
  set KP := Cp * cU6 P n AP / (D + 1) with hKP
  set KB := Cb * (cU6 P n AB / (D + 1)) with hKB
  refine AxisBodyA6.mono (axisBodyA6_of_pass (C := 13 * KS + 2 * KP + (6 * CF + 3) * KB) hX
    (fun k hk => ?_)) ?_
  · obtain ⟨hH, hM0, ht, hWs, hst, hsep, hWw, hf, hpre0, hpo⟩ :=
      HG n hnG src hsrc D hD k hk
    obtain ⟨φ1, φ2, B, BH, Bk, Lmax, Ka, Kr, Kc, X0, hAK, f1, f2, f3, f4, f5, f6, s1, s2, kc⟩ :=
      HB n hnB src hsrc D hD k hk
    obtain ⟨h1, hS2, hS3, hS4, hS5, hS6, hS8⟩ := HSl n hnS src hsrc D hD k hk tab E ext _ hSi Isym
    have hSK := HP n hnP src hsrc D hD k hk E ext _ hPi Isym
    have hsG := J6A.monoSrc_G hH hM0 (by omega : 0 < 8 * HA6 P n) ht hWs hst hsep hWw
    have hsC := J6A.monoSrc_C hH (by omega : 2 * HA6 P n ≤ 8 * HA6 P n) ht
    have ht0 : 0 < tF6 P n k := by unfold tF6; split_ifs <;> positivity
    have hPA := axA_pass hA0 hdF0 hFA hfree
      (ρK_regOK hdF0 (by right; decide) (by decide) (by decide)) hρA hTA hFine hMul hK hf hpre0
      ht0 hpo hH hM0 hsG hsC hAK h1 hS2 hS3 hS4 hS5 hS6 hSK hS8
    have hprod := pre_t_post P n D k hk
    refine ⟨fun L => L.length = preT P n D k * (tF6 P n k * postT P n D k) ∧
      GB (pP6 P n + 2) L, _, hPA.conv (fun L hL => ⟨hL, (HE n hnE src hsrc D hD k hk L
        (by rw [hL.1, ← hprod]; ring)).symm⟩) le_rfl, ?_,
      fun L hlen hgb => ⟨by rw [hlen, ← hprod]; ring, hgb⟩⟩
    have hF5 := mul_le_mul_of_nonneg_left f5 hCF
    have hF6 := mul_le_mul_of_nonneg_left f6 hCF
    have hF1 := mul_le_mul_of_nonneg_left f1 hCF
    have hF2 := mul_le_mul_of_nonneg_left f2 hCF
    have hF3 := mul_le_mul_of_nonneg_left f3 hCF
    have hF4 := mul_le_mul_of_nonneg_left f4 hCF
    unfold axACost
    nlinarith
  · have e1 := hmono Cs AS hCs (by omega)
    have e2 := hmono Cp AP hCp (by omega)
    have e3 : KB ≤ Cb * (cU6 P n A / (D + 1)) := by
      rw [hKB]
      exact mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right
        (cU6_mono P hP n (by omega : AB ≤ A)) hD1.le) hCb
    have h6 : 0 ≤ 6 * CF + 3 := by positivity
    have e3' := mul_le_mul_of_nonneg_left e3 h6
    have eK : C₀ * cU6 P n A / (D + 1) = C₀ * (cU6 P n A / (D + 1)) := mul_div_assoc _ _ _
    rw [eK, hC₀]
    set K := cU6 P n A / (D + 1)
    have : (13 * Cs + 2 * Cp + (6 * CF + 3) * Cb + 2) * K =
        13 * (Cs * K) + 2 * (Cp * K) + (6 * CF + 3) * (Cb * K) + 2 * K := by ring
    rw [this]
    linarith

end J6Seg.Ax

end

