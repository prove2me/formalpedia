theorem solution (u : NLogN.IState NLogN.HS) (d' Q Mh Mf i s : ℕ) (h : NLogN.KFM.SrcRegs u d' Q Mh Mf)
    (LS LP : List NLogN.Item) (hS : u.G NLogN.KFM.mS = .int (s : ℤ) :: LS) (hP : u.G NLogN.KFM.mP = .int 1 :: LP)
    (hs : 2 ≤ s) (hIx : NLogN.KFM.ixO.eval u = i) (hIok : NLogN.KFM.ixO.ok u)
    (hj : ∀ j < i, (j < d' → j ≤ Mh) ∧ (d' ≤ j → j - d' ≤ Mf)) :
    (NLogN.RS.rep NLogN.KFM.mIc NLogN.KFM.ixO NLogN.KFM.pmB).ok u ∧ (NLogN.RS.rep NLogN.KFM.mIc NLogN.KFM.ixO NLogN.KFM.pmB).run u =
      u.upd NLogN.KFM.mP (.int ((∏ j ∈ Finset.range i, NLogN.KFM.srcV d' Q Mh Mf j) % s : ℕ) :: LP) := by
  set g := NLogN.KFM.srcV d' Q Mh Mf with hg
  have H := NLogN.KFM.genLoop_run NLogN.KFM.mIc NLogN.KFM.mP NLogN.KFM.ixO NLogN.KFM.pmB u i (fun k c => (c * (g (i - 1 - k) : ℤ)) % (s : ℤ)) 1 LP
    (by decide) (by decide) (NLogN.KFM.clean_of_regs _ (by decide)) hIok hIx (by decide) hP
    (NLogN.KFM.pmB_step u d' Q Mh Mf i s h LS LP hS hs hj)
  rw [NLogN.KFM.accSeq_pm, NLogN.KFM.pm_prod s g hs i] at H
  exact H
