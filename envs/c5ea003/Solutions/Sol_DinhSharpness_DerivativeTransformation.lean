noncomputable section

namespace DinhSharpness

variable {d h : ℕ}

@[simp] theorem scale_inl (α : ℝ) (θ : Parameter d h) (ij : Fin d × Fin h) :
    scale α θ (Sum.inl ij) = α * θ (Sum.inl ij) := rfl

@[simp] theorem scale_inr (α : ℝ) (θ : Parameter d h) (j : Fin h) :
    scale α θ (Sum.inr j) = α⁻¹ * θ (Sum.inr j) := rfl

@[simp] theorem scale_inv_scale (α : ℝ) (ha : α ≠ 0) (θ : Parameter d h) :
    scale α⁻¹ (scale α θ) = θ := by
  ext k
  cases k <;> simp [ha]

@[simp] theorem scale_scale_inv (α : ℝ) (ha : α ≠ 0) (θ : Parameter d h) :
    scale α (scale α⁻¹ θ) = θ := by
  simpa using scale_inv_scale α⁻¹ (inv_ne_zero ha) θ

/-- Reciprocal layer scaling is an invertible linear change of Euclidean parameters. -/
def scaleEquiv (α : ℝ) (ha : α ≠ 0) : Parameter d h ≃L[ℝ] Parameter d h :=
  LinearEquiv.toContinuousLinearEquiv
    { toFun := scale α
      invFun := scale α⁻¹
      left_inv := scale_inv_scale α ha
      right_inv := scale_scale_inv α ha
      map_add' := by
        intro θ ψ
        ext k
        cases k <;> simp [mul_add]
      map_smul' := by
        intro c θ
        ext k
        cases k <;> simp [mul_left_comm] }

@[simp] theorem scaleEquiv_apply (α : ℝ) (ha : α ≠ 0) (θ : Parameter d h) :
    scaleEquiv α ha θ = scale α θ := rfl

@[simp] theorem scaleEquiv_symm_apply (α : ℝ) (ha : α ≠ 0) (θ : Parameter d h) :
    (scaleEquiv α ha).symm θ = scale α⁻¹ θ := rfl

theorem relu_mul (α t : ℝ) (ha : 0 ≤ α) : relu (α * t) = α * relu t := by
  simp only [relu, mul_max_of_nonneg _ _ ha, mul_zero]

theorem prediction_scale (θ : Parameter d h) {α : ℝ} (ha : 0 < α) :
    prediction (scale α θ) = prediction θ := by
  funext x
  unfold prediction
  apply Finset.sum_congr rfl
  intro j _
  simp only [scale_inl, scale_inr]
  rw [show (∑ i : Fin d, x i * (α * θ (Sum.inl (i, j)))) =
      α * (∑ i : Fin d, x i * θ (Sum.inl (i, j))) by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        exact mul_left_comm _ _ _]
  rw [relu_mul α _ ha.le]
  calc
    (α * relu (∑ i : Fin d, x i * θ (Sum.inl (i, j)))) *
        (α⁻¹ * θ (Sum.inr j)) =
        (α * α⁻¹) * (relu (∑ i : Fin d, x i * θ (Sum.inl (i, j))) *
          θ (Sum.inr j)) := mul_mul_mul_comm _ _ _ _
    _ = _ := by simp [ha.ne']

theorem loss_scale (ℓ : (Input d → ℝ) → ℝ) (θ : Parameter d h)
    {α : ℝ} (ha : 0 < α) : parameterLoss ℓ (scale α θ) = parameterLoss ℓ θ := by
  simp only [parameterLoss, prediction_scale θ ha]

theorem localMin_scale_iff (ℓ : (Input d → ℝ) → ℝ) (θ : Parameter d h)
    {α : ℝ} (ha : 0 < α) :
    IsLocalMin (parameterLoss ℓ) (scale α θ) ↔ IsLocalMin (parameterLoss ℓ) θ := by
  constructor
  · intro hmin
    have hc := (scaleEquiv (d := d) (h := h) α ha.ne').continuous.continuousAt (x := θ)
    simpa only [Function.comp_def, scaleEquiv_apply, loss_scale ℓ _ ha] using
      hmin.comp_continuous hc
  · intro hmin
    have hmin' : IsLocalMin (parameterLoss ℓ) (scale α⁻¹ (scale α θ)) := by
      simpa only [scale_inv_scale α ha.ne' θ] using hmin
    have hc := (scaleEquiv (d := d) (h := h) α⁻¹ (inv_ne_zero ha.ne')).continuous.continuousAt
      (x := scale α θ)
    simpa only [Function.comp_def, scaleEquiv_apply, loss_scale ℓ _ (inv_pos.mpr ha)] using
      hmin'.comp_continuous hc

theorem scale_single (α : ℝ) (k : Coordinate d h) (t : ℝ) :
    scale α (EuclideanSpace.single k t) =
      (match k with | Sum.inl _ => α | Sum.inr _ => α⁻¹) •
        EuclideanSpace.single k t := by
  ext k'
  by_cases hk : k' = k
  · subst k'
    cases k <;> simp
  · cases k <;> cases k' <;> simp_all

@[simp] theorem scale_single_inl (α : ℝ) (ij : Fin d × Fin h) (t : ℝ) :
    scale α (EuclideanSpace.single (Sum.inl ij) t) =
      α • EuclideanSpace.single (Sum.inl ij) t := scale_single α (Sum.inl ij) t

@[simp] theorem scale_single_inr (α : ℝ) (j : Fin h) (t : ℝ) :
    scale (d := d) α (EuclideanSpace.single (Sum.inr j) t) =
      α⁻¹ • EuclideanSpace.single (Sum.inr j) t := scale_single α (Sum.inr j) t

/-- The exact scaling-symmetry milestone, with the source's positive architecture dimensions. -/
theorem scalingSymmetry :
    ∀ (d h : ℕ), 0 < d → 0 < h →
      ∀ (ℓ : (Input d → ℝ) → ℝ) (θ : Parameter d h) (α : ℝ), 0 < α →
        prediction (scale α θ) = prediction θ ∧
        parameterLoss ℓ (scale α θ) = parameterLoss ℓ θ ∧
        (IsLocalMin (parameterLoss ℓ) (scale α θ) ↔
          IsLocalMin (parameterLoss ℓ) θ) := by
  intro d h _ _ ℓ θ α ha
  exact ⟨prediction_scale θ ha, loss_scale ℓ θ ha, localMin_scale_iff ℓ θ ha⟩

end DinhSharpness
