set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open NLogN.KFU
open IntMul KFC AModel AModelL12
theorem solution {q' : ℕ} {K : ℝ} (hK : NLogN.KFU.SwOK q' K) (hK0 : 0 ≤ K) (mz : ℕ → ℕ) (bg : ℕ → Bool)
    (hmz : ∀ j, 1 ≤ mz j) (u : ℕ) (hu : 1 ≤ u) (L : List ℕ) (cid : ℕ)
    (hL : ∀ j ∈ L, mz j = 2 ^ u) (hcid : bg cid = false) (hnd : (L ++ [cid]).Nodup)
    (w : ℕ) (xs0 : List ℤ) (hx : NLogN.Bnd w xs0) (hxs : xs0.length = AModel.vol ((L ++ [cid]).map (NLogN.KFU.tz mz bg)))
    (I : List NLogN.Sym) (t : NLogN.IState NLogN.HS) (R : List NLogN.Item) (h0 : t.G 0 = NLogN.ints xs0 ++ R) :
    ∃ c : ℕ, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFU.revC q' w u mz bg L cid) t
      (t.upd 0 (NLogN.ints (AModel.pull ((L ++ [cid]).map (NLogN.KFU.tz mz bg)) ((L.reverse ++ [cid]).map (NLogN.KFU.tz mz bg))
        (NLogN.KFU.revH L.length) 0 xs0) ++ R)) c ∧
      (c : ℝ) ≤ 3 * (L.length + 1) * (NLogN.KFU.cMv (AModel.vol ((L ++ [cid]).map (NLogN.KFU.tz mz bg))) w + 1 +
        K * ((w : ℝ) + 1) * ((AModel.vol ((L ++ [cid]).map (NLogN.KFU.tz mz bg)) : ℝ) + 1) * (u : ℝ) ^ NLogN.KFS.τS) := by
  set lay0 := NLogN.KFU.layA bg (L ++ [cid]) with hlay0
  have hatm : NLogN.KFU.atm bg cid = [2 * cid] := by simp [NLogN.KFU.atm, hcid]
  have e0 : lay0 = NLogN.KFU.layA bg L ++ [2 * cid] := by rw [hlay0, NLogN.KFU.layA_append]; simp [NLogN.KFU.layA, hatm]
  have hnd0 : lay0.Nodup := NLogN.KFU.nodup_layA bg _ hnd
  have hF0 : NLogN.KFU.Full bg (L ++ [cid]) lay0 := NLogN.KFU.full_layA bg _
  have hV : AModel.vol (lay0.map (NLogN.KFU.asz mz)) = AModel.vol ((L ++ [cid]).map (NLogN.KFU.tz mz bg)) := NLogN.KFU.vol_layA mz bg _
  set V := AModel.vol ((L ++ [cid]).map (NLogN.KFU.tz mz bg))
  have hD0 : NLogN.KFU.Dl mz bg (L ++ [cid]) lay0 xs0 0 = xs0 := NLogN.KFU.Dl_self mz bg _ hnd (fun j _ => hmz j) xs0 0 hxs
  -- phase 1
  have P1 := NLogN.KFU.p1_spec (I := I) (iprog := NLogN.KFL.l12prog) mz bg hmz (L ++ [cid]) lay0 hnd0 hF0 w xs0 hx
    L [] [2 * cid] (by rw [e0]; simp) t R (by rw [h0]; simp only [List.nil_append]; rw [← e0, hD0])
  rw [hV] at P1
  -- phase 2
  set lay2 := NLogN.KFU.mains L ++ NLogN.KFU.bitsR bg L ++ [2 * cid]
  have hp2 : List.Perm lay2 lay0 := by
    rw [e0]; simpa [lay2] using NLogN.KFU.perm_mid [] [2 * cid] (NLogN.KFU.perm_layA_R bg L).symm
  have hr : L.length ≤ lay2.length := by simp [lay2, NLogN.KFU.mains]
  have hS : ∀ i < L.length, NLogN.KFU.asz mz (lay2.getD i 0) = 2 ^ u := by
    intro i hi
    have : lay2.getD i 0 = 2 * L[i] := by
      simp only [lay2, List.append_assoc, NLogN.KFU.mains]
      rw [List.getD_append _ _ _ _ (by simp; omega)]
      simp [List.getD_eq_getElem?_getD, hi]
    rw [this]; simp only [NLogN.KFU.asz]; rw [if_pos (by omega), show 2 * L[i] / 2 = L[i] by omega]
    exact hL _ (List.getElem_mem hi)
  obtain ⟨-, -, c2, H2, hc2⟩ := NLogN.KFU.swC_spec hK hK0 mz bg hmz u hu (L ++ [cid]) lay2
    (hp2.nodup_iff.2 hnd0) (hF0.mono (fun x hx => hp2.symm.mem_iff.1 hx)) L.length hr hS w xs0 hx I
    (t.upd 0 (NLogN.ints (NLogN.KFU.Dl mz bg (L ++ [cid]) ([] ++ NLogN.KFU.mains L ++ NLogN.KFU.bitsR bg L ++ [2 * cid]) xs0 0) ++ R))
    R (by simp [lay2]) (L.length / 2) le_rfl
  rw [NLogN.KFU.rv_half hr] at H2
  have e2 : (lay2.take L.length).reverse ++ lay2.drop L.length =
      [] ++ NLogN.KFU.mains L.reverse ++ NLogN.KFU.bitsF bg L.reverse ++ [2 * cid] := by
    simp only [lay2, List.append_assoc]
    rw [List.take_append_of_le_length (by simp [NLogN.KFU.mains]), List.take_of_length_le (by simp [NLogN.KFU.mains]),
      List.drop_append_of_le_length (by simp [NLogN.KFU.mains]), List.drop_of_length_le (by simp [NLogN.KFU.mains])]
    simp [NLogN.KFU.mains, NLogN.KFU.bitsR, List.map_reverse]
  rw [e2] at H2
  -- phase 3
  have hp3 : List.Perm ([] ++ NLogN.KFU.layA bg L.reverse ++ [2 * cid]) lay0 := by
    rw [e0]; simp only [List.nil_append]
    exact ((List.reverse_perm L).flatMap_right (NLogN.KFU.atm bg)).append_right _
  have P3 := NLogN.KFU.p3_spec (I := I) (iprog := NLogN.KFL.l12prog) mz bg hmz (L ++ [cid]) lay0 hnd0 hF0 w xs0 hx
    L.reverse [] [2 * cid] hp3
    (t.upd 0 (NLogN.ints (NLogN.KFU.Dl mz bg (L ++ [cid]) ([] ++ NLogN.KFU.mains L.reverse ++ NLogN.KFU.bitsF bg L.reverse ++ [2 * cid])
      xs0 0) ++ R)) R (by simp)
  rw [hV] at P3
  have e3 : [] ++ NLogN.KFU.layA bg L.reverse ++ [2 * cid] = NLogN.KFU.layA bg (L.reverse ++ [cid]) := by
    rw [NLogN.KFU.layA_append]; simp [NLogN.KFU.layA, hatm]
  rw [e3, NLogN.KFU.Dl_rev mz bg L cid hnd (fun j _ => hmz j)] at P3
  obtain ⟨c1, hc1, E1⟩ := P1
  obtain ⟨c3, hc3, E3⟩ := P3
  refine ⟨c1 + (c2 + c3), (NLogN.IRuns.seq ⟨c1, le_rfl, E1⟩ (NLogN.IRuns.seq (H2.mono' (by simp) le_rfl)
    ⟨c3, le_rfl, E3⟩)).mono' (by simp) le_rfl, ?_⟩
  rw [NLogN.KFU.vol_perm mz hp2, hV] at hc2
  have hB : 0 ≤ K * ((w : ℝ) + 1) * ((V : ℝ) + 1) * (u : ℝ) ^ KFS.τS := by
    have : (0 : ℝ) ≤ (u : ℝ) ^ KFS.τS := Real.rpow_nonneg (Nat.cast_nonneg _) _
    positivity
  have h1 : (c1 : ℝ) ≤ (L.length + 1) * ((NLogN.KFU.cMv V w : ℝ) + 1) := by exact_mod_cast hc1
  have h3 : (c3 : ℝ) ≤ (L.length + 1) * ((NLogN.KFU.cMv V w : ℝ) + 1) := by
    have := hc3; simp only [List.length_reverse] at this; exact_mod_cast this
  have hl2 : ((L.length / 2 : ℕ) : ℝ) ≤ L.length := by exact_mod_cast Nat.div_le_self _ _
  set B := K * ((w : ℝ) + 1) * ((V : ℝ) + 1) * (u : ℝ) ^ NLogN.KFS.τS
  have h2 : (c2 : ℝ) ≤ L.length * B + 1 :=
    le_trans hc2 (by have := mul_le_mul_of_nonneg_right hl2 hB; linarith)
  have hM : (0 : ℝ) ≤ NLogN.KFU.cMv V w := Nat.cast_nonneg _
  have hn : (0 : ℝ) ≤ L.length := Nat.cast_nonneg _
  push_cast
  nlinarith
end
