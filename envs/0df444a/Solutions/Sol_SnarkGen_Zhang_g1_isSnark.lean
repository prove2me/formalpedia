private abbrev Wedge34 := Fin 34 × Fin 34 × Fin 34
private abbrev Path34 := Fin 34 × List (Fin 34)
private abbrev Quint34 := Path34 × Path34 × Path34 × Path34 × Path34

private def memEdges (p : Fin 34 × Fin 34) : Bool :=
  g1Edges.any (fun q => p.1.val == q.1.val && p.2.val == q.2.val)

private def adjBool (a b : Fin 34) : Bool :=
  (a.val != b.val) && (memEdges (a, b) || memEdges (b, a))

private lemma adj_of_adjBool {a b : Fin 34} (h : adjBool a b = true) : g1.Adj a b := by
  simp only [adjBool, memEdges, Bool.and_eq_true, bne_iff_ne, ne_eq, ← Fin.ext_iff,
    Bool.or_eq_true, List.any_eq_true, beq_iff_eq] at h
  rcases h with ⟨hne, ⟨⟨q1, q2⟩, hmem, h1, h2⟩ | ⟨⟨q1, q2⟩, hmem, h1, h2⟩⟩
  · subst h1 h2; exact ⟨hne, Or.inl hmem⟩
  · subst h1 h2; exact ⟨hne, Or.inr hmem⟩

private def allDirEdges : List (Fin 34 × Fin 34) :=
  g1Edges ++ g1Edges.map (fun p => (p.2, p.1))

private lemma mem_allDirEdges_of_adj {a b : Fin 34} (h : g1.Adj a b) :
    (a, b) ∈ allDirEdges := by
  rw [allDirEdges, List.mem_append, List.mem_map]
  rcases h with ⟨_, hmem | hmem⟩
  · exact Or.inl hmem
  · exact Or.inr ⟨(b, a), hmem, rfl⟩

private def g1Wedges : List Wedge34 :=
  allDirEdges.flatMap (fun e1 =>
    allDirEdges.filterMap (fun e2 =>
      if e1.2 == e2.1 && e1.1 != e2.2 && decide (e1.1.val < e2.2.val) then
        some (e1.1, e1.2, e2.2)
      else none))

private lemma mem_g1Wedges {a b c : Fin 34}
    (hab : g1.Adj a b) (hbc : g1.Adj b c) (hlt : a.val < c.val) :
    (a, b, c) ∈ g1Wedges := by
  rw [g1Wedges, List.mem_flatMap]
  refine ⟨(a, b), mem_allDirEdges_of_adj hab, ?_⟩
  rw [List.mem_filterMap]
  refine ⟨(b, c), mem_allDirEdges_of_adj hbc, ?_⟩
  have hne : a ≠ c := Fin.ne_of_val_ne (ne_of_lt hlt)
  simp [hne, hlt]

private def walkPairs : Fin 34 → List (Fin 34) → List (Fin 34 × Fin 34)
  | _, [] => []
  | a, b :: l => (a, b) :: walkPairs b l

private def walkEnd : Fin 34 → List (Fin 34) → Fin 34
  | a, [] => a
  | _, b :: l => walkEnd b l

private def walkValid : Fin 34 → List (Fin 34) → Bool
  | _, [] => true
  | a, b :: l => adjBool a b && walkValid b l

private def pathOk (ua ub uc ra rb rc : Fin 34) (w : Path34) : Bool :=
  (w.1 == ua || w.1 == ub || w.1 == uc) &&
  (walkEnd w.1 w.2 == ra || walkEnd w.1 w.2 == rb || walkEnd w.1 w.2 == rc) &&
  walkValid w.1 w.2

private def pPairs (w : Path34) : List (Fin 34 × Fin 34) := walkPairs w.1 w.2

private def sameEdge (p q : Fin 34 × Fin 34) : Bool :=
  (p.1.val == q.1.val && p.2.val == q.2.val) || (p.1.val == q.2.val && p.2.val == q.1.val)

private def listDisj (l₁ l₂ : List (Fin 34 × Fin 34)) : Bool :=
  l₁.all (fun p => l₂.all (fun q => !sameEdge p q))

private def quintOk (ua ub uc ra rb rc : Fin 34) (q : Quint34) : Bool :=
  let (w₀, w₁, w₂, w₃, w₄) := q
  pathOk ua ub uc ra rb rc w₀ &&
  pathOk ua ub uc ra rb rc w₁ &&
  pathOk ua ub uc ra rb rc w₂ &&
  pathOk ua ub uc ra rb rc w₃ &&
  pathOk ua ub uc ra rb rc w₄ &&
  listDisj (pPairs w₀) (pPairs w₁) &&
  listDisj (pPairs w₀) (pPairs w₂) &&
  listDisj (pPairs w₀) (pPairs w₃) &&
  listDisj (pPairs w₀) (pPairs w₄) &&
  listDisj (pPairs w₁) (pPairs w₂) &&
  listDisj (pPairs w₁) (pPairs w₃) &&
  listDisj (pPairs w₁) (pPairs w₄) &&
  listDisj (pPairs w₂) (pPairs w₃) &&
  listDisj (pPairs w₂) (pPairs w₄) &&
  listDisj (pPairs w₃) (pPairs w₄)

