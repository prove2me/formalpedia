private theorem isOneParamGroup_R [FiniteDimensional ℂ (V K φ)] (hφ : Continuous φ) (hρ0 : ρ 0 = 1)
    (hρadd : ∀ s t, ρ (s + t) = ρ s * ρ t) (hρc : Continuous ρ) :
    M4aP3B.AutoSmooth.IsOneParamGroup (R K φ ρ hρK b) :=
  ⟨R_zero K φ ρ hρK b hρ0, R_add K φ ρ hρK b hρadd, continuous_R K φ ρ hρK b hφ hρc⟩

private theorem contDiff_R [FiniteDimensional ℂ (V K φ)] (hφ : Continuous φ) (hρ0 : ρ 0 = 1)
    (hρadd : ∀ s t, ρ (s + t) = ρ s * ρ t) (hρc : Continuous ρ) : ContDiff ℝ ∞ (R K φ ρ hρK b) :=
  (isOneParamGroup_R K φ ρ hρK b hφ hρ0 hρadd hρc).contDiff

private def coef (i : Fin n) (θ : ℝ) : ℂ :=
  b.repr (T K φ (ρK K ρ hρK θ) (φV K φ)) i

omit [TopologicalSpace G] [ContinuousMul G] in
private theorem coef_eq_R_apply (i : Fin n) (θ : ℝ) :
    coef K φ ρ hρK b i θ = R K φ ρ hρK b θ (b.equivFun (φV K φ)) i := by
  rw [R_apply, LinearEquiv.symm_apply_apply, Module.Basis.equivFun_apply, coef]

private theorem contDiff_coef [FiniteDimensional ℂ (V K φ)] (hφ : Continuous φ) (hρ0 : ρ 0 = 1)
    (hρadd : ∀ s t, ρ (s + t) = ρ s * ρ t) (hρc : Continuous ρ) (i : Fin n) :
