theorem W_le_cWc (c : Cfg) : c.W ≤ 2 ^ cWc c := Nat.le_pow_clog (by norm_num) _

theorem cWc_le (c : Cfg) : cWc c ≤ c.W :=
  Nat.clog_le_of_le_pow (Nat.lt_two_pow_self).le

theorem Zc_ge (c : Cfg) : 64 ≤ Zc c := by unfold Zc; omega

