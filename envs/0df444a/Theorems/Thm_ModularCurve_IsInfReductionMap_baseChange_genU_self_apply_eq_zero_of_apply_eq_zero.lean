theorem ModularCurve.IsInfReductionMap.baseChange_genU_self_apply_eq_zero_of_apply_eq_zero
    (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (hpM : p ∣ M) (hpM2 : ¬ p ^ 2 ∣ M)
    (H : Subgroup (ZMod M)ˣ)
    (hHp : ∀ u : (ZMod M)ˣ, ZMod.unitsMap (Nat.div_dvd_of_dvd hpM) u = 1 → u ∈ H)
    (K : Type*) [Field K] [IsAlgClosed K] [Algebra (ZMod p) K] (S : Set ℕ)
    {ρ : K ⊗[ZMod p] CuspForm.IntTwoCuspForms M H p →ₗ[K]
        Ω[ModularCurve.qExpFunctionFieldC K
            (CohCarrier.GammaH (M / p) (ModularCurve.infSubgroup p M H hpM))⁄K]}
    (hρ : ModularCurve.IsInfReductionMap K p M H hpM ρ)
    (x : K ⊗[ZMod p] CuspForm.IntTwoCuspForms M H p) (hx : ρ x = 0) :
    (CuspForm.intTwoCuspGenMod M H p S (CohCarrier.Gen.U p Fact.out hpM)).baseChange K x = 0 := by sorry
