open Polynomial

example : Irreducible (X : Polynomial ℤ) := Polynomial.prime_X.irreducible

example : ¬ (X : Polynomial ℤ) ∣ Polynomial.C 2 := by
  rintro ⟨c, hc⟩
  have h0 := congrArg (Polynomial.eval 0) hc
  simp at h0

example : ¬ ∃ t : Polynomial ℤ, (X : Polynomial ℤ) ∣ t * Polynomial.C 2 - 1 := by
  rintro ⟨t, c, hc⟩
  have h0 := congrArg (Polynomial.eval 0) hc
  simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C,
    Polynomial.eval_one, Polynomial.eval_X, zero_mul, sub_eq_zero] at h0
  omega

end MaximalityGate
