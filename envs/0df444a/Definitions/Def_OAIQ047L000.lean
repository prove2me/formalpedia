def U (c z T p : ℕ) : ℤ :=
  if z ≤ T ∧ p ≤ T then
    (((List.range (min p z + 1)).filter (fun h => p + z ≤ T + h)).map
      (fun h => (-1 : ℤ) ^ (z-h) * (Nat.choose z h : ℤ) *
        (Nat.choose (T-z) (p-h) : ℤ) * (c : ℤ) ^ (p-h))).sum
  else 0

def X (entries : List (ℕ × ℕ × ℤ)) (z T : ℕ) : ℤ :=
  (entries.map (fun (p,j,a) => if p+j = T then a * U 2 z T p else 0)).sum

