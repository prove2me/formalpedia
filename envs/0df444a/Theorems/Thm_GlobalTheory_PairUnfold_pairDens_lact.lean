theorem GlobalTheory.PairUnfold.pairDens_lact {r : ℕ} (X : Data E r) {la : Wt X.Ψ r} {P f0 : Frame X.Ψ r → ℂ}
    {W : Frame X.Ψ r → ℝ≥0∞}
    (hf : ∀ γ ∈ X.Γ, ∀ x ∈ X.dom, f0 (lact γ x) = X.χ la γ * f0 x)
    (hW : IsMetricW X la W) {γ : GL (Fin r) E} (hγ : γ ∈ X.Γ) {x : Frame X.Ψ r} (hx : x ∈ X.dom) :
    pairDens X P f0 W (lact γ x) =
      (X.χ la γ)⁻¹ * P (lact γ x) * ((starRingEnd ℂ) (f0 x) * ((W x).toReal : ℂ)) := by sorry
