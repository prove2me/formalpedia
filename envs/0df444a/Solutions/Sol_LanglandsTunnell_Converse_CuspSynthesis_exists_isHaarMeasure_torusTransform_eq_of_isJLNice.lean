section FurtherPlaces

variable {K : Type} [Field K] [NumberField K] {S : Finset (HeightOneSpectrum (𝓞 K))}
  {epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ} {ω : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}

private theorem t0927 {v : HeightOneSpectrum (𝓞 K)} {M : GL (Fin 2) (v.adicCompletion K)}
    (hM : LocalWhittaker.IsIntegral Valued.v M) :
    Valued.v ((M : GL (Fin 2) (v.adicCompletion K)) : Matrix (Fin 2) (Fin 2) (v.adicCompletion K)).det ≤ 1 := by
  rw [Matrix.det_fin_two]
  refine (Valuation.map_sub _ _ _).trans (max_le ?_ ?_)
  · rw [Valuation.map_mul]
    exact mul_le_one' (hM 0 0) (hM 1 1)
  · rw [Valuation.map_mul]
    exact mul_le_one' (hM 0 1) (hM 1 0)

private theorem t0928 {v : HeightOneSpectrum (𝓞 K)} {x : v.adicCompletion K}
    {m n : ℤ} {P : GL (Fin 2) (v.adicCompletion K)}
    (hP : ((P : GL (Fin 2) (v.adicCompletion K)) : Matrix (Fin 2) (Fin 2) (v.adicCompletion K))
      = !![(uniformizerUnit K v : v.adicCompletion K) ^ m * (uniformizerUnit K v : v.adicCompletion K) ^ n,
            x * (uniformizerUnit K v : v.adicCompletion K) ^ n;
          0, (uniformizerUnit K v : v.adicCompletion K) ^ n])
    (hPI : LocalWhittaker.IsIntegral Valued.v P) (hPI' : LocalWhittaker.IsIntegral Valued.v P⁻¹) :
    m = 0 ∧ n = 0 ∧ Valued.v x ≤ 1 := by

  have h1 := t0927 hPI
  have h2 := t0927 hPI'
  have hprod : Valued.v ((P : GL (Fin 2) (v.adicCompletion K)) : Matrix (Fin 2) (Fin 2) (v.adicCompletion K)).det
      * Valued.v (((P⁻¹ : GL (Fin 2) (v.adicCompletion K)) : GL (Fin 2) (v.adicCompletion K)) :
          Matrix (Fin 2) (Fin 2) (v.adicCompletion K)).det = 1 := by
    rw [← Valuation.map_mul, ← Matrix.det_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.det_one,
      Valuation.map_one]
  have hdet : Valued.v ((P : GL (Fin 2) (v.adicCompletion K)) : Matrix (Fin 2) (Fin 2) (v.adicCompletion K)).det
      = 1 :=
    le_antisymm h1 (by
      calc (1 : ℤᵐ⁰)
          = Valued.v ((P : GL (Fin 2) (v.adicCompletion K)) : Matrix (Fin 2) (Fin 2) (v.adicCompletion K)).det
            * Valued.v (((P⁻¹ : GL (Fin 2) (v.adicCompletion K)) : GL (Fin 2) (v.adicCompletion K)) :
              Matrix (Fin 2) (Fin 2) (v.adicCompletion K)).det := hprod.symm
        _ ≤ Valued.v ((P : GL (Fin 2) (v.adicCompletion K)) : Matrix (Fin 2) (Fin 2) (v.adicCompletion K)).det * 1 :=
            mul_le_mul_right h2 _
        _ = Valued.v ((P : GL (Fin 2) (v.adicCompletion K)) : Matrix (Fin 2) (Fin 2) (v.adicCompletion K)).det :=
            mul_one _)
  rw [hP, Matrix.det_fin_two_of, mul_zero, sub_zero, ← Units.val_zpow_eq_zpow_val, ← Units.val_zpow_eq_zpow_val,
    Valuation.map_mul, Valuation.map_mul, t0359, t0359,
    ← WithZero.exp_add, ← WithZero.exp_add, WithZero.exp_eq_one] at hdet

  have h11 : Valued.v ((uniformizerUnit K v : v.adicCompletion K) ^ n) ≤ 1 := by simpa [hP] using hPI 1 1
  have h00 : Valued.v ((uniformizerUnit K v : v.adicCompletion K) ^ m * (uniformizerUnit K v : v.adicCompletion K) ^ n)
      ≤ 1 := by simpa [hP] using hPI 0 0
  rw [← Units.val_zpow_eq_zpow_val, t0359, ← WithZero.exp_zero, WithZero.exp_le_exp] at h11
  rw [← Units.val_zpow_eq_zpow_val, ← Units.val_zpow_eq_zpow_val, Valuation.map_mul, t0359,
    t0359, ← WithZero.exp_add, ← WithZero.exp_zero, WithZero.exp_le_exp] at h00
  have hn : n = 0 := by omega
  have hm : m = 0 := by omega
  subst hn hm
  refine ⟨rfl, rfl, ?_⟩
  simpa [hP] using hPI 0 1

private theorem t0929 (v : HeightOneSpectrum (𝓞 K)) (x : v.adicCompletion K)
    (m n : ℤ) (k : GL (Fin 2) (Valued.v : Valuation (v.adicCompletion K) ℤᵐ⁰).integer)
    (hI : LocalWhittaker.IsIntegral Valued.v
      (unipotent x
          * UnramifiedWhittaker.diagZ (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero m
          * UnramifiedWhittaker.scalarPi (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero ^ n
          * Matrix.GeneralLinearGroup.map (Valued.v.integer.subtype) k))
    (hI' : LocalWhittaker.IsIntegral Valued.v
      (unipotent x
          * UnramifiedWhittaker.diagZ (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero m
          * UnramifiedWhittaker.scalarPi (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero ^ n
          * Matrix.GeneralLinearGroup.map (Valued.v.integer.subtype) k)⁻¹) :
    m = 0 ∧ n = 0 ∧ Valued.v x ≤ 1 := by
  have hk := t0433 v k
  have hPI := t0875 Valued.v hI hk.2
  rw [mul_inv_cancel_right] at hPI
  have hPI' := t0875 Valued.v hk.1 hI'
  rw [mul_inv_rev, mul_inv_cancel_left] at hPI'
  refine t0928 ?_ hPI hPI'
  simp only [Units.val_mul, LocalIwasawa.t0428, LocalIwasawa.t0429, LocalIwasawa.t0426,
    LocalIwasawa.t0427]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

variable {b : AdelicGL2 (𝓞 K) K}

private theorem s002.t0930 (D : s002 (S := S) b) {v : HeightOneSpectrum (𝓞 K)}
    (hvS : v ∉ S) (hvL : v ∉ D.L) : D.cAll v = 0 := by
  obtain ⟨hI, hI'⟩ := D.isIntegral v hvS hvL
  rw [D.t0910 v] at hI hI'
  exact (t0929 v _ _ _ _ hI hI').1

private theorem s002.t0931 (D : s002 (S := S) b) {v : HeightOneSpectrum (𝓞 K)}
    (hvS : v ∉ S) (hvL : v ∉ D.L) : D.nAll v = 0 := by
  obtain ⟨hI, hI'⟩ := D.isIntegral v hvS hvL
  rw [D.t0910 v] at hI hI'
  exact (t0929 v _ _ _ _ hI hI').2.1

private theorem s002.t0932 (D : s002 (S := S) b)
    {v : HeightOneSpectrum (𝓞 K)} (hvS : v ∉ S) (hvL : v ∉ D.L) : Valued.v (D.xAll v) ≤ 1 := by
  obtain ⟨hI, hI'⟩ := D.isIntegral v hvS hvL
  rw [D.t0910 v] at hI hI'
  exact (t0929 v _ _ _ _ hI hI').2.2

variable (d : JLData K S epsS ω) {g₀ : AdelicGL2 (𝓞 K) K} (D : s002 (S := S) (d087 g₀))

private theorem s002.t0933 {v : HeightOneSpectrum (𝓞 K)} (hvS : v ∉ S) (hvL : v ∉ D.L) :
    D.d109 d v := by
