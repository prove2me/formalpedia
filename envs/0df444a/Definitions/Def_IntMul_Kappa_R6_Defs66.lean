/-- Read the header and the stage tables. -/
def hdrK : RS :=
  .seq (tkRS RL) (.seq (tkRS rP) (.seq (tkRS rP1) (.seq (tkRS BC) (.seq (tkRS RT) (.seq (tkRS kc)
  (.seq (tkRS kB) (.seq (tkRS R2) (.seq (dupR dT DU TDI CC RL) (.seq (dupR dT DU TGI CC RL)
  (.seq (dupR dT DU TGA CC RL) (.seq (dupR dT DU TDD CC RL) (.push kD (.lit 1)))))))))))))

/-- The zeros, the output, restoring the table, clearing. -/
def finK : RS :=
  .seq (.pop BC) (.seq (zeroR OUT CC R2) (.seq (dropR 0 CC R2) (.seq (mvP OUT 0 TP CC RL)
  (.seq (dropR TDI CC RL) (.seq (dropR TGI CC RL) (.seq (dropR TGA CC RL) (.seq (dropR TDD CC RL)
  (.seq (NLogN.mvK DU dT CC (.reg RT)) (.seq (.pop RL) (.seq (.pop rP) (.seq (.pop rP1)
  (.seq (.pop RT) (.seq (.pop kc) (.seq (.pop kB) (.seq (.pop R2) (.pop kD))))))))))))))))

end J6Seg.KR

