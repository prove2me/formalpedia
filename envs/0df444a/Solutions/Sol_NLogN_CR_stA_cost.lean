    parEx K N ≤ K * (mkParams K N).e ∧ K * (mkParams K N).e ≤ parEx K N + K - 1 := by
  rw [par_e]
  constructor
  · have := Nat.lt_div_mul_add (a := parEx K N + K - 1) (b := K) (by omega)
    rw [mul_comm]
