-- title:
--   Theorem 1, p. 7 — under Assumption 1, every limit point of the SUM iterates is a stationary point of problem (2)
-- statement:
--   Consider the problem
--   $$
--   \min_x\ f(x)\quad\text{s.t.}\quad x\in\mathcal X \tag{2}
--   $$
--   with $\mathcal X\subseteq\mathbb R^m$ closed and convex and $f:\mathbb R^m\to\mathbb R$. Let $u:\mathbb R^m\times\mathbb R^m\to\mathbb R$ satisfy Assumption 1:
--   1. (A1) $u(y,y)=f(y)$ for all $y\in\mathcal X$;
--   2. (A2) $u(x,y)\ge f(x)$ for all $x,y\in\mathcal X$;
--   3. (A3) $u'(x,y;d)\big|_{x=y}=f'(y;d)$ for all $y\in\mathcal X$ and all $d$ with $y+d\in\mathcal X$, the derivative of $u$ being taken in $x$ only;
--   4. (A4) $u$ is continuous on $\mathcal X\times\mathcal X$.
--
--   Here $h'(x;d)=\liminf_{\lambda\downarrow 0}\,(h(x+\lambda d)-h(x))/\lambda$. Let $x^0\in\mathcal X$ and let $x^{r+1}$ be any element of $\arg\min_{x\in\mathcal X}u(x,x^r)$ for $r=0,1,2,\dots$ (the SUM algorithm). Then every limit point $z$ of $\{x^r\}$ is a stationary point of (2):
--   $$
--   z\in\mathcal X\quad\text{and}\quad f'(z;d)\ge 0\qquad\forall\,d\in\mathbb R^m\text{ with }z+d\in\mathcal X .
--   $$
--
--   Theorem 1 is the convergence result for successive upper-bound minimization (majorization–minimization) on a convex feasible set, with a possibly nonconvex and nonsmooth objective; it covers algorithms such as DC programming, EM and proximal minimization.
--
--   **Formalization Note** "Limit point" is a cluster point of the sequence (`MapClusterPt`); the whole sequence need not converge, and no limit point need exist. No continuity of $f$ is assumed beyond what (A1) and (A4) give. The page's $f$ with $\operatorname{dom} f=\mathcal X$ is a real function on $\mathbb R^m$ whose values off $\mathcal X$ do not enter the statement.
-- source:
--   Razaviyayn, Hong & Luo, arXiv:1209.2385v1, p. 7, Theorem 1

import Mathlib
import Definitions.Def_TsengBCD_Stationary_Setting
import Definitions.Def_BSUMConv_SUM_Setting

namespace BSUMConv.SUM

open Filter Topology

/-- Theorem 1, p. 7: under Assumption 1, every limit point of the iterates generated by the SUM
algorithm is a stationary point of problem (2). -/
theorem theorem_1 {m : ℕ} (Xset : Set (EuclideanSpace ℝ (Fin m)))
    (hconv : Convex ℝ Xset) (hclosed : IsClosed Xset)
    (f : EuclideanSpace ℝ (Fin m) → ℝ)
    (u : EuclideanSpace ℝ (Fin m) → EuclideanSpace ℝ (Fin m) → ℝ)
    (hA : Assumption1 Xset f u)
    (x : ℕ → EuclideanSpace ℝ (Fin m)) (hx : IsSUMRun Xset u x)
    (z : EuclideanSpace ℝ (Fin m)) (hz : MapClusterPt z atTop x) :
    IsStationaryOn Xset f z := by sorry

end BSUMConv.SUM
