theorem exists_small_rat_of_tight_system {K : Type*} [Field K] [CharZero K]
    (A : Matrix ι ι ℚ) (b : ι → ℚ) {B : ℕ}
    (hA : ∀ i j, (A i j).num.natAbs ≤ B ∧ (A i j).den ≤ B)
    (hb : ∀ i, (b i).num.natAbs ≤ B ∧ (b i).den ≤ B)
    (hdet : A.det ≠ 0) (x : ι → K)
    (hx : (A.map (fun z : ℚ => (z : K))) *ᵥ x = fun i => (b i : K)) :
    ∃ q : ι → ℚ, ∀ i, (q i : K) = x i ∧
