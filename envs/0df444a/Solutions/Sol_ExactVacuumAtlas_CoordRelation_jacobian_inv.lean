open scoped ContDiff
open Matrix Filter Topology
open ExactVacuumAtlas
open ExactVacuumAtlas.CoordRelation
variable {g₁ g₂ : Metric 4} {U V : Set (Pt 4)} {Φ Ψ : Pt 4 → Pt 4}
  {J K : Pt 4 → Matrix (Fin 4) (Fin 4) ℝ}
theorem solution (h : CoordRelation g₁ g₂ U V Φ Ψ J) (hU : IsOpen U) (hV : IsOpen V)
    (hJK : ∀ x ∈ U, J x * K x = 1) {y : Pt 4} (hy : y ∈ V) (k i : Fin 4) :
    HasDerivAt (fun u : ℝ => Ψ (Function.update y i u) k) (K (Ψ y) k i) (y i) := by
  have hx : Ψ y ∈ U := h.bijOn_inv.mapsTo hy
  have hdΨ : DifferentiableAt ℝ Ψ y :=
    (h.smooth_inv.contDiffAt (hV.mem_nhds hy)).differentiableAt (by simp)
  have hdΦ : DifferentiableAt ℝ Φ (Ψ y) :=
    (h.smooth.contDiffAt (hU.mem_nhds hx)).differentiableAt (by simp)
  -- `Φ ∘ Ψ = id` near `y`, so `DΦ(Ψ y) ∘ DΨ(y) = id`
  have hcomp : HasFDerivAt (Φ ∘ Ψ) ((fderiv ℝ Φ (Ψ y)).comp (fderiv ℝ Ψ y)) y :=
    hdΦ.hasFDerivAt.comp y hdΨ.hasFDerivAt
  have hev : (Φ ∘ Ψ) =ᶠ[𝓝 y] id := by
    filter_upwards [hV.mem_nhds hy] with z hz
    exact h.right_inv z hz
  have hid : HasFDerivAt id ((fderiv ℝ Φ (Ψ y)).comp (fderiv ℝ Ψ y)) y := hcomp.congr_of_eventuallyEq hev.symm
  have huniq := hid.unique (hasFDerivAt_id y)
  -- apply to the basis vector `eᵢ`
  have hvec : J (Ψ y) *ᵥ (fderiv ℝ Ψ y (Pi.single i 1)) = Pi.single i 1 := by
    have := congrArg (fun L : Pt 4 →L[ℝ] Pt 4 => L (Pi.single i 1)) huniq
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at this
    calc J (Ψ y) *ᵥ (fderiv ℝ Ψ y (Pi.single i 1))
        = fderiv ℝ Φ (Ψ y) (fderiv ℝ Ψ y (Pi.single i 1)) :=
          (fderiv_eq_mulVec hU h.smooth hx (h.jacobian _ hx) _).symm
      _ = Pi.single i 1 := this
  have hKJ : K (Ψ y) * J (Ψ y) = 1 := mul_eq_one_comm.mp (hJK _ hx)
  have hcol : fderiv ℝ Ψ y (Pi.single i 1) = fun k => K (Ψ y) k i := by
    have e : fderiv ℝ Ψ y (Pi.single i 1) = K (Ψ y) *ᵥ (J (Ψ y) *ᵥ fderiv ℝ Ψ y (Pi.single i 1)) := by
      rw [Matrix.mulVec_mulVec, hKJ, Matrix.one_mulVec]
    rw [e, hvec]
    ext k
    simp [Matrix.mulVec, dotProduct, Pi.single_apply]
  -- the slice derivative of `Ψ_k` along `i`
  have h1 : HasDerivAt (Function.update y i) (Pi.single i 1) (y i) := hasDerivAt_update y i (y i)
  have h2 : HasFDerivAt Ψ (fderiv ℝ Ψ y) (Function.update y i (y i)) := by
    rw [Function.update_eq_self]; exact hdΨ.hasFDerivAt
  have h3 := HasFDerivAt.comp_hasDerivAt (x := y i) (hl := h2) (hf := h1)
  have h4 := (hasDerivAt_pi.mp h3) k
  rw [hcol] at h4
  exact h4
