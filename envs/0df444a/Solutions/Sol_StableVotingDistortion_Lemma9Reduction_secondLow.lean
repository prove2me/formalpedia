section
set_option autoImplicit true
namespace StableVotingDistortion.PaperAnalytic
open Set PaperCurve PaperBox PaperMiddle


structure MassCell where
  lo : ℚ
  hi : ℚ
  beta0 : ℚ
  beta1 : ℚ
  eta0 : ℚ
  eta1 : ℚ
  j0 : ℚ
  j1 : ℚ
  cap0 : ℚ
  cap1 : ℚ
  deriving DecidableEq,Repr


def massOK (m : MassCell) : Bool :=
  let j := qprimitive m.lo
  decide (0 ≤ m.lo ∧ m.hi≤1 ∧ 0 ≤ m.eta0 ∧ 0 ≤ m.eta1 ∧ 0 ≤ m.cap0 ∧ 0 ≤ m.cap1 ∧
    m.j0 ≤ j ∧ m.j1 ≤ j+(m.hi-m.lo)*qscore m.hi ∧
    m.lo+m.cap0 ≤ m.beta0*m.j0 ∧ m.hi+m.cap1 ≤ m.beta1*m.j1 ∧
    m.lo+m.hi+m.cap0+m.cap1 ≤ m.beta0*m.j1+m.beta1*m.j0)

def capTest (e c : ℚ) (s : Segment) (a b : ℚ) : Prop :=
  e*s.qline a+a-lamQ ≤ c ∧ e*s.qline b+b-lamQ ≤ c
instance (e c : ℚ) (s : Segment) (a b : ℚ) : Decidable (capTest e c s a b) :=
  inferInstanceAs (Decidable (_ ∧ _))
def capOK (m : MassCell) (s : Segment) : Bool :=
  let a := max m.lo s.lo
  if s.hi < a then true else decide (capTest m.eta0 m.cap0 s a s.hi ∧ capTest m.eta1 m.cap1 s a s.hi)

private theorem cap_sound {e c a b : ℚ} {s : Segment} {x : ℝ} (ok : capTest e c s a b)
    (hx : x∈Icc (a:ℝ) b) (he : 0 ≤ e) (hh : score x ≤ s.line x) :
    (e:ℝ)*score x+x-PaperCurve.lam ≤ c := by
  obtain ⟨t,ht,eq⟩ := affine_parameter hx
  have h0 := (Rat.cast_le (K:=ℝ)).mpr ok.1
  have h1 := (Rat.cast_le (K:=ℝ)).mpr ok.2
  simp only [Rat.cast_sub,Rat.cast_add,Rat.cast_mul,Segment.cast_qline] at h0 h1
  have h := add_le_add (mul_le_mul_of_nonneg_left h0 (sub_nonneg.mpr ht.2)) (mul_le_mul_of_nonneg_left h1 ht.1)
  have hs := mul_le_mul_of_nonneg_left hh (by exact_mod_cast he : (0:ℝ) ≤ e)
  unfold Segment.line at hs h
  unfold PaperCurve.lam
  rw [eq] at hs ⊢
  linarith only [h,hs]

private theorem product_lower {t b B j J a A c C : ℝ} (ht : t∈Icc (0:ℝ) 1)
    (h0 : a+c ≤ b*j) (h1 : A+C ≤ B*J) (hm : a+A+c+C ≤ b*J+B*j) :
    (1-t)*a+t*A+((1-t)*c+t*C) ≤ ((1-t)*b+t*B)*((1-t)*j+t*J) := by
  have l := mul_nonneg (sq_nonneg (1-t)) (sub_nonneg.mpr h0)
  have r := mul_nonneg (sq_nonneg t) (sub_nonneg.mpr h1)
  have m := mul_nonneg (mul_nonneg (sub_nonneg.mpr ht.2) ht.1) (sub_nonneg.mpr hm)
  linarith only [l,r,m]

theorem mass_certifies {m : MassCell} (ok : massOK m=true) {s : Segment} (caps : capOK m s=true)
    {p x t β η : ℝ} (hp : p∈Icc (m.lo:ℝ) m.hi)
    (hx : x∈Icc (s.lo:ℝ) s.hi) (hpx : p ≤ x) (hφ : score x ≤ s.line x)
    (ht : t∈Icc (0:ℝ) 1) (ep : p=(1-t)*m.lo+t*m.hi)
    (eb : β=(1-t)*m.beta0+t*m.beta1) (ee : η=(1-t)*m.eta0+t*m.eta1) (hβ : 0≤β) :
    p-β*J score p+max (x-PaperCurve.lam+η*score x) 0≤0 := by
  unfold massOK at ok
  obtain ⟨a0,b1,e0,e1,c0,c1,j0,j1,v0,v1,vm⟩ := of_decide_eq_true ok
  let a := max m.lo s.lo
  have ha : (a:ℝ) ≤ x := by simpa [a] using max_le (hp.1.trans hpx) hx.1
  have hh : a ≤ s.hi := by exact_mod_cast ha.trans hx.2
  change (if s.hi < a then true else decide _) = true at caps
  rw [if_neg hh.not_gt] at caps
  obtain ⟨k0,k1⟩ : capTest m.eta0 m.cap0 s a s.hi ∧ capTest m.eta1 m.cap1 s a s.hi := of_decide_eq_true caps
  have p0 : (0:ℝ) ≤ m.lo := by exact_mod_cast a0
  have p1 : (m.hi:ℝ)≤1 := by exact_mod_cast b1
  have d := primitive_sandwich score_isScoreFunction p0 hp.1 (hp.2.trans p1)
  have fs := score_antitone (show p∈Icc 0 1 from ⟨p0.trans hp.1,hp.2.trans p1⟩)
    (show (m.hi:ℝ)∈Icc 0 1 from ⟨(p0.trans hp.1).trans hp.2,p1⟩) hp.2
  have jl := (Rat.cast_le (K:=ℝ)).mpr j0
  have jr := (Rat.cast_le (K:=ℝ)).mpr j1
  have heJ : (qprimitive m.lo:ℝ)=J score m.lo := (qprimitive_exact _).trans
    (J_score ⟨p0,(hp.1.trans hp.2).trans p1⟩).symm
  simp only [heJ,Rat.cast_add,Rat.cast_sub,Rat.cast_mul,qscore_exact] at jr jl
  have hj : (1-t)*(m.j0:ℝ)+t*m.j1 ≤ J score p := by
    have H := add_le_add (mul_le_mul_of_nonneg_left jl (sub_nonneg.mpr ht.2)) (mul_le_mul_of_nonneg_left jr ht.1)
    have hm := mul_le_mul_of_nonneg_left fs (sub_nonneg.mpr hp.1)
    rw [ep] at hm d
    rw [ep]
    linarith only [H,hm,d.1]
  have ma := cap_sound k0 ⟨ha,hx.2⟩ e0 hφ
  have mb := cap_sound k1 ⟨ha,hx.2⟩ e1 hφ
  have hc : max (x-PaperCurve.lam+η*score x) 0≤(1-t)*m.cap0+t*m.cap1 := by
    apply max_le
    · rw [ee];linarith only [mul_le_mul_of_nonneg_left ma (sub_nonneg.mpr ht.2),mul_le_mul_of_nonneg_left mb ht.1]
    · exact add_nonneg (mul_nonneg (sub_nonneg.mpr ht.2) (by exact_mod_cast c0)) (mul_nonneg ht.1 (by exact_mod_cast c1))
  have hh0 : (m.lo:ℝ)+m.cap0≤(m.beta0:ℝ)*m.j0 := by exact_mod_cast v0
  have hh1 : (m.hi:ℝ)+m.cap1≤(m.beta1:ℝ)*m.j1 := by exact_mod_cast v1
  have hhm : (m.lo:ℝ)+m.hi+m.cap0+m.cap1≤(m.beta0:ℝ)*m.j1+(m.beta1:ℝ)*m.j0 := by exact_mod_cast vm
  have h := product_lower ht hh0 hh1 hhm
  rw [← ep,← eb] at h
  linarith only [h,hc,mul_le_mul_of_nonneg_left hj hβ]

def endpointFor (col : PaperMiddle.Knot → ℕ) (c d : PaperMiddle.Knot) (x : ℚ) : ℚ :=
  qValue col c+qSlope col c d*(x-qRank c)

def link (c d : PaperMiddle.Knot) (l h : ℚ) (m : MassCell) : Prop :=
  m.lo=l ∧ m.hi=h ∧ m.beta0=endpointFor PaperMiddle.Knot.beta c d l ∧
    m.beta1=endpointFor PaperMiddle.Knot.beta c d h ∧ m.eta0=endpointFor PaperMiddle.Knot.eta c d l ∧
    m.eta1=endpointFor PaperMiddle.Knot.eta c d h
instance (c d : PaperMiddle.Knot) (l h : ℚ) (m : MassCell) : Decidable (link c d l h m) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _))

def cellsMatch (ms : List MassCell) (z : PaperMiddle.Knot×PaperMiddle.Knot) : Bool :=
  let a := qRank z.1
  let b := min (qRank z.2) lamQ
  let mid := (a+b)/2
  if b < a then true else ms.any (fun m => decide (link z.1 z.2 a mid m)) &&
    ms.any (fun m => decide (link z.1 z.2 mid b m))

theorem entry_mixes {c d : PaperMiddle.Knot} {p t : ℝ} {a b : ℚ} {col : PaperMiddle.Knot → ℕ}
    (hs : rank c < rank d) (hk : p∈Icc (rank c) (rank d)) (hp : p=(1-t)*(a:ℝ)+t*b)
    (en : entry col p=interpolate col c d p) :
    entry col p=(1-t)*(endpointFor col c d a:ℝ)+t*(endpointFor col c d b:ℝ) := by
  rw [en,interpolate_eq _ _ _ _ hs hk,hp]
  simp only [endpointFor,Rat.cast_add,Rat.cast_mul,Rat.cast_sub,qValue_cast,qSlope_cast,qRank_cast]
  ring

end StableVotingDistortion.PaperAnalytic
end

