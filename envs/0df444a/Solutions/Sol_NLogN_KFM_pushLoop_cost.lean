-- Source module: Solutions.KFMS7
/-!
# KFM S7: the source and inverse lists in IL (run lemmas)

Scratch stacks `1–5` (setup is a leaf procedure, UNIFORM amendment): `mOc = 1` outer counter,
`mS = 2` the source `s_i`, `mP = 3` the running product, `mM = 4` the sum, `mIc = 5` the inner
counter. The parameters are read from `zDp, zQ, zMh, zMf` (KFMS3).

* `srcE ix`: `s_j = 1 + Q·(j < d' ? M_h − j : M_f − (j − d'))` for `j = ix` (**`srcE_spec`**).
* `muB dst`: for `i = (top of mOc) − 1`, computes `P_i mod s_i` by a product loop, then
  `μ_i = Σ_{y=1}^{s_i} y·[y P_i ≡ 1]` by a sum loop, and pushes `μ_i` on `dst`
  (**`muB_run`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul RS

/-! ## The product loop -/

/-! ## The sum loop -/

/-! ## One inverse -/

/-! ## Loops that push one value per index -/

theorem pushL_succ (v : ℕ → ℤ) (d k : ℕ) (hk : k < d) :
    pushL v d (k + 1) = v (d - k - 1) :: pushL v d k := by
  unfold pushL
  rw [List.range_succ_eq_map, List.map_cons, List.map_map]
  congr 1
  all_goals first
    | (congr 1; omega)
    | (apply List.map_congr_left
       intro t _
       show v (d - (k + 1) + (t + 1)) = v (d - k + t)
       congr 1; omega)

end NLogN.KFM

end

