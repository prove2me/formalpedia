open LanglandsTunnell.CubicInduction.CharacterComponents

variable {v : HeightOneSpectrum (𝓞 ℚ)}

private theorem localChar_mul_localChar_pow_three_eq_one
    {ω χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ} (hω : IsUnramifiedCharAt ω v)
    (hχ : IsUnramifiedCharAt χ v) {u : (v.adicCompletion ℚ)ˣ} (hu : IsIntegralUnit v u) :
    localChar ω v u * localChar χ v u ^ 3 = 1 := by
  rw [hω u hu.1 hu.2, hχ u hu.1 hu.2, one_pow, mul_one]

private theorem coe_localChar_mul_coe_localChar_pow_three_eq_one {ω χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ}
    (hω : IsUnramifiedCharAt ω v) (hχ : IsUnramifiedCharAt χ v) {u : (v.adicCompletion ℚ)ˣ}
    (hu : IsIntegralUnit v u) :
    ((localChar ω v u : ℂˣ) : ℂ) * ((localChar χ v u : ℂˣ) : ℂ) ^ 3 = 1 := by
  rw [hω u hu.1 hu.2, hχ u hu.1 hu.2, Units.val_one, one_pow, mul_one]

private theorem isIntegralUnit_of_mul_self_eq_one
    {t : (v.adicCompletion ℚ)ˣ} (ht : t * t = 1) : IsIntegralUnit v t := by
  have hinv : t⁻¹ = t := inv_eq_of_mul_eq_one_right ht
  have hsq : Valued.v (t : v.adicCompletion ℚ) * Valued.v (t : v.adicCompletion ℚ) = 1 := by
    rw [← map_mul, ← Units.val_mul, ht, Units.val_one, map_one]
  have hle : Valued.v (t : v.adicCompletion ℚ) ≤ 1 := by
    rcases le_total (Valued.v (t : v.adicCompletion ℚ)) 1 with h | h
    · exact h
    · calc Valued.v (t : v.adicCompletion ℚ) = Valued.v (t : v.adicCompletion ℚ) * 1 := (mul_one _).symm
        _ ≤ Valued.v (t : v.adicCompletion ℚ) * Valued.v (t : v.adicCompletion ℚ) := mul_le_mul_right h _
        _ = 1 := hsq
  refine ⟨(HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hle, ?_⟩
  rw [hinv]
  exact (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hle

private theorem apply_archIdeleHom_mul_prod_localChar_eq_one (ξ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (hξ : Continuous ξ)
    (N : Finset (HeightOneSpectrum (𝓞 ℚ))) (hN : ∀ w, w ∉ N → IsUnramifiedCharAt ξ w) {y : (AdeleRing (𝓞 ℚ) ℚ)ˣ}
    (hyy : y * y = 1) (hy : ξ y = 1) :
    ξ (archIdeleHom (unitsAtInfinity y)) * ∏ w ∈ N, localChar ξ w (unitsAt w y) = 1 := by
  rw [← apply_eq_apply_unitsAtInfinity_mul_prod_localChar ξ hξ N hN archIdeleHom archIdeleHom_apply_coe y
    fun w _ => isIntegralUnit_of_mul_self_eq_one (by rw [← map_mul, hyy, map_one])]
  exact hy

private theorem exists_ne_one_of_addCharLevel_eq_zero (ψ : AddChar (v.adicCompletion ℚ) ℂ)
    (hψk : ∃ k : ℤ, ∀ x : v.adicCompletion ℚ, Valued.v x ≤ WithZero.exp k → ψ x = 1) (hψ : ψ ≠ 1)
    (h0 : addCharLevel ψ = 0) (y : v.adicCompletion ℚ) (hy : y ∉ v.adicCompletionIntegers ℚ) :
    ∃ x : v.adicCompletion ℚ, Valued.v (x * y⁻¹) ≤ 1 ∧ ψ x ≠ 1 := by
  obtain ⟨-, x, hx, hxψ⟩ := forall_eq_one_and_exists_ne_one_of_addCharLevel ℚ v ψ hψk hψ
  rw [h0, zero_add] at hx
  have h1 : 1 < Valued.v y := lt_of_not_ge fun h => hy ((HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr h)
  have hne : Valued.v y ≠ 0 := (zero_lt_one.trans h1).ne'
  have hlog : (0 : ℤ) < WithZero.log (Valued.v y) := by
    rw [WithZero.lt_log_iff_exp_lt hne, WithZero.exp_zero]
    exact h1
  have hexp : WithZero.exp (1 : ℤ) ≤ Valued.v y := (WithZero.le_log_iff_exp_le hne).mp (by omega)
  refine ⟨x, ?_, hxψ⟩
  rw [map_mul, map_inv₀, ← div_eq_mul_inv, div_le_one₀ (zero_lt_iff.mpr hne)]
  exact hx.trans hexp

end LanglandsTunnell.CubicInduction.TwistUnits
