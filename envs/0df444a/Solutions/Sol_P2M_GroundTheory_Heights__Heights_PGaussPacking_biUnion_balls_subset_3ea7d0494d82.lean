theorem _root_.solution {n : ℕ} (s : Finset (EuclideanSpace ℝ (Fin n))) {δ r : ℝ}
    (hs : ∀ x ∈ s, ‖x‖ ≤ r) :
    (⋃ x ∈ s, ball x (δ / 2)) ⊆ ball (0 : EuclideanSpace ℝ (Fin n)) (r + δ / 2) := by
  intro z hz
  simp only [Set.mem_iUnion] at hz
  obtain ⟨x, hx, hz⟩ := hz
  rw [mem_ball, dist_eq_norm] at hz ⊢
  rw [sub_zero]
  calc ‖z‖ = ‖(z - x) + x‖ := by rw [sub_add_cancel]
    _ ≤ ‖z - x‖ + ‖x‖ := norm_add_le _ _
    _ < δ / 2 + r := by linarith [hs x hx]
    _ = r + δ / 2 := by ring
end GroundTheory.Heights₂.Heights.PGaussPacking
