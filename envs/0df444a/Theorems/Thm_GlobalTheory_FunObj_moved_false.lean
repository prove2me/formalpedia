theorem GlobalTheory.FunObj.moved_false (g : G.VertexGroup) (T : G.Args → ℂ) (z : G.Args) : moved G false g T z =
    ((oppositePath G.m).map fun b => apow (gdet (g b.src))⁻¹ ((G.rank b.tgt : ℂ) / 2) *
