/-- The tables that oTables writes are those that a batch reads. -/
theorem BTabs.of_OTabs {x : Light.Filter2.OracleInst} {fr : ℕ} {μ : ℕ → ℤ} (h : OTabs x fr μ) : BTabs x fr μ := by
  have enl : (fun h : ℕ => resid x.p ((h : ℤ) * (-1) + (x.p : ℤ)))
      = fun h : ℕ => resid x.p ((x.p : ℤ) - h) := by
    funext h; congr 1; ring
  have ehk : (fun h : ℕ => resid x.p ((h : ℤ) * (oDig x.p : ℤ) + 0))
      = fun h : ℕ => resid x.p ((h * oDig x.p : ℕ) : ℤ) := by
    funext h; congr 1
  have hnl := h.nl
  have hhk := h.hk
  rw [enl] at hnl
  rw [ehk] at hhk
  exact ⟨h.rac, h.rnbc, hnl, hhk, h.rs, h.rv, h.zh, h.zl⟩

/-- **The run of the oracle.** -/
theorem oracle_ends (R : Program) {lim : Limits} {d : ℕ} {x : Light.Filter2.OracleInst} {μ : ℕ → ℤ} {fr : ℕ}
    (hpre : x.Pre μ fr) (hok : (Light.Batch.oNeedAt x.n x.U x.s x.p).Ok lim fr d) :
    Ends lim (oProg ++ R) d Light.Batch.oracleBody ⟨frame (Light.Filter2.oracleTask.args x ++ [(fr : ℤ)]), μ⟩
      (tOracle x.n x.U x.s x.p) fun σ' => Light.Filter2.oracleTask.Post x μ fr (σ'.loc 0) σ'.mem := by
  unfold Light.Batch.oracleBody tOracle
  (focus
     (repeat
         with_unfolding_none
           first
           | refine Light.Ends.seqAssoc ?_
           | refine Light.Ends.skipThen ?_)
     (first
       | refine Light.Ends.pieceThen (oParams_ends' R hpre hok) ?_ ?_
       | refine Light.Ends.pieceLast (oParams_ends' R hpre hok) ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => rintro ⟨loc₁, μ₁⟩ ⟨hloc₁, hso₁⟩))
  simp only at hloc₁ hso₁
  subst hloc₁
  have hk₁ : Kept μ μ₁ fr := fun b hb => hso₁ b (Or.inl hb)
  have hpre₁ : x.Pre μ₁ fr := { hpre with toPre := hpre.toPre.keep hk₁ }
  (focus
     (repeat
         with_unfolding_none
           first
           | refine Light.Ends.seqAssoc ?_
           | refine Light.Ends.skipThen ?_)
     (first
       | refine Light.Ends.pieceThen (oAddrs_ends R hpre hok (μ := μ₁)) ?_ ?_
       | refine Light.Ends.pieceLast (oAddrs_ends R hpre hok (μ := μ₁)) ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => rintro ⟨loc₂, μ₂⟩ ⟨hloc₂, hm₂⟩))
  simp only at hloc₂ hm₂
  subst hloc₂ hm₂
  (focus
     (repeat
         with_unfolding_none
           first
           | refine Light.Ends.seqAssoc ?_
           | refine Light.Ends.skipThen ?_)
     (first
       | refine Light.Ends.pieceThen (oTables_ends R hpre₁ hok 0 0 0 0) ?_ ?_
       | refine Light.Ends.pieceLast (oTables_ends R hpre₁ hok 0 0 0 0) ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
