    (by simp [NLogN.KIL.zB, NLogN.KIL.yB, NLogN.KIL.NE.val, w1 NLogN.KIL.kP (by decide), w1 NLogN.KIL.kG (by decide), w1 NLogN.KIL.kS (by decide),
