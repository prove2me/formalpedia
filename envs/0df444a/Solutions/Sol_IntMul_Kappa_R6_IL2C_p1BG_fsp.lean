section
-- Source module: Solutions.R6IL2CCorr
/-!
# Round six, compact controls (I2C): the correction with an abstract key program

`corrG kp B M A` is `KFL.corrRS` with the key program `keyProg` replaced by any register program
`kp` that pushes a key `κ k` on `rK` (`KeyOK`); the radix sort and pass 3 are the frozen ones.

**`corrG_fsp`**: for a bijection `κ` of `ℕ` (inverse `γ`) preserving `[0, M)`,
`flR recs M ↦ flR (recs ∘ γ) M`, at the cost `cCorrG` (moved records only in the sort).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## The program -/

theorem P1_env (κ : ℕ → ℕ) (recs : ℕ → List ℤ) (M : ℕ) (G0 : Fin HS → List ℤ) (k : ℕ) :
    ∀ r ∈ kEnvRegs, KFL.P1 κ recs M G0 k r = G0 r := by
  intro r hr
  simp only [kEnvRegs, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp +decide [KFL.P1, Function.update_apply]

set_option maxHeartbeats 2000000 in
/-- **One record of pass 1** with an abstract key program. -/
theorem p1BG_fsp_sol_aux {kp : RS} {κ : ℕ → ℕ} {B M cK Bb : ℕ} (hB : 1 ≤ B) (hB2 : 2 ≤ Bb)
    (hbig : 4 * (M * B) < 2 ^ Bb) (hκ : ∀ m < M, κ m < M)
    (recs : ℕ → List ℤ) (hlen : ∀ m, (recs m).length = B) (hbits : ∀ m, Bnd 1 (recs m))
    (s : IState HS) (hkp : KeyOK kp s κ M cK) (G0 : Fin HS → List ℤ) (hC : G0 rC = [])
    (hE : ∀ r ∈ kEnvRegs, G0 r = []) {k : ℕ} (hk : k < M) :
    FSp (p1BG kp B) (encK s (KFL.P1 κ recs M G0 k)) (encK s (KFL.P1 κ recs M G0 (k + 1)))
      (cP1G cK B Bb) := by
  set V := M * B with hVd
  have hMV : M ≤ V := Nat.le_mul_of_pos_right _ hB
  have hBV : B ≤ V := Nat.le_mul_of_pos_left _ (by omega)
  have hb4 : ((4 * V : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hbig
  push_cast at hb4
  have zN : ∀ n : ℕ, n ≤ 2 * V → zsz (n : ℤ) ≤ Bb := fun n hn => zsz_of_le hb4 (by
    rw [abs_of_nonneg (by positivity)]; have : (n : ℤ) ≤ 2 * V := by exact_mod_cast hn
    linarith)
  set G := KFL.P1 κ recs M G0 k with hG
  have gm : G rm = (k : ℤ) :: G0 rm := by simp +decide [G, KFL.P1, Function.update_apply]
  have gc : G rC = [] := by simp +decide [G, KFL.P1, Function.update_apply, hC]
  have gK : G rK = G0 rK := by simp +decide [G, KFL.P1, Function.update_apply]
  have gN : G rNB = (nMv κ k : ℤ) :: G0 rNB := by simp +decide [G, KFL.P1, Function.update_apply]
  have g0 : G 0 = recs k ++ restR recs M (k + 1) := by
    simp +decide [G, KFL.P1, Function.update_apply]; exact restR_succ recs hk
  have gE : ∀ r ∈ kEnvRegs, G r = [] := fun r hr => by
    rw [hG, P1_env κ recs M G0 k r hr]; exact hE r hr
  -- the key
  have SK := hkp G k (G0 rm) gc gE hk gm
  set G1 := Function.update G rK ((κ k : ℤ) :: G rK) with hG1
  have hκM : κ k < M := hκ k hk
  -- the branch
  have SB := brB_fsp (B := B) (Bb := Bb) (by omega) s G1 (recs k) (restR recs M (k + 1))
    (by simp only [G1]; rw [upd_ne (by decide)]; exact g0) (hlen k) (hbits k) (zN _ (by omega))
    (k := k) (kv := κ k) (nb := nMv κ k) (lk := G rK) (lm := G0 rm) (ln := G0 rNB)
    (by simp only [G1]; rw [Function.update_self])
    (zN _ (by omega)) (by simp only [G1]; rw [upd_ne (by decide)]; exact gm) (zN _ (by omega))
    (by simp only [G1]; rw [upd_ne (by decide)]; exact gN)
    (zN _ (by have := nMv_le κ k; omega))
    (by have := nMv_le κ k; exact_mod_cast zN (nMv κ k + 1) (by omega))
    (zsz_of_le hb4 (by
      rw [abs_le]; constructor
      · have : (k : ℤ) ≤ V := by exact_mod_cast (by omega : k ≤ V)
        have : (0 : ℤ) ≤ κ k := by positivity
        linarith
      · have : (κ k : ℤ) ≤ V := by exact_mod_cast (by omega : κ k ≤ V)
        have : (0 : ℤ) ≤ k := by positivity
        linarith))
  set G2 := Function.update (Function.update (Function.update (Function.update (Function.update
      (Function.update G1 0 (restR recs M (k + 1)))
      sT ((if decide (κ k ≠ k) then [] else (recs k).reverse) ++ G1 sT))
      sKB ((if decide (κ k ≠ k) then (recs k).reverse else []) ++ G1 sKB))
      sKK ((if decide (κ k ≠ k) then [(κ k : ℤ)] else []) ++ G1 sKK))
      sFL ((if κ k ≠ k then 1 else 0) :: G1 sFL))
      rNB (((nMv κ k + if κ k ≠ k then 1 else 0 : ℕ) : ℤ) :: G0 rNB) with hG2
  have g2K : G2 rK = (κ k : ℤ) :: G0 rK := by
    simp only [G2]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
      upd_ne (by decide), upd_ne (by decide)]
    simp only [G1]; rw [Function.update_self, gK]
  have S3 := Sp.pop s G2 (B := Bb) (by decide) g2K (zN _ (by omega))
  set G3 := Function.update G2 rK (G0 rK) with hG3
  have g3m : G3 rm = (k : ℤ) :: G0 rm := by
    simp only [G3, G2]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
      upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]
    simp only [G1]; rw [upd_ne (by decide)]; exact gm
  have S4 := Sp.asg s G3 (i := rm) (e := .add (.reg rm) (.lit 1)) (B := Bb) (by decide) g3m
    (zN _ (by omega)) (clean_add (clean_reg (by decide)) (clean_lit _)) ⟨ok_reg g3m, trivial⟩
    ⟨trivial, trivial⟩
    ⟨bnd_reg g3m (zN _ (by omega)), by simp only [Ex.Bnd, zsz_one]; omega, by
      simp only [Ex.eval]; rw [top_encK g3m]; exact_mod_cast zN (k + 1) (by omega)⟩
  have ev4 : (Ex.add (.reg rm) (.lit 1) : Ex HS).eval (encK s G3) = (k : ℤ) + 1 := by
    simp only [Ex.eval]; rw [top_encK g3m]
  rw [ev4] at S4
  have H := SK.seq (SB.seq ((FSp.of_norep rfl S3).seq (FSp.of_norep rfl S4)))
  refine (H.congr ?_).mono ?_
  · congr 1
    funext j
    simp only [G3, G2, G1, G, KFL.P1]
    by_cases a1 : j = rm
    · subst a1; simp +decide
    by_cases a2 : j = rK
    · subst a2; simp +decide
    by_cases a3 : j = rNB
    · subst a3; simp +decide [nMv_succ]
    by_cases a4 : j = sFL
    · subst a4; simp +decide [flL_succ, flagV]
    by_cases a5 : j = sKK
    · subst a5; simp +decide [stkK_succ, mvP]
    by_cases a6 : j = sKB
    · subst a6; simp +decide [stkF_succ, mvP]
    by_cases a7 : j = sT
    · subst a7; simp +decide [stkF_succ, mvP]
    by_cases a8 : j = 0
    · subst a8; simp +decide
    simp [Function.update_apply, a1, a2, a3, a4, a5, a6, a7, a8]
  · clear H SK SB S3 S4
    simp only [cP1G, Ex.size]
    have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
    have : (Bb + 2) ≤ (Bb + 2) ^ 2 := by nlinarith
    nlinarith

end IntMul.Kappa.R6.IL2C

end

theorem solution : type_of% @IntMul.Kappa.R6.IL2C.p1BG_fsp_sol_aux := @IntMul.Kappa.R6.IL2C.p1BG_fsp_sol_aux
