theorem solution (R : Type) [CommRing R] (e f : R)
    (Φ : Polynomial R) :
    ∃ q : (TypeDensity.BlowupChart R e f ⧸ Ideal.span
        {TypeDensity.chartBase R e f e, Polynomial.eval₂ (TypeDensity.chartBase R e f) (TypeDensity.chartSlope R e f) Φ}) ≃+* AdjoinRoot
      (Φ.map (Ideal.Quotient.mk (Ideal.span ({e, f} : Set R)))),
      (∀ r : R, q (Ideal.Quotient.mk _ (TypeDensity.chartBase R e f r)) = AdjoinRoot.of _
        (Ideal.Quotient.mk (Ideal.span ({e, f} : Set R)) r)) ∧ q
      (Ideal.Quotient.mk _ (TypeDensity.chartSlope R e f)) = AdjoinRoot.root _ := by
  obtain ⟨ε, hεb, hεs⟩ := TypeDensity.exceptional_chart_is_affine_line R e f
  set P := Polynomial.eval₂ (TypeDensity.chartBase R e f) (TypeDensity.chartSlope R e f) Φ with hP
  set J := TypeDensity.exceptionalLevelIdeal R e f 1 with hJ
  have hsup : Ideal.span {TypeDensity.chartBase R e f e, P} = J ⊔ Ideal.span {P} := by
    rw [hJ, TypeDensity.exceptionalLevelIdeal, pow_one, ← Ideal.span_insert]
  have hεP : ε (Ideal.Quotient.mk J P) =
      Φ.map (Ideal.Quotient.mk (Ideal.span ({e, f} : Set R))) := by
    rw [hP, Polynomial.hom_eval₂]
    change (ε.toRingHom) _ = _
    rw [Polynomial.hom_eval₂]
    have h1 : ε.toRingHom.comp ((Ideal.Quotient.mk J).comp (TypeDensity.chartBase R e f)) =
        Polynomial.C.comp (Ideal.Quotient.mk (Ideal.span ({e, f} : Set R))) := by
      exact RingHom.ext hεb
    have h2 : ε.toRingHom (Ideal.Quotient.mk J (TypeDensity.chartSlope R e f)) = Polynomial.X := hεs
    rw [h1, h2]
    rfl
  have hK : Ideal.span {Φ.map (Ideal.Quotient.mk (Ideal.span ({e, f} : Set R)))} =
      (Ideal.map (Ideal.Quotient.mk J) (Ideal.span {P})).map ε.toRingHom := by
    rw [Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton]
    simp [hεP]
  let E1 := Ideal.quotEquivOfEq hsup
  let E2 := (DoubleQuot.quotQuotEquivQuotSup J (Ideal.span {P})).symm
  let E3 : ((TypeDensity.BlowupChart R e f ⧸ J) ⧸ (Ideal.map (Ideal.Quotient.mk J) (Ideal.span {P}))) ≃+*
      AdjoinRoot (Φ.map (Ideal.Quotient.mk (Ideal.span ({e, f} : Set R)))) :=
    Ideal.quotientEquiv _ _ ε hK
  refine ⟨(E1.trans E2).trans E3, ?_, ?_⟩
  · intro r
