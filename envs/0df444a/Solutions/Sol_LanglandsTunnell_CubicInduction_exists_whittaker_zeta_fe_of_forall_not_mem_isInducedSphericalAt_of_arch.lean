private theorem infPart_archIdeleHom (u : (InfiniteAdeleRing ℚ)ˣ) :
    M4aHerbrand.infPart (archIdeleHom u) = u := by
  apply Units.ext
  rw [M4aHerbrand.coe_infPart_apply, archIdeleHom_apply_coe]

private theorem finPart_archIdeleHom (u : (InfiniteAdeleRing ℚ)ˣ) :
    RatIdele.finPart (archIdeleHom u) = 1 := by
  apply Units.ext
  show ((archIdeleHom u : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).2 = 1
  rw [archIdeleHom_apply_coe]

private theorem infPart_archIdeleHom_eq_and_finPart_archIdeleHom_eq_one (u : (InfiniteAdeleRing ℚ)ˣ) :
    M4aHerbrand.infPart (archIdeleHom u) = u ∧ RatIdele.finPart (archIdeleHom u) = 1 :=
  ⟨infPart_archIdeleHom u, finPart_archIdeleHom u⟩

end

