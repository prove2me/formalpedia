variable {K : Type*} [Field K] {R : Subring K}
open BruhatTits
open Pointwise
variable [IsDiscreteValuationRing R]
namespace BruhatTits
theorem _root_.solution (b : Basis (Fin 2) K (Fin 2 → K)) {ϖ : R} (hϖ : Irreducible ϖ) :
    IsStandardNeighbour (b.ntwist₂ hϖ 1 0).toLattice (b.toLattice (R := R)) where
  lt := by
    simp [Basis.ntwist₂, Basis.twist₂]
    nth_rw 2 [← b.twist_zero hϖ]
    rw [b.twist_lt_twist_iff]
    constructor
    intro i
    match i with
    | 0 => simp
    | 1 => simp
    use 0
    simp
  ϖlt := by
    intro ϖ' hϖ'
    rw [← maximalIdeal_smul_eq_uniformizer_smul _ hϖ', maximalIdeal_smul_eq_uniformizer_smul _ hϖ]
    simp [Basis.ntwist₂, Basis.twist₂]
    nth_rw 1 [← b.twist_zero hϖ]
    rw [b.smul_twist]
    rw [b.twist_lt_twist_iff]
    constructor
    intro i
    match i with
    | 0 => simp
    | 1 => simp
    use 1
    simp
end BruhatTits
