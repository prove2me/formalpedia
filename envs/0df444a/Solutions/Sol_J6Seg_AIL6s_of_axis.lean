lemma chirpA_congr (P σ W s t α H : ℕ) (U U' : ℕ → ℤ × ℤ) (hs : 0 < s)
    (h : ∀ j < s, U j = U' j) : chirpA P σ W s t α H U = chirpA P σ W s t α H U' := by
  have e : ∀ j : ℤ, U (j % (s : ℤ)).toNat = U' (j % (s : ℤ)).toNat := by
