open ModularCurve

theorem ModularCurve.jqNModC_mul_eq_pow (K : Type*) [CommRing K] (N : ℕ) [NeZero N] {ℓ : ℕ} [Fact ℓ.Prime] [CharP K ℓ] :
    jqNModC K (N * ℓ) = (jqNModC K N) ^ ℓ := by sorry
