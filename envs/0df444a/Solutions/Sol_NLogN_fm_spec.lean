        rw [abs_lt, pow_succ]; constructor <;> linarith)
      omega
    have hsm := NLogN.smul_runs (I := I) (iprog := iprog) (A := NLogN.ARG) (X := NLogN.XA) (Y := NLogN.QS) (W := NLogN.W)
      (Q := NLogN.CC) (R := NLogN.U) (T := NLogN.V) (by decide) s a b LA hA
    have hfr := NLogN.fred_runs (I := I) (iprog := iprog) (X := NLogN.ARG) (by decide) (by decide) (by decide)
      (by decide) (s.upd NLogN.ARG (.int (a * b) :: LA)) (a * b) N LA LN LF (by simp)
      (by simp +decide [hN]) (by simp +decide [hF]) (by
        have hab : |a * b| < 2 ^ (2 * N + 1) := by
          rw [abs_of_nonneg (mul_nonneg ha.1 hb.1), pow_succ, pow_mul']
          have : a * b ≤ 2 ^ N * 2 ^ N := mul_le_mul ha.2 hb.2 hb.1 (by positivity)
          nlinarith [pow_pos (show (0 : ℤ) < 2 by norm_num) N]
        have : ((a * b).natAbs : ℤ) < 2 ^ (2 * N + 1) := by rw [Int.natCast_natAbs]; exact hab
        exact_mod_cast this)
    have hbody := NLogN.IRuns.seq ht (NLogN.IRuns.iteT (i := NLogN.ZZ) (f := fun c => c == NLogN.Cls.neg) (q := .seq (.op (.drop NLogN.ZZ)) (NLogN.fmMain pF pD pT pP)) hcl (NLogN.IRuns.seq hdrop (NLogN.IRuns.seq hsm hfr)))
    have hsc : NLogN.smulCost (NLogN.zsz a + NLogN.zsz b) ≤ NLogN.smulCost (2 * N + 2) := by
      simp only [NLogN.smulCost]; gcongr
    have hbc := NLogN.fmBase_cost N hN1 hl
    have hb2 : NLogN.IRuns I iprog (iprog pF) s (s.upd NLogN.ARG (.int ((a * b) % (2 ^ N + 1)) :: LA))
        (NLogN.fmPhi N - 2) := by
      rw [hPF]
      refine hbody.mono' ?_ ?_
      · clear * -; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
      · clear * - hbc hsc; generalize NLogN.fmPhi N = Φ at *; generalize NLogN.smulCost (NLogN.zsz a + NLogN.zsz b) = s1 at *; generalize NLogN.smulCost (2 * N + 2) = s2 at *; generalize (NLogN.fmL N + 1) ^ 2 = q at *; generalize NLogN.fmL N = l at *; apply Nat.le_sub_of_add_le; linarith
    exact (NLogN.IRuns.call hb2).mono (by clear * - hbc; generalize NLogN.fmPhi N = Φ at *; omega)
  · -- recursion
    have hl' : 2048 ≤ NLogN.fmL N := by simp only [NLogN.fmThr] at hl; omega
    have hdiv : 2 ^ NLogN.fmK N ∣ N := by
      rcases hcase with h | h
      · exact absurd h hl
      · exact h
    obtain ⟨_, hB, hKM, hM1, hnt, hnN, hℓ, hdiv'⟩ := Hpar N hl' hdiv
    have hFMn := ih (NLogN.fmN' N) hnN (by omega) (Or.inr hdiv')
    have hm := NLogN.fmMain_runs (I := I) (iprog := iprog) pF pD pT pP hPD hPT hPP N (NLogN.fmPhi (NLogN.fmN' N)) hFMn
      hN1 hB hKM hM1 hnt hnN.le hℓ s a b LA LP LN LF ha hb hA hP hN hF
    have hcl : (fun c => c == NLogN.Cls.neg) (s1.cl NLogN.ZZ) = false := by
      simp [hs1, hv]; simp only [NLogN.fmThr] at hl ⊢; omega
    have hbody := NLogN.IRuns.seq ht (NLogN.IRuns.iteF (i := NLogN.ZZ) (f := fun c => c == NLogN.Cls.neg) (p := .seq (.op (.drop NLogN.ZZ)) NLogN.fmBase) hcl (NLogN.IRuns.seq hdrop hm))
    have hc := Hcost N hl' hdiv
    have hb2 : NLogN.IRuns I iprog (iprog pF) s (s.upd NLogN.ARG (.int ((a * b) % (2 ^ N + 1)) :: LA))
        (NLogN.fmPhi N - 2) := by
      rw [hPF]; refine hbody.mono ?_
      clear * - hc hzv hl'; generalize NLogN.fmPhi N = Φ at *; generalize NLogN.fmPhi (NLogN.fmN' N) = Φ' at *; omega
    exact (NLogN.IRuns.call hb2).mono (by
      clear * - hc; generalize NLogN.fmPhi N = Φ at *; generalize NLogN.fmPhi (NLogN.fmN' N) = Φ' at *; omega)
end
