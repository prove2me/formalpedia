section PowerSums

variable {F : Type} [Field F] [Algebra (ZMod 2) F]

variable {N : ℕ}

end PowerSums

/-- First address of the multiplication table. -/
def detMulBase (_w : ℕ) : ℕ := 64

/-- First address of the squaring table. -/
def detSqBase (w : ℕ) : ℕ := detMulBase w + 2 ^ (2 * w)

/-- First address of the inversion table. -/
def detInvBase (w : ℕ) : ℕ := detSqBase w + 2 ^ (2 * w)

/-- First address of the position table `ι⁻¹(v) + 1`. -/
def detPosBase (w : ℕ) : ℕ := detInvBase w + 2 ^ w

/-- First address of the image table `i ↦ ι i`. -/
def detImgBase (w : ℕ) : ℕ := detPosBase w + 2 ^ w

/-- One past the last address used by `det`. -/
def detEnd (w : ℕ) : ℕ := detImgBase w + 2 ^ w

/-- The payload `y` read as a function of the bit position, with `0` outside the payload. -/
def payloadAt {M : ℕ} (y : Fin M → ZMod 2) (p : ℕ) : ZMod 2 :=
  if h : p < M then y ⟨p, h⟩ else 0

/-- The field element whose `b`-coordinates are the bits of the `j`-th packed field: this is the
`j`-th syndrome coordinate, written in the basis `b`. -/
noncomputable def payloadField {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) {M : ℕ} (y : Fin M → ZMod 2) (j : ℕ) : F :=
  b.repr.symm (Finsupp.equivFunOnFinite.symm (fun k : Fin w => payloadAt y (j * w + k.val)))

/-- The finite syndrome polynomial, with coefficient zero equal to `P₁`. -/
noncomputable def syndromePoly {F : Type} [Field F] (e : ℕ → F) (t : ℕ) : F[X] :=
  ∑ j ∈ Finset.range (2 * t), C (e j) * X ^ j

noncomputable def tracePolynomial {F : Type} [Field F] (a : F) : ℕ → F[X]
  | 0 => 0
  | n + 1 => tracePolynomial a n ^ 2 + C a * X

