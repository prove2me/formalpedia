    have hleg : ψ₀ = q.comp (frobTwist Onr Fr (-k) y.ψ) := by
      rw [M7Asm.comp_frobTwist, ← ModuliPackage.GPoint.map_ψ, ← hx₀, hk, M7Asm.frobTwist_frobTwist, add_neg_cancel,
        M7Asm.frobTwist_zero]
    subst hleg
    obtain ⟨x, -, -, -, -, -, -, -, -, -, -, -, hΞx⟩ :=
