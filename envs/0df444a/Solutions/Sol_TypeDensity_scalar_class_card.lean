    Nat.card (TypeDensity.scalarClass v) = Nat.card k - 1 ∧ (∀ w ∈ TypeDensity.scalarClass v, w ≠ 0) ∧
      (TypeDensity.scalarClass v).Finite := by
  classical
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hv
  refine ⟨?_, ?_, Set.toFinite _⟩
  · let f : {c : k // c ≠ 0} → TypeDensity.scalarClass v := fun c => ⟨c.1 • v, c.1, c.2, rfl⟩
