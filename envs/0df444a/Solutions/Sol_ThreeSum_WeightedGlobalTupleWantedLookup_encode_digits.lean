noncomputable section
open ThreeSum ThreeSum.WeightedGlobalTupleWantedLookup
open TernaryWantedLittleEndian
set_option maxHeartbeats 2000000
namespace ThreeSum.WeightedGlobalTupleWantedLookup
theorem _root_.solution (digits : List ℕ) (R : ℕ) (is : List ℕ) (code scale : ℕ) :
    encode digits R code scale is=code+scale*Nat.ofDigits R (is.map (fun i => digits.getD i 0)) := by
  induction is generalizing code scale with
  | nil => simp [encode,Nat.ofDigits]
  | cons i is ih =>
    rw [encode,ih]
    simp only [List.map_cons,Nat.ofDigits]
    norm_cast
    ring
end ThreeSum.WeightedGlobalTupleWantedLookup
