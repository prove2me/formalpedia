theorem Sm_zero : Sm (0 : GI) := by simp [Sm]

theorem sum_bits_lt (d : ℕ → ℕ) (hd : ∀ p, d p < 2) :
    ∀ K, ∑ p ∈ Finset.range K, d p * 2 ^ p < 2 ^ K
  | 0 => by simp
  | K + 1 => by
    rw [Finset.sum_range_succ, pow_succ]
    have := sum_bits_lt d hd K
    have : d K * 2 ^ K ≤ 1 * 2 ^ K := Nat.mul_le_mul_right _ (by have := hd K; omega)
    omega

theorem adig_lt {m n : ℕ} (b : Fin m × Fin n → Fin 2) (i : ℕ) : adig b i < 2 := by
  unfold adig; split_ifs
  · exact (b _).isLt
  · norm_num

theorem aidx_eq {m n : ℕ} (b : Fin m × Fin n → Fin 2) :
    aidx b = ∑ i ∈ Finset.range (m * n), adig b i * 2 ^ i := by
  unfold aidx
  rw [← Equiv.sum_comp finProdFinEquiv.symm, ← Fin.sum_univ_eq_sum_range
    (fun i => adig b i * 2 ^ i)]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [adig, i.isLt, dif_pos, Fin.eta, Equiv.apply_symm_apply]

theorem aidx_lt {m n : ℕ} (b : Fin m × Fin n → Fin 2) : aidx b < 2 ^ (m * n) := by
  rw [aidx_eq]; exact sum_bits_lt _ (adig_lt b) _

theorem length_segApply (off : ℕ) (Ms : List M2G) (B1 G : ℕ) (zs : List GI)
    (h : off + G * (2 * B1 * Ms.length) ≤ zs.length) :
    (segApply off Ms B1 G zs).length = zs.length := by
  unfold segApply
  rw [List.length_append, List.length_append, length_qopL _ _ _ _ (by simp; omega)]
  simp; omega

theorem GB_getD {w : ℕ} {zs : List GI} :
    NLogN.KFB.GB w zs ↔ ∀ i < zs.length, zsz (zs.getD i 0).1 ≤ w ∧ zsz (zs.getD i 0).2 ≤ w := by
  constructor
  · intro h i hi
    rw [List.getD_eq_getElem _ _ hi]; exact h _ (List.getElem_mem hi)
  · intro h z hz
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
    have := h i hi
    rwa [List.getD_eq_getElem _ _ hi] at this

theorem cQopW_le (w B1 G N off Z : ℕ) (hB : 1 ≤ B1) (hN : G * (2 * B1) = N) :
    cQopW w B1 [()].length G off Z ≤ NLogN.KFB.cPass w N off Z := by
  simp only [cQopW, cQop, NLogN.KFB.cBlk, NLogN.KFB.cPass, List.length_singleton, mul_one, one_mul]
  have hG : G ≤ N := by nlinarith
  have hGB : G * B1 ≤ N := by nlinarith
  have e1 : G * (B1 * (135000 * w + 530000) + 12000 + 2101) =
      (G * B1) * (135000 * w + 530000) + G * 14101 := by ring
  have e2 : 2 * (G * (2 * B1)) = 2 * N := by rw [hN]
  rw [e1, e2]
  have : (G * B1) * (135000 * w + 530000) ≤ N * (135000 * w + 530000) :=
    Nat.mul_le_mul_right _ hGB
  have : G * 14101 ≤ N * 14101 := Nat.mul_le_mul_right _ hG
  nlinarith

end NLogN.KFB

