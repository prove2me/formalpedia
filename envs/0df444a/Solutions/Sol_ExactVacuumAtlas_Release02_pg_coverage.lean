/-!
# Painlevé–Gullstrand: the atom `q = √(2M/r)` and its derivative shapes

The only analytic input of the PG tables beyond `Atlas.Core.Deriv`: for `M ≥ 0`, `r > 0`,
`q² = 2M/r` and `q' = −q/(2r)` (genuine `HasDerivAt`, including the case `M = 0` where `q ≡ 0`).
The shape lemmas in `PG.D` certify the closed forms that occur in the Christoffel table.
-/

open Real
open scoped ContDiff

namespace ExactVacuumAtlas.Schwarzschild.PG

@[simp] theorem qf_zero (r : ℝ) : qf 0 r = 0 := by simp [qf]

/-- At the coordinate radius `r = 2M` (for `M > 0`) the atom equals `1`. -/
theorem qf_two_mul {M : ℝ} (hM : 0 < M) : qf M (2 * M) = 1 := by
  unfold qf; rw [div_self (by positivity)]; exact Real.sqrt_one

namespace D

variable {M r : ℝ}

end D

end ExactVacuumAtlas.Schwarzschild.PG

