set_option autoImplicit false
theorem solution {ε h Q J : ℝ} {F b A : ℝ → ℝ} (hε : 0 < ε)
    (cF : ContDiffOn ℝ 6 F (Set.Ioo (-ε) ε))
    (cb : ContDiffOn ℝ 6 b (Set.Ioo (-ε) ε))
    (cA : ContDiffOn ℝ 6 A (Set.Ioo (-ε) ε))
    (F0 : F 0 = 1) (b0 : b 0 = 1) (A0 : A 0 = 0)
    (hPM : ∀ x ∈ Set.Ioo 0 ε, realPM h Q J F b A x = 0)
    (hPA : ∀ x ∈ Set.Ioo 0 ε, realPA h Q J F b A x = 0)
    (hPC : ∀ x ∈ Set.Ioo 0 ε, realPC h Q J F b A x = 0) :
    FiniteJetOutput h Q J F b A := by
  have h0 := zero_mem_Ioo6 hε
  have hF := contDiffAt6_of_Ioo cF h0
  have hb := contDiffAt6_of_Ioo cb h0
  have hA := contDiffAt6_of_Ioo cA h0
  have hn : JetNormalization (massLabel F) (magneticLabel A) (jet4 F) (jet4 b) (jet4 A) :=
    jetNormalization_jet4 F0 b0 A0
  have hr := selectedRows_of_right_zero_fin hε cF cb cA hPM hPA hPC
  obtain ⟨hrec, hΓ, -⟩ := vii04_compactified_jet_recursion _ h J Q _ _ _ _ hn hr
  simp only [coeff_jet4_of_lt _ (show (1 : ℕ) < 5 by norm_num),
    coeff_jet4_of_lt _ (show (2 : ℕ) < 5 by norm_num),
    coeff_jet4_of_lt _ (show (3 : ℕ) < 5 by norm_num),
    coeff_jet4_of_lt _ (show (4 : ℕ) < 5 by norm_num)] at hrec
  exact ⟨matchesC4_realPM hF hb hA h Q J, matchesC4_realPA hF hb hA h Q J,
    matchesC4_realPC hF hb hA h Q J, matchesC4_realCore hF hb hA h Q J, hn, hr, hrec, hΓ⟩
