-- title:
--   Deterministic causal CAS protocols and operational error resilience
-- statement:
--   There are $n$ labeled parties, each holding $m$ bits. A $T$-round deterministic protocol computes every outgoing action from the party's own input and received prefix. The alphabet is $\{0,1,\perp\}$; the last symbol means listen when sent. Exactly one speaker gives its bit as the channel baseline; silence and collisions both give $\perp$.
--
--   For a full received-symbol matrix $A$, errors are counted against the baseline of the actions generated by that same matrix. Write $e_i$ for the count at receiver $i$. Then
--   $$\delta_i=e_i/T,\qquad \overline\delta=\frac{\sum_i e_i}{nT}.$$
--   Resilience at budget $\delta\in[0,1]$ means full ordered-vector recovery, on every input and every matrix of average error at most $\delta$, by every receiver with $\delta_i\le10\delta$. Erasure resilience restricts each received symbol to the baseline or $\perp$. The rate is $nm/T$.
--
--   The final two transparent predicates express uniform achievability with the logarithmic rate bound and a uniform converse over all durations. Zero sizes have total definitions but are excluded in every theorem about resilience or rate.
-- source:
--   Klim Efremenko, Gillat Kol, Raghuvansh Saxena, Zhijun Zhang, STOC 2027 submission #1146 (October 2026), Section 3.3; Theorems 4.1 and 5.1, printed p.19, PDF p.21

import Mathlib

set_option autoImplicit false

namespace MultiPartyError1146.Adaptive

/-- The two transmitted bits and the listen/erasure symbol. -/
abbrev Symbol := Option Bool
abbrev Input (n m : ℕ) := Fin n → Fin m → Bool

/-- A causal deterministic CAS protocol. Time and party indices are zero based. -/
structure Protocol (n m T : ℕ) where
  send : (t : Fin T) → Fin n → (Fin m → Bool) → (Fin t.val → Symbol) → Symbol
  output : Fin n → (Fin m → Bool) → (Fin T → Symbol) → Input n m

/-- An adversary's full received-symbol matrix, independently specified per receiver. -/
abbrev Adversary (n T : ℕ) := Fin T → Fin n → Symbol

/-- Recursive prefix construction makes the execution order explicit. -/
def receivedPrefix {n T : ℕ} (A : Adversary n T) :
    (j : ℕ) → j ≤ T → Fin n → Fin j → Symbol
  | 0, _, _, t => Fin.elim0 t
  | j + 1, hj, i, t =>
    if h : t.val < j then
      receivedPrefix A j (by omega) i ⟨t.val, h⟩
    else A ⟨j, by omega⟩ i

/-- The actual actions in round t depend only on each party's own input and prefix. -/
def actions {n m T : ℕ} (P : Protocol n m T) (x : Input n m)
    (A : Adversary n T) (t : Fin T) : Fin n → Symbol :=
  fun i => P.send t i (x i) (receivedPrefix A t.val (Nat.le_of_lt t.isLt) i)

/-- Unique speaker's bit; both silence and collision give none. -/
noncomputable def cas {n : ℕ} (a : Fin n → Symbol) : Symbol := by
  classical
  let speakers := Finset.univ.filter (fun i => (a i).isSome)
  exact if h : speakers.card = 1 then a (Classical.choose (Finset.card_pos.mp (by omega : 0 < speakers.card))) else none

noncomputable def errorCount {n m T : ℕ} (P : Protocol n m T) (x : Input n m)
    (A : Adversary n T) (i : Fin n) : ℕ := by
  classical
  exact (Finset.univ.filter fun t => A t i ≠ cas (actions P x A t)).card

noncomputable def localError {n m T : ℕ} (P : Protocol n m T) (x : Input n m)
    (A : Adversary n T) (i : Fin n) : ℝ := errorCount P x A i / (T : ℝ)

noncomputable def averageError {n m T : ℕ} (P : Protocol n m T) (x : Input n m)
    (A : Adversary n T) : ℝ :=
  (∑ i : Fin n, (errorCount P x A i : ℝ)) / ((n : ℝ) * T)

noncomputable def IsErasure {n m T : ℕ} (P : Protocol n m T) (x : Input n m)
    (A : Adversary n T) : Prop :=
  ∀ t i, A t i = none ∨ A t i = cas (actions P x A t)

/-- Full-vector recovery at every locally eligible receiver, with inclusive budgets. -/
noncomputable def Resilient {n m T : ℕ} (P : Protocol n m T) (δ : ℝ)
    (erasuresOnly : Bool := false) : Prop :=
  0 ≤ δ ∧ δ ≤ 1 ∧ ∀ (x : Input n m) (A : Adversary n T),
    (erasuresOnly = true → IsErasure P x A) → averageError P x A ≤ δ →
    ∀ i, localError P x A i ≤ 10 * δ →
      P.output i (x i) (fun t => A t i) = x

noncomputable def rate (n m T : ℕ) : ℝ := (n : ℝ) * m / T

/-- The all-size rate bound, retaining the proof's logarithmic loss. -/
noncomputable def Achievability : Prop :=
  ∀ η : ℝ, 0 < η → ∃ c K : ℝ, 0 < c ∧ c ≤ 1 ∧ 0 < K ∧
    ∀ n m : ℕ, 1 ≤ n → 1 ≤ m → ∃ T : ℕ, 1 ≤ T ∧
      ∃ P : Protocol n m T, Resilient P (c / Real.sqrt n) ∧
        (T : ℝ) ≤ K * m * (n : ℝ) ^ ((3 : ℝ) / 2 + η) * Real.log (2 * n)

/-- Every duration, protocol and budget, even when only erasures are allowed. -/
noncomputable def Converse : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ n m T : ℕ, 1 ≤ n → 1 ≤ m → 1 ≤ T →
    ∀ (P : Protocol n m T) (δ : ℝ), Resilient P δ true → δ ≤ C / Real.sqrt n

end MultiPartyError1146.Adaptive


