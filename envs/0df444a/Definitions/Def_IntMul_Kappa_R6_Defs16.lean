section
-- Source module: Solutions.R6MCpy
/-!
# Round-six machine: copying a stored descriptor

The setup leaves the descriptors of the interface calls on `zPh`, `zLn`, `zCh` (`BaseOK6`). Before
a call, `cpyD Z X k c` copies the `k d + c` integers on top of `Z` onto the builder stack `X`
and leaves `Z` as it was (`d` from `zDd`; scratch `40`, counter `41`):
`mvK Z 40 41 n` moves them to `40` reversed, then a counted loop pushes each one back on `Z` and
on `X`.

* **`cpyD_sp`**: the specification on managed states.
* **`cpyD_run`**: the form `callW_I` uses: from any state with the descriptor on top of `Z`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL RS

noncomputable section

/-- The scratch stack of the copy. -/
abbrev yC : Fin HS := 40
/-- The counter of the copy. -/
abbrev cC : Fin HS := 41

/-- `k` copies of `zDd` plus `c`. -/
def lenE : ℕ → ℕ → Ex HS
  | 0, c => .lit c
  | k + 1, c => .add (.reg zDd) (lenE k c)

/-- One step of the copy loop. -/
def cpyB (Z X : Fin HS) : RS := .seq (.push X (.reg yC)) (.seq (.push Z (.reg yC)) (.pop yC))

/-- **The copy.** -/
def cpyD (Z X : Fin HS) (k c : ℕ) : RS := .seq (mvK Z yC cC (lenE k c)) (.rep cC (lenE k c) (cpyB Z X))

/-- The states of the loop. -/
def cpyF (f : Fin HS → List ℤ) (Z X : Fin HS) (rv : List ℤ) (k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update f yC (rv.drop k)) X (rv.take k).reverse) Z
    (rv.take k).reverse

end

end IntMul.Kappa.R6

end

section
-- Source module: Solutions.R6MPh
/-!
# Round-six machine: the interface calls

The frozen `KFMBig2` / `KFMBig3` at the round-six parameters. Every interface call is
`callW (cpyD Z X k c) X Y dS e`: the builder copies the stored descriptor (`zLn`, `zCh`, `zPh`,
length `k d + c`) onto the builder stack `X = bX dS`. The interfaces run in their own tables
`kTableP tab ext` and are relabelled into the merged table (`callW_I`).

* `lineG6`, `chirpG6`, `phiG6`: the per-size guarantees (bodies of `LineNeed6`, the chirp, and
  `CrtNeed6`).
* **`lineA_phase6`**, **`lineB_phase6`**, **`chirp_phase6`**, **`phi_phase6`**.
* **`phiF_rep6`**: the digits after `Φ` (frozen `phiF_rep`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open AModel AModelL12 IntMul NLogN NLogN.KIL KFB KFT RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM

noncomputable section

/-! ## The builder of a call -/

/-- The cost bound of `cpyD` for a descriptor of length `len` with entries of `B` bits. -/
def kCpy (k len B : ℕ) : ℕ := 2 * (2 * k + 2) * 2000 * (B + 2) + len * (40000 * (B + 2) + 30) + 64

/-! ## The guarantees per size -/

section Guar

variable {E : ℕ}

/-- **The line maps for one size** (body of `LineBody6` after the axis maps). -/
def lineG6 (Isym : List Sym) (tbl : Fin (7 + E) → IStmt HS (7 + E)) (eA eB : Fin (7 + E))
    (dS : Fin HS) (C₀ : ℝ) (A : ℕ) (Q : Q6) (D : ℕ) [∀ i, NeZero (Q.sB D i)]
    [∀ i, NeZero (Q.tB D i)] (M : AxisMaps6 Q.α (Q.sB D) (Q.tB D)) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = Q.dLn →
    (∀ (zs : List GI) (u : ((i : Fin (D + 1)) → ZMod (Q.sB D i)) → ℂ),
      f 0 = gflat zs ++ l → RepPad Q.p (Q.sB D) (Q.tB D) zs u → ‖u‖ ≤ 1 / 2 →
      ∃ (zs' : List GI) (w : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ) (c : ℕ),
        IRuns Isym tbl (.call eA) (encK s f) (encK s (Function.update f 0 (gflat zs' ++ l))) c ∧
        RepFull Q.p (Q.tB D) zs' w ∧ GB (Q.p + 2) zs' ∧
        ‖w - tensCLM (kerA M.A) u‖ ≤ Q.er * hp Q.p ∧
        (c : ℝ) ≤ C₀ * cU6 Q.P Q.n A) ∧
    (∀ (ys : List GI) (y : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ),
      f 0 = gflat ys ++ l → RepFull Q.p (Q.tB D) ys y → ‖y‖ ≤ 1 →
      ∃ (ys' : List GI) (v : ((i : Fin (D + 1)) → ZMod (Q.sB D i)) → ℂ) (c : ℕ),
        IRuns Isym tbl (.call eB) (encK s f) (encK s (Function.update f 0 (gflat ys' ++ l))) c ∧
        RepPad Q.p (Q.sB D) (Q.tB D) ys' v ∧ GB (Q.p + 2) ys' ∧
        ‖v - tensCLM (kerB M.B) y‖ ≤ Q.er * hp Q.p ∧
        (c : ℝ) ≤ C₀ * cU6 Q.P Q.n A)

/-- **The chirp for one size** (as the frozen `chirpGN`, error `Q.er`). -/
def chirpG6 (Isym : List Sym) (tbl : Fin (7 + E) → IStmt HS (7 + E)) (eC : Fin (7 + E))
    (dS : Fin HS) (C₀ : ℝ) (A : ℕ) (Q : Q6) (D : ℕ) [∀ i, NeZero (Q.tB D i)]
    (θt θit at' bt : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = Q.dCh →
    ∀ (xs : List GI) (x : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ),
      f 0 = gflat xs ++ l → RepFull Q.p (Q.tB D) xs x → ‖x‖ ≤ 6 / 10 →
      ∃ (Mrt : (((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ) →
          (((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ) →
          (((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ)),
        (∀ f g, Grid Q.p f → Grid Q.p g → ‖f‖ ≤ 1 → ‖g‖ ≤ 1 →
          ‖Mrt f g - mrX (Q.tB D) f g‖ ≤ Q.er * hp Q.p) ∧
      ∃ (ys : List GI) (c : ℕ),
        IRuns Isym tbl (.call eC) (encK s f) (encK s (Function.update f 0 (gflat ys ++ l))) c ∧
        RepFull Q.p (Q.tB D) ys (chirpT Q.p (mcT Q.p Mrt θt θit) bt at' x) ∧
        GB (Q.p + 2) ys ∧
        (c : ℝ) ≤ C₀ * cU6 Q.P Q.n A

/-- **`Φ` for one size** (body of `CrtBody6`). -/
def phiG6 (Isym : List Sym) (tbl : Fin (7 + E) → IStmt HS (7 + E)) (eF eB : Fin (7 + E))
    (dS : Fin HS) (C₀ : ℝ) (A : ℕ) (Q : Q6) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = Q.dPh →
    (∀ xs : List ℤ, f 0 = xs ++ l →
      xs.length = vol (KFU.shK Q.d (KFU.sP Q.d Q.src)) → Bnd (Q.p + 2) xs →
      ∃ c : ℕ, IRuns Isym tbl (.call eF) (encK s f)
          (encK s (Function.update f 0 (KFU.PhiD Q.h Q.d Q.bL Q.src Q.mu xs ++ l))) c ∧
        (c : ℝ) ≤ C₀ * cU6 Q.P Q.n A) ∧
    (∀ ys : List ℤ, f 0 = ys ++ l →
      ys.length = vol (KFU.shR Q.d (KFU.tP Q.d Q.h Q.bL)) → Bnd (Q.p + 2) ys →
      ∃ c : ℕ, IRuns Isym tbl (.call eB) (encK s f)
          (encK s (Function.update f 0 (KFU.PhiInvD Q.h Q.d Q.bL Q.src Q.mu ys ++ l))) c ∧
        (c : ℝ) ≤ C₀ * cU6 Q.P Q.n A)

end Guar

/-! ## The phases -/

/-- The cost bound of a call with a copied descriptor of `k d + c` entries of `Bd` bits. -/
def kCall6 (Q : Q6) (k c Bd : ℕ) (C₀ : ℝ) (A : ℕ) : ℝ :=
  1 + (kCpy k (k * Q.d + c) (Bd + Q.b) : ℝ) + 3 * (k * Q.d + c) * KFM.cMv Bd + 101 +
    C₀ * cU6 Q.P Q.n A

/-! ## The digits after `Φ` -/

end

end IntMul.Kappa.R6

