-- Source module: Solutions.R6IL3Top7
/-!
# Round six, item language (I3): the layer body of the uniform Proposition 14

On a core assignment (`CoreR` at `k = 0`, `G` on `vG`), `bodyCH c jK jL` pushes

* `14 qB = min(D - q₀, ⌈⌊D/m⌋ G / K⌉)` (two natural frames `bF1`, `bF2`),
* `15 Gs D''` (`D'' = D - q₀ - qB`; frame `bF3`),
* `13 E = q₀ + (qB + Gs D'') + (⌊D/2⌋ + D mod 2)` (frame `bF4`),

then runs `S_D ; C ; S_D ; b^D ; Q_p` (the frozen `sdC`, `mdC`, `truncU`, and the round-six
`C`-layer `clCH`).  **`bodyCoreQ`**: the output is `prop14Proc … (tens Cm)` with the frozen
guarantees; **`bodyQH`**: the run of `bodyCH` as a `RunQ`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul AModel NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

section Body

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

set_option maxHeartbeats 4000000 in
/-- **The body proper** (the frozen `bodyQ` with the round-six `C`-layer). -/
theorem bodyCoreQ_sol_aux {c : Cfg} (hc : CfgOK c) (jK jL : Fin Pp) (rowC : IStmt HS Pp)
    (hK : tbl jK = kerLoopC jK jL) (hL : tbl jL = levCH c jL rowC)
    {K S r H P D ρ q0 Bp qB Zl Z Zr G Mb Bz : ℕ} {CB : ℕ → ℝ}
    (L1 : LvH c Isym tbl jL rowC K r Zl Zr H G CB 1) (hρ : ρ < K) (hS : 1 ≤ S) (hP : 1 ≤ P)
    (hr : 1 ≤ r) (hD : 1 ≤ D) (hqq : q0 + qB ≤ D)
    (hZl : zsz ((32 * c.Wr * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Zl)
    (hZ32 : zsz ((32 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z) (hHZ : zsz (H : ℤ) ≤ Z)
    (hV1 : zsz ((VbH c K (K * D) S r H 1 (ρ + K * (D - 1)) P : ℕ) : ℤ) ≤ Zr) (hH1 : 1 ≤ H)
    (hMb : zsz (Mb : ℤ) ≤ Bz) (hM : K * D + P + D + S + 10 ≤ Mb)
    (pre : q0 + qB < D → MidPre c Isym tbl jL rowC CB K S r H P D ρ q0 Bp qB Zl Z Zr G)
    (hEZ : zsz ((Etot c D q0 qB : ℕ) : ℤ) ≤ Z)
    {σ : Fin HS → Option ℤ} (hC : CoreR σ K S r H P D ρ 0 q0 Bp) (hG : σ vG = some (G : ℤ))
    (h14 : σ 14 = some (qB : ℤ)) (h15 : σ 15 = some ((c.G (D - q0 - qB) : ℕ) : ℤ))
    (h13 : σ 13 = some ((Etot c D q0 qB : ℕ) : ℤ))
    (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ)) (p w : ℕ)
    (hC0 : Clean0 f) (h0 : f 0 = gflat zs ++ l) (hx : RecRep r p zs xs)
    (hl : xs.length = vol (Butterfly.layerShape P K D S)) (hb : GB w zs)
    (hH : w + (dwCL c D q0 qB + 2) ≤ H)
    (hdisk : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    ∃ zs', RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
        (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs) ∧
      RunQ Isym tbl σ (bodyCore jK jL) f (Function.update f 0 (gflat zs' ++ l))
        (cBodyC c CB K S r H P D q0 qB Bp Z Zr Bz w) := by
  have hK1 : 1 ≤ K := by omega
  have hσ0 : σ 0 = none := hC.base.off 0 (by (try dsimp only); decide)
  have hsl : SLaws (fun x : Fin D => KFH.stT K D S ρ x) (P * 2 ^ (K * D) * S) := by
    have := slaws_layer (P := P) (D := D) (S := S) hρ
    rwa [← pow_mul] at this
  set E := Etot c D q0 qB with hEdef
  set N := P * 2 ^ (K * D) * S * r with hN
  have hZ16 : zsz ((16 * N : ℕ) : ℤ) ≤ Z := le_trans (zsz_natCast_le (by omega)) hZ32
  have S1 := sdQ (Isym := Isym) (tbl := tbl) 0 H hC hρ hS hP hr hD hZ16
  have CL := clQH hc jK jL rowC hK hL L1 hρ hS hP hr hqq hZl hZ32 hHZ hV1 hH1 hMb (by omega) pre hC
    hG h14 h15
  have MDq := mdQ (Isym := Isym) (tbl := tbl) 0 H hC hρ hS hP hr hD hZ16 hMb (by omega)
  have L := ((S1.comp hsl CL).comp hsl S1).comp hsl MDq
  have hlv : xs.length = P * 2 ^ (K * D) * S := by rw [hl, KFM.vol_layer_eq]
  obtain ⟨zs1, r1, b1, R1⟩ := runQ_of_sImplQ L f zs l xs p w hC0 h0 hx hlv hb (Nat.zero_le _)
    (by simp only [dwCL] at hH ⊢; omega)
  rw [← KFM.vol_layer_eq, ← selOp_eq_selOpF (strideSel_layer hρ)] at r1
  have hTm : Butterfly.tensF (Butterfly.kerAt (⟨0, hD⟩ : Fin D) (Butterfly.cb ^ D • (1 : Butterfly.M2))) *
      (SD * (Butterfly.tens Butterfly.Cm * SD)) =
      (Butterfly.tens Butterfly.H0 : Butterfly.Op (Fin D)) := by
    rw [tensF_kerAt_smul_one, Butterfly.tens_H0, Fintype.card_fin, smul_mul_assoc,
      one_mul, mul_assoc]
  rw [hTm] at r1
  have r1' : RecRep r (p + E) zs1 (Butterfly.layerH P K D S ρ hρ xs) := by
    have e : p + (0 + (q0 + (qB + c.G (D - q0 - qB))) + 0 + (D / 2 + D % 2)) = p + E := by
      rw [hEdef, Etot]; ring
    rw [e] at r1; exact r1
  have hz1 : zs1.length = N := by
    rw [r1'.1, Butterfly.layerH, Butterfly.butterflyLayer, Butterfly.length_selOp, KFM.vol_layer_eq]
  -- the truncation frame
  have hEN : zsz (E : ℤ) ≤ Z := hEZ
  have ePow : ExC σ (.pow2 (.reg 13)) (2 ^ ((E : ℤ).toNat))
      ((Ex.reg 13 : Ex HS).size * 10 ^ 7 * (Z + 2) ^ 2 + 2 * moveCost Z + pow2Cost (E : ℤ).toNat +
        2 * Z + 100) :=
    ExC.pow2 (ExV.reg h13 hEN) (by positivity)
  rw [Int.toNat_natCast] at ePow
  have eLv := eL_exv hC hS hP hr hD hK1 hZ16
  have eLv' : ExV (Function.update σ 17 (some ((2 : ℤ) ^ E))) eL ((2 * N : ℕ) : ℤ) Z :=
    eLv.of_regs (fun j hj => by
      rw [Function.update_of_ne]
      rintro rfl; revert hj; decide)
  have hz17 : zsz ((2 : ℤ) ^ E) ≤ E + Z + 1 := by rw [NLogN.zsz_two_pow]; omega
  have hz18 : zsz (((2 * N : ℕ) : ℤ)) ≤ E + Z + 1 := by
    have := le_trans (zsz_natCast_le (show 2 * N ≤ 16 * N by omega)) hZ16
    omega
  have hP2 : PushSeq σ trEH [(17, (2 : ℤ) ^ E), (18, ((2 * N : ℕ) : ℤ))] (cTrP E Z) := by
    have p18 := pushSeq_consC (σ := Function.update σ 17 (some ((2 : ℤ) ^ E))) (i := 18) (l := [])
      (vl := []) (by (try dsimp only); decide) (clean_of_lt (by (try dsimp only); decide)) eLv'.cost hz18
      (pushSeq_nil _)
    have p17 := pushSeq_consC (σ := σ) (i := 17) (by (try dsimp only); decide)
      (clean_of_lt (by (try dsimp only); decide)) ePow hz17 p18
    refine p17.mono (le_of_eq ?_)
    simp only [cTrP, Ex.size]
  set vl : List (Fin HS × ℤ) := [(17, (2 : ℤ) ^ E), (18, ((2 * N : ℕ) : ℤ))] with hvl
  set σ' := σPush σ vl with hσ'
  have hb' : BaseR σ' := hC.base.push vl (by
    intro p hp
    simp only [hvl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl <;> ((try dsimp only); decide))
  have hnd : (vl.map Prod.fst).Nodup := by simp only [hvl, List.map_cons, List.map_nil]; decide
  have h17 : σ' 17 = some ((2 : ℤ) ^ E) := σPush_mem _ σ _ _ hnd (by simp [hvl])
  have h18 : σ' 18 = some ((2 * zs1.length : ℕ) : ℤ) := by
    rw [hz1]; exact σPush_mem _ σ _ _ hnd (by simp [hvl])
  set f1 := Function.update f 0 (gflat zs1 ++ l) with hf1
  have hC1 : Clean0 f1 := hC0.upd0 _
  obtain ⟨rT, bT, RT⟩ := runQ_truncU (I := Isym) (iprog := tbl) hb'.lt hb'.off h17 f1 zs1
    (Butterfly.layerH P K D S ρ hρ xs) l h18 r1' (by simp [hf1]) hC1 b1 Z
    (by rw [hz1]; exact le_trans (zsz_natCast_le (by omega)) hZ16)
  have RF := runQ_push (I := Isym) (iprog := tbl) trEH vl (cTrP E Z) (E + Z + 1) hP2
    (fun j hj => by
      have : j ≠ 0 := by rintro rfl; simp [hσ0] at hj
      rw [hf1, Function.update_of_ne this]; exact hC0 j this)
    (fun p hp => by
      simp only [hvl, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl
      · exact ⟨by rw [hf1, Function.update_of_ne (by (try dsimp only); decide)]
                  exact hC0 _ (by (try dsimp only); decide),
          by rw [Function.update_of_ne (by (try dsimp only); decide), hf1,
                Function.update_of_ne (by (try dsimp only); decide)]
             exact hC0 _ (by (try dsimp only); decide)⟩
      · exact ⟨by rw [hf1, Function.update_of_ne (by (try dsimp only); decide)]
                  exact hC0 _ (by (try dsimp only); decide),
          by rw [Function.update_of_ne (by (try dsimp only); decide), hf1,
                Function.update_of_ne (by (try dsimp only); decide)]
             exact hC0 _ (by (try dsimp only); decide)⟩)
    (fun p hp => by
      simp only [hvl, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl
      · exact hz17
      · exact hz18)
    RT
  -- the output
  obtain ⟨hout, hdisk', herr⟩ := Butterfly.prop14_output (P := P) (S := S) hρ p
    (Butterfly.tens Butterfly.Cm) rfl xs hdisk
  rw [← hout] at rT
  refine ⟨_, rT, ?_⟩
  have F := R1.seq RF
  rw [hf1, Function.update_idem] at F
  refine F.mono (le_of_eq ?_)
  simp only [cBodyC, dwCL, hvl, List.length_cons, List.length_nil, Nat.zero_add, Nat.add_zero, hz1]
  ring

end Body

