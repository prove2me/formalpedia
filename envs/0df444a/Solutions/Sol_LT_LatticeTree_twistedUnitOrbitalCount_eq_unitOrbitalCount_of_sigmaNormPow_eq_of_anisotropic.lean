  · exfalso
    have hb' : b - b' ≠ 0 := sub_ne_zero.mpr hb
    have g01 : G 0 1 = 0 := (mul_eq_zero.mp (show (b - b') * G 0 1 = 0 by linear_combination e01)).resolve_left hb'
    have g10 : G 1 0 = 0 := (mul_eq_zero.mp (show (b - b') * G 1 0 = 0 by linear_combination e10)).resolve_left hb'
    have g11 : G 1 1 = G 0 0 := mul_left_cancel₀ hb' (by linear_combination e11 - e00)
    apply hG (G 0 0)
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp only [Matrix.smul_apply, smul_eq_mul, Fin.zero_eta, Fin.mk_one, Fin.isValue, Matrix.one_apply_eq,
        Matrix.one_apply_ne (by decide : (0 : Fin 2) ≠ 1), Matrix.one_apply_ne (by decide : (1 : Fin 2) ≠ 0), mul_one, mul_zero]
    · exact g01
    · exact g10
    · exact g11

