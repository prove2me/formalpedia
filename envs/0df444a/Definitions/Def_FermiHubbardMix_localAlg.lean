-- title:
--   Local fermionic algebra $\mathfrak A_S$ and the single-site matrix units $P^i_{\mu\nu}$
-- statement:
--   Let $\Lambda$ be a finite set of sites, each carrying $m$ complex fermionic modes, and fix an ordering of the modes of $\Lambda\times[m]$, i.e. a bijection $\Lambda\times[m]\to\{0,\dots,N-1\}$; write $c_{i,a}$ for the annihilation operator of mode $a$ at site $i$.
--
--   **Definition 11.1.** For $S\subseteq\Lambda$, the **local fermionic algebra** $\mathfrak A_S$ is the unital algebra generated by $c_{i,a},c_{i,a}^\dagger$ ($i\in S$, $a\in[m]$): the finite linear combinations of products of these generators and the identity. An operator is *supported in* $S$ if it lies in $\mathfrak A_S$.
--
--   **Definition 11.2 (single site).** For a site $i$ and local configurations $\mu,\nu\in F_i=\{0,1\}^{[m]}$, the **matrix unit** $P^i_{\mu\nu}\in\mathfrak A_{\{i\}}$ is the fermionic operator that maps the configuration $\nu$ of site $i$ to $\mu$. Explicitly
--   $$
--   P^i_{\mu\nu}=c^\dagger_\mu\,\Pi^{\{i\}}_0\,\bigl(c^\dagger_\nu\bigr)^\dagger,\qquad \Pi^{\{i\}}_0=\prod_{a\in[m]}(1-n_{i,a}),
--   $$
--   where $c^\dagger_\mu$ is the product of the creation operators $c_{i,a}^\dagger$ of the modes occupied in $\mu$, taken in increasing global order. These satisfy $P^i_{\mu\nu}P^i_{\mu'\nu'}=\delta_{\nu\mu'}P^i_{\mu\nu'}$, $(P^i_{\mu\nu})^\dagger=P^i_{\nu\mu}$ and $\sum_\mu P^i_{\mu\mu}=I$.
--
--   The local algebras define fermionic locality; the matrix units are the jump operators of the field-resonant Lindbladian.
--
--   **Formalization Note** The generating set is closed under adjoints and finite dimensional, so the generated algebra is the C*-algebra of the paper. The explicit $P^i_{\mu\nu}$ agree with the paper's $\iota_{\{i\}}(|\mu\rangle\langle\nu|)$ up to signs $s_\mu s_\nu\in\{\pm1\}$; the diagonal units are identical, and every Lindbladian of the paper is quadratic in each jump, so nothing depends on these signs.
-- source:
--   Bakshi, Moitra, Tan, Algorithmic Aspects of the Fermi–Hubbard Model, arXiv:2604.08408 (held version, sha256 055b8f8f…), Definition 11.1, p.50; Definition 11.2, p.51

import Mathlib
import Definitions.Def_FermiHubbardMix_parityOp
open scoped BigOperators
open Matrix
noncomputable section

namespace FermiHubbardMix

/-- The generators `c_{i,a}, c_{i,a}†` (`i ∈ S`, `a ∈ [m]`) of the local fermionic algebra of a set
of sites `S`, for a mode ordering `ord : Λ × Fin m ≃ Fin N` (arXiv:2604.08408, held version sha256
055b8f8f…, §11.1 and Definition 11.1, p.50). -/
def localGens {Λ : Type*} {m N : ℕ} (ord : Λ × Fin m ≃ Fin N) (S : Set Λ) : Set (Op N) :=
  {A | ∃ i ∈ S, ∃ a : Fin m,
    A = GaussTesting.annihilator N (ord (i, a)) ∨ A = (GaussTesting.annihilator N (ord (i, a)))ᴴ}

/-- **Definition 11.1 (Local fermionic algebra)** (arXiv:2604.08408, held version sha256
055b8f8f…, p.50). For `S ⊆ Λ`, `𝔄_S` is the unital algebra generated by `c_{i,a}, c_{i,a}†`
(`i ∈ S`, `a ∈ [m]`): the finite linear combinations of products of these generators and the
identity. `A` is supported in `S` iff `A ∈ localAlg ord S`.

**Formalization Note** The generating set is closed under `†`, so the generated algebra is a
`*`-subalgebra; it is finite dimensional and hence norm closed, so it is the C*-algebra of the
paper. The mode ordering is the bijection `ord : Λ × Fin m ≃ Fin N` (mode `a` of site `i` is the
`ord (i, a)`-th mode of the Jordan–Wigner chain). -/
def localAlg {Λ : Type*} {m N : ℕ} (ord : Λ × Fin m ≃ Fin N) (S : Set Λ) : Subalgebra ℂ (Op N) :=
  Algebra.adjoin ℂ (localGens ord S)

/-- A local occupation configuration `μ ∈ F_{{i}} = {0,1}^{[m]}` of one site
(arXiv:2604.08408, held version sha256 055b8f8f…, Definition 11.2, p.51). -/
abbrev LocCfg (m : ℕ) := Fin m → Fin 2

/-- `c†_μ`: the product of the creation operators `c_{i,a}†` of the modes `a` occupied in `μ`, taken in
increasing global mode order (arXiv:2604.08408, held version sha256 055b8f8f…, Definition 11.2,
p.51; see the Formalization Note of `matUnit`). -/
def createWord {Λ : Type*} [DecidableEq Λ] {m N : ℕ} (ord : Λ × Fin m ≃ Fin N) (i : Λ)
    (μ : LocCfg m) : Op N :=
  ((List.finRange N).map fun k =>
    if (ord.symm k).1 = i ∧ μ (ord.symm k).2 = 1 then (GaussTesting.annihilator N k)ᴴ else 1).prod

/-- `Π^{{i}}_0 = ∏_{a} (1 - n_{i,a})`, the projection onto "site `i` empty"
(arXiv:2604.08408, held version sha256 055b8f8f…, Definition 11.2, p.51). -/
def vacProj {Λ : Type*} {m N : ℕ} (ord : Λ × Fin m ≃ Fin N) (i : Λ) : Op N :=
  ((List.finRange m).map fun a => 1 - numOp N (ord (i, a))).prod

/-- **Definition 11.2 (Local occupation matrix units)**, single-site case `S = {i}`
(arXiv:2604.08408, held version sha256 055b8f8f…, p.51): `P^i_{μν}`, the fermionic operator that maps
the configuration `ν` of site `i` to `μ`, i.e. `ι_{{i}}(|μ⟩⟨ν|)`.

**Formalization Note** It is written explicitly as `P^i_{μν} = c†_μ Π^{{i}}_0 (c†_ν)†`, where
`c†_μ` is the product of the creators of the occupied modes of `μ` in increasing global order and
`Π^{{i}}_0` projects onto "site `i` empty". These operators satisfy the three identities of
Definition 11.2 (`P_{μν}P_{μ'ν'} = δ_{νμ'}P_{μν'}`, `P_{μν}† = P_{νμ}`, `∑_μ P_{μμ} = I`) and lie in
`𝔄_{{i}}`; they agree with the paper's `ι_{{i}}(|μ⟩⟨ν|)` up to signs `s_μ s_ν ∈ {±1}` (a re-signed
local basis). The diagonal units `P^i_{μμ}` coincide with the paper's, and every Lindbladian of the
paper is quadratic in each jump `P^i_{μν}`, so it does not depend on these signs. -/
def matUnit {Λ : Type*} [DecidableEq Λ] {m N : ℕ} (ord : Λ × Fin m ≃ Fin N) (i : Λ)
    (μ ν : LocCfg m) : Op N :=
  createWord ord i μ * vacProj ord i * (createWord ord i ν)ᴴ

end FermiHubbardMix


