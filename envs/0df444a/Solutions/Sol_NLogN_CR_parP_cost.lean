      have key : (if (c : ℤ) + -1 + -(dh : ℤ) < 0 then max ((m1 : ℤ) + -((c : ℤ) + -1)) 0
          else max ((m2 : ℤ) + -((c : ℤ) + -1 + -(dh : ℤ))) 0) =
          ((if c - 1 < dh then m1 - (c - 1) else m2 - (c - 1 - dh) : ℕ) : ℤ) := by
        split_ifs <;> omega
      rw [key, hsv]; push_cast; ring)
  set w1 := NLogN.CR.pushV w pTS sv with hw1
  have h2 := push_sp w1 rRec (by decide) (.mul (.reg pTS) (.reg NLogN.CR.rS)) (clean_of_regs (by simp only [Ex.regs, List.append_nil, List.nil_append, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false, false_or]; decide))
    (by simp +decide [hw1, Ex.ok, isInt_of' hS]) ((sv * W : ℕ) : ℤ)
    (by simp +decide [hw1, Ex.eval, top_of hS])
  set w2 := NLogN.CR.pushV w1 rRec ((sv * W : ℕ) : ℤ) with hw2
  have h3 := push_sp w2 rRec (by decide) (.reg NLogN.CR.rS) (clean_of_regs (by simp only [Ex.regs, List.append_nil, List.nil_append, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false, false_or]; decide))
    (by simp +decide [hw2, hw1, Ex.ok, isInt_of' hS]) (W : ℤ)
    (by simp +decide [hw2, hw1, Ex.eval, top_of hS])
  set w3 := NLogN.CR.pushV w2 rRec (W : ℤ) with hw3
  have h4 := push_sp w3 rRec (by decide) (.reg pTS) (clean_of_regs (by simp only [Ex.regs, List.append_nil, List.nil_append, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false, false_or]; decide))
    (by simp +decide [hw3, hw2, hw1, Ex.ok]) (sv : ℤ)
    (by simp +decide [hw3, hw2, hw1, Ex.eval])
  set w4 := NLogN.CR.pushV w3 rRec (sv : ℤ) with hw4
  have h5' := push_sp w4 rRec (by decide) (.lit 0) (clean_of_regs (by simp only [Ex.regs, List.append_nil, List.nil_append, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false, false_or]; decide)) trivial 0 rfl
  set w5 := NLogN.CR.pushV w4 rRec 0 with hw5
  have h6' := asg_sp w5 NLogN.CR.rS (by decide) (.mul (.reg pTS) (.reg NLogN.CR.rS)) (clean_of_regs (by simp only [Ex.regs, List.append_nil, List.nil_append, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false, false_or]; decide))
    (by simp +decide [hw5, hw4, hw3, hw2, hw1, Ex.ok, isInt_of' hS]) ((sv * W : ℕ) : ℤ)
    (by simp +decide [hw5, hw4, hw3, hw2, hw1, Ex.eval, top_of hS]) W LS
    (by simp +decide [hw5, hw4, hw3, hw2, hw1, hS])
  set w6 := w5.upd NLogN.CR.rS (.int ((sv * W : ℕ) : ℤ) :: LS) with hw6
  have h7 := pop_sp w6 pTS (by decide) sv (w.G pTS) (by simp +decide [hw6, hw5, hw4, hw3, hw2, hw1])
  have z : ∀ v : ℕ, v ≤ M → zsz (v : ℤ) ≤ B := fun v hv => natCast_lt_pow (lt_of_le_of_lt hv hM)
  have c1 := push_cost w pTS NLogN.CR.sE B (sE_bnd w c dh Q m1 m2 hc LQ LN LT L5 L6 hq hn hT h5 h6 sv hsv M B hM
    (by omega))
  have c2 := push_cost w1 rRec (.mul (.reg pTS) (.reg NLogN.CR.rS)) B (by
    simp +decide [hw1, Ex.Bnd, Ex.eval, top_of hS]
    refine ⟨z _ (by omega), z _ (by omega), by exact_mod_cast z (sv * W) (by omega)⟩)
  have c3 := push_cost w2 rRec (.reg NLogN.CR.rS) B (by
    simp +decide [hw2, hw1, Ex.Bnd, top_of hS]; exact z _ (by omega))
  have c4 := push_cost w3 rRec (.reg pTS) B (by
    simp +decide [hw3, hw2, hw1, Ex.Bnd]; exact z _ (by omega))
  have c5 := push_cost w4 rRec (.lit 0) B (by simp [Ex.Bnd, zsz_zero])
  have c6 := asg_cost w5 NLogN.CR.rS (.mul (.reg pTS) (.reg NLogN.CR.rS)) B (by
    simp +decide [hw5, hw4, hw3, hw2, hw1, Ex.Bnd, Ex.eval, top_of hS]
    refine ⟨z _ (by omega), z _ (by omega), by exact_mod_cast z (sv * W) (by omega)⟩)
    (by simp +decide [hw5, hw4, hw3, hw2, hw1, top_of hS]; exact z _ (by omega))
  have g7 : w6.G pTS = .int (sv : ℕ) :: w.G pTS := by simp +decide [hw6, hw5, hw4, hw3, hw2, hw1]
  have c7 := pop_cost w6 pTS B (by rw [top_of g7]; exact z _ (by omega))
  unfold NLogN.CR.sBody
  simp only [seqL]
  refine le_trans (seq_cost h1.2 c1 (seq_cost h2.2 c2 (seq_cost h3.2 c3 (seq_cost h4.2 c4
    (seq_cost h5'.2 c5 (seq_cost h6'.2 c6 c7)))))) ?_
  simp only [Ex.size, NLogN.CR.sE, iEx, NLogN.CR.max0]
  have hX : 1 ≤ (B + 2) ^ 2 := Nat.one_le_pow _ _ (by omega)
  generalize (B + 2) ^ 2 = X at *
  omega

theorem copS_pos (K dh r : ℕ) : ∀ x ∈ copS K dh r, 0 < x := by
  intro x hx; simp [copS] at hx; obtain ⟨i, _, rfl⟩ := hx; omega

set_option maxHeartbeats 2000000 in
theorem stD_cost (K dh r : ℕ) (t : IState HS) (LN : List Item) (hn : t.G hNb = .int dh :: LN)
    (M B : ℕ) (hM : M < 2 ^ B)
    (hb : K + dh + m1V K r + m2V K r + copQ K r * m1V K r + copQ K r * m2V K r + copQ K r +
      3 * (copS K dh r).prod + 2 ≤ M) :
    (stD K).cost (NLogN.CR.pushV (NLogN.CR.pushV (NLogN.CR.pushV t pTQ (copQ K r)) pT5 (m1V K r)) pT6 (m2V K r)) ≤
      (K + 1) * (2 * 10 ^ 9) * (B + 2) ^ 2 := by
  have z : ∀ v : ℕ, v ≤ M → zsz (v : ℤ) ≤ B := fun v hv => natCast_lt_pow (lt_of_le_of_lt hv hM)
  set u := NLogN.CR.pushV (NLogN.CR.pushV (NLogN.CR.pushV t pTQ (copQ K r)) pT5 (m1V K r)) pT6 (m2V K r) with hu
  have un : u.G hNb = .int dh :: LN := by simp +decide [hu, hn]
  have uT : ∃ L, u.G pTQ = .int (copQ K r : ℕ) :: L := ⟨t.G pTQ, by simp +decide [hu]⟩
  have u5 : ∃ L, u.G pT5 = .int (m1V K r : ℕ) :: L := ⟨t.G pT5, by simp +decide [hu]⟩
  have u6 : ∃ L, u.G pT6 = .int (m2V K r : ℕ) :: L := ⟨t.G pT6, by simp +decide [hu]⟩
  have h1 := push_sp u NLogN.CR.rS (by decide) (.lit 1) (clean_of_regs (by simp only [Ex.regs, List.append_nil, List.nil_append, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false, false_or]; decide)) trivial 1 rfl
  have c1 := push_cost u NLogN.CR.rS (.lit 1) B (by simp only [Ex.Bnd]; exact_mod_cast z 1 (by omega))
  have H := sLoop_states K dh r u LN un uT u5 u6
  set sl := copS K dh r with hsl
  have hs := copS_pos K dh r
  have hl : sl.length = K := copS_length K dh r
  have c2 := RepStates.cost_le H B (10 ^ 9 * (B + 2) ^ 2) (by simp only [Ex.Bnd]; exact z K (by omega))
    (by simp only [Ex.eval]; exact z K (by omega)) (by
      intro k hk
      simp only [Ex.eval, Int.toNat_natCast] at hk ⊢
      obtain ⟨LT, hT⟩ := uT
      obtain ⟨L5, h5⟩ := u5
      obtain ⟨L6, h6⟩ := u6
      set w := withCtr hQ (NLogN.CR.pushV u NLogN.CR.rS 1) K k (NLogN.CR.dSt u sl K k) with hw
      have e1 := getD_le_prod sl hs (K - k - 1)
      have e2 := prod_drop_le sl hs (K - k)
      have e3 := sw_le sl hs (K - k - 1)
      have e4 : wgt sl (K - k - 1) = Wk sl K k := by
        simp only [wgt, Wk]; congr 2; omega
      rw [e4] at e3
      have e5 : Wk sl K k ≤ sl.prod := e2
      exact sBody_cost w (K - k) dh (copQ K r) (m1V K r) (m2V K r) (Wk sl K k) (by omega)
        (u.G hQ) LN LT L5 L6 (u.G NLogN.CR.rS) (ints (recsF sl K k) ++ u.G rRec)
        (by simp +decide [hw, withCtr]; omega) (by simp +decide [hw, withCtr, NLogN.CR.dSt, un])
        (by simp +decide [hw, withCtr, NLogN.CR.dSt, hT]) (by simp +decide [hw, withCtr, NLogN.CR.dSt, h5])
        (by simp +decide [hw, withCtr, NLogN.CR.dSt, h6]) (by simp +decide [hw, withCtr, NLogN.CR.dSt])
        (by simp +decide [hw, withCtr, NLogN.CR.dSt]) (sl.getD (K - k - 1) 1)
        (by rw [hsl, NLogN.CR.copS_getD _ _ _ _ (by omega)]) M B hM (by omega))
  simp only [Ex.eval, Int.toNat_natCast] at c2
  have h2 : (rep hQ (.lit K) NLogN.CR.sBody).run (NLogN.CR.pushV u NLogN.CR.rS 1) = NLogN.CR.dSt u sl K K := by
    rw [H.run]; simp [Ex.eval]
  set d := NLogN.CR.dSt u sl K K with hd
  have g3 : d.G pT6 = .int (m2V K r : ℕ) :: t.G pT6 := by simp +decide [hd, NLogN.CR.dSt, hu]
  have h3 := pop_sp d pT6 (by decide) _ _ g3
  have c3 := pop_cost d pT6 B (by rw [top_of g3]; exact z _ (by omega))
  set d1 := d.upd pT6 (t.G pT6) with hd1
  have g4 : d1.G pT5 = .int (m1V K r : ℕ) :: t.G pT5 := by simp +decide [hd1, hd, NLogN.CR.dSt, hu]
  have h4 := pop_sp d1 pT5 (by decide) _ _ g4
  have c4 := pop_cost d1 pT5 B (by rw [top_of g4]; exact z _ (by omega))
  set d2 := d1.upd pT5 (t.G pT5) with hd2
  have g5 : d2.G pTQ = .int (copQ K r : ℕ) :: t.G pTQ := by simp +decide [hd2, hd1, hd, NLogN.CR.dSt, hu]
  have c5 := pop_cost d2 pTQ B (by rw [top_of g5]; exact z _ (by omega))
  unfold stD
  simp only [seqL]
  refine le_trans (seq_cost h1.2 c1 (seq_cost h2 c2 (seq_cost h3.2 c3 (seq_cost h4.2 c4 c5)))) ?_
  simp only [Ex.size]
  have hX : 1 ≤ (B + 2) ^ 2 := Nat.one_le_pow _ _ (by omega)
  generalize (B + 2) ^ 2 = X at *
  nlinarith

end NLogN.CR

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.CR
open IntMul RS IntMul.HvdH IntMul.HvdH.Ref
theorem solution (K N nb : ℕ) (hK : 1 ≤ K) (hN : 1 ≤ N) (hnb : N < 2 ^ nb) (s : NLogN.IState NLogN.HS)
    (LN LNb : List NLogN.Item) (hsN : s.G NLogN.CR.rN = .int N :: LN) (hsNb : s.G NLogN.CR.rNb = .int nb :: LNb)
    (B : ℕ) (hB : NLogN.CR.parBnd K N nb < 2 ^ B) :
    (NLogN.CR.parP K).cost s ≤ (NLogN.CR.facN K + 2 * K + 5 * nb + 102) * 10 ^ 9 * (B + 2) ^ 2 := by
  have hA := NLogN.CR.stA_spec K N nb hK hN hnb s LN LNb hsN hsNb
  have cA := NLogN.CR.stA_cost K N nb hK hN hnb s LN LNb hsN hsNb B (lt_of_le_of_lt (by unfold NLogN.CR.parBnd; omega) hB : NLogN.CR.bndA K N nb < 2 ^ B)
  set a := NLogN.CR.outA s K N with ha
  have hB' := NLogN.CR.stB_spec K (mkParams K N).b (NLogN.CR.parEx K N) (mkParams K N).e a (s.G NLogN.CR.rB) (s.G NLogN.CR.rE) (s.G NLogN.CR.hRr)
    (by simp +decide [ha, NLogN.CR.outA]) (by simp +decide [ha, NLogN.CR.outA]) (by simp +decide [ha, NLogN.CR.outA])
  have hPq : NLogN.CR.PV K (mkParams K N).b (NLogN.CR.parEx K N) = (mkParams K N).P := rfl
  have cB := NLogN.CR.stB_cost K (mkParams K N).b (NLogN.CR.parEx K N) (mkParams K N).e a (s.G NLogN.CR.rB) (s.G NLogN.CR.rE) (s.G NLogN.CR.hRr)
    (by simp +decide [ha, NLogN.CR.outA]) (by simp +decide [ha, NLogN.CR.outA]) (by simp +decide [ha, NLogN.CR.outA]) hK B
    (by rw [hPq]; exact (lt_of_le_of_lt (by unfold NLogN.CR.parBnd; omega) hB : NLogN.CR.bndB K N < 2 ^ B))
  set b := NLogN.CR.pushV (NLogN.CR.pushV (NLogN.CR.pushV (NLogN.CR.pushV a NLogN.CR.rAl (NLogN.CR.alV K (mkParams K N).b)) NLogN.CR.hPp (NLogN.CR.pV K (mkParams K N).b
    (NLogN.CR.parEx K N))) NLogN.CR.rPP (NLogN.CR.PV K (mkParams K N).b (NLogN.CR.parEx K N))) NLogN.CR.rFn
    ((4 * 2 ^ (mkParams K N).e * NLogN.CR.PV K (mkParams K N).b (NLogN.CR.parEx K N) : ℕ) : ℤ) with hb
  have hC := NLogN.CR.stC_spec K (mkParams K N).e hK (NLogN.CR.par_e_pos K N hK hN) b (s.G NLogN.CR.hRr) (s.G NLogN.CR.hRh)
    (by simp +decide [hb, ha, NLogN.CR.outA]) (by simp +decide [hb, ha, NLogN.CR.outA])
  have cC := NLogN.CR.stC_cost K (mkParams K N).e hK (NLogN.CR.par_e_pos K N hK hN) b (s.G NLogN.CR.hRr) (s.G NLogN.CR.hRh)
    (by simp +decide [hb, ha, NLogN.CR.outA]) (by simp +decide [hb, ha, NLogN.CR.outA]) B
    (lt_of_le_of_lt (by unfold NLogN.CR.parBnd; omega) hB : NLogN.CR.bndC K N < 2 ^ B)
  have cD := NLogN.CR.stD_cost K (mkParams K N).dh (2 ^ (mkParams K N).e) b (s.G NLogN.CR.hNb)
    (by simp +decide [hb, ha, NLogN.CR.outA]) _ B hB (by
      have : NLogN.CR.bndD K N ≤ NLogN.CR.parBnd K N nb := by unfold NLogN.CR.parBnd; omega
      unfold NLogN.CR.bndD at this; omega)
  have hbn : (mkParams K N).b ≤ nb := Nat.size_le.2 hnb
  unfold NLogN.CR.parP
  simp only [NLogN.RS.seqL]
  refine le_trans (NLogN.CR.seq_cost hA.2 cA (NLogN.CR.seq_cost hB'.2 cB (NLogN.CR.seq_cost hC.2 cC cD))) ?_
  have hX : 1 ≤ (B + 2) ^ 2 := Nat.one_le_pow _ _ (by omega)
  generalize (B + 2) ^ 2 = X at *
  generalize (mkParams K N).b = bb at *
  nlinarith
end
