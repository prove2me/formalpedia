-- title:
--   Single-parameter exponential-family observations and regularity
-- statement:
--   Let $\Theta$ be a nonempty open interval containing the null $\theta_0$. The scalar exponential family has density $\exp(\theta x-\psi(\theta))$ relative to a reference measure, normalized for every $\theta\in\Theta$. The function $\psi$ is twice differentiable there, $\psi''>0$, and each law has finite fourth absolute moment. On a common measurable space, the real observations are measurable, independent, and identically distributed with that law under each probability measure $P_\theta$.
--
--   The history at sample count $n$ is exactly the sigma algebra of the first $n$ observations. The information is $I(\theta,\theta_0)=(\theta-\theta_0)\psi'(\theta)-(\psi(\theta)-\psi(\theta_0))$. Additional regularity for Theorem 2 means absolute continuity of $\psi''$ on the entire parameter interval: one delta works for every finite disjoint family of subintervals in the domain. The derivative is real and exists throughout the open domain, so it is finite on a neighborhood of $\theta_0$.
--
--   Formalization Note: The published exponential-family object is specialized to scale one and zero base log density. An arbitrary reference measure generalizes the source's Lebesgue-density formulation, recovered by taking reference measure $f_0(x)\,dx$. Coordinate zero denotes $X_1$.
-- source:
--   Johari, Pekelis and Walsh, Always Valid Inference: Continuous Monitoring of A/B Tests, arXiv:1512.04922v3 (2019), https://arxiv.org/abs/1512.04922v3, §3, p. 11; §5.2, p. 18; Theorem 2, p. 21 (PDF page = printed page).

import Mathlib
import Definitions.Def_ChenPrivatePricing_General_ExponentialFamily

open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal Topology BigOperators

namespace AlwaysValidInference.Efficiency

/-- Absolute continuity on the whole interval, with one delta for all finite
families of disjoint subintervals. This is not merely local absolute continuity. -/
def AbsolutelyContinuousOnDomain (f : ℝ → ℝ) (D : Set ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧
    ∀ (n : ℕ) (a b : Fin n → ℝ),
      (∀ i, a i ∈ D ∧ b i ∈ D ∧ a i ≤ b i) →
      (Pairwise fun i j => Disjoint (Ioo (a i) (b i)) (Ioo (a j) (b j))) →
      (∑ i, (b i - a i)) < δ → (∑ i, |f (b i) - f (a i)|) < ε

/-- The standing assumptions of Sections 3 and 5.2. Coordinates start at zero:
`X 0` is the paper's first observation. The reference measure may be arbitrary;
the source is recovered with reference measure `f₀ dx`. -/
structure Model (Ω : Type*) [MeasurableSpace Ω] where
  family : ChenPrivatePricing.General.ExponentialFamily
  unitScale : family.zeta = 1
  zeroBaseLog : family.baseLogDensity = fun _ => 0
  normalized : family.Normalized
  openDomain : IsOpen family.domain
  intervalDomain : family.domain.OrdConnected
  null : ℝ
  null_mem : null ∈ family.domain
  differentiable : ∀ θ ∈ family.domain, DifferentiableAt ℝ family.cumulant θ
  twiceDifferentiable : ∀ θ ∈ family.domain,
    DifferentiableAt ℝ (deriv family.cumulant) θ
  curvature_pos : ∀ θ ∈ family.domain, 0 < deriv (deriv family.cumulant) θ
  fourthMoment : ∀ θ ∈ family.domain,
    Integrable (fun x : ℝ => |x| ^ 4) (family.law θ)
  X : ℕ → Ω → ℝ
  measurable_X : ∀ n, Measurable (X n)
  law : ℝ → Measure Ω
  probability : ∀ θ ∈ family.domain, IsProbabilityMeasure (law θ)
  independent : ∀ θ ∈ family.domain, iIndepFun X (law θ)
  identical : ∀ θ ∈ family.domain, ∀ n, (law θ).map (X n) = family.law θ

/-- Exactly the sigma algebra generated by the first `n` observations. -/
def Model.history {Ω : Type*} [MeasurableSpace Ω] (E : Model Ω) (n : ℕ) :
    MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => fun i : Fin n => E.X i.val ω) inferInstance

/-- The additional regularity of Theorem 2. Finiteness of the second derivative
is encoded by its real codomain and actual differentiability throughout the open
domain, which already contains a neighborhood of the null. -/
def Model.Regular {Ω : Type*} [MeasurableSpace Ω] (E : Model Ω) : Prop :=
  AbsolutelyContinuousOnDomain (deriv (deriv E.family.cumulant)) E.family.domain

noncomputable def Model.information {Ω : Type*} [MeasurableSpace Ω]
    (E : Model Ω) (θ : ℝ) : ℝ :=
  (θ - E.null) * deriv E.family.cumulant θ -
    (E.family.cumulant θ - E.family.cumulant E.null)

end AlwaysValidInference.Efficiency


