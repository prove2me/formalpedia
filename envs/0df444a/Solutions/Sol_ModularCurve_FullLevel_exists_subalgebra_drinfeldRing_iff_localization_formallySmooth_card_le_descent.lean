      haveI : Algebra.FiniteType A₀ ↥B := (Subalgebra.fg_iff_finiteType B).mp hfg
      haveI : IsNoetherianRing ↥B := Algebra.FiniteType.isNoetherianRing A₀ ↥B
      haveI : IsFractionRing ↥B ↥F₀ := IsFractionRing.of_field ↥B ↥F₀ (fun z => by
        obtain ⟨b, c, hb, hc, hc0, hz⟩ := hfrac z
        exact ⟨⟨b, hb⟩, ⟨c, hc⟩, (eq_div_iff hc0).mpr hz⟩)
      haveI : IsIntegrallyClosed ↥B := (isIntegrallyClosed_iff ↥F₀).mpr (fun {x} hx => ⟨⟨x, hn x hx⟩, rfl⟩)
