open MeasureTheory
open scoped BigOperators
namespace SCAFFOLD

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

def meanControl (A : Run P ν S K T ηl ηg init) (r : ℕ) (ω : Ω) : Space d :=
  (N : ℝ)⁻¹ • ∑ i, A.c r i ω

def averageOracle (A : Run P ν S K T ηl ηg init) (r : ℕ) (i : Fin N)
    (ω : Ω) : Space d :=
  (K : ℝ)⁻¹ • ∑ k ∈ Finset.range K, A.g r k i ω

def direction (A : Run P ν S K T ηl ηg init) (r k : ℕ) (i : Fin N)
    (ω : Ω) : Space d :=
  A.g r k i ω - A.c r i ω + meanControl A r ω

theorem Run.local_path (A : Run P ν S K T ηl ηg init) {r : ℕ} (hr : r < T)
    {k : ℕ} (hk : k ≤ K) (i : Fin N) :
    A.y r k i =ᵐ[ν] fun ω ↦ A.x r ω -
      ηl • ∑ j ∈ Finset.range k, direction A r j i ω := by
  induction k with
  | zero => simpa using A.start r hr i
  | succ k ih =>
    filter_upwards [ih (Nat.le_of_succ_le hk),
      A.local_update r hr k (Nat.lt_of_succ_le hk) i] with ω hprev hnext
    rw [hnext, hprev, Finset.sum_range_succ]
    dsimp [direction, meanControl]
    simp only [smul_add]
    abel

theorem Run.local_endpoint (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (i : Fin N) :
    A.y r K i =ᵐ[ν] fun ω ↦ A.x r ω - ((K : ℝ) * ηl) •
      (averageOracle A r i ω - A.c r i ω + meanControl A r ω) := by
  have hK : (K : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.steps_pos
  filter_upwards [A.local_path hr le_rfl i] with ω hω
  rw [hω]
  congr 1
  simp only [direction, averageOracle, Finset.sum_add_distrib, Finset.sum_sub_distrib,
    Finset.sum_const, Finset.card_range, ← Nat.cast_smul_eq_nsmul ℝ]
  simp only [smul_add, smul_sub, smul_smul]
  have hcancel : (K : ℝ) * ηl * (K : ℝ)⁻¹ = ηl := by field_simp
  rw [hcancel]
  module

theorem Run.server_displacement (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) :
    A.x (r + 1) =ᵐ[ν] fun ω ↦ A.x r ω -
      (effectiveStep K ηl ηg / (S : ℝ)) • ∑ i ∈ A.sample r ω,
        (averageOracle A r i ω - A.c r i ω + meanControl A r ω) := by
  filter_upwards [A.server_update r hr,
    Filter.eventually_all.mpr (A.local_endpoint hr)] with ω hserver hend
  rw [hserver]
  simp_rw [hend, sub_sub_cancel_left]
  rw [Finset.sum_neg_distrib, ← Finset.smul_sum, smul_neg, smul_smul, sub_eq_add_neg]
  have hc : ηg / (S : ℝ) * ((K : ℝ) * ηl) = effectiveStep K ηl ηg / S := by
    dsimp [effectiveStep]
    ring
  rw [hc]

end SCAFFOLD
