-- Source module: NLogN.HFW8
/-!
# Fermat-ring convolution machine, part 8: scaling and decoding

`dcL`: for each residue `z` on `XD`: push `(z · 2^{2n-l}) mod F` on `KZ` (linear operations,
ruler `2^{n-l}` on `SH = 28`), drop `z`, run `decP` (pushes the reversed block on `KO`).
`mvPairs`: move the `N·r` Gaussian pairs from `KO` to `OUT = 0` keeping each pair's order.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.FW

open IntMul IntMul.HvdH NLogN

abbrev SH : Fin HS := 28
abbrev OUT : Fin HS := 0

/-! ## Bounds on decoded blocks -/

/-! ## The scaling expression -/

def wE : Ex HS := .shl (.reg XD) (.reg SH)
def dsE : Ex HS := .add (.quo wE (.reg NLogN.FW.XN)) (.neg (.rem wE (.reg NLogN.FW.XN)))
/-- `(z · 2^{2n-l}) mod (2^n + 1)` for `z` on `XD`, `2^{n-l}` on `SH`. -/
def scE : Ex HS := .sel dsE (.add dsE (.reg XF)) dsE

/-- The scaled residue. -/
def scl (n l : ℕ) (z : ℤ) : ℤ := (z * 2 ^ (2 * n - l)) % (2 ^ n + 1)

/-! ## The decoding loop -/

def dcBody : RM := RM.seqL [.rs (.push KZ scE), .rs (.pop XD), decP]

def dcL : RM := .rep C0 (.reg NN) dcBody

def dSt (P r l : ℕ) (C : List ℤ) (s : IState HS) (RD : List Item) (k : ℕ) : IState HS :=
  (s.upd XD (ints (C.drop k) ++ RD)).upd KO
    (gints (((C.take k).map (scl (4 * r * P) l)).flatMap
      (Ref.decBlk (2 ^ (4 * r * P) + 1) P r)).reverse ++ s.G KO)

/-- Cost of decoding `N` residues. -/
def dcCost (N r P Q W : ℕ) : ℕ :=
  N * (1000000 * (r + 1) * (Q + 5) + 200000 * (r * P + 1) + 100000 * (W + 2)) + 4000 * (W + 2) + 32

/-! ## Moving the Gaussian pairs -/

/-- `N · r` -/
def cntE : Ex HS := .shl (.reg NN) (.reg KR)

def mpBody : RM :=
  RM.seqL [.rs (.push TMP (.reg KO)), .rs (.pop KO), .rs (.push OUT (.reg KO)), .rs (.pop KO),
    .rs (.push OUT (.reg TMP)), .rs (.pop TMP)]

def mvPairs : RM := .rep C0 cntE mpBody

def mpSt (Z : List (ℤ × ℤ)) (s : IState HS) (RK : List Item) (k : ℕ) : IState HS :=
  (s.upd KO (gints (Z.drop k) ++ RK)).upd OUT (gints (Z.take k).reverse ++ s.G OUT)

end NLogN.FW

end

