    (ha : s.G i = .int a :: La) (hb : s.G j = .int b :: Lb) (hza : zsz a ≤ m) (hzb : zsz b ≤ m) :
    Spec M (.mul k i j) s (s.upd k (.int (b * a) :: s.G k)) (Φm + 1000 * (m + 1)) := by
  refine ⟨RM.mul_ok_of_bnd hM k i j s a b La Lb hk hi hj ha hb hza hzb, ?_,
    RM.mul_cost_of_bnd hM k i j s a b La Lb ha hb hza hzb⟩
  simp [RM.run, IState.top_eq ha, IState.top_eq hb]

end NLogN.FW

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.FW
open IntMul IntMul.HvdH NLogN
theorem solution (M : MulSpec) {Φm : ℕ} (n W N : ℕ) (hM : MulBnd M (n + 1) Φm) (s : IState HS)
    (A B : List ℤ) (RD RY LN LXN LXF : List Item) (hAl : A.length = N) (hBl : B.length = N)
    (hAc : Canon (2 ^ n + 1) A) (hBc : Canon (2 ^ n + 1) B) (hX : s.G XD = ints B ++ RD)
    (hY : s.G YC = ints A ++ RY) (hN : s.G NN = .int (N : ℤ) :: LN)
    (hXN : s.G NLogN.FW.XN = .int (2 ^ n) :: LXN) (hXF : s.G XF = .int (2 ^ n + 1) :: LXF)
    (hW : 2 * n + 2 ≤ W) (hNW : zsz (N : ℤ) ≤ W) :
    Spec M pmL s ((s.upd XD (ints (Ref.pmulZ (2 ^ n + 1) A B) ++ RD)).upd YC RY)
      (pmCost N W Φm) := by
  have H := NLogN.FW.rep_spec_reg (M := M) (i := NLogN.FW.C0) (r := NLogN.FW.NN) (b := NLogN.FW.pmBody) (s := s) (NLogN.FW.pmSt n A B s RD RY) N
    LN hN (by simp (config := {decide := true}) [NLogN.FW.pmBody, NLogN.RM.seqL, NLogN.RM.writes, NLogN.RS.writes])
    (by simp only [NLogN.FW.pmSt, List.drop_zero, List.take_zero]; rw [← hX, ← hY]; simp [Ref.pmulZ])
    (fun k => by simp (config := {decide := true}) [NLogN.FW.pmSt, NLogN.IState.upd_G]) (by decide) (by decide)
    W hNW (Φm + 100000 * (W + 2)) ?_
  · have e1 : NLogN.FW.pmSt n A B s RD RY N = ((s.upd NLogN.FW.XD RD).upd NLogN.FW.YC RY).upd NLogN.FW.ZB
        (NLogN.ints (Ref.pmulZ (2 ^ n + 1) A B).reverse ++ s.G NLogN.FW.ZB) := by
      simp only [NLogN.FW.pmSt, List.drop_eq_nil_of_le (show A.length ≤ N by omega),
        List.drop_eq_nil_of_le (show B.length ≤ N by omega), List.take_of_length_le
        (show A.length ≤ N by omega), List.take_of_length_le (show B.length ≤ N by omega), NLogN.ints_nil,
        List.nil_append]
    rw [e1] at H
    have hpl : (Ref.pmulZ (2 ^ n + 1) A B).length = N := by rw [NLogN.FW.length_pmulZ _ _ _ (by omega), hAl]
    have e2 := NLogN.FW.spec_mv M NLogN.FW.ZB NLogN.FW.XD NLogN.FW.C2 NLogN.FW.NN (((s.upd NLogN.FW.XD RD).upd NLogN.FW.YC RY).upd NLogN.FW.ZB
        (NLogN.ints (Ref.pmulZ (2 ^ n + 1) A B).reverse ++ s.G NLogN.FW.ZB)) (Ref.pmulZ (2 ^ n + 1) A B).reverse
      (s.G NLogN.FW.ZB) LN (by decide) (by decide) (by decide) (by simp)
      (by simp (config := {decide := true}) [hN, hpl]) (by decide) (by decide) (by decide)
      (by decide) W (by simp [hpl, hNW]) (fun x hx => by
        have := NLogN.FW.canon_pmulZ'' n A B x (List.mem_reverse.1 hx)
        exact (NLogN.FW.canon_zsz' this.1 this.2).trans (by omega))
    rw [List.reverse_reverse, List.length_reverse, hpl] at e2
    refine (H.seq e2).congr ?_ |>.mono ?_
    · ((apply NLogN.IState.ext' <;> intros <;> simp (config := {decide := true}) only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.withCtr] <;> split_ifs <;> simp_all (config := {decide := true})))
    · have := Nat.mul_le_mul_left N
        (show Φm + 100000 * (W + 2) + 8000 * (W + 2) + 30 ≤ Φm + 110000 * (W + 2) by omega)
      simp only [NLogN.FW.pmCost]; omega
  intro k hk
  have hkA : k < A.length := by omega
  have hkB : k < B.length := by omega
  have ca := hAc _ (List.getElem_mem hkA)
  have cb := hBc _ (List.getElem_mem hkB)
  set t := NLogN.withCtr NLogN.FW.C0 s N k (NLogN.FW.pmSt n A B s RD RY k) with ht
  have tX : t.G NLogN.FW.XD = .int B[k] :: (NLogN.ints (B.drop (k + 1)) ++ RD) := by
    simp (config := {decide := true}) only [ht, NLogN.withCtr, NLogN.FW.pmSt, NLogN.IState.upd_G, if_true, if_false]
    rw [List.drop_eq_getElem_cons hkB]; rfl
  have tY : t.G NLogN.FW.YC = .int A[k] :: (NLogN.ints (A.drop (k + 1)) ++ RY) := by
    simp (config := {decide := true}) only [ht, NLogN.withCtr, NLogN.FW.pmSt, NLogN.IState.upd_G, if_true, if_false]
    rw [List.drop_eq_getElem_cons hkA]; rfl
  have e1 := NLogN.FW.spec_mul M hM NLogN.FW.TMP NLogN.FW.XD NLogN.FW.YC t B[k] A[k] _ _ (by decide) (by decide) (by decide) tX tY
    (NLogN.FW.canon_zsz' cb.1 cb.2) (NLogN.FW.canon_zsz' ca.1 ca.2)
  set t1 := t.upd NLogN.FW.TMP (.int (A[k] * B[k]) :: t.G NLogN.FW.TMP) with ht1
  have hx0 : 0 ≤ A[k] * B[k] := mul_nonneg ca.1 cb.1
  have hx1 : A[k] * B[k] ≤ 2 ^ (2 * n) := by
    rw [two_mul, pow_add]; exact mul_le_mul (by omega) (by omega) cb.1 (by positivity)
  have rf := NLogN.FW.redE_facts t1 n W (A[k] * B[k]) (t.G NLogN.FW.TMP) LXN LXF (by simp [ht1])
    (by simp (config := {decide := true}) [ht1, ht, NLogN.withCtr, NLogN.FW.pmSt, NLogN.IState.upd_G, hXN])
    (by simp (config := {decide := true}) [ht1, ht, NLogN.withCtr, NLogN.FW.pmSt, NLogN.IState.upd_G, hXF]) hx0 hx1 hW
  have e2 := NLogN.FW.spec_push_lin M NLogN.FW.ZB NLogN.FW.redE t1 (by decide) rf.2.1 rf.2.2.1 rf.2.2.2.1 W rf.2.2.2.2
  rw [rf.1] at e2
  set t2 := t1.upd NLogN.FW.ZB (.int (A[k] * B[k] % (2 ^ n + 1)) :: t1.G NLogN.FW.ZB) with ht2
  have hm := (NLogN.FW.canon_zsz' hx0 (lt_of_le_of_lt hx1 (by
    have := pow_lt_pow_right₀ (show (1 : ℤ) < 2 by norm_num) (show 2 * n < 2 * n + 1 by omega)
    linarith) : A[k] * B[k] < 2 ^ (2 * n + 1) + 1)).trans (show 2 * n + 1 + 1 ≤ W by omega)
  have e3 := NLogN.FW.spec_pop M NLogN.FW.TMP t2 (A[k] * B[k]) (t.G NLogN.FW.TMP) (by decide)
    (by simp (config := {decide := true}) [ht2, ht1]) W hm
  have e4 := NLogN.FW.spec_pop M NLogN.FW.XD (t2.upd NLogN.FW.TMP (t.G NLogN.FW.TMP)) B[k] (NLogN.ints (B.drop (k + 1)) ++ RD) (by decide)
    (by simp (config := {decide := true}) [ht2, ht1, tX]) W ((NLogN.FW.canon_zsz' cb.1 cb.2).trans (by omega))
  have e5 := NLogN.FW.spec_pop M NLogN.FW.YC ((t2.upd NLogN.FW.TMP (t.G NLogN.FW.TMP)).upd NLogN.FW.XD (NLogN.ints (B.drop (k + 1)) ++ RD)) A[k]
    (NLogN.ints (A.drop (k + 1)) ++ RY) (by decide)
    (by simp (config := {decide := true}) [ht2, ht1, tY]) W ((NLogN.FW.canon_zsz' ca.1 ca.2).trans (by omega))
  simp only [NLogN.FW.pmBody, NLogN.RM.seqL]
  refine (e1.seq (e2.seq (e3.seq (e4.seq e5)))).congr ?_ |>.mono ?_
  · simp only [ht2, ht1, ht, NLogN.FW.pmSt, NLogN.withCtr]
    rw [NLogN.FW.pmulZ_take_succ _ A B k hkA hkB, List.reverse_append]
    ((apply NLogN.IState.ext' <;> intros <;> simp (config := {decide := true}) only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.withCtr] <;> split_ifs <;> simp_all (config := {decide := true})))
  · simp only [NLogN.FW.redE, NLogN.FW.dE, NLogN.Ex.size]; omega
end
