  have hhp : (0 : ℝ) ≤ hp (pP6 P n) := by unfold hp; positivity
  unfold errW6
  have hcard : ((D + 1 : ℕ) : ℝ) * ((12 * m + 11 : ℕ) : ℝ) ≤ (2 : ℝ) ^ (pP6 P n / 2) := by
    have : (D + 1) * (12 * m + 11) ≤ 2 ^ ((pP6 P n) / 2) := by rw [← hD]; exact hsum
    exact_mod_cast this
