import Mathlib.LinearAlgebra.Matrix.Rank
import Mathlib.LinearAlgebra.Vandermonde
import Mathlib.Tactic

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# Exact integer moment detection at bounded distinct support

All determinants are ordinary integer determinants.  The largest nonsingular
leading Hankel matrix identifies the number of distinct modes.  Multiplying
the physical measure by `(mode-target)^2` then detects whether the target is
one of those modes; no rational elimination or polynomial root recovery is
needed.  Runtime construction of these fixed-size determinants is separate.
-/

namespace ThreeSum.FiniteMomentZeroDetector

open Matrix Finset
open scoped BigOperators

set_option maxHeartbeats 2000000

def moment {t : ℕ} (v w : Fin t → ℤ) (k : ℕ) : ℤ :=
  ∑ s, w s * v s^k

def hankel {t : ℕ} (v w : Fin t → ℤ) (d : ℕ) : Matrix (Fin d) (Fin d) ℤ :=
  fun i j => moment v w (i.val+j.val)

def powerTable {t : ℕ} (v : Fin t → ℤ) (d : ℕ) : Matrix (Fin t) (Fin d) ℤ :=
  fun s i => v s^i.val

theorem hankel_factor {t : ℕ} (v w : Fin t → ℤ) (d : ℕ) :
    hankel v w d=(powerTable v d)ᵀ * diagonal w * powerTable v d := by
  ext i j
  change (∑ s, w s * v s^(i.val+j.val))=
    ∑ s, (((powerTable v d)ᵀ * diagonal w) i s) * powerTable v d s j
  simp only [Matrix.mul_diagonal,Matrix.transpose_apply,powerTable]
  apply Finset.sum_congr rfl
  intro s hs
  rw [pow_add]
  ring

theorem det_hankel_formula {t : ℕ} (v w : Fin t → ℤ) :
    (hankel v w t).det=(vandermonde v).det^2 * ∏ s, w s := by
  rw [hankel_factor,Matrix.det_mul,Matrix.det_mul,Matrix.det_transpose,Matrix.det_diagonal]
  change (vandermonde v).det*(∏ s,w s)*(vandermonde v).det=_
  ring

theorem det_hankel_support_ne_zero {t : ℕ} (v w : Fin t → ℤ)
    (hv : Function.Injective v) (hw : ∀ s, w s≠0) :
    (hankel v w t).det≠0 := by
  rw [det_hankel_formula]
  exact mul_ne_zero (pow_ne_zero 2 (Matrix.det_vandermonde_ne_zero_iff.mpr hv))
    (Finset.prod_ne_zero_iff.mpr (fun s hs => hw s))

theorem det_hankel_eq_zero_of_support_lt {t d : ℕ} (v w : Fin t → ℤ) (ht : t<d) :
    (hankel v w d).det=0 := by
  by_contra hdet
  have hr := Matrix.rank_of_det_ne_zero hdet
  have hb : (hankel v w d).rank≤t := by
    rw [hankel_factor]
    exact (Matrix.rank_mul_le_left _ _).trans
      ((Matrix.rank_mul_le_left _ _).trans (Matrix.rank_le_width _))
  simp only [Fintype.card_fin] at hr
  omega




def modifiedMoment {t : ℕ} (v w : Fin t → ℤ) (a : ℤ) (k : ℕ) : ℤ :=
  moment v w (k+2)-2*a*moment v w (k+1)+a^2*moment v w k

theorem modifiedMoment_eq {t : ℕ} (v w : Fin t → ℤ) (a : ℤ) (k : ℕ) :
    modifiedMoment v w a k=moment v (fun s => w s*(v s-a)^2) k := by
  unfold modifiedMoment moment
  rw [Finset.mul_sum,Finset.mul_sum]
  rw [←Finset.sum_sub_distrib,←Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro s hs
  simp only [pow_add,pow_one,pow_two]
  ring

def modifiedHankel {t : ℕ} (v w : Fin t → ℤ) (a : ℤ) (d : ℕ) :
    Matrix (Fin d) (Fin d) ℤ := fun i j => modifiedMoment v w a (i.val+j.val)

theorem modifiedHankel_eq {t : ℕ} (v w : Fin t → ℤ) (a : ℤ) (d : ℕ) :
    modifiedHankel v w a d=hankel v (fun s => w s*(v s-a)^2) d := by
  ext i j
  exact modifiedMoment_eq v w a (i.val+j.val)

theorem modified_det_factor {t : ℕ} (v w : Fin t → ℤ) (a : ℤ) :
    (modifiedHankel v w a t).det=(hankel v w t).det * ∏ s, (v s-a)^2 := by
  rw [modifiedHankel_eq,det_hankel_formula,det_hankel_formula,Finset.prod_mul_distrib]
  ring

theorem modified_det_zero_iff {t : ℕ} (v w : Fin t → ℤ) (a : ℤ)
    (hv : Function.Injective v) (hw : ∀ s, w s≠0) :
    (modifiedHankel v w a t).det=0 ↔ ∃ s, v s=a := by
  have hn := det_hankel_support_ne_zero v w hv hw
  rw [modified_det_factor,mul_eq_zero]
  simp only [hn,false_or,Finset.prod_eq_zero_iff,Finset.mem_univ,true_and,
    sq_eq_zero_iff,sub_eq_zero]

end ThreeSum.FiniteMomentZeroDetector


