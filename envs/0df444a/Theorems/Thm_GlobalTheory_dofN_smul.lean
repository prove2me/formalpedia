variable {R : Type} [CommRing R] {d n : ℕ}

theorem GlobalTheory.dofN_smul (F : Fin d → PS R 2 d) (b : Fin n) (u : Fin d → R) (t : R) (f : PS R n d) :
    DofN F b u (t • f) = t • DofN F b u f := by sorry
