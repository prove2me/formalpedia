theorem ringHom_flat_of_injective (𝒪 k : Type) [CommRing 𝒪] [IsDomain 𝒪] [Field k] (i : 𝒪 →+* k)
    (hi : Function.Injective i) : i.Flat := by
  letI : Algebra 𝒪 k := i.toAlgebra
  let K := FractionRing 𝒪
  let j : K →+* k := IsFractionRing.lift (A := 𝒪) (K := K) (g := i) hi
  letI : Algebra K k := j.toAlgebra
  haveI : IsScalarTower 𝒪 K k := by
    refine IsScalarTower.of_algebraMap_eq (fun x => ?_)
    change i x = j (algebraMap 𝒪 K x)
    simp [j, IsFractionRing.lift_algebraMap]
  have hK : Module.Flat 𝒪 K := IsLocalization.flat K (nonZeroDivisors 𝒪)
  have hk : Module.Flat K k := inferInstance
  have : Module.Flat 𝒪 k := Module.Flat.trans 𝒪 K k
  exact this

theorem flat_specMap_of_injective (𝒪 k : Type) [CommRing 𝒪] [IsDomain 𝒪] [Field k] (i : 𝒪 →+* k)
    (hi : Function.Injective i) : Flat (Spec.map (CommRingCat.ofHom i)) := by
  rw [HasRingHomProperty.Spec_iff (P := @Flat)]
  simpa using ringHom_flat_of_injective 𝒪 k i hi

section BaseChangeAction

variable {B k : Type} [CommRing B] [CommRing k] (i : B →+* k) {M₀ : Scheme.{0}}
  (πM₀ : M₀ ⟶ Spec (CommRingCat.of B))

noncomputable def bcHom (g : M₀ ⟶ M₀) (hg : g ≫ πM₀ = πM₀) :
    pullback πM₀ (Spec.map (CommRingCat.ofHom i)) ⟶ pullback πM₀ (Spec.map (CommRingCat.ofHom i)) :=
  pullback.lift (pullback.fst _ _ ≫ g) (pullback.snd _ _) (by rw [Category.assoc, hg, pullback.condition])

@[scoped simp] theorem bcHom_fst (g : M₀ ⟶ M₀) (hg : g ≫ πM₀ = πM₀) :
    bcHom i πM₀ g hg ≫ pullback.fst _ _ = pullback.fst _ _ ≫ g := pullback.lift_fst _ _ _

@[scoped simp] theorem bcHom_snd (g : M₀ ⟶ M₀) (hg : g ≫ πM₀ = πM₀) :
    bcHom i πM₀ g hg ≫ pullback.snd _ _ = pullback.snd _ _ := pullback.lift_snd _ _ _

noncomputable def bcAut (g : Aut M₀) (hg : g.hom ≫ πM₀ = πM₀) : Aut (pullback πM₀ (Spec.map (CommRingCat.ofHom i))) where
  hom := bcHom i πM₀ g.hom hg
  inv := bcHom i πM₀ g.inv (by rw [Iso.inv_comp_eq]; exact hg.symm)
  hom_inv_id := by
    apply pullback.hom_ext
    · simp only [Category.assoc, bcHom_fst, Category.id_comp]
      rw [← Category.assoc, bcHom_fst, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    · simp only [Category.assoc, bcHom_snd, Category.id_comp]
  inv_hom_id := by
    apply pullback.hom_ext
    · simp only [Category.assoc, bcHom_fst, Category.id_comp]
      rw [← Category.assoc, bcHom_fst, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    · simp only [Category.assoc, bcHom_snd, Category.id_comp]

@[scoped simp] theorem bcAut_hom_fst (g : Aut M₀) (hg : g.hom ≫ πM₀ = πM₀) :
    (bcAut i πM₀ g hg).hom ≫ pullback.fst _ _ = pullback.fst _ _ ≫ g.hom := bcHom_fst i πM₀ g.hom hg

@[scoped simp] theorem bcAut_hom_snd (g : Aut M₀) (hg : g.hom ≫ πM₀ = πM₀) :
    (bcAut i πM₀ g hg).hom ≫ pullback.snd _ _ = pullback.snd _ _ := bcHom_snd i πM₀ g.hom hg

variable {G : Type} [Group G]

noncomputable def bcAction (ρ : G →* Aut M₀) (hρ : ∀ g : G, (ρ g).hom ≫ πM₀ = πM₀) :
    G →* Aut (pullback πM₀ (Spec.map (CommRingCat.ofHom i))) where
  toFun g := bcAut i πM₀ (ρ g) (hρ g)
  map_one' := by
    refine Iso.ext (pullback.hom_ext ?_ ?_)
    · change (bcAut i πM₀ (ρ 1) (hρ 1)).hom ≫ pullback.fst _ _ = (𝟙 _) ≫ pullback.fst _ _
      rw [bcAut_hom_fst, map_one, Category.id_comp]
      exact Category.comp_id _
    · change (bcAut i πM₀ (ρ 1) (hρ 1)).hom ≫ pullback.snd _ _ = (𝟙 _) ≫ pullback.snd _ _
      rw [bcAut_hom_snd, Category.id_comp]
  map_mul' g h := by
    refine Iso.ext (pullback.hom_ext ?_ ?_)
    · change (bcAut i πM₀ (ρ (g * h)) (hρ (g * h))).hom ≫ pullback.fst _ _ =
        ((bcAut i πM₀ (ρ h) (hρ h)).hom ≫ (bcAut i πM₀ (ρ g) (hρ g)).hom) ≫ pullback.fst _ _
      rw [bcAut_hom_fst, map_mul, Category.assoc, bcAut_hom_fst, ← Category.assoc, bcAut_hom_fst, Category.assoc]
      rfl
    · change (bcAut i πM₀ (ρ (g * h)) (hρ (g * h))).hom ≫ pullback.snd _ _ =
        ((bcAut i πM₀ (ρ h) (hρ h)).hom ≫ (bcAut i πM₀ (ρ g) (hρ g)).hom) ≫ pullback.snd _ _
      rw [bcAut_hom_snd, Category.assoc, bcAut_hom_snd, bcAut_hom_snd]

@[scoped simp] theorem bcAction_hom_fst (ρ : G →* Aut M₀) (hρ : ∀ g : G, (ρ g).hom ≫ πM₀ = πM₀) (g : G) :
    (bcAction i πM₀ ρ hρ g).hom ≫ pullback.fst _ _ = pullback.fst _ _ ≫ (ρ g).hom :=
  bcAut_hom_fst i πM₀ _ _

@[scoped simp] theorem bcAction_hom_snd (ρ : G →* Aut M₀) (hρ : ∀ g : G, (ρ g).hom ≫ πM₀ = πM₀) (g : G) :
    (bcAction i πM₀ ρ hρ g).hom ≫ pullback.snd _ _ = pullback.snd _ _ :=
  bcAut_hom_snd i πM₀ _ _

theorem bcAction_hom_eq (ρ : G →* Aut M₀) (hρ : ∀ g : G, (ρ g).hom ≫ πM₀ = πM₀) (g : G) :
    (bcAction i πM₀ ρ hρ g).hom =
      pullback.lift (pullback.fst πM₀ (Spec.map (CommRingCat.ofHom i)) ≫ (ρ g).hom)
        (pullback.snd πM₀ (Spec.map (CommRingCat.ofHom i))) (by rw [Category.assoc, hρ, pullback.condition]) := by
  apply pullback.hom_ext
