    (fun k => by simp [T, hXD.symm, hYD.symm, hZD.symm]) (dmB X Y Z) (410 * (B + 1))
    (by
      intro k hk LA LC LD
      have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hz := hB _ (List.getElem_mem hk)
      have hx : (cf3 (T k) pA pC pD LA LC LD).G X = .int L[k] :: (ints (L.drop (k + 1)) ++ RX) := by
        simp only [T, cf3, IState.upd_G, if_neg hXD, if_neg hXC, if_neg hXA, if_neg hXY,
          if_neg hXZ, if_true]
        rw [hd]; rfl
      have H1 := IRuns.dup (I := I) (iprog := iprog) hXY hx
      have H2 := IRuns.mv (I := I) (iprog := iprog)
        (s := (cf3 (T k) pA pC pD LA LC LD).upd Y
