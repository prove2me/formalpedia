namespace EquidistantBIBDPell

/-- Number of points of the proposed symmetric design. -/
def v (u : ℤ) : ℤ := 12 * u ^ 2 + 8 * u + 2

/-- Block size of the proposed symmetric design. -/
def k (u : ℤ) : ℤ := 6 * u ^ 2 + u

/-- The index `λ` of the proposed symmetric design, as the *polynomial* `3u² − u`. -/
def lam (u : ℤ) : ℤ := 3 * u ^ 2 - u















end EquidistantBIBDPell


