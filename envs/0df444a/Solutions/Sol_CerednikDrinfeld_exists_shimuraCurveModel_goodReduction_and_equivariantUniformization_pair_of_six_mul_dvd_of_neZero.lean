theorem natCast_coe_completion (A : ValuationSubring (AlgebraicClosure ℚ)) (r : ℕ) :
    ((r : AlgebraicClosure ℚ) : A.valuation.Completion) = (r : A.valuation.Completion) :=
  map_natCast (algebraMap (AlgebraicClosure ℚ) A.valuation.Completion) r

theorem rho_s_mem_typePreserving
    (r : ℕ) [Fact r.Prime] (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime r)
    (R₀ : Type) [CommRing R₀] [IsDomain R₀] [IsDiscreteValuationRing R₀]
    [Algebra R₀ ↥(ValuationSubring.ratClosure A)] [IsFractionRing R₀ ↥(ValuationSubring.ratClosure A)]
    (hR₀ : ∀ x : ↥(ValuationSubring.ratClosure A), x ∈ Set.range (algebraMap R₀ ↥(ValuationSubring.ratClosure A)) ↔
      Valued.v (algebraMap ↥(ValuationSubring.ratClosure A) A.valuation.Completion x) ≤ 1)
    {ad bd : ℚ} (ι : ℍ[ℚ, ad, bd] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ↥(ValuationSubring.ratClosure A)) (hι : Function.Injective ι)
    (ρ : (ℍ[ℚ, ad, bd])ˣ →* PGL(2, ↥(ValuationSubring.ratClosure A)))
    (hρ : ∀ x : (ℍ[ℚ, ad, bd])ˣ, ρ x = Matrix.ProjGenLinGroup.mk
      (Units.map (ι : ℍ[ℚ, ad, bd] →* Matrix (Fin 2) (Fin 2) ↥(ValuationSubring.ratClosure A)) x))
    (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓr : ℓ ≠ r)
    (s : (ℍ[ℚ, ad, bd])ˣ) (hs : nrd (s : ℍ[ℚ, ad, bd]) = ((ℓ : ℕ) : ℚ)) :
    ρ s ∈ Mumford.typePreserving PGL(2, ↥(ValuationSubring.ratClosure A)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A))
      (LT.LatticeTree.stdVertex R₀ ↥(ValuationSubring.ratClosure A)) := by
  letI act : MulAction (ℍ[ℚ, ad, bd])ˣ (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A)) := MulAction.compHom _ ρ
  have hnd : ¬ r ∣ ℓ := fun h => hℓr ((Nat.prime_dvd_prime_iff_eq Fact.out hℓ).mp h).symm
  have h := (CerednikDrinfeld.BruhatTits.mem_typePreserving_iff_even_padicValRat_nrd r A hA R₀ hR₀ ι hι ρ hρ (fun _ _ => rfl) s).mpr
    (by rw [hs, padicValRat.of_nat, padicValNat.eq_zero_of_not_dvd hnd]; exact ⟨0, rfl⟩)
  rw [Mumford.mem_typePreserving_iff] at h ⊢
  exact h

theorem cover_of {q q' r r' : ℕ} (hrq : (r = q ∧ r' = q') ∨ (r = q' ∧ r' = q)) (ℓ : Nat.Primes) :
    (ℓ : ℕ) = r ∨ (ℓ : ℕ) = r' ∨ ((ℓ : ℕ) ≠ q ∧ (ℓ : ℕ) ≠ q') := by
  by_cases h1 : (ℓ : ℕ) = r
  · exact Or.inl h1
  by_cases h2 : (ℓ : ℕ) = r'
  · exact Or.inr (Or.inl h2)
  rcases hrq with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact Or.inr (Or.inr ⟨h1, h2⟩)
  · exact Or.inr (Or.inr ⟨h2, h1⟩)

def PlaceBlock2 (N q q' r r' : ℕ) (i i' : Fin 2) [Fact r.Prime] [Fact r'.Prime] [NeZero N]
    (A : ValuationSubring (AlgebraicClosure ℚ))
