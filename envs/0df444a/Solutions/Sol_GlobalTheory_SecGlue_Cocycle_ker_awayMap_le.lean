  rw [IsLocalization.mk'_eq_zero_iff] at hx
  obtain ⟨⟨_, p, rfl⟩, hp⟩ := hx
  rw [IsLocalization.mk'_mem_map_algebraMap_iff]
  refine ⟨r ^ p, ⟨p, rfl⟩, ?_⟩
  rw [RingHom.mem_ker, map_mul, map_pow]
  exact hp
