/-! ## Transport of the consistency defect -/

theorem MIPStarRE.QPBT.WinImplications.consistencyDefect_swappedState {X α ιA ιB : Type*}
    [Fintype X] [DecidableEq X] [Fintype α] [DecidableEq α]
    [Fintype ιA] [DecidableEq ιA] [Fintype ιB] [DecidableEq ιB]
    (μ : _root_.LIDT.MIPStarRE.LDT.Distribution X) (M : X → α → _root_.LIDT.MIPStarRE.Quantum.Op ιA) (N : X → α → _root_.LIDT.MIPStarRE.Quantum.Op ιB)
    (ψ : EuclideanSpace ℂ (ιA × ιB)) :
    _root_.MIPStarRE.QPBT.consistencyDefect μ (fun x a => _root_.MIPStarRE.QPBT.heteroKron (N x a) 1)
        (fun x a => _root_.MIPStarRE.QPBT.heteroKron 1 (M x a))
        (_root_.MIPStarRE.QPBT.reindexState (Equiv.prodComm ιA ιB) ψ) =
      _root_.MIPStarRE.QPBT.consistencyDefect μ (fun x a => _root_.MIPStarRE.QPBT.heteroKron (M x a) 1)
        (fun x a => _root_.MIPStarRE.QPBT.heteroKron 1 (N x a)) ψ := by sorry
