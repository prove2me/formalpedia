theorem D_pow_succ_inv (f : F) (m : ℕ) :
    KaehlerDifferential.D K F ((f ^ (m + 1))⁻¹)
      = (-((m + 1 : ℕ) : F) * (f ^ (m + 2))⁻¹) • KaehlerDifferential.D K F f := by
