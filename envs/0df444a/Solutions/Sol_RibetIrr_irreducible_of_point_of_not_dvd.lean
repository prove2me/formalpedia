theorem evalk_eq_zero_iff_mem (k : ℕ) (x : ModularCurve.TateModule p J) :
    evalk p J k x = 0 ↔ x ∈ ((p : ℤ_[p]) ^ k) • (⊤ : Submodule ℤ_[p] (ModularCurve.TateModule p J)) := by
  rw [evalk_eq_zero_iff p J hsmul, Submodule.mem_smul_pointwise_iff_exists]
