def kInF (n D BΦ BL BC AL AC : ℕ) (CΦ CL CC : ℝ) : ℝ :=
  ((2 * moveCost (n + 1) + 19 + kDig n : ℕ) : ℝ) + kPhi n BΦ CΦ + kFtF n D BL BC AL AC CL CC

