-- title:
--   Lévy natural filtration right germ sits in completed past
-- statement:
--   Let $X$ be a Lévy process on a probability space $(\Omega,\mathcal{F},P)$, and write $\mathcal{G}_t=\sigma(X_s:s\le t)$ for its raw natural filtration. Fix $t\ge 0$, and let $\mathcal{N}$ be the $\sigma$-algebra generated by subsets of $P$-null measurable sets.
--
--   Then
--   $$
--   \bigcap_{s>t}\mathcal{G}_s \;\subseteq\; \mathcal{G}_t\vee\mathcal{N}.
--   $$
--
--   This is the Blumenthal-type right-germ inclusion for general Lévy processes (independent increments and càdlàg paths), and is the probabilistic core of Kyprianou Exercise 3.1.
-- source:
--   Kyprianou (2006), Chapter 3, Exercise 3.1 (right-germ / Blumenthal step), printed p. 83

import Mathlib
import Definitions.Def_LeanLevy_Processes_LevyProcess
import Definitions.Def_Kyprianou_Ch03_CompletedNaturalFiltration
open MeasureTheory ProbabilityTheory
open scoped NNReal
set_option autoImplicit false

namespace Kyprianou.Ch03
theorem levy_natFiltr_rightGerm_le_completed
    {Omega : Type} [MeasurableSpace Omega]
    (P : Measure Omega) [IsProbabilityMeasure P]
    (X : NNReal -> Omega -> Real)
    (hX : ProbabilityTheory.IsLevyProcess X P)
    (t : NNReal) :
    (⨅ s : NNReal, ⨅ (_ : t < s), PerfCorrMSQ.natFiltr X s) ≤
      PerfCorrMSQ.natFiltr X t ⊔
        MeasurableSpace.generateFrom
            {A : Set Omega |
              exists N : Set Omega,
                MeasurableSet N ∧ P N = 0 ∧ A ⊆ N} := by
  sorry

end Kyprianou.Ch03
