/-- **`BigSpec` from contexts and setup runs.** -/
theorem bigSpec_of6 {E : ℕ} (P : Prm) (ix : Ix6 (7 + E)) (tab : Fin 1 → IStmt HS 1)
    (extM : Fin E → IStmt HS (7 + E)) (bigE : Fin (7 + E))
    (hbig : IL.kTableP tab extM bigE = bigP6 ix) (ext₁ : Fin ix.P₁ → IStmt HS (7 + ix.P₁))
    (hp₁ : ∀ j, IL.kTableP tab extM (ix.g₁ j) = (IL.kTableP tab ext₁ j).ren id ix.g₁)
    (N₁ : ℕ) (Tb : ℕ → ℕ)
    (H : ∀ n, N₁ ≤ n → ∃ (src : ℕ → ℕ) (D : ℕ) (iS : ∀ i, NeZero (sD6 src D i))
      (iT : ∀ i, NeZero (tD6 P n D i)), ∀ (Isym : List Sym) (x y : List Bool),
        x.length = n → y.length = n →
        ∃ (t : IState HS) (c0 : ℕ), IRuns Isym (IL.kTableP tab ext₁) (.call ix.eS) (readSt x y) t c0 ∧
          BaseOK6 P n src t ∧ t.G 0 = [] ∧ t.G pW = [] ∧ t.G ARGM = (readSt x y).G ARGM ∧
          t.out = [] ∧
          ∃ C : BigCtx6 ix Isym tab extM ⟨P, n, src⟩ D,
            (c0 : ℝ) + kMul6 C + kFin6 C + 2 ≤ Tb n) :
    BigSpec (IL.kTableP tab extM) bigE N₁ Tb := by
  intro x y hxy hN
  obtain ⟨src, D, iS, iT, HC⟩ := H _ hN
  obtain ⟨t, c0, r0, hR, h0, hW, hA, hout, C, hT⟩ := HC (inputCodes x y) x y rfl hxy.symm
  obtain ⟨s', c, r, ho, hc⟩ := big_run6 C ext₁ hp₁ x y rfl hxy.symm t c0 r0 hR h0 hW hA hout
  refine ⟨s', c + 2, IRuns.call (by rw [hbig]; exact r), ho, ?_⟩
  have h2 : ((c + 2 : ℕ) : ℝ) ≤ (Tb x.length : ℝ) := by push_cast; linarith
  exact_mod_cast h2

end

end IntMul.Kappa.R6

