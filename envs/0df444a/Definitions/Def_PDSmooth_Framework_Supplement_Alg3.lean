-- title:
--   Algorithm 3, p. 34 — runs of the stochastic primal-dual smoothing framework and the uniform output index
-- statement:
--   Let $(\Omega,\mathcal F,\mathbb P)$ be a probability space and use the setting of problem (1.1) of the base mission: the objective $q=f+r$, its dual smoothing $q_\rho=f_\rho+r$, the DGF $\omega_{\mathcal X}$ and the range $R_{\mathcal Y}(\omega_{\mathcal Y})$. For $\lambda>0$ and $x\in\mathcal X$ write $Q^\lambda_\rho(x';x)=q_\rho(x')+\lambda^{-1}D_{\omega_{\mathcal X}}(x',x)$ and $q^\lambda_\rho(x)=\inf_{x'\in\mathcal X}Q^\lambda_\rho(x';x)$.
--
--   A **run of Algorithm 3** for $K$ iterations with accuracy $\eta$ and $\rho=\eta/(4R_{\mathcal Y}(\omega_{\mathcal Y}))$ (`IsAlg3Run`) is a family of random points $x_k:\Omega\to\mathbb X$ such that
--
--   1. $x_1\equiv x_1^{\circ}$ for a deterministic point $x_1^{\circ}\in\mathcal X$;
--   2. $x_1,\dots,x_{K+1}$ are measurable;
--   3. for $k=1,\dots,K$: $x_{k+1}$ takes values in $\mathcal X$ ($=\mathcal X^o$ by §2.4 (ii)), $Q^\lambda_\rho(x_{k+1};x_k)$ is integrable, and almost surely
--
--   $$
--   \mathbb E\big[Q^\lambda_\rho(x_{k+1};x_k)\,\big|\,x_k\big]\ \le\ q^\lambda_\rho(x_k)+\eta .
--   $$
--
--   The output is $x_{\mathrm{out}}=x_\kappa$, where the index $\kappa$ is uniform on $\{1,\dots,K\}$ (`IsUniformIndex`: $\kappa$ measurable and $\mathbb P(\kappa=k)=1/K$ for $k=1,\dots,K$).
--
--   Algorithm 3 is the stochastic extension of Algorithm 1: Step 2 holds only in conditional expectation, and the algorithm runs for a fixed number of iterations and outputs a uniformly sampled iterate.
--
--   **Formalization Note** The conditional expectation is taken given the σ-algebra generated by $x_k$, which is the page's $\mathbb E[\cdot\mid x_k]$ and the weakest form of the hypothesis. The infimum $q^\lambda_\rho(x_k)$ is written by quantifying over every $x'\in\mathcal X$ inside the almost-sure statement. When $R_{\mathcal Y}(\omega_{\mathcal Y})=0$, Lean's division gives $\rho=0$, and then $\rho R_{\mathcal Y}=0\le\eta/4$. Independence of $\kappa$ from the iterates is stated by the theorem.
-- source:
--   Zhao, A primal-dual smoothing framework for max-structured non-convex optimization, arXiv:2003.04375v5, p. 34, Algorithm 3

import Mathlib
import Definitions.Def_PDSmooth_Framework_Setting

namespace PDSmooth.Framework.Supplement

open MeasureTheory PDSmooth.Framework

/-- A run of Algorithm 3 (p. 34) on a probability space `(Ω, P)`, for `K` iterations, with dual
smoothing parameter `ρ = η/(4 R_Y(ω_Y))`: the start `x₁ ∈ X` is deterministic; the iterates
`x_k : Ω → 𝕏` (`1 ≤ k ≤ K + 1`) are measurable; and for `k = 1, …, K` the iterate `x_{k+1}` takes
values in `X` (`= X°` by §2.4 (ii)), `Q^λ_ρ(x_{k+1}; x_k)` is integrable, and almost surely
`E[Q^λ_ρ(x_{k+1}; x_k) | x_k] ≤ q^λ_ρ(x_k) + η`, where `q^λ_ρ(x_k) = inf_{x' ∈ X} Q^λ_ρ(x'; x_k)`;
the bound is written against every `x' ∈ X` inside the almost-sure statement, and the conditional
expectation is given the σ-algebra generated by `x_k`. `x 0` is unused. -/
def IsAlg3Run {E F Ω : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [MeasurableSpace E]
    [MeasurableSpace Ω] (P : Measure Ω)
    (X : Set E) (Y : Set F) (Φ : E → F → ℝ) (g : F → ℝ) (r : E → ℝ) (ωX : E → ℝ) (ωY : F → ℝ)
    (lam η : ℝ) (K : ℕ) (x1 : E) (x : ℕ → Ω → E) : Prop :=
  x1 ∈ X ∧ (∀ ω, x 1 ω = x1) ∧ (∀ k : ℕ, 1 ≤ k → k ≤ K + 1 → Measurable (x k)) ∧
    ∀ k : ℕ, 1 ≤ k → k ≤ K →
      (∀ ω, x (k + 1) ω ∈ X) ∧
      Integrable (fun ω => Qprox (qSmooth Φ g r ωY Y (η / (4 * rangeY ωY Y))) ωX lam
        (x k ω) (x (k + 1) ω)) P ∧
      ∀ᵐ ω ∂P, ∀ x' ∈ X,
        (P[fun ω' => Qprox (qSmooth Φ g r ωY Y (η / (4 * rangeY ωY Y))) ωX lam
            (x k ω') (x (k + 1) ω') | MeasurableSpace.comap (x k) ‹MeasurableSpace E›]) ω
          ≤ Qprox (qSmooth Φ g r ωY Y (η / (4 * rangeY ωY Y))) ωX lam (x k ω) x' + η

/-- Algorithm 3's output index (p. 34): `κ ∼ Unif{1, …, K}`, i.e. `κ` is measurable and takes each
value `k ∈ {1, …, K}` with probability `1/K`. -/
def IsUniformIndex {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (κ : Ω → ℕ) (K : ℕ) : Prop :=
  Measurable κ ∧ ∀ k ∈ Finset.Icc 1 K, P (κ ⁻¹' {k}) = ((K : ENNReal))⁻¹

end PDSmooth.Framework.Supplement


