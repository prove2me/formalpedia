theorem trace511_valid : Valid 262144 511 177147 346 trace511 := by decide

theorem trace511_bound (k : ℕ) :
    syracuseStep^[11] (262144 * k + 511) ≤ 177147 * k + 346 := by
  exact sound trace511_valid k

theorem trace511_strict_descent (k : ℕ) :
    syracuseStep^[11] (262144 * k + 511) < 262144 * k + 511 := by
  exact strict_descent trace511_valid (by decide) (by decide) k


