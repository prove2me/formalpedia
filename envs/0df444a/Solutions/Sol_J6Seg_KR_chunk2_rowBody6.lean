theorem chunk2_rowBody6_sol_aux {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {e : Fin Pp}
    {M : MulSpec} {pM : Fin Pp} (htbl : tbl e = chunkI2 pM) (hM : MulOK Isym tbl pM M)
    (hdom : ∀ x y, M.dom x y)
    {b pk φD B BH : ℕ} {φT : ℕ → ℕ} (hΦD : ∀ x y : ℤ, zsz x ≤ B → zsz y ≤ B → M.Φ x y ≤ φD)
    (hΦT : ∀ n, ∀ x y : ℤ, zsz x ≤ b * (2 * n) + 2 → zsz y ≤ b * (2 * n) + 2 → M.Φ x y ≤ φT n)
    (hb : 1 ≤ b) (P lam : ℕ) (hlam : 1 ≤ lam) (di gi gam dd : List ℤ)
    (ds : ℕ → List (ℕ × List ℤ × List ℤ)) {Kt X : ℤ} (hKt : 0 ≤ Kt) (hX : 0 ≤ X)
    (hdi : di.length = lam) (hgi : gi.length = lam) (hga : gam.length = lam)
    (hdd : dd.length = lam)
    (tdi : TB (2 ^ P * Kt) di) (tgi : TB (2 ^ P * Kt) gi) (tga : TB (2 ^ P * Kt) gam)
    (tdd : TB (2 ^ P * Kt) dd) (hKpk : 2 ^ P * Kt ≤ 2 ^ pk)
    (hpk : Xs ((lam + 1) * Kt + 1) X 7 ≤ 2 ^ pk)
    (hds : ∀ q, ∀ d ∈ ds q, 1 ≤ d.1 ∧ d.2.1.length = d.1 ∧ d.2.2.length = d.1 ∧ d.1 ≤ lam ∧
        TB (2 ^ P * Kt) d.2.1 ∧ TB (2 ^ P * Kt) d.2.2 ∧
        2 * (2 * d.1) * 2 ^ (2 * pk) < 2 ^ (b - 1) ∧
        zsz ((2 * d.1 : ℕ) : ℤ) ≤ B ∧ (∀ v ∈ blkHdr2 d.1 b, zsz v ≤ BH))
    (hsum : ∀ q, sumN (ds q) ≤ lam)
    (hBb : b + 4 ≤ B) (hBp : 2 * pk + 4 ≤ B) (hPB : P + 3 ≤ B) (hlB : zsz ((2 * lam : ℕ) : ℤ) ≤ B)
    (hBBH : B ≤ BH) (hBH : ∀ q, ∀ v ∈ tabK2 P pk b lam di gi gam dd (ds q), zsz v ≤ BH)
    (C : ℝ) (hC : ∀ q, ((cKer2 pk b lam φD φT B BH (ds q) + 2 : ℕ) : ℝ) ≤ C) :
    RowBody6 Isym tbl e dT (fun q => tabK2 P pk b lam di gi gam dd (ds q))
      (fun x => x.length = lam ∧ AB X x) (fun q => chunkG2 P di gi gam dd (ds q)) C := by
  intro q s F x l hF hFT hF0 ⟨hxl, hxX⟩
  have hX7 : X ≤ 2 ^ pk :=
    (Xs_mono (K := (lam + 1) * Kt + 1) (by nlinarith) hX (Nat.zero_le 7)).trans hpk
  have TBm : ∀ {c : List ℤ}, TB (2 ^ P * Kt) c → TB (2 ^ pk) c := fun h => TB_mono h hKpk
  have H := chunkI2_runs (I := Isym) (iprog := tbl) (pM := pM) hM hdom hΦD hΦT hb P lam hlam s
    di gi gam dd (ds q) x l hxl hdi hgi hga hdd
    (fun d hd => by
      obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := hds q d hd
      exact ⟨h1, h2, h3, h4, h4, h4, h4, TBm h5, TBm h6, h7, h8, h9⟩)
    (hsum q)
    (chunkOK_of P hKt hX tdi tgi tga tdd (by omega) (by omega) (by omega) (by omega) hpk (ds q) x
      (fun d hd => by
        obtain ⟨h1, h2, h3, h4, h5, h6, _⟩ := hds q d hd
        exact ⟨h4, by omega, by omega, h5, h6⟩) (by rw [hxl]; exact hsum q) hxX)
    (AB_mono hxX hX7) (TBm tdi) (TBm tgi) (TBm tga) (TBm tdd) hBb hBp hPB hlB hBBH (hBH q)
  refine ⟨_, ?_, hC q⟩
  have e0 := frame0 F hF
  rw [hFT, hF0] at e0
  have hF' : ∀ j, j ≠ 0 → j ≠ dT →
      Function.update F 0 (gflat (chunkG2 P di gi gam dd (ds q) x) ++ l) j = [] := fun j h0 h1 => by
    rw [Function.update_of_ne h0, hF j h0 h1]
  have e1 := frame0 _ hF'
  rw [Function.update_self, Function.update_of_ne (by decide), hFT] at e1
  beta_reduce
  rw [e1, e0]
  exact IRuns.call (by rw [htbl]; exact H)

end J6Seg.KR

