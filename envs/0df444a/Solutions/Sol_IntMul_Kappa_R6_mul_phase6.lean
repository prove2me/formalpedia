open Complex IntMul.OpenAI.RT IntMul.OpenAI.RC NLogN.KFZ

noncomputable section

variable {D : ℕ}

theorem QA_small {κ : Type*} [Fintype κ] (p : ℕ) {F : (κ → ℂ) → (κ → ℂ)} (hF : LinC F)
    (Es : ℝ) (hEs : Es * hp p ≤ 1 / 100) {u v : κ → ℂ} (hu1 : ‖u‖ ≤ 1 / 4) (hv1 : ‖v‖ ≤ 1 / 4)
    {U V : κ → ℂ} (hU : ‖U - F u‖ ≤ Es * hp p) (hV : ‖V - F v‖ ≤ Es * hp p) :
    Grid p (QA p (U * V)) ∧ ‖QA p (U * V)‖ ≤ 1 / 2 := by
  have nU : ‖F u‖ ≤ 1 / 4 := (hF.le u).trans hu1
  have nV : ‖F v‖ ≤ 1 / 4 := (hF.le v).trans hv1
  have nUt : ‖U‖ ≤ 1 / 4 + 1 / 100 := by
    have := norm_sub_norm_le U (F u); linarith
  have nVt : ‖V‖ ≤ 1 / 4 + 1 / 100 := by
    have := norm_sub_norm_le V (F v); linarith
  refine ⟨QA_grid _ _, (norm_QA_le _ _).trans ((KFM.norm_mul_le' _ _).trans (by
    nlinarith [norm_nonneg U, norm_nonneg V]))⟩

end

end NLogN.KFM

