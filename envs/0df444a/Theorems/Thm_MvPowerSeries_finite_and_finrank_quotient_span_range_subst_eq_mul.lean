-- title:
--   Multiplicativity of dim_k k[[X]]/(f) under substitution
-- statement:
--   Let $k$ be a field and $d$ a natural number, and let $f = (f_1,\dots,f_d)$ and $g = (g_1,\dots,g_d)$ be two $d$-tuples of formal power series in $k[[X_1,\dots,X_d]] =$ `MvPowerSeries (Fin d) k`, each of whose members has vanishing constant coefficient. Assume that the quotient of $k[[X_1,\dots,X_d]]$ by the ideal generated by the set of the $f_i$ is a finite $k$-module, and likewise for the ideal generated by the set of the $g_i$. Then the quotient of $k[[X_1,\dots,X_d]]$ by the ideal generated by the $d$ series $\mathrm{subst}\,g\,(f_i)$, obtained by substituting the tuple $g$ into $f_i$, is again a finite $k$-module, and its $k$-dimension satisfies
--   $$\dim_k k[[X]]/(\mathrm{subst}\,g\,(f_1),\dots,\mathrm{subst}\,g\,(f_d)) = \dim_k k[[X]]/(f_1,\dots,f_d)\cdot \dim_k k[[X]]/(g_1,\dots,g_d),$$
--   the dimensions being `Module.finrank` over $k$. The two assertions — finiteness of the composite quotient and the product formula for its rank — are stated as a single conjunction.
--
--   This is the multiplicativity of the order of the kernel under composition of isogenies of formal Lie groups over a field, written in coordinates: a homomorphism of formal group laws is a tuple of power series without constant term, the coordinate ring of its kernel is the corresponding quotient of $k[[X]]$, and the tuple attached to a composite is obtained by substitution. It is used in the Čerednik–Drinfel'd part of the development, for instance in computing the ranks of kernel algebras of isogenies of special formal $O_D$-modules and in producing isogenies of prescribed height.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_MvPowerSeries_finite_and_finrank_quotient_span_range_subst_eq_mul.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

universe u

theorem MvPowerSeries.finite_and_finrank_quotient_span_range_subst_eq_mul
    {k : Type u} [Field k] {d : ℕ} (f g : Fin d → MvPowerSeries (Fin d) k)
    (hf : ∀ i, MvPowerSeries.constantCoeff (f i) = 0)
    (hg : ∀ i, MvPowerSeries.constantCoeff (g i) = 0)
    (hffin : Module.Finite k (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range f)))
    (hgfin : Module.Finite k (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range g))) :
    Module.Finite k
        (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range fun i => MvPowerSeries.subst g (f i))) ∧
      Module.finrank k
          (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range fun i => MvPowerSeries.subst g (f i))) =
        Module.finrank k (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range f)) *
          Module.finrank k (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range g)) := by sorry
