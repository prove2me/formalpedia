lemma solution {h : ℝ} (hh : 0 < h) {v : EuclideanSpace ℝ (Fin d)}
    (hv : ‖v‖ = 1) {ϑ : ℝ} (hϑ : 0 < ϑ) (hϑ' : ϑ ≤ π / 2)
    (p : EuclideanSpace ℝ (Fin d)) :
    h • p ∈ QFS.doubleCone v ϑ ↔ p ∈ QFS.doubleCone v ϑ := by
  constructor
  · intro hp
    have := QFS.smul_mem_doubleCone hv hϑ hϑ' (t := h⁻¹) (by positivity) hp
    rwa [smul_smul, inv_mul_cancel₀ (ne_of_gt hh), one_smul] at this
  · exact fun hp => QFS.smul_mem_doubleCone hv hϑ hϑ' hh hp
