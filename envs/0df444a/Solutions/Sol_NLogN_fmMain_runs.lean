namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem bnd_reverse {m : ℕ} {A : List ℤ} (h : Bnd m A) : Bnd m A.reverse := by
  intro a ha; exact h a (List.mem_reverse.mp ha)

theorem zev_digits (M : ℕ) : ∀ D : List ℤ, (∀ d ∈ D, 0 ≤ d ∧ d < 2 ^ M) →
    0 ≤ zev (2 ^ M) D ∧ zev (2 ^ M) D < 2 ^ (D.length * M)
  | [], _ => by simp [zev]
  | d :: D, h => by
    obtain ⟨ih0, ih1⟩ := zev_digits M D (fun x hx => h x (by simp [hx]))
    obtain ⟨h0, h1⟩ := h d (by simp)
    simp only [zev, List.length_cons]
    have e : (2 : ℤ) ^ ((D.length + 1) * M) = 2 ^ M * 2 ^ (D.length * M) := by
      rw [← pow_add]; congr 1; ring
    rw [e]
    have hp : (0 : ℤ) < 2 ^ M := by positivity
    constructor
    · positivity
    · nlinarith

end NLogN

end

