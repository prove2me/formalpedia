-- url     : https://prove2.me/theorems/ec9d833b-a1ce-4627-9347-5c8d81cb9d02
-- title:
--   Algorithm 4 (Optimistic Double Pointer Market Maker) and its rewards, trades and imbalance
-- statement:
--   **Algorithm 4** runs on finite grids $\mathcal B^\circ$ (bids) and $\mathcal A^\circ$ (asks) with confidence radii $\psi_t(b)$, $\psi_t(a)$ that may depend on the history. Initially $\mathcal B^\circ_0=\mathcal B^\circ$, $\mathcal A^\circ_0=\mathcal A^\circ$, $\widehat F_0=\widehat S_0=0$ and $\psi_0\equiv1$. In round $t=1,\dots,T$:
--
--   1. Build the bounds of time $t-1$:
--   $$F^{\mathrm{up}}_{t-1}=\min\{1,\widehat F_{t-1}+\psi_{t-1}\},\quad F^{\mathrm{low}}_{t-1}=\max\{0,\widehat F_{t-1}-\psi_{t-1}\},$$
--   and likewise $S^{\mathrm{up}}_{t-1},S^{\mathrm{low}}_{t-1}$ from $\widehat S_{t-1}$.
--   2. Run Algorithm 5 on the active sets $\mathcal B^\circ_{t-1},\mathcal A^\circ_{t-1}$ with these bounds; it returns the candidate pair $(B_{t,0},A_{t,0})$. Set $\mathcal B^\circ_t=\mathcal B^\circ\cap[B_{t,0},1]$ and $\mathcal A^\circ_t=\mathcal A^\circ\cap[0,A_{t,0}]$.
--   3. Correction: if $S^{\mathrm{up}}_{t-1}(A_{t,0})<F^{\mathrm{low}}_{t-1}(B_{t,0})$, draw $X\sim\mathrm{Bern}(S^{\mathrm{up}}_{t-1}(A_{t,0})/F^{\mathrm{low}}_{t-1}(B_{t,0}))$ and post $B_t=0$ if $X=0$; else, if $F^{\mathrm{up}}_{t-1}(B_{t,0})<S^{\mathrm{low}}_{t-1}(A_{t,0})$, draw $Y\sim\mathrm{Bern}(F^{\mathrm{up}}_{t-1}(B_{t,0})/S^{\mathrm{low}}_{t-1}(A_{t,0}))$ and post $A_t=1$ if $Y=0$. Otherwise $(B_t,A_t)=(B_{t,0},A_{t,0})$.
--   4. Observe the limit-order-book feedback and update the estimates
--   $$\widehat F_t(b)=\frac1t\sum_{\tau=1}^t\chi^{\mathrm{sell}}_\tau(b),\qquad \widehat S_t(a)=\frac1t\sum_{\tau=1}^t\chi^{\mathrm{buy}}_\tau(a),$$
--   where $\chi^{\mathrm{sell}}_\tau(b)=\mathbb I(\max\{V^{\mathrm{sell}}_\tau,B_\tau\}\le b)$ and $\chi^{\mathrm{buy}}_\tau(a)=\mathbb I(\min\{V^{\mathrm{buy}}_\tau,A_\tau\}\ge a)$ (Eq. (17)), which the maker can compute from what it observes.
--
--   The maker buys in round $t$ iff $V^{\mathrm{sell}}_t\le B_t$ and sells iff $V^{\mathrm{buy}}_t\ge A_t$. Its reward and imbalance are
--   $$
--   r_t=A_t\,\mathbb I(V^{\mathrm{buy}}_t\ge A_t)-B_t\,\mathbb I(V^{\mathrm{sell}}_t\le B_t),\qquad I_t=\sum_{\tau=1}^t\big(\mathbb I(V^{\mathrm{sell}}_\tau\le B_\tau)-\mathbb I(V^{\mathrm{buy}}_\tau\ge A_\tau)\big).
--   $$
--   The module also names the bounds $F^{\mathrm{up}}_t,F^{\mathrm{low}}_t,S^{\mathrm{up}}_t,S^{\mathrm{low}}_t$ after round $t$ and $J^{\mathrm{up}}_t(b,a)=(a-b)\min\{F^{\mathrm{up}}_t(b),S^{\mathrm{up}}_t(a)\}$, $J^{\mathrm{low}}_t(b,a)=(a-b)\min\{F^{\mathrm{low}}_t(b),S^{\mathrm{low}}_t(a)\}$ of Lemma 6.14.
--
--   **Formalization Note** The algorithm is defined pathwise, outcome by outcome, as a recursion over rounds; the record of round $t$ holds $\mathcal B^\circ_t,\mathcal A^\circ_t$, $(B_{t,0},A_{t,0})$ and $(B_t,A_t)$. The draw $X\sim\mathrm{Bern}(p)$ is $\mathbb 1\{U_t<p\}$. The estimates $\widehat F_t,\widehat S_t$ are defined at every price by the observable averages (the paper updates them on the active sets, the only prices where they are used). The radius of time $0$ is $1$ whatever the radius functions say.
-- source:
--   Maran, Restelli, Stradi, No-Regret Revenue Maximization in Sequential Market Making Under Inventory Constraints, arXiv:2610.24562v1, Algorithm 4, p. 37; Eqs. (17), (20), (21), pp. 36–38; Definition 3.1, p. 16; reward r_t, p. 17; Lemma 6.14, p. 44

import Mathlib
import Definitions.Def_InvMarketMaking_LOB_IsRoundModel
import Definitions.Def_InvMarketMaking_LOB_doublePointer

namespace InvMarketMaking.LOB

/-- The parameters of Algorithm 4: the finite discretized sets `B° = Bg` (bids) and `A° = Ag`
(asks), and the confidence radii `ψ_t(b) = ψF t b ω`, `ψ_t(a) = ψS t a ω`, which may depend on the
outcome `ω` (Notation 6.9, p. 38: functions "that depend only on quantities generated by the end of
round `t`"). -/
structure LOBConfig (Ω : Type*) where
  /-- the bid grid `B°` -/
  Bg : Finset ℝ
  /-- the ask grid `A°` -/
  Ag : Finset ℝ
  /-- bid radius `ψ_t(b)` -/
  ψF : ℕ → ℝ → Ω → ℝ
  /-- ask radius `ψ_t(a)` -/
  ψS : ℕ → ℝ → Ω → ℝ

/-- What Algorithm 4 records in round `t`: the active sets `B°_t`, `A°_t` (Lines 5–6), the
candidate pair `(B_{t,0}, A_{t,0})` returned by Algorithm 5 (Line 4) and the posted pair
`(B_t, A_t)` after the correction (Lines 7–20). -/
structure RoundRec where
  activeB : Finset ℝ
  activeA : Finset ℝ
  bid0 : ℝ
  ask0 : ℝ
  bid : ℝ
  ask : ℝ

/-- `χ^sell_τ(b) = I(max{V^sell_τ, B_τ} ≤ b)` (Eq. (17), p. 36), for a valuation sequence `vs` and a
posted-bid sequence `bid`. -/
noncomputable def chiSell (vs bid : ℕ → ℝ) (τ : ℕ) (b : ℝ) : ℝ :=
  if max (vs τ) (bid τ) ≤ b then 1 else 0

/-- `χ^buy_τ(a) = I(min{V^buy_τ, A_τ} ≥ a)` (Eq. (17), p. 36). -/
noncomputable def chiBuy (vb ask : ℕ → ℝ) (τ : ℕ) (a : ℝ) : ℝ :=
  if a ≤ min (vb τ) (ask τ) then 1 else 0

/-- The observable estimate `F̂_t(b) = (1/t) Σ_{τ=1}^t χ^sell_τ(b)` (Eqs. (17)–(18), p. 36). At
`t = 0` it is `0` (Line 2 of Algorithm 4: `F̂_0 ← 0`; Lean's `x / 0 = 0`). -/
noncomputable def estSellOf (vs bid : ℕ → ℝ) (t : ℕ) (b : ℝ) : ℝ :=
  (∑ τ ∈ Finset.Icc 1 t, chiSell vs bid τ b) / t

/-- The observable estimate `Ŝ_t(a) = (1/t) Σ_{τ=1}^t χ^buy_τ(a)` (Eqs. (17), (19)); `Ŝ_0 = 0`. -/
noncomputable def estBuyOf (vb ask : ℕ → ℝ) (t : ℕ) (a : ℝ) : ℝ :=
  (∑ τ ∈ Finset.Icc 1 t, chiBuy vb ask τ a) / t

/-- The radius used at time `t`: `ψ_0 ≡ 1` (Line 2 of Algorithm 4), and `ψ_t(x)` for `t ≥ 1`. -/
noncomputable def radius (ψ : ℕ → ℝ → ℝ) (t : ℕ) (x : ℝ) : ℝ :=
  if t = 0 then 1 else ψ t x

/-- Upper confidence bound `min{1, est + ψ}` (Eqs. (20)–(21), p. 38). -/
noncomputable def upperBound (est rad : ℝ) : ℝ := min 1 (est + rad)

/-- Lower confidence bound `max{0, est − ψ}` (Eqs. (20)–(21), p. 38). -/
noncomputable def lowerBound (est rad : ℝ) : ℝ := max 0 (est - rad)

/-- The randomized correction of Algorithm 4 (Lines 7–20), given the uniform draw `u`, the
candidate pair `(b0, a0) = (B_{t,0}, A_{t,0})` and the bounds
`F^up_{t−1}(b0), F^low_{t−1}(b0), S^up_{t−1}(a0), S^low_{t−1}(a0)`. If `S^up < F^low`, draw
`X ∼ Bern(S^up/F^low)` and set `B_t ← 0` when `X = 0`; else if `F^up < S^low`, draw
`Y ∼ Bern(F^up/S^low)` and set `A_t ← 1` when `Y = 0`. A Bernoulli draw `X ∼ Bern(p)` is
`X = 1{u < p}`. -/
noncomputable def correct (u b0 a0 Fup Flo Sup Slo : ℝ) : ℝ × ℝ :=
  if Sup < Flo then (if u < Sup / Flo then b0 else 0, a0)
  else if Fup < Slo then (b0, if u < Fup / Slo then a0 else 1)
  else (b0, a0)

/-- One round `t ≥ 1` of Algorithm 4 (Lines 4–20, p. 37), pathwise: `h τ` is the record of round
`τ` for `τ ≤ t − 1` (round `0` holds the initial active sets `B°_0 = B°`, `A°_0 = A°`). The bounds
of time `t − 1` are built from the observable estimates `F̂_{t−1}, Ŝ_{t−1}` (from the posted prices
of rounds `1, …, t − 1`) and the radius `ψ_{t−1}` (`≡ 1` when `t − 1 = 0`). -/
noncomputable def roundStep (Bg Ag : Finset ℝ) (ψF ψS : ℕ → ℝ → ℝ) (vs vb u : ℕ → ℝ) (t : ℕ)
    (h : ℕ → RoundRec) : RoundRec :=
  let Fup : ℝ → ℝ := fun b =>
    upperBound (estSellOf vs (fun τ => (h τ).bid) (t - 1) b) (radius ψF (t - 1) b)
  let Flo : ℝ → ℝ := fun b =>
    lowerBound (estSellOf vs (fun τ => (h τ).bid) (t - 1) b) (radius ψF (t - 1) b)
  let Sup : ℝ → ℝ := fun a =>
    upperBound (estBuyOf vb (fun τ => (h τ).ask) (t - 1) a) (radius ψS (t - 1) a)
  let Slo : ℝ → ℝ := fun a =>
    lowerBound (estBuyOf vb (fun τ => (h τ).ask) (t - 1) a) (radius ψS (t - 1) a)
  let p := doublePointer ((h (t - 1)).activeB.sort) ((h (t - 1)).activeA.sort) Fup Flo Sup Slo
  let q := correct (u t) p.1 p.2 (Fup p.1) (Flo p.1) (Sup p.2) (Slo p.2)
  { activeB := Bg.filter (fun x => p.1 ≤ x ∧ x ≤ 1)
    activeA := Ag.filter (fun x => 0 ≤ x ∧ x ≤ p.2)
    bid0 := p.1
    ask0 := p.2
    bid := q.1
    ask := q.2 }

/-- The records of rounds `0, …, t` after round `t` of Algorithm 4 (entries beyond `t` are the
initial record). -/
noncomputable def history (Bg Ag : Finset ℝ) (ψF ψS : ℕ → ℝ → ℝ) (vs vb u : ℕ → ℝ) :
    ℕ → ℕ → RoundRec
  | 0 => fun _ => ⟨Bg, Ag, 0, 0, 0, 0⟩
  | t + 1 => Function.update (history Bg Ag ψF ψS vs vb u t) (t + 1)
      (roundStep Bg Ag ψF ψS vs vb u (t + 1) (history Bg Ag ψF ψS vs vb u t))

/-- **Algorithm 4** (Optimistic Double Pointer Market Maker; Maran, Restelli, Stradi,
No-Regret Revenue Maximization in Sequential Market Making Under Inventory Constraints,
arXiv:2610.24562v1, p. 37), run on the outcome `ω`: the record of round `t` (active sets `B°_t`,
`A°_t`, candidate `(B_{t,0}, A_{t,0})`, posted `(B_t, A_t)`). Round `0` is the initialization
(`B°_0 = B°`, `A°_0 = A°`; its price fields are unused).

**Formalization Note** (i) The algorithm uses limit-order-book feedback only: its estimates are
the observable averages of `χ^sell, χ^buy` (Eq. (17)), not the full-feedback averages of Eq. (12);
Proposition 6.7 relates the two. (ii) `F̂_0 = Ŝ_0 = 0` and `ψ_0 ≡ 1` (Line 2), so in round 1 the
bounds are `[0, 1]`. (iii) Line 4 passes the active sets of round `t − 1` to Algorithm 5 as
increasing lists. (iv) The Bernoulli draws are `1{U_t < p}`. (v) The active sets are
`B° ∩ [B_{t,0}, 1]` and `A° ∩ [0, A_{t,0}]` (Lines 5–6). -/
noncomputable def lobRound {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (ω : Ω) :
    RoundRec :=
  history C.Bg C.Ag (fun s x => C.ψF s x ω) (fun s x => C.ψS s x ω) (fun s => M.Vs s ω)
    (fun s => M.Vb s ω) (fun s => M.U s ω) t t

/-- The algorithm's observable estimate `F̂_t(b)` after round `t` (Eq. (18)). -/
noncomputable def estSell {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (b : ℝ) (ω : Ω) :
    ℝ :=
  estSellOf (fun s => M.Vs s ω) (fun τ => (lobRound C M τ ω).bid) t b

/-- The algorithm's observable estimate `Ŝ_t(a)` after round `t` (Eq. (19)). -/
noncomputable def estBuy {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (a : ℝ) (ω : Ω) :
    ℝ :=
  estBuyOf (fun s => M.Vb s ω) (fun τ => (lobRound C M τ ω).ask) t a

/-- The bid radius at time `t`, with `ψ_0 ≡ 1`. -/
noncomputable def radF {Ω : Type*} (C : LOBConfig Ω) (t : ℕ) (b : ℝ) (ω : Ω) : ℝ :=
  radius (fun s x => C.ψF s x ω) t b

/-- The ask radius at time `t`, with `ψ_0 ≡ 1`. -/
noncomputable def radS {Ω : Type*} (C : LOBConfig Ω) (t : ℕ) (a : ℝ) (ω : Ω) : ℝ :=
  radius (fun s x => C.ψS s x ω) t a

/-- `F^up_t(b) = min{1, F̂_t(b) + ψ_t(b)}` (Eq. (20)). -/
noncomputable def Fup {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (b : ℝ) (ω : Ω) : ℝ :=
  upperBound (estSell C M t b ω) (radF C t b ω)

/-- `F^low_t(b) = max{0, F̂_t(b) − ψ_t(b)}` (Eq. (20)). -/
noncomputable def Flo {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (b : ℝ) (ω : Ω) : ℝ :=
  lowerBound (estSell C M t b ω) (radF C t b ω)

/-- `S^up_t(a) = min{1, Ŝ_t(a) + ψ_t(a)}` (Eq. (21)). -/
noncomputable def Sup {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (a : ℝ) (ω : Ω) : ℝ :=
  upperBound (estBuy C M t a ω) (radS C t a ω)

/-- `S^low_t(a) = max{0, Ŝ_t(a) − ψ_t(a)}` (Eq. (21)). -/
noncomputable def Slo {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (a : ℝ) (ω : Ω) : ℝ :=
  lowerBound (estBuy C M t a ω) (radS C t a ω)

/-- `J^up_t(b, a) = (a − b) min{F^up_t(b), S^up_t(a)}` (Lemma 6.14, p. 44). -/
noncomputable def Jup {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (b a : ℝ) (ω : Ω) :
    ℝ :=
  (a - b) * min (Fup C M t b ω) (Sup C M t a ω)

/-- `J^low_t(b, a) = (a − b) min{F^low_t(b), S^low_t(a)}` (Lemma 6.14, p. 44). -/
noncomputable def Jlow {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (b a : ℝ) (ω : Ω) :
    ℝ :=
  (a - b) * min (Flo C M t b ω) (Slo C M t a ω)

/-- The maker buys in round `t`: `I(V^sell_t ≤ B_t)` (Sec. 3, p. 14). -/
noncomputable def buyInd {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (ω : Ω) : ℝ :=
  if M.Vs t ω ≤ (lobRound C M t ω).bid then 1 else 0

/-- The maker sells in round `t`: `I(V^buy_t ≥ A_t)` (Sec. 3, p. 14). -/
noncomputable def sellInd {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (ω : Ω) : ℝ :=
  if (lobRound C M t ω).ask ≤ M.Vb t ω then 1 else 0

/-- The reward `r_t = A_t I(V^buy_t ≥ A_t) − B_t I(V^sell_t ≤ B_t)` (Sec. 3.3, p. 17). -/
noncomputable def reward {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (ω : Ω) : ℝ :=
  (lobRound C M t ω).ask * sellInd C M t ω - (lobRound C M t ω).bid * buyInd C M t ω

/-- The inventory increment `I(V^sell_t ≤ B_t) − I(V^buy_t ≥ A_t)` of round `t`. -/
noncomputable def invIncrement {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (ω : Ω) : ℝ :=
  buyInd C M t ω - sellInd C M t ω

/-- The imbalance `I_t = Σ_{τ=1}^t I(V^sell_τ ≤ B_τ) − Σ_{τ=1}^t I(V^buy_τ ≥ A_τ)`
(Definition 3.1, p. 16): purchases minus sales. -/
noncomputable def imbalance {Ω : Type*} (C : LOBConfig Ω) (M : Market Ω) (t : ℕ) (ω : Ω) : ℝ :=
  ∑ τ ∈ Finset.Icc 1 t, invIncrement C M τ ω

end InvMarketMaking.LOB


