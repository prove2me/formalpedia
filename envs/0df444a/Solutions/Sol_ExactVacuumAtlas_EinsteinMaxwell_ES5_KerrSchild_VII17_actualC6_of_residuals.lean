variable {f g : ℝ → ℝ} {k : ℕ} {a c L : ℝ}

theorem ExtV.congr (h : ExtV k f L) (he : f =ᶠ[𝓝[>] (0:ℝ)] g) : ExtV k g L := by
  obtain ⟨G, hG, hGf, hv⟩ := h
  exact ⟨G, hG, hGf.trans he, hv⟩

theorem ExtV.mono (h : ExtV (k + 1) f L) : ExtV k f L := by
  obtain ⟨G, hG, hGf, hv⟩ := h
  exact ⟨G, hG.of_le (by exact_mod_cast Nat.le_succ k), hGf, hv⟩

theorem ExtV.div (hf : ExtV k f a) (hg : ExtV k g c) (hc : c ≠ 0) :
    ExtV k (fun x => f x / g x) (a / c) := by
  obtain ⟨F, hF, hFf, rfl⟩ := hf; obtain ⟨G, hG, hGg, rfl⟩ := hg
  exact ⟨fun x => F x / G x, hF.div hG hc, hFf.div hGg, rfl⟩

