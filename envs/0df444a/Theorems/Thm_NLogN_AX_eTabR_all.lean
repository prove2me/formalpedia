theorem NLogN.AX.eTabR_all (p s t α Bq : ℕ) (st : IState HS) (hs : 0 < s)
    (hP : ∃ L, st.G bO = .int (p : ℤ) :: L) (hS : ∃ L, st.G bS = .int (s : ℤ) :: L)
    (hT : ∃ L, st.G bT = .int (t : ℤ) :: L) (hM : ∃ L, st.G xE = .int (HvdH.eWidth p α : ℤ) :: L)
    (hA : ∃ L, st.G bI = .int ((α ^ 2 : ℕ) : ℤ) :: L) (hK : ∃ L, st.G xK = .int ((s ^ 2 : ℕ) : ℤ) :: L)
    (hR : ∃ L, st.G bNR = .int ((2 * HvdH.eWidth p α + 1 : ℕ) : ℤ) :: L)
    (hBq : (α ^ 2 + s + t + 2 * HvdH.eWidth p α + 2) ^ 24 < 2 ^ Bq) (hpB : zsz (p : ℤ) ≤ Bq)
    (hKB : zsz ((s ^ 2 : ℕ) : ℤ) ≤ Bq) (hEB : ∀ j, zsz (HvdH.expNeg p (s ^ 2) j) ≤ Bq) :
    eTabR.ok st ∧ eTabR.run st = st.upd bW (ints (eTab p s t α).flatten ++ st.G bW) ∧
      eTabR.cost st ≤ tabCost (2 * HvdH.eWidth p α + 1) s (eWCost p Bq) := by sorry
