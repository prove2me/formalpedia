theorem getD_segApply (off : ℕ) (Ms : List M2G) (B1 G : ℕ) (zs : List GI)
    (h : off + G * (2 * B1 * Ms.length) ≤ zs.length) (i : ℕ) :
    (segApply off Ms B1 G zs).getD i 0 =
      if off ≤ i ∧ i < off + G * (2 * B1 * Ms.length) then
        pent (Ms.getD ((i - off) % (2 * B1 * Ms.length) / (2 * B1)) M0) B1 (zs.drop off) (i - off)
      else zs.getD i 0 := by
  have hl := length_qopL Ms B1 G (zs.drop off) (by simp; omega)
  have ht : (zs.take off).length = off := by simp; omega
  unfold segApply
  by_cases h1 : i < off
  · rw [if_neg (by omega), List.getD_append _ _ _ _ (by omega), getD_take' _ _ _ h1]
  rw [List.getD_append_right _ _ _ _ (by omega), ht]
  by_cases h2 : i < off + G * (2 * B1 * Ms.length)
  · rw [if_pos ⟨by omega, h2⟩, List.getD_append _ _ _ _ (by omega),
      getD_qopL Ms B1 _ G (by simp; omega) _ (by omega)]
  · rw [if_neg (by omega), List.getD_append_right _ _ _ _ (by omega), hl, NLogN.KFB.getD_drop', NLogN.KFB.getD_drop']
    congr 1; omega

/-- One pass on a clean managed state. -/
theorem pass_fsp (s : IState HS) (w B1 G off : ℕ) (Ms : List M2G) (hM : ∀ M ∈ Ms, M.Ok)
    (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (hlen : off + G * (2 * B1 * Ms.length) ≤ zs.length) (h0 : f 0 = gflat zs ++ l)
    (hC : Cl f) (hb : NLogN.KFB.GB w zs) (Z : ℕ)
    (hZ : zsz (((4 * (B1 + G + G * (2 * B1 * Ms.length) + off)) : ℕ) : ℤ) ≤ Z) :
    FSp (qopW Ms B1 G off) (encK s f)
      (encK s (Function.update f 0 (gflat (segApply off Ms B1 G zs) ++ l)))
      (cQopW w B1 Ms.length G off Z) :=
  qopW_fsp s w B1 G off Ms hM f (zs.take off) (zs.drop off) l (by simp; omega)
    (by simp; omega) (by rw [List.take_append_drop]; exact h0) hC
    (by rw [List.take_append_drop]; exact hb) Z hZ

theorem den_gate_mulVec {W m n : ℕ} (T : Butterfly.Op (Fin n)) (G : Matrix (Fin W) (Fin W) ℂ)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (p : Fin W × (Fin m × Fin n → Fin 2)) :
    ((P8Lift.RStep.den T (P8Lift.RStep.gate G : P8Lift.RStep (Fin W) m)).mulVec x) p =
      ∑ w', G p.1 w' * x (w', p.2) := by
  simp only [Matrix.mulVec, dotProduct, P8Lift.RStep.den, mul_ite, mul_one, mul_zero, ite_mul,
    zero_mul]
  rw [Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun w' _ => ?_
  rw [Finset.sum_ite_eq]; simp

theorem g2_sum {W m n : ℕ} (r : ℕ) (hr : r + 1 < W) (M : M2G)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (p : Fin W) (b : Fin m × Fin n → Fin 2) :
    ∑ w', g2Mat W r M p w' * x (w', b) =
      if p.val = r then NLogN.KFB.toC M.a * x (⟨r, by omega⟩, b) + NLogN.KFB.toC M.b * x (⟨r + 1, hr⟩, b)
      else if p.val = r + 1 then NLogN.KFB.toC M.c * x (⟨r, by omega⟩, b) + NLogN.KFB.toC M.d * x (⟨r + 1, hr⟩, b)
      else x (p, b) := by
  have hpair : ∀ F : Fin W → ℂ, (∀ q : Fin W, q.val ≠ r → q.val ≠ r + 1 → F q = 0) →
      ∑ q, F q = F ⟨r, by omega⟩ + F ⟨r + 1, hr⟩ := by
    intro F hF
    rw [← Finset.sum_subset (Finset.subset_univ {⟨r, by omega⟩, ⟨r + 1, hr⟩})]
    · rw [Finset.sum_pair]; intro e; simp [Fin.ext_iff] at e
    · intro q _ hq
      simp only [Finset.mem_insert, Finset.mem_singleton, Fin.ext_iff, not_or] at hq
      exact hF q hq.1 hq.2
  split_ifs with h1 h2
  · rw [hpair]
    · simp [g2Mat, h1]
    · intro q hq1 hq2
      have : p ≠ q := fun e => hq1 (e ▸ h1)
      simp [g2Mat, h1, hq1, hq2, this]
  · rw [hpair]
    · simp [g2Mat, h2]
    · intro q hq1 hq2
      have : p ≠ q := fun e => hq2 (e ▸ h2)
      simp [g2Mat, h2, hq1, hq2, this]
  · rw [Finset.sum_eq_single p]
    · simp [g2Mat, h1, h2]
    · intro q _ hq
      simp only [g2Mat, h1, h2, false_and, if_false]
      rw [if_neg (Ne.symm hq), zero_mul]
    · simp

theorem seg2 {N r w a : ℕ} (ha : a < N) :
    (r * N ≤ w * N + a ∧ w * N + a < r * N + 2 * N) ↔ (w = r ∨ w = r + 1) := by
  constructor
  · rintro ⟨h1, h2⟩
    rcases lt_or_ge w r with h | h
    · have : (w + 1) * N ≤ r * N := Nat.mul_le_mul_right _ h
      rw [Nat.succ_mul] at this; omega
    rcases lt_or_ge (r + 1) w with h' | h'
    · have : (r + 2) * N ≤ w * N := Nat.mul_le_mul_right _ h'
      rw [show (r + 2) * N = r * N + 2 * N by ring] at this; omega
    omega
  · rintro (rfl | rfl)
    · omega
    · rw [Nat.succ_mul]; omega

theorem rep_gate2 {W m n : ℕ} (T : Butterfly.Op (Fin n)) (r : ℕ) (hr : r + 1 < W) (M : M2G)
    (zs : List GI) (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : Rep zs x) :
    Rep (g2L (2 ^ (m * n)) r M zs)
      ((P8Lift.RStep.den T (P8Lift.RStep.gate (g2Mat W r M) : P8Lift.RStep (Fin W) m)).mulVec x) := by
  obtain ⟨hl, hv⟩ := hx
  have hb : ∀ b : Fin m × Fin n → Fin 2, aidx b < 2 ^ (m * n) := fun b => aidx_lt b
  have hNp : 0 < 2 ^ (m * n) := by positivity
  unfold Rep g2L
  generalize 2 ^ (m * n) = N at hl hv hb hNp ⊢
  have hlen : r * N + 1 * (2 * N * [M].length) ≤ zs.length := by
    rw [hl]; simp only [List.length_singleton, mul_one, one_mul]
    have : (r + 2) * N ≤ W * N := Nat.mul_le_mul_right _ (by omega)
    rw [show (r + 2) * N = r * N + 2 * N by ring] at this; exact this
  refine ⟨by rw [length_segApply _ _ _ _ _ hlen, hl], fun w' b => ?_⟩
  rw [NLogN.KFB.den_gate_mulVec, g2_sum r hr M x w' b, getD_segApply _ _ _ _ _ hlen]
  simp only [List.length_singleton, mul_one, one_mul]
  have ha := hb b
  by_cases e1 : w'.val = r
  · rw [if_pos ((seg2 ha).2 (Or.inl e1)), if_pos e1, e1]
    have e : r * N + aidx b - r * N = aidx b := by omega
    rw [e, Nat.mod_eq_of_lt (by omega), Nat.div_eq_of_lt (by omega)]
    simp only [pent, List.getD_cons_zero, Nat.mod_eq_of_lt (show aidx b < 2 * N by omega),
      if_pos ha, NLogN.KFB.getD_drop', lin2, toC_add, toC_gmul]
    rw [show r * N + aidx b = (⟨r, by omega⟩ : Fin W).val * N + aidx b from rfl, hv,
      show r * N + (aidx b + N) = (⟨r + 1, hr⟩ : Fin W).val * N + aidx b by simp; ring, hv]
  by_cases e2 : w'.val = r + 1
  · rw [if_pos ((seg2 ha).2 (Or.inr e2)), if_neg (by omega), if_pos e2, e2]
    have e : (r + 1) * N + aidx b - r * N = N + aidx b := by rw [Nat.succ_mul]; omega
    rw [e, Nat.mod_eq_of_lt (by omega), Nat.div_eq_of_lt (by omega)]
    simp only [pent, List.getD_cons_zero, Nat.mod_eq_of_lt (show N + aidx b < 2 * N by omega),
      if_neg (show ¬ N + aidx b < N by omega), NLogN.KFB.getD_drop', lin2, toC_add, toC_gmul]
    rw [show r * N + (N + aidx b - N) = (⟨r, by omega⟩ : Fin W).val * N + aidx b by simp, hv,
      show r * N + (N + aidx b) = (⟨r + 1, hr⟩ : Fin W).val * N + aidx b by simp; ring, hv]
  · rw [if_neg (fun h => by rcases (seg2 ha).1 h with h | h <;> contradiction), if_neg e1,
      if_neg e2, hv]

theorem GB_getD_all {w : ℕ} {zs : List GI} (h : NLogN.KFB.GB w zs) (j : ℕ) :
    zsz (zs.getD j 0).1 ≤ w ∧ zsz (zs.getD j 0).2 ≤ w := by
  by_cases hj : j < zs.length
  · exact (GB_getD.1 h) j hj
  · rw [List.getD_eq_default _ _ (by omega)]
    exact ⟨by simp [zsz_zero], by simp [zsz_zero]⟩

theorem GB_segApply {w : ℕ} (off : ℕ) (Ms : List M2G) (hM : ∀ M ∈ Ms, M.Ok) (B1 G : ℕ)
    (zs : List GI) (h : off + G * (2 * B1 * Ms.length) ≤ zs.length) (hb : NLogN.KFB.GB w zs) :
    NLogN.KFB.GB (w + 2) (segApply off Ms B1 G zs) := by
  have hM0 : True ∧ ∀ k, (Ms.getD k M0).Ok := by
    have z : M0.Ok := ⟨Sm_zero, Sm_zero, Sm_zero, Sm_zero⟩
    refine ⟨trivial, fun k => ?_⟩
    rw [List.getD_eq_getElem?_getD]
    cases e : Ms[k]? with
    | none => exact z
    | some M => exact hM M (List.mem_of_getElem? e)
  rw [GB_getD]
  intro i _
  rw [getD_segApply _ _ _ _ _ h]
  split_ifs
  · simp only [pent]
    have hd := GB_drop hb off
    split_ifs
    · exact lin2_bnd (hM0.2 _).1 (hM0.2 _).2.1 (GB_getD_all hd _) (GB_getD_all hd _)
    · exact lin2_bnd (hM0.2 _).2.2.1 (hM0.2 _).2.2.2 (GB_getD_all hd _) (GB_getD_all hd _)
  · have := GB_getD_all hb i
    exact ⟨this.1.trans (by omega), this.2.trans (by omega)⟩

end NLogN.KFB

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFB
open IntMul RS AModel KIL KFD Complex
theorem solution {Pp : ℕ} {I : List NLogN.Sym} {iprog : Fin Pp → NLogN.IStmt NLogN.HS Pp}
    (s : NLogN.IState NLogN.HS) (wb : ℕ) {W m n : ℕ} (T : Butterfly.Op (Fin n)) (r : ℕ) (hr : r + 1 < W)
    (M : NLogN.KFB.M2G) (hM : M.Ok) (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : NLogN.KFB.Rep zs x) (h0 : f 0 = NLogN.KFB.gflat zs ++ l)
    (hC : NLogN.KFB.Cl f) (hb : NLogN.KFB.GB wb zs) :
    ∃ zs', NLogN.KFB.Rep zs' ((P8Lift.RStep.den T
        (P8Lift.RStep.gate (NLogN.KFB.g2Mat W r M) : P8Lift.RStep (Fin W) m)).mulVec x) ∧
      NLogN.KFB.GB (wb + 2) zs' ∧ zs' = NLogN.KFB.g2L (2 ^ (m * n)) r M zs ∧
      NLogN.IRuns I iprog (NLogN.KFD.fcode (NLogN.KFB.qopW [M] (2 ^ (m * n)) 1 (r * 2 ^ (m * n)))) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat zs' ++ l)))
        (NLogN.KFB.cPass wb (2 * 2 ^ (m * n)) (r * 2 ^ (m * n))
          (NLogN.zsz (((4 * (3 * (2 * 2 ^ (m * n)) + r * 2 ^ (m * n))) : ℕ) : ℤ))) := by
  have hNp : 1 ≤ 2 ^ (m * n) := Nat.one_le_two_pow
  have hlen : r * 2 ^ (m * n) + 1 * (2 * 2 ^ (m * n) * [M].length) ≤ zs.length := by
    rw [hx.1]; simp only [List.length_singleton, mul_one, one_mul]
    have : (r + 2) * 2 ^ (m * n) ≤ W * 2 ^ (m * n) := Nat.mul_le_mul_right _ (by omega)
    rw [show (r + 2) * 2 ^ (m * n) = r * 2 ^ (m * n) + 2 * 2 ^ (m * n) by ring] at this
    exact this
  have H := NLogN.KFB.pass_fsp s wb (2 ^ (m * n)) 1 (r * 2 ^ (m * n)) [M] (by simpa using hM) f zs l hlen h0
    hC hb (NLogN.zsz (((4 * (3 * (2 * 2 ^ (m * n)) + r * 2 ^ (m * n))) : ℕ) : ℤ))
    (NLogN.zsz_natCast_le (by simp; omega))
  refine ⟨_, NLogN.KFB.rep_gate2 T r hr M zs x hx, NLogN.KFB.GB_segApply _ _ (by simpa using hM) _ _ _ hlen hb, rfl,
    NLogN.KFD.FSp.irun (NLogN.KFB.fok_qopW _ _ _ _) (H.mono ?_)⟩
  have := NLogN.KFB.cQopW_le wb (2 ^ (m * n)) 1 (2 * 2 ^ (m * n)) (r * 2 ^ (m * n))
    (NLogN.zsz (((4 * (3 * (2 * 2 ^ (m * n)) + r * 2 ^ (m * n))) : ℕ) : ℤ)) hNp (by ring)
  simp only [List.length_singleton] at this ⊢; exact this
end
