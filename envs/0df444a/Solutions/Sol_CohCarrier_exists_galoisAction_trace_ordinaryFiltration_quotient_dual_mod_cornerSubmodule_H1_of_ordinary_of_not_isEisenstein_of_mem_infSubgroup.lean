  have h1 : ΞAA (op g) = ⟨TC T 𝒪 g, hmem⟩ := Subtype.ext (Ξ_op op hop hgen T bO hbO g)
  rw [h1, crd_TC T u cT 𝒪 huindO huspanO hu_T]

