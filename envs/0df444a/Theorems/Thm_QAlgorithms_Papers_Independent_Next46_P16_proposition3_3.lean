-- title:
--   The form topology makes Schwartz operators a Frechet space
-- statement:
--   Fix $N\ge1$ and let $\mathcal H=L^2(\mathbb R^N)$. Define $\mathcal S(\mathcal H)$ to consist of bounded operators whose four-index Schwartz test forms are Hilbert bounded, as in Definition 3.1. Give this complex vector space the topology generated by the associated form seminorms. Then
--   $$
--   \mathcal S(\mathcal H)\text{ is a Fr\'echet space}.
--   $$
--   More explicitly, addition and complex scalar multiplication are continuous, the topology is locally convex, and it admits a compatible complete metric. The vector space is defined only by the form bounds; completeness and the other topological properties are conclusions.
-- source:
--   Schwartz operators, arXiv:1503.04086v1, PDF p. 11, Proposition 3.3

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P16

noncomputable section

open MeasureTheory Filter

open QAlgorithms.Papers.Independent.Claimed50.P10 (Configuration)

open QAlgorithms.Papers.Independent.Dependency50.P13 (IsTraceClass)

open scoped BigOperators ENNReal ComplexOrder

namespace QAlgorithms.Papers.Independent.Next46.P16

attribute [local instance] QAlgorithms.Papers.Independent.Next46.P16.canonicalComplexCalculus

attribute [local instance] QAlgorithms.Papers.Independent.Next46.P16.canonicalRealCalculus

attribute [local instance] QAlgorithms.Papers.Independent.Next46.P16.canonicalRealNonUnitalCalculus

/-- Proposition 3.3, PDF pp.1,11--12: the original form topology makes the
complex Schwartz-operator space a Frechet space. All topological vector-space,
local convexity and complete metrizability assertions are conclusions. -/
theorem proposition3_3 (n : ℕ) (hn : 0 < n) :
    letI : TopologicalSpace (SchwartzOperator n) := schwartzOperatorTopology n
    IsTopologicalAddGroup (SchwartzOperator n) ∧
      ContinuousSMul ℂ (SchwartzOperator n) ∧
      LocallyConvexSpace ℝ (SchwartzOperator n) ∧
      TopologicalSpace.IsCompletelyMetrizableSpace (SchwartzOperator n) := by sorry

end QAlgorithms.Papers.Independent.Next46.P16

end
