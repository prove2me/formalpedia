section Cons2

variable {sh : Shape} {n Q : ℕ}

variable (Λ : Layout sh n Q)

lemma Layout.actIdx_cons2_add (P L k : ℕ) : (Λ.cons2 P L).actIdx (k + 2) = Λ.actIdx k := by
  unfold Layout.actIdx
  congr 1
  funext i
  simp

lemma Layout.actIdx_cons2_lt (P L k : ℕ) (hk : k < 2) : (Λ.cons2 P L).actIdx k = none := by
  unfold Layout.actIdx
  rw [List.find?_eq_none]
  intro i _
  simp only [cons2_pos, beq_iff_eq]
  omega

lemma act_cons2 (P L p r : ℕ) (x : List ℕ) : act (Λ.cons2 P L) (p :: r :: x) = act Λ x := by
  funext i
  simp [act]

lemma setAct_cons2 (P L p r : ℕ) (x : List ℕ) (v : Fin n → ZMod Q) :
    setAct (Λ.cons2 P L) (p :: r :: x) v = p :: r :: setAct Λ x v := by
  apply List.ext_getElem (by simp)
  intro k h₁ h₂
  rw [getElem_setAct]
  rcases k with _ | _ | k
  · rw [Λ.actIdx_cons2_lt P L 0 (by omega)]; rfl
  · rw [Λ.actIdx_cons2_lt P L 1 (by omega)]; rfl
  · rw [Λ.actIdx_cons2_add]
    simp only [List.getElem_cons_succ]
    rw [getElem_setAct]

lemma amap_cons2 (P L p r : ℕ) (x : List ℕ) (M : Matrix (Fin n) (Fin n) (ZMod Q)) :
    amap (Λ.cons2 P L) M (p :: r :: x) = p :: r :: amap Λ M x := by
  simp only [amap, act_cons2, setAct_cons2]

lemma rowLift_amap {P L : ℕ} (M : Matrix (Fin n) (Fin n) (ZMod Q)) {a : List ℕ}
    (ha : AModel.Valid (P :: L :: sh) a) : rowLift (amap Λ M) a = amap (Λ.cons2 P L) M a := by
  obtain ⟨p, r, x, rfl, -⟩ := valid_cons2 ha
  rw [amap_cons2]; rfl

end Cons2

section ShearAction

variable {rest : Shape} {m Q : ℕ} {M : Type*} [AddCommGroup M]

variable (Λ : Layout rest (m + m) Q) (φ : M →+ Matrix (Fin m) (Fin m) (ZMod Q))

/-- Hypothesis `hπv` of `network_interchange_shear`. -/
lemma shearπ_valid [NeZero Q] (a : M) (x : List ℕ) (hx : AModel.Valid rest x) :
    AModel.Valid rest (shearπ Λ φ a x) :=
  valid_amap Λ _ hx

/-- Hypothesis `hπadd` of `network_interchange_shear`. -/
lemma shearπ_add [NeZero Q] (a b : M) (x : List ℕ) (hx : AModel.Valid rest x) :
    shearπ Λ φ (a + b) x = shearπ Λ φ a (shearπ Λ φ b x) := by
  simp only [shearπ]
  rw [amap_shear_comp Λ _ _ hx, map_add, neg_add_rev]

/-- Hypothesis `hπ0` of `network_interchange_shear`. -/
lemma shearπ_zero (x : List ℕ) (hx : AModel.Valid rest x) : shearπ Λ φ 0 x = x := by
  simp only [shearπ, map_zero, neg_zero]
  exact amap_shear_zero Λ hx

/-- **The row-split shear network (Prop. 11, the shear `H ← H + D`).** Split the rows into `W`
role streams, run the gate network with the physical frame changes `Φ_a` = pull by the shear
`-φ a` on the `rest` digits of every stream, and merge back undoing `ρ`. If every gate is OK, the
scalar circuit routes `w` to `ρ w`, and `Mout (ρ w) - Min w = I0` with `φ I0 = 1`, the result is
the pull of the whole array by the shear by `-1` (on every row, prefix and row digits fixed),
i.e. the array permutation realizing `H ← H + D` (see `pull_shear_moves`). -/
theorem shear_network {R : Type*} [CommRing R] [NeZero Q] (P W L : ℕ) [NeZero W]
    (gates : List (NGate (Fin W) R M)) (hg : ∀ g ∈ gates, g.OK)
    (ρ : Fin W → Fin W) (hρ : ∀ (v : Fin W → R) w, scalarRun gates v (ρ w) = v w)
    (Min Mout : Fin W → M) (I0 : M) (hI : ∀ w, Mout (ρ w) - Min w = I0) (hφ : φ I0 = 1)
    (xs : List R) :
    rowMerge P W L rest 0 (fun w => List.ofFn
      (netRun (streamΦ P L rest (shearπ Λ φ) (shearπ_valid Λ φ)) gates Min Mout
        (fun w' i => (rowSplit P W L rest w' 0 xs).getD (i : ℕ) 0) (ρ w))) =
      AModel.pull (P :: W * L :: rest) (P :: W * L :: rest) (amap (Λ.cons2 P (W * L)) (shearMat (-1)))
        0 xs := by
  rw [network_interchange_shear P W L rest (shearπ Λ φ) (shearπ_valid Λ φ) (shearπ_add Λ φ)
    (shearπ_zero Λ φ) gates hg ρ hρ Min Mout I0 hI xs]
  apply pull_congr
  intro a ha
  rw [shearπ, hφ, rowLift_amap Λ _ ha]

end ShearAction

section Frames

variable {Wr Ω R M : Type*} [CommRing R] [Fintype Wr] [DecidableEq Wr] [AddGroup M]

omit [Fintype Wr] in
lemma netRunF_coe (Φ : M → (Ω → R) →ₗ[R] (Ω → R)) (gates : List (NGate Wr R M))
    (Min Mout : Wr → M) (f : Wr → Ω → R) :
    netRunF (fun a => ⇑(Φ a)) gates Min Mout f = netRun Φ gates Min Mout f := rfl

omit [Fintype Wr] in
lemma foldl_physStepF_congr (Pr : M → Prop) (Φ₁ Φ₂ : M → (Ω → R) → (Ω → R))
    (h : ∀ a, Pr a → Φ₁ a = Φ₂ a) (Mout : Wr → M) :
    ∀ (gates : List (NGate Wr R M)) (st : (Wr → M) × (Wr → Ω → R)),
      FramesOK Pr gates st.1 Mout →
      gates.foldl (physStepF Φ₁) st = gates.foldl (physStepF Φ₂) st ∧
        ∀ w, Pr (Mout w - (gates.foldl (physStepF Φ₁) st).1 w) := by
  intro gates
  induction gates with
  | nil => intro st hF; exact ⟨rfl, hF⟩
  | cons g gs ih =>
    intro st hF
    have e : physStepF Φ₁ st g = physStepF Φ₂ st g := by
      simp only [physStepF, Prod.mk.injEq, true_and]
      funext w
      split_ifs
      · exact Finset.sum_congr rfl fun w' hw' => by rw [h _ (hF.1 w' hw')]
      · rfl
    simp only [List.foldl_cons]
    rw [← e]
    exact ih _ hF.2

omit [Fintype Wr] in
/-- Two implementations agreeing on every frame change that occurs give the same network. -/
theorem netRunF_congr (Pr : M → Prop) (Φ₁ Φ₂ : M → (Ω → R) → (Ω → R))
    (h : ∀ a, Pr a → Φ₁ a = Φ₂ a) (gates : List (NGate Wr R M)) (Min Mout : Wr → M)
    (hF : FramesOK Pr gates Min Mout) (f : Wr → Ω → R) :
    netRunF Φ₁ gates Min Mout f = netRunF Φ₂ gates Min Mout f := by
  obtain ⟨e, hp⟩ := foldl_physStepF_congr Pr Φ₁ Φ₂ h Mout gates (Min, f) hF
  funext w
  simp only [netRunF]
  rw [← e, h _ (hp w)]

end Frames

section RunChild

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {α : Type*}

/-- If every delegated interchange is correct, `runC` is the array run of the steps. -/
theorem runC_eq_runArr (child : Fin n → Fin n → List α → List α) (d : α)
    (steps : List (AModel.Step n Q))
    (hchild : ∀ a b, Step.swap a b ∈ steps → ∀ ys : List α, ys.length = AModel.vol sh →
      child a b ys = (Step.swap a b).arr Λ d ys)
    {xs : List α} (hxs : xs.length = AModel.vol sh) : runC Λ child d steps xs = AModel.runArr Λ d steps xs := by
  induction steps generalizing xs with
  | nil => rfl
  | cons s rest ih =>
    simp only [runC, AModel.runArr, List.foldl_cons] at ih ⊢
    have e : stepC Λ child d xs s = s.arr Λ d xs := by
      cases s with
      | shift i u c => rfl
      | swap a b => exact hchild a b List.mem_cons_self xs hxs
    rw [e]
    exact ih (fun a b h => hchild a b (List.mem_cons_of_mem _ h)) (by rw [Step.arr, length_pull])

end RunChild

section Chunks

lemma hdPos_castAdd (A B : Shape) (m : ℕ) (i : Fin m) :
    AModel.hdPos A B m (Fin.castAdd m i : ℕ) = A.length + i := by
  simp [AModel.hdPos]

lemma hdPos_natAdd (A B : Shape) (m : ℕ) (j : Fin m) :
    AModel.hdPos A B m (Fin.natAdd m j : ℕ) = A.length + B.length + m + j := by
  simp [AModel.hdPos]; omega

lemma vol_replicate (m N : ℕ) : AModel.vol (List.replicate m N) = N ^ m := List.prod_replicate m N

lemma vol_hdShape (A B C : Shape) (m N : ℕ) :
    AModel.vol (hdShape A B C m N) = AModel.vol (swShape A B C (N ^ m)) := by
  simp only [hdShape, swShape, vol_append, vol_cons, vol_replicate]

/-- Merging `r = Y.length` fields starting at `X.length`. -/
lemma mergeShape_append (X Y Z : Shape) {i r : ℕ} (hi : i = X.length) (hr : r = Y.length) :
    mergeShape (X ++ (Y ++ Z)) i r = X ++ (AModel.vol Y :: Z) := by
  subst hi hr
  simp [mergeShape, List.drop_append]

/-- Merging both chunks of `P :: L :: hdShape` gives `P :: L :: swShape` with field `N ^ m`. -/
lemma mergeShape2_hdShape (P L : ℕ) (A B C : Shape) (m N : ℕ) :
    mergeShape2 (P :: L :: hdShape A B C m N) (A.length + 2) (A.length + B.length + m + 2) m =
      P :: L :: swShape A B C (N ^ m) := by
  have h1 : P :: L :: hdShape A B C m N =
      (P :: L :: (A ++ (List.replicate m N ++ B))) ++ (List.replicate m N ++ C) := by
    simp [hdShape]
  have h2 : (P :: L :: (A ++ (List.replicate m N ++ B))) ++ (AModel.vol (List.replicate m N) :: C) =
      (P :: L :: A) ++ (List.replicate m N ++ (B ++ (N ^ m :: C))) := by
    simp [vol_replicate]
  unfold mergeShape2
  rw [h1, mergeShape_append _ _ _ (by simp; omega) (by simp), h2,
    mergeShape_append _ _ _ (by simp) (by simp)]
  simp [swShape, vol_replicate]

end Chunks

section SwapBlock

variable {sh : Shape} {m Q : ℕ} [NeZero Q] (Λ : Layout sh (m + m) Q)

/-- For contiguous `H` fields at `c, …, c+m-1` and `D` fields at `c', …, c'+m-1`, the chunk
interchange `(H, D) ↦ (D, H)` moves digit blocks: it is `blockSwap c c' m` on valid addresses. -/
theorem amap_swapMat_eq_blockSwap {c c' : ℕ}
    (hc : ∀ i : Fin m, (Λ.pos (Fin.castAdd m i) : ℕ) = c + i)
    (hc' : ∀ j : Fin m, (Λ.pos (Fin.natAdd m j) : ℕ) = c' + j) (hcc : c + m ≤ c')
    {a : List ℕ} (ha : AModel.Valid sh a) : amap Λ swapMat a = blockSwap c c' m a := by
  apply List.ext_getElem (by simp [amap])
  intro k h₁ h₂
  rw [getElem_blockSwap]
  simp only [amap] at h₁ ⊢
  rw [getElem_setAct]
  cases h : Λ.actIdx k with
  | none =>
    have hn := Λ.actIdx_none h
    have o1 : ¬ (c ≤ k ∧ k < c + m) := by
      rintro ⟨h1, h2⟩
      exact hn (Fin.castAdd m ⟨k - c, by omega⟩) (by rw [hc]; simp; omega)
    have o2 : ¬ (c' ≤ k ∧ k < c' + m) := by
      rintro ⟨h1, h2⟩
      exact hn (Fin.natAdd m ⟨k - c', by omega⟩) (by rw [hc']; simp; omega)
    rw [bsIdx_out o1 o2, List.getD_eq_getElem]
  | some t =>
    have hk := Λ.actIdx_some h
    subst hk
    simp only
    induction t using Fin.addCases with
    | left i =>
      have e1 : (swapMat *ᵥ act Λ a) (Fin.castAdd m i) = act Λ a (Fin.natAdd m i) :=
        congrFun (hv_swapMat (act Λ a)) i
      rw [e1, val_act Λ ha, hc, hc', bsIdx_left hcc i.2]
    | right j =>
      have e1 : (swapMat *ᵥ act Λ a) (Fin.natAdd m j) = act Λ a (Fin.castAdd m j) :=
        congrFun (dv_swapMat (act Λ a)) j
      rw [e1, val_act Λ ha, hc, hc', bsIdx_right hcc j.2]

end SwapBlock

