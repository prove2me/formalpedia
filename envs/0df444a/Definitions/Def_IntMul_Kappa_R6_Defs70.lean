section
-- Source module: Solutions.J6SegAxA7
/-!
# `A`-line axis program (`AxisUA6`), part 7: assembly

**`AKerNeedA6 P`** (the numeric leaf of the `A` axis): eventually, for every axis, kernel
parameters satisfying `AKCond` (`J6SegAxA5`; `pk = 8p + 16`, `b = 17p + 40`, input bound
`p + 2`, `2^f = 8H`) and the nine non-set-up cost terms of `axACost` (six fine exposures, two
slab passes, the kernel run) each `≤ Cb · cU6 P n A / (D + 1)`.

**`axisUA6_of`**: `AxisUA6 P tab` from `FineU6 tab`, `PreA6 P 8 16 17 40 tab` (B4, the kernel
register set-up), `AStepNeed6 P` (A worker, the copy step and the descriptor set-ups) and
`AKerNeedA6 P`. The descriptor stack is `dA = 31` (`30` when the fine stack is `31`), the kernel
registers `ρK dF` (`10 … 29` without `dF`), the kernel `aKprog2` and the axis body are the
machine's own two procedures.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab

/-- **`AKerNeedA6 P`**: the kernel conditions and the cost terms of every `A` axis. -/
def AKerNeedA6 (P : Prm) : Prop :=
  ∃ (Cb : ℝ) (A n₁ : ℕ), 0 ≤ Cb ∧
  ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D,
    let p := pP6 P n; let s := src k; let t := tF6 P n k; let α := αN6 P n; let H := HA6 P n
    let pk := pkA6 8 16 p; let b := bA6 17 40 p; let w := p + 2
    let f := Nat.log 2 (IntMul.HvdH.sWidth p α) + 3
    let pre := preT P n D k; let post := postT P n D k; let M := t / (16 * H)
    let K := Cb * (cU6 P n A / (D + 1))
    ∃ (φ1 φ2 B BH Bk Lmax : ℕ) (Ka Kr Kc X0 : ℤ),
      AKCond p s t α H pk b w f pre post φ1 φ2 B BH Bk Lmax Ka Kr Kc X0 ∧
      cFine w 5 1 (pre * (t * post)) ≤ K ∧ cFine w 5 pre (t * post) ≤ K ∧
      cFine w 3 pre (M * (8 * H) * post) ≤ K ∧ cFine w 3 (pre * M) (8 * H * post) ≤ K ∧
      cFine w f (pre * (M * 8)) post ≤ K ∧ cFine (pk + 1) f (pre * (M * 8)) post ≤ K ∧
      (cSlabA (32 * t) (8 * (M * (8 * H))) post pre w
        (J6A.srcG s t H (J6A.WA p α H) M (8 * H)) : ℝ) ≤ K ∧
      (cSlabA (M * 8 * (8 * H)) t post pre (pk + 1) (J6A.srcC H (8 * H)) : ℝ) ≤ K ∧
      (kerC ⌊((KR.AK.cAK2 (2 * J6A.WA p α H) (2 * H) (8 * H) pk b φ1 φ2 B BH : ℕ) : ℝ) + 2⌋₊ Bk
        (2 ^ f) post Lmax (M * 8) (tabsT (aTabG p s t α H pk b) (M * 8)).length pre
        (2 * (pre * (M * 8) * post * 2 ^ f)) : ℝ) ≤ K

/-- The descriptor stack of the `A` axis program. -/
def dAA6 (dF : Fin HS) : Fin HS := if dF = 31 then 30 else 31

/-- The axis body. -/
def axABody {Pp : ℕ} (iDup i2u i2d i3u i3d i4u i4d i5u i5d i6u i6d i8u i8d iF iB iA iAd iK : Fin Pp)
    (dF : Fin HS) : IStmt HS Pp :=
  axAProg (.call iDup) (fxSt (.call i2u) (.call i2d) iF) (fxSt (.call i3u) (.call i3d) iB)
    (slSt (.call i4u) (.call i4d) (passP (.op (.drop 0)) (.op (.mv 0 Slab.rT)) itI (.op (.mv Slab.rT 0))))
    (fxSt (.call i5u) (.call i5d) iF) (fxSt (.call i6u) (.call i6d) iB)
    (kpSt iA iAd (ρK dF) KR.dT dF iF iB iK)
    (slSt (.call i8u) (.call i8d) (passP (.op (.drop 0)) (.op (.mv 0 Slab.rT)) itI (.op (.mv Slab.rT 0))))

/-- The machine's own procedures: the `A` kernel and the axis body. -/
def ownA (nF nP nS : ℕ) (eF eB : Fin nF) (eA eAd : Fin nP)
    (eDup e2u e2d e3u e3d e4u e4d e5u e5d e6u e6d e8u e8d : Fin nS) (dF : Fin HS) (E : ℕ)
    (idx : Fin (nF + (nP + nS) + 2) → Fin (7 + E)) (i : Fin 2) : IStmt HS (7 + E) :=
  let iF : Fin nF → Fin (7 + E) := fun j => idx (Fin.castAdd 2 (Fin.castAdd (nP + nS) j))
  let iP : Fin nP → Fin (7 + E) := fun j =>
    idx (Fin.castAdd 2 (Fin.natAdd nF (Fin.castAdd nS j)))
  let iS : Fin nS → Fin (7 + E) := fun j =>
    idx (Fin.castAdd 2 (Fin.natAdd nF (Fin.natAdd nP j)))
  if i.val = 0 then KR.AK.aKprog2 (NLogN.KFM.pMul E)
  else axABody (iS eDup) (iS e2u) (iS e2d) (iS e3u) (iS e3d) (iS e4u) (iS e4d) (iS e5u) (iS e5d)
    (iS e6u) (iS e6d) (iS e8u) (iS e8d) (iF eF) (iF eB) (iP eA) (iP eAd) (idx (Fin.natAdd _ 0)) dF

end J6Seg.Ax

end

