theorem colon {ι : Type*} (μ : ι → σ →₀ ℕ) (ν : σ →₀ ℕ)
    (hν : ∀ l, Disjoint ν.support (μ l).support) (a : ℝ) (ha : a ≠ 0)
    (c : MvPolynomial σ ℝ) (h : monomial ν a * c ∈ monIdeal μ) : c ∈ monIdeal μ := by
  classical
  rw [monIdeal_eq, mem_ideal_span_monomial_image] at h ⊢
  intro xi hxi
  have hm : ν + xi ∈ (monomial ν a * c).support := by
    rw [mem_support_iff, coeff_monomial_mul]
    exact mul_ne_zero ha (mem_support_iff.1 hxi)
  obtain ⟨_, ⟨l, rfl⟩, hl⟩ := h _ hm
  refine ⟨μ l, ⟨l, rfl⟩, ?_⟩
  rw [Finsupp.le_def] at hl ⊢
  intro v
  have hlv := hl v
  simp only [Finsupp.add_apply] at hlv
  by_cases hv : v ∈ (μ l).support
  · have : v ∉ ν.support := Finset.disjoint_right.1 (hν l) hv
    rw [Finsupp.notMem_support_iff] at this
    omega
  · rw [Finsupp.notMem_support_iff] at hv
    omega

