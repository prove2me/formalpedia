namespace GlobalTheory.InertZeta
theorem _root_.solution {u u' : GU σ (N + 2)} (hu : u ∈ radQ σ N) (hu' : u' ∈ radQ σ N)
    (h : rowOf u = rowOf u') : colOf u = colOf u' := funext fun i => by
