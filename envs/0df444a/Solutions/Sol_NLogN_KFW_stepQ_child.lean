  have hP : NLogN.KFW.PushSeq σ (NLogN.KFW.childPush h) (NLogN.KFW.childL K k e Bn h) (NLogN.KFW.cFrame 5 6 Bz) := by
    set σ1 := Function.update σ NLogN.KFW.vk (some (k : ℤ))
