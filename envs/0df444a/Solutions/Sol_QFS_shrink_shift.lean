end QFS

open QFS

variable {E : Type*} [NormedAddCommGroup E]

/-- Shrinking commutes with shifting. -/
lemma solution (S : Set E) (r : ℝ) (x : E) :
    QFS.shrink (QFS.shift S x) r = QFS.shift (QFS.shrink S r) x := by
  ext y
  simp only [QFS.mem_shrink, QFS.mem_shift, Set.subset_def, Metric.mem_closedBall, dist_eq_norm]
  constructor
  · rintro ⟨hy, hb⟩
    refine ⟨hy, fun z hz => ?_⟩
    have h1 : ‖z + x - y‖ ≤ r := by
      have he : z + x - y = z - (y - x) := by abel
      rw [he]; exact hz
    simpa using hb (z + x) h1
  · rintro ⟨hy, hb⟩
    refine ⟨hy, fun z hz => ?_⟩
    have h1 : ‖z - x - (y - x)‖ ≤ r := by
      have he : z - x - (y - x) = z - y := by abel
      rw [he]; exact hz
    exact hb (z - x) h1
