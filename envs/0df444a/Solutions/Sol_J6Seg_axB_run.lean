/-!
# B-line IL, B6 §3: pushing / dropping a descriptor by `dup` / `drop`, one axis step

* `dupsI rs dA`: `dup r dA` for `r ∈ rs` in order (`dups_run`: pushes the values, the last on
  top); `dropsI dA n`: `n` drops (`drops_run`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

section dd
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem dups_run (s : IState HS) (dA : Fin HS) (B : ℕ) :
    ∀ (rs : List (Fin HS)) (xs : List ℤ) (G : Fin HS → List ℤ), rs.length = xs.length →
      (∀ r ∈ rs, r ≠ dA) → (∀ i (h1 : i < rs.length) (h2 : i < xs.length),
        ∃ l, G (rs[i]) = xs[i] :: l) → (∀ x ∈ xs, zsz x ≤ B) →
      IRuns I iprog (dupsI dA rs) (encK s G) (encK s (update G dA (xs.reverse ++ G dA)))
        (rs.length * (300 * (B + 1)) + 1)
  | [], [], G, _, _, _, _ => by simpa [dupsI] using IRuns.skip (encK s G)
  | [], _ :: _, G, h, _, _, _ => by simp at h
  | _ :: _, [], G, h, _, _, _ => by simp at h
  | r :: rs, x :: xs, G, hl, hr, hv, hb => by
      obtain ⟨l, hl0⟩ := hv 0 (by simp) (by simp)
      simp only [List.getElem_cons_zero] at hl0
      have d1 := IRuns.dupK (I := I) (iprog := iprog) s (hr r (by simp)) hl0
      have ih := dups_run s dA B rs xs (update G dA (x :: G dA)) (by simpa using hl)
        (fun r' h => hr r' (by simp [h]))
        (fun i h1 h2 => by
          obtain ⟨l', hl'⟩ := hv (i + 1) (by simp; omega) (by simp; omega)
          simp only [List.getElem_cons_succ] at hl'
          refine ⟨l', ?_⟩
          rw [update_of_ne (hr _ (by simp))]; exact hl')
        (fun y hy => hb y (by simp [hy]))
      simp only [update_self, update_idem] at ih
      have hc := dupCost_le (zsz x)
      have hxB := hb x (by simp)
      refine (d1.seq ih).mono' (by simp) ?_
      simp only [List.length_cons]
      nlinarith

theorem drops_run (s : IState HS) (dA : Fin HS) (B : ℕ) :
    ∀ (xs R : List ℤ) (K : Fin HS → List ℤ), K dA = xs ++ R → (∀ x ∈ xs, zsz x ≤ B) →
      IRuns I iprog (dropsI dA xs.length) (encK s K) (encK s (update K dA R))
        (xs.length * (2 * B + 2) + 1)
  | [], R, K, h, _ => by
      simp only [List.nil_append] at h
      simpa [dropsI, ← h] using IRuns.skip (encK s K)
  | x :: xs, R, K, h, hb => by
      have d1 := IRuns.dropK (I := I) (iprog := iprog) s (G := K) (a := x) (l := xs ++ R)
        (by rw [h, List.cons_append])
      have ih := drops_run s dA B xs R (update K dA (xs ++ R)) (by simp)
        (fun y hy => hb y (by simp [hy]))
      simp only [update_idem] at ih
      have hxB := hb x (by simp)
      refine (d1.seq ih).mono ?_
      simp only [List.length_cons]
      nlinarith

end dd

end J6Seg

