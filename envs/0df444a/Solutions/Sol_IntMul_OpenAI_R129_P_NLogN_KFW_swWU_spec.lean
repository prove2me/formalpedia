theorem cost_absorb {u c Bb V : ℕ} {K D : ℝ} (hu : 1 ≤ u) (hK : 0 ≤ K) (hD0 : 0 ≤ D)
    (hov : ((Bb : ℝ) + 2) ^ 2 ≤ D * V)
    (hc : (c : ℝ) ≤ K * ((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 42)) :
    (((8 * 10 ^ 7 * (Bb + 2) ^ 2 + 1 + c + (4 * (2 * Bb + 2) + 1) : ℕ)) : ℝ)
      ≤ (K + 10 ^ 8 * D) * ((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 42) := by
  set x := (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 42)
