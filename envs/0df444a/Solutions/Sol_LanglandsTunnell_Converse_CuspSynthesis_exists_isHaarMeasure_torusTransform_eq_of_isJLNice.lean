open MeasureTheory

attribute [local instance] NumberField.Idele.ideleBorel NumberField.Idele.borelSpace_ideleBorel
  NumberField.Idele.isHaarMeasure_idelicHaar

private theorem t0436 {v : HeightOneSpectrum (𝓞 K)}
    {m : AdelicGL2 (𝓞 K) K} (hm : compAt v m = 1) (h : GL (Fin 2) (v.adicCompletion K)) :
    placeEmbed K v h * m = m * placeEmbed K v h := by
  refine t0018 ?_ fun w => ?_
  · rw [map_mul, map_mul, t0019, one_mul, mul_one]
  · rw [map_mul, map_mul]
    by_cases hw : w = v
    · subst hw
      rw [t0003, hm, one_mul, mul_one]
    · rw [t0004 hw, one_mul, mul_one]

private theorem t0437 (v : HeightOneSpectrum (𝓞 K)) (m : AdelicGL2 (𝓞 K) K) :
    compAt v (m * (placeEmbed K v (compAt v m))⁻¹) = 1 := by
  rw [map_mul, map_inv, t0003, mul_inv_cancel]

private theorem t0438 {v w : HeightOneSpectrum (𝓞 K)} (hw : w ≠ v)
    (m : AdelicGL2 (𝓞 K) K) : compAt w (m * (placeEmbed K v (compAt v m))⁻¹) = compAt w m := by
  rw [map_mul, map_inv, t0004 hw, inv_one, mul_one]

private theorem t0439 (dF : FinWhittakerDatum K S Pi) (A : AdelicGL2 (𝓞 K) K → ℂ)
    {m m' : AdelicGL2 (𝓞 K) K} (h : ∀ g : AdelicGL2 (𝓞 K) K, dF.Wf (g * m) = dF.Wf (g * m')) :
    d042 dF A m = d042 dF A m' := by
  funext g
  unfold d042
  rw [h g]

private theorem t0440 (W : AdelicGL2 (𝓞 K) K → ℂ)
    (δ : (AdeleRing (𝓞 K) K)ˣ) (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) (a : (AdeleRing (𝓞 K) K)ˣ) :
    zetaIntegrand W χ s (δ * a)
      = ((χ δ : ℂˣ) : ℂ) * ((ideleNorm K δ : ℝ) : ℂ) ^ (s - 1)
          * zetaIntegrand (fun y => W (diagOne δ * y)) χ s a := by
  simp only [zetaIntegrand, map_mul, Units.val_mul, ideleNorm_mul, Complex.ofReal_mul,
    Complex.mul_cpow_ofReal_nonneg (ideleNorm_pos δ).le (ideleNorm_pos a).le]
  ring

private theorem t0441 (W : AdelicGL2 (𝓞 K) K → ℂ)
    (δ : (AdeleRing (𝓞 K) K)ˣ) (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) :
    ∫ a, zetaIntegrand W χ s a ∂(NumberField.Idele.idelicHaar K)
      = ((χ δ : ℂˣ) : ℂ) * ((ideleNorm K δ : ℝ) : ℂ) ^ (s - 1)
          * ∫ a, zetaIntegrand (fun y => W (diagOne δ * y)) χ s a ∂(NumberField.Idele.idelicHaar K) := by
  rw [← integral_mul_left_eq_self (fun a => zetaIntegrand W χ s a) δ]
  simp only [t0440 W δ χ s]
  exact integral_const_mul _ _

private theorem t0442 (v : HeightOneSpectrum (𝓞 K)) (t : (v.adicCompletion K)ˣ)
    (x : v.adicCompletion K) :
    placeEmbed K v (unipotent x) * diagOne (d004 v t)
      = diagOne (d004 v t)
          * placeEmbed K v (unipotent (((t⁻¹ : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x)) := by
  rw [t0370, t0034, ← mul_assoc, Units.mul_inv, one_mul]

private theorem t0443 (v : HeightOneSpectrum (𝓞 K)) (t : (v.adicCompletion K)ˣ) (n : ℤ) :
    d004 v (t ^ n) = d004 v t ^ n :=
  map_zpow (d008 v) t n

private theorem t0444 {A : Type} [CommRing A] (t : Aˣ) (n : ℤ) :
    d007 (t ^ n) = d007 t ^ n := by
  unfold d007
  exact map_zpow _ t n

private theorem t0445 (dF : FinWhittakerDatum K S Pi)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (g : AdelicGL2 (𝓞 K) K) :
    dF.Wf (g * placeEmbed K v (d007 (uniformizerUnit K v))) = Pi.toRawCentral.b v * dF.Wf g := by
  have h := dF.central_eigen v hv g
  rw [t0037, t0031, t0074] at h
  rw [← t0074, t0067, t0074, h]

private theorem t0446 (dF : FinWhittakerDatum K S Pi)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (n : ℤ) (g : AdelicGL2 (𝓞 K) K) :
    dF.Wf (g * placeEmbed K v (d007 (uniformizerUnit K v)) ^ n) = Pi.toRawCentral.b v ^ n * dF.Wf g := by
  rcases eq_or_ne (Pi.toRawCentral.b v) 0 with hb | hb
  · have hzero : ∀ g' : AdelicGL2 (𝓞 K) K, dF.Wf g' = 0 := fun g' => by
      rw [← inv_mul_cancel_right g' (placeEmbed K v (d007 (uniformizerUnit K v))),
        t0445 dF hv, hb, zero_mul]
    rw [hzero, hzero, mul_zero]
  · induction n with
    | zero => rw [zpow_zero, zpow_zero, mul_one, one_mul]
    | succ i ih =>
      rw [zpow_add_one, ← mul_assoc, t0445 dF hv, ih, zpow_add_one₀ hb]
      ring
    | pred i ih =>
      have h := t0445 dF hv
        (g * placeEmbed K v (d007 (uniformizerUnit K v)) ^ (-(i : ℤ) - 1))
      rw [mul_assoc, ← zpow_add_one, sub_add_cancel, ih] at h
      rw [zpow_sub_one₀ hb, mul_comm _ (Pi.toRawCentral.b v)⁻¹, mul_assoc, eq_inv_mul_iff_mul_eq₀ hb]
      exact h.symm

private theorem t0447 (c : ℂ) (W : AdelicGL2 (𝓞 K) K → ℂ) (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ)
    (a : (AdeleRing (𝓞 K) K)ˣ) : zetaIntegrand (fun y => c * W y) χ s a = c * zetaIntegrand W χ s a := by
  simp only [zetaIntegrand]
  ring

private theorem t0448 (W : AdelicGL2 (𝓞 K) K → ℂ)
    (δ : (AdeleRing (𝓞 K) K)ˣ) (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) (a : (AdeleRing (𝓞 K) K)ˣ) :
    zetaIntegrand (fun y => W (y * diagOne δ)) χ s a = zetaIntegrand (fun y => W (diagOne δ * y)) χ s a := by
  simp only [zetaIntegrand]
  rw [← map_mul diagOne, mul_comm a δ, map_mul diagOne]

private theorem t0449 (c : ℂ) (V : AdelicGL2 (𝓞 K) K → ℂ)
    (δ : (AdeleRing (𝓞 K) K)ˣ) (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) :
    ∫ a, zetaIntegrand (fun y => c * V (y * diagOne δ)) χ s a ∂(NumberField.Idele.idelicHaar K)
      = ((χ δ⁻¹ : ℂˣ) : ℂ) * ((ideleNorm K δ⁻¹ : ℝ) : ℂ) ^ (s - 1) * c
          * ∫ a, zetaIntegrand V χ s a ∂(NumberField.Idele.idelicHaar K) := by
  have h2 : ∀ y : AdelicGL2 (𝓞 K) K, V (diagOne δ * (diagOne δ⁻¹ * y)) = V y := fun y => by
    rw [← mul_assoc, ← map_mul diagOne, mul_inv_cancel, map_one, one_mul]
  simp only [t0447 c (fun y => V (y * diagOne δ)),
    t0448 V δ χ s]
  rw [integral_const_mul,
    t0441 (fun y => V (diagOne δ * y)) δ⁻¹ χ s]
  simp only [h2]
  ring

private theorem t0450 (dF : FinWhittakerDatum K S Pi) {u : AdelicGL2 (𝓞 K) K}
    (hu : ∀ w : HeightOneSpectrum (𝓞 K),
      LocalWhittaker.IsIntegral Valued.v (compAt w u) ∧ LocalWhittaker.IsIntegral Valued.v (compAt w u)⁻¹)
    (g : AdelicGL2 (𝓞 K) K) : dF.Wf (g * u) = dF.Wf g := by
  have hfin : dF.Wf (g * u) = dF.Wf (g * finEmbed (𝓞 K) K (glFin (𝓞 K) K u)) :=
    dF.finite_dependent _ _ (by rw [map_mul, map_mul, glFin_finEmbed])
  rw [hfin]
  refine t0017 dF g (Subgroup.mem_inf.mpr
    ⟨?_, (mem_finiteAdelicGL2Subgroup_iff K _).mpr (glArch_finEmbed _ _ _)⟩)
  rw [mem_levelOne_iff, glFin_finEmbed, ← mem_levelOne_iff]
  refine CuspSynthesis.t0244 (fun w i j => ?_) (fun w i j => ?_)
  · exact (mem_adicCompletionIntegers _ _ _).mpr ((hu w).1 i j)
  · have h' : LocalWhittaker.IsIntegral Valued.v (compAt w u⁻¹) := by
      rw [map_inv]
      exact (hu w).2
    exact (mem_adicCompletionIntegers _ _ _).mpr (h' i j)

private theorem t0451 (dF : FinWhittakerDatum K S Pi)
    (T : Finset (HeightOneSpectrum (𝓞 K))) :
    T ⊆ S → ∀ u : AdelicGL2 (𝓞 K) K, (∀ w : HeightOneSpectrum (𝓞 K), w ∉ T →
        LocalWhittaker.IsIntegral Valued.v (compAt w u) ∧ LocalWhittaker.IsIntegral Valued.v (compAt w u)⁻¹) →
      ∀ g : AdelicGL2 (𝓞 K) K, dF.Wf (g * u) = dF.Wf g := by
  classical
  refine Finset.induction_on T ?_ ?_
  · intro _ u hu g
    exact t0450 dF (fun w => hu w (Finset.notMem_empty w)) g
  · intro w₁ T hw₁T ih hT u hu g
    have hw₁S : w₁ ∈ S := hT (Finset.mem_insert_self w₁ T)
    have hTS : T ⊆ S := fun w hw => hT (Finset.mem_insert_of_mem hw)
    have hu₁ : ∀ w : HeightOneSpectrum (𝓞 K), w ∉ T →
        LocalWhittaker.IsIntegral Valued.v (compAt w (u * (placeEmbed K w₁ (compAt w₁ u))⁻¹)) ∧
          LocalWhittaker.IsIntegral Valued.v (compAt w (u * (placeEmbed K w₁ (compAt w₁ u))⁻¹))⁻¹ := by
      intro w hwT
      by_cases hww : w = w₁
      · subst hww
        have h1 := t0433 w 1
        rw [map_one] at h1
        rw [t0437]
        exact h1
      · rw [t0438 hww]
        refine hu w ?_
        rw [Finset.mem_insert, not_or]
        exact ⟨hww, hwT⟩
    have hu_eq : u = u * (placeEmbed K w₁ (compAt w₁ u))⁻¹ * placeEmbed K w₁ (compAt w₁ u) :=
      (inv_mul_cancel_right u _).symm
    rw [hu_eq, ← mul_assoc, dF.blind_at w₁ hw₁S, ih hTS _ hu₁ g]

private theorem t0452 (dF : FinWhittakerDatum K S Pi)
    {u : AdelicGL2 (𝓞 K) K} (hu : ∀ w : HeightOneSpectrum (𝓞 K), w ∉ S →
      LocalWhittaker.IsIntegral Valued.v (compAt w u) ∧ LocalWhittaker.IsIntegral Valued.v (compAt w u)⁻¹)
    (g : AdelicGL2 (𝓞 K) K) : dF.Wf (g * u) = dF.Wf g :=
  t0451 dF S (fun _ hw => hw) u hu g

private theorem t0453 (dF : FinWhittakerDatum K S Pi) {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) {u : AdelicGL2 (𝓞 K) K} (hu : compAt v u = 1) {m : AdelicGL2 (𝓞 K) K}
    {x : v.adicCompletion K} {c n : ℤ} {k : GL (Fin 2) (Valued.v : Valuation (v.adicCompletion K) ℤᵐ⁰).integer}
    (hm : compAt v m
      = unipotent x
        * UnramifiedWhittaker.diagZ (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero c
        * UnramifiedWhittaker.scalarPi (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero ^ n
        * Matrix.GeneralLinearGroup.map (Valued.v.integer.subtype) k)
    (g : AdelicGL2 (𝓞 K) K) :
    d042 dF A m (g * u)
      = Pi.toRawCentral.b v ^ n
        * d042 dF A (m * (placeEmbed K v (compAt v m))⁻¹)
            (g * diagOne (d004 v (uniformizerUnit K v ^ c))
              * (u * placeEmbed K v (unipotent
                  (((uniformizerUnit K v ^ (-c) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x)))) := by
  have hP : placeEmbed K v (compAt v m)
      = placeEmbed K v (unipotent x) * diagOne (d004 v (uniformizerUnit K v ^ c))
        * placeEmbed K v (d007 (uniformizerUnit K v)) ^ n
        * placeEmbed K v (Matrix.GeneralLinearGroup.map (Valued.v.integer.subtype) k) := by
    rw [hm, map_mul, map_mul, map_mul, t0434, t0435, t0444,
      map_zpow (placeEmbed K v) (d007 (uniformizerUnit K v)) n, t0392]
  generalize hm₁def : m * (placeEmbed K v (compAt v m))⁻¹ = m₁
  have hsplit : m = m₁ * placeEmbed K v (compAt v m) := by
    rw [← hm₁def]
    exact (inv_mul_cancel_right m _).symm
  have hm₁ : compAt v m₁ = 1 := by
    rw [← hm₁def]
    exact t0437 v m
  have hk := t0433 v k
  have hint : ∀ z : AdelicGL2 (𝓞 K) K,
      dF.Wf (z * placeEmbed K v (Matrix.GeneralLinearGroup.map (Valued.v.integer.subtype) k)) = dF.Wf z :=
    fun z => t0012 dF v hk.1 hk.2 z
  have h1 : ∀ r : AdelicGL2 (𝓞 K) K,
      m₁ * (placeEmbed K v (unipotent x) * r) = placeEmbed K v (unipotent x) * (m₁ * r) :=
    fun r => by rw [← mul_assoc, ← t0436 hm₁, mul_assoc]
  have h2 : m₁ * diagOne (d004 v (uniformizerUnit K v ^ c))
      = diagOne (d004 v (uniformizerUnit K v ^ c)) * m₁ := by
    rw [t0392]
    exact (t0436 hm₁ _).symm
  have h3 : ∀ r : AdelicGL2 (𝓞 K) K, u * (diagOne (d004 v (uniformizerUnit K v ^ c)) * r)
      = diagOne (d004 v (uniformizerUnit K v ^ c)) * (u * r) := fun r => by
    rw [← mul_assoc, t0392, ← t0436 hu, mul_assoc]
  have h4 : ∀ r : AdelicGL2 (𝓞 K) K,
      placeEmbed K v (unipotent x) * (diagOne (d004 v (uniformizerUnit K v ^ c)) * r)
        = diagOne (d004 v (uniformizerUnit K v ^ c))
          * (placeEmbed K v (unipotent
              (((uniformizerUnit K v ^ (-c) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x)) * r) := fun r => by
    rw [← mul_assoc, zpow_neg, t0442, mul_assoc]
  have hgrp : g * u * m₁ * placeEmbed K v (unipotent x) * diagOne (d004 v (uniformizerUnit K v ^ c))
      = g * diagOne (d004 v (uniformizerUnit K v ^ c)) * u
        * placeEmbed K v (unipotent (((uniformizerUnit K v ^ (-c) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x))
        * m₁ := by
    simp only [mul_assoc]
    rw [h1, h2, h4, h3]
  have hwf : dF.Wf (g * u * m)
      = Pi.toRawCentral.b v ^ n
        * dF.Wf (g * diagOne (d004 v (uniformizerUnit K v ^ c))
            * (u * placeEmbed K v (unipotent
                (((uniformizerUnit K v ^ (-c) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x)))
            * m₁) := by
    rw [hsplit, hP]
    simp only [← mul_assoc]
    rw [hint, t0446 dF hv n, hgrp]
  have hcut : cutS S (g * diagOne (d004 v (uniformizerUnit K v ^ c))
      * (u * placeEmbed K v (unipotent
          (((uniformizerUnit K v ^ (-c) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x)))) = cutS S (g * u) := by
    refine t0363 fun w hw => ?_
    have hwv : w ≠ v := ne_of_mem_of_not_mem hw hv
    rw [t0392]
    simp only [map_mul, t0004 hwv, mul_one]
  have hA' : A (g * diagOne (d004 v (uniformizerUnit K v ^ c))
      * (u * placeEmbed K v (unipotent
          (((uniformizerUnit K v ^ (-c) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x)))) = A (g * u) := by
    refine hA _ _ ?_
    rw [t0392]
    simp only [map_mul, t0019, mul_one]
  unfold d042
  rw [hcut, hA', hwf]
  ring

private theorem t0454 (dF : FinWhittakerDatum K S Pi)
    {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) {u : AdelicGL2 (𝓞 K) K} (hu : compAt v u = 1) {m : AdelicGL2 (𝓞 K) K}
    {x : v.adicCompletion K} {c n : ℤ} {k : GL (Fin 2) (Valued.v : Valuation (v.adicCompletion K) ℤᵐ⁰).integer}
    (hm : compAt v m
      = unipotent x
        * UnramifiedWhittaker.diagZ (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero c
        * UnramifiedWhittaker.scalarPi (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero ^ n
        * Matrix.GeneralLinearGroup.map (Valued.v.integer.subtype) k)
    (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) :
    ∫ a, zetaIntegrand (fun y => d042 dF A m (y * u)) χ s a ∂(NumberField.Idele.idelicHaar K)
      = ((χ (d004 v (uniformizerUnit K v ^ (-c))) : ℂˣ) : ℂ)
          * ((ideleNorm K (d004 v (uniformizerUnit K v ^ (-c))) : ℝ) : ℂ) ^ (s - 1)
          * Pi.toRawCentral.b v ^ n
          * ∫ a, zetaIntegrand (fun y => d042 dF A (m * (placeEmbed K v (compAt v m))⁻¹)
              (y * (u * placeEmbed K v (unipotent
                (((uniformizerUnit K v ^ (-c) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x))))) χ s a
              ∂(NumberField.Idele.idelicHaar K) := by
  have hfun : (fun y => d042 dF A m (y * u))
      = fun y => Pi.toRawCentral.b v ^ n
          * d042 dF A (m * (placeEmbed K v (compAt v m))⁻¹)
              (y * diagOne (d004 v (uniformizerUnit K v ^ c))
                * (u * placeEmbed K v (unipotent
                    (((uniformizerUnit K v ^ (-c) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x)))) :=
    funext fun y => t0453 dF hA hv hu hm y
  rw [hfun, t0449 (Pi.toRawCentral.b v ^ n)
    (fun z => d042 dF A (m * (placeEmbed K v (compAt v m))⁻¹)
      (z * (u * placeEmbed K v (unipotent
        (((uniformizerUnit K v ^ (-c) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x)))))
    (d004 v (uniformizerUnit K v ^ c)) χ s, t0032, ← zpow_neg]

private theorem t0455 (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) (δ₁ δ₂ : (AdeleRing (𝓞 K) K)ˣ) :
    ((χ (δ₁ * δ₂) : ℂˣ) : ℂ) * ((ideleNorm K (δ₁ * δ₂) : ℝ) : ℂ) ^ (s - 1)
      = ((χ δ₁ : ℂˣ) : ℂ) * ((ideleNorm K δ₁ : ℝ) : ℂ) ^ (s - 1)
        * (((χ δ₂ : ℂˣ) : ℂ) * ((ideleNorm K δ₂ : ℝ) : ℂ) ^ (s - 1)) := by
  rw [map_mul, Units.val_mul, ideleNorm_mul, Complex.ofReal_mul,
    Complex.mul_cpow_ofReal_nonneg (ideleNorm_pos δ₁).le (ideleNorm_pos δ₂).le]
  ring

private theorem t0456 (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) :
    ∀ (L : List (HeightOneSpectrum (𝓞 K))) (f : HeightOneSpectrum (𝓞 K) → (AdeleRing (𝓞 K) K)ˣ),
      (L.map fun v => ((χ (f v) : ℂˣ) : ℂ) * ((ideleNorm K (f v) : ℝ) : ℂ) ^ (s - 1)).prod
        = ((χ (L.map f).prod : ℂˣ) : ℂ) * ((ideleNorm K (L.map f).prod : ℝ) : ℂ) ^ (s - 1)
  | [], _ => by
    simp only [List.map_nil, List.prod_nil, map_one, Units.val_one, ideleNorm_one, Complex.ofReal_one,
      Complex.one_cpow, mul_one]
  | v :: L, f => by
    rw [List.map_cons, List.prod_cons, List.map_cons, List.prod_cons, t0456 χ s L f,
      t0455]

private theorem t0457 (v : HeightOneSpectrum (𝓞 K)) :
    LocalWhittaker.IsIntegral Valued.v (1 : GL (Fin 2) (v.adicCompletion K)) ∧
      LocalWhittaker.IsIntegral Valued.v (1 : GL (Fin 2) (v.adicCompletion K))⁻¹ := by
  have h := t0433 v 1
  rw [map_one] at h
  exact h

private theorem t0458 (dF : FinWhittakerDatum K S Pi)
    {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g)
    (x : ∀ v : HeightOneSpectrum (𝓞 K), v.adicCompletion K) (c n : HeightOneSpectrum (𝓞 K) → ℤ)
    (k : ∀ v : HeightOneSpectrum (𝓞 K), GL (Fin 2) (Valued.v : Valuation (v.adicCompletion K) ℤᵐ⁰).integer) :
    ∀ L : List (HeightOneSpectrum (𝓞 K)), L.Nodup → (∀ v ∈ L, v ∉ S) →
      ∀ u m : AdelicGL2 (𝓞 K) K, (∀ v ∈ L, compAt v u = 1) →
        (∀ v ∈ L, compAt v m
          = unipotent (x v)
            * UnramifiedWhittaker.diagZ (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero (c v)
            * UnramifiedWhittaker.scalarPi (uniformizerUnit K v : v.adicCompletion K) (uniformizerUnit K v).ne_zero
                ^ n v
            * Matrix.GeneralLinearGroup.map (Valued.v.integer.subtype) (k v)) →
        ∃ m' : AdelicGL2 (𝓞 K) K, (∀ v ∈ L, compAt v m' = 1) ∧
          (∀ w : HeightOneSpectrum (𝓞 K), w ∉ L → compAt w m' = compAt w m) ∧
          ∀ (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ),
            ∫ a, zetaIntegrand (fun y => d042 dF A m (y * u)) χ s a ∂(NumberField.Idele.idelicHaar K)
              = (L.map fun v => ((χ (d004 v (uniformizerUnit K v ^ (-c v))) : ℂˣ) : ℂ)
                  * ((ideleNorm K (d004 v (uniformizerUnit K v ^ (-c v))) : ℝ) : ℂ) ^ (s - 1)).prod
                * (L.map fun v => Pi.toRawCentral.b v ^ n v).prod
                * ∫ a, zetaIntegrand (fun y => d042 dF A m' (y * (u * (L.map fun v => placeEmbed K v (unipotent
                    (((uniformizerUnit K v ^ (-c v) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x v))).prod)))
                    χ s a ∂(NumberField.Idele.idelicHaar K)
  | [], _, _, u, m, _, _ =>
    ⟨m, fun v hv => by simp at hv, fun _ _ => rfl, fun χ s => by
      simp only [List.map_nil, List.prod_nil, one_mul, mul_one]⟩
  | v :: L, hnd, hLS, u, m, hu, hm => by
    have hvL : v ∉ L := (List.nodup_cons.mp hnd).1
    have hv : v ∉ S := hLS v (List.mem_cons.mpr (Or.inl rfl))
    have huv : compAt v u = 1 := hu v (List.mem_cons.mpr (Or.inl rfl))
    have hmv := hm v (List.mem_cons.mpr (Or.inl rfl))
    have hu' : ∀ w ∈ L, compAt w (u * placeEmbed K v (unipotent
        (((uniformizerUnit K v ^ (-c v) : (v.adicCompletion K)ˣ) : v.adicCompletion K) * x v))) = 1 := by
      intro w hw
      have hwv : w ≠ v := fun h => hvL (h ▸ hw)
      rw [map_mul, hu w (List.mem_cons.mpr (Or.inr hw)), t0004 hwv, mul_one]
    have hm' : ∀ w ∈ L, compAt w (m * (placeEmbed K v (compAt v m))⁻¹)
        = unipotent (x w)
          * UnramifiedWhittaker.diagZ (uniformizerUnit K w : w.adicCompletion K) (uniformizerUnit K w).ne_zero (c w)
          * UnramifiedWhittaker.scalarPi (uniformizerUnit K w : w.adicCompletion K) (uniformizerUnit K w).ne_zero
              ^ n w
          * Matrix.GeneralLinearGroup.map (Valued.v.integer.subtype) (k w) := by
      intro w hw
      have hwv : w ≠ v := fun h => hvL (h ▸ hw)
      rw [t0438 hwv]
      exact hm w (List.mem_cons.mpr (Or.inr hw))
    obtain ⟨m', h1, h2, h3⟩ := t0458 dF hA x c n k L
      (List.nodup_cons.mp hnd).2 (fun w hw => hLS w (List.mem_cons.mpr (Or.inr hw))) _ _ hu' hm'
    refine ⟨m', fun w hw => ?_, fun w hw => ?_, fun χ s => ?_⟩
    · rcases List.mem_cons.mp hw with rfl | hw
      · rw [h2 _ hvL, t0437]
      · exact h1 w hw
    · have hwv : w ≠ v := fun h => hw (List.mem_cons.mpr (Or.inl h))
      have hwL : w ∉ L := fun h => hw (List.mem_cons.mpr (Or.inr h))
      rw [h2 w hwL, t0438 hwv]
    · rw [t0454 dF hA hv huv hmv χ s, h3 χ s, List.map_cons,
        List.prod_cons, List.map_cons, List.prod_cons, List.map_cons, List.prod_cons]
      simp only [mul_assoc]
      ring

private theorem t0459 (dF : FinWhittakerDatum K S Pi)
    {A : AdelicGL2 (𝓞 K) K → ℂ}
