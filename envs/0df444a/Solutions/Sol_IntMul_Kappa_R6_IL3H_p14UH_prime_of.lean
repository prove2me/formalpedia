theorem Z_lt : Z < 2 ^ Z := Nat.lt_two_pow_self

theorem Zc_le_pow : Zc c ≤ 2 ^ Z := by have := h.Zc_lt_Z; have := h.Z_lt; omega

theorem Wr_le_Zc : c.Wr + c.W + cLH c + c.m + c.Aw ≤ Zc c := by unfold Zc; omega

theorem pow3 : 2 ^ (3 * Z) = 2 ^ Z * 2 ^ Z * 2 ^ Z := by
