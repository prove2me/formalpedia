theorem IntMul.Kappa.R6.sp_jloop (P : Prm) (n : ℕ) (s : IState HS) (f : Fin HS → List ℤ) (Aa Bb : ℕ)
    (l25 l33 l34 l36 : List ℤ) (h48 : f 48 = []) (h49 : f 49 = []) (h50 : f 50 = [])
    (h25 : f 25 = (dP6 P n : ℤ) :: l25) (h33 : f 33 = (hN6 P n : ℤ) :: l33)
    (h34 : f 34 = (dpN6 P n : ℤ) :: l34) (h36 : f 36 = 1 :: l36)
    (hd : 1 ≤ dP6 P n) (hl : 2 ≤ ℓP6 P n) (hW : WinOK6 P n) (hAa : 2 ≤ Aa)
    (hcA : 2 ^ ℓP6 P n * 2 ^ ℓP6 P n ≤ Aa) (hPA : 2 * 2 ^ (ℓP6 P n * dP6 P n) ≤ Aa)
    (hsA : 8 * (dP6 P n + ℓP6 P n) ≤ Aa) (hB : Aa ^ 6 < 2 ^ Bb) :
    Sp jR (encK s f)
      (encK s (update (update (update f 36 ((PP6 P n (dP6 P n) : ℤ) :: l36)) 37
        (saL P n (dP6 P n) ++ f 37)) 38 (maL P n (dP6 P n) ++ f 38)))
      ((dP6 P n * (cJ (2 ^ ℓP6 P n) + 1) + 1) * kU Bb) := by sorry
