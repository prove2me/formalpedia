-- Source module: Solutions.J6SegILPreJ10
/-!
# B-line IL, `J` pre-table (B5-J), part 10: straight-line instruction lists

`Ins`: `a` (register assignment), `rd` (random read `dst := X[e]`), `pu` (push), `po` (pop), `en`
(`d := expNeg n k j`, the library program through `PreT.callC`). `Ins.run` is the effect on
`(v, c)`, `Ins.ok W N` the side conditions (values `≤ 2^W`, read lists of length `≤ N`), and
`Rn.insL`: a list of instructions runs as its `runL`, at cost `costL W N`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function IntMul.HvdH

inductive Ins where
  | a (i : Fin HS) (e : E)
  | rd (X : Fin HS) (e : E) (dst : Fin HS)
  | pu (X : Fin HS) (e : E)
  | po (X : Fin HS)
  | en (d n k j : Fin HS)

namespace Ins

def p : Ins → RS
  | a i e => .asg i e.ex
  | rd X e dst => .seq (.asg rIx e.ex) (rdAt X sTmp cRdC rIx dst)
  | pu X e => .push X e.ex
  | po X => .pop X
  | en d n k j => J6Seg.PreT.callC d (.reg n) (.reg k) (.reg j) (.lit 0) expNegP

def run : Ins → Vr × Cs → Vr × Cs
  | a i e, (v, c) => (update v i (e.den v), c)
  | rd X e dst, (v, c) => (update (update v rIx (e.den v)) dst ((c X).getD (e.den v).toNat 0), c)
  | pu X e, (v, c) => (v, update c X (e.den v :: c X))
  | po X, (v, c) => (v, update c X (c X).tail)
  | en d n k j, (v, c) => (update v d (expNeg (v n).toNat (v k).toNat (v j).toNat), c)

def ok (W N : ℕ) : Ins → Vr × Cs → Prop
  | a i e, (v, _) => i ∈ rg ∧ e.ok = true ∧ e.lb ≤ 2 ^ W ∧ |e.den v| ≤ 2 ^ W
  | rd X e dst, (v, c) => X ∉ rg ∧ X.val < 56 ∧ X ≠ sTmp ∧ X ≠ cRdC ∧ dst ∈ rg ∧ dst ≠ rIx ∧
      e.ok = true ∧ e.lb ≤ 2 ^ W ∧ 0 ≤ e.den v ∧ e.den v < (c X).length ∧ (c X).length ≤ N ∧
      ∀ x ∈ c X, |x| ≤ 2 ^ W
  | pu X e, (v, _) => X ∉ rg ∧ X.val < 56 ∧ e.ok = true ∧ e.lb ≤ 2 ^ W
  | po X, (_, c) => X ∉ rg ∧ X.val < 56 ∧ c X ≠ [] ∧ |(c X).headD 0| ≤ 2 ^ W
  | en d n k j, (v, _) => d ∈ rg ∧ n ∈ rg ∧ k ∈ rg ∧ j ∈ rg ∧ 0 ≤ v n ∧ 0 ≤ v k ∧ 0 ≤ v j ∧
      (v n).toNat ≤ W + 1 ∧ |expNeg (v n).toNat (v k).toNat (v j).toNat| ≤ 2 ^ W

/-- The cost of an `expNeg` call at width `W`. -/
def cEn (W : ℕ) : ℕ :=
  J6Seg.PreT.cCall (.reg 0) (.reg 0) (.reg 0) (.lit 0) (W + 1) (expNegCost (W + 1) (W + 1) (W + 1))

def cost (W N : ℕ) : Ins → ℕ
  | a _ e => cT e.ex W
  | rd _ e _ => cT e.ex W + cRd N (W + 1)
  | pu _ e => cT e.ex W
  | po _ => 2 * (W + 1) + 2
  | en .. => cEn W

end Ins

/-! ## Lists of instructions -/

def progL : List Ins → RS
  | [] => .skip
  | i :: l => .seq i.p (progL l)

def runL : List Ins → Vr × Cs → Vr × Cs
  | [], st => st
  | i :: l, st => runL l (i.run st)

def OkL (W N : ℕ) : List Ins → Vr × Cs → Prop
  | [], _ => True
  | i :: l, st => i.ok W N st ∧ OkL W N l (i.run st)

def costL (W N : ℕ) : List Ins → ℕ
  | [] => 1
  | i :: l => i.cost W N + costL W N l

end J6Seg.PJ

end

