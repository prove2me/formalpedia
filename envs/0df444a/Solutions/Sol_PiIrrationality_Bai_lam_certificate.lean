/-- The table `rows` is admissible and ordered, and `λ_{10^16}(rows) ≥ ω₀ = 1202.5657733612916`. -/
theorem lam_certificate :
    ∃ L : List (ℕ × ℕ × ℕ × ℕ × ℕ), L.all PiIrrationality.Bai.okRow = true ∧
      PiIrrationality.Bai.chainOk L = true ∧
      (1202.5657733612916 : ℝ) ≤ PiIrrationality.Bai.lam L (10 ^ 16) := by
  refine ⟨rows, rows_ok, rows_chain, ?_⟩
  have h := lam_ge
  have e : PiIrrationality.Bai.lam rows (10 ^ 16) = lam (10 ^ 16) := rfl
  rw [e]
  have c : (1202.5657733612916 : ℝ) = 12025657733612916 / 10 ^ 13 := by norm_num
  rw [c]
  exact h

end PiIrrationality.BaiPhi

theorem solution :
    ∃ L : List (ℕ × ℕ × ℕ × ℕ × ℕ), L.all PiIrrationality.Bai.okRow = true ∧
