namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## The register file of the chunk kernel -/

/-! ## Moving the parameters into the base state -/

/-! ## Entry bound of a record product -/

theorem kmulD_bnd_sol_aux {b r p Δ : ℕ} (hb : 1 ≤ b) (hbig : 2 * r * 2 ^ (2 * p) < 2 ^ (b - 1))
    {zx zy : List GI} (hzx : ∀ z ∈ zx, |z.1| ≤ 2 ^ p ∧ |z.2| ≤ 2 ^ p)
    (hzy : ∀ z ∈ zy, |z.1| ≤ 2 ^ p ∧ |z.2| ≤ 2 ^ p) : GB (b + 2) (kmulD r Δ zx zy) := by
  set c : ℤ := 2 ^ p with hc
  set H : ℤ := 2 ^ (b - 1) with hHdef
  have hBH : (2 : ℤ) ^ b = 2 * H := two_pow_pred hb
  have hbigZ : (2 : ℤ) * r * 2 ^ (2 * p) < H := by rw [hHdef]; exact_mod_cast hbig
  have hcp : (0 : ℤ) < c := by positivity
  have hc2 : c * c = 2 ^ (2 * p) := by rw [hc, ← pow_add]; ring_nf
  have hcnv : ∀ (u v : ℕ → ℤ), (∀ i, |u i| ≤ c) → (∀ i, |v i| ≤ c) → ∀ j,
      |Synth.cnv r u v j| ≤ r * 2 ^ (2 * p) := by
    intro u v hu hv j
    have := Synth.abs_cnv_le (r := r) hu hv j
    rwa [hc2] at this
  have fa : ∀ i, |reF zx i| ≤ c := fun i =>
    getD_mem_bnd (P := fun z : GI => |z.1| ≤ c) (fun z hz => (hzx z hz).1) (by simp; positivity) i
  have fb : ∀ i, |imF zx i| ≤ c := fun i =>
    getD_mem_bnd (P := fun z : GI => |z.2| ≤ c) (fun z hz => (hzx z hz).2) (by simp; positivity) i
  have fc : ∀ i, |reF zy i| ≤ c := fun i =>
    getD_mem_bnd (P := fun z : GI => |z.1| ≤ c) (fun z hz => (hzy z hz).1) (by simp; positivity) i
  have fe : ∀ i, |imF zy i| ≤ c := fun i =>
    getD_mem_bnd (P := fun z : GI => |z.2| ≤ c) (fun z hz => (hzy z hz).2) (by simp; positivity) i
  have hReb : ∀ j, -H ≤ hRe r zx zy j ∧ hRe r zx zy j < H := by
    intro j
    have h1 := hcnv _ _ fa fc j
    have h2 := hcnv _ _ fb fe j
    have := abs_sub (Synth.cnv r (reF zx) (reF zy) j) (Synth.cnv r (imF zx) (imF zy) j)
    have h3 : |hRe r zx zy j| < H := by unfold hRe; linarith
    exact ⟨by linarith [neg_abs_le (hRe r zx zy j)], lt_of_le_of_lt (le_abs_self _) h3⟩
  have hImb : ∀ j, -H ≤ hIm r zx zy j ∧ hIm r zx zy j < H := by
    intro j
    have h1 := hcnv _ _ fa fe j
    have h2 := hcnv _ _ fb fc j
    have := abs_add_le (Synth.cnv r (reF zx) (imF zy) j) (Synth.cnv r (imF zx) (reF zy) j)
    have h3 : |hIm r zx zy j| < H := by unfold hIm; linarith
    exact ⟨by linarith [neg_abs_le (hIm r zx zy j)], lt_of_le_of_lt (le_abs_self _) h3⟩
  have hfdt : ∀ x y : ℤ, -H ≤ x ∧ x < H → -H ≤ y ∧ y < H → zsz (fdt Δ x y) ≤ b + 2 := by
    intro x y hx hy
    refine le_trans (KFH.zsz_tdiv_le _ _) (NLogN.zsz_le_of_abs ?_)
    have : (2 : ℤ) * H < 2 ^ (b + 2) := by
      rw [pow_add, hBH]; nlinarith [pow_pos (two_pos : (0 : ℤ) < 2) (b - 1)]
    rw [abs_lt]; constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]
  intro z hz
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.1 hz
  have hj' : j < r := by simpa [kmulD] using hj
  simp only [kmulD, List.getElem_zip, List.getElem_map, List.getElem_range]
  exact ⟨hfdt _ _ (hReb _) (hReb _), hfdt _ _ (hImb _) (hImb _)⟩

