variable (v : HeightOneSpectrum (𝓞 ℚ))
variable {mT : MeasurableSpace (v.adicCompletion ℚ)ˣ} {mA : MeasurableSpace (v.adicCompletion ℚ)}
variable (μ : Measure (v.adicCompletion ℚ)ˣ) (ν : Measure (v.adicCompletion ℚ))

private theorem isLocalZeta31ConvergentAbove_comp_mul_left_iff
    (hprod : ∀ (u : (v.adicCompletion ℚ)ˣ) {c : (v.adicCompletion ℚ)ˣ},
      TateLocal.modulus (c : v.adicCompletion ℚ) = 1 →
      ∀ F : (v.adicCompletion ℚ)ˣ × v.adicCompletion ℚ → ℂ,
        Integrable (fun p => F (u * p.1, (c : v.adicCompletion ℚ) * p.2)) (μ.prod ν) ↔ Integrable F (μ.prod ν))
    (F : LocalGL3 v → ℂ) (χ : (v.adicCompletion ℚ)ˣ →* ℂˣ) {D : LocalGL3 v} {c : (v.adicCompletion ℚ)ˣ}
    (hc : TateLocal.modulus (c : v.adicCompletion ℚ) = 1)
    (hD : ∀ (y : (v.adicCompletion ℚ)ˣ) (x : v.adicCompletion ℚ),
      D * (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x) =
        iotaGL (diagUnitGL2 y) * lowerUnipotent21 ((c : v.adicCompletion ℚ) * x) * D)
    (q : LocalGL3 v) (σ₀ : ℝ) :
    IsLocalZeta31ConvergentAbove v μ ν (fun h => F (D * h)) χ q σ₀ ↔
      IsLocalZeta31ConvergentAbove v μ ν F χ (D * q) σ₀ := by
  have hpt : ∀ (y : (v.adicCompletion ℚ)ˣ) (x : v.adicCompletion ℚ),
      D * (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * q) =
        iotaGL (diagUnitGL2 y) * lowerUnipotent21 ((c : v.adicCompletion ℚ) * x) * (D * q) := by
    intro y x
    rw [← mul_assoc, hD y x, mul_assoc]
  simp only [IsLocalZeta31ConvergentAbove]
  refine forall_congr' fun s => imp_congr_right fun _ => ?_
  convert hprod 1 hc (fun p : (v.adicCompletion ℚ)ˣ × v.adicCompletion ℚ =>
    F (iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 * (D * q)) * ((χ p.1 : ℂˣ) : ℂ) *
      ((TateLocal.modulus (p.1 : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1)) using 2
  funext p
  simp only [one_mul, hpt]

private theorem isLocalZeta31ConvergentAbove_glScalar_mul_iff (F : LocalGL3 v → ℂ) (χ : (v.adicCompletion ℚ)ˣ →* ℂˣ)
    {z : (v.adicCompletion ℚ)ˣ} {C : ℂ} (hC : C ≠ 0)
    (hF : ∀ X : LocalGL3 v, F (Matrix.GeneralLinearGroup.scalar (Fin 3) z * X) = C * F X) (q : LocalGL3 v) (σ₀ : ℝ) :
    IsLocalZeta31ConvergentAbove v μ ν F χ (Matrix.GeneralLinearGroup.scalar (Fin 3) z * q) σ₀ ↔
      IsLocalZeta31ConvergentAbove v μ ν F χ q σ₀ := by
  have hpoint : ∀ (y : (v.adicCompletion ℚ)ˣ) (x : v.adicCompletion ℚ),
      iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * (Matrix.GeneralLinearGroup.scalar (Fin 3) z * q) =
        Matrix.GeneralLinearGroup.scalar (Fin 3) z * (iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * q) := by
    intro y x
    rw [← mul_assoc, ← ScalarComponents.glScalar_mul_comm, mul_assoc]
  simp only [IsLocalZeta31ConvergentAbove]
  refine forall_congr' fun s => imp_congr_right fun _ => ?_
  convert integrable_const_mul_iff (IsUnit.mk0 C hC) (fun p : (v.adicCompletion ℚ)ˣ × v.adicCompletion ℚ =>
    F (iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 * q) * ((χ p.1 : ℂˣ) : ℂ) *
      ((TateLocal.modulus (p.1 : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1)) using 2
  funext p
  simp only [hpoint, hF]
  ring

private theorem isLocalZeta31ConvergentAbove_iotaGL_diagUnitGL2_mul_iff
    (hprod : ∀ (u : (v.adicCompletion ℚ)ˣ) {c : (v.adicCompletion ℚ)ˣ},
      TateLocal.modulus (c : v.adicCompletion ℚ) = 1 →
      ∀ F : (v.adicCompletion ℚ)ˣ × v.adicCompletion ℚ → ℂ,
        Integrable (fun p => F (u * p.1, (c : v.adicCompletion ℚ) * p.2)) (μ.prod ν) ↔ Integrable F (μ.prod ν))
    (F : LocalGL3 v → ℂ) (χ : (v.adicCompletion ℚ)ˣ →* ℂˣ) {b : (v.adicCompletion ℚ)ˣ}
    (hb : TateLocal.modulus (b : v.adicCompletion ℚ) = 1) (q : LocalGL3 v) (σ₀ : ℝ) :
    IsLocalZeta31ConvergentAbove v μ ν F χ (iotaGL (diagUnitGL2 b) * q) σ₀ ↔
      IsLocalZeta31ConvergentAbove v μ ν F χ q σ₀ := by
  have hmb : TateLocal.modulus ((b⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = 1 := modulus_coe_inv_eq_one hb
  have hpt : ∀ (y : (v.adicCompletion ℚ)ˣ) (x : v.adicCompletion ℚ),
      iotaGL (diagUnitGL2 y) * lowerUnipotent21 x * (iotaGL (diagUnitGL2 b) * q) =
        iotaGL (diagUnitGL2 (b * y)) * lowerUnipotent21 ((b : v.adicCompletion ℚ) * x) * q := by
    intro y x
    rw [← mul_assoc, mul_assoc (iotaGL (diagUnitGL2 y)), lowerUnipotent21_mul_iotaGL_diagUnitGL2, ← mul_assoc,
      ← TorusPoints.iotaGL_diagUnitGL2_mul, mul_comm y b]
  simp only [IsLocalZeta31ConvergentAbove]
  refine forall_congr' fun s => imp_congr_right fun _ => ?_
  have h1 : Integrable (fun p : (v.adicCompletion ℚ)ˣ × v.adicCompletion ℚ =>
        F (iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 * (iotaGL (diagUnitGL2 b) * q)) * ((χ p.1 : ℂˣ) : ℂ) *
          ((TateLocal.modulus (p.1 : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1)) (μ.prod ν) ↔
      Integrable (fun p : (v.adicCompletion ℚ)ˣ × v.adicCompletion ℚ =>
        F (iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 * q) * ((χ (b⁻¹ * p.1) : ℂˣ) : ℂ) *
          ((TateLocal.modulus (((b⁻¹ * p.1 : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)) : ℝ) : ℂ) ^ (s - 1))
        (μ.prod ν) := by
    convert hprod b hb (fun p : (v.adicCompletion ℚ)ˣ × v.adicCompletion ℚ =>
      F (iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 * q) * ((χ (b⁻¹ * p.1) : ℂˣ) : ℂ) *
        ((TateLocal.modulus (((b⁻¹ * p.1 : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)) : ℝ) : ℂ) ^ (s - 1))
      using 2
    funext p
    simp only [hpt, inv_mul_cancel_left]
  refine h1.trans ?_
  convert integrable_const_mul_iff (IsUnit.mk0 _ (Units.ne_zero (χ b⁻¹)))
    (fun p : (v.adicCompletion ℚ)ˣ × v.adicCompletion ℚ =>
      F (iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 * q) * ((χ p.1 : ℂˣ) : ℂ) *
        ((TateLocal.modulus (p.1 : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1)) using 2
  funext p
  rw [map_mul, Units.val_mul, Units.val_mul, TateLocal.modulus_mul, hmb, one_mul]
  ring

end
