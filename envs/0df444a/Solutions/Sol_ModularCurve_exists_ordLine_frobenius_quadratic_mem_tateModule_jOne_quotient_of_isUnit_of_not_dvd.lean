theorem es_pi_eq
    (Λ : (letI := heckeModuleOneBar M; ↥(rationalHeckeAlgebraOne p (JOne M))) →+* K)
    (a d : O)
    (ha : (letI := heckeModuleOneBar M; Λ (rationalHeckeOne p (JOne M) ⟨p, Fact.out⟩)) = algebraMap O K a)
    (hd : (letI := heckeModuleOneBar M; Λ (rationalDiamondOne p (JOne M) p)) * algebraMap O K d = 1)
    (W : Type) [AddCommGroup W] [Module K W]
    (r : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → (W →ₗ[K] W))
    (π : K ⊗[ℤ_[p]] TateModule p (JOne M) →ₗ[K] W)
