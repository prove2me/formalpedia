                                                         ( (repeat
                                                               ((with_reducible rename Light.SameOn _ _ _ => h_m5);
                                                                 (try have := h_m5 x_m3 (by omega)); (revert h_m5)))
                                                           (intros)
                                                           (try simp only [Function.update_apply, Light.wrote] at *)); (omega))
