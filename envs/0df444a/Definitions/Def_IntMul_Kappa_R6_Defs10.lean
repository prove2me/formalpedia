-- Source module: NLogN.Logic
/-!
# Program logic for stack programs

`Runs I prog s σ σ' c`: `s` takes `σ` to `σ'` with cost at most `c`.  Besides the rules for each
statement this file provides

* `caseTops`: branch on the tops of several stacks (constant cost);
* `opsStmt`: straight-line lists of primitive operations;
* `machine`: a finite-state transducer whose state lives on a dedicated stack; its correctness
  reduces to iterating a plain Lean function `mstep`.
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

namespace Runs

theorem mono {s : Stmt S P} {σ σ' : St S} {c c' : ℕ} (h : Runs I prog s σ σ' c) (hc : c ≤ c') :
    Runs I prog s σ σ' c' := by
  obtain ⟨d, hd, h⟩ := h; exact ⟨d, by omega, h⟩

theorem mono' {s : Stmt S P} {σ σ' σ'' : St S} {c c' : ℕ} (h : Runs I prog s σ σ' c)
    (he : σ' = σ'') (hc : c ≤ c') : Runs I prog s σ σ'' c' := he ▸ h.mono hc

theorem skip (σ : St S) : Runs I prog .skip σ σ 1 := ⟨1, le_rfl, .skip σ⟩
theorem push (σ : St S) (i a) : Runs I prog (.push i a) σ (σ.push i a) 1 := ⟨1, le_rfl, .push σ i a⟩
theorem pop (σ : St S) (i) : Runs I prog (.pop i) σ (σ.pop i) 1 := ⟨1, le_rfl, .pop σ i⟩
theorem inRd (σ : St S) (i) : Runs I prog (.inRd i) σ (σ.inRd I i) 1 := ⟨1, le_rfl, .inRd σ i⟩
theorem out (σ : St S) (b) : Runs I prog (.out b) σ (σ.outB b) 1 := ⟨1, le_rfl, .out σ b⟩

theorem seq {p q : Stmt S P} {σ σ₁ σ₂ : St S} {c₁ c₂ : ℕ} (h₁ : Runs I prog p σ σ₁ c₁)
    (h₂ : Runs I prog q σ₁ σ₂ c₂) : Runs I prog (.seq p q) σ σ₂ (c₁ + c₂) := by
  obtain ⟨d₁, hd₁, h₁⟩ := h₁; obtain ⟨d₂, hd₂, h₂⟩ := h₂
  exact ⟨d₁ + d₂, by omega, .seq h₁ h₂⟩

theorem iteT {i f} {p q : Stmt S P} {σ σ' : St S} {c : ℕ} (hf : f (σ.top i) = true)
    (h : Runs I prog p σ σ' c) : Runs I prog (.ite i f p q) σ σ' (c + 1) := by
  obtain ⟨d, hd, h⟩ := h; exact ⟨d + 1, by omega, .iteT hf h⟩

theorem iteF {i f} {p q : Stmt S P} {σ σ' : St S} {c : ℕ} (hf : f (σ.top i) = false)
    (h : Runs I prog q σ σ' c) : Runs I prog (.ite i f p q) σ σ' (c + 1) := by
  obtain ⟨d, hd, h⟩ := h; exact ⟨d + 1, by omega, .iteF hf h⟩

theorem call {j : Fin P} {σ σ' : St S} {c : ℕ} (h : Runs I prog (prog j) σ σ' c) :
    Runs I prog (.call j) σ σ' (c + 2) := by
  obtain ⟨d, hd, h⟩ := h; exact ⟨d + 2, by omega, .call h⟩

theorem loopF {i f} {p : Stmt S P} {σ : St S} (hf : f (σ.top i) = false) :
    Runs I prog (.loop i f p) σ σ 1 := ⟨1, le_rfl, .loopF hf⟩

/-- A loop running through the states `σs 0, σs 1, …, σs m`. -/
theorem loop {i f} {p : Stmt S P} (σs : ℕ → St S) (cs : ℕ → ℕ) (m : ℕ)
    (hT : ∀ k < m, f ((σs k).top i) = true) (hF : f ((σs m).top i) = false)
    (hb : ∀ k < m, Runs I prog p (σs k) (σs (k + 1)) (cs k)) :
    Runs I prog (.loop i f p) (σs 0) (σs m) ((∑ k ∈ Finset.range m, (cs k + 1)) + 1) := by
  suffices H : ∀ r j, j + r = m → Runs I prog (.loop i f p) (σs j) (σs m)
      ((∑ k ∈ Finset.Ico j m, (cs k + 1)) + 1) by
    have := H m 0 (by omega)
    rwa [Finset.range_eq_Ico]
  intro r
  induction r with
  | zero => intro j hj; subst hj; simpa using loopF hF
  | succ r ih =>
    intro j hj
    have hjm : j < m := by omega
    obtain ⟨d₁, hd₁, h₁⟩ := hb j hjm
    obtain ⟨d₂, hd₂, h₂⟩ := ih (j + 1) (by omega)
    refine ⟨d₁ + d₂ + 1, ?_, .loopT (hT j hjm) h₁ h₂⟩
    rw [Finset.sum_eq_sum_Ico_succ_bot hjm]
    omega

/-- Loop with a uniform bound on the cost of each iteration. -/
theorem loop' {i f} {p : Stmt S P} (σs : ℕ → St S) (c m : ℕ)
    (hT : ∀ k < m, f ((σs k).top i) = true) (hF : f ((σs m).top i) = false)
    (hb : ∀ k < m, Runs I prog p (σs k) (σs (k + 1)) c) :
    Runs I prog (.loop i f p) (σs 0) (σs m) (m * (c + 1) + 1) := by
  have := loop σs (fun _ => c) m hT hF hb
  simpa [Finset.sum_const, Finset.card_range, smul_eq_mul] using this

end Runs

/-! ## Branching on stack tops -/

theorem Runs.caseList {i : Fin S} {k : Option Sym → Stmt S P} {σ σ' : St S} {c : ℕ} {a : Sym}
    (ha : σ.top i = some a) (h : Runs I prog (k (some a)) σ σ' c) :
    ∀ l : List Sym, a ∈ l → Runs I prog (NLogN.caseList i k l) σ σ' (c + l.length) := by
  intro l hl
  induction l with
  | nil => simp at hl
  | cons b l ih =>
    simp only [NLogN.caseList, List.length_cons]
    by_cases hb : a = b
    · subst hb
      exact (Runs.iteT (by simp [ha]) h).mono (by omega)
    · have hl' : a ∈ l := by simpa [hb] using hl
      exact (Runs.iteF (by simp [ha, hb]) (ih hl')).mono (by omega)

theorem Runs.caseTop {i : Fin S} {k : Option Sym → Stmt S P} {σ σ' : St S} {c : ℕ}
    (h : Runs I prog (k (σ.top i)) σ σ' c) : Runs I prog (NLogN.caseTop i k) σ σ' (c + 17) := by
  unfold NLogN.caseTop
  rcases ht : σ.top i with _ | a
  · rw [ht] at h; exact (Runs.iteT (by simp [ht]) h).mono (by omega)
  · rw [ht] at h
    have := Runs.caseList ht h (List.finRange 16) (List.mem_finRange a)
    exact (Runs.iteF (by simp [ht]) this).mono (by simp)

theorem Runs.caseTops {σ σ' : St S} {c : ℕ} :
    ∀ (w : List (Fin S)) (k : List (Option Sym) → Stmt S P),
      Runs I prog (k (σ.tops w)) σ σ' c →
        Runs I prog (NLogN.caseTops w k) σ σ' (c + 17 * w.length)
  | [], k, h => by simpa [NLogN.caseTops, St.tops] using h
  | i :: w, k, h => by
    simp only [NLogN.caseTops, List.length_cons]
    have := Runs.caseTops w (fun os => k (σ.top i :: os)) (by simpa [St.tops] using h)
    exact (Runs.caseTop this).mono (by ring_nf; omega)

/-! ## Straight-line operations -/

theorem Runs.op (o : Op S) (σ : St S) : Runs I prog (o.stmt : Stmt S P) σ (o.run I σ) 1 := by
  cases o <;> simp only [Op.stmt, Op.run]
  · exact Runs.push _ _ _
  · exact Runs.pop _ _
  · exact Runs.inRd _ _
  · exact Runs.out _ _

theorem Runs.ops : ∀ (l : List (Op S)) (σ : St S),
    Runs I prog (opsStmt l : Stmt S P) σ (runOps I l σ) (l.length + 1)
  | [], σ => by simpa [opsStmt, runOps] using Runs.skip σ
  | o :: l, σ => by
    simp only [opsStmt, runOps, List.length_cons]
    exact (Runs.seq (Runs.op o σ) (Runs.ops l _)).mono (by omega)

/-! ## Finite-state transducers -/

theorem Runs.machine {q : Fin S} {w : List (Fin S)} {q0 : Sym}
    {δ : List (Option Sym) → List (Op S)} (B : ℕ) (hB : ∀ os, (δ os).length ≤ B)
    (σ : St S) (m : ℕ)
    (hrun : ∀ k < m, ((mstep I q w δ)^[k] (σ.push q q0)).top q ≠ some hlt)
    (hstop : ((mstep I q w δ)^[m] (σ.push q q0)).top q = some hlt) :
    Runs I prog (NLogN.machine q w q0 δ : Stmt S P) σ
      (((mstep I q w δ)^[m] (σ.push q q0)).pop q) (m * (B + 17 * w.length + 19) + 3) := by
  unfold NLogN.machine
  have hl := Runs.loop' (I := I) (prog := prog) (i := q) (f := fun o => decide (o ≠ some hlt))
    (p := NLogN.caseTops (q :: w) fun os => opsStmt (δ os))
    (fun k => (mstep I q w δ)^[k] (σ.push q q0)) (B + 17 * w.length + 18) m
    (fun k hk => by simpa using hrun k hk) (by simpa using hstop) (fun k _ => by
      rw [Function.iterate_succ_apply']
      have := Runs.ops (I := I) (prog := prog) (δ (((mstep I q w δ)^[k] (σ.push q q0)).tops
        (q :: w))) ((mstep I q w δ)^[k] (σ.push q q0))
      have h2 := Runs.caseTops (I := I) (prog := prog) (q :: w) (fun os => opsStmt (δ os)) this
      refine h2.mono ?_
      have := hB (((mstep I q w δ)^[k] (σ.push q q0)).tops (q :: w))
      simp only [List.length_cons]; omega)
  simp only [Function.iterate_zero, id] at hl
  have := Runs.seq (Runs.push (I := I) (prog := prog) σ q q0)
    (Runs.seq hl (Runs.pop (I := I) (prog := prog) _ q))
  exact this.mono (by ring_nf; omega)

end NLogN

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

end NLogN

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

namespace Reaches

variable {q : Fin S} {w : List (Fin S)} {δ : List (Option Sym) → List (Op S)}

theorem refl (σ : St S) : Reaches I q w δ σ σ 0 := ⟨rfl, fun _ h => absurd h (by omega)⟩

theorem step {σ σf : St S} {m : ℕ} (h : σ.top q ≠ some hlt)
    (h' : Reaches I q w δ (mstep I q w δ σ) σf m) : Reaches I q w δ σ σf (m + 1) := by
  refine ⟨by rw [Function.iterate_succ_apply]; exact h'.1, fun k hk => ?_⟩
  rcases k with _ | k
  · simpa using h
  · rw [Function.iterate_succ_apply]; exact h'.2 k (by omega)

theorem step' {σ σ₁ σf : St S} {m : ℕ} (h : σ.top q ≠ some hlt) (e : mstep I q w δ σ = σ₁)
    (h' : Reaches I q w δ σ₁ σf m) : Reaches I q w δ σ σf (m + 1) := step h (e ▸ h')

theorem trans {σ σ₁ σf : St S} {m₁ m₂ : ℕ} (h₁ : Reaches I q w δ σ σ₁ m₁)
    (h₂ : Reaches I q w δ σ₁ σf m₂) : Reaches I q w δ σ σf (m₁ + m₂) := by
  refine ⟨by rw [add_comm, Function.iterate_add_apply, h₁.1, h₂.1], fun k hk => ?_⟩
  by_cases hk1 : k < m₁
  · exact h₁.2 k hk1
  · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le (not_lt.mp hk1)
    rw [add_comm, Function.iterate_add_apply, h₁.1]; exact h₂.2 j (by omega)

end Reaches

theorem Runs.machine_reach {q : Fin S} {w : List (Fin S)} {q0 : Sym}
    {δ : List (Option Sym) → List (Op S)} (B : ℕ) (hB : ∀ os, (δ os).length ≤ B)
    (σ σf : St S) (m : ℕ) (hR : Reaches I q w δ (σ.push q q0) σf m)
    (hstop : σf.top q = some hlt) :
    Runs I prog (NLogN.machine q w q0 δ : Stmt S P) σ (σf.pop q)
      (m * (B + 17 * w.length + 19) + 3) := by
  have := Runs.machine (I := I) (prog := prog) B hB σ m hR.2 (by rw [hR.1]; exact hstop)
  rwa [hR.1] at this

end NLogN

