open scoped ContDiff Topology Matrix
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.NullDirections
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geodesic
variable {I : Set ℝ} {f m N w p a : ℝ → ℝ}
theorem solution (hP : PaperData I f m N w p a) {x : Pt 5} (hx : x ∈ esDomain I)
    {lam : ℝ → ℝ} {lam' : ℝ} (hlam : HasDerivAt lam lam' (x 1))
    (hsq : ∀ᶠ r in 𝓝 (x 1), lam r ^ 2 = alphaSq f m N w p a r) :
    metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) x *ᵥ
        accel (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
          (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (principalField f m N w p a lam) x =
      ![-(lam (x 1) * deriv (deriv p) (x 1)),
        eFun w p a (x 1) / f (x 1) * (deriv (deriv p) (x 1) + w (x 1) * deriv (deriv a) (x 1)) -
          deriv a (x 1) * deriv (deriv a) (x 1) / Hfun m N (x 1),
        0, -(x 2 * lam (x 1) * deriv (deriv a) (x 1)),
        -((1 - x 2) * lam (x 1) * deriv (deriv a) (x 1))] := by
  have hE := hP.toESData
  have hO := isOpen_esDomain hP.isOpen
  have hg := esMetric_differentiableAt hE hx
  have hinv := esMetric_mul_inverse hE hx
  have hK := principalField_differentiableAt hP hx.1 hlam.differentiableAt
  have hKx := principalField_apply f m N w p a lam x
  set K := principalField f m N w p a lam with hKdef
  have hK0 : K x 0 = eFun w p a (x 1) / f (x 1) := by rw [hKx]; rfl
  have hK1 : K x 1 = lam (x 1) := by rw [hKx]; rfl
  have hK2 : K x 2 = 0 := by rw [hKx]; rfl
  have hK3 : K x 3 = w (x 1) * (eFun w p a (x 1) / f (x 1)) - deriv a (x 1) / Hfun m N (x 1) := by
    rw [hKx]; rfl
  have hK34 : K x 3 = K x 4 := by rw [hKx]; rfl
  have hlow : ∀ y ∈ esDomain I,
      metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ K y =
        ![-deriv p (y 1), Dfun f m N (y 1) * lam (y 1), 0, -(y 2 * deriv a (y 1)),
          -((1 - y 2) * deriv a (y 1))] := fun y hy =>
    principal_lower (hP.nf _ hy.1) (hP.nm _ hy.1) (hP.nN _ hy.1) _
  have e0 : Set.EqOn
      (fun y => (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ K y) 0)
      (liftRU fun r _ => -deriv p r) (esDomain I) := fun y hy => by simp [hlow y hy]
  have e1 : Set.EqOn
      (fun y => (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ K y) 1)
      (liftRU fun r _ => Dfun f m N r * lam r) (esDomain I) := fun y hy => by simp [hlow y hy]
  have e2 : Set.EqOn
      (fun y => (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ K y) 2)
      (liftRU fun _ _ => 0) (esDomain I) := fun y hy => by simp [hlow y hy]
  have e3 : Set.EqOn
      (fun y => (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ K y) 3)
      (liftRU fun r u => -(u * deriv a r)) (esDomain I) := fun y hy => by simp [hlow y hy]
  have e4 : Set.EqOn
      (fun y => (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ K y) 4)
      (liftRU fun r u => -((1 - u) * deriv a r)) (esDomain I) := fun y hy => by simp [hlow y hy]
  have d0 : deriv (fun s => -deriv p s) (x 1) = -deriv (deriv p) (x 1) :=
    (hP.d2p hx.1).neg.deriv
  have d1 : deriv (fun s => Dfun f m N s * lam s) (x 1) =
      _ := ((hasDerivAt_Dfun hP hx.1).mul hlam).deriv
  have d3 : deriv (fun s => -(x 2 * deriv a s)) (x 1) = -(x 2 * deriv (deriv a) (x 1)) :=
    ((hP.d2a hx.1).const_mul (x 2)).neg.deriv
  have d4 : deriv (fun s => -((1 - x 2) * deriv a s)) (x 1) =
      -((1 - x 2) * deriv (deriv a) (x 1)) :=
    ((hP.d2a hx.1).const_mul (1 - x 2)).neg.deriv
  have c0 := sum_pd_esMetric_of_ne f (Dfun f m N) (Afun f m) (Hfun m N) w
    (b := 0) (by decide) (by decide) x (K x)
  have c3 := sum_pd_esMetric_of_ne f (Dfun f m N) (Afun f m) (Hfun m N) w
    (b := 3) (by decide) (by decide) x (K x)
  have c4 := sum_pd_esMetric_of_ne f (Dfun f m N) (Afun f m) (Hfun m N) w
    (b := 4) (by decide) (by decide) x (K x)
  have c2 := sum_pd_two_esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w hg (K x) hK2 hK34
  have c1 := sum_pd_one_esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w hg (hP.df hx.1)
    (hasDerivAt_Dfun hP hx.1) (hasDerivAt_Hfun hP hx.1) (hP.dw hx.1) (K x) hK2 hK34
  -- the eventual identity `λ² = alphaSq` and its genuine derivative
  have hsq0 : lam (x 1) ^ 2 = alphaSq f m N w p a (x 1) := hsq.self_of_nhds
  have hrel := ((hasDerivAt_alphaSq hP hx.1).congr_of_eventuallyEq hsq).unique (hlam.pow 2)
  have r0 := lower_accel hinv hg hK 0
  rw [sum_pd_congr (K x) hO hx e0, sum_pd_liftRU hK2, c0] at r0
  have r1 := lower_accel hinv hg hK 1
  rw [sum_pd_congr (K x) hO hx e1, sum_pd_liftRU hK2, c1] at r1
  have r2 := lower_accel hinv hg hK 2
  rw [sum_pd_congr (K x) hO hx e2, sum_pd_liftRU hK2, c2] at r2
  have r3 := lower_accel hinv hg hK 3
  rw [sum_pd_congr (K x) hO hx e3, sum_pd_liftRU hK2, c3] at r3
  have r4 := lower_accel hinv hg hK 4
  rw [sum_pd_congr (K x) hO hx e4, sum_pd_liftRU hK2, c4] at r4
  simp only [d0, d1, d3, d4, hK0, hK1, hK3, deriv_const'] at r0 r1 r2 r3 r4
  funext b
  fin_cases b
  · refine r0.trans ?_; simp
  · refine r1.trans ?_
    simp only [Fin.mk_one, Matrix.cons_val_one, Matrix.cons_val_zero]
    simp only [alphaSq] at hsq0
    simp only [Nat.cast_ofNat, Nat.reduceSub, pow_one] at hrel
    have hf0 := hP.nf _ hx.1
    have hm0 := hP.nm _ hx.1
    have hN0 := hP.nN _ hx.1
    linear_combination (norm := skip)
      ((deriv m (x 1) * (4 * f (x 1) * N (x 1)) -
          m (x 1) * (4 * deriv f (x 1) * N (x 1) + 4 * f (x 1) * deriv N (x 1))) /
          (4 * f (x 1) * N (x 1)) ^ 2 / 2) * hsq0 - (Dfun f m N (x 1) / 2) * hrel
    simp only [Dfun, Hfun]
    field_simp
    ring
  · refine r2.trans ?_; simp
  · refine r3.trans ?_; simp; ring
  · refine r4.trans ?_; simp; ring
