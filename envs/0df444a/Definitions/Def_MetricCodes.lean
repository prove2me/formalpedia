    (youngClebschLower mu lam hdeg row).adjoint (v ⊗ₜ[ℝ] q) =
        (youngClebschLower mu lam hdeg row).adjoint
          ((∑ j : Fin n, v j • b j) ⊗ₜ[ℝ] q) := by rw [hv]
    _ = ∑ j : Fin n,
