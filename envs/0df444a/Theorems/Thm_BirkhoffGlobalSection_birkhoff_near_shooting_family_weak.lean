-- title:
--   Birkhoff's near shooting family (weak endpoint)
-- statement:
--   Fix $0<\mu<1$ and a Jacobi energy $-c$ below the first critical value. Let $\Sigma_{\mu,c}$ be the selected Levi-Civita component and $\varphi$ a continuous flow on it generated by the Hamiltonian vector field of $K_{\mu,c}$. A state is $s=(z_1,z_2,w_1,w_2)$; its physical position relative to the primary is $(x_1,x_2)=(2(z_1^2-z_2^2),\,4z_1z_2)$, and $(v_1,v_2)$ denotes the physical (Jacobi) velocity. A collision state has $z=0$; on $K=0$ it has $|w|^2=1-\mu$. $N(r)$ and $F(r)$ are the perpendicular near and far starts at $z=(r,0)$ and $z=(0,r)$, and $(\sigma,\eta)$ are the shooting coordinates (velocity sine and depth $-x_2$).
--
--   **Near shooting family, weak endpoint.** This is identical to `birkhoff_near_shooting_family` except that the endpoint $\Gamma(-1)=(\alpha,0)$ only satisfies $-1\le\alpha<-\sqrt2/2$.
--
--   There is a continuous curve $\Gamma:[-1,1]\to[-1,1]\times[0,1]$ from $(\alpha,0)$ to $(\sqrt2/2,0)$ with the following property. Every interior point has $|\sigma|<1$ and $\eta>0$, and is realised as the crossing coordinates of a backward trajectory from a near-side perpendicular start. That trajectory stays below the axis, has $x_1$ strictly increasing, and has $v_1>0$ at the crossing.
-- source:
--   Birkhoff 1915, The restricted problem of three bodies, §§16–18 (Collected Mathematical Papers Vol. 1, pp. 731–741); Liu–Salomão, arXiv 2506.17867v2, §5, pp. 30–31

import Definitions.Def_BirkhoffShootingCoordinates

namespace BirkhoffGlobalSection

theorem birkhoff_near_shooting_family_weak (μ c : ℝ)
    (hμ0 : 0 < μ) (hμ1 : μ < 1)
    (hc : belowFirstCriticalValue μ c)
    (φ : Flow ℝ (LeftEnergyState μ c))
    (hφ : IsLeviCivitaHamiltonianFlow μ c φ) :
    ∃ Γ : ℝ → ℝ × ℝ, ∃ α : ℝ, -1 ≤ α ∧ α < -(Real.sqrt 2 / 2) ∧
      ContinuousOn Γ (Set.Icc (-1) 1) ∧
      Γ (-1) = (α, 0) ∧ Γ 1 = (Real.sqrt 2 / 2, 0) ∧
      (∀ s ∈ Set.Icc (-1 : ℝ) 1,
        -1 ≤ (Γ s).1 ∧ (Γ s).1 ≤ 1 ∧ 0 ≤ (Γ s).2 ∧ (Γ s).2 ≤ 1) ∧
      ∀ s ∈ Set.Ioo (-1 : ℝ) 1, |(Γ s).1| < 1 ∧ 0 < (Γ s).2 ∧
        ∃ x : LeftEnergyState μ c, ∃ τ : ℝ, 0 < τ ∧
          (x : Phase) 1 = 0 ∧ (x : Phase) 2 = 0 ∧ (x : Phase) 0 ≠ 0 ∧
          (∀ t ∈ Set.Ioo (-τ) 0,
            relativePosition μ ((φ t x : LeftEnergyState μ c) : Phase) 1 < 0) ∧
          StrictMonoOn
            (fun t : ℝ => relativePosition μ ((φ t x : LeftEnergyState μ c) : Phase) 0)
            (Set.Icc (-τ) 0) ∧
          relativePosition μ ((φ (-τ) x : LeftEnergyState μ c) : Phase) 0 = 0 ∧
          0 < jacobiVelocity
            (leviCivitaToJacobi μ ((φ (-τ) x : LeftEnergyState μ c) : Phase)) 0 ∧
          shootingCoordinates μ ((φ (-τ) x : LeftEnergyState μ c) : Phase) = Γ s := by sorry

end BirkhoffGlobalSection
