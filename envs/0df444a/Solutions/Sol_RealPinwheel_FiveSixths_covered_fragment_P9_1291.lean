private def fragmentComputed {n : ℕ} (N : ℕ) (codes : ℕ → CycleCode)
    (Γ : List (LinearAtom n)) : LinearFragment n → Bool
  | .empty c => combinationCheck Γ c (falseAtom n)
  | .word j cs => linearCoverCheck N codes Γ (.word j cs)
  | .split i p q st l r => decide (0 < q) &&
      fragmentComputed N codes (upperAtom i p q st :: Γ) l &&
      fragmentComputed N codes (complementAtom (upperAtom i p q st) :: Γ) r
  | .hole => false
private theorem fragmentComputed_sound {n : ℕ} (N : ℕ) (codes : ℕ → CycleCode)
    (Γ : List (LinearAtom n)) (tree : LinearFragment n)
    (h : fragmentComputed N codes Γ tree = true) : fragmentObligations N codes Γ tree := by
  induction tree generalizing Γ with
  | empty c => exact h
  | word j cs => exact h
  | hole => simp [fragmentComputed] at h
  | split i p q st l r ihl ihr =>
    simp only [fragmentComputed, Bool.and_eq_true, decide_eq_true_eq] at h
    exact ⟨h.1.1, ihl _ h.1.2, ihr _ h.2⟩

set_option maxRecDepth 100000
set_option maxHeartbeats 0
theorem solution (d : Fin 9 → ℝ) (hΓ : ∀ a ∈ ((complementAtom (upperAtom (⟨5, by decide⟩ : Fin 9) 1 30 false)) :: (upperAtom (⟨0, by decide⟩ : Fin 9) 1 3 true) :: (upperAtom (⟨4, by decide⟩ : Fin 9) 1 15 false) :: (complementAtom (upperAtom (⟨3, by decide⟩ : Fin 9) 1 11 false)) :: (upperAtom (⟨2, by decide⟩ : Fin 9) 3 22 false) :: (complementAtom (upperAtom (⟨0, by decide⟩ : Fin 9) 4 13 false)) :: (complementAtom (upperAtom (⟨4, by decide⟩ : Fin 9) 5 96 false)) :: (complementAtom (upperAtom (⟨3, by decide⟩ : Fin 9) 5 96 false)) :: (upperAtom (⟨1, by decide⟩ : Fin 9) 5 24 false) :: (complementAtom (upperAtom (⟨2, by decide⟩ : Fin 9) 1 9 false)) :: (complementAtom (upperAtom (⟨2, by decide⟩ : Fin 9) 1 17 false)) :: (complementAtom (upperAtom (⟨1, by decide⟩ : Fin 9) 5 32 false)) :: (complementAtom (upperAtom (⟨1, by decide⟩ : Fin 9) 1 13 false)) :: (upperAtom (⟨0, by decide⟩ : Fin 9) 5 13 false) :: (complementAtom (upperAtom (⟨0, by decide⟩ : Fin 9) 2 7 false)) :: (complementAtom (upperAtom (⟨0, by decide⟩ : Fin 9) 7 34 false)) :: (complementAtom (upperAtom (⟨0, by decide⟩ : Fin 9) 11 96 false)) :: initialAtoms 9 8 : List (LinearAtom 9)), a.Holds d) :
    ∃ j : Fin 7968, codeBox (codeFunctionP9 j.val) d := by
  have hc : fragmentObligations 7968 codeFunctionP9 fragmentContextP9_1291 fragmentTreeP9_1291 := by
    unfold fragmentTreeP9_1291
    apply fragmentComputed_sound
    decide +kernel
  exact fragment_sound 7968 codeFunctionP9 fragmentContextP9_1291 fragmentTreeP9_1291 hc d hΓ
