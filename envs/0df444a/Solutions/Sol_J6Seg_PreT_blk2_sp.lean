-- Source module: Solutions.J6SegILPre12
/-!
# B-line IL, pre-tables (B5), part 12: one block

`blkB K Cs`: for the block starting at `st` (on `1`): scan its length `n = 1 + enF st` (`2`),
push its descriptor `encD pk b (n, am_st, ap_st)` in reading order onto the scratch stack `K`,
advance `1 += n`, count `7 += 1` (blocks) and `8 += n` (entries), and zero the work registers.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

theorem StIn2.of {v w : Fin HS → ℤ} {P R sN tN lam aN A : ℕ} (hi : StIn2 v P R sN tN lam aN A)
    (hw : VB w A) (h : ∀ j, ¬ Wk j → w j = v j) : StIn2 w P R sN tN lam aN A :=
  { vb := hw
    h20 := by rw [h 20 (by unfold Wk; decide), hi.h20]
    h21 := by rw [h 21 (by unfold Wk; decide), hi.h21]
    h22 := by rw [h 22 (by unfold Wk; decide), hi.h22]
    h23 := by rw [h 23 (by unfold Wk; decide), hi.h23]
    h24 := by rw [h 24 (by unfold Wk; decide), hi.h24]
    h25 := by rw [h 25 (by unfold Wk; decide), hi.h25]
    lam := hi.lam
    A2 := hi.A2
    h9 := by rw [h 9 (by unfold Wk; decide), hi.h9]
    h10 := by rw [h 10 (by unfold Wk; decide), hi.h10] }

theorem spA' (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {A : ℕ} (hA : 2 ≤ A)
    (hv : VB v A) {i : Fin HS} (hi : i ∈ rg) {e : Ex HS} (he : InRg e) (hp : Poly e = true)
    (hd : dg e ≤ 40) (hs : Safe e = true) :
    Sp (.asg i e) (encK s (RF v c)) (encK s (RF (Function.update v i (e.eval (encK s (RF v c)))) c))
      (cE e (BW A)) :=
  spA s v c hi he (ok_RF he hs) (V := fun _ => 2 ^ A) (B := BW A) (vb_regs hv he) (hv i hi)
    (mgB hA hp hd) (Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega))

end J6Seg.PreT

end

