theorem solution (n tst : NLogN.Ex NLogN.HS) (rd : Fin NLogN.HS) (P : ℕ → Prop) [DecidablePred P] (s : NLogN.IState NLogN.HS)
    (N : ℕ) (hd56 : rd.val < 56) (hdI : rd ≠ NLogN.KFM.sI) (hn : n.Clean) (hnd : rd ∉ n.regs)
    (hnok : n.ok s) (hN : n.eval s = N) (ht : tst.Clean) (htd : rd ∉ tst.regs)
    (htst : ∀ x, 1 ≤ x → x ≤ N → tst.ok (NLogN.KFM.xSt s x) ∧ (tst.eval (NLogN.KFM.xSt s x) < 0 ↔ P x)) :
    (NLogN.KFM.cntP n tst rd).ok s ∧ (NLogN.KFM.cntP n tst rd).run s =
      s.upd rd (.int (∑ x ∈ Finset.Icc 1 N, if P x then (1 : ℤ) else 0) :: s.G rd) := by
  set s1 := s.upd rd (.int 0 :: s.G rd) with hs1
  have r1 : (NLogN.RS.push rd (.lit 0)).run s = s1 := by simp [NLogN.RS.run, NLogN.Ex.eval, hs1]
  have k1 : (NLogN.RS.push rd (.lit 0)).ok s := ⟨hd56, by intro j hj; simp [NLogN.Ex.regs] at hj, trivial⟩
  have H := NLogN.KFM.genLoop_run NLogN.KFM.sI rd n (NLogN.KFM.cntB tst rd) s1 N (NLogN.KFM.sumG (fun x => if P x then (1 : ℤ) else 0) N) 0
    (s.G rd) (Ne.symm hdI) (by decide) hn ((NLogN.Ex.ok_upd s rd _ n hnd).2 hnok)
    (by rw [hs1, NLogN.Ex.eval_upd s rd _ n hnd, hN]) (by simp [NLogN.KFM.cntB, NLogN.RS.writes]; exact Ne.symm hdI)
    (by simp [hs1])
    (NLogN.KFM.cntB_step n tst rd P s N hd56 hdI ht htd htst)
  rw [NLogN.KFM.accSeq_sum, zero_add] at H
  refine ⟨⟨k1, by rw [r1]; exact H.1⟩, ?_⟩
  simp only [NLogN.KFM.cntP, NLogN.RS.run_seq]
  rw [r1, H.2, hs1, NLogN.IState.upd_upd_same]
