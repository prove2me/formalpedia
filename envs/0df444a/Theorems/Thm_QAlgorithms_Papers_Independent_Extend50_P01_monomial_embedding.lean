local notation "pauliWord" => QAlgorithms.Papers.Independent.Gap48.P33.pauliWord

/-- PDF p.5: matched squarefree monomial orbits; translation of a pair uses at most d terms. -/
theorem monomial_embedding (d : ℕ) (K : Subgroup (Equiv.Perm (Fin d))) (A : Finset (Fin d)) :
    (∀ s ∈ K, ∀ x : Fin d → ℝ,
      monomialEncoding K A (featurePullback s x) = conjugate (wireMatrix s) (monomialEncoding K A x)) ∧
    (∀ t : Equiv.Perm (Fin d), 0 < d → t ^ d = 1 → A.card = 2 →
      (supportOrbit (Subgroup.zpowers t) A).card ≤ d) := by sorry

end QAlgorithms.Papers.Independent.Extend50.P01

