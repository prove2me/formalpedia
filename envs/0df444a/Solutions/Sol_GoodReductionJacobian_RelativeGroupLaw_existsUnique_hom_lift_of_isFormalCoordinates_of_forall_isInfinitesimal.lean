variable {B : Type} [CommRing B] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of B)}

theorem mul_left_cancel (L : RelativeGroupLaw B f) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B))
    {x y z : SchemeHomOver t f} (h : L.mul t x y = L.mul t x z) : y = z := by
  have h' := congrArg (L.mul t (L.inv t x)) h
  rwa [← L.mul_assoc, ← L.mul_assoc, L.inv_mul_cancel, L.one_mul, L.one_mul] at h'

theorem nsmulPt_eq_nsmul (L : RelativeGroupLaw B f) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B))
    (n : ℕ) (P : SchemeHomOver t f) : nsmulPt L t n P = L.nsmul t n P := by
  induction n with
  | zero => rfl
  | succ n ih =>
    show L.mul t (nsmulPt L t n P) P = _
    rw [ih, RelativeGroupLaw.nsmul_succ]

theorem nsmul_mul (L : RelativeGroupLaw B f) (hc : L.IsCommutative) {T : Scheme.{0}}
    (t : T ⟶ Spec (CommRingCat.of B)) (n : ℕ) (P Q : SchemeHomOver t f) :
    L.nsmul t n (L.mul t P Q) = L.mul t (L.nsmul t n P) (L.nsmul t n Q) := by
  induction n with
  | zero =>
    simp only [RelativeGroupLaw.nsmul_zero]
    exact (L.one_mul t _).symm
  | succ n ih =>
    simp only [RelativeGroupLaw.nsmul_succ]
    rw [ih, L.mul_assoc, L.mul_assoc, ← L.mul_assoc t (L.nsmul t n Q) P Q, hc.mul_comm t (L.nsmul t n Q) P,
      L.mul_assoc]

theorem schemeNsmul_pt (L : RelativeGroupLaw B f) (n : ℕ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B))
    (P : SchemeHomOver t f) (h : (P.1 ≫ L.schemeNsmul n) ≫ f = t) :
    (⟨P.1 ≫ L.schemeNsmul n, h⟩ : SchemeHomOver t f) = L.nsmul t n P := by
  have key := L.nsmul_natural f t P.1 P.2 n RelativeGroupLaw.idPoint
  have hid : schemeHomOverComp P.1 P.2 (RelativeGroupLaw.idPoint (f := f)) = P := by
    apply Subtype.ext; simp only [schemeHomOverComp_coe]; exact Category.comp_id _
  rw [hid] at key
  rw [← key]
  apply Subtype.ext
  rfl

theorem mapPt_schemeNsmul (L : RelativeGroupLaw B f) (n : ℕ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B))
    (P : SchemeHomOver t f) :
    mapPt (L.schemeNsmul n) (L.schemeNsmul_over n) P = L.nsmul t n P :=
  schemeNsmul_pt L n t P _

variable {A' : Scheme.{0}} {f' : A' ⟶ Spec (CommRingCat.of B)}

theorem mapPt_one (L : RelativeGroupLaw B f) (L' : RelativeGroupLaw B f') (φ : A ⟶ A') (hφ : φ ≫ f' = f)
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t f),
      mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) :
    mapPt φ hφ (L.one t) = L'.one t := by
  have h := hmul t (L.one t) (L.one t)
  rw [L.one_mul] at h
  have h' : L'.mul t (mapPt φ hφ (L.one t)) (L'.one t) =
      L'.mul t (mapPt φ hφ (L.one t)) (mapPt φ hφ (L.one t)) := by
    rw [L'.mul_one]; exact h
  exact (mul_left_cancel L' t h').symm

theorem mapPt_nsmul (L : RelativeGroupLaw B f) (L' : RelativeGroupLaw B f') (φ : A ⟶ A') (hφ : φ ≫ f' = f)
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t f),
      mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (n : ℕ) (P : SchemeHomOver t f) :
    mapPt φ hφ (L.nsmul t n P) = L'.nsmul t n (mapPt φ hφ P) := by
  induction n with
  | zero => exact mapPt_one L L' φ hφ hmul t
  | succ n ih => rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, hmul, ih]

theorem schemeNsmul_comm (L : RelativeGroupLaw B f) (L' : RelativeGroupLaw B f') (φ : A ⟶ A') (hφ : φ ≫ f' = f)
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t f),
      mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q)) (n : ℕ) :
    L.schemeNsmul n ≫ φ = φ ≫ L'.schemeNsmul n := by
  have h1 := mapPt_nsmul L L' φ hφ hmul f n RelativeGroupLaw.idPoint
  have h2 := congrArg Subtype.val h1
  rw [← schemeNsmul_pt L' n f (mapPt φ hφ RelativeGroupLaw.idPoint)
    (by rw [Category.assoc, L'.schemeNsmul_over]; exact (mapPt φ hφ RelativeGroupLaw.idPoint).2)] at h2
  simpa [mapPt_coe, RelativeGroupLaw.schemeNsmul] using h2

