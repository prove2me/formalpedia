theorem pi_character_kernel_eq_reflection_line (r : ReflectionParameter K)
    (a : Additive (Kernel K schemePi)) (ha : a ≠ 0) :
    LinearMap.ker (kernelCharacterLinear K schemePi schemePiConjugate a) =
      Submodule.span (ZMod 19) {piKernelReflection K r a} := by
  have hs := kernelCharacterLinear_surjective_of_cross K schemePi schemePiConjugate
    (pi_cross_left_nondegenerate K) a ha
  have hd := LinearMap.finrank_range_add_finrank_ker (kernelCharacterLinear K schemePi schemePiConjugate a)
  rw [LinearMap.range_eq_top.mpr hs, _root_.finrank_top, roots_finrank_one K,
    (Order13ActualNormKernelRanksTwo.actual_norm_kernel_ranks_two K).2] at hd
  have hk : Module.finrank (ZMod 19)
      (LinearMap.ker (kernelCharacterLinear K schemePi schemePiConjugate a)) = 1 := by omega
  have hv : piKernelReflection K r a ≠ 0 := by
    intro h
    apply ha
    apply (piKernelReflection K r).injective
    exact h.trans (map_zero (piKernelReflection K r)).symm
  have hle : Submodule.span (ZMod 19) {piKernelReflection K r a} ≤
      LinearMap.ker (kernelCharacterLinear K schemePi schemePiConjugate a) := by
    apply Submodule.span_le.mpr
    intro v hv
    rw [Set.mem_singleton_iff] at hv
    rw [hv]
    exact piReflection_mem_character_kernel K r a
  symm
  apply Submodule.eq_of_le_of_finrank_eq hle
  rw [finrank_span_singleton hv, hk]

