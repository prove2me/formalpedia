variable (p : ℕ) [NeZero p]

theorem galois_smul_heckeModuleBar_smul (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (t : HeckeAlg) (x : JZero p) :
    (letI := heckeModuleBar p; σ • (t • x) = t • (σ • x)) := by
  letI := heckeModuleBar p
  by_cases hc : HeckeOperatorsCommuteBar p
  · haveI := smulCommClass_JZero_of_heckeOperatorsCommuteBar p hc
    exact smul_comm σ t x
  · rw [heckeModuleBar_smul_of_not hc t x, heckeModuleBar_smul_of_not hc t (σ • x)]
    exact map_zsmul (DistribSMul.toAddMonoidHom (JZero p) σ) (MvPolynomial.constantCoeff t) x

theorem smul_mem_eisensteinKernelSubmodule (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (w : JZero p)
    (hw : w ∈ eisensteinKernelSubmodule p (heckeModuleBar p)) :
    σ • w ∈ eisensteinKernelSubmodule p (heckeModuleBar p) := by
  letI := heckeModuleBar p
  unfold eisensteinKernelSubmodule at hw ⊢
  refine Submodule.smul_induction_on
    (p := fun w => σ • w ∈ eisensteinKernel (JZero p) (eisensteinIdeal p) • (⊤ : Submodule HeckeAlg (JZero p))) hw ?_ ?_
  · intro t ht v _
    rw [galois_smul_heckeModuleBar_smul]
    exact Submodule.smul_mem_smul ht Submodule.mem_top
  · intro a b ha hb
    rw [smul_add]
    exact Submodule.add_mem _ ha hb

noncomputable def galLinear (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    letI := heckeModuleBar p; JZero p →ₗ[HeckeAlg] JZero p :=
  letI := heckeModuleBar p
  { toFun := fun x => σ • x
    map_add' := fun x y => smul_add σ x y
    map_smul' := fun t x => galois_smul_heckeModuleBar_smul p σ t x }

noncomputable def galQuot (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    EisensteinQuotient p (heckeModuleBar p) →+ EisensteinQuotient p (heckeModuleBar p) :=
  letI := heckeModuleBar p
  ((eisensteinKernelSubmodule p (heckeModuleBar p)).mapQ (eisensteinKernelSubmodule p (heckeModuleBar p))
    (galLinear p σ) (fun w hw => smul_mem_eisensteinKernelSubmodule p σ w hw)).toAddMonoidHom

theorem galQuot_mk (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (x : JZero p) :
    galQuot p σ (eisensteinQuotientMk p (heckeModuleBar p) x) = eisensteinQuotientMk p (heckeModuleBar p) (σ • x) :=
  rfl

noncomputable scoped instance instSMulQuot : SMul (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (EisensteinQuotient p (heckeModuleBar p)) :=
  ⟨fun σ z => galQuot p σ z⟩

theorem smul_quot_def (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (z : EisensteinQuotient p (heckeModuleBar p)) :
    σ • z = galQuot p σ z := rfl

theorem smul_mk (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (x : JZero p) :
    σ • eisensteinQuotientMk p (heckeModuleBar p) x = eisensteinQuotientMk p (heckeModuleBar p) (σ • x) :=
  rfl

noncomputable scoped instance instDistribMulActionQuot :
    DistribMulAction (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (EisensteinQuotient p (heckeModuleBar p)) where
  one_smul z := by
    letI := heckeModuleBar p
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective (eisensteinKernelSubmodule p (heckeModuleBar p)) z
    show galQuot p 1 (eisensteinQuotientMk p (heckeModuleBar p) x) = _
    rw [galQuot_mk, one_smul]; rfl
  mul_smul σ τ z := by
    letI := heckeModuleBar p
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective (eisensteinKernelSubmodule p (heckeModuleBar p)) z
    show galQuot p (σ * τ) (eisensteinQuotientMk p (heckeModuleBar p) x) =
      galQuot p σ (galQuot p τ (eisensteinQuotientMk p (heckeModuleBar p) x))
    rw [galQuot_mk, galQuot_mk, galQuot_mk, mul_smul]
  smul_zero σ := map_zero (galQuot p σ)
  smul_add σ z w := map_add (galQuot p σ) z w

noncomputable def torsionQuotMap (m : ℤ) :
    ↥(Submodule.torsionBy ℤ (JZero p) m) →+ ↥(Submodule.torsionBy ℤ (EisensteinQuotient p (heckeModuleBar p)) m) :=
  { toFun := fun x => ⟨eisensteinQuotientMk p (heckeModuleBar p) x, by
      have hx := x.2
      rw [Submodule.mem_torsionBy_iff] at hx ⊢
      rw [← map_zsmul, hx, map_zero]⟩
    map_zero' := Subtype.ext (map_zero _)
    map_add' := fun x y => Subtype.ext (map_add _ _ _) }

theorem torsionQuotMap_surjective (m : ℤ) (hm : m ≠ 0) : Function.Surjective (torsionQuotMap p m) := by
  intro z
  obtain ⟨x, hx, hxz⟩ := exists_mem_torsionBy_eisensteinQuotientMk_eq p (heckeModuleBar p) m hm z z.2
  exact ⟨⟨x, hx⟩, Subtype.ext hxz⟩

theorem torsionQuotMap_smul (m : ℤ) (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (x : ↥(Submodule.torsionBy ℤ (JZero p) m)) :
    torsionQuotMap p m (σ • x) = σ • torsionQuotMap p m x :=
  rfl

end HMN1
