namespace HostData

variable (X : HostData) (D' : ℕ)

/-- The data stay valid for an inner dimension that is at least `q p`. -/
theorem Valid.withD {X : HostData} (hv : X.Valid) {D' : ℕ} (h : X.q * X.p ≤ D') :
    (X.withD D').Valid :=
  { n_pos := hv.n_pos, p_pos := hv.p_pos, q_pos := hv.q_pos, cap_pos := hv.cap_pos, qp_le := h,
    lenAB := hv.lenAB, lenBC := hv.lenBC, lenAC := hv.lenAC }

end HostData

/-- The memory that the loop reads does not depend on the inner dimension. -/
theorem HostMem.withD {X : HostData} {A : HostAddr} {μ : ℕ → ℤ} (h : HostMem X A μ) (D' : ℕ) :
    HostMem (X.withD D') A μ :=
  { segAB := h.segAB, segBC := h.segBC, segAC := h.segAC, segRAC := h.segRAC,
    segRBC := h.segRBC, segQI := h.segQI, segQJ := h.segQJ, segCR := h.segCR, segCL := h.segCL,
    segCW := h.segCW }

/-- The marks do not depend on the inner dimension of the layout. -/
theorem AEMarksLay.withD {X : HostData} {A : HostAddr} {fl : ℕ} (h : AEMarksLay X A fl) (D' : ℕ) :
    AEMarksLay (X.withD D') A fl :=
  { below := h.below, ab := h.ab, bc := h.bc, ac := h.ac, rac := h.rac, rbc := h.rbc, qi := h.qi,
    qj := h.qj, cr := h.cr, cl := h.cl, cw := h.cw }

/-- A layout for the inner dimension `D` holds the matrices of a smaller inner dimension. -/
theorem HostLay.withD {X : HostData} {A : HostAddr} (h : HostLay X A) {D' : ℕ} (hD : D' ≤ X.D) :
    HostLay (X.withD D') A := by
  have hxy := h.xy
  have hyo := h.yo
  have h1 : X.n * D' ≤ X.n * X.D := Nat.mul_le_mul_left _ hD
  have h2 : D' * X.n ≤ X.D * X.n := Nat.mul_le_mul_right _ hD
  exact
    { bAB := h.bAB, bBC := h.bBC, bAC := h.bAC, bRAC := h.bRAC, bRBC := h.bRBC, bQI := h.bQI,
      bQJ := h.bQJ, bCR := h.bCR, bCL := h.bCL, bCW := h.bCW,
      xy := by simp only [HostData.withD_n, HostData.withD_D]; omega
      yo := by simp only [HostData.withD_n, HostData.withD_D]; omega
      ofr := h.ofr }

/-- `⌈s/g⌉ ≤ s` for `g ≥ 1`. -/
theorem pieceSizeNat_le_sqrt {D g : ℕ} (hg : 1 ≤ g) : pieceSizeNat D g ≤ Nat.sqrt D :=
  (Nat.ceilDiv_le_iff hg).2 (Nat.le_mul_of_pos_right _ hg)

/-- The middle dimension is at most `D`. -/
theorem midDim_le {D g : ℕ} (hg : 1 ≤ g) : midDim D g ≤ D :=
  (Nat.mul_le_mul_right _ (pieceSizeNat_le_sqrt hg)).trans (Nat.sqrt_le D)

/-- The data with the middle dimension are valid. -/
theorem midHostData_valid {x : TriInst} {μ : ℕ → ℤ} {fr D g : ℕ} (hpre : x.Pre μ fr)
    (h : BigCase x.n D g) : (midHostData x D g).Valid :=
  (hostData_valid hpre h).withD (Nat.mul_le_mul_left _ (hostData_p_le x g h.sixteen_le))

/-- The need of the core covers that of the host of Theorem 17. -/
theorem midNeedAt_ok_host {lim : Limits} {fr d a b : ℕ} {need : List ℕ → Light.Need} {n U D g : ℕ}
    (h : (midNeedAt a b need n U D g).Ok lim fr d) : (hostNeedAt a b need n U D g).Ok lim fr d :=
  h.mono (by simp only [midNeedAt]; omega) (by simp only [midNeedAt]; omega)
    (by simp only [midNeedAt]; omega)

/-- The need of the solver on an instance with at most cap query pairs is at most supNeed. -/
private theorem need_le_supNeed' (need : List ℕ → Light.Need) (n D : ℕ) {cap w : ℕ} (hw : w ≤ cap) :
    (need [n, D, w]).word ≤ (supNeed need n D cap).word ∧
      (need [n, D, w]).cells ≤ (supNeed need n D cap).cells ∧
      (need [n, D, w]).depth ≤ (supNeed need n D cap).depth := by
  have hm : w ∈ Finset.range (cap + 1) := Finset.mem_range.2 (by omega)
  exact ⟨Finset.le_sup (f := fun v => (need [n, D, v]).word) hm,
    Finset.le_sup (f := fun v => (need [n, D, v]).cells) hm,
    Finset.le_sup (f := fun v => (need [n, D, v]).depth) hm⟩

/-- **What the loop asks of the limits**, for the data with the middle dimension and the addresses
of the host. -/
theorem midLim_of_ok {lim : Limits} {d a b : ℕ} {need : List ℕ → Light.Need} {x : TriInst}
    {fr D g : ℕ} (hbig : BigCase x.n D g) (hok : (midNeedAt a b need x.n x.U D g).Ok lim fr d) :
    HostLim lim (d + 1) (midHostData x D g) x.U (hostAddr x (hostData x D g) fr) need := by
  have h0 := hostLim_of_ok hbig (midNeedAt_ok_host hok)
  have hcells := hok.cells
  have hdepth := hok.depth
  have hword := hok.word
  simp only [midNeedAt, hostNeedAt] at hcells hdepth hword
  have hfr := aFr_le (x := x) (g := g) hbig.sixteen_le fr
  exact
    { space := h0.space
      fr := h0.fr
      prime := h0.prime
      count := h0.count
      step := h0.step
      weights := h0.weights
      depth := h0.depth
      solver := fun t ht => by
        have hwc : (hostData x D g).w t ≤ queryCapNat x.n D := (hostData x D g).w_le_cap ht
        obtain ⟨hsword, hscells, hsdepth⟩ := need_le_supNeed' need x.n (midDim D g) hwc
        change (need [x.n, midDim D g, (hostData x D g).w t]).Ok lim
          (aFr (hostData x D g) x.U fr) (d + 1 + 1)
        have h1 : (need [x.n, midDim D g, (hostData x D g).w t]).word
            ≤ hostWord a b x.n x.U D g + (supNeed need x.n D (queryCapNat x.n D)).word
              + (supNeed need x.n (midDim D g) (queryCapNat x.n D)).word := by omega
        exact ⟨le_trans (by exact_mod_cast h1) hword, by omega, hok.space, by omega⟩ }

variable {P₀ R : Program} {ν : Et17Nums} {pAEBrute pAELoop pScanPairsAE pCore pFill : ℕ}
  {Tn : List ℕ → ℕ} {need : List ℕ → Need} {Dfun Gfun tD tG wD wG : ℕ → ℕ}

/-- The context of the loop. -/
theorem MidCtx.loop (C : MidCtx P₀ R ν pAEBrute pAELoop pScanPairsAE pCore pFill Tn need Dfun Gfun
    tD tG wD wG) : AEHostCtx P₀ R ν.pS ν.pWriteX ν.pWriteY pScanPairsAE ν.pScan Tn need :=
  ⟨C.et.loop.sol, C.et.loop.writeX, C.et.loop.writeY, C.hScanPairsAE, C.et.loop.scan⟩

/-- The time of the third part in a run, written for the data of the host of Theorem 17. -/
theorem aeRunTime_withD (Tn : List ℕ → ℕ) (X : HostData) (D' U : ℕ) :
    aeRunTime Tn (X.withD D') U = tDblTable (bitLen U) + 3 * tResidues (X.n * X.n) (bitLen U)
      + tClasses X.n X.p + tChunks X.p X.chunkCount + tAELoop Tn (X.withD D') + 80 := rfl

open Et17 in
/-- **The third part of the core**: below the free pointer, the memory with the marks after all
instances. -/
theorem midTables_spec (C : MidCtx P₀ R ν pAEBrute pAELoop pScanPairsAE pCore pFill Tn need Dfun
    Gfun tD tG wD wG) {lim : Limits} {d : ℕ} (x : AEInst) (μ : ℕ → ℤ) (fr D g a b : ℕ)
    (hpre : x.Pre μ fr) (hcell : μ fr = x.out) (hzero : ∀ q < x.n * x.n, μ (x.out + q) = 0)
    (hbig : BigCase x.n D g) (hok : (midNeedAt a b need x.n x.U D g).Ok lim (fr + 1) d) :
    Ends lim (P₀ ++ R) d (midTables ν pAELoop) ⟨Light.frame (et17LocB x.toTriInst (fr + 1) D g), μ⟩
      (aeRunTime Tn (midHostData x.toTriInst D g) x.U)
      fun σ' => Light.Kept (withMarks μ x.out (x.n * x.n)
        ((midHostData x.toTriInst D g).marks (midHostData x.toTriInst D g).m)) σ'.mem (fr + 1) := by
  have hpre' : x.toTriInst.Pre μ (fr + 1) := hpre.toPre.mono (by omega)
  have hok₀ := midNeedAt_ok_host hok
  have hr := ready_of hpre' hbig hok₀
  have hlim := midLim_of_ok hbig hok
  have hv := hostData_valid hpre' hbig
  have hv' := midHostData_valid hpre' hbig
  have hqs : midDim D g ≤ D := midDim_le hbig.one_le_g
  have hqD : pieceSizeNat D g * Nat.sqrt D ≤ D := hqs
  have hsD : Nat.sqrt D ≤ D := Nat.sqrt_le_self D
  have hqsq : pieceSizeNat D g ≤ Nat.sqrt D := pieceSizeNat_le_sqrt hbig.one_le_g
  have hwD : ((D : ℕ) : ℤ) ≤ lim.word := le_word_of_le_hostWord hok₀
  have hbo := hpre.belowOut
  have hAB := hpre.apartAB
  have hBC := hpre.apartBC
  have hAC := hpre.apartAC
  unfold et17LocB midHostData at *
  have hq : (hostData x.toTriInst D g).q = pieceSizeNat D g := rfl
  have hXD : (hostData x.toTriInst D g).D = D := rfl
  rw [← hXD] at hqs
  rw [show midDim D g = (hostData x.toTriInst D g).q * Nat.sqrt D from rfl] at hlim hv' ⊢
  rw [← hq] at hqD hqsq
  rw [aeRunTime_withD]
  generalize hX : hostData x.toTriInst D g = X at hr hlim hv hv' hq hXD hqs hqD hqsq ⊢
  have hn : X.n = x.n := by rw [← hX]; rfl
  have hdepth := hr.depth
  have hplaces := host_places X x.U (fr + 1)
  have hfr : fr + 1 ≤ aX X x.U (fr + 1) := by omega
  unfold midTables
  refine resid_then C.et.hDbl C.et.hResid C.et.hResidues hr (fun r₁ μ₁ hresid => ?_) (by omega)
  refine classes_then C.et.hClasses C.et.hChunks hr hv.cap_pos hresid.rab
    (fun r₂ μ₂ hclass => ?_) (by omega)
  -- below the free pointer nothing has changed
  have hsame : ∀ c < fr + 1, μ₂ c = μ c := fun c hc =>
    (hclass.same c (Or.inl (by omega))).trans (hresid.same c (Or.inl hc))
  -- NumInst := NumPieces * NumChunks
  have hcount := hlim.count
  have hm : (X.m : ℤ) = (X.h : ℤ) * X.chunkCount := by
    rw [HostData.m]
    push_cast
    rfl
  have hpos : (0 : ℤ) ≤ (X.h : ℤ) * X.chunkCount := by positivity
  simp only [HostData.withD_m] at hcount
  (focus
     ((first
         | refine Light.Ends.seqSelf ?_
         | refine Light.Ends.skipLast ?_);
       (repeat
           with_unfolding_none
             first
             | refine Light.Ends.seqAssoc ?_
             | refine Light.Ends.skipThen ?_))
     (refine Light.Ends.setToThen (X.m : ℕ) ?_ ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, hm])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [hm] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 =>
         ( (try have := Light.Std.space_le (by assumption))
           (try have := Light.Std.const_le (by assumption))
           (simp [Light.Limits.Addr, abs_le, -abs_mul, hm] <;> omega)))
     (try with_unfolding_none refine Light.Ends.skip ?_))
  -- the loop
  have hcell₂ : μ₂ fr = x.out := (hsame fr (by omega)).trans hcell
  have hzero₂ : ∀ q < X.n * X.n, μ₂ (x.out + q) = 0 := fun q hq => by
    rw [hn] at hq
    rw [hsame _ (by omega)]
    exact hzero q hq
  have hL : AEMarksLay X (hostAddr x.toTriInst X (fr + 1)) x.out := by
    have hnn : X.n * X.n = x.n * x.n := by rw [hn]
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    all_goals simp only [hostAddr, Apart, hnn]
    all_goals try omega
  have hloop := aeLoop_spec C.loop ⟨hv', hr.leAB, hr.leBC, hr.leAC⟩
    ((hostMem_of hr hresid hclass).withD _)
    ((hostLay_of hr (hr.chunkCount_le hv.cap_pos)).withD (by rw [hXD]; exact hqD)) hlim (hL.withD _) hzero₂
  refine Ends.callTo (Meets.of_body (Q := fun _ μ' => Light.Kept (aeBase (X.withD (X.q * Nat.sqrt D))
      x.out μ₂ X.m) μ' (hostAddr x.toTriInst X (fr + 1)).x) C.hAELoop hloop) ?_ ?_ (by omega)
      (by simp; omega)
  · intro r μ₃ hkept c hc
    change μ₃ c = _
    rw [hkept c (by simp only [hostAddr]; omega)]
    simp only [aeBase, hn, HostData.withD_n, HostData.withD_m]
    unfold withMarks
    split_ifs
    · rfl
    · exact hsame c hc
  · constructor
    · intro e he
      simp only [List.mem_cons, List.not_mem_nil, or_false] at he
      rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
        rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      all_goals simp [Expr.Safe]
      · have hqs0 : ((X.q * Nat.sqrt D : ℕ) : ℤ) ≤ lim.word := le_trans (by exact_mod_cast hqD) hwD
        push_cast at hqs0
        exact hqs0
      · have htop := hr.top
        have hsp := hr.space
        refine ⟨⟨by omega, by omega⟩, ?_⟩
        simp only [Limits.Addr]
        omega
    · simp [aeLoopArgs, hostAddr, setLocal, hcell₂]

namespace MidTime

variable {x : TriInst} {μ : ℕ → ℤ} {fr D g : ℕ}

end MidTime

open Et17 in
/-- **The core writes the flags.** -/
theorem midCore_spec (C : MidCtx P₀ R ν pAEBrute pAELoop pScanPairsAE pCore pFill Tn need Dfun
    Gfun tD tG wD wG) {lim : Limits} {d : ℕ} (x : AEInst) (μ : ℕ → ℤ) (fr : ℕ)
    (hpre : x.Pre μ fr) (hcell : μ fr = x.out) (hzero : ∀ q < x.n * x.n, μ (x.out + q) = 0)
    (hok : (midCoreNeed Dfun Gfun wD wG need x.n x.U).Ok lim (fr + 1) d) :
    Ends lim (P₀ ++ R) d (midCoreBody ν pAEBrute pAELoop)
      ⟨Light.frame [x.n, x.U, x.ab, x.bc, x.ac, (fr + 1 : ℕ)], μ⟩
      (midCoreTime Dfun Gfun tD tG Tn x.n x.U) fun σ' =>
        Seg σ'.mem x.out (aeFlags x.n x.AB x.BC x.AC) ∧ KeptBut μ σ'.mem fr x.out (x.n * x.n) := by
  have hpre' : x.toTriInst.Pre μ (fr + 1) := hpre.toPre.mono (by omega)
  have hok₀ : (hostNeed Dfun Gfun wD wG need x.n x.U).Ok lim (fr + 1) d := midNeedAt_ok_host hok
  have hparams := et17Params_spec C.et x.toTriInst μ (fr + 1) hpre' hok₀
  have hone : (1 : ℤ) ≤ lim.word := by
    have hword := hok₀.word
    simp only [hostNeed, hostNeedAt, hostWord] at hword
    omega
  have hbo := hpre.belowOut
  rw [← frame_append_zeros [(x.n : ℤ), x.U, x.ab, x.bc, x.ac, ((fr + 1 : ℕ) : ℤ)] 29]
  unfold hostNeed at hok₀
  unfold midCoreNeed at hok
  unfold midCoreBody midCoreTime hostSetup
  generalize Dfun x.n = D at *
  generalize Gfun D = g at *
  refine Ends.next _ (hparams.mono le_rfl ?_) (by omega)
  rintro _ rfl
  by_cases hs : SmallCase x.n D g
  · -- the small case: the brute force
    rw [if_pos hs]
    have hbrute : (aeBruteNeed x.n x.U).Ok lim (fr + 1) (d + 1) :=
      hok₀.mono (by simp only [aeBruteNeed, hostNeedAt, hostWord]; omega)
        (by simp only [aeBruteNeed]; omega) (by simp only [aeBruteNeed, hostNeedAt]; omega)
    have hdepth := hok₀.depth
    simp only [hostNeedAt] at hdepth
    have hcells := hok₀.cells
    refine Ends.iteLast (fun _ => ?_) (fun h => absurd (by simp [et17LocA, hs]) h) (by simp; omega)
    refine Ends.callTo (aeBrute_meets C.hAEBrute C.et.loop.scan x μ (fr + 1)
      (hpre.mono (by omega)) hbrute) ?_ ?_ (by omega) (by simp; omega)
    · rintro _ μ' ⟨hseg, hkept⟩
      exact ⟨hseg, fun c hc => hkept c ⟨by omega, hc.2⟩⟩
    · constructor
      · intro e he
        simp only [List.mem_cons, List.not_mem_nil, or_false] at he
        have hsp := hok₀.space
        rcases he with rfl | rfl | rfl | rfl | rfl | rfl | rfl
        all_goals simp [Expr.Safe, et17LocA]
        refine ⟨⟨by omega, by omega⟩, ?_⟩
        simp only [Limits.Addr]
        omega
      · simp [et17LocA, hcell]
  rw [if_neg hs]
  refine Ends.iteLast (fun h => absurd h (by simp [et17LocA, hs])) (fun _ => ?_) (by simp; omega)
  -- otherwise: the sizes, then the tables and the loop over the instances
  have hbig := not_smallCase_iff.1 hs
  have htime := MidTime.midRunTime_le hpre' hbig Tn
  refine Ends.next _ ((et17Sizes_spec C.et x.toTriInst μ (fr + 1) D g _ _ hpre' hbig hok₀).mono
    le_rfl ?_) (by unfold midHostMain; simp; omega)
  rintro _ ⟨μ', rfl, hk⟩
  have hpre₁ : x.Pre μ' fr := hpre.keep fun c hc => hk c (by omega)
  refine (midTables_spec C x μ' fr D g _ _ hpre₁ ((hk fr (by omega)).trans hcell)
    (fun q hq => (hk _ (by omega)).trans (hzero q hq)) hbig hok).mono
    (by unfold midHostMain; simp; omega) ?_
  rintro σ'' hk'
  have hv := midHostData_valid hpre' hbig
  refine ⟨fun q hq => ?_, fun c hc => ?_⟩
  · rw [length_aeFlags] at hq
    rw [hk' _ (by omega), withMarks_in _ hq, getElem_aeFlags]
    exact HostData.bit_marks_m hv hq
  · rw [hk' c (by omega), withMarks_out _ hc.2]
    exact hk c (by omega)

/-- **The top procedure solves all-edges Exact Triangle.** -/
theorem midTop_spec (C : MidCtx P₀ R ν pAEBrute pAELoop pScanPairsAE pCore pFill Tn need Dfun Gfun
    tD tG wD wG) {lim : Limits} {d : ℕ} (x : AEInst) (μ : ℕ → ℤ) (fr : ℕ) (hpre : x.Pre μ fr)
    (hok : (midHostNeed Dfun Gfun wD wG need x.n x.U).Ok lim fr d) :
    Ends lim (P₀ ++ R) d (aeTopBody pFill pCore)
      ⟨Light.frame [x.n, x.U, x.ab, x.bc, x.ac, x.out, fr], μ⟩
      (midHostTime Dfun Gfun tD tG Tn x.n x.U) fun σ' => aeTask.Post x μ fr (σ'.loc 0) σ'.mem := by
  have hw := hok.space
  have hcells := hok.cells
  have hdepth := hok.depth
  have hword := hok.word
  simp only [midHostNeed] at hcells hdepth hword
  have hbo := hpre.belowOut
  have hAB := hpre.apartAB
  have hBC := hpre.apartBC
  have hAC := hpre.apartAC
  have lAB := hpre.lenAB
  have lBC := hpre.lenBC
  have lAC := hpre.lenAC
  have hbAB := hpre.belowAB
  have hbBC := hpre.belowBC
  have hbAC := hpre.belowAC
  have hnn : ((x.n * x.n : ℕ) : ℤ) ≤ lim.word := by
    have : (0 : ℤ) ≤ ((midCoreNeed Dfun Gfun wD wG need x.n x.U).word : ℤ) := by positivity
    push_cast at hword ⊢
    omega
  have hcore : (midCoreNeed Dfun Gfun wD wG need x.n x.U).Ok lim (fr + 1) (d + 1) :=
    ⟨by push_cast at hword; omega, by omega, hw, by omega⟩
  unfold aeTopBody midHostTime
  -- fill(out, n², 0)
  (focus
     ((first
         | refine Light.Ends.seqSelf ?_
         | refine Light.Ends.skipLast ?_);
       (repeat
           with_unfolding_none
             first
             | refine Light.Ends.seqAssoc ?_
             | refine Light.Ends.skipThen ?_))
     (first
       |
         refine
           Light.Ends.callToThen
             ((fill_meets (d := d + 1) (dst := x.out) (n := x.n * x.n) (x := 0) C.hFill hw (by omega))
               _ (by omega))
             ?_ ?_ ?_ ?_
       |
         refine
           Light.Ends.callToThen
             (fill_meets (d := d + 1) (dst := x.out) (n := x.n * x.n) (x := 0) C.hFill hw (by omega))
             ?_ ?_ ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => omega)
     (on_goal -1 =>
         ( (try have := Light.Std.space_le (by assumption))
           (try have := Light.Std.const_le (by assumption))
           (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))
     (on_goal -1 =>
         ((rintro r₁ μ₁
               ⟨hfill, same₁⟩
                   -- mem[fr] := out
                   );
           (try with_unfolding_none refine Light.Ends.skip ?_))))
  -- mem[fr] := out
  refine Ends.storeToThen fr (x.out : ℤ) ?_ (by (( (try have := Light.Std.space_le (by assumption))
                                                   (try have := Light.Std.const_le (by assumption))
                                                   (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))) (by (first
                                                                                                                    | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil,
                                                                                                                            List.sum_cons, List.sum_nil, ])
                                                                                                                        (first
                                                                                                                          | omega
                                                                                                                          | ((ring_nf); (omega))))
                                                                                                                    | omega
                                                                                                                    |
                                                                                                                      (simp [] <;>
                                                                                                                          first
                                                                                                                          | omega
                                                                                                                          | ((ring_nf); (omega)))))
  -- the core
  set μ₂ := Function.update μ₁ fr (x.out : ℤ) with hμ₂
  have hpre₂ : x.Pre μ₂ fr :=
    { hpre with
      segAB := fun i hi => by
        rw [hμ₂, Function.update_of_ne (by omega), same₁ _ (by omega)]
        exact hpre.segAB i hi
      segBC := fun i hi => by
        rw [hμ₂, Function.update_of_ne (by omega), same₁ _ (by omega)]
        exact hpre.segBC i hi
      segAC := fun i hi => by
        rw [hμ₂, Function.update_of_ne (by omega), same₁ _ (by omega)]
        exact hpre.segAC i hi }
  have hcell : μ₂ fr = x.out := by simp [hμ₂]
  have hzero : ∀ q < x.n * x.n, μ₂ (x.out + q) = 0 := fun q hq => by
    rw [hμ₂, Function.update_of_ne (by omega)]
    have := hfill q (by simpa using hq)
    simpa using this
  have hcall : Meets lim (P₀ ++ R) pCore (d + 1) [x.n, x.U, x.ab, x.bc, x.ac, (fr + 1 : ℕ)] μ₂
      (midCoreTime Dfun Gfun tD tG Tn x.n x.U) fun _ μ' =>
        Seg μ' x.out (aeFlags x.n x.AB x.BC x.AC) ∧ KeptBut μ₂ μ' fr x.out (x.n * x.n) :=
    Meets.of_body C.hCore (midCore_spec C x μ₂ fr hpre₂ hcell hzero hcore)
  (focus
     ((first
         | refine Light.Ends.seqSelf ?_
         | refine Light.Ends.skipLast ?_);
       (repeat
           with_unfolding_none
             first
             | refine Light.Ends.seqAssoc ?_
             | refine Light.Ends.skipThen ?_))
     (first
       | refine Light.Ends.callToThen (hcall _ (by omega)) ?_ ?_ ?_ ?_
       | refine Light.Ends.callToThen hcall ?_ ?_ ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => omega)
     (on_goal -1 =>
         ( (try have := Light.Std.space_le (by assumption))
           (try have := Light.Std.const_le (by assumption))
           (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))
     (on_goal -1 =>
         ((rintro r₃ μ₃
               ⟨hseg, hkept⟩
                   -- return 0
                   );
           (try with_unfolding_none refine Light.Ends.skip ?_))))
  -- return 0
  refine Ends.setTo 0 ⟨hseg, fun c hc => ?_⟩ (by simp; omega) (by simp; omega)
  change μ₃ c = μ c
  rw [hkept c hc, hμ₂, Function.update_of_ne (by omega)]
  exact same₁ c hc.2

/-- **The context of the top procedure**, in the assembled program with anything appended to it. -/
theorem midCtx_assembled {P₀ : Program} {pS pD pG : ℕ} {Tn : List ℕ → ℕ} {need : List ℕ → Light.Need}
    {Dfun Gfun tD tG wD wG : ℕ → ℕ} (hsol : SolvesN lopDetectTask P₀ pS Tn need)
    (hD : ∀ R, ParamProc (P₀ ++ R) pD Dfun tD wD) (hG : ∀ R, ParamProc (P₀ ++ R) pG Gfun tG wG)
    (hpos : ∀ n, 1 ≤ n → 1 ≤ Dfun n) (R : Program) :
    MidCtx P₀ (midProcs pS pD pG P₀.length ++ R) (et17NumsAt pS pD pG P₀.length)
      (P₀.length + 31) (P₀.length + 30) (P₀.length + 29) (P₀.length + 32) (P₀.length + 14)
      Tn need Dfun Gfun tD tG wD wG := by
  have hR : midProcs pS pD pG P₀.length ++ R =
      et17Procs pS pD pG P₀.length ++ (midExtra pS pD pG P₀.length ++ R) := by
    rw [midProcs, List.append_assoc]
  have L : ∀ {i : ℕ} {body : Stmt}, (midExtra pS pD pG P₀.length)[i]? = some body →
      (P₀ ++ (midProcs pS pD pG P₀.length ++ R))[P₀.length + (29 + i)]? = some body := by
    intro i body h
    rw [midProcs, List.append_assoc]
    exact getElem?_append_append
      (B := et17Procs pS pD pG P₀.length ++ midExtra pS pD pG P₀.length)
      R (by rw [List.getElem?_append_right (by simp [length_et17Procs]), length_et17Procs,
        Nat.add_sub_cancel_left]; exact h)
  have hfill : (P₀ ++ (midProcs pS pD pG P₀.length ++ R))[P₀.length + 14]? = some fillBody := by
    rw [midProcs, List.append_assoc]
    exact getElem?_append_append
      (B := et17Procs pS pD pG P₀.length ++ midExtra pS pD pG P₀.length)
      R (by rw [List.getElem?_append_left (by simp [length_et17Procs])]; rfl)
  refine ⟨?_, L (i := 0) rfl, L (i := 1) rfl, L (i := 2) rfl, L (i := 3) rfl, hfill⟩
  rw [hR]
  exact et17Ctx_assembled hsol hD hG hpos _

end Light.Sec3
