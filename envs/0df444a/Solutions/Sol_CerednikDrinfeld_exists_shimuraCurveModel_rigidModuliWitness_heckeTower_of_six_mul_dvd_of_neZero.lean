def corrBarOf (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (ℓ : ℕ) (hℓ : ℓ.Prime) : Divisor (AlgebraicClosure ℚ) Fbar →+ Divisor (AlgebraicClosure ℚ) Fbar :=
  if h : ℓ = q then DistribSMul.toAddMonoidHom (Divisor (AlgebraicClosure ℚ) Fbar) (W 0)
  else if h' : ℓ = q' then DistribSMul.toAddMonoidHom (Divisor (AlgebraicClosure ℚ) Fbar) (W 1)
  else Divisor.correspondence (𝕋.φ (awayOf ℓ hℓ h h', 0)) (𝕋.φ (awayOf ℓ hℓ h h', 1))
    (𝕋.integral (awayOf ℓ hℓ h h', 0)) (𝕋.integral (awayOf ℓ hℓ h h', 1))

theorem corrBarOf_of_eq_q (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    {ℓ : ℕ} (hℓ : ℓ.Prime) (h : ℓ = q) (D : Divisor (AlgebraicClosure ℚ) Fbar) :
    corrBarOf 𝕋 W ℓ hℓ D = W 0 • D := by
  unfold corrBarOf; rw [dif_pos h]; rfl

theorem corrBarOf_of_eq_q' (hqq' : q' ≠ q) (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    {ℓ : ℕ} (hℓ : ℓ.Prime) (h : ℓ = q') (D : Divisor (AlgebraicClosure ℚ) Fbar) :
    corrBarOf 𝕋 W ℓ hℓ D = W 1 • D := by
  unfold corrBarOf; rw [dif_neg (h ▸ hqq'), dif_pos h]; rfl

theorem corrBarOf_away (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (ℓ : HeckeTower.AwayPrime q q') :
    corrBarOf 𝕋 W (ℓ.1 : ℕ) ℓ.1.prop =
      Divisor.correspondence (𝕋.φ (ℓ, 0)) (𝕋.φ (ℓ, 1)) (𝕋.integral (ℓ, 0)) (𝕋.integral (ℓ, 1)) := by
  obtain ⟨⟨l, hl⟩, h1, h2⟩ := ℓ
  unfold corrBarOf; rw [dif_neg h1, dif_neg h2]; rfl

theorem corrBarOf_away' (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    {ℓ : ℕ} (hℓ : ℓ.Prime) (h : ¬ ℓ = q) (h' : ¬ ℓ = q') :
    corrBarOf 𝕋 W ℓ hℓ =
      Divisor.correspondence (𝕋.φ (awayOf ℓ hℓ h h', 0)) (𝕋.φ (awayOf ℓ hℓ h h', 1))
        (𝕋.integral (awayOf ℓ hℓ h h', 0)) (𝕋.integral (awayOf ℓ hℓ h h', 1)) := by
  unfold corrBarOf; rw [dif_neg h, dif_neg h']

variable [IsCurveOver (AlgebraicClosure ℚ) Fbar]

def heckePic0Of (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (hFI : ∀ α : HeckeTower.Arr q q', FundamentalIdentityAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.integral α))
    (hNF : ∀ α : HeckeTower.Arr q q', NormFormulaAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.finite α))
    (ℓ : ℕ) (hℓ : ℓ.Prime) : Pic0 (AlgebraicClosure ℚ) Fbar →+ Pic0 (AlgebraicClosure ℚ) Fbar :=
  if h : ℓ = q then DistribSMul.toAddMonoidHom (Pic0 (AlgebraicClosure ℚ) Fbar) (W 0)
  else if h' : ℓ = q' then DistribSMul.toAddMonoidHom (Pic0 (AlgebraicClosure ℚ) Fbar) (W 1)
  else Pic0.correspondence (𝕋.φ (awayOf ℓ hℓ h h', 0)) (𝕋.φ (awayOf ℓ hℓ h h', 1))
    (𝕋.integral (awayOf ℓ hℓ h h', 0)) (𝕋.integral (awayOf ℓ hℓ h h', 1))
    (hFI (awayOf ℓ hℓ h h', 0)) (𝕋.finite (awayOf ℓ hℓ h h', 1)) (hNF (awayOf ℓ hℓ h h', 1))

theorem heckePic0Of_of_eq_q (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (hFI : ∀ α : HeckeTower.Arr q q', FundamentalIdentityAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.integral α))
    (hNF : ∀ α : HeckeTower.Arr q q', NormFormulaAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.finite α))
    {ℓ : ℕ} (hℓ : ℓ.Prime) (h : ℓ = q) (c : Pic0 (AlgebraicClosure ℚ) Fbar) :
    heckePic0Of 𝕋 W hFI hNF ℓ hℓ c = W 0 • c := by
  unfold heckePic0Of; rw [dif_pos h]; rfl

theorem heckePic0Of_of_eq_q' (hqq' : q' ≠ q) (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (hFI : ∀ α : HeckeTower.Arr q q', FundamentalIdentityAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.integral α))
    (hNF : ∀ α : HeckeTower.Arr q q', NormFormulaAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.finite α))
    {ℓ : ℕ} (hℓ : ℓ.Prime) (h : ℓ = q') (c : Pic0 (AlgebraicClosure ℚ) Fbar) :
    heckePic0Of 𝕋 W hFI hNF ℓ hℓ c = W 1 • c := by
  unfold heckePic0Of; rw [dif_neg (h ▸ hqq'), dif_pos h]; rfl

theorem heckePic0Of_away' (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (hFI : ∀ α : HeckeTower.Arr q q', FundamentalIdentityAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.integral α))
    (hNF : ∀ α : HeckeTower.Arr q q', NormFormulaAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.finite α))
    {ℓ : ℕ} (hℓ : ℓ.Prime) (h : ¬ ℓ = q) (h' : ¬ ℓ = q') :
    heckePic0Of 𝕋 W hFI hNF ℓ hℓ =
      Pic0.correspondence (𝕋.φ (awayOf ℓ hℓ h h', 0)) (𝕋.φ (awayOf ℓ hℓ h h', 1))
        (𝕋.integral (awayOf ℓ hℓ h h', 0)) (𝕋.integral (awayOf ℓ hℓ h h', 1))
        (hFI (awayOf ℓ hℓ h h', 0)) (𝕋.finite (awayOf ℓ hℓ h h', 1)) (hNF (awayOf ℓ hℓ h h', 1)) := by
  unfold heckePic0Of; rw [dif_neg h, dif_neg h']

end Hecke

section Slots
open CategoryTheory AlgebraicGeometry NeronModelInfra GoodReductionJacobian IsDedekindDomain AlgebraicCurve QuaternionAlgebra CerednikDrinfeld CerednikDrinfeld.QM
open scoped Quaternion TensorProduct NumberField

theorem slot_exists_sbar (D : ℕ) [NeZero D] :
    ∃ sbar : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ))),
      sbar ≫ Spec.map (CommRingCat.ofHom (algebraMap ℤ (Localization.Away ((D : ℕ) : ℤ)))) =
        Spec.map (CommRingCat.ofHom (algebraMap ℤ (AlgebraicClosure ℚ))) := by
  have hne : ((((D : ℕ) : ℤ)) : AlgebraicClosure ℚ) ≠ 0 := by
    exact_mod_cast (NeZero.ne D)
  have hunit : IsUnit (algebraMap ℤ (AlgebraicClosure ℚ) ((D : ℕ) : ℤ)) := isUnit_iff_ne_zero.mpr (by simpa using hne)
  refine ⟨Spec.map (CommRingCat.ofHom (IsLocalization.Away.lift ((D : ℕ) : ℤ) hunit)), ?_⟩
  have hcomp : (IsLocalization.Away.lift ((D : ℕ) : ℤ) hunit).comp
      (algebraMap ℤ (Localization.Away ((D : ℕ) : ℤ))) = algebraMap ℤ (AlgebraicClosure ℚ) :=
    RingHom.ext_int _ _
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]

theorem slot_exists_pts {R : Type} [CommRing R] {X : Scheme.{0}} (πX : X ⟶ Spec (CommRingCat.of R))
    (sbar : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ Spec (CommRingCat.of R))
    {Fbar : Type} [Field Fbar] [Algebra (AlgebraicClosure ℚ) Fbar]
    (𝔐 : AlgebraicCurve.CurveModel (AlgebraicClosure ℚ) Fbar)
    (e𝔐 : 𝔐.C ⟶ CategoryTheory.Limits.pullback πX sbar) [IsIso e𝔐]
    (he : e𝔐 ≫ CategoryTheory.Limits.pullback.snd πX sbar = 𝔐.toBase) :
    ∃ pts : Place (AlgebraicClosure ℚ) Fbar ≃ SchemeHomOver sbar πX,
      ∀ P : Place (AlgebraicClosure ℚ) Fbar,
        (pts P).1 = (𝔐.pointEquivPlace.symm P).1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar := by

  let fwd : {p : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ 𝔐.C // p ≫ 𝔐.toBase = 𝟙 _} → SchemeHomOver sbar πX :=
    fun p => ⟨p.1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar, by
      simp only [Category.assoc]
      rw [CategoryTheory.Limits.pullback.condition, reassoc_of% he, reassoc_of% p.2]⟩

  let bwd : SchemeHomOver sbar πX → {p : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ 𝔐.C // p ≫ 𝔐.toBase = 𝟙 _} :=
    fun x => ⟨CategoryTheory.Limits.pullback.lift x.1 (𝟙 _) (by rw [Category.id_comp]; exact x.2) ≫ inv e𝔐, by
      rw [Category.assoc, ← he, IsIso.inv_hom_id_assoc, CategoryTheory.Limits.pullback.lift_snd]⟩
  refine ⟨𝔐.pointEquivPlace.symm.trans ⟨fwd, bwd, ?_, ?_⟩, fun P => rfl⟩
  · intro p
    apply Subtype.ext
    show CategoryTheory.Limits.pullback.lift (p.1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar) (𝟙 _) _ ≫ inv e𝔐 = p.1
    rw [IsIso.comp_inv_eq]
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Limits.pullback.lift_fst, Category.assoc]
    · rw [CategoryTheory.Limits.pullback.lift_snd, Category.assoc, he, p.2]
  · intro x
    apply Subtype.ext
    show (CategoryTheory.Limits.pullback.lift x.1 (𝟙 _) _ ≫ inv e𝔐) ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar = x.1
    rw [Category.assoc, IsIso.inv_hom_id_assoc, CategoryTheory.Limits.pullback.lift_fst]

theorem slot_pp_laws {F F' : Type} [Field F] [Field F'] [Algebra (AlgebraicClosure ℚ) F] [Algebra (AlgebraicClosure ℚ) F']
    [IsCurveOver (AlgebraicClosure ℚ) F] [Algebra.EssFiniteType (AlgebraicClosure ℚ) F]
    [IsCurveOver (AlgebraicClosure ℚ) F'] [Algebra.EssFiniteType (AlgebraicClosure ℚ) F']
    (φ : F →ₐ[AlgebraicClosure ℚ] F') (hfin : FiniteAlong (AlgebraicClosure ℚ) φ) (hint : φ.toRingHom.IsIntegral) :
    FundamentalIdentityAlong (AlgebraicClosure ℚ) φ hint ∧ NormFormulaAlong (AlgebraicClosure ℚ) φ hfin := by
  haveI : CharZero F := charZero_of_injective_algebraMap (algebraMap (AlgebraicClosure ℚ) F).injective
  have hsep : SeparableAlong (AlgebraicClosure ℚ) φ := AlgebraicCurve.separableAlong_of_charZero φ hint
  exact ⟨AlgebraicCurve.fundamentalIdentityAlong φ hint hfin hsep, AlgebraicCurve.normFormulaAlong_of_separableAlong φ hfin hsep⟩

end Slots

section Slots2
open AlgebraicCurve CerednikDrinfeld

variable {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] {Fbar : Type} [Field Fbar] [Algebra (AlgebraicClosure ℚ) Fbar]
  [IsCurveOver (AlgebraicClosure ℚ) Fbar]

theorem slot_heckePic0Of_comm (hqq' : q' ≠ q) (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (WT : ∀ ℓ : HeckeTower.AwayPrime q q', Fin 2 → SemilinearAut (AlgebraicClosure ℚ) (𝕋.F ℓ))
    (hFI : ∀ α : HeckeTower.Arr q q', FundamentalIdentityAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.integral α))
    (hNF : ∀ α : HeckeTower.Arr q q', NormFormulaAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.finite α))
    (hW_comm : W 0 * W 1 = W 1 * W 0)
    (hWT_φ : ∀ (α : HeckeTower.Arr q q') i (x : Fbar), WT α.1 i • 𝕋.φ α x = 𝕋.φ α (W i • x))
    (hcomm : ∀ (ℓ ℓ' : HeckeTower.AwayPrime q q') (D : Divisor (AlgebraicClosure ℚ) Fbar),
      Divisor.correspondence (𝕋.φ (ℓ, 0)) (𝕋.φ (ℓ, 1)) (𝕋.integral (ℓ, 0)) (𝕋.integral (ℓ, 1))
        (Divisor.correspondence (𝕋.φ (ℓ', 0)) (𝕋.φ (ℓ', 1)) (𝕋.integral (ℓ', 0)) (𝕋.integral (ℓ', 1)) D) =
      Divisor.correspondence (𝕋.φ (ℓ', 0)) (𝕋.φ (ℓ', 1)) (𝕋.integral (ℓ', 0)) (𝕋.integral (ℓ', 1))
        (Divisor.correspondence (𝕋.φ (ℓ, 0)) (𝕋.φ (ℓ, 1)) (𝕋.integral (ℓ, 0)) (𝕋.integral (ℓ, 1)) D))
    (ℓ ℓ' : ℕ) (hℓ : ℓ.Prime) (hℓ' : ℓ'.Prime) :
    (heckePic0Of 𝕋 W hFI hNF ℓ hℓ).comp (heckePic0Of 𝕋 W hFI hNF ℓ' hℓ') =
      (heckePic0Of 𝕋 W hFI hNF ℓ' hℓ').comp (heckePic0Of 𝕋 W hFI hNF ℓ hℓ) := by

  apply AddMonoidHom.ext; intro c
  simp only [AddMonoidHom.comp_apply]

  have away_W : ∀ (i : Fin 2) {l : ℕ} (hl : l.Prime) (h1 : ¬ l = q) (h2 : ¬ l = q') (x : Pic0 (AlgebraicClosure ℚ) Fbar),
      heckePic0Of 𝕋 W hFI hNF l hl (W i • x) = W i • heckePic0Of 𝕋 W hFI hNF l hl x := by
    intro i l hl h1 h2 x
    rw [heckePic0Of_away' _ _ _ _ hl h1 h2]
    apply AlgebraicCurve.SemilinearAut.pic0_correspondence_smul
    · exact fun y => hWT_φ (awayOf l hl h1 h2, 0) i y
    · exact fun y => hWT_φ (awayOf l hl h1 h2, 1) i y
  have away_away : ∀ {l l' : ℕ} (hl : l.Prime) (hl' : l'.Prime) (h1 : ¬ l = q) (h2 : ¬ l = q') (h1' : ¬ l' = q) (h2' : ¬ l' = q')
      (x : Pic0 (AlgebraicClosure ℚ) Fbar),
      heckePic0Of 𝕋 W hFI hNF l hl (heckePic0Of 𝕋 W hFI hNF l' hl' x) =
        heckePic0Of 𝕋 W hFI hNF l' hl' (heckePic0Of 𝕋 W hFI hNF l hl x) := by
    intro l l' hl hl' h1 h2 h1' h2' x
    obtain ⟨D, rfl⟩ := Pic0.mk_surjective x
    rw [heckePic0Of_away' _ _ _ _ hl h1 h2, heckePic0Of_away' _ _ _ _ hl' h1' h2']
    simp only [Pic0.correspondence_mk]
    congr 1
    apply Subtype.ext
    simp only [Pic0.coe_degZeroCorrespondence]
    exact hcomm (awayOf l hl h1 h2) (awayOf l' hl' h1' h2') (D : Divisor (AlgebraicClosure ℚ) Fbar)
  by_cases h1 : ℓ = q
  · by_cases h1' : ℓ' = q
    · rw [heckePic0Of_of_eq_q _ _ _ _ hℓ h1, heckePic0Of_of_eq_q _ _ _ _ hℓ' h1',
        heckePic0Of_of_eq_q _ _ _ _ hℓ h1, heckePic0Of_of_eq_q _ _ _ _ hℓ' h1']
    · by_cases h2' : ℓ' = q'
      · rw [heckePic0Of_of_eq_q _ _ _ _ hℓ h1, heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ' h2',
          heckePic0Of_of_eq_q _ _ _ _ hℓ h1, heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ' h2', ← mul_smul, ← mul_smul, hW_comm]
      · rw [heckePic0Of_of_eq_q _ _ _ _ hℓ h1, heckePic0Of_of_eq_q _ _ _ _ hℓ h1, away_W 0 hℓ' h1' h2']
  · by_cases h2 : ℓ = q'
    · by_cases h1' : ℓ' = q
      · rw [heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ h2, heckePic0Of_of_eq_q _ _ _ _ hℓ' h1',
          heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ h2, heckePic0Of_of_eq_q _ _ _ _ hℓ' h1', ← mul_smul, ← mul_smul, hW_comm]
      · by_cases h2' : ℓ' = q'
        · rw [heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ h2, heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ' h2',
            heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ h2, heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ' h2']
        · rw [heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ h2, heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ h2, away_W 1 hℓ' h1' h2']
    · by_cases h1' : ℓ' = q
      · rw [heckePic0Of_of_eq_q _ _ _ _ hℓ' h1', heckePic0Of_of_eq_q _ _ _ _ hℓ' h1', away_W 0 hℓ h1 h2]
      · by_cases h2' : ℓ' = q'
        · rw [heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ' h2', heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ' h2', away_W 1 hℓ h1 h2]
        · exact away_away hℓ hℓ' h1 h2 h1' h2' c

theorem slot_gal_smul_heckePic0Of (hqq' : q' ≠ q) (𝕋 : HeckeTower.TowerData q q' Fbar) (W : Fin 2 → SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (gal : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) →* SemilinearAut (AlgebraicClosure ℚ) Fbar)
    (galT : ∀ ℓ : HeckeTower.AwayPrime q q', (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) →* SemilinearAut (AlgebraicClosure ℚ) (𝕋.F ℓ))
    (hFI : ∀ α : HeckeTower.Arr q q', FundamentalIdentityAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.integral α))
    (hNF : ∀ α : HeckeTower.Arr q q', NormFormulaAlong (AlgebraicClosure ℚ) (𝕋.φ α) (𝕋.finite α))
    (hW_gal : ∀ i σ, W i * gal σ = gal σ * W i)
    (hgalT_φ : ∀ (α : HeckeTower.Arr q q') (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (x : Fbar),
      galT α.1 σ • 𝕋.φ α x = 𝕋.φ α (gal σ • x))
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (ℓ : ℕ) (hℓ : ℓ.Prime) (c : Pic0 (AlgebraicClosure ℚ) Fbar) :
    gal σ • heckePic0Of 𝕋 W hFI hNF ℓ hℓ c = heckePic0Of 𝕋 W hFI hNF ℓ hℓ (gal σ • c) := by
  by_cases h : ℓ = q
  · rw [heckePic0Of_of_eq_q _ _ _ _ hℓ h, heckePic0Of_of_eq_q _ _ _ _ hℓ h, ← mul_smul, ← mul_smul, hW_gal]
  · by_cases h' : ℓ = q'
    · rw [heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ h', heckePic0Of_of_eq_q' hqq' _ _ _ _ hℓ h', ← mul_smul, ← mul_smul, hW_gal]
    · rw [heckePic0Of_away' _ _ _ _ hℓ h h']
      symm
      apply AlgebraicCurve.SemilinearAut.pic0_correspondence_smul
      · exact fun x => hgalT_φ (awayOf ℓ hℓ h h', 0) σ x
      · exact fun x => hgalT_φ (awayOf ℓ hℓ h h', 1) σ x

end Slots2

section Main
open scoped TensorProduct Quaternion NumberField MatrixGroups
open IsDedekindDomain QuaternionAlgebra CerednikDrinfeld ModularCurve AlgebraicCurve
open CerednikDrinfeld.Mumford CerednikDrinfeld.Omega
open scoped Classical
open CategoryTheory
theorem solution
    {N q q' : ℕ} [NeZero N] (hN : Squarefree N) [Fact q.Prime] [Fact q'.Prime]
    (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hqq' : q' ≠ q)
    (D : ℕ) [NeZero D] (hD : 6 * N * q * q' ∣ D)
    (hq5 : 5 ≤ q) (hq'5 : 5 ≤ q')

    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (R : Submodule ℤ ℍ[ℚ, a, b]) (hR : IsEichlerOrder R N)
    (ι : ℍ[ℚ, a, b] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ℝ) (hι : Function.Injective ι)
    :
    ∃ (Λ : Submodule ℤ ℍ[ℚ, a, b]) (_ : IsMaximalOrder Λ) (_ : R ≤ Λ),
    ∃ M : ShimuraCurveModel R ι (fun ℓ => if ℓ ∣ N then levelHeckeUSet Λ R ℓ else primeHeckeSet R ℓ),
      ∃ w : M.ModuliWitnessD Λ N q q' D, w.IsOriented ∧ w.IsGoodReductionModel ∧
      (∀ (B : ValuationSubring (AlgebraicClosure ℚ)), IsUnit (((N * q * q' : ℕ) : ℤ) : ↥B) →
      ∀ E : CerednikDrinfeld.QM.FakeEllipticCurve Λ N (AlgebraicClosure ℚ), ∃ 𝒜 : CerednikDrinfeld.QM.FakeEllipticCurve Λ N ↥B,
        CerednikDrinfeld.QM.FakeEllipticCurve.IsPullback (B.subtype : ↥B →+* AlgebraicClosure ℚ) 𝒜 E) ∧
