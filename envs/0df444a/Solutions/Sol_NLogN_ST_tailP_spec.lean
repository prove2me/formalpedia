  rw [hs] at this; omega

end RS

/-- Shared step of the loop cost bounds: the decrement in iteration `k` reads `N - k`. -/
theorem withCtr_dec_le {B : ℕ} (i : Fin HS) (s t : IState HS) (n : Ex HS) (k : ℕ)
    (hk : k < (n.eval s).toNat) (hB : zsz (n.eval s) ≤ B) :
