/-- A triple with total `total` whose first two coordinates are `a, b` whenever `a + b ≤ total`. -/
def normTriple (total a b : ℕ) : Fin 3 → ℕ :=
  ![min a total, min b (total - min a total), total - min a total - min b (total - min a total)]

theorem normTriple_sum (total a b : ℕ) :
    normTriple total a b 0 + normTriple total a b 1 + normTriple total a b 2 = total := by
  simp only [normTriple, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.head_cons, Matrix.tail_cons]
  omega

def parent3 (ρ : Fin 6) (r : Fin 88) : Fin 3 → ℕ :=
  normTriple 8 (termShape (term3 ρ r) (ReleasedGlobal.roles ρ 0))
    (termShape (term3 ρ r) (ReleasedGlobal.roles ρ 1))

theorem htotal3 (ρ : Fin 6) :
    ∀ r, parent3 ρ r 0 + parent3 ρ r 1 + parent3 ρ r 2 = 2 * (2 * 2 ^ (2 - 1)) :=
  fun r ↦ normTriple_sum 8 _ _

def n3 (ρ : Fin 6) (r : Fin 88) : ℕ :=
  termGalpha (term3 ρ r) * termRegion (term3 ρ r) ρ * denominator ^ 3

def m3 (ρ : Fin 6) (r : Fin 88) (c : RecursiveThinSplit.Split (2 * 2 ^ (2 - 1)) (parent3 ρ r)) : ℕ :=
  termGalpha (term3 ρ r) * termRegion (term3 ρ r) ρ *
    termAlpha (term3 ρ r) ρ (physOf ρ fun i ↦ (c.val i).val) * denominator ^ 2

def mu3 (ρ : Fin 6) (i : Fin 3) (c : Cell (2 * 2 ^ (2 - 1)) 88 (parent3 ρ))
    (w : CompleteSplit.CompleteWord 2) : ℕ :=
  (m3 ρ c.1 c.2 + m3 ρ c.1 (complement (htotal3 ρ c.1) c.2)) *
    childP (physOf ρ fun i ↦ (c.2.val i).val)
      (termS0 (term3 ρ c.1) ρ (physOf ρ fun i ↦ (c.2.val i).val))
      (ReleasedGlobal.roles ρ i) (w 0).val (w 1).val / denominator

