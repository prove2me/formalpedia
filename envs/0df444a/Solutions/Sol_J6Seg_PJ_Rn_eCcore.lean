/-!
# B-line IL, `J` pre-table (B5-J), part 10: straight-line instruction lists

`Ins`: `a` (register assignment), `rd` (random read `dst := X[e]`), `pu` (push), `po` (pop), `en`
(`d := expNeg n k j`, the library program through `PreT.callC`). `Ins.run` is the effect on
`(v, c)`, `Ins.ok W N` the side conditions (values `≤ 2^W`, read lists of length `≤ N`), and
`Rn.insL`: a list of instructions runs as its `runL`, at cost `costL W N`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function IntMul.HvdH

namespace Ins

end Ins

/-! ## Lists of instructions -/

/-- **A straight-line block.** -/
theorem Rn.insL {W N : ℕ} (hN : N ≤ 2 ^ W) : ∀ (l : List Ins) {v : Vr} {c : Cs}, BV W v →
    OkL W N l (v, c) →
    Rn (progL l) v c (fun v' => v' = (runL l (v, c)).1 ∧ BV W v') (runL l (v, c)).2 (costL W N l)
  | [], v, c, hv, _ => (Rn.skip v c).mono (fun v' h => ⟨h, h ▸ hv⟩) le_rfl
  | i :: l, v, c, hv, ⟨hi, hl⟩ => by
    refine Rn.seq (Rn.ins1 hN hv i hi) (fun v1 ⟨e1, b1⟩ => ?_)
    subst e1
    have h := Rn.insL hN l b1 (c := (i.run (v, c)).2) (by rwa [Prod.mk.eta])
    simp only [runL]
    rwa [Prod.mk.eta] at h

end J6Seg.PJ

