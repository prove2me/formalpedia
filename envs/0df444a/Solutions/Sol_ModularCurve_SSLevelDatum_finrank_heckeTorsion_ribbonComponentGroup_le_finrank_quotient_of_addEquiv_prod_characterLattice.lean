section Generic

variable {ι : Type*}

def IsWidthAdjoint (w : ι → ℕ) (T A : Matrix ι ι ℤ) : Prop :=
  ∀ i j, (w i : ℤ) * T i j = (w j : ℤ) * A j i

def widthAdjoint (w : ι → ℕ) (T : Matrix ι ι ℤ) : Matrix ι ι ℤ :=
  Matrix.of fun j i => ((w i : ℤ) * T i j) / (w j : ℤ)

theorem widthAdjoint_apply (w : ι → ℕ) (T : Matrix ι ι ℤ) (j i : ι) :
    widthAdjoint w T j i = ((w i : ℤ) * T i j) / (w j : ℤ) := rfl

theorem isWidthAdjoint_widthAdjoint {w : ι → ℕ} {T : Matrix ι ι ℤ}
    (hdvd : ∀ i j, (w j : ℤ) ∣ (w i : ℤ) * T i j) : IsWidthAdjoint w T (widthAdjoint w T) := by
  intro i j
  rw [widthAdjoint_apply, Int.mul_ediv_cancel' (hdvd i j)]

namespace IsWidthAdjoint

variable {w : ι → ℕ} {T S A B : Matrix ι ι ℤ}

theorem unique (hw : ∀ i, 0 < w i) (hA : IsWidthAdjoint w T A) (hB : IsWidthAdjoint w T B) : A = B := by
  ext j i
  have h := (hA i j).symm.trans (hB i j)
  have hne : (w j : ℤ) ≠ 0 := by exact_mod_cast (hw j).ne'
  exact mul_left_cancel₀ hne h

theorem dvd (hA : IsWidthAdjoint w T A) (i j : ι) : (w j : ℤ) ∣ (w i : ℤ) * T i j :=
  ⟨A j i, hA i j⟩

theorem widthAdjoint_eq (hw : ∀ i, 0 < w i) (hA : IsWidthAdjoint w T A) : widthAdjoint w T = A :=
  (isWidthAdjoint_widthAdjoint hA.dvd).unique hw hA

theorem symm (hA : IsWidthAdjoint w T A) : IsWidthAdjoint w A T := fun i j => (hA j i).symm

theorem apply_eq (hw : ∀ i, 0 < w i) (hA : IsWidthAdjoint w T A) (j i : ι) :
    A j i = ((w i : ℤ) * T i j) / (w j : ℤ) := by
  rw [← hA.widthAdjoint_eq hw, widthAdjoint_apply]

theorem mul [Fintype ι] (hA : IsWidthAdjoint w T A) (hB : IsWidthAdjoint w S B) :
    IsWidthAdjoint w (T * S) (B * A) := by
  intro i j
  simp only [Matrix.mul_apply, Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  have h1 := hA i k
  have h2 := hB k j
  calc (w i : ℤ) * (T i k * S k j) = ((w i : ℤ) * T i k) * S k j := by ring
    _ = (w k : ℤ) * A k i * S k j := by rw [h1]
    _ = A k i * ((w k : ℤ) * S k j) := by ring
    _ = A k i * ((w j : ℤ) * B j k) := by rw [h2]
    _ = (w j : ℤ) * (B j k * A k i) := by ring

theorem commute [Fintype ι] (hw : ∀ i, 0 < w i) (hA : IsWidthAdjoint w T A) (hB : IsWidthAdjoint w S B)
    (h : Commute T S) : Commute A B := by
  have h1 : IsWidthAdjoint w (T * S) (B * A) := hA.mul hB
  have h2 : IsWidthAdjoint w (S * T) (A * B) := hB.mul hA
  rw [h.eq] at h1
  show A * B = B * A
  exact h2.unique hw h1

theorem widthPairing_mulVec [Fintype ι] (hA : IsWidthAdjoint w T A) (x y : ι → ℤ) :
    widthPairing w (T.mulVec x) y = widthPairing w x (A.mulVec y) := by
  simp only [widthPairing_apply, Matrix.mulVec, dotProduct]
  calc ∑ i, (w i : ℤ) * ((∑ j, T i j * x j) * y i)
      = ∑ i, ∑ j, (w i : ℤ) * T i j * x j * y i := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Finset.sum_mul, Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
    _ = ∑ i, ∑ j, (w j : ℤ) * A j i * x j * y i := by
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
        rw [hA i j]
    _ = ∑ j, ∑ i, (w j : ℤ) * A j i * x j * y i := Finset.sum_comm
    _ = ∑ j, (w j : ℤ) * (x j * ∑ i, A j i * y i) := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [Finset.mul_sum, Finset.mul_sum]
        exact Finset.sum_congr rfl fun i _ => by ring

end IsWidthAdjoint

theorem isWidthAdjoint_self_iff (w : ι → ℕ) (T : Matrix ι ι ℤ) :
    IsWidthAdjoint w T T ↔ HeckeWeightSymm w T.transpose := by
  constructor
  · intro h i j
    simpa only [Matrix.transpose_apply] using (h i j).symm
  · intro h i j
    simpa only [Matrix.transpose_apply] using (h i j).symm

theorem mulVec_eq_heckeDivisorAction [Fintype ι] (A : Matrix ι ι ℤ) (x : ι → ℤ) :
    A.mulVec x = heckeDivisorAction A.transpose x := by
  funext j
  simp [heckeDivisorAction_apply, Matrix.mulVec, dotProduct, Matrix.transpose_apply]

theorem mulVec_mem_characterLattice [Fintype ι] {A : Matrix ι ι ℤ} {c : ℤ} (hc : ∀ i, ∑ j, A j i = c)
    {x : ι → ℤ} (hx : x ∈ characterLattice ι) : A.mulVec x ∈ characterLattice ι := by
  rw [mulVec_eq_heckeDivisorAction]
  refine heckeDivisorAction_mem_characterLattice (B := A.transpose) (n := c) ?_ hx
  intro i
  simpa only [Matrix.transpose_apply] using hc i

def permMat [DecidableEq ι] (σ : Equiv.Perm ι) : Matrix ι ι ℤ := Matrix.of fun i j => if i = σ j then 1 else 0

theorem permMat_apply [DecidableEq ι] (σ : Equiv.Perm ι) (i j : ι) :
    permMat σ i j = if i = σ j then 1 else 0 := rfl

theorem permMat_transpose_mul [Fintype ι] [DecidableEq ι] (σ : Equiv.Perm ι) :
    (permMat σ).transpose * permMat σ = 1 := by
  ext j k
  simp only [Matrix.mul_apply, Matrix.transpose_apply, permMat_apply, Matrix.one_apply]
  rw [Finset.sum_eq_single (σ j)]
  · by_cases h : j = k
    · subst h; simp
    · have : ¬ σ j = σ k := fun e => h (σ.injective e)
      simp [this, h]
  · intro i _ hi
    simp [hi]
  · intro h
    exact absurd (Finset.mem_univ _) h

theorem permMat_mul_transpose [Fintype ι] [DecidableEq ι] (σ : Equiv.Perm ι) :
    permMat σ * (permMat σ).transpose = 1 := by
  ext i k
  simp only [Matrix.mul_apply, Matrix.transpose_apply, permMat_apply, Matrix.one_apply]
  rw [Finset.sum_eq_single (σ.symm i)]
  · simp only [Equiv.apply_symm_apply]
    by_cases h : i = k
    · subst h; simp
    · have : ¬ k = i := fun e => h e.symm
      simp [this, h]
  · intro j _ hj
    have : ¬ i = σ j := fun e => hj (by rw [e, Equiv.symm_apply_apply])
    simp [this]
  · intro h
    exact absurd (Finset.mem_univ _) h

theorem permMat_rowsum [Fintype ι] [DecidableEq ι] (σ : Equiv.Perm ι) (i : ι) : ∑ j, permMat σ i j = 1 := by
  simp only [permMat_apply]
  rw [Finset.sum_eq_single (σ.symm i)]
  · simp
  · intro j _ hj
    have : ¬ i = σ j := fun e => hj (by rw [e, Equiv.symm_apply_apply])
    simp [this]
  · intro h
    exact absurd (Finset.mem_univ _) h

theorem isWidthAdjoint_permMat_transpose [DecidableEq ι] {w : ι → ℕ} (σ : Equiv.Perm ι)
    (hw : ∀ j, w (σ j) = w j) : IsWidthAdjoint w (permMat σ) (permMat σ).transpose := by
  intro i j
  simp only [Matrix.transpose_apply, permMat_apply]
  by_cases h : i = σ j
  · subst h; simp [hw]
  · simp [h]

theorem intertwine_transpose_of_perm [Fintype ι] [DecidableEq ι] {ι' : Type*} [Fintype ι'] [DecidableEq ι']
    (Am : Matrix ι' ι ℤ) (σ : Equiv.Perm ι) (τ : Equiv.Perm ι')
    (h : Am * permMat σ = permMat τ * Am) :
    Am * (permMat σ).transpose = (permMat τ).transpose * Am := by
  calc Am * (permMat σ).transpose
      = ((permMat τ).transpose * permMat τ) * Am * (permMat σ).transpose := by
          rw [permMat_transpose_mul, Matrix.one_mul]
    _ = (permMat τ).transpose * (permMat τ * Am) * (permMat σ).transpose := by
          rw [Matrix.mul_assoc _ _ Am]
    _ = (permMat τ).transpose * (Am * permMat σ) * (permMat σ).transpose := by rw [h]
    _ = (permMat τ).transpose * Am * (permMat σ * (permMat σ).transpose) := by
          simp only [Matrix.mul_assoc]
    _ = (permMat τ).transpose * Am := by rw [permMat_mul_transpose, Matrix.mul_one]

end Generic

