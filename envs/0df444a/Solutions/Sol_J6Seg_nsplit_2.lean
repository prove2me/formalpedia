    rw [Finset.disjoint_left]
    intro h hF hH
    obtain ⟨k, hk, rfl⟩ := mem_image.1 hF
    rw [mem_blS] at hk
    obtain ⟨_, _, _, hout⟩ := mem_Hset hH
    exact hout ⟨by omega, by omega⟩
