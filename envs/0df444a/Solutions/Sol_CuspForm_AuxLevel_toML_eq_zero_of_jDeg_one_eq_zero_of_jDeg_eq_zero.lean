    exact (hunit.map (i₃ : 𝒪₃ →+* F)).ne_zero h'

  have hχFNE : ∃ (ℓ₀' : ℕ) (hℓ₀' : ℓ₀'.Prime) (hℓ₀'N : ¬ ℓ₀' ∣ N) (hℓ₀'S : ℓ₀' ∉ (↑S : Set ℕ)),
