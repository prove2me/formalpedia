/-! #### Certified fast evaluation of the coefficients of `η²⁴` up to `q⁴⁹`

`tauEtaPowVec 49 24` performs 24 truncated convolutions over `Vector`/`Fin` sums, which the
kernel evaluates slowly. Below, the same coefficients are computed by repeated squaring on plain
integer lists (`η² , η⁴, η⁸, η¹⁶`, then `η¹⁶ · η⁸`), five truncated products in all. Each list
product is proved to compute the coefficients of the power-series product
(`tauListMul_getD`), so the list for `η²⁴` equals the coefficients of `(etaPS ℤ)^24`; the vector
side equals them by `tauEtaPowVec_spec`. Only the final 50-entry comparison of the fast list with
the stated table is a kernel computation. -/

/-- Dot product of two integer lists (stops at the shorter one). -/
def tauListDot : List Int → List Int → Int
  | x :: xs, y :: ys => x * y + tauListDot xs ys
  | _, _ => 0

/-- Truncated product of two coefficient lists, keeping coefficients `0..N`: coefficient `j`
is the dot product of `a` with the reversed prefix `b_j, …, b_0`. -/
def tauListMul (N : Nat) (a b : List Int) : List Int :=
  (List.range (N + 1)).map fun j => tauListDot a (b.take (j + 1)).reverse

/-- Coefficients `0..N` of `(q;q)_∞`, from Euler's pentagonal theorem. -/
def tauEtaList (N : Nat) : List Int := (List.range (N + 1)).map tauEtaCoeffZ

/-- Coefficients `0..N` of `(q;q)_∞^24` by repeated squaring: `η²⁴ = η¹⁶ · η⁸`. -/
def tauEta24List (N : Nat) : List Int :=
  let e1 := tauEtaList N
  let e2 := tauListMul N e1 e1
  let e4 := tauListMul N e2 e2
  let e8 := tauListMul N e4 e4
  let e16 := tauListMul N e8 e8
  tauListMul N e16 e8

/-- Port helper: `Vector.get` agrees with `getElem` (no simp lemma in Lean 4.33). -/
@[simp] theorem vector_get_eq_getElem_port {α : Type*} {n : Nat} (v : Vector α n) (i : Fin n) :
    v.get i = v[i.1] := rfl

