variable {C : Type} [CommRing C] {MC : Scheme.{0}} {g : MC ⟶ Spec (CommRingCat.of C)} {PR : AlgFunctor C}
  (toM : ∀ (T : Type) [CommRing T] [Algebra C T], PR.obj T → SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) g)
  {Xsd : Scheme.{0}} (ξd : Xsd ⟶ MC)
  (ptsd : ∀ (T : Type) [CommRing T] [Algebra C T],
    SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξd ≫ g) → PR.obj T)
  {Xb : Scheme.{0}} (ι : Xb ⟶ Xsd)

def ξb : Xb ⟶ MC := ι ≫ ξd

omit toM ptsd in
theorem ξb_def : ξb ξd ι = ι ≫ ξd := rfl

def push (T : Type) [CommRing T] [Algebra C T]
    (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ξd ι ≫ g)) :
    SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξd ≫ g) :=
  ⟨x.1 ≫ ι, by rw [Category.assoc]; simpa [ξb, Category.assoc] using x.2⟩

omit toM ptsd in
@[scoped simp] theorem push_val (T : Type) [CommRing T] [Algebra C T]
    (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ξd ι ≫ g)) :
    (push ξd ι T x).1 = x.1 ≫ ι := rfl

def pt₀ (T : Type) [CommRing T] [Algebra C T]
    (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ξd ι ≫ g)) : PR.obj T :=
  ptsd T (push ξd ι T x)

theorem p1
    (hs1d : ∀ (T : Type) [CommRing T] [Algebra C T]
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξd ≫ g)), (toM T (ptsd T x)).1 = x.1 ≫ ξd) :
    ∀ (T : Type) [CommRing T] [Algebra C T]
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ξd ι ≫ g)),
      (toM T (pt₀ ξd ptsd ι T x)).1 = x.1 ≫ ξb ξd ι := by
  intro T _ _ x
  rw [pt₀, hs1d, push_val, Category.assoc]
  rfl

theorem p2
    (hs2d : ∀ (T T' : Type) [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T'] (φ : T →ₐ[C] T')
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξd ≫ g))
      (x' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T'))) (ξd ≫ g)),
      x'.1 = Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ x.1 → ptsd T' x' = PR.map φ (ptsd T x)) :
    ∀ (T T' : Type) [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T'] (φ : T →ₐ[C] T')
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ξd ι ≫ g))
      (x' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T'))) (ξb ξd ι ≫ g)),
      x'.1 = Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ x.1 → pt₀ ξd ptsd ι T' x' = PR.map φ (pt₀ ξd ptsd ι T x) := by
  intro T T' _ _ _ _ φ x x' h
  unfold pt₀
  apply hs2d
  rw [push_val, push_val, h, Category.assoc]

theorem p3 (p : C) [Mono ι]
    (Rep : ∀ (T : Type) [CommRing T] [Algebra C T], Type)
    (cls : ∀ (T : Type) [CommRing T] [Algebra C T], Rep T → PR.obj T)
    (ptXd : ∀ (T : Type) [CommRing T] [Algebra C T], algebraMap C T p = 0 → Rep T →
      SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξd ≫ g))
    (IsoNS : ∀ (T : Type) [CommRing T] [Algebra C T], Rep T → Rep T → Prop)
    (Nrm : ∀ (T : Type) [CommRing T] [Algebra C T], Rep T → Prop)
    (hx1 : ∀ (T : Type) [CommRing T] [Algebra C T] (h0 : algebraMap C T p = 0) (ρ : Rep T), ptsd T (ptXd T h0 ρ) = cls T ρ)
    (hx3 : ∀ (T : Type) [CommRing T] [Algebra C T] (h0 : algebraMap C T p = 0)
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξd ≫ g)), ∃ ρ : Rep T, ptXd T h0 ρ = x)
    (hx4 : ∀ (T : Type) [CommRing T] [Algebra C T] (h0 : algebraMap C T p = 0) (ρ ρ' : Rep T),
      ptXd T h0 ρ = ptXd T h0 ρ' ↔ IsoNS T ρ ρ')
    (HB : ∀ (T : Type) [CommRing T] [Algebra C T] (h0 : algebraMap C T p = 0) (ρ : Rep T),
      (∃ x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ξd ι ≫ g), x.1 ≫ ι = (ptXd T h0 ρ).1) ↔ Nrm T ρ)
    (KEY : ∀ (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] (h0 : algebraMap C T p = 0) (ρ ρ' : Rep T),
      cls T ρ = cls T ρ' → Nrm T ρ → Nrm T ρ' → IsoNS T ρ ρ') :
    ∀ (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T], algebraMap C T p = 0 →
      ∀ (x x' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ξd ι ≫ g)),
        pt₀ ξd ptsd ι T x = pt₀ ξd ptsd ι T x' → x = x' := by
  intro T _ _ _ h0 x x' h
  obtain ⟨ρ, hρ⟩ := hx3 T h0 (push ξd ι T x)
  obtain ⟨ρ', hρ'⟩ := hx3 T h0 (push ξd ι T x')
  have hcls : cls T ρ = cls T ρ' := by
    rw [← hx1 T h0 ρ, ← hx1 T h0 ρ', hρ, hρ']
    exact h
  have hn : Nrm T ρ := (HB T h0 ρ).1 ⟨x, by rw [hρ]; rfl⟩
  have hn' : Nrm T ρ' := (HB T h0 ρ').1 ⟨x', by rw [hρ']; rfl⟩
  have hiso : IsoNS T ρ ρ' := KEY T h0 ρ ρ' hcls hn hn'
  have hpt : ptXd T h0 ρ = ptXd T h0 ρ' := (hx4 T h0 ρ ρ').2 hiso
  have hpush : push ξd ι T x = push ξd ι T x' := by rw [← hρ, ← hρ', hpt]
  have hval : x.1 ≫ ι = x'.1 ≫ ι := by
    have := congrArg Subtype.val hpush
    simpa [push_val] using this
  exact Subtype.ext ((cancel_mono ι).1 hval)

