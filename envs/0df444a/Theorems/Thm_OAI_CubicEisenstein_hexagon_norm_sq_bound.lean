theorem OAI.CubicEisenstein.hexagon_norm_sq_bound (x y : ℝ)
    (hx : |x|≤1/2)
    (h₁ : x+Real.sqrt 3*y≤1) (h₂ : x-Real.sqrt 3*y≤1)
    (h₃ : -x+Real.sqrt 3*y≤1) (h₄ : -x-Real.sqrt 3*y≤1) :
    x^2+y^2≤1/3 := by sorry
