def coordinatePreprocess {F : Type*} [CommRing F] {N d : ℕ}
    (index : Fin N) (guess : F) (randomness : Fin d → F)
    (observed : Matrix (Fin d) (Fin N) F × (Fin d → F)) :
    Matrix (Fin d) (Fin N) F × (Fin d → F) :=
  (observed.1 + vecMulVec randomness (Pi.single index 1), observed.2 + guess • randomness)
theorem coordinate_matrix_mulVec {F : Type*} [CommRing F] {N d : ℕ}
    (index : Fin N) (secret : Fin N → F) (randomness : Fin d → F)
    (matrix : Matrix (Fin d) (Fin N) F) :
    (matrix + vecMulVec randomness (Pi.single index 1)).mulVec secret =
      matrix.mulVec secret + (secret index) • randomness := by
  rw [Matrix.add_mulVec, Matrix.vecMulVec_mulVec]
  simp [single_dotProduct]
theorem coordinatePreprocess_response {F : Type*} [CommRing F] {N d : ℕ}
    (index : Fin N) (guess : F) (secret : Fin N → F) (randomness error : Fin d → F)
    (matrix : Matrix (Fin d) (Fin N) F) :
    (_root_.InfoLossLAR.WorstCase.coordinatePreprocess index guess randomness (matrix, matrix.mulVec secret + error)).2 =
      (_root_.InfoLossLAR.WorstCase.coordinatePreprocess index guess randomness (matrix, matrix.mulVec secret + error)).1.mulVec secret +
        error + (guess - secret index) • randomness := by
  dsimp only [_root_.InfoLossLAR.WorstCase.coordinatePreprocess]
  rw [_root_.InfoLossLAR.WorstCase.coordinate_matrix_mulVec]
  ext i
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
  ring
theorem coordinatePreprocess_wrong_injective {F : Type*} [Field F] {N d : ℕ}
    (index : Fin N) (guess : F) (secret : Fin N → F) (hguess : guess ≠ secret index)
    (error : Fin d → F) : Function.Injective
      (fun pair : Matrix (Fin d) (Fin N) F × (Fin d → F) =>
        _root_.InfoLossLAR.WorstCase.coordinatePreprocess index guess pair.2 (pair.1, pair.1.mulVec secret + error)) := by
  rintro ⟨first, rfirst⟩ ⟨second, rsecond⟩ he
  have hm := congrArg Prod.fst he
  have hb := congrArg Prod.snd he
  rw [_root_.InfoLossLAR.WorstCase.coordinatePreprocess_response, _root_.InfoLossLAR.WorstCase.coordinatePreprocess_response, hm] at hb
  have hr : rfirst = rsecond :=
    smul_right_injective _ (sub_ne_zero.mpr hguess) (add_left_cancel hb)
  dsimp only [_root_.InfoLossLAR.WorstCase.coordinatePreprocess] at hm
  rw [hr] at hm
  exact Prod.ext (add_right_cancel hm) hr
noncomputable def coordinateWrongTableEquiv {F : Type*} [Field F] [Fintype F] {N d t : ℕ}
    (index : Fin N) (guess : F) (secret : Fin N → F) (hguess : guess ≠ secret index)
    (errors : Fin t → Fin d → F) :
    (Fin t → Matrix (Fin d) (Fin N) F × (Fin d → F)) ≃
      (Fin t → Matrix (Fin d) (Fin N) F × (Fin d → F)) :=
  Equiv.piCongrRight fun block => Equiv.ofBijective _
    (Finite.injective_iff_bijective.mp (_root_.InfoLossLAR.WorstCase.coordinatePreprocess_wrong_injective index guess secret hguess (errors block)))
def coordinateShiftPreprocess {F : Type*} [CommRing F] {N d : ℕ}
    (index : Fin N) (guess : F) (shift : Fin N → F) (randomness : Fin d → F)
    (observed : Matrix (Fin d) (Fin N) F × (Fin d → F)) :
    Matrix (Fin d) (Fin N) F × (Fin d → F) :=
  _root_.InfoLossLAR.WorstCase.coordinatePreprocess index (guess + shift index) randomness
    (observed.1, observed.2 + observed.1.mulVec shift)
noncomputable def coordinateTestLaw {F : Type*} [CommRing F] [Fintype F] {N d t : ℕ}
    (index : Fin N) (guess : F) (secret : Fin N → F)
    (errors : _root_.AFT.FiniteDist (Fin t → Fin d → F)) :
