section
-- Source module: ThreeSumApsp.Batch.OParams
/-!
# The batched counting oracle: its parameters and its time

For `n` vertices, the block size `s` and the modulus `p ≥ 1`:

* `m = ⌈log₄ (4 s p)⌉ ≥ 1`, `D = 4^m ≥ 4 s p`, `L = 20 m`, `t = ⌈θ m⌉` with `θ = 56569/500000`;
* `N₀ = 3^{L-m}`, `K₀ = ⌊√binom(L, m)⌋`, `KK = K₀²` (the products of a batch);
* `k = ⌊√(p-1)⌋ + 1` (so `k² ≥ p`, `k ≤ p`), the `n k` digit rows of a product;
* `nb = ⌈n k / N₀⌉ + 1` blocks of `N₀` rows per product, `NP = nb N₀` rows, and the virtual size
  `Nv = K₀ NP` of Theorem 30;
* `T = ⌈n/s⌉` products, in `B = ⌈T / KK⌉` batches.

`oTimeF A n U s p` is the time of the oracle, with the constant `A` for all the bookkeeping.
-/

@[expose] public section

namespace Light.Batch

open ThreeSumApsp Light.Sec4

/-- `m = ⌈log₄ (4 s p)⌉`. -/
def oM (s p : ℕ) : ℕ := Nat.clog 4 (4 * s * p)
/-- `L = 20 m`. -/
def oL (s p : ℕ) : ℕ := 20 * oM s p
/-- `t = ⌈θ m⌉`, `θ = 56569/500000`. -/
def oT (s p : ℕ) : ℕ := (56569 * oM s p + 500000 - 1) / 500000
/-- `D = 4^m`. -/
def oD (s p : ℕ) : ℕ := 4 ^ oM s p
/-- `N₀ = 3^{L-m}`. -/
def oN0 (s p : ℕ) : ℕ := 3 ^ (oL s p - oM s p)
/-- `K₀ = ⌊√binom(L, m)⌋`. -/
def oK0 (s p : ℕ) : ℕ := Nat.sqrt ((oL s p).choose (oM s p))
/-- `KK = K₀²`. -/
def oKK (s p : ℕ) : ℕ := oK0 s p * oK0 s p
/-- `k = ⌊√(p-1)⌋ + 1`. -/
def oDig (p : ℕ) : ℕ := Nat.sqrt (p - 1) + 1
/-- `nb = ⌈n k / N₀⌉ + 1`. -/
def oNb (n s p : ℕ) : ℕ := (n * oDig p) ⌈/⌉ oN0 s p + 1
/-- `NP = nb N₀`. -/
def oNP (n s p : ℕ) : ℕ := oNb n s p * oN0 s p
/-- `Nv = K₀ NP`. -/
def oNv (n s p : ℕ) : ℕ := oK0 s p * oNP n s p
/-- The number of products, `T = ⌈n/s⌉`. -/
def oProd (n s : ℕ) : ℕ := n ⌈/⌉ s
/-- The number of batches, `B = ⌈T / KK⌉`. -/
def oBat (n s p : ℕ) : ℕ := oProd n s ⌈/⌉ oKK s p
/-- The parameters of Theorem 30 for a batch. -/
def oPar (n s p : ℕ) : Sec2.Par := ⟨oL s p, oM s p, oNv n s p⟩

/-- The time of the oracle, with the constant `A` for the bookkeeping: the tables, the parameters,
writing the sources of each batch, the loops of the queries; the preprocessing of each batch, and
one query for each pair and each product. -/
def oTimeF (A n U s p : ℕ) : ℕ :=
  if p = 0 then 0 else
    A * (n * n * (Nat.log 2 (U + 1) + 2) + p + oDig p * oDig p + oNP n s p + n * oDig p
        + (oL s p).choose (oM s p) + 4 ^ oL s p
        + oBat n s p * (oKK s p * oNP n s p * oD s p + oKK s p * n * oDig p * (s + 1)
            + oKK s p * n * n + 1) + 1)
      + oBat n s p * tPreCoreP cShared30 (oPar n s p) (oT s p)
      + oBat n s p * (oKK s p * (n * n)) * tQueryAt (oL s p) (oM s p) (oT s p)

end Light.Batch
end
end

section
-- Source module: ThreeSumApsp.Batch.OProg
/-!
# The batched counting oracle: the program text

The program `oProg` is `base58B` (Theorem 30 with the batched band arrays, numbers 0 to 57), the
procedures 58 to 73 of Section 4.4 for the rational parameters `c = 20`, `θ = 56569/500000`
(`procs31 G20`: copy, fill, log4, …, and `⌈θ m⌉` at 73), and the procedures of the oracle from 74 on:

* 74 emod, 75 ceilDiv, 76 powNat(b, e) = b^e;
* 77 residTab(dst, src, len, sgn, p, fr): `dst[q] := (sgn · src[q]) mod p` for `q < len`;
* 78 smallTab(dst, len, mul, add, p, fr): `dst[h] := (h · mul + add) mod p` for `h < len`;
* 79 rowTab(dst, nb, N0, Mul): `dst[i N0 + o] := i · Mul + o` for `i < nb`, `o < N0`;
* 80 divTab(dst, k): `dst[h k + l] := h` for `h, l < k`;
* 81 zTab(zh, zl, rn, dk, len, k): `zh[q] := dk[rn[q]]`, then `zl[q] := rn[q] - k · zh[q]`;
* 82 writeSrc: one source of a batch;
* 83 queries: the queries of a batch;
* 84 oracle: the top procedure.
-/

@[expose] public section

namespace Light.Batch

open ThreeSumApsp Light.Sec4

/-! ## The procedure numbers -/

abbrev pEmod : ℕ := 74
abbrev pCeilDiv : ℕ := 75
abbrev pPowNat : ℕ := 76
abbrev pResidTab : ℕ := 77
abbrev pSmallTab : ℕ := 78
abbrev pRowTab : ℕ := 79
abbrev pDivTab : ℕ := 80
abbrev pZTab : ℕ := 81
abbrev pWriteSrc : ℕ := 82
abbrev pQueries : ℕ := 83
abbrev pOracle : ℕ := 84

/-! ## Small procedures -/

/-- powNat(b, e): locals 2 (counter) and 3 (the power). -/
def powNatBody : Stmt :=
  .set 3 (k 1) ;;
  .for 2 (Light.v 1) (.set 3 (Light.v 3 *' Light.v 0)) ;;
  .set 0 (Light.v 3)

/-- residTab(dst, src, len, sgn, p, fr): local 6 is the counter, 7 the residue. -/
def residTabBody : Stmt :=
  .for 6 (Light.v 2) (
    .call pEmod [Light.v 3 *' M (Light.v 1 +' Light.v 6), Light.v 4, Light.v 5] 7 ;;
    .store (Light.v 0 +' Light.v 6) (Light.v 7))

/-- smallTab(dst, len, mul, add, p, fr): local 6 is the counter, 7 the residue. -/
def smallTabBody : Stmt :=
  .for 6 (Light.v 1) (
    .call pEmod [Light.v 6 *' Light.v 2 +' Light.v 3, Light.v 4, Light.v 5] 7 ;;
    .store (Light.v 0 +' Light.v 6) (Light.v 7))

/-- rowTab(dst, nb, N0, Mul): locals 4 and 5 are the counters i and o. -/
def rowTabBody : Stmt :=
  .for 4 (Light.v 1) (.for 5 (Light.v 2) (.store (Light.v 0 +' Light.v 4 *' Light.v 2 +' Light.v 5) (Light.v 4 *' Light.v 3 +' Light.v 5)))

/-- divTab(dst, k): locals 2 and 3 are the counters h and l. -/
def divTabBody : Stmt :=
  .for 2 (Light.v 1) (.for 3 (Light.v 1) (.store (Light.v 0 +' Light.v 2 *' Light.v 1 +' Light.v 3) (Light.v 2)))

/-- zTab(zh, zl, rn, dk, len, k): local 6 is the counter. -/
def zTabBody : Stmt :=
  .for 6 (Light.v 4) (.store (Light.v 0 +' Light.v 6) (M (Light.v 3 +' M (Light.v 2 +' Light.v 6)))) ;;
  .for 6 (Light.v 4) (.store (Light.v 1 +' Light.v 6) (M (Light.v 2 +' Light.v 6) -' Light.v 5 *' M (Light.v 0 +' Light.v 6)))

/-! ## One source of a batch -/

namespace WS

/-- The locals of writeSrc: the arguments base, T1, T2, RS, n, k, p, D, N0, j0, KKb, s, sz; then
the counters u, a, l, cl, the first vertex c0 = (j0 + u) s of the middle block, its length len, a
temporary, and the address of the row. -/
abbrev Base : ℕ := 0
@[inherit_doc Base] abbrev T1 : ℕ := 1
@[inherit_doc Base] abbrev T2 : ℕ := 2
@[inherit_doc Base] abbrev RS : ℕ := 3
@[inherit_doc Base] abbrev N : ℕ := 4
@[inherit_doc Base] abbrev Kd : ℕ := 5
@[inherit_doc Base] abbrev Pr : ℕ := 6
@[inherit_doc Base] abbrev Dd : ℕ := 7
@[inherit_doc Base] abbrev N0 : ℕ := 8
@[inherit_doc Base] abbrev J0 : ℕ := 9
@[inherit_doc Base] abbrev KKb : ℕ := 10
@[inherit_doc Base] abbrev S : ℕ := 11
@[inherit_doc Base] abbrev Sz : ℕ := 12
@[inherit_doc Base] abbrev U : ℕ := 13
@[inherit_doc Base] abbrev A : ℕ := 14
@[inherit_doc Base] abbrev Lc : ℕ := 15
@[inherit_doc Base] abbrev Cl : ℕ := 16
@[inherit_doc Base] abbrev C0 : ℕ := 17
@[inherit_doc Base] abbrev Len : ℕ := 18
@[inherit_doc Base] abbrev Tmp : ℕ := 19
@[inherit_doc Base] abbrev Row : ℕ := 20

end WS

open WS in
/-- One cell: `tmp := T1[a n + c0 + cl] + T2[l]`, reduced mod p; `row[cl p + tmp] := 1`. -/
def writeSrcCell : Stmt :=
  .set Tmp (M (Light.v T1 +' Light.v Light.Batch.WS.A *' Light.v Light.Batch.WS.N +' Light.v Light.Batch.WS.C0 +' Light.v Cl) +' M (Light.v T2 +' Light.v Lc)) ;;
  .ite (Light.v Tmp <' Light.v Pr) .skip (.set Tmp (Light.v Tmp -' Light.v Pr)) ;;
  .store (Light.v Light.Batch.WS.Row +' Light.v Cl *' Light.v Pr +' Light.v Tmp) (k 1)

open WS in
/-- The row `R = a k + l` of the product `u`: its address `base + (RS[R] + u N0) D`, then its cells. -/
def writeSrcRow : Stmt :=
  .set Light.Batch.WS.Row (Light.v Base +' (M (Light.v RS +' Light.v Light.Batch.WS.A *' Light.v Kd +' Light.v Lc) +' Light.v Light.Batch.WS.U *' Light.v N0) *' Light.v Dd) ;;
  .for Cl (Light.v Light.Batch.WS.Len) writeSrcCell

open WS in
/-- The product `u` of the batch: its middle block, then its rows. -/
def writeSrcProd : Stmt :=
  .set Light.Batch.WS.C0 ((Light.v J0 +' Light.v Light.Batch.WS.U) *' Light.v Light.Batch.WS.S) ;;
  .ite (Light.v Light.Batch.WS.C0 +' Light.v Light.Batch.WS.S ≤' Light.v Light.Batch.WS.N) (.set Light.Batch.WS.Len (Light.v Light.Batch.WS.S)) (.set Light.Batch.WS.Len (Light.v Light.Batch.WS.N -' Light.v Light.Batch.WS.C0)) ;;
  .for Light.Batch.WS.A (Light.v Light.Batch.WS.N) (.for Lc (Light.v Kd) writeSrcRow)

open WS in
/-- writeSrc(base, T1, T2, RS, n, k, p, D, N0, j0, KKb, s, sz): clear the `sz` cells, then mark the
cells of the products `u < KKb`. -/
def writeSrcBody : Stmt :=
  .call Proc.fill [Light.v Base, Light.v Sz, k 0] Tmp ;;
  .for Light.Batch.WS.U (Light.v KKb) writeSrcProd

/-! ## The queries of a batch -/

namespace QS

/-- The locals of queries: the arguments b0, ZL, ZH, RV, n, k, N0, K0, KKb, cnt, j0; then the
slot g, h, the counters a, b, the two positions I, J, the answer, the place of the counts of the
product, and the counter u of the products. -/
abbrev B0 : ℕ := 0
@[inherit_doc B0] abbrev ZL : ℕ := 1
@[inherit_doc B0] abbrev ZH : ℕ := 2
@[inherit_doc B0] abbrev RV : ℕ := 3
@[inherit_doc B0] abbrev N : ℕ := 4
@[inherit_doc B0] abbrev Kd : ℕ := 5
@[inherit_doc B0] abbrev N0 : ℕ := 6
@[inherit_doc B0] abbrev K0 : ℕ := 7
@[inherit_doc B0] abbrev KKb : ℕ := 8
@[inherit_doc B0] abbrev Cnt : ℕ := 9
@[inherit_doc B0] abbrev J0 : ℕ := 10
@[inherit_doc B0] abbrev G : ℕ := 11
@[inherit_doc B0] abbrev H : ℕ := 12
@[inherit_doc B0] abbrev A : ℕ := 13
@[inherit_doc B0] abbrev B : ℕ := 14
@[inherit_doc B0] abbrev I : ℕ := 15
@[inherit_doc B0] abbrev J : ℕ := 16
@[inherit_doc B0] abbrev Res : ℕ := 17
@[inherit_doc B0] abbrev Dst : ℕ := 18
@[inherit_doc B0] abbrev Uq : ℕ := 19

end QS

open QS in
/-- The query of the pair `(a, b)` in the slot `(g, h)`. -/
def queryCell : Stmt :=
  .set I (M (Light.v RV +' Light.v Light.Batch.QS.A *' Light.v Kd +' M (Light.v ZL +' Light.v Light.Batch.QS.A *' Light.v Light.Batch.QS.N +' Light.v Light.Batch.QS.B)) +' Light.v G *' Light.v N0) ;;
  .set Light.Batch.QS.J (M (Light.v RV +' Light.v Light.Batch.QS.B *' Light.v Kd +' M (Light.v ZH +' Light.v Light.Batch.QS.A *' Light.v Light.Batch.QS.N +' Light.v Light.Batch.QS.B)) +' Light.v H *' Light.v N0) ;;
  .call Proc.queryAt [Light.v I, Light.v Light.Batch.QS.J, Light.v B0] Light.Batch.QS.Res ;;
  .store (Light.v Light.Batch.QS.Dst +' Light.v Light.Batch.QS.A *' Light.v Light.Batch.QS.N +' Light.v Light.Batch.QS.B) (Light.v Light.Batch.QS.Res)

open QS in
/-- The product `u = g K₀ + h` of the batch: the queries of all pairs, then the next slot. -/
def queryProd : Stmt :=
  .set Light.Batch.QS.Dst (Light.v Light.Batch.QS.Cnt +' (Light.v J0 +' Light.v Uq) *' (Light.v Light.Batch.QS.N *' Light.v Light.Batch.QS.N)) ;;
  .for Light.Batch.QS.A (Light.v Light.Batch.QS.N) (.for Light.Batch.QS.B (Light.v Light.Batch.QS.N) queryCell) ;;
  .set H (Light.v H +' k 1) ;;
  .ite (Light.v H =' Light.v K0) (.set H (k 0) ;; .set G (Light.v G +' k 1)) .skip

open QS in
/-- queries(b0, ZL, ZH, RV, n, k, N0, K0, KKb, cnt, j0): the products `u < KKb` of the batch, in the
slots `(g, h)`, `u = g K₀ + h`. -/
def queriesBody : Stmt :=
  .set G (k 0) ;; .set H (k 0) ;;
  .for Uq (Light.v KKb) queryProd

/-! ## The top procedure -/

namespace OS

/-- The locals of the oracle: the arguments n, U, ab, bc, ac, s, p, cnt, fr; the parameters m, D,
L, t, N0, K0, KK, k, nb, NP, Nv, T, B; the addresses of the tables RAC, RNBC, RNAB, NL, HK, RS,
RV, DK, ZH, ZL, of the two sources and of the data structure; a temporary; the batch, its first
product j0 and its number KKb of products; the rows and the cells of a source; binom(L, m). -/
abbrev Nn : ℕ := 0

@[inherit_doc Nn] abbrev Ab : ℕ := 2
@[inherit_doc Nn] abbrev Bc : ℕ := 3
@[inherit_doc Nn] abbrev Ac : ℕ := 4
@[inherit_doc Nn] abbrev S : ℕ := 5
@[inherit_doc Nn] abbrev Pr : ℕ := 6
@[inherit_doc Nn] abbrev Cnt : ℕ := 7
@[inherit_doc Nn] abbrev Fr : ℕ := 8
@[inherit_doc Nn] abbrev Mm : ℕ := 9
@[inherit_doc Nn] abbrev Dd : ℕ := 10
@[inherit_doc Nn] abbrev Ll : ℕ := 11
@[inherit_doc Nn] abbrev Tt : ℕ := 12
@[inherit_doc Nn] abbrev N0 : ℕ := 13
@[inherit_doc Nn] abbrev K0 : ℕ := 14
@[inherit_doc Nn] abbrev KK : ℕ := 15
@[inherit_doc Nn] abbrev Kd : ℕ := 16
@[inherit_doc Nn] abbrev Nb : ℕ := 17
@[inherit_doc Nn] abbrev NP : ℕ := 18
@[inherit_doc Nn] abbrev Nv : ℕ := 19
@[inherit_doc Nn] abbrev Tp : ℕ := 20
@[inherit_doc Nn] abbrev Bt : ℕ := 21
@[inherit_doc Nn] abbrev aRAC : ℕ := 22
@[inherit_doc Nn] abbrev aRNBC : ℕ := 23
@[inherit_doc Nn] abbrev aRNAB : ℕ := 24
@[inherit_doc Nn] abbrev aNL : ℕ := 25
@[inherit_doc Nn] abbrev aHK : ℕ := 26
@[inherit_doc Nn] abbrev aRS : ℕ := 27
@[inherit_doc Nn] abbrev aRV : ℕ := 28
@[inherit_doc Nn] abbrev aDK : ℕ := 29
@[inherit_doc Nn] abbrev aZH : ℕ := 30
@[inherit_doc Nn] abbrev aZL : ℕ := 31
@[inherit_doc Nn] abbrev aX : ℕ := 32
@[inherit_doc Nn] abbrev aY : ℕ := 33
@[inherit_doc Nn] abbrev B0 : ℕ := 34
@[inherit_doc Nn] abbrev Tmp : ℕ := 35
@[inherit_doc Nn] abbrev Bn : ℕ := 36
@[inherit_doc Nn] abbrev J0 : ℕ := 37
@[inherit_doc Nn] abbrev KKb : ℕ := 38
@[inherit_doc Nn] abbrev Rows : ℕ := 39
@[inherit_doc Nn] abbrev Sz : ℕ := 40
@[inherit_doc Nn] abbrev Kb : ℕ := 41

end OS

open OS in
/-- The parameters. -/
def oParams : Stmt :=
  .call Proc.log4 [(k 4 *' Light.v Light.Batch.OS.S) *' Light.v Pr, Light.v Fr] Mm ;;
  .set Dd (M (Light.v Fr)) ;;
  .set Ll (k 20 *' Light.v Mm) ;;
  .call Proc.switch31 [Light.v Mm] Tt ;;
  .call pPowNat [k 3, Light.v Ll -' Light.v Mm] N0 ;;
  .call Sec2.pBinom [Light.v Ll, Light.v Mm, Light.v Fr +' k 1] Kb ;;
  .call Sec2.pSqrt [Light.v Kb] K0 ;;
  .set KK (Light.v K0 *' Light.v K0) ;;
  .call Sec2.pSqrt [Light.v Pr -' k 1] Kd ;;
  .set Kd (Light.v Kd +' k 1) ;;
  .call pCeilDiv [Light.v Nn *' Light.v Kd, Light.v N0] Nb ;;
  .set Nb (Light.v Nb +' k 1) ;;
  .set NP (Light.v Nb *' Light.v N0) ;;
  .set Nv (Light.v K0 *' Light.v NP) ;;
  .call pCeilDiv [Light.v Nn, Light.v Light.Batch.OS.S] Tp ;;
  .call pCeilDiv [Light.v Tp, Light.v KK] Bt

open OS in
/-- The addresses: the tables, the two sources, the data structure. -/
def oAddrs : Stmt :=
  .set aRAC (Light.v Fr) ;;
  .set aRNBC (Light.v aRAC +' Light.v Nn *' Light.v Nn) ;;
  .set aRNAB (Light.v aRNBC +' Light.v Nn *' Light.v Nn) ;;
  .set aNL (Light.v aRNAB +' Light.v Nn *' Light.v Nn) ;;
  .set aHK (Light.v aNL +' Light.v Kd) ;;
  .set aRS (Light.v aHK +' Light.v Kd) ;;
  .set aRV (Light.v aRS +' Light.v NP) ;;
  .set aDK (Light.v aRV +' Light.v NP) ;;
  .set aZH (Light.v aDK +' Light.v Kd *' Light.v Kd) ;;
  .set aZL (Light.v aZH +' Light.v Nn *' Light.v Nn) ;;
  .set Light.Batch.OS.Rows (Light.v KK *' Light.v NP) ;;
  .set Sz (Light.v Light.Batch.OS.Rows *' Light.v Dd) ;;
  .set Light.Batch.OS.aX (Light.v aZL +' Light.v Nn *' Light.v Nn) ;;
  .set Light.Batch.OS.aY (Light.v Light.Batch.OS.aX +' Light.v Sz) ;;
  .set B0 (Light.v Light.Batch.OS.aY +' Light.v Sz)

open OS in
/-- The tables. -/
def oTables : Stmt :=
  .call pResidTab [Light.v aRAC, Light.v Ac, Light.v Nn *' Light.v Nn, k 1, Light.v Pr, Light.v B0] Tmp ;;
  .call pResidTab [Light.v aRNBC, Light.v Bc, Light.v Nn *' Light.v Nn, k 0 -' k 1, Light.v Pr, Light.v B0] Tmp ;;
  .call pResidTab [Light.v aRNAB, Light.v Ab, Light.v Nn *' Light.v Nn, k 0 -' k 1, Light.v Pr, Light.v B0] Tmp ;;
  .call pSmallTab [Light.v aNL, Light.v Kd, k 0 -' k 1, Light.v Pr, Light.v Pr, Light.v B0] Tmp ;;
  .call pSmallTab [Light.v aHK, Light.v Kd, Light.v Kd, k 0, Light.v Pr, Light.v B0] Tmp ;;
  .call pRowTab [Light.v aRS, Light.v Nb, Light.v N0, Light.v KK *' Light.v N0] Tmp ;;
  .call pRowTab [Light.v aRV, Light.v Nb, Light.v N0, Light.v K0 *' Light.v N0] Tmp ;;
  .call pDivTab [Light.v aDK, Light.v Kd] Tmp ;;
  .call pZTab [Light.v aZH, Light.v aZL, Light.v aRNAB, Light.v aDK, Light.v Nn *' Light.v Nn, Light.v Kd] Tmp

open OS in
/-- One batch: its products, the two sources, the preprocessing, the queries. -/
def oBatch : Stmt :=
  .set J0 (Light.v Bn *' Light.v KK) ;;
  .ite (Light.v J0 +' Light.v KK ≤' Light.v Tp) (.set KKb (Light.v KK)) (.set KKb (Light.v Tp -' Light.v J0)) ;;
  .call pWriteSrc [Light.v Light.Batch.OS.aX, Light.v aRAC, Light.v aNL, Light.v aRS, Light.v Nn, Light.v Kd, Light.v Pr, Light.v Dd, Light.v N0, Light.v J0, Light.v KKb, Light.v Light.Batch.OS.S,
    Light.v Sz] Tmp ;;
  .call pWriteSrc [Light.v Light.Batch.OS.aY, Light.v aRNBC, Light.v aHK, Light.v aRS, Light.v Nn, Light.v Kd, Light.v Pr, Light.v Dd, Light.v N0, Light.v J0, Light.v KKb, Light.v Light.Batch.OS.S,
    Light.v Sz] Tmp ;;
  .call Proc.preCore [Light.v Ll, Light.v Mm, Light.v Tt, Light.v Nv, Light.v Dd, Light.v Light.Batch.OS.aX, Light.v Light.Batch.OS.aY, Light.v B0] Tmp ;;
  .call pQueries [Light.v B0, Light.v aZL, Light.v aZH, Light.v aRV, Light.v Nn, Light.v Kd, Light.v N0, Light.v K0, Light.v KKb, Light.v Light.Batch.OS.Cnt, Light.v J0] Tmp

open OS in
/-- oracle(n, U, ab, bc, ac, s, p, cnt, fr). -/
def oracleBody : Stmt :=
  oParams ;; oAddrs ;; oTables ;; .for Bn (Light.v Bt) oBatch

/-! ## The program -/

/-- The rational parameters `c = 20`, `θ = 56569/500000`. -/
def G20 : RatParams where
  a := 20
  b := 1
  p := 56569
  q := 500000
  m₀ := 1
  hb := by norm_num
  hq := by norm_num
  hc := by norm_num
  hp := by norm_num
  hθ := by norm_num
  hm₀ := by norm_num

/-- The procedures of the oracle, numbers 74 to 84. -/
def oProcs : Program :=
  [emodBody, Sec3.ceilDivBody, powNatBody, residTabBody, smallTabBody, rowTabBody, divTabBody,
    zTabBody, writeSrcBody, queriesBody, Light.Batch.oracleBody]

/-- **The program of the batched counting oracle.** -/
def oProg : Program := base58B ++ procs31 G20 ++ oProcs

end Light.Batch
end
end

section
-- Source module: ThreeSumApsp.Batch.Lift
/-!
# The digit-lifted sources and the count identity

The sources of a batch are 0/1 matrices with at most one entry 1 in each inner block of `p` columns.
A source row `ρ = (i K₀² + u) N₀ + o` belongs to the product `u` (`rowU`) and is its row
`R = i N₀ + o` (`rowR`).  The inner index `κ = cl p + r` is the vertex `cl` of the middle block and
the residue `r`.  The entry is 1 iff the triple `(u, R, cl)` is valid (`ok`) and `r` is the residue
`f u R cl`.

* `sum_srcVal`: the inner product of a row of the left source and a column of the right source of the
  same product counts the `cl` where both are valid and the two residues agree.
* `lift_count`: with the residues of the digit construction (Lemma 4.1 of the note), the residues
  agree iff `p` divides the triangle sum.
-/

@[expose] public section

open Finset

namespace ThreeSumApsp.Batch

/-- The product of a source row. -/
def rowU (KK N0 ρ : ℕ) : ℕ := ρ / N0 % KK

/-- The row of its product that a source row is. -/
def rowR (KK N0 ρ : ℕ) : ℕ := ρ / N0 / KK * N0 + ρ % N0

/-- The source row of the row `R` of the product `u`. -/
def srcOf (KK N0 u R : ℕ) : ℕ := (R / N0 * KK + u) * N0 + R % N0

/-- The entry `(ρ, κ)` of a source. -/
def srcVal (s p KK N0 : ℕ) (ok : ℕ → ℕ → ℕ → Bool) (f : ℕ → ℕ → ℕ → ℕ) (ρ κ : ℕ) : ℤ :=
  if κ / p < s ∧ ok (rowU KK N0 ρ) (rowR KK N0 ρ) (κ / p) = true ∧
      κ % p = f (rowU KK N0 ρ) (rowR KK N0 ρ) (κ / p) then 1 else 0

/-! ## The residues of the digit construction -/

/-- The residue of an integer, as a natural number. -/
def resid (p : ℕ) (w : ℤ) : ℕ := (w % (p : ℤ)).toNat

/-! ## The sources of the digit construction -/

section Digits

variable (n s p k T KK bt : ℕ) (AB BC AC : List ℤ)

/-- The product `u` of the batch `bt` is the product of the middle block `bt K₀² + u`. -/
abbrev jOf (u : ℕ) : ℕ := bt * KK + u

/-- The left source: row `R = a k + l` of the product of the middle block `j`, vertex `cl` of the
block; the residue is `(w(a, c) - l) mod p`. -/
def okX (u R cl : ℕ) : Bool := decide (ThreeSumApsp.Batch.jOf KK bt u < T ∧ R / k < n ∧ ThreeSumApsp.Batch.jOf KK bt u * s + cl < n)

def fX (u R cl : ℕ) : ℕ :=
  (ThreeSumApsp.Batch.resid p (AC.getD (R / k * n + (ThreeSumApsp.Batch.jOf KK bt u * s + cl)) 0) + (p - R % k) % p) % p

/-- The right source: column `C = b k + h`; the residue is `(h k - w(b, c)) mod p`. -/
def okY (u C cl : ℕ) : Bool := decide (ThreeSumApsp.Batch.jOf KK bt u < T ∧ C / k < n ∧ ThreeSumApsp.Batch.jOf KK bt u * s + cl < n)

def fY (u C cl : ℕ) : ℕ :=
  (C % k * k % p + ThreeSumApsp.Batch.resid p (-BC.getD (C / k * n + (ThreeSumApsp.Batch.jOf KK bt u * s + cl)) 0)) % p

end Digits

/-! ## The virtual positions of a query -/

/-- The virtual position of the row `R` of the slot row `g`. -/
def virt (K0 N0 g R : ℕ) : ℕ := R / N0 * (K0 * N0) + g * N0 + R % N0

end ThreeSumApsp.Batch
end
end

section
-- Source module: ThreeSumApsp.Filter2.Defs
/-!
# Deterministic filtering: parameters and the counting oracle

The filtering reduction of the 2.996001 note (Lemma 3.1, Lemma 4.1).  A candidate is a triple
`(a, b, j)`: the pair `(a, b)` and the block `C_j = [j s, min((j+1) s, n))` of third vertices.  It
lies at index `i = j n² + a n + b`; its group is the pair, `i % (n n) = a n + b`.  For a modulus
`p ≥ 1` its count is the number of `c ∈ C_j` with `p ∣ w(a,b) + w(b,c) + w(a,c)`.

* The parameters, as functions of `n` and `U` (§3, (3.5)): `kOf`, `ellOf`, `RR`, `bOf`, `dOf`,
  `roundsOf`, `sOf`, `mOf`, `cKOf`, `rOf`, `BOf`, `hOf`, `pool`, `QOf`, `Guard`, `PmaxOf`.
* The counts (`cntList`) and the task of the counting oracle (`oracleTask`).
-/

@[expose] public section

open ThreeSumApsp

namespace Light.Filter2

open ThreeSumApsp.Spec Light.Sec3

/-! ## Parameters -/

/-- `k`, the bit length of `n`: `n < 2^k`. -/
def kOf (n : ℕ) : ℕ := Nat.size n

/-- `ℓ = ⌊√k⌋ + 1`. -/
def ellOf (n : ℕ) : ℕ := Nat.sqrt (Light.Filter2.kOf n) + 1

/-- `R = 2^ℓ`; the pool is the primes in `[R, 2R)`. -/
def RR (n : ℕ) : ℕ := 2 ^ Light.Filter2.ellOf n

/-- `b = ℓ (⌊√ℓ⌋ + 1)`, about `k^{3/4}`. -/
def bOf (n : ℕ) : ℕ := Light.Filter2.ellOf n * (Nat.sqrt (Light.Filter2.ellOf n) + 1)

/-- `d = ⌊b/2⌋`: a round with the guard shrinks the active set by `2^d`. -/
def dOf (n : ℕ) : ℕ := Light.Filter2.bOf n / 2

/-- The number of rounds, `⌊3k/d⌋ + 1`, so that `d · rounds > 3k`. -/
def roundsOf (n : ℕ) : ℕ := 3 * Light.Filter2.kOf n / Light.Filter2.dOf n + 1

/-- The block size `s = 2^{⌊σ k⌋}`, `σ = 0.0336175`. -/
def sOf (n : ℕ) : ℕ := 2 ^ (336175 * Light.Filter2.kOf n / 10 ^ 7)

/-- The number of blocks, `⌈n/s⌉`. -/
def mOf (n : ℕ) : ℕ := (n + Light.Filter2.sOf n - 1) / Light.Filter2.sOf n

/-- `c_K`, the bit length of the largest witness count `s`. -/
def cKOf (n : ℕ) : ℕ := Nat.size (Light.Filter2.sOf n)

/-- The number of prime factors per round, `⌊(c_K + b)/ℓ⌋ + 1`. -/
def rOf (n : ℕ) : ℕ := (Light.Filter2.cKOf n + Light.Filter2.bOf n) / Light.Filter2.ellOf n + 1

/-- `B`, the bit length of `3U`: every triangle sum has absolute value below `2^B`. -/
def BOf (U : ℕ) : ℕ := Nat.size (3 * U)

/-- `h = ⌊(B − 1)/ℓ⌋`: a nonzero integer below `2^B` in absolute value has at most `h` prime
divisors in the pool. -/
def hOf (n U : ℕ) : ℕ := (Light.Filter2.BOf U - 1) / Light.Filter2.ellOf n

/-- The pool: the primes in `[R, 2R)`. -/
def pool (n : ℕ) : Finset ℕ := (Finset.range (2 * Light.Filter2.RR n)).filter fun q => Light.Filter2.RR n ≤ q ∧ q.Prime

/-- `Q`, the size of the pool. -/
def QOf (n : ℕ) : ℕ := (Light.Filter2.pool n).card

/-- The guard (3.6), `K (2h)^r 2^d ≤ Q^r` with `K = s`.  Not tested by the program on the main
path; it holds for all large `n` along polynomially bounded `U`. -/
def Guard (n U : ℕ) : Prop := Light.Filter2.sOf n * (2 * Light.Filter2.hOf n U) ^ Light.Filter2.rOf n * 2 ^ Light.Filter2.dOf n ≤ Light.Filter2.QOf n ^ Light.Filter2.rOf n

instance (n U : ℕ) : Decidable (Light.Filter2.Guard n U) := by unfold Light.Filter2.Guard; infer_instance

/-- The largest modulus, `(2R)^r`. -/
def PmaxOf (n : ℕ) : ℕ := (2 * Light.Filter2.RR n) ^ Light.Filter2.rOf n

/-! ## The counts -/

/-- The block `j` of third vertices: `c` with `j s ≤ c < (j + 1) s` and `c < n`. -/
def InBlock (n s j c : ℕ) : Prop := j * s ≤ c ∧ c < (j + 1) * s ∧ c < n

instance (n s j c : ℕ) : Decidable (Light.Filter2.InBlock n s j c) := by unfold Light.Filter2.InBlock; infer_instance

/-- The triangle sum `w(a,b) + w(b,c) + w(a,c)` of the pair `q = a n + b` and the vertex `c`, as in
`aeFlags`. -/
def triSum (n : ℕ) (AB BC AC : List ℤ) (q c : ℕ) : ℤ :=
  AB.getD q 0 + BC.getD (q % n * n + c) 0 + AC.getD (q / n * n + c) 0

/-- The count of the candidate `i = j n² + q` at the modulus `p`: the `c` in block `j` with
`p ∣ triSum q c`. -/
def cntOf (n s p : ℕ) (AB BC AC : List ℤ) (i : ℕ) : ℕ :=
  ((Finset.range n).filter fun c =>
    Light.Filter2.InBlock n s (i / (n * n)) c ∧ (p : ℤ) ∣ Light.Filter2.triSum n AB BC AC (i % (n * n)) c).card

/-- All `m n²` counts at the modulus `p`, candidate `i` in cell `i`. -/
def cntList (n s p : ℕ) (AB BC AC : List ℤ) : List ℤ :=
  (List.range ((n + s - 1) / s * (n * n))).map fun i => (Light.Filter2.cntOf n s p AB BC AC i : ℤ)

/-! ## The counting oracle as a task -/

/-- An instance of the oracle: an all-edges instance (without the place of the flags), a block size
`s`, a modulus `p`, and the place `cnt` of the `m n²` counts. -/
structure OracleInst : Type extends TriInst where
  s : ℕ
  p : ℕ
  cnt : ℕ

/-- The number of counts, `⌈n/s⌉ n²`. -/
def OracleInst.len (x : Light.Filter2.OracleInst) : ℕ := (x.n + x.s - 1) / x.s * (x.n * x.n)

/-- The matrices and the place of the counts lie below the free pointer and do not meet;
`1 ≤ s ≤ n`, `1 ≤ p`. -/
structure OracleInst.Pre (x : Light.Filter2.OracleInst) (μ : ℕ → ℤ) (fr : ℕ) : Prop
    extends TriInst.Pre x.toTriInst μ fr where
  s_pos : 1 ≤ x.s
  s_le : x.s ≤ x.n
  p_pos : 1 ≤ x.p
  belowCnt : x.cnt + x.len ≤ fr
  apartAB : Apart x.ab (x.n * x.n) x.cnt x.len
  apartBC : Apart x.bc (x.n * x.n) x.cnt x.len
  apartAC : Apart x.ac (x.n * x.n) x.cnt x.len

/-- **The counting oracle** (Lemma 4.1): `oracle(n, U, ab, bc, ac, s, p, cnt, fr)` writes the counts
of all candidates at the modulus `p` to `cnt`, and changes no other cell below `fr`. -/
def oracleTask : TaskN where
  Inst := Light.Filter2.OracleInst
  pars x := [x.n, x.U, x.s, x.p]
  args x := [x.n, x.U, x.ab, x.bc, x.ac, x.s, x.p, x.cnt]
  Pre := Light.Filter2.OracleInst.Pre
  Post x μ fr _ μ' := Seg μ' x.cnt (Light.Filter2.cntList x.n x.s x.p x.AB x.BC x.AC) ∧
    KeptBut μ μ' fr x.cnt x.len

end Light.Filter2
end
end

section
-- Source module: ThreeSumApsp.Batch.OMath
/-!
# The batched counting oracle: the sources and the answer of a query

The two sources of a batch have the same shape (`srcMat`): the entry `(ρ, κ)` is 1 iff the product
`u` and the row `R` of the row `ρ`, and the vertex `cl = κ / p` of the middle block, are valid, and
`κ % p` is the residue `fGen T1 T2 u R cl = (T1[a n + c] + T2[l]) mod p` (`R = a k + l`,
`c = j s + cl`).  The left source has `T1 = w(a, c) mod p`, `T2[l] = -l mod p`; the right source,
transposed, has `T1 = -w(b, c) mod p`, `T2[h] = h k mod p`.

`query_eq_cntOf`: the query of the batched data structure at the virtual positions of the pair
`(a, b)` in the slot `(g, h)` returns the count of the candidate `j n² + a n + b`, `j` the middle
block of the product `u = g K₀ + h`.
-/

@[expose] public section

open Finset ThreeSumApsp ThreeSumApsp.Batch ThreeSumApsp.Spec

namespace Light.Batch

/-- The residue of the cell of the row `R` and the vertex `cl`. -/
def fGen (n s p k KK bt : ℕ) (T1 T2 : ℕ → ℕ) (u R cl : ℕ) : ℕ :=
  (T1 (R / k * n + (ThreeSumApsp.Batch.jOf KK bt u * s + cl)) + T2 (R % k)) % p

/-- A source of a batch, `rows × D`. -/
def srcMat (rows D' n s p k T KK N0 bt : ℕ) (T1 T2 : ℕ → ℕ) : Matrix (Fin rows) (Fin D') ℤ :=
  fun ρ κ => srcVal s p KK N0 (okX n s k T KK bt) (fGen n s p k KK bt T1 T2) ρ κ

/-- The tables of the left source. -/
def t1X (p : ℕ) (AC : List ℤ) (q : ℕ) : ℕ := ThreeSumApsp.Batch.resid p (AC.getD q 0)
def t2X (p : ℕ) (l : ℕ) : ℕ := (p - l) % p
/-- The tables of the right source. -/
def t1Y (p : ℕ) (BC : List ℤ) (q : ℕ) : ℕ := ThreeSumApsp.Batch.resid p (-BC.getD q 0)
def t2Y (p k : ℕ) (h : ℕ) : ℕ := h * k % p
end Light.Batch
end
end

section
-- Source module: ThreeSumApsp.Batch.OSpecs
/-!
# The batched counting oracle: what its small procedures do

The specifications of the procedures 76 to 82 (`OProg`), as propositions about a program `P`, with
their times.  They are proved in `OTables` (the tables) and `OWrite` (writeSrc).
-/

@[expose] public section

namespace Light.Batch

open ThreeSumApsp ThreeSumApsp.Batch Light.Sec4

/-! ## Times -/

def tPowNat (e : ℕ) : ℕ := 12 * e + 12
def tResidTab (len V p : ℕ) : ℕ := len * (emodTime V p + 30) + 10
def tSmallTab (len V p : ℕ) : ℕ := len * (emodTime V p + 30) + 10
def tRowTab (nb N0 : ℕ) : ℕ := nb * (N0 * 30 + 30) + 10
def tDivTab (k : ℕ) : ℕ := k * (k * 30 + 30) + 10
def tZTab (len : ℕ) : ℕ := len * 60 + 20
/-- writeSrc: the clearing of `sz` cells, then the products, rows and cells. -/
def tWriteSrc (sz KKb n k s : ℕ) : ℕ :=
  tFill sz + KKb * (n * (k * (s * 60 + 60) + 30) + 60) + 30

/-! ## Specifications -/

variable (lim : Limits) (P : Program)

/-- powNat(b, e) returns `b^e`, for `b ≥ 1`, and changes no cell. -/
def PowNatSpec : Prop :=
  ∀ (b e : ℕ) (μ : ℕ → ℤ) (d : ℕ), 1 ≤ b → ((b ^ e + e + 1 : ℕ) : ℤ) ≤ lim.word →
    Meets lim P pPowNat d [b, e] μ (tPowNat e) fun r μ' => r = (b ^ e : ℕ) ∧ μ' = μ

/-- residTab(dst, src, len, sgn, p, fr), `sgn = ±1`: `dst[q] := resid p (sgn · src[q])`.  It changes
the `len` cells from dst and cells from fr on (the table of emod). -/
def ResidTabSpec : Prop :=
  ∀ (dst src : ℕ) (W : List ℤ) (sgn : ℤ) (p V fr : ℕ) (μ : ℕ → ℤ) (d : ℕ),
    (sgn = 1 ∨ sgn = -1) → Seg μ src W → (∀ w ∈ W, |w| ≤ V) → Emod.Pre lim p V fr →
    dst + W.length ≤ fr → src + W.length ≤ fr → Apart dst W.length src W.length →
    d + 1 ≤ lim.depth →
    Meets lim P pResidTab d [dst, src, W.length, sgn, p, fr] μ (tResidTab W.length V p)
      fun _ μ' => SegN μ' dst (W.map fun w => resid p (sgn * w)) ∧
        SameOn (fun b => b < fr ∧ Outside dst W.length b) μ μ'

/-- smallTab(dst, len, mul, add, p, fr): `dst[h] := resid p (h · mul + add)`. -/
def SmallTabSpec : Prop :=
  ∀ (dst len : ℕ) (mul add : ℤ) (p V fr : ℕ) (μ : ℕ → ℤ) (d : ℕ),
    (∀ h < len, |(h : ℤ) * mul + add| ≤ V) → |mul| ≤ V → |add| ≤ V → (len : ℤ) ≤ V →
    Emod.Pre lim p V fr → dst + len ≤ fr → d + 1 ≤ lim.depth →
    Meets lim P pSmallTab d [dst, len, mul, add, p, fr] μ (tSmallTab len V p)
      fun _ μ' => SegN μ' dst ((List.range len).map fun h => resid p ((h : ℤ) * mul + add)) ∧
        SameOn (fun b => b < fr ∧ Outside dst len b) μ μ'

/-- rowTab(dst, nb, N0, Mul): `dst[R] := R / N0 · Mul + R % N0` for `R < nb N0`. -/
def RowTabSpec : Prop :=
  ∀ (dst nb N0 Mul : ℕ) (μ : ℕ → ℤ) (d : ℕ), Std lim → 1 ≤ N0 → dst + nb * N0 < lim.space →
    (((nb + 1) * (Mul + N0 + 1) : ℕ) : ℤ) ≤ lim.word →
    Meets lim P pRowTab d [dst, nb, N0, Mul] μ (tRowTab nb N0)
      fun _ μ' => SegN μ' dst ((List.range (nb * N0)).map fun R => R / N0 * Mul + R % N0) ∧
        SameOutside μ μ' dst (nb * N0)

/-- divTab(dst, k): `dst[z] := z / k` for `z < k²`. -/
def DivTabSpec : Prop :=
  ∀ (dst k : ℕ) (μ : ℕ → ℤ) (d : ℕ), Std lim → dst + k * k < lim.space →
    Meets lim P pDivTab d [dst, k] μ (tDivTab k)
      fun _ μ' => SegN μ' dst ((List.range (k * k)).map fun z => z / k) ∧
        SameOutside μ μ' dst (k * k)

/-- zTab(zh, zl, rn, dk, len, k): `zh[q] := rn[q] / k`, `zl[q] := rn[q] % k`, from the table
`dk` of divTab. -/
def ZTabSpec : Prop :=
  ∀ (zh zl rn dk k : ℕ) (RN : List ℕ) (μ : ℕ → ℤ) (d : ℕ), Std lim → 1 ≤ k → SegN μ rn RN →
    SegN μ dk ((List.range (k * k)).map fun z => z / k) → (∀ z ∈ RN, z < k * k) →
    Apart zh RN.length zl RN.length → Apart zh RN.length rn RN.length →
    Apart zl RN.length rn RN.length → Apart zh RN.length dk (k * k) →
    zh + RN.length < lim.space → zl + RN.length < lim.space → rn + RN.length < lim.space →
    dk + k * k < lim.space →
    Meets lim P pZTab d [zh, zl, rn, dk, RN.length, k] μ (tZTab RN.length)
      fun _ μ' => SegN μ' zh (RN.map (· / k)) ∧ SegN μ' zl (RN.map (· % k)) ∧
        SameOn (fun b => Outside zh RN.length b ∧ Outside zl RN.length b) μ μ'

/-- What writeSrc assumes.  The source has `KK NP` rows of `D` cells from base; the tables T1
(`n²` residues) and T2 (`k` residues) and the table RS of the first rows `R / N0 · KK N0 + R % N0`
lie apart from it; the products `j0 + u`, `u < KKb`, have middle blocks that begin below `n`. -/
structure WriteSrcPre (μ : ℕ → ℤ) (base t1 t2 rs n k p D N0 j0 KKb s KK NP : ℕ) (T1 T2 : List ℕ) :
    Prop where
  std : Std lim
  p_pos : 1 ≤ p
  N0_pos : 1 ≤ N0
  k_pos : 1 ≤ k
  D_pos : 1 ≤ D
  seg1 : SegN μ t1 T1
  len1 : T1.length = n * n
  lt1 : ∀ x ∈ T1, x < p
  seg2 : SegN μ t2 T2
  len2 : T2.length = k
  lt2 : ∀ x ∈ T2, x < p
  segRS : SegN μ rs ((List.range NP).map fun R => R / N0 * (KK * N0) + R % N0)
  NP_mul : N0 ∣ NP
  nk_le : n * k ≤ NP
  KKb_le : KKb ≤ KK
  blocks : ∀ u < KKb, (j0 + u) * s < n
  sp_le : s * p ≤ D
  space : base + KK * NP * D < lim.space
  apart1 : Apart base (KK * NP * D) t1 (n * n)
  apart2 : Apart base (KK * NP * D) t2 k
  apartRS : Apart base (KK * NP * D) rs NP
  below1 : t1 + n * n < lim.space
  below2 : t2 + k < lim.space
  belowRS : rs + NP < lim.space
  word : (((j0 + KKb + 1) * (s + 1) + n * n + n * k + 2 * p + 4 : ℕ) : ℤ) ≤ lim.word

/-- writeSrc(base, t1, t2, rs, n, k, p, D, N0, j0, KKb, s, KK NP D): afterwards the `KK NP × D`
source at base holds `srcMat` for the batch `bt` (`j0 = bt KK`, the valid products `u < KKb`), and
no other cell has changed. -/
def WriteSrcSpec : Prop :=
  ∀ (base t1 t2 rs n k p D N0 bt KKb s KK NP : ℕ) (T1 T2 : List ℕ) (μ : ℕ → ℤ) (d : ℕ),
    WriteSrcPre lim μ base t1 t2 rs n k p D N0 (bt * KK) KKb s KK NP T1 T2 →
    d + 1 ≤ lim.depth →
    Meets lim P pWriteSrc d [base, t1, t2, rs, n, k, p, D, N0, bt * KK, KKb, s, KK * NP * D] μ
      (tWriteSrc (KK * NP * D) KKb n k s) fun _ μ' =>
      (∀ ρ < KK * NP, ∀ κ < D, μ' (base + ρ * D + κ) =
        srcVal s p KK N0 (okX n s k (bt * KK + KKb) KK bt)
          (fGen n s p k KK bt (fun q => T1.getD q 0) (fun l => T2.getD l 0)) ρ κ) ∧
      SameOutside μ μ' base (KK * NP * D)

end Light.Batch
end
end

section
-- Source module: ThreeSumApsp.Batch.OQuery
/-!
# The batched counting oracle: the queries of a batch

`queries(b0, ZL, ZH, RV, n, k, N0, K0, KKb, cnt, j0)` asks, for each product `u < KKb` of the batch
(slot `g = u / K₀`, `h = u % K₀`) and each pair `(a, b)`, the query at the virtual positions
`I = virt g (a k + ZL[a n + b])`, `J = virt h (b k + ZH[a n + b])`, and stores the answer at
`cnt + (j0 + u) n² + a n + b` (`queries_ok`).  The invariant `QInv E`: the data structure is ready,
the first `E` cells from `cnt + j0 n²` hold their answers, and no other cell below b0 has changed.
-/

@[expose] public section

namespace Light.Batch

open ThreeSumApsp ThreeSumApsp.Spec ThreeSumApsp.Batch Light.Sec4 QS

variable {lim : Limits} {P : Program} {d : ℕ}

/-- The answer of the query of the pair `(a, b)` in the slot `(g, h)`. -/
def qVal (pv : Sec2.Par) (t : ℕ) (hmL : pv.m ≤ pv.L) (AL : ArrL pv) (AR : Light.Batch.ArrR pv) (n k : ℕ)
    (ZL ZH : List ℕ) (g h a b : ℕ) : ℤ :=
  queryValue pv.m t
    (encRowA AL (virt pv.K0 pv.N0 g (a * k + ZL.getD (a * n + b) 0) / (pv.K0 * pv.N0)))
    (encColA AR (virt pv.K0 pv.N0 h (b * k + ZH.getD (a * n + b) 0) / (pv.K0 * pv.N0)))
    (outStrOfPos (stdLayout hmL) (virt pv.K0 pv.N0 g (a * k + ZL.getD (a * n + b) 0))
      (virt pv.K0 pv.N0 h (b * k + ZH.getD (a * n + b) 0)))

/-- The answer of the cell `e` from `cnt + j0 n²`. -/
def qAns (pv : Sec2.Par) (t : ℕ) (hmL : pv.m ≤ pv.L) (AL : ArrL pv) (AR : Light.Batch.ArrR pv) (n k : ℕ)
    (ZL ZH : List ℕ) (e : ℕ) : ℤ :=
  qVal pv t hmL AL AR n k ZL ZH (e / (n * n) / pv.K0) (e / (n * n) % pv.K0) (e % (n * n) / n)
    (e % (n * n) % n)

/-- What the queries of a batch assume, in the memory μ₀ at the start. -/
structure QSet (lim : Limits) (P : Program) (pv : Sec2.Par) (t : ℕ) (aX aY b0 : ℕ) (AL : ArrL pv)
    (AR : Light.Batch.ArrR pv) (U : ℤ) (μ₀ : ℕ → ℤ) (zl zh rv n k NP KKb cnt j0 : ℕ) (ZL ZH : List ℕ) :
    Prop where
  hq : QueryAtASpec lim P
  ht : t ≤ pv.m
  hlim : Lim30 lim pv t b0 U
  hb : BoundA AL AR U
  segZL : SegN μ₀ zl ZL
  segZH : SegN μ₀ zh ZH
  lenZL : ZL.length = n * n
  lenZH : ZH.length = n * n
  ltZL : ∀ x ∈ ZL, x < k
  ltZH : ∀ x ∈ ZH, x < k
  segRV : SegN μ₀ rv ((List.range NP).map fun R => R / pv.N0 * (pv.K0 * pv.N0) + R % pv.N0)
  hN : pv.N = pv.K0 * NP
  n_pos : 1 ≤ n
  NP_mul : pv.N0 ∣ NP
  nk_le : n * k ≤ NP
  KKb_le : KKb ≤ pv.K0 * pv.K0
  belowZL : zl + n * n ≤ b0
  belowZH : zh + n * n ≤ b0
  belowRV : rv + NP ≤ b0
  belowCnt : cnt + (j0 + KKb) * (n * n) ≤ b0
  apZL : Apart (cnt + j0 * (n * n)) (KKb * (n * n)) zl (n * n)
  apZH : Apart (cnt + j0 * (n * n)) (KKb * (n * n)) zh (n * n)
  apRV : Apart (cnt + j0 * (n * n)) (KKb * (n * n)) rv NP

/-- The invariant: the data structure is ready, the first `E` cells from `cnt + j0 n²` hold their
answers, and no other cell below b0 has changed. -/
def QInv (pv : Sec2.Par) (t : ℕ) (hmL : pv.m ≤ pv.L) (aX aY b0 : ℕ) (AL : ArrL pv) (AR : Light.Batch.ArrR pv)
    (μ₀ : ℕ → ℤ) (n k : ℕ) (ZL ZH : List ℕ) (base E : ℕ) (μ : ℕ → ℤ) : Prop :=
  DSReadyA pv t aX aY b0 AL AR μ ∧ (∀ e < E, μ (base + e) = qAns pv t hmL AL AR n k ZL ZH e) ∧
    ∀ x < b0, (x < base ∨ base + E ≤ x) → μ x = μ₀ x

/-- The time of the queries of a batch. -/
def tQueries (KKb n tq : ℕ) : ℕ := KKb * (n * (n * (tq + 80) + 20) + 80) + 30

section cell

variable {pv : Sec2.Par} {t : ℕ} {aX aY b0 : ℕ} {AL : ArrL pv} {AR : ArrR pv} {U : ℤ}
  {μ₀ : ℕ → ℤ} {zl zh rv n k NP KKb cnt j0 : ℕ} {ZL ZH : List ℕ}

/-- The locals of queries. -/
abbrev qFr (b0 zl zh rv n k N0 K0 KKb cnt j0 g h a b : ℕ) (I J r : ℤ) (dst u : ℕ) : List ℤ :=
  [b0, zl, zh, rv, n, k, N0, K0, KKb, cnt, j0, g, h, a, b, I, J, r, dst, u]

/-- The time of the queries of a row `a`. -/
def tQRow (n tq : ℕ) : ℕ := n * (tq + 80) + 6

/-- The time of the queries of a product. -/
def tQRows (n tq : ℕ) : ℕ := n * (tQRow n tq + 10) + 6

/-- The time of a product. -/
def tQProd (n tq : ℕ) : ℕ := tQRows n tq + 60

end cell

end Light.Batch
end
end


