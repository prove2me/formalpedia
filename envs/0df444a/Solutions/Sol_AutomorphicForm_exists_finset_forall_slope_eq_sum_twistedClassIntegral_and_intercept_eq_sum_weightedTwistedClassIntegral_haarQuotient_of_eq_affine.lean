theorem affine_unique {A B A' B' : ℂ} {R₀ : ℝ}
    (h : ∀ R : ℝ, R₀ ≤ R → (R : ℂ) * A + B = (R : ℂ) * A' + B') : A = A' ∧ B = B' := by
  have h0 := h R₀ le_rfl
  have h1 := h (R₀ + 1) (by linarith)
  have hA : A = A' := by
    have : ((R₀ + 1 : ℝ) : ℂ) * A + B - ((R₀ : ℂ) * A + B) = ((R₀ + 1 : ℝ) : ℂ) * A' + B' - ((R₀ : ℂ) * A' + B') := by
      rw [h1, h0]
    push_cast at this
    linear_combination this
  refine ⟨hA, ?_⟩
  rw [hA] at h0
  linear_combination h0
end H5ASMi

