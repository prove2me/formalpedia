theorem ModularCurve.finrank_tensorProduct_intTwoCuspForms_eq_finrank_twoCompRegularDifferentials
    (p : ℕ) [Fact p.Prime] (M : ℕ) [NeZero M] (hpM : p ∣ M) (hpM2 : ¬ p ^ 2 ∣ M)
    (H : Subgroup (ZMod M)ˣ)
    (hHp : ∀ u : (ZMod M)ˣ, ZMod.unitsMap (Nat.div_dvd_of_dvd hpM) u = 1 → u ∈ H)
    (K : Type*) [Field K] [IsAlgClosed K] [CharP K p] [Algebra (ZMod p) K] :
    FiniteDimensional K (K ⊗[ZMod p] CuspForm.IntTwoCuspForms M H p) ∧
      FiniteDimensional K ↥(ModularCurve.twoCompRegularDifferentials K (CohCarrier.GammaH (M / p) (ModularCurve.infSubgroup p M H hpM)) p) ∧
      Module.finrank K (K ⊗[ZMod p] CuspForm.IntTwoCuspForms M H p) =
        Module.finrank K ↥(ModularCurve.twoCompRegularDifferentials K (CohCarrier.GammaH (M / p) (ModularCurve.infSubgroup p M H hpM)) p) := by sorry
