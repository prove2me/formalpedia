def GenHom (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) : Prop :=
  ∀ i ξ x, f i ξ x ∈ ⋀[ℝ]^(i + 1) (Module.Dual ℝ (Fin m → ℝ))

noncomputable def ceLift (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f) : CE L →ₐ[ℝ] Ω m :=
  (generator_lift_dga.1 f hf).choose

theorem ceLift_gen (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f) (i : ℕ)
    (ξ : Module.Dual ℝ (L i)) : ceLift f hf (gen L i ξ) = f i ξ :=
  (generator_lift_dga.1 f hf).choose_spec i ξ

noncomputable def retr (S : GenSys L) (i : ℕ) : Module.Dual ℝ (L i) →ₗ[ℝ] S i :=
  (LinearMap.exists_leftInverse_of_injective (K := ℝ) (V := S i) (V' := Module.Dual ℝ (L i))
    (S i).subtype (Submodule.ker_subtype _)).choose

theorem retr_spec (S : GenSys L) (i : ℕ) (ξ : S i) : retr S i (ξ : Module.Dual ℝ (L i)) = ξ :=
  LinearMap.congr_fun
    (LinearMap.exists_leftInverse_of_injective (K := ℝ) (V := S i) (V' := Module.Dual ℝ (L i))
      (S i).subtype (Submodule.ker_subtype _)).choose_spec ξ

noncomputable def rawVal (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) (i : ℕ) :
    Module.Dual ℝ (L i) →ₗ[ℝ] Ω m :=
  if h : i < m then
    ∑ k : Fin (Module.finrank ℝ (S i)), LinearMap.smulRight
      ((Finsupp.lapply k).comp ((genBasis S i).repr.toLinearMap.comp (retr S i)))
      (wRep hr (z ⟨i, h⟩ k))
  else 0

theorem rawVal_lt (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) {i : ℕ} (h : i < m)
    (ξ : Module.Dual ℝ (L i)) :
    rawVal hr S z i ξ = ∑ k : Fin (Module.finrank ℝ (S i)),
      (genBasis S i).repr (retr S i ξ) k • wRep hr (z ⟨i, h⟩ k) := by
  simp only [rawVal, h, ↓reduceDIte, LinearMap.sum_apply,
    LinearMap.smulRight_apply, LinearMap.comp_apply, Finsupp.lapply_apply,
    LinearEquiv.coe_coe]

theorem rawVal_ge (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) {i : ℕ} (h : ¬ i < m)
    (ξ : Module.Dual ℝ (L i)) : rawVal hr S z i ξ = 0 := by
  simp only [rawVal, h, ↓reduceDIte, LinearMap.zero_apply]

theorem isDeg_rawVal (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) (i : ℕ)
    (ξ : Module.Dual ℝ (L i)) : IsDeg (i + 1) (rawVal hr S z i ξ) := by
  by_cases h : i < m
  · rw [rawVal_lt hr S z h]
    intro x hx
    rw [Finset.sum_apply]
    exact Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _ ((wRep_spec hr _).1.1 x hx)
  · rw [rawVal_ge hr S z h]
    exact isDeg_zero

open Classical in
noncomputable def cutL : Ω m →ₗ[ℝ] Ω m where
  toFun ϖ x := if x ∈ simplex m then ϖ x else 0
  map_add' ϖ ϖ' := by funext x; by_cases hx : x ∈ simplex m <;> simp [hx]
  map_smul' c ϖ := by funext x; by_cases hx : x ∈ simplex m <;> simp [hx]

theorem cutL_eqOn (ϖ : Ω m) : FormEqOn (cutL ϖ) ϖ := fun x hx => by simp [cutL, hx]

noncomputable def genVal (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) (i : ℕ) :
    Module.Dual ℝ (L i) →ₗ[ℝ] Ω m :=
  cutL ∘ₗ rawVal hr S z i

theorem genHom_genVal (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) : GenHom (genVal hr S z) :=
  fun i ξ x => by
  by_cases hx : x ∈ simplex m
  · simp only [genVal, cutL, LinearMap.comp_apply, LinearMap.coe_mk, AddHom.coe_mk, hx, ↓reduceIte]
    exact isDeg_rawVal hr S z i ξ x hx
  · simp only [genVal, cutL, LinearMap.comp_apply, LinearMap.coe_mk, AddHom.coe_mk, hx, ↓reduceIte]
    exact Submodule.zero_mem _

theorem isCr_genVal (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) (i : ℕ)
    (ξ : Module.Dual ℝ (L i)) : IsCr r (genVal hr S z i ξ) := by
  have e : ∀ x ∈ simplex m, rawVal hr S z i ξ x = genVal hr S z i ξ x :=
    fun x hx => (cutL_eqOn (rawVal hr S z i ξ) x hx).symm
  refine generator_lift_dga.2.2.2.2.2.2.2.2 e ?_
  by_cases h : i < m
  · rw [rawVal_lt hr S z h]
    exact IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 hr _ _ fun k _ => isCr_smul hr _ (wRep_spec hr _).1.2
  · rw [rawVal_ge hr S z h]; exact isCr_zero

theorem genVal_ge (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) {i : ℕ} (h : m ≤ i)
    (ξ : Module.Dual ℝ (L i)) : genVal hr S z i ξ = 0 := by
  show cutL (rawVal hr S z i ξ) = 0
  rw [rawVal_ge hr S z (by omega), map_zero]

theorem jet_genVal_basis (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S m) (t : Fin m)
    (k : Fin (Module.finrank ℝ (S t))) :
    jet r (genVal hr S z t (genBasis S t k)) = z t k := by
  have e : FormEqOn (genVal hr S z t (genBasis S t k)) (wRep hr (z t k)) := fun x hx => by
    show cutL (rawVal hr S z t (genBasis S t k)) x = _
    rw [cutL_eqOn _ x hx, rawVal_lt hr S z t.2, retr_spec, Module.Basis.repr_self]
    simp only [Finsupp.single_apply, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq,
      Finset.mem_univ, ↓reduceIte, Fin.eta]
  rw [jet_congr e]
  exact (wRep_spec hr (z t k)).2

theorem ceLift_mem_deg (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f) {p : ℕ}
    {a : CE L} (ha : a ∈ ceDeg L p) (x : Fin m → ℝ) :
    ceLift f hf a x ∈ ⋀[ℝ]^p (Module.Dual ℝ (Fin m → ℝ)) :=
  IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 f hf (ceLift f hf) (ceLift_gen f hf) ha x

theorem genVal_eqOn_of_integ (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (z : Amb r S m)
    (φ : genAlg L S →ₐ[ℝ] Ω m) (hφ : IsDGAMap r δ S m φ)
    (hz : ∀ (t : Fin m) (k : Fin (Module.finrank ℝ (S t))),
      (z t k : Jet r m × Jet r m) =
        jet r (φ ⟨gen L t (genBasis S t k), gen_mem_genAlg S (genBasis S t k).2⟩))
    (i : ℕ) (ξ : Module.Dual ℝ (L i)) (hξ : ξ ∈ S i) :
    FormEqOn (φ ⟨gen L i ξ, gen_mem_genAlg S hξ⟩) (genVal hr S z i ξ) :=
  IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 hr δ S z (genVal hr S z) (isCr_genVal hr S z) (fun i h ξ => genVal_ge hr S z h ξ)
    (jet_genVal_basis hr S z) φ hφ hz i ξ hξ
end AmbVal

end IntLInfty.Kan.A83I1

namespace IntLInfty.Kan.A83KM

open IntLInfty.Kan IntLInfty.Kan.A83
open scoped ContDiff

variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]


/-- `res` as a continuous linear map. -/
noncomputable def resCLM {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (r m : ℕ) :
    Amb r S m →L[ℝ] Amb r S' m where
  toFun := res h
  map_add' z w := funext fun t => funext fun k => by
    show ∑ l, _ • (z + w) t l = (∑ l, _ • z t l) + ∑ l, _ • w t l
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun l _ => smul_add _ _ _
  map_smul' c z := funext fun t => funext fun k => by
    show ∑ l, _ • (c • z) t l = c • ∑ l, _ • z t l
    rw [Finset.smul_sum]
    exact Finset.sum_congr rfl fun l _ => smul_comm (_ : ℝ) c (z t l)
  cont := continuous_pi fun t => continuous_pi fun k =>
    continuous_finset_sum _ fun l _ =>
      (continuous_const_smul ((genBasis S t).repr (Submodule.inclusion (h t) (genBasis S' t k)) l)).comp
        ((continuous_apply l).comp (continuous_apply t))

theorem faceAmb_res {r : ℕ} (hr : 1 ≤ r) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (m : ℕ)
    (i : Fin (m + 2)) (z : Amb r S (m + 1)) :
    faceAmb r S' m i (res h z) = res h (faceAmb r S m i z) := by
  funext t k
  show faceLin hr ((t : ℕ) + 1) i (∑ l, _ • z t.castSucc l) =
    ∑ l, _ • faceLin hr ((t : ℕ) + 1) i (z t.castSucc l)
  rw [map_sum]
  exact Finset.sum_congr rfl fun l _ => map_smul _ _ _

theorem genAlg_mono {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) : genAlg L S' ≤ genAlg L S :=
  Algebra.adjoin_mono (Set.iUnion_mono fun i => Set.image_mono (h i))

noncomputable def jetLin {r m : ℕ} (hr : 1 ≤ r) {S : GenSys L} (φ : genAlg L S →ₐ[ℝ] Ω m)
    (hcr : ∀ a, IsCr r (φ a)) : genAlg L S →ₗ[ℝ] Jet r m × Jet r m where
  toFun a := jet r (φ a)
  map_add' a b := by rw [map_add]; exact jet_add hr (hcr a) (hcr b)
  map_smul' c a := by rw [map_smul]; exact jet_smul hr c (hcr a)

theorem jetLin_apply {r m : ℕ} (hr : 1 ≤ r) {S : GenSys L} (φ : genAlg L S →ₐ[ℝ] Ω m)
    (hcr : ∀ a, IsCr r (φ a)) (a : genAlg L S) : jetLin hr φ hcr a = jet r (φ a) := rfl

theorem gen_expand {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (t : ℕ)
    (k : Fin (Module.finrank ℝ (S' t))) :
    (⟨gen L t (genBasis S' t k), gen_mem_genAlg S (h t (genBasis S' t k).2)⟩ : genAlg L S) =
      ∑ l, (genBasis S t).repr (Submodule.inclusion (h t) (genBasis S' t k)) l •
        (⟨gen L t (genBasis S t l), gen_mem_genAlg S (genBasis S t l).2⟩ : genAlg L S) := by
  have e1 : ((genBasis S' t k : S' t) : Module.Dual ℝ (L t)) =
      ∑ l, (genBasis S t).repr (Submodule.inclusion (h t) (genBasis S' t k)) l •
        ((genBasis S t l : S t) : Module.Dual ℝ (L t)) := by
    have := congrArg (fun v : S t => (v : Module.Dual ℝ (L t)))
      ((genBasis S t).sum_repr (Submodule.inclusion (h t) (genBasis S' t k)))
    simp only [Submodule.coe_sum, Submodule.coe_smul] at this
    exact this.symm
  apply Subtype.ext
  rw [AddSubmonoidClass.coe_finset_sum]
  simp only [SetLike.val_smul]
  rw [e1, map_sum]
  simp only [map_smul]

theorem res_coe {r m : ℕ} {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (z : Amb r S m) (t : Fin m)
    (k : Fin (Module.finrank ℝ (S' t))) :
    (res h z t k : Jet r m × Jet r m) =
      ∑ l, (genBasis S t).repr (Submodule.inclusion (h t) (genBasis S' t k)) l •
        (z t l : Jet r m × Jet r m) := by
  show ((∑ l, _ • z t l : CrForms r m (t + 1)) : Jet r m × Jet r m) = _
  rw [Submodule.coe_sum]
  simp only [Submodule.coe_smul]

theorem isDGAMap_restrict {r m : ℕ} (δ : LInfty L) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i)
    {φ : genAlg L S →ₐ[ℝ] Ω m} (hφ : IsDGAMap r δ S m φ) :
    IsDGAMap r δ S' m (φ.comp (Subalgebra.inclusion (genAlg_mono h))) := by
  obtain ⟨hdeg, hcr, hd⟩ := hφ
  refine ⟨fun t ξ hξ => ?_, fun a => ?_, fun a b hab x hx => ?_⟩
  · rw [AlgHom.comp_apply, Subalgebra.inclusion_mk]
    exact hdeg t ξ (h t hξ)
  · rw [AlgHom.comp_apply]
    exact hcr _
  · rw [AlgHom.comp_apply, AlgHom.comp_apply]
    refine hd _ _ ?_ x hx
    rw [Subalgebra.coe_inclusion, Subalgebra.coe_inclusion]
    exact hab

set_option maxHeartbeats 4000000 in
theorem res_mem_integ {r : ℕ} (hr : 1 ≤ r) (δ : LInfty L) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i)
    (m : ℕ) {z : Amb r S m} (hz : z ∈ integ r δ S m) : res h z ∈ integ r δ S' m := by
  obtain ⟨φ, hφ, hzφ⟩ := hz
  have hcr := hφ.2.1
  refine ⟨φ.comp (Subalgebra.inclusion (genAlg_mono h)), isDGAMap_restrict δ h hφ, fun t k => ?_⟩
  rw [res_coe h z t k]
  rw [AlgHom.comp_apply, Subalgebra.inclusion_mk]
  rw [← jetLin_apply hr φ hcr, gen_expand h t k, map_sum]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [map_smul, jetLin_apply, ← hzφ t l]

end IntLInfty.Kan.A83KM

namespace IntLInfty.Kan.A83Comp

open IntLInfty.Kan IntLInfty.Kan.A83
open scoped ContDiff

variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]

theorem res_res {r m : ℕ} {S S' S'' : GenSys L} (h1 : ∀ i, S' i ≤ S i) (h2 : ∀ i, S'' i ≤ S' i)
    (z : Amb r S m) :
    res h2 (res h1 z) = res (fun i => (h2 i).trans (h1 i)) z := by
  funext t k
  have key : ∀ p, (genBasis S t).repr (Submodule.inclusion ((h2 t).trans (h1 t)) (genBasis S'' t k)) p
      = ∑ l, (genBasis S' t).repr (Submodule.inclusion (h2 t) (genBasis S'' t k)) l *
          (genBasis S t).repr (Submodule.inclusion (h1 t) (genBasis S' t l)) p := by
    intro p
    have hw : Submodule.inclusion ((h2 t).trans (h1 t)) (genBasis S'' t k) =
        Submodule.inclusion (h1 t) (∑ l, (genBasis S' t).repr
          (Submodule.inclusion (h2 t) (genBasis S'' t k)) l • genBasis S' t l) := by
      rw [Module.Basis.sum_repr]; exact Subtype.ext rfl
    rw [hw, map_sum, map_sum]
    simp only [map_smul, Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.smul_apply, smul_eq_mul]
  show ∑ l, (genBasis S' t).repr (Submodule.inclusion (h2 t) (genBasis S'' t k)) l •
      (∑ p, (genBasis S t).repr (Submodule.inclusion (h1 t) (genBasis S' t l)) p • z t p) =
    ∑ p, (genBasis S t).repr (Submodule.inclusion ((h2 t).trans (h1 t)) (genBasis S'' t k)) p • z t p
  simp only [Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [← Finset.sum_smul]
  exact congrArg (· • z t p) (key p).symm

theorem hornCompat_res {r : ℕ} (hr : 1 ≤ r) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (m : ℕ)
    (j : Fin (m + 2)) (p : {i : Fin (m + 2) // i ≠ j} → Amb r S m)
    (hp : HornCompat (fun q => faceAmb r S q) m j p) :
    HornCompat (fun q => faceAmb r S' q) m j (fun i => res h (p i)) := by
  cases m with
  | zero => exact True.intro
  | succ q =>
    intro a b hab ha hb
    have e := hp a b hab ha hb
    show faceAmb r S' q a (res h (p ⟨b.succ, hb⟩)) = faceAmb r S' q b (res h (p ⟨a.castSucc, ha⟩))
    rw [A83KM.faceAmb_res hr h q a, A83KM.faceAmb_res hr h q b]
    exact congrArg (res h) e

/-- Filler data for `∫_S → ∫_{S'}` at level `m`, horn `j` (the inputs of `isKanFibration_of_filler'`). -/
def FillerAt (r : ℕ) (δ : LInfty L) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (m : ℕ)
    (j : Fin (m + 2))
    (σ : Amb r S (m + 1) → (({i : Fin (m + 2) // i ≠ j} → Amb r S m) × Amb r S' (m + 1)) →
      Amb r S (m + 1)) : Prop :=
  (∀ x, ContDiff ℝ ∞ (σ x)) ∧
  (∀ x ∈ integ r δ S (m + 1), ∀ y ∈ RelHorn r δ h m j,
      σ x y ∈ integ r δ S (m + 1) ∧ kanMap h m j (σ x y) = y) ∧
  (∀ x ∈ integ r δ S (m + 1), σ x (kanMap h m j x) = x)

/-- Composition of fillers: `∫_S → ∫_{S'}` and `∫_{S'} → ∫_{S''}` give `∫_S → ∫_{S''}`. -/
theorem fillerAt_comp {r : ℕ} (hr : 1 ≤ r) (δ : LInfty L) {S S' S'' : GenSys L}
    (h1 : ∀ i, S' i ≤ S i) (h2 : ∀ i, S'' i ≤ S' i) (m : ℕ) (j : Fin (m + 2))
    {σ1 : Amb r S (m + 1) → (({i : Fin (m + 2) // i ≠ j} → Amb r S m) × Amb r S' (m + 1)) →
      Amb r S (m + 1)}
    {σ2 : Amb r S' (m + 1) → (({i : Fin (m + 2) // i ≠ j} → Amb r S' m) × Amb r S'' (m + 1)) →
      Amb r S' (m + 1)}
    (hσ1 : FillerAt r δ h1 m j σ1) (hσ2 : FillerAt r δ h2 m j σ2) :
    FillerAt r δ (fun i => (h2 i).trans (h1 i)) m j
      (fun x y => σ1 x (y.1, σ2 (res h1 x) (fun i => res h1 (y.1 i), y.2))) := by
  obtain ⟨c1, M1, X1⟩ := hσ1
  obtain ⟨c2, M2, X2⟩ := hσ2
  refine ⟨fun x => ?_, fun x hx y hy => ?_, fun x hx => ?_⟩
  · have hin : ContDiff ℝ ∞
        (fun y : ({i : Fin (m + 2) // i ≠ j} → Amb r S m) × Amb r S'' (m + 1) =>
          ((fun i => res h1 (y.1 i)), y.2)) := by
      refine ContDiff.prodMk (contDiff_pi.2 fun i => ?_) contDiff_snd
      exact (A83KM.resCLM h1 r m).contDiff.comp ((contDiff_pi.1 contDiff_id i).comp contDiff_fst)
    exact (c1 x).comp (contDiff_fst.prodMk ((c2 (res h1 x)).comp hin))
  · obtain ⟨hp, hz, hc, hf⟩ := hy
    have hx' : res h1 x ∈ integ r δ S' (m + 1) := A83KM.res_mem_integ hr δ h1 (m + 1) hx
    have hy' : ((fun i => res h1 (y.1 i)), y.2) ∈ RelHorn r δ h2 m j := by
      refine ⟨fun i => A83KM.res_mem_integ hr δ h1 m (hp i), hz, hornCompat_res hr h1 m j y.1 hc,
        fun i => ?_⟩
      show faceAmb r S'' m i.1 y.2 = res h2 (res h1 (y.1 i))
      rw [hf i]
      exact (res_res h1 h2 _).symm
    obtain ⟨hw, hkw⟩ := M2 (res h1 x) hx' _ hy'
    have hy'' : (y.1, σ2 (res h1 x) ((fun i => res h1 (y.1 i)), y.2)) ∈ RelHorn r δ h1 m j := by
      refine ⟨hp, hw, hc, fun i => ?_⟩
      exact congrArg (fun q => q.1 i) hkw
    obtain ⟨hv, hkv⟩ := M1 x hx _ hy''
    refine ⟨hv, ?_⟩
    have e1 : (fun i : {i : Fin (m + 2) // i ≠ j} =>
        faceAmb r S m i.1 (σ1 x (y.1, σ2 (res h1 x) ((fun i => res h1 (y.1 i)), y.2)))) = y.1 :=
      congrArg Prod.fst hkv
    have e2 : res h1 (σ1 x (y.1, σ2 (res h1 x) ((fun i => res h1 (y.1 i)), y.2))) =
        σ2 (res h1 x) ((fun i => res h1 (y.1 i)), y.2) := congrArg Prod.snd hkv
    have e3 : res h2 (σ2 (res h1 x) ((fun i => res h1 (y.1 i)), y.2)) = y.2 :=
      congrArg Prod.snd hkw
    refine Prod.ext e1 ?_
    show res (fun i => (h2 i).trans (h1 i))
      (σ1 x (y.1, σ2 (res h1 x) ((fun i => res h1 (y.1 i)), y.2))) = y.2
    rw [← res_res h1 h2, e2, e3]
  · have hx' := A83KM.res_mem_integ hr δ h1 (m + 1) hx
    have e : ((fun i => res h1 ((kanMap (fun i => (h2 i).trans (h1 i)) m j x).1 i)),
        (kanMap (fun i => (h2 i).trans (h1 i)) m j x).2) = kanMap h2 m j (res h1 x) := by
      refine Prod.ext (funext fun i => ?_) ?_
      · show res h1 (faceAmb r S m i.1 x) = faceAmb r S' m i.1 (res h1 x)
        exact (A83KM.faceAmb_res hr h1 m i.1 x).symm
      · show res (fun i => (h2 i).trans (h1 i)) x = res h2 (res h1 x)
        exact (res_res h1 h2 x).symm
    show σ1 x ((kanMap (fun i => (h2 i).trans (h1 i)) m j x).1,
      σ2 (res h1 x) ((fun i => res h1 ((kanMap (fun i => (h2 i).trans (h1 i)) m j x).1 i)),
        (kanMap (fun i => (h2 i).trans (h1 i)) m j x).2)) = x
    rw [e, X2 _ hx']
    exact X1 x hx

end IntLInfty.Kan.A83Comp

namespace IntLInfty.Kan.A83Low

open IntLInfty.Kan IntLInfty.Kan.A83 IntLInfty.Kan.A83I1 IntLInfty.Kan.A83Comp
open scoped ContDiff

set_option linter.unusedSectionVars false

variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]

theorem jet_zero' {r m : ℕ} (hr : 1 ≤ r) : jet r (0 : Ω m) = 0 := by
  have := jet_smul hr (0 : ℝ) (isCr_zero (r := r) (m := m))
  simpa using this

theorem extD_zero' {r m : ℕ} (hr : 1 ≤ r) {x : Fin m → ℝ} (hx : x ∈ simplex m) :
    extD (0 : Ω m) x = 0 := by
  have := extD_smul hr (0 : ℝ) (isCr_zero (r := r) (m := m)) hx
  simpa using this

theorem isCr_sum {r M : ℕ} (hr : 1 ≤ r) {ι : Type} (s : Finset ι) (ϖ : ι → Ω M)
    (h : ∀ k ∈ s, IsCr r (ϖ k)) : IsCr r (∑ k ∈ s, ϖ k) :=
  IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 hr s ϖ h

theorem alg_eq_zero_of_lt {m p : ℕ} (hp : m < p)
    {a : ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ))}
    (ha : a ∈ ⋀[ℝ]^p (Module.Dual ℝ (Fin m → ℝ))) : a = 0 :=
  IntLInfty.Kan.integ_iff_generator_condition.2.2.2.2.2.2.2.2.2.2.2.2.2.1 hp ha

theorem gen_mem_ceDeg (i : ℕ) (ξ : Module.Dual ℝ (L i)) : gen L i ξ ∈ ceDeg L (i + 1) :=
  Submodule.subset_span ⟨1, fun _ => i, fun _ => ξ, by simp, by simp⟩

/-- `CrForms`-valued generator values of `w : Amb r S m` (degree `≥ m` generators go to `0`). -/
noncomputable def valC {r m : ℕ} (S : GenSys L) (w : Amb r S m) (t : ℕ) :
    Module.Dual ℝ (L t) →ₗ[ℝ] CrForms r m (t + 1) :=
  if h : t < m then
    ∑ k : Fin (Module.finrank ℝ (S t)), LinearMap.smulRight
      ((Finsupp.lapply k).comp ((genBasis S t).repr.toLinearMap.comp (retr S t)))
      (w ⟨t, h⟩ k)
  else 0

theorem valC_lt {r m : ℕ} (S : GenSys L) (w : Amb r S m) {t : ℕ} (h : t < m)
    (ξ : Module.Dual ℝ (L t)) :
    valC S w t ξ = ∑ k : Fin (Module.finrank ℝ (S t)),
      (genBasis S t).repr (retr S t ξ) k • w ⟨t, h⟩ k := by
  simp only [valC, h, ↓reduceDIte, LinearMap.sum_apply,
    LinearMap.smulRight_apply, LinearMap.comp_apply, Finsupp.lapply_apply,
    LinearEquiv.coe_coe]

theorem valC_ge {r m : ℕ} (S : GenSys L) (w : Amb r S m) {t : ℕ} (h : ¬ t < m)
    (ξ : Module.Dual ℝ (L t)) : valC S w t ξ = 0 := by
  simp only [valC, h, ↓reduceDIte, LinearMap.zero_apply]

theorem valC_of_mem {r m : ℕ} (S : GenSys L) (w : Amb r S m) {t : ℕ} (h : t < m)
    {ξ : Module.Dual ℝ (L t)} (hξ : ξ ∈ S t) :
    valC S w t ξ = ∑ k : Fin (Module.finrank ℝ (S t)),
      (genBasis S t).repr ⟨ξ, hξ⟩ k • w ⟨t, h⟩ k := by
  have e : retr S t ξ = ⟨ξ, hξ⟩ := retr_spec S t ⟨ξ, hξ⟩
  rw [valC_lt S w h, e]

/-- Restriction `S' ≤ S` does not change the values on `S'`. -/
theorem valC_res {r m : ℕ} {S S' : GenSys L} (hS : ∀ i, S' i ≤ S i) (w : Amb r S m) (t : ℕ)
    {ξ : Module.Dual ℝ (L t)} (hξ : ξ ∈ S' t) : valC S' (res hS w) t ξ = valC S w t ξ := by
  by_cases h : t < m
  · have e1 : (⟨ξ, hS t hξ⟩ : S t) = Submodule.inclusion (hS t) ⟨ξ, hξ⟩ := rfl
    rw [valC_of_mem S' (res hS w) h hξ, valC_of_mem S w h (hS t hξ), e1]
    conv_rhs => rw [← (genBasis S' t).sum_repr ⟨ξ, hξ⟩]
    simp only [res, map_sum, map_smul, Finsupp.coe_finset_sum, Finsupp.coe_smul,
      Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finset.smul_sum, Finset.sum_smul, mul_smul]
    exact Finset.sum_comm
  · rw [valC_ge S' _ h, valC_ge S _ h]
theorem jet_sum_aux {r M : ℕ} (hr : 1 ≤ r) {ι : Type} (s : Finset ι) (f : ι → Ω M)
    (h : ∀ k, IsCr r (f k)) : jet r (∑ k ∈ s, f k) = ∑ k ∈ s, jet r (f k) := by
  classical
  refine Finset.induction_on s ?_ ?_
  · simp only [Finset.sum_empty]
    exact jet_zero' hr
  · intro a s ha ih
    rw [Finset.sum_insert ha, Finset.sum_insert ha,
      jet_add hr (h a) (isCr_sum hr s f fun k _ => h k), ih]

/-- The jet of a generator value is its `CrForms` value. -/
theorem jet_genVal {r M : ℕ} (hr : 1 ≤ r) (S : GenSys L) (z : Amb r S M) (i : ℕ)
    (ξ : Module.Dual ℝ (L i)) :
    jet r (genVal hr S z i ξ) = (valC S z i ξ : Jet r M × Jet r M) := by
  by_cases h : i < M
  · have e : FormEqOn (genVal hr S z i ξ) (rawVal hr S z i ξ) := cutL_eqOn (rawVal hr S z i ξ)
    rw [jet_congr e, rawVal_lt hr S z h, valC_lt S z h,
      jet_sum_aux hr _ _ fun k => isCr_smul hr _ (wRep_spec hr (z ⟨i, h⟩ k)).1.2,
      Submodule.coe_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [jet_smul hr _ (wRep_spec hr (z ⟨i, h⟩ k)).1.2, (wRep_spec hr _).2, Submodule.coe_smul]
  · rw [genVal_ge hr S z (by omega) ξ, valC_ge S z h, jet_zero' hr]
    rfl

theorem genVal_res {r M : ℕ} (hr : 1 ≤ r) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i)
    (z : Amb r S M) (i : ℕ) {ξ : Module.Dual ℝ (L i)} (hξ : ξ ∈ S' i) :
    FormEqOn (genVal hr S' (res h z) i ξ) (genVal hr S z i ξ) :=
  formEqOn_of_jet (isCr_genVal hr S' _ i ξ) (isCr_genVal hr S z i ξ) (by
    rw [jet_genVal, jet_genVal, valC_res h z i hξ])

/-- Two generator maps agreeing on the generators of `S` agree on `A_S` (on the simplex). -/
theorem ceLift_eqOn_gen {M : ℕ} (S : GenSys L) (f g : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω M)
    (hf : GenHom f) (hg : GenHom g)
    (hfg : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → FormEqOn (f i ξ) (g i ξ)) :
    ∀ a (_ : a ∈ Algebra.adjoin ℝ (⋃ i, (gen L i : Module.Dual ℝ (L i) → CE L) ''
      (S i : Set (Module.Dual ℝ (L i))))), FormEqOn (ceLift f hf a) (ceLift g hg a) := by
  intro a ha
  induction ha using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨i, ξ, hξ, rfl⟩ := Set.mem_iUnion.1 hy
    intro x hx
    rw [ceLift_gen, ceLift_gen]
    exact hfg i ξ hξ x hx
  | algebraMap c =>
    intro x hx
    exact congrFun (((ceLift f hf).commutes c).trans ((ceLift g hg).commutes c).symm) x
  | add y w hy hw ihy ihw =>
    intro x hx
    rw [map_add, map_add, Pi.add_apply, Pi.add_apply, ihy x hx, ihw x hx]
  | mul y w hy hw ihy ihw =>
    intro x hx
    rw [map_mul, map_mul, Pi.mul_apply, Pi.mul_apply, ihy x hx, ihw x hx]

/-- (⊆) A point of `∫_S` satisfies the generator-level DGA condition for `Φ_z`. -/
theorem genCond_of_integ {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L)
    (hcl : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S)
    {z : Amb r S M} (hz : z ∈ integ r δ S M) (i : ℕ) (ξ : Module.Dual ℝ (L i)) (hξ : ξ ∈ S i) :
    ∀ x ∈ simplex M, extD (genVal hr S z i ξ) x =
      ceLift (genVal hr S z) (genHom_genVal hr S z) (δ.δ (gen L i ξ)) x := by
  obtain ⟨φ, hφ, hzφ⟩ := hz
  have hg := fun i ξ hξ => genVal_eqOn_of_integ hr δ S z φ hφ hzφ i ξ hξ
  have hall : ∀ a (ha : a ∈ Algebra.adjoin ℝ (⋃ i, (gen L i : Module.Dual ℝ (L i) → CE L) ''
      (S i : Set (Module.Dual ℝ (L i))))),
      FormEqOn (φ ⟨a, ha⟩) (ceLift (genVal hr S z) (genHom_genVal hr S z) a) := by
    intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem y hy =>
      obtain ⟨i, ξ, hξ, rfl⟩ := Set.mem_iUnion.1 hy
      intro x hx
      rw [ceLift_gen]
      exact hg i ξ hξ x hx
    | algebraMap c =>
      intro x hx
      exact congrFun ((φ.commutes c).trans ((ceLift _ _).commutes c).symm) x
    | add y w hy hw ihy ihw =>
      intro x hx
      change φ (⟨y, hy⟩ + ⟨w, hw⟩) x = ceLift _ _ (y + w) x
      rw [map_add, map_add, Pi.add_apply, Pi.add_apply, ihy x hx, ihw x hx]
    | mul y w hy hw ihy ihw =>
      intro x hx
      change φ (⟨y, hy⟩ * ⟨w, hw⟩) x = ceLift _ _ (y * w) x
      rw [map_mul, map_mul, Pi.mul_apply, Pi.mul_apply, ihy x hx, ihw x hx]
  intro x hx
  have e1 := (extD_congr (hg i ξ hξ)) x hx
  have e2 := hφ.2.2 ⟨gen L i ξ, gen_mem_genAlg S hξ⟩ ⟨δ.δ (gen L i ξ), hcl _ _ hξ⟩ rfl x hx
  have e3 := hall _ (hcl _ _ hξ) x hx
  rw [← e1, e2, e3]

theorem integ_of_genCond {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (z : Amb r S M)
    (hd : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → ∀ x ∈ simplex M,
      extD (genVal hr S z i ξ) x =
        ceLift (genVal hr S z) (genHom_genVal hr S z) (δ.δ (gen L i ξ)) x) :
    z ∈ integ r δ S M :=
  ⟨(ceLift (genVal hr S z) (genHom_genVal hr S z)).comp (genAlg L S).val,
    generator_lift_dga.2.2.1 hr δ S _
      (fun i ξ _ x _ => by rw [ceLift_gen]; exact genHom_genVal hr S z i ξ x)
      (fun i ξ _ => by rw [ceLift_gen]; exact isCr_genVal hr S z i ξ)
      (fun i ξ h x hx => by rw [ceLift_gen]; exact hd i ξ h x hx),
    fun t k => by
      show _ = jet r (ceLift (genVal hr S z) (genHom_genVal hr S z) (gen L t (genBasis S t k)))
      rw [ceLift_gen]
      exact (jet_genVal_basis hr S z t k).symm⟩

/-- If `S` and `S'` agree below level `M`, then `res z ∈ ∫_{S'}` forces `z ∈ ∫_S`. -/
theorem integ_of_res_low {r M : ℕ} (hr : 1 ≤ r) (δ : LInfty L) {S S' : GenSys L}
    (h : ∀ i, S' i ≤ S i) (hlow : ∀ i, i < M → S i ≤ S' i)
    (hcl : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S)
    (hcl' : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S' i → δ.δ (gen L i ξ) ∈ genAlg L S')
    (z : Amb r S M) (hz : res h z ∈ integ r δ S' M) : z ∈ integ r δ S M := by
  have hagree : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i →
      FormEqOn (genVal hr S' (res h z) i ξ) (genVal hr S z i ξ) := by
    intro i ξ hξ
    by_cases hi : i < M
    · exact genVal_res hr h z i (hlow i hi hξ)
    · intro x _
      rw [genVal_ge hr S' (res h z) (by omega) ξ, genVal_ge hr S z (by omega) ξ]
  refine integ_of_genCond hr δ S z fun i ξ hξ x hx => ?_
  by_cases hi : i < M
  · have hξ' := hlow i hi hξ
    rw [← extD_congr (genVal_res hr h z i hξ') x hx,
      genCond_of_integ hr δ S' hcl' hz i ξ hξ' x hx]
    exact ceLift_eqOn_gen S _ _ _ _ hagree _ (hcl i ξ hξ) x hx
  · have hD := ceLift_mem_deg (genVal hr S z) (genHom_genVal hr S z)
      (δ.deg (i + 1) _ (gen_mem_ceDeg i ξ)) x
    rw [genVal_ge hr S z (by omega) ξ, extD_zero' hr hx]
    exact (alg_eq_zero_of_lt (p := i + 1 + 1) (by omega) hD).symm


theorem fillerAt_low {r m : ℕ} (hr : 1 ≤ r) (δ : LInfty L) {S S' : GenSys L}
    (h : ∀ i, S' i ≤ S i) (hlow : ∀ i, i < m + 1 → S i ≤ S' i)
    (hcl : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S)
    (hcl' : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S' i → δ.δ (gen L i ξ) ∈ genAlg L S')
    (j : Fin (m + 2)) : ∃ σ, FillerAt r δ h m j σ := by
  obtain ⟨Z, hZc, hZres, hZface, hZkan⟩ := (linear_horn_filler_ambient r hr L S S' h).1 m j
  refine ⟨Z, hZc, fun x _ y hy => ?_, fun x _ => hZkan x⟩
  obtain ⟨_, hy2, hy3, hy4⟩ := hy
  refine ⟨integ_of_res_low hr δ h hlow hcl hcl' _ (by rw [hZres x y]; exact hy2), ?_⟩
  exact Prod.ext (funext fun i => hZface x y hy3 hy4 i) (hZres x y)

end IntLInfty.Kan.A83Low

open scoped ContDiff

open IntLInfty.Kan in
theorem solution (r : ℕ) (hr : 1 ≤ r) (L : ℕ → Type) [∀ i, AddCommGroup (L i)]
    [∀ i, Module ℝ (L i)] [∀ i, FiniteDimensional ℝ (L i)] (δ : LInfty L) :
    (∀ (S S' S'' : GenSys L) (h1 : ∀ i, S' i ≤ S i) (h2 : ∀ i, S'' i ≤ S' i) (h3 : ∀ i, S'' i ≤ S i)
      (m : ℕ) (j : Fin (m + 2)),
      (∃ σ : Amb r S (m + 1) → (({i : Fin (m + 2) // i ≠ j} → Amb r S m) × Amb r S' (m + 1)) →
          Amb r S (m + 1),
        (∀ x, ContDiff ℝ ∞ (σ x)) ∧
        (∀ x ∈ integ r δ S (m + 1), ∀ y ∈ RelHorn r δ h1 m j,
            σ x y ∈ integ r δ S (m + 1) ∧ kanMap h1 m j (σ x y) = y) ∧
        (∀ x ∈ integ r δ S (m + 1), σ x (kanMap h1 m j x) = x)) →
      (∃ σ : Amb r S' (m + 1) → (({i : Fin (m + 2) // i ≠ j} → Amb r S' m) × Amb r S'' (m + 1)) →
          Amb r S' (m + 1),
        (∀ x, ContDiff ℝ ∞ (σ x)) ∧
        (∀ x ∈ integ r δ S' (m + 1), ∀ y ∈ RelHorn r δ h2 m j,
            σ x y ∈ integ r δ S' (m + 1) ∧ kanMap h2 m j (σ x y) = y) ∧
        (∀ x ∈ integ r δ S' (m + 1), σ x (kanMap h2 m j x) = x)) →
      ∃ σ : Amb r S (m + 1) → (({i : Fin (m + 2) // i ≠ j} → Amb r S m) × Amb r S'' (m + 1)) →
          Amb r S (m + 1),
        (∀ x, ContDiff ℝ ∞ (σ x)) ∧
        (∀ x ∈ integ r δ S (m + 1), ∀ y ∈ RelHorn r δ h3 m j,
            σ x y ∈ integ r δ S (m + 1) ∧ kanMap h3 m j (σ x y) = y) ∧
        (∀ x ∈ integ r δ S (m + 1), σ x (kanMap h3 m j x) = x)) ∧
    (∀ (S S' : GenSys L) (h : ∀ i, S' i ≤ S i) (m : ℕ), (∀ i, i < m + 1 → S i ≤ S' i) →
      (∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S) →
      (∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S' i → δ.δ (gen L i ξ) ∈ genAlg L S') →
      ∀ j : Fin (m + 2),
      ∃ σ : Amb r S (m + 1) → (({i : Fin (m + 2) // i ≠ j} → Amb r S m) × Amb r S' (m + 1)) →
          Amb r S (m + 1),
        (∀ x, ContDiff ℝ ∞ (σ x)) ∧
        (∀ x ∈ integ r δ S (m + 1), ∀ y ∈ RelHorn r δ h m j,
            σ x y ∈ integ r δ S (m + 1) ∧ kanMap h m j (σ x y) = y) ∧
        (∀ x ∈ integ r δ S (m + 1), σ x (kanMap h m j x) = x))  :=
  ⟨fun _ _ _ h1 h2 _ m j ⟨_, hσ1⟩ ⟨_, hσ2⟩ => ⟨_, A83Comp.fillerAt_comp hr δ h1 h2 m j hσ1 hσ2⟩,
   fun _ _ h _ hlow hcl hcl' j => A83Low.fillerAt_low hr δ h hlow hcl hcl' j⟩
