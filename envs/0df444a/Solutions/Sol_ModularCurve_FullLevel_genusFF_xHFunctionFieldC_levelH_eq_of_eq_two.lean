theorem solution
    (q : ℕ) [Fact q.Prime] (hq2 : q = 2) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (κ : Type) [Field κ] [CharP κ q] [IsAlgClosed κ] :
    (AlgebraicCurve.genusFF κ ↥(xHFunctionFieldC κ (q ^ 2 * M') (levelH q M')) : ℚ) = genusFormula M' := by
  classical
  have hE : xHFunctionFieldC κ (q ^ 2 * M') (levelH q M') = modularFunctionFieldC κ M' :=
    xHFunctionFieldC_levelH_eq_modularFunctionFieldC_of_eq_two q hq2 M' hqM' κ
  have h1 : (genusFF κ ↥(xHFunctionFieldC κ (q ^ 2 * M') (levelH q M')) : ℚ) =
      (genusFF κ ↥(modularFunctionFieldC κ M') : ℚ) :=
    congrArg (fun X : IntermediateField κ (LaurentSeries κ) => (genusFF κ ↥X : ℚ)) hE
  rw [h1]
  exact IgusaGenusQ2.genusFF_E0_eq q M' κ hqM'

end S_ModularCurve_FullLevel_genusFF_xHFunctionFieldC_levelH_eq_of_eq_two
end P2MW
