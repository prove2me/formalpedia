theorem runQ_of_sImplQ {σ : Fin HS → Option ℤ} {lo hi r : ℕ} {st : ι → ℕ} {n : ℕ}
    {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ} {U : IStmt HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
