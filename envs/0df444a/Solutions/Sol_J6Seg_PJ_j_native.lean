-- Source module: Solutions.J6SegJPre4
/-!
# `J` kernel precondition (JPre), part 4: the intermediates of the kernel in closed form

For the streams `fsOf`/`bsOf` of a sorted line `L` (pattern `bandS mw c`, border `c ≤ ·`) and an
input `v` (`|L| ≤ |v|`), with the right-hand side `bv L v` (`bv (L_r) = v_r`):

* `fA_eq`: the forward accumulator after `r` rows is `accF r = [bt_{r-1}, …, bt_0]`;
* `bwdS_eq`: the backward state after `j` records is `(accZ (m-j), accB (m-j))` (the solution
  values `z_{m-j}, …, z_{m-1}` and their border part);
* the shapes of the streams (`fsOf_getElem_length`, `bsOf_getElem`, `WbOf_le`,
  `czOf_length`, `flOf_01`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK

section line
variable {P : ℕ} {L : List ℕ} {mw c : ℕ} {A : ℕ → ℕ → ℤ}

lemma bsOf_getElem {j : ℕ} (hj : j < (bsOf P L mw c A).length) :
    (bsOf P L mw c A)[j] =
      (cbOf P (bandS mw c) L A (c ≤ ·) (WbOf L mw (L.length - 1 - j)) (L.length - 1 - j),
        czOf P (bandS mw c) L A (c ≤ ·) (L.length - 1 - j),
        Aseq P (bandS mw c) L A (L.length - 1 - j) (L.getD (L.length - 1 - j) 0)
          (L.getD (L.length - 1 - j) 0), flOf L (c ≤ ·) (L.length - 1 - j)) := by
  simp [bsOf, List.getElem_reverse]

end line

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegJPre6
/-!
# `J` kernel precondition (JPre), part 6: the explicit parameters and the table length

* `Xb0 P w Bv = max Bv P + size (2w+1) + 4`: the a-priori bit bound of every stream entry and
  intermediate of the `J` kernel on an input with `Bnd Bv`;
* `Bc0 s K G = size (G + 2K + 3s² + 2Ks + 10s)`: the counter bound;
* `jBody_len`: `|jBody| ≤ 3m² + 2Km + 7m` for streams of `m` rows with the line shapes;
* `zsz_of_abs`, `abs_of_bnd`: between `zsz` bounds and real bounds;
* `xb0_ge`: `2^{Xb0} ≥ 16 (2w+2) 2^{max Bv P}`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK
open IntMul NLogN NLogN.KIL Function

lemma length_flatMap_le {α : Type*} (l : List α) (g : α → List ℤ) (c : ℕ)
    (h : ∀ x ∈ l, (g x).length ≤ c) : (l.flatMap g).length ≤ l.length * c := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.flatMap_cons, List.length_append, List.length_cons]
    have h1 := h a (by simp)
    have h2 := ih (fun x hx => h x (by simp [hx]))
    rw [Nat.succ_mul]; omega

theorem jBody_len {k m K : ℕ} {fs : List (List ℤ)} {bs : List (List ℤ × List ℤ × ℤ × ℤ)}
    {cc : List (List ℤ)} (hfs : fs.length = m) (hbs : bs.length = m) (hcc : cc.length = m)
    (hf : ∀ r (h : r < fs.length), fs[r].length + 1 ≤ m)
    (hb : ∀ j (h : j < bs.length), bs[j].1.length ≤ m ∧ bs[j].2.1.length ≤ m)
    (hc : ∀ r (h : r < cc.length), cc[r].length = 2 * K + 1) :
    (jBody k fs bs cc).length ≤ 3 * m ^ 2 + 2 * K * m + 7 * m := by
  unfold jBody
  have h1 : (flatT fs).length ≤ fs.length * m := by
    apply length_flatMap_le
    intro x hx
    obtain ⟨r, hr, rfl⟩ := List.mem_iff_getElem.1 hx
    simp only [rowT, List.length_cons]; exact hf r hr
  have h2 : (flatB k bs).length ≤ bs.length * (2 * m + 5) := by
    apply length_flatMap_le
    intro x hx
    obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.1 hx
    have := hb j hj
    simp only [recT, rowT, List.length_append, List.length_cons, List.length_nil]
    omega
  have h3 : (flatT cc).length ≤ cc.length * (2 * K + 2) := by
    apply length_flatMap_le
    intro x hx
    obtain ⟨r, hr, rfl⟩ := List.mem_iff_getElem.1 hx
    simp only [rowT, List.length_cons]; rw [hc r hr]
  rw [hfs] at h1; rw [hbs] at h2; rw [hcc] at h3
  simp only [List.length_append]
  have e : m * m + m * (2 * m + 5) + m * (2 * K + 2) = 3 * m ^ 2 + 2 * K * m + 7 * m := by ring
  omega

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegJPre3
/-!
# `J` kernel precondition (JPre), part 3: the round-six regime

`r6_segReg`: for `n ≥ n₁` and every admissible source list, every axis `j < d` of the machine
(`P = segPF p d s_j`, `R = ⌊p/7⌋`, `λ = lamP d`, `w = wF d`, `s = s_j`, `t = t_j`, `α`) is in the
regime `SegReg`. With `segReg_aseq` this gives the round-six elimination bounds
(`r6_aseq`).
-/

open Complex Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.P47 IntMul.Kappa.R6

/-- **Every axis of the round-six machine is in the regime of the segmented inverse.** -/
theorem r6_segReg (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ j < dP6 P n,
      SegReg (segPF (pP6 P n) (dP6 P n) (src j)) (pP6 P n / 7) (src j) (tF6 P n j)
        (lamP (dP6 P n)) (wF (dP6 P n)) (αN6 P n) := by
  obtain ⟨n₁, h⟩ := r6_axis_nat P hP
  obtain ⟨n₂, h'⟩ := r6_axis_fit P hP
  obtain ⟨n₃, h''⟩ := r6_axis_hyps P hP
  refine ⟨max n₁ (max n₂ n₃), fun n hn src hsrc j hj => ?_⟩
  have hn1 : n₁ ≤ n := by omega
  have hn2 : n₂ ≤ n := by omega
  have hn3 : n₃ ≤ n := by omega
  obtain ⟨hs0, hst, hα2, hkey, -, hαd, hαp, hpα, hb', hd1⟩ := h n hn1 src hsrc j hj
  obtain ⟨hθ, h6d, h48d, hd2⟩ := h' n hn2 src hsrc j hj
  obtain ⟨-, -, -, hx⟩ := h'' n hn3 src hsrc j hj
  have h48 : 48 ≤ αN6 P n ^ 2 := by
    have : 48 * 1 ≤ 48 * dP6 P n ^ 2 := Nat.mul_le_mul_left _ (Nat.one_le_pow _ _ hd1)
    omega
  have hp : 100 ≤ pP6 P n := by
    have e : pP6 P n = 6 * b'P6 P n := rfl
    omega
  haveI : NeZero (src j) := ⟨by omega⟩
  haveI : NeZero (tF6 P n j) := ⟨by omega⟩
  have hcop := tF6_coprime P n j (src j) (hsrc.odd j hj)
  have hl1 := lamP_pos (dP6 P n)
  have hlF := lamP_le (dP6 P n) hd1
  have hDle := fit_ddle (pP6 P n) (dP6 P n) (src j) (tF6 P n j) (αN6 P n) (lamP (dP6 P n)) hst
    hcop hα2 hαp hkey hd2 h6d h48 hpα hθ h48d hp hl1 hlF
  obtain ⟨hPE, -, -⟩ := fit_PE (pP6 P n) (dP6 P n) (src j) (tF6 P n j) (αN6 P n)
    (lamP (dP6 P n)) hst hcop hα2 hαp hkey hd2 h6d h48 hpα hθ h48d hp hl1 hlF hDle
  obtain ⟨hk1, hk2⟩ := kF_sq (dP6 P n) (by omega)
  have hws : wF (dP6 P n) ≤ src j := by
    unfold wF
    have : kF (dP6 P n) ≤ dP6 P n + 1 := by nlinarith
    nlinarith
  exact ⟨hs0, hst.le, hα2, hx, hl1, hws, hDle, hPE⟩

/-- **The round-six elimination bounds** (`segReg_aseq` on every axis). -/
theorem r6_aseq (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ j < dP6 P n,
      let Q := segPF (pP6 P n) (dP6 P n) (src j)
      let L := LJ (src j) (tF6 P n j) (lamP (dP6 P n)) (wF (dP6 P n))
      let A := capI Q (TT Q (pP6 P n / 7) (src j) (tF6 P n j) (αN6 P n))
        (BB (src j) (tF6 P n j) (lamP (dP6 P n)) (wF (dP6 P n)))
      let S := bandS (lamP (dP6 P n) + wF (dP6 P n)) (src j - lamP (dP6 P n) - wF (dP6 P n))
      (∀ r ≤ L.length, ∀ i ∈ L.drop r, ∀ k ∈ L.drop r, |Aseq Q S L A r i k| ≤ 2 ^ (Q + 1)) ∧
      (∀ r < L.length, 2 ^ (Q - 1) ≤ Aseq Q S L A r (L.getD r 0) (L.getD r 0)) ∧
      (∀ i ∈ L, ∀ k ∈ L, |A i k| ≤ 2 ^ (Q + 1)) := by
  obtain ⟨n₁, h⟩ := r6_segReg P hP
  exact ⟨n₁, fun n hn src hsrc j hj => segReg_aseq (h n hn src hsrc j hj)⟩

end J6Seg

end

