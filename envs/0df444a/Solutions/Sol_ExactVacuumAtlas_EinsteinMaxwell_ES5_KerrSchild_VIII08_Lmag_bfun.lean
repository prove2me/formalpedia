        + ((Y R * sfun j q (1 / R) / R ^ 3) * Y R - Ifun j q R * deriv Y R) / Y R ^ 2) R :=
    ht1.add ht2
  unfold Lmag
  rw [hev.deriv_eq, hsum.deriv]
  -- the `- V b` term, and the cancellation `Mfun · u' = Ifun · Y'/Y²`
  have hW := wronskian_bfun (j := j) (q := q) hq hR
  have hb : bfun j q R = Y R * (bfun j q R / Y R) := bfun_eq_Y_mul hR
  have hPY := P_mul_deriv_Y_Mfun hR
  have hu' : kfun j q (1 / R) / R ^ 2 = deriv (fun t => bfun j q t / Y t) R :=
    (hasDerivAt_bfun_div_Y (j := j) (q := q) hq hR).deriv.symm
  have hPu' : P R * deriv (fun t => bfun j q t / Y t) R = Ifun j q R / Y R ^ 2 := by
    have hYs : Y R ≠ 0 := hY
    field_simp at hW ⊢
    linarith [hW]
  have hkey : Mfun R * (kfun j q (1 / R) / R ^ 2)
      = Ifun j q R * deriv Y R / Y R ^ 2 := by
    rw [hu']
    calc Mfun R * deriv (fun t => bfun j q t / Y t) R
        = (P R * deriv Y R) * deriv (fun t => bfun j q t / Y t) R := by rw [hPY]
      _ = deriv Y R * (P R * deriv (fun t => bfun j q t / Y t) R) := by ring
      _ = deriv Y R * (Ifun j q R / Y R ^ 2) := by rw [hPu']
      _ = Ifun j q R * deriv Y R / Y R ^ 2 := by ring
  rw [hkey]
  have hb2 : Vfun R * bfun j q R = Vfun R * Y R * (bfun j q R / Y R) := by
    conv_lhs => rw [hb]
    ring
  rw [hb2]
  field_simp
  ring
