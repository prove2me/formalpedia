/-! ## The two actual principal null directions (paper dictionary) -/

/-- Actual coordinate principal vector `𝒦_λ = esFrame · K_λ` of the paper dictionary. -/
noncomputable def principalCoord (f m N w p a : ℝ → ℝ) (lam : ℝ) (x : Pt 5) : Fin 5 → ℝ :=
  esFrame w x *ᵥ
    principalFrame (f (x 1)) (Hfun m N (x 1)) (eFun w p a (x 1)) (deriv a (x 1)) lam

/-- `k₊ = 𝒦_{+√alphaSq}`. -/
noncomputable def kPlus (f m N w p a : ℝ → ℝ) (x : Pt 5) : Fin 5 → ℝ :=
  principalCoord f m N w p a (Real.sqrt (alphaSq f m N w p a (x 1))) x

/-- `k₋ = 𝒦_{-√alphaSq}`. -/
noncomputable def kMinus (f m N w p a : ℝ → ℝ) (x : Pt 5) : Fin 5 → ℝ :=
  principalCoord f m N w p a (-Real.sqrt (alphaSq f m N w p a (x 1))) x

