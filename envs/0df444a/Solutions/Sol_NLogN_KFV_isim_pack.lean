theorem πr_K : πr c KG b r BJ D2 kK = some KG := by simp +decide [πR, pmOf]
theorem πr_B : πr c KG b r BJ D2 kB = some ((2 : ℤ) ^ b) := by simp +decide [πR, pmOf]

