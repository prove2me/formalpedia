    exact 𝔐.zero_mem
  have key : ∀ x : ↥(pullback (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))), ((pullback.fst (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))).base x) = ι.base ((Spec.map (CommRingCat.ofHom
