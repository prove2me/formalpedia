open IsLocalRing

theorem W1PD_isArtinianRing_quotient_pow (R : Type) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    (n : ℕ) : IsArtinianRing (R ⧸ IsLocalRing.maximalIdeal R ^ (n + 1)) := by
  have hI : IsLocalRing.maximalIdeal R ^ (n + 1) ≠ ⊤ :=
    ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal R).ne_top (Ideal.pow_le_self (Nat.succ_ne_zero n))
  haveI : Nontrivial (R ⧸ IsLocalRing.maximalIdeal R ^ (n + 1)) := Ideal.Quotient.nontrivial_iff.mpr hI
  haveI : IsLocalRing (R ⧸ IsLocalRing.maximalIdeal R ^ (n + 1)) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  haveI := IsLocalHom.of_surjective (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (n + 1))) Ideal.Quotient.mk_surjective
  rw [isArtinianRing_iff_isNilpotent_maximalIdeal]
  have hmap : (IsLocalRing.maximalIdeal R).map (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (n + 1))) =
      IsLocalRing.maximalIdeal (R ⧸ IsLocalRing.maximalIdeal R ^ (n + 1)) := by
    ext x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    simp [sup_eq_left.mpr (IsLocalRing.le_maximalIdeal hI)]
  refine ⟨n + 1, ?_⟩
  rw [← hmap, ← Ideal.map_pow, Ideal.zero_eq_bot, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]

theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (N : ℕ) (p : ℕ) [Fact p.Prime] (hpq : p ≠ q) (hpq' : p ≠ q') (hpN : ¬ p ∣ N)
    (R : Type) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [IsAdicComplete (maximalIdeal R) R]
    [IsAlgClosed (ResidueField R)] [CharP (ResidueField R) p] (h2 : IsUnit (2 : R))
    (π : ∀ n : ℕ, (R ⧸ maximalIdeal R ^ (n + 1 + 1)) →+* (R ⧸ maximalIdeal R ^ (n + 1)))
    (hπ : ∀ n, (π n).comp (Ideal.Quotient.mk (maximalIdeal R ^ (n + 1 + 1))) = Ideal.Quotient.mk (maximalIdeal R ^ (n + 1)))
    (E : ∀ n : ℕ, FakeEllipticCurve Λ N (R ⧸ maximalIdeal R ^ (n + 1)))
    (t : ∀ n : ℕ, (E n).A ⟶ (E (n + 1)).A)
    (ht : ∀ n, FakeEllipticCurve.IsPullbackVia (π n) (E (n + 1)) (E n) (t n))

    (hversal : ∀ (B : Type) [CommRing B] [IsLocalRing B] [IsArtinianRing B]
      (ρ : B →+* (R ⧸ maximalIdeal R ^ (0 + 1))) (hρ : Function.Surjective ρ) (hρker : RingHom.ker ρ = maximalIdeal B)
      (E' : FakeEllipticCurve Λ N B) (g' : (E 0).A ⟶ E'.A) (hg' : FakeEllipticCurve.IsPullbackVia ρ E' (E 0) g'),
      ∃ (n : ℕ) (φ : (R ⧸ maximalIdeal R ^ (n + 1)) →+* B) (h : E'.A ⟶ (E n).A),
        FakeEllipticCurve.IsPullbackVia φ (E n) E' h) :
    ∃ (𝓛 : ∀ n : ℕ, (E n).A.Modules),
      (∀ n, Scheme.Modules.IsInvertible (𝓛 n)) ∧
      (∀ n, Nonempty ((Scheme.Modules.pullback (t n)).obj (𝓛 (n + 1)) ≅ 𝓛 n)) ∧
      Scheme.Modules.FiniteBySections ((𝓛 0) ⊗ (𝓛 0) ⊗ (𝓛 0)) (E 0).f := by
  classical

  have hne : ∀ k : ℕ, maximalIdeal R ^ (k + 1) ≠ ⊤ := fun k =>
    ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal R).ne_top (Ideal.pow_le_self (Nat.succ_ne_zero k))
  have inst_nt : ∀ k : ℕ, Nontrivial (R ⧸ maximalIdeal R ^ (k + 1)) := fun k => Ideal.Quotient.nontrivial_iff.mpr (hne k)
  have inst_loc : ∀ k : ℕ, IsLocalRing (R ⧸ maximalIdeal R ^ (k + 1)) := fun k =>
    haveI := inst_nt k; IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have inst_art : ∀ k : ℕ, IsArtinianRing (R ⧸ maximalIdeal R ^ (k + 1)) := fun k => W1PD_isArtinianRing_quotient_pow R k
  have hmapmax : ∀ k : ℕ, (maximalIdeal R).map (Ideal.Quotient.mk (maximalIdeal R ^ (k + 1))) =
      @IsLocalRing.maximalIdeal (R ⧸ maximalIdeal R ^ (k + 1)) _ (inst_loc k) := by
    intro k
    letI := inst_nt k; letI := inst_loc k
    haveI := IsLocalHom.of_surjective (Ideal.Quotient.mk (maximalIdeal R ^ (k + 1))) Ideal.Quotient.mk_surjective
    ext x
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    simp [sup_eq_left.mpr (IsLocalRing.le_maximalIdeal (hne k))]
  have hnil : ∀ k : ℕ, (@IsLocalRing.maximalIdeal (R ⧸ maximalIdeal R ^ (k + 1)) _ (inst_loc k)) ^ (k + 1) = ⊥ := by
    intro k
    rw [← hmapmax k, ← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
  have inst_ac : ∀ k : ℕ, @IsAlgClosed (@IsLocalRing.ResidueField (R ⧸ maximalIdeal R ^ (k + 1)) _ (inst_loc k)) _ := by
    intro k
    letI := inst_nt k; letI := inst_loc k
    haveI : IsLocalHom (Ideal.Quotient.mk (maximalIdeal R ^ (k + 1))) := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    have hs : Function.Surjective (IsLocalRing.ResidueField.map (Ideal.Quotient.mk (maximalIdeal R ^ (k + 1)))) := by
      intro y
      obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
      exact ⟨IsLocalRing.residue R r, by simp [IsLocalRing.ResidueField.map_residue]⟩
    exact IsAlgClosed.of_ringEquiv _ _ (RingEquiv.ofBijective _
      ⟨(IsLocalRing.ResidueField.map (Ideal.Quotient.mk (maximalIdeal R ^ (k + 1)))).injective, hs⟩)

  have hpmem : ((p : ℕ) : R) ∈ maximalIdeal R := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]; exact CharP.cast_eq_zero _ p
  have hpB : ∀ k : ℕ, IsNilpotent ((p : ℕ) : (R ⧸ maximalIdeal R ^ (k + 1))) := by
    intro k
