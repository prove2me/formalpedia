theorem solution
    (p : ℕ) [Fact p.Prime] (h : Subsingleton (JZero p))
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : ¬ ℓ ∣ p)
    (A' : ValuationSubring (AlgebraicClosure ℚ)) (hA' : A'.LiesOverPrime ℓ) :
    Subsingleton (JZeroC (IsLocalRing.ResidueField ↥A') p) := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩

  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥A') :=
    ValuationSubring.isAlgClosed_residueField_algebraicClosure_rat A'
  haveI : CharP (IsLocalRing.ResidueField ↥A') ℓ :=
    ValuationSubring.charP_residueField_of_liesOverPrime ℓ A' hA'
  haveI : IsCurveOver (IsLocalRing.ResidueField ↥A') (modularFunctionFieldFullC (IsLocalRing.ResidueField ↥A') p) :=
    ModularCurve.isCurveOver_modularFunctionFieldFullC _ p
  haveI : Algebra.EssFiniteType (IsLocalRing.ResidueField ↥A')
      ↥(modularFunctionFieldFullC (IsLocalRing.ResidueField ↥A') p) :=
    ModularCurve.essFiniteType_modularFunctionFieldFullC _ p

  have hg : genusFF (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar p) = 0 := by
    have hle := ModularCurve.JZero.pow_two_mul_genusFF_le_card_torsion p 2 two_ne_zero
    haveI : Unique {y : JZero p // 2 • y = 0} :=
      { default := ⟨0, smul_zero 2⟩, uniq := fun a => Subsingleton.elim _ _ }
    rw [Nat.card_unique] at hle
    by_contra hne
    have h2 : 2 * genusFF (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar p) ≠ 0 := by omega
    exact absurd (Nat.one_lt_two_pow h2) (not_lt.mpr hle)

  have hp0 : ((p : ℕ) : IsLocalRing.ResidueField ↥A') ≠ 0 := by
    rw [Ne, CharP.cast_eq_zero_iff (IsLocalRing.ResidueField ↥A') ℓ p]
