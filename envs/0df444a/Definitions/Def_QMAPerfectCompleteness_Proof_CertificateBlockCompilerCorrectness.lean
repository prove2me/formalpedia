/-! Exact coherent master-layout block circuit, with literal dynamic comparisons. -/
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
open Matrix
open scoped Kronecker
namespace QMAPerfectCompleteness.Main.CertificateBlockCorrectness
open CertificateMasterLayout BlockCompiler BlockImplements
variable (V : Verifier gatesG2)

noncomputable def selectGates : List (Instr gatesG2 (total V)) :=
  CertificateRangeCircuit.gates V ++ CertificateVerifierCoordinates.forward V (work V) ++
    (CertificateOldPrograms.midProgram V).gates ++ CertificateVerifierCoordinates.backward V (work V) ++
    postGates V ++ (CertificateRangeCircuit.gates V).reverse



/-- The exact coherent paper circuit: H, dynamic SELECT, H. It never enumerates certificates. -/
noncomputable def gates : List (Instr gatesG2 (total V)) :=
  CertificateHadamardCoordinates.gates V (work V) ++ selectGates V ++
    CertificateHadamardCoordinates.gates V (work V)



end QMAPerfectCompleteness.Main.CertificateBlockCorrectness


