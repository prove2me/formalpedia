-- title:
--   Convex risk measures on bounded payoffs and risk measures generated by a penalty (Definitions 2.1–2.3)
-- statement:
--   Let $(\Omega,\mathcal F)$ be a measurable space, $\mathcal P$ the set of probability measures on it, and $\mathcal Y$ the linear space of bounded measurable functions $Y:\Omega\to\mathbb R$ ("positions", read as payoffs: larger is better). For $Y_1, Y_2 \in \mathcal Y$, $Y_1 \ge Y_2$ means $Y_1(\omega) \ge Y_2(\omega)$ for every $\omega$.
--
--   1. A function $\rho:\mathcal Y\to\mathbb R$ is a **risk measure** if, for all $Y_1, Y_2 \in \mathcal Y$: $Y_1 \ge Y_2$ implies $\rho(Y_1) \le \rho(Y_2)$; and $\rho(Y_1 + c) = \rho(Y_1) - c$ for every $c \in \mathbb R$.
--   2. A risk measure is **convex** if, for all $Y_1, Y_2 \in \mathcal Y$ and $\lambda \in [0,1]$,
--   $$
--   \rho(\lambda Y_1 + (1-\lambda) Y_2) \le \lambda \rho(Y_1) + (1-\lambda)\rho(Y_2).
--   $$
--   3. A **penalty** is a function $\alpha:\mathcal P\to[0,\infty]$. It is **convex** if $\alpha(t\mathbb Q_1 + (1-t)\mathbb Q_2) \le t\,\alpha(\mathbb Q_1) + (1-t)\,\alpha(\mathbb Q_2)$ for all $\mathbb Q_1, \mathbb Q_2 \in \mathcal P$ and $t \in [0,1]$ (with $0\cdot\infty = 0$), and **normalized** if $\alpha(\mathbb Q) = 0$ for some $\mathbb Q \in \mathcal P$ (nonnegativity is built into the codomain).
--   4. $\rho$ is **generated by** the penalty $\alpha$ if $\alpha$ is convex and, for every $Y \in \mathcal Y$,
--   $$
--   \rho(Y) = \sup_{\mathbb Q \in \mathcal P} \big\{ -\mathbb E_{\mathbb Q}[Y] - \alpha(\mathbb Q) \big\},
--   $$
--   the supremum being a least upper bound. Measures with $\alpha(\mathbb Q) = \infty$ contribute $-\infty$ and are left out of the supremum.
--   5. $\rho_\alpha(Y)$ denotes the supremum on the right-hand side, computed as a real supremum over the measures with $\alpha(\mathbb Q) < \infty$.
--
--   These are the objects of §2.2 of the paper. Theorem 2.1 identifies soft robust feasibility with a constraint built from a normalized convex risk measure in exactly this sense.
--
--   **Formalization Note** Risk measures are functions `(Ω → ℝ) → ℝ`, but every property quantifies only over bounded measurable `Y`, so values outside $\mathcal Y$ are irrelevant. $\mathbb E_{\mathbb Q}[Y]$ is the Bochner integral; it is meaningful because $Y$ is bounded and measurable. $\rho_\alpha$ is `sSup` of a set of reals; it is the true supremum when the set is nonempty and bounded above (for instance for $Y \in \mathcal Y$ and normalized $\alpha$), and the predicate "generated by" states the least-upper-bound property explicitly. The paper writes $\alpha:\mathcal P\to\mathbb R$; the penalties it uses ($\alpha^Q$) take the value $+\infty$, so the codomain is $[0,\infty]$.
-- source:
--   Ben-Tal, Bertsimas, Brown, A Soft Robust Model for Optimization Under Ambiguity, Oper. Res. 58(4) (2010), p. 1223, §2.2, Definitions 2.1, 2.2, 2.3 and the representation ρ(Y) = sup_{ℚ∈𝒫}{−𝔼_ℚ[Y] − α(ℚ)}

import Mathlib
import Definitions.Def_SoftRobust_Duality_Mixture

open MeasureTheory
open scoped NNReal ENNReal

namespace SoftRobust.Duality

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The space `𝒴` of positions of Ben-Tal, Bertsimas, Brown (2010), §2.2, p. 1223: payoffs
`Y : Ω → ℝ` that are bounded and measurable (random variables). -/
def IsBddPayoff (Y : Ω → ℝ) : Prop :=
  Measurable Y ∧ ∃ C : ℝ, ∀ ω, |Y ω| ≤ C

/-- Definition 2.1 (p. 1223), payoff convention. `ρ` is a *risk measure* on `𝒴` if for all
`Y₁, Y₂ ∈ 𝒴`: (1) `Y₁ ≥ Y₂` pointwise implies `ρ(Y₁) ≤ ρ(Y₂)`; (2) `ρ(Y₁ + c) = ρ(Y₁) − c` for
every `c ∈ ℝ`. Only the values of `ρ` on `𝒴` matter. -/
def IsRiskMeasure (ρ : (Ω → ℝ) → ℝ) : Prop :=
  (∀ Y₁ Y₂ : Ω → ℝ, IsBddPayoff Y₁ → IsBddPayoff Y₂ → (∀ ω, Y₂ ω ≤ Y₁ ω) → ρ Y₁ ≤ ρ Y₂) ∧
  (∀ (Y : Ω → ℝ) (c : ℝ), IsBddPayoff Y → ρ (fun ω => Y ω + c) = ρ Y - c)

/-- Definition 2.2 (p. 1223). A risk measure `ρ` is *convex* if
`ρ(λY₁ + (1 − λ)Y₂) ≤ λρ(Y₁) + (1 − λ)ρ(Y₂)` for all `Y₁, Y₂ ∈ 𝒴` and `λ ∈ [0, 1]`. -/
def IsConvexRiskMeasure (ρ : (Ω → ℝ) → ℝ) : Prop :=
  IsRiskMeasure ρ ∧
  ∀ Y₁ Y₂ : Ω → ℝ, IsBddPayoff Y₁ → IsBddPayoff Y₂ → ∀ l : ℝ, 0 ≤ l → l ≤ 1 →
    ρ (fun ω => l * Y₁ ω + (1 - l) * Y₂ ω) ≤ l * ρ Y₁ + (1 - l) * ρ Y₂

/-- A penalty `α : 𝒫 → [0, ∞]` on probability measures is *convex* (p. 1223, "α is a convex
function") in the sense of mixtures: `α(tℚ₁ + (1 − t)ℚ₂) ≤ t α(ℚ₁) + (1 − t) α(ℚ₂)` for `t ∈ [0, 1]`,
with the convention `0 · ∞ = 0`. -/
def IsConvexPenalty (α : ProbabilityMeasure Ω → ℝ≥0∞) : Prop :=
  ∀ (t : ℝ≥0) (ht : t ≤ 1) (Q₁ Q₂ : ProbabilityMeasure Ω),
    α (mix t ht Q₁ Q₂) ≤ (t : ℝ≥0∞) * α Q₁ + ((1 - t : ℝ≥0) : ℝ≥0∞) * α Q₂

/-- Definition 2.3 (p. 1223): the penalty `α` is *normalized* — nonnegative (automatic for
`[0, ∞]`-valued `α`) and `α(ℚ) = 0` for some `ℚ ∈ 𝒫`. -/
def IsNormalizedPenalty (α : ProbabilityMeasure Ω → ℝ≥0∞) : Prop :=
  ∃ Q : ProbabilityMeasure Ω, α Q = 0

/-- The values `−E_ℚ[Y] − α(ℚ)` over the probability measures `ℚ` with `α(ℚ) < ∞`; the measures with
`α(ℚ) = ∞` contribute `−∞` to the supremum of p. 1223 and are omitted. -/
def penaltyValues (α : ProbabilityMeasure Ω → ℝ≥0∞) (Y : Ω → ℝ) : Set ℝ :=
  {r | ∃ Q : ProbabilityMeasure Ω, α Q ≠ ⊤ ∧
    r = -(∫ ω, Y ω ∂(Q : Measure Ω)) - (α Q).toReal}

/-- `ρ` is *generated by* the penalty `α` (p. 1223): `α` is convex and, for every `Y ∈ 𝒴`,
`ρ(Y) = sup_{ℚ ∈ 𝒫} {−E_ℚ[Y] − α(ℚ)}`, the supremum being a genuine least upper bound. -/
def IsGeneratedBy (ρ : (Ω → ℝ) → ℝ) (α : ProbabilityMeasure Ω → ℝ≥0∞) : Prop :=
  IsConvexPenalty α ∧ ∀ Y : Ω → ℝ, IsBddPayoff Y → IsLUB (penaltyValues α Y) (ρ Y)

/-- The functional `ρ_α(Y) = sup_{ℚ ∈ 𝒫} {−E_ℚ[Y] − α(ℚ)}` built from a penalty `α` (p. 1223).
For `Y ∈ 𝒴` and a normalized `α` the set of values is nonempty and bounded above, so this is the
true supremum. -/
noncomputable def riskOfPenalty (α : ProbabilityMeasure Ω → ℝ≥0∞) (Y : Ω → ℝ) : ℝ :=
  sSup (penaltyValues α Y)

end SoftRobust.Duality


