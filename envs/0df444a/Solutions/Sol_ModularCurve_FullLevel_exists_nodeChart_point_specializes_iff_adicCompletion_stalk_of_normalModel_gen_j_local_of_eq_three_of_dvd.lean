theorem valuationSubring_eq (hfrac : ∀ f : F, ∃ a b : ↥O, b ≠ 0 ∧ f * (b : F) = (a : F))
    (V₁ V₂ : ValuationSubring F) (h₁ : O ≤ V₁.toSubring) (h₂ : O ≤ V₂.toSubring)
    (c₁ c₂ : ↥O)
    (hc₁₁ : (c₁ : F) ∈ V₁.nonunits) (hc₁₂ : (c₁ : F) ∉ V₂.nonunits)
    (hc₂₂ : (c₂ : F) ∈ V₂.nonunits) (hc₂₁ : (c₂ : F) ∉ V₁.nonunits)
    (ht₁ : (t : F) ∈ V₁.nonunits) (ht₂ : (t : F) ∈ V₂.nonunits)
    (V : ValuationSubring F) (hV : O ≤ V.toSubring) (htV : (t : F) ∈ V.nonunits)

    (d₁ : ↥O) (hd₁ : (d₁ : F) ∈ V.nonunits) (hd₁₂ : (d₁ : F) ∉ V₂.nonunits)
    (d₂ : ↥O) (hd₂m : d₂ ∈ maximalIdeal ↥O) (hd₂ : (d₂ : F) ∉ V.nonunits) : V = V₁ := by
  have hm : ∀ (V' : ValuationSubring F) (hV' : O ≤ V'.toSubring) (c : ↥O), (c : F) ∉ V'.nonunits →
      (c : F) ∈ V₁.nonunits ∨ (c : F) ∈ V₂.nonunits → ((maximalIdeal ↥V').comap (Subring.inclusion hV')) ≠ maximalIdeal ↥O := by
    intro V' hV' c hc hc' heq
    have hcm : c ∈ maximalIdeal ↥O := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; intro hu
      rcases hc' with h | h
      · have := hu.map (Subring.inclusion h₁)
        exact (IsLocalRing.mem_maximalIdeal _).mp ((ValuationSubring.coe_mem_nonunits_iff (a := Subring.inclusion h₁ c)).mp h) this
      · have := hu.map (Subring.inclusion h₂)
        exact (IsLocalRing.mem_maximalIdeal _).mp ((ValuationSubring.coe_mem_nonunits_iff (a := Subring.inclusion h₂ c)).mp h) this
    rw [← heq, mem_centre_iff] at hcm
    exact hc hcm
  have hne : ((maximalIdeal ↥V₁).comap (Subring.inclusion h₁)) ≠ ((maximalIdeal ↥V₂).comap (Subring.inclusion h₂)) := by
    intro heq
    have := (mem_centre_iff O V₁ h₁ c₁).mpr hc₁₁
    rw [heq, mem_centre_iff] at this
    exact hc₁₂ this
  have hm₁ := hm V₁ h₁ c₂ hc₂₁ (Or.inr hc₂₂)
  have hm₂ := hm V₂ h₂ c₁ hc₁₂ (Or.inl hc₁₁)
  have hmV : ((maximalIdeal ↥V).comap (Subring.inclusion hV)) ≠ maximalIdeal ↥O := by
    intro heq
    have := hd₂m; rw [← heq, mem_centre_iff] at this
    exact hd₂ this
  have htc₁ : t ∈ ((maximalIdeal ↥V₁).comap (Subring.inclusion h₁)) := (mem_centre_iff O V₁ h₁ t).mpr ht₁
  have htc₂ : t ∈ ((maximalIdeal ↥V₂).comap (Subring.inclusion h₂)) := (mem_centre_iff O V₂ h₂ t).mpr ht₂
  have htcV : t ∈ ((maximalIdeal ↥V).comap (Subring.inclusion hV)) := (mem_centre_iff O V hV t).mpr htV
  rcases prime_eq_or_eq π hπ E hE O ι t ht (((maximalIdeal ↥V₁).comap (Subring.inclusion h₁))) (((maximalIdeal ↥V₂).comap (Subring.inclusion h₂))) hne htc₁ htc₂ hm₁ hm₂
      (((maximalIdeal ↥V).comap (Subring.inclusion hV))) htcV hmV with heq | heq
  ·
    apply le_antisymm
    · intro f hf
      obtain ⟨a, b, hb, e⟩ := (mem_iff_of_centre π hπ E hE O ι t ht hfrac V hV htcV hmV f).mp hf
      rw [heq] at hb
      exact (mem_iff_of_centre π hπ E hE O ι t ht hfrac V₁ h₁ htc₁ hm₁ f).mpr ⟨a, b, hb, e⟩
    · intro f hf
      obtain ⟨a, b, hb, e⟩ := (mem_iff_of_centre π hπ E hE O ι t ht hfrac V₁ h₁ htc₁ hm₁ f).mp hf
      rw [← heq] at hb
      exact (mem_iff_of_centre π hπ E hE O ι t ht hfrac V hV htcV hmV f).mpr ⟨a, b, hb, e⟩
  ·
    exfalso
    have := (mem_centre_iff O V hV d₁).mpr hd₁
    rw [heq, mem_centre_iff] at this
    exact hd₁₂ this

