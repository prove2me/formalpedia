    rw [Nat.eq_of_beq_eq_true h1, Nat.eq_of_beq_eq_true h2, Nat.eq_of_beq_eq_true h3]
    exact hr
  | cons st l ih =>
    obtain ⟨de, G⟩ := st
    intro m c e h
    simp only [seg, Bool.and_eq_true] at h
    obtain ⟨⟨⟨⟨hm, hs⟩, hg⟩, hb⟩, hw⟩ := h
    simp only [List.cons_append, walk, Bool.and_eq_true]
    exact ⟨⟨⟨⟨hm, hs⟩, hg⟩, hb⟩, ih _ _ _ hw⟩

