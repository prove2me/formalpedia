omit [Fintype d] in
lemma integerCongruenceEquiv_zero (N : ℕ) [NeZero N] :
    (integerCongruenceEquiv N (0 : d → ℤ)).1 = 0 := by
  funext i
  simp [integerCongruenceEquiv, Int.divModEquiv, Int.natMod]

