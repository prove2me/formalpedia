section
-- Source module: Solutions.J6SegBand
/-!
# Segmented inverse (S2): sparse (banded + border) elimination

`geSolveS P S L A b` is the elimination of `geSolve` restricted to a pattern `S`: the Schur
update of `(i, k)` is performed only when `S i j ∧ S j k`, the right-hand side update only when
`S i j`, and the back substitution sums only over `S j k`.

`geSolveS_eq`: if `A` vanishes off `S` on `L × L`, `S` is closed under elimination in the order of
`L` (`PatOK`: `S i j → S j k → S i k` for `i, k` after the pivot `j`), and the hypotheses of
`geSolve_resid` hold (row deviation `η`, `η + |L|²/2^P ≤ 1/2`, so every pivot is positive), then
`geSolveS = geSolve`. Hence the error theorems of `geSolve` hold verbatim for the sparse version.

`bandS m c a b`: `|a - b| ≤ m` or `a ≥ c` or `b ≥ c` (band plus a border at the end, the
cyclic block-tridiagonal shape); `PatOK` holds for it along any increasing list (`bandS_patOK`).
-/

open Finset

namespace J6Seg

section band
variable (P : ℕ)

theorem bandS_patOK (m c : ℕ) : ∀ L : List ℕ, L.Pairwise (· < ·) → PatOK (bandS m c) L := by
  intro L
  induction L with
  | nil => intro _; trivial
  | cons j L ih =>
    intro hL
    rw [List.pairwise_cons] at hL
    refine ⟨fun i hi k hk h1 h2 => ?_, ih hL.2⟩
    have hi' := hL.1 i hi
    have hk' := hL.1 k hk
    unfold bandS at h1 h2 ⊢
    omega

end band

end J6Seg

end

section
-- Source module: Solutions.J6SegSparse
/-!
# Segmented inverse (S2): the sparse algorithm

`segInvS P lam T B U` is `segInv` with the capacitance solved by `geSolveS` on the pattern
`bandS (λ + w) (s - λ - w)`: a band of half-width `λ + w` (blocks of length `≤ λ`, coupling width
`w`) plus the border of positions `≥ s - λ - w` (the cyclic wrap). Per row of the capacitance
at most `2(λ+w)+1` band entries plus the border are touched.

* `capI_band`: the capacitance vanishes off the pattern;
* `segInvS_eq`: under the hypotheses of `segInv_err`, `segInvS = segInv`;
* `segInvFullS_err`: the fully instantiated sparse algorithm satisfies the bound of
  `segInvFull_err`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section sp
variable {P s t α lam : ℕ} {B : Blocks} {T : Tables}

lemma Jlist_pairwise (B : Blocks) : (Jlist B).Pairwise (· < ·) :=
  (List.pairwise_lt_range).filter _

/-- The capacitance vanishes off the band-plus-border pattern. -/
theorem capI_band (hB : BlocksOK s t B) (hs : 0 < s) (hlam : ∀ i < s, B.len i ≤ lam)
    {a b : ℕ} (ha : a < s) (hnb : ¬ bandS (lam + B.w) (B.s - lam - B.w) a b) :
    capI P T B a b = 0 := by
  have hbs := hB.hs
  have hw := hB.hw
  obtain ⟨c1, c2, c3⟩ := hB.cover a ha
  have hla := hlam a ha
  unfold bandS at hnb
  rw [hbs] at hnb
  unfold capI
  have hab : a ≠ b := by intro h; subst h; exact hnb (Or.inl ⟨by omega, by omega⟩)
  rw [if_neg hab, zero_add]
  refine sum_eq_zero fun i hi => sum_eq_zero fun h hh => ?_
  rw [mem_Ico] at hi
  obtain ⟨hw1, hw2, _, _⟩ := mem_Hset hh
  rw [if_neg]
  intro hcol
  unfold col at hcol
  rw [hbs] at hcol
  have hcase := emod_cases hs (a := (i : ℤ) + h) (by omega) (by omega)
  have hjv : (((((i : ℤ) + h) % s).toNat : ℕ) : ℤ) = ((i : ℤ) + h) % s :=
    Int.toNat_of_nonneg (Int.emod_nonneg _ (by exact_mod_cast hs.ne'))
  rw [hcol] at hjv
  omega

end sp

end J6Seg

end

section
-- Source module: Solutions.J6SegLn3
/-!
# Segmented inverse (S2), machine side 3: the sparse elimination in closed form

For the elimination `geSolveS P S L A b` along `L = [l₀, l₁, …]` (no repetitions), with the
matrices `Aseq L A r` and right-hand sides `bseq L A b r` after `r` pivots:

* **`bseq_closed`**: `bseq r i = b i − ∑_{q < r, S i l_q} fmul (F_q i) (bt q)` where
  `F_q i = fdiv (A_q i l_q) (A_q l_q l_q)` and `bt q = bseq q l_q` (forward substitution: every
  pivot step subtracts one rounded term);
* **`geSolveS_closed`**: `z l_r = fdiv (bt r − ∑_{k ∈ tail, S l_r k} fmul (A_r l_r k) (z k)) (A_r l_r l_r)`
  (back substitution with the final values `z`);
* `geSolveS_off`: `z k = 0` off `L`.

Everything data-independent (`A_q`, hence all multipliers and pivots) can be precomputed; the
data enter only through `bt` and `z`.
-/

open Finset

namespace J6Seg

section closed
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S]

lemma geSolveS_cons (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) (k : ℕ) :
    geSolveS P S (j :: L) A b k = if k = j then
      fdiv P (b j - ∑ k' ∈ L.toFinset.filter (fun k' => S j k'),
        fmul P (A j k') (geSolveS P S L (stepA P S j A) (stepB P S j A b) k')) (A j j)
      else geSolveS P S L (stepA P S j A) (stepB P S j A b) k := rfl

/-- `geSolveS` vanishes off `L`. -/
theorem geSolveS_off : ∀ (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) (k : ℕ), k ∉ L →
    geSolveS P S L A b k = 0
  | [], _, _, _, _ => rfl
  | j :: L, A, b, k, hk => by
    rw [geSolveS_cons]
    simp only [List.mem_cons, not_or] at hk
    rw [if_neg hk.1]
    exact geSolveS_off L _ _ k hk.2

lemma Aseq_zero (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) : Aseq P S (j :: L) A 0 = A := rfl
lemma Aseq_succ (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (q : ℕ) :
    Aseq P S (j :: L) A (q + 1) = Aseq P S L (stepA P S j A) q := rfl
lemma bseq_zero (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) : bseq P S (j :: L) A b 0 = b := rfl
lemma bseq_succ (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ) (q : ℕ) :
    bseq P S (j :: L) A b (q + 1) = bseq P S L (stepA P S j A) (stepB P S j A b) q := rfl

/-- **Back substitution in closed form.** -/
theorem geSolveS_closed : ∀ (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ), L.Nodup →
    ∀ r < L.length, geSolveS P S L A b (L.getD r 0) =
      fdiv P (bseq P S L A b r (L.getD r 0) -
        ∑ k' ∈ (L.drop (r + 1)).toFinset.filter (fun k' => S (L.getD r 0) k'),
          fmul P (Aseq P S L A r (L.getD r 0) k') (geSolveS P S L A b k'))
        (Aseq P S L A r (L.getD r 0) (L.getD r 0))
  | [], _, _, _, r, hr => by simp at hr
  | j :: L, A, b, hnd, 0, _ => by
    rw [List.nodup_cons] at hnd
    simp only [List.getD_cons_zero, Aseq_zero, bseq_zero, List.drop_one, List.tail_cons]
    rw [geSolveS_cons, if_pos rfl]
    congr 2
    refine Finset.sum_congr rfl (fun k hk => ?_)
    have hk' : k ∈ L := by simp only [Finset.mem_filter, List.mem_toFinset] at hk; exact hk.1
    rw [geSolveS_cons, if_neg (show k ≠ j from fun e => hnd.1 (e ▸ hk'))]
  | j :: L, A, b, hnd, r + 1, hr => by
    rw [List.nodup_cons] at hnd
    simp only [List.length_cons] at hr
    simp only [List.getD_cons_succ, Aseq_succ, bseq_succ]
    have hmem : L.getD r 0 ∈ L := by
      rw [List.getD_eq_getElem _ _ (by omega)]; exact List.getElem_mem _
    rw [geSolveS_cons, if_neg (show L.getD r 0 ≠ j from fun e => hnd.1 (e ▸ hmem))]
    rw [geSolveS_closed L _ _ hnd.2 r (by omega)]
    congr 2
    have e : (j :: L).drop (r + 1 + 1) = L.drop (r + 1) := by simp
    rw [e]
    refine Finset.sum_congr rfl (fun k hk => ?_)
    have hk' : k ∈ L := by
      simp only [Finset.mem_filter, List.mem_toFinset] at hk; exact List.mem_of_mem_drop hk.1
    rw [geSolveS_cons, if_neg (show k ≠ j from fun e => hnd.1 (e ▸ hk'))]

end closed

end J6Seg

end

section
-- Source module: Solutions.J6SegLn4
/-!
# Segmented inverse (S2), machine side 4: the capacitance solve as list kernels

The per-line work on the near-boundary positions `L = Jlist B = [j₀ < j₁ < …]` is done by two
list kernels driven by precomputed (data-independent) coefficient streams:

* `fwdK fs Y []`: for `r = 0, 1, …`: `bt_r = Y_r − ∑_i fmul (fs_r)_i bt_{r-1-i}` (the accumulator
  holds the previous values, most recent first); the result is `[bt_{m-1}, …, bt_0]`;
* `bwdK bs bt [] []`: for `r = m-1, …, 0` with the record `(cb, cz, pv, fl)`:
  `z_r = fdiv (bt_r − ∑ fmul cb_i z_{r+1+i} − ∑ fmul cz_i ZB_i) pv`, where `ZB` holds the
  `z` of the border indices computed so far (`fl = 1` marks a border index); the result is
  `[z₀, …, z_{m-1}]`.

**`fwdK_eq`**, **`bwdK_eq`**: with the coefficient streams `fsOf`, `bsOf` of the line (built from
`Aseq` of the pattern-restricted elimination of `capI`), `fwdK` computes the forward values
`bseq r j_r` and `bwdK` the solution `geSolveS … j_r`, given the support facts of the pattern
(`FwdSupp`, `BwdSupp`).
-/

open Finset

namespace J6Seg

section bwd
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S] (L : List ℕ) (A : ℕ → ℕ → ℤ) (b : ℕ → ℤ)

variable {P S L A b}

lemma accZ_succ {k : ℕ} (hk : k < L.length) :
    accZ P S L A b k = zW P S L A b k :: accZ P S L A b (k + 1) := by
  unfold accZ
  rw [show L.length - k = (L.length - (k + 1)) + 1 by omega, List.range'_succ]
  simp

lemma accB_succ (fl : ℕ → ℤ) {k : ℕ} (hk : k < L.length) :
    accB P S L A b fl k = if fl k = 1 then zW P S L A b k :: accB P S L A b fl (k + 1)
      else accB P S L A b fl (k + 1) := by
  unfold accB
  rw [show L.length - k = (L.length - (k + 1)) + 1 by omega, List.range'_succ]
  by_cases h : fl k = 1 <;> simp [List.filter_cons, h]

/-- **The backward kernel computes the solution**, given records whose coefficient lists
split the back-substitution sum over the band part (`accZ`) and the border part (`accB`). -/
theorem bwdK_eq (hnd : L.Nodup) (cb cz : ℕ → List ℤ) (pv fl : ℕ → ℤ)
    (hpv : ∀ r < L.length, pv r = Aseq P S L A r (L.getD r 0) (L.getD r 0))
    (hsplit : ∀ r < L.length, bsum P S L A b r =
      dotF P (cb r) (accZ P S L A b (r + 1)) + dotF P (cz r) (accB P S L A b fl (r + 1))) :
    bwdK P ((List.range L.length).reverse.map fun r => (cb r, cz r, pv r, fl r))
      ((List.range L.length).reverse.map (btV P S L A b)) [] [] =
      (List.range L.length).map (zW P S L A b) := by
  have key : ∀ k, k ≤ L.length →
      bwdK P ((List.range k).reverse.map fun r => (cb r, cz r, pv r, fl r))
        ((List.range k).reverse.map (btV P S L A b)) (accZ P S L A b k)
        (accB P S L A b fl k) = accZ P S L A b 0 := by
    intro k
    induction k with
    | zero => intro _; simp [bwdK]
    | succ k ih =>
      intro hk
      rw [List.range_succ, List.reverse_append]
      simp only [List.reverse_singleton, List.singleton_append, List.map_cons, bwdK]
      have e : fdiv P (btV P S L A b k - dotF P (cb k) (accZ P S L A b (k + 1)) -
          dotF P (cz k) (accB P S L A b fl (k + 1))) (pv k) = zW P S L A b k := by
        unfold zW btV
        rw [geSolveS_closed P S L A b hnd k (by omega), hpv k (by omega), sub_sub,
          ← hsplit k (by omega)]
        rfl
      rw [e, ← accZ_succ (by omega)]
      have e2 : (if fl k = 1 then zW P S L A b k :: accB P S L A b fl (k + 1)
          else accB P S L A b fl (k + 1)) = accB P S L A b fl k := (accB_succ fl (by omega)).symm
      rw [e2]
      exact ih (by omega)
  have := key L.length le_rfl
  have h0 : accZ P S L A b L.length = [] := by simp [accZ]
  have h1 : accB P S L A b fl L.length = [] := by simp [accB]
  rw [h0, h1] at this
  rw [this]
  simp [accZ, List.range_eq_range']

end bwd

end J6Seg

end

section
-- Source module: Solutions.J6SegLn7
/-!
# Segmented inverse (S2), machine side 7: the capacitance solve of one line as list kernels

For the pattern `S = bandS (λ+w) c` (`c = s - λ - w`, border `bd = (c ≤ ·)`) on the sorted
line `L = Jlist B`:

* `WbOf r` (backward band window): the number of later line positions within `λ + w` of `L_r`;
* `cfOf r` (forward window): all previous rows on border rows, else the number of previous line
  positions within `λ + w`;
* **`jsolve_eq`**: `bwdK (records) (fwdK (forward streams) [Y_{L_r}]_r [])` is the list of the
  solution `geSolveS … Y` at `L_0, …, L_{m-1}`, for every right-hand side `Y`.

All windows and streams depend only on `s, t, λ, w` and the tables (not on the data).
-/

open Finset

namespace J6Seg

section jsolve
variable (P : ℕ) (L : List ℕ) (mw c : ℕ) (A : ℕ → ℕ → ℤ)

variable {P L mw c A}

lemma getD_lt_getD (hsort : L.Pairwise (· < ·)) {i j : ℕ} (hij : i < j) (hj : j < L.length) :
    L.getD i 0 < L.getD j 0 := by
  rw [List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ hj]
  exact (List.pairwise_iff_getElem.1 hsort) i j (by omega) hj hij

lemma getD_le_getD (hsort : L.Pairwise (· < ·)) {i j : ℕ} (hij : i ≤ j) (hj : j < L.length) :
    L.getD i 0 ≤ L.getD j 0 := by
  rcases Nat.lt_or_ge i j with h | h
  · exact (getD_lt_getD hsort h hj).le
  · rw [show i = j by omega]

theorem fwdSupp_of (hsort : L.Pairwise (· < ·)) {r : ℕ} (hr : r < L.length) :
    FwdSupp (S := bandS mw c) (L := L) r (cfOf L mw c r) := by
  unfold cfOf
  split_ifs with hb
  · exact ⟨le_rfl, fun q hq => absurd hq (by omega)⟩
  · refine ⟨(card_filter_le _ _).trans (by simp), fun q hq hS => ?_⟩
    have hqr : L.getD q 0 < L.getD r 0 := getD_lt_getD hsort (by omega) hr
    have hband : L.getD r 0 ≤ L.getD q 0 + mw := by
      unfold bandS at hS; omega
    -- every row in `[q, r)` is in the window
    have hsub : Ico q r ⊆ (range r).filter (fun q' => L.getD r 0 ≤ L.getD q' 0 + mw) := by
      intro q' hq'
      rw [mem_Ico] at hq'
      rw [mem_filter, mem_range]
      refine ⟨hq'.2, ?_⟩
      have := getD_le_getD hsort hq'.1 (by omega)
      omega
    have := card_le_card hsub
    rw [Nat.card_Ico] at this
    omega

theorem bwin_of (hsort : L.Pairwise (· < ·)) {r : ℕ} (hr : r < L.length) :
    ∀ q, r < q → q < L.length → ¬ (c ≤ L.getD q 0) → bandS mw c (L.getD r 0) (L.getD q 0) →
      q ≤ r + WbOf L mw r := by
  intro q hrq hq hb hS
  have hqr : L.getD r 0 < L.getD q 0 := getD_lt_getD hsort hrq hq
  have hband : L.getD q 0 ≤ L.getD r 0 + mw := by
    unfold bandS at hS; omega
  have hsub : Ioc r q ⊆ (Ioo r L.length).filter (fun q' => L.getD q' 0 ≤ L.getD r 0 + mw) := by
    intro q' hq'
    rw [mem_Ioc] at hq'
    rw [mem_filter, mem_Ioo]
    refine ⟨⟨hq'.1, by omega⟩, ?_⟩
    have := getD_le_getD hsort hq'.2 hq
    omega
  have := card_le_card hsub
  rw [Nat.card_Ioc] at this
  unfold WbOf
  omega

/-- **The capacitance solve of one line by the two list kernels.** -/
theorem jsolve_eq (hsort : L.Pairwise (· < ·)) (Y : ℕ → ℤ) :
    bwdK P (bsOf P L mw c A)
      (fwdK P (fsOf P L mw c A) ((List.range L.length).map fun r => Y (L.getD r 0)) []) [] [] =
      (List.range L.length).map fun r => geSolveS P (bandS mw c) L A Y (L.getD r 0) := by
  have hnd : L.Nodup := hsort.imp (fun h => ne_of_lt h)
  unfold fsOf
  rw [fwdK_eq (P := P) (S := bandS mw c) (L := L) (A := A) (b := Y) (cfOf L mw c)
    (fun r hr => fwdSupp_of hsort hr)]
  rw [show ((List.range L.length).map (btV P (bandS mw c) L A Y)).reverse =
    (List.range L.length).reverse.map (btV P (bandS mw c) L A Y) by simp]
  unfold bsOf
  have := bwdK_eq (P := P) (S := bandS mw c) (L := L) (A := A) (b := Y) hnd
    (fun r => cbOf P (bandS mw c) L A (c ≤ ·) (WbOf L mw r) r)
    (fun r => czOf P (bandS mw c) L A (c ≤ ·) r)
    (fun r => Aseq P (bandS mw c) L A r (L.getD r 0) (L.getD r 0)) (flOf L (c ≤ ·))
    (fun r _ => rfl)
    (fun r hr => hsplit_of Y (WbOf L mw r) hsort r hr (bwin_of hsort hr))
  exact this

end jsolve

end J6Seg

end

section
-- Source module: Solutions.J6SegLn8
/-!
# Segmented inverse (S2), machine side 8: one real line of `segInvS` by list kernels

The real part of the segmented inverse on one line, as the machine computes it, on a padded
line `x` of `N = n_c λ` positions (`s ≤ N`):

1. `Y = applyL x`: the chunk kernel on each `λ`-chunk (`M⁻¹`);
2. the values of `Y` on the line `L = Jlist B`, the two capacitance kernels (`jsolve_eq`);
3. the coupling window kernel on the cyclic extension (`couple_window`), scattered back to the
   positions (zero off `L`);
4. `Y₂ = applyL` of the scattered coupling; the output is `Y - Y₂`.

**`segLineC_eq`**: entry `u < N` of the result is `segInvS … u` for `u < s` and `0` beyond.
-/

open Finset

namespace J6Seg

section segline
variable (P R s t lam w α K : ℕ)

variable {P R s t lam w α K}

lemma LJ_sorted : (LJ s t lam w).Pairwise (· < ·) := Jlist_pairwise _

lemma LJ_lt {x : ℕ} (hx : x ∈ LJ s t lam w) : x < s := by
  unfold LJ Jlist at hx
  rw [List.mem_filter, List.mem_range] at hx
  exact hx.1

end segline

end J6Seg

end

section
-- Source module: Solutions.J6SegJPre1
/-!
# `J` kernel precondition (JPre), part 1: the regime and the capacitance of a line

`SegReg P R s t λ w α` bundles the hypotheses of `segInvFullS_err` (with `Bu = 1/2`, as used by
`B0seg`): `0 < s ≤ t`, `2 ≤ α`, `3 ≤ xθ`, `1 ≤ λ`, `w ≤ s`, `D_{λ-1} ≤ 2^R`,
`1000 · fullG λ w s t α (1/2) ≤ 2^P`.

`segReg_cap`: in this regime the capacitance `capI P (TT P R s t α) (BB s t λ w)` on the line
`LJ s t λ w` has row sums `|C/2^P - I| ≤ η ≤ 1/4`, vanishes off the pattern
`bandS (λ+w) (s-λ-w)`, and `(|LJ|+1)²/2^P ≤ 1/8` (so also `η + |LJ|²/2^P ≤ 1/2`).
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section reg
variable {P R s t lam w α : ℕ}

lemma LJ_nodup (s t lam w : ℕ) : (LJ s t lam w).Nodup := Jlist_nodup _

lemma LJ_length_le_s (s t lam w : ℕ) : (LJ s t lam w).length ≤ s :=
  Jlist_length_le (mkBlocks s t lam w)

/-- **The capacitance of a line in the regime.** -/
theorem segReg_cap (h : SegReg P R s t lam w α) :
    ∃ η : ℝ, 0 ≤ η ∧ η ≤ 1 / 4 ∧ (((LJ s t lam w).length : ℝ) + 1) ^ 2 / 2 ^ P ≤ 1 / 8 ∧
      (∀ i ∈ LJ s t lam w, ∑ k ∈ (LJ s t lam w).toFinset,
        |(capI P (TT P R s t α) (BB s t lam w) i k : ℝ) / 2 ^ P - kd i k| ≤ η) ∧
      (∀ i ∈ LJ s t lam w, ∀ k ∈ LJ s t lam w, ¬ bandS (lam + w) (s - lam - w) i k →
        capI P (TT P R s t α) (BB s t lam w) i k = 0) := by
  obtain ⟨hG1, hG2, hδ, hs8, hP1⟩ := segReg_num h
  have hS := two_pow_pos' P
  have hT := mkTables_ok (P := P) (R := R) h.hs h.hst h.hα hP1 h.hl hG1 h.hR (mkBlocks s t lam w)
    (fun i _ => mkBlocks_len h.hl w i)
  have hB := mkBlocks_ok (s := s) (t := t) (lam := lam) h.hs w h.hw
  have hE : (0 : ℝ) ≤ 3 * lam + 3 := by positivity
  refine ⟨1 / 7 + (lam : ℝ) * (2 * w + 1) * (15 * ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) *
      (((lam : ℝ) + 1) * (3 * lam + 3) + 1) / 2 ^ P), ?_, ?_, ?_, ?_, ?_⟩
  · have := one_le_ddR (α := (α : ℝ)) (sigma_ge h.hs h.hst) (lam - 1)
    positivity
  · linarith
  · have hm : ((LJ s t lam w).length : ℝ) ≤ s := by exact_mod_cast LJ_length_le_s s t lam w
    rw [div_le_iff₀ hS]
    have : (((LJ s t lam w).length : ℝ) + 1) ^ 2 ≤ ((s : ℝ) + 1) ^ 2 :=
      pow_le_pow_left₀ (by positivity) (by linarith) 2
    linarith
  · intro i hi
    exact cap_row hB h.hs h.hst h.hα h.hx hT hE (fun i _ => mkBlocks_len h.hl w i) hG2 (LJ_lt (s := s) (t := t) (lam := lam) (w := w) hi)
  · intro i hi k _ hnb
    exact capI_band hB h.hs (fun i _ => mkBlocks_len h.hl w i) (LJ_lt (s := s) (t := t) (lam := lam) (w := w) hi) hnb

end reg

end J6Seg

end

section
-- Source module: Solutions.J6SegJPre2
/-!
# `J` kernel precondition (JPre), part 2: entries and pivots of the elimination

`ElimOK P S L A η` bundles the hypotheses of `aseq_rows`/`geSolveS_eq` (near-identity rows with
`η + |L|²/2^P ≤ 1/2`, zero pattern, `PatOK`). Under it, on every trailing block `L.drop r`:

* `aseq_dev`: `|A_r(i,k)/2^P - δ_ik| ≤ 1/2`;
* `aseq_abs_le` / `aseq_int_le`: `|A_r(i,k)| ≤ (3/2) 2^P ≤ 2^{P+1}`; `aseq_zsz`: `zsz ≤ P + 1`;
* `aseq_off`: off the diagonal `|A_r(i,k)| ≤ 2^P/2`;
* `aseq_piv` / `aseq_piv_int`: the pivot `A_r(i,i) ≥ 2^P/2` (`≥ 2^{P-1}` in `ℤ`);
* `aseq_offsum`: the off-diagonal part of pivot row `r` sums to `≤ 2^P/2`;
* `fco_abs_le`: the forward multipliers satisfy `|F| ≤ 2^P + 1`.

`segReg_elim`: the capacitance of a line in the regime `SegReg` satisfies `ElimOK` on
`LJ` with the pattern `bandS (λ+w) (s-λ-w)`; `segReg_aseq` collects the bounds there.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

/-! ## The line in the regime -/

section reg
variable {P R s t lam w α : ℕ}

theorem segReg_elim (h : SegReg P R s t lam w α) :
    ∃ η : ℝ, η ≤ 1 / 4 ∧ (((LJ s t lam w).length : ℝ) + 1) ^ 2 / 2 ^ P ≤ 1 / 8 ∧
      ElimOK P (bandS (lam + w) (s - lam - w)) (LJ s t lam w)
        (capI P (TT P R s t α) (BB s t lam w)) η := by
  obtain ⟨η, h0, h4, h8, hrow, hzero⟩ := segReg_cap h
  have hS := two_pow_pos' P
  refine ⟨η, h4, h8, ⟨LJ_nodup s t lam w, h0, ?_, hrow, hzero,
    bandS_patOK _ _ _ (LJ_sorted (s := s) (t := t) (lam := lam) (w := w))⟩⟩
  have : ((LJ s t lam w).length : ℝ) ^ 2 / 2 ^ P ≤
      (((LJ s t lam w).length : ℝ) + 1) ^ 2 / 2 ^ P :=
    div_le_div_of_nonneg_right (by nlinarith [(Nat.cast_nonneg (LJ s t lam w).length : (0 : ℝ) ≤ _)])
      hS.le
  linarith

end reg

end J6Seg

end

section
-- Source module: Solutions.J6SegJPre4
/-!
# `J` kernel precondition (JPre), part 4: the intermediates of the kernel in closed form

For the streams `fsOf`/`bsOf` of a sorted line `L` (pattern `bandS mw c`, border `c ≤ ·`) and an
input `v` (`|L| ≤ |v|`), with the right-hand side `bv L v` (`bv (L_r) = v_r`):

* `fA_eq`: the forward accumulator after `r` rows is `accF r = [bt_{r-1}, …, bt_0]`;
* `bwdS_eq`: the backward state after `j` records is `(accZ (m-j), accB (m-j))` (the solution
  values `z_{m-j}, …, z_{m-1}` and their border part);
* the shapes of the streams (`fsOf_getElem_length`, `bsOf_getElem`, `WbOf_le`,
  `czOf_length`, `flOf_01`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK

lemma bv_at {L : List ℕ} (hnd : L.Nodup) (v : List ℤ) {r : ℕ} (hr : r < L.length) :
    bv L v (L.getD r 0) = v.getD r 0 := by
  unfold bv
  rw [List.getD_eq_getElem _ _ hr, List.Nodup.idxOf_getElem hnd r hr]

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegJPre5
/-!
# `J` kernel precondition (JPre), part 5: value bounds

* `fmul_abs_le`, `dotF_abs_le`: `|fmul x y| ≤ |x||y|/2^P + 1/2`, and the dot product bound;
* `z_bound`: under `ElimOK`, `η ≤ 1/4`, `(|L|+1)²/2^P ≤ 1/8` and `|b| ≤ M`, every value of the
  sparse solve satisfies `|z| ≤ 4M + 2^P` (from `geSolve_bound` and `geSolveS_eq`);
* `bt_bound`: the forward values satisfy `|bt_r| ≤ 2 Z + 3/4 + |L|/2` when `|z| ≤ Z`
  (from the closed back substitution and `fdiv_err`);
* `cpl_abs_le`, `ccOf_abs_le`: the coupling entries are `≤ 2^P + 1`, the window coefficients
  `≤ (2w+1)(2^P+1)`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

lemma fmul_abs_le (P : ℕ) (x y : ℤ) :
    |(fmul P x y : ℝ)| ≤ |(x : ℝ)| * |(y : ℝ)| / 2 ^ P + 1 / 2 := by
  have h := fmul_err P x y
  have hS := two_pow_pos' P
  have h2 : |(fmul P x y : ℝ) / 2 ^ P| ≤ |(x : ℝ)| * |(y : ℝ)| / 2 ^ P / 2 ^ P + 1 / (2 * 2 ^ P) := by
    have := abs_sub_abs_le_abs_sub ((fmul P x y : ℝ) / 2 ^ P) ((x : ℝ) / 2 ^ P * ((y : ℝ) / 2 ^ P))
    have e2 : |(x : ℝ) / 2 ^ P * ((y : ℝ) / 2 ^ P)| = |(x : ℝ)| * |(y : ℝ)| / 2 ^ P / 2 ^ P := by
      rw [abs_mul, abs_div, abs_div, abs_of_pos hS]; ring
    linarith
  rw [abs_div, abs_of_pos hS, div_le_iff₀ hS] at h2
  have e3 : (|(x : ℝ)| * |(y : ℝ)| / 2 ^ P / 2 ^ P + 1 / (2 * 2 ^ P)) * 2 ^ P =
      |(x : ℝ)| * |(y : ℝ)| / 2 ^ P + 1 / 2 := by field_simp
  linarith

lemma dotF_abs_le (P : ℕ) (cs acc : List ℤ) {C Z : ℝ} (hC : ∀ x ∈ cs, |(x : ℝ)| ≤ C)
    (hZ : ∀ x ∈ acc, |(x : ℝ)| ≤ Z) (hC0 : 0 ≤ C) (hZ0 : 0 ≤ Z) :
    |(dotF P cs acc : ℝ)| ≤ cs.length * (C * Z / 2 ^ P + 1 / 2) := by
  have hS := two_pow_pos' P
  unfold dotF
  rw [Int.cast_sum]
  refine (abs_sum_le_sum_abs _ _).trans ?_
  have hterm : ∀ i ∈ range cs.length,
      |(fmul P (cs.getD i 0) (acc.getD i 0) : ℝ)| ≤ C * Z / 2 ^ P + 1 / 2 := by
    intro i hi
    rw [mem_range] at hi
    have h1 : |((cs.getD i 0 : ℤ) : ℝ)| ≤ C := by
      rw [List.getD_eq_getElem _ _ hi]; exact hC _ (List.getElem_mem _)
    have h2 : |((acc.getD i 0 : ℤ) : ℝ)| ≤ Z := by
      by_cases hl : i < acc.length
      · rw [List.getD_eq_getElem _ _ hl]; exact hZ _ (List.getElem_mem _)
      · rw [List.getD_eq_default _ _ (by omega)]; simpa using hZ0
    have h3 := fmul_abs_le P (cs.getD i 0) (acc.getD i 0)
    have h4 : |((cs.getD i 0 : ℤ) : ℝ)| * |((acc.getD i 0 : ℤ) : ℝ)| ≤ C * Z :=
      mul_le_mul h1 h2 (abs_nonneg _) hC0
    have h5 := div_le_div_of_nonneg_right h4 hS.le
    linarith
  refine (sum_le_sum hterm).trans ?_
  rw [sum_const, card_range, nsmul_eq_mul]

section vals
variable {P : ℕ} {S : ℕ → ℕ → Prop} [DecidableRel S] {L : List ℕ} {A : ℕ → ℕ → ℤ} {η : ℝ}

/-- **The solution values.** -/
theorem z_bound (h : ElimOK P S L A η) (hη : η ≤ 1 / 4)
    (hL : ((L.length : ℝ) + 1) ^ 2 / 2 ^ P ≤ 1 / 8) (b : ℕ → ℤ) {M : ℝ}
    (hb : ∀ i, |(b i : ℝ)| ≤ M) (hM : 0 ≤ M) :
    ∀ k, |(geSolveS P S L A b k : ℝ)| ≤ 4 * M + 2 ^ P := by
  have hS := two_pow_pos' P
  have hge := geSolveS_eq P S L A b η h.nd h.η0 h.ηs h.row h.zero h.pat
  have hB := (geSolve_bound P L A b η (M / 2 ^ P) h.nd h.η0 hη hL h.row
    (fun i _ => by rw [abs_div, abs_of_pos hS]; exact div_le_div_of_nonneg_right (hb i) hS.le)
    (by positivity)).1
  intro k
  by_cases hk : k ∈ L
  · rw [hge k]
    have := hB k hk
    rw [abs_div, abs_of_pos hS, div_le_iff₀ hS] at this
    have e : (4 * (M / 2 ^ P) + 1) * 2 ^ P = 4 * M + 2 ^ P := by field_simp
    linarith
  · rw [geSolveS_off P S L A b k hk]; simp; positivity

end vals

section cc
variable {P R s t lam w α : ℕ}

lemma cpl_abs_le (hs : 0 < s) (i : ℕ) (h : ℤ) :
    |((TT P R s t α).cpl i h : ℝ)| ≤ 2 ^ P + 1 := by
  show |(expNeg P (s ^ 2) (α ^ 2 * (eKz s t i h).toNat) : ℝ)| ≤ 2 ^ P + 1
  have hx0 : 0 ≤ π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ) := by positivity
  have hb := expNeg_err (P := P) (s := s ^ 2) (by positivity) (α ^ 2 * (eKz s t i h).toNat)
    (x := π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ)) rfl
  have he : Real.exp (-(π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ))) ≤ 1 :=
    Real.exp_le_one_iff.2 (by linarith)
  have hp := Real.exp_pos (-(π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ)))
  have hS := two_pow_pos' P
  have := abs_sub_abs_le_abs_sub (expNeg P (s ^ 2) (α ^ 2 * (eKz s t i h).toNat) : ℝ)
    (2 ^ P * Real.exp (-(π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ))))
  rw [abs_of_pos (by positivity : (0 : ℝ) < 2 ^ P * Real.exp
    (-(π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ))))] at this
  have : (2 : ℝ) ^ P * Real.exp (-(π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) /
      ((s ^ 2 : ℕ) : ℝ))) ≤ 2 ^ P := by nlinarith
  linarith

lemma ccOf_abs_le (hs : 0 < s) (L : List ℕ) (K r i : ℕ) :
    |(ccOf (TT P R s t α) (BB s t lam w) L K r i : ℝ)| ≤ (2 * w + 1) * (2 ^ P + 1) := by
  unfold ccOf
  rw [Int.cast_sum]
  refine (abs_sum_le_sum_abs _ _).trans ?_
  refine (sum_le_sum (g := fun _ => (2 : ℝ) ^ P + 1) (fun h _ => ?_)).trans ?_
  · split_ifs
    · exact cpl_abs_le hs _ _
    · simp; positivity
  · rw [sum_const, nsmul_eq_mul]
    have hc0 := Hset_card (B := BB s t lam w) (L.getD r 0)
    have hw : (BB s t lam w).w = w := rfl
    rw [hw] at hc0
    have hc : ((Hset (BB s t lam w) (L.getD r 0)).card : ℝ) ≤ 2 * w + 1 := by exact_mod_cast hc0
    have := two_pow_pos' P
    nlinarith

end cc

end J6Seg

end

section
-- Source module: Solutions.J6SegJPre6
/-!
# `J` kernel precondition (JPre), part 6: the explicit parameters and the table length

* `Xb0 P w Bv = max Bv P + size (2w+1) + 4`: the a-priori bit bound of every stream entry and
  intermediate of the `J` kernel on an input with `Bnd Bv`;
* `Bc0 s K G = size (G + 2K + 3s² + 2Ks + 10s)`: the counter bound;
* `jBody_len`: `|jBody| ≤ 3m² + 2Km + 7m` for streams of `m` rows with the line shapes;
* `zsz_of_abs`, `abs_of_bnd`: between `zsz` bounds and real bounds;
* `xb0_ge`: `2^{Xb0} ≥ 16 (2w+2) 2^{max Bv P}`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK
open IntMul NLogN NLogN.KIL Function

lemma abs_of_bnd {a : ℤ} {X : ℕ} (h : zsz a ≤ X) : |(a : ℝ)| < 2 ^ X := by
  have h1 := zsz_le_iff.1 h
  have : ((a.natAbs : ℕ) : ℝ) < ((2 ^ X : ℕ) : ℝ) := by exact_mod_cast h1
  rw [Nat.cast_natAbs, Int.cast_abs] at this; push_cast at this; exact this

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegJPre8
/-!
# `J` kernel precondition (JPre), part 8: the output bound of the `J` kernel

`jKer_out_bnd`: in the regime `SegReg`, with `|LJ| ≤ G`, for every row part `v` of length `G`
with `Bnd Bv v`, every entry of `jKer P R s t λ w α K G v` is bounded by
`jWb P w K Bv = 11 (2K+1)(2w+1) 2^{max Bv P}` (the window coefficients are `≤ (2w+1)(2^P+1)`,
the capacitance solution `≤ 4·2^{Bv} + 2^P`). `jKerG_out_bnd`: the same for both parts of a
`GI` row through `liftG`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK
open IntMul NLogN NLogN.KIL NLogN.KFB Function

section out
variable {P R s t lam w α K G Bv : ℕ}

set_option maxHeartbeats 1000000 in
/-- **The output bound of the `J` kernel** (one part). -/
theorem jKer_out_bnd_sol_aux (h : SegReg P R s t lam w α) (hG : (LJ s t lam w).length ≤ G)
    (v : List ℤ) (hv : v.length = G) (hvb : Bnd Bv v) :
    ∀ y ∈ jKer P R s t lam w α K G v, |y| ≤ jWb P w K Bv := by
  obtain ⟨η, hη4, hL8, hE⟩ := segReg_elim h
  have hsort := LJ_sorted (s := s) (t := t) (lam := lam) (w := w)
  have hnd := LJ_nodup s t lam w
  have hS := two_pow_pos' P
  have hMP : (2 : ℝ) ^ P ≤ 2 ^ max Bv P := pow_le_pow_right₀ (by norm_num) (le_max_right _ _)
  have hMB : (2 : ℝ) ^ Bv ≤ 2 ^ max Bv P := pow_le_pow_right₀ (by norm_num) (le_max_left _ _)
  have hP1 : (1 : ℝ) ≤ 2 ^ P := one_le_pow₀ (by norm_num)
  have hw0 : (0 : ℝ) ≤ w := Nat.cast_nonneg _
  have hK0 : (0 : ℝ) ≤ K := Nat.cast_nonneg _
  have hvl : (LJ s t lam w).length ≤ v.length := by omega
  have hbv : ∀ i, |(bv (LJ s t lam w) v i : ℝ)| ≤ 2 ^ Bv := by
    intro i; unfold bv
    by_cases hi : (LJ s t lam w).idxOf i < v.length
    · rw [List.getD_eq_getElem _ _ hi]; exact (abs_of_bnd (hvb _ (List.getElem_mem _))).le
    · rw [List.getD_eq_default _ _ (by omega)]; simp only [Int.cast_zero, abs_zero]; positivity
  have hz0 := z_bound hE hη4 hL8 (bv (LJ s t lam w) v) hbv (by positivity)
  have htake : v.take (LJ s t lam w).length =
      (List.range (LJ s t lam w).length).map fun r => bv (LJ s t lam w) v ((LJ s t lam w).getD r 0) := by
    apply List.ext_getElem
    · simp; omega
    · intro r h1 h2
      simp only [List.getElem_take, List.getElem_map, List.getElem_range]
      rw [bv_at hnd v (by simpa using h2), List.getD_eq_getElem _ _ (by simp at h1; omega)]
  have hzl := jsolve_eq (P := P) (mw := lam + w) (c := s - lam - w)
    (A := capI P (J6Seg.TT P R s t α) (BB s t lam w)) hsort (bv (LJ s t lam w) v)
  rw [← htake] at hzl
  intro y hy
  unfold jKer at hy
  rw [List.mem_append] at hy
  rcases hy with hy | hy
  · unfold wOf at hy
    rw [hzl, List.mem_map] at hy
    obtain ⟨r, hr, rfl⟩ := hy
    have hZ : ∀ x ∈ (zext K ((List.range (LJ s t lam w).length).map fun r =>
        geSolveS P (bandS (lam + w) (s - lam - w)) (LJ s t lam w) (capI P (J6Seg.TT P R s t α)
          (BB s t lam w)) (bv (LJ s t lam w) v) ((LJ s t lam w).getD r 0))).drop r,
        |(x : ℝ)| ≤ 5 * 2 ^ max Bv P := by
      intro x hx
      have hx' := List.mem_of_mem_drop hx
      unfold zext at hx'
      have hx'' : x ∈ (List.range (LJ s t lam w).length).map fun r =>
          geSolveS P (bandS (lam + w) (s - lam - w)) (LJ s t lam w) (capI P (J6Seg.TT P R s t α)
            (BB s t lam w)) (bv (LJ s t lam w) v) ((LJ s t lam w).getD r 0) := by
        rcases List.mem_append.1 hx' with h1 | h1
        · exact List.mem_of_mem_drop h1
        · rcases List.mem_append.1 h1 with h2 | h2
          · exact h2
          · exact List.mem_of_mem_take h2
      obtain ⟨q, _, rfl⟩ := List.mem_map.1 hx''
      have := hz0 ((LJ s t lam w).getD q 0)
      linarith
    have hC : ∀ x ∈ ccL P R s t lam w α K r, |(x : ℝ)| ≤ (2 * w + 1) * (2 ^ P + 1) := by
      intro x hx
      simp only [ccL, List.mem_map, List.mem_range] at hx
      obtain ⟨i, _, rfl⟩ := hx
      exact ccOf_abs_le h.hs (LJ s t lam w) K r i
    have hM0 : (0 : ℝ) < 2 ^ max Bv P := by positivity
    have hd := dotF_abs_le P _ _ hC hZ (by positivity) (by positivity)
    have hlen : (ccL P R s t lam w α K r).length = 2 * K + 1 := by simp [ccL]
    rw [hlen] at hd
    push_cast at hd
    have hwM : (0 : ℝ) ≤ (2 * w + 1) * 2 ^ max Bv P := by positivity
    have e1 : (2 * (w : ℝ) + 1) * (2 ^ P + 1) * (5 * 2 ^ max Bv P) / 2 ^ P ≤
        10 * ((2 * w + 1) * 2 ^ max Bv P) := by
      rw [div_le_iff₀ hS]
      nlinarith [mul_nonneg hwM (sub_nonneg.2 hP1)]
    have e2 : (1 : ℝ) / 2 ≤ (2 * w + 1) * 2 ^ max Bv P := by
      have : (1 : ℝ) ≤ 2 ^ max Bv P := le_trans hP1 hMP
      nlinarith
    have e3 : (2 * (K : ℝ) + 1) * ((2 * w + 1) * (2 ^ P + 1) * (5 * 2 ^ max Bv P) / 2 ^ P + 1 / 2)
        ≤ (2 * (K : ℝ) + 1) * (11 * ((2 * w + 1) * 2 ^ max Bv P)) :=
      mul_le_mul_of_nonneg_left (by linarith) (by positivity)
    have hfin : |(dotF P (ccL P R s t lam w α K r) ((zext K ((List.range (LJ s t lam w).length).map
        fun r => geSolveS P (bandS (lam + w) (s - lam - w)) (LJ s t lam w) (capI P (J6Seg.TT P R s t α)
          (BB s t lam w)) (bv (LJ s t lam w) v) ((LJ s t lam w).getD r 0))).drop r) : ℝ)| ≤
        ((jWb P w K Bv : ℤ) : ℝ) := by
      unfold jWb; push_cast
      have e4 : (11 : ℝ) * (2 * K + 1) * (2 * w + 1) * 2 ^ max Bv P =
          (2 * (K : ℝ) + 1) * (11 * ((2 * w + 1) * 2 ^ max Bv P)) := by ring
      rw [e4]; linarith
    exact_mod_cast hfin
  · rw [List.mem_replicate] at hy
    rw [hy.2]; unfold jWb; simp; positivity

end out

end J6Seg.JK

end

theorem solution : type_of% @J6Seg.JK.jKer_out_bnd_sol_aux := @J6Seg.JK.jKer_out_bnd_sol_aux
