variable (C : Type) [CommRing C] (p : C)

abbrev I (T : Type) [CommRing T] [Algebra C T] : Ideal T := Ideal.span {algebraMap C T p}

abbrev mkA (T : Type) [CommRing T] [Algebra C T] : T →ₐ[C] T ⧸ I C p T := Ideal.Quotient.mkₐ C (I C p T)

lemma algebraMap_quot (T : Type) [CommRing T] [Algebra C T] :
    algebraMap C (T ⧸ I C p T) = (Ideal.Quotient.mk (I C p T)).comp (algebraMap C T) :=
  RingHom.ext fun _ => rfl

lemma algebraMap_quot_p (T : Type) [CommRing T] [Algebra C T] : algebraMap C (T ⧸ I C p T) p = 0 := by
  rw [algebraMap_quot, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span rfl

lemma mkA_coe (T : Type) [CommRing T] [Algebra C T] :
    (mkA C p T : T →+* T ⧸ I C p T) = Ideal.Quotient.mk (I C p T) := RingHom.ext fun _ => rfl

lemma I_le_comap {T T' : Type} [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T'] (φ : T →ₐ[C] T') :
    I C p T ≤ (I C p T').comap φ := by
  rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, AlgHom.commutes]
  exact Ideal.subset_span rfl

abbrev barA {T T' : Type} [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T'] (φ : T →ₐ[C] T') :
    T ⧸ I C p T →ₐ[C] T' ⧸ I C p T' := Ideal.quotientMapₐ (I C p T') φ (I_le_comap C p φ)

lemma barA_comp_mk {T T' : Type} [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T'] (φ : T →ₐ[C] T') :
    (barA C p φ : T ⧸ I C p T →+* T' ⧸ I C p T').comp (Ideal.Quotient.mk (I C p T)) =
      (Ideal.Quotient.mk (I C p T')).comp (φ : T →+* T') := by
  have h := Ideal.quotient_map_comp_mkₐ (I C p T') φ (I_le_comap C p φ)
  have h' := congrArg (fun (g : T →ₐ[C] T' ⧸ I C p T') => (g : T →+* T' ⧸ I C p T')) h
  simpa [AlgHom.comp_toRingHom, mkA_coe] using h'

abbrev specMk (T : Type) [CommRing T] [Algebra C T] :
    Spec (CommRingCat.of (T ⧸ I C p T)) ⟶ Spec (CommRingCat.of T) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I C p T)))

lemma specMk_comp_algebraMap (T : Type) [CommRing T] [Algebra C T] :
    specMk C p T ≫ Spec.map (CommRingCat.ofHom (algebraMap C T)) =
      Spec.map (CommRingCat.ofHom (algebraMap C (T ⧸ I C p T))) := by
  rw [algebraMap_quot, CommRingCat.ofHom_comp, Spec.map_comp]

lemma spec_barA_comp_specMk {T T' : Type} [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T']
    (φ : T →ₐ[C] T') :
    Spec.map (CommRingCat.ofHom (barA C p φ : T ⧸ I C p T →+* T' ⧸ I C p T')) ≫ specMk C p T =
      specMk C p T' ≫ Spec.map (CommRingCat.ofHom (φ : T →+* T')) := by
  simp only [specMk, ← Spec.map_comp, ← CommRingCat.ofHom_comp, barA_comp_mk]

end

