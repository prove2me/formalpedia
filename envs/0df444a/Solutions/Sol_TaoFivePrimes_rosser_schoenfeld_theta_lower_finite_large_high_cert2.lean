    rw [le_div_iff₀ (by norm_num)]
    nlinarith
  · have hc' : Nat.ble (y * 10995116277760000000000) Z = false := by
      cases hb : Nat.ble (y * 10995116277760000000000) Z
      · rfl
      · exact absurd (Nat.le_of_ble_eq_true hb) hc
