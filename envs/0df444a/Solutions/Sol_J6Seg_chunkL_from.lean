-- Source module: Solutions.J6SegLn2
/-!
# Segmented inverse (S2), machine side 2: `M⁻¹` chunk by chunk

With `λ`-aligned chunks `[cλ, cλ + λ)` every block of `mkBlocks s t λ w` lies inside one chunk
(cuts at the multiples of `λ`). The blocks of chunk `c` (`chunkBl`) start at `cλ` and follow each
other (`b ↦ b + 1 + enF b`) until `min(s, cλ + λ)`.

* `chunkL di gi gam dd descs x`: the block solves of consecutive blocks
  `descs = [(n_k, am_k, ap_k)]` on consecutive segments of `x`, zeros on the rest;
* `descsOf T c`: the block descriptors of chunk `c` (lengths and the block tables `am, ap`);
* **`chunkL_rep`**: on chunk `c`, `chunkL … (descsOf c) x` is `M⁻¹` (`applyMinv`) at the positions
  `< s` of the chunk and `0` at the others.
-/

open Finset

namespace J6Seg

section chunk
variable (P : ℕ) (s t lam : ℕ)

variable {s t lam}

lemma stF_of_cut {b i : ℕ} (hb : cutP s t lam b) (hbi : b ≤ i)
    (hi : i < b + 1 + enF s t lam b) : stF s t lam i = b := by
  unfold stF
  rw [Nat.findGreatest_eq_iff]
  refine ⟨hbi, fun _ => hb, fun j hj hji hcj => ?_⟩
  have := (not_cut_of_lt_en (s := s) (t := t) (lam := lam) (c := b) (k := j - b - 1)
    (by omega)).1
  rw [show b + 1 + (j - b - 1) = j by omega] at this
  exact this hcj

lemma next_cut_or {b : ℕ} : cutP s t lam (b + 1 + enF s t lam b) ∨ s ≤ b + 1 + enF s t lam b :=
  Nat.find_spec (enF_ex s t lam b)

lemma en_le_chunk (hl : 1 ≤ lam) {b c : ℕ} (hb1 : c * lam ≤ b) (hb2 : b < c * lam + lam) :
    b + 1 + enF s t lam b ≤ c * lam + lam := by
  have hm : (b + 1 + (lam - b % lam - 1)) % lam = 0 := by
    have h1 : b % lam < lam := Nat.mod_lt _ (by omega)
    have h2 : b + 1 + (lam - b % lam - 1) = lam * (b / lam + 1) := by
      have := Nat.div_add_mod b lam
      rw [Nat.mul_add, mul_one]; omega
    rw [h2, Nat.mul_mod_right]
  have h := Nat.find_min' (enF_ex s t lam b) (Or.inl (Or.inr (Or.inl hm)))
  have hdiv : b / lam = c := Nat.div_eq_of_lt_le hb1 (by rw [Nat.succ_mul]; exact hb2)
  have := Nat.div_add_mod b lam
  unfold enF at *
  have e3 : lam * (b / lam) = c * lam := by rw [hdiv, mul_comm]
  omega

end chunk

section chunkRep
variable (P R s t lam w α : ℕ)

variable {P R s t lam w α}

lemma getD_range_map {n u : ℕ} (f : ℕ → ℤ) (hu : u < n) : ((List.range n).map f).getD u 0 = f u := by
  rw [List.getD_eq_getElem _ _ (by simp; omega)]; simp

/-- The general step: blocks from a cut `st` of chunk `c`. -/
theorem chunkL_from_sol_aux (hl : 1 ≤ lam) (c : ℕ) :
    ∀ (f st : ℕ) (x : List ℤ), c * lam ≤ st → st ≤ c * lam + lam → cutP s t lam st ∨ s ≤ st →
      c * lam + lam ≤ st + f → x.length = c * lam + lam - st →
      ∀ (X : ℕ → ℤ), (∀ u < x.length, x.getD u 0 = X (st + u)) →
      ∀ u < x.length, (chunkL P (diL P R s t lam α) (giL P R s t lam α) (gamL P R s t lam α)
        (ddL P R s t lam α) (descsFrom P R s t lam α c f st) x).getD u 0 =
        if st + u < s then applyMinv P (TT P R s t α) (BB s t lam w) X (st + u) else 0 := by
  intro f
  induction f with
  | zero =>
    intro st x h1 h2 hcs hf hx X hX u hu
    exfalso; omega
  | succ f ih =>
    intro st x h1 h2 hcs hf hx X hX u hu
    by_cases hst : st < min s (c * lam + lam)
    · -- a block starting at the cut `st`
      have hlt : st < s := lt_of_lt_of_le hst (min_le_left _ _)
      have hcut : cutP s t lam st := by rcases hcs with h | h; exact h; omega
      have hchunk : st < c * lam + lam := lt_of_lt_of_le hst (min_le_right _ _)
      have hend := en_le_chunk (s := s) (t := t) hl h1 hchunk
      have hends : st + 1 + enF s t lam st ≤ s := en_le_s hlt
      obtain ⟨n, hn⟩ : ∃ n, n = 1 + enF s t lam st := ⟨_, rfl⟩
      have eb : blFrom s t lam (min s (c * lam + lam)) (f + 1) st =
          (st, n) :: blFrom s t lam (min s (c * lam + lam)) f (st + n) := by
        simp only [blFrom, if_pos hst, hn, Nat.add_assoc]
      simp only [descsFrom, eb, List.map_cons, chunkL]
      have hnx : n ≤ x.length := by rw [hx]; omega
      have hrep : RepL n (x.take n) (fun v => X (st + v)) := by
        refine ⟨by simp; omega, fun v hv => ?_⟩
        rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_take,
          ← List.getD_eq_getElem _ 0 (by omega), hX v (by omega)]
      have hr := blkL_rep P (TT P R s t α) st n (di := diL P R s t lam α) (gi := giL P R s t lam α)
            (gam := gamL P R s t lam α) (dd := ddL P R s t lam α)
            (am := (List.range n).map ((TT P R s t α).am st))
            (ap := (List.range n).map ((TT P R s t α).ap st))
            (by simp [diL]; omega) (by simp [giL]; omega) (by simp [gamL]; omega)
            (by simp [ddL]; omega)
            (fun u hu => getD_range_map _ (by omega)) (fun u hu => getD_range_map _ (by omega))
            (fun u hu => getD_range_map _ (by omega)) (fun u hu => getD_range_map _ (by omega))
            (fun u hu => getD_range_map _ hu) (fun u hu => getD_range_map _ hu) hrep
      by_cases hun : u < n
      · rw [List.getD_append _ _ _ _ (by rw [hr.1]; exact hun), hr.2 u hun, if_pos (by omega)]
        have hsF : stF s t lam (st + u) = st := stF_of_cut hcut (by omega) (by omega)
        simp only [applyMinv, BB, mkBlocks, hsF, ← hn]
        rw [show st + u - st = u by omega]
      · rw [List.getD_append_right _ _ _ _ (by rw [hr.1]; omega), hr.1]
        have hnext := next_cut_or (s := s) (t := t) (lam := lam) (b := st)
        have := ih (st + n) (x.drop n) (by omega) (by omega)
          (by rw [hn, ← Nat.add_assoc]; exact hnext)
          (by omega) (by simp; omega) X (fun v hv => by
            simp only [List.length_drop] at hv
            rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_drop,
              ← List.getD_eq_getElem _ 0 (by omega), hX (n + v) (by omega)]
            congr 1; omega) (u - n) (by simp; omega)
        simp only [descsFrom] at this
        rw [this, show st + n + (u - n) = st + u by omega]
    · have eb : blFrom s t lam (min s (c * lam + lam)) (f + 1) st = [] := by
        simp only [blFrom, if_neg hst]
      simp only [descsFrom, eb, List.map_nil, chunkL]
      rw [List.getD_eq_getElem _ _ (by simp; omega)]
      simp only [List.getElem_map]
      have : s ≤ st := by
        by_contra h
        push Not at h
        have : st < min s (c * lam + lam) := lt_min h (by omega)
        exact hst this
      rw [if_neg (by omega)]

end chunkRep

end J6Seg

end

theorem solution : type_of% @J6Seg.chunkL_from_sol_aux := @J6Seg.chunkL_from_sol_aux
