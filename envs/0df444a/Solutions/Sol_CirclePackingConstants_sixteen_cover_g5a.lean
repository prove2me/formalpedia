open CirclePackingConstants in
theorem solution (n : ℕ → ℕ) (hn : ∀ i, n i ≤ 2) (hsum : ∑ i ∈ Finset.range 16, n i = 16) (hne : ∃ i < 16, n i ≠ 1)
    (hab : (n 0 = 1 ∧ n 1 = 1 ∧ n 2 = 0) ∨ (n 0 = 1 ∧ n 1 = 1 ∧ n 2 = 2)) :
    ∃ e s tx ty, Sixteen.Matches Sixteen.sixteenLib n e s tx ty := by
  have h0 := hn 0
  have h1 := hn 1
  have h2 := hn 2
  rcases hab with ha | hab
  · exact CPQ.piece_sound3 Sixteen.sixteenLib CPQ.covTabP110 CPQ.tabP110_ok CPQ.covTokP110 1 1 0 CPQ.pieceP110_ok (by omega) (by omega) (by omega) n hn hsum hne ha.1 ha.2.1 ha.2.2
  ·
    have ha := hab
    exact CPQ.piece_sound3 Sixteen.sixteenLib CPQ.covTabP112 CPQ.tabP112_ok CPQ.covTokP112 1 1 2 CPQ.pieceP112_ok (by omega) (by omega) (by omega) n hn hsum hne ha.1 ha.2.1 ha.2.2
