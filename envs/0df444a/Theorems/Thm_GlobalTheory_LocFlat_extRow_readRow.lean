theorem GlobalTheory.LocFlat.extRow_readRow (p : ℕ) (hp : p - 1 < c) (z : Matrix (n ⊕ Fin c) (n' ⊕ Fin (c + 1)) k) (r s)
    (h : rdRow p r s = true) : extRow (readRow p hp z) r s = z r s := by sorry
