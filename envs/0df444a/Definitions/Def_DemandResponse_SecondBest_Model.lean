-- title:
--   Canonical space, controls, admissible pairs (weak formulation), criteria $J_A$, $J_P$, contracts $\mathcal C$ (2.5), $V_A$, $\mathcal P^\star(\xi)$ and $V^{SB}$ (2.7)
-- statement:
--   This file sets up the continuous-time contracting problem of Sections 2.1-2.2.
--
--   **Canonical space.** $\Omega:=C([0,T],\mathbb R)$ with canonical process $X_t(\omega)=\omega(t)$, the σ-algebra generated by the coordinates, and the natural filtration $\mathcal F_t:=\sigma(X_s:s\le t)$, $t\in[0,T]$.
--
--   **Controls.** A control $\nu=(\alpha,\beta)$ is a pair of $\mathbb F$-progressively measurable processes with $\alpha_t\in A$ and $\beta_t\in B=[\varepsilon,1]^d$. Its cost rate is $c(\nu_t):=c_1(\alpha_t)+\frac12c_2(\beta_t)$.
--
--   **Admissible pairs.** The controlled equation (2.1), $X_t=X_0-\int_0^t\alpha_s\cdot\mathbf 1\,ds+\int_0^t\sigma(\beta_s)\cdot dW_s$, is taken in the weak sense. A pair $(\nu,\mathbb P)$ is admissible when $\mathbb P$ is a probability measure on $\Omega$ with $\mathbb P(X_0=X_0)=1$ under which
--   $$M_t:=X_t-X_0+\int_0^t\alpha_s\cdot\mathbf 1\,ds\qquad\text{and}\qquad M_t^2-\int_0^t|\sigma(\beta_s)|^2ds$$
--   are $\mathbb F$-martingales.
--
--   **Criteria.** With $f(x)=\kappa x$, $g(x)=\theta x$, $U_A(x)=-e^{-rx}$, $U(x)=-e^{-px}$ and $\langle X\rangle_T=\int_0^T|\sigma(\beta_s)|^2ds$:
--   $$J_A(\xi,\nu,\mathbb P):=\mathbb E^{\mathbb P}\Big[U_A\Big(\xi+\int_0^T\big(\kappa X_s-c(\nu_s)\big)ds\Big)\Big],\qquad J_P(\xi,\nu,\mathbb P):=\mathbb E^{\mathbb P}\Big[U\Big(-\xi-\int_0^T\theta X_sds-\frac h2\langle X\rangle_T\Big)\Big],$$
--   both valued in $[-\infty,0]$.
--
--   **Contracts.** $\xi\in\mathcal C$ if $\xi$ is $\mathcal F_T$-measurable and, for some $m>1$,
--   $$\sup_{(\nu,\mathbb P)}\mathbb E^{\mathbb P}\big[e^{-rm\xi}\big]+\sup_{(\nu,\mathbb P)}\mathbb E^{\mathbb P}\big[e^{pm\xi}\big]<+\infty\qquad(2.5),$$
--   the suprema over admissible pairs.
--
--   **Values.** The consumer's value is $V_A(\xi):=\sup_{(\nu,\mathbb P)}J_A(\xi,\nu,\mathbb P)$ (2.3), and $\mathcal P^\star(\xi)$ is the set of admissible pairs attaining it. The producer's second-best value is
--   $$V^{SB}:=\sup_{\xi\in\Xi}\ \sup_{(\nu,\mathbb P)\in\mathcal P^\star(\xi)}J_P(\xi,\nu,\mathbb P),\qquad\Xi:=\{\xi\in\mathcal C:V_A(\xi)\ge R_0\}\qquad(2.7),$$
--   with $\sup\emptyset=-\infty$: the consumer responds optimally and, among optimal responses, the one best for the producer is used.
--
--   **Formalization Note.** The paper indexes everything by the law $\mathbb P^\nu$ and ignores the weak-solution technicalities (footnote 2, p. 7); here the admissible object is the pair $(\nu,\mathbb P)$, defined by a martingale problem on the canonical space, which is equivalent to $\mathbb P$ being the law of a weak solution of (2.1) for these bounded coefficients. Controls are required to be progressively measurable (the paper says adapted). In $J_P$ the quadratic variation $\langle X\rangle_T$ is replaced by its almost-sure value $\int_0^T|\sigma(\beta_s)|^2ds$; contracts may still be any $\mathcal F_T$-measurable function of the path. Expectations of the utilities are negated lower Lebesgue integrals of $e^{(\cdot)}$, so they are always defined, in $[-\infty,0]$; all suprema are in the extended reals, so the empty supremum is $-\infty$. Processes on $[0,T]$ are integrated in time through the clamp $s\mapsto\mathrm{proj}_{[0,T]}(s)$, only on $[0,T]$.
-- source:
--   arXiv:1810.09063v3, Section 2.1 (pp. 7-8: (2.1), c(ν), A, B, C, (2.2), (2.3), P*(ξ)), Section 2.2 (pp. 8-9: (2.4), (2.5), (2.7))

import Mathlib
import Definitions.Def_DemandResponse_SecondBest_Hamiltonian

namespace DemandResponse.SecondBest

open MeasureTheory

variable {N d : ℕ}

/-- The canonical space `Ω := C([0,T], ℝ)` of scalar continuous consumption paths (p. 7). -/
abbrev PathSpace (T : ℝ) := C(Set.Icc (0 : ℝ) T, ℝ)

/-- The σ-algebra on `Ω` generated by the coordinates `X_t(ω) = ω(t)`. -/
instance pathMeasurableSpace (T : ℝ) : MeasurableSpace (PathSpace T) :=
  ⨆ t : Set.Icc (0 : ℝ) T, MeasurableSpace.comap (fun ω : PathSpace T => ω t) inferInstance

/-- The natural filtration `𝔽 = (𝓕_t)_{t ∈ [0,T]}` of the canonical process `X`:
`𝓕_t := σ(X_s : s ≤ t)` (p. 7). -/
def canonFilt (T : ℝ) : Filtration (Set.Icc (0 : ℝ) T) (pathMeasurableSpace T) where
  seq t := ⨆ (s : Set.Icc (0 : ℝ) T) (_ : s ≤ t),
    MeasurableSpace.comap (fun ω : PathSpace T => ω s) inferInstance
  mono' _ _ hst := iSup₂_mono' fun s hs => ⟨s, le_trans hs hst, le_rfl⟩
  le' _ := iSup₂_le fun s _ =>
    le_iSup (fun s : Set.Icc (0 : ℝ) T =>
      MeasurableSpace.comap (fun ω : PathSpace T => ω s) inferInstance) s

/-- Clamping a real time into `[0, T]`, used to integrate processes indexed by `[0, T]`
(only times in `[0, T]` are ever integrated). -/
noncomputable def clampT (P : Params N d) (s : ℝ) : Set.Icc (0 : ℝ) P.T := Set.projIcc 0 P.T P.hT.le s

/-- The terminal time `T` as an element of `[0, T]`. -/
def termT (P : Params N d) : Set.Icc (0 : ℝ) P.T := ⟨P.T, P.hT.le, le_rfl⟩

/-- The initial time `0` as an element of `[0, T]`. -/
def initT (P : Params N d) : Set.Icc (0 : ℝ) P.T := ⟨0, le_rfl, P.hT.le⟩

/-- A control `ν = (α, β)` of the consumer (p. 7): processes on the canonical space, progressively
measurable for the canonical filtration, with `α` valued in `A` and `β` valued in `B = [ε,1]^d`. -/
structure Control (P : Params N d) where
  α : Set.Icc (0 : ℝ) P.T → PathSpace P.T → (Fin N → ℝ)
  β : Set.Icc (0 : ℝ) P.T → PathSpace P.T → (Fin d → ℝ)
  α_mem : ∀ t ω, α t ω ∈ EffA P
  β_mem : ∀ t ω, β t ω ∈ EffB P
  α_prog : IsStronglyProgressive (canonFilt P.T) α
  β_prog : IsStronglyProgressive (canonFilt P.T) β

/-- The cost rate `c(ν_t) := c₁(α_t) + ½ c₂(β_t)` (p. 8). -/
noncomputable def costRate (P : Params N d) (ν : Control P) (t : Set.Icc (0 : ℝ) P.T)
    (ω : PathSpace P.T) : ℝ :=
  c1 P (ν.α t ω) + (1 / 2) * c2 P (ν.β t ω)

/-- The martingale part `M_t := X_t - X₀ + ∫₀ᵗ α_s · 1 ds` of the controlled equation (2.1). -/
noncomputable def driftCompensated (P : Params N d) (ν : Control P) (t : Set.Icc (0 : ℝ) P.T)
    (ω : PathSpace P.T) : ℝ :=
  ω t - P.X0 + ∫ s in (0 : ℝ)..(t : ℝ), ∑ i, ν.α (clampT P s) ω i

/-- `∫₀ᵗ |σ(β_s)|² ds`, the quadratic variation of `X` up to time `t` under an admissible pair. -/
noncomputable def qvIntegral (P : Params N d) (ν : Control P) (t : ℝ) (ω : PathSpace P.T) : ℝ :=
  ∫ s in (0 : ℝ)..t, sigmaSq P (ν.β (clampT P s) ω)

/-- Weak formulation of the controlled equation (2.1),
`X_t = X₀ - ∫₀ᵗ α_s·1 ds + ∫₀ᵗ σ(β_s)·dW_s`, as a martingale problem on the canonical space: `(ν, ℙ)` is
admissible when `ℙ` is a probability measure with `X_0 = X₀` a.s. under which
`M_t = X_t - X₀ + ∫₀ᵗ α_s·1 ds` and `M_t² - ∫₀ᵗ |σ(β_s)|² ds` are `𝔽`-martingales. -/
def IsAdmissible (P : Params N d) (ν : Control P) (Q : Measure (PathSpace P.T)) : Prop :=
  IsProbabilityMeasure Q ∧
  (∀ᵐ ω ∂Q, ω (initT P) = P.X0) ∧
  Martingale (fun t ω => driftCompensated P ν t ω) (canonFilt P.T) Q ∧
  Martingale (fun t ω => driftCompensated P ν t ω ^ 2 - qvIntegral P ν (t : ℝ) ω) (canonFilt P.T) Q

/-- Consumer's criterion (2.2) with `f(x) = κ x` and `U_A(x) = -e^{-r x}`:
`J_A(ξ, ν, ℙ) := E^ℙ[ -exp(-r(ξ + ∫₀ᵀ (κ X_s - c(ν_s)) ds)) ]`, as an extended real in `[-∞, 0]`. -/
noncomputable def JA (P : Params N d) (ξ : PathSpace P.T → ℝ) (ν : Control P)
    (Q : Measure (PathSpace P.T)) : EReal :=
  -(((∫⁻ ω, ENNReal.ofReal (Real.exp (-P.r * (ξ ω +
      (∫ s in (0 : ℝ)..P.T, (P.κ * ω (clampT P s) - costRate P ν (clampT P s) ω))))) ∂Q) : ENNReal) : EReal)

/-- Producer's criterion (2.4) with `g(x) = θ x`, `U(x) = -e^{-p x}` and
`⟨X⟩_T = ∫₀ᵀ |σ(β_s)|² ds`: `J_P(ξ, ν, ℙ) := E^ℙ[ -exp(-p(-ξ - ∫₀ᵀ θ X_s ds - (h/2) ⟨X⟩_T)) ]`,
an extended real in `[-∞, 0]`. -/
noncomputable def JP (P : Params N d) (ξ : PathSpace P.T → ℝ) (ν : Control P)
    (Q : Measure (PathSpace P.T)) : EReal :=
  -(((∫⁻ ω, ENNReal.ofReal (Real.exp (-P.p * (-ξ ω -
      (∫ s in (0 : ℝ)..P.T, P.θ * ω (clampT P s)) - P.h / 2 * qvIntegral P ν P.T ω))) ∂Q) : ENNReal) : EReal)

/-- The contracts `𝒞` (p. 9): `𝓕_T`-measurable `ξ` with the integrability property (2.5),
`sup_ℙ E^ℙ[e^{-r m ξ}] + sup_ℙ E^ℙ[e^{p m ξ}] < +∞` for some `m > 1`, the suprema over all admissible
pairs. -/
def IsContract (P : Params N d) (ξ : PathSpace P.T → ℝ) : Prop :=
  Measurable[canonFilt P.T (termT P)] ξ ∧
  ∃ m : ℝ, 1 < m ∧
    (⨆ (ν : Control P) (Q : Measure (PathSpace P.T)) (_ : IsAdmissible P ν Q),
        ∫⁻ ω, ENNReal.ofReal (Real.exp (-P.r * m * ξ ω)) ∂Q) +
      (⨆ (ν : Control P) (Q : Measure (PathSpace P.T)) (_ : IsAdmissible P ν Q),
        ∫⁻ ω, ENNReal.ofReal (Real.exp (P.p * m * ξ ω)) ∂Q) < ⊤

/-- The consumer's value (2.3), `V_A(ξ) := sup_{(ν,ℙ) admissible} J_A(ξ, ν, ℙ)` in `[-∞, +∞]`. -/
noncomputable def VA (P : Params N d) (ξ : PathSpace P.T → ℝ) : EReal :=
  ⨆ (ν : Control P) (Q : Measure (PathSpace P.T)) (_ : IsAdmissible P ν Q), JA P ξ ν Q

/-- The consumer's optimal responses `𝒫*(ξ)` (p. 8): admissible pairs attaining `V_A(ξ)`. -/
def IsOptimalResponse (P : Params N d) (ξ : PathSpace P.T → ℝ) (ν : Control P)
    (Q : Measure (PathSpace P.T)) : Prop :=
  IsAdmissible P ν Q ∧ JA P ξ ν Q = VA P ξ

/-- The producer's second-best value (2.7):
`V^SB := sup_{ξ ∈ Ξ} sup_{ℙ ∈ 𝒫*(ξ)} J_P(ξ, ℙ)` with `Ξ := {ξ ∈ 𝒞 : V_A(ξ) ≥ R₀}`; the empty supremum is
`⊥ = -∞`, the paper's convention `sup ∅ = -∞`. -/
noncomputable def VSB (P : Params N d) : EReal :=
  ⨆ (ξ : PathSpace P.T → ℝ) (_ : IsContract P ξ ∧ (P.R0 : EReal) ≤ VA P ξ),
    ⨆ (ν : Control P) (Q : Measure (PathSpace P.T)) (_ : IsOptimalResponse P ξ ν Q), JP P ξ ν Q

end DemandResponse.SecondBest


