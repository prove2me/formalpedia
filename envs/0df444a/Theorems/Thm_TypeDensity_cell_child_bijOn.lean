theorem TypeDensity.cell_child_bijOn (m : ConcreteMember) (c : m.cellIndex) (D : CellChildData m c) :
    Set.BijOn (fun J j => D.Φ J j) (m.toMeasured.cell c)
        (Set.pi Set.univ fun j => (D.mc j).toMeasured.stateSet) := by sorry
