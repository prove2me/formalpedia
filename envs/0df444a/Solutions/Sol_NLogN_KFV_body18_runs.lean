-- Source module: Solutions.KFV17Link
/-!
# KFV §21: the generated terms are the paper's exponent table

For the paper's layout (`pLP`: `D, ℓ, K, b = bb, q = qq, nL = nLong, Lst = |lstL|, n = |tgtL|`)
the closed-form positions are the slot positions of `tgtL`:

* `spos_eq_posF`: `spos (i, t) = posF i t` for `t ≤ ℓ - 2` (`pre_slot`, `tgt_slot`);
* `spos_top`: the top slot of a long axis sits at its rank among the long axes;

hence (**`genG_perm`**) the terms generated at run time (`genG`) are a permutation of
`tabT h = trips tgtL ℓ h (partAxes al h)` (forward) resp. of `negTr (2r) (tabT h)` (opposite),
and the exponent tables agree (**`svv_genG`**).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open Finset Synth GlueLayout GlueP14 GlueError

/-! ## List lemmas -/

theorem filter_take_length {α : Type*} (p : α → Bool) :
    ∀ (l : List α) (k : ℕ), ((l.take k).filter p).length = ((l.map p).take k).count true
  | [], k => by simp
  | y :: l, 0 => by simp
  | y :: l, k + 1 => by
    rw [List.take_succ_cons, List.map_cons, List.take_succ_cons, List.filter_cons, List.count_cons]
    by_cases hy : p y = true
    · simp only [hy, if_true, List.length_cons, filter_take_length p l k]; simp
    · simp only [hy, Bool.false_eq_true, if_false, filter_take_length p l k]; simp

/-! ## The paper's layout parameters -/

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

theorem flOf_count : (flOf D long).count true = nLong D long := by
  unfold flOf nLong
  have := filter_take_length (fun i => long i) (List.finRange D) D
  rw [List.take_of_length_le (by simp), List.take_of_length_le (by simp)] at this
  exact this.symm

end Paper

end NLogN.KFV

