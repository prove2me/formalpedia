open Filter Topology
open scoped ContDiff
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
variable {n : ℕ}
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
theorem solution {s : Set E} {A : E → Matrix (Fin n) (Fin n) ℝ}
    (hA : ∀ a b, ContDiffOn ℝ ∞ (fun p => A p a b) s) (a b : Fin n) :
    ContDiffOn ℝ ∞ (fun p => (A p).adjugate a b) s := by
  simp only [Matrix.adjugate_apply]
  refine contDiffOn_det_of fun p q => ?_
  by_cases hp : p = b
  · subst hp
    simp only [Matrix.updateRow_self]
    exact contDiffOn_const
  · simp only [Matrix.updateRow_ne hp]
    exact hA p q
