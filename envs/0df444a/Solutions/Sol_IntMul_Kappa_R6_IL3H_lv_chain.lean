section Lev

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

theorem ltNE_val (hL : LevRH c σ K t S0 r H E e B) :
    (ltNE c).val (vOf σ) = if E < 2 * c.m then 0 else 1 := by
  simp only [ltNE, NE.val, vOf_eq hL.hk]

/-- **A chain level.** -/
theorem lv_chain_sol_aux (hc : CfgOK c) {rowC : IStmt HS Pp} {jL : Fin Pp} (hj : tbl jL = levCH c jL rowC)
    {K r Z Zr H G : ℕ} {CB : ℕ → ℝ} {aK : ℕ → ℝ} {τ : ℝ} (hCB : CBRec c aK τ K CB) (hK : 1 ≤ K)
    (hr : 1 ≤ r) (hZr : Zr + 2 ≤ r) {E : ℕ} (hE1 : 1 ≤ E) (hE2 : E < 2 * c.m)
    (IH : LvH c Isym tbl jL rowC K r Z Zr H G CB (E - 1)) :
    LvH c Isym tbl jL rowC K r Z Zr H G CB E := by
  intro σ t S0 e B hL hG24 hS hB hdvd hdS hKe het hz16 hV hGH
  have hm := hc.m1
  set v := (ltNE c).val (vOf σ) with hv
  have hv0 : v = 0 := by rw [hv, ltNE_val hL, if_pos hE2]
  set σ19 := σPush σ [((19 : Fin HS), ((v : ℕ) : ℤ))] with hσ19
  have hL19 : LevRH c σ19 K t S0 r H E e B := levRH_push19 hL _
  have hle : ∀ x, x ≤ VbH c K t S0 r H E e B → zsz (x : ℤ) ≤ Zr := fun x hx =>
    le_trans (zsz_natCast_le hx) hV
  have hGE : c.G E = E := Gs_lt hE2
  have hGE1 : c.G (E - 1) = E - 1 := Gs_lt (by omega)
  -- the lower bits
  have hG19 : σPush σ19 (frV σ19 chainFr) vG = some (G : ℤ) := by
    rw [σPush_frV_ne σ19 σ19 chainFr (by decide), hσ19, σPush_ne _ _ _ (fun p hp => by
      simp only [List.mem_singleton] at hp; subst hp; exact (by decide : (19 : Fin HS) ≠ 24))]
    exact hG24
  have hF0 : (E - 1) / c.m - 1 = 0 := by
    have : (E - 1) / c.m < 2 := Nat.div_lt_of_lt_mul (by omega)
    omega
  have IHC := IH (σPush σ19 (frV σ19 chainFr)) t S0 (e - K) B (levRH_chain hL19 hE2) hG19 hS hB
    (by rw [dep_lt (by omega), pow_zero, hF0]; simp)
    (by rw [hF0]; simp)
    (by
      rcases Nat.lt_or_ge E 2 with h | h
      · have : E - 1 - 1 = 0 := by omega
        rw [this, mul_zero]; exact Nat.zero_le _
      · have e1 : K * (E - 1) = K * (E - 1 - 1) + K := by
          rw [show E - 1 = E - 1 - 1 + 1 by omega, mul_add, mul_one]; simp
        omega)
    (by have := het_sub hK het 1; rwa [mul_one] at this) hz16
    (le_trans (zsz_natCast_le (VbH_mono c (by omega) (Nat.sub_le _ _) le_rfl)) hV)
    (by rw [hGE1]; rw [hGE] at hGH; omega)
  have hz12 : zsz ((12 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Zr := hle _ (by
    unfold VbH
    have : B * 2 ^ t * S0 * r ≤ c.Wr * (B * 2 ^ t * S0 * r) :=
      Nat.le_mul_of_pos_left _ (by show 0 < c.W + c.T; have := hc.W1; omega)
    omega)
  obtain ⟨cost, SC, hcost⟩ := sImplQ_chainC hj hL19 hE1 hS hB hr hK hKe het Zr hz12 hZr
    (VbH c K t S0 r H E e B) (by unfold VbH; omega) hV _ _ IHC
  have hsc : ES 0 + c.G (E - 1) = c.G E := by
    rw [hGE, hGE1]; show 1 + (E - 1) = E; omega
  have hdw : 2 + (c.Wr + 4) * c.G (E - 1) ≤ (c.Wr + 4) * c.G E := by
    rw [hGE, hGE1]
    have : (c.Wr + 4) * E = (c.Wr + 4) * (E - 1) + (c.Wr + 4) := by
      rw [show E = E - 1 + 1 by omega, mul_add, mul_one]; simp
    omega
  have SC' := (SC.congrE hsc rfl).mono_dw hdw
  refine lv_wrap hL hE1 hm Zr (VbH c K t S0 r H E e B) hV (by unfold VbH; omega) hZr (CB E) _
    (by rw [← hv, if_pos hv0]; exact SC') (fun w hw => ?_)
  -- the cost
  have hw' : w + (2 + (c.Wr + 4) * c.G (E - 1)) ≤ H := le_trans (by omega) hw
  have h1 := hcost w hw'
  set NY := nN B t S0 * Yu r Zr H with hNY
  have hn1 : 1 ≤ nN B t S0 := one_le_nN hB hS
  have hYNY : Yu r Zr H ≤ NY := Nat.le_mul_of_pos_left _ hn1
  have hfl : (⌊CB (E - 1) * (NY : ℝ)⌋₊ : ℝ) ≤ CB (E - 1) * (NY : ℝ) :=
    Nat.floor_le (mul_nonneg (hCB.nonneg _) (Nat.cast_nonneg _))
  have h1R : (cost w : ℝ) ≤ (⌊CB (E - 1) * (NY : ℝ)⌋₊ : ℝ) + 10 ^ 13 * (NY : ℝ) := by
    exact_mod_cast h1
  have hYR : (Yu r Zr H : ℝ) ≤ (NY : ℝ) := by exact_mod_cast hYNY
  have hch := hCB.chain E hE1 hE2
  have hNY0 : (0 : ℝ) ≤ (NY : ℝ) := Nat.cast_nonneg _
  have hm1 := mul_le_mul_of_nonneg_right hch hNY0
  linarith

end Lev

