namespace HigherWeylShiftedSquarePairNormalization
open MetricCodes.Spherical.HigherHierarchy
theorem shifted_square_pair_ratio_eq_pairFactor
    {r n : ℕ} (hn : 2 * r + 4 ≤ n)
    (lam : Fin (r + 1) → ℕ)
    {i j : Fin (r + 1)} (hij : i < j) :
    ((((lam i : ℝ) - (i.val : ℝ)) *
          (((lam i : ℝ) - (i.val : ℝ)) + (n : ℝ) - 2) -
