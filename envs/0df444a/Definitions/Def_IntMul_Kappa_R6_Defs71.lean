open IntMul NLogN NLogN.KIL Function Finset

/-- Every table entry is `≤ X`. -/
structure TabX (T : Tables) (lam : ℕ) (X : ℤ) : Prop where
  ap : ∀ c, ∀ j < lam, |T.ap c j| ≤ X
  am : ∀ c, ∀ j < lam, |T.am c j| ≤ X
  gam : ∀ j ≤ lam, |T.gam j| ≤ X
  gi : ∀ j < lam, |T.gi j| ≤ X
  dd : ∀ j < lam, |T.dd j| ≤ X
  di : ∀ j < lam, |T.di j| ≤ X
  cpl : ∀ i h, |T.cpl i h| ≤ X
  X1 : 1 ≤ X

end J6Seg.PJ

