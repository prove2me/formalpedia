  have hx₁ : 𝔫.map (algebraMap (Pz.B₀ ⧸ 𝔭z) ((Pz.B₀ ⧸ 𝔭z) ⊗[V] A)) ≤ xT := by rw [Ideal.map_le_iff_le_comap, h𝔫def]
  have hx₂ : 𝔫.map (algebraMap (Pz.B₀ ⧸ 𝔭z) ((Pz.B₀ ⧸ 𝔭z) ⊗[Z₀] A₀)) ≤ 𝔪u.map ΘU := by
    rw [Ideal.map_le_iff_le_comap]
