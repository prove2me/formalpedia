theorem smul_one_ne_zero_of_unit (z : (ℍ[ℚ, a₁, b₁])ˣ) (c : ℚ) (hc : ((z : (ℍ[ℚ, a₁, b₁])ˣ) : ℍ[ℚ, a₁, b₁]) = c • 1) :
    c ≠ 0 := by
  intro h0
  apply Units.ne_zero z
  rw [hc, h0, zero_smul]

def Zc (Γt : Subgroup (ℍ[ℚ, a₁, b₁])ˣ) {G : Type} [Group G] (θt : ↥Γt →* G) : Subgroup ↥Γt where
  carrier := {z | (∃ c : ℚ, (((z : ↥Γt) : (ℍ[ℚ, a₁, b₁])ˣ) : ℍ[ℚ, a₁, b₁]) = c • 1) ∧ θt z = 1}
  one_mem' := ⟨⟨1, by rw [one_smul]; rfl⟩, map_one θt⟩
  mul_mem' := by
    rintro x y ⟨⟨c, hc⟩, hx⟩ ⟨⟨d, hd⟩, hy⟩
    refine ⟨⟨c * d, ?_⟩, by rw [map_mul, hx, hy, one_mul]⟩
    rw [Subgroup.coe_mul, Units.val_mul, hc, hd, smul_mul_smul_comm, one_mul]
  inv_mem' := by
    rintro x ⟨⟨c, hc⟩, hx⟩
    have hc0 : c ≠ 0 := smul_one_ne_zero_of_unit _ c hc
    refine ⟨⟨c⁻¹, ?_⟩, by rw [map_inv, hx, inv_one]⟩
    rw [Subgroup.coe_inv]
    apply Units.inv_eq_of_mul_eq_one_right
    rw [hc, smul_mul_smul_comm, one_mul, mul_inv_cancel₀ hc0, one_smul]

theorem mem_Zc_iff (Γt : Subgroup (ℍ[ℚ, a₁, b₁])ˣ) {G : Type} [Group G] (θt : ↥Γt →* G) (z : ↥Γt) :
    z ∈ Zc Γt θt ↔ (∃ c : ℚ, (((z : ↥Γt) : (ℍ[ℚ, a₁, b₁])ˣ) : ℍ[ℚ, a₁, b₁]) = c • 1) ∧ θt z = 1 := Iff.rfl

theorem central_mem_inf_map_conj (Γt : Subgroup (ℍ[ℚ, a₁, b₁])ˣ) (s z : (ℍ[ℚ, a₁, b₁])ˣ) (hz : z ∈ Γt)
    (c : ℚ) (hc : ((z : (ℍ[ℚ, a₁, b₁])ˣ) : ℍ[ℚ, a₁, b₁]) = c • 1) :
    z ∈ Γt ⊓ Γt.map (MulAut.conj s).toMonoidHom := by
  refine Subgroup.mem_inf.mpr ⟨hz, Subgroup.mem_map.mpr ⟨z, hz, ?_⟩⟩
  have hcomm : s * z = z * s := by
    apply Units.ext
    rw [Units.val_mul, Units.val_mul, hc, Algebra.mul_smul_comm, mul_one, Algebra.smul_mul_assoc, one_mul]
  rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, hcomm, mul_inv_cancel_right]

theorem exists_map_eq_scalarGL {K₀ : Type} [Field K₀] [CharZero K₀]
    (ι₀ : ℍ[ℚ, a₁, b₁] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) K₀) (z : (ℍ[ℚ, a₁, b₁])ˣ)
    (c : ℚ) (hc : ((z : (ℍ[ℚ, a₁, b₁])ˣ) : ℍ[ℚ, a₁, b₁]) = c • 1) :
    ∃ c' : K₀ˣ, Units.map (ι₀ : ℍ[ℚ, a₁, b₁] →* Matrix (Fin 2) (Fin 2) K₀) z = scalarGL c' := by
  have hc0 : c ≠ 0 := smul_one_ne_zero_of_unit _ c hc
  have hc1 : algebraMap ℚ K₀ c ≠ 0 := by
    rw [map_ne_zero_iff _ (algebraMap ℚ K₀).injective]; exact hc0
  refine ⟨Units.mk0 _ hc1, ?_⟩
  apply Units.ext
  rw [Units.coe_map, scalarGL_coe, Units.val_mk0, MonoidHom.coe_coe, hc, map_smul, map_one, algebraMap_smul]

