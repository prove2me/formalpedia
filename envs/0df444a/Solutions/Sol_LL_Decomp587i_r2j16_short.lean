      (lt_of_lt_of_le ha0_pos h2.1) (lt_of_lt_of_le ha0_pos h3.1)
      (by norm_num [b0, BuchstabArithmetic.b] at h0 h1 h2 h3; linarith [h0.2, h1.2, h2.2, h3.2])
  have hAT_eq : ∫ x in T_cone φ, (1 / rProd) * tanNum φ x = BuchstabArithmetic.AT φ := by
    rw [integral_const_mul]; exact integral_T_cone_tanNum hlo hhi
  by_cases hsplit : φ ≤ BuchstabArithmetic.splitPoint
  · rw [BuchstabArithmetic.capAffine, if_pos hsplit]
    have hAR_eq : ∫ x in R_cone φ, (1 / rProd) * tanNum φ x = BuchstabArithmetic.AR φ := by
      rw [integral_const_mul]; exact integral_R_cone_tanNum hlo hsplit
    have hdisj : Disjoint (Cap_open φ) (R_cone φ) := by
      rw [Set.disjoint_left]; intro x hxC hxR
      have h1 : a0 ≤ x.1 := hxC.1.1
      have h2 : x.1 < a0 := hxR.2.2.2.2
      linarith
    have hT_union : T_cone φ = Cap_open φ ∪ R_cone φ := by
      ext x; constructor
