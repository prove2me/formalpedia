namespace NLogN.KFM

/-- `B̃₀ = D̃' J̃' C̃`: the base `Bapprox` without its two data permutations. -/
def B0approx (p s t α : ℕ) (W : ℕ → ℤ × ℤ) : ℕ → ℤ × ℤ :=
  IntMul.HvdH.Dapprox p s t α (IntMul.HvdH.Japprox p s t α (IntMul.HvdH.cSel s t W))

/-- `B̃₀` read periodically: index `l` is reduced mod `s` (the machine reads `l < s` only). -/
def B0P (p s t α : ℕ) (W : ℕ → ℤ × ℤ) (l : ℕ) : ℤ × ℤ := B0approx p s t α W (l % s)

end NLogN.KFM

end

