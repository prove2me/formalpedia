import Mathlib
set_option autoImplicit false
open MeasureTheory ProbabilityTheory Filter
open scoped NNReal ENNReal
namespace Kyprianou.Ch09.B1

/-- First centred Appell polynomial generated by a finite first moment. -/
def appellOne (m x : ℝ) : ℝ := x - m

/-- Second centred Appell polynomial generated by its first two cumulants. -/
def appellTwo (m variance x : ℝ) : ℝ := (x - m) ^ 2 - variance

/-- The first Appell polynomial has derivative one. -/
theorem appellOne_deriv (m x : ℝ) :
    deriv (appellOne m) x = 1 := by
  change deriv (fun z : ℝ => z - m) x = 1
  exact ((hasDerivAt_id x).sub_const m).deriv

/-- The second Appell polynomial obeys the derivative recurrence. -/
theorem appellTwo_deriv (m variance x : ℝ) :
    deriv (appellTwo m variance) x = 2 * appellOne m x := by
  change deriv (fun z : ℝ => (z - m) ^ 2 - variance) x = 2 * (x - m)
  have h1 : HasDerivAt (fun z : ℝ => z - m) 1 x :=
    (hasDerivAt_id x).sub_const m
  have h2 := ((h1.pow 2).sub_const variance)
  have h3 : HasDerivAt (fun z : ℝ => (z - m) ^ 2 - variance)
      (2 * (x - m)) x := by
    simpa [pow_two, mul_comm, mul_left_comm, mul_assoc] using h2
  exact h3.deriv

/-- Degree-one mean-value property without any exponential-moment premise. -/
theorem appellOne_finite_mean {n : ℕ} (w y : Fin n → ℝ)
    (m x : ℝ)
    (hmass : ∑ i, w i = 1)
    (hm : ∑ i, w i * y i = m) :
    (∑ i, w i * appellOne m (x + y i)) = x := by
  simp only [appellOne]
  have heq :
      (∑ i, w i * (x + y i - m)) =
        (∑ i, w i) * x + (∑ i, w i * y i) -
        (∑ i, w i) * m := by
    simp_rw [mul_sub, mul_add]
    rw [Finset.sum_sub_distrib, Finset.sum_add_distrib]
    simp only [← Finset.sum_mul]
  rw [heq, hmass, hm]
  ring

/-- The first Appell root is its first moment. -/
theorem appellOne_root (m : ℝ) :
    appellOne m m = 0 := by
  simp [appellOne]

/-- Algebraic smooth-fit factor, valid even when the derivative vanishes. -/
theorem smoothFit_iff_factor_zero (slope atom : ℝ) :
    slope * atom = 0 ↔ slope = 0 ∨ atom = 0 := mul_eq_zero

end Kyprianou.Ch09.B1


