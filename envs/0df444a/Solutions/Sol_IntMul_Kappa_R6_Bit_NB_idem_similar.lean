-- Source module: Solutions.R6BitNBSim
/-!
# Round six, bit network: similarity of idempotents, explicit corner idempotent, transitivity

* `idem_similar`: idempotent matrices over `ℚ` of equal rank are similar.
* `eIdem n r`: an explicit idempotent of rank `r` whose top-right `(n-r)`-corner is the identity
  (for `n < 2r`).
* `conj_rank_one`: for `y ⬝ x = 1 = y' ⬝ x'` some invertible `Q` has `Q (x yᵀ) Q⁻¹ = x' y'ᵀ`.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset

section Sim

variable {n : ℕ}

lemma toLin'_idem {A : Matrix (Fin n) (Fin n) ℚ} (hA : A * A = A) :
    IsIdempotentElem (Matrix.toLin' A) := by
  rw [IsIdempotentElem, Module.End.mul_eq_comp, ← Matrix.toLin'_mul, hA]

lemma rank_toLin' (A : Matrix (Fin n) (Fin n) ℚ) :
    Module.finrank ℚ (LinearMap.range (Matrix.toLin' A)) = A.rank := by
  rw [Matrix.rank, Matrix.toLin'_apply']

/-- **Idempotents of equal rank are similar.** -/
theorem idem_similar_sol_aux (A B : Matrix (Fin n) (Fin n) ℚ) (hA : A * A = A) (hB : B * B = B)
    (hr : A.rank = B.rank) : ∃ Q : Matrix (Fin n) (Fin n) ℚ, IsUnit Q.det ∧ Q * A = B * Q := by
  set fA := Matrix.toLin' A with hfA
  set fB := Matrix.toLin' B with hfB
  have iA := toLin'_idem hA
  have iB := toLin'_idem hB
  have cA := LinearMap.IsIdempotentElem.isCompl iA
  have cB := LinearMap.IsIdempotentElem.isCompl iB
  have r1 : Module.finrank ℚ (LinearMap.range fA) = Module.finrank ℚ (LinearMap.range fB) := by
    rw [rank_toLin', rank_toLin', hr]
  have r2 : Module.finrank ℚ (LinearMap.ker fA) = Module.finrank ℚ (LinearMap.ker fB) := by
    have a1 := LinearMap.finrank_range_add_finrank_ker fA
    have a2 := LinearMap.finrank_range_add_finrank_ker fB
    omega
  let e1 := LinearEquiv.ofFinrankEq _ _ r1
  let e2 := LinearEquiv.ofFinrankEq _ _ r2
  let φ : (Fin n → ℚ) ≃ₗ[ℚ] (Fin n → ℚ) :=
    ((Submodule.prodEquivOfIsCompl _ _ cA).symm.trans (e1.prodCongr e2)).trans
      (Submodule.prodEquivOfIsCompl _ _ cB)
  have key : (φ : (Fin n → ℚ) →ₗ[ℚ] (Fin n → ℚ)) ∘ₗ fA = fB ∘ₗ (φ : (Fin n → ℚ) →ₗ[ℚ] _) := by
    apply LinearMap.ext
    intro v
    obtain ⟨⟨a, b⟩, rfl⟩ := (Submodule.prodEquivOfIsCompl _ _ cA).surjective v
    have hfa : fA a = a := (LinearMap.IsIdempotentElem.mem_range_iff iA).1 a.2
    have hfb : fA b = 0 := b.2
    have hfa' : fB (e1 a) = e1 a := (LinearMap.IsIdempotentElem.mem_range_iff iB).1 (e1 a).2
    have hfb' : fB (e2 b) = 0 := (e2 b).2
    have h1 : φ (a : Fin n → ℚ) = (e1 a : Fin n → ℚ) := by
      simp only [φ, LinearEquiv.trans_apply, Submodule.prodEquivOfIsCompl_symm_apply_left,
        LinearEquiv.prodCongr_apply, map_zero, Submodule.coe_prodEquivOfIsCompl',
        ZeroMemClass.coe_zero, add_zero]
    have h2 : φ (Submodule.prodEquivOfIsCompl _ _ cA (a, b)) = (e1 a : Fin n → ℚ) + e2 b := by
      show (Submodule.prodEquivOfIsCompl _ _ cB) ((e1.prodCongr e2)
        ((Submodule.prodEquivOfIsCompl _ _ cA).symm (Submodule.prodEquivOfIsCompl _ _ cA (a, b)))) = _
      rw [LinearEquiv.symm_apply_apply]; rfl
    simp only [LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply]
    rw [h2, Submodule.coe_prodEquivOfIsCompl', map_add, hfa, hfb, add_zero, h1, map_add, hfa',
      hfb', add_zero]
  refine ⟨LinearMap.toMatrix' (φ : (Fin n → ℚ) →ₗ[ℚ] (Fin n → ℚ)), ?_, ?_⟩
  · apply Matrix.isUnit_det_of_right_inverse
      (B := LinearMap.toMatrix' (φ.symm : (Fin n → ℚ) →ₗ[ℚ] (Fin n → ℚ)))
    rw [← LinearMap.toMatrix'_comp]
    have : (φ : (Fin n → ℚ) →ₗ[ℚ] (Fin n → ℚ)) ∘ₗ (φ.symm : (Fin n → ℚ) →ₗ[ℚ] (Fin n → ℚ)) =
        LinearMap.id := by
      apply LinearMap.ext; intro v; simp
    rw [this, LinearMap.toMatrix'_id]
  · have h1 : A = LinearMap.toMatrix' fA := by rw [hfA, LinearMap.toMatrix'_toLin']
    have h2 : B = LinearMap.toMatrix' fB := by rw [hfB, LinearMap.toMatrix'_toLin']
    rw [h1, h2, ← LinearMap.toMatrix'_comp, ← LinearMap.toMatrix'_comp, key]

end Sim

end IntMul.Kappa.R6.Bit.NB

