section
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
open GlueProp18
open Finset Butterfly AModel Synth GlueLayout GlueP14 GlueError
variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ) {D : ℕ}
variable {sh : Shape} {a : Fin D → ℕ} (L : CoordLayout sh a)
variable {r : ℕ} {C : CoeffModel y r}
theorem solution (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool) {r : ℕ}
    (C : Synth.CoeffModel y r) (p : ℕ) (hK : 0 < K) (hℓ : 1 ≤ ℓ) (hy : y ^ (2 ^ ℓ) = -1)
    {f g : List R} (hf : f.length = AModel.vol (Synth.binSh (Synth.tgtL D ℓ K long).length))
    (hg : g.length = AModel.vol (Synth.binSh (Synth.tgtL D ℓ K long).length))
    (hfd : ∀ k, ‖C.co (f.getD k 0)‖ ≤ 1) (hgd : ∀ k, ‖C.co (g.getD k 0)‖ ≤ 1)
    {v : List ℕ} (hv : AModel.Valid (Synth.binSh (Synth.tgtL D ℓ K long).length) v) :
    ‖C.co ((Synth.Mv (Synth.al D ℓ long) : ℂ) • (GlueProp18.procQI y (GlueLayout.paperLayout D ℓ K long hK hℓ) C p ℓ
        (Synth.partAxes (Synth.al D ℓ long)) (GlueLayout.paperSel D ℓ K long hK hℓ) ℓ
        (GlueError.ofA (GlueProp18.QQ y C p (GlueProp18.PP y C
          (GlueError.toA C (AModel.vol (Synth.binSh (Synth.tgtL D ℓ K long).length)) (GlueError.procQ C p (GlueLayout.paperLayout D ℓ K long hK hℓ) ℓ (Synth.partAxes (Synth.al D ℓ long))
            (GlueLayout.paperSel D ℓ K long hK hℓ) ℓ f))
          (GlueError.toA C (AModel.vol (Synth.binSh (Synth.tgtL D ℓ K long).length)) (GlueError.procQ C p (GlueLayout.paperLayout D ℓ K long hK hℓ) ℓ (Synth.partAxes (Synth.al D ℓ long))
            (GlueLayout.paperSel D ℓ K long hK hℓ) ℓ g)))))).getD
          (AModel.encode (Synth.binSh (Synth.tgtL D ℓ K long).length) v) 0 -
        Synth.Mr r (Synth.al D ℓ long) (Synth.fn (GlueLayout.paperLayout D ℓ K long hK hℓ) f)
          (Synth.fn (GlueLayout.paperLayout D ℓ K long hK hℓ) g) ((GlueLayout.paperLayout D ℓ K long hK hℓ).coord v))‖ <
      Real.sqrt 2 * (Synth.Mv (Synth.al D ℓ long)) * (3 * ℓ + 1) * 2⁻¹ ^ p :=
  GlueProp18.prop18_scaled_full y (GlueLayout.paperLayout D ℓ K long hK hℓ) p hy (GlueLayout.al_le D ℓ long) hℓ
    (fun h _ => GlueLayout.paper_compat D ℓ K long hK hℓ h) hf hg hfd hgd hv
end
