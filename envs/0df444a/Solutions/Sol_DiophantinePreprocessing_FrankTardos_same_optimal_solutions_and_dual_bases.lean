        rw [e1, ← Finset.sum_attach S.1 (fun i => y i • v i)]
        show ∑ j ∈ S.1.attach, y (j : Fin n) • v (j : Fin n)
          = ∑ j : {x // x ∈ S.1}, w j • v (j : Fin n)
        rw [Finset.univ_eq_attach]
        exact Finset.sum_congr rfl (fun j _ => by simp [hy, j.2])
  rw [key]
  exact isClosed_iUnion_of_finite (fun S => isClosed_image_of_linearIndepOn v S.1 S.2)

/-- The image of the nonnegative orthant under `y ↦ W y` is closed. -/
theorem isClosed_coneOf (W : Matrix (Fin m) (Fin n) ℝ) : IsClosed (coneOf W) := by
  have h : coneOf W
      = {z : Fin m → ℝ | ∃ y : Fin n → ℝ, (∀ j, 0 ≤ y j) ∧ ∑ j, y j • (fun i => W i j) = z} := by
    ext z
    constructor
    · rintro ⟨y, hy, rfl⟩; exact ⟨y, hy, (mulVec_eq_sum W y).symm⟩
    · rintro ⟨y, hy, rfl⟩; exact ⟨y, hy, mulVec_eq_sum W y⟩
  rw [h]
  exact isClosed_coneSpan _

/-- The image of the nonnegative orthant under `y ↦ W y` is convex. -/
theorem convex_coneOf (W : Matrix (Fin m) (Fin n) ℝ) : Convex ℝ (coneOf W) := by
  rintro z1 ⟨y1, hy1, rfl⟩ z2 ⟨y2, hy2, rfl⟩ a b ha hb _
  refine ⟨a • y1 + b • y2, fun j => ?_, ?_⟩
  · have := mul_nonneg ha (hy1 j)
    have := mul_nonneg hb (hy2 j)
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    linarith
  · simp [Matrix.mulVec_add, Matrix.mulVec_smul]

end FGCone

namespace FGCone

variable {m n : ℕ}

/-- The cone is stable under nonnegative scaling. -/
lemma smul_mem_coneOf (A : Matrix (Fin m) (Fin n) ℝ) {z : Fin m → ℝ} (hz : z ∈ coneOf A)
    {t : ℝ} (ht : 0 ≤ t) : t • z ∈ coneOf A := by
  obtain ⟨y, hy, rfl⟩ := hz
  exact ⟨t • y, fun j => mul_nonneg ht (hy j), by rw [Matrix.mulVec_smul]⟩

lemma zero_mem_coneOf (A : Matrix (Fin m) (Fin n) ℝ) : (0 : Fin m → ℝ) ∈ coneOf A :=
  ⟨0, fun _ => le_rfl, by simp⟩

/-- Every column of `A` lies in the cone. -/
lemma col_mem_coneOf (A : Matrix (Fin m) (Fin n) ℝ) (j : Fin n) :
    (fun i => A i j) ∈ coneOf A := by
  refine ⟨Pi.single j 1, fun k => ?_, ?_⟩
  · by_cases h : k = j <;> simp [h]
  · funext i
    simp [Matrix.mulVec, dotProduct, Pi.single_apply]

/-- **Farkas' lemma**: exactly one of `∃ x ≥ 0, A x = b` and
`∃ p, Aᵀ p ≥ 0 ∧ pᵀ b < 0` holds. -/
theorem farkas_lemma (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) :
    Xor (∃ x : Fin n → ℝ, 0 ≤ x ∧ A.mulVec x = b)
      (∃ p : Fin m → ℝ, 0 ≤ Aᵀ.mulVec p ∧ dotProduct p b < 0) := by
  by_cases hP : ∃ x : Fin n → ℝ, 0 ≤ x ∧ A.mulVec x = b
  · left
    refine ⟨hP, ?_⟩
    rintro ⟨p, hp, hpb⟩
    obtain ⟨x, hx, hAx⟩ := hP
    have h1 : dotProduct p b = dotProduct (Aᵀ.mulVec p) x := by
      rw [← hAx, Matrix.dotProduct_mulVec, Matrix.mulVec_transpose]
    have h2 : 0 ≤ dotProduct (Aᵀ.mulVec p) x :=
      Finset.sum_nonneg fun j _ => mul_nonneg (hp j) (hx j)
    rw [h1] at hpb
    linarith
  · right
    refine ⟨?_, hP⟩
    have hbnot : b ∉ coneOf A := by
      rintro ⟨y, hy, hAy⟩
      exact hP ⟨y, fun j => hy j, hAy⟩
    obtain ⟨f, u, hfs, hfb⟩ :=
      geometric_hahn_banach_closed_point (convex_coneOf A) (isClosed_coneOf A) hbnot
    have hu : 0 < u := by
      have h := hfs 0 (zero_mem_coneOf A)
      simpa using h
    have hcone_le : ∀ z ∈ coneOf A, f z ≤ 0 := by
      intro z hz
      by_contra hpos
      push Not at hpos
      have ht : (0:ℝ) ≤ (u + 1) / f z := by positivity
      have hmem := smul_mem_coneOf A hz ht
      have h := hfs _ hmem
      rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ (ne_of_gt hpos)] at h
      linarith
    set p : Fin m → ℝ := fun i => - f (Pi.single i 1) with hpdef
    have hrepr : ∀ z : Fin m → ℝ, f z = - dotProduct p z := by
      intro z
      have hz : z = ∑ i, z i • (Pi.single i (1:ℝ)) := by
        funext k
        simp [Finset.sum_apply, Pi.single_apply]
      calc f z = f (∑ i, z i • (Pi.single i (1:ℝ))) := by rw [← hz]
        _ = ∑ i, z i * f (Pi.single i (1:ℝ)) := by
            rw [map_sum]; exact Finset.sum_congr rfl (fun i _ => by rw [map_smul, smul_eq_mul])
        _ = - dotProduct p z := by
            rw [dotProduct, ← Finset.sum_neg_distrib]
            exact Finset.sum_congr rfl (fun i _ => by simp [hpdef, mul_comm])
    refine ⟨p, ?_, ?_⟩
    · intro j
      have hcol : f (fun i => A i j) ≤ 0 := hcone_le _ (col_mem_coneOf A j)
      rw [hrepr] at hcol
      have : 0 ≤ dotProduct p (fun i => A i j) := by linarith
      simpa [Matrix.mulVec, dotProduct, Matrix.transpose_apply, mul_comm] using this
    · have h := hfb
      rw [hrepr] at h
      linarith

end FGCone
end


/- Inlined checked module: SquareBasisCoordinates -/
section
set_option autoImplicit false

open scoped BigOperators
open Matrix

namespace ObjectiveCompression

def SameSmallSigns (n : ℕ) (w w' : Fin n → ℝ) : Prop :=
  ∀ h : Fin n → ℤ, ∑ j, |h j| ≤ ((n + 1).factorial : ℤ) →
    SignType.sign (realDot h w) = SignType.sign (realDot h w')

noncomputable def squareCoordinates {n : ℕ} (D : Matrix (Fin n) (Fin n) ℤ) (w : Fin n → ℝ) :
    Fin n → ℝ :=
  ((D.det : ℝ)⁻¹) • (w ᵥ* D.adjugate.map (Int.castRingHom ℝ))

theorem squareCoordinates_reconstruct {n : ℕ} (D : Matrix (Fin n) (Fin n) ℤ)
    (hD : D.det ≠ 0) (w : Fin n → ℝ) :
    squareCoordinates D w ᵥ* D.map (Int.castRingHom ℝ) = w := by
  have hd : (D.det : ℝ) ≠ 0 := by exact_mod_cast hD
  have hm : D.adjugate.map (Int.castRingHom ℝ) * D.map (Int.castRingHom ℝ) =
      (D.det : ℝ) • 1 := by
    change (Int.castRingHom ℝ).mapMatrix D.adjugate *
      (Int.castRingHom ℝ).mapMatrix D = _
    rw [(Int.castRingHom ℝ).map_adjugate, Matrix.adjugate_mul,
      ← (Int.castRingHom ℝ).map_det]
    rfl
  rw [squareCoordinates, Matrix.smul_vecMul, Matrix.vecMul_vecMul, hm,
    Matrix.vecMul_smul, Matrix.vecMul_one, smul_smul, inv_mul_cancel₀ hd, one_smul]

theorem squareCoordinates_vecMul {n : ℕ} (D : Matrix (Fin n) (Fin n) ℤ)
    (hD : D.det ≠ 0) (c : Fin n → ℝ) :
    squareCoordinates D (c ᵥ* D.map (Int.castRingHom ℝ)) = c := by
  have hd : (D.det : ℝ) ≠ 0 := by exact_mod_cast hD
  have hm : D.map (Int.castRingHom ℝ) * D.adjugate.map (Int.castRingHom ℝ) =
      (D.det : ℝ) • 1 := by
    change (Int.castRingHom ℝ).mapMatrix D *
      (Int.castRingHom ℝ).mapMatrix D.adjugate = _
    rw [(Int.castRingHom ℝ).map_adjugate, Matrix.mul_adjugate,
      ← (Int.castRingHom ℝ).map_det]
    rfl
  rw [squareCoordinates, Matrix.vecMul_vecMul, hm, Matrix.vecMul_smul,
    Matrix.vecMul_one, smul_smul, inv_mul_cancel₀ hd, one_smul]

theorem adjugate_column_test_bound {n : ℕ} (D : Matrix (Fin n) (Fin n) ℤ)
    (hD : ∀ i j, |D i j| ≤ 1) (k : Fin n) :
    ∑ j, |D.adjugate j k| ≤ ((n + 1).factorial : ℤ) := by
  have hterm (j : Fin n) : |D.adjugate j k| ≤ (n.factorial : ℤ) := by
    simpa using abs_adjugate_le_factorial_pow D 1 (by norm_num) hD j k
  calc
    ∑ j, |D.adjugate j k| ≤ ∑ _j : Fin n, (n.factorial : ℤ) :=
      Finset.sum_le_sum fun j _ => hterm j
    _ ≤ ((n + 1).factorial : ℤ) := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      exact_mod_cast (show n * n.factorial ≤ (n + 1).factorial by
        rw [Nat.factorial_succ]
        nlinarith)

/-- Bounded sign tests determine the signs of coordinates in every 0/±1 basis. -/
theorem squareCoordinates_sign_eq {n : ℕ} (D : Matrix (Fin n) (Fin n) ℤ)
    (hD : ∀ i j, |D i j| ≤ 1) (w w' : Fin n → ℝ)
    (hs : SameSmallSigns n w w') (k : Fin n) :
    SignType.sign (squareCoordinates D w k) = SignType.sign (squareCoordinates D w' k) := by
  have ht := hs (fun j => D.adjugate j k) (adjugate_column_test_bound D hD k)
  change SignType.sign ((D.det : ℝ)⁻¹ * realDot (fun j => D.adjugate j k) w) =
    SignType.sign ((D.det : ℝ)⁻¹ * realDot (fun j => D.adjugate j k) w')
  rw [sign_mul, sign_mul, ht]

end ObjectiveCompression
end


/- Inlined checked module: BoundedBasisExtension -/
section
set_option autoImplicit false

open scoped BigOperators
open Matrix

namespace ObjectiveCompression

/-- Complete independent 0/±1 rows to a square basis using only standard coordinate rows. -/
theorem exists_bounded_basis_extension {ι : Type*} [Fintype ι] {n : ℕ}
    (C : Matrix ι (Fin n) ℤ) (hC : ∀ i j, |C i j| ≤ 1)
    (hli : LinearIndependent ℝ (fun i j => (C i j : ℝ))) :
    ∃ D : Matrix (Fin n) (Fin n) ℤ, (∀ i j, |D i j| ≤ 1) ∧ D.det ≠ 0 ∧
      ∃ e : ι ↪ Fin n, ∀ i, D (e i) = C i := by
  classical
  let v : ι ⊕ Fin n → Fin n → ℤ := Sum.elim C (fun j => Pi.single j 1)
  let V : ι ⊕ Fin n → Fin n → ℝ := fun i j => (v i j : ℝ)
  have hleft : LinearIndepOn ℝ V (Sum.inl '' (Set.univ : Set ι)) := by
    apply LinearIndepOn.image_of_comp Sum.inl V
    exact hli.linearIndepOn_univ
  obtain ⟨B, _, hB, hspan, hliB⟩ :=
    exists_linearIndepOn_extension hleft (Set.subset_univ _)
  have hstd (j : Fin n) : Pi.single j (1 : ℝ) ∈ Submodule.span ℝ (V '' B) := by
    have h := hspan ⟨Sum.inr j, Set.mem_univ _, rfl⟩
    have heq : V (Sum.inr j) = Pi.single j (1 : ℝ) := by
      ext k
      change (((Pi.single j (1 : ℤ) : Fin n → ℤ) k) : ℝ) =
        (Pi.single j (1 : ℝ) : Fin n → ℝ) k
      by_cases hk : k = j
      · subst k
        simp
      · simp [Pi.single_eq_of_ne hk]
    rw [← heq]
    exact h
  have htop : ⊤ ≤ Submodule.span ℝ (V '' B) := by
    rw [← (Pi.basisFun ℝ (Fin n)).span_eq]
    apply Submodule.span_le.mpr
    rintro _ ⟨j, rfl⟩
    rw [Pi.basisFun_apply]
    exact hstd j
  have htop' : ⊤ ≤ Submodule.span ℝ (Set.range (fun i : B => V i.1)) := by
    simpa only [Set.image_eq_range] using htop
  let basis : Module.Basis B ℝ (Fin n → ℝ) := Module.Basis.mk hliB htop'
  have hcard : Fintype.card B = n := by
    simpa using (Module.finrank_eq_card_basis basis).symm
  let e : Fin n ≃ B := Fintype.equivOfCardEq (by simpa using hcard.symm)
  let D : Matrix (Fin n) (Fin n) ℤ := fun i j => v (e i).1 j
  have hD (i j : Fin n) : |D i j| ≤ 1 := by
    dsimp [D]
    cases hk : (e i).1 with
    | inl k => exact hC k j
    | inr k =>
        change |(Pi.single k (1 : ℤ) : Fin n → ℤ) j| ≤ 1
        by_cases hj : j = k
        · subst j
          simp
        · simp [Pi.single_eq_of_ne hj]
  have hliD : LinearIndependent ℝ (fun i j => (D i j : ℝ)) :=
    hliB.comp e e.injective
  have hdetR : (D.map (Int.castRingHom ℝ)).det ≠ 0 :=
    Matrix.nonsingular_iff_det_ne_zero.mp
      (Matrix.Nonsingular.of_linearIndependent_row hliD)
  have hdet : D.det ≠ 0 := by
    have hcast : (D.det : ℝ) ≠ 0 := by
      rw [show (D.det : ℝ) = (D.map (Int.castRingHom ℝ)).det from
        (Int.castRingHom ℝ).map_det D]
      exact hdetR
    exact_mod_cast hcast
  let f : ι → B := fun i => ⟨Sum.inl i, hB ⟨i, Set.mem_univ _, rfl⟩⟩
  let emb : ι ↪ Fin n :=
    ⟨fun i => e.symm (f i), by
      intro i j hij
      have h := congrArg Subtype.val (e.symm.injective hij)
      exact Sum.inl_injective h⟩
  refine ⟨D, hD, hdet, emb, ?_⟩
  intro i
  change v (e (e.symm (f i))).1 = C i
  rw [e.apply_symm_apply]
  rfl

end ObjectiveCompression
end


/- Inlined checked module: CoefficientEmbedding -/
section
set_option autoImplicit false

open scoped BigOperators
open Matrix

namespace ObjectiveCompression

variable {ι : Type*} [Fintype ι] {n : ℕ}

def embedCoefficients (e : ι ↪ Fin n) (c : ι → ℝ) : Fin n → ℝ :=
  fun j => ∑ i, if e i = j then c i else 0

theorem embedCoefficients_apply (e : ι ↪ Fin n) (c : ι → ℝ) (i : ι) :
    embedCoefficients e c (e i) = c i := by
  classical
  simp [embedCoefficients, e.injective.eq_iff]

theorem embedCoefficients_eq_zero (e : ι ↪ Fin n) (c : ι → ℝ) (j : Fin n)
    (hj : j ∉ Set.range e) : embedCoefficients e c j = 0 := by
  apply Finset.sum_eq_zero
  intro i _
  exact if_neg (fun h => hj ⟨i, h⟩)

theorem embedCoefficients_vecMul {k : ℕ} (e : ι ↪ Fin n) (c : ι → ℝ)
    (D : Matrix (Fin n) (Fin k) ℝ) (j : Fin k) :
    (embedCoefficients e c ᵥ* D) j = ∑ i, c i * D (e i) j := by
  simp only [Matrix.vecMul, dotProduct, embedCoefficients, Finset.sum_mul]
  rw [Finset.sum_comm]
  simp only [ite_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]

theorem embedCoefficients_recover (e : ι ↪ Fin n) (c : Fin n → ℝ)
    (hc : ∀ j, j ∉ Set.range e → c j = 0) :
    embedCoefficients e (fun i => c (e i)) = c := by
  funext j
  by_cases hj : j ∈ Set.range e
  · obtain ⟨i, rfl⟩ := hj
    exact embedCoefficients_apply e _ i
  · rw [embedCoefficients_eq_zero e _ j hj, hc j hj]

end ObjectiveCompression
end


/- Inlined checked module: IndependentCoefficientTransport -/
section
set_option autoImplicit false

open scoped BigOperators
open Matrix

namespace ObjectiveCompression

/-- Sign-equivalent objectives have coordinates of the same signs in every independent
0/±1 row family, including the assertion that both lie in its span. -/
theorem independent_coefficient_transport {ι : Type*} [Fintype ι] {n : ℕ}
    (C : Matrix ι (Fin n) ℤ) (hC : ∀ i j, |C i j| ≤ 1)
    (hli : LinearIndependent ℝ (fun i j => (C i j : ℝ)))
    (w w' : Fin n → ℝ) (hs : SameSmallSigns n w w')
    (c : ι → ℝ) (hw : ∀ j, w j = ∑ i, c i * (C i j : ℝ)) :
    ∃ c' : ι → ℝ, (∀ j, w' j = ∑ i, c' i * (C i j : ℝ)) ∧
      ∀ i, SignType.sign (c i) = SignType.sign (c' i) := by
  classical
  obtain ⟨D, hD, hdet, e, he⟩ := exists_bounded_basis_extension C hC hli
  have hrep : embedCoefficients e c ᵥ* D.map (Int.castRingHom ℝ) = w := by
    funext j
    rw [embedCoefficients_vecMul]
    simp only [Matrix.map_apply, he]
    change (∑ i, c i * (C i j : ℝ)) = w j
    exact (hw j).symm
  have hcoord : squareCoordinates D w = embedCoefficients e c := by
    rw [← hrep]
    exact squareCoordinates_vecMul D hdet _
  let cnew := squareCoordinates D w'
  have hzero (j : Fin n) (hj : j ∉ Set.range e) : cnew j = 0 := by
    have h := squareCoordinates_sign_eq D hD w w' hs j
    rw [hcoord, embedCoefficients_eq_zero e c j hj, sign_zero] at h
    exact sign_eq_zero_iff.mp h.symm
  have hreconstruct := squareCoordinates_reconstruct D hdet w'
  have hlift : embedCoefficients e (fun i => cnew (e i)) = cnew :=
    embedCoefficients_recover e cnew hzero
  refine ⟨fun i => cnew (e i), ?_, ?_⟩
  · intro j
    calc
      w' j = (cnew ᵥ* D.map (Int.castRingHom ℝ)) j := (congrFun hreconstruct j).symm
      _ = ∑ i, cnew (e i) * (C i j : ℝ) := by
        rw [← hlift, embedCoefficients_vecMul]
        simp only [Matrix.map_apply, he, embedCoefficients_apply]
        rfl
  · intro i
    have h := squareCoordinates_sign_eq D hD w w' hs (e i)
    rw [hcoord, embedCoefficients_apply] at h
    exact h

end ObjectiveCompression
end


/- Inlined checked module: RowCone -/
section
set_option autoImplicit false

open scoped BigOperators
open Matrix

namespace ObjectiveCompression

def RowCone {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ) (w : Fin n → ℝ) : Prop :=
  ∃ c : Fin m → ℝ, (∀ i, 0 ≤ c i) ∧ ∀ j, w j = ∑ i, c i * (A i j : ℝ)

theorem SameSmallSigns.symm {n : ℕ} {w w' : Fin n → ℝ} (h : SameSmallSigns n w w') :
    SameSmallSigns n w' w := fun v hv => (h v hv).symm

theorem rowCone_transport {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (hA : ∀ i j, |A i j| ≤ 1) (w w' : Fin n → ℝ) (hs : SameSmallSigns n w w')
    (hw : RowCone A w) : RowCone A w' := by
  classical
  obtain ⟨c, hc, hwc⟩ := hw
  let v : Fin m → Fin n → ℝ := fun i j => (A i j : ℝ)
  have hsum : ∑ i, c i • v i = w := by
    funext j
    simpa [v] using (hwc j).symm
  obtain ⟨d, hd, hdsum, hli⟩ := FGCone.exists_linearIndepOn_repr v
    {i | c i ≠ 0}.toFinset.card c hc le_rfl
  have hdsum' : ∑ i, d i • v i = w := hdsum.trans hsum
  let S := {i : Fin m | d i ≠ 0}
  let e : S ↪ Fin m := ⟨Subtype.val, Subtype.val_injective⟩
  have hemb : embedCoefficients e (fun i => d i.1) = d := by
    apply embedCoefficients_recover e d
    intro j hj
    by_contra hn
    exact hj ⟨⟨j, hn⟩, rfl⟩
  have hwS (j : Fin n) : w j = ∑ i : S, d i.1 * (A i.1 j : ℝ) := by
    have h : (d ᵥ* A.map (Int.castRingHom ℝ)) j = w j := by
      simpa [v, Matrix.vecMul, dotProduct, mul_comm] using congrFun hdsum' j
    rw [← hemb, embedCoefficients_vecMul] at h
    exact h.symm
  obtain ⟨d', hwd', hsign⟩ := independent_coefficient_transport
    (fun (i : S) j => A i.1 j) (fun i j => hA i.1 j) hli w w' hs
    (fun i => d i.1) hwS
  have hd' (i : S) : 0 ≤ d' i := by
    apply sign_nonneg_iff.mp
    rw [← hsign i]
    exact sign_nonneg_iff.mpr (hd i.1)
  refine ⟨embedCoefficients e d', ?_, ?_⟩
  · intro j
    apply Finset.sum_nonneg
    intro i _
    split_ifs
    · exact hd' i
    · exact le_rfl
  · intro j
    have h := embedCoefficients_vecMul e d' (A.map (Int.castRingHom ℝ)) j
    change (∑ i, embedCoefficients e d' i * (A i j : ℝ)) =
      (∑ i : S, d' i * (A i.1 j : ℝ)) at h
    exact (hwd' j).trans h.symm

theorem rowCone_iff_of_sameSmallSigns {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (hA : ∀ i j, |A i j| ≤ 1) (w w' : Fin n → ℝ) (hs : SameSmallSigns n w w') :
    RowCone A w ↔ RowCone A w' :=
  ⟨rowCone_transport A hA w w' hs, rowCone_transport A hA w' w hs.symm⟩

end ObjectiveCompression
end


/- Inlined checked module: PositiveStep -/
section
set_option autoImplicit false

open Filter Topology

