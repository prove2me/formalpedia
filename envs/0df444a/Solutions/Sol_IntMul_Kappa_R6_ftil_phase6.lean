section
-- Source module: Solutions.KFMBig2
/-!
# KFM Big2: the interface calls of `bigE`

Every interface call is `callW bld X Y dS e` (KFMCall) with the descriptor builder `bld` (KFMSB,
KFMSF) on the builder stack `X = bX dS` and the scratch `Y = bY dS` (both differ from the
interface's descriptor stack `dS`). A run of the interface in its own table `kTable ext` is a run
in the merged table (`IRuns.relabel`).

* **`callW_I`**: the generic call in the merged table.
* **`lineA_phase`**, **`chirp_phase`**, **`lineB_phase`**, **`phiF_phase`**, **`phiB_phase`**:
  each call from a state with `BaseOK`, its output and its cost.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open AModel AModelL12 IntMul KIL KFB KFT RS IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.RC IntMul.OpenAI.Glue
  IntMul.OpenAI.RCost

noncomputable section

/-! ## Builder stacks -/

theorem bX_ne (dS : Fin HS) : bX dS ≠ dS := by
  unfold bX; split_ifs with h
  · subst h; decide
  · exact fun e => h e.symm

theorem bY_ne (dS : Fin HS) : bY dS ≠ dS := by
  unfold bY; split_ifs with h
  · subst h; decide
  · exact fun e => h e.symm

theorem bX_ne_bY (dS : Fin HS) : bX dS ≠ bY dS := by
  unfold bX bY; split_ifs <;> decide

theorem bX_ne0 (dS : Fin HS) : bX dS ≠ 0 := by unfold bX; split_ifs <;> decide

/-! ## The generic call -/

section Call

variable {P P' : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {iprog' : Fin P' → IStmt HS P'}
  {g : Fin P' → Fin P}

theorem callW_I (hprog : ∀ j, iprog (g j) = (iprog' j).ren id g) (bld : RS) {dS : Fin HS}
    (hd0 : dS ≠ 0) (e : Fin P') (t : IState HS) (data data' desc : List ℤ) (R0 : List Item)
    (h0 : t.G 0 = ints data ++ R0) (B : ℕ) (hB : ∀ x ∈ desc, zsz x ≤ B)
    (hok : bld.ok (t.upd (bX dS) (.mark :: t.G (bX dS))))
    (hrun : bld.run (t.upd (bX dS) (.mark :: t.G (bX dS))) =
      (t.upd (bX dS) (.mark :: t.G (bX dS))).upd (bX dS) (ints desc ++ .mark :: t.G (bX dS)))
