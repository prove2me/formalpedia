-- title:
--   Lemma 5 — Algorithm 2 converges linearly: $\mathbb E\|x_k - x^*\|_P \le \sqrt N(\tilde C + \tilde D)\tilde q^k$
-- statement:
--   Let Assumptions 1 and 2 hold, $\mu > 0$, $N \ge 1$, and let $x^*$ be a Nash equilibrium. Let $\{x_k\}$ be generated by Algorithm 2 under Assumption 3, from a starting point with $\|x_{i,0} - x_i^*\| \le C$ for all $i$. The inexactness is $\alpha_{i,k} = \eta^{\beta_{i,k}+1}$ for some $\eta \in (0,1)$, where $\beta_{i,k}$ is the number of updates of player $i$ before iteration $k$. Let $\tilde c = \max\{\tilde a, \tilde\eta\}$. Then for every $\tilde q \in (\tilde c, 1)$,
--   $$\mathbb E\big[\|x_k - x^*\|_P\big] \le \sqrt N\,(\tilde C + \tilde D)\,\tilde q^k \qquad \forall k \ge 0,$$
--   with $\|\cdot\|_P$ from (A.2), $D = 1/\ln((\tilde q/\tilde c)^e)$, $\tilde C = C\big(\sum_{i=1}^N N^{-1}p_i^{-1}\big)^{1/2}$ and $\tilde D = D\eta\tilde\eta^{-1}$.
--
--   This is the geometric rate of the randomized scheme. It reduces to Proposition 4 when every $p_i = 1$.
--
--   **Formalization Note** The starting point is deterministic, and the paper's $\mathbb E\|x_{i,0} - x_i^*\| \le C$ is read as $\|x_{i,0} - x_i^*\| \le C$. The proof's step $\|x_0 - x^*\|_P \le C(\sum_i p_i^{-1})^{1/2}$ needs this. The run is any run of the abstract scheme (`IsAlg2Run`) with $\alpha_{i,k} = \eta^{\beta_{i,k}+1}$.
-- source:
--   Lei, Shanbhag, Pang & Sen, On Synchronous, Asynchronous, and Randomized Best-Response Schemes for Stochastic Nash Games, arXiv:1704.04578v2, p. 15, Lemma 5 (proof: App. B, pp. 32–33)

import Mathlib
import Definitions.Def_LeiBR_Rand_Game
import Definitions.Def_LeiBR_Rand_ProxBR
import Definitions.Def_LeiBR_Rand_Assumption1
import Definitions.Def_LeiBR_Rand_SA
import Definitions.Def_LeiBR_Rand_Algorithm2
import Definitions.Def_LeiBR_Rand_Constants

open MeasureTheory ProbabilityTheory

namespace LeiBR.Rand

/-- Lemma 5 (geometric convergence), p. 15. Let `x_k` be generated by Algorithm 2 with
`α_{i,k} = η^{β_{i,k}+1}`, `η ∈ (0,1)`, and `‖x_{i,0} − x*_i‖ ≤ C`, under Assumptions 1–3. Then for
every `q̃ ∈ (c̃, 1)`, `c̃ = max{ã, η̃}`,
`E‖x_k − x*‖_P ≤ √N (C̃ + D̃) q̃^k` for all `k ≥ 0`. -/
theorem lemma_5 {N : ℕ} {n : Fin N → ℕ} {d : ℕ} (G : Game N n)
    (μξ : Measure (EuclideanSpace ℝ (Fin d)))
    (ψ : Fin N → LeiBR.Sync.Profile n → EuclideanSpace ℝ (Fin d) → ℝ)
    (gψ : ∀ i, LeiBR.Sync.Profile n → EuclideanSpace ℝ (Fin d) → LeiBR.Sync.Strat n i) (M : Fin N → ℝ)
    (hA1 : Assumption1 G μξ ψ gψ M) (mu : ℝ) (hmu : 0 < mu)
    (xhat : LeiBR.Sync.Profile n → LeiBR.Sync.Profile n) (hxhat : IsProxBR G mu xhat)
    (hA2 : Assumption2 G mu) (xstar : LeiBR.Sync.Profile n) (hNE : G.IsNE xstar) (hN : 0 < N)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (F : Filtration ℕ (inferInstance : MeasurableSpace Ω)) (p : Fin N → ℝ)
    (χ : Fin N → ℕ → Ω → ℕ) (w : ∀ i, ℕ → Ω → LeiBR.Sync.Strat n i) (x0 : LeiBR.Sync.Profile n)
    (x : ℕ → Ω → LeiBR.Sync.Profile n) (η : ℝ) (hη0 : 0 < η) (hη1 : η < 1)
    (C : ℝ) (hC : ∀ i, ‖x0 i - xstar i‖ ≤ C)
    (hrun : IsAlg2Run G xhat P F p χ w (fun i k ω => η ^ (beta χ i k ω + 1)) x0 x)
    (q : ℝ) (hq : ctil p (contrFactor G mu) η < q) (hq1 : q < 1) (k : ℕ) :
    ∫ ω, wnorm p (x k ω - xstar) ∂P ≤
      Real.sqrt N * (Ctil p C + Dtil p (contrFactor G mu) η q) * q ^ k := by sorry

end LeiBR.Rand
