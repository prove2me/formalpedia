  obtain ⟨𝒥, hJ⟩ := CerednikDrinfeld.exists_twoPlaceTorsionDatum_laws_classSet_of_squarefree_of_six_mul_dvd_of_neZero p hN hqN hq'N hqq' hqp hq'p D hD6
    hq5 hq'5
    A₁ hA₁ A₂ hA₂
