theorem brB_fsp (s : IState HS) (g : Fin HS → List ℤ) {L : NLogN.KFV.LP} {h k U : ℕ} (fl : List Bool)
    (H : GRegs s g L h) (hL : L.OK) (hiR : RV s g NLogN.KFV.gI k)
    (hgT : g NLogN.KFV.gT = []) (hg2 : g gT2 = []) {op : Bool} {Q : ℕ}
    (hoR : RV s g NLogN.KFV.gV (opV op)) (hqR : RV s g tbQ Q) (hQU : Q ≤ U) (hQl : 2 ^ L.ℓ ≤ 2 * Q)
    (hk : k < L.D) {lG : List ℤ} (hG : g gLG = fv (fl.getD k false) :: lG)
    {lR : List ℤ} (hR : g gRk = (rk fl k : ℤ) :: lR) (hfl : fl.count true ≤ L.n)
    (hhl : h + 1 ≤ L.ℓ) (hnU : L.n ≤ U) (h2l : 2 ^ L.ℓ ≤ U) {m : ℕ} {lm : List ℤ}
    (hM : g tbM = (m : ℤ) :: lm) (hmU : m + h ≤ U) :
    FSp NLogN.KFV.brB (NLogN.KIL.encK s g)
      (NLogN.KIL.encK s (Function.update (pushT g (NLogN.KFV.axG L fl op Q h k)) tbM
        (((m + (NLogN.KFV.axG L fl op Q h k).length : ℕ) : ℤ) :: lm)))
      (NLogN.KFV.cBr h (zsz (U : ℤ))) := by
  set B := zsz (U : ℤ)
  have z : ∀ x : ℤ, -(U : ℤ) ≤ x → x ≤ U → zsz x ≤ B := fun x h1 h2 => NLogN.KFV.zB (by omega)
  have hlU : L.ℓ ≤ U := le_trans (Nat.lt_two_pow_self).le h2l
  have hU1 : 1 ≤ U := le_trans Nat.one_le_two_pow h2l
  have hc : eTop.Clean := clean_lo (by decide)
  have ho : eTop.ok (NLogN.KIL.encK s g) := ⟨⟨H.h.isInt, trivial⟩, H.l.isInt⟩
  have hB : eTop.Bnd (NLogN.KIL.encK s g) B :=
    ⟨⟨by simp only [Ex.Bnd, H.h.top]; exact z _ (by omega) (by omega),
      by simp only [Ex.Bnd]; exact z _ (by omega) (by omega),
      by simp only [Ex.eval, H.h.top]; exact z _ (by omega) (by omega)⟩,
      by simp only [Ex.Bnd, H.l.top]; exact z _ (by omega) (by omega),
      by simp only [Ex.eval, H.h.top, H.l.top]; exact z _ (by omega) (by omega)⟩
  have hev : eTop.eval (NLogN.KIL.encK s g) = (h : ℤ) + 1 - L.ℓ := by
    simp only [eTop, Ex.eval, H.h.top, H.l.top]; ring
  have hsz := posE_size
  have hcB : ∀ c, c ≤ cAX 100 h B → (eTop.size + 1) * 2000 * (B + 2) + (2 * B + 2) + 25 + c ≤
      NLogN.KFV.cBr h B := fun c hc => by simp only [NLogN.KFV.cBr, eTop, Ex.size]; omega
  by_cases hT : h + 1 < L.ℓ
  · have hax : NLogN.KFV.axG L fl op Q h k = axTr L op Q h k (posF L k h) := by unfold NLogN.KFV.axG; rw [if_pos hT]
    rw [hax]
    have tR : RV s g gH h := H.h
    have hp := posF_lt hL hk (show h + 2 ≤ L.ℓ by omega)
    have A := AX_fsp s g (posE NLogN.KFV.gI gH) (clean_posE NLogN.KFV.gI gH (by decide) (by decide))
      (posE_ok H hL hiR tR hk (by omega)) (posE_bnd H hL hiR tR hk (by omega) hnU)
      (posE_eval H hL hiR tR hk (by omega)) H hL hiR hgT hg2 hoR hqR hQU hQl hk hp hhl hnU h2l
      hM (by omega)
    rw [axTr_length]
    refine (FSp.iteT hc ho (by simp [eTop, Ex.Lin]) hB (by rw [hev]; omega) A).mono (hcB _ ?_)
    simp only [cAX]; nlinarith
  · have hF : ¬ eTop.eval (NLogN.KIL.encK s g) < 0 := by rw [hev]; omega
    have tG := top_encK (s := s) hG
    have hcG : (Ex.reg gLG : Ex HS).Clean := clean_reg (by decide)
    have hoG : (Ex.reg gLG : Ex HS).ok (NLogN.KIL.encK s g) := isInt_encK hG
    have hBG : (Ex.reg gLG : Ex HS).Bnd (NLogN.KIL.encK s g) B := by
      simp only [Ex.Bnd, tG, fv]; split_ifs <;> exact z _ (by omega) (by omega)
    by_cases hl : fl.getD k false = true
    · have hax : NLogN.KFV.axG L fl op Q h k = axTr L op Q h k (rk fl k) := by
        unfold NLogN.KFV.axG; rw [if_neg hT, if_pos hl]
      rw [hax]
      have hr := rk_lt_count hl
      have A := AX_fsp s g (.reg gRk) (clean_reg (by decide)) (isInt_encK hR)
        (by simp only [Ex.Bnd, top_encK hR]; exact z _ (by omega) (by omega)) (top_encK hR)
        H hL hiR hgT hg2 hoR hqR hQU hQl hk (by omega) hhl hnU h2l hM (by omega)
      rw [axTr_length]
      have A2 := FSp.iteT (b := .skip) hcG hoG (by simp [Ex.Lin]) hBG
        (by show (NLogN.KIL.encK s g).top gLG < 0; rw [tG, hl]; simp [fv]) A
      refine (FSp.iteF hc ho (by simp [eTop, Ex.Lin]) hB hF A2).mono (hcB _ ?_)
      have hB2 : zsz (U : ℤ) + 2 ≤ (zsz (U : ℤ) + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
      simp only [cAX, Ex.size, B]; generalize (zsz (U : ℤ) + 2) ^ 2 = Y at *; omega
    · have hax : NLogN.KFV.axG L fl op Q h k = [] := by unfold NLogN.KFV.axG; rw [if_neg hT, if_neg hl]
      rw [hax, pushT_nil, List.length_nil, Nat.add_zero, ← hM, Function.update_eq_self]
      have A2 := FSp.iteF (a := AX (.reg gRk)) hcG hoG (by simp [Ex.Lin]) hBG
        (by show ¬ (NLogN.KIL.encK s g).top gLG < 0; rw [Bool.not_eq_true] at hl; rw [tG, hl]; simp [fv])
        (FSp.skip _)
      refine (FSp.iteF hc ho (by simp [eTop, Ex.Lin]) hB hF A2).mono (hcB _ ?_)
      have hB2 : zsz (U : ℤ) + 2 ≤ (zsz (U : ℤ) + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
      simp only [cAX, Ex.size, B]; generalize (zsz (U : ℤ) + 2) ^ 2 = Y at *; omega

theorem genL_succ (L : NLogN.KFV.LP) (fl : List Bool) (op : Bool) (Q h k : ℕ) :
    genL L fl op Q h (k + 1) = genL L fl op Q h k ++ NLogN.KFV.axG L fl op Q h k := by
  simp [genL, List.range_succ, List.flatMap_append]

theorem genL_length_le (L : NLogN.KFV.LP) (fl : List Bool) (op : Bool) (Q h k : ℕ) :
    (genL L fl op Q h k).length ≤ k * h := by
  induction k with
  | zero => simp [genL]
  | succ k ih =>
    rw [genL_succ, List.length_append]
    have := axG_length_le L fl op Q h k
    rw [Nat.succ_mul]; omega

theorem rk_succ {fl : List Bool} {k : ℕ} (hk : k < fl.length) :
    (rk fl (k + 1) : ℤ) = rk fl k - fv (fl.getD k false) := by
  unfold rk fv
  rw [List.take_add_one, List.getElem?_eq_getElem hk, List.getD_eq_getElem _ _ hk]
  simp only [Option.toList_some, List.count_append, List.count_singleton]
  split_ifs <;> simp_all

theorem axF_other (g : Fin HS → List ℤ) (L : NLogN.KFV.LP) (fl : List Bool) (op : Bool) (Q h m0 : ℕ)
    (lm rG rG2 : List ℤ) (k : ℕ) (x : Fin HS) (h1 : x ≠ tbC) (h2 : x ≠ tbK) (h3 : x ≠ tbL)
    (h4 : x ≠ tbM) (h5 : x ≠ gLG) (h6 : x ≠ gLG2) (h7 : x ≠ gRk) :
    NLogN.KFV.axF g L fl op Q h m0 lm rG rG2 k x = g x := by
  simp only [NLogN.KFV.axF, Function.update_apply, h4, h5, h6, h7, if_false]
  exact pushT_other _ _ _ h1 h2 h3

set_option maxHeartbeats 4000000 in
theorem axB_fsp (s : IState HS) (g : Fin HS → List ℤ) {L : NLogN.KFV.LP} {h U : ℕ} (fl : List Bool)
    (H : GRegs s g L h) (hL : L.OK)
    (hgT : g NLogN.KFV.gT = []) (hg2 : g gT2 = []) {op : Bool} {Q : ℕ}
    (hoR : RV s g NLogN.KFV.gV (opV op)) (hqR : RV s g tbQ Q) (hQU : Q ≤ U) (hQl : 2 ^ L.ℓ ≤ 2 * Q)
    (hfl : fl.length = L.D) (hcnt : fl.count true ≤ L.n) (hDU : L.D ≤ U)
    (hhl : h + 1 ≤ L.ℓ) (hnU : L.n ≤ U) (h2l : 2 ^ L.ℓ ≤ U) {m0 : ℕ} {lm rG rG2 : List ℤ}
    (hmU : m0 + L.D * h ≤ U) {k : ℕ} (hk : k < L.D) (cv : List ℤ) :
    FSp NLogN.KFV.axB (NLogN.KIL.encK s (Function.update (Function.update (NLogN.KFV.axF g L fl op Q h m0 lm rG rG2 k) NLogN.KFV.gI
        [(k : ℤ)]) NLogN.KFV.gA cv))
      (NLogN.KIL.encK s (Function.update (Function.update (NLogN.KFV.axF g L fl op Q h m0 lm rG rG2 (k + 1)) NLogN.KFV.gI
        [((k + 1 : ℕ) : ℤ)]) NLogN.KFV.gA cv))
      (cAxB h (zsz (U : ℤ))) := by
  set B := zsz (U : ℤ)
  have z : ∀ x : ℤ, -(U : ℤ) ≤ x → x ≤ U → zsz x ≤ B := fun x h1 h2 => NLogN.KFV.zB (by omega)
  have hU1 : 1 ≤ U := le_trans Nat.one_le_two_pow h2l
  set F := NLogN.KFV.axF g L fl op Q h m0 lm rG rG2
  set g1 := Function.update (Function.update (F k) NLogN.KFV.gI [(k : ℤ)]) NLogN.KFV.gA cv
  have e0 : ∀ x : Fin HS, x ≠ tbC → x ≠ tbK → x ≠ tbL → x ≠ tbM → x ≠ gLG → x ≠ gLG2 → x ≠ gRk →
      x ≠ NLogN.KFV.gA → x ≠ NLogN.KFV.gI → g1 x = g x := fun x a b c d e f i j l => by
    simp only [g1, Function.update_apply, j, l, if_false]
    exact axF_other _ _ _ _ _ _ _ _ _ _ _ _ a b c d e f i
  have H1 : GRegs s g1 L h := H.congr fun r hr => by
    obtain ⟨_, a, b, c, _⟩ := gIn_ne hr; obtain ⟨d, e, f, i, l, j, _⟩ := gIn_ne2 hr
    exact e0 r a b c j d e f i l
  have hdrop : fl.drop k = fl.getD k false :: fl.drop (k + 1) := by
    rw [List.drop_eq_getElem_cons (by omega), List.getD_eq_getElem _ _ (by omega)]
  have hG1 : g1 gLG = fv (fl.getD k false) :: ((fl.drop (k + 1)).map fv ++ rG) := by
    simp +decide [g1, F, NLogN.KFV.axF, Function.update_apply, hdrop]
  have hR1 : g1 gRk = (rk fl k : ℤ) :: [] := by simp +decide [g1, F, NLogN.KFV.axF]
  have hM1 : g1 tbM = (((m0 + (genL L fl op Q h k).length : ℕ) : ℤ)) :: lm := by
    simp +decide [g1, F, NLogN.KFV.axF]
  have hgl := genL_length_le L fl op Q h k
  have hkh : k * h + h ≤ L.D * h := by rw [← Nat.succ_mul]; exact Nat.mul_le_mul_right _ hk
  have E : ∀ x : Fin HS, x ∈ [NLogN.KFV.gT, gT2, NLogN.KFV.gV, tbQ] → g1 x = g x := by
    intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl <;>
      exact e0 _ (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
        (by decide) (by decide)
  have S2 := NLogN.KFV.brB_fsp s g1 fl (op := op) (U := U) H1 hL (RV.of_list (l := []) (by simp +decide [g1]))
    ((E NLogN.KFV.gT (by decide)).trans hgT) ((E gT2 (by decide)).trans hg2) (hoR.congr (E NLogN.KFV.gV (by decide)))
    (hqR.congr (E tbQ (by decide))) hQU hQl hk hG1
    hR1 hcnt hhl hnU h2l hM1 (by omega)
  set a := NLogN.KFV.axG L fl op Q h k
  set g2 := Function.update (pushT g1 a) tbM
    (((m0 + (genL L fl op Q h k).length + a.length : ℕ) : ℤ) :: lm)
  have hR2 : g2 gRk = (rk fl k : ℤ) :: [] := by
    simp only [g2]; rw [Function.update_of_ne (by decide), pushT_other _ _ _ (by decide) (by decide)
      (by decide)]; exact hR1
  have hG2 : g2 gLG = fv (fl.getD k false) :: ((fl.drop (k + 1)).map fv ++ rG) := by
    simp only [g2]; rw [Function.update_of_ne (by decide), pushT_other _ _ _ (by decide) (by decide)
