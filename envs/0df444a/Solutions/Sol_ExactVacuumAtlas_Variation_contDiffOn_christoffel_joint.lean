variable {n : ℕ}
theorem solution {g ginv : ℝ → Metric n} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hg : ∀ i j, ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => g p.1 i j p.2) W)
    (hgi : ∀ i j, ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => ginv p.1 i j p.2) W) (a b c : Fin n) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => christoffel (g p.1) (ginv p.1) a b c p.2) W := by
  unfold christoffel
  apply ContDiffOn.div_const
  apply ContDiffOn.sum
  intro k _
  exact (hgi a k).mul (((contDiffOn_pd_joint (Φ := fun ε => g ε k b) hW (hg k b) c).add
    (contDiffOn_pd_joint (Φ := fun ε => g ε k c) hW (hg k c) b)).sub
    (contDiffOn_pd_joint (Φ := fun ε => g ε b c) hW (hg b c) k))
