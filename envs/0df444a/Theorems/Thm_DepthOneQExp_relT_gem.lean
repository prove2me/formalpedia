-- name    : DepthOneQExp.relT_gem
-- status  : Open
-- author  : @Shuze Chen
-- created : 2026-11-24T06:55:47.271496+00:00
-- url     : https://prove2.me/theorems/e46551b1-c93a-4c34-85aa-e9caca0368d1
-- title:
--   Relative property (T): GEMs move an $\varepsilon$-invariant vector by $\le 18\varepsilon$
-- statement:
--   Let $s\ge1$, $R=\mathrm{Mat}(s;\mathbb F_2)$, and view $\mathrm{SL}(3s;\mathbb F_2)=\mathrm{EL}(3;R)$ through $3\times3$ block matrices; $E_{a,b}(r)$ is the identity plus the block $r$ in position $(a,b)$. Let $\rho$ be a finite-dimensional unitary representation of $\mathrm{SL}(3s;\mathbb F_2)$, $v$ a vector and $\varepsilon\ge0$ such that every element of Kassabov's generating family $\Sigma_{3s}$ moves $v$ by at most $\varepsilon$:
--
--   $$
--   \|\rho(\sigma_i)v-v\|\le\varepsilon\qquad(1\le i\le14).
--   $$
--
--   Then for all $r_1,r_2\in R$ the four kinds of generalized elementary matrices (GEMs)
--
--   1. $E_{1,3}(r_1)E_{2,3}(r_2)$ (third block column),
--   2. $E_{2,1}(r_1)E_{3,1}(r_2)$ (first block column),
--   3. $E_{1,2}(r_1)E_{1,3}(r_2)$ (first block row),
--   4. $E_{3,1}(r_1)E_{3,2}(r_2)$ (third block row)
--
--   each move $v$ by at most $18\,\varepsilon$.
--
--   This is the relative property (T) of the pairs $(\mathrm{EL}_2(R)\ltimes R^2,R^2)$ embedded in $\mathrm{EL}_3(R)$ (Kassabov, Theorem 2.2 and Corollary 2.8). Over a ring of characteristic $2$ generated by two elements ($A$ and $B$) the constant improves to $2M=18$.
--
--   **Formalization Note** Blocks are $0$-based: `blockElem s a b r` is $E_{a+1,b+1}(r)$. The GEMs are products of two elements of `SL` built from `blockElem`.
-- source:
--   M. Kassabov, Universal lattices and unbounded rank expanders, Invent. Math. 170 (2007), arXiv:math/0502237, Theorem 2.2, Corollary 2.8 and Lemma 1.1(a) (relative property T for EL_2(R) x R^2); characteristic-2 specialization of Lemma 2.7 with ring generators A, B of Fact 2.9 in arXiv:2609.01605

import Mathlib
import Definitions.Def_ConstGapCircuits_spectralGap
import Definitions.Def_DepthOneQExp_blockElem
import Definitions.Def_DepthOneQExp_sigma

namespace DepthOneQExp

/-- Relative property (T) for the generalized elementary matrices of `EL₃(Mat(s; 𝔽₂))`
(Kassabov, arXiv:math/0502237, Lemma 1.1(a) / Corollary 2.8, with the characteristic-two
constant `2M = 18`): if every generator of `Σ_{3s}` moves `v` by at most `ε`, then each GEM
`E₁₃(r₁)E₂₃(r₂)`, `E₂₁(r₁)E₃₁(r₂)`, `E₁₂(r₁)E₁₃(r₂)`, `E₃₁(r₁)E₃₂(r₂)` moves `v` by at most `18 ε`.

**Formalization Note** Blocks are 0-based (`blockElem s a b r` is `E_{a+1,b+1}(r)`). -/

theorem relT_gem (s : ℕ) (hs : 1 ≤ s)
    (ρ : ConstGapCircuits.UnitaryRep (Matrix.SpecialLinearGroup (Fin (3 * s)) (ZMod 2)))
    (v : EuclideanSpace ℂ (Fin ρ.dim)) (ε : ℝ) (hε : 0 ≤ ε)
    (hv : ∀ i : Fin 14, ‖Matrix.toEuclideanCLM (𝕜 := ℂ) (ρ.hom (sigma s i) : Matrix (Fin ρ.dim) (Fin ρ.dim) ℂ) v - v‖ ≤ ε)
    (r₁ r₂ : Matrix (Fin s) (Fin s) (ZMod 2)) :
    ‖Matrix.toEuclideanCLM (𝕜 := ℂ) (ρ.hom ((show Matrix.SpecialLinearGroup (Fin (3 * s)) (ZMod 2) from ⟨blockElem s 0 2 r₁, det_blockElem s (by decide) r₁⟩) * (show Matrix.SpecialLinearGroup (Fin (3 * s)) (ZMod 2) from ⟨blockElem s 1 2 r₂, det_blockElem s (by decide) r₂⟩)) : Matrix (Fin ρ.dim) (Fin ρ.dim) ℂ) v - v‖ ≤ 18 * ε ∧
    ‖Matrix.toEuclideanCLM (𝕜 := ℂ) (ρ.hom ((show Matrix.SpecialLinearGroup (Fin (3 * s)) (ZMod 2) from ⟨blockElem s 1 0 r₁, det_blockElem s (by decide) r₁⟩) * (show Matrix.SpecialLinearGroup (Fin (3 * s)) (ZMod 2) from ⟨blockElem s 2 0 r₂, det_blockElem s (by decide) r₂⟩)) : Matrix (Fin ρ.dim) (Fin ρ.dim) ℂ) v - v‖ ≤ 18 * ε ∧
    ‖Matrix.toEuclideanCLM (𝕜 := ℂ) (ρ.hom ((show Matrix.SpecialLinearGroup (Fin (3 * s)) (ZMod 2) from ⟨blockElem s 0 1 r₁, det_blockElem s (by decide) r₁⟩) * (show Matrix.SpecialLinearGroup (Fin (3 * s)) (ZMod 2) from ⟨blockElem s 0 2 r₂, det_blockElem s (by decide) r₂⟩)) : Matrix (Fin ρ.dim) (Fin ρ.dim) ℂ) v - v‖ ≤ 18 * ε ∧
    ‖Matrix.toEuclideanCLM (𝕜 := ℂ) (ρ.hom ((show Matrix.SpecialLinearGroup (Fin (3 * s)) (ZMod 2) from ⟨blockElem s 2 0 r₁, det_blockElem s (by decide) r₁⟩) * (show Matrix.SpecialLinearGroup (Fin (3 * s)) (ZMod 2) from ⟨blockElem s 2 1 r₂, det_blockElem s (by decide) r₂⟩)) : Matrix (Fin ρ.dim) (Fin ρ.dim) ℂ) v - v‖ ≤ 18 * ε := by sorry

end DepthOneQExp
