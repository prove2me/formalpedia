    simp only [Ex.eval, top_RF (show (29 : Fin HS) ∈ rg by decide)]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]
    simp only [zr, h29]; rw [if_neg (by decide)]; ring
