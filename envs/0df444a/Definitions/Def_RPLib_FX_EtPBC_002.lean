-- ===== S4.Def_RP_EtPBC_A_CovSj =====
section

/-!
# S4-EtPBC-A, R4-T2 (G1e): making the lifted cover surjective

For a finite etale `ρ : U ⟶ Y'` the range is clopen; `ρs ρ : U ⨿ Z ⟶ Y'` with `Z` the complement of the range is
finite and surjective. If `m : S ⟶ Y'` has range inside the range of `ρ`, every lift `pullback ρ m ⟶ T` over `S`
extends to `pullback (ρs ρ) m ⟶ T` (**`exists_surj_ext`**). For the lifted charts, `range_yxL`: the range of
`yxL L` lies in the range of `(dL L).toBase` when `q` is surjective; **`exists_surj_L`**.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite TopologicalSpace
open scoped TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open RamanujanPetersson.EtPBC.Z3

universe u

section Surj

variable {U Y' : Scheme.{u}} (ρ : U ⟶ Y') [IsFinite ρ] [Etale ρ]

/-- **The range of a finite etale morphism is clopen.** -/
theorem isClopen_range_fe : IsClopen (Set.range ρ) :=
  ⟨ρ.isClosedMap.isClosed_range, ρ.isOpenMap.isOpen_range⟩

/-- The complement of the range of `ρ`. -/
def Zc : Y'.Opens := ⟨(Set.range ρ)ᶜ, (isClopen_range_fe ρ).1.isOpen_compl⟩

instance isClosedImmersion_Zc : IsClosedImmersion (Zc ρ).ι where
  toSurjectiveOnStalks := inferInstance
  isClosedEmbedding := ⟨(Zc ρ).ι.isOpenEmbedding.isEmbedding, by
    rw [Scheme.Opens.range_ι]
    exact (isClopen_range_fe ρ).2.isClosed_compl⟩

/-- **The surjectified cover** `U ⨿ Z ⟶ Y'`. -/
abbrev ρs : U ⨿ (Zc ρ).toScheme ⟶ Y' := coprod.desc ρ (Zc ρ).ι

theorem surj_ρs : Function.Surjective (ρs ρ) := by
  intro y
  by_cases h : y ∈ Set.range ρ
  · obtain ⟨u, rfl⟩ := h
    exact ⟨(coprod.inl : U ⟶ U ⨿ (Zc ρ).toScheme) u, by rw [← Scheme.Hom.comp_apply, coprod.inl_desc]⟩
  · refine ⟨(coprod.inr : (Zc ρ).toScheme ⟶ U ⨿ (Zc ρ).toScheme) (⟨y, h⟩ : Zc ρ), ?_⟩
    have e := Scheme.Hom.comp_apply (coprod.inr : (Zc ρ).toScheme ⟶ U ⨿ (Zc ρ).toScheme) (ρs ρ) (⟨y, h⟩ : Zc ρ)
    rw [coprod.inr_desc] at e
    exact e.symm

variable {S : Scheme.{u}} (m : S ⟶ Y') (hm : Set.range m ⊆ Set.range ρ)

include hm in
theorem range_fst_ρs :
    Set.range (pullback.fst (ρs ρ) m) ⊆ Set.range (coprod.inl : U ⟶ U ⨿ (Zc ρ).toScheme) := by
  rintro _ ⟨z, rfl⟩
  by_contra hz
  have h2 : pullback.fst (ρs ρ) m z ∈ Set.range (coprod.inr : (Zc ρ).toScheme ⟶ U ⨿ (Zc ρ).toScheme) := by
    rw [← (isCompl_range_inl_inr U (Zc ρ).toScheme).compl_eq]
    exact hz
  obtain ⟨w, hw⟩ := h2
  have e1 : (ρs ρ) (pullback.fst (ρs ρ) m z) = m (pullback.snd (ρs ρ) m z) := by
    rw [← Scheme.Hom.comp_apply, pullback.condition, Scheme.Hom.comp_apply]
  rw [← hw, ← Scheme.Hom.comp_apply, coprod.inr_desc] at e1
  have h3 : (Zc ρ).ι w ∈ Set.range ρ := by
    rw [e1]
    exact hm ⟨_, rfl⟩
  exact w.2 h3

/-- The factorization of `pullback (ρs ρ) m ⟶ U ⨿ Z` through `U`. -/
def liftU : pullback (ρs ρ) m ⟶ U :=
  IsOpenImmersion.lift coprod.inl (pullback.fst (ρs ρ) m) (range_fst_ρs ρ m hm)

theorem liftU_inl : liftU ρ m hm ≫ coprod.inl = pullback.fst (ρs ρ) m :=
  IsOpenImmersion.lift_fac _ _ _

theorem liftU_w : liftU ρ m hm ≫ ρ = pullback.snd (ρs ρ) m ≫ m := by
  calc liftU ρ m hm ≫ ρ = liftU ρ m hm ≫ coprod.inl ≫ ρs ρ :=
        (congrArg (liftU ρ m hm ≫ ·) (coprod.inl_desc ρ (Zc ρ).ι)).symm
    _ = pullback.fst (ρs ρ) m ≫ ρs ρ := by rw [← Category.assoc, liftU_inl]
    _ = pullback.snd (ρs ρ) m ≫ m := pullback.condition

/-- `pullback (ρs ρ) m ⟶ pullback ρ m`. -/
def toPb : pullback (ρs ρ) m ⟶ pullback ρ m :=
  pullback.lift (liftU ρ m hm) (pullback.snd _ _) (liftU_w ρ m hm)

theorem toPb_snd : toPb ρ m hm ≫ pullback.snd ρ m = pullback.snd (ρs ρ) m :=
  pullback.lift_snd _ _ _

include hm in
/-- **Surjectification of a finite etale cover with a lift over `m`.** -/
theorem exists_surj_ext {T : Scheme.{u}} (q : T ⟶ S) (ψ : pullback ρ m ⟶ T) (hψ : ψ ≫ q = pullback.snd ρ m) :
    ∃ (U' : Scheme.{u}) (ρ' : U' ⟶ Y'), IsFinite ρ' ∧ Function.Surjective ρ' ∧
      ∃ ψ' : pullback ρ' m ⟶ T, ψ' ≫ q = pullback.snd ρ' m :=
  ⟨_, ρs ρ, inferInstance, surj_ρs ρ, toPb ρ m hm ≫ ψ, by rw [Category.assoc, hψ, toPb_snd]⟩

end Surj

section Lifted

attribute [local instance] CoverLift.cR CoverLift.aR CoverLift.eR CoverLift.c₀ CoverLift.c₁ CoverLift.c₀₁ CoverLift.a₀ CoverLift.a₁ CoverLift.a₀₁ CoverLift.f₀ CoverLift.f₁ CoverLift.et₀ CoverLift.et₁

end Lifted

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_Inj0a =====
section

/-!
# S4-EtPBC-A, G1a: germs of a pulled-back section control the support

For `f : X ⟶ Y`, a geometric point `s` of `X`, a sheaf `G` on `Y`, `V : Y.Etale`, a fibre point `b` of `s` over
`f⁻¹ V` and `z ∈ G(V)`:
* `cpt f s b : V.left`, the point of `V` under `b`; `cpt_map` (naturality in `V`);
* **`comap_germ_eq_zero`**: if the germ of `η_G(z) ∈ (f^* G)(f⁻¹ V)` at `b` vanishes, so does the germ of `z` at `b`
  for the point `comapPt f s` of `Y` (Mathlib's stalk isomorphism `(f^* G)_s ≅ G_{s ≫ f}`, `comapIso_hom_app`);
* `exists_nbhd_of_comap_germ`: such a germ vanishes on an etale neighbourhood;
* **`cpt_not_mem_supp`**: then `cpt b` is not in the support `supp G z`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite GrothendieckTopology

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtCompact.Cech

universe u

variable {Λ : Type u} [CommRing Λ] {X Y : Scheme.{u}} (f : X ⟶ Y) (s : GeomPt X)

/-- The point of `V` under a fibre point of `s` over `f⁻¹ V`. -/
def cpt {V : Y.Etale} (b : s.point.fiber.obj ((etPull f).obj V)) : V.left :=
  pullback.fst V.hom f ((s.liftOf b).left (default : Spec (CommRingCat.of s.Ω)))

/-- A vanishing germ at `comapPt f s` vanishes on an etale neighbourhood. -/
theorem exists_nbhd_of_comap_germ (G : EtSh Λ Y) {V : Y.Etale} (b : (comapPt f s).fiber.obj V)
    (z : G.obj.obj (op V)) (h : ((comapPt f s).toPresheafFiber V b G.obj).hom z = 0) :
    ∃ (W : Y.Etale) (g : W ⟶ V) (b' : (comapPt f s).fiber.obj W),
      (comapPt f s).fiber.map g b' = b ∧ (G.obj.map g.op).hom z = 0 := by
  have h' : ((comapPt f s).toPresheafFiber V b G.obj).hom z =
      ((comapPt f s).toPresheafFiber V b G.obj).hom 0 := h.trans (map_zero _).symm
  obtain ⟨W, g, b', hb, hs⟩ := ((comapPt f s).toPresheafFiber_eq_iff' V b z 0).1 h'
  refine ⟨W, g, b', hb, ?_⟩
  have hs' : (G.obj.map g.op).hom z = (G.obj.map g.op).hom 0 := hs
  rw [hs', map_zero]

end RamanujanPetersson.EtPBC

end

end

-- ===== S4.Def_RP_EtPBC_A_StkRD =====
section

/-!
# S4-EtPBC-A, L1b: stalks of derived pushforwards

For `g : P ⟶ S`, a geometric point `s` of `S` and an injective resolution `I` of `F`, the stalk at `s`
of `R^q g_* F` is the fibre (a filtered colimit over the etale neighbourhoods `V` of `s`) of the presheaf
`V ↦ H^q(I^•(g⁻¹ V))` (`stalkRDIso`, `preHomologyObjIso`). Both the stalk functor and the presheaf fibre
functor are exact, so they commute with homology.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves

universe u

variable (Λ : Type u) [CommRing Λ] {P S : Scheme.{u}} (g : P ⟶ S)

/-- The complex of presheaves `V ↦ K(g⁻¹ V)` on `S`. -/
abbrev preCx (K : CochainComplex (EtSh Λ P) ℕ) :
    CochainComplex ((S.Etale)ᵒᵖ ⥤ ModuleCat.{u} Λ) ℕ :=
  ((push g Λ ⋙ sheafToPresheaf S.smallEtaleTopology (ModuleCat.{u} Λ)).mapHomologicalComplex
    (ComplexShape.up ℕ)).obj K

variable (s : GeomPt S)

instance : (s.point.presheafFiber (A := ModuleCat.{u} Λ)).PreservesHomology := by
  have : PreservesFiniteColimits (s.point.presheafFiber (A := ModuleCat.{u} Λ)) := inferInstance
  have : PreservesFiniteLimits (s.point.presheafFiber (A := ModuleCat.{u} Λ)) := inferInstance
  infer_instance

end RamanujanPetersson.EtPBC

end

end

-- ===== S4.Def_RP_EtPBC_A_SecCoc =====
section

/-!
# S4-EtPBC-A, L1c (part 1): cocycles of `I^•(W)` as `Ext` classes

For an injective resolution `I` of `F`, `W : X.Etale` and `p : ℕ`: `secSc Λ I W p` is the short complex `sc (p+1)` of
the complex of sections `I^•(W)`; `cocExtFun` sends a cocycle `z` (an element of `ker g`) to the class
`InjectiveResolution.extMk` of the map `Λ[W] ⟶ I^(p+1)` given by `z` (`freeEquiv`); it is additive (`cocExtFun_add`).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves

universe u

variable (Λ : Type u) [CommRing Λ] {X : Scheme.{u}} {F : EtSh Λ X} (I : InjectiveResolution F)

theorem extMk_congr {A : EtSh Λ X} {n : ℕ} {f f' : A ⟶ I.cocomplex.X n} (h : f = f') (m : ℕ)
    (hm : n + 1 = m) (hf : f ≫ I.cocomplex.d n m = 0) :
    I.extMk f m hm hf = I.extMk f' m hm (h ▸ hf) := by
  subst h; rfl

theorem up_next (p : ℕ) : p + 1 + 1 = (ComplexShape.up ℕ).next (p + 1) := (CochainComplex.next ℕ (p + 1)).symm

theorem up_prev (p : ℕ) : (ComplexShape.up ℕ).prev (p + 1) + 1 = p + 1 := by
  rw [CochainComplex.prev_nat_succ]

end RamanujanPetersson.EtPBC

end

end

-- ===== S4.Def_RP_EtPBC_A_Delta =====
section

/-!
# S4-EtPBC-A, L1e: the δ-functor lemma for base change maps on germs

Abstract setting: an exact functor `L : C ⥤ D` of abelian categories, `C` with enough injectives, a cofiltered
system `A : J ⥤ C` (the free sheaves `Λ[g⁻¹ V]` of the etale neighbourhoods `V` of a geometric point), an object
`B : D` (the unit sheaf of the fibre) and compatible maps `u j : B ⟶ L (A j)`. The base change map at `j` is
`bc j : Ext^q(A j, F) → Ext^q(B, L F)`, `α ↦ u j ∘ L α`, and `res a` restricts classes along `a : j' ⟶ j`.

**`injAt_all`**: if base change is injective on germs in degree `0` for all `F` (`InjAt 0`) and surjective on germs
in every degree for all `F` (`SurjAt q`), then it is injective on germs in every degree. The proof embeds `F` into
an injective object and uses the long exact `Ext` sequences, `Ext^(q+1)(-, I) = 0` and the compatibility of
`Ext.mapExactFunctor` with composition and extension classes.
-/

set_option autoImplicit false

open CategoryTheory Limits Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.Delta

universe w v₁ u₁ v₂ u₂ v₃ u₃

variable {C : Type u₁} [Category.{v₁} C] [Abelian C] [HasExt.{w} C]
  {D : Type u₂} [Category.{v₂} D] [Abelian D] [HasExt.{w} D]
  {J : Type u₃} [Category.{v₃} J]
  (L : C ⥤ D) [L.Additive] [PreservesFiniteLimits L] [PreservesFiniteColimits L]
  (A : J ⥤ C) (B : D) (u : ∀ j, B ⟶ L.obj (A.obj j))

/-- The base change map at `j`: `Ext^q(A j, F) → Ext^q(B, L F)`. -/
def bc (j : J) (F : C) (q : ℕ) : Ext (A.obj j) F q →+ Ext B (L.obj F) q where
  toFun α := (Ext.mk₀ (u j)).comp (α.mapExactFunctor L) (zero_add q)
  map_zero' := by rw [Ext.mapExactFunctor_zero, Ext.comp_zero]
  map_add' _ _ := by rw [Ext.mapExactFunctor_add, Ext.comp_add]

end RamanujanPetersson.EtPBC.Delta

end

end

