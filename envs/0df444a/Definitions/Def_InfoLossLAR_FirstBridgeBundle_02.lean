namespace Integration9_9.TM2NativeAffineApply
open AFT AFT.BinaryArithmetic
open OAI.MetricKMedian.Binary OAI.MetricKMedian.Binary.Automatic
open InfoLossLAR.WorstCase
open scoped BigOperators
abbrev Sample := List (List ℕ)×List ℕ
abbrev Affine := List (List ℤ)×List ℤ
abbrev Input := (ℕ×_root_.Integration9_9.TM2NativeAffineApply.Affine)×_root_.Integration9_9.TM2NativeAffineApply.Sample

def dot (x : List ℤ×List ℤ) : ℤ := ((x.1.zip x.2).map (fun p=>p.1*p.2)).sum
noncomputable def dotProgram : PolyProgram Automatic.enc Signed.encode _root_.Integration9_9.TM2NativeAffineApply.dot :=
  ((PolyProgram.listZipWith Signed.encode Signed.encode 0 0 PolyProgram.intMul).comp _root_.Integration9_9.TM2NativeEmitterCoordinates.sumProgram).congr _ (fun _=>rfl)
@[fun_prop] theorem dot_poly : Poly _root_.Integration9_9.TM2NativeAffineApply.dot := ⟨_root_.Integration9_9.TM2NativeAffineApply.dotProgram⟩

def column (x : List (List ℕ)×ℕ) : List ℤ := x.1.map (fun row=>((row[x.2]?.getD 0 : ℕ) : ℤ))
@[fun_prop] theorem column_poly : Poly _root_.Integration9_9.TM2NativeAffineApply.column := by unfold _root_.Integration9_9.TM2NativeAffineApply.column;fun_prop

def entry (x : (ℕ×(List ℤ×List (List ℕ)))×ℕ) : ℕ :=
  _root_.Integration9_9.TM2NativeBodyKernel.emodNatural (_root_.Integration9_9.TM2NativeAffineApply.dot (x.1.2.1,_root_.Integration9_9.TM2NativeAffineApply.column (x.1.2.2,x.2)),x.1.1)
@[fun_prop] theorem entry_poly : Poly _root_.Integration9_9.TM2NativeAffineApply.entry := by unfold _root_.Integration9_9.TM2NativeAffineApply.entry;fun_prop

def row (x : ℕ×(List ℤ×List (List ℕ))) : List ℕ :=
  (List.range (x.2.2[0]?.getD []).length).map (fun col=>_root_.Integration9_9.TM2NativeAffineApply.entry (x,col))
