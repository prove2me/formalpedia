def deltaSet (M₀ q : ℕ) : Finset ℕ :=
  (Finset.range (M₀ * q)).filter (fun d => Nat.Coprime d (M₀ * q) ∧ d ≡ 1 [MOD M₀])

def normGen (M₀ q : ℕ) : ModularCurve.HeckeAlgOne :=
  ∑ d ∈ deltaSet M₀ q, ModularCurve.diamondGen d

theorem mem_deltaSet {M₀ q d : ℕ} (hd : d ∈ deltaSet M₀ q) :
    Nat.Coprime d (M₀ * q) ∧ d ≡ 1 [MOD M₀] :=
  (Finset.mem_filter.1 hd).2

theorem one_mem_deltaSet {M₀ q : ℕ} [NeZero M₀] (hq : q.Prime) : 1 ∈ deltaSet M₀ q := by
  refine Finset.mem_filter.2 ⟨Finset.mem_range.2 ?_, Nat.coprime_one_left _, Nat.ModEq.refl 1⟩
  have h1 : 1 ≤ M₀ := Nat.pos_of_ne_zero (NeZero.ne M₀)
  calc 1 < 2 := one_lt_two
    _ ≤ M₀ * q := by nlinarith [hq.two_le]

theorem card_deltaSet_ne_zero {M₀ q : ℕ} [NeZero M₀] (hq : q.Prime) (K : Type) [Field K]
    [CharZero K] : ((deltaSet M₀ q).card : K) ≠ 0 :=
  Nat.cast_ne_zero.2 (Finset.card_pos.2 ⟨1, one_mem_deltaSet hq⟩).ne'

