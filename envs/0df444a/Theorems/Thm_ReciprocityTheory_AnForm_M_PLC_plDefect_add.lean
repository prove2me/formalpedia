variable {X : Type} [TopologicalSpace X]

theorem ReciprocityTheory.AnForm.M.PLC.plDefect_add [CompactSpace X] [T2Space X] (A : FinHolAtlas 1 X) (L : LocPot X)
    (s : X → X → ℂ) {r : ℕ} (m : Fin r → ℕ) (p : Fin r → X)
    (hL : IsPotential A L) (hs : IsSection A L s) (hsnc : IsSNC A L s m (fun k => {p k}))
    {f f' : X → ℝ} (hf : A.Smooth f) (hf' : A.Smooth f') :
    plDefect A L s m p (fun z => f z + f' z) = plDefect A L s m p f + plDefect A L s m p f' := by sorry
