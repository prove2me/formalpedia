-- title:
--   §2–§2.1, pp. 4–8 — densities, the dissipator L_a, the closed resource class Channel(S), Hörmander systems, transitivity, the range D_S(ρ), and the qubit operators |0⟩⟨1| ⊗ I, Z ⊗ I, E∞, R
-- statement:
--   This file fixes the model of §2 and §2.1 of the paper. The Hilbert space is finite-dimensional, $H=\mathbb C^{\iota}$ for a finite index set $\iota$, and operators are $\iota\times\iota$ complex matrices.
--
--   1. **Densities** (p. 4): $\mathcal D(H)=\{\rho:\rho=\rho^*,\ \rho\ge 0,\ \operatorname{tr}\rho=1\}$.
--   2. **Lindblad generator** of a jump operator $a$ (rule (JU), p. 5), with rate $2$:
--   $$L_a(\rho)=2a\rho a^*-a^*a\rho-\rho a^*a .$$
--   3. **Unitary channel** $\operatorname{Ad}_U(\rho)=U\rho U^*$.
--   4. **Hörmander system** (Definition 2.1, p. 5). For a resource set $S$, let $\mathfrak a(S)$ be the set of anti-Hermitian operators $X=iH$ in the complex span of $S$. $S$ is Hörmander if the real Lie algebra generated by $\mathfrak a(S)$ contains $\mathfrak{su}(d)=\{X: X^*=-X,\ \operatorname{tr}X=0\}$.
--   5. **The closed class** $\overline{\mathrm{Channel}(S)}$ (p. 5) is the smallest closed set $\mathcal C$ of superoperators such that:
--      - (UN) $\operatorname{Ad}_{e^{tX}}\in\mathcal C$ for every $X\in\mathfrak a(S)$ and $t\ge0$;
--      - (JU) $e^{tL_a}\in\mathcal C$ for every $a\in S$ and $t\ge 0$;
--      - (CO) $\Phi\circ\Psi\in\mathcal C$ whenever $\Phi,\Psi\in\mathcal C$.
--
--      It is the intersection of all closed sets with these three properties, so it satisfies (CL) as well.
--   6. **Transitivity** (Definitions 2.4–2.5, p. 6): a set $O$ of superoperators is transitive if for all densities $\rho,\sigma$ some $\Phi\in O$ has $\Phi(\rho)=\sigma$.
--   7. **Range** (Definition 2.9, p. 8): $D_S(\rho)=\{\Phi(\rho):\Phi\in\overline{\mathrm{Channel}(S)}\}$.
--   8. **Pinching** $\rho\mapsto\operatorname{diag}(\rho)$. On one qubit this is $E_\infty$ (p. 7), on $k$ qubits it is $E_\infty^{\otimes k}$.
--
--   For $k$ qubits, $H=\mathbb C^{2^k}$ has the computational basis indexed by bit strings $\omega\in\{0,1\}^k$. On qubit $i$ the file defines:
--   - $|0\rangle\langle 1|\otimes I$, which sends $|\omega\rangle$ with $\omega_i=1$ to the string with $\omega_i$ reset to $0$ and kills $|\omega\rangle$ with $\omega_i=0$;
--   - $Z\otimes I$ with $Z=\operatorname{diag}(1,-1)$;
--   - $E_\infty\otimes\mathrm{id}$, which deletes the entries off-diagonal in qubit $i$;
--   - $\mathcal R_{|0\rangle\langle0|}\otimes\mathrm{id}$, $\rho\mapsto|0\rangle\langle0|_i\otimes\operatorname{tr}_i\rho$.
--
--   It also defines the pure state $|0_k\rangle\langle0_k|$ and the replacer channel $\mathcal R_{|0_k\rangle\langle0_k|}(\rho)=\operatorname{tr}(\rho)\,|0_k\rangle\langle0_k|$ (p. 4).
--
--   These are the objects of Theorem 2.12 and of the lemmas its proof uses.
--
--   **Formalization Note**
--   - **Sign of (JU).** The page prints (JU) as $L_a(\rho)=a^*a\rho+\rho a^*a-2a\rho a^*$. Its exponential is not positive, and every computation of the paper uses the opposite, standard sign: the [CW16] display, $L_Z=4(E_\infty-\mathrm{id})$ (p. 8), $L_{a,b}$ (p. 9), Example 4.7. The standard sign is used here.
--   - **Hörmander reading.** Theorem 2.12 applies Definition 2.1 to a set $S=S^*$ that contains non-anti-Hermitian jumps. "Generates a Hörmander system" is therefore read on the anti-Hermitian part of $\operatorname{span}S$, which is what (UN) uses. It is stated as containment of $\mathfrak{su}(d)$, because the generated algebra may also contain $i\mathbb R\cdot I$, which acts trivially.
--   - **Carrier and topology.** Superoperators are continuous linear maps with the operator norm over the $L^2$-operator norm on matrices. In finite dimension every norm gives the same topology, so "closed" and the limits do not depend on this choice.
--   - **Indices.** Bit strings are `Fin k → Bool`, with `false` $=|0\rangle$ and the page's first qubit at index `0`.
-- source:
--   Cai, Govindarajan, Junge, How Far do Lindbladians Go?, arXiv:2504.04883v2, pp. 4–8, (UN), (JU), (CO), (CL), Definitions 2.1, 2.4, 2.5, 2.9, notation E∞ (p. 7), replacer channel R_σ (p. 4)

import Mathlib

namespace LindbladReach.MinDiss

open scoped Matrix ComplexOrder Matrix.Norms.L2Operator

attribute [local instance 100] LieRing.ofAssociativeRing

/-! ### General finite-dimensional objects (index type `ι`, `H = ℂ^ι`) -/

/-- Superoperators on `𝔹(ℂ^ι)`: continuous `ℂ`-linear maps of `ι × ι` complex matrices, with the
operator norm induced by the `L²`-operator norm on matrices (all norms give the same topology). -/
abbrev Superop (ι : Type) [Fintype ι] [DecidableEq ι] :=
  Matrix ι ι ℂ →L[ℂ] Matrix ι ι ℂ

section General

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- Densities `D(H)` (p. 4): `ρ = ρ*`, `ρ ≥ 0`, `tr ρ = 1`. -/
def IsDensity (ρ : Matrix ι ι ℂ) : Prop :=
  ρ.PosSemidef ∧ ρ.trace = 1

/-- The Lindblad generator of a jump operator `a`, with the paper's rate 2 and the standard sign:
`L_a(ρ) = 2 a ρ a* − a* a ρ − ρ a* a` (p. 5 (JU), sign as in every computation of the paper). -/
noncomputable def dissipator (a : Matrix ι ι ℂ) : Superop ι :=
  LinearMap.toContinuousLinearMap
    { toFun := fun ρ => (2 : ℂ) • (a * ρ * aᴴ) - aᴴ * a * ρ - ρ * (aᴴ * a)
      map_add' := fun ρ σ => by
        simp only [Matrix.mul_add, Matrix.add_mul, smul_add]
        abel
      map_smul' := fun c ρ => by
        simp only [Matrix.mul_smul, Matrix.smul_mul, smul_sub, RingHom.id_apply]
        rw [smul_comm c (2 : ℂ)] }

@[simp] theorem dissipator_apply (a ρ : Matrix ι ι ℂ) :
    dissipator a ρ = (2 : ℂ) • (a * ρ * aᴴ) - aᴴ * a * ρ - ρ * (aᴴ * a) := rfl

/-- The conjugation channel `Ad_U(ρ) = U ρ U*`. -/
noncomputable def unitaryConj (U : Matrix ι ι ℂ) : Superop ι :=
  LinearMap.toContinuousLinearMap
    { toFun := fun ρ => U * ρ * Uᴴ
      map_add' := fun ρ σ => by simp only [Matrix.mul_add, Matrix.add_mul]
      map_smul' := fun c ρ => by
        simp only [Matrix.mul_smul, Matrix.smul_mul, RingHom.id_apply] }

@[simp] theorem unitaryConj_apply (U ρ : Matrix ι ι ℂ) : unitaryConj U ρ = U * ρ * Uᴴ := rfl

/-- The anti-Hermitian part of the complex span of `S`: the operators `iH ∈ span{S}` with
`(iH)* = −iH` used in (UN), p. 5. -/
def antiHermSpan (S : Set (Matrix ι ι ℂ)) : Set (Matrix ι ι ℂ) :=
  {X | X ∈ Submodule.span ℂ S ∧ Xᴴ = -X}

/-- `𝔰𝔲(d)`: traceless anti-Hermitian matrices. -/
def suAlg (ι : Type) [Fintype ι] [DecidableEq ι] : Set (Matrix ι ι ℂ) :=
  {X | Xᴴ = -X ∧ X.trace = 0}

/-- Hörmander system (Definition 2.1, p. 5), applied to a resource set `S = S*` as in Theorem 2.12:
the real Lie algebra generated by the anti-Hermitian part of `span S` contains `𝔰𝔲(d)`. -/
def IsHormander (S : Set (Matrix ι ι ℂ)) : Prop :=
  suAlg ι ⊆ (LieSubalgebra.lieSpan ℝ (Matrix ι ι ℂ) (antiHermSpan S) : Set (Matrix ι ι ℂ))

/-- The closed resource class `C̅h̅a̅n̅n̅e̅l̅(̅S̅)̅` (p. 5): the smallest closed set of superoperators that
contains every unitary channel `Ad_{e^{tX}}` with `X = iH ∈ span S` anti-Hermitian and `t ≥ 0` (UN),
every semigroup element `e^{tL_a}` with `a ∈ S` and `t ≥ 0` (JU), and is closed under
composition (CO), i.e. the intersection of all such closed sets (CL). -/
def channelClosure (S : Set (Matrix ι ι ℂ)) : Set (Superop ι) :=
  ⋂₀ {C : Set (Superop ι) | IsClosed C ∧
      (∀ X ∈ antiHermSpan S, ∀ t : ℝ, 0 ≤ t →
        unitaryConj (NormedSpace.exp ((t : ℂ) • X)) ∈ C) ∧
      (∀ a ∈ S, ∀ t : ℝ, 0 ≤ t → NormedSpace.exp ((t : ℂ) • dissipator a) ∈ C) ∧
      (∀ Φ ∈ C, ∀ Ψ ∈ C, Φ.comp Ψ ∈ C)}

/-- Transitivity (Definitions 2.4–2.5, p. 6): for all densities `ρ, σ` some `Φ ∈ O` has `Φ(ρ) = σ`. -/
def IsTransitive (O : Set (Superop ι)) : Prop :=
  ∀ ρ σ : Matrix ι ι ℂ, IsDensity ρ → IsDensity σ → ∃ Φ ∈ O, Φ ρ = σ

/-- The range `D_S(ρ) = {Φ(ρ) : Φ ∈ C̅h̅a̅n̅n̅e̅l̅(̅S̅)̅}` (Definition 2.9, p. 8). -/
def reachSet (S : Set (Matrix ι ι ℂ)) (ρ : Matrix ι ι ℂ) : Set (Matrix ι ι ℂ) :=
  (fun Φ : Superop ι => Φ ρ) '' channelClosure S

/-- The full pinching `ρ ↦ diag(ρ)`: on one qubit `E∞` (p. 7), on `k` qubits `E∞^{⊗k}`. -/
noncomputable def pinchAll : Superop ι :=
  LinearMap.toContinuousLinearMap
    { toFun := fun ρ => Matrix.diagonal fun i => ρ i i
      map_add' := fun ρ σ => by
        ext i j
        simp [Matrix.diagonal_apply]
        split_ifs <;> simp
      map_smul' := fun c ρ => by
        ext i j
        simp [Matrix.diagonal_apply] }

@[simp] theorem pinchAll_apply (ρ : Matrix ι ι ℂ) :
    (pinchAll : Superop ι) ρ = Matrix.diagonal fun i => ρ i i := rfl

end General

/-! ### `k` qubits: `H = ℂ^{2^k}`, computational basis indexed by bit strings -/

/-- Computational basis of `k` qubits: bit strings `ω : Fin k → Bool`, `false = |0⟩`, `true = |1⟩`;
qubit `i : Fin k`, the page's first qubit being `0`. -/
abbrev Idx (k : ℕ) := Fin k → Bool

/-- Operators on `ℂ^{2^k}`. -/
abbrev Mat (k : ℕ) := Matrix (Idx k) (Idx k) ℂ

variable {k : ℕ}

/-- `|0⟩⟨1|` on qubit `i`, identity on the others (`|0⟩⟨1| ⊗ I^{⊗(k−1)}` for the first qubit). -/
def ampDamp (i : Fin k) : Mat k :=
  Matrix.of fun ω ω' => if ω i = false ∧ ω' i = true ∧ ∀ j, j ≠ i → ω j = ω' j then 1 else 0

/-- `Z = diag(1, −1)` on qubit `i`, identity on the others (`Z_1 = Z ⊗ I^{⊗(k−1)}`). -/
def dephZ (i : Fin k) : Mat k :=
  Matrix.diagonal fun ω => if ω i then -1 else 1

/-- `E∞` on qubit `i` tensored with the identity on the others (`E∞ ⊗ id^{k−1}` for the first qubit):
it deletes the entries that are off-diagonal in qubit `i`. -/
noncomputable def pinch (i : Fin k) : Superop (Idx k) :=
  LinearMap.toContinuousLinearMap
    { toFun := fun ρ => Matrix.of fun ω ω' => if ω i = ω' i then ρ ω ω' else 0
      map_add' := fun ρ σ => by
        ext ω ω'
        simp only [Matrix.of_apply, Matrix.add_apply]
        split_ifs <;> simp
      map_smul' := fun c ρ => by
        ext ω ω'
        simp only [Matrix.of_apply, Matrix.smul_apply, RingHom.id_apply]
        split_ifs <;> simp }

@[simp] theorem pinch_apply (i : Fin k) (ρ : Mat k) :
    pinch i ρ = Matrix.of fun ω ω' => if ω i = ω' i then ρ ω ω' else 0 := rfl

/-- `|0_k⟩⟨0_k|`, the pure state `|0 ⋯ 0⟩`. -/
def zeroState (k : ℕ) : Mat k :=
  Matrix.of fun ω ω' => if (∀ j, ω j = false) ∧ (∀ j, ω' j = false) then 1 else 0

/-- `R_{|0⟩⟨0|} ⊗ id` on qubit `i`: trace out qubit `i` and put it in `|0⟩`,
`ρ ↦ |0⟩⟨0|_i ⊗ tr_i ρ`, where `R_σ(ρ) = tr(ρ) σ` is the replacer channel (p. 4). -/
noncomputable def resetQubit (i : Fin k) : Superop (Idx k) :=
  LinearMap.toContinuousLinearMap
    { toFun := fun ρ => Matrix.of fun ω ω' =>
        if ω i = false ∧ ω' i = false then
          ∑ b : Bool, ρ (Function.update ω i b) (Function.update ω' i b)
        else 0
      map_add' := fun ρ σ => by
        ext ω ω'
        simp only [Matrix.of_apply, Matrix.add_apply]
        split_ifs <;> simp [Finset.sum_add_distrib]
      map_smul' := fun c ρ => by
        ext ω ω'
        simp only [Matrix.of_apply, Matrix.smul_apply, RingHom.id_apply]
        split_ifs <;> simp [mul_add] }

/-- The replacer channel `R_{|0_k⟩⟨0_k|}(ρ) = tr(ρ) |0_k⟩⟨0_k|` (p. 4). -/
noncomputable def resetAll (k : ℕ) : Superop (Idx k) :=
  LinearMap.toContinuousLinearMap
    { toFun := fun ρ => ρ.trace • zeroState k
      map_add' := fun ρ σ => by simp [Matrix.trace_add, add_smul]
      map_smul' := fun c ρ => by simp [Matrix.trace_smul, smul_smul] }

end LindbladReach.MinDiss


