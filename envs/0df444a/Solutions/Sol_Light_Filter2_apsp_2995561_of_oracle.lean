open Filter ThreeSumApsp
open Light
open Light.Filter2
open ThreeSumApsp.Spec Light.Sec3
theorem solution {P : Program} {pO : ℕ} {To : List ℕ → ℕ} {needo : List ℕ → Light.Need}
    (hsol : SolvesN Light.Filter2.oracleTask P pO To needo) (hpoly : PolyNeedN needo)
    (hT : ∀ c κ : ℝ, ∀ᶠ n : ℕ in atTop, ∀ U : ℕ, (U : ℝ) ≤ c * (n : ℝ) ^ κ →
      ∀ p : ℕ, p ≤ Light.Filter2.PmaxOf n → (To [n, U, Light.Filter2.sOf n, p] : ℝ) ≤ (n : ℝ) ^ (2.9955609 : ℝ)) :
    EndStatement.APSP.SolvedInTime (2.995561 : ℚ) := by
  obtain ⟨R, p', hae⟩ := Light.Filter2.filter_host.1 _ _ _ _ hsol
  have hS := hae.solvedIn (Light.Filter2.filter_host.2 _ hpoly)
  have hnn : ∀ n u, 0 ≤ timeUpTo (Light.Filter2.filterTime To) n u := fun n u => by
    unfold timeUpTo; exact Nat.cast_nonneg _
  refine apsp_2995561_of_ae
    (T := fun n u => timeUpTo (Light.Filter2.filterTime To) n u + (n : ℝ) ^ 2)
    (a := 2.99556095) (by norm_num) (by norm_num)
    (hS.mono fun n u _ _ => by have := hnn n u; nlinarith)
    (fun n u _ => by have := hnn n u; linarith) (fun c κ hc hκ => ?_)
  obtain ⟨K, hK⟩ := filterTime_bound hT c (κ + 1)
  refine isPowPolylog_of_eventually_le (C := K + 1) ?_
  filter_upwards [hK, eventually_ge_atTop 1] with n hK hn
  have hN1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hu : 0 ≤ c * (n : ℝ) ^ (κ + 1) := by positivity
  have h1 : timeUpTo (Light.Filter2.filterTime To) n (c * (n : ℝ) ^ (κ + 1)) ≤
      K * (n : ℝ) ^ (2.99556095 : ℝ) :=
    timeUpTo_le fun U hU => hK U (by rwa [max_eq_left hu] at hU)
  have h2 : (n : ℝ) ^ 2 ≤ (n : ℝ) ^ (2.99556095 : ℝ) := by
    have := Real.rpow_le_rpow_of_exponent_le hN1 (show (2 : ℝ) ≤ 2.99556095 by norm_num)
    rwa [show (n : ℝ) ^ (2 : ℝ) = (n : ℝ) ^ 2 by rw [← Real.rpow_natCast]; norm_num] at this
  exact ⟨by have := hnn n (c * (n : ℝ) ^ (κ + 1)); positivity, by linarith⟩
end
