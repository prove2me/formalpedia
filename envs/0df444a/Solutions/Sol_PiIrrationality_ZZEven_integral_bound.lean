      (25446889899179247216376714095171 / 1600000000000000000000000 : ℝ) * (4 * u - 3) ^ 18 * (1 - (4 * u - 3)) ^ 2 +
      (261059424233471774096077673 / 200000000000000000000 : ℝ) * (4 * u - 3) ^ 19 * (1 - (4 * u - 3)) ^ 1 +
      (4370757334318291640240399 / 100000000000000000000 : ℝ) * (4 * u - 3) ^ 20 * (1 - (4 * u - 3)) ^ 0 := by
    unfold Pxy; ring
  rw [h]
  have hw0 : 0 ≤ (4 * u - 3) := by linarith
  have hw1 : 0 ≤ 1 - (4 * u - 3) := by linarith
  positivity


/-- The pointwise saddle estimate from a nonnegative certificate. -/
lemma G_le (t : ℂ) (h : 0 ≤ Pxy t.re t.im) :
    ‖t‖ ^ 4 * ‖t ^ 4 + 6 * t ^ 2 + 25‖ ^ 4 ≤ 9 / 10000 * ‖25 - t ^ 2‖ ^ 6 := by
  have h1 : ‖t‖ ^ 2 = t.re ^ 2 + t.im ^ 2 := by
    rw [Complex.sq_norm, Complex.normSq_apply]; ring
  have h2 : ‖t ^ 4 + 6 * t ^ 2 + 25‖ ^ 2 =
      ((t.re ^ 2 - t.im ^ 2) ^ 2 - 4 * t.re ^ 2 * t.im ^ 2 + 6 * (t.re ^ 2 - t.im ^ 2) + 25) ^ 2 +
        (4 * t.re * t.im * (t.re ^ 2 - t.im ^ 2) + 12 * t.re * t.im) ^ 2 := by
    rw [Complex.sq_norm, Complex.normSq_apply]
    simp only [add_re, add_im, mul_re, mul_im, pow_succ, pow_zero, one_mul, re_ofNat, im_ofNat]
    ring
  have h3 : ‖25 - t ^ 2‖ ^ 2 = (25 - t.re ^ 2 + t.im ^ 2) ^ 2 + (2 * t.re * t.im) ^ 2 := by
    rw [Complex.sq_norm, Complex.normSq_apply]
    simp only [sub_re, sub_im, mul_re, mul_im, pow_succ, pow_zero, one_mul, re_ofNat, im_ofNat]
    ring
  unfold Pxy at h
  have e1 : ‖t‖ ^ 4 = (‖t‖ ^ 2) ^ 2 := by ring
  have e2 : ‖t ^ 4 + 6 * t ^ 2 + 25‖ ^ 4 = (‖t ^ 4 + 6 * t ^ 2 + 25‖ ^ 2) ^ 2 := by ring
  have e3 : ‖25 - t ^ 2‖ ^ 6 = (‖25 - t ^ 2‖ ^ 2) ^ 3 := by ring
  rw [e1, e2, e3, h1, h2, h3]
  linarith

/-- `R n` is holomorphic on the open disc of radius 5. -/
lemma R_differentiableOn (n : ℕ) : DifferentiableOn ℂ (R n) (ball 0 5) := by
  intro z hz
  have hz' : ‖z‖ < 5 := by simpa using hz
  have hne : (25 - z ^ 2 : ℂ) ≠ 0 := by
    intro h0
    have : ‖z ^ 2‖ = 25 := by
      rw [show z ^ 2 = 25 by linear_combination -h0]; norm_num
    rw [norm_pow] at this
    nlinarith [norm_nonneg z]
  apply DifferentiableAt.differentiableWithinAt
  have hd : DifferentiableAt ℂ (fun t : ℂ => 5 * t ^ (4 * n) * (t ^ 4 + 6 * t ^ 2 + 25) ^ (4 * n) /
      (25 - t ^ 2) ^ (6 * n + 1)) z :=
    DifferentiableAt.div (by fun_prop) (by fun_prop) (pow_ne_zero _ hne)
  exact hd


/-- Pointwise bound for `R n` at a point of norm at most `√5` satisfying the certificate. -/
lemma norm_R_le (n : ℕ) (t : ℂ) (hP : 0 ≤ Pxy t.re t.im) (ht : ‖t‖ ^ 2 ≤ 5) :
    ‖R n t‖ ≤ 5 / 20 * (9 / 10000 : ℝ) ^ n := by
  have hD : 20 ≤ ‖25 - t ^ 2‖ := by
    have h1 : ‖(25 : ℂ)‖ ≤ ‖25 - t ^ 2‖ + ‖t ^ 2‖ := by
      calc ‖(25 : ℂ)‖ = ‖(25 - t ^ 2) + t ^ 2‖ := by ring_nf
        _ ≤ ‖25 - t ^ 2‖ + ‖t ^ 2‖ := norm_add_le _ _
    rw [norm_pow] at h1
    norm_num at h1
    linarith
  have hDpos : 0 < ‖25 - t ^ 2‖ := by linarith
  have hG := G_le t hP
  unfold R
  rw [norm_div, norm_mul, norm_mul, norm_pow, norm_pow, norm_pow]
  have h5 : ‖(5 : ℂ)‖ = 5 := by norm_num
  rw [h5, pow_mul ‖t‖ 4 n, pow_mul ‖t ^ 4 + 6 * t ^ 2 + 25‖ 4 n, pow_succ ‖25 - t ^ 2‖ (6 * n),
    pow_mul ‖25 - t ^ 2‖ 6 n]
  have hA : (‖t‖ ^ 4) ^ n * (‖t ^ 4 + 6 * t ^ 2 + 25‖ ^ 4) ^ n ≤
      (9 / 10000 : ℝ) ^ n * (‖25 - t ^ 2‖ ^ 6) ^ n := by
    rw [← mul_pow (‖t‖ ^ 4), ← mul_pow (9 / 10000 : ℝ)]
    exact pow_le_pow_left₀ (by positivity) hG n
  have hB : 0 < (‖25 - t ^ 2‖ ^ 6) ^ n := by positivity
  rw [div_le_iff₀ (by positivity)]
  calc 5 * (‖t‖ ^ 4) ^ n * (‖t ^ 4 + 6 * t ^ 2 + 25‖ ^ 4) ^ n
      = 5 * ((‖t‖ ^ 4) ^ n * (‖t ^ 4 + 6 * t ^ 2 + 25‖ ^ 4) ^ n) := by ring
    _ ≤ 5 * ((9 / 10000 : ℝ) ^ n * (‖25 - t ^ 2‖ ^ 6) ^ n) := by gcongr
    _ ≤ 5 / 20 * (9 / 10000 : ℝ) ^ n * ((‖25 - t ^ 2‖ ^ 6) ^ n * ‖25 - t ^ 2‖) := by
      have : (0 : ℝ) ≤ (9 / 10000 : ℝ) ^ n * (‖25 - t ^ 2‖ ^ 6) ^ n := by positivity
      nlinarith

/-- Fundamental theorem of calculus along an affine path inside the disc. -/
lemma path_ftc (n : ℕ) {F : ℂ → ℂ} (hF : ∀ z ∈ ball (0 : ℂ) 5, HasDerivAt F (R n z) z)
    (p v : ℂ) (α β : ℝ) (hαβ : α ≤ β)
    (hmem : ∀ s ∈ Set.Icc α β, p + (s : ℂ) * v ∈ ball (0 : ℂ) 5) :
    ∫ s in α..β, R n (p + (s : ℂ) * v) * v = F (p + (β : ℂ) * v) - F (p + (α : ℂ) * v) := by
  apply intervalIntegral.integral_eq_sub_of_hasDerivAt
  · intro s hs
    rw [Set.uIcc_of_le hαβ] at hs
    have h1 : HasDerivAt (fun w : ℂ => p + w * v) v (s : ℂ) := by
      simpa using ((hasDerivAt_id (s : ℂ)).mul_const v).const_add p
    have h2 := (hF _ (hmem s hs)).comp (s : ℂ) h1
    exact h2.comp_ofReal
  · apply ContinuousOn.intervalIntegrable
    rw [Set.uIcc_of_le hαβ]
    apply ContinuousOn.mul _ continuousOn_const
    exact ((R_differentiableOn n).continuousOn).comp (by fun_prop) (fun s hs => hmem s hs)

/-- Convexity of `‖·‖²` along a segment. -/
lemma normSq_seg_le (a b : ℂ) (u : ℝ) (h0 : 0 ≤ u) (h1 : u ≤ 1) (ha : ‖a‖ ^ 2 ≤ 5)
    (hb : ‖b‖ ^ 2 ≤ 5) : ‖a + (u : ℂ) * (b - a)‖ ^ 2 ≤ 5 := by
  rw [Complex.sq_norm, Complex.normSq_apply] at *
  simp only [add_re, add_im, mul_re, mul_im, ofReal_re, ofReal_im, sub_re, sub_im, zero_mul,
    sub_zero, add_zero] at *
  nlinarith [mul_nonneg h0 (sub_nonneg.mpr h1), sq_nonneg (b.re - a.re), sq_nonneg (b.im - a.im)]

lemma mem_ball_of_normSq {t : ℂ} (h : ‖t‖ ^ 2 ≤ 5) : t ∈ ball (0 : ℂ) 5 := by
  rw [mem_ball, dist_zero_right]
  nlinarith [norm_nonneg t]


/-- The four edges of the polygon. -/
noncomputable def v0 : ℂ := ⟨-1, -2⟩
noncomputable def v1 : ℂ := ⟨-81 / 100, -2049 / 1000⟩
noncomputable def v2 : ℂ := ⟨7 / 10, 0⟩
noncomputable def v3 : ℂ := ⟨-81 / 100, 2049 / 1000⟩
noncomputable def v4 : ℂ := ⟨-1, 2⟩

lemma seg_re_im (a b : ℂ) (u : ℝ) :
    (a + (u : ℂ) * (b - a)).re = a.re + u * (b.re - a.re) ∧
      (a + (u : ℂ) * (b - a)).im = a.im + u * (b.im - a.im) := by
  constructor <;> simp

/-- Certificate on every edge. -/
lemma cert_edge0 (u : ℝ) (h0 : 0 ≤ u) (h1 : u ≤ 1) :
    0 ≤ Pxy (v0 + (u : ℂ) * (v1 - v0)).re (v0 + (u : ℂ) * (v1 - v0)).im := by
  obtain ⟨hr, hi⟩ := seg_re_im v0 v1 u
  rw [hr, hi]; simp only [v0, v1]
  have := cert_0_0 u h0 h1
  convert this using 2 <;> ring

lemma cert_edge1 (u : ℝ) (h0 : 0 ≤ u) (h1 : u ≤ 1) :
    0 ≤ Pxy (v1 + (u : ℂ) * (v2 - v1)).re (v1 + (u : ℂ) * (v2 - v1)).im := by
  obtain ⟨hr, hi⟩ := seg_re_im v1 v2 u
  rw [hr, hi]; simp only [v1, v2]
  have key : 0 ≤ Pxy ((-81 / 100 : ℝ) + u * (151 / 100 : ℝ)) ((-2049 / 1000 : ℝ) + u * (2049 / 1000 : ℝ)) := by
    rcases le_total u (1 / 4) with ha | ha
    · exact cert_1_0 u h0 ha
    rcases le_total u (1 / 2) with hb | hb
    · exact cert_1_1 u ha hb
    rcases le_total u (3 / 4) with hc | hc
    · exact cert_1_2 u hb hc
    · exact cert_1_3 u hc h1
  convert key using 2 <;> ring

lemma cert_edge2 (u : ℝ) (h0 : 0 ≤ u) (h1 : u ≤ 1) :
    0 ≤ Pxy (v2 + (u : ℂ) * (v3 - v2)).re (v2 + (u : ℂ) * (v3 - v2)).im := by
  have h := cert_edge1 (1 - u) (by linarith) (by linarith)
  obtain ⟨hr, hi⟩ := seg_re_im v2 v3 u
  obtain ⟨hr', hi'⟩ := seg_re_im v1 v2 (1 - u)
  rw [hr', hi'] at h
  rw [hr, hi, ← Pxy_neg]
  simp only [v1, v2, v3] at h ⊢
  convert h using 2 <;> ring

lemma cert_edge3 (u : ℝ) (h0 : 0 ≤ u) (h1 : u ≤ 1) :
    0 ≤ Pxy (v3 + (u : ℂ) * (v4 - v3)).re (v3 + (u : ℂ) * (v4 - v3)).im := by
  have h := cert_edge0 (1 - u) (by linarith) (by linarith)
  obtain ⟨hr, hi⟩ := seg_re_im v3 v4 u
  obtain ⟨hr', hi'⟩ := seg_re_im v0 v1 (1 - u)
  rw [hr', hi'] at h
  rw [hr, hi, ← Pxy_neg]
  simp only [v0, v1, v3, v4] at h ⊢
  convert h using 2 <;> ring

lemma normSq_v (z : ℂ) (x y : ℝ) (hz : z = ⟨x, y⟩) : ‖z‖ ^ 2 = x ^ 2 + y ^ 2 := by
  rw [hz, Complex.sq_norm, Complex.normSq_apply]; ring

lemma norm_le_of_sq {z : ℂ} {L : ℝ} (hL : 0 ≤ L) (h : ‖z‖ ^ 2 ≤ L ^ 2) : ‖z‖ ≤ L :=
  abs_le_of_sq_le_sq' h hL |>.2 |> fun h' => by
    have := norm_nonneg z; nlinarith [sq_nonneg (‖z‖ - L), sq_nonneg (‖z‖ + L)]

/-- One edge contributes at most `(5/20) (9/10000)^n ‖b - a‖`. -/
lemma edge_bound (n : ℕ) {F : ℂ → ℂ} (hF : ∀ z ∈ ball (0 : ℂ) 5, HasDerivAt F (R n z) z)
    (a b : ℂ) (ha : ‖a‖ ^ 2 ≤ 5) (hb : ‖b‖ ^ 2 ≤ 5)
    (hcert : ∀ u : ℝ, 0 ≤ u → u ≤ 1 → 0 ≤ Pxy (a + (u : ℂ) * (b - a)).re (a + (u : ℂ) * (b - a)).im) :
    ‖F b - F a‖ ≤ 5 / 20 * (9 / 10000 : ℝ) ^ n * ‖b - a‖ := by
  have hftc := path_ftc n hF a (b - a) 0 1 zero_le_one (fun s hs =>
    mem_ball_of_normSq (normSq_seg_le a b s hs.1 hs.2 ha hb))
  simp only [Complex.ofReal_one, one_mul, Complex.ofReal_zero, zero_mul, add_zero,
    add_sub_cancel] at hftc
  rw [← hftc]
  have := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 1)
    (C := 5 / 20 * (9 / 10000 : ℝ) ^ n * ‖b - a‖)
    (f := fun s : ℝ => R n (a + (s : ℂ) * (b - a)) * (b - a)) (by
      intro u hu
      rw [Set.uIoc_of_le zero_le_one] at hu
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right (norm_R_le n _ (hcert u hu.1.le hu.2)
        (normSq_seg_le a b u hu.1.le hu.2 ha hb)) (norm_nonneg _))
  simpa using this

end PiIrrationality.ZZEven.IntegralBound

open PiIrrationality.ZZEven PiIrrationality.ZZEven.IntegralBound in
theorem solution (n : ℕ) :
    ‖PiIrrationality.ZZEven.J n‖ ≤ 10 * Real.exp (-(7 * (n : ℝ))) := by
  obtain ⟨F, hF⟩ := (R_differentiableOn n).isExactOn_ball
  -- the vertical segment
  have hvert := path_ftc n hF (-1) Complex.I (-2) 2 (by norm_num) (fun s hs => by
    apply mem_ball_of_normSq
    rw [normSq_v _ (-1) s (by apply Complex.ext <;> simp)]
    nlinarith [hs.1, hs.2])
  rw [intervalIntegral.integral_mul_const] at hvert
  have e4 : (-1 : ℂ) + ((2 : ℝ) : ℂ) * Complex.I = v4 := by apply Complex.ext <;> simp [v4]
  have e0 : (-1 : ℂ) + ((-2 : ℝ) : ℂ) * Complex.I = v0 := by apply Complex.ext <;> simp [v0]
  rw [e4, e0] at hvert
  have hJ : ‖J n‖ = ‖F v4 - F v0‖ := by
    unfold J
    rw [norm_neg, ← hvert, norm_mul, Complex.norm_I, mul_one]
  -- vertex norms
  have n0 : ‖v0‖ ^ 2 ≤ 5 := by rw [normSq_v v0 (-1) (-2) rfl]; norm_num
  have n1 : ‖v1‖ ^ 2 ≤ 5 := by rw [normSq_v v1 _ _ rfl]; norm_num
  have n2 : ‖v2‖ ^ 2 ≤ 5 := by rw [normSq_v v2 _ _ rfl]; norm_num
  have n3 : ‖v3‖ ^ 2 ≤ 5 := by rw [normSq_v v3 _ _ rfl]; norm_num
  have n4 : ‖v4‖ ^ 2 ≤ 5 := by rw [normSq_v v4 (-1) 2 rfl]; norm_num
  have b0 := edge_bound n hF v0 v1 n0 n1 cert_edge0
  have b1 := edge_bound n hF v1 v2 n1 n2 cert_edge1
  have b2 := edge_bound n hF v2 v3 n2 n3 cert_edge2
  have b3 := edge_bound n hF v3 v4 n3 n4 cert_edge3
  -- edge lengths
  have l0 : ‖v1 - v0‖ ≤ 1 / 5 := norm_le_of_sq (by norm_num) (by
    rw [normSq_v (v1 - v0) (19 / 100) (-49 / 1000) (by apply Complex.ext <;> simp [v0, v1] <;> norm_num)]
    norm_num)
  have l1 : ‖v2 - v1‖ ≤ 13 / 5 := norm_le_of_sq (by norm_num) (by
    rw [normSq_v (v2 - v1) (151 / 100) (2049 / 1000) (by apply Complex.ext <;> simp [v1, v2] <;> norm_num)]
    norm_num)
  have l2 : ‖v3 - v2‖ ≤ 13 / 5 := norm_le_of_sq (by norm_num) (by
    rw [normSq_v (v3 - v2) (-151 / 100) (2049 / 1000) (by apply Complex.ext <;> simp [v2, v3] <;> norm_num)]
    norm_num)
  have l3 : ‖v4 - v3‖ ≤ 1 / 5 := norm_le_of_sq (by norm_num) (by
    rw [normSq_v (v4 - v3) (-19 / 100) (-49 / 1000) (by apply Complex.ext <;> simp [v3, v4] <;> norm_num)]
    norm_num)
  have hsplit : F v4 - F v0 = (F v1 - F v0) + (F v2 - F v1) + (F v3 - F v2) + (F v4 - F v3) := by ring
  have hg : (0 : ℝ) ≤ 5 / 20 * (9 / 10000 : ℝ) ^ n := by positivity
  have htot : ‖F v4 - F v0‖ ≤ 5 / 20 * (9 / 10000 : ℝ) ^ n * (28 / 5) := by
    rw [hsplit]
    calc ‖(F v1 - F v0) + (F v2 - F v1) + (F v3 - F v2) + (F v4 - F v3)‖
        ≤ ‖F v1 - F v0‖ + ‖F v2 - F v1‖ + ‖F v3 - F v2‖ + ‖F v4 - F v3‖ := by
          refine (norm_add_le _ _).trans ?_
          gcongr
          refine (norm_add_le _ _).trans ?_
          gcongr
          exact norm_add_le _ _
      _ ≤ 5 / 20 * (9 / 10000 : ℝ) ^ n * ‖v1 - v0‖ + 5 / 20 * (9 / 10000 : ℝ) ^ n * ‖v2 - v1‖ +
          5 / 20 * (9 / 10000 : ℝ) ^ n * ‖v3 - v2‖ + 5 / 20 * (9 / 10000 : ℝ) ^ n * ‖v4 - v3‖ := by
          gcongr
      _ ≤ 5 / 20 * (9 / 10000 : ℝ) ^ n * (28 / 5) := by
          nlinarith [mul_le_mul_of_nonneg_left l0 hg, mul_le_mul_of_nonneg_left l1 hg,
            mul_le_mul_of_nonneg_left l2 hg, mul_le_mul_of_nonneg_left l3 hg]
  -- 9/10000 ≤ exp(-7)
  have hexp : (9 / 10000 : ℝ) ≤ Real.exp (-7) := by
    rw [Real.exp_neg, le_inv_comm₀ (by norm_num) (Real.exp_pos _)]
    have h := Real.exp_one_lt_d9
    have : Real.exp 7 = Real.exp 1 ^ 7 := by rw [← Real.exp_nat_mul]; norm_num
    rw [this]
    calc Real.exp 1 ^ 7 ≤ (2.7182818286 : ℝ) ^ 7 :=
          pow_le_pow_left₀ (Real.exp_pos 1).le h.le 7
      _ ≤ (9 / 10000)⁻¹ := by norm_num
  have hpow : (9 / 10000 : ℝ) ^ n ≤ Real.exp (-(7 * (n : ℝ))) := by
    rw [show -(7 * (n : ℝ)) = n * (-7) by ring, Real.exp_nat_mul]
    exact pow_le_pow_left₀ (by norm_num) hexp n
  rw [hJ]
  calc ‖F v4 - F v0‖ ≤ 5 / 20 * (9 / 10000 : ℝ) ^ n * (28 / 5) := htot
    _ ≤ 10 * Real.exp (-(7 * (n : ℝ))) := by nlinarith [pow_nonneg (show (0:ℝ) ≤ 9 / 10000 by norm_num) n]
