theorem NLogN.KFM.sum_mu (P s : ℕ) (hs : 2 ≤ s) (hc : Nat.Coprime P s) :
    ∑ y ∈ Finset.Icc 1 s, (y : ℤ) * (if ((y : ℤ) * ((P % s : ℕ) : ℤ)) % (s : ℤ) = 1 then 1 else 0) =
