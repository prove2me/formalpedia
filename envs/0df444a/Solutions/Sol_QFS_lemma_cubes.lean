variable {d : ℕ}

/-- **Lemma 3.4** of Bux–Kassmann–Schulze. For `x, y` in the lattice `hℤ^d` at
Euclidean distance more than `√d·h`, and points `s ∈ A_h(x)`, `t ∈ A_h(y)`,

  `(2√d)⁻¹ |x-y| < |s-t| < 2√d |x-y|`.

The paper states the hypothesis as `x, y ∈ ℤ^d` for every `h > 0`; its proof
treats `h = 1` and says the general case "follows by scaling", which is the
statement proved here. The literal statement is false — see
`lemma_cubes_literal_false`. -/
theorem solution {h : ℝ} (hh : 0 < h) {x y s t : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ QFS.scaledLattice d h) (hy : y ∈ QFS.scaledLattice d h)
    (hxy : Real.sqrt d * h < ‖x - y‖) (hs : s ∈ QFS.cube h x) (ht : t ∈ QFS.cube h y) :
    1 / (2 * Real.sqrt d) * ‖x - y‖ < ‖s - t‖ ∧ ‖s - t‖ < 2 * Real.sqrt d * ‖x - y‖ := by
  -- The hypothesis forces `d > 0`.
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · exfalso
    have : ‖x - y‖ = 0 := by simp [EuclideanSpace.norm_eq]
    rw [this] at hxy
    simp at hxy
  have : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  have hsd : (0 : ℝ) < Real.sqrt d := Real.sqrt_pos.mpr (by exact_mod_cast hd)
  -- `‖x-y‖ ≤ √d · N` gives `h < N`, and lattice integrality upgrades this to `2h ≤ N`.
  have hN1 : ‖x - y‖ ≤ Real.sqrt d * QFS.infNorm (x - y) := QFS.norm_le_sqrt_dim_mul_infNorm _
  have hhN : h < QFS.infNorm (x - y) := by nlinarith
  have hN2 : 2 * h ≤ QFS.infNorm (x - y) := QFS.two_mul_le_infNorm_sub hh hx hy hhN
  -- The two cube conditions.
  have hsx : QFS.infNorm (s - x) < h / 2 := hs
  have hty : QFS.infNorm (t - y) < h / 2 := ht
  have hyt : QFS.infNorm (y - t) < h / 2 := by rw [QFS.infNorm_sub_comm]; exact ht
  have hxs : QFS.infNorm (x - s) < h / 2 := by rw [QFS.infNorm_sub_comm]; exact hs
  -- `M < N + h` and `N < M + h`.
  have hMN : QFS.infNorm (s - t) < QFS.infNorm (x - y) + h := by
    have e : s - t = (s - x) + ((x - y) + (y - t)) := by abel
    have b1 : QFS.infNorm (s - t) ≤ QFS.infNorm (s - x) + QFS.infNorm ((x - y) + (y - t)) := by
      rw [e]; exact QFS.infNorm_add_le _ _
    have b2 : QFS.infNorm ((x - y) + (y - t)) ≤ QFS.infNorm (x - y) + QFS.infNorm (y - t) :=
      QFS.infNorm_add_le _ _
    linarith
  have hNM : QFS.infNorm (x - y) < QFS.infNorm (s - t) + h := by
    have e : x - y = (x - s) + ((s - t) + (t - y)) := by abel
    have b1 : QFS.infNorm (x - y) ≤ QFS.infNorm (x - s) + QFS.infNorm ((s - t) + (t - y)) := by
      rw [e]; exact QFS.infNorm_add_le _ _
    have b2 : QFS.infNorm ((s - t) + (t - y)) ≤ QFS.infNorm (s - t) + QFS.infNorm (t - y) :=
      QFS.infNorm_add_le _ _
    linarith
  -- Passing between the two norms.
  have hNle : QFS.infNorm (x - y) ≤ ‖x - y‖ := QFS.infNorm_le_norm _
  have hMle : QFS.infNorm (s - t) ≤ ‖s - t‖ := QFS.infNorm_le_norm _
  have hstle : ‖s - t‖ ≤ Real.sqrt d * QFS.infNorm (s - t) := QFS.norm_le_sqrt_dim_mul_infNorm _
  have hNnn : 0 ≤ QFS.infNorm (x - y) := QFS.infNorm_nonneg _
  constructor
  · -- `‖x-y‖ ≤ √d N < √d (2M) ≤ 2√d ‖s-t‖`
    have hkey : ‖x - y‖ < 2 * Real.sqrt d * ‖s - t‖ := by nlinarith
    have he : 1 / (2 * Real.sqrt d) * ‖x - y‖ = ‖x - y‖ / (2 * Real.sqrt d) := by ring
    rw [he, div_lt_iff₀ (by positivity)]
    nlinarith
  · -- `‖s-t‖ ≤ √d M < √d (N + h) ≤ 2√d N ≤ 2√d ‖x-y‖`
    nlinarith
