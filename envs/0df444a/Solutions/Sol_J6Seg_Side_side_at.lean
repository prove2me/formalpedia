theorem n6 :
    cSlabOut (axpre6 P n D k) (axnc6 P n k * axl6 P n) (axpost6 P n D k) (axwd6 P n src k ap)
        (2 * axp6 P n + 6) (axQ6 P n src k - axp6 P n) (axp6 P n) ≤
      10 ^ 11 * (Wc ap + 11) * (TP6 P n * pP6 P n) +
        10 ^ 7 * TP6 P n * KFM.fmB (2 * (axwd6 P n src k ap + (2 * pP6 P n + 6) + 2)) := by
  have hw := wd_le ap h
