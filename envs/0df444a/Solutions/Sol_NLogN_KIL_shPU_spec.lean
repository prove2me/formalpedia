  · rw [hn, Int.toNat_natCast] at this
    have h2 : L.length * (4000 * (B + 2) + 2 * B + 2 + 8000 * (B + 2) + 30) ≤
        L.length * (14000 * (B + 2)) := Nat.mul_le_mul_left _ (by omega)
