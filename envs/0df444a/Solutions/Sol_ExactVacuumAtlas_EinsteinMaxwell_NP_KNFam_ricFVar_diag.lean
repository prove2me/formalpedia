/-- Antisymmetry of the frame-Faraday variation. -/
theorem FfrFVar_antisymm {F f : TwoForm 4} {E B : Fin 4 → Fin 4 → Pt 4 → ℂ} {x : Pt 4}
    (hF : ∀ i j, F i j x = -F j i x) (hf : ∀ i j, f i j x = -f j i x) (A K : Fin 4) :
    FfrFVar F f E B K A x = -FfrFVar F f E B A K x := by
  unfold FfrFVar
  rw [ccontr_antisymm hf (fvec E A x) (fvec E K x), ccontr_antisymm hF (fvec E A x) (fvec B K x),
    ccontr_antisymm hF (fvec B A x) (fvec E K x)]
  ring

theorem FfrFVar_self {F f : TwoForm 4} {E B : Fin 4 → Fin 4 → Pt 4 → ℂ} {x : Pt 4}
    (hF : ∀ i j, F i j x = -F j i x) (hf : ∀ i j, f i j x = -f j i x) (A : Fin 4) :
    FfrFVar F f E B A A x = 0 := by
  have := FfrFVar_antisymm (E := E) (B := B) hF hf A A
  linear_combination this / 2

