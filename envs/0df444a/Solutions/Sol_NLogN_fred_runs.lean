  generalize z.natAbs / 2 ^ m = a at h ⊢
  generalize z.natAbs % 2 ^ m = b at h ⊢
  have h' : (2 : ℤ) ^ m * a + b = (z.natAbs : ℤ) := by exact_mod_cast h
  split_ifs with hz
  · have : (z.natAbs : ℤ) = -z := by omega
    rw [this] at h'; linear_combination h'
  · have : (z.natAbs : ℤ) = z := by omega
    rw [this] at h'; linear_combination -h'

