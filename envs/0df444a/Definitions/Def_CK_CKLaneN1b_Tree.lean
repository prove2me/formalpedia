by `N1b/work/gen_tree.py`: all 4730 leaves with owner labels
0 = endpoint_plane_taylor, 1 = endpoint_plane_endpoints, 2 = shifted_logsum, 3 = cap, 4 = endpoint_sum, 5 = sum_normalized, 6 = outside, 7 = logsum_quad_endpoints.
A node `N ax l r` halves axis `ax` (0 = a, 1 = b, 2 = t); `l` is the lower half (digit `2 ax`),
`r` the upper half (digit `2 ax + 1`), exactly as `FULL_ENTROPY_COVER.reconstruct` from the root
`[1/10, 1/2] × [1/2, 9/10] × [0, 1]`.
-/

namespace CKLaneN1b

/-- A labelled binary partition tree. -/
inductive MTree where
  | leaf (label : ℕ)
  | node (axis : ℕ) (l r : MTree)
  deriving Repr

/-- All leaves `(path, label)`; `rpre` is the REVERSED path prefix. -/
def MTree.leavesR : MTree → List ℕ → List (List ℕ × ℕ)
  | .leaf l, rpre => [(rpre.reverse, l)]
  | .node ax l r, rpre => MTree.leavesR l (2 * ax :: rpre) ++ MTree.leavesR r ((2 * ax + 1) :: rpre)

/-- All leaves `(path, label)` of a tree (paths from the root). -/
def MTree.leaves (T : MTree) : List (List ℕ × ℕ) := T.leavesR []

/-- The archived root box. -/
def boxRoot : Box := ⟨1 / 10, 1 / 2, 1 / 2, 9 / 10, 0, 1⟩

/-- One exact halving step of the archived partition (`FULL_ENTROPY_COVER.reconstruct`). -/
def boxStep (B : Box) (d : ℕ) : Box :=
  match d with
  | 0 => { B with a1 := (B.a0 + B.a1) / 2 }
  | 1 => { B with a0 := (B.a0 + B.a1) / 2 }
  | 2 => { B with b1 := (B.b0 + B.b1) / 2 }
  | 3 => { B with b0 := (B.b0 + B.b1) / 2 }
  | 4 => { B with t1 := (B.t0 + B.t1) / 2 }
  | 5 => { B with t0 := (B.t0 + B.t1) / 2 }
  | _ => B

/-- The exact leaf box of an archived path. -/
def boxOf (p : List ℕ) : Box := p.foldl boxStep boxRoot

local notation "L" => MTree.leaf
local notation "N" => MTree.node

