-- title:
--   Conditional Bernoulli feedback, independent draws and expected regret
-- statement:
--   A policy maps each finite observed history and the current covariate to a price in $[0,1]$. Each round uses an independent draw $(X,U)$ with law $\mu\otimes\mathrm{Uniform}[0,1]$. Given the current price $p$, the purchase bit is $\mathbf1\{U<D(X,p)\}$ and the observed revenue is $Z=p\mathbf1\{U<D(X,p)\}$. Thus the price depends only on past observations and current covariates, and the purchase is conditionally Bernoulli with the requested success probability, including price zero. The chronological list of observations is generated by a finite fold.
--
--   For horizon $T$, the sample law is the finite product of the one-round law, and the regret is the expectation of $\sum_{t=1}^T[f^*(X_t)-f(X_t,p_t)]$. The optimal revenue is computed by the model definition. Under the theorem's measurability and regularity assumptions these are bounded measurable summands, so the integral equals the printed sum of expectations. The empty horizon is defined to have an empty sum; the theorem excludes it.
--
--   Differences from the source:
--   - encoding: prices, covariates, revenue observations and expectations are described probabilistically → Euclidean cube and closed-unit-price subtypes, finite histories, independent covariate/uniform draws, revenue p times a threshold-generated purchase bit, and an integral of the finite sum of gaps; reason: this realizes the stated conditional Bernoulli law and equals the sum of expectations; the source’s measurability convention is explicit
-- source:
--   Chen and Gallego, Nonparametric Pricing Analytics with Customer Covariates, arXiv:1805.01136v3 (16 February 2020), https://arxiv.org/abs/1805.01136v3; §2 and Assumption 1, printed/PDF pp. 7–8

import Mathlib
import Definitions.Def_ChenGallegoPricing_ABE_Model
import Definitions.Def_ChenGallegoPricing_ABE_Algorithm

open MeasureTheory

namespace ChenGallegoPricing.ABE

/-- A covariate and an independent fresh uniform draw generate each purchase. -/
abbrev Draw (d : ℕ) := Ctx d × ℝ

noncomputable def feedback {d : ℕ} (D : Demand d) (π : Policy d)
    (h : History d) (w : Draw d) : Observation d :=
  let p := π h w.1
  (w.1, p, if w.2 < (D (w.1, p) : ℝ) then (p : ℝ) else 0)

noncomputable def play {d : ℕ} (D : Demand d) (π : Policy d)
    (draws : List (Draw d)) : History d :=
  draws.foldl (fun h w => h ++ [feedback D π h w]) []

/-- Finite independent product; the uniform factor has mass exactly one. -/
noncomputable def drawLaw {d : ℕ} (μ : Measure (Ctx d)) [IsProbabilityMeasure μ]
    (T : ℕ) : Measure (Fin T → Draw d) :=
  Measure.pi (fun _ => μ.prod (volume.restrict (Set.Icc (0 : ℝ) 1)))

/-- Expected cumulative gap to the continuous-price clairvoyant. -/
noncomputable def regret {d : ℕ} (D : Demand d) (μ : Measure (Ctx d))
    [IsProbabilityMeasure μ] (π : Policy d) (T : ℕ) : ℝ :=
  ∫ w, ((play D π (List.ofFn w)).map (fun o =>
    optimalRevenue D o.1 - revenue D o.1 o.2.1)).sum ∂drawLaw μ T

end ChenGallegoPricing.ABE


