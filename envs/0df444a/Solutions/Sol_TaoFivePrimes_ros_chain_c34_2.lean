theorem child34_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu150.lin : ℝ) ≤ (S : ℝ) * logProd gu150.lo) :
    (gu153.lfin : ℝ) ≤ (S : ℝ) * logProd gu153.top ∧
      (∀ x : ℝ, (gu150.lo : ℝ) < x → x ≤ (gu153.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u150 hγ hstate
  have s1 := sol_u151 hγ (by simpa [gu150, gu151] using s0.1)
  have s2 := sol_u152 hγ (by simpa [gu151, gu152] using s1.1)
  have s3 := sol_u153 hγ (by simpa [gu152, gu153] using s2.1)
  refine ⟨s3.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu150.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu151.lo : ℝ) < x := by
        have hb : (gu150.top : ℝ) = (gu151.lo : ℝ) := by simp [gu150, gu151]
        linarith
    by_cases h1 : x ≤ (gu151.top : ℝ)
    · exact s1.2 x hx1 h1
    · have hx2 : (gu152.lo : ℝ) < x := by
          have hb : (gu151.top : ℝ) = (gu152.lo : ℝ) := by simp [gu151, gu152]
          linarith
      by_cases h2 : x ≤ (gu152.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu153.lo : ℝ) < x := by
            have hb : (gu152.top : ℝ) = (gu153.lo : ℝ) := by simp [gu152, gu153]
            linarith
        exact s3.2 x hx3 htop

