set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open NLogN.KFU
open IntMul KFC AModel AModelL12
theorem solution {q' : ℕ} {K : ℝ} (hK : NLogN.KFU.SwOK q' K) (hK0 : 0 ≤ K) (w h d : ℕ) (hh : 1 ≤ h)
    (bL : ℕ → Bool) (sF μ : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (hst : ∀ j < d, sF j ≤ 2 ^ h)
    (Bb : ℕ) (hBb : NLogN.zsz ((2 * AModel.vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) : ℕ) : ℤ) ≤ Bb)
    (I : List NLogN.Sym) (ys : List ℤ) (hlen : ys.length = AModel.vol (NLogN.KFU.shR d (NLogN.KFU.tP d h bL))) (hb : NLogN.Bnd w ys)
    (t : NLogN.IState NLogN.HS) (R : List NLogN.Item) (h0 : t.G 0 = NLogN.ints ys ++ R) :
    ∃ c : ℕ, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFU.phiInvC q' w h d bL sF μ) t
      (t.upd 0 (NLogN.ints (NLogN.KFU.PhiInvD h d bL sF μ ys) ++ R)) c ∧
      (c : ℝ) ≤ NLogN.KFU.cPhi d w (AModel.vol (NLogN.KFU.shR d (NLogN.KFU.tP d h bL))) (AModel.vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)))
        (AModel.vol ((List.range (d - 1)).map sF)) Bb K h := by
  set SK := NLogN.KFU.shK d (NLogN.KFU.sP d sF) with hSK
  set TK := NLogN.KFU.shK d (NLogN.KFU.tP d h bL) with hTK
  set SR := NLogN.KFU.shR d (NLogN.KFU.sP d sF) with hSR
  set TR := NLogN.KFU.shR d (NLogN.KFU.tP d h bL) with hTR
  have hFK : List.Forall₂ (· ≤ ·) SK TK := NLogN.KFU.le_SK d h bL sF hst
  have hFR : List.Forall₂ (· ≤ ·) SR TR := NLogN.KFU.le_SR d h bL sF hst
  have hpK : ∀ a ∈ SK, 1 ≤ a := NLogN.KFU.pos_shK d sF hs
  have hpR : ∀ a ∈ SR, 1 ≤ a := NLogN.KFU.pos_shR d sF hs
  have hVT : AModel.vol TK = AModel.vol TR := NLogN.KFU.vol_shK d _
  -- 1. unpad
  have P1 := NLogN.KFU.unpadAll_spec (I := I) (iprog := NLogN.KFL.l12prog) SR TR hFR hpR w ys hlen hb t R h0
    (d + 1) (by rw [NLogN.KFU.length_shR])
  rw [NLogN.KFU.take_app_full (NLogN.KFU.length_shR d _) (NLogN.KFU.length_shR d _)] at P1
  set Y1 := AModelL12.extract SR TR 0 ys
  set t1 := t.upd 0 (NLogN.ints Y1 ++ R)
  -- 2. inverse shifts
  have P2 := NLogN.KFU.rotsBC_spec (I := I) (iprog := NLogN.KFL.l12prog) d sF hs (NLogN.KFU.csB sF μ) (NLogN.KFU.csB_ok d sF μ hs) w
    Bb hBb d le_rfl Y1 (by rw [AModelL12.length_extract]) (NLogN.KFU.bnd_pull _ _ _ hb) t1 R (by simp [t1])
  set Y2 := AModel.pull SR SR (NLogN.KFU.Gb sF (NLogN.KFU.csB sF μ) d) 0 Y1
  set t2 := t1.upd 0 (NLogN.ints Y2 ++ R)
  -- 3. pad
  have P3 := NLogN.KFU.padAll_spec (I := I) (iprog := NLogN.KFL.l12prog) SR TR hFR hpR w Y2 (by simp [Y2])
    (NLogN.KFU.bnd_pull _ _ _ (NLogN.KFU.bnd_pull _ _ _ hb)) t2 R (by simp [t2]) (d + 1) (by rw [NLogN.KFU.length_shR])
  rw [NLogN.KFU.take_app_full (NLogN.KFU.length_shR d _) (NLogN.KFU.length_shR d _)] at P3
  set Y3 := AModelL12.embed SR TR 0 Y2
  set t3 := t2.upd 0 (NLogN.ints Y3 ++ R)
  -- 4. reverse back
  obtain ⟨c4, P4, hc4⟩ := NLogN.KFU.rev_spec hK hK0 (NLogN.KFU.mzP d h) (NLogN.KFU.bgP d bL) (NLogN.KFU.mzP_pos d h) h hh
    (List.range d) d (NLogN.KFU.mzP_L d h _ (by simp)) (NLogN.KFU.bgP_d d bL) (NLogN.KFU.nodup_L d) w Y3
    (NLogN.KFU.bnd_embed _ _ (NLogN.KFU.bnd_pull _ _ _ (NLogN.KFU.bnd_pull _ _ _ hb))) (by simp only [Y3, AModelL12.length_embed]; rfl)
    I t3 R (by simp [t3])
  have e4 : AModel.pull ((List.range d ++ [d]).map (NLogN.KFU.tz (NLogN.KFU.mzP d h) (NLogN.KFU.bgP d bL)))
      (((List.range d).reverse ++ [d]).map (NLogN.KFU.tz (NLogN.KFU.mzP d h) (NLogN.KFU.bgP d bL)))
      (NLogN.KFU.revH (List.range d).length) 0 Y3 = AModel.pull TR TK (NLogN.KFU.revH d) 0 Y3 := by
    simp only [List.length_range]; rfl
  have eV4 : AModel.vol ((List.range d ++ [d]).map (NLogN.KFU.tz (NLogN.KFU.mzP d h) (NLogN.KFU.bgP d bL))) = AModel.vol TR := rfl
  rw [e4] at P4
  rw [eV4, List.length_range] at hc4
  set Y4 := AModel.pull TR TK (NLogN.KFU.revH d) 0 Y3
  set t4 := t3.upd 0 (NLogN.ints Y4 ++ R)
  -- 5. unpad
  have P5 := NLogN.KFU.unpadAll_spec (I := I) (iprog := NLogN.KFL.l12prog) SK TK hFK hpK w Y4 (by simp [Y4])
    (NLogN.KFU.bnd_pull _ _ _ (NLogN.KFU.bnd_embed _ _ (NLogN.KFU.bnd_pull _ _ _ (NLogN.KFU.bnd_pull _ _ _ hb)))) t4 R (by simp [t4])
    (d + 1) (by rw [NLogN.KFU.length_shK])
  rw [NLogN.KFU.take_app_full (NLogN.KFU.length_shK d _) (NLogN.KFU.length_shK d _)] at P5
  have e5 : AModelL12.extract SK TK 0 Y4 = AModel.pull SR SK (NLogN.KFU.revH d) 0 Y2 :=
    NLogN.KFU.extract_pull_embed' (AModelL12.shapeLE_of_forall₂ hFR) (AModelL12.shapeLE_of_forall₂ hFK) (NLogN.KFU.revH d)
      (fun a ha => NLogN.KFU.valid_revH_KR d _ ha) 0 Y2
  rw [e5] at P5
  refine ⟨_, (P1.seq (P2.seq (P3.seq (P4.seq P5)))).mono' ?_ le_rfl, ?_⟩
  · simp only [t4, t3, t2, t1, NLogN.IState.upd_upd_same]; rfl
  · rw [hVT]
    simp only [← hSR]
    unfold NLogN.KFU.cPhi
    push_cast
    linarith
end
