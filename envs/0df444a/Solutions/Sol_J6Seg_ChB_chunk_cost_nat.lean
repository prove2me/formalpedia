namespace J6Seg.ChB
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 J6Seg J6Seg.KR

/-- The arithmetic of the chunk pass. -/
theorem chunk_arith {V lam T Ck S Y Bk K pnL pre NC Tot : ℕ}
    (hK : K ≤ V * Ck + 100000 * (Bk + 2) * (V * (lam + 1) + pnL + pre * (Tot + 2) + NC + 2))
    (hl : 1 ≤ lam) (hV : V * lam ≤ T)
    (hCk : Ck = 10 ^ 9 * (lam + 1) * S + 2 * lam * Y + 10 ^ 4 + 2)
    (hpnL : pnL ≤ 19 * T) (hTot : pre * Tot ≤ 19 * T) (hpre : pre ≤ T) (hNC : NC ≤ 2 * T)
    (hT1 : 1 ≤ T) :
    K ≤ T * (2 * 10 ^ 9 * S + 2 * Y + 10 ^ 4 + 2 + 5000000 * (Bk + 2)) := by
  have hCk' : Ck ≤ lam * (2 * 10 ^ 9 * S + 2 * Y + 10 ^ 4 + 2) := by
    rw [hCk]
    have h1 : (lam + 1) * S ≤ 2 * lam * S := Nat.mul_le_mul_right _ (by omega)
    have e : lam * (2 * 10 ^ 9 * S + 2 * Y + 10 ^ 4 + 2) =
        10 ^ 9 * (2 * lam * S) + 2 * lam * Y + (10 ^ 4 + 2) * lam := by ring
    have e2 : 10 ^ 9 * (lam + 1) * S = 10 ^ 9 * ((lam + 1) * S) := by ring
    rw [e, e2]
    have h3 : 10 ^ 9 * ((lam + 1) * S) ≤ 10 ^ 9 * (2 * lam * S) := Nat.mul_le_mul_left _ h1
    have h4 : 10 ^ 4 + 2 ≤ (10 ^ 4 + 2) * lam := Nat.le_mul_of_pos_right _ hl
    omega
  have a1 : V * Ck ≤ T * (2 * 10 ^ 9 * S + 2 * Y + 10 ^ 4 + 2) := by
    calc V * Ck ≤ V * (lam * (2 * 10 ^ 9 * S + 2 * Y + 10 ^ 4 + 2)) := Nat.mul_le_mul_left _ hCk'
      _ = (V * lam) * (2 * 10 ^ 9 * S + 2 * Y + 10 ^ 4 + 2) := by ring
      _ ≤ T * (2 * 10 ^ 9 * S + 2 * Y + 10 ^ 4 + 2) := Nat.mul_le_mul_right _ hV
  have a2 : V * (lam + 1) ≤ 2 * T := by
    have : V * (lam + 1) ≤ V * (2 * lam) := Nat.mul_le_mul_left _ (by omega)
    have e : V * (2 * lam) = 2 * (V * lam) := by ring
    omega
  have a3 : V * (lam + 1) + pnL + pre * (Tot + 2) + NC + 2 ≤ 50 * T := by
    have e : pre * (Tot + 2) = pre * Tot + 2 * pre := by ring
    omega
  have a4 : 100000 * (Bk + 2) * (V * (lam + 1) + pnL + pre * (Tot + 2) + NC + 2) ≤
      100000 * (Bk + 2) * (50 * T) := Nat.mul_le_mul_left _ a3
  have e : T * (2 * 10 ^ 9 * S + 2 * Y + 10 ^ 4 + 2 + 5000000 * (Bk + 2)) =
      T * (2 * 10 ^ 9 * S + 2 * Y + 10 ^ 4 + 2) + 100000 * (Bk + 2) * (50 * T) := by ring
  rw [e]
  omega

section ax
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : Side.AxNum P n src D k)
include h

theorem chunk_cost_nat_sol_aux :
    kerC (cCk P n src k ap) (cBk P n src k ap) (2 ^ axfC6 P n) (axpost6 P n D k) (cLc P n)
      (axnc6 P n k) (tabsT (axTC6 P n src k ap) (axnc6 P n k)).length (axpre6 P n D k)
      (2 * (axpre6 P n D k * axnc6 P n k * axpost6 P n D k * 2 ^ axfC6 P n)) ≤
    TP6 P n * cY P n src k ap := by
  obtain ⟨hl1, hlQ⟩ := lam_facts h
  have hK := kerC_leN (cCk P n src k ap) (cBk P n src k ap) (2 ^ axfC6 P n) (axpost6 P n D k)
    (cLc P n) (axnc6 P n k) (tabsT (axTC6 P n src k ap) (axnc6 P n k)).length (axpre6 P n D k)
