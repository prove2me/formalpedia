theorem e18_enc_bits (X : ℕ) : ∀ A : ℕ,
    encode (binSh A) ((List.range A).reverse.map fun h => (getBit h X : ℕ)) = X % 2 ^ A
  | 0 => by simp [binSh, encode, Nat.mod_one]
  | A + 1 => by
    rw [List.range_succ, List.reverse_append, List.reverse_singleton, List.singleton_append,
      List.map_cons]
    have hb : binSh (A + 1) = 2 :: binSh A := by simp [binSh, List.replicate_succ]
    rw [hb]
    simp only [encode, List.headD_cons, List.tail_cons]
    rw [e18_enc_bits X A, vol_binSh, Nat.mod_pow_succ]
    simp only [getBit, Fin.val_mk]
    ring

theorem e18_pow_prod {ι : Type*} (b : ι → ℕ) : ∀ l : List ι,
    (l.map fun i => 2 ^ b i).prod = 2 ^ (l.map b).sum
  | [] => by simp
  | i :: l => by simp [e18_pow_prod b l, pow_add]

theorem e18_blocks {ι : Type*} (b : ι → ℕ) (w : ι → List ℕ) : ∀ l : List ι,
    (∀ i ∈ l, (w i).length = b i ∧ encode (binSh (b i)) (w i) < 2 ^ b i) →
    encode (binSh (l.map b).sum) (l.flatMap w) < 2 ^ (l.map b).sum ∧
    ∀ k (hk : k < l.length), digL (l.map fun i => 2 ^ b i)
      (encode (binSh (l.map b).sum) (l.flatMap w)) k = encode (binSh (b l[k])) (w l[k])
  | [], _ => ⟨by simp [binSh, encode], fun k hk => by simp at hk⟩
  | i :: l, h => by
    obtain ⟨ih1, ih2⟩ := e18_blocks b w l (fun j hj => h j (List.mem_cons_of_mem _ hj))
    obtain ⟨hl, hlt⟩ := h i (by simp)
    have hsum : ((i :: l).map b).sum = b i + (l.map b).sum := by simp
    have hsh : binSh ((i :: l).map b).sum = binSh (b i) ++ binSh (l.map b).sum := by
      rw [hsum]; unfold binSh; rw [List.replicate_add]
    have hfl : (i :: l).flatMap w = w i ++ l.flatMap w := by simp
    have henc : encode (binSh ((i :: l).map b).sum) ((i :: l).flatMap w) =
        encode (binSh (b i)) (w i) * 2 ^ (l.map b).sum +
          encode (binSh (l.map b).sum) (l.flatMap w) := by
      rw [hsh, hfl, AModelL12.encode_append_len _ _ (by simp [binSh, hl]), vol_binSh]
    rw [henc]
    have hS : 0 < 2 ^ (l.map b).sum := by positivity
    obtain ⟨d1, d2⟩ := div_mod_split hS hlt ih1
    refine ⟨?_, fun k hk => ?_⟩
    · rw [hsum, pow_add]
      calc encode (binSh (b i)) (w i) * 2 ^ (l.map b).sum +
            encode (binSh (l.map b).sum) (l.flatMap w)
          < encode (binSh (b i)) (w i) * 2 ^ (l.map b).sum + 2 ^ (l.map b).sum := by omega
        _ = (encode (binSh (b i)) (w i) + 1) * 2 ^ (l.map b).sum := by ring
        _ ≤ 2 ^ b i * 2 ^ (l.map b).sum := Nat.mul_le_mul_right _ hlt
    · rcases k with _ | k
      · simp only [List.map_cons, digL, List.getElem_cons_zero]
        rw [e18_pow_prod b l]; exact d1
      · simp only [List.map_cons, digL, List.getElem_cons_succ]
        rw [e18_pow_prod b l, d2]
        exact ih2 k (by simpa using hk)

