theorem sub_mvK' {σ : Fin HS → Option ℤ} {X Y C : Fin HS} (hX : σ X = none) (hY : σ Y = none)
    (n : Ex HS) : RS.sub σ (NLogN.mvK X Y C n) = NLogN.mvK X Y C (Ex.sub σ n) := by
  simp [NLogN.mvK, RS.sub, Ex.sub, hX]

/-! ## Truncation -/

theorem sub_truncU {σ : Fin HS → Option ℤ} (hoff : OffG σ) {xD xN : Fin HS} {Δ N : ℕ}
    (hD : σ xD = some ((2 : ℤ) ^ Δ)) (hN : σ xN = some (N : ℤ)) :
    RS.sub σ (truncU xD xN) = truncP Δ N := by
  have h0 : σ 0 = none := hoff 0 (by decide)
  have hrN : σ rN = none := hoff rN (by decide)
  have hqO : σ qO = none := hoff qO (by decide)
  simp only [truncU, truncP, truncLoop, quoE, RS.sub, sub_mvK' hqO h0, Ex.sub, hD, hN, h0, hrN]

theorem noW_truncU {σ : Fin HS → Option ℤ} (hoff : OffG σ) (xD xN : Fin HS) :
    NoW σ (truncU xD xN) := by
  intro i hi
  apply hoff
  revert i
  simp only [truncU, NLogN.mvK, RS.writes, List.forall_mem_append, List.forall_mem_cons,
    List.append_nil, List.cons_append, List.nil_append]
  and_intros <;> first | decide | (intro x hx; simp at hx)

section Trunc

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- **Uniform truncation** as a fixed run. -/
theorem runQ_truncU {σ : Fin HS → Option ℤ} (hlt : ∀ i v, σ i = some v → i.val < 56)
    (hoff : OffG σ) {xD xN : Fin HS} {r p Δ w : ℕ}
    (hD : σ xD = some ((2 : ℤ) ^ Δ)) (f : Fin HS → List ℤ) (zs : List GI)
    (xs : List (Fin r → ℂ)) (l : List ℤ) (hN : σ xN = some ((2 * zs.length : ℕ) : ℤ))
    (hx : RecRep r (p + Δ) zs xs) (h0 : f 0 = gflat zs ++ l) (hC : Clean0 f) (hb : GB w zs)
    (Z : ℕ) (hZ : zsz ((2 * zs.length : ℕ) : ℤ) ≤ Z) :
    RecRep r p (zs.map (gtr Δ)) (Butterfly.QpArr p xs) ∧ GB w (zs.map (gtr Δ)) ∧
    RunQ I iprog σ (fcode (truncU xD xN)) f
      (Function.update f 0 (gflat (zs.map (gtr Δ)) ++ l))
      (400 * (cTrunc w Δ (2 * zs.length) Z + 0)) := by
  refine ⟨truncP_rep hx, GB_map_gtr hb, fun s hs => ?_⟩
  have hag : Agree σ (encK s f) := agree_clean0 (hoff 0 (by decide)) hs hC
  obtain ⟨-, -, F⟩ := truncP_rec s f zs xs l hx h0 hC.clN.cl hb Z hZ
  have hO : HRef (truncP Δ (2 * zs.length)) (RS.sub σ (truncU xD xN)) 0 := by
    rw [sub_truncU hoff hD hN]; exact HRef.refl _
  exact (FSp.uni (sclean_of_lt hlt) (noW_truncU hoff xD xN) hO hag F).irun
    (fok_uni (noW_truncU hoff xD xN) hO (fok_truncP _ _))

end Trunc

