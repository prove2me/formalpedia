-- title:
--   §2.3, (7) — Fejér inequality: ‖xⁿ⁺¹ − x̄‖² ≤ ‖xⁿ − x̄‖² − ‖xⁿ⁺¹ − xⁿ‖² for x̄ ∈ M
-- statement:
--   Let $H$ be a real Hilbert space, $C\subseteq H$ convex, closed and bounded, $T:H\to H'$ monotone and hemicontinuous on $C$, and let $(x^n)$ be a sequence generated by the regularization algorithm (2) from $x^0\in C$. Let $\bar x\in M$ be any solution of (1) and set $d^n=\|x^n-\bar x\|^2$. Then for every $n\ge 0$
--   $$
--   d^{n+1}\le d^n-\|x^{n+1}-x^n\|^2 .
--   $$
--
--   Consequently the distances to every solution are nonincreasing (Fejér monotonicity), which drives Lemme 1.
--
--   **Formalization Note.** $\bar x\in M$ is a hypothesis, as in the paper ("Soit $\bar x\in M$ quelconque"). The standing hypotheses of §2.1 are bundled in `Standing T C`, and `IsRegSeq T C x` says $x^0\in C$ and every step satisfies (2).
-- source:
--   Martinet, Régularisation d'inéquations variationnelles par approximations successives, R.I.R.O. 4(R-3) (1970), p. 156, §2.3, (7) (dⁿ defined on p. 155)

import Mathlib
import Definitions.Def_MartinetReg_VI_Setting

namespace MartinetReg.VI

open Filter Topology

/-- §2.3, (7), p. 156: with `dⁿ = ‖xⁿ − x̄‖²` for a solution `x̄ ∈ M`,
`dⁿ⁺¹ ≤ dⁿ − ‖xⁿ⁺¹ − xⁿ‖²`. -/
theorem eq7 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : H → StrongDual ℝ H) (C : Set H) (hS : Standing T C)
    (x : ℕ → H) (hx : IsRegSeq T C x) (xbar : H) (hxbar : xbar ∈ solSet T C) (n : ℕ) :
    ‖x (n + 1) - xbar‖ ^ 2 ≤ ‖x n - xbar‖ ^ 2 - ‖x (n + 1) - x n‖ ^ 2 := by sorry

end MartinetReg.VI
