theorem Defm.bc_comp {B B' B'' : Type} [CommRing B] [CommRing B'] [CommRing B''] {ρ : B →+* ResidueField O}
    {ρ' : B' →+* ResidueField O} {ρ'' : B'' →+* ResidueField O} (f : B →+* B') (g : B' →+* B'')
    (hf : ρ'.comp f = ρ) (hg : ρ''.comp g = ρ') (hgf : ρ''.comp (g.comp f) = ρ) (x : Defm E₀ B ρ) :
    Defm.Rel ((x.bc f hf).bc g hg) (x.bc (g.comp f) hgf) := by
  refine Defm.rel_bc (g.comp f) hgf x _ (bcK g (x.bc f hf).E ≫ bcK f x.E) ?_ ?_
  · exact FakeEllipticCurve.IsPullbackVia.comp f g x.E (bcE f x.E) (bcE g (bcE f x.E)) (bcK f x.E) (bcK g _)
      (bcK_spec f x.E).1 (bcK_spec g _).1
  · rw [← Category.assoc, Defm.bc_g_comp, Defm.bc_g_comp]

theorem Defm.bc_congr {B B' : Type} [CommRing B] [CommRing B'] {ρ : B →+* ResidueField O} {ρ' : B' →+* ResidueField O}
    {f f' : B →+* B'} (e : f = f') (hf : ρ'.comp f = ρ) (hf' : ρ'.comp f' = ρ) (x : Defm E₀ B ρ) :
    Defm.Rel (x.bc f hf) (x.bc f' hf') := by
  subst e; exact Defm.Rel.refl _

def Hobj (E₀ : FakeEllipticCurve Λ 1 (ResidueField O)) (B : Type) [CommRing B] (ψ : O →+* B) : Type 1 :=
  ∀ ρ : Adm B ψ, DefCl E₀ B ρ.1

def Hmap {B B' : Type} [CommRing B] [CommRing B'] {ψ : O →+* B} {ψ' : O →+* B'} (f : B →+* B') (hf : f.comp ψ = ψ')
    (x : Hobj E₀ B ψ) : Hobj E₀ B' ψ' :=
  fun ρ' => Quotient.map' (fun d => Defm.bc f rfl d) (fun _ _ r => Defm.bc_rel f rfl r) (x (Adm.comap f hf ρ'))

theorem Hmap_mk {B B' : Type} [CommRing B] [CommRing B'] {ψ : O →+* B} {ψ' : O →+* B'} (f : B →+* B') (hf : f.comp ψ = ψ')
    (x : ∀ ρ : Adm B ψ, Defm E₀ B ρ.1) (ρ' : Adm B' ψ') :
    Hmap f hf (fun ρ => (⟦x ρ⟧ : DefCl E₀ B ρ.1)) ρ' = ⟦(x (Adm.comap f hf ρ')).bc f rfl⟧ := rfl

theorem Hmap_id_aux {B : Type} [CommRing B] {ψ : O →+* B} (x : Hobj E₀ B ψ) (σ ρ' : Adm B ψ) (e : σ = ρ')
    (hf : ρ'.1.comp (RingHom.id B) = σ.1) :
    Quotient.map' (fun d => Defm.bc (RingHom.id B) hf d) (fun _ _ r => Defm.bc_rel (RingHom.id B) hf r) (x σ) = x ρ' := by
  subst e
  obtain ⟨d, hd⟩ := Quotient.exists_rep (x σ)
  rw [← hd]
  exact Quotient.sound (Defm.bc_id d)

theorem Hmap_id {B : Type} [CommRing B] {ψ : O →+* B} (x : Hobj E₀ B ψ) :
    Hmap (RingHom.id B) (RingHom.id_comp ψ) x = x := by
  funext ρ'
  exact Hmap_id_aux x (Adm.comap (RingHom.id B) (RingHom.id_comp ψ) ρ') ρ' (Subtype.ext (RingHom.comp_id _)) rfl

theorem Hmap_comp_aux {B B' B'' : Type} [CommRing B] [CommRing B'] [CommRing B'']
    {ψ : O →+* B} {ρ' : B' →+* ResidueField O} {ρ'' : B'' →+* ResidueField O}
    (g : B' →+* B'') (f : B →+* B') (x : Hobj E₀ B ψ) (σ₁ σ₂ : Adm B ψ) (e : σ₂ = σ₁)
    (h₁ : ρ''.comp (g.comp f) = σ₁.1) (h₂ : ρ''.comp g = ρ') (h₃ : ρ'.comp f = σ₂.1) :
    Quotient.map' (fun d => Defm.bc (g.comp f) h₁ d) (fun _ _ r => Defm.bc_rel (g.comp f) h₁ r) (x σ₁) =
      Quotient.map' (fun d => Defm.bc g h₂ d) (fun _ _ r => Defm.bc_rel g h₂ r)
        (Quotient.map' (fun d => Defm.bc f h₃ d) (fun _ _ r => Defm.bc_rel f h₃ r) (x σ₂)) := by
  subst e
  obtain ⟨d, hd⟩ := Quotient.exists_rep (x σ₂)
  rw [← hd]
  exact (Quotient.sound (Defm.bc_comp f g h₃ h₂ h₁ d)).symm

theorem Hmap_comp {B B' B'' : Type} [CommRing B] [CommRing B'] [CommRing B'']
    {ψ : O →+* B} {ψ' : O →+* B'} {ψ'' : O →+* B''} (g : B' →+* B'') (f : B →+* B') (hf : f.comp ψ = ψ')
    (hg : g.comp ψ' = ψ'') (x : Hobj E₀ B ψ) :
    Hmap (g.comp f) (by rw [RingHom.comp_assoc, hf, hg]) x = Hmap g hg (Hmap f hf x) := by
  funext ρ''
  exact Hmap_comp_aux g f x (Adm.comap (g.comp f) (by rw [RingHom.comp_assoc, hf, hg]) ρ'')
    (Adm.comap f hf (Adm.comap g hg ρ'')) (Subtype.ext (RingHom.comp_assoc _ _ _).symm) rfl rfl rfl

def Gpt (B : Type) [CommRing B] (ψ : O →+* B) : Type :=
  {χ : PowerSeries O →+* B // χ.comp (algebraMap O (PowerSeries O)) = ψ ∧ IsNilpotent (χ PowerSeries.X)}

def Gobj (B : Type) [CommRing B] (ψ : O →+* B) : Type := Adm B ψ → Gpt B ψ

def Gmap {B B' : Type} [CommRing B] [CommRing B'] {ψ : O →+* B} {ψ' : O →+* B'} (f : B →+* B') (hf : f.comp ψ = ψ')
    (x : Gobj B ψ) : Gobj B' ψ' :=
  fun ρ' => ⟨f.comp (x (Adm.comap f hf ρ')).1, by rw [RingHom.comp_assoc, (x _).2.1, hf],
    by rw [RingHom.comp_apply]; exact (x _).2.2.map f⟩

theorem Gmap_id {B : Type} [CommRing B] {ψ : O →+* B} (x : Gobj B ψ) : Gmap (RingHom.id B) (RingHom.id_comp ψ) x = x := by
  funext ρ
  have : Adm.comap (RingHom.id B) (RingHom.id_comp ψ) ρ = ρ := Subtype.ext (RingHom.comp_id _)
  apply Subtype.ext
  show (RingHom.id B).comp (x (Adm.comap (RingHom.id B) (RingHom.id_comp ψ) ρ)).1 = (x ρ).1
  rw [this, RingHom.id_comp]

theorem Gmap_comp {B B' B'' : Type} [CommRing B] [CommRing B'] [CommRing B'']
    {ψ : O →+* B} {ψ' : O →+* B'} {ψ'' : O →+* B''} (g : B' →+* B'') (f : B →+* B') (hf : f.comp ψ = ψ')
    (hg : g.comp ψ' = ψ'') (x : Gobj B ψ) :
    Gmap (g.comp f) (by rw [RingHom.comp_assoc, hf, hg]) x = Gmap g hg (Gmap f hf x) := by
  funext ρ
  apply Subtype.ext
  show (g.comp f).comp (x _).1 = g.comp (f.comp (x _).1)
  have : Adm.comap (g.comp f) (by rw [RingHom.comp_assoc, hf, hg]) ρ = Adm.comap f hf (Adm.comap g hg ρ) :=
    Subtype.ext (RingHom.comp_assoc _ _ _).symm
  rw [RingHom.comp_assoc, this]

