-- title:
--   Remark 1: replacing H by R
-- statement:
--   Put $R=P^2H=2^{-1/2}\begin{pmatrix}1&1\\-1&1\end{pmatrix}$. Select shortest $R/P$ words once for the exact matrices generated by $R$ and $P$. Let $\mathcal N_R$ use those tails and the Definition 7 grammar with $R$ replacing $H$. For every $R/P/T$ word $C$,
--
--   $$\exists!\,D\in\mathcal N_R:\quad f_{u,R}(D)=f_{u,R}(C).$$
--
--   The map $f_{u,R}$ evaluates the printed product with $R$ as the first basis letter. Equality includes global phase. This is the alternate-basis canonical representation asserted by the remark; no runtime or gate-count optimality assertion is added.
-- source:
--   Representation of Quantum Circuits with Clifford and $π/8$ Gates, arXiv:0806.3834v1, PDF p. 6, Remark 1: replacing H by R

import Definitions.Def_QAlgorithms_Papers_Independent_Gap48_P12

noncomputable section

namespace QAlgorithms.Papers.Independent.Gap48.P12

local notation "Mat" => Matrix Bool Bool ℂ

local notation "Vec" => EuclideanSpace ℂ Bool

local notation "wordMatrix" => fun (B : CircuitBasis) (w : CircuitWord) =>
  QAlgorithms.Papers.Independent.Next46.P21.wordMatrix (chronologicalInstructions B w)

/-- PDF p.6, Remark 1: replace H by R throughout the grammar and reselect
shortest R/P tails. This asserts no time bound or H-count optimality. -/
theorem r_basis_unique_normal_form (reps : Representatives .rp) (C : CircuitWord) :
    ∃! D : CircuitWord, IsNormalWord .rp reps D ∧ wordMatrix .rp D = wordMatrix .rp C := by sorry

end QAlgorithms.Papers.Independent.Gap48.P12

end
