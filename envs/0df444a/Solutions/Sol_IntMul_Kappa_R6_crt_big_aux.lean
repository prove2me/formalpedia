-- Source module: Solutions.R6CrtNeed
/-!
# CRT reversal §12: **`CrtNeed6`**

`crtNeed6 : ∀ P, P.Ok → CrtNeed6 P`.

The table is `mTab4 tab ext₁ ext0 ext0 ext0 own` with `ext₁` the table of `IL.SwapNeedτ tab P.τ`
and `own = [phiFE, phiBE]` (KFUU's uniform `Φ`, `Φ⁻¹` with the reversal `revE`, whose phase 2 uses
three composite swaps of `h⌊d/2⌋`-bit digits and six digit-selector rotation sets instead of
KFUU's `⌊d/2⌋` single-digit swaps). `RowUCP` is not used.

Cost: `c ≤ C₀ · T p · Ncost6` with `A = 0`, from

* the frozen part (`natCost`, `O((d+1) T p)` once `d + 1 ≤ 2^h`),
* the rest of `p2E` (`O((d+1) T p)` once `d + 1 ≤ 2^h` and `T ≥ poly(b)`),
* three composite swaps, each `≤ K (4 T p ℓ (d ln p)^τ + 96 T p)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFM AModel NLogN.KFUU NLogN.KFUU.R6Crt NLogN.KFU

noncomputable section

/-! ## Parameter facts -/

/-! ## Eventual sizes -/

theorem crt_d2 (P : Prm) (hP : P.Ok) {n : ℕ} (G : Good P n) (hb : 16 ≤ bP6 n) : 2 ≤ dP6 P n := by
  have hb1 : (16 : ℝ) ≤ bP6 n := by exact_mod_cast hb
  have hb0 : (0 : ℝ) < bP6 n := by linarith
  have h2e : (bP6 n : ℝ) ^ (1 : ℝ) ≤ (bP6 n : ℝ) ^ (2 * P.ε) :=
    Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith [hP.eps_ge])
  rw [Real.rpow_one] at h2e
  have hsq : (bP6 n : ℝ) ^ (2 * P.ε) = (bP6 n : ℝ) ^ P.ε * (bP6 n : ℝ) ^ P.ε := by
    rw [← Real.rpow_add hb0]; ring_nf
  have he : 0 ≤ (bP6 n : ℝ) ^ P.ε := (Real.rpow_pos_of_pos hb0 _).le
  have h4 : (4 : ℝ) ≤ (bP6 n : ℝ) ^ P.ε := by nlinarith
  have := G.d_ge
  have : (2 : ℝ) ≤ dP6 P n := by linarith
  exact_mod_cast this

/-- The eventual sizes, for an arbitrary constant `c` (kept abstract: `CU` is huge). -/
theorem crt_big_aux_sol_aux (P : Prm) (hP : P.Ok) (c : ℕ) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n →
    Good P n ∧ 2 ≤ dP6 P n ∧ 2 ≤ ℓP6 P n ∧ dP6 P n + 1 ≤ 2 ^ hN6 P n ∧
    (dP6 P n + 2) * (c * (3 * pP6 P n + 1) ^ 2 + 15 * pP6 P n + 10 ^ 4) ≤ TP6 P n := by
  obtain ⟨n₀, hG⟩ := params6_ok P hP
  obtain ⟨n₂, hℓ⟩ := ell_big P hP 2
  obtain ⟨B₀, hB₀⟩ := poly_le_two_pow_half (4 + 3 * P.x + 1)
  refine ⟨max (max n₀ n₂) (2 ^ (max (max B₀ 16) (3 * (361 * c + 90 + 10 ^ 4)))), fun n hn => ?_⟩
  have G := hG n (le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn)
  have Hl := hℓ n (le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn)
  have hbB : max (max B₀ 16) (3 * (361 * c + 90 + 10 ^ 4)) ≤ bP6 n :=
    lg_ge _ (le_trans (le_max_right _ _) hn)
  have hb16 : 16 ≤ bP6 n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hbB
  have hbB0 : B₀ ≤ bP6 n := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hbB
  have hbC : 3 * (361 * c + 90 + 10 ^ 4) ≤ bP6 n := le_trans (le_max_right _ _) hbB
  have hd2 := crt_d2 P hP G hb16
  have hdb := G.d_le_b
  -- `ℓ ≥ 2` and `d + 1 ≤ 2^h`
  have hm1 : Nat.log 2 (bP6 n) + 1 ≤ (Nat.log 2 (bP6 n) + 1) ^ 2 :=
    Nat.le_self_pow (by norm_num) _
  have hl : Nat.log 2 (bP6 n) + 2 ≤ ℓP6 P n := by omega
  have hdh : dP6 P n + 1 ≤ 2 ^ hN6 P n := by
    have h1 : bP6 n < 2 ^ (Nat.log 2 (bP6 n) + 1) := Nat.lt_pow_succ_log_self (by norm_num) _
    have h2 : 2 ^ (Nat.log 2 (bP6 n) + 1) ≤ 2 ^ hN6 P n :=
      Nat.pow_le_pow_right (by norm_num) (by unfold hN6; omega)
    omega
  -- `T` is large
  have hn2 : 2 ≤ n := by
    by_contra h
    push Not at h
    have hb4 : 4 ≤ bP6 n := G.b_ge
    interval_cases n <;> simp [bP6, IntMul.lg] at hb4
  have hlt := two_pow_b_lt hn2
  have hTb := G.T_lo
  have hb'1 : 1 ≤ b'P6 P n := b'P6_pos P n
  have hpow := hB₀ (bP6 n) hbB0
  generalize hbd : bP6 n = b at *
  generalize hb'd : b'P6 P n = b' at *
  have hb'e : b' = b ^ (1 + P.x) := by rw [← hb'd, ← hbd]; rfl
  have hp : pP6 P n = 6 * b' := by rw [← hb'd]; rfl
  rw [hp]
  generalize dP6 P n = d at *
  generalize TP6 P n = T at *
  have hpoly : (d + 2) * (c * (3 * (6 * b') + 1) ^ 2 + 15 * (6 * b') + 10 ^ 4) * b' ≤
      3 * (361 * c + 90 + 10 ^ 4) * b ^ (4 + 3 * P.x) := by
    have i1 : c * (3 * (6 * b') + 1) ^ 2 + 15 * (6 * b') + 10 ^ 4 ≤
        (361 * c + 90 + 10 ^ 4) * b' ^ 2 := by
      have j1 : (3 * (6 * b') + 1) ^ 2 ≤ 361 * b' ^ 2 := by nlinarith
      have j2 : c * (3 * (6 * b') + 1) ^ 2 ≤ c * (361 * b' ^ 2) := Nat.mul_le_mul_left c j1
      have j3 : 15 * (6 * b') ≤ 90 * b' ^ 2 := by nlinarith
      have j4 : 10 ^ 4 ≤ 10 ^ 4 * b' ^ 2 := Nat.le_mul_of_pos_right _ (by positivity)
      have e : (361 * c + 90 + 10 ^ 4) * b' ^ 2 = c * (361 * b' ^ 2) + 90 * b' ^ 2 + 10 ^ 4 * b' ^ 2 := by
        ring
      linarith
    have i2 : d + 2 ≤ 3 * b := by omega
    have i3 : b' ^ 3 * b = b ^ (4 + 3 * P.x) := by
      rw [hb'e, ← pow_mul, ← pow_succ]; congr 1; ring
    calc (d + 2) * (c * (3 * (6 * b') + 1) ^ 2 + 15 * (6 * b') + 10 ^ 4) * b'
        ≤ (3 * b) * ((361 * c + 90 + 10 ^ 4) * b' ^ 2) * b' := Nat.mul_le_mul (Nat.mul_le_mul i2 i1) le_rfl
      _ = 3 * (361 * c + 90 + 10 ^ 4) * (b' ^ 3 * b) := by ring
      _ = 3 * (361 * c + 90 + 10 ^ 4) * b ^ (4 + 3 * P.x) := by rw [i3]
  have hbig : 3 * (361 * c + 90 + 10 ^ 4) * b ^ (4 + 3 * P.x) ≤ 2 ^ (b + 1) := by
    have h1 : 3 * (361 * c + 90 + 10 ^ 4) * b ^ (4 + 3 * P.x) ≤ b ^ (4 + 3 * P.x + 1) := by
      rw [pow_succ]; exact (Nat.mul_le_mul_right _ hbC).trans (le_of_eq (mul_comm _ _))
    have h2 : 2 ^ (b / 2) ≤ 2 ^ (b + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
    calc 3 * (361 * c + 90 + 10 ^ 4) * b ^ (4 + 3 * P.x) ≤ b ^ (4 + 3 * P.x + 1) := h1
      _ ≤ 8 * b ^ (4 + 3 * P.x + 1) := Nat.le_mul_of_pos_left _ (by norm_num)
      _ ≤ 2 ^ (b / 2) := hpow
      _ ≤ 2 ^ (b + 1) := h2
  have hTn : 2 ^ (b + 1) ≤ T * b' := by
    have : 2 ^ (b + 1) = 4 * 2 ^ (b - 1) := by
      rw [show b + 1 = (b - 1) + 2 by omega, pow_add]; ring
    omega
  have hT : (d + 2) * (c * (3 * (6 * b') + 1) ^ 2 + 15 * (6 * b') + 10 ^ 4) ≤ T :=
    Nat.le_of_mul_le_mul_right (le_trans hpoly (le_trans hbig hTn)) (by omega)
  exact ⟨G, hd2, by omega, hdh, hT⟩

