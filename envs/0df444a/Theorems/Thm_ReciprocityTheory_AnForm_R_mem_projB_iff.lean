variable {K : Type} [Fintype K] [Nonempty K] {ι : K → Type} [∀ k, Fintype (ι k)]

theorem ReciprocityTheory.AnForm.R.mem_projB_iff {P D : Ideal (MvPolynomial (Σ k, ι k) ℂ)} (hP : IsMultiHomogIdeal P)
    (hD : IsMultiHomogIdeal D) (p : (k : K) → ι k) (x : projX P hP) (hx : x ∈ (chartOpen hP p).1) :
    x ∈ projB P D hP ↔
      ∀ f ∈ D, (projX P hP).evaluation _ x hx ((gammaChart hP p).symm (Ideal.Quotient.mk _ f)) = 0 := by sorry
