    simp only [List.cons_append, dcomY, List.length_cons, add_left_inj] at h ⊢
    rw [dcomY_snoc F n E (i + 1) A B a b h]
    simp only [List.cons.injEq, true_and]
    congr 5; ring_nf
  | _, [], _ :: _, _, _, h => by simp at h
  | _, _ :: _, [], _, _, h => by simp at h

