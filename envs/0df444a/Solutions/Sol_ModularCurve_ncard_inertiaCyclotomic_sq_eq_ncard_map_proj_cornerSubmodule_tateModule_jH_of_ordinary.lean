  have := PadicInt.toZMod_spec (a p σ)
  rw [ZMod.cast_eq_val, PadicInt.maximalIdeal_eq_span_p, Ideal.mem_span_singleton] at this
  exact this

theorem exists_inertia_toZMod_a_ne_one (hp2 : p ≠ 2)
    (Pl : ValuationSubring (AlgebraicClosure ℚ)) (hPl : Pl.LiesOverPrime p) :
    ∃ τ₀ ∈ Pl.inertiaSubgroupIn ℚ, ¬ (p : ℤ_[p]) ∣ a p τ₀ - 1 := by
