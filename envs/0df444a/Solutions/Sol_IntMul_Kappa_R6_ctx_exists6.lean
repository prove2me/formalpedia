theorem ctx_exists6_sol_aux {E : ℕ} (P : Prm) (ix : Ix6 (7 + E)) (tab : Fin 1 → IStmt HS 1)
    (extM : Fin E → IStmt HS (7 + E))
    (ext₂ : Fin ix.P₂ → IStmt HS (7 + ix.P₂))
    (hp₂ : ∀ j, IL.kTableP tab extM (ix.g₂ j) = (IL.kTableP tab ext₂ j).ren id ix.g₂)
    (ext₃ : Fin ix.P₃ → IStmt HS (7 + ix.P₃))
    (hp₃ : ∀ j, IL.kTableP tab extM (ix.g₃ j) = (IL.kTableP tab ext₃ j).ren id ix.g₃)
    (ext₄ : Fin ix.P₄ → IStmt HS (7 + ix.P₄))
    (hp₄ : ∀ j, IL.kTableP tab extM (ix.g₄ j) = (IL.kTableP tab ext₄ j).ren id ix.g₄)
    (CΦ CL CC : ℝ) (AΦ AL AC n₁Φ n₁L n₁C : ℕ)
    (hdΦ : ix.dSΦ ≠ 0) (hdL : ix.dSL ≠ 0) (hdC : ix.dSC ≠ 0)
    (HΦ : ∀ (Isym : List Sym) (n : ℕ), n₁Φ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src →
      phiG6 Isym (IL.kTableP tab ext₂) ix.eF ix.eI ix.dSΦ CΦ AΦ ⟨P, n, src⟩)
    (HL : ∀ n, n₁L ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
      ∀ [∀ i, NeZero (sD6 src D i)] [∀ i, NeZero (tD6 P n D i)],
      ∃ M : AxisMaps6 (αN6 P n) (sD6 src D) (tD6 P n D),
        ∀ Isym, lineG6 Isym (IL.kTableP tab ext₃) ix.eA ix.eB ix.dSL CL AL ⟨P, n, src⟩ D M)
    (HC : ∀ (Q : Q6), Q.P = P → QOk Q → n₁C ≤ Q.n → ∀ (D : ℕ), Q.d = D + 1 →
      ∀ [∀ i, NeZero (Q.tB D i)],
      ∃ (θt θit at' bt : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ) (ζ : ℂ),
        ζ ^ Q.tB D (Fin.last D) = -1 ∧
        Phases Q.p (twX (Q.tB D) ζ) θt ∧
        Phases Q.p (fun j => (twX (Q.tB D) ζ j)⁻¹) θit ∧
        Phases Q.p (fun j => (starRingEnd ℂ) (chirp (Q.sB D) (Q.tB D) j)) at' ∧
        Phases Q.p (chirp (Q.sB D) (Q.tB D)) bt ∧
        Grid Q.p bt ∧
        ∀ Isym, chirpG6 Isym (IL.kTableP tab ext₄) ix.eC ix.dSC CC AC Q D θt θit at' bt)
    (n : ℕ) (src : ℕ → ℕ) (hQ : QOk ⟨P, n, src⟩) (h1 : n₁Φ ≤ n) (h2 : n₁L ≤ n) (h3 : n₁C ≤ n)
    (D : ℕ) (hD : dP6 P n = D + 1) :
    ∃ (iS : ∀ i, NeZero (sD6 src D i)) (iT : ∀ i, NeZero (tD6 P n D i)), ∀ Isym,
      ∃ C : BigCtx6 ix Isym tab extM ⟨P, n, src⟩ D, C.CΦ = CΦ ∧ C.AΦ = AΦ ∧
        C.BΦ = dzB (descPhi6 P n src) ∧ C.CL = CL ∧ C.AL = AL ∧ C.BL = dzB (descLine6 P n src) ∧
        C.CC = CC ∧ C.AC = AC ∧ C.BC = dzB (descChirp6 P n src) := by
  set Q : Q6 := ⟨P, n, src⟩ with hQd
  have hD' : Q.d = D + 1 := hD
  letI iS : ∀ i, NeZero (sD6 src D i) := fun i => ⟨(hQ.sB_pos hD' i).ne'⟩
  letI iT : ∀ i, NeZero (tD6 P n D i) := fun i => ⟨(hQ.tB_pos hD' i).ne'⟩
  refine ⟨iS, iT, fun Isym => ?_⟩
  obtain ⟨θt, θit, aTb, bt, ζ, hζ, hθ, hθi, ha, hb', hbg, hCg⟩ := HC Q rfl hQ h3 D hD'
  obtain ⟨M, hM⟩ := HL n h2 src hQ.src D hD
  have H : KFU.CrtOK (D + 1) Q.src Q.mu := by rw [← hD']; exact hQ.crtOK6
  exact ⟨BigCtx6.mk hQ hD' H ext₂ hp₂ CΦ AΦ hdΦ (HΦ Isym n h1 src hQ.src)
    (dzB (descPhi6 P n src)) (le_dzB _)
    ext₃ hp₃ CL AL hdL M (hM Isym) (dzB (descLine6 P n src)) (le_dzB _)
    ext₄ hp₄ CC AC hdC θt θit aTb bt ζ hζ hθ hθi ha hb' hbg (hCg Isym)
    (dzB (descChirp6 P n src)) (le_dzB _),
