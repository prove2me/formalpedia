    (hWB : ∀ W ∈ NLogN.Rsp.sTab p s t α, ∀ y ∈ W, NLogN.zsz y ≤ mm)
    (hAcc : (2 * HvdH.sWidth p α + 2) * 2 ^ (2 * mm) ≤ 2 ^ B) (hmB : 2 * mm ≤ B)
