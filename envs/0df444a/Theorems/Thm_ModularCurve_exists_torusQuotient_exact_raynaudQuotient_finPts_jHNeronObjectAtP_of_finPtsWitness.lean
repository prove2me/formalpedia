          x ∈ Set.range jv.base)

    (hjB : ∀ v, Function.Injective (Bialgebra.TensorProduct.map (BialgHom.id (ZMod p) (ZMod p)) (ψ v)))
    :
    ∃ (T : ℕ → Type) (_ : ∀ v, CommRing (T v)) (_ : ∀ v, HopfAlgebra (ZMod p) (T v))
