/-- A surjective submersion from a global smooth "filler" `σ x y` (a point of `M` over `y`
that equals `x` when `y = κ x`). -/
theorem isSurjSubmersionOn_of_filler {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F]
    (κ : E → F) (M : Set E) (N : Set F) (hmaps : Set.MapsTo κ M N) (hne : N.Nonempty → M.Nonempty)
    (σ : E → F → E) (hσ : ∀ x, ContDiff ℝ ∞ (σ x))
    (hσM : ∀ x ∈ M, ∀ y ∈ N, σ x y ∈ M ∧ κ (σ x y) = y) (hσx : ∀ x ∈ M, σ x (κ x) = x) :
    IsSurjSubmersionOn κ M N := by
  refine ⟨hmaps, fun y hy => ?_, fun x hx => ⟨Set.univ, isOpen_univ, trivial, σ x,
    (hσ x).contDiffOn, hσx x hx, fun y hy => hσM x hx y hy.2⟩⟩
  obtain ⟨x, hx⟩ := hne ⟨y, hy⟩
  exact ⟨σ x y, (hσM x hx y hy).1, (hσM x hx y hy).2⟩


