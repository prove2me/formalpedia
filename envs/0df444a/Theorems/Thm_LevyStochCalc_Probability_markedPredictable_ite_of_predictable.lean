theorem _root_.LevyStochCalc.Probability.markedPredictable_ite_of_predictable [SigmaFinite ν] {n : ℕ} {Λ : ℝ → Ω → Fin n → ℝ}
    (hΛ : Measurable[predictableSigma ℱ] fun p : ℝ × Ω => Λ p.1 p.2)
