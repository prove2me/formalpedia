-- title:
--   The crossed-action subgroup is normal and contains the commutator subgroup
-- statement:
--   Let $G$ and $H$ be finite-dimensional real Lie groups, let $t:H\to G$ be a smooth group homomorphism, and let $\alpha:G\times H\to H$ be a smooth action by group automorphisms. Assume the crossed-module identities
--   $$t(\alpha(g,h))=gt(h)g^{-1},\qquad \alpha(t(h),k)=hkh^{-1}.$$
--   Define $[G,H]$ as the ordinary subgroup generated by $h^{-1}\alpha(g,h)$ for $g\in G$ and $h\in H$. Then
--   $$[G,H]\trianglelefteq H,\qquad [H,H]\subseteq [G,H].$$
--   Here $[H,H]$ is the commutator subgroup. This supplies the algebraic normality and containment used to define the reduction; it makes no assertion that the generated subgroup is closed.
-- source:
--   Connections on non-abelian Gerbes and their Holonomy, arXiv:0808.1923v3, PDF p. 50, Lemma 5.2.1

import Definitions.Def_QAlgorithms_Papers_Independent_Bridge50_P09

namespace QAlgorithms.Papers.Independent.Bridge50.P09

open scoped Manifold ContDiff

/-- Lemma 5.2.1, PDF p. 50. For a smooth crossed module, the subgroup
`[G,H]` is normal in `H` and contains `[H,H]`. Smoothness is retained,
even though the conclusion is algebraic. -/
theorem actionCommutator_normal_contains_commutator
    {EG EH : Type*}
    [NormedAddCommGroup EG] [NormedSpace ℝ EG] [FiniteDimensional ℝ EG]
    [NormedAddCommGroup EH] [NormedSpace ℝ EH] [FiniteDimensional ℝ EH]
    {G H : Type*} [Group G] [Group H]
    [TopologicalSpace G] [TopologicalSpace H]
    [T2Space G] [T2Space H]
    [SecondCountableTopology G] [SecondCountableTopology H]
    [ChartedSpace EG G] [ChartedSpace EH H]
    [IsManifold (𝓘(ℝ, EG)) ∞ G] [IsManifold (𝓘(ℝ, EH)) ∞ H]
    [LieGroup (𝓘(ℝ, EG)) ∞ G] [LieGroup (𝓘(ℝ, EH)) ∞ H]
    (t : H →* G) (alpha : G →* MulAut H)
    (hCrossed : QAlgorithms.Papers.Independent.Renew46.P18.IsCrossedModule t alpha)
    (ht : ContMDiff (𝓘(ℝ, EH)) (𝓘(ℝ, EG)) ∞ t)
    (ha : ContMDiff ((𝓘(ℝ, EG)).prod (𝓘(ℝ, EH))) (𝓘(ℝ, EH)) ∞
      (fun p : G × H => alpha p.1 p.2)) :
    (actionCommutatorSubgroup (fun g h => alpha g h)).Normal ∧
      commutator H ≤ actionCommutatorSubgroup (fun g h => alpha g h) := by sorry

end QAlgorithms.Papers.Independent.Bridge50.P09
