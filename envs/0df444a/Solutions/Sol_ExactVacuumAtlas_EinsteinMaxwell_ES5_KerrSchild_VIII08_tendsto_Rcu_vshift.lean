/-! ## The continuous factor of the Green kernel -/

theorem kfun_eq_mul_gfun (j : ℝ) (q : ℝ → ℝ) (x : ℝ) :
    kfun j q x = x * gfun j q x := by
  unfold kfun gfun
  ring

theorem continuousOn_gfun {j : ℝ} {q : ℝ → ℝ} (hq : ContinuousOn q UG) {b : ℝ} (hb : b < aG) :
    ContinuousOn (gfun j q) (Icc (0:ℝ) b) := by
  have hB : ContinuousOn (Bfun j q) (Icc (0:ℝ) b) := continuousOn_Bfun_Icc hq hb
  have hsubK : Icc (0:ℝ) b ⊆ Icc (0:ℝ) (1 / 3) := by
    intro x hx
    have hb3 : b ≤ 1 / 3 := by simpa [aG] using le_of_lt hb
    exact ⟨hx.1, by linarith [hx.2]⟩
  have hA : ContinuousOn (fun x : ℝ => (1 - x) * AcK x ^ 2) (Icc (0:ℝ) b) :=
    (continuousOn_const.sub continuousOn_id).mul ((continuousOn_AcK.mono hsubK).pow 2)
  have hne : ∀ x ∈ Icc (0:ℝ) b, (1 - x) * AcK x ^ 2 ≠ 0 := by
    intro x hx
    have hxb : x ∈ Icc (0:ℝ) (1 / 3) := hsubK hx
    have h1 : (0:ℝ) < 1 - x := by linarith [hxb.2]
    have hApos : (0:ℝ) < AcK x := lt_of_lt_of_le (by norm_num) (AcK_ge_third hxb)
    exact mul_ne_zero (ne_of_gt h1) (pow_ne_zero 2 (ne_of_gt hApos))
  exact ContinuousOn.div hB hA hne

theorem gfun_zero {j : ℝ} {q : ℝ → ℝ} : gfun j q 0 = Bfun j q 0 / A0 ^ 2 := by
  unfold gfun
  rw [AcK_zero]
  norm_num

/-! ## A second-order Taylor lemma for `u ↦ ∫₀^u t g(t)` -/

/-! ## `B_s(0)` and the definition of `sigma_b` -/

/-- `B_s(0) = ∫₀^a AcK(t) s(t) dt`. -/
theorem Bfun_zero (j : ℝ) (q : ℝ → ℝ) : Bfun j q 0 = ∫ t in (0:ℝ)..aG, AcK t * sfun j q t := by
  have h := Bfun_subst (j := j) (q := q) (x := (0:ℝ))
  simpa using h

/-- `AcK` and `Ac` agree on `Ioc 0 a`, so the `AcK` and `Ac` forms of `B_s(0)` coincide. -/
theorem Bfun_zero_Ac (j : ℝ) (q : ℝ → ℝ) :
    Bfun j q 0 = ∫ t in (0:ℝ)..aG, Ac t * sfun j q t := by
  rw [Bfun_zero]
  refine intervalIntegral.integral_congr_ae (μ := volume) (a := (0:ℝ)) (b := aG) ?_
  have haG0 : (0:ℝ) ≤ aG := by have ha : aG = 1 / 3 := rfl; rw [ha]; norm_num
  filter_upwards with t ht
  rw [uIoc_of_le haG0] at ht
  rw [AcK_eq (ne_of_gt ht.1)]

theorem sigmaB_eq {j : ℝ} {q : ℝ → ℝ} : sigmaB j q = -(Bfun j q 0 / (2 * A0)) := by
  unfold sigmaB
  rw [Bfun_zero_Ac]

/-! ## `R^2 K_s(R) -> B_s(0)/(2 A0^2)` -/

theorem tendsto_inv_atTop_nhdsGT_zero : Tendsto (fun R : ℝ => (1:ℝ) / R) atTop (𝓝[>] (0:ℝ)) := by
  refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
  · simpa [one_div] using tendsto_inv_atTop_zero (𝕜 := ℝ)
  · filter_upwards [eventually_gt_atTop (0:ℝ)] with R hR
    exact div_pos zero_lt_one hR

theorem tendsto_Rsq_Kfun {j : ℝ} {q : ℝ → ℝ} (hq : ContinuousOn q UG) :
    Tendsto (fun R : ℝ => R ^ 2 * Kfun j q R) atTop (𝓝 (Bfun j q 0 / (2 * A0 ^ 2))) := by
  have hb : (1:ℝ) / 4 < aG := by
    have ha : aG = 1 / 3 := rfl
    rw [ha]; norm_num
  have hg := continuousOn_gfun (j := j) hq hb
  have hlim := tendsto_integral_mul_div_sq (g := gfun j q) (b := 1 / 4) (by norm_num) hg
  have hval : gfun j q 0 / 2 = Bfun j q 0 / (2 * A0 ^ 2) := by
    rw [gfun_zero]
    field_simp
  rw [hval] at hlim
  have hcomp := hlim.comp ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.tendsto_inv_atTop_nhdsGT_zero
  refine hcomp.congr' ?_
  filter_upwards [eventually_gt_atTop (0:ℝ)] with R hR
  have hR0 : R ≠ 0 := ne_of_gt hR
  have hk : (∫ t in (0:ℝ)..(1 / R), kfun j q t) = ∫ t in (0:ℝ)..(1 / R), t * gfun j q t :=
    intervalIntegral.integral_congr (fun t _ => kfun_eq_mul_gfun j q t)
  show (∫ t in (0:ℝ)..(1 / R), t * gfun j q t) / (1 / R) ^ 2 = R ^ 2 * Kfun j q R
  rw [← hk]
  unfold Kfun
  field_simp

/-! ## `R b_s(R) -> sigma_b` -/

/-- `R b_s(R) = -aY(R) · R² K_s(R)`. -/
theorem Rbfun_eq (j : ℝ) (q : ℝ → ℝ) (R : ℝ) :
    R * bfun j q R = -aY R * (R ^ 2 * Kfun j q R) := by
  rcases eq_or_ne R 0 with h | h
  · subst h
    unfold bfun aY
    simp
  · unfold bfun aY
    field_simp

/-- **The magnetic charge is the actual limit**: `R b_s(R) -> sigma_b`. -/
theorem tendsto_Rbfun {j : ℝ} {q : ℝ → ℝ} (hq : ContinuousOn q UG) :
    Tendsto (fun R : ℝ => R * bfun j q R) atTop (𝓝 (sigmaB j q)) := by
  have h1 : Tendsto (fun R : ℝ => -aY R) atTop (𝓝 (-A0)) := tendsto_aY_atTop.neg
  have h2 := tendsto_Rsq_Kfun (j := j) hq
  have hmul := h1.mul h2
  have hval : -A0 * (Bfun j q 0 / (2 * A0 ^ 2)) = sigmaB j q := by
    rw [sigmaB_eq]
    field_simp
  rw [hval] at hmul
  refine hmul.congr' ?_
  filter_upwards with R
  exact (Rbfun_eq j q R).symm

