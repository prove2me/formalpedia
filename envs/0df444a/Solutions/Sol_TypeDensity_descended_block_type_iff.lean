  have hback : ∀ τ, TypeDensity.HasPolynomialTypeF (AdjoinRoot Φ)
      (B.map (algebraMap _ (TypeDensity.BaseField (AdjoinRoot Φ)))) τ →
      TypeDensity.HasPolynomialTypeF O (TypeDensity.monicPolynomial O a) (TypeDensity.scaleType Φ.natDegree τ) := by
