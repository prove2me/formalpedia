open NLogN
open IntMul IntMul.HvdH IntMul.HvdH.Ref
set_option maxHeartbeats 2000000

theorem NLogN.encP_ok (M : MulSpec) (s : IState HS) (P : ℕ) (blk : List (ℤ × ℤ))
    (R LR LM LW LF : List Item)
    (F : ℤ) (hU : s.G GU = gints blk ++ R) (hR : s.G CR = .int (2 ^ P) :: LR)
    (hM : s.G CM = .int blk.length :: LM)
    (hW : s.G RW = .int (2 ^ (2 * blk.length * P)) :: LW) (hF : s.G FR = .int F :: LF) :
    encP.ok M s := by sorry
