section Composition

variable {g : Matrix (Fin 2) (Fin 2) ℝ}

private theorem norm_iteratedFDeriv_comp_log_rad_le (hg : g.det ≠ 0) {Ψ : ℝ → ℂ} (hΨ : ContDiff ℝ ∞ Ψ)
    {κ : ℝ} (hκ : 0 ≤ κ) (hΨd : ∀ (j : ℕ) (t : ℝ), ‖iteratedDeriv j Ψ t‖ ≤ κ ^ j * ‖Ψ t‖)
    {n i : ℕ} (hin : i ≤ n) (u : ℝ) :
    ‖iteratedFDeriv ℝ i (fun u => Ψ (Real.log (rad g u))) u‖
      ≤ n ! * (max 1 κ ^ n * ‖Ψ (Real.log (rad g u))‖) * towerD g n ^ n := by
  have hC : ∀ j, j ≤ i → ‖iteratedFDeriv ℝ j Ψ (Real.log (rad g u))‖
      ≤ max 1 κ ^ n * ‖Ψ (Real.log (rad g u))‖ := by
    intro j hj
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    refine (hΨd j _).trans (mul_le_mul_of_nonneg_right ?_ (norm_nonneg _))
    exact (pow_le_pow_left₀ hκ (le_max_right 1 κ) j).trans (pow_le_pow_right₀ (le_max_left 1 κ) (hj.trans hin))
  have hD : ∀ j, 1 ≤ j → j ≤ i → ‖iteratedFDeriv ℝ j (fun u => Real.log (rad g u)) u‖ ≤ towerD g n ^ j :=
    fun j hj1 hji => norm_iteratedFDeriv_log_rad_le hg hj1 (hji.trans hin) u
  have h := norm_iteratedFDeriv_comp_le (g := Ψ) (f := fun u => Real.log (rad g u)) (n := i)
    hΨ (contDiff_log_rad hg) (by exact_mod_cast le_top) u hC hD
  rw [Function.comp_def] at h
  refine h.trans ?_
  have hfac : (i ! : ℝ) ≤ n ! := by exact_mod_cast Nat.factorial_le hin
  have hpow : towerD g n ^ i ≤ towerD g n ^ n := pow_le_pow_right₀ (one_le_towerD n) hin
  have h0 : 0 ≤ max 1 κ ^ n * ‖Ψ (Real.log (rad g u))‖ := by positivity
  exact mul_le_mul (mul_le_mul_of_nonneg_right hfac h0) hpow (pow_nonneg (towerD_pos n).le _) (by positivity)

private theorem norm_iteratedFDeriv_comp_angle_le (hg : g.det ≠ 0) {c : ℝ → ℂ} (hc : ContDiff ℝ ∞ c)
    {Cc : ℝ} {n : ℕ} (hcb : ∀ j, j ≤ n → ∀ θ : ℝ, ‖iteratedDeriv j c θ‖ ≤ Cc)
    {i : ℕ} (hin : i ≤ n) (u : ℝ) :
    ‖iteratedFDeriv ℝ i (fun u => c (angle g u)) u‖ ≤ n ! * Cc * towerD g n ^ n := by
  have hCc : 0 ≤ Cc := (norm_nonneg _).trans (hcb 0 (Nat.zero_le n) (angle g u))
  have hC : ∀ j, j ≤ i → ‖iteratedFDeriv ℝ j c (angle g u)‖ ≤ Cc := by
    intro j hj
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    exact hcb j (hj.trans hin) _
  have hD : ∀ j, 1 ≤ j → j ≤ i → ‖iteratedFDeriv ℝ j (angle g) u‖ ≤ towerD g n ^ j :=
    fun j hj1 hji => norm_iteratedFDeriv_angle_le hg hj1 (hji.trans hin) u
  have h := norm_iteratedFDeriv_comp_le (g := c) (f := angle g) (n := i)
    hc (contDiff_angle hg) (by exact_mod_cast le_top) u hC hD
  rw [Function.comp_def] at h
  refine h.trans ?_
  have hfac : (i ! : ℝ) ≤ n ! := by exact_mod_cast Nat.factorial_le hin
  have hpow : towerD g n ^ i ≤ towerD g n ^ n := pow_le_pow_right₀ (one_le_towerD n) hin
  exact mul_le_mul (mul_le_mul_of_nonneg_right hfac hCc) hpow (pow_nonneg (towerD_pos n).le _) (by positivity)

private def kConst (n : ℕ) (κ Cc d : ℝ) : ℝ := 2 ^ n * ((n ! : ℝ) * max 1 κ ^ n * d ^ n) * ((n ! : ℝ) * Cc * d ^ n)

private theorem kConst_nonneg (n : ℕ) {κ Cc d : ℝ} (hCc : 0 ≤ Cc) (hd : 0 ≤ d) : 0 ≤ kConst n κ Cc d := by
  unfold kConst; positivity

private theorem kConst_mono (n : ℕ) {κ Cc d d' : ℝ} (hCc : 0 ≤ Cc) (hd : 0 ≤ d) (hdd' : d ≤ d') :
    kConst n κ Cc d ≤ kConst n κ Cc d' := by
  have hd' : 0 ≤ d' := hd.trans hdd'
  unfold kConst; gcongr

private theorem contDiff_mul_comp (hg : g.det ≠ 0) {Ψ c : ℝ → ℂ} (hΨ : ContDiff ℝ ∞ Ψ) (hc : ContDiff ℝ ∞ c) :
    ContDiff ℝ ∞ (fun u => Ψ (Real.log (rad g u)) * c (angle g u)) :=
  (hΨ.comp (contDiff_log_rad hg)).mul (hc.comp (contDiff_angle hg))

private theorem norm_iteratedDeriv_mul_comp_le (hg : g.det ≠ 0) {Ψ c : ℝ → ℂ} (hΨ : ContDiff ℝ ∞ Ψ)
    (hc : ContDiff ℝ ∞ c) {κ : ℝ} (hκ : 0 ≤ κ)
    (hΨd : ∀ (j : ℕ) (t : ℝ), ‖iteratedDeriv j Ψ t‖ ≤ κ ^ j * ‖Ψ t‖)
    {Cc : ℝ} {n : ℕ} (hcb : ∀ j, j ≤ n → ∀ θ : ℝ, ‖iteratedDeriv j c θ‖ ≤ Cc) (u : ℝ) :
    ‖iteratedDeriv n (fun u => Ψ (Real.log (rad g u)) * c (angle g u)) u‖
      ≤ kConst n κ Cc (towerD g n) * ‖Ψ (Real.log (rad g u))‖ := by
  have hCc : 0 ≤ Cc := (norm_nonneg _).trans (hcb 0 (Nat.zero_le n) (angle g u))
  have hd := towerD_pos (g := g) n
  rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  refine (norm_iteratedFDeriv_mul_le (hΨ.comp (contDiff_log_rad hg) : ContDiff ℝ ∞ fun u => Ψ (Real.log (rad g u)))
    (hc.comp (contDiff_angle hg) : ContDiff ℝ ∞ fun u => c (angle g u)) u (by exact_mod_cast le_top)).trans ?_
  have hP : ∀ i ∈ Finset.range (n + 1), ‖iteratedFDeriv ℝ i (fun u => Ψ (Real.log (rad g u))) u‖
      ≤ n ! * (max 1 κ ^ n * ‖Ψ (Real.log (rad g u))‖) * towerD g n ^ n :=
    fun i hi => norm_iteratedFDeriv_comp_log_rad_le hg hΨ hκ hΨd (Nat.lt_succ_iff.1 (Finset.mem_range.1 hi)) u
  have hQ : ∀ i ∈ Finset.range (n + 1), ‖iteratedFDeriv ℝ (n - i) (fun u => c (angle g u)) u‖
      ≤ n ! * Cc * towerD g n ^ n :=
    fun i _ => norm_iteratedFDeriv_comp_angle_le hg hc hcb (Nat.sub_le n i) u
  have h2 : ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) = 2 ^ n := by
    exact_mod_cast Nat.sum_range_choose n
  calc ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)
          * ‖iteratedFDeriv ℝ i (fun u => Ψ (Real.log (rad g u))) u‖
          * ‖iteratedFDeriv ℝ (n - i) (fun u => c (angle g u)) u‖
      ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)
          * (n ! * (max 1 κ ^ n * ‖Ψ (Real.log (rad g u))‖) * towerD g n ^ n)
          * (n ! * Cc * towerD g n ^ n) := by
        refine Finset.sum_le_sum fun i hi => ?_
        exact mul_le_mul (mul_le_mul_of_nonneg_left (hP i hi) (by positivity)) (hQ i hi) (norm_nonneg _)
          (by positivity)
    _ = (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ))
          * ((n ! * (max 1 κ ^ n * ‖Ψ (Real.log (rad g u))‖) * towerD g n ^ n) * (n ! * Cc * towerD g n ^ n)) := by
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun i _ => ?_
        ring
    _ = kConst n κ Cc (towerD g n) * ‖Ψ (Real.log (rad g u))‖ := by
        rw [h2]
        unfold kConst
        ring

private theorem _root_.M4aP3B.ScalarMajorant.norm_iteratedDeriv_le (hg : g.det ≠ 0) {Ψ c : ℝ → ℂ} (hΨ : ContDiff ℝ ∞ Ψ)
    (hc : ContDiff ℝ ∞ c) {κ : ℝ} (hκ : 0 ≤ κ)
    (hΨd : ∀ (j : ℕ) (t : ℝ), ‖iteratedDeriv j Ψ t‖ ≤ κ ^ j * ‖Ψ t‖)
    {Cc : ℝ} {n : ℕ} (hcb : ∀ j, j ≤ n → ∀ θ : ℝ, ‖iteratedDeriv j c θ‖ ≤ Cc)
    {M β : ℝ} (hβ : 0 ≤ β) (hM : ∀ t, ‖Ψ t‖ ≤ M * Real.exp (-β * t)) (u : ℝ) :
    ‖iteratedDeriv n (fun u => Ψ (Real.log (rad g u)) * c (angle g u)) u‖
      ≤ kConst n κ Cc (towerD g n) * Real.sqrt (radFloor g) ^ (-β) * M * max 1 |u| ^ (-β) := by
  have hCc : 0 ≤ Cc := (norm_nonneg _).trans (hcb 0 (Nat.zero_le n) (angle g u))
  have hM0 : 0 ≤ M := by
    have h := (norm_nonneg _).trans (hM 0)
    simpa using h
  have hk := kConst_nonneg n (κ := κ) hCc (towerD_pos (g := g) n).le
  calc ‖iteratedDeriv n (fun u => Ψ (Real.log (rad g u)) * c (angle g u)) u‖
      ≤ kConst n κ Cc (towerD g n) * ‖Ψ (Real.log (rad g u))‖ := norm_iteratedDeriv_mul_comp_le hg hΨ hc hκ hΨd hcb u
    _ ≤ kConst n κ Cc (towerD g n) * (M * (Real.sqrt (radFloor g) ^ (-β) * max 1 |u| ^ (-β))) := by
        refine mul_le_mul_of_nonneg_left ?_ hk
        exact (norm_le_rad_rpow hg hM u).trans (mul_le_mul_of_nonneg_left (rad_rpow_neg_le hg hβ u) hM0)
    _ = kConst n κ Cc (towerD g n) * Real.sqrt (radFloor g) ^ (-β) * M * max 1 |u| ^ (-β) := by ring

