-- ===== S4.Def_RP_EtPBC_A_O2R1 =====
section

/-!
# S4-EtPBC-A, O2 (MV route), M6a (1): the free sheaf on a coproduct is a biproduct; fibres of a coproduct

For a family `S : ι → P.Etale` with coproduct `cop S` (`Cech.cop`):
* `freeCop_hom_ext`: maps out of `Λ[cop S]` agree if they agree on every `Λ[S k]`;
* `copPr Λ S z : Λ[cop S] ⟶ Λ[S z]` with `copι_copPr_self`, `copι_copPr_ne`, **`sum_copPr`**
  (`Σ z, copPr z ≫ Λ[copι z] = 𝟙`);
* fibres: `fib_cop_surj` (every fibre point of `cop S` comes from some `S k`), `fib_cop_idx` (from one `k` only),
  `fib_cop_inj` (`copι k` is injective on fibres).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech

universe u

variable {Λ : Type u} [CommRing Λ] {P : Scheme.{u}} {ι : Type u} (S : ι → P.Etale)

section Fib

variable (x : P)

theorem fib_cop_surj (a : (geomPtAt x).point.fiber.obj (cop S)) :
    ∃ k b, (geomPtAt x).point.fiber.map (copι S k) b = a := by
  obtain ⟨k, s, hs⟩ := cop_jointly S (fpt x a)
  obtain ⟨b, hb, -⟩ := exists_lift_fib (copι S k) x a s hs
  exact ⟨k, b, hb⟩

theorem fib_cop_idx {k k' : ι} (b : (geomPtAt x).point.fiber.obj (S k))
    (b' : (geomPtAt x).point.fiber.obj (S k'))
    (h : (geomPtAt x).point.fiber.map (copι S k) b = (geomPtAt x).point.fiber.map (copι S k') b') : k = k' := by
  by_contra hkk
  have e : fl x b ≫ Sigma.ι (fun j => (S j).left) k = fl x b' ≫ Sigma.ι (fun j => (S j).left) k' :=
    congrArg (fun a => fl x a) h
  have hE := isEmpty_of_commSq_sigmaι_of_ne ⟨e⟩ hkk
  exact hE.false (default : Spec (CommRingCat.of (geomPtAt x).Ω))

theorem fib_cop_inj (k : ι) : Function.Injective ((geomPtAt x).point.fiber.map (copι S k)) := by
  intro b b' h
  have e : fl x b ≫ Sigma.ι (fun j => (S j).left) k = fl x b' ≫ Sigma.ι (fun j => (S j).left) k :=
    congrArg (fun a => fl x a) h
  have hm : Mono (Sigma.ι (fun j => (S j).left) k) := MonoCoprod.mono_ι _ k
  exact fiber_ext _ (hm.right_cancellation _ _ e)

end Fib

end RamanujanPetersson.EtPBC.EtMV

end

