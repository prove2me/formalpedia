-- Source module: Solutions.KFUURev2
/-!
# KFUU §2b: the layouts of the uniform reversal

The axes are `L = range n` with sizes `2^(u + b_j)` (`bs = [b_0, …]`), the inner block is the
atom `cid = n` of size `cz`: `mzB u n cz`, `bgB bs`. Phase 1 runs through `lay1 i`
(`i = n, …, 0`): `layA (L.take i) ++ mains (L.drop i) ++ bitsR (L.drop i) ++ [2n]`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU

open IntMul KIL KFC KFT KFU AModel AModelL12

theorem mzB_pos {u n cz : ℕ} (hcz : 1 ≤ cz) (j : ℕ) : 1 ≤ mzB u n cz j := by
  unfold mzB; split_ifs
  · exact Nat.one_le_two_pow
  · exact hcz

theorem bgB_n (bs : List Bool) : bgB bs bs.length = false := by
  simp [bgB]

theorem tz_lt {u cz : ℕ} {bs : List Bool} {j : ℕ} (hj : j < bs.length) :
    tz (mzB u bs.length cz) (bgB bs) j = 2 ^ (u + if bs[j] then 1 else 0) := by
  simp only [tz, mzB, bgB, if_pos hj, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hj,
    Option.getD_some]
  split_ifs <;> simp [pow_succ]

theorem tz_n (u cz : ℕ) (bs : List Bool) : tz (mzB u bs.length cz) (bgB bs) bs.length = cz := by
  simp [tz, mzB, bgB_n]

theorem asz_main {u cz : ℕ} {bs : List Bool} {j : ℕ} (hj : j < bs.length) :
    asz (mzB u bs.length cz) (2 * j) = 2 ^ u := by
  simp [asz, mzB, hj]

theorem asz_cid (u cz n : ℕ) : asz (mzB u n cz) (2 * n) = cz := by
  simp [asz, mzB]

theorem map_tz_range (u cz : ℕ) (bs : List Bool) :
    (List.range bs.length).map (tz (mzB u bs.length cz) (bgB bs)) = shP u bs := by
  apply List.ext_getElem (by simp [KFM.shPad])
  intro j h1 h2
  simp only [List.getElem_map, List.getElem_range, KFM.shPad]
  exact tz_lt (by simpa using h1)

theorem shape_in (u cz : ℕ) (bs : List Bool) :
    (List.range bs.length ++ [bs.length]).map (tz (mzB u bs.length cz) (bgB bs)) = shP u bs ++ [cz] := by
  rw [List.map_append, map_tz_range]; simp [tz_n]

/-! ## Phase 1 layouts -/

theorem layA_cid (bg : ℕ → Bool) {n : ℕ} (hn : bg n = false) :
    layA bg (List.range n ++ [n]) = layA bg (List.range n) ++ [2 * n] := by
  rw [layA_append]; simp [layA, atm, hn]

theorem lay1_perm (bg : ℕ → Bool) {n : ℕ} (hn : bg n = false) (i : ℕ) :
    List.Perm (lay1 bg n i) (layA bg (List.range n ++ [n])) := by
  rw [layA_cid bg hn]
  conv_rhs => rw [← List.take_append_drop i (List.range n), layA_append]
  have := perm_mid (layA bg ((List.range n).take i)) [2 * n] (perm_layA_R bg ((List.range n).drop i)).symm
  simpa [lay1, List.append_assoc] using this

/-! ## Volumes -/

theorem vol_lay1 {u cz : ℕ} {bs : List Bool} (i : ℕ) :
    vol ((lay1 (bgB bs) bs.length i).map (asz (mzB u bs.length cz))) = vol (shP u bs) * cz := by
  rw [vol_perm _ (lay1_perm (bgB bs) (bgB_n bs) i), vol_layA, shape_in, vol_append]; simp [vol]

/-! ## One step of phase 1 -/

theorem nodup_ax0 (n : ℕ) : (List.range n ++ [n]).Nodup := by
  rw [← List.range_succ]; exact List.nodup_range

end NLogN.KFUU

end

