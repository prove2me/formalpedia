    by_cases xQ : x = tbQ
    · subst xQ; simp +decide [f8, f7, F, NLogN.KFV.axF, pushT, Function.update_apply, f5, f4, f3, f2, f1]
    simp [f8, f7, F, NLogN.KFV.axF, pushT, Function.update_apply, f5, f4, f3, f2, f1, xC, xK, xL, xM, xG, xG2,
      xR, xV, xN, xQ]
  · have hB2 : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
    have hc := cost_reg_le (NLogN.KIL.encK s f7) NLogN.KFV.gD
    rw [H7.d.top] at hc
