set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL KFW KFH AModel Butterfly

/-! ## The sorted rows -/

/-! ## Expression combinators -/

section Comb

variable {u : IState HS} {Bb : ℕ}

theorem ESp.sel {c x y : Ex HS} {cv v : ℤ} (hc : ESp c u Bb cv) (hxc : x.Clean) (hyc : y.Clean)
    (hx : cv < 0 → ESp x u Bb v) (hy : ¬ cv < 0 → ESp y u Bb v) : ESp (.sel c x y) u Bb v := by
  refine ⟨?_, ⟨hc.ok, ?_⟩, ⟨hc.bnd, ?_⟩, ?_⟩
  · intro r hr
    simp only [Ex.regs, List.mem_append] at hr
    rcases hr with (h | h) | h
    · exact hc.clean r h
    · exact hxc r h
    · exact hyc r h
  · rw [hc.ev]; split_ifs with h
    · exact (hx h).ok
    · exact (hy h).ok
  · rw [hc.ev]; split_ifs with h
    · exact (hx h).bnd
    · exact (hy h).bnd
  · simp only [Ex.eval, hc.ev]; split_ifs with h
    · exact (hx h).ev
    · exact (hy h).ev

theorem ESp.sub {a b : Ex HS} {x y : ℤ} (ha : ESp a u Bb x) (hb : ESp b u Bb y)
    (h : zsz (x - y) ≤ Bb) : ESp (eSub a b) u Bb (x - y) := by
  rw [sub_eq_add_neg] at h ⊢; exact ESp.add ha (ESp.neg hb) h

theorem ESp.min {a b : Ex HS} {x y : ℤ} (ha : ESp a u Bb x) (hb : ESp b u Bb y)
    (h : zsz (x - y) ≤ Bb) : ESp (eMin a b) u Bb (min x y) :=
  ESp.sel (ESp.sub ha hb h) ha.clean hb.clean
    (fun hl => ESp.of_eq ha (by rw [min_eq_left (by linarith)]))
    (fun hl => ESp.of_eq hb (by rw [min_eq_right (by linarith)]))

end Comb

