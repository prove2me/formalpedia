noncomputable def mkBD {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} (k : Type) [Field k] [Algebra (DualNumber k) k]
    (u : FakeEllipticCurve Λ N k) (w : FakeEllipticCurve Λ N (DualNumber k))
    (g : u.A ⟶ w.A)
    (hc : CategoryTheory.IsPullback g u.f w.f (Spec.map (CommRingCat.ofHom (algebraMap (DualNumber k) k))))
    (hhom : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of k)) (P Q : SchemeHomOver t' u.f),
      (u.L.mul t' P Q).1 ≫ g =
        (w.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap (DualNumber k) k)))
          ⟨P.1 ≫ g, by rw [Category.assoc, hc.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ g, by rw [Category.assoc, hc.w, ← Category.assoc, Q.2]⟩).1) :
    BareDeformation u.f u.L (DualNumber k) :=
  { A := w.A, f := w.f, L := w.L, comm := w.comm, bundle := w.bundle, g := g, cart := hc, hom := hhom }

