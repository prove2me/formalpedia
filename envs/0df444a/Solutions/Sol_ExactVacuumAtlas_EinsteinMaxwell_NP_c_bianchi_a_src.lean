/-- Both real parts realised by Kerr–Newman families whose slice contains `U`. -/
theorem KNCTan.fams (hτ : KNCTan M a Q U τ) :
    (∃ (g gi : ℝ → Metric 4) (F : ℝ → TwoForm 4) (E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ) (W : Set (ℝ × Pt 4)),
      KNFam M a Q g gi F E Θ W ∧ NPTangent g F E W τ.hR τ.fR τ.BR ∧ ∀ y ∈ U, ((0 : ℝ), y) ∈ W) ∧
    (∃ (g gi : ℝ → Metric 4) (F : ℝ → TwoForm 4) (E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ) (W : Set (ℝ × Pt 4)),
      KNFam M a Q g gi F E Θ W ∧ NPTangent g F E W τ.hI τ.fI τ.BI ∧ ∀ y ∈ U, ((0 : ℝ), y) ∈ W) := by
  obtain ⟨g, gi, F, E, Θ, W, hK, ht, hs⟩ := knRealize hτ.isOpen hτ.sub hτ.re
  obtain ⟨g', gi', F', E', Θ', W', hK', ht', hs'⟩ := knRealize hτ.isOpen hτ.sub hτ.im
  exact ⟨⟨g, gi, F, E, Θ, W, hK, ht, fun y hy => by rw [← hs] at hy; exact hy⟩,
