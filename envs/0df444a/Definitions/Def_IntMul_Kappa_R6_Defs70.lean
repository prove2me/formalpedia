section
-- Source module: Solutions.J6SegAxBud6
/-!
# B-line axis budget 6: **`chunkBudget6_all`** (the chunk half of `AxBudget6`)

With `Wt = Wc + 4 (3 bA + bC) + 5 (3 pkA + pkC) + 60`, `K3 = Wt + 3x + 12`,
`C1 = Cfm (Wt+10)(Wt+x+14)²`, the chunk pass costs `≤ Kch · cU6 P n 2 / (D+1)` with
`Kch = 10^10 (Wt+2) + 3·10^15 Wt K3² + 650000 C1 + 8·10^7 Cfm Wt K3² + 10^5`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.ChB
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 J6Seg J6Seg.KR

def Wb (ap : AxPlan6) : ℕ := 3 * ap.pl.bA + ap.pl.bC
def Wk (ap : AxPlan6) : ℕ := 3 * ap.pl.pkA + ap.pl.pkC
def Wt (ap : AxPlan6) : ℕ := Side.Wc ap + 4 * Wb ap + 5 * Wk ap + 60
def K3 (P : Prm) (ap : AxPlan6) : ℝ := (Wt ap : ℝ) + 3 * (P.x : ℝ) + 12
def C1 (P : Prm) (ap : AxPlan6) : ℝ :=
  (NLogN.KFZ.Cfm : ℝ) * ((Wt ap : ℝ) + 10) * ((Wt ap : ℝ) + P.x + 14) ^ 2
def Kch (P : Prm) (ap : AxPlan6) : ℝ :=
  10 ^ 10 * ((Wt ap : ℝ) + 2) + 3 * 10 ^ 15 * (Wt ap : ℝ) * K3 P ap ^ 2 + 650000 * C1 P ap +
    8 * 10 ^ 7 * (NLogN.KFZ.Cfm : ℝ) * (Wt ap : ℝ) * K3 P ap ^ 2 + 10 ^ 5

end J6Seg.ChB
end

end

section
-- Source module: Solutions.J6SegAxJ
/-!
# B-line axis: the `J`-kernel half of the budget (statement only)

`JBudgetAt P ap n src D k Cc`: the `J`-pass conjuncts of `AxBudgetAt` (same order): `Bx`, `BkJ`,
`Lj` with `3 kJ + 10 ≤ Bx`, the `kerW` size facts of the `J` pass, the table bound, and
`kerC (jC … (uC (mulSup (2(kJ+2))) Bx Bc) + 2) BkJ (2^fJ) post Lj 1 |TJ| pre NJ ≤ Cc`.
`JBudget6 P ap`: uniformly over the round-six regime with `Cc = C · cU6 P n A / (D+1)`.
(Target for the value worker: `P.Ok → ValCond6 ap → ChunkPlan6 ap → JBudget6 P ap`.)
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

def JBudgetAt (P : Prm) (ap : AxPlan6) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) (Cc : ℝ) : Prop :=
  let Q := axQ6 P n src k; let R := axR6 P n; let lam := axl6 P n
  let wd := axwd6 P n src k ap
  let kJ := axkJ6 P n src k ap; let G := axG6 P n src k
  let pre := axpre6 P n D k; let post := axpost6 P n D k
  let fJ := axfJ6 P n src k
  let NJ := 2 * (pre * 1 * post * 2 ^ fJ)
  let TJ := tabsT (fun _ => axTJ6 P n src k ap) 1
  ∃ (BkJ Lj Bx : ℕ),
    3 * kJ + 10 ≤ Bx ∧
    1 ≤ BkJ ∧ wd ≤ BkJ ∧ zsz (wd : ℤ) ≤ BkJ ∧ zsz (fJ : ℤ) ≤ BkJ ∧
    zsz ((pre * 1 : ℕ) : ℤ) ≤ BkJ ∧ zsz (post : ℤ) ≤ BkJ ∧ zsz (pre : ℤ) ≤ BkJ ∧
    zsz ((1 : ℕ) : ℤ) ≤ BkJ ∧ zsz ((2 * 2 ^ fJ : ℕ) : ℤ) ≤ BkJ ∧ zsz (NJ : ℤ) ≤ BkJ ∧
    zsz (TJ.length : ℤ) ≤ BkJ ∧ zsz (Lj : ℤ) ≤ BkJ ∧
    Bnd BkJ (axTJ6 P n src k ap) ∧ (axTJ6 P n src k ap).length ≤ Lj ∧
    (kerC (JK.jC kJ (axw6 P n) G
        (JK.jFs Q R (axs6 src k) (axt6 P n k) lam (axw6 P n) (axα6 P n))
        (JK.jBs Q R (axs6 src k) (axt6 P n k) lam (axw6 P n) (axα6 P n))
        (JK.jCc Q R (axs6 src k) (axt6 P n k) lam (axw6 P n) (axα6 P n) (axw6 P n))
        (JK.uC (mulSup (2 * (kJ + 2))) Bx (axBc6 P n src k ap)) + 2)
      BkJ (2 ^ fJ) post Lj 1 TJ.length pre NJ : ℝ) ≤ Cc

/-- **`JBudget6 P ap`**. -/
def JBudget6 (P : Prm) (ap : AxPlan6) : Prop :=
  ∃ (C : ℝ) (A n₁ : ℕ), 0 ≤ C ∧ ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src →
    ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D, JBudgetAt P ap n src D k (C * cU6 P n A / (D + 1))

end J6Seg
end

end

