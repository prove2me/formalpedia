    ∀ s : Spec (CommRingCat.of T) ⟶ Xg, s ≫ q ≫ g = Spec.map (CommRingCat.ofHom (algebraMap C T)) →
      ∃ s₀ : Spec (CommRingCat.of T) ⟶ Xb, s₀ ≫ j = s)
  (hlift : ∀ (B : Type) [CommRing B] [Algebra C B] (t : Spec (CommRingCat.of B) ⟶ MC),
    t ≫ g = Spec.map (CommRingCat.ofHom (algebraMap C B)) →
    ∀ (s₀ : Spec (CommRingCat.of (B ⧸ Ideal.span {algebraMap C B p})) ⟶ Xb),
      s₀ ≫ ξb = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C B p}))) ≫ t →
      ∃! s : Spec (CommRingCat.of B) ⟶ Xg, s ≫ q = t ∧
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C B p}))) ≫ s = s₀ ≫ j)

abbrev PtG (g : MC ⟶ Spec (CommRingCat.of C)) (q : Xg ⟶ MC) (T : Type) [CommRing T] [Algebra C T] :=
  SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (q ≫ g)

abbrev PtB (g : MC ⟶ Spec (CommRingCat.of C)) (ξb : Xb ⟶ MC) (T : Type) [CommRing T] [Algebra C T] :=
  SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ≫ g)

include hjred in
lemma exists_red (T : Type) [CommRing T] [Algebra C T] (s : PtG g q T) :
    ∃ s₀ : Spec (CommRingCat.of (T ⧸ I C p T)) ⟶ Xb, s₀ ≫ j = specMk C p T ≫ s.1 := by
  refine hjred _ (algebraMap_quot_p C p T) _ ?_
  simp only [Category.assoc]
  rw [s.2, specMk_comp_algebraMap]

noncomputable def red (T : Type) [CommRing T] [Algebra C T] (s : PtG g q T) : PtB g ξb (T ⧸ I C p T) :=
  ⟨(exists_red hjred T s).choose, by
    rw [← hjq, Category.assoc, ← Category.assoc, (exists_red hjred T s).choose_spec, Category.assoc, s.2,
      specMk_comp_algebraMap]⟩

lemma red_comp_j (T : Type) [CommRing T] [Algebra C T] (s : PtG g q T) :
    (red hjq hjred T s).1 ≫ j = specMk C p T ≫ s.1 := (exists_red hjred T s).choose_spec

lemma red_comp_ξb (T : Type) [CommRing T] [Algebra C T] (s : PtG g q T) :
    (red hjq hjred T s).1 ≫ ξb = specMk C p T ≫ s.1 ≫ q := by
  rw [← Category.assoc, ← red_comp_j hjq hjred T s, Category.assoc, hjq]

lemma ptB_ext {T : Type} [CommRing T] [Algebra C T] (x x' : PtB g ξb T) (h : x.1 ≫ j = x'.1 ≫ j) : x = x' :=
  Subtype.ext (by rwa [cancel_mono] at h)

def tOf (T : Type) [CommRing T] [Algebra C T] (s : PtG g q T) :
    SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) g :=
  ⟨s.1 ≫ q, by rw [Category.assoc, s.2]⟩

include hp1 in
lemma red_compat (T : Type) [CommRing T] [Algebra C T] (s : PtG g q T) :
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C T p}))) ≫ (tOf T s).1 =
      (toM _ (pt₀ _ (red hjq hjred T s))).1 := by
  rw [hp1, red_comp_ξb]; rfl

include hp1 hred in
lemma exu (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] (s : PtG g q T) :
    ∃! x : PR.obj T, PR.map (mkA C p T) x = pt₀ _ (red hjq hjred T s) ∧ toM T x = tOf T s :=
  hred T _ _ (red_compat hp1 hjq hjred T s)

noncomputable def e (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] (s : PtG g q T) : PR.obj T :=
  (exu hred hp1 hjq hjred T s).exists.choose

lemma e_spec (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] (s : PtG g q T) :
    PR.map (mkA C p T) (e hred hp1 hjq hjred T s) = pt₀ _ (red hjq hjred T s) ∧
      toM T (e hred hp1 hjq hjred T s) = tOf T s :=
  (exu hred hp1 hjq hjred T s).exists.choose_spec

lemma e_unique (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] (s : PtG g q T) (x : PR.obj T)
    (h1 : PR.map (mkA C p T) x = pt₀ _ (red hjq hjred T s)) (h2 : toM T x = tOf T s) :
    e hred hp1 hjq hjred T s = x :=
  (exu hred hp1 hjq hjred T s).unique (e_spec hred hp1 hjq hjred T s) ⟨h1, h2⟩

lemma e_toM (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] (s : PtG g q T) :
    (toM T (e hred hp1 hjq hjred T s)).1 = s.1 ≫ q := by
  rw [(e_spec hred hp1 hjq hjred T s).2]; rfl

include hp3 hlift in

lemma e_injective (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] (s s' : PtG g q T)
    (h : e hred hp1 hjq hjred T s = e hred hp1 hjq hjred T s') : s = s' := by
  have hq : s.1 ≫ q = s'.1 ≫ q := by rw [← e_toM hred hp1 hjq hjred T s, ← e_toM hred hp1 hjq hjred T s', h]
  have hred' : red hjq hjred T s = red hjq hjred T s' := by
    apply hp3 _ (algebraMap_quot_p C p T)
    rw [← (e_spec hred hp1 hjq hjred T s).1, ← (e_spec hred hp1 hjq hjred T s').1, h]
  have hmk : specMk C p T ≫ s.1 = specMk C p T ≫ s'.1 := by
    rw [← red_comp_j hjq hjred T s, ← red_comp_j hjq hjred T s', hred']
  obtain ⟨s₁, -, huniq⟩ := hlift T (s.1 ≫ q) (by rw [Category.assoc, s.2]) (red hjq hjred T s).1
    (red_comp_ξb hjq hjred T s)
  have e1 := huniq s.1 ⟨rfl, (red_comp_j hjq hjred T s).symm⟩
  have e2 := huniq s'.1 ⟨hq.symm, by rw [← hmk, red_comp_j]⟩
  exact Subtype.ext (e1.trans e2.symm)

include hR0 hp2 in

lemma e_natural (T T' : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] [CommRing T'] [IsNoetherianRing T']
    [Algebra C T'] (φ : T →ₐ[C] T') (s : PtG g q T) (s' : PtG g q T')
    (hs : s'.1 = Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ s.1) :
    e hred hp1 hjq hjred T' s' = PR.map φ (e hred hp1 hjq hjred T s) := by

  let xφ : PtB g ξb (T' ⧸ I C p T') :=
    ⟨Spec.map (CommRingCat.ofHom (barA C p φ : T ⧸ I C p T →+* T' ⧸ I C p T')) ≫ (red hjq hjred T s).1, by
      rw [Category.assoc, (red hjq hjred T s).2, ← Spec.map_comp, ← CommRingCat.ofHom_comp, (barA C p φ).comp_algebraMap]⟩
  have hred' : red hjq hjred T' s' = xφ := by
    apply ptB_ext (j := j)
    rw [red_comp_j, Category.assoc, red_comp_j, ← Category.assoc, spec_barA_comp_specMk, Category.assoc, hs]
  apply e_unique
  · rw [← PR.map_comp, show (mkA C p T').comp φ = (barA C p φ).comp (mkA C p T) from
      (Ideal.quotient_map_comp_mkₐ (I C p T') φ (I_le_comap C p φ)).symm, PR.map_comp,
      (e_spec hred hp1 hjq hjred T s).1, hred']
    exact (hp2 _ _ (barA C p φ) (red hjq hjred T s) xφ rfl).symm
  · apply Subtype.ext
    rw [hR0, e_toM]
    show Spec.map _ ≫ s.1 ≫ q = s'.1 ≫ q
    rw [← Category.assoc, ← hs]

include hR0 hlift in

lemma e_image (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] (x : PR.obj T) :
    (∃ s : PtG g q T, e hred hp1 hjq hjred T s = x) ↔
      ∃ x₀ : PtB g ξb (T ⧸ Ideal.span {algebraMap C T p}),
        pt₀ _ x₀ = PR.map (Ideal.Quotient.mkₐ C (Ideal.span {algebraMap C T p})) x := by
  constructor
  · rintro ⟨s, rfl⟩
    exact ⟨red hjq hjred T s, (e_spec hred hp1 hjq hjred T s).1.symm⟩
  · rintro ⟨x₀, hx₀⟩
    have ht := (toM T x).2
    have hcompat : x₀.1 ≫ ξb = specMk C p T ≫ (toM T x).1 := by
      rw [← hp1, hx₀, hR0]; rfl
    obtain ⟨s₁, ⟨hs₁q, hs₁j⟩, -⟩ := hlift T (toM T x).1 ht x₀.1 hcompat
    refine ⟨⟨s₁, by rw [← Category.assoc, hs₁q, ht]⟩, ?_⟩
    have hred' : red hjq hjred T ⟨s₁, by rw [← Category.assoc, hs₁q, ht]⟩ = x₀ := by
      apply ptB_ext (j := j); rw [red_comp_j]; exact hs₁j
    apply e_unique
    · rw [hred', hx₀]
    · exact Subtype.ext hs₁q.symm

end Main

theorem exists_pointMap_injective_natural_image
    (C : Type) [CommRing C] (p : C) (MC : Scheme.{0}) (g : MC ⟶ Spec (CommRingCat.of C))
    (PR : AlgFunctor C)
    (toM : ∀ (T : Type) [CommRing T] [Algebra C T], PR.obj T → SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) g)
    (hR0 : ∀ (S S' : Type) [CommRing S] [Algebra C S] [CommRing S'] [Algebra C S'] (φ : S →ₐ[C] S') (x : PR.obj S),
      (toM S' (PR.map φ x)).1 = Spec.map (CommRingCat.ofHom (φ : S →+* S')) ≫ (toM S x).1)
    (hred : ∀ (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T]
      (xb : PR.obj (T ⧸ Ideal.span {algebraMap C T p}))
      (t : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) g),
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C T p}))) ≫ t.1 = (toM _ xb).1 →
      ∃! x : PR.obj T, PR.map (Ideal.Quotient.mkₐ C (Ideal.span {algebraMap C T p})) x = xb ∧ toM T x = t)
    (Xb : Scheme.{0}) (ξb : Xb ⟶ MC)
    (pt₀ : ∀ (T : Type) [CommRing T] [Algebra C T],
      SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ≫ g) → PR.obj T)
    (hp1 : ∀ (T : Type) [CommRing T] [Algebra C T]
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ≫ g)), (toM T (pt₀ T x)).1 = x.1 ≫ ξb)
    (hp2 : ∀ (T T' : Type) [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T'] (φ : T →ₐ[C] T')
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ≫ g))
      (x' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T'))) (ξb ≫ g)),
      x'.1 = Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ x.1 → pt₀ T' x' = PR.map φ (pt₀ T x))
    (hp3 : ∀ (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T], algebraMap C T p = 0 →
      ∀ (x x' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ≫ g)), pt₀ T x = pt₀ T x' → x = x')
    (Xg : Scheme.{0}) (q : Xg ⟶ MC) (j : Xb ⟶ Xg) (hjq : j ≫ q = ξb) (hjm : Mono j)
    (hjred : ∀ (T : Type) [CommRing T] [Algebra C T], algebraMap C T p = 0 →
      ∀ s : Spec (CommRingCat.of T) ⟶ Xg, s ≫ q ≫ g = Spec.map (CommRingCat.ofHom (algebraMap C T)) →
        ∃ s₀ : Spec (CommRingCat.of T) ⟶ Xb, s₀ ≫ j = s)
    (hlift : ∀ (B : Type) [CommRing B] [Algebra C B] (t : Spec (CommRingCat.of B) ⟶ MC),
      t ≫ g = Spec.map (CommRingCat.ofHom (algebraMap C B)) →
      ∀ (s₀ : Spec (CommRingCat.of (B ⧸ Ideal.span {algebraMap C B p})) ⟶ Xb),
        s₀ ≫ ξb = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C B p}))) ≫ t →
        ∃! s : Spec (CommRingCat.of B) ⟶ Xg, s ≫ q = t ∧
          Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C B p}))) ≫ s = s₀ ≫ j) :
    ∃ e : ∀ (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T],
        SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (q ≫ g) → PR.obj T,

      (∀ (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T]
          (s : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (q ≫ g)), (toM T (e T s)).1 = s.1 ≫ q) ∧

      (∀ (T T' : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] [CommRing T'] [IsNoetherianRing T'] [Algebra C T']
          (φ : T →ₐ[C] T') (s : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (q ≫ g))
          (s' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T'))) (q ≫ g)),
          s'.1 = Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ s.1 → e T' s' = PR.map φ (e T s)) ∧

      (∀ (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T]
          (s s' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (q ≫ g)), e T s = e T s' → s = s') ∧

      (∀ (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T] (x : PR.obj T),
          (∃ s : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (q ≫ g), e T s = x) ↔
            ∃ x₀ : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C (T ⧸ Ideal.span {algebraMap C T p})))) (ξb ≫ g),
              pt₀ _ x₀ = PR.map (Ideal.Quotient.mkₐ C (Ideal.span {algebraMap C T p})) x) := by
  haveI := hjm
  exact ⟨fun T _ _ _ s => e hred hp1 hjq hjred T s,
    fun T _ _ _ s => e_toM hred hp1 hjq hjred T s,
    fun T T' _ _ _ _ _ _ φ s s' hs => e_natural hR0 hred hp1 hp2 hjq hjred T T' φ s s' hs,
    fun T _ _ _ s s' h => e_injective hred hp1 hp3 hjq hjred hlift T s s' h,
    fun T _ _ _ x => e_image hR0 hred hp1 hjq hjred hlift T x⟩

#print axioms exists_pointMap_injective_natural_image

theorem exists_represents_of_stratumPiece_of_chartScheme
    (𝒪 : Type) [CommRing 𝒪] (C : Type) [CommRing C] [Algebra 𝒪 C] (p : C)
    (MC : Scheme.{0}) (g : MC ⟶ Spec (CommRingCat.of C))
    (PR : AlgFunctor C)
    (toM : ∀ (T : Type) [CommRing T] [Algebra C T], PR.obj T → SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) g)
    (hR0 : ∀ (S S' : Type) [CommRing S] [Algebra C S] [CommRing S'] [Algebra C S'] (φ : S →ₐ[C] S') (x : PR.obj S),
      (toM S' (PR.map φ x)).1 = Spec.map (CommRingCat.ofHom (φ : S →+* S')) ≫ (toM S x).1)
    (hred : ∀ (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T]
      (xb : PR.obj (T ⧸ Ideal.span {algebraMap C T p}))
      (t : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) g),
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C T p}))) ≫ t.1 = (toM _ xb).1 →
      ∃! x : PR.obj T, PR.map (Ideal.Quotient.mkₐ C (Ideal.span {algebraMap C T p})) x = xb ∧ toM T x = t)

    (Xb : Scheme.{0}) (ξb : Xb ⟶ MC)
    (pt₀ : ∀ (T : Type) [CommRing T] [Algebra C T],
      SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ≫ g) → PR.obj T)
    (hp1 : ∀ (T : Type) [CommRing T] [Algebra C T]
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ≫ g)), (toM T (pt₀ T x)).1 = x.1 ≫ ξb)
    (hp2 : ∀ (T T' : Type) [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T'] (φ : T →ₐ[C] T')
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ≫ g))
      (x' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T'))) (ξb ≫ g)),
      x'.1 = Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ x.1 → pt₀ T' x' = PR.map φ (pt₀ T x))
    (hp3 : ∀ (T : Type) [CommRing T] [IsNoetherianRing T] [Algebra C T], algebraMap C T p = 0 →
      ∀ (x x' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξb ≫ g)), pt₀ T x = pt₀ T x' → x = x')
    (Pγ : ∀ (S : Type) [CommRing S] [Algebra C S], PR.obj S → Prop)
    (hDimg : ∀ (S : Type) [CommRing S] [Algebra C S] [IsNoetherianRing S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
      (x : PR.obj S),
      (∃ x₀ : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C (S ⧸ Ideal.span {algebraMap C S p})))) (ξb ≫ g),
          pt₀ _ x₀ = PR.map (Ideal.Quotient.mkₐ C (Ideal.span {algebraMap C S p})) x) ↔ Pγ S x)

    (Xg : Scheme.{0}) (q : Xg ⟶ MC) (hlft : LocallyOfFiniteType (q ≫ g)) (j : Xb ⟶ Xg) (hjq : j ≫ q = ξb) (hjm : Mono j)
    (hjred : ∀ (T : Type) [CommRing T] [Algebra C T], algebraMap C T p = 0 →
      ∀ s : Spec (CommRingCat.of T) ⟶ Xg, s ≫ q ≫ g = Spec.map (CommRingCat.ofHom (algebraMap C T)) →
        ∃ s₀ : Spec (CommRingCat.of T) ⟶ Xb, s₀ ≫ j = s)
    (hlift : ∀ (B : Type) [CommRing B] [Algebra C B] (t : Spec (CommRingCat.of B) ⟶ MC),
      t ≫ g = Spec.map (CommRingCat.ofHom (algebraMap C B)) →
      ∀ (s₀ : Spec (CommRingCat.of (B ⧸ Ideal.span {algebraMap C B p})) ⟶ Xb),
        s₀ ≫ ξb = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C B p}))) ≫ t →
        ∃! s : Spec (CommRingCat.of B) ⟶ Xg, s ≫ q = t ∧
          Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C B p}))) ≫ s = s₀ ≫ j) :
    ∃ (X : Scheme.{0}) (fX : X ⟶ Spec (CommRingCat.of C)) (_ : LocallyOfFiniteType fX)
      (e : ∀ (S : Type) [CommRing S] [Algebra C S] [IsNoetherianRing S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S],
        (Scheme.nilpPoints fX).obj S → PR.obj S),

      (∀ (S S' : Type) [CommRing S] [Algebra C S] [IsNoetherianRing S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          [CommRing S'] [Algebra C S'] [IsNoetherianRing S'] [Algebra 𝒪 S'] [IsScalarTower 𝒪 C S'] (φ : S →ₐ[C] S')
          (y : (Scheme.nilpPoints fX).obj S)
          (y' : (Scheme.nilpPoints fX).obj S'),
          y'.1 = Spec.map (CommRingCat.ofHom (φ : S →+* S')) ≫ y.1 → e S' y' = PR.map φ (e S y)) ∧

      (∀ (S : Type) [CommRing S] [Algebra C S] [IsNoetherianRing S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (y y' : (Scheme.nilpPoints fX).obj S), e S y = e S y' → y = y') ∧

      (∀ (S : Type) [CommRing S] [Algebra C S] [IsNoetherianRing S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S] (x : PR.obj S),
          (∃ y : (Scheme.nilpPoints fX).obj S, e S y = x) ↔ Pγ S x) := by
  obtain ⟨e, -, hnat, hinj, himg⟩ := exists_pointMap_injective_natural_image C p MC g PR toM hR0 hred Xb ξb pt₀ hp1 hp2 hp3
    Xg q j hjq hjm hjred hlift
  refine ⟨Xg, q ≫ g, hlft, fun S _ _ _ _ _ y => e S y, fun S S' _ _ _ _ _ _ _ _ _ _ φ y y' h => hnat S S' φ y y' h,
    fun S _ _ _ _ _ y y' h => hinj S y y' h, fun S _ _ _ _ _ x => (himg S x).trans (hDimg S x)⟩

#print axioms exists_represents_of_stratumPiece_of_chartScheme

