      tv * (((Ideal.absNorm v.asIdeal : ℕ) : ℝ≥0∞) - 1)⁻¹ * (1 - ((Ideal.absNorm v.asIdeal : ℕ) : ℝ≥0∞) ^ (-(2 : ℝ)))⁻¹ := by sorry
