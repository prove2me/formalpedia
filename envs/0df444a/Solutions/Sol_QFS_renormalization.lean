end QFS

open QFS

variable {d : ℕ}

/-- **Proposition 5.14** of Bux–Kassmann–Schulze. For every radius `r` there is
`R ≥ r`, depending only on `r`, `ϑ` and `d`, such that in a `ϑ`-sparsely
populated town of scale `(h, ℓ)` any two blocks whose indices lie within `r` of a
point `z` of the index lattice are connected in the favored graph by a path
through blocks whose indices stay within `R` of `z`.

The proof is the paper's: the town is identified with `ℤ^d` by `x ↦ Q_ℓ(hx)`, the
configuration `x ↦` (the cone of apex angle `ϑ/2` with the axis of a cone favored
in `Q_ℓ(hx)`) is `ϑ/2`-bounded, Lemma 5.9 turns each of its edges into an edge of
the favored graph — this is exactly where sparse population is used, since it
makes `δℓ < h ≤ ‖hx − hy‖` for distinct `x, y` — and Corollary 5.8 supplies the
connectivity. -/
theorem solution {ϑ : ℝ} (hϑ : 0 < ϑ) (hϑ' : ϑ ≤ π / 2) {r : ℝ} (hr : 0 < r) :
    ∃ R : ℝ, r ≤ R ∧
      ∀ Γ : QFS.Configuration (EuclideanSpace ℝ (Fin d)), QFS.IsBounded Γ ϑ →
      ∀ h ℓ : ℝ, 0 < h → 0 < ℓ → QFS.SparselyPopulated d ϑ h ℓ →
      ∀ z ∈ QFS.lattice d, ∀ x ∈ QFS.lattice d, ∀ y ∈ QFS.lattice d,
        ‖x - z‖ ≤ r → ‖y - z‖ ≤ r →
        QFS.FavoredConn Γ (QFS.townBall h ℓ z R) (QFS.townIndex h ℓ x) (QFS.townIndex h ℓ y) := by
  have hϑ2 : (0:ℝ) < ϑ / 2 := by positivity
  have hϑ2' : ϑ / 2 ≤ π / 2 := by linarith [pi_pos]
  obtain ⟨R, hRr, hRprop⟩ :=
    QFS.discrete_template (d := d) (ϑ := ϑ / 2) hϑ2 hϑ2' (show (0:ℝ) < r + 1 by linarith)
  refine ⟨R, by linarith, ?_⟩
  intro Γ hΓ h ℓ hh hℓ hsp z hz x hx y hy hxz hyz
  -- a favored cone in each block, and the induced `ϑ/2`-configuration on `ℤ^d`
  choose W hWfav hWmem using
    fun p : EuclideanSpace ℝ (Fin d) => QFS.exists_favoredIn Γ (QFS.block_finite hℓ.le (h • p))
  set Γ' : QFS.Configuration (EuclideanSpace ℝ (Fin d)) :=
    fun p => ⟨(W p).axis, (W p).norm_axis, ϑ / 2, hϑ2, hϑ2'⟩ with hΓ'
  have hΓ'b : QFS.IsBounded Γ' (ϑ / 2) := ⟨hϑ2, fun p => le_refl _⟩
  -- each edge of `Γ'` becomes an edge of the favored graph
  have hedge : ∀ p q : EuclideanSpace ℝ (Fin d), p ∈ QFS.lattice d → q ∈ QFS.lattice d →
      q ∈ QFS.coneAt Γ' p → QFS.FavoredEdge Γ (QFS.townIndex h ℓ p) (QFS.townIndex h ℓ q) := by
    intro p q hp hq hpq
    refine ⟨W p, hWfav p, fun x' hx' y' hy' => ?_⟩
    obtain ⟨p0, hp0Q, hWp⟩ := hWmem p ⟨x', hx'⟩
    have hapex : ϑ ≤ (W p).apex := by rw [hWp]; exact hΓ.2 p0
    have hax : ‖(W p).axis‖ = 1 := (W p).norm_axis
    have hne : q ≠ p := by
      intro hc
      rw [hc, QFS.mem_coneAt, sub_self] at hpq
      exact (Γ' p).zero_notMem hpq
    -- pick the half-cone containing `q − p`
    obtain ⟨v, hv1, hvsub, hqp⟩ : ∃ v : EuclideanSpace ℝ (Fin d), ‖v‖ = 1 ∧
        QFS.cone v ϑ ⊆ (W p).carrier ∧ q - p ∈ QFS.cone v (ϑ / 2) := by
      have hmem : q - p ∈ QFS.doubleCone (W p).axis (ϑ / 2) := hpq
      rcases QFS.mem_doubleCone_iff.mp hmem with hc | hc
      · refine ⟨(W p).axis, hax, fun u hu => ?_, hc⟩
        exact QFS.doubleCone_mono (le_of_lt hϑ) (W p).apex_le_pi hapex
          (Set.mem_union_left _ hu)
      · refine ⟨-(W p).axis, by simp [hax], fun u hu => ?_, ?_⟩
        · have h1 : u ∈ QFS.doubleCone (-(W p).axis) ϑ := Set.mem_union_left _ hu
          rw [QFS.doubleCone_neg] at h1
          exact QFS.doubleCone_mono (le_of_lt hϑ) (W p).apex_le_pi hapex h1
        · rw [QFS.cone_neg]; exact hc
    -- Lemma 5.9 applies: sparse population gives the distance
    have hscale : h • q - h • p = h • (q - p) := by rw [smul_sub]
    have hdist : QFS.apexShrinkConst d ϑ * ℓ ≤ ‖h • p - h • q‖ := by
      have h1 : ‖h • p - h • q‖ = h * ‖p - q‖ := by
        rw [← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_pos hh]
      have h2 : 1 ≤ ‖p - q‖ := QFS.one_le_norm_sub_of_lattice hp hq (fun hc => hne hc.symm)
      have h3 : QFS.apexShrinkConst d ϑ * ℓ < h := by
        rw [QFS.SparselyPopulated, lt_div_iff₀ hℓ] at hsp
        linarith
      have h4 : h ≤ h * ‖p - q‖ := by nlinarith
      linarith
    have hincone : h • q ∈ QFS.shift (QFS.cone v (ϑ / 2)) (h • p) := by
      rw [QFS.mem_shift, hscale]
      exact QFS.smul_mem_cone hv1 hϑ2 hϑ2' hh hqp
    have hcube := QFS.renormalization_apex_shrink hϑ hϑ' hv1 hℓ hdist hincone
    have hy'c : y' ∈ QFS.closedCube ℓ (h • q) := hy'.2
    have hx'c : x' ∈ QFS.closedCube ℓ (h • p) := hx'.2
    have := Set.mem_iInter₂.mp (hcube hy'c) x' hx'c
    rw [QFS.mem_shift] at this ⊢
    exact hvsub this
  -- transfer paths
  have htrans : ∀ a b : EuclideanSpace ℝ (Fin d),
      QFS.ConnWithin Γ' (ball z R ∩ QFS.lattice d) a b →
      QFS.FavoredConn Γ (QFS.townBall h ℓ z R) (QFS.townIndex h ℓ a) (QFS.townIndex h ℓ b) := by
    intro a b hab
    induction hab with
    | refl => exact QFS.FavoredConn.refl _ _ _
    | tail _ hstep ih =>
        have hmemT : ∀ w ∈ ball z R ∩ QFS.lattice d, QFS.townIndex h ℓ w ∈ QFS.townBall h ℓ z R := by
          rintro w ⟨hwb, hwlat⟩
          refine ⟨w, ⟨hwlat, ?_⟩, rfl⟩
          rw [mem_ball, dist_eq_norm] at hwb
          exact hwb
        refine QFS.FavoredConn.trans ih (Relation.ReflTransGen.single
          ⟨hmemT _ hstep.1, hmemT _ hstep.2.1, ?_⟩)
        exact hstep.2.2.imp (fun e => hedge _ _ hstep.1.2 hstep.2.1.2 e)
          (fun e => hedge _ _ hstep.2.1.2 hstep.1.2 e)
  -- Corollary 5.8 connects `z` to `x` and to `y`
  have hconn := hRprop Γ' hΓ'b z hz
  have hzx := hconn x (by rw [mem_ball, dist_eq_norm]; linarith) hx
  have hzy := hconn y (by rw [mem_ball, dist_eq_norm]; linarith) hy
  exact QFS.FavoredConn.trans (htrans _ _ hzx).symm (htrans _ _ hzy)
