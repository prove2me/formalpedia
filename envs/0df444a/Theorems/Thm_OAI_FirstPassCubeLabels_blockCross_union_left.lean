theorem OAI.FirstPassCubeLabels.blockCross_union_left {ι : Type*} [DecidableEq ι]
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (S T C : Finset ι)
    (hd : Disjoint S T) (e : ι → ℕ) :
    blockCross p hg (S ∪ T) C e = blockCross p hg S C e * blockCross p hg T C e := by sorry
