/-- For `0 < a`, the ideals `(π - u T^a X^b, T)` and `(π, T)` of `O[[T,X]]` coincide. -/
private theorem surfaceRelation_span_axisT_eq (O : Type) [CommRing O] (pi : O) (u : (TwoSeries O)ˣ)
    (a b : ℕ) (ha : 0 < a) :
    Ideal.span {surfaceRelation O pi u a b, axisT O} =
      Ideal.span {(MvPowerSeries.C pi : TwoSeries O), axisT O} := by
  obtain ⟨a', rfl⟩ : ∃ a', a = a' + 1 := ⟨a - 1, by omega⟩
  rw [show surfaceRelation O pi u (a' + 1) b = MvPowerSeries.C pi +
      -((u : TwoSeries O) * axisT O ^ a' * axisX O ^ b) * axisT O by rw [surfaceRelation]; ring,
    Ideal.span_pair_add_mul_right]

end TypeDensity

open TypeDensity

theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] (pi : O) (hpi : Irreducible pi) (u : (TypeDensity.TwoSeries O)ˣ) (a b : ℕ)
    (ha : 0 < a) :
    ∃ q : (TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span {TypeDensity.surfaceT O pi u a b}) ≃+*
        PowerSeries (IsLocalRing.ResidueField O),
      ∀ s : TypeDensity.TwoSeries O, q (Ideal.Quotient.mk (Ideal.span {TypeDensity.surfaceT O pi u a b})
        (TypeDensity.surfaceMk O pi u a b s)) = TypeDensity.residueKillT O s := by
  obtain ⟨-, -, -, hsurj, hker⟩ := TypeDensity.residueKillT_apply_ker O pi hpi
  set I := TypeDensity.surfaceIdeal O pi u a b
  set J : Ideal (TypeDensity.TwoSeries O) := Ideal.span {TypeDensity.axisT O}
  have h1 : Ideal.span {TypeDensity.surfaceT O pi u a b} = J.map (Ideal.Quotient.mk I) := by
    rw [Ideal.map_span, Set.image_singleton]; rfl
  have h2 : I ⊔ J = RingHom.ker (TypeDensity.residueKillT O) := by
    rw [hker, ← TypeDensity.surfaceRelation_span_axisT_eq O pi u a b ha, Ideal.span_insert]; rfl
  exact ⟨((Ideal.quotEquivOfEq h1).trans (DoubleQuot.quotQuotEquivQuotSup I J)).trans
    ((Ideal.quotEquivOfEq h2).trans (RingHom.quotientKerEquivOfSurjective hsurj)), fun _ ↦ rfl⟩
