-- title:
--   The Laurent-series field generated by two unit coordinates
-- statement:
--   Defines the intermediate field of $K((q))$ generated by the first modular-unit series $u_0$ and the ratio $u_0/u_1$. It records the two plane coordinates as function-field generators for the level-$25$ curve.
-- source:
--   B. Mazur, Modular curves and the Eisenstein ideal, Publ. IHES 47 (1977); Lean formalization of the order-25 case for this mission. Modules in the MazurProof/Keystone/Tate families are adapted from anthropics/fermats-last-theorem (Apache-2.0) via the xiangyazi24/FLT fork.

import Definitions.Def_N25_Units
/-! The Laurent-series subfield generated by the two plane coordinates. -/
noncomputable section
namespace N25

/-- The subfield generated by the first unit and its ratio with the second unit. -/
def unitLaurentField25C (K : Type*) [Field K] :
    IntermediateField K (LaurentSeries K) :=
  IntermediateField.adjoin K
    ({unitSeries25 K 0, unitSeries25 K 0 / unitSeries25 K 1} : Set (LaurentSeries K))

end N25


