            ordinaryReciprocalBudget x) =
          2 * ((1 / 2 : ℝ) * (x / laterBlockLower q k) * Real.log x) +
            2 * ordinaryReciprocalBudget x by ring,
        hmain]
      calc
        (x * Real.log x) / (2 * (q : ℝ)) *
              (1 / ((k : ℝ) + 5 / 4)) +
            2 * ordinaryReciprocalBudget x +
              (2 / Real.pi) * ordinaryReciprocalBudget x * (q : ℝ) *
                Real.log (4 * (q : ℝ)) =
            (x * Real.log x) / (2 * (q : ℝ)) *
                (1 / ((k : ℝ) + 5 / 4)) +
              (2 * ordinaryReciprocalBudget x +
                (2 / Real.pi) * ordinaryReciprocalBudget x * (q : ℝ) *
                  Real.log (4 * (q : ℝ))) := by ring
        _ ≤ (x * Real.log x) / (2 * (q : ℝ)) *
                (1 / ((k : ℝ) + 5 / 4)) +
              ordinaryReciprocalBudget x * oddVinogradovBlockConstant q :=
