-- title:
--   §2, pp. 4–7 — monopoly production under a Gaussian demand posterior, followed by one-shot Kyle trading with a market-efficient price
-- statement:
--   This file sets up the basic model of §2 of Chen and Jorgensen: a monopolist chooses an output quantity, and afterwards its manager trades the firm's stock against noise traders and a competitive market maker, as in Kyle (1985).
--
--   **Primitives.** The firm faces the inverse demand $p = \tilde a - q$ with zero marginal cost. The demand intercept has prior $\tilde a \sim N(m_a, \Sigma_a)$, and the manager discloses a signal $\tilde s = \tilde a + \tilde\theta$ with $\tilde\theta \sim N(0,\Sigma_\theta)$. The noise traders' demand is $\tilde u \sim N(0, \Sigma_u)$, independent of the demand. The manager holds a stake $\omega$ in the firm. The standing assumptions are
--   $$\Sigma_a > 0,\quad \Sigma_\theta > 0,\quad \Sigma_u > 0,\quad 0 < \omega \le 1 .$$
--
--   **Posterior.** The game is analysed given the realized signal $s$. The demand intercept then has the posterior law
--   $$(a\mid s) \sim N\!\left(E[a|s],\ \frac{\Sigma_a\Sigma_\theta}{\Sigma_a+\Sigma_\theta}\right),\qquad E[a|s] = \frac{\Sigma_a s + \Sigma_\theta m_a}{\Sigma_a+\Sigma_\theta},$$
--   and $(a, u)$ is distributed as the product of this law and $N(0,\Sigma_u)$. Write $\kappa = \sqrt{\Sigma_u\Sigma_a\Sigma_\theta/(\Sigma_a+\Sigma_\theta)}$.
--
--   **Trading stage at quantity $q$.** The firm value is $V = q(a - q)$. The manager uses a linear demand $d(V) = \alpha + \beta V$ (5), and the market maker a linear price $P(y) = \mu + \lambda y$ in the total order flow $D = d(V) + u$ (6). The pair is a *linear equilibrium of the trading stage* when two conditions hold:
--   1. for every realization of $a$, the demand $d(V)$ maximizes the insider's expected profit $E[(V - P(d+\tilde u))\,d]$ over all $d \in \mathbb R$, the expectation being over $\tilde u$ (3);
--   2. the price is efficient, $P(D) = E[V \mid D]$ almost surely (4).
--
--   **Production stage.** The manager's objective (2) is $\omega E[V(q)] + E[\Pi(q)]$, where $E[\Pi(q)] = E[(V - P(D))\,d(V)]$ is the expected trading profit over $(a,u)$. A *linear equilibrium* is a pair $(q, e)$ satisfying two conditions:
--   1. $e$ is a linear equilibrium of the trading stage at $q$;
--   2. no quantity $q' \in \mathbb R$, followed by any linear equilibrium $e'$ of its own trading stage, gives a higher objective.
--
--   Finally the file names Proposition 1's closed forms: $\hat q = \tfrac12 E[a|s] + \kappa/(4\omega)$, and at a quantity $q$ the coefficients
--   $$\alpha = -\frac{\sqrt{\Sigma_u}}{\sqrt{\Sigma_a\Sigma_\theta/(\Sigma_a+\Sigma_\theta)}}(E[a|s]-q),\quad \beta = \frac{\sqrt{\Sigma_u}}{q\sqrt{\Sigma_a\Sigma_\theta/(\Sigma_a+\Sigma_\theta)}},\quad \mu = q(E[a|s]-q),\quad \lambda = \frac{q}{2\sqrt{\Sigma_u}}\sqrt{\frac{\Sigma_a\Sigma_\theta}{\Sigma_a+\Sigma_\theta}} .$$
--
--   Every theorem of the mission is stated about these objects.
--
--   **Formalization Note.** The variances are named `Sa`, `Sθ`, `Su` (for $\Sigma_a, \Sigma_\theta, \Sigma_u$) and $\lambda$ is `lam`, because `Σ` and `λ` are Lean notation. The posterior law of $a$ given $s$ is taken as the model's input, with the paper's mean and variance (§2.1, p. 6). Deriving it from the prior and the signal is not part of this mission. Gaussian laws use `gaussianReal m v.toNNReal`; under the standing assumptions the variances are positive, so `toNNReal` changes nothing. Quantities are real numbers and may be negative (footnote 7). The price condition (4) is Mathlib's conditional expectation `condExp` with respect to the σ-algebra generated by the order flow, not a formula. Insider optimality holds for every realization of $a$, not just almost every one. The closed forms `eqStrat` are the paper's, written for $q > 0$.
-- source:
--   Chen and Jorgensen, Insider Trading, Competition, and Real Activities Manipulation, SSRN 2358668 (version of February 2016), pp. 4–7 (PDF 5–8), §2, (2)–(6), footnote 7, and Proposition 1

import Mathlib

namespace KyleProduction.Monopoly

open MeasureTheory ProbabilityTheory

/-- The primitives of the monopoly model of §2, conditional on the realized, publicly disclosed
signal `s`: prior mean `ma` of demand, the variances `Sa = Σa` (demand), `Sθ = Σθ` (accounting
noise), `Su = Σu` (noise trade), the manager's stake `ω` and the realized signal `s`. -/
structure Params where
  ma : ℝ
  Sa : ℝ
  Sθ : ℝ
  Su : ℝ
  ω : ℝ
  s : ℝ

/-- Standing assumptions of §2 (pp. 4–5): positive variances and `0 < ω ≤ 1`. -/
def Params.Standing (P : Params) : Prop :=
  0 < P.Sa ∧ 0 < P.Sθ ∧ 0 < P.Su ∧ 0 < P.ω ∧ P.ω ≤ 1

/-- `E[a|s] = (Σa s + Σθ m_a)/(Σa + Σθ)`. -/
noncomputable def postMean (P : Params) : ℝ := (P.Sa * P.s + P.Sθ * P.ma) / (P.Sa + P.Sθ)

/-- `Var(a|s) = ΣaΣθ/(Σa + Σθ)`. -/
noncomputable def postVar (P : Params) : ℝ := P.Sa * P.Sθ / (P.Sa + P.Sθ)

/-- `κ = √(ΣuΣaΣθ/(Σa + Σθ))`. -/
noncomputable def kappa (P : Params) : ℝ := Real.sqrt (P.Su * P.Sa * P.Sθ / (P.Sa + P.Sθ))

/-- The posterior law `(a|s) ∼ N(E[a|s], Var(a|s))` of the demand intercept. -/
noncomputable def lawA (P : Params) : Measure ℝ := gaussianReal (postMean P) (postVar P).toNNReal

/-- The law `N(0, Σu)` of the noise trade `u`. -/
noncomputable def lawU (P : Params) : Measure ℝ := gaussianReal 0 P.Su.toNNReal

/-- The joint law of `(a, u)`: independent, with marginals `lawA` and `lawU`. -/
noncomputable def law (P : Params) : Measure (ℝ × ℝ) := (lawA P).prod (lawU P)

/-- The firm value `V = q(a − q)`: price `a − q` times quantity `q`, marginal cost `0`. -/
def firmValue (q a : ℝ) : ℝ := q * (a - q)

/-- Linear strategies: the insider's demand `d(V) = α + βV` (5) and the market maker's pricing
rule `P(y) = μ + λ y` (6). `lam` stands for `λ`. -/
structure LinStrat where
  α : ℝ
  β : ℝ
  μ : ℝ
  lam : ℝ

/-- The insider's demand `d(V) = α + βV`, (5). -/
def demand (e : LinStrat) (v : ℝ) : ℝ := e.α + e.β * v

/-- The market maker's price `P(y) = μ + λ y` for total order flow `y`, (6). -/
def price (e : LinStrat) (y : ℝ) : ℝ := e.μ + e.lam * y

/-- The total order flow `D = d(V) + u` as a function of `(a, u)`. -/
def orderFlow (e : LinStrat) (q : ℝ) : ℝ × ℝ → ℝ :=
  fun x => demand e (firmValue q x.1) + x.2

/-- (3): the insider's expected trading profit from demand `d` when the firm value is `v`,
averaged over the noise trade `u` only. -/
noncomputable def insiderPayoff (P : Params) (e : LinStrat) (v d : ℝ) : ℝ :=
  ∫ u, (v - price e (d + u)) * d ∂(lawU P)

/-- The insider's linear demand is a best response to the pricing rule for every realized `a`. -/
def InsiderOptimal (P : Params) (q : ℝ) (e : LinStrat) : Prop :=
  ∀ a d : ℝ, insiderPayoff P e (firmValue q a) d ≤
    insiderPayoff P e (firmValue q a) (demand e (firmValue q a))

/-- (4): the price is `E[V | D]`, the conditional expectation of the firm value given the
σ-algebra generated by the order flow, almost surely under the joint law. -/
def MarketEfficient (P : Params) (q : ℝ) (e : LinStrat) : Prop :=
  (fun x => price e (orderFlow e q x)) =ᵐ[law P]
    (law P)[fun x => firmValue q x.1 | MeasurableSpace.comap (orderFlow e q) inferInstance]

/-- A linear equilibrium of the trading stage that follows production quantity `q`. -/
def IsLinEq (P : Params) (q : ℝ) (e : LinStrat) : Prop :=
  InsiderOptimal P q e ∧ MarketEfficient P q e

/-- `E[Π(q)]`: the insider's expected trading profit `E[(V − P(D)) d]` over `(a, u)`. -/
noncomputable def tradingProfit (P : Params) (q : ℝ) (e : LinStrat) : ℝ :=
  ∫ x, (firmValue q x.1 - price e (orderFlow e q x)) * demand e (firmValue q x.1) ∂(law P)

/-- `E[V(q)]`, the expected firm value. -/
noncomputable def expFirmValue (P : Params) (q : ℝ) : ℝ := ∫ a, firmValue q a ∂(lawA P)

/-- The manager's objective (2): `ω E[V(q)] + E[Π(q)]`. -/
noncomputable def objective (P : Params) (q : ℝ) (e : LinStrat) : ℝ :=
  P.ω * expFirmValue P q + tradingProfit P q e

/-- Backward-induction linear equilibrium: the trading stage at `q` is a linear equilibrium `e`,
and `(q, e)` does at least as well in (2) as every quantity `q'` followed by any linear
equilibrium `e'` of its own trading stage. -/
def IsEquilibrium (P : Params) (q : ℝ) (e : LinStrat) : Prop :=
  IsLinEq P q e ∧ ∀ q' e', IsLinEq P q' e' → objective P q' e' ≤ objective P q e

/-- Proposition 1's production quantity `q̂ = E[a|s]/2 + κ/(4ω)`. -/
noncomputable def qHat (P : Params) : ℝ := postMean P / 2 + kappa P / (4 * P.ω)

/-- Proposition 1's trading coefficients at quantity `q`. -/
noncomputable def eqStrat (P : Params) (q : ℝ) : LinStrat where
  α := -(Real.sqrt P.Su / Real.sqrt (postVar P)) * (postMean P - q)
  β := Real.sqrt P.Su / (q * Real.sqrt (postVar P))
  μ := q * (postMean P - q)
  lam := q / (2 * Real.sqrt P.Su) * Real.sqrt (postVar P)

end KyleProduction.Monopoly


