-- Source module: Solutions.J6SegILJKer11
/-!
# B-line IL, the `J` kernel (B4), part 11: the coupling window

Row `r` of `cplP` reads `|cc_r|`, runs the dot loop on the window `E = ze.drop r` and pushes
`W_r = dotF P cc_r (ze.drop r)` onto `W`, then drops the head of `E` (`cpl_body`). After
`m = top HM` rows `W = (W_0, …, W_{m-1}).reverse` (`cplP_spec`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

section cpl
variable (P : ℕ) (F : Fin HS → List ℤ) (cc : List (List ℤ)) (ze R T0 : List ℤ)

variable {P F cc ze R T0}

theorem cplP_spec_sol_aux {M : MulSpec} {Xb Φm Bx Bc : ℕ} (hMB : MulBnd M Xb Φm) (s : IState HS)
    {lp lp1 lh : List ℤ} (hF : CplF P F lp lp1) (hm : cc.length ≤ ze.length)
    (hwf : ∀ r (h : r < cc.length), cc[r].length + r ≤ ze.length)
    (hcB : ∀ r (h : r < cc.length), Bnd Xb cc[r]) (hzB : Bnd Xb ze) (hzl : ze.length < 2 ^ Bc)
    (hXB : 2 * Xb + P + Bc + 3 ≤ Bx) (hT : F dTJ = flatT cc ++ R) (hTT : F TT = T0)
    (hE : F E = ze) (hW : F W = []) (hHM : F HM = (cc.length : ℤ) :: lh) :
    MSp M cplP (encK s F) (encK s (cSt P F cc ze R T0 cc.length))
      ((∑ r ∈ range cc.length, ((cc.getD r []).length + 3) + 1) * uC Φm Bx Bc) := by
  have e0 : cSt P F cc ze R T0 0 = F := by
    funext j
    simp only [cSt, update_apply, List.drop_zero, List.take_zero, List.range_zero, List.map_nil,
      List.reverse_nil]
    by_cases j1 : j = W
    · subst j1; simp +decide [hW]
    by_cases j2 : j = E
    · subst j2; simp +decide [hE]
    by_cases j3 : j = TT
    · subst j3; simp +decide [hTT, flatT]
    by_cases j4 : j = dTJ
    · subst j4; simp +decide [hT]
    simp [j1, j2, j3, j4]
  have hCR : ∀ k, cSt P F cc ze R T0 k CR = [] := fun k => by
    simp +decide [cSt, update_apply, hF.cr]
  have hw : CR ∉ cplB.writes := by
    simp +decide [cplB, dotP, kD, rdT, RM.writes, RS.writes, mvK]
  have hzm : zsz (cc.length : ℤ) ≤ Bc := by apply zsz_le_of_lt; simp; omega
  have hloop := MSp.repS (M := M) (C := CR) (n := .reg HM) (b := cplB) (s := s)
    (F := fun k => cSt P F cc ze R T0 k) (N := cc.length) (B := Bc)
    (c := fun r => ((cc.getD r []).length + 2) * uC Φm Bx Bc) (by decide) hCR hw
    (RS.clean_of_lt (by decide))
    (by simp only [e0]; exact isInt_encK hHM) (by simp only [e0, Ex.Bnd, top_encK hHM]; exact hzm)
    (by simp only [e0]; simp [Ex.eval, top_encK hHM]) (fun k hk => by
      have := cpl_body (R := R) (T0 := T0) hMB s hF hm hwf hcB hzB hzl hXB cc.length k hk
      rw [List.getD_eq_getElem _ _ hk]; exact this)
  simp only [e0] at hloop
  refine hloop.mono ?_
  simp only [Ex.size]
  have hsum : ∑ k ∈ range cc.length, (((cc.getD k []).length + 2) * uC Φm Bx Bc +
      4 * 10 ^ 7 * (Bc + 2) ^ 2 + 30) ≤
      ∑ k ∈ range cc.length, ((cc.getD k []).length + 3) * uC Φm Bx Bc := by
    apply Finset.sum_le_sum
    intro k _
    simp only [uC]; nlinarith
  have e1 : (∑ r ∈ range cc.length, ((cc.getD r []).length + 3) + 1) * uC Φm Bx Bc =
      ∑ r ∈ range cc.length, ((cc.getD r []).length + 3) * uC Φm Bx Bc + uC Φm Bx Bc := by
    rw [add_mul, Finset.sum_mul, one_mul]
  rw [e1]
  have : 2 * 10 ^ 7 * (Bc + 2) ^ 2 + 32 ≤ uC Φm Bx Bc := by simp only [uC]; nlinarith
  omega

end cpl

end J6Seg.JK

end

