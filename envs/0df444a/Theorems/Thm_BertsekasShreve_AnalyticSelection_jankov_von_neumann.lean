-- title:
--   Proposition 7.49 (Jankov–von Neumann) — analytic sets admit analytically measurable selectors
-- statement:
--   Let $X$ and $Y$ be Borel spaces and $A\subseteq X\times Y$ an analytic set. There exists an analytically measurable function
--   $$\varphi:\mathrm{proj}_X(A)\to Y\qquad\text{with}\qquad \mathrm{Gr}(\varphi)\subseteq A,$$
--   that is, $(x,\varphi(x))\in A$ for every $x\in\mathrm{proj}_X(A)$.
--
--   This is the uniformization theorem on which the ε-optimal selection results of the book rest: a selector exists that is measurable with respect to the σ-algebra generated by the analytic sets, which is in general strictly smaller than the universal σ-algebra.
-- source:
--   Bertsekas & Shreve, Stochastic Optimal Control: The Discrete-Time Case, Athena Scientific 1996, p. 182, Proposition 7.49

import Mathlib
import Definitions.Def_BertsekasShreve_AnalyticSelection_BorelSpace
import Definitions.Def_BertsekasShreve_AnalyticSelection_Measurability

open MeasureTheory

namespace BertsekasShreve.AnalyticSelection

/-- **Proposition 7.49** (Jankov–von Neumann theorem, p. 182). Let `X`, `Y` be Borel spaces and
`A ⊆ X × Y` analytic. There is an analytically measurable `φ : proj_X(A) → Y` whose graph lies
in `A`. -/
theorem jankov_von_neumann {X Y : Type*}
    [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X] [IsBorelSpace X]
    [TopologicalSpace Y] [MeasurableSpace Y] [BorelSpace Y] [IsBorelSpace Y]
    (A : Set (X × Y)) (hA : AnalyticSet A) :
    ∃ φ : (Prod.fst '' A) → Y,
      IsAnalyticallyMeasurableFun (Prod.fst '' A) φ ∧ ∀ x : Prod.fst '' A, ((x : X), φ x) ∈ A := by sorry

end BertsekasShreve.AnalyticSelection
