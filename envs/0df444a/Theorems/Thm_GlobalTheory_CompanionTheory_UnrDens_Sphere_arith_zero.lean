theorem GlobalTheory.CompanionTheory.UnrDens.Sphere.arith_zero (q ε x Q : ℝ) (hq : q ≠ 0) :
    (q * (1 + ε) - ε) * (Q / q * (1 + (q - 1) * x)) +
        (q ^ 2 - (q * (1 + ε) - ε)) * (Q / q * (1 - x)) =
      Q * q ^ 2 / q * (1 + (q - 1) * (x * (ε / q))) := by sorry
