theorem fcost_sim_sol_aux {π : KIL.PMap} (hπ : KIL.PLow π) {p p' : RS} (h : KIL.RSim π p p') :
    (∀ i v, π i = some v → i ∉ p.writes) → ∀ s, KIL.PV π s → p.ok s →
      fcost p' s ≤ 200 * fcost p s := by
  induction h with
  | skip => intro _ s _ _; simp [fcost]
  | asg i he =>
    intro _ s hs _
    simp only [fcost, asgCost, he.eval_eq hs]
    have := he.cost_le hs; omega
  | push i he =>
    intro _ s hs _
    simp only [fcost, he.eval_eq hs]
    have := he.cost_le hs; omega
  | pop i => intro _ s _ _; simp only [fcost]; omega
  | @seq a a' b b' ha hb iha ihb =>
    intro hw s hs hok
    have hwa : ∀ i v, π i = some v → i ∉ a.writes := fun i v hv h' =>
      hw i v hv (by simp only [RS.writes, List.mem_append]; exact Or.inl h')
    have hwb : ∀ i v, π i = some v → i ∉ b.writes := fun i v hv h' =>
      hw i v hv (by simp only [RS.writes, List.mem_append]; exact Or.inr h')
    have c1 := iha hwa s hs hok.1
    have r1 := (ha.sim hπ hwa s hs hok.1).2.1
    have hs' : KIL.PV π (a.run s) := hs.of_G (fun i v hv => RS.run_G_of_not_mem _ s i (hwa i v hv))
    have c2 := ihb hwb _ hs' hok.2
    simp only [fcost, r1]; omega
  | ite hc ha hb iha ihb =>
    intro hw s hs hok
    have hwa : ∀ i v, π i = some v → i ∉ _ := fun i v hv h' =>
      hw i v hv (by simp only [RS.writes, List.mem_append]; exact Or.inl h')
    have hwb : ∀ i v, π i = some v → i ∉ _ := fun i v hv h' =>
      hw i v hv (by simp only [RS.writes, List.mem_append]; exact Or.inr h')
    obtain ⟨hcl, hco, hbr⟩ := hok
    have he := hc.eval_eq hs
    simp only [fcost, he]
    have := hc.cost_le hs
    split_ifs at hbr ⊢
    · have := iha hwa s hs hbr; omega
    · have := ihb hwb s hs hbr; omega
  | @rep i n n' b b' hn hb ihb =>
    intro hw s hs hok
    have hwb : ∀ j v, π j = some v → j ∉ b.writes := fun j v hv h' =>
      hw j v hv (by simp only [RS.writes, List.mem_cons]; exact Or.inr h')
    have hwi : ∀ j v, π j = some v → j ≠ i := fun j v hv h' =>
      hw j v hv (by simp only [RS.writes, List.mem_cons]; exact Or.inl h')
    obtain ⟨hi, hnc, hno, hn0, hiw, hbok⟩ := hok
    have he := hn.eval_eq hs
    set N := (n.eval s).toNat
    have hPV : ∀ k, KIL.PV π (repSt i n b s k) := fun k =>
      hs.of_G (fun j v hv => KIL.repSt_G_of_not_mem i n b s j (hwi j v hv) (hwb j v hv) k)
    have hst : ∀ k ≤ N, repSt i n' b' s k = repSt i n b s k := by
      intro k hk
      induction k with
      | zero => simp only [repSt, Function.iterate_zero, id, he]
      | succ k ih =>
        simp only [repSt] at ih ⊢
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih (by omega)]
        have := (hb.sim hπ hwb _ (hPV k) (hbok k (by omega))).2.1
        simp only [repSt] at this
        rw [this]
    have hN' : (n'.eval s).toNat = N := by rw [he]
    simp only [fcost, he]
    rw [show (n'.eval s).toNat = N from hN'] at *
    have hsum : (∑ k ∈ Finset.range N, (fcost b' (repSt i n' b' s k) + 31)) ≤
        200 * (∑ k ∈ Finset.range N, (fcost b (repSt i n b s k) + 31)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_le_sum fun k hk => ?_
      rw [Finset.mem_range] at hk
      rw [hst k hk.le]
      have := ihb hwb _ (hPV k) (hbok k hk)
      omega
    have := hn.cost_le hs
    simp only [N] at hsum
    omega

end KFD

end NLogN

