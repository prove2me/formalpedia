variable {ι : Type*} [DecidableEq ι]
  (p : ι → OAI.SecondPassArithmetic.O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
  (hcop : Pairwise (Function.onFun IsCoprime (fun i => Ideal.span {p i})))
  (hg : ∀ i, lambda ∉ Ideal.span {p i})

theorem OAI.SecondPassArithmetic.secondTotalWeight_norm_le
    (hinj : Function.Injective (fun i => Ideal.span {p i}))
    (hc : ∀ i, ringChar (O ⧸ Ideal.span {p i}) ≠ 2)
    (Ψ₁ Ψ₂ : O →* ℂ) (m r c d e k : O) (z : SecondRayIndex) (S : Finset ι)
    (hΨ₁ : ‖Ψ₁ (∏ i ∈ S, p i)‖ ≤ 1) (hΨ₂ : ‖Ψ₂ (∏ i ∈ S, p i)‖ ≤ 1) :
    ‖secondTotalWeight p hp hcop hg Ψ₁ Ψ₂ m r c d e k (z,S)‖ ≤ ‖secondRayCoefficient z‖ := by sorry
