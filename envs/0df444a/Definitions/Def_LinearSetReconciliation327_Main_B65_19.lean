  let m1 := Function.update (Function.update m 88 0) 112 w
  have hf01 : MemoryFrame (rootBasisWritable R U D C TB cap Q0 Q1 t) m m1 :=
    (initializeLoop_frame m 88 112 w).mono (by
      intro addr ha
      left
      dsimp [rootBasisMeta]
      omega)
  have hc1 := hc.of_basis_frame hl hQ0 hQ1 hQ0sep.QZ hQ1sep.QZ hf01
  have hv1 : RootBasisView b R U D C TB ZB cap L Q0 Q1 fs0 0 w m1 := by
    refine ⟨hc1, (hq.meta_update hQ0 88 0 (by norm_num)).meta_update hQ0 112 w (by norm_num), ?_, ?_, ?_, ?_, ?_⟩
    · simpa [m1] using hm83
    · simpa [m1] using hm84
    · simpa [m1] using hm89
    · simp [m1]
    · simp [m1]
  have hwWord : w < 2 ^ E.W := by have he : E.W < 2 ^ E.W := Nat.lt_two_pow_self; omega
  obtain ⟨hInitAt, hRootAt⟩ := At.seqStmt hAt
  have hInit : Sem P E pc (pc + 42) (boundaryState pc m)
      (fun k z => k ≤ 42 ∧ z = boundaryState (pc + 42) m1) :=
    Sem.boundary_block P E pc (initializeLoopCode 88 112 77) m m1 hInitAt
      (by simp [initializeLoopCode, setMetaCode, copyMetaCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (initializeLoop_spec E _ 88 112 77 w (by omega) hmeta (by omega) (by decide) hwWord hc.dimension)
  have hRoot := rootBasisProcedure_spec b ι t N P E (pc + 42) R U D C TB ZB cap L Q0 Q1 fs0 m1 hRootAt
    hw hW hdet ht hL hcap hl hwords hQ0 hQ1 hQ0word hQ1word hQ0sep hQ1sep hdisj hmeta hpos hmass hv1
  have hFull := Sem.seq_bound hInit (fun z _ hz => by subst z; exact hRoot)
  refine Sem.mono hFull ?_
  intro k z hQ
  obtain ⟨hk, m2, hz2, BQ, QB, fs, horder, hv2, hpos2, hmass2, hforest, hf12⟩ := hQ
  exact ⟨by omega, m2, hz2, BQ, QB, fs, horder, hv2, hpos2, hmass2, hforest, MemoryFrame.trans hf01 hf12⟩

