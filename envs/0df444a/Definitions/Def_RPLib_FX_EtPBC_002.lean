section Chart

instance etale_tensor₂ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C] [Algebra.Etale A C] :
    Algebra.Etale A (C ⊗[A] C) :=
  Algebra.Etale.comp A C (C ⊗[A] C)

variable {X : Scheme.{u}} {A : Type u} [CommRing A] (σ : Spec (CommRingCat.of A) ⟶ X) [Etale σ]

/-- `Spec R` as an etale `X`-object through `σ`. -/
def etS (R : Type u) [CommRing R] [Algebra A R] [Algebra.Etale A R] : X.Etale :=
  MorphismProperty.Over.mk ⊤ (Spec.map (CommRingCat.ofHom (algebraMap A R)) ≫ σ) (by
    have : Etale (Spec.map (CommRingCat.ofHom (algebraMap A R))) :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).2 (RingHom.etale_algebraMap.2 inferInstance)
    infer_instance)

end Chart

