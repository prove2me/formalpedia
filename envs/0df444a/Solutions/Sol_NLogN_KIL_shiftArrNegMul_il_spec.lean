theorem ceil_split {c : ℕ} (hc : 0 < c) (a : ℕ) :
    (a + c - 1) / c = a / c + (if a % c = 0 then 0 else 1) := by
  have e : a + c - 1 = c * (a / c) + (a % c + c - 1) := by
    have := Nat.div_add_mod a c; omega
  rw [e, Nat.mul_add_div hc]
  congr 1
  split_ifs with h
  · rw [h, Nat.zero_add]; exact Nat.div_eq_of_lt (by omega)
  · have := Nat.mod_lt a hc
    exact Nat.div_eq_of_lt_le (by omega) (by omega)

theorem nxt_hit (hc : 0 < c) {j z : ℕ} (h : (j * Q + z) % c = 0) :
    nxt Q c j z = (j * Q + z) / c ∧ nxt Q c j (z + 1) = (j * Q + z) / c + 1 := by
  constructor
  · unfold nxt; rw [ceil_split hc, if_pos h, Nat.add_zero]
  · unfold nxt
    rw [show j * Q + (z + 1) + c - 1 = j * Q + z + c by omega]
    have e : j * Q + z + c = c * ((j * Q + z) / c + 1) := by
      have := Nat.div_add_mod (j * Q + z) c; rw [h] at this; rw [Nat.mul_add, Nat.mul_one]; omega
    rw [e, Nat.mul_div_cancel_left _ hc]

theorem nxt_miss (hc : 0 < c) {j z : ℕ} (h : (j * Q + z) % c ≠ 0) :
    nxt Q c j (z + 1) = nxt Q c j z := by
  unfold nxt
  rw [show j * Q + (z + 1) + c - 1 = (j * Q + z) + c by omega, Nat.add_div_right _ hc,
    ceil_split hc, if_neg h]

theorem nxt_mono (j : ℕ) {z z' : ℕ} (h : z ≤ z') : nxt Q c j z ≤ nxt Q c j z' :=
  Nat.div_le_div_right (by omega)

theorem nxt_Q (j : ℕ) : nxt Q c j Q = lo Q c (j + 1) := by
  unfold lo nxt; congr 1; ring_nf

theorem lo_zero : lo Q c 0 = 0 := by
  unfold lo nxt; simp only [Nat.zero_mul, Nat.add_zero, Nat.zero_add]
  rcases Nat.eq_zero_or_pos c with h | h
  · simp [h]
  · exact Nat.div_eq_of_lt (by omega)

theorem lo_c (hc : 0 < c) : lo Q c c = Q := by
  unfold lo nxt
  rw [Nat.add_zero, Nat.mul_comm, show Q * c + c - 1 = (c - 1) + c * Q by rw [Nat.mul_comm]; omega,
    Nat.add_mul_div_left _ _ hc, Nat.div_eq_of_lt (by omega), Nat.zero_add]

theorem lo_mono {j j' : ℕ} (h : j ≤ j') : lo Q c j ≤ lo Q c j' :=
  Nat.div_le_div_right (by have := Nat.mul_le_mul_right Q h; omega)

