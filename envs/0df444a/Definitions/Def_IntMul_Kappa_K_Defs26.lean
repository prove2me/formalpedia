-- Source module: Solutions.KFY2Trans
/-!
# KFY 2: the axis rotation of `TransNeed` as an `RM` procedure node

The line passes are register programs (`RM`, nlogn `HRM`). The axis exposure is `TransNeed`'s
rotation, an item-language procedure with its descriptor on an unknown stack `dT ≠ 0`. It enters
the `RM` program as one `RM.prc` node (`trPrc`) whose code calls a small wrapper procedure:

`trW X Y dT jT = xfer X Y dT; call jT; unxfer dT`

The caller builds the descriptor `descTr w h bs` on its own stack `X` above a mark (any `X, Y` with
`X, Y ≠ dT`). The wrapper moves it to `dT` (KFMSC `xfer`), calls the rotation, and drops it
again.

* `trF` / `trPre` / `trC`: the functional specification, the precondition and the cost of the
  node. `trF` decodes the descriptor and the array from the state, so it is an honest function
  of the state. The cost is an upper bound (`IRuns` bounds costs from above), so the node does not
  depend on the input tape `Isym`.
* **`trW_runs`** / **`trPrc_ok`** (`PrcOK`): the wrapper meets the node's specification, from the
  `TransNeed` run (stated here for any table that contains the wrapper and the rotation).
* **`trF_eq`**, **`trC_le`**: on a state with explicit `w h bs zs l R`, `trF` is the rotation
  `transposeL t (V/t)` on stack `0`, and its cost is the `TransNeed` bound plus `O(k B)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM KIL KFB AModel

/-! ## Decoding -/

/-- The integer of an item (`0` for a mark). -/
def itZ : Item → ℤ
  | .int z => z
  | .mark => 0

/-- The items above the first mark. -/
def blk (L : List Item) : List Item := L.takeWhile fun it => it != .mark

/-- The items below the first mark. -/
def aft (L : List Item) : List Item := (L.dropWhile fun it => it != .mark).tail

/-- `h` from a rotation descriptor `[w, h, k, b…]`. -/
def hOf (D : List Item) : ℕ := (itZ (D.getD 1 .mark)).toNat

/-- `w` from a rotation descriptor. -/
def wOfD (D : List Item) : ℕ := (itZ (D.getD 0 .mark)).toNat

/-- The bits from a rotation descriptor. -/
def bsOf (D : List Item) : List Bool := (D.drop 3).map fun it => decide (it = .int 1)

/-- The first `n` Gaussian pairs of an item list. -/
def pairsOf : ℕ → List Item → List GI
  | 0, _ => []
  | n + 1, a :: b :: rest => (itZ a, itZ b) :: pairsOf n rest
  | _ + 1, _ => []

/-! ## The node -/

section node

variable (X dT : Fin HS) (Kc : ℝ)

/-- Shape of the descriptor on `X`. -/
def trSh (u : IState HS) : Shape := shPad (hOf (NLogN.KFY.blk (u.G X))) (bsOf (NLogN.KFY.blk (u.G X)))

/-- **The functional specification**: drop the descriptor block on `X`, rotate stack `0`. -/
def trF (u : IState HS) : IState HS :=
  (u.upd X (aft (u.G X))).upd 0
    (ints (gflat (transposeL ((trSh X u).headD 1) (vol (trSh X u).tail)
      (pairsOf (vol (trSh X u)) (u.G 0)))) ++ (u.G 0).drop (2 * vol (trSh X u)))

/-- The precondition: a rotation descriptor over a mark on `X`, a matching array on `0`. -/
def trPre (u : IState HS) : Prop :=
  ∃ (w h : ℕ) (bs : List Bool) (zs : List GI) (l R : List Item),
    u.G X = ints (descTr w h bs) ++ .mark :: R ∧ u.G 0 = ints (gflat zs) ++ l ∧
      1 ≤ h ∧ bs ≠ [] ∧ zs.length = vol (shPad h bs) ∧ NLogN.KFB.GB w zs

/-- The `TransNeed` cost bound for `w h k V`. -/
noncomputable def trBound (w h k V : ℕ) : ℝ :=
  Kc * (((k + 1 : ℕ) : ℝ) * ((w : ℝ) + 1) * ((V : ℝ) + 1) * ((h : ℝ) ^ KFS.τS + 1) +
    (((k + 1) * (h + w + k + 1) ^ 2 : ℕ) : ℝ))

/-- Bit size of the descriptor entries. -/
def trB (w h k : ℕ) : ℕ := w + h + k + 1

/-- The overhead of the wrapper (`xfer`, `unxfer`, calls). -/
def trOver (w h k : ℕ) : ℕ := 3 * (k + 3) * NLogN.KFM.cMv (trB w h k) + 110

/-- The cost of the node (an upper bound). -/
noncomputable def trC (u : IState HS) : ℕ :=
  ⌈trBound Kc (wOfD (NLogN.KFY.blk (u.G X))) (hOf (NLogN.KFY.blk (u.G X))) (bsOf (NLogN.KFY.blk (u.G X))).length
      (vol (trSh X u))⌉₊ +
    trOver (wOfD (NLogN.KFY.blk (u.G X))) (hOf (NLogN.KFY.blk (u.G X))) (bsOf (NLogN.KFY.blk (u.G X))).length

theorem trF_frame (u : IState HS) (j : Fin HS) (hj : j ∉ [X, 0]) : (trF X u).G j = u.G j := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hj
  simp [trF, hj.1, hj.2]

theorem trF_io (u : IState HS) : (trF X u).ip = u.ip ∧ (trF X u).out = u.out := by
  simp [trF]

/-- **The rotation node.** Procedure `pc 1` is the wrapper. -/
noncomputable def trPrc : RM :=
  .prc 0 (trF X) (trC X Kc) (trPre X) [X, 0] (trF_frame X) (trF_io X)

end node

/-! ## The wrapper procedure -/

/-- The wrapper body: move the descriptor to `dT`, rotate, drop the descriptor. -/
def trW {P : ℕ} (X Y dT : Fin HS) (jT : Fin P) : IStmt HS P :=
  .seq (xfer X Y dT) (.seq (.call jT) (unxfer dT))

/-- The rotation, as an `IRuns` hypothesis on a table (the `TransNeed` clause, relabelled). -/
def TrHyp {P : ℕ} (I : List Sym) (iprog : Fin P → IStmt HS P) (jT : Fin P) (dT : Fin HS)
    (Kc : ℝ) : Prop :=
  ∀ (w h : ℕ) (bs : List Bool), 1 ≤ h → bs ≠ [] →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dT → f j = []) →
    f dT = descTr w h bs →
    f 0 = gflat zs ++ l → zs.length = vol (shPad h bs) → NLogN.KFB.GB w zs →
    ∃ c : ℕ, IRuns I iprog (.call jT) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0
          (gflat (transposeL ((shPad h bs).headD 1) (vol (shPad h bs).tail) zs) ++ l))) c ∧
      (c : ℝ) ≤ trBound Kc w h bs.length (vol (shPad h bs))

end NLogN.KFY

end

