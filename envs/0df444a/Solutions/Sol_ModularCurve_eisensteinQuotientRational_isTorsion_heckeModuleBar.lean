private def KummerPackageV5 (p : ℕ) [Fact p.Prime] : Prop :=
  ∀ q : ℕ, (hq : q.Prime) → q ∣ ((p : ℤ) - 1).natAbs / ((p : ℤ) - 1).gcd 12 →
    haveI : Fact q.Prime := ⟨hq⟩
    ∃ R : ∀ m : ℕ,
        letI := heckeModuleBar p
        JKummerRow q m (eisensteinQuotientRationalLocalized p q),
      (∀ m : ℕ,
        letI := heckeModuleBar p; letI := (R m).instH1Jtors; Finite (R m).H1Jtors) ∧
      ∃ Φ : ∀ m : ℕ,
          letI := heckeModuleBar p
          OpenAction ↥(eisensteinPrimaryTorsionBar p q m),
        (∀ m : ℕ,
          letI := heckeModuleBar p
          ∀ (σ : (AlgebraicClosure ℚ) ≃ₐ[ℚ] (AlgebraicClosure ℚ))
            (x : ↥(eisensteinPrimaryTorsionBar p q m)),
            ((Φ m).φ σ x : JZero p) = σ • (x : JZero p)) ∧
        ∃ c : ∀ m : ℕ,
            letI := heckeModuleBar p
            AdmissibleChain q (Φ m),
          ∃ h0 δ h1 : ℕ → ℕ,
            (∀ m : ℕ,
              letI := heckeModuleBar p; letI := (R m).instH1Jtors
              Nat.card (R m).H1Jtors ≤ q ^ h1 m) ∧
            (∀ m : ℕ,
              letI := heckeModuleBar p
              (h1 m : ℤ) + (filtAlpha (c m) : ℤ) ≤ (h0 m : ℤ) + (δ m : ℤ)) ∧
            (∃ g : ℕ, ∃ C : ℤ, ∀ m : ℕ,
              letI := heckeModuleBar p
              (δ m : ℤ) ≤ (m : ℤ) * (g : ℤ) + C ∧
                (m : ℤ) * (g : ℤ) ≤ (filtAlpha (c m) : ℤ) + C) ∧
            (∃ H₀ : ℕ, ∀ m : ℕ, h0 m ≤ H₀)

private theorem h1Jtors_bounded {ι : Type} (card : ι → ℕ) (q : ℕ) (hq : q.Prime)
    (fa : ι → ℕ) (h0 δ h1 : ι → ℕ) (lvl : ι → ℕ)
    (hh1 : ∀ m, card m ≤ q ^ h1 m)
    (hdev : ∀ m, (h1 m : ℤ) + (fa m : ℤ) ≤ (h0 m : ℤ) + (δ m : ℤ))
    (hδα : ∃ g : ℕ, ∃ C : ℤ, ∀ m,
      (δ m : ℤ) ≤ (lvl m : ℤ) * (g : ℤ) + C ∧ (lvl m : ℤ) * (g : ℤ) ≤ (fa m : ℤ) + C)
    (hh0 : ∃ H₀ : ℕ, ∀ m, h0 m ≤ H₀) :
    ∃ Kb : ℕ, ∀ m, card m ≤ Kb := by
  obtain ⟨g, C, hgC⟩ := hδα
  obtain ⟨H₀, hH₀⟩ := hh0
  refine ⟨q ^ (H₀ + (2 * C).toNat), fun m => ?_⟩
  have hb : h1 m ≤ H₀ + (2 * C).toNat := by
    have h₁ := (hgC m).1
    have h₂ := (hgC m).2
    have h₃ := hdev m
    have h₄ := hH₀ m
    have h₅ := Int.self_le_toNat (2 * C)
    omega
  exact le_trans (hh1 m) (Nat.pow_le_pow_right hq.pos hb)

private theorem core (p : ℕ) [Fact p.Prime] (hcomm : HeckeOperatorsCommuteBar p) (hp5 : 5 ≤ p)
    (hpkg : KummerPackageV5 p) :
    letI := heckeModuleBar p
    ∀ z ∈ eisensteinQuotientRational p (heckeModuleBar p), ∃ n : ℕ, 0 < n ∧ n • z = 0 := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  have hfgc := ModularCurve.eisensteinQuotientRational_closure_fg_heckeModuleBar p hcomm
    (ModularCurve.JZero.addGroup_fg_invariants_rat_of_prime_of_five_le p Fact.out hp5)
  have hB := ModularCurve.eisensteinQuotientRational_closure_locallyTorsion_isTorsion_heckeModuleBar
    p hcomm (ModularCurve.heckeSubalgebraBar_fg p) (ModularCurve.JZero.divisible p)
    (ModularCurve.jZeroTorsionFinite p)
  have hC := ModularCurve.eisensteinIdeal_image_cokernel_dvd_num_heckeModuleBar p hcomm
    (ModularCurve.heckeOperatorBar_self_add_frickeInvolutionBar_smul p)
  refine ModularCurve.eisensteinQuotientRational_isTorsion_heckeModuleBar_of_perPrimeFinite
    p hcomm hfgc ?_ hB hC
  intro q hq hqdiv
  haveI : Fact q.Prime := ⟨hq⟩
  obtain ⟨R, hfinH, Φ, hΦ, c, h0, δ, h1, hh1, hdev, hδα, hh0⟩ := hpkg q hq hqdiv
  exact ModularCurve.eisensteinQuotientRationalLocalized_eisensteinPrimary_stabilizes p hcomm q hfgc R
    (ModularCurve.eisensteinQuotientRationalLocalized_qPowQuotient_le_h1Jtors p hcomm q hfgc R hfinH)
    (h1Jtors_bounded (fun m => letI := (R m).instH1Jtors; Nat.card (R m).H1Jtors) q hq
      (fun m => letI := heckeModuleBar p; filtAlpha (c m)) h0 δ h1 (fun m => m) hh1 hdev hδα hh0)

theorem solution (p : ℕ) [Fact p.Prime]
    (hcomm : HeckeOperatorsCommuteBar p) :
    letI := heckeModuleBar p
    ∀ z ∈ eisensteinQuotientRational p (heckeModuleBar p), ∃ n : ℕ, 0 < n ∧ n • z = 0 := by
  by_cases hp5 : 5 ≤ p
  · exact core p hcomm hp5 (fun q hq hqdiv =>
      ModularCurve.exists_jKummerRow_admissibleChain_bounded_heckeModuleBar_v5 p hcomm q hq hqdiv)
  ·
    haveI : Subsingleton (JZero p) := ModularCurve.subsingleton_jZero_of_lt_five p (by omega)
    intro z _
    exact ⟨1, Nat.one_pos, Subsingleton.elim _ _⟩

end S_ModularCurve_eisensteinQuotientRational_isTorsion_heckeModuleBar
