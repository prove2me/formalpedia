-- title:
--   Theorem 6.5 — sensitivity to every block
-- statement:
--   Fix a degree $d$, a level $u\ge0$ and an exponent $\alpha\ge0$, and put $j=\lfloor\alpha\rfloor+1$, $\nu=m_{u+j-1}$. For all sufficiently large $n$ with $u+j\le h_{\max}(n)$, every DNF $\Phi$ of width at most $W$ on the leaves of $r$ independent blocks of height $j$ with dimensions $m_u,\dots,m_{u+j-1}$, where $1\le r\le W\le n^\alpha$, satisfies, uniformly over the prescribed root values of the blocks,
--   $$\Pr\bigl[\Phi(X)=1\text{ and }\Phi(X^{(i)})=0\text{ for all }i\bigr]\le2^{-\nu r/4}.$$
--   Here $X$ is the input generated by the blocks and $X^{(i)}$ flips the root value of block $i$ alone, with the same projections. This supplies the hypothesis of Theorem 6.9.
--
--   Differences from the source:
--   - generalization: a code family of Definition 3.1 → any family with the degree condition (CodeDeg d); reason: the paper says the switching argument uses the code family only through the degree bound (p. 6); every code family of Definition 3.1 qualifies
--   - reading: for all sufficiently large n, with thresholds depending only on u, alpha and d → one n0 chosen before the family, for given d, u and alpha; reason: this is what the paper's sentence on the thresholds says
-- source:
--   Mantri, Classical Verification of Quantum Computation Beyond the Polynomial Hierarchy, arXiv:2610.37635 (PDF sha256 d1fab777…1d0b33), Theorem 6.5, p. 26 (PDF p. 28)

import Mathlib
import Definitions.Def_MantriCVQ_CodeDeg
import Definitions.Def_MantriCVQ_Pr
import Definitions.Def_MantriCVQ_dimsRange
import Definitions.Def_MantriCVQ_listWidth
import Definitions.Def_MantriCVQ_sensitiveEvent

open QAlgorithms.Complexity SamplingAC0

namespace MantriCVQ

/-- **Theorem 6.5** (Mantri, arXiv:2610.37635 (PDF sha256 d1fab777…1d0b33), Theorem 6.5, p. 26 (PDF p. 28)): fix a degree `d`, a level `u` and an exponent
`α ≥ 0`, and put `j = ⌊α⌋ + 1`, `ν = m_{u+j-1}`. For all sufficiently large `n`, every DNF of width at most
`W` on the leaves of `r` independent blocks of height `j` with dimensions `m_u, …, m_{u+j-1}`, where
`1 ≤ r ≤ W ≤ n^α`, accepts `X` and is sensitive at `X` to the free leaf of every block with probability at
most `2^{-νr/4}`, uniformly over the prescribed root values.

**Formalization Note** The threshold `n₀` is chosen before the code family, since the paper says it
depends only on `u`, `α` and `d`. -/
theorem theorem_6_5 (d u : ℕ) (α : ℝ) (hα : 0 ≤ α) :
    ∃ n₀ : ℕ, ∀ (C : CodeDeg d) (n : ℕ), n₀ ≤ n → u + (⌊α⌋₊ + 1) ≤ hmax n →
      ∀ r W : ℕ, 1 ≤ r → r ≤ W → (W : ℝ) ≤ (n : ℝ) ^ α →
      ∀ Φ : DNF (Fin r × Addr (dimsRange n u (⌊α⌋₊ + 1))), listWidth Φ ≤ W →
      ∀ v : Fin r → Bool,
        Pr (fun s : Fin r → Seed (dimsRange n u (⌊α⌋₊ + 1)) =>
            sensitiveEvent C.code (dimsRange n u (⌊α⌋₊ + 1)) Φ v s) ≤
          (2 : ℝ) ^ (-((dim n (u + (⌊α⌋₊ + 1) - 1) : ℝ) * r / 4)) := by sorry

end MantriCVQ
