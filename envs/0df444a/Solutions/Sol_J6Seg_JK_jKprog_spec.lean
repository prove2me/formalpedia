  have hXB : Xb ≤ Bx := by omega
  have hrl : re.length = G := by simp [hre, hxl]
  have hil : im.length = G := by simp [him, hxl]
  -- the header
  have hhd : Bnd Bx (jHdr P k K G fs bs cc) := by
    intro a ha
    simp only [jHdr, List.mem_cons, List.not_mem_nil, or_false] at ha
    rcases ha with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact le_trans (zsz_pow2_le P) (by omega)
    · exact le_trans (zsz_pow2_le (P + 1)) (by omega)
    · exact le_trans (zsz_pow2_le k) (by omega)
    · exact zc _ (by omega)
    · exact zc _ (by omega)
    · exact zc _ (by omega)
    · apply zc
