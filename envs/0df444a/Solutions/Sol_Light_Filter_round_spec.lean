    rintro σ - ⟨Mc, z, D', μ', rfl, hm', hu', hM1, hMle, hI1', hDD', hpow⟩
    simp only [rFrame, stepArgs, List.cons_append, List.nil_append]
    have hMP : Mc ≤ PmaxOf x.n := hMle
    (focus
       ((first
           | refine Light.Ends.seqSelf ?_
           | refine Light.Ends.skipLast ?_);
         (repeat
             with_unfolding_none
               first
               | refine Light.Ends.seqAssoc ?_
               | refine Light.Ends.skipThen ?_))
       (first
         |
           refine
             Light.Ends.callToThen
               ((oracle_call (R := R) hsol E (d := d + 1) (by omega) hm'.kept hM1 hMP) _ (by omega)) ?_
               ?_ ?_ ?_
         |
           refine
             Light.Ends.callToThen (oracle_call (R := R) hsol E (d := d + 1) (by omega) hm'.kept hM1 hMP)
               ?_ ?_ ?_ ?_)
       (on_goal -1 =>
           first
           | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                   List.map_nil, List.sum_cons, List.sum_nil, ])
               (first
                 | omega
                 | ((ring_nf); (omega))))
           | omega
           |
             (simp [] <;>
                 first
                 | omega
                 | ((ring_nf); (omega))))
       (on_goal -1 => omega)
       (on_goal -1 =>
           ( (try have := Light.Std.space_le (by assumption))
             (try have := Light.Std.const_le (by assumption))
             (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))
       (on_goal -1 => ((rintro _ μ3 ⟨hcnt3, hkb3⟩); (try with_unfolding_none refine Light.Ends.skip ?_))))
    have hm3 := hm'.keep fun a ha => hkb3 a ⟨by omega, by omega⟩
    have hfa := filterAct_meets (lim := lim) (d := d + 1) HP.fa (μ := μ3) (act := aACT x.n fr)
      (cnt := aCNT x.n fr) (L := Light.Filter.LL x.n) (A := act)
      (c := fun i => cntOf x.n (Light.Filter.sOf x.n) Mc x.AB x.BC x.AC i) hm3.act hcnt3
      (by omega) (by omega) (by omega) hw (by omega)
    have hLZ : ((mOf x.n : ℤ) * ((x.n : ℤ) * (x.n : ℤ))) = (Light.Filter.LL x.n : ℤ) := by
      rw [hLN]; push_cast; ring
    (focus
       ((first
           | refine Light.Ends.seqSelf ?_
           | refine Light.Ends.skipLast ?_);
         (repeat
             with_unfolding_none
               first
               | refine Light.Ends.seqAssoc ?_
               | refine Light.Ends.skipThen ?_))
       (first
         | refine Light.Ends.callToThen (hfa _ (by omega)) ?_ ?_ ?_ ?_
         | refine Light.Ends.callToThen hfa ?_ ?_ ?_ ?_)
       (on_goal -1 =>
           first
           | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                   List.map_nil, List.sum_cons, List.sum_nil, hLZ])
               (first
                 | omega
                 | ((ring_nf); (omega))))
           | omega
           |
             (simp [hLZ] <;>
                 first
                 | omega
                 | ((ring_nf); (omega))))
       (on_goal -1 => omega)
       (on_goal -1 =>
           ( (try have := Light.Std.space_le (by assumption))
             (try have := Light.Std.const_le (by assumption))
             (simp [Light.Limits.Addr, abs_le, -abs_mul, hLZ] <;> omega)))
       (on_goal -1 => ((rintro _ μ4 ⟨hact4, hso4⟩); (try with_unfolding_none refine Light.Ends.skip ?_))))
    refine ⟨fun i => act i && decide (0 < cntOf x.n (Light.Filter.sOf x.n) Mc x.AB x.BC x.AC i), D', ?_, hI1',
      ?_, ?_⟩
    · exact ⟨fun a ha => (hso4 a (Or.inl (by omega))).trans (hm3.kept a ha),
        hm3.pool.congr fun i hi => hso4 _ (Or.inl (by omega)), hact4,
        hm3.done.congr fun i hi => hso4 _ (Or.inr (by omega))⟩
    · intro i hi hD hc0
      have hDi : D (i % (x.n * x.n)) = false := by
        cases h : D (i % (x.n * x.n)) with
        | false => rfl
        | true => rw [hDD' _ h] at hD; exact absurd hD (by simp)
      simp [hI2 i hi hDi hc0, cntOf_pos_of_cnt0 Mc hc0]
    · have he : eff (x.n * x.n) (fun i => act i && decide (0 < cntOf x.n (Light.Filter.sOf x.n) Mc x.AB x.BC x.AC i))
          D' = fun i => eff (x.n * x.n) act D' i &&
            decide (0 < cntOf x.n (Light.Filter.sOf x.n) Mc x.AB x.BC x.AC i) := by
        funext i
        simp only [eff]
        cases act i <;> cases D' (i % (x.n * x.n)) <;> simp
      rw [he]
      calc _ ≤ QOf x.n ^ rOf x.n * tot x.n (Light.Filter.sOf x.n) x.AB x.BC x.AC (eff (x.n * x.n) act D') Mc :=
            Nat.mul_le_mul_left _ (card_filter_le_tot _ _)
        _ ≤ _ := hpow
        _ ≤ _ := Nat.mul_le_mul_left _ (tot_le_s _ _)
end
