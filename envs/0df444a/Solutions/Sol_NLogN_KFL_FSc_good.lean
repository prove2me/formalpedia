  split_ifs with h1 h2 h3 h3
  · omega
  · rw [Nat.testBit_mod_two_pow]; simp [h2]
  · subst h3
    simp only [Nat.sub_self, Nat.testBit_zero]
    interval_cases v <;> simp
  · omega
  · omega
  · rw [Nat.testBit_div_two_pow]; congr 1; omega

