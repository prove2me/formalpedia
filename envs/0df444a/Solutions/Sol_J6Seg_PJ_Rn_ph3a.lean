-- Source module: Solutions.J6SegILPreJ5
/-!
# B-line IL, `J` pre-table (B5-J), part 5: register-only loops and the parameter recursions

* `Rn.loopA`: `repeat rN times (asgs l)` (registers only), from a step invariant.
* the four recursions of the parameter phase, as pure invariant lemmas:
  `sqrt` (`sqS_step`), `2^⌊log₂ x⌋` by doubling (`lgS_step`), `Nat.size` by halving
  (`szS_step`), `2^⌈log₂ m⌉` (`clS_step`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS E

/-! ## The recursions -/

/-- One halving step towards `Nat.size x`. -/
theorem szS_step (x k : ℕ) :
    (if 0 - ((x / 2 ^ k : ℕ) : ℤ) < 0 then ((min k (Nat.size x) : ℕ) : ℤ) + 1
      else ((min k (Nat.size x) : ℕ) : ℤ)) = ((min (k + 1) (Nat.size x) : ℕ) : ℤ) ∧
    ((x / 2 ^ k : ℕ) : ℤ) / 2 = ((x / 2 ^ (k + 1) : ℕ) : ℤ) := by
  refine ⟨?_, ?_⟩
  · rcases lt_or_ge k (Nat.size x) with h | h
    · rw [min_eq_left h.le, min_eq_left h]
      have h1 : 2 ^ k ≤ x := Nat.lt_size.mp h
      have h2 : 0 < x / 2 ^ k := Nat.div_pos h1 (by positivity)
      have : 0 - ((x / 2 ^ k : ℕ) : ℤ) < 0 := by
        have : (0 : ℤ) < ((x / 2 ^ k : ℕ) : ℤ) := by exact_mod_cast h2
        linarith
      rw [if_pos this]; push_cast; ring
    · rw [min_eq_right h, min_eq_right (by omega : Nat.size x ≤ k + 1)]
      have h1 : x < 2 ^ k := by
        by_contra hc; push Not at hc; have := Nat.lt_size.mpr hc; omega
      have h2 : x / 2 ^ k = 0 := Nat.div_eq_of_lt h1
      rw [h2]; simp
  · rw [pow_succ, ← Nat.div_div_eq_div_mul]; push_cast; rfl

end J6Seg.PJ

end

