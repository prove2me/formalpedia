/-- The exponent is represented by supplied slots, so the machine never
expands a binary exponent into exponentially many steps. -/
def powerStep (state : ℕ × ℕ) (_ : Unit) : ℕ × ℕ := (state.1,state.2*state.1)

@[fun_prop] theorem powerStep_poly : Poly (fun x : (ℕ × ℕ) × Unit => _root_.Integration9_9.LARCoinMachine.powerStep x.1 x.2) := by
  unfold _root_.Integration9_9.LARCoinMachine.powerStep
  fun_prop

 theorem _root_.Integration9_9.LARCoinMachine.powerState_length (state : ℕ × ℕ) :
    (enc state).length=2*state.1.bits.length+1+state.2.bits.length := by
  change (encodePair Nat.bits Nat.bits state).length = _
  exact encodePair_length _ _ _

 theorem _root_.Integration9_9.LARCoinMachine.powerStep_length (state : ℕ × ℕ) (slot : Unit) :
    (enc (_root_.Integration9_9.LARCoinMachine.powerStep state slot)).length ≤ (enc state).length+state.1.bits.length := by
  have h := NatBinary.mul_length state.2 state.1
  simp only [_root_.Integration9_9.LARCoinMachine.powerState_length,_root_.Integration9_9.LARCoinMachine.powerStep]
  omega

 theorem _root_.Integration9_9.LARCoinMachine.powerFold_length (slots : List Unit) (state : ℕ × ℕ) :
    (enc (slots.foldl _root_.Integration9_9.LARCoinMachine.powerStep state)).length ≤
      (enc state).length+slots.length*state.1.bits.length := by
  induction slots generalizing state with
  | nil => simp
  | cons slot slots ih =>
    have h := ih (_root_.Integration9_9.LARCoinMachine.powerStep state slot)
    have hs := _root_.Integration9_9.LARCoinMachine.powerStep_length state slot
    have hb : (_root_.Integration9_9.LARCoinMachine.powerStep state slot).1=state.1 := rfl
    rw [hb] at h
    simp only [List.foldl_cons,List.length_cons]
    nlinarith

 theorem _root_.Integration9_9.LARCoinMachine.powerFold_bound (slots : List Unit) (state : ℕ × ℕ)
    (pre suf : List Unit) (hsplit : slots=pre++suf) :
    (enc (pre.foldl _root_.Integration9_9.LARCoinMachine.powerStep state)).length ≤
      (X+X^2 : Polynomial ℕ).eval (encodePair (encodeList (enc : Unit → Str)) enc (slots,state)).length := by
  let length := (encodePair (encodeList (enc : Unit → Str)) enc (slots,state)).length
  have hlength : length=2*(encodeList (enc : Unit → Str) slots).length+1+(enc state).length :=
    encodePair_length _ _ _
  have hslots := EncodedList.length_le (enc : Unit → Str) slots
  have hpre : pre.length ≤ slots.length := by simp only [hsplit,List.length_append]; omega
  have hstate : (enc state).length ≤ length := by omega
  have hbase : state.1.bits.length ≤ length := by rw [_root_.Integration9_9.LARCoinMachine.powerState_length] at hstate; omega
  have hm : pre.length*state.1.bits.length ≤ length*length := Nat.mul_le_mul (by omega) hbase
  have hf := _root_.Integration9_9.LARCoinMachine.powerFold_length pre state
  change (enc (pre.foldl _root_.Integration9_9.LARCoinMachine.powerStep state)).length ≤ (X+X^2 : Polynomial ℕ).eval length
  simp only [eval_add,eval_pow,eval_mul,eval_X,pow_two]
  omega

@[fun_prop] theorem powerFold_poly :
    Poly (fun x : List Unit × (ℕ × ℕ) => x.1.foldl _root_.Integration9_9.LARCoinMachine.powerStep x.2) :=
  ⟨_root_.Integration9_9.LARCoinMachine.powerStep_poly.program.listFold () (X+X^2) _root_.Integration9_9.LARCoinMachine.powerFold_bound⟩

