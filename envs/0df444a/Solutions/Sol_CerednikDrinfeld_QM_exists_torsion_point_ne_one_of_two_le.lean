theorem solution
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle k f)
    (g : ℕ) (hdim : ∀ s : ↥(Spec (CommRingCat.of k)), topologicalKrullDim ↥(f.base ⁻¹' {s}) = g) (hg : 1 ≤ g)
    (n : ℕ) (hn : 2 ≤ n) :
    ∃ (R : Type) (_ : CommRing R) (t : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of k)) (x : SchemeHomOver t f),
      L.nsmul t n x = L.one t ∧ x ≠ L.one t := by
  haveI : Smooth f := hA.smooth
  haveI : SmoothOfRelativeDimension g f :=
    RelativeGroupLaw.smoothOfRelativeDimension_of_forall_topologicalKrullDim_eq L g hdim
  obtain ⟨H, iR, iH, hfin, -, hrank, -, e, -, hnat⟩ :=
    AbelianSchemePropertyBundle.exists_hopfAlgebra_torsion_finrank_eq_pow_and_nsmulAlgHom_eq
      k f L hc hA g n (by omega)
  refine ⟨H, iR, Spec.map (CommRingCat.ofHom (algebraMap k H)),
    (e H (WithConv.toConv (AlgHom.id k H))).val, (e H (WithConv.toConv (AlgHom.id k H))).property, ?_⟩
  intro hx

  have key : ∀ ψ : H →ₐ[k] H, ψ = AlgHom.id k H := by
    intro ψ
    have h1 := hnat H H ψ (WithConv.toConv (AlgHom.id k H))
    simp only [AlgHom.comp_id] at h1
    have hψt : Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap k H)) =
        Spec.map (CommRingCat.ofHom (algebraMap k H)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]
    have h2 : Spec.map (CommRingCat.ofHom ψ.toRingHom) ≫
        (L.one (Spec.map (CommRingCat.ofHom (algebraMap k H)))).1 =
        (L.one (Spec.map (CommRingCat.ofHom (algebraMap k H)))).1 := by
      have := L.one_natural _ _ (Spec.map (CommRingCat.ofHom ψ.toRingHom)) hψt
      exact congrArg Subtype.val this
    have h3 : (e H (WithConv.toConv ψ)).val = (e H (WithConv.toConv (AlgHom.id k H))).val := by
      apply Subtype.ext
      rw [h1, hx, h2]
    have h4 : e H (WithConv.toConv ψ) = e H (WithConv.toConv (AlgHom.id k H)) := Subtype.ext h3
    exact WithConv.toConv_injective ((e H).injective h4)

  have hηε := key ((Algebra.ofId k H).comp (Bialgebra.counitAlgHom k H))
  have hspan : ∀ h : H, ∃ c : k, c • (1 : H) = h := by
    intro h
    refine ⟨Coalgebra.counit (R := k) h, ?_⟩
    have := congrArg (fun φ : H →ₐ[k] H => φ h) hηε
    simpa [Algebra.ofId_apply, Algebra.algebraMap_eq_smul_one] using this
  have hle : Module.finrank k H ≤ 1 := finrank_le_one (1 : H) hspan

  have hlt : 1 < n ^ (2 * g) := Nat.one_lt_pow (by omega) (by omega)
  omega

