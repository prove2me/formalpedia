noncomputable def check : Bool := decide (expected.length=512) &&
  ((List.range 512).zip expected).all (fun p => decide (compute (512+p.1)=p.2))
theorem checked : check=true := by decide +kernel
end RHBatch01GammaPacket01

theorem guard01 : RHBatch01GammaPacket01.expected.all RHBatch01GammaGuards.guard=true := by decide +kernel

namespace RHBatch01GammaGuardBlock00
open RHBatch01GammaArithmetic RHBatch01GammaGuards
lemma packet_guard (xs : List Record) (lo : Nat)
    (hc : xs.length=512 ∧
      ((List.range 512).zip xs).all (fun p => decide (compute (lo+p.1)=p.2))=true)
    (hg : xs.all guard=true) (j : Nat) (hj : j<512) : guard (compute (lo+j))=true := by
  have hidx : j<xs.length := by omega
  have hm : (j,xs[j])∈(List.range 512).zip xs := by
    apply List.mem_iff_getElem.mpr
    refine ⟨j,by simp only [List.length_zip,List.length_range,hc.1];omega,?_⟩
    rw [List.getElem_zip]
    simp only [List.getElem_range]
  have he := List.all_eq_true.mp hc.2 (j,xs[j]) hm
  simp only [decide_eq_true_eq] at he
  rw [he]
  exact List.all_eq_true.mp hg xs[j] (List.getElem_mem hidx)
end RHBatch01GammaGuardBlock00

theorem solution :
  ∀ i : Nat, 0 ≤ i → i < 1024 → RHBatch01GammaGuards.guard (RHBatch01GammaArithmetic.compute i)=true := by
  intro i hlo hhi
  by_cases hc : i<512

  · have h := RHBatch01GammaPacket00.checked
    unfold RHBatch01GammaPacket00.check at h
    simp only [Bool.and_eq_true,decide_eq_true_eq] at h
    have hg := RHBatch01GammaGuardBlock00.packet_guard RHBatch01GammaPacket00.expected 0
      h guard00 (i-0) (by omega)
    simpa only [show 0+(i-0)=i by omega] using hg

  · have h := RHBatch01GammaPacket01.checked
    unfold RHBatch01GammaPacket01.check at h
    simp only [Bool.and_eq_true,decide_eq_true_eq] at h
    have hg := RHBatch01GammaGuardBlock00.packet_guard RHBatch01GammaPacket01.expected 512
      h guard01 (i-512) (by omega)
    simpa only [show 512+(i-512)=i by omega] using hg
#print axioms solution
