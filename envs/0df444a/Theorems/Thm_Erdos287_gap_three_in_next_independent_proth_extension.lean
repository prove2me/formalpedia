-- title:
--   Second independently generated Proth extension interval
-- statement:
--   For a strictly increasing representation of \(1\) as a sum of at least two distinct unit fractions with denominators greater than \(1\), suppose the largest denominator belongs to the exact closed integer interval \([L,U]\) in the Lean statement, approximately \(6.00128486118\times10^{880}\) to \(3.26766469171\times10^{881}\). Then some consecutive gap is at least three.
-- source:
--   Erdős Problem 287, https://www.erdosproblems.com/287. Independently generated Proth certificate pairs and factorial cofactor exclusions.

import Mathlib

theorem Erdos287.gap_three_in_next_independent_proth_extension (k : ℕ) (hk : 2 ≤ k) (f : ℕ → ℕ)
    (hf1 : ∀ i, i < k → 1 < f i)
    (hmono : ∀ i j, i < j → j < k → f i < f j)
    (hsum : ∑ i ∈ Finset.range k, (1 : ℚ) / f i = 1)
    (hlo :  ≤ f (k - 1)) (hhi : f (k - 1) ≤ ) :
    ∃ i, i + 1 < k ∧ 3 ≤ f (i + 1) - f i := by sorry
