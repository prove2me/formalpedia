-- title:
--   The cyclic cuspidal subgroup generated by two selected cusps
-- statement:
--   Let $P_0$ and $P_1$ be the first two selected geometric cusps and let $M$ be the relevant rational subgroup of the Jacobian. The file defines $$d=[P_0-P_1]∈M,\qquad C=\langle d\rangle⊂M.$$ This is the explicit cuspidal subgroup whose later arithmetic analysis identifies the order-$71$ class central to the endgame.
-- source:
--   B. Mazur, Modular curves and the Eisenstein ideal, Publ. IHES 47 (1977); Lean formalization of the order-25 case for this mission. Modules in the MazurProof/Keystone/Tate families are adapted from anthropics/fermats-last-theorem (Apache-2.0) via the xiangyazi24/FLT fork.

import Definitions.Def_N25_PointDifference
import Definitions.Def_N25_SelectedCusps
set_option autoImplicit false
noncomputable section
namespace N25.Endgame

/-- The difference of the first two selected geometric cusps, as a rational point of the Jacobian.
The degree equality and rationality that make it a point of `N25.M` always hold (`pG25_degree`,
`pointDiff_mem_M`); the junk value `0` in the other case keeps this definition independent of those theorems.
Use `coe_d25` to compute it. -/
noncomputable def d25 : ↥N25.M :=
  open Classical in
  if h : ∃ hd : (pG25 0).deg = (pG25 1).deg, pointDiff (pG25 0) (pG25 1) hd ∈ N25.M then
    ⟨pointDiff (pG25 0) (pG25 1) h.fst, h.snd⟩
  else 0

def C25 : AddSubgroup ↥N25.M := AddSubgroup.zmultiples d25

end N25.Endgame


