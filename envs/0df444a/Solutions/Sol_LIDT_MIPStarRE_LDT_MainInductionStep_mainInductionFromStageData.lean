/-!
# Section 6 — Stage-Data Constructors

Constructors for the slice restriction, per-slice induction, self-improvement,
and averaged pasting stage records: `SliceRestrictionData.ofRestrictedProbabilities`,
`AnswerSliceRestrictionData.ofRestrictedProbabilities`,
`SliceRestrictionData.ofAnswer`, `PerSliceInductionData.ofRecursion`,
`AnswerPerSliceInductionData.*`, `SelfImprovementData.ofAnswerForPerSliceInductionData`,
`SelfImprovementData.ofAnswer`, `AnswerSelfImprovementData.ofSelfImprovementData`,
`AveragedPastingData.invokeLdPasting`, and `mainInductionFromStageData`.

## References

- `blueprint/src/chapter/ch10_induction.tex`
-/

@[expose] public section

open LIDT.MIPStarRE.LDT.MainInductionStep

open MIPStarRE.LDT
open scoped MatrixOrder

universe uι

variable {ι : Type uι} [Fintype ι] [DecidableEq ι]

/-! ## Stage-data constructors and theorem composition -/

theorem solution.{uι', uF}
    {ι' : Type uι'} [Fintype ι'] [DecidableEq ι']
    {_fieldUniverse : Type uF}
    (_fieldPoint : _fieldUniverse)
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters)
    [_root_.LIDT.MIPStarRE.LDT.FieldModel.{uF} params.q]
    (strategy : _root_.LIDT.MIPStarRE.LDT.SymStrat params.next ι')
    (eps delta gamma : _root_.LIDT.MIPStarRE.LDT.Error)
    (k : ℕ)
    (hgood : strategy.IsGood eps delta gamma)
    (hrestrict : _root_.LIDT.MIPStarRE.LDT.MainInductionStep.SliceRestrictionData.{uι', uF} params strategy eps delta gamma)
    (hinduction : _root_.LIDT.MIPStarRE.LDT.MainInductionStep.PerSliceInductionData.{uι', uF} params strategy eps delta gamma hrestrict k)
    (hself : _root_.LIDT.MIPStarRE.LDT.MainInductionStep.SelfImprovementData.{uι', uF} params strategy eps delta gamma k hrestrict
      hinduction)
    (hpaste : _root_.LIDT.MIPStarRE.LDT.MainInductionStep.AveragedPastingData.{uι', uF} params strategy eps delta gamma k hself)
    (hk : 400 * params.m * params.d ≤ k) :
    ∃ H : _root_.LIDT.MIPStarRE.LDT.Measurement (_root_.LIDT.MIPStarRE.LDT.Polynomial params.next) ι',
      _root_.LIDT.MIPStarRE.LDT.ConsRel strategy.state (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Point params.next))
        (_root_.LIDT.MIPStarRE.LDT.IdxProjMeas.toIdxSubMeas strategy.pointMeasurement)
        (_root_.LIDT.MIPStarRE.LDT.polynomialEvaluationFamily params.next H.toSubMeas)
        (_root_.LIDT.MIPStarRE.LDT.MainInductionStep.mainInductionError params.next k eps delta gamma) := by
  let family : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily params ι' := hself.family
  let kappa : _root_.LIDT.MIPStarRE.LDT.Error := hpaste.kappa
  let zeta : _root_.LIDT.MIPStarRE.LDT.Error := hpaste.zeta
  have hwitness :
      ∃ error : _root_.LIDT.MIPStarRE.LDT.Error, ∃ H : _root_.LIDT.MIPStarRE.LDT.Measurement (_root_.LIDT.MIPStarRE.LDT.Polynomial params.next) ι',
        _root_.LIDT.MIPStarRE.LDT.ConsRel strategy.state (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Point params.next))
          (_root_.LIDT.MIPStarRE.LDT.IdxProjMeas.toIdxSubMeas strategy.pointMeasurement)
          (_root_.LIDT.MIPStarRE.LDT.polynomialEvaluationFamily params.next H.toSubMeas)
          error ∧
        error ≤ _root_.LIDT.MIPStarRE.LDT.MainInductionStep.mainInductionError params.next k eps delta gamma := by
    have hpasted :
        ∃ H : _root_.LIDT.MIPStarRE.LDT.Measurement (_root_.LIDT.MIPStarRE.LDT.Polynomial params.next) ι',
          _root_.LIDT.MIPStarRE.LDT.MainInductionStep.LdPastingInInductionSectionConclusion params strategy family H
            eps delta gamma kappa zeta k := by
      simpa [family, kappa, zeta] using
        _root_.LIDT.MIPStarRE.LDT.MainInductionStep.AveragedPastingData.invokeLdPasting_general
          (params := params) (strategy := strategy)
          (eps := eps) (delta := delta) (gamma := gamma) (k := k)
          (pkg := hpaste) hgood hk
    rcases hpasted with ⟨H, hH⟩
    exact
      ⟨_root_.LIDT.MIPStarRE.LDT.MainInductionStep.ldPastingInInductionError params k eps delta gamma kappa zeta, H,
        hH.pointConsistency, by simpa [kappa, zeta] using hpaste.error_le⟩
  exact _root_.LIDT.MIPStarRE.LDT.MainInductionStep.mainInductionOfWitness params.next strategy eps delta gamma k hwitness
