variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (pF pD pT pP : Fin P) (hPF : iprog pF = NLogN.fmBody pF pD pT pP)
    (hPD : iprog pD = NLogN.difBody pD) (hPT : iprog pT = NLogN.ditBody pT) (hPP : iprog pP = NLogN.pow2Body pP)
    (s : NLogN.IState NLogN.NS) (a b : ℤ) (LA : List NLogN.Item) (hA : s.G NLogN.ARG = .int a :: .int b :: LA) :
    NLogN.IRuns I iprog (NLogN.KFM.mulBody pF pP) s (s.upd NLogN.ARG (.int (a * b) :: LA))
      (NLogN.KFM.mulCost (NLogN.zsz a + NLogN.zsz b)) := by
  generalize hn : NLogN.zsz a + NLogN.zsz b = n
  obtain ⟨hN0, hN01, hdiv, -⟩ := NLogN.mainN0_facts n
  set N := NLogN.mainN0 n with hNdef
  have h1 := NLogN.KFM.signC_runs (I := I) (iprog := iprog) s a b LA hA
  set s1 := (s.upd NLogN.ARG (.int |a| :: .int |b| :: LA)).upd NLogN.T3 (.int (NLogN.KFM.fl b (NLogN.KFM.fl a 1)) :: s.G NLogN.T3)
    with hs1
  have ex : ((a.natAbs : ℕ) : ℤ) = |a| := Int.natCast_natAbs a
  have ey : ((b.natAbs : ℕ) : ℤ) = |b| := Int.natCast_natAbs b
  have zx : NLogN.zsz ((a.natAbs : ℕ) : ℤ) = NLogN.zsz a := by rw [ex, NLogN.KFM.zsz_abs]
  have zy : NLogN.zsz ((b.natAbs : ℕ) : ℤ) = NLogN.zsz b := by rw [ey, NLogN.KFM.zsz_abs]
  have h2 := NLogN.KFM.lenC_runs (I := I) (iprog := iprog) s1 a.natAbs b.natAbs LA
    (by simp +decide [hs1, ex, ey])
  rw [zx, zy, hn] at h2
  set s2 := s1.upd NLogN.ZZ (.int ((n + 1 : ℕ) : ℤ) :: s1.G NLogN.ZZ) with hs2
  have h3 := NLogN.KFM.parC_runs (I := I) (iprog := iprog) pP hPP s2 n (s1.G NLogN.ZZ) (by simp [hs2])
  rw [← hNdef] at h3
  set s3 := ((s2.upd NLogN.PRM (.int (N : ℤ) :: s2.G NLogN.PRM)).upd NLogN.RN (.int (2 ^ N) :: s2.G NLogN.RN)).upd NLogN.RF
    (.int (2 ^ N + 1) :: s2.G NLogN.RF) with hs3
  -- the product is below `2^N`
  have hxa : |a| < 2 ^ NLogN.zsz a := by
    have := NLogN.natAbs_lt_zsz a; rw [← ex]; exact_mod_cast this
  have hyb : |b| < 2 ^ NLogN.zsz b := by
    have := NLogN.natAbs_lt_zsz b; rw [← ey]; exact_mod_cast this
  have hnN : (2 : ℤ) ^ n ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) (by omega)
  have hprod : |a| * |b| < 2 ^ N := by
    have : |a| * |b| < 2 ^ NLogN.zsz a * 2 ^ NLogN.zsz b :=
      mul_lt_mul'' hxa hyb (abs_nonneg _) (abs_nonneg _)
    rw [← pow_add, hn] at this; omega
  have hapos := abs_nonneg a
  have hbpos := abs_nonneg b
  have ha' : |a| ≤ 2 ^ N := by
    have : |a| ≤ 2 ^ NLogN.zsz a := hxa.le
    have : (2 : ℤ) ^ NLogN.zsz a ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) (by omega)
    omega
  have hb' : |b| ≤ 2 ^ N := by
    have : |b| ≤ 2 ^ NLogN.zsz b := hyb.le
    have : (2 : ℤ) ^ NLogN.zsz b ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) (by omega)
    omega
  have h4 := NLogN.fm_spec' (I := I) (iprog := iprog) pF pD pT pP hPF hPD hPT hPP N hN01 (Or.inr hdiv)
    s3 |a| |b| LA (s.G NLogN.PRM) (s.G NLogN.RN) (s.G NLogN.RF) ⟨hapos, ha'⟩ ⟨hbpos, hb'⟩
    (by simp +decide [hs3, hs2, hs1]) (by simp +decide [hs3, hs2, hs1])
    (by simp +decide [hs3, hs2, hs1]) (by simp +decide [hs3, hs2, hs1])
  rw [Int.emod_eq_of_lt (by positivity) (by omega)] at h4
  set s4 := s3.upd NLogN.ARG (.int (|a| * |b|) :: LA) with hs4
  have h5 := NLogN.KFM.cleanC_runs (I := I) (iprog := iprog) s4 N n (NLogN.KFM.fl b (NLogN.KFM.fl a 1)) (|a| * |b|)
    (NLogN.KFM.fl_sign a b) LA (s.G NLogN.PRM) (s.G NLogN.RN) (s.G NLogN.RF) (s.G NLogN.ZZ) (s.G NLogN.T3)
    (by simp +decide [hs4]) (by simp +decide [hs4, hs3, hs2, hs1])
    (by simp +decide [hs4, hs3, hs2, hs1]) (by simp +decide [hs4, hs3, hs2, hs1])
    (by simp +decide [hs4, hs3, hs2, hs1]) (by simp +decide [hs4, hs3, hs2, hs1])
  rw [NLogN.KFM.fl_mul] at h5
  refine (NLogN.IRuns.seq h1 (NLogN.IRuns.seq h2 (NLogN.IRuns.seq h3 (NLogN.IRuns.seq h4 h5)))).mono' ?_ ?_
  · simp only [hs4, hs3, hs2, hs1]; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
  · have : 300 * (NLogN.zsz a + 2) ≤ 300 * (n + 2) := by omega
    simp only [NLogN.KFM.mulCost, ← hNdef]
    omega
end
