private theorem t0099 (v : HeightOneSpectrum (𝓞 K)) (a : (AdeleRing (𝓞 K) K)ˣ) :
    compAt v (diagOne a) = diagOne (unitAt v a) := by
  refine Units.ext (Matrix.ext fun i j => ?_)
  rw [t0002, glFin_apply, diagOne_coe_apply, diagOne_coe_apply]
  fin_cases i <;> fin_cases j <;> simp [t0051] <;> rfl

private theorem t0100 (w : InfinitePlace K) (a : (AdeleRing (𝓞 K) K)ˣ) :
    archComponent K w (glArch (𝓞 K) K (diagOne a)) = diagOne (d006 w a) := by
  refine Units.ext (Matrix.ext fun i j => ?_)
  rw [archComponent_apply, glArch_apply, diagOne_coe_apply, diagOne_coe_apply]
  fin_cases i <;> fin_cases j <;> simp [t0053] <;> rfl

