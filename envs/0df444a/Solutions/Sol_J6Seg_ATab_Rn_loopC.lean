set_option maxHeartbeats 2000000 in
theorem expPosP_ok (n k j σ : ℕ) (s : IState HS) (L16 L17 L18 L27 : List Item)
    (h16 : s.G 16 = .int n :: L16) (h17 : s.G 17 = .int k :: L17)
    (h18 : s.G 18 = .int j :: L18) (h27 : s.G 27 = .int σ :: L27) : expPosP.ok s := by
