theorem oneSide
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (ℓ : ℕ) (hℓ : ℓ.Prime)
    (m : ℕ) (hm : 3 ≤ m) (hℓm : ℓ ∣ m)
    (L₀ : Submodule ℤ ℍ[ℚ, a, b]) (hL₀ : L₀ ≤ Λ) (hℓL₀ : ∀ x : ↥Λ, (ℓ : ℚ) • (x : ℍ[ℚ, a, b]) ∈ L₀)
    (hL₀_left : ∀ (y : ↥Λ) (x : ℍ[ℚ, a, b]), x ∈ L₀ → (y : ℍ[ℚ, a, b]) * x ∈ L₀)
    (hL₀_index : L₀.toAddSubgroup.relIndex Λ.toAddSubgroup = ℓ ^ 2)
    (B : Type) [CommRing B] (hN : IsUnit ((N : ℕ) : B)) (hm' : IsUnit ((m : ℕ) : B)) (h2 : IsUnit ((2 : ℕ) : B))
    (h3 : IsUnit ((3 : ℕ) : B)) :
    ∃ (M : Scheme.{0}) (πM : M ⟶ Spec (CommRingCat.of B))
      (ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)),
        FakeEllipticCurve.WithFullLevel Λ N m S → SchemeHomOver s πM)
      (_ : IsFineModuli Λ N m M πM ptF) (_ : LocallyOfFiniteType πM)
      (G : Type) (_ : Group G) (_ : Fintype G) (ρ : G →* Aut M) (χ : G → ↥Λ)
      (_ : IsLevelTwistAction Λ N m M πM ptF G ρ χ)
      (H : Subgroup G) (_ : ∀ g : G, g ∈ H ↔ ∀ x : ℍ[ℚ, a, b], x ∈ L₀ → x * (χ g : ℍ[ℚ, a, b]) ∈ L₀)
      (XH : Scheme.{0}) (πXH : XH ⟶ Spec (CommRingCat.of B)) (πH : M ⟶ XH) (_ : πH ≫ πXH = πM)
      (hπH : ∀ h : H, (ρ h).hom ≫ πH = πH)
      (_ : IsIntegralHom πH) (_ : IsAffineHom πH) (_ : Function.Surjective πH.base)
      (_ : ∀ x x' : M, πH.base x = πH.base x' ↔ ∃ h : H, (ρ h).hom.base x = x')
      (_ : ∀ V : XH.Opens, Function.Injective (πH.app V))
      (_ : ∀ V : XH.Opens, Set.range (πH.app V) =
        {s | ∀ h : H, (ρ h).hom.appLE (πH ⁻¹ᵁ V) (πH ⁻¹ᵁ V) (by rw [← Scheme.Hom.comp_preimage, hπH h]) s = s})
      (_ : ∀ (T : Scheme.{0}) (f : M ⟶ T), (∀ h : H, (ρ h).hom ≫ f = f) → ∃! f' : XH ⟶ T, πH ≫ f' = f)
      (U : XH.Opens)
      (ptT : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)),
        FakeEllipticCurve.WithExtraLevel Λ N ℓ S → SchemeHomOver s (U.ι ≫ πXH)),
      IsClosed (U : Set XH) ∧ IsCoarseModuliT Λ N ℓ (U : Scheme.{0}) (U.ι ≫ πXH) ptT ∧
      (∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B))
        (u : FakeEllipticCurve.WithFullLevel Λ N m S) (K : u.1.ExtraLevel ℓ),
        (∀ (k : Type) [Field k] [IsAlgClosed k] (sk : S →+* k) (Q : SchemeHomOver (geomPoint k sk) u.1.f),
          FactorsThrough K.levK Q ↔
            ∃ x : ↥Λ, (x : ℍ[ℚ, a, b]) ∈ L₀ ∧
              pushPt (u.1.act x) (u.1.act_over x)
                (nsmulPt u.1.L (geomPoint k sk) (m / ℓ) (FakeEllipticCurve.sectionAt u.2.P k sk)) = Q) →
        (ptT S s ⟨u.1, K⟩).1 ≫ U.ι = (ptF S s u).1 ≫ πH) ∧
      (∀ (k' : Type) [Field k'] [IsAlgClosed k'] (sk : Spec (CommRingCat.of k') ⟶ Spec (CommRingCat.of B))
        (u : FakeEllipticCurve.WithFullLevel Λ N m k'),
        ((ptF k' sk u).1 ≫ πH).base (IsLocalRing.closedPoint k') ∈ (U : Set XH) ↔
          ∃ K : u.1.ExtraLevel ℓ,
            ∀ (k : Type) [Field k] [IsAlgClosed k] (sk' : k' →+* k) (Q : SchemeHomOver (geomPoint k sk') u.1.f),
              FactorsThrough K.levK Q ↔
                ∃ x : ↥Λ, (x : ℍ[ℚ, a, b]) ∈ L₀ ∧
                  pushPt (u.1.act x) (u.1.act_over x)
                    (nsmulPt u.1.L (geomPoint k sk') (m / ℓ) (FakeEllipticCurve.sectionAt u.2.P k sk')) = Q) := by
  haveI : NeZero m := ⟨by omega⟩
  obtain ⟨M, πM, ptF, hM, hMsep, -, hMlft, hAF, -⟩ :=
    CerednikDrinfeld.QM.exists_isFineModuli_of_isUnit_two_of_isUnit_three hqq' hB Λ hΛ N m hm B hN hm' h2 h3
  obtain ⟨G, instG, instFG, ρ, χ, hρ⟩ :=
    CerednikDrinfeld.QM.IsFineModuli.exists_isLevelTwistAction Λ hΛ.isOrder N m hM
  letI := instG; letI := instFG
  have hover : ∀ g : G, (ρ g).hom ≫ πM = πM := fun g => hρ.over_base g

  have hadm : ∀ x : M, ∃ U : M.Opens, IsAffineOpen U ∧ x ∈ U ∧ ∀ g : G, (ρ g).hom ⁻¹ᵁ U = U :=
    AlgebraicGeometry.Scheme.forall_exists_isAffineOpen_invariant_of_isSeparated_of_finset πM hMsep hAF ρ
  obtain ⟨X₁, π₁, hπ₁, hint₁, haff₁, hsurj₁, horbit₁, hsec₁, hinv₁, hopen₁, hcat₁⟩ :=
    AlgebraicGeometry.Scheme.exists_quotient_of_finite_of_forall_exists_isAffineOpen_invariant ρ hadm
  obtain ⟨πX₁, hπX₁⟩ := (hcat₁ _ πM hover).exists
  obtain ⟨pt₁, hX₁, hpt₁⟩ :=
    CerednikDrinfeld.QM.IsFineModuli.exists_isCoarseModuli_of_quotient_of_isIndefiniteRamifiedExactlyAt
      hqq' hB Λ hΛ N m hm' hM hρ X₁ πX₁ π₁ hπX₁ hπ₁ hint₁ haff₁ hsurj₁ horbit₁ hsec₁ hinv₁ hopen₁ hcat₁

  obtain ⟨H, hH⟩ :=
    CerednikDrinfeld.QM.IsLevelTwistAction.exists_subgroup_mem_iff_forall_mul_mem Λ hΛ.isOrder N m hρ L₀ hL₀ hℓL₀ hℓm hL₀_left
  let ρH : ↥H →* Aut M := ρ.comp H.subtype
  have hadmH : ∀ x : M, ∃ U : M.Opens, IsAffineOpen U ∧ x ∈ U ∧ ∀ h : ↥H, (ρH h).hom ⁻¹ᵁ U = U :=
    AlgebraicGeometry.Scheme.forall_exists_isAffineOpen_invariant_of_isSeparated_of_finset πM hMsep hAF ρH
  obtain ⟨XH, πH, hπH, hintH, haffH, hsurjH, horbitH, hsecH, hinvH, hopenH, hcatH⟩ :=
    AlgebraicGeometry.Scheme.exists_quotient_of_finite_of_forall_exists_isAffineOpen_invariant ρH hadmH
  have hoverH : ∀ h : ↥H, (ρH h).hom ≫ πM = πM := fun h => hover h
  obtain ⟨πXH, hπHX⟩ := (hcatH _ πM hoverH).exists
  obtain ⟨d₀, hd₀⟩ := (hcatH _ π₁ (fun h => hπ₁ h)).exists

  obtain ⟨U, ptT, hUcl, hUT, hUc, -, hUf, -⟩ :=
    CerednikDrinfeld.QM.IsFineModuli.exists_isCoarseModuliT_of_quotient_of_isIndefiniteRamifiedExactlyAt_of_isUnit_mem_iff
      hqq' hB Λ hΛ N m hN hm' hM hρ π₁ hπX₁ hX₁ hpt₁ ℓ hℓ hℓm L₀ hL₀ hℓL₀ hL₀_left hL₀_index H hH
      XH πXH πH hπHX hπH hintH haffH hsurjH horbitH hsecH hinvH hopenH hcatH d₀ hd₀
  exact ⟨M, πM, ptF, hM, hMlft, G, instG, instFG, ρ, χ, hρ, H, hH, XH, πXH, πH, hπHX, hπH, hintH, haffH, hsurjH,
    horbitH, hsecH, hinvH, hcatH, U, ptT, hUcl, hUT, hUc, hUf⟩

end CoarseBCFieldQMT

