theorem Erdos1041.Counterexample.cos_two_pi_div_seven_cubic :
    8 * Real.cos (2 * Real.pi / 7) ^ 3 + 4 * Real.cos (2 * Real.pi / 7) ^ 2
      - 4 * Real.cos (2 * Real.pi / 7) - 1 = 0 := by sorry
