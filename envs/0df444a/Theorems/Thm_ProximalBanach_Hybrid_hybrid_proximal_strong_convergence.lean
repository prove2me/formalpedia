-- title:
--   Theorem 8 — the proximal-type algorithm (3.1) converges strongly to Q_{T⁻¹0} x_0
-- statement:
--   Let $E$ be a uniformly convex and uniformly smooth real Banach space with duality mapping $J$, and let $T:E\to2^{E^*}$ be a maximal monotone operator with $T^{-1}0\neq\emptyset$. Let $(r_n)\subset(0,\infty)$ satisfy $\liminf_{n\to\infty}r_n>0$. Let $(x_n)$ be generated by the algorithm
--   $$\begin{cases}x_0\in E,\\ 0=v_n+\frac1{r_n}(Jy_n-Jx_n),\quad v_n\in Ty_n,\\ H_n=\{z\in E:\langle z-y_n,v_n\rangle\le0\},\\ W_n=\{z\in E:\langle z-x_n,Jx_0-Jx_n\rangle\le0\},\\ x_{n+1}=Q_{H_n\cap W_n}x_0,\qquad n=0,1,2,\dots\end{cases}\tag{3.1}$$
--   Then $(x_n)$ converges strongly to $Q_{T^{-1}0}x_0$, the generalized projection of $x_0$ onto the zero set of $T$:
--   $$\lim_{n\to\infty}\|x_n-Q_{T^{-1}0}x_0\|=0 .$$
--
--   This extends Solodov and Svaiter's strongly convergent hybrid proximal point method from Hilbert spaces to spaces such as $L^p$, $1<p<\infty$.
--
--   **Formalization Note** The conclusion is that there is a point $z$ which is a generalized projection of $x_0$ onto $T^{-1}0$ ($z\in T^{-1}0$ minimizes $\varphi(\cdot,x_0)$ there) and $x_n\to z$ in norm. $\liminf r_n>0$ is encoded as "there is $c>0$ with $r_n\ge c$ for all large $n$". The theorem holds for every run of (3.1) (runs exist by Proposition 7). Reflexivity, strict convexity and smoothness are not assumed: they follow from uniform convexity and uniform smoothness. $T^{-1}0$ is not assumed closed or convex.
-- source:
--   Kamimura and Takahashi, Strong convergence of a proximal-type algorithm in a Banach space, SIAM J. Optim. 13(3), 2003, p. 942, Theorem 8 (with the standing assumption of §3 that T is maximal monotone)

import Mathlib
import Definitions.Def_ProximalBanach_Hybrid_Basic

namespace ProximalBanach.Hybrid

open Filter Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- Theorem 8 (p. 942): let `E` be uniformly convex and uniformly smooth and `T` maximal
monotone with `T⁻¹0 ≠ ∅`. If `r_n > 0` and `liminf r_n > 0`, then every run `{x_n}` of (3.1)
converges strongly to `Q_{T⁻¹0} x_0`. -/
theorem hybrid_proximal_strong_convergence [UniformConvexSpace E]
    (hUS : IsUniformlySmooth E) (J : E → StrongDual ℝ E) (hJ : ∀ x, J x ∈ dualityMap x)
    (T : E → Set (StrongDual ℝ E)) (hT : IsMaximalMonotone T) (hZ : (zeros T).Nonempty)
    (r : ℕ → ℝ) (hr : ∀ n, 0 < r n) (hlim : ∃ c : ℝ, 0 < c ∧ ∀ᶠ n in atTop, c ≤ r n)
    (x y : ℕ → E) (v : ℕ → StrongDual ℝ E) (hrun : IsHybridRun T J r x y v) :
    ∃ z : E, IsGenProj J (zeros T) (x 0) z ∧ Tendsto x atTop (𝓝 z) := by sorry

end ProximalBanach.Hybrid
