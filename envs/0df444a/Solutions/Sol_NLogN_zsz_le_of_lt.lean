theorem nbits_zero : nbits 0 = [] := by rw [nbits]; simp

theorem nbits_pos {m : ℕ} (h : m ≠ 0) : nbits m = decide (m % 2 = 1) :: nbits (m / 2) := by
  rw [nbits]; simp [h]

