theorem NLogN.GL.loop12 (M : MulSpec) (b : RM) (A B1 B2 c dA : Fin HS) (e : α → List Item)
    (d1 : β → List Item) (d2 : β2 → List Item) (f1 : α → β) (f2 : α → β2) (s : IState HS)
    (L : List α) (R : List Item) (C N Bc : ℕ) (n : Ex HS)
    (hd : [A, dA, B1, B2, c].Nodup) (h1 : s.G A = L.flatMap e ++ R) (hl : L.length = N)
