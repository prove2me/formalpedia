theorem ModularCurve.finiteDimensional_and_isSeparable_adjoin_jqNModC_of_natCast_ne_zero
    (K : Type*) [Field K] (N : ℕ) [NeZero N] (hNK : (N : K) ≠ 0)
    (data : ModularPolynomialData N) :
    FiniteDimensional
      (IntermediateField.adjoin K
        ({(⟨jqNModC K N, jqNModC_mem K N⟩ : modularFunctionFieldC K N)} : Set (modularFunctionFieldC K N)))
      (modularFunctionFieldC K N) ∧
    Algebra.IsSeparable
      (IntermediateField.adjoin K
        ({(⟨jqNModC K N, jqNModC_mem K N⟩ : modularFunctionFieldC K N)} : Set (modularFunctionFieldC K N)))
      (modularFunctionFieldC K N) := by sorry
