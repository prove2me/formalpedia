def UC : (E'.L.schemeKer (N * N₀)).Opens := (exists_UC (N := N) E' hM).choose
theorem UC_closed : IsClosed (UC (N := N) E' hM : Set ↥(E'.L.schemeKer (N * N₀))) := (exists_UC (N := N) E' hM).choose_spec.1
theorem UC_iff {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t E'.f) :
    CerednikDrinfeld.QM.FactorsThrough E'.lev P ↔
      ∃ κ : TT ⟶ E'.L.schemeKer (N * N₀), κ ≫ KerOps.ι E'.L (N * N₀) = P.1 ∧
