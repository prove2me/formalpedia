    (h : ¬ (jBar N : laurentBaseChange (AlgebraicClosure ℚ)
      (modularFunctionFieldFull N)) ∈ w.compSubring A)
    (b : fm.BInf) (a : A)
    (hb : w.HasValueAt (b : laurentBaseChange (AlgebraicClosure ℚ)
