    have : Bn ≤ B := by rw [hBB]; exact Nat.le_mul_of_pos_left _ Wc_pos
    exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _
      (Nat.mul_le_mul_right _ this)))
  have IHc : ∀ h : Fin mC, SImplQ Isym tbl (fun s => Agree (σChild σN K k e Bn h) s) 0 H r
      (fun c : Fin (mC ^ k) => 2 ^ ((e - h.val * (K * mC ^ k)) - K * c.val) * S0) (nN Bn t S0)
      (Butterfly.tens Cm) (levC jL rowC) (ES k) (DWb Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0 k) (fun _ => cI) := by
    intro h
    have hce := child_e_bound hKe h.isLt
    exact IH _ t S0 _ Bn (levR_child hN h) hS hBn hdvd' (by omega)
      (affK_top_le (Nat.sub_le _ _) het) hz16c ((zsz_natCast_le (Vb_child hBB)).trans hV)
  have hstep := fun a ha => step_any (Isym := Isym) hRow hKc hj hN hBB hK6 hr hKZ Zr hZZ hZr hHZ hS
    hBn hKe het hz16 hV cI IHc a ha
  choose! dwf cf hP using hstep
  have hsl := slaws_node (S0 := S0) (Bn := Bn) hK hKe het
  have RL := rImplQ_list hsl (Butterfly.tens Cm : Butterfly.Op (Fin (mC ^ k))) (stepC jL rowC) (eSt k) dwf
    (fun a _ => cf a) P8Lift.complexIface.net (fun a ha => (hP a ha).1)
  rw [P8Lift.complexIface.correct (Fin (mC ^ k))] at RL
  have SN := sImplQ_of_rImplQ_roleDiag Wc_pos hsl
    (fun p => dvd_pow_lay (posR K e k) t S0 Bn (posR_lt hK het) p) (by omega) RL
  -- the node frame
  have hle : ∀ x, x ≤ Vb K t S0 r H (k + 1) B → zsz (x : ℤ) ≤ Zr := fun x hx =>
    le_trans (zsz_natCast_le hx) hV
  have hBB2 : B ≤ B * 2 ^ t * S0 * r := by
    have : 1 ≤ 2 ^ t * S0 * r := by
      have := Nat.one_le_two_pow (n := t)
      have := Nat.mul_le_mul this hS
      have := Nat.mul_le_mul this hr
      simpa using this
    calc B = B * 1 := by ring
      _ ≤ B * (2 ^ t * S0 * r) := Nat.mul_le_mul_left _ this
      _ = B * 2 ^ t * S0 * r := by ring
  have hBnB : Bn * 2 ^ t * S0 * r ≤ B * 2 ^ t * S0 * r := by
    rw [hBB]
    have : Bn ≤ P8Lift.Wc * Bn := Nat.le_mul_of_pos_left _ Wc_pos
    exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ this))
  have hSr : S0 * r ≤ B * 2 ^ t * S0 * r := by
    have : 1 ≤ B * 2 ^ t := by
      have := Nat.mul_le_mul hB (Nat.one_le_two_pow (n := t)); simpa using this
    calc S0 * r = 1 * (S0 * r) := by ring
      _ ≤ (B * 2 ^ t) * (S0 * r) := Nat.mul_le_mul_right _ this
      _ = B * 2 ^ t * S0 * r := by ring
  have hm1 : mC ^ (k + 1) ≤ mC ^ (k + 1 + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hm0 : mC ^ k ≤ mC ^ (k + 1 + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hm2 : K * mC ^ k ≤ K * mC ^ (k + 1 + 1) := Nat.mul_le_mul_left _ hm0
  have hES1 := ES_mono_succ (k + 1)
  have hES0 := ES_mono_succ k
  have hWB : P8Lift.Wc ≤ B := by rw [hBB]; exact Nat.le_mul_of_pos_right _ hBn
  have hBz : zsz ((mC ^ (k + 1) + mC + B + P8Lift.Wc + S0 * r + 2 * (Bn * 2 ^ t * S0 * r) +
      K * mC ^ k + ES (k + 1) + P8Lift.sc + NLogN.KFW.cL + 2 : ℕ) : ℤ) ≤ Zr := hle _ (by unfold Vb; omega)
  have hPS := pushSeq_node Bn hL hBB hS hr hBn Zr hBz
  have hBb : ∀ p ∈ nodeVL K t S0 r k Bn, zsz p.2 ≤ Zr + ES k + 1 := by
    intro p hp
    simp only [nodeVL, List.mem_cons, List.not_mem_nil, or_false] at hp
    have hz : ∀ x, x ≤ Vb K t S0 r H (k + 1) B → zsz (x : ℤ) ≤ Zr + ES k + 1 := fun x hx =>
      le_trans (hle x hx) (by omega)
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact hz _ (by unfold Vb; omega)
    · exact hz _ (by unfold Vb; have : Bn ≤ B := by rw [hBB]; exact Nat.le_mul_of_pos_left _ Wc_pos
                     omega)
    · exact hz _ (by unfold Vb; omega)
    · exact hz _ (by unfold Vb; omega)
    · exact hz _ (by
        unfold Vb
        have : 2 * (Bn * (S0 * r * 2 ^ t)) = 2 * (Bn * 2 ^ t * S0 * r) := by ring
        omega)
    · exact hz _ (by unfold Vb; omega)
    · simp only; rw [NLogN.zsz_two_pow]; omega
    · simp only; rw [zsz_one]; omega
  have h0 : (0 : Fin HS) ∉ (nodePush).map Prod.fst := by
    rw [← hPS.fst]
    simp only [nodeVL, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false]
    decide
  have SP := sImplQ_push σL (hL.off 0 (by decide)) (fun s h => h) nodePush
    (nodeVL K t S0 r k Bn) (cNodeF Zr (ES k)) (Zr + ES k + 1) hPS h0 hBb
    (fun s hs => agree_pushSt' _ hs) SN
  -- transport to `Fin (m^(k+1))`
  have hst : stN K e k S0 = (fun i : Fin (mC ^ (k + 1)) => 2 ^ (e - K * i.val) * S0) ∘ eqvL k := by
    funext p; simp only [stN, Function.comp, eqvL_val, posR]
  rw [hst] at SP
  have SE := sImplQ_equiv (eqvL k) (fun i : Fin (mC ^ (k + 1)) => 2 ^ (e - K * i.val) * S0) Cm SP
  have hn : P8Lift.Wc * nN Bn t S0 = B * 2 ^ t * S0 := by rw [hBB]; simp only [nN]; ring
  rw [hn] at SE
  have HI := sImplQ_ite (I := Isym) (iprog := tbl) (i := vk)
    (fc := fun c => decide (c = NLogN.Cls.zero)) (p := leafC) (q := nodeC jL rowC) (by decide) false
    (fun s hs => by
      rw [cl_agree hs hL.hk]
      have h1 : ¬ ((k : ℤ) + 1 = 0) := by omega
      have h2 : ¬ ((k : ℤ) + 1 < 0) := by omega
      simp [NLogN.cls, h1, h2]) SE
  have HE := HI.congrE (sum_eSt_net k) rfl
  have hdw : (P8Lift.complexIface.net.map dwf).sum ≤ DWb Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0 (k + 1) := by
    have := sum_le_count' P8Lift.RStep.isChild _ _ dwf P8Lift.complexIface.net
      (fun a ha => (hP a ha).2.1)
    rw [P8Lift.complexIface.count, ← Lc_eq] at this
    exact this
  refine ((HE.mono_dw hdw).congrC rfl).mono (fun w _ hw => ?_)
  -- the cost
  apply Nat.le_floor
  rw [costL_const]
  have hESH : ES k ≤ H := le_trans (ES_le_DWb k) (by omega)
  have hESZ : zsz ((ES k : ℕ) : ℤ) ≤ Zr := hle _ (by unfold Vb; omega)
  have hOV := cNodeF_Y hESH hESZ hZr
  have hlen : (nodeVL K t S0 r k Bn).length = 8 := rfl
  rw [hlen]
  set Y := Yu r Zr H with hY
  set P := P8Lift.Wc * nN Bn t S0 * Y with hPdef
  set G : ℝ := 18 * (Kc * (K + 2) + 1) * ((mC : ℝ) ^ k + 1) ^ τ50 with hG
  have hG0 : 0 ≤ G := by positivity
  have hsum : ((P8Lift.complexIface.net.map cf).sum : ℝ) ≤
      (P8Lift.sc : ℝ) * ((cI : ℝ) + ((Mloc : ℝ) + G) * (P : ℝ)) +
        (Lc : ℝ) * (((Mloc : ℝ) + G) * (P : ℝ)) := by
    have := sum_ite_le' P8Lift.RStep.isChild ((cI : ℝ) + ((Mloc : ℝ) + G) * (P : ℝ))
      (((Mloc : ℝ) + G) * (P : ℝ)) (mul_nonneg (add_nonneg (Nat.cast_nonneg _) hG0) (Nat.cast_nonneg _))
      (fun a => (cf a : ℝ)) P8Lift.complexIface.net
      (fun a ha => by
        have h := (hP a ha).2.2
        split_ifs at h ⊢ <;> linarith)
    rw [P8Lift.complexIface.count, ← Lc_eq] at this
    rw [Nat.cast_list_sum, List.map_map]
    exact this
  have hcI' : (cI : ℝ) ≤ cbW Kc K k * ((Bn * 2 ^ t * S0 * Y : ℕ) : ℝ) :=
    Nat.floor_le (mul_nonneg (cbW_nonneg hKc K k) (Nat.cast_nonneg _))
  have hnY : ((B * 2 ^ t * S0 * Y : ℕ) : ℝ) = (P8Lift.Wc : ℝ) * ((Bn * 2 ^ t * S0 * Y : ℕ) : ℝ) := by
    rw [hBB]; push_cast; ring
  have hPn : (P : ℝ) = (P8Lift.Wc : ℝ) * ((Bn * 2 ^ t * S0 * Y : ℕ) : ℝ) := by
    rw [hPdef]; push_cast; ring
  rw [hnY]
  unfold cbW at hcI' ⊢
  simp only [KFN.cb]
  rw [hPn] at hsum
  have hOV' : ((cNodeF Zr (ES k) + 1 + (8 * (2 * (Zr + ES k + 1) + 2) + 1) + 25 : ℕ) : ℝ) ≤
      (Lam : ℝ) * ((P8Lift.Wc : ℝ) * ((Bn * 2 ^ t * S0 * Y : ℕ) : ℝ)) := by
    have h1 : (10 ^ 10 : ℝ) ≤ (Lam : ℝ) := by unfold Lam; push_cast; norm_num
    have h2 : (Y : ℝ) ≤ (P8Lift.Wc : ℝ) * ((Bn * 2 ^ t * S0 * Y : ℕ) : ℝ) := by
      have : Y ≤ P8Lift.Wc * (Bn * 2 ^ t * S0 * Y) := by
        have hn1 : 1 ≤ Bn * 2 ^ t * S0 := by
          have := Nat.mul_le_mul hBn (Nat.one_le_two_pow (n := t))
          have := Nat.mul_le_mul this hS
          simpa using this
        have : Y ≤ Bn * 2 ^ t * S0 * Y := Nat.le_mul_of_pos_left _ hn1
        exact le_trans this (Nat.le_mul_of_pos_left _ Wc_pos)
      exact_mod_cast this
    have h3 : ((cNodeF Zr (ES k) + 1 + (8 * (2 * (Zr + ES k + 1) + 2) + 1) + 25 : ℕ) : ℝ) ≤
        10 ^ 10 * (Y : ℝ) := by exact_mod_cast hOV
    have h4 : (0 : ℝ) ≤ Y := Nat.cast_nonneg _
    have hL0 : (0 : ℝ) ≤ (Lam : ℝ) := Nat.cast_nonneg _
    calc _ ≤ 10 ^ 10 * (Y : ℝ) := h3
      _ ≤ (Lam : ℝ) * (Y : ℝ) := mul_le_mul_of_nonneg_right h1 h4
      _ ≤ _ := mul_le_mul_of_nonneg_left h2 hL0
  have hlam : (1 : ℝ) ≤ (Lam : ℝ) := by exact_mod_cast one_le_Lam
  have hMl : (Mloc : ℝ) ≤ (Lam : ℝ) * (alN P8Lift.Wc NLogN.KFW.A0 : ℝ) := by exact_mod_cast Mloc_le
  have hW0 : (0 : ℝ) < (P8Lift.Wc : ℝ) := by exact_mod_cast Wc_pos
  have key := node_real (s := (P8Lift.sc : ℝ)) (W := (P8Lift.Wc : ℝ)) (L := (Lc : ℝ))
    (lam := (Lam : ℝ)) (cb0 := KFN.cb Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0 mC (18 * (Kc * (K + 2) + 1)) τ50 k)
    (al := (alN P8Lift.Wc NLogN.KFW.A0 : ℝ)) (CRG := G) (Ml := (Mloc : ℝ)) (cI := (cI : ℝ))
    (OV := ((cNodeF Zr (ES k) + 1 + (8 * (2 * (Zr + ES k + 1) + 2) + 1) + 25 : ℕ) : ℝ))
    (S := ((P8Lift.complexIface.net.map cf).sum : ℝ))
    (nY := ((Bn * 2 ^ t * S0 * Y : ℕ) : ℝ)) hW0 (Nat.cast_nonneg _) (Nat.cast_nonneg _) (Nat.cast_nonneg _)
    hlam hG0 hMl hcI' hOV' hsum
  have e1 : ((cNodeF Zr (ES k) + ((P8Lift.complexIface.net.map cf).sum + 1) +
      (8 * (2 * (Zr + ES k + 1) + 2) + 1) + 25 : ℕ) : ℝ) =
      ((cNodeF Zr (ES k) + 1 + (8 * (2 * (Zr + ES k + 1) + 2) + 1) + 25 : ℕ) : ℝ) +
      ((P8Lift.complexIface.net.map cf).sum : ℝ) := by push_cast; ring
  rw [e1, Nat.cast_add P8Lift.sc Lc]
  exact key

end Lev

