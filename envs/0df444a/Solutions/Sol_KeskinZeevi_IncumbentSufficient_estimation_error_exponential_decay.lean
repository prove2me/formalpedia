lemma noiseSum_measF {M : Model} {Ω : Type*} (π : Policy M) (β : ℝ) (ε : ℕ → Ω → ℝ) (n : ℕ) :
    Measurable[F ε n] (fun ω => noiseSum π β ε n ω) := by
  show Measurable[F ε n] (fun ω => ∑ s ∈ Finset.Icc 1 n, ε s ω * dev π β ε s ω)
  refine Finset.measurable_sum _ (fun s hs => ?_)
  have hs' := Finset.mem_Icc.mp hs
  exact (eps_measF ε hs'.1 hs'.2).mul ((dev_measF π β ε s).mono (F_mono ε (by omega)) le_rfl)

lemma Jhat_measF {M : Model} {Ω : Type*} (π : Policy M) (β : ℝ) (ε : ℕ → Ω → ℝ) (n : ℕ) :
    Measurable[F ε n] (fun ω => Jhat π β ε n ω) := by
  show Measurable[F ε n] (fun ω => ∑ s ∈ Finset.Icc 1 n, dev π β ε s ω ^ 2)
  refine Finset.measurable_sum _ (fun s hs => ?_)
  have hs' := Finset.mem_Icc.mp hs
  exact ((dev_measF π β ε s).mono (F_mono ε (by omega)) le_rfl).pow_const 2

lemma Z_bound {M : Model} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ε : ℕ → Ω → ℝ) (σ : ℝ) (hε : LightTailedNoise P ε σ)
    (K l₀ : ℝ)
    (hK : ∀ t (l : ℝ), |l| ≤ l₀ → Integrable (fun ω => Real.exp (l * ε t ω)) P ∧
        ∫ ω, Real.exp (l * ε t ω) ∂P ≤ Real.exp (K * l ^ 2))
    (π : Policy M) (β z : ℝ) (hz : |z| * (M.u - M.l) ≤ l₀) (n : ℕ) :
    ∫⁻ ω, ENNReal.ofReal (Real.exp (z * noiseSum π β ε n ω - K * z ^ 2 * Jhat π β ε n ω)) ∂P
      ≤ 1 := by
  have hm := hε.measurable
  induction n with
  | zero => simp [noiseSum, Jhat]
  | succ n ih =>
    set B := M.u - M.l with hB
    have hB0 : 0 ≤ B := by rw [hB]; linarith [M.l_lt_u]
    set Zn : Ω → ℝ := fun ω => Real.exp (z * noiseSum π β ε n ω - K * z ^ 2 * Jhat π β ε n ω)
      with hZn
    have hNS : ∀ ω, noiseSum π β ε (n + 1) ω =
        noiseSum π β ε n ω + ε (n + 1) ω * dev π β ε (n + 1) ω := by
      intro ω; unfold noiseSum; rw [Finset.sum_Icc_succ_top (by omega)]
    have hJ : ∀ ω, Jhat π β ε (n + 1) ω = Jhat π β ε n ω + dev π β ε (n + 1) ω ^ 2 := by
      intro ω; unfold Jhat; rw [Finset.sum_Icc_succ_top (by omega)]
    set Y : Ω → ℝ × ℝ := fun ω =>
      (Zn ω * Real.exp (-(K * z ^ 2 * dev π β ε (n + 1) ω ^ 2)), dev π β ε (n + 1) ω) with hY
    have hYm : Measurable[F ε (n + 1 - 1)] Y := by
      have h1 : Measurable[F ε n] Zn :=
        ((measurable_const.mul (noiseSum_measF π β ε n)).sub
          (measurable_const.mul (Jhat_measF π β ε n))).exp
      have h2 : Measurable[F ε n] (fun ω => dev π β ε (n + 1) ω) := dev_measF π β ε (n + 1)
      exact (h1.mul ((measurable_const.mul (h2.pow_const 2)).neg.exp)).prodMk h2
    have hYm' : Measurable Y := hYm.mono (F_le ε hm _) le_rfl
    have hYε : IndepFun Y (ε (n + 1)) P :=
      (indep_eps P ε hm hε.indep (n + 1) (by omega) Y hYm).symm
    set G : (ℝ × ℝ) × ℝ → ENNReal := fun q =>
      ENNReal.ofReal (q.1.1 * Real.exp (z * clampB B q.1.2 * q.2)) with hG
    have hGc : Continuous (fun q : (ℝ × ℝ) × ℝ => q.1.1 * Real.exp (z * clampB B q.1.2 * q.2)) :=
      (continuous_fst.comp continuous_fst).mul (Real.continuous_exp.comp
        ((continuous_const.mul ((clampB_cont B).comp (continuous_snd.comp continuous_fst))).mul
          continuous_snd))
    have hGm : Measurable G := ENNReal.measurable_ofReal.comp hGc.measurable
    have hpt : ∀ ω, ENNReal.ofReal (Real.exp (z * noiseSum π β ε (n + 1) ω -
        K * z ^ 2 * Jhat π β ε (n + 1) ω)) = G (Y ω, ε (n + 1) ω) := by
      intro ω
      simp only [hG, hY, hZn]
      rw [clampB_eq B _ (dev_abs π β ε (n + 1) ω), hNS, hJ, ← Real.exp_add, ← Real.exp_add]
      congr 2; ring
    have hinner : ∀ p : ℝ × ℝ, ∫⁻ e, G (p, e) ∂(P.map (ε (n + 1))) ≤
        ENNReal.ofReal (p.1 * Real.exp (K * (z * clampB B p.2) ^ 2)) := by
      intro p
      have hsec : Measurable (fun e : ℝ => G (p, e)) :=
        hGm.comp (measurable_const.prodMk measurable_id)
      rw [lintegral_map hsec (hm _)]
      simp only [hG, Function.comp]
      set l := z * clampB B p.2 with hl
      have hlb : |l| ≤ l₀ := by
        rw [hl, abs_mul]
        exact le_trans (mul_le_mul_of_nonneg_left (clampB_abs B p.2 hB0) (abs_nonneg z)) hz
      obtain ⟨hI, hle⟩ := hK (n + 1) l hlb
      rcases le_or_gt p.1 0 with h | h
      · have : ∀ ω, ENNReal.ofReal (p.1 * Real.exp (l * ε (n + 1) ω)) = 0 := fun ω =>
          ENNReal.ofReal_of_nonpos (mul_nonpos_of_nonpos_of_nonneg h (Real.exp_pos _).le)
        simp only [this, lintegral_zero]
        exact zero_le
      · calc ∫⁻ ω, ENNReal.ofReal (p.1 * Real.exp (l * ε (n + 1) ω)) ∂P
            = ∫⁻ ω, ENNReal.ofReal p.1 * ENNReal.ofReal (Real.exp (l * ε (n + 1) ω)) ∂P := by
              congr 1; funext ω; rw [ENNReal.ofReal_mul h.le]
          _ = ENNReal.ofReal p.1 * ∫⁻ ω, ENNReal.ofReal (Real.exp (l * ε (n + 1) ω)) ∂P :=
              lintegral_const_mul _
                (ENNReal.measurable_ofReal.comp (measurable_const.mul (hm _)).exp)
          _ = ENNReal.ofReal p.1 * ENNReal.ofReal (∫ ω, Real.exp (l * ε (n + 1) ω) ∂P) := by
              rw [ofReal_integral_eq_lintegral_ofReal hI
                (Filter.Eventually.of_forall (fun ω => (Real.exp_pos _).le))]
          _ ≤ ENNReal.ofReal p.1 * ENNReal.ofReal (Real.exp (K * l ^ 2)) := by
              gcongr
          _ = ENNReal.ofReal (p.1 * Real.exp (K * l ^ 2)) := (ENNReal.ofReal_mul h.le).symm
    have hHc : Continuous (fun p : ℝ × ℝ => p.1 * Real.exp (K * (z * clampB B p.2) ^ 2)) :=
      continuous_fst.mul (Real.continuous_exp.comp
        (continuous_const.mul ((continuous_const.mul ((clampB_cont B).comp continuous_snd)).pow 2)))
    have hHm : Measurable (fun p : ℝ × ℝ =>
        ENNReal.ofReal (p.1 * Real.exp (K * (z * clampB B p.2) ^ 2))) :=
      ENNReal.measurable_ofReal.comp hHc.measurable
    calc ∫⁻ ω, ENNReal.ofReal (Real.exp (z * noiseSum π β ε (n + 1) ω -
            K * z ^ 2 * Jhat π β ε (n + 1) ω)) ∂P
        = ∫⁻ ω, G (Y ω, ε (n + 1) ω) ∂P := lintegral_congr (fun ω => hpt ω)
      _ = ∫⁻ q, G q ∂(P.map (fun ω => (Y ω, ε (n + 1) ω))) :=
          (lintegral_map hGm (hYm'.prodMk (hm _))).symm
      _ = ∫⁻ q, G q ∂((P.map Y).prod (P.map (ε (n + 1)))) := by
          rw [hYε.map_prod_eq_prod_map_map hYm'.aemeasurable (hm _).aemeasurable]
      _ = ∫⁻ p, ∫⁻ e, G (p, e) ∂(P.map (ε (n + 1))) ∂(P.map Y) :=
          lintegral_prod G hGm.aemeasurable
      _ ≤ ∫⁻ p, ENNReal.ofReal (p.1 * Real.exp (K * (z * clampB B p.2) ^ 2)) ∂(P.map Y) :=
          lintegral_mono (fun p => hinner p)
      _ = ∫⁻ ω, ENNReal.ofReal ((Y ω).1 * Real.exp (K * (z * clampB B (Y ω).2) ^ 2)) ∂P :=
          lintegral_map hHm hYm'
      _ = ∫⁻ ω, ENNReal.ofReal (Zn ω) ∂P := by
          apply lintegral_congr
          intro ω
          simp only [hY]
          rw [clampB_eq B _ (dev_abs π β ε (n + 1) ω), mul_assoc, ← Real.exp_add]
          congr 1
          rw [show -(K * z ^ 2 * dev π β ε (n + 1) ω ^ 2) + K * (z * dev π β ε (n + 1) ω) ^ 2 = 0
            by ring, Real.exp_zero, mul_one]
      _ ≤ 1 := ih

end Aux_KZI_L5

