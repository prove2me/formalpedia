/-! ### Generators congruent to one modulo a modulus -/

theorem TauCeti.GlobalNumberFields.exists_mem_isCongrOne {𝔪 : _root_.TauCeti.GlobalNumberFields.Modulus K} {D : _root_.Ideal (𝓞 K)} (hD : D ≠ ⊥)
    (hcop : D ⊔ 𝔪.finitePart = ⊤) :
    ∃ (a : 𝓞 K) (x : Kˣ), a ∈ D ∧ (x : K) = a ∧ _root_.TauCeti.GlobalNumberFields.IsCongrOne 𝔪 x := by sorry
