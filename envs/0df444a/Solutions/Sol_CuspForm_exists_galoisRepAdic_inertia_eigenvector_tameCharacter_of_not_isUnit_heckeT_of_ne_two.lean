    rw [Ideal.span_singleton_le_iff_mem]; exact hk
  obtain ⟨H₂, i₂, j₂, hfin₂, hflat₂, hcocomm₂, e₂, he₂_add, he₂_act⟩ :=
    GaloisRep.exists_finiteFlat_quotient_of_equivariant_surjection p H₁ e₁ he₁_add he₁_act
