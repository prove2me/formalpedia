        (List.map weight (List.ofFn clauses.get)).sum := by
      rw [List.ofFn_get]
    _ = (List.ofFn
        (fun index : Fin clauses.length =>
          weight (clauses.get index))).sum := by
      rw [List.map_ofFn]
      rfl
    _ = ∑ index : Fin clauses.length, weight (clauses.get index) :=
      List.sum_ofFn
