theorem NLogN.KFM.chirpL_err (P : ℕ) (c : GI) (C : ℂ) (hC : ‖C‖ ≤ 1)
    (hc : ‖vP P c - C‖ ≤ (2 : ℝ)⁻¹ ^ P) :
    ∀ (n m : ℕ) (h g : GI) (H G : ℂ), ‖H‖ ≤ 1 → ‖G‖ ≤ 1 →
      ‖vP P g - G‖ ≤ 4 * m ^ 2 * (2 : ℝ)⁻¹ ^ P →
      ‖vP P h - H‖ ≤ (4 * m + 1) * (2 : ℝ)⁻¹ ^ P →
      (4 * (m + n) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ P ≤ 1 →
      ∀ k (hk : k < n), ‖vP P ((chirpL P c h g n)[k]'(by rw [length_chirpL]; exact hk)) -
        G * H ^ k * C ^ (k * (k - 1) / 2)‖ ≤ 4 * ((m + k : ℕ) : ℝ) ^ 2 * (2 : ℝ)⁻¹ ^ P := by sorry
