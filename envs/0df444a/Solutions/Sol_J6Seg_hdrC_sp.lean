theorem pushD_sp (s : IState HS) (F : Fin HS → List ℤ) (z ds : List ℤ) (v : Fin 19 → List ℤ)
    (j : Fin 19) (x : ℤ) (hv : v j = [x]) (B : ℕ) (hz : zsz x ≤ B) :
    Sp (.push dS (.reg (σ j))) (encK s (SS σ dS F z ds v)) (encK s (SS σ dS F z (x :: ds) v))
      (4000 * (B + 2)) := by
  have hj : SS σ dS F z ds v (σ j) = [x] := by rw [SS_at hW, hv]
  have S := Sp.push s (SS σ dS F z ds v) (i := dS) (e := .reg (σ j)) (B := B) hW.Slt
    (clean_reg (hW.lt j)) (ok_reg hj) trivial (bnd_reg hj hz)
  rw [eval_reg hj, SS_atS hW, SS_ds hW] at S
  exact S.mono (by simp [Ex.size])

theorem hdrC_sp_sol_aux (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D B : ℕ) (hb : SwB P n src D B)
    (s : IState HS) (F : Fin HS → List ℤ) (z : List ℤ) :
