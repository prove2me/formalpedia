theorem PDivisibleGroup.exists_isCartierDual
    {R : Type} [CommRing R] {p h : ℕ} (G : PDivisibleGroup R p h) :
    ∃ G' : PDivisibleGroup R p h, G.IsCartierDual G' := by sorry
