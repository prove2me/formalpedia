-- Source module: Solutions.R6IL3Hyps
/-!
# Round six, item language (I3): the extra hypotheses of `P14NeedH'` at round-six parameters

`p14_hyps_r6`: for `P.Ok`, any constant `K₀` and all large `n`, the round-six values
`K = KP6 = ℓ - 1`, `D = dP6 = ⌊b^ε⌋`, `p = pP6 = 6 b^(1+x)` satisfy

1. `zsz N ≤ p` for every `N < 2^(6b)` (and `n ≤ 2^b`, `V ≤ 48 n`, so every local size of the
   caller is far below);
2. `(p + K₀)^5 ≤ 2^K`;
3. `K₀ D (zsz p + 1) ≤ K D^lamp` (this is `ε (2 - lamp) < 1`, `Prm.Ok.eps_two_sub`);

and also `6 ≤ K`.
-/

open Real

namespace IntMul.Kappa.R6.IL3

open IntMul.Kappa.R6 NLogN

noncomputable section

/-- The exponent `m = ⌈1/(1-ε)⌉`. -/
def mExp (P : Prm) : ℕ := ⌈1 / (1 - P.ε)⌉₊

end

end IntMul.Kappa.R6.IL3

end

