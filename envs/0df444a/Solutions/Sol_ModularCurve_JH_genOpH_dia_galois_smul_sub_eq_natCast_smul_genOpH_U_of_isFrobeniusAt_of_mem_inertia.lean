theorem mem_valuationSubring_of_pow_eq_one {u : AlgebraicClosure ℚ} {m : ℕ} (hm : 0 < m) (hu : u ^ m = 1) :
    u ∈ A := by
  rcases A.mem_or_inv_mem u with h | h
  · exact h
  · have hu0 : u ≠ 0 := by
      rintro rfl
      rw [zero_pow hm.ne'] at hu
      exact zero_ne_one hu
    have hinv : u = (u⁻¹) ^ (m - 1) := by
      have h1 : u * (u⁻¹) ^ (m - 1) * u⁻¹ = (u⁻¹) ^ (m - 1) := by
        rw [mul_assoc, mul_comm ((u⁻¹) ^ (m - 1)), ← mul_assoc, mul_inv_cancel₀ hu0, one_mul]
      have h2 : (u⁻¹) ^ (m - 1) * u⁻¹ = (u⁻¹) ^ m := by
        rw [← pow_succ, Nat.sub_add_cancel hm]
      rw [mul_assoc, h2, inv_pow, hu, inv_one, mul_one] at h1
      exact h1
    rw [hinv]
    exact pow_mem h _

