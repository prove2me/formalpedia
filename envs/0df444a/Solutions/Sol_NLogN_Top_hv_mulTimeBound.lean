theorem instrAt_valid (ent : Fin P → ℕ) (L : ℕ) (hent : ∀ j, ent j < L) :
    ∀ (s : Stmt S P) (a e x : ℕ) (ins : Instr S), a + s.size ≤ L → e < L →
      s.instrAt ent a e x = some ins → ins.Valid L := by
  intro s
  induction s with
  | skip | push | pop | inRd | out =>
    intro a e x ins _ he h
    simp only [Stmt.instrAt] at h; split_ifs at h; cases h; exact he
  | call j =>
    intro a e x ins _ he h
    simp only [Stmt.instrAt] at h; split_ifs at h; cases h; exact ⟨hent j, he⟩
  | seq p q ihp ihq =>
    intro a e x ins ha he h
    have hp := p.size_pos; have hq := q.size_pos
    simp only [Stmt.size] at ha
    simp only [Stmt.instrAt] at h; split_ifs at h
    · exact ihp _ _ _ _ (by omega) (by omega) h
    · exact ihq _ _ _ _ (by omega) he h
  | ite i f p q ihp ihq =>
    intro a e x ins ha he h
    have hp := p.size_pos; have hq := q.size_pos
    simp only [Stmt.size] at ha
    simp only [Stmt.instrAt] at h; split_ifs at h
    · cases h; exact ⟨by omega, by omega⟩
    · exact ihp _ _ _ _ (by omega) he h
    · exact ihq _ _ _ _ (by omega) he h
  | loop i f p ihp =>
    intro a e x ins ha he h
    have hp := p.size_pos
    simp only [Stmt.size] at ha
    simp only [Stmt.instrAt] at h; split_ifs at h
    · cases h; exact ⟨by omega, he⟩
    · exact ihp _ _ _ _ (by omega) (by omega) h

theorem codeOf_valid (prog : Fin P → Stmt S P) :
    ∀ x < codeLen prog, (codeOf prog x).Valid (codeLen prog) := by
  intro x _
  unfold codeOf
  split
  · next j _ =>
    rcases h : (prog j).instrAt (fun j => entryOf prog j) (entryOf prog j)
      (entryOf prog j + (prog j).size) x with _ | ins
    · trivial
    · have hj := entryOf_le_codeLen prog j
      exact instrAt_valid (fun j => entryOf prog j) (codeLen prog)
        (fun j' => by have := entryOf_le_codeLen prog j'; omega)
        (prog j) _ _ _ _ (by omega) (by omega) h
  · trivial

theorem init_enc (L : ℕ) (x y : List Bool) :
    initTapes (syms L) (by omega : 2 ≤ S + 3) x y =
      NLogN.enc ((initTapes (syms L) (by omega : 2 ≤ S + 3) x y).cells tin) ⟨0, St.init S, []⟩ := by
  apply enc_eq_of
  · rfl
  · simp [initTapes, tin, St.init]
  · funext p; rcases p with _ | p <;> simp [initTapes, tout, St.init, tapeOf]
  · simp [initTapes, tout, St.init]
  · funext p; rcases p with _ | p <;> simp [initTapes, tctl, tapeOf]
  · simp [initTapes, tctl]
  · intro i; funext p; rcases p with _ | p <;> simp [initTapes, tst, St.init, tapeOf]
  · intro i; simp [initTapes, tst, St.init]

theorem init_inCode (L : ℕ) (x y : List Bool) (p : ℕ) :
    inCode ((initTapes (syms L) (by omega : 2 ≤ S + 3) x y).cells tin (p + 1)) =
      (inputCodes x y).getD p codeEnd := by
  simp only [initTapes, tin, if_true]
  have e : (x.map (fun b => if b then (syms L).one else (syms L).zero) ++
      (syms L).sep :: y.map (fun b => if b then (syms L).one else (syms L).zero)) =
      (inputCodes x y).map gsym := by
    simp only [inputCodes, List.map_append, List.map_map, List.map_cons]
    congr 1
    · congr 1; funext b; cases b <;> rfl
    · congr 1; congr 1; funext b; cases b <;> rfl
  rw [e]
  by_cases hp : p < (inputCodes x y).length
  · rw [List.getD_eq_getElem _ _ (by simpa using hp), List.getD_eq_getElem _ _ hp]
    simp [inCode, gsym]
  · rw [List.getD_eq_default _ _ (by simpa using hp), List.getD_eq_default _ _ (by omega)]
    rfl

/-- Compiler correctness against the platform's notion of multiplication. -/
theorem multipliesAt_of_exec (prog : Fin P → Stmt S P) (hP : 0 < P) (n : ℕ) (T : ℝ)
    (h : ∀ x y : List Bool, x.length = n → y.length = n → ∃ σ' c,
      Exec (inputCodes x y) prog (prog ⟨0, hP⟩) (St.init S) σ' c ∧
        σ'.out = bin (2 * n) (val x * val y) ∧ (2 * c + 1 : ℝ) ≤ T) :
    MultipliesAt (machineOf prog hP) n T := by
  intro x y hx hy
  obtain ⟨σ', c, hexec, hout, hT⟩ := h x y hx hy
  set L := codeLen prog
  have hent0 : entryOf prog (⟨0, hP⟩ : Fin P) = 0 := by simp [entryOf]
  have hflat := exec_flat (progPlaced_codeOf prog) hexec _ _ ((progPlaced_codeOf prog) ⟨0, hP⟩).1 []
  simp only [hent0] at hflat
  have hret := ((progPlaced_codeOf prog) ⟨0, hP⟩).2
  simp only [hent0] at hret
  set inp := (initTapes (syms L) (by omega : 2 ≤ S + 3) x y).cells tin
  obtain ⟨t, ht, hh⟩ := sim_halts (code := codeOf prog) (L := L) (pc0 := ⟨0, codeLen_pos prog hP⟩)
    (inp := inp) (inputCodes x y) (init_inCode L x y) (codeOf_valid prog) hflat
    (codeLen_pos prog hP) (by simp) hret rfl
  have hrun : IntMul.Mach.Runs (syms L).st (progOf (codeOf prog) L ⟨0, codeLen_pos prog hP⟩)
      (initTapes (syms L) (by omega : 2 ≤ S + 3) x y) t (NLogN.enc inp ⟨0 + (prog ⟨0, hP⟩).size, σ', []⟩) := by
    rw [init_enc L x y]
    exact hh
  refine ⟨t + 1, ?_, compile_haltsWithOutput (syms L) (by omega) _ x y _ t _ hrun ?_⟩
  · have : (t : ℝ) ≤ 2 * c := by exact_mod_cast ht
    push_cast; linarith
  · show (NLogN.enc inp _).cells tout = _
    rw [enc_cells_tout]
    simp only [hout]

