-- title:
--   Proposition 3.5: separation iff content vectors distinguish paths
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. Fix $n\ge0$ and elements $J_i\in X_i$ for $1\le i\le n$. For each path $T$ let $c_T=(c_T(1),\ldots,c_T(n))$, where $J_i\epsilon_T=c_T(i)\epsilon_T$ after embedding in $A_n$. Then
--
--   $$\bigl(\forall S,T,\ S=T\Longleftrightarrow c_S=c_T\bigr)\quad\Longleftrightarrow\quad k[J_1,\ldots,J_n]=X_n.$$
--
--   The finite content vectors separate paths exactly when the elements generate the GT algebra.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 12, Proposition 3.5: separation iff content vectors distinguish paths

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Proposition 3.5, source PDF pp. 12–13. Finite-level separation requires neither
additive centrality nor assumptions at any other level nor an infinite field. -/
theorem contents_iff_separation (D : Tower k AA) (n : ℕ)
    (J : (i : Fin n) → AA (i.val + 1)) (hJ : ∀ i, J i ∈ towerGTAlgebra D (i.val + 1)) :
    (∀ s t : TowerPath D n, s = t ↔ contentVector D J s = contentVector D J t) ↔
      Algebra.adjoin k (Set.range (embeddedSequence D n J)) = towerGTAlgebra D n := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
