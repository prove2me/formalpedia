-- Source module: Solutions.KFX1Sw
/-!
# KFX §1: the Lemma 12 swap wrapper with expression parameters

`swE q eP eG eS eU` pushes the four Lemma 12 parameters as the values of arbitrary expressions
(read from registers at run time), runs `l12F`, pops.  **`swE_spec`** is `KFL.swI_spec` with the
literals replaced by expressions (`KFL.ESp` facts), and **`swE_geo`** gives the three slot swaps
`rixT g (swT i)` on the 8-axis geometry.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL AModel AModelL12 NetProp7

/-- The parameter pushes of the swap. -/
def swPl (eP eG eS eU : Ex HS) : List (Fin HS × Ex HS) :=
  [(kP, eP), (NLogN.KIL.kG, eG), (NLogN.KIL.kS, eS), (aU, eU)]

/-- **The swap wrapper with expression parameters.** -/
def swE (q : ℕ) (eP eG eS eU : Ex HS) : IStmt HS 1 := withPushI (swPl eP eG eS eU) (l12C q)

/-- Expressions that do not read the four Lemma 12 parameter stacks. -/
def NoK (e : Ex HS) : Prop := ∀ r ∈ e.regs, r ≠ kP ∧ r ≠ NLogN.KIL.kG ∧ r ≠ NLogN.KIL.kS ∧ r ≠ aU

/-! ## The three slot swaps on the 8-axis geometry -/

/-- The prefix volume of slot swap `i`. -/
def svP (g : Geo) : Fin 3 → ℕ
  | 0 => g.N0
  | 1 => vol [g.N0, g.Q, g.N1]
  | 2 => g.N0

/-- The middle volume of slot swap `i`. -/
def svG (g : Geo) : Fin 3 → ℕ
  | 0 => g.N1
  | 1 => g.N2
  | 2 => vol [g.N1, g.Q, g.N2]

/-- The suffix volume of slot swap `i`. -/
def svS (g : Geo) : Fin 3 → ℕ
  | 0 => vol [g.N2, g.Q, g.N3, g.B]
  | 1 => vol [g.N3, g.B]
  | 2 => vol [g.N3, g.B]

end NLogN.KFX

end

