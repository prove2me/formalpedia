namespace RIGN_I3

section CC
open MvPowerSeries

theorem constantCoeff_subst_of_constantCoeff_zero {S : Type} [CommRing S] (a : Fin 2 → MvPowerSeries (Fin 2) S)
    (ha0 : ∀ i, constantCoeff (a i) = 0) (f : MvPowerSeries (Fin 2) S) :
    constantCoeff (subst a f) = constantCoeff f := by
  have ha : HasSubst a := hasSubst_of_constantCoeff_zero ha0
  rw [constantCoeff_subst ha]
  rw [finsum_eq_single _ (0 : Fin 2 →₀ ℕ)]
  · simp
  · intro d hd
    obtain ⟨s, hs⟩ : ∃ s, d s ≠ 0 := by
      by_contra h; push Not at h; exact hd (Finsupp.ext fun s => by simpa using h s)
    rw [Finsupp.prod, map_prod]
    rw [Finset.prod_eq_zero (Finsupp.mem_support_iff.2 hs) (by rw [map_pow, ha0, zero_pow hs]), smul_zero]

theorem constantCoeff_eq_zero_of_factorisation {S S' : Type} [CommRing S] [CommRing S'] (κB : S →+* S')
    (hκ : Function.Injective κB) (σ : CerednikDrinfeld.SpecialFormal.Series S) (χ ρ : CerednikDrinfeld.SpecialFormal.Series S')
    (hρ : ρ = (σ.map κB).comp χ) (hχ0 : ∀ i, constantCoeff (χ i) = 0) (hρ0 : ∀ i, constantCoeff (ρ i) = 0) :
    ∀ i, constantCoeff (σ i) = 0 := by
  intro i
  have h := hρ0 i
  rw [hρ] at h
  change constantCoeff (subst χ ((σ.map κB) i)) = 0 at h
  rw [constantCoeff_subst_of_constantCoeff_zero χ hχ0] at h
  change constantCoeff (MvPowerSeries.map κB (σ i)) = 0 at h
  rw [constantCoeff_map] at h
  exact hκ (by rw [h, map_zero])

end CC

theorem bridge_injective {𝒪 S : Type} [CommRing 𝒪] [CommRing S] [Algebra 𝒪 S] (π : 𝒪) (r : ℕ)
    (κB : (S ⧸ Ideal.span {algebraMap 𝒪 S π}) →+* (S ⧸ Ideal.span {((r : ℕ) : S)}))
    (hκB1 : κB.comp (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 S π})) = Ideal.Quotient.mk (Ideal.span {((r : ℕ) : S)}))
    (hrπ : ((r : ℕ) : S) ∈ Ideal.span {algebraMap 𝒪 S π}) :
    Function.Injective κB := by
  rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
  intro y hy
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
  rw [RingHom.mem_ker, ← RingHom.comp_apply, hκB1, Ideal.Quotient.eq_zero_iff_mem] at hy
  rw [Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
  exact (Ideal.span_singleton_le_iff_mem _).mpr hrπ hy

theorem isODHom_germ
    {r N : ℕ} [Fact r.Prime]
    (𝒪 : Type) [CommRing 𝒪] (π : 𝒪) (Onr : Type) [CommRing Onr] [Algebra 𝒪 Onr]
    {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b]) (coord : ↥Λ → Zp2 r × Zp2 r) (hcoord : IsOrderCoord Λ r coord)
    (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}))
    (X₀ : FormalODModule r (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})) (θ₀ : RelativeGroupLaw.FormalCoordinates A₀.f 2)
    (hA₀ : A₀.IsFormalModuleVia coord X₀ θ₀)
    (S : Type) [CommRing S] [IsNoetherianRing S] [Algebra 𝒪 S] (hBr : IsNilpotent ((r : ℕ) : S)) (ψS : Onr →ₐ[𝒪] S)
    (x : FakeEllipticCurve.RigidifiedCurve r π A₀ S ψS)
    (X : FormalODModule r S) (θ : RelativeGroupLaw.FormalCoordinates x.1.f 2) (hXθ : x.1.IsFormalModuleVia coord X θ)
    (σ : Series (S ⧸ Ideal.span {algebraMap 𝒪 S π})) (hσ0 : ∀ i, MvPowerSeries.constantCoeff (σ i) = 0)
    (hrep : ∀ (B'' : Type) [CommRing B''] [Algebra (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B''] [Algebra S B'']
        [Algebra (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B''],
        algebraMap S B'' = (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'').comp (Ideal.Quotient.mk _) →
        algebraMap (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B'' =
          (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'').comp (FakeEllipticCurve.Rigidification.residueLeg π ψS) →
        ∀ (J : Ideal B'') (m : ℕ), J ^ (m + 1) = ⊥ → ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
          ∀ PA : Spec (CommRingCat.of B'') ⟶ x.2.Ab.A,
            PA ≫ x.2.Ab.f = Spec.map (CommRingCat.ofHom (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'')) →
            PA ≫ x.2.gA = (θ₀ B'' s).1 →
              PA ≫ x.2.φ' ≫ x.2.gb = (θ B'' (fun i => MvFormalGroup.nilEval m (σ i) s)).1) :
    FormalODModule.IsODHom (X₀.map (FakeEllipticCurve.Rigidification.residueLeg π ψS))
      (X.map (algebraMap S (S ⧸ Ideal.span {algebraMap 𝒪 S π}))) σ := by
  classical

  letI instOL : Algebra (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) (S ⧸ Ideal.span {algebraMap 𝒪 S π}) :=
    (FakeEllipticCurve.Rigidification.residueLeg π ψS).toAlgebra
  obtain ⟨θA, hθA, hθAg⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_isFormalModuleVia_map_and_comp_eq coord
      (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) (S ⧸ Ideal.span {algebraMap 𝒪 S π}) A₀ x.2.Ab x.2.gA x.2.isPullback_Ab X₀ θ₀ hA₀
  obtain ⟨θE, hθE, hθEg⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_isFormalModuleVia_map_and_comp_eq coord
      S (S ⧸ Ideal.span {algebraMap 𝒪 S π}) x.1 x.2.Eb x.2.gb x.2.isPullback_Eb X θ hXθ

  have hLr : IsNilpotent ((r : ℕ) : (S ⧸ Ideal.span {algebraMap 𝒪 S π})) := by
    simpa using hBr.map (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 S π}))
  obtain ⟨hφ, hφ', mulφ, mulφ', actφ, actφ', compφ⟩ := x.2.isIsogenyPair
  obtain ⟨qhat, hqOD, hqrep⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isODHom_forall_comp_eq_apply_nilEval_of_isFormalModuleVia coord hcoord hLr
      x.2.Ab x.2.Eb x.2.φ' hφ' mulφ' actφ' _ θA hθA _ θE hθE

  have hqrep' : ∀ (B'' : Type) [CommRing B''] [Algebra (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B''] [Algebra S B'']
      [Algebra (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B''],
      algebraMap S B'' = (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'').comp (Ideal.Quotient.mk _) →
      algebraMap (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B'' =
        (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'').comp (FakeEllipticCurve.Rigidification.residueLeg π ψS) →
      ∀ (J : Ideal B'') (m : ℕ), J ^ (m + 1) = ⊥ → ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
        ∀ PA : Spec (CommRingCat.of B'') ⟶ x.2.Ab.A,
          PA ≫ x.2.Ab.f = Spec.map (CommRingCat.ofHom (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'')) →
          PA ≫ x.2.gA = (θ₀ B'' s).1 →
            PA ≫ x.2.φ' ≫ x.2.gb = (θ B'' (fun i => MvFormalGroup.nilEval m (qhat i) s)).1 := by
    intro B'' _ _ _ _ h1 h2 J m hJ s hs PA hPAf hPAg
    haveI : IsScalarTower S (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'' := IsScalarTower.of_algebraMap_eq (fun y => by rw [h1]; rfl)
    haveI : IsScalarTower (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'' :=
      IsScalarTower.of_algebraMap_eq (fun y => by rw [h2]; rfl)
    have hsn : ∀ i, IsNilpotent (s i) := fun i => ⟨m + 1, by
      have h := Ideal.pow_mem_pow (hs i) (m + 1)
      rwa [hJ, Ideal.mem_bot] at h⟩

    have hPA : PA = (θA B'' s).1 := by
      apply x.2.isPullback_Ab.1.hom_ext
      · rw [hPAg, hθAg B'' s hsn]
      · rw [hPAf]; exact (θA B'' s).2.symm

    have hqn : ∀ i, IsNilpotent (MvFormalGroup.nilEval m (qhat i) s) := fun i =>
      ⟨m + 1, by
        have hmem := (MvFormalGroup.nilEval_subst_of_mem J m hJ s hs qhat hqOD.constantCoeff (MvPowerSeries.X 0)).1 i
        have h := Ideal.pow_mem_pow hmem (m + 1)
        rwa [hJ, Ideal.mem_bot] at h⟩
    rw [hPA, ← Category.assoc, hqrep B'' J m hJ s hs, hθEg B'' _ hqn]

  have hσq : σ = qhat :=
    CerednikDrinfeld.QM.FakeEllipticCurve.Rigidification.eq_of_represents_of_represents_of_constantCoeff_eq_zero
      𝒪 π Onr Λ coord A₀ θ₀ S ψS x.1 x.2 X θ hXθ σ qhat hσ0 hqOD.constantCoeff hrep hqrep'
  rw [hσq]
  exact hqOD

theorem isODHom_germ_map
    {r N : ℕ} [Fact r.Prime]
    (𝒪 : Type) [CommRing 𝒪] (π : 𝒪) (Onr : Type) [CommRing Onr] [Algebra 𝒪 Onr]
    {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b]) (coord : ↥Λ → Zp2 r × Zp2 r) (hcoord : IsOrderCoord Λ r coord)
    (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}))
    (X₀ : FormalODModule r (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})) (θ₀ : RelativeGroupLaw.FormalCoordinates A₀.f 2)
    (hA₀ : A₀.IsFormalModuleVia coord X₀ θ₀)
    (S : Type) [CommRing S] [IsNoetherianRing S] [Algebra 𝒪 S] (hBr : IsNilpotent ((r : ℕ) : S)) (ψS : Onr →ₐ[𝒪] S)
    (x : FakeEllipticCurve.RigidifiedCurve r π A₀ S ψS)
    (X : FormalODModule r S) (θ : RelativeGroupLaw.FormalCoordinates x.1.f 2) (hXθ : x.1.IsFormalModuleVia coord X θ)
    {Φ : FormalODModule r (Onr ⧸ pIdeal r Onr)} (tx : Rigidified r Φ S) (htX : tx.X = X)
    (κ : (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) →+* (Onr ⧸ pIdeal r Onr))
    (κB : (S ⧸ Ideal.span {algebraMap 𝒪 S π}) →+* (S ⧸ pIdeal r S))
    (hκB1 : κB.comp (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 S π})) = Ideal.Quotient.mk (pIdeal r S))
    (hκB2 : κB.comp (FakeEllipticCurve.Rigidification.residueLeg π ψS) = (residueMap (ψS : Onr →+* S)).comp κ)
    (σ : Series (S ⧸ Ideal.span {algebraMap 𝒪 S π})) (hσ0 : ∀ i, MvPowerSeries.constantCoeff (σ i) = 0)
    (hrep : ∀ (B'' : Type) [CommRing B''] [Algebra (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B''] [Algebra S B'']
        [Algebra (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B''],
        algebraMap S B'' = (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'').comp (Ideal.Quotient.mk _) →
        algebraMap (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B'' =
          (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'').comp (FakeEllipticCurve.Rigidification.residueLeg π ψS) →
        ∀ (J : Ideal B'') (m : ℕ), J ^ (m + 1) = ⊥ → ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
          ∀ PA : Spec (CommRingCat.of B'') ⟶ x.2.Ab.A,
            PA ≫ x.2.Ab.f = Spec.map (CommRingCat.ofHom (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'')) →
            PA ≫ x.2.gA = (θ₀ B'' s).1 →
              PA ≫ x.2.φ' ≫ x.2.gb = (θ B'' (fun i => MvFormalGroup.nilEval m (σ i) s)).1) :
    FormalODModule.IsODHom ((X₀.map κ).map (residueMap (ψS : Onr →+* S))) tx.Xbar (σ.map κB) := by
  have h := (isODHom_germ 𝒪 π Onr Λ coord hcoord A₀ X₀ θ₀ hA₀ S hBr ψS x X θ hXθ σ hσ0 hrep).map κB
  rw [FormalODModule.map_map, FormalODModule.map_map, hκB2, ← FormalODModule.map_map] at h
  have e1 : κB.comp (algebraMap S (S ⧸ Ideal.span {algebraMap 𝒪 S π})) = Ideal.Quotient.mk (pIdeal r S) := hκB1
  rw [e1, ← htX] at h
  exact h

end RIGN_I3

