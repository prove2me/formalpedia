    (hU _ (List.getElem_mem _)).1 (hU _ (List.getElem_mem _)).2

theorem upd_back (s : IState HS) (Y Z : List Item) :
    ((s.upd gD Y).upd gZA Z).upd gZA (s.G gZA) = s.upd gD Y := by
  rw [IState.upd_upd_same, IState.upd_comm _ (by decide), IState.upd_self]

theorem zipC_eq (q : Params) (A U : List (ℤ × ℤ)) :
    List.zipWith (gzF sgConjMul q.p) A U =
      List.zipWith (fun a u => mulZ q.p (conjZ a) u) A U := by
  congr 1; funext a u; exact gzF_conjMul q.p a u

