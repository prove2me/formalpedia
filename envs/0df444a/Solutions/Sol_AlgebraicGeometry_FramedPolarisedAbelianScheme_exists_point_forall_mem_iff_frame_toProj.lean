variable {A : Type} [CommRing A] {n : ℕ} {Z : Scheme.{0}}
  (ι : Z ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A))

def Vanishes (d : ℕ) (F : MvPolynomial (Fin (n + 1)) A) (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A d) : Prop :=
  ∀ i : Fin (n + 1),
    ι.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A) (X i))
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A) (X i))
        (HomogeneousLocalization.mk
          { deg := d
            num := ⟨F, hF⟩
            den := ⟨X i ^ d, (MvPolynomial.mem_homogeneousSubmodule d _).mpr (MvPolynomial.isHomogeneous_X_pow i d)⟩
            den_mem := ⟨d, rfl⟩ })) = 0

theorem vanishes_congr' {a b : ℕ} (e : a = b) {F G : MvPolynomial (Fin (n + 1)) A}
    (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A a)
    (hG : G ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A b) (h : F = G) :
    Vanishes ι a F hF ↔ Vanishes ι b G hG := by
  subst e; subst h; exact Iff.rfl

theorem vanishes_congr {d : ℕ} {F G : MvPolynomial (Fin (n + 1)) A} (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A d)
    (hG : G ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A d) (h : F = G) :
    Vanishes ι d F hF ↔ Vanishes ι d G hG := by
  subst h; exact Iff.rfl

noncomputable abbrev frac (i : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) A)
    (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A d) :
    HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A) (X i) :=
  HomogeneousLocalization.mk
    { deg := d
      num := ⟨F, hF⟩
      den := ⟨X i ^ d, (MvPolynomial.mem_homogeneousSubmodule d _).mpr (MvPolynomial.isHomogeneous_X_pow i d)⟩
      den_mem := ⟨d, rfl⟩ }

theorem frac_zero (i : Fin (n + 1)) (d : ℕ) :
    frac i d (0 : MvPolynomial (Fin (n + 1)) A) (Submodule.zero_mem _) = 0 := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_zero]
  exact Localization.mk_zero _

theorem frac_add (i : Fin (n + 1)) (d : ℕ) (F G : MvPolynomial (Fin (n + 1)) A)
    (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A d) (hG : G ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A d) :
    frac i d (F + G) (Submodule.add_mem _ hF hG) = frac i d F hF + frac i d G hG := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_add, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk,
    HomogeneousLocalization.val_mk]
  exact (Localization.add_mk_self _ _ _).symm

theorem frac_mul (i : Fin (n + 1)) (a b : ℕ) (H G : MvPolynomial (Fin (n + 1)) A)
    (hH : H ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A a) (hG : G ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A b) :
    frac i (a + b) (H * G) (SetLike.mul_mem_graded hH hG) = frac i a H hH * frac i b G hG := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk,
    HomogeneousLocalization.val_mk, Localization.mk_mul]
  congr 1
  exact Subtype.ext (pow_add _ _ _)

theorem vanishes_zero (d : ℕ) : Vanishes ι d 0 (Submodule.zero_mem _) := by
  intro i
  show ι.app _ (Proj.awayToSection _ (X i) (frac i d 0 (Submodule.zero_mem _))) = 0
  rw [frac_zero, map_zero, map_zero]

theorem vanishes_add {d : ℕ} {F G : MvPolynomial (Fin (n + 1)) A}
    (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A d) (hG : G ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A d)
    (vF : Vanishes ι d F hF) (vG : Vanishes ι d G hG) : Vanishes ι d (F + G) (Submodule.add_mem _ hF hG) := by
  intro i
  show ι.app _ (Proj.awayToSection _ (X i) (frac i d (F + G) (Submodule.add_mem _ hF hG))) = 0
  rw [frac_add i d F G hF hG, map_add, map_add]
  have h1 := vF i
  have h2 := vG i
  change ι.app _ (Proj.awayToSection _ (X i) (frac i d F hF)) = 0 at h1
  change ι.app _ (Proj.awayToSection _ (X i) (frac i d G hG)) = 0 at h2
  rw [h1, h2, add_zero]

theorem vanishes_mul {a b : ℕ} {H G : MvPolynomial (Fin (n + 1)) A}
    (hH : H ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A a) (hG : G ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A b)
    (vG : Vanishes ι b G hG) : Vanishes ι (a + b) (H * G) (SetLike.mul_mem_graded hH hG) := by
  intro i
  show ι.app _ (Proj.awayToSection _ (X i) (frac i (a + b) (H * G) (SetLike.mul_mem_graded hH hG))) = 0
  rw [frac_mul i a b H G hH hG, map_mul, map_mul]
  have h2 := vG i
  change ι.app _ (Proj.awayToSection _ (X i) (frac i b G hG)) = 0 at h2
  rw [h2, mul_zero]

def AllVanish (f : MvPolynomial (Fin (n + 1)) A) : Prop :=
  ∀ d : ℕ, Vanishes ι d (homogeneousComponent d f) (homogeneousComponent_mem d f)

theorem allVanish_zero : AllVanish ι 0 := fun d => by
  rw [vanishes_congr ι _ (Submodule.zero_mem _) (map_zero _)]
  exact vanishes_zero ι d

theorem allVanish_add {f g : MvPolynomial (Fin (n + 1)) A} (hf : AllVanish ι f) (hg : AllVanish ι g) :
    AllVanish ι (f + g) := fun d => by
  rw [vanishes_congr ι _ (Submodule.add_mem _ (homogeneousComponent_mem d f) (homogeneousComponent_mem d g)) (map_add _ _ _)]
  exact vanishes_add ι _ _ (hf d) (hg d)

theorem allVanish_C_mul (c : A) {f : MvPolynomial (Fin (n + 1)) A} (hf : AllVanish ι f) : AllVanish ι (C c * f) := fun d => by
  have hC : C c ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A 0 := (mem_homogeneousSubmodule 0 _).mpr (isHomogeneous_C _ c)
  have hmem : C c * homogeneousComponent d f ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A d := by
    simpa using (SetLike.mul_mem_graded hC (homogeneousComponent_mem d f))
  rw [vanishes_congr ι _ hmem (homogeneousComponent_C_mul f d c)]
  have h := vanishes_mul ι hC (homogeneousComponent_mem d f) (hf d)
  exact (vanishes_congr' ι (Nat.zero_add d) _ hmem rfl).mp h

theorem allVanish_mul_X (k : Fin (n + 1)) {f : MvPolynomial (Fin (n + 1)) A} (hf : AllVanish ι f) : AllVanish ι (f * X k) := by
  intro d
  have hX : (X k : MvPolynomial (Fin (n + 1)) A) ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A 1 :=
    (mem_homogeneousSubmodule 1 _).mpr (isHomogeneous_X A k)
  rw [mul_comm]
  cases d with
  | zero =>
    have h0 : homogeneousComponent 0 (X k * f) = 0 := by
      rw [homogeneousComponent_zero, coeff_X_mul', if_neg (by simp), C_0]
    rw [vanishes_congr ι _ (Submodule.zero_mem _) h0]
    exact vanishes_zero ι 0
  | succ j =>
    have hdec : homogeneousComponent (1 + j) (X k * f) = X k * homogeneousComponent j f := by
      have := DirectSum.coe_decompose_mul_add_of_left_mem (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A) (b := f) (j := j) hX
      rw [← MvPolynomial.decomposition.decompose'_apply, ← MvPolynomial.decomposition.decompose'_apply]
      exact this
    have hmem : X k * homogeneousComponent j f ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) A (1 + j) :=
      SetLike.mul_mem_graded hX (homogeneousComponent_mem j f)
    have h := vanishes_mul ι hX (homogeneousComponent_mem j f) (hf j)
    have hdec' : homogeneousComponent (j + 1) (X k * f) = X k * homogeneousComponent j f := by
      rw [Nat.add_comm j 1]; exact hdec
    exact (vanishes_congr' ι (Nat.add_comm 1 j) hmem (homogeneousComponent_mem (j + 1) (X k * f)) hdec'.symm).mp h

theorem allVanish_mul (r : MvPolynomial (Fin (n + 1)) A) : ∀ (f : MvPolynomial (Fin (n + 1)) A), AllVanish ι f → AllVanish ι (r * f) := by
  refine @MvPolynomial.induction_on A (Fin (n + 1)) _
    (fun r => ∀ (f : MvPolynomial (Fin (n + 1)) A), AllVanish ι f → AllVanish ι (r * f)) r
    (fun c f hf => allVanish_C_mul ι c hf) (fun p q hp hq f hf => ?_) (fun p k hp f hf => ?_)
  · rw [add_mul]; exact allVanish_add ι (hp f hf) (hq f hf)
  · rw [mul_assoc]
    apply hp _
    rw [mul_comm]
    exact allVanish_mul_X ι k hf

theorem vanishes_of_mem_span (m d : ℕ) (F : MvPolynomial (Fin (n + 1)) A) (hF : F.IsHomogeneous d)
    (hmem : F ∈ Ideal.span { F : MvPolynomial (Fin (n + 1)) A | ∃ (d : ℕ) (hF : F.IsHomogeneous d), m ≤ d ∧
        Vanishes ι d F ((MvPolynomial.mem_homogeneousSubmodule d F).mpr hF) }) :
    Vanishes ι d F ((MvPolynomial.mem_homogeneousSubmodule d F).mpr hF) := by
  have hall : AllVanish ι F := by
    refine Submodule.span_induction (p := fun f _ => AllVanish ι f) ?_ (allVanish_zero ι) (fun _ _ _ _ h₁ h₂ => allVanish_add ι h₁ h₂)
      (fun r _ _ h => allVanish_mul ι r _ h) hmem
    rintro G ⟨dG, hG, -, vG⟩ d'
    have hc := homogeneousComponent_of_mem (m := d') ((MvPolynomial.mem_homogeneousSubmodule dG G).mpr hG)
    by_cases hdd : d' = dG
    · subst hdd
      rw [if_pos rfl] at hc
      rw [vanishes_congr ι _ ((MvPolynomial.mem_homogeneousSubmodule _ G).mpr hG) hc]
      exact vG
    · rw [if_neg hdd] at hc
      rw [vanishes_congr ι _ (Submodule.zero_mem _) hc]
      exact vanishes_zero ι d'
  have h := hall d
  have hc := homogeneousComponent_of_mem (m := d) ((MvPolynomial.mem_homogeneousSubmodule d F).mpr hF)
  rw [if_pos rfl] at hc
  exact (vanishes_congr ι _ ((MvPolynomial.mem_homogeneousSubmodule d F).mpr hF) hc).mp h

end FramedHilbPoint

