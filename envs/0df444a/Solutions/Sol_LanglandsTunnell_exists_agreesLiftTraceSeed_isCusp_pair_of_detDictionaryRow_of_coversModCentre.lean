private theorem ratOf_prime (u : HeightOneSpectrum (𝓞 (↥(_root_.LanglandsTunnell.P0.fixFld (_root_.LanglandsTunnell.P5.sylowH e))))) : (ratOf u).Prime :=
  ((Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ)) (u.under (𝓞 ℚ))).2

