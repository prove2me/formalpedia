/-!
# `atanInv` / `atanhInv` as a register program

Inputs `N` on register `0`, `K` on register `1`; the result is pushed on register `2`.
Scratch registers `40 … 45`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

theorem atanSum_succ (x N : ℕ) (σ : ℤ) (k : ℕ) : atanSum x N σ (k + 1) =
    atanSum x N σ k + σ ^ k * ((2 ^ N / ((2 * k + 1) * x ^ (2 * k + 1)) : ℕ) : ℤ) := by
  simp [atanSum, Finset.sum_range_succ]

end NLogN

namespace NLogN
open IntMul RS

theorem zsz_le_of_abs_le {z : ℤ} {M B : ℕ} (h : |z| ≤ (M : ℤ)) (hM : M < 2 ^ B) : zsz z ≤ B :=
  zsz_le_of_natAbs_le (by rw [Int.abs_eq_natAbs] at h; exact_mod_cast h) hM

theorem atanSum_abs_le (x N : ℕ) (σ : ℤ) (hσ : |σ| = 1) (k : ℕ) :
    |atanSum x N σ k| ≤ k * 2 ^ N := by
  induction k with
  | zero => simp [atanSum]
  | succ k ih =>
    rw [atanSum_succ]
    have hq : |(((2 ^ N / ((2 * k + 1) * x ^ (2 * k + 1)) : ℕ) : ℤ))| ≤ 2 ^ N := by
      rw [abs_of_nonneg (by positivity)]
      exact_mod_cast Nat.div_le_self _ _
    calc |atanSum x N σ k + σ ^ k * _| ≤ |atanSum x N σ k| + |σ ^ k * _| := abs_add_le _ _
      _ ≤ k * 2 ^ N + 2 ^ N := by
        rw [abs_mul, abs_pow, hσ, one_pow, one_mul]; exact add_le_add ih hq
      _ = ((k + 1 : ℕ) : ℤ) * 2 ^ N := by push_cast; ring

theorem atanM_lt (x N K : ℕ) : atanM x N K < 2 ^ atanB x N K := by
  have h1 : 2 * K + 3 < 2 ^ (2 * K + 3) := Nat.lt_two_pow_self
  have h2 : x ^ (2 * K + 3) < 2 ^ ((2 * K + 3) * x + 1) := by
    calc x ^ (2 * K + 3) < (2 ^ x) ^ (2 * K + 3) :=
          Nat.pow_lt_pow_left Nat.lt_two_pow_self (by omega)
      _ = 2 ^ ((2 * K + 3) * x) := by rw [← pow_mul, mul_comm]
      _ < 2 ^ ((2 * K + 3) * x + 1) := Nat.pow_lt_pow_right (by norm_num) (by omega)
  unfold atanM atanB
  calc 2 ^ N * (2 * K + 3) * x ^ (2 * K + 3) < 2 ^ N * 2 ^ (2 * K + 3) * 2 ^ ((2 * K + 3) * x + 1) := by
        apply Nat.mul_lt_mul'' (Nat.mul_lt_mul_of_pos_left h1 (by positivity)) h2
    _ = 2 ^ (N + (2 * K + 3) * (x + 1) + 1) := by rw [← pow_add, ← pow_add]; ring_nf
    _ ≤ _ := Nat.pow_le_pow_right (by norm_num) (by omega)

