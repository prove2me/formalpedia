open AlgebraicCurve

theorem AlgebraicCurve.Pic0.exists_nsmul_eq_of_charP (K F : Type*) [Field K] [Field F] [Algebra K F]
    [IsAlgClosed K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (hfg : ∃ x : F, Transcendental K x ∧ FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F)
    [IsCurveOver K F]
    (n : ℕ) (hn : n ≠ 0) (x : Pic0 K F) :
    ∃ y : Pic0 K F, n • y = x := by sorry
