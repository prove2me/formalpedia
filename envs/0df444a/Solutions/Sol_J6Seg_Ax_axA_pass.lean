-- Source module: Solutions.J6SegKr5
/-!
# B3 (chunk kernel), part 5: one block

`blkI pM`: with a block header `[n, 2n, kG b (2n) 2^pk, (2^b)^(4n)]` and the block tables `am, ap`
on top of the table stack `dT`, the four stage tables on `TDI, TGI, TGA, TDD`, and the block
input `z` (length `n`) on top of the row stack `0`, it pushes `gflat (blkG …).reverse` onto `OUT`,
consumes the header and tables from `dT` onto the consumed-descriptor stack `DU`, and decrements
the block counter `BC`.

The stacks the block body changes are kept in the frame `BF` (twelve stacks over a base `G`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Taking header values off the table stack -/

/-! ## The block -/

lemma gb_AB {pk B : ℕ} {u : List GI} (h : AB (2 ^ pk) u) (hB : pk + 1 ≤ B) : GB B u := by
  intro w hw
  have hlt : ∀ a : ℤ, |a| ≤ 2 ^ pk → zsz a ≤ B := fun a ha =>
    le_trans (NLogN.zsz_le_of_abs (lt_of_le_of_lt ha (pow_lt_pow_right₀ (by norm_num) (by omega))))
      hB
  exact ⟨hlt _ (h w hw).1, hlt _ (h w hw).2⟩

end J6Seg.KR

