section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open NLogN.KIL
open IntMul RS AModel
theorem solution (t : NLogN.IState NLogN.HS) (xs : List ℤ) (P Q k B Bb : ℕ) (R : List NLogN.Item)
    (hlen : xs.length = P * Q * B) (hb : NLogN.Bnd Bb xs) (hk : 1 ≤ k)
    (hQk : Nat.Coprime Q k) (zB : NLogN.zsz (B : ℤ) ≤ Bb) (zk : NLogN.zsz ((2 * k : ℕ) : ℤ) ≤ Bb)
    (zQ : NLogN.zsz (Q : ℤ) ≤ Bb) (zQB : NLogN.zsz ((Q * B : ℕ) : ℤ) ≤ Bb) (zP : NLogN.zsz (P : ℤ) ≤ Bb)
    (zV : NLogN.zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = NLogN.ints xs ++ R) (hp : NLogN.KIL.StP t P Q B) :
    NLogN.KIL.Sp (NLogN.KIL.fmulPU k) t (t.upd 0 (NLogN.ints (AModel.pull [P, Q, B] [P, Q, B] (NLogN.KIL.mulAddr Q k) 0 xs) ++ R))
      (NLogN.KIL.cMulPgU P Q k B Bb) := by
  by_cases h : k < 2
  · obtain rfl : k = 1 := by omega
    rw [NLogN.KIL.fmulPU, if_pos h, NLogN.KIL.pull_mulAddr_one hlen, NLogN.KIL.upd_eq_self h0]
    exact (NLogN.KIL.Sp.skip t).mono (by unfold NLogN.KIL.cMulPgU; omega)
  · rw [NLogN.KIL.fmulPU, if_neg h]
    obtain ⟨_, hQs⟩ := hp.hQ; obtain ⟨_, hBs⟩ := hp.hB; obtain ⟨_, hAs⟩ := hp.hA
    obtain ⟨_, hVs⟩ := hp.hV; obtain ⟨_, hQBs⟩ := hp.hQB
    exact NLogN.KIL.mulPgU_spec t xs P Q k B Bb R hlen hb (by omega) hQk zB zk zQ zQB zP zV h0 hQs hBs hAs
      hVs hQBs
end
