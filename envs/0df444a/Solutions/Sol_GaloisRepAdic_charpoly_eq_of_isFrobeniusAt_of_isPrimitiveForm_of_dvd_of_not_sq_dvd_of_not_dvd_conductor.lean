    rw [Module.finrank_baseChange, ρES.finrank_eq]

  have hiQex : ∃ iQ : ℚ_[lam] →+* ↥L', iQ = (algebraMap (FractionRing O') ↥L').comp jL := ⟨_, rfl⟩
