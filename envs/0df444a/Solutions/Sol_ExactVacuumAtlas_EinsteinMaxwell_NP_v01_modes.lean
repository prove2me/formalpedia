section III
variable (p : Hintz2026.SubextremalKN)

/-- Domains: `(r, θ) ∈ U p` iff `(t, r, θ, φ) ∈ domKN M a Q` (any `t`, `φ`). -/
theorem mem_U_iff (x : Pt 4) : toRT x ∈ Hintz2026.U p ↔ x ∈ domKN p.M p.a p.Q := Iff.rfl

end III

/-! ### The four directions are III's `j = 0` operators -/

section Bridge
variable (p : Hintz2026.SubextremalKN) (om mm : ℝ) (u : (Fin 2 → ℝ) → ℂ) (x : Pt 4)

/-! The mode factor and the frame prefactors never vanish on the exterior, so each frame derivative vanishes iff the
III operator does (`ω = 0`, `m = 0` included; nothing is divided by `ω` or `m`). -/

