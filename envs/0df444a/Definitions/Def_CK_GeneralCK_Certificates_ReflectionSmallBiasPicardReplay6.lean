    funext z
    ring
  have h10 : Approximates 24 k (fun z => f z ^ 10) replay6p10 := by
    convert (h2.mul hk h8).replacePolynomial (equalityCheck_sound replay6p10_checked k) using 1
    funext z
    ring
  have h12 : Approximates 24 k (fun z => f z ^ 12) replay6p12 := by
