  · filter_upwards [eventually_ne_atTop 0] with n hn
    simp only [Complex.norm_natCast]
    rw [div_mul_cancel₀ _ (Nat.cast_ne_zero.2 hn)]
  · exact Eventually.of_forall fun n ↦ by simp
