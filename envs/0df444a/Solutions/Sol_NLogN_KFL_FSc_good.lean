lemma packed_bounds (hρK : ρ < K) (hf : 1 ≤ f) (lo : ℤ) (u : ℕ → ℤ) (h : ℤ)
    (hlo : 0 ≤ lo ∧ lo < 2 ^ ρ) (hu : ∀ i < f - 1, 0 ≤ u i ∧ u i < 2 ^ K)
    (hh : 0 ≤ h ∧ h < 2 ^ (K - ρ)) :
    0 ≤ packed K ρ (f - 1) lo u h ∧ packed K ρ (f - 1) lo u h < 2 ^ (f * K) := by
  obtain ⟨p0, p1⟩ := pk_bounds K (f - 1) u h _ hu hh.1 hh.2
  have hρ : (0 : ℤ) < 2 ^ ρ := by positivity
  unfold packed
  constructor
  · nlinarith
  · have hpk : Butterfly.pk K (f - 1) u h + 1 ≤ 2 ^ ((f - 1) * K) * 2 ^ (K - ρ) := by linarith
    have e : (2 : ℤ) ^ ρ * (2 ^ ((f - 1) * K) * 2 ^ (K - ρ)) = 2 ^ (f * K) := by
      rw [← pow_add, ← pow_add]; congr 1
      obtain ⟨g, rfl⟩ : ∃ g, f = g + 1 := ⟨f - 1, by omega⟩
      simp only [Nat.add_sub_cancel]; rw [Nat.add_mul, one_mul]; omega
    calc lo + 2 ^ ρ * Butterfly.pk K (f - 1) u h < 2 ^ ρ + 2 ^ ρ * Butterfly.pk K (f - 1) u h := by linarith
      _ = 2 ^ ρ * (Butterfly.pk K (f - 1) u h + 1) := by ring
      _ ≤ 2 ^ ρ * (2 ^ ((f - 1) * K) * 2 ^ (K - ρ)) := by gcongr
      _ = 2 ^ (f * K) := e

/-- The offset of a packed line, computed segmentwise. -/
lemma offset_packed (hK : 1 ≤ K) (x b : ℤ) (lo : ℤ) (u : ℕ → ℤ) (h : ℤ)
    (hlo : 0 ≤ lo ∧ lo < 2 ^ ρ) (hu : ∀ i < f - 1, 0 ≤ u i ∧ u i < 2 ^ K) (hh : 0 ≤ h) :
    Butterfly.offset K ρ f x (packed K ρ (f - 1) lo u h) b =
      2 ^ ρ * Butterfly.pk K (f - 1) (fun i => if Butterfly.ctl K ρ x i ∧ u i % 2 = b then 1 else 0) 0 := by
  rw [← sum_eq_pk, Finset.mul_sum, Butterfly.offset]
  refine Finset.sum_congr rfl fun i hi => ?_
  rw [bitAt_packed K ρ (f - 1) hK lo u h hlo hu hh i (Finset.mem_range.1 hi), pow_add]
  simp only [Butterfly.ctl, decide_eq_true_eq]; ring

/-- One packed line acts segmentwise as long as all segments stay in `[0, 2^K)`. -/
lemma pline_packed (hρK : ρ < K) (hf : 1 ≤ f) (x : ℤ) (l : Line)
    (loy loz hy hz : ℤ) (u w : ℕ → ℤ)
    (hloy : 0 ≤ loy ∧ loy < 2 ^ ρ) (hloz : 0 ≤ loz ∧ loz < 2 ^ ρ)
    (hhy : 0 ≤ hy ∧ hy < 2 ^ (K - ρ)) (hhz : 0 ≤ hz ∧ hz < 2 ^ (K - ρ))
    (hu : ∀ i < f - 1, 0 ≤ u i ∧ u i < 2 ^ K) (hw : ∀ i < f - 1, 0 ≤ w i ∧ w i < 2 ^ K)
    (hu' : ∀ i < f - 1, 0 ≤ (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).1 ∧
      (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).1 < 2 ^ K)
    (hw' : ∀ i < f - 1, 0 ≤ (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).2 ∧
      (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).2 < 2 ^ K) :
    pline K ρ f x l (packed K ρ (f - 1) loy u hy, packed K ρ (f - 1) loz w hz) =
      (packed K ρ (f - 1) loy (fun i => (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).1) hy,
       packed K ρ (f - 1) loz (fun i => (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).2) hz) := by
  have hK : 1 ≤ K := by omega
  unfold pline
  by_cases ht : l.tgtY
  · simp only [ht, if_true]
    rw [offset_packed hK x l.b loz w hz hloz hw hhz.1]
    have e : packed K ρ (f - 1) loy u hy + l.sgn * (2 ^ ρ * Butterfly.pk K (f - 1)
        (fun i => if Butterfly.ctl K ρ x i ∧ w i % 2 = l.b then 1 else 0) 0) =
        packed K ρ (f - 1) loy (fun i => (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).1) hy := by
      unfold packed
      rw [show l.sgn * (2 ^ ρ * Butterfly.pk K (f - 1)
          (fun i => if Butterfly.ctl K ρ x i ∧ w i % 2 = l.b then 1 else 0) 0) =
          2 ^ ρ * Butterfly.pk K (f - 1)
          (fun i => l.sgn * (if Butterfly.ctl K ρ x i ∧ w i % 2 = l.b then 1 else 0)) 0 by
        rw [← sum_eq_pk, ← sum_eq_pk, Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => by ring]
      rw [add_assoc, ← mul_add, pk_add]
      congr 2; congr 1; funext i; simp [Line.apply, ht]
    rw [e]
    obtain ⟨b0, b1⟩ := packed_bounds hρK hf loy _ hy hloy hu' hhy
    rw [Int.emod_eq_of_lt b0 b1]
    congr 1
    unfold packed; congr 2; congr 1; funext i; simp [Line.apply, ht]
  · simp only [ht, Bool.false_eq_true, if_false]
    rw [offset_packed hK x l.b loy u hy hloy hu hhy.1]
    have e : packed K ρ (f - 1) loz w hz + l.sgn * (2 ^ ρ * Butterfly.pk K (f - 1)
        (fun i => if Butterfly.ctl K ρ x i ∧ u i % 2 = l.b then 1 else 0) 0) =
        packed K ρ (f - 1) loz (fun i => (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).2) hz := by
      unfold packed
      rw [show l.sgn * (2 ^ ρ * Butterfly.pk K (f - 1)
          (fun i => if Butterfly.ctl K ρ x i ∧ u i % 2 = l.b then 1 else 0) 0) =
          2 ^ ρ * Butterfly.pk K (f - 1)
          (fun i => l.sgn * (if Butterfly.ctl K ρ x i ∧ u i % 2 = l.b then 1 else 0)) 0 by
        rw [← sum_eq_pk, ← sum_eq_pk, Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => by ring]
      rw [add_assoc, ← mul_add, pk_add]
      congr 2; congr 1; funext i; simp [Line.apply, ht]
    rw [e]
    obtain ⟨b0, b1⟩ := packed_bounds hρK hf loz _ hz hloz hw' hhz
    rw [Int.emod_eq_of_lt b0 b1]
    congr 1
    unfold packed; congr 2; congr 1; funext i; simp [Line.apply, ht]

/-- Running a list of lines segmentwise, with a displacement budget. -/
lemma foldl_packed (hρK : ρ < K) (hf : 1 ≤ f) (x : ℤ) :
    ∀ (ls : List Line), (∀ l ∈ ls, l ∈ lines) →
    ∀ (loy loz hy hz : ℤ) (u w : ℕ → ℤ),
    (0 ≤ loy ∧ loy < 2 ^ ρ) → (0 ≤ loz ∧ loz < 2 ^ ρ) →
    (0 ≤ hy ∧ hy < 2 ^ (K - ρ)) → (0 ≤ hz ∧ hz < 2 ^ (K - ρ)) →
    (∀ i < f - 1, (ls.length : ℤ) ≤ u i ∧ u i < 2 ^ K - ls.length) →
    (∀ i < f - 1, (ls.length : ℤ) ≤ w i ∧ w i < 2 ^ K - ls.length) →
    ls.foldl (fun p l => pline K ρ f x l p)
        (packed K ρ (f - 1) loy u hy, packed K ρ (f - 1) loz w hz) =
      (packed K ρ (f - 1) loy
          (fun i => (ls.foldl (fun p l => l.apply (Butterfly.ctl K ρ x i) p) (u i, w i)).1) hy,
       packed K ρ (f - 1) loz
          (fun i => (ls.foldl (fun p l => l.apply (Butterfly.ctl K ρ x i) p) (u i, w i)).2) hz) := by
  intro ls
  induction ls with
  | nil => intros; rfl
  | cons l ls ih =>
    intro hls loy loz hy hz u w hloy hloz hhy hhz hu hw
    simp only [List.length_cons, Nat.cast_add, Nat.cast_one] at hu hw
    have hl := hls l (by simp)
    have hb := fun i => Line.apply_bound l hl (Butterfly.ctl K ρ x i) (u i, w i)
    rw [List.foldl_cons, pline_packed hρK hf x l loy loz hy hz u w hloy hloz hhy hhz
      (fun i hi => ⟨by linarith [(hu i hi).1, Nat.cast_nonneg (α := ℤ) ls.length],
        by linarith [(hu i hi).2, Nat.cast_nonneg (α := ℤ) ls.length]⟩)
      (fun i hi => ⟨by linarith [(hw i hi).1, Nat.cast_nonneg (α := ℤ) ls.length],
        by linarith [(hw i hi).2, Nat.cast_nonneg (α := ℤ) ls.length]⟩)
      (fun i hi => by
        have := (hb i).1; rw [abs_le] at this
        constructor <;> linarith [(hu i hi).1, (hu i hi).2, Nat.cast_nonneg (α := ℤ) ls.length])
      (fun i hi => by
        have := (hb i).2; rw [abs_le] at this
        constructor <;> linarith [(hw i hi).1, (hw i hi).2, Nat.cast_nonneg (α := ℤ) ls.length])]
    rw [ih (fun l' hl' => hls l' (by simp [hl'])) loy loz hy hz _ _ hloy hloz hhy hhz
      (fun i hi => by
        have := (hb i).1; rw [abs_le] at this
        constructor <;> linarith [(hu i hi).1, (hu i hi).2])
      (fun i hi => by
        have := (hb i).2; rw [abs_le] at this
        constructor <;> linarith [(hw i hi).1, (hw i hi).2])]
    rfl

/-- **Lemma 13, core correctness (segment form).** If every used segment of `y` and `z` lies in
`[8, 2^K - 8)`, the eight packed lines `S0` flip the parity of segment `i` of `y` exactly when
its control `x_{j_i}` is one, and restore `z`. -/
theorem S0_packed (hρK : ρ < K) (hf : 1 ≤ f) (x : ℤ) (loy loz hy hz : ℤ) (u w : ℕ → ℤ)
    (hloy : 0 ≤ loy ∧ loy < 2 ^ ρ) (hloz : 0 ≤ loz ∧ loz < 2 ^ ρ)
    (hhy : 0 ≤ hy ∧ hy < 2 ^ (K - ρ)) (hhz : 0 ≤ hz ∧ hz < 2 ^ (K - ρ))
    (hu : ∀ i < f - 1, 8 ≤ u i ∧ u i < 2 ^ K - 8) (hw : ∀ i < f - 1, 8 ≤ w i ∧ w i < 2 ^ K - 8) :
    Butterfly.S0 K ρ f x (packed K ρ (f - 1) loy u hy, packed K ρ (f - 1) loz w hz) =
      (packed K ρ (f - 1) loy
          (fun i => u i + (if Butterfly.ctl K ρ x i then 1 else 0) * (1 - 2 * (u i % 2))) hy,
       packed K ρ (f - 1) loz w hz) := by
  unfold Butterfly.S0
  rw [foldl_packed hρK hf x lines (fun l hl => hl) loy loz hy hz u w hloy hloz hhy hhz
    (by simpa [lines] using hu) (by simpa [lines] using hw)]
  have : ∀ i, lines.foldl (fun p l => l.apply (Butterfly.ctl K ρ x i) p) (u i, w i) =
      (u i + (if Butterfly.ctl K ρ x i then 1 else 0) * (1 - 2 * (u i % 2)), w i) :=
    fun i => run8_eq _ _ _
  simp only [this]

/-- Every integer is the packing of its own `K`-bit digits. -/
lemma pk_digits (n : ℕ) (P : ℤ) :
    P = Butterfly.pk K n (fun i => (P / 2 ^ (i * K)) % 2 ^ K) (P / 2 ^ (n * K)) := by
  induction n generalizing P with
  | zero => simp [Butterfly.pk]
  | succ n ih =>
    have hK : (0 : ℤ) ≤ 2 ^ K := by positivity
    simp only [Butterfly.pk, zero_mul, pow_zero, Int.ediv_one]
    have e1 : ∀ i, P / 2 ^ ((i + 1) * K) = P / 2 ^ K / 2 ^ (i * K) := by
      intro i; rw [Int.ediv_ediv_of_nonneg hK, ← pow_add]; congr 2; ring
    simp only [e1]
    rw [← ih (P / 2 ^ K), Int.emod_add_mul_ediv]

/-- `N mod 2^K = 2 ((N/2) mod 2^{K-1}) + N mod 2`. -/
lemma emod_two_pow_split (N : ℤ) (hK : 1 ≤ K) :
    N % 2 ^ K = 2 * ((N / 2) % 2 ^ (K - 1)) + N % 2 := by
  have hQ : (0 : ℤ) < 2 ^ (K - 1) := by positivity
  have h2K : (2 : ℤ) ^ K = 2 * 2 ^ (K - 1) := by rw [← pow_succ']; congr 1; omega
  have := (Int.ediv_emod_unique (a := N) (b := 2 ^ K) (r := 2 * ((N / 2) % 2 ^ (K - 1)) + N % 2)
    (q := N / 2 / 2 ^ (K - 1)) (by positivity)).2
  refine (this ⟨?_, ?_, ?_⟩).2
  · have a1 := Int.emod_add_mul_ediv N 2
    have a2 := Int.emod_add_mul_ediv (N / 2) (2 ^ (K - 1))
    rw [h2K]; linear_combination a1 + 2 * a2
  · have := Int.emod_nonneg (N / 2) hQ.ne'
    have := Int.emod_nonneg N (two_ne_zero)
    positivity
  · have a1 := Int.emod_lt_of_pos (N / 2) hQ
    have a2 := Int.emod_lt_of_pos N two_pos
    rw [h2K]; linarith

