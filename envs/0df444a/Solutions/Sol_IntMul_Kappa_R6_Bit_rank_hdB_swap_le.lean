section Blocks

variable {K : Type*} [Field K] {m : ℕ}

/-- A single transposition contributes rank at most one to the `H × D` block. -/
lemma rank_hdB_swap_le_sol_aux (a b : Fin (m + m)) :
    (hdB ((Equiv.swap a b).permMatrix K)).rank ≤ 1 := by
  have key : ∀ (s : Finset (Fin m)), s.card ≤ 1 →
      (∀ i j, (Equiv.swap a b) (Fin.castAdd m i) = Fin.natAdd m j → i ∈ s) →
      (hdB ((Equiv.swap a b).permMatrix K)).rank ≤ 1 := by
    intro s hs hsub
    refine (rank_le_card_of_support_subset _ s ?_).trans hs
    intro i hi
    rw [Function.mem_support] at hi
    by_contra hni
    apply hi
    funext j
    have : (Equiv.swap a b) (Fin.castAdd m i) ≠ Fin.natAdd m j := fun h => hni (hsub i j h)
    simp [hdB, Matrix.row, Equiv.Perm.permMatrix, PEquiv.toMatrix_apply, Equiv.toPEquiv_apply,
      this, -Fin.natAdd_eq_addNat]
  induction a using Fin.addCases with
  | left a =>
    induction b using Fin.addCases with
    | left b =>
      refine key ∅ (by simp) fun i j h => ?_
      exfalso
      rw [Equiv.swap_apply_def] at h
      split_ifs at h <;> exact castAdd_ne_natAdd _ _ h
    | right b =>
      refine key {a} (by simp) fun i j h => ?_
      rw [Equiv.swap_apply_def] at h
      split_ifs at h with h1 h2
      · exact Finset.mem_singleton.2 (Fin.castAdd_injective _ _ h1)
      · exact absurd h2 (castAdd_ne_natAdd _ _)
      · exact absurd h (castAdd_ne_natAdd _ _)
  | right a =>
    induction b using Fin.addCases with
    | left b =>
      refine key {b} (by simp) fun i j h => ?_
      rw [Equiv.swap_apply_def] at h
      split_ifs at h with h1 h2
      · exact absurd h1 (castAdd_ne_natAdd _ _)
      · exact Finset.mem_singleton.2 (Fin.castAdd_injective _ _ h2)
      · exact absurd h (castAdd_ne_natAdd _ _)
    | right b =>
      refine key ∅ (by simp) fun i j h => ?_
      exfalso
      rw [Equiv.swap_apply_def] at h
      split_ifs at h with h1 h2
      · exact castAdd_ne_natAdd _ _ h1
      · exact castAdd_ne_natAdd _ _ h2
      · exact castAdd_ne_natAdd _ _ h

end Blocks

