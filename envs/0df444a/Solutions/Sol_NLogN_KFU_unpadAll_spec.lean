theorem one_le_vol : ∀ (A : Shape), (∀ a ∈ A, 1 ≤ a) → 1 ≤ AModel.vol A
  | [], _ => by simp
  | a :: A, h => by
    rw [vol_cons]
    exact Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by have := h a (by simp); omega)
      (by have := one_le_vol A (fun b hb => h b (by simp [hb])); omega))

theorem vol_le_of_forall₂ : ∀ {A B : Shape}, List.Forall₂ (· ≤ ·) A B → AModel.vol A ≤ AModel.vol B
  | [], [], _ => le_rfl
  | a :: A, b :: B, .cons h hr => by
    rw [vol_cons, vol_cons]; exact Nat.mul_le_mul h (vol_le_of_forall₂ hr)

theorem vol_take_le (T : Shape) (hT : ∀ a ∈ T, 1 ≤ a) (k : ℕ) : AModel.vol (T.take k) ≤ AModel.vol T := by
  conv_rhs => rw [← List.take_append_drop k T]
  rw [vol_append]
  exact Nat.le_mul_of_pos_right _ (NLogN.KFU.one_le_vol _ (fun a ha => hT a (List.mem_of_mem_drop ha)))

theorem forall₂_refl' (X : Shape) : List.Forall₂ (· ≤ ·) X X :=
  List.forall₂_same.2 fun x _ => le_refl x

theorem bnd_pull {w : ℕ} (sh sh' : Shape) (g : List ℕ → List ℕ) {xs : List ℤ} (h : Bnd w xs) :
    Bnd w (AModel.pull sh sh' g 0 xs) := by
  intro a ha
  simp only [AModel.pull, List.mem_map, List.mem_range] at ha
  obtain ⟨j, -, rfl⟩ := ha
  unfold List.getD
  rcases hx : xs[encode sh (g (decode sh' j))]? with _ | x
  · simp [zsz_zero]
  · exact h x (List.mem_of_getElem? hx)

end NLogN.KFU

