section Dilation

variable [IsFractionRing R K]

private theorem stdLattice_le_latticeMap_scalarGL_inv_pow {ϖ : R} (hϖ : ϖ ≠ 0) (N : ℕ) :
    stdLattice R K ≤
      latticeMap (scalarGL ((unitOfNeZero (K := K) hϖ)⁻¹ ^ N)) (stdLattice R K) := by
  intro v hv
  rw [mem_latticeMap_scalarGL]
  have hne : algebraMap R K ϖ ≠ 0 := by
    rw [← unitOfNeZero_coe (K := K) hϖ]
    exact Units.ne_zero _
  refine ⟨algebraMap R K (ϖ ^ N) • v, ?_, ?_⟩
  · intro i
    rw [Pi.smul_apply, smul_eq_mul, map_pow]
    exact IsLocalization.isInteger_mul ⟨ϖ ^ N, by rw [map_pow]⟩ (hv i)
  · have hcoe : (((unitOfNeZero (K := K) hϖ)⁻¹ ^ N : Kˣ) : K) =
        (algebraMap R K ϖ)⁻¹ ^ N := by
      rw [Units.val_pow_eq_pow_val, Units.val_inv_eq_inv_val, unitOfNeZero_coe]
    rw [smul_smul, hcoe, map_pow, inv_pow, inv_mul_cancel₀ (pow_ne_zero N hne), one_smul]

end Dilation
