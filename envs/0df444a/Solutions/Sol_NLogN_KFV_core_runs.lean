theorem recRep_scG {r p n : ℕ} {zs : List GI} {xs : List (Fin r → ℂ)} (h : RecRep r p zs xs) :
    RecRep r p (zs.map (scG n)) (xs.map fun x => ((2 : ℂ) ^ n) • x) := by
  refine ⟨by simp [h.1], fun j c hj => ?_⟩
  simp only [List.length_map] at hj
  have hjr : j * r + c < zs.length := by
    rw [h.1]
    calc j * r + c < j * r + r := by omega
      _ = (j + 1) * r := by ring
      _ ≤ xs.length * r := Nat.mul_le_mul_right _ hj
  rw [List.getD_eq_getElem _ _ (by simpa using hjr), List.getElem_map,
    List.getD_eq_getElem _ _ (by simpa using hj), List.getElem_map]
  have e := h.2 j c hj
  rw [List.getD_eq_getElem _ _ hjr, List.getD_eq_getElem _ _ hj] at e
  simp only [scG, NLogN.KFB.toC, Pi.smul_apply, smul_eq_mul] at e ⊢
  push_cast
  have : ((zs[j * r + ↑c].1 : ℂ) + (zs[j * r + ↑c].2 : ℂ) * Complex.I) = 2 ^ p * xs[j] c := e
  linear_combination (2 : ℂ) ^ n * this

theorem gflat_length (zs : List GI) : (gflat zs).length = 2 * zs.length := by
  induction zs with
  | nil => rfl
  | cons z zs ih => simp [gflat] at ih ⊢; omega

theorem rebase_sT (s : IState HS) (fB : Fin HS → List ℤ) (hT : fB NLogN.KFV.sT = []) (X v : List ℤ) :
    encK (encK s fB) (Function.update (o0 v) NLogN.KFV.sT X) =
      encK (encK s (Function.update fB NLogN.KFV.sT X)) (o0 v) := by
  rw [encK_encK, encK_encK]
  congr 1
  funext j
  by_cases h1 : j = NLogN.KFV.sT
  · subst h1; simp +decide [o0, hT]
  · by_cases h2 : j = 0
    · subst h2; simp +decide [o0]
    · simp [o0, h1, h2]

end NLogN.KFV

