-- Source module: Solutions.KFY3Core
/-!
# KFY 3: generic pieces of the line passes

* **`coreQ ax`**: nlogn's `GL.axisP ax` without its transposition prelude `preP` (the
  `O(V log V)` radix transpose `transP 2`). The rotation is done before, by `TransNeed`.
  **`coreQ_all`**: on `gD = gints L ++ R` it applies the slice map to the consecutive slices
  of `L` (`coreOut`).
* **`padIn`** / **`padOut`**: a slice program for slices of length `s` turned into one for the
  padded slices of length `t ≥ s`: `padIn` drops the last `t − s` entries of the input slice
  (`f (x.take s)`), `padOut` appends `t − s` zeros to the output slice
  (`f x ++ replicate (t − s) 0`).
* **`pushL`** / **`popL`**: push a list of register values given by expressions, pop them again.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

/-! ## Small expression facts -/

/-- `2 t − 2 s` from registers `rT`, `rS`. -/
def cdE (rT rS : Fin HS) : Ex HS := .add (cnt2 rT) (.neg (cnt2 rS))

/-- Size conditions of the moves of a padded axis (`n = n' = t`, `m` slices). -/
structure AxQA (t m Bi Bo Q : ℕ) : Prop where
  hm : 1 ≤ m
  bB : Bi ≤ Q
  bBo : Bo ≤ Q
  bt : zsz ((2 * t : ℕ) : ℤ) ≤ Q
  bm : zsz ((2 * m : ℕ) : ℤ) ≤ Q
  btot : zsz ((2 * (m * t) : ℕ) : ℤ) ≤ Q

/-! ## The axis core -/

section core

variable {M : MulSpec} {Ctx : IState HS → Prop} {B : ℕ}

/-- `GL.axisP` without the transposition prelude. -/
def coreQ (ax : GL.Axis M Ctx B) : RM :=
  .seq (.rep gCC (.reg ax.rm) (chunkBody ax)) (.rs (mvList gZB NLogN.GL.gD gCV (cnt2 ax.rtot)))

/-- Cost bound of `coreQ`. -/
def coreCost (ax : GL.Axis M Ctx B) (Q : ℕ) : ℕ :=
  ax.m * (ax.C + 100000 * (ax.n + ax.n' + 1) * (Q + 2)) + 100000 * (ax.m * ax.n' + 1) * (Q + 2)

/-- The output of the core: the slice map on the consecutive slices. -/
def coreOut (ax : GL.Axis M Ctx B) (L : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  (chunkL ax.n L).flatMap ax.f

end core

/-! ## Pushing zeros -/

/-- Push `n` zero items onto `X` (counter `C`). -/
def pushZ (X C : Fin HS) (n : Ex HS) : RS := .rep C n (.push X (.lit 0))

/-! ## Padded slice programs -/

section pad

variable {M : MulSpec} {Ctx : IState HS → Prop}

/-- Drop the last `t − s` entries of the slice on `I` (via `Z`, counter `K`), then run `p`. -/
def padInP (I Z K rS rT : Fin HS) (p : RM) : RM :=
  RM.seqL [.rs (mvList I Z gCV (cnt2 rS)), .rs (popK I K (cdE rT rS)), .rs (mvList Z I gCV (cnt2 rS)),
    p]

/-- The side conditions of `padIn`. -/
structure PadInOk (I O Z K rS rT : Fin HS) : Prop where
  hIZ : I ≠ Z
  hIV : I ≠ gCV
  hZV : Z ≠ gCV
  hI55 : I.val < 55
  hZ55 : Z.val < 55
  hIK : I ≠ K
  hK56 : K.val < 56
  hS56 : rS.val < 56
  hT56 : rT.val < 56
  hSI : rS ≠ I
  hSZ : rS ≠ Z
  hTI : rT ≠ I
  hTZ : rT ≠ Z

/-- Push `t − s` zero entries on `O` (counter `K`), then run `p`. -/
def padOutP (O K rS rT : Fin HS) (p : RM) : RM := .seq (.rs (pushZ O K (cdE rT rS))) p

end pad

/-! ## Pushing and popping register lists -/

/-- Push the value of `e` onto `r`, for each `(r, e)` in order. -/
def pushL : List (Fin HS × Ex HS) → RS
  | [] => .skip
  | (r, e) :: l => .seq (.push r e) (pushL l)

/-- Pop every register of the list. -/
def popL : List (Fin HS) → RS
  | [] => .skip
  | r :: l => .seq (.pop r) (popL l)

/-- The well-formedness of a push list at `s`: distinct targets `< 56`, clean expressions
defined at `s` that read no target. -/
structure PushOk (l : List (Fin HS × Ex HS)) (s : IState HS) : Prop where
  nd : (l.map Prod.fst).Nodup
  lt : ∀ p ∈ l, p.1.val < 56
  cl : ∀ p ∈ l, p.2.Clean
  ok : ∀ p ∈ l, p.2.ok s
  rd : ∀ p ∈ l, ∀ q ∈ l, q.1 ∉ p.2.regs

/-- The registers of a pop list hold integers of size `≤ B` on top. -/
def PopOk (l : List (Fin HS)) (s : IState HS) (B : ℕ) : Prop :=
  l.Nodup ∧ ∀ r ∈ l, r.val < 56 ∧ ∃ (v : ℤ) (L : List Item), s.G r = .int v :: L ∧ zsz v ≤ B

end NLogN.KFY

end

