  rw [hχ 1, Nat.cast_one, one_pow, mul_one] at h1
  have hpos' : 0 < (letI := moduleSectionsOfHom f (𝓜 ⊗ Q) ⊤; Module.finrank k Γ(𝓜 ⊗ Q, ⊤)) := by
