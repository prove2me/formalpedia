variable {d : ℕ}
theorem solution (s t : Fin d → ℕ) [∀ i, NeZero (s i)]
    (hcop : ∀ i, Nat.Coprime (s i) (t i)) (b : ℕ) (ubar vbar : ((i : Fin d) → ZMod (s i)) → ℂ) :
    let S : ℂ := ∏ i, (s i : ℂ)
    let u := fun k => (2 : ℂ)⁻¹ ^ (b + 2) * ubar k
    let v := fun k => (2 : ℂ)⁻¹ ^ (b + 2) * vbar k
    (fun j => (2 : ℂ) ^ (2 * b + 4) * S * (S * IntMul.OpenAI.RT.Rperm s t (IntMul.OpenAI.RC.dftP s (fun k =>
        IntMul.OpenAI.RT.Rperm s t (IntMul.OpenAI.RT.dftM s u) k * IntMul.OpenAI.RT.Rperm s t (IntMul.OpenAI.RT.dftM s v) k)) j)) = IntMul.OpenAI.RC.cconv s ubar vbar := by
  intro S u v
  have hS : S ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => by exact_mod_cast NeZero.ne (s i))
  rw [IntMul.OpenAI.RC.lemma21_cancel s t hcop u v]
  funext j
  simp only [IntMul.OpenAI.RC.cconv, u, v]
  rw [Finset.sum_div, Finset.mul_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun k _ => ?_)
  have h2 : (2 : ℂ) ^ (2 * b + 4) * ((2 : ℂ)⁻¹ ^ (b + 2) * (2 : ℂ)⁻¹ ^ (b + 2)) = 1 := by
    rw [show 2 * b + 4 = (b + 2) + (b + 2) by ring, pow_add, inv_pow]
    field_simp
  change (2 : ℂ) ^ (2 * b + 4) * S * (S * ((2 : ℂ)⁻¹ ^ (b + 2) * ubar k *
    ((2 : ℂ)⁻¹ ^ (b + 2) * vbar (j - k)) / S ^ 2)) = ubar k * vbar (j - k)
  have h3 : S * S / S ^ 2 = 1 := by field_simp
  calc _ = ((2 : ℂ) ^ (2 * b + 4) * ((2 : ℂ)⁻¹ ^ (b + 2) * (2 : ℂ)⁻¹ ^ (b + 2))) *
        (S * S / S ^ 2) * (ubar k * vbar (j - k)) := by ring
    _ = _ := by rw [h2, h3]; ring
end
