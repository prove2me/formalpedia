    |(sample v j).1|≤(2:Int)^100 ∧ |(sample v j).2|≤(2:Int)^100 := by
  have hjv:j<v.length:=by omega
  have hjt:j<(v.take 1954).length:=by simp only [List.length_take];omega
  have hm:(v.take 1954)[j]∈v.take 1954:=List.getElem_mem hjt
  have hh:=of_decide_eq_true ((List.all_eq_true.mp h) _ hm)
  simp only [List.getElem_take] at hh
  simpa only [sample,List.getElem?_eq_getElem hjv,Option.getD_some,decode] using hh
