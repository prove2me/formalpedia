section
-- Source module: Solutions.KFMCall
/-!
# KFM: calling an interface procedure

`callW bld X Y dS e`: build a descriptor on `X` (above a mark), transfer it in order onto the
interface's descriptor stack `dS` (KFMSC `xfer`, scratch `Y`), `call e`, and drop it again
(`unxfer`). The interface sees `encK s' f` with `f 0` the data on top of stack `0`, `f dS` the
descriptor and every other `f j = []`; everything else (including the old contents of `dS`, under
a mark) is in the unmanaged part `s'`, which the interface preserves.

* `wS t dS R0`, `wF data desc dS`: that decomposition (`encK_wrap`).
* **`callW_runs`**: from an interface run on `encK (wS …) (wF …)` to a run of the wrapper that
  only replaces the data on top of stack `0`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul KIL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem wF_nil {data desc : List ℤ} {dS : Fin HS} : ∀ j, j ≠ 0 → j ≠ dS → wF data desc dS j = [] :=
  fun j h0 hd => by simp [wF, h0, hd]

theorem wF_dS {data desc : List ℤ} {dS : Fin HS} (hd : dS ≠ 0) : wF data desc dS dS = desc := by
  simp [wF, hd]

theorem wF_zero {data desc : List ℤ} {dS : Fin HS} : wF data desc dS 0 = data := by simp [wF]

theorem wF_update {data desc : List ℤ} {dS : Fin HS} (hd : dS ≠ 0) (data' : List ℤ) :
    Function.update (wF data desc dS) 0 data' = wF data' desc dS := by
  funext j; by_cases h : j = 0 <;> simp [wF, h, Function.update]

theorem encK_wF (t : IState HS) (dS : Fin HS) (hd : dS ≠ 0) (R0 : List Item) (data desc : List ℤ) :
    encK (wS t dS R0) (wF data desc dS) =
      (t.upd 0 (ints data ++ R0)).upd dS (ints desc ++ .mark :: t.G dS) := by
  refine IState.ext' (fun j => ?_) (by simp [wS]) (by simp [wS])
  by_cases h0 : j = 0
  · subst h0; simp [wS, wF, IState.upd_G, Ne.symm hd]
  · by_cases h1 : j = dS
    · subst h1; simp [wS, wF, IState.upd_G, h0]
    · simp [wS, wF, IState.upd_G, h0, h1, ints]

/-- **An interface call.** -/
theorem callW_runs (bld : RS) {X Y dS : Fin HS} (hXY : X ≠ Y) (hXd : X ≠ dS) (hYd : Y ≠ dS)
    (hd0 : dS ≠ 0) (hX0 : X ≠ 0) (e : Fin P) (t : IState HS) (data data' desc : List ℤ)
    (R0 : List Item) (h0 : t.G 0 = ints data ++ R0) (B : ℕ) (hB : ∀ x ∈ desc, zsz x ≤ B)
    (hok : bld.ok (t.upd X (.mark :: t.G X)))
    (hrun : bld.run (t.upd X (.mark :: t.G X)) =
      (t.upd X (.mark :: t.G X)).upd X (ints desc ++ .mark :: t.G X))
    {c : ℕ} (hI : IRuns I iprog (.call e) (encK (wS t dS R0) (wF data desc dS))
      (encK (wS t dS R0) (wF data' desc dS)) c) :
    IRuns I iprog (callW bld X Y dS e) t (t.upd 0 (ints data' ++ R0))
      (1 + bld.cost (t.upd X (.mark :: t.G X)) + (2 * desc.length * cMv B + 70) + c +
        (desc.length * cMv B + 31)) := by
  set t1 := t.upd X (.mark :: t.G X) with ht1
  have r1 : IRuns I iprog (.op (.mark X)) t t1 1 := IRuns.mark X
  have r2 := RS.code_runs (I := I) (iprog := iprog) bld t1 hok
  rw [hrun] at r2
  set t2 := t1.upd X (ints desc ++ .mark :: t.G X)
  have r3 := xfer_runs (I := I) (iprog := iprog) X Y dS hXY hXd hYd B desc hB t2 (t.G X)
    (by simp [t2])
  set t3 := (t2.upd X (t.G X)).upd dS (ints desc ++ .mark :: t2.G dS)
  have e3 : t3 = encK (wS t dS R0) (wF data desc dS) := by
    rw [encK_wF t dS hd0 R0 data desc]
    refine IState.ext' (fun j => ?_) (by simp [t3, t2, t1, wS]) (by simp [t3, t2, t1, wS])
    simp only [t3, t2, t1, IState.upd_G]
    split_ifs <;> simp_all
  rw [e3] at r3
  rw [encK_wF t dS hd0 R0 data' desc] at hI
  have r5 := unxfer_runs (I := I) (iprog := iprog) dS B desc hB
    ((t.upd 0 (ints data' ++ R0)).upd dS (ints desc ++ .mark :: t.G dS)) (t.G dS) (by simp)
  refine (r1.seq (r2.seq (r3.seq (hI.seq r5)))).mono' ?_ (by omega)
  refine IState.ext' (fun j => ?_) (by simp) (by simp)
  simp only [IState.upd_G]
  split_ifs <;> simp_all

end NLogN.KFM

end

section
-- Source module: Solutions.KFZChirpR
/-!
# KFZ: the per-call form of the chirp interface

`ChirpNeed` fixes `M̃r` per `n` before the input and the machine state, and asks the procedure to
output exactly `C̃(x) = chirpT p (mcT p M̃r θ̃ θ̃⁻) b̃ ã x`. With `P18IL` as the only source of
`M̃r`, this cannot be met. `P18IL` gives, for each initial state `encK s f` (unmanaged part `s`,
tail `l` on stack `0`), *some* run with *some* result `zh` within the Prop 18 bound. Nothing ties
the results of two different states together, and a `P18IL` procedure may legally read `s` or `l`
and restore it. The dependence on the input tape `Isym` can be removed (`KFZIsym`); the dependence
on `s` and `l` cannot. The obvious workaround, computing `mrX` exactly, is an integer product of
size `Θ(V)` and does not fit the `V · Ncost · polylog` budget.

This file gives the per-call statement and shows that it gives the chain everything it uses:

* **`ChirpNeedR`**: `ChirpNeed` with `∃ Mrt` (and its `ErC · hp` bound) moved after the input. The
  tables `θ̃, θ̃⁻, ã, b̃` and `ζ` stay fixed per `n` (they are explicit FM table outputs).
* **`ChirpNeed.toR`**: `ChirpNeed → ChirpNeedR`.
* **`chirp_call_err`**: for any `M̃r` with the Prop 18 bound and the fixed tables, one call
  satisfies `‖C̃ x − Q F_t x‖ ≤ (Er + 22) hp`, `‖C̃ x‖ ≤ 1`, `Grid p (C̃ x)`. These are exactly the
  conclusions `chain_close` uses about the chirp step (its `hCt`).
* **`pipeline_err3`**: `pipeline_err` with three separate computed values `F̃u`, `F̃v`, `F̃(z̄)`
  instead of one function `F̃`. This is what the assembly needs when every step is per call. The
  same applies to `LineNeed`'s `Ã, B̃₀`, whose outputs also depend on the state.
-/

namespace NLogN.KFZ

open IntMul KIL KFB IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.RC IntMul.OpenAI.Glue
  IntMul.OpenAI.RCost NLogN.KFM

noncomputable section

variable {D : ℕ}

/-- **One chirp call**: any `M̃r` within `Er · hp` of `mrX` on grid inputs, with the fixed phase
tables, gives the chirp-step guarantee of `chain_close` (`hCt`). -/
theorem chirp_call_err (p : ℕ) (s t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)]
    (ht : ∀ i, Even (t i)) (ζ : ℂ) (hζ : ζ ^ t (Fin.last D) = -1)
    {Mrt : (((i : Fin (D + 1)) → ZMod (t i)) → ℂ) → (((i : Fin (D + 1)) → ZMod (t i)) → ℂ) →
      (((i : Fin (D + 1)) → ZMod (t i)) → ℂ)}
    {θt θit at' bt : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ} (Er : ℝ)
    (hMrt : ∀ f g, Grid p f → Grid p g → ‖f‖ ≤ 1 → ‖g‖ ≤ 1 → ‖Mrt f g - mrX t f g‖ ≤ Er * hp p)
    (hθ : Phases p (twX t ζ) θt) (hθi : Phases p (fun j => (twX t ζ j)⁻¹) θit)
    (ha : Phases p (fun j => (starRingEnd ℂ) (chirp s t j)) at') (hb' : Phases p (chirp s t) bt)
    (hbg : Grid p bt) (hEr : Er * hp p ≤ 1 / 10)
    {x : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ} (hx : ‖x‖ ≤ 6 / 10) :
    ‖chirpT p (mcT p Mrt θt θit) bt at' x - Qperm s t (dftM t x)‖ ≤ (Er + 22) * hp p ∧
      ‖chirpT p (mcT p Mrt θt θit) bt at' x‖ ≤ 1 ∧
      Grid p (chirpT p (mcT p Mrt θt θit) bt at' x) := by
  have h0 := hp_pos p
  set MC : (((i : Fin (D + 1)) → ZMod (t i)) → ℂ) → (((i : Fin (D + 1)) → ZMod (t i)) → ℂ) →
      (((i : Fin (D + 1)) → ZMod (t i)) → ℂ) :=
    fun f g => (fun j => (twX t ζ j)⁻¹) * mrX t (twX t ζ * f) (twX t ζ * g) with hMC
  have hMCb : BilC MC := bilC_twist (bilC_mrX t) hθ.e hθi.e
  have hMCt : ∀ f g, Grid p f → Grid p g → ‖f‖ ≤ 1 → ‖g‖ ≤ 7 / 10 →
      ‖mcT p Mrt θt θit f g - MC f g‖ ≤ (Er + 12) * hp p ∧ ‖mcT p Mrt θt θit f g‖ ≤ 1 := by
    intro f g _ _ hf hg
    obtain ⟨e1, e2⟩ := mc_err p (bilC_mrX t) Er hMrt hθ hθi hf hg (hEr.trans (by norm_num))
    exact ⟨e1, e2.trans (by linarith)⟩
  obtain ⟨e1, e2⟩ := chirp_err p hMCb (Er + 12) hMCt ha hb' hbg hx
  refine ⟨?_, e2, QA_grid _ _⟩
  have hQ : (fun j => (starRingEnd ℂ) (chirp s t j)) *
      MC (chirp s t) ((fun j => (starRingEnd ℂ) (chirp s t j)) * x) = Qperm s t (dftM t x) := by
    show (fun j => (starRingEnd ℂ) (chirp s t j)) *
      ((fun j => (twX t ζ j)⁻¹) * mrX t (twX t ζ * chirp s t)
        (twX t ζ * ((fun j => (starRingEnd ℂ) (chirp s t j)) * x))) = Qperm s t (dftM t x)
    rw [mc_exact t ζ hζ]
    exact chirp_exact s t ht x
  rw [← hQ]
  calc _ ≤ (Er + 12 + 10) * hp p := e1
    _ = _ := by ring

end

end NLogN.KFZ

end

section
-- Source module: Solutions.KFMRep
/-!
# KFM: arrays as lists and as box functions

The machine holds the arrays of the chain as row-major lists of Gaussian integers (numerators
at scale `2^p`); `LineNeed`/`ChirpNeedR` relate them to box functions by `RepPad`/`RepFull`.
Here the box function of a list is made explicit, so every list the machine produces names its
function:

* `kL K`: the coordinates of a box point as a list; `boxIx` is `decode` (`digL_decode`).
* **`funF p t zs`** (full `t`-box) and **`funP p s t zs`** (the `s`-box read out of the padded
  `t`-box): `toC (zs[enc K]) / 2^p`.
* **`repFull_iff`**, **`repPad_iff`**: a list represents exactly its own function (so the function
  a call returns is determined by the returned list).
* `grid_funF`, `grid_funP`: these functions are on the grid of `Q_p`.
* Pointwise list maps: **`RepPad.smul`** (`g z = c·z`, e.g. `× 2^γ`), **`RepPad.conj`**,
  **`RepPad.gmul`** (`zipWith (gmulT p)` is `Q_p(u · v)`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul KIL KFB IntMul.HvdH AModel Complex

noncomputable section

/-! ## Coordinates -/

theorem digL_decode : ∀ (ts : List ℕ) (x i : ℕ), digL ts x i = (decode ts x).getD i 0
  | [], _, _ => by simp [digL, decode]
  | t :: ts, x, 0 => by simp [digL, decode, vol]
  | t :: ts, x, i + 1 => by simp [digL, decode, vol, digL_decode ts]

variable {d : ℕ}

theorem decode_ofFn (t : Fin d → ℕ) (x : ℕ) :
    decode (List.ofFn t) x = List.ofFn fun i => boxIx t x i := by
  apply List.ext_getElem (by simp [length_decode])
  intro k h1 h2
  simp only [List.getElem_ofFn, boxIx, digL_decode, List.getD_eq_getElem?_getD,
    List.getElem?_eq_getElem h1, Option.getD_some]

theorem valid_kL {s t : Fin d → ℕ} [∀ i, NeZero (s i)] (hst : ∀ i, s i ≤ t i)
    (k : (i : Fin d) → ZMod (s i)) : Valid (List.ofFn t) (kL k) := by
  rw [valid_iff]
  refine ⟨by simp [kL], fun j h1 h2 => ?_⟩
  simp only [kL, List.getElem_ofFn]
  exact lt_of_lt_of_le (ZMod.val_lt _) (hst _)

theorem boxIx_encode {s t : Fin d → ℕ} [∀ i, NeZero (s i)] (hst : ∀ i, s i ≤ t i)
    (k : (i : Fin d) → ZMod (s i)) (i : Fin d) :
    boxIx t (encode (List.ofFn t) (kL k)) i = (k i).val := by
  have h := decode_encode (valid_kL hst k)
  rw [decode_ofFn] at h
  have := congrArg (fun l => l.getD i.val 0) h
  simpa [kL, List.getD_eq_getElem?_getD] using this

theorem kL_cast {s : Fin d → ℕ} [∀ i, NeZero (s i)] (v : Fin d → ℕ) (hv : ∀ i, v i < s i) :
    kL (fun i => ((v i : ℕ) : ZMod (s i))) = List.ofFn v := by
  simp only [kL]
  congr 1; funext i
  rw [ZMod.val_natCast, Nat.mod_eq_of_lt (hv i)]

theorem encode_boxIx (t : Fin d → ℕ) {x : ℕ} (hx : x < (List.ofFn t).prod) :
    encode (List.ofFn t) (List.ofFn fun i => boxIx t x i) = x := by
  rw [← decode_ofFn]; exact encode_decode hx

/-! ## The function of a list -/

theorem gC_eq_toC (z : GI) : gC z = toC z := rfl

theorem two_pow_ne (p : ℕ) : (2 : ℂ) ^ p ≠ 0 := pow_ne_zero _ two_ne_zero

theorem repPad_iff {p : ℕ} {s t : Fin d → ℕ} [∀ i, NeZero (s i)] (hst : ∀ i, s i ≤ t i)
    {zs : List GI} (u : ((i : Fin d) → ZMod (s i)) → ℂ) :
    RepPad p s t zs u ↔ (zs.length = (List.ofFn t).prod ∧ PadZ s t zs) ∧ u = funP p s t zs := by
  constructor
  · rintro ⟨hl, h⟩
    refine ⟨⟨hl, fun x hx hn => (h x hx).2 hn⟩, ?_⟩
    funext k
    have hv := valid_kL hst k
    have hx := encode_lt hv
    have hlt : ∀ i, boxIx t (encode (List.ofFn t) (kL k)) i < s i := fun i => by
      rw [boxIx_encode hst k i]; exact ZMod.val_lt _
    have e := (h _ hx).1 hlt
    have hK : (fun i => ((boxIx t (encode (List.ofFn t) (kL k)) i : ℕ) : ZMod (s i))) = k := by
      funext i; rw [boxIx_encode hst k i, ZMod.natCast_zmod_val]
    rw [hK, gC_eq_toC] at e
    rw [funP, e]; field_simp [two_pow_ne p]
  · rintro ⟨⟨hl, hz⟩, rfl⟩
    refine ⟨hl, fun x hx => ⟨fun hs => ?_, hz x hx⟩⟩
    rw [funP, kL_cast _ hs, encode_boxIx t hx, gC_eq_toC]
    field_simp [two_pow_ne p]

/-! ## Grid -/

/-! ## Pointwise maps -/

theorem toC_inj {a b : GI} (h : toC a = toC b) : a = b := by
  have h1 := congrArg Complex.re h
  have h2 := congrArg Complex.im h
  simp [toC] at h1 h2
  exact Prod.ext h1 h2

theorem toC_eq_zero {a : GI} (h : toC a = 0) : a = 0 := toC_inj (by rw [h, toC_zero])

theorem getD_map0 (g : GI → GI) (hg : g 0 = 0) (l : List GI) (x : ℕ) :
    (l.map g).getD x 0 = g (l.getD x 0) := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_map]
  cases l[x]? <;> simp [hg]

theorem padZ_map {s t : Fin d → ℕ} {zs : List GI} (g : GI → GI) (hg : g 0 = 0)
    (h : PadZ s t zs) : PadZ s t (zs.map g) := by
  intro x hx hn
  rw [getD_map0 g hg, h x hx hn, hg]

theorem funP_map (p : ℕ) (s t : Fin d → ℕ) {zs : List GI} (g : GI → GI) (hg : g 0 = 0)
    (k : (i : Fin d) → ZMod (s i)) :
    funP p s t (zs.map g) k = toC (g (zs.getD (encode (List.ofFn t) (kL k)) 0)) / 2 ^ p := by
  rw [funP, getD_map0 g hg]

/-- A scalar map `g z = c·z` on the numerators. -/
theorem RepPad.smul {p : ℕ} {s t : Fin d → ℕ} [∀ i, NeZero (s i)] (hst : ∀ i, s i ≤ t i)
    {zs : List GI} {u : ((i : Fin d) → ZMod (s i)) → ℂ} (h : RepPad p s t zs u)
    (g : GI → GI) (c : ℂ) (hg : ∀ z, toC (g z) = c * toC z) :
    RepPad p s t (zs.map g) (fun k => c * u k) := by
  have hg0 : g 0 = 0 := toC_eq_zero (by rw [hg, toC_zero, mul_zero])
  obtain ⟨⟨hl, hz⟩, rfl⟩ := (repPad_iff hst u).1 h
  refine (repPad_iff hst _).2 ⟨⟨by simp [hl], padZ_map g hg0 hz⟩, ?_⟩
  funext k
  rw [funP_map p s t g hg0, hg, funP]; ring

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMHT
/-!
# KFM: parameter registers and the pass wrappers of `bigE`

`bigE` keeps its run-time parameters on its own stacks `6–19`, one value on top of each (the
*registers* below). A uniform pass reads its counts and constants from the fixed stacks
`nX, nX2, pR, pX2, pX3`. The wrapper `withD src dst p` copies the top of `src` onto `dst`, runs
`p` and drops the copy again. So every wrapped pass changes only stack `0`.

* **`withD_runs`**: the frame rule of the wrapper.
* `Hold t r a`: the top of stack `r` is the integer `a`.
* The wrapped passes **`shlW_runs`**, **`roundW_runs`**, **`smulW_runs`**, **`gmulW_runs`**,
  **`conjW_runs`**. Each runs from any state whose registers hold the right values, and its final
  state differs from the initial one only on stack `0` (`gmulW` also pops `pW`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFM

open IntMul KIL KFT KFB

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## Registers of `bigE` -/

theorem Hold.upd {t : IState HS} {r : Fin HS} {a : ℤ} (h : Hold t r a) (j : Fin HS) (hj : j ≠ r)
    (L : List Item) : Hold (t.upd j L) r a := by
  obtain ⟨L', h'⟩ := h
  exact ⟨L', by simp [IState.upd_G, Ne.symm hj, h']⟩

/-! ## The wrapper -/

theorem withD_runs {src dst : Fin HS} (hsd : src ≠ dst) (hd0 : dst ≠ 0) {p : IStmt HS P}
    {t : IState HS} {a : ℤ} (hs : Hold t src a) {X : List Item} {c : ℕ}
    (hp : IRuns I iprog p (t.upd dst (.int a :: t.G dst))
      ((t.upd dst (.int a :: t.G dst)).upd 0 X) c) :
    IRuns I iprog (withD src dst p) t (t.upd 0 X) (c + cW a) := by
  obtain ⟨L, hL⟩ := hs
  have r1 := IRuns.dup (I := I) (iprog := iprog) hsd hL
  have r3 := IRuns.drop (I := I) (iprog := iprog)
    (s := (t.upd dst (.int a :: t.G dst)).upd 0 X) (i := dst) (a := a) (L := t.G dst)
    (by simp [IState.upd_G, hd0])
  refine (r1.seq (hp.seq r3)).mono' ?_ (by unfold cW; omega)
  refine IState.ext' (fun j => ?_) (by simp) (by simp)
  simp only [IState.upd_G]
  split_ifs <;> simp_all

/-! ## Wrapped passes -/

theorem shlW_runs {src : Fin HS} (hs1 : src ≠ nX) (hs2 : src ≠ pR) (γ w : ℕ) (t : IState HS)
    (L : List ℤ) (R0 : List Item) (h0 : t.G 0 = ints L ++ R0) (hw : ∀ x ∈ L, zsz x ≤ w)
    (hT : Hold t rT2 (L.length : ℤ)) (hG : Hold t src (2 ^ γ)) :
    IRuns I iprog (shlW src) t (t.upd 0 (ints (L.map (· * 2 ^ γ)) ++ R0))
      (cItem L.length (1000 * (w + γ + 2)) (w + γ + 1) + 2 * cCnt L.length +
        cW (2 ^ γ) + cW (L.length : ℤ)) := by
  refine withD_runs (by decide) (by decide) hT ?_
  refine withD_runs hs2 (by decide) (hG.upd nX (Ne.symm hs1) _) ?_
  exact shlPU_runs (I := I) (iprog := iprog) γ w _ L R0 (t.G pR) (by simp +decide [IState.upd_G, h0])
    (by simp +decide [IState.upd_G]) hw (t.G nX) (by simp +decide [IState.upd_G])

end NLogN.KFM

end

