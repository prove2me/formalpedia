-- Source module: Solutions.KFGPairW
/-!
# KFG: the self-contained pair pass on roles `i < j`, and the scaled role encoding

* `pairW M L i j`: pushes the counts (`L`, `2L`, `2iL`, `2(j-i-1)L`), runs `pairP M`, pops.
  `pairW_fsp`: on a clean managed state, stack `0` holding a role-major array `zs` (role length
  `L`), the result is `pairL M L i j zs`; cost `cPairW`.  `fok_pairW`: it compiles finely.
* `getD_pairL`: index semantics.
* `Enc W L e zs y`: `zs` encodes the role streams `y w p` (`w < W`, `p < L`) with per-role scale
  `2^{-e w}`: `toC zs[w L + p] = 2^{e w} y w p`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFG

open IntMul RS AModel KIL KFD KFB Complex

/-! ## Compilability -/

/-! ## The wrapper -/

/-- The pair pass on roles `i < j` of a role-major array with role length `L`. -/
def pairW (M : M2S) (L i j : ℕ) : RS :=
  .seq (.push NLogN.KFB.rB (.lit (L : ℤ))) (.seq (.push rB2 (.lit ((2 * L : ℕ) : ℤ)))
  (.seq (.push NLogN.KFB.rP (.lit ((2 * (i * L) : ℕ) : ℤ))) (.seq (.push rQ (.lit ((2 * ((j - i - 1) * L) : ℕ) : ℤ)))
  (.seq (pairP M) (.seq (.pop NLogN.KFB.rB) (.seq (.pop rB2) (.seq (.pop NLogN.KFB.rP) (.pop rQ))))))))

/-- Clean scratch of the pair pass. -/
structure ClP (f : Fin HS → List ℤ) : Prop where
  scr : Scr f
  a : f qA = []
  p : f qP = []
  q : f qQ = []
  b : f NLogN.KFB.rB = []
  b2 : f rB2 = []
  rp : f NLogN.KFB.rP = []
  rq : f rQ = []

/-- List semantics of the pair pass on roles `i < j`. -/
def pairL (M : M2S) (L i j : ℕ) (zs : List GI) : List GI :=
  zs.take (i * L) ++ (List.zipWith (lin2S M.a M.b) ((zs.drop (i * L)).take L) ((zs.drop (j * L)).take L) ++
    ((zs.drop ((i + 1) * L)).take ((j - i - 1) * L) ++
      (List.zipWith (lin2S M.c M.d) ((zs.drop (i * L)).take L) ((zs.drop (j * L)).take L) ++
        zs.drop ((j + 1) * L))))

/-- Cost of the wrapper. -/
def cPairW (w D L i j Z : ℕ) : ℕ :=
  cPair w D L (i * L) ((j - i - 1) * L) + 4 * (4000 * (Z + 2) + 2 * Z + 2)

end NLogN.KFG

end

