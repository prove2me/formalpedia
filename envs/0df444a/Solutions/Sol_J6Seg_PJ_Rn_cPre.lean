theorem natB {a W : ℕ} (h : a ≤ 2 ^ W) : |(a : ℤ)| ≤ 2 ^ W := by
  rw [abs_of_nonneg (by positivity)]; exact_mod_cast h

/-- **Before the chunk store.** -/
theorem Rn.cPre_sol_aux {pkA pkC bA bC kA kC wA wC pre post s t p α d W : ℕ} {c : Cs} (hcL : c cLC = [])
    {v : Vr} (hv : BV W v) (hP : ParV kA kC wA wC pre post s t p α d v)
    (bpk : pkA * segPF p d s + pkC ≤ 2 ^ W) (bb : bA * segPF p d s + bC ≤ 2 ^ W)
    (bl : pkA + pkC + bA + bC + 2 ≤ 2 ^ W) (blam : 2 * lamP d + 2 < 2 ^ W) :
    Rn (cPreP pkA pkC bA bC) v c (fun v' =>
      v' 5 = ((2 ^ Nat.clog 2 (lamP d) : ℕ) : ℤ) ∧ v' 6 = (Nat.clog 2 (lamP d) : ℤ) ∧
      v' 26 = ((pkA * segPF p d s + pkC : ℕ) : ℤ) ∧ v' 28 = ((bA * segPF p d s + bC : ℕ) : ℤ) ∧
      v' 29 = ((t / lamP d : ℕ) : ℤ) ∧
      (∀ j : Fin HS, j ≠ 5 → j ≠ 6 → j ≠ 26 → j ≠ 28 → j ≠ 29 → v' j = v j) ∧ BV W v')
      (update c sSt (((2 ^ Nat.clog 2 (lamP d) : ℕ) : ℤ) :: (Nat.clog 2 (lamP d) : ℤ) ::
        ((wA * segPF p d s + wC : ℕ) : ℤ) :: (post : ℤ) :: (pre : ℤ) :: c sSt))
      (cCPre pkA pkC bA bC W 0 (lamP d)) := by
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h9, h10, h11, h12, h20, h21, h22, h23, h24, h25, h26⟩ := hP
  have hpos : (0 : ℤ) ≤ 2 ^ W := by positivity
  have htl : t / lamP d ≤ t := Nat.div_le_self _ _
  have bt : |v 23| ≤ 2 ^ W := hv 23 (by decide)
  rw [h23] at bt
  have hdv : (t : ℤ) / (lamP d : ℤ) = ((t / lamP d : ℕ) : ℤ) := by push_cast; rfl
  have k1 : (pkA : ℤ) * v 20 + pkC = ((pkA * segPF p d s + pkC : ℕ) : ℤ) := by rw [h20]; push_cast; ring
  have k2 : (bA : ℤ) * v 20 + bC = ((bA * segPF p d s + bC : ℕ) : ℤ) := by rw [h20]; push_cast; ring
  have k3 : v 23 / v 24 = ((t / lamP d : ℕ) : ℤ) := by rw [h23, h24, hdv]
  have a1 : |(pkA : ℤ) * v 20 + pkC| ≤ 2 ^ W := by rw [k1]; exact natB bpk
  have a2 : |(bA : ℤ) * v 20 + bC| ≤ 2 ^ W := by rw [k2]; exact natB bb
  have a3 : |v 23 / v 24| ≤ 2 ^ W := by
    rw [k3]; exact natB (le_trans htl (by exact_mod_cast (le_trans (le_abs_self _) bt)))
  have o1 := cPre1_ok pkA pkC bA bC v c hv bl a1 a2 a3
  have r1 := Rn.insL (N := 0) (by omega) (cPre1 pkA pkC bA bC) hv o1
  unfold cPreP cCPre
  refine Rn.seq r1 (fun v1 ⟨e1, b1⟩ => ?_)
  rw [cPre1_run] at e1 ⊢
  subst e1
  dsimp only at b1 ⊢
  refine Rn.seq (clL b1 (by simp [update_apply]) (by simp [update_apply])
    (by simp [update_apply, h24]) blam (by rw [update_of_ne (by decide)]; exact hcL)) (fun v2 ⟨e2, b2⟩ => ?_)
  subst e2
  have o2 : OkL W 0 cPre2 (update (update (update (update (update (update (update v 26
      (↑pkA * v 20 + ↑pkC)) 28 (↑bA * v 20 + ↑bC)) 29 (v 23 / v 24)) 5 1) 6 0) 6
      (Nat.clog 2 (lamP d) : ℤ)) 5 ((2 ^ Nat.clog 2 (lamP d) : ℕ) : ℤ),
      update c sSt (v 7 :: v 4 :: v 3 :: c sSt)) := by
    simp only [cPre2, OkL, Ins.ok, Ins.run]
    exact ⟨⟨by decide, by decide, rfl, by simp [E.lb]; omega⟩,
      ⟨by decide, by decide, rfl, by simp [E.lb]; omega⟩, trivial⟩
  have r3 := Rn.insL (N := 0) (by omega) cPre2 b2 o2
  rw [cPre2_run] at r3
  dsimp only at r3

  rw [update_idem (f := c), update_self] at r3
  simp only [update_apply, Fin.reduceEq, reduceIte, ↓reduceIte] at r3
  rw [← h7, ← h4, ← h3]
  refine r3.mono (fun v3 ⟨e3, b3⟩ => ?_) le_rfl
  subst e3
  refine ⟨by simp [update_apply], by simp [update_apply], ?_, ?_, ?_, ?_, b3⟩
  · simp [update_apply, k1]
  · simp [update_apply, k2]
  · simp [update_apply, k3]
  · intro j a5 a6 a26 a28 a29
    simp [update_apply, a5, a6, a26, a28, a29]

