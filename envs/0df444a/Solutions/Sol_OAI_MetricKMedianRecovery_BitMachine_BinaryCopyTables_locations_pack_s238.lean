lemma head_set (H : Finset (Fin n)) (hH : H.Nonempty) : head (BinaryFinSet.encode H)=(H.min' hH).val.bits := by
  rw [BinaryFinSet.encode_eq]
  have hn : H.sort (·≤·)≠[] := by
