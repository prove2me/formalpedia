  have hM : 2 ^ Z * 1024 ≤ 2 ^ Z * 2 ^ Z := Nat.mul_le_mul_left _ hbig
  have hM2 : 2 ^ Z * 2 ^ Z * 1024 ≤ 2 ^ Z * 2 ^ Z * 2 ^ Z := Nat.mul_le_mul_left _ hbig
