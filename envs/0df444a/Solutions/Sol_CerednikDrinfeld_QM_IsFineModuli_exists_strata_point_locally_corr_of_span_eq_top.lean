theorem isIso_of_isPullbackVia_id {S : Type} [CommRing S] (A A' : FakeEllipticCurve Λ N S) (uA : A'.A ⟶ A.A)
    (huA : FakeEllipticCurve.IsPullbackVia (RingHom.id _) A A' uA) : IsIso uA := by
  obtain ⟨sq, -⟩ := huA
  have : IsIso (Spec.map (CommRingCat.ofHom (RingHom.id S))) := by
    rw [CommRingCat.ofHom_id, Spec.map_id]; infer_instance
  exact isIso_of_isPullback_of_isIso _ _ _ _ sq

theorem finrank_act_eq_of_isPullbackVia_id {S : Type} [CommRing S] (A A' : FakeEllipticCurve Λ N S) (uA : A'.A ⟶ A.A)
    (huA : FakeEllipticCurve.IsPullbackVia (RingHom.id _) A A' uA) (x : ↥Λ)
    [IsFinite (A.act x)] [Flat (A.act x)] (y' : ↥A'.A) :
    (A'.act x).finrank y' = (A.act x).finrank (uA.base y') := by
  haveI := isIso_of_isPullbackVia_id A A' uA huA
  obtain ⟨-, -, hΛ, -⟩ := huA
  haveI : Flat (A'.act x) := by
    have e : A'.act x = (uA ≫ A.act x) ≫ inv uA := by rw [← hΛ x]; simp
    rw [e]; infer_instance
  haveI : IsFinite (A'.act x) := by
    have e : A'.act x = (uA ≫ A.act x) ≫ inv uA := by rw [← hΛ x]; simp
    rw [e]; infer_instance
  rw [← finrank_comp_right_of_isIso (A'.act x) uA y', hΛ x, Scheme.Hom.finrank_comp_left_of_isIso]

theorem isIso_of_comp_gb_eq {r : ℕ} {𝒪 : Type} [CommRing 𝒪] {π : 𝒪} {Onr : Type} [CommRing Onr] [Algebra 𝒪 Onr]
    {A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})}
    {L : Type} [CommRing L] [Algebra 𝒪 L] {ψL ψL' : Onr →ₐ[𝒪] L} {E E' : FakeEllipticCurve Λ N L}
    (ϱ : FakeEllipticCurve.Rigidification r π A₀ ψL E) (ϱ' : FakeEllipticCurve.Rigidification r π A₀ ψL' E')
    (i₀ : E.A ≅ E'.A) (hi : i₀.hom ≫ E'.f = E.f)
    (ib : ϱ.Eb.A ⟶ ϱ'.Eb.A) (hib : ib ≫ ϱ'.gb = ϱ.gb ≫ i₀.hom) (hibf : ib ≫ ϱ'.Eb.f = ϱ.Eb.f) : IsIso ib := by
  obtain ⟨sqb, -⟩ := ϱ.isPullback_Eb
  obtain ⟨sqb', -⟩ := ϱ'.isPullback_Eb
  have w1 : (ϱ'.gb ≫ i₀.inv) ≫ E.f =
      ϱ'.Eb.f ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 L π}))) := by
    rw [Category.assoc, ← hi, i₀.inv_hom_id_assoc, sqb'.w]
  refine ⟨⟨sqb.lift (ϱ'.gb ≫ i₀.inv) ϱ'.Eb.f w1, ?_, ?_⟩⟩
  · apply sqb.hom_ext
    · rw [Category.assoc, sqb.lift_fst, ← Category.assoc, hib, Category.assoc, i₀.hom_inv_id,
        Category.comp_id, Category.id_comp]
    · rw [Category.assoc, sqb.lift_snd, hibf, Category.id_comp]
  · apply sqb'.hom_ext
    · rw [Category.assoc, hib, ← Category.assoc, sqb.lift_fst, Category.assoc, i₀.inv_hom_id,
        Category.comp_id, Category.id_comp]
    · rw [Category.assoc, hibf, sqb.lift_snd, Category.id_comp]

theorem finrank_eq_of_corr_noShift {r : ℕ} [Fact r.Prime] {𝒪 : Type} [CommRing 𝒪] {π : 𝒪} {Onr : Type} [CommRing Onr] [Algebra 𝒪 Onr]
    (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    {A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})}
    {L : Type} [CommRing L] [Algebra 𝒪 L] {ψL ψL' : Onr →ₐ[𝒪] L} {E E' : FakeEllipticCurve Λ N L}
    (ϱ : FakeEllipticCurve.Rigidification r π A₀ ψL E) (ϱ' : FakeEllipticCurve.Rigidification r π A₀ ψL' E')
    (i₀ : E.A ≅ E'.A) (hi : i₀.hom ≫ E'.f = E.f)
    (ib : ϱ.Eb.A ⟶ ϱ'.Eb.A) (hib : ib ≫ ϱ'.gb = ϱ.gb ≫ i₀.hom) (hibf : ib ≫ ϱ'.Eb.f = ϱ.Eb.f)
    (uA : ϱ'.Ab.A ⟶ ϱ.Ab.A) (huA : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ϱ.Ab ϱ'.Ab uA) (huAg : uA ≫ ϱ.gA = ϱ'.gA)
    (h : ib ≫ ϱ'.φ ≫ uA = ϱ.φ) (y' : ↥ϱ'.Ab.A) :
    ϱ'.φ.finrank y' = ϱ.φ.finrank (uA.base y') := by
  obtain ⟨hφ'fin, hφ'fl, -, -⟩ := FakeEllipticCurve.isFinite_flat_surjective_of_isIsogenyPair hΛℤ r ϱ'.d _
    ϱ'.Eb ϱ'.Ab ϱ'.φ ϱ'.φ' ϱ'.isIsogenyPair
  haveI := isIso_of_isPullbackVia_id ϱ.Ab ϱ'.Ab uA huA
  haveI := isIso_of_comp_gb_eq ϱ ϱ' i₀ hi ib hib hibf
  rw [← h, Scheme.Hom.finrank_comp_left_of_isIso, finrank_comp_right_of_isIso]

theorem act_comm_act_rpow {S : Type} [CommRing S] (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ) (A : FakeEllipticCurve Λ N S)
    (r k : ℕ) (x : ↥Λ) :
    A.act x ≫ A.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = A.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩ ≫ A.act x := by
  have hmem : ((((r ^ k : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) * (x : ℍ[ℚ, a, b]) ∈ Λ := by
    rw [coe_mul_eq_smul, Int.cast_smul_eq_zsmul]
    exact Λ.smul_mem _ x.2
  have hmem' : (x : ℍ[ℚ, a, b]) * ((((r ^ k : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
    rw [← coe_commutes]; exact hmem
  rw [← A.act_mul _ _ hmem, ← A.act_mul _ _ hmem']
  congr 1
  exact Subtype.ext (coe_commutes _ _)

private theorem _root_.GPShift.RankKit.isIsogenyPair_act_rpow {S : Type} [CommRing S] (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    (A : FakeEllipticCurve Λ N S) (r k : ℕ) :
    FakeEllipticCurve.IsIsogenyPair (r ^ (2 * k)) A A
      (A.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩) (A.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩) := by
  refine ⟨A.act_over _, A.act_over _, fun t P Q => A.act_hom _ t P Q, fun t P Q => A.act_hom _ t P Q,
    fun x => act_comm_act_rpow hΛℤ A r k x, fun x => act_comm_act_rpow hΛℤ A r k x, fun hd => ?_⟩
  have hmem : ((((r ^ k : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) * ((((r ^ k : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
    rw [← coe_mul]; exact_mod_cast hΛℤ ((r ^ k : ℕ) * (r ^ k : ℕ) : ℕ)
  have heq : A.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩ ≫ A.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩ =
      A.act ⟨((r ^ (2 * k) : ℕ) : ℚ), hd⟩ := by
    rw [← A.act_mul _ _ hmem]
    congr 1
    apply Subtype.ext
    show (((r ^ k : ℕ) : ℤ) : ℚ) * ((((r ^ k : ℕ) : ℤ) : ℚ) : ℍ[ℚ, a, b]) = (((r ^ (2 * k) : ℕ) : ℚ) : ℍ[ℚ, a, b])
    rw [← coe_mul]
    congr 1
    push_cast
    ring
  exact ⟨heq, heq⟩

