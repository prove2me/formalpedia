/-- The first `L` coefficients of a polynomial are stored at `B`. -/
def PolynomialStored {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (m : ℕ → ℕ) (B L : ℕ) (p : F[X]) : Prop :=
  ∀ i < L, m (B + i) = enc b (p.coeff i)

def boundaryState (pc : ℕ) (m : ℕ → ℕ) : RAMState := ⟨pc, fun _ => 0, m⟩

def MemoryFrame (allowed : ℕ → Prop) (before after : ℕ → ℕ) : Prop :=
  ∀ addr, ¬ allowed addr → after addr = before addr

/-- A field-valued vector stored in consecutive RAM words. -/
def FieldArrayStored {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (m : ℕ → ℕ) (B len : ℕ) (v : ℕ → F) : Prop :=
  ∀ j < len, m (B + j) = enc b (v j)

