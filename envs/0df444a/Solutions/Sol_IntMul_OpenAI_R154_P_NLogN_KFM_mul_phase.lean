theorem ftil_phase (hp₂ : ∀ j, iprog (g₂ j) = (kTable ext₂ j).ren id g₂)
    (hp₃ : ∀ j, iprog (g₃ j) = (kTable ext₃ j).ren id g₃)
    {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R154.dP n = D + 1)
    [instS : ∀ i, NeZero (sBD n D i)] [instT : ∀ i, NeZero (tBD n D i)]
    (hst : ∀ i, sBD n D i ≤ tBD n D i) (ht : ∀ i, Even (tBD n D i))
    (M : AxisMaps (d := D + 1) (pP n) (αP n) (sBD n D) (tBD n D))
    (hεA : epsA (pP n) (αP n) (D + 1) * hp (pP n) ≤ 1 / 10)
    (hEr : ErC n D * hp (pP n) ≤ 1 / 10)
    {eA eB : Fin (7 + P₂)} {dSL : Fin HS} {C₀ : ℝ} {A : ℕ} (hdL : dSL ≠ 0)
    (hL : lineG Isym ext₂ eA eB dSL C₀ A n (D + 1))
    {eC : Fin (7 + P₃)} {dSC : Fin HS} {C₁ : ℝ} {A₁ : ℕ} (hdC : dSC ≠ 0)
    {θt θit at' bt : ((i : Fin (D + 1)) → ZMod (tBD n D i)) → ℂ} {ζ : ℂ}
    (hζ : ζ ^ tBD n D (Fin.last D) = -1)
    (hθ : Phases (pP n) (twX (tBD n D) ζ) θt)
    (hθi : Phases (pP n) (fun j => (twX (tBD n D) ζ j)⁻¹) θit)
    (ha : Phases (pP n) (fun j => (starRingEnd ℂ) (chirp (sBD n D) (tBD n D) j)) at')
    (hb' : Phases (pP n) (chirp (sBD n D) (tBD n D)) bt) (hbg : Grid (pP n) bt)
    (hC : chirpGN Isym ext₃ eC dSC C₁ A₁ n D θt θit at' bt)
    (BL BC : ℕ) (hBL : ∀ x ∈ descLineN n, zsz x ≤ BL) (hBC : ∀ x ∈ descChirpN n, zsz x ≤ BC)
    (t : IState HS) (hR : BaseOK t n) (zs : List GI)
    (u : ((i : Fin (D + 1)) → ZMod (sBD n D i)) → ℂ) (R0 : List Item)
    (h0 : t.G 0 = ints (gflat zs) ++ R0)
    (hu : RepPad (pP n) (sBD n D) (tBD n D) zs u) (hu1 : ‖u‖ ≤ 1 / 2) :
    ∃ (zs' : List GI) (U : ((i : Fin (D + 1)) → ZMod (sBD n D i)) → ℂ) (c : ℕ),
      IRuns Isym iprog (ftilP g₂ g₃ eA eB eC dSL dSC) t (t.upd 0 (ints (gflat zs') ++ R0)) c ∧
      RepPad (pP n) (sBD n D) (tBD n D) zs' U ∧
      NLogN.KFB.GB (pP n + 2 + (2 * (D + 1) * αP n ^ 2 + 1)) zs' ∧
      ‖U - Rperm (sBD n D) (tBD n D) (dftM (sBD n D) u)‖ ≤ EsN n D * hp (pP n) ∧
      (c : ℝ) ≤ kLine n BL C₀ A + kChirp n BC C₁ A₁ + kLine n BL C₀ A + kShl n D := by
  set γ := 2 * (D + 1) * αP n ^ 2 with hγ
  -- A lines
  obtain ⟨zs1, w, c1, r1, hw, hg1, hMw, hc1⟩ :=
    lineA_phase hp₂ hn hdL hL BL hBL t hR zs u R0 h0 hu hu1
  have nw := w_small (pP n) (αP n) (sBD n D) (tBD n D) M _ hεA hu1 (hMw M)
  -- chirp
  set t1 := t.upd 0 (ints (gflat zs1) ++ R0) with ht1
  have hR1 : BaseOK t1 n := hR.upd 0 (by decide) _
  obtain ⟨Mrt, hMrt, ys, c2, r2, hy, hg2, hc2⟩ :=
    chirp_phase hp₃ hn hdC hC BC hBC t1 hR1 zs1 w R0 (by simp [t1]) hw nw
  obtain ⟨eC', nC, gC⟩ := KFZ.chirp_call_err (pP n) (sBD n D) (tBD n D) ht ζ hζ _ hMrt hθ hθi ha hb'
    hbg hEr nw
  rw [ht1, IState.upd_upd_same] at r2
  -- B lines
  set t2 := t.upd 0 (ints (gflat ys) ++ R0) with ht2
  have hR2 : BaseOK t2 n := hR.upd 0 (by decide) _
  obtain ⟨ys', v, c3, r3, hv, hg3, hMv, hc3⟩ :=
    lineB_phase hp₂ hn hdL hL BL hBL t2 hR2 ys _ R0 (by simp [t2]) hy nC
  rw [ht2, IState.upd_upd_same] at r3
