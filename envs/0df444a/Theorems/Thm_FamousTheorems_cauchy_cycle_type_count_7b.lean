-- title:
--   Cauchy's formula for the number of permutations of a given cycle type
-- statement:
--   **Cauchy's formula for the number of permutations of a given cycle type.** Let $\alpha$ be a finite set with $n$ elements and let $m$ be a multiset of integers $\ge2$ with sum $s\le n$. The number of permutations of $\alpha$ whose nontrivial cycles have lengths given by $m$ is
--   $$\frac{n!}{(n-s)!\,\prod_{\ell\in m}\ell\,\prod_k c_k!},$$
--   where $c_k$ is the number of times $k$ occurs in $m$. If $s>n$ or $m$ contains an entry less than $2$, there are no such permutations.
--
--   The formula gives the sizes of the conjugacy classes of $S_n$ and, dividing into $n!$, the orders of their centralizers. It underlies the cycle index of the symmetric group and Pólya enumeration. It follows from the orbit–stabilizer theorem, since the centralizer of a permutation of type $m$ is generated by rotations of the cycles, permutations of equal-length cycles, and permutations of the fixed points.
--
--   **Formalization note.** Mathlib's `Equiv.Perm.card_of_cycleType`. The cycle type omits fixed points, so $n-s$ is the number of fixed points. The division is natural number division, and it is exact in the first case.
-- source:
--   Listed in Mathlib's curated theorem manifests (docs/1000.yaml); formalized in Mathlib as `Equiv.Perm.card_of_cycleType`. Proof here reduces to that Mathlib result.

import Mathlib

namespace FamousTheorems

theorem cauchy_cycle_type_count_7b (α : Type*) [DecidableEq α] [Fintype α] (m : Multiset ℕ) :
    ({g : Equiv.Perm α | g.cycleType = m} : Finset (Equiv.Perm α)).card =
      if m.sum ≤ Fintype.card α ∧ ∀ a ∈ m, 2 ≤ a then
        (Fintype.card α).factorial /
          ((Fintype.card α - m.sum).factorial * m.prod * ∏ n ∈ m.toFinset, (Multiset.count n m).factorial)
      else 0 := by sorry

end FamousTheorems
