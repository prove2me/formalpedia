open TunnellMap
open Polynomial
namespace TunnellMap
theorem _root_.solution {v : Triple} (hv : v ≠ ⟨0, 0, 0⟩) :
    primitiveDirection v ≠ ⟨0, 0, 0⟩ := by
  intro hd
  have h := direction_decomposition v
  rw [hd] at h
  apply hv
  simpa [vsmul] using h
end TunnellMap
