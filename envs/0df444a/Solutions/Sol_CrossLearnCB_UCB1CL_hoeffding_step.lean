variable {K C : ℕ} {Ω : Type*} [MeasurableSpace Ω]

/-- The past σ-algebra: generated by the rewards of rounds `s < k`. -/
abbrev past (R : ℕ → Ω → Fin K → Fin C → ℝ) (k : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (s : Fin k) => R s ω) inferInstance

lemma past_mono (R : ℕ → Ω → Fin K → Fin C → ℝ) {s k : ℕ} (h : s ≤ k) :
    past R s ≤ past R k := by
  have hφ : Measurable (fun (y : Fin k → Fin K → Fin C → ℝ) (j : Fin s) =>
      y ⟨j, lt_of_lt_of_le j.2 h⟩) :=
    measurable_pi_lambda _ (fun j => measurable_pi_apply _)
  have : Measurable[past R k] (fun ω (j : Fin s) => R j ω) :=
    hφ.comp (comap_measurable (fun ω (s : Fin k) => R s ω))
  exact this.comap_le

lemma measurable_R_past (R : ℕ → Ω → Fin K → Fin C → ℝ) {s k : ℕ} (h : s < k) :
    Measurable[past R k] (R s) :=
  (measurable_pi_apply (⟨s, h⟩ : Fin k)).comp (comap_measurable (fun ω (s : Fin k) => R s ω))

lemma past_le (R : ℕ → Ω → Fin K → Fin C → ℝ) (hR : ∀ t, Measurable (R t)) (k : ℕ) :
    past R k ≤ ‹MeasurableSpace Ω› :=
  (measurable_pi_lambda (fun ω (s : Fin k) => R s ω) (fun s => hR s)).comap_le

/-- Independence of the past and the present round. -/
lemma indep_past (P : Measure Ω) (R : ℕ → Ω → Fin K → Fin C → ℝ)
    (hmeas : ∀ t, Measurable (R t)) (hind : iIndepFun (fun t => R t) P) (k : ℕ) :
    Indep (past R k) (MeasurableSpace.comap (R k) inferInstance) P := by
  have h := hind.indepFun_finset (Finset.range k) {k}
    (by simp) hmeas
  rw [IndepFun_iff_Indep] at h
  refine indep_of_indep_of_le_right (indep_of_indep_of_le_left h ?_) ?_
  · have hφ : Measurable (fun (y : (Finset.range k) → Fin K → Fin C → ℝ) (j : Fin k) =>
        y ⟨j, Finset.mem_range.2 j.2⟩) :=
      measurable_pi_lambda _ (fun j => measurable_pi_apply _)
    have : Measurable[MeasurableSpace.comap (fun ω (i : Finset.range k) => R i ω) inferInstance]
        (fun ω (s : Fin k) => R s ω) :=
      hφ.comp (comap_measurable (fun ω (i : Finset.range k) => R i ω))
    exact this.comap_le
  · have hφ : Measurable (fun (y : ({k} : Finset ℕ) → Fin K → Fin C → ℝ) =>
        y ⟨k, Finset.mem_singleton_self k⟩) := measurable_pi_apply _
    have : Measurable[MeasurableSpace.comap (fun ω (i : ({k} : Finset ℕ)) => R i ω) inferInstance]
        (R k) :=
      hφ.comp (comap_measurable (fun ω (i : ({k} : Finset ℕ)) => R i ω))
    exact this.comap_le

/-- Exponential supermartingale bound for a predictable `{0,1}` selection of rounds. -/
lemma exp_sum_le_one (P : Measure Ω) [IsProbabilityMeasure P] (R : ℕ → Ω → Fin K → Fin C → ℝ)
    (hmeas : ∀ t, Measurable (R t)) (hind : iIndepFun (fun t => R t) P)
    (ψ : (Fin K → Fin C → ℝ) → ℝ) (hψm : Measurable ψ) (B : ℝ) (hψB : ∀ v, |ψ v| ≤ B)
    (β : ℝ) (hψ : ∀ k, ∫ ω, Real.exp (ψ (R k ω) - β) ∂P ≤ 1)
    (a : ℕ → Ω → ℝ) (ha01 : ∀ k ω, a k ω = 0 ∨ a k ω = 1)
    (ham : ∀ k, Measurable[past R k] (a k)) :
    ∀ k, ∫ ω, Real.exp (∑ s ∈ Finset.range k, a s ω * (ψ (R s ω) - β)) ∂P ≤ 1 := by
  have hB0 : 0 ≤ B := le_trans (abs_nonneg _) (hψB 0)
  -- measurability of the partial sums w.r.t. the past
  have hSm : ∀ k, Measurable[past R k]
      (fun ω => ∑ s ∈ Finset.range k, a s ω * (ψ (R s ω) - β)) := by
    intro k
    apply Finset.measurable_sum
    intro s hs
    have hs' := Finset.mem_range.1 hs
    exact ((ham s).mono (past_mono R hs'.le) le_rfl).mul
      ((hψm.comp (measurable_R_past R hs')).sub_const β)
  have hbound : ∀ k ω, |∑ s ∈ Finset.range k, a s ω * (ψ (R s ω) - β)| ≤ k * (B + |β|) := by
    intro k ω
    calc |∑ s ∈ Finset.range k, a s ω * (ψ (R s ω) - β)|
        ≤ ∑ s ∈ Finset.range k, |a s ω * (ψ (R s ω) - β)| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _s ∈ Finset.range k, (B + |β|) := by
          apply Finset.sum_le_sum
          intro s _
          rw [abs_mul]
          have h1 : |a s ω| ≤ 1 := by rcases ha01 s ω with h | h <;> simp [h]
          have h2 : |ψ (R s ω) - β| ≤ B + |β| :=
            (abs_sub _ _).trans (by linarith [hψB (R s ω)])
          calc |a s ω| * |ψ (R s ω) - β| ≤ 1 * (B + |β|) :=
                mul_le_mul h1 h2 (abs_nonneg _) zero_le_one
            _ = B + |β| := one_mul _
      _ = k * (B + |β|) := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  -- integrability of bounded measurable functions
  have hint : ∀ (f : Ω → ℝ) (M : ℝ), Measurable f → (∀ ω, |f ω| ≤ M) → Integrable f P := by
    intro f M hf hM
    exact (integrable_const M).mono' hf.aestronglyMeasurable
      (ae_of_all _ (fun ω => by rw [Real.norm_eq_abs]; exact hM ω))
  intro k
  induction k with
  | zero => simp
  | succ k ih =>
    set S : Ω → ℝ := fun ω => ∑ s ∈ Finset.range k, a s ω * (ψ (R s ω) - β) with hSdef
    set M : Ω → ℝ := fun ω => Real.exp (S ω) with hMdef
    set E : Ω → ℝ := fun ω => Real.exp (ψ (R k ω) - β) with hEdef
    have hpastle := past_le R hmeas
    have hSmeas : Measurable S := (hSm k).mono (hpastle k) le_rfl
    have hMmeas : Measurable M := Real.measurable_exp.comp hSmeas
    have hakmeas : Measurable (a k) := (ham k).mono (hpastle k) le_rfl
    have hEmeas : Measurable E :=
      Real.measurable_exp.comp ((hψm.comp (hmeas k)).sub_const β)
    have hMb : ∀ ω, |M ω| ≤ Real.exp (k * (B + |β|)) := by
      intro ω
      simp only [hMdef]
      rw [abs_of_pos (Real.exp_pos _)]
      exact Real.exp_le_exp.2 (le_trans (le_abs_self _) (hbound k ω))
    have hEb : ∀ ω, |E ω| ≤ Real.exp (B + |β|) := by
      intro ω
      simp only [hEdef]
      rw [abs_of_pos (Real.exp_pos _)]
      apply Real.exp_le_exp.2
      have := hψB (R k ω)
      have := le_abs_self (ψ (R k ω))
      have := neg_abs_le β
      linarith
    have hab : ∀ ω, |a k ω| ≤ 1 := fun ω => by rcases ha01 k ω with h | h <;> simp [h]
    have hMint : Integrable M P := hint M _ hMmeas hMb
    have hMab : ∀ ω, |M ω * a k ω| ≤ Real.exp (k * (B + |β|)) * 1 := by
      intro ω
      rw [abs_mul]
      exact mul_le_mul (hMb ω) (hab ω) (abs_nonneg _) (Real.exp_pos _).le
    have hMaint : Integrable (fun ω => M ω * a k ω) P :=
      hint (fun ω => M ω * a k ω) _ (hMmeas.mul hakmeas) hMab
    have hEint : Integrable E P := hint E _ hEmeas hEb
    -- pointwise identity
    have hpt : ∀ ω, Real.exp (∑ s ∈ Finset.range (k + 1), a s ω * (ψ (R s ω) - β))
        = (M ω - M ω * a k ω) + (M ω * a k ω) * E ω := by
      intro ω
      rw [Finset.sum_range_succ, Real.exp_add]
      simp only [hMdef, hSdef, hEdef]
      rcases ha01 k ω with h | h <;> rw [h] <;> simp
    -- independence of `M * a k` and `E`
    have hindep : IndepFun (fun ω => M ω * a k ω) E P := by
      rw [IndepFun_iff_Indep]
      refine indep_of_indep_of_le_right (indep_of_indep_of_le_left
        (indep_past P R hmeas hind k) ?_) ?_
      · exact (((hSm k).exp).mul (ham k)).comap_le
      · exact (Real.measurable_exp.comp ((hψm.comp (comap_measurable (R k))).sub_const β)).comap_le
    have hprod : ∫ ω, (M ω * a k ω) * E ω ∂P = (∫ ω, M ω * a k ω ∂P) * ∫ ω, E ω ∂P :=
      hindep.integral_mul_eq_mul_integral (hMmeas.mul hakmeas).aestronglyMeasurable
        hEmeas.aestronglyMeasurable
    have hMa0 : 0 ≤ ∫ ω, M ω * a k ω ∂P := by
      apply integral_nonneg
      intro ω
      show 0 ≤ M ω * a k ω
      rcases ha01 k ω with h | h <;> rw [h] <;> simp [hMdef, (Real.exp_pos _).le]
    simp_rw [hpt]
    have hsubint : Integrable (fun ω => M ω - M ω * a k ω) P := hMint.sub hMaint
    have hthird : Integrable (fun ω => M ω * a k ω * E ω) P := by
      refine hint (fun ω => M ω * a k ω * E ω) (Real.exp (k * (B + |β|)) * 1 * Real.exp (B + |β|))
        ((hMmeas.mul hakmeas).mul hEmeas) (fun ω => ?_)
      rw [abs_mul]
      exact mul_le_mul (hMab ω) (hEb ω) (abs_nonneg _) (by positivity)
    rw [integral_add hsubint hthird, integral_sub hMint hMaint, hprod]
    have hE1 := hψ k
    have : (∫ ω, M ω * a k ω ∂P) * ∫ ω, E ω ∂P ≤ ∫ ω, M ω * a k ω ∂P := by
      calc (∫ ω, M ω * a k ω ∂P) * ∫ ω, E ω ∂P ≤ (∫ ω, M ω * a k ω ∂P) * 1 :=
            mul_le_mul_of_nonneg_left hE1 hMa0
        _ = _ := mul_one _
    have ih' : ∫ ω, M ω ∂P ≤ 1 := ih
    linarith


/-- A real function of an arm sequence that only depends on the first `T` arms is measurable. -/
lemma measurable_of_dep {K : ℕ} [NeZero K] (T : ℕ) (f : (ℕ → Fin K) → ℝ)
    (hf : ∀ J J' : ℕ → Fin K, (∀ s < T, J s = J' s) → f J = f J') : Measurable f := by
  classical
  let ext : (Fin T → Fin K) → (ℕ → Fin K) := fun y s => if h : s < T then y ⟨s, h⟩ else 0
  let g : (Fin T → Fin K) → ℝ := fun y => f (ext y)
  have hg : Measurable g := measurable_of_countable g
  have hres : Measurable (fun J : ℕ → Fin K => fun s : Fin T => J s) :=
    measurable_pi_lambda _ (fun s => measurable_pi_apply _)
  have : f = g ∘ (fun J : ℕ → Fin K => fun s : Fin T => J s) := by
    funext J
    simp only [Function.comp, g]
    apply hf
    intro s hs
    simp [ext, hs]
  rw [this]
  exact hg.comp hres

/-- A function of the arms `I_0, …, I_k` is measurable w.r.t. the past of round `k`. -/
lemma measurable_past_of_dep [NeZero K] (R : ℕ → Ω → Fin K → Fin C → ℝ) (I : ℕ → Ω → Fin K)
    (hI : ∀ t, Measurable[past R t] (I t)) (k : ℕ) (f : (ℕ → Fin K) → ℝ)
    (hf : ∀ J J' : ℕ → Fin K, (∀ s < k + 1, J s = J' s) → f J = f J') :
    Measurable[past R k] (fun ω => f (fun j => I j ω)) := by
  classical
  let Ψ : Ω → ℕ → Fin K := fun ω j => if j ≤ k then I j ω else 0
  have hΨ : Measurable[past R k] Ψ := by
    rw [@measurable_pi_iff]
    intro j
    by_cases hj : j ≤ k
    · simp only [Ψ, hj, if_true]
      exact (hI j).mono (past_mono R hj) le_rfl
    · simp only [Ψ, hj, if_false]
      exact measurable_const
  have heq : (fun ω => f (fun j => I j ω)) = fun ω => f (Ψ ω) := by
    funext ω
    apply hf
    intro s hs
    simp [Ψ, show s ≤ k by omega]
  rw [heq]
  exact (measurable_of_dep (k + 1) f hf).comp hΨ

open Classical in
/-- The `{0,1}` selector of the first `n` observations of arm `i` in context `c`. -/
noncomputable def sel (G : Fin K → Fin C → Fin C → Prop) (ctx : ℕ → Fin C) (i : Fin K) (c : Fin C)
    (n : ℕ) (s : ℕ) (J : ℕ → Fin K) : ℝ :=
  if (J s = i ∧ G i (ctx s) c) ∧ obsCount G ctx J s i c < n then 1 else 0

lemma obsCount_congr (G : Fin K → Fin C → Fin C → Prop) (ctx : ℕ → Fin C)
    (J J' : ℕ → Fin K) (t : ℕ) (h : ∀ s < t, J s = J' s) (i : Fin K) (c : Fin C) :
    obsCount G ctx J t i c = obsCount G ctx J' t i c := by
  classical
  unfold obsCount
  congr 1
  apply Finset.filter_congr
  intro s hs
  rw [h s (Finset.mem_range.1 hs)]

lemma sel_dep (G : Fin K → Fin C → Fin C → Prop) (ctx : ℕ → Fin C) (i : Fin K) (c : Fin C)
    (n s : ℕ) (J J' : ℕ → Fin K) (h : ∀ j < s + 1, J j = J' j) :
    sel G ctx i c n s J = sel G ctx i c n s J' := by
  unfold sel
  rw [h s (by omega), obsCount_congr G ctx J J' s (fun j hj => h j (by omega))]

open Classical in
lemma filter_mono' (G : Fin K → Fin C → Fin C → Prop) (ctx : ℕ → Fin C)
    (J : ℕ → Fin K) {a b : ℕ} (hab : a ≤ b) (i : Fin K) (c : Fin C) :
    (Finset.range a).filter (fun s => J s = i ∧ G i (ctx s) c) ⊆
      (Finset.range b).filter (fun s => J s = i ∧ G i (ctx s) c) := by
  intro s hs
  simp only [Finset.mem_filter, Finset.mem_range] at hs ⊢
  exact ⟨by omega, hs.2⟩

lemma obsCount_mono' (G : Fin K → Fin C → Fin C → Prop) (ctx : ℕ → Fin C)
    (J : ℕ → Fin K) {a b : ℕ} (hab : a ≤ b) (i : Fin K) (c : Fin C) :
    obsCount G ctx J a i c ≤ obsCount G ctx J b i c := by
  classical
  unfold obsCount
  exact Finset.card_le_card (filter_mono' G ctx J hab i c)

lemma obsCount_succ_le (G : Fin K → Fin C → Fin C → Prop) (ctx : ℕ → Fin C)
    (J : ℕ → Fin K) (t : ℕ) (i : Fin K) (c : Fin C) :
    obsCount G ctx J (t + 1) i c ≤ obsCount G ctx J t i c + 1 := by
  classical
  unfold obsCount
  calc ((Finset.range (t + 1)).filter (fun s => J s = i ∧ G i (ctx s) c)).card
      ≤ (insert t ((Finset.range t).filter (fun s => J s = i ∧ G i (ctx s) c))).card := by
        apply Finset.card_le_card
        intro s hs
        simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_insert] at hs ⊢
        by_cases hst : s = t
        · left; exact hst
        · right; exact ⟨by omega, hs.2⟩
    _ ≤ _ := Finset.card_insert_le _ _

open Classical in
/-- Pathwise identities: on `n ≤ τ_T`, the selector picks exactly the first `n` observations. -/
lemma sel_sums (G : Fin K → Fin C → Fin C → Prop) (ctx : ℕ → Fin C) (J : ℕ → Fin K)
    (r : ℕ → Fin K → Fin C → ℝ) (i : Fin K) (c : Fin C) (n T : ℕ) (hn : 1 ≤ n) (hT : 1 ≤ T)
    (hnT : n ≤ obsCount G ctx J T i c) :
    (∑ s ∈ Finset.range T, sel G ctx i c n s J) = n ∧
    (∑ s ∈ Finset.range T, sel G ctx i c n s J * r s i c)
      = n * firstNMean G ctx J r i c n := by
  set N := fun t => obsCount G ctx J t i c with hN
  have hmem : T - 1 ∈ {t' : ℕ | n ≤ obsCount G ctx J (t' + 1) i c} := by
    simp only [Set.mem_setOf_eq]
    rw [show T - 1 + 1 = T by omega]; exact hnT
  set τ0 := obsTime G ctx J i c n with hτ0
  have hτle : τ0 ≤ T - 1 := Nat.sInf_le hmem
  have hτmem : n ≤ obsCount G ctx J (τ0 + 1) i c := Nat.sInf_mem ⟨T - 1, hmem⟩
  have hτlt : obsCount G ctx J τ0 i c < n := by
    rcases Nat.eq_zero_or_pos τ0 with h0 | hpos
    · rw [h0]; simp [obsCount]; omega
    · have hnot : τ0 - 1 ∉ {t' : ℕ | n ≤ obsCount G ctx J (t' + 1) i c} :=
        Nat.notMem_of_lt_sInf (by show τ0 - 1 < τ0; omega)
      simp only [Set.mem_setOf_eq, not_le] at hnot
      rwa [show τ0 - 1 + 1 = τ0 by omega] at hnot
  have hset : (Finset.range T).filter
      (fun s => (J s = i ∧ G i (ctx s) c) ∧ obsCount G ctx J s i c < n) =
      (Finset.range (τ0 + 1)).filter (fun s => J s = i ∧ G i (ctx s) c) := by
    ext s
    simp only [Finset.mem_filter, Finset.mem_range]
    constructor
    · rintro ⟨hs, hD, hNs⟩
      refine ⟨?_, hD⟩
      by_contra hge
      have := obsCount_mono' G ctx J (show τ0 + 1 ≤ s by omega) i c
      omega
    · rintro ⟨hs, hD⟩
      refine ⟨by omega, hD, ?_⟩
      have := obsCount_mono' G ctx J (show s ≤ τ0 by omega) i c
      omega
  have hcard : ((Finset.range (τ0 + 1)).filter (fun s => J s = i ∧ G i (ctx s) c)).card = n := by
    have h1 := obsCount_succ_le G ctx J τ0 i c
    have : obsCount G ctx J (τ0 + 1) i c = n := by omega
    simpa [obsCount] using this
  constructor
  · unfold sel
    rw [← Finset.sum_filter, hset]
    simp [hcard]
  · have hsum : (∑ s ∈ Finset.range T, sel G ctx i c n s J * r s i c)
        = obsSum G ctx J r (τ0 + 1) i c := by
      unfold sel obsSum
      simp only [ite_mul, one_mul, zero_mul]
      rw [← Finset.sum_filter, hset]
    rw [hsum]
    unfold firstNMean
    rw [← hτ0]
    have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast (show n ≠ 0 by omega)
    field_simp


/-- Hoeffding's lemma in the form used here: for `Y ∈ [lo, lo + 1]`,
`E[exp(λ (Y - E Y) - λ²/8)] ≤ 1`. -/
lemma hoeffding_mgf (P : Measure Ω) [IsProbabilityMeasure P] (Y : Ω → ℝ) (hY : Measurable Y)
    (lo : ℝ) (hb : ∀ ω, Y ω ∈ Set.Icc lo (lo + 1)) (l : ℝ) :
    ∫ ω, Real.exp (l * (Y ω - ∫ ω', Y ω' ∂P) - l ^ 2 / 8) ∂P ≤ 1 := by
  have h := hasSubgaussianMGF_of_mem_Icc (X := Y) (μ := P) hY.aemeasurable (ae_of_all _ hb)
  have h2 := h.mgf_le l
  have hc : (((‖lo + 1 - lo‖₊ / 2) ^ 2 : NNReal) : ℝ) = 1 / 4 := by
    simp only [add_sub_cancel_left, nnnorm_one, NNReal.coe_pow, NNReal.coe_div, NNReal.coe_one]
    norm_num
  rw [hc] at h2
  unfold mgf at h2
  have heq : (fun ω => Real.exp (l * (Y ω - ∫ ω', Y ω' ∂P) - l ^ 2 / 8)) =
      fun ω => Real.exp (l * (Y ω - ∫ ω', Y ω' ∂P)) * Real.exp (-(l ^ 2 / 8)) := by
    funext ω; rw [← Real.exp_add]; ring_nf
  rw [heq, integral_mul_const]
  calc (∫ ω, Real.exp (l * (Y ω - ∫ ω', Y ω' ∂P)) ∂P) * Real.exp (-(l ^ 2 / 8))
      ≤ Real.exp (1 / 4 * l ^ 2 / 2) * Real.exp (-(l ^ 2 / 8)) :=
        mul_le_mul_of_nonneg_right h2 (Real.exp_pos _).le
    _ = 1 := by rw [← Real.exp_add]; ring_nf; simp

lemma exp_sum_integrable (P : Measure Ω) [IsProbabilityMeasure P]
    (R : ℕ → Ω → Fin K → Fin C → ℝ) (hmeas : ∀ t, Measurable (R t))
    (ψ : (Fin K → Fin C → ℝ) → ℝ) (hψm : Measurable ψ) (B : ℝ) (hψB : ∀ v, |ψ v| ≤ B)
    (β : ℝ) (a : ℕ → Ω → ℝ) (ha01 : ∀ k ω, a k ω = 0 ∨ a k ω = 1)
    (ham : ∀ k, Measurable (a k)) (k : ℕ) :
    Integrable (fun ω => Real.exp (∑ s ∈ Finset.range k, a s ω * (ψ (R s ω) - β))) P := by
  have hm : Measurable (fun ω => Real.exp (∑ s ∈ Finset.range k, a s ω * (ψ (R s ω) - β))) :=
    Real.measurable_exp.comp (Finset.measurable_sum _ (fun s _ =>
      (ham s).mul ((hψm.comp (hmeas s)).sub_const β)))
  refine (integrable_const (Real.exp (k * (B + |β|)))).mono' hm.aestronglyMeasurable
    (ae_of_all _ (fun ω => ?_))
  rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
  apply Real.exp_le_exp.2
  calc (∑ s ∈ Finset.range k, a s ω * (ψ (R s ω) - β))
      ≤ ∑ _s ∈ Finset.range k, (B + |β|) := by
        apply Finset.sum_le_sum
        intro s _
        have h2 : |ψ (R s ω) - β| ≤ B + |β| :=
          (abs_sub _ _).trans (by linarith [hψB (R s ω)])
        rcases ha01 s ω with h | h <;> rw [h]
        · simp; linarith [abs_nonneg (ψ (R s ω) - β), abs_nonneg β]
        · rw [one_mul]; exact (le_abs_self _).trans h2
    _ = k * (B + |β|) := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]

