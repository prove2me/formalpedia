@[simp] theorem reaches_pure_iff (h : Hidden N R anchor) (a b : α) :
    Reaches h (.pure a) b ↔ b = a := by
  constructor
  · intro hr
    cases hr
    rfl
  · rintro rfl
    exact .pure _

