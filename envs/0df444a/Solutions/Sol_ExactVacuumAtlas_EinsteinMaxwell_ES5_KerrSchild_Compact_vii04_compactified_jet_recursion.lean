theorem gammaGen_coeff_eight (hn : JetNormalization M c F b A) :
    (gammaGen h Q J F b A).coeff 8 = 2 * M * h * Q * A.coeff 2 - 2 * M * J * c ^ 2
      - 3 * M * Q * A.coeff 3 + h * Q * c * F.coeff 2 - 9 * h * Q * A.coeff 3
      + 2 * J * c ^ 2 * b.coeff 1 + 8 * J * c * A.coeff 2 + 4 * Q * c ^ 3 - 3 * Q * c * F.coeff 3
      - 2 * Q * F.coeff 2 * A.coeff 2 + 12 * Q * A.coeff 4 := by
  rw [show (gammaGen h Q J F b A).coeff 8 = (gammaGen h Q J F b A).coeff (4 + 4) from rfl,
    gammaGen_coeff_add_four, gammaCore]
  ( simp only [coeff_add, coeff_sub, coeff_neg,
  coeff_ofNat_mul', coeff_C_mul, coeff_X_mul_ite, mul_coeff_zero, FiniteJet.coeff_mul_one_eq,
  FiniteJet.coeff_mul_two_eq, FiniteJet.coeff_mul_three_eq, coeff_mul_four_eq, coeff_thetaP,
  coeff_theta2P, coeff_uP_ite, coeff_ofNat_ite, coeff_C, coeff_X, Nat.cast_ofNat, Nat.cast_one,
  Nat.cast_zero, mul_zero, zero_mul, add_zero, zero_add, sub_zero, zero_sub, mul_one, one_mul,
  ↓reduceIte, Nat.reduceEqDiff, Nat.reduceSub, Nat.reduceAdd, ite_true, ite_false, neg_zero])
  simp only [hn.F0, hn.b0, hn.A0, hn.F1, hn.A1]
  ring

/-! ## The eight selected rows and the triangular recursion -/

/-! Derived values (outputs of `jet_recursion`; compare RECURRENCE.md). -/

/-! ## F1's transcribed jets have exactly these low coefficients -/


theorem f1Jet_normalization (M h J Q c : ℝ) : JetNormalization M c (FiniteJet.fJet M h J Q c)
    (FiniteJet.mBarJet M h J Q c) (FiniteJet.aJet M h J Q c) where
  F0 := by ( simp only [FiniteJet.fJet, FiniteJet.aJet,
  FiniteJet.mBarJet, coeff_add, coeff_C_mul, coeff_X_pow, coeff_C, ↓reduceIte, Nat.reduceEqDiff,
  mul_one, mul_zero, add_zero, zero_add])
  b0 := by ( simp only [FiniteJet.fJet, FiniteJet.aJet,
  FiniteJet.mBarJet, coeff_add, coeff_C_mul, coeff_X_pow, coeff_C, ↓reduceIte, Nat.reduceEqDiff,
  mul_one, mul_zero, add_zero, zero_add])
  A0 := by ( simp only [FiniteJet.fJet, FiniteJet.aJet,
  FiniteJet.mBarJet, coeff_add, coeff_C_mul, coeff_X_pow, coeff_C, ↓reduceIte, Nat.reduceEqDiff,
  mul_one, mul_zero, add_zero, zero_add])
  F1 := by ( simp only [FiniteJet.fJet, FiniteJet.aJet,
  FiniteJet.mBarJet, coeff_add, coeff_C_mul, coeff_X_pow, coeff_C, ↓reduceIte, Nat.reduceEqDiff,
  mul_one, mul_zero, add_zero, zero_add]); ring
  A1 := by ( simp only [FiniteJet.fJet, FiniteJet.aJet,
  FiniteJet.mBarJet, coeff_add, coeff_C_mul, coeff_X_pow, coeff_C, ↓reduceIte, Nat.reduceEqDiff,
  mul_one, mul_zero, add_zero, zero_add]); ring

theorem f1Jet_coeffs (M h J Q c : ℝ) :
    (FiniteJet.mBarJet M h J Q c).coeff 1 = jetB1 M h J Q c ∧
    (FiniteJet.fJet M h J Q c).coeff 2 = jetF2 M h J Q c ∧
    (FiniteJet.fJet M h J Q c).coeff 3 = jetF3 M h J Q c ∧
    (FiniteJet.aJet M h J Q c).coeff 2 = jetA2 M h J Q c ∧
    (FiniteJet.aJet M h J Q c).coeff 3 = jetA3 M h J Q c ∧
    (FiniteJet.aJet M h J Q c).coeff 4 = jetA4 M h J Q c := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> ( simp only [FiniteJet.fJet, FiniteJet.aJet,
  FiniteJet.mBarJet, coeff_add, coeff_C_mul, coeff_X_pow, coeff_C, ↓reduceIte, Nat.reduceEqDiff,
  mul_one, mul_zero, add_zero, zero_add]) <;>
    simp only [jetB1, jetF2, jetF3, jetA2, jetA3, jetA4] <;> ring

/-! ## Connection to F1 and the equation-sourced finite-coefficient obstruction -/

/-- The derived low data make the generic Γ coefficients 6, 7, 8 equal to F1's `gammaJet`
coefficients. Higher coefficients of `F b A` are arbitrary (the formula lemmas hold for every
polynomial with the normalisation); `gammaGen` is not replaced by `gammaJet`. -/
theorem gammaGen_coeffs_eq_gammaJet (hn : JetNormalization M c F b A)
    (hr : SelectedRows h Q J F b A) :
    (gammaGen h Q J F b A).coeff 6 = (FiniteJet.gammaJet M h J Q c).coeff 6 ∧
    (gammaGen h Q J F b A).coeff 7 = (FiniteJet.gammaJet M h J Q c).coeff 7 ∧
    (gammaGen h Q J F b A).coeff 8 = (FiniteJet.gammaJet M h J Q c).coeff 8 := by
  obtain ⟨hB1, hF2, -, hA2, hA3, hF3, -, hA4⟩ := jet_recursion hn hr
  obtain ⟨jB1, jF2, jF3, jA2, jA3, jA4⟩ := f1Jet_coeffs M h J Q c
  have hJ := f1Jet_normalization M h J Q c
  rw [gammaJet_eq_gammaGen, gammaGen_coeff_six hn, gammaGen_coeff_six hJ,
    gammaGen_coeff_seven hn, gammaGen_coeff_seven hJ, gammaGen_coeff_eight hn,
    gammaGen_coeff_eight hJ, hB1, hF2, hA2, hA3, hF3, hA4, jB1, jF2, jF3, jA2, jA3, jA4]
  exact ⟨rfl, rfl, rfl⟩

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Compact
end R05Seg4

-- ==== solution ====
open Polynomial
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Compact
variable {M h J Q c : ℝ} {F b A : ℝ[X]}
theorem solution (M h J Q c : ℝ) (F b A : ℝ[X])
    (hn : JetNormalization M c F b A) (hr : SelectedRows h Q J F b A) :
    (b.coeff 1 = jetB1 M h J Q c ∧ F.coeff 2 = jetF2 M h J Q c ∧ b.coeff 2 = jetB2 M h J Q c ∧
      A.coeff 2 = jetA2 M h J Q c ∧ A.coeff 3 = jetA3 M h J Q c ∧ F.coeff 3 = jetF3 M h J Q c ∧
      b.coeff 3 = jetB3 M h J Q c ∧ A.coeff 4 = jetA4 M h J Q c) ∧
    ((gammaGen h Q J F b A).coeff 6 = (FiniteJet.gammaJet M h J Q c).coeff 6 ∧
      (gammaGen h Q J F b A).coeff 7 = (FiniteJet.gammaJet M h J Q c).coeff 7 ∧
      (gammaGen h Q J F b A).coeff 8 = (FiniteJet.gammaJet M h J Q c).coeff 8) ∧
    ((gammaGen h Q J F b A).coeff 6 = 0 → (gammaGen h Q J F b A).coeff 7 = 0 →
      (gammaGen h Q J F b A).coeff 8 = 0 → J ^ 3 * Q ^ 5 = 0 ∧ (J = 0 ∨ Q = 0)) := by
  obtain ⟨e6, e7, e8⟩ := gammaGen_coeffs_eq_gammaJet hn hr
  refine ⟨jet_recursion hn hr, ⟨e6, e7, e8⟩, fun h6 h7 h8 => ?_⟩
  rw [e6] at h6; rw [e7] at h7; rw [e8] at h8
  exact ⟨FiniteJet.gammaJet_obstruction M h J Q c h6 h7 h8,
    FiniteJet.gammaJet_zero_branch M h J Q c h6 h7 h8⟩
