private theorem e_inertia (hinj : Function.Injective ιT)
    (hgal : ∀ (τ : ↥(A.decompositionSubgroup ℚ)) (c : J),
      ιT (gal (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) c) = galT τ (ιT c))
    (hinert : ∀ τ : ↥(A.decompositionSubgroup ℚ),
      (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) ∈ A.inertiaSubgroupIn ℚ → actZ τ = 1) :
    ∀ σ : ↥(A.decompositionSubgroup ℚ),
      (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) ∈ A.inertiaSubgroupIn ℚ →
      ∀ s : A.valuation.Completion ≃ₐ[ℚ] A.valuation.Completion, (∀ c, s c = σ • c) →
        ∀ (u : ↥𝒰.P.U) (hu : 𝒰.P.coeffMap (s : A.valuation.Completion →+* A.valuation.Completion)
            (u : 𝒰.P.TorusPoints) ∈ 𝒰.P.U),
          e ⟨𝒰.P.coeffMap (s : A.valuation.Completion →+* A.valuation.Completion) (u : 𝒰.P.TorusPoints), hu⟩ =
            gal (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (e u) := by
  intro σ hσ s hs u hu
  apply hinj
  rw [he, hgal, he]
  exact (EquivariantUniformization.eFull_restrict_U_torsion_and_equiv 𝒰).2.2.2.2.1 σ (hinert σ hσ) s hs
    (u : 𝒰.P.TorusPoints)

