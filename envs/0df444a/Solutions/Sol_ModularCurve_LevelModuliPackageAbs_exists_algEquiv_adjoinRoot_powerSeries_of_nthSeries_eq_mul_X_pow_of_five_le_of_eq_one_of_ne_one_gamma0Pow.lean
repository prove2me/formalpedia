theorem solution
    (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (hq5 : 5 ≤ q) (ℓ M' : ℕ) [Fact ℓ.Prime] (hℓ3 : 3 ≤ ℓ) [NeZero M']
    (A₀ : Type) [CommRing A₀]

    (hℓ : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (D : ModularCurve.LevelPData T), ModularCurve.IsLevelPStructure W ℓ D →
        ModularCurve.IsLevelPStructure (C • W) ℓ (D.variableChange C))
    (hM : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (p k : ℕ) (h : Polynomial T), ModularCurve.IsGamma0PowAt W p k h →
        ModularCurve.IsGamma0PowAt (C • W) p k (ModularCurve.kernelVariableChangeDeg C (ModularCurve.gamma0PowDeg p k) h))
    (𝒢 : GroupLaws A₀) (h𝒢 : 𝒢.IsChordTangent) (h𝒢O : 𝒢.IsOriginIdentity)
    (𝒯 : LevelTransport A₀ 𝒢 q) (h𝒯 : 𝒯.IsSectionTransport)
    (P₀ : LevelModuliPackageAbs A₀ (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).toLevelModuliDatum)

    (x : (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).Raw P₀.B₀)
    (hx : (Quot.mk _ x : (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).Pt P₀.B₀) = P₀.univ)

    (R : Type) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [IsAdicComplete (maximalIdeal R) R]
    [Algebra A₀ R] (ι : P₀.B₀ →ₐ[A₀] R)
    (k : Type) [Field k] [CharP k q] (hℓk : ((ℓ : ℕ) : k) ≠ 0) (hM'k : ((M' : ℕ) : k) ≠ 0)
    (resR : R →+* k) (hresR : Function.Surjective resR) (hkerR : RingHom.ker resR = maximalIdeal R)

    (W₀ : Type) [CommRing W₀] [IsDomain W₀] [IsDiscreteValuationRing W₀]
    [IsAdicComplete (maximalIdeal W₀) W₀] (hW₀ : maximalIdeal W₀ = Ideal.span {(q : W₀)})
    (res₀ : W₀ →+* k) (hres₀ : Function.Surjective res₀) (hker₀ : RingHom.ker res₀ = maximalIdeal W₀)
    [Algebra W₀ R] [Algebra A₀ W₀] [IsScalarTower A₀ W₀ R]
    (hresR₀ : ∀ w : W₀, resR (algebraMap W₀ R w) = res₀ w)

    (hfac : ∀ (T : Type) [CommRing T] [IsLocalRing T] [IsArtinianRing T] [Algebra W₀ T]
        [Algebra A₀ T] [IsScalarTower A₀ W₀ T]
        (resT : T →+* k), Function.Surjective resT → RingHom.ker resT = maximalIdeal T →
        (∀ w : W₀, resT (algebraMap W₀ T w) = res₀ w) →
        ∀ φ : P₀.B₀ →ₐ[A₀] T, (∀ b : P₀.B₀, resT (φ b) = resR (ι b)) →
          ∃! Φ : R →ₐ[W₀] T, (∀ r : R, resT (Φ r) = resR r) ∧ ∀ b : P₀.B₀, Φ (ι b) = φ b)

    (F₀ : FormalGroup k)
    (hF₀W : F₀.toPowerSeries =
      ((((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).level.2.2.curve).map resR).formalGroupLawFixed)
    (hF₀ : ∃ u : PowerSeries k, IsUnit u ∧ F₀.nthSeries q = u * PowerSeries.X ^ q)

    (hnorm : letI : Algebra A₀ k := (res₀.comp (algebraMap A₀ W₀)).toAlgebra
      ∀ (ρ : P₀.B₀ →ₐ[A₀] k), (∀ b : P₀.B₀, ρ b = resR (ι b)) →
        ∃ hΔ : IsUnit ((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ρ x).level.2.2.curve.Δ,
          ((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ρ x).level.2.2.P =
              (𝒢 k _ hΔ).one (𝟙 (base (T := k))) ∧
          ((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ρ x).level.2.2.Q ≠
              (𝒢 k _ hΔ).one (𝟙 (base (T := k)))) :
    ∃ g : Polynomial (PowerSeries W₀), g.Monic ∧ g.natDegree = q - 1 ∧
      (∀ i < q - 1, g.coeff i ∈ maximalIdeal (PowerSeries W₀)) ∧
      (∃ u : PowerSeries W₀, IsUnit u ∧ g.coeff 0 = (q : PowerSeries W₀) * u) ∧
      Nonempty (R ≃ₐ[W₀] AdjoinRoot g) := by
  classical
  have hq3 : q ≠ 3 := by omega

  have hunitW : ∀ n : ℕ, (n : k) ≠ 0 → IsUnit ((n : ℕ) : W₀) := by
    intro n hn
    by_contra hu
    have hmem : ((n : ℕ) : W₀) ∈ maximalIdeal W₀ := (mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hu)
    rw [← hker₀, RingHom.mem_ker, map_natCast] at hmem
    exact hn hmem
  have hcastk : ∀ n : ℕ, n.Prime → n ≠ q → (n : k) ≠ 0 := by
    intro n hn hnq h
    have := (CharP.cast_eq_zero_iff k q n).mp h
    exact hnq ((Nat.prime_dvd_prime_iff_eq (Fact.out) hn).mp this).symm
  have h2W : IsUnit ((2 : ℕ) : W₀) := hunitW 2 (hcastk 2 Nat.prime_two (Ne.symm hq2))
  have h3W : IsUnit ((3 : ℕ) : W₀) := hunitW 3 (hcastk 3 Nat.prime_three (Ne.symm hq3))
  have hℓW : IsUnit ((ℓ : ℕ) : W₀) := hunitW ℓ hℓk
  have hMW : IsUnit ((M' : ℕ) : W₀) := hunitW M' hM'k

  have hℓ' : ∀ (T : Type) [CommRing T] [Algebra W₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (D : ModularCurve.LevelPData T), ModularCurve.IsLevelPStructure W ℓ D →
        ModularCurve.IsLevelPStructure (C • W) ℓ (D.variableChange C) := by
    intro T _ _; letI : Algebra A₀ T := algebraRestrict A₀ W₀ T; exact hℓ T
  have hM' : ∀ (T : Type) [CommRing T] [Algebra W₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (p k : ℕ) (h : Polynomial T), ModularCurve.IsGamma0PowAt W p k h →
        ModularCurve.IsGamma0PowAt (C • W) p k (ModularCurve.kernelVariableChangeDeg C (ModularCurve.gamma0PowDeg p k) h) := by
    intro T _ _; letI : Algebra A₀ T := algebraRestrict A₀ W₀ T; exact hM T
  obtain ⟨Pet, hPet_ft, -⟩ :=
    ModularCurve.FullLevel.exists_levelModuliPackageAbs_trivial_of_isUnit_two_three_gamma0Pow W₀ ℓ M' hℓ3 hℓW hMW h2W h3W hℓ' hM'
  haveI : Algebra.FiniteType W₀ Pet.B₀ := hPet_ft
  haveI : IsNoetherianRing Pet.B₀ := Algebra.FiniteType.isNoetherianRing W₀ Pet.B₀
  obtain ⟨xet, hxet⟩ := Quot.exists_rep Pet.univ

  have hCO₀ : ∀ (T T' : Type) [CommRing T] [Algebra A₀ T] [CommRing T'] [Algebra A₀ T'] (f : T →ₐ[A₀] T')
      (W : WeierstrassCurve.Projective T),
      ∃ (φ : projModelGradingCR W →+*ᵍ projModelGradingCR (W.map f.toRingHom))
        (_ : HomogeneousIdeal.irrelevant (projModelGradingCR (W.map f.toRingHom)) ≤
          (HomogeneousIdeal.irrelevant (projModelGradingCR W)).map φ),
        IsCoefficientHom W f.toRingHom φ :=
    fun T T' _ _ _ _ f W => WeierstrassProjModel.exists_isCoefficientHom W f.toRingHom
  obtain ⟨h𝒢', h𝒢O', -, -⟩ := WeierstrassCurve.DrinfeldGlobal.pins_restrictScalars A₀ W₀ q 𝒢 h𝒢 h𝒢O 𝒯 h𝒯 hCO₀
  haveI : xet.curve.toAffine.IsElliptic := ⟨xet.isUnit_Δ⟩
  obtain ⟨ev, hev⟩ := h𝒢' Pet.B₀ xet.curve xet.isUnit_Δ
  obtain ⟨CQ, instCQ, instAlgCQ, instFinCQ, instFlatCQ, Qu, hQu, hrep⟩ :=
    WeierstrassProjModel.RelativeGroupLaw.exists_moduleFinite_flat_represents_nsmul_eq_one xet.curve
      ((𝒢.restrictScalars W₀) Pet.B₀ xet.curve xet.isUnit_Δ) ev hev q
      (Fact.out : q.Prime).pos

  letI instW₀k : Algebra W₀ k := res₀.toAlgebra
  letI instA₀k : Algebra A₀ k := (res₀.comp (algebraMap A₀ W₀)).toAlgebra
  haveI instTowk : IsScalarTower A₀ W₀ k := IsScalarTower.of_algebraMap_eq (fun a => rfl)
  have hk₀ : ∀ w : W₀, algebraMap W₀ k w = res₀ w := fun w => rfl
  obtain ⟨ρ, ψet, χ, hΔk, Qk, hρ, hχψ, hQk_pin0, hQk, ⟨hhk, hDk, hyk, hρyk⟩, hord_k, hQ0⟩ :=
    glue_S1c q ℓ M' hℓ3 A₀ hℓ hM 𝒢 h𝒢 h𝒢O 𝒯 h𝒯 P₀ x hx R ι k resR hresR hkerR W₀ res₀ hres₀ hker₀ hresR₀
      F₀ hF₀W hF₀ hnorm hℓ' hM' Pet xet hxet h𝒢' h𝒢O' CQ Qu hQu hrep
  letI instBk : Algebra Pet.B₀ k := ψet.toRingHom.toAlgebra
  have hψalg : ∀ b : Pet.B₀, algebraMap Pet.B₀ k b = ψet b := fun b => rfl
  letI instW₀CQ : Algebra W₀ CQ := ((algebraMap Pet.B₀ CQ).comp (algebraMap W₀ Pet.B₀)).toAlgebra
  haveI instTowCQ : IsScalarTower W₀ Pet.B₀ CQ := IsScalarTower.of_algebraMap_eq (fun w => rfl)
  have hχ₀ : ∀ w : W₀, χ (algebraMap W₀ CQ w) = res₀ w := by
    intro w
    show χ (algebraMap Pet.B₀ CQ (algebraMap W₀ Pet.B₀ w)) = res₀ w
