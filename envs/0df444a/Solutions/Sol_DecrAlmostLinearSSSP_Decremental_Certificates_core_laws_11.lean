namespace DecrAlmostLinearSSSP.Decremental.Structured
lemma loop_wellFounded {σ : Type} (test : Test) (body : Cmd) (repr : σ → Data → Prop)
    (rel : σ → σ → Prop) (wf : WellFounded rel)
    (step : ∀ q s, repr q s → test.holds s →
      ∃ q' t cost, Eval body s cost t ∧ repr q' t ∧ rel q' q) :
    ∀ q s, repr q s → ∃ q' t cost, Eval (.loop test body) s cost t ∧ repr q' t ∧ ¬ test.holds t := by
  intro q
  induction q using wf.induction with
  | h q ih =>
    intro s hs
    by_cases ht : test.holds s
    · obtain ⟨q',t,c,he,hr,hrel⟩ := step q s hs ht
      obtain ⟨q'',u,rest,hu,hru,hstop⟩ := ih q' hrel t hr
      exact ⟨q'',u,c+rest+2,Eval.loopYes ht he hu,hru,hstop⟩
    · exact ⟨q,s,2,Eval.loopNo s ht,hs,ht⟩
lemma loop_wellFounded_amortized {σ : Type} (test : Test) (body : Cmd) (repr : σ → Data → Prop)
    (rel : σ → σ → Prop) (wf : WellFounded rel) (budget : σ → ℕ)
    (step : ∀ q s, repr q s → test.holds s →
      ∃ q' t cost, Eval body s cost t ∧ repr q' t ∧ rel q' q ∧ cost+2+budget q' ≤ budget q) :
    ∀ q s, repr q s → ∃ q' t cost, Eval (.loop test body) s cost t ∧ repr q' t ∧
      ¬ test.holds t ∧ cost+budget q' ≤ budget q+2 := by
  intro q
  induction q using wf.induction with
  | h q ih =>
    intro s hs
    by_cases ht : test.holds s
    · obtain ⟨q',t,c,he,hr,hrel,hcost⟩ := step q s hs ht
      obtain ⟨q'',u,rest,hu,hru,hstop,hrcost⟩ := ih q' hrel t hr
      exact ⟨q'',u,c+rest+2,Eval.loopYes ht he hu,hru,hstop,by omega⟩
    · exact ⟨q,s,2,Eval.loopNo s ht,hs,ht,by omega⟩
end DecrAlmostLinearSSSP.Decremental.Structured
end s363
