    (π : UnitaryRepresentation G V) (h : H) :
    (V →L[ℂ] V) ≃⋆ₐ[ℂ] (V →L[ℂ] V) :=
  Unitary.conjStarAlgAut ℂ (V →L[ℂ] V) (π (E.splitting h))
