variable {D : ℕ}

theorem NLogN.KFM.mrt_err_of_list (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)]
    (f g : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) {xh : List (Fin (t (Fin.last D)) → ℂ)} {E : ℝ}
    (hE : 0 ≤ E) (hl : xh.length = (tsOf t).prod)
    (h : ∀ j < (tsOf t).prod, ∀ k : Fin (t (Fin.last D)),
      ‖xh.getD j 0 k - (mrL (t (Fin.last D)) (tsOf t) (recL t f) (recL t g)).getD j 0 k‖ ≤ E) :
    ‖boxOf t xh - mrX t f g‖ ≤ E := by sorry
