section TruncEvalWs40
omit [IsLocalRing O]
variable {S : Type} [CommRing S] (θ : O →+* S) (s : S) (N : ℕ)

theorem eval₂_eq_eval₂_trunc_coe (hs : s ^ N = 0) (P : Polynomial O) :
    P.eval₂ θ s = (PowerSeries.trunc N (P : PowerSeries O)).eval₂ θ s := by
  have hdvd : Polynomial.X ^ N ∣ P - PowerSeries.trunc N (P : PowerSeries O) := by
    rw [Polynomial.X_pow_dvd_iff]
    intro d hd
    rw [Polynomial.coeff_sub, PowerSeries.coeff_trunc, if_pos hd, Polynomial.coeff_coe, sub_self]
  obtain ⟨Q, hQ⟩ := hdvd
  have hP : P = PowerSeries.trunc N (P : PowerSeries O) + Polynomial.X ^ N * Q := by
    rw [← hQ, add_sub_cancel]
  conv_lhs => rw [hP]
  rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow, hs, zero_mul, add_zero]

def truncEval (hs : s ^ (N + 2) = 0) : PowerSeries O →+* S where
  toFun f := (PowerSeries.trunc (N + 2) f).eval₂ θ s
  map_one' := by
    simp only [PowerSeries.trunc_one, Polynomial.eval₂_one]
  map_mul' f g := by
    rw [← Polynomial.eval₂_mul, eval₂_eq_eval₂_trunc_coe θ s (N + 2) hs (_ * _), Polynomial.coe_mul,
      PowerSeries.trunc_trunc_mul_trunc]
  map_zero' := by
    simp only [map_zero, Polynomial.eval₂_zero]
  map_add' f g := by
    simp only [map_add, Polynomial.eval₂_add]

theorem truncEval_apply (hs : s ^ (N + 2) = 0) (f : PowerSeries O) :
    truncEval θ s N hs f = (PowerSeries.trunc (N + 2) f).eval₂ θ s := rfl

theorem truncEval_C (hs : s ^ (N + 2) = 0) (r : O) : truncEval θ s N hs (PowerSeries.C r) = θ r := by
  rw [truncEval_apply, PowerSeries.trunc_C, Polynomial.eval₂_C]

theorem truncEval_X (hs : s ^ (N + 2) = 0) : truncEval θ s N hs PowerSeries.X = s := by
  rw [truncEval_apply, PowerSeries.trunc_X, Polynomial.eval₂_X]

theorem truncEval_comp_algebraMap (hs : s ^ (N + 2) = 0) :
    (truncEval θ s N hs).comp (algebraMap O (PowerSeries O)) = θ := by
  ext r
  rw [RingHom.comp_apply, PowerSeries.algebraMap_eq]
  exact truncEval_C θ s N hs r

theorem eq_truncEval_of_pow_eq_zero (χ : PowerSeries O →+* S) (hχ : χ PowerSeries.X ^ (N + 2) = 0) :
    χ = truncEval (χ.comp (algebraMap O (PowerSeries O))) (χ PowerSeries.X) N hχ := by

  have hpoly : χ.comp (Polynomial.coeToPowerSeries.ringHom (R := O)) =
      (truncEval (χ.comp (algebraMap O (PowerSeries O))) (χ PowerSeries.X) N hχ).comp
        (Polynomial.coeToPowerSeries.ringHom (R := O)) := by
    refine Polynomial.ringHom_ext' ?_ ?_
    · ext r
      simp only [RingHom.comp_apply, Polynomial.coeToPowerSeries.ringHom_apply, Polynomial.coe_C]
      rw [truncEval_C, RingHom.comp_apply, PowerSeries.algebraMap_eq]
    · simp only [RingHom.comp_apply, Polynomial.coeToPowerSeries.ringHom_apply, Polynomial.coe_X]
      rw [truncEval_X]
  apply RingHom.ext
  intro f
  have ef := PowerSeries.eq_X_pow_mul_shift_add_trunc (N + 2) f
  conv_lhs => rw [ef]
  conv_rhs => rw [ef]
  rw [map_add, map_add, map_mul, map_mul, map_pow, map_pow, truncEval_X, hχ, zero_mul, zero_mul, zero_add, zero_add]
  exact RingHom.congr_fun hpoly (PowerSeries.trunc (N + 2) f)

end TruncEvalWs40
