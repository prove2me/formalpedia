        Real.rpow_le_rpow_of_exponent_le (by norm_num) (by unfold IntMul.OpenAI.R154.c; norm_num)
    _ = ((2 : ℝ) ^ ((2 : ℝ) ^ 81 - 1)) ^ c := by rw [Real.rpow_mul (by norm_num)]
    _ ≤ (IntMul.OpenAI.R154.dP n : ℝ) ^ c := Real.rpow_le_rpow h0 hY (by unfold IntMul.OpenAI.R154.c; norm_num)

