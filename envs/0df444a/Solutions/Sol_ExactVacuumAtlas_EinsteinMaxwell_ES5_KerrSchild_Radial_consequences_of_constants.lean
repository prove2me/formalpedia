open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}
theorem solution (hP : PaperData I f m N w p a) (hr : r ∈ I) {Q J : ℝ}
    (hq : qFun f N w p a r = -Q) (hl : ellFun f m N w p a r = -2 * J)
    (hJs : Generic.redJ_σ f (Dfun f m N) (Afun f m) (Hfun m N) w p a r = 0) :
    eFun w p a r = -Q * f r / N r ∧
      deriv w r = -2 * (J + 2 * Q * a r) * f r * m r / N r ^ 2 ∧
      m r * deriv (fun s => m s * deriv a s) r - f r * a r =
        2 * Q * f r * m r ^ 2 / N r ^ 2 * (J + 2 * Q * a r) := by
  have hf := hP.nf r hr; have hm := hP.nm r hr; have hN := hP.nN r hr
  have he : eFun w p a r = -Q * f r / N r := by
    rw [eq_div_iff hN, ← (show N r / f r * eFun w p a r = -Q from hq)]
    field_simp
  have h1 : N r ^ 2 / (f r * m r) * deriv w r = -2 * J - 4 * Q * a r := by
    have h := hl
    simp only [ellFun, Kfun] at h
    rw [hq] at h
    linear_combination h
  have hK : N r ^ 2 / (f r * m r) * (f r * m r) = N r ^ 2 := div_mul_cancel₀ _ (mul_ne_zero hf hm)
  have hw : deriv w r = -2 * (J + 2 * Q * a r) * f r * m r / N r ^ 2 := by
    rw [eq_div_iff (pow_ne_zero 2 hN)]
    linear_combination (f r * m r) * h1 - deriv w r * hK
  refine ⟨he, hw, ?_⟩
  have hX : m r * deriv (fun s => m s * deriv a s) r - f r * a r -
      N r * m r / f r * deriv w r * eFun w p a r = 0 := by
    have h := redJ_σ_eq hP hr
    rw [hJs] at h
    have hc : 4 * f r / m r ^ 2 ≠ 0 :=
      div_ne_zero (mul_ne_zero (by norm_num) hf) (pow_ne_zero 2 hm)
    exact (mul_eq_zero.mp h.symm).resolve_left hc
  have hR : 2 * Q * f r * m r ^ 2 / N r ^ 2 * (J + 2 * Q * a r) =
      N r * m r / f r * deriv w r * eFun w p a r := by
    rw [hw, he]; field_simp
  linear_combination hX - hR
