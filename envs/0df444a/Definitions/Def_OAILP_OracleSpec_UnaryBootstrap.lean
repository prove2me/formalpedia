/-! The public dimension is binary, while the allowed clock is polynomial in its *value*.
The work tape is padded using explicit bit-stack instructions before invoking any program
that promises polynomial work in a word's length. -/
namespace OAI
namespace Optimization
namespace LinearProgramming
namespace OracleSpec
namespace UnaryBootstrap

open ExactQuantumFactoring.BitStackProgram

def bank (wire unary digits scratch : Word) : Store (Fin 4) := ![wire, unary, digits, scratch]

@[simp] theorem bank_0 (w u b s : Word) : bank w u b s 0 = w := rfl
@[simp] theorem bank_1 (w u b s : Word) : bank w u b s 1 = u := rfl
@[simp] theorem bank_2 (w u b s : Word) : bank w u b s 2 = b := rfl
@[simp] theorem bank_3 (w u b s : Word) : bank w u b s 3 = s := rfl

def twoPushes : Program (Fin 4) := .seq (.push 3 true) (.push 3 true)
def doubleUnary : Program (Fin 4) := .seq (.loop 1 twoPushes twoPushes) (reverseMove 3 1)
def digit : Bool → Program (Fin 4)
  | false => doubleUnary
  | true => .seq doubleUnary (.push 1 true)
def readDigits : Program (Fin 4) := .loop 2 (digit false) (digit true)

def readValue (xs : Word) (acc : ℕ) := xs.foldl (fun n b => Nat.bit b n) acc

/-- Four fixed binary stacks suffice. Decode N without losing the original public input,
read its bits from most to least significant, and frame the unary answer on the input wire. -/
def program : Program (Fin 4) :=
  .seq (unquoteMove 0 1 2 3) (.seq (duplicateReverse 1 2 3)
    (.seq (quoteMove 1 0 3) (.seq readDigits (quoteMove 1 0 3))))

end UnaryBootstrap
end OracleSpec
end LinearProgramming
end Optimization
end OAI


