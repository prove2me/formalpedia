-- title:
--   The centralizer of the adjacent Artin automorphisms is generated by global conjugation
-- statement:
--   Let β be an endomorphism of the free group on n letters that commutes with every adjacent Artin automorphism and fixes the global word x₁⋯xₙ. For n ≥ 3, β is conjugation by an integral power of that global word. This is the free-group centralizer calculation used to identify a pure central braid with a power of the full twist.
-- source:
--   Birman, Braids, Links, and Mapping Class Groups, Chapter 1, Theorem 1.9 and Corollary 1.8.4; Artin's free-group automorphism argument.

import Mathlib
import Definitions.Def_BraidsLinksMCG_ArtinBraidGroup
import Definitions.Def_BraidsLinksMCG_ArtinEndo

namespace BraidsLinksMCG

theorem artin_centralizer_inner_v1 (n : ℕ) (hn : 3 ≤ n)
    (beta : MulAut (FreeGroup (Fin n)))
    (hcentral : ∀ i : Fin (n - 1), ∀ w : FreeGroup (Fin n),
      beta (artinEndo n i w) = artinEndo n i (beta w))
    (hword : beta (freeWordProd n) = freeWordProd n) :
    ∃ k : ℤ, ∀ w : FreeGroup (Fin n),
      beta w = (freeWordProd n) ^ k * w * (freeWordProd n) ^ (-k) := by sorry

end BraidsLinksMCG
