theorem abelian_quotient_zmultiples_generator_of_pair
    {Q : Type*} [AddCommGroup Q] (α δ : Q)
    (hgen : AddSubgroup.closure ({α, δ} : Set Q) = ⊤) :
    AddSubgroup.zmultiples (α : Q ⧸ AddSubgroup.zmultiples δ) = ⊤ := by sorry









