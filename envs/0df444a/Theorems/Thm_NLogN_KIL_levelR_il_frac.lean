variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W) (N : ℕ) [NeZero N] (A B Cs : Shape)

theorem NLogN.KIL.levelR_il_frac (D : ℕ) (hN : 1 < N)
    (hfr : FramesOK (FrOK C N (ShFrac N D)) C.gates C.Min C.Mout) :
    ∃ K : ℕ, ∀ (P L' : ℕ), (∀ a ∈ P :: L' :: hdShape A B Cs m N, 1 ≤ a) →
      ∀ {Pp : ℕ} (I : List Sym) (iprog : Fin Pp → IStmt HS Pp)
      (jOf : Fin (m + m) → Fin (m + m) → Fin Pp)
      (child : Fin (m + m) → Fin (m + m) → List (ZMod 2) → List (ZMod 2)) (c0 Bb : ℕ),
      (∀ (i j : Fin m) (t : IState HS) (R : List Item) (ys : List (ZMod 2)),
        ys.length = vol (P :: L' :: hdShape A B Cs m N) →
        IRuns I iprog (iprog (jOf (Fin.castAdd m i) (Fin.natAdd m j)))
          (t.upd 0 (ints (enc2 ys) ++ R))
          (t.upd 0 (ints (enc2 (child (Fin.castAdd m i) (Fin.natAdd m j) ys)) ++ R)) c0 ∧
        (child (Fin.castAdd m i) (Fin.natAdd m j) ys).length =
          vol (P :: L' :: hdShape A B Cs m N)) →
      zsz ((vol (P :: W * L' :: hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb →
      zsz ((2 * N : ℕ) : ℤ) ≤ Bb →
      ∃ code : IStmt HS Pp, ∀ (t : IState HS) (R : List Item) (xs : List (ZMod 2)),
        xs.length = vol (P :: W * L' :: hdShape A B Cs m N) →
        IRuns I iprog code (t.upd 0 (ints (enc2 xs) ++ R))
          (t.upd 0 (ints (enc2 (levelR C N P L' A B Cs child xs)) ++ R))
          (K * ((vol (P :: W * L' :: hdShape A B Cs m N) + 1) * (Bb + 2) ^ 2) +
            rankSum C * (c0 + 2)) := by sorry
