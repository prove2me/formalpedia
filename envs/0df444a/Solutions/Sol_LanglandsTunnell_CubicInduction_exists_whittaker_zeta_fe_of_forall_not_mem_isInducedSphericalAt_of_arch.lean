variable {v : HeightOneSpectrum (𝓞 ℚ)}

private theorem continuous_of_isOpen_of_isRightInvariant
    {U : Subgroup (LocalGL3 v)} (hU : IsOpen (U : Set (LocalGL3 v)))
    {W : LocalGL3 v → ℂ} (hW : IsRightInvariant U W) : Continuous W := by
  refine IsLocallyConstant.continuous ((IsLocallyConstant.iff_exists_open W).mpr fun g => ?_)
  refine ⟨g • (U : Set (LocalGL3 v)), hU.smul g, ?_, fun y hy => ?_⟩
  · exact ⟨1, U.one_mem, mul_one g⟩
  · obtain ⟨u, hu, rfl⟩ := hy
    exact hW g u hu

end
