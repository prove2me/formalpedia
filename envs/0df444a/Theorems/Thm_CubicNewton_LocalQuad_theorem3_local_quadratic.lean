-- title:
--   Theorem 3 (item 3) — quadratic convergence of (3.5) to a non-degenerate local minimum, (3.8)
-- statement:
--   Let $f:\mathbb{R}^n\to\mathbb{R}$ ($n \ge 1$) be twice differentiable with gradient $f'$ and Hessian $f''$, and suppose the Hessian is Lipschitz continuous with constant $L > 0$ in the spectral norm. Let $\{x_k\}_{k\ge0}$ be generated by the relaxed cubic regularization of Newton method
--   $$x_{k+1} = T_{M_k}(x_k), \qquad M_k \in (0, 2L], \qquad k \ge 0,$$
--   where $T_M(x)$ is any global minimizer of $y \mapsto \langle f'(x), y-x\rangle + \tfrac12\langle f''(x)(y-x), y-x\rangle + \tfrac M6\|y-x\|^3$. Suppose $f''(x_0) \succ 0$ and
--   $$\delta_0 = \frac{L\|f'(x_0)\|}{\lambda_n^2(f''(x_0))} \le \frac14 .$$
--   Then the whole sequence $\{x_k\}$ converges to a point $x^*$ which is a non-degenerate local minimum of $f$: $f'(x^*) = 0$, $f''(x^*) \succ 0$, and $f(x^*) \le f(x)$ for all $x$ near $x^*$. Moreover, for every $k \ge 1$,
--   $$\|f'(x_k)\| \le \lambda_n^2(f''(x_0))\,\frac{9e^{3/2}}{16L}\left(\frac12\right)^{2^k}.$$
--
--   This is the local quadratic convergence of the cubic-regularized Newton method: near a non-degenerate minimum the lower bound $L_0 > 0$ on the regularization parameter and the acceptance test of the globally convergent scheme can be dropped.
--
--   **Formalization Note** The paper's "converges quadratically" is rendered by its own "in particular" clause, the gradient bound (3.8), stated for every $k \ge 1$ exactly as printed. The limit point is asserted to exist, with $f'(x^*) = 0$, $\lambda_n(f''(x^*)) > 0$ and `IsLocalMin f x*`. The mission takes $F = \mathbb{R}^n$: $f$ is twice differentiable and Assumption 1 holds on all of $\mathbb{R}^n$. $\lambda_n$ is `lamMin` (Rayleigh-quotient infimum); $\delta_0$ is `deltaMeasure`; $(1/2)^{2^k}$ has a natural-number exponent.
-- source:
--   Nesterov & Polyak, Cubic regularization of Newton method and its global performance, Math. Program. Ser. A 108 (2006) 177–205, DOI 10.1007/s10107-006-0706-8, p. 187, Theorem 3, item 3, inequality (3.8)

import Mathlib
import Definitions.Def_CubicNewton_LocalQuad_IsRelaxedRun
import Definitions.Def_CubicNewton_LocalQuad_deltaMeasure

namespace CubicNewton.LocalQuad

/-- Nesterov–Polyak 2006, Theorem 3, item 3, including (3.8), p. 187, in the case `F = ℝⁿ`:
let `f″(x₀) ≻ 0` and `δ₀ ≤ 1/4`, and let `{x_k}` be generated by the relaxed method (3.5).
Then the whole sequence converges to a point `x*` which is a non-degenerate local minimum of `f`
(`f′(x*) = 0`, `f″(x*) ≻ 0`, and `x*` is a local minimizer), and for every `k ≥ 1`
`‖f′(x_k)‖ ≤ λₙ²(f″(x₀)) · (9 e^{3/2} / (16 L)) · (1/2)^{2^k}`. -/
theorem theorem3_local_quadratic {n : ℕ}
    (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (H : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (L : ℝ)
    (hf : ∀ x, HasGradientAt f (g x) x) (hg : ∀ x, HasFDerivAt g (H x) x)
    (hL : 0 < L) (hLip : ∀ x y, ‖H x - H y‖ ≤ L * ‖x - y‖)
    (hn : 0 < n) (x : ℕ → EuclideanSpace ℝ (Fin n)) (M : ℕ → ℝ)
    (hrun : IsRelaxedRun L g H x M)
    (hpos : 0 < CubicNewton.Shared.lamMin (H (x 0))) (hδ0 : deltaMeasure L g H (x 0) ≤ 1 / 4) :
    ∃ xs : EuclideanSpace ℝ (Fin n),
      Filter.Tendsto x Filter.atTop (nhds xs) ∧ g xs = 0 ∧ 0 < CubicNewton.Shared.lamMin (H xs) ∧
      IsLocalMin f xs ∧
      ∀ k, 1 ≤ k → ‖g (x k)‖ ≤
        CubicNewton.Shared.lamMin (H (x 0)) ^ 2 * (9 * Real.exp (3 / 2) / (16 * L)) * (1 / 2 : ℝ) ^ (2 ^ k) := by sorry

end CubicNewton.LocalQuad
