    (hA : s.G CA = ints c ++ RA) (hY : s.G CY = .int y0 :: LY) (hR : s.G CR = .int (2 ^ b) :: LR)
    (hM : s.G CM = .int c.length :: LM) (hy0 : 0 ≤ y0) (hyB : y0 < 2 ^ B)
    (hc : ∀ x ∈ c, 0 ≤ x ∧ x < 2 ^ B) (hb1 : 1 ≤ b) (hbB : b ≤ B) (hMB : zsz (c.length : ℤ) ≤ B) :
    carryP.cost M s ≤ 40000 * (c.length + 1) * (B + 3) + 20000 * (b * c.length + B + 4) := by
  have hc0 : ∀ x ∈ c, 0 ≤ x := fun x hx => (hc x hx).1
  have k1 := carry1_cost M s b B c y0 RA LY LR LM hA hY hR hM hy0 hyB hc hb1 hbB hMB
  rw [carryP, RM.cost_seq']
  rw [carry1_run s b c y0 RA LY LR LM hA hY hR hM hy0 hc0]
  set dl := (carryL b c y0).1 with hdl
  set yM := (carryL b c y0).2 with hyM
  have hlen : dl.length = c.length := carryL_length b c y0
  have hyM0 : 0 ≤ yM := carryL_carry_nonneg b c y0 hy0 hc0
  have hyMB : yM < 2 ^ B := carryL_carry_lt b B hb1 c y0 hy0 hyB hc
  set s1 := ((s.upd CA RA).upd CY (.int yM :: LY)).upd CD (ints dl.reverse ++ s.G CD) with hs1
  have hR1 : s1.G CR = .int (2 ^ b) :: LR := by
    simp (config := {decide := true}) [hs1, IState.upd_G, hR]
  have hM1 : s1.G CM = .int dl.length :: LM := by
    simp (config := {decide := true}) [hs1, IState.upd_G, hM, hlen]
  have hY1 : s1.G CY = .int yM :: LY := by
    simp (config := {decide := true}) [hs1, IState.upd_G]
  have e0 : (RS.seq (.asg CY (.add (.reg CY) (.lit 1))) (.push CP (.lit 1))).run s1 =
      c2St s1 b dl yM LY (s.G CD) (s.G CP) 0 := by
    simp only [c2St, Nat.sub_zero, List.drop_length, List.take_length, mul_zero, pow_zero]
    apply IState.ext' <;> intros <;>
      simp (config := {decide := true}) only [RS.run, IState.upd_G, IState.upd_ip,
        IState.upd_out, Ex.eval, IState.top, hs1] <;>
      split_ifs <;> simp_all (config := {decide := true}) [kpack]
  have hst := asm_states s1 b dl yM LY (s.G CD) (s.G CP) LR LM (carryL_digits b c y0) hyM0 hR1 hM1
  have hN : (Ex.eval (c2St s1 b dl yM LY (s.G CD) (s.G CP) 0) (Ex.reg CM)).toNat = dl.length := by
    simp (config := {decide := true}) [Ex.eval, IState.top, hM1, c2St, IState.upd_G]
  have k2 := asm_cost M s1 b B dl yM LY (s.G CD) (s.G CP) LR LM (carryL_digits b c y0) hyM0 hR1 hM1
    hbB (by rw [hlen]; exact hMB)
  rw [carry2, RM.cost_seq', RM.cost_seq', RM.cost_rs', RM.cost_rs', RS.cost_seq', RS.cost_seq',
    RM.run_rs, e0, hst.run, hN]
  -- the initial assignment and push
  have hlt1 : yM + 1 < 2 ^ (B + 1) := by rw [pow_succ]; have : (1 : ℤ) ≤ 2 ^ B := one_le_pow₀ (by norm_num); omega
  have hlt0 : yM < 2 ^ (B + 1) := by omega
  have a1 := RS.asgCost_le_lin CY (.add (.reg CY) (.lit 1)) s1 (B + 1) (by simp [Ex.Lin])
    (by
      simp only [Ex.Bnd, Ex.eval, IState.top, hY1]
      refine ⟨zsz_le_of_nonneg_lt hyM0 hlt0, by rw [zsz_one]; omega,
        zsz_le_of_nonneg_lt (by omega) hlt1⟩)
    (by simp only [IState.top, hY1]; exact zsz_le_of_nonneg_lt hyM0 hlt0)
  have a2 := RS.pushCost_le_lin (.lit 1) ((RS.asg CY (.add (.reg CY) (.lit 1))).run s1) (B + 1)
    (by simp [Ex.Lin]) (by simp only [Ex.Bnd]; rw [zsz_one]; omega)
  -- the final subtraction
  have hdig := carryL_digits b c y0
  have hkp := kpack_nonneg b dl (fun x hx => (hdig x hx).1)
  have hkl := kpack_lt b dl hdig
  set W := b * dl.length with hW
  have hpos : (0 : ℤ) < 2 ^ W := by positivity
  have hA2 : kpack (2 ^ b) dl + (yM + 1) * 2 ^ W < 2 ^ (W + B + 1) := by
    have : (yM + 1) * 2 ^ W ≤ 2 ^ B * 2 ^ W := mul_le_mul_of_nonneg_right (by omega) hpos.le
    rw [pow_add, pow_add, pow_one]; nlinarith
  have hWlt : (2 : ℤ) ^ W < 2 ^ (W + B + 1) := pow_lt_pow_right₀ (by norm_num) (by omega)
  set t2 := c2St s1 b dl yM LY (s.G CD) (s.G CP) dl.length with ht2
  have tY : t2.G CY = .int (kpack (2 ^ b) dl + (yM + 1) * 2 ^ W) :: LY := by
    simp (config := {decide := true}) [ht2, c2St, IState.upd_G, hW]
  have tP : t2.G CP = .int (2 ^ W) :: s.G CP := by
    simp (config := {decide := true}) [ht2, c2St, IState.upd_G, hW]
  have hfin : 0 ≤ kpack (2 ^ b) dl + (yM + 1) * 2 ^ W + -2 ^ W := by nlinarith
  have hfin2 : kpack (2 ^ b) dl + (yM + 1) * 2 ^ W + -2 ^ W < 2 ^ (W + B + 1) := by nlinarith
  have a3 := RS.asgCost_le_lin CY (.add (.reg CY) (.neg (.reg CP))) t2 (W + B + 1)
    (by simp [Ex.Lin])
    (by
      simp only [Ex.Bnd, Ex.eval, IState.top, tY, tP]
      refine ⟨zsz_le_of_nonneg_lt (by positivity) hA2, zsz_le_of_nonneg_lt hpos.le hWlt, ?_⟩
      exact zsz_le_of_nonneg_lt hfin hfin2)
    (by simp only [IState.top, tY]; exact zsz_le_of_nonneg_lt (by positivity) hA2)
  have a4 : RS.cost (.pop CP) ((RS.asg CY (.add (.reg CY) (.neg (.reg CP)))).run t2) =
      2 * (W + 1) + 2 := by
    simp (config := {decide := true}) [RS.cost, RS.run, IState.top, IState.upd_G, tP, NLogN.zsz_two_pow]
  simp only [Ex.size] at a1 a2 a3
  have a1' : (RS.asg CY (.add (.reg CY) (.lit 1))).cost s1 ≤ (1 + 1 + 1 + 1) * 2000 * (B + 1 + 2) :=
    a1
  have a2' : (RS.push CP (.lit 1)).cost ((RS.asg CY (.add (.reg CY) (.lit 1))).run s1) ≤
      (1 + 1) * 2000 * (B + 1 + 2) := a2
  have a3' : (RS.asg CY (.add (.reg CY) (.neg (.reg CP)))).cost t2 ≤
      (1 + 1 + 1 + 1 + 1) * 2000 * (W + B + 1 + 2) := a3
  rw [hlen] at k2 hW
  rw [a4]
  have hW' : W = b * c.length := hW
  rw [hW'] at a3'
  push_cast at *
  linarith

end NLogN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.CR
open IntMul IntMul.HvdH IntMul.HvdH.Ref RS
theorem solution (M : NLogN.MulSpec) (s : NLogN.IState NLogN.HS) (b B : ℕ) (c : List ℤ) (RA LR LM : List NLogN.Item)
    (hA : s.G NLogN.CA = NLogN.ints c ++ RA) (hR : s.G NLogN.CR = .int (2 ^ b) :: LR)
    (hM : s.G NLogN.CM = .int c.length :: LM) (hc : ∀ x ∈ c, 0 ≤ x ∧ x < 2 ^ B) (hb1 : 1 ≤ b)
    (hbB : b ≤ B) (hMB : NLogN.zsz (c.length : ℤ) ≤ B) :
    NLogN.CR.evalP.cost M s ≤ 40000 * (c.length + 1) * (B + 3) + 20000 * (b * c.length + B + 4) + 103 := by
  set s1 := (NLogN.RS.push NLogN.CY (.lit 0)).run s with hs1
  have s1A : s1.G NLogN.CA = NLogN.ints c ++ RA := by simp +decide [hs1, hA]
  have s1Y : s1.G NLogN.CY = .int 0 :: s.G CY := by simp +decide [hs1, NLogN.Ex.eval]
  have s1R : s1.G NLogN.CR = .int (2 ^ b) :: LR := by simp +decide [hs1, hR]
  have s1M : s1.G NLogN.CM = .int c.length :: LM := by simp +decide [hs1, hM]
  have := NLogN.carryP_cost M s1 b B c 0 RA (s.G NLogN.CY) LR LM s1A s1Y s1R s1M le_rfl (by positivity) hc hb1
    hbB hMB
  have e : NLogN.CR.evalP.cost M s = 103 + NLogN.carryP.cost M s1 := by
    simp only [NLogN.CR.evalP, NLogN.RM.cost_seq', NLogN.RM.cost_rs', NLogN.RS.cost, NLogN.Ex.cost, NLogN.Ex.eval, NLogN.zsz_zero, NLogN.moveCost,
      ← hs1, NLogN.RM.run_rs]
  rw [e]; omega
end
