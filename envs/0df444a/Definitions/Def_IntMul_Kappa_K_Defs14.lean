-- Source module: Solutions.KFCBwd
/-!
# KFC: fine-cost paper Lemma 3, backward direction `[P, M, q, B] → [P, q, M, B]`

Per block: load the `M` groups (`q` records each) into the mark-delimited accumulator, then for
each row `y < q` peel the first record of every group to the output (`unzipA`) and move the
remaining groups back (`backB`).  All counting is unary; cost `O(q·V)` entry moves.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN

open IntMul AModel

namespace KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Unzip column: `mvB A O CB DB; mvW A T; unmark A; mark T` -/

def ucol : IStmt HS Pp :=
  .seq (mvB sA NLogN.KFC.sO sCB sDB) (.seq (mvW sA NLogN.KFC.sT) (.seq (.op (.unmark sA)) (.op (.mark NLogN.KFC.sT))))

def unzipA : IStmt HS Pp := uloop sCM sDM ucol

def urow : IStmt HS Pp := .seq unzipA backB

/-! ## Rows of one block -/

/-- Records `y = k, …, q-1` of column `m`. -/
def sufF (rr : ℕ → ℕ → List ℤ) (q k m : ℕ) : List ℤ := flF (fun y => rr y m) k (q - k)

def rowsB : IStmt HS Pp := uloop sCQ sDQ urow

/-! ## Loading a block into the accumulator -/

def mvQ : IStmt HS Pp := uloop sCQ sDQ (mvB sX NLogN.KFC.sT sCB sDB)

def ldcol : IStmt HS Pp := .seq mvQ (.op (.mark NLogN.KFC.sT))

def loadT : IStmt HS Pp := uloop sCM sDM ldcol

/-! ## Clearing the `M` empty groups -/

def clrA : IStmt HS Pp := uloop sCM sDM (.op (.unmark sA))

end KFC

end NLogN

end

section
-- Source module: Solutions.KFCBwdMain
/-!
# KFC: the self-contained fine-cost backward field move `bwdF`

`bwdF_spec`: on `t` with `ints xs ++ R` on stack `0` (shape `[P, M, q, B]`) and `P, q, M, B` on
stacks `1 … 4`, `bwdF` ends in `t.upd 0 (ints (pull [P,M,q,B] [P,q,M,B] gS 0 xs) ++ R)` with cost
`≤ cBwdF P q M B w = (2q+18)·kap w·V + cUL P + cUL q + cUL M + cUL B + 1000`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN

open IntMul AModel

namespace KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## One block -/

def blkB : IStmt HS Pp := .seq loadT (.seq backB (.seq rowsB clrA))

def cBlkB (q M B w : ℕ) : ℕ := (2 * q + 10) * kap w * (q * M * B)

/-! ## All blocks -/

def allB : IStmt HS Pp := uloop sCP sDP blkB

/-! ## Core and program -/

def coreB : IStmt HS Pp :=
  .seq (.op (.mark NLogN.KFC.sO)) (.seq (.op (.mark NLogN.KFC.sT)) (.seq allB (.seq (mvW NLogN.KFC.sO sX)
    (.seq (.op (.unmark NLogN.KFC.sO)) (.op (.unmark NLogN.KFC.sT))))))

def bwdF : IStmt HS Pp :=
  NLogN.KFC.wrap 4 sCB sDB (NLogN.KFC.wrap 3 sCM sDM (NLogN.KFC.wrap 2 sCQ sDQ (NLogN.KFC.wrap 1 sCP sDP coreB)))

def cBwdF (P q M B w : ℕ) : ℕ :=
  (2 * q + 18) * kap w * (P * q * M * B) + cUL P + cUL q + cUL M + cUL B + 1000

end KFC

end NLogN

end

