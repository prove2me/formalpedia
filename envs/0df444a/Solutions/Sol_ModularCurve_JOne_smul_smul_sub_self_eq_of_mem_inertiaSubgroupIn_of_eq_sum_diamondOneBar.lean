  apply Subtype.ext
  show ((arithmeticGalois (x1FunctionField (M₀ * q)) g • incl M₀ q x : Ftop M₀ q) : LaurentSeries Qb)
    = ((incl M₀ q (arithmeticGalois (x1x0FunctionFieldC ℚ M₀ q) g • x) : Ftop M₀ q) : LaurentSeries Qb)
