theorem position_of_coherent {g : ℕ} (pos : Option (Fin g)) (rank : ℕ)
    (coherent : ∀ i,pos=some i → i.val=rank) :
    position g pos.isSome rank=pos ∧ (pos.isSome=true → rank<g) := by
  cases pos with
  | none => simp [position]
  | some i =>
    have h := coherent i rfl
    subst rank
    simp [position,i.isLt]

