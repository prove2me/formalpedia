section Field

variable {R : Type*} [Field R]

/-- Truncated LHS of Chan Ch 13 identity: `sum_{k=0}^N q^{k^2} / (q;q)_k^2`. -/
noncomputable def deepIdentityLHSTrunc (q : R) (N : Nat) : R :=
  natSum (fun k => q ^ (k * k) / (qPochhammer q k) ^ 2) N

