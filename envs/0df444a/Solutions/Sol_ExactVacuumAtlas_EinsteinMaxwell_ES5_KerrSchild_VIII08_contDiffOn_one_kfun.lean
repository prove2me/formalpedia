/-!
# VIII08 — regularity: `Y ∈ C²` and `b_s ∈ C²` on `(3, ∞)`, and `MagClass 3 b_s`

`deriv Y R = R/(R-1) · segV Y R` and `segV Y R = (R-3)⁻¹ ∫₃ᴿ V Y`, where the primitive
`Mfun` is `C¹` with derivative `V · Y` (continuous).  Hence `Y ∈ C²` on `(3, ∞)`, and
`Y ∈ C¹` up to the horizon, which gives `b_s ∈ C²` on `(3, ∞)` and `HorizonC1` for the
(permitted) extension through `R = 3`.
-/

set_option maxHeartbeats 4000000

open Set Filter Topology MeasureTheory intervalIntegral
open scoped ContDiff Interval

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08

open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04

/-! ## `Mfun` is `C¹` on `(3, ∞)` -/

theorem continuousOn_VY_Ioi : ContinuousOn (fun z => Vfun z * Y z) (Ioi 3) :=
  (continuousOn_Vfun.mul Y_continuousOn).mono Ioi_subset_Ici_self

theorem hasDerivAt_Mfun {R : ℝ} (hR : 3 < R) : HasDerivAt Mfun (Vfun R * Y R) R :=
  hasDerivAt_VY_integral hR

theorem contDiffOn_one_Mfun : ContDiffOn ℝ 1 Mfun (Ioi (3:ℝ)) := by
  rw [contDiffOn_one_iff_derivWithin (uniqueDiffOn_Ioi 3)]
  refine ⟨?_, ?_⟩
  · intro x hx
    exact (hasDerivAt_Mfun hx).differentiableAt.differentiableWithinAt
  · refine (continuousOn_congr ?_).mpr continuousOn_VY_Ioi
    intro x hx
    rw [derivWithin_of_isOpen isOpen_Ioi hx]
    exact (hasDerivAt_Mfun hx).deriv

/-! ## `deriv Y` in closed form on `(3, ∞)` -/

theorem deriv_Y_eq_closed {R : ℝ} (hR : 3 < R) :
    deriv Y R = R / (R - 1) * ((R - 3)⁻¹ * Mfun R) := by
  rw [(hasDerivAt_Y hR).deriv, segV_eq (hg := Y) (ne_of_gt hR)]
  unfold Mfun
  ring

theorem contDiffOn_one_derivY : ContDiffOn ℝ 1 (deriv Y) (Ioi (3:ℝ)) := by
  have hfac : ContDiffOn ℝ 1 (fun R : ℝ => R / (R - 1) * (R - 3)⁻¹) (Ioi (3:ℝ)) := by
    refine ContDiffOn.mul ?_ ?_
    · refine ContDiffOn.div contDiffOn_id (contDiffOn_id.sub contDiffOn_const) ?_
      intro x hx
      exact (by linarith [mem_Ioi.mp hx] : (x:ℝ) - 1 ≠ 0)
    · refine ContDiffOn.inv (contDiffOn_id.sub contDiffOn_const) ?_
      intro x hx
      exact (by linarith [mem_Ioi.mp hx] : (x:ℝ) - 3 ≠ 0)
  refine (hfac.mul contDiffOn_one_Mfun).congr ?_
  intro x hx
  rw [deriv_Y_eq_closed hx]
  ring

/-- **`Y ∈ C²` on `(3, ∞)`.** -/
theorem contDiffOn_two_Y : ContDiffOn ℝ 2 Y (Ioi (3:ℝ)) := by
  have hstep := (contDiffOn_succ_iff_deriv_of_isOpen (n := 1) (f := Y) (s := Ioi (3:ℝ))
    (𝕜 := ℝ) isOpen_Ioi).mpr
  refine hstep ⟨?_, fun h => absurd h (by norm_num), contDiffOn_one_derivY⟩
  intro x hx
  exact (hasDerivAt_Y hx).differentiableAt.differentiableWithinAt

/-! ## `AcK` and `F_s` on `(0, a)` -/

theorem mapsTo_one_div : MapsTo (fun x : ℝ => (1:ℝ) / x) (Ioo (0:ℝ) aG) (Ioi 3) := by
  rintro x ⟨hx0, hxa⟩
  show 3 < 1 / x
  have ha : aG = 1 / 3 := rfl
  rw [ha] at hxa
  rw [lt_div_iff₀ hx0]
  linarith

theorem contDiffOn_two_one_div : ContDiffOn ℝ 2 (fun x : ℝ => (1:ℝ) / x) (Ioo (0:ℝ) aG) := by
  refine ContDiffOn.div contDiffOn_const contDiffOn_id ?_
  intro x hx
  exact (ne_of_gt hx.1)

theorem contDiffOn_two_AcK : ContDiffOn ℝ 2 AcK (Ioo (0:ℝ) aG) := by
  have hcomp : ContDiffOn ℝ 2 (fun x : ℝ => Y (1 / x)) (Ioo (0:ℝ) aG) :=
    contDiffOn_two_Y.comp contDiffOn_two_one_div mapsTo_one_div
  have hid : ContDiffOn ℝ 2 (fun x : ℝ => x) (Ioo (0:ℝ) aG) := contDiffOn_id
  have h := hid.mul hcomp
  refine h.congr ?_
  intro x hx
  have hx0 : x ≠ 0 := ne_of_gt hx.1
  rw [AcK_eq hx0]
  unfold Ac
  rw [one_div]

theorem contDiffOn_one_sfun {j : ℝ} {q : ℝ → ℝ} (hq : ContDiffOn ℝ 1 q UG) :
    ContDiffOn ℝ 1 (sfun j q) (Ioo (0:ℝ) aG) := by
  have hsub : Ioo (0:ℝ) aG ⊆ UG := by
    intro x hx
    exact ⟨by linarith [hx.1], by
      have ha : aG = 1 / 3 := rfl
      rw [ha] at hx; linarith [hx.2]⟩
  have h := ContDiffOn.add (f := fun _ : ℝ => 3 * j) contDiffOn_const (hq.mono hsub)
  refine h.congr ?_
  intro x _
  unfold sfun
  ring

theorem contDiffOn_one_Ffun {j : ℝ} {q : ℝ → ℝ} (hq : ContDiffOn ℝ 1 q UG) :
    ContDiffOn ℝ 1 (Ffun j q) (Ioo (0:ℝ) aG) := by
  have hA : ContDiffOn ℝ 1 AcK (Ioo (0:ℝ) aG) := contDiffOn_two_AcK.of_le (by norm_num)
  have h := ContDiffOn.mul (f := AcK) (g := sfun j q) hA (contDiffOn_one_sfun hq)
  refine h.congr ?_
  intro x _
  unfold Ffun
  ring

/-! ## `Q(x) = ∫₀ˣ F_s` is `C²`, hence `B_s`, `k_s ∈ C¹` -/

theorem hasDerivAt_Qfun {j : ℝ} {q : ℝ → ℝ} (hq : ContDiffOn ℝ 1 q UG) {x : ℝ}
    (hx : x ∈ Ioo (0:ℝ) aG) : HasDerivAt (Qfun j q) (Ffun j q x) x := by
  have hF : ContDiffOn ℝ 1 (Ffun j q) (Ioo (0:ℝ) aG) := contDiffOn_one_Ffun (j := j) hq
  have hcont : ContinuousOn (Ffun j q) (Ioo (0:ℝ) aG) := hF.continuousOn
  have hcontIcc : ContinuousOn (Ffun j q) (Icc (0:ℝ) aG) := continuousOn_Ffun (j := j) hq.continuousOn
  have hint : IntervalIntegrable (Ffun j q) volume (0:ℝ) x := by
    refine ContinuousOn.intervalIntegrable_of_Icc (le_of_lt hx.1) ?_
    exact hcontIcc.mono (fun y hy => ⟨hy.1, hy.2.trans (le_of_lt hx.2)⟩)
  have hcat : ContinuousAt (Ffun j q) x := hcont.continuousAt (isOpen_Ioo.mem_nhds hx)
  unfold Qfun
  exact intervalIntegral.integral_hasDerivAt_right (f := Ffun j q) (a := (0:ℝ)) (b := x) hint
    (ContinuousOn.stronglyMeasurableAtFilter isOpen_Ioo hcont x hx) hcat

theorem contDiffOn_one_deriv_Qfun {j : ℝ} {q : ℝ → ℝ} (hq : ContDiffOn ℝ 1 q UG) :
    ContDiffOn ℝ 1 (deriv (Qfun j q)) (Ioo (0:ℝ) aG) := by
  refine (contDiffOn_one_Ffun (j := j) hq).congr ?_
  intro x hx
  exact (hasDerivAt_Qfun hq hx).deriv

theorem contDiffOn_two_Qfun {j : ℝ} {q : ℝ → ℝ} (hq : ContDiffOn ℝ 1 q UG) :
    ContDiffOn ℝ 2 (Qfun j q) (Ioo (0:ℝ) aG) := by
  have hstep := (contDiffOn_succ_iff_deriv_of_isOpen (n := 1) (f := Qfun j q)
    (s := Ioo (0:ℝ) aG) (𝕜 := ℝ) isOpen_Ioo).mpr
  refine hstep ⟨?_, fun h => absurd h (by norm_num), contDiffOn_one_deriv_Qfun hq⟩
  intro x hx
  exact (hasDerivAt_Qfun hq hx).differentiableAt.differentiableWithinAt

theorem contDiffOn_one_Bfun {j : ℝ} {q : ℝ → ℝ} (hq : ContDiffOn ℝ 1 q UG) :
    ContDiffOn ℝ 1 (Bfun j q) (Ioo (0:ℝ) aG) := by
  have hQ : ContDiffOn ℝ 1 (Qfun j q) (Ioo (0:ℝ) aG) :=
    (contDiffOn_two_Qfun hq).of_le (m := 1) (by norm_num)
  have hnum : ContDiffOn ℝ 1
      (fun x => (∫ t in (0:ℝ)..aG, Ffun j q t) - Qfun j q x) (Ioo (0:ℝ) aG) :=
    ContDiffOn.sub (f := fun _ : ℝ => ∫ t in (0:ℝ)..aG, Ffun j q t) contDiffOn_const hQ
  have hden : ContDiffOn ℝ 1 (fun x : ℝ => 1 - 3 * x) (Ioo (0:ℝ) aG) :=
    ContDiffOn.sub (f := fun _ : ℝ => (1:ℝ)) contDiffOn_const
      (ContDiffOn.mul (f := fun _ : ℝ => (3:ℝ)) contDiffOn_const contDiffOn_id)
  have h := ContDiffOn.div hnum hden (fun x hx => by
    have hxa : x < 1 / 3 := by have ha : aG = 1 / 3 := rfl; linarith [hx.2]
    intro hc; linarith)
  refine h.congr ?_
  intro x hx
  exact Bfun_eq_sub hq.continuousOn (le_of_lt hx.1) hx.2

