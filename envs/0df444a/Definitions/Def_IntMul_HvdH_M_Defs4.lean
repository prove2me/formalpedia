-- Source module: NLogN.HCrPar2
/-!
# Parameter computation, part 2: facts about `mkParams` (namespace `NLogN.CR`)
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

/-- The exponent `E = ⌈log₂ 4L⌉` of `mkParams`. -/
def parEx (K N : ℕ) : ℕ := Nat.clog 2 (4 * (mkParams K N).L)

end NLogN.CR

end

section
-- Source module: NLogN.HCrPar3
/-!
# Parameter computation, part 3: the scalar stage (namespace `NLogN.CR`)

Input: `N ≥ 1` on `rN`, `nb` with `N < 2^nb` on `rNb`.
Stage A pushes `b, L, E, e, dh, K-dh, r, r/2, 2r, T, logOuter, 2^b, 2L-1`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

abbrev rFn : Fin HS := 26
abbrev rS : Fin HS := 28
abbrev rN : Fin HS := 34
abbrev rNb : Fin HS := 35
abbrev rB : Fin HS := 36
abbrev rE : Fin HS := 37
abbrev re : Fin HS := 38
abbrev rLO : Fin HS := 39
abbrev rRec : Fin HS := 40
abbrev rAl : Fin HS := 42
abbrev rPP : Fin HS := 44

/-- Push the integer `v` onto stack `r`. -/
def pushV (s : IState HS) (r : Fin HS) (v : ℤ) : IState HS := s.upd r (.int v :: s.G r)

@[simp] theorem pushV_ip (s : IState HS) (r : Fin HS) (v : ℤ) : (pushV s r v).ip = s.ip := rfl
@[simp] theorem pushV_out (s : IState HS) (r : Fin HS) (v : ℤ) : (pushV s r v).out = s.out := rfl

/-- `max x 0` as an expression. -/
def max0 (x : Ex HS) : Ex HS := .sel x (.lit 0) x

/-! ## Stage A -/

def stA (K : ℕ) : RS :=
  seqL [srch rB hQ (.reg rNb) (.add (.reg rN) (.neg (.pow2 (.reg rB)))),
    push cLR (.ndiv (.add (.add (.reg rN) (.reg rB)) (.lit (-1))) (.reg rB)),
    srch rE hQ (.add (.reg rNb) (.lit 2))
      (.add (.add (.mul (.lit 4) (.reg cLR)) (.lit (-1))) (.neg (.pow2 (.reg rE)))),
    push re (.ndiv (.add (.reg rE) (.lit ((K : ℤ) - 1))) (.lit K)),
    push hNb (.add (.mul (.lit K) (.reg re)) (.neg (.reg rE))),
    push hNa (.add (.lit K) (.neg (.reg hNb))),
    push hRr (.pow2 (.reg re)),
    push hRh (.pow2 (.add (.reg re) (.lit (-1)))),
    push hM2 (.pow2 (.add (.reg re) (.lit 1))),
    push hTT (.pow2 (.reg rE)),
    push rLO (.add (.reg rE) (.neg (.reg re))),
    push cRB (.pow2 (.reg rB)),
    push cMR (.add (.mul (.lit 2) (.reg cLR)) (.lit (-1)))]

/-- The state after stage A. -/
def outA (s : IState HS) (K N : ℕ) : IState HS :=
  let q := mkParams K N
  let E := parEx K N
  pushV (pushV (pushV (pushV (pushV (pushV (pushV (pushV (pushV (pushV (pushV (pushV (pushV s
    rB q.b) cLR q.L) rE E) re q.e) hNb q.dh) hNa ((q.K - q.dh : ℕ) : ℤ)) hRr ((2 ^ q.e : ℕ) : ℤ))
    hRh ((2 ^ (q.e - 1) : ℕ) : ℤ)) hM2 ((2 ^ (q.e + 1) : ℕ) : ℤ)) hTT (q.tdims.prod : ℤ))
    rLO (q.logOuter : ℤ)) cRB ((2 ^ q.b : ℕ) : ℤ)) cMR ((2 * q.L - 1 : ℕ) : ℤ)

/-! ## Stage B: `α, p, P, fn` -/

abbrev pT1 : Fin HS := 18
abbrev pT2 : Fin HS := 19
abbrev pT3 : Fin HS := 21

/-- `x - 1 - m·m < 0 ↔ ceilSqrt x ≤ m`. -/
def csE (x m : Fin HS) : Ex HS := .add (.add (.reg x) (.lit (-1))) (.neg (.mul (.reg m) (.reg m)))

def pE (K : ℕ) : Ex HS :=
  .add (.add (.add (.add (.mul (.lit 2) (.reg rB)) (.mul (.lit 2) (.reg rE)))
    (.mul (.lit (6 * K)) (.mul (.reg rAl) (.reg rAl)))) (.mul (.lit 8) (.reg pT3))) (.lit (4 * K + 64))

def stB (K : ℕ) : RS :=
  seqL [srch pT1 hQ (.reg rB) (csE rB pT1), srch pT2 hQ (.reg pT1) (csE pT1 pT2),
    push rAl (.mul (.lit K) (.add (.reg pT2) (.lit 2))),
    srch pT3 hQ (.reg rB) (.add (.reg rB) (.neg (.pow2 (.reg pT3)))),
    push hPp (pE K), push rPP (.add (.add (.mul (.lit 2) (.reg hPp)) (.reg rE)) (.lit 8)),
    push rFn (.mul (.mul (.lit 4) (.reg hRr)) (.reg rPP)),
    pop pT3, pop pT2, pop pT1]

def alV (K b : ℕ) : ℕ := K * (ceilSqrt (ceilSqrt b) + 2)
def pV (K b E : ℕ) : ℕ := 2 * b + 2 * E + 6 * K * alV K b ^ 2 + 8 * Nat.size b + 4 * K + 64
def PV (K b E : ℕ) : ℕ := 2 * pV K b E + E + 8

/-! ## Stage C: `Q, m1, m2` (the factorial `(256K²)!` by a loop) -/

abbrev pT4 : Fin HS := 22
abbrev pT5 : Fin HS := 23
abbrev pT6 : Fin HS := 24
abbrev pTQ : Fin HS := 25

def facN (K : ℕ) : ℕ := 256 * K ^ 2

def QE (K : ℕ) : Ex HS :=
  .mul (.mul (.lit 2) (.reg pT4))
    (.add (.ndiv (.reg hRr) (.mul (.mul (.lit 2) (.reg pT4)) (.lit (facN K)))) (.lit 1))

def mE (K : ℕ) (x : Fin HS) : Ex HS :=
  .ndiv (max0 (.add (.mul (.lit ((4 * K - 1 : ℕ) : ℤ)) (.reg x)) (.lit (-(4 * K : ℤ)))))
    (.mul (.lit (4 * K)) (.reg pTQ))

def stC (K : ℕ) : RS :=
  seqL [facP pT4 hQ (.lit (facN K)), push pTQ (QE K), push pT5 (mE K hRh), push pT6 (mE K hRr),
    pop pT4]

def m1V (K r : ℕ) : ℕ := ((4 * K - 1) * (r / 2) - 4 * K) / (4 * K * copQ K r)
def m2V (K r : ℕ) : ℕ := ((4 * K - 1) * r - 4 * K) / (4 * K * copQ K r)

/-! ## Stage D: the source lengths `sᵢ`, their records and `S = ∏ sᵢ` -/

abbrev pTS : Fin HS := 20

def iEx : Ex HS := .add (.reg hQ) (.lit (-1))

def sE : Ex HS :=
  .add (.lit 1) (.mul (.reg pTQ) (.sel (.add iEx (.neg (.reg hNb)))
    (max0 (.add (.reg pT5) (.neg iEx))) (max0 (.add (.reg pT6) (.neg (.add iEx (.neg (.reg hNb))))))))

def sBody : RS :=
  seqL [push pTS sE, push rRec (.mul (.reg pTS) (.reg rS)), push rRec (.reg rS), push rRec (.reg pTS),
    push rRec (.lit 0), asg rS (.mul (.reg pTS) (.reg rS)), pop pTS]

/-- The records of the axes `K - k, …, K - 1` (the first on top). -/
def recsF (sl : List ℕ) (K k : ℕ) : List ℤ :=
  ((List.range k).map fun j => recI sl 0 (K - k + j)).flatten

def Wk (sl : List ℕ) (K k : ℕ) : ℕ := (sl.drop (K - k)).prod

def dSt (t : IState HS) (sl : List ℕ) (K k : ℕ) : IState HS :=
  pushV (t.upd rRec (ints (recsF sl K k) ++ t.G rRec)) rS (Wk sl K k)

def stD (K : ℕ) : RS := seqL [push rS (.lit 1), rep hQ (.lit K) sBody, pop pT6, pop pT5, pop pTQ]

/-- The state after stages C and D: records `[0, sᵢ, wᵢ, sᵢwᵢ]` on `rRec` and `S` on `rS`. -/
def outD (t : IState HS) (sl : List ℕ) : IState HS :=
  pushV (t.upd rRec (ints (recL sl 0).flatten ++ t.G rRec)) rS (sl.prod)

/-! ## The whole parameter program -/

/-- **`mkParams` as a register program.** -/
def parP (K : ℕ) : RS := seqL [stA K, NLogN.CR.stB K, stC K, stD K]

/-- The state after `parP`. -/
def parOut (s : IState HS) (K N : ℕ) : IState HS :=
  let q := mkParams K N
  outD (pushV (pushV (pushV (pushV (outA s K N) rAl q.α) hPp q.p) rPP q.P) rFn q.fn) q.s

end NLogN.CR

end


