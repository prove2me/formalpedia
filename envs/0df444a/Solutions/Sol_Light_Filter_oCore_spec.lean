          segQI := key h.segQI (by simp [lenQI]; omega) (by simp [lenQI]; omega)
          segQJ := key h.segQJ (by simp [lenQJ]; omega) (by simp [lenQJ]; omega)
          segCR := key h.segCR (by simp [lenCT]; omega) (by simp [lenCT]; omega)
          segCL := key h.segCL (by simp [lenCT]; omega) (by simp [lenCT]; omega)
          segCW := key h.segCW (by simp [lenCT]; omega) (by simp [lenCT]; omega) }
      lay := S.lay
