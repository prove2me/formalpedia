-- Source module: Solutions.R6Norm
/-!
# Normalization of the round-six hypotheses into a `Prm`

`r6_normalize`: from the hypotheses of `IntMul.Kappa.jain_round6_framework` we get a
`P : Prm` with `P.Ok`, `κ < P.gap`, the two moment bounds at `P.τ, P.σ` and the depth-guard
constant bound `2 + 576 log s_c ≤ P.C1`.

Construction: `τ = 1 - ab`, `σ = 1 - ac`, `ε' = max ε (1/2)`, `lamp = lampOf τ σ`,
`x' = ⌈x⌉₊ + ⌈C₁⌉₊ + 3`, `C1 = ⌈C₁⌉₊`.
-/

namespace IntMul.Kappa.R6

open IntMul.Kappa

theorem histMoment_nonneg (h : List (ℕ × ℕ)) (m : ℕ) (τ : ℝ) : 0 ≤ histMoment h m τ := by
  unfold histMoment
  apply List.sum_nonneg
  intro y hy
  obtain ⟨p, -, rfl⟩ := List.mem_map.mp hy
  positivity

theorem histMoment_append (h₁ h₂ : List (ℕ × ℕ)) (m : ℕ) (τ : ℝ) :
    histMoment (h₁ ++ h₂) m τ = histMoment h₁ m τ + histMoment h₂ m τ := by
  unfold histMoment; simp [List.map_append, List.sum_append]

/-- For a nonpositive exponent, a term with `0 < w ≤ m` is at least `n_w`. -/
theorem term_ge (w n m : ℕ) (τ : ℝ) (hw : 0 < w) (hwm : w ≤ m) (hτ : τ ≤ 0) :
    (n : ℝ) ≤ (n : ℝ) * ((w : ℝ) / m) ^ τ := by
  have hw' : (0 : ℝ) < w := by exact_mod_cast hw
  have hm' : (0 : ℝ) < m := by exact_mod_cast (lt_of_lt_of_le hw hwm)
  have h1 : ((w : ℝ) / m) ≤ 1 := by
    rw [div_le_one hm']; exact_mod_cast hwm
  have := Real.one_le_rpow_of_pos_of_le_one_of_nonpos (div_pos hw' hm') h1 hτ
  have hn : (0 : ℝ) ≤ n := by positivity
  nlinarith

theorem bitR6_tau_pos (τ : ℝ) (h : histMoment Jain.bitR6 529 τ < 148225616) : 0 < τ := by
  by_contra hτ
  push Not at hτ
  have e : Jain.bitR6 = [(1, 2191713447)] ++ Jain.bitR6.tail := rfl
  rw [e, histMoment_append] at h
  have h2 := histMoment_nonneg Jain.bitR6.tail 529 τ
  have h1 := term_ge 1 2191713447 529 τ (by norm_num) (by norm_num) hτ
  simp only [histMoment, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
    add_zero] at h h2
  push_cast at h1 h
  linarith

theorem cxR6_sigma_pos (σ : ℝ) (h : histMoment Jain.cxR6 576 σ < 207387136) : 0 < σ := by
  by_contra hσ
  push Not at hσ
  have e : Jain.cxR6 = [(1, 184811440), (2, 107199136)] ++ Jain.cxR6.tail.tail := rfl
  rw [e, histMoment_append] at h
  have h3 := histMoment_nonneg Jain.cxR6.tail.tail 576 σ
  have h1 := term_ge 1 184811440 576 σ (by norm_num) (by norm_num) hσ
  have h2 := term_ge 2 107199136 576 σ (by norm_num) (by norm_num) hσ
  simp only [histMoment, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
    add_zero] at h h3
  push_cast at h1 h2 h
  linarith

/-- `(1+y) (10⁻²²/y) = 10⁻²²/y + 10⁻²²` for `y ≠ 0`. -/
theorem poly_eq (y : ℝ) (hy : y ≠ 0) : (1 + y) * (1 / 10 ^ 22 / y) = 1 / 10 ^ 22 / y + 1 / 10 ^ 22 := by
  field_simp

theorem r6_normalize_sol_aux (ab ac ε x C₁ κ : ℝ) (hab : 0 ≤ ab) (hac : 0 ≤ ac)
    (hbit : histMoment Jain.bitR6 529 (1 - ab) < 148225616)
    (hcx : histMoment Jain.cxR6 576 (1 - ac) < 207387136)
    (hasm : CrudeAssembly ab ac (1 / 1000) ε x C₁ κ 576 (histRankSum Jain.cxR6)) :
    ∃ P : Prm, P.Ok ∧ κ < P.gap ∧ histMoment Jain.bitR6 529 P.τ < 148225616 ∧
      histMoment Jain.cxR6 576 P.σ < 207387136 ∧
      2 + 576 * Real.log (histRankSum Jain.cxR6) ≤ P.C1 := by
  obtain ⟨-, hC, hlamp, h2l, -, -, hε0, hε1, h2ε, ⟨hδ0, -⟩, k1, k2, k3, k4, k5⟩ := hasm
  have hC' : 2 + 576 * Real.log (histRankSum Jain.cxR6 : ℝ) ≤ C₁ := by exact_mod_cast hC
  clear hC
  set L := lampOf (1 - ab) (1 - ac) with hL
  have hlamp' : L < 1 := hlamp
  have k2' : κ < ε * (1 - L) := k2
  have hτ := bitR6_tau_pos _ hbit
  have hσ := cxR6_sigma_pos _ hcx
  -- `x > 0` from `δ > 0`
  have hx0 : 0 < x := by
    by_contra hx; push Not at hx
    have : 1 / 10 ^ 22 / x ≤ 0 := div_nonpos_of_nonneg_of_nonpos (by norm_num) hx
    linarith
  have hC0 : (0 : ℝ) ≤ C₁ := by
    have : (0 : ℝ) ≤ Real.log (histRankSum Jain.cxR6) :=
      Real.log_natCast_nonneg _
    linarith
  set P : Prm := ⟨1 - ab, 1 - ac, max ε (1 / 2), L, ⌈x⌉₊ + ⌈C₁⌉₊ + 3, ⌈C₁⌉₊⟩ with hP
  have hxc : x ≤ (⌈x⌉₊ : ℝ) := Nat.le_ceil x
  have hCc : C₁ ≤ (⌈C₁⌉₊ : ℝ) := Nat.le_ceil C₁
  have hCc' : (⌈C₁⌉₊ : ℝ) < C₁ + 1 := Nat.ceil_lt_add_one hC0
  have hX : (P.x : ℝ) = ⌈x⌉₊ + ⌈C₁⌉₊ + 3 := by simp [hP]
  have hXge : x + C₁ + 3 ≤ (P.x : ℝ) := by rw [hX]; linarith
  have hXpos : (0 : ℝ) < P.x := by linarith
  -- lamp facts
  have hLτ : (1 - ab) + 2 / 10 ^ 16 ≤ L := by
    rw [hL]; unfold lampOf
    have h1 := le_max_left (max (max (1 - ab) (1 - ac))
      ((1 - ab) + (1 - beta) * max ((1 - ac) - (1 - ab)) 0) + 1 / 10 ^ 16)
      ((1 - ac) + beta * (1 - (1 - ac)))
    have h2 := le_max_left (max (1 - ab) (1 - ac))
      ((1 - ab) + (1 - beta) * max ((1 - ac) - (1 - ab)) 0)
    have h3 := le_max_left (1 - ab) (1 - ac)
    linarith
  have hLpos : 0 < L := by linarith
  -- poly decreases
  have hpoly : P.poly ≤ (1 + x) * (1 / 10 ^ 22 / x) := by
    have e1 : P.poly = 1 / 10 ^ 22 / (P.x : ℝ) + 1 / 10 ^ 22 := by
      unfold Prm.poly Prm.δ; exact poly_eq _ hXpos.ne'
    rw [e1, poly_eq _ hx0.ne']
    have : 1 / 10 ^ 22 / (P.x : ℝ) ≤ 1 / 10 ^ 22 / x :=
      div_le_div_of_nonneg_left (by norm_num) hx0 (by linarith)
    linarith
  have hpoly0 : P.poly ≤ 2 / 10 ^ 22 := by
    have e1 : P.poly = 1 / 10 ^ 22 / (P.x : ℝ) + 1 / 10 ^ 22 := by
      unfold Prm.poly Prm.δ; exact poly_eq _ hXpos.ne'
    have : 1 / 10 ^ 22 / (P.x : ℝ) ≤ 1 / 10 ^ 22 / 1 :=
      div_le_div_of_nonneg_left (by norm_num) one_pos (by linarith)
    rw [e1]; linarith
  have hεP : P.ε = max ε (1 / 2) := rfl
  have hε'1 : max ε (1 / 2) < 1 := max_lt hε1 (by norm_num)
  have hε'h : 1 / 2 ≤ max ε (1 / 2) := le_max_right _ _
  have h2l' : ε * (2 - L) < 1 := h2l
  have h2ε' : 2 * ε - 1 < L * ε := h2ε
  have hC1 : (0 : ℝ) ≤ (⌈C₁⌉₊ : ℝ) := by positivity
  refine ⟨P, ?_, ?_, hbit, hcx, hC'.trans hCc⟩
  · refine ⟨by simpa [hP] using hτ, by simp [hP]; linarith, by simpa [hP] using hσ,
      by simp [hP]; linarith, hε'h, hε'1, by simp [hP], le_refl _, hlamp', ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rcases le_total ε (1 / 2) with h | h
      · show max ε (1 / 2) * (2 - L) < 1
        rw [max_eq_right h]; linarith
      · show max ε (1 / 2) * (2 - L) < 1
        rw [max_eq_left h]; exact h2l'
    · show max ε (1 / 2) * (⌈C₁⌉₊ : ℝ) < 1 + (P.x : ℝ)
      have : max ε (1 / 2) * (⌈C₁⌉₊ : ℝ) ≤ (⌈C₁⌉₊ : ℝ) :=
        mul_le_of_le_one_left hC1 hε'1.le
      linarith
    · show 2 * max ε (1 / 2) + max ε (1 / 2) < 1 + (P.x : ℝ)
      linarith
    · rcases le_total ε (1 / 2) with h | h
      · show 2 * max ε (1 / 2) - 1 < L * max ε (1 / 2)
        rw [max_eq_right h]; linarith
      · show 2 * max ε (1 / 2) - 1 < L * max ε (1 / 2)
        rw [max_eq_left h]; exact h2ε'
    · unfold Prm.δ; positivity
    · unfold Prm.δ
      have : 1 / 10 ^ 22 / (P.x : ℝ) ≤ 1 / 10 ^ 22 / 1 :=
        div_le_div_of_nonneg_left (by norm_num) one_pos (by linarith)
      linarith
  · rw [Prm.lt_gap_iff]
    have k3' : κ < 1 - ε - (1 + x) * (1 / 10 ^ 22 / x) := k3
    have k5' : κ < max ε (1 - ε) * (1 - (1 - ab)) := k5
    show κ < 1 - max ε (1 / 2) ∧ κ < max ε (1 / 2) * (1 - L) ∧ κ < 1 - max ε (1 / 2) - P.poly ∧
      κ < max ε (1 / 2) ∧ κ < max (max ε (1 / 2)) (1 - max ε (1 / 2)) * (1 - (1 - ab))
    rcases le_total ε (1 / 2) with h | h
    · rw [max_eq_right h]
      have hm : max (1 / 2 : ℝ) (1 - 1 / 2) = 1 / 2 := by norm_num
      rw [hm]
      have hk : κ < 1 / 2 * (1 - L) := by
        have : ε * (1 - L) ≤ 1 / 2 * (1 - L) :=
          mul_le_mul_of_nonneg_right h (by linarith)
        linarith
      refine ⟨by linarith, hk, by linarith, by linarith, by linarith⟩
    · rw [max_eq_left h]
      refine ⟨k1, k2', by linarith, k4, k5'⟩

end IntMul.Kappa.R6

end

theorem solution : type_of% @IntMul.Kappa.R6.r6_normalize_sol_aux := @IntMul.Kappa.R6.r6_normalize_sol_aux
