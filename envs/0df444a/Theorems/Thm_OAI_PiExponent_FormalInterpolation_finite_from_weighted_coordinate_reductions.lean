-- title:
--   Finite module from weighted coordinate reductions
-- statement:
--   Given homogeneous generators of positive weighted degree and homogeneous equations reducing a positive power of every coordinate by that degree, prove the polynomial ring is a finite module over the algebra generated by those generators.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.finite_from_weighted_coordinate_reductions
    {d k : Nat} (w : Fin d → Rat) (hw : ∀ i, 0 < (w i : Real))
    (D : Real) (hD : 0 < D) (g : Fin k → MvPolynomial (Fin d) Complex)
    (hhom : ∀ j, (g j).IsWeightedHomogeneous (fun i => (w i : Real)) D)
    (n : Fin d → Nat) (hn : ∀ i, 0 < n i)
    (c : Fin d → Fin k → MvPolynomial (Fin d) Complex)
    (heq : ∀ i, (MvPolynomial.X i : MvPolynomial (Fin d) Complex) ^ n i =
      ∑ j : Fin k, c i j * g j)
    (hc : ∀ i j, (c i j).IsWeightedHomogeneous (fun l => (w l : Real))
      ((n i : Real) * (w i : Real) - D)) :
    Module.Finite (Algebra.adjoin Complex (Set.range g))
      (MvPolynomial (Fin d) Complex) := by sorry
