  intro j h1 h2
  rw [length_rixT, Geo.V_rec] at h1
  have hj : j = j / g.B * g.B + j % g.B := (Nat.div_add_mod' j g.B).symm
  have hm : j / g.B < g.recG.V := by
    rw [Nat.div_lt_iff_lt_mul hB]; exact h1
  have hb : j % g.B < g.B := Nat.mod_lt _ hB
