theorem tdivE_bnd (s : IState HS) (a m : Ex HS) (B : ℕ) (ha : a.Bnd s B) (hm : m.Bnd s B)
    (hm0 : 0 < m.eval s) : (tdivE a m).Bnd s (B + 2) := by
  simp only [tdivE, Ex.Bnd]
  refine ⟨Ex.Bnd_mono s (by omega) a ha, ?_⟩
  split_ifs
  · exact Ex.fdiv_bnd s _ _ B ha hm hm0
  · exact Ex.fdiv_bnd s _ _ B ha hm hm0

theorem zsz_tdiv_le (a m : ℤ) (hm : 0 < m) : zsz (a.tdiv m) ≤ zsz a := by
  apply zsz_mono
  rw [Int.natAbs_tdiv]
  exact Nat.div_le_self _ _

/-- Size facts for `scaleZP`. -/
theorem scale_facts (p k Bz : ℕ) (x y : ℤ) (hx : |x| < 2 ^ Bz) (hy : |y| < 2 ^ Bz) :
    0 ≤ (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) ∧ zsz (2 ^ k * x) ≤ k + Bz ∧ zsz (2 ^ k * y) ≤ k + Bz ∧ zsz x ≤ Bz ∧ zsz y ≤ Bz ∧
    zsz (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) ≤ 2 * (k + Bz + 1) ∧ zsz (2 ^ k * x * (2 ^ k * x)) ≤ 2 * (k + Bz + 1) ∧
    zsz (2 ^ k * y * (2 ^ k * y)) ≤ 2 * (k + Bz + 1) ∧ zsz ((2 : ℤ) ^ (p + p)) ≤ 2 * p + 1 ∧
    zsz (2 ^ (p + p) + -(2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y))) ≤ 2 * p + 2 * (k + Bz + 1) + 2 ∧ zsz (k : ℤ) ≤ k ∧
    zsz (p : ℤ) ≤ p ∧ zsz (Bz : ℤ) ≤ Bz ∧ zsz ((p : ℤ) + p) ≤ 2 * p ∧
    zsz ((k : ℤ) + Bz) ≤ k + Bz ∧ zsz ((k : ℤ) + Bz + 1) ≤ k + Bz + 1 ∧ zsz (1 : ℤ) ≤ 1 ∧
    zsz ((2 : ℤ) ^ p) ≤ p + 1 ∧ zsz (2 ^ k * x * 2 ^ p) ≤ k + Bz + p + 1 ∧
    zsz (2 ^ k * y * 2 ^ p) ≤ k + Bz + p + 1 ∧ zsz ((2 : ℤ) ^ k) ≤ k + 1 := by
  have hV0 : 0 ≤ (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) := add_nonneg (mul_self_nonneg _) (mul_self_nonneg _)
  have hVlt := scale_v_lt k Bz x y hx hy
  have hW1 : |2 ^ k * x| < 2 ^ (k + Bz) := by
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℤ) < 2 ^ k), pow_add]
    exact mul_lt_mul_of_pos_left hx (by positivity)
  have hW2 : |2 ^ k * y| < 2 ^ (k + Bz) := by
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℤ) < 2 ^ k), pow_add]
    exact mul_lt_mul_of_pos_left hy (by positivity)
  have zW1 : zsz (2 ^ k * x) ≤ k + Bz := NLogN.zsz_le_of_abs hW1
  have zW2 : zsz (2 ^ k * y) ≤ k + Bz := NLogN.zsz_le_of_abs hW2
  have zx : zsz x ≤ Bz := NLogN.zsz_le_of_abs hx
  have zy : zsz y ≤ Bz := NLogN.zsz_le_of_abs hy
  have zV : zsz (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) ≤ 2 * (k + Bz + 1) :=
    NLogN.zsz_le_of_abs (by rw [abs_of_nonneg hV0]; exact hVlt)
  have zWW1 : zsz (2 ^ k * x * (2 ^ k * x)) ≤ 2 * (k + Bz + 1) := le_trans (zsz_mul_le _ _) (by omega)
  have zWW2 : zsz (2 ^ k * y * (2 ^ k * y)) ≤ 2 * (k + Bz + 1) := le_trans (zsz_mul_le _ _) (by omega)
  have z4p : zsz ((2 : ℤ) ^ (p + p)) ≤ 2 * p + 1 := by rw [NLogN.zsz_two_pow]; omega
  have zc : zsz (2 ^ (p + p) + -(2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y))) ≤ 2 * p + 2 * (k + Bz + 1) + 2 := by
    have := zsz_add_le' ((2 : ℤ) ^ (p + p)) (-(2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y))); rw [zsz_neg] at this; omega
  have zk : zsz (k : ℤ) ≤ k := zsz_natCast_le_self' k
  have zp : zsz (p : ℤ) ≤ p := zsz_natCast_le_self' p
  have zB : zsz (Bz : ℤ) ≤ Bz := zsz_natCast_le_self' Bz
  have zpp : zsz ((p : ℤ) + p) ≤ 2 * p := by
    have := zsz_natCast_le_self' (p + p); push_cast at this; omega
  have zkB : zsz ((k : ℤ) + Bz) ≤ k + Bz := by
    have := zsz_natCast_le_self' (k + Bz); push_cast at this; omega
  have zkB1 : zsz ((k : ℤ) + Bz + 1) ≤ k + Bz + 1 := by
    have := zsz_natCast_le_self' (k + Bz + 1); push_cast at this; omega
  have z1 : zsz (1 : ℤ) ≤ 1 := by rw [zsz_one]
  have zP : zsz ((2 : ℤ) ^ p) ≤ p + 1 := by rw [NLogN.zsz_two_pow]
  have zWP1 : zsz (2 ^ k * x * 2 ^ p) ≤ k + Bz + p + 1 := le_trans (zsz_mul_le _ _) (by omega)
  have zWP2 : zsz (2 ^ k * y * 2 ^ p) ≤ k + Bz + p + 1 := le_trans (zsz_mul_le _ _) (by omega)
  exact ⟨hV0, zW1, zW2, zx, zy, zV, zWW1, zWW2, z4p, zc, zk, zp, zB, zpp, zkB, zkB1, z1, zP,
    zWP1, zWP2, by rw [NLogN.zsz_two_pow]⟩

theorem ceilSqrt_le (v : ℕ) : ceilSqrt v ≤ v + 1 := by
  unfold ceilSqrt; have := Nat.sqrt_le_self v; split_ifs <;> omega

set_option maxHeartbeats 4000000 in
theorem scaleThen_cost (p k Bz : ℕ) (x y : ℤ) (hx : |x| < 2 ^ Bz) (hy : |y| < 2 ^ Bz)
    (s : IState HS) (L10 L11 L12 L13 L14 : List Item)
    (h10 : s.G 10 = .int p :: L10) (h11 : s.G 11 = .int k :: L11) (h12 : s.G 12 = .int x :: L12)
    (h13 : s.G 13 = .int y :: L13) (h14 : s.G 14 = .int Bz :: L14)
    (hc : 2 ^ (p + p) + -(2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) < 0) :
    scaleThen.cost (NLogN.scSt s k x y) ≤ ceilSqrtCost (zsz (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y))) (k + Bz + 1) +
      10 ^ 10 * (2 * (p + k + Bz) + 14) ^ 2 := by
  obtain ⟨hV0, zW1, zW2, zx, zy, zV, zWW1, zWW2, z4p, zc, zk, zp, zB, zpp, zkB, zkB1, z1, zP,
    zWP1, zWP2, zK⟩ := scale_facts p k Bz x y hx hy
  obtain ⟨-, hrun, hcost⟩ := scaleThen_run p k Bz x y hx hy s L10 L11 L12 L13 L14 h10 h11 h12
    h13 h14
  have hpos : (0 : ℤ) < ceilSqrt (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat := by
    have : 0 < (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat := by
      have : (0 : ℤ) < 2 ^ (p + p) := by positivity
      omega
    exact_mod_cast ceilSqrt_pos _ this
  have zm : zsz ((ceilSqrt (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat : ℕ) : ℤ) ≤ 2 * (k + Bz + 1) + 2 := by
    have h1 := ceilSqrt_le (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat
    have : ((ceilSqrt (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat : ℕ) : ℤ) ≤ (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) + 1 := by
      have : ((ceilSqrt (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat : ℕ) : ℤ) ≤ (((2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat + 1 : ℕ) : ℤ) := by exact_mod_cast h1
      push_cast at this; rw [Int.toNat_of_nonneg hV0] at this; exact this
    have h2 := zsz_add_le' (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) 1
    refine le_trans (zsz_mono (by omega)) (le_trans h2 (by rw [zsz_one]; omega))
  have zt1 := NLogN.zsz_tdiv_le (2 ^ k * x * 2 ^ p) _ hpos
  have zt2 := NLogN.zsz_tdiv_le (2 ^ k * y * 2 ^ p) _ hpos
  have t43 : (scSt2 s k Bz x y).top 43 = ceilSqrt (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat := by
    simp (config := {decide := true}) [scSt2, NLogN.scSt, IState.top, IState.upd_G]
  set Bb := 2 * (p + k + Bz) + 10 with hBb
  simp only [scaleThen, NLogN.RS.seqL, RS.cost]
  rw [hrun]
  refine le_trans (add_le_add (pushCost_le _ _ Bb ?_) (add_le_add (pushCost_le _ _ Bb ?_)
    (add_le_add hcost (add_le_add (pushCost_le _ _ (Bb + 2) (tdivE_bnd _ _ _ Bb ?_ ?_ ?_))
    (add_le_add (pushCost_le _ _ (Bb + 2) (tdivE_bnd _ _ _ Bb ?_ ?_ ?_)) le_rfl))))) ?_
  all_goals simp (config := {decide := true}) only [Ex.Bnd, Ex.eval, IState.top, RS.run_push_G,
    RS.run_pop_G, IState.upd_G, NLogN.scSt, scSt2, scBE, if_true, if_false, List.tail_cons, h10, h11,
    h14, Int.toNat_natCast]
  all_goals (repeat' apply And.intro)
  all_goals first
    | exact hpos
    | omega
    | skip
  simp only [tdivE, Ex.fdiv, Ex.size]
  have h1 : (Bb + 2) ^ 2 ≤ (2 * (p + k + Bz) + 14) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have h2 : (Bb + 2 + 2) ^ 2 ≤ (2 * (p + k + Bz) + 14) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have h3 : Bb ≤ (2 * (p + k + Bz) + 14) ^ 2 := by nlinarith
  generalize (2 * (p + k + Bz) + 14) ^ 2 = Z at *
  generalize (Bb + 2) ^ 2 = Y1 at *
  generalize (Bb + 2 + 2) ^ 2 = Y2 at *
  linarith

set_option maxHeartbeats 4000000 in
theorem scaleZP_cost (p k Bz : ℕ) (x y : ℤ) (hx : |x| < 2 ^ Bz) (hy : |y| < 2 ^ Bz)
    (s : IState HS) (L10 L11 L12 L13 L14 : List Item)
    (h10 : s.G 10 = .int p :: L10) (h11 : s.G 11 = .int k :: L11) (h12 : s.G 12 = .int x :: L12)
    (h13 : s.G 13 = .int y :: L13) (h14 : s.G 14 = .int Bz :: L14) :
    scaleZP.cost s ≤ scaleCost p k Bz := by
  obtain ⟨hV0, zW1, zW2, zx, zy, zV, zWW1, zWW2, z4p, zc, zk, zp, zB, zpp, zkB, zkB1, z1, zP,
    zWP1, zWP2, zK⟩ := scale_facts p k Bz x y hx hy
  have hG : ∀ j : Fin HS, j ∉ (NLogN.RS.ite scCondE scaleThen scaleElse).writes →
      ((NLogN.RS.ite scCondE scaleThen scaleElse).run (NLogN.scSt s k x y)).G j = (NLogN.scSt s k x y).G j :=
    fun j hj => RS.run_G_of_not_mem _ _ j hj
  have g19 := hG 19 (by simp (config := {decide := true}) [RS.writes, scaleThen, scaleElse,
    ceilSqrtP, isqrtP, NLogN.RS.seqL])
  have g18 := hG 18 (by simp (config := {decide := true}) [RS.writes, scaleThen, scaleElse,
    ceilSqrtP, isqrtP, NLogN.RS.seqL])
  have g17 := hG 17 (by simp (config := {decide := true}) [RS.writes, scaleThen, scaleElse,
    ceilSqrtP, isqrtP, NLogN.RS.seqL])
  have e19 : ((NLogN.RS.ite scCondE scaleThen scaleElse).run (NLogN.scSt s k x y)).top 19 = (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) := by
    simp only [IState.top]; rw [g19]; simp (config := {decide := true}) [NLogN.scSt, IState.upd_G]
  have e18 : ((pop 19).run ((NLogN.RS.ite scCondE scaleThen scaleElse).run (NLogN.scSt s k x y))).top 18 =
      2 ^ k * y := by
    simp only [IState.top]; rw [RS.run_pop_G, if_neg (by decide), g18]
    simp (config := {decide := true}) [NLogN.scSt, IState.upd_G]
  have e17 : ((pop 18).run ((pop 19).run ((NLogN.RS.ite scCondE scaleThen scaleElse).run
      (NLogN.scSt s k x y)))).top 17 = 2 ^ k * x := by
    simp only [IState.top]
    rw [RS.run_pop_G, if_neg (by decide), RS.run_pop_G, if_neg (by decide), g17]
    simp (config := {decide := true}) [NLogN.scSt, IState.upd_G]
  have hce := scCond_eval s p k x y h10
  have zc' : zsz (scCondE.eval (NLogN.scSt s k x y)) ≤ 2 * p + 2 * (k + Bz + 1) + 2 := by rw [hce]; exact zc
  set Bb := 2 * (p + k + Bz) + 10 with hBb
  have hbr : (if scCondE.eval (NLogN.scSt s k x y) < 0 then scaleThen.cost (NLogN.scSt s k x y)
      else scaleElse.cost (NLogN.scSt s k x y)) ≤ ceilSqrtCost (zsz (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y))) (k + Bz + 1) +
        10 ^ 10 * (2 * (p + k + Bz) + 14) ^ 2 := by
    split_ifs with hc
    · rw [hce] at hc
      exact scaleThen_cost p k Bz x y hx hy s L10 L11 L12 L13 L14 h10 h11 h12 h13 h14 hc
    · simp only [scaleElse, NLogN.RS.seqL, RS.cost]
      refine le_trans (add_le_add (pushCost_le _ _ Bb ?_) (pushCost_le _ _ Bb ?_)) ?_
      · simp (config := {decide := true}) [Ex.Bnd, IState.top, NLogN.scSt, IState.upd_G]
        omega
      · simp (config := {decide := true}) [Ex.Bnd, IState.top, NLogN.scSt, IState.upd_G, RS.run_push_G]
        omega
      · simp only [Ex.size]
        have h1 : (Bb + 2) ^ 2 ≤ (2 * (p + k + Bz) + 14) ^ 2 := Nat.pow_le_pow_left (by omega) 2
        generalize (2 * (p + k + Bz) + 14) ^ 2 = Z at *
        generalize (Bb + 2) ^ 2 = Y at *
        linarith
  have hpp : ((p : ℤ) + p).toNat = p + p := by omega
  simp only [scaleZP, NLogN.RS.seqL, RS.cost]
  rw [scSt_eq p k Bz x y s L10 L11 L12 L13 L14 h10 h11 h12 h13 h14, e19, e18, e17]
  refine le_trans (add_le_add (pushCost_le _ _ Bb ?_) (add_le_add (pushCost_le _ _ Bb ?_)
    (add_le_add (pushCost_le _ _ Bb ?_) (add_le_add (add_le_add (add_le_add (add_le_add
    (pushCost_le _ _ Bb ?_) le_rfl) le_rfl) hbr) le_rfl)))) ?_
  all_goals simp (config := {decide := true}) only [Ex.Bnd, Ex.eval, IState.top, RS.run_push_G,
    IState.upd_G, NLogN.scSt, w1E, w2E, vE, scCondE, if_true, if_false, List.tail_cons, h10, h11, h12,
    h13, Int.toNat_natCast, hpp]
  all_goals (repeat' apply And.intro)
  all_goals first
    | omega
    | skip
  simp only [Ex.size, ceilSqrtCost, scaleCost]
  generalize hS : p + k + Bz + 20 = S
  have a1 : (zsz (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) + 2 * (k + Bz + 1) + 12) ^ 2 ≤ (4 * S) ^ 2 :=
    Nat.pow_le_pow_left (by omega) 2
  have a2 : 10 ^ 11 * (k + Bz + 1 + 1) * (zsz (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) + 2 * (k + Bz + 1) + 12) ^ 2 ≤
      10 ^ 11 * S * (4 * S) ^ 2 := Nat.mul_le_mul (Nat.mul_le_mul_left _ (by omega)) a1
  have a3 : (Bb + 2) ^ 2 ≤ (2 * S) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have a4 : (2 * (p + k + Bz) + 14) ^ 2 ≤ (2 * S) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have e1 : 10 ^ 11 * S * (4 * S) ^ 2 = 16 * 10 ^ 11 * S ^ 3 := by ring
  have e2 : (2 * S) ^ 2 = 4 * S ^ 2 := by ring
  have a5 : S ^ 2 ≤ S ^ 3 := Nat.pow_le_pow_right (by omega) (by omega)
  have a6 : S ≤ S ^ 2 := by nlinarith
  rw [e1] at a2; rw [e2] at a3 a4
  generalize 10 ^ 11 * (k + Bz + 1 + 1) * (zsz (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) + 2 * (k + Bz + 1) + 12) ^ 2 = Cs at *
  generalize (Bb + 2) ^ 2 = Y at *
  generalize (2 * (p + k + Bz) + 14) ^ 2 = Y' at *
  generalize S ^ 3 = W3 at *
  generalize S ^ 2 = W2 at *
  omega

theorem scaleZP_spec (p k Bz : ℕ) (x y : ℤ) (hx : |x| < 2 ^ Bz) (hy : |y| < 2 ^ Bz)
    (s : IState HS) (L10 L11 L12 L13 L14 : List Item)
    (h10 : s.G 10 = .int p :: L10) (h11 : s.G 11 = .int k :: L11) (h12 : s.G 12 = .int x :: L12)
    (h13 : s.G 13 = .int y :: L13) (h14 : s.G 14 = .int Bz :: L14) :
    scaleZP.ok s ∧ scaleZP.run s = (s.upd 15 (.int (scaleZ p k (x, y)).1 :: s.G 15)).upd 16
      (.int (scaleZ p k (x, y)).2 :: s.G 16) ∧ scaleZP.cost s ≤ scaleCost p k Bz :=
  ⟨scaleZP_ok p k Bz x y hx hy s L10 L11 L12 L13 L14 h10 h11 h12 h13 h14,
    scaleZP_run p k Bz x y hx hy s L10 L11 L12 L13 L14 h10 h11 h12 h13 h14,
    scaleZP_cost p k Bz x y hx hy s L10 L11 L12 L13 L14 h10 h11 h12 h13 h14⟩

end NLogN

end

section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS IntMul.HvdH
theorem solution (s : NLogN.IState NLogN.HS) (h10 : s.IsInt 10) (h10' : 0 ≤ s.top 10)
    (h11 : s.IsInt 11) (h11' : 0 ≤ s.top 11) (h12 : s.IsInt 12) (h13 : s.IsInt 13)
    (h14 : s.IsInt 14) (h14' : 0 ≤ s.top 14) (hx : |s.top 12| < 2 ^ (s.top 14).toNat)
    (hy : |s.top 13| < 2 ^ (s.top 14).toNat) :
    NLogN.scaleZP.ok s ∧ NLogN.scaleZP.run s = (s.upd 15 (.int (scaleZ (s.top 10).toNat (s.top 11).toNat
      (s.top 12, s.top 13)).1 :: s.G 15)).upd 16 (.int (scaleZ (s.top 10).toNat (s.top 11).toNat
      (s.top 12, s.top 13)).2 :: s.G 16) ∧
    NLogN.scaleZP.cost s ≤ NLogN.scaleCost (s.top 10).toNat (s.top 11).toNat (s.top 14).toNat := by
  obtain ⟨L10, e10⟩ := NLogN.top_toNat_G h10 h10'
  obtain ⟨L11, e11⟩ := NLogN.top_toNat_G h11 h11'
  obtain ⟨L12, e12⟩ := h12
  obtain ⟨L13, e13⟩ := h13
  obtain ⟨L14, e14⟩ := NLogN.top_toNat_G h14 h14'
  exact NLogN.scaleZP_spec _ _ _ _ _ hx hy s L10 L11 L12 L13 L14 e10 e11 e12 e13 e14
end
