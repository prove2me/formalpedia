-- title:
--   Paper Parameters: explicit upper bound of is Optimal Number
-- statement:
--   Any relationally optimal pebbling number is bounded above by the explicit
--   constant generated by the formal upper-bound construction.
--
--   Source: https://github.com/LeanPool/lean-pool/blob/e110decb9d02249d99fa85a144e6a659dea91440/LeanPool/PebblingLean/UpperBoundParameters.lean#L5764-L5781
-- source:
--   https://github.com/LeanPool/lean-pool/blob/e110decb9d02249d99fa85a144e6a659dea91440/LeanPool/PebblingLean/UpperBoundParameters.lean#L5764-L5781

module
public import Definitions.Def_LeanPool_PebblingLean_UpperBoundLoss
public import Definitions.Def_LeanPool_PebblingLean_LowerBound
public import Mathlib.Analysis.Complex.ExponentialBounds
public import Mathlib.Analysis.SpecialFunctions.Pow.NNReal
public import Definitions.Def_LeanPool_PebblingLean_UpperBoundParameters
set_option autoImplicit true
@[expose] public section
public section
open PebblingLean
open PebblingLean.Hypercube
open PebblingLean.Hypercube.PaperParameters

theorem PebblingLean.Hypercube.PaperParameters.explicit_upper_bound_of_isOptimalNumber {n k : ℕ}
    (hopt : Pebbling.IsOptimalNumber (graph n) k) :
    (k : ℝ) ≤
      (Real.exp (4 * loss explicitCutoff) *
        finiteBaseNormalizedBound (recursiveCostBound 217 explicitCutoff)
          explicitCutoff) *
        (((4 : ℝ) / 3) ^ n) := by sorry
