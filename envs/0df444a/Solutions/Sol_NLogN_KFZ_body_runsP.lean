    GB (p + 2) (aLz p h D sv t) :=
  gb_of_box (length_aLz p h D sv t) (Phases.norm_le (phases_at hst hT))

theorem gb_tLz (htl : t (Fin.last D) = 2 ^ (h + 1)) : GB (p + 2) (tLz p h D t) :=
  gb_of_box (length_tLz p h D htl) (Phases.norm_le (phases_θt htl))

theorem gb_iLz (htl : t (Fin.last D) = 2 ^ (h + 1)) : GB (p + 2) (iLz p h D t) :=
  gb_of_box (length_iLz p h D htl) (Phases.norm_le (phases_θit htl))

