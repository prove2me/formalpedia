open NLogN
open NLogN.KFH
open IntMul RS AModel KIL KFD KFB Complex
variable {P K D S ρ : ℕ}
theorem solution (hρ : ρ < K) (hD : 1 ≤ D) {r : ℕ} (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P)
    {Cprog : NLogN.RS} {dC : ℕ} {kC : ℕ → ℕ}
    (hCimpl : NLogN.KFH.LImpl (P := P) (S := S) hρ r (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D))
      Cprog D dC kC) :
    NLogN.KFH.LImpl (P := P) (S := S) hρ r (Butterfly.tens Butterfly.Cinv : Butterfly.Op (Fin D))
      (.seq (.seq (.seq (NLogN.KFH.kersP K D S ρ P r NLogN.KFH.MZ ((List.finRange D).map Fin.val)) Cprog)
        (NLogN.KFH.kersP K D S ρ P r NLogN.KFH.MZ ((List.finRange D).map Fin.val))) (NLogN.KFH.kerP K D S ρ P r 0 (NLogN.KFH.MU D)))
      (0 * D + D + 0 * D + 0) (2 * D + dC + 2 * D + 2)
      (fun w => D * NLogN.KFH.ck (AModel.vol (Butterfly.layerShape P K D S) * r)
          (NLogN.zsz ((12 * (AModel.vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ)) (w + 2 * D) + 1 +
        kC (w + 2 * D) +
        (D * NLogN.KFH.ck (AModel.vol (Butterfly.layerShape P K D S) * r)
          (NLogN.zsz ((12 * (AModel.vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ)) (w + (2 * D + dC) + 2 * D)
          + 1) +
        NLogN.KFH.ck (AModel.vol (Butterfly.layerShape P K D S) * r)
          (NLogN.zsz ((12 * (AModel.vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ)) (w + (2 * D + dC + 2 * D))) := by
  have LZ := NLogN.KFH.limpl_tens (P := P) (S := S) (D := D) hρ hr hS hP NLogN.KFH.MZ_ok NLogN.KFH.kerOk_MZ _ le_rfl
  have LU := NLogN.KFH.limpl_ker (P := P) (S := S) hρ ⟨0, hD⟩ hr hS hP (M := NLogN.KFH.MU D)
    ⟨NLogN.KFB.Sm_ipw _, NLogN.KFB.Sm_zero, NLogN.KFB.Sm_zero, NLogN.KFB.Sm_ipw _⟩ (NLogN.KFH.kerOk_MU D) _ le_rfl
  refine (((LZ.comp hCimpl).comp LZ).comp LU).congrT ?_
  rw [NLogN.KFH.tensF_kerAt_smul_one, Butterfly.tens_Cinv', Butterfly.tens_Zm, Fintype.card_fin,
    smul_mul_assoc, one_mul, mul_assoc]
