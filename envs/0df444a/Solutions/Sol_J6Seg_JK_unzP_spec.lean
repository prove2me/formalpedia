theorem unzP_spec_sol_aux {x : List GI} {l lg : List ℤ} {B : ℕ} (h0 : F 0 = gflat x ++ l)
    (hRE : F RE = []) (hIM : F IM = []) (hCR : F CR = []) (hG : F HG = (x.length : ℤ) :: lg)
    (hB : GBnd B x) (hzB : zsz (x.length : ℤ) ≤ B) :
    Sp unzP (encK s F) (encK s (update (update (update F 0 l) RE (x.map Prod.fst).reverse) IM
      (x.map Prod.snd).reverse)) (x.length * 10 ^ 5 * (B + 2) + 10 ^ 5 * (B + 2)) := by
  set Fk : ℕ → Fin HS → List ℤ := fun k => update (update (update F 0 (gflat (x.drop k) ++ l)) RE
    ((x.take k).map Prod.fst).reverse) IM ((x.take k).map Prod.snd).reverse with hFk
  have e0 : Fk 0 = F := by
    funext j; simp only [hFk, List.drop_zero, List.take_zero, List.map_nil, List.reverse_nil,
      update_apply]
    split_ifs with h1 h2 h3 <;> subst_vars <;> simp_all +decide
  have hBx : ∀ k (hk : k < x.length), zsz x[k].1 ≤ B ∧ zsz x[k].2 ≤ B := fun k hk =>
    ⟨hB _ (List.mem_flatMap.2 ⟨x[k], List.getElem_mem hk, by simp⟩),
      hB _ (List.mem_flatMap.2 ⟨x[k], List.getElem_mem hk, by simp⟩)⟩
  have hCk : ∀ k, Fk k CR = [] := fun k => by simp +decide [hFk, update_apply, hCR]
  have H := Sp.rep (s := s) (C := CR) (n := .reg HG)
    (b := .seq (.push RE (.reg 0)) (.seq (.pop 0) (.seq (.push IM (.reg 0)) (.pop 0))))
    (F := Fk) (N := x.length) (B := B) (c := 10 ^ 4 * (B + 2)) (by decide) hCk
    (by simp +decide [RS.writes]) (RS.clean_of_lt (by decide)) (by rw [e0]; exact isInt_encK hG)
    trivial (by rw [e0]; simp only [Ex.Bnd, top_encK hG]; exact hzB)
    (by rw [e0]; simp [Ex.eval, top_encK hG]) (fun k hk => by
      obtain ⟨b1, b2⟩ := hBx k hk
      have hd : x.drop k = x[k] :: x.drop (k + 1) := List.drop_eq_getElem_cons hk
      set H0 := update (Fk k) CR [(x.length : ℤ) - k] with hH0
      have g0 : H0 0 = x[k].1 :: (x[k].2 :: (gflat (x.drop (k + 1)) ++ l)) := by
        rw [hH0, update_of_ne (by decide)]
        simp +decide only [hFk, update_apply, ↓reduceIte]
        rw [hd, gflat_cons]; rfl
      have s1 := Sp.push (s := s) (f := H0) (i := RE) (e := .reg 0) (B := B) (by decide)
        (RS.clean_of_lt (by decide)) (isInt_encK g0) trivial (by simp only [Ex.Bnd, top_encK g0]; exact b1)
      rw [show (Ex.reg (S := HS) 0).eval (encK s H0) = x[k].1 from top_encK g0] at s1
      have g1 : update H0 RE (x[k].1 :: H0 RE) 0 = x[k].1 :: (x[k].2 :: (gflat (x.drop (k + 1)) ++ l)) := by
        rw [update_of_ne (by decide), g0]
      have s2 := Sp.pop (s := s) (f := _) (B := B) (by decide) g1 b1
      have g2 : update (update H0 RE (x[k].1 :: H0 RE)) 0 (x[k].2 :: (gflat (x.drop (k + 1)) ++ l)) 0 =
          x[k].2 :: (gflat (x.drop (k + 1)) ++ l) := by simp
      have s3 := Sp.push (s := s) (f := _) (i := IM) (e := .reg 0) (B := B) (by decide)
        (RS.clean_of_lt (by decide)) (isInt_encK g2) trivial (by simp only [Ex.Bnd, top_encK g2]; exact b2)
      rw [show (Ex.reg (S := HS) 0).eval _ = x[k].2 from top_encK g2] at s3
      have g3 : update (update (update H0 RE (x[k].1 :: H0 RE)) 0 (x[k].2 :: (gflat (x.drop (k + 1)) ++ l)))
          IM (x[k].2 :: update (update H0 RE (x[k].1 :: H0 RE)) 0
            (x[k].2 :: (gflat (x.drop (k + 1)) ++ l)) IM) 0 = x[k].2 :: (gflat (x.drop (k + 1)) ++ l) := by
        simp +decide
      have s4 := Sp.pop (s := s) (f := _) (B := B) (by decide) g3 b2
      refine ((s1.seq (s2.seq (s3.seq s4))).congr ?_).mono ?_
      · congr 1
        have tk : x.take (k + 1) = x.take k ++ [x[k]] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hk]; rfl
        have r1 : ((x.take (k + 1)).map Prod.fst).reverse = x[k].1 :: ((x.take k).map Prod.fst).reverse := by
          rw [tk, List.map_append, List.reverse_append]; rfl
        have r2 : ((x.take (k + 1)).map Prod.snd).reverse = x[k].2 :: ((x.take k).map Prod.snd).reverse := by
          rw [tk, List.map_append, List.reverse_append]; rfl
        funext j
        simp only [hH0, hFk, update_apply]
        by_cases j1 : j = 0
        · subst j1; simp +decide
        by_cases j2 : j = RE
        · subst j2; rw [r1]; simp +decide
        by_cases j3 : j = IM
        · subst j3; rw [r2]; simp +decide
        simp [j1, j2, j3]
      · simp only [Ex.size]; omega)
  rw [e0] at H
  refine (H.congr ?_).mono ?_
  · congr 1; simp [hFk]
    rw [List.take_of_length_le (by simp), List.take_of_length_le (by simp)]
  · simp only [Ex.size]; nlinarith

