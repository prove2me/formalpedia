open MarkovProcess.LifetimePath in

theorem MarkovProcess.LifetimePath.continuous_coordinate_before (ω : LifetimePath α) :
    Continuous (fun t : {t : NNReal // (t : ENNReal) < ω.lifetime} ↦
      coordinate t ω) := by sorry
