open MeasureTheory ProbabilityTheory InnerProductSpace RealInnerProductSpace AvgLMS.Expect in
theorem solution {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ] {d : ℕ}
    (x z : ℕ → Ω → Hs d) (H : Hs d →L[ℝ] Hs d) (θstar : Hs d) (R σ : ℝ)
    (hA : LMSAssumptions μ x z H θstar R σ)
    (γ : ℝ) (hγ0 : 0 < γ) (hγR : γ * R ^ 2 ≤ 1) (η0 : Hs d) (n : ℕ) (hn : 1 ≤ n) :
    Integrable (fun ω => ⟪avg (biasIter γ η0 x) (n - 1) ω,
      H (avg (biasIter γ η0 x) (n - 1) ω)⟫_ℝ) μ ∧
    ∫ ω, ⟪avg (biasIter γ η0 x) (n - 1) ω, H (avg (biasIter γ η0 x) (n - 1) ω)⟫_ℝ ∂μ ≤
      ‖η0‖ ^ 2 / (n * γ) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  simp only [Nat.add_sub_cancel]
  have hmη : ∀ k, Measurable (biasIter γ η0 x k) := AvgLMSC2.bias_meas hA γ η0
  have ham : Measurable (avg (biasIter γ η0 x) m) := by
    unfold avg
    refine Measurable.const_smul ?_ (((m : ℝ) + 1)⁻¹)
    exact Finset.measurable_sum _ fun k _ => hmη k
  have hgm : Measurable fun ω => ⟪avg (biasIter γ η0 x) m ω, H (avg (biasIter γ η0 x) m ω)⟫_ℝ :=
    ham.inner (H.continuous.measurable.comp ham)
  have hg0 : ∀ ω, 0 ≤ ⟪avg (biasIter γ η0 x) m ω, H (avg (biasIter γ η0 x) m ω)⟫_ℝ :=
    fun ω => AvgLMSC2.q_nonneg hA _
  have hc : (0 : ℝ) < (m : ℝ) + 1 := by positivity
  have hgle : ∀ ω, ⟪avg (biasIter γ η0 x) m ω, H (avg (biasIter γ η0 x) m ω)⟫_ℝ ≤
      ((m : ℝ) + 1)⁻¹ * ∑ k ∈ Finset.range (m + 1),
        ⟪biasIter γ η0 x k ω, H (biasIter γ η0 x k ω)⟫_ℝ := by
    intro ω
    unfold avg
    rw [AvgLMSC2.q_smul]
    have h := AvgLMSC2.q_sum_le hA (Finset.range (m + 1)) (fun k => biasIter γ η0 x k ω)
    rw [Finset.card_range] at h
    push_cast at h
    calc ((m : ℝ) + 1)⁻¹ ^ 2 * ⟪∑ k ∈ Finset.range (m + 1), biasIter γ η0 x k ω,
          H (∑ k ∈ Finset.range (m + 1), biasIter γ η0 x k ω)⟫_ℝ
        ≤ ((m : ℝ) + 1)⁻¹ ^ 2 * (((m : ℝ) + 1) * ∑ k ∈ Finset.range (m + 1),
          ⟪biasIter γ η0 x k ω, H (biasIter γ η0 x k ω)⟫_ℝ) := by gcongr
      _ = _ := by field_simp
  have hS : ∑ k ∈ Finset.range (m + 1),
      ∫⁻ ω, ENNReal.ofReal ⟪biasIter γ η0 x k ω, H (biasIter γ η0 x k ω)⟫_ℝ ∂μ ≤
      ENNReal.ofReal (‖η0‖ ^ 2 / γ) := by
    rw [ENNReal.ofReal_div_of_pos hγ0, ENNReal.le_div_iff_mul_le
      (Or.inl (by simp [hγ0])) (Or.inl ENNReal.ofReal_ne_top), mul_comm]
    exact le_trans le_add_self (AvgLMSC2.telescope hA γ hγ0 hγR η0 (m + 1))
  have hlin : ∫⁻ ω, ENNReal.ofReal
      ⟪avg (biasIter γ η0 x) m ω, H (avg (biasIter γ η0 x) m ω)⟫_ℝ ∂μ ≤
      ENNReal.ofReal (‖η0‖ ^ 2 / (((m + 1 : ℕ) : ℝ) * γ)) := by
    calc _ ≤ ∫⁻ ω, ENNReal.ofReal ((m : ℝ) + 1)⁻¹ * ∑ k ∈ Finset.range (m + 1),
          ENNReal.ofReal ⟪biasIter γ η0 x k ω, H (biasIter γ η0 x k ω)⟫_ℝ ∂μ := by
          refine lintegral_mono fun ω => ?_
          rw [← ENNReal.ofReal_sum_of_nonneg (fun k _ => AvgLMSC2.q_nonneg hA _),
            ← ENNReal.ofReal_mul (inv_nonneg.2 hc.le)]
          exact ENNReal.ofReal_le_ofReal (hgle ω)
      _ = ENNReal.ofReal ((m : ℝ) + 1)⁻¹ * ∑ k ∈ Finset.range (m + 1),
          ∫⁻ ω, ENNReal.ofReal ⟪biasIter γ η0 x k ω, H (biasIter γ η0 x k ω)⟫_ℝ ∂μ := by
          have hqm : ∀ k, Measurable fun ω =>
              ENNReal.ofReal ⟪biasIter γ η0 x k ω, H (biasIter γ η0 x k ω)⟫_ℝ := fun k =>
            ENNReal.measurable_ofReal.comp ((hmη k).inner (H.continuous.measurable.comp (hmη k)))
          rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
            lintegral_finsetSum _ fun k _ => hqm k]
      _ ≤ ENNReal.ofReal ((m : ℝ) + 1)⁻¹ * ENNReal.ofReal (‖η0‖ ^ 2 / γ) := by gcongr
      _ = _ := by
          rw [← ENNReal.ofReal_mul (inv_nonneg.2 hc.le)]
          congr 1
          push_cast
          field_simp
  have hfin : ∫⁻ ω, ENNReal.ofReal
      ⟪avg (biasIter γ η0 x) m ω, H (avg (biasIter γ η0 x) m ω)⟫_ℝ ∂μ < ⊤ :=
    lt_of_le_of_lt hlin ENNReal.ofReal_lt_top
  refine ⟨⟨hgm.aestronglyMeasurable,
    (hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall hg0)).2 hfin⟩, ?_⟩
  rw [integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall hg0)
    hgm.aestronglyMeasurable]
  exact ENNReal.toReal_le_of_le_ofReal (by positivity) hlin
