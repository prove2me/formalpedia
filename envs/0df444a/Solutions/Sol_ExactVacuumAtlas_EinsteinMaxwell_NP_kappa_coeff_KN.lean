  ( ((try simp) <;> (try push_cast) <;> (try field_simp) <;> (
  generalize Complex.cos ((x 2 : ℝ) : ℂ) = cc at *
  generalize Complex.sin ((x 2 : ℝ) : ℂ) = ss at *
  generalize ((Sig a (x 1) (x 2) : ℝ) : ℂ) = SS at *
  generalize ((Del M a Q (x 1) : ℝ) : ℂ) = DD at *
