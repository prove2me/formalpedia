def parAt (ρ : Fin 6) (r : Fin 88) : ℕ × ℕ × ℕ := ((parTab.getD ρ []).getD r (0, 0, 0))

def wAt (ρ : Fin 6) (r : Fin 88) : ℕ := (wTab.getD ρ []).getD r 0

def cellsAt (ρ : Fin 6) (r : Fin 88) : List ((ℕ × ℕ × ℕ) × ℕ × ℕ) := ((cellTab.getD ρ []).getD r [])

def parent3 (ρ : Fin 6) (r : Fin 88) : Fin 3 → ℕ :=
  normTriple 8 (parAt ρ r).1 (parAt ρ r).2.1

theorem htotal3 (ρ : Fin 6) :
    ∀ r, parent3 ρ r 0 + parent3 ρ r 1 + parent3 ρ r 2 = 2 * (2 * 2 ^ (2 - 1)) :=
  fun r ↦ normTriple_sum 8 _ _

/-- The cell record of a level-3 split, looked up by its grade triple. -/
def cellRec (ρ : Fin 6) (r : Fin 88) (c : RecursiveThinSplit.Split (2 * 2 ^ (2 - 1)) (parent3 ρ r)) :
    ℕ × ℕ :=
  match (cellsAt ρ r).find? fun x ↦ x.1 = ((c.val 0).val, (c.val 1).val, (c.val 2).val) with
  | some x => x.2
  | none => (0, 0)

def n3 (ρ : Fin 6) (r : Fin 88) : ℕ := wAt ρ r * D ^ 3

def m3 (ρ : Fin 6) (r : Fin 88) (c : RecursiveThinSplit.Split (2 * 2 ^ (2 - 1)) (parent3 ρ r)) : ℕ :=
  wAt ρ r * (cellRec ρ r c).1 * D ^ 2

/-- The nine mode-`i` word weights of a cell, as one list indexed by `3 w0 + w1`. -/
def cellDist (ρ : Fin 6) (i : Fin 3) (r : Fin 88)
    (c : RecursiveThinSplit.Split (2 * 2 ^ (2 - 1)) (parent3 ρ r)) : List ℕ :=
  (List.range 9).map fun idx ↦
    childW (c.val 0).val (c.val 1).val (c.val 2).val (cellRec ρ r c).2 i.val (idx / 3) (idx % 3)

def mu3 (ρ : Fin 6) (i : Fin 3) (c : Cell (2 * 2 ^ (2 - 1)) 88 (parent3 ρ))
    (w : CompleteSplit.CompleteWord 2) : ℕ :=
  (m3 ρ c.1 c.2 + m3 ρ c.1 (complement (htotal3 ρ c.1) c.2)) *
    (cellDist ρ i c.1 c.2).getD (3 * (w 0).val + (w 1).val) 0 / D

