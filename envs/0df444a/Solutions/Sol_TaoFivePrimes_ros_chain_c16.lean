    · have hx2 : (gu077.lo : ℝ) < x := by
          have hb : (gu076.top : ℝ) = (gu077.lo : ℝ) := by simp [gu076, gu077]
          linarith
      by_cases h2 : x ≤ (gu077.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu078.lo : ℝ) < x := by
            have hb : (gu077.top : ℝ) = (gu078.lo : ℝ) := by simp [gu077, gu078]
            linarith
        exact s3.2 x hx3 htop

