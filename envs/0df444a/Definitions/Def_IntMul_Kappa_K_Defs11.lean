-- Source module: Solutions.KIL2Unit
/-!
# KIL2: the Lemma 10 controlled shift with unit coefficient `u = ±c` (`2 ≤ c ≤ 20`)

`shiftArr Λ i u c` with `u = c` (resp. `u = -c`), `c` a small positive integer prime to `Q`, is
done as the paper's Lemma 4: first the fixed multiplicative permutation `y ↦ c·y (mod Q)` of the
target field (`mulPc`: split into `c` increasing streams, merge by residue), then the rotation
`shP` (resp. the reflection `shN`) by the offsets `Σ_j c_j·d_j`.

* `outMul_recR`: `mulPc` computes `pull [P, Q, B] [P, Q, B] (mulAddr Q c)`.
* `mulPc_spec`: stack form, linear cost `cMulPc_le`.
* `shiftArr_u_eq`: any coefficient `u`, `shiftArr` as a pull on `[vol A, Q, vol C]`.
* `shiftArr_mul_eq`, `shiftArr_negmul_eq`: `shiftArr u = (rotation/reflection) ∘ (y ↦ c·y)`.
* `shiftArrMul_il_spec`, `shiftArrNegMul_il_spec`: the IL programs, cost
  `cMulPc + cShift = O((|A| + 1) · (V + 1) · (Bb + 2) + (Bb + 2)^2)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

/-- Output address `(p, z, b)` ↦ input address `(p, c⁻¹·z, b)`. -/
def mulAddr (Q c : ℕ) (a : List ℕ) : List ℕ := [a.getD 0 0, NLogN.KIL.yOf Q c (a.getD 1 0), a.getD 2 0]

/-! ## The shift with any coefficient as a pull on `[vol A, Q, vol C]` -/

section ShiftU

open AModelL12

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

/-- Output address `(p, y, b)` ↦ input address `(p, u⁻¹·(y − a_p), b)`. -/
def uAddr (Q : ℕ) (u : ZMod Q) (as : ℕ → ℕ) (a : List ℕ) : List ℕ :=
  [a.getD 0 0, (u⁻¹ * ((a.getD 1 0 : ZMod Q) - (as (a.getD 0 0) : ZMod Q))).val, a.getD 2 0]

/-- `u = k`: multiplicative permutation, then the self-contained rotation. -/
def shMul (Q k P B : ℕ) (ac : List (ℕ × ℕ)) : RS := .seq (mulPc P Q k B) (shP Q P B ac)

/-- `u = -k`: multiplicative permutation, then the self-contained reflection. -/
def shNMul (Q k P B : ℕ) (ac : List (ℕ × ℕ)) : RS := .seq (mulPc P Q k B) (shN Q P B ac)

/-- Cost bound of `shMul` / `shNMul`. -/
def cShiftU (nA V Bb : ℕ) : ℕ := 10 ^ 7 * (V + 1) * (Bb + 2) + cShift nA V Bb

end ShiftU

/-! ## Step runner with small unit coefficients -/

section RunU

open AModelL12

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}

/-- The coefficients handled: `±1`, and `±k` with `2 ≤ k ≤ 20`, `k` prime to `Q`. -/
def SmallUnit (Q : ℕ) (u : ZMod Q) : Prop :=
  u = 1 ∨ u = -1 ∨ (2 ≤ u.val ∧ u.val ≤ 20 ∧ Nat.Coprime Q u.val) ∨
    (2 ≤ (-u).val ∧ (-u).val ≤ 20 ∧ Nat.Coprime Q (-u).val)

/-- Shift code for small unit coefficients. -/
def scodeU : Step n Q → IStmt HS Pp
  | .shift i u c =>
    if u = 1 ∨ u = -1 then scodePM Λ (.shift i u c)
    else if 2 ≤ u.val ∧ u.val ≤ 20 ∧ Nat.Coprime Q u.val then
      (shMul Q u.val (AModel.vol (sh.take (Λ.pos i))) (AModel.vol (sh.drop (Λ.pos i + 1)))
        ((sh.take (Λ.pos i)).zip (csOf Λ c (sh.take (Λ.pos i))))).code
    else (shNMul Q (-u).val (AModel.vol (sh.take (Λ.pos i))) (AModel.vol (sh.drop (Λ.pos i + 1)))
        ((sh.take (Λ.pos i)).zip (csOf Λ c (sh.take (Λ.pos i))))).code
  | .swap _ _ => .skip

end RunU

end NLogN.KIL

end

