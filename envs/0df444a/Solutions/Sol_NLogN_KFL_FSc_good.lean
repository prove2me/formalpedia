theorem T0n_eq {K : ℕ} (hK : 1 ≤ K) (ρ : ℕ) (x y : ℕ) :
    ∀ n, T0n K ρ n x y = ((y ^^^ (x &&& selM K ρ n) : ℕ) : ℤ)
  | 0 => by simp [T0n, selM]
