theorem rotRS {T : Ex HS} {tf : ℤ → ℤ → ℤ} {Tm Rv : ℤ} (hT : SegTR T tf Bb Tm Rv)
    (sgn : ℤ) (hs : sgn = 1 ∨ sgn = -1) (hfok : fok (tabGenR sgn T) = true)
    {Q d1 d2 n : ℕ} {ru rv rw w0 : ℤ} (hv : TVal Q d1 d2 ru rv rw w0 Tm n Bb)
    {P S : ℕ} (hS : 0 < S) (hBr : 0 < Br) (hM : P * Q * S = M) (zP : zsz (P : ℤ) ≤ Bb)
    {eP eQ eB e1 e2 eu ev ew e0 en eR : Ex HS}
    (hsz : ((rotPlR eP eQ eB e1 e2 eu ev ew e0 en eR).map fun p => p.2.size + 1).sum ≤ 200)
    (hlow : ∀ p ∈ rotPlR eP eQ eB e1 e2 eu ev ew e0 en eR, KFX.NoLow p.2)
    (EP : ∀ t, E t → ESp eP t Bb (P : ℤ)) (EQ : ∀ t, E t → ESp eQ t Bb (Q : ℤ))
    (EB : ∀ t, E t → ESp eB t Bb ((S * Br : ℕ) : ℤ))
    (E1 : ∀ t, E t → ESp e1 t Bb (d1 : ℤ)) (E2 : ∀ t, E t → ESp e2 t Bb (d2 : ℤ))
    (Eu : ∀ t, E t → ESp eu t Bb ru) (Ev : ∀ t, E t → ESp ev t Bb rv)
    (Ew : ∀ t, E t → ESp ew t Bb rw) (E0 : ∀ t, E t → ESp e0 t Bb w0)
    (En : ∀ t, E t → ESp en t Bb (n : ℤ)) (ER : ∀ t, E t → ESp eR t Bb Rv) :
    RecStep I tab (rotR sgn T eP eQ eB e1 e2 eu ev ew e0 en eR) E M Br
      (rotP Q S (tabE sgn tf ru rv rw w0 d1 d2 Q n)) (cRotR T Bb n P Q (S * Br) 1 : ℕ) := by
  intro t recs R0 ht hl hb h0
  rw [← hM] at h0 ⊢
  exact ⟨_, rotRec_runs (I := I) (iprog := tab) hT sgn hs hfok hv P S Br 1 hS hBr zP t hl
    (bnd_bits (bits_flR hb _)) R0 h0 hsz hlow (EP t ht) (EQ t ht) (EB t ht) (E1 t ht) (E2 t ht)
    (Eu t ht) (Ev t ht) (Ew t ht) (E0 t ht) (En t ht) (ER t ht), le_rfl⟩

end Gen

/-! ## The layout facts of the compact phase -/

namespace PhOK

variable {l : Lay} {K ρ G n L Br : ℕ} (hP : PhOK l K ρ G n L Br)
include hP

theorem ok : l.OK := hP.kv.ok

theorem yM : l.sY ≤ l.M := le_trans (Nat.le_mul_of_pos_right _ hP.ok.ql) hP.ok.yq_le

theorem tqM : l.sT * l.QC ≤ l.M := by
  obtain ⟨kM, hkM, eM⟩ := hP.ok.kM
  exact le_of_eq_mul (c := kM) eM hkM
theorem tM : l.sT ≤ l.M := le_trans (Nat.le_mul_of_pos_right _ hP.ok.qc) hP.tqM
theorem uqT : l.sU * l.QC ≤ l.sT := by
  obtain ⟨a, ha, ea⟩ := hP.ok.kTU
  exact le_of_eq_mul (c := a) ea ha
theorem uM : l.sU ≤ l.M := le_trans (le_trans (Nat.le_mul_of_pos_right _ hP.ok.qc) hP.uqT) hP.tM
theorem z3 {v : ℕ} (h : v ≤ 3 * l.M) : zsz (v : ℤ) ≤ zsz ((l.M * Br : ℕ) : ℤ) + 3 := hP.kv.zn h

end PhOK

