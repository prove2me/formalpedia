namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-! ## Conditionals on the register file -/

theorem spIT (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {e : Ex HS} (he : InRg e)
    (hok : e.ok (encK s (RF v c))) {V : Fin HS → ℕ} {B : ℕ} (hv : ∀ j ∈ e.regs, |v j| ≤ V j)
    (hm : mg V e < 2 ^ B) (hneg : e.eval (encK s (RF v c)) < 0) {a b : RS} {t : IState HS} {ca : ℕ}
    (ha : Sp a (encK s (RF v c)) t ca) :
    Sp (.ite e a b) (encK s (RF v c)) t (cE e B + (2 * B + 2) + 25 + ca) := by
  have hB := bnd_of_mg _ V B e (RF_bnd (s := s) (c := c) he hv) hm
  refine ⟨⟨clean_of_inRg he, hok, by rw [if_pos hneg]; exact ha.1⟩,
    by simp [RS.run, hneg, ha.2.1], ?_⟩
  have h1 := pushCost_le e _ B hB
  have h2 := Ex.zsz_eval_le _ B e hB
  simp only [RS.cost, if_pos hneg]
  have := ha.2.2
  unfold cE
  omega

theorem spIF (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {e : Ex HS} (he : InRg e)
    (hok : e.ok (encK s (RF v c))) {V : Fin HS → ℕ} {B : ℕ} (hv : ∀ j ∈ e.regs, |v j| ≤ V j)
    (hm : mg V e < 2 ^ B) (hpos : ¬ e.eval (encK s (RF v c)) < 0) {a b : RS} {t : IState HS}
    {cb : ℕ} (hb : Sp b (encK s (RF v c)) t cb) :
    Sp (.ite e a b) (encK s (RF v c)) t (cE e B + (2 * B + 2) + 25 + cb) := by
  have hB := bnd_of_mg _ V B e (RF_bnd (s := s) (c := c) he hv) hm
  refine ⟨⟨clean_of_inRg he, hok, by rw [if_neg hpos]; exact hb.1⟩,
    by simp [RS.run, hpos, hb.2.1], ?_⟩
  have h1 := pushCost_le e _ B hB
  have h2 := Ex.zsz_eval_le _ B e hB
  simp only [RS.cost, if_neg hpos]
  have := hb.2.2
  unfold cE
  omega

