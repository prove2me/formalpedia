/-!
# Round-six setup, part 1: the sources by search, and the counted parameters

The setup machine picks the source `s_j` of axis `j` by scanning the candidates
`c = A_j + x` (`A_j = t_j - 2 w_j`, `x = w_j, w_j - 1, …, 1`) and keeping the last one coprime to
`2 ∏_{i<j} s_i` (`pick`, `src6`). The sieve (`J6SieveStep.step`) shows that a coprime candidate
exists once `w_j > sieveBound d r` (**`exists_cop`**), which holds for large `n`
(**`ell_big`**: `ℓ ≥ C (log₂ b + 1)^2` eventually). Then `src6` satisfies `SrcOK6`
(**`src6_ok`**).

The parameters `d, L, α` are computed by the machine as counts (`d_count6`, `L_count6`,
`α_count6`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KFM Finset

noncomputable section

/-! ## Selection -/

/-! ## The sources -/

/-! ## Existence of a coprime candidate (the sieve) -/

/-! ## `SrcOK6` for the selected sources -/

/-! ## Eventual growth of `ℓ` -/

/-- **`ℓ ≥ C (log₂ b + 1)^2` for large `n`.** -/
theorem ell_big_sol_aux (P : Prm) (hP : P.Ok) (C : ℕ) :
    ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → C * (Nat.log 2 (bP6 n) + 1) ^ 2 ≤ ℓP6 P n := by
  obtain ⟨n₀, hG⟩ := params6_ok P hP
  set e := 1 - P.ε with he
  have he0 : 0 < e := by have := hP.eps_lt; linarith
  set ρ : ℝ := (2 : ℝ) ^ e with hρ
  have hρ1 : 1 < ρ := Real.one_lt_rpow (by norm_num) he0
  have ht := tendsto_pow_const_div_const_pow_of_one_lt 2 hρ1
  have hpos : (0 : ℝ) < 1 / (8 * C + 8) := by positivity
  obtain ⟨M, hM⟩ := Filter.eventually_atTop.1 (ht.eventually (gt_mem_nhds hpos))
  refine ⟨max n₀ (2 ^ (2 ^ (M + 1))), fun n hn => ?_⟩
  have G := hG n (le_trans (le_max_left _ _) hn)
  set b := bP6 n with hb
  have hbM : 2 ^ (M + 1) ≤ b := lg_ge _ (le_trans (le_max_right _ _) hn)
  have hb1 : 1 ≤ b := bP6_pos n
  set m := Nat.log 2 b with hm
  have hmM : M + 1 ≤ m := Nat.le_log_of_pow_le (by norm_num) hbM
  have h2m : 2 ^ m ≤ b := Nat.pow_log_le_self 2 (by omega)
  have hb0 : (0 : ℝ) < b := by exact_mod_cast (show 0 < b by omega)
  -- `ℓ ≥ b^e / 2`
  have hd0 : (0 : ℝ) < dP6 P n := by exact_mod_cast G.d_pos
  have h1 : (b : ℝ) ^ e / 2 ≤ ℓP6 P n := by
    refine le_trans ?_ G.ell_ge
    have hsplit : (b : ℝ) = (b : ℝ) ^ e * (b : ℝ) ^ P.ε := by
      rw [← Real.rpow_add hb0]; simp [he]
    rw [le_div_iff₀ (by positivity)]
    have hdle := G.d_le
    have he1 : 0 ≤ (b : ℝ) ^ e := (Real.rpow_pos_of_pos hb0 _).le
    calc (b : ℝ) ^ e / 2 * (2 * dP6 P n) = (b : ℝ) ^ e * dP6 P n := by ring
      _ ≤ (b : ℝ) ^ e * (b : ℝ) ^ P.ε := mul_le_mul_of_nonneg_left hdle he1
      _ = b := hsplit.symm
  -- `b^e ≥ ρ^m`
  have h2 : ρ ^ m ≤ (b : ℝ) ^ e := by
    have : ((2 : ℝ) ^ m) ^ e ≤ (b : ℝ) ^ e :=
      Real.rpow_le_rpow (by positivity) (by exact_mod_cast h2m) he0.le
    have e1 : ρ ^ m = ((2 : ℝ) ^ m) ^ e := by
      rw [hρ, ← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_natCast (2 : ℝ) m,
        ← Real.rpow_mul (by norm_num), mul_comm]
    rw [e1]; exact this
  -- `(8C+8) m^2 < ρ^m`
  have h3 := hM m (by omega)
  have hρm : (0 : ℝ) < ρ ^ m := by positivity
  rw [div_lt_iff₀ hρm] at h3
  have h4 : ((8 * C + 8 : ℕ) : ℝ) * (m : ℝ) ^ 2 < ρ ^ m := by
    have := mul_lt_mul_of_pos_right h3 (show (0 : ℝ) < 8 * C + 8 by positivity)
    rw [show 1 / (8 * (C : ℝ) + 8) * ρ ^ m * (8 * C + 8) = ρ ^ m by field_simp] at this
    push_cast; linarith
  have h5 : C * (m + 1) ^ 2 ≤ (8 * C + 8) * m ^ 2 / 2 := by
    have : (m + 1) ^ 2 ≤ 4 * m ^ 2 := by nlinarith
    have : C * (m + 1) ^ 2 ≤ C * (4 * m ^ 2) := Nat.mul_le_mul_left _ this
    have e2 : (8 * C + 8) * m ^ 2 = 2 * ((4 * C + 4) * m ^ 2) := by ring
    rw [e2, Nat.mul_div_cancel_left _ (by norm_num)]
    nlinarith
  have h6 : ((C * (m + 1) ^ 2 : ℕ) : ℝ) ≤ ℓP6 P n := by
    have a1 : ((C * (m + 1) ^ 2 : ℕ) : ℝ) ≤ (((8 * C + 8) * m ^ 2 / 2 : ℕ) : ℝ) := by
      exact_mod_cast h5
    have a2 : (((8 * C + 8) * m ^ 2 / 2 : ℕ) : ℝ) ≤ ((8 * C + 8 : ℕ) : ℝ) * (m : ℝ) ^ 2 / 2 := by
      rw [le_div_iff₀ (by norm_num)]
      have : ((8 * C + 8) * m ^ 2 / 2) * 2 ≤ (8 * C + 8) * m ^ 2 := Nat.div_mul_le_self _ _
      exact_mod_cast this
    linarith
  exact_mod_cast h6

