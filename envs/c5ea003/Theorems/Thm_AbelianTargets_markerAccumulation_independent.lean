-- title:
--   Accumulating independent sets preserves independence
-- statement:
--   Let $G$ be a simple graph on an arbitrary set $X$, and let $(C_n)_{n\in\mathbb N}$ be independent vertex sets. For $S\subseteq X$, define its neighbor set $N_G(S)=\{y:\exists x\in S,\ G(x,y)\}$. Define
--   $$M_0=\varnothing,\qquad M_{n+1}=M_n\cup(C_n\setminus N_G(M_n)).$$
--   Then $M_n$ is independent in $G$ for every $n\in\mathbb N$. No topology or covering assumption is required.
-- source:
--   Ruijun Wang, Continuous graph homomorphisms of higher dimensional abelian group actions, arXiv:2609.39824v1 (30 September 2026), Sections 2–7, supporting construction for Proposition 7.1; https://arxiv.org/html/2609.39824v1. Formalization-specific helper: AbelianTargets/ClopenMarkers.lean, lines 55–71; SHA256 7555b61d55257a699bdb418732869ed00680e5f483d1794d31b47ef023996b17.

import Definitions.Def_AT260939824_ClopenMarkers
import Init
import Mathlib.Combinatorics.SimpleGraph.Basic
import Mathlib.Order.Monotone.Basic
import Mathlib.Topology.Clopen

set_option autoImplicit false

/-!
# A clopen maximal independent set from a countable clopen independent cover

This is the maximal-independent-set part of Lemma 3.1 of
arXiv:2609.39824. The graph-neighbor operator is assumed to preserve clopen
sets, as happens for graphs generated by finitely many homeomorphisms.
The existence of the countable independent cover is a separate input.
-/
namespace AbelianTargets
end AbelianTargets
open AbelianTargets
universe u
variable {X : Type u} (G : SimpleGraph X)
variable {G}

theorem AbelianTargets.markerAccumulation_independent (C : ℕ → Set X)
    (hindep : ∀ n, GraphIndependent G (C n)) (n : ℕ) :
    GraphIndependent G (markerAccumulation G C n) := by sorry
