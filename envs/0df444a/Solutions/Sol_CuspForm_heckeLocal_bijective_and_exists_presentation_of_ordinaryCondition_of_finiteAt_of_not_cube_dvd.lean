theorem GaloisRepAdic.isUnramifiedAt_of_baseChangeAlong_injective {A B : Type} [CommRing A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B] (φ : A →+* B) (hφ : IsLocalHom φ) (hinj : Function.Injective φ)
    (ρ : GaloisRepAdic A) {q : ℕ} (h : (ρ.baseChangeAlong φ hφ).IsUnramifiedAt q) : ρ.IsUnramifiedAt q := by
  intro P hP σ hσ
  have h1 := h P hP σ hσ
  refine LadderDescent.eq_of_baseChange_eq φ hφ hinj ρ _ _ ?_
  letI : Algebra A B := φ.toAlgebra
  change (ρ.baseChangeAlong φ hφ).ρ σ = _
  rw [h1, LinearMap.baseChange_one]
  rfl

