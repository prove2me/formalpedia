      RS.asgCost i (RS.decE i) (b.run (RS.repSt i n b s k)) + 30) ≤
      (n.eval s).toNat * (C + 8000 * (B + 2) + 30) := by
    have := Finset.sum_le_sum (s := Finset.range (n.eval s).toNat)
      (f := fun k => b.cost (RS.repSt i n b s k) +
        RS.asgCost i (RS.decE i) (b.run (RS.repSt i n b s k)) + 30)
