theorem nodup_mvL : (NLogN.KFL.mvL κ M).Nodup := (List.nodup_reverse.2 List.nodup_range).filter _

theorem mem_mvL {m : ℕ} : m ∈ NLogN.KFL.mvL κ M ↔ m < M ∧ κ m ≠ m := by
  simp [NLogN.KFL.mvL]

