theorem PI.QmRowExpWork.rowLast {A : Type*} [Ring A] [Algebra ℂ A] {n m : ℕ} (E : Fin n → Fin n → A)
    (a b : Fin (m + 1) → Fin n) (u : ℂ) :
    qminorRow E a b u = ∑ j : Fin (m + 1), (((-1 : ℤ) ^ (m + (j : ℕ)) : ℤ) : A) *
      (qminorRow E (a ∘ Fin.castSucc) (b ∘ j.succAbove) (u - 1) * Tm E u (a (Fin.last m)) (b j)) := by sorry
