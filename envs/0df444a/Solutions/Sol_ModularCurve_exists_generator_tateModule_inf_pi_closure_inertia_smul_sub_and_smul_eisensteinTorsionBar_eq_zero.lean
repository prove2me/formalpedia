variable [Module HeckeAlg (JZero p)]

theorem tateHeckeRep_mem_tateSub {S : AddSubgroup (JZero p)} {t : HeckeAlg}
    (hS : ∀ x ∈ S, t • x ∈ S) {s : _root_.TateModule 2 (JZero p)} (hs : s ∈ tateSub p S) :
    tateHeckeRep 2 (JZero p) t s ∈ tateSub p S := fun n => by
  rw [coe_tateHeckeRep_apply_apply]
  exact hS _ (hs n)

theorem adjoin_apply_mem_tateSub {S : AddSubgroup (JZero p)}
    (hS : ∀ t : HeckeAlg, ∀ x ∈ S, t • x ∈ S)
    {α : Module.End ℤ_[2] (_root_.TateModule 2 (JZero p))}
    (hα : α ∈ Algebra.adjoin ℤ_[2] (Set.range fun t : HeckeAlg => tateHeckeRep 2 (JZero p) t))
    {s : _root_.TateModule 2 (JZero p)} (hs : s ∈ tateSub p S) : α s ∈ tateSub p S := by
  induction hα using Algebra.adjoin_induction generalizing s with
  | mem x hx =>
      obtain ⟨t, rfl⟩ := hx
      exact tateHeckeRep_mem_tateSub p (hS t) hs
  | algebraMap r =>
      rw [Module.algebraMap_end_apply]
      exact Submodule.smul_mem _ r hs
  | add x y _ _ hx hy =>
      rw [LinearMap.add_apply]
      exact Submodule.add_mem _ (hx hs) (hy hs)
  | mul x y _ _ hx hy =>
      rw [Module.End.mul_apply]
      exact hx (hy hs)

theorem tateHeckeRep_comm :
    ∀ a ∈ (Set.range fun t : HeckeAlg => tateHeckeRep 2 (JZero p) t),
      ∀ b ∈ (Set.range fun t : HeckeAlg => tateHeckeRep 2 (JZero p) t), a * b = b * a := by
  rintro _ ⟨s, rfl⟩ _ ⟨t, rfl⟩
  show tateHeckeRep 2 (JZero p) s * tateHeckeRep 2 (JZero p) t =
    tateHeckeRep 2 (JZero p) t * tateHeckeRep 2 (JZero p) s
  rw [← map_mul, ← map_mul, mul_comm]

theorem algebraMap_natCast_eq (n : ℕ) :
    algebraMap ℤ_[2] (Module.End ℤ_[2] (_root_.TateModule 2 (JZero p))) (n : ℤ_[2]) =
      tateHeckeRep 2 (JZero p) (n : HeckeAlg) :=
  (map_natCast (algebraMap ℤ_[2] (Module.End ℤ_[2] (_root_.TateModule 2 (JZero p)))) n).trans
    (map_natCast (tateHeckeRep 2 (JZero p)) n).symm

