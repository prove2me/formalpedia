p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open IsDedekindDomain NumberField

section

variable (F : Type) [Field F] [NumberField F]

private theorem finRoot₁_nonneg (v : HeightOneSpectrum (𝓞 F)) (g : AdelicGL 3 (𝓞 F) F) : 0 ≤ finRoot₁ F v g := by
  unfold finRoot₁ detSize lastRowSup
  positivity

private theorem finRoot₂_nonneg (v : HeightOneSpectrum (𝓞 F)) (g : AdelicGL 3 (𝓞 F) F) : 0 ≤ finRoot₂ F v g := by
  unfold finRoot₂ minorSup
  positivity

private theorem archRoot₁_nonneg (w : InfinitePlace F) (g : AdelicGL 3 (𝓞 F) F) : 0 ≤ archRoot₁ F w g := by
  unfold archRoot₁ detSize lastRowEucl
  positivity

private theorem archRoot₂_nonneg (w : InfinitePlace F) (g : AdelicGL 3 (𝓞 F) F) : 0 ≤ archRoot₂ F w g := by
  unfold archRoot₂ minorEucl
  positivity

private theorem rootSizeProd_nonneg (g : AdelicGL 3 (𝓞 F) F) : 0 ≤ rootSizeProd F g := by
  unfold rootSizeProd
  exact mul_nonneg (finprod_nonneg fun v => mul_nonneg (finRoot₁_nonneg F v g) (finRoot₂_nonneg F v g))
    (Finset.prod_nonneg fun w _ => mul_nonneg (archRoot₁_nonneg F w g) (archRoot₂_nonneg F w g))

private theorem archRootSum_nonneg (g : AdelicGL 3 (𝓞 F) F) : 0 ≤ archRootSum F g := by
  unfold archRootSum
  exact Finset.sum_nonneg fun w _ => add_nonneg (archRoot₁_nonneg F w g) (archRoot₂_nonneg F w g)

variable {F}

private structure IsDiagonalTorusAt (T : AdelicGL 3 (𝓞 F) F) (b c : (v : HeightOneSpectrum (𝓞 F)) → v.adicCompletion F)
    (b' c' : (w : InfinitePlace F) → w.Completion) : Prop where
  fin : ∀ v, ((componentAt3 (𝓞 F) F v T : GL (Fin 3) (v.adicCompletion F)) :
    Matrix (Fin 3) (Fin 3) (v.adicCompletion F)) = Matrix.diagonal ![b v * c v, c v, 1]
  arch : ∀ w, ((archPlaceComponent3 F w T : GL (Fin 3) w.Completion) : Matrix (Fin 3) (Fin 3) w.Completion) =
    Matrix.diagonal ![b' w * c' w, c' w, 1]
  b_ne : ∀ v, b v ≠ 0
  c_ne : ∀ v, c v ≠ 0
  b'_ne : ∀ w, b' w ≠ 0
  c'_ne : ∀ w, c' w ≠ 0

variable {T : AdelicGL 3 (𝓞 F) F} {b c : (v : HeightOneSpectrum (𝓞 F)) → v.adicCompletion F}
  {b' c' : (w : InfinitePlace F) → w.Completion}

private theorem IsDiagonalTorusAt.finRoot₁_mul (h : IsDiagonalTorusAt T b c b' c') (v : HeightOneSpectrum (𝓞 F))
    (g : AdelicGL 3 (𝓞 F) F) : finRoot₁ F v (T * g) = ‖b v‖ * finRoot₁ F v g :=
  (finRoot_mul_of_componentAt3_eq F T g v (b v) (c v) (h.c_ne v) (h.fin v)).1

private theorem IsDiagonalTorusAt.finRoot₂_mul (h : IsDiagonalTorusAt T b c b' c') (v : HeightOneSpectrum (𝓞 F))
    (g : AdelicGL 3 (𝓞 F) F) : finRoot₂ F v (T * g) = ‖c v‖ * finRoot₂ F v g :=
  (finRoot_mul_of_componentAt3_eq F T g v (b v) (c v) (h.c_ne v) (h.fin v)).2

private theorem IsDiagonalTorusAt.archRoot₁_mul (h : IsDiagonalTorusAt T b c b' c') (w : InfinitePlace F)
    (g : AdelicGL 3 (𝓞 F) F) : archRoot₁ F w (T * g) = ‖b' w‖ * archRoot₁ F w g :=
  (archRoot_mul_of_archPlaceComponent3_eq F T g w (b' w) (c' w) (h.c'_ne w) (h.arch w)).1

private theorem IsDiagonalTorusAt.archRoot₂_mul (h : IsDiagonalTorusAt T b c b' c') (w : InfinitePlace F)
    (g : AdelicGL 3 (𝓞 F) F) : archRoot₂ F w (T * g) = ‖c' w‖ * archRoot₂ F w g :=
  (archRoot_mul_of_archPlaceComponent3_eq F T g w (b' w) (c' w) (h.c'_ne w) (h.arch w)).2

private noncomputable def IsDiagonalTorusAt.archSize (_h : IsDiagonalTorusAt T b c b' c') : ℝ :=
  ∏ w : InfinitePlace F, ‖b' w‖ * ‖c' w‖

private noncomputable def IsDiagonalTorusAt.finSize (_h : IsDiagonalTorusAt T b c b' c') : ℝ :=
  ∏ᶠ v : HeightOneSpectrum (𝓞 F), ‖b v‖ * ‖c v‖

private theorem IsDiagonalTorusAt.archSize_pos (h : IsDiagonalTorusAt T b c b' c') : 0 < h.archSize :=
  Finset.prod_pos fun w _ => mul_pos (norm_pos_iff.2 (h.b'_ne w)) (norm_pos_iff.2 (h.c'_ne w))

private theorem IsDiagonalTorusAt.finSize_pos (h : IsDiagonalTorusAt T b c b' c') : 0 < h.finSize := by
  unfold IsDiagonalTorusAt.finSize
  exact finprod_induction (fun x => 0 < x) zero_lt_one (fun _ _ => mul_pos)
    fun v => mul_pos (norm_pos_iff.2 (h.b_ne v)) (norm_pos_iff.2 (h.c_ne v))

private theorem IsDiagonalTorusAt.rootSizeProd_mul (h : IsDiagonalTorusAt T b c b' c')
    (hS : (Function.mulSupport fun v => ‖b v‖ * ‖c v‖).Finite) (g : AdelicGL 3 (𝓞 F) F) :
    rootSizeProd F (T * g) = h.archSize * rootSizeProd F g ∨
      rootSizeProd F (T * g) = h.archSize * h.finSize * rootSizeProd F g := by
  have harch : (∏ w : InfinitePlace F, archRoot₁ F w (T * g) * archRoot₂ F w (T * g)) =
      h.archSize * ∏ w : InfinitePlace F, archRoot₁ F w g * archRoot₂ F w g := by
    unfold IsDiagonalTorusAt.archSize
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun w _ => ?_
    simp only [h.archRoot₁_mul, h.archRoot₂_mul]
    ring
  have hfin : (∏ᶠ v, finRoot₁ F v (T * g) * finRoot₂ F v (T * g)) =
      ∏ᶠ v, (‖b v‖ * ‖c v‖) * (finRoot₁ F v g * finRoot₂ F v g) :=
    finprod_congr fun v => by
      simp only [h.finRoot₁_mul, h.finRoot₂_mul]
      ring
  unfold rootSizeProd
  simp only [harch, hfin]
  by_cases hsupp : (Function.mulSupport fun v => finRoot₁ F v g * finRoot₂ F v g).Finite
  · right
    unfold IsDiagonalTorusAt.finSize
    simp only [finprod_mul_distrib hS hsupp]
    ring
  · left
    have hinf : (Function.mulSupport fun v => (‖b v‖ * ‖c v‖) * (finRoot₁ F v g * finRoot₂ F v g)).Infinite := by
      intro hfin'
      apply hsupp
      refine (hS.union hfin').subset fun v hv => ?_
      by_contra hv'
      simp only [Set.mem_union, Function.mem_mulSupport, not_or, not_not] at hv'
      have h2 := hv'.2
      rw [hv'.1, one_mul] at h2
      exact hv h2
    simp only [finprod_of_infinite_mulSupport hinf, finprod_of_infinite_mulSupport hsupp]
    ring

private theorem IsDiagonalTorusAt.mul_archRootSum_le (h : IsDiagonalTorusAt T b c b' c') {m : ℝ}
    (hmb : ∀ w, m ≤ ‖b' w‖) (hmc : ∀ w, m ≤ ‖c' w‖) (g : AdelicGL 3 (𝓞 F) F) :
    m * archRootSum F g ≤ archRootSum F (T * g) := by
  unfold archRootSum
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun w _ => ?_
  simp only [h.archRoot₁_mul, h.archRoot₂_mul, mul_add]
  exact add_le_add (mul_le_mul_of_nonneg_right (hmb w) (archRoot₁_nonneg F w g))
    (mul_le_mul_of_nonneg_right (hmc w) (archRoot₂_nonneg F w g))

private theorem IsDiagonalTorusAt.isGaugeMajorised3_comp_mul (h : IsDiagonalTorusAt T b c b' c')
    (S₁ : Finset (HeightOneSpectrum (𝓞 F))) (hb1 : ∀ v, v ∉ S₁ → ‖b v‖ = 1) (hc1 : ∀ v, v ∉ S₁ → ‖c v‖ = 1)
    {W : AdelicGL 3 (𝓞 F) F → ℂ} (hW : IsGaugeMajorised3 F W) : IsGaugeMajorised3 F fun g => W (T * g) := by
  classical
  obtain ⟨t, T₀, B₀, hW⟩ := hW

  have hS : (Function.mulSupport fun v => ‖b v‖ * ‖c v‖).Finite := by
    refine S₁.finite_toSet.subset fun v hv => ?_
    by_contra hv'
    exact hv (by simp [hb1 v hv', hc1 v hv'])
  set M : ℝ := 1 + ∑ v ∈ S₁, (‖b v‖⁻¹ + ‖c v‖⁻¹) with hM
  have hM1 : 1 ≤ M := le_add_of_nonneg_right (Finset.sum_nonneg fun v _ => by positivity)
  have hMb : ∀ v, ‖b v‖⁻¹ ≤ M := by
    intro v
    by_cases hv : v ∈ S₁
    · exact (le_add_of_nonneg_right (by positivity)).trans
        ((Finset.single_le_sum (f := fun v => ‖b v‖⁻¹ + ‖c v‖⁻¹) (fun v _ => by positivity) hv).trans
          (le_add_of_nonneg_left zero_le_one))
    · rw [hb1 v hv, inv_one]; exact hM1
  have hMc : ∀ v, ‖c v‖⁻¹ ≤ M := by
    intro v
    by_cases hv : v ∈ S₁
    · exact (le_add_of_nonneg_left (by positivity)).trans
        ((Finset.single_le_sum (f := fun v => ‖b v‖⁻¹ + ‖c v‖⁻¹) (fun v _ => by positivity) hv).trans
          (le_add_of_nonneg_left zero_le_one))
    · rw [hc1 v hv, inv_one]; exact hM1
  set m : ℝ := (1 + ∑ w : InfinitePlace F, (‖b' w‖⁻¹ + ‖c' w‖⁻¹))⁻¹ with hm
  have hm0 : 0 < m := by rw [hm]; positivity
  have hm1 : m ≤ 1 := inv_le_one_of_one_le₀ (le_add_of_nonneg_right (Finset.sum_nonneg fun w _ => by positivity))
  have hmb : ∀ w, m ≤ ‖b' w‖ := by
    intro w
    have hw : ‖b' w‖⁻¹ ≤ m⁻¹ := by
      rw [hm, inv_inv]
      exact (le_add_of_nonneg_right (by positivity)).trans
        ((Finset.single_le_sum (f := fun w => ‖b' w‖⁻¹ + ‖c' w‖⁻¹) (fun w _ => by positivity)
          (Finset.mem_univ w)).trans (le_add_of_nonneg_left zero_le_one))
    simpa only [inv_inv] using inv_anti₀ (inv_pos.2 (norm_pos_iff.2 (h.b'_ne w))) hw
  have hmc : ∀ w, m ≤ ‖c' w‖ := by
    intro w
    have hw : ‖c' w‖⁻¹ ≤ m⁻¹ := by
      rw [hm, inv_inv]
      exact (le_add_of_nonneg_left (by positivity)).trans
        ((Finset.single_le_sum (f := fun w => ‖b' w‖⁻¹ + ‖c' w‖⁻¹) (fun w _ => by positivity)
          (Finset.mem_univ w)).trans (le_add_of_nonneg_left zero_le_one))
    simpa only [inv_inv] using inv_anti₀ (inv_pos.2 (norm_pos_iff.2 (h.c'_ne w))) hw

  set K : ℝ := min h.archSize (h.archSize * h.finSize) with hK
  have hK0 : 0 < K := lt_min h.archSize_pos (mul_pos h.archSize_pos h.finSize_pos)
  refine ⟨t, T₀ ∪ S₁, max B₀ 1 * M, fun N => ?_⟩
  obtain ⟨C₀, hC⟩ := hW N
  refine ⟨max C₀ 0 / (K ^ t * m ^ N), fun g => ?_⟩
  have hg := hC (T * g)

  have hlevel : InRootLevel F T₀ B₀ (T * g) → InRootLevel F (T₀ ∪ S₁) (max B₀ 1 * M) g := by
    rintro ⟨h1, h2⟩
    have hle : ∀ v, finRoot₁ F v (T * g) ≤ max B₀ 1 ∧ finRoot₂ F v (T * g) ≤ max B₀ 1 := by
      intro v
      by_cases hv : v ∈ T₀
      · exact ⟨(h2 v hv).1.trans (le_max_left _ _), (h2 v hv).2.trans (le_max_left _ _)⟩
      · exact ⟨(h1 v hv).1.trans (le_max_right _ _), (h1 v hv).2.trans (le_max_right _ _)⟩
    have hdiv : ∀ v, finRoot₁ F v g ≤ max B₀ 1 * M ∧ finRoot₂ F v g ≤ max B₀ 1 * M := by
      intro v
      have e₁ : finRoot₁ F v g = ‖b v‖⁻¹ * finRoot₁ F v (T * g) := by
        rw [eq_inv_mul_iff_mul_eq₀ (norm_ne_zero_iff.2 (h.b_ne v))]
        exact (h.finRoot₁_mul v g).symm
      have e₂ : finRoot₂ F v g = ‖c v‖⁻¹ * finRoot₂ F v (T * g) := by
        rw [eq_inv_mul_iff_mul_eq₀ (norm_ne_zero_iff.2 (h.c_ne v))]
        exact (h.finRoot₂_mul v g).symm
      rw [e₁, e₂, mul_comm (max B₀ 1) M]
      exact ⟨mul_le_mul (hMb v) (hle v).1 (finRoot₁_nonneg F v _) (zero_le_one.trans hM1),
        mul_le_mul (hMc v) (hle v).2 (finRoot₂_nonneg F v _) (zero_le_one.trans hM1)⟩
    refine ⟨fun v hv => ?_, fun v _ => hdiv v⟩
    rw [Finset.mem_union, not_or] at hv
    have h1v := h1 v hv.1
    rw [h.finRoot₁_mul, h.finRoot₂_mul, hb1 v hv.2, hc1 v hv.2, one_mul, one_mul] at h1v
    exact h1v
  refine ⟨fun hnot => hg.1 fun hin => hnot (hlevel hin), fun _ => ?_⟩

  have hden : 0 ≤ rootSizeProd F g ^ t * (1 + archRootSum F g) ^ N :=
    mul_nonneg (pow_nonneg (rootSizeProd_nonneg F g) _)
      (pow_nonneg (add_nonneg zero_le_one (archRootSum_nonneg F g)) _)
  have hC' : 0 ≤ max C₀ 0 / (K ^ t * m ^ N) :=
    div_nonneg (le_max_right _ _) (mul_nonneg (pow_nonneg hK0.le _) (pow_nonneg hm0.le _))
  by_cases hin : InRootLevel F T₀ B₀ (T * g)
  · refine (hg.2 hin).trans ?_

    obtain ⟨κ, hκK, hκ⟩ : ∃ κ, K ≤ κ ∧ rootSizeProd F (T * g) = κ * rootSizeProd F g := by
      rcases h.rootSizeProd_mul hS g with e | e
      · exact ⟨_, min_le_left _ _, e⟩
      · exact ⟨_, min_le_right _ _, e⟩
    have hκ0 : 0 < κ := hK0.trans_le hκK
    have hsum : m * (1 + archRootSum F g) ≤ 1 + archRootSum F (T * g) := by
      rw [mul_add, mul_one]
      exact add_le_add hm1 (h.mul_archRootSum_le hmb hmc g)
    have hcmp : K ^ t * m ^ N * (rootSizeProd F g ^ t * (1 + archRootSum F g) ^ N) ≤
        rootSizeProd F (T * g) ^ t * (1 + archRootSum F (T * g)) ^ N := by
      have hmσ : 0 ≤ m * (1 + archRootSum F g) := mul_nonneg hm0.le (add_nonneg zero_le_one (archRootSum_nonneg F g))
      calc K ^ t * m ^ N * (rootSizeProd F g ^ t * (1 + archRootSum F g) ^ N)
          = (K ^ t * rootSizeProd F g ^ t) * (m * (1 + archRootSum F g)) ^ N := by rw [mul_pow]; ring
        _ ≤ (κ ^ t * rootSizeProd F g ^ t) * (1 + archRootSum F (T * g)) ^ N :=
          mul_le_mul (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ hK0.le hκK t)
              (pow_nonneg (rootSizeProd_nonneg F g) _))
            (pow_le_pow_left₀ hmσ hsum N) (pow_nonneg hmσ _)
            (mul_nonneg (pow_nonneg hκ0.le _) (pow_nonneg (rootSizeProd_nonneg F g) _))
        _ = rootSizeProd F (T * g) ^ t * (1 + archRootSum F (T * g)) ^ N := by simp only [hκ, mul_pow]
    rcases hden.eq_or_lt with hz | hpos
    ·
      have hz' : rootSizeProd F (T * g) ^ t * (1 + archRootSum F (T * g)) ^ N = 0 := by
        have h1 : (1 + archRootSum F g) ^ N ≠ 0 :=
          pow_ne_zero _ (add_pos_of_pos_of_nonneg zero_lt_one (archRootSum_nonneg F g)).ne'
        have h0 : rootSizeProd F g ^ t = 0 := by
          rcases mul_eq_zero.1 hz.symm with h0 | h0
          · exact h0
          · exact absurd h0 h1
        simp only [hκ, mul_pow, h0, mul_zero, zero_mul]
      calc C₀ / (rootSizeProd F (T * g) ^ t * (1 + archRootSum F (T * g)) ^ N) = 0 := by rw [hz', div_zero]
        _ ≤ _ := by rw [← hz, div_zero]
    · calc C₀ / (rootSizeProd F (T * g) ^ t * (1 + archRootSum F (T * g)) ^ N)
          ≤ max C₀ 0 / (rootSizeProd F (T * g) ^ t * (1 + archRootSum F (T * g)) ^ N) :=
            div_le_div_of_nonneg_right (le_max_left _ _) (mul_nonneg (pow_nonneg (rootSizeProd_nonneg F _) _)
              (pow_nonneg (add_nonneg zero_le_one (archRootSum_nonneg F _)) _))
        _ ≤ max C₀ 0 / (K ^ t * m ^ N * (rootSizeProd F g ^ t * (1 + archRootSum F g) ^ N)) :=
            div_le_div_of_nonneg_left (le_max_right _ _)
              (mul_pos (mul_pos (pow_pos hK0 _) (pow_pos hm0 _)) hpos) hcmp
        _ = max C₀ 0 / (K ^ t * m ^ N) / (rootSizeProd F g ^ t * (1 + archRootSum F g) ^ N) := by
            rw [div_div]
  · simp only [hg.1 hin, norm_zero]
    exact div_nonneg hC' hden

end
