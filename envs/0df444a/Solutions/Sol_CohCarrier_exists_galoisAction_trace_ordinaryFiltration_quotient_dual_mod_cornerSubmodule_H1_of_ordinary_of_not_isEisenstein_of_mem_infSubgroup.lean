    rw [hq, map_add, map_one, πk_smul_r Sp i₀ πk r hrk, add_zero]
  map_mul' x y := by
    obtain ⟨q, hq⟩ := Θ_mul hfaith op hop hgen T u c bO hbO hk θbar Sp i₀ πk hπk hEis r p huindO huspanO huindp huspanp hu_mul N hpN x y
    rw [hq, map_add, map_mul, πk_smul_r Sp i₀ πk r hrk, add_zero]
