theorem GlobalTheory.BXOf.biextension_secondLaw_associativity_value (hJ : Good P z J) (x y y' y'' : T ⟶ G) :
    val β.law2 (lift x (lift (y * y') y'')).left z J * val β.law2 (lift x (lift y y')).left z J =
      val β.law2 (lift x (lift y (y' * y''))).left z J * val β.law2 (lift x (lift y' y'')).left z J := by sorry
