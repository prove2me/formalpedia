  refine ⟨coord, hcoord, X, θ, hE, ν, Φ, fun T _ _ χ => ⟨⟨_, (hmemχ T χ).1, (hmemχ T χ).2⟩, hevχ T χ, heχ T χ⟩, ?_⟩

  intro T _ _ J' n hJ' s hs hzero
  have htors : E.L.nsmul (Scheme.specOver (𝒪 := k) T) p (θ T s) = E.L.one (Scheme.specOver (𝒪 := k) T) := by
    rw [← hφ T J' n hJ' s hs]
    have : (fun i => MvFormalGroup.nilEval n (X.F.nthSeries p i) s) = 0 := funext hzero
    rw [this]
    exact R2PinKit.theta_zero E.L X.F θ hE.1 T
  have hmem : θ T s ∈ E.L.torsionSubset (Spec.map (CommRingCat.ofHom (algebraMap k T))) p := htors
  let χ : H →ₐ[k] T := ((e T).symm ⟨θ T s, hmem⟩).ofConv
  refine ⟨χ, ?_⟩
  have h1 : ((e T (.toConv χ)).val : SchemeHomOver _ E.f) = θ T s := by
    show ((e T (.toConv ((e T).symm ⟨θ T s, hmem⟩).ofConv)).val : SchemeHomOver _ E.f) = θ T s
    rw [WithConv.toConv_ofConv, Equiv.apply_symm_apply]
  have h2 := heχ T χ
  rw [h1] at h2

  obtain ⟨hJχ, hcχ⟩ := hmemχ T χ
  have hJJ := R2PinKit.sup_pow_eq_bot J' _ n ν hJ' hJχ
  have hinj := (hE.1.2 T _ _ hJJ).2.1 s (fun i => χ (Φ (Ideal.Quotient.mk _ (MvPowerSeries.X i))))
    (fun i => Ideal.mem_sup_left (hs i)) (fun i => Ideal.mem_sup_right (hcχ i)) h2
  intro i
  exact (congrFun hinj i).symm

