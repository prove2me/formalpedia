open NLogN
open NLogN.KIL
open AModel AModelL12 AModelFac AModelRat
variable {m : ℕ}
theorem solution {R : Type*} [CommRing R] {W : ℕ} (C : AModelRat.QCircuit R m W) {q b N : ℕ}
    (hq : q.Prime) (hN : N ∣ q ^ b) (hN1 : 1 < N) (X : AModel.IMat m)
    (hg : AModelRat.GoodAtQ q ((C.den : ℚ)⁻¹ • AModelFac.ratM X)) :
    AModel.edgeSteps (C.toCircuit (q ^ b)) N X = (NLogN.KIL.edgeTplQ C X).map (NLogN.KIL.TStep.eval N) := by
  set A := (C.den : ℚ)⁻¹ • AModelFac.ratM X
  have : NeZero (q ^ b) := ⟨pow_ne_zero _ hq.ne_zero⟩
  obtain ⟨-, hd1, hd2, hn1, hn2⟩ := hg
  obtain ⟨-, hz1, -, hz2, -⟩ := AModelRat.ratFacQ_spec A
  have g1 : NLogN.KIL.FGood N (AModelRat.ratFacQ A).1 := NLogN.KIL.fgood_of hN hd1 hz1 hn1
  have g2 : NLogN.KIL.FGood N (AModelRat.ratFacQ A).2.2 := NLogN.KIL.fgood_of hN hd2 hz2 hn2
  have hQ1 : ∀ i j, Nat.Coprime ((AModelRat.ratFacQ A).1 i j).den (q ^ b) := fun i j => (hd1 i j).pow_right b
  have hQ2 : ∀ i j, Nat.Coprime ((AModelRat.ratFacQ A).2.2 i j).den (q ^ b) :=
    fun i j => (hd2 i j).pow_right b
  have H2 : (NLogN.KIL.shearQ (AModelRat.ratFacQ A).1 (AModelRat.piQ A) (AModelRat.ratFacQ A).2.2).map (NLogN.KIL.TStep.eval N ∘ NLogN.KIL.QStep.tpl) =
      (NLogN.KIL.shearQ (AModelRat.ratFacQ A).1 (AModelRat.piQ A) (AModelRat.ratFacQ A).2.2).map (NLogN.KIL.QStep.red N) :=
    List.map_congr_left (fun s hs => NLogN.KIL.QStep.tpl_eval s (NLogN.KIL.shearQ_good _ g1 g2 s hs))
  simp only [NLogN.KIL.edgeTplQ, List.map_map]
  rw [H2, NLogN.KIL.shearQ_red hN1 g1 g2 (AModelRat.piQ_01 A)]
  simp only [AModel.edgeSteps, AModelRat.QCircuit.toCircuit, AModelRat.facD, AModelRat.facQ]
  rw [NLogN.KIL.castM_map_liftZ hN hQ1, NLogN.KIL.castM_map_liftZ hN hQ2]
end
