open MeasureTheory

namespace Cex6d62

/-- A copy of `ℝ` carrying the coarse σ-algebra generated by `{0}`. -/
def CR : Type := ℝ

noncomputable instance : NormedAddCommGroup CR := inferInstanceAs (NormedAddCommGroup ℝ)
noncomputable instance : NormedSpace ℝ CR := inferInstanceAs (NormedSpace ℝ ℝ)
instance : MeasurableSpace CR := MeasurableSpace.generateFrom {{(0 : CR)}}

noncomputable def p1 : CR := (1 : ℝ)
noncomputable def p2 : CR := (2 : ℝ)

lemma p1_ne : p1 ≠ 0 := fun h => by
  have h' : (1 : ℝ) = 0 := h
  norm_num at h'

lemma p2_ne : p2 ≠ 0 := fun h => by
  have h' : (2 : ℝ) = 0 := h
  norm_num at h'

lemma norm_p1 : ‖p1‖ = 1 := by
  show ‖(1 : ℝ)‖ = 1
  simp

lemma norm_p2 : ‖p2‖ = 2 := by
  show ‖(2 : ℝ)‖ = 2
  simp

lemma ms_zero_compl : MeasurableSet ({(0 : CR)}ᶜ : Set CR) :=
  (MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton _)).compl

lemma measurable_big (T : Set CR) (hT : MeasurableSet T) (p : CR) (hp : p ≠ 0)
    (hpT : p ∈ T) : ({(0 : CR)}ᶜ : Set CR) ⊆ T := by
  rcases measurableSet_generateFrom_singleton_iff.mp hT with rfl | rfl | rfl | rfl
  · exact absurd hpT (Set.notMem_empty _)
  · exact absurd (Set.mem_singleton_iff.mp hpT) hp
  · exact le_rfl
  · exact Set.subset_univ _

lemma null_of_aesm (Q : Measure CR) (h : AEStronglyMeasurable (fun x : CR => ‖x‖) Q) :
    Q ({(0 : CR)}ᶜ : Set CR) = 0 := by
  have hg : StronglyMeasurable (h.mk _) := h.stronglyMeasurable_mk
  have hae : (fun x : CR => ‖x‖) =ᵐ[Q] h.mk _ := h.ae_eq_mk
  have hconst : ∀ x : CR, x ≠ 0 → h.mk _ x = h.mk _ p1 := by
    intro x hx
    have hm : MeasurableSet ((h.mk _) ⁻¹' {h.mk _ p1}) :=
      hg.measurable (measurableSet_singleton _)
    exact measurable_big _ hm p1 p1_ne rfl hx
  have hnull : Q {x | ¬ ‖x‖ = h.mk _ x} = 0 := ae_iff.mp hae
  obtain ⟨q, hq0, hq⟩ : ∃ q : CR, q ≠ 0 ∧ q ∈ {x | ¬ ‖x‖ = h.mk _ x} := by
    by_cases h1 : ‖p1‖ = h.mk _ p1
    · refine ⟨p2, p2_ne, ?_⟩
      show ¬ ‖p2‖ = h.mk _ p2
      rw [hconst p2 p2_ne, ← h1, norm_p1, norm_p2]
      norm_num
    · exact ⟨p1, p1_ne, h1⟩
  have hT := measurable_big _ (measurableSet_toMeasurable Q _) q hq0
    (subset_toMeasurable Q _ hq)
  refine nonpos_iff_eq_zero.mp ?_
  calc Q ({(0 : CR)}ᶜ : Set CR) ≤ Q (toMeasurable Q {x | ¬ ‖x‖ = h.mk _ x}) := measure_mono hT
    _ = 0 := by rw [measure_toMeasurable]; exact hnull

lemma ae_zero (Q : Measure CR) (hQ : Q ({(0 : CR)}ᶜ : Set CR) = 0) :
    (fun x : CR => ‖x‖) =ᵐ[Q] 0 := by
  rw [Filter.EventuallyEq, ae_iff]
  refine measure_mono_null ?_ hQ
  intro x hx h0
  apply hx
  rw [Set.mem_singleton_iff.mp h0]
  simp

lemma integral_norm_zero (Q : Measure CR) (hQ : Q ({(0 : CR)}ᶜ : Set CR) = 0) :
    ∫ x, ‖x‖ ∂Q = 0 := by
  rw [integral_congr_ae (ae_zero Q hQ)]
  simp

lemma emp_eq : WassersteinDRO.Duality.empiricalDistribution (fun _ : Fin 1 => (0 : CR)) =
    Measure.dirac (0 : CR) := by
  simp [WassersteinDRO.Duality.empiricalDistribution]

lemma emp_null : WassersteinDRO.Duality.empiricalDistribution (fun _ : Fin 1 => (0 : CR))
    ({(0 : CR)}ᶜ : Set CR) = 0 := by
  rw [emp_eq, Measure.dirac_apply' _ ms_zero_compl]
  simp

lemma lip_ge : (1 : ENNReal) ≤ WassersteinDRO.Duality.lipschitzModulus (fun x : CR => ‖x‖) := by
  unfold WassersteinDRO.Duality.lipschitzModulus
  refine le_iSup_of_le p1 (le_iSup_of_le 0 (le_iSup_of_le p1_ne ?_))
  simp [norm_p1]

open WassersteinDRO.Duality in
theorem cex : ¬ (∀ {E : Type} [MeasurableSpace E] [NormedAddCommGroup E]
    [NormedSpace ℝ E]
    (ε : ℝ) (hε : 0 ≤ ε) {N : ℕ} (hN : 0 < N) (ξhat : Fin N → E)
    (ℓ : E → ℝ) (hconv : ConvexOn ℝ Set.univ ℓ)
    (hℓ : Integrable ℓ (empiricalDistribution ξhat)),
    worstCaseRisk ε 1 Set.univ (empiricalDistribution ξhat) ℓ =
      (nominalRisk (empiricalDistribution ξhat) ℓ : EReal) +
        ((ENNReal.ofReal ε * lipschitzModulus ℓ : ENNReal) : EReal)) := by
  intro h
  have hint : Integrable (fun x : CR => ‖x‖)
      (empiricalDistribution (fun _ : Fin 1 => (0 : CR))) :=
    (integrable_zero _ _ _).congr (ae_zero _ emp_null).symm
  have key := h (E := CR) 1 zero_le_one (N := 1) one_pos (fun _ => (0 : CR))
    (fun x : CR => ‖x‖) (convexOn_norm convex_univ) hint
  have hL : worstCaseRisk 1 1 Set.univ (empiricalDistribution (fun _ : Fin 1 => (0 : CR)))
      (fun x : CR => ‖x‖) ≤ 0 := by
    unfold worstCaseRisk
    refine iSup_le fun Q => iSup_le fun _ => iSup_le fun hi => ?_
    unfold nominalRisk
    rw [integral_norm_zero Q (null_of_aesm Q hi.aestronglyMeasurable)]
    simp
  have hN0 : (0 : ℝ) ≤ nominalRisk (empiricalDistribution (fun _ : Fin 1 => (0 : CR)))
      (fun x : CR => ‖x‖) := integral_nonneg fun _ => norm_nonneg _
  have hR : (1 : EReal) ≤ ((nominalRisk (empiricalDistribution (fun _ : Fin 1 => (0 : CR)))
      (fun x : CR => ‖x‖) : ℝ) : EReal) +
      ((ENNReal.ofReal 1 * lipschitzModulus (fun x : CR => ‖x‖) : ENNReal) : EReal) := by
    have h1 : (0 : EReal) ≤ ((nominalRisk (empiricalDistribution (fun _ : Fin 1 => (0 : CR)))
      (fun x : CR => ‖x‖) : ℝ) : EReal) := EReal.coe_nonneg.mpr hN0
    have h2 : (1 : EReal) ≤
        ((ENNReal.ofReal 1 * lipschitzModulus (fun x : CR => ‖x‖) : ENNReal) : EReal) := by
      rw [ENNReal.ofReal_one, one_mul]
      exact_mod_cast lip_ge
    calc (1 : EReal) = 0 + 1 := (zero_add 1).symm
      _ ≤ _ := add_le_add h1 h2
  rw [key] at hL
  have h10 : (1 : EReal) ≤ 0 := hR.trans hL
  have h10' : (1 : ℝ) ≤ 0 := by exact_mod_cast h10
  norm_num at h10'

end Cex6d62

