set_option linter.unusedSimpArgs false

namespace NLogN.AX

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.Rsp

/-- The axis core (= `GL.axisP (bapAx …)`, written out). -/
def bapCoreP : RM :=
  .seq (RM.seqL [.rs (.push 1 (.reg bT)), .rs (.push 2 (.reg bM)), .rs (.push 3 (.reg bKB)),
      .rs (transP 2), .rs (.pop 1), .rs (.pop 2), .rs (.pop 3)])
