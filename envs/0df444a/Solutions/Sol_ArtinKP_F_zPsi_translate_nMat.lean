-- module Solutions.Artin.KP.F_Per_Z
attribute [-instance] _root_.ArtinPrimitiveRoots.L3X.instDiscrSFin
/-! # WP-F, file 5: the residue `z_Ψ` — linearity, translations, `ρ_∞`

* `zPsi_of_mD`: `z_Ψ` from a continuation of `mD D Ψ` over a strict cell.
* `zPsi_add`, `zPsi_smul`, `zPsi_sum`: `Ψ ↦ z_Ψ` is linear.
* `zPsi_translate_nMat`: `z_{n(t)·Ψ} = z_Ψ` for `t ∈ R`.
* **`zPsi_restrict`**: `z_{Φρ_∞} = q/(q+1) · z_Φ` for every genuine section `Φ`.
-/

open scoped MatrixGroups ComplexConjugate ENNReal Topology
open MeasureTheory Set NumberField Filter IsDedekindDomain ArtinPrimitiveRoots Metric

set_option autoImplicit false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

namespace ArtinKP.F

open ArtinKP.A ArtinKP.S ArtinKP.X ArtinKP.B1 ArtinKP.B ArtinKP.C5 ArtinKP.K ArtinKP.RF ArtinKP.N
  ArtinKP.T ArtinKP.B7 ArtinKP.FA ArtinKP.N2

noncomputable section

variable {F : Type*} [Field F] [NumberField F] [IsTotallyComplex F] {𝔪 : Ideal (𝓞 F)}
  {ι : F →+* ℂ} {P : CubicPkg F} {v : HeightOneSpectrum (𝓞 F)}

/-! ### Finite sums of twisted sections -/

section z

variable (hG : Good 𝔪) {z6 : 𝓞 F} (hz6 : IsPrimitiveRoot z6 6)

lemma cell_of_pcell {Γ : Subgroup (SL(2, 𝓞 F))} {D : Set (InfinitePlace F → ℂ)} {n : ℕ}
    (hD : PCell (latN Γ) D) (hb : ∀ x ∈ D, ∀ w, ‖x w‖ ≤ n) : Cell Γ D n :=
  ⟨hD.meas, hD.isAddFundamentalDomain volume, hb⟩

include hG hz6 in
/-- A finite-index group fixing two sections, with a strict cell. -/
lemma exists_common (P : CubicPkg F) (Ψ Ψ' : TSection ι 𝔪) : ∃ (Γ : Subgroup (SL(2, 𝓞 F))) (_ : Γ.FiniteIndex)
    (D : Set (InfinitePlace F → ℂ)) (n : ℕ), Inv Γ Ψ ∧ Inv Γ Ψ' ∧ PCell (latN Γ) D ∧
      (∀ x ∈ D, ∀ w, ‖x w‖ ≤ n) ∧ 1 ≤ n := by
  have h1 := finiteIndex_stabGroup hG hz6 P Ψ
  have h2 := finiteIndex_stabGroup hG hz6 P Ψ'
  have h3 : (stabGroup Ψ ⊓ stabGroup Ψ').FiniteIndex := inferInstance
  obtain ⟨D, n, hD, hb⟩ := exists_pcell_latN (stabGroup Ψ ⊓ stabGroup Ψ')
  refine ⟨_, h3, D, max n 1, fun γ hγ => inv_stabGroup Ψ γ hγ.1,
    fun γ hγ => inv_stabGroup Ψ' γ hγ.2, hD, fun x hx w => (hb x hx w).trans ?_, le_max_right _ _⟩
  exact_mod_cast le_max_left n 1

/-! ### Translations -/

lemma nMat_inv (t : SInt 𝔪) : (_root_.ArtinKP.S.nMat t)⁻¹ = _root_.ArtinKP.S.nMat (-t) := by
  apply inv_eq_of_mul_eq_one_right
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]

lemma toF_nMat_smul_mk (t : SInt 𝔪) (x : InfinitePlace F → ℂ) (vv : InfinitePlace F → ℝ)
    (hvv : ∀ w, 0 < vv w) :
    toF 𝔪 (_root_.ArtinKP.S.nMat t) • X.mk x vv hvv = X.mk (x + emb (t : F)) vv hvv := by
  have hc : ∀ w : InfinitePlace F, (sigma F (toF 𝔪 (_root_.ArtinKP.S.nMat t)) w) 1 0 = 0 := fun w => by
    rw [sigma_apply]
    change w.embedding (((_root_.ArtinKP.S.nMat t).1 1 0 : SInt 𝔪) : F) = 0
    simp
  refine X.ext' (funext fun w => ?_) (funext fun w => ?_)
  · have h := (smul_of_lower_zero (hc w) ((X.mk x vv hvv) w)).1
    change ((sigma F (toF 𝔪 (_root_.ArtinKP.S.nMat t)) w) • (X.mk x vv hvv) w).x = _
    rw [h, sigma_apply, sigma_apply]
    change w.embedding (((_root_.ArtinKP.S.nMat t).1 0 0 : SInt 𝔪) : F) ^ 2 * (X.mk x vv hvv).x w
      + w.embedding (((_root_.ArtinKP.S.nMat t).1 0 0 : SInt 𝔪) : F) * w.embedding (((_root_.ArtinKP.S.nMat t).1 0 1 : SInt 𝔪) : F)
      = (X.mk (x + emb (t : F)) vv hvv).x w
    simp
  · have h := (smul_of_lower_zero (hc w) ((X.mk x vv hvv) w)).2
    change ((sigma F (toF 𝔪 (_root_.ArtinKP.S.nMat t)) w) • (X.mk x vv hvv) w).v = _
    rw [h, sigma_apply]
    change Complex.normSq (w.embedding (((_root_.ArtinKP.S.nMat t).1 0 0 : SInt 𝔪) : F)) * (X.mk x vv hvv).v w
      = (X.mk (x + emb (t : F)) vv hvv).v w
    simp

include hG hz6 in
/-- **`z_{n(t)·Ψ} = z_Ψ`**: the constant term at `∞` does not see translations. -/
theorem zPsi_translate_nMat_oai (t : SInt 𝔪) (Ψ : TSection ι 𝔪) :
    zPsi P hG hz6 (TSection.translate P hG hz6 (_root_.ArtinKP.S.nMat t) Ψ) = zPsi P hG hz6 Ψ := by
  have h𝔪 := hG.ne_bot
  obtain ⟨Γ, hfi, D, n, hΓ, hΓ', hD, hb, hn⟩ :=
    exists_common hG hz6 P Ψ (TSection.translate P hG hz6 (_root_.ArtinKP.S.nMat t) Ψ)
  have hc := cell_of_pcell hD hb
  have := (adm_latN Γ).countable
  have hD0 : (((volume D).toReal : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (volume_toReal_pos hD hb).ne'
  refine zPsi_eq_of_continuation P hG hz6 hΓ' hc (m' := mext Γ Ψ D n)
    (differentiableOn_mext hG hΓ (eisE hG Ψ) hc hn) (fun s hs => ?_)
    (tendsto_mext_zPsi hG hz6 hΓ hc hn)
  rw [mext_eq_mD hG hΓ hc hn hs (eisE hG Ψ s hs), mD_eq_integral h𝔪 _ hs hD.meas hb hD0,
    mD_eq_integral h𝔪 _ hs hD.meas hb hD0]
  have einf : TSection.translate P hG hz6 (_root_.ArtinKP.S.nMat t) Ψ s (Row.inf 𝔪) = Ψ s (Row.inf 𝔪) := by
    rw [TSection.translate_apply]
    congr 1
    ext <;> simp
  have e : ∀ x : InfinitePlace F → ℂ,
      eis (TSection.translate P hG hz6 (_root_.ArtinKP.S.nMat t) Ψ) s (X.mk x (fun _ => 1) (fun _ => one_pos))
        = eis Ψ s (X.mk (x + emb ((-t : SInt 𝔪) : F)) (fun _ => 1) (fun _ => one_pos)) :=
    fun x => by rw [eis_translate P hG hz6, nMat_inv, toF_nMat_smul_mk]
  simp only [e]
  rw [einf, FB.setIntegral_translate (L := latN Γ) (hD.isAddFundamentalDomain volume)
    (G := fun x => eis Ψ s (X.mk x (fun _ => 1) (fun _ => one_pos)))
    (fun b x => by
      rw [add_comm]
      exact eis_add_latN h𝔪 hΓ s b.2 x _ _)]

/-! ### `ρ_∞` -/

end z

end

end ArtinKP.F
end

theorem solution.{u_1} : type_of% @ArtinKP.F.zPsi_translate_nMat_oai.{u_1} := @ArtinKP.F.zPsi_translate_nMat_oai.{u_1}
