open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII16
theorem solution (n : ℕ) :
    ∀ {h : ℝ → ℝ} {ε : ℝ}, 0 < ε → ContDiffOn ℝ n h (Ioo (0:ℝ) ε) →
      (∀ k ≤ n, Tendsto (iteratedDeriv k h) (𝓝[>] (0:ℝ)) (𝓝 0)) →
      ContDiffOn ℝ n (flatExt h) (Ioo (-ε) ε) := by
  induction n with
  | zero =>
      intro h ε hε hc hlim
      exact contDiffOn_zero.mpr (continuousOn_flatExt hc.continuousOn (by simpa using hlim 0 le_rfl))
  | succ n ih =>
      intro h ε hε hc hlim
      have hlim0 : Tendsto h (𝓝[>] (0:ℝ)) (𝓝 0) := by
        simpa using hlim 0 (Nat.zero_le _)
      have hlim1 : Tendsto (deriv h) (𝓝[>] (0:ℝ)) (𝓝 0) := by
        have h1 := hlim 1 (Nat.one_le_iff_ne_zero.mpr (Nat.succ_ne_zero n))
        simpa using h1
      obtain ⟨hdiff, -, hderivC⟩ :=
        (contDiffOn_succ_iff_deriv_of_isOpen (n := n) (f := h) isOpen_Ioo).1 hc
      have hderivEq := deriv_flatExt_eq hε hdiff hlim0 hlim1
      show ContDiffOn ℝ (n + 1) (flatExt h) (Ioo (-ε) ε)
      rw [(contDiffOn_succ_iff_deriv_of_isOpen (n := n) (f := flatExt h) isOpen_Ioo)]
      refine ⟨?_, ?_, ?_⟩
      · -- differentiability on the whole interval
        intro x hx
        rcases lt_trichotomy x 0 with hlt | heq | hgt
        · have hz : flatExt h =ᶠ[𝓝 x] (fun _ => (0:ℝ)) := by
            filter_upwards [Iio_mem_nhds hlt] with y hy
            exact flatExt_of_nonpos (not_lt.mpr hy.le)
          exact (DifferentiableAt.congr_of_eventuallyEq
            (differentiableAt_const (c := (0:ℝ))) hz).differentiableWithinAt
        · subst heq
          exact (hasDerivAt_flatExt_zero hε hdiff hlim0 hlim1).differentiableAt
            |>.differentiableWithinAt
        · have hz : flatExt h =ᶠ[𝓝 x] h := by
            filter_upwards [Ioi_mem_nhds hgt] with y hy
            exact flatExt_of_pos hy
          exact (DifferentiableAt.congr_of_eventuallyEq
            ((hdiff x ⟨hgt, hx.2⟩).differentiableAt (Ioo_mem_nhds hgt hx.2)) hz)
            |>.differentiableWithinAt
      · intro hn
        exact absurd hn (by simp)
      · -- the derivative, by the induction hypothesis applied to `deriv h`
        rw [hderivEq]
        refine ih hε hderivC ?_
        intro k hk
        have := hlim (k + 1) (by omega)
        rwa [iteratedDeriv_succ'] at this
