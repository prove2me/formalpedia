structure FramedPt (n : ℕ) where
  pt : ∀ (R : Type) [CommRing R] [Algebra B R], FramedPolarisedAbelianScheme g N n R → Point R N hf
  iso : ∀ (R : Type) [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R),
    ∃ e : (C.Φ R (pt R X)).1 ≅ X.A, e.hom ≫ X.frame.toProj = (C.Φ R (pt R X)).2
