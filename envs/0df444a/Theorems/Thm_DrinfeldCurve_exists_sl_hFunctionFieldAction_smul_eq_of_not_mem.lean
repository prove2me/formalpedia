namespace DrinfeldCurve

theorem exists_sl_hFunctionFieldAction_smul_eq_of_not_mem
    (q : ℕ) [Fact q.Prime] (k : Type) [Field k] [Algebra (GaloisField q 2) k] [IsAlgClosed k] [IsDomain (CoordRing q k)]
    (v v' : AlgebraicCurve.Place k (drinfeldFunctionField q k))
    (hv : algebraMap (CoordRing q k) (drinfeldFunctionField q k) (x q k) ∉ v.toValuationSubring ∨
      algebraMap (CoordRing q k) (drinfeldFunctionField q k) (y q k) ∉ v.toValuationSubring)
    (hv' : algebraMap (CoordRing q k) (drinfeldFunctionField q k) (x q k) ∉ v'.toValuationSubring ∨
      algebraMap (CoordRing q k) (drinfeldFunctionField q k) (y q k) ∉ v'.toValuationSubring) :
    ∃ g : Matrix.SpecialLinearGroup (Fin 2) (ZMod q),
      hFunctionFieldAction q k ⟨(Matrix.SpecialLinearGroup.toGL g, (1 : (GaloisField q 2)ˣ)), toGL_one_mem_hSubgroup q g⟩ • v = v' := by sorry
