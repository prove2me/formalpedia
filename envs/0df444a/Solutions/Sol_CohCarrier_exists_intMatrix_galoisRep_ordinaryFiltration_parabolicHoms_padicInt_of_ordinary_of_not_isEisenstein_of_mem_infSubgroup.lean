theorem toC_smul (x : Ap p T) (w : ↥(Wpar ℤ_[p] M Hs)) :
    toC T p S₁ i₁ (x • w) = S₁.toCornerRing i₁ x • toC T p S₁ i₁ w := by
  apply Subtype.ext
  show S₁.e i₁ • (x • w) = ((S₁.toCornerRing i₁ x : S₁.CornerRing i₁) : Ap p T) • (S₁.e i₁ • w)
  rw [S₁.coe_toCornerRing, smul_smul, smul_smul, mul_assoc (S₁.e i₁ * x), (S₁.idem i₁).eq, mul_comm (S₁.e i₁) x,
