    · subst j3
      simp [hsc, hsb, hsa, hIO, hI.1, hI.2.2.2.2.2.2.1, hI.2.2.2.2.2.1]
    by_cases j4 : j = gZT
    · subst j4
      simp (config := {decide := true}) [hsc, hsb, hsa, Ne.symm hI.2.2.2.2.2.2.1,
        Ne.symm hO.2.2.2.2.2.2.1]
    by_cases j5 : j = NLogN.GL.gD
    · subst j5
      simp (config := {decide := true}) [hsc, hsb, hsa, Ne.symm hI.1, Ne.symm hO.1]
    simp [hsc, hsb, hsa, j1, j2, j3, j4, j5]
  · refine ⟨a2, ?_⟩
    rw [a1]; refine ⟨b2, ?_⟩
    rw [b1]; refine ⟨c2, ?_⟩
    rw [c1]; exact d2
  · show (RM.rs _).cost M t + ((RM.rs _).cost M ((RM.rs _).run t) +
      (ax.sl.p.cost M ((RM.rs _).run ((RM.rs _).run t)) +
        (RM.rs _).cost M (ax.sl.p.run ((RM.rs _).run ((RM.rs _).run t))))) ≤ _
    rw [a1, b1, c1]
    have : 2 * ax.n * (14000 * (Q + 2) + 30) + 2 * ax.n * (14000 * (Q + 2) + 30) +
      2 * ax.n' * (14000 * (Q + 2) + 30) ≤ 3 * (2 * (ax.n + ax.n') * (14000 * (Q + 2) + 30)) := by
      nlinarith
    omega

theorem flatMap_length_const {α β : Type*} (X : List α) (g : α → List β) (k : ℕ)
    (h : ∀ x ∈ X, (g x).length = k) : (X.flatMap g).length = X.length * k := by
  induction X with
  | nil => simp
  | cons a X ih =>
    simp only [List.flatMap_cons, List.length_append, List.length_cons]
    rw [h a (by simp), ih (fun x hx => h x (by simp [hx]))]; ring

