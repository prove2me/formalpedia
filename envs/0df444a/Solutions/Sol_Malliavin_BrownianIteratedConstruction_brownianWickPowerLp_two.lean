theorem _root_.solution
    (hB : IsPreBrownianReal B P) (v : ℝ≥0 →₀ ℝ) :
    brownianWickPowerLp hB v 2 =
      brownianStepPowerLp hB v 2 -
        ‖stepToLp v‖ ^ 2 • Lp.const 2 P (1 : ℝ) := by
