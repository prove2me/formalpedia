theorem ModularCurve.JZeroNeronObjectAtP.heckeTorsion_ne_bot_of_mem_finPts_of_not_mem_toricPts
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (Λ : JZeroNeronObjectAtP.LevelData N₀ p A) (hΛ : Λ.IsJacobian)
    (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) :
    HeckeInputsAll (N₀ * p) → HeckeOperatorsCommuteBar (N₀ * p) →
    HeckeInputsAll N₀ → HeckeOperatorsCommuteBar N₀ →
      ∀ 𝔪 : Ideal HeckeAlg, 𝔪.IsMaximal → ((p : ℕ) : HeckeAlg) ∈ 𝔪 → heckeGen ⟨p, Fact.out⟩ ∉ 𝔪 →
        ∀ x ∈ O.finPts p, (letI := heckeModuleBar (N₀ * p); x ∈ heckeTorsion (JZero (N₀ * p)) 𝔪) →
          x ∉ O.toricPts p →
            (letI := heckeModuleBar N₀; heckeTorsion (JZero N₀) 𝔪 ≠ ⊥) := by sorry
