  · rw [if_neg compatible]
theorem exactJointPrefixAliceOperatorMass_sum_insert
    (G : Game X Y A B) (n : ℕ) (S : Strategy (G.repeat n))
    (D fixedX fixedY : Finset (Fin n)) (j : Fin n)
    (fresh : j ∉ fixedX)
    (answer : {k : Fin n // k ∈ D} → A)
