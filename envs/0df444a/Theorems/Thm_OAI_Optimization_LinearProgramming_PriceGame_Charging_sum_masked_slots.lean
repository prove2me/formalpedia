theorem sum_masked_slots {V : Type*} [Fintype V] [DecidableEq V] (S : Finset V)
    (m : V → ℚ) (arity : ℕ) (f : (Fin arity → V) → ℚ) :
    ∑ x, slots arity (maskedMass S m) x * f x =
      ∑ x : Fin arity → S, slots arity (fun i : S => m i) x * f (fun j => (x j : V)) := by sorry
