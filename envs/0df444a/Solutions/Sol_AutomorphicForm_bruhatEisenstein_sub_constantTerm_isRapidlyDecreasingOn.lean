  rw [Complex.normSq_eq_norm_sq (botP g z), ← Real.sqrt_sq (norm_nonneg (botP g z))]
  exact Real.sqrt_le_sqrt (by rw [Real.sq_sqrt (by positivity)]; exact le_add_of_nonneg_right (normSq_nonneg _))

private theorem norm_botQ_le_radC (z : ℂ) : ‖botQ g z‖ ≤ radC g z := by
  unfold radC
  rw [Complex.normSq_eq_norm_sq (botQ g z), ← Real.sqrt_sq (norm_nonneg (botQ g z))]
  exact Real.sqrt_le_sqrt (by rw [Real.sq_sqrt (by positivity)]; exact le_add_of_nonneg_left (normSq_nonneg _))

private theorem norm_entry10_le_sqrt_botNormSqC (g : Matrix (Fin 2) (Fin 2) ℂ) :
    ‖g 1 0‖ ≤ Real.sqrt (botNormSqC g) := by
  unfold botNormSqC
  rw [Complex.normSq_eq_norm_sq (g 1 0), ← Real.sqrt_sq (norm_nonneg (g 1 0))]
  exact Real.sqrt_le_sqrt (by rw [Real.sq_sqrt (by positivity)]; exact le_add_of_nonneg_right (normSq_nonneg _))

private theorem norm_entry11_le_sqrt_botNormSqC (g : Matrix (Fin 2) (Fin 2) ℂ) :
    ‖g 1 1‖ ≤ Real.sqrt (botNormSqC g) := by
  unfold botNormSqC
  rw [Complex.normSq_eq_norm_sq (g 1 1), ← Real.sqrt_sq (norm_nonneg (g 1 1))]
  exact Real.sqrt_le_sqrt (by rw [Real.sq_sqrt (by positivity)]; exact le_add_of_nonneg_left (normSq_nonneg _))

private theorem norm_iteratedFDeriv_affine (c₀ c₁ : ℂ) (t : ℝ) :
    ‖iteratedFDeriv ℝ 0 (fun t : ℝ => c₀ + t * c₁) t‖ = ‖c₀ + t * c₁‖
    ∧ ‖iteratedFDeriv ℝ 1 (fun t : ℝ => c₀ + t * c₁) t‖ = ‖c₁‖
    ∧ ∀ k : ℕ, ‖iteratedFDeriv ℝ (k + 2) (fun t : ℝ => c₀ + t * c₁) t‖ = 0 := by
  have hd : deriv (fun t : ℝ => c₀ + t * c₁) = fun _ : ℝ => c₁ := by
    funext s
    have h : HasDerivAt (fun t : ℝ => c₀ + t * c₁) c₁ s := by
      simpa using (((hasDerivAt_id s).ofReal_comp).mul_const c₁).const_add c₀
    exact h.deriv
  refine ⟨by rw [norm_iteratedFDeriv_zero], ?_, fun k => ?_⟩
  · rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_one, hd]
  · rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_succ', hd, iteratedDeriv_const]
    simp

private theorem contDiff_invRadC_line (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) :
    ContDiff ℝ ∞ fun t : ℝ => (((radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℝ) : ℂ))⁻¹ :=
  (Complex.ofRealCLM.contDiff.comp (contDiff_radC_line hg z₀ θ)).inv fun t =>
    Complex.ofReal_ne_zero.mpr (radC_line_pos hg z₀ θ t).ne'

private theorem norm_iteratedFDeriv_affine_mul_invRadC_le (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) (c₀ c₁ : ℂ)
    (hval : ∀ t : ℝ, ‖c₀ + t * c₁‖ ≤ radC g (z₀ + t * Complex.exp (θ * Complex.I)))
    (hslope : ‖c₁‖ ≤ Real.sqrt (botNormSqC g)) (n : ℕ) (t : ℝ) :
    ‖iteratedFDeriv ℝ n
        (fun t : ℝ => (c₀ + t * c₁)
          * (((radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℝ) : ℂ))⁻¹) t‖
      ≤ hatTower g n := by
  have haff : ContDiff ℝ ∞ fun t : ℝ => c₀ + t * c₁ :=
    contDiff_const.add (Complex.ofRealCLM.contDiff.mul contDiff_const)
  have hR : 0 < radC g (z₀ + t * Complex.exp (θ * Complex.I)) := radC_line_pos hg z₀ θ t
  have hF : 0 < Real.sqrt (radFloorC g) := Real.sqrt_pos.mpr (radFloorC_pos hg)

  have hfloor : (radC g (z₀ + t * Complex.exp (θ * Complex.I)))⁻¹ ≤ (Real.sqrt (radFloorC g))⁻¹ := by
    apply inv_anti₀ hF
    calc Real.sqrt (radFloorC g) = Real.sqrt (radFloorC g) * 1 := (mul_one _).symm
      _ ≤ Real.sqrt (radFloorC g) * max 1 ‖z₀ + t * Complex.exp (θ * Complex.I)‖ :=
          mul_le_mul_of_nonneg_left (le_max_left _ _) hF.le
      _ ≤ radC g (z₀ + t * Complex.exp (θ * Complex.I)) := sqrt_radFloorC_mul_le_radC hg _
  obtain ⟨h0, h1, h2⟩ := norm_iteratedFDeriv_affine c₀ c₁ t
  have hI := invRadTower_nonneg g n

  obtain ⟨b, hb0, hb1, hb2⟩ : ∃ b : ℕ → ℝ, b 0 = invRadTower g n
      ∧ b 1 = n * (Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g)) * invRadTower g n
      ∧ ∀ k : ℕ, b (k + 2) = 0 :=
    ⟨fun i => if i = 0 then invRadTower g n
      else if i = 1 then n * (Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g)) * invRadTower g n
      else 0, by simp, by simp, fun k => by simp⟩
  have hterm : ∀ i ∈ Finset.range (n + 1),
      (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i (fun t : ℝ => c₀ + t * c₁) t‖
          * ‖iteratedFDeriv ℝ (n - i)
              (fun t : ℝ => (((radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℝ) : ℂ))⁻¹) t‖
        ≤ b i := by
    intro i _
    have hinv := norm_iteratedFDeriv_invRadC_line_le hg z₀ θ (Nat.sub_le n i) t
    rcases i with _ | _ | k
    ·
      rw [hb0, h0, Nat.choose_zero_right, Nat.cast_one, one_mul, Nat.sub_zero]
      calc ‖c₀ + t * c₁‖ * ‖iteratedFDeriv ℝ n
              (fun t : ℝ => (((radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℝ) : ℂ))⁻¹) t‖
          ≤ radC g (z₀ + t * Complex.exp (θ * Complex.I))
              * (invRadTower g n * (radC g (z₀ + t * Complex.exp (θ * Complex.I)))⁻¹) :=
            mul_le_mul (hval t) hinv (norm_nonneg _) hR.le
        _ = invRadTower g n := by field_simp
    ·
      rw [hb1, h1, Nat.choose_one_right]
      calc (n : ℝ) * ‖c₁‖ * ‖iteratedFDeriv ℝ (n - 1)
              (fun t : ℝ => (((radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℝ) : ℂ))⁻¹) t‖
          ≤ n * Real.sqrt (botNormSqC g)
              * (invRadTower g n * (Real.sqrt (radFloorC g))⁻¹) :=
            mul_le_mul (mul_le_mul_of_nonneg_left hslope (Nat.cast_nonneg n))
              (hinv.trans (mul_le_mul_of_nonneg_left hfloor hI)) (norm_nonneg _) (by positivity)
        _ = n * (Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g)) * invRadTower g n := by ring
    ·
      rw [hb2, h2 k, mul_zero, zero_mul]

  have hsum : ∑ i ∈ Finset.range (n + 1), b i ≤ hatTower g n := by
    unfold hatTower
    rcases n with _ | m
    · rw [Finset.sum_range_one, hb0]
      simp
    · have hz : ∑ i ∈ Finset.range m, b (i + 1 + 1) = 0 := Finset.sum_eq_zero fun i _ => hb2 i
      have hb1' : b (0 + 1) = (m + 1 : ℕ) * (Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g))
          * invRadTower g (m + 1) := hb1
      rw [Finset.sum_range_succ', Finset.sum_range_succ', hz, hb1', hb0, zero_add]
      apply le_of_eq
      ring
  exact (norm_iteratedFDeriv_mul_le haff (contDiff_invRadC_line hg z₀ θ) t
    (by exact_mod_cast le_top)).trans ((Finset.sum_le_sum hterm).trans hsum)

private theorem norm_iteratedFDeriv_linePhat_le (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) (n : ℕ) (t : ℝ) :
    ‖iteratedFDeriv ℝ n (linePhat g z₀ θ) t‖ ≤ hatTower g n := by
  have hfun : linePhat g z₀ θ
      = fun t : ℝ => (botP g z₀ + t * (Complex.exp (θ * Complex.I) * g 1 0))
          * (((radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℝ) : ℂ))⁻¹ := by
    funext t
    simp only [linePhat, div_eq_mul_inv]
    congr 1
    simp only [botP]
    ring
  rw [hfun]
  refine norm_iteratedFDeriv_affine_mul_invRadC_le hg z₀ θ _ _ (fun s => ?_) ?_ n t
  · have h : botP g z₀ + s * (Complex.exp (θ * Complex.I) * g 1 0)
        = botP g (z₀ + s * Complex.exp (θ * Complex.I)) := by
      simp only [botP]; ring
    rw [h]
    exact norm_botP_le_radC _
  · rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
    exact norm_entry10_le_sqrt_botNormSqC g

private theorem norm_iteratedFDeriv_lineQhat_le (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) (n : ℕ) (t : ℝ) :
    ‖iteratedFDeriv ℝ n (lineQhat g z₀ θ) t‖ ≤ hatTower g n := by
  have hfun : lineQhat g z₀ θ
      = fun t : ℝ => (botQ g z₀ + t * (Complex.exp (θ * Complex.I) * g 1 1))
          * (((radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℝ) : ℂ))⁻¹ := by
    funext t
    simp only [lineQhat, div_eq_mul_inv]
    congr 1
    simp only [botQ]
    ring
  rw [hfun]
  refine norm_iteratedFDeriv_affine_mul_invRadC_le hg z₀ θ _ _ (fun s => ?_) ?_ n t
  · have h : botQ g z₀ + s * (Complex.exp (θ * Complex.I) * g 1 1)
        = botQ g (z₀ + s * Complex.exp (θ * Complex.I)) := by
      simp only [botQ]; ring
    rw [h]
    exact norm_botQ_le_radC _
  · rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
    exact norm_entry11_le_sqrt_botNormSqC g

end LineHatTowers
