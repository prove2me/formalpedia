    exact ⟨by
      simp [Light.Sec3.scanRound, Limits.Addr, abs_le, update_frame_setLocal, hreadB, hreadA, hz]; omega,
      by simp [Light.Sec3.scanRound, update_frame_setLocal, hreadB, hreadA, hz, Light.Sec3.bit]⟩

