-- title:
--   Theorem 6.6.1 — a hypervariety germ is cut out by one function generating its ideal
-- statement:
--   Let $U \subset \mathbb{C}^n$ be open, let $X \subset U$ be a subvariety of pure codimension $1$, and let $p \in U$, so that $(X, p)$ is a germ of a pure codimension-1 subvariety. Then there is a function $f$ holomorphic on an open neighborhood $W$ of $p$ such that, with $Z_f = \{ z \in W : f(z) = 0 \}$,
--   $$(Z_f, p) = (X, p) \qquad \text{and} \qquad I_p(X) = (f, p)\,\mathcal{O}_p ,$$
--   i.e. the ideal $I_p(X) \subset \mathcal{O}_p$ of germs vanishing on $(X, p)$ is the principal ideal generated by the germ $(f, p)$.
--
--   Local questions about a hypervariety thus reduce to questions about the zero set of a single function; this is the input for the goal theorem on singular sets.
--
--   **Formalization Note.** Germ equality and $I_p(X)$ are the mission's `GermEq` and `vanishingIdeal`; the ideal generated by $(f,p)$ is `Ideal.span` of the singleton in the subring `holGerms p` $= \mathcal{O}_p$. The germ $(X,p)$ is given by a representative subvariety $X \subset U$ of pure codimension 1 with $p \in U$; the conclusion depends only on the germ, so this is equivalent to the book's germ formulation.
-- source:
--   Lebl, Tasty Bits of Several Complex Variables, version 4.4 (2026), p. 188, Theorem 6.6.1

import Mathlib
import Definitions.Def_LeblSCV_Varieties_IsSubvariety
import Definitions.Def_LeblSCV_Varieties_IsPureCodim
import Definitions.Def_LeblSCV_Varieties_GermEq
import Definitions.Def_LeblSCV_Varieties_holGerms
import Definitions.Def_LeblSCV_Varieties_vanishingIdeal

namespace LeblSCV.Varieties

open Filter Topology

/-- Lebl, Theorem 6.6.1: let `(X, p)` be the germ at `p` of a subvariety `X` of an open set
`U ∋ p` of pure codimension 1. Then there is a function `f` holomorphic on an open neighborhood
`W` of `p` such that `(Z_f, p) = (X, p)`, where `Z_f = W ∩ f⁻¹(0)`, and `I_p(X)` is the ideal of
`𝒪_p` generated by the germ `(f, p)`. -/
theorem hypervariety_locally_principal {n : ℕ} {U X : Set (Fin n → ℂ)}
    (hX : IsSubvariety U X) (hpure : IsPureCodim X 1) {p : Fin n → ℂ} (hp : p ∈ U) :
    ∃ (f : (Fin n → ℂ) → ℂ) (W : Set (Fin n → ℂ)) (hW : IsOpen W) (hpW : p ∈ W)
      (hf : DifferentiableOn ℂ f W),
      GermEq p (W ∩ f ⁻¹' {0}) X ∧
        vanishingIdeal p X =
          Ideal.span {(⟨(f : Germ (𝓝 p) ℂ), ⟨f, W, hW, hpW, hf, rfl⟩⟩ : holGerms p)} := by sorry

end LeblSCV.Varieties
