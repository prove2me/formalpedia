set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000

namespace InfoLossLAR.WorstCase
open AFT
open scoped BigOperators Classical

/-- The actual little-endian fair-bit ticket, with no enumeration of the output space. -/
def boundedBoolTicket (bits : ℕ) : (Fin bits → Bool) ≃ Fin (2^bits) :=
  (Equiv.arrowCongr (Equiv.refl (Fin bits)) finTwoEquiv.symm).trans finFunctionFinEquiv

/-- One bounded rejection attempt: return the exact interval index or an explicit failure. -/
def boundedFinDraw (count : ℕ) (tape : Fin (Nat.size count) → Bool) : Option (Fin count) :=
  let ticket := _root_.InfoLossLAR.WorstCase.boundedBoolTicket (Nat.size count) tape
  if h : ticket.val<count then some ⟨ticket.val,h⟩ else none

/-- The success event is independent of every future LWE input. -/
noncomputable def boundedFinSuccess (count : ℕ) : ℝ := (count : ℝ)/(2 : ℝ)^Nat.size count



/-- The exact finite law of this actual Boolean program. -/
noncomputable def boundedFinLaw (count : ℕ) : _root_.AFT.FiniteDist (Option (Fin count)) :=
  (_root_.AFT.FiniteDist.uniform (Fin (Nat.size count) → Bool)).map (_root_.InfoLossLAR.WorstCase.boundedFinDraw count)









/-- The literal successful decoder uses base-q quotient and remainder digits. -/
def boundedBaseQDecode (q coordinates : ℕ) (hq : 0<q) (ticket : Fin (q^coordinates)) : Fin coordinates → Fin q :=
  fun index => ⟨ticket.val/q^index.val%q,Nat.mod_lt _ hq⟩





/-- The joint field-vector equivalence has an explicit modular digit implementation. -/
def boundedFieldEquiv (q coordinates : ℕ) [NeZero q] : Fin (q^coordinates) ≃ (Fin coordinates → ZMod q) :=
  finFunctionFinEquiv.symm.trans (Equiv.piCongrRight fun _ => (ZMod.finEquiv q).toEquiv)

def boundedFieldDecode (q coordinates : ℕ) [NeZero q] (ticket : Fin (q^coordinates)) : Fin coordinates → ZMod q :=
  fun index => ZMod.finEquiv q (_root_.InfoLossLAR.WorstCase.boundedBaseQDecode q coordinates (Nat.pos_of_ne_zero (NeZero.ne q)) ticket index)











/-- Split the sampled field coordinates into one shared auxiliary vector
and one independent field label at every position of the complete sample table. -/
def boundedSplitEquiv (F : Type*) (N samples labels : ℕ) :
    (Fin (N+samples*labels) → F) ≃ (Fin N → F) × (Fin samples → Fin labels → F) :=
  ((Equiv.arrowCongr finSumFinEquiv.symm (Equiv.refl F)).trans
    (Equiv.sumArrowEquivProdArrow (Fin N) (Fin (samples*labels)) F)).trans
    ((Equiv.refl (Fin N → F)).prodCongr
      ((Equiv.arrowCongr finProdFinEquiv.symm (Equiv.refl F)).trans
        (Equiv.curry (Fin samples) (Fin labels) F)))

def boundedSplit (F : Type*) (N samples labels : ℕ) (word : Fin (N+samples*labels) → F) :
    (Fin N → F) × (Fin samples → Fin labels → F) :=
  (fun index => word (Fin.castAdd (samples*labels) index),
    fun sample label => word (Fin.natAdd N (finProdFinEquiv (sample,label))))



/-- The semantic bijection corresponds exactly to the implemented quotient/remainder digits. -/
def boundedJointEquiv (q N samples labels : ℕ) [NeZero q] :
    Fin (q^(N+samples*labels)) ≃ (Fin N → ZMod q) × (Fin samples → Fin labels → ZMod q) :=
  (_root_.InfoLossLAR.WorstCase.boundedFieldEquiv q (N+samples*labels)).trans (_root_.InfoLossLAR.WorstCase.boundedSplitEquiv (ZMod q) N samples labels)

/-- The actual bounded Boolean sampler returns both all shared/table coins
or an explicit failure; its decoder uses integer division and remainder. -/
def boundedJointDraw (q N samples labels : ℕ) [NeZero q]
    (tape : Fin (Nat.size (q^(N+samples*labels))) → Bool) :
    Option ((Fin N → ZMod q) × (Fin samples → Fin labels → ZMod q)) :=
  match _root_.InfoLossLAR.WorstCase.boundedFinDraw (q^(N+samples*labels)) tape with
  | none => none
  | some ticket => some (_root_.InfoLossLAR.WorstCase.boundedSplit (ZMod q) N samples labels (_root_.InfoLossLAR.WorstCase.boundedFieldDecode q (N+samples*labels) ticket))













end InfoLossLAR.WorstCase

end


