  have hX : 4 ≤ ellOf n * (mmOf n + 4) + 4 := by omega
  have hj1 : 1 ≤ jOf n := by
    unfold jOf; rw [Nat.le_div_iff_mul_le (by norm_num)]; norm_num; omega
  constructor
  · rw [sOf_eq]
    have : 2 ≤ 2 ^ jOf n := le_trans (by norm_num) (Nat.pow_le_pow_right (by norm_num) hj1)
    nlinarith
  · have hsp : sOf n * p ≤ 2 ^ (2 * jOf n + bOf n + 3 * ellOf n + 2) := by
