-- title:
--   Corollary 2.6
-- statement:
--   For $n\geq0$, let $GZ(n)$ be the unital algebra generated by the embedded centers of the symmetric-group tower, and let $X_i=\sum_{j<i}(j,i)$. Then
--
--   $$GZ(n)=\langle X_1,\ldots,X_n\rangle.$$
--
--   For $n=0$, both sides are the scalar algebra of the trivial group. The result identifies two independently constructed subalgebras.
-- source:
--   A New Approach to the Representation Thoery of the Symmetric Groups. 2, arXiv:math/0503040v3, PDF p. 12, Corollary 2.6

import Definitions.Def_QAlgorithms_Papers_Independent_Renew46_P26

noncomputable section

namespace QAlgorithms.Papers.Independent.Renew46.P26

open scoped BigOperators

attribute [local instance] Classical.propDecidable

/-- Corollary 2.6 (PDF p.12). At n=0 the generated unital algebra is scalar.
The proof's final equality C[S_2]=C is a typo and is not asserted here. -/
theorem corollary_2_6 (n : ℕ) :
    gzAlgebra n = Algebra.adjoin ℂ (Set.range (yjm (n := n))) := by sorry

end QAlgorithms.Papers.Independent.Renew46.P26

end
