section
-- Source module: Solutions.KFV8Sim
/-!
# KFV §12: literal-to-register simulation of item-language code

`ISim π c c'`: `c'` is `c` with some literal pushes `.const j v` replaced by copies `.dup i j` of a
parameter stack `i` holding `v` (`π i = some v`). It is the `IStmt`-level analogue of
`KIL.RSim` and covers compiled register programs (`Ex.code` compiles `.lit v` to `.const` and
`.reg i` to `.dup`) as well as hand-written codes such as KFT's `carI`/`digI`.

**`ISim.runs`**: if `c` does not write any parameter stack and makes no calls (`NW π c`), every
run of `c` from a state with the parameters on top (`PV π s`) is matched by a run of `c'` with
the same final state and at most `2000 ×` the cost. This turns old codes whose *shape* does not
depend on `n` into uniform codes reading their sizes from stacks.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KIL

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The stacks an operation may change. -/
def opW : IOp HS → List (Fin HS)
  | .add i j k => [i, j, k]
  | .neg i => [i]
  | .dup _ j => [j]
  | .drop i => [i]
  | .mv i j => [i, j]
  | .const i _ => [i]
  | .mark i => [i]
  | .unmark i => [i]
  | .shl i _ => [i]
  | .split i _ k => [i, k]
  | .read i j _ => [i, j]
  | .write i j => [i, j]
  | .cat i _ k => [i, k]

/-- `c` writes no parameter stack and makes no calls. -/
def NW (π : PMap) : IStmt HS Pp → Prop
  | .skip => True
  | .op o => ∀ i ∈ opW o, π i = none
  | .seq a b => NW π a ∧ NW π b
  | .ite _ _ a b => NW π a ∧ NW π b
  | .loop _ _ a => NW π a
  | .call _ => False

/-- `c'` is `c` with some literal pushes replaced by parameter copies (`par`), or by any code
computing the literal from the parameters at most `2000 ×` as expensively (`parC`). -/
inductive ISim (I : List Sym) (iprog : Fin Pp → IStmt HS Pp) (π : PMap) :
    IStmt HS Pp → IStmt HS Pp → Prop
  | skip : ISim I iprog π .skip .skip
  | op (o : IOp HS) : ISim I iprog π (.op o) (.op o)
  | call (j : Fin Pp) : ISim I iprog π (.call j) (.call j)
  | par {i j : Fin HS} {v : ℤ} : π i = some v → i ≠ j →
      ISim I iprog π (.op (.const j v)) (.op (.dup i j))
  | parC {j : Fin HS} {v : ℤ} {d : IStmt HS Pp} :
      (∀ s : IState HS, PV π s → IRuns I iprog d s (s.upd j (.int v :: s.G j)) (2000 * (zsz v + 2))) →
      ISim I iprog π (.op (.const j v)) d
  | seq {a a' b b' : IStmt HS Pp} : ISim I iprog π a a' → ISim I iprog π b b' →
      ISim I iprog π (.seq a b) (.seq a' b')
  | ite {i : Fin HS} {f : Cls → Bool} {a a' b b' : IStmt HS Pp} : ISim I iprog π a a' →
      ISim I iprog π b b' → ISim I iprog π (.ite i f a b) (.ite i f a' b')
  | loop {i : Fin HS} {f : Cls → Bool} {a a' : IStmt HS Pp} : ISim I iprog π a a' →
      ISim I iprog π (.loop i f a) (.loop i f a')

/-! ## Compiled register programs -/

end NLogN.KFV

end

section
-- Source module: Solutions.KFV9Gen
/-!
# KFV §13: generalized literal substitution and the write analysis

* `wl c` (stacks written, calls ignored) and `nc c` (no calls): `NW_of` gives `NW π c` when no
  parameter stack is written. `wl_ecode`: compiled expressions write only the scratch `56…63`;
  `wl_fcode`: compiled register programs write `p.writes`, the scratch, and the `toUL` stacks.
* `EG π e e'`: `e'` is `e` with literals `v` replaced by any clean expression over the parameters
  that evaluates to `v` at cost `≤ 2000 (zsz v + 2)` (e.g. `2r = r + r`, `-K`, `B / 2`).
  `GSim` is the register-program version. **`ISim.fcodeG`**: `GSim π p p'` gives
  `ISim π (fcode p) (fcode p')`. **`ISim.pushE`**: a literal push `const j v` on any stack
  `j ≠ 56` may be replaced by `e.code; mv 56 j`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open IntMul KIL KFD

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Write analysis -/

/-- Stacks written by a code (calls ignored). -/
def wl : IStmt HS Pp → List (Fin HS)
  | .skip => []
  | .op o => opW o
  | .seq a b => wl a ++ wl b
  | .ite _ _ a b => wl a ++ wl b
  | .loop _ _ a => wl a
  | .call _ => []

/-- No calls. -/
def nc : IStmt HS Pp → Bool
  | .call _ => false
  | .seq a b => nc a && nc b
  | .ite _ _ a b => nc a && nc b
  | .loop _ _ a => nc a
  | _ => true

/-! ## Generalized substitution -/

end NLogN.KFV

end

section
-- Source module: Solutions.KFWSwap1
/-!
# KFW: uniform Lemma 12 on integer arrays (parameters in registers)

The integer-array swap `KFS.swW q w Pre G Suf u` (to bits, Lemma 12, back to integers) with its
size-dependent literals read from registers:

* `toBitsU` / `fromBitsU`: `KFL.toBitsI N w` / `fromBitsI N w` with `N`, `w` copied from the
  registers `sN`, `sW` (`ISim`, at most `2000 ×` the cost);
* `swIU q`: the Lemma 12 wrapper `KFL.swI` with the four parameters pushed from the registers
  `sP, sG, sS, sU` (**`swIU_spec`**);
* `swWU q`: the composite (**`swWU_spec`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KIL KFD KFE KFB KFL KFS KFV AModel AModelL12 NetProp7

/-- Registers: `w`, `u`, `vol Pre`, `vol G`, `vol Suf · (w+1)`, `N`. -/
abbrev sW : Fin HS := 1
abbrev sU : Fin HS := 2
abbrev sP : Fin HS := 3
abbrev sG : Fin HS := 4
abbrev sS : Fin HS := 5
abbrev sN : Fin HS := 6

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Conversions -/

def toBitsU : IStmt HS Pp :=
  .seq (.op (.dup sN cPN)) (.seq (.op (.dup NLogN.KFW.sW cPW)) (.seq (.op (.const cR2 2))
    (.seq (KFC.wrap cPN cCN cDN (KFC.wrap cPW cCw cDw toCore))
    (.seq (.op (.drop cR2)) (.seq (.op (.drop cPW)) (.op (.drop cPN)))))))

def fromBitsU : IStmt HS Pp :=
  .seq (.op (.dup sN cPN)) (.seq (.op (.dup NLogN.KFW.sW cPW)) (.seq (.op (.const cR2 2))
    (.seq (KFC.wrap cPN cCN cDN (KFC.wrap cPW cCw cDw fromCore))
    (.seq (.op (.drop cR2)) (.seq (.op (.drop cPW)) (.op (.drop cPN)))))))

/-- The parameter map of the conversions. -/
def πNW (N w : ℕ) : PMap := fun i => if i = sN then some (N : ℤ) else if i = NLogN.KFW.sW then some (w : ℤ) else none

/-! ## The Lemma 12 wrapper with register parameters -/

/-- The parameter pushes, from the registers. -/
def swLU : List (Fin HS × Ex HS) :=
  [(KIL.kP, .reg NLogN.KFW.sP), (KIL.kG, .reg sG), (KIL.kS, .reg sS), (aU, .reg sU)]

/-- **The uniform swap wrapper.** -/
def swIU (q : ℕ) : IStmt HS 1 := withPushI swLU (l12C q)

/-! ## The integer-array swap -/

/-- **The uniform integer-array swap**: to bits, Lemma 12, back to integers. -/
def swWU (q : ℕ) : IStmt HS 1 := .seq toBitsU (.seq (swIU q) fromBitsU)

end NLogN.KFW

end

section
-- Source module: Solutions.KFWSwap2
/-!
# KFW: reading the swap descriptor

The descriptor `descSw w u p q sh = [w, u, p, q, |sh|, sh_0, …]` sits on the managed stack `dS`.
`descP` reads it into the registers of `swWU` (`w`, `u`, `vol Pre`, `vol G`, `vol Suf · (w+1)`,
`N` for the Gaussian array of shape `sh ++ [2]`) by moving it item by item to a temporary stack
and back, with unary-counted loops (`rep`); **`descP_fsp`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KIL KFD KFB KFS AModel

/-- Descriptor and scratch stacks. -/
abbrev dS : Fin HS := 7
abbrev sT : Fin HS := 8
abbrev xp : Fin HS := 9
abbrev xq : Fin HS := 10
abbrev xL : Fin HS := 11
abbrev aS : Fin HS := 12
abbrev cC : Fin HS := 13

/-- Move one item from `dS` to `sT`. -/
def mv1 : RS := .seq (.push sT (.reg NLogN.KFW.dS)) (.pop NLogN.KFW.dS)

/-- Move one item from `sT` back to `dS`. -/
def mvb1 : RS := .seq (.push NLogN.KFW.dS (.reg sT)) (.pop sT)

/-- Quadratic cost unit. -/
def cq (B : ℕ) : ℕ := 10 ^ 8 * (B + 2) ^ 2

/-- Read the top of `dS` into `X` and move it to `sT`. -/
def hdr (X : Fin HS) : RS := .seq (.push X (.reg NLogN.KFW.dS)) NLogN.KFW.mv1

/-- One step of a product phase: `A *= top dS`, move the top to `sT`. -/
def phB (A : Fin HS) : RS := .seq (.asg A (.mul (.reg A) (.reg NLogN.KFW.dS))) NLogN.KFW.mv1

/-- A product phase of `n` steps. -/
def phR (A : Fin HS) (n : Ex HS) : RS := .rep cC n (phB A)

/-- The state after `k` steps of a product phase. -/
def phS (f : Fin HS → List ℤ) (A : Fin HS) (a0 : ℕ) (ys : List ℕ) (rest T0 : List ℤ) (k : ℕ) :
    Fin HS → List ℤ :=
  Function.update (Function.update (Function.update f A [((a0 * (ys.take k).prod : ℕ) : ℤ)]) sT
    (((ys.take k).reverse.map fun y : ℕ => (y : ℤ)) ++ T0)) NLogN.KFW.dS
    ((ys.drop k).map (fun y : ℕ => (y : ℤ)) ++ rest)

/-- Move `n` items back from `sT` to `dS`. -/
def bkR (n : Ex HS) : RS := .rep cC n mvb1

def bkS (f : Fin HS → List ℤ) (zs T1 D0 : List ℤ) (k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update f NLogN.KFW.dS ((zs.take k).reverse ++ D0)) sT (zs.drop k ++ T1)

/-! ## The descriptor program -/

/-- **Reading the descriptor** into the registers of `swWU`. -/
def descP : RS :=
  .seq (hdr NLogN.KFW.sW)
  (.seq (hdr sU)
  (.seq (hdr xp)
  (.seq (hdr xq)
  (.seq (hdr xL)
  (.seq (.push NLogN.KFW.sP (.lit 1))
  (.seq (.push sG (.lit 1))
  (.seq (.push NLogN.KFW.aS (.lit 1))
  (.seq (phR NLogN.KFW.sP (.reg xp))
  (.seq (NLogN.KFW.mv1)
  (.seq (phR sG (.add (.add (.reg xq) (.neg (.reg xp))) (.lit (-1))))
  (.seq (NLogN.KFW.mv1)
  (.seq (phR NLogN.KFW.aS (.add (.add (.reg xL) (.neg (.reg xq))) (.lit (-1))))
  (.seq (bkR (.reg xL))
  (.seq (mvb1)
  (.seq (mvb1)
  (.seq (mvb1)
  (.seq (mvb1)
  (.seq (mvb1)
  (.seq (.push sS (.mul (.mul (.reg NLogN.KFW.aS) (.lit 2)) (.add (.reg NLogN.KFW.sW) (.lit 1))))
  (.seq (.push sN (.mul (.mul (.mul (.mul (.mul (.lit 2) (.reg NLogN.KFW.sP)) (.reg sG)) (.reg NLogN.KFW.aS)) (.pow2 (.reg sU))) (.pow2 (.reg sU))))
  (.seq (.pop NLogN.KFW.aS)
  (.seq (.pop xL)
  (.seq (.pop xq)
  ((.pop xp)))))))))))))))))))))))))

/-- The managed stacks of `descP` as a record. -/
def stD (f : Fin HS → List ℤ) (D T W U P G S N X Y Lr A : List ℤ) : Fin HS → List ℤ := fun j =>
  if j = NLogN.KFW.dS then D else if j = sT then T else if j = NLogN.KFW.sW then W else if j = sU then U else
  if j = NLogN.KFW.sP then P else if j = sG then G else if j = sS then S else if j = sN then N else
  if j = xp then X else if j = xq then Y else if j = xL then Lr else if j = NLogN.KFW.aS then A else f j

/-- The registers `descP` produces. -/
def regsSw (f : Fin HS → List ℤ) (w u p q : ℕ) (sh : List ℕ) : Fin HS → List ℤ :=
  stD f (f NLogN.KFW.dS) [] [(w : ℤ)] [(u : ℤ)] [((preS sh p).prod : ℤ)] [((midS sh p q).prod : ℤ)]
    [(((sufS sh q).prod * 2 * (w + 1) : ℕ) : ℤ)] [((2 * sh.prod : ℕ) : ℤ)] [] [] [] []

/-! ### Record lemmas for `stD` -/

section StD
variable (f : Fin HS → List ℤ) (D T W U P G S N X Y Lr A : List ℤ) (v : List ℤ)

@[simp] theorem stD_dS : stD f D T W U P G S N X Y Lr A NLogN.KFW.dS = D := rfl

@[simp] theorem stD_sT : stD f D T W U P G S N X Y Lr A sT = T := rfl

@[simp] theorem stD_sW : stD f D T W U P G S N X Y Lr A NLogN.KFW.sW = W := rfl

@[simp] theorem stD_sU : stD f D T W U P G S N X Y Lr A sU = U := rfl

@[simp] theorem stD_sP : stD f D T W U P G S N X Y Lr A NLogN.KFW.sP = P := rfl

@[simp] theorem stD_sG : stD f D T W U P G S N X Y Lr A sG = G := rfl

@[simp] theorem stD_sS : stD f D T W U P G S N X Y Lr A sS = S := rfl

@[simp] theorem stD_sN : stD f D T W U P G S N X Y Lr A sN = N := rfl

@[simp] theorem stD_xp : stD f D T W U P G S N X Y Lr A xp = X := rfl

@[simp] theorem stD_xq : stD f D T W U P G S N X Y Lr A xq = Y := rfl

@[simp] theorem stD_xL : stD f D T W U P G S N X Y Lr A xL = Lr := rfl

@[simp] theorem stD_aS : stD f D T W U P G S N X Y Lr A NLogN.KFW.aS = A := rfl

end StD

/-- Per-piece cost budget of `descP`. -/
def xD (L B BL : ℕ) : ℕ := 2 * cq BL + 2 * L * cq B + cRep L

end NLogN.KFW

end

section
-- Source module: Solutions.KFWSwapG
/-!
# KFW: uniform Lemma 12 on Gaussian arrays (`SwapNeed`)

`swGU q = descP ; swWU q ; popP`: read the descriptor `descSw w u p q sh` on `dS` into the
registers of `swWU` (`descP`), run the register-driven integer swap on the shape `sh ++ [2]`,
and pop the registers again.  **`swGU_spec`**, and **`swapNeed : KFM.SwapNeed`** with the table
`kTable (fun _ => (swGU q).ren id (gL 1))` (one fixed prime `q`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KIL KFD KFB KFS KFL AModel AModelL12

/-- Pop the six registers of `swWU`. -/
def popP : RS :=
  .seq (.pop sN) (.seq (.pop sS) (.seq (.pop sG) (.seq (.pop sP) (.seq (.pop sU) (.pop NLogN.KFW.sW)))))

/-- **The uniform Gaussian swap.** -/
def swGU (q : ℕ) : IStmt HS 1 := .seq (fcode descP) (.seq (swWU q) (fcode popP))

end NLogN.KFW

end


