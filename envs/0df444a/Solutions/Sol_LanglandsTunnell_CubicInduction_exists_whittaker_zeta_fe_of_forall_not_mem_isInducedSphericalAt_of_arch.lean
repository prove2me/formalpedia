namespace FibreRegroup
p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open IsDedekindDomain NumberField
open LanglandsTunnell.RankinSelberg

variable (F : Type*) [Field F] (K : Type*) [Field K] [Algebra (𝓞 F) (𝓞 K)]
  [Algebra.IsIntegral (𝓞 F) (𝓞 K)]

private def toBase (𝔓 : HeightOneSpectrum (𝓞 K)) : HeightOneSpectrum (𝓞 F) :=
  𝔓.under (𝓞 F)

private theorem finprod_eq_finprod_finprod_primeFibre (E : HeightOneSpectrum (𝓞 K) → ℂ)
    (hE : Function.HasFiniteMulSupport E) :
    ∏ᶠ 𝔓, E 𝔓 = ∏ᶠ v : HeightOneSpectrum (𝓞 F), ∏ᶠ 𝔓 ∈ primeFibre F K v, E 𝔓 := by
  classical
  have hS : Function.mulSupport E ⊆ ↑hE.toFinset := fun 𝔓 h => by simpa using h
  rw [finprod_eq_prod_of_mulSupport_subset E hS,
    finprod_eq_prod_of_mulSupport_subset _ (s := hE.toFinset.image (toBase F K)) ?_]
  · rw [← Finset.prod_fiberwise_of_maps_to (fun 𝔓 h => Finset.mem_image_of_mem (toBase F K) h) E]
    refine Finset.prod_congr rfl fun v _ => ?_
    refine (finprod_mem_eq_prod_of_inter_mulSupport_eq E ?_).symm
    ext 𝔓
    simp only [Set.mem_inter_iff, mem_primeFibre, Finset.coe_filter, Set.mem_setOf_eq,
      Function.mem_mulSupport, Set.Finite.mem_toFinset, toBase]
    tauto
  · intro v hv
    rw [Function.mem_mulSupport] at hv
    by_contra hvS
    refine hv (finprod_mem_of_eqOn_one fun 𝔓 h𝔓 => ?_)
    show E 𝔓 = 1
    by_contra hne
    exact hvS (Finset.mem_image.2 ⟨𝔓, hE.mem_toFinset.2 hne, h𝔓⟩)

end LanglandsTunnell.CubicInduction.FibreRegroup
