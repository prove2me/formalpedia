end Piece_EtPi1Geo_Cmp

/-! ### piece EtPi1Geo_InstA1 (lib module EtPi1Geo_InstA1) -/
section Piece_EtPi1Geo_InstA1


/-!
# S4-EtPi1Geo, G6 (InstA1): `cmp` for `A¹`: `π₁(k[X], FK) ≃ₜ* π₁^geo(𝔽_q[X], 𝔽_q(X))`

`k` algebraically closed and algebraic over the finite field `𝔽_q`, `FK = Frac k[X]` (any `IsFractionRing`).
The algebras `𝔽_q[X] → k[X]`, `𝔽_q[X] → FK`, `𝔽_q(X) → FK`, `k → FK` are local (`algPK`, `algPF`, `algRF`,
`algKF`); the field hypotheses of `cmp` are `hgen_A1`, `hcl_A1`, `isAlgebraic_A1`, `hq_A1`; the ring one
`isIntegral_A1`. Exports **`cmpA1`**, **`iotaA1`** (a ring isomorphism), **`cmpA1_apply`**, and the
restriction lemmas **`iotaA1_algebraMap`**, **`iotaA1_C`** (`k` goes to the constants through `kA1`),
**`iotaA1_X`** (`X ↦ X`), `kA1_surj` (every constant of `𝔽_q(X)‾` is `kA1 c`).
-/

set_option autoImplicit false

namespace RamanujanPetersson
namespace EtPi1Geo

open Polynomial IntermediateField CurveCoh

noncomputable section

theorem charP_k (Fq k : Type) [Field Fq] [Field k] [Algebra Fq k] (p : ℕ) [CharP Fq p] : CharP k p :=
  charP_of_injective_algebraMap (algebraMap Fq k).injective p

theorem charP_RF (Fq : Type) [Field Fq] (p : ℕ) [CharP Fq p] : CharP (RatFunc Fq) p :=
  charP_of_injective_algebraMap (algebraMap Fq (RatFunc Fq)).injective p

section A1

variable (Fq k FK : Type) [Field Fq] [Field k] [Algebra Fq k] [Field FK] [Algebra k[X] FK]
  [IsFractionRing k[X] FK]

/-- `𝔽_q[X] → k[X]` coefficientwise (local use only). -/
abbrev algPK : Algebra Fq[X] k[X] := (mapRingHom (algebraMap Fq k)).toAlgebra

/-- `𝔽_q[X] → FK` through `k[X]` (local use only). -/
abbrev algPF : Algebra Fq[X] FK := ((algebraMap k[X] FK).comp (mapRingHom (algebraMap Fq k))).toAlgebra

theorem injective_PF : Function.Injective ((algebraMap k[X] FK).comp (mapRingHom (algebraMap Fq k))) :=
  (IsFractionRing.injective k[X] FK).comp (map_injective _ (algebraMap Fq k).injective)

/-- `𝔽_q(X) → FK` (local use only). -/
abbrev algRF : Algebra (RatFunc Fq) FK :=
  (IsFractionRing.lift (K := RatFunc Fq) (injective_PF Fq k FK)).toAlgebra

/-- `k → FK` (local use only). -/
abbrev algKF : Algebra k FK := ((algebraMap k[X] FK).comp C).toAlgebra

theorem tower_PRF : letI := algRF Fq k FK; letI := algPF Fq k FK; IsScalarTower Fq[X] (RatFunc Fq) FK := by
  letI := algRF Fq k FK; letI := algPF Fq k FK
  exact IsScalarTower.of_algebraMap_eq fun a => (IsFractionRing.lift_algebraMap _ a).symm

omit [IsFractionRing k[X] FK] in
theorem tower_PKF : letI := algPK Fq k; letI := algPF Fq k FK; IsScalarTower Fq[X] k[X] FK := by
  letI := algPK Fq k; letI := algPF Fq k FK
  exact IsScalarTower.of_algebraMap_eq fun _ => rfl

theorem algRF_X : letI := algRF Fq k FK
    algebraMap (RatFunc Fq) FK RatFunc.X = algebraMap k[X] FK X := by
  letI := algRF Fq k FK
  show IsFractionRing.lift (K := RatFunc Fq) (injective_PF Fq k FK) RatFunc.X = _
  rw [← RatFunc.algebraMap_X, IsFractionRing.lift_algebraMap, RingHom.comp_apply, coe_mapRingHom, map_X]

/-- `FK = 𝔽_q(X)(k)`. -/
theorem mem_adjoin_A1 (y : FK) : letI := algRF Fq k FK; letI := algKF k FK
    y ∈ adjoin (RatFunc Fq) (Set.range (algebraMap k FK)) := by
  letI := algRF Fq k FK; letI := algKF k FK
  have hX : algebraMap k[X] FK X ∈ adjoin (RatFunc Fq) (Set.range (algebraMap k FK)) := by
    rw [← algRF_X Fq k FK]
    exact IntermediateField.algebraMap_mem _ _
  have hpoly : ∀ f : k[X], algebraMap k[X] FK f ∈ adjoin (RatFunc Fq) (Set.range (algebraMap k FK)) := by
    intro f
    rw [f.as_sum_range_C_mul_X_pow, map_sum]
    refine sum_mem fun i _ => ?_
    rw [map_mul, map_pow]
    exact mul_mem (subset_adjoin _ _ ⟨f.coeff i, rfl⟩) (pow_mem hX _)
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := k[X]) y
  exact div_mem (hpoly a) (hpoly b)

variable (p : ℕ) [Fact p.Prime] [Finite Fq] [CharP Fq p]

omit [Fact p.Prime] in
theorem isConst_A1 [Algebra.IsAlgebraic Fq k] (c : k) : IsConst p c :=
  haveI := charP_k Fq k p
  isConst_of_isIntegral p (Fq := Fq) (Algebra.IsAlgebraic.isAlgebraic c).isIntegral

omit [Fact p.Prime] in
theorem hgen_A1 [Algebra.IsAlgebraic Fq k] : letI := algRF Fq k FK
    ∀ c : FK, c ∈ adjoin (RatFunc Fq) {x : FK | IsConst p x} := by
  letI := algRF Fq k FK; letI := algKF k FK
  exact hgen_of p (RatFunc Fq) FK k (isConst_A1 Fq k p) (mem_adjoin_A1 Fq k FK)

include p in
theorem isAlgebraic_A1 [Algebra.IsAlgebraic Fq k] : letI := algRF Fq k FK
    Algebra.IsAlgebraic (RatFunc Fq) FK := by
  letI := algRF Fq k FK; letI := algKF k FK
  exact isAlgebraic_of p (RatFunc Fq) FK k (isConst_A1 Fq k p) (mem_adjoin_A1 Fq k FK)

include p in
theorem isIntegral_A1 [Algebra.IsAlgebraic Fq k] : letI := algPK Fq k; Algebra.IsIntegral Fq[X] k[X] :=
  isIntegral_polyMap p (isConst_A1 Fq k p)

omit [IsFractionRing k[X] FK] in
theorem hcl_A1 [IsAlgClosed k] :
    ∀ x : AlgebraicClosure FK, IsConst p x → ∃ c : FK, algebraMap FK _ c = x :=
  letI := algKF k FK
  hcl_of_isAlgClosed p FK k

omit [Fact p.Prime] [Finite Fq] in
theorem hq_A1 [Fintype Fq] : ∃ e, 0 < e ∧ Fintype.card Fq = p ^ e := by
  obtain ⟨n, -, hn⟩ := FiniteField.card Fq p
  exact ⟨n, n.pos, hn⟩

end A1

section CmpA1

variable (p : ℕ) [Fact p.Prime] (Fq k FK : Type) [Field Fq] [Fintype Fq] [CharP Fq p] [Field k] [IsAlgClosed k]
  [Algebra Fq k] [Algebra.IsAlgebraic Fq k] [Field FK] [Algebra k[X] FK] [IsFractionRing k[X] FK]

/-- **PI1-CMP for `A¹`**: `π₁(k[X], FK) ≃ₜ* π₁^geo(𝔽_q[X], 𝔽_q(X))`, conjugation by `iotaA1`. -/
def cmpA1 : Pi1 k[X] FK ≃ₜ* pi1geo Fq[X] (RatFunc Fq) (Fintype.card Fq) :=
  letI := algPK Fq k; letI := algPF Fq k FK; letI := algRF Fq k FK
  haveI := tower_PRF Fq k FK; haveI := tower_PKF Fq k FK
  haveI := charP_RF Fq p; haveI := isAlgebraic_A1 Fq k FK p; haveI := isIntegral_A1 Fq k p
  cmp p Fq[X] (RatFunc Fq) FK k[X] (Fintype.card Fq) (hgen_A1 Fq k FK p) (hq_A1 Fq p) (hcl_A1 k FK p)

/-- **The field identification for `A¹`**: `maxUnram k[X] FK ≃+* maxUnram 𝔽_q[X] 𝔽_q(X)`. -/
def iotaA1 : maxUnram k[X] FK ≃+* maxUnram Fq[X] (RatFunc Fq) :=
  letI := algPK Fq k; letI := algPF Fq k FK; letI := algRF Fq k FK
  haveI := tower_PRF Fq k FK; haveI := tower_PKF Fq k FK
  haveI := charP_RF Fq p; haveI := isAlgebraic_A1 Fq k FK p; haveI := isIntegral_A1 Fq k p
  (iota p Fq[X] (RatFunc Fq) FK k[X] (hgen_A1 Fq k FK p)).toRingEquiv

/-- **`cmpA1_apply`**: `cmpA1 g = ι ∘ g ∘ ι⁻¹`. -/
theorem cmpA1_apply (σ : Pi1 k[X] FK) (x : maxUnram Fq[X] (RatFunc Fq)) :
    (cmpA1 p Fq k FK σ : Pi1 Fq[X] (RatFunc Fq)) x = iotaA1 p Fq k FK (σ ((iotaA1 p Fq k FK).symm x)) := by
  letI := algPK Fq k; letI := algPF Fq k FK; letI := algRF Fq k FK
  haveI := tower_PRF Fq k FK; haveI := tower_PKF Fq k FK
  haveI := charP_RF Fq p; haveI := isAlgebraic_A1 Fq k FK p; haveI := isIntegral_A1 Fq k p
  exact cmp_apply p Fq[X] (RatFunc Fq) FK k[X] (Fintype.card Fq) (hgen_A1 Fq k FK p) (hq_A1 Fq p)
    (hcl_A1 k FK p) σ x

/-- The `𝔽_q(X)`-embedding `FK → 𝔽_q(X)‾` (`phiFK`). -/
def phiA1 : FK →+* AlgebraicClosure (RatFunc Fq) :=
  letI := algRF Fq k FK
  haveI := isAlgebraic_A1 Fq k FK p
  (phiFK (RatFunc Fq) FK).toRingHom

/-- `k → 𝔽_q(X)‾`: the constants of `FK`, embedded by `phiA1`. -/
def kA1 : k →+* AlgebraicClosure (RatFunc Fq) := (phiA1 p Fq k FK).comp ((algebraMap k[X] FK).comp C)

omit [IsAlgClosed k] in
/-- **Restriction lemma**: `ι` is `phiA1` on `FK`. -/
theorem iotaA1_algebraMap (c : FK) :
    (iotaA1 p Fq k FK (algebraMap FK (maxUnram k[X] FK) c) : AlgebraicClosure (RatFunc Fq)) = phiA1 p Fq k FK c := by
  letI := algPK Fq k; letI := algPF Fq k FK; letI := algRF Fq k FK
  haveI := tower_PRF Fq k FK; haveI := tower_PKF Fq k FK
  haveI := charP_RF Fq p; haveI := isAlgebraic_A1 Fq k FK p; haveI := isIntegral_A1 Fq k p
  exact iota_algebraMap p Fq[X] (RatFunc Fq) FK k[X] (hgen_A1 Fq k FK p) c

omit [IsAlgClosed k] in
/-- `ι` sends the constant `c : k` to `kA1 c`. -/
theorem iotaA1_C (c : k) :
    (iotaA1 p Fq k FK (algebraMap FK (maxUnram k[X] FK) (algebraMap k[X] FK (C c))) :
      AlgebraicClosure (RatFunc Fq)) = kA1 p Fq k FK c :=
  iotaA1_algebraMap p Fq k FK _

omit [IsAlgClosed k] in
/-- `ι` fixes `X`. -/
theorem iotaA1_X :
    (iotaA1 p Fq k FK (algebraMap FK (maxUnram k[X] FK) (algebraMap k[X] FK X)) :
      AlgebraicClosure (RatFunc Fq)) = algebraMap (RatFunc Fq) (AlgebraicClosure (RatFunc Fq)) RatFunc.X := by
  rw [iotaA1_algebraMap]
  letI := algRF Fq k FK
  haveI := isAlgebraic_A1 Fq k FK p
  rw [← algRF_X Fq k FK]
  exact (phiFK (RatFunc Fq) FK).commutes RatFunc.X

omit [IsAlgClosed k] in
/-- `kA1` lands in the constants. -/
theorem kA1_isConst (c : k) : IsConst p (kA1 p Fq k FK c) :=
  (isConst_A1 Fq k p c).map (kA1 p Fq k FK)

/-- `kA1` is onto the constants of `𝔽_q(X)‾`. -/
theorem kA1_surj (x : AlgebraicClosure (RatFunc Fq)) (hx : IsConst p x) : ∃ c : k, kA1 p Fq k FK c = x :=
  letI := (kA1 p Fq k FK).toAlgebra
  exists_algebraMap_eq_of_isConst p k _ x hx

end CmpA1

end

