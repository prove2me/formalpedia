/-! ## The real Γ core -/

/-- Real-function instance of the `gammaCore` body: atoms `θg = x g'`, `θ₂g = x² g''`. -/
noncomputable def realCore (h Q J : ℝ) (F b A : ℝ → ℝ) (x : ℝ) : ℝ :=
  coreE x (1 - h * x) h Q J (F x) (x * deriv F x) (b x) (A x) (x * deriv A x)
    (x ^ 2 * deriv (deriv A) x)

