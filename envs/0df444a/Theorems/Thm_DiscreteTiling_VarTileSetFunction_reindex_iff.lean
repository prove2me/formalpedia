theorem DiscreteTiling.VarTileSetFunction.reindex_iff {f : VarTileSetFunction Y ps Prop H} {y : Y} {t : TileSet ps ιᵤ} (e : Eᵤ) :
    f y (t.reindex e) ↔ f y t := by sorry
