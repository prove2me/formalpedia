-- title:
--   Primitive numerator norm is not divisible by two
-- statement:
--   Let $x\in\mathbb Z[\omega]$. Distinguish $v_{\sqrt2}$ from the base-two valuation $v_2$, both computed by divisibility inside this ring. Then
--
--   $$
--   v_{\sqrt2}(x)=0\quad\Longrightarrow\quad v_2(|x|^2)=0.
--   $$
--
--   The norm valuation has base two, rather than $\sqrt2$. This gives the primitive norm obstruction used in the appendix.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 20, Appendix A unnumbered corollary: primitive numerator norm is not divisible by 2

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Appendix A, PDF p.20: primitive numerator norm has zero valuation at base 2. -/
theorem primitive_norm_base_two (x : integralRing) (hprimitive : gde (x : ℂ) = 0) :
    gdeTwo (normSquared (x : ℂ)) = 0 := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
