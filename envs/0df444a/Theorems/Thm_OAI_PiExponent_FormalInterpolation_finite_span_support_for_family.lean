-- title:
--   One finite generator list supports a finite family of span memberships
-- statement:
--   For a finite family of elements, if each lies in the ideal generated by a restricted range, then a single finite list of elements from that restricted range generates a span containing the whole family.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

universe u v w

theorem OAI.PiExponent.FormalInterpolation.finite_span_support_for_family
    {R : Type u} [CommSemiring R]
    {ι : Type v} [Fintype ι] [DecidableEq ι]
    {α : Type w}
    (y : ι → R) (P : α → Prop) (g : α → R)
    (h : ∀ i : ι, y i ∈ Ideal.span (Set.range (fun a : {a // P a} => g a.1))) :
    ∃ k : Nat, ∃ f : Fin k → {a // P a},
      ∀ i : ι, y i ∈ Ideal.span (Set.range (fun j : Fin k => g (f j).1)) := by sorry
