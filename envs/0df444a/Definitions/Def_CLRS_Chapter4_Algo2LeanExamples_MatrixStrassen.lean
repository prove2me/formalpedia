/-! Source: proofs/chapter4/StrassenValue.lean -/

section

open Chapter4Math
namespace StrassenValues
abbrev Seq := Int → Int → Int

/-- Pointwise addition/subtraction on a finite square of nested rows. -/
def linearValues (count : Nat) (sign : Int) (a b : Seq) : Seq := fun row col =>
  if 0 ≤ row ∧ row < (count : Int) ∧ 0 ≤ col ∧ col < (count : Int)
  then a row col + sign * b row col else 0

/-- Copy a square block into fresh rows. The stride argument is retained in the
    source interface, but nested indexing does not need a stride. -/
def quadrantValues (_n h row col : Int) (a : Seq) : Seq := fun i j =>
  if 0 ≤ i ∧ i < h ∧ 0 ≤ j ∧ j < h then a (row+i) (col+j) else 0

/-- Place four nested blocks into the corresponding quadrants. -/
def joinValues (h : Int) (a b c d : Seq) : Seq := fun row col =>
  if 0 ≤ row ∧ row < 2*h ∧ 0 ≤ col ∧ col < 2*h then
    if row < h then
      if col < h then a row col else b row (col-h)
    else
      if col < h then c (row-h) col else d (row-h) (col-h)
  else 0

/-- Finite matrix entries represented by the first n entries of the first n rows. -/
def Rep (n : Nat) (a : Seq) (A : Matrix) : Prop :=
  ∀ i j, i < n → j < n → a (i : Int) (j : Int) = A i j

/-- Pure value returned by the seven recursive products in the source. -/
def strassenValue : Nat → Seq → Seq → Seq
  | 0, a, b => fun row col => if row = 0 ∧ col = 0 then a 0 0 * b 0 0 else 0
  | depth+1, a, b =>
    let h : Nat := 2^depth
    let n : Int := 2*h
    let a11 := quadrantValues n h 0 0 a
    let a12 := quadrantValues n h 0 h a
    let a21 := quadrantValues n h h 0 a
    let a22 := quadrantValues n h h h a
    let b11 := quadrantValues n h 0 0 b
    let b12 := quadrantValues n h 0 h b
    let b21 := quadrantValues n h h 0 b
    let b22 := quadrantValues n h h h b
    let p1 := strassenValue depth a11 (linearValues h (-1) b12 b22)
    let p2 := strassenValue depth (linearValues h 1 a11 a12) b22
    let p3 := strassenValue depth (linearValues h 1 a21 a22) b11
    let p4 := strassenValue depth a22 (linearValues h (-1) b21 b11)
    let p5 := strassenValue depth (linearValues h 1 a11 a22) (linearValues h 1 b11 b22)
    let p6 := strassenValue depth (linearValues h (-1) a12 a22) (linearValues h 1 b21 b22)
    let p7 := strassenValue depth (linearValues h (-1) a11 a21) (linearValues h 1 b11 b12)
    let c11 := linearValues h 1 (linearValues h (-1) (linearValues h 1 p5 p4) p2) p6
    let c12 := linearValues h 1 p1 p2
    let c21 := linearValues h 1 p3 p4
    let c22 := linearValues h (-1) (linearValues h (-1) (linearValues h 1 p5 p1) p3) p7
    joinValues h c11 c12 c21 c22
























end StrassenValues

end

