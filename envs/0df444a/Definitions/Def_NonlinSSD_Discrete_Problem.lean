-- title:
--   Problem (38)–(41), the Slater condition, the utility sets V_i, the Lagrangians (42) and Λ, the utility (46) and the dual functional (47)
-- statement:
--   These are the objects of §5 of Dentcheva–Ruszczyński, where the probability space is finite.
--
--   **Data.** There are $n$ scenarios $\omega_1,\dots,\omega_n$ with probabilities $p_1,\dots,p_n$ ($p_j \ge 0$, $\sum_j p_j = 1$ wherever a theorem needs it), and $m$ dominance constraints, indexed by $i \in I = \{1,\dots,m\}$; $J = \{1,\dots,n\}$. The decision $z$ lies in a set $Z \subseteq \mathbb R^N$. For each scenario $j$ the objective contribution is $h_j : \mathbb R^N \to \mathbb R$ and the outcome functions are $g_{ij} : \mathbb R^N \to \mathbb R$. The reference outcomes are the realizations $y_{ij}$ of $Y_i$, and the split variables are $X = (x_{ij}) \in \mathbb R^{mn}$. Write $(t)_+ = \max(t,0)$.
--
--   1. **Problem (38)–(41).** Maximize the objective $\sum_{j=1}^n p_j h_j(z)$ subject to
--   $$\sum_{j=1}^n p_j (y_{ik} - x_{ij})_+ \le \sum_{j=1}^n p_j (y_{ik} - y_{ij})_+ \quad (i \in I,\ k \in J), \qquad x_{ik} \le g_{ik}(z) \quad (i \in I,\ k \in J), \qquad z \in Z.$$
--   The first family is the dominance constraints (39), the second the splitting constraints (40). A pair $(z, X)$ is **feasible** if it satisfies all three. It is an **optimal solution** if it is feasible and its objective value is at least that of every feasible pair.
--   2. **Slater condition** (p. 16). There exist $\tilde z \in \operatorname{relint} Z$ and $\tilde X$ with $\tilde x_{ik} < g_{ik}(\tilde z)$ for all $i, k$, and with the dominance constraints (39) satisfied (non-strictly).
--   3. **The utility set $V_i$** (p. 16), for the realizations $y_{i1},\dots,y_{in}$: a function $u : \mathbb R \to \mathbb R$ belongs to $V_i$ if it is concave and nondecreasing, piecewise linear with break points only at the $y_{ik}$ (it is affine on every interval $[s,t]$ whose interior contains no $y_{ik}$), and $u(t) = 0$ for all $t \ge y_{i,[n]} = \max_k y_{ik}$.
--   4. **The Lagrangian (42).** For $u = (u_1,\dots,u_m)$ and $\theta \in \mathbb R^{mn}$,
--   $$L(z,X,u,\theta) = \sum_{j=1}^n p_j\Big[h_j(z) + \sum_{i=1}^m \theta_{ij} g_{ij}(z)\Big] + \sum_{i=1}^m \sum_{j=1}^n p_j\big[u_i(x_{ij}) - u_i(y_{ij}) - \theta_{ij} x_{ij}\big].$$
--   5. **The standard Lagrangian** (p. 17), with multipliers $\mu_{ik}$ for (39):
--   $$\Lambda(z,X,\mu,\theta) = \sum_{j=1}^n p_j\Big[h_j(z) + \sum_{i=1}^m \theta_{ij}\big(g_{ij}(z) - x_{ij}\big)\Big] + \sum_{i=1}^m \sum_{k=1}^n \mu_{ik}\Big[\sum_{j=1}^n p_j (y_{ik} - y_{ij})_+ - \sum_{j=1}^n p_j (y_{ik} - x_{ij})_+\Big].$$
--   6. **The utility generated by multipliers (46):** $u_i(t) = -\sum_{k=1}^n \mu_{ik} (y_{ik} - t)_+$.
--   7. **The dual functional (47):** $D(u,\theta) = \sup_{z \in Z,\ X \in \mathbb R^{mn}} L(z, X, u, \theta)$, an extended real number.
--
--   These objects carry the optimality and duality theory of the finite-scenario dominance-constrained problem: Theorem 6 replaces the measure-valued multiplier of the general theory by a piecewise-linear utility in $V_i$.
--
--   **Formalization Note.** $\mathbb R^N$ is `Fin N → ℝ` and $X$, $\theta$, $\mu$ are `Fin m → Fin n → ℝ`. The relative interior is Mathlib's `intrinsicInterior ℝ Z`. The page defines $V_i \subset \mathcal U_1([a_i,b_i])$ and asks $u(y_{i,[n]}) = 0$; since $\mathcal U_1$ forces $u = 0$ on $[b_i,\infty)$ with $b_i \ge y_{i,[n]}$ and $u$ is affine to the right of $y_{i,[n]}$, this is the same as $u = 0$ on $[y_{i,[n]},\infty)$, which is what is encoded. No positive left slope is required (the printed $c > 0$ of $\mathcal U_1$ is a misprint for $c \ge 0$; $u \equiv 0$ must belong to $V_i$). With these clauses every function in $V_i$ lies in $\mathcal U_1([a,b])$ (with $c \ge 0$) for every interval $[a,b]$ containing all $y_{ik}$. The dual functional is an `EReal` supremum; it equals $-\infty$ only when $Z = \emptyset$.
-- source:
--   Dentcheva, Ruszczyński, Optimality and duality theory for stochastic optimization problems with nonlinear dominance constraints, author manuscript (rev. April 2003; Math. Program. 2004, DOI 10.1007/s10107-003-0453-z), pp. 2, 7 and 15–18, Eqs. (38)–(42), (46), (47), Slater condition and the sets V_i (p. 16), standard Lagrangian (p. 17, proof of Theorem 6)

import Mathlib

namespace NonlinSSD.Discrete

open Finset

/-! Section 5 of Dentcheva–Ruszczyński (finite scenarios). Scenarios `j : Fin n` carry
probabilities `p j`; dominance groups are `i : Fin m`; the decision `z` lives in `ℝᴺ`
(`Fin N → ℝ`), and `X i j = x_ij`. Positive parts `(t)₊` are written `max t 0`. -/

variable {m n N : ℕ}

/-- The objective (38): `∑_j p_j h_j(z)`. -/
def objective (p : Fin n → ℝ) (h : Fin n → (Fin N → ℝ) → ℝ) (z : Fin N → ℝ) : ℝ :=
  ∑ j, p j * h j z

/-- The dominance constraints (39): for all `i ∈ I`, `k ∈ J`,
`∑_j p_j (y_ik − x_ij)₊ ≤ ∑_j p_j (y_ik − y_ij)₊`. -/
def DominanceConstraints (p : Fin n → ℝ) (y X : Fin m → Fin n → ℝ) : Prop :=
  ∀ i k, ∑ j, p j * max (y i k - X i j) 0 ≤ ∑ j, p j * max (y i k - y i j) 0

/-- Feasibility for problem (38)–(41): the dominance constraints (39), the splitting
constraints (40) `x_ik ≤ g_ik(z)`, and (41) `z ∈ Z`. -/
def Feasible (p : Fin n → ℝ) (Z : Set (Fin N → ℝ)) (g : Fin m → Fin n → (Fin N → ℝ) → ℝ)
    (y : Fin m → Fin n → ℝ) (z : Fin N → ℝ) (X : Fin m → Fin n → ℝ) : Prop :=
  DominanceConstraints p y X ∧ (∀ i k, X i k ≤ g i k z) ∧ z ∈ Z

/-- `(z, X)` is an optimal solution of (38)–(41): feasible, and its objective value is at
least that of every feasible point. -/
def IsOptimal (p : Fin n → ℝ) (Z : Set (Fin N → ℝ)) (h : Fin n → (Fin N → ℝ) → ℝ)
    (g : Fin m → Fin n → (Fin N → ℝ) → ℝ) (y : Fin m → Fin n → ℝ)
    (z : Fin N → ℝ) (X : Fin m → Fin n → ℝ) : Prop :=
  Feasible p Z g y z X ∧
    ∀ z' X', Feasible p Z g y z' X' → objective p h z' ≤ objective p h z

/-- The Slater condition of p. 16: some `z̃ ∈ relint Z` and `X̃` with `x̃_ik < g_ik(z̃)` for all
`i, k`, and the dominance constraints (39) satisfied (non-strictly). -/
def SlaterCondition (p : Fin n → ℝ) (Z : Set (Fin N → ℝ))
    (g : Fin m → Fin n → (Fin N → ℝ) → ℝ) (y : Fin m → Fin n → ℝ) : Prop :=
  ∃ zt ∈ intrinsicInterior ℝ Z, ∃ Xt : Fin m → Fin n → ℝ,
    (∀ i k, Xt i k < g i k zt) ∧ DominanceConstraints p y Xt

/-- Membership in the utility set `V_i` (p. 16), for the realizations `y = (y_i1, …, y_in)` of
`Y_i`: `u` is concave and nondecreasing on `ℝ`, piecewise linear with break points only at the
`y_ik` (affine on every interval `[s, t]` whose interior contains no `y_ik`), and `u(t) = 0`
for every `t ≥ max_k y_ik`. -/
def InV (y : Fin n → ℝ) (u : ℝ → ℝ) : Prop :=
  ConcaveOn ℝ Set.univ u ∧ Monotone u ∧
    (∀ s t : ℝ, s ≤ t → (∀ k, y k ∉ Set.Ioo s t) →
      ∃ α β : ℝ, ∀ x ∈ Set.Icc s t, u x = α * x + β) ∧
    (∀ t : ℝ, (∀ k, y k ≤ t) → u t = 0)

/-- The Lagrangian (42):
`L(z,X,u,θ) = ∑_j p_j [h_j(z) + ∑_i θ_ij g_ij(z)] + ∑_i ∑_j p_j [u_i(x_ij) − u_i(y_ij) − θ_ij x_ij]`. -/
def lagrangian (p : Fin n → ℝ) (h : Fin n → (Fin N → ℝ) → ℝ)
    (g : Fin m → Fin n → (Fin N → ℝ) → ℝ) (y : Fin m → Fin n → ℝ)
    (z : Fin N → ℝ) (X : Fin m → Fin n → ℝ) (u : Fin m → ℝ → ℝ)
    (θ : Fin m → Fin n → ℝ) : ℝ :=
  (∑ j, p j * (h j z + ∑ i, θ i j * g i j z)) +
    ∑ i, ∑ j, p j * (u i (X i j) - u i (y i j) - θ i j * X i j)

/-- The standard Lagrangian `Λ` (p. 17, proof of Theorem 6), with multipliers `μ_ik` for the
dominance constraints (39):
`Λ(z,X,μ,θ) = ∑_j p_j [h_j(z) + ∑_i θ_ij (g_ij(z) − x_ij)]
  + ∑_i ∑_k μ_ik [∑_j p_j (y_ik − y_ij)₊ − ∑_j p_j (y_ik − x_ij)₊]`. -/
def stdLagrangian (p : Fin n → ℝ) (h : Fin n → (Fin N → ℝ) → ℝ)
    (g : Fin m → Fin n → (Fin N → ℝ) → ℝ) (y : Fin m → Fin n → ℝ)
    (z : Fin N → ℝ) (X : Fin m → Fin n → ℝ) (μ θ : Fin m → Fin n → ℝ) : ℝ :=
  (∑ j, p j * (h j z + ∑ i, θ i j * (g i j z - X i j))) +
    ∑ i, ∑ k, μ i k *
      ((∑ j, p j * max (y i k - y i j) 0) - ∑ j, p j * max (y i k - X i j) 0)

/-- The utility function (46) generated by multipliers `μ_i = (μ_i1, …, μ_in)`:
`u_i(t) = −∑_k μ_ik (y_ik − t)₊`. -/
def multiplierUtility (y μ : Fin n → ℝ) (t : ℝ) : ℝ :=
  -∑ k, μ k * max (y k - t) 0

/-- The dual functional (47), `D(u, θ) = sup_{z ∈ Z, X ∈ ℝ^{mn}} L(z, X, u, θ)`, valued in `EReal`
(it may be `+∞`; it is `⊥` only if `Z = ∅`). -/
noncomputable def dualFunctional (p : Fin n → ℝ) (Z : Set (Fin N → ℝ))
    (h : Fin n → (Fin N → ℝ) → ℝ) (g : Fin m → Fin n → (Fin N → ℝ) → ℝ)
    (y : Fin m → Fin n → ℝ) (u : Fin m → ℝ → ℝ) (θ : Fin m → Fin n → ℝ) : EReal :=
  ⨆ z ∈ Z, ⨆ X : Fin m → Fin n → ℝ, ((lagrangian p h g y z X u θ : ℝ) : EReal)

end NonlinSSD.Discrete


