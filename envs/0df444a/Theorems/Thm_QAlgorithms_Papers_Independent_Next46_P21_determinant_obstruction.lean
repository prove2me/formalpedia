-- title:
--   Discrete determinant obstruction to absolute approximation
-- statement:
--   Fix the one-qubit Clifford+T gate set generated by $H$, $S=\operatorname{diag}(1,i)$, $T=\operatorname{diag}(1,\omega)$ and the scalar phase $\omega I$, where $\omega=e^{i\pi/4}$. For every $U\in U(2)$,
--
--   $$
--   \bigl(\forall\varepsilon>0\ \exists\text{ a finite gate word }c:\|U_c-U\|_{\mathrm{op}}\le\varepsilon\bigr)
--   \quad\Longleftrightarrow\quad
--   \det U\in\{\omega^j:0\le j<8\}.
--   $$
--
--   Here $U_c$ is the exact chronological product of the word's gates, with no ancillas, resource states or measurements. The norm compares absolute phases. This is a topological approximability statement, with no efficiency or termination conclusion.
-- source:
--   Efficient Clifford+T approximation of single-qubit operators, arXiv:1212.6253v2, PDF p. 12, Remark 26: determinant obstruction to absolute approximation

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P21

noncomputable section

namespace QAlgorithms.Papers.Independent.Next46.P21

open Set

open scoped ComplexConjugate

/-- Remark 26, PDF p.12: arbitrary absolute approximation iff the determinant is a discrete phase. -/
theorem determinant_obstruction (U : Matrix.unitaryGroup Bool ℂ) :
    (∀ eps : ℝ, 0 < eps → ∃ c : List Letter,
      QAlgorithms.specNorm (wordMatrix c - (U : Matrix Bool Bool ℂ)) ≤ eps) ↔
    ∃ j : Fin 8, Matrix.det (U : Matrix Bool Bool ℂ) = (QAlgorithms.gateT true true) ^ (j : ℕ) := by sorry

end QAlgorithms.Papers.Independent.Next46.P21

end
