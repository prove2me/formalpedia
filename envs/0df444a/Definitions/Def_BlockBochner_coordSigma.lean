-- title:
--   Coordinate $\sigma$-algebra $\sigma(X_J)$
-- statement:
--   Let $\Omega=\prod_{i\in\iota}X_i$ be a product of measurable spaces and $J\subseteq\iota$ a set of sites. The coordinate $\sigma$-algebra $\sigma(X_J)$ is the $\sigma$-algebra on $\Omega$ generated by the coordinate maps $x\mapsto x_i$, $i\in J$. A function on $\Omega$ is "a function of the spins at $J$" when it is $\sigma(X_J)$-measurable.
--
--   This is the conditioning $\sigma$-algebra of every conditional expectation in the paper, for instance $E_v f=E_\mu[f\mid X_{-v}]$ with $J=V\setminus\{v\}$.
--
--   **Formalization Note** It is the supremum over $i\in J$ of the pull-backs of the spin $\sigma$-algebras; $J=\emptyset$ gives the trivial $\sigma$-algebra. A structural lemma records that it is contained in the product $\sigma$-algebra.
-- source:
--   Leake–Li, Beyond the Bochner Method: Optimal Spectral Gaps for Block Dynamics of Spin Systems like the O(N) Model, arXiv:2611.05228, Sec. 1.6, p.8; Sec. 2.2, p.15

import Mathlib

open MeasureTheory

namespace BlockBochner

/-- **Coordinate σ-algebra `σ(X_J)`.** Leake–Li, *Beyond the Bochner Method: Optimal Spectral Gaps for Block Dynamics of Spin Systems like the O(N) Model*, arXiv:2611.05228, Sec. 1.6, p.8 and Sec. 2.2, p.15: a function
"of the spins at `J`" (e.g. `E_µ[f | X_{−v}]` conditions on the spins of `J = V ∖ {v}`). This is the
σ-algebra on the configuration space `∏_i X_i` generated by the coordinates `x ↦ x_i`, `i ∈ J`.

**Formalization Note** It is the supremum over `i ∈ J` of the pull-backs of the spin σ-algebras along
the coordinate projections; `J = ∅` gives the trivial σ-algebra `⊥`. -/
@[instance_reducible] def coordSigma {ι : Type*} {X : ι → Type*} [∀ i, MeasurableSpace (X i)] (J : Set ι) :
    MeasurableSpace (∀ i, X i) :=
  ⨆ i ∈ J, MeasurableSpace.comap (fun x : ∀ i, X i => x i) inferInstance

/-- The coordinate σ-algebra is a sub-σ-algebra of the product σ-algebra. -/
theorem coordSigma_le {ι : Type*} {X : ι → Type*} [∀ i, MeasurableSpace (X i)] (J : Set ι) :
    coordSigma (X := X) J ≤ MeasurableSpace.pi :=
  iSup₂_le fun i _ => (measurable_pi_apply i).comap_le

end BlockBochner


