/-! # Einstein–Maxwell certificate for the 5D EF static family (ATLAS-VI-01)

Unconditional replacement of the CONDITIONAL statements in `Certificate.lean`: every field of
`EMCertificateD` is discharged from proved lemmas (`einsteinMaxwellD_eq_factor`,
`maxwellDiv_ef5`, `faradayCyclic_faraday5`, plus the structural lemmas of `Defs.lean` /
`Frame.lean`). Total dimension `5 = 4 + 1`, domain `domU5 = {0 < r, 0 < u < 1}`, all
`mu beta Q : ℝ` (no sign or horizon restriction).

* `cert_iff`: `EMCertificateD (gEF5 mu beta) (giEF5 mu beta) (faraday5 Q) domU5 ↔ 3β = Q²`.
* `vacuum_cert` (`β = 0`, `Q = 0`) and `vacuum_cert_iff` (`Q = 0`: certificate ↔ `β = 0`).
* `counterexample`: at `(μ, β, Q) = (1, 1, 1)`, `E_{22} = 1/8` at `r = 2`, `u = 1/2`,
  so no certificate exists. -/

open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.EF5

namespace ExactVacuumAtlas.EinsteinMaxwell.EF5

/-- `B_{22} = 1/(4 r⁴ u (1-u)) ≠ 0` on `domU5`. -/
theorem emFactorEF5_22_ne_zero (mu beta : ℝ) {x : Pt 5} (hx : x ∈ domU5) :
    emFactorEF5 mu beta x 2 2 ≠ 0 := by
  have hr := domU5_r hx; have hu := domU5_u hx; have h1u := domU5_1mu hx
  show 1 / (4 * x 1 ^ 4 * x 2 * (1 - x 2)) ≠ 0
  exact one_div_ne_zero (by positivity)

/-- Pointwise: all 25 residuals vanish at `x ∈ domU5` iff `3β = Q²`. -/
theorem einstein_zero_at_iff (mu beta Q : ℝ) {x : Pt 5} (hx : x ∈ domU5) :
    (∀ a b, einsteinMaxwellD (gEF5 mu beta) (giEF5 mu beta) (faraday5 Q) a b x = 0) ↔
      3 * beta = Q ^ 2 := by
  constructor
  · intro h
    have h22 := h 2 2
    rw [einsteinMaxwellD_eq_factor mu beta Q hx] at h22
    have := (mul_eq_zero.mp h22).resolve_right (emFactorEF5_22_ne_zero mu beta hx)
    linarith
  · intro hQ a b
    rw [einsteinMaxwellD_eq_factor mu beta Q hx, hQ, sub_self, zero_mul]

