namespace NLogN.KFB

open IntMul RS AModel KIL KFD

theorem getD_pairOut (M : M2G) (B1 : ℕ) (zs : List GI) (h : 2 * B1 ≤ zs.length) (j : ℕ)
    (hj : j < 2 * B1) :
    (pairOut M (zs.take B1) ((zs.drop B1).take B1)).getD j 0 =
      if j < B1 then lin2 M.a M.b (zs.getD j 0) (zs.getD (j + B1) 0)
      else lin2 M.c M.d (zs.getD (j - B1) 0) (zs.getD j 0) := by
  simp only [List.getD_eq_getElem?_getD, pairOut]
  have l1 : (List.zipWith (lin2 M.a M.b) (zs.take B1) ((zs.drop B1).take B1)).length = B1 := by
    simp; omega
  split_ifs with h1
  · rw [List.getElem?_append_left (by omega), List.getElem?_zipWith, List.getElem?_take,
      List.getElem?_take, List.getElem?_drop, if_pos h1, if_pos h1]
    rw [List.getElem?_eq_getElem (by omega), List.getElem?_eq_getElem (by omega)]
    rw [show j + B1 = B1 + j by ring, List.getElem?_eq_getElem (show B1 + j < zs.length by omega)]
    simp
  · rw [List.getElem?_append_right (by rw [l1]; omega), l1, List.getElem?_zipWith, List.getElem?_take,
      List.getElem?_take, List.getElem?_drop, if_pos (by omega), if_pos (by omega)]
    rw [List.getElem?_eq_getElem (by omega), List.getElem?_eq_getElem (by omega)]
    simp only [Option.map_some, Option.bind_some, Option.getD_some]
    rw [List.getElem?_eq_getElem (show j < zs.length by omega)]; simp only [Option.getD_some]
    congr 2; omega

theorem getD_qopL1 (M : M2G) (B1 : ℕ) (zs : List GI) : ∀ (G : ℕ), G * (2 * B1) ≤ zs.length →
    ∀ j, j < G * (2 * B1) →
    (qopL [M] B1 G zs).getD j 0 =
      if j % (2 * B1) < B1 then lin2 M.a M.b (zs.getD j 0) (zs.getD (j + B1) 0)
      else lin2 M.c M.d (zs.getD (j - B1) 0) (zs.getD j 0)
  | 0, _, j, hj => by simp at hj
  | G + 1, hG, j, hj => by
    have hB : 0 < B1 := by
      rcases Nat.eq_zero_or_pos B1 with h | h
      · subst h; simp at hj
      · exact h
    have hl := length_qopL [M] B1 G zs (by simpa using le_trans (by nlinarith) hG)
    simp only [List.length_singleton, mul_one] at hl
    rw [qopL_succ]
    by_cases hj' : j < G * (2 * B1)
    · rw [List.getD_append _ _ _ _ (by simpa [hl] using hj')]
      exact getD_qopL1 M B1 zs G (le_trans (by nlinarith) hG) j hj'
    · rw [List.getD_append_right _ _ _ _ (by simp [hl]; omega)]
      simp only [List.length_singleton, mul_one, hl, grpOut, List.append_nil]
      have hjj : j - G * (2 * B1) < 2 * B1 := by rw [Nat.succ_mul] at hj; omega
      rw [getD_pairOut M B1 _ (by simp; rw [Nat.succ_mul] at hG; omega) _ hjj]
      have hmod : j % (2 * B1) = j - G * (2 * B1) := by
        have : j = (j - G * (2 * B1)) + G * (2 * B1) := by omega
        rw [this, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hjj]; omega
      rw [hmod]
      simp only [List.getD_eq_getElem?_getD, List.getElem?_drop]
      split_ifs with h1
      · congr 2 <;> congr 1 <;> omega
      · congr 2 <;> congr 1 <;> omega

end NLogN.KFB

