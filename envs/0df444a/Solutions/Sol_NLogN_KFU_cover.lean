namespace NLogN.KFU

open IntMul KFC AModel AModelL12

section Cover

variable {d : ℕ} {sF μ : ℕ → ℕ}

theorem CrtOK.coprime (H : CrtOK d sF μ) {j : ℕ} (hj : j < d) : Nat.Coprime (μ j) (sF j) := by
  have h := H.inv j hj
  push_cast at h
  exact (ZMod.isUnit_iff_coprime _ _).1 (IsUnit.of_mul_eq_one _ h)

theorem Ppre_eq_prod (d : ℕ) (sF : ℕ → ℕ) :
    ∏ i : Fin d, sF i = OpenAI.RCRT.Ppre sF d := by
  rw [Fin.prod_univ_eq_prod_range (fun j => sF j) d]; rfl

/-- The residue map is onto the source box. -/
theorem cover_take (H : CrtOK d sF μ) (b : List ℕ) (hb : ∀ j < d, b.getD j 0 < sF j)
    (hl : d ≤ b.length) :
    ∃ k < OpenAI.RCRT.Ppre sF d, (List.range d).map (fun j => μ j * k % sF j) = b.take d := by
  classical
  let s' : Fin d → ℕ := fun i => sF i
  have : ∀ i, NeZero (s' i) := fun i => ⟨by have := H.pos i i.2; simp only [s']; omega⟩
  have hcop : Pairwise (Function.onFun Nat.Coprime s') := fun i j hij =>
    H.cop i j i.2 j.2 (fun e => hij (Fin.ext e))
  let μ' : Fin d → ℕ := fun i => μ i
  have hμ' : ∀ i, Nat.Coprime (μ' i) (s' i) := fun i => H.coprime i.2
  have hP : ∏ i, s' i = OpenAI.RCRT.Ppre sF d := Ppre_eq_prod d sF
  have : NeZero (∏ i, s' i) := ⟨by
    rw [Finset.prod_ne_zero_iff]; intro i _; exact NeZero.ne _⟩
  let t : (i : Fin d) → ZMod (s' i) := fun i => (b.getD i 0 : ZMod (s' i))
  let x := (OpenAI.RCRT.PhiEquiv s' hcop μ' hμ').symm t
  have hx : OpenAI.RCRT.Phi s' μ' x = t := by
    rw [← OpenAI.RCRT.PhiEquiv_apply s' hcop μ' hμ']; simp [x]
  refine ⟨x.val, hP ▸ ZMod.val_lt x, ?_⟩
  apply List.ext_getElem (by simp; omega)
  intro j h1 h2
  simp only [List.length_map, List.length_range] at h1
  have hj := congrFun hx ⟨j, h1⟩
  simp only [OpenAI.RCRT.Phi, ZMod.castHom_apply, ZMod.cast_eq_val, t, s', μ'] at hj
  have hj' : ((μ j * x.val : ℕ) : ZMod (sF j)) = ((b.getD j 0 : ℕ) : ZMod (sF j)) := by
    push_cast; exact hj
  rw [ZMod.natCast_eq_natCast_iff', Nat.mod_eq_of_lt (hb j h1)] at hj'
  simp only [List.getElem_map, List.getElem_range, List.getElem_take]
  rw [hj', List.getD_eq_getElem _ _ (by omega)]

end Cover

