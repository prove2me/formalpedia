def augSet (P : ValuationSubring (AlgebraicClosure ℚ)) : Set (TateModule p (JOne M)) :=
  {z : TateModule p (JOne M) |
    ∃ τ ∈ P.inertiaSubgroupIn ℚ, ∃ y : TateModule p (JOne M),
      (∀ (n : ℕ), ∀ d ∈ normFreeRepsAt M p,
          diamondOneBar M d ((y : ℕ → JOne M) n) = (y : ℕ → JOne M) n) ∧
        z = TateModule.rep p (JOne M) Gal τ y - y}

def oldSet : Set (TateModule p (JOne M)) :=
  {z : TateModule p (JOne M) |
    ∃ (i : Fin 2) (w : TateModule p (JOne (M / p))), ∀ n : ℕ,
      (z : ℕ → JOne M) n = JOne.degeneracyPullbackPair (M / p) M p i ((w : ℕ → JOne (M / p)) n)}

