theorem solution (R : Type) [CommRing R] (t x : R) (hreg : TypeDensity.RegularParameterPair R t x)
    (hregSwap : TypeDensity.RegularParameterPair R x t) (beta : TypeDensity.BlowupRestriction R t x) (j : ℕ)
    (h : TypeDensity.cechInputLattice R t x j ≤ (TypeDensity.cechOutputLattice R t x j).comap
    (TypeDensity.fullCechDifferential R t x beta 0)) :
    LinearMap.range (TypeDensity.surfaceToCechInput R t x j) = LinearMap.ker
      (TypeDensity.finiteCechDifferential R t x beta 0 j h) := by
  have key : ∀ k (w : TypeDensity.CechLevelInput R t x k),
      TypeDensity.finiteCechDifferential R t x beta 0 k
        (TypeDensity.actual_cech_preserves_exceptional_lattices R t x beta 0 k) w = 0 →
      w ∈ LinearMap.range (TypeDensity.surfaceToCechInput R t x k) := by
    intro k
    induction k with
    | zero =>
      intro w _
      refine ⟨0, ?_⟩
      induction w using Submodule.Quotient.induction_on with
      | H z =>
        rw [map_zero, eq_comm, Submodule.Quotient.mk_eq_zero]
        simp only [TypeDensity.cechInputLattice]
        refine ⟨?_, ?_⟩
        · change z.1 ∈ (1 : Ideal (TypeDensity.BlowupChart R t x))
          exact (Ideal.one_eq_top (R := TypeDensity.BlowupChart R _ _)) ▸ Submodule.mem_top
        · change z.2 ∈ (1 : Ideal (TypeDensity.BlowupChart R x t))
          exact (Ideal.one_eq_top (R := TypeDensity.BlowupChart R _ _)) ▸ Submodule.mem_top
    | succ k ih =>
      intro w hw
      have hcomm := TypeDensity.actual_cech_differentials_commute_with_reduction R t x beta 0 k
        (TypeDensity.actual_cech_preserves_exceptional_lattices R t x beta 0 (k+1))
        (TypeDensity.actual_cech_preserves_exceptional_lattices R t x beta 0 k)
      have hw' : TypeDensity.finiteCechDifferential R t x beta 0 k
          (TypeDensity.actual_cech_preserves_exceptional_lattices R t x beta 0 k)
          (TypeDensity.cechInputReduction R t x k w) = 0 := by
        have := congrArg (fun f => f w) hcomm
        simp only [LinearMap.comp_apply] at this
        rw [← this, hw, map_zero]
      obtain ⟨r, hr⟩ := ih _ hw'
      have hred : TypeDensity.cechInputReduction R t x k (TypeDensity.surfaceToCechInput R t x (k+1) r) =
          TypeDensity.surfaceToCechInput R t x k r := rfl
      obtain ⟨r', -, hr'⟩ := TypeDensity.surface_layer_kernel_lift R t x hreg hregSwap beta k
        (TypeDensity.actual_cech_preserves_exceptional_lattices R t x beta 0 (k+1))
        (w - TypeDensity.surfaceToCechInput R t x (k+1) r)
        (by rw [map_sub, hw, TypeDensity.surface_section_closed, sub_zero])
        (by rw [map_sub, hred, hr, sub_self])
      exact ⟨r + r', by rw [map_add, hr', add_sub_cancel]⟩
  ext w
  exact ⟨by rintro ⟨r, rfl⟩; exact TypeDensity.surface_section_closed R t x beta j h r, key j w⟩
