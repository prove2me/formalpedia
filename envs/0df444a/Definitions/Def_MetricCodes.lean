theorem arbitraryRowAxialRaise_fischer_inner_eq_lowerScalar_mul_coordinate
    {r n : ℕ} (lam : Fin (r + 1) → ℕ)
    (row : Fin (r + 1)) (k : Fin n)
    (p q : PolynomialSpace r n)
    (hhighest : ∀ a b : Fin (r + 1), a < b →
      polarization r n a b q = 0) :
