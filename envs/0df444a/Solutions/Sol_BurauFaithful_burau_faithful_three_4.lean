/-
`BurauFaithful.burau_three_spec_kernel_hard`, reduced to the statement about the *reduced* Burau
representation at `t = -1`.

The child `BurauFaithful.spec_reduced_kernel_le` says that the kernel of the `t = -1`
specialization `redHom3` of the reduced 2-dimensional Burau representation is generated by
`Δ⁴ = (σ₀σ₁)⁶`. What is proved here is the passage from the unreduced 3×3 specialization of the
node's statement to `redHom3`: at `t = -1` the unreduced representation is conjugate over `ℤ`
(by the matrix `C = !![1,-1,1; 1,-1,0; 1,0,-1]`, of determinant `1`) to the direct sum of the
trivial representation and the reduced one,

  `C⁻¹ · ρ₃(σᵢ)|_{t=-1} · C = 1 ⊕ redHom3(σᵢ)`   (`i = 0, 1`),

which is the content of the Proved platform theorem `BurauFaithful.burau_three_spec_reduction`
(recomputed here for the two generators, so that this file is self-contained). Hence for every `β`
the 3×3 specialized matrix is `1` only if `redHom3 β = 1`.
-/



set_option autoImplicit false

open Matrix BraidsLinksMCG

namespace BurauLink

abbrev SL2 := Matrix.SpecialLinearGroup (Fin 2) ℤ
abbrev GL3 := Matrix.GeneralLinearGroup (Fin 3) ℤ
abbrev M3 := Matrix (Fin 3) (Fin 3) ℤ

/-- The specialization `ℤ[t,t⁻¹] → ℤ`, `t ↦ -1`. -/
noncomputable def specM1 : (LaurentPolynomial ℤ) →+* ℤ :=
  LaurentPolynomial.eval₂ (Int.castRingHom ℤ) (-1 : ℤˣ)

/-- The `t = -1` specialization of the unreduced Burau representation, as a homomorphism into
`GL₃(ℤ)`. -/
noncomputable def specRep : PresentedGroup (braidRels 3) →* GL3 :=
  (Matrix.GeneralLinearGroup.map specM1).comp (BurauFaithful.burauRep 3)

/-- The conjugating matrix of `BurauFaithful.burau_three_spec_reduction`. -/
def C3 : M3 := !![1, -1, 1; 1, -1, 0; 1, 0, -1]

/-- Its inverse over `ℤ` (the determinant is `1` at `t = -1`). -/
def C3inv : M3 := !![1, -1, 1; 1, -2, 1; 1, -1, 0]

lemma C3_mul_C3inv : C3 * C3inv = 1 := by decide

lemma C3inv_mul_C3 : C3inv * C3 = 1 := by decide

/-- `C3` as an element of `GL₃(ℤ)`. -/
def P3 : GL3 := ⟨C3, C3inv, C3_mul_C3inv, C3inv_mul_C3⟩

/-- The conjugate of the specialized unreduced representation by `C3`. -/
noncomputable def Conj : PresentedGroup (braidRels 3) →* GL3 where
  toFun β := P3⁻¹ * specRep β * P3
  map_one' := by simp
  map_mul' := by
    intro x y
    simp only [map_mul]
    group

/-- The block-diagonal embedding `SL(2,ℤ) → M₃(ℤ)`, `M ↦ diag(1, M)`. -/
def blk (M : SL2) : M3 :=
  !![1, 0, 0; 0, M 0 0, M 0 1; 0, M 1 0, M 1 1]

lemma blk_one : blk 1 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [blk]

lemma blk_mul (M N : SL2) : blk (M * N) = blk M * blk N := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [blk, Matrix.mul_apply, Fin.sum_univ_three, Fin.sum_univ_two]

/-- The block-diagonal embedding composed with the reduced specialization. -/
def blkUnit (M : SL2) : GL3 :=
  ⟨blk M, blk M⁻¹, by rw [← blk_mul, mul_inv_cancel, blk_one],
    by rw [← blk_mul, inv_mul_cancel, blk_one]⟩

/-- The block-diagonal embedding as a monoid homomorphism into `GL₃(ℤ)`. -/
def blkHom : SL2 →* GL3 where
  toFun := blkUnit
  map_one' := by
    apply Units.ext
    simp [blkUnit, blk_one]
  map_mul' := by
    intro M N
    apply Units.ext
    simp [blkUnit, blk_mul]

/-- The block-diagonal embedding composed with the reduced specialization. -/
noncomputable def blkRep : PresentedGroup (braidRels 3) →* GL3 :=
  blkHom.comp BurauFaithful.redHom3

lemma blkRep_entry (β : PresentedGroup (braidRels 3)) :
    (↑(blkRep β) : M3) = blk (BurauFaithful.redHom3 β) := rfl

/-- The specialization of the unreduced Burau matrices of the generators, in the shape used by
`BurauFaithful.burau_three_spec_reduction`. -/
lemma specRep_of_eq_map (i : Fin (3 - 1)) :
    (specRep (PresentedGroup.of i) : M3) = Matrix.map (BurauFaithful.burauMatrix i) specM1 := by
  show (Matrix.GeneralLinearGroup.map specM1
      (BurauFaithful.burauRep 3 (PresentedGroup.of i)) : M3) = _
  have hg : (BurauFaithful.burauRep 3 (PresentedGroup.of i)).1 = BurauFaithful.burauMatrix i :=
    congrArg Units.val (PresentedGroup.toGroup.of (h := BurauFaithful.burauGen_relations 3) (x := i))
  ext a b
  rw [Matrix.GeneralLinearGroup.map_apply, hg]
  rfl

lemma specRep_zero :
    (specRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) : M3) = !![2, -1, 0; 1, 0, 0; 0, 0, 1] := by
  have h := specRep_of_eq_map (⟨0, by decide⟩ : Fin 2)
  have hmat : (Matrix.map (BurauFaithful.burauMatrix (0 : Fin 2)) specM1 : M3) =
      !![2, -1, 0; 1, 0, 0; 0, 0, 1] := by
    ext a b
    fin_cases a <;> fin_cases b <;>
      simp [BurauFaithful.burauMatrix_apply, specM1, LaurentPolynomial.eval₂_T, Matrix.map_apply] <;>
      norm_num
  exact h.trans hmat

lemma specRep_one :
    (specRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) : M3) = !![1, 0, 0; 0, 2, -1; 0, 1, 0] := by
  have h := specRep_of_eq_map (⟨1, by decide⟩ : Fin 2)
  have hmat : (Matrix.map (BurauFaithful.burauMatrix (1 : Fin 2)) specM1 : M3) =
      !![1, 0, 0; 0, 2, -1; 0, 1, 0] := by
    ext a b
    fin_cases a <;> fin_cases b <;>
      simp [BurauFaithful.burauMatrix_apply, specM1, LaurentPolynomial.eval₂_T, Matrix.map_apply] <;>
      norm_num
  exact h.trans hmat

/-- The value of `blkRep` on the two generators. -/
lemma blkRep_of_zero :
    (↑(blkRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2))) : M3) =
      !![1, 0, 0; 0, 1, -1; 0, 0, 1] := by
  show blk (BurauFaithful.redHom3 (PresentedGroup.of (⟨0, by decide⟩ : Fin 2))) = _
  rw [show BurauFaithful.redHom3 (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) =
      BurauFaithful.redGen ⟨0, by decide⟩ from
    PresentedGroup.toGroup.of (h := BurauFaithful.redGen_braid)]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [blk, BurauFaithful.redGen]

lemma blkRep_of_one :
    (↑(blkRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2))) : M3) =
      !![1, 0, 0; 0, 2, -1; 0, 1, 0] := by
  show blk (BurauFaithful.redHom3 (PresentedGroup.of (⟨1, by decide⟩ : Fin 2))) = _
  rw [show BurauFaithful.redHom3 (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) =
      BurauFaithful.redGen ⟨1, by decide⟩ from
    PresentedGroup.toGroup.of (h := BurauFaithful.redGen_braid)]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [blk, BurauFaithful.redGen]

/-- The two homomorphisms agree on the first generator: `C⁻¹ · ρ₃(σ₀)|_{t=-1} · C = 1 ⊕ A`.
This is the first half of `BurauFaithful.burau_three_spec_reduction`, checked by computation. -/
lemma conj_of_zero :
    Conj (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) =
      blkRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) := by
  apply Units.ext
  show (↑(P3⁻¹ * specRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) * P3) : M3) =
    ↑(blkRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)))
  rw [blkRep_of_zero]
  simp only [Units.val_mul, P3, Units.val_mk, Inv.inv, C3inv, C3]
  rw [show (specRep (PresentedGroup.of (⟨0, by decide⟩ : Fin 2)) : M3) =
      !![2, -1, 0; 1, 0, 0; 0, 0, 1] from specRep_zero]
  decide

/-- The two homomorphisms agree on the second generator: `C⁻¹ · ρ₃(σ₁)|_{t=-1} · C = 1 ⊕ B`. -/
lemma conj_of_one :
    Conj (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) =
      blkRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) := by
  apply Units.ext
  show (↑(P3⁻¹ * specRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) * P3) : M3) =
    ↑(blkRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)))
  rw [blkRep_of_one]
  simp only [Units.val_mul, P3, Units.val_mk, Inv.inv, C3inv, C3]
  rw [show (specRep (PresentedGroup.of (⟨1, by decide⟩ : Fin 2)) : M3) =
      !![1, 0, 0; 0, 2, -1; 0, 1, 0] from specRep_one]
  decide

lemma Conj_eq_blkRep : Conj = blkRep := by
  refine PresentedGroup.ext (φ := Conj) (ψ := blkRep) ?_
  intro i
  fin_cases i
  · exact conj_of_zero
  · exact conj_of_one

/-- The link: the `t = -1` specialization of the unreduced representation dies only if the
specialization of the reduced representation dies. -/
theorem link (β : BraidsLinksMCG.ArtinBraidGroup 3)
    (h : Matrix.GeneralLinearGroup.map (LaurentPolynomial.eval₂ (Int.castRingHom ℤ) (-1 : ℤˣ))
        (BurauFaithful.burauRep 3 β) = 1) :
    BurauFaithful.redHom3 β = 1 := by
  have hspec : specRep β = 1 := h
  have hConj : Conj β = 1 := by
    show P3⁻¹ * specRep β * P3 = 1
    rw [show specRep β = 1 from hspec]
    simp
  have hblkRep : blkRep β = 1 := by
    rw [← Conj_eq_blkRep]
    exact hConj
  have hmat : blk (BurauFaithful.redHom3 β) = 1 := by
    rw [← blkRep_entry β, hblkRep]
    simp
  have e00 : (BurauFaithful.redHom3 β : Matrix (Fin 2) (Fin 2) ℤ) 0 0 = 1 := by
    have := congrArg (fun X : M3 => X 1 1) hmat
    simpa [blk] using this
  have e01 : (BurauFaithful.redHom3 β : Matrix (Fin 2) (Fin 2) ℤ) 0 1 = 0 := by
    have := congrArg (fun X : M3 => X 1 2) hmat
    simpa [blk] using this
  have e10 : (BurauFaithful.redHom3 β : Matrix (Fin 2) (Fin 2) ℤ) 1 0 = 0 := by
    have := congrArg (fun X : M3 => X 2 1) hmat
    simpa [blk] using this
  have e11 : (BurauFaithful.redHom3 β : Matrix (Fin 2) (Fin 2) ℤ) 1 1 = 1 := by
    have := congrArg (fun X : M3 => X 2 2) hmat
    simpa [blk] using this
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [e00, e01, e10, e11]

end BurauLink

/-
`spec_reduced_kernel_normalClosure` via `Q = B₃/⟨⟨Δ⁴⟩⟩ ≅ H = ⟨S,R | S⁴, R³ = S²⟩`.

Plan (see NOTES_BURAU.md, rounds 55–58):
  * `Q = B₃ ⧸ ⟨⟨(σ₀σ₁)⁶⟩⟩`, `q : B₃ →* Q`;
  * `γ : Q →* H` with `q σ₀ ↦ R⁻¹ S`, `q σ₁ ↦ S R⁻¹`;
  * `H →* Q` with `S ↦ q Δ`, `R ↦ q (σ₀σ₁)`, using the Garside identity `Δ² = (σ₀σ₁)³`;
  * the two round trips are checked on generators, giving `Q ≅ H`;
  * then `redHom3` corresponds to the surjection `H → SL(2,ℤ)`, `S ↦ ABA`, `R ↦ AB`, and the node
    becomes injectivity of that explicit map.

This file is concatenated with the `Sol_sl2_*` development for compilation.
-/



set_option autoImplicit false

open BraidsLinksMCG

namespace BurauKerFinal

/-- Relators of the presentation `H = ⟨S,R | S⁴ = 1, R³ S² = 1⟩`. -/
def relsSR : Set (FreeGroup (Fin 2)) :=
  {FreeGroup.of 0 ^ 4, FreeGroup.of 1 ^ 3 * FreeGroup.of 0 ^ 2}

/-- The group `H = ⟨S,R | S⁴, R³ S²⟩`. -/
abbrev H : Type := PresentedGroup relsSR

instance : Group H := inferInstanceAs (Group (PresentedGroup relsSR))

/-- The generator `S`. -/
noncomputable def S : H := PresentedGroup.of (rels := relsSR) (0 : Fin 2)

/-- The generator `R`. -/
noncomputable def R : H := PresentedGroup.of (rels := relsSR) (1 : Fin 2)

/-- `S⁴ = 1` in `H`. -/
theorem S_pow_four : S ^ 4 = 1 := by
  have hmem : FreeGroup.of (0 : Fin 2) ^ 4 ∈ Subgroup.normalClosure relsSR :=
    Subgroup.subset_normalClosure (by rw [relsSR]; exact Or.inl rfl)
  have h : PresentedGroup.mk relsSR (FreeGroup.of (0 : Fin 2) ^ 4) = 1 :=
    PresentedGroup.mk_eq_one_iff.mpr hmem
  simpa only [S, PresentedGroup.of, map_pow] using h

/-- `R³ S² = 1` in `H`. -/
theorem R_cube_mul_S_sq : R ^ 3 * S ^ 2 = 1 := by
  have hmem : FreeGroup.of (1 : Fin 2) ^ 3 * FreeGroup.of 0 ^ 2 ∈
      Subgroup.normalClosure relsSR :=
    Subgroup.subset_normalClosure (by rw [relsSR]; exact Or.inr rfl)
  have h : PresentedGroup.mk relsSR (FreeGroup.of (1 : Fin 2) ^ 3 * FreeGroup.of 0 ^ 2) = 1 :=
    PresentedGroup.mk_eq_one_iff.mpr hmem
  simpa only [R, S, PresentedGroup.of, map_mul, map_pow] using h

/-- `S² = R³` in `H`. -/
theorem S_sq_eq_R_cube : S ^ 2 = R ^ 3 := by
  have h := R_cube_mul_S_sq
  have hinv : (S ^ 2)⁻¹ = S ^ 2 := by
    have h22 : (S ^ 2) ^ 2 = 1 := by
      rw [← pow_mul, show (2 : ℕ) * 2 = 4 from rfl, S_pow_four]
    exact inv_eq_of_mul_eq_one_left h22
  have hR : R ^ 3 = (S ^ 2)⁻¹ := by
    rw [← mul_inv_eq_one]
    exact h
  rw [hR, hinv]

/-- The braid relation in `H` for the images `R⁻¹S` and `SR⁻¹` of `σ₀`, `σ₁`. -/
theorem braid_in_H :
    (R⁻¹ * S) * (S * R⁻¹) * (R⁻¹ * S) = (S * R⁻¹) * (R⁻¹ * S) * (S * R⁻¹) := by
  have hS2 : S ^ 2 = R ^ 3 := S_sq_eq_R_cube
  have hSS : S * S = R ^ 3 := by rw [← pow_two S, hS2]
  have e1 : (R⁻¹ * S) * (S * R⁻¹) * (R⁻¹ * S) = S := by
    have key : (R⁻¹ * S) * (S * R⁻¹) * (R⁻¹ * S) = R⁻¹ * (S * S) * (R⁻¹ * R⁻¹) * S := by
      group
    rw [key, hSS]
    group
  have e2 : (S * R⁻¹) * (R⁻¹ * S) * (S * R⁻¹) = S := by
    have key : (S * R⁻¹) * (R⁻¹ * S) * (S * R⁻¹) = S * (R⁻¹ * R⁻¹) * (S * S) * R⁻¹ := by
      group
    rw [key, hSS]
    group
  rw [e1, e2]

/-- The braid relation as an equation in `PresentedGroup (braidRels 3)`. -/
theorem braid_relation_of :
    PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 =
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 := by
  have hmem : FreeGroup.of (0 : Fin 2) * FreeGroup.of 1 * FreeGroup.of 0 *
      (FreeGroup.of 1 * FreeGroup.of 0 * FreeGroup.of 1)⁻¹ ∈
      Subgroup.normalClosure (BraidsLinksMCG.braidRels 3) :=
    Subgroup.subset_normalClosure (by
      rw [BraidsLinksMCG.braidRels]
      exact Or.inr ⟨0, 1, by decide, rfl⟩)
  have h1 : PresentedGroup.mk (BraidsLinksMCG.braidRels 3)
      (FreeGroup.of (0 : Fin 2) * FreeGroup.of 1 * FreeGroup.of 0 *
        (FreeGroup.of 1 * FreeGroup.of 0 * FreeGroup.of 1)⁻¹) = 1 :=
    PresentedGroup.mk_eq_one_iff.mpr hmem
  have h2 : PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
      (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1)⁻¹ = 1 := by
    have hmid : PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
        (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
          PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
          PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1)⁻¹ =
        PresentedGroup.mk (BraidsLinksMCG.braidRels 3)
          (FreeGroup.of (0 : Fin 2) * FreeGroup.of 1 * FreeGroup.of 0 *
            (FreeGroup.of 1 * FreeGroup.of 0 * FreeGroup.of 1)⁻¹) := by
      simp only [PresentedGroup.of, map_mul, map_inv]
    exact hmid.trans h1
  exact mul_inv_eq_one.mp h2

/-- **The Garside identity**: `Δ² = (σ₀σ₁)³`, entirely inside `PresentedGroup (braidRels 3)`. -/
theorem garside_identity_of :
    (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0) ^ 2 =
      (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1) ^ 3 := by
  set D : PresentedGroup (BraidsLinksMCG.braidRels 3) :=
    PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 with hDdef
  have h := braid_relation_of
  rw [hDdef, pow_two, pow_three]
  nth_rewrite 2 [h]
  simp only [mul_assoc]

/-- Images of the two generators in `H`. -/
noncomputable def gen : Fin 2 → H := Fin.cases (R⁻¹ * S) (fun _ => S * R⁻¹)

theorem gen_zero : gen 0 = R⁻¹ * S := rfl

theorem gen_one : gen 1 = S * R⁻¹ := rfl

/-- The braid relators hold for `gen`. -/
theorem gen_braid : ∀ r ∈ BraidsLinksMCG.braidRels 3, FreeGroup.lift gen r = 1 := by
  intro r hr
  simp only [BraidsLinksMCG.braidRels, Set.mem_union] at hr
  rcases hr with ⟨i, j, h, rfl⟩ | ⟨i, j, h, rfl⟩
  · exfalso
    fin_cases i <;> fin_cases j <;> norm_num at h
  · simp only [map_mul, map_inv, FreeGroup.lift_apply_of]
    rw [mul_inv_eq_one]
    fin_cases i <;> fin_cases j
    · exfalso; norm_num at h
    · show gen ⟨0, by decide⟩ * gen ⟨1, by decide⟩ * gen ⟨0, by decide⟩ =
          gen ⟨1, by decide⟩ * gen ⟨0, by decide⟩ * gen ⟨1, by decide⟩
      exact braid_in_H
    · exfalso; norm_num at h
    · exfalso; norm_num at h

/-- The homomorphism sending the two braid generators to `R⁻¹S` and `SR⁻¹`. -/
noncomputable def toH : PresentedGroup (BraidsLinksMCG.braidRels 3) →* H :=
  PresentedGroup.toGroup gen_braid

/-- `toH` on the first generator. -/
theorem toH_of_zero :
    toH (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2)) = R⁻¹ * S := by
  rw [toH, PresentedGroup.toGroup.of]
  exact gen_zero

/-- `toH` on the second generator. -/
theorem toH_of_one :
    toH (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2)) = S * R⁻¹ := by
  rw [toH, PresentedGroup.toGroup.of]
  exact gen_one

/-- `R³ = S²` in `H`. -/
theorem toH_R_cube : R ^ 3 = S ^ 2 := by
  have h := R_cube_mul_S_sq
  have hinv : (S ^ 2)⁻¹ = S ^ 2 := by
    have h22 : (S ^ 2) ^ 2 = 1 := by
      rw [← pow_mul, show (2 : ℕ) * 2 = 4 from rfl, S_pow_four]
    exact inv_eq_of_mul_eq_one_left h22
  have hR : R ^ 3 = (S ^ 2)⁻¹ := by
    rw [← mul_inv_eq_one]
    exact h
  rw [hR, hinv]

/-- `toH` sends `σ₀σ₁` to `R`. -/
theorem toH_y :
    toH (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1) = R := by
  rw [map_mul, toH_of_zero, toH_of_one]
  have key : (R⁻¹ * S) * (S * R⁻¹) = R⁻¹ * (S * S) * R⁻¹ := by group
  rw [key, show S * S = R ^ 3 from by rw [← pow_two S, S_sq_eq_R_cube]]
  group

/-- `toH` kills the kernel generator `Δ⁴ = (σ₀σ₁)⁶`. -/
theorem toH_Delta4 :
    toH ((PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1) ^ 6) = 1 := by
  rw [map_pow, toH_y]
  rw [show (6 : ℕ) = 3 * 2 from rfl, pow_mul, toH_R_cube]
  rw [← pow_mul, show (2 : ℕ) * 2 = 4 from rfl, S_pow_four]

/-- The kernel generator `Δ⁴ = (σ₀σ₁)⁶` of `B₃`, inside `PresentedGroup (braidRels 3)`. -/
noncomputable def Delta4 : PresentedGroup (BraidsLinksMCG.braidRels 3) :=
  (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
    PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1) ^ 6

/-- `Q = B₃ / ⟨⟨Δ⁴⟩⟩`. -/
abbrev Q : Type :=
  PresentedGroup (BraidsLinksMCG.braidRels 3) ⧸
    Subgroup.normalClosure ({Delta4} : Set (PresentedGroup (BraidsLinksMCG.braidRels 3)))

/-- The quotient map `B₃ →* Q`. -/
noncomputable def q : PresentedGroup (BraidsLinksMCG.braidRels 3) →* Q :=
  QuotientGroup.mk'
    (Subgroup.normalClosure ({Delta4} : Set (PresentedGroup (BraidsLinksMCG.braidRels 3))))

/-- The descended map `γ : Q →* H`. -/
noncomputable def gamma : Q →* H :=
  QuotientGroup.lift
    (Subgroup.normalClosure ({Delta4} : Set (PresentedGroup (BraidsLinksMCG.braidRels 3))))
    toH (Subgroup.normalClosure_le_normal (by
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact toH_Delta4))

/-- `Δ = σ₀σ₁σ₀` in `B₃`. -/
noncomputable def Delta : PresentedGroup (BraidsLinksMCG.braidRels 3) :=
  PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
    PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0

/-- `y = σ₀σ₁` in `B₃`. -/
noncomputable def yB : PresentedGroup (BraidsLinksMCG.braidRels 3) :=
  PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
    PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1

/-- `Δ⁴ = (σ₀σ₁)⁶`, from the Garside identity. -/
theorem Delta4_eq : Delta4 = Delta ^ 4 := by
  unfold Delta4
  rw [show (6 : ℕ) = 3 * 2 from rfl, pow_mul]
  unfold Delta
  rw [garside_identity_of.symm, ← pow_mul, show (2 : ℕ) * 2 = 4 from rfl]

/-- `q` kills `Δ⁴`. -/
theorem q_Delta4 : q Delta4 = 1 := by
  show QuotientGroup.mk' _ Delta4 = 1
  rw [← MonoidHom.mem_ker, QuotientGroup.ker_mk']
  exact Subgroup.subset_normalClosure (Set.mem_singleton Delta4)

/-- The images of `S`, `R` in `Q`. -/
noncomputable def genQ : Fin 2 → Q := Fin.cases (q Delta) (fun _ => q yB)

theorem genQ_zero : genQ 0 = q Delta := rfl

theorem genQ_one : genQ 1 = q yB := rfl

/-- The relators of `H` hold for `genQ`. -/
theorem genQ_rels : ∀ r ∈ relsSR, FreeGroup.lift genQ r = 1 := by
  intro r hr
  simp only [relsSR, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · rw [map_pow, FreeGroup.lift_apply_of, genQ_zero]
    show (q Delta) ^ 4 = 1
    rw [← map_pow, ← Delta4_eq]
    exact q_Delta4
  · rw [map_mul, map_pow, map_pow, FreeGroup.lift_apply_of, FreeGroup.lift_apply_of,
      genQ_zero, genQ_one]
    show (q yB) ^ 3 * (q Delta) ^ 2 = 1
    have h : (q yB) ^ 3 = (q Delta) ^ 2 := by
      rw [← map_pow, ← map_pow]
      show q (yB ^ 3) = q (Delta ^ 2)
      rw [show Delta ^ 2 = yB ^ 3 from garside_identity_of]
    rw [h, ← pow_add]
    show (q Delta) ^ 4 = 1
    rw [← map_pow, ← Delta4_eq]
    exact q_Delta4

/-- The map `H →* Q` sending `S ↦ q Δ`, `R ↦ q (σ₀σ₁)`. -/
noncomputable def toQ : H →* Q := PresentedGroup.toGroup genQ_rels

theorem toQ_S : toQ S = q Delta := by
  rw [toQ, S, PresentedGroup.toGroup.of, genQ_zero]

theorem toQ_R : toQ R = q yB := by
  rw [toQ, R, PresentedGroup.toGroup.of, genQ_one]

/-- `toH Δ = S`. -/
theorem toH_Delta : toH Delta = S := by
  unfold Delta
  rw [map_mul, map_mul, toH_of_zero, toH_of_one]
  have hSS : S * S = R ^ 3 := by rw [← pow_two S, S_sq_eq_R_cube]
  have key : (R⁻¹ * S) * (S * R⁻¹) * (R⁻¹ * S) = R⁻¹ * (S * S) * (R⁻¹ * R⁻¹) * S := by
    group
  rw [key, hSS]
  group

/-- `γ` computed on representatives of `B₃`. -/
theorem gamma_mk (x : PresentedGroup (BraidsLinksMCG.braidRels 3)) :
    gamma (QuotientGroup.mk x) = toH x := by
  show (QuotientGroup.lift _ toH _) (QuotientGroup.mk x) = toH x
  exact QuotientGroup.lift_mk' _ _ x

/-- `q` on representatives. -/
theorem q_mk (x : PresentedGroup (BraidsLinksMCG.braidRels 3)) :
    q x = QuotientGroup.mk x := by
  show (QuotientGroup.mk' _) x = QuotientGroup.mk x
  rw [QuotientGroup.mk'_apply]

/-- `toQ ∘ toH = q`. -/
theorem toQ_toH : toQ.comp toH = q := by
  refine PresentedGroup.ext (fun i => ?_)
  fin_cases i
  · show toQ (toH (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2))) =
        q (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2))
    rw [toH_of_zero, map_mul, map_inv, toQ_S, toQ_R]
    have h : yB⁻¹ * Delta =
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) := by
      unfold yB Delta
      group
    rw [← map_inv, ← map_mul, h]
  · show toQ (toH (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2))) =
        q (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2))
    rw [toH_of_one, map_mul, map_inv, toQ_S, toQ_R]
    have h : Delta * yB⁻¹ =
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2) := by
      unfold yB Delta
      rw [show PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
            PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
            PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 =
          PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
            PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
            PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 from braid_relation_of]
      group
    rw [← map_inv, ← map_mul, h]

/-- `γ ∘ toQ = id`. -/
theorem gamma_toQ : gamma.comp toQ = MonoidHom.id H := by
  refine PresentedGroup.ext (fun i => ?_)
  fin_cases i
  · show gamma (toQ S) = S
    rw [toQ_S, q_mk, gamma_mk, toH_Delta]
  · show gamma (toQ R) = R
    rw [toQ_R, q_mk, gamma_mk]
    show toH yB = R
    unfold yB
    exact toH_y

/-- `toQ ∘ γ = id`. -/
theorem toQ_gamma : toQ.comp gamma = MonoidHom.id Q := by
  refine MonoidHom.ext (fun z => ?_)
  refine QuotientGroup.induction_on z (fun x => ?_)
  show toQ (gamma (QuotientGroup.mk x)) = QuotientGroup.mk x
  rw [gamma_mk]
  have h := congrArg (fun f : PresentedGroup (BraidsLinksMCG.braidRels 3) →* Q => f x) toQ_toH
  simp only [MonoidHom.comp_apply] at h
  rw [h, q_mk]

/-- The two generators `A = !![1,-1;0,1]`, `B = !![2,-1;1,0]` of the reduced Burau image. -/
noncomputable def Amat : Matrix.SpecialLinearGroup (Fin 2) ℤ := ⟨!![1, -1; 0, 1], by decide⟩

noncomputable def Bmat : Matrix.SpecialLinearGroup (Fin 2) ℤ := ⟨!![2, -1; 1, 0], by decide⟩

noncomputable def genSL : Fin 2 → Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  Fin.cases Amat (fun _ => Bmat)

theorem genSL_braid : ∀ r ∈ BraidsLinksMCG.braidRels 3, FreeGroup.lift genSL r = 1 := by
  intro r hr
  simp only [BraidsLinksMCG.braidRels, Set.mem_union] at hr
  rcases hr with ⟨i, j, h, rfl⟩ | ⟨i, j, h, rfl⟩
  · exfalso
    fin_cases i <;> fin_cases j <;> norm_num at h
  · simp only [map_mul, map_inv, FreeGroup.lift_apply_of]
    rw [mul_inv_eq_one]
    fin_cases i <;> fin_cases j
    · exfalso; norm_num at h
    · show genSL (0 : Fin 2) * genSL 1 * genSL 0 = genSL 1 * genSL 0 * genSL 1
      ext a b
      fin_cases a <;> fin_cases b <;> decide
    · exfalso; norm_num at h
    · exfalso; norm_num at h

/-- The map `B₃ →* SL(2,ℤ)` of the `t = -1` specialization of the reduced Burau representation. -/
noncomputable def toSL : PresentedGroup (BraidsLinksMCG.braidRels 3) →*
    Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  PresentedGroup.toGroup genSL_braid

theorem toSL_of_zero :
    toSL (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2)) = Amat := by
  rw [toSL, PresentedGroup.toGroup.of]
  rfl

theorem toSL_of_one :
    toSL (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2)) = Bmat := by
  rw [toSL, PresentedGroup.toGroup.of]
  rfl

/-- `(AB)⁶ = 1`. -/
theorem Amat_mul_Bmat_pow_six : (Amat * Bmat) ^ 6 = 1 := by
  ext a b
  fin_cases a <;> fin_cases b <;> decide

/-- `toSL` kills `Δ⁴ = (σ₀σ₁)⁶`. -/
theorem toSL_Delta4 :
    toSL ((PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1) ^ 6) = 1 := by
  rw [map_pow, map_mul, toSL_of_zero, toSL_of_one]
  exact Amat_mul_Bmat_pow_six

/-- The induced map `ψ : Q →* SL(2,ℤ)`. -/
noncomputable def psi : Q →* Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  QuotientGroup.lift
    (Subgroup.normalClosure ({Delta4} : Set (PresentedGroup (BraidsLinksMCG.braidRels 3))))
    toSL (Subgroup.normalClosure_le_normal (by
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact toSL_Delta4))

/-- `A` and `B` generate `SL(2,ℤ)`. -/
theorem closure_Amat_Bmat :
    Subgroup.closure ({Amat, Bmat} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) = ⊤ := by
  have h1 : Amat ∈ Subgroup.closure ({Amat, Bmat} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) :=
    Subgroup.subset_closure (by simp)
  have h2 : Bmat ∈ Subgroup.closure ({Amat, Bmat} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) :=
    Subgroup.subset_closure (by simp)
  have hS : ModularGroup.S ∈
      Subgroup.closure ({Amat, Bmat} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) := by
    have h : ModularGroup.S = Amat ^ 2 * Bmat := by
      ext i j
      fin_cases i <;> fin_cases j <;> decide
    rw [h]
    exact Subgroup.mul_mem _ (Subgroup.pow_mem _ h1 2) h2
  have hT : ModularGroup.T ∈
      Subgroup.closure ({Amat, Bmat} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) := by
    have h : ModularGroup.T = Amat⁻¹ := by
      ext i j
      fin_cases i <;> fin_cases j <;> decide
    rw [h]
    exact Subgroup.inv_mem _ h1
  have hST : ({ModularGroup.S, ModularGroup.T} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) ⊆
      Subgroup.closure ({Amat, Bmat} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) := by
    intro x hx
    rcases hx with rfl | rfl
    · exact hS
    · exact hT
  have htop : (⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℤ)) ≤
      Subgroup.closure ({Amat, Bmat} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) := by
    rw [← SpecialLinearGroup.SL2Z_generators]
    rw [Subgroup.closure_le]
    exact hST
  exact top_le_iff.mp htop

/-- `ψ` is surjective. -/
theorem psi_surjective : Function.Surjective psi := by
  intro x
  have hx : x ∈ Subgroup.closure ({Amat, Bmat} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) := by
    rw [closure_Amat_Bmat]
    trivial
  have hsub : ({Amat, Bmat} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) ⊆
      (psi.range : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) := by
    intro y hy
    rcases hy with rfl | rfl
    · exact ⟨q (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2)),
        by rw [q_mk, psi, QuotientGroup.lift_mk', toSL_of_zero]⟩
    · exact ⟨q (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2)),
        by rw [q_mk, psi, QuotientGroup.lift_mk', toSL_of_one]⟩
  have hle : Subgroup.closure ({Amat, Bmat} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) ≤
      psi.range := by
    rw [Subgroup.closure_le]
    exact hsub
  exact hle hx

end BurauKerFinal



set_option autoImplicit false

open Matrix

/-!
# The entry-sum monovariant behind the elementary presentation proof of `SL(2,ℤ)`

Source: **Keith Conrad, *SL₂(ℤ)*, Appendix C** (Theorem C.1), whose argument is taken from
**R. Rankin, *Modular Forms and Functions* (CUP 1977), p. 12**; see
`REFERENCE_sl2z_presentation.md` for the full proof being ported.

With `S = !![0,-1;1,0]` (order 4, `S² = -1`) and `R = ST = !![0,-1;1,1]` (order 6, `R³ = -1`), one
has, up to sign,

`SR = -!![1,1;0,1]`,  `SR² = -!![1,0;1,1]`.

The matrices `U₁ = !![1,1;0,1]` and `U₂ = !![1,0;1,1]` have non-negative entries, and right
multiplication by either of them never decreases the sum of all four entries. Consequently any
non-empty product of copies of `U₁`, `U₂` has entry sum `≥ 3`, while the identity and its negative
have entry sum `2` resp. `-2`: **no non-empty product of `U₁`'s and `U₂`'s is `±1`**. This is the
step that rules out representations of `1` as a product of `x y`'s and `x y²`'s in Conrad's proof.
-/

namespace SL2FreeProd

abbrev M2 := Matrix (Fin 2) (Fin 2) ℤ

/-- `U₁ = !![1,1;0,1]` (up to sign, `S R`). -/
def U1 : M2 := !![1, 1; 0, 1]

/-- `U₂ = !![1,0;1,1]` (up to sign, `S R²`). -/
def U2 : M2 := !![1, 0; 1, 1]

/-- The sum of all four entries. -/
def entrySum (M : M2) : ℤ := M 0 0 + M 0 1 + M 1 0 + M 1 1

@[simp] theorem entrySum_one : entrySum (1 : M2) = 2 := by
  simp [entrySum, Matrix.one_fin_two]

@[simp] theorem entrySum_neg_one : entrySum (-1 : M2) = -2 := by
  simp [entrySum, Matrix.one_fin_two]

theorem entrySum_U1 : entrySum U1 = 3 := by simp [entrySum, U1]

theorem entrySum_U2 : entrySum U2 = 3 := by simp [entrySum, U2]

/-! ### Entry formulas for right multiplication -/

theorem mul_U1_entries (M : M2) :
    (M * U1) 0 0 = M 0 0 ∧ (M * U1) 0 1 = M 0 0 + M 0 1 ∧
      (M * U1) 1 0 = M 1 0 ∧ (M * U1) 1 1 = M 1 0 + M 1 1 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    simp [U1, Matrix.mul_apply, Fin.sum_univ_two]

theorem mul_U2_entries (M : M2) :
    (M * U2) 0 0 = M 0 0 + M 0 1 ∧ (M * U2) 0 1 = M 0 1 ∧
      (M * U2) 1 0 = M 1 0 + M 1 1 ∧ (M * U2) 1 1 = M 1 1 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
    simp [U2, Matrix.mul_apply, Fin.sum_univ_two]

theorem entrySum_mul_U1 (M : M2) (h : 0 ≤ M 0 0 + M 1 0) :
    entrySum M ≤ entrySum (M * U1) := by
  obtain ⟨h00, h01, h10, h11⟩ := mul_U1_entries M
  simp only [entrySum, h00, h01, h10, h11]
  linarith

theorem entrySum_mul_U2 (M : M2) (h : 0 ≤ M 0 1 + M 1 1) :
    entrySum M ≤ entrySum (M * U2) := by
  obtain ⟨h00, h01, h10, h11⟩ := mul_U2_entries M
  simp only [entrySum, h00, h01, h10, h11]
  linarith

/-- A product of two matrices with non-negative entries has non-negative entries. -/
theorem nonneg_mul {A B : M2} (hA : ∀ i j, 0 ≤ A i j) (hB : ∀ i j, 0 ≤ B i j) :
    ∀ i j, 0 ≤ (A * B) i j := by
  intro i j
  simp only [Matrix.mul_apply, Fin.sum_univ_two]
  exact add_nonneg (mul_nonneg (hA i 0) (hB 0 j)) (mul_nonneg (hA i 1) (hB 1 j))

/-! ### Products of `U₁`'s and `U₂`'s -/

/-- A product of copies of `U₁`, `U₂` has non-negative entries. -/
theorem nonneg_prod : ∀ l : List M2, (∀ U ∈ l, U = U1 ∨ U = U2) → ∀ i j, 0 ≤ l.prod i j
  | [], _ => by
      intro i j
      show 0 ≤ (1 : M2) i j
      rw [Matrix.one_apply]
      split_ifs <;> norm_num
  | U :: l, h => by
      have hU : U = U1 ∨ U = U2 := h U (List.mem_cons_self ..)
      have hl : ∀ V ∈ l, V = U1 ∨ V = U2 := fun V hV => h V (List.mem_cons_of_mem _ hV)
      have ih := nonneg_prod l hl
      have hUne : ∀ i j, 0 ≤ U i j := by
        rcases hU with rfl | rfl <;> (intro i j; fin_cases i <;> fin_cases j <;> simp [U1, U2])
      rw [List.prod_cons]
      exact nonneg_mul hUne ih

/-- Right multiplication by a product of `U₁`'s and `U₂`'s never decreases the entry sum. -/
theorem entrySum_le_mul_prod : ∀ l : List M2, (∀ U ∈ l, U = U1 ∨ U = U2) →
    ∀ M : M2, (∀ i j, 0 ≤ M i j) → entrySum M ≤ entrySum (M * l.prod)
  | [], _, M, _ => by simp
  | U :: l, h, M, hM => by
      have hU : U = U1 ∨ U = U2 := h U (List.mem_cons_self ..)
      have hl : ∀ V ∈ l, V = U1 ∨ V = U2 := fun V hV => h V (List.mem_cons_of_mem _ hV)
      have hstep : entrySum M ≤ entrySum (M * U) := by
        rcases hU with rfl | rfl
        · exact entrySum_mul_U1 M (by linarith [hM 0 0, hM 1 0])
        · exact entrySum_mul_U2 M (by linarith [hM 0 1, hM 1 1])
      have hM' : ∀ i j, 0 ≤ (M * U) i j := by
        rcases hU with rfl | rfl
        · exact nonneg_mul hM (by intro i j; fin_cases i <;> fin_cases j <;> simp [U1])
        · exact nonneg_mul hM (by intro i j; fin_cases i <;> fin_cases j <;> simp [U2])
      have ih := entrySum_le_mul_prod l hl (M * U) hM'
      calc entrySum M ≤ entrySum (M * U) := hstep
        _ ≤ entrySum ((M * U) * l.prod) := ih
        _ = entrySum (M * (U :: l).prod) := by rw [List.prod_cons, mul_assoc]

/-- **The monovariant.** A non-empty product of `U₁`'s and `U₂`'s has entry sum at least `3`. -/
theorem three_le_entrySum_prod : ∀ l : List M2, (∀ U ∈ l, U = U1 ∨ U = U2) → l ≠ [] →
    3 ≤ entrySum l.prod
  | [], _, h => absurd rfl h
  | U :: l, h, _ => by
      have hU : U = U1 ∨ U = U2 := h U (List.mem_cons_self ..)
      have hl : ∀ V ∈ l, V = U1 ∨ V = U2 := fun V hV => h V (List.mem_cons_of_mem _ hV)
      have hsum : entrySum U = 3 := by
        rcases hU with rfl | rfl <;> simp [entrySum_U1, entrySum_U2]
      have hnonneg : ∀ i j, 0 ≤ U i j := by
        rcases hU with rfl | rfl <;> (intro i j; fin_cases i <;> fin_cases j <;> simp [U1, U2])
      have := entrySum_le_mul_prod l hl U hnonneg
      rw [List.prod_cons]
      linarith

/-- **No non-empty product of `U₁`'s and `U₂`'s is `±1`** (the identity and its negative have entry
sum `2` resp. `-2`). -/
theorem prod_ne_one_and_ne_neg_one (l : List M2) (h : ∀ U ∈ l, U = U1 ∨ U = U2) (hne : l ≠ []) :
    l.prod ≠ 1 ∧ l.prod ≠ -1 := by
  have h3 := three_le_entrySum_prod l h hne
  constructor <;> intro heq
  · rw [heq] at h3; simp [entrySum] at h3
  · rw [heq] at h3; simp [entrySum] at h3

/-! ### The letters that end a Conrad form

A Conrad exponent list starting with `x = S` has letters `S R^{i₁}, …, S R^{i_n}`; the last one is a
bare `S` when `i_n = 0`. The case analysis therefore also needs "products of `U`'s are never `±S`",
which is immediate from positivity: products of `U₁ = !![1,1;0,1]` and `U₂ = !![1,0;1,1]` have
non-negative entries, while `±S = ±!![0,-1;1,0]` has a negative entry. -/

/-- `S = !![0,-1;1,0]` as a plain matrix. -/
def Sm : M2 := !![0, -1; 1, 0]

theorem Sm_neg_entry : Sm 0 1 = -1 := by simp [Sm]

theorem negSm_neg_entry : (-Sm) 1 0 = -1 := by simp [Sm]

/-- No product of `U₁`'s and `U₂`'s is `±S`. -/
theorem prod_ne_pm_Sm (l : List M2) (h : ∀ U ∈ l, U = U1 ∨ U = U2) :
    l.prod ≠ Sm ∧ l.prod ≠ -Sm := by
  have hnn := nonneg_prod l h
  constructor
  · intro hcon
    have := hnn 0 1
    rw [hcon, Sm_neg_entry] at this
    omega
  · intro hcon
    have := hnn 1 0
    rw [hcon, negSm_neg_entry] at this
    omega

end SL2FreeProd



set_option autoImplicit false

open Matrix

/-!
# Conrad's Theorem C.1 in Lean: setup

Ported from **Keith Conrad, *SL₂(ℤ)*, Appendix C** (argument from **Rankin, *Modular Forms and
Functions*, p. 12**); see `REFERENCE_sl2z_presentation.md` for the full proof and
`Solutions/Sol_sl2_free_product.lean` for the entry-sum monovariant it uses.

Generators: `S = !![0,-1;1,0]` (order 4, `S² = -1`) and `R = S T = !![0,-1;1,1]` (order 6,
`R³ = -1`), where `T = !![1,1;0,1]`. The two "letters" `S R` and `S R²` are, up to sign, the
non-negative matrices `U₁ = !![1,1;0,1]` and `U₂ = !![1,0;1,1]`, which the monovariant shows can
never multiply to `±1`.

Everything here is a `decide` fact about concrete `2×2` integer matrices.
-/

namespace SL2Conrad

abbrev SL2 := Matrix.SpecialLinearGroup (Fin 2) ℤ

abbrev M2 := Matrix (Fin 2) (Fin 2) ℤ

/-- `S = !![0,-1;1,0]`, of order 4. -/
def S : SL2 := ⟨!![0, -1; 1, 0], by decide⟩

/-- `T = !![1,1;0,1]`, the unipotent generator. -/
def T : SL2 := ⟨!![1, 1; 0, 1], by decide⟩

/-- `R = S T = !![0,-1;1,1]`, of order 6. -/
def R : SL2 := S * T

/-- `U₁ = !![1,1;0,1]`, i.e. `S R` up to sign. -/
def U1 : M2 := !![1, 1; 0, 1]

/-- `U₂ = !![1,0;1,1]`, i.e. `S R²` up to sign. -/
def U2 : M2 := !![1, 0; 1, 1]

/-- The `-1` of `SL(2,ℤ)`. -/
def negOne : SL2 := -1

theorem S_sq : S ^ 2 = -1 := by decide

theorem S_pow_four : S ^ 4 = 1 := by decide

theorem S_ne_one : S ≠ 1 := by decide

theorem S_ne_neg_one : S ≠ -1 := by decide

theorem R_cube : R ^ 3 = -1 := by decide

theorem R_pow_six : R ^ 6 = 1 := by decide

theorem R_ne_one : R ≠ 1 := by decide

theorem R_ne_neg_one : R ≠ -1 := by decide

theorem R_sq_ne_one : R ^ 2 ≠ 1 := by decide

theorem R_sq_ne_neg_one : R ^ 2 ≠ -1 := by decide

theorem R_sq_ne_neg_R : R ^ 2 ≠ -R := by decide

theorem negOne_central (g : SL2) : (-1 : SL2) * g = g * (-1 : SL2) := by
  rw [mul_neg, neg_mul, one_mul, mul_one]

/-- The two letters, up to sign: `S R = -U₁`. -/
theorem S_mul_R : ((S * R : SL2) : M2) = -U1 := by decide

/-- `S R² = -U₂`. -/
theorem S_mul_R_sq : ((S * R ^ 2 : SL2) : M2) = -U2 := by decide

/-- Shift the exponent of `R` by three, which flips the sign (`R³ = -1`). -/
theorem R_zpow_add_three (i : ℤ) : R ^ (i + 3) = -(R ^ i) := by
  have h3 : R ^ (3 : ℤ) = -1 := by
    rw [show (3 : ℤ) = ((3 : ℕ) : ℤ) by norm_num, zpow_natCast, R_cube]
  rw [_root_.zpow_add, h3, mul_neg, mul_one]

/-! ### The finite letter table

In the normal form `R^{i₀} S R^{i₁} S ⋯ S R^{i_n}` all exponents are taken in `{0,1,2}`, so the only
letters that ever occur, and the only powers of `R` that occur after shifting the last exponent by
`i₀ ∈ {0,1,2}`, have exponent `m ∈ {0,1,2,3,4}`. All of them are therefore finite facts. -/

theorem R_pow_four : (R ^ (4 : ℕ) : SL2) = -R := by decide

theorem R_pow_three_nat : (R ^ (3 : ℕ) : SL2) = -1 := R_cube

theorem negOne_sq : (-1 : SL2) ^ 2 = 1 := by decide

/-- `S R⁰ = S`. -/
theorem S_mul_R_pow_zero : ((S * R ^ (0 : ℕ) : SL2) : M2) = !![0, -1; 1, 0] := by decide

/-- `S R¹ = -U₁`. -/
theorem S_mul_R_pow_one : ((S * R ^ (1 : ℕ) : SL2) : M2) = -U1 := by
  simpa using S_mul_R

/-- `S R² = -U₂`. -/
theorem S_mul_R_pow_two : ((S * R ^ (2 : ℕ) : SL2) : M2) = -U2 := by
  simpa using S_mul_R_sq

/-- `S R³ = -S`. -/
theorem S_mul_R_pow_three : ((S * R ^ (3 : ℕ) : SL2) : M2) = -!![0, -1; 1, 0] := by decide

/-- `S R⁴ = U₁`. -/
theorem S_mul_R_pow_four : ((S * R ^ (4 : ℕ) : SL2) : M2) = U1 := by decide

/-- `S R⁵ = U₂`. -/
theorem S_mul_R_pow_five : ((S * R ^ (5 : ℕ) : SL2) : M2) = U2 := by decide

/-- The normal-form product `R^{i₀} S R^{i₁} S ⋯ S R^{i_n}` (exponents in `{0,1,2}`). -/
def nfProd : List ℕ → SL2
  | [] => 1
  | [i] => R ^ i
  | i :: rest => R ^ i * S * nfProd rest

@[simp] theorem nfProd_nil : nfProd [] = 1 := rfl

@[simp] theorem nfProd_singleton (i : ℕ) : nfProd [i] = R ^ i := rfl

theorem nfProd_cons_cons (i : ℕ) {l : List ℕ} (hl : l ≠ []) :
    nfProd (i :: l) = R ^ i * S * nfProd l := by
  cases l with
  | nil => exact absurd rfl hl
  | cons j rest => rfl

/-! ### Signs do not matter for the monovariant

The letters `S R^m` with `m ∈ {1,2,4,5}` are `±U₁` or `±U₂`, and `-1` is central in `M2`, so any
product of such letters is `±` (a product of `U₁`'s and `U₂`'s). -/

/-- `-1` is central in `M2`. -/
theorem negOneMat_central (M : M2) : (-1 : M2) * M = M * (-1 : M2) := by
  rw [neg_mul, one_mul, mul_neg, mul_one]

/-- Every letter whose exponent lies in `{1,2,4,5}` is `±U₁` or `±U₂`. -/
theorem letter_cases (m : ℕ) (h : m = 1 ∨ m = 2 ∨ m = 4 ∨ m = 5) :
    ((S * R ^ m : SL2) : M2) = U1 ∨ ((S * R ^ m : SL2) : M2) = -U1 ∨
      ((S * R ^ m : SL2) : M2) = U2 ∨ ((S * R ^ m : SL2) : M2) = -U2 := by
  rcases h with h | h | h | h <;> subst h
  · exact Or.inr (Or.inl S_mul_R_pow_one)
  · exact Or.inr (Or.inr (Or.inr S_mul_R_pow_two))
  · exact Or.inl S_mul_R_pow_four
  · exact Or.inr (Or.inr (Or.inl S_mul_R_pow_five))

/-- Split a `±U` into a sign and an unsigned `U`. -/
theorem letter_split (M : M2) (h : M = U1 ∨ M = -U1 ∨ M = U2 ∨ M = -U2) :
    ∃ (s : M2) (A : M2), (s = 1 ∨ s = -1) ∧ (A = U1 ∨ A = U2) ∧ M = s * A := by
  rcases h with h | h | h | h
  · exact ⟨1, U1, Or.inl rfl, Or.inl rfl, by rw [h]; simp⟩
  · exact ⟨-1, U1, Or.inr rfl, Or.inl rfl, by rw [h]; simp⟩
  · exact ⟨1, U2, Or.inl rfl, Or.inr rfl, by rw [h]; simp⟩
  · exact ⟨-1, U2, Or.inr rfl, Or.inr rfl, by rw [h]; simp⟩

/-- **Sign collection.** A product of `±U`'s is a sign times a product of `U`'s, with the unsigned
list as long as the original one. -/
theorem prod_signed (l : List M2)
    (h : ∀ M ∈ l, M = U1 ∨ M = -U1 ∨ M = U2 ∨ M = -U2) :
    ∃ (s : M2) (m : List M2), (s = 1 ∨ s = -1) ∧ (∀ A ∈ m, A = U1 ∨ A = U2) ∧
      m.length = l.length ∧ l.prod = s * m.prod := by
  induction l with
  | nil => exact ⟨1, [], Or.inl rfl, by simp, by simp, by simp⟩
  | cons M l ih =>
      have hM : M = U1 ∨ M = -U1 ∨ M = U2 ∨ M = -U2 := h M (List.mem_cons_self ..)
      have hl : ∀ N ∈ l, N = U1 ∨ N = -U1 ∨ N = U2 ∨ N = -U2 :=
        fun N hN => h N (List.mem_cons_of_mem _ hN)
      obtain ⟨s, A, hs, hA, hMA⟩ := letter_split M hM
      obtain ⟨s', m, hs', hm, hlen, hprod⟩ := ih hl
      refine ⟨s * s', A :: m, ?_, ?_, ?_, ?_⟩
      · rcases hs with hs | hs <;> rcases hs' with hs' | hs' <;> rw [hs, hs'] <;> decide
      · intro B hB
        rcases List.mem_cons.mp hB with rfl | hB
        · exact hA
        · exact hm B hB
      · simp [hlen]
      · rw [List.prod_cons, hprod, hMA, List.prod_cons]
        rcases hs' with hs' | hs'
        · simp only [hs', one_mul, mul_one, mul_assoc]
        · simp only [hs', neg_mul, one_mul, mul_neg, mul_one, mul_assoc]

/-! ### Letters and the normal form -/

/-- The letters `S R^{i₀}, S R^{i₁}, …` of the normal form, as a list in `SL(2,ℤ)`. -/
def lettersSL (l : List ℕ) : List SL2 := l.map fun i => S * R ^ i

/-- **Letter decomposition**: for non-empty `l`, `S * nfProd l` is the product of the letters. -/
theorem S_mul_nfProd (l : List ℕ) (hl : l ≠ []) :
    S * nfProd l = (lettersSL l).prod := by
  induction l with
  | nil => exact absurd rfl hl
  | cons i rest ih =>
      cases rest with
      | nil => simp [nfProd, lettersSL]
      | cons j rest' =>
          have hne : (j :: rest') ≠ [] := by simp
          rw [nfProd_cons_cons i hne, mul_assoc (R ^ i) S (nfProd (j :: rest')),
            ← mul_assoc S (R ^ i) (S * nfProd (j :: rest')), ih hne]
          simp only [lettersSL, List.map_cons, List.prod_cons, mul_assoc]

/-- **Shift lemma**: `R ^ a` can be pushed into the last letter of the letter product. -/
theorem lettersSL_prod_mul_R (mid : List ℕ) (b a : ℕ) :
    (lettersSL (mid ++ [b])).prod * R ^ a = (lettersSL (mid ++ [b + a])).prod := by
  induction mid with
  | nil => simp [lettersSL, pow_add, mul_assoc]
  | cons i rest ih =>
      have ih' := ih
      simp only [lettersSL] at ih'
      simp only [List.cons_append, lettersSL, List.map_cons, List.prod_cons]
      rw [mul_assoc, ih']

/-! ### Case (b) of Conrad's induction -/

/-- `S⁻¹ = !![0,1;-1,0]`, explicitly. -/
def Sinv : SL2 := ⟨!![0, 1; -1, 0], by decide⟩

theorem S_mul_Sinv : S * Sinv = 1 := by decide

theorem Sinv_mul_S : Sinv * S = 1 := by decide

theorem Sinv_sq : Sinv * Sinv = -1 := by decide

theorem neg_eq_neg_one_iff (X : SL2) : -X = -1 ↔ X = 1 := neg_inj

theorem neg_eq_one_iff (X : SL2) : -X = 1 ↔ X = -1 := by
  constructor
  · intro h
    have h' := congrArg Neg.neg h
    simpa using h'
  · intro h
    rw [h]
    simp

/-- **Cancelling outer `S`'s**: `S X S = ±1` implies `X = ±1`. -/
theorem eq_pm_one_of_SXS (X : SL2) (h : S * X * S = 1 ∨ S * X * S = -1) :
    X = 1 ∨ X = -1 := by
  have hXS : X = Sinv * (S * X * S) * Sinv := by
    rw [← mul_assoc Sinv (S * X) S, ← mul_assoc Sinv S X, Sinv_mul_S, one_mul,
      mul_assoc X S Sinv, S_mul_Sinv, mul_one]
  have h1 : Sinv * (1 : SL2) * Sinv = -1 := by rw [mul_one, Sinv_sq]
  have h2 : Sinv * (-1 : SL2) * Sinv = 1 := by
    rw [mul_neg, mul_one, neg_mul, Sinv_sq, neg_neg]
  rcases h with h | h
  · right
    rw [h, h1] at hXS
    exact hXS
  · left
    rw [h, h2] at hXS
    exact hXS

/-- **Case (b)**: if the letters of `mid ++ [b]` multiply to `±1` and `R ^ b = ±1`, then `nfProd mid`
is `±1` — the shorter word whose existence contradicts minimality in Conrad's induction. -/
theorem nfProd_of_letters (mid : List ℕ) (b : ℕ) (hm : mid ≠ [])
    (hR : R ^ b = 1 ∨ R ^ b = -1)
    (h : (lettersSL (mid ++ [b])).prod = 1 ∨ (lettersSL (mid ++ [b])).prod = -1) :
    nfProd mid = 1 ∨ nfProd mid = -1 := by
  have hsplit : (lettersSL (mid ++ [b])).prod = (lettersSL mid).prod * (S * R ^ b) := by
    simp [lettersSL, List.map_append, List.prod_append]
  rw [hsplit, ← S_mul_nfProd mid hm] at h
  rcases hR with hR | hR
  · rw [hR, mul_one] at h
    exact eq_pm_one_of_SXS (nfProd mid) (by simpa [mul_assoc] using h)
  · rw [hR] at h
    have h2 : S * nfProd mid * S = 1 ∨ S * nfProd mid * S = -1 := by
      rcases h with h | h
      · right
        have hne : -((S * nfProd mid) * S) = 1 := by
          simpa [mul_neg, mul_one, mul_assoc] using h
        exact neg_eq_one_iff _ |>.mp hne
      · left
        have hne : -((S * nfProd mid) * S) = -1 := by
          simpa [mul_neg, mul_one, mul_assoc] using h
        exact neg_eq_neg_one_iff _ |>.mp hne
    exact eq_pm_one_of_SXS (nfProd mid) h2

/-! ### The Conrad normal-form predicate and the base cases -/

/-- `l` is a Conrad exponent list: non-empty, every exponent `≤ 2`, and every *inner* exponent
(non-zero position, not the last) is non-zero. -/
def IsNF (l : List ℕ) : Prop :=
  l ≠ [] ∧ (∀ m ∈ l, m ≤ 2) ∧ ∀ m ∈ (l.drop 1).dropLast, m ≠ 0

/-- Conjugating a `±1` by anything gives it back. -/
theorem inv_mul_pm_one_mul (Y Z : SL2) (hZ : Z = 1 ∨ Z = -1) : Y⁻¹ * Z * Y = Z := by
  rcases hZ with rfl | rfl
  · rw [mul_one, inv_mul_cancel]
  · rw [mul_neg, mul_one, neg_mul, inv_mul_cancel]

theorem nfProd_len_one (a : ℕ) (ha : a ≤ 2)
    (h : nfProd [a] = 1 ∨ nfProd [a] = -1) : a = 0 := by
  interval_cases a
  · rfl
  · exfalso
    rw [nfProd_singleton, pow_one] at h
    simp [R_ne_one, R_ne_neg_one] at h
  · exfalso
    rw [nfProd_singleton] at h
    simp [R_sq_ne_one, R_sq_ne_neg_one] at h

theorem nfProd_len_two (a b : ℕ) (ha : a ≤ 2) (hb : b ≤ 2)
    (h : nfProd [a, b] = 1 ∨ nfProd [a, b] = -1) : False := by
  interval_cases a <;> interval_cases b <;> (exfalso; revert h; decide)

/-! ### Splitting off the last element, and Conrad's tail predicate

For the induction we need to peel the *last* element of a list, so `init` is defined by its own
structural recursion (its equation lemmas are then `rfl`). -/

/-- All but the last element. -/
def init : List ℕ → List ℕ
  | [] => []
  | [_] => []
  | b :: c :: rest => b :: init (c :: rest)

@[simp] theorem init_nil : init [] = [] := rfl

@[simp] theorem init_singleton (b : ℕ) : init [b] = [] := rfl

theorem init_cons_cons (b c : ℕ) (rest : List ℕ) :
    init (b :: c :: rest) = b :: init (c :: rest) := rfl

theorem init_cons_of_ne_nil (y : ℕ) {l : List ℕ} (hl : l ≠ []) : init (y :: l) = y :: init l := by
  cases l with
  | nil => exact absurd rfl hl
  | cons z zs => rfl

theorem init_append_singleton (l : List ℕ) (b : ℕ) : init (l ++ [b]) = l := by
  induction l with
  | nil => simp [init]
  | cons y t ih =>
      have hne : t ++ [b] ≠ [] := by simp
      rw [List.cons_append, init_cons_of_ne_nil y hne]
      cases t with
      | nil => simp [init]
      | cons z zs => rw [ih]

theorem eq_init_append_last : ∀ t : List ℕ, t ≠ [] → ∃ b : ℕ, t = init t ++ [b]
  | [], h => absurd rfl h
  | [b], _ => ⟨b, by simp [init]⟩
  | x :: y :: rest, _ => by
      obtain ⟨b, hb⟩ := eq_init_append_last (y :: rest) (by simp)
      exact ⟨b, by rw [init_cons_cons, List.cons_append, ← hb]⟩

/-- Conrad's tail predicate: every entry is `1` or `2`, except possibly the last, which is `≤ 2`. -/
def IsNFtail : List ℕ → Prop
  | [] => False
  | [b] => b ≤ 2
  | b :: c :: rest => (b = 1 ∨ b = 2) ∧ IsNFtail (c :: rest)

theorem isNFtail_ne_nil {t : List ℕ} (h : IsNFtail t) : t ≠ [] := by
  cases t with
  | nil => exact h.elim
  | cons b rest => simp

theorem isNFtail_le_two : ∀ {t : List ℕ}, IsNFtail t → ∀ m ∈ t, m ≤ 2
  | [], h => h.elim
  | [b], h => by
      intro m hm
      have hb : b ≤ 2 := h
      simp at hm
      omega
  | b :: c :: rest, h => by
      intro m hm
      rcases List.mem_cons.mp hm with rfl | hm
      · rcases h.1 with h1 | h1 <;> omega
      · exact isNFtail_le_two h.2 m hm

theorem isNFtail_tail {b : ℕ} {rest : List ℕ} (h : IsNFtail (b :: rest)) (hr : rest ≠ []) :
    IsNFtail rest := by
  cases rest with
  | nil => exact absurd rfl hr
  | cons c t => exact h.2

theorem isNFtail_cons_of {b : ℕ} {l : List ℕ} (hb : b = 1 ∨ b = 2)
    (hl : IsNFtail l ∨ l = []) : IsNFtail (b :: l) := by
  rcases hl with hl | rfl
  · cases l with
    | nil => exact hl.elim
    | cons x t => exact ⟨hb, hl⟩
  · rcases hb with h | h <;> rw [h] <;> simp [IsNFtail]

/-- `init` preserves the tail predicate, and all entries of `init t` (for `1 < t.length`) are `1` or
`2`. -/
theorem isNFtail_init : ∀ {t : List ℕ}, IsNFtail t → 1 < t.length →
    IsNFtail (init t) ∧ ∀ m ∈ init t, m = 1 ∨ m = 2
  | [], h, _ => h.elim
  | [_], _, hlen => by simp at hlen
  | b :: c :: rest, h, _ => by
      cases rest with
      | nil =>
          refine ⟨?_, ?_⟩
          · rw [init_cons_cons, init_singleton]
            rcases h.1 with h1 | h1 <;> rw [h1] <;> simp [IsNFtail]
          · intro m hm
            simp [init_cons_cons, init_singleton] at hm
            rw [hm]
            exact h.1
      | cons d rest' =>
          have htail : IsNFtail (c :: d :: rest') := h.2
          have hlen' : 1 < (c :: d :: rest').length := by simp
          obtain ⟨ih1, ih2⟩ := isNFtail_init htail hlen'
          refine ⟨?_, ?_⟩
          · rw [init_cons_cons]
            exact isNFtail_cons_of h.1 (Or.inl ih1)
          · intro m hm
            rw [init_cons_cons] at hm
            rcases List.mem_cons.mp hm with rfl | hm
            · exact h.1
            · exact ih2 m hm

theorem init_length_add_one_le : ∀ l : List ℕ, l ≠ [] → (init l).length + 1 ≤ l.length
  | [], h => absurd rfl h
  | [b], _ => by simp [init]
  | b :: c :: rest, _ => by
      rw [init_cons_cons, List.length_cons, List.length_cons]
      exact Nat.succ_le_succ (init_length_add_one_le (c :: rest) (by simp))

/-- The inductive step of Claim A, isolated: from `R ^ b * P = ±1`, where `P` is the letter product
of the Conrad tail `c :: d :: rest` and `b ∈ {1,2}`, we derive a contradiction with the induction
hypothesis for `init (c :: d :: rest)`.

`hletters` is the consequence of the entry-sum monovariant (`Sol_sl2_free_product.lean`): a non-empty
product of letters with exponents in `{1,2,4,5}` is never `±1`. -/
theorem nfProd_ne_pm_one_step
    (hletters : ∀ l : List ℕ, l ≠ [] → (∀ m ∈ l, m = 1 ∨ m = 2 ∨ m = 4 ∨ m = 5) →
      (lettersSL l).prod ≠ 1 ∧ (lettersSL l).prod ≠ -1)
    {b c d : ℕ} {rest : List ℕ} (hb : b = 1 ∨ b = 2)
    (htail : IsNFtail (c :: d :: rest))
    (hinit_ne : init (c :: d :: rest) ≠ [])
    (hIH : nfProd (init (c :: d :: rest)) ≠ 1 ∧ nfProd (init (c :: d :: rest)) ≠ -1)
    (h : R ^ b * (lettersSL (c :: d :: rest)).prod = 1 ∨
      R ^ b * (lettersSL (c :: d :: rest)).prod = -1) : False := by
  have hu : (c :: d :: rest) ≠ [] := by simp
  have hlen2 : 1 < (c :: d :: rest).length := by simp
  have hPR : (lettersSL (c :: d :: rest)).prod * R ^ b = 1 ∨
      (lettersSL (c :: d :: rest)).prod * R ^ b = -1 := by
    rcases h with h | h
    · left
      have h1 : (lettersSL (c :: d :: rest)).prod = (R ^ b)⁻¹ * (1 : SL2) := by
        have hc := congrArg (fun Z : SL2 => (R ^ b)⁻¹ * Z) h
        simpa only [← mul_assoc, inv_mul_cancel, one_mul] using hc
      rw [h1]
      exact inv_mul_pm_one_mul (R ^ b) 1 (Or.inl rfl)
    · right
      have h1 : (lettersSL (c :: d :: rest)).prod = (R ^ b)⁻¹ * (-1 : SL2) := by
        have hc := congrArg (fun Z : SL2 => (R ^ b)⁻¹ * Z) h
        simpa only [← mul_assoc, inv_mul_cancel, one_mul] using hc
      rw [h1]
      exact inv_mul_pm_one_mul (R ^ b) (-1) (Or.inr rfl)
  obtain ⟨d', hd'⟩ := eq_init_append_last (c :: d :: rest) hu
  have hshift : (lettersSL (init (c :: d :: rest) ++ [d' + b])).prod = 1 ∨
      (lettersSL (init (c :: d :: rest) ++ [d' + b])).prod = -1 := by
    rw [← lettersSL_prod_mul_R (init (c :: d :: rest)) d' b, ← hd']
    exact hPR
  have hb2 : b ≤ 2 := by rcases hb with h | h <;> omega
  have hd'_mem : d' ∈ (c :: d :: rest) := by rw [hd']; simp
  have hd2 : d' ≤ 2 := isNFtail_le_two htail d' hd'_mem
  have hsum : d' + b = 0 ∨ d' + b = 1 ∨ d' + b = 2 ∨ d' + b = 3 ∨ d' + b = 4 := by omega
  have hall_of : (d' + b = 1 ∨ d' + b = 2 ∨ d' + b = 4) →
      ∀ m ∈ init (c :: d :: rest) ++ [d' + b], m = 1 ∨ m = 2 ∨ m = 4 ∨ m = 5 := by
    intro hdb m hm
    rcases List.mem_append.mp hm with hm | hm
    · rcases (isNFtail_init htail hlen2).2 m hm with h | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
    · simp at hm
      subst hm
      rcases hdb with h | h | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr (Or.inl h))
  rcases hsum with h0 | h1 | h2 | h3 | h4
  · have hR : R ^ (d' + b) = 1 ∨ R ^ (d' + b) = -1 := by
      rw [h0]
      exact Or.inl (pow_zero R)
    rcases nfProd_of_letters (init (c :: d :: rest)) (d' + b) hinit_ne hR hshift with h | h
    · exact hIH.1 h
    · exact hIH.2 h
  · have hne : init (c :: d :: rest) ++ [d' + b] ≠ [] := by simp
    have hall := hall_of (Or.inl h1)
    rcases hshift with h | h
    · exact (hletters _ hne hall).1 h
    · exact (hletters _ hne hall).2 h
  · have hne : init (c :: d :: rest) ++ [d' + b] ≠ [] := by simp
    have hall := hall_of (Or.inr (Or.inl h2))
    rcases hshift with h | h
    · exact (hletters _ hne hall).1 h
    · exact (hletters _ hne hall).2 h
  · have hR : R ^ (d' + b) = 1 ∨ R ^ (d' + b) = -1 := by
      rw [h3]
      exact Or.inr R_cube
    rcases nfProd_of_letters (init (c :: d :: rest)) (d' + b) hinit_ne hR hshift with h | h
    · exact hIH.1 h
    · exact hIH.2 h
  · have hne : init (c :: d :: rest) ++ [d' + b] ≠ [] := by simp
    have hall := hall_of (Or.inr (Or.inr h4))
    rcases hshift with h | h
    · exact (hletters _ hne hall).1 h
    · exact (hletters _ hne hall).2 h

/-- **Claim A (Conrad's induction)**: a non-trivial Conrad tail never multiplies to `±1`. -/
theorem nfProd_ne_pm_one_aux
    (hletters : ∀ l : List ℕ, l ≠ [] → (∀ m ∈ l, m = 1 ∨ m = 2 ∨ m = 4 ∨ m = 5) →
      (lettersSL l).prod ≠ 1 ∧ (lettersSL l).prod ≠ -1) :
    ∀ n : ℕ, ∀ t : List ℕ, t.length ≤ n → IsNFtail t → t ≠ [0] →
      nfProd t ≠ 1 ∧ nfProd t ≠ -1 := by
  intro n
  induction n with
  | zero =>
      intro t hlen ht _
      cases t with
      | nil => exact ht.elim
      | cons a l => simp at hlen
  | succ n ih =>
      intro t hlen ht ht0
      rcases t with _ | ⟨b, _ | ⟨c, _ | ⟨d, rest⟩⟩⟩
      · exact absurd rfl (isNFtail_ne_nil ht)
      · have hb : b ≤ 2 := ht
        have hb0 : b ≠ 0 := fun h => ht0 (by rw [h])
        have hb12 : b = 1 ∨ b = 2 := by omega
        constructor <;> intro hcon
        · rw [nfProd_singleton] at hcon
          rcases hb12 with h | h <;> rw [h] at hcon <;>
            simp [pow_one, R_ne_one, R_sq_ne_one] at hcon
        · rw [nfProd_singleton] at hcon
          rcases hb12 with h | h <;> rw [h] at hcon <;>
            simp [pow_one, R_ne_neg_one, R_sq_ne_neg_one] at hcon
      · have hb2 : b ≤ 2 := by rcases ht.1 with h | h <;> omega
        have hc2 : c ≤ 2 := ht.2
        exact ⟨fun hcon => nfProd_len_two b c hb2 hc2 (Or.inl hcon),
          fun hcon => nfProd_len_two b c hb2 hc2 (Or.inr hcon)⟩
      · have hb : b = 1 ∨ b = 2 := ht.1
        have htail : IsNFtail (c :: d :: rest) := ht.2
        have hu : (c :: d :: rest) ≠ [] := by simp
        have hlen2 : 1 < (c :: d :: rest).length := by simp
        have hinit_ne : init (c :: d :: rest) ≠ [] := by
          rw [init_cons_cons]; simp
        have hinitNF : IsNFtail (init (c :: d :: rest)) := (isNFtail_init htail hlen2).1
        have hinit_entries : ∀ m ∈ init (c :: d :: rest), m = 1 ∨ m = 2 :=
          (isNFtail_init htail hlen2).2
        have hinit0 : init (c :: d :: rest) ≠ [0] := by
          intro hcon
          have hmem : (0 : ℕ) ∈ init (c :: d :: rest) := by rw [hcon]; simp
          rcases hinit_entries 0 hmem with h | h <;> omega
        have hlenn : (init (c :: d :: rest)).length ≤ n := by
          have hle := init_length_add_one_le (c :: d :: rest) hu
          have hlen' : (c :: d :: rest).length + 1 ≤ n + 1 := by simpa using hlen
          omega
        have hIH := ih (init (c :: d :: rest)) hlenn hinitNF hinit0
        constructor <;> intro hcon
        · have h := hcon
          rw [nfProd_cons_cons b hu, mul_assoc (R ^ b) S (nfProd (c :: d :: rest)),
            S_mul_nfProd (c :: d :: rest) hu] at h
          exact nfProd_ne_pm_one_step hletters hb htail hinit_ne hIH (Or.inl h)
        · have h := hcon
          rw [nfProd_cons_cons b hu, mul_assoc (R ^ b) S (nfProd (c :: d :: rest)),
            S_mul_nfProd (c :: d :: rest) hu] at h
          exact nfProd_ne_pm_one_step hletters hb htail hinit_ne hIH (Or.inr h)

end SL2Conrad



set_option autoImplicit false

open Matrix

/-!
# Discharging the letter hypothesis: Conrad's theorem, unconditional

This file is the **bridge** between the two developments:

* `Solutions/Sol_sl2_free_product.lean` — the entry-sum monovariant
  (`SL2FreeProd.prod_ne_one_and_ne_neg_one`: no non-empty product of `U₁`'s and `U₂`'s is `±1`);
* `Solutions/Sol_sl2_conrad.lean` — the finite letter table, `prod_signed`, and Conrad's induction
  `nfProd_ne_pm_one_aux`, which is *conditional* on the letter hypothesis `hletters`.

Compiling Lean in this workspace cannot share `.olean`s (a build is refused: `permission denied`), so
for compilation and for submission the three files are concatenated with the interior `import`s
stripped. Here we prove `hletters` from the monovariant and obtain Conrad's theorem unconditionally:

  **`nfProd t ≠ 1 ∧ nfProd t ≠ -1` for every Conrad tail `t` with `t ≠ [0]`.**

This is exactly the statement `PSL₂(ℤ) ≅ ℤ/2 * ℤ/3` (Keith Conrad, *SL₂(ℤ)*, Appendix C, Theorem
C.1; argument from Rankin, *Modular Forms and Functions*, p. 12).
-/

namespace SL2Discharge

/-- The letters of a normal-form list, as plain `2×2` matrices. -/
def letterMat (l : List ℕ) : List SL2Conrad.M2 :=
  l.map fun m => ((SL2Conrad.S * SL2Conrad.R ^ m : SL2Conrad.SL2) : SL2Conrad.M2)

/-- The coercion `SL(2,ℤ) → M₂` is multiplicative. -/
theorem coe_mul' (A B : SL2Conrad.SL2) :
    ((A * B : SL2Conrad.SL2) : SL2Conrad.M2) = (A : SL2Conrad.M2) * (B : SL2Conrad.M2) := rfl

/-- Coercing the product of letters to matrices. -/
theorem lettersSL_coe (l : List ℕ) :
    (((SL2Conrad.lettersSL l).prod : SL2Conrad.SL2) : SL2Conrad.M2) = (letterMat l).prod := by
  induction l with
  | nil => rfl
  | cons m l ih =>
      simp only [SL2Conrad.lettersSL, letterMat, List.map_cons, List.prod_cons] at ih ⊢
      rw [coe_mul', ih]

/-- **The letter hypothesis, proved.** A non-empty product of letters whose exponents lie in
`{1,2,4,5}` is never `±1` in `SL(2,ℤ)`. -/
theorem letters_ne_pm_one (l : List ℕ) (hne : l ≠ [])
    (h : ∀ m ∈ l, m = 1 ∨ m = 2 ∨ m = 4 ∨ m = 5) :
    (SL2Conrad.lettersSL l).prod ≠ 1 ∧ (SL2Conrad.lettersSL l).prod ≠ -1 := by
  have hcases : ∀ M ∈ letterMat l, M = SL2FreeProd.U1 ∨ M = -SL2FreeProd.U1 ∨
      M = SL2FreeProd.U2 ∨ M = -SL2FreeProd.U2 := by
    intro M hM
    simp only [letterMat, List.mem_map] at hM
    obtain ⟨m, hm, rfl⟩ := hM
    have hc := SL2Conrad.letter_cases m (h m hm)
    simpa [SL2Conrad.U1, SL2Conrad.U2, SL2FreeProd.U1, SL2FreeProd.U2] using hc
  obtain ⟨s, m, hs, hm, hlen, hprod⟩ := SL2Conrad.prod_signed (letterMat l) hcases
  have hLne : letterMat l ≠ [] := by
    simp only [letterMat, ne_eq, List.map_eq_nil_iff]
    exact hne
  have hmne : m ≠ [] := by
    intro h0
    have h1 : m.length = 0 := by simp [h0]
    rw [hlen] at h1
    exact hLne (List.length_eq_zero_iff.mp h1)
  have hmono := SL2FreeProd.prod_ne_one_and_ne_neg_one m hm hmne
  have hL1 : (letterMat l).prod ≠ 1 := by
    intro h1
    rw [hprod] at h1
    rcases hs with hs | hs
    · rw [hs, one_mul] at h1
      exact hmono.1 h1
    · rw [hs, neg_mul, one_mul] at h1
      have h2 : m.prod = -1 := by
        have := congrArg Neg.neg h1
        simpa using this
      exact hmono.2 h2
  have hL2 : (letterMat l).prod ≠ -1 := by
    intro h1
    rw [hprod] at h1
    rcases hs with hs | hs
    · rw [hs, one_mul] at h1
      exact hmono.2 h1
    · rw [hs, neg_mul, one_mul] at h1
      exact hmono.1 (neg_inj.mp h1)
  have hcoe := lettersSL_coe l
  constructor
  · intro hcon
    exact hL1 (by rw [← hcoe]; exact congrArg (fun z : SL2Conrad.SL2 => (z : SL2Conrad.M2)) hcon)
  · intro hcon
    exact hL2 (by rw [← hcoe]; exact congrArg (fun z : SL2Conrad.SL2 => (z : SL2Conrad.M2)) hcon)

/-- **Conrad's theorem, unconditional.** Every Conrad exponent list `t ≠ [0]` has normal-form
product different from `±1`. -/
theorem conrad_theorem (n : ℕ) (t : List ℕ) (hlen : t.length ≤ n) (ht : SL2Conrad.IsNFtail t)
    (ht0 : t ≠ [0]) : SL2Conrad.nfProd t ≠ 1 ∧ SL2Conrad.nfProd t ≠ -1 :=
  SL2Conrad.nfProd_ne_pm_one_aux letters_ne_pm_one n t hlen ht ht0

/-! ### The letters extension: a bare `S` is allowed as the last letter

A Conrad form starting with `x = S` has letters `S R^{i₁}, …, S R^{i_n}`, and the last one is a bare
`S` when `i_n = 0`. Since `(product of U's) * S = ±1` is equivalent to `(product of U's) = ±S`,
which is impossible by positivity, such a product is never `±1`. -/

theorem Sm_mul_neg_Sm : SL2FreeProd.Sm * (-SL2FreeProd.Sm) = 1 := by decide

theorem neg_Sm_mul_Sm : (-SL2FreeProd.Sm) * SL2FreeProd.Sm = 1 := by decide

/-- Multiplying a `±1`-free matrix by `±1` keeps it `±1`-free. -/
theorem pm_one_mul_ne (s X : SL2FreeProd.M2) (hs : s = 1 ∨ s = -1) (hX : X ≠ 1 ∧ X ≠ -1) :
    s * X ≠ 1 ∧ s * X ≠ -1 := by
  rcases hs with rfl | rfl
  · simpa using hX
  · constructor
    · intro h1
      rw [neg_mul, one_mul] at h1
      have : X = -1 := by
        have := congrArg Neg.neg h1
        simpa using this
      exact hX.2 this
    · intro h1
      rw [neg_mul, one_mul] at h1
      exact hX.1 (neg_inj.mp h1)

/-- **The letters extension**: a product of `±U₁`'s and `±U₂`'s followed by one letter which is
`±U₁`, `±U₂`, `±S` is never `±1`. -/
theorem letters_ext_ne_pm_one (L : List SL2FreeProd.M2)
    (hL : ∀ M ∈ L, M = SL2FreeProd.U1 ∨ M = -SL2FreeProd.U1 ∨
      M = SL2FreeProd.U2 ∨ M = -SL2FreeProd.U2)
    (last : SL2FreeProd.M2)
    (hlast : last = SL2FreeProd.U1 ∨ last = -SL2FreeProd.U1 ∨ last = SL2FreeProd.U2 ∨
      last = -SL2FreeProd.U2 ∨ last = SL2FreeProd.Sm ∨ last = -SL2FreeProd.Sm) :
    L.prod * last ≠ 1 ∧ L.prod * last ≠ -1 := by
  obtain ⟨s, m, hs, hm, _hlen, hprod⟩ :=
    SL2Conrad.prod_signed L
      (by simpa [SL2Conrad.U1, SL2Conrad.U2, SL2FreeProd.U1, SL2FreeProd.U2] using hL)
  have hkey : m.prod * last ≠ 1 ∧ m.prod * last ≠ -1 := by
    have hU : ∀ U : SL2FreeProd.M2, (U = SL2FreeProd.U1 ∨ U = SL2FreeProd.U2) →
        m.prod * U = (m ++ [U]).prod := by
      intro U _
      simp
    have hmem : ∀ U : SL2FreeProd.M2, (U = SL2FreeProd.U1 ∨ U = SL2FreeProd.U2) →
        ∀ M ∈ m ++ [U], M = SL2FreeProd.U1 ∨ M = SL2FreeProd.U2 := by
      intro U hU' M hM
      rcases List.mem_append.mp hM with hM | hM
      · exact hm M hM
      · rw [List.mem_singleton] at hM
        subst hM
        exact hU'
    have keyU : ∀ U : SL2FreeProd.M2, (U = SL2FreeProd.U1 ∨ U = SL2FreeProd.U2) →
        m.prod * U ≠ 1 ∧ m.prod * U ≠ -1 := by
      intro U hU'
      have h := SL2FreeProd.prod_ne_one_and_ne_neg_one (m ++ [U]) (hmem U hU') (by simp)
      rw [← hU U hU'] at h
      exact h
    have neg_one_mul_neg : ∀ X : SL2FreeProd.M2, (-1 : SL2FreeProd.M2) * (-X) = X := by
      intro X
      rw [neg_mul, one_mul, neg_neg]
    have keyS : m.prod * SL2FreeProd.Sm ≠ 1 ∧ m.prod * SL2FreeProd.Sm ≠ -1 := by
      constructor
      · intro h1
        have h2 : m.prod = -SL2FreeProd.Sm := by
          calc m.prod = m.prod * 1 := (mul_one _).symm
            _ = m.prod * (SL2FreeProd.Sm * -SL2FreeProd.Sm) := by rw [Sm_mul_neg_Sm]
            _ = (m.prod * SL2FreeProd.Sm) * -SL2FreeProd.Sm := by rw [mul_assoc]
            _ = 1 * -SL2FreeProd.Sm := by rw [h1]
            _ = -SL2FreeProd.Sm := one_mul _
        exact (SL2FreeProd.prod_ne_pm_Sm m hm).2 h2
      · intro h1
        have h2 : m.prod = SL2FreeProd.Sm := by
          calc m.prod = m.prod * 1 := (mul_one _).symm
            _ = m.prod * (SL2FreeProd.Sm * -SL2FreeProd.Sm) := by rw [Sm_mul_neg_Sm]
            _ = (m.prod * SL2FreeProd.Sm) * -SL2FreeProd.Sm := by rw [mul_assoc]
            _ = -1 * -SL2FreeProd.Sm := by rw [h1]
            _ = SL2FreeProd.Sm := neg_one_mul_neg _
        exact (SL2FreeProd.prod_ne_pm_Sm m hm).1 h2
    have keySneg : m.prod * (-SL2FreeProd.Sm) ≠ 1 ∧ m.prod * (-SL2FreeProd.Sm) ≠ -1 := by
      constructor
      · intro h1
        have h2 : m.prod = SL2FreeProd.Sm := by
          calc m.prod = m.prod * 1 := (mul_one _).symm
            _ = m.prod * ((-SL2FreeProd.Sm) * SL2FreeProd.Sm) := by rw [neg_Sm_mul_Sm]
            _ = (m.prod * (-SL2FreeProd.Sm)) * SL2FreeProd.Sm := by rw [mul_assoc]
            _ = 1 * SL2FreeProd.Sm := by rw [h1]
            _ = SL2FreeProd.Sm := one_mul _
        exact (SL2FreeProd.prod_ne_pm_Sm m hm).1 h2
      · intro h1
        have h2 : m.prod = -SL2FreeProd.Sm := by
          calc m.prod = m.prod * 1 := (mul_one _).symm
            _ = m.prod * ((-SL2FreeProd.Sm) * SL2FreeProd.Sm) := by rw [neg_Sm_mul_Sm]
            _ = (m.prod * (-SL2FreeProd.Sm)) * SL2FreeProd.Sm := by rw [mul_assoc]
            _ = -1 * SL2FreeProd.Sm := by rw [h1]
            _ = -SL2FreeProd.Sm := by rw [neg_mul, one_mul]
        exact (SL2FreeProd.prod_ne_pm_Sm m hm).2 h2
    rcases hlast with h | h | h | h | h | h
    · rw [h]
      exact keyU _ (Or.inl rfl)
    · rw [h]
      constructor
      · intro h1
        rw [mul_neg] at h1
        exact (keyU _ (Or.inl rfl)).2 (by
          have := congrArg Neg.neg h1
          simpa using this)
      · intro h1
        rw [mul_neg] at h1
        exact (keyU _ (Or.inl rfl)).1 (by
          have := congrArg Neg.neg h1
          simpa using this)
    · rw [h]
      exact keyU _ (Or.inr rfl)
    · rw [h]
      constructor
      · intro h1
        rw [mul_neg] at h1
        exact (keyU _ (Or.inr rfl)).2 (by
          have := congrArg Neg.neg h1
          simpa using this)
      · intro h1
        rw [mul_neg] at h1
        exact (keyU _ (Or.inr rfl)).1 (by
          have := congrArg Neg.neg h1
          simpa using this)
    · rw [h]
      exact keyS
    · rw [h]
      exact keySneg
  have hstep : (s * m.prod) * last = s * (m.prod * last) := mul_assoc s m.prod last
  rw [hprod, hstep]
  exact pm_one_mul_ne s (m.prod * last) hs hkey

/-! ### The SL(2,ℤ)-level letters extension -/

/-- The last letter `S R^z` with `z ≤ 2` is `S`, `-U₁` or `-U₂`. -/
theorem last_letter (z : ℕ) (hz : z ≤ 2) :
    ((SL2Conrad.S * SL2Conrad.R ^ z : SL2Conrad.SL2) : SL2Conrad.M2) = SL2FreeProd.Sm ∨
      ((SL2Conrad.S * SL2Conrad.R ^ z : SL2Conrad.SL2) : SL2Conrad.M2) = -SL2FreeProd.U1 ∨
      ((SL2Conrad.S * SL2Conrad.R ^ z : SL2Conrad.SL2) : SL2Conrad.M2) = -SL2FreeProd.U2 := by
  interval_cases z
  · left
    rw [pow_zero, mul_one]
    rfl
  · right; left
    simpa [pow_one, SL2Conrad.U1, SL2FreeProd.U1] using SL2Conrad.S_mul_R
  · right; right
    simpa [SL2Conrad.U2, SL2FreeProd.U2] using SL2Conrad.S_mul_R_sq

/-- **Letters extension at the level of `SL(2,ℤ)`**: the letters `S R^{i₁}, …, S R^{i_n}` of a
Conrad form with inner exponents `1` or `2` and last exponent `≤ 2` never multiply to `±1`. -/
theorem lettersSL_ext_ne_pm_one {u : List ℕ} (hu : ∀ m ∈ u, m = 1 ∨ m = 2) (z : ℕ) (hz : z ≤ 2) :
    (SL2Conrad.lettersSL (u ++ [z])).prod ≠ 1 ∧
      (SL2Conrad.lettersSL (u ++ [z])).prod ≠ -1 := by
  have hU : ∀ M ∈ letterMat u, M = SL2FreeProd.U1 ∨ M = -SL2FreeProd.U1 ∨
      M = SL2FreeProd.U2 ∨ M = -SL2FreeProd.U2 := by
    intro M hM
    simp only [letterMat, List.mem_map] at hM
    obtain ⟨m, hm, rfl⟩ := hM
    have hm' : m = 1 ∨ m = 2 ∨ m = 4 ∨ m = 5 := by
      rcases hu m hm with h | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
    have hc := SL2Conrad.letter_cases m hm'
    simpa [SL2Conrad.U1, SL2Conrad.U2, SL2FreeProd.U1, SL2FreeProd.U2] using hc
  have hlast' : ((SL2Conrad.S * SL2Conrad.R ^ z : SL2Conrad.SL2) : SL2Conrad.M2) =
        SL2FreeProd.U1 ∨
      ((SL2Conrad.S * SL2Conrad.R ^ z : SL2Conrad.SL2) : SL2Conrad.M2) = -SL2FreeProd.U1 ∨
      ((SL2Conrad.S * SL2Conrad.R ^ z : SL2Conrad.SL2) : SL2Conrad.M2) = SL2FreeProd.U2 ∨
      ((SL2Conrad.S * SL2Conrad.R ^ z : SL2Conrad.SL2) : SL2Conrad.M2) = -SL2FreeProd.U2 ∨
      ((SL2Conrad.S * SL2Conrad.R ^ z : SL2Conrad.SL2) : SL2Conrad.M2) = SL2FreeProd.Sm ∨
      ((SL2Conrad.S * SL2Conrad.R ^ z : SL2Conrad.SL2) : SL2Conrad.M2) = -SL2FreeProd.Sm := by
    rcases last_letter z hz with h | h | h
    · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  have hmat := letters_ext_ne_pm_one (letterMat u) hU _ hlast'
  have hcoe := lettersSL_coe (u ++ [z])
  have hsplit : letterMat (u ++ [z]) =
      letterMat u ++ [((SL2Conrad.S * SL2Conrad.R ^ z : SL2Conrad.SL2) : SL2Conrad.M2)] := by
    simp [letterMat, List.map_append]
  rw [hsplit, List.prod_append, List.prod_singleton] at hcoe
  constructor
  · intro h1
    exact hmat.1 (by
      rw [← hcoe]
      exact congrArg (fun g : SL2Conrad.SL2 => (g : SL2Conrad.M2)) h1)
  · intro h1
    exact hmat.2 (by
      rw [← hcoe]
      exact congrArg (fun g : SL2Conrad.SL2 => (g : SL2Conrad.M2)) h1)

/-! ### The general Conrad theorem: the first exponent may be `0` -/

/-- **Conrad's theorem for a normal form whose first exponent may be zero.** If `a ≤ 2` and `u` is a
Conrad tail, then `nfProd (a :: u) = ±1` only in the trivial case `u = []`, `a = 0`. -/
theorem conrad_tail
    (hletters : ∀ l : List ℕ, l ≠ [] → (∀ m ∈ l, m = 1 ∨ m = 2 ∨ m = 4 ∨ m = 5) →
      (SL2Conrad.lettersSL l).prod ≠ 1 ∧ (SL2Conrad.lettersSL l).prod ≠ -1)
    (a : ℕ) (ha : a ≤ 2) (u : List ℕ) (hu : SL2Conrad.IsNFtail u)
    (hne : ¬ (u = [] ∧ a = 0)) :
    SL2Conrad.nfProd (a :: u) ≠ 1 ∧ SL2Conrad.nfProd (a :: u) ≠ -1 := by
  rcases u with _ | ⟨c, _ | ⟨d, rest⟩⟩
  · have ha0 : a ≠ 0 := fun h => hne ⟨rfl, h⟩
    have hsing : SL2Conrad.nfProd (a :: ([] : List ℕ)) = SL2Conrad.R ^ a := rfl
    rw [hsing]
    interval_cases a
    · exact absurd rfl ha0
    · constructor
      · intro hcon
        rw [pow_one] at hcon
        exact SL2Conrad.R_ne_one hcon
      · intro hcon
        rw [pow_one] at hcon
        exact SL2Conrad.R_ne_neg_one hcon
    · constructor
      · exact SL2Conrad.R_sq_ne_one
      · exact SL2Conrad.R_sq_ne_neg_one
  · have hc : c ≤ 2 := hu
    have hpair : SL2Conrad.nfProd (a :: [c]) = SL2Conrad.nfProd [a, c] := rfl
    exact ⟨fun hcon => SL2Conrad.nfProd_len_two a c ha hc (by rw [← hpair]; exact Or.inl hcon),
      fun hcon => SL2Conrad.nfProd_len_two a c ha hc (by rw [← hpair]; exact Or.inr hcon)⟩
  · have hu' : SL2Conrad.IsNFtail (c :: d :: rest) := hu
    have hlen2 : 1 < (c :: d :: rest).length := by simp
    have hinit_ne : SL2Conrad.init (c :: d :: rest) ≠ [] := by
      rw [SL2Conrad.init_cons_cons]
      simp
    have hInitNF : SL2Conrad.IsNFtail (SL2Conrad.init (c :: d :: rest)) :=
      (SL2Conrad.isNFtail_init hu' hlen2).1
    have hInit0 : SL2Conrad.init (c :: d :: rest) ≠ [0] := by
      intro hcon'
      have hmem : (0 : ℕ) ∈ SL2Conrad.init (c :: d :: rest) := by rw [hcon']; simp
      rcases (SL2Conrad.isNFtail_init hu' hlen2).2 0 hmem with h | h <;> omega
    have hIH := SL2Conrad.nfProd_ne_pm_one_aux hletters
      (SL2Conrad.init (c :: d :: rest)).length (SL2Conrad.init (c :: d :: rest))
      le_rfl hInitNF hInit0
    have hletterCase : ∀ (ε : SL2Conrad.SL2), ε = 1 ∨ ε = -1 →
        SL2Conrad.nfProd (0 :: (c :: d :: rest)) = ε → False := by
      intro ε hε hcon
      obtain ⟨z, hz⟩ := SL2Conrad.eq_init_append_last (c :: d :: rest) (by simp)
      have hentries : ∀ m ∈ SL2Conrad.init (c :: d :: rest), m = 1 ∨ m = 2 :=
        (SL2Conrad.isNFtail_init hu' hlen2).2
      have hzmem : z ∈ (c :: d :: rest) := by rw [hz]; simp
      have hz2 : z ≤ 2 := SL2Conrad.isNFtail_le_two hu' z hzmem
      have hext := lettersSL_ext_ne_pm_one hentries z hz2
      have hnf : SL2Conrad.nfProd (0 :: (c :: d :: rest)) =
          (SL2Conrad.lettersSL (c :: d :: rest)).prod := by
        rw [SL2Conrad.nfProd_cons_cons 0 (by simp),
          mul_assoc (SL2Conrad.R ^ 0) SL2Conrad.S _,
          SL2Conrad.S_mul_nfProd _ (by simp), pow_zero, one_mul]
      rw [hnf, hz] at hcon
      rcases hε with hε | hε <;> rw [hε] at hcon
      · exact hext.1 hcon
      · exact hext.2 hcon
    constructor <;> intro hcon
    · by_cases ha0 : a = 0
      · exact hletterCase 1 (Or.inl rfl) (by rw [← ha0]; exact hcon)
      · have ha12 : a = 1 ∨ a = 2 := by omega
        have h := hcon
        rw [SL2Conrad.nfProd_cons_cons a (by simp), mul_assoc (SL2Conrad.R ^ a) SL2Conrad.S
          (SL2Conrad.nfProd (c :: d :: rest)), SL2Conrad.S_mul_nfProd _ (by simp)] at h
        exact SL2Conrad.nfProd_ne_pm_one_step (hb := ha12) (htail := hu')
          hletters hinit_ne hIH (Or.inl h)
    · by_cases ha0 : a = 0
      · exact hletterCase (-1) (Or.inr rfl) (by rw [← ha0]; exact hcon)
      · have ha12 : a = 1 ∨ a = 2 := by omega
        have h := hcon
        rw [SL2Conrad.nfProd_cons_cons a (by simp), mul_assoc (SL2Conrad.R ^ a) SL2Conrad.S
          (SL2Conrad.nfProd (c :: d :: rest)), SL2Conrad.S_mul_nfProd _ (by simp)] at h
        exact SL2Conrad.nfProd_ne_pm_one_step (hb := ha12) (htail := hu')
          hletters hinit_ne hIH (Or.inr h)

/-! ### The change of generators, and the append lemma

The mission's reduced Burau generators at `t = -1` are
`A = !![1,-1;0,1] = R⁻¹ S` and `B = !![2,-1;1,0] = S R S R S` (found by a breadth-first search over
words in `S`, `R`; `R⁻¹ = R⁵` since `R⁶ = 1`). The append lemma is the reduction step "multiply by
`S`": appending an exponent inserts an `S`. -/

theorem A_as_word :
    ((SL2Conrad.R ^ 5 * SL2Conrad.S : SL2Conrad.SL2) : SL2Conrad.M2) = !![1, -1; 0, 1] := by
  decide

theorem B_as_word :
    ((SL2Conrad.S * SL2Conrad.R * SL2Conrad.S * SL2Conrad.R * SL2Conrad.S : SL2Conrad.SL2) :
      SL2Conrad.M2) = !![2, -1; 1, 0] := by
  decide

/-- **Append lemma**: appending an exponent to a normal form inserts an `S` and a new last letter. -/
theorem nfProd_append_singleton : ∀ (t : List ℕ) (b : ℕ), t ≠ [] →
    SL2Conrad.nfProd (t ++ [b]) = SL2Conrad.nfProd t * SL2Conrad.S * SL2Conrad.R ^ b
  | [], b, h => absurd rfl h
  | [_], b, _ => by simp [SL2Conrad.nfProd]
  | x :: y :: rest, b, _ => by
      have h1 : ((y :: rest) ++ [b]) ≠ [] := by simp
      have ih := nfProd_append_singleton (y :: rest) b (by simp)
      rw [show x :: y :: rest ++ [b] = x :: ((y :: rest) ++ [b]) from rfl]
      rw [SL2Conrad.nfProd_cons_cons x h1, ih,
        SL2Conrad.nfProd_cons_cons x (by simp : (y :: rest) ≠ [])]
      simp only [mul_assoc]

/-! ### The reduction algorithm: state and its `R`-step

A state is `(b, t)`, representing `sg b * nfProd t` where `sg true = S² = -1` and `sg false = 1`.
The invariant is that no inner exponent of `t` is `0`. Multiplying by `R` increments the last
exponent, using `R³ = S²` when it would reach `3`; multiplying by `S` appends a `0`, cancelling with
the relation when the last exponent is already `0`. -/

/-- The last exponent. -/
def last : List ℕ → ℕ
  | [] => 0
  | [b] => b
  | _ :: rest => last rest

theorem last_cons_cons (b c : ℕ) (rest : List ℕ) : last (b :: c :: rest) = last (c :: rest) := rfl

theorem init_append_last : ∀ t : List ℕ, t ≠ [] → t = SL2Conrad.init t ++ [last t]
  | [], h => absurd rfl h
  | [b], _ => by simp [SL2Conrad.init, last]
  | b :: c :: rest, _ => by
      have ih := init_append_last (c :: rest) (by simp)
      rw [SL2Conrad.init_cons_cons, last_cons_cons, List.cons_append]
      conv_lhs => rw [ih]

/-- The sign of a state: `true` means an extra factor `S² = -1`. -/
def sg (b : Bool) : SL2Conrad.SL2 := if b then SL2Conrad.S ^ 2 else 1

/-- The `R`-step on the sign-free core, by recursion on the exponent list: increment the last
exponent; `R² * R = R³ = S²` sets the sign to `true` and normalises the last exponent to `0`. -/
def mulRCore : List ℕ → Bool × List ℕ
  | [] => (false, [1])
  | [z] => if z = 2 then (true, [0]) else (false, [z + 1])
  | z :: rest => ((mulRCore rest).1, z :: (mulRCore rest).2)

/-- Multiply a state by `R`. -/
def mulR (st : Bool × List ℕ) : Bool × List ℕ :=
  ((mulRCore st.2).1 != st.1, (mulRCore st.2).2)

/-- Multiply a state by `S`. -/
def mulS (st : Bool × List ℕ) : Bool × List ℕ :=
  if st.2 = [] then (st.1, [0, 0])
  else if last st.2 = 0 then
    (if SL2Conrad.init st.2 = [] then (st.1, [0, 0]) else (!st.1, SL2Conrad.init st.2))
  else (st.1, st.2 ++ [0])

theorem sg_true : sg true = SL2Conrad.S ^ 2 := rfl

theorem sg_false : sg false = 1 := rfl

theorem negOne_central_SL2 (X : SL2Conrad.SL2) :
    (-1 : SL2Conrad.SL2) * X = X * (-1 : SL2Conrad.SL2) := SL2Conrad.negOne_central X

/-- `S²` is central. -/
theorem S_sq_central (X : SL2Conrad.SL2) :
    X * SL2Conrad.S ^ 2 = SL2Conrad.S ^ 2 * X := by
  have h := negOne_central_SL2 X
  rw [← SL2Conrad.S_sq] at h
  exact h.symm

/-- Every sign `sg c` is central. -/
theorem sg_central (c : Bool) (X : SL2Conrad.SL2) : X * sg c = sg c * X := by
  cases c
  · simp [sg]
  · simpa [sg] using S_sq_central X

theorem mul_sg_mul (c : Bool) (X Y : SL2Conrad.SL2) : X * (sg c * Y) = sg c * (X * Y) := by
  rw [← mul_assoc, sg_central c X, mul_assoc]

theorem sg_bne (b c : Bool) : sg (b != c) = sg b * sg c := by
  cases b <;> cases c <;> decide

theorem sg_comm (b c : Bool) : sg b * sg c = sg c * sg b := by
  cases b <;> cases c <;> decide

theorem mulRCore_snd_ne_nil : ∀ t : List ℕ, (mulRCore t).2 ≠ []
  | [] => by simp [mulRCore]
  | z :: rest => by
      cases rest with
      | nil => by_cases hz : z = 2 <;> simp [mulRCore, hz]
      | cons y t =>
          simp only [mulRCore]
          exact List.cons_ne_nil _ _

/-- **Correctness of the `R`-step** (sign-free core). -/
theorem mulRCore_spec : ∀ t : List ℕ,
    SL2Conrad.nfProd t * SL2Conrad.R
      = sg (mulRCore t).1 * SL2Conrad.nfProd (mulRCore t).2
  | [] => by simp [mulRCore, sg, SL2Conrad.nfProd]
  | [z] => by
      rw [SL2Conrad.nfProd]
      by_cases hz : z = 2
      · subst hz
        rw [show SL2Conrad.R ^ (2 : ℕ) = SL2Conrad.R ^ 2 from rfl]
        have hstep : SL2Conrad.R ^ 2 * SL2Conrad.R = SL2Conrad.S ^ 2 := by
          rw [← pow_succ, show (2 + 1 : ℕ) = 3 by norm_num, SL2Conrad.R_cube, ← SL2Conrad.S_sq]
        rw [hstep]
        simp [mulRCore, sg, SL2Conrad.nfProd]
      · have hstep : SL2Conrad.R ^ z * SL2Conrad.R = SL2Conrad.R ^ (z + 1) := by
          rw [← pow_succ]
        rw [hstep]
        simp [mulRCore, hz, sg, SL2Conrad.nfProd]
  | z :: y :: rest => by
      have ih := mulRCore_spec (y :: rest)
      have hne : (mulRCore (y :: rest)).2 ≠ [] := mulRCore_snd_ne_nil (y :: rest)
      rw [show SL2Conrad.nfProd (z :: y :: rest) * SL2Conrad.R
            = SL2Conrad.R ^ z * SL2Conrad.S
              * (SL2Conrad.nfProd (y :: rest) * SL2Conrad.R) by
          rw [SL2Conrad.nfProd_cons_cons z (by simp)]
          simp only [mul_assoc]]
      rw [ih]
      simp only [mulRCore, mul_assoc]
      rw [mul_sg_mul (mulRCore (y :: rest)).1 SL2Conrad.S
        (SL2Conrad.nfProd (mulRCore (y :: rest)).2)]
      rw [mul_sg_mul (mulRCore (y :: rest)).1 (SL2Conrad.R ^ z)
        (SL2Conrad.S * SL2Conrad.nfProd (mulRCore (y :: rest)).2)]
      have hcons : SL2Conrad.nfProd (z :: (mulRCore (y :: rest)).2)
          = SL2Conrad.R ^ z * (SL2Conrad.S * SL2Conrad.nfProd (mulRCore (y :: rest)).2) := by
        rw [SL2Conrad.nfProd_cons_cons z hne, mul_assoc]
      rw [hcons]

/-- **The `R`-step multiplies by `R` on the right.** -/
theorem mulR_spec (b : Bool) (t : List ℕ) :
    sg b * SL2Conrad.nfProd t * SL2Conrad.R
      = sg (mulR (b, t)).1 * SL2Conrad.nfProd (mulR (b, t)).2 := by
  have hcore := mulRCore_spec t
  simp only [mulR]
  rw [mul_assoc, hcore, sg_bne, sg_comm, mul_assoc]

/-! ### The reduced-word state for the word criterion

A state is `(b, w)`: the sign `sg b` and a word `w` in the letters `x = S` (order 2) and `y^i = R^i`
(order 3), reduced so that adjacent equal letters never occur and no `y^0` occurs. Multiplying by
`x` appends `x`, cancelling `x²` with a sign (since `S² = -1 = R³` in `SL(2,ℤ)`); multiplying by `y`
increments the last `y`-power, cancelling `y³` with the same sign. The point of this representation
(rather than exponent lists) is that both operations are *structural* on the word, so their
correctness proofs are structural inductions. -/

/-- The letters `x = S` and `y^i = R^i`. -/
inductive Let : Type
  | x : Let
  | y : ℕ → Let
  deriving DecidableEq

namespace Let

/-- Evaluate a letter in `SL(2,ℤ)`. -/
def ev : Let → SL2Conrad.SL2
  | .x => SL2Conrad.S
  | .y i => SL2Conrad.R ^ i

end Let

/-- A state: a sign and a word of letters. -/
abbrev St := Bool × List Let

/-- Evaluate a state. -/
def St.ev (st : St) : SL2Conrad.SL2 := sg st.1 * (st.2.map Let.ev).prod

/-- Multiply a reduced word by `x = S`, by recursion on the word. -/
def mulXCore : List Let → Bool × List Let
  | [] => (false, [Let.x])
  | [a] => match a with
    | Let.x => (true, [])
    | Let.y i => (false, [Let.y i, Let.x])
  | a :: b :: rest => ((mulXCore (b :: rest)).1, a :: (mulXCore (b :: rest)).2)

/-- Multiply a state by `S`. -/
def mulX (st : St) : St := ((mulXCore st.2).1 != st.1, (mulXCore st.2).2)

/-- **The `x`-step at the level of the evaluated product** (sign-free core). -/
theorem mulXCore_spec : ∀ w : List Let,
    (w.map Let.ev).prod * SL2Conrad.S
      = sg (mulXCore w).1 * ((mulXCore w).2.map Let.ev).prod
  | [] => by simp [mulXCore, sg, Let.ev]
  | [a] => by
      cases a with
      | x =>
          simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one, Let.ev]
          rw [← pow_two]
          simp [mulXCore, sg]
      | y i =>
          simp [mulXCore, sg, Let.ev]
  | a :: b :: rest => by
      have ih := mulXCore_spec (b :: rest)
      rw [show (List.map Let.ev (a :: b :: rest)).prod
            = Let.ev a * (List.map Let.ev (b :: rest)).prod by
          simp [List.prod_cons]]
      rw [mul_assoc, ih]
      simp only [mulXCore]
      rw [mul_sg_mul (mulXCore (b :: rest)).1 (Let.ev a)
        ((mulXCore (b :: rest)).2.map Let.ev).prod]
      rw [show (List.map Let.ev (a :: (mulXCore (b :: rest)).2)).prod
            = Let.ev a * (List.map Let.ev (mulXCore (b :: rest)).2).prod by
          simp [List.prod_cons]]

/-- **The `S`-step multiplies by `S` on the right.** -/
theorem mulX_spec (b : Bool) (w : List Let) :
    sg b * (w.map Let.ev).prod * SL2Conrad.S
      = St.ev (mulX (b, w)) := by
  have hcore := mulXCore_spec w
  simp only [mulX, St.ev]
  rw [mul_assoc, hcore, sg_bne, sg_comm, mul_assoc]

/-- Multiply a reduced word by `y = R`, by recursion on the word. -/
def mulYCore : List Let → Bool × List Let
  | [] => (false, [Let.y 1])
  | [a] => match a with
    | Let.x => (false, [Let.x, Let.y 1])
    | Let.y i => if i = 2 then (true, []) else (false, [Let.y (i + 1)])
  | a :: b :: rest => ((mulYCore (b :: rest)).1, a :: (mulYCore (b :: rest)).2)

/-- Multiply a state by `R`. -/
def mulY (st : St) : St := ((mulYCore st.2).1 != st.1, (mulYCore st.2).2)

/-- **The `y`-step at the level of the evaluated product** (sign-free core). -/
theorem mulYCore_spec : ∀ w : List Let,
    (w.map Let.ev).prod * SL2Conrad.R
      = sg (mulYCore w).1 * ((mulYCore w).2.map Let.ev).prod
  | [] => by simp [mulYCore, sg, Let.ev, SL2Conrad.nfProd]
  | [a] => by
      cases a with
      | x => simp [mulYCore, sg, Let.ev]
      | y i =>
          by_cases hi : i = 2
          · subst hi
            simp only [mulYCore, if_pos rfl, List.map_cons, List.map_nil, List.prod_cons,
              List.prod_nil, mul_one, Let.ev]
            rw [show SL2Conrad.R ^ 2 * SL2Conrad.R = SL2Conrad.S ^ 2 by
              rw [← pow_succ, show (2 + 1 : ℕ) = 3 by norm_num, SL2Conrad.R_cube,
                ← SL2Conrad.S_sq]]
            simp [sg]
          · simp only [mulYCore, if_neg hi, List.map_cons, List.map_nil, List.prod_cons,
              List.prod_nil, mul_one, Let.ev]
            rw [← pow_succ]
            simp [sg]
  | a :: b :: rest => by
      have ih := mulYCore_spec (b :: rest)
      rw [show (List.map Let.ev (a :: b :: rest)).prod
            = Let.ev a * (List.map Let.ev (b :: rest)).prod by
          simp [List.prod_cons]]
      rw [mul_assoc, ih]
      simp only [mulYCore]
      rw [mul_sg_mul (mulYCore (b :: rest)).1 (Let.ev a)
        ((mulYCore (b :: rest)).2.map Let.ev).prod]
      rw [show (List.map Let.ev (a :: (mulYCore (b :: rest)).2)).prod
            = Let.ev a * (List.map Let.ev (mulYCore (b :: rest)).2).prod by
          simp [List.prod_cons]]

/-- **The `R`-step multiplies by `R` on the right.** -/
theorem mulY_spec (b : Bool) (w : List Let) :
    sg b * (w.map Let.ev).prod * SL2Conrad.R
      = St.ev (mulY (b, w)) := by
  have hcore := mulYCore_spec w
  simp only [mulY, St.ev]
  rw [mul_assoc, hcore, sg_bne, sg_comm, mul_assoc]

theorem mulX_spec' (st : St) : (mulX st).ev = st.ev * SL2Conrad.S := (mulX_spec st.1 st.2).symm

theorem mulY_spec' (st : St) : (mulY st).ev = st.ev * SL2Conrad.R := (mulY_spec st.1 st.2).symm

theorem mul_S_cube (X : SL2Conrad.SL2) :
    X * SL2Conrad.S * SL2Conrad.S * SL2Conrad.S = X * SL2Conrad.S ^ 3 := by
  rw [show (3 : ℕ) = 2 + 1 by norm_num, pow_add, pow_two]
  simp only [mul_assoc, pow_one]

theorem mul_R_pow_five (X : SL2Conrad.SL2) :
    X * SL2Conrad.R * SL2Conrad.R * SL2Conrad.R * SL2Conrad.R * SL2Conrad.R
      = X * SL2Conrad.R ^ 5 := by
  rw [show (5 : ℕ) = 4 + 1 by norm_num, pow_add, show (4 : ℕ) = 3 + 1 by norm_num, pow_add,
    show (3 : ℕ) = 2 + 1 by norm_num, pow_add, pow_two]
  simp only [mul_assoc, pow_one]

/-- The generator `(0, false) = S`, `(0, true) = S⁻¹ = S³`, `(1, false) = R`, `(1, true) = R⁻¹ = R⁵`
evaluated in `SL(2,ℤ)`. -/
def genEv (g : Fin 2 × Bool) : SL2Conrad.SL2 :=
  if g.1 = 0 then (if g.2 then SL2Conrad.S ^ 3 else SL2Conrad.S)
  else (if g.2 then SL2Conrad.R ^ 5 else SL2Conrad.R)

/-- One step of the reduction (`S⁻¹ = S³`, `R⁻¹ = R⁵`). -/
def step (st : St) (g : Fin 2 × Bool) : St :=
  if g.1 = 0 then (if g.2 then mulX (mulX (mulX st)) else mulX st)
  else (if g.2 then mulY (mulY (mulY (mulY (mulY st)))) else mulY st)

/-- Fold the reduction over a word. -/
def reduce (st : St) (w : List (Fin 2 × Bool)) : St := w.foldl step st

/-- **One step multiplies the evaluated element by the generator.** -/
theorem step_spec (st : St) (g : Fin 2 × Bool) :
    (step st g).ev = st.ev * genEv g := by
  unfold step genEv
  split_ifs with h1 h2
  · rw [mulX_spec', mulX_spec', mulX_spec']
    exact mul_S_cube st.ev
  · rw [mulX_spec']
  · rw [mulY_spec', mulY_spec', mulY_spec', mulY_spec', mulY_spec']
    exact mul_R_pow_five st.ev
  · rw [mulY_spec']

/-- **The fold multiplies by the product of the generators.** -/
theorem reduce_spec (st : St) (w : List (Fin 2 × Bool)) :
    (reduce st w).ev = st.ev * (w.map genEv).prod := by
  induction w generalizing st with
  | nil => simp [reduce]
  | cons g w ih =>
      rw [show reduce st (g :: w) = reduce (step st g) w by simp [reduce], ih, step_spec,
        List.map_cons, List.prod_cons, mul_assoc]

/-! ### The presentation `⟨S, R | S⁴ = 1, R³ = S²⟩` and the state-to-word bridge -/

/-- The relators for `S` (index `0`) and `R` (index `1`): `S⁴` and `R³S²` (the latter expresses
`R³ = S²`, since `(S²)² = 1`). -/
def relsSR : Set (FreeGroup (Fin 2)) :=
  {FreeGroup.of 0 ^ 4, FreeGroup.of 1 ^ 3 * FreeGroup.of 0 ^ 2}

/-- The assignment `0 ↦ S`, `1 ↦ R`. -/
def genSR : Fin 2 → SL2Conrad.SL2 := fun i => if i = 0 then SL2Conrad.S else SL2Conrad.R

theorem genSR_zero : genSR 0 = SL2Conrad.S := rfl

theorem genSR_one : genSR 1 = SL2Conrad.R := rfl

theorem relsSR_lift : ∀ r ∈ relsSR, FreeGroup.lift genSR r = 1 := by
  intro r hr
  simp only [relsSR, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · rw [map_pow, FreeGroup.lift_apply_of, genSR_zero]
    exact SL2Conrad.S_pow_four
  · rw [_root_.map_mul, _root_.map_pow, _root_.map_pow, FreeGroup.lift_apply_of,
      FreeGroup.lift_apply_of, genSR_zero, genSR_one, SL2Conrad.R_cube, SL2Conrad.S_sq]
    simp

/-- The canonical map `⟨S, R | S⁴ = 1, R³ = S²⟩ → SL(2,ℤ)`. -/
noncomputable def φSR : PresentedGroup relsSR →* SL2Conrad.SL2 :=
  PresentedGroup.toGroup relsSR_lift

/-- **`S² = R³` in the presented group.** -/
theorem mk_SS_eq_mk_R3 :
    PresentedGroup.mk relsSR (FreeGroup.of 0 ^ 2)
      = PresentedGroup.mk relsSR (FreeGroup.of 1 ^ 3) := by
  have hmem1 : FreeGroup.of 0 ^ 4 ∈ relsSR := by simp [relsSR]
  have hmem2 : FreeGroup.of 1 ^ 3 * FreeGroup.of 0 ^ 2 ∈ relsSR := by simp [relsSR]
  have hkey : (FreeGroup.of 0 ^ 2 : FreeGroup (Fin 2)) * (FreeGroup.of 1 ^ 3)⁻¹
      = FreeGroup.of 0 ^ 4 * (FreeGroup.of 1 ^ 3 * FreeGroup.of 0 ^ 2)⁻¹ := by
    rw [_root_.mul_inv_rev]
    group
  have hmem : (FreeGroup.of 0 ^ 2) * (FreeGroup.of 1 ^ 3)⁻¹
      ∈ Subgroup.normalClosure relsSR := by
    rw [hkey]
    exact Subgroup.mul_mem _ (Subgroup.subset_normalClosure hmem1)
      (Subgroup.inv_mem _ (Subgroup.subset_normalClosure hmem2))
  have h1 : PresentedGroup.mk relsSR ((FreeGroup.of 0 ^ 2) * (FreeGroup.of 1 ^ 3)⁻¹) = 1 :=
    PresentedGroup.mk_eq_one_iff.mpr hmem
  rw [map_mul, map_inv] at h1
  exact mul_inv_eq_one.mp h1

/-- The word in the free group on `S, R` of a letter. -/
def Let.w : Let → FreeGroup (Fin 2)
  | .x => FreeGroup.of 0
  | .y i => FreeGroup.of 1 ^ i

/-- The sign word `R³` for `true` and `1` for `false`, as a name (so that the `if` never appears
syntactically in the statements below). -/
def sgnPow (c : Bool) : FreeGroup (Fin 2) := FreeGroup.of 1 ^ (if c then 3 else 0)

theorem sgnPow_true : sgnPow true = FreeGroup.of 1 ^ 3 := rfl

theorem sgnPow_false : sgnPow false = 1 := rfl

/-- The word of a state: the letters, then the sign as `R³` (= `S²`) at the right end. -/
def St.w (st : St) : FreeGroup (Fin 2) :=
  (st.2.map Let.w).prod * sgnPow st.1

/-- **`R⁶ = 1` in the presented group** (so the sign, tracked mod 2, is well defined). -/
theorem mk_of1_pow_six : PresentedGroup.mk relsSR (FreeGroup.of 1 ^ 6) = 1 := by
  have h1 : (FreeGroup.of 1 ^ 6 : FreeGroup (Fin 2)) = (FreeGroup.of 1 ^ 3) ^ 2 := by
    rw [show (6 : ℕ) = 3 * 2 by norm_num, pow_mul]
  rw [h1, map_pow]
  rw [show PresentedGroup.mk relsSR (FreeGroup.of 1 ^ 3)
      = PresentedGroup.mk relsSR (FreeGroup.of 0 ^ 2) from mk_SS_eq_mk_R3.symm]
  rw [← map_pow]
  rw [show (FreeGroup.of 0 ^ 2 : FreeGroup (Fin 2)) ^ 2 = FreeGroup.of 0 ^ 4 by
    rw [show (4 : ℕ) = 2 * 2 by norm_num, pow_mul]]
  rw [PresentedGroup.mk_eq_one_iff]
  exact Subgroup.subset_normalClosure (by simp [relsSR])

/-- The word of a generator step, matching `genEv`. -/
def genWord (g : Fin 2 × Bool) : FreeGroup (Fin 2) :=
  if g.1 = 0 then (if g.2 then FreeGroup.of 0 ^ 3 else FreeGroup.of 0)
  else (if g.2 then FreeGroup.of 1 ^ 5 else FreeGroup.of 1)

/-! ### The H-level version of the reduction steps

With the sign at the *right* end of the state word, the induction mirrors `mulXCore` exactly: the
only relation used is `S² = R³` (`mk_SS_eq_mk_R3`). -/

theorem Let.w_x : Let.w Let.x = FreeGroup.of 0 := rfl

theorem Let.w_y (i : ℕ) : Let.w (Let.y i) = FreeGroup.of 1 ^ i := rfl

/-- **The `x`-step at the level of the presented group** (sign-free core). -/
theorem mulXCore_w : ∀ w : List Let,
    PresentedGroup.mk relsSR ((w.map Let.w).prod * FreeGroup.of 0)
      = PresentedGroup.mk relsSR (((mulXCore w).2).map Let.w).prod
        * PresentedGroup.mk relsSR (sgnPow (mulXCore w).1)
  | [] => by simp [mulXCore, sgnPow, Let.w_x]
  | [a] => by
      cases a with
      | x =>
          have h : PresentedGroup.mk relsSR (FreeGroup.of 0 * FreeGroup.of 0)
              = PresentedGroup.mk relsSR (FreeGroup.of 1 ^ 3) := by
            rw [show FreeGroup.of 0 * FreeGroup.of 0 = (FreeGroup.of 0 : FreeGroup (Fin 2)) ^ 2 by
              rw [pow_two]]
            exact mk_SS_eq_mk_R3
          rw [show mulXCore [Let.x] = (true, ([] : List Let)) from rfl]
          simp only [List.map_nil, List.prod_nil, mul_one, map_one, sgnPow_true]
          exact h
      | y i =>
          rw [show mulXCore [Let.y i] = (false, [Let.y i, Let.x]) from rfl]
          simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
            map_one, one_mul, Let.w_x, Let.w_y, sgnPow_false, map_mul]
  | a :: b :: rest => by
      have ih := mulXCore_w (b :: rest)
      simp only [List.map_cons, List.prod_cons, map_mul, mul_assoc] at ih
      simp only [mulXCore, List.map_cons, List.prod_cons, map_mul, mul_assoc]
      rw [ih]

theorem of1_pow_succ (i : ℕ) :
    (FreeGroup.of 1 ^ i * FreeGroup.of 1 : FreeGroup (Fin 2)) = FreeGroup.of 1 ^ (i + 1) := by
  rw [pow_succ]

/-- **The `y`-step at the level of the presented group** (sign-free core). -/
theorem mulYCore_w : ∀ w : List Let,
    PresentedGroup.mk relsSR ((w.map Let.w).prod * FreeGroup.of 1)
      = PresentedGroup.mk relsSR (((mulYCore w).2).map Let.w).prod
        * PresentedGroup.mk relsSR (sgnPow (mulYCore w).1)
  | [] => by simp [mulYCore, sgnPow, Let.w_y, pow_one]
  | [a] => by
      cases a with
      | x => simp [mulYCore, sgnPow, Let.w_x, Let.w_y, map_mul, of1_pow_succ]
      | y i =>
          by_cases hi : i = 2
          · subst hi
            simp [mulYCore, sgnPow, Let.w_y, of1_pow_succ]
          · simp [mulYCore, sgnPow, Let.w_y, hi, of1_pow_succ]
  | a :: b :: rest => by
      have ih := mulYCore_w (b :: rest)
      simp only [List.map_cons, List.prod_cons, map_mul, mul_assoc] at ih
      simp only [mulYCore, List.map_cons, List.prod_cons, map_mul, mul_assoc]
      rw [ih]

/-- **`R³` commutes with `S`** in the presented group: both products equal `S³`, since `R³ = S²`. -/
theorem mk_R3_mul_of0 :
    PresentedGroup.mk relsSR (FreeGroup.of 1 ^ 3 * FreeGroup.of 0)
      = PresentedGroup.mk relsSR (FreeGroup.of 0 * FreeGroup.of 1 ^ 3) := by
  have h1 : PresentedGroup.mk relsSR (FreeGroup.of 1 ^ 3 * FreeGroup.of 0)
      = PresentedGroup.mk relsSR (FreeGroup.of 0 ^ 2 * FreeGroup.of 0) := by
    rw [map_mul, map_mul, ← mk_SS_eq_mk_R3]
  have h2 : PresentedGroup.mk relsSR (FreeGroup.of 0 * FreeGroup.of 1 ^ 3)
      = PresentedGroup.mk relsSR (FreeGroup.of 0 * FreeGroup.of 0 ^ 2) := by
    rw [map_mul, map_mul, ← mk_SS_eq_mk_R3]
  have h3 : (FreeGroup.of 0 ^ 2 * FreeGroup.of 0 : FreeGroup (Fin 2))
      = FreeGroup.of 0 ^ 3 := by
    calc (FreeGroup.of 0 : FreeGroup (Fin 2)) ^ 2 * FreeGroup.of 0
        = FreeGroup.of 0 ^ (2 + 1) := (pow_succ _ 2).symm
      _ = FreeGroup.of 0 ^ 3 := by norm_num
  have h4 : (FreeGroup.of 0 * FreeGroup.of 0 ^ 2 : FreeGroup (Fin 2))
      = FreeGroup.of 0 ^ 3 := by
    calc (FreeGroup.of 0 : FreeGroup (Fin 2)) * FreeGroup.of 0 ^ 2
        = FreeGroup.of 0 ^ 1 * FreeGroup.of 0 ^ 2 := by rw [pow_one]
      _ = FreeGroup.of 0 ^ (1 + 2) := (pow_add _ _ _).symm
      _ = FreeGroup.of 0 ^ 3 := by norm_num
  rw [h1, h2, h3, h4]

/-- **`R³` commutes with `R`** in the presented group. -/
theorem mk_R3_mul_of1 :
    PresentedGroup.mk relsSR (FreeGroup.of 1 ^ 3 * FreeGroup.of 1)
      = PresentedGroup.mk relsSR (FreeGroup.of 1 * FreeGroup.of 1 ^ 3) := by
  have h1 : (FreeGroup.of 1 ^ 3 * FreeGroup.of 1 : FreeGroup (Fin 2))
      = FreeGroup.of 1 ^ 4 := by
    calc (FreeGroup.of 1 : FreeGroup (Fin 2)) ^ 3 * FreeGroup.of 1
        = FreeGroup.of 1 ^ (3 + 1) := (pow_succ _ 3).symm
      _ = FreeGroup.of 1 ^ 4 := by norm_num
  have h2 : (FreeGroup.of 1 * FreeGroup.of 1 ^ 3 : FreeGroup (Fin 2))
      = FreeGroup.of 1 ^ 4 := by
    calc (FreeGroup.of 1 : FreeGroup (Fin 2)) * FreeGroup.of 1 ^ 3
        = FreeGroup.of 1 ^ 1 * FreeGroup.of 1 ^ 3 := by rw [pow_one]
      _ = FreeGroup.of 1 ^ (1 + 3) := (pow_add _ _ _).symm
      _ = FreeGroup.of 1 ^ 4 := by norm_num
  rw [h1, h2]

/-- `sgnPow c` commutes with `S` in the presented group. -/
theorem mk_sgnPow_mul_of0 (c : Bool) :
    PresentedGroup.mk relsSR (sgnPow c * FreeGroup.of 0)
      = PresentedGroup.mk relsSR (FreeGroup.of 0 * sgnPow c) := by
  cases c
  · simp [sgnPow]
  · simpa [sgnPow] using mk_R3_mul_of0

/-- `sgnPow c` commutes with `R` in the presented group. -/
theorem mk_sgnPow_mul_of1 (c : Bool) :
    PresentedGroup.mk relsSR (sgnPow c * FreeGroup.of 1)
      = PresentedGroup.mk relsSR (FreeGroup.of 1 * sgnPow c) := by
  cases c
  · simp [sgnPow]
  · simpa [sgnPow] using mk_R3_mul_of1

/-- The product of two signs is the sign of the exclusive or (the sign has order `2` in `H`). -/
theorem mk_sgnPow_mul_sgnPow (b c : Bool) :
    PresentedGroup.mk relsSR (sgnPow c * sgnPow b)
      = PresentedGroup.mk relsSR (sgnPow (b != c)) := by
  cases b <;> cases c
  · simp [sgnPow]
  · simp [sgnPow]
  · simp [sgnPow]
  · simp only [sgnPow, Bool.true_bne, Bool.not_true, Bool.false_eq_true, reduceIte, pow_zero,
      show (FreeGroup.of 1 ^ 3 * FreeGroup.of 1 ^ 3 : FreeGroup (Fin 2))
        = FreeGroup.of 1 ^ 6 by
        rw [← pow_add],
      mk_of1_pow_six, map_one]

/-- `!=` is symmetric. -/
theorem bne_comm (a b : Bool) : (a != b) = (b != a) := by
  cases a <;> cases b <;> rfl

/-- Contextual form: a sign can be moved past `S` even inside a longer word. -/
theorem mk_mul_sgnPow_mul_of0 (X : FreeGroup (Fin 2)) (c : Bool) :
    PresentedGroup.mk relsSR (X * sgnPow c * FreeGroup.of 0)
      = PresentedGroup.mk relsSR (X * FreeGroup.of 0 * sgnPow c) := by
  calc PresentedGroup.mk relsSR (X * sgnPow c * FreeGroup.of 0)
      = PresentedGroup.mk relsSR X
        * PresentedGroup.mk relsSR (sgnPow c * FreeGroup.of 0) := by
        rw [mul_assoc, map_mul]
    _ = PresentedGroup.mk relsSR X
        * PresentedGroup.mk relsSR (FreeGroup.of 0 * sgnPow c) := by
        rw [mk_sgnPow_mul_of0]
    _ = PresentedGroup.mk relsSR (X * FreeGroup.of 0 * sgnPow c) := by
        rw [← map_mul]
        congr 1
        rw [mul_assoc]

/-- Contextual form: a sign can be moved past `R` even inside a longer word. -/
theorem mk_mul_sgnPow_mul_of1 (X : FreeGroup (Fin 2)) (c : Bool) :
    PresentedGroup.mk relsSR (X * sgnPow c * FreeGroup.of 1)
      = PresentedGroup.mk relsSR (X * FreeGroup.of 1 * sgnPow c) := by
  calc PresentedGroup.mk relsSR (X * sgnPow c * FreeGroup.of 1)
      = PresentedGroup.mk relsSR X
        * PresentedGroup.mk relsSR (sgnPow c * FreeGroup.of 1) := by
        rw [mul_assoc, map_mul]
    _ = PresentedGroup.mk relsSR X
        * PresentedGroup.mk relsSR (FreeGroup.of 1 * sgnPow c) := by
        rw [mk_sgnPow_mul_of1]
    _ = PresentedGroup.mk relsSR (X * FreeGroup.of 1 * sgnPow c) := by
        rw [← map_mul]
        congr 1
        rw [mul_assoc]

/-- Split form of the sign product, with the exclusive or in the order used by `mulX`/`mulY`. -/
theorem mk_sgnPow_mul_sgnPow' (c b : Bool) :
    PresentedGroup.mk relsSR (sgnPow c) * PresentedGroup.mk relsSR (sgnPow b)
      = PresentedGroup.mk relsSR (sgnPow (c != b)) := by
  rw [← map_mul, mk_sgnPow_mul_sgnPow, bne_comm]

/-- **The `x`-step in the presented group**, with the state's sign. -/
theorem mulX_w (b : Bool) (w : List Let) :
    PresentedGroup.mk relsSR ((w.map Let.w).prod * sgnPow b * FreeGroup.of 0)
      = PresentedGroup.mk relsSR (St.w (mulX (b, w))) := by
  have hcore := mulXCore_w w
  have hcomm := mk_mul_sgnPow_mul_of0 ((w.map Let.w).prod) b
  have hsg := mk_sgnPow_mul_sgnPow' (mulXCore w).1 b
  simp only [St.w, mulX]
  calc PresentedGroup.mk relsSR ((w.map Let.w).prod * sgnPow b * FreeGroup.of 0)
      = PresentedGroup.mk relsSR ((w.map Let.w).prod * FreeGroup.of 0 * sgnPow b) := hcomm
    _ = PresentedGroup.mk relsSR ((w.map Let.w).prod * FreeGroup.of 0)
        * PresentedGroup.mk relsSR (sgnPow b) := by rw [map_mul]
    _ = (PresentedGroup.mk relsSR (((mulXCore w).2).map Let.w).prod
          * PresentedGroup.mk relsSR (sgnPow (mulXCore w).1))
        * PresentedGroup.mk relsSR (sgnPow b) := by rw [hcore]
    _ = PresentedGroup.mk relsSR (((mulXCore w).2).map Let.w).prod
        * (PresentedGroup.mk relsSR (sgnPow (mulXCore w).1)
          * PresentedGroup.mk relsSR (sgnPow b)) := by rw [mul_assoc]
    _ = PresentedGroup.mk relsSR (((mulXCore w).2).map Let.w).prod
        * PresentedGroup.mk relsSR (sgnPow ((mulXCore w).1 != b)) := by
        rw [hsg]
    _ = PresentedGroup.mk relsSR
        ((((mulXCore w).2).map Let.w).prod * sgnPow ((mulXCore w).1 != b)) := by
        rw [← map_mul]

/-- **The `y`-step in the presented group**, with the state's sign. -/
theorem mulY_w (b : Bool) (w : List Let) :
    PresentedGroup.mk relsSR ((w.map Let.w).prod * sgnPow b * FreeGroup.of 1)
      = PresentedGroup.mk relsSR (St.w (mulY (b, w))) := by
  have hcore := mulYCore_w w
  have hcomm := mk_mul_sgnPow_mul_of1 ((w.map Let.w).prod) b
  have hsg := mk_sgnPow_mul_sgnPow' (mulYCore w).1 b
  simp only [St.w, mulY]
  calc PresentedGroup.mk relsSR ((w.map Let.w).prod * sgnPow b * FreeGroup.of 1)
      = PresentedGroup.mk relsSR ((w.map Let.w).prod * FreeGroup.of 1 * sgnPow b) := hcomm
    _ = PresentedGroup.mk relsSR ((w.map Let.w).prod * FreeGroup.of 1)
        * PresentedGroup.mk relsSR (sgnPow b) := by rw [map_mul]
    _ = (PresentedGroup.mk relsSR (((mulYCore w).2).map Let.w).prod
          * PresentedGroup.mk relsSR (sgnPow (mulYCore w).1))
        * PresentedGroup.mk relsSR (sgnPow b) := by rw [hcore]
    _ = PresentedGroup.mk relsSR (((mulYCore w).2).map Let.w).prod
        * (PresentedGroup.mk relsSR (sgnPow (mulYCore w).1)
          * PresentedGroup.mk relsSR (sgnPow b)) := by rw [mul_assoc]
    _ = PresentedGroup.mk relsSR (((mulYCore w).2).map Let.w).prod
        * PresentedGroup.mk relsSR (sgnPow ((mulYCore w).1 != b)) := by rw [hsg]
    _ = PresentedGroup.mk relsSR
        ((((mulYCore w).2).map Let.w).prod * sgnPow ((mulYCore w).1 != b)) := by
        rw [← map_mul]

/-- Right-multiplication form of the `x`-step. -/
theorem mulX_w' (st : St) :
    PresentedGroup.mk relsSR (St.w st) * PresentedGroup.mk relsSR (FreeGroup.of 0)
      = PresentedGroup.mk relsSR (St.w (mulX st)) := by
  rw [← map_mul]
  exact mulX_w st.1 st.2

/-- Right-multiplication form of the `y`-step. -/
theorem mulY_w' (st : St) :
    PresentedGroup.mk relsSR (St.w st) * PresentedGroup.mk relsSR (FreeGroup.of 1)
      = PresentedGroup.mk relsSR (St.w (mulY st)) := by
  rw [← map_mul]
  exact mulY_w st.1 st.2

/-- Iterating the `x`-step. -/
theorem mulX_w_pow : ∀ (n : ℕ) (st : St),
    PresentedGroup.mk relsSR (St.w st) * PresentedGroup.mk relsSR (FreeGroup.of 0 ^ n)
      = PresentedGroup.mk relsSR (St.w ((mulX^[n]) st))
  | 0, st => by simp
  | n + 1, st => by
      rw [pow_succ, map_mul, ← mul_assoc, Function.iterate_succ_apply', mulX_w_pow n st,
        mulX_w']

/-- Iterating the `y`-step. -/
theorem mulY_w_pow : ∀ (n : ℕ) (st : St),
    PresentedGroup.mk relsSR (St.w st) * PresentedGroup.mk relsSR (FreeGroup.of 1 ^ n)
      = PresentedGroup.mk relsSR (St.w ((mulY^[n]) st))
  | 0, st => by simp
  | n + 1, st => by
      rw [pow_succ, map_mul, ← mul_assoc, Function.iterate_succ_apply', mulY_w_pow n st,
        mulY_w']

/-- **One generator step is correct in the presented group.** -/
theorem step_w (st : St) (g : Fin 2 × Bool) :
    PresentedGroup.mk relsSR (St.w st) * PresentedGroup.mk relsSR (genWord g)
      = PresentedGroup.mk relsSR (St.w (step st g)) := by
  unfold step genWord
  split_ifs with h1 h2
  · exact mulX_w_pow 3 st
  · exact mulX_w' st
  · exact mulY_w_pow 5 st
  · exact mulY_w' st

/-- **The whole fold is correct in the presented group.** -/
theorem reduce_w (st : St) (w : List (Fin 2 × Bool)) :
    PresentedGroup.mk relsSR (St.w st) * PresentedGroup.mk relsSR ((w.map genWord).prod)
      = PresentedGroup.mk relsSR (St.w (reduce st w)) := by
  induction w generalizing st with
  | nil => simp [reduce]
  | cons g w ih =>
      rw [show reduce st (g :: w) = reduce (step st g) w by simp [reduce],
        List.map_cons, List.prod_cons, map_mul, ← mul_assoc, step_w st g, ih]

/-! ### The endgame: from the reduced state back to `SL(2,ℤ)`

`ex` reads a word of letters as a Conrad exponent list (`x` becomes the exponent `0` between two
`S`s, i.e. `R⁰·S·R⁰`). For a reduced word all inner exponents are `1` or `2`. -/

/-- The Conrad exponent list of a word of letters. The letters `x` are the separators `S` of the
Conrad form, so they contribute an exponent `0` only at the two *ends* of the word; the inner
exponents are the `y`-powers. For a reduced word all inner exponents are `1` or `2`. -/
def ex : List Let → List ℕ
  | [] => []
  | [Let.x] => [0, 0]
  | [Let.y i] => [i]
  | Let.x :: b :: rest => 0 :: ex (b :: rest)
  | Let.y i :: Let.x :: [] => [i, 0]
  | Let.y i :: Let.x :: c :: rest => i :: ex (c :: rest)
  | Let.y i :: Let.y j :: rest => i :: ex (Let.y j :: rest)

theorem ex_cons_ne_nil : ∀ (a : Let) (l : List Let), ex (a :: l) ≠ [] := by
  intro a l
  cases l with
  | nil => cases a <;> simp [ex]
  | cons b rest => cases a <;> cases b <;> cases rest <;> simp [ex]

/-- The kind of a letter: `x` versus `y`. -/
def Kind : Let → Bool
  | .x => true
  | .y _ => false

/-- A letter is non-degenerate: `x`, or `y` raised to a power `1` or `2`. -/
def NZ : Let → Prop
  | .x => True
  | .y i => i = 1 ∨ i = 2

/-- A *reduced* word: no `y 0`, and no two adjacent letters of the same kind (an `x` is a separator,
so consecutive `y`-powers are illegal in a Conrad form). -/
def Reduced : List Let → Prop
  | [] => True
  | [a] => NZ a
  | a :: b :: rest => NZ a ∧ (Kind a ≠ Kind b) ∧ Reduced (b :: rest)

/-- **The evaluation of a reduced letter word is the Conrad normal form of its exponent list.** -/
theorem ev_prod_eq_nfProd : ∀ w : List Let, Reduced w →
    (w.map Let.ev).prod = SL2Conrad.nfProd (ex w)
  | [], _ => by simp [ex, SL2Conrad.nfProd]
  | [Let.x], _ => by
      rw [show ex [Let.x] = [0, 0] from rfl, SL2Conrad.nfProd_cons_cons 0 (by simp)]
      simp [Let.ev, SL2Conrad.nfProd]
  | [Let.y i], _ => by simp [ex, Let.ev, SL2Conrad.nfProd]
  | Let.x :: b :: rest, h => by
      obtain ⟨_, _, hred⟩ := h
      have ih := ev_prod_eq_nfProd (b :: rest) hred
      have hne := ex_cons_ne_nil b rest
      rw [List.map_cons, List.prod_cons, ih,
        show ex (Let.x :: b :: rest) = 0 :: ex (b :: rest) from rfl,
        SL2Conrad.nfProd_cons_cons 0 hne]
      simp [Let.ev]
  | Let.y i :: Let.x :: [], _ => by
      rw [show ex [Let.y i, Let.x] = [i, 0] from rfl]
      simp [Let.ev, SL2Conrad.nfProd, SL2Conrad.nfProd_cons_cons]
  | Let.y i :: Let.x :: c :: rest, h => by
      obtain ⟨_, _, _, _, hred⟩ := h
      have ih := ev_prod_eq_nfProd (c :: rest) hred
      have hne := ex_cons_ne_nil c rest
      rw [List.map_cons, List.prod_cons, List.map_cons, List.prod_cons, ih,
        show ex (Let.y i :: Let.x :: c :: rest) = i :: ex (c :: rest) from rfl,
        SL2Conrad.nfProd_cons_cons i hne]
      simp only [Let.ev, mul_assoc]
  | Let.y i :: Let.y j :: rest, h => by
      simp only [Reduced, Kind, NZ] at h
      exact absurd rfl h.2.1

/-- `mulXCore` keeps the first letter (unless it empties the word). -/
theorem mulXCore_head (a : Let) (l : List Let) :
    (mulXCore (a :: l)).2 = []
      ∨ ∃ b t, (mulXCore (a :: l)).2 = b :: t ∧ Kind b = Kind a := by
  cases l with
  | nil =>
      cases a with
      | x => exact Or.inl rfl
      | y i => exact Or.inr ⟨Let.y i, [Let.x], rfl, rfl⟩
  | cons b rest =>
      refine Or.inr ⟨a, (mulXCore (b :: rest)).2, ?_, rfl⟩
      rw [show mulXCore (a :: b :: rest)
        = ((mulXCore (b :: rest)).1, a :: (mulXCore (b :: rest)).2) from rfl]

/-- `mulYCore` keeps the *kind* of the first letter (unless it empties the word). -/
theorem mulYCore_head (a : Let) (l : List Let) :
    (mulYCore (a :: l)).2 = []
      ∨ ∃ b t, (mulYCore (a :: l)).2 = b :: t ∧ Kind b = Kind a := by
  cases l with
  | nil =>
      cases a with
      | x => exact Or.inr ⟨Let.x, [Let.y 1], rfl, rfl⟩
      | y i =>
          by_cases hi : i = 2
          · subst hi
            exact Or.inl rfl
          · refine Or.inr ⟨Let.y (i + 1), [], ?_, rfl⟩
            rw [show mulYCore [Let.y i] = (false, [Let.y (i + 1)]) from by
              simp only [mulYCore, if_neg hi]]
  | cons b rest =>
      refine Or.inr ⟨a, (mulYCore (b :: rest)).2, ?_, rfl⟩
      rw [show mulYCore (a :: b :: rest)
        = ((mulYCore (b :: rest)).1, a :: (mulYCore (b :: rest)).2) from rfl]

/-- Building a reduced word by prepending a letter. -/
theorem reduced_cons (a b : Let) (w' : List Let) (ha : NZ a) (hred : Reduced w')
    (hkind : Kind a ≠ Kind b)
    (hhead : w' = [] ∨ ∃ b' t, w' = b' :: t ∧ Kind b' = Kind b) : Reduced (a :: w') := by
  rcases hhead with rfl | ⟨b', t, rfl, hk⟩
  · exact ha
  · exact ⟨ha, fun h => hkind (h.trans hk), hred⟩

/-- `mulXCore` preserves reducedness. -/
theorem mulXCore_reduced : ∀ w : List Let, Reduced w → Reduced (mulXCore w).2
  | [], _ => by simp [mulXCore, Reduced, NZ]
  | [Let.x], _ => by simp [mulXCore, Reduced]
  | [Let.y i], h => by
      rw [show mulXCore [Let.y i] = (false, [Let.y i, Let.x]) from rfl]
      exact ⟨h, by simp [Kind], trivial⟩
  | Let.x :: b :: rest, h => by
      obtain ⟨hx, hk, hr⟩ := h
      have ih := mulXCore_reduced (b :: rest) hr
      rw [show mulXCore (Let.x :: b :: rest)
        = ((mulXCore (b :: rest)).1, Let.x :: (mulXCore (b :: rest)).2) from rfl]
      exact reduced_cons Let.x b (mulXCore (b :: rest)).2 hx ih hk (mulXCore_head b rest)
  | Let.y i :: b :: rest, h => by
      obtain ⟨hi, hk, hr⟩ := h
      have ih := mulXCore_reduced (b :: rest) hr
      rw [show mulXCore (Let.y i :: b :: rest)
        = ((mulXCore (b :: rest)).1, Let.y i :: (mulXCore (b :: rest)).2) from rfl]
      exact reduced_cons (Let.y i) b (mulXCore (b :: rest)).2 hi ih hk (mulXCore_head b rest)

/-- `mulYCore` preserves reducedness. -/
theorem mulYCore_reduced : ∀ w : List Let, Reduced w → Reduced (mulYCore w).2
  | [], _ => by simp [mulYCore, Reduced, NZ]
  | [Let.x], _ => by
      rw [show mulYCore [Let.x] = (false, [Let.x, Let.y 1]) from rfl]
      exact ⟨trivial, by decide, by simp [Reduced, NZ]⟩
  | [Let.y i], h => by
      by_cases hi : i = 2
      · subst hi
        rw [show mulYCore [Let.y 2] = (true, []) from rfl]
        simp [Reduced]
      · rw [show mulYCore [Let.y i] = (false, [Let.y (i + 1)]) from by
          simp only [mulYCore, if_neg hi]]
        rcases h with h1 | h1
        · rw [h1]
          simp [Reduced, NZ]
        · exact absurd h1 hi
  | Let.x :: b :: rest, h => by
      obtain ⟨hx, hk, hr⟩ := h
      have ih := mulYCore_reduced (b :: rest) hr
      rw [show mulYCore (Let.x :: b :: rest)
        = ((mulYCore (b :: rest)).1, Let.x :: (mulYCore (b :: rest)).2) from rfl]
      exact reduced_cons Let.x b (mulYCore (b :: rest)).2 hx ih hk (mulYCore_head b rest)
  | Let.y i :: b :: rest, h => by
      obtain ⟨hi, hk, hr⟩ := h
      have ih := mulYCore_reduced (b :: rest) hr
      rw [show mulYCore (Let.y i :: b :: rest)
        = ((mulYCore (b :: rest)).1, Let.y i :: (mulYCore (b :: rest)).2) from rfl]
      exact reduced_cons (Let.y i) b (mulYCore (b :: rest)).2 hi ih hk (mulYCore_head b rest)

theorem mulX_reduced (st : St) (h : Reduced st.2) : Reduced (mulX st).2 := by
  simp only [mulX]
  exact mulXCore_reduced st.2 h

theorem mulY_reduced (st : St) (h : Reduced st.2) : Reduced (mulY st).2 := by
  simp only [mulY]
  exact mulYCore_reduced st.2 h

/-- The generator step preserves reducedness. -/
theorem step_reduced (st : St) (g : Fin 2 × Bool) (h : Reduced st.2) :
    Reduced (step st g).2 := by
  unfold step
  split_ifs with h1 h2
  · exact mulX_reduced _ (mulX_reduced _ (mulX_reduced _ h))
  · exact mulX_reduced _ h
  · exact mulY_reduced _ (mulY_reduced _ (mulY_reduced _ (mulY_reduced _ (mulY_reduced _ h))))
  · exact mulY_reduced _ h

/-- The fold preserves reducedness. -/
theorem reduce_reduced (st : St) (w : List (Fin 2 × Bool)) (h : Reduced st.2) :
    Reduced (reduce st w).2 := by
  induction w generalizing st with
  | nil => exact h
  | cons g w ih => exact ih (step st g) (step_reduced st g h)

/-- `conrad_tail` with its `lettersSL` hypothesis discharged. -/
theorem nfProd_ne_pm_one_of_IsNFtail (a : ℕ) (ha : a ≤ 2) (u : List ℕ)
    (hu : SL2Conrad.IsNFtail u) (hne : ¬ (u = [] ∧ a = 0)) :
    SL2Conrad.nfProd (a :: u) ≠ 1 ∧ SL2Conrad.nfProd (a :: u) ≠ -1 :=
  conrad_tail letters_ne_pm_one a ha u hu hne

theorem ex_ne_nil {w : List Let} (h : w ≠ []) : ex w ≠ [] := by
  cases w with
  | nil => exact absurd rfl h
  | cons a l => exact ex_cons_ne_nil a l

/-- **A reduced `y`-headed word has a `IsNFtail` exponent list**: its inner exponents are `1` or `2`. -/
theorem ex_isNFtail (i : ℕ) (l : List Let) (h : Reduced (Let.y i :: l)) :
    SL2Conrad.IsNFtail (ex (Let.y i :: l)) := by
  cases l with
  | nil =>
      rw [show ex [Let.y i] = [i] from rfl]
      simp only [Reduced, NZ] at h
      rcases h with h1 | h1 <;> rw [h1] <;> simp [SL2Conrad.IsNFtail]
  | cons b rest =>
      cases b with
      | x =>
          cases rest with
          | nil =>
              rw [show ex [Let.y i, Let.x] = [i, 0] from rfl]
              obtain ⟨hi, _, _⟩ := h
              simp only [NZ] at hi
              rcases hi with h1 | h1 <;> rw [h1] <;> simp [SL2Conrad.IsNFtail]
          | cons c t =>
              have hk : Kind Let.x ≠ Kind c := h.2.2.2.1
              have hcy : ∃ j, c = Let.y j := by
                cases c with
                | x => exact absurd rfl hk
                | y j => exact ⟨j, rfl⟩
              obtain ⟨j, rfl⟩ := hcy
              have hred2 : Reduced (Let.y j :: t) := h.2.2.2.2
              have hi : NZ (Let.y i) := h.1
              have ih := ex_isNFtail j t hred2
              rw [show ex (Let.y i :: Let.x :: Let.y j :: t) = i :: ex (Let.y j :: t) from rfl]
              simp only [NZ] at hi
              rcases hi with h1 | h1
              · rw [h1]
                exact SL2Conrad.isNFtail_cons_of (Or.inl rfl) (Or.inl ih)
              · rw [h1]
                exact SL2Conrad.isNFtail_cons_of (Or.inr rfl) (Or.inl ih)
      | y j =>
          exact absurd (by simp [Kind] : Kind (Let.y i) = Kind (Let.y j)) h.2.1

/-- The head of `ex` of a `y`-headed word is the exponent of that letter. -/
theorem ex_y_head (i : ℕ) (l : List Let) : ∃ u, ex (Let.y i :: l) = i :: u := by
  cases l with
  | nil => exact ⟨[], rfl⟩
  | cons b rest =>
      cases b with
      | x =>
          cases rest with
          | nil => exact ⟨[0], rfl⟩
          | cons c t => exact ⟨ex (c :: t), rfl⟩
      | y j => exact ⟨ex (Let.y j :: rest), rfl⟩

theorem Reduced.head_nz {a : Let} {l : List Let} (h : Reduced (a :: l)) : NZ a := by
  cases l with
  | nil => simpa only [Reduced] using h
  | cons b rest =>
      simp only [Reduced] at h
      exact h.1

theorem Reduced.tail {a b : Let} {rest : List Let} (h : Reduced (a :: b :: rest)) :
    Reduced (b :: rest) := by
  simp only [Reduced] at h
  exact h.2.2

theorem Reduced.kind_ne {a b : Let} {rest : List Let} (h : Reduced (a :: b :: rest)) :
    Kind a ≠ Kind b := by
  simp only [Reduced] at h
  exact h.2.1

/-- **A nonempty reduced word has a Conrad normal form different from `±1`.** -/
theorem nfProd_ex_ne_pm_one (w : List Let) (hred : Reduced w) (hne : ex w ≠ []) :
    SL2Conrad.nfProd (ex w) ≠ 1 ∧ SL2Conrad.nfProd (ex w) ≠ -1 := by
  cases w with
  | nil => exact absurd rfl hne
  | cons a l =>
      cases a with
      | x =>
          cases l with
          | nil =>
              refine nfProd_ne_pm_one_of_IsNFtail 0 (by norm_num) [0]
                (by simp [SL2Conrad.IsNFtail]) ?_
              simp
          | cons c t =>
              have hk : Kind Let.x ≠ Kind c := hred.kind_ne
              have hcy : ∃ j, c = Let.y j := by
                cases c with
                | x => exact absurd rfl hk
                | y j => exact ⟨j, rfl⟩
              obtain ⟨j, rfl⟩ := hcy
              have hred2 : Reduced (Let.y j :: t) := hred.tail
              refine nfProd_ne_pm_one_of_IsNFtail 0 (by norm_num) (ex (Let.y j :: t))
                (ex_isNFtail j t hred2) ?_
              simp [ex_ne_nil]
      | y i =>
          obtain ⟨u, hu⟩ := ex_y_head i l
          have hnf := ex_isNFtail i l hred
          rw [hu] at hnf
          have hi : i ≤ 2 := by
            have h1 : NZ (Let.y i) := hred.head_nz
            simp only [NZ] at h1
            rcases h1 with h | h <;> omega
          have hi' : i = 1 ∨ i = 2 := by simpa only [NZ] using hred.head_nz
          cases u with
          | nil =>
              rw [hu]
              rcases hi' with h1 | h1 <;> rw [h1]
              · refine ⟨?_, ?_⟩
                · simpa using SL2Conrad.R_ne_one
                · simpa using SL2Conrad.R_ne_neg_one
              · refine ⟨?_, ?_⟩
                · simpa using SL2Conrad.R_sq_ne_one
                · simpa using SL2Conrad.R_sq_ne_neg_one
          | cons c rest =>
              have hres := nfProd_ne_pm_one_of_IsNFtail i hi (c :: rest) hnf.2 (by simp)
              rw [hu]
              exact hres

/-- **The endgame**: a reduced state with trivial evaluation is trivial in the presented group. -/
theorem St.ev_eq_one_endgame (b : Bool) (w : List Let) (hred : Reduced w)
    (hev : St.ev (b, w) = 1) : PresentedGroup.mk relsSR (St.w (b, w)) = 1 := by
  have hsg : sg b * sg b = 1 := by cases b <;> decide
  have h2 : SL2Conrad.nfProd (ex w) = sg b := by
    have h1 : sg b * SL2Conrad.nfProd (ex w) = 1 := by
      rw [← ev_prod_eq_nfProd w hred]
      exact hev
    calc SL2Conrad.nfProd (ex w) = 1 * SL2Conrad.nfProd (ex w) := (one_mul _).symm
      _ = (sg b * sg b) * SL2Conrad.nfProd (ex w) := by rw [hsg]
      _ = sg b * (sg b * SL2Conrad.nfProd (ex w)) := by rw [mul_assoc]
      _ = sg b * 1 := by rw [h1]
      _ = sg b := mul_one _
  have hw : w = [] := by
    by_contra hne
    have hp := nfProd_ex_ne_pm_one w hred (ex_ne_nil hne)
    have hpm : sg b = 1 ∨ sg b = -1 := by
      cases b
      · simp [sg]
      · exact Or.inr (by simp [sg, SL2Conrad.S_sq])
    rcases hpm with h | h
    · exact hp.1 (by rw [h2, h])
    · exact hp.2 (by rw [h2, h])
  subst hw
  have hb : b = false := by
    have h1 : sg b = 1 := by rw [← h2]; simp [ex, SL2Conrad.nfProd]
    cases b with
    | false => rfl
    | true => exact absurd h1 (by decide)
  subst hb
  simp [St.w, sgnPow]

/-- **The word criterion** (generator-word form): a word of generators whose image in `SL(2,ℤ)` is
trivial is trivial in the presented group. -/
theorem word_criterion_gen (l : List (Fin 2 × Bool)) (h : (l.map genEv).prod = 1) :
    PresentedGroup.mk relsSR ((l.map genWord).prod) = 1 := by
  have hred : Reduced (reduce (false, []) l).2 :=
    reduce_reduced (false, []) l (by simp [Reduced])
  have hev : St.ev (reduce (false, []) l) = 1 := by
    rw [reduce_spec]
    simp [h, St.ev, sg]
  have hend := St.ev_eq_one_endgame (reduce (false, []) l).1 (reduce (false, []) l).2 hred hev
  have hrw := reduce_w (false, []) l
  rw [show St.w (false, ([] : List Let)) = 1 from by simp [St.w, sgnPow], map_one, one_mul]
    at hrw
  rw [hrw]
  exact hend

/-- The word in the free group of one generator step (`(i, false)` is `of i`, `(i, true)` is
`(of i)⁻¹`). -/
def freeWord (g : Fin 2 × Bool) : FreeGroup (Fin 2) :=
  (FreeGroup.of g.1) ^ (if g.2 then (-1 : ℤ) else 1)

/-- Per-generator bridge: the inverse generator word equals the `S³`/`R⁵` power in the presented
group (both come from the relators `S⁴ = 1` resp. `R⁶ = 1`). -/
theorem mk_freeWord_eq_genWord (g : Fin 2 × Bool) :
    PresentedGroup.mk relsSR (freeWord g) = PresentedGroup.mk relsSR (genWord g) := by
  rcases g with ⟨i, b⟩
  fin_cases i <;> cases b
  · simp [freeWord, genWord]
  · have h4 : PresentedGroup.mk relsSR ((FreeGroup.of (0 : Fin 2)) ^ 4) = 1 :=
      PresentedGroup.mk_eq_one_iff.mpr (Subgroup.subset_normalClosure (by simp [relsSR]))
    simp only [freeWord, genWord, Fin.isValue, if_true, if_false]
    calc PresentedGroup.mk relsSR ((FreeGroup.of (0 : Fin 2)) ^ (-1 : ℤ))
        = PresentedGroup.mk relsSR ((FreeGroup.of (0 : Fin 2)) ^ (-1 : ℤ)) * 1 :=
          (mul_one _).symm
      _ = PresentedGroup.mk relsSR ((FreeGroup.of (0 : Fin 2)) ^ (-1 : ℤ))
          * PresentedGroup.mk relsSR ((FreeGroup.of (0 : Fin 2)) ^ 4) := by rw [h4]
      _ = PresentedGroup.mk relsSR ((FreeGroup.of (0 : Fin 2)) ^ (-1 : ℤ)
          * (FreeGroup.of (0 : Fin 2)) ^ 4) := by rw [← map_mul]
      _ = PresentedGroup.mk relsSR ((FreeGroup.of (0 : Fin 2)) ^ 3) := by
          congr 1
          group
  · simp [freeWord, genWord]
  · simp only [freeWord, genWord, Fin.isValue, if_true, if_false]
    calc PresentedGroup.mk relsSR ((FreeGroup.of (1 : Fin 2)) ^ (-1 : ℤ))
        = PresentedGroup.mk relsSR ((FreeGroup.of (1 : Fin 2)) ^ (-1 : ℤ)) * 1 :=
          (mul_one _).symm
      _ = PresentedGroup.mk relsSR ((FreeGroup.of (1 : Fin 2)) ^ (-1 : ℤ))
          * PresentedGroup.mk relsSR ((FreeGroup.of (1 : Fin 2)) ^ 6) := by rw [mk_of1_pow_six]
      _ = PresentedGroup.mk relsSR ((FreeGroup.of (1 : Fin 2)) ^ (-1 : ℤ)
          * (FreeGroup.of (1 : Fin 2)) ^ 6) := by rw [← map_mul]
      _ = PresentedGroup.mk relsSR ((FreeGroup.of (1 : Fin 2)) ^ 5) := by
          congr 1
          group

theorem mk_freeWord_prod_eq (l : List (Fin 2 × Bool)) :
    PresentedGroup.mk relsSR ((l.map freeWord).prod)
      = PresentedGroup.mk relsSR ((l.map genWord).prod) := by
  induction l with
  | nil => simp
  | cons g l ih =>
      rw [List.map_cons, List.prod_cons, List.map_cons, List.prod_cons, map_mul, map_mul,
        mk_freeWord_eq_genWord g, ih]

/-- **The word criterion** (free-group form). -/
theorem word_criterion_free (l : List (Fin 2 × Bool)) (h : (l.map genEv).prod = 1) :
    PresentedGroup.mk relsSR ((l.map freeWord).prod) = 1 := by
  rw [mk_freeWord_prod_eq]
  exact word_criterion_gen l h

-- Capstone restatement of `word_criterion_free`: for every list `l` of generators whose evaluated
-- product in `SL(2,ℤ)` is `1`, the corresponding word is trivial in `H = ⟨S,R | S⁴, R³ = S²⟩`.
-- Consequently `φSR` is injective on the subgroup generated by `S` and `R`, i.e. `H ≅ SL(2,ℤ)`.

end SL2Discharge

/-
Linking file, concatenated **after** `Sol_burau_ker_final.lean` and the `Sol_sl2_*` development.

It uses the dev's `φSR : PresentedGroup relsSR →* SL(2,ℤ)` (injective, `Sol_sl2_discharge.lean`)
together with the new `ψ : Q ↠ SL(2,ℤ)` and `γ : Q ≅ H`, to reduce
`BurauFaithful.spec_reduced_kernel_normalClosure` to injectivity of an explicit surjective
endomorphism `δ' : H →* H`, i.e. to Hopfian-ness of `H ≅ SL(2,ℤ)`.
-/


set_option autoImplicit false

open Matrix

namespace BurauKerFinal

/-- `φSR` on the first generator. -/
theorem phiSR_of_zero :
    SL2Discharge.φSR (PresentedGroup.of (rels := SL2Discharge.relsSR) (0 : Fin 2)) =
      SL2Conrad.S := by
  rw [SL2Discharge.φSR, PresentedGroup.toGroup.of]
  exact SL2Discharge.genSR_zero

/-- `φSR` on the second generator. -/
theorem phiSR_of_one :
    SL2Discharge.φSR (PresentedGroup.of (rels := SL2Discharge.relsSR) (1 : Fin 2)) =
      SL2Conrad.R := by
  rw [SL2Discharge.φSR, PresentedGroup.toGroup.of]
  exact SL2Discharge.genSR_one

/-- The two generators of `SL(2,ℤ)` are in the range of `φSR` (as `ModularGroup.S`, `T`). -/
theorem modularGroup_generators_mem_range :
    ({ModularGroup.S, ModularGroup.T} : Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) ⊆
      Set.range SL2Discharge.φSR := by
  intro x hx
  rcases hx with rfl | rfl
  · refine ⟨PresentedGroup.of (rels := SL2Discharge.relsSR) (0 : Fin 2), ?_⟩
    rw [phiSR_of_zero]
    ext i j
    fin_cases i <;> fin_cases j <;> decide
  · have hS : SL2Conrad.S ∈ SL2Discharge.φSR.range :=
      ⟨PresentedGroup.of (rels := SL2Discharge.relsSR) (0 : Fin 2), phiSR_of_zero⟩
    have hR : SL2Conrad.R ∈ SL2Discharge.φSR.range :=
      ⟨PresentedGroup.of (rels := SL2Discharge.relsSR) (1 : Fin 2), phiSR_of_one⟩
    have hmem : SL2Conrad.S⁻¹ * SL2Conrad.R ∈ SL2Discharge.φSR.range :=
      SL2Discharge.φSR.range.mul_mem (SL2Discharge.φSR.range.inv_mem hS) hR
    have hT : ModularGroup.T = SL2Conrad.S⁻¹ * SL2Conrad.R := by
      ext i j
      fin_cases i <;> fin_cases j <;> decide
    rw [hT]
    exact hmem

/-- `φSR` is surjective. -/
theorem phiSR_surjective : Function.Surjective SL2Discharge.φSR := by
  intro x
  have hle : Subgroup.closure ({ModularGroup.S, ModularGroup.T} :
      Set (Matrix.SpecialLinearGroup (Fin 2) ℤ)) ≤
      (SL2Discharge.φSR.range : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℤ)) := by
    rw [Subgroup.closure_le]
    exact modularGroup_generators_mem_range
  have htop : (⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℤ)) ≤
      SL2Discharge.φSR.range := by
    rw [← SpecialLinearGroup.SL2Z_generators]
    exact hle
  exact htop trivial

end BurauKerFinal

/-
Bridging `φSR : H →* SL(2,ℤ)` to the dev's word criterion (`word_criterion_free`), in order to
package `Function.Injective φSR`.

Key Mathlib facts used (all from `Mathlib/GroupTheory/FreeGroup/Basic.lean`):
  * `FreeGroup.lift_mk : lift f (mk L) = List.prod (L.map fun x => cond x.2 (f x.1) (f x.1)⁻¹)` (rfl)
  * `FreeGroup.lift_unique (g) (hg : ∀ x, g (of x) = f x) {x} : g x = FreeGroup.lift f x`
  * `FreeGroup.mk_toWord : FreeGroup.mk x.toWord = x`
  * `PresentedGroup.mk_eq_one_iff`

Note the sign conventions: Mathlib's `mk`/`lift_mk` uses `true ↦ f x`, `false ↦ (f x)⁻¹`, while the
dev's `freeWord`/`genEv` use `true ↦ inverse`.  The two are related by flipping the boolean.

Concatenated **after** `Sol_sl2_*`.
-/


set_option autoImplicit false

namespace BurauKerFinal

/-- `φSR` on an arbitrary free-group word is the evaluation in `SL(2,ℤ)`. -/
theorem phiSR_mk (w : FreeGroup (Fin 2)) :
    SL2Discharge.φSR (PresentedGroup.mk SL2Discharge.relsSR w) =
      FreeGroup.lift SL2Discharge.genSR w := by
  have hg : ∀ x : Fin 2,
      (SL2Discharge.φSR.comp (PresentedGroup.mk SL2Discharge.relsSR)) (FreeGroup.of x) =
        SL2Discharge.genSR x := by
    intro x
    fin_cases x
    · show SL2Discharge.φSR (PresentedGroup.of (rels := SL2Discharge.relsSR) (0 : Fin 2)) =
        SL2Discharge.genSR 0
      rw [phiSR_of_zero, SL2Discharge.genSR_zero]
    · show SL2Discharge.φSR (PresentedGroup.of (rels := SL2Discharge.relsSR) (1 : Fin 2)) =
        SL2Discharge.genSR 1
      rw [phiSR_of_one, SL2Discharge.genSR_one]
  exact FreeGroup.lift_unique _ hg

/-- The list-side evaluation of `FreeGroup.lift`. -/
theorem lift_genSR_mk (L : List (Fin 2 × Bool)) :
    FreeGroup.lift SL2Discharge.genSR (FreeGroup.mk L) =
      (L.map fun x => cond x.2 (SL2Discharge.genSR x.1) (SL2Discharge.genSR x.1)⁻¹).prod :=
  FreeGroup.lift_mk

/-- `S³ = S⁻¹`. -/
theorem S_cube_eq_inv : SL2Conrad.S ^ 3 = SL2Conrad.S⁻¹ := by decide

/-- `R⁵ = R⁻¹`. -/
theorem R_five_eq_inv : SL2Conrad.R ^ 5 = SL2Conrad.R⁻¹ := by decide

/-- The dev's evaluation `genEv` equals Mathlib's list evaluation with the sign flipped. -/
theorem genEv_eq_lift (l : List (Fin 2 × Bool)) :
    (l.map SL2Discharge.genEv).prod =
      (l.map fun x => cond (!x.2) (SL2Discharge.genSR x.1) (SL2Discharge.genSR x.1)⁻¹).prod := by
  induction l with
  | nil => simp
  | cons g t ih =>
    obtain ⟨i, b⟩ := g
    simp only [List.map_cons, List.prod_cons, ih]
    cases b <;> fin_cases i <;>
      simp [SL2Discharge.genEv, SL2Discharge.genSR_zero, SL2Discharge.genSR_one,
        S_cube_eq_inv, R_five_eq_inv]

/-- Generic list-side evaluation of `FreeGroup.lift`. -/
theorem lift_mk_prod {β : Type*} [Group β] (f : Fin 2 → β) (L : List (Fin 2 × Bool)) :
    FreeGroup.lift f (FreeGroup.mk L) =
      (L.map fun x => cond x.2 (f x.1) (f x.1)⁻¹).prod :=
  FreeGroup.lift_mk

/-- `FreeGroup.mk` of a letter list is the product of the corresponding powers. -/
theorem mk_prod (L : List (Fin 2 × Bool)) :
    FreeGroup.mk L = (L.map fun x => cond x.2 (FreeGroup.of x.1) (FreeGroup.of x.1)⁻¹).prod := by
  have h := lift_mk_prod (FreeGroup.of : Fin 2 → FreeGroup (Fin 2)) L
  have h2 : FreeGroup.lift (FreeGroup.of : Fin 2 → FreeGroup (Fin 2)) (FreeGroup.mk L) =
      FreeGroup.mk L :=
    (FreeGroup.lift_unique (MonoidHom.id (FreeGroup (Fin 2))) (fun x => rfl)
      (x := FreeGroup.mk L)).symm
  rwa [h2] at h

/-- Flipping the signs twice is the identity. -/
theorem map_flip_flip (l : List (Fin 2 × Bool)) :
    (l.map (fun x => (x.1, !x.2))).map (fun x => (x.1, !x.2)) = l := by
  induction l with
  | nil => rfl
  | cons g t ih =>
    obtain ⟨i, b⟩ := g
    cases b <;> simp [ih]

/-- Flipping the signs turns the dev's `freeWord`-word into `FreeGroup.mk`. -/
theorem mk_flip_eq_freeWord_prod (l : List (Fin 2 × Bool)) :
    FreeGroup.mk (l.map (fun x => (x.1, !x.2))) = (l.map SL2Discharge.freeWord).prod := by
  rw [mk_prod, List.map_map]
  have hf : ((fun x : Fin 2 × Bool => cond x.2 (FreeGroup.of x.1) (FreeGroup.of x.1)⁻¹) ∘
      (fun x : Fin 2 × Bool => (x.1, !x.2))) = SL2Discharge.freeWord := by
    funext x
    obtain ⟨i, b⟩ := x
    cases b <;> simp [SL2Discharge.freeWord, Function.comp]
  rw [hf]

/-- **`φSR` is injective**: the presentation `⟨S,R | S⁴, R³ = S²⟩` is `SL(2,ℤ)`. -/
theorem phiSR_injective : Function.Injective SL2Discharge.φSR := by
  rw [injective_iff_map_eq_one]
  intro h hh
  obtain ⟨w, rfl⟩ := PresentedGroup.mk_surjective (SL2Discharge.relsSR) h
  have h1 : FreeGroup.lift SL2Discharge.genSR w = 1 := by
    rw [← phiSR_mk]
    exact hh
  have h2 : ((w.toWord.map (fun x => (x.1, !x.2))).map SL2Discharge.genEv).prod = 1 := by
    rw [genEv_eq_lift, List.map_map]
    have hm : ((fun x : Fin 2 × Bool => cond (!x.2) (SL2Discharge.genSR x.1)
          (SL2Discharge.genSR x.1)⁻¹) ∘ (fun x : Fin 2 × Bool => (x.1, !x.2))) =
        (fun x : Fin 2 × Bool => cond x.2 (SL2Discharge.genSR x.1)
          (SL2Discharge.genSR x.1)⁻¹) := by
      funext x
      obtain ⟨i, b⟩ := x
      cases b <;> simp [Function.comp]
    rw [hm, ← lift_mk_prod, FreeGroup.mk_toWord]
    exact h1
  have hcrit := SL2Discharge.word_criterion_free (w.toWord.map (fun x => (x.1, !x.2))) h2
  rwa [← mk_flip_eq_freeWord_prod, map_flip_flip, FreeGroup.mk_toWord] at hcrit

end BurauKerFinal

/-
Final assembly: reduces `ker ψ = 1` (hence `spec_reduced_kernel_normalClosure`) to Hopfian-ness
of `H ≅ SL(2,ℤ)`.

Concatenated after `Sol_burau_ker_final3.lean`.
-/


set_option autoImplicit false

namespace BurauKerFinal

/-- `φSR` is bijective. -/
theorem phiSR_bijective : Function.Bijective SL2Discharge.φSR :=
  ⟨phiSR_injective, phiSR_surjective⟩

/-- The isomorphism `H ≃* SL(2,ℤ)`. -/
noncomputable def phiSRE : H ≃* SL2Conrad.SL2 :=
  MulEquiv.ofBijective SL2Discharge.φSR phiSR_bijective

/-- `ψ ∘ γ⁻¹` read in `H`. -/
noncomputable def thetaSL : H →* SL2Conrad.SL2 :=
  psi.comp toQ

/-- The explicit surjective endomorphism of `H`. -/
noncomputable def delta' : H →* H :=
  phiSRE.symm.toMonoidHom.comp thetaSL

/-- `toQ` is surjective. -/
theorem toQ_surjective : Function.Surjective toQ := by
  intro y
  refine ⟨gamma y, ?_⟩
  have h := congrArg (fun g : Q →* Q => g y) toQ_gamma
  simpa [MonoidHom.comp_apply] using h

/-- `thetaSL` is surjective. -/
theorem thetaSL_surjective : Function.Surjective thetaSL :=
  psi_surjective.comp toQ_surjective

/-- `delta'` is surjective. -/
theorem delta'_surjective : Function.Surjective delta' :=
  phiSRE.symm.surjective.comp thetaSL_surjective

/-- `ψ = thetaSL ∘ γ`. -/
theorem psi_eq_thetaSL_gamma (z : Q) : psi z = thetaSL (gamma z) := by
  have h := congrArg (fun g : Q →* Q => g z) toQ_gamma
  have hz : toQ (gamma z) = z := by simpa [MonoidHom.comp_apply] using h
  show psi z = psi (toQ (gamma z))
  rw [hz]

/-- `delta' x` computed. -/
theorem delta'_apply (x : H) : delta' x = phiSRE.symm (thetaSL x) := rfl

/-- **Given Hopfian-ness of `H`, the kernel of `ψ` is trivial.** -/
theorem psi_injective_of_hopfian
    (hH : ∀ g : H →* H, Function.Surjective g → Function.Injective g) :
    Function.Injective psi := by
  rw [injective_iff_map_eq_one]
  intro z hz
  have h1 : thetaSL (gamma z) = 1 := by
    rw [← psi_eq_thetaSL_gamma]
    exact hz
  have h2 : delta' (gamma z) = 1 := by
    have hφ : phiSRE (delta' (gamma z)) = phiSRE 1 := by
      rw [delta'_apply, phiSRE.apply_symm_apply, h1, map_one]
    exact phiSRE.injective hφ
  have h3 : gamma z = 1 := hH delta' delta'_surjective (by rw [h2, map_one])
  have h := congrArg (fun g : Q →* Q => g z) toQ_gamma
  have hz' : toQ (gamma z) = z := by simpa [MonoidHom.comp_apply] using h
  rw [h3, map_one] at hz'
  exact hz'.symm

end BurauKerFinal

/-
Mal'cev: a finitely generated residually finite group is Hopfian, specialised to
`H = ⟨S,R | S⁴, R³ = S²⟩`.

Concatenated after `Sol_burau_ker_final4.lean`.
-/


set_option autoImplicit false

namespace BurauKerFinal

/-- Iterates of an endomorphism of `H`, as a monoid homomorphism. -/
noncomputable def iterHom (f : H →* H) (n : ℕ) : H →* H where
  toFun := f^[n]
  map_one' := by
    induction n with
    | zero => rfl
    | succ n ih => simp only [Function.iterate_succ_apply', map_one, ih]
  map_mul' x y := by
    induction n with
    | zero => rfl
    | succ n ih => simp only [Function.iterate_succ_apply', map_mul, ih]

theorem iterHom_zero (f : H →* H) : iterHom f 0 = MonoidHom.id H := rfl

theorem iterHom_succ (f : H →* H) (n : ℕ) : iterHom f (n + 1) = (iterHom f n).comp f := by
  ext x
  simp [iterHom, Function.iterate_succ_apply']

/-- Additivity of `iterHom` in the exponent. -/
theorem iterHom_add (f : H →* H) (a b : ℕ) :
    iterHom f (a + b) = (iterHom f a).comp (iterHom f b) := by
  ext x
  simp [iterHom, Function.iterate_add_apply]

/-- Iterates of a surjective endomorphism are surjective. -/
theorem iterHom_surjective (f : H →* H) (hf : Function.Surjective f) (n : ℕ) :
    Function.Surjective (iterHom f n) := by
  induction n with
  | zero =>
    rw [iterHom_zero]
    exact Function.surjective_id
  | succ n ih =>
    rw [iterHom_succ]
    exact ih.comp hf

/-- **Finitely many homs from `H` to a finite group.** -/
theorem finite_hom_of_finite {M : Type*} [Group M] [Finite M] : Finite (H →* M) :=
  Finite.of_injective (fun g : H →* M => (g S, g R)) (by
    intro g₁ g₂ hg
    refine PresentedGroup.ext (fun i => ?_)
    fin_cases i
    · exact congrArg Prod.fst hg
    · exact congrArg Prod.snd hg)

/-- **Mal'cev, specialised to `H`.** -/
theorem hopfian_of_residuallyFinite
    (hN : ∀ x : H, x ≠ 1 →
      ∃ (N : Subgroup H) (_ : N.Normal), Finite (H ⧸ N) ∧ x ∉ N)
    (f : H →* H) (hf : Function.Surjective f) : Function.Injective f := by
  rw [injective_iff_map_eq_one]
  intro x hx
  by_contra hne
  obtain ⟨N, hNn, hNfin, hxN⟩ := hN x hne
  haveI : N.Normal := hNn
  haveI : Finite (H ⧸ N) := hNfin
  let π : H →* H ⧸ N := QuotientGroup.mk' N
  let πn : ℕ → (H →* H ⧸ N) := fun n => π.comp (iterHom f n)
  have hker : ∀ n : ℕ, (πn n).ker = Subgroup.comap (iterHom f n) N := by
    intro n
    ext y
    simp only [πn, MonoidHom.mem_ker, MonoidHom.comp_apply, Subgroup.mem_comap]
    exact QuotientGroup.eq_one_iff _
  have hfin := finite_hom_of_finite (M := H ⧸ N)
  -- `x` is killed by every positive iterate
  have hiter : ∀ j : ℕ, (iterHom f (j + 1)) x = 1 := by
    intro j
    rw [iterHom_succ, MonoidHom.comp_apply, hx, map_one]
  have hdistinct : Function.Injective πn := by
    intro n m hnm
    by_contra hne'
    rcases le_total n m with hle | hle
    · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hle
      have hk : k ≠ 0 := by
        rintro rfl
        exact hne' (by omega)
      have h1 : Subgroup.comap (iterHom f n) N =
          Subgroup.comap (iterHom f (k + n)) N := by
        rw [← hker n, ← hker (k + n), hnm, Nat.add_comm n k]
      have hcomp : Subgroup.comap (iterHom f (k + n)) N =
          Subgroup.comap (iterHom f n) (Subgroup.comap (iterHom f k) N) := by
        rw [iterHom_add f k n]
        ext z
        simp only [Subgroup.mem_comap, MonoidHom.comp_apply]
      have h2 : Subgroup.comap (iterHom f k) N = N :=
        (Subgroup.comap_injective (iterHom_surjective f hf n)) (h1.trans hcomp).symm
      have hmem : x ∈ Subgroup.comap (iterHom f k) N := by
        obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk
        rw [Subgroup.mem_comap, hiter j]
        exact N.one_mem
      rw [h2] at hmem
      exact hxN hmem
    · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hle
      have hk : k ≠ 0 := by
        rintro rfl
        exact hne' (by omega)
      have h1 : Subgroup.comap (iterHom f m) N =
          Subgroup.comap (iterHom f (k + m)) N := by
        rw [← hker m, ← hker (k + m), hnm.symm, Nat.add_comm m k]
      have hcomp : Subgroup.comap (iterHom f (k + m)) N =
          Subgroup.comap (iterHom f m) (Subgroup.comap (iterHom f k) N) := by
        rw [iterHom_add f k m]
        ext z
        simp only [Subgroup.mem_comap, MonoidHom.comp_apply]
      have h2 : Subgroup.comap (iterHom f k) N = N :=
        (Subgroup.comap_injective (iterHom_surjective f hf m)) (h1.trans hcomp).symm
      have hmem : x ∈ Subgroup.comap (iterHom f k) N := by
        obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk
        rw [Subgroup.mem_comap, hiter j]
        exact N.one_mem
      rw [h2] at hmem
      exact hxN hmem
  have hrange : (Set.range πn).Infinite := Set.infinite_range_of_injective hdistinct
  exact (Set.Finite.subset Set.finite_univ (Set.subset_univ _)).not_infinite hrange

end BurauKerFinal

/-
Residual finiteness of `H`, in the form needed by `hopfian_of_residuallyFinite`.

`phiSRE : H ≃* SL(2,ℤ)`; a matrix `≠ 1` has a nonzero entry in `M - 1`, and reducing modulo a prime
larger than that entry separates it.

Concatenated after `Sol_burau_ker_final5.lean`.
-/


set_option autoImplicit false

namespace BurauKerFinal

/-- Reduction `SL(2,ℤ) →* SL(2, ℤ/p)`. -/
noncomputable def reduceMod (p : ℕ) :
    Matrix.SpecialLinearGroup (Fin 2) ℤ →* Matrix.SpecialLinearGroup (Fin 2) (ZMod p) :=
  Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod p))

theorem reduceMod_coe (p : ℕ) (M : Matrix.SpecialLinearGroup (Fin 2) ℤ) :
    ((reduceMod p M : Matrix.SpecialLinearGroup (Fin 2) (ZMod p)) :
        Matrix (Fin 2) (Fin 2) (ZMod p)) =
      (M : Matrix (Fin 2) (Fin 2) ℤ).map (Int.castRingHom (ZMod p)) :=
  rfl

/-- **Residual finiteness of `H`**, in the form used by Mal'cev. -/
theorem residuallyFinite_H :
    ∀ x : H, x ≠ 1 →
      ∃ (N : Subgroup H) (_ : N.Normal), Finite (H ⧸ N) ∧ x ∉ N := by
  intro x hx
  have hφ : phiSRE x ≠ 1 := fun h => hx (phiSRE.injective h)
  set M : Matrix (Fin 2) (Fin 2) ℤ := (phiSRE x : Matrix (Fin 2) (Fin 2) ℤ)
  have hex : ∃ i j, M i j ≠ (1 : Matrix (Fin 2) (Fin 2) ℤ) i j := by
    by_contra h
    exact hφ (Subtype.ext (by
      ext i j
      by_contra hij
      exact h ⟨i, j, hij⟩))
  obtain ⟨i, j, hij⟩ := hex
  obtain ⟨p, hp, hprime⟩ :=
    Nat.exists_infinite_primes ((M i j - (1 : Matrix (Fin 2) (Fin 2) ℤ) i j).natAbs + 1)
  haveI : NeZero p := ⟨by have := hprime.pos; omega⟩
  let f : H →* Matrix.SpecialLinearGroup (Fin 2) (ZMod p) :=
    (reduceMod p).comp phiSRE.toMonoidHom
  have hne : f x ≠ 1 := by
    intro h1
    have hh := congrArg (fun N : Matrix.SpecialLinearGroup (Fin 2) (ZMod p) =>
      (N : Matrix (Fin 2) (Fin 2) (ZMod p)) i j) h1
    have hx : ((f x : Matrix.SpecialLinearGroup (Fin 2) (ZMod p)) :
        Matrix (Fin 2) (Fin 2) (ZMod p)) = (M.map (Int.castRingHom (ZMod p))) := by
      show ((reduceMod p (phiSRE x) : Matrix.SpecialLinearGroup (Fin 2) (ZMod p)) :
        Matrix (Fin 2) (Fin 2) (ZMod p)) = _
      exact reduceMod_coe p (phiSRE x)
    rw [hx, Matrix.map_apply] at hh
    have hentry : ((M i j - (1 : Matrix (Fin 2) (Fin 2) ℤ) i j : ℤ)) = 0 := by
      have h4 : ((M i j : ℤ) : ZMod p) =
          (((1 : Matrix (Fin 2) (Fin 2) ℤ) i j : ℤ) : ZMod p) := by
        by_cases hij' : i = j
        · subst hij'
          simpa [Matrix.one_apply] using hh
        · simpa [Matrix.one_apply, hij'] using hh
      have h5 : ((M i j - (1 : Matrix (Fin 2) (Fin 2) ℤ) i j : ℤ) : ZMod p) = 0 := by
        rw [Int.cast_sub, h4, sub_self]
      have hdvd : ((p : ℤ)) ∣ (M i j - (1 : Matrix (Fin 2) (Fin 2) ℤ) i j) :=
        (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp h5
      have h2 : p ∣ (M i j - (1 : Matrix (Fin 2) (Fin 2) ℤ) i j).natAbs := by
        simpa using (Int.natAbs_dvd_natAbs (a := (p : ℤ))
          (b := M i j - (1 : Matrix (Fin 2) (Fin 2) ℤ) i j)).mpr hdvd
      exact Int.natAbs_eq_zero.mp (Nat.eq_zero_of_dvd_of_lt h2 (by omega))
    exact hij (sub_eq_zero.mp hentry)
  refine ⟨f.ker, inferInstance, ?_, ?_⟩
  · refine Finite.of_injective (QuotientGroup.quotientKerEquivRange f).toFun ?_
    exact (QuotientGroup.quotientKerEquivRange f).injective
  · intro hmem
    exact hne hmem

end BurauKerFinal

/-
Final assembly: `Hopfian(H)` ⇒ `ker ψ = 1` ⇒ the mission node
`spec_reduced_kernel_normalClosure` (local formulation).

Concatenated after `Sol_burau_ker_final6.lean`.
-/


set_option autoImplicit false

namespace BurauKerFinal

/-- `H` is Hopfian (Mal'cev + residual finiteness). -/
theorem hopfian_H : ∀ g : H →* H, Function.Surjective g → Function.Injective g :=
  hopfian_of_residuallyFinite residuallyFinite_H

/-- **`ψ` is injective**, i.e. `ker redHom3 = ⟨⟨Δ⁴⟩⟩`. -/
theorem psi_injective : Function.Injective psi :=
  psi_injective_of_hopfian hopfian_H

/-- `ψ ∘ q = toSL`. -/
theorem psi_q_apply (x : PresentedGroup (BraidsLinksMCG.braidRels 3)) : psi (q x) = toSL x := by
  have hq : q x = QuotientGroup.mk x := by
    show (QuotientGroup.mk' _) x = QuotientGroup.mk x
    rw [QuotientGroup.mk'_apply]
  rw [hq]
  show (QuotientGroup.lift _ toSL _) (QuotientGroup.mk x) = toSL x
  exact QuotientGroup.lift_mk' _ _ x

/-- `q.ker = ⟨⟨Δ⁴⟩⟩`. -/
theorem ker_q : q.ker =
    Subgroup.normalClosure ({Delta4} : Set (PresentedGroup (BraidsLinksMCG.braidRels 3))) :=
  QuotientGroup.ker_mk' _

/-- `Δ⁴ = (σ₀σ₁)⁶`. -/
theorem Delta4_eq_sigma : Delta4 =
    (BraidsLinksMCG.sigma (n := 3) ⟨0, by decide⟩ *
      BraidsLinksMCG.sigma (n := 3) ⟨1, by decide⟩) ^ 6 := rfl

/-- **`spec_reduced_kernel_normalClosure`** (local formulation): every braid killed by `toSL`
lies in the normal closure of `Δ⁴ = (σ₀σ₁)⁶`. -/
theorem spec_reduced_kernel_normalClosure_local
    (β : PresentedGroup (BraidsLinksMCG.braidRels 3)) (hβ : toSL β = 1) :
    β ∈ Subgroup.normalClosure ({Delta4} : Set (PresentedGroup (BraidsLinksMCG.braidRels 3))) := by
  have hq : q β = 1 := by
    apply psi_injective
    rw [map_one, psi_q_apply]
    exact hβ
  have hmem : β ∈ q.ker := by
    rw [MonoidHom.mem_ker]
    exact hq
  rwa [ker_q] at hmem

end BurauKerFinal


namespace BurauKerFinal

theorem gen_of_zero : BurauKerFinal.toSL
    (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2)) = BurauFaithful.redGen 0 := by
  rw [toSL_of_zero]
  rfl

theorem gen_of_one : BurauKerFinal.toSL
    (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2)) = BurauFaithful.redGen 1 := by
  rw [toSL_of_one]
  rfl

theorem toSL_gen_eq (x : Fin 2) : BurauKerFinal.toSL
    (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) x) = BurauFaithful.redGen x := by
  fin_cases x
  . exact gen_of_zero
  . exact gen_of_one

theorem toSL_eq_redHom3_pointwise (b : BraidsLinksMCG.ArtinBraidGroup 3) :
    BurauKerFinal.toSL b = BurauFaithful.redHom3 b := by
  have h := PresentedGroup.toGroup.unique (f := BurauFaithful.redGen)
      (rels := BraidsLinksMCG.braidRels 3) BurauFaithful.redGen_braid BurauKerFinal.toSL
      toSL_gen_eq (x := b)
  rw [BurauFaithful.redHom3]
  exact h

theorem redHom3_kernel_normalClosure (beta : BraidsLinksMCG.ArtinBraidGroup 3)
    (h : BurauFaithful.redHom3 beta = 1) :
    beta ∈ Subgroup.normalClosure
      ({(BraidsLinksMCG.sigma (n := 3) (0 : Fin 2) *
          BraidsLinksMCG.sigma (n := 3) (1 : Fin 2)) ^ 6} :
        Set (BraidsLinksMCG.ArtinBraidGroup 3)) :=
  spec_reduced_kernel_normalClosure_local beta (by
    rw [toSL_eq_redHom3_pointwise]
    exact h)

end BurauKerFinal

theorem solution : Function.Injective (BurauFaithful.burauRep 3) := by
  rw [injective_iff_map_eq_one]
  intro beta hbeta
  have h1 : (Matrix.GeneralLinearGroup.map
      (LaurentPolynomial.eval₂ (Int.castRingHom Int) (-1 : Intˣ))
      (BurauFaithful.burauRep 3 beta)) = 1 := by
    rw [hbeta, map_one]
  have h2 : BurauFaithful.redHom3 beta = 1 := BurauLink.link beta h1
  have h3 := BurauKerFinal.redHom3_kernel_normalClosure beta h2
  obtain ⟨k, hk⟩ := BurauFaithful.spec_reduced_kernel_last_mile beta h3
  have htwist : (BurauFaithful.burauRep 3
      (BraidsLinksMCG.sigma (n := 3) ⟨0, by decide⟩ *
        BraidsLinksMCG.sigma (n := 3) ⟨1, by decide⟩)) ^ (6 * k) = 1 := by
    rw [← map_zpow, ← hk, hbeta]
  have hk0 : k = 0 := BurauFaithful.burau_three_fullTwist_sq_infinite_order k htwist
  rw [hk, hk0, mul_zero, zpow_zero]
