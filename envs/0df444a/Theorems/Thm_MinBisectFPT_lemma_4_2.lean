-- title:
--   Lemma 4.2 — factorization of $F(W)$ over the children
-- statement:
--   Under the standing assumptions of §4, fix a node $t$ with children $c_1,\dots,c_r$. For every $W\subseteq\beta$, and for $R_t$ with any truncation $x^{q'+1}$,
--   $$F(W)=\sum_{S\subseteq W}x^{|S|}y^{|S\setminus\sigma|}z^{|\delta_B(S)|}u^{S\cap\sigma}\prod_{i=1}^rP_{c_i}(S\cap\sigma(c_i)).$$
--   Moreover $F(W)-1$ lies in the ideal generated by $x$ and $z$: every monomial of $F(W)-1$ contains $x$ or $z$.
--
--   The formula computes $F(W)$ from the tables of the children.
--
--   Differences from the source:
--   - reading: "every monomial in $F(W)-1$ contains either $x$ or $z$" → `F W - 1 ∈ J`; reason: the ideal $J_t$ of p.12 is the span of those monomials
--   - encoding: the row $\sum_{\ell,j}$ → the sum over the table's range $\ell\le|\alpha(c)|$, $j\le k$; reason: other coefficients are not in the table, and they vanish in $R_t$ or count nothing
-- source:
--   Anand, Kipouridis, Węgrzycki, Counting over Unbreakable Decompositions, STOC 2027 submission (manuscript sha256 8db80a52…), Lemma 4.2, pp.11–12

import Mathlib
import Definitions.Def_MinBisectFPT_NodeCtx

open scoped Classical

namespace MinBisectFPT

/-- **Lemma 4.2.** Anand, Kipouridis, Węgrzycki, STOC 2027 submission (manuscript sha256 8db80a52…), Lemma 4.2, pp.11–12: the factorization of `F(W)` over the children, for every
truncation `q′` of `x`, and `F(W) − 1 ∈ J_t` ("every monomial in F(W) − 1 contains either x or z"). -/
theorem lemma_4_2 {n : ℕ} (ctx : NodeCtx n) (q' : ℕ) (W : Finset (Fin n)) (hW : W ⊆ ctx.β) :
    ctx.F q' W = ∑ S ∈ W.powerset,
      ctx.monoT q' S.card (S \ ctx.σ).card (cutSize ctx.B S) (S ∩ ctx.σ) *
        ∏ c ∈ ctx.D.children ctx.t, ctx.row q' c (S ∩ ctx.D.adhesion c) ∧
    ctx.F q' W - 1 ∈ ctx.J q' := by sorry

end MinBisectFPT
