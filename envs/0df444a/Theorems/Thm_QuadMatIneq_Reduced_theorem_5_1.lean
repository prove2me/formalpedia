-- title:
--   Theorem 5.1, pp. 18–19 — for Φ ∈ 𝚷_{n,T}, data are informative for quadratic stabilization iff the LMI (5.5) is feasible; under Φ₂₂ < 0 and full row rank, iff (5.6) is; K = LP⁻¹ stabilizes Σ
-- statement:
--   Let $\Phi\in\boldsymbol\Pi_{n,T}$ and consider data $(U_-, X)$ generated by the system $x(t+1) = A_sx(t)+B_su(t)+w(t)$ with noise satisfying the noise model $W_-^\top\in\mathcal Z_T(\Phi)$, so that $(A_s, B_s)\in\Sigma$.
--
--   1. The data are informative for quadratic stabilization if and only if there exist an $n\times n$ matrix $P>0$, a matrix $L\in\mathbb R^{m\times n}$ and a scalar $\beta>0$ such that
--   $$\begin{bmatrix} P-\beta I&0&0&0\\ 0&-P&-L^\top&0\\ 0&-L&0&L\\ 0&0&L^\top&P\end{bmatrix} - \begin{bmatrix} I&X_+\\ 0&-X_-\\ 0&-U_-\\ 0&0\end{bmatrix}\begin{bmatrix}\Phi_{11}&\Phi_{12}\\ \Phi_{21}&\Phi_{22}\end{bmatrix}\begin{bmatrix} I&X_+\\ 0&-X_-\\ 0&-U_-\\ 0&0\end{bmatrix}^\top\ge 0. \tag{5.5}$$
--   2. If, in addition, $\Phi_{22}<0$ and $\operatorname{rank}\begin{bmatrix} X_-\\ U_-\end{bmatrix} = n+m$, then the data are informative for quadratic stabilization if and only if there exist an $n\times n$ matrix $P>0$ and $L\in\mathbb R^{m\times n}$ satisfying (5.6), the strict inequality obtained from (5.5) by replacing $P-\beta I$ with $P$.
--   3. If $P>0$, $L$, $\beta>0$ satisfy (5.5), or $P>0$, $L$ satisfy (5.6), then $K := LP^{-1}$ is a stabilizing feedback gain for all $(A,B)\in\Sigma$: for every $(A,B)\in\Sigma$,
--   $$P - (A+BK)P(A+BK)^\top > 0\quad\text{and}\quad (A+BK)^k\to 0\ \ (k\to\infty).$$
--
--   This is the general LMI characterization of data informativity for quadratic stabilization under the QMI noise model; it requires no rank condition in part (a). Theorem 5.3 reduces its size.
--
--   **Formalization Note** "Generated by (2.1) with noise model (2.3)" is the hypothesis that $\Sigma$ contains some pair $(A_s, B_s)$; without it informativity could hold vacuously. "Stabilizing gain" is stated with the $P$ of the LMI, as the proof establishes: the Lyapunov inequality (2.4) and Schur stability of $A+BK$. This statement is the goal of the companion mission IV of this series and is restated here identically so that this mission is self-contained.
-- source:
--   van Waarde–Camlibel–Eising–Trentelman, arXiv:2203.12959v3, Theorem 5.1, pp. 18–19

import Mathlib
import Definitions.Def_QuadMatIneq_Reduced_QMI
import Definitions.Def_QuadMatIneq_Reduced_Data
open Matrix

namespace QuadMatIneq.Reduced

theorem theorem_5_1 {n m T : ℕ} (Φ : Matrix (Fin n ⊕ Fin T) (Fin n ⊕ Fin T) ℝ)
    (X : Matrix (Fin n) (Fin (T + 1)) ℝ) (Um : Matrix (Fin m) (Fin T) ℝ)
    (hΦ : InPi Φ) (hgen : ∃ As Bs, (As, Bs) ∈ QuadMatIneq.Stabilization.Sigma Φ X Um) :
    (QuadMatIneq.Stabilization.InformativeQS Φ X Um ↔
      ∃ (P : Matrix (Fin n) (Fin n) ℝ) (L : Matrix (Fin m) (Fin n) ℝ) (β : ℝ),
        P.PosDef ∧ 0 < β ∧ (lmi55 Φ X Um P L β).PosSemidef) ∧
    ((-Φ.toBlocks₂₂).PosDef → (Matrix.fromRows (QuadMatIneq.Stabilization.Xminus X) Um).rank = n + m →
      (QuadMatIneq.Stabilization.InformativeQS Φ X Um ↔
        ∃ (P : Matrix (Fin n) (Fin n) ℝ) (L : Matrix (Fin m) (Fin n) ℝ),
          P.PosDef ∧ (QuadMatIneq.Stabilization.lmi56 Φ X Um P L).PosDef)) ∧
    (∀ (P : Matrix (Fin n) (Fin n) ℝ) (L : Matrix (Fin m) (Fin n) ℝ) (β : ℝ),
      P.PosDef → 0 < β → (lmi55 Φ X Um P L β).PosSemidef →
        ∀ AB ∈ QuadMatIneq.Stabilization.Sigma Φ X Um,
          (P - (AB.1 + AB.2 * (L * P⁻¹)) * P * (AB.1 + AB.2 * (L * P⁻¹))ᵀ).PosDef ∧
          Filter.Tendsto (fun k : ℕ => (AB.1 + AB.2 * (L * P⁻¹)) ^ k) Filter.atTop (nhds 0)) ∧
    (∀ (P : Matrix (Fin n) (Fin n) ℝ) (L : Matrix (Fin m) (Fin n) ℝ),
      P.PosDef → (QuadMatIneq.Stabilization.lmi56 Φ X Um P L).PosDef →
        ∀ AB ∈ QuadMatIneq.Stabilization.Sigma Φ X Um,
          (P - (AB.1 + AB.2 * (L * P⁻¹)) * P * (AB.1 + AB.2 * (L * P⁻¹))ᵀ).PosDef ∧
          Filter.Tendsto (fun k : ℕ => (AB.1 + AB.2 * (L * P⁻¹)) ^ k) Filter.atTop (nhds 0)) := by sorry

end QuadMatIneq.Reduced
