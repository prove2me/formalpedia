    8192 ≤ bP n ∧ 1 ≤ IntMul.OpenAI.Glue.dP n ∧ IntMul.OpenAI.Glue.dP n ≤ bP n ∧ IntMul.OpenAI.Glue.dP n ^ 2 ≤ bP n ∧ n ≤ 2 ^ bP n ∧ IntMul.OpenAI.Glue.LP n < bP n ∧
