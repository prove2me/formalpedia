-- title:
--   Finite MDP with dynamics $p(s', r \mid s, a)$, stochastic policies and the coverage assumption
-- statement:
--   A **finite Markov decision process** consists of a finite set of states $\mathcal S$ (here including the terminal states, the book's $\mathcal S^+$), a finite set of actions $\mathcal A$, a finite set of rewards $\mathcal R \subset \mathbb R$, and dynamics
--
--   $$
--   p(s', r \mid s, a) \ge 0, \qquad \sum_{s' \in \mathcal S} \sum_{r \in \mathcal R} p(s', r \mid s, a) = 1 \quad \text{for all } s, a,
--   $$
--
--   the probability of moving to state $s'$ with reward $r$ after action $a$ in state $s$. The **state-transition probability** is $p(s' \mid s, a) = \sum_{r \in \mathcal R} p(s', r \mid s, a)$.
--
--   A **policy** $\pi$ assigns to every state $s$ a probability distribution $\pi(\cdot \mid s)$ over actions. A behaviour policy $b$ **covers** a target policy $\pi$ if
--
--   $$
--   \pi(a \mid s) > 0 \implies b(a \mid s) > 0 \qquad \text{for every state } s \text{ and action } a .
--   $$
--
--   These are the objects of off-policy prediction: episodes are generated by $b$ and used to evaluate $\pi$; coverage is the condition under which every action $\pi$ might take is sometimes taken by $b$.
--
--   **Formalization Note** One action set is used for every state (the book's footnote 3, p. 48, allows this). The structure `MDP` and `Policy` are the same as in the other missions of this series; the terminal states are a separate `Finset` parameter of the episode definitions.
-- source:
--   Sutton & Barto, Reinforcement Learning: An Introduction, 2nd ed., MIT Press (2018), ISBN 9780262039246, Eqs. (3.2)–(3.4), pp. 48–49; policies §3.5, p. 58; assumption of coverage, §5.5, p. 103

import Mathlib
import Definitions.Def_SuttonBartoRL_FiniteMDP_MDP

namespace SuttonBartoRL.ImportanceSampling

/-- Sutton & Barto, *Reinforcement Learning: An Introduction*, 2nd ed. (2018), §3.1, Eqs. (3.2)–(3.3),
pp. 48–49: a finite Markov decision process with finite state set `S` (terminal states included,
the book's `S⁺`, p. 54), one finite action set `A` for every state (footnote 3, p. 48), a finite
reward set `R ⊂ ℝ`, and four-argument dynamics `p s a s' r = p(s', r | s, a)`, a probability
distribution over `(s', r) ∈ S × R` for every `(s, a)`. Values of `p` at rewards outside `R` are
never used. -/
structure MDP (S A : Type) [Fintype S] [Fintype A] where
  /-- The finite reward set `R`. -/
  R : Finset ℝ
  /-- The dynamics `p(s', r | s, a)`, written `p s a s' r`. -/
  p : S → A → S → ℝ → ℝ
  /-- Probabilities are nonnegative. -/
  p_nonneg : ∀ s a s' r, 0 ≤ p s a s' r
  /-- (3.3): `Σ_{s' ∈ S} Σ_{r ∈ R} p(s', r | s, a) = 1` for all `s`, `a`. -/
  p_sum : ∀ s a, ∑ s', ∑ r ∈ R, p s a s' r = 1

namespace MDP

variable {S A : Type} [Fintype S] [Fintype A]

/-- (3.4), p. 49: the state-transition probability `p(s' | s, a) = Σ_{r ∈ R} p(s', r | s, a)`. -/
def trans (M : MDP S A) (s : S) (a : A) (s' : S) : ℝ :=
  ∑ r ∈ M.R, M.p s a s' r

end MDP

/-- The assumption of coverage, p. 103: `π(a|s) > 0` implies `b(a|s) > 0`, for every state `s` and
action `a`. -/
def Coverage {S A : Type} [Fintype A] (π b : SuttonBartoRL.FiniteMDP.Policy S A) : Prop :=
  ∀ s a, 0 < π.prob s a → 0 < b.prob s a

end SuttonBartoRL.ImportanceSampling


