theorem OAI.InitialMeanSquare.initialErrorFrequencyBound_le (a b Z H : ℝ) (hZ : 1 ≤ Z) (hH : 1 ≤ H) :
    initialErrorFrequencyBound a b Z H ≤
      48*(1+Real.exp (initialErrorWindow a b))^16*Z^16 := by sorry
