theorem candidate_close {n r m D E : ℤ} {x : ℝ}
    (hr : 0 < r) (hrn : r < n) (hm : 0 < m)
    (hD : Candidate n r m x D) (hE : Candidate n r m x E) :
    |D-E| ≤ 1 := by
  obtain ⟨hDl,hDu⟩ := abs_le.mp hD
  obtain ⟨hEl,hEu⟩ := abs_le.mp hE
  have hnR : (r:ℝ) < n := by exact_mod_cast hrn
  have hmR : (0:ℝ) < m := by exact_mod_cast hm
  have hnm : 0 < (n:ℝ)*m := mul_pos (by exact_mod_cast lt_trans hr hrn) hmR
  have hmr : (m:ℝ)*r < (n:ℝ)*m := by nlinarith
  apply abs_le.mpr
  constructor
  · by_contra h
    have hgapZ : 2 ≤ E-D := by omega
    have hgap : (2:ℝ) ≤ (E:ℝ)-D := by exact_mod_cast hgapZ
    have hmul := mul_le_mul_of_nonneg_left hgap hnm.le
    nlinarith only [hEu,hDl,hmul,hmr]
  · by_contra h
    have hgapZ : 2 ≤ D-E := by omega
    have hgap : (2:ℝ) ≤ (D:ℝ)-E := by exact_mod_cast hgapZ
    have hmul := mul_le_mul_of_nonneg_left hgap hnm.le
    nlinarith only [hDu,hEl,hmul,hmr]

theorem same_det_of_not_coprime {n r m q D E b c : ℤ} {x : ℝ}
    (hr : 0 < r) (hrn : r < n) (hm : 0 < m)
    (hq : ¬ IsCoprime r q) (hb : IsCoprime r b) (hc : IsCoprime r c)
    (hD : Candidate n r m x D) (hE : Candidate n r m x E)
    (hd : r ∣ D*b-q) (he : r ∣ E*c-q) : D=E := by
  have hclose := abs_le.mp (candidate_close hr hrn hm hD hE)
  obtain ⟨x,y,hxy⟩ := determinant_in_ideal hb hd
  obtain ⟨u,v,huv⟩ := determinant_in_ideal hc he
  by_contra hne
  apply hq
  have hcases : D-E=1 ∨ E-D=1 := by omega
  rcases hcases with hplus | hminus
  · refine ⟨x-u,y-v,?_⟩
    linear_combination hxy-huv+hplus
  · refine ⟨u-x,v-y,?_⟩
    linear_combination huv-hxy+hminus

theorem coprime_blocker_card {α : Type*} [DecidableEq α]
    {n r m q : ℤ} {x : ℝ} (S : Finset α) (f : α → ℤ)
    (hr : 0 < r) (hrn : r < n) (hm : 0 < m) (hq : IsCoprime r q)
    (hinj : ∀ b ∈ S, ∀ c ∈ S, r ∣ f b-f c → b=c)
    (hblock : ∀ b ∈ S, Blocks n r m q (f b) x) : S.card ≤ 2 := by
  by_contra hcard
  obtain ⟨b,c,d,hb,hc,hd,hbc,hbd,hcd⟩ :=
    Finset.two_lt_card_iff.mp (show 2 < S.card by omega)
  obtain ⟨D,hD,hDb⟩ := hblock b hb
  obtain ⟨E,hE,hEc⟩ := hblock c hc
  obtain ⟨F,hF,hFd⟩ := hblock d hd
  have hDE : D ≠ E := by
    intro heq
    apply hbc
    apply hinj b hb c hc
    rw [← heq] at hEc
    exact same_det_residue_of_coprime hq hDb hEc
  have hDF : D ≠ F := by
    intro heq
    apply hbd
    apply hinj b hb d hd
    rw [← heq] at hFd
    exact same_det_residue_of_coprime hq hDb hFd
  have hEF : E ≠ F := by
    intro heq
    apply hcd
    apply hinj c hc d hd
    rw [← heq] at hFd
    exact same_det_residue_of_coprime hq hEc hFd
  have hDEc := abs_le.mp (candidate_close hr hrn hm hD hE)
  have hDFc := abs_le.mp (candidate_close hr hrn hm hD hF)
  have hEFc := abs_le.mp (candidate_close hr hrn hm hE hF)
  omega

theorem opposite_blocks_dvd_twice {n r m q b c : ℤ} {x : ℝ}
    (hr : 0 < r) (hrn : r < n) (hm : 0 < m)
    (hq : ¬ IsCoprime r q) (hb : IsCoprime r b) (hc : IsCoprime r c)
    (hopp : r ∣ b+c)
    (hbb : Blocks n r m q b x) (hbc : Blocks n r m q c x) : r ∣ 2*q := by
  obtain ⟨D,hD,hd⟩ := hbb
  obtain ⟨E,hE,he⟩ := hbc
  have hDE := same_det_of_not_coprime hr hrn hm hq hb hc hD hE hd he
  subst E
  have hsum : r ∣ D*(b+c)-2*q := by
    have heq : (D*b-q)+(D*c-q)=D*(b+c)-2*q := by ring
    simpa only [heq] using dvd_add hd he
  have hmul : r ∣ D*(b+c) := dvd_mul_of_dvd_right hopp D
  have heq : D*(b+c)-(D*(b+c)-2*q)=2*q := by ring
  simpa only [heq] using dvd_sub hmul hsum

/-- Actual badness at a real clock produces an integral determinant. -/
theorem actual_bad_blocks {n r m q b : ℕ} {a c : ℤ} {z : ℝ}
    (hn : 0 < n) (hr : 0 < r) (hm : 0 < m)
    (hu : a*(b:ℤ)-c*r=1)
    (hbad : ndist ((q:ℝ)*((a:ℝ)/r-z/((n:ℝ)*m*r))) ≤ 1/(n:ℝ)) :
    Blocks (n:ℤ) r m q b ((q:ℝ)*z) := by
  let j : ℤ := round ((q:ℝ)*((a:ℝ)/r-z/((n:ℝ)*m*r)))
  refine ⟨(q:ℤ)*a-r*j,?_,?_⟩
  · have hh := SharedMiddleArithmetic.scaled_band
      (n:=(n:ℤ)) (r:=(r:ℤ)) (m:=(m:ℤ)) (p:=(q:ℤ)) (a:=a) (j:=j)
      (by exact_mod_cast hn) (by exact_mod_cast hr) (by exact_mod_cast hm) hbad
    simpa only [Candidate,Int.cast_natCast] using hh
  · refine ⟨(q:ℤ)*c-j*b,?_⟩
    linear_combination (q:ℤ)*hu



@[simp] theorem mem_badUnits {n r m q b : ℕ} {x : ℝ} :
    b ∈ badUnits n r m q x ↔ b ∈ units r ∧ Blocks (n:ℤ) r m q b x := by
  classical simp [badUnits]

/-- At any fixed real clock a non-half-phase blocker covers at most two units,
or at most half the units. -/
theorem capacity {n r m q : ℕ} {x : ℝ}
    (hr : 1 < r) (hrn : r < n) (hm : 0 < m) (hnot : ¬r ∣ 2*q) :
    (badUnits n r m q x).card ≤ 2 ∨ 2*(badUnits n r m q x).card ≤ r.totient := by
  classical
  by_cases hcop : Nat.Coprime r q
  · left
    apply coprime_blocker_card (n:=(n:ℤ)) (r:=(r:ℤ)) (m:=(m:ℤ))
      (q:=(q:ℤ)) (badUnits n r m q x) (fun b => (b:ℤ))
      (by exact_mod_cast (show 0 < r by omega)) (by exact_mod_cast hrn)
      (by exact_mod_cast hm) hcop.isCoprime
    · intro b hb c hc hd
      have hb' := (mem_units.mp (mem_badUnits.mp hb).1).1
      have hc' := (mem_units.mp (mem_badUnits.mp hc).1).1
      have heq := (Nat.modEq_iff_dvd.mpr hd).symm
      change b%r=c%r at heq
      simpa only [Nat.mod_eq_of_lt hb',Nat.mod_eq_of_lt hc'] using heq
    · intro b hb
      exact (mem_badUnits.mp hb).2
  · right
    apply no_opposite_half_card hr (fun b hb => (mem_badUnits.mp hb).1)
    intro b hb hc
    obtain ⟨hbu,hbb⟩ := mem_badUnits.mp hb
    obtain ⟨hcu,hcb⟩ := mem_badUnits.mp hc
    have hd := opposite_blocks_dvd_twice (n:=(n:ℤ)) (r:=(r:ℤ)) (m:=(m:ℤ))
      (q:=(q:ℤ)) (b:=(b:ℤ)) (c:=((r-b:ℕ):ℤ))
      (by exact_mod_cast (show 0 < r by omega)) (by exact_mod_cast hrn)
      (by exact_mod_cast hm) (fun h => hcop h.natCoprime)
      (mem_units.mp hbu).2.isCoprime (mem_units.mp hcu).2.isCoprime
      (by rw [Nat.cast_sub (mem_units.mp hbu).1.le]; simp) hbb hcb
    apply hnot
    exact_mod_cast hd

/-- Modular reduction preserves the real determinant certificate. -/
theorem blocks_mod {n r m q b : ℕ} {x : ℝ}
    (hb : Blocks (n:ℤ) r m q b x) : Blocks (n:ℤ) r m q ((b%r:ℕ):ℤ) x := by
  obtain ⟨D,hD,hd⟩ := hb
  refine ⟨D,hD,?_⟩
  have hmod : (r:ℤ) ∣ (b:ℤ)-(b%r:ℕ) := Nat.modEq_iff_dvd.mp (Nat.mod_mod b r)
  have heq : (D*(b:ℤ)-q)-D*((b:ℤ)-(b%r:ℕ))=D*(b%r:ℕ)-q := by ring
  simpa only [heq] using dvd_sub hd (dvd_mul_of_dvd_right hmod D)

/-- At least one primitive flank with the terminal margin is safe from an
arbitrary non-half-phase blocker, at every prescribed real clock. -/
theorem exists_safe_at_clock {n r m q : ℕ} {z : ℝ}
    (hr : 1 < r) (hrn : r < n) (hm : 0 < m) (heven : Even r)
    (hphi : 4 ≤ r.totient) (hnot : ¬r ∣ 2*q) :
    ∃b ∈ primitiveFlanks n r, b ≤ n-3 ∧
      1/(n:ℝ) < ndist ((q:ℝ)*((numerator r b:ℝ)/r-z/((n:ℝ)*m*r))) := by
  classical
  let U := (primitiveFlanks n r).filter (fun b => b ≤ n-3)
  let B := badUnits n r m q ((q:ℝ)*z)
  by_contra! hno
  have hmap : ∀b ∈ U, b%r ∈ B := by
    intro b hb
    obtain ⟨hbf,hbs⟩ := Finset.mem_filter.mp hb
    obtain ⟨_,_,hbc⟩ := mem_primitiveFlanks.mp hbf
    apply mem_badUnits.mpr
    refine ⟨mem_units.mpr ⟨Nat.mod_lt _ (by omega),?_⟩,?_⟩
    · change Nat.gcd r (b%r)=1
      rw [Nat.gcd_comm,← Nat.gcd_rec]
      exact hbc
    · exact blocks_mod (actual_bad_blocks (by omega : 0 < n) (by omega : 0 < r) hm
        (numerator_unit hbc) (hno b hbf hbs))
  have hc : U.card ≤ B.card := by
    apply Finset.card_le_card_of_injOn (fun b => b%r) hmap
    intro b hb c hc heq
    exact primitiveFlanks_mod_injective (Finset.mem_filter.mp hb).1
      (Finset.mem_filter.mp hc).1 heq
  have hs := terminal_survivor_card hrn.le heven
  have hcap := capacity (x:=(q:ℝ)*z) hr hrn hm hnot
  change r.totient ≤ U.card+1 at hs
  rcases hcap with hh | hh <;> change _ at hh <;> dsimp [B] at hc <;> omega

