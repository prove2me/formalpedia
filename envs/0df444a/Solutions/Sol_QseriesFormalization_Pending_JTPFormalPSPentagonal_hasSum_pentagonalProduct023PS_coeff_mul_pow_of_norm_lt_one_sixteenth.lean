    Summable fun n : ℕ => ‖-q ^ k * (q ^ 5) ^ n‖ := by
  have hq5 : ‖q ^ 5‖ < 1 := by
    rw [norm_pow]
    exact pow_lt_one₀ (norm_nonneg q) hq (by norm_num)
  exact Ch02.summable_norm_mul_geometric_complex (-(q ^ k)) (q ^ 5) hq5

/-- The k-th mod-5 residue factor family is multipliable for ‖q‖ < 1. -/
