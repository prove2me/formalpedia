noncomputable def outerEnvelope (x alpha : ℝ) (d : ℕ) : ℝ :=
  safeCap (ordinaryDivisorCap x (d : ℝ))
    (ordinaryReciprocalBudget x)
    (Real.pi * (2 * alpha) * (d : ℝ))
def InitialHalfBlockBound : Prop :=
  ∀ (x : ℝ) (a q M : ℕ) (gamma beta : ℝ),
    1 ≤ x → 4 ≤ q → Nat.Coprime a q →
    2 * gamma = (a : ℝ) / (q : ℝ) + beta →
    |beta| ≤ 1 / (q : ℝ) ^ 2 →
    (∑ d ∈ initialOddDivisors M q,
      safeCap (ordinaryDivisorCap x (d : ℝ))
        (ordinaryReciprocalBudget x)
        (Real.pi * gamma * (d : ℝ))) ≤
      (1 / 2 : ℝ) * ordinaryReciprocalBudget x *
        oddVinogradovBlockConstant q
end TaoFivePrimes.TypeIOrdinaryFinalAssembly
