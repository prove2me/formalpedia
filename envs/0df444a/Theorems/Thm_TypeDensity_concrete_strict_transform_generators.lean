open TypeDensity
open scoped BigOperators ENNReal
variable (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)] (pi : O)
  (hpi : Irreducible pi) (u : (TwoSeries O)ˣ) (a b : ℕ) (ha : 0 < a)
include hpi ha

theorem TypeDensity.concrete_strict_transform_generators (d : ℕ) (f : (ConcreteSurface O pi u a b)) (c : Fin (d + 1) → (ConcreteSurface O pi u a b))
    (hc : f = ∑ i : Fin (d + 1), c i * (surfaceT O pi u a b) ^ (d - i.val) * (surfaceX O pi u a b) ^ i.val) (P : Ideal (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)))
    [P.IsMaximal] [P.IsPrime] (hP : chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) ∈ P) (Pinf : Ideal (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)))
    [Pinf.IsMaximal] [Pinf.IsPrime] (hx : chartBase (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) ∈ Pinf)
    (hW : chartSlope (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) ∈ Pinf) :
    strictTransformAt (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) P d (Ideal.span {f}) = Ideal.span {completedPointMap
      (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) P
      (∑ i : Fin (d+1), algebraMap (ConcreteSurface O pi u a b) (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (c i) * chartSlope (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) ^ i.val)} ∧
    strictTransformAt (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) Pinf d (Ideal.span {f}) = Ideal.span {completedPointMap
      (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) Pinf
      (∑ i : Fin (d+1),
        algebraMap (ConcreteSurface O pi u a b) (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) (c i) * chartSlope (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) ^ (d - i.val))} := by sorry
