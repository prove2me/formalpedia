open Filter Asymptotics

private theorem exists_entire_boundedOnStrips_eq {Z Zd PT PA Pd Λ Λd γ : ℂ → ℂ} {c κb ε κ : ℂ} {N σ₁ σ₂ : ℝ}
    (hPT : Differentiable ℂ PT) (hPTb : BoundedOnStrips PT) (hPA : Differentiable ℂ PA)
    (hPAe : ExpTypeOnStrips PA) (hΛ : Differentiable ℂ Λ) (hΛb : BoundedOnStrips Λ)
    (hfe : ∀ s : ℂ, Λ s = ε * (N : ℂ) ^ (κ - s) * Λd (2 * κ - s))
    (hR : ∀ s : ℂ, σ₁ < s.re → Z s = PT s * PA s * Λ s)
    (hBR : ∀ a b : ℝ, σ₁ < a → ∃ C : ℝ, ∀ s : ℂ, a ≤ s.re → s.re ≤ b → ‖Z s‖ ≤ C)
    (hL : ∀ s : ℂ, s.re < σ₂ → Zd (1 - s) = κb * (Pd s * Λd (2 * κ - s)))
    (hBL : ∀ a b : ℝ, b < σ₂ → ∃ C : ℝ, ∀ s : ℂ, a ≤ s.re → s.re ≤ b → ‖Zd (1 - s)‖ ≤ C)
    (hbox : c * κb = 1) (hM₁ : ∀ s : ℂ, γ s = ε * (N : ℂ) ^ (κ - s))
    (hM₂ : ∀ s : ℂ, Pd s = γ s * (PT s * PA s)) :
    ∃ E : ℂ → ℂ, Differentiable ℂ E ∧ BoundedOnStrips E ∧ ∃ σ₁ σ₂ : ℝ,
      (∀ s : ℂ, σ₁ < s.re → E s = Z s) ∧ (∀ s : ℂ, s.re < σ₂ → E s = c * Zd (1 - s)) := by
  have hER : ∀ s : ℂ, σ₁ < s.re → PT s * PA s * Λ s = Z s := fun s hs => (hR s hs).symm
  have hEL : ∀ s : ℂ, s.re < σ₂ → PT s * PA s * Λ s = c * Zd (1 - s) := fun s hs =>
    calc PT s * PA s * Λ s = ε * (N : ℂ) ^ (κ - s) * (PT s * PA s) * Λd (2 * κ - s) := by rw [hfe s]; ring
      _ = c * κb * (Pd s * Λd (2 * κ - s)) := by rw [hbox, ← hM₁ s, hM₂ s]; ring
      _ = c * Zd (1 - s) := by rw [hL s hs]; ring
  have hE : Differentiable ℂ fun s => PT s * PA s * Λ s := by fun_prop
  refine ⟨fun s => PT s * PA s * Λ s, hE, fun a b => ?_, σ₁, σ₂, hER, hEL⟩

  obtain ⟨σ₁', h1⟩ : ∃ σ₁' : ℝ, σ₁ < σ₁' := ⟨σ₁ + 1, lt_add_one σ₁⟩
  obtain ⟨σ₂', h2, h12⟩ : ∃ σ₂' : ℝ, σ₂' < σ₂ ∧ σ₂' < σ₁' :=
    ⟨min σ₂ σ₁' - 1, (sub_one_lt _).trans_le (min_le_left _ _), (sub_one_lt _).trans_le (min_le_right _ _)⟩
  obtain ⟨CR, hCR⟩ := hBR σ₁' (max b σ₁') h1
  obtain ⟨CL, hCL⟩ := hBL (min a σ₂') σ₂' h2

  obtain ⟨CM, hCM⟩ : ∃ C : ℝ, ∀ s : ℂ, σ₂' ≤ s.re → s.re ≤ σ₁' → ‖PT s * PA s * Λ s‖ ≤ C := by
    obtain ⟨K₁, hK₁⟩ := hPTb σ₂' σ₁'
    obtain ⟨K₂, hK₂⟩ := hΛb σ₂' σ₁'
    obtain ⟨C₃, A, hC₃⟩ := hPAe σ₂' σ₁'

    have hgrowth : ∀ s : ℂ, σ₂' ≤ s.re → s.re ≤ σ₁' →
        ‖PT s * PA s * Λ s‖ ≤ max (K₁ * C₃ * K₂) 0 * Real.exp (max A 0 * |s.im|) := by
      intro s ha hb
      have hP := hK₁ s ha hb
      have hI := hC₃ s ha hb
      have hΛs := hK₂ s ha hb
      have h12' : ‖PT s‖ * ‖PA s‖ ≤ K₁ * (C₃ * Real.exp (A * |s.im|)) :=
        mul_le_mul hP hI (norm_nonneg _) ((norm_nonneg _).trans hP)
      have h123 : ‖PT s‖ * ‖PA s‖ * ‖Λ s‖ ≤ K₁ * (C₃ * Real.exp (A * |s.im|)) * K₂ :=
        mul_le_mul h12' hΛs (norm_nonneg _) ((mul_nonneg (norm_nonneg _) (norm_nonneg _)).trans h12')
      rw [norm_mul, norm_mul]
      refine h123.trans ?_
      have hexp : 0 < Real.exp (A * |s.im|) := Real.exp_pos _
      calc K₁ * (C₃ * Real.exp (A * |s.im|)) * K₂ = K₁ * C₃ * K₂ * Real.exp (A * |s.im|) := by ring
        _ ≤ max (K₁ * C₃ * K₂) 0 * Real.exp (A * |s.im|) := mul_le_mul_of_nonneg_right (le_max_left _ _) hexp.le
        _ ≤ max (K₁ * C₃ * K₂) 0 * Real.exp (max A 0 * |s.im|) :=
          mul_le_mul_of_nonneg_left
            (Real.exp_le_exp.2 (mul_le_mul_of_nonneg_right (le_max_left _ _) (abs_nonneg _))) (le_max_right _ _)

    have hq : 0 < Real.pi / (σ₁' - σ₂') := div_pos Real.pi_pos (sub_pos.2 h12)
    obtain ⟨r, hr0, hrπ⟩ : ∃ r : ℝ, 0 < r ∧ r < Real.pi / (σ₁' - σ₂') :=
      ⟨Real.pi / (σ₁' - σ₂') / 2, half_pos hq, half_lt_self_iff.2 hq⟩
    have hO : (fun s => PT s * PA s * Λ s)
        =O[comap (_root_.abs ∘ Complex.im) atTop ⊓ 𝓟 (Complex.re ⁻¹' Set.Ioo σ₂' σ₁')]
        fun z => Real.exp (max A 0 / r * Real.exp (r * |z.im|)) := by
      refine IsBigO.of_bound (max (K₁ * C₃ * K₂) 0) (eventually_inf_principal.2 (Eventually.of_forall fun z hz => ?_))
      show ‖PT z * PA z * Λ z‖ ≤ _
      rw [Real.norm_of_nonneg (Real.exp_pos _).le]
      exact (hgrowth z (le_of_lt hz.1) (le_of_lt hz.2)).trans
        (mul_le_mul_of_nonneg_left (exp_le_exp_mul_exp (le_max_right _ _) hr0 (abs_nonneg _)) (le_max_right _ _))
    refine ⟨max CR (‖c‖ * CL), fun s ha hb => ?_⟩
    refine PhragmenLindelof.vertical_strip (f := fun s => PT s * PA s * Λ s)
      hE.diffContOnCl ⟨r, hrπ, max A 0 / r, hO⟩ (fun z hz => ?_) (fun z hz => ?_) ha hb
    ·
      show ‖PT z * PA z * Λ z‖ ≤ _
      rw [hEL z (hz ▸ h2), norm_mul]
      exact (mul_le_mul_of_nonneg_left (hCL z (hz ▸ min_le_right a σ₂') hz.le) (norm_nonneg c)).trans
        (le_max_right _ _)
    ·
      show ‖PT z * PA z * Λ z‖ ≤ _
      rw [hER z (hz ▸ h1)]
      exact (hCR z hz.ge (hz ▸ le_max_right b σ₁')).trans (le_max_left _ _)

  refine ⟨max CR (max (‖c‖ * CL) CM), fun s ha hb => ?_⟩
  show ‖PT s * PA s * Λ s‖ ≤ _
  rcases le_or_gt σ₁' s.re with hr | hr
  · rw [hER s (h1.trans_le hr)]
    exact (hCR s hr (hb.trans (le_max_left b σ₁'))).trans (le_max_left _ _)
  rcases le_or_gt s.re σ₂' with hl | hl
  · rw [hEL s (hl.trans_lt h2), norm_mul]
    exact (mul_le_mul_of_nonneg_left (hCL s ((min_le_left a σ₂').trans ha) hl) (norm_nonneg c)).trans
      ((le_max_left _ _).trans (le_max_right _ _))
  · exact (hCM s hl.le hr.le).trans ((le_max_right _ _).trans (le_max_right _ _))

end

