private theorem map_pentagonal023SeriesPS_int
    (R : Type*) [CommRing R] :
    PowerSeries.map (Int.castRingHom R) (pentagonal023SeriesPS ℤ) =
      pentagonal023SeriesPS R := by
  ext n
