section Bruhat

variable {K : Type*} [Field K]

private def bruhatShift (β : GL (Fin 2) K) (ξ : K) : K :=
  ((β : Matrix (Fin 2) (Fin 2) K) 0 1 + ξ * (β : Matrix (Fin 2) (Fin 2) K) 1 1) / (β : Matrix (Fin 2) (Fin 2) K) 0 0

private def bruhatShiftEquiv {β : GL (Fin 2) K} (hβ : β ∈ borelSubgroup K) : K ≃ K where
  toFun := bruhatShift β
  invFun ξ' := (ξ' * (β : Matrix (Fin 2) (Fin 2) K) 0 0 - (β : Matrix (Fin 2) (Fin 2) K) 0 1)
    / (β : Matrix (Fin 2) (Fin 2) K) 1 1
  left_inv ξ := by
    have ha : (β : Matrix (Fin 2) (Fin 2) K) 0 0 ≠ 0 := by
      have h := (borelDiagFst (⟨β, hβ⟩ : ↥(borelSubgroup K))).ne_zero
      rwa [borelDiagFst_apply_val] at h
    have hd : (β : Matrix (Fin 2) (Fin 2) K) 1 1 ≠ 0 := by
      have h := (borelDiagSnd (⟨β, hβ⟩ : ↥(borelSubgroup K))).ne_zero
      rwa [borelDiagSnd_apply_val] at h
    simp only [bruhatShift]
    field_simp
    ring
  right_inv ξ' := by
    have ha : (β : Matrix (Fin 2) (Fin 2) K) 0 0 ≠ 0 := by
      have h := (borelDiagFst (⟨β, hβ⟩ : ↥(borelSubgroup K))).ne_zero
      rwa [borelDiagFst_apply_val] at h
    have hd : (β : Matrix (Fin 2) (Fin 2) K) 1 1 ≠ 0 := by
      have h := (borelDiagSnd (⟨β, hβ⟩ : ↥(borelSubgroup K))).ne_zero
      rwa [borelDiagSnd_apply_val] at h
    simp only [bruhatShift]
    field_simp
    ring

@[scoped simp] private theorem bruhatShiftEquiv_apply {β : GL (Fin 2) K} (hβ : β ∈ borelSubgroup K) (ξ : K) :
    bruhatShiftEquiv hβ ξ = bruhatShift β ξ := rfl

end Bruhat
