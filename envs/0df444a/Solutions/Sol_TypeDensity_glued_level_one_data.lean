      ∀ i : Fin (TypeDensity.curveDataDegree D+1),
        (TypeDensity.divisorAffinePolynomial (IsLocalRing.ResidueField R) Dv * Polynomial.C a).coeff i.val =
          IsLocalRing.residue R (c i) := by
