attribute [local instance 100] LieRing.ofAssociativeRing

section Geometry

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Lemma A.2, PDF pp. 27–28. The generated cone includes the closure shown in the PDF. -/
theorem coneHull_pointed_of_recession [FiniteDimensional ℝ E] (C : Set E)
    (hc : IsClosed C) (hv : Convex ℝ C) (hr : Pointed (recession C)) (hz : (0 : E) ∉ C) :
    Pointed (closedConeHull C) := by sorry

