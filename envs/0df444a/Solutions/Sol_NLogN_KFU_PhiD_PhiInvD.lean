open IntMul KFC AModel AModelL12
variable {d : ℕ} {sF μ : ℕ → ℕ}
theorem solution (H : NLogN.KFU.CrtOK d sF μ) (h : ℕ) (bL : ℕ → Bool) (hst : ∀ j < d, sF j ≤ 2 ^ h)
    (ys : List ℤ) (hlen : ys.length = AModel.vol (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)))
    (hz : ∀ b, AModel.Valid (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) b → ¬ AModel.Valid (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) b →
      ys.getD (AModel.encode (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) b) 0 = 0) :
    NLogN.KFU.PhiD h d bL sF μ (NLogN.KFU.PhiInvD h d bL sF μ ys) = ys := by
  classical
  rw [NLogN.KFU.PhiD_eq H h bL hst]
  apply List.ext_getElem (by simp [hlen])
  intro j h1 h2
  simp only [List.length_map, List.length_range] at h1
  rw [List.getElem_map, List.getElem_range]
  set b := AModel.decode (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) j
  have hvT : AModel.Valid (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) b := AModel.valid_decode h1
  have ej : ys[j] = ys.getD (AModel.encode (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) b) 0 := by
    rw [AModel.encode_decode h1, List.getD_eq_getElem]
  rw [ej]
  split_ifs with hv
  · obtain ⟨hk, hb⟩ := NLogN.KFU.cover H hv
    rw [NLogN.KFU.PhiInvD_at h d bL sF μ H.pos hst H.inv ys _ _ hk (NLogN.KFU.cover_c d sF hv), hb]
  · exact (hz b hvT hv).symm
end
