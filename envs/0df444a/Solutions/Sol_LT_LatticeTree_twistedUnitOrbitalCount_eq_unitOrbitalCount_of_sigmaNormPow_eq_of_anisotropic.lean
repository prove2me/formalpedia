        rw [hm, pow_succ', RingHom.coe_mul, Function.comp_apply, heven m] at hper
        exact hper
      · have e : φ a = φ (φ a) := by linear_combination (sub_eq_zero.mp hB) - (sub_eq_zero.mp hD)
        exact (φ.injective e).symm

  obtain ⟨a₀, ha₀⟩ := hφfix a haφ
  have hform : Y₀.map (algebraMap k F) - a • (1 : Matrix (Fin 2) (Fin 2) F)
      = (Y₀ - a₀ • (1 : Matrix (Fin 2) (Fin 2) k)).map (algebraMap k F) := by
