open ED2Aux in
theorem solution
    {g d n : ℕ} (hn : 3 ≤ n) {S : Type} [CommRing S] (hn' : IsUnit ((n : ℕ) : S))
    {k : ℕ} (r : Fin k → S) (hr : Ideal.span (Set.range r) = ⊤)
    [Module.FaithfullyFlat S (∀ i : Fin k, Localization.Away (r i))]
    (u₁ u₂ : PolarisedAbelianScheme g d n S) (w₁ w₂ : PolarisedAbelianScheme g d n (∀ i : Fin k, Localization.Away (r i)))
    (h₁ : PolarisedAbelianScheme.IsPullback (algebraMap S (∀ i : Fin k, Localization.Away (r i))) u₁ w₁)
    (h₂ : PolarisedAbelianScheme.IsPullback (algebraMap S (∀ i : Fin k, Localization.Away (r i))) u₂ w₂)
    (h : PolarisedAbelianScheme.Iso w₁ w₂) :
    PolarisedAbelianScheme.Iso u₁ u₂ := by
  classical
  obtain ⟨c₁, hc₁, ⟨κ₁⟩⟩ := Cmp.of_isPullback h₁
  obtain ⟨c₂, hc₂, ⟨κ₂⟩⟩ := Cmp.of_isPullback h₂
  obtain ⟨e, he, hemul, heP, hepol⟩ := h

  have he' : e.inv ≫ w₁.f = w₂.f := by rw [← he, Iso.inv_hom_id_assoc]
  have hemul' : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of (∀ i : Fin k, Localization.Away (r i)))) (x y : SchemeHomOver t w₂.f),
      (w₂.L.mul t x y).1 ≫ e.inv =
        (w₁.L.mul t ⟨x.1 ≫ e.inv, by rw [Category.assoc, he']; exact x.2⟩
          ⟨y.1 ≫ e.inv, by rw [Category.assoc, he']; exact y.2⟩).1 := by
    intro T t x y
    have h0 := hemul t ⟨x.1 ≫ e.inv, by rw [Category.assoc, he']; exact x.2⟩
      ⟨y.1 ≫ e.inv, by rw [Category.assoc, he']; exact y.2⟩
    have h2 := congrArg (· ≫ e.inv) h0
    simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id] at h2
    rw [h2]
    congr 1
    exact mul_val_congr w₂.L rfl _ _ _ _
      (show x.1 = (x.1 ≫ e.inv) ≫ e.hom by rw [Category.assoc, Iso.inv_hom_id, Category.comp_id])
      (show y.1 = (y.1 ≫ e.inv) ≫ e.hom by rw [Category.assoc, Iso.inv_hom_id, Category.comp_id])
  have heP' : ∀ i, (w₂.P i).1 ≫ e.inv = (w₁.P i).1 := fun i => by
    rw [← heP i, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hepol' : LocIso w₂.f ((Scheme.Modules.pullback e.inv).obj w₁.pol) w₂.pol := by
    have hk : e.inv ≫ w₁.f = w₂.f ≫ Spec.map (CommRingCat.ofHom (RingHom.id (∀ i : Fin k, Localization.Away (r i)))) := by
      rw [he', CommRingCat.ofHom_id, Spec.map_id, Category.comp_id]
    have L0 := LocIso.pullback _ e.inv hk hepol
    exact L0.symm.trans (LocIso.of_iso ((pullbackCompIso e.inv e.hom w₂.pol).symm ≪≫
      (Scheme.Modules.pullbackCongr e.inv_hom_id).app w₂.pol ≪≫ (Scheme.Modules.pullbackId _).app w₂.pol))

  have hψ₁ : Cmp (algebraMap S (∀ i : Fin k, Localization.Away (r i))) u₂ w₁ (e.hom ≫ c₂) := hc₂.of_iso e he hemul heP
  have hψ₂ : Cmp (algebraMap S (∀ i : Fin k, Localization.Away (r i))) u₁ w₂ (e.inv ≫ c₁) := hc₁.of_iso e.symm he' hemul' heP'
  have hψpol₁ : LocIso w₁.f ((Scheme.Modules.pullback (e.hom ≫ c₂)).obj u₂.pol) w₁.pol :=
    (LocIso.of_iso (pullbackCompIso e.hom c₂ u₂.pol ≪≫ (Scheme.Modules.pullback e.hom).mapIso κ₂)).trans hepol
  have hψpol₂ : LocIso w₂.f ((Scheme.Modules.pullback (e.inv ≫ c₁)).obj u₁.pol) w₂.pol :=
    (LocIso.of_iso (pullbackCompIso e.inv c₁ u₁.pol ≪≫ (Scheme.Modules.pullback e.inv).mapIso κ₁)).trans hepol'
  obtain ⟨⟨E₁, hE₁⟩, uniq₁⟩ := descend hn hn' u₁ u₂ w₁ c₁ hc₁ κ₁ (e.hom ≫ c₂) hψ₁ hψpol₁
  obtain ⟨⟨E₂, hE₂⟩, uniq₂⟩ := descend hn hn' u₂ u₁ w₂ c₂ hc₂ κ₂ (e.inv ≫ c₁) hψ₂ hψpol₂
  have h12 : E₁ ≫ E₂ = 𝟙 _ := uniq₁ _ _ (by
    rw [← Category.assoc, hE₁, Category.assoc, hE₂, ← Category.assoc, Iso.hom_inv_id, Category.id_comp, Category.comp_id])
  have h21 : E₂ ≫ E₁ = 𝟙 _ := uniq₂ _ _ (by
    rw [← Category.assoc, hE₂, Category.assoc, hE₁, ← Category.assoc, Iso.inv_hom_id, Category.id_comp, Category.comp_id])
  let E : u₁.A ≅ u₂.A := ⟨E₁, E₂, h12, h21⟩
  have hEf : E.hom ≫ u₂.f = u₁.f := uniq₁ _ _ (by
    show c₁ ≫ E₁ ≫ u₂.f = c₁ ≫ u₁.f
    rw [← Category.assoc, hE₁, Category.assoc, hc₂.sq.w, ← Category.assoc, he, hc₁.sq.w])
  refine ⟨E, hEf, ?_, ?_, ?_⟩
  ·
    intro T t x y
    apply baseChange_epi (S' := (∀ i : Fin k, Localization.Away (r i))) t
    set π := pullback.fst t (Spec.map (CommRingCat.ofHom (algebraMap S (∀ i : Fin k, Localization.Away (r i))))) with hπdef
    set σ := pullback.snd t (Spec.map (CommRingCat.ofHom (algebraMap S (∀ i : Fin k, Localization.Away (r i))))) with hσdef
    have hπ : π ≫ t = σ ≫ Spec.map (CommRingCat.ofHom (algebraMap S (∀ i : Fin k, Localization.Away (r i)))) := pullback.condition
    have wx : (π ≫ x.1) ≫ u₁.f = σ ≫ Spec.map (CommRingCat.ofHom (algebraMap S (∀ i : Fin k, Localization.Away (r i)))) := by rw [Category.assoc, x.2, hπ]
    have wy : (π ≫ y.1) ≫ u₁.f = σ ≫ Spec.map (CommRingCat.ofHom (algebraMap S (∀ i : Fin k, Localization.Away (r i)))) := by rw [Category.assoc, y.2, hπ]
    let xt : SchemeHomOver σ w₁.f := ⟨hc₁.sq.lift (π ≫ x.1) σ wx, hc₁.sq.lift_snd _ _ _⟩
    let yt : SchemeHomOver σ w₁.f := ⟨hc₁.sq.lift (π ≫ y.1) σ wy, hc₁.sq.lift_snd _ _ _⟩
    have hxt : xt.1 ≫ c₁ = π ≫ x.1 := hc₁.sq.lift_fst _ _ _
    have hyt : yt.1 ≫ c₁ = π ≫ y.1 := hc₁.sq.lift_fst _ _ _
    have A := congrArg Subtype.val (u₁.L.mul_natural t (π ≫ t) π rfl x y)
    rw [GoodReductionJacobian.schemeHomOverComp_coe] at A
    have B : (u₁.L.mul (π ≫ t) (schemeHomOverComp π rfl x) (schemeHomOverComp π rfl y)).1 =
        (w₁.L.mul σ xt yt).1 ≫ c₁ := by
      rw [hc₁.mul]
      exact mul_val_congr u₁.L hπ _ _ _ _
        (show π ≫ x.1 = xt.1 ≫ c₁ by rw [hxt]) (show π ≫ y.1 = yt.1 ≫ c₁ by rw [hyt])
    have C := hψ₁.mul σ xt yt
    have D := fun (X Y : SchemeHomOver t u₂.f) => congrArg Subtype.val (u₂.L.mul_natural t (π ≫ t) π rfl X Y)
    simp only [GoodReductionJacobian.schemeHomOverComp_coe] at D
    show π ≫ (u₁.L.mul t x y).1 ≫ E₁ = π ≫ _
    rw [← Category.assoc π, A, B, Category.assoc, hE₁, C, D]
    exact mul_val_congr u₂.L hπ.symm _ _ _ _
      (show xt.1 ≫ e.hom ≫ c₂ = π ≫ (x.1 ≫ E₁) by rw [← hE₁, ← Category.assoc, hxt, Category.assoc])
      (show yt.1 ≫ e.hom ≫ c₂ = π ≫ (y.1 ≫ E₁) by rw [← hE₁, ← Category.assoc, hyt, Category.assoc])
  ·
    intro i
    apply specMap_epi (S' := (∀ i : Fin k, Localization.Away (r i)))
    show _ ≫ (u₁.P i).1 ≫ E₁ = _
    rw [← Category.assoc, ← hc₁.lev i, Category.assoc, hE₁]
    exact hψ₁.lev i
  ·
    have hloc : LocIso w₁.f ((Scheme.Modules.pullback c₁).obj ((Scheme.Modules.pullback E₁).obj u₂.pol))
        ((Scheme.Modules.pullback c₁).obj u₁.pol) :=
      (LocIso.of_iso ((pullbackCompIso c₁ E₁ u₂.pol).symm ≪≫ (Scheme.Modules.pullbackCongr hE₁).app u₂.pol)).trans
        (hψpol₁.trans (LocIso.of_iso κ₁.symm))
    exact AlgebraicGeometry.Scheme.Modules.locallyIso_of_locallyIso_pullback_pi_localizationAway r hr u₁.f w₁.f c₁ hc₁.sq
      ((Scheme.Modules.pullback E₁).obj u₂.pol) u₁.pol hloc

end

