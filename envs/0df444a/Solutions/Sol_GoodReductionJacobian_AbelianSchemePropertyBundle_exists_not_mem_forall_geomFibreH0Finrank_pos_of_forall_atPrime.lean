theorem solution
    {S : Type} [CommRing S] [IsNoetherianRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) (hA : AbelianSchemePropertyBundle S f)
    (𝓛 : A.Modules) (h𝓛 : Scheme.Modules.IsInvertible 𝓛) (hK : KernelIsTwoTorsion f L 𝓛)
    (𝔭 : PrimeSpectrum S)
    (hpos : ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : S →+* k),
      (∀ s : S, s ∉ 𝔭.asIdeal → sk s ≠ 0) → 0 < Scheme.Modules.geomFibreH0Finrank f 𝓛 k sk) :
    ∃ g : S, g ∉ 𝔭.asIdeal ∧
      ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : S →+* k), sk g ≠ 0 → 0 < Scheme.Modules.geomFibreH0Finrank f 𝓛 k sk := by
  haveI : IsProper f := hA.proper
  haveI : Smooth f := hA.smooth
  haveI : Flat f := inferInstance
  haveI : CompactSpace ↥A := QuasiCompact.compactSpace_of_compactSpace f
  obtain ⟨𝒰⟩ := nonempty_orderedAffineCover A

  obtain ⟨g₁, hg₁, χ₀, hχ⟩ :=
    OModulePresheaf.exists_notMem_forall_eulerChar_baseChange_eq_of_locallyTrivial f 𝓛 h𝓛.exists_trivialization 𝒰 𝔭

  let κ₀ := 𝔭.asIdeal.ResidueField
  let k₀ := AlgebraicClosure κ₀
  have hk₀ : ∀ s : S, s ∉ 𝔭.asIdeal → algebraMap S k₀ s ≠ 0 := by
    intro s hs h
    rw [IsScalarTower.algebraMap_apply S κ₀ k₀, map_eq_zero_iff _ (algebraMap κ₀ k₀).injective,
      Ideal.algebraMap_residueField_eq_zero] at h
    exact hs h
  have hpos₀ : 0 < Scheme.Modules.geomFibreH0Finrank f 𝓛 k₀ (algebraMap S k₀) := hpos k₀ _ hk₀
  have hvan₀ := subsingleton_HSucc_fibre f L hA 𝓛 h𝓛 hK k₀ hpos₀

  have hχ₀pos : 0 < χ₀ := by
    rw [← hχ k₀ (hk₀ g₁ hg₁), ← geomFibreH0Finrank_eq_eulerChar f 𝓛 k₀ (𝒰.baseChange f k₀) (hvan₀ _)]
    exact_mod_cast hpos₀

  let Z : ℕ → Set (PrimeSpectrum S) := fun i => {q : PrimeSpectrum S | 1 ≤
      (OModulePresheaf.ofModules
          (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S q.asIdeal.ResidueField))
          ((Scheme.Modules.pullback
            (pullback.fst f (Scheme.TwoAffineOpenCover.specMap S q.asIdeal.ResidueField))).obj 𝓛)).cechFinrank
        (𝒰.baseChange f q.asIdeal.ResidueField) (i + 1)}
  have hZ : ∀ i, IsClosed (Z i) := fun i =>
    OModulePresheaf.isClosed_setOf_le_cechFinrank_baseChange_residueField_of_locallyTrivial f 𝓛
      h𝓛.exists_trivialization 𝒰 (i + 1) 1
  have h𝔭Z : ∀ i, 𝔭 ∉ Z i := by
    intro i hi
    change 1 ≤ _ at hi
    have h1 := OModulePresheaf.cechFinrank_baseChange_eq_of_locallyTrivial_of_field
      (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S κ₀))
      ((Scheme.Modules.pullback (pullback.fst f (Scheme.TwoAffineOpenCover.specMap S κ₀))).obj 𝓛)
      (h𝓛.pullback _).exists_trivialization (𝒰.baseChange f κ₀) k₀ (i + 1)
    have h2 := cechFinrank_iter f κ₀ k₀ (Scheme.TwoAffineOpenCover.specMap S k₀) (specMap_comp_eq S κ₀ k₀) 𝓛 h𝓛
      ((𝒰.baseChange f κ₀).baseChange _ k₀) (𝒰.baseChange f k₀) (i + 1)
    rw [← h1, h2, OModulePresheaf.cechFinrank_succ] at hi
    haveI := hvan₀ (𝒰.baseChange f k₀) i
    rw [Module.finrank_zero_of_subsingleton] at hi
    exact absurd hi (by norm_num)

  let U : Set (PrimeSpectrum S) := (PrimeSpectrum.basicOpen g₁ : Set (PrimeSpectrum S)) ∩
      ⋂ i ∈ Finset.range (Fintype.card 𝒰.ι), (Z i)ᶜ
  have hUopen : IsOpen U := by
    refine (PrimeSpectrum.basicOpen g₁).2.inter ?_
    exact isOpen_biInter_finset fun i _ => (hZ i).isOpen_compl
  have h𝔭U : 𝔭 ∈ U := ⟨hg₁, Set.mem_biInter fun i _ => h𝔭Z i⟩
  obtain ⟨V, ⟨g, rfl⟩, h𝔭g, hgU⟩ := PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open h𝔭U hUopen
  refine ⟨g, h𝔭g, ?_⟩

  intro k _ _ sk hskg
  letI : Algebra S k := sk.toAlgebra
  haveI hprime : (RingHom.ker sk).IsPrime := RingHom.ker_isPrime sk
  let q : PrimeSpectrum S := ⟨RingHom.ker sk, hprime⟩
  haveI : q.asIdeal.IsPrime := hprime
  have hq : q ∈ U := hgU (show g ∉ RingHom.ker sk from fun h => hskg (RingHom.mem_ker.mp h))
  have hqg₁ : sk g₁ ≠ 0 := fun h => hq.1 (RingHom.mem_ker.mpr h)
  have hqZ : ∀ i, i < Fintype.card 𝒰.ι → q ∉ Z i := fun i hi =>
    (Set.mem_iInter₂.mp hq.2) i (Finset.mem_range.mpr hi)

  have hunit : (RingHom.ker sk).primeCompl ≤ (IsUnit.submonoid k).comap sk := by
    intro s hs
    rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
    exact Ne.isUnit (fun h => hs (RingHom.mem_ker.mpr h))
  letI : Algebra q.asIdeal.ResidueField k := (Ideal.ResidueField.lift (RingHom.ker sk) sk le_rfl hunit).toAlgebra
  haveI : IsScalarTower S q.asIdeal.ResidueField k := IsScalarTower.of_algebraMap_eq fun s =>
    (Ideal.ResidueField.lift_algebraMap (RingHom.ker sk) sk le_rfl hunit s).symm
  have hAk := hA.baseChange_of_field (Scheme.TwoAffineOpenCover.specMap S k)
  haveI : IsProper (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k)) := hAk.proper

  have hvan : ∀ i : ℕ, Subsingleton ((OModulePresheaf.ofModules (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k))
      ((Scheme.Modules.pullback (pullback.fst f (Scheme.TwoAffineOpenCover.specMap S k))).obj 𝓛)).HSucc
      (𝒰.baseChange f k) i) := by
    intro i
    by_cases hi : i < Fintype.card 𝒰.ι
    · have h0 : (OModulePresheaf.ofModules (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S q.asIdeal.ResidueField))
          ((Scheme.Modules.pullback
            (pullback.fst f (Scheme.TwoAffineOpenCover.specMap S q.asIdeal.ResidueField))).obj 𝓛)).cechFinrank
          (𝒰.baseChange f q.asIdeal.ResidueField) (i + 1) = 0 := by
        have := hqZ i hi
        change ¬ (1 ≤ _) at this
        omega
      have h1 := OModulePresheaf.cechFinrank_baseChange_eq_of_locallyTrivial_of_field
        (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S q.asIdeal.ResidueField))
        ((Scheme.Modules.pullback (pullback.fst f (Scheme.TwoAffineOpenCover.specMap S q.asIdeal.ResidueField))).obj 𝓛)
        (h𝓛.pullback _).exists_trivialization (𝒰.baseChange f q.asIdeal.ResidueField) k (i + 1)
      have h2 := cechFinrank_iter f q.asIdeal.ResidueField k (Scheme.TwoAffineOpenCover.specMap S k)
        (specMap_comp_eq S q.asIdeal.ResidueField k) 𝓛 h𝓛
        ((𝒰.baseChange f q.asIdeal.ResidueField).baseChange _ k) (𝒰.baseChange f k) (i + 1)
      rw [h0, h2, OModulePresheaf.cechFinrank_succ] at h1
      have hfin := (OModulePresheaf.cechFinite_ofModules_of_locallyTrivial
        (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S k))
        ((Scheme.Modules.pullback (pullback.fst f (Scheme.TwoAffineOpenCover.specMap S k))).obj 𝓛)
        (h𝓛.pullback _).exists_trivialization (𝒰.baseChange f k)).2 i
      haveI := hfin
      exact Module.finrank_zero_iff.mp h1
    · exact subsingleton_HSucc_of_card_le _ _ (by show Fintype.card 𝒰.ι ≤ i + 1; omega)

  have heq := geomFibreH0Finrank_eq_eulerChar f 𝓛 k (𝒰.baseChange f k) hvan
  rw [hχ k hqg₁] at heq
  have : (0 : ℤ) < (Scheme.Modules.geomFibreH0Finrank f 𝓛 k (algebraMap S k) : ℕ) := by rw [heq]; exact hχ₀pos
  exact_mod_cast this

