section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS
theorem solution (n : ℕ) (s : NLogN.IState NLogN.HS) (L3 : List NLogN.Item) (h3 : s.G 3 = .int n :: L3) :
    NLogN.log2P.ok s ∧ NLogN.log2P.run s = s.upd 4 (.int (IntMul.HvdH.log2Bits n) :: s.G 4) ∧
      NLogN.log2P.cost s ≤ NLogN.piCost 3 3 n := by
  refine ⟨NLogN.twoAtanP_ok 3 3 1 2 0 (by norm_num) (by norm_num) n s L3 h3, ?_,
    NLogN.twoAtanP_cost 3 3 1 2 0 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by norm_num) n s L3 h3⟩
  rw [NLogN.log2P, NLogN.twoAtanP_run 3 3 1 2 0 (by norm_num) (by norm_num) n s L3 h3]
  simp only [IntMul.HvdH.log2Bits, IntMul.HvdH.log2Approx, NLogN.atanhInv_eq]
  ring_nf
end
