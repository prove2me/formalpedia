/-- Sums over `ZMod a` as sums over `[0, a)`. -/
lemma sum_zmod_eq_range {a : ℕ} [NeZero a] (f : ℕ → ℂ) :
    ∑ k : ZMod a, f k.val = ∑ n ∈ range a, f n := by
  refine Finset.sum_nbij' (fun k => k.val) (fun n => (n : ZMod a)) ?_ ?_ ?_ ?_ ?_
  · intro k _; simp [ZMod.val_lt]
  · intro n _; simp
  · intro k _; simp
  · intro n hn; simp only [mem_range] at hn; simp [ZMod.val_cast_of_lt hn]
  · intro k _; rfl

/-- A lifted line map is a kernel sum over `[0, a)`. -/
lemma liftL_sum {a b : ℕ} [NeZero a] [NeZero b] (L : (ZMod a → ℂ) →L[ℂ] (ZMod b → ℂ))
    (x : ℕ → ℂ) (m : ℕ) :
    NLogN.KFM.liftL L x m = ∑ n ∈ range a, L (Pi.single (n : ZMod a) 1) (m : ZMod b) * x n := by
  unfold NLogN.KFM.liftL
  rw [clm_kernel L]
  have := sum_zmod_eq_range (a := a)
    (fun n => L (Pi.single (n : ZMod a) 1) (m : ZMod b) * x n)
  simp only [ZMod.natCast_zmod_val] at this
  exact this

