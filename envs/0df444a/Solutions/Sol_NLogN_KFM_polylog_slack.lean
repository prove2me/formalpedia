theorem solution (A : ℕ) (c : ℝ) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n →
    c * (Real.log (6 * (IntMul.lg n : ℝ)) + 1) ^ A ≤ (6 * (IntMul.lg n : ℝ)) ^ κ := by
  have hκ : 0 < κ := by unfold IntMul.OpenAI.RCost.κ; norm_num
  -- (log x + 1)^A = o(x^κ)
  have hlo : (fun x : ℝ => (Real.log x + 1) ^ A) =o[Filter.atTop] fun x => x ^ κ := by
    have h1 : (fun x : ℝ => Real.log x ^ (A : ℝ)) =o[Filter.atTop] fun x => x ^ κ :=
      isLittleO_log_rpow_rpow_atTop (A : ℝ) hκ
    have h2 : (fun x : ℝ => (Real.log x + 1) ^ A) =O[Filter.atTop]
        fun x => Real.log x ^ (A : ℝ) := by
      refine Asymptotics.IsBigO.of_bound (2 ^ A) ?_
      filter_upwards [Filter.eventually_ge_atTop (Real.exp 1)] with x hx
      have hx0 : 0 < x := lt_of_lt_of_le (Real.exp_pos 1) hx
      have hl1 : 1 ≤ Real.log x := by
        rw [← Real.log_exp 1]; exact Real.log_le_log (Real.exp_pos 1) hx
      have hl0 : 0 ≤ Real.log x := by linarith
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (by positivity),
        abs_of_nonneg (Real.rpow_nonneg hl0 _), Real.rpow_natCast]
      calc (Real.log x + 1) ^ A ≤ (2 * Real.log x) ^ A := by
            apply pow_le_pow_left₀ (by linarith); linarith
        _ = 2 ^ A * Real.log x ^ A := mul_pow _ _ _
    exact h2.trans_isLittleO h1
  have hev := (hlo.const_mul_left c).bound (show (0 : ℝ) < 1 by norm_num)
  obtain ⟨X, hX⟩ := Filter.eventually_atTop.1 hev
  -- choose B with 6 B ≥ max X 1
  obtain ⟨B, hB⟩ := exists_nat_ge (max X 1)
  refine ⟨2 ^ B, fun n hn => ?_⟩
  have hlg : B ≤ IntMul.lg n := NLogN.KFM.lg_ge B n hn
  have hBr : (B : ℝ) ≤ IntMul.lg n := by exact_mod_cast hlg
  have hxX : X ≤ 6 * (IntMul.lg n : ℝ) := by
    have : X ≤ max X 1 := le_max_left _ _
    have : (0 : ℝ) ≤ B := Nat.cast_nonneg B
    linarith
  have hx1 : (1 : ℝ) ≤ 6 * (IntMul.lg n : ℝ) := by
    have : (1 : ℝ) ≤ max X 1 := le_max_right _ _
    linarith
  have h := hX _ hxX
  rw [Real.norm_eq_abs, Real.norm_eq_abs, one_mul,
    abs_of_nonneg (Real.rpow_nonneg (by linarith) _)] at h
  exact (le_abs_self _).trans h
