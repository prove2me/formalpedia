  smul_assoc c T S := by ext v; simp

local instance : SMulCommClass ℂ (Operator X H) (Operator X H) where
  smul_comm c T S := by ext v; simp

def RoeMultiplier (T : Operator X H) : Prop :=
  ∀ S : algebra (X := X) (H := H),
    T * S.val ∈ algebra (X := X) (H := H) ∧ S.val * T ∈ algebra (X := X) (H := H)

def roeIdealizer : NonUnitalStarSubalgebra ℂ (Operator X H) where
  carrier := {T | RoeMultiplier T}
  zero_mem' S := by simp only [zero_mul, mul_zero]; exact ⟨zero_mem _, zero_mem _⟩
  add_mem' hT hU S := by
    rw [add_mul, mul_add]
    exact ⟨add_mem (hT S).1 (hU S).1, add_mem (hT S).2 (hU S).2⟩
  mul_mem' hT hU S := by
    constructor
    · rw [mul_assoc]
      exact (hT ⟨_, (hU S).1⟩).1
    · rw [← mul_assoc]
      exact (hU ⟨_, (hT S).2⟩).2
  smul_mem' z T hT S := by
    rw [smul_mul_assoc, mul_smul_comm]
    exact ⟨(algebra (X := X) (H := H)).smul_mem z (hT S).1,
      (algebra (X := X) (H := H)).smul_mem z (hT S).2⟩
  star_mem' hT S := by
    have h := hT ⟨star S.val, star_mem S.property⟩
    exact ⟨by simpa only [star_mul, star_star] using star_mem h.2,
      by simpa only [star_mul, star_star] using star_mem h.1⟩

