      ∀ (M : TypeDensity.Law) (τ : TypeDensity.FactorType), τ ∉ (M.map Prod.fst).toFinset →
        (TypeDensity.lawCoeff M τ).eval q = 0 := by
  refine ⟨?_, fun M τ h ↦ ?_⟩
  · induction L generalizing σ with
    | zero =>
      simp [TypeDensity.lawProd, TypeDensity.lawOne, TypeDensity.lawCoeff, TypeDensity.expression_sum_eval, Fintype.piFinset_of_isEmpty,
        eq_comm, apply_ite, TypeDensity.Expr.eval]
