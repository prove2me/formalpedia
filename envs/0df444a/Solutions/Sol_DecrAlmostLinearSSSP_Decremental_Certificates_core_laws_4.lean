section s195
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreSource
open Structured
lemma Image.resume (B R N entry : ℕ) (g : Machine) (s : Data) (h : Image B R N g s) :
    Image B R N (DecrAlmostLinearSSSP.Decremental.resume g entry) s :=
  ⟨h.base,h.factor,h.record,h.savedBase,h.zero,h.realMem,h.natMem,h.work,h.saved.resume N entry g s,h.tail⟩
lemma Image.nat_patch (B R N slot source value : ℕ) (g : Machine) (s : Data)
    (h : Image B R N g s) (hodd : ∃ r, R = B+2*r+1) (hne : source ≠ 630) (hv : s.natReg source = 2*value) :
    Image B R N {g with natReg := Function.update g.natReg slot value} (CoreRequest.natResult slot source s) := by
  have he := CoreRequest.nat_eval slot source s
  have hn (k : ℕ) (hk : k ≠ 630) := he.nat_frame (CoreRequest.nat_frame slot source k hk)
  have hbaseodd : ∃ r, s.natReg 50 = B+2*r+1 := by
    obtain ⟨r,hr⟩ := hodd
    exact ⟨r+4,by rw [h.savedBase,hr];omega⟩
  refine ⟨(hn 74 (by omega)).trans h.base,(hn 112 (by omega)).trans h.factor,
    (hn 106 (by omega)).trans h.record,(hn 50 (by omega)).trans h.savedBase,
    (hn 56 (by omega)).trans h.zero,?_,?_,?_,h.saved.nat_patch N slot source value g s hne hv,?_⟩
  · intro a
    rw [(CoreRequest.nat_values slot source s hne).2]
    exact h.realMem a
  · intro a
    have haddr : B+2*(2*a+1) = B+4*a+2 := by omega
    rw [haddr,CoreRequest.nat_guest_frame B slot source s hne hbaseodd a]
    simpa only [haddr] using h.natMem a
  · rw [(CoreRequest.nat_values slot source s hne).1,h.savedBase,Function.update_of_ne (show R+6 ≠ R+8+2*slot by omega)]
    exact h.work
  · intro j hj
    rw [he.nat_frame (CoreRequest.nat_frame slot source (shadowReg j) (by dsimp [shadowReg];omega)),
      he.real_frame (CoreRequest.nat_real_frame slot source (shadowReg j))]
    exact h.tail j hj
lemma Image.real_patch (B R N slot source : ℕ) (g : Machine) (s : Data)
    (h : Image B R N g s) (hodd : ∃ r, R = B+2*r+1) :
    Image B R N {g with realReg := Function.update g.realReg slot (s.realReg source)} (CoreRequest.realResult slot source s) := by
  have he := CoreRequest.real_eval slot source s
  have hn (k : ℕ) (hk : k ≠ 630) := he.nat_frame (CoreRequest.real_nat_frame slot source k hk)
  have hbaseodd : ∃ r, s.natReg 50 = B+2*r+1 := by
    obtain ⟨r,hr⟩ := hodd
    exact ⟨r+4,by rw [h.savedBase,hr];omega⟩
  refine ⟨(hn 74 (by omega)).trans h.base,(hn 112 (by omega)).trans h.factor,
