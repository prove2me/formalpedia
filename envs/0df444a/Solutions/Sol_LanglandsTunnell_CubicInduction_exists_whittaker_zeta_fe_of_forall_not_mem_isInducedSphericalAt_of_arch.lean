  infer_instance

attribute [local instance] isAddHaarMeasure_selfDualHaarAt regular_selfDualHaarAt

private theorem sigmaFinite_selfDualHaarAt : SigmaFinite (selfDualHaarAt ℚ v) := by

  have hϖ : Valued.v (((NumberField.AdelicLevel.uniformizerUnit ℚ v)⁻¹ : (v.adicCompletion ℚ)ˣ) :
      v.adicCompletion ℚ) = (WithZero.exp (-1 : ℤ))⁻¹ := by
    rw [Units.val_inv_eq_inv_val, map_inv₀, NumberField.AdelicLevel.valued_uniformizerUnit ℚ v]
  letI : NontriviallyNormedField (v.adicCompletion ℚ) :=
    { (inferInstance : NormedField (v.adicCompletion ℚ)) with
      non_trivial := ⟨_, by
        rw [IdeleNormSplit.norm_eq_of_valued_eq v (n := -1) hϖ, zpow_neg_one, inv_inv]
        exact_mod_cast NumberField.HeightOneSpectrum.one_lt_absNorm (v := v)⟩ }
  haveI : ProperSpace (v.adicCompletion ℚ) :=
    ProperSpace.of_nontriviallyNormedField_of_weaklyLocallyCompactSpace _
  infer_instance

attribute [local instance] sigmaFinite_selfDualHaarAt

private theorem selfDualHaarAt_smul_set (u : (v.adicCompletion ℚ)ˣ) (s : Set (v.adicCompletion ℚ)) :
    selfDualHaarAt ℚ v (u • s) = (modulus (u : v.adicCompletion ℚ) : ℝ≥0∞) * selfDualHaarAt ℚ v s :=
  measure_smul_set (selfDualHaarAt ℚ v) u s

private theorem integral_selfDualHaarAt_comp_mul_left {u : (v.adicCompletion ℚ)ˣ}
    (hu : modulus (u : v.adicCompletion ℚ) = 1) (f : v.adicCompletion ℚ → ℂ) :
    ∫ x, f ((u : v.adicCompletion ℚ) * x) ∂selfDualHaarAt ℚ v = ∫ x, f x ∂selfDualHaarAt ℚ v :=
  integral_comp_mul_left_of_modulus_eq_one (selfDualHaarAt ℚ v) hu f

private theorem integrable_selfDualHaarAt_comp_mul_left_iff {u : (v.adicCompletion ℚ)ˣ}
    (hu : modulus (u : v.adicCompletion ℚ) = 1) (f : v.adicCompletion ℚ → ℂ) :
    Integrable (fun x => f ((u : v.adicCompletion ℚ) * x)) (selfDualHaarAt ℚ v) ↔
      Integrable f (selfDualHaarAt ℚ v) :=
  integrable_comp_mul_left_iff_of_modulus_eq_one (selfDualHaarAt ℚ v) hu f

private theorem isHaarMeasure_comap_mulMeasure_selfDualHaarAt :
    (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))).IsHaarMeasure :=
  isHaarMeasure_comap_mulMeasure (selfDualHaarAt ℚ v) (continuous_modulus_adicCompletion v)

attribute [local instance] isHaarMeasure_comap_mulMeasure_selfDualHaarAt

private theorem sigmaFinite_comap_mulMeasure_selfDualHaarAt :
    SigmaFinite (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) :=
  sigmaFinite_comap_mulMeasure (selfDualHaarAt ℚ v)

private theorem integral_comap_mulMeasure_selfDualHaarAt_comp_mul_left (u : (v.adicCompletion ℚ)ˣ)
    (f : (v.adicCompletion ℚ)ˣ → ℂ) :
    ∫ y, f (u * y) ∂(Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) =
      ∫ y, f y ∂(Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) := by
  set ν := Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))
  let e := unitsMulLeftEquiv (K := v.adicCompletion ℚ) u
  have h := e.measurableEmbedding.integral_map (μ := ν) f
  rw [show ν.map e = ν from Measure.IsMulLeftInvariant.map_mul_left_eq_self u] at h
  exact h.symm

private theorem integrable_comap_mulMeasure_selfDualHaarAt_comp_mul_left_iff (u : (v.adicCompletion ℚ)ˣ)
    (f : (v.adicCompletion ℚ)ˣ → ℂ) :
    Integrable (fun y => f (u * y)) (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) ↔
      Integrable f (Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))) := by
  set ν := Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))
  let e := unitsMulLeftEquiv (K := v.adicCompletion ℚ) u
  have h := e.measurableEmbedding.integrable_map_iff (μ := ν) (g := f)
  rw [show ν.map e = ν from Measure.IsMulLeftInvariant.map_mul_left_eq_self u] at h
  exact h.symm

private theorem integrable_prod_selfDualHaarAt_comp_mul_left_iff (u : (v.adicCompletion ℚ)ˣ)
    {c : (v.adicCompletion ℚ)ˣ} (hc : modulus (c : v.adicCompletion ℚ) = 1)
    (F : (v.adicCompletion ℚ)ˣ × v.adicCompletion ℚ → ℂ) :
    Integrable (fun p => F (u * p.1, (c : v.adicCompletion ℚ) * p.2))
        ((Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))).prod (selfDualHaarAt ℚ v)) ↔
      Integrable F ((Measure.comap Units.val (mulMeasure (selfDualHaarAt ℚ v))).prod (selfDualHaarAt ℚ v)) := by
  haveI := sigmaFinite_comap_mulMeasure_selfDualHaarAt v
  exact integrable_prod_comp_mul_left_iff (selfDualHaarAt ℚ v) (continuous_modulus_adicCompletion v) u hc F

