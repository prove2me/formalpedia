    (fun z hz => (hM₂ z hz).trans (le_max_right _ _)) hza hzb

  set k : ℝ := Real.pi / (2 * (σ₂ - σ₁)) with hk
  have hkpos : 0 < k := by positivity
  refine ⟨k, ?_, |D| / k, ?_⟩
  · have hd : 0 < σ₂ - σ₁ := sub_pos.2 h₁₂
    rw [hk]
    exact div_lt_div_of_pos_left Real.pi_pos hd (by linarith)
  · refine Asymptotics.IsBigO.of_bound C ?_
    refine Filter.eventually_inf_principal.2 (Filter.Eventually.of_forall fun z hz => ?_)
    have hz₁ : σ₁ ≤ z.re := (mem_preimage.1 hz).1.le
    have hz₂ : z.re ≤ σ₂ := (mem_preimage.1 hz).2.le
    have hDt : D * |z.im| ≤ |D| / k * Real.exp (k * |z.im|) := by
      have h0 : 0 ≤ |z.im| := abs_nonneg _
      have hx : k * |z.im| ≤ Real.exp (k * |z.im|) := by linarith [Real.add_one_le_exp (k * |z.im|)]
      calc D * |z.im| ≤ |D| * |z.im| := mul_le_mul_of_nonneg_right (le_abs_self D) h0
        _ = |D| / k * (k * |z.im|) := by field_simp
        _ ≤ |D| / k * Real.exp (k * |z.im|) := mul_le_mul_of_nonneg_left hx (by positivity)
    rw [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    exact (hCD z hz₁ hz₂).trans (mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 hDt) (by
      by_contra hC
      have := hCD z hz₁ hz₂
      linarith [norm_nonneg (F z), mul_neg_of_neg_of_pos (lt_of_not_ge hC) (Real.exp_pos (D * |z.im|))]))

end VerticalStripBounds
