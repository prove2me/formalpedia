variable {n Q : ℕ}

lemma runCost_eq (T : ℝ → ℝ) (v : ℝ) (steps : List (Step n Q)) :
    runCost T v steps = (steps.countP (fun s => !s.isSwap) : ℝ) * v +
      (steps.countP Step.isSwap : ℝ) * T v := by
  induction steps with
  | nil => simp [runCost]
  | cons s l ih =>
    simp only [runCost, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih, List.countP_cons, List.countP_cons]
    cases s.isSwap <;> simp <;> ring

lemma countP_not_add (steps : List (Step n Q)) :
    steps.countP (fun s => !s.isSwap) + steps.countP Step.isSwap = steps.length := by
  induction steps with
  | nil => rfl
  | cons s l ih =>
    rw [List.countP_cons, List.countP_cons, List.length_cons]
    cases s.isSwap <;> simp <;> omega

lemma length_revSteps (l : List (Step n Q)) : (revSteps l).length = l.length := by
  simp [revSteps]

variable {m : ℕ}

lemma length_shearSteps (E₁ W E₂ : Matrix (Fin m) (Fin m) (ZMod Q)) :
    (shearSteps E₁ W E₂).length = 4 * m + 3 * (pivots W).length := by
  have h3 : ∀ ps : List (Fin m × Fin m), (addSteps ps : List (Step (m + m) Q)).length =
      3 * ps.length := by
    intro ps
    induction ps with
    | nil => rfl
    | cons p ps ih =>
      have e : (addSteps (p :: ps) : List (Step (m + m) Q)) = pivotSteps p.1 p.2 ++ addSteps ps := by
        simp [addSteps]
      rw [e, List.length_append, ih]; simp [pivotSteps]; ring
  simp only [shearSteps, List.length_append, length_revSteps, h3]
  simp [hSteps, dSteps, hIdx, dIdx]
  ring

end StepCost

section ProgCost

variable {R : Type*} [CommRing R] {m W : ℕ}

lemma one_le_costConst (C : Circuit R m W) : 1 ≤ costConst C := by
  have h := frameSum_nonneg (fun A => (4 * m + 2 * pivRank C A : ℝ)) (fun A => by positivity)
    C.gates C.Min C.Mout
  rw [costConst]
  have : 0 ≤ (frameSum (fun A => (4 * m + 2 * pivRank C A : ℝ)) C.gates C.Min C.Mout +
    touched C.gates) / W := by positivity
  have : (0 : ℝ) ≤ m := by positivity
  linarith

end ProgCost

section Assembled

variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]

/-- The chunk interchange on the digit shape: if the two chunks are runs of `e` radix-`q`
digits (`P :: L :: hdShape A B Cs e q`), swapping the two merged fields is the block swap of
the two digit runs. -/
theorem pull_swapPos_eq_blockSwap (P L : ℕ) (A B Cs : Shape) (e q : ℕ) (xs : List R) :
    pull (P :: L :: swShape A B Cs (q ^ e)) (P :: L :: swShape A B Cs (q ^ e))
        (swapPos (A.length + 2) (A.length + B.length + 3)) 0 xs =
      pull (P :: L :: hdShape A B Cs e q) (P :: L :: hdShape A B Cs e q)
        (blockSwap (A.length + 2) (A.length + B.length + e + 2) e) 0 xs := by
  have hg : ∀ k, k < e + e → (P :: L :: hdShape A B Cs e q).getD (hdPos A B e k + 2) 0 = q :=
    fun k hk => by simpa using hdShape_getD A B Cs e q k hk
  rw [pull_blockSwap (by omega) (by simp [length_hdShape]; omega) (fun k hk => by
      have h1 := hg k (by omega)
      have h2 := hg (e + k) (by omega)
      simp only [hdPos, if_pos hk, if_neg (show ¬ e + k < e by omega)] at h1 h2
      rw [show A.length + 2 + k = A.length + k + 2 by omega, h1,
        show A.length + B.length + e + 2 + k = A.length + B.length + (e + k) + 2 by omega, h2]),
    mergeShape2_hdShape, show A.length + B.length + e + 2 + 1 - e = A.length + B.length + 3 by
      omega]

end Assembled

