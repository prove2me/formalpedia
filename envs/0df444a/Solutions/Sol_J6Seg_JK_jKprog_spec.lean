  have e1 : kS B1 (gflat x ++ l) [] [] [] [] [] [] [] = B1 := by
    funext j
    simp only [kS, update_apply]
    split_ifs <;> (try subst_vars) <;> first | rfl |
      (simp +decide only [hB1, hdrSt, update_apply, ↓reduceIte]
