namespace CoarseAssembly

abbrev LatticeVertex := ℤ × ℤ

def latticeRadius (u : LatticeVertex) : ℤ :=
  max (max |u.1| |u.2|) |u.1 + u.2|

def triangularGraph : SimpleGraph LatticeVertex where
  Adj u v := |u.1 - v.1| ≤ 1 ∧ |u.2 - v.2| ≤ 1 ∧
    |(u.1 + u.2) - (v.1 + v.2)| ≤ 1 ∧ u ≠ v
  symm := ⟨by intro u v h; simpa only [abs_sub_comm, ne_eq, eq_comm] using h⟩
  loopless := ⟨fun _ h => h.2.2.2 rfl⟩

def Disc (j : ℕ) := {u : LatticeVertex // latticeRadius u ≤ (j : ℤ)}

noncomputable instance (j : ℕ) : Fintype (OAI.CoarseAssembly.Disc j) := by
  classical

  exact ((
    let local_proof (j : ℕ) : {u : OAI.CoarseAssembly.LatticeVertex | OAI.CoarseAssembly.latticeRadius u ≤ (j : ℤ)}.Finite :=
      open OAI OAI.CoarseAssembly in
        by
          apply ((Set.finite_Icc (-(j : ℤ)) j).prod (Set.finite_Icc (-(j : ℤ)) j)).subset
          intro u hu
          simp only [Set.mem_ofPred_eq, OAI.CoarseAssembly.latticeRadius, max_le_iff, abs_le] at hu
          exact ⟨hu.1.1, hu.1.2⟩
    local_proof) j).fintype

def discGraph (j : ℕ) : SimpleGraph (Disc j) where
  Adj u v := triangularGraph.Adj u.val v.val
  symm := ⟨fun _ _ h => h.symm⟩
  loopless := ⟨fun _ h => h.2.2.2 rfl⟩

def discDepth (j : ℕ) (u : Disc j) : ℕ := ((j : ℤ) - latticeRadius u.val).toNat

end CoarseAssembly

