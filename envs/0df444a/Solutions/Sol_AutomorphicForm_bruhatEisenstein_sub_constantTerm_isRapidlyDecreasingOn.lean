  have hof : ContDiff ℝ ∞ (Complex.ofReal) := Complex.ofRealCLM.contDiff
  have heq : (fun t : ℝ => botP g (z₀ + t * Complex.exp (θ * Complex.I)))
      = fun t : ℝ => botP g z₀ + (t : ℂ) * (Complex.exp (θ * Complex.I) * g 1 0) := by
    funext t
    exact botP_line g z₀ θ t
  rw [heq]
  exact contDiff_const.add (hof.mul contDiff_const)

private theorem contDiff_botQ_line (z₀ : ℂ) (θ : ℝ) :
    ContDiff ℝ ∞ fun t : ℝ => botQ g (z₀ + t * Complex.exp (θ * Complex.I)) := by
  have hof : ContDiff ℝ ∞ (Complex.ofReal) := Complex.ofRealCLM.contDiff
  have heq : (fun t : ℝ => botQ g (z₀ + t * Complex.exp (θ * Complex.I)))
      = fun t : ℝ => botQ g z₀ + (t : ℂ) * (Complex.exp (θ * Complex.I) * g 1 1) := by
    funext t
    exact botQ_line g z₀ θ t
  rw [heq]
  exact contDiff_const.add (hof.mul contDiff_const)

private theorem contDiff_inv_radC_line_cast (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) :
    ContDiff ℝ ∞ fun t : ℝ =>
      (((radC g (z₀ + t * Complex.exp (θ * Complex.I)))⁻¹ : ℝ) : ℂ) := by
  have hof : ContDiff ℝ ∞ (Complex.ofReal) := Complex.ofRealCLM.contDiff
  exact hof.comp ((contDiff_radC_line hg z₀ θ).inv fun t => (radC_line_pos hg z₀ θ t).ne')

private theorem contDiff_linePhat (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) :
    ContDiff ℝ ∞ (linePhat g z₀ θ) := by
  have heq : linePhat g z₀ θ = fun t : ℝ =>
      botP g (z₀ + t * Complex.exp (θ * Complex.I))
        * (((radC g (z₀ + t * Complex.exp (θ * Complex.I)))⁻¹ : ℝ) : ℂ) := by
    funext t
    rw [linePhat, div_eq_mul_inv, Complex.ofReal_inv]
  rw [heq]
  exact (contDiff_botP_line z₀ θ).mul (contDiff_inv_radC_line_cast hg z₀ θ)

private theorem contDiff_lineQhat (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) :
    ContDiff ℝ ∞ (lineQhat g z₀ θ) := by
  have heq : lineQhat g z₀ θ = fun t : ℝ =>
      botQ g (z₀ + t * Complex.exp (θ * Complex.I))
        * (((radC g (z₀ + t * Complex.exp (θ * Complex.I)))⁻¹ : ℝ) : ℂ) := by
    funext t
    rw [lineQhat, div_eq_mul_inv, Complex.ofReal_inv]
  rw [heq]
  exact (contDiff_botQ_line z₀ θ).mul (contDiff_inv_radC_line_cast hg z₀ θ)

private theorem contDiff_normSq_comp {f : ℝ → ℂ} (hf : ContDiff ℝ ∞ f) :
    ContDiff ℝ ∞ fun t => normSq (f t) := by
  have heq : (fun t => normSq (f t))
      = fun t => (f t).re * (f t).re + (f t).im * (f t).im := by
    funext t
    rw [normSq_apply]
  rw [heq]
  exact ((Complex.reCLM.contDiff.comp hf).mul (Complex.reCLM.contDiff.comp hf)).add
    ((Complex.imCLM.contDiff.comp hf).mul (Complex.imCLM.contDiff.comp hf))

private theorem contDiff_lineQSq (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) :
    ContDiff ℝ ∞ (lineQSq g z₀ θ) :=
  contDiff_normSq_comp (contDiff_lineQhat hg z₀ θ)

