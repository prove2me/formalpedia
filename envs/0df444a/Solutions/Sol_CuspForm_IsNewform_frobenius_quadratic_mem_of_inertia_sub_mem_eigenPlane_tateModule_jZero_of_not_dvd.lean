  have hESV0 := es_operator_mem_connSpan (K := K) A σ ρM _hρ TM _hT
    (esElt_mem_connSet lam hlamM A hA hσ) w
  rw [_hTlam _ hσw] at hESV0
  have hESW : (ρM σ).baseChange K ((ρM σ).baseChange K w)
      - algebraMap O'' K (algebraMap O' O''
          ((iota.comp chig.rangeRestrict)
            (CuspForm.heckeAlgebra.T (Fact.out : lam.Prime) hlamM (by simp)))) •
        (ρM σ).baseChange K w
