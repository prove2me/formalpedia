-- Source module: Solutions.R6P18Chunk
/-!
# Round six, Proposition 18: the chunk rounds through `P14NeedH'`

`KFV.layerU_chunk` with the uniform Proposition 14 of round six (`IL3.P14NeedH'`: guard `Ew`,
exponent `lamp`, per-call factor `(zsz p + 1) D^lamp`, the three size hypotheses `n1 n2 n3`, no
bound on `K`). **`layerU_chunk6`**, **`chunkU_of6`**; the cost of a chunk round is `cChunk6`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV.R6P

open IntMul RS KIL KFD KFB KFH AModel Butterfly

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

section Paper

open Synth GlueLayout GlueP14 GlueError

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

/-- The chunk rounds from the uniform Proposition 14 of round six (descriptor on `dD = 36`). -/
theorem chunkU_of6 (hK : 0 < K) (hℓ : 1 ≤ ℓ) {e14 : Fin Pp} {Ew : ℕ → ℕ} {lamp : ℝ} {K₀ : ℕ}
    {C₀ : ℝ} (HP : IntMul.Kappa.R6.IL3.P14NeedH' I iprog e14 dD Ew lamp K₀ C₀) {p W Z B : ℕ}
    (hW : p + 1 ≤ W) (hB : (tgtL D ℓ K long).length + ℓ + 3 ≤ B) (hpB : p ≤ B) (hWB : W ≤ B)
    (hZB : Z ≤ B) (c1 : 6 ≤ K) (c3 : 80 * Z * (Z + 2) ≤ 2 ^ K)
    (c4 : zsz ((32 * (2 ^ nB D ℓ K long * 2 ^ ℓ) : ℕ) : ℤ) ≤ Z)
    (cp : zsz (p : ℤ) ≤ Z) (c6 : Ew D ≤ W + 1)
    (c7 : W + Ew D + 2 < 2 ^ Z) (c8 : 2 * (2 * Z + 4) ^ 3 + 2 ≤ 2 ^ ℓ)
    (c9 : (K * D + 2 ^ nB D ℓ K long + 10) * (Z + 2) ≤ 2 ^ nB D ℓ K long * 2 ^ ℓ)
    (n1 : zsz ((2 ^ nB D ℓ K long * 2 ^ ℓ + W + Ew D : ℕ) : ℤ) ≤ p) (n2 : (p + K₀) ^ 5 ≤ 2 ^ K)
    (n3 : ((K₀ * D * (zsz (p : ℤ) + 1) : ℕ) : ℝ) ≤ K * (D : ℝ) ^ lamp) :
    ChunkU D ℓ K long I iprog e14 hK hℓ p W Z (cChunk6 D ℓ K long W B C₀ lamp p) :=
  fun h hb hh => layerU_chunk6 D ℓ K long hK hℓ HP hb hh hW hB hpB hWB hZB c1 c3 c4 cp c6 c7 c8 c9
    n1 n2 n3

end Paper

end NLogN.KFV.R6P

end

section
-- Source module: Solutions.R6P18Tab
/-!
# Round six, Proposition 18: the table

`ext6 nU U e su td q : Fin (nU + 3) → IStmt HS (7 + (nU + 3))` extends `IL.kTableP tab` (any
Lemma 12 table `tab` in slot `0`) by

* the `nU` procedures of the uniform Proposition 14 (`IL3.P14UH'`) at `idx6 i = 7 + i`;
* a copy of the frozen Lemma 12 procedure `KFL.l12prog 0` at `eL6 = 7 + nU`;
* the frozen uniform Gaussian swap `KFW.swGU q`, relabelled onto that copy, at `eSw6 = 8 + nU`;
* the body of Proposition 18 at `ent6 = 9 + nU`.

The swap entry is only needed for the correctness proof of the layout programs: at round six
`K = ℓ - 1`, so phase 3 of the layout never calls it (`R6P18Lay`), and its exponent does not
enter the cost. **`swOK6`**: `SwOK` for the swap entry.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV.R6P

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12
open IntMul.Kappa.R6

section
variable {tab : Fin 1 → IStmt HS 1} {nU : ℕ}
  {U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E)} {e : Fin nU}
  {su td : (Pp : ℕ) → IStmt HS Pp} {q : ℕ}

theorem kT6_idx (i : Fin nU) :
    IL.kTableP tab (ext6 nU U e su td q) (idx6 nU i) = U (nU + 3) (idx6 nU) i := by
  have := IL.kTableP_ext tab (ext6 nU U e su td q) ⟨i.val, by omega⟩
  simp only [idx6] at this ⊢
  rw [this]; simp [ext6]

theorem kT6_l12 :
    ∀ j, IL.kTableP tab (ext6 nU U e su td q) (gL6 nU j) = (KFL.l12prog j).ren id (gL6 nU) := by
  intro j
  have hj : j = 0 := Subsingleton.elim _ _
  subst hj
  have := IL.kTableP_ext tab (ext6 nU U e su td q) ⟨nU, by omega⟩
  simp only [gL6, eL6] at this ⊢
  rw [this]; simp [ext6]

theorem kT6_sw :
    IL.kTableP tab (ext6 nU U e su td q) (eSw6 nU) = (KFW.swGU q).ren id (gL6 nU) := by
  have := IL.kTableP_ext tab (ext6 nU U e su td q) ⟨nU + 1, by omega⟩
  simp only [eSw6] at this ⊢
  rw [this]; simp [ext6]

theorem kT6_ent :
    IL.kTableP tab (ext6 nU U e su td q) (ent6 nU) =
      body18 (su _) (td _) (idx6 nU e) (eSw6 nU) (KFM.pMul (nU + 3)) := by
  have := IL.kTableP_ext tab (ext6 nU U e su td q) ⟨nU + 2, by omega⟩
  simp only [ent6] at this ⊢
  rw [this]; simp [ext6]

/-- **The swap entry satisfies `SwOK`** (for a prime `q` past the threshold of `swGU_spec`). -/
theorem swOK6 {K : ℝ} (hK : 0 ≤ K)
    (HK : ∀ (u w : ℕ) (sh : Shape) (p q' : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) → p < q' →
      q' < sh.length → sh.getD p 0 = 2 ^ u → sh.getD q' 0 = 2 ^ u →
      ∀ (I : List Sym) (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
      (∀ j, j ≠ 0 → j ≠ KFW.dS → f j = []) → f KFW.dS = KFM.descSw w u p q' sh →
      f 0 = gflat zs ++ l → zs.length = vol sh → GB w zs →
      ∃ c : ℕ, IRuns I KFL.l12prog (KFW.swGU q) (encK s f)
        (encK s (Function.update f 0 (gflat (pull sh sh (swapPos p q') 0 zs) ++ l))) c ∧
        (c : ℝ) ≤ K * (((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ KFS.τS +
          (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ)))
    (I : List Sym) :
    SwOK I (IL.kTableP tab (ext6 nU U e su td q)) (eSw6 nU) dW18 (K + 2) := by
  intro u w sh p q' hu hsh hpq hq hpu hqu s f zs l hf hfD hf0 hzl hGB
  obtain ⟨c, Hc, hc⟩ := HK u w sh p q' hu hsh hpq hq hpu hqu I s f zs l hf hfD hf0 hzl hGB
  have R := KFM.IRuns.relabel (iprog' := IL.kTableP tab (ext6 nU U e su td q))
    (g := gL6 nU) kT6_l12 Hc
  refine ⟨c + 2, IRuns.call (by rw [kT6_sw]; exact R), ?_⟩
  set X : ℝ := ((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ KFS.τS +
    (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ) with hX
  have hX1 : 1 ≤ X := by
    have h1 : (0 : ℝ) ≤ ((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ KFS.τS := by positivity
    have h2 : 0 < (sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 := by positivity
    have h3 : (1 : ℝ) ≤ (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ) := by
      exact_mod_cast h2
    linarith
  push_cast
  nlinarith

end

end NLogN.KFV.R6P

end

