/-- A primitive Pythagorean triple: positive integers with a² + b² = c²,
gcd(a,b) = 1, and opposite parity. -/
structure PrimitivePythTriple where
  a : ℕ
  b : ℕ
  c : ℕ
  pos_a : 0 < a
  pos_b : 0 < b
  pos_c : 0 < c
  pyth : a * a + b * b = c * c
  coprime : Nat.gcd a b = 1
  parity : a % 2 = 1 ∧ b % 2 = 0

/-- The base triple (3, 4, 5) is a primitive Pythagorean triple. -/
def baseTriple : PrimitivePythTriple where
  a := 3; b := 4; c := 5
  pos_a := by omega
  pos_b := by omega
  pos_c := by omega
  pyth := by norm_num
  coprime := by decide
  parity := by omega





