                have hmem : (π₀⁻¹ : ↥k₀) ∈ V.toSubring.comap cK := hπ₀V
                rw [h] at hmem
                have hmem' : algebraMap ↥k₀ (AlgebraicClosure ℚ) π₀⁻¹ ∈ A := hmem
