    ∃ (ρ : P₀.B₀ →ₐ[A₀] k) (ψet : Pet.B₀ →ₐ[W₀] k) (χ : CQ →+* k)
      (hΔk : IsUnit (xet.curve.map ψet.toRingHom).Δ) (Qk : Section (xet.curve.map ψet.toRingHom)),
      (∀ b : P₀.B₀, ρ b = resR (ι b)) ∧
      (∀ b : Pet.B₀, χ (algebraMap Pet.B₀ CQ b) = ψet b) ∧
      (∃ (φ : projModelGradingCR xet.curve →+*ᵍ projModelGradingCR (xet.curve.map ψet.toRingHom))
