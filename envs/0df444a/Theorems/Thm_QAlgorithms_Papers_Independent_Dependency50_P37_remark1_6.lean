-- title:
--   Continuous-time capacities from any positive sampling time
-- statement:
--   Let $\{\Psi_t\}_{t\ge0}$ be a continuous-time quantum Markov semigroup on $M_d(\mathbb C)$, $d\ge1$, generated by a Lindbladian. Fix $t_0>0$, set $\Phi=\Psi_{t_0}$, and choose its actual peripheral decomposition with matrix-block dimensions $a_1,\dots,a_K\ge1$. Capacities are the one-shot zero-error capacities in bits. Then, for every $t>0$, $\chi(\Psi_t)=\chi(\Phi)$, and
--
--   $$
--   \begin{aligned}
--   \lim_{t\to\infty}C_0(\Psi_t)&=\lim_{n\to\infty}C_0(\Phi^n)=\log_2\sum_k a_k,\\
--   \lim_{t\to\infty}Q_0(\Psi_t)&=\lim_{n\to\infty}Q_0(\Phi^n)=\log_2\max_k a_k.
--   \end{aligned}
--   $$
--
--   Any strictly positive sampling interval therefore computes the same long-time capacities.
--
--   **Formalization Note** The semigroup is encoded by channels at nonnegative times, identity at zero, the semigroup law, and continuity on nonnegative times; this is equivalent to the finite-dimensional Lindbladian model.
-- source:
--   Zero-error communication under discrete-time Markovian dynamics, arXiv:2402.18703v3, PDF p. 4, Remark 1.6

import Definitions.Def_QAlgorithms_Papers_Independent_Dependency50_P37

noncomputable section

open scoped BigOperators Matrix ComplexConjugate ComplexOrder

open Filter

namespace QAlgorithms.Papers.Independent.Dependency50.P37

open QAlgorithms.Papers.Independent.Information100.P23 (Operator)

open QAlgorithms.Papers.Independent.Information100.P07 (positivePart operatorRange)

open QAlgorithms.Papers.Independent.Information100.P26 (commutant scalars)

open QAlgorithms.Papers.Independent.Information100.P62
  (classicalCapacity assistedCapacity quantumCapacity graph)

open QAlgorithms.Papers.Independent.Information100.P67 (complementaryChannel)

/-- Remark 1.6, PDF p.4: every strictly positive sampling time works. Zero is
excluded from peripheral-space independence. Finite-dimensional continuity is
included in ContinuousQMS, the Lindbladian semigroup model. -/
theorem remark1_6 {d : ℕ} (hd : 0 < d) (S : ContinuousQMS d)
    (t0 : ℝ) (ht0 : 0 < t0) (D : PeripheralDecomposition (S.map t0)) :
    (∀ t : ℝ, 0 < t → Information100.P26.peripheral (channelMatrix (S.map t)) = Information100.P26.peripheral (channelMatrix (S.map t0))) ∧
    Tendsto (fun t : ℝ => classicalCapacity (S.map t)) atTop
      (nhds (Real.logb 2 (peripheralBlockDimensionSum D))) ∧
    Tendsto (fun t : ℝ => quantumCapacity (S.map t)) atTop
      (nhds (Real.logb 2 (blockMaximum D))) ∧
    Tendsto (fun n : ℕ => classicalCapacity (Nat.iterate (S.map t0) n)) atTop
      (nhds (Real.logb 2 (peripheralBlockDimensionSum D))) ∧
    Tendsto (fun n : ℕ => quantumCapacity (Nat.iterate (S.map t0) n)) atTop
      (nhds (Real.logb 2 (blockMaximum D))) := by sorry

end QAlgorithms.Papers.Independent.Dependency50.P37

end
