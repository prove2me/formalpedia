section
-- Source module: Solutions.KFDPass
/-!
# KFD: the fine gather `divPgU` (multiplication of the target field by `c⁻¹`)

Fine specifications of KIL3Gather / KIL4Div (programs unchanged).  Three size bounds:

* `w` bounds the data entries (per-entry cost `O(w + 2)`);
* `b ≥ zsz (2c)` bounds the residue counter and the `c`-way branch (per-record cost
  `O(c · (b + 2))`, a constant for fixed `c`);
* `bL` bounds the per-block numbers `Q`, `B`, `Q·B` of the run-time pass counts (`cntE`, one
  multiplication per pass and block: `O((bL + 2)^2)` per block, `= O(Q·B)` for `bL ≈ zsz (Q·B)`);
* `Bb` bounds the per-call numbers `P`, `P·Q·B` (`O((Bb + 2)^2)` per call).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KIL AModel

/-! ## Literal passes -/

def cBrF (B w : ℕ) : ℕ := cLp B (250 * (w + 2)) B

section GatherLemmas

variable {rp : ℕ → List ℤ} {Q c B : ℕ}

def cBodyGF (c B w b : ℕ) : ℕ := c * cSel b + cBrF B w + (14 + 1) * 2000 * (b + 2)

def cPassGF (Q c B w b : ℕ) : ℕ :=
  (1 + 1) * 2000 * (b + 2) + cLp Q (cBodyGF c B w b) Q + (2 * b + 2) +
    cLp (Q * B) (250 * (w + 2)) (Q * B)

/-! ## Uniform passes -/

def cPassGUF (Q c B w b bL : ℕ) : ℕ :=
  10 * 10 ^ 7 * (bL + 2) ^ 2 + (200 * cPassGF Q c B w b + (2 * bL + 2))

def cBlkGUF (Q c B w b bL : ℕ) : ℕ := 1 + c * cPassGUF Q c B w b bL

def cDivPgRF (P Q c B w b bL Bb : ℕ) : ℕ :=
  cLp P (cBlkGUF Q c B w b bL) Bb + cLp (P * (Q * B)) (250 * (w + 2)) Bb

def cDivPgUF (P Q c B w b bL Bb : ℕ) : ℕ :=
  4 * 10 ^ 7 * (Bb + 2) ^ 2 + (c * cSel Bb + cDivPgRF P Q c B w b bL Bb + (2 * Bb + 2))

end GatherLemmas

end KFD

end NLogN

end

