noncomputable def sourceFourEnd (Q p : ℕ) (j k : Fin (Q+1)) : Module.End ℂ (Space Q) :=
  annihilate k * annihilate j * sourcePairEnd Q p

noncomputable def limitFourEnd (Q p : ℕ) (j k : Fin (Q+1)) : Module.End ℂ (Space Q) :=
