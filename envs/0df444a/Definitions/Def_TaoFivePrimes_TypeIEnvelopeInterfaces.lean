namespace TaoFivePrimes
namespace TypeIOuterDAssembly
noncomputable def fullInnerSupport (x : ℝ) (d : ℕ) : Finset ℕ :=
  (Finset.Ioc 0 ⌊x⌋₊).filter fun w =>
    (d, w) ∈ eta0VaughanOpenOddPairs x
noncomputable def transferredInnerSupport
    (x V : ℝ) (d : ℕ) : Finset ℕ :=
  (fullInnerSupport x d).filter fun w => ⌊V⌋₊ < w
noncomputable def fullCombinedCoefficient
    (U V : ℝ) (d w : ℕ) : ℝ :=
  (if d ≤ ⌊U⌋₊ then
      (μ d : ℝ) * Real.log (w : ℝ)
    else 0) -
    vaughanTypeICorrectionCoefficient ⌊U⌋₊ ⌊V⌋₊ d
noncomputable def transferredCoefficient
    (U : ℝ) (d w : ℕ) : ℝ :=
  if ⌊U⌋₊ < d then
    (μ d : ℝ) * ((1 / 2 : ℝ) * Real.log (w : ℝ))
  else 0
noncomputable def outerSlice
    (x alpha U V : ℝ) (d : ℕ) : ℂ :=
  (∑ w ∈ fullInnerSupport x d,
      ((fullCombinedCoefficient U V d w : ℝ) : ℂ) *
        eta0VaughanTest x alpha (d * w)) +
    ∑ w ∈ transferredInnerSupport x V d,
      ((transferredCoefficient U d w : ℝ) : ℂ) *
        eta0VaughanTest x alpha (d * w)
end TypeIOuterDAssembly
end TaoFivePrimes
