-- title:
--   Theorem 1 (first claim): $\sum_{i\ge0} r_{M_i}(x_i)^3 \le \frac{12}{L_0}(f(x_0) - f^*)$
-- statement:
--   Let $F \subseteq \mathbb{R}^n$ be a closed convex set with nonempty interior, and let $f$ be twice differentiable on $F$, with gradient $f'(x)$ and Hessian $f''(x)$. Assume the Hessian is Lipschitz continuous on $F$ in the spectral norm (Assumption 1): for some $L > 0$,
--   $$\|f''(x) - f''(y)\| \le L\,\|x - y\| \qquad \text{for all } x, y \in F.$$
--
--   Let $x_0 \in \operatorname{int} F$ be a starting point such that $F$ contains the level set $\mathcal{L}(f(x_0)) = \{x \in \mathbb{R}^n : f(x) \le f(x_0)\}$ in its interior.
--
--   Let $0 < L_0 \le L$ and let $\{x_k\}_{k \ge 0}$ be generated by the **cubic regularization of Newton method** (3.3): $x_0$ is the starting point and, at every iteration $k \ge 0$, a parameter $M_k \in [L_0, 2L]$ is chosen such that $f(T_{M_k}(x_k)) \le \bar f_{M_k}(x_k)$, and $x_{k+1} = T_{M_k}(x_k)$. Here $T_M(x)$ is any global minimizer of the cubic model $y \mapsto \langle f'(x), y - x\rangle + \tfrac12\langle f''(x)(y - x), y - x\rangle + \tfrac{M}{6}\|y - x\|^3$ and $\bar f_M(x) = f(x) + \min_y(\text{cubic model})$. Assume $f$ is bounded below on $F$: $f(x) \ge f^*$ for all $x \in F$.
--
--   Then, with $r_{M_i}(x_i) = \|x_i - x_{i+1}\|$, the series of cubed step lengths converges and
--   $$\sum_{i=0}^{\infty} r_{M_i}(x_i)^3 \le \frac{12}{L_0}\,\big(f(x_0) - f^*\big).$$
--   This is the first claim of Theorem 1; the other two (the limit of $\mu_L$ and inequality (3.4)) follow from it together with Lemma 5.
--
--   **Formalization Note** The space is `EuclideanSpace ℝ (Fin n)`. The gradient and Hessian are given as maps `g` and `H` with `HasGradientAt f (g x) x` and `HasFDerivAt g (H x) x` at every `x ∈ F` (two-sided derivatives, also at boundary points of $F$); the operator norm on `H x` is the spectral norm. A run is the predicate `IsCubicNewtonRun` on the sequences `x : ℕ → E` and `M : ℕ → ℝ`, 0-based as in the paper, with $\bar f_{M_k}(x_k)$ written as `f (x k) + cubicModel g H (M k) (x k) (x (k+1))`, which equals the minimum because $x_{k+1}$ attains it. The level-set hypothesis is written `{x | f x ≤ f x₀} ⊆ interior F`, for $f$ defined on all of $\mathbb{R}^n$ as in problem (3.1). The bound on the infinite sum is stated together with its summability, so the value of `tsum` is never Lean's default for a divergent series.
-- source:
--   Nesterov & Polyak, Cubic regularization of Newton method and its global performance, Math. Program. Ser. A 108 (2006) 177–205, DOI 10.1007/s10107-006-0706-8, p. 185, Theorem 1 (first claim)

import Mathlib
import Definitions.Def_CubicNewton_Shared_IsCubicNewtonRun

open scoped RealInnerProductSpace

namespace CubicNewton.Nonconvex

/-- Nesterov–Polyak 2006, Theorem 1 (first claim), p. 185: along every run of method (3.3),
`∑_{i ≥ 0} r_{M_i}(x_i)³ ≤ (12/L₀)(f(x₀) − f*)`, with `r_{M_i}(x_i) = ‖x_i − x_{i+1}‖`. -/
theorem run_sum_cubes_le {n : ℕ}
    (F : Set (EuclideanSpace ℝ (Fin n))) (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (H : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (L : ℝ)
    (hF_closed : IsClosed F) (hF_convex : Convex ℝ F)
    (hf : ∀ x ∈ F, HasGradientAt f (g x) x) (hg : ∀ x ∈ F, HasFDerivAt g (H x) x)
    (hL : 0 < L) (hLip : ∀ x ∈ F, ∀ y ∈ F, ‖H x - H y‖ ≤ L * ‖x - y‖)
    (x₀ : EuclideanSpace ℝ (Fin n)) (hx₀ : x₀ ∈ interior F)
    (hlevel : {x | f x ≤ f x₀} ⊆ interior F)
    (L₀ : ℝ) (hL₀ : 0 < L₀) (hL₀L : L₀ ≤ L)
    (fstar : ℝ) (hfstar : ∀ y ∈ F, fstar ≤ f y)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (M : ℕ → ℝ) (hrun : CubicNewton.Shared.IsCubicNewtonRun f g H L₀ L x₀ x M) :
    Summable (fun i => ‖x i - x (i + 1)‖ ^ 3) ∧
      ∑' i, ‖x i - x (i + 1)‖ ^ 3 ≤ 12 / L₀ * (f x₀ - fstar) := by sorry

end CubicNewton.Nonconvex
