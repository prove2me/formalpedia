theorem Formalism.REAL.lie_derivative_mul {f h : Matrix (Fin n) (Fin n) ℂ → ℂ} (a b : Fin n) {g : Matrix (Fin n) (Fin n) ℂ}
    (hf : SmoothOnG ε f) (hh : SmoothOnG ε h) (hg : inUJ ε g) :
    Eab ε a b (fun x => f x * h x) g = Eab ε a b f g * h g + f g * Eab ε a b h g := by sorry
