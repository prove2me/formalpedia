    · exact Dvd.intro (r * k) (by rw [hk]; ring)
  rw [show b * (r * (r - 1) / 2) = b * (r * (r - 1)) / 2 by
        rw [Int.mul_ediv_assoc b hdvd]]
  rw [show b * r * (r - 1) = b * (r * (r - 1)) by ring]

