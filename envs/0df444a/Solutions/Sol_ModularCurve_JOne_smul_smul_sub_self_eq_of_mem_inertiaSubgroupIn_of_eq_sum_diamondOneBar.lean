  exact IntermediateField.adjoin.mono _ _ _ (Set.image_mono (x1x0_le_x1 M₀ q))

def incl : Fbot M₀ q →ₐ[Qb] Ftop M₀ q :=
  IntermediateField.inclusion (fbot_le_ftop M₀ q)

@[scoped simp]
theorem coe_incl (x : Fbot M₀ q) : ((incl M₀ q x : Ftop M₀ q) : LaurentSeries Qb) = x :=
  IntermediateField.coe_inclusion _ x

theorem intertwines_incl (g : Qb ≃ₐ[ℚ] Qb) :
    IntertwinesAlong (incl M₀ q).toRingHom
      (arithmeticGalois (x1x0FunctionFieldC ℚ M₀ q) g)
      (arithmeticGalois (x1FunctionField (M₀ * q)) g) := by
