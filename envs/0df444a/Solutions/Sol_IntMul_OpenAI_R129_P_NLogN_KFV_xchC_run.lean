variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
set_option maxHeartbeats 1000000
theorem solution {eSw : Fin Pp} {dW : Fin NLogN.HS} {Kc : ℝ} (HSw : IntMul.OpenAI.R129.P.NLogN.KFV.SwOK I iprog eSw dW Kc)
    (hd0 : dW ≠ 0) (hd56 : dW.val < 56) (hKc : 0 ≤ Kc)
    (S : NLogN.IState NLogN.HS) (zs : List NLogN.KFB.GI) (l : List ℤ) {i j K n ℓ W B : ℕ}
    (hij : i + K ≤ j) (hj : j + K ≤ n) (hK : 1 ≤ K)
    (hzs : zs.length = 2 ^ n * 2 ^ ℓ) (hgb : NLogN.KFB.GB W zs)
    {eE eK eM eI eW : NLogN.Ex NLogN.HS} (sE : NLogN.KFV.DSafe dW eE) (sK : NLogN.KFV.DSafe dW eK) (sM : NLogN.KFV.DSafe dW eM)
    (sI : NLogN.KFV.DSafe dW eI) (sW : NLogN.KFV.DSafe dW eW)
    (vE : NLogN.KFV.EV (NLogN.KIL.encK S (NLogN.KFV.o0 (NLogN.KFB.gflat zs ++ l))) B eE ((n - j - K + ℓ : ℕ) : ℤ))
    (vK : NLogN.KFV.EV (NLogN.KIL.encK S (NLogN.KFV.o0 (NLogN.KFB.gflat zs ++ l))) B eK (K : ℤ))
    (vM : NLogN.KFV.EV (NLogN.KIL.encK S (NLogN.KFV.o0 (NLogN.KFB.gflat zs ++ l))) B eM ((j - i - K : ℕ) : ℤ))
    (vI : NLogN.KFV.EV (NLogN.KIL.encK S (NLogN.KFV.o0 (NLogN.KFB.gflat zs ++ l))) B eI (i : ℤ))
    (vW : NLogN.KFV.EV (NLogN.KIL.encK S (NLogN.KFV.o0 (NLogN.KFB.gflat zs ++ l))) B eW (W : ℤ))
    (hB : n + ℓ + 5 ≤ B) (hWB : W ≤ B) :
    NLogN.IRuns I iprog (NLogN.KFV.xchC eSw dW eE eK eM eI eW) (NLogN.KIL.encK S (NLogN.KFV.o0 (NLogN.KFB.gflat zs ++ l)))
      (NLogN.KIL.encK S (NLogN.KFV.o0 (NLogN.KFB.gflat (NLogN.KFV.zMv n (2 ^ ℓ) (AModel.bsIdx i j K) zs) ++ l)))
      (IntMul.OpenAI.R129.P.NLogN.KFV.cXch Kc eE eK eM eI eW n ℓ K W B) := by
  set v := NLogN.KFB.gflat zs ++ l
  set m := j - i - K
  set E := n - j - K + ℓ
  have z : ∀ x : ℕ, x ≤ B → NLogN.zsz (x : ℤ) ≤ B := fun x hx => NLogN.KFV.zsz_nat_le hx
  have zP : ∀ k, k < B → NLogN.zsz (((2 ^ k : ℕ) : ℤ)) ≤ B := fun k hk =>
    NLogN.KFV.zsz_nat_lt (Nat.pow_lt_pow_right (by norm_num) hk)
  have z5 : NLogN.zsz (5 : ℤ) ≤ B := by
    have := z 5 (by omega); simpa using this
  have z3 : NLogN.zsz (3 : ℤ) ≤ B := by
    have := z 3 (by omega); simpa using this
  have z1 : NLogN.zsz (1 : ℤ) ≤ B := by
    have := z 1 (by omega); simpa using this
  set ps : List (NLogN.Ex NLogN.HS × ℤ) := [(.pow2 eE, ((2 ^ E : ℕ) : ℤ)), (.pow2 eK, ((2 ^ K : ℕ) : ℤ)),
    (.pow2 eM, ((2 ^ m : ℕ) : ℤ)), (.pow2 eK, ((2 ^ K : ℕ) : ℤ)), (.pow2 eI, ((2 ^ i : ℕ) : ℤ)),
    (.lit 5, 5), (.lit 3, 3), (.lit 1, 1), (eK, (K : ℤ)), (eW, (W : ℤ))]
  have hps : ps.map Prod.fst = NLogN.KFV.xchEs eE eK eM eI eW := rfl
  have hpv : (ps.map Prod.snd).reverse = NLogN.KFM.descSw W K 1 3 (NLogN.KFV.sh5 i K m E) := by
    simp [ps, NLogN.KFM.descSw, NLogN.KFV.sh5]
  have hsafe : ∀ p ∈ ps, NLogN.KFV.EV (NLogN.KIL.encK S (NLogN.KFV.o0 v)) B p.1 p.2 ∧ p.1.Clean ∧ ∀ r ∈ p.1.regs, r ≠ dW := by
    intro p hp
    simp only [ps, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨vE.pow2 (by omega), sE.1, sE.2⟩
    · exact ⟨vK.pow2 (by omega), sK.1, sK.2⟩
    · exact ⟨vM.pow2 (by omega), sM.1, sM.2⟩
    · exact ⟨vK.pow2 (by omega), sK.1, sK.2⟩
    · exact ⟨vI.pow2 (by omega), sI.1, sI.2⟩
    · exact ⟨NLogN.KFV.EV.lit z5, fun _ h => by simp [NLogN.Ex.regs] at h, fun _ h => by simp [NLogN.Ex.regs] at h⟩
    · exact ⟨NLogN.KFV.EV.lit z3, fun _ h => by simp [NLogN.Ex.regs] at h, fun _ h => by simp [NLogN.Ex.regs] at h⟩
    · exact ⟨NLogN.KFV.EV.lit z1, fun _ h => by simp [NLogN.Ex.regs] at h, fun _ h => by simp [NLogN.Ex.regs] at h⟩
    · exact ⟨vK, sK.1, sK.2⟩
    · exact ⟨vW, sW.1, sW.2⟩
  have P1 := NLogN.KFV.pushL_sp S (NLogN.KFV.o0 v) hd56 ps [] hsafe
  rw [hps, hpv, List.append_nil, NLogN.KFV.upd_o0_nil v hd0] at P1
  have R1 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (NLogN.KFV.fok_pushL _ _)
    (NLogN.KFD.FSp.of_norep (NLogN.KFV.norep_pushL _ _) P1)
  -- the call
  have hvol : AModel.vol (NLogN.KFV.sh5 i K m E) = 2 ^ (n + ℓ) := by
    rw [NLogN.KFV.vol_sh5]; congr 1; omega
  obtain ⟨c, RC, hc⟩ := HSw K W (NLogN.KFV.sh5 i K m E) 1 3 hK
    (by intro a ha; simp only [NLogN.KFV.sh5, List.mem_cons, List.not_mem_nil, or_false] at ha
        rcases ha with rfl | rfl | rfl | rfl | rfl <;> exact Nat.one_le_two_pow)
    (by norm_num) (by simp [NLogN.KFV.sh5]) (by simp [NLogN.KFV.sh5]) (by simp [NLogN.KFV.sh5])
    S (Function.update (NLogN.KFV.o0 v) dW (NLogN.KFM.descSw W K 1 3 (NLogN.KFV.sh5 i K m E))) zs l
    (fun j hj0 hjd => by simp [Function.update_apply, hjd, NLogN.KFV.o0_ne v hj0])
    (by simp) (by rw [Function.update_of_ne hd0.symm]; simp [v])
    (by rw [hvol, hzs, pow_add]) hgb
  -- the result
  have hP : AModel.pull (NLogN.KFV.sh5 i K m E) (NLogN.KFV.sh5 i K m E) (AModel.swapPos 1 3) 0 zs = NLogN.KFV.zMv n (2 ^ ℓ) (AModel.bsIdx i j K) zs := by
    unfold NLogN.KFV.zMv
    rw [NLogN.KFV.pull_ext_xch hij hj]
    congr 2 <;> simp [NLogN.KFV.sh5, E, ← pow_add] <;> omega
  rw [hP] at RC
  set v' := NLogN.KFB.gflat (NLogN.KFV.zMv n (2 ^ ℓ) (AModel.bsIdx i j K) zs) ++ l
  have eF : Function.update (Function.update (NLogN.KFV.o0 v) dW (NLogN.KFM.descSw W K 1 3 (NLogN.KFV.sh5 i K m E))) 0 v' =
      Function.update (NLogN.KFV.o0 v') dW (NLogN.KFM.descSw W K 1 3 (NLogN.KFV.sh5 i K m E) ++ []) := by
    funext x
    simp only [Function.update_apply, NLogN.KFV.o0, List.append_nil]
    split_ifs <;> simp_all
  rw [eF] at RC
  have hz : ∀ x ∈ NLogN.KFM.descSw W K 1 3 (NLogN.KFV.sh5 i K m E), NLogN.zsz x ≤ B := by
    intro x hx
    rw [← hpv, List.mem_reverse] at hx
    obtain ⟨q, hq, rfl⟩ := List.mem_map.1 hx
    have h := (hsafe q hq).1
    rw [← h.2.1]
    exact NLogN.Ex.zsz_eval_le _ B _ h.2.2
  have P3 := NLogN.KFV.popN_sp S (NLogN.KFV.o0 v') hd56 (NLogN.KFM.descSw W K 1 3 (NLogN.KFV.sh5 i K m E)) [] hz
  have hlen10 : (NLogN.KFM.descSw W K 1 3 (NLogN.KFV.sh5 i K m E)).length = 10 := by simp [NLogN.KFM.descSw, NLogN.KFV.sh5]
  rw [hlen10, NLogN.KFV.upd_o0_nil v' hd0] at P3
  have R3 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (NLogN.KFV.fok_popN _ _) (NLogN.KFD.FSp.of_norep (NLogN.KFV.norep_popN _ _) P3)
  refine (R1.seq (RC.seq R3)).mono' rfl ?_
  have hc' : c ≤ ⌈Kc * (((W : ℝ) + 1) * ((2 ^ (n + ℓ) : ℕ) + 1) * (K : ℝ) ^ IntMul.OpenAI.R129.P.NLogN.KFS.τS +
      (((5 + 1) * (Nat.size (2 ^ (n + ℓ)) + W + K + 1) ^ 2 : ℕ) : ℝ))⌉₊ := by
    have : (NLogN.KFV.sh5 i K m E).length = 5 := rfl
    rw [hvol, this] at hc
    exact_mod_cast hc.trans (Nat.le_ceil _)
  unfold IntMul.OpenAI.R129.P.NLogN.KFV.cXch
  omega
end
