theorem le_supTo (To : List ℕ → ℕ) {n U p : ℕ} (hp : p ≤ Light.Filter2.PmaxOf n) :
    To [n, U, Light.Filter2.sOf n, p] ≤ Light.Filter2.supTo To n U :=
  Finset.le_sup (f := fun p => To [n, U, Light.Filter2.sOf n, p]) (Finset.mem_range.2 (by omega))

theorem Env.n_pos {d : ℕ} {x : AEInst} {fr : ℕ} {μ0 : ℕ → ℤ} {needo : List ℕ → Light.Need}
    (E : Light.Filter2.Env lim d x fr μ0 needo) : 1 ≤ x.n := E.pre.n_pos

/-- The places, in order. -/
theorem layout (n fr : ℕ) : fr + 2 * Light.Filter2.RR n = Light.Filter2.aPL n fr ∧ Light.Filter2.aPL n fr + 2 * Light.Filter2.RR n = Light.Filter2.aACT n fr ∧
    Light.Filter2.aACT n fr + Light.Filter2.LL n = Light.Filter2.aDONE n fr ∧ Light.Filter2.aDONE n fr + n * n = Light.Filter2.aUA n fr ∧ Light.Filter2.aUA n fr + n * n = Light.Filter2.aCNT n fr ∧
    Light.Filter2.aCNT n fr + Light.Filter2.LL n = Light.Filter2.aGT n fr ∧ Light.Filter2.aGT n fr + 2 * Light.Filter2.RR n * (n * n) = Light.Filter2.aTOP n fr := by
  refine ⟨rfl, ?_, rfl, rfl, rfl, rfl, rfl⟩
  unfold Light.Filter2.aPL Light.Filter2.aACT
  omega

theorem seg_cntList_arr {μ : ℕ → ℤ} {a n s p : ℕ} {AB BC AC : List ℤ}
    (h : Seg μ a (Light.Filter2.cntList n s p AB BC AC)) :
    Light.Filter2.Arr μ a ((n + s - 1) / s * (n * n)) fun i => (Light.Filter2.cntOf n s p AB BC AC i : ℤ) := fun i hi => by
  rw [h i (by simp [Light.Filter2.cntList]; exact hi)]
  simp [Light.Filter2.cntList]

/-- **The oracle**, called at the modulus `p ≤ Pmax`: it writes the counts to `cnt`. -/
theorem oracle_call {P₀ R : Program} {pO : ℕ} {To : List ℕ → ℕ} {needo : List ℕ → Light.Need}
    (hsol : SolvesN Light.Filter2.oracleTask P₀ pO To needo) {d0 : ℕ} {x : AEInst} {fr : ℕ} {μ0 : ℕ → ℤ}
    (E : Light.Filter2.Env lim d0 x fr μ0 needo) {d : ℕ} (hd : d ≤ d0 + 4) {μ : ℕ → ℤ} (hk : Light.Kept μ0 μ fr)
    {p : ℕ} (hp1 : 1 ≤ p) (hp : p ≤ Light.Filter2.PmaxOf x.n) :
    Meets lim (P₀ ++ R) pO d [x.n, x.U, x.ab, x.bc, x.ac, Light.Filter2.sOf x.n, p, Light.Filter2.aCNT x.n fr, Light.Filter2.aTOP x.n fr] μ
      (Light.Filter2.supTo To x.n x.U) fun _ μ' =>
        Light.Filter2.Arr μ' (Light.Filter2.aCNT x.n fr) (Light.Filter2.LL x.n) (fun i => (Light.Filter2.cntOf x.n (Light.Filter2.sOf x.n) p x.AB x.BC x.AC i : ℤ)) ∧
          KeptBut μ μ' (Light.Filter2.aTOP x.n fr) (Light.Filter2.aCNT x.n fr) (Light.Filter2.LL x.n) := by
  have hpre := E.pre
  have hn := E.n_pos
  obtain ⟨_, _, _, _, _, _, _⟩ := Light.Filter2.layout x.n fr
  have hbo := hpre.belowOut
  have hAB := hpre.belowAB
  have hBC := hpre.belowBC
  have hAC := hpre.belowAC
  have hopre : (Light.Filter2.oInst x fr p).Pre μ (Light.Filter2.aTOP x.n fr) :=
    { toPre := (hpre.toPre.keep hk).mono (by omega)
      s_pos := sOf_pos x.n
      s_le := sOf_le hn
      p_pos := hp1
      belowCnt := by simp only [Light.Filter2.oInst, Light.Filter2.OracleInst.len]; unfold Light.Filter2.LL Light.Filter2.mOf at *; omega
      apartAB := by simp only [Light.Filter2.oInst, Light.Filter2.OracleInst.len, Apart]; omega
      apartBC := by simp only [Light.Filter2.oInst, Light.Filter2.OracleInst.len, Apart]; omega
      apartAC := by simp only [Light.Filter2.oInst, Light.Filter2.OracleInst.len, Apart]; omega }
  have hok : (needo (Light.Filter2.oracleTask.pars (Light.Filter2.oInst x fr p))).Ok lim (Light.Filter2.aTOP x.n fr) d := by
    show (needo [x.n, x.U, Light.Filter2.sOf x.n, p]).Ok lim (Light.Filter2.aTOP x.n fr) d
    exact (E.oracle p hp).mono le_rfl le_rfl (by omega)
  have h := hsol.meets R (Light.Filter2.oInst x fr p) hopre hok
  refine h.mono (le_supTo To hp) ?_
  rintro r μ' ⟨hseg, hkept⟩
  exact ⟨seg_cntList_arr hseg, hkept⟩

theorem filterWord_eq (n U : ℕ) : Light.Filter2.filterWord n U = 10 ^ 9 * (Light.Filter2.KW n U * Light.Filter2.KW n U) := by
  unfold Light.Filter2.filterWord Light.Filter2.KW; ring

theorem KW_ge (n U : ℕ) : (n + 1) ^ 3 ≤ Light.Filter2.KW n U ∧ U + 1 ≤ Light.Filter2.KW n U ∧ Light.Filter2.RR n + 1 ≤ Light.Filter2.KW n U ∧
    Light.Filter2.PmaxOf n + 1 ≤ Light.Filter2.KW n U := by
  have h1 : 1 ≤ (n + 1) ^ 3 := Nat.one_le_pow _ _ (by omega)
  have h2 : 1 ≤ U + 1 := by omega
  have h3 : 1 ≤ Light.Filter2.RR n + 1 := by omega
  have h4 : 1 ≤ Light.Filter2.PmaxOf n + 1 := by omega
  unfold Light.Filter2.KW
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc (n + 1) ^ 3 = (n + 1) ^ 3 * 1 * 1 * 1 := by ring
      _ ≤ _ := by gcongr
  · calc U + 1 = 1 * (U + 1) * 1 * 1 := by ring
      _ ≤ _ := by gcongr
  · calc Light.Filter2.RR n + 1 = 1 * 1 * (Light.Filter2.RR n + 1) * 1 := by ring
      _ ≤ _ := by gcongr
  · calc Light.Filter2.PmaxOf n + 1 = 1 * 1 * 1 * (Light.Filter2.PmaxOf n + 1) := by ring
      _ ≤ _ := by gcongr

theorem le_filterWord {n U a : ℕ} (h : a ≤ 1000 * (Light.Filter2.KW n U * Light.Filter2.KW n U)) : a ≤ Light.Filter2.filterWord n U := by
  rw [filterWord_eq]; omega

theorem hOf_le (n U : ℕ) : Light.Filter2.hOf n U ≤ 3 * U := by
  unfold Light.Filter2.hOf Light.Filter2.BOf
  have : Nat.size (3 * U) ≤ 3 * U := Nat.size_le.2 Nat.lt_two_pow_self
  exact (Nat.div_le_self _ _).trans (by omega)

theorem mass_le {n s : ℕ} {AB BC AC : List ℤ} (A : ℕ → Bool) (M : ℕ) {g : ℕ} (hg : g < n * n) :
    Light.Filter2.mass n s AB BC AC A M g ≤ (n + s - 1) / s * s := by
  rw [mass_eq_sum _ _ hg]
  calc _ ≤ ∑ j ∈ Finset.range ((n + s - 1) / s), s := Finset.sum_le_sum fun j _ => by
        split_ifs
        · exact cntOf_le_s M _
        · exact Nat.zero_le _
    _ = _ := by simp

/-- The numbers that the host forms. -/
theorem word_facts {n U : ℕ} (hn : 1 ≤ n) :
    Light.Filter2.mOf n * Light.Filter2.sOf n + Light.Filter2.mOf n + 1 ≤ Light.Filter2.filterWord n U ∧
    (Light.Filter2.QOf n + Light.Filter2.hOf n U + 1) * (Light.Filter2.mOf n * Light.Filter2.sOf n + 1) ≤ Light.Filter2.filterWord n U ∧
    n * n * (Light.Filter2.mOf n * Light.Filter2.sOf n) + n * n + Light.Filter2.QOf n + 1 ≤ Light.Filter2.filterWord n U ∧
    Light.Filter2.PmaxOf n + 1 ≤ Light.Filter2.filterWord n U ∧
    Light.Filter2.LL n + n + Light.Filter2.sOf n ≤ Light.Filter2.filterWord n U ∧
    3 * U + 1 ≤ Light.Filter2.filterWord n U ∧
    4 * Light.Filter2.RR n + 2 ≤ Light.Filter2.filterWord n U := by
  obtain ⟨k1, k2, k3, k4⟩ := KW_ge n U
  have hs := sOf_le hn
  have hm := mOf_le n
  have hQ := QOf_lt n
  have hh := hOf_le n U
  set K := Light.Filter2.KW n U
  have hK : 1 ≤ K := by nlinarith [Nat.one_le_pow 3 (n + 1) (by omega)]
  have hn3 : (n + 1) ^ 3 = (n + 1) * (n + 1) * (n + 1) := by ring
  have hms : Light.Filter2.mOf n * Light.Filter2.sOf n ≤ n * n := Nat.mul_le_mul hm hs
  have hnn : n * n ≤ K := by nlinarith
  have hnK : n ≤ K := by nlinarith
  have hL : Light.Filter2.LL n ≤ K := by
    unfold Light.Filter2.LL
    calc Light.Filter2.mOf n * (n * n) ≤ n * (n * n) := Nat.mul_le_mul_right _ hm
      _ ≤ K := by nlinarith
  refine ⟨le_filterWord ?_, le_filterWord ?_, le_filterWord ?_, le_filterWord ?_, le_filterWord ?_,
    le_filterWord ?_, le_filterWord ?_⟩
  · nlinarith
  · have h1 : Light.Filter2.QOf n + Light.Filter2.hOf n U + 1 ≤ 6 * K := by omega
    have h2 : Light.Filter2.mOf n * Light.Filter2.sOf n + 1 ≤ 2 * K := by omega
    calc (Light.Filter2.QOf n + Light.Filter2.hOf n U + 1) * (Light.Filter2.mOf n * Light.Filter2.sOf n + 1) ≤ (6 * K) * (2 * K) := Nat.mul_le_mul h1 h2
      _ ≤ 1000 * (K * K) := by nlinarith
  · have h1 : n * n * (Light.Filter2.mOf n * Light.Filter2.sOf n) ≤ K * K := Nat.mul_le_mul hnn (hms.trans hnn)
    nlinarith
  · nlinarith
  · nlinarith
  · nlinarith
  · nlinarith

section keep

variable {x : AEInst} {fr : ℕ} {μ0 μ μ' : ℕ → ℤ} {act D : ℕ → Bool} {M : ℕ}

/-- Writes from `cnt` on keep the memory of the host. -/
theorem FMem.keep (h : Light.Filter2.FMem x fr μ0 μ act D) (hs : SameOn (· < Light.Filter2.aCNT x.n fr) μ μ') :
    Light.Filter2.FMem x fr μ0 μ' act D := by
  obtain ⟨_, _, _, _, _, _, _⟩ := Light.Filter2.layout x.n fr
  have hQ := QOf_lt x.n
  exact ⟨fun a ha => (hs a (by omega)).trans (h.kept a ha),
    h.pool.congr fun i hi => hs _ (by omega), h.act.congr fun i hi => hs _ (by omega),
    h.done.congr fun i hi => hs _ (by omega)⟩

theorem FMem.keepU (h : Light.Filter2.FMem x fr μ0 μ act D) (hs : SameOn (· < Light.Filter2.aUA x.n fr) μ μ') :
    Light.Filter2.FMem x fr μ0 μ' act D := by
  obtain ⟨_, _, _, _, _, _, _⟩ := Light.Filter2.layout x.n fr
  have hQ := QOf_lt x.n
  exact ⟨fun a ha => (hs a (by omega)).trans (h.kept a ha),
    h.pool.congr fun i hi => hs _ (by omega), h.act.congr fun i hi => hs _ (by omega),
    h.done.congr fun i hi => hs _ (by omega)⟩

theorem UOk.keep (h : Light.Filter2.UOk x fr μ act D M) (hs : SameOn (· < Light.Filter2.aCNT x.n fr) μ μ') :
    Light.Filter2.UOk x fr μ' act D M := fun g hg hD => by
  obtain ⟨_, _, _, _, _, _, _⟩ := Light.Filter2.layout x.n fr
  rw [hs _ (by omega)]
  exact h g hg hD

end keep

section step

variable {P₀ R : Program} {pO pAggr pCert pArg pCopy : ℕ} {To : List ℕ → ℕ}
  {needo : List ℕ → Need} {d0 : ℕ} {x : AEInst} {fr : ℕ} {μ0 : ℕ → ℤ}

set_option maxHeartbeats 400000 in
/-- One round of the loop over the pool: the oracle at `M q`, and the masses at `M q`. -/
theorem stepRound_spec (hsol : SolvesN Light.Filter2.oracleTask P₀ pO To needo)
    (HP : Light.Filter2.StepProcs (P₀ ++ R) pAggr pCert pArg pCopy) (E : Light.Filter2.Env lim d0 x fr μ0 needo) {d : ℕ}
    (hd : d ≤ d0 + 3) {act D : ℕ → Bool} {Mc : ℕ} (hM1 : 1 ≤ Mc)
    (hM : Mc * (2 * Light.Filter2.RR x.n) ≤ Light.Filter2.PmaxOf x.n) {t : ℕ} (ht : t < Light.Filter2.QOf x.n) (z : ℤ) {μ' : ℕ → ℤ}
    (hmem : Light.Filter2.FMem x fr μ0 μ' act D) (hU : Light.Filter2.UOk x fr μ' act D Mc) (hG : Light.Filter2.GOk x fr μ' act Mc t) :
    Ends lim (P₀ ++ R) d
      (.call pO [Light.v 0, Light.v 1, Light.v 2, Light.v 3, Light.v 4, Light.v 5, Light.v 17 *' M (Light.v 6 +' Light.v 18), Light.v 10, Light.v 12] 19 ;;
        .call pAggr [Light.v 10, Light.v 7, Light.v 11 +' Light.v 18 *' Light.v 13, Light.v 13, Light.v 14] 19)
      ⟨Light.frame (setLocal (setLocal (Light.Filter2.stepArgs x fr Mc) 19 z) 18 t), μ'⟩
      (Light.Filter2.supTo To x.n x.U + Light.Filter2.tAggr (x.n * x.n) (Light.Filter2.mOf x.n) + 27) fun σ' =>
        Light.Filter2.FMem x fr μ0 σ'.mem act D ∧ Light.Filter2.UOk x fr σ'.mem act D Mc ∧ Light.Filter2.GOk x fr σ'.mem act Mc (t + 1) := by
  have hn := E.n_pos
  obtain ⟨l1, l2, l3, l4, l5, l6, l7⟩ := Light.Filter2.layout x.n fr
  have hsp := E.space
  have hw := E.hw
  obtain ⟨w1, w2, w3, w4, w5, w6, w7⟩ := word_facts (U := x.U) hn
  have hword := E.word
  have hdep := E.depth
  have hQ := QOf_lt x.n
  have hpoolt := hmem.pool t ht
  obtain ⟨hq1, hq2, -⟩ := pool_bounds (poolAt_mem ht)
  have hR := RR_two_le x.n
  have hp : Mc * Light.Filter2.poolAt x.n t ≤ Light.Filter2.PmaxOf x.n :=
    le_trans (Nat.mul_le_mul_left Mc hq2.le) hM
  have hp1 : 1 ≤ Mc * Light.Filter2.poolAt x.n t := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
  have hpZ : (Mc : ℤ) * (Light.Filter2.poolAt x.n t : ℤ) ≤ lim.word := by
    have : ((Mc * Light.Filter2.poolAt x.n t : ℕ) : ℤ) ≤ (Light.Filter2.filterWord x.n x.U : ℤ) := by exact_mod_cast (by omega)
    push_cast at this
    omega
  have hpZ0 : (0 : ℤ) ≤ (Mc : ℤ) * (Light.Filter2.poolAt x.n t : ℤ) := Int.mul_nonneg (Int.natCast_nonneg _) (Int.natCast_nonneg _)
  have hLN : Light.Filter2.LL x.n = Light.Filter2.mOf x.n * (x.n * x.n) := rfl
  have htN : t * (x.n * x.n) + x.n * x.n ≤ 2 * Light.Filter2.RR x.n * (x.n * x.n) := by
    have := Nat.mul_le_mul_right (x.n * x.n) (show t + 1 ≤ 2 * Light.Filter2.RR x.n by omega)
    rw [Nat.add_mul, Nat.one_mul] at this
    exact this
  have htNZ : (0 : ℤ) ≤ (t : ℤ) * ((x.n : ℤ) * (x.n : ℤ)) := by positivity
  have htNZ' : (t : ℤ) * ((x.n : ℤ) * (x.n : ℤ)) + (x.n : ℤ) * (x.n : ℤ) ≤
      2 * (Light.Filter2.RR x.n : ℤ) * ((x.n : ℤ) * (x.n : ℤ)) := by exact_mod_cast htN
  simp only [Light.Filter2.stepArgs, setLocal]
  -- the oracle at M q
  (focus
     ((first
         | refine Light.Ends.seqSelf ?_
         | refine Light.Ends.skipLast ?_);
       (repeat
           with_unfolding_none
             first
             | refine Light.Ends.seqAssoc ?_
             | refine Light.Ends.skipThen ?_))
     (first
       |
         refine
           Light.Ends.callToThen
             ((oracle_call (R := R) hsol E (d := d + 1) (by omega) hmem.kept hp1 hp) _ (by omega)) ?_
             ?_ ?_ ?_
       |
         refine
           Light.Ends.callToThen (oracle_call (R := R) hsol E (d := d + 1) (by omega) hmem.kept hp1 hp)
             ?_ ?_ ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, hpoolt])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [hpoolt] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => omega)
     (on_goal -1 =>
         ( (try have := Light.Std.space_le (by assumption))
           (try have := Light.Std.const_le (by assumption))
           (simp [Light.Limits.Addr, abs_le, -abs_mul, hpoolt] <;> omega)))
     (on_goal -1 =>
         ((rintro _ μ1
               ⟨hcnt, hkb⟩
                   -- the masses at M q
                   );
           (try with_unfolding_none refine Light.Ends.skip ?_))))
  -- the masses at M q
  have hs1 : SameOn (· < Light.Filter2.aCNT x.n fr) μ' μ1 := fun a ha => hkb a ⟨by omega, by omega⟩
  have hmem1 := hmem.keep hs1
  have hc : ∀ i < Light.Filter2.mOf x.n * (x.n * x.n),
      Light.Filter2.cntOf x.n (Light.Filter2.sOf x.n) (Mc * Light.Filter2.poolAt x.n t) x.AB x.BC x.AC i ≤ Light.Filter2.sOf x.n :=
    fun i _ => cntOf_le_s _ _
  have hcall := aggr_meets (lim := lim) (d := d + 1) HP.aggr (μ := μ1) (cnt := Light.Filter2.aCNT x.n fr)
    (act := Light.Filter2.aACT x.n fr) (dst := Light.Filter2.aGT x.n fr + t * (x.n * x.n)) (N := x.n * x.n) (m := Light.Filter2.mOf x.n)
    (cmax := Light.Filter2.sOf x.n) (A := act)
    (c := fun i => Light.Filter2.cntOf x.n (Light.Filter2.sOf x.n) (Mc * Light.Filter2.poolAt x.n t) x.AB x.BC x.AC i)
    hmem1.act hcnt hc (by unfold Light.Filter2.LL at *; omega) (by unfold Light.Filter2.LL at *; omega) (by omega)
    (by unfold Light.Filter2.LL at *; omega) (by unfold Light.Filter2.LL at *; omega) hw
    (le_trans (by exact_mod_cast (by unfold Light.Filter2.LL at *; omega)) hword)
  have htNw : (Light.Filter2.aGT x.n fr : ℤ) + (t : ℤ) * ((x.n : ℤ) * (x.n : ℤ)) ≤ lim.word := by
    have : ((Light.Filter2.aGT x.n fr + t * (x.n * x.n) : ℕ) : ℤ) ≤ lim.space := by exact_mod_cast (by omega)
    push_cast at this
    omega
  (focus
     ((first
         | refine Light.Ends.seqSelf ?_
         | refine Light.Ends.skipLast ?_);
       (repeat
           with_unfolding_none
             first
             | refine Light.Ends.seqAssoc ?_
             | refine Light.Ends.skipThen ?_))
     (first
       | refine Light.Ends.callToThen (hcall _ (by omega)) ?_ ?_ ?_ ?_
       | refine Light.Ends.callToThen hcall ?_ ?_ ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, htNZ, htNw])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [htNZ, htNw] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => omega)
     (on_goal -1 =>
         ( (try have := Light.Std.space_le (by assumption))
           (try have := Light.Std.const_le (by assumption))
           (simp [Light.Limits.Addr, abs_le, -abs_mul, htNZ, htNw] <;> omega)))
     (on_goal -1 => ((rintro _ μ2 ⟨hgt, hso⟩); (try with_unfolding_none refine Light.Ends.skip ?_))))
  have hs2 : SameOn (· < Light.Filter2.aCNT x.n fr) μ' μ2 := fun a ha =>
    (hso a (Or.inl (by omega))).trans (hs1 a ha)
  refine ⟨hmem.keep hs2, hU.keep hs2, fun t' ht' g hg => ?_⟩
  dsimp only
  rcases Nat.lt_succ_iff_lt_or_eq.1 ht' with ht' | rfl
  · have h1 : t' * (x.n * x.n) + g < t * (x.n * x.n) := by
      have := Nat.mul_le_mul_right (x.n * x.n) (show t' + 1 ≤ t by omega)
      rw [Nat.add_mul, Nat.one_mul] at this
      omega
    rw [hso _ (Or.inl (by omega)), hkb _ ⟨by omega, Or.inr (by omega)⟩]
    exact hG t' ht' g hg
  · have := hgt g hg
    rw [show Light.Filter2.aGT x.n fr + (t' * (x.n * x.n) + g) = Light.Filter2.aGT x.n fr + t' * (x.n * x.n) + g by ring, this,
      mass_eq_sum _ _ hg]
    rfl

theorem stepD_iff (x : AEInst) (act D : ℕ → Bool) (Mc g : ℕ) :
    Light.Filter2.stepD x act D Mc g = true ↔
      (D g = true ∨ Light.Filter2.certOf x.n (Light.Filter2.sOf x.n) x.U x.AB x.BC x.AC act Mc g) := by
  simp [Light.Filter2.stepD, Light.Filter2.certOf]

set_option maxHeartbeats 800000 in
/-- **One step**: the certificate at `Mc`, and the choice of the prime `q*` of the pool that leaves
the least mass; it returns `Mc q*`. -/
theorem step_spec (hsol : SolvesN Light.Filter2.oracleTask P₀ pO To needo) {pStep : ℕ}
    (hS : (P₀ ++ R)[pStep]? = some (Light.Filter2.stepBody pO pAggr pCert pArg pCopy))
    (HP : Light.Filter2.StepProcs (P₀ ++ R) pAggr pCert pArg pCopy) (E : Light.Filter2.Env lim d0 x fr μ0 needo) {d : ℕ}
    (hd : d ≤ d0 + 3) {act D : ℕ → Bool} {Mc : ℕ} (hM1 : 1 ≤ Mc)
    (hM : Mc * (2 * Light.Filter2.RR x.n) ≤ Light.Filter2.PmaxOf x.n) {μ : ℕ → ℤ}
    (hmem : Light.Filter2.FMem x fr μ0 μ act D) (hU : Light.Filter2.UOk x fr μ act D Mc) :
    Meets lim (P₀ ++ R) pStep d (Light.Filter2.stepArgs x fr Mc) μ (Light.Filter2.tStep To x.n x.U) fun r μ' =>
      ∃ ts < Light.Filter2.QOf x.n, r = ((Mc * Light.Filter2.poolAt x.n ts : ℕ) : ℤ) ∧
        Light.Filter2.FMem x fr μ0 μ' act (Light.Filter2.stepD x act D Mc) ∧ Light.Filter2.UOk x fr μ' act (Light.Filter2.stepD x act D Mc) (Mc * Light.Filter2.poolAt x.n ts) ∧
        ∀ t < Light.Filter2.QOf x.n, Light.Filter2.remMass x act (Light.Filter2.stepD x act D Mc) (Mc * Light.Filter2.poolAt x.n ts) ≤
          Light.Filter2.remMass x act (Light.Filter2.stepD x act D Mc) (Mc * Light.Filter2.poolAt x.n t) := by
  have hn := E.n_pos
  obtain ⟨l1, l2, l3, l4, l5, l6, l7⟩ := Light.Filter2.layout x.n fr
  have hsp := E.space
  have hw := E.hw
  obtain ⟨w1, w2, w3, w4, w5, w6, w7⟩ := word_facts (U := x.U) hn
  have hword := E.word
  have hdep := E.depth
  have hQ := QOf_lt x.n
  have hQ0 := QOf_pos x.n
  have hR := RR_two_le x.n
  have hQN : Light.Filter2.QOf x.n * (x.n * x.n) ≤ 2 * Light.Filter2.RR x.n * (x.n * x.n) := Nat.mul_le_mul_right _ hQ
  refine Meets.of_body hS ?_
  unfold Light.Filter2.stepBody Light.Filter2.tStep
  refine Ends.next (Light.Filter2.QOf x.n * (Light.Filter2.supTo To x.n x.U + Light.Filter2.tAggr (x.n * x.n) (Light.Filter2.mOf x.n) + 40) + 10)
    (Ends.forScratch [19] (fun t μ' => Light.Filter2.FMem x fr μ0 μ' act D ∧ Light.Filter2.UOk x fr μ' act D Mc ∧
      Light.Filter2.GOk x fr μ' act Mc t) (Light.Filter2.QOf x.n) (Light.Filter2.supTo To x.n x.U + Light.Filter2.tAggr (x.n * x.n) (Light.Filter2.mOf x.n) + 27)
      ⟨hmem, hU, fun _ h => absurd h (Nat.not_lt_zero _)⟩ ?round ?done ?bound (by simp) (by simp)
      (by omega) (by simp only [Expr.cost]; ring_nf; omega)) (by omega)
  case bound =>
    intro j loc' μ' hj _
    simp only [refreshLocals, Light.Filter2.stepArgs]
    (( (try have := Light.Std.space_le (by assumption))
       (try have := Light.Std.const_le (by assumption))
       (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))
  case round =>
    intro t loc' μ' ht ⟨hm, hu, hg⟩
    simp only [refreshLocals]
    exact stepRound_spec hsol HP E (by omega) hM1 hM ht (loc' 19) hm hu hg
  case done =>
    intro loc' μ1 ⟨hm1, hu1, hg1⟩
    simp only [refreshLocals, Light.Filter2.stepArgs, setLocal]
    have hmb : ∀ (A : ℕ → Bool) (M' g : ℕ), g < x.n * x.n →
        Light.Filter2.mass x.n (Light.Filter2.sOf x.n) x.AB x.BC x.AC A M' g ≤ Light.Filter2.mOf x.n * Light.Filter2.sOf x.n :=
      fun A M' g hg => mass_le A M' hg
    -- the certificate
    have hcert := cert_meets (lim := lim) (d := d + 1) HP.cert (μ := μ1) (ua := Light.Filter2.aUA x.n fr)
      (gt := Light.Filter2.aGT x.n fr) (done := Light.Filter2.aDONE x.n fr) (N := x.n * x.n) (Q := Light.Filter2.QOf x.n) (h := Light.Filter2.hOf x.n x.U)
      (vmax := Light.Filter2.mOf x.n * Light.Filter2.sOf x.n) (D := D)
      (Uv := fun g => Light.Filter2.mass x.n (Light.Filter2.sOf x.n) x.AB x.BC x.AC act Mc g)
      (Gv := fun t g => Light.Filter2.mass x.n (Light.Filter2.sOf x.n) x.AB x.BC x.AC act (Mc * Light.Filter2.poolAt x.n t) g)
      hm1.done hu1 hg1 (fun g hg => hmb _ _ g hg) (fun t _ g hg => hmb _ _ g hg)
      (by omega) (by omega) (by omega) (by omega) (by omega) hw
      (le_trans (by exact_mod_cast w2) hword)
    (focus
       ((first
           | refine Light.Ends.seqSelf ?_
           | refine Light.Ends.skipLast ?_);
         (repeat
             with_unfolding_none
               first
               | refine Light.Ends.seqAssoc ?_
               | refine Light.Ends.skipThen ?_))
       (first
         | refine Light.Ends.callToThen (hcert _ (by omega)) ?_ ?_ ?_ ?_
         | refine Light.Ends.callToThen hcert ?_ ?_ ?_ ?_)
       (on_goal -1 =>
           first
           | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                   List.map_nil, List.sum_cons, List.sum_nil, ])
               (first
                 | omega
                 | ((ring_nf); (omega))))
           | omega
           |
             (simp [] <;>
                 first
                 | omega
                 | ((ring_nf); (omega))))
       (on_goal -1 => omega)
