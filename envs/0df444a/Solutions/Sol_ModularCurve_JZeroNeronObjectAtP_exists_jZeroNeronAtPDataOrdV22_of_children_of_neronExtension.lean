theorem castOver_mul {T X : Scheme.{0}} {R : Type} [CommRing R] {ι ι' : T ⟶ Spec (CommRingCat.of R)}
    {f : X ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f) (h : ι = ι') (x y : SchemeHomOver ι f) :
    castOver h (L.mul ι x y) = L.mul ι' (castOver h x) (castOver h y) := by
  subst h; rfl

