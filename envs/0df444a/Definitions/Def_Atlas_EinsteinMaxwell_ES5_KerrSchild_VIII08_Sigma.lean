/-! ## `B_s(0)` and the definition of `sigma_b` -/

/-- **The magnetic charge**: `sigma_b = -[∫₀^a Ac(t) s(t) dt]/(2 A0)`. -/
noncomputable def sigmaB (j : ℝ) (q : ℝ → ℝ) : ℝ :=
  -((∫ t in (0:ℝ)..aG, Ac t * sfun j q t) / (2 * A0))

