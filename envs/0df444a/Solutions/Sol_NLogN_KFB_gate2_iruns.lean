theorem qopW_fsp (s : IState HS) (w B1 G off : ℕ) (Ms : List M2G) (hM : ∀ M ∈ Ms, M.Ok)
    (f : Fin HS → List ℤ) (pre seg : List GI) (l : List ℤ) (hpre : pre.length = off)
