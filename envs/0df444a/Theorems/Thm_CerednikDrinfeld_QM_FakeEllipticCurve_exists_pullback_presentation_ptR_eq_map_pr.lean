        (P'' : u'.1.FullLevel n) (_ : (P''.P).1 ≫ gE = Spec.map (CommRingCat.ofHom (φ : S →+* S')) ≫ (P'.P).1)
        (_ : P''.P = pushPt (u'.1.act hmod) (u'.1.act_over hmod) u'.2.P),
