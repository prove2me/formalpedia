private theorem secondCountableTopology_completion (w : InfinitePlace ℚ) : SecondCountableTopology w.Completion := by
  obtain rfl : w = Rat.infinitePlace := Subsingleton.elim _ _
  exact (InfinitePlace.Completion.isometryEquivRealOfIsReal
    Rat.isReal_infinitePlace).toHomeomorph.isEmbedding.secondCountableTopology

private theorem secondCountableTopology_infiniteAdeleRing : SecondCountableTopology (InfiniteAdeleRing ℚ) := by
  haveI : ∀ w : InfinitePlace ℚ, SecondCountableTopology w.Completion := secondCountableTopology_completion
  exact inferInstanceAs (SecondCountableTopology ((w : InfinitePlace ℚ) → w.Completion))

private theorem t2Space_infiniteAdeleRing : T2Space (InfiniteAdeleRing ℚ) :=
  inferInstanceAs (T2Space ((w : InfinitePlace ℚ) → w.Completion))

private theorem secondCountableTopology_units_infiniteAdeleRing : SecondCountableTopology (InfiniteAdeleRing ℚ)ˣ := by
  haveI := secondCountableTopology_infiniteAdeleRing
  haveI := t2Space_infiniteAdeleRing
  haveI : SecondCountableTopology (InfiniteAdeleRing ℚ)ᵐᵒᵖ :=
    MulOpposite.opHomeomorph.symm.isEmbedding.secondCountableTopology
  exact Units.isClosedEmbedding_embedProduct.toIsEmbedding.secondCountableTopology

private theorem sigmaFinite_of_isHaarMeasure_units_infiniteAdeleRing [MeasurableSpace (InfiniteAdeleRing ℚ)ˣ]
    (ν : Measure (InfiniteAdeleRing ℚ)ˣ) [ν.IsHaarMeasure] : SigmaFinite ν := by
  haveI := secondCountableTopology_units_infiniteAdeleRing
  haveI := t2Space_infiniteAdeleRing
  infer_instance

end
