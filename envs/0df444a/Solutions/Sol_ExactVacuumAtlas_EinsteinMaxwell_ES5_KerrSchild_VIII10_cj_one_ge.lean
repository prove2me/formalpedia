open Set Filter Topology MeasureTheory intervalIntegral
open scoped ContDiff Interval Topology
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII10
set_option maxHeartbeats 1600000
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII05
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08R
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII09
theorem solution {R : ℝ} (hR : 3 < R) :
    5 / (3072 * R) ≤ cj 1 R := by
  have hq : ∀ x ∈ KG, sfun 0 (q3j 1) x ≤ sfun 0 (fun _ : ℝ => (-5 / 384 : ℝ)) x := by
    intro x hx
    have h := q3j_le (j := 1) (by norm_num) hx
    simp only [sfun]
    norm_num at h ⊢
    linarith
  have h := bfun_anti (j := (0:ℝ)) (j' := (0:ℝ)) (q := q3j 1)
    (q' := fun _ : ℝ => (-5 / 384 : ℝ)) (Aq := 1) (Aq' := 5 / 384)
    (q3j_contDiffOn 1) contDiffOn_const_neg
    (fun x hx => by
      simpa using abs_q3j_le (j := (1:ℝ)) (x := x) hx)
    (by norm_num) abs_const_neg_le (by norm_num) hq hR
  rwa [bfun_const_neg hR] at h
