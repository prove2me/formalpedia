section
-- Source module: Solutions.R6MTotal
/-!
# Round-six machine: the total cost of one context

* `cU6_mono`, `ZU6_le`: the unit `ZU6` is within `Kz6 · cU6 A` (`A ≥ 2`).
* **`total_le6`**: the setup (within `C_S · cU6 A_S`) plus `kMul6 + kFin6 + 2` of a context is at
  most `Ctot6 · cU6 A'` with `A' = A_Φ + A_L + A_C + A_S + 2`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open Finset IntMul NLogN NLogN.KIL KFB KFT KFU RS IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM

noncomputable section

theorem cU6_eq (Q : Q6) (A : ℕ) : cU6 Q.P Q.n A =
    (Q.T : ℝ) * Q.p * Ncost6 Q.P Q.n * (Real.log (IntMul.lg Q.n) + 1) ^ A := by
  unfold cU6 VP6; rfl

theorem cU6_mono (Q : Q6) (hP : Q.P.Ok) {A A' : ℕ} (h : A ≤ A') :
    cU6 Q.P Q.n A ≤ cU6 Q.P Q.n A' := by
  rw [cU6_eq, cU6_eq]
  have hL := lgn_ge Q.n
  have := pow_le_pow_right₀ hL h
  have h0 : 0 ≤ (Q.T : ℝ) * Q.p * Ncost6 Q.P Q.n := by
    have := Ncost6_ge_one Q.P hP Q.n; positivity
  exact mul_le_mul_of_nonneg_left this h0

theorem cU6_one (Q : Q6) (hP : Q.P.Ok) (hb : 1 ≤ Q.b) (A : ℕ) : 1 ≤ cU6 Q.P Q.n A := by
  rw [cU6_eq]
  have hL := one_le_pow₀ (n := A) (lgn_ge Q.n)
  have hN := Ncost6_ge_one Q.P hP Q.n
  have hT : (1 : ℝ) ≤ Q.T := by exact_mod_cast (Nat.one_le_two_pow : 1 ≤ 2 ^ Q.L)
  have hp : (1 : ℝ) ≤ Q.p := by exact_mod_cast (show 1 ≤ Q.p by rw [Q.p_eq]; omega)
  have a1 : (1 : ℝ) ≤ (Q.T : ℝ) * Q.p := one_le_mul_of_one_le_of_one_le hT hp
  have a2 : (1 : ℝ) ≤ (Q.T : ℝ) * Q.p * Ncost6 Q.P Q.n := one_le_mul_of_one_le_of_one_le a1 hN
  exact one_le_mul_of_one_le_of_one_le a2 hL

theorem Kz6_pos (P : Prm) : 0 ≤ Kz6 P := by unfold Kz6; positivity

set_option maxRecDepth 100000 in
set_option maxHeartbeats 8000000 in
/-- **The total cost of one context.** -/
theorem total_le6_sol_aux {E : ℕ} {ix : Ix6 (7 + E)} {Isym : List Sym} {tab : Fin 1 → IStmt HS 1}
    {extM : Fin E → IStmt HS (7 + E)} {Q : Q6} {D : ℕ} [∀ i, NeZero (Q.sB D i)]
    [∀ i, NeZero (Q.tB D i)] (C : BigCtx6 ix Isym tab extM Q D) (hP : Q.P.Ok)
    {CΦ CL CC CS : ℝ} (h1 : 0 ≤ CΦ) (h2 : 0 ≤ CL) (h3 : 0 ≤ CC) (h4 : 0 ≤ CS)
    (AΦ AL AC AS : ℕ)
    (e1 : C.CΦ = CΦ) (e2 : C.AΦ = AΦ) (e3 : C.BΦ = dzB Q.dPh) (e4 : C.CL = CL) (e5 : C.AL = AL)
    (e6 : C.BL = dzB Q.dLn) (e7 : C.CC = CC) (e8 : C.AC = AC) (e9 : C.BC = dzB Q.dCh)
    (c0 : ℕ) (hc0 : (c0 : ℝ) ≤ CS * cU6 Q.P Q.n AS) :
    (c0 : ℝ) + kMul6 C + kFin6 C + 2 ≤
      Ctot6 Q.P CΦ CL CC CS * cU6 Q.P Q.n (AΦ + AL + AC + AS + 2) := by
  have hQ := C.hQ
  have hD := C.hD
  set A' := AΦ + AL + AC + AS + 2 with hA'
  set U := cU6 Q.P Q.n A' with hU
  have hZ : (ZU6 Q : ℝ) ≤ Kz6 Q.P * U := by
    have := ZU6_le hQ hP (AΦ + AL + AC + AS); rw [hU, hA']; exact this
  have hU1 : 1 ≤ U := cU6_one Q hP (by have := hQ.hb; omega) A'
  have mΦ : cU6 Q.P Q.n AΦ ≤ U := cU6_mono Q hP (by omega)
  have mL : cU6 Q.P Q.n AL ≤ U := cU6_mono Q hP (by omega)
  have mC : cU6 Q.P Q.n AC ≤ U := cU6_mono Q hP (by omega)
  have mS : cU6 Q.P Q.n AS ≤ U := cU6_mono Q hP (by omega)
  have hKz := Kz6_pos Q.P
  have hb := hQ.hb
  have hp1 : 1 ≤ Q.p := by rw [Q.p_eq]; omega
  have hT1 : 1 ≤ Q.T := Nat.one_le_two_pow
  set Z := ZU6 Q with hZd
  have z1 : Q.T * (Q.p + 1) ≤ Z := by
    unfold Z ZU6
    have := Nat.mul_le_mul_left Q.T (Nat.le_add_right (Q.p + 1) (KFM.fmB (8 * Q.p)))
    omega
  have z2 : Q.T * (Q.p + 1 + KFM.fmB (8 * Q.p)) ≤ Z := by unfold Z ZU6; omega
  have z3 : (Q.b + 1) ^ 6 ≤ Z := by unfold Z ZU6; omega
  have z4 : Q.n ≤ Z := by unfold Z ZU6; omega
  have z5 : Q.p + 1 ≤ Z := by
    have : Q.p + 1 ≤ Q.T * (Q.p + 1) := Nat.le_mul_of_pos_left _ (by omega)
    omega
  have hb2 : (Q.b + 1) ^ 2 ≤ (Q.b + 1) ^ 6 := Nat.pow_le_pow_right (by omega) (by norm_num)
  -- the calls
  have dΦ := dzB_le_of6 (desc_phi6 hQ hD)
  have dL := dzB_le_of6 (desc_line6 hQ hD)
  have dC := dzB_le_of6 (desc_chirp6 hQ hD)
  have kΦ := kCall_le6 hQ hD (k := 3) (c := 3) (Bd := C.BΦ) (by norm_num) (by norm_num)
    (by rw [e3]; exact dΦ) C.CΦ C.AΦ
  have kL := kCall_le6 hQ hD (k := 2) (c := 4) (Bd := C.BL) (by norm_num) (by norm_num)
    (by rw [e6]; exact dL) C.CL C.AL
  have kC := kCall_le6 hQ hD (k := 2) (c := 5) (Bd := C.BC) (by norm_num) (by norm_num)
    (by rw [e9]; exact dC) C.CC C.AC
  rw [e1, e2] at kΦ
  rw [e4, e5] at kL
  rw [e7, e8] at kC
  have zc : ((10 ^ 7 * (Q.b + 1) ^ 2 : ℕ) : ℝ) ≤ 10 ^ 7 * (Z : ℝ) := by
    have : 10 ^ 7 * (Q.b + 1) ^ 2 ≤ 10 ^ 7 * Z := Nat.mul_le_mul_left _ (hb2.trans z3)
    exact_mod_cast this
  have uΦ : CΦ * cU6 Q.P Q.n AΦ ≤ CΦ * U := mul_le_mul_of_nonneg_left mΦ h1
  have uL : CL * cU6 Q.P Q.n AL ≤ CL * U := mul_le_mul_of_nonneg_left mL h2
  have uC : CC * cU6 Q.P Q.n AC ≤ CC * U := mul_le_mul_of_nonneg_left mC h3
  have uS : CS * cU6 Q.P Q.n AS ≤ CS * U := mul_le_mul_of_nonneg_left mS h4
  -- the passes
  have pSh := kShl_le6 hQ hD
  have pGm := kGm_le6 hQ hD
  have pCj := kCj_le6 hQ hD (B := Q.p + 1) (by omega)
  have pFA := kFinA_le6 hQ hD
  have pCa := cCarU_le6 hQ hD
  have pDg := kDig_le6 hQ hD
  have pMv : 2 * cMvN (2 ^ (Q.L + 1)) (wU6 Q D) ≤ 10 ^ 6 * Z := by
    have := cMvN_le' (2 ^ (Q.L + 1)) (wU6 Q D)
    rw [eT2_6 hQ hD] at this ⊢
    have hW := wU_le6 hQ hD
    have : (2 * Q.T + 1) * (wU6 Q D + 2) ≤ 9 * (Q.T * (Q.p + 1)) := by
      have := Nat.mul_le_mul (show 2 * Q.T + 1 ≤ 3 * Q.T by omega)
        (show wU6 Q D + 2 ≤ 3 * (Q.p + 1) by omega)
      nlinarith
    nlinarith
  have pmv : 2 * moveCost (Q.n + 1) + 19 ≤ 200 * Z := by simp only [moveCost]; omega
  have pw : cW (Q.S : ℤ) + cW (2 ^ Q.b) + outRCost (2 * Q.n) ≤ 10 ^ 4 * Z := by
    have := cW_nat Q.S; have := cW_pow Q.b; have := KFT.outRCost_le (2 * Q.n)
    have : Q.S ≤ Q.T := hQ.S_le_T hD
    have : Q.b + 2 ≤ Z := by rw [Q.p_eq] at z5; omega
    have : Q.T ≤ Q.T * (Q.p + 1) := Nat.le_mul_of_pos_right _ (by omega)
    omega
  have cast1 : ((kShl6 Q D : ℕ) : ℝ) ≤ 10 ^ 7 * (Z : ℝ) := by
    have : kShl6 Q D ≤ 10 ^ 7 * Z := by omega
    exact_mod_cast this
  have cast2 : ((kGm6 Q D : ℕ) : ℝ) ≤ 10 ^ 9 * (Z : ℝ) := by
    have : kGm6 Q D ≤ 10 ^ 9 * Z := by omega
    exact_mod_cast this
  have cast3 : ((kCj6 Q (Q.p + 1) : ℕ) : ℝ) ≤ 10 ^ 7 * (Z : ℝ) := by
    have : kCj6 Q (Q.p + 1) ≤ 10 ^ 7 * Z := by omega
    exact_mod_cast this
  have cast4 : ((kFinA6 Q D : ℕ) : ℝ) ≤ 10 ^ 10 * (Z : ℝ) := by
    have : kFinA6 Q D ≤ 10 ^ 10 * Z := by omega
    exact_mod_cast this
  have cast5 : (((cCarU Q.b (Q.p + 2) Q.S + cW (Q.S : ℤ) + cW (2 ^ Q.b) +
      outRCost (2 * Q.n) : ℕ)) : ℝ) ≤ 10 ^ 8 * (Z : ℝ) := by
    have : cCarU Q.b (Q.p + 2) Q.S + cW (Q.S : ℤ) + cW (2 ^ Q.b) + outRCost (2 * Q.n) ≤
        10 ^ 8 * Z := by omega
    exact_mod_cast this
  have cast6 : (((2 * moveCost (Q.n + 1) + 19 + kDig6 Q : ℕ)) : ℝ) ≤ 2 * 10 ^ 8 * (Z : ℝ) := by
    have : 2 * moveCost (Q.n + 1) + 19 + kDig6 Q ≤ 2 * 10 ^ 8 * Z := by omega
    exact_mod_cast this
  have cast7 : (((2 * cMvN (2 ^ (Q.L + 1)) (wU6 Q D) : ℕ)) : ℝ) ≤ 10 ^ 6 * (Z : ℝ) := by
    exact_mod_cast pMv
  unfold kMul6 kFin6 kIn6 kFt6
  rw [e1, e2, e3, e4, e5, e6, e7, e8, e9] at *
  have hZK : (Z : ℝ) ≤ Kz6 Q.P * U := hZ
  unfold Ctot6
  have : (10 ^ 11 * Kz6 Q.P + 3 * CΦ + 6 * CL + 3 * CC + CS + 2) * U =
      10 ^ 11 * (Kz6 Q.P * U) + 3 * (CΦ * U) + 6 * (CL * U) + 3 * (CC * U) + CS * U + 2 * U := by
    ring
  rw [this]
  linarith

end

