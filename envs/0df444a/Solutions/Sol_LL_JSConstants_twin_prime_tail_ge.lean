    rw [Finset.sum_Ico_succ_top hk, ih, Nat.cast_add, Nat.cast_one]
    ring

lemma finite_prime_sum_le (S : Finset ℕ) (hS : ∀ n ∈ S, n.Prime ∧ 51 ≤ n) :
    (∑ n ∈ S, termReal n) ≤ (39638 : ℝ) / 10000000 := by
  rw [← Finset.sum_filter_add_sum_filter_not S (fun n => n < 64680) termReal]
  set S_head := S.filter (fun n => n < 64680)
  set S_tail := S.filter (fun n => ¬ n < 64680)
  -- 1. Head bound
  have hhead_pt : ∀ n ∈ S_head, termReal n ≤ (termUb n : ℝ) / 10000000000000 := by
    intro n hn
    exact termReal_le_termUb (hS n (Finset.mem_of_mem_filter n hn)).2
  have hhead_nat : (∑ n ∈ S_head, termUb n) ≤ 39602850000 := by
    set allM := masks0 ++ (masks1 ++ (masks2 ++ masks3))
    have hall_len : allM.length = 308 := by
      simp [allM, List.length_append, masks0_len, masks1_len, masks2_len, masks3_len]
    have hall_eq : sumAllBlocks 0 allM = totalHeadBlocks := by
      dsimp [allM, totalHeadBlocks]
      rw [sumAllBlocks_append, masks0_len, zero_add,
        sumAllBlocks_append, masks1_len,
        sumAllBlocks_append, masks2_len]
      change sumAllBlocks 0 masks0 +
          (sumAllBlocks 77 masks1 +
            (sumAllBlocks (77 + 77) masks2 + sumAllBlocks (77 + 77 + 77) masks3)) =
        (sumAllBlocks 0 masks0 + sumAllBlocks 77 masks1) +
          (sumAllBlocks 154 masks2 + sumAllBlocks 231 masks3)
      norm_num
      omega
    refine le_trans (sumAllBlocks_ge allM 0 S_head ?_) (by rw [hall_eq]; exact head_blocks_le)
    intro n hn
    rcases Finset.mem_filter.mp hn with ⟨hnS, hlt⟩
    rcases hS n hnS with ⟨hp, h51⟩
    refine ⟨hp, h51, Nat.zero_le _, ?_⟩
    rw [hall_len]
    omega
  have hhead_real : (∑ n ∈ S_head, termReal n) ≤ (39602850000 : ℝ) / 10000000000000 := by
    calc
      (∑ n ∈ S_head, termReal n) ≤ ∑ n ∈ S_head, ((termUb n : ℝ) / 10000000000000) :=
        Finset.sum_le_sum hhead_pt
      _ = ((∑ n ∈ S_head, termUb n : ℕ) : ℝ) / 10000000000000 := by
        rw [← Finset.sum_div, Nat.cast_sum]
      _ ≤ (39602850000 : ℝ) / 10000000000000 := by
        gcongr
        exact_mod_cast hhead_nat
  -- 2. Tail bound
  set KTop : ℕ := max 28 (S_tail.sup (fun n => n / 2310) + 1)
  have hKTop28 : 28 ≤ KTop := le_max_left _ _
  set R2310 : Finset ℕ := (Finset.range 2310).filter (fun r => Nat.Coprime r 2310)
  set Grid : Finset (ℕ × ℕ) := Finset.Ico 28 KTop ×ˢ R2310
  let gFun : ℕ × ℕ → ℝ := fun p =>
