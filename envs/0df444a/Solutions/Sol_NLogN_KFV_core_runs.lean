theorem norm_ppq_le {r p : ℕ} (hr : 0 < r) {u v : Fin r → ℂ} (hu : ‖u‖ ≤ 1) (hv : ‖v‖ ≤ 1) :
    ‖ppq r p u v‖ ≤ 1 := by
  refine (pi_norm_le_iff_of_nonneg zero_le_one).2 fun j => ?_
  refine le_trans (Butterfly.norm_Qp_le p _) ?_
  have hr' : (0 : ℝ) < r := by exact_mod_cast hr
  have hs : ‖ncv u v j‖ ≤ r := by
    unfold ncv
    refine le_trans (norm_sum_le _ _) ?_
    have : ∀ i ∈ (Finset.univ : Finset (Fin r)), ‖u i * (if h : (i : ℕ) ≤ j then v ⟨j - i, by omega⟩
        else -v ⟨j + r - i, by have := j.isLt; omega⟩)‖ ≤ 1 := by
      intro i _
      rw [norm_mul]
      have h1 : ‖u i‖ ≤ 1 := le_trans (norm_le_pi_norm u i) hu
      have h2 : ‖(if h : (i : ℕ) ≤ j then v ⟨j - i, by omega⟩
          else -v ⟨j + r - i, by have := j.isLt; omega⟩)‖ ≤ 1 := by
        split_ifs
        · exact le_trans (norm_le_pi_norm v _) hv
        · rw [norm_neg]; exact le_trans (norm_le_pi_norm v _) hv
      calc ‖u i‖ * _ ≤ 1 * 1 := mul_le_mul h1 h2 (norm_nonneg _) zero_le_one
        _ = 1 := one_mul 1
    refine le_trans (Finset.sum_le_sum this) ?_
    simp
  rw [norm_mul, norm_inv, Complex.norm_natCast]
  rw [inv_mul_le_iff₀ hr']; linarith

theorem disk_zipWith_ppq {r p : ℕ} (hr : 0 < r) {xf xg : List (Fin r → ℂ)} (hf : Disk xf)
    (hg : Disk xg) : Disk (List.zipWith (ppq r p) xf xg) := by
  intro j hj
  rw [List.getElem_zipWith]
  have h1 : j < xf.length := by simp at hj; omega
  have h2 : j < xg.length := by simp at hj; omega
  exact norm_ppq_le hr (hf j h1) (hg j h2)

