-- title:
--   Transcendence degree and minimality over a generic fibre point
-- statement:
--   Let $R$, $A$, $A'$ be commutative rings in a common universe, with $A$ and $A'$ algebras over $R$ and $A'$ of finite type over $R$, and let $\mathfrak P$ be a prime ideal of $A \otimes_R A'$. Write $\mathfrak p = \mathfrak P \cap A$ for the contraction of $\mathfrak P$ along $\mathrm{algebraMap}\ A\ (A \otimes_R A')$, $\mathfrak p' = \mathfrak P \cap A'$ for its contraction along the ring homomorphism underlying `Algebra.TensorProduct.includeRight`, $\mathfrak n_0 = \mathfrak P \cap R$ and $\mathfrak n = \mathfrak p' \cap R$. The hypothesis is that $\mathfrak p'$ is a minimal prime of the ideal of $A'$ generated by the image of $\mathfrak n_0$ under $\mathrm{algebraMap}\ R\ A'$. The conclusion is a conjunction: first, the transcendence degree of $(A \otimes_R A')/\mathfrak P$ over $A/\mathfrak p$ is at most the transcendence degree of $A'/\mathfrak p'$ over $R/\mathfrak n$; second, $\mathfrak P$ is a minimal prime of the ideal of $A \otimes_R A'$ generated by the image of $\mathfrak p$ if and only if those two transcendence degrees are equal.
--
--   This is the algebraic form of the statement that, over a generic point of a fibre of $\operatorname{Spec} A' \to \operatorname{Spec} R$, the points of the fibre of $\operatorname{Spec}(A \otimes_R A') \to \operatorname{Spec} A$ of maximal residue transcendence degree are exactly its generic points (EGA IV, 4.2.1). It is used in the Néron model infrastructure, in [`NeronModelInfra.exists_mem_opens_forall_dense_preimage_fst_of_forall_maximal_mem`](thm.html#NeronModelInfra.exists_mem_opens_forall_dense_preimage_fst_of_forall_maximal_mem), to control density of preimages under the first projection.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_Algebra_TensorProduct_trdeg_quotient_le_and_mem_minimalPrimes_iff_of_mem_minimalPrimes.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open TensorProduct

universe u

theorem Algebra.TensorProduct.trdeg_quotient_le_and_mem_minimalPrimes_iff_of_mem_minimalPrimes
    {R A A' : Type u} [CommRing R] [CommRing A] [CommRing A'] [Algebra R A] [Algebra R A']
    [Algebra.FiniteType R A']
    (𝔓 : Ideal (A ⊗[R] A')) [𝔓.IsPrime]
    (h : 𝔓.comap (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := A')).toRingHom ∈
      ((𝔓.under R).map (algebraMap R A')).minimalPrimes) :
    Algebra.trdeg (A ⧸ 𝔓.under A) ((A ⊗[R] A') ⧸ 𝔓) ≤
        Algebra.trdeg
          (R ⧸ (𝔓.comap (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := A')).toRingHom).under R)
          (A' ⧸ 𝔓.comap (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := A')).toRingHom) ∧
      (𝔓 ∈ ((𝔓.under A).map (algebraMap A (A ⊗[R] A'))).minimalPrimes ↔
        Algebra.trdeg (A ⧸ 𝔓.under A) ((A ⊗[R] A') ⧸ 𝔓) =
          Algebra.trdeg
            (R ⧸ (𝔓.comap (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := A')).toRingHom).under R)
            (A' ⧸ 𝔓.comap (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := A')).toRingHom)) := by sorry
