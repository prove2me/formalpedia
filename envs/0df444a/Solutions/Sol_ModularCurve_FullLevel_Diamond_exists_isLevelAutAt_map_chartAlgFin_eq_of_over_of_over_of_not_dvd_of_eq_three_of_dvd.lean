universe u

theorem inv_one {R : Type u} [CommRing R] {X : Scheme.{u}} {f : X ⟶ Spec (CommRingCat.of R)}
    (G : RelativeGroupLaw R f) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    G.inv t (G.one t) = G.one t := by
  have h := G.inv_mul_cancel t (G.one t)
  rw [G.mul_one] at h
  exact h

theorem zsmulSection_one {T : Type u} [CommRing T] {W : WeierstrassCurve.Projective T}
    (G : RelativeGroupLaw T (projModelStrCR W)) (n : ℤ) :
    ModularCurve.LevelRelabelling.zsmulSection G n (G.one (𝟙 _)) = G.one (𝟙 _) := by
  cases n with
  | ofNat k =>
    show G.nsmul _ k (G.one _) = G.one _
    exact G.nsmul_unit _ k
  | negSucc k =>
    show G.inv _ (G.nsmul _ (k + 1) (G.one _)) = G.one _
    rw [G.nsmul_unit]
    exact inv_one G _

theorem zlinComb_one_one {T : Type u} [CommRing T] {W : WeierstrassCurve.Projective T}
    (G : RelativeGroupLaw T (projModelStrCR W)) (a b : ℤ) :
    ModularCurve.LevelRelabelling.zlinComb G (G.one (𝟙 _)) (G.one (𝟙 _)) a b = G.one (𝟙 _) := by
  unfold ModularCurve.LevelRelabelling.zlinComb
  rw [zsmulSection_one, zsmulSection_one, G.mul_one]

theorem relabel_eq_of_eq_one {A : Type u} [CommRing A] {T : Type u} [CommRing T] [Algebra A T]
    (𝒢 : GroupLaws A) (g : Matrix (Fin 2) (Fin 2) ℤ) (x : RawDrinfeldPair T) (hΔ : IsUnit x.curve.Δ)
    (hP : x.P = (𝒢 T x.curve hΔ).one (𝟙 _)) (hQ : x.Q = (𝒢 T x.curve hΔ).one (𝟙 _)) :
    ModularCurve.LevelRelabelling.RawDrinfeldPair.relabel 𝒢 g x hΔ = x := by
  obtain ⟨c, P, Q⟩ := x
  simp only [ModularCurve.LevelRelabelling.RawDrinfeldPair.relabel]
  simp only at hP hQ
  rw [hP, hQ, zlinComb_one_one, zlinComb_one_one]

theorem eq_of_eq_one {A : Type u} [CommRing A] {T : Type u} [CommRing T] [Algebra A T]
    (𝒢 : GroupLaws A) (x x' : RawDrinfeldPair T) (hΔ : IsUnit x.curve.Δ) (hΔ' : IsUnit x'.curve.Δ)
    (hc : x'.curve = x.curve)
    (hP : x.P = (𝒢 T x.curve hΔ).one (𝟙 _)) (hQ : x.Q = (𝒢 T x.curve hΔ).one (𝟙 _))
    (hP' : x'.P = (𝒢 T x'.curve hΔ').one (𝟙 _)) (hQ' : x'.Q = (𝒢 T x'.curve hΔ').one (𝟙 _)) :
    x' = x := by
  obtain ⟨c, P, Q⟩ := x
  obtain ⟨c', P', Q'⟩ := x'
  simp only at hc
  subst hc
  simp only at hP hQ hP' hQ'
  rw [hP, hQ, hP', hQ']

theorem isGamma1Point_variableChange {A : Type u} [CommRing A] {W : WeierstrassCurve A} {ℓ : ℕ}
    {D : ModularCurve.LevelPData A} (h : ModularCurve.IsGamma1Point W ℓ D) (C : WeierstrassCurve.VariableChange A) :
    ModularCurve.IsGamma1Point (C • W) ℓ (D.variableChange C) where
  equation_P := ModularCurve.IsLevelPStructure.equation_variableChange_aux C h.equation_P
  preΨ_P := by
    rw [ModularCurve.LevelPData.variableChange_xP, WeierstrassCurve.eval_prePsi_variableChange, h.preΨ_P, mul_zero]
  xQ_eq := by rw [ModularCurve.LevelPData.variableChange_xQ, ModularCurve.LevelPData.variableChange_xP, h.xQ_eq]
  yQ_eq := by rw [ModularCurve.LevelPData.variableChange_yQ, ModularCurve.LevelPData.variableChange_yP, h.xQ_eq, h.yQ_eq]

theorem baseChange_self {F : Type u} [Field F] (W : WeierstrassCurve F) : W.baseChange F = W := by
  show W.map (algebraMap F F) = W
  rw [Algebra.algebraMap_self, WeierstrassCurve.map_id]

end OrbitH1

theorem solution
    (q : ℕ) [Fact q.Prime] (hq3 : q = 3) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (ℓg : ℕ) (hℓg : ℓg.Prime) (hℓg12 : ℓg % 12 = 11) (hℓgM' : ℓg ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' (ResidueField A))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (s : ↥W)

    (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ)) (π₀ : ↥k₀) (hπ : (π₀ : (AlgebraicClosure ℚ)) ∈ A)
    (hdvr : IsDiscreteValuationRing ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))))
    (hunif : maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) =
      Ideal.span {(⟨π₀, hπ⟩ : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))))})
    (hhens : HenselianLocalRing ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))))
    (hres : IsAlgClosed (ResidueField ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))))
    (hκ : ∀ a : (AlgebraicClosure ℚ), a ∈ A → ∃ c : ↥k₀, (c : (AlgebraicClosure ℚ)) ∈ A ∧ ∃ h : a - c ∈ A, (⟨_, h⟩ : A) ∈ maximalIdeal A)

    (ξ : ↥k₀) (hξ : IsPrimitiveRoot ξ q)
    (hιξ : ∃ ι : ↥k₀ →+* ℂ, ι ξ = Complex.exp (2 * Real.pi * Complex.I / q))
    (H₁ : Subgroup (ZMod (q ^ 2 * M'))ˣ)
    (hH₁ : H₁ = ModularCurve.FullLevel.levelH q M' ⊓ (ZMod.unitsMap (Dvd.dvd.mul_left hℓgM' (q ^ 2))).ker)
    (K : IntermediateField ↥k₀ (LaurentSeries ↥k₀))
    (hK : K = ModularCurve.laurentBaseChange ↥k₀
      (ModularCurve.xHFunctionField (q ^ 2 * M') H₁))
    [Algebra ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ↥K] [IsScalarTower ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ↥k₀ ↥K]
    (j : ↥K) (hj : ((j : LaurentSeries ↥k₀)) = ModularCurve.coeffEmb ↥k₀ ModularCurve.jq) [Fact (j ≠ 0)]

    (y y' : Ideal ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j)) (hy : y.IsMaximal) (hy' : y'.IsMaximal)
    (hπy : algebraMap ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j) ⟨π₀, hπ⟩ ∈ y) (hπy' : algebraMap ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j) ⟨π₀, hπ⟩ ∈ y')
    (hover : (∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
          (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
          (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
            0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
              coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
              ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
            0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
              ↥(modularFunctionFieldBar M'))) →
          (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ∈
              (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
          ∀ (hgK : (coeffEmb ↥k₀ g) ∈ K)
            (hgC : (⟨_, hgK⟩ : ↥K) ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j),
          ∀ (c : ↥k₀) (hc : (c : (AlgebraicClosure ℚ)) ∈ A),
            residue A ⟨(c : (AlgebraicClosure ℚ)), hc⟩ =
              (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩) →
            (⟨⟨_, hgK⟩, hgC⟩ : ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j)) - algebraMap ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j) ⟨c, hc⟩ ∈ y))
    (hover' : (∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
          (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
          (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
            0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
              coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
              ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
            0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
              ↥(modularFunctionFieldBar M'))) →
          (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ∈
              (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
          ∀ (hgK : (coeffEmb ↥k₀ g) ∈ K)
            (hgC : (⟨_, hgK⟩ : ↥K) ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j),
          ∀ (c : ↥k₀) (hc : (c : (AlgebraicClosure ℚ)) ∈ A),
            residue A ⟨(c : (AlgebraicClosure ℚ)), hc⟩ =
              (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩) →
            (⟨⟨_, hgK⟩, hgC⟩ : ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j)) - algebraMap ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j) ⟨c, hc⟩ ∈ y')) :
    ∃ (γ : SL(2, ℤ)) (_ : γ ∈ CongruenceSubgroup.Gamma q) (_ : γ ∈ CongruenceSubgroup.Gamma0 M')
      (τ : ↥K ≃ₐ[↥k₀] ↥K),
      ModularCurve.FullLevel.IsLevelAutAt ↥k₀ q ξ q (q ^ 2 * M') H₁ γ⁻¹ K τ ∧
      (∀ f : ↥K, f ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j →
        τ f ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j) ∧
      (∀ (f : ↥K) (hf : f ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j)
        (hf' : τ f ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j),
        (⟨f, hf⟩ : ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j)) ∈ y ↔ (⟨τ f, hf'⟩ : ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j)) ∈ y') := by
  classical
  have hqp : q.Prime := Fact.out
  haveI hqne : NeZero q := ⟨hqp.ne_zero⟩

  haveI hresI : IsAlgClosed (ResidueField ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) := hres
  have hℓgpf : ℓg ∈ M'.primeFactors := Nat.mem_primeFactors.mpr ⟨hℓg, hℓgM', NeZero.ne M'⟩
  have hℓodd : Odd ℓg := by
    rw [Nat.odd_iff]; omega
  haveI : Fact ℓg.Prime := ⟨hℓg⟩

  obtain ⟨𝒢, 𝒯, h𝒢, h𝒢O, h𝒯, hVC, hCO⟩ :=
    WeierstrassCurve.DrinfeldGlobal.exists_groupLaws_levelTransport_isChordTangent_isOriginIdentity_isSectionTransport ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) q
  have hℓT : ∀ (T : Type) [CommRing T] [Algebra ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (D : ModularCurve.LevelPData T), ModularCurve.IsGamma1Point W ℓg D →
        ModularCurve.IsGamma1Point (C • W) ℓg (D.variableChange C) :=
    fun T _ _ W C D h => OrbitH1.isGamma1Point_variableChange h C
  have hMT : ∀ (T : Type) [CommRing T] [Algebra ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (p k : ℕ) (h : Polynomial T), ModularCurve.IsGamma0PowAt W p k h →
        ModularCurve.IsGamma0PowAt (C • W) p k (ModularCurve.kernelVariableChangeDeg C (ModularCurve.gamma0PowDeg p k) h) :=
    fun T _ _ W C p k h hh => ModularCurve.IsGamma0PowAt.variableChange W C p k h hh
  obtain ⟨Φ, -, hO, hI, hIII, hIV⟩ :=
    ModularCurve.FullLevel.Diamond.exists_ssFibreDictionary_chartAlgFin_rigidDataGamma1Pow q M' hqM' ℓg hℓg hℓg12 hℓgM' hℓgpf
      A hA W hW hle R₀ hR₀ s k₀ π₀ hπ hdvr hunif hhens hres hκ ξ hξ hιξ H₁ hH₁ K hK j hj hℓT hMT 𝒢 h𝒢 h𝒢O 𝒯 h𝒯 hVC hCO

  obtain ⟨C₀, hcurve, htuple, hline⟩ := hI ⟨y, hy, hπy⟩ ⟨y', hy', hπy'⟩ hover hover'
  obtain ⟨hx0, hxP, hxD⟩ := ((WeierstrassCurve.DrinfeldGlobal.rigidDataGamma1Pow ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ℓg M' q hℓT hMT 𝒢 𝒯).act C₀ (Φ ⟨y, hy, hπy⟩)).isLevel
  obtain ⟨hx0', hxP', hxD'⟩ := (Φ ⟨y', hy', hπy'⟩).isLevel

  haveI instE : ((Φ ⟨y', hy', hπy'⟩).curve).IsElliptic := ⟨(Φ ⟨y', hy', hπy'⟩).isUnit_Δ⟩

  have hxP1 : ModularCurve.IsGamma1Point (Φ ⟨y', hy', hπy'⟩).curve ℓg ((WeierstrassCurve.DrinfeldGlobal.rigidDataGamma1Pow ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ℓg M' q hℓT hMT 𝒢 𝒯).act C₀ (Φ ⟨y, hy, hπy⟩)).level.2.1 :=
    hcurve ▸ hxP
  have hns' : ((Φ ⟨y', hy', hπy'⟩).curve).toAffine.Nonsingular (Φ ⟨y', hy', hπy'⟩).level.2.1.xP (Φ ⟨y', hy', hπy'⟩).level.2.1.yP :=
    (WeierstrassCurve.Affine.equation_iff_nonsingular).mp hxP'.equation_P
  have hns1 : ((Φ ⟨y', hy', hπy'⟩).curve).toAffine.Nonsingular ((WeierstrassCurve.DrinfeldGlobal.rigidDataGamma1Pow ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ℓg M' q hℓT hMT 𝒢 𝒯).act C₀ (Φ ⟨y, hy, hπy⟩)).level.2.1.xP
      ((WeierstrassCurve.DrinfeldGlobal.rigidDataGamma1Pow ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ℓg M' q hℓT hMT 𝒢 𝒯).act C₀ (Φ ⟨y, hy, hπy⟩)).level.2.1.yP :=
    (WeierstrassCurve.Affine.equation_iff_nonsingular).mp hxP1.equation_P
  set P' : ((Φ ⟨y', hy', hπy'⟩).curve).toAffine.Point := WeierstrassCurve.Affine.Point.some _ _ hns' with hP'def
  set P₁ : ((Φ ⟨y', hy', hπy'⟩).curve).toAffine.Point := WeierstrassCurve.Affine.Point.some _ _ hns1 with hP1def

  have hmem : P₁ ∈ AddSubgroup.zmultiples P' :=
    ModularCurve.InLine.some_mem_zmultiples_some_of_nonsingular _ ℓg hns' hns1 hline
  have hordP : ∀ {u v : ResidueField ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))} (hns : ((Φ ⟨y', hy', hπy'⟩).curve).toAffine.Nonsingular u v),
      ((Φ ⟨y', hy', hπy'⟩).curve.preΨ ℓg).eval u = 0 → addOrderOf (WeierstrassCurve.Affine.Point.some u v hns) = ℓg := by
    intro u v hns hΨ
    refine (addOrderOf_eq_prime_iff).mpr ⟨?_, WeierstrassCurve.Affine.Point.some_ne_zero hns⟩
    rw [WeierstrassCurve.Affine.Point.nsmul_some_eq_zero_iff_eval_prePsi _ hℓodd hns, ← WeierstrassCurve.preΨ_ofNat]
    exact hΨ
  have hoP' : addOrderOf P' = ℓg := hordP hns' hxP'.preΨ_P
  have hoP1 : addOrderOf P₁ = ℓg := hordP hns1 hxP1.preΨ_P
  haveI : NeZero ℓg := ⟨hℓg.ne_zero⟩
  obtain ⟨d, hd⟩ := AddSubgroup.exists_units_zmod_val_smul_eq_of_addOrderOf_eq_of_mem_zmultiples ℓg P' P₁ hoP' hoP1 hmem

  have hd' : P' = ((d⁻¹ : (ZMod ℓg)ˣ) : ZMod ℓg).val • P₁ := by
    have hmod : ((d⁻¹ : (ZMod ℓg)ˣ) : ZMod ℓg).val * (d : ZMod ℓg).val % ℓg = 1 % ℓg := by
      rw [← ZMod.val_mul, Units.inv_mul, ← Nat.cast_one, ZMod.val_natCast]
    rw [hd, smul_smul]
    calc P' = (1 % addOrderOf P') • P' := by rw [mod_addOrderOf_nsmul, one_smul]
      _ = ((((d⁻¹ : (ZMod ℓg)ˣ) : ZMod ℓg).val * (d : ZMod ℓg).val) % addOrderOf P') • P' := by rw [hoP', hmod]
      _ = (((d⁻¹ : (ZMod ℓg)ˣ) : ZMod ℓg).val * (d : ZMod ℓg).val) • P' := mod_addOrderOf_nsmul _ _

  obtain ⟨γ, hγq, hγ0, hγd⟩ :=
    CongruenceSubgroup.exists_mem_Gamma_mem_Gamma0_intCast_apply_eq_of_coprime_of_dvd q M'
      ((Nat.Prime.coprime_iff_not_dvd hqp).mpr hqM') ℓg hℓgM' (d⁻¹)

  have hγP : ((((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 1 1) : ℤ) • P₁ = P' := by
    have hℓP1 : ((ℓg : ℕ) : ℤ) • P₁ = 0 := by
      have h := addOrderOf_nsmul_eq_zero P₁
      rw [hoP1] at h
      rw [natCast_zsmul]; exact h
    have hcast : (((((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 1 1) : ℤ) : ZMod ℓg) =
        (((((d⁻¹ : (ZMod ℓg)ˣ) : ZMod ℓg).val : ℕ) : ℤ) : ZMod ℓg) := by
      rw [hγd, Int.cast_natCast, ZMod.natCast_zmod_val]
    obtain ⟨c, hc⟩ := (ZMod.intCast_eq_intCast_iff_dvd_sub _ _ ℓg).mp hcast
    have e : ((((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 1 1) : ℤ) =
        (((((d⁻¹ : (ZMod ℓg)ˣ) : ZMod ℓg).val : ℕ) : ℤ)) - (ℓg : ℤ) * c := by linarith
    rw [e, sub_zsmul, mul_comm, ← smul_smul, hℓP1]
    simp only [zsmul_zero, smul_zero, neg_zero, add_zero, sub_zero, natCast_zsmul]
    exact hd'.symm

  obtain ⟨γ', hγ'q, hγ'0, τ, hτ, hτC, H⟩ := hIII γ hγq hγ0

  obtain ⟨G, hGfin, hGmem⟩ :=
    ModularCurve.FullLevel.exists_finite_subgroup_forall_mem_iff_exists_isLevelAutAt_of_exists_ringHom_of_eq_levelH_inf_ker
      q M' hqM' ℓg hℓgM' ↥k₀ ξ hξ hιξ H₁ hH₁ K hK
  obtain ⟨huniq, hmul, hone⟩ :=
    ModularCurve.FullLevel.isLevelAutAt_unique_mul_one_of_exists_ringHom_of_eq_levelH_inf_ker
      q M' hqM' ℓg hℓgM' ↥k₀ ξ hξ hιξ H₁ hH₁ K hK
  haveI : Finite ↥G := hGfin
  let S : Set (↥K ≃ₐ[↥k₀] ↥K) :=
    {τ | ∃ γ : SL(2, ℤ), γ ∈ CongruenceSubgroup.Gamma q ∧ γ ∈ CongruenceSubgroup.Gamma0 M' ∧ ModularCurve.FullLevel.IsLevelAutAt ↥k₀ q ξ q (q ^ 2 * M') H₁ γ⁻¹ K τ}
  have hS_sub : S ⊆ (G : Set (↥K ≃ₐ[↥k₀] ↥K)) := by
    rintro τ ⟨γ, -, hγ0, hτ⟩
    exact (hGmem τ).mpr ⟨γ, hγ0, hτ⟩
  have hS_one : (1 : ↥K ≃ₐ[↥k₀] ↥K) ∈ S := by
    refine ⟨1, Subgroup.one_mem _, Subgroup.one_mem _, ?_⟩
    rw [inv_one]
    exact hone 1 (Subgroup.one_mem _) (Subgroup.one_mem _) (by simp)
  have hS_mul : ∀ τ σ, τ ∈ S → σ ∈ S → τ * σ ∈ S := by
    rintro τ σ ⟨γ, hγq, hγ0, hτ⟩ ⟨δ, hδq, hδ0, hσ⟩
    refine ⟨γ * δ, Subgroup.mul_mem _ hγq hδq, Subgroup.mul_mem _ hγ0 hδ0, ?_⟩
    rw [mul_inv_rev]
    exact hmul γ⁻¹ δ⁻¹ (Subgroup.inv_mem _ hγ0) (Subgroup.inv_mem _ hδ0) τ σ hτ hσ
  have hS_pow : ∀ τ, τ ∈ S → ∀ n : ℕ, τ ^ n ∈ S := by
    intro τ hτ n
    induction n with
    | zero => simpa using hS_one
    | succ n ih => rw [pow_succ]; exact hS_mul _ _ ih hτ
  have hS_inv : ∀ τ, τ ∈ S → τ⁻¹ ∈ S := by
    intro τ hτ
    have hfin : IsOfFinOrder τ := by
      have h : IsOfFinOrder (⟨τ, hS_sub hτ⟩ : ↥G) := isOfFinOrder_of_finite _
      obtain ⟨n, hn, hτn⟩ := h.exists_pow_eq_one
      refine isOfFinOrder_iff_pow_eq_one.mpr ⟨n, hn, ?_⟩
      have := congrArg Subtype.val hτn
      simpa using this
    obtain ⟨n, hn, hτn⟩ := hfin.exists_pow_eq_one
    have : τ⁻¹ = τ ^ (n - 1) := by
      rw [eq_comm, ← mul_eq_one_iff_eq_inv', ← pow_succ', Nat.sub_add_cancel hn, hτn]
    rw [this]
    exact hS_pow τ hτ (n - 1)
  let Gq : Subgroup (↥K ≃ₐ[↥k₀] ↥K) :=
    { carrier := S, mul_mem' := fun {a b} ha hb => hS_mul a b ha hb, one_mem' := hS_one, inv_mem' := fun {a} ha => hS_inv a ha }
  haveI : Finite ↥Gq := Finite.Set.subset (G : Set (↥K ≃ₐ[↥k₀] ↥K)) hS_sub

  have hstab : ∀ τ : ↥Gq, ∀ a : ↥K, a ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j → (τ : ↥K ≃ₐ[↥k₀] ↥K) a ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j := by
    rintro ⟨τ, γ, hγq, hγ0, hτ⟩ a ha
    exact ModularCurve.FullLevel.map_mem_chartAlgFin_of_isLevelAutAt q M' ↥k₀ q ξ hιξ K
      ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) j hj H₁ γ⁻¹ τ hτ a ha
  letI actC : MulSemiringAction ↥Gq ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j) :=
