section loops
variable {W : ℕ}

theorem sqB_step {v : Vr} {c : Cs} (hv : BV W v) {p k : ℕ} (hv5 : v 5 = p) (hv20 : v 20 = k)
    (hv21 : v 21 = min k (Nat.sqrt p)) (hkp : k < p) (hpW : p < 2 ^ W) :
    Rn sqB v c (· = Function.update (Function.update v 20 (k + 1)) 21 (min (k + 1) (Nat.sqrt p))) c
      (J6Seg.PJ.cT (Ex.add (.reg 20) (.lit 1) : Ex HS) W + J6Seg.PJ.cT (Ex.add (.reg 21) (.sel (.add (.reg 5)
        (.neg (.mul (.reg 20) (.reg 20)))) (.lit 0) (.lit 1)) : Ex HS) W) := by
  have h1 := Rn.asgR (v := v) (c := c) (W := W) (i := 20) (by decide)
    (e := .add (.reg 20) (.lit 1)) (by decide) (okR_plain _ (by decide))
    (by simp [Tame]; exact Nat.one_le_two_pow) hv
  apply Rn.seq h1; intro v1 hv1
  subst hv1
  have hbv1 : BV W (Function.update v 20 (ev v c (.add (.reg 20) (.lit 1)))) := by
    apply BV_upd hv
    rw [ev_add, ev_reg (by decide), hv20, ev_lit]
    have : ((k : ℤ) + 1) ≤ 2 ^ W := by exact_mod_cast (show k + 1 ≤ 2 ^ W by omega)
    rw [abs_of_nonneg (by positivity)]; exact this
  have h2 := Rn.asgR (v := Function.update v 20 (ev v c (.add (.reg 20) (.lit 1)))) (c := c) (W := W)
    (i := 21) (by decide)
    (e := .add (.reg 21) (.sel (.add (.reg 5) (.neg (.mul (.reg 20) (.reg 20)))) (.lit 0) (.lit 1)))
    (by decide) (okR_plain _ (by decide))
    (by simp [Tame]; exact Nat.one_le_two_pow) hbv1
  refine h2.mono (fun v2 hv2 => ?_) le_rfl
  rw [hv2]
  have e20 : ev v c (.add (.reg 20) (.lit 1)) = (k : ℤ) + 1 := by
    rw [ev_add, ev_reg (by decide), hv20, ev_lit]
  rw [e20]
  have e21 : ev (Function.update v 20 ((k : ℤ) + 1)) c
      (.add (.reg 21) (.sel (.add (.reg 5) (.neg (.mul (.reg 20) (.reg 20)))) (.lit 0) (.lit 1))) =
      ((min (k + 1) (Nat.sqrt p) : ℕ) : ℤ) := by
    simp only [ev_add, ev_sel, ev_neg, ev_mul, ev_lit, ev_reg (show (21 : Fin HS) ∈ rg by decide),
      ev_reg (show (5 : Fin HS) ∈ rg by decide), ev_reg (show (20 : Fin HS) ∈ rg by decide),
      Function.update_self, Function.update_of_ne (show (21 : Fin HS) ≠ 20 by decide),
      Function.update_of_ne (show (5 : Fin HS) ≠ 20 by decide), hv21, hv5]
    by_cases hk : (k + 1) * (k + 1) ≤ p
    · have hs : k + 1 ≤ Nat.sqrt p := Nat.le_sqrt.2 hk
      rw [if_neg (by push_cast; nlinarith)]
      rw [min_eq_left (by omega), min_eq_left hs]; push_cast; ring
    · have hs : ¬ k + 1 ≤ Nat.sqrt p := fun h => hk (Nat.le_sqrt.1 h)
      rw [if_pos (by push_cast; push Not at hk; nlinarith)]
      rw [min_eq_right (by omega), min_eq_right (by omega)]; ring
  rw [e21, Nat.cast_min]; push_cast; rfl

theorem upd2 (v : Vr) (a b a' b' : ℤ) {i j : Fin HS} (hij : i ≠ j) :
    Function.update (Function.update (Function.update (Function.update v i a) j b) i a') j b' =
      Function.update (Function.update v i a') j b' := by
