    -- **piece E**: `N = ⊥` ⟹ `W` is faithful and irreducible ⟹ Gorenstein 3.2.2 gives
    -- `Z(G)` cyclic.
    have hWf : Function.Injective W.toRepresentation := by
      have hinj : Function.Injective W.toRepresentation.asGroupHom :=
        (MonoidHom.ker_eq_bot_iff _).mp hNbot
      intro a b hab
      apply hinj
      rw [Units.ext_iff, W.toRepresentation.asGroupHom_apply, W.toRepresentation.asGroupHom_apply]
      exact hab
    have : FiniteDimensional F ↥W.toSubmodule := inferInstance
    have hZcyc : IsCyclic (Subgroup.center G) :=
      OddOrder.RepresentationTheory.isCyclic_center_of_faithful_irreducible W.toRepresentation hWf
    -- **steps 5-8.**  `ρ` is faithful (`ker ρ ≤ ker (W.toRep.asGroupHom) = ⊥`).
    have hρf : ∀ g : G, ρ g = 1 → g = 1 := by
      intro g hg
      apply hWf
      apply LinearMap.ext
      intro x
      apply Subtype.ext
      change ρ g (x : V) = (W.toRepresentation (1 : G) x : V)
      rw [hg, map_one]; rfl
    -- `g₀ ∈ ⁅R, K⁆ ⊆ K`; `K` acts nontrivially (`ρ g₀ ≠ 1`).
    have hg₀K : g₀ ∈ K := (Subgroup.commutator_le_right R K) hg₀mem
    have hKne : K ≠ ⊥ := by
      intro hKbot; apply hg₀ne
      rw [show g₀ = 1 by rw [hKbot, Subgroup.mem_bot] at hg₀K; exact hg₀K, map_one]
