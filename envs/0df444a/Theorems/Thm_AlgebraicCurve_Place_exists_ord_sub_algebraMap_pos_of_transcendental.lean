theorem AlgebraicCurve.Place.exists_ord_sub_algebraMap_pos_of_transcendental
    {K M : Type*} [Field K] [Field M] [Algebra K M] (t : M) (ht : Transcendental K t)
    [FiniteDimensional K⟮t⟯ M] [Algebra.IsSeparable K⟮t⟯ M] (c : K) :
    ∃ v : AlgebraicCurve.Place K M, 0 < v.ord (t - algebraMap K M c) := by sorry
