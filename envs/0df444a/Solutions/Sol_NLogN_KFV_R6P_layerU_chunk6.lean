-- Source module: Solutions.ButterflyTensor
/-!
# §5.1 Phase-frame identities and tensor products on selected bits

The `2 × 2` matrices of §5.1 of the OpenAI preprint "Integer multiplication below n log n":
`H0 = ½[[1,1],[1,-1]]`, `S = diag(1,i)`, `Z = diag(1,-1)`, `X = [[0,1],[1,0]]`,
`C = HSH = aI + bX` with `a = (1+i)/2`, `b = (1-i)/2`, and the identities (13), (14), (17), (18).

Tensor products over an arbitrary finite set `ι` of selected bits:
`tensF A x y = ∏ i, A i (x i) (y i)` for a family `A : ι → M₂`.
-/

namespace Butterfly

open Matrix Complex Finset

lemma cb_sq : cb ^ 2 = -I / 2 := by
  simp only [cb]; ring_nf; rw [I_sq]; ring

/-- (14): `H0 = b S C S`. -/
theorem H0_eq : H0 = cb • (Sm * Cm * Sm) := by
  rw [Cm_eq]
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [H0, Sm, Matrix.mul_apply, Fin.sum_univ_two, ca, cb] <;> ring_nf <;> simp [I_sq] <;>
    ring

/-! ## Tensor products on selected bits -/

section Tensor

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem tens_Sm : (tens Sm : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) = SD := by
  rw [Sm, diag2_tens, SD]; congr 1; funext x; exact prod_phase I x

/-- (18): `H0^{⊗D} = b^D S_D C^{⊗D} S_D`. -/
theorem tens_H0 : (tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) =
    cb ^ Fintype.card ι • (SD * tens Cm * SD) := by
  rw [H0_eq, tens_smul, tens_mul, tens_mul, tens_Sm]

/-- The scalar of (18): `b^D = (-i/2)^{⌊D/2⌋} b^{D mod 2}`. -/
theorem cb_pow (D : ℕ) : cb ^ D = (-I / 2) ^ (D / 2) * cb ^ (D % 2) := by
  conv_lhs => rw [← Nat.div_add_mod D 2, pow_add, pow_mul, cb_sq]

/-- Every row of `H0^{⊗D}` has absolute row sum one. -/
theorem tens_H0_row_sum (x : ι → Fin 2) : ∑ y, ‖(tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) x y‖ = 1 := by
  simp only [tens, tensF, norm_prod]
  rw [← Fintype.prod_sum (fun i j => ‖H0 (x i) j‖)]
  apply Finset.prod_eq_one
  intro i _
  rcases Fin.exists_fin_two.1 ⟨x i, rfl⟩ with h | h <;>
    simp [h, H0, Fin.sum_univ_two] <;> norm_num

end Tensor

/-! ## (15): address permutations conjugate translations -/

/-! ## Elementary row additions generate `GL(m, F₂)` -/

