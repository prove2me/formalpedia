section Bruhat

lemma runVec_append (l₁ l₂ : List (Step n Q)) (x : Fin n → ZMod Q) :
    runVec (l₁ ++ l₂) x = runVec l₂ (runVec l₁ x) := by
  simp [runVec, List.foldl_append]

variable {E : Matrix (Fin n) (Fin n) (ZMod Q)}

lemma shiftStep_vec (hE : ∀ i j, i < j → E i j = 0) (i : Fin n) (x : Fin n → ZMod Q) :
    (shiftStep E i).vec x = Function.update x i ((E *ᵥ x) i) := by
  simp only [shiftStep, Step.vec, shiftVec]
  congr 1
  simp only [mulVec, dotProduct]
  have : ∀ j, E i j * x j =
      (if j = i then E i i * x i else 0) + (if j < i then E i j else 0) * x j := by
    intro j
    rcases lt_trichotomy j i with h | h | h
    · simp [h, h.ne]
    · subst h; simp
    · simp [h.ne', not_lt.2 h.le, hE i j h]
  rw [Finset.sum_congr rfl (fun j _ => this j), Finset.sum_add_distrib, Finset.sum_ite_eq']
  simp

lemma mulVec_congr_le (hE : ∀ i j, i < j → E i j = 0) {x y : Fin n → ZMod Q} {k : Fin n}
    (h : ∀ m, m ≤ k → x m = y m) : (E *ᵥ x) k = (E *ᵥ y) k := by
  simp only [mulVec, dotProduct]
  refine Finset.sum_congr rfl fun m _ => ?_
  by_cases hm : m ≤ k
  · rw [h m hm]
  · rw [hE k m (not_le.1 hm), zero_mul, zero_mul]

/-- Shifts applied in strictly decreasing target order: each shift reads only earlier
coordinates, which later shifts (with smaller targets) have not yet touched. -/
lemma runVec_shifts_aux (hE : ∀ i j, i < j → E i j = 0) (l : List (Fin n))
    (hl : l.Pairwise (· > ·)) (x : Fin n → ZMod Q) :
    runVec (l.map (shiftStep E)) x = fun k => if k ∈ l then (E *ᵥ x) k else x k := by
  induction l generalizing x with
  | nil => funext k; simp [runVec]
  | cons i l ih =>
    rw [List.pairwise_cons] at hl
    have h1 : runVec ((i :: l).map (shiftStep E)) x =
        runVec (l.map (shiftStep E)) ((shiftStep E i).vec x) := rfl
    rw [h1, ih hl.2, shiftStep_vec hE]
    funext k
    by_cases hk : k ∈ l
    · have hki : k < i := hl.1 k hk
      simp only [hk, if_true, List.mem_cons, or_true]
      refine mulVec_congr_le hE fun m hm => ?_
      rw [Function.update_of_ne (ne_of_lt (lt_of_le_of_lt hm hki))]
    · simp only [hk, if_false, List.mem_cons, or_false]
      by_cases hki : k = i
      · subst hki; simp
      · simp [hki]

/-- The descending shifts for a lower triangular `E` realize `x ↦ E x`. -/
theorem runVec_shiftSteps (hE : ∀ i j, i < j → E i j = 0) (x : Fin n → ZMod Q) :
    runVec (shiftSteps E) x = E *ᵥ x := by
  rw [shiftSteps, runVec_shifts_aux hE]
  · funext k; simp
  · rw [List.pairwise_reverse]; exact List.pairwise_lt_finRange n

lemma shiftSteps_WF (hd : ∀ i, IsUnit (E i i)) : ∀ s ∈ shiftSteps E, s.WF := by
  intro s hs
  simp only [shiftSteps, List.mem_map] at hs
  obtain ⟨i, -, rfl⟩ := hs
  exact ⟨hd i, fun j hj => by simp [not_lt.2 hj]⟩

lemma runVec_swapSteps (ts : List (Fin n × Fin n)) (x : Fin n → ZMod Q) :
    runVec (swapSteps ts) x = x ∘ swapProd ts := by
  induction ts generalizing x with
  | nil => rfl
  | cons p ts ih =>
    have h1 : runVec (swapSteps (p :: ts)) x =
        runVec (swapSteps ts) (x ∘ Equiv.swap p.1 p.2) := rfl
    rw [h1, ih]
    simp [swapProd, Equiv.Perm.coe_mul, Function.comp_assoc]

lemma swapSteps_WF (ts : List (Fin n × Fin n)) : ∀ s ∈ (swapSteps ts : List (Step n Q)), s.WF := by
  intro s hs
  simp only [swapSteps, List.mem_map] at hs
  obtain ⟨p, -, rfl⟩ := hs
  trivial

lemma runVec_bruhatSteps {E₁ E₂ : Matrix (Fin n) (Fin n) (ZMod Q)}
    (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hE₂ : ∀ i j, i < j → E₂ i j = 0)
    {σ : Equiv.Perm (Fin n)} {ts : List (Fin n × Fin n)} (hts : swapProd ts = σ)
    (x : Fin n → ZMod Q) :
    runVec (bruhatSteps E₁ ts E₂) x = (E₁ * σ.permMatrix (ZMod Q) * E₂) *ᵥ x := by
  rw [bruhatSteps, runVec_append, runVec_append, runVec_shiftSteps hE₂, runVec_swapSteps,
    runVec_shiftSteps hE₁, hts, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
    Equiv.Perm.permMatrix, PEquiv.toMatrix_toPEquiv_mulVec]

lemma isUnit_det_bruhat {E₁ E₂ : Matrix (Fin n) (Fin n) (ZMod Q)}
    (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hE₂ : ∀ i j, i < j → E₂ i j = 0)
    (hd₁ : ∀ i, IsUnit (E₁ i i)) (hd₂ : ∀ i, IsUnit (E₂ i i)) (σ : Equiv.Perm (Fin n)) :
    IsUnit (E₁ * σ.permMatrix (ZMod Q) * E₂).det := by
  rw [det_mul, det_mul, det_permutation, det_of_isLowerTriangular E₁ (fun i j h => hE₁ i j h),
    det_of_isLowerTriangular E₂ (fun i j h => hE₂ i j h)]
  refine IsUnit.mul (IsUnit.mul (IsUnit.prod_univ_iff.2 hd₁) ?_) (IsUnit.prod_univ_iff.2 hd₂)
  rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with h | h <;> simp [h]

variable [NeZero Q]

/-- **Main theorem.** For lower triangular `E₁, E₂` and a permutation `σ` written as a product
of transpositions `ts` (leftmost first), the address map of `L = E₁ * w * E₂`, where
`w = σ.permMatrix = σ.toPEquiv.toMatrix` (so `(w *ᵥ x) i = x (σ i)`), equals: the controlled
shifts for `E₂` (targets `n-1, …, 0`), then the field transpositions of `ts` in order, then the
controlled shifts for `E₁` (targets `n-1, …, 0`). -/
theorem linear_via_bruhat {E₁ E₂ : Matrix (Fin n) (Fin n) (ZMod Q)}
    (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hE₂ : ∀ i j, i < j → E₂ i j = 0)
    (σ : Equiv.Perm (Fin n)) (ts : List (Fin n × Fin n))
    (hts : (ts.map fun p => Equiv.swap p.1 p.2).prod = σ) :
    ∀ a, Valid sh a → amap Λ (E₁ * σ.permMatrix (ZMod Q) * E₂) a = run Λ (bruhatSteps E₁ ts E₂) a := by
  intro a ha
  rw [run_eq_vmap Λ _ ha, amap_eq_vmap]
  congr 1
  funext x
  exact (runVec_bruhatSteps hE₁ hE₂ hts x).symm

/-- `amap L⁻¹` inverts `amap L` (on valid addresses) for `L = E₁ w E₂`. -/
theorem amap_inv_amap {L : Matrix (Fin n) (Fin n) (ZMod Q)} (hL : IsUnit L.det) {a : List ℕ}
    (ha : Valid sh a) : amap Λ L⁻¹ (amap Λ L a) = a ∧ amap Λ L (amap Λ L⁻¹ a) = a := by
  rw [amap_mul Λ _ _ ha, amap_mul Λ _ _ ha, Matrix.nonsing_inv_mul _ hL,
    Matrix.mul_nonsing_inv _ hL, amap_one Λ ha]
  exact ⟨rfl, rfl⟩

end Bruhat

end AModel

end

section
open AModel
open Matrix
variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)
variable {E : Matrix (Fin n) (Fin n) (ZMod Q)}
variable [NeZero Q]
theorem solution {E₁ E₂ : Matrix (Fin n) (Fin n) (ZMod Q)}
    (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hE₂ : ∀ i j, i < j → E₂ i j = 0)
    (hd₁ : ∀ i, IsUnit (E₁ i i)) (hd₂ : ∀ i, IsUnit (E₂ i i))
    (σ : Equiv.Perm (Fin n)) (ts : List (Fin n × Fin n))
    (hts : (ts.map fun p => Equiv.swap p.1 p.2).prod = σ)
    {α : Type*} (d : α) (xs : List α) (hxs : xs.length = AModel.vol sh) :
    AModel.pull sh sh (AModel.amap Λ (E₁ * σ.permMatrix (ZMod Q) * E₂)⁻¹) d xs =
      AModel.runArr Λ d (AModel.bruhatSteps E₁ ts E₂) xs := by
  have hL := AModel.isUnit_det_bruhat hE₁ hE₂ hd₁ hd₂ σ
  have hWF : ∀ s ∈ (AModel.bruhatSteps E₁ ts E₂ : List (AModel.Step n Q)), s.WF := by
    intro s hs
    simp only [AModel.bruhatSteps, List.mem_append] at hs
    rcases hs with (hs | hs) | hs
    · exact AModel.shiftSteps_WF hd₂ s hs
    · exact AModel.swapSteps_WF ts s hs
    · exact AModel.shiftSteps_WF hd₁ s hs
  rw [AModel.runArr_eq_pull Λ d _ hxs]
  apply AModel.pull_congr
  intro b hb
  have hb' := AModel.valid_amap Λ (E₁ * σ.permMatrix (ZMod Q) * E₂)⁻¹ hb
  conv_rhs => rw [← (AModel.amap_inv_amap Λ hL hb).2, AModel.linear_via_bruhat Λ hE₁ hE₂ σ ts hts _ hb']
  exact (AModel.invChain_run Λ hWF hb').symm
end
