-- Source module: NLogN.Flat
/-!
# Flat code with jumps, and compilation of structured programs into it

Instructions carry absolute addresses. `ret` with an empty control stack halts.
`exec_flat`: a structured run of cost `c` is `c` flat steps.
-/

namespace NLogN

variable {S P : ℕ}

/-! ## Layout -/

theorem exec_flat_sol_aux {I : List Sym} {prog : Fin P → Stmt S P} {code : ℕ → Instr S}
    {ent : Fin P → ℕ} (hprog : ProgPlaced code prog ent) {s : Stmt S P} {σ σ' : St S} {c : ℕ}
    (h : Exec I prog s σ σ' c) :
    ∀ a e, Placed code ent s a e → ∀ ctl, Steps I code ⟨a, σ, ctl⟩ c ⟨e, σ', ctl⟩ := by
  induction h with
  | skip σ =>
    intro a e hp ctl
    exact Steps.one (by simp [fstep, show code a = _ from hp])
  | push σ i x =>
    intro a e hp ctl
    exact Steps.one (by simp [fstep, show code a = _ from hp])
  | pop σ i =>
    intro a e hp ctl
    exact Steps.one (by simp [fstep, show code a = _ from hp])
  | inRd σ i =>
    intro a e hp ctl
    exact Steps.one (by simp [fstep, show code a = _ from hp])
  | out σ b =>
    intro a e hp ctl
    exact Steps.one (by simp [fstep, show code a = _ from hp])
  | seq _ _ ih₁ ih₂ =>
    intro a e hp ctl
    exact (ih₁ _ _ hp.1 ctl).trans (ih₂ _ _ hp.2 ctl)
  | @iteT i f p q σ σ' c hc _ ih =>
    intro a e hp ctl
    have h1 : Steps I code ⟨a, σ, ctl⟩ 1 ⟨a + 1, σ, ctl⟩ :=
      Steps.one (by simp [fstep, hp.1, hc])
    have := h1.trans (ih _ _ hp.2.1 ctl)
    rwa [Nat.add_comm] at this
  | @iteF i f p q σ σ' c hc _ ih =>
    intro a e hp ctl
    have h1 : Steps I code ⟨a, σ, ctl⟩ 1 ⟨a + 1 + p.size, σ, ctl⟩ :=
      Steps.one (by simp [fstep, hp.1, hc])
    have := h1.trans (ih _ _ hp.2.2 ctl)
    rwa [Nat.add_comm] at this
  | @loopT i f p σ σ₁ σ₂ c₁ c₂ hc _ _ ih₁ ih₂ =>
    intro a e hp ctl
    have h1 : Steps I code ⟨a, σ, ctl⟩ 1 ⟨a + 1, σ, ctl⟩ :=
      Steps.one (by simp [fstep, hp.1, hc])
    have := (h1.trans (ih₁ _ _ hp.2 ctl)).trans (ih₂ a e hp ctl)
    convert this using 1
    omega
  | loopF hc =>
    intro a e hp ctl
    exact Steps.one (by simp [fstep, hp.1, hc])
  | @call j σ σ' c _ ih =>
    intro a e hp ctl
    have h1 : Steps I code ⟨a, σ, ctl⟩ 1 ⟨ent j, σ, e :: ctl⟩ :=
      Steps.one (by simp [fstep, show code a = _ from hp])
    have h2 := ih _ _ (hprog j).1 (e :: ctl)
    have h3 : Steps I code ⟨ent j + (prog j).size, σ', e :: ctl⟩ 1 ⟨e, σ', ctl⟩ :=
      Steps.one (by simp [fstep, (hprog j).2])
    have := (h1.trans h2).trans h3
    convert this using 1
    omega

/-! ## A concrete layout -/

