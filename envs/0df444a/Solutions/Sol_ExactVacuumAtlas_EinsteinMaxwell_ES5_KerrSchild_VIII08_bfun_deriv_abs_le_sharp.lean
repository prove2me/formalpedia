    rw [hdecomp]; ring
  rw [hsplit]
  have h2 : |R ^ 2 * (Ifun j q R / (P R * Y R))| ≤ B * R / (3 * (R - 1)) := by
    rw [abs_mul, abs_of_pos (by positivity : (0:ℝ) < R ^ 2)]
    refine le_trans (mul_le_mul_of_nonneg_left hIterrm (by positivity)) (le_of_eq ?_)
    field_simp
  have h3 : B * R / (3 * (R - 1)) ≤ B / 2 := by
    rw [div_le_div_iff₀ (by linarith : (0:ℝ) < 3 * (R - 1)) (by norm_num : (0:ℝ) < 2)]
    nlinarith
  have h4 : |R ^ 2 * (Ifun j q R / (P R * Y R))| ≤ B / 2 := le_trans h2 h3
  calc |R ^ 2 * (deriv Y R / Y R * bfun j q R) + R ^ 2 * (Ifun j q R / (P R * Y R))|
      ≤ |R ^ 2 * (deriv Y R / Y R * bfun j q R)| + |R ^ 2 * (Ifun j q R / (P R * Y R))| :=
        abs_add_le _ _
    _ ≤ 3 * B / 8 + B / 2 := add_le_add h1 h4
    _ ≤ B := by linarith
