variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

theorem fbk_le (k : ℕ) : fbk D long k ≤ 1 := by unfold fbk; split_ifs <;> simp

theorem rkS_succ (k : ℕ) : rkS D long (k + 1) = rkS D long k + fbk D long k := by
  simp [rkS, List.range_succ]

theorem sum_ite_filter {α : Type*} (p : α → Bool) :
    ∀ l : List α, (l.map fun x => if p x then 1 else 0).sum = (l.filter p).length
  | [] => rfl
  | x :: l => by
    simp only [List.map_cons, List.sum_cons, List.filter_cons]
    rw [sum_ite_filter p l]; split_ifs <;> simp_all; omega

theorem rkS_D : rkS D long D = nLong D long := by
  unfold rkS nLong
  have := map_finRange_fbk D long (fun x => x)
  simp only [Function.comp_def] at this
  rw [← this, ← sum_ite_filter]
  congr 1; apply List.map_congr_left; intro i _; simp [fbk, i.2]

theorem rkS_mono {j k : ℕ} (h : j ≤ k) : rkS D long j ≤ rkS D long k := by
  induction k with
  | zero => rw [Nat.le_zero.1 h]
  | succ k ih =>
    rcases Nat.lt_or_ge j (k + 1) with h' | h'
    · rw [rkS_succ]; have := ih (by omega); omega
    · rw [Nat.le_antisymm h h']

theorem ops1_flat : ops1 D ℓ long = (List.range D).flatMap fun k => [op1 D ℓ long k] := by
  unfold ops1 op1; rw [List.map_eq_flatMap]

