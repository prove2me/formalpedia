theorem GlobalTheory.ThetaCoord.sv_act {θ : ThetaGrp A L k T} {x : T ⟶ A} (hx : θ.pt = x) {s s' : LB.Sec (LPow A L k T)}
    (H : IsActOf A L k θ s s') (π : T' ⟶ T) {z : T'.left} {J} (hJ : Good L z J) (p : T' ⟶ A) :
