namespace RankBasedSDI.LoadBalancing

theorem proposition_4_1_ii {Ω : Type*} [MeasurableSpace Ω] {N : ℕ}
    (S : LoadBalancingSequence Ω N) (H : HeavyTraffic S) (μ₀ : ProbabilityMeasure (Fin N → ℝ))
    (hIC : IC0 S μ₀) (φ : ℕ → ℕ) (hφ : StrictMono φ)
    (Ω' : Type) [mΩ' : MeasurableSpace Ω'] (P' : Measure Ω') [IsProbabilityMeasure P']
    (X L E Sl Pl : Ω' → ℝ → Fin N → ℝ)
    (hcont : ∀ᵐ ω ∂P', ∀ i : Fin N, ContinuousOn (fun t => X ω t i) (Set.Ici 0) ∧
      ContinuousOn (fun t => L ω t i) (Set.Ici 0) ∧ ContinuousOn (fun t => E ω t i) (Set.Ici 0) ∧
      ContinuousOn (fun t => Sl ω t i) (Set.Ici 0) ∧ ContinuousOn (fun t => Pl ω t i) (Set.Ici 0))
    (hlim : CouplingConverges S.P P'
      (fun k ω t => Fin.append (Fin.append (Fin.append (Fin.append
        (Xhat S (φ k) ω t) (Lhat S (φ k) ω t)) (Ehat S (φ k) ω t)) (Shat S (φ k) ω t))
        (PhatSharp H (φ k) ω t))
      (fun ω t => Fin.append (Fin.append (Fin.append (Fin.append
        (X ω t) (L ω t)) (E ω t)) (Sl ω t)) (Pl ω t))) :
    ∃ (F : Filtration ℝ≥0 mΩ') (Xv Lv Bv β : Ω' → ℝ → Fin N → ℝ),
      (∀ᵐ ω ∂P', ∀ t : ℝ, 0 ≤ t → Xv ω t = X ω t ∧ Lv ω t = L ω t ∧
        Bv ω t = fun i => (E ω t i - Sl ω t i) / diffSigma H i) ∧
      (∀ᵐ ω ∂P', ∀ᵐ t ∂(volume.restrict (Set.Ici (0 : ℝ))), ∀ i : Fin N,
        HasDerivAt (fun s => Pl ω s i) (β ω t i) t) ∧
      IsWeakSolutionSDIR (driftB H) (driftM H) (diffSigma H) P' F Xv Lv Bv β := by sorry

end RankBasedSDI.LoadBalancing
