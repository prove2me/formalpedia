lemma sum_range_mul' (A M : ℕ) (g : ℕ → ℕ) :
    ∑ n ∈ range (A * M), g n = ∑ q ∈ range M, ∑ r ∈ range A, g (q * A + r) := by
  induction M with
  | zero => simp
  | succ M ih =>
    rw [Nat.mul_succ, Finset.sum_range_add, ih, Finset.sum_range_succ]
    congr 1; refine Finset.sum_congr rfl fun r _ => ?_; rw [Nat.mul_comm]

/-- Digit distribution: `#{n < A Q C : ⌊n/A⌋ mod Q ∈ bad} = A · #bad · C`. -/
theorem count_digit (A Q C : ℕ) (hA : 0 < A) (hQ : 0 < Q) (bad : Finset ℕ)
    (hbad : bad ⊆ range Q) :
    ((range (A * (Q * C))).filter fun n => (n / A) % Q ∈ bad).card = A * bad.card * C := by
  rw [Finset.card_filter, sum_range_mul']
  have h1 : ∀ q, ∑ r ∈ range A, (if ((q * A + r) / A) % Q ∈ bad then 1 else 0) =
      A * (if q % Q ∈ bad then 1 else 0) := by
    intro q
    have : ∀ r ∈ range A, (q * A + r) / A = q := fun r hr => by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hA, Nat.div_eq_of_lt (Finset.mem_range.1 hr),
        zero_add]
    rw [Finset.sum_congr rfl fun r hr => by rw [this r hr], Finset.sum_const, card_range,
      smul_eq_mul]
  simp only [h1]
  rw [← Finset.mul_sum, sum_range_mul']
  have h2 : ∀ t, ∑ s ∈ range Q, (if (t * Q + s) % Q ∈ bad then 1 else 0) = bad.card := by
    intro t
    have : ∀ s ∈ range Q, (t * Q + s) % Q = s := fun s hs => by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt (Finset.mem_range.1 hs)]
    rw [Finset.sum_congr rfl fun s hs => by rw [this s hs], ← Finset.card_filter]
    congr 1; ext s; simp only [Finset.mem_filter, Finset.mem_range]
    exact ⟨fun h => h.2, fun h => ⟨Finset.mem_range.1 (hbad h), h⟩⟩
  simp only [h2, Finset.sum_const, card_range, smul_eq_mul]; ring

