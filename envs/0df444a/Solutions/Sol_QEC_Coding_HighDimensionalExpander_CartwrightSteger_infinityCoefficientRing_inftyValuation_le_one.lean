theorem _root_.solution
    (P : BasePrime) (r : Rank) (a : InfinityCoefficientRing P r) :
    RatFunc.inftyValuation (ConstantExtension P r)
        (a : SplittingFunctionField P r) ≤ 1 := by
  classical
  apply Algebra.adjoin_induction
    (R := ConstantExtension P r)
    (s := {(splittingY P r)⁻¹})
    (p := fun x _ => RatFunc.inftyValuation (ConstantExtension P r) x ≤ 1)
  · intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    change RatFunc.inftyValuation (ConstantExtension P r)
      ((RatFunc.X : SplittingFunctionField P r)⁻¹) ≤ 1
    rw [show (RatFunc.X : SplittingFunctionField P r)⁻¹ =
      1 / RatFunc.X by simp]
    rw [RatFunc.inftyValuation.X_inv]
    simpa using
      ((WithZero.exp_le_exp).2 (show (-1 : ℤ) ≤ 0 by omega))
  · intro c
    by_cases hc : c = 0
    · subst c
      simp
    · exact (RatFunc.inftyValuation.C (ConstantExtension P r) hc).le
  · intro x y hx hy hvx hvy
    exact (RatFunc.inftyValuation (ConstantExtension P r)).map_add x y |>.trans
      (max_le hvx hvy)
  · intro x y hx hy hvx hvy
    rw [map_mul]
    exact mul_le_one₀ hvx bot_le hvy
  · exact a.property
