          (((𝒢.restrictScalars W₀) Pet.B₀ xet.curve xet.isUnit_Δ).one t').1 := by
      rintro t t' rfl; rfl
    have h1 := WeierstrassCurve.DrinfeldGlobal.GroupLaws.one_comp_projMap_eq_of_isCoefficientHom W₀
      (𝒢.restrictScalars W₀) h𝒢Or Pet.B₀ k ψet xet.curve xet.isUnit_Δ hΔk φc hφc hcoef (𝟙 (base (T := k)))
    have h2 : Qk.1 ≫ Proj.map φc hφc =
        (((𝒢.restrictScalars W₀) k (xet.curve.map ψet.toRingHom) hΔk).one (𝟙 (base (T := k)))).1 ≫
          Proj.map φc hφc := by
      rw [hpin, h0, h1]
      exact key (by rw [hcompψ, Category.id_comp])
    have h3 := WeierstrassCurve.DrinfeldGlobal.section_eq_of_comp_projMap_eq_of_isCoefficientHom
      xet.curve ψet.toRingHom φc hφc hcoef Qk _ h2
