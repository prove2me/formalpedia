open Classical

/-- the cone generated by a finite family -/
def chm_cone {ι E : Type*} [Fintype ι] [AddCommGroup E] [Module ℝ E] (v : ι → E) : Set E :=
  {x | ∃ l : ι → ℝ, (∀ i, 0 ≤ l i) ∧ x = ∑ i, l i • v i}

def chm_Ls {ι E : Type*} [AddCommGroup E] [Module ℝ E] (v : ι → E) (s : Finset ι) :
    (s → ℝ) →ₗ[ℝ] E where
  toFun μ := ∑ i, μ i • v i
  map_add' a b := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' c a := by simp [Finset.smul_sum, smul_smul]

lemma chm_sum_sub {ι E : Type*} [Fintype ι] [AddCommGroup E] (s : Finset ι) (f : ι → E)
    (h : ∀ i, i ∉ s → f i = 0) : ∑ i : s, f i = ∑ i, f i := by
  rw [Finset.sum_coe_sort s f]
  exact Finset.sum_subset (Finset.subset_univ _) (fun i _ hi => h i hi)

lemma chm_carath {ι E : Type*} [Fintype ι] [AddCommGroup E] [Module ℝ E] (v : ι → E) :
    ∀ n : ℕ, ∀ l : ι → ℝ, (∀ i, 0 ≤ l i) → (Finset.univ.filter (fun i => l i ≠ 0)).card = n →
      ∃ s : Finset ι, LinearIndependent ℝ (fun i : s => v i) ∧
        ∃ μ : s → ℝ, (∀ i, 0 ≤ μ i) ∧ ∑ i, l i • v i = ∑ i, μ i • v i := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro l hl hn
  set s := Finset.univ.filter (fun i => l i ≠ 0) with hs
  have hsum_s : ∑ i, l i • v i = ∑ i : s, l i • v i := by
    symm
    apply chm_sum_sub s (fun i => l i • v i)
    intro i hi
    have : l i = 0 := by
      by_contra h; exact hi (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩)
    simp [this]
  by_cases hli : LinearIndependent ℝ (fun i : s => v i)
  · exact ⟨s, hli, fun i => l i, fun i => hl i, hsum_s⟩
  rw [Fintype.not_linearIndependent_iff] at hli
  obtain ⟨g0, hg0, i0, hi0⟩ := hli
  -- make some coefficient positive
  obtain ⟨g, hg, j0, hj0⟩ : ∃ g : s → ℝ, ∑ i, g i • v i = 0 ∧ ∃ j, 0 < g j := by
    rcases lt_or_gt_of_ne hi0 with h | h
    · refine ⟨fun i => -g0 i, ?_, i0, by linarith⟩
      simp only [neg_smul, Finset.sum_neg_distrib, hg0, neg_zero]
    · exact ⟨g0, hg0, i0, h⟩
  let μ : ι → ℝ := fun i => if h : i ∈ s then g ⟨i, h⟩ else 0
  have hμsum : ∑ i, μ i • v i = 0 := by
    rw [← hg]
    have : ∑ i : s, g i • v i = ∑ i : s, μ i • v i := by
      apply Finset.sum_congr rfl; intro i _; simp [μ, i.2]
    rw [this]
    exact (chm_sum_sub s (fun i => μ i • v i) (fun i hi => by simp [μ, hi])).symm
  have hμoff : ∀ i, i ∉ s → μ i = 0 := by intro i hi; simp [μ, hi]
  set P := s.filter (fun i => 0 < μ i) with hP
  have hPne : P.Nonempty := ⟨j0, Finset.mem_filter.2 ⟨j0.2, by simp [μ, j0.2, hj0]⟩⟩
  obtain ⟨i1, hi1P, hmin⟩ := P.exists_min_image (fun i => l i / μ i) hPne
  rw [Finset.mem_filter] at hi1P
  set θ := l i1 / μ i1 with hθ
  have hθnn : 0 ≤ θ := div_nonneg (hl i1) hi1P.2.le
  let l' : ι → ℝ := fun i => l i - θ * μ i
  have hl' : ∀ i, 0 ≤ l' i := by
    intro i
    simp only [l']
    by_cases hμ : 0 < μ i
    · by_cases his : i ∈ s
      · have := hmin i (Finset.mem_filter.2 ⟨his, hμ⟩)
        rw [le_div_iff₀ hμ] at this
        linarith
      · rw [hμoff i his] at hμ; exact absurd hμ (lt_irrefl 0)
    · push_neg at hμ
      have := hl i
      nlinarith
  have hl'sum : ∑ i, l' i • v i = ∑ i, l i • v i := by
    simp only [l', sub_smul, Finset.sum_sub_distrib, mul_smul, ← Finset.smul_sum, hμsum,
      smul_zero, sub_zero]
  have hsub : Finset.univ.filter (fun i => l' i ≠ 0) ⊆ s.erase i1 := by
    intro i hi
    rw [Finset.mem_filter] at hi
    rw [Finset.mem_erase]
    constructor
    · rintro rfl
      apply hi.2
      simp only [l', hθ]
      rw [div_mul_cancel₀ _ hi1P.2.ne', sub_self]
    · by_contra his
      apply hi.2
      simp only [l']
      have h1 : l i = 0 := by
        by_contra h; exact his (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩)
      rw [h1, hμoff i his]; ring
  have hlt : (Finset.univ.filter (fun i => l' i ≠ 0)).card < n := by
    calc _ ≤ (s.erase i1).card := Finset.card_le_card hsub
      _ < s.card := Finset.card_erase_lt_of_mem hi1P.1
      _ = n := hn
  obtain ⟨s', h1, μ', h2, h3⟩ := ih _ hlt l' hl' rfl
  exact ⟨s', h1, μ', h2, hl'sum ▸ h3⟩

lemma chm_cone_closed {ι E : Type*} [Fintype ι] [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] (v : ι → E) : IsClosed (chm_cone v) := by
  have heq : chm_cone v = ⋃ s ∈ (Finset.univ.filter
      (fun s : Finset ι => LinearIndependent ℝ (fun i : s => v i)) : Set (Finset ι)),
      (chm_Ls v s) '' {μ | ∀ i, 0 ≤ μ i} := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_image, Finset.coe_filter, Set.mem_setOf_eq,
      Finset.mem_univ, true_and]
    constructor
    · rintro ⟨l, hl, rfl⟩
      obtain ⟨s, hs, μ, hμ, he⟩ := chm_carath v _ l hl rfl
      exact ⟨s, hs, μ, hμ, he.symm⟩
    · rintro ⟨s, _, μ, hμ, rfl⟩
      refine ⟨fun i => if h : i ∈ s then μ ⟨i, h⟩ else 0, ?_, ?_⟩
      · intro i; dsimp only; split_ifs
        · exact hμ _
        · exact le_rfl
      · show ∑ i, μ i • v i = _
        have : ∑ i : s, μ i • v i =
            ∑ i : s, (fun j => (if h : j ∈ s then μ ⟨j, h⟩ else 0) • v j) i := by
          apply Finset.sum_congr rfl; intro i _; simp [i.2]
        rw [this]
        exact chm_sum_sub s (fun j => (if h : j ∈ s then μ ⟨j, h⟩ else 0) • v j)
          (fun i hi => by simp [hi])
  rw [heq]
  apply Set.Finite.isClosed_biUnion (Set.toFinite _)
  intro s hs
  simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hs
  have hker : LinearMap.ker (chm_Ls v s) = ⊥ := by
    rw [LinearMap.ker_eq_bot']
    intro μ hμ
    rw [Fintype.linearIndependent_iff] at hs
    funext i
    exact hs μ hμ i
  have hemb := LinearMap.isClosedEmbedding_of_injective hker
  apply hemb.isClosedMap
  have : {μ : s → ℝ | ∀ i, 0 ≤ μ i} = ⋂ i, {μ : s → ℝ | 0 ≤ μ i} := by ext; simp
  rw [this]
  exact isClosed_iInter (fun i => isClosed_le continuous_const (continuous_apply i))

lemma chm_hull_le {V : Type*} [Fintype V] (S : Finset (V → ℝ)) (hS : S.Nonempty) (c : V → ℝ)
    (x : V → ℝ) (hx : x ∈ convexHull ℝ (S : Set (V → ℝ))) :
    ∑ u, c u * x u ≤ S.sup' hS (fun x => ∑ u, c u * x u) := by
  suffices hsub : convexHull ℝ (S : Set (V → ℝ)) ⊆
      {x | ∑ u, c u * x u ≤ S.sup' hS (fun x => ∑ u, c u * x u)} from hsub hx
  apply convexHull_min
  · intro y hy
    exact Finset.le_sup' (fun x => ∑ u, c u * x u) (Finset.mem_coe.1 hy)
  · intro y hy z hz s t hs ht hst
    simp only [Set.mem_setOf_eq, Pi.add_apply, Pi.smul_apply, smul_eq_mul, mul_add,
      Finset.sum_add_distrib] at hy hz ⊢
    have e1 : ∑ u, c u * (s * y u) = s * ∑ u, c u * y u := by
      rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro u _; ring
    have e2 : ∑ u, c u * (t * z u) = t * ∑ u, c u * z u := by
      rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro u _; ring
    rw [e1, e2]
    have := mul_le_mul_of_nonneg_left hy hs
    have := mul_le_mul_of_nonneg_left hz ht
    have : S.sup' hS (fun x => ∑ u, c u * x u) =
      s * S.sup' hS (fun x => ∑ u, c u * x u) + t * S.sup' hS (fun x => ∑ u, c u * x u) := by
      rw [← add_mul, hst, one_mul]
    linarith

lemma chm_weak {V J : Type*} [Fintype V] [Fintype J] (a : J → V → ℝ) (b : J → ℝ) (c : V → ℝ)
    (x : V → ℝ) (hx0 : ∀ u, 0 ≤ x u) (hx : ∀ i, ∑ u, a i u * x u ≤ b i)
    (lam : J → ℝ) (hl0 : ∀ i, 0 ≤ lam i) (hl : ∀ u, c u ≤ ∑ i, lam i * a i u) :
    ∑ u, c u * x u ≤ ∑ i, lam i * b i := by
  calc ∑ u, c u * x u ≤ ∑ u, (∑ i, lam i * a i u) * x u :=
        Finset.sum_le_sum (fun u _ => mul_le_mul_of_nonneg_right (hl u) (hx0 u))
    _ = ∑ i, lam i * ∑ u, a i u * x u := by
        simp only [Finset.sum_mul, Finset.mul_sum]
        rw [Finset.sum_comm]
        apply Finset.sum_congr rfl; intro i _
        apply Finset.sum_congr rfl; intro u _
        ring
    _ ≤ ∑ i, lam i * b i :=
        Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_left (hx i) (hl0 i))

/-- generators of the dual cone, living in `Option V → ℝ` -/
def chm_gen {V J : Type*} [DecidableEq V] (a : J → V → ℝ) (b : J → ℝ) :
    J ⊕ V ⊕ Unit → Option V → ℝ
  | Sum.inl i => fun o => match o with
      | none => b i
      | some u => a i u
  | Sum.inr (Sum.inl u) => fun o => match o with
      | none => 0
      | some u' => if u' = u then -1 else 0
  | Sum.inr (Sum.inr _) => fun o => match o with
      | none => 1
      | some _ => 0

lemma chm_dual {V J : Type*} [Fintype V] [Fintype J] [DecidableEq V]
    (a : J → V → ℝ) (b : J → ℝ) (S : Finset (V → ℝ)) (hS : S.Nonempty)
    (hP : {x : V → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i} = convexHull ℝ (S : Set (V → ℝ)))
    (c : V → ℝ) :
    ∃ lam : J → ℝ, (∀ i, 0 ≤ lam i) ∧ (∀ u, c u ≤ ∑ i, lam i * a i u) ∧
      ∑ i, lam i * b i ≤ S.sup' hS (fun x => ∑ u, c u * x u) := by
  set M := S.sup' hS (fun x => ∑ u, c u * x u) with hM
  let t : Option V → ℝ := fun o => match o with
    | none => M
    | some u => c u
  by_cases ht : t ∈ chm_cone (chm_gen a b)
  · obtain ⟨l, hl0, hl⟩ := ht
    refine ⟨fun i => l (Sum.inl i), fun i => hl0 _, ?_, ?_⟩
    · intro u
      have := congrFun hl (some u)
      simp only [t, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Fintype.sum_sum_type,
        chm_gen, Fintype.sum_unique] at this
      simp only [mul_ite, mul_neg, mul_one, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq',
        Finset.mem_univ, if_true, add_zero] at this
      have := hl0 (Sum.inr (Sum.inl u))
      show c u ≤ ∑ i, l (Sum.inl i) * a i u
      linarith
    · have := congrFun hl none
      simp only [t, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Fintype.sum_sum_type,
        chm_gen, Fintype.sum_unique, mul_zero, Finset.sum_const_zero, mul_one] at this
      have := hl0 (Sum.inr (Sum.inr ()))
      linarith
  · exfalso
    have hconv : Convex ℝ (chm_cone (chm_gen a b)) := by
      rintro x ⟨l1, h1, rfl⟩ y ⟨l2, h2, rfl⟩ p q hp hq _
      refine ⟨fun i => p * l1 i + q * l2 i, fun i => by have := h1 i; have := h2 i; positivity, ?_⟩
      simp only [Finset.smul_sum, smul_smul, add_smul, Finset.sum_add_distrib]
    obtain ⟨f, u0, hfu, hfc⟩ := geometric_hahn_banach_point_closed hconv
      (chm_cone_closed (chm_gen a b)) ht
    have h0 : (0 : Option V → ℝ) ∈ chm_cone (chm_gen a b) :=
      ⟨fun _ => 0, fun _ => le_rfl, by simp⟩
    have hu0 : u0 < 0 := by simpa using hfc 0 h0
    have hgen : ∀ k, 0 ≤ f (chm_gen a b k) := by
      intro k
      by_contra hneg
      push_neg at hneg
      set r := u0 / f (chm_gen a b k) with hr
      have hrpos : 0 < r := div_pos_of_neg_of_neg hu0 hneg
      have hmem : r • chm_gen a b k ∈ chm_cone (chm_gen a b) := by
        refine ⟨fun k' => if k' = k then r else 0, fun k' => by show 0 ≤ (if k' = k then r else 0); split_ifs <;> linarith, ?_⟩
        simp
      have := hfc _ hmem
      rw [map_smul, smul_eq_mul, hr, div_mul_cancel₀ _ hneg.ne] at this
      exact lt_irrefl _ this
    set φ : Option V → ℝ := fun o => f (fun j => if o = j then 1 else 0) with hφ
    have hf : ∀ w, f w = ∑ o, w o * φ o := by
      intro w
      have := f.toLinearMap.pi_apply_eq_sum_univ w
      simpa [smul_eq_mul] using this
    set s := φ none
    set y : V → ℝ := fun u => φ (some u)
    have hgi : ∀ i, 0 ≤ b i * s + ∑ u, a i u * y u := by
      intro i
      have := hgen (Sum.inl i)
      rw [hf, Fintype.sum_option] at this
      simpa [chm_gen] using this
    have hgu : ∀ u, y u ≤ 0 := by
      intro u
      have := hgen (Sum.inr (Sum.inl u))
      rw [hf, Fintype.sum_option] at this
      simp [chm_gen] at this
      simpa [y] using this
    have hgs : 0 ≤ s := by
      have := hgen (Sum.inr (Sum.inr ()))
      rw [hf, Fintype.sum_option] at this
      simpa [chm_gen] using this
    have hft : M * s + ∑ u, c u * y u < 0 := by
      have := hfu.trans hu0
      rw [hf, Fintype.sum_option] at this
      simpa [t] using this
    rcases hgs.lt_or_eq with hspos | hs0
    · -- x = -y/s is feasible with objective > M
      set x : V → ℝ := fun u => -y u / s
      have hxP : x ∈ convexHull ℝ (S : Set (V → ℝ)) := by
        rw [← hP]
        refine ⟨fun u => div_nonneg (by linarith [hgu u]) hspos.le, fun i => ?_⟩
        have : ∑ u, a i u * x u = -(∑ u, a i u * y u) / s := by
          simp only [x, Finset.sum_div, ← Finset.sum_neg_distrib]
          apply Finset.sum_congr rfl; intro u _; ring
        rw [this, div_le_iff₀ hspos]
        linarith [hgi i]
      have h1 := chm_hull_le S hS c x hxP
      have : ∑ u, c u * x u = -(∑ u, c u * y u) / s := by
        simp only [x, Finset.sum_div, ← Finset.sum_neg_distrib]
        apply Finset.sum_congr rfl; intro u _; ring
      rw [this, div_le_iff₀ hspos] at h1
      rw [← hM] at h1
      linarith
    · -- recession direction
      obtain ⟨x0, hx0⟩ := hS
      have hx0P' : (∀ u, 0 ≤ x0 u) ∧ ∀ i, ∑ u, a i u * x0 u ≤ b i := by
        have : x0 ∈ convexHull ℝ (S : Set (V → ℝ)) := subset_convexHull ℝ _ (Finset.mem_coe.2 hx0)
        rw [← hP] at this; exact this
      have hcy : ∑ u, c u * y u < 0 := by rw [← hs0] at hft; simpa using hft
      have hay : ∀ i, 0 ≤ ∑ u, a i u * y u := by
        intro i; have := hgi i; rw [← hs0] at this; simpa using this
      have hMx0 : ∑ u, c u * x0 u ≤ M := Finset.le_sup' (fun x => ∑ u, c u * x u) hx0
      set r := (M - ∑ u, c u * x0 u + 1) / (-(∑ u, c u * y u)) with hr
      have hrpos : 0 < r := div_pos (by linarith) (by linarith)
      set x : V → ℝ := fun u => x0 u - r * y u
      have hxP : x ∈ convexHull ℝ (S : Set (V → ℝ)) := by
        rw [← hP]
        refine ⟨fun u => ?_, fun i => ?_⟩
        · have := hx0P'.1 u; have := hgu u; simp only [x]; nlinarith
        · have e : ∑ u, a i u * x u = ∑ u, a i u * x0 u - r * ∑ u, a i u * y u := by
            simp only [x, Finset.mul_sum, ← Finset.sum_sub_distrib]
            apply Finset.sum_congr rfl; intro u _; ring
          rw [e]
          have := hx0P'.2 i
          have := mul_nonneg hrpos.le (hay i)
          linarith
      have h1 := chm_hull_le S ⟨x0, hx0⟩ c x hxP
      have e : ∑ u, c u * x u = ∑ u, c u * x0 u - r * ∑ u, c u * y u := by
        simp only [x, Finset.mul_sum, ← Finset.sum_sub_distrib]
        apply Finset.sum_congr rfl; intro u _; ring
      rw [e] at h1
      have : r * (-(∑ u, c u * y u)) = M - ∑ u, c u * x0 u + 1 := by
        rw [hr, div_mul_cancel₀]; linarith
      change _ ≤ M at h1
      linarith


lemma chm_sep {V : Type*} [Fintype V] (S : Finset (V → ℝ)) (x : V → ℝ)
    (hx : x ∉ convexHull ℝ (S : Set (V → ℝ))) :
    ∃ c : V → ℝ, ∀ s ∈ S, ∑ u, c u * s u < ∑ u, c u * x u := by
  obtain ⟨f, r, hf, hr⟩ := geometric_hahn_banach_closed_point (convex_convexHull ℝ _)
    (S.finite_toSet.isClosed_convexHull (𝕜 := ℝ)) hx
  refine ⟨fun u => f (fun j => if u = j then 1 else 0), fun s hs => ?_⟩
  have key : ∀ y : V → ℝ, f y = ∑ u, f (fun j => if u = j then 1 else 0) * y u := by
    intro y
    have := f.toLinearMap.pi_apply_eq_sum_univ y
    simpa [smul_eq_mul, mul_comm] using this
  rw [← key, ← key]
  exact (hf s (subset_convexHull ℝ _ hs)).trans hr

lemma chm_int {V : Type*} [Fintype V] (S : Finset (V → ℝ)) (x : V → ℝ) (c : V → ℝ)
    (hc : ∀ s ∈ S, ∑ u, c u * s u < ∑ u, c u * x u) :
    ∃ k : V → ℤ, ∀ s ∈ S, ∑ u, (k u : ℝ) * s u < ∑ u, (k u : ℝ) * x u := by
  set B : ℝ := ∑ u, |x u| + ∑ s ∈ S, ∑ u, |s u| with hB
  have hB0 : 0 ≤ B := by positivity
  obtain ⟨N, hN⟩ := exists_nat_gt (∑ s ∈ S, B / (∑ u, c u * x u - ∑ u, c u * s u))
  refine ⟨fun u => ⌊(N : ℝ) * c u⌋, fun s hs => ?_⟩
  have hδ : 0 < ∑ u, c u * x u - ∑ u, c u * s u := by linarith [hc s hs]
  have hNs : B / (∑ u, c u * x u - ∑ u, c u * s u) < N := by
    refine lt_of_le_of_lt ?_ hN
    exact Finset.single_le_sum (f := fun s => B / (∑ u, c u * x u - ∑ u, c u * s u))
      (fun t ht => div_nonneg hB0 (by linarith [hc t ht])) hs
  rw [div_lt_iff₀ hδ] at hNs
  have hsB : ∑ u, |s u| ≤ ∑ s ∈ S, ∑ u, |s u| :=
    Finset.single_le_sum (f := fun s : V → ℝ => ∑ u, |s u|) (fun t _ => by positivity) hs
  have term : ∀ u, (N : ℝ) * c u * (x u - s u) - (|x u| + |s u|) ≤
      (⌊(N : ℝ) * c u⌋ : ℝ) * (x u - s u) := by
    intro u
    have h1 := Int.floor_le ((N : ℝ) * c u)
    have h2 := Int.lt_floor_add_one ((N : ℝ) * c u)
    have hx1 := le_abs_self (x u); have hx2 := neg_abs_le (x u)
    have hs1 := le_abs_self (s u); have hs2 := neg_abs_le (s u)
    rcases le_total 0 (x u - s u) with h | h
    · nlinarith
    · nlinarith
  have hsum := Finset.sum_le_sum (fun u (_ : u ∈ Finset.univ) => term u)
  rw [Finset.sum_sub_distrib] at hsum
  have e1 : ∑ u, (N : ℝ) * c u * (x u - s u) =
      (N : ℝ) * (∑ u, c u * x u - ∑ u, c u * s u) := by
    rw [mul_sub, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl; intro u _; ring
  have e2 : ∑ u, (⌊(N : ℝ) * c u⌋ : ℝ) * (x u - s u) =
      ∑ u, (⌊(N : ℝ) * c u⌋ : ℝ) * x u - ∑ u, (⌊(N : ℝ) * c u⌋ : ℝ) * s u := by
    rw [← Finset.sum_sub_distrib]; apply Finset.sum_congr rfl; intro u _; ring
  rw [e1, e2, Finset.sum_add_distrib] at hsum
  show ∑ u, (⌊(N : ℝ) * c u⌋ : ℝ) * s u < ∑ u, (⌊(N : ℝ) * c u⌋ : ℝ) * x u
  linarith

lemma chm_poly_convex {V J : Type*} [Fintype V] [Fintype J] (a : J → V → ℝ) (b : J → ℝ) :
    Convex ℝ {x : V → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i} := by
  intro y hy z hz s t hs ht hst
  refine ⟨fun u => ?_, fun i => ?_⟩
  · simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    have := hy.1 u; have := hz.1 u; positivity
  · simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, mul_add, Finset.sum_add_distrib]
    have e1 : ∑ u, a i u * (s * y u) = s * ∑ u, a i u * y u := by
      rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro u _; ring
    have e2 : ∑ u, a i u * (t * z u) = t * ∑ u, a i u * z u := by
      rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro u _; ring
    rw [e1, e2]
    have := mul_le_mul_of_nonneg_left (hy.2 i) hs
    have := mul_le_mul_of_nonneg_left (hz.2 i) ht
    have : b i = s * b i + t * b i := by rw [← add_mul, hst, one_mul]
    linarith

lemma chm_rev {V : Type*} [Fintype V] {J : Type*} [Fintype J]
    (a : J → V → ℝ) (b : J → ℝ) (S : Finset (V → ℝ)) (hS : S.Nonempty)
    (hSsol : ∀ x ∈ S, (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i)
    (h : ∀ c : V → ℤ, ∃ lam : J → ℝ, (∀ i, 0 ≤ lam i) ∧ (∀ u, (c u : ℝ) ≤ ∑ i, lam i * a i u) ∧
          ∑ i, lam i * b i ≤ S.sup' hS (fun x => ∑ u, (c u : ℝ) * x u)) :
    {x : V → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i} = convexHull ℝ (S : Set (V → ℝ)) := by
  apply Set.Subset.antisymm
  · intro x hx
    by_contra hnot
    obtain ⟨c, hc⟩ := chm_sep S x hnot
    obtain ⟨k, hk⟩ := chm_int S x c hc
    obtain ⟨lam, hl0, hl, hlb⟩ := h k
    have h1 := chm_weak a b (fun u => (k u : ℝ)) x hx.1 hx.2 lam hl0 hl
    have h2 : S.sup' hS (fun x => ∑ u, (k u : ℝ) * x u) < ∑ u, (k u : ℝ) * x u :=
      (Finset.sup'_lt_iff hS).2 hk
    linarith
  · exact convexHull_min (fun y hy => hSsol y (Finset.mem_coe.1 hy)) (chm_poly_convex a b)

open ChvatalPolytopes.Shared

noncomputable def svF {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) :
    Finset (V → ℝ) :=
  (Finset.univ.filter (fun s : Finset V => G.IsIndepSet (s : Set V))).image incidenceVector

lemma svF_coe {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) :
    (svF G : Set (V → ℝ)) = stableVectors G := by
  ext x
  simp only [svF, Finset.coe_image, Finset.coe_filter, Finset.mem_univ, true_and,
    Set.mem_image, Set.mem_setOf_eq, stableVectors]
  constructor
  · rintro ⟨s, hs, rfl⟩; exact ⟨s, hs, rfl⟩
  · rintro ⟨s, hs, rfl⟩; exact ⟨s, hs, rfl⟩

lemma mem_svF {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (x : V → ℝ) :
    x ∈ svF G ↔ x ∈ stableVectors G := by
  rw [← Finset.mem_coe, svF_coe]

lemma sv_of_01 {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (y : V → ℝ)
    (h01 : ∀ p, y p = 0 ∨ y p = 1) (hadj : ∀ p q, y p = 1 → y q = 1 → ¬ G.Adj p q) :
    y ∈ stableVectors G := by
  refine ⟨Finset.univ.filter (fun p => y p = 1), ?_, ?_⟩
  · intro p hp q hq _
    simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hp hq
    exact hadj p q hp hq
  · funext p
    simp only [incidenceVector, Finset.mem_filter, Finset.mem_univ, true_and]
    rcases h01 p with h | h <;> simp [h]

lemma sv_01 {V : Type*} [DecidableEq V] (G : SimpleGraph V) (y : V → ℝ)
    (hy : y ∈ stableVectors G) :
    (∀ p, y p = 0 ∨ y p = 1) ∧ ∀ p q, y p = 1 → y q = 1 → ¬ G.Adj p q := by
  obtain ⟨s, hs, rfl⟩ := hy
  constructor
  · intro p; simp only [incidenceVector]; split_ifs <;> simp
  · intro p q hp hq hadj
    have h1 : p ∈ s := by by_contra h; simp [incidenceVector, h] at hp
    have h2 : q ∈ s := by by_contra h; simp [incidenceVector, h] at hq
    exact hs h1 h2 (G.ne_of_adj hadj) hadj

lemma ite_eq_one {P : Prop} [Decidable P] {t : ℝ} (h : (if P then t else 0) = 1) : t = 1 := by
  split_ifs at h
  · exact h
  · norm_num at h

lemma sum_split_dite {V₁ : Type*} [Fintype V₁] [DecidableEq V₁] (v : V₁) (f : V₁ → ℝ) (t : ℝ)
    (g : {u : V₁ // u ≠ v} → ℝ) :
    ∑ u, f u * (if h : u = v then t else g ⟨u, h⟩) = f v * t + ∑ w : {u : V₁ // u ≠ v}, f w * g w := by
  rw [Fintype.sum_eq_add_sum_subtype_ne _ v, dif_pos rfl]
  congr 1
  apply Finset.sum_congr rfl; intro w _
  rw [dif_neg w.2]

lemma sv_zero {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) :
    (0 : V → ℝ) ∈ stableVectors G :=
  sv_of_01 G 0 (fun _ => Or.inl rfl) (fun p q hp => by simp at hp)

lemma sv_single {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (w : V) :
    (fun p => if p = w then (1 : ℝ) else 0) ∈ stableVectors G := by
  apply sv_of_01
  · intro p; split_ifs <;> simp
  · intro p q hp hq hadj
    simp only [ite_eq_left_iff, zero_ne_one, imp_false, not_not] at hp hq
    subst hp hq; exact G.loopless.irrefl _ hadj

lemma svF_ne {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) : (svF G).Nonempty :=
  ⟨0, (mem_svF G 0).2 (sv_zero G)⟩

lemma sub_dual {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) {J : Type*} [Fintype J]
    (a : J → V → ℝ) (b : J → ℝ)
    (h : {x : V → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i} = stablePolytope G)
    (c : V → ℝ) :
    ∃ lam : J → ℝ, (∀ i, 0 ≤ lam i) ∧ (∀ u, c u ≤ ∑ i, lam i * a i u) ∧
      ∑ i, lam i * b i ≤ (svF G).sup' (svF_ne G) (fun x => ∑ u, c u * x u) := by
  apply chm_dual a b (svF G) (svF_ne G)
  rw [h, stablePolytope, svF_coe]

lemma sub_weak {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) {J : Type*} [Fintype J]
    (a : J → V → ℝ) (b : J → ℝ)
    (h : {x : V → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i} = stablePolytope G)
    (y : V → ℝ) (hy : y ∈ stableVectors G) :
    (∀ u, 0 ≤ y u) ∧ ∀ i, ∑ u, a i u * y u ≤ b i := by
  have : y ∈ stablePolytope G := subset_convexHull ℝ _ hy
  rw [← h] at this; exact this

lemma sub_le_sup {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (f : (V → ℝ) → ℝ)
    (y : V → ℝ) (hy : y ∈ stableVectors G) : f y ≤ (svF G).sup' (svF_ne G) f :=
  Finset.le_sup' f ((mem_svF G y).2 hy)

lemma sub_sup_le {V : Type*} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (f : (V → ℝ) → ℝ)
    (M : ℝ) (h : ∀ y ∈ stableVectors G, f y ≤ M) : (svF G).sup' (svF_ne G) f ≤ M :=
  Finset.sup'_le _ _ (fun y hy => h y ((mem_svF G y).1 hy))

lemma mu_exists {V₂ : Type*} [Fintype V₂] [DecidableEq V₂] [Nonempty V₂] (G₂ : SimpleGraph V₂)
    {J₂ : Type*} [Fintype J₂] (a₂ : J₂ → V₂ → ℝ) (b₂ : J₂ → ℝ)
    (h₂ : {x : V₂ → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ j, ∑ u, a₂ j u * x u ≤ b₂ j} = stablePolytope G₂)
    (e : V₂ → ℝ) (he : ∀ u, 0 ≤ e u) :
    ∃ μ : J₂ → ℝ, (∀ j, 0 ≤ μ j) ∧ ∑ j, μ j * b₂ j = 1 ∧
      ∀ u, 0 ≤ ∑ j, μ j * a₂ j u ∧
        e u ≤ (svF G₂).sup' (svF_ne G₂) (fun x => ∑ u, e u * x u) * ∑ j, μ j * a₂ j u := by
  set m₂ := (svF G₂).sup' (svF_ne G₂) (fun x => ∑ u, e u * x u) with hm₂
  have hm0 : 0 ≤ m₂ := by
    have := sub_le_sup G₂ (fun x => ∑ u, e u * x u) 0 (sv_zero G₂)
    simp only [Pi.zero_apply, mul_zero, Finset.sum_const_zero] at this
    exact this
  have hsingle : ∀ w, ∑ u, e u * (fun p => if p = w then (1 : ℝ) else 0) u = e w := by
    intro w; simp
  have hle : ∀ w, e w ≤ m₂ := by
    intro w
    have := sub_le_sup G₂ (fun x => ∑ u, e u * x u) _ (sv_single G₂ w)
    rwa [hsingle] at this
  rcases hm0.lt_or_eq with hpos | hzero
  · obtain ⟨lam, hl0, hl, hlb⟩ := sub_dual G₂ a₂ b₂ h₂ e
    obtain ⟨y, hy, hyeq⟩ := Finset.exists_mem_eq_sup' (svF_ne G₂) (fun x => ∑ u, e u * x u)
    have hy' := (mem_svF G₂ y).1 hy
    have hyP := sub_weak G₂ a₂ b₂ h₂ y hy'
    have hw := chm_weak a₂ b₂ e y hyP.1 hyP.2 lam hl0 hl
    have heq : ∑ j, lam j * b₂ j = m₂ := le_antisymm hlb (by rw [hm₂, hyeq]; exact hw)
    refine ⟨fun j => lam j / m₂, fun j => div_nonneg (hl0 j) hpos.le, ?_, fun u => ?_⟩
    · simp only [div_mul_eq_mul_div, ← Finset.sum_div, heq, div_self hpos.ne']
    · have e1 : ∑ j, lam j / m₂ * a₂ j u = (∑ j, lam j * a₂ j u) / m₂ := by
        rw [Finset.sum_div]; apply Finset.sum_congr rfl; intro j _; ring
      rw [e1, mul_div_cancel₀ _ hpos.ne']
      exact ⟨div_nonneg ((he u).trans (hl u)) hpos.le, hl u⟩
  · obtain ⟨w₀⟩ := (inferInstance : Nonempty V₂)
    set ind : V₂ → ℝ := fun p => if p = w₀ then (1 : ℝ) else 0 with hind
    obtain ⟨μ, hμ0, hμ, hμb⟩ := sub_dual G₂ a₂ b₂ h₂ ind
    have hwk := sub_weak G₂ a₂ b₂ h₂ ind (sv_single G₂ w₀)
    have h1 := chm_weak a₂ b₂ ind ind hwk.1 hwk.2 μ hμ0 hμ
    have hii : ∑ u, ind u * ind u = 1 := by simp [hind]
    have h2 : (svF G₂).sup' (svF_ne G₂) (fun x => ∑ u, ind u * x u) ≤ 1 := by
      apply sub_sup_le
      intro y hy
      have : ∑ u, ind u * y u = y w₀ := by simp [hind]
      rw [this]
      rcases (sv_01 G₂ y hy).1 w₀ with h | h <;> rw [h] <;> norm_num
    refine ⟨μ, hμ0, by linarith, fun u => ⟨?_, ?_⟩⟩
    · have := hμ u
      have : 0 ≤ ind u := by simp only [hind]; split_ifs <;> norm_num
      linarith
    · rw [← hzero, zero_mul]; have := hle u; linarith

lemma sum_split {V₁ : Type*} [Fintype V₁] [DecidableEq V₁] (v : V₁) (f : V₁ → ℝ) :
    ∑ u, f u = f v + ∑ w : {u : V₁ // u ≠ v}, f w :=
  Fintype.sum_eq_add_sum_subtype_ne f v

/-- the system (5.1) as a matrix -/
def sysA {V₁ V₂ J₁ J₂ : Type*} (a₁ : J₁ → V₁ → ℝ) (b₂ : J₂ → ℝ) (a₂ : J₂ → V₂ → ℝ) (v : V₁) :
    J₁ × J₂ → {u : V₁ // u ≠ v} ⊕ V₂ → ℝ :=
  fun p => Sum.elim (fun w => b₂ p.2 * a₁ p.1 w) (fun u => max (a₁ p.1 v) 0 * a₂ p.2 u)

lemma sysA_sum {V₁ V₂ J₁ J₂ : Type*} [Fintype V₁] [DecidableEq V₁] [Fintype V₂] (a₁ : J₁ → V₁ → ℝ) (b₂ : J₂ → ℝ)
    (a₂ : J₂ → V₂ → ℝ) (v : V₁) (i : J₁) (j : J₂) (x : {u : V₁ // u ≠ v} ⊕ V₂ → ℝ) :
    ∑ z, sysA a₁ b₂ a₂ v (i, j) z * x z =
      max (a₁ i v) 0 * ∑ u : V₂, a₂ j u * x (.inr u)
          + b₂ j * ∑ w : {u : V₁ // u ≠ v}, a₁ i w * x (.inl w) := by
  rw [Fintype.sum_sum_type, add_comm, Finset.mul_sum, Finset.mul_sum]
  simp only [sysA, Sum.elim_inl, Sum.elim_inr]
  congr 1 <;> apply Finset.sum_congr rfl <;> intro u _ <;> ring

lemma valid_core {V₁ V₂ : Type*} [Fintype V₁] [DecidableEq V₁]
    [Fintype V₂] [DecidableEq V₂] (G₁ : SimpleGraph V₁) (G₂ : SimpleGraph V₂)
    {J₁ J₂ : Type*} [Fintype J₁] [Fintype J₂]
    (a₁ : J₁ → V₁ → ℝ) (b₁ : J₁ → ℝ) (a₂ : J₂ → V₂ → ℝ) (b₂ : J₂ → ℝ)
    (h₁ : {x : V₁ → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a₁ i u * x u ≤ b₁ i} = stablePolytope G₁)
    (h₂ : {x : V₂ → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ j, ∑ u, a₂ j u * x u ≤ b₂ j} = stablePolytope G₂)
    (v : V₁) :
    ∀ x ∈ stableVectors (substitute G₁ v G₂),
      (∀ u, 0 ≤ x u) ∧
      ∀ i j, max (a₁ i v) 0 * ∑ u : V₂, a₂ j u * x (.inr u)
          + b₂ j * ∑ w : {u : V₁ // u ≠ v}, a₁ i w * x (.inl w) ≤ b₁ i * b₂ j := by
  intro x hx
  obtain ⟨h01, hadj⟩ := sv_01 _ x hx
  refine ⟨fun u => by rcases h01 u with h | h <;> rw [h] <;> norm_num, fun i j => ?_⟩
  -- G₂ part
  have hz : (fun u => x (.inr u)) ∈ stableVectors G₂ :=
    sv_of_01 G₂ _ (fun p => h01 _) (fun p q hp hq => hadj _ _ hp hq)
  have hzP := sub_weak G₂ a₂ b₂ h₂ _ hz
  have hs₂ : ∑ u, a₂ j u * x (.inr u) ≤ b₂ j := hzP.2 j
  have hb₂ : 0 ≤ b₂ j := by
    have := (sub_weak G₂ a₂ b₂ h₂ 0 (sv_zero G₂)).2 j; simpa using this
  -- G₁ part without v
  set A := ∑ w : {u : V₁ // u ≠ v}, a₁ i w * x (.inl w) with hA
  have hy0 : (fun u => if h : u = v then (0 : ℝ) else x (.inl ⟨u, h⟩)) ∈ stableVectors G₁ := by
    apply sv_of_01
    · intro p; split_ifs
      · exact Or.inl rfl
      · exact h01 _
    · intro p q hp hq
      have h1 : p ≠ v := by rintro rfl; simp at hp
      have h2 : q ≠ v := by rintro rfl; simp at hq
      rw [dif_neg h1] at hp; rw [dif_neg h2] at hq
      exact hadj _ _ hp hq
  have hA1 : A ≤ b₁ i := by
    have := (sub_weak G₁ a₁ b₁ h₁ _ hy0).2 i
    rw [sum_split_dite v (a₁ i) 0 (fun w => x (.inl w))] at this
    simpa [hA] using this
  by_cases hex : ∃ u, x (.inr u) = 1
  · obtain ⟨u₀, hu₀⟩ := hex
    have hy1 : (fun u => if h : u = v then (1 : ℝ) else x (.inl ⟨u, h⟩)) ∈ stableVectors G₁ := by
      apply sv_of_01
      · intro p; split_ifs
        · exact Or.inr rfl
        · exact h01 _
      · intro p q hp hq hpq
        by_cases h1 : p = v
        · subst h1
          have h2 : q ≠ p := fun e => G₁.loopless.irrefl _ (e ▸ hpq)
          simp only [h2, dite_false] at hq
          exact hadj _ _ hq hu₀ (show G₁.Adj q p from G₁.adj_symm hpq)
        · by_cases h2 : q = v
          · subst h2
            simp only [h1, dite_false] at hp
            exact hadj _ _ hp hu₀ (show G₁.Adj p q from hpq)
          · simp only [h1, h2, dite_false] at hp hq
            exact hadj _ _ hp hq hpq
    have hA2 : a₁ i v + A ≤ b₁ i := by
      have := (sub_weak G₁ a₁ b₁ h₁ _ hy1).2 i
      rw [sum_split_dite v (a₁ i) 1 (fun w => x (.inl w))] at this
      simpa [hA] using this
    rcases le_total 0 (a₁ i v) with hv | hv
    · rw [max_eq_left hv]
      have := mul_le_mul_of_nonneg_left hs₂ hv
      have := mul_le_mul_of_nonneg_left hA2 hb₂
      nlinarith
    · rw [max_eq_right hv, zero_mul, zero_add, mul_comm (b₁ i)]
      exact mul_le_mul_of_nonneg_left hA1 hb₂
  · push_neg at hex
    have h0 : ∀ u, x (.inr u) = 0 := fun u => (h01 _).resolve_right (hex u)
    simp only [h0, mul_zero, Finset.sum_const_zero, zero_add]
    rw [mul_comm (b₁ i)]
    exact mul_le_mul_of_nonneg_left hA1 hb₂

theorem defining_core {V₁ V₂ : Type*} [Fintype V₁] [DecidableEq V₁]
    [Fintype V₂] [DecidableEq V₂] [Nonempty V₂] (G₁ : SimpleGraph V₁) (G₂ : SimpleGraph V₂)
    {J₁ J₂ : Type*} [Fintype J₁] [Fintype J₂]
    (a₁ : J₁ → V₁ → ℝ) (b₁ : J₁ → ℝ) (a₂ : J₂ → V₂ → ℝ) (b₂ : J₂ → ℝ)
    (h₁ : {x : V₁ → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a₁ i u * x u ≤ b₁ i} = stablePolytope G₁)
    (h₂ : {x : V₂ → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ j, ∑ u, a₂ j u * x u ≤ b₂ j} = stablePolytope G₂)
    (v : V₁) :
    {x : {u : V₁ // u ≠ v} ⊕ V₂ → ℝ |
        (∀ u, 0 ≤ x u) ∧
        ∀ i j, max (a₁ i v) 0 * ∑ u : V₂, a₂ j u * x (.inr u)
          + b₂ j * ∑ w : {u : V₁ // u ≠ v}, a₁ i w * x (.inl w) ≤ b₁ i * b₂ j} =
      stablePolytope (substitute G₁ v G₂) := by
  set G := substitute G₁ v G₂ with hG
  set A := sysA a₁ b₂ a₂ v
  set B : J₁ × J₂ → ℝ := fun p => b₁ p.1 * b₂ p.2
  have hset : {x : {u : V₁ // u ≠ v} ⊕ V₂ → ℝ |
        (∀ u, 0 ≤ x u) ∧
        ∀ i j, max (a₁ i v) 0 * ∑ u : V₂, a₂ j u * x (.inr u)
          + b₂ j * ∑ w : {u : V₁ // u ≠ v}, a₁ i w * x (.inl w) ≤ b₁ i * b₂ j} =
      {x | (∀ u, 0 ≤ x u) ∧ ∀ p, ∑ z, A p z * x z ≤ B p} := by
    ext x
    simp only [Set.mem_setOf_eq, Prod.forall, A, B, sysA_sum]
  rw [hset, stablePolytope, ← svF_coe]
  apply chm_rev A B (svF G) (svF_ne G)
  · intro x hx
    obtain ⟨h0, h⟩ := valid_core G₁ G₂ a₁ b₁ a₂ b₂ h₁ h₂ v x ((mem_svF G x).1 hx)
    refine ⟨h0, fun p => ?_⟩
    simp only [A, B, sysA_sum]
    exact h p.1 p.2
  intro c
  set cr : {u : V₁ // u ≠ v} ⊕ V₂ → ℝ := fun z => (c z : ℝ) with hcr
  set d : {u : V₁ // u ≠ v} ⊕ V₂ → ℝ := fun z => max (cr z) 0 with hd
  set e : V₂ → ℝ := fun u => d (.inr u) with he
  set m₂ := (svF G₂).sup' (svF_ne G₂) (fun x => ∑ u, e u * x u) with hm₂
  obtain ⟨y₂, hy₂, hy₂eq⟩ := Finset.exists_mem_eq_sup' (svF_ne G₂) (fun x => ∑ u, e u * x u)
  have hy₂' := (mem_svF G₂ y₂).1 hy₂
  obtain ⟨μ, hμ0, hμb, hμa⟩ := mu_exists G₂ a₂ b₂ h₂ e (fun u => le_max_right _ _)
  set c₁ : V₁ → ℝ := fun u => if h : u = v then m₂ else d (.inl ⟨u, h⟩) with hc₁
  obtain ⟨l₁, hl0, hl, hlb⟩ := sub_dual G₁ a₁ b₁ h₁ c₁
  refine ⟨fun p => l₁ p.1 * μ p.2, fun p => mul_nonneg (hl0 _) (hμ0 _), ?_, ?_⟩
  · rintro (w | u)
    · have e1 : ∑ p : J₁ × J₂, l₁ p.1 * μ p.2 * A p (.inl w) =
          (∑ i, l₁ i * a₁ i w) * (∑ j, μ j * b₂ j) := by
        rw [Fintype.sum_prod_type, Finset.sum_mul_sum]
        apply Finset.sum_congr rfl; intro i _; apply Finset.sum_congr rfl; intro j _
        simp only [A, sysA, Sum.elim_inl]; ring
      rw [e1, hμb, mul_one]
      have := hl w.1
      have hcw : c₁ w.1 = d (.inl w) := by simp [hc₁, w.2]
      rw [hcw] at this
      exact (le_max_left _ _).trans this
    · have e1 : ∑ p : J₁ × J₂, l₁ p.1 * μ p.2 * A p (.inr u) =
          (∑ i, l₁ i * max (a₁ i v) 0) * (∑ j, μ j * a₂ j u) := by
        rw [Fintype.sum_prod_type, Finset.sum_mul_sum]
        apply Finset.sum_congr rfl; intro i _; apply Finset.sum_congr rfl; intro j _
        simp only [A, sysA, Sum.elim_inr]; ring
      rw [e1]
      have hP : m₂ ≤ ∑ i, l₁ i * max (a₁ i v) 0 := by
        have := hl v
        simp only [hc₁, dite_true] at this
        refine this.trans (Finset.sum_le_sum fun i _ => ?_)
        exact mul_le_mul_of_nonneg_left (le_max_left _ _) (hl0 i)
      obtain ⟨hQ, hmQ⟩ := hμa u
      have h3 : cr (.inr u) ≤ e u := le_max_left _ _
      have := mul_le_mul_of_nonneg_right hP hQ
      linarith
  · have e1 : ∑ p : J₁ × J₂, l₁ p.1 * μ p.2 * B p = (∑ i, l₁ i * b₁ i) * (∑ j, μ j * b₂ j) := by
      rw [Fintype.sum_prod_type, Finset.sum_mul_sum]
      apply Finset.sum_congr rfl; intro i _; apply Finset.sum_congr rfl; intro j _
      simp only [B]; ring
    rw [e1, hμb, mul_one]
    refine hlb.trans (sub_sup_le G₁ _ _ fun y hy => ?_)
    obtain ⟨y01, yadj⟩ := sv_01 G₁ y hy
    obtain ⟨z01, zadj⟩ := sv_01 G₂ y₂ hy₂'
    set x : {u : V₁ // u ≠ v} ⊕ V₂ → ℝ := Sum.elim
      (fun w => if 0 < cr (.inl w) then y w.1 else 0)
      (fun u => if 0 < cr (.inr u) then y v * y₂ u else 0) with hx
    have hyv1 : ∀ u, y v * y₂ u = 1 → y v = 1 ∧ y₂ u = 1 := by
      intro u h
      rcases y01 v with h1 | h1 <;> rcases z01 u with h2 | h2 <;> rw [h1, h2] at h <;>
        norm_num at h
      exact ⟨h1, h2⟩
    have hxs : x ∈ stableVectors G := by
      apply sv_of_01
      · rintro (w | u)
        · simp only [hx, Sum.elim_inl]; split_ifs
          · exact y01 _
          · exact Or.inl rfl
        · simp only [hx, Sum.elim_inr]; split_ifs
          · rcases y01 v with h1 | h1 <;> rcases z01 u with h2 | h2 <;> simp [h1, h2]
          · exact Or.inl rfl
      · rintro (p | p) (q | q) hp hq hpq
        · exact yadj _ _ (ite_eq_one hp) (ite_eq_one hq) hpq
        · exact yadj _ _ (ite_eq_one hp) (hyv1 _ (ite_eq_one hq)).1 hpq
        · exact yadj _ _ (ite_eq_one hq) (hyv1 _ (ite_eq_one hp)).1 hpq
        · exact zadj _ _ (hyv1 _ (ite_eq_one hp)).2 (hyv1 _ (ite_eq_one hq)).2 hpq
    have hc₁v : c₁ v = m₂ := by simp only [hc₁, dite_true]
    have hc₁w : ∀ w : {u : V₁ // u ≠ v}, c₁ w = d (.inl w) := by
      intro w; simp only [hc₁]; rw [dif_neg w.2]
    have hval : ∑ u, c₁ u * y u = ∑ z, cr z * x z := by
      rw [sum_split v, Fintype.sum_sum_type]
      have t1 : ∀ w : {u : V₁ // u ≠ v}, cr (.inl w) * x (.inl w) = c₁ w * y w := by
        intro w
        rw [hc₁w]
        show cr (.inl w) * (if 0 < cr (.inl w) then y w.1 else 0) = max (cr (.inl w)) 0 * y w
        split_ifs with h
        · rw [max_eq_left h.le]
        · rw [max_eq_right (not_lt.1 h)]; ring
      have t2 : ∀ u, cr (.inr u) * x (.inr u) = y v * (e u * y₂ u) := by
        intro u
        show cr (.inr u) * (if 0 < cr (.inr u) then y v * y₂ u else 0) =
          y v * (max (cr (.inr u)) 0 * y₂ u)
        split_ifs with h
        · rw [max_eq_left h.le]; ring
        · rw [max_eq_right (not_lt.1 h)]; ring
      rw [Finset.sum_congr rfl (fun w _ => t1 w), Finset.sum_congr rfl (fun u _ => t2 u),
        ← Finset.mul_sum, hc₁v]
      have : ∑ u, e u * y₂ u = m₂ := by rw [hm₂, hy₂eq]
      rw [this]; ring
    rw [hval]
    exact sub_le_sup G (fun x => ∑ u, cr u * x u) x hxs

end ChvatalPolytopes.Substitution

open ChvatalPolytopes.Substitution
open ChvatalPolytopes ChvatalPolytopes.Substitution

theorem solution {V₁ V₂ : Type*} [Fintype V₁] [DecidableEq V₁]
    [Fintype V₂] [DecidableEq V₂] [Nonempty V₂] (G₁ : SimpleGraph V₁) (G₂ : SimpleGraph V₂)
    {J₁ J₂ : Type*} [Fintype J₁] [Fintype J₂]
    (a₁ : J₁ → V₁ → ℝ) (b₁ : J₁ → ℝ) (a₂ : J₂ → V₂ → ℝ) (b₂ : J₂ → ℝ)
    (h₁ : {x : V₁ → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a₁ i u * x u ≤ b₁ i} = Shared.stablePolytope G₁)
    (h₂ : {x : V₂ → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ j, ∑ u, a₂ j u * x u ≤ b₂ j} = Shared.stablePolytope G₂)
    (v : V₁) :
    {x : {u : V₁ // u ≠ v} ⊕ V₂ → ℝ |
        (∀ u, 0 ≤ x u) ∧
        ∀ i j, max (a₁ i v) 0 * ∑ u : V₂, a₂ j u * x (.inr u)
          + b₂ j * ∑ w : {u : V₁ // u ≠ v}, a₁ i w * x (.inl w) ≤ b₁ i * b₂ j} =
      Shared.stablePolytope (substitute G₁ v G₂) := by
  exact defining_core G₁ G₂ a₁ b₁ a₂ b₂ h₁ h₂ v
