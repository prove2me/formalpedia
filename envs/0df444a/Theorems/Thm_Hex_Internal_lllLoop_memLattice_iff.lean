theorem lllLoop_memLattice_iff (s : LLLState n m) (k : Nat) (δ : Rat)
    (hδ : 1/4 < δ) (hδ' : δ ≤ 1) (hk : 1 ≤ k) (hkn : k ≤ n) (fuel : Nat)
    (v : Vector Int m) :
    Matrix.memLattice (lllLoop s k δ hδ hδ' hk hkn fuel) v ↔
      Matrix.memLattice s.b v := by sorry
