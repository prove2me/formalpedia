    decSt i (withCtr i s N k t) = withCtr i s N (k + 1) t := by
  have e : ((N : ℤ) - k - 1) = (N : ℤ) - (k + 1 : ℕ) := by push_cast; ring
  simp only [decSt, withCtr, IState.upd_upd_same, IState.top, IState.upd_G, if_true,
