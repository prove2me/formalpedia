theorem Rn.miT_sol_aux (hN : N ≤ 2 ^ W) (hW2 : 2 ≤ W) (hu : BV W u)
    (h1 : u 1 = c) (h2 : u 2 = n) (h3 : u 3 = uu) (h7 : u 7 = a) (h24 : u 24 = lam)
    (h26 : u 26 = w) (h9 : u 9 = 2 ^ Q) (h10 : u 10 = 2 ^ (Q + 1))
