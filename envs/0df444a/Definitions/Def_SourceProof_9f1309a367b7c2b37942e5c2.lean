/-!
# The natural filtration is generated by the counts on finite-intensity windows

The reference intensity is a product with a σ-finite mark measure, so a set of times at most `T`
splits into the null part at nonpositive times and a countable increasing union of sets inside
windows `(0, T] × A` with `ν A` finite. The counts on those windows are almost surely finite, so
their real parts generate the natural filtration modulo null sets, and the characters of those
real counts separate.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal Topology

namespace LevyStochCalc.Poisson

universe u v w

variable {Ω : Type u} [MeasurableSpace Ω] {E : Type v} [MeasurableSpace E]
  {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν]

section Window


theorem _root_.Prove2MeSourceProof.h_9f1309a367b7c2b37942e5c2 (N : PoissonRandomMeasure P ν) (T : ℝ)
    {Z : Ω → ℂ} (hZ : Integrable Z P)
    (hZm : AEStronglyMeasurable[Probability.aug (naturalFiltration N T) ‹MeasurableSpace Ω› P]
      Z P)
    (h : ∀ (F : Finset (WindowSet E ν T)) (w : F → ℝ),
      ∫ ω, Complex.exp
          ((∑ D : F, (N.N ω ((D : WindowSet E ν T) : Set (ℝ × E))).toReal * w D : ℝ)
            * Complex.I) * Z ω ∂P = 0) :
    Z =ᵐ[P] 0 := by
  obtain ⟨Z₁, hZ₁m, hZZ₁⟩ := hZm
  have hZ₁m' : StronglyMeasurable[LevyStochCalc.Probability.aug (LevyStochCalc.Poisson.windowSigma N T) ‹MeasurableSpace Ω› P] Z₁ :=
    hZ₁m.mono (LevyStochCalc.Probability.aug_le_of_le_aug (_root_.Prove2MeSourceProof.h_04375d3495819d57e1cd04a0 N T))
  obtain ⟨Y, hYm, hZ₁Y⟩ := LevyStochCalc.Probability.aestronglyMeasurable_of_stronglyMeasurable_aug hZ₁m'
  have hZY : Z =ᵐ[P] Y := hZZ₁.trans hZ₁Y
  refine hZY.trans (LevyStochCalc.Poisson.ae_eq_zero_of_integral_char_windowSigma N T (hZ.congr hZY) hYm ?_)
  intro F w
  rw [← h F w]
  refine integral_congr_ae ?_
  filter_upwards [hZY] with ω hω
  rw [hω]
end Window

end LevyStochCalc.Poisson


