variable (s t lam w : ℕ)

variable {s t lam w}

theorem drp_pred {j : ℕ} (hj : j < s) : drp s j = j :: drp s (j + 1) := by
  unfold drp
  rw [List.drop_eq_getElem_cons (by simp; exact hj)]
  simp

