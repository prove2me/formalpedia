section Den

variable {R : Type} [Fintype R] [DecidableEq R] {m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

namespace HStep

/-- With exact children a child step is the slot family on its wire. -/
theorem den_child_exact (w : R) (S neg : Finset (Fin m)) :
    (child w S neg : HStep R m).den (chEx (κ := κ)) = wireOp w (tensF (slotFam (κ := κ) S neg)) := by
  rw [den, signedOp_chEx]

/-- `ofR` preserves the exact denotation. -/
theorem den_ofR (st : RStep R m) :
    (ofR st).den (chEx (κ := κ)) = st.den (tens Cm : Op κ) := by
  cases st with
  | child w h fwd =>
    rw [ofR, den_child_exact]
    cases fwd
    · rw [den_child_false, slotOp_tens]
      congr 2; funext p; by_cases hp : p.1 = h <;> simp [slotFam, hp]
    · rw [den_child_true, slotOp_tens]
      congr 2; funext p; simp [slotFam]
  | gate G => rfl
  | rowAdd w i j hij => rfl
  | phase w k₀ k₁ a => rfl
  | perm σ => rfl

end HStep

/-- `ofR` on lists preserves the exact denotation. -/
theorem denListH_map_ofR (l : List (RStep R m)) :
    denListH (chEx (κ := κ)) (l.map HStep.ofR) = denListR (tens Cm : Op κ) l := by
  induction l using List.reverseRecOn with
  | nil => rfl
  | append_singleton l s ih =>
    rw [List.map_append, List.map_singleton, denListH_append, denListR_append, ih,
      denListH_single, HStep.den_ofR]
    simp [denListR]

end Den

