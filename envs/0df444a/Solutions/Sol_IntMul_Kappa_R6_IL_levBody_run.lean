    (eqv (W := W) (T := T)).symm ⟨k, h⟩ = Sum.inr ⟨k, hk⟩ := by
  rw [Equiv.symm_apply_eq]; ext; simp

lemma eqv_symm_ge (w : Fin W) (h : T + (w : ℕ) < T + W) :
    (eqv (W := W) (T := T)).symm ⟨T + w, h⟩ = Sum.inl w := by
  rw [Equiv.symm_apply_eq]; ext; simp

/-- Zeros in front of the role streams: the initial wire table. -/
theorem init_tab {v : ℕ} (ins : Fin W → List (ZMod 2)) (hins : ∀ w, (ins w).length = v) :
    List.replicate (T * v) 0 ++ tabR 0 W (liftF [] fun w => enc2 (ins w)) =
      tabR 0 (T + W) (tabS (Bit.QHNet.initH (T := T) v ins)) := by
  rw [tabR_add 0 T W, tabR_shift _ W (0 + T)]
  congr 1
  · rw [tabR_congr 0 T (G := fun _ => List.replicate v (0 : ℤ)) (fun k _ hk => ?_), tabR_zeros]
    simp only [Nat.zero_add] at hk
    simp only [tabS, liftF, dif_pos (show k < T + W by omega), eqv_symm_lt hk,
      Bit.QHNet.initH, enc2_replicate]
  · apply tabR_congr
    intro k _ hk
    simp only [Nat.zero_add] at hk
    simp only [tabS, liftF, dif_pos (show 0 + T + k < T + W by omega), dif_pos hk]
    rw [show (⟨0 + T + k, by omega⟩ : Fin (T + W)) = ⟨T + (⟨k, hk⟩ : Fin W), by simp; omega⟩ by
      ext; simp, eqv_symm_ge]
    rfl

/-- After the routing, the role streams (behind the temporaries) in merge order. -/
theorem route_tab {v : ℕ} (ρ : Fin W → Fin W) (st : Fin W ⊕ Fin T → List (ZMod 2))
    (hst : ∀ x, (st x).length = v) :
    tabR T W (fun k => sumS (tabS st) v (srcR T ρ k)) =
      (List.finRange W).flatMap fun w => enc2 (st (Sum.inl (ρ w))) := by
  rw [flatMap_finRange_tabR, tabR_shift _ W T]
  apply tabR_congr
  intro k _ hk
  simp only [Nat.zero_add] at hk
  have h1 : ¬ T + k < T := by omega
  have h2 : T + k - T < W := by omega
  simp only [srcR, if_neg h1, dif_pos h2]
  have hk' : (⟨T + k - T, h2⟩ : Fin W) = ⟨k, hk⟩ := by ext; simp
  rw [hk', sumS_single (uni_tabS hst) (by have := (ρ ⟨k, hk⟩).2; omega)]
  simp only [tabS, liftF, dif_pos (show T + (ρ ⟨k, hk⟩ : ℕ) < T + W by have := (ρ ⟨k, hk⟩).2; omega),
    dif_pos hk, eqv_symm_ge]

/-- Lengths along a run, when the edges of the program preserve them. -/
theorem netRunH_len {Wr R : Type*} [Fintype Wr] [DecidableEq Wr] [CommRing R] {m : ℕ} (n : ℕ)
    (impl : Bit.Edge m → List R → List R) :
    ∀ (prog : List (Bit.Instr Wr R m)),
      (∀ e ∈ Bit.progEdges prog, ∀ ys : List R, ys.length = n → (impl e ys).length = n) →
      ∀ st : Wr → List R, (∀ x, (st x).length = n) →
        ∀ x, (Bit.netRunH n impl prog st x).length = n
  | [], _, st, hst => hst
  | i :: l, hE, st, hst => by
    have hE' : ∀ e ∈ Bit.progEdges l, _ := fun e he =>
      hE e (by rw [Bit.progEdges_cons]; exact List.mem_append_right _ he)
    have h1 : ∀ x, (Bit.instrRun n impl st i x).length = n := by
      cases i with
      | gate g S =>
        intro x
        simp only [Bit.instrRun, Bit.gateApply]
        split_ifs
        · simp
        · exact hst x
      | edge w e =>
        have he : e ∈ Bit.progEdges (Bit.Instr.edge w e :: l) := by
          rw [Bit.progEdges_cons]; simp [Bit.Instr.edgeOf]
        intro x
        simp only [Bit.instrRun]
        by_cases hx : x = w
        · subst hx; rw [Function.update_self]; exact hE e he _ (hst x)
        · rw [Function.update_of_ne hx]; exact hst x
    simp only [Bit.netRunH, List.foldl_cons]
    exact netRunH_len n impl l hE' _ h1

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1}

theorem fok_zeroKE_gTV : fok (zeroKE 0 21 (.reg gTV)) = true := by decide
theorem fok_dropKE_gTV : fok (dropKE 0 21 (.reg gTV)) = true := by decide

set_option maxHeartbeats 1000000 in
/-- **One level body computes `levelH`.** -/
theorem levBody_run_sol_aux (C : Bit.QHNet (ZMod 2) W T m) {N : ℕ} [NeZero N] (hN : 1 < N)
    (P L' f : ℕ) (A B Cs : Shape) (hpos : ∀ a ∈ P :: L' :: hdShape A B Cs m N, 1 ≤ a) (Bb : ℕ)
    (hTOK : ∀ e ∈ C.edges, ∀ T' ∈ tplE e.E₁ ++ tplE e.E₂, TOK T' N Bb)
    (hcop : ∀ e ∈ C.edges, ∀ i j, Nat.Coprime (e.E₁ i j).den N ∧ Nat.Coprime (e.E₂ i j).den N)
    (hVT : zsz (((T + W) * vol (P :: L' :: hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * N : ℕ) : ℤ) ≤ Bb)
    (G0 : Fin HS → List Item) (hG : LevH G0 m W T N P L' f A B Cs)
    (child : ℕ × ℕ × ℕ → List (ZMod 2) → List (ZMod 2)) (cC : ℕ × ℕ × ℕ → ℕ)
    (hcall : ∀ e ∈ C.edges, ∀ ρ ∈ e.runs, ∀ (t : IState HS) (R : List Item) (ys : List (ZMod 2)),
      Inv G0 t → ys.length = vol (P :: L' :: hdShape A B Cs m N) →
      IRuns I tab (callR (0 : Fin 1) m ρ) (t.upd 0 (ints (enc2 ys) ++ R))
        (t.upd 0 (ints (enc2 (child ρ ys)) ++ R)) (cC ρ) ∧
      (child ρ ys).length = vol (P :: L' :: hdShape A B Cs m N))
    (t : IState HS) (ht : Inv G0 t) (R : List Item) (xs : List (ZMod 2))
    (hxs : xs.length = vol (P :: W * L' :: hdShape A B Cs m N)) :
    IRuns I tab (levBody C) (t.upd 0 (ints (enc2 xs) ++ R))
      (t.upd 0 (ints (enc2 (Bit.levelH C N P L' A B Cs child xs)) ++ R))
      (cLevBody C P L' (vol (hdShape A B Cs m N)) (vol (P :: L' :: hdShape A B Cs m N)) Bb cC) := by
  set rest := hdShape A B Cs m N with hrest
  set v := vol (P :: L' :: rest) with hv
  set Λ := (hdLayout A B Cs m N).cons2 P L' with hΛ
  have hW1 : 1 ≤ W := NeZero.pos W
  have hP1 : 1 ≤ P := hpos P List.mem_cons_self
  have hL1 : 1 ≤ L' := hpos L' (List.mem_cons_of_mem _ List.mem_cons_self)
  have hr1 : 1 ≤ vol rest := vol_pos_of (fun a ha =>
    hpos a (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ ha)))
  have hvexp : v = P * L' * vol rest := by simp only [hv, vol_cons]; ring
  have hv1 : 1 ≤ v := by rw [hvexp]; exact Nat.mul_pos (Nat.mul_pos hP1 hL1) hr1
  have hle : ∀ k : ℕ, k ≤ (T + W) * v → zsz (k : ℤ) ≤ Bb := fun k hk =>
    le_trans (zsz_natCast_le' hk) hVT
  have hvT : v ≤ (T + W) * v := Nat.le_mul_of_pos_left v (by omega)
  have hWv : W ≤ (T + W) * v := le_trans (Nat.le_add_left W T) (Nat.le_mul_of_pos_right _ hv1)
  have hTv : T * v ≤ (T + W) * v := Nat.mul_le_mul_right v (Nat.le_add_right T W)
  have hB1 : 1 ≤ Bb := le_trans (by
    have := zsz_natCast_le' (show 1 ≤ 2 * N by omega)
    simpa [zsz_one] using this) hQ2
  have zW : zsz (W : ℤ) ≤ Bb := hle W hWv
  have zv : zsz ((P * L' * vol rest : ℕ) : ℤ) ≤ Bb := by rw [← hvexp]; exact hle v hvT
  have hTab : TabB (T + W) v Bb :=
    ⟨le_trans (zsz_natCast_le' (by omega)) hQ2, hVT, by omega⟩
  -- registers
  obtain ⟨LP, tP⟩ := inv_reg ht (r := dP) (by decide) (by decide) hG.p
  obtain ⟨LL, tL⟩ := inv_reg ht (r := rLp) (by decide) (by decide) hG.lp
  obtain ⟨LV, tV⟩ := inv_reg ht (r := rV) (by decide) (by decide) hG.v
  obtain ⟨LWV, tWV⟩ := inv_reg ht (r := rWV) (by decide) (by decide) hG.wv
  obtain ⟨LTV, tTV⟩ := inv_reg ht (r := gTV) (by decide) (by decide) hG.tv
  have tV' : t.G rV = .int ((P * L' * vol rest : ℕ) : ℤ) :: LV := by rw [← hvexp]; exact tV
  set s := t.upd 0 R with hs
  have hsI : Inv G0 s := ht.upd (not_prot (by decide)) R
  have sG : ∀ r : Fin HS, r ≠ 0 → s.G r = t.G r := fun r hr => upd0_G hr
  -- Phase 1: the row split
  set ins : Fin W → List (ZMod 2) := fun w => rowSplit P W L' rest w 0 xs with hins
  have hinsl : ∀ w, (ins w).length = v := fun w => by simp [ins, v]
  have H1 := withSplitF_runs (I := I) (iprog := tab) KFC.bwdF W P L' (vol rest) Bb t (enc2 xs)
    ((List.finRange W).flatMap fun w => rowSplit P W L' rest w 0 (enc2 xs)) R hP1 hL1 hr1
    zW zv hB1 tP tL tV' _
    (fun u h0 h1 h2 h3 h4 => KFC.rowSplitF_spec u (enc2 xs) P W L' rest 1 R (t.G 1) (t.G 2)
      (t.G 3) (t.G 4) (by rw [length_enc2]; exact hxs) (bnd_enc2 xs le_rfl) hr1
      (Nat.mul_pos hP1 hL1) hW1 h0 h1 h2 h3 h4)
  have e1 : (List.finRange W).flatMap (fun w => rowSplit P W L' rest w 0 (enc2 xs)) =
      tabR 0 W (liftF [] fun w => enc2 (ins w)) := by
    simp only [rowSplit_enc2, ins]; exact flatMap_finRange_tabR _
  rw [e1, upd_as_encK t (tabR 0 W (liftF [] fun w => enc2 (ins w))) R] at H1
  -- Phase 2: the temporaries
  set f0 : Fin HS → List ℤ := Function.update (fun _ => []) 0 (tabR 0 W (liftF [] fun w => enc2 (ins w)))
    with hf0
  have H2 := KFE.FSp.zeroR (Y := 0) (C := 21) (r := gTV) (by decide) (by decide) (by decide)
    (by decide) s f0 (T * v) (by simp [f0]) (Lr := LTV)
    (by simp only [encK_G, f0, Function.update_apply, if_neg (show gTV ≠ 0 by decide), ints,
      List.map_nil, List.nil_append]; rw [sG _ (by decide)]; exact tTV) Bb (hle _ hTv)
  rw [Function.update_idem] at H2
  set init := Bit.QHNet.initH (T := T) v ins with hinit
  have hinitl : ∀ x, (init x).length = v := fun x => by
    cases x with
    | inl w => exact hinsl w
    | inr t => simp [init, Bit.QHNet.initH]
  have e2 : List.replicate (T * v) 0 ++ f0 0 = tabR 0 (T + W) (tabS init) ++ [] := by
    simp only [f0, Function.update_self, List.append_nil]; exact init_tab ins hinsl
  rw [e2] at H2
  -- Phase 3: the network
  set f1 : Fin HS → List ℤ := Function.update (fun _ => []) 0 (tabR 0 (T + W) (tabS init) ++ [])
    with hf1
  have ef1 : Function.update f0 0 (tabR 0 (T + W) (tabS init) ++ []) = f1 := by
    simp only [f0, f1, Function.update_idem]
  try rw [ef1] at H2
  have hfp : ∀ (L : List ℤ), ∀ r, Prot r → (Function.update (fun _ => []) 0 L : Fin HS → List ℤ) r = [] :=
    fun L => KIL.prot_upd0 (fun _ _ => rfl) L
  have hRS : ∀ L : List ℤ, RegS s (Function.update (fun _ => []) 0 L) (T + W) v := fun L =>
    ⟨by rw [Function.update_of_ne (by decide)], by rw [Function.update_of_ne (by decide)],
      by rw [Function.update_of_ne (by decide)], ⟨LV, by rw [sG _ (by decide)]; exact tV⟩,
      ⟨LWV, by rw [sG _ (by decide)]; exact tWV⟩⟩
  set impl : Bit.Edge m → List (ZMod 2) → List (ZMod 2) := fun e => Bit.realEdge Λ child e
    with himpl
  have hEdge : ∀ e ∈ Bit.progEdges C.prog, ∀ ys : List (ZMod 2), ys.length = v →
      ∀ (t' : IState HS) (R' : List Item), Inv G0 t' →
      IRuns I tab (edgeR (0 : Fin 1) m e) (t'.upd 0 (ints (enc2 ys) ++ R'))
        (t'.upd 0 (ints (enc2 (impl e ys)) ++ R')) (cEdgeR m e v Bb cC) ∧ (impl e ys).length = v := by
    intro e he ys hys t' R' ht'
    obtain ⟨_, q1⟩ := inv_reg ht' (r := sNQ) (by decide) (by decide) hG.nq
    obtain ⟨_, q2⟩ := inv_reg ht' (r := sQQ) (by decide) (by decide) hG.qq
    obtain ⟨_, q3⟩ := inv_reg ht' (r := rXs) (by decide) (by decide) hG.xs
    obtain ⟨_, q4⟩ := inv_reg ht' (r := rVB) (by decide) (by decide) hG.vb
    obtain ⟨_, q5⟩ := inv_reg ht' (r := rVC) (by decide) (by decide) hG.vc
    exact edgeR_runs (I := I) (iprog := tab) (0 : Fin 1) A B Cs P L' hpos e Bb (hTOK e he)
      (hcop e he) (hle v hvT) hQ2 child cC t' q1 q2 q3 q4 q5
      (fun ρ hρ R'' ys' hys' => hcall e he ρ hρ t' R'' ys' ht' hys') R' ys hys
  have H3 := netH_runs (I := I) (iprog := tab) (G0 := G0) (edgeR (0 : Fin 1) m) impl
    (fun e => cEdgeR m e v Bb cC) s hsI [] hTab hv1 C.prog
    (fun e he ys hys => (hEdge e he ys hys t R ht).2)
    (fun e he ys hys t' R' ht' => (hEdge e he ys hys t' R' ht').1) init f1 hinitl (hfp _) (hRS _)
    (by simp [f1]) (by simp [f1])
  set st := Bit.netRunH v impl C.prog init with hst
  have hstl : ∀ x, (st x).length = v :=
    netRunH_len v impl C.prog (fun e he ys hys => (hEdge e he ys hys t R ht).2) init hinitl
  -- Phase 4: the routing
  set f2 : Fin HS → List ℤ := Function.update (fun _ => []) 0 (tabR 0 (T + W) (tabS st) ++ [])
    with hf2
  have ef2 : Function.update f1 0 (tabR 0 (T + W) (tabS st) ++ []) = f2 := by
    simp only [f1, f2, Function.update_idem]
  try rw [ef2] at H3
  have H4 := rebuildCU_fsp (uni_tabS hstl) s f2 [] (by simp [f2]) (by simp [f2]) (hRS _) hTab hv1
    (srcR_ok T C.ρ hW1)
  set G' : ℕ → List ℤ := fun k => sumS (tabS st) v (srcR T C.ρ k) with hG'
  set f3 : Fin HS → List ℤ := Function.update (fun _ => []) 0 (tabR 0 (T + W) G' ++ []) with hf3
  have ef3 : Function.update f2 0 (tabR 0 (T + W) G' ++ []) = f3 := by
    simp only [f2, f3, Function.update_idem]
  try rw [ef3] at H4
  -- Phase 5: drop the temporaries
  have hUG : Uni (T + W) v G' := uni_sumS (uni_tabS hstl) (srcR_ok T C.ρ hW1)
  have hlenL : (tabR 0 T G').length = T * v := length_tabR hUG 0 T (by omega)
  have H5 := KFE.FSp.dropR (X := 0) (C := 21) (r := gTV) (by decide) (by decide) (by decide)
    (by decide) s f3 (tabR 0 T G') (tabR T W G')
    (by simp only [f3, Function.update_self, List.append_nil]; rw [tabR_add 0 T W, Nat.zero_add])
    (by simp [f3]) (Lr := LTV)
    (by rw [hlenL]; simp only [encK_G, f3, Function.update_apply, if_neg (show gTV ≠ 0 by decide),
      ints, List.map_nil, List.nil_append]; rw [sG _ (by decide)]; exact tTV) 1 Bb
    (bits_bnd (bits_tabR hUG 0 T (by omega)) le_rfl) (by rw [hlenL]; exact hle _ hTv)
  rw [hlenL] at H5
  set sM : Fin W → List ℤ := fun w => enc2 (st (Sum.inl (C.ρ w))) with hsM
  have eR : tabR T W G' = (List.finRange W).flatMap sM := route_tab C.ρ st hstl
  have e5 : encK s (Function.update f3 0 (tabR T W G')) =
      t.upd 0 (ints ((List.finRange W).flatMap sM) ++ R) := by
    rw [eR, upd_as_encK]
    simp only [f3, Function.update_idem]
    rfl
  -- Phase 6: the row merge
  have H6 := withSplitF_runs (I := I) (iprog := tab) KFC.fwdF W P L' (vol rest) Bb t
    ((List.finRange W).flatMap sM) (rowMerge P W L' rest 0 sM) R hP1 hL1 hr1 zW zv hB1 tP tL tV' _
    (fun u h0 h1 h2 h3 h4 => KFC.rowMergeF_spec u sM P L' rest 1 R (t.G 1) (t.G 2) (t.G 3) (t.G 4)
      (fun w => by simp only [sM, length_enc2, hstl, hvexp]) (fun w => bnd_enc2 _ le_rfl) hr1
      (Nat.mul_pos hP1 hL1) h0 h1 h2 h3 h4)
  rw [hsM, rowMerge_enc2] at H6
  have H := H1.seq ((H2.irun fok_zeroKE_gTV).seq (H3.seq ((H4.irun (fok_rebuildCU _ _)).seq
    (((H5.irun fok_dropKE_gTV).mono' e5 le_rfl).seq H6))))
  refine H.mono' rfl (le_of_eq ?_)
  simp only [cLevBody]

end

