section
-- Source module: Solutions.KFMBig3
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open AModel AModelL12 IntMul KIL KFB KFT KFU IntMul.OpenAI.Glue

noncomputable section

theorem tBox_eq {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.Glue.dP n = D + 1) :
    tBox (D + 1) (ℓP n - 1) (bLn n) = tBD n D := by
  have hl := ell_pos hn
