variable {s : IState HS} {G : Fin HS → List ℤ}

theorem zS_Z (a b c d : List ℤ) : zS G a b c d Z = a := by simp +decide [zS, update_apply]
theorem zS_TMP (a b c d : List ℤ) : zS G a b c d TMP = b := by simp +decide [zS, update_apply]
theorem zS_TM2 (a b c d : List ℤ) : zS G a b c d TM2 = c := by simp +decide [zS, update_apply]
theorem zS_ER (a b c d : List ℤ) : zS G a b c d ER = d := by simp [zS]

theorem zS_ne (zv tm tm2 er : List ℤ) {j : Fin HS} (h1 : j ≠ Z) (h2 : j ≠ TMP) (h3 : j ≠ TM2)
    (h4 : j ≠ ER) : zS G zv tm tm2 er j = G j := by
  simp [zS, update_apply, h1, h2, h3, h4]

theorem zS_uZ (a b c d x : List ℤ) : update (zS G a b c d) Z x = zS G x b c d := by
  funext i; simp only [zS, update_apply]; split_ifs <;> simp_all +decide
theorem zS_uTMP (a b c d x : List ℤ) : update (zS G a b c d) TMP x = zS G a x c d := by
  funext i; simp only [zS, update_apply]; split_ifs <;> simp_all +decide
theorem zS_uTM2 (a b c d x : List ℤ) : update (zS G a b c d) TM2 x = zS G a b x d := by
  funext i; simp only [zS, update_apply]; split_ifs <;> simp_all +decide
theorem zS_uER (a b c d x : List ℤ) : update (zS G a b c d) ER x = zS G a b c x := by
  funext i; simp only [zS, update_apply]; split_ifs <;> simp_all +decide

theorem cnt_facts {t : IState HS} {m K : ℕ} (hm : t.top HM = m) (hmi : t.IsInt HM)
    (hk : t.top HK = K) (hki : t.IsInt HK) (hKm : K ≤ m) {B : ℕ}
    (hB : zsz ((m + 2 * K : ℕ) : ℤ) ≤ B) :
    (cK.ok t ∧ cK.Lin ∧ cK.Bnd t B ∧ cK.eval t = K ∧ cK.Clean) ∧
    (cM.ok t ∧ cM.Lin ∧ cM.Bnd t B ∧ cM.eval t = m ∧ cM.Clean) ∧
    (cMK.ok t ∧ cMK.Lin ∧ cMK.Bnd t B ∧ cMK.eval t = ((m - K : ℕ) : ℤ) ∧ cMK.Clean) ∧
    (cM2K.ok t ∧ cM2K.Lin ∧ cM2K.Bnd t B ∧ cM2K.eval t = ((m + 2 * K : ℕ) : ℤ) ∧ cM2K.Clean) := by
  have z1 : ∀ a : ℕ, a ≤ m + 2 * K → zsz (a : ℤ) ≤ B := fun a ha =>
    le_trans (zsz_natCast_le ha) hB
  have z2 : ∀ a : ℤ, 0 ≤ a → a ≤ (m + 2 * K : ℕ) → zsz a ≤ B := fun a h0 ha => by
    have := z1 a.toNat (by omega); rwa [Int.toNat_of_nonneg h0] at this
  refine ⟨⟨hki, trivial, ?_, ?_, RS.clean_of_lt (by decide)⟩, ⟨hmi, trivial, ?_, ?_,
    RS.clean_of_lt (by decide)⟩, ⟨⟨hmi, hki⟩, ⟨trivial, trivial⟩, ?_, ?_, clean_of_regs (by decide)⟩,
    ⟨⟨hmi, hki, hki⟩, ⟨trivial, trivial, trivial⟩, ?_, ?_, clean_of_regs (by decide)⟩⟩
  all_goals simp only [cK, cM, cMK, cM2K, Ex.Bnd, Ex.eval, hm, hk]
  · exact z2 _ (by omega) (by push_cast; omega)
  · exact z2 _ (by omega) (by push_cast; omega)
  · refine ⟨z2 _ (by omega) (by push_cast; omega), z2 _ (by omega) (by push_cast; omega), ?_⟩
    rw [show (m : ℤ) + -K = ((m - K : ℕ) : ℤ) by push_cast [hKm]; ring]
    exact z1 _ (by omega)
  · push_cast [hKm]; ring
  · refine ⟨z2 _ (by omega) (by push_cast; omega), ⟨z2 _ (by omega) (by push_cast; omega),
      z2 _ (by omega) (by push_cast; omega), z2 _ (by omega) (by push_cast; omega)⟩,
      z2 _ (by omega) (by push_cast; omega)⟩
  · push_cast; ring

theorem zS_cnt {lm lk : List ℤ} {m K B : ℕ} (hm : G HM = (m : ℤ) :: lm)
    (hk : G HK = (K : ℤ) :: lk) (hKm : K ≤ m) (hB : zsz ((m + 2 * K : ℕ) : ℤ) ≤ B)
    (a b c d : List ℤ) :
    let t := encK s (zS G a b c d)
    (cK.ok t ∧ cK.Lin ∧ cK.Bnd t B ∧ cK.eval t = K ∧ cK.Clean) ∧
    (cM.ok t ∧ cM.Lin ∧ cM.Bnd t B ∧ cM.eval t = m ∧ cM.Clean) ∧
    (cMK.ok t ∧ cMK.Lin ∧ cMK.Bnd t B ∧ cMK.eval t = ((m - K : ℕ) : ℤ) ∧ cMK.Clean) ∧
    (cM2K.ok t ∧ cM2K.Lin ∧ cM2K.Bnd t B ∧ cM2K.eval t = ((m + 2 * K : ℕ) : ℤ) ∧
      cM2K.Clean) := by
  have hm' : zS G a b c d HM = (m : ℤ) :: lm := by
    rw [zS_ne _ _ _ _ (by decide) (by decide) (by decide) (by decide)]; exact hm
  have hk' : zS G a b c d HK = (K : ℤ) :: lk := by
    rw [zS_ne _ _ _ _ (by decide) (by decide) (by decide) (by decide)]; exact hk
  exact cnt_facts (top_encK hm') (isInt_encK hm') (top_encK hk') (isInt_encK hk') hKm hB

