namespace RedKerCore

open Function

theorem natCard_matrix_two (ℓ : ℕ) [Fact ℓ.Prime] : Nat.card (Matrix (Fin 2) (Fin 2) (ZMod ℓ)) = ℓ ^ 4 := by
  haveI : NeZero ℓ := ⟨(Fact.out : ℓ.Prime).ne_zero⟩
  show Nat.card (Fin 2 → Fin 2 → ZMod ℓ) = ℓ ^ 4
  rw [Nat.card_eq_fintype_card, Fintype.card_fun, Fintype.card_fun, ZMod.card, Fintype.card_fin]
  ring

theorem dichotomy_of_card
    (ℓ : ℕ) [Fact ℓ.Prime]
    {V W : Type*} [AddCommGroup V] [Module (Matrix (Fin 2) (Fin 2) (ZMod ℓ)) V]
    [AddCommGroup W] [Module (Matrix (Fin 2) (Fin 2) (ZMod ℓ)) W] [Finite W]
    (e : V ≃ₗ[Matrix (Fin 2) (Fin 2) (ZMod ℓ)] Matrix (Fin 2) (Fin 2) (ZMod ℓ))
    (f : V →ₗ[Matrix (Fin 2) (Fin 2) (ZMod ℓ)] W) (hW : Nat.card W ≤ ℓ ^ 2)
    (K : Fin (ℓ + 1) → Submodule (Matrix (Fin 2) (Fin 2) (ZMod ℓ)) V)
    (hK : ∀ i, Nat.card (K i) = ℓ ^ 2) (hKinj : Function.Injective K) :
    (∃! i, K i ≤ LinearMap.ker f) ∨ ((∀ i, K i ≤ LinearMap.ker f) ∧ f = 0) := by
  classical
  have hℓ : 1 < ℓ := (Fact.out : ℓ.Prime).one_lt
  have hℓ2 : ℓ ^ 2 < ℓ ^ 4 := Nat.pow_lt_pow_right hℓ (by norm_num)
  have h1 : 1 < ℓ ^ 2 := Nat.one_lt_pow (by norm_num) hℓ
  haveI : Finite V := Finite.of_equiv _ e.toEquiv.symm
  have hV : Nat.card V = ℓ ^ 4 := by rw [Nat.card_congr e.toEquiv, natCard_matrix_two]

  let Φ := Submodule.orderIsoMapComap e
  have hΦ : ∀ S : Submodule _ V, Φ S = S.map (e : V →ₗ[Matrix (Fin 2) (Fin 2) (ZMod ℓ)] _) := fun _ => rfl
  let f' : Matrix (Fin 2) (Fin 2) (ZMod ℓ) →ₗ[Matrix (Fin 2) (Fin 2) (ZMod ℓ)] W := f.comp e.symm.toLinearMap
  have hker : LinearMap.ker f' = Φ (LinearMap.ker f) := by
    rw [hΦ]
    show LinearMap.ker (f.comp e.symm.toLinearMap) = _
    rw [LinearMap.ker_comp]
    exact (Submodule.map_equiv_eq_comap_symm e (LinearMap.ker f)).symm

  obtain ⟨hcount, hdisj⟩ := Matrix.natCard_leftIdeal_ne_bot_ne_top_eq_and_inf_eq_bot ℓ
  have hKbot : ∀ i, K i ≠ ⊥ := by
    intro i h
    have := hK i
    rw [h, Nat.card_unique (α := (⊥ : Submodule _ V))] at this
    omega
  have hKtop : ∀ i, K i ≠ ⊤ := by
    intro i h
    have := hK i
    rw [h] at this
    have : Nat.card V = ℓ ^ 2 := by rw [← this]; exact Nat.card_congr (Equiv.Set.univ V).symm |> Eq.symm |> fun h => by simpa using h
    omega
  have hf : LinearMap.ker f ≠ ⊥ := by
    intro h
    have hinj : Injective f := LinearMap.ker_eq_bot.1 h
    have := Nat.card_le_card_of_injective f hinj
    omega
  have hres := dichotomy (ℓ + 1) (Nat.succ_ne_zero ℓ) hcount hdisj f'
    (by rw [hker]; exact fun h => hf (Φ.injective (h.trans (map_bot Φ).symm) |> id |> fun h' => by simpa using h'))
    (fun i => Φ (K i)) (fun i h => hKbot i (by simpa using Φ.injective (h.trans Φ.map_bot.symm)))
    (fun i h => hKtop i (Φ.injective (h.trans Φ.map_top.symm))) (fun i j h => hKinj (Φ.injective h))

  rcases hres with ⟨i₀, hi₀, huniq⟩ | ⟨hall, hrange⟩
  · left
    refine ⟨i₀, ?_, fun j hj => huniq j ?_⟩
    · have hi₀' : Φ (K i₀) ≤ LinearMap.ker f' := hi₀
      rwa [hker, Φ.le_iff_le] at hi₀'
    · show Φ (K j) ≤ LinearMap.ker f'
      rw [hker, Φ.le_iff_le]; exact hj
  · right
    refine ⟨fun i => by have h' : Φ (K i) ≤ LinearMap.ker f' := hall i; rwa [hker, Φ.le_iff_le] at h', ?_⟩
    have : LinearMap.range f = ⊥ := by
      rw [← hrange]
      show LinearMap.range f = LinearMap.range (f.comp e.symm.toLinearMap)
      rw [LinearMap.range_comp_of_range_eq_top]
      exact LinearEquiv.range e.symm
    exact LinearMap.range_eq_bot.1 this

end RedKerCore
