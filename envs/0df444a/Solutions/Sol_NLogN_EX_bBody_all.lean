    nlinarith

theorem clean_sub {e : Ex HS} (L : List (Fin HS)) (hL : ∀ i ∈ L, i.val < 56)
    (h : ∀ i ∈ e.regs, i ∈ L) : e.Clean :=
  NLogN.CR.clean_of_regs (fun i hi => hL i (h i hi))

theorem invF_eq (s t u : ℕ) (ht : 2 ≤ t) (hco : Nat.Coprime s t)
    (hu : ((s : ZMod t)⁻¹).val = u) (x : ℕ) (hx : x < t) : invF s t x = if x = u then u else 0 := by
  have : NeZero t := ⟨by omega⟩
  have hut : u < t := by rw [← hu]; exact ZMod.val_lt _
  have hsu : (s : ZMod t) * (u : ZMod t) = 1 := by
    rw [← hu, ZMod.natCast_zmod_val]; exact ZMod.coe_mul_inv_eq_one s hco
  unfold invF
  by_cases hxu : x = u
  · subst hxu
    rw [if_pos, if_pos rfl]
    have h1 : ((s * x : ℕ) : ZMod t) = ((1 : ℕ) : ZMod t) := by push_cast; exact hsu
    rw [ZMod.natCast_eq_natCast_iff'] at h1
    rw [h1]; exact Nat.mod_eq_of_lt (by omega)
  · rw [if_neg hxu, if_neg]
    intro h
    apply hxu
    have h1 : ((s * x : ℕ) : ZMod t) = 1 := by
      rw [← ZMod.natCast_mod, h]; simp
    push_cast at h1
    have h2 : (x : ZMod t) = (u : ZMod t) := by
      have := congrArg (fun z => (u : ZMod t) * z) h1
      simp only [mul_one] at this
      rw [← this, ← mul_assoc, mul_comm (u : ZMod t), hsu, one_mul]
    have := congrArg ZMod.val h2
    rwa [ZMod.val_cast_of_lt hx, ZMod.val_cast_of_lt hut] at this

theorem invAcc_full (s t u : ℕ) (ht : 2 ≤ t) (hco : Nat.Coprime s t)
    (hu : ((s : ZMod t)⁻¹).val = u) : invAcc s t t = u := by
  have : NeZero t := ⟨by omega⟩
  have hut : u < t := by rw [← hu]; exact ZMod.val_lt _
  unfold invAcc
  rw [Finset.sum_range_reflect (fun x => invF s t x) t]
  rw [Finset.sum_congr rfl (fun x hx => invF_eq s t u ht hco hu x (Finset.mem_range.1 hx))]
  rw [Finset.sum_ite_eq' (Finset.range t) u (fun _ => u)]
  simp [hut]

theorem invAcc_le (s t u : ℕ) (ht : 2 ≤ t) (hco : Nat.Coprime s t)
    (hu : ((s : ZMod t)⁻¹).val = u) (k : ℕ) (hk : k ≤ t) : invAcc s t k ≤ u := by
  have : NeZero t := ⟨by omega⟩
  have hut : u < t := by rw [← hu]; exact ZMod.val_lt _
  unfold invAcc
  have e : ∀ j ∈ Finset.range k, invF s t (t - 1 - j) = if t - 1 - j = u then u else 0 :=
    fun j hj => invF_eq s t u ht hco hu _ (by omega)
  rw [Finset.sum_congr rfl e]
  calc (∑ j ∈ Finset.range k, if t - 1 - j = u then u else 0)
      ≤ ∑ j ∈ Finset.range k, if j = t - 1 - u then u else 0 := by
        apply Finset.sum_le_sum; intro j hj
        have hj' := Finset.mem_range.1 hj
        by_cases h : t - 1 - j = u
        · rw [if_pos h, if_pos (by omega)]
        · rw [if_neg h]; exact Nat.zero_le _
    _ ≤ u := by
        rw [Finset.sum_ite_eq']; split_ifs <;> omega

theorem invAcc_succ (s t k : ℕ) : invAcc s t (k + 1) = invAcc s t k + invF s t (t - 1 - k) := by
  simp [invAcc, Finset.sum_range_succ]

theorem invC_spec (s t x : ℕ) (ht : 0 < t) :
    (((((s : ℤ) * x) % t - 1) * (((s : ℤ) * x) % t - 1) + -1 < 0) ↔ s * x % t = 1) := by
  have h1 : ((s : ℤ) * x) % t = ((s * x % t : ℕ) : ℤ) := by push_cast; rfl
  rw [h1]
  generalize s * x % t = y
  constructor
  · intro h
    by_contra hy
    have : (1 : ℤ) ≤ ((y : ℤ) - 1) * ((y : ℤ) - 1) := by
      rcases Nat.lt_or_gt_of_ne hy with h' | h'
      · have : y = 0 := by omega
        subst this; norm_num
      · have : (2 : ℤ) ≤ y := by exact_mod_cast h'
        nlinarith
    linarith
  · intro h; subst h; norm_num

section inv

variable (X C Sr Tr : Fin HS)

theorem invStates (w : IState HS) (s t : ℕ) (LS LT : List Item)
    (hXC : X ≠ C) (hXS : X ≠ Sr) (hXT : X ≠ Tr) (hCS : C ≠ Sr) (hCT : C ≠ Tr)
    (hS : w.G Sr = .int s :: LS) (hT : w.G Tr = .int t :: LT) (ht : 0 < t) :
    NLogN.RepStates C (.reg Tr) (invB X C Sr Tr) (w.upd X (.int 0 :: w.G X)) (invSt X w s t) where
  nonneg := by simp [Ex.eval, IState.top, hXT.symm, hT]
  hw := by simp [invB, RS.writes]; exact fun h => hXC h.symm
  h0 := by simp [invSt, invAcc]
  hG := fun k => by simp [invSt, Ne.symm hXC]
  step := fun k hk => by
    have eN : (Ex.reg Tr).eval (w.upd X (.int 0 :: w.G X)) = t := by
      simp [Ex.eval, IState.top, hXT.symm, hT]
    rw [eN, Int.toNat_natCast] at hk ⊢
    set z := withCtr C (w.upd X (.int 0 :: w.G X)) t k (invSt X w s t k) with hz
    have zX : z.G X = .int (invAcc s t k) :: w.G X := by simp [hz, withCtr, invSt, hXC]
    have zC : z.top C = ((t - 1 - k : ℕ) : ℤ) + 1 := by
      simp [hz, withCtr, IState.top]; omega
    have zS : z.top Sr = s := by simp [hz, withCtr, invSt, IState.top, hCS.symm, hXS.symm, hS]
    have zT : z.top Tr = t := by simp [hz, withCtr, invSt, IState.top, hCT.symm, hXT.symm, hT]
    have ex : (invX C).eval z = ((t - 1 - k : ℕ) : ℤ) := by simp [invX, Ex.eval, zC]
    have ec : ((invC C Sr Tr).eval z < 0) ↔ s * (t - 1 - k) % t = 1 := by
      simp only [invC, invY, Ex.eval, ex, zS, zT]
      exact invC_spec s t _ ht
    simp only [invB, RS.run, Ex.eval, IState.top_eq zX, zX, List.tail_cons]
    have e2 : ((invAcc s t k : ℕ) : ℤ) + (if (invC C Sr Tr).eval z < 0 then (invX C).eval z
        else 0) = ((invAcc s t (k + 1) : ℕ) : ℤ) := by
      rw [invAcc_succ]
      by_cases h : s * (t - 1 - k) % t = 1
      · rw [if_pos (ec.2 h), ex]; simp [invF, h]
      · rw [if_neg (fun h' => h (ec.1 h'))]; simp [invF, h]
    rw [e2, hz]
    apply IState.ext' _ (by simp [withCtr, invSt]) (by simp [withCtr, invSt])
    intro y
    simp only [withCtr, invSt, IState.upd_G]
    clear * - hXC
    split_ifs <;> (try subst_vars) <;> simp_all

theorem invP_run (w : IState HS) (s t : ℕ) (LS LT : List Item)
    (hXC : X ≠ C) (hXS : X ≠ Sr) (hXT : X ≠ Tr) (hCS : C ≠ Sr) (hCT : C ≠ Tr)
    (hS : w.G Sr = .int s :: LS) (hT : w.G Tr = .int t :: LT) (ht : 2 ≤ t)
    (hco : Nat.Coprime s t) :
    (invP X C Sr Tr).run w = w.upd X (.int (((s : ZMod t)⁻¹).val : ℕ) :: w.G X) := by
  have H := invStates X C Sr Tr w s t LS LT hXC hXS hXT hCS hCT hS hT (by omega)
  have eN : (Ex.reg Tr).eval (w.upd X (.int 0 :: w.G X)) = t := by
    simp [Ex.eval, IState.top, hXT.symm, hT]
  show (RS.rep C (.reg Tr) (invB X C Sr Tr)).run ((RS.push X (.lit 0)).run w) = _
  have r0 : (RS.push X (.lit 0)).run w = w.upd X (.int 0 :: w.G X) := by simp [RS.run, Ex.eval]
  rw [r0, H.run, eN, Int.toNat_natCast, invSt, invAcc_full s t _ ht hco rfl]

theorem sqb (Y t : ℤ) (h0 : 0 ≤ Y) (h1 : Y < t) : (Y + -1) * (Y + -1) ≤ (t + 1) * (t + 1) := by
  nlinarith

theorem Vfacts (s t : ℕ) : s * t + t + 2 ≤ 4 * (s + 2) * (t + 2) * (t + 2) ∧
    s + t + 2 ≤ 4 * (s + 2) * (t + 2) * (t + 2) ∧ 2 * t + 2 ≤ 4 * (s + 2) * (t + 2) * (t + 2) ∧
    (t + 1) * (t + 1) + 1 ≤ 4 * (s + 2) * (t + 2) * (t + 2) := by
  have h1 : (s + 2) * (t + 2) ≤ 4 * (s + 2) * (t + 2) * (t + 2) := by
    have : 1 * ((s + 2) * (t + 2)) ≤ (4 * (t + 2)) * ((s + 2) * (t + 2)) :=
      Nat.mul_le_mul_right _ (by omega)
    calc (s + 2) * (t + 2) = 1 * ((s + 2) * (t + 2)) := by ring
      _ ≤ _ := this
      _ = _ := by ring
  have h2 : (t + 2) * (t + 2) ≤ 4 * (s + 2) * (t + 2) * (t + 2) := by
    have : 1 * ((t + 2) * (t + 2)) ≤ (4 * (s + 2)) * ((t + 2) * (t + 2)) :=
      Nat.mul_le_mul_right _ (by omega)
    calc (t + 2) * (t + 2) = 1 * ((t + 2) * (t + 2)) := by ring
      _ ≤ _ := this
      _ = _ := by ring
  have e1 : (s + 2) * (t + 2) = s * t + 2 * s + 2 * t + 4 := by ring
  have e2 : (t + 2) * (t + 2) = (t + 1) * (t + 1) + 2 * t + 3 := by ring
  refine ⟨by omega, by omega, by omega, by omega⟩

theorem invB_bnd (z : IState HS) (s t x A B : ℕ) (zX : z.top X = A)
