universe u
variable (p : Nat) [NeZero p]
variable {Site : Type u} [Fintype Site] [DecidableEq Site]
namespace QEC.Distillation.KT19Protocol
theorem _root_.solution (word label : PrimeQuditRegisterLabel p Site) :
    xWordTransport p word (registerBasisKet p label) =
      registerBasisKet p (label + word) := by
  classical
  ext target
  by_cases htarget : target = label + word
  · subst target
    simp [xWordTransport_apply, registerBasisKet, EuclideanSpace.basisFun_apply]
  · have htarget' : target - word ≠ label := by
      intro h
      apply htarget
      calc
        target = (target - word) + word := by
          funext site
          simp
        _ = label + word := by rw [h]
    simp [xWordTransport_apply, registerBasisKet, EuclideanSpace.basisFun_apply,
      htarget, htarget']
end QEC.Distillation.KT19Protocol
