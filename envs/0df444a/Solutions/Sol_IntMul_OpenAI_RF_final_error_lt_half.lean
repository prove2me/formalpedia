lemma pow_two_ge_sq (x : ℝ) (hx : 0 ≤ x) : (x * Real.log 2) ^ 2 / 2 ≤ (2 : ℝ) ^ x := by
  rw [Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 2)]
  have h := Real.quadratic_le_exp_of_nonneg (x := Real.log 2 * x)
    (mul_nonneg (Real.log_nonneg (by norm_num)) hx)
  have : 0 ≤ Real.log 2 * x := mul_nonneg (Real.log_nonneg (by norm_num)) hx
  nlinarith

/-- `896 b < 2^{3b/4}` for `b ≥ 8192` (the paper's cutoff is `b ≥ 2^24`). -/
lemma lin_lt_pow (b : ℝ) (hb : 8192 ≤ b) : 896 * b < (2 : ℝ) ^ (3 * b / 4) := by
  have h := pow_two_ge_sq (3 * b / 4) (by linarith)
  have hl := Real.log_two_gt_d9
  have h1 : 0.5 * b ≤ 3 * b / 4 * Real.log 2 := by nlinarith
  have h2 : (0.5 * b) ^ 2 / 2 ≤ (3 * b / 4 * Real.log 2) ^ 2 / 2 := by
    have : 0 ≤ 0.5 * b := by linarith
    gcongr
  nlinarith

