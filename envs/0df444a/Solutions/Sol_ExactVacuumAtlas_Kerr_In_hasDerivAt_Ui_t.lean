open Real
open ExactVacuumAtlas
open ExactVacuumAtlas.Kerr
open ExactVacuumAtlas.Kerr.In
theorem solution (a r θ : ℝ) (h : r ^ 2 + a ^ 2 * cos θ ^ 2 ≠ 0) :
    HasDerivAt (fun t => Ui a r t) (2 * a ^ 2 * sin θ * cos θ * Ui a r θ ^ 2) θ := by
  have h1 : HasDerivAt (fun t : ℝ => r ^ 2 + a ^ 2 * cos t ^ 2)
      (a ^ 2 * (2 * cos θ * (-sin θ))) θ := by
    have := ((Real.hasDerivAt_cos θ).pow 2).const_mul (a ^ 2)
    have := this.const_add (r ^ 2)
    refine this.congr_deriv ?_
    push_cast; ring
  have h2 := h1.inv h
  unfold Ui
  refine h2.congr_deriv ?_
  rw [div_eq_mul_inv, ← inv_pow]; try ring
