-- title:
--   Proof of Theorem 4, p. 13 — E_{k+1} − E_k ≤ (δ_{k+1} − δ_k − (α − 1)δ_k/(k + 1))(f(x_{k+1}) − f(x⋆))
-- statement:
--   Let $\mathcal H$ be a real Hilbert space and $f:\mathcal H\to\mathbb R$ a convex $\mathcal C^1$ function with a minimizer $x^\star$. Let $\alpha\ge1$, $h>0$, $s=h^2$, let $(\beta_k)$, $(b_k)$ be non-negative sequences, and let $(x_k)$ be generated by (IPAHD). With
--   $\delta_k=h(b_khk-\beta_{k+1}-k(\beta_{k+1}-\beta_k))(k+1)$ as in (9) and the energy
--   $$E_k=\delta_k\big(f(x_k)-f(x^\star)\big)+\tfrac12\|v_k\|^2,\qquad v_k=(\alpha-1)(x_k-x^\star)+k\big(x_k-x_{k-1}+\beta_kh\nabla f(x_k)\big),$$
--   if $k\ge1$ and $(\mathcal G_2^{\rm dis})$ holds at $k$, then
--   $$E_{k+1}-E_k\le\Big(\delta_{k+1}-\delta_k-(\alpha-1)\frac{\delta_k}{k+1}\Big)\big(f(x_{k+1})-f(x^\star)\big).$$
--
--   Under the second growth condition $(\mathcal G_3^{\rm dis})$ the right-hand side is non-positive, so the energy is non-increasing.
--
--   **Formalization Note.** The minimizer is a point $x^\star$ with $f(x^\star)\le f(y)$ for all $y$. $h>0$ and $\beta_k,b_k\ge0$ are implicit on the page and added.
-- source:
--   Attouch, Chbani, Fadili, Riahi, First-order optimization algorithms via inertial systems with Hessian driven damping, arXiv:1907.10536v2, §3.1.1, proof of Theorem 4, p. 13

import Mathlib
import Definitions.Def_GoldenRatioVI_Shared_IsProxPoint
import Definitions.Def_HessianDamping_IPAHD_Setting

namespace HessianDamping.IPAHD

/-- Proof of Theorem 4, p. 13: the increment of the energy under (G₂dis) at `k`. -/
theorem EK_succ_sub_le
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (f : H → ℝ) (hfconv : ConvexOn ℝ Set.univ f) (hfC1 : ContDiff ℝ 1 f)
    (xstar : H) (hxstar : ∀ y, f xstar ≤ f y)
    (α : ℝ) (hα : 1 ≤ α)
    (h s : ℝ) (hh : 0 < h) (hs : s = h ^ 2)
    (β b : ℕ → ℝ) (hβ : ∀ k, 0 ≤ β k) (hb : ∀ k, 0 ≤ b k)
    (x : ℕ → H) (hx : IsIPAHDRun f α s β b x)
    (k : ℕ) (hk : 1 ≤ k)
    (hG2 : 0 < b k * h * k - β (k + 1) - k * (β (k + 1) - β k)) :
    EK f α h β b x xstar (k + 1) - EK f α h β b x xstar k
      ≤ (deltaK h β b (k + 1) - deltaK h β b k - (α - 1) * deltaK h β b k / ((k : ℝ) + 1))
        * (f (x (k + 1)) - f xstar) := by sorry

end HessianDamping.IPAHD
