  generalize cU (4 * p + 1) = c
  have h1 : n' + 1 ≤ n + n' + 1 := by omega
  have h2 := Nat.mul_le_mul_right (4 * u) h1
  have h3 : 1 ≤ n + n' + 1 := by omega
  have h4 := Nat.mul_le_mul_right (6 * u) h3
  nlinarith

theorem frame_le {p d s : ℕ} (α : ℕ) (hp : 1 ≤ p) (hd : d ≤ p) (hQ : segPF p d s ≤ 3 * p) :
    frameC (4 * p) d s p ≤ Kb * (NF d s + p + 1) * Ut p α := by
  obtain ⟨f1, f2, f3, f4, f5⟩ := u_facts hp
  have hc := cPar_le (4 * p) d (NF d s) (segPF p d s)
  have hl := J6Seg.PJ.lamF_le_NF d s
  have hu : uC (4 * p) DD ≤ Ut p α := by simp only [Ut]; omega
  simp only [frameC]
  generalize NF d s = N at *
  set Y := N + p + 1 with hY
  have e1 : Kp * (4 * p + 3) ^ 2 * (N + segPF p d s + d + lamF d + 2) ≤
      Kp * (16 * uC (4 * p) DD) * (4 * Y) :=
    Nat.mul_le_mul (Nat.mul_le_mul_left _ f5) (by omega)
  generalize J6Seg.PJ.cPar 0 0 0 0 (4 * p) d N (segPF p d s) (0 * segPF p d s + 0) = cp at *
  generalize parkC (4 * p + 1) = pk at *
  generalize uC 2 DD = u2 at *
  generalize Ut p α = U at *
  generalize uC (4 * p) DD = u at *
  have q1 : Kp * (16 * u) * (4 * Y) = 64 * (Kp * u * Y) := by ring
  have hY1 : 1 ≤ Y := by omega
  have q2 : u ≤ u * Y := Nat.le_mul_of_pos_right _ hY1
  have q3 : u * Y ≤ U * Y := Nat.mul_le_mul_right _ hu
  have q4 : Kp * u * Y ≤ Kp * U * Y := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hu)
  have q5 : Kb * Y * U = 10 ^ 6 * (U * Y) + 100 * (Kp * U * Y) := by simp only [Kb]; ring
  rw [q5]
  omega

theorem cost7_le {p Q t α : ℕ} : cost7 (4 * p) Q p α t ≤ 400 * (Q + t + 2) * Ut p α := by
  have h := ctlPhC_le (p := p) (n := t) (n' := t) α
  simp only [cost7, c7]
  have hu : uC (4 * p) DD ≤ Ut p α := by simp only [Ut]; omega
  have he : ePC (4 * p) p α ≤ Ut p α := by simp only [Ut]; omega
  have m1 : (t + 1) * (200 * uC (4 * p) DD + 2 * ePC (4 * p) p α + 4 * uC (4 * p) DD +
      uC (4 * p) DD) ≤ (t + 1) * (207 * Ut p α) := Nat.mul_le_mul_left _ (by omega)
  have m2 : (2 * Q + 4) * (40 * uC (4 * p) DD) ≤ (2 * Q + 4) * (40 * Ut p α) :=
    Nat.mul_le_mul_left _ (by omega)
  nlinarith

theorem dnC_le {p m : ℕ} (α : ℕ) :
    dnC (4 * p) m + (uC (4 * p) DD + uC (4 * p) DD) ≤ 10 * (m + 1) * Ut p α := by
  have hu : uC (4 * p) DD ≤ Ut p α := by simp only [Ut]; omega
  simp only [dnC]
  generalize uC (4 * p) DD = u at *
  nlinarith

end J6Seg.Src

