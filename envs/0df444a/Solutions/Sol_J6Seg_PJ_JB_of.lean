-- Source module: Solutions.J6SegILPreJK26
/-!
# B5 `J` side, part K26: crude magnitude bounds of the row quantities

With every table entry `≤ X` (`TabX`): `tsT ≤ X³`, its partial sums `≤ λ X³`, the `M⁻¹` row
entries `miV ≤ λ X⁷`, the slot values `gV ≤ λ X⁸`, the capacitance partial sums
`≤ 2^Q + K λ X⁸`, the coupling partial sums `≤ J X`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL Function Finset

theorem rs_abs_le (P : ℕ) (a : ℤ) : |rs P a| ≤ |a| := by
  have h := rs_err P a
  have hP : (1 : ℝ) ≤ 2 ^ P := one_le_pow₀ (by norm_num)
  have h3 : |(a : ℝ)| / 2 ^ P ≤ |(a : ℝ)| := div_le_self (abs_nonneg _) hP
  have h4 : |((rs P a : ℤ) : ℝ)| ≤ |(a : ℝ)| / 2 ^ P + 1 / 2 := by
    have := abs_sub_abs_le_abs_sub ((rs P a : ℤ) : ℝ) ((a : ℝ) / 2 ^ P)
    rw [abs_div, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ P)] at this
    linarith
  have h5 : ((|rs P a| : ℤ) : ℝ) < ((|a| + 1 : ℤ) : ℝ) := by
    push_cast; linarith
  have h6 : |rs P a| < |a| + 1 := by exact_mod_cast h5
  omega

theorem fmulI_abs (P : ℕ) (x y : ℤ) : |fmul P x y| ≤ |x| * |y| := by
  unfold fmul; rw [← abs_mul]; exact rs_abs_le P _

theorem fmulI_le {P : ℕ} {x y X Y : ℤ} (hx : |x| ≤ X) (hy : |y| ≤ Y) : |fmul P x y| ≤ X * Y :=
  (fmulI_abs P x y).trans (mul_le_mul hx hy (abs_nonneg _) ((abs_nonneg _).trans hx))

theorem sum_abs_le {f : ℕ → ℤ} {K : ℕ} {M : ℤ} (h : ∀ k < K, |f k| ≤ M) :
    |∑ k ∈ range K, f k| ≤ K * M := by
  refine (abs_sum_le_sum_abs _ _).trans ?_
  have := Finset.sum_le_card_nsmul (range K) (fun k => |f k|) M
    (fun k hk => h k (Finset.mem_range.mp hk))
  simpa using this

section bnd
variable {Q lam : ℕ} {T : Tables} {X : ℤ} (hT : TabX T lam X)
include hT

theorem tsT_abs {c u v k : ℕ} (hk : k < lam) : |tsT Q T c u v k| ≤ X ^ 3 := by
  have hX0 : 0 ≤ X := le_trans zero_le_one hT.X1
  unfold tsT
  split_ifs with h
  · rw [abs_mul]
    have h1 := hT.ap c (k - u) (by omega)
    have h2 : |fmul Q (T.gam k) (T.am c (k - v))| ≤ X * X :=
      fmulI_le (hT.gam k hk.le) (hT.am c (k - v) (by omega))
    calc |T.ap c (k - u)| * |fmul Q (T.gam k) (T.am c (k - v))| ≤ X * (X * X) :=
          mul_le_mul h1 h2 (abs_nonneg _) hX0
      _ = X ^ 3 := by ring
  · simp only [abs_zero]; positivity

theorem tsS_abs {c u v K : ℕ} (hK : K ≤ lam) :
    |∑ k ∈ range K, tsT Q T c u v k| ≤ lam * X ^ 3 := by
  have hX0 : 0 ≤ X := le_trans zero_le_one hT.X1
  refine (sum_abs_le (M := X ^ 3) (fun k hk => tsT_abs hT (by omega))).trans ?_
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast hK) (by positivity)

theorem tsY_abs {c u v n : ℕ} (hu : u < lam) (hv : v < lam) (hn : n ≤ lam) :
    |fmul Q (fmul Q (T.gi u) (T.gi v)) (fmul Q (∑ k ∈ range n, tsT Q T c u v k) 1)| ≤
      X * X * (lam * X ^ 3) := by
  refine fmulI_le (fmulI_le (hT.gi u hu) (hT.gi v hv)) ?_
  refine (fmulI_le (tsS_abs hT hn) (le_refl |(1 : ℤ)|)).trans ?_
  simp

theorem miV_abs {B : Blocks} {a u : ℕ} (hn : B.len a ≤ lam) (ho : a - B.st a < B.len a)
    (hu : u < B.len a) :
    |miV Q T B a u| ≤ X * X * (X * X * (lam * X ^ 3)) := by
  rw [miV_eq]
  refine fmulI_le (fmulI_le (hT.dd _ (by omega)) (hT.di _ (by omega))) ?_
  exact tsY_abs hT (lt_of_lt_of_le (tU_lt ho hu) hn) (lt_of_lt_of_le (tV_lt ho hu) hn) hn

theorem gV_abs {B : Blocks} {a y : ℕ} (hn : B.len a ≤ lam) (ho : a - B.st a < B.len a)
    (hy : y < B.len a * (2 * B.w + 1)) :
    |gV Q T B a y| ≤ X * X * (X * X * (lam * X ^ 3)) * X := by
  unfold gV
  have hu : y / (2 * B.w + 1) < B.len a := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hy)
  exact fmulI_le (miV_abs hT hn ho hu) (hT.cpl _ _)

theorem colS_abs {B : Blocks} {a b K : ℕ} (hn : B.len a ≤ lam) (ho : a - B.st a < B.len a)
    (hK : K ≤ B.len a * (2 * B.w + 1)) :
    |(if a = b then (2 : ℤ) ^ Q else 0) +
        ∑ y ∈ range K, cTm (gV Q T B a) (gC B (B.st a)) b y| ≤
      2 ^ Q + K * (X * X * (X * X * (lam * X ^ 3)) * X) := by
  have hX0 : 0 ≤ X := le_trans zero_le_one hT.X1
  refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
  · split_ifs
    · rw [abs_of_pos (by positivity)]
    · simp only [abs_zero]; positivity
  · refine sum_abs_le (fun y hy => ?_)
    unfold cTm
    split_ifs
    · exact gV_abs hT hn ho (by omega)
    · simp only [abs_zero]; positivity

theorem ccS_abs {B : Blocks} {l b J : ℕ} :
    |∑ j ∈ range J, ccT T B l b j| ≤ J * X := by
  have hX0 : 0 ≤ X := le_trans zero_le_one hT.X1
  refine sum_abs_le (fun j hj => ?_)
  unfold ccT
  split_ifs
  · exact hT.cpl _ _
  · simp only [abs_zero]; exact hX0

end bnd

end J6Seg.PJ

