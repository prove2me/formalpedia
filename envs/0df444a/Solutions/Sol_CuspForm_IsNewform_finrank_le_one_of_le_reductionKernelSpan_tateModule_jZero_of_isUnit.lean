section TateHelpers

variable {J : Type} [AddCommGroup J] [Module HeckeAlg J] {p : ℕ}

private theorem tateModule_pow_smul_apply_add {y : ℕ → J} (hy : y ∈ ModularCurve.TateModule p J) :
    ∀ n m : ℕ, (p ^ n : ℕ) • y (n + m) = y m := by
  intro n
  induction n with
  | zero => intro m; simp
  | succ k ih =>
    intro m
    have hidx : k + 1 + m = k + m + 1 := by omega
    rw [hidx, pow_succ, mul_smul]
    have hstep : p • y (k + m + 1) = y (k + m) := (ModularCurve.TateModule.mem_iff.mp hy).2 (k + m)
    rw [hstep]
    exact ih m

private theorem tateModule_exists_pow_smul_mem_of_apply_eq_zero
    (F : ℕ → AddSubgroup J)
    (hFinf : ∀ m m' : ℕ, m ∣ m' → ∀ x ∈ F m', (m : ℤ) • x = 0 → x ∈ F m)
    {y : ℕ → J} (hy : y ∈ ModularCurve.TateModule p J) (n : ℕ) (h0 : y n = 0)
    (hmem : ∀ m, y m ∈ F (p ^ m)) :
    ∃ z ∈ ModularCurve.TateModule p J, (p ^ n : ℕ) • z = y ∧ ∀ m, z m ∈ F (p ^ m) := by
  have hz : (fun m => y (n + m)) ∈ ModularCurve.TateModule p J := by
    refine ⟨h0, fun m => ?_⟩
    exact (ModularCurve.TateModule.mem_iff.mp hy).2 (n + m)
  refine ⟨fun m => y (n + m), hz, ?_, fun m => ?_⟩
  · funext m
    show (p ^ n : ℕ) • y (n + m) = y m
    exact tateModule_pow_smul_apply_add hy n m
  · have h1 : (p ^ m : ℕ) • y (n + m) = 0 := ModularCurve.TateModule.pow_smul_apply hz m
    have htor : ((p ^ m : ℕ) : ℤ) • y (n + m) = 0 := by rw [natCast_zsmul]; exact h1
    exact hFinf (p ^ m) (p ^ (n + m)) (pow_dvd_pow p (Nat.le_add_left m n)) _ (hmem (n + m)) htor

variable [Fact p.Prime] [Module ℤ_[p] (ModularCurve.TateModule p J)]

private def tateSub
    (hsmul : ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
      ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n)
    (F : ℕ → AddSubgroup J) : Submodule ℤ_[p] (ModularCurve.TateModule p J) where
  carrier := {x | ∀ n, (x : ℕ → J) n ∈ F (p ^ n)}
  add_mem' := by
    intro x y hx hy n
    exact (F (p ^ n)).add_mem (hx n) (hy n)
  zero_mem' := by
    intro n
    exact (F (p ^ n)).zero_mem
  smul_mem' := by
    intro a x hx n
    rw [hsmul a x n]
    exact AddSubgroup.nsmul_mem _ (hx n) _

private theorem mem_tateSub_iff
    (hsmul : ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
      ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n)
    (F : ℕ → AddSubgroup J) (x : ModularCurve.TateModule p J) :
    x ∈ tateSub hsmul F ↔ ∀ n, (x : ℕ → J) n ∈ F (p ^ n) := Iff.rfl

private theorem natCast_padic_smul
    (hsmul : ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
      ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n)
    (k : ℕ) (x : ModularCurve.TateModule p J) :
    ((k : ℤ_[p]) • x : ModularCurve.TateModule p J) = k • x := by
  apply Subtype.ext
  funext n
  rw [hsmul, map_natCast, ZMod.val_natCast]
  have hx : p ^ n • (x : ℕ → J) n = 0 := ModularCurve.TateModule.pow_smul_apply x.2 n
  change (k % p ^ n) • (x : ℕ → J) n = ((k • x : ModularCurve.TateModule p J) : ℕ → J) n
  rw [Submodule.coe_smul_of_tower, Pi.smul_apply]
  conv_rhs => rw [← Nat.div_add_mod k (p ^ n)]
  rw [add_smul, mul_comm, mul_smul, hx, smul_zero, zero_add]

private theorem natCast_smul_coe
    (hsmul : ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
      ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n)
    (k : ℕ) (x : ModularCurve.TateModule p J) :
    (((k : ℤ_[p]) • x : ModularCurve.TateModule p J) : ℕ → J) = k • (x : ℕ → J) := by
  rw [natCast_padic_smul hsmul k x, Submodule.coe_smul_of_tower]

private def heckeEndZp
    (hsmul : ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
      ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n)
    (t : HeckeAlg) : ModularCurve.TateModule p J →ₗ[ℤ_[p]] ModularCurve.TateModule p J where
  toFun x := t • x
  map_add' x y := smul_add t x y
  map_smul' a x := by
    apply Subtype.ext
    funext n
    change t • (((a • x : ModularCurve.TateModule p J) : ℕ → J) n) = ((a • (t • x) : ModularCurve.TateModule p J) : ℕ → J) n
    rw [hsmul, hsmul]
    change t • ((PadicInt.toZModPow n a).val • (x : ℕ → J) n) =
      (PadicInt.toZModPow n a).val • (t • (x : ℕ → J) n)
    exact smul_comm _ _ _

@[scoped simp] private theorem heckeEndZp_apply
    (hsmul : ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
      ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n)
    (t : HeckeAlg) (x : ModularCurve.TateModule p J) : heckeEndZp hsmul t x = t • x := rfl

private theorem heckeEndZp_pow_apply_coe
    (hsmul : ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
      ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n)
    (t : HeckeAlg) (m : ℕ) (x : ModularCurve.TateModule p J) (k : ℕ) :
    (((heckeEndZp hsmul t ^ m) x : ModularCurve.TateModule p J) : ℕ → J) k =
      ((DistribSMul.toAddMonoidHom J t).toIntLinearMap ^ m) ((x : ℕ → J) k) := by
  induction m generalizing x with
  | zero => simp
  | succ m ih =>
    rw [pow_succ, pow_succ, Module.End.mul_apply, Module.End.mul_apply, ih]
    rfl

private theorem TM_eq_baseChange
    (hsmul : ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
      ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n)
    (O : Type) [CommRing O] [Algebra ℤ_[p] O]
    (TM : HeckeAlg →+* Module.End O (O ⊗[ℤ_[p]] ModularCurve.TateModule p J))
    (hT : ∀ (t : HeckeAlg) (a : O) (x : ModularCurve.TateModule p J), TM t (a ⊗ₜ[ℤ_[p]] x) = a ⊗ₜ[ℤ_[p]] (t • x))
    (t : HeckeAlg) : TM t = (heckeEndZp hsmul t).baseChange O := by
  apply LinearMap.ext
  intro v
  induction v using TensorProduct.induction_on with
  | zero => rw [map_zero, map_zero]
  | tmul a x => rw [hT, LinearMap.baseChange_tmul, heckeEndZp_apply]
  | add v₁ v₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂]

end TateHelpers
