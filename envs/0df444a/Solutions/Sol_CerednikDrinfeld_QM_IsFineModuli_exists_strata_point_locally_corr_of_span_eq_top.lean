    (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (uA : ρ'.Ab.A ⟶ ρ.Ab.A)
    (huA : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA)
    (h : ib ≫ ρ'.φ ≫ uA = ρ.φ) (s t : ℕ) :
