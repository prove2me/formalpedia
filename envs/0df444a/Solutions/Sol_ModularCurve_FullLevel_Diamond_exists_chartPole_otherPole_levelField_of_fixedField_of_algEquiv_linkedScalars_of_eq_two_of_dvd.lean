    PA x ↔ algebraMap k K₀ x ∈ V.comap (φ.toRingEquiv : K₀ →+* F₀) := by
  rw [h, ValuationSubring.mem_comap]
  show _ ↔ φ.toRingEquiv (algebraMap k K₀ x) ∈ V
