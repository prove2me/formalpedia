    rw [run_rep 45 _ _ t0 hw (by rw [hK]; positivity), hK, Int.toNat_natCast, gj 45 (by decide) (by decide) (by decide) (by decide) (by decide)]
  refine ⟨⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩, ?_⟩
  · simp (config := {decide := true}) [atanPre, seqL, RS.ok, run_seq, Ex.ok, Ex.eval, Ex.Clean,
      Ex.regs, IState.IsInt, IState.top, h0]
  · have : (atanPre.run s).G 41 = .int 0 :: s.G 41 := by
