-- module Solutions.Artin.KP.T_Linear
/-! # WP-T, file 7: linearity

Twisted level (for the linear combinations of WP-F, which are not genuine sections):
* `eis_add`, `eis_smulFun` (`Re s > 2`); `HasCoefT.add`, `HasCoefT.smulFun`, `HasCoefT.unique`;
* `resSlit_congr`, `resSlit_add`, `resSlit_mul` (function level) and their forms with seeds
  `resSlit_add_of_seed`, `resSlit_mul_of_seed`: `Res(a₀ + b₀) = Res a₀ + Res b₀`,
  `Res(f·a₀) = f(4/3)·Res a₀` for entire `f`.

Genuine level:
* `aSer_add`, `aSer_smulFun`: the Kubota series is linear in `Φ` (`Re s > 2`), read off the
  Fourier coefficients;
* **`tau_add`, `tau_smulFun`, `tau_smul`**.
-/

open scoped MatrixGroups ComplexConjugate ENNReal Topology
open MeasureTheory Set NumberField Filter IsDedekindDomain ArtinPrimitiveRoots Metric

set_option autoImplicit false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

namespace ArtinKP.T

open ArtinKP.A ArtinKP.S ArtinKP.X ArtinKP.B1 ArtinKP.B ArtinKP.C5 ArtinKP.K ArtinKP.RF ArtinKP.N

noncomputable section

/-! ### Function level -/

theorem contSlit_congr {a₀ b₀ : ℂ → ℂ} (h : ∀ s : ℂ, 2 < s.re → a₀ s = b₀ s) :
    EqOn (contSlit a₀) (contSlit b₀) E.slit := by
  by_cases hex : ∃ a : ℂ → ℂ, DifferentiableOn ℂ a E.slit ∧ ∀ s : ℂ, 2 < s.re → a s = a₀ s
  · have hs := contSlit_spec hex
    exact contSlit_unique hs.1 fun s hs' => (hs.2 s hs').trans (h s hs')
  · have hex' : ¬ ∃ a : ℂ → ℂ, DifferentiableOn ℂ a E.slit ∧ ∀ s : ℂ, 2 < s.re → a s = b₀ s := by
      rintro ⟨a, ha, hab⟩
      exact hex ⟨a, ha, fun s hs => (hab s hs).trans (h s hs).symm⟩
    unfold contSlit
    rw [dif_neg hex, dif_neg hex']
    exact fun _ _ => rfl

lemma eventually_ray_mem_slit : ∀ᶠ t : ℝ in 𝓝[>] 0, ray t ∈ E.slit := by
  filter_upwards [self_mem_nhdsWithin] with t ht
  exact ray_mem_slit ht

theorem resSlit_congr {a₀ b₀ : ℂ → ℂ} (h : ∀ s : ℂ, 2 < s.re → a₀ s = b₀ s) :
    resSlit a₀ = resSlit b₀ := by
  have heq : (fun t : ℝ => ((t : ℂ) * (1 + Complex.I)) * contSlit a₀ (ray t)) =ᶠ[𝓝[>] 0]
      fun t : ℝ => ((t : ℂ) * (1 + Complex.I)) * contSlit b₀ (ray t) := by
    filter_upwards [eventually_ray_mem_slit] with t ht
    rw [contSlit_congr h ht]
  unfold resSlit limUnder
  rw [Filter.map_congr heq]

variable {F : Type*} [Field F] [NumberField F] [IsTotallyComplex F] {𝔪 : Ideal (𝓞 F)}
  {ι : F →+* ℂ}

/-! ### Twisted sections -/

theorem eis_smulFun (h𝔪 : 𝔪 ≠ ⊥) (f : ℂ → ℂ) (hf : Differentiable ℂ f) (Ψ : TSection ι 𝔪)
    {s : ℂ} (hs : 2 < s.re) (Q : X F) :
    eis (TSection.smulFun f hf Ψ) s Q = f s * eis Ψ s Q := by
  have h1 := (hasSum_eis h𝔪 Ψ hs Q).mul_left (f s)
  have h2 := hasSum_eis h𝔪 (TSection.smulFun f hf Ψ) hs Q
  refine h2.unique (h1.congr_fun fun q => ?_)
  simp only [term, TSection.smulFun_apply]
  ring

section coef

variable {Ψ Ψ' : TSection ι 𝔪} {ν' : F} {a₀ b₀ : ℂ → ℂ} {D : Set (InfinitePlace F → ℂ)} {κ : ℂ}

theorem HasCoefT.smulFun (h𝔪 : 𝔪 ≠ ⊥) (f : ℂ → ℂ) (hf : Differentiable ℂ f)
    (h : HasCoefT Ψ ν' a₀ D κ) :
    HasCoefT (TSection.smulFun f hf Ψ) ν' (fun s => f s * a₀ s) D κ := by
  intro s hs v hv
  simp only [eis_smulFun h𝔪 f hf Ψ hs, mul_assoc]
  rw [integral_const_mul, h s hs v hv]
  ring

/-- The coefficient series is determined by one admissible cell. -/
theorem HasCoefT.unique (h : HasCoefT Ψ ν' a₀ D κ) (h' : HasCoefT Ψ ν' b₀ D κ) (hκ : κ ≠ 0)
    (hD0 : volume D ≠ 0) (hDt : volume D ≠ ⊤) {s : ℂ} (hs : 2 < s.re) : a₀ s = b₀ s := by
  obtain ⟨δ, hδ, hne⟩ := exists_WX_ne_zero (F := F) ν' (show 1 < s.re by linarith)
  have hv : ∀ w : InfinitePlace F, 0 < (fun _ : InfinitePlace F => δ / 2) w := fun _ => by
    positivity
  have hW : Winf s ν' (fun _ : InfinitePlace F => δ / 2) ≠ 0 :=
    hne (X.mk 0 _ hv) fun w => by
      change δ / 2 < δ
      linarith
  have h1 := (h s hs _ hv).symm.trans (h' s hs _ hv)
  have hvol : (((volume D).toReal : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ENNReal.toReal_ne_zero.mpr ⟨hD0, hDt⟩)
  exact mul_left_cancel₀ (mul_ne_zero (mul_ne_zero hvol hκ) hW) h1

end coef

/-! ### Genuine sections -/

section genuine

variable {P : CubicPkg F} (hG : Good 𝔪) {z6 : 𝓞 F} (hz6 : IsPrimitiveRoot z6 6)
  (Φ Φ' : GSection ι P 𝔪) {ν : SInt 𝔪}

theorem twist_smulFun (f : ℂ → ℂ) (hf : Differentiable ℂ f) :
    (GSection.smulFun f hf Φ).twist hG hz6 = TSection.smulFun f hf (Φ.twist hG hz6) := by
  ext s p
  simp only [GSection.twist_apply, GSection.smulFun_apply, TSection.smulFun_apply]
  ring

theorem validDepth_smulFun {ν' : F} {M : ℤ} (h : ValidDepth hG Φ ν' M) (f : ℂ → ℂ)
    (hf : Differentiable ℂ f) : ValidDepth hG (GSection.smulFun f hf Φ) ν' M :=
  ⟨fun b hb s c d => by rw [GSection.smulFun_apply, GSection.smulFun_apply, h.unip b hb],
    h.char⟩

/-- **The Kubota series commutes with multiplication by an entire function of `s`.** -/
theorem aSer_smulFun (hν : ν ≠ 0) (f : ℂ → ℂ) (hf : Differentiable ℂ f) {s : ℂ}
    (hs : 2 < s.re) :
    (kubota hG hz6).aSer (GSection.smulFun f hf Φ) ν s = f s * (kubota hG hz6).aSer Φ ν s := by
  have h𝔪 := hG.ne_bot
  obtain ⟨M, hM, hV⟩ := exists_validDepth_nonneg hG Φ (ν : F)
  have hD₀ := pcell_cellM h𝔪 hM
  have hb₀ := cellM_bdd h𝔪 hM
  have h1 : HasCoef hG hz6 Φ ν (cellM 𝔪 M) (kap 𝔪 M) := hasCoef_transLat hν hM hV hD₀ hb₀
  have h3 : HasCoef hG hz6 (GSection.smulFun f hf Φ) ν (cellM 𝔪 M) (kap 𝔪 M) :=
    hasCoef_transLat hν hM (validDepth_smulFun hG Φ hV f hf) hD₀ hb₀
  have h4 := HasCoefT.smulFun h𝔪 f hf h1
  unfold HasCoef at h3
  rw [twist_smulFun] at h3
  exact h3.unique h4 (kap_ne_zero h𝔪 hM)
    ((hD₀.isAddFundamentalDomain volume).measure_ne_zero (NeZero.ne _))
    (volume_ne_top_of_bdd hb₀) hs

/-- **`τ_{f·Φ}(ν) = f(4/3)·τ_Φ(ν)`** for an entire function `f` of `s`. -/
theorem tau_smulFun_oai (hν : ν ≠ 0) (f : ℂ → ℂ) (hf : Differentiable ℂ f) :
    tau hG hz6 (GSection.smulFun f hf Φ) ν = f (4 / 3) * tau hG hz6 Φ ν := by
  unfold tau
  rw [resSlit_congr fun s hs => aSer_smulFun hG hz6 Φ hν f hf hs]
  exact resSlit_mul_of_seed P hG hz6 (coe_ne_zero hν) (hasSeed hG hz6 Φ hν) hf

end genuine

end

