      ∧ (∀ t, Real.cos (ψf t)
          = (lineQhat g z₀ θ (chartClamp a b η t)).re / Real.cos (δf t))
      ∧ (∀ t, Real.sin (ψf t)
          = -Real.sqrt (normSq (linePhat g z₀ θ (chartClamp a b η t)))
              / Real.cos (δf t)) := by
  have hWconv : Convex ℝ (Set.Icc (a - η) (b + η)) := convex_Icc _ _
  have hclmem : ∀ t, chartClamp a b η t ∈ Set.Icc (a - η) (b + η) :=
    chartClamp_mem hη hab
  have hclid : ∀ t ∈ Set.Icc a b, chartClamp a b η t = t := fun t ht =>
    chartClamp_of_mem hη ht

  have hPpos : ∀ u ∈ Set.Icc (a - η) (b + η), 0 < normSq (linePhat g z₀ θ u) := fun u hu =>
    lt_of_lt_of_le (by linarith) (hguard u hu)
  have hPne : ∀ u ∈ Set.Icc (a - η) (b + η),
      botP g (z₀ + u * Complex.exp (θ * Complex.I)) ≠ 0 := by
    intro u hu h0
    have hp := hPpos u hu
    rw [linePhat, h0, zero_div, normSq_zero] at hp
    exact lt_irrefl 0 hp

  obtain ⟨μf, hμs, hμprop, hμtow⟩ := exists_smooth_arg_branch (-(botP g z₀))
    (-(Complex.exp (θ * Complex.I) * g 1 0)) hWconv (by
      intro u hu h0
      have hne := hPne u hu
      rw [botP_line] at hne
      apply hne
      have h1 : -(botP g z₀ + (u : ℂ) * (Complex.exp (θ * Complex.I) * g 1 0)) = 0 := by
        rw [← h0]; ring
      exact neg_eq_zero.mp h1)

  have hμtow' : ∀ k t, |iteratedDeriv (k + 1) μf t|
      ≤ (k ! : ℝ) * (Real.sqrt (normSq (Complex.exp (θ * Complex.I) * g 1 0))
          / ‖botP g z₀ + t * (Complex.exp (θ * Complex.I) * g 1 0)‖) ^ (k + 1) := by
    intro k t
    have h := hμtow k t
    rw [normSq_neg] at h
    have hn : (-(botP g z₀) + (t : ℂ) * -(Complex.exp (θ * Complex.I) * g 1 0))
        = -(botP g z₀ + (t : ℂ) * (Complex.exp (θ * Complex.I) * g 1 0)) := by ring
    rwa [hn, norm_neg] at h

  have hμP : ∀ u ∈ Set.Icc (a - η) (b + η),
      Complex.exp ((μf u : ℂ) * Complex.I) * (-(linePhat g z₀ θ u))
        = (‖linePhat g z₀ θ u‖ : ℂ) := by
    intro u hu
    have h1 := hμprop u hu
    have hrpos := radC_line_pos hg z₀ θ u
    have hpath : (-(botP g z₀) + (u : ℂ) * -(Complex.exp (θ * Complex.I) * g 1 0))
        = -(botP g (z₀ + u * Complex.exp (θ * Complex.I))) := by
      rw [botP_line]; ring
    rw [hpath] at h1
    rw [linePhat, ← neg_div, ← mul_div_assoc, h1, norm_neg, norm_div, Complex.ofReal_div]
    congr 1
    have hnr : ‖((radC g (z₀ + (u : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)) : ℝ) : ℂ)‖
        = radC g (z₀ + (u : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)) := by
      simp [abs_of_pos hrpos]
    rw [hnr]

  have hQim : ContDiff ℝ ∞ fun t => (lineQhat g z₀ θ (chartClamp a b η t)).im :=
    Complex.imCLM.contDiff.comp ((contDiff_lineQhat hg z₀ θ).comp (contDiff_chartClamp a b η))
  have hQbound : ∀ t, (lineQhat g z₀ θ (chartClamp a b η t)).im ^ 2 ≤ 1 / 2 + m := by
    intro t
    have hrow := normSq_linePhat_add_lineQSq hg z₀ θ (chartClamp a b η t)
    have hpl := hguard _ (hclmem t)
    have hns : (lineQhat g z₀ θ (chartClamp a b η t)).im ^ 2
        ≤ lineQSq g z₀ θ (chartClamp a b η t) := by
      rw [lineQSq, normSq_apply]
      nlinarith [sq_nonneg (lineQhat g z₀ θ (chartClamp a b η t)).re]
    nlinarith
  have hQlt : ∀ t, (lineQhat g z₀ θ (chartClamp a b η t)).im ^ 2 < 1 := fun t =>
    lt_of_le_of_lt (hQbound t) (by linarith)
  have hQne1 : ∀ t, (lineQhat g z₀ θ (chartClamp a b η t)).im ≠ 1 := by
    intro t h1
    have := hQlt t
    rw [h1] at this
    norm_num at this
  have hQneNeg1 : ∀ t, (lineQhat g z₀ θ (chartClamp a b η t)).im ≠ -1 := by
    intro t h1
    have := hQlt t
    rw [h1] at this
    norm_num at this
  have hδs : ContDiff ℝ ∞ fun t =>
      -Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im) := by
    refine ContDiff.neg ?_
    rw [contDiff_iff_contDiffAt]
    intro t
    show ContDiffAt ℝ ∞
      (Real.arcsin ∘ fun s => (lineQhat g z₀ θ (chartClamp a b η s)).im) t
    exact (Real.contDiffAt_arcsin (hQneNeg1 t) (hQne1 t)).comp t hQim.contDiffAt

  have hcosδ : ∀ t, Real.cos (-Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im))
      = Real.sqrt (1 - (lineQhat g z₀ θ (chartClamp a b η t)).im ^ 2) := by
    intro t
    rw [Real.cos_neg, Real.cos_arcsin]
  have hcosδ_pos : ∀ t,
      0 < Real.cos (-Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im)) := by
    intro t
    rw [hcosδ t]
    exact Real.sqrt_pos.2 (by nlinarith [hQbound t])

  have hxs : ContDiff ℝ ∞ fun t =>
      (lineQhat g z₀ θ (chartClamp a b η t)).re
        / Real.cos (-Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im)) := by
    refine ContDiff.div ?_ (Real.contDiff_cos.comp hδs) fun t => (hcosδ_pos t).ne'
    exact Complex.reCLM.contDiff.comp
      ((contDiff_lineQhat hg z₀ θ).comp (contDiff_chartClamp a b η))
  have hys : ContDiff ℝ ∞ fun t =>
      -Real.sqrt (normSq (linePhat g z₀ θ (chartClamp a b η t)))
        / Real.cos (-Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im)) := by
    refine ContDiff.div (ContDiff.neg ?_) (Real.contDiff_cos.comp hδs)
      fun t => (hcosδ_pos t).ne'
    rw [contDiff_iff_contDiffAt]
    intro t
    show ContDiffAt ℝ ∞
      (Real.sqrt ∘ fun s => normSq (linePhat g z₀ θ (chartClamp a b η s))) t
    exact (Real.contDiffAt_sqrt (hPpos _ (hclmem t)).ne').comp t
      (contDiff_normSq_comp ((contDiff_linePhat hg z₀ θ).comp
        (contDiff_chartClamp a b η))).contDiffAt
  have hcircle : ∀ t,
      ((lineQhat g z₀ θ (chartClamp a b η t)).re
        / Real.cos (-Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im))) ^ 2
      + (-Real.sqrt (normSq (linePhat g z₀ θ (chartClamp a b η t)))
        / Real.cos (-Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im))) ^ 2 = 1 := by
    intro t
    have hc2 : Real.cos (-Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im)) ^ 2
        = 1 - (lineQhat g z₀ θ (chartClamp a b η t)).im ^ 2 := by
      rw [hcosδ t, Real.sq_sqrt (by nlinarith [hQlt t])]
    have hrow := normSq_linePhat_add_lineQSq hg z₀ θ (chartClamp a b η t)
    have hsq : Real.sqrt (normSq (linePhat g z₀ θ (chartClamp a b η t))) ^ 2
        = normSq (linePhat g z₀ θ (chartClamp a b η t)) :=
      Real.sq_sqrt (normSq_nonneg _)
    have hns : lineQSq g z₀ θ (chartClamp a b η t)
        = (lineQhat g z₀ θ (chartClamp a b η t)).re ^ 2
          + (lineQhat g z₀ θ (chartClamp a b η t)).im ^ 2 := by
      rw [lineQSq, normSq_apply]
      ring
    have hcne := (hcosδ_pos t).ne'
    field_simp
    nlinarith [hc2, hrow, hsq, hns]
  obtain ⟨ψf, hψs, hψcos, hψsin, _⟩ := exists_smooth_circle_lift hxs hys hcircle

  refine ⟨μf, ψf, fun t => -Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im),
    hμs, hψs, hδs, ?_, hμtow', hμP, rfl, fun t => hψcos t, fun t => hψsin t⟩
  intro t ht
  have hclt : chartClamp a b η t = t := hclid t ht
  have hWt : t ∈ Set.Icc (a - η) (b + η) :=
    Set.Icc_subset_Icc (by linarith) (by linarith) ht
  have habs : ((lineQhat g z₀ θ (chartClamp a b η t)).im) ^ 2 ≤ 1 := (hQlt t).le
  have hδ' : Real.sin (-Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im))
      = -(botQ g (z₀ + t * Complex.exp (θ * Complex.I))
          / (radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℂ)).im := by
    rw [Real.sin_neg, Real.sin_arcsin (by nlinarith [habs]) (by nlinarith [habs]), hclt]
    rfl
  have hc' : Real.cos (2 * (ψf t / 2))
        * Real.cos (-Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im))
      = (botQ g (z₀ + t * Complex.exp (θ * Complex.I))
          / (radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℂ)).re := by
    rw [show 2 * (ψf t / 2) = ψf t from by ring, hψcos t,
      div_mul_cancel₀ _ (hcosδ_pos t).ne', hclt]
    rfl
  have hs' : Real.sin (2 * (ψf t / 2))
        * Real.cos (-Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im))
      = -‖botP g (z₀ + t * Complex.exp (θ * Complex.I))
          / (radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℂ)‖ := by
    rw [show 2 * (ψf t / 2) = ψf t from by ring, hψsin t,
      div_mul_cancel₀ _ (hcosδ_pos t).ne', hclt]
    have hnorm : ‖linePhat g z₀ θ t‖ = Real.sqrt (normSq (linePhat g z₀ θ t)) := by
      rw [normSq_eq_norm_sq, Real.sqrt_sq (norm_nonneg _)]
    rw [show Real.sqrt (normSq (linePhat g z₀ θ t)) = ‖linePhat g z₀ θ t‖ from hnorm.symm]
    rfl
  have hμ' : Complex.exp ((μf t : ℂ) * Complex.I)
        * (-(botP g (z₀ + t * Complex.exp (θ * Complex.I))
          / (radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℂ)))
      = (‖botP g (z₀ + t * Complex.exp (θ * Complex.I))
          / (radC g (z₀ + t * Complex.exp (θ * Complex.I)) : ℂ)‖ : ℂ) :=
    hμP t hWt
