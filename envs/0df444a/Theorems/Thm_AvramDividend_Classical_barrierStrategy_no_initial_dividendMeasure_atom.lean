-- title:
--   Below-barrier initial capital produces no dividend Stieltjes atom at zero
-- statement:
--   For any spectrally negative Levy path, nonnegative initial reserve x and cap a with x no greater than a, the Stieltjes dividend measure generated by the barrier strategy assigns zero to time zero. This separates the no-initial-payment case from the already established above-barrier initial lump-sum case.
-- source:
--   Consequence of Proved barrierStrategy_isDividendStrategy_nonnegative_barrier, dividendMeasure_singleton_eq_rightLimit_sub and barrierStrategy_right_increment_formula.

import Theorems.Thm_AvramDividend_Classical_dividendMeasure_singleton_eq_rightLimit_sub
import Theorems.Thm_AvramDividend_Classical_barrierStrategy_isDividendStrategy_nonnegative_barrier
import Theorems.Thm_AvramDividend_Classical_barrierStrategy_right_increment_formula
open AvramDividend.Classical MeasureTheory
open scoped NNReal ENNReal

theorem AvramDividend.Classical.barrierStrategy_no_initial_dividendMeasure_atom
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
    {𝓕 : Filtration ℝ≥0 mΩ}
    (X : SpectrallyNegativeLevy P 𝓕) (x a : ℝ)
    (hx : 0 ≤ x) (ha : 0 ≤ a) (hxa : x ≤ a) (ω : Ω) :
    dividendMeasure (barrierStrategy X x a) ω ({0} : Set ℝ) = 0 := by sorry
