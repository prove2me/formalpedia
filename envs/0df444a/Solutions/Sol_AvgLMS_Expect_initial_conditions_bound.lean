theorem q_eq {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {d : ℕ}
    {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}
    (hA : LMSAssumptions μ x z H θstar R σ) (v : Hs d) :
    ⟪v, H v⟫_ℝ = ∫ ω, ⟪x 1 ω, v⟫_ℝ ^ 2 ∂μ := by
  rw [hA.cov_eq v v]; congr 1; funext ω; ring

theorem q_nonneg {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {d : ℕ}
    {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}
    (hA : LMSAssumptions μ x z H θstar R σ) (v : Hs d) :
    0 ≤ ⟪v, H v⟫_ℝ := by
  rw [q_eq hA]; exact integral_nonneg fun _ => sq_nonneg _

theorem int_sq {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {d : ℕ}
    {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}
    (hA : LMSAssumptions μ x z H θstar R σ) (v : Hs d) :
    Integrable (fun ω => ⟪x 1 ω, v⟫_ℝ ^ 2) μ :=
  (hA.integrable_cov v v).congr (Filter.Eventually.of_forall fun ω => by dsimp only; ring)

theorem norm_step_sq {d : ℕ} (γ : ℝ) (v y : Hs d) :
    ‖v - γ • (⟪y, v⟫_ℝ • y)‖ ^ 2 =
      ‖v‖ ^ 2 - 2 * γ * ⟪y, v⟫_ℝ ^ 2 + γ ^ 2 * (‖y‖ ^ 2 * ⟪y, v⟫_ℝ ^ 2) := by
  rw [smul_smul, norm_sub_sq_real, inner_smul_right, norm_smul, mul_pow, Real.norm_eq_abs,
    sq_abs, real_inner_comm v y]
  ring

theorem step_bound {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    {d : ℕ} {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}
    (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ) (hγ0 : 0 < γ) (hγR : γ * R ^ 2 ≤ 1)
    (v : Hs d) :
    Integrable (fun ω => ‖v - γ • (⟪x 1 ω, v⟫_ℝ • x 1 ω)‖ ^ 2 + γ * ⟪v, H v⟫_ℝ) μ ∧
    ∫ ω, (‖v - γ • (⟪x 1 ω, v⟫_ℝ • x 1 ω)‖ ^ 2 + γ * ⟪v, H v⟫_ℝ) ∂μ ≤ ‖v‖ ^ 2 := by
  have e : (fun ω => ‖v - γ • (⟪x 1 ω, v⟫_ℝ • x 1 ω)‖ ^ 2 + γ * ⟪v, H v⟫_ℝ) =
      fun ω => (‖v‖ ^ 2 + γ * ⟪v, H v⟫_ℝ) +
        ((-2 * γ) * ⟪x 1 ω, v⟫_ℝ ^ 2 + γ ^ 2 * (‖x 1 ω‖ ^ 2 * ⟪x 1 ω, v⟫_ℝ ^ 2)) := by
    funext ω; rw [norm_step_sq]; ring
  have i1 : Integrable (fun ω => (-2 * γ) * ⟪x 1 ω, v⟫_ℝ ^ 2) μ := (int_sq hA v).const_mul _
  have i2 : Integrable (fun ω => γ ^ 2 * (‖x 1 ω‖ ^ 2 * ⟪x 1 ω, v⟫_ℝ ^ 2)) μ :=
    (hA.integrable_fourth v).const_mul _
  have i12 : Integrable (fun ω => (-2 * γ) * ⟪x 1 ω, v⟫_ℝ ^ 2 +
      γ ^ 2 * (‖x 1 ω‖ ^ 2 * ⟪x 1 ω, v⟫_ℝ ^ 2)) μ := i1.add i2
  rw [e]
  refine ⟨(integrable_const _).add i12, ?_⟩
  rw [integral_add (integrable_const _) i12, integral_const, integral_add i1 i2,
    integral_const_mul, integral_const_mul, ← q_eq hA v]
  simp only [probReal_univ, one_smul]
  have h4 := hA.fourth_le v
  have hq := q_nonneg hA v
  have a1 : γ ^ 2 * (∫ ω, ‖x 1 ω‖ ^ 2 * ⟪x 1 ω, v⟫_ℝ ^ 2 ∂μ) ≤
      γ ^ 2 * (R ^ 2 * ⟪v, H v⟫_ℝ) := mul_le_mul_of_nonneg_left h4 (sq_nonneg γ)
  have a2 : γ * (γ * R ^ 2) * ⟪v, H v⟫_ℝ ≤ γ * 1 * ⟪v, H v⟫_ℝ := by gcongr
  nlinarith

/-- The σ-algebra generated by the observation pair `(x (j+1), z (j+1))`. -/
noncomputable def obsSig {Ω : Type*} {d : ℕ} (x z : ℕ → Ω → Hs d) (j : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => (x (j + 1) ω, z (j + 1) ω)) inferInstance

/-- The σ-algebra of the first `k` observation pairs. -/
noncomputable def past {Ω : Type*} {d : ℕ} (x z : ℕ → Ω → Hs d) (k : ℕ) : MeasurableSpace Ω :=
  ⨆ j ∈ {j : ℕ | j < k}, obsSig x z j

theorem meas_step {Ω : Type*} [MeasurableSpace Ω] {d : ℕ} (γ : ℝ) (f g : Ω → Hs d)
    (hf : Measurable f) (hg : Measurable g) :
    Measurable (fun ω => f ω - γ • (⟪g ω, f ω⟫_ℝ • g ω)) :=
  (Continuous.measurable (by fun_prop :
    Continuous fun p : Hs d × Hs d => p.1 - γ • (⟪p.2, p.1⟫_ℝ • p.2))).comp (hf.prodMk hg)

theorem x_meas_obs {Ω : Type*} {d : ℕ} (x z : ℕ → Ω → Hs d) (k : ℕ) :
    Measurable[obsSig x z k] (x (k + 1)) :=
  measurable_fst.comp (comap_measurable (fun ω => (x (k + 1) ω, z (k + 1) ω)))

theorem obs_le_past {Ω : Type*} {d : ℕ} (x z : ℕ → Ω → Hs d) {j k : ℕ} (h : j < k) :
    obsSig x z j ≤ past x z k :=
  le_iSup₂ (f := fun j (_ : j ∈ {j : ℕ | j < k}) => obsSig x z j) j h

theorem past_mono {Ω : Type*} {d : ℕ} (x z : ℕ → Ω → Hs d) (k : ℕ) :
    past x z k ≤ past x z (k + 1) :=
  iSup₂_le fun j hj => obs_le_past x z (Nat.lt_succ_of_lt hj)

theorem bias_meas_past {Ω : Type*} {d : ℕ} (x z : ℕ → Ω → Hs d) (γ : ℝ) (η0 : Hs d) :
    ∀ k, Measurable[past x z k] (biasIter γ η0 x k)
  | 0 => measurable_const
  | k + 1 => by
      have h1 : Measurable[past x z (k + 1)] (biasIter γ η0 x k) :=
        (bias_meas_past x z γ η0 k).mono (past_mono x z k) le_rfl
      have h2 : Measurable[past x z (k + 1)] (x (k + 1)) :=
        (x_meas_obs x z k).mono (obs_le_past x z (Nat.lt_succ_self k)) le_rfl
      exact @meas_step Ω (past x z (k + 1)) d γ _ _ h1 h2

theorem obs_le {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {d : ℕ}
    {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}
    (hA : LMSAssumptions μ x z H θstar R σ) (j : ℕ) :
    obsSig x z j ≤ ‹MeasurableSpace Ω› :=
  ((hA.measurable_x (j + 1)).prodMk (hA.measurable_z (j + 1))).comap_le

theorem bias_meas {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {d : ℕ}
    {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}
    (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ) (η0 : Hs d) (k : ℕ) :
    Measurable (biasIter γ η0 x k) :=
  (bias_meas_past x z γ η0 k).mono (iSup₂_le fun j _ => obs_le hA j) le_rfl

theorem indep_step {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    {d : ℕ} {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}
    (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ) (η0 : Hs d) (k : ℕ) :
    IndepFun (biasIter γ η0 x k) (x (k + 1)) μ := by
  have hind : iIndep (obsSig x z) μ := (iIndepFun_iff_iIndep _ _ μ).1 hA.indep
  have hI := indep_iSup_of_disjoint (obs_le hA) hind (S := {j : ℕ | j < k}) (T := {k})
    (Set.disjoint_singleton_right.2 (lt_irrefl k))
  rw [IndepFun_iff_Indep]
  refine indep_of_indep_of_le_right
    (indep_of_indep_of_le_left hI (bias_meas_past x z γ η0 k).comap_le) ?_
  exact (x_meas_obs x z k).comap_le.trans
    (le_iSup₂ (f := fun j (_ : j ∈ ({k} : Set ℕ)) => obsSig x z j) k rfl)

theorem lint_step {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    {d : ℕ} {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}
    (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ) (hγ0 : 0 < γ) (hγR : γ * R ^ 2 ≤ 1)
    (η0 : Hs d) (k : ℕ) :
    ∫⁻ ω, ENNReal.ofReal (‖biasIter γ η0 x (k + 1) ω‖ ^ 2) ∂μ +
      ENNReal.ofReal γ * ∫⁻ ω, ENNReal.ofReal ⟪biasIter γ η0 x k ω, H (biasIter γ η0 x k ω)⟫_ℝ ∂μ
      ≤ ∫⁻ ω, ENNReal.ofReal (‖biasIter γ η0 x k ω‖ ^ 2) ∂μ := by
  set η := biasIter γ η0 x k with hη_def
  have hsucc : ∀ ω, biasIter γ η0 x (k + 1) ω = η ω - γ • (⟪x (k + 1) ω, η ω⟫_ℝ • x (k + 1) ω) :=
    fun ω => rfl
  have hηm : Measurable η := bias_meas hA γ η0 k
  have hxm : Measurable (x (k + 1)) := hA.measurable_x (k + 1)
  let Φ : Hs d × Hs d → ENNReal := fun p =>
    ENNReal.ofReal (‖p.1 - γ • (⟪p.2, p.1⟫_ℝ • p.2)‖ ^ 2 + γ * ⟪p.1, H p.1⟫_ℝ)
  have hΦ : Measurable Φ := ENNReal.measurable_ofReal.comp (Continuous.measurable (by fun_prop))
  have hm1 : Measurable fun ω => ENNReal.ofReal (‖biasIter γ η0 x (k + 1) ω‖ ^ 2) :=
    ENNReal.measurable_ofReal.comp ((bias_meas hA γ η0 (k + 1)).norm.pow_const 2)
  have hm2 : Measurable fun ω => ENNReal.ofReal ⟪η ω, H (η ω)⟫_ℝ :=
    ENNReal.measurable_ofReal.comp (hηm.inner (H.continuous.measurable.comp hηm))
  have hlhs : ∫⁻ ω, ENNReal.ofReal (‖biasIter γ η0 x (k + 1) ω‖ ^ 2) ∂μ +
      ENNReal.ofReal γ * ∫⁻ ω, ENNReal.ofReal ⟪η ω, H (η ω)⟫_ℝ ∂μ =
      ∫⁻ ω, Φ (η ω, x (k + 1) ω) ∂μ := by
    rw [← lintegral_const_mul _ hm2, ← lintegral_add_left hm1]
    congr 1; funext ω
    simp only [Φ]
    rw [ENNReal.ofReal_add (sq_nonneg _) (mul_nonneg hγ0.le (q_nonneg hA _)),
      ENNReal.ofReal_mul hγ0.le, hsucc]
  have hmap : μ.map (x (k + 1)) = μ.map (x 1) :=
    ((hA.identDistrib k).comp measurable_fst).map_eq
  have hI := indep_step hA γ η0 k
  calc _ = ∫⁻ ω, Φ (η ω, x (k + 1) ω) ∂μ := hlhs
    _ = ∫⁻ p, Φ p ∂(μ.map fun ω => (η ω, x (k + 1) ω)) :=
        (lintegral_map hΦ (hηm.prodMk hxm)).symm
    _ = ∫⁻ v, ∫⁻ y, Φ (v, y) ∂(μ.map (x 1)) ∂(μ.map η) := by
        rw [hI.map_prod_eq_prod_map_map hηm.aemeasurable hxm.aemeasurable,
          lintegral_prod _ hΦ.aemeasurable, hmap]
    _ ≤ ∫⁻ v, ENNReal.ofReal (‖v‖ ^ 2) ∂(μ.map η) := by
        refine lintegral_mono fun v => ?_
        have hmv : Measurable fun y : Hs d => Φ (v, y) :=
          hΦ.comp (measurable_const.prodMk measurable_id)
        rw [lintegral_map hmv (hA.measurable_x 1)]
        obtain ⟨hint, hle⟩ := step_bound hA γ hγ0 hγR v
        rw [← ofReal_integral_eq_lintegral_ofReal hint (Filter.Eventually.of_forall fun ω =>
          add_nonneg (sq_nonneg _) (mul_nonneg hγ0.le (q_nonneg hA v)))]
        exact ENNReal.ofReal_le_ofReal hle
    _ = ∫⁻ ω, ENNReal.ofReal (‖η ω‖ ^ 2) ∂μ :=
        lintegral_map (ENNReal.measurable_ofReal.comp (measurable_norm.pow_const 2)) hηm

theorem telescope {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    {d : ℕ} {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}
    (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ) (hγ0 : 0 < γ) (hγR : γ * R ^ 2 ≤ 1)
    (η0 : Hs d) : ∀ n : ℕ,
    ∫⁻ ω, ENNReal.ofReal (‖biasIter γ η0 x n ω‖ ^ 2) ∂μ +
      ENNReal.ofReal γ * ∑ k ∈ Finset.range n,
        ∫⁻ ω, ENNReal.ofReal ⟪biasIter γ η0 x k ω, H (biasIter γ η0 x k ω)⟫_ℝ ∂μ
      ≤ ENNReal.ofReal (‖η0‖ ^ 2)
  | 0 => by simp [biasIter]
  | n + 1 => by
      rw [Finset.sum_range_succ, mul_add, ← add_assoc]
      calc _ ≤ ∫⁻ ω, ENNReal.ofReal (‖biasIter γ η0 x n ω‖ ^ 2) ∂μ +
            ENNReal.ofReal γ * ∑ k ∈ Finset.range n,
              ∫⁻ ω, ENNReal.ofReal ⟪biasIter γ η0 x k ω, H (biasIter γ η0 x k ω)⟫_ℝ ∂μ := by
            rw [add_right_comm]
            gcongr
            exact lint_step hA γ hγ0 hγR η0 n
        _ ≤ _ := telescope hA γ hγ0 hγR η0 n

theorem q_smul {d : ℕ} (H : Hs d →L[ℝ] Hs d) (c : ℝ) (v : Hs d) :
    ⟪c • v, H (c • v)⟫_ℝ = c ^ 2 * ⟪v, H v⟫_ℝ := by
  rw [map_smul, real_inner_smul_left, real_inner_smul_right]; ring

theorem q_sum_le {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {d : ℕ}
    {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}
    (hA : LMSAssumptions μ x z H θstar R σ) {ι : Type*} (s : Finset ι) (w : ι → Hs d) :
    ⟪∑ i ∈ s, w i, H (∑ i ∈ s, w i)⟫_ℝ ≤ s.card * ∑ i ∈ s, ⟪w i, H (w i)⟫_ℝ := by
  rw [q_eq hA, Finset.sum_congr rfl fun i _ => q_eq hA (w i),
    ← integral_finsetSum s (fun i _ => int_sq hA (w i)), ← integral_const_mul]
  refine integral_mono (int_sq hA _)
    ((integrable_finsetSum s fun i _ => int_sq hA (w i)).const_mul _) fun ω => ?_
  simp only [inner_sum]
  exact sq_sum_le_card_mul_sum_sq

