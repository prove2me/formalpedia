theorem not_zX_of_lt {j : Fin HS} (h : j.val < 56) : j ∉ zX.all := by
  simp only [zX_all, List.mem_cons, List.not_mem_nil, or_false]
  intro hh; rcases hh with hh | hh | hh | hh | hh | hh | hh | hh <;>
    (rw [hh] at h; exact absurd h (by decide))

theorem accSeq_prodG (N : ℕ) : ∀ k ≤ N, accSeq (prodG N) 1 k = (N.descFactorial k : ℤ)
  | 0, _ => by simp [accSeq]
  | k + 1, hk => by
    rw [accSeq, accSeq_prodG N k (by omega), prodG, Nat.descFactorial_succ]
    push_cast [show k ≤ N by omega]; ring

theorem prodB_step (rd : Fin HS) (s : IState HS) (N : ℕ) (hd56 : rd.val < 56) (hdI : rd ≠ NLogN.KFM.sI) :
    ∀ k < N, (prodB rd).ok (lpSt (s.upd rd (.int 1 :: s.G rd)) NLogN.KFM.sI rd (s.G rd) N k
        (accSeq (prodG N) 1 k)) ∧
      (prodB rd).run (lpSt (s.upd rd (.int 1 :: s.G rd)) NLogN.KFM.sI rd (s.G rd) N k (accSeq (prodG N) 1 k)) =
      (lpSt (s.upd rd (.int 1 :: s.G rd)) NLogN.KFM.sI rd (s.G rd) N k (accSeq (prodG N) 1 k)).upd rd
        (.int (prodG N k (accSeq (prodG N) 1 k)) :: s.G rd) := by
  intro k hk
  set u := lpSt (s.upd rd (.int 1 :: s.G rd)) NLogN.KFM.sI rd (s.G rd) N k (accSeq (prodG N) 1 k) with hu
  have uD : u.G rd = .int (accSeq (prodG N) 1 k) :: s.G rd := lpSt_G_a _ _ _ _ _ _ _
  have uI : u.G NLogN.KFM.sI = .int ((N : ℤ) - k) :: (s.upd rd (.int 1 :: s.G rd)).G sI :=
    lpSt_G_i _ _ _ _ _ _ _ (Ne.symm hdI)
  refine ⟨⟨hd56, ?_, ⟨IState.isInt_of uD, IState.isInt_of uI⟩, IState.isInt_of uD⟩, ?_⟩
  · intro j hj
    simp only [Ex.regs, List.mem_append, List.mem_singleton] at hj
    rcases hj with rfl | rfl
    · exact not_zX_of_lt hd56
    · decide
  · simp only [prodB, RS.run, Ex.eval, IState.top_eq uD, IState.top_eq uI, uD, List.tail_cons, prodG]

