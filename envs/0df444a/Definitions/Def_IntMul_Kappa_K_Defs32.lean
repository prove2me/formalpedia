    (U : IStmt HS Pp) (f g : Fin HS → List ℤ) (c : ℕ) : Prop :=
  ∀ s, Agree σ s → IRuns I iprog U (NLogN.KIL.encK s f) (NLogN.KIL.encK s g) c

variable {σ : Fin HS → Option ℤ} {U V : IStmt HS Pp} {f g h : Fin HS → List ℤ} {c c' : ℕ}

end Run

