open Module Matrix
open scoped Matrix
open scoped InnerProductSpace ComplexOrder

namespace FinDimAux


section MatrixPrelude
variable {n : ℕ} (β : Matrix (Fin n) (Fin n) ℂ)

lemma herm_eq (hβ : β.IsHermitian) : β.map star = β.transpose := by
  ext i j
  rw [Matrix.map_apply, Matrix.transpose_apply]
  exact hβ.apply j i

lemma mapStar_herm (hβ : β.IsHermitian) : (β.map star).IsHermitian := by
  rw [herm_eq β hβ]
  exact (Matrix.isHermitian_transpose_iff).mp hβ

lemma mapStar_posDef (hβ : β.PosDef) : (β.map star).PosDef := by
  rw [herm_eq β hβ.1]
  exact hβ.transpose

lemma G_herm (hβ : β.IsHermitian) : (β⁻¹).IsHermitian := by
  show (β⁻¹).conjTranspose = β⁻¹
  rw [Matrix.conjTranspose_nonsing_inv, hβ]

lemma Gβ_eq_one (hβ : β.PosDef) : β⁻¹ * β = 1 := by
  refine Matrix.nonsing_inv_mul _ ?_
  rw [← Matrix.isUnit_iff_isUnit_det]
  exact hβ.isUnit

/-- The key transpose identity: `Gᵀ * (β.map star) = 1`. -/
lemma GTA_eq_one (hβ : β.PosDef) : (β⁻¹).transpose * (β.map star) = 1 := by
  have h1 : (β⁻¹).transpose = β.transpose⁻¹ :=
    Matrix.transpose_nonsing_inv _
  rw [h1, herm_eq β hβ.1]
  refine Matrix.nonsing_inv_mul _ ?_
  rw [← Matrix.isUnit_iff_isUnit_det]
  exact hβ.transpose.isUnit


end MatrixPrelude

section Model

variable {X : Type u} {n : ℕ} (β : Matrix (Fin n) (Fin n) ℂ) (w : Fin n → X → ℂ)

/-- The span of the given functions. -/
def Sw : Submodule ℂ (X → ℂ) := Submodule.span ℂ (Set.range w)

lemma memSw (i : Fin n) : w i ∈ Sw w :=
  Submodule.subset_span (Set.mem_range_self i)

/-- The family as elements of the span. -/
def wf (i : Fin n) : ↥(Sw w) := ⟨w i, memSw w i⟩

/-- Linear independence transfers to the span. -/
lemma wf_linearIndependent (hw : LinearIndependent ℂ w) :
    LinearIndependent ℂ (wf w) := by
  have h2 : (⇑(Submodule.subtype (Sw w))) ∘ (wf w) = w := by
    funext i
    rfl
  have h3 : LinearIndependent ℂ (⇑(Submodule.subtype (Sw w)) ∘ (wf w)) := by
    rw [h2]
    exact hw
  exact LinearIndependent.of_comp (Submodule.subtype (Sw w)) h3

/-- The family spans the span (tautologically, via the coercion). -/
lemma span_wf_mem (z : X → ℂ) (hz : z ∈ Sw w) :
    (⟨z, hz⟩ : ↥(Sw w)) ∈ Submodule.span ℂ (Set.range (wf w)) := by
  induction hz using Submodule.span_induction with
  | mem z' hz' =>
      obtain ⟨i, rfl⟩ := hz'
      exact Submodule.subset_span ⟨i, rfl⟩
  | zero => exact Submodule.zero_mem _
  | add _ _ _ _ h₁ h₂ => exact Submodule.add_mem _ h₁ h₂
  | smul c _ _ h => exact Submodule.smul_mem _ c h

lemma wf_spanning (u : ↥(Sw w)) : u ∈ Submodule.span ℂ (Set.range (wf w)) :=
  span_wf_mem w u.1 u.2

/-- The basis of the model space. -/
noncomputable def bS (hw : LinearIndependent ℂ w) : Basis (Fin n) ℂ ↥(Sw w) :=
  Basis.mk (wf_linearIndependent w hw) (fun u _ => wf_spanning w u)

/-- The Gram matrix of the model: the inverse of `β`. -/
noncomputable def G (β : Matrix (Fin n) (Fin n) ℂ) : Matrix (Fin n) (Fin n) ℂ := β⁻¹

/-- The inner product of the model. -/
noncomputable def inS (β : Matrix (Fin n) (Fin n) ℂ) (hw : LinearIndependent ℂ w)
    (u v : ↥(Sw w)) : ℂ :=
  ∑ i, ∑ j, (G β) i j * star ((bS w hw).repr u i) * (bS w hw).repr v j

/-- Coordinate linearity. -/
lemma repr_add (hw : LinearIndependent ℂ w) (u v z : ↥(Sw w)) :
    (bS w hw).repr (u + v) = (bS w hw).repr u + (bS w hw).repr v :=
  map_add _ _ _

/-- Quadratic positivity of the inverse Gram matrix. -/
lemma G_quad_pos (hβ : β.PosDef) {x : Fin n → ℂ} (hx : x ≠ 0) :
    0 < star x ⬝ᵥ ((G β) *ᵥ x) := by
  have hunit : IsUnit β.det := by
    rw [← Matrix.isUnit_iff_isUnit_det]
    exact hβ.isUnit
  have hAG : β * (G β) = 1 := Matrix.mul_nonsing_inv _ hunit
  have hηne : (G β) *ᵥ x ≠ 0 := by
    intro h0
    apply hx
    have hback : β *ᵥ ((G β) *ᵥ x) = x := by
      rw [Matrix.mulVec_mulVec, hAG, Matrix.one_mulVec]
    rw [h0, Matrix.mulVec_zero] at hback
    exact hback.symm
  have hkey : star x ⬝ᵥ ((G β) *ᵥ x)
      = star ((G β) *ᵥ x) ⬝ᵥ (β *ᵥ ((G β) *ᵥ x)) := by
    have hxη : x = β *ᵥ ((G β) *ᵥ x) := by
      rw [Matrix.mulVec_mulVec, hAG, Matrix.one_mulVec]
    have s1 : star x ⬝ᵥ ((G β) *ᵥ x) = ((G β) *ᵥ x) ⬝ᵥ star x :=
      dotProduct_comm _ _
    have s2 : ((G β) *ᵥ x) ⬝ᵥ star x
        = ((G β) *ᵥ x) ⬝ᵥ star (β *ᵥ ((G β) *ᵥ x)) := by
      rw [congrArg star hxη]
    have s3 : ((G β) *ᵥ x) ⬝ᵥ star (β *ᵥ ((G β) *ᵥ x))
        = ((G β) *ᵥ x) ⬝ᵥ (star ((G β) *ᵥ x) ᵥ* β) := by
      rw [star_mulVec, (hβ.1)]
    have s4 : ((G β) *ᵥ x) ⬝ᵥ (star ((G β) *ᵥ x) ᵥ* β)
        = (star ((G β) *ᵥ x) ᵥ* β) ⬝ᵥ ((G β) *ᵥ x) :=
      dotProduct_comm _ _
    have s5 : (star ((G β) *ᵥ x) ᵥ* β) ⬝ᵥ ((G β) *ᵥ x)
        = star ((G β) *ᵥ x) ⬝ᵥ (β *ᵥ ((G β) *ᵥ x)) :=
      (dotProduct_mulVec _ _ _).symm
    rw [s1, s2, s3, s4, s5]
  rw [hkey]
  exact hβ.dotProduct_mulVec_pos hηne

/-- Quadratic positivity in explicit sum form. -/
lemma G_quad_pos_sum (hβ : β.PosDef) {x : Fin n → ℂ} (hx : x ≠ 0) :
    0 < ∑ i, star (x i) * ∑ j, (G β) i j * x j := by
  have h1 : (∑ i, star (x i) * ∑ j, (G β) i j * x j)
      = star x ⬝ᵥ ((G β) *ᵥ x) := by
    simp only [dotProduct, Matrix.mulVec, star, Finset.mul_sum]
  rw [h1]
  exact G_quad_pos β hβ hx

/-- The inner product of the model is a valid `InnerProductSpace.Core` when `β` is
positive definite. -/
noncomputable def inSCore (hβ : β.PosDef) (hw : LinearIndependent ℂ w) :
    InnerProductSpace.Core ℂ ↥(Sw w) where
  inner := fun u v => inS w β hw u v
  conj_inner_symm := by
    intro u v
    have hGe : ∀ i j, (starRingEnd ℂ) ((G β) j i) = (G β) i j :=
      fun i j => by
        show (starRingEnd ℂ) ((G β) j i) = (G β) i j
        exact (G_herm β hβ.1).apply i j
    show (starRingEnd ℂ) (∑ i, ∑ j, (G β) i j * star ((bS w hw).repr v i)
          * (bS w hw).repr u j)
        = ∑ i, ∑ j, (G β) i j * star ((bS w hw).repr u i) * (bS w hw).repr v j
    have h1 : (starRingEnd ℂ) (∑ i, ∑ j, (G β) i j * star ((bS w hw).repr v i)
        * (bS w hw).repr u j)
        = ∑ i, ∑ j, (G β) j i * (bS w hw).repr v i * star ((bS w hw).repr u j) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, map_mul]
      have hs : (starRingEnd ℂ) (star ((bS w hw).repr v i)) = (bS w hw).repr v i :=
        star_star _
      have hs2 : (starRingEnd ℂ) ((bS w hw).repr u j) = star ((bS w hw).repr u j) := rfl
      rw [hs, hs2, hGe j i]
    rw [h1, Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    ring
  re_inner_nonneg := by
    intro u
    show 0 ≤ RCLike.re (∑ i, ∑ j, (G β) i j * star ((bS w hw).repr u i)
        * (bS w hw).repr u j)
    by_cases hu : ⇑((bS w hw).repr u) = 0
    · simp [hu]
    · have hsum : (∑ i, ∑ j, (G β) i j * star ((bS w hw).repr u i)
          * (bS w hw).repr u j)
          = ∑ i, star ((bS w hw).repr u i) * ∑ j, (G β) i j * (bS w hw).repr u j := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun j _ => by ring
      rw [hsum]
      have hq : 0 < ∑ i, star ((bS w hw).repr u i)
          * ∑ j, (G β) i j * (bS w hw).repr u j :=
        G_quad_pos_sum (β := β) hβ hu
      exact le_of_lt (RCLike.pos_iff.mp hq).1
  add_left := by
    intro u v z
    have hra : ∀ i : Fin n, (bS w hw).repr (u + v) i
        = (bS w hw).repr u i + (bS w hw).repr v i := by
      intro i
      show ((bS w hw).repr (u + v)) i = ((bS w hw).repr u) i + ((bS w hw).repr v) i
      rw [show ((bS w hw).repr (u + v)) = (bS w hw).repr u + (bS w hw).repr v from
        map_add _ _ _]
      rfl
    show inS w β hw (u + v) z = inS w β hw u z + inS w β hw v z
    rw [show inS w β hw (u + v) z = ∑ i, ∑ j, (G β) i j
          * star ((bS w hw).repr (u + v) i) * (bS w hw).repr z j from rfl,
      show inS w β hw u z = ∑ i, ∑ j, (G β) i j
          * star ((bS w hw).repr u i) * (bS w hw).repr z j from rfl,
      show inS w β hw v z = ∑ i, ∑ j, (G β) i j
          * star ((bS w hw).repr v i) * (bS w hw).repr z j from rfl]
    have hterm : ∀ i j : Fin n, (G β) i j * star ((bS w hw).repr (u + v) i)
          * (bS w hw).repr z j
        = (G β) i j * star ((bS w hw).repr u i) * (bS w hw).repr z j
          + (G β) i j * star ((bS w hw).repr v i) * (bS w hw).repr z j := by
      intro i j
      rw [hra i, star_add]
      ring
    rw [Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => hterm i j]
    simp only [Finset.sum_add_distrib]
  smul_left := by
    intro u v r
    have hrs : ∀ i : Fin n, (bS w hw).repr (r • u) i = r * (bS w hw).repr u i := by
      intro i
      show ((bS w hw).repr (r • u)) i = r * ((bS w hw).repr u) i
      rw [show ((bS w hw).repr (r • u)) = r • (bS w hw).repr u from map_smul _ _ _]
      rfl
    have hterm : ∀ i j : Fin n, (G β) i j * star ((bS w hw).repr (r • u) i)
          * (bS w hw).repr v j
        = (starRingEnd ℂ) r * ((G β) i j
            * star ((bS w hw).repr u i) * (bS w hw).repr v j) := by
      intro i j
      have hsr : star r = (starRingEnd ℂ) r := rfl
      rw [hrs i, star_mul, hsr]
      ring
