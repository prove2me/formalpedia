namespace IntMul.Kappa.R6.Cx.NetG

attribute [local irreducible] G1 G2 cs1 cs2 E4mv S1 E4s S2 KK PL

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw

lemma cntK_le (n : ℕ) : cntK 24 n ≤ 24 := by
  unfold cntK
  calc (∑ i : Fin 24, if n.testBit i then 1 else 0) ≤ ∑ _i : Fin 24, 1 :=
        Finset.sum_le_sum fun i _ => by split_ifs <;> norm_num
    _ = 24 := by simp

lemma dimC_le : ∀ c : Code, dimC c ≤ 24
  | .coord X => by rw [dimC, pc24_eq]; exact cntK_le X
  | .psp _ _ C => by rw [dimC, pc24_eq]; exact cntK_le C
  | .perp _ => by rw [dimC]; norm_num
  | .ext _ => by rw [dimC]; norm_num

lemma wd1_le (w o V : ℕ) : wd1 w o V ≤ 24 := by
  unfold wd1 NetSpec.dist
  have := dimC_le (Code.ofNat V); have := dimC_le (Code.ofNat o); omega

lemma wd2_le (w o V : ℕ) : wd2 w o V ≤ 552 := by
  unfold wd2 NetSpec.dist
  have := dimC_le (Code.ofNat V); have := dimC_le (Code.ofNat o)
  cases Nat.beq (o % 4) 3 <;> cases Nat.beq (o / 4) 0 <;> simp <;> omega

lemma progMvW_le {wd : ℕ → ℕ → ℕ → ℕ} {B : ℕ} (h : ∀ w o V, wd w o V ≤ B) (cs : List LChunk) :
    ∀ x ∈ progMvW wd cs, x < B + 1 := by
  intro x hx
  simp only [progMvW, List.mem_flatMap, List.mem_map] at hx
  obtain ⟨C, _, p, _, rfl⟩ := hx
  exact Nat.lt_succ_of_le (h _ _ _)

theorem ms1 : ((progMvW wd1 cs1 : List ℕ) : Multiset ℕ) = histMS h1 := by
  obtain ⟨⟨_, s2, s3, _⟩, _⟩ := stage1Seg dataOK wf10
  obtain ⟨k1, k2⟩ := progChk_hist NL mvOK1 wd1 (specs1 dat) S1_0
  refine multiset_of_pack 577 _ h1 (fun x hx => by have := progMvW_le wd1_le cs1 x hx; omega)
    (by decide) ?_ (by decide) ?_
  · unfold cs1; rw [← k2, s3]; norm_num [HB]
  · unfold cs1; rw [← k1, s2, pack1]

theorem ms2 : ((progMvW wd2 cs2 : List ℕ) : Multiset ℕ) = histMS h2 := by
  obtain ⟨⟨_, s2, s3, _⟩, _⟩ := stage2Seg dataOK wf20
  obtain ⟨k1, k2⟩ := progChk_hist NL (mvOK2 dat) wd2 (specs2 dat) S2_0
  refine multiset_of_pack 577 _ h2 (fun x hx => by have := progMvW_le wd2_le cs2 x hx; omega)
    (by decide) ?_ (by decide) ?_
  · unfold cs2; rw [← k2, s3]; norm_num [HB]
  · unfold cs2; rw [← k1, s2, pack2]

lemma count_W {L : List ℕ} {h : List (ℕ × ℕ)} (hm : (L : Multiset ℕ) = histMS h) (k : ℕ) :
    (L.filter (fun x => x != 0)).count k = if k = 0 then 0 else cntH h k := by
  by_cases hk : k = 0
  · subst hk; rw [if_pos rfl]; exact List.count_eq_zero.2 (fun hm' => by simp at hm')
  · rw [if_neg hk, List.count_filter (by simpa using hk), ← Multiset.coe_count, hm, count_histMS]

lemma count_flatMap_const {α : Type*} (l : List α) (W : List ℕ) (k : ℕ) :
    (l.flatMap fun _ => W).count k = l.length * W.count k := by
  induction l with
  | nil => simp
  | cons a l ih => rw [List.flatMap_cons, List.count_append, ih, List.length_cons]; ring

lemma progWidths_append' (a b : List (GChunk Rl 576)) : progWidths (a ++ b) = progWidths a ++ progWidths b := by
  simp [progWidths]

lemma progWidths_flatMap {ι : Type*} (L : List ι) (F : ι → List (GChunk Rl 576)) :
    progWidths (L.flatMap F) = L.flatMap fun i => progWidths (F i) := by
  simp [progWidths, List.flatMap_assoc]

lemma S1_widths : progWidths S1 = (List.range NV).flatMap fun _ => W1 := by
  unfold S1
  rw [progWidths_flatMap]
  exact List.flatMap_congr fun b hb => wid1 (List.mem_range.1 hb)

lemma S2_widths : progWidths S2 = (List.range NV).flatMap fun _ => W2 := by
  unfold S2
  rw [progWidths_flatMap]
  exact List.flatMap_congr fun a ha => wid2 (List.mem_range.1 ha)

lemma E4_widths : progWidths E4s = (List.range NV).flatMap fun _ => (List.range NR).flatMap fun _ => [552] := by
  unfold E4s
  simp only [progWidths, List.flatMap_map]
  refine List.flatMap_congr fun b hb => ?_
  have hb' := List.mem_range.1 hb
  obtain ⟨p, hp⟩ := tb_zero triOK hb'
  show mvWidths ⊤ (E4mv b) = _
  unfold E4mv mvWidths
  rw [List.flatMap_map]
  refine List.flatMap_congr fun q _ => ?_
  simp only [Fd_E4 (tb_unit triOK hb') hp]
  norm_num

lemma Up_Fd {a b : ℕ} (ha : a < NV) (hb : b < NV) : Fd (Up a b) ⊤ = 1 := by
  have hE : EdgeOK (Up a b) ⊤ := Or.inr (up_E5 (Uv_unit ha hb))
  rw [Fd_eq_natAbs hE, finrank_top, Module.finrank_fin_fun]
  have := finrank_perpM (Uv_unit ha hb)
  rw [Up]
  omega

lemma KK_widths : progWidths KK = PL.flatMap fun _ => [1] := by
  unfold KK
  rw [progWidths_flatMap]
  refine List.flatMap_congr fun p hp => ?_
  obtain ⟨ha, hb⟩ := mem_PL.1 hp
  simp only [K, progWidths, C1, C2, C3, List.flatMap_cons, List.flatMap_nil, mvWidths, Up_Fd ha hb]
  norm_num

lemma PL_length : PL.length = NV * NV := by
  unfold PL; exact (List.length_product _ _).trans (by rw [List.length_range])

lemma cntH_big {h : List (ℕ × ℕ)} {N k : ℕ} (hh : ∀ p ∈ h, p.1 < N) (hk : N ≤ k) : cntH h k = 0 := by
  unfold cntH
  apply List.sum_eq_zero
  intro x hx
  obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hx
  rw [if_neg]; intro e; have := hh p hp; omega

theorem CH_hist : ((progWidths CH : List ℕ) : Multiset ℕ) = histMS Jain.cxR6 := by
  ext k
  rw [Multiset.coe_count, count_histMS, CH, progWidths_append', progWidths_append', progWidths_append',
    S1_widths, E4_widths, S2_widths, KK_widths]
  simp only [List.count_append, count_flatMap_const, List.length_range, PL_length]
  rw [W1, W2, count_W ms1, count_W ms2]
  have e552 : List.count k [552] = if k = 552 then 1 else 0 := by
    by_cases hk : k = 552 <;> simp [hk, List.count_singleton]; omega
  have e1 : List.count k [1] = if k = 1 then 1 else 0 := by
    by_cases hk : k = 1 <;> simp [hk, List.count_singleton]; omega
  rw [e552, e1]
  by_cases hk : k < 577
  · have := cntAll_chk k hk
    unfold cntAll at this
    simp only [NV, NR] at *
    omega
  · have hA : cntH Jain.cxR6 k = 0 := cntH_big (N := 577) (by decide) (by omega)
    have h1' : cntH h1 k = 0 := cntH_big (N := 577) (by decide) (by omega)
    have h2' : cntH h2 k = 0 := cntH_big (N := 577) (by decide) (by omega)
    rw [hA, h1', h2']
    split_ifs <;> omega

theorem CH_small : ∀ w ∈ progWidths CH, w < 576 := by
  intro w hw
  have hm : w ∈ (histMS Jain.cxR6) := by rw [← CH_hist]; exact Multiset.mem_coe.2 hw
  have hpos : (histMS Jain.cxR6).count w ≠ 0 := Multiset.count_ne_zero.2 hm
  rw [count_histMS] at hpos
  by_contra hge
  exact hpos (cntH_big (N := 576) (by decide) (by omega))

end IntMul.Kappa.R6.Cx.NetG

