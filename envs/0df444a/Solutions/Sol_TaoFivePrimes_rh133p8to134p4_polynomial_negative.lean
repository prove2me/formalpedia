set_option autoImplicit false

namespace RH132RealBridge

lemma quadratic_seed (x t : ℝ) :
    ((t : ℂ) - Complex.I * (x : ℂ)) ^ 2 =
      ((2 * t : ℝ) : ℂ) * ((t : ℂ) - Complex.I * (x : ℂ)) -
        ((t ^ 2 + x ^ 2 : ℝ) : ℂ) := by
  apply Complex.ext <;>
    simp [pow_two, Complex.mul_re, Complex.mul_im] <;> ring

lemma real_power_recurrence (x t : ℝ) (n : ℕ) :
    (((t : ℂ) - Complex.I * (x : ℂ)) ^ (n + 2)).re =
      2 * t * (((t : ℂ) - Complex.I * (x : ℂ)) ^ (n + 1)).re -
        (t ^ 2 + x ^ 2) *
          (((t : ℂ) - Complex.I * (x : ℂ)) ^ n).re := by
  let z : ℂ := (t : ℂ) - Complex.I * (x : ℂ)
  have hz : z ^ 2 = ((2 * t : ℝ) : ℂ) * z -
      ((t ^ 2 + x ^ 2 : ℝ) : ℂ) := by
    simpa only [z] using quadratic_seed x t
  have hrec : z ^ (n + 2) =
      ((2 * t : ℝ) : ℂ) * z ^ (n + 1) -
        ((t ^ 2 + x ^ 2 : ℝ) : ℂ) * z ^ n := by
    calc
      z ^ (n + 2) = z ^ n * z ^ 2 := pow_add z n 2
      _ = _ := by
        rw [hz, pow_succ]
        ring
  simpa only [z, Complex.sub_re, Complex.mul_re, Complex.ofReal_re,
    Complex.ofReal_im, zero_mul, sub_zero] using congrArg Complex.re hrec

end RH132RealBridge


