-- Source module: Solutions.J6SegILJKer7
/-!
# B-line IL, the `J` kernel (B4), part 7: list moves on managed states

Plain register programs (no products, linear cost) used around the kernel loops:

* `rdT X`: one table entry from `dTJ` onto `X`, recorded on the consumed-table stack `TT`;
* `rdH X`: one header entry from `dTJ` onto `X` (not recorded);
* `popL X C n`: drop `n` entries of `X`;
* `dupMv X Y T C n`: copy the top `n` entries of `X` (reversed) onto `Y` and onto `T`, removing
  them from `X`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

section moves
variable {s : IState HS} {G : Fin HS → List ℤ}

theorem rdH_spec {X : Fin HS} (hX1 : X ≠ dTJ) (hX5 : X.val < 56) {x : ℤ}
    {rest : List ℤ} (hT : G dTJ = x :: rest) {B : ℕ} (hx : zsz x ≤ B) :
    Sp (rdH X) (encK s G) (encK s (update (update G X (x :: G X)) dTJ rest)) (10000 * (B + 2)) := by
  have s1 := Sp.push (s := s) (f := G) (i := X) (e := .reg dTJ) (B := B) hX5
    (RS.clean_of_lt (by decide)) (isInt_encK hT) trivial (by simp only [Ex.Bnd, top_encK hT]; exact hx)
  rw [show (Ex.reg (S := HS) dTJ).eval (encK s G) = x from top_encK hT] at s1
  have g1 : update G X (x :: G X) dTJ = x :: rest := by rw [update_of_ne (Ne.symm hX1), hT]
  have s3 := Sp.pop (s := s) (f := update G X (x :: G X)) (i := dTJ) (B := B) (by decide) g1 hx
  refine (s1.seq s3).mono ?_
  simp only [Ex.size]; omega

end moves

end J6Seg.JK

end

