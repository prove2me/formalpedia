    have hlevel : ((orbit E Ω ℓ ρ hρ x (∑ i, c i • bΛ i) : TateModule ℓ (E.L.AlgPoints E.comm Ω)) : ℕ → E.L.AlgPoints E.comm Ω) n = 0 := by
