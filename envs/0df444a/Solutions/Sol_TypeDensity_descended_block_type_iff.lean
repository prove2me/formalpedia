  have hG : (TypeDensity.monicPolyO a).map (algebraMap O (AdjoinRoot Φ)) = TypeDensity.conjugateProduct O Φ B := by
    have := (TypeDensity.descend_block_mem_cell O Φ hΦ r b hb).2
