section

/-!
# Cœur affine : `Hom_ℂ(A, ℂ)` est connexe par arcs (A6)

Pour une ℂ-algèbre de type fini intègre `A`, l'espace `Pts A = Hom_ℂ(A, ℂ)` (topologie faible)
est connexe par arcs (`pathConnectedSpace_pts`). Normalisation de Noether `S ⊆ A`, puis, pour
deux points `ψ₁, ψ₂` : des bons éléments `uᵢ` séparant leurs fibres, des chemins `ψᵢ ⇝ φᵢ`
vers `proj⁻¹(Vᵢ)`, connexes par arcs, qui se rencontrent au-dessus de `V₁ ∩ V₂`.
-/

open Polynomial

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

section Noether

variable {n : ℕ} {A : Type} [CommRing A] [IsDomain A] [Algebra ℂ A] [Algebra (Sn n) A]
  [IsScalarTower ℂ (Sn n) A] [Module.Finite (Sn n) A] [Module.IsTorsionFree (Sn n) A]

theorem natDegree_F_pos (e : GoodElt n A) : 0 < e.F.natDegree :=
  minpoly.natDegree_pos (isIntegral_u e)

theorem exists_mem_fib (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    ∃ φ : Pts A, proj φ = z := by
  have h := card_fib (A := A) e hz
  obtain ⟨φ, hφ⟩ := Finset.card_pos.mp (h ▸ natDegree_F_pos e)
  exact ⟨φ, mem_fib.mp hφ⟩

end Noether

/-- **Connexité par arcs**, une normalisation de Noether étant fixée. -/
theorem pathConnectedSpace_pts_of_noether (n : ℕ) {A : Type} [CommRing A] [IsDomain A]
    [Algebra ℂ A] [Algebra (Sn n) A] [IsScalarTower ℂ (Sn n) A] [Module.Finite (Sn n) A]
    [Module.IsTorsionFree (Sn n) A] : PathConnectedSpace (Pts A) := by
  obtain ⟨e₀, -⟩ := exists_goodElt (A := A) (0 : Fin n → ℂ)
  obtain ⟨z₀, hz₀⟩ := exists_eval_ne_zero (mul_ne_zero e₀.hc e₀.hδ)
  obtain ⟨φ₀, -⟩ := exists_mem_fib e₀ hz₀
  refine ⟨⟨φ₀⟩, fun ψ₁ ψ₂ ↦ ?_⟩
  obtain ⟨e₁, hs₁⟩ := exists_goodElt (A := A) (proj (n := n) ψ₁)
  obtain ⟨e₂, hs₂⟩ := exists_goodElt (A := A) (proj (n := n) ψ₂)
  obtain ⟨φ₁, hφ₁, hj₁⟩ := exists_joined_preimage_V e₁ ψ₁ hs₁
  obtain ⟨φ₂, hφ₂, hj₂⟩ := exists_joined_preimage_V e₂ ψ₂ hs₂
  have hD : e₁.c * e₁.δ * (e₂.c * e₂.δ) ≠ 0 :=
    mul_ne_zero (mul_ne_zero e₁.hc e₁.hδ) (mul_ne_zero e₂.hc e₂.hδ)
  obtain ⟨z, hz⟩ := exists_eval_ne_zero hD
  rw [map_mul] at hz
  have hz₁ : z ∈ e₁.V := left_ne_zero_of_mul hz
  have hz₂ : z ∈ e₂.V := right_ne_zero_of_mul hz
  obtain ⟨χ, hχ⟩ := exists_mem_fib e₁ hz₁
  have hχ₁ : χ ∈ (proj ⁻¹' e₁.V : Set (Pts A)) := by rw [Set.mem_preimage, hχ]; exact hz₁
  have hχ₂ : χ ∈ (proj ⁻¹' e₂.V : Set (Pts A)) := by rw [Set.mem_preimage, hχ]; exact hz₂
  have j₁ := ((isPathConnected_preimage_V e₁ hφ₁).joinedIn φ₁ hφ₁ χ hχ₁).joined
  have j₂ := ((isPathConnected_preimage_V e₂ hφ₂).joinedIn χ hχ₂ φ₂ hφ₂).joined
  exact hj₁.trans (j₁.trans (j₂.trans hj₂.symm))

/-- **`Hom_ℂ(A, ℂ)` est connexe par arcs** pour `A` de type fini intègre. -/
theorem pathConnectedSpace_pts (A : Type) [CommRing A] [IsDomain A] [Algebra ℂ A]
    [Algebra.FiniteType ℂ A] : PathConnectedSpace (Pts A) := by
  obtain ⟨n, g, hinj, hfin⟩ := exists_finite_inj_algHom_of_fg ℂ A
  let _ : Algebra (Sn n) A := g.toRingHom.toAlgebra
  have : IsScalarTower ℂ (Sn n) A := IsScalarTower.of_algebraMap_eq fun r ↦ (g.commutes r).symm
  have : Module.Finite (Sn n) A := hfin
  have : FaithfulSMul (Sn n) A := (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  exact pathConnectedSpace_pts_of_noether n

/-- **Cœur affine de A6**, sous la forme de l'énoncé `FiniteFields.Betti.pathConnectedSpace_algHom`
(topologie `ptsTop` dépliée). -/
theorem pathConnectedSpace_algHom_proof (A : Type) [CommRing A] [IsDomain A] [Algebra ℂ A]
    [Algebra.FiniteType ℂ A] :
    @PathConnectedSpace (A →ₐ[ℂ] ℂ)
      (TopologicalSpace.induced (fun φ : A →ₐ[ℂ] ℂ ↦ (⇑φ : A → ℂ)) inferInstance) :=
  pathConnectedSpace_pts A


end FiniteFields.Betti.Connected

end

