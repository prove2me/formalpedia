-- Source module: NLogNP.Move
/-!
# Basic transducers: moving stack contents
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-- Replace stack `i`. -/
def St.set (σ : St S) (i : Fin S) (l : List Sym) : St S :=
  { σ with stk := Function.update σ.stk i l }

@[simp] theorem St.set_ip (σ : St S) (i : Fin S) (l : List Sym) : (σ.set i l).ip = σ.ip := rfl
@[simp] theorem St.set_out (σ : St S) (i : Fin S) (l : List Sym) : (σ.set i l).out = σ.out := rfl

@[simp] theorem St.push_ip (σ : St S) (i : Fin S) (a : Sym) : (σ.push i a).ip = σ.ip := rfl
@[simp] theorem St.push_out (σ : St S) (i : Fin S) (a : Sym) : (σ.push i a).out = σ.out := rfl
@[simp] theorem St.pop_ip (σ : St S) (i : Fin S) : (σ.pop i).ip = σ.ip := rfl
@[simp] theorem St.pop_out (σ : St S) (i : Fin S) : (σ.pop i).out = σ.out := rfl

@[simp] theorem St.inRd_ip (σ : St S) (i : Fin S) : (σ.inRd I i).ip = σ.ip + 1 := rfl
@[simp] theorem St.inRd_out (σ : St S) (i : Fin S) : (σ.inRd I i).out = σ.out := rfl
@[simp] theorem St.outB_stk (σ : St S) (b : Bool) : (σ.outB b).stk = σ.stk := rfl
@[simp] theorem St.outB_ip (σ : St S) (b : Bool) : (σ.outB b).ip = σ.ip := rfl
@[simp] theorem St.outB_out (σ : St S) (b : Bool) : (σ.outB b).out = σ.out ++ [b] := rfl

/-! ### Normalising chains of `set` -/

/-- Advance the input position. -/
def St.adv (σ : St S) : St S := { σ with ip := σ.ip + 1 }

theorem St.adv_set (σ : St S) (i : Fin S) (l : List Sym) : (σ.set i l).adv = σ.adv.set i l := rfl

theorem St.outB_set (σ : St S) (i : Fin S) (l : List Sym) (b : Bool) :
    (σ.set i l).outB b = (σ.outB b).set i l := rfl

/-! ## Moving symbols from one stack to another -/

/-- Transition of `move`: while `g` is defined on the top of `src`, pop it and push its image
on `dst`. -/
def moveδ (q src dst : Fin S) (g : Sym → Option Sym) : List (Option Sym) → List (Op S)
  | [_, some a] =>
    match g a with
    | some b => [.pop src, .push dst b]
    | none => [.pop q, .push q hlt]
  | _ => [.pop q, .push q hlt]

def move (q src dst : Fin S) (g : Sym → Option Sym) : Stmt S P :=
  machine q [src] 0 (moveδ q src dst g)

/-- Cost of `move` on `m` symbols. -/
def moveCost (m : ℕ) : ℕ := (m + 1) * 38 + 3

end NLogN

end

