p2m_open "LanglandsTunnell.Converse.Ideles P2MW.S_LanglandsTunnell_Converse_CuspSynthesis_exists_isHaarMeasure_torusTransform_eq_of_isJLNice.LanglandsTunnell.Converse.Ideles NumberField.TateGlobal MeasureTheory"
open scoped ENNReal

variable {K : Type} [Field K] [NumberField K]

private noncomputable def d024 : Kˣ ≃ ↥(M4aHerbrand.principalIdeles (𝓞 K) K) :=
  Equiv.ofBijective (fun γ => ⟨Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) γ, ⟨γ, rfl⟩⟩)
    ⟨fun γ₁ γ₂ h => Units.map_injective (NumberField.AdeleRing.algebraMap_injective (𝓞 K) K) (congrArg Subtype.val h),
      fun x => by
        obtain ⟨γ, hγ⟩ := x.2
        exact ⟨γ, Subtype.ext hγ⟩⟩

private theorem t0286 (γ : Kˣ) :
    ((d024 (K := K) γ : ↥(M4aHerbrand.principalIdeles (𝓞 K) K)) : (AdeleRing (𝓞 K) K)ˣ)
      = Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) γ := rfl

private noncomputable def d025 (S : Finset (HeightOneSpectrum (𝓞 K))) (F : (AdeleRing (𝓞 K) K)ˣ → ℝ≥0∞)
    (z : (AdeleRing (𝓞 K) K)ˣ) : ℝ≥0∞ :=
  ∑' γ : ↥(M4aHerbrand.principalIdeles (𝓞 K) K),
    (d020 S).indicator F ((γ : (AdeleRing (𝓞 K) K)ˣ)⁻¹ * z)

private noncomputable def d026 (S : Finset (HeightOneSpectrum (𝓞 K))) (F : (AdeleRing (𝓞 K) K)ˣ → ℝ≥0∞)
    (p : ↥(torusClass (K := K) S) × ℝ) : ℝ≥0∞ :=
  ∑' β : {β : Kˣ // IsSUnit K S β},
    F (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) β.1
      * ((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K p.2)

private theorem t0287 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (F : (AdeleRing (𝓞 K) K)ˣ → ℝ≥0∞) (γ₀ : Kˣ) (z : (AdeleRing (𝓞 K) K)ˣ) :
    d025 S F (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) γ₀ * z)
      = d025 S F z := by
  rw [d025, d025, ← (Equiv.mulLeft (d024 (K := K) γ₀)⁻¹).tsum_eq fun γ =>
    (d020 S).indicator F ((γ : (AdeleRing (𝓞 K) K)ˣ)⁻¹ * z)]
  refine tsum_congr fun γ => ?_
  simp only [Equiv.coe_mulLeft]
  congr 1
  simp only [Subgroup.coe_mul, Subgroup.coe_inv, t0286, mul_inv_rev, inv_inv, mul_assoc]

private theorem t0288 {S : Finset (HeightOneSpectrum (𝓞 K))}
    (F : (AdeleRing (𝓞 K) K)ˣ → ℝ≥0∞) {y : (AdeleRing (𝓞 K) K)ˣ} (hy : y ∈ unitIdelesAt S) (γ : Kˣ) :
    (d020 S).indicator F (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) γ * y)
      = {β : Kˣ | IsSUnit K S β}.indicator
          (fun β => F (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) β * y)) γ := by
  have hmem : Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) γ * y ∈ d020 S
      ↔ γ ∈ {β : Kˣ | IsSUnit K S β} := by
    rw [t0262, Set.mem_setOf_eq, ← t0264 S γ]
    exact (unitIdelesAt S).mul_mem_cancel_right hy
  by_cases h : γ ∈ {β : Kˣ | IsSUnit K S β}
  · rw [Set.indicator_of_mem (hmem.2 h), Set.indicator_of_mem h]
  · rw [Set.indicator_of_notMem (fun h' => h (hmem.1 h')), Set.indicator_of_notMem h]

private theorem t0289 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (F : (AdeleRing (𝓞 K) K)ˣ → ℝ≥0∞) (q : ↥(torusClass (K := K) S)) (t : ℝ) :
    d025 S F (((torusLift q : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K t)
      = d026 S F (q, t) := by
  set y : (AdeleRing (𝓞 K) K)ˣ :=
    ((torusLift q : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K t with hy_def
  have hy : y ∈ unitIdelesAt S := (unitIdelesAt S).mul_mem (t0235 q) (t0269 S t)
  calc d025 S F y
      = ∑' γ : Kˣ, (d020 S).indicator F
          ((Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) γ)⁻¹ * y) := by
        rw [d025, ← (d024 (K := K)).tsum_eq fun γ =>
          (d020 S).indicator F ((γ : (AdeleRing (𝓞 K) K)ˣ)⁻¹ * y)]
        rfl
    _ = ∑' γ : Kˣ, (d020 S).indicator F
          (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) γ * y) := by
        rw [← (Equiv.inv Kˣ).tsum_eq fun γ => (d020 S).indicator F
          (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) γ * y)]
        refine tsum_congr fun γ => ?_
        rw [Equiv.inv_apply, map_inv]
    _ = ∑' γ : Kˣ, {β : Kˣ | IsSUnit K S β}.indicator
          (fun β => F (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) β * y)) γ :=
        tsum_congr fun γ => t0288 F hy γ
    _ = ∑' β : ↥{β : Kˣ | IsSUnit K S β},
          F (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) (β : Kˣ) * y) :=
        (tsum_subtype {β : Kˣ | IsSUnit K S β} fun β =>
          F (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) β * y)).symm
    _ = d026 S F (q, t) := by
        rw [d026]
        exact tsum_congr fun β => by rw [hy_def, mul_assoc]

private theorem t0290 (S : Finset (HeightOneSpectrum (𝓞 K))) (F : (AdeleRing (𝓞 K) K)ˣ → ℝ≥0∞)
    (z : (AdeleRing (𝓞 K) K)ˣ) : d025 S F z = d026 S F (d022 S z) := by
  have hproj : d022 S (((torusLift (d022 S z).1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ)
      * Ideles.archScale K (d022 S z).2) = d022 S z :=
    t0281 (d022 S z).1 (d022 S z).2
  obtain ⟨γ, hγ⟩ := t0283 S hproj.symm
  conv_lhs => rw [hγ]
  rw [t0287, t0289]

private theorem t0291 {F : (AdeleRing (𝓞 K) K)ˣ → ℝ≥0∞} (hF : LowerSemicontinuous F)
    (S : Finset (HeightOneSpectrum (𝓞 K))) {m : (AdeleRing (𝓞 K) K)ˣ → (AdeleRing (𝓞 K) K)ˣ} (hm : Continuous m) :
    LowerSemicontinuous fun z => (d020 S).indicator F (m z) := by
  rw [lowerSemicontinuous_iff_isOpen_preimage]
  intro y
  have hset : (fun z => (d020 S).indicator F (m z)) ⁻¹' Set.Ioi y
      = m ⁻¹' (d020 S ∩ F ⁻¹' Set.Ioi y) := by
    classical
    ext z
    simp only [Set.mem_preimage, Set.mem_Ioi, Set.mem_inter_iff, Set.indicator_apply]
    split_ifs with h <;> simp [h]
  rw [hset]
  exact ((t0263 S).inter (hF.isOpen_preimage y)).preimage hm

private theorem t0292 (S : Finset (HeightOneSpectrum (𝓞 K)))
    {F : (AdeleRing (𝓞 K) K)ˣ → ℝ≥0∞} (hF : LowerSemicontinuous F) : LowerSemicontinuous (d025 S F) := by
  show LowerSemicontinuous fun z => ∑' γ : ↥(M4aHerbrand.principalIdeles (𝓞 K) K),
    (d020 S).indicator F ((γ : (AdeleRing (𝓞 K) K)ˣ)⁻¹ * z)
  exact lowerSemicontinuous_tsum fun γ => t0291 hF S (continuous_const.mul continuous_id)

private noncomputable def d027 : (AdeleRing (𝓞 K) K)ˣ ≃ₜ ↥(normOneIdeles K) × ℝ where
  toFun z := (⟨d021 z, t0267 z⟩, Real.log (ideleNorm K z))
  invFun w := (w.1 : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K w.2
  left_inv z := t0273 z
  right_inv w := by
    refine Prod.ext (Subtype.ext ?_) ?_
    · show d021 ((w.1 : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K w.2) = w.1
      rw [d021, t0234 w.1.2, Real.log_exp, mul_assoc, ← FiniteWhittaker.t0115,
        add_neg_cancel, FiniteWhittaker.t0116, mul_one]
    · show Real.log (ideleNorm K ((w.1 : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K w.2)) = w.2
      rw [t0234 w.1.2, Real.log_exp]
  continuous_toFun :=
    (t0274.subtype_mk t0267).prodMk
      ((continuous_ideleNorm K).log fun z => (ideleNorm_pos z).ne')
  continuous_invFun :=
    (continuous_subtype_val.comp continuous_fst).mul (FiniteWhittaker.t0117.comp continuous_snd)

private theorem t0293 (S : Finset (HeightOneSpectrum (𝓞 K))) (x : ↥(normOneIdeles K)) :
    (QuotientGroup.mk x : NormOneQuot (K := K)) ∈ torusClass S := by
  have hx : d021 (x : (AdeleRing (𝓞 K) K)ˣ) = x := by
    rw [d021, (mem_normOneIdeles_iff _).1 x.2, Real.log_one, neg_zero, FiniteWhittaker.t0116, mul_one]
  have h := t0276 S (x : (AdeleRing (𝓞 K) K)ˣ)
  rwa [show (⟨d021 (x : (AdeleRing (𝓞 K) K)ˣ), t0267 _⟩ : ↥(normOneIdeles K)) = x from
    Subtype.ext hx] at h

private noncomputable def d028 (S : Finset (HeightOneSpectrum (𝓞 K))) (x : ↥(normOneIdeles K)) :
    ↥(torusClass (K := K) S) :=
  ⟨QuotientGroup.mk x, t0293 S x⟩

private theorem t0294 (S : Finset (HeightOneSpectrum (𝓞 K))) :
    IsOpenMap (d028 (K := K) S) := by
  intro V hV
  have himage : d028 S '' V
      = Subtype.val ⁻¹' ((QuotientGroup.mk : ↥(normOneIdeles K) → NormOneQuot (K := K)) '' V) := by
    ext q
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact ⟨x, hx, rfl⟩
    · rintro ⟨x, hx, hq⟩
      exact ⟨x, hx, Subtype.ext hq⟩
  rw [himage]
  exact (QuotientGroup.isOpenMap_coe V hV).preimage continuous_subtype_val

private theorem t0295 (S : Finset (HeightOneSpectrum (𝓞 K))) :
    d022 (K := K) S = Prod.map (d028 S) id ∘ d027 := by
  funext z
  rfl

private theorem t0296 (S : Finset (HeightOneSpectrum (𝓞 K))) : IsOpenMap (d022 (K := K) S) := by
  rw [t0295]
  exact ((t0294 S).prodMap IsOpenMap.id).comp d027.isOpenMap

private theorem t0297 (S : Finset (HeightOneSpectrum (𝓞 K)))
    {F : (AdeleRing (𝓞 K) K)ˣ → ℝ≥0∞} (hF : LowerSemicontinuous F) : LowerSemicontinuous (d026 S F) := by
  rw [lowerSemicontinuous_iff_isOpen_preimage]
  intro y
  have hset : d026 S F ⁻¹' Set.Ioi y = d022 S '' (d025 S F ⁻¹' Set.Ioi y) := by
    ext p
    constructor
    · intro hp
      refine ⟨((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K p.2, ?_,
        t0281 p.1 p.2⟩
      show y < d025 S F _
      rw [t0289]
      exact hp
    · rintro ⟨z, hz, rfl⟩
      show y < d026 S F (d022 S z)
      rw [← t0290]
      exact hz
  rw [hset]
  exact t0296 S _ ((t0292 S hF).isOpen_preimage y)

