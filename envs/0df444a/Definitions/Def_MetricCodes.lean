theorem coordinateDegreeTransport_axis
    {n : ℕ} (hn : 3 ≤ n) (k L : ℕ)
    (i : Jacobi.Index k L)
    (x : Euclidean n) (p : HarmonicSpace n (k + i.val)) :
    coordinateDegreeTransport hn k L i
        (HarmonicSourceProjection.harmonicAxisTensor
          n (k + i.val) x p) =
      harmonicDegreeAxisTensor n k L i x
