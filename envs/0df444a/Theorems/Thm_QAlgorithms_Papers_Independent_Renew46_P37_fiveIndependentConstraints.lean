-- title:
--   Five nonredundant positive-combination constraints
-- statement:
--   On normalized finite tripartite laws, define $F=(I(A:BC),I(B:AC),I(C:AB),S_3,T_3)$. For each $j$, there do not exist constants $c_i\ge0$ with $c_j=0$ such that
--   $$F_j(P)=\sum_{i=1}^{5}c_iF_i(P)\qquad\text{for every }P.$$
--   Here $S_3=H(AB)+H(BC)+H(AC)-2H(ABC)=I(A:BC)+I(B:C\mid A)$, and $T_3=H(A)+H(B)+H(C)-H(ABC)=I(A:B)+I(AB:C)$. All alphabets are nonempty and finite; entropies are in bits.
--
--   These constraints are nonredundant in the nonnegative cone, although the five functions have a linear relation.
-- source:
--   Multipartite Classical and Quantum Secrecy Monotones, arXiv:quant-ph/0202103v1, PDF p. 7, §IV.A, (39),(40)

import Definitions.Def_QAlgorithms_Papers_Independent_Renew46_P37

noncomputable section

namespace QAlgorithms.Papers.Independent.Renew46.P37

open scoped Matrix ComplexConjugate ComplexOrder ENNReal

attribute [local instance] Classical.propDecidable Classical.decEq

open QAlgorithms.Papers.Independent.Information100.P56 (IsLaw)

open QAlgorithms.Papers.Independent.Information100.P27 (shannon)

open QAlgorithms.Papers.Independent.Frontier30.P12 (IsStochastic)

open QAlgorithms.Papers.Independent.Claimed50.P33
  (InformationKind RegisterBasis FiniteState singleParties allParties
   info entropyAt trivialExtension informationFunctional LocalInstrument
   IsContinuousFunctional partyProduct registerMarginal)

/-- §IV.A, PDF p.7, (39),(40): none of the five functions is in the
nonnegative cone generated by the other four. Equality must hold on EVERY
finite law. This does not assert linear independence. -/
theorem fiveIndependentConstraints :
    (∀ j : Fin 5, ¬ ∃ c : Fin 5 → ℝ, (∀ i, 0 ≤ c i) ∧ c j = 0 ∧
      ∀ p : CData 3, IsValidClassicalData p → fiveValues p j = ∑ i, c i * fiveValues p i) ∧
    (∀ p : CData 3, IsValidClassicalData p →
      cValue .dual p = cH p {0,1} + cH p {1,2} + cH p {0,2} - 2*cH p Finset.univ ∧
      cValue .dual p = lawCMI p {0} {1,2} ∅ + lawCMI p {1} {2} {0} ∧
      cValue .total p = cH p {0} + cH p {1} + cH p {2} - cH p Finset.univ ∧
      cValue .total p = lawCMI p {0} {1} ∅ + lawCMI p {0,1} {2} ∅) := by sorry

end QAlgorithms.Papers.Independent.Renew46.P37

end
