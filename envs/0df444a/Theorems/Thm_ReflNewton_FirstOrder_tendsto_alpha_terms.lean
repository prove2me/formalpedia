-- title:
--   Proof of Theorem 8, p. 208 — α_k g_kᵀs_k → 0 and α_k² min(s_kᵀH_ks_k, 0) → 0
-- statement:
--   Under the compactness and smoothness assumption, let $\{x_k\}$ be generated by the interior-reflective algorithm of Fig. 9 with $0<\sigma_l<\sigma_u<1$ and $\rho>0$. Then
--   $$\lim_{k\to\infty}\alpha_k\,g_k^{T}s_k=0\qquad\text{and}\qquad\lim_{k\to\infty}\alpha_k^2\min(s_k^{T}H_ks_k,0)=0 .$$
--
--   Since $f$ is bounded below on the compact set $\mathcal L$ and decreases along the run, the decrease guaranteed by (3.4) must vanish, and both of its nonpositive parts vanish with it. The second limit is the second half of Theorem 8.
--
--   **Formalization Note** No condition on the directions is assumed: this step of the proof uses only (3.4), the descent property and compactness. `x 0` is the paper's $x_1$.
-- source:
--   Coleman & Li, On the convergence of interior-reflective Newton methods for nonlinear minimization subject to bounds, Math. Programming 67 (1994), p. 208, proof of Theorem 8 (first three displays)

import Mathlib
import Definitions.Def_LewisTorczon_BoundPS_Box
import Definitions.Def_ReflNewton_FirstOrder_Setting
open Filter Topology

namespace ReflNewton.FirstOrder

theorem tendsto_alpha_terms
    {n : ℕ} (l u : Fin n → EReal) (hl : ∀ i, l i ≠ ⊤) (hu : ∀ i, u i ≠ ⊥) (hlu : l ≤ u)
    (f : E n → ℝ) (D : Set (E n)) (hDo : IsOpen D)
    (hFD : LewisTorczon.BoundPS.box l u ⊆ D) (hf : ContDiffOn ℝ 2 f D)
    (σl σu ρ : ℝ) (hσl : 0 < σl) (hσlu : σl < σu) (hσu : σu < 1) (hρ : 0 < ρ)
    (x s : ℕ → E n) (α : ℕ → ℝ) (hrun : IsIRRun l u f σl σu ρ x s α)
    (hL : IsCompact (LewisTorczon.BoundPS.levelSet l u f (x 0))) :
    Tendsto (fun k => α k * inner ℝ (gradient f (x k)) (s k)) atTop (𝓝 0) ∧
      Tendsto (fun k => α k ^ 2 * min (hq f (x k) (s k)) 0) atTop (𝓝 0) := by sorry

end ReflNewton.FirstOrder
