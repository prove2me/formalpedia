theorem pc_cnj {n : ℕ} (hn : n ≤ N) (hp : p + 2 ≤ P) :
    cCnj n (p + 2) ≤ 10 ^ 5 * ((N + 1) * (FM P + P + 1)) := by
  have a := cCnj_le n (p + 2)
  have : (n + 1) * (p + 2 + 2) ≤ (N + 1) * (2 * (FM P + P + 1)) := Nat.mul_le_mul (by omega) (by omega)
  calc cCnj n (p + 2) ≤ 10 ^ 4 * (n + 1) * (p + 2 + 2) := a
    _ = 10 ^ 4 * ((n + 1) * (p + 2 + 2)) := by ring
    _ ≤ 10 ^ 4 * ((N + 1) * (2 * (FM P + P + 1))) := Nat.mul_le_mul_left _ this
    _ = 2 * 10 ^ 4 * ((N + 1) * (FM P + P + 1)) := by ring
    _ ≤ 10 ^ 5 * ((N + 1) * (FM P + P + 1)) := Nat.mul_le_mul_right _ (by norm_num)

theorem pc_tw (hP : dlV p h (D + 1) + 3 ≤ P) (hr : 2 ^ (h + 1) ≤ N) :
    cTwGU (dlV p h (D + 1)) (2 ^ (h + 2)) 1 (2 ^ (h + 1)) (KFM.fmB (2 * (dlV p h (D + 1) + 2))) ≤
      10 ^ 27 * ((N + 1) * (FM P + P + 1) + (P + 31) ^ 6) := by
  set Δ := dlV p h (D + 1) with hΔ
  have hhΔ : h ≤ Δ := by rw [hΔ]; unfold dlV; omega
  have hφ : KFM.fmB (2 * (Δ + 2)) ≤ FM P := fmB_mono (by omega)
  have a := cTwGU_le Δ (2 ^ (h + 2)) 1 (2 ^ (h + 1)) (KFM.fmB (2 * (Δ + 2)))
  have b := cTw_le' Δ (2 ^ (h + 2)) 1
  have z1 : zsz (((2 ^ (h + 2) : ℕ) : ℤ)) ≤ h + 3 := by
    have := zsz_tw h (2 ^ (h + 1)) le_rfl
    rwa [show 2 * 2 ^ (h + 1) = 2 ^ (h + 2) by rw [pow_succ]; ring] at this
  have z2 : zsz (((1 : ℕ) : ℤ)) ≤ 1 := zsz_natCast_le_self' 1
  have b' : (Δ + zsz ((1 : ℕ) : ℤ) + zsz (((2 ^ (h + 2) : ℕ) : ℤ)) + 30) ^ 5 ≤ 243 * (P + 31) ^ 5 := by
    calc _ ≤ (3 * (P + 31)) ^ 5 := Nat.pow_le_pow_left (by omega) 5
      _ = 243 * (P + 31) ^ 5 := by ring
  have y5 : (P + 31) ^ 5 ≤ (P + 31) ^ 6 := le_Y 5 (by norm_num) le_rfl
  have c := cChirpG_le' (2 ^ (h + 1)) (KFM.fmB (2 * (Δ + 2))) (Δ + 2) Δ
  have hQ : 1 ≤ FM P + P + 1 := by omega
  have c' : (2 ^ (h + 1) + 1) * (8 * KFM.fmB (2 * (Δ + 2)) + 10 ^ 6 * (Δ + 2 + Δ + 1)) ≤
      (N + 1) * (4 * 10 ^ 6 * (FM P + P + 1)) := Nat.mul_le_mul (by omega) (by omega)
  have e : (N + 1) * (4 * 10 ^ 6 * (FM P + P + 1)) = 4 * 10 ^ 6 * ((N + 1) * (FM P + P + 1)) := by
    ring
  rw [e] at c'
  have h4 : 2 ^ (h + 2) = 2 * 2 ^ (h + 1) := by rw [pow_succ]; ring
  have d1 : 10 ^ 4 * (Δ + 2 ^ (h + 2) + 1 + 2 ^ (h + 1) + 3) ≤
      10 ^ 5 * ((N + 1) * (FM P + P + 1)) := by
    have e5 : N + 1 ≤ (N + 1) * (FM P + P + 1) := Nat.le_mul_of_pos_right _ (by omega)
    have e6 : FM P + P + 1 ≤ (N + 1) * (FM P + P + 1) := Nat.le_mul_of_pos_left _ (by omega)
    rw [h4]; omega
  have d2 : 2 * Δ + 12 ≤ 10 * ((N + 1) * (FM P + P + 1)) := by
    have e5 : FM P + P + 1 ≤ (N + 1) * (FM P + P + 1) := Nat.le_mul_of_pos_left _ (by omega)
    omega
  have b2 : cTw Δ (2 ^ (h + 2)) 1 ≤ 10 ^ 23 * (243 * (P + 31) ^ 6) :=
    b.trans (Nat.mul_le_mul_left _ (b'.trans (Nat.mul_le_mul_left _ y5)))
  unfold cTwG at a
  have cc := c.trans c'
  clear c c'
  linarith

theorem pc_repl (hp : p + 2 ≤ P) (M r : ℕ) (hM : M * r = N) (hr : 1 ≤ r) (hrN : r ≤ N) :
    cRepl M (2 * r) (p + 2) + cMvX (2 * r) (p + 2) ≤ 10 ^ 6 * ((N + 1) * (FM P + P + 1)) := by
  have a := cRepl_le M (2 * r) (p + 2)
  have b := pc_mvX (N := N) (P := P) (n := 2 * r) (w := p + 2) (by omega) (by omega)
  have hMN : M ≤ N := by rw [← hM]; exact Nat.le_mul_of_pos_right _ hr
  have h1 : (M + 1) * (2 * r + 1) ≤ 5 * (N + 1) := by
    have e : (M + 1) * (2 * r + 1) = 2 * (M * r) + M + 2 * r + 1 := by ring
    rw [e, hM]; omega
  have h2 : (M + 1) * (2 * r + 1) * (p + 2 + 2) ≤ 5 * (N + 1) * (2 * (FM P + P + 1)) :=
    Nat.mul_le_mul h1 (by omega)
  have e : 10 ^ 4 * (M + 1) * (2 * r + 1) * (p + 2 + 2) =
      10 ^ 4 * ((M + 1) * (2 * r + 1) * (p + 2 + 2)) := by ring
  have e2 : 5 * (N + 1) * (2 * (FM P + P + 1)) = 10 * ((N + 1) * (FM P + P + 1)) := by ring
  rw [e] at a; rw [e2] at h2
  generalize (M + 1) * (2 * r + 1) * (p + 2 + 2) = A1 at a h2
  generalize (N + 1) * (FM P + P + 1) = A4 at h2 b ⊢
  omega

theorem pc_cmul (hp : p + 2 ≤ P) :
    cCmul (p + 2) p N ≤ 10 ^ 8 * ((N + 1) * (FM P + P + 1)) := by
  have a := cCmul_le (p + 2) p N
  have hφ : KFM.fmB (2 * (p + 2)) ≤ FM P := fmB_mono (by omega)
  have h1 : 4 * N * KFM.fmB (2 * (p + 2)) ≤ 4 * ((N + 1) * (FM P + P + 1)) := by
    have : N * KFM.fmB (2 * (p + 2)) ≤ (N + 1) * (FM P + P + 1) := Nat.mul_le_mul (by omega) (by omega)
    calc 4 * N * KFM.fmB (2 * (p + 2)) = 4 * (N * KFM.fmB (2 * (p + 2))) := by ring
      _ ≤ _ := Nat.mul_le_mul_left _ this
  have h2 : 10 ^ 7 * (N + 1) * (p + 2 + p + 2) ≤ 2 * 10 ^ 7 * ((N + 1) * (FM P + P + 1)) := by
    have : (N + 1) * (p + 2 + p + 2) ≤ (N + 1) * (2 * (FM P + P + 1)) :=
      Nat.mul_le_mul_left _ (by omega)
    calc 10 ^ 7 * (N + 1) * (p + 2 + p + 2) = 10 ^ 7 * ((N + 1) * (p + 2 + p + 2)) := by ring
      _ ≤ 10 ^ 7 * ((N + 1) * (2 * (FM P + P + 1))) := Nat.mul_le_mul_left _ this
      _ = _ := by ring
  linarith

theorem pc_M (hB : B ≤ P) (hBd : Bd ≤ P) (hb : b ≤ P) (hlen : len ≤ P) :
    cM B Bd b len ≤ 10 ^ 14 * (P + 31) ^ 6 := by
  have a := cM_le B Bd b len
  have h1 : (B + 2) ^ 2 ≤ (P + 31) ^ 6 := le_Y 2 (by norm_num) (by omega)
  have h2 : (b + 1) ^ 3 ≤ (P + 31) ^ 6 := le_Y 3 (by norm_num) (by omega)
  have h3 : (len + 1) * (Bd + 2) ≤ (P + 31) ^ 6 := by
    calc (len + 1) * (Bd + 2) ≤ (P + 31) * (P + 31) := Nat.mul_le_mul (by omega) (by omega)
      _ = (P + 31) ^ 2 := by ring
      _ ≤ _ := le_Y 2 (by norm_num) le_rfl
  have e : 400 * (len + 1) * (Bd + 2) = 400 * ((len + 1) * (Bd + 2)) := by ring
  rw [e] at a
  omega

theorem cBody_le_sol_aux (hP : dlV p h (D + 1) + 3 ≤ P) (hB : B ≤ P) (hBd : Bd ≤ P) (hb : b ≤ P)
    (hlen : len ≤ P) (hst : ∀ i, sv i ≤ t i) (ht2 : ∀ i, 2 ≤ t i) (hT : ∀ i, t i ≤ 2 ^ (h + 1))
    (hprod : ∏ i, t i = 2 ^ ((D + 1) * h + σ))
    (hM : (∏ i : Fin D, t i.castSucc) * 2 ^ (h + 1) = 2 ^ ((D + 1) * h + σ))
    (hdr : (D + 1) * 2 ^ (h + 1) ≤ 2 ^ ((D + 1) * h + σ)) :
    cBody B Bd b len p h D σ sv t ≤
      10 ^ 30 * ((2 ^ ((D + 1) * h + σ) + 1) * (FM P + P + 1) + (P + 31) ^ 6) := by
  have hr := two_pow_h_le hdr
  have hΔ : dlV p h (D + 1) = 2 * p + 2 * h + (D + 1) + 8 := rfl
  have hg : gV p h (D + 1) = p + 2 * h + (D + 1) + 8 := rfl
  have hp2 : p + 2 ≤ P := by omega
  have hQ : 1 ≤ FM P + P + 1 := by omega
  have s0 := pc_setup hB (D := D) (by omega)
  have p2 := pc_push hB 2 (by norm_num)
  have p3 := pc_push hB 3 (by norm_num)
  have p4 := pc_push hB 4 (by norm_num)
  have p5 := pc_push hB 5 (by norm_num)
  have c1 := pc_chirp hP hst ht2 hT hprod hdr
  have m1 := pc_mvX (N := 2 ^ ((D + 1) * h + σ)) (P := P) (n := 2 * 2 ^ ((D + 1) * h + σ))
    (w := dlV p h (D + 1) + 3) le_rfl (by omega)
  have m2 := pc_mvX (N := 2 ^ ((D + 1) * h + σ)) (P := P) (n := 2 * 2 ^ ((D + 1) * h + σ))
    (w := p + 2) le_rfl (by omega)
  have m3 := pc_mvX (N := 2 ^ ((D + 1) * h + σ)) (P := P) (n := 2 * 2 ^ (h + 1))
    (w := dlV p h (D + 1) + 3) (by omega) (by omega)
  have i1 := pc_item (N := 2 ^ ((D + 1) * h + σ)) (P := P) (n := 2 * 2 ^ ((D + 1) * h + σ))
    (c := 3000 * (dlV p h (D + 1) + 3 + gV p h (D + 1) + 3)) (w := 2 * (dlV p h (D + 1) + 3) + 1)
    le_rfl (by omega) (by omega)
  have i2 := pc_item (N := 2 ^ ((D + 1) * h + σ)) (P := P) (n := 2 * 2 ^ (h + 1))
    (c := 3000 * (dlV p h (D + 1) + 3 + gV p h (D + 1) + 3)) (w := 2 * (dlV p h (D + 1) + 3) + 1)
    (by omega) (by omega) (by omega)
  have n1 := pc_cnj (N := 2 ^ ((D + 1) * h + σ)) (P := P) (n := 2 ^ ((D + 1) * h + σ)) le_rfl hp2
  have tw := pc_tw (N := 2 ^ ((D + 1) * h + σ)) (D := D) hP hr
  have rp := pc_repl (N := 2 ^ ((D + 1) * h + σ)) (P := P) hp2 (∏ i : Fin D, t i.castSucc)
    (2 ^ (h + 1)) hM Nat.one_le_two_pow hr
  have cm := pc_cmul (N := 2 ^ ((D + 1) * h + σ)) (P := P) hp2
  have mm := pc_M (P := P) hB hBd hb hlen
  have r1 : cRepl 1 (2 * 2 ^ ((D + 1) * h + σ)) (p + 2) ≤
      10 ^ 6 * ((2 ^ ((D + 1) * h + σ) + 1) * (FM P + P + 1)) := by
    have a := cRepl_le 1 (2 * 2 ^ ((D + 1) * h + σ)) (p + 2)
    have : (2 * 2 ^ ((D + 1) * h + σ) + 1) * (p + 2 + 2) ≤
        (2 * (2 ^ ((D + 1) * h + σ) + 1)) * (2 * (FM P + P + 1)) := Nat.mul_le_mul (by omega) (by omega)
    have e : 10 ^ 4 * (1 + 1) * (2 * 2 ^ ((D + 1) * h + σ) + 1) * (p + 2 + 2) =
        2 * 10 ^ 4 * ((2 * 2 ^ ((D + 1) * h + σ) + 1) * (p + 2 + 2)) := by ring
    have e2 : (2 * (2 ^ ((D + 1) * h + σ) + 1)) * (2 * (FM P + P + 1)) =
        4 * ((2 ^ ((D + 1) * h + σ) + 1) * (FM P + P + 1)) := by ring
    rw [e] at a; rw [e2] at this
    omega
  have y1 : 5 * (2 * B + 2) + 1 ≤ 100 * (P + 31) ^ 6 := by
    have : B + 2 ≤ (P + 31) ^ 6 := by
      simpa using le_Y (P := P) 1 (by norm_num) (show B + 2 ≤ P + 31 by omega)
    omega
  unfold cBody cPP
  omega

