variable {s t lam : ℕ}

theorem stepOK_iff (hs : 0 < s) (l : ℕ) :
    stepOK s t l ↔ rrZ s t ((l : ℤ) + 1) = rrZ s t l + 1 := by
  unfold stepOK IntMul.HvdH.bOf rrZ
  have hs' : (s : ℤ) ≠ 0 := by exact_mod_cast hs.ne'
  constructor
  · intro h
    have : (s : ℤ) * ((2 * (t : ℤ) * ((l : ℤ) + 1) + s) / (2 * s)) =
        (s : ℤ) * ((2 * (t : ℤ) * l + s) / (2 * s) + 1) := by linarith
    exact mul_left_cancel₀ hs' this
  · intro h; rw [h]; ring

theorem cut_iff (hs : 0 < s) {j : ℕ} (hj : 1 ≤ j) :
    cutP s t lam j ↔ j % lam = 0 ∨ rrZ s t j ≠ rrZ s t ((j - 1 : ℕ) : ℤ) + 1 := by
  unfold cutP
  rw [stepOK_iff hs]
  have e : (((j - 1 : ℕ) : ℤ) + 1) = (j : ℤ) := by push_cast [Nat.cast_sub hj]; ring
  rw [e]
  constructor
  · rintro (h | h | h)
    · omega
    · exact Or.inl h
    · exact Or.inr h
  · rintro (h | h)
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr h)

theorem stF_zero : stF s t lam 0 = 0 := by simp [stF]

theorem stF_succ (j : ℕ) :
    stF s t lam (j + 1) = if cutP s t lam (j + 1) then j + 1 else stF s t lam j := by
  unfold stF; rw [Nat.findGreatest_succ]

theorem stF_eq_iff (j : ℕ) : stF s t lam j = j ↔ cutP s t lam j := by
  constructor
  · intro h; have := stF_cut (s := s) (t := t) (lam := lam) j; rwa [h] at this
  · intro h; unfold stF; exact Nat.findGreatest_eq h

end J6Seg.Src

