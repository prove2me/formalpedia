  rfl

theorem tBD_last {n D : ℕ} (_hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R129.dP n = D + 1) : tBD n D (Fin.last D) = IntMul.OpenAI.R129.rP n := by
  have h := mcnt_lt (IntMul.OpenAI.Glue.LP n) (IntMul.OpenAI.R129.dP n) (by omega)
