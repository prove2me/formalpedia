-- Source module: NLogN.HPerm
/-!
# Permuting a list of records by a list of target indices

Stack `0` holds `n` records of `d` integers, `n` is on `1`, the number of key bits `kb`
(`n ≤ 2^kb`) on `2`, and stack `3` holds the target indices `Kl` (a permutation of `0, …, n-1`).
`permP d` moves record `p` to position `Kl[p]`; the index list on `3` is restored.
Scratch: `40`, `41`, `43`, `45`, `51`, `54` and those of `sortP`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

def pRec (Kl : List ℕ) (D : List (List ℤ)) (p : ℕ) : List ℤ := (Kl.getD p 0 : ℤ) :: D.getD p []

def pflat (Kl : List ℕ) (D : List (List ℤ)) (p : ℕ) : List ℤ :=
  ((List.range p).map (pRec Kl D)).flatten

def natInts (Kl : List ℕ) : List Item := ints (List.map (Nat.cast : ℕ → ℤ) Kl)

def pBody (d : ℕ) : RS :=
  NLogN.RS.seq (push 40 (.reg 3)) (NLogN.RS.seq (mvK 0 40 51 (.lit d)) (NLogN.RS.seq (push 41 (.reg 3))
    (NLogN.RS.seq (pop 3) (asg 45 (.add (.reg 45) (.lit (d + 1)))))))

def pSt (s : IState HS) (Kl : List ℕ) (D : List (List ℤ)) (Rest RK : List Item) (d p : ℕ) :
    IState HS :=
  ((((s.upd 0 (ints (D.drop p).flatten ++ Rest)).upd 3 (natInts (Kl.drop p) ++ RK)).upd 40
    (ints (pflat Kl D p).reverse ++ s.G 40)).upd 41
    ((natInts (Kl.take p)).reverse ++ s.G 41)).upd 45
    (.int ((p * (d + 1) : ℕ) : ℤ) :: s.G 45)

def pLoop (d : ℕ) : RS := rep 43 (.reg 1) (pBody d)

def pAttachP (d : ℕ) : RS :=
  NLogN.RS.seq (push 45 (.lit 0)) (NLogN.RS.seq (pLoop d) (NLogN.RS.seq (mvK 40 0 51 (.reg 45))
    (NLogN.RS.seq (mvK 41 3 51 (.reg 1)) (pop 45))))

/-- The permuted list: position `q` holds the record whose target index is `q`. -/
def permL (Kl : List ℕ) (D : List (List ℤ)) : List (List ℤ) :=
  (List.range Kl.length).map fun q => D.getD (Kl.idxOf q) []

def permP (d : ℕ) : RS :=
  NLogN.RS.seq (pAttachP d) (NLogN.RS.seq (sortP (d + 1)) (NLogN.RS.seq (push 54 (.reg 1)) (NLogN.RS.seq (push 45 (.lit 0))
    (NLogN.RS.seq (stripP d) (NLogN.RS.seq (pop 45) (pop 54))))))

/-! ## Costs -/

end NLogN

end

