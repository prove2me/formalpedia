section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open Set PaperBox PaperBox.Bounds
noncomputable section

def fastValue (x : ℚ) : ℚ := if x∈Icc 0 1 then quickScore x else qscore x
def fastJ (x : ℚ) : ℚ := if x∈Icc 0 1 then quickJ x else qprimitive x
@[simp] theorem fastValue_eq (x : ℚ) : fastValue x=qscore x := by
  unfold fastValue;split <;> first | apply quickScore_eq;assumption | rfl
@[simp] theorem fastJ_eq (x : ℚ) : fastJ x=qprimitive x := by
  unfold fastJ;split <;> first | apply quickJ_eq;assumption | rfl

def fastValueBox (i : Bounds) : Bounds :=
  decreasingRange (fun q => point (fastValue q)) (i.meet ⟨0,1⟩)
def fastJBox (i : Bounds) : Bounds :=
  unimodalRange (fun q => point (fastJ q)) lamQ (i.meet ⟨0,1⟩)
@[simp] theorem fastValueBox_eq (i : Bounds) : fastValueBox i=scoreBox i := by simp [fastValueBox,scoreBox]
@[simp] theorem fastJBox_eq (i : Bounds) : fastJBox i=primitiveBox i := by simp [fastJBox,primitiveBox]

def fastSlopeP (b c : Bounds) : Bounds :=
  let x := rankArg b c
  (((point massE).times ((fastJBox x).minus (fastJBox c))).minus
    (((point massE).times b).times (fastValueBox x))).minus (((point lamQ).minus c).times (fastValueBox b))
def fastSlopeQ (b c : Bounds) : Bounds :=
  (((point massE).times b).times ((fastValueBox (rankArg b c)).minus (fastValueBox c))).plus (fastJBox b)
def fastResidual (p q : ℚ) : ℚ :=
  massE*p*(fastJ (1-p+q)-fastJ q)-(lamQ-q)*fastJ p

def fastRectTest (r : Box 2) : Bool :=
  let b := r 0
  let c := r 1
  let s := fastSlopeP b c
  let t := fastSlopeQ b c
  decide (validRectangle b c ∧ fastResidual (anchor b s) (anchor c t)+deviation b s+deviation c t ≤ 0)

theorem fastRectTest_eq : fastRectTest=rectTest := by
  funext r
  apply Bool.eq_iff_iff.mpr
  simp only [fastRectTest,rectTest,boxAccept,fastSlopeP,slopeP,fastSlopeQ,slopeQ,fastResidual,qResidual,fastJ_eq,fastValueBox_eq,fastJBox_eq,decide_eq_true_eq]
  exact decide_eq_true_iff.symm

end
end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open PaperBox

/-- A valid finite partition on the displayed physical rectangle. -/
def C2 (f : Box 2 → Bool) (p P q Q : ℚ) : Prop :=
  ∃ t : Cover 2, t.verify f ![⟨p,P⟩,⟨q,Q⟩]=true
def C3 (f : Box 3 → Bool) (p P q Q z Z : ℚ) : Prop :=
  ∃ t : Cover 3, t.verify f ![⟨p,P⟩,⟨q,Q⟩,⟨z,Z⟩]=true

private theorem split_rect {d : ℕ} {f : Box d → Bool} {b l r : Box d}
    {s t : Cover d} (i : Fin d) (u : ℚ) (el : lowerBox b i u=l)
    (er : upperBox b i u=r) (h : s.verify f l=true) (k : t.verify f r=true) :
    (Cover.split i u s t).verify f b=true := by
  simp only [Cover.verify,el,er,h,k,Bool.and_self]

theorem cLeaf2 {f : Box 2 → Bool} {p P q Q : ℚ}
    (h : f ![⟨p,P⟩,⟨q,Q⟩]=true) : C2 f p P q Q := ⟨.leaf,h⟩
theorem cLeaf3 {f : Box 3 → Bool} {p P q Q z Z : ℚ}
    (h : f ![⟨p,P⟩,⟨q,Q⟩,⟨z,Z⟩]=true) : C3 f p P q Q z Z := ⟨.leaf,h⟩

theorem cSplit20 {f : Box 2 → Bool} {p P q Q : ℚ} (cut : ℚ)
    (a : C2 f p cut q Q) (b : C2 f cut P q Q) : C2 f p P q Q := by
  obtain ⟨s,hs⟩ := a
  obtain ⟨t,ht⟩ := b
  refine ⟨.split 0 cut s t,split_rect 0 cut ?_ ?_ hs ht⟩ <;> funext j <;> fin_cases j <;> rfl

theorem cSplit21 {f : Box 2 → Bool} {p P q Q : ℚ} (cut : ℚ)
    (a : C2 f p P q cut) (b : C2 f p P cut Q) : C2 f p P q Q := by
  obtain ⟨s,hs⟩ := a
  obtain ⟨t,ht⟩ := b
  refine ⟨.split 1 cut s t,split_rect 1 cut ?_ ?_ hs ht⟩ <;> funext j <;> fin_cases j <;> rfl

theorem cSplit30 {f : Box 3 → Bool} {p P q Q z Z : ℚ} (cut : ℚ)
    (a : C3 f p cut q Q z Z) (b : C3 f cut P q Q z Z) : C3 f p P q Q z Z := by
  obtain ⟨s,hs⟩ := a
  obtain ⟨t,ht⟩ := b
  refine ⟨.split 0 cut s t,split_rect 0 cut ?_ ?_ hs ht⟩ <;> funext j <;> fin_cases j <;> rfl

theorem cSplit31 {f : Box 3 → Bool} {p P q Q z Z : ℚ} (cut : ℚ)
    (a : C3 f p P q cut z Z) (b : C3 f p P cut Q z Z) : C3 f p P q Q z Z := by
  obtain ⟨s,hs⟩ := a
  obtain ⟨t,ht⟩ := b
  refine ⟨.split 1 cut s t,split_rect 1 cut ?_ ?_ hs ht⟩ <;> funext j <;> fin_cases j <;> rfl

theorem cSplit32 {f : Box 3 → Bool} {p P q Q z Z : ℚ} (cut : ℚ)
    (a : C3 f p P q Q z cut) (b : C3 f p P q Q cut Z) : C3 f p P q Q z Z := by
  obtain ⟨s,hs⟩ := a
  obtain ⟨t,ht⟩ := b
  refine ⟨.split 2 cut s t,split_rect 2 cut ?_ ?_ hs ht⟩ <;> funext j <;> fin_cases j <;> rfl


/-- A box partition described by midpoint cuts and their coordinate indices. -/
inductive AxisPartition (d : ℕ) where
  | leaf
  | bisect (j : Fin d) (left right : AxisPartition d)

namespace AxisPartition

/-- Check the two-dimensional rectangles, passing the four rational endpoints
directly to the appropriate child at each bisection. -/
def check2 (f : Box 2 → Bool) : AxisPartition 2 → ℚ → ℚ → ℚ → ℚ → Bool
  | .leaf, p, P, q, Q => f ![⟨p,P⟩,⟨q,Q⟩]
  | .bisect j left right, p, P, q, Q =>
    if j=0 then
      let m := (p+P)/2
      check2 f left p m q Q && check2 f right m P q Q
    else
      let m := (q+Q)/2
      check2 f left p P q m && check2 f right p P m Q

/-- Every successful numerical decision provides a verified cover of the original box. -/
theorem covers2 (f : Box 2 → Bool) (t : AxisPartition 2) {p P q Q : ℚ}
    (h : check2 f t p P q Q = true) : C2 f p P q Q := by
  induction t generalizing p P q Q with
  | leaf => exact cLeaf2 h
  | bisect j left right il ir =>
    by_cases hp : j=0
    · simp only [check2,if_pos hp,Bool.and_eq_true] at h
      exact cSplit20 _ (il h.1) (ir h.2)
    · simp only [check2,if_neg hp,Bool.and_eq_true] at h
      exact cSplit21 _ (il h.1) (ir h.2)

/-- Three-dimensional check on the mass, candidate rank and adversarial rank. -/
def check3 (f : Box 3 → Bool) : AxisPartition 3 → ℚ → ℚ → ℚ → ℚ → ℚ → ℚ → Bool
  | .leaf, p, P, q, Q, z, Z => f ![⟨p,P⟩,⟨q,Q⟩,⟨z,Z⟩]
  | .bisect j left right, p, P, q, Q, z, Z =>
    if j=0 then
      let m := (p+P)/2
      check3 f left p m q Q z Z && check3 f right m P q Q z Z
    else if j=1 then
      let m := (q+Q)/2
      check3 f left p P q m z Z && check3 f right p P m Q z Z
    else
      let m := (z+Z)/2
      check3 f left p P q Q z m && check3 f right p P q Q m Z

theorem covers3 (f : Box 3 → Bool) (t : AxisPartition 3) {p P q Q z Z : ℚ}
    (h : check3 f t p P q Q z Z = true) : C3 f p P q Q z Z := by
  induction t generalizing p P q Q z Z with
  | leaf => exact cLeaf3 h
  | bisect j left right il ir =>
    by_cases hp : j=0
    · simp only [check3,if_pos hp,Bool.and_eq_true] at h
      exact cSplit30 _ (il h.1) (ir h.2)
    by_cases hq : j=1
    · simp only [check3,if_neg hp,if_pos hq,Bool.and_eq_true] at h
      exact cSplit31 _ (il h.1) (ir h.2)
    · simp only [check3,if_neg hp,if_neg hq,Bool.and_eq_true] at h
      exact cSplit32 _ (il h.1) (ir h.2)

end AxisPartition
end StableVotingDistortion.PaperCurve
end

