-- Source module: NLogN.HRspDTab
/-!
# Building the `D̃'` table `dTab p s t α` (one row `dTilde p s t α l`, `l < s`) on `W3`

Scalars: `TP = p`, `TS = s`, `TT = t`, `TK2 = s²`, `TBe = α²`, `TSg = 2α² - 2`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN RS

/-- `2α² - 2` (the `σ` argument of `expPos`). -/
abbrev TSg : Fin HS := 25

/-- `t l - s r_l`. -/
def dDE : Ex HS := .add (.mul (.reg NLogN.Rsp.TT) kE) (.neg (.mul (.reg TS) cRE))
/-- `α² (t l - s r_l)²`. -/
def XDE : Ex HS := .mul (.reg TBe) (.mul dDE dDE)

/-- The `D̃'` weight program. -/
def dTWP : RS :=
  NLogN.RS.seq (push 16 (.reg TP)) (NLogN.RS.seq (push 17 (.reg TK2)) (NLogN.RS.seq (push 18 XDE) (NLogN.RS.seq (push 27 (.reg TSg))
    (NLogN.RS.seq expPosP (NLogN.RS.seq (push W3 (.reg 19)) (NLogN.RS.seq (pop 19) (NLogN.RS.seq (pop 27) (NLogN.RS.seq (pop 18)
      (NLogN.RS.seq (pop 17) (pop 16))))))))))

def dTWf (p s t A K2 g : ℕ) (_i k : ℕ) : ℤ := HvdH.expPos p K2 (A * HvdH.kOf s t k) g

def dTWCost (p g Bq : ℕ) : ℕ := 100 * 10 ^ 7 * (Bq + 2) ^ 2 + expPosCost p Bq Bq g

/-- The `D̃'` table builder: pushes `ints (dTab p s t α).flatten` on `W3`. -/
def dTabBP : RS := row1P W3 TS dTWP

end NLogN.Rsp

end

section
-- Source module: NLogN.HRspETab
/-!
# Building the `E` weight table `eTab p s t α` on `BW`

Row `i < 2m+1` (`h = i - m`), column `l < s`: `eW p s t α i l`.
Scalars: `TP = p`, `TS = s`, `TT = t`, `TM = m = eWidth p α`, `TK2 = s²`, `TBe = α²`,
`TRI = 2m+1`; counters `TCI`, `TCK`.
The floor division in `bOf s t (l+h)` (numerator possibly negative) is computed as
`(N + 2s·tm) / (2s) - tm` with a non-negative shifted numerator.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN RS

/-- `h = i - m`. -/
def hE : Ex HS := .add iE (.neg (.reg TM))
/-- `l + h`. -/
def xE : Ex HS := .add kE hE
/-- `2t(l+h) + s + 2s·t·m ≥ 0`. -/
def nE : Ex HS :=
  .add (.add (.mul (.add (.reg NLogN.Rsp.TT) (.reg NLogN.Rsp.TT)) NLogN.Rsp.xE) (.reg TS))
    (.mul (.mul (.add (.reg TS) (.reg TS)) (.reg NLogN.Rsp.TT)) (.reg TM))
/-- `⌊(2t(l+h) + s) / (2s)⌋`. -/
def flE : Ex HS := .add (.ndiv nE (.add (.reg TS) (.reg TS))) (.neg (.mul (.reg NLogN.Rsp.TT) (.reg TM)))
/-- `b_{l+h}`. -/
def bxE : Ex HS := .add (.mul (.reg NLogN.Rsp.TT) NLogN.Rsp.xE) (.neg (.mul (.reg TS) flE))
/-- `t h + b_l`. -/
def aE' : Ex HS := .add (.mul (.reg NLogN.Rsp.TT) hE) dDE
/-- `K_{l,h}`. -/
def kzE : Ex HS := .add (.mul aE' aE') (.neg (.mul bxE bxE))
/-- `α² · K_{l,h}.toNat`. -/
def XEE : Ex HS := .mul (.reg TBe) (.sel kzE (.lit 0) kzE)

/-! ## a generic bound for polynomial expressions -/

/-- A degree-like measure: `|e| ≤ D ^ deg e` when all leaves are `≤ D` (`D ≥ 2`). -/
def deg : Ex HS → ℕ
  | .reg _ | .lit _ => 1
  | .add a b => max (deg a) (deg b) + 1
  | .mul a b => deg a + deg b
  | .neg a => deg a
  | .ndiv a b | .nmod a b => max (deg a) (deg b)
  | .sel c x y => max (deg c) (max (deg x) (deg y))
  | _ => 0

/-- Leaves bounded by `D`, divisions of non-negatives by positives, no shifts/powers. -/
def PolyOK (σ : IState HS) (D : ℤ) : Ex HS → Prop
  | .reg i => |σ.top i| ≤ D
  | .lit c => |c| ≤ D
  | .add a b | .mul a b => PolyOK σ D a ∧ PolyOK σ D b
  | .neg a => PolyOK σ D a
  | .ndiv a b | .nmod a b => PolyOK σ D a ∧ PolyOK σ D b ∧ 0 ≤ a.eval σ ∧ 0 < b.eval σ
  | .sel c x y => PolyOK σ D c ∧ PolyOK σ D x ∧ PolyOK σ D y
  | _ => False

end NLogN.Rsp

end

