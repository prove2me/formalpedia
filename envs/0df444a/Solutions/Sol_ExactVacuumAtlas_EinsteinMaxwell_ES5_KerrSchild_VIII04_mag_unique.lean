  refine ⟨hRh, by unfold n1; linarith, hR0, hN, div_pos hN (by positivity), div_pos hN hR0,
    div_pos hN hR0, fun Q => ?_⟩
  unfold Vc; positivity

theorem Vc_pos (Q : ℝ) {R : ℝ} (hR : 0 < R) : 0 < Vc Q R := by
  unfold Vc; positivity

