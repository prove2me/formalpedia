theorem IntMul.Kappa.R6.IL2C.corrLC_runs {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {l : Lay} {K ρ G n L B : ℕ} (hB : 1 ≤ B)
    (hV : KVal l K ρ G n L l.M (zsz ((l.M * B : ℕ) : ℤ) + 3))
    (t : IState HS) (recs : ℕ → List ℤ) (hlen : ∀ m, (recs m).length = B)
    (hbits : ∀ m, Bnd 1 (recs m)) (R0 : List Item) (h0 : t.G 0 = ints (flR recs l.M) ++ R0)
    (hE : KEnv t l K ρ G n) {eB eM eA : Ex HS} {Bb : ℕ}
    (hsz : ((corrPlC eB eM eA).map fun p => p.2.size + 1).sum ≤ 30)
    (n1 : NoLow eB) (n2 : NoLow eM) (n3 : NoLow eA)
    (E1 : ESp eB t Bb (B : ℤ)) (E2 : ESp eM t Bb (l.M : ℤ))
    (E3 : ESp eA t Bb (zsz ((l.M * B : ℕ) : ℤ) : ℤ)) :
    IRuns I iprog (corrLC eB eM eA) t
      (t.upd 0 (ints (flR (fun d => recs (corrC l K ρ G n L d)) l.M) ++ R0))
      (30 * 10 ^ 7 * (Bb + 2) ^ 2 + 1 +
        400 * cCorrG (cKeyC (zsz ((l.M * B : ℕ) : ℤ) + 3) n) B l.M (zsz ((l.M * B : ℕ) : ℤ))
          (nMv (keyC l K ρ G n L) l.M) (zsz ((l.M * B : ℕ) : ℤ) + 3) +
        (3 * (2 * Bb + 2) + 1)) := by sorry
