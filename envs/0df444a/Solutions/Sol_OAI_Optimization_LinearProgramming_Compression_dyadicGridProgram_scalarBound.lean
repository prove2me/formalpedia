theorem ratBits_mul_le (q r : ℚ) : ratBits (q*r) ≤ 1 + 2 * (ratBits q + ratBits r) := by
  linarith [ratBits_le_width (q*r), width_mul q r, width_le_ratBits q, width_le_ratBits r]

