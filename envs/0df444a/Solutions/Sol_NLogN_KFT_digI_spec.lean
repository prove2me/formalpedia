    (a := (2 : ℤ) ^ b) (L := s.G NLogN.KFT.tR) (by simp +decide [s6, s5, s4, s3, s2, s1])
  refine (h1.seq (h2.seq (h3.seq (h4.seq (h5.seq (h6.seq (h7.seq h8))))))).mono' ?_ ?_
  · have eG : NLogN.ints (NLogN.KFB.gflat (NLogN.KFT.digG b e M S x)) =
        NLogN.ints (NLogN.KFB.gflat ((NLogN.KFT.chk b M x).map (NLogN.KFT.fG e))) ++ NLogN.ints (List.replicate (2 * (S - M)) 0) := by
      rw [NLogN.KFT.digG, NLogN.KFB.gflat_append, NLogN.KFT.gflat_replicate, NLogN.ints_append]; rfl
    rw [eG]
    simp only [s6, s5, s4, s3, s2, s1]
    clear h1 h2 h3 h4 h5 h6 h7 h8 eG hq hx hX
    apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;>
      split_ifs <;> subst_vars <;> simp_all +decide [NLogN.ints_append]
  · have z1 : NLogN.zsz ((2 : ℤ) ^ b) = b + 1 := NLogN.zsz_two_pow b
    have z2 : NLogN.zsz ((2 : ℤ) ^ e) = e + 1 := NLogN.zsz_two_pow e
    simp only [z1, z2, NLogN.zsz_zero, Nat.cast_zero, NLogN.KFT.cDig]
    omega
end
