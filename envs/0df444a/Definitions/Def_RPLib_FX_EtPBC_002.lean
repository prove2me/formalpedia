theorem assoc4 {A B D E F G : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ D) (c : D ⟶ E) (d : E ⟶ F) (e : F ⟶ G) :
    (a ≫ b ≫ c ≫ d) ≫ e = a ≫ b ≫ c ≫ d ≫ e := by
  simp only [Category.assoc]

theorem comp_apply4 {A B D E F : Scheme.{u}} (a : A ⟶ B) (b : B ⟶ D) (c : D ⟶ E) (d : E ⟶ F) (x : A) :
    (a ≫ b ≫ c ≫ d) x = d (c (b (a x))) :=
  (Scheme.Hom.comp_apply _ _ x).trans <| (Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _)

/-- Sections of a composite (generic, so the kernel never unfolds the factors). -/
theorem sh_comp_apply {X : Scheme.{u}} {F G H : EtSh Λ X} (φ : F ⟶ G) (ψ : G ⟶ H) (V : (X.Etale)ᵒᵖ)
    (z : F.obj.obj V) : ((φ ≫ ψ).hom.app V).hom z = (ψ.hom.app V).hom ((φ.hom.app V).hom z) := rfl

/-- Sections of `Ψ_* φ` (generic). -/
theorem push_map_app {X Z : Scheme.{u}} (Ψ : X ⟶ Z) {G G' : EtSh Λ X} (φ : G ⟶ G') (V : Z.Etale)
    (z : ((push Ψ Λ).obj G).obj.obj (op V)) :
    (((push Ψ Λ).map φ).hom.app (op V)).hom z = (φ.hom.app (op ((etPull Ψ).obj V))).hom z := rfl

section C1

variable {P P' Y U Ps : Scheme.{u}} (π : Y ⟶ P) (f : P' ⟶ P) (Φ : U ⟶ P') (h : U ⟶ Y)
  (hh : h ≫ π = Φ ≫ f) (ι' : Ps ⟶ P')

include hh in
theorem hsU_cond (ι : Ps ⟶ P) (hι : ι' ≫ f = ι) :
    (pullback.fst Φ ι' ≫ h) ≫ π = pullback.snd Φ ι' ≫ ι := by
  rw [← hι, Category.assoc, hh, ← Category.assoc, pullback.condition, Category.assoc]

/-- `U_s ⟶ Y_s` over `h`. -/
def hsU (ι : Ps ⟶ P) (hι : ι' ≫ f = ι) : pullback Φ ι' ⟶ pullback π ι :=
  pullback.lift (pullback.fst Φ ι' ≫ h) (pullback.snd Φ ι') (hsU_cond π f Φ h hh ι' ι hι)

@[reassoc]
theorem hsU_fst (ι : Ps ⟶ P) (hι : ι' ≫ f = ι) :
    hsU π f Φ h hh ι' ι hι ≫ pullback.fst π ι = pullback.fst Φ ι' ≫ h :=
  pullback.lift_fst _ _ _

theorem hsU_snd (ι : Ps ⟶ P) (hι : ι' ≫ f = ι) :
    hsU π f Φ h hh ι' ι hι ≫ pullback.snd π ι = pullback.snd Φ ι' :=
  pullback.lift_snd _ _ _

end C1

