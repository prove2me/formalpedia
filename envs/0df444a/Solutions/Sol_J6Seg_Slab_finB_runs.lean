variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem encK_upd' (s : IState HS) (F : Fin HS → List ℤ) (i : Fin HS) (l : List ℤ) :
    (encK s F).upd i (ints l ++ s.G i) = encK s (update F i l) := by
  refine IState.ext' (fun x => ?_) rfl rfl
  by_cases h : x = i
  · subst h; simp
  · simp [h]

theorem dupM (s : IState HS) (F : Fin HS → List ℤ) {i j : Fin HS} (hij : i ≠ j) {a : ℤ}
    {l : List ℤ} (hi : F i = a :: l) :
    IRuns I iprog (.op (.dup i j)) (encK s F) (encK s (update F j (a :: F j)))
      (dupCost (zsz a) + 17) := by
  have h := IRuns.dup (I := I) (iprog := iprog) (s := encK s F) (i := i) (j := j) hij
    (L := ints l ++ s.G i) (a := a) (by simp [hi, ints])
  refine h.mono' ?_ le_rfl
  rw [show (Item.int a :: (encK s F).G j) = ints (a :: F j) ++ s.G j by simp [ints], encK_upd']

theorem dropM (s : IState HS) (F : Fin HS → List ℤ) {i : Fin HS} {a : ℤ} {l : List ℤ}
    (hi : F i = a :: l) :
    IRuns I iprog (.op (.drop i)) (encK s F) (encK s (update F i l)) (2 * zsz a + 2) := by
  have h := IRuns.drop (I := I) (iprog := iprog) (s := encK s F) (i := i)
    (L := ints l ++ s.G i) (a := a) (by simp [hi, ints])
  exact h.mono' (encK_upd' s F i l) le_rfl

theorem constM (s : IState HS) (F : Fin HS → List ℤ) (i : Fin HS) (c : ℤ) :
    IRuns I iprog (.op (.const i c)) (encK s F) (encK s (update F i (c :: F i))) (zsz c + 2) := by
  have h := IRuns.const (I := I) (iprog := iprog) (s := encK s F) i c
  refine h.mono' ?_ le_rfl
  rw [show (Item.int c :: (encK s F).G i) = ints (c :: F i) ++ s.G i by simp [ints], encK_upd']

/-- The `rptX` counters over a managed state with empty counter stacks. -/
theorem cf3_encK (s : IState HS) (F : Fin HS → List ℤ) (hA : F lA = []) (hC : F lC = [])
    (hD : F lD = []) (LA LC LD : List Item) :
    cf3 (encK s F) lA lC lD LA LC LD = encK (cf3 s lA lC lD LA LC LD) F := by
  unfold cf3
  refine IState.ext' (fun x => ?_) rfl rfl
  by_cases e1 : x = lD
  · subst e1; simp [hD]
  · by_cases e2 : x = lC
    · subst e2; simp [hC]
    · by_cases e3 : x = lA
      · subst e3; simp [hA]
      · simp [e1, e2, e3]

