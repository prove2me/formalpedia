/-! ### Product identity -/
lemma rs_prod_id (k : ℕ) (hk : k < 52) :
    ∏ p ∈ Nat.primesLE (rsPtab k), (p : ℝ) / ((p : ℝ) - 1) =
      ((rsPnum k : ℕ) : ℝ) / ((rsPden k : ℕ) : ℝ) := by
  have hsub : ∀ p ∈ Nat.primesLE (rsPtab k), (p : ℝ) - 1 = ((p - 1 : ℕ) : ℝ) := by
    intro p hp
    have h1 : 1 ≤ p := (Nat.one_lt_of_mem_primesLE hp).le
    simpa using (Nat.cast_sub h1).symm
  rw [show (∏ p ∈ Nat.primesLE (rsPtab k), (p : ℝ) / ((p : ℝ) - 1)) =
        ∏ p ∈ Nat.primesLE (rsPtab k), (p : ℝ) / ((p - 1 : ℕ) : ℝ) by
      exact Finset.prod_congr rfl (fun p hp => by rw [hsub p hp]),
    Finset.prod_div_distrib, ← Nat.cast_prod, ← Nat.cast_prod,
    rs_pnum_eq k hk, rs_pden_eq k hk]


/-! ### e^γ lower bound -/
theorem rs_exp_gamma_ge :
    (1781071 : ℝ) / 10 ^ 6 ≤ Real.exp Real.eulerMascheroniConstant := by
  calc (1781071 : ℝ) / 10 ^ 6
      ≤ ∑ i ∈ Finset.range 12, (57721565 / 10 ^ 8 : ℝ) ^ i / (i.factorial : ℝ) := by
        norm_num [Finset.sum_range_succ, Nat.factorial]
    _ ≤ Real.exp (57721565 / 10 ^ 8) :=
        Real.sum_le_exp_of_nonneg (by norm_num) 12
    _ ≤ Real.exp Real.eulerMascheroniConstant :=
        Real.exp_le_exp.mpr theta_cert_totient_gamma_lower


/-! ### Log lower bounds: `rsClo k / 10^6 < log (rsPtab k)` -/

lemma rs_loglo_0 : ((rsClo 0 : ℕ) : ℝ) < Real.log (rsPtab 0) * 10 ^ 6 := by
  rw [show rsPtab 0 = 691 by decide]
  have hM : ((rsClo 0 : ℕ) : ℝ) = ((6 : ℝ) + 0.538137) * 10 ^ 6 := by
    rw [show rsClo 0 = 6538137 by decide]
    norm_num
  rw [hM]
