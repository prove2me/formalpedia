namespace Butterfly

open AModel Matrix Finset

variable {sh : Shape} {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {M : Type*} [AddCommMonoid M] [Module ℂ M]

variable (Sb : SelBits sh ι)

@[simp] lemma length_selOp (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) :
    (selOp Sb T xs).length = AModel.vol sh := by simp [selOp]

lemma getElem_selOp (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) (j : ℕ)
    (hj : j < (selOp Sb T xs).length) :
    (selOp Sb T xs)[j] =
      ∑ y, T (Sb.bits (decode sh j)) y • xs.getD (encode sh (Sb.set (decode sh j) y)) 0 := by
  simp [selOp]

/-- Value of `selOp` at a valid address. -/
lemma getD_selOp_encode (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) {a : List ℕ}
    (ha : AModel.Valid sh a) :
    (selOp Sb T xs).getD (encode sh a) 0 =
      ∑ y, T (Sb.bits a) y • xs.getD (encode sh (Sb.set a y)) 0 := by
  have hlt := encode_lt ha
  rw [List.getD_eq_getElem _ _ (by simpa using hlt), getElem_selOp, decode_encode ha]

/-- Composition of selected-bit operators is the matrix product. -/
theorem selOp_mul (T U : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) :
    selOp Sb T (selOp Sb U xs) = selOp Sb (T * U) xs := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [length_selOp] at h₁
  have hv := valid_decode h₁
  rw [getElem_selOp, getElem_selOp]
  simp_rw [getD_selOp_encode Sb U xs (Sb.valid_set _ _ hv), Sb.bits_set _ _ hv,
    Sb.set_set _ _ _ hv, Finset.smul_sum, smul_smul, Matrix.mul_apply, Finset.sum_smul]
  exact Finset.sum_comm

theorem selOp_one {xs : List M} (h : xs.length = AModel.vol sh) : selOp Sb 1 xs = xs := by
  apply List.ext_getElem (by simp [h])
  intro j h₁ h₂
  simp only [length_selOp] at h₁
  have hv := valid_decode h₁
  rw [getElem_selOp]
  simp only [Matrix.one_apply, ite_smul, one_smul, zero_smul]
  rw [Finset.sum_ite_eq, if_pos (mem_univ _), Sb.set_bits _ hv, encode_decode h₁,
    List.getD_eq_getElem]

theorem selOp_smul (c : ℂ) (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (xs : List M) :
    selOp Sb (c • T) xs = (selOp Sb T xs).map (c • ·) := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [List.getElem_map, getElem_selOp, Matrix.smul_apply, smul_eq_mul, mul_smul,
    Finset.smul_sum]

lemma tensF_kerAt_apply (i : ι) (A : M2) (x y : ι → Fin 2) :
    tensF (kerAt i A) x y = ∑ b : Fin 2, if y = Function.update x i b then A (x i) b else 0 := by
  rw [tensF_apply, ← Finset.mul_prod_erase _ _ (mem_univ i)]
  have hi : kerAt i A i = A := Function.update_self _ _ _
  have hrest : ∏ k ∈ univ.erase i, kerAt i A k (x k) (y k) =
      if ∀ k, k ≠ i → x k = y k then 1 else 0 := by
    have : ∀ k ∈ univ.erase i, kerAt i A k (x k) (y k) = if x k = y k then 1 else 0 := by
      intro k hk
      rw [kerAt, Function.update_of_ne (Finset.ne_of_mem_erase hk), Matrix.one_apply]
    rw [Finset.prod_congr rfl this, Finset.prod_boole]
    simp only [Finset.mem_erase, mem_univ, and_true]
  rw [hi, hrest]
  rw [Finset.sum_eq_single (y i)]
  · by_cases hxy : ∀ k, k ≠ i → x k = y k
    · have : y = Function.update x i (y i) := by
        funext k; by_cases hk : k = i
        · subst hk; simp
        · rw [Function.update_of_ne hk, hxy k hk]
      rw [if_pos hxy, if_pos this, mul_one]
    · have : ¬ y = Function.update x i (y i) := by
        intro hy; apply hxy; intro k hk; rw [hy, Function.update_of_ne hk]
      rw [if_neg hxy, if_neg this, mul_zero]
  · intro b _ hb
    rw [if_neg]; intro hy; apply hb; rw [hy, Function.update_self]
  · simp

lemma list_prod_kerAt (A : M2) (k : ι) :
    ∀ l : List ι, l.Nodup →
      ((l.map fun i => kerAt i A).map fun B => B k).prod = if k ∈ l then A else 1
  | [], _ => by simp
  | i :: l, hnd => by
    have ih := list_prod_kerAt A k l (List.nodup_cons.1 hnd).2
    simp only [List.map_cons, List.prod_cons, List.mem_cons, ih]
    by_cases hki : k = i
    · subst hki
      have : k ∉ l := (List.nodup_cons.1 hnd).1
      simp [kerAt, this]
    · simp [kerAt, Function.update_of_ne hki, hki]

/-- The tensor power `A^{⊗ι}` is the product of the individual kernels, in any order. -/
theorem tens_eq_prod_kerAt (A : M2) (l : List ι) (hnd : l.Nodup) (hl : ∀ i, i ∈ l) :
    (Butterfly.tens A : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) = ((l.map fun i => kerAt i A).map tensF).prod := by
  rw [← tensF_list_prod]
  unfold Butterfly.tens
  congr 1; funext k
  rw [list_prod_kerAt A k l hnd, if_pos (hl k)]

/-- (18) on arrays: `H0^{⊗D} z = b^D • S_D C^{⊗D} S_D z`. -/
theorem butterflyLayer_eq (xs : List M) :
    butterflyLayer Sb xs =
      (phaseLayer Sb (cLayer Sb (phaseLayer Sb xs))).map ((Butterfly.cb ^ Fintype.card ι) • ·) := by
  rw [butterflyLayer, tens_H0, selOp_smul, phaseLayer, cLayer, phaseLayer, selOp_mul, selOp_mul]

/-- Disk arrays go to disk arrays (every row of `H0^{⊗D}` has absolute row sum one). -/
theorem butterflyLayer_norm_le {N : Type*} [SeminormedAddCommGroup N] [NormedSpace ℂ N]
    (Sb : SelBits sh ι) (xs : List N) (hxs : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    ∀ j (h : j < (butterflyLayer Sb xs).length), ‖(butterflyLayer Sb xs)[j]‖ ≤ 1 := by
  intro j h
  rw [show (butterflyLayer Sb xs)[j] = _ from getElem_selOp Sb (Butterfly.tens H0) xs j h]
  have hg : ∀ k, ‖xs.getD k 0‖ ≤ 1 := by
    intro k
    by_cases hk : k < xs.length
    · rw [List.getD_eq_getElem _ _ hk]; exact hxs k hk
    · rw [List.getD_eq_default _ _ (by omega)]; simp
  calc ‖∑ y, (Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) y •
          xs.getD (encode sh (Sb.set (decode sh j) y)) 0‖
      ≤ ∑ y, ‖(Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) y •
          xs.getD (encode sh (Sb.set (decode sh j) y)) 0‖ := norm_sum_le _ _
    _ ≤ ∑ y, ‖(Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) y‖ := by
        apply Finset.sum_le_sum; intro y _
        rw [norm_smul]
        exact mul_le_of_le_one_right (norm_nonneg _) (hg _)
    _ = 1 := tens_H0_row_sum _

