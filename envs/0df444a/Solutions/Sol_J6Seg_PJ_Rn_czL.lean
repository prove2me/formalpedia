      u' 6 = (if r < m - 1 - j ∧ cB ≤ Lg L (m - 1 - j) then 1 else 0) ∧
      (∀ i ∉ ([6, 7, 8, 29] : List (Fin HS)), u' i = u i) ∧ BV W u') c
      (costL W (m * m + m) czI) := by
  obtain ⟨f9, f10, f11, f12, f21, f28⟩ := hF
  obtain ⟨hM, hL⟩ := hS
  have hq : m - 1 - j < m := by omega
  have eq : (m : ℤ) - 1 - j = ((m - 1 - j : ℕ) : ℤ) := by omega
  have ei : (r : ℤ) * m + ((m - 1 - j : ℕ) : ℤ) = ((r * m + (m - 1 - j) : ℕ) : ℤ) := by push_cast; ring
  have g1 : (matL Mf m).getD (r * m + (m - 1 - j)) 0 = Mf r (m - 1 - j) := matL_get2 Mf hr hq
  have h1W : (1 : ℤ) ≤ 2 ^ W := one_le_pow₀ (by norm_num)
  have hok : OkL W (m * m + m) czI (u, c) := by
    simp (disch := decide) only [czI, OkL, runL, Ins.run, Ins.ok, E.den, qzE, update_of_ne,
      update_self, h1, h2, f28, f12, hM, hL, eq, ei, Int.toNat_natCast, castL_getD, g1,
      matL_length, List.length_map, hLm, den_ltE]
    and_intros
    all_goals first | assumption | (push_cast; omega) | positivity | decide | exact le_trans (by decide) hB.two | exact hB.Mb | exact hB.Lb | (rw [abs_le]; split_ifs <;> constructor <;> linarith) | exact_mod_cast idx_lt hr hq | (have := hB.2.1; push_cast; nlinarith) | skip
    done
  have h := Rn.insL hB.2.1 czI hv hok
  have hc : (runL czI (u, c)).2 = c := by simp only [czI, runL, Ins.run]
  rw [hc] at h
  refine h.mono (fun u' hu => ?_) le_rfl
  obtain ⟨e, hb⟩ := hu
  subst e
  refine ⟨?_, ?_, ?_, ?_, hb⟩
  · simp (disch := decide) only [czI, runL, Ins.run, E.den, qzE, update_of_ne, update_self, h1, h2,
      f28, hL, eq, Int.toNat_natCast, castL_getD]
  · simp (disch := decide) only [czI, runL, Ins.run, E.den, qzE, update_of_ne, update_self, h1, h2,
      f28, hM, eq, ei, Int.toNat_natCast, g1]
  · simp (disch := decide) only [czI, runL, Ins.run, E.den, qzE, update_of_ne, update_self, h1, h2,
      f28, f12, hL, eq, Int.toNat_natCast, castL_getD, den_ltE]
    split_ifs <;> first | rfl | omega | (exfalso; omega) | skip
