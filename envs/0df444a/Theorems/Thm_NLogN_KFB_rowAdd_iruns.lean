theorem NLogN.KFB.rowAdd_iruns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    (s : IState HS) (wb : ℕ) {W m n : ℕ} (hW : 1 ≤ W) (T : Butterfly.Op (Fin n)) (w : Fin W)
    (i j : Fin m) (hij : i ≠ j) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : Rep zs x) (h0 : f 0 = gflat zs ++ l)
    (hC : Cl f) (hb : NLogN.KFB.GB wb zs) :
    ∃ zs', Rep zs' ((P8Lift.RStep.den T
        (P8Lift.RStep.rowAdd w i j hij : P8Lift.RStep (Fin W) m)).mulVec x) ∧ NLogN.KFB.GB wb zs' ∧
      IRuns I iprog (rowP W m n w.val i j n) (encK s f)
        (encK s (Function.update f 0 (gflat zs' ++ l))) (n * cColU W (m * n) wb + 1) := by sorry
