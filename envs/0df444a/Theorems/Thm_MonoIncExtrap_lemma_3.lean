-- title:
--   Lemma 3, p.14 — $v^t\in(F+B)(x^{t+1})$ and the identity (45)
-- statement:
--   Assume the standing assumptions of §2: $\gamma_0>0$, $\delta\in(0,1)$, $0<\nu\le1/2$, $\eta\in[0,\nu/(1+\nu))$, $\epsilon>0$, $x^0\in\mathrm{dom}\,B$, Assumption 1 with $\mu>0$, and let $x^*$ be the solution of (1). Let $\Delta^t=F(x^t)-F(x^{t-1})$, $\tilde\Delta^t=\Delta^t-\eta\gamma_{t-1}^{-1}(x^t-x^{t-1})$, $\tilde\gamma_t=\gamma_t/(1-\eta)$ and
--   $$
--   v^t=\gamma_t^{-1}\bigl(x^t-x^{t+1}+\alpha_t(x^t-x^{t-1})+\gamma_t\Delta^{t+1}-\gamma_t\beta_t\Delta^t\bigr).
--   $$
--   Then for every $t\ge1$ such that $x^{t+1}$ has been generated,
--   $$
--   v^t\in(F+B)(x^{t+1}),\qquad v^t=\tilde\gamma_t^{-1}\bigl(x^t-x^{t+1}+\tilde\gamma_t\tilde\Delta^{t+1}-\tilde\gamma_t\beta_t\tilde\Delta^t\bigr).
--   $$
--
--   The vector $v^t$ is the one in the termination test (7), so the test certifies an $\epsilon$-residual solution.
--
--   Differences from the source:
--   - encoding: $F$ is a point-valued operator on $\mathrm{cl}(\mathrm{dom}\,B)$ → a total map on $\mathbb R^n$, constrained only on $\mathrm{cl}(\mathrm{dom}\,B)$; reason: values of $F$ elsewhere never enter $F+B$ or a run, since iterates lie in $\mathrm{dom}\,B$
--   - encoding: Assumption 1(d), the resolvent of $\gamma B$ can be exactly evaluated → a family $J$ with $J_\gamma=(I+\gamma B)^{-1}$ for every $\gamma>0$; reason: the assumption has no mathematical content; the family exists and is unique on $\gamma>0$
--   - encoding: iterates generated by Algorithm 1, $1\le t\in\mathbb T-1$ → the prefix predicate `Alg1.IsPrefix` at index $t\ge1$; reason: $t\in\mathbb T-1$ says exactly that $x^{t+1}$ has been generated; nothing is said past it
-- source:
--   Lu & Mei, Primal-dual extrapolation methods for monotone inclusions under local Lipschitz continuity, arXiv:2206.00973v3, Lemma 3, p.14

import Mathlib
import Definitions.Def_ThreeOpSplitting_Convergence_MonotoneOperators
import Definitions.Def_MonoIncExtrap_Setting
import Definitions.Def_MonoIncExtrap_Algorithm1

open InnerProductSpace ThreeOpSplitting.Convergence

namespace MonoIncExtrap

/-- **Lemma 3.** arXiv:2206.00973v3, Lemma 3, p.14. For a run of Algorithm 1 and `t ≥ 1` such that
`x^{t+1}` has been generated, `v^t ∈ (F + B)(x^{t+1})` (44), and
`v^t = γ̃_t⁻¹(x^t − x^{t+1} + γ̃_tΔ̃^{t+1} − γ̃_tβ_tΔ̃^t)` (45).

**Formalization Note.** "`1 ≤ t ∈ 𝕋 − 1`" is `1 ≤ t` together with `IsPrefix I x γ n' t`. -/
theorem lemma_3 {n : ℕ}
    {B : EuclideanSpace ℝ (Fin n) → Set (EuclideanSpace ℝ (Fin n))}
    {I : Alg1.Input (EuclideanSpace ℝ (Fin n))} {xstar : EuclideanSpace ℝ (Fin n)}
    (hI : Alg1.Standing B I xstar)
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {γ : ℕ → ℝ} {n' : ℕ → ℕ} {t : ℕ}
    (hx : Alg1.IsPrefix I x γ n' t) (ht : 1 ≤ t) :
    Alg1.vSeq I x γ t ∈ sumOp I.F B (x (t + 1)) ∧
      Alg1.vSeq I x γ t =
        (Alg1.gammaTilde I γ t)⁻¹ •
          (x t - x (t + 1) + Alg1.gammaTilde I γ t • Alg1.DeltaTilde I x γ (t + 1)
            - (Alg1.gammaTilde I γ t * Alg1.betaSeq I γ t) • Alg1.DeltaTilde I x γ t) := by sorry

end MonoIncExtrap
