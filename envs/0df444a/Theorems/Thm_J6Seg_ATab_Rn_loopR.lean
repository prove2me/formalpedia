theorem J6Seg.ATab.Rn.loopR {W p s t α H q : ℕ} {v0 : Vr} {c0 : Cs} (hv0 : BV W v0) (hc0 : c0 cI = [])
    (h1 : v0 1 = ((2 * p : ℕ) : ℤ)) (h3 : v0 3 = s) (h4 : v0 4 = t)
    (h7 : v0 7 = ((t ^ 3 * α ^ 2 : ℕ) : ℤ)) (h8 : v0 8 = H) (h9 : v0 9 = J6A.WA p α H)
    (h10 : v0 10 = ((2 * J6A.WA p α H + 2 * H : ℕ) : ℤ))
    (h12 : v0 12 = 2 ^ J6A.QA p)
    (h25 : v0 25 = (t : ℤ) * (J6A.jcB s t H (J6A.kkA H q) - J6A.WA p α H) -
      s * J6A.kcB H (J6A.kkA H q))
    (hpW : 2 * p ≤ W + 1) (hN : 2 * J6A.WA p α H + 2 * H < 2 ^ W)
    (hb1 : ∀ e < 2 * J6A.WA p α H + 2 * H, (rNum p s t α H q e : ℤ) ≤ 2 ^ W)
    (hb2 : ∀ e < 2 * J6A.WA p α H + 2 * H, |fR p s t α H q e| ≤ 2 ^ W) :
    Rn J6Seg.ATab.loopR v0 c0 (fun v' => (∀ j, j ∉ ([26, 28, 29] : List (Fin HS)) → v' j = v0 j) ∧ BV W v')
      (update c0 sS (PreT.rv (fR p s t α H q) (2 * J6A.WA p α H + 2 * H) ++ c0 sS))
      (cFor W (2 * J6A.WA p α H + 2 * H) (cBodyR W)) := by sorry
