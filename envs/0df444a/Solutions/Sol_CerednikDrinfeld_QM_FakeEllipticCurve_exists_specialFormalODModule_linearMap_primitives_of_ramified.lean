theorem nonempty_ringHom_zp2 (p : ℕ) [Fact p.Prime] (k : Type) [Field k] [IsAlgClosed k] [CharP k p] :
    Nonempty (Zp2 p →+* k) := by
  classical
  letI : Algebra (ZMod p) k := ZMod.algebra k p
  haveI : Algebra.IsAlgebraic (ZMod p) (GaloisField p 2) := Algebra.IsAlgebraic.of_finite (ZMod p) (GaloisField p 2)
  let ι : GaloisField p 2 →ₐ[ZMod p] k := IsAlgClosed.lift

  let c0 : Zp2 p →+* GaloisField p 2 :=
    { toFun := fun x => x.coeff 0
      map_one' := WittVector.one_coeff_zero p _
      map_mul' := fun x y => WittVector.mul_coeff_zero x y
      map_zero' := WittVector.zero_coeff p (GaloisField p 2) 0
      map_add' := fun x y => WittVector.add_coeff_zero x y }
  exact ⟨ι.toRingHom.comp c0⟩

theorem exists_linearMap_section {k : Type} [Field k] {R : Type} [CommRing R] [Algebra k R] (I : Ideal R) :
    ∃ σ : (R ⧸ I) →ₗ[k] R, ∀ y, Ideal.Quotient.mk I (σ y) = y := by
  obtain ⟨σ, hσ⟩ := LinearMap.exists_rightInverse_of_surjective (Ideal.Quotient.mkₐ k I).toLinearMap
    (by rw [LinearMap.range_eq_top]; exact Ideal.Quotient.mkₐ_surjective k I)
  exact ⟨σ, fun y => by simpa using congrArg (fun f => f y) hσ⟩

end R2Loc

theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    {N : ℕ} {p : ℕ} [Fact p.Prime]
    (k : Type) [Field k] [IsAlgClosed k] [CharP k p]
    (E : FakeEllipticCurve Λ N k)

    (H : Type) [CommRing H] [HopfAlgebra k H] [Module.Finite k H] [Coalgebra.IsCocomm k H]
    (hH : Module.finrank k H = p ^ (2 * 2))
    (hHp : PDivisibleGroup.Hopf.nsmulAlgHom k H p = (Algebra.ofId k H).comp (Bialgebra.counitAlgHom k H))
    (e : ∀ (T : Type) [CommRing T] [Algebra k T],
      WithConv (H →ₐ[k] T) ≃ E.L.torsionSubset (Spec.map (CommRingCat.ofHom (algebraMap k T))) p)
    (he_mul : ∀ (T : Type) [CommRing T] [Algebra k T] (φ ψ : WithConv (H →ₐ[k] T)),
      ((e T (φ * ψ)).val : SchemeHomOver _ E.f) = E.L.mul _ (e T φ).val (e T ψ).val)
    (he_nat : ∀ (T T' : Type) [CommRing T] [Algebra k T] [CommRing T'] [Algebra k T']
        (g' : T →ₐ[k] T') (φ : WithConv (H →ₐ[k] T)),
      ((e T' (.toConv (g'.comp φ.ofConv))).val : SchemeHomOver _ E.f).1 =
        Spec.map (CommRingCat.ofHom g'.toRingHom) ≫ (e T φ).val.1)
    (hp : p = q ∨ p = q') :
    ∃ (coord : ↥Λ → Zp2 p × Zp2 p) (_ : IsOrderCoord Λ p coord) (j₀ : Zp2 p →+* k)
      (X₀ : SpecialFormalODModule p j₀) (Ψ : ↥(primitives k H) →ₗ[k] MvPowerSeries (Fin 2) k),
      (∀ x, MvPowerSeries.constantCoeff (Ψ x) = 0 ∧ X₀.F.addCoboundary (Ψ x) ∈ Ideal.span (Set.range (Sum.elim
            (fun l => MvPowerSeries.subst
              (fun t => (MvPowerSeries.X (Sum.inl t) : MvPowerSeries (Fin 2 ⊕ Fin 2) k)) (X₀.F.nthSeries p l))
            (fun l => MvPowerSeries.subst
              (fun t => (MvPowerSeries.X (Sum.inr t) : MvPowerSeries (Fin 2 ⊕ Fin 2) k)) (X₀.F.nthSeries p l))))) ∧
      (∀ x, Ψ x ∈ Ideal.span (Set.range (X₀.F.nthSeries p)) → x = 0) ∧
      (∀ h : MvPowerSeries (Fin 2) k, MvPowerSeries.constantCoeff h = 0 →
        X₀.F.addCoboundary h ∈ Ideal.span (Set.range (Sum.elim
            (fun l => MvPowerSeries.subst
              (fun t => (MvPowerSeries.X (Sum.inl t) : MvPowerSeries (Fin 2 ⊕ Fin 2) k)) (X₀.F.nthSeries p l))
            (fun l => MvPowerSeries.subst
              (fun t => (MvPowerSeries.X (Sum.inr t) : MvPowerSeries (Fin 2 ⊕ Fin 2) k)) (X₀.F.nthSeries p l)))) →
        ∃ x, h - Ψ x ∈ Ideal.span (Set.range (X₀.F.nthSeries p))) ∧
      (∀ (m : ↥Λ) (φH : H →ₐ[k] H),
        (∀ (T : Type) [CommRing T] [Algebra k T] (q : WithConv (H →ₐ[k] T)),
          ((e T (.toConv (q.ofConv.comp φH))).val : SchemeHomOver _ E.f).1 = (e T q).val.1 ≫ E.act m) →
        ∀ (hprim : ∀ x ∈ primitives k H, φH x ∈ primitives k H) (x : ↥(primitives k H)),
          Ψ ⟨φH x, hprim x x.2⟩ -
            MvPowerSeries.subst (CerednikDrinfeld.SpecialFormal.Series.addVia X₀.F (X₀.act (coord m).1) ((X₀.act (coord m).2).comp X₀.varpi)) (Ψ x) ∈
              Ideal.span (Set.range (X₀.F.nthSeries p))) := by
  classical

  obtain ⟨coord, hcoord, X, θ, hE, ν, Φ, hpin, hsurj⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isFormalModuleVia_algEquiv_kerAlgebra_forall_apply_eq_nilEval_of_ramified hqq' hB Λ hΛ k E H e he_nat hp
  obtain ⟨j₀⟩ := R2Loc.nonempty_ringHom_zp2 p k
  have hq : IsNilpotent ((p : ℕ) : k) := ⟨1, by rw [pow_one]; exact CharP.cast_eq_zero k p⟩
  have h1 : (1 : ℍ[ℚ, a, b]) ∈ Λ := hΛ.1.one_mem
  have hspec : X.IsSpecial j₀ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsFormalModuleOf.isSpecial coord hcoord k hq j₀ E X ⟨θ, hE⟩
  have hht : X.HasHeight 4 :=
    CerednikDrinfeld.QM.FakeEllipticCurve.hasHeight_four_of_isFormalModuleVia_of_one_mem coord hcoord h1 k hq E X θ hE
  let X₀ : SpecialFormalODModule p j₀ := { toFormalODModule := X, isSpecial := hspec, hasHeight := hht }

  set I : Ideal (MvPowerSeries (Fin 2) k) := Ideal.span (Set.range (X.F.nthSeries p)) with hI
  obtain ⟨σ, hσ⟩ := R2Loc.exists_linearMap_section (k := k) I
  let Ψ : ↥(primitives k H) →ₗ[k] MvPowerSeries (Fin 2) k :=
    σ ∘ₗ (Φ.symm.toLinearMap ∘ₗ (primitives k H).subtype)
  have hΨ : ∀ x : ↥(primitives k H), Φ (Ideal.Quotient.mk I (Ψ x)) = (x : H) := by
    intro x
    show Φ (Ideal.Quotient.mk I (σ (Φ.symm (x : H)))) = (x : H)
    rw [hσ, AlgEquiv.apply_symm_apply]
  have hΨ' : ∀ x : ↥(primitives k H), Ideal.Quotient.mk I (Ψ x) = Φ.symm (x : H) := by
    intro x
    show Ideal.Quotient.mk I (σ (Φ.symm (x : H))) = Φ.symm (x : H)
    rw [hσ]

  have hHOPF := fun G => GoodReductionJacobian.RelativeGroupLaw.apply_mk_mem_primitives_iff_addCoboundary_mem_of_forall_apply_eq_nilEval k E.f E.L p X.F θ hE.1 (X.F.nthSeries p) H e he_mul ν Φ hpin hsurj G
  refine ⟨coord, hcoord, j₀, X₀, Ψ, ?_, ?_, ?_, ?_⟩
  ·
    intro x
    have hx : Φ (Ideal.Quotient.mk I (Ψ x)) ∈ primitives k H := by rw [hΨ]; exact x.2
    exact (hHOPF (Ψ x)).1 hx
