  have hR : J6A.rTabA p s t α (HAx p α) q =
      (List.range (2 * J6A.WA p α (HAx p α) + 2 * HAx p α)).map (fR p s t α (HAx p α) q) := rfl
  unfold segT
  generalize ((aTab6 p s t α pk b q).length : ℤ) = L
  have e : aTab6 p s t α pk b q =
      KR.AK.aHdr2 (2 * J6A.WA p α (HAx p α)) (2 * HAx p α) (8 * HAx p α) (J6A.QA p) pk b ++
      ((List.range (2 * J6A.WA p α (HAx p α))).map (fA p s t α (HAx p α) q) ++
      ((List.range (2 * J6A.WA p α (HAx p α) + 2 * HAx p α)).map (fR p s t α (HAx p α) q) ++
      (List.range (2 * HAx p α)).map (fC p s t α))) := by
    rw [← hA, ← hR, ← hc]; rfl
  rw [e]
  simp only [PreT.rv, List.reverse_cons, List.reverse_append, List.append_assoc]

set_option maxHeartbeats 4000000 in
/-- **The block body.** -/
theorem Rn.blockB_sol_aux {W p s t α pk b q : ℕ} {v : Vr} {c : Cs} (hB : ABnd W p s t α)
    (hq : q < ncA p t α) (hL : LV p s t α pk b v) (h24 : v 24 = q) (hv : BV W v)
    (hcI : c cI = []) :
    Rn blockB v c (fun v' => (∀ j, j ∉ TB' → v' j = v j) ∧ BV W v')
      (update c sS ((segT (aTab6 p s t α pk b) q).reverse ++ c sS)) (cBlock W p α) := by
  have hW1 := hB.hN
  -- 1. the block offset
  have s1 := Rn.asgE (c := c) (i := 25) (e := eA0) (by decide) (by decide) (lb32 hB.w32 (by decide)) hv
  rw [eA0_den hL h24] at s1
  refine Rn.seq s1 (fun v1 e1 => ?_)
  subst e1
  have hv1 : BV W (update v 25 (A0 p s t α q)) := BV_upd hv (hB.hA0 q hq)
  have hL1 : LV p s t α pk b (update v 25 (A0 p s t α q)) :=
    hL.agree (fun j hj => update_of_ne (by intro e; subst e; exact hj (by decide)) _ _)
  -- 2. the header
  have s2 := Rn.pushes (S := sS) (by decide) (by decide) hv1 hdrE c (fun e he => by
    simp only [hdrE, List.mem_cons, List.mem_nil_iff, or_false] at he
    rcases he with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h <;>
      subst h <;> exact ⟨by decide, lb32 hB.w32 (by decide)⟩)
  rw [hdr_den (q := q) hL1] at s2
  refine Rn.seq s2 (fun v2 e2 => ?_)
  subst e2
  set c2 := update c sS ((((aTab6 p s t α pk b q).length : ℤ) ::
      KR.AK.aHdr2 (2 * J6A.WA p α (HAx p α)) (2 * HAx p α) (8 * HAx p α) (J6A.QA p) pk b).reverse
      ++ c sS) with hc2
  have hc2I : c2 cI = [] := by rw [hc2, update_of_ne (by decide)]; exact hcI
  -- 3. the input-scaling table
  have s3 := Rn.asgE (c := c2) (i := 10) (e := e2W) (by decide) (by decide)
    (lb32 hB.w32 (by decide)) hv1
  refine Rn.seq s3 (fun v3 e3 => ?_)
  subst e3
  have d3 : e2W.den (update v 25 (A0 p s t α q)) = ((2 * J6A.WA p α (HAx p α) : ℕ) : ℤ) := by
    simp only [e2W, E.den, hL1.r9]; push_cast; ring
  rw [d3]
  set v3 := update (update v 25 (A0 p s t α q)) 10 ((2 * J6A.WA p α (HAx p α) : ℕ) : ℤ) with hv3d
  have hv3 : BV W v3 := BV_upd hv1 (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast (by omega))
  have hL3 : LV p s t α pk b v3 :=
    hL1.agree (fun j hj => update_of_ne (by intro e; subst e; exact hj (by decide)) _ _)
  have s4 := Rn.loopA (W := W) (p := p) (s := s) (t := t) (α := α) (H := HAx p α) (q := q)
    (c0 := c2) hv3 hc2I hL3.r1 hL3.r3 hL3.r4 hL3.r7 (by rw [hv3d, update_self]) hL3.r12
    (by rw [hv3d, update_of_ne (by decide), update_self]; rfl) hB.pW (by omega)
    (hB.aN q hq) (hB.fA q hq)
  refine Rn.seq s4 (fun v4 ⟨a4, hv4⟩ => ?_)
  set c4 := update c2 sS (PreT.rv (fA p s t α (HAx p α) q) (2 * J6A.WA p α (HAx p α)) ++ c2 sS)
    with hc4
  have hc4I : c4 cI = [] := by rw [hc4, update_of_ne (by decide)]; exact hc2I
  have hL4 : LV p s t α pk b v4 := hL3.agree (fun j hj => a4 j (by
    simp only [TB, List.mem_cons, List.mem_nil_iff, or_false, not_or] at hj ⊢; tauto))
  have v4_25 : v4 25 = A0 p s t α q := by
    rw [a4 25 (by decide), hv3d, update_of_ne (by decide), update_self]
  -- 4. the correlation table
  have s5 := Rn.asgE (c := c4) (i := 10) (e := e2W2H) (by decide) (by decide)
    (lb32 hB.w32 (by decide)) hv4
  refine Rn.seq s5 (fun v5 e5 => ?_)
  subst e5
  have d5 : e2W2H.den v4 = ((2 * J6A.WA p α (HAx p α) + 2 * HAx p α : ℕ) : ℤ) := by
    simp only [e2W2H, E.den, hL4.r9, hL4.r8]; push_cast; ring
  rw [d5]
  set v5 := update v4 10 ((2 * J6A.WA p α (HAx p α) + 2 * HAx p α : ℕ) : ℤ) with hv5d
  have hv5 : BV W v5 := BV_upd hv4 (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast hW1.le)
  have hL5 : LV p s t α pk b v5 :=
    hL4.agree (fun j hj => update_of_ne (by intro e; subst e; exact hj (by decide)) _ _)
  have s6 := Rn.loopR (W := W) (p := p) (s := s) (t := t) (α := α) (H := HAx p α) (q := q)
    (c0 := c4) hv5 hc4I hL5.r1 hL5.r3 hL5.r4 hL5.r7 hL5.r8 hL5.r9 (by rw [hv5d, update_self])
    hL5.r12 (by rw [hv5d, update_of_ne (by decide), v4_25]; rfl) hB.pW hW1
    (hB.rN q hq) (hB.fR q hq)
  refine Rn.seq s6 (fun v6 ⟨a6, hv6⟩ => ?_)
  set c6 := update c4 sS (PreT.rv (fR p s t α (HAx p α) q)
    (2 * J6A.WA p α (HAx p α) + 2 * HAx p α) ++ c4 sS) with hc6
  have hc6I : c6 cI = [] := by rw [hc6, update_of_ne (by decide)]; exact hc4I
  have hL6 : LV p s t α pk b v6 := hL5.agree (fun j hj => a6 j (by
    simp only [TB, List.mem_cons, List.mem_nil_iff, or_false, not_or] at hj ⊢; tauto))
  -- 5. the output-scaling table
  have s7 := Rn.asgE (c := c6) (i := 10) (e := e2H) (by decide) (by decide)
    (lb32 hB.w32 (by decide)) hv6
  refine Rn.seq s7 (fun v7 e7 => ?_)
  subst e7
  have d7 : e2H.den v6 = ((2 * HAx p α : ℕ) : ℤ) := by
    simp only [e2H, E.den, hL6.r8]; push_cast; ring
  rw [d7]
  set v7 := update v6 10 ((2 * HAx p α : ℕ) : ℤ) with hv7d
  have hv7 : BV W v7 := BV_upd hv6 (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast (by omega))
  have hL7 : LV p s t α pk b v7 :=
    hL6.agree (fun j hj => update_of_ne (by intro e; subst e; exact hj (by decide)) _ _)
  have s8 := Rn.loopC (W := W) (p := p) (s := s) (t := t) (α := α) (c0 := c6) hv7 hc6I
    hL7.r1 hL7.r2 hL7.r3 hL7.r4 hL7.r5 hL7.r6 hL7.r8 (by rw [hv7d, update_self]) hL7.r11
    hB.pW hB.pW' (by omega) hB.hK hB.cN hB.cB hB.cE
  refine s8.congr ?_ |>.mono (fun v8 ⟨a8, hv8⟩ => ⟨fun j hj => ?_, hv8⟩) le_rfl
  · rw [hc6, hc4, hc2, update_self, update_self, update_idem, update_idem, update_self,
      update_idem, segT_rev]
    simp only [List.append_assoc]
  · simp only [TB', List.mem_cons, List.mem_nil_iff, or_false, not_or] at hj
    obtain ⟨j10, j25, j26, j28, j29⟩ := hj
    have n3 : j ∉ ([26, 28, 29] : List (Fin HS)) := by
      simp only [List.mem_cons, List.mem_nil_iff, or_false, not_or]; exact ⟨j26, j28, j29⟩
    rw [a8 j n3, hv7d, update_of_ne j10, a6 j n3, hv5d, update_of_ne j10, a4 j n3, hv3d,
      update_of_ne j10, update_of_ne j25]

end J6Seg.ATab

end

theorem solution : type_of% @J6Seg.ATab.Rn.blockB_sol_aux := @J6Seg.ATab.Rn.blockB_sol_aux
