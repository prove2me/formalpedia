variable (U₀ : P.Opens) (k : ι) {Uz : P.Opens} (h : U₀ ≤ Uz)
  (hrng : ∀ j, j ≠ k → ∀ v : (S j).left, (S j).hom v ∈ Uz)

variable (Λ) in
/-- The summand maps `Λ[S j] ⟶ Λ[Uz]`: `0` at `k`, the inclusion elsewhere. -/
def restSec (j : ι) : freeSh Λ (S j) ⟶ freeSh Λ (opEt Uz) :=
  if hj : j = k then 0 else freeMap Λ (toOpEt (S j) Uz (hrng j hj))

theorem restSec_self : restSec Λ S k hrng k = 0 := by
  rw [restSec, dif_pos rfl]

theorem restSec_ne {j : ι} (hj : j ≠ k) : restSec Λ S k hrng j = freeMap Λ (toOpEt (S j) Uz (hrng j hj)) := by
  rw [restSec, dif_neg hj]

