open Complex Filter Topology
open scoped ComplexConjugate Matrix ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.Variation
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {U : Set (Pt 4)} {g0 gi0 : Metric 4} {F0 f : TwoForm 4} {E0 Θ0 B : Fin 4 → Fin 4 → Pt 4 → ℂ}
  {h : Metric 4}
variable (hN : NullFrameData g0 gi0 E0 Θ0 U) (ht : RealFrameTangent g0 E0 U h f B)
include hN ht
theorem solution : IsOpen (rzW U E0 B) := by
  have hU : IsOpen (Set.univ ×ˢ U : Set (ℝ × Pt 4)) := isOpen_univ.prod hN.metric.isOpen
  have hsm : ∀ A μ, ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzE E0 B p.1 A μ p.2) (Set.univ ×ˢ U) := by
    intro A μ
    have hs : ∀ {φ : Pt 4 → ℂ}, ContDiffOn ℝ ∞ φ U →
        ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => φ p.2) (Set.univ ×ˢ U) :=
      fun hφ => hφ.comp contDiff_snd.contDiffOn fun p hp => hp.2
    exact (hs (hN.smooth_E A μ)).add
      ((Complex.ofRealCLM.contDiff.comp contDiff_fst).contDiffOn.mul (hs (ht.smooth_B A μ)))
  have hdet : ContinuousOn (fun p : ℝ × Pt 4 => (frMat (rzE E0 B p.1) p.2).det) (Set.univ ×ˢ U) :=
    (contDiffOn_detC_of (A := fun p : ℝ × Pt 4 => frMat (rzE E0 B p.1) p.2)
      fun μ A => by simpa only [frMat, Matrix.of_apply] using hsm A μ).continuousOn
  have := hdet.isOpen_inter_preimage hU (isOpen_compl_singleton (x := (0 : ℂ)))
  convert this using 1
  ext p
  simp [rzW, Set.mem_prod]
