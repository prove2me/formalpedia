private theorem sphericalTorusValue_inv_triple_recurrence (e₁ e₂ e₃ : ℂ) (h₃ : e₃ ≠ 0) (n : ℕ) :
    e₃ ^ (n + 3) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (n + 3) =
      e₂ * (e₃ ^ (n + 2) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (n + 2)) -
          e₁ * e₃ * (e₃ ^ (n + 1) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (n + 1)) +
        e₃ ^ 2 * (e₃ ^ n * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ n) := by
  have r : sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (n + 3) =
      e₂ / e₃ * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (n + 2) -
          e₁ / e₃ * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (n + 1) +
        e₃⁻¹ * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ n := rfl
  rw [r]
  have h : e₃ * e₃⁻¹ = 1 := mul_inv_cancel₀ h₃
  linear_combination (e₃ ^ n * e₃ ^ 2 *
    (e₂ * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (n + 2) -
      e₁ * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (n + 1) +
      sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ n)) * h

private theorem sq_sub_mul_sphericalTorusValue_recurrence (e₁ e₂ e₃ : ℂ) (n : ℕ) :
    sphericalTorusValue e₁ e₂ e₃ (n + 4) ^ 2 -
        sphericalTorusValue e₁ e₂ e₃ (n + 5) * sphericalTorusValue e₁ e₂ e₃ (n + 3) =
      e₂ * (sphericalTorusValue e₁ e₂ e₃ (n + 3) ^ 2 -
            sphericalTorusValue e₁ e₂ e₃ (n + 4) * sphericalTorusValue e₁ e₂ e₃ (n + 2)) -
          e₁ * e₃ * (sphericalTorusValue e₁ e₂ e₃ (n + 2) ^ 2 -
            sphericalTorusValue e₁ e₂ e₃ (n + 3) * sphericalTorusValue e₁ e₂ e₃ (n + 1)) +
        e₃ ^ 2 * (sphericalTorusValue e₁ e₂ e₃ (n + 1) ^ 2 -
          sphericalTorusValue e₁ e₂ e₃ (n + 2) * sphericalTorusValue e₁ e₂ e₃ n) := by
  have r5 : sphericalTorusValue e₁ e₂ e₃ (n + 5) =
      e₁ * sphericalTorusValue e₁ e₂ e₃ (n + 4) - e₂ * sphericalTorusValue e₁ e₂ e₃ (n + 3) +
        e₃ * sphericalTorusValue e₁ e₂ e₃ (n + 2) := rfl
  have r4 : sphericalTorusValue e₁ e₂ e₃ (n + 4) =
      e₁ * sphericalTorusValue e₁ e₂ e₃ (n + 3) - e₂ * sphericalTorusValue e₁ e₂ e₃ (n + 2) +
        e₃ * sphericalTorusValue e₁ e₂ e₃ (n + 1) := rfl
  have r3 : sphericalTorusValue e₁ e₂ e₃ (n + 3) =
      e₁ * sphericalTorusValue e₁ e₂ e₃ (n + 2) - e₂ * sphericalTorusValue e₁ e₂ e₃ (n + 1) +
        e₃ * sphericalTorusValue e₁ e₂ e₃ n := rfl
  rw [r5, r4, r3]
  ring

private theorem pow_mul_sphericalTorusValue_inv_triple_eq_sq_sub_mul (e₁ e₂ e₃ : ℂ) (h₃ : e₃ ≠ 0) (n : ℕ) :
    e₃ ^ (n + 1) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (n + 1) =
      sphericalTorusValue e₁ e₂ e₃ (n + 1) ^ 2 -
        sphericalTorusValue e₁ e₂ e₃ (n + 2) * sphericalTorusValue e₁ e₂ e₃ n := by
  have key : ∀ m : ℕ,
      (e₃ ^ (m + 1) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (m + 1) =
        sphericalTorusValue e₁ e₂ e₃ (m + 1) ^ 2 -
          sphericalTorusValue e₁ e₂ e₃ (m + 2) * sphericalTorusValue e₁ e₂ e₃ m) ∧
      (e₃ ^ (m + 2) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (m + 2) =
        sphericalTorusValue e₁ e₂ e₃ (m + 2) ^ 2 -
          sphericalTorusValue e₁ e₂ e₃ (m + 3) * sphericalTorusValue e₁ e₂ e₃ (m + 1)) ∧
      (e₃ ^ (m + 3) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (m + 3) =
        sphericalTorusValue e₁ e₂ e₃ (m + 3) ^ 2 -
          sphericalTorusValue e₁ e₂ e₃ (m + 4) * sphericalTorusValue e₁ e₂ e₃ (m + 2)) := by
    intro m
    induction m with
    | zero =>
      have h : e₃ * e₃⁻¹ = 1 := mul_inv_cancel₀ h₃
      refine ⟨?_, ?_, ?_⟩
      · show e₃ ^ 1 * (e₂ / e₃) = e₁ ^ 2 - (e₁ ^ 2 - e₂) * 1
        linear_combination e₂ * h
      · show e₃ ^ 2 * ((e₂ / e₃) ^ 2 - e₁ / e₃) =
          (e₁ ^ 2 - e₂) ^ 2 - (e₁ * (e₁ ^ 2 - e₂) - e₂ * e₁ + e₃ * 1) * e₁
        linear_combination (e₂ ^ 2 * e₃ * e₃⁻¹ + e₂ ^ 2 - e₁ * e₃) * h
      · show e₃ ^ 3 * (e₂ / e₃ * ((e₂ / e₃) ^ 2 - e₁ / e₃) - e₁ / e₃ * (e₂ / e₃) + e₃⁻¹ * 1) =
          (e₁ * (e₁ ^ 2 - e₂) - e₂ * e₁ + e₃ * 1) ^ 2 -
            (e₁ * (e₁ * (e₁ ^ 2 - e₂) - e₂ * e₁ + e₃ * 1) - e₂ * (e₁ ^ 2 - e₂) + e₃ * e₁) * (e₁ ^ 2 - e₂)
        linear_combination (e₂ ^ 3 * e₃ ^ 2 * e₃⁻¹ ^ 2 + e₂ ^ 3 * e₃ * e₃⁻¹ + e₂ ^ 3 + e₃ ^ 2 -
          2 * e₁ * e₂ * e₃ ^ 2 * e₃⁻¹ - 2 * e₁ * e₂ * e₃) * h
    | succ k ih =>
      obtain ⟨i0, i1, i2⟩ := ih
      refine ⟨i1, i2, ?_⟩
      have hR : e₃ ^ (k + 4) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (k + 4) =
          e₂ * (e₃ ^ (k + 3) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (k + 3)) -
              e₁ * e₃ * (e₃ ^ (k + 2) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (k + 2)) +
            e₃ ^ 2 * (e₃ ^ (k + 1) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (k + 1)) :=
          sphericalTorusValue_inv_triple_recurrence e₁ e₂ e₃ h₃ (k + 1)
      show e₃ ^ (k + 4) * sphericalTorusValue (e₂ / e₃) (e₁ / e₃) e₃⁻¹ (k + 4) =
        sphericalTorusValue e₁ e₂ e₃ (k + 4) ^ 2 -
          sphericalTorusValue e₁ e₂ e₃ (k + 5) * sphericalTorusValue e₁ e₂ e₃ (k + 3)
      rw [hR, i0, i1, i2]
      exact (sq_sub_mul_sphericalTorusValue_recurrence e₁ e₂ e₃ k).symm
  exact (key n).1

private theorem xLineAt_eq_apply_iotaGL_diagUnitGL2_unitsAt_of_valued_le_one (v : HeightOneSpectrum (𝓞 ℚ))
    (Wloc : (w : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 w → ℂ)
    (hWK : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 (Wloc v)))
    (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (g : AdelicGL 3 (𝓞 ℚ) ℚ)
    (hg : componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) {y : v.adicCompletion ℚ}
    (hy : Valued.v y ≤ 1) :
    LineIntegral.xLineAt Wloc a g v y =
      dualWhittakerFn3 (Wloc v) (iotaGL (diagUnitGL2 (CharacterComponents.unitsAt v a))) := by
  unfold LineIntegral.xLineAt
  rw [mul_assoc]
  exact hWK _ _ (mul_mem (LineIntegral.lowerUnipotent21_mem_localMaximalCompact3 v hy)
    (DualProduct.weylPrime3_mul_transposeInv3_mem_localMaximalCompact3 hg))

private theorem xLineAt_eq_zero_of_not_mem_adicCompletionIntegers (v : HeightOneSpectrum (𝓞 ℚ))
    (Wloc : (w : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 w → ℂ) {ψ : AddChar (v.adicCompletion ℚ) ℂ}
    (hWψ : IsGL3PsiWhittakerFn ψ (dualWhittakerFn3 (Wloc v)))
    (hWK : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 (Wloc v)))
    (hψ : ∀ y₀ ∉ v.adicCompletionIntegers ℚ, ∃ y : v.adicCompletion ℚ, Valued.v (y * y₀⁻¹) ≤ 1 ∧ ψ y ≠ 1)
    (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (g : AdelicGL 3 (𝓞 ℚ) ℚ)
    (hg : componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) {y₀ : v.adicCompletion ℚ}
    (hy₀ : y₀ ∉ v.adicCompletionIntegers ℚ) : LineIntegral.xLineAt Wloc a g v y₀ = 0 := by
  obtain ⟨y, hy, hψy⟩ := hψ y₀ hy₀
  have h0 : y₀ ≠ 0 := by
    rintro rfl
    exact hy₀ (zero_mem _)
  unfold LineIntegral.xLineAt
  exact RootVanishing.apply_iotaGL_diagUnitGL2_mul_lowerUnipotent21_mul_eq_zero hWψ hWK _ (Units.mk0 y₀ h0) hy hψy
    (DualProduct.weylPrime3_mul_transposeInv3_mem_localMaximalCompact3 hg)

private theorem pow_mul_apply_inv_centralGen_pow_mul_eq {G : Type} [Group G] (z : G) (W : G → ℂ) {e : ℂ}
    (hz : ∀ h : G, W (z * h) = e * W h) (n : ℕ) (X : G) : e ^ n * W (z⁻¹ ^ n * X) = W X := by
  induction n generalizing X with
  | zero =>
    rw [pow_zero, pow_zero, one_mul, one_mul]
  | succ k ih =>
    have h1 : W (z * (z⁻¹ ^ (k + 1) * X)) = e * W (z⁻¹ ^ (k + 1) * X) := hz (z⁻¹ ^ (k + 1) * X)
    have h2 : z * (z⁻¹ ^ (k + 1) * X) = z⁻¹ ^ k * X := by
      rw [pow_succ', mul_assoc, mul_inv_cancel_left]
    rw [h2] at h1
    rw [pow_succ, mul_assoc, ← h1]
    exact ih X

private theorem apply_inv_centralGen_pow_mul {G : Type} [Group G] (z : G) (W : G → ℂ) {e : ℂ} (he : e ≠ 0)
    (hz : ∀ h : G, W (z * h) = e * W h) (n : ℕ) (X : G) : W (z⁻¹ ^ n * X) = e⁻¹ ^ n * W X := by
  rw [← pow_mul_apply_inv_centralGen_pow_mul_eq z W hz n X, ← mul_assoc, ← mul_pow, inv_mul_cancel₀ he, one_pow,
    one_mul]

private theorem longWeyl3_mul_transposeInv3_eq_scalar_inv_pow_mul {F : Type} [Field F] (p ϖ : Fˣ) (n : ℕ)
    (X Y : GL (Fin 3) F)
    (hX : ((X⁻¹ : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) = Matrix.diagonal ![(((p ^ n)⁻¹ : Fˣ) : F), 1, 1])
    (hY : (Y : Matrix (Fin 3) (Fin 3) F) = Matrix.diagonal ![((p ^ n : Fˣ) : F), ((p ^ n : Fˣ) : F), 1]) :
    longWeyl3 * transposeInv3 (X * (longWeyl3 * Matrix.GeneralLinearGroup.scalar (Fin 3) ((ϖ * p⁻¹) ^ n))) =
      (Matrix.GeneralLinearGroup.scalar (Fin 3) ϖ)⁻¹ ^ n * Y := by
  have hp : (p : F) ≠ 0 := p.ne_zero
  have hu : (ϖ : F) ≠ 0 := ϖ.ne_zero
  have hT : ((transposeInv3 X : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) =
      Matrix.diagonal ![(((p ^ n)⁻¹ : Fˣ) : F), 1, 1] :=
    TorusTransport.coe_transposeInv3_of_coe_inv_eq_diagonal hX
  have hW : ((transposeInv3 (longWeyl3 : GL (Fin 3) F) : GL (Fin 3) F) : Matrix (Fin 3) (Fin 3) F) =
      !![0, 0, 1; 0, 1, 0; 1, 0, 0] := by
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  rw [TorusTransport.transposeInv3_mul, TorusTransport.transposeInv3_mul, TorusTransport.transposeInv3_glScalar,
    ← map_inv, ← map_pow]
  apply Units.ext
  simp only [Units.val_mul, hT, hW, hY, ScalarComponents.coe_glScalar, longWeyl3_coe]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_three, Matrix.diagonal, Matrix.vecHead, Matrix.vecTail,
      Units.val_pow_eq_pow_val, Units.val_mul, Units.val_inv_eq_inv_val, mul_pow, inv_pow] <;>
    field_simp

private theorem longWeyl3_mul_transposeInv3_eq_inv_centralGen_pow_mul_twoRowPointLocal (v : HeightOneSpectrum (𝓞 ℚ))
    (n : ℕ) :
    longWeyl3 * transposeInv3 (iotaTorusLocal v n * (longWeyl3 *
        Matrix.GeneralLinearGroup.scalar (Fin 3) ((AdelicLevel.uniformizerUnit ℚ v * (ratPrimeUnit v)⁻¹) ^ n))) =
      (centralGen v)⁻¹ ^ n * twoRowPointLocal v n n := by
  rw [ScalarComponents.centralGen_eq_glScalar]
  refine longWeyl3_mul_transposeInv3_eq_scalar_inv_pow_mul (ratPrimeUnit v) (AdelicLevel.uniformizerUnit ℚ v) n
    (iotaTorusLocal v n) (twoRowPointLocal v n n) ?_ (TorusDilation.coe_twoRowPointLocal v n n)
  show ((iotaGL (diagHom (ratPrimeUnit v ^ n)))⁻¹ : LocalGL3 v).val = _
  rw [diagHom_apply, TorusPoints.iotaGL_diagUnitGL2_inv, TorusPoints.coe_iotaGL_diagUnitGL2]

private theorem dualWhittakerFn3_apply_iotaTorusLocal_eq_mul_sphericalTorusValue {K : Type} [Field K]
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (c : HeightOneSpectrum (𝓞 K) → ℂ)
    (v : HeightOneSpectrum (𝓞 ℚ)) (Wloc : (w : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 w → ℂ)
    (hWv : HasSphericalTorusValuesAt c v (Wloc v)) (hE3 : inducedE3 ℚ c v ≠ 0)
    (hWz : ∀ h : LocalGL3 v, Wloc v (centralGen v * h) = inducedE3 ℚ c v * Wloc v h)
    (hWK : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 (Wloc v))) (n : ℕ) :
    dualWhittakerFn3 (Wloc v) (iotaTorusLocal v n) =
      (cNormQ v)⁻¹ ^ n *
        sphericalTorusValue (inducedE2 ℚ c v / inducedE3 ℚ c v) (inducedE1 ℚ c v / inducedE3 ℚ c v)
          (inducedE3 ℚ c v)⁻¹ n := by
  have hunit : CharacterComponents.IsIntegralUnit v ((AdelicLevel.uniformizerUnit ℚ v * (ratPrimeUnit v)⁻¹) ^ n) := by
    apply ScalarComponents.isIntegralUnit_of_valued_eq_one
    simp [Units.val_pow_eq_pow_val, Units.val_mul, Units.val_inv_eq_inv_val, map_pow, map_mul, map_inv₀,
      AdelicLevel.valued_uniformizerUnit, TorusPoints.valued_ratPrimeUnit]
  have hk : longWeyl3 * Matrix.GeneralLinearGroup.scalar (Fin 3) ((AdelicLevel.uniformizerUnit ℚ v *
      (ratPrimeUnit v)⁻¹) ^ n) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v :=
    mul_mem (DualProduct.longWeyl3_mem_localMaximalCompact3 v)
      ((ScalarComponents.glScalar_mem_localMaximalCompact3_iff v _).2 hunit)
  rw [← hWK (iotaTorusLocal v n) _ hk, dualWhittakerFn3_apply,
    longWeyl3_mul_transposeInv3_eq_inv_centralGen_pow_mul_twoRowPointLocal,
    apply_inv_centralGen_pow_mul (centralGen v) (Wloc v) hE3 hWz]
  cases n with
  | zero =>
    rw [twoRowPointLocal_zero_right, hWv.1 0]
    simp [sphericalTorusValue]
  | succ m =>
    rw [hWv.2 (m + 1) m (le_refl _)]
    have key := pow_mul_sphericalTorusValue_inv_triple_eq_sq_sub_mul (inducedE1 ℚ c v) (inducedE2 ℚ c v)
      (inducedE3 ℚ c v) hE3 m
    have h2 : sphericalTorusValue (inducedE1 ℚ c v) (inducedE2 ℚ c v) (inducedE3 ℚ c v) (m + 1 + 1) =
        sphericalTorusValue (inducedE1 ℚ c v) (inducedE2 ℚ c v) (inducedE3 ℚ c v) (m + 2) := rfl
    rw [h2]
    have hinv : (inducedE3 ℚ c v)⁻¹ ^ (m + 1) * inducedE3 ℚ c v ^ (m + 1) = 1 := by
      rw [← mul_pow, inv_mul_cancel₀ hE3, one_pow]
    linear_combination (-((inducedE3 ℚ c v)⁻¹ ^ (m + 1) * (cNormQ v)⁻¹ ^ (m + 1))) * key +
      ((cNormQ v)⁻¹ ^ (m + 1) *
        sphericalTorusValue (inducedE2 ℚ c v / inducedE3 ℚ c v) (inducedE1 ℚ c v / inducedE3 ℚ c v)
          (inducedE3 ℚ c v)⁻¹ (m + 1)) * hinv

private theorem xLineAt_uniformizer_pow_eq_shellCoeff_inv_triple {K : Type} [Field K] [Algebra (𝓞 ℚ) (𝓞 K)]
    [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (c : HeightOneSpectrum (𝓞 K) → ℂ) (v : HeightOneSpectrum (𝓞 ℚ))
    (Wloc : (w : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 w → ℂ) (hWv : HasSphericalTorusValuesAt c v (Wloc v))
    (hE3 : inducedE3 ℚ c v ≠ 0)
    (hWz : ∀ h : LocalGL3 v, Wloc v (centralGen v * h) = inducedE3 ℚ c v * Wloc v h)
    {ψloc : (w : HeightOneSpectrum (𝓞 ℚ)) → AddChar (w.adicCompletion ℚ) ℂ}
    (hWψ : IsGL3PsiWhittakerFn (ψloc v) (dualWhittakerFn3 (Wloc v)))
    (hWK : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) (dualWhittakerFn3 (Wloc v)))
    (hψloc : ∀ y₀ ∉ v.adicCompletionIntegers ℚ, ∃ y : v.adicCompletion ℚ, Valued.v (y * y₀⁻¹) ≤ 1 ∧ ψloc v y ≠ 1)
    (g : AdelicGL 3 (𝓞 ℚ) ℚ) (hg : componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    (∀ (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (n : ℕ), Idele.ord ℚ v a = n →
      ((selfDualHaarAt ℚ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℂ)⁻¹ *
          ∫ y : v.adicCompletion ℚ, LineIntegral.xLineAt Wloc a g v y ∂(selfDualHaarAt ℚ v) =
        (cNormQ v)⁻¹ ^ n *
          sphericalTorusValue (inducedE2 ℚ c v / inducedE3 ℚ c v) (inducedE1 ℚ c v / inducedE3 ℚ c v)
            (inducedE3 ℚ c v)⁻¹ n) ∧
    ∀ a : (AdeleRing (𝓞 ℚ) ℚ)ˣ, Idele.ord ℚ v a < 0 →
      ((selfDualHaarAt ℚ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℂ)⁻¹ *
          ∫ y : v.adicCompletion ℚ, LineIntegral.xLineAt Wloc a g v y ∂(selfDualHaarAt ℚ v) = 0 := by
  have hvol : (((selfDualHaarAt ℚ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (left_ne_zero_of_mul_eq_one
      (TateLocal.selfDualHaarAt_real_integers_mul_real_setOf_valued_le_exp_addCharLevel ℚ v))
  have hO : MeasurableSet[TateLocal.localBorel ℚ v] (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) := by
    letI := TateLocal.localBorel ℚ v
    haveI := TateLocal.borelSpace_localBorel ℚ v
    rw [← TateLocal.coe_integersPositiveCompacts]
    exact (TateLocal.integersPositiveCompacts ℚ v).isCompact.measurableSet
  have hval : ∀ a : (AdeleRing (𝓞 ℚ) ℚ)ˣ,
      ∫ y : v.adicCompletion ℚ, LineIntegral.xLineAt Wloc a g v y ∂(selfDualHaarAt ℚ v) =
        (selfDualHaarAt ℚ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) •
          dualWhittakerFn3 (Wloc v) (iotaGL (diagUnitGL2 (CharacterComponents.unitsAt v a))) := by
    intro a
    have hfun : (fun y : v.adicCompletion ℚ => LineIntegral.xLineAt Wloc a g v y) =
        (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)).indicator
          (fun _ => dualWhittakerFn3 (Wloc v) (iotaGL (diagUnitGL2 (CharacterComponents.unitsAt v a)))) := by
      funext y
      by_cases hy : y ∈ v.adicCompletionIntegers ℚ
      · rw [Set.indicator_of_mem hy]
        exact xLineAt_eq_apply_iotaGL_diagUnitGL2_unitsAt_of_valued_le_one v Wloc hWK a g hg hy
      · rw [Set.indicator_of_notMem hy]
        exact xLineAt_eq_zero_of_not_mem_adicCompletionIntegers v Wloc hWψ hWK hψloc a g hg hy
    rw [hfun, MeasureTheory.integral_indicator_const _ hO]
  have hord : ∀ a : (AdeleRing (𝓞 ℚ) ℚ)ˣ,
      Valued.v (CharacterComponents.unitsAt v a : v.adicCompletion ℚ) = WithZero.exp (-Idele.ord ℚ v a) := by
    intro a
    rw [CharacterComponents.unitsAt_val, Idele.valued_snd_eq_exp_neg_ord]
  refine ⟨fun a n hn => ?_, fun a ha => ?_⟩
  · rw [hval, Complex.real_smul, ← mul_assoc, inv_mul_cancel₀ hvol, one_mul,
      TorusPoints.apply_iotaGL_diagUnitGL2_eq_apply_iotaTorusLocal v hWK (by rw [hord, hn]),
      dualWhittakerFn3_apply_iotaTorusLocal_eq_mul_sphericalTorusValue c v Wloc hWv hE3 hWz hWK]
  · have hd : (CharacterComponents.unitsAt v a : v.adicCompletion ℚ) ∉ v.adicCompletionIntegers ℚ := by
      intro h
      have h' : Valued.v (CharacterComponents.unitsAt v a : v.adicCompletion ℚ) ≤ 1 := h
      rw [hord, ← WithZero.exp_zero, WithZero.exp_le_exp] at h'
      omega
    obtain ⟨y, hy, hψy⟩ := hψloc _ hd
    have hy' : Valued.v ((CharacterComponents.unitsAt v a)⁻¹ * y : v.adicCompletion ℚ) ≤ 1 := by
      rwa [Units.val_inv_eq_inv_val, mul_comm]
    have h0 := RootVanishing.apply_iotaGL_diagUnitGL2_mul_eq_zero hWψ hWK (CharacterComponents.unitsAt v a) hy' hψy
      (one_mem (localMaximalCompact3 (𝓞 ℚ) ℚ v))
    rw [mul_one] at h0
    rw [hval, h0, smul_zero, mul_zero]

