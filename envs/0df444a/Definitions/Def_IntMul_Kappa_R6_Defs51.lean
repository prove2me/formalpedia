-- Source module: Solutions.R6BitNBRed
/-!
# Round six, bit network: reduction mod `N` of good rational matrices

`GoodM N A`: all entries of `A` have denominators coprime to `N`. Good matrices form a ring and
`redM N` is multiplicative and additive on them. Partial swaps over `ℚ` multiply as over
`ZMod N` (`pswQ_mul`), and an edge with rational Bruhat data (`EdgeQ e q`, good factors) has
frame matrix `redM N (pswQ q)` (`edgeMat_eq`).
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

namespace NB

open Matrix AModelFac AModel

variable {l n p : Type*} [Fintype n] [DecidableEq n]

/-- All denominators coprime to `N`. -/
def GoodM (N : ℕ) (A : Matrix l p ℚ) : Prop := ∀ i j, Nat.Coprime (A i j).den N

/-- The good matrix as a matrix over `goodSub N`. -/
def toG (N : ℕ) (A : Matrix n n ℚ) : Matrix n n (goodSub N) := A.map (toGood N)

end NB

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitNBKr
/-!
# Round six, bit network: frames in the flag basis

`K A B = S (A ⊗ B) S⁻¹` (`S`, `Sinv` from `flagBasis`). The stage frames are
`Φ₁ b c = pswQ (K (Pc c) (Pl b))` and `Φ₂ a c = pswQ (1 - K (Pl a) (Pc c))`; every edge of the network
is a partial swap `pswQ (K A B)` and carries frames along (identities over `ℚ`).
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix R6Chk R6Chk.Bit R6Chk.Bit.Loc
open scoped Kronecker

abbrev M23 := Matrix (Fin 23) (Fin 23) ℚ

section K

variable (S : Matrix (Fin 529) (Pr 23) ℚ) (Si : Matrix (Pr 23) (Fin 529) ℚ)

/-- The conjugated Kronecker product. -/
def K (A B : M23) : Matrix (Fin 529) (Fin 529) ℚ := S * (A ⊗ₖ B) * Si

variable {S Si}

/-- Stage-one frames. -/
noncomputable def Φ₁ (S : Matrix (Fin 529) (Pr 23) ℚ) (Si : Matrix (Pr 23) (Fin 529) ℚ) (b c : ℕ) :
    QMat2 529 := pswQ (K S Si (Pc c) (Pl b))

/-- Stage-two frames. -/
noncomputable def Φ₂ (S : Matrix (Fin 529) (Pr 23) ℚ) (Si : Matrix (Pr 23) (Fin 529) ℚ) (a c : ℕ) :
    QMat2 529 := pswQ (1 - K S Si (Pl a) (Pc c))

variable (hS : S * Si = 1) (hSi : Si * S = 1)
include hS hSi

end K

end IntMul.Kappa.R6.Bit.NB

end


