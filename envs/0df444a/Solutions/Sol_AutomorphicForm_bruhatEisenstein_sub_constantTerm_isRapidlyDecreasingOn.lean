private theorem bigCellArch_apply (φ : AdelicGL2 (𝓞 F) F → ℂ) (z : F → 𝔸) (x : AdelicGL2 (𝓞 F) F) (u : InfiniteAdeleRing F) :
    bigCellArch φ z x u = ∑' ξ : F, φ (adelicWeyl (𝓞 F) F * unipotentGL2 (z ξ + mkAdele F u 0) * x) := rfl

private def transFamily (z : F → 𝔸) (u : InfiniteAdeleRing F) : F → 𝔸 := fun ξ => z ξ + mkAdele F u 0

private theorem transFamily_apply (z : F → 𝔸) (u : InfiniteAdeleRing F) (ξ : F) : transFamily z u ξ = z ξ + mkAdele F u 0 := rfl

private theorem bigCellArch_flow_eq (φ : AdelicGL2 (𝓞 F) F → ℂ) (z : F → 𝔸) (x : AdelicGL2 (𝓞 F) F) (u : InfiniteAdeleRing F) :
