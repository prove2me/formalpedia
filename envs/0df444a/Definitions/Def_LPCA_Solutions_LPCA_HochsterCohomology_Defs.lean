namespace LPCA

open CategoryTheory CategoryTheory.Limits

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k]

theorem offsetFaceComplex_isZero_below (rank : V ↪ ℕ) (K : Complex V)
    (m n : ℤ) (hn : n < m) : IsZero ((offsetFaceComplex k rank K m).X n) := by
  haveI : IsEmpty (OffsetFaceIndex K m n) := ⟨fun G => by
    have hc := G.property.2
    omega⟩
  change IsZero (ModuleCat.of k (OffsetFaceIndex K m n → k))
  exact ModuleCat.isZero_iff_subsingleton.mpr inferInstance







end LPCA


