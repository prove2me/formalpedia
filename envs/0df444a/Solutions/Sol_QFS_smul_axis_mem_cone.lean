open QFS

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The point `t • v` lies in the cone about `v`, for every `t > 0`. -/
lemma solution {v : E} (hv : ‖v‖ = 1) {ϑ : ℝ} (hϑ : 0 < ϑ) (hϑ' : ϑ ≤ π / 2)
    {t : ℝ} (ht : 0 < t) : t • v ∈ QFS.cone v ϑ := by
  refine QFS.mem_cone_of_norm_sub_lt hv hϑ hϑ' ht ?_
  simp only [sub_self, norm_zero]
  exact mul_pos ht (Real.sin_pos_of_pos_of_lt_pi hϑ (by linarith [pi_pos]))
