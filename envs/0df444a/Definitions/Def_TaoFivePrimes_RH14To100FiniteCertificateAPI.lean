namespace CertifiedFixedPoint

structure Box where
  lo : ℕ
  hi : ℕ
  deriving DecidableEq, Repr

def mulDivBox (S d : ℕ) (a b : Box) : Box :=
  ⟨a.lo*b.lo/(S*d),a.hi*b.hi/(S*d)+1⟩

def repeatedSquare (S : ℕ) : ℕ → Box → Box
  | 0, a => a
  | n+1, a => repeatedSquare S n (mulDivBox S 1 a a)

end CertifiedFixedPoint

