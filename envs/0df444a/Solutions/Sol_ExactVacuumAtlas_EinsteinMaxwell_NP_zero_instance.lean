variable {U : Set (Pt 4)} {g h₁ h₂ : Metric 4} {F f₁ f₂ : TwoForm 4} {E B₁ B₂ : Fin 4 → Fin 4 → Pt 4 → ℂ}
  {c₁ c₂ : ℝ}

variable (hU : IsOpen U) (hB₁ : ∀ A μ, ContDiffOn ℝ ∞ (B₁ A μ) U) (hB₂ : ∀ A μ, ContDiffOn ℝ ∞ (B₂ A μ) U)
include hU hB₁ hB₂

theorem brkVar_lcomb {x : Pt 4} (hx : x ∈ U) (A K μ : Fin 4) :
    brkVar E (lcombC c₁ B₁ c₂ B₂) A K μ x = c₁ * brkVar E B₁ A K μ x + c₂ * brkVar E B₂ A K μ x := by
  have e1 : ∀ A K, fdir E A (lcombC c₁ B₁ c₂ B₂ K μ) x
      = (c₁ : ℂ) * fdir E A (B₁ K μ) x + (c₂ : ℂ) * fdir E A (B₂ K μ) x := by
    intro A K
    rw [show lcombC c₁ B₁ c₂ B₂ K μ = fun z => (c₁ : ℂ) * B₁ K μ z + (c₂ : ℂ) * B₂ K μ z from rfl,
      fdir_add_of hU hx (contDiffOn_const.mul (hB₁ K μ)) (contDiffOn_const.mul (hB₂ K μ)),
      fdir_const_mul, fdir_const_mul]
  have e2 : ∀ A K, fdir (lcombC c₁ B₁ c₂ B₂) A (E K μ) x
      = (c₁ : ℂ) * fdir B₁ A (E K μ) x + (c₂ : ℂ) * fdir B₂ A (E K μ) x := by
    intro A K
    simp only [fdir, lcombC, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun _ _ => by ring
  simp only [brkVar, e1, e2]
  ring

theorem cLVar_lcomb {x : Pt 4} (hx : x ∈ U) (C A K : Fin 4) :
    cLVar g (lcomb c₁ h₁ c₂ h₂) E (lcombC c₁ B₁ c₂ B₂) C A K x
      = c₁ * cLVar g h₁ E B₁ C A K x + c₂ * cLVar g h₂ E B₂ C A K x := by
  have hT := ccontr_lin_T (T := lcomb c₁ h₁ c₂ h₂) (T₁ := h₁) (T₂ := h₂) (x := x) (c₁ := c₁) (c₂ := c₂)
    (fun a b => rfl)
  have hv : ∀ A, fvec (lcombC c₁ B₁ c₂ B₂) A x = fun μ => (c₁ : ℂ) * fvec B₁ A x μ + (c₂ : ℂ) * fvec B₂ A x μ :=
    fun A => rfl
  have hb : (fun μ => brkVar E (lcombC c₁ B₁ c₂ B₂) A K μ x)
      = fun μ => (c₁ : ℂ) * brkVar E B₁ A K μ x + (c₂ : ℂ) * brkVar E B₂ A K μ x :=
    funext fun μ => brkVar_lcomb hU hB₁ hB₂ hx A K μ
  simp only [cLVar, hT, hv, hb, ccontr_lin_left, ccontr_lin_right]
  ring

/-- **Real linearity of the connection-component variation** `omLVar` in `(h, B)`. -/
theorem omLVar_lcomb {x : Pt 4} (hx : x ∈ U) (C A K : Fin 4) :
    omLVar g (lcomb c₁ h₁ c₂ h₂) E (lcombC c₁ B₁ c₂ B₂) C A K x
      = c₁ * omLVar g h₁ E B₁ C A K x + c₂ * omLVar g h₂ E B₂ C A K x := by
  simp only [omLVar, cLVar_lcomb hU hB₁ hB₂ hx]
  ring

