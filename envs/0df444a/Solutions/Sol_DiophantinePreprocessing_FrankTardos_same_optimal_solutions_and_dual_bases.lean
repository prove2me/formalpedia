/-- A direction pointing into the nonnegative orthant at every zero coordinate permits
a strictly positive feasible step. The family is finite. -/
theorem exists_positive_step {ι : Type*} [Fintype ι] (y v : ι → ℝ)
    (hy : ∀ i, 0 ≤ y i) (hv : ∀ i, y i = 0 → 0 ≤ v i) :
    ∃ t : ℝ, 0 < t ∧ ∀ i, 0 ≤ y i + t * v i := by
  have he : ∀ᶠ t : ℝ in 𝓝 0, ∀ i, 0 ≤ t → 0 ≤ y i + t * v i := by
    apply eventually_all.mpr
    intro i
    by_cases hi : y i = 0
    · exact Eventually.of_forall fun t ht => by
        rw [hi, zero_add]
        exact mul_nonneg ht (hv i hi)
    · have hpos : 0 < y i := lt_of_le_of_ne (hy i) (Ne.symm hi)
      have hc : ContinuousAt (fun t : ℝ => y i + t * v i) 0 := by fun_prop
      have hp : ∀ᶠ t : ℝ in 𝓝 0, 0 < y i + t * v i :=
        hc.eventually (Ioi_mem_nhds (by simpa using hpos))
      exact hp.mono fun t ht _ => ht.le
  have hf : ∀ᶠ t : ℝ in 𝓝[>] 0, 0 < t ∧ ∀ i, 0 ≤ y i + t * v i := by
    filter_upwards [he.filter_mono nhdsWithin_le_nhds, self_mem_nhdsWithin] with t ht hpos
    exact ⟨hpos, fun i => ht i hpos.le⟩
  exact hf.exists

end ObjectiveCompression
end


/- Inlined checked module: PrimalOptimality -/
section
set_option autoImplicit false

open scoped BigOperators
open Matrix
open DiophantinePreprocessing.FrankTardos

namespace ObjectiveCompression

def rowEval {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ) (i : Fin m) (x : Fin n → ℝ) : ℝ :=
  ∑ j, (A i j : ℝ) * x j

noncomputable def activeRows {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (b : Fin m → ℝ) (x : Fin n → ℝ) : Matrix (Fin m) (Fin n) ℤ := by
  classical
  exact fun i => if rowEval A i x = b i then A i else 0

theorem rowEval_active_eq {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (b : Fin m → ℝ) (x y : Fin n → ℝ) (i : Fin m) (hi : rowEval A i x = b i) :
    rowEval (activeRows A b x) i y = rowEval A i y := by
  unfold rowEval
  simp only [activeRows, if_pos hi]

theorem rowEval_active_zero {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (b : Fin m → ℝ) (x y : Fin n → ℝ) (i : Fin m) (hi : rowEval A i x ≠ b i) :
    rowEval (activeRows A b x) i y = 0 := by
  unfold rowEval
  simp [activeRows, hi]

theorem weighted_sum_sub_mul {n : ℕ} (a x p : Fin n → ℝ) (t : ℝ) :
    (∑ j, a j * (x j - t * p j)) = (∑ j, a j * x j) - t * ∑ j, a j * p j := by
  simp [mul_sub, Finset.sum_sub_distrib, Finset.mul_sum, mul_left_comm]

theorem representation_dot {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (c : Fin m → ℝ) (w y : Fin n → ℝ)
    (hw : ∀ j, w j = ∑ i, c i * (A i j : ℝ)) :
    (∑ j, w j * y j) = ∑ i, c i * rowEval A i y := by
  simp_rw [hw, Finset.sum_mul, mul_assoc]
  rw [Finset.sum_comm]
  simp only [rowEval, Finset.mul_sum]

/-- Finite linear programming optimality expressed by the cone of active row normals. -/
theorem optimal_iff_active_rowCone {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (b : Fin m → ℝ) (w x : Fin n → ℝ) :
    IsWMaximal A b w x ↔ x ∈ polyhedron A b ∧ RowCone (activeRows A b x) w := by
  classical
  constructor
  · rintro ⟨hx, hopt⟩
    refine ⟨hx, ?_⟩
    let C : Matrix (Fin m) (Fin n) ℝ := fun i j => (activeRows A b x i j : ℝ)
    rcases (FGCone.farkas_lemma Cᵀ w).or with hrep | hsep
    · obtain ⟨c, hc, heq⟩ := hrep
      refine ⟨c, hc, ?_⟩
      intro j
      have h := congrFun heq j
      change (∑ i, (activeRows A b x i j : ℝ) * c i) = w j at h
      simpa only [mul_comm] using h.symm
    · obtain ⟨p, hp, hpw⟩ := hsep
      have hp' (i : Fin m) : 0 ≤ ∑ j, C i j * p j := by
        simpa [Matrix.mulVec, dotProduct] using hp i
      have hpw' : (∑ j, w j * p j) < 0 := by simpa [dotProduct, mul_comm] using hpw
      let s : Fin m → ℝ := fun i => b i - rowEval A i x
      let v : Fin m → ℝ := fun i => rowEval A i p
      have hs (i : Fin m) : 0 ≤ s i := sub_nonneg.mpr (hx i)
      have hv (i : Fin m) (hi : s i = 0) : 0 ≤ v i := by
        have heq : rowEval A i x = b i := by dsimp [s] at hi; linarith
        have h := hp' i
        change 0 ≤ rowEval (activeRows A b x) i p at h
        rw [rowEval_active_eq A b x p i heq] at h
        exact h
      obtain ⟨t, ht, hstep⟩ := exists_positive_step s v hs hv
      let y : Fin n → ℝ := fun j => x j - t * p j
      have hy : y ∈ polyhedron A b := by
        intro i
        change (∑ j, (A i j : ℝ) * (x j - t * p j)) ≤ b i
        rw [weighted_sum_sub_mul]
        have h := hstep i
        dsimp [s, v, rowEval] at h
        linarith
      have h := hopt y hy
      change (∑ j, w j * (x j - t * p j)) ≤ ∑ j, w j * x j at h
      rw [weighted_sum_sub_mul] at h
      have hneg := mul_neg_of_pos_of_neg ht hpw'
      exfalso
      linarith
  · rintro ⟨hx, c, hc, hw⟩
    refine ⟨hx, ?_⟩
    intro y hy
    rw [representation_dot (activeRows A b x) c w y hw,
      representation_dot (activeRows A b x) c w x hw]
    apply Finset.sum_le_sum
    intro i _
    apply mul_le_mul_of_nonneg_left _ (hc i)
    by_cases hi : rowEval A i x = b i
    · rw [rowEval_active_eq A b x y i hi, rowEval_active_eq A b x x i hi, hi]
      exact hy i
    · rw [rowEval_active_zero A b x y i hi, rowEval_active_zero A b x x i hi]

theorem same_maximizers_of_signs {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (hA : ∀ i j, |A i j| ≤ 1) (b : Fin m → ℝ) (w w' : Fin n → ℝ)
    (hs : SameSmallSigns n w w') (x : Fin n → ℝ) :
    IsWMaximal A b w x ↔ IsWMaximal A b w' x := by
  rw [optimal_iff_active_rowCone, optimal_iff_active_rowCone]
  have hactive (i : Fin m) (j : Fin n) : |activeRows A b x i j| ≤ 1 := by
    classical
    dsimp [activeRows]
    split_ifs
    · exact hA i j
    · norm_num
  rw [rowCone_iff_of_sameSmallSigns (activeRows A b x) hactive w w' hs]

end ObjectiveCompression
end


/- Inlined checked module: DualSupportOptimality -/
section
set_option autoImplicit false

open scoped BigOperators
open Matrix DiophantinePreprocessing.FrankTardos

namespace ObjectiveCompression

theorem sum_add_mul_sub {m : ℕ} (a y q y' : Fin m → ℝ) (t : ℝ) :
    (∑ i, (y i + t * (q i - y' i)) * a i) =
      (∑ i, y i * a i) + t * ((∑ i, q i * a i) - ∑ i, y' i * a i) := by
  simp [add_mul, sub_mul, mul_sub, Finset.sum_add_distrib,
    Finset.sum_sub_distrib, Finset.mul_sum, mul_assoc]

/-- Optimality transfers between feasible dual points when every zero coordinate of the
old point is also zero at the new point. This includes arbitrary right-hand sides and costs. -/
theorem dual_optimal_transport {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (b : Fin m → ℝ) (w w' : Fin n → ℝ) (y y' : Fin m → ℝ)
    (hy' : IsDualFeasible A w' y') (hzero : ∀ i, y i = 0 → y' i = 0)
    (hy : IsDualOptimal A b w y) : IsDualOptimal A b w' y' := by
  refine ⟨hy', ?_⟩
  intro q' hq'
  let v : Fin m → ℝ := fun i => q' i - y' i
  have hv (i : Fin m) (hi : y i = 0) : 0 ≤ v i := by
    dsimp [v]
    rw [hzero i hi, sub_zero]
    exact hq'.1 i
  obtain ⟨t, ht, hstep⟩ := exists_positive_step y v hy.1.1 hv
  let q : Fin m → ℝ := fun i => y i + t * (q' i - y' i)
  have hq : IsDualFeasible A w q := by
    refine ⟨hstep, ?_⟩
    intro j
    change (∑ i, (y i + t * (q' i - y' i)) * (A i j : ℝ)) = w j
    rw [sum_add_mul_sub, hy.1.2 j, hq'.2 j, hy'.2 j]
    ring
  have hcost := hy.2 q hq
  change (∑ i, y i * b i) ≤ ∑ i, (y i + t * (q' i - y' i)) * b i at hcost
  rw [sum_add_mul_sub] at hcost
  have hprod : 0 ≤ t * ((∑ i, q' i * b i) - ∑ i, y' i * b i) := by linarith
  have hdiff : 0 ≤ (∑ i, q' i * b i) - ∑ i, y' i * b i := by
    by_contra hneg
    have hlt := mul_neg_of_pos_of_neg ht (lt_of_not_ge hneg)
    linarith
  exact sub_nonneg.mp hdiff

end ObjectiveCompression
end


/- Inlined checked module: DualBasisTransport -/
section
set_option autoImplicit false

open scoped BigOperators
open Matrix DiophantinePreprocessing.FrankTardos

namespace ObjectiveCompression

theorem optimal_dual_basis_transport {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (hA : ∀ i j, |A i j| ≤ 1) (b : Fin m → ℝ) (w w' : Fin n → ℝ)
    (hs : SameSmallSigns n w w') (B : Finset (Fin m))
    (hopt : IsOptimalDualBasis A b w B) : IsOptimalDualBasis A b w' B := by
  classical
  obtain ⟨hB, y, hyout, hyopt⟩ := hopt
  let C : Matrix B (Fin n) ℤ := fun i j => A i.1 j
  let AR : Matrix (Fin m) (Fin n) ℝ := fun i j => (A i j : ℝ)
  let e : B ↪ Fin m := ⟨Subtype.val, Subtype.val_injective⟩
  have hemb : embedCoefficients e (fun i => y i.1) = y := by
    apply embedCoefficients_recover e y
    intro i hi
    apply hyout i
    intro hmem
    exact hi ⟨⟨i, hmem⟩, rfl⟩
  have hw (j : Fin n) : w j = ∑ i : B, y i.1 * (C i j : ℝ) := by
    have h : (y ᵥ* AR) j = w j := hyopt.1.2 j
    rw [← hemb, embedCoefficients_vecMul] at h
    exact h.symm
  obtain ⟨z, hzrep, hzsign⟩ := independent_coefficient_transport C
    (fun i j => hA i.1 j) hB.1 w w' hs (fun i => y i.1) hw
  have hz0 (i : B) : 0 ≤ z i := by
    apply sign_nonneg_iff.mp
    rw [← hzsign i]
    exact sign_nonneg_iff.mpr (hyopt.1.1 i.1)
  let ynew := embedCoefficients e z
  have hnew : IsDualFeasible A w' ynew := by
    constructor
    · intro j
      apply Finset.sum_nonneg
      intro i _
      split_ifs
      · exact hz0 i
      · exact le_rfl
    · intro j
      have h := embedCoefficients_vecMul e z AR j
      change (∑ i, ynew i * (A i j : ℝ)) = ∑ i : B, z i * (C i j : ℝ) at h
      exact h.trans (hzrep j).symm
  have hout (j : Fin m) (hj : j ∉ B) : ynew j = 0 := by
    apply embedCoefficients_eq_zero
    rintro ⟨i, rfl⟩
    exact hj i.property
  have hzero (i : Fin m) (hi : y i = 0) : ynew i = 0 := by
    by_cases hmem : i ∈ B
    · have hzi : z ⟨i, hmem⟩ = 0 := by
        apply sign_eq_zero_iff.mp
        rw [← hzsign ⟨i, hmem⟩, hi, sign_zero]
      have h := embedCoefficients_apply e z ⟨i, hmem⟩
      exact h.trans hzi
    · exact hout i hmem
  exact ⟨hB, ynew, hout, dual_optimal_transport A b w w' y ynew hnew hzero hyopt⟩

theorem same_optimal_dual_bases_of_signs {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (hA : ∀ i j, |A i j| ≤ 1) (b : Fin m → ℝ) (w w' : Fin n → ℝ)
    (hs : SameSmallSigns n w w') (B : Finset (Fin m)) :
    IsOptimalDualBasis A b w B ↔ IsOptimalDualBasis A b w' B :=
  ⟨optimal_dual_basis_transport A hA b w w' hs B,
    optimal_dual_basis_transport A hA b w' w hs.symm B⟩

end ObjectiveCompression
end


/- Inlined checked module: FrankTardosRoot -/
section
set_option autoImplicit false

namespace DiophantinePreprocessing.FrankTardos

/-- Frank–Tardos, Theorem 4.2 (p. 58), existence form: for every rational `w ∈ ℚⁿ` there is an
integral `w̃` with `‖w̃‖∞ ≤ 2^{4n³} N^{n(n+2)}`, `N = (n+1)! + 1` (the output of the
preprocessing algorithm applied to `w` and `N`), such that for every matrix `A` with entries
`0, ±1` and every `b`: (i) `x ∈ P = {x : A x ≤ b}` is `w`-maximal iff it is `w̃`-maximal, and
(ii) a set of rows of `A` is an optimal dual basis for `max (w x : A x ≤ b)` iff it is one for
`max (w̃ x : A x ≤ b)`. -/
theorem same_optimal_solutions_and_dual_bases (n : ℕ) (w : Fin n → ℚ) :
    ∃ wt : Fin n → ℤ,
      (∀ j, |wt j| ≤ 2 ^ (4 * n ^ 3) * (((n + 1).factorial : ℤ) + 1) ^ (n * (n + 2))) ∧
      ∀ (m : ℕ) (A : Matrix (Fin m) (Fin n) ℤ),
        (∀ i j, A i j = -1 ∨ A i j = 0 ∨ A i j = 1) →
        ∀ b : Fin m → ℝ,
          (∀ x : Fin n → ℝ,
            IsWMaximal A b (fun j => (w j : ℝ)) x ↔ IsWMaximal A b (fun j => (wt j : ℝ)) x) ∧
          (∀ B : Finset (Fin m),
            IsOptimalDualBasis A b (fun j => (w j : ℝ)) B ↔
              IsOptimalDualBasis A b (fun j => (wt j : ℝ)) B) := by
  obtain ⟨wt, hwt, hs⟩ := ObjectiveCompression.weight_compression n
    ((n + 1).factorial + 1) (by omega) (fun j => (w j : ℝ))
  have hsign : ObjectiveCompression.SameSmallSigns n
      (fun j => (w j : ℝ)) (fun j => (wt j : ℝ)) := by
    intro h hh
    exact hs h (by simpa only [Nat.cast_add, Nat.cast_one, add_sub_cancel_right] using hh)
  refine ⟨wt, ?_, ?_⟩
  · intro j
    simpa only [Nat.cast_add, Nat.cast_one] using hwt j
  · intro m A hA b
    have hAabs (i : Fin m) (j : Fin n) : |A i j| ≤ 1 := by
      rcases hA i j with h | h | h <;> rw [h] <;> norm_num
    exact ⟨fun x => ObjectiveCompression.same_maximizers_of_signs A hAabs b
        (fun j => (w j : ℝ)) (fun j => (wt j : ℝ)) hsign x,
      fun B => ObjectiveCompression.same_optimal_dual_bases_of_signs A hAabs b
        (fun j => (w j : ℝ)) (fun j => (wt j : ℝ)) hsign B⟩

end DiophantinePreprocessing.FrankTardos
end


open DiophantinePreprocessing.FrankTardos

theorem solution (n : ℕ) (w : Fin n → ℚ) :
    ∃ wt : Fin n → ℤ,
      (∀ j, |wt j| ≤ 2 ^ (4 * n ^ 3) * (((n + 1).factorial : ℤ) + 1) ^ (n * (n + 2))) ∧
      ∀ (m : ℕ) (A : Matrix (Fin m) (Fin n) ℤ),
        (∀ i j, A i j = -1 ∨ A i j = 0 ∨ A i j = 1) →
        ∀ b : Fin m → ℝ,
          (∀ x : Fin n → ℝ,
            IsWMaximal A b (fun j => (w j : ℝ)) x ↔ IsWMaximal A b (fun j => (wt j : ℝ)) x) ∧
          (∀ B : Finset (Fin m),
            IsOptimalDualBasis A b (fun j => (w j : ℝ)) B ↔
              IsOptimalDualBasis A b (fun j => (wt j : ℝ)) B) := DiophantinePreprocessing.FrankTardos.same_optimal_solutions_and_dual_bases n w
