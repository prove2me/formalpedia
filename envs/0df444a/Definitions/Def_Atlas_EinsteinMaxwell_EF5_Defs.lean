namespace ExactVacuumAtlas.EinsteinMaxwell.EF5

def domU5 : Set (Pt 5) := {x | 0 < x 1 ∧ 0 < x 2 ∧ x 2 < 1}

noncomputable def gEF5 (mu beta : ℝ) : Metric 5
  | 0, 0 => fun x => -(1 - mu / x 1 ^ 2 + beta / x 1 ^ 4)
  | 0, 1 => fun _ => 1
  | 1, 0 => fun _ => 1
  | 2, 2 => fun x => x 1 ^ 2 / (4 * x 2 * (1 - x 2))
  | 3, 3 => fun x => x 1 ^ 2 * x 2
  | 4, 4 => fun x => x 1 ^ 2 * (1 - x 2)
  | _, _ => fun _ => 0

noncomputable def giEF5 (mu beta : ℝ) : Metric 5
  | 0, 1 => fun _ => 1
  | 1, 0 => fun _ => 1
  | 1, 1 => fun x => 1 - mu / x 1 ^ 2 + beta / x 1 ^ 4
  | 2, 2 => fun x => 4 * x 2 * (1 - x 2) / x 1 ^ 2
  | 3, 3 => fun x => 1 / (x 1 ^ 2 * x 2)
  | 4, 4 => fun x => 1 / (x 1 ^ 2 * (1 - x 2))
  | _, _ => fun _ => 0

noncomputable def emPot5 (Q : ℝ) : CoVec 5
  | 0 => fun x => -Q / (2 * x 1 ^ 2)
  | _ => fun _ => 0

noncomputable def faraday5 (Q : ℝ) : TwoForm 5
  | 1, 0 => fun x => Q / x 1 ^ 3
  | 0, 1 => fun x => -Q / x 1 ^ 3
  | _, _ => fun _ => 0

/-! ## Smoothness -/

end ExactVacuumAtlas.EinsteinMaxwell.EF5


