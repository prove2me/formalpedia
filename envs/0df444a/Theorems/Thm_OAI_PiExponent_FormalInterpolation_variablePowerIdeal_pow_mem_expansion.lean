-- title:
--   Expansion of a variable-power ideal power
-- statement:
--   Every polynomial in the nth power of the ideal generated by the variable powers has a finite expansion into polynomial multiples of generator monomials, where the multiplicities in each monomial sum to n.

import Mathlib.RingTheory.MvPolynomial.Ideal

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.variablePowerIdeal_pow_mem_expansion
    {σ : Type*} [Fintype σ] {k : Type*} [CommSemiring k]
    (e : σ → Nat) (n : Nat) (p : MvPolynomial σ k)
    (hp : p ∈ (Ideal.span (Set.range
      (fun i : σ => (MvPolynomial.X i : MvPolynomial σ k) ^ e i))) ^ n) :
    ∃ (m : Nat) (b : Fin m → σ → Nat)
      (q : Fin m → MvPolynomial σ k),
      (∀ j, (∑ i, b j i) = n) ∧
      p = ∑ j, MvPolynomial.monomial
        (Finsupp.equivFunOnFinite.symm (fun i : σ => e i * b j i)) (1 : k) * q j := by sorry
