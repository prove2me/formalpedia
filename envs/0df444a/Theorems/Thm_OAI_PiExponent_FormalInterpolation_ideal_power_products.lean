-- title:
--   Coordinate powers in ideals generated by indexed products
-- statement:
--   If `x^e` belongs to the ideal generated by `g`, then `x^(e*k)` belongs to the ideal generated by all indexed k-fold products of `g`. The equivalence `eFin` enumerates those products, and `hprod` identifies them with the stated generators.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.ideal_power_products
    {d n N : Nat} (g : Fin n → MvPolynomial (Fin d) Complex)
    (p : Fin N → MvPolynomial (Fin d) Complex) (e k : Nat)
    (x : MvPolynomial (Fin d) Complex)
    (hx : x ^ e ∈ Ideal.span (Set.range g))
    (eFin : Fin N ≃ (Fin k → Fin n))
    (hprod : ∀ j : Fin N, p j = ∏ t : Fin k, g (eFin j t)) :
    x ^ (e * k) ∈ Ideal.span (Set.range p) := by sorry
