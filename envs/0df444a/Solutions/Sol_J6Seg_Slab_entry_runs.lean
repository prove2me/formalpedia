/-! ## Managed-state operations -/

section ops
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem encK_upd' (s : IState HS) (F : Fin HS → List ℤ) (i : Fin HS) (l : List ℤ) :
    (encK s F).upd i (ints l ++ s.G i) = encK s (update F i l) := by
  refine IState.ext' (fun x => ?_) rfl rfl
  by_cases h : x = i
  · subst h; simp
  · simp [h]

theorem mvM (s : IState HS) (F : Fin HS → List ℤ) {i j : Fin HS} (hij : i ≠ j) {a : ℤ}
    {l : List ℤ} (hi : F i = a :: l) :
    IRuns I iprog (.op (.mv i j)) (encK s F) (encK s (update (update F i l) j (a :: F j)))
      (2 * moveCost (zsz a) + 19) := by
  have h := IRuns.mv (I := I) (iprog := iprog) (s := encK s F) (i := i) (j := j) hij
    (L := ints l ++ s.G i) (a := a) (by simp [hi, ints])
  refine h.mono' ?_ le_rfl
  rw [encK_upd', show (Item.int a :: (encK s F).G j) = ints (a :: update F i l j) ++ s.G j by
    simp [ints, Function.update_of_ne (Ne.symm hij)], encK_upd', Function.update_of_ne (Ne.symm hij)]

theorem constM (s : IState HS) (F : Fin HS → List ℤ) (i : Fin HS) (c : ℤ) :
    IRuns I iprog (.op (.const i c)) (encK s F) (encK s (update F i (c :: F i))) (zsz c + 2) := by
  have h := IRuns.const (I := I) (iprog := iprog) (s := encK s F) i c
  refine h.mono' ?_ le_rfl
  rw [show (Item.int c :: (encK s F).G i) = ints (c :: F i) ++ s.G i by simp [ints], encK_upd']

end ops

