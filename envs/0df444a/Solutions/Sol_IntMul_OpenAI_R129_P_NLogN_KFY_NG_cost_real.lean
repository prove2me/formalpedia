          Kc * (((IntMul.OpenAI.R129.dP n : ℕ) : ℝ) * ((((IntMul.OpenAI.R129.dP n + 1) * (IntMul.OpenAI.R129.ℓP n - 1 + (IntMul.OpenAI.Glue.pP n + 2) + IntMul.OpenAI.R129.dP n + 1) ^ 2 : ℕ) : ℝ))) := by
