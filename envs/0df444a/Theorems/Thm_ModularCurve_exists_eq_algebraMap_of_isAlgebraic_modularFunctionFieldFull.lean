theorem ModularCurve.exists_eq_algebraMap_of_isAlgebraic_modularFunctionFieldFull
    (N : ℕ) [NeZero N] (x : ↥(modularFunctionFieldFull N)) (hx : IsAlgebraic ℚ x) :
