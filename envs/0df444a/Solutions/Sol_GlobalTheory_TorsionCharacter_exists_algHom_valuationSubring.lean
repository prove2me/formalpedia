  have h : ∀ a, φ a ∈ (⊥ : Subalgebra W F) := fun a => by
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.1 ((Algebra.IsIntegral.isIntegral (R := W) a).map φ)
