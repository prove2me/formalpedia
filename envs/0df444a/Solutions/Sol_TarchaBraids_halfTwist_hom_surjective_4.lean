import Mathlib
import Definitions.Def_BraidsLinksMCG_ArtinBraidGroup
import Definitions.Def_BraidsLinksMCG_ConfigSpace
import Definitions.Def_TarchaBraids_HalfTwist
import Theorems.Thm_TarchaBraids_thm_3_11_half_twists_generate

/-!
# Surjectivity of the half-twist homomorphism

`ArtinBraidGroup n` is `PresentedGroup (braidRels n)`, so it is generated by the `sigma i`.
Hence the range of *any* homomorphism out of it is the subgroup generated by the images of the
`sigma i`.  When those images are the elementary half-twists, the range is exactly
`Subgroup.closure (Set.range (halfTwistBraid n))`, and surjectivity is then precisely the
generation statement `thm_3_11_half_twists_generate`.

Steps 1-3 below are unconditional group theory; the single topological input is `thm_3_11`.
-/

open TarchaBraids BraidsLinksMCG

theorem solution (n : ℕ)
    (f : ArtinBraidGroup n →* GeomBraidGroup n)
    (hf : ∀ i : Fin (n - 1), f (sigma i) = halfTwistBraid n i) :
    Function.Surjective f := by
  rw [← MonoidHom.range_eq_top]
  -- The image of the generating set is exactly the set of elementary half-twists.
  have himg : f '' (Set.range (PresentedGroup.of : Fin (n - 1) → ArtinBraidGroup n))
      = Set.range (fun i : Fin (n - 1) => halfTwistBraid n i) := by
    ext y
    constructor
    · rintro ⟨x, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, (hf i).symm⟩
    · rintro ⟨i, rfl⟩
      exact ⟨PresentedGroup.of i, ⟨i, rfl⟩, hf i⟩
  calc f.range
      = Subgroup.map f ⊤ := MonoidHom.range_eq_map f
    _ = Subgroup.map f
          (Subgroup.closure (Set.range (PresentedGroup.of : Fin (n - 1) → ArtinBraidGroup n))) := by
          congr 1
          exact (PresentedGroup.closure_range_of (braidRels n)).symm
    _ = Subgroup.closure
          (f '' (Set.range (PresentedGroup.of : Fin (n - 1) → ArtinBraidGroup n))) :=
          MonoidHom.map_closure f _
    _ = Subgroup.closure (Set.range (fun i : Fin (n - 1) => halfTwistBraid n i)) := by
          rw [himg]
    _ = ⊤ := TarchaBraids.thm_3_11_half_twists_generate n
