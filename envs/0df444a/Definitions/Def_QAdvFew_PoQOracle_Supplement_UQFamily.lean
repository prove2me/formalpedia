-- title:
--   Uniform circuit families and QCMA verifiers over a unitary oracle
-- statement:
--   A **circuit family** over a unitary oracle assigns to each input length $n$ an oracle quantum circuit on $n+\mathrm{anc}(n)+1$ wires and an output wire; on input $x$ it starts in $|x,0\cdots0\rangle$ and accepts with the probability that the output wire reads $1$. A **QCMA verifier** additionally reads a classical witness $w$ of length $\mathrm{wit}(n)$ after $x$. A family is **uniform** if a deterministic polynomial-time algorithm without oracle access maps $1^n$ to the description of the circuit at length $n$, and **polynomially bounded** if one polynomial bounds the circuit size, the number of ancillas and the witness length.
--
--   Uniform, polynomially bounded families are the QPT oracle algorithms and QPT oracle verifiers of Definitions 3.6 and 3.7.
-- source:
--   Goldin, Lombardi, Morimae, Quantum Advantage has Few Complexity Implications, arXiv:2611.05303v1, §3.2.1, p. 12 (PDF p. 14); Definitions 3.6–3.7, p. 13 (PDF p. 15)

import Mathlib
import Definitions.Def_QAdvFew_PoQOracle_Supplement_UCirc

open QAlgorithms.Complexity

namespace QAdvFew.PoQOracle.Supplement

open QAdvFew.PoQOracle

/-- A family of oracle quantum circuits over a unitary oracle of arity `ar` (and a classical oracle)
deciding a language (Goldin, Lombardi, Morimae, *Quantum Advantage has Few Complexity Implications*, arXiv:2611.05303v1, §3.2.1, p. 12 (PDF p. 14), and Definition 3.6, p. 13 (PDF p. 15)): at input
length `n`, `anc n` ancilla wires beyond a mandatory one, a circuit on `n + anc n + 1` wires, and
an output wire. -/
structure UQFamily (ar : ℕ → ℕ → ℕ) where
  anc : ℕ → ℕ
  circ : (n : ℕ) → UCirc ar (n + anc n + 1)
  out : (n : ℕ) → Fin (n + anc n + 1)

namespace UQFamily

variable {ar : ℕ → ℕ → ℕ}

/-- The input state `|x, 0…0⟩`. -/
def inputState (Q : UQFamily ar) (x : Str) : QState (x.length + Q.anc x.length + 1) :=
  basisState fun i => if h : (i : ℕ) < x.length then x.get ⟨i, h⟩ else false

/-- `Pr[A^{O,C}(x) → 1]`: the probability that the output wire reads `1`. -/
noncomputable def accept (Q : UQFamily ar) (O : UOracle ar) (C : Oracle) (x : Str) : ℝ :=
  probOne ((Q.circ x.length).run O C (Q.inputState x)) (Q.out x.length)

/-- Uniformity (p. 12: "Uniform circuit families have descriptions generated by a deterministic
polynomial-time algorithm"): a polynomial-time computable map, with no oracle access, sends `1^n` to
the ancilla count, the output wire and the circuit description at length `n`. -/
def Uniform (Q : UQFamily ar) : Prop :=
  ∃ f : Str → Str, PolyTimeComputable f ∧
    ∀ n : ℕ, f (unary n) = bnat (Q.anc n) ++ bnat (Q.out n : ℕ) ++ (Q.circ n).desc

/-- Polynomial time: one polynomial bounds the circuit size (`UCirc.size`, which charges `t` for a
level-`t` query) and the ancilla count. -/
def PolyBounded (Q : UQFamily ar) : Prop :=
  ∃ q : Polynomial ℕ, ∀ n : ℕ, (Q.circ n).size ≤ q.eval n ∧ Q.anc n ≤ q.eval n

end UQFamily

/-- A QCMA verifier over a unitary oracle (Goldin, Lombardi, Morimae, *Quantum Advantage has Few Complexity Implications*, arXiv:2611.05303v1, Definition 3.7, p. 13 (PDF p. 15): "a QPT oracle
verifier `Ver^U` and a polynomial `p`"): at input length `n`, a witness length `wit n`, `anc n`
ancillas beyond a mandatory one, a circuit on `n + wit n + anc n + 1` wires reading `x` and then the
classical witness `w`, and an output wire. -/
structure UQVer (ar : ℕ → ℕ → ℕ) where
  wit : ℕ → ℕ
  anc : ℕ → ℕ
  circ : (n : ℕ) → UCirc ar (n + wit n + anc n + 1)
  out : (n : ℕ) → Fin (n + wit n + anc n + 1)

namespace UQVer

variable {ar : ℕ → ℕ → ℕ}

/-- The input state `|x, w, 0…0⟩`. -/
def inputState (V : UQVer ar) (x : Str) (w : Bits (V.wit x.length)) :
    QState (x.length + V.wit x.length + V.anc x.length + 1) :=
  basisState fun i =>
    if h : (i : ℕ) < x.length then x.get ⟨i, h⟩
    else if h' : (i : ℕ) < x.length + V.wit x.length then w ⟨i - x.length, by omega⟩
    else false

/-- `Pr[Ver^{O,C}(x, w) → 1]`. -/
noncomputable def accept (V : UQVer ar) (O : UOracle ar) (C : Oracle) (x : Str)
    (w : Bits (V.wit x.length)) : ℝ :=
  probOne ((V.circ x.length).run O C (V.inputState x w)) (V.out x.length)

/-- Uniformity: a polynomial-time computable map, with no oracle access, sends `1^n` to the witness
length, the ancilla count, the output wire and the circuit description at length `n`. -/
def Uniform (V : UQVer ar) : Prop :=
  ∃ f : Str → Str, PolyTimeComputable f ∧
    ∀ n : ℕ, f (unary n) =
      bnat (V.wit n) ++ bnat (V.anc n) ++ bnat (V.out n : ℕ) ++ (V.circ n).desc

/-- One polynomial bounds the circuit size, the ancilla count and the witness length. -/
def PolyBounded (V : UQVer ar) : Prop :=
  ∃ q : Polynomial ℕ, ∀ n : ℕ,
    (V.circ n).size ≤ q.eval n ∧ V.anc n ≤ q.eval n ∧ V.wit n ≤ q.eval n

end UQVer

end QAdvFew.PoQOracle.Supplement


