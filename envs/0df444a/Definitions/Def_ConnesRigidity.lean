    (hp : IsProjectionSupremum S p) :
    IsProjectionSupremum (e '' S) (e p) := by
  refine ⟨hp.1.map e, ?_, ?_⟩
  · rintro q ⟨r, hrS, rfl⟩
    exact ⟨(hp.2.1 r hrS).1.map e,
