private def HasArchWhittakerType (K : Type) [Field K] [NumberField K] (pins : CarrierPins K)
    (Φ : HeckeEigensystem K ℂ)
    (archR : ∀ w : InfinitePlace K, w.IsReal → RealArchParam)
    (archC : ∀ w : InfinitePlace K, w.IsComplex → ComplexArchParam)
    (dR : ∀ (w : InfinitePlace K) (hw : w.IsReal), ArchDatumR (archR w hw))
    (dC : ∀ (w : InfinitePlace K) (hw : w.IsComplex), ArchDatumC (archC w hw)) : Prop :=
  ∃ R : SmoothCuspRealizationAt K pins Φ.toRawCentral,
    IsGenuineCuspRealizationAt K pins Φ.toRawCentral R ∧
      ∃ g₀ : AdelicGL2 (𝓞 K) K,
        (∃ g : AdelicGL2 (𝓞 K) K, glFin (𝓞 K) K g = glFin (𝓞 K) K g₀ ∧
          whittakerCoefficient K pins (NumberField.StandardAddChar.stdAddChar K) R.toFun 1 g ≠ 0) ∧
        ∃ z : ℂ, ∀ g : AdelicGL2 (𝓞 K) K, glFin (𝓞 K) K g = glFin (𝓞 K) K g₀ →
          whittakerCoefficient K pins (NumberField.StandardAddChar.stdAddChar K) R.toFun 1 g =
            (((∏ w : InfinitePlace K, NumberField.AdelicVolume.archDetNorm w g ^ w.mult) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ) *
                archW archR archC dR dC g * z

