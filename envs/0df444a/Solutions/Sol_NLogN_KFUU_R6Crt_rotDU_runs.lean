-- Source module: Solutions.KILList
/-!
# KIL list layer: block transposes and their `pull` denotations

Arrays on `[P, q, M, B]` are described by a record function `r p y m : List ℤ` (each of length
`B`).  `inp r P q M` lists the records in the order `(p, y, m)`, `outF r P q M` in the order
`(p, m, y)`.  Moving the field `q` behind the field `M` maps `inp` to `outF` (and back).
-/

namespace NLogN.KIL

open AModel

/-! ## Generic list lemmas -/

theorem fm_congr {α β : Type*} {l : List α} {f g : α → List β} (h : ∀ x ∈ l, f x = g x) :
    l.flatMap f = l.flatMap g := by
  induction l with
  | nil => rfl
  | cons a l ih =>
    simp only [List.flatMap_cons]
    rw [h a (by simp), ih (fun x hx => h x (by simp [hx]))]

theorem range_mul (m n : ℕ) :
    List.range (m * n) = (List.range m).flatMap fun i => (List.range n).map fun j => i * n + j := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Nat.succ_mul, List.range_add, ih, List.range_succ, List.flatMap_append]
    simp

/-! ## The two orders of the records -/

