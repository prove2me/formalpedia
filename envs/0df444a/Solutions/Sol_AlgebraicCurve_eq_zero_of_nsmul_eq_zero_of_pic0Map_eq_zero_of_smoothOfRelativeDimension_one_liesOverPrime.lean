  have ptsQ_nsmul : ∀ (m : ℕ) (c : Pic0 (AlgebraicClosure ℚ) F), ptsQ (m • c) = (ptsQ c) ^ m := by
    intro m c
    induction m with
    | zero => rw [zero_nsmul, pow_zero]; exact ptsQ_zero
    | succ m ih => rw [succ_nsmul, pow_succ, hptsQ_add, ih]; rfl
  have ptsk_zero : ptsk 0 = 1 := by
    have h := hptsk_add 0 0
    rw [add_zero] at h
