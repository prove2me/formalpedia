theorem hdrF_gen (s : IState HS) (G : Fin HS → List ℤ) {r0 o du T : List ℤ} {bc : List ℤ}
    {n BH : ℕ} {x3 x4 : ℤ} (hb1 : zsz (n : ℤ) ≤ BH) (hb2 : zsz ((2 * n : ℕ) : ℤ) ≤ BH)
    (hb3 : zsz x3 ≤ BH) (hb4 : zsz x4 ≤ BH) :
    Sp hdrRS (encK s (BF G r0 [] [] o ((n : ℤ) :: ((2 * n : ℕ) : ℤ) :: x3 :: x4 :: T) du [] [] [] [] [] bc))
      (encK s (BF G r0 [] [] o T (x4 :: x3 :: ((2 * n : ℕ) : ℤ) :: (n : ℤ) :: du) [(n : ℤ)]
        [((2 * n : ℕ) : ℤ)] [((2 * n : ℕ) : ℤ)] [x3] [x4] bc))
      (52000 * (BH + 2)) := by
  have g1 := sp_tk (s := s) (BF G r0 [] [] o ((n : ℤ) :: ((2 * n : ℕ) : ℤ) :: x3 :: x4 :: T)
    du [] [] [] [] [] bc) (R := bN) (B := BH) (by decide) (by decide) (by decide) BF_dt hb1
  simp only [BF_bn, BF_du, BFu_bn, BFu_du, BFu_dt] at g1
  have g2 := sp_pushR (s := s) (BF G r0 [] [] o (((2 * n : ℕ) : ℤ) :: x3 :: x4 :: T)
    ((n : ℤ) :: du) [(n : ℤ)] [] [] [] [] bc) (i := bN2) (j := dT) (B := BH) (by decide)
    (by decide) BF_dt hb2
  simp only [BF_bn2, BFu_bn2] at g2
  have g3 := sp_tk (s := s) (BF G r0 [] [] o (((2 * n : ℕ) : ℤ) :: x3 :: x4 :: T)
    ((n : ℤ) :: du) [(n : ℤ)] [((2 * n : ℕ) : ℤ)] [] [] [] bc)
    (R := kr) (B := BH) (by decide) (by decide) (by decide) BF_dt hb2
  simp only [BF_vr, BF_du, BFu_vr, BFu_du, BFu_dt] at g3
  have g4 := sp_tk (s := s) (BF G r0 [] [] o (x3 :: x4 :: T)
    (((2 * n : ℕ) : ℤ) :: (n : ℤ) :: du) [(n : ℤ)] [((2 * n : ℕ) : ℤ)] [((2 * n : ℕ) : ℤ)] [] [] bc)
    (R := kK) (B := BH) (by decide) (by decide) (by decide) BF_dt hb3
  simp only [BF_vk, BF_du, BFu_vk, BFu_du, BFu_dt] at g4
  have g5 := sp_tk (s := s) (BF G r0 [] [] o (x4 :: T)
    (x3 :: ((2 * n : ℕ) : ℤ) :: (n : ℤ) :: du) [(n : ℤ)] [((2 * n : ℕ) : ℤ)] [((2 * n : ℕ) : ℤ)]
