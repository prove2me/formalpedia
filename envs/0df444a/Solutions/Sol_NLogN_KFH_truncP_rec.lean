theorem truncLoop_fsp (s : IState HS) (Δ w : ℕ) (f : Fin HS → List ℤ) (L l : List ℤ)
    (h0 : f 0 = L ++ l) (hO : f qO = []) (hc : f NLogN.KFB.c1 = []) {Lr : List Item}
    (hr : (encK s f).G rN = .int (L.length : ℤ) :: Lr) (hb : Bnd w L) :
    FSp (truncLoop Δ) (encK s f)
      (encK s (Function.update (Function.update f 0 l) qO
        (L.map fun a => a.tdiv (2 ^ Δ)).reverse))
      (L.length * (8100 * (w + Δ + 3) + 2100) + 2000) := by
  obtain ⟨n, hn⟩ : ∃ n, n = L.length := ⟨_, rfl⟩
  rw [← hn] at hr ⊢
  let F : ℕ → Fin HS → List ℤ := fun k => Function.update (Function.update f 0 (L.drop k ++ l)) qO
    ((L.take k).map fun a => a.tdiv (2 ^ Δ)).reverse
  have F0 : F 0 = f := by
    funext j
    simp only [F, List.drop_zero, List.take_zero, List.map_nil, List.reverse_nil,
      Function.update_apply]
    split_ifs with e1 e2 <;> (try subst e1) <;> (try subst e2) <;> simp_all
  have hFC : ∀ k, F k NLogN.KFB.c1 = [] := fun k => by simp +decide [F, Function.update_apply, hc]
  have H := FSp.repReg (C := NLogN.KFB.c1) (r := rN) (s := s) (F := F) (N := n) (Bb := zsz (n : ℤ))
    (c := 8100 * (w + Δ + 3)) (b := .seq (.push qO (quoE Δ)) (.pop 0)) (by decide) (by decide) hFC
    (by simp +decide [RS.writes]) (L := Lr) (by rw [F0]; exact hr) le_rfl ?_
  · rw [F0] at H
    refine (H.mono (cLp_self n _)).congr ?_
    congr 1; funext j
    simp only [F, hn, List.drop_length, List.nil_append, List.take_length]
  · intro k hk
    have hkL : k < L.length := by omega
    set a := L[k]
    have ha : zsz a ≤ w := hb a (List.getElem_mem hkL)
    set g := Function.update (F k) NLogN.KFB.c1 [(n : ℤ) - k]
    have hd : L.drop k = a :: L.drop (k + 1) := List.drop_eq_getElem_cons hkL
    have g0 : g 0 = a :: (L.drop (k + 1) ++ l) := by
      simp +decide [g, F, Function.update_apply, hd]
    have hq : (quoE Δ).eval (encK s g) = a.tdiv (2 ^ Δ) := by
      simp only [quoE, Ex.eval]; rw [top_encK g0]
    have s1 := Sp.push s g (i := qO) (e := quoE Δ) (B := w + Δ + 1) (by decide) (quoE_clean Δ)
      ⟨ok_reg g0, trivial, Δ, by simp [Ex.eval]⟩ ⟨trivial, trivial⟩
      ⟨bnd_reg g0 (by omega), by simp only [Ex.Bnd, NLogN.zsz_two_pow]; omega⟩
    rw [hq] at s1
    set g1 := Function.update g qO (a.tdiv (2 ^ Δ) :: g qO)
    have g10 : g1 0 = a :: (L.drop (k + 1) ++ l) := by
      simp only [g1, Function.update_apply, if_neg (show (0 : Fin HS) ≠ qO by decide)]; exact g0
    have s2 := Sp.pop s g1 (i := 0) (B := w) (by decide) g10 ha
    refine (FSp.of_norep rfl (s1.seq s2)).mono ?_ |>.congr ?_
    · simp only [quoE, Ex.size]; nlinarith
    · congr 1; funext x
      simp only [g1, g, F, Function.update_apply]
      by_cases e1 : x = 0
      · subst e1; simp +decide
      by_cases e2 : x = qO
      · subst e2
        have ht : L.take (k + 1) = L.take k ++ [a] := (List.take_concat_get' L k hkL).symm
        simp [ht, show (qO : Fin HS) ≠ 0 by decide, show (qO : Fin HS) ≠ NLogN.KFB.c1 by decide]
      simp [e1, e2]

theorem truncP_fsp (s : IState HS) (Δ w : ℕ) (f : Fin HS → List ℤ) (L l : List ℤ)
    (h0 : f 0 = L ++ l) (hC : Cl f) (hb : Bnd w L) (Z : ℕ) (hZ : zsz (L.length : ℤ) ≤ Z) :
    FSp (truncP Δ L.length) (encK s f)
      (encK s (Function.update f 0 ((L.map fun a => a.tdiv (2 ^ Δ)) ++ l)))
      (cTrunc w Δ L.length Z) := by
  have p1 := Sp.push s f (i := rN) (e := .lit (L.length : ℤ)) (B := Z) (by decide) (clean_lit _)
    trivial trivial hZ
  rw [show Ex.eval (encK s f) (.lit (L.length : ℤ)) :: f rN = [(L.length : ℤ)] by
    simp [Ex.eval, hC.rn]] at p1
  set f1 := Function.update f rN [(L.length : ℤ)]
  have t1 := truncLoop_fsp s Δ w f1 L l (by simp +decide [f1, h0]) (by simp +decide [f1, hC.scr.o])
    (by simp +decide [f1, hC.scr.c]) (Lr := s.G rN) (by simp +decide [f1, ints]) hb
  set f2 := Function.update (Function.update f1 0 l) qO (L.map fun a => a.tdiv (2 ^ Δ)).reverse
  have m1 := FSp.mvN (X := qO) (Y := 0) (C := NLogN.KFB.c1) (r := rN) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f2 (L.map fun a => a.tdiv (2 ^ Δ)).reverse []
    (by simp [f2]) (Lr := s.G rN) (by simp +decide [f2, f1, ints]) w
    (fun x hx => by
      obtain ⟨y, hy, rfl⟩ := List.mem_map.1 (List.mem_reverse.1 hx)
      exact (zsz_tdiv_le _ _).trans (hb y hy))
  set f3 := Function.update (Function.update f2 qO []) 0
    ((L.map fun a => a.tdiv (2 ^ Δ)).reverse.reverse ++ f2 0)
  have o1 := Sp.pop s f3 (i := rN) (a := (L.length : ℤ)) (l := []) (B := Z) (by decide)
    (by simp +decide [f3, f2, f1]) hZ
  refine ((FSp.of_norep rfl p1).seq (t1.seq (m1.seq (FSp.of_norep rfl o1)))).mono ?_ |>.congr ?_
  · simp only [Ex.size, List.length_reverse, List.length_map, cTrunc]; omega
  · congr 1; funext x
    simp only [f3, f2, f1, Function.update_apply, List.reverse_reverse]
    by_cases e0 : x = 0
    · subst e0; simp +decide
    by_cases e1 : x = qO
    · subst e1; simp +decide [hC.scr.o]
    by_cases e2 : x = rN
    · subst e2; simp +decide [hC.rn]
    simp [e0, e1, e2]

end NLogN.KFH

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFH
open IntMul RS AModel KIL KFD KFB Complex
theorem solution (s : NLogN.IState NLogN.HS) {r p Δ w : ℕ} (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI)
    (xs : List (Fin r → ℂ)) (l : List ℤ) (hx : NLogN.KFH.RecRep r (p + Δ) zs xs)
    (h0 : f 0 = NLogN.KFB.gflat zs ++ l) (hC : NLogN.KFB.Cl f) (hb : NLogN.KFB.GB w zs) (Z : ℕ)
    (hZ : NLogN.zsz ((2 * zs.length : ℕ) : ℤ) ≤ Z) :
    NLogN.KFH.RecRep r p (zs.map (NLogN.KFH.gtr Δ)) (Butterfly.QpArr p xs) ∧ NLogN.KFB.GB w (zs.map (NLogN.KFH.gtr Δ)) ∧
      NLogN.KFD.FSp (NLogN.KFH.truncP Δ (2 * zs.length)) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat (zs.map (NLogN.KFH.gtr Δ)) ++ l)))
        (NLogN.KFH.cTrunc w Δ (2 * zs.length) Z) := by
  refine ⟨NLogN.KFH.truncP_rep hx, NLogN.KFH.GB_map_gtr hb, ?_⟩
  have H := NLogN.KFH.truncP_fsp s Δ w f (NLogN.KFB.gflat zs) l h0 hC hb.bnd Z (by simpa using hZ)
  rw [NLogN.KFB.length_gflat, ← NLogN.KFH.gflat_map_gtr] at H
  exact H
end
