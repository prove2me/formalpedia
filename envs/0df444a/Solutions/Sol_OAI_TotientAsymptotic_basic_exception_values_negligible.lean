  have hh := (((tendsto_const_nhds : Tendsto (fun _ : ℕ => (1 : ℝ)) atTop (nhds 1)).add hb).mul he).mul hp
  change Tendsto (fun H => (1+bandPrimeError C (9/10) (P H))*
    Real.exp (simplexBoxTail 4 (P H))*projectedEnvelope K (P H)) atTop (nhds 0)
