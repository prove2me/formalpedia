-- title:
--   Proposition 4.4, (14), p. 16 — under (6), with probability → 1 every good permutation has overlap > α with π*
-- statement:
--   Let $0 < \alpha < 1$, $\beta > 0$, $\gamma > 0$, and let $q = q_n$, $s = s_n$ satisfy $0 \le q_n < s_n \le 1$ for every $n$ and, for all large enough $n$, conditions (6):
--   $$nqs \ge \max\Big\{20,\ 84\log\frac{2}{1-\alpha},\ \frac{16}{\min(\gamma,\beta)(1-\alpha)}\Big\},\quad s > \frac{8}{1-\alpha}\,q,\quad \frac{2q(1-s^2)}{s} \le n^{-\beta},\quad qs \le n^{-2\gamma}.$$
--   Let $(A,B)$ be generated by the correlated Erdős–Rényi model $(n, q_n, s_n)$ with planted permutation $\pi^*_n$. Then
--   $$\mathbb P\big(\forall \pi,\ [\pi \text{ good} \Rightarrow \beta(\pi,\pi^*_n) > \alpha]\big) \longrightarrow 1 \qquad (n\to\infty). \quad (14)$$
--
--   Together with Proposition 4.2 it shows that any good permutation returned by the enumeration algorithm recovers more than a fraction $\alpha$ of the alignment.
--
--   **Formalization Note** "Good" is Definition 2 with the same $\alpha$, $q_n$, $s_n$, evaluated on the observed pair $(A,B)$; $\pi$ ranges over all permutations of $\{1,\dots,n\}$. The statement holds for every sequence of planted permutations. The inequality $\beta(\pi,\pi^*) > \alpha$ is strict, as in (14).
-- source:
--   Hall, Massoulié, Partial Recovery in the Graph Alignment Problem, arXiv:2007.00533v5, p. 16, Proposition 4.4, (14); conditions (6), p. 8

import Mathlib
import Definitions.Def_GraphAlignment_Possible_Setting

namespace GraphAlignment.Possible

open Filter Topology

theorem proposition_4_4 (α βe γe : ℝ) (hα : 0 < α ∧ α < 1) (hβe : 0 < βe) (hγe : 0 < γe)
    (q s : ℕ → ℝ) (hqs : ∀ n, 0 ≤ q n ∧ q n < s n ∧ s n ≤ 1)
    (h6 : ∀ᶠ n : ℕ in atTop, Cond6 α βe γe n (q n) (s n))
    (πstar : ∀ n : ℕ, Equiv.Perm (Fin n)) :
    Tendsto (fun n : ℕ => prob (q n) (s n)
        (fun ω : Config n => ∀ π : Equiv.Perm (Fin n),
          good n (q n) (s n) α (A ω) (B (πstar n) ω) π → α < overlap π (πstar n)))
      atTop (𝓝 1) := by sorry

end GraphAlignment.Possible
