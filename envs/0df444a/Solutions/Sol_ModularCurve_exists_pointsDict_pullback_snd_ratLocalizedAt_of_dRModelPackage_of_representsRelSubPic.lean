      (eQ : pullback P.c (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ) ≅ pullback (DRModel.toBase p) (specMap ℤ ℚ))
      (heQ : eQ.hom ≫ pullback.snd _ _ = pullback.snd _ _) (heQ' : eQ.inv ≫ pullback.snd _ _ = pullback.snd _ _)
      (heQ₀ : P.e₀ ≫ eQ.hom = e36.hom ≫ 𝔛.e₀)
      (hQ : RepresentsRelSubPic (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε)
        (algEquivZeroCut (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε)) (P.D.baseChange ℚ))
      (θQ : SchemeHomOver (P.D.baseChange ℚ).toBase (D.baseChange ℚ).toBase)
      (θ : SchemeHomOver P.D.toBase (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))))
      (θ' : SchemeHomOver (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))) P.D.toBase),
      Nonempty (hQ.poincare.L ≅ (BaseChange.ofR P.c P.ε ℚ
        (P.hD.poincare.pullbackAlong ⟨pullback.fst P.D.toBase (specMap ↥(GaloisRep.ratLocalizedAt ℓ) ℚ), pullback.condition⟩)).L) ∧
      (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of ℚ))
        (M : RigidifiedLineBundle (baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ) (sectionBaseChange ℚ P.ε) t) (hM : FibrewiseAlgEquivZero M)
        (N : RigidifiedLineBundle (baseChange ℤ (DRModel.toBase p) ℚ) (sectionBaseChange ℚ 𝔛.εinf) t) (hN : FibrewiseAlgEquivZero N)
        (Q : T.Modules), Scheme.Modules.IsInvertible Q →
        Nonempty (N.L ≅ (Scheme.Modules.pullback (curveChange (c := baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c ℚ)
            (c' := baseChange ℤ (DRModel.toBase p) ℚ) eQ.inv heQ' t)).obj M.L ⊗
          (Scheme.Modules.pullback (pullback.snd (baseChange ℤ (DRModel.toBase p) ℚ) t)).obj Q) →
        postComp θQ (hQ.classify t M hM) = h'.classify t N hN) ∧
      θ.1 ≫ θ'.1 = 𝟙 _ ∧ θ'.1 ≫ θ.1 = 𝟙 _ ∧
      (genericFibreRestrict ↥(GaloisRep.ratLocalizedAt ℓ) ℚ (pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ)))))
          P.D.toBase θ).1 = θQ.1 ≫ (pasteIso D (ℓ := ℓ)).inv := by
  haveI : IsDiscreteValuationRing ↥(GaloisRep.ratLocalizedAt ℓ) := GaloisRep.isDiscreteValuationRing_ratLocalizedAt ℓ Fact.out
  haveI : IsFractionRing ↥(GaloisRep.ratLocalizedAt ℓ) ℚ := GaloisRep.isFractionRing_ratLocalizedAt ℓ
  obtain ⟨e36, he36, hplace36, eQ, heQ, heQ', heQ₀⟩ := exists_curveIsoQ 𝔛 P
  obtain ⟨hQ, hPQ⟩ := AlgebraicGeometry.RelPicard.exists_representsRelSubPic_baseChange ↥(GaloisRep.ratLocalizedAt ℓ) P.c P.ε P.D P.hD ℚ
  obtain ⟨θQ, θQ', h1, h2, hθQ⟩ :=
    AlgebraicGeometry.RelPicard.RepresentsRelSubPic.exists_inverse_pair_of_iso_of_sections
      (sectionBaseChange ℚ P.ε) (sectionBaseChange ℚ 𝔛.εinf) eQ heQ heQ' hQ h'

  let gR := pullback.snd D.toBase (Spec.map (CommRingCat.ofHom (algebraMap ℤ ↥(GaloisRep.ratLocalizedAt ℓ))))
  let φK : SchemeHomOver (pullback.snd P.D.toBase (specGenericFibreInclusion ↥(GaloisRep.ratLocalizedAt ℓ) ℚ))
      (pullback.snd gR (specGenericFibreInclusion ↥(GaloisRep.ratLocalizedAt ℓ) ℚ)) :=
    ⟨θQ.1 ≫ (pasteIso D (ℓ := ℓ)).inv, by
      rw [Category.assoc]
      erw [pasteIso_inv_snd D (ℓ := ℓ)]
      exact θQ.2⟩
  let ψK : SchemeHomOver (pullback.snd gR (specGenericFibreInclusion ↥(GaloisRep.ratLocalizedAt ℓ) ℚ))
      (pullback.snd P.D.toBase (specGenericFibreInclusion ↥(GaloisRep.ratLocalizedAt ℓ) ℚ)) :=
    ⟨(pasteIso D (ℓ := ℓ)).hom ≫ θQ'.1, by
      show ((pasteIso D (ℓ := ℓ)).hom ≫ θQ'.1) ≫ (P.D.baseChange ℚ).toBase = _
      rw [Category.assoc, θQ'.2]
      exact pasteIso_hom_toBase D (ℓ := ℓ)⟩
  have hφψ : φK.1 ≫ ψK.1 = 𝟙 _ := by
    show (θQ.1 ≫ (pasteIso D (ℓ := ℓ)).inv) ≫ (pasteIso D (ℓ := ℓ)).hom ≫ θQ'.1 = 𝟙 _
    rw [Category.assoc, Iso.inv_hom_id_assoc, h1]
  have hψφ : ψK.1 ≫ φK.1 = 𝟙 _ := by
    show ((pasteIso D (ℓ := ℓ)).hom ≫ θQ'.1) ≫ θQ.1 ≫ (pasteIso D (ℓ := ℓ)).inv = 𝟙 _
    rw [Category.assoc, reassoc_of% h2, Iso.hom_inv_id]
  obtain ⟨θ, θ', hθK, -, hθθ', hθ'θ, -⟩ :=
    GoodReductionJacobian.exists_schemeHomOver_inverse_of_abelianSchemePropertyBundle_of_genericFibre
      ↥(GaloisRep.ratLocalizedAt ℓ) ℚ P.bundle hbundle φK ψK hφψ hψφ
  exact ⟨e36, he36, hplace36, eQ, heQ, heQ', heQ₀, hQ, θQ, θ, θ', hPQ, hθQ, hθθ', hθ'θ, congrArg Subtype.val hθK⟩

