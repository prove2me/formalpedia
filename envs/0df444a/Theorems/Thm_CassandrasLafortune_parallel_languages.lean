-- title:
--   Generated and marked languages of parallel composition
-- statement:
--   A global word is generated by the parallel composition exactly when both projections are locally generated. It is marked exactly when both projections are locally marked.
-- source:
--   C. G. Cassandras and S. Lafortune, Introduction to Discrete Event Systems, 2nd ed. (Springer, 2008), ch. 2, §2.3.2, Composition Operations, parallel composition. https://doi.org/10.1007/978-0-387-68612-7_2 Lean proof https://github.com/kmehltretter82/linux-rv-lean/blob/d516e69a81f09c0a017196ea954e4676316cfa3f/LinuxRV/Parallel.lean#L60

import Definitions.Def_CassandrasLafortune_Parallel
open RamadgeWonham.Shared

namespace CassandrasLafortune
variable {A B C : Type}
theorem parallel_languages (G : Generator (A ⊕ C)) (H : Generator (B ⊕ C))
    (w : List (Event A B C)) :
    (w ∈ (parallel G H).L ↔ w.filterMap Event.left ∈ G.L ∧ w.filterMap Event.right ∈ H.L) ∧
    (w ∈ (parallel G H).Lm ↔ w.filterMap Event.left ∈ G.Lm ∧ w.filterMap Event.right ∈ H.Lm) := by sorry
end CassandrasLafortune
