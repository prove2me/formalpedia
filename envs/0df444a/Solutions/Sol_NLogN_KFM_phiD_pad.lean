-- Source module: Solutions.ResampleCRT
/-!
# §9.3 An explicit cyclic-convolution layout

* `Phi`: `ℤ/S → ∏ ℤ/s_i`, `k ↦ (μ_i k)_i` (the coordinate map of `x ↦ ∏ x_i^{μ_i}`), an additive
  equivalence for pairwise coprime `s_i` and units `μ_i` (`PhiEquiv`); every additive
  equivalence carries cyclic convolution to cyclic convolution (`conv_addEquiv`), so
  `Φ(u ∗ v) = Φu ∗ Φv` (`Phi_conv`).
* Mixed radix: `k mod P_i = Σ_{j<i} a_j P_j` (`mod_prefix_eq_sum`) and the coordinate formula
  (42): `μ_i k ≡ a_i + μ_i Σ_{j<i} a_j P_j (mod s_i)` (`coord_formula`).
* Triangular realization: the prefix-controlled cyclic shifts, processed for `i = d-1, …, 0`,
  send every valid address `a` to `b` of (42) (`shifts_realize`); each shift is a bijection of
  the padded box preserving the valid set `V` and its complement (`upd_inv`, `upd_valid`,
  `upd_invalid`).
-/

open Finset

namespace IntMul.OpenAI.RCRT

/-! ### Convolution is preserved by additive equivalences -/

/-! ### The map `Φ` -/

variable {d : ℕ}

lemma PhiEquiv_apply (s : Fin d → ℕ) [∀ i, NeZero (s i)]
    (hcop : Pairwise (Function.onFun Nat.Coprime s)) (μ : Fin d → ℕ)
    (hμ : ∀ i, Nat.Coprime (μ i) (s i)) (k : ZMod (∏ i, s i)) :
    PhiEquiv s hcop μ hμ k = Phi s μ k := by
  ext i
  simp only [PhiEquiv, Phi, AddEquiv.trans_apply, RingEquiv.toAddEquiv_eq_coe,
    RingEquiv.coe_toAddEquiv, AddEquiv.piCongrRight_apply, AddEquiv.coe_mk, Equiv.coe_fn_mk]
  rw [ZMod.prodEquivPi_apply]

/-! ### Mixed radix and the coordinate formula (42) -/

lemma mod_prefix_eq_sum (s : ℕ → ℕ) (k : ℕ) :
    ∀ i, k % Ppre s i = ∑ j ∈ range i, digit s k j * Ppre s j
  | 0 => by simp [Ppre, Nat.mod_one]
  | i + 1 => by
    rw [Finset.sum_range_succ, ← mod_prefix_eq_sum s k i]
    have : Ppre s (i + 1) = Ppre s i * s i := by simp [Ppre, Finset.prod_range_succ]
    rw [this, Nat.mod_mul, digit]; ring

/-- `k = Σ_j a_j P_j` once `k < P_d`. -/
lemma mixed_radix (s : ℕ → ℕ) (k i : ℕ) (hk : k < Ppre s i) :
    k = ∑ j ∈ range i, digit s k j * Ppre s j := by
  rw [← mod_prefix_eq_sum, Nat.mod_eq_of_lt hk]

/-- **(42)**: if `μ_i P_i ≡ 1 (mod s_i)` then
`μ_i k ≡ a_i + μ_i Σ_{j<i} a_j P_j (mod s_i)`. -/
theorem coord_formula (s : ℕ → ℕ) (μ : ℕ → ℕ) (i k : ℕ)
    (hμ : ((μ i * Ppre s i : ℕ) : ZMod (s i)) = 1) :
    ((μ i * k : ℕ) : ZMod (s i)) =
      ((digit s k i + μ i * ∑ j ∈ range i, digit s k j * Ppre s j : ℕ) : ZMod (s i)) := by
  rw [← mod_prefix_eq_sum]
  have h1 : k = k % Ppre s i + Ppre s i * (k / Ppre s i) := (Nat.mod_add_div k _).symm
  have h2 : ((k / Ppre s i : ℕ) : ZMod (s i)) = ((digit s k i : ℕ) : ZMod (s i)) := by
    rw [digit, ZMod.natCast_mod]
  conv_lhs => rw [h1]
  push_cast at hμ ⊢
  rw [h2]
  linear_combination (digit s k i : ZMod (s i)) * hμ

/-! ### Realization by prefix-controlled cyclic shifts -/

section shifts
variable (s μ : ℕ → ℕ)

lemma offset_update (x : ℕ → ℕ) (i v : ℕ) : offset s μ (Function.update x i v) i = offset s μ x i := by
  unfold offset
  congr 1
  refine Finset.sum_congr rfl (fun j hj => ?_)
  rw [Function.update_of_ne (by simp at hj; omega)]

lemma valid_update (x : ℕ → ℕ) (i v : ℕ) (hx : validUpTo s x i) (hv : v < s i) :
    validUpTo s (Function.update x i v) i := by
  intro j hj
  rcases eq_or_ne j i with rfl | hne
  · simpa using hv
  · rw [Function.update_of_ne hne]; exact hx j hj

lemma mod_sub_cancel (x o m : ℕ) (hx : x < m) : ((x + o) % m + (m - o % m)) % m = x := by
  have hm : 0 < m := by omega
  have : NeZero m := ⟨by omega⟩
  have hle : o % m ≤ m := (Nat.mod_lt _ hm).le
  have h : (((x + o) % m + (m - o % m) : ℕ) : ZMod m) = (x : ZMod m) := by
    push_cast [Nat.cast_sub hle]
    rw [ZMod.natCast_mod, ZMod.natCast_mod, ZMod.natCast_self]; push_cast; ring
  have := congrArg ZMod.val h
  rwa [ZMod.val_natCast, ZMod.val_natCast, Nat.mod_eq_of_lt hx] at this

/-- Each prefix-controlled shift is a bijection of the padded box (explicit inverse). -/
theorem upd_inv (i : ℕ) (x : ℕ → ℕ) : updInv s μ i (upd s μ i x) = x := by
  unfold upd
  split_ifs with h
  · have hs : 0 < s i := lt_of_le_of_lt (Nat.zero_le _) (h i le_rfl)
    have hv : (x i + offset s μ x i) % s i < s i := Nat.mod_lt _ hs
    unfold updInv
    rw [if_pos (valid_update s x i _ h hv), offset_update]
    simp only [Function.update_self, Function.update_idem]
    rw [mod_sub_cancel _ _ _ (h i le_rfl)]
    exact Function.update_eq_self i x
  · unfold updInv; rw [if_neg h]

/-- Processing the targets `m, …, m+n-1` in descending order on a valid address updates each of
them from the original lower coordinates. -/
theorem shifts_foldr (d : ℕ) (a : ℕ → ℕ) (ha : ∀ j < d, a j < s j) :
    ∀ n m, m + n ≤ d → (List.range' m n).foldr (upd s μ) a =
      fun j => if m ≤ j ∧ j < m + n then (a j + offset s μ a j) % s j else a j
  | 0, m, _ => by funext j; simp
  | n + 1, m, h => by
    rw [List.range'_succ, List.foldr_cons, shifts_foldr d a ha n (m + 1) (by omega)]
    set y : ℕ → ℕ := fun j => if m + 1 ≤ j ∧ j < m + 1 + n then
      (a j + offset s μ a j) % s j else a j with hy
    have hyl : ∀ j ≤ m, y j = a j := by
      intro j hj; simp only [hy]; rw [if_neg (by omega)]
    have hval : validUpTo s y m := fun j hj => by rw [hyl j hj]; exact ha j (by omega)
    have hoff : offset s μ y m = offset s μ a m := by
      unfold offset; congr 1
      refine Finset.sum_congr rfl (fun j hj => ?_)
      rw [hyl j (by simp at hj; omega)]
    unfold upd
    rw [if_pos hval, hoff, hyl m le_rfl]
    funext j
    rcases eq_or_ne j m with rfl | hne
    · simp
    · rw [Function.update_of_ne hne]; simp only [hy]
      by_cases h1 : m + 1 ≤ j ∧ j < m + 1 + n
      · rw [if_pos h1, if_pos (by omega)]
      · rw [if_neg h1, if_neg (by omega)]

/-- **Triangular realization of `Φ`**: the shifts for `i = d-1, …, 0` send the valid address
`a` to `b_i = (a_i + μ_i Σ_{j<i} a_j P_j) mod s_i` (42). -/
theorem shifts_realize (d : ℕ) (a : ℕ → ℕ) (ha : ∀ j < d, a j < s j) :
    (List.range d).foldr (upd s μ) a =
      fun j => if j < d then (a j + offset s μ a j) % s j else a j := by
  rw [List.range_eq_range', shifts_foldr s μ d a ha d 0 (by omega)]
  funext j; simp

end shifts

end IntMul.OpenAI.RCRT

end

section
-- Source module: Solutions.KFUPhi
/-!
# KFU §8: the programs `Φ` and `Φ⁻¹`

Parameters: `d` axes, sources `s_j = sF j` (`1 ≤ s_j ≤ t_j`), padded sizes
`t_j = tP d h bL j = 2^h · (2 if bL j)`, multipliers `μ j`.  Arrays are integer lists with a
trailing component axis of size `2` (Gaussian records in `gflat` form); the component axis has
index `d`.

* `shK f = ((range d).reverse ++ [d]).map f` (k-order, `x_0` innermost: flat index `2k + c`),
* `shR f = (range d ++ [d]).map f` (reversed order, `x_0` outermost).

`phiC`: pad `S_k → T_k` (one scan per axis), reverse the axes (`revC`: Lemma 12 swaps of the
`2^h`-atoms + single-bit moves), delete the padding `T_r → S_r`, run the `d` prefix-controlled
shifts `i = d-1, …, 0` (`rotStep`: offset table `Σ_{j<i} (μ_i P_j mod s_i) x_j mod s_i`), pad
`S_r → T_r`.  `phi_spec`: the result is `PhiD xs`.

`phiInvC`: the inverse (delete padding, inverse shifts `i = 0, …, d-1`, pad, reverse back,
delete padding).  `phiInv_spec`: the result is `PhiInvD ys`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFU

open IntMul KFC AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Generic shape lemmas -/

theorem forall₂_map_le {L : List ℕ} {f g : ℕ → ℕ} (h : ∀ j ∈ L, f j ≤ g j) :
    List.Forall₂ (· ≤ ·) (L.map f) (L.map g) := by
  induction L with
  | nil => exact .nil
  | cons a L ih =>
    exact .cons (h a (by simp)) (ih (fun j hj => h j (by simp [hj])))

theorem vol_rangeMap (f : ℕ → ℕ) : ∀ i, vol ((List.range i).map f) = ∏ j ∈ Finset.range i, f j
  | 0 => by simp [vol]
  | i + 1 => by
    rw [List.range_succ, List.map_append, vol_append, vol_rangeMap f i, Finset.prod_range_succ]
    simp [vol]

/-! ## Parameters and shapes -/

theorem tP_eq (d h : ℕ) (bL : ℕ → Bool) (j : ℕ) :
    tP d h bL j = if j < d then (if bL j then 2 ^ h * 2 else 2 ^ h) else 2 := by
  unfold tP tz mzP bgP; by_cases hj : j < d <;> simp [hj]

theorem shR_split (d : ℕ) (sF : ℕ → ℕ) {i : ℕ} (hi : i < d) :
    shR d (sP d sF) = (List.range i).map sF ++ sF i ::
      (((List.range d).drop (i + 1) ++ [d]).map (sP d sF)) := by
  have e : List.range d = List.range i ++ i :: (List.range d).drop (i + 1) := by
    conv_lhs => rw [← List.take_append_drop i (List.range d)]
    rw [List.take_range, min_eq_left hi.le, List.drop_eq_getElem_cons (by simpa using hi),
      List.getElem_range]
  unfold shR
  conv_lhs => rw [e]
  simp only [List.append_assoc, List.cons_append, List.map_append, List.map_cons]
  congr 1
  · apply List.map_congr_left; intro j hj; simp at hj; simp [sP, show j < d by omega]
  · simp [sP, hi]

/-! ## The shifts -/

theorem valid_rotG {A C : Shape} {Q : ℕ} (hQ : 1 ≤ Q) (f : List ℕ → ℕ) {b : List ℕ}
    (hb : Valid (A ++ Q :: C) b) : Valid (A ++ Q :: C) (rotG A.length Q f b) := by
  have hl : (b.take A.length).length = A.length := by
    have := hb.length_eq; simp at this ⊢; omega
  rw [← List.take_append_drop A.length b] at hb
  obtain ⟨h1, h2⟩ := (KIL.valid_append_iff hl).1 hb
  obtain ⟨y, rest, hd⟩ : ∃ y rest, b.drop A.length = y :: rest := by
    cases e : b.drop A.length with
    | nil => rw [e] at h2; cases h2
    | cons y rest => exact ⟨y, rest, rfl⟩
  rw [hd] at h2
  have hr : b.drop (A.length + 1) = rest := by
    rw [← List.drop_drop, hd]; rfl
  unfold rotG
  rw [hr]
  exact valid_append h1 (.cons (Nat.mod_lt _ (by omega)) (by cases h2; assumption))

theorem valid_gRot (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (cs : ℕ → List ℕ) {i : ℕ}
    (hi : i < d) {b : List ℕ} (hb : Valid (shR d (sP d sF)) b) :
    Valid (shR d (sP d sF)) (gRot sF cs i b) := by
  rw [shR_split d sF hi] at hb ⊢
  have := valid_rotG (A := (List.range i).map sF) (hs i hi) (fun a => KIL.lf (cs i) a % sF i) hb
  simpa [gRot] using this

theorem valid_Gf (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (cs : ℕ → List ℕ) :
    ∀ k ≤ d, ∀ b, Valid (shR d (sP d sF)) b → Valid (shR d (sP d sF)) (Gf sF cs k b)
  | 0, _, b, hb => hb
  | k + 1, hk, b, hb => valid_gRot d sF hs cs (by omega) (valid_Gf d sF hs cs k (by omega) b hb)

end NLogN.KFU

end

section
-- Source module: Solutions.KFUPhiRun
/-!
# KFU §9: the runs of `Φ` and `Φ⁻¹`

`phiC` (stack `0`: `ints xs ++ R`, `xs` on `S_k = shK (sP)`):
1. pad `S_k → T_k` (`d+1` scans),
2. reverse the axes on `T_k → T_r` (`revC`, Lemma 12 swaps + bit moves),
3. delete the padding `T_r → S_r`,
4. the shifts `i = d-1, …, 0` (forward coefficients `csF`),
5. pad `S_r → T_r`.

Result `PhiD xs = embed S_r T_r (pull S_r S_r (Gf d) (pull S_k S_r (revH d) xs))` (steps 1–3
collapse by `extract_pull_embed'`).  `phiInvC` runs the inverse chain; result
`PhiInvD ys = pull S_r S_k (revH d) (pull S_r S_r (Gb d) (extract S_r T_r ys))`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

