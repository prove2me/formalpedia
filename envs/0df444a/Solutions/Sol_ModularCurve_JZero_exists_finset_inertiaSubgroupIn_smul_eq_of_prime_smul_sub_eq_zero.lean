theorem solution (N : ℕ) [NeZero N] :
    ∃ S : Finset ℕ, ∀ ℓ : ℕ, ℓ.Prime → ℓ ∉ S →
      ∀ A : ValuationSubring (AlgebraicClosure ℚ), A.LiesOverPrime ℓ →
        ∀ σ ∈ A.inertiaSubgroupIn ℚ, ∀ p : ℕ, p.Prime → p ≠ ℓ →
          ∀ y : JZero N, p • (σ • y - y) = 0 → σ • y = y := by
  refine ⟨N.primeFactors, fun ℓ hℓ hℓS A hA σ hσ p hp hpℓ y hy => ?_⟩
  have hℓN : ¬ ℓ ∣ N := fun hdvd => hℓS (Nat.mem_primeFactors.mpr ⟨hℓ, hdvd, NeZero.ne N⟩)
