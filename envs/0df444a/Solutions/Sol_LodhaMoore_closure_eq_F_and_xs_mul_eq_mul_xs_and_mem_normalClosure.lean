theorem solution (g : SeqGroup) (_hg : g ∈ F)
    (s t : Seq) (h : FinAct g s t) :
    Subgroup.closure ({xs [], xs [true]} : Set SeqGroup) = F ∧ xs s * g = g * xs t ∧
    ∀ wg ws wt : FreeGroup Bool,
      FreeGroup.lift (fun d : Bool => if d then xs [true] else xs []) wg = g →
      FreeGroup.lift (fun d : Bool => if d then xs [true] else xs []) ws = xs s →
      FreeGroup.lift (fun d : Bool => if d then xs [true] else xs []) wt = xs t →
      FreeGroup.map (fun d : Bool => if d then [true] else []) (ws * wg * (wg * wt)⁻¹) ∈
        Subgroup.normalClosure RX := by
  refine ⟨closure_eq_F, xs_mul_eq h, ?_⟩
  intro wg ws wt hwg hws hwt
  obtain ⟨⟨phi, hphi, hinj, -⟩, -⟩ := exists_presentation_F_and_mulEquiv_F2
  rw [← PresentedGroup.mk_eq_one_iff]
  apply hinj
  rw [map_one]
  have hcomp : phi.comp (PresentedGroup.mk RX) = FreeGroup.lift xs := by
    ext s; exact hphi s
  have e1 : phi (PresentedGroup.mk RX (FreeGroup.map (fun d : Bool => if d then [true] else [])
      (ws * wg * (wg * wt)⁻¹))) = FreeGroup.lift xs (FreeGroup.map
        (fun d : Bool => if d then [true] else []) (ws * wg * (wg * wt)⁻¹)) :=
    congrArg (fun φ : FreeGroup Seq →* SeqGroup => φ _) hcomp
  rw [e1, lift_map_eq]
  have e2 : (xs ∘ fun d : Bool => if d then [true] else []) =
      fun d : Bool => if d then xs [true] else xs [] := by
    funext d; cases d <;> rfl
  rw [e2, map_mul, map_mul, map_inv, map_mul, hwg, hws, hwt, xs_mul_eq h, mul_inv_cancel]
