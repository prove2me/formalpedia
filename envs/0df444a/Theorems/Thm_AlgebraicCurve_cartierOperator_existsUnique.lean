-- title:
--   Existence and uniqueness of the Cartier operator on Ω¹_{F/K}
-- statement:
--   Let $K$ and $F$ be fields with $F$ a $K$-algebra satisfying the project predicate [`AlgebraicCurve.IsCurveOver K F`](def/AlgebraicCurve_IsCurveOver.html#L15), that is: every nonzero $f \in F$ admits a divisor $D$ on the set of places of $F/K$ (valuation subrings of $F$ containing the image of $K$, proper in $F$ and principal) whose value at each place $v$ is $v.\mathrm{ord}(f)$ and whose degree is $0$; each place has residue field finite over $K$; and $\Omega^1_{F/K} =$ `Ω[F⁄K]` is free of rank one over $F$. Let $p$ be a prime, assume $K$ has characteristic $p$ and is perfect, and let $x \in F$ be such that $F$ is finite-dimensional over the intermediate field $K(x)$ generated by $x$. The assertion is that there is exactly one additive map $C : \Omega^1_{F/K} \to \Omega^1_{F/K}$ (a homomorphism of additive monoids, no $F$-linearity assumed) such that $C(f^p \cdot \omega) = f \cdot C(\omega)$ for all $f \in F$ and all $\omega \in \Omega^1_{F/K}$, such that $C(df) = 0$ for all $f \in F$, and such that $C(f^{p-1} \cdot df) = df$ for all $f \in F$, where $d$ denotes the universal derivation `KaehlerDifferential.D K F`.
--
--   This is the coordinate-free characterisation of the Cartier operator on the differentials of a one-variable function field in characteristic $p$: $p^{-1}$-semilinearity, annihilation of exact differentials, and the normalisation $f^{p-1}\,df \mapsto df$ determine it uniquely. It is used in the project to bound the $p$-torsion of the divisor class group and to identify operators satisfying the same three laws with the coordinate construction, and thence in the work on differentials on modular curves.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicCurve_cartierOperator_existsUnique.lean

import Definitions.Def_AlgebraicCurve_IsCurveOver

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u v

theorem AlgebraicCurve.cartierOperator_existsUnique {K : Type u} {F : Type v} [Field K] [Field F]
    [Algebra K F] [AlgebraicCurve.IsCurveOver K F] (p : ℕ) [Fact p.Prime] [CharP K p]
    [PerfectField K] (x : F) [FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F] :
    ∃! C : Ω[F⁄K] →+ Ω[F⁄K],
      (∀ (f : F) (ω : Ω[F⁄K]), C (f ^ p • ω) = f • C ω) ∧
      (∀ f : F, C (KaehlerDifferential.D K F f) = 0) ∧
      (∀ f : F, C (f ^ (p - 1) • KaehlerDifferential.D K F f) = KaehlerDifferential.D K F f) := by sorry
