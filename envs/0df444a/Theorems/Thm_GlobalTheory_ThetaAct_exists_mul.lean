theorem GlobalTheory.ThetaAct.exists_mul (hL : L.IsLB) (θx θy : ThetaGrp A L k T) :
    ∃ θ : ThetaGrp A L k T, θ.pt = θy.pt * θx.pt ∧ ∀ (Z : Scheme.{0}) (r : Z ⟶ (T ⊗ A).left) (z : Z) (J),
