                exactReverseLeftSide_coordinate_mem seed⟩)
        rw [exactReverseAliceContext_prefix_before_marked]
        exact j.property
      have hparts :=
        (exactOrderedSidePrefix_mem_iff
          side context.sideRank marker.castSucc j.val).mp
