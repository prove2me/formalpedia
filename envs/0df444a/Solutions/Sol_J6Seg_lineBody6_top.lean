-- Source module: Solutions.J6LineTop4
/-!
# `LineNeed6` top level, part 4: **`lineBody6_top`** and **`lineNeed6_of`**

One extension table holds the A-line table of `AIL6s` (relabelled, `g4₁`) and the machine's own
procedures (`ownL`): the per-axis family `U` of `AxisU6` and, last, the sweep
`swp (sgm dS dA) dS dA (idx eX)` (`J6SegILSweep9`) on the descriptor stack `dS` of `AIL6s`.

* the `A` clause: the relabelled run of `AIL6s` and `aLine_math`;
* the `B` clause: `sweep_run` with the invariant "length `∏ t` and `DiscL p`" (`PipeDisc6`),
  `r6_machine` (the sweep computes `tensorGo (mapsLine6 …)`) and `r6_passB`; the cost is
  `(C_X + 10^12) cU6` (`sweep_cost_le`).

**`lineNeed6_of`**: `AIL6s`, `AxisU6` (under the table facts of `LineNeed6`) and `PipeDisc6` give
`∀ P, P.Ok → LineNeed6 P`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Complex

noncomputable section

namespace J6Seg
open IntMul IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf NLogN.KFM NLogN.KFY IntMul.OpenAI.RT
open NLogN NLogN.KIL NLogN.KFB AModel
open IntMul.Kappa.R6
open NLogN.KFB (GI gflat)

theorem extL_idx {EA nU : ℕ} (tab : Fin 1 → IStmt HS 1) (extA : Fin EA → IStmt HS (7 + EA))
    (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
    (body : IStmt HS (7 + (EA + 0 + 0 + 0 + (nU + 1)))) (i : Fin nU) :
    IL.kTableP tab (extL extA U body) (idxL EA nU i) = U _ (idxL EA nU) i := by
  unfold extL
  refine (mTab4_own tab extA ext0 ext0 ext0 (ownL U (idxL EA nU) body) (Fin.castSucc i)).trans ?_
  unfold ownL
  rw [dif_pos (by simp)]
  rfl

theorem extL_body {EA nU : ℕ} (tab : Fin 1 → IStmt HS 1) (extA : Fin EA → IStmt HS (7 + EA))
    (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
    (body : IStmt HS (7 + (EA + 0 + 0 + 0 + (nU + 1)))) :
    IL.kTableP tab (extL extA U body) (gO4 EA 0 0 0 (nU + 1) (Fin.last nU)) = body := by
  unfold extL
  refine (mTab4_own tab extA ext0 ext0 ext0 (ownL U (idxL EA nU) body) (Fin.last nU)).trans ?_
  unfold ownL
  rw [dif_neg (by simp)]

theorem extL_A {EA nU : ℕ} (tab : Fin 1 → IStmt HS 1) (extA : Fin EA → IStmt HS (7 + EA))
    (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
    (body : IStmt HS (7 + (EA + 0 + 0 + 0 + (nU + 1)))) (j : Fin (7 + EA)) :
    IL.kTableP tab (extL extA U body) (g4₁ EA 0 0 0 (nU + 1) j) =
      (IL.kTableP tab extA j).ren id (g4₁ EA 0 0 0 (nU + 1)) :=
  mTab4_g1 tab extA ext0 ext0 ext0 (ownL U (idxL EA nU) body) j

set_option maxHeartbeats 1000000 in
/-- **`LineBody6` from the remaining pieces.** -/
theorem lineBody6_top_sol_aux (P : Prm) (hP : P.Ok) (tab : Fin 1 → IStmt HS 1) (hA : AIL6s P tab)
    (hX : AxisU6 P tab) (hDisc : PipeDisc6 P) : LineBody6 P tab := by
  obtain ⟨EA, extA, eA, dS, CA, AA, nA, hdS0, hdS56, hCA, HA⟩ := hA
  obtain ⟨nU, U, eX, dA, CX, AX, nX, hdA, hCX, HX⟩ := hX
  obtain ⟨nD, HD⟩ := hDisc
  obtain ⟨nM, hm⟩ := r6_machine P hP
  obtain ⟨n₂, hpass⟩ := r6_passB P hP
  obtain ⟨n₃, hfit⟩ := r6_fitSpec P hP
  obtain ⟨nQ, hq⟩ := qok_of P hP
  obtain ⟨nAm, ham⟩ := aLine_math P hP
  have hW := sgm_ok dS dA hdS0 hdS56 hdA
  set σ := sgm dS dA with hσ
  set E := EA + 0 + 0 + 0 + (nU + 1) with hE
  set idx := idxL EA nU with hidxd
  set body : IStmt HS (7 + E) := swp σ dS dA (idx eX) with hbody
  set ext := extL extA U body with hext
  have hidx : ∀ i, IL.kTableP tab ext (idx i) = U E idx i := extL_idx tab extA U body
  have hbd : IL.kTableP tab ext (gO4 EA 0 0 0 (nU + 1) (Fin.last nU)) = body :=
    extL_body tab extA U body
  set C₀ : ℝ := max CA (CX + 10 ^ 12) with hC₀
  set A := max AA AX with hAd
  refine ⟨E, ext, g4₁ EA 0 0 0 (nU + 1) eA, gO4 EA 0 0 0 (nU + 1) (Fin.last nU), dS, C₀, A,
    max nA (max nX (max nD (max nM (max n₂ (max n₃ (max nQ nAm)))))), hdS0,
    le_trans hCA (le_max_left _ _), ?_⟩
  intro n hn src hsrc D hD _ _
  have hnA : nA ≤ n := by omega
  have hnX : nX ≤ n := by omega
  have hnD : nD ≤ n := by omega
  have hnM : nM ≤ n := by omega
  have hn2 : n₂ ≤ n := by omega
  have hn3 : n₃ ≤ n := by omega
  have hnQ : nQ ≤ n := by omega
  have hnAm : nAm ≤ n := by omega
  obtain ⟨M, hM⟩ := hfit n hn3 src hsrc D hD
  have hcU : ∀ A' : ℕ, A' ≤ A → cU6 P n A' ≤ cU6 P n A := fun A' h => cU6_mono P hP n h
  have hcU0 : 0 ≤ cU6 P n A := le_trans (by positivity) (T_le_cU6 P hP n A)
  refine ⟨M, fun Isym s f l hf hdesc => ⟨?_, ?_⟩⟩
  · -- the `A` lines
    intro zs u hzs hrep hu
    obtain ⟨hlen, hGB, r1, r2, r3⟩ := ham n hnAm src hsrc D hD M hM zs u hrep hu
    obtain ⟨c, hc, hcost⟩ := HA n hnA src hsrc D hD Isym s f l hf hdesc zs hzs hlen hGB
    have hc' := IRuns.relabel (iprog' := IL.kTableP tab ext) (g := g4₁ EA 0 0 0 (nU + 1))
      (extL_A tab extA U body) hc
    refine ⟨_, _, c, hc', r1, r2, r3, ?_⟩
    have h1 : CA * cU6 P n AA ≤ C₀ * cU6 P n A :=
      mul_le_mul (le_max_left _ _) (hcU AA (le_max_left _ _))
        (le_trans (by positivity) (T_le_cU6 P hP n AA)) (le_trans hCA (le_max_left _ _))
    linarith
  · -- the `B` lines
    intro ys y hys hrep hy
    have hlen : ys.length = (List.ofFn (tD6 P n D)).prod := hrep.1
    have hdisc : DiscL (pP6 P n) ys := fun z hz => by
      obtain ⟨x, hx, rfl⟩ := List.mem_iff_getElem.1 hz
      have := repFull_disc (pP6 P n) (tD6 P n D) hrep hy x
      rwa [List.getD_eq_getElem _ _ hx] at this
    set Q : List GI → Prop := fun L =>
      L.length = (List.ofFn (tD6 P n D)).prod ∧ DiscL (pP6 P n) L with hQd
    have hQ : ∀ L, Q L → L.length = TW P n D ∧ GB (pP6 P n + 2) L :=
      fun L h => ⟨h.1, GB_of_disc h.2⟩
    have hpipe : ∀ k ≤ D, ∀ L : List GI, Q L → Q (pipe6 P n src D k L) := by
      intro k hk L h
      obtain ⟨e1, e2⟩ := HD n hnD src hsrc D hD k hk L h.1 h.2
      exact ⟨e1.trans h.1, e2⟩
    have hXb := HX n hnX src hsrc D hD E ext idx hidx Isym
    have hQk := hq n hnQ src hsrc
    have hb := swB_of P n src hQk D hD
    have hCx0 : 0 ≤ CX * cU6 P n AX / (D + 1) := by
      have := le_trans (by positivity) (T_le_cU6 P hP n AX)
      positivity
    obtain ⟨c, hc, hcost⟩ := sweep_run hW hXb hCx0 hD (bSw P n) hb Q hQ hpipe s f l hf hdesc
      ys hys ⟨hlen, hdisc⟩
    have hc2 : IRuns Isym (IL.kTableP tab ext) (.call (gO4 EA 0 0 0 (nU + 1) (Fin.last nU)))
        (encK s f) (encK s (Function.update f 0
          (gflat (pipeSweep (pipe6 P n src D) (D + 1) ys) ++ l))) (c + 2) :=
      IRuns.call (by rw [hbd]; exact hc)
    rw [hm n hnM src hsrc D hD ys hlen] at hc2
    obtain ⟨r1, r2, r3⟩ := hpass n hn2 src hsrc D hD M hM ys y hrep hy
    refine ⟨_, _, c + 2, hc2, r1, r2, r3, ?_⟩
    have hsw := sweep_cost_le P hP n src hQk D hD AX
    have hD1 : (0 : ℝ) < (D : ℝ) + 1 := by positivity
    have e : ((D : ℝ) + 1) * (CX * cU6 P n AX / (D + 1)) = CX * cU6 P n AX := by
      field_simp
    have hX1 : (CX + 10 ^ 12) * cU6 P n AX ≤ C₀ * cU6 P n A :=
      mul_le_mul (le_max_right _ _) (hcU AX (le_max_right _ _))
        (le_trans (by positivity) (T_le_cU6 P hP n AX)) (le_trans (by positivity) (le_max_right _ _))
    push_cast
    have : (c : ℝ) + 2 ≤ CX * cU6 P n AX + (10 ^ 9 * ((bSw P n : ℝ) + 2) ^ 2 * (2 * D + 3) + 2) := by
      have := hcost
      nlinarith
    nlinarith

end J6Seg

end

