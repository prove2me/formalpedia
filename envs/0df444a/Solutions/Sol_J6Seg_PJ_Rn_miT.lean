/-!
# B5-J math, part 2: loop forms of the `J`-table quantities

* `sum_flat`: a double sum over `u < n`, `j < m` as one sum over `x < n m` (`x / m`, `x % m`).
* `sum_Hset`: the coupling-offset sum as a sum over `j < 2w + 1` with the test `hc`.
* `TsumI_range`, `TinvI_eq`, `capI_flat`, `ccOf_flat`: the forms the IL loops compute.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

open Finset

namespace J6Seg

section tab
variable (P : ℕ) (T : Tables) (B : Blocks)

theorem TsumI_range (a n u v : ℕ) :
    TsumI P T a n u v = rs P (∑ k ∈ range n,
      if max u v ≤ k then T.ap a (k - u) * fmul P (T.gam k) (T.am a (k - v)) else 0) := by
  unfold TsumI
  congr 1
  rw [← Finset.sum_filter]
  congr 1
  ext k; simp [Finset.mem_Ico, and_comm]

theorem TinvI_eq (w a n u v : ℕ) :
    TinvI P T w a n u v = fmul P (fmul P (T.gi (tU w n u v)) (T.gi (tV w n u v)))
      (TsumI P T a n (tU w n u v) (tV w n u v)) := by
  unfold TinvI tU tV; split_ifs <;> rfl

end tab

end J6Seg

end

