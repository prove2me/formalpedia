    obtain ⟨_, _, hs⟩ := hg
    rw [← m.hS_t]
    revert hs
    cases m.toMeasured.s with
    | single a c => rintro ⟨_, _, h⟩; exact fun h' ↦ ENat.natCast_ne_top c (h.symm.trans h')
    | crossing a b c _ =>
      rintro ⟨_, _, h, _⟩; exact fun h' ↦ ENat.natCast_ne_top c (h.symm.trans h')
  obtain ⟨q, -⟩ := TypeDensity.concrete_surface_quotient_T_equiv m.O m.pi m.hpi m.u m.a m.b m.ha
  have h878 := TypeDensity.concrete_surface_equiv_curve_length_and_regular m.R m.O m.pi m.u m.a m.b
    (RingEquiv.refl _) q g
  have h872 := (TypeDensity.concrete_surface_equiv_regular_pair m.R m.O m.pi m.hpi m.u m.a m.b m.ha
