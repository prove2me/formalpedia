variable {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] {a b : ℚ}

theorem exists_sbar (M : ℕ) [NeZero M] :
    ∃ sbar : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ Spec (CommRingCat.of (Localization.Away ((M : ℕ) : ℤ))),
      sbar ≫ Spec.map (CommRingCat.ofHom (algebraMap ℤ (Localization.Away ((M : ℕ) : ℤ)))) =
        Spec.map (CommRingCat.ofHom (algebraMap ℤ (AlgebraicClosure ℚ))) := by
  have hM : IsUnit (algebraMap ℤ (AlgebraicClosure ℚ) ((M : ℕ) : ℤ)) := by
    rw [isUnit_iff_ne_zero, map_natCast]
    exact Nat.cast_ne_zero.mpr (NeZero.ne M)
  refine ⟨Spec.map (CommRingCat.ofHom (IsLocalization.Away.lift ((M : ℕ) : ℤ) hM)), ?_⟩
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  exact RingHom.ext_int _ _

theorem ne_zero_and_ne_zero (hB : IsIndefiniteRamifiedExactlyAt a b q q') : a ≠ 0 ∧ b ≠ 0 := by
  have key : ∀ y : ℍ[ℚ, a, b], y ≠ 0 → y * y = 0 → False := by
    intro y hy hyy
    obtain ⟨u, rfl⟩ := QuaternionAlgebra.IsIndefiniteRamifiedExactlyAt.isUnit_of_ne_zero hB y hy
    apply hy
    calc (u : ℍ[ℚ, a, b]) = ↑u⁻¹ * (↑u * ↑u) := by rw [← mul_assoc, Units.inv_mul, one_mul]
      _ = 0 := by rw [hyy, mul_zero]
  refine ⟨fun h0 => key ⟨0, 1, 0, 0⟩ ?_ ?_, fun h0 => key ⟨0, 0, 1, 0⟩ ?_ ?_⟩
  · intro h; simpa using congrArg QuaternionAlgebra.imI h
  · ext <;> simp [h0]
  · intro h; simpa using congrArg QuaternionAlgebra.imJ h
  · ext <;> simp [h0]

theorem isEichlerOrder_one (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) : IsEichlerOrder Λ 1 := by
  refine ⟨Λ, Λ, hΛ, hΛ, (inf_idem Λ).symm, ?_⟩
  simp [AddSubgroup.relIndex]

theorem exists_mem_nrd_eq_of_mem_fuchsianGroup_mul_prod (ha : a ≠ 0) (hb : b ≠ 0)
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsOrder Λ)
    (ι : ℍ[ℚ, a, b] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ℝ) (hι : Function.Injective ι)
    (e : ℕ) (ℓ : Fin e → ℕ) (x : Fin e → ℍ[ℚ, a, b]) (hx : ∀ j, x j ∈ Λ ∧ nrd (x j) = (ℓ j : ℚ))
    (δ : Fin e → GL (Fin 2) ℝ) (hδ : ∀ j, ((δ j : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = ι (x j))
    (γ : GL (Fin 2) ℝ) (hγ : γ ∈ fuchsianGroup Λ ι) :
    ∃ α : ℍ[ℚ, a, b], α ∈ Λ ∧ nrd α = ((∏ j, (ℓ j : ℤ) : ℤ) : ℚ) ∧
      ((γ * ((List.ofFn δ).reverse).prod : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = ι α := by
  have nrd_mul : ∀ y z : ℍ[ℚ, a, b], nrd (y * z) = nrd y * nrd z := by
    intro y z
    have h := QuaternionAlgebra.det_eq_nrd_of_injective ha hb ι hι (y * z)
    rw [map_mul, Matrix.det_mul, QuaternionAlgebra.det_eq_nrd_of_injective ha hb ι hι y,
      QuaternionAlgebra.det_eq_nrd_of_injective ha hb ι hι z] at h
    exact_mod_cast h.symm

  have main : ∀ (e : ℕ) (ℓ : Fin e → ℕ) (x : Fin e → ℍ[ℚ, a, b]) (_ : ∀ j, x j ∈ Λ ∧ nrd (x j) = (ℓ j : ℚ))
      (δ : Fin e → GL (Fin 2) ℝ) (_ : ∀ j, ((δ j : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = ι (x j)),
      ∃ β : ℍ[ℚ, a, b], β ∈ Λ ∧ nrd β = ∏ j, (ℓ j : ℚ) ∧
        ((((List.ofFn δ).reverse).prod : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = ι β := by
    intro e
    induction e with
    | zero =>
      intro ℓ x _ δ _
      exact ⟨1, hΛ.one_mem, by simp, by simp⟩
    | succ e ih =>
      intro ℓ x hx δ hδ
      obtain ⟨β', hβ'Λ, hβ'n, hβ'm⟩ := ih (fun j => ℓ j.succ) (fun j => x j.succ) (fun j => hx j.succ)
        (fun j => δ j.succ) (fun j => hδ j.succ)
      refine ⟨β' * x 0, hΛ.mul_mem hβ'Λ (hx 0).1, ?_, ?_⟩
      · rw [nrd_mul, hβ'n, (hx 0).2, Fin.prod_univ_succ, mul_comm]
      · rw [List.ofFn_succ, List.reverse_cons, List.prod_append, List.prod_singleton, Units.val_mul, map_mul,
          ← hβ'm, ← hδ 0]
  obtain ⟨β, hβΛ, hβn, hβm⟩ := main e ℓ x hx δ hδ
  obtain ⟨u, hu, hu1, hγu⟩ := CerednikDrinfeld.exists_isUnitOf_nrd_eq_one_of_mem_fuchsianGroup ha hb Λ hΛ ι hι γ hγ
  refine ⟨u * β, hΛ.mul_mem hu.1 hβΛ, ?_, ?_⟩
  · rw [nrd_mul, hu1, one_mul, hβn]; push_cast; rfl
  · rw [Units.val_mul, map_mul, hγu, hβm]

end CMFiniteSkeleton

open CMFiniteSkeleton in
theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (t n : ℤ) (htn : t ^ 2 < 4 * n) :
    ∃ (m : ℕ) (S : Fin m → FakeEllipticCurve Λ N (AlgebraicClosure ℚ)),
      ∀ E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ), (∀ j : Fin m, ¬ FakeEllipticCurve.Iso E (S j)) →
        ¬ ∃ (φ : E.A ⟶ E.A) (hφ : φ ≫ E.f = E.f),
          (∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (P Q : SchemeHomOver s E.f),
              mapPt φ hφ (E.L.mul s P Q) = E.L.mul s (mapPt φ hφ P) (mapPt φ hφ Q)) ∧
          (∀ x : ↥Λ, E.act x ≫ φ = φ ≫ E.act x) ∧
          ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (P : SchemeHomOver s E.f),
            letI := E.L.pointCommGroup E.comm s
            mapPt φ hφ (mapPt φ hφ P) * P ^ n = mapPt φ hφ P ^ t := by
  classical

  refine CerednikDrinfeld.QM.FakeEllipticCurve.exists_fin_forall_not_iso_not_exists_mapPt_mapPt_mul_zpow_eq_zpow_of_level_one
    Λ hΛ.1 N t n ?_

  obtain ⟨k, hνpos, hνsq⟩ := Int.exists_pos_and_not_isSquare_sq_sub_mul_add_of_sq_lt_four_mul t n htn

  have hq1 : ¬ q ∣ 1 := fun h => (Fact.out : q.Prime).ne_one (Nat.dvd_one.mp h)
  have hq'1 : ¬ q' ∣ 1 := fun h => (Fact.out : q'.Prime).ne_one (Nat.dvd_one.mp h)
  obtain ⟨X, hXint, πX, pt, hsm, hpr, pt_iso, pt_pb, pt_surj, pt_inj, hsm1, hgeom, hchar, halg⟩ :=
    CerednikDrinfeld.QM.exists_coarseModuliScheme_of_squarefree_of_six_mul_dvd_of_neZero (N := 1) hq1 hq'1 hqq' squarefree_one hB Λ hΛ
      (6 * q * q') (by rw [mul_one])
  obtain ⟨sbar, sbar_over⟩ := exists_sbar (6 * q * q')
  haveI := hXint
  haveI := hchar
  obtain ⟨_, _, Fbar, _, _, _, _, toBar, gal, 𝔐, e𝔐, he𝔐, -, -, -, -, -, he𝔐_snd, -, -, -⟩ :=
    CerednikDrinfeld.exists_barFunctionField_curveModel_of_smoothProperCurve (N := 6) (q := q) (q' := q')
      X πX hpr hsm1 hgeom halg sbar sbar_over
  obtain ⟨ι, hι⟩ := QuaternionAlgebra.IsIndefiniteRamifiedExactlyAt.exists_algHom_matrix_injective hB
  obtain ⟨ha, hb⟩ := ne_zero_and_ne_zero hB
  obtain ⟨Fc, _, _, _, _, U, bcPlace, hsurj, hHecke, -, -, -, -, -, -, -, hbcinj, hmod, hALq, hALq'⟩ :=
    CerednikDrinfeld.QM.exists_uniformizedHeckeCurve_place_corr_single_eq_sum_levelOne_of_two_mul_dvd_neZero hB Λ hΛ ι hι hqq'
      (6 * q * q') ⟨3, by ring⟩
      X πX pt hsm hpr pt_iso pt_pb pt_surj pt_inj hsm1 hgeom sbar sbar_over Fbar gal 𝔐 e𝔐 he𝔐 he𝔐_snd

  obtain ⟨F, hF⟩ := CerednikDrinfeld.exists_finset_forall_smul_eq_of_nrd_eq_of_not_isSquare hqq' hB Λ hΛ ι hι
    (k ^ 2 - t * k + n) hνpos hνsq

  have G4 : ∀ E : FakeEllipticCurve Λ 1 (AlgebraicClosure ℚ), ∃ P : Place (AlgebraicClosure ℚ) Fbar,
      (pt _ sbar E).1 = (𝔐.pointEquivPlace.symm P).1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar := by
    intro E
    haveI := he𝔐
    let z : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ CategoryTheory.Limits.pullback πX sbar :=
      CategoryTheory.Limits.pullback.lift (pt _ sbar E).1 (𝟙 _) (by rw [Category.id_comp]; exact (pt _ sbar E).2)
    let p : {p : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ 𝔐.C // p ≫ 𝔐.toBase = 𝟙 _} :=
      ⟨z ≫ inv e𝔐, by rw [Category.assoc, ← he𝔐_snd, IsIso.inv_hom_id_assoc, CategoryTheory.Limits.pullback.lift_snd]⟩
    refine ⟨𝔐.pointEquivPlace p, ?_⟩
    rw [Equiv.symm_apply_apply]
    show (pt _ sbar E).1 = (z ≫ inv e𝔐) ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar
    rw [Category.assoc, IsIso.inv_hom_id_assoc, CategoryTheory.Limits.pullback.lift_fst]
  have G5 : ∀ P P' : Place (AlgebraicClosure ℚ) Fbar,
      (𝔐.pointEquivPlace.symm P).1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar =
        (𝔐.pointEquivPlace.symm P').1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar → P = P' := by
    intro P P' h
    haveI := he𝔐
    apply 𝔐.pointEquivPlace.symm.injective
    apply Subtype.ext
    rw [← cancel_mono e𝔐]
    apply CategoryTheory.Limits.pullback.hom_ext
    · simpa only [Category.assoc] using h
    · rw [Category.assoc, Category.assoc, he𝔐_snd, (𝔐.pointEquivPlace.symm P).2, (𝔐.pointEquivPlace.symm P').2]
  have G8 : ∀ P P' : Place (AlgebraicClosure ℚ) Fbar, bcPlace P = bcPlace P' → P = P' := by
    intro P P' h
    exact hbcinj h

  let bad : Finset (Place ℂ Fc) := F.image U.pt

  have key : ∀ (E : FakeEllipticCurve Λ 1 (AlgebraicClosure ℚ)),
      (∃ (φ : E.A ⟶ E.A) (hφ : φ ≫ E.f = E.f),
          (∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (P Q : SchemeHomOver s E.f),
              mapPt φ hφ (E.L.mul s P Q) = E.L.mul s (mapPt φ hφ P) (mapPt φ hφ Q)) ∧
          (∀ x : ↥Λ, E.act x ≫ φ = φ ≫ E.act x) ∧
          ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (P : SchemeHomOver s E.f),
            letI := E.L.pointCommGroup E.comm s
            mapPt φ hφ (mapPt φ hφ P) * P ^ n = mapPt φ hφ P ^ t) →
      ∀ P₀ : Place (AlgebraicClosure ℚ) Fbar,
        (pt _ sbar E).1 = (𝔐.pointEquivPlace.symm P₀).1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar →
        bcPlace P₀ ∈ bad := by
    rintro E ⟨φ, hφ, hadd, hlin, hrel⟩ P₀ hP₀

    obtain ⟨ψ, hψ, hadd', hlin', -, hrel'⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_mapPt_mapPt_mul_zpow_eq_zpow_sub_of_mapPt_mapPt_mul_zpow_eq_zpow
        hΛ.1 E t n k φ hφ hadd hlin hrel
    have htn' : (t - 2 * k) ^ 2 < 4 * (k ^ 2 - t * k + n) := by nlinarith [htn]

    obtain ⟨e, ℓ, C, hℓ, hprod, hC0, hCe, hstep⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_chain_isLevelIsogeny_or_isAtkinLehnerQuotient_of_mapPt_mapPt_mul_zpow_eq_zpow
        hqq' hB Λ hΛ E (t - 2 * k) (k ^ 2 - t * k + n) htn' ψ hψ hadd' hlin' hrel'

    choose Pc hPc using fun j : Fin (e + 1) => G4 (C j)
    obtain ⟨τ₀, hτ₀⟩ := hsurj (bcPlace (Pc 0))
    have hlast : bcPlace (Pc (Fin.last e)) = bcPlace (Pc 0) := by
      congr 1
      apply G5
      rw [← hPc (Fin.last e), ← hPc 0, hC0]
      exact congrArg Subtype.val (pt_iso _ sbar _ _ hCe)
    have hsteps : ∀ j : Fin e, (fun j => bcPlace (Pc j)) j.succ ∈
        (U.corr (ℓ j) (hℓ j) (Finsupp.single ((fun j => bcPlace (Pc j)) j.castSucc) 1)).support := by
      intro j
      simp only []
      rcases hstep j with ⟨hjq, hjq', K, hK⟩ | ⟨hjq, hAL⟩ | ⟨hjq', hAL⟩
      · obtain ⟨nn, Ks, d, Ps, -, hexh, hisog, hPs, hcorr⟩ :=
          hmod (ℓ j) (hℓ j) hjq hjq' (Pc j.castSucc) (C j.castSucc) (hPc _)
        obtain ⟨i, hi⟩ := hexh K
        have hiso : FakeEllipticCurve.Iso (C j.succ) (d i) :=
          CerednikDrinfeld.QM.FakeEllipticCurve.iso_of_isLevelIsogeny_of_forall_factorsThrough_iff_of_isOrder
            (ℓ j) (hℓ j) hΛ.1 (C j.castSucc) K (Ks i) hi (C j.succ) (d i) hK (hisog i)
        have hPeq : Pc j.succ = Ps i :=
          G5 _ _ (by rw [← hPc, ← hPs i]; exact congrArg Subtype.val (pt_iso _ sbar _ _ hiso))
        rw [hcorr, hPeq, Finsupp.mem_support_iff, Finsupp.finsetSum_apply]
        refine ne_of_gt (Finset.sum_pos' (fun i' _ => ?_) ⟨i, Finset.mem_univ _, ?_⟩)
        · simp only [Finsupp.single_apply]; split_ifs <;> norm_num
        · simp
      · have hc : ∀ h : (ℓ j).Prime, U.corr (ℓ j) h (Finsupp.single (bcPlace (Pc j.castSucc)) 1) =
            Finsupp.single (bcPlace (Pc j.succ)) 1 := by
          rw [hjq]; intro h; exact hALq _ _ _ _ (hPc _) (hPc _) hAL
        rw [hc]; simp
      · have hc : ∀ h : (ℓ j).Prime, U.corr (ℓ j) h (Finsupp.single (bcPlace (Pc j.castSucc)) 1) =
            Finsupp.single (bcPlace (Pc j.succ)) 1 := by
          rw [hjq']; intro h; exact hALq' _ _ _ _ (hPc _) (hPc _) hAL
        rw [hc]; simp

    obtain ⟨δ, γ, hδ, hγ, hfix⟩ :=
      ModularCurve.UniformizedHeckeCurve.exists_mul_prod_smul_eq_of_forall_mem_support_corr
        U e ℓ hℓ (fun j => bcPlace (Pc j)) τ₀ hτ₀ hsteps hlast

    have hx : ∀ j : Fin e, ∃ x : ℍ[ℚ, a, b], (x ∈ Λ ∧ nrd x = (ℓ j : ℚ)) ∧
        ((δ j : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) = ι x := by
      intro j
      obtain ⟨S, hS, -, hmap⟩ := hHecke (ℓ j) (hℓ j)
      have hmem : ((δ j : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) ∈ S.val.map ι := by
        rw [← hmap]; simp only [Multiset.map_id']; simp [Multiset.bind, Bind.bind, Pure.pure]; exact ⟨δ j, hδ j, rfl⟩
      obtain ⟨x, hxS, hxe⟩ := Multiset.mem_map.mp hmem
      exact ⟨x, ⟨(hS x hxS).1, (hS x hxS).2.1⟩, hxe.symm⟩
    choose x hx using hx
    obtain ⟨α, hαΛ, hαn, hαm⟩ := exists_mem_nrd_eq_of_mem_fuchsianGroup_mul_prod ha hb Λ hΛ.1 ι hι e ℓ x
      (fun j => (hx j).1) δ (fun j => (hx j).2) γ hγ
    have hαν : nrd α = ((k ^ 2 - t * k + n : ℤ) : ℚ) := by rw [hαn, hprod]

    obtain ⟨γ', hγ', τ₁, hτ₁, hγ'τ⟩ := hF τ₀ α (γ * ((List.ofFn δ).reverse).prod) hαΛ hαν hαm hfix
    have hpt : U.pt τ₁ = U.pt τ₀ := (U.pt_eq_pt_iff τ₁ τ₀).mpr ⟨γ', hγ', hγ'τ⟩
    have hP0 : P₀ = Pc 0 := G5 _ _ (by rw [← hP₀, ← hPc 0, hC0])
    rw [hP0, ← hτ₀, ← hpt]
    exact Finset.mem_image_of_mem _ hτ₁

  choose Pof hPof using G4
  let good : Place ℂ Fc → Prop := fun p => ∃ E : FakeEllipticCurve Λ 1 (AlgebraicClosure ℚ), bcPlace (Pof E) = p
  let L : List (FakeEllipticCurve Λ 1 (AlgebraicClosure ℚ)) :=
    bad.toList.filterMap fun p => if h : good p then some h.choose else none
  refine ⟨L.length, fun j => L.get j, ?_⟩
  intro E hnot hCM
  have hbad : bcPlace (Pof E) ∈ bad := key E hCM (Pof E) (hPof E)
  have hgood : good (bcPlace (Pof E)) := ⟨E, rfl⟩
  have hmemL : hgood.choose ∈ L := by
    simp only [L, List.mem_filterMap]
    exact ⟨bcPlace (Pof E), Finset.mem_toList.mpr hbad, by rw [dif_pos hgood]⟩
  obtain ⟨j, hj⟩ := List.get_of_mem hmemL
  apply hnot j
  have hE' : bcPlace (Pof hgood.choose) = bcPlace (Pof E) := hgood.choose_spec
  have hPP : Pof hgood.choose = Pof E := G8 _ _ hE'
  refine pt_inj _ sbar _ _ ?_
  show pt _ sbar E = pt _ sbar (L.get j)
  rw [hj]
  exact Subtype.ext (by rw [hPof E, hPof hgood.choose, hPP])

