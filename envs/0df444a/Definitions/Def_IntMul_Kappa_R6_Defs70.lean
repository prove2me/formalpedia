open J6Seg.PJ (cT cE cA cLoop cRd cRdK cRdBlk cPh2 cPh3 cPh3a cPh3b cPar pA1 pA2 pA3 pA4 pA5 pA6 eSq eLg eSz1 eSz2 ePw)

/-- The constant of the parameter phase. -/
def Kp : ℕ :=
  10 ^ 10 + cA 0 pA1 + cA 0 [(5, eSq)] + cA 0 pA2 + cA 0 [(24, eLg)] + cA 0 pA3 +
    cA 0 [(8, eSz1), (11, eSz2)] + cA 0 pA4 + cA 0 [(9, ePw 9)] + cA 0 (pA5 0 0) +
    cA 0 [(12, ePw 12)] + cA 0 (pA6 0 0)

