    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
    by
      obtain ⟨s, b, _⟩ := exists_hilbertBasis ℂ H
      let : Countable s := (
      let local_proof {H : Type _} [NormedAddCommGroup H]
          [InnerProductSpace ℂ H] [SecondCountableTopology H] {ι : Type _} {v : ι → H}
          (hv : Orthonormal ℂ v) : Countable ι :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Analytic in
          by
            have hd : Pairwise (fun i j => Disjoint (Metric.ball (v i) (1 / 2 : ℝ))
                (Metric.ball (v j) (1 / 2 : ℝ))) := by
              intro i j hij
              apply Set.disjoint_left.mpr
              intro z hzi hzj
              have hn : ‖v i - v j‖ ^ 2 = 2 := by
