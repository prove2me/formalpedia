theorem one_le_nR {t S0 B : ℕ} (hS : 1 ≤ S0) (hB : 1 ≤ B) : 1 ≤ nR t S0 B := by
  unfold nR; nlinarith [Nat.one_le_two_pow (n := t), Nat.mul_le_mul hB hS]

theorem alN_ge (W A : ℕ) : (A + W + 1) * 1000000 ≤ alN W A ∧ (W + 5) * 1000000 ≤ alN W A ∧
    (W * (W + 5) + 1) * 1000000 ≤ alN W A ∧ 4 * 1000000 + (W + 3) * 1000000 ≤ alN W A := by
  unfold alN
  have h : W + A + 10 ≤ (W + A + 10) ^ 3 := by
    calc W + A + 10 = (W + A + 10) ^ 1 := (pow_one _).symm
      _ ≤ (W + A + 10) ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have h2 : (W + A + 10) ^ 2 ≤ (W + A + 10) ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  refine ⟨by nlinarith, by nlinarith, by nlinarith, by nlinarith⟩

/-- The wrapper around a child program. -/
theorem wrapChild_X (hW : 1 ≤ W) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v) {n : ℕ}
    (hn : 1 ≤ n) (e dw : ℕ) (cost : ℕ → ℕ) (w : ℕ) :
    cWrapR W (n * r) Z e dw cost w ≤
      cost w + (W + 3) * 1000000 * (W * n) * Xf r Ψ (w + dw + (e + 2) * W + e + 4) := by
  unfold cWrapR
  have c1 := cAtom_X (r := r) (Ψ := Ψ) (Z := Z) (w := w + dw + (e + 2) * W) (D := e) hW hn hZΨ
  have hX : 2 ≤ Xf r Ψ (w + dw + (e + 2) * W + e + 4) := by unfold Xf; have := hZΨ (w + dw + (e + 2) * W + e + 4); omega
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  have k1 := Nat.mul_le_mul_left (W + 2) c1
  have k3 : 3 ≤ 1000000 * (W * n) * Xf r Ψ (w + dw + (e + 2) * W + e + 4) := by nlinarith
  nlinarith

theorem one_le_Gam (m k : ℕ) {τ : ℝ} (hτ : 0 ≤ τ) : (1 : ℝ) ≤ ((m : ℝ) ^ k + 1) ^ τ :=
  Real.one_le_rpow (by have : (0 : ℝ) ≤ (m : ℝ) ^ k := by positivity
                       linarith) hτ

theorem zsz_role {W t S0 B r Z : ℕ} (hW : 1 ≤ W) (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) :
