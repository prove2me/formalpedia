private theorem t0680 (u : ℂˣ) (a b c X₀ : ℂ) :
    (C 1 - C ((u : ℂ) * (c * a)) * X + C (((u ^ 2 : ℂˣ) : ℂ) * (c ^ 2 * b)) * X ^ 2 : ℂ[X]).eval X₀ =
      (C 1 - C ((u : ℂ) * a) * X + C (((u ^ 2 : ℂˣ) : ℂ) * b) * X ^ 2 : ℂ[X]).eval (c * X₀) := by
  simp only [eval_add, eval_sub, eval_mul, eval_C, eval_X, eval_pow]
  ring

private theorem t0681 {N : ℂ} (hN : N ≠ 0) (u : ℂˣ) (a b s : ℂ) :
    1 - a / N * ((u : ℂ) * N ^ (1 - s)) + b / N / N * ((u : ℂ) * N ^ (1 - s)) ^ 2 =
      (C 1 - C ((u : ℂ) * a) * X + C (((u ^ 2 : ℂˣ) : ℂ) * b) * X ^ 2 : ℂ[X]).eval (N ^ (-s)) := by
  have h1 : N ^ (1 - s) = N * N ^ (-s) := by
    rw [sub_eq_add_neg, Complex.cpow_add _ _ hN, Complex.cpow_one]
  simp only [eval_add, eval_sub, eval_mul, eval_C, eval_X, eval_pow, Units.val_pow_eq_pow_val, h1]
