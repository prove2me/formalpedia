-- Source module: Solutions.J6AILTab3
/-!
# A lines, table set-up, part 3: the correlation and output-scaling table loops

* `loopR`: for `e < 2W + 2H`: `28 := s (A0 + t(2W+H) - t e)²; 29 := expNeg 2p (t³α²) 28;
  push 2^Q · 29`, i.e. it pushes `rTabA … q` (`Rn.loopR`);
* `loopC`: for `κ < 2H`: `28 := s (t-s)⁺ (κ - H)²; 29 := expPos 2p (t²α²) 28 (p/2);
  29 := 29 · β; push tdiv 29 2^(2p)`, i.e. it pushes `cTabA … q` (`Rn.loopC`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

/-! ## The correlation loop -/

/-- The exponent numerator of `rFA`. -/
def rNum (p s t α H q e : ℕ) : ℕ :=
  s * ((t : ℤ) * (J6A.jcB s t H (J6A.kkA H q) - J6A.WA p α H +
    ((2 * J6A.WA p α H + H : ℕ) : ℤ) - (e : ℤ)) - s * J6A.kcB H (J6A.kkA H q)).natAbs ^ 2

def eRx : E := .sub (.add (.r 25) (.mul (.r 4) (.add (.add (.r 9) (.r 9)) (.r 8))))
  (.mul (.r 4) (.r 26))
def eR1 : E := .mul (.r 3) (.mul eRx eRx)

def bodyR : RS := .seq (.asg 28 eR1.ex) (.seq (Ins.en 29 1 7 28).p (.push sS ePQ.ex))

/-- **The correlation loop** (count on `10`, index on `26`). -/
def loopR : RS := forL cI 10 26 bodyR

def cBodyR (W : ℕ) : ℕ := cT eR1.ex W + (Ins.cEn W + cT ePQ.ex W)

/-- The entries pushed by `loopR` for block `q`. -/
def fR (p s t α H q : ℕ) (e : ℕ) : ℤ := 2 ^ J6A.QA p * J6A.rFA p s t α H q e

/-! ## The output-scaling loop -/

/-- The exponent numerator of entry `κ` of `cTabA`. -/
def cNumA (s t H κ : ℕ) : ℕ := s * (t - s) * ((κ : ℤ) - H).natAbs ^ 2

def eKx : E := .sub (.r 26) (.r 8)
def eC1 : E := .mul (.mul (.r 3) eTS) (.mul eKx eKx)
def eCb : E := .mul (.r 29) (.r 6)
def eTd : E := .sel (.r 29) (.sub (.k 0) (.dv (.sub (.k 0) (.r 29)) (.r 5))) (.dv (.r 29) (.r 5))

def bodyC : RS := .seq (.asg 28 eC1.ex) (.seq (J6A.PA.epX 29 (.reg 1) (.reg 11) (.reg 28) (.reg 2))
  (.seq (.asg 29 eCb.ex) (.push sS eTd.ex)))

/-- **The output-scaling loop** (count on `10`, index on `26`). -/
def loopC : RS := forL cI 10 26 bodyC

def cBodyC (W : ℕ) : ℕ := cT eC1.ex W + (cEp W + (cT eCb.ex W + cT eTd.ex W))

/-- The entries pushed by `loopC` (the same for every block). -/
def fC (p s t α : ℕ) (κ : ℕ) : ℤ :=
  (expPos (2 * p) (t ^ 2 * α ^ 2) (cNumA s t (HAx p α) κ) (p / 2) * betaT (2 * p) α).tdiv
    (2 ^ (2 * p))

end J6Seg.ATab

end

section
-- Source module: Solutions.J6AILTab4
/-!
# A lines, table set-up, part 4: one block

* `pushes S es`: push the values of `es` in order (`Rn.pushes`: `S` gains `(es.map den).reverse`);
* `Rn.pushForL`: a counted loop whose body pushes the list `g k` (in reading order) onto `S`;
* `LV`: the loop registers (`J6AILTab2`); `ABnd`: the width conditions;
* `blockB`: `25 := A0(q); push |tab|, header; loopA; loopR; loopC` pushes
  `segT (aTab6 …) q` (reversed) onto `sS` (`Rn.blockB`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

/-! ## Pushes of a list -/

def pushes (S : Fin HS) : List E → RS
  | [] => .skip
  | e :: es => .seq (.push S e.ex) (pushes S es)

def cPushes (W : ℕ) : List E → ℕ
  | [] => 1
  | e :: es => cT e.ex W + cPushes W es

/-! ## The block loop -/

/-- The concatenation of the first `k` lists of `g`, reversed. -/
def rvL (g : ℕ → List ℤ) (k : ℕ) : List ℤ := ((List.range k).flatMap g).reverse

/-! ## The loop registers -/

/-- The persistent registers of the table loop. -/
structure LV (p s t α pk b : ℕ) (v : Vr) : Prop where
  r1 : v 1 = ((2 * p : ℕ) : ℤ)
  r2 : v 2 = ((p / 2 : ℕ) : ℤ)
  r3 : v 3 = s
  r4 : v 4 = t
  r5 : v 5 = 2 ^ (2 * p)
  r6 : v 6 = betaT (2 * p) α
  r7 : v 7 = ((t ^ 3 * α ^ 2 : ℕ) : ℤ)
  r8 : v 8 = HAx p α
  r9 : v 9 = J6A.WA p α (HAx p α)
  r11 : v 11 = ((t ^ 2 * α ^ 2 : ℕ) : ℤ)
  r12 : v 12 = 2 ^ J6A.QA p
  r20 : v 20 = 2 ^ pk
  r21 : v 21 = 2 ^ b
  r22 : v 22 = ((KR.AK.jA (2 * J6A.WA p α (HAx p α)) (2 * HAx p α) : ℕ) : ℤ)
  r23 : v 23 = ((b * (2 * (2 * J6A.WA p α (HAx p α) + 2 * HAx p α)) : ℕ) : ℤ)

/-- The registers the block body changes. -/
def TB : List (Fin HS) := [10, 24, 25, 26, 28, 29]

/-! ## The width conditions -/

