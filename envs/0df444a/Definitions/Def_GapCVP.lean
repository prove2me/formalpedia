def sourceGridIndex_failureTrace
    (count : ℕ) :
    EvalsToInTime sourceCanonicalUnaryGridIndexMachine.step
      (sourceGridIndexConfiguration 6
        [] (List.replicate count true) [] [] [])
      (some (Turing.haltList
        sourceCanonicalUnaryGridIndexMachine []))
