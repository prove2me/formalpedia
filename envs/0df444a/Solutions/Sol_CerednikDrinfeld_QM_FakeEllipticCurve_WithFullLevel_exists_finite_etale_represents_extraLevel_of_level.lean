    have hr' : Set.range (x ≫ kN).base ⊆ (VC (N := N) E' hM : Set _) := by
      rintro _ ⟨τ, rfl⟩; exact hr ⟨τ, rfl⟩
    have hxks : (x ≫ kN) ≫ E'.L.schemeKerStr N = t ≫ Spec.map (CommRingCat.ofHom ψ) := by
