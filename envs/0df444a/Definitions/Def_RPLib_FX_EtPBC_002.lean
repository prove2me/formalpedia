-- ===== S4.Def_RP_EtPBC_A_CovGl1 =====
section

/-!
# S4-EtPBC-A, R4-T2 (G1c, part 2a): localization squares are pushouts

`isLoc_of_away`: an `IsAwayMap ψ t` with `ψ t` a unit is a localization away from `t`. `isLoc_tmap`: its base change
`R' ⊗ B → R' ⊗ C` is a localization away from `1 ⊗ t`. **`isPushout_loc`**: a map `ψ : E → E'` of algebras over
`R' ⊗ B` and `R' ⊗ C`, compatible on pure tensors and a localization away from `1 ⊗ t`, gives a pushout square.
-/

set_option autoImplicit false

open CategoryTheory Limits TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

/-- **An `IsAwayMap` at an element with unit image is a localization.** -/
theorem isLoc_of_away {E E' : Type u} [CommRing E] [CommRing E'] (ψ : E →+* E') (t : E) (haw : IsAwayMap ψ t)
    (hu : IsUnit (ψ t)) : @IsLocalization.Away E _ t E' _ ψ.toAlgebra := by
  letI := ψ.toAlgebra
  show IsLocalization (Submonoid.powers t) E'
  rw [isLocalization_iff]
  refine ⟨?_, fun z => ?_, fun {x y} hxy => ?_⟩
  · rintro ⟨_, k, rfl⟩
    show IsUnit (ψ (t ^ k))
    rw [map_pow]
    exact hu.pow k
  · obtain ⟨k, a, h⟩ := haw.1 z
    exact ⟨(a, ⟨t ^ k, k, rfl⟩), by show z * ψ (t ^ k) = ψ a; rw [map_pow, mul_comm, h]⟩
  · obtain ⟨k, hk⟩ := haw.2 (x - y) (by rw [map_sub, sub_eq_zero]; exact hxy)
    exact ⟨⟨t ^ k, k, rfl⟩, by rw [← sub_eq_zero, ← mul_sub]; exact hk⟩

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovFbB =====
section

/-!
# S4-EtPBC-A, R4-T2 (G1d, part 2): the lifts agree on the overlap

`eq_of_away`: ring maps out of a localization agreeing on the image are equal. **`gW_glue`**: for chart surjections
`θ₀ : E₀ ↠ G₀`, `θ₁ : E₁ ↠ G₁` compatible with localizations `ψᵢ : Eᵢ → E₀₁`, `pᵢ : Gᵢ → G₀₁` through some
`θ₀₁ : E₀₁ → G₀₁` (not assumed surjective), the two lifts of `w ≫ Spec ψᵢ` factor through one `c : W ⟶ Spec G₀₁`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

/-- **Ring maps out of a localization** that agree on the image of the localization map are equal. -/
theorem eq_of_away {E E' S : Type u} [CommRing E] [CommRing E'] [CommRing S] (ψ : E →+* E') (t : E)
    (haw : IsAwayMap ψ t) (f g : E' →+* S) (hu : IsUnit (f (ψ t))) (h : f.comp ψ = g.comp ψ) : f = g := by
  ext y
  obtain ⟨k, a, hy⟩ := haw.1 y
  have h1 := congrArg f hy
  have h2 := congrArg g hy
  rw [map_mul, map_pow] at h1 h2
  have ht : g (ψ t) = f (ψ t) := (RingHom.congr_fun h t).symm
  have ha : g (ψ a) = f (ψ a) := (RingHom.congr_fun h a).symm
  rw [ht, ha, ← h1] at h2
  exact ((hu.pow k).mul_left_cancel h2).symm

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovFbC =====
section

/-!
# S4-EtPBC-A, R4-T2 (G1d, part 3): the chart identity and the pullback square of the fibre cover

* `hxL_of`: a ring map `χ' : R' → K` over `x` gives a lift `Spec χ'` of `x`.
* **`fromSpec_yx`**: for a chart `U` of `Y` and `θ : E → Γ(T, q⁻¹ fx⁻¹ U)` as in `CoverLift`,
  `T_U ⟶ T ⟶ Y_x ⟶ Y_{V'}` equals `Spec θ ≫ Spec (alg) ≫ chY`.
* `mono_yxMap`: `Y_x ⟶ Y_{V'}` is a monomorphism.
* `pb_key`: the square of a chart of the pulled back gluing cover.
* `gW_congr`: `gW` only depends on `w`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite TopologicalSpace
open scoped TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open RamanujanPetersson.EtPBC.Z3

universe u

/-- **The square of a chart of the pulled back gluing cover.** -/
theorem pb_key {X : Scheme.{u}} (𝒰 : X.OpenCover) [Category 𝒰.I₀] [𝒰.LocallyDirected] [Small.{u} 𝒰.I₀]
    [Quiver.IsThin 𝒰.I₀] (d : 𝒰.RelativeGluingData) {Z : Scheme.{u}} (m : Z ⟶ X) (j : 𝒰.I₀) :
    pullback.snd (pullback.fst d.toBase m) (d.cover.f j) ≫ d.natTrans.app j ≫ 𝒰.f j =
      pullback.fst (pullback.fst d.toBase m) (d.cover.f j) ≫ pullback.snd d.toBase m ≫ m := by
  have h2 : d.cover.f j ≫ d.toBase = d.natTrans.app j ≫ 𝒰.f j := Scheme.Cover.RelativeGluingData.ι_toBase d j
  refine (congrArg (pullback.snd (pullback.fst d.toBase m) (d.cover.f j) ≫ ·) h2.symm).trans ?_
  refine (pullback.condition_assoc (f := pullback.fst d.toBase m) (g := d.cover.f j) d.toBase).symm.trans ?_
  exact congrArg (pullback.fst (pullback.fst d.toBase m) (d.cover.f j) ≫ ·) (pullback.condition (f := d.toBase) (g := m))

section Chart

end Chart

