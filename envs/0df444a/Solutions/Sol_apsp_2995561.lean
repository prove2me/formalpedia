/-- `(L + 1) 4^L ≤ 9^L`. -/
theorem succ_mul_four_pow_le_nine_pow (L : ℕ) : (L + 1) * 4 ^ L ≤ 9 ^ L := by
  induction L with
  | zero => simp
  | succ L ih =>
    calc (L + 1 + 1) * 4 ^ (L + 1) = 4 * ((L + 2) * 4 ^ L) := by ring
      _ ≤ 4 * ((2 * (L + 1)) * 4 ^ L) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ (by omega))
