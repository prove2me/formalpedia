-- title:
--   Powers of a generated ideal are spanned by generator products
-- statement:
--   The m-th power of an ideal generated by the range of g is contained in the ideal spanned by all products of m elements of that range. At m = 0, both sides are the top ideal.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.RingTheory.Ideal.Operations
open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.ideal_span_pow_le_span_generator_products {A R : Type} [CommSemiring R] (g : A → R) (m : Nat) : (Ideal.span (Set.range g)) ^ m ≤ Ideal.span (Set.range (fun u : Fin m → A => ∏ i, g (u i))) := by sorry
