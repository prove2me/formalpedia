variable (hN : NullFrameData g0 gi0 E0 Θ0 U) (ht : RealFrameTangent g0 E0 U h f B)
include hN ht

theorem contDiffOn_rzE_joint (A μ : Fin 4) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzE E0 B p.1 A μ p.2) (rzW U E0 B) := by
  have hs : ∀ {φ : Pt 4 → ℂ}, ContDiffOn ℝ ∞ φ U → ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => φ p.2) (rzW U E0 B) :=
    fun hφ => hφ.comp contDiff_snd.contDiffOn fun p hp => hp.1
  have hfst : ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => ((p.1 : ℝ) : ℂ)) (rzW U E0 B) :=
    (Complex.ofRealCLM.contDiff.comp contDiff_fst).contDiffOn
  exact (hs (hN.smooth_E A μ)).add (hfst.mul (hs (ht.smooth_B A μ)))

theorem contDiffOn_rzTh_joint (C μ : Fin 4) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzTh U E0 Θ0 B p.1 C μ p.2) (rzW U E0 B) := by
  have hinv := contDiffOn_invC_of (A := fun p : ℝ × Pt 4 => frMat (rzE E0 B p.1) p.2) (s := rzW U E0 B)
    (fun ν A => by simpa only [frMat, Matrix.of_apply] using contDiffOn_rzE_joint hN ht A ν)
    (fun p hp => hp.2) C μ
  exact hinv.congr fun p hp => rzTh_eq_inv hp.1 C μ

