-- Source module: Solutions.J6SegILPreJD9
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D9: **the serialization stage** and its cost

**`Rn.serP`**: from the eliminated matrix on `14` (row-major `matL (Mseq Q (bandS mw cB) L A m) m`)
and the lines on `30`, push `flatT (fsOf Q L mw cB A) ++ flatB k (bsOf Q L mw cB A)` onto `41`,
set `22 := nBd (bsOf …)` and `23 :=` its length; registers outside `1–8, 22, 23, 29` and all
stacks but `41` unchanged.  **`cSer_le`**: `cSer W m ≤ 10^60 (m+1)^4 (W+1)^2`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

/-- **The serialization stage.** -/
theorem Rn.serP {Q W m mw cB k : ℕ} {L : List ℕ} {A : ℕ → ℕ → ℤ} {v : Vr} {c : Cs}
    (hv : BV W v) (h9 : v 9 = 2 ^ Q) (h10 : v 10 = 2 ^ (Q + 1)) (h11 : v 11 = mw)
    (h12 : v 12 = cB) (h28 : v 28 = m) (h21 : v 21 = 2 ^ k)
    (hL : c 30 = L.map (fun j : ℕ => (j : ℤ))) (hLm : L.length = m)
    (hM : c 14 = matL (Mseq Q (bandS mw cB) L A m) m)
    (hE : ∀ j ∈ ([15, 16, 17, 18, 19, 27, 47, 48, 50, 51] : List (Fin HS)), c j = [])
    (hW1 : 1 ≤ W) (hW8 : 8 * (m + 1) ^ 2 ≤ 2 ^ W) (hLb : ∀ j ∈ L, j ≤ 2 ^ W)
    (hMb : ∀ i < m, ∀ k < m, |Mseq Q (bandS mw cB) L A m i k| ≤ 2 ^ W) :
    Rn serP v c
      (fun v' => (∀ j, j ∉ ([1, 2, 3, 4, 5, 6, 7, 8, 22, 23, 29] : List (Fin HS)) → v' j = v j) ∧
        v' 22 = JK.nBd (bsOf Q L mw cB A) ∧
        v' 23 = ((JK.flatT (fsOf Q L mw cB A) ++ JK.flatB k (bsOf Q L mw cB A)).length : ℤ) ∧
        BV W v')
      (update c 41 (JK.flatT (fsOf Q L mw cB A) ++ JK.flatB k (bsOf Q L mw cB A) ++ c 41))
      (cSer W m) := by
  have hF : Fx Q k m mw cB v := ⟨h9, h10, h11, h12, h21, h28⟩
  have hS : StS m L (Mseq Q (bandS mw cB) L A m) c := ⟨hM, hL⟩
  have hB : BdS W m L (Mseq Q (bandS mw cB) L A m) := ⟨hW1, by nlinarith, hLb, hMb⟩
  have H := Rn.serPs (kk := k) hF hS hB hLm hv (hE 50 (by decide)) (hE 51 (by decide)) hW8
  rw [serL_rev hLm] at H
  refine H.mono (fun v' ⟨hf, h22, h23, hb⟩ => ⟨hf, ?_, ?_, hb⟩) le_rfl
  · rw [h22, flN_eq (Q := Q) (mw := mw) (A := A) hLm]
  · rw [h23, ← List.length_reverse, serL_rev hLm]

/-! ## The cost bound -/

end J6Seg.PJ

end

