section
-- Source module: Solutions.KFWC22
/-!
# KFW C-layer 22: `RowUP → P14U`, and the unconditional `P14U`

The procedure list: `levC`, `topC`, `lowC`, `eaccC`, `logC`, the entry `p14C` (positions `0 … 5`),
then the `nR` row-addition procedures of `RowUP`.  **`p14U_of_rowUP`** assembles `mainRun`
(`chainQ` / `p14Q` with the parameter bounds of `KFWC20` and the closed cost of `KFWC21`) and
`KFM.round_cost_closed`; the representation and error guarantees come from KFM's (non-uniform)
`prop14Ph_kTable` by uniqueness of the representation.  (`KFWP14U.p14U`: with `KFX.rowUP`.)
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

section Main

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

end Main

/-! ## The procedure list -/

/-- The row-procedure placement inside the list. -/
def iR {nR E : ℕ} (idx : Fin (6 + nR) → Fin (7 + E)) : Fin nR → Fin (7 + E) :=
  fun q => idx ⟨q.val + 6, by omega⟩

/-- **The procedure list** of the uniform Proposition 14. -/
noncomputable def UU (nR : ℕ) (UR : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → Fin nR → IStmt HS (7 + E))
    (rowC : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → IStmt HS (7 + E)) (E : ℕ)
    (idx : Fin (6 + nR) → Fin (7 + E)) (i : Fin (6 + nR)) : IStmt HS (7 + E) :=
  if h0 : i.val = 0 then levC (idx ⟨0, by omega⟩) (rowC E (iR idx))
  else if h1 : i.val = 1 then NLogN.KFW.topC (idx ⟨1, by omega⟩) (idx ⟨0, by omega⟩)
  else if h2 : i.val = 2 then lowC (idx ⟨2, by omega⟩) (idx ⟨0, by omega⟩)
  else if h3 : i.val = 3 then eaccC (idx ⟨3, by omega⟩) (NLogN.KFW.bodyC (idx ⟨1, by omega⟩) (idx ⟨2, by omega⟩))
  else if h4 : i.val = 4 then logC (idx ⟨4, by omega⟩) (coreC (idx ⟨3, by omega⟩))
  else if h5 : i.val = 5 then p14C (idx ⟨4, by omega⟩)
  else UR E (iR idx) ⟨i.val - 6, by have := i.isLt; omega⟩

end NLogN.KFW

end


