theorem inclusion_T {N : ℕ} [NeZero N] {S S' : Set ℕ} (h : S ⊆ S') {ℓ : ℕ} (hℓ : ℓ.Prime)
    (hℓN : ¬ ℓ ∣ N) (hℓS' : ℓ ∉ S') (hℓS : ℓ ∉ S) :
    Subalgebra.inclusion (CuspForm.heckeAlgebra_mono (N := N) (k := 2) h)
        (CuspForm.heckeAlgebra.T hℓ hℓN hℓS') = CuspForm.heckeAlgebra.T hℓ hℓN hℓS :=
  Subtype.ext rfl

private theorem _root_.KAnemicG4.inclusion_inclusion {N : ℕ} [NeZero N] {S₀ S₁ S : Set ℕ} (h₀₁ : S₀ ⊆ S₁) (h₁ : S₁ ⊆ S)
    (h₀ : S₀ ⊆ S) (t : CuspForm.heckeAlgebra N 2 S) :
    Subalgebra.inclusion (CuspForm.heckeAlgebra_mono (N := N) (k := 2) h₀₁)
        (Subalgebra.inclusion (CuspForm.heckeAlgebra_mono (N := N) (k := 2) h₁) t) =
      Subalgebra.inclusion (CuspForm.heckeAlgebra_mono (N := N) (k := 2) h₀) t :=
  Subalgebra.inclusion_inclusion _ _ t

p2m_export "KAnemicG4" "inclusion_inclusion"
