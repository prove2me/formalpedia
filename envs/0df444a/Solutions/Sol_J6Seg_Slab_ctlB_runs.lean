section
-- Source module: Solutions.J6SegILCtl5
/-!
# B-line IL, B1 follow-up: building the control list, §5 the builder

**`ctlB`** = `const bCur 0; rptX bN' entP; finB; lenB; rptX rNC (mv bT rC; mv bT rC);
rptX bN' (mv bSv bX; mv bSv bX)`.

**`ctlB_runs`**: from any managed state `G` with the source table `srcTab src argOf n'` on top of
`bX = 44`, `n'` on `bN' = 20`, `n` on `bN = 21` and empty `rptX` counters, for a monotone source
(`MonoSrc n n' src`), the builder pushes `flatC (ctlOf n n' src argOf)` onto `rC = 45` and
`n + n'` (`= |ctlOf …|`) onto `rNC = 38`; every other stack is restored (the table included).
Cost `≤ (n + n' + 1) (30 cU Z + 20000)` with `Z ≥ 1`, `Z ≥ zsz n, zsz n'`, `Z ≥ zsz (argOf l)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

theorem flat_bound {n n' : ℕ} {src : ℕ → Option ℕ} {argOf : ℕ → ℤ} {Z : ℕ} (hZ : 1 ≤ Z)
    (ha : ∀ l < n', zsz (argOf l) ≤ Z) : ∀ y ∈ flatC (J6Seg.ctlOf n n' src argOf), zsz y ≤ Z := by
  intro y hy
  simp only [flatC, List.mem_flatMap] at hy
  obtain ⟨c, hc, hy⟩ := hy
  rcases mem_ctlOf hc with rfl | rfl | ⟨l, hl, rfl⟩ <;>
    simp only [J6Seg.dropC, List.mem_cons, List.not_mem_nil, or_false] at hy <;>
    rcases hy with rfl | rfl
  · rw [zsz_neg, zsz_one]; exact hZ
  · rw [zsz_zero]; omega
  · rw [zsz_zero]; omega
  · rw [zsz_zero]; omega
  · rw [zsz_one]; exact hZ
  · exact ha l hl

theorem tab_bound {n n' : ℕ} {src : ℕ → Option ℕ} {argOf : ℕ → ℤ} (hs : J6Seg.MonoSrc n n' src)
    {Z : ℕ} (hZ : 1 ≤ Z) (hn : zsz (n : ℤ) ≤ Z) (ha : ∀ l < n', zsz (argOf l) ≤ Z) :
    ∀ y ∈ srcTab src argOf n', zsz y ≤ Z := by
  intro y hy
  simp only [srcTab, List.mem_flatMap, List.mem_range, List.mem_cons, List.not_mem_nil,
    or_false] at hy
  obtain ⟨l, hl, rfl | rfl⟩ := hy
  · cases hk : src l with
    | none => simp only [code]; rw [zsz_neg, zsz_one]; exact hZ
    | some k => exact le_trans (zsz_mono (by simp; exact (hs.1 l hl k hk).le)) hn
  · exact ha l hl

section main
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- **The control builder runs.** -/
theorem ctlB_runs_sol_aux (s : IState HS) (G : Fin HS → List ℤ) {n n' : ℕ} {src : ℕ → Option ℕ}
    (argOf : ℕ → ℤ) (hs : J6Seg.MonoSrc n n' src) {LX L1 L2 : List ℤ}
    (hX : G bX = srcTab src argOf n' ++ LX) (hN' : G bN' = (n' : ℤ) :: L1)
    (hN : G bN = (n : ℤ) :: L2) {Z : ℕ} (hZ : 1 ≤ Z) (hn : zsz (n : ℤ) ≤ Z)
    (hn' : zsz (n' : ℤ) ≤ Z) (ha : ∀ l < n', zsz (argOf l) ≤ Z)
    (hA : G lA = []) (hC : G lC = []) (hD : G lD = []) :
    IRuns I iprog ctlB (encK s G)
      (encK s (update (update G rNC (((n + n' : ℕ) : ℤ) :: G rNC)) rC
        (flatC (J6Seg.ctlOf n n' src argOf) ++ G rC)))
      (ctlCost Z n n') := by
  -- init
  have h0 := constM (I := I) (iprog := iprog) s
    (cS G (G bX) (G bSv) (G bCur) (G bT) (G bCd) (G bA) (G bD) (G bW)) bCur 0
  (simp only [J6Seg.Slab.cS_X, J6Seg.Slab.cS_Sv, J6Seg.Slab.cS_Cur, J6Seg.Slab.cS_T, J6Seg.Slab.cS_Cd, J6Seg.Slab.cS_A, J6Seg.Slab.cS_D, J6Seg.Slab.cS_W, J6Seg.Slab.cS_upd_X, J6Seg.Slab.cS_upd_Sv, J6Seg.Slab.cS_upd_Cur, J6Seg.Slab.cS_upd_T, J6Seg.Slab.cS_upd_Cd, J6Seg.Slab.cS_upd_A, J6Seg.Slab.cS_upd_D, J6Seg.Slab.cS_upd_W] at h0)
  rw [cS_self] at h0
  have e0 : cS G (G bX) (G bSv) (0 :: G bCur) (G bT) (G bCd) (G bA) (G bD) (G bW) =
      mS G src argOf n' LX 0 := by
    rw [mS, hX]; rfl
  rw [e0] at h0
  -- main loop
  have h1 := mainLoop_runs (I := I) (iprog := iprog) s G argOf hs LX hN' hZ hn ha hA hC hD
  have e1 : mS G src argOf n' LX n' = cS G LX ((srcTab src argOf n').reverse ++ G bSv)
      ((pos src argOf n' : ℤ) :: G bCur)
      ((flatC (J6Seg.ctlAux src argOf (List.range n') 0).1).reverse ++ G bT) (G bCd) (G bA)
      (G bD) (G bW) := by
    rw [mS, List.drop_of_length_le (by rw [length_srcTab])]; rfl
  rw [e1] at h1
  have hp := pos_le_n argOf hs (j := n') le_rfl
  -- final drops
  have h2 := finB_runs (I := I) (iprog := iprog) s G LX ((srcTab src argOf n').reverse ++ G bSv)
    (G bCur) ((flatC (J6Seg.ctlAux src argOf (List.range n') 0).1).reverse ++ G bT) (G bCd)
    (G bA) (G bD) (G bW) n (pos src argOf n') hN hp hn hA hC hD
  have e2 : (flatC (List.replicate (n - pos src argOf n') J6Seg.dropC)).reverse ++
      ((flatC (J6Seg.ctlAux src argOf (List.range n') 0).1).reverse ++ G bT) =
      (flatC (J6Seg.ctlOf n n' src argOf)).reverse ++ G bT := by
    rw [J6Seg.ctlOf, flatC_append, List.reverse_append, List.append_assoc]; rfl
  rw [e2] at h2
  -- the length
  have h3 := lenB_runs (I := I) (iprog := iprog) s G LX ((srcTab src argOf n').reverse ++ G bSv)
    (G bCur) ((flatC (J6Seg.ctlOf n n' src argOf)).reverse ++ G bT) (G bCd) (G bA) (G bD) (G bW)
    n n' hN' hN hn hn'
  obtain ⟨G1, hG1⟩ : ∃ G1, G1 = update G rNC (((n + n' : ℕ) : ℤ) :: G rNC) := ⟨_, rfl⟩
  rw [← hG1] at h3
  have g1 : ∀ r, r ≠ rNC → G1 r = G r := fun r hr => by rw [hG1, update_of_ne hr]
  -- the transfer
  have h4 := pairMove_runs (I := I) (iprog := iprog) (i := bT) (j := rC) (X := rNC) (by decide)
    (by decide)
    (fun A B => cS (update G1 rC B) LX ((srcTab src argOf n').reverse ++ G bSv) (G bCur) A
      (G bCd) (G bA) (G bD) (G bW))
    (fun A B => cS_T _ _ _ _ _ _ _ _ _)
    (fun A B => by
      rw [cS_G _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)
        (by decide) (by decide) (by decide), update_self])
    (fun A B v w => by
      rw [cS_upd_T, cS_upd_G _ _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide)
        (by decide) (by decide) (by decide) (by decide), update_idem])
    (fun A B => by rw [cS_lA, update_of_ne (by decide), g1 lA (by decide), hA])
    (fun A B => by rw [cS_lC, update_of_ne (by decide), g1 lC (by decide), hC])
    (fun A B => by rw [cS_lD, update_of_ne (by decide), g1 lD (by decide), hD])
    (n + n') (LM := G rNC)
    (fun A B => by
      rw [cS_G _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)
        (by decide) (by decide) (by decide), update_of_ne (by decide), hG1, update_self])
    (flatC (J6Seg.ctlOf n n' src argOf)) (G bT) (G rC)
    (by rw [length_flatC, length_ctlOf argOf hs]) (flat_bound hZ ha) s
  have eG1 : update G1 rC (G rC) = G1 := by
    rw [← g1 rC (by decide)]; exact update_eq_self _ _
  simp only [eG1] at h4
  obtain ⟨G2, hG2⟩ : ∃ G2, G2 = update G1 rC (flatC (J6Seg.ctlOf n n' src argOf) ++ G rC) :=
    ⟨_, rfl⟩
  rw [← hG2] at h4
  have g2 : ∀ r, r ≠ rC → r ≠ rNC → G2 r = G r := fun r h1 h2 => by
    rw [hG2, update_of_ne h1, g1 r h2]
  -- the restore
  have h5 := pairMove_runs (I := I) (iprog := iprog) (i := bSv) (j := bX) (X := bN') (by decide)
    (by decide)
    (fun A B => cS G2 B A (G bCur) (G bT) (G bCd) (G bA) (G bD) (G bW))
    (fun A B => cS_Sv _ _ _ _ _ _ _ _ _) (fun A B => cS_X _ _ _ _ _ _ _ _ _)
    (fun A B v w => by rw [cS_upd_Sv, cS_upd_X])
    (fun A B => by simp [g2 lA (by decide) (by decide), hA])
    (fun A B => by simp [g2 lC (by decide) (by decide), hC])
    (fun A B => by simp [g2 lD (by decide) (by decide), hD])
    n' (LM := L1)
    (fun A B => by
      rw [cS_G _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)
        (by decide) (by decide) (by decide), g2 bN' (by decide) (by decide), hN'])
    (srcTab src argOf n') (G bSv) LX (length_srcTab _ _ _) (tab_bound hs hZ hn ha) s
  have eF : cS G2 (srcTab src argOf n' ++ LX) (G bSv) (G bCur) (G bT) (G bCd) (G bA) (G bD)
      (G bW) = G2 := by
    rw [← hX, ← g2 bX (by decide) (by decide), ← g2 bSv (by decide) (by decide),
      ← g2 bCur (by decide) (by decide), ← g2 bT (by decide) (by decide),
      ← g2 bCd (by decide) (by decide), ← g2 bA (by decide) (by decide),
      ← g2 bD (by decide) (by decide), ← g2 bW (by decide) (by decide)]
    exact cS_self G2
  rw [eF] at h5
  rw [← hG1, ← hG2]
  refine (h0.seq (h1.seq (h2.seq (h3.seq (h4.seq h5))))).mono ?_
  have c0 := NLogN.KFUU.one_le_cU Z
  have hd : 4000 * (n - pos src argOf n' + 1) ≤ 4000 * (n + 1) := by omega
  have hz : zsz (0 : ℤ) + 2 = 2 := by rw [zsz_zero]
  unfold ctlCost
  nlinarith

end main

end J6Seg.Slab

end

theorem solution : type_of% @J6Seg.Slab.ctlB_runs_sol_aux := @J6Seg.Slab.ctlB_runs_sol_aux
