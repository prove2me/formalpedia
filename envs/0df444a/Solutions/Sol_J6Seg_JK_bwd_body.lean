/-!
# B-line IL, the `J` kernel (B4), part 2: specifications of multiplying register programs

`MSp M p s t c`: the multiplying register program `p : RM` (products through the
multiplication procedure with specification `M`) is executable from `s`, ends in `t` and costs
at most `c`; the analogue of `KIL.Sp`. Here: composition (`MSp.seq`), plain register programs
(`MSp.rs`), a multiplication on a managed state (`MSp.mul`: `Φm + O(X)` for `X`-bit operands,
given `MulBnd M X Φm`), the branch (`MSp.ite`), the counted loop through managed states
(`MSp.rep`, overhead quadratic only in the bit size of the *count*) and the compilation
(`MSp.irun`). Also `floorDivE` / `rsE`: the rounding `rs P` as linear work.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function

/-! ## Specifications -/

section msp
variable {M : MulSpec}

theorem MSp.mono {p : RM} {s t : IState HS} {c c' : ℕ} (h : MSp M p s t c) (hc : c ≤ c') :
    MSp M p s t c' := ⟨h.1, h.2.1, le_trans h.2.2 hc⟩

theorem MSp.congr {p : RM} {s t t' : IState HS} {c : ℕ} (h : MSp M p s t c) (e : t = t') :
    MSp M p s t' c := e ▸ h

theorem MSp.seq {a b : RM} {s t u : IState HS} {c1 c2 : ℕ} (ha : MSp M a s t c1)
    (hb : MSp M b t u c2) : MSp M (.seq a b) s u (c1 + c2) := by
  obtain ⟨ha1, ha2, ha3⟩ := ha
  obtain ⟨hb1, hb2, hb3⟩ := hb
  subst ha2
  refine ⟨⟨ha1, hb1⟩, ?_, ?_⟩
  · simp only [RM.run, hb2]
  · simp only [RM.cost]; omega

theorem MSp.rs {p : RS} {s t : IState HS} {c : ℕ} (h : Sp p s t c) : MSp M (.rs p) s t c :=
  ⟨h.1, h.2.1, h.2.2⟩

theorem MSp.skip (s : IState HS) : MSp M (.rs .skip) s s 1 := MSp.rs (Sp.skip s)

theorem MSp.ite {c : Ex HS} {a b : RM} {s t : IState HS} {cc B : ℕ} (hc : c.Clean)
    (hok : c.ok s) (hl : c.Lin) (hB : c.Bnd s B) (ha : c.eval s < 0 → MSp M a s t cc)
    (hb : ¬ c.eval s < 0 → MSp M b s t cc) :
    MSp M (.ite c a b) s t ((c.size + 1) * 2000 * (B + 2) + 2 * B + 30 + cc) := by
  have h1 := RS.pushCost_le_lin c s B hl hB
  have h2 := Ex.zsz_eval_le s B c hB
  by_cases h : c.eval s < 0
  · obtain ⟨o, r, k⟩ := ha h
    refine ⟨⟨hc, hok, by rw [if_pos h]; exact o⟩, by simp only [RM.run, if_pos h, r], ?_⟩
    simp only [RM.cost, if_pos h]; omega
  · obtain ⟨o, r, k⟩ := hb h
    refine ⟨⟨hc, hok, by rw [if_neg h]; exact o⟩, by simp only [RM.run, if_neg h, r], ?_⟩
    simp only [RM.cost, if_neg h]; omega

end msp

/-! ## The rounding as linear work -/

