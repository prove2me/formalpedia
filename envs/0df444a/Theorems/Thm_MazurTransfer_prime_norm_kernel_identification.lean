-- title:
--   A prime-order kernel element identifies both norm kernels
-- statement:
--   Let f and g be group endomorphisms whose kernel cardinalities are p and one in some order, where p is prime. If x belongs to the kernel of g and has exact order p, then the kernel of f is trivial and the kernel of g is the cyclic subgroup generated by x. Applied to the same represented order-thirteen Picard scheme, the checked infinity point identifies the two rational norm kernels. No finiteness or rank assumption on the whole group is required.
-- source:
--   Owned group argument, Apache-2.0. Named downstream consumer: exact rational kernels of the same represented order-thirteen Picard norm isogenies.

import Mathlib

theorem MazurTransfer.prime_norm_kernel_identification (G : Type) [Group G] (f g : G →* G) (p : ℕ)
    (hp : Nat.Prime p) (x : G) (hx : x ∈ g.ker) (ho : orderOf x = p)
    (hc : (Nat.card f.ker = p ∧ Nat.card g.ker = 1) ∨
      (Nat.card f.ker = 1 ∧ Nat.card g.ker = p)) :
    f.ker = ⊥ ∧ g.ker = Subgroup.zpowers x := by sorry
