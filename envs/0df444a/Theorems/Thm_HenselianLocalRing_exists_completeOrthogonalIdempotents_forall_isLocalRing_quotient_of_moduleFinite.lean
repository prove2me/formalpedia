-- title:
--   Module-finite algebras over henselian local rings split into local factors
-- statement:
--   Let $R$ be a commutative ring that is a henselian local ring, and let $S$ be a commutative $R$-algebra which is finite as an $R$-module. The assertion is that there exists a `Fintype` structure on `MaximalSpectrum S`, the set of maximal ideals of $S$ — so in particular $S$ has only finitely many maximal ideals — together with a family $(e_{\mathfrak m})_{\mathfrak m}$ of elements of $S$ indexed by the maximal ideals of $S$, such that: the family is a complete family of orthogonal idempotents in the sense of Mathlib's `CompleteOrthogonalIdempotents`, i.e. each $e_{\mathfrak m}$ is idempotent, $e_{\mathfrak m}e_{\mathfrak m'} = 0$ for $\mathfrak m \neq \mathfrak m'$, and the $e_{\mathfrak m}$ sum to $1$; each $e_{\mathfrak m}$ lies outside $\mathfrak m$; each $e_{\mathfrak m}$ lies in every other maximal ideal $\mathfrak m'$; and for each $\mathfrak m$ the quotient of $S$ by the ideal generated by $1 - e_{\mathfrak m}$ is a local ring. Thus $S$ decomposes as the finite product of the local rings $S/(1-e_{\mathfrak m})$, one for each maximal ideal.
--
--   This is the standard structure theorem for finite algebras over a henselian local ring: such an algebra is a finite product of local rings, with the factors indexed by its maximal ideals. It is used in the project's henselian toolkit, for instance to transport module-finiteness to localisations at primes, to construct ideals with prescribed prime behaviour over discrete valuation rings, and in the uniqueness statement for algebra maps out of finite étale algebras.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_HenselianLocalRing_exists_completeOrthogonalIdempotents_forall_isLocalRing_quotient_of_moduleFinite.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u v

theorem HenselianLocalRing.exists_completeOrthogonalIdempotents_forall_isLocalRing_quotient_of_moduleFinite
    {R : Type u} [CommRing R] [HenselianLocalRing R]
    {S : Type v} [CommRing S] [Algebra R S] [Module.Finite R S] :
    ∃ (_ : Fintype (MaximalSpectrum S)) (e : MaximalSpectrum S → S),
      CompleteOrthogonalIdempotents e ∧
      (∀ m : MaximalSpectrum S, e m ∉ m.asIdeal) ∧
      (∀ m m' : MaximalSpectrum S, m ≠ m' → e m ∈ m'.asIdeal) ∧
      (∀ m : MaximalSpectrum S, IsLocalRing (S ⧸ Ideal.span {1 - e m})) := by sorry
