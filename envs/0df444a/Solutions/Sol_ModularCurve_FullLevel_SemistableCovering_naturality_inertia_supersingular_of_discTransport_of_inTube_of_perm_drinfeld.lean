variable {K F : Type*} [Field K] [Field F] [Algebra K F] (g : SemilinearAut K F)

def semiSmulDisc (D : Set (Place K F)) : Set (Place K F) := {P | g⁻¹ • P ∈ D}

theorem mem_semiSmulDisc_iff (D : Set (Place K F)) (P : Place K F) : P ∈ semiSmulDisc g D ↔ g⁻¹ • P ∈ D := Iff.rfl

theorem smul_mem_semiSmulDisc_iff (D : Set (Place K F)) (P : Place K F) : g • P ∈ semiSmulDisc g D ↔ P ∈ D := by
  rw [mem_semiSmulDisc_iff, inv_smul_smul]

theorem forall_mem_of_forall_mem_semiSmul {D : Set (Place K F)} {f : F}
    (hreg : ∀ w ∈ SemilinearAut.semiSmulDisc g D, f ∈ w.toValuationSubring) :
    ∀ w ∈ D, g⁻¹ • f ∈ w.toValuationSubring := by
  intro w hw
  have h := hreg (g • w) ((smul_mem_semiSmulDisc_iff g D w).mpr hw)
  rwa [SemilinearAut.PlaceTransport.mem_smul_iff] at h

end Disc

