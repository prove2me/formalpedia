    (hb : ∀ k < m, IRuns I iprog p (ss k) (ss (k + 1)) c) :
    IRuns I iprog (.loop i f p) (ss 0) (ss m) (m * (c + 30) + 30) := by
  have := loop ss (fun _ => c) m hT hF hb
  simpa [Finset.sum_const, Finset.card_range, smul_eq_mul] using this

