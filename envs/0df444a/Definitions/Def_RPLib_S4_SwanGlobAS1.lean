-- title:
--   The valuation at infinity of $\mathbb{F}_q(x)$ is minus the degree
-- statement:
--   For the valuation ring $\mathcal{O}_\infty$ of $\mathbb{F}_q(x)$ at infinity with maximal ideal generated by $1/x$, the file identifies the additive $\infty$-adic valuation: $$v_\infty(f) = -\deg f$$ for polynomials $f \ne 0$, and $v_\infty(g) = \deg(\text{denominator}) - \deg(\text{numerator})$ for rational functions.
--
--   **Formalization note.** Library module of a formalization of the Ramanujan-Petersson conjecture (Swan conductors and wild ramification at infinity, used for Weil-type bounds of exponential sums). It contains definitions together with proved lemmas (no `sorry`), so that later solution files can import them.
-- source:
--   M. Rosen, Number Theory in Function Fields, GTM 210, Springer (2002), Chapter 5; H. Stichtenoth, Algebraic Function Fields and Codes, 2nd ed., GTM 254, Springer (2009), Section 3.7 (Artin-Schreier extensions)

import Mathlib
import Definitions.Def_RPLib_S4_SwanGlobPc

/-!
# S4-Swan (K2), part 21: the valuation at `∞` of `Fq(X)` is minus the degree

For the (unique) height-one prime `p` of `O_∞ ⊆ Fq(X)`, `adicAdd p x = -deg x` (`adicAdd_inf_eq`): `p = (1/X)`,
`v_p(1/X) = 1`, and `x / X^{deg x}` is a unit of `O_∞`.
-/

set_option autoImplicit false

noncomputable section

open IsDedekindDomain Polynomial

namespace RamanujanPetersson

namespace Swan

section InfVal

variable {Fq : Type} [Field Fq] [DecidableEq (RatFunc Fq)] (p : HeightOneSpectrum (Places.Oinf Fq))

theorem asIdeal_eq_span_piInf : p.asIdeal = Ideal.span {Places.piInf Fq} := by
  rw [IsLocalRing.eq_maximalIdeal (p.isPrime.isMaximal p.ne_bot),
    IsLocalRing.eq_maximalIdeal (Places.span_piInf_isMaximal Fq)]

theorem adicAdd_piInf :
    adicAdd p (algebraMap (Places.Oinf Fq) (RatFunc Fq) (Places.piInf Fq)) = 1 := by
  have h0 : algebraMap (Places.Oinf Fq) (RatFunc Fq) (Places.piInf Fq) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 (Places.piInf_ne_zero Fq)
  rw [adicAdd_apply, negLogV_of_ne p h0, HeightOneSpectrum.valuation_of_algebraMap,
    HeightOneSpectrum.intValuation_singleton p (Places.piInf_ne_zero Fq) (asIdeal_eq_span_piInf p)]
  simp

theorem adicAdd_eq_zero_of_mem {u : RatFunc Fq} (hu : u ∈ Places.Oinf Fq) (hu' : u⁻¹ ∈ Places.Oinf Fq)
    (h0 : u ≠ 0) : adicAdd p u = 0 := by
  have ha : 0 ≤ adicAdd p u := adicAdd_algebraMap_nonneg p (⟨u, hu⟩ : Places.Oinf Fq)
  have hb : 0 ≤ adicAdd p u⁻¹ := adicAdd_algebraMap_nonneg p (⟨u⁻¹, hu'⟩ : Places.Oinf Fq)
  have hs : adicAdd p u + adicAdd p u⁻¹ = 0 := by
    rw [← AddValuation.map_mul, mul_inv_cancel₀ h0, AddValuation.map_one]
  exact ((add_eq_zero_iff_of_nonneg ha hb).1 hs).1

theorem adicAdd_polynomial {P : Fq[X]} (hP : P ≠ 0) :
    adicAdd p (algebraMap Fq[X] (RatFunc Fq) P) = ((-(P.natDegree : ℤ) : ℤ) : WithTop ℤ) := by
  set n := P.natDegree
  have hXn : (X ^ n : Fq[X]) ≠ 0 := pow_ne_zero _ X_ne_zero
  have hX : algebraMap Fq[X] (RatFunc Fq) (X ^ n) ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hXn
  have hP' : algebraMap Fq[X] (RatFunc Fq) P ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective _ _)).2 hP
  set w := algebraMap Fq[X] (RatFunc Fq) P / algebraMap Fq[X] (RatFunc Fq) (X ^ n) with hw_def
  have hw0 : w ≠ 0 := div_ne_zero hP' hX
  have hw : w ∈ Places.Oinf Fq := by
    rw [Places.mem_Oinf_iff' Fq hw0, hw_def, Places.intDegree_div_polys Fq hP hXn, natDegree_X_pow, sub_self]
  have hw' : w⁻¹ ∈ Places.Oinf Fq := by
    rw [Places.mem_Oinf_iff' Fq (inv_ne_zero hw0), hw_def, inv_div,
      Places.intDegree_div_polys Fq hXn hP, natDegree_X_pow, sub_self]
  have hv := adicAdd_eq_zero_of_mem p hw hw' hw0
  have hpi : algebraMap Fq[X] (RatFunc Fq) (X ^ n) =
      (algebraMap (Places.Oinf Fq) (RatFunc Fq) (Places.piInf Fq))⁻¹ ^ n := by
    rw [map_pow, inv_pow]
    show _ = ((1 / RatFunc.X : RatFunc Fq) ^ n)⁻¹
    rw [one_div, inv_pow, inv_inv, RatFunc.algebraMap_X]
  have he : algebraMap Fq[X] (RatFunc Fq) P = w * algebraMap Fq[X] (RatFunc Fq) (X ^ n) :=
    (div_mul_cancel₀ _ hX).symm
  rw [he, AddValuation.map_mul, hv, zero_add, hpi, AddValuation.map_pow, AddValuation.map_inv, adicAdd_piInf,
    show (-(1 : WithTop ℤ)) = ((-1 : ℤ) : WithTop ℤ) from rfl, ← WithTop.coe_nsmul]
  congr 1
  simp

/-- **The valuation at `∞`:** `v_∞(x) = -deg x`. -/
theorem adicAdd_inf_eq {x : RatFunc Fq} (hx : x ≠ 0) :
    adicAdd p x = ((-x.intDegree : ℤ) : WithTop ℤ) := by
  have hn : x.num ≠ 0 := RatFunc.num_ne_zero hx
  have hd : x.denom ≠ 0 := x.denom_ne_zero
  have hdeg := Places.intDegree_div_polys Fq hn hd
  rw [RatFunc.num_div_denom x] at hdeg
  conv_lhs => rw [← RatFunc.num_div_denom x]
  rw [AddValuation.map_div, adicAdd_polynomial p hn, adicAdd_polynomial p hd, hdeg,
    ← WithTop.LinearOrderedAddCommGroup.coe_sub]
  congr 1
  ring

end InfVal

end Swan

end RamanujanPetersson


