/-- **`EpsOK` for row exponents** on `Fin m × Fin f` (the frozen `epsOK_tab`, any `m`). -/
theorem epsOK_tabM_sol_aux {m f : ℕ} (hm : 0 < m) {σ : Fin HS → Option ℤ} {s : IState HS}
    (hs : Agree σ s) {eR KR NR fR : Fin HS} {e K : ℕ} (hR : AffReg σ eR KR NR e K (m * f))
    (hf : σ fR = some (f : ℤ)) (hfS : fR ≠ KFW.kS)
    (hlt : eR.val < 56 ∧ KR.val < 56 ∧ NR.val < 56 ∧ fR.val < 56)
    (hK : 0 < K) (hf0 : 0 < f) (hN : K * (m * f - 1) ≤ e) (a : Fin m → ℕ) (t Bε : ℕ)
    (hB : zsz (((e + t + K + m * f + f : ℕ)) : ℤ) ≤ Bε) (h3 : zsz (3 : ℤ) ≤ Bε) :
    EpsOK s (εTab eR KR NR fR (List.ofFn a)) t
      (aEof (fun p : Fin m × Fin f => e - K * (p.2.val + f * p.1.val)) (fun p => a p.1)) Bε := by
  refine ⟨clean_of_lt (fun j hj => ?_), fun k hk g hgk hfr => ?_⟩
  · rcases εTab_regs _ _ _ _ _ j hj with rfl | rfl | rfl | rfl | rfl
    · exact hlt.1
    · decide
    · exact hlt.2.1
    · exact hlt.2.2.1
    · exact hlt.2.2.2
  have mem := εTab_mem eR KR NR fR (List.ofFn a)
    (List.ne_nil_of_length_pos (by rw [List.length_ofFn]; exact hm))
  obtain ⟨t1, t2, t3, t4, t5, t6, t7, t8⟩ := aff_tops hs hR hgk
    (hfr _ mem.1 hR.eS) (hfr _ mem.2.1 hR.KS) (hfr _ mem.2.2.1 hR.NS)
  obtain ⟨t9, t10⟩ := agree_top_encK hs hf (hfr _ mem.2.2.2 hfS)
  have hBB : zsz (((e + k + K + m * f : ℕ)) : ℤ) ≤ Bε := le_trans (zsz_nat_le (by omega)) hB
  obtain ⟨o, ev, b⟩ := εAff_spec (encK s g) eR KR NR (fun x => lookL (List.ofFn a) 0
      (.ndiv x (.reg fR))) e k K (m * f) Bε hK t1 t2 t3 t4 t5 t6 t7 t8 hBB
    (fun q => (((List.ofFn a).getD (q / f) 0 % 4 : ℕ) : ℤ)) (fun x q hq xo xe xb => by
      have hqf : q / f < m := (Nat.div_lt_iff_lt_mul hf0).2 hq
