/-- **The slot selected bits are compatible with the slot layout.** -/
theorem slot_compat (hS : SlotArr D a arr) (h : ℕ) (P : Finset (Fin D)) (hP : ∀ i ∈ P, h < a i) :
    SelCompat (slotLayout hS) h P (slotSel hS h P hP) where
  bits_eq v hv i := by
    apply Fin.ext
    rw [slotSel, posSel_bits _ hv]
    show v.getD (spos D arr i.1 h) 0 = (getBit h (coordS D a arr v i.1) : ℕ)
    unfold coordS
    rw [getBit_bitsum _ (fun t => valid_getD_lt_two hv _) _ _ (hP i.1 i.2)]
  set_eq v hv yb := by
    have hl := (valid_binSh_iff.1 hv).1
    funext j
    show coordS D a arr ((slotPos hS h P hP).setL v yb) j = _
    unfold coordS
    have hval : ∀ t ∈ range (a j), ((slotPos hS h P hP).setL v yb).getD (spos D arr j t) 0 =
        (slotPos hS h P hP).val v yb (spos D arr j t) := fun t ht =>
      (slotPos hS h P hP).getD_setL v yb (by rw [hl]; exact hS.spos_lt (mem_range.1 ht))
    rw [sum_congr rfl (fun t ht => by rw [hval t ht])]
    by_cases hj : j ∈ P
    · rw [dif_pos hj]
      show _ = setBit h (∑ t ∈ range (a j), v.getD (spos D arr j t) 0 * 2 ^ t) (yb ⟨j, hj⟩)
      rw [← bitsum_update _ (fun t => valid_getD_lt_two hv _) (hP j hj)]
      apply sum_congr rfl
      intro t ht
      have ht' := mem_range.1 ht
      by_cases hth : t = h
      · subst hth
        rw [if_pos rfl]
        exact congrArg (· * 2 ^ t) ((slotPos hS t P hP).val_pos v yb ⟨j, hj⟩)
      · rw [if_neg hth, (slotPos hS h P hP).val_of_not v yb]
        intro i hi
        exact hth (hS.spos_inj (hP i.1 i.2) ht' hi).2.symm
    · rw [dif_neg hj]
      apply sum_congr rfl
      intro t ht
      rw [(slotPos hS h P hP).val_of_not v yb]
      intro i hi
      have := (hS.spos_inj (hP i.1 i.2) (mem_range.1 ht) hi).1
      exact hj (this ▸ i.2)

