theorem GlobalTheory.AinfXi.exists_order (x : Ainf p O) (hx : x ≠ 0) :
    ∃ (N : ℕ) (y : Ainf p O), x = xi ε ^ N * y ∧ fontaineTheta O p y ≠ 0 := by sorry
