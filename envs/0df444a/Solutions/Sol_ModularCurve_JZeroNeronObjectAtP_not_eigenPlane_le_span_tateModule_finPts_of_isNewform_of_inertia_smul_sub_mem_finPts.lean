            (algebraMap ℤ_[lam] O'' c + (val : O'')) := by ring
      rw [hfac]
      exact Ideal.mul_mem_right _ _ hcval
    have h2 : ((val ^ 2 : ℕ) : O'') - (val : O'') =
        -((algebraMap ℤ_[lam] O'' c) ^ 2 - ((val : O'')) ^ 2) + (d - (val : O'')) := by
      rw [hd]; push_cast; ring
    rw [h2]
