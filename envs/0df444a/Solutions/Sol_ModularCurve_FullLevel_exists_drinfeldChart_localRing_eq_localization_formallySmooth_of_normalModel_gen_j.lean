theorem solution
    (q : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' (ResidueField A))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (π : AlgebraicClosure ℚ) (hπ : π ^ (q ^ 2 - 1) = (q : AlgebraicClosure ℚ)) (hπP : π ∈ A)
    (ζ : Idx q)
    (OIg : CuspidalType.ProjLine q → ValuationSubring (fieldBar q M'))
    (OSS : ↥W → ValuationSubring (fieldBar q M'))

    (hIg_inf : ∀ f : fieldBar q M', f ∈ OIg (lineInfty q) ↔
      ∃ x y : LaurentSeries A, coeffMap (IsLocalRing.residue A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    (hIg : ∀ ℓ, ∃ γ : SL(2, ℤ), γ ∈ Gamma0 M' ∧ redQ q γ • lineInfty q = ℓ ∧
      OIg ℓ = (OIg (lineInfty q)).comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom)
    (hIg_inj : Function.Injective OIg)
    (hIg_perm : ∀ (ζ' : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' →
      ∃ σ : Equiv.Perm (CuspidalType.ProjLine q),
        ∀ ℓ, (OIg ℓ).comap (levelAutBar q M' ζ' γ).toAlgHom.toRingHom = OIg (σ ℓ))

    (hSS_A : ∀ s (x : AlgebraicClosure ℚ), algebraMap (AlgebraicClosure ℚ) (fieldBar q M') x ∈ OSS s ↔ x ∈ A)
    (hSS_over : ∀ (s : ↥W) (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
      (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) → 0 ≤ P.ord (f : ↥(modularFunctionFieldBar M'))) →
      (R₀.residue ⟨f, hf⟩ : modularFunctionFieldC (ResidueField A) M') ∈
          (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
        (IntermediateField.inclusion hle f : fieldBar q M') ∈ OSS s ∧
        ∀ a : A, residue A a =
            (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨f, hf⟩) →
          ∃ h : (IntermediateField.inclusion hle f : fieldBar q M')
              - algebraMap (AlgebraicClosure ℚ) (fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OSS s,
            (⟨_, h⟩ : OSS s) ∈ maximalIdeal (OSS s))
    (hSS_fix : ∀ (s : ↥W) (ζ' : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' →
      (OSS s).comap (levelAutBar q M' ζ' γ).toAlgHom.toRingHom = OSS s)

    (hSS_tr : ∀ s : ↥W, ∃ t : fieldBar q M', t ∈ OSS s ∧ ∀ a : A,
      ∃ h : t - algebraMap (AlgebraicClosure ℚ) (fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OSS s, IsUnit (⟨_, h⟩ : OSS s))

    (K₀ : Subfield (AlgebraicClosure ℚ)) [Algebra.IsAlgebraic ↥K₀ (AlgebraicClosure ℚ)] (hπK₀ : π ∈ K₀)
    (A₀ : Type) [CommRing A₀] [IsDomain A₀] [IsDiscreteValuationRing A₀] [HenselianLocalRing A₀]
    (ι : A₀ →+* ↥A) [IsLocalHom ι] (hι : Function.Injective ι)
    (hιK₀ : Set.range (fun a : A₀ => ((ι a : ↥A) : AlgebraicClosure ℚ)) =
      (A : Set (AlgebraicClosure ℚ)) ∩ (K₀ : Set (AlgebraicClosure ℚ)))
    (hres : Function.Surjective ((IsLocalRing.residue ↥A).comp ι))
    (ϖ₀ : A₀) (hϖ₀ : maximalIdeal A₀ = Ideal.span {ϖ₀})

    (hϖ₀π : ((ι ϖ₀ : ↥A) : AlgebraicClosure ℚ) = π)

    (F₀ : Subfield ↥(fieldBar q M'))
    (hF₀ : ∀ f : ↥(fieldBar q M'), f ∈ F₀ ↔ ∀ n : ℤ, ((f : ↥(fieldBar q M')) : LaurentSeries (AlgebraicClosure ℚ)).coeff n ∈ K₀)

    (hjF₀ : (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) ∈ F₀)

    [Algebra A₀ ↥F₀]
    (hj₀ : ∀ a : A₀, ((algebraMap A₀ ↥F₀ a : ↥F₀) : ↥(fieldBar q M')) =
      algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') ((ι a : ↥A) : AlgebraicClosure ℚ))

    (X₀ : Scheme.{0}) (toBase₀ : X₀ ⟶ Spec (CommRingCat.of A₀))
    [IsIntegral X₀] [IsProper toBase₀] [Flat toBase₀] [LocallyOfFinitePresentation toBase₀]
    (hn₀ : ∀ y : X₀, IsIntegrallyClosed (X₀.presheaf.stalk y))
    (φ₀ : ↥F₀ ≃+* X₀.functionField)
    (hφ₀ : ∀ a : A₀, φ₀ (algebraMap A₀ ↥F₀ a) = SemistableModel.baseToFunctionField toBase₀ a)
    (hdim : ∀ η y : X₀, toBase₀.base η = closedPoint A₀ → (∃ z : X₀, η ⤳ z ∧ z ≠ η) → η ⤳ y → y ≠ η →
      ∀ z : X₀, y ⤳ z → z = y)

    (gen : CuspidalType.ProjLine q ⊕ ↥W → X₀)
    (hgenIg : ∀ ℓ (f : ↥F₀), f ∈ SemistableModel.localRing X₀ φ₀ (gen (Sum.inl ℓ)) ↔ (f : ↥(fieldBar q M')) ∈ OIg ℓ)
    (hgenSS : ∀ s (f : ↥F₀), f ∈ SemistableModel.localRing X₀ φ₀ (gen (Sum.inr s)) ↔ (f : ↥(fieldBar q M')) ∈ OSS s)
    (hgen₀ : ∀ i, toBase₀.base (gen i) = closedPoint A₀)
    (hgen : ∀ x : X₀, toBase₀.base x = closedPoint A₀ → ((∃ i, x = gen i) ↔ ∃ y : X₀, x ⤳ y ∧ y ≠ x))
    (s : ↥W) :

    gen (Sum.inr s) ∈ toBase₀.smoothLocus ∧

    (∀ x₀ : X₀, toBase₀.base x₀ = closedPoint A₀ → (∀ y : X₀, x₀ ⤳ y → y = x₀) →
      gen (Sum.inr s) ⤳ x₀ → (∀ ℓ : CuspidalType.ProjLine q, ¬ gen (Sum.inl ℓ) ⤳ x₀) →
      ∃ (B : Subalgebra A₀ ↥F₀) (𝔪 : Ideal ↥B) (_ : 𝔪.IsMaximal),

        B.FG ∧
        (∀ x : ↥F₀, _root_.IsIntegral ↥B x → x ∈ B) ∧
        (∀ x : ↥F₀, ∃ b c : ↥F₀, b ∈ B ∧ c ∈ B ∧ c ≠ 0 ∧ x * c = b) ∧
        (∀ 𝔮 : Ideal ↥B, 𝔮.IsPrime → Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) ≤ 𝔮 → ¬ 𝔮.IsMaximal →
          𝔮 ∈ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)).minimalPrimes) ∧

        (∀ 𝔭 : Ideal ↥B, 𝔭.IsPrime → 𝔭 ≠ ⊥ → ¬ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) ≤ 𝔭) →
          ∃ V : ValuationSubring ↥F₀, ∀ f : ↥F₀, f ∈ V ↔ ∃ b c : ↥B, c ∉ 𝔭 ∧ f * (c : ↥F₀) = (b : ↥F₀)) ∧
        (∀ η : X₀, toBase₀.base η = closedPoint A₀ → (∃ y : X₀, η ⤳ y ∧ y ≠ η) →
          (B : Set ↥F₀) ⊆ SemistableModel.localRing X₀ φ₀ η →
            ∃ 𝔮 : Ideal ↥B, 𝔮.IsPrime ∧ ∀ x : ↥F₀, x ∈ SemistableModel.localRing X₀ φ₀ η ↔
              ∃ b c : ↥B, c ∉ 𝔮 ∧ x * (c : ↥F₀) = (b : ↥F₀)) ∧
        (∀ 𝔮 : Ideal ↥B, 𝔮 ∈ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)).minimalPrimes →
          ∃ η : X₀, toBase₀.base η = closedPoint A₀ ∧ (∃ y : X₀, η ⤳ y ∧ y ≠ η) ∧
            ∀ x : ↥F₀, x ∈ SemistableModel.localRing X₀ φ₀ η ↔ ∃ b c : ↥B, c ∉ 𝔮 ∧ x * (c : ↥F₀) = (b : ↥F₀)) ∧

        (⟨_, hjF₀⟩ : ↥F₀) ∈ B ∧

        (∀ i, (B : Set ↥F₀) ⊆ SemistableModel.localRing X₀ φ₀ (gen i) → i = Sum.inr s) ∧

        (∀ f : ↥F₀, f ∈ SemistableModel.localRing X₀ φ₀ x₀ ↔ ∃ b c : ↥B, c ∉ 𝔪 ∧ f * (c : ↥F₀) = (b : ↥F₀)) ∧

        (algebraMap A₀ (Localization.AtPrime 𝔪)).FormallySmooth) := by
  classical

  have mem_OIgF : ∀ (ℓ' : CuspidalType.ProjLine q) (f : ↥F₀),
      f ∈ (OIg ℓ').comap F₀.subtype ↔ (f : ↥(fieldBar q M')) ∈ OIg ℓ' := fun _ _ => ValuationSubring.mem_comap
  have mem_OSSF : ∀ (s' : ↥W) (f : ↥F₀),
      f ∈ (OSS s').comap F₀.subtype ↔ (f : ↥(fieldBar q M')) ∈ OSS s' := fun _ _ => ValuationSubring.mem_comap
  have hIgLR : ∀ ℓ', ((OIg ℓ').comap F₀.subtype).toSubring =
      SemistableModel.localRing X₀ φ₀ (gen (Sum.inl ℓ')) := by
    intro ℓ'; ext f; exact (mem_OIgF ℓ' f).trans (hgenIg ℓ' f).symm
  have hSSLR : ∀ s', ((OSS s').comap F₀.subtype).toSubring =
      SemistableModel.localRing X₀ φ₀ (gen (Sum.inr s')) := by
    intro s'; ext f; exact (mem_OSSF s' f).trans (hgenSS s' f).symm
  have hgen_nc : ∀ i, ∃ y : X₀, gen i ⤳ y ∧ y ≠ gen i := fun i => (hgen (gen i) (hgen₀ i)).mp ⟨i, rfl⟩

  have hval : ∀ η : X₀, toBase₀.base η = closedPoint A₀ → (∃ y : X₀, η ⤳ y ∧ y ≠ η) →
      ∃ V : ValuationSubring ↥F₀, V.toSubring = SemistableModel.localRing X₀ φ₀ η := by
    intro η hη hnc
    obtain ⟨i, rfl⟩ := (hgen η hη).mpr hnc
    rcases i with ℓ' | s'
    · exact ⟨_, hIgLR ℓ'⟩
    · exact ⟨_, hSSLR s'⟩

  have eq_of_dom : ∀ (V : ValuationSubring ↥F₀) (x y : X₀),
      SSN.LR X₀ φ₀ x ≤ V.toLocalSubring → SSN.LR X₀ φ₀ y ≤ V.toLocalSubring → x = y := by
    intro V x y hx hy
    exact AlgebraicGeometry.Scheme.eq_of_forall_mem_valuationSubring_of_isSeparated toBase₀
      (V.comap (φ₀.symm : X₀.functionField ≃+* ↥F₀).toRingHom) x y
      (SSN.centre_of_LR_le x V hx).1 (SSN.centre_of_LR_le x V hx).2
      (SSN.centre_of_LR_le y V hy).1 (SSN.centre_of_LR_le y V hy).2

  have gen_dom : ∀ s', SSN.LR X₀ φ₀ (gen (Sum.inr s')) ≤ ((OSS s').comap F₀.subtype).toLocalSubring := by
    intro s'
    refine ⟨(hSSLR s').ge, ⟨fun a ha => ?_⟩⟩
    obtain ⟨v, hv⟩ := ha.exists_right_inv
    have hv' : (a : ↥F₀) * (v : ↥F₀) = 1 := congrArg Subtype.val hv
    have hvmem : (v : ↥F₀) ∈ SemistableModel.localRing X₀ φ₀ (gen (Sum.inr s')) := (hSSLR s') ▸ v.2
    exact ⟨⟨a, ⟨v, hvmem⟩, Subtype.ext hv', Subtype.ext (by rw [mul_comm] at hv'; exact hv')⟩, rfl⟩

  have const_mem : ∀ (x : X₀) (a : A₀), algebraMap A₀ ↥F₀ a ∈ SemistableModel.localRing X₀ φ₀ x := by
    intro x a
    refine ⟨(X₀.presheaf.germ ⊤ x trivial).hom (toBase₀.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv.hom a)), ?_⟩
    change SSN.θ X₀ φ₀ x _ = _
    rw [SSN.θ_germ_appTop, ← hφ₀, RingEquiv.symm_apply_apply]
  have ϖ₀_nonunit : ∀ (x : X₀), toBase₀.base x = closedPoint A₀ → ∀ (V : ValuationSubring ↥F₀),
      SSN.LR X₀ φ₀ x ≤ V.toLocalSubring → algebraMap A₀ ↥F₀ ϖ₀ ∈ V.nonunits := by
    intro x hx V hV
    have hϖ : ϖ₀ ∈ maximalIdeal A₀ := by rw [hϖ₀]; exact Ideal.subset_span rfl
    have h1 := SSN.not_isUnit_germ_of_base_eq_closedPoint X₀ toBase₀ x hx ϖ₀ hϖ
    apply SSN.mem_nonunits_of_LR_le x V hV _ (const_mem x ϖ₀)
    intro hu
    apply h1
    have heq : SSN.locEquiv X₀ φ₀ x ((X₀.presheaf.germ ⊤ x trivial).hom
        (toBase₀.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv.hom ϖ₀))) =
          ⟨algebraMap A₀ ↥F₀ ϖ₀, const_mem x ϖ₀⟩ := by
      apply Subtype.ext
      change SSN.θ X₀ φ₀ x _ = _
      rw [SSN.θ_germ_appTop, ← hφ₀, RingEquiv.symm_apply_apply]
    have hu' : IsUnit (SSN.locEquiv X₀ φ₀ x ((X₀.presheaf.germ ⊤ x trivial).hom
        (toBase₀.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A₀)).inv.hom ϖ₀)))) := by rw [heq]; exact hu
    exact (MulEquiv.isUnit_map (SSN.locEquiv X₀ φ₀ x).toMulEquiv).mp hu'

  have base_closed : ∀ (i : CuspidalType.ProjLine q ⊕ ↥W) (z : X₀), gen i ⤳ z → toBase₀.base z = closedPoint A₀ := by
    intro i z hz
    have h1 : toBase₀.base (gen i) ⤳ toBase₀.base z := hz.map toBase₀.base.hom.continuous
    rw [hgen₀] at h1
    have h2 := (specializes_iff_mem_closure).mp h1
    exact Set.mem_singleton_iff.mp (closure_minimal (Set.Subset.refl _) (isClosed_singleton_closedPoint _) h2)

  have place : ∀ x : X₀, (∀ y : X₀, x ⤳ y → y = x) → gen (Sum.inr s) ⤳ x →
      ∃ V : ValuationSubring ↥F₀, SSN.LR X₀ φ₀ x ≤ V.toLocalSubring ∧
        (∀ f : ↥F₀, f ∈ V → (f : ↥(fieldBar q M')) ∈ OSS s) ∧
        (∃ f : ↥F₀, (f : ↥(fieldBar q M')) ∈ OSS s ∧ f ∉ V) := by
    intro x hcl hsp
    obtain ⟨V, hVO, hVR⟩ := ValuationSubring.exists_le_and_le_toLocalSubring_of_toSubring_le
      ((OSS s).comap F₀.subtype) (SSN.LR X₀ φ₀ x)
      (by rw [SSN.LR_toSubring, hSSLR]; exact SSN.localRing_le_of_specializes X₀ φ₀ hsp)
    refine ⟨V, hVR, fun f hf => (mem_OSSF s f).mp (hVO hf), ?_⟩
    by_contra hne
    have hall : ∀ f : ↥F₀, (f : ↥(fieldBar q M')) ∈ OSS s → f ∈ V := fun f hf => by
      by_contra h; exact hne ⟨f, hf, h⟩
    have hVeq : V = (OSS s).comap F₀.subtype :=
      le_antisymm hVO (fun f hf => hall f ((mem_OSSF s f).mp hf))
    have hxg : x = gen (Sum.inr s) := eq_of_dom V x _ hVR (hVeq ▸ gen_dom s)
    obtain ⟨y, hy, hyne⟩ := hgen_nc (Sum.inr s)
    exact hyne (by rw [← hxg] at hy ⊢; exact hcl y hy)

  obtain ⟨B, hfg, hn, hfrac, hdimB, hgenB, hJ, hBSS, ⟨𝔮₀, h𝔮₀, h𝔮₀loc, hmin⟩, hcIg, hcSS, hsmB, hends⟩ :=
    ModularCurve.FullLevel.exists_subalgebra_drinfeldRing_iff_localization_formallySmooth_card_le_descent
      q hq M' hqM' A hA W hW hle R₀ hR₀ π hπ hπP ζ OIg OSS hIg_inf hIg hIg_inj hIg_perm hSS_A hSS_over hSS_fix hSS_tr K₀ hπK₀ A₀ ι hι hιK₀ hres ϖ₀ hϖ₀ hϖ₀π F₀ hF₀ hjF₀ hj₀ s
  haveI : Algebra.FormallySmooth A₀ ↥B := hsmB
  have hsm : ∀ (𝔪 : Ideal ↥B) [𝔪.IsPrime], (algebraMap A₀ (Localization.AtPrime 𝔪)).FormallySmooth :=
    fun 𝔪 _ => RingHom.formallySmooth_algebraMap.mpr inferInstance
  have one_mem : ∀ (𝔪 : Ideal ↥B), 𝔪.IsMaximal → (1 : ↥B) ∉ 𝔪 := fun 𝔪 h𝔪 h => h𝔪.ne_top ((Ideal.eq_top_iff_one _).mpr h)

  have hcomp : ∀ η : X₀, toBase₀.base η = closedPoint A₀ → (∃ y : X₀, η ⤳ y ∧ y ≠ η) →
      (B : Set ↥F₀) ⊆ SemistableModel.localRing X₀ φ₀ η →
        ∃ 𝔮 : Ideal ↥B, 𝔮.IsPrime ∧ ∀ x : ↥F₀, x ∈ SemistableModel.localRing X₀ φ₀ η ↔
          ∃ b c : ↥B, c ∉ 𝔮 ∧ x * (c : ↥F₀) = (b : ↥F₀) := by
    intro η hη hnc hBη
    obtain ⟨i, rfl⟩ := (hgen η hη).mpr hnc
    rcases i with ℓ' | s'
    · exact (hcIg ℓ' (fun b => (hgenIg ℓ' _).mp (hBη b.2))).elim
    · have hs' : s' = s := hcSS s' (fun b => (hgenSS s' _).mp (hBη b.2))
      subst hs'
      exact ⟨𝔮₀, h𝔮₀, fun f => (hgenSS s' f).trans (h𝔮₀loc f)⟩
  have hcomp' : ∀ 𝔮 : Ideal ↥B, 𝔮 ∈ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)).minimalPrimes →
      ∃ η : X₀, toBase₀.base η = closedPoint A₀ ∧ (∃ y : X₀, η ⤳ y ∧ y ≠ η) ∧
        ∀ x : ↥F₀, x ∈ SemistableModel.localRing X₀ φ₀ η ↔ ∃ b c : ↥B, c ∉ 𝔮 ∧ x * (c : ↥F₀) = (b : ↥F₀) := by
    intro 𝔮 h𝔮m
    have h := hmin 𝔮 h𝔮m
    subst h
    exact ⟨gen (Sum.inr s), hgen₀ _, hgen_nc _, fun f => (hgenSS s f).trans (h𝔮₀loc f)⟩
  have hcentre : ∀ i, (B : Set ↥F₀) ⊆ SemistableModel.localRing X₀ φ₀ (gen i) → i = Sum.inr s := by
    intro i hBi
    rcases i with ℓ' | s'
    · exact (hcIg ℓ' (fun b => (hgenIg ℓ' _).mp (hBi b.2))).elim
    · exact congrArg Sum.inr (hcSS s' (fun b => (hgenSS s' _).mp (hBi b.2)))

  have good : ∀ (x : X₀), toBase₀.base x = closedPoint A₀ → ∀ (V : ValuationSubring ↥F₀),
      SSN.LR X₀ φ₀ x ≤ V.toLocalSubring →
      (∃ f : ↥F₀, (f : ↥(fieldBar q M')) ∈ OSS s ∧ f ∉ V) →
      (∀ b : ↥B, (b : ↥F₀) ∈ V) →
      ∃ (𝔪 : Ideal ↥B) (_ : 𝔪.IsMaximal), algebraMap A₀ ↥B ϖ₀ ∈ 𝔪 ∧
        (∀ f : ↥F₀, f ∈ SemistableModel.localRing X₀ φ₀ x ↔ ∃ b c : ↥B, c ∉ 𝔪 ∧ f * (c : ↥F₀) = (b : ↥F₀)) := by
    intro x hx V hVR hVlt hBV

    let φV : ↥B →+* ↥V :=
      { toFun := fun b => ⟨(b : ↥F₀), hBV b⟩
        map_one' := Subtype.ext (by simp)
        map_mul' := fun a b => Subtype.ext (by simp)
        map_zero' := Subtype.ext (by simp)
        map_add' := fun a b => Subtype.ext (by simp) }
    let 𝔪 : Ideal ↥B := (maximalIdeal ↥V).comap φV
    have hcen : ∀ b : ↥B, b ∈ 𝔪 ↔ (b : ↥F₀) ∈ V.nonunits := by
      intro b
      change φV b ∈ maximalIdeal ↥V ↔ _
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact (ValuationSubring.coe_mem_nonunits_iff (a := (⟨(b : ↥F₀), hBV b⟩ : ↥V))).symm
    have h𝔪p : 𝔪.IsPrime := Ideal.comap_isPrime φV (maximalIdeal ↥V)
    have hϖ𝔪 : algebraMap A₀ ↥B ϖ₀ ∈ 𝔪 :=
      (hcen _).mpr (by simpa using ϖ₀_nonunit x hx V hVR)
    have h𝔭 : Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) ≤ 𝔪 := by
      rw [hϖ₀, Ideal.map_span, Set.image_singleton, Ideal.span_le, Set.singleton_subset_iff]
      exact hϖ𝔪

    have h𝔪 : 𝔪.IsMaximal := by
      by_contra hnm
      have hmem := hdimB 𝔪 h𝔪p h𝔭 hnm
      have heq : 𝔪 = 𝔮₀ := hmin 𝔪 hmem
      obtain ⟨f, hfS, hfV⟩ := hVlt
      apply hfV
      obtain ⟨b, c, hc, hfc⟩ := (h𝔮₀loc f).mp hfS
      rw [← heq] at hc
      have hcV : (c : ↥F₀) ∉ V.nonunits := fun h => hc ((hcen c).mpr h)
      have hc0 : ((c : ↥B) : ↥F₀) ≠ 0 := by
        intro h0; apply hcV; rw [h0]; exact (V.mem_nonunits_iff_or).mpr (Or.inl rfl)
      have hcinv : ((c : ↥B) : ↥F₀)⁻¹ ∈ V := by
        by_contra h; exact hcV ((V.mem_nonunits_iff_or).mpr (Or.inr h))
      have hfeq : f = (b : ↥F₀) * ((c : ↥B) : ↥F₀)⁻¹ := by
        rw [← hfc, mul_assoc, mul_inv_cancel₀ hc0, mul_one]
      rw [hfeq]
      exact V.mul_mem _ _ (hBV b) hcinv
    haveI := h𝔪.isPrime
    obtain ⟨x₁, hx₁⟩ :=
      AlgebraicGeometry.exists_localRing_eq_localization_of_normal_affineModel_of_map_maximalIdeal_le
        A₀ X₀ toBase₀ hn₀ φ₀ hφ₀ hdim hval B hfg hn hfrac hdimB hcomp hcomp' 𝔪 h𝔭
    have hx₁V : SSN.LR X₀ φ₀ x₁ ≤ V.toLocalSubring := SSN.LR_le_of_forall_iff' B 𝔪 x₁ V hBV hcen hx₁
    have : x₁ = x := eq_of_dom V x₁ x hx₁V hVR
    subst this
    exact ⟨𝔪, h𝔪, hϖ𝔪, hx₁⟩

  refine ⟨?_, ?_⟩
  ·
    let S : Subalgebra A₀ ↥F₀ :=
      { carrier := SemistableModel.localRing X₀ φ₀ (gen (Sum.inr s))
        mul_mem' := fun ha hb => Subring.mul_mem _ ha hb
        one_mem' := Subring.one_mem _
