namespace AModelL12

open AModel

/-! ## 1. Prefix transport -/

section Prefix

lemma decode_append (A B : Shape) {n : ℕ} (hn : n < vol A * vol B) :
    decode (A ++ B) n = decode A (n / vol B) ++ decode B (n % vol B) := by
  induction A generalizing n with
  | nil =>
    simp only [vol_nil, one_mul] at hn
    simp [decode, Nat.mod_eq_of_lt hn]
  | cons q A ih =>
    simp only [vol_cons] at hn
    have hAB : 0 < vol A * vol B := by
      rcases Nat.eq_zero_or_pos (vol A * vol B) with h | h
      · rw [mul_assoc, h] at hn; simp at hn
      · exact h
    simp only [List.cons_append, decode, vol_append]
    rw [ih (Nat.mod_lt _ hAB)]
    congr 2
    · rw [Nat.div_div_eq_div_mul, mul_comm (vol B)]
    · rw [mul_comm (vol A), Nat.mod_mul_right_div_self]
    · simp

lemma encode_append_len (X Y : Shape) {u w : List ℕ} (hu : u.length = X.length) :
    encode (X ++ Y) (u ++ w) = encode X u * vol Y + encode Y w := by
  rw [encode_append, List.drop_left' hu]
  congr 2
  apply encode_congr
  intro k hk
  rw [List.getD_append _ _ _ _ (by omega)]

/-- **Prefix transport.** A pull acting only on the digits after a prefix `X` is the same array
operation whatever field structure the prefix has (only `vol X` matters). -/
theorem pull_prefix {α : Type*} (X X' Y : Shape) (hX : vol X = vol X')
    (f : List ℕ → List ℕ) (d : α) (xs : List α) :
    pull (X ++ Y) (X ++ Y) (fun a => a.take X.length ++ f (a.drop X.length)) d xs =
      pull (X' ++ Y) (X' ++ Y) (fun a => a.take X'.length ++ f (a.drop X'.length)) d xs := by
  have key : ∀ Z : Shape, ∀ j < vol Z * vol Y,
      encode (Z ++ Y) ((fun a => a.take Z.length ++ f (a.drop Z.length)) (decode (Z ++ Y) j)) =
        j / vol Y * vol Y + encode Y (f (decode Y (j % vol Y))) := by
    intro Z j hj
    have hY : 0 < vol Y := by
      rcases Nat.eq_zero_or_pos (vol Y) with h | h
      · rw [h] at hj; simp at hj
      · exact h
    have hl : (decode Z (j / vol Y)).length = Z.length := length_decode _ _
    simp only [decode_append Z Y hj, List.take_left' hl, List.drop_left' hl]
    rw [encode_append_len Z Y (length_decode _ _), encode_decode
      ((Nat.div_lt_iff_lt_mul hY).2 hj)]
  apply List.ext_getElem (by simp [vol_append, hX])
  intro j h₁ h₂
  simp only [length_pull, vol_append] at h₁ h₂
  rw [getElem_pull, getElem_pull, key X j h₁, key X' j h₂]

/-- `blockSwap` after a prefix of `c` digits. -/
lemma blockSwap_shift {c i j r : ℕ} {a : List ℕ} (hc : c ≤ a.length) :
    blockSwap (c + i) (c + j) r a = a.take c ++ blockSwap i j r (a.drop c) := by
  apply List.ext_getElem (by simp; omega)
  intro k h₁ h₂
  rw [getElem_blockSwap]
  by_cases hk : k < c
  · rw [List.getElem_append_left (by simp; omega), List.getElem_take,
      bsIdx_out (by omega) (by omega), List.getD_eq_getElem]
  · simp only [length_blockSwap] at h₁
    rw [List.getElem_append_right (by simp; omega), getElem_blockSwap]
    simp only [List.length_take, min_eq_left hc]
    rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_drop]
    congr 2
    unfold bsIdx; split_ifs <;> omega

/-- **Block swap after a reshaped prefix.** -/
theorem pull_blockSwap_prefix {α : Type*} (X X' Y : Shape) (hX : vol X = vol X')
    (i j r : ℕ) (d : α) (xs : List α) :
    pull (X ++ Y) (X ++ Y) (blockSwap (X.length + i) (X.length + j) r) d xs =
      pull (X' ++ Y) (X' ++ Y) (blockSwap (X'.length + i) (X'.length + j) r) d xs := by
  have conv : ∀ Z : Shape, pull (Z ++ Y) (Z ++ Y) (blockSwap (Z.length + i) (Z.length + j) r) d xs
      = pull (Z ++ Y) (Z ++ Y) (fun a => a.take Z.length ++ blockSwap i j r (a.drop Z.length))
          d xs := by
    intro Z
    apply pull_congr
    intro a ha
    rw [blockSwap_shift (by rw [ha.length_eq]; simp)]
  rw [conv, conv]
  exact pull_prefix X X' Y hX _ d xs

end Prefix

/-! ## 2. Embedding into a larger shape (padding) and extraction -/

section Embed

variable {α : Type*}

@[simp] lemma length_embed (S T : Shape) (d : α) (xs : List α) :
    (embed S T d xs).length = vol T := by simp [embed]

/-- **Padding lemma.** Embedding `S` into `T ≥ S`, applying any pull whose address map keeps
valid `S`-addresses valid `S`-addresses, and extracting, is the same pull on the original
array. (The padded entries may be arbitrary: the pull never reads them at `S`-addresses.) -/
theorem extract_pull_embed {S T : Shape} (hST : ShapeLE S T) (g : List ℕ → List ℕ)
    (hg : ∀ a, Valid S a → Valid S (g a)) (d : α) (xs : List α) :
    extract S T d (pull T T g d (embed S T d xs)) = pull S S g d xs := by
  classical
  unfold extract
  rw [pull_comp g id (fun a ha => hST.valid ha)]
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [length_pull] at h₁
  rw [getElem_pull, getElem_pull, Function.comp_apply, id]
  have hv := hg _ (valid_decode h₁)
  have hlt := encode_lt (hST.valid hv)
  rw [List.getD_eq_getElem _ _ (by simpa using hlt)]
  simp only [embed, List.getElem_map, List.getElem_range, decode_encode (hST.valid hv),
    if_pos hv]

end Embed

/-! ## 3. Pieces: adjacent block swaps compose -/

section Pieces

lemma blockSwap_blockSwap_adj {i j r₁ r₂ : ℕ} {a : List ℕ} (hij : i + r₁ + r₂ ≤ j)
    (hj : j + r₁ + r₂ ≤ a.length) :
    blockSwap i j r₁ (blockSwap (i + r₁) (j + r₁) r₂ a) = blockSwap i j (r₁ + r₂) a := by
  unfold blockSwap
  rw [permIdx_permIdx (fun k hk => bsIdx_lt (by omega) (by omega) hk)]
  apply permIdx_congr
  intro k _
  simp only [Function.comp_apply]
  unfold bsIdx
  split_ifs <;> omega

/-- **Interchanging two chunks = interchanging all corresponding aligned pieces.** If every
piece operation at offset `o` with width `w t` is the pull by the block swap of the digit runs
`[c + o, c + o + w t)` and `[c' + o, c' + o + w t)`, then running all pieces is the pull by the
block swap of the whole chunks `[c + o₀, c + o₀ + Σ w)` and `[c' + o₀, …)`. -/
theorem runPieces_eq {α β : Type*} {T : Shape} {c c' n : ℕ} (hcc : c + n ≤ c')
    (hc' : c' + n ≤ T.length) (hsz : ∀ k < n, T.getD (c + k) 0 = T.getD (c' + k) 0)
    (step : ℕ → β → List α → List α) (w : β → ℕ) (d : α)
    (hstep : ∀ o t ys, o + w t ≤ n → ys.length = vol T →
      step o t ys = pull T T (blockSwap (c + o) (c' + o) (w t)) d ys) :
    ∀ (ts : List β) (o : ℕ) (xs : List α), o + (ts.map w).sum ≤ n → xs.length = vol T →
      runPieces step w o ts xs = pull T T (blockSwap (c + o) (c' + o) (ts.map w).sum) d xs := by
  intro ts
  induction ts with
  | nil =>
    intro o xs _ hxs
    simp only [runPieces, List.map_nil, List.sum_nil]
    rw [pull_congr (g' := id) (fun a _ => blockSwap_zero _ _ a), pull_id d hxs]
  | cons t ts ih =>
    intro o xs ho hxs
    simp only [List.map_cons, List.sum_cons] at ho ⊢
    simp only [runPieces]
    rw [hstep o t xs (by omega) hxs, ih (o + w t) _ (by omega) (by simp),
      pull_comp (blockSwap (c + o) (c' + o) (w t))
        (blockSwap (c + (o + w t)) (c' + (o + w t)) (ts.map w).sum) (fun a ha => valid_blockSwap (i := c + (o + w t))
        (j := c' + (o + w t)) (r := (ts.map w).sum) (by omega) (by omega) (fun k hk => by
          rw [show c + (o + w t) + k = c + (o + w t + k) by omega,
            show c' + (o + w t) + k = c' + (o + w t + k) by omega]
          exact hsz _ (by omega)) ha)]
    apply pull_congr
    intro a ha
    simp only [Function.comp_apply]
    rw [show c + (o + w t) = c + o + w t by omega, show c' + (o + w t) = c' + o + w t by omega,
      blockSwap_blockSwap_adj (by omega) (by rw [ha.length_eq]; omega)]

end Pieces

