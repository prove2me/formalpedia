theorem solution (t : NLogN.IState NLogN.HS) {W : ℕ} (s : Fin W → List ℤ) (P L : ℕ) [NeZero W] (rest : AModel.Shape)
    (Bb : ℕ) (R L1 L2 L3 L4 : List NLogN.Item)
    (hs : ∀ w, (s w).length = P * L * AModel.vol rest) (hb : ∀ w, NLogN.Bnd Bb (s w))
    (hB1 : 1 ≤ AModel.vol rest) (hPL : 1 ≤ P * L)
    (hV : NLogN.zsz ((1 * (W * (P * L * AModel.vol rest)) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = NLogN.ints ((List.finRange W).flatMap s) ++ R)
    (h1 : t.G 1 = .int ((1 : ℕ) : ℤ) :: L1)
    (h2 : t.G 2 = .int (W : ℤ) :: L2) (h3 : t.G 3 = .int ((P * L : ℕ) : ℤ) :: L3)
    (h4 : t.G 4 = .int (AModel.vol rest : ℤ) :: L4) :
    NLogN.KIL.fwdP.ok t ∧ NLogN.KIL.fwdP.run t = t.upd 0 (NLogN.ints (AModel.rowMerge P W L rest 0 s) ++ R) ∧
      NLogN.KIL.fwdP.cost t ≤ NLogN.KIL.cMove 1 W (P * L) (AModel.vol rest) Bb := by
  rw [NLogN.KIL.rowMerge_eq P W L rest s hs]
  refine NLogN.KIL.fwdP_spec t _ 1 W (P * L) (AModel.vol rest) Bb R L1 L2 L3 L4 ?_ ?_ hB1 hPL (NeZero.pos W)
    le_rfl (by simpa [Nat.mul_comm, Nat.mul_assoc, Nat.mul_left_comm] using hV) h0 h1 h2 h3 h4
  · rw [NLogN.KIL.length_fm_const _ _ (P * L * AModel.vol rest) (fun w _ => hs w)]; simp; ring
  · exact NLogN.KIL.bnd_flatMap fun w => hb w
