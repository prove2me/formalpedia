variable {E : Type} [Field E] [StarRing E]

theorem PIW.AdelClassFin.hform_eq {n : Type} [Fintype n] (J : Matrix n n E) (x y : n → E) :
    hform (starRingEnd E) J x y = star x ⬝ᵥ (J *ᵥ y) := by sorry
