section formula

variable {g gi : Metric n} {U : Set (Pt n)}

theorem riemLow_formula (hm : MetricData g gi U) {y : Pt n} (hy : y ∈ U) (a b c d : Fin n) :
    riemLow g gi a b c d y = pd c (chr1 g a d b) y - pd d (chr1 g a c b) y
      - ∑ e, chr1 g e c a y * christoffel g gi e d b y
      + ∑ e, chr1 g e d a y * christoffel g gi e c b y := by
  have hU := hm.isOpen
  have hΓ : ∀ i j k, ContDiffOn ℝ ∞ (christoffel g gi i j k) U :=
    fun i j k => contDiffOn_christoffel hU hm.smooth hm.smooth_inv i j k
  have key : ∀ c d : Fin n, ∑ e, g a e y * pd c (christoffel g gi e d b) y
      = pd c (chr1 g a d b) y - ∑ e, chr1 g a c e y * christoffel g gi e d b y
        - ∑ e, chr1 g e c a y * christoffel g gi e d b y := by
    intro c d
    have hfun : Set.EqOn (fun z => ∑ e, g a e z * christoffel g gi e d b z) (chr1 g a d b) U :=
      fun z hz => sum_g_christoffel hm hz a d b
    have h1 := pd_sum_of hU hy c Finset.univ (f := fun e z => g a e z * christoffel g gi e d b z)
      (fun e _ => (hm.smooth a e).mul (hΓ e d b))
    rw [pd_congr_of_eqOn hU hy hfun c] at h1
    rw [h1]
    simp only [pd_mul_of hU hy c (hm.smooth a _) (hΓ _ d b), pd_g_eq_chr1 hm hy a c, add_mul,
      Finset.sum_add_distrib]
    ring
  have quad : ∀ c d : Fin n, ∑ e, g a e y * ∑ f, christoffel g gi e c f y * christoffel g gi f d b y
      = ∑ f, chr1 g a c f y * christoffel g gi f d b y := by
    intro c d
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun f _ => ?_
    rw [← sum_g_christoffel hm hy a c f, Finset.sum_mul]
    exact Finset.sum_congr rfl fun e _ => by ring
  have hsplit : riemLow g gi a b c d y
      = ∑ e, g a e y * pd c (christoffel g gi e d b) y - ∑ e, g a e y * pd d (christoffel g gi e c b) y
        + ∑ e, g a e y * ∑ f, christoffel g gi e c f y * christoffel g gi f d b y
        - ∑ e, g a e y * ∑ f, christoffel g gi e d f y * christoffel g gi f c b y := by
    simp only [riemLow, riem_expand, Finset.sum_sub_distrib, mul_add, mul_sub, Finset.sum_add_distrib]
