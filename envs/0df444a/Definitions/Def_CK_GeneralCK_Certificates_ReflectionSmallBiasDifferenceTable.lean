theorem eval_candidateTable (z : ℂ × ℂ) :
    eval (Real.log 2:ℂ) candidateTable z = SmallBiasCandidate.polynomial z := by
  have he := eval_eq_of_degrees 24 (Real.log 2:ℂ) candidateTable rawCandidate z
    (degreeBound_sound candidateTable_degreeBound) (degreeBound_sound rawCandidate_degreeBound)
