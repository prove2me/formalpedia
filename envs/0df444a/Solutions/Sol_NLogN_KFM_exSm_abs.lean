    rw [abs_of_nonneg (by positivity)]
    have : ((2 ^ (a.eval s).toNat : ℕ) : ℤ) ≤ A := by exact_mod_cast h.2.2
    push_cast at this
    have h1 := NLogN.KFM.pow_mono_A hA (NLogN.KFM.exDg_pos a)
    simp only [pow_one] at h1
    linarith
  | .shl _ _, h | .quo _ _, h | .rem _ _, h | .sel _ _ _, h => h.elim

theorem solution (A : ℕ) (s : NLogN.IState NLogN.HS) (hA : 2 ≤ A) :
