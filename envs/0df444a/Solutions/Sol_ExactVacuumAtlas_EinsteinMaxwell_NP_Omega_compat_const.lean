open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {n : ℕ}
variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}
theorem solution (hF : FrameData g gi E Θ U) {η : Matrix (Fin n) (Fin n) ℂ}
    (hG : ∀ z ∈ U, gramM g E z = η) {x : Pt n} (hx : x ∈ U) (A : Fin n) :
    (Omega g gi E Θ A x)ᵀ * η + η * Omega g gi E Θ A x = 0 := by
  have h0 : Dmat E A (gramM g E) x = 0 := by
    unfold Dmat
    refine Finset.sum_eq_zero fun μ _ => ?_
    rw [pdMC_congr_of_eqOn hF.isOpen hx μ (B := fun _ => η) hG]
    have : pdMC μ (fun _ => η) x = 0 := by
      ext a b; simp only [pdMC_apply, Matrix.zero_apply]; exact cpdC_const _ μ x
    rw [this, smul_zero]
  rw [Dmat_gramM hF hx A, hG x hx] at h0
  exact h0
