theorem GlobalTheory.QuadSymbol.prod_eta_infinite {K L : Type} [Field K] [NumberField K] [Field L] [Algebra K L]
    (e : Module.Basis (Fin 2) K L) (h0 : e 0 = 1) {δ : Kˣ} (h1 : e 1 * e 1 = algebraMap K L δ)
    (t : Kˣ) [Fintype (K →+* ℝ)] :
    ∏ w : InfinitePlace K, eta K L w.Completion (infDiag K t w) =
      ∏ σ : K →+* ℝ, hs (.inr σ) t δ := by sorry
