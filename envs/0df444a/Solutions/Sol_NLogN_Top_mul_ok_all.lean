/-- `blenS` with an `O(ℓ log ℓ)` cost bound. -/
theorem blenS_runs' {X C : Fin NS} (hXC : X ≠ C) (hX5 : X ≠ T5) (hX6 : X ≠ T6) (hX7 : X ≠ T7)
    (hC5 : C ≠ T5) (hC6 : C ≠ T6) (hC7 : C ≠ T7) (s : IState NS) (x : ℕ) (LX : List Item)
    (hX : s.G X = .int x :: LX) :
    IRuns I iprog (blenS X C) s (s.upd C (.int (zsz (x : ℤ)) :: s.G C))
      (2000 * (zsz (x : ℤ) + 1) * (zsz (zsz (x : ℤ) : ℤ) + 2)) := by
  set ℓ := zsz (x : ℤ) with hℓ
  set b := zsz (ℓ : ℤ) with hb
  have hC5' := Ne.symm hC5; have hC6' := Ne.symm hC6; have hC7' := Ne.symm hC7
  have hX5' := Ne.symm hX5; have hX7' := Ne.symm hX7; have hXC' := Ne.symm hXC
