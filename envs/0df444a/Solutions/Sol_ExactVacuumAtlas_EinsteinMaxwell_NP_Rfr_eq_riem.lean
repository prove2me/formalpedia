section R05Seg5
/-!
# Atlas V-02 (B): connection of a general smooth complex frame, commutators, curvature bridge

B3 local definition layer (`mission/PHYSICS_BOUNDARY.md` §L). A **general** frame on an open set `U ⊆ ℝⁿ`:
complex components `E A μ x = e_A^μ(x)` (frame matrix `frMat E x`, column `A` = vector `e_A`) and a genuine
two-sided dual `Θ C μ x = θ^C_μ(x)` (`coMat Θ x`). No null/orthonormal normalisation, no field equation, no
reality condition. Directional derivatives use V-01's `cpdC` (real slice derivative of complex functions; no
holomorphy). Definitions (class B, transparent; `Γ = christoffel g gi`, first lower index = direction):

* `fdir E A f = Σ_μ e_A^μ ∂_μ f` (`D_A`);
* `omegaC g gi E Θ μ = Θ (∂_μ E + Γ_μ E)`: the connection in coordinate directions, gauge-transformed to the frame;
* `Omega g gi E Θ A = Σ_μ e_A^μ ω_μ`, entries `(Ω_A)^C_B = Σ_ν θ^C_ν (D_A e_B^ν + Σ_{μλ} Γ^ν_{μλ} e_A^μ e_B^λ)`;
* `brk E A B μ = D_A e_B^μ − D_B e_A^μ` and `cfr E Θ C A B = Σ_μ θ^C_μ brk^μ_{AB}` (`c^C_{AB}`);
* `Rfr g gi E Θ A B = D_A Ω_B − D_B Ω_A + Ω_A Ω_B − Ω_B Ω_A − Σ_C c^C_{AB} Ω_C` — **with** the non-coordinate
  term `−Σ_C c^C_{AB} Ω_C`.

Main results on `U` (hypothesis bundle `FrameData`: `MetricData`, `C^∞` frame and dual, duality):
`fdir_comm` (`[D_A, D_B] f = Σ_C c^C_{AB} D_C f`), `cfr_eq_Omega` (torsion-free: `c^C_{AB} = Ω_A^C_B − Ω_B^C_A`),
`pdMC_gramM` / `fdir_gram` (metric compatibility `D_A G = Ω_Aᵀ G + G Ω_A`, `G = Eᵀ g E`), `Fom_eq` (gauge
covariance: the curvature of `ω` is `Θ · R_{μν} · E`), `Rfr_eq` and **`Rfr_eq_riem`**:
`(Rfr A B)^I_J = Σ θ^I_ρ R^ρ_{σμν} e_J^σ e_A^μ e_B^ν` with `R = riem g gi` read off II's `curv`.
-/

open scoped ContDiff Matrix
open Complex

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {n : ℕ}

/-! ### Definitions -/

/-! ### Basic algebra -/

namespace FrameData

variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}

theorem isOpen (hF : FrameData g gi E Θ U) : IsOpen U := hF.metric.isOpen

theorem compl (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) : frMat E x * coMat Θ x = 1 :=
  mul_eq_one_comm.mp (hF.dual x hx)

theorem smoothOnC_frMat (hF : FrameData g gi E Θ U) : SmoothOnC (frMat E) U :=
  fun μ A => hF.smooth_E A μ

theorem smoothOnC_coMat (hF : FrameData g gi E Θ U) : SmoothOnC (coMat Θ) U :=
  fun C μ => hF.smooth_Θ C μ

theorem smoothOnC_GamC (hF : FrameData g gi E Θ U) (μ : Fin n) : SmoothOnC (GamC g gi μ) U :=
  SmoothOnC.map_ofReal (hF.metric.smoothOn_connMat μ)

end FrameData

/-! ### Commutator of frame derivatives -/

section comm

variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}

end comm

/-! ### Torsion-freeness -/

/-! ### Gauge covariance of the curvature and the curvature bridge -/

/-- Algebraic core over any ring: with `∂K = −K S K`, the curvature of `K (S + A T)` is `K [∂A − ∂A + A A − A A] T`;
only `T K = 1` is used. -/
theorem fom_core {R : Type*} [Ring R] {K T Sc Sd Scd Ac Ad Acd Adc : R} (hTK : T * K = 1) :
    (-(K * Sc * K) * (Sd + Ad * T) + K * (Scd + Acd * T + Ad * Sc))
      - (-(K * Sd * K) * (Sc + Ac * T) + K * (Scd + Adc * T + Ac * Sd))
      + K * (Sc + Ac * T) * (K * (Sd + Ad * T)) - K * (Sd + Ad * T) * (K * (Sc + Ac * T))
      = K * (Acd - Adc + Ac * Ad - Ad * Ac) * T := by
  have h : ∀ X : R, T * (K * X) = X := fun X => by rw [← mul_assoc, hTK, one_mul]
  simp only [mul_add, add_mul, mul_sub, sub_mul, neg_mul, mul_neg, mul_assoc, h]
  abel

section bridge

variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}

theorem riemC_eq (g gi : Metric n) (μ ν : Fin n) (x : Pt n) :
    riemC g gi μ ν x = pdMC μ (GamC g gi ν) x - pdMC ν (GamC g gi μ) x
      + GamC g gi μ x * GamC g gi ν x - GamC g gi ν x * GamC g gi μ x := by
  ext a b
  simp only [riemC, curv, GamC, Matrix.map_apply, Matrix.sub_apply, Matrix.add_apply, Matrix.mul_apply,
    pdMC_apply, pdM_apply]
  rw [cpdC_ofReal, cpdC_ofReal]
  push_cast
  ring

theorem pdMC_omegaC (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (μ ν : Fin n) :
    pdMC μ (omegaC g gi E Θ ν) x
      = -(coMat Θ x * pdMC μ (frMat E) x * coMat Θ x) * (pdMC ν (frMat E) x + GamC g gi ν x * frMat E x)
        + coMat Θ x * (pdMC μ (fun z => pdMC ν (frMat E) z) x + pdMC μ (GamC g gi ν) x * frMat E x
          + GamC g gi ν x * pdMC μ (frMat E) x) := by
  have hU := hF.isOpen
  have hT := hF.smoothOnC_frMat
  have hK := hF.smoothOnC_coMat
  have hG := hF.smoothOnC_GamC ν
  unfold omegaC
  rw [pdMC_mul hU hx μ hK ((hT.pdMC hU ν).add (hG.mul hT)),
    pdMC_add hU hx μ (hT.pdMC hU ν) (hG.mul hT), pdMC_mul hU hx μ hG hT,
    pdMC_inv hU hx μ hT hK (fun z hz => hF.dual z hz) (hF.compl hx)]
  noncomm_ring

/-- **Gauge covariance**: the curvature of `ω` is `Θ · R_{μν} · E` (`R_{μν}` the complexified `curv`). -/
theorem Fom_eq (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (μ ν : Fin n) :
    Fom g gi E Θ μ ν x = coMat Θ x * riemC g gi μ ν x * frMat E x := by
  have hsymm : pdMC ν (fun z => pdMC μ (frMat E) z) x = pdMC μ (fun z => pdMC ν (frMat E) z) x :=
    pdMC_pdMC_symm hF.isOpen hx hF.smoothOnC_frMat ν μ
  unfold Fom
  rw [pdMC_omegaC hF hx μ ν, pdMC_omegaC hF hx ν μ, hsymm, riemC_eq]
  unfold omegaC
  exact fom_core (hF.compl hx)

end bridge

