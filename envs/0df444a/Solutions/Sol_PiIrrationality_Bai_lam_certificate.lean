def rows : List (Nat × Nat × Nat × Nat × Nat) := chunk0 ++ chunk1 ++ chunk2 ++ chunk3 ++ chunk4 ++ chunk5 ++ chunk6


/-- `⌊10^20 D (B-A) / ((A+mD)(B+mD))⌋`. -/
def headTerm (m : Nat) (t : Nat × Nat × Nat × Nat × Nat) : Nat :=
  10 ^ 20 * Dd * (t.2.1 - t.1) / ((t.1 + m * Dd) * (t.2.1 + m * Dd))

/-- Centered power sums `∑ (D-2A)^j - (D-2B)^j`. -/
def psum (j : Nat) : Int :=
  (rows.map fun t => ((Dd : Int) - 2 * t.1) ^ j - ((Dd : Int) - 2 * t.2.1) ^ j).sum

/-! Integer list polynomials (index = power). -/

def pAdd : List Int → List Int → List Int
  | [], q => q
  | a :: p, [] => a :: p
  | a :: p, b :: q => (a + b) :: pAdd p q

def pSmul (c : Int) (p : List Int) : List Int := p.map (c * ·)

def pMul : List Int → List Int → List Int
  | [], _ => []
  | a :: p, q => pAdd (pSmul a q) (0 :: pMul p q)

def pPow (p : List Int) : Nat → List Int
  | 0 => [1]
  | k + 1 => pMul (pPow p k) p

def pHorner : List Int → List Int → List Int
  | [], _ => []
  | c :: cs, q => pAdd [c] (pMul q (pHorner cs q))

def pEvalZ : List Int → Int → Int
  | [], _ => 0
  | c :: cs, z => c + z * pEvalZ cs z

def sumAbs : List Int → Nat
  | [] => 0
  | c :: cs => c.natAbs + sumAbs cs

