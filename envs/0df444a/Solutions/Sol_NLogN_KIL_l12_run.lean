variable {α : Type*}

lemma forall₂_refl_le (X : Shape) : List.Forall₂ (· ≤ ·) X X :=
  List.forall₂_same.2 fun x _ => le_refl x

theorem embed_binShape (Pre G Suf : Shape) {F F' : ℕ} (hF : F ≤ F') (d : α) {xs : List α}
    (hxs : xs.length = AModel.vol (binShape Pre G Suf F)) :
    AModelL12.embed (binShape Pre G Suf F) (binShape Pre G Suf F') d xs =
      NLogN.KIL.padL (AModel.vol Pre) F F' (AModel.vol G * (F' * AModel.vol Suf)) d
        (NLogN.KIL.padL (AModel.vol Pre * (F * AModel.vol G)) F F' (AModel.vol Suf) d xs) := by
  set S1 := Pre ++ (F :: (G ++ (F' :: Suf)))
  have h1 : ShapeLE (binShape Pre G Suf F) S1 := shapeLE_of_forall₂ (List.rel_append
    (forall₂_refl_le Pre) (List.Forall₂.cons (le_refl F) (List.rel_append (forall₂_refl_le G)
      (List.Forall₂.cons hF (forall₂_refl_le Suf)))))
  rw [← embed_trans h1]
  have e0 : binShape Pre G Suf F = (Pre ++ F :: G) ++ F :: Suf := by simp [binShape]
  have eA : AModel.vol (Pre ++ F :: G) = AModel.vol Pre * (F * AModel.vol G) := by simp [vol_append]
  have i1 : AModelL12.embed (binShape Pre G Suf F) S1 d xs =
      NLogN.KIL.padL (AModel.vol Pre * (F * AModel.vol G)) F F' (AModel.vol Suf) d xs := by
    rw [e0, show S1 = (Pre ++ F :: G) ++ F' :: Suf by simp [S1], embed_eq_padL _ _ hF d
      (by rw [hxs, e0]), eA]
  rw [i1]
  have hl : (NLogN.KIL.padL (AModel.vol Pre * (F * AModel.vol G)) F F' (AModel.vol Suf) d xs).length = AModel.vol (Pre ++ F :: (G ++ F' :: Suf)) := by
    rw [length_padL hF d (by rw [hxs]; simp [binShape, vol_append]; ring_nf; try exact le_refl _)]
    simp [vol_append]; try ring
  rw [show binShape Pre G Suf F' = Pre ++ F' :: (G ++ F' :: Suf) from rfl, embed_eq_padL _ _ hF d hl]
  simp [vol_append]

theorem extract_binShape (Pre G Suf : Shape) {F F' : ℕ} (hF : F ≤ F') (d : α) {ys : List α}
    (hys : ys.length = AModel.vol (binShape Pre G Suf F')) :
    extract (binShape Pre G Suf F) (binShape Pre G Suf F') d ys =
      unpadL (AModel.vol Pre * (F * AModel.vol G)) F F' (AModel.vol Suf)
        (unpadL (AModel.vol Pre) F F' (AModel.vol G * (F' * AModel.vol Suf)) ys) := by
  set S1 := Pre ++ (F :: (G ++ (F' :: Suf)))
  have h1 : ShapeLE (binShape Pre G Suf F) S1 := shapeLE_of_forall₂ (List.rel_append
    (forall₂_refl_le Pre) (List.Forall₂.cons (le_refl F) (List.rel_append (forall₂_refl_le G)
      (List.Forall₂.cons hF (forall₂_refl_le Suf)))))
  rw [← extract_trans h1]
  have i2 : extract S1 (binShape Pre G Suf F') d ys =
      unpadL (AModel.vol Pre) F F' (AModel.vol G * (F' * AModel.vol Suf)) ys := by
    rw [show binShape Pre G Suf F' = Pre ++ F' :: (G ++ F' :: Suf) from rfl,
      extract_eq_unpadL _ _ hF d (by rw [hys]; rfl)]
    simp [vol_append]
  rw [i2]
  have e0 : binShape Pre G Suf F = (Pre ++ F :: G) ++ F :: Suf := by simp [binShape]
  have hl : (unpadL (AModel.vol Pre) F F' (AModel.vol G * (F' * AModel.vol Suf)) ys).length =
      AModel.vol ((Pre ++ F :: G) ++ F' :: Suf) := by
    rw [length_unpadL (by rw [hys]; simp [binShape, vol_append]; try ring_nf) hF]
    simp [vol_append]; try ring
  rw [e0, show S1 = (Pre ++ F :: G) ++ F' :: Suf by simp [S1], extract_eq_unpadL _ _ hF d hl]
  simp [vol_append]

end Shapes

