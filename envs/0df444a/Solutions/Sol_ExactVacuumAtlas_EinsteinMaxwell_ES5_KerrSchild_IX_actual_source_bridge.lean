theorem solution
    (kg : Set ℝ)
    (srcMbar : ℝ → ℝ) (qMcK : ℝ → ℝ)
    (wF : ℝ → ℝ) (wMc : ℝ → ℝ) (wC : ℝ → ℝ) (wA : ℝ → ℝ)
    (lamF : ℝ → ℝ) (lamM : ℝ → ℝ) (lamC : ℝ → ℝ) (lamA : ℝ → ℝ)
    (hD : PhysicalSourceData kg srcMbar qMcK wF wMc wC wA lamF lamM lamC lamA)
    (hF : ResidualZero wF kg) (hMc : ResidualZero wMc kg)
