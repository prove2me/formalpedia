open _root_.NLogN.KFY.NG hiding Lb bl casesOn d5 dbig mk nf rec recOn win2 α4
open _root_.IntMul.OpenAI.R154.P.NLogN.KFY.NG
theorem NG.S_sq4 : SN n ^ 2 ≤ 4 * pP n := by
  have h1 := ceilSqrt_le_sqrt h (pP n)
  have h2 := Nat.sqrt_le' (pP n)
  have h3 := Nat.sqrt_le_self (pP n)
  have hp := h.p_pos
  calc SN n ^ 2 ≤ (Nat.sqrt (pP n) + 1) ^ 2 := Nat.pow_le_pow_left h1 2
    _ = Nat.sqrt (pP n) ^ 2 + 2 * Nat.sqrt (pP n) + 1 := by ring
    _ ≤ 4 * pP n := by omega

open _root_.NLogN.KFY.NG hiding Lb bl casesOn d5 dbig mk nf rec recOn win2 α4
