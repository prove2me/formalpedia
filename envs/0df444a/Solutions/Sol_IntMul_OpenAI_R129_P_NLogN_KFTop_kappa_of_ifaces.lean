set_option maxHeartbeats 4000000 in
/-- **One run of `bigE`.** -/
theorem big_run (C : BigCtx ix Isym extM n D) (x y : List Bool) (hxl : x.length = n)
    (hyl : y.length = n) :
    ∃ s' c, IRuns Isym (kTable extM) (bigP ix) (readSt x y) s' c ∧
      s'.out = bin (2 * n) (IntMul.val x * IntMul.val y) ∧ (c : ℝ) ≤ (IntMul.OpenAI.R129.P.NLogN.KFM.setC x y : ℝ) + kMul C + kFin C := by
  subst hxl
  have hn := C.hn
  obtain ⟨c0, r0, hc0⟩ := setP_runs (I := Isym) (iprog := kTable extM) x y hn
  set t := baseSt x y with ht
  have hR : BaseOK t x.length := baseOK x y
  have hx : IntMul.val x < 2 ^ x.length := val_lt x
  have hy : IntMul.val y < 2 ^ x.length := hyl ▸ val_lt y
  have h0 : t.G 0 = [] := baseSt_G_free x y 0 (by decide) (by decide) (by decide) (by decide)
  have hW : t.G pW = [] := baseSt_G_free x y pW (by decide) (by decide) (by decide) (by decide)
  obtain ⟨zsZ, Z, Ux, Uy, c1, r1, hZ, gZ, eZ, eX, eY, k1⟩ :=
    mul_phase C t hR (IntMul.val x) (IntMul.val y) hx hy (baseSt_ARGM x y) h0 hW
  obtain ⟨-, -, hcl⟩ := final_call3 (pP x.length) (bP x.length) (sBD x.length D) (tBD x.length D)
    C.hcop (EsN x.length D) C.hEs C.hB2 (norm_dgt_le (bP x.length) (NLogN.KFM.mN x.length) (IntMul.val x) _)
    (norm_dgt_le (bP x.length) (NLogN.KFM.mN x.length) (IntMul.val y) _) eX eY eZ
  set t2 := ((t.upd ARGM []).upd pW []).upd 0 (ints (gflat zsZ)) with ht2
  have hR2 : BaseOK t2 x.length :=
    ((hR.upd ARGM (by decide) _).upd pW (by decide) _).upd 0 (by decide) _
  obtain ⟨s', c2, r2, hout, k2⟩ := fin_phase C t2 hR2 (IntMul.val x) (IntMul.val y) hx hy zsZ Z (by simp [t2])
    hZ gZ hcl (by simp [t2, ht, baseSt_out])
  refine ⟨s', _, r0.seq (r1.seq r2), hout, ?_⟩
  have hc0' : (c0 : ℝ) ≤ (IntMul.OpenAI.R129.P.NLogN.KFM.setC x y : ℝ) := by exact_mod_cast hc0
  push_cast
  linarith

end

