    simp only [PJ.miT, runL, Ins.run, d1, d2, d4, d5, e3', e6, Int.toNat_natCast]
    simp (disch := decide) only [update_of_ne, update_self, E.den]
  have h2W : (4 : ℕ) ≤ 2 ^ W := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) hW2
