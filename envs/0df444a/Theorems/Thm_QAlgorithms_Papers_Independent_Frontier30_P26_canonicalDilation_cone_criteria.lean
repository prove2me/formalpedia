-- title:
--   Proposition 4.2: Canonical-dilation invariance of a generating cone
-- statement:
--   All vector spaces and Lie algebras are finite dimensional and real, with their usual Hausdorff topology. An invariant set is invariant under the group generated by $e^{\operatorname{ad}y}$. A closed convex set is pointed when its recession edge is zero. Write $\mathcal O_x=\operatorname{Inn}(\mathfrak g)x$, $\operatorname{co}(x)=\overline{\operatorname{conv}}\mathcal O_x$, and $C_x=\operatorname{cone}(\mathcal O_x)$. Admissibility means existence of a pointed generating invariant closed convex subset.
--
--   In an admissible structural presentation, let $W$ be a pointed generating invariant cone and set $D_{\rm can}(z,v,l)=(z,v/2,0)$. Invariance of $W$ under $e^{tD_{\rm can}}$ for every real $t$ is equivalent to $p_z(W),p_l(W)\subseteq W$, and also to invariance of $W\cap\mathfrak t$ under this flow. Under these conditions, with $W_z=W\cap\mathfrak z$ and $W_l=W\cap\mathfrak l$,
--
--   $$W\cap(\mathfrak z+\mathfrak l)=W_z+W_l,\qquad W=e^{\operatorname{ad}V}(W_z+W_l)=\operatorname{Inn}(\mathfrak g)(W_z+W_l).$$
--
--   Consequently the two sections uniquely determine $W$ among cones satisfying these conditions.
-- source:
--   Elements in pointed invariant cones in Lie algebras and corresponding affine pairs, arXiv:2110.07297v1, PDF p. 19, Proposition 4.2: Canonical-dilation invariance of a generating cone

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier30_P26

namespace QAlgorithms.Papers.Independent.Frontier30.P26

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Dependency50.P12.Coordinates (expAd)

attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section Derivations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Proposition 4.2, PDF pp. 19–20: three criteria, both orbit recovery descriptions and uniqueness. -/
theorem canonicalDilation_cone_criteria (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) (W : Set G) (hW : GeneratingInvariantCone W) :
    (FlowInvariant (canonicalDilation P) W ↔
      (∀ x ∈ W, zPart P x ∈ W) ∧ (∀ x ∈ W, lPart P x ∈ W)) ∧
    (FlowInvariant (canonicalDilation P) W ↔ FlowInvariant (canonicalDilation P) (W ∩ (P.T : Set G))) ∧
    (FlowInvariant (canonicalDilation P) W →
      W ∩ ((LieAlgebra.center ℝ G).toSubmodule ⊔ P.L.toSubmodule : Submodule ℝ G) =
        setSum (W ∩ (LieAlgebra.center ℝ G : Set G)) (W ∩ (P.L : Set G)) ∧
      W = {x | ∃ v : P.V, ∃ y ∈ setSum (W ∩ (LieAlgebra.center ℝ G : Set G)) (W ∩ (P.L : Set G)),
        x = expAd (v : G) y} ∧
      W = {x | ∃ y ∈ setSum (W ∩ (LieAlgebra.center ℝ G : Set G)) (W ∩ (P.L : Set G)), x ∈ innerAdjointOrbit y} ∧
      ∀ W' : Set G, GeneratingInvariantCone W' → FlowInvariant (canonicalDilation P) W' →
        W' ∩ (LieAlgebra.center ℝ G : Set G) = W ∩ (LieAlgebra.center ℝ G : Set G) →
        W' ∩ (P.L : Set G) = W ∩ (P.L : Set G) → W' = W) := by sorry

end Derivations

end

end QAlgorithms.Papers.Independent.Frontier30.P26
