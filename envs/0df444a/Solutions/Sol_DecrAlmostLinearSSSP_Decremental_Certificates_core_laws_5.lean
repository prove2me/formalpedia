    (fun k hk => (eval_code s).nat_frame (nat_frame k (by simp at hk;omega) (by simp at hk;omega) (by simp at hk;omega)))
    (fun k hk => (eval_code s).real_frame (real_frame k (by simp at hk;omega) (by simp at hk;omega) (by simp at hk;omega)))
