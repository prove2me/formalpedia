-- title:
--   §4.2 — $P(\emptyset)$ is the set of sums of squares and the smallest cone
-- statement:
--   In $\mathbb R[x_1,\dots,x_n]$, the cone generated by the empty set consists exactly of the polynomials that are sums of squares:
--   $$
--   P(\emptyset)=\Big\{\textstyle\sum_i p_i^2 : p_i\in\mathbb R[x_1,\dots,x_n]\Big\},
--   $$
--   and it is the smallest cone: $P(\emptyset)\subseteq P$ for every cone $P$ of $\mathbb R[x_1,\dots,x_n]$, i.e. every subset $P$ with $a,b\in P\Rightarrow a+b\in P$, $a,b\in P\Rightarrow ab\in P$, and $a^2\in P$ for every polynomial $a$.
--
--   This identifies the "sum of squares" multipliers of the Positivstellensatz with the elements of $P(\emptyset)$.
--
--   **Formalization Note** Cones are those of Definition 4.5 (closed under sums, products and containing all squares). "Smallest cone" is rendered as inclusion in every subset satisfying the three properties of Definition 4.5.
-- source:
--   Parrilo, Semidefinite programming relaxations for semialgebraic problems, Math. Program. Ser. B 96 (2003) 293–320, p. 304, §4.2, after Definition 4.5

import Mathlib
import Definitions.Def_SemialgebraicSDP_Psatz_Cone

namespace SemialgebraicSDP.Psatz

open MvPolynomial

theorem cone_empty_eq_isSumSq (n : ℕ) :
    cone (∅ : Set (MvPolynomial (Fin n) ℝ)) = {a | IsSumSq a} ∧
      ∀ P : Set (MvPolynomial (Fin n) ℝ),
        (∀ a ∈ P, ∀ b ∈ P, a + b ∈ P) → (∀ a ∈ P, ∀ b ∈ P, a * b ∈ P) →
        (∀ a : MvPolynomial (Fin n) ℝ, a ^ 2 ∈ P) → cone ∅ ⊆ P := by sorry

end SemialgebraicSDP.Psatz
