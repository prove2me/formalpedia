-- title:
--   §2–§4, pp. 932–935 — the Markov-modulated inventory model: data, standing assumptions, (2.1)–(2.5), F_{n+1} (3.1), the DP (3.2), policies (3.3), (4.1), (4.2), (4.8), (4.11)
-- statement:
--   This file sets up the finite-horizon inventory model of Sethi and Cheng (1997, §2–§4), in which the demand distribution is modulated by a finite Markov chain.
--
--   **Data.** There are $L$ demand states $I$ and periods $k = 0,1,\dots,N$. The demand state $i_k$ follows a Markov chain with transition matrix $P = (p_{ij})$. Given $i_k = i$, the demand $\xi_k \ge 0$ has density $\varphi_{i,k}$. Ordering $u \ge 0$ units in period $k$ in state $i$ costs
--   $$c_k(i,u) = K^i_k\,\delta(u) + c^i_k u, \qquad (2.1)$$
--   and a surplus (inventory, or backlog if negative) $x$ costs $f_k(i,x)$.
--
--   **Standing assumptions (§2).**
--   1. $P$ is a stochastic matrix.
--   2. Each $\varphi_{i,k}$ is a measurable probability density, zero on $(-\infty,0)$, with mean $E\{\xi_k \mid i_k = i\} \le M$.
--   3. $K^i_k \ge 0$ and $c^i_k \ge 0$.
--   4. Each $f_k(i,\cdot)$ is convex and nonnegative, $f_k(i,0) = 0$, and $f_k(i,x) \le C(1+|x|)$ for a constant $C > 0$ (2.2).
--
--   **Dynamics, cost and value.** Orders arrive at once and unmet demand is backlogged: $x_{k+1} = x_k + u_k - \xi_k$ (2.4). An admissible decision $U = (u_n,\dots,u_{N-1})$ is history dependent: $u_{n+t}$ is a nonnegative function, measurable in the demands, of the states $i_n,\dots,i_{n+t}$ and the past demands $\xi_n,\dots,\xi_{n+t-1}$. The objective and the value function are
--   $$J_n(i,x;U) = E\Big\{\sum_{k=n}^{N}\big[c_k(i_k,u_k) + f_k(i_k,x_k)\big]\Big\}, \qquad v_n(i,x) = \inf_{U} J_n(i,x;U), \qquad (2.3),(2.5)$$
--   with $i_n = i$, $x_n = x$.
--
--   **Dynamic programming.** For $b$ of linear growth,
--   $$F_{n+1}(b)(i,y) = \sum_{j=1}^{L} p_{ij}\int_0^\infty b(j,y-z)\,\varphi_{i,n}(z)\,dz. \qquad (3.1)$$
--   The functions of (3.2) are $v_N(i,x) = f_N(i,x)$ and, for $n < N$,
--   $$v_n(i,x) = f_n(i,x) + \inf_{u \ge 0}\big\{c_n(i,u) + F_{n+1}(v_{n+1})(i,x+u)\big\}.$$
--   The file also defines:
--   1. $z_n(i,y) = c^i_n y + F_{n+1}(v_{n+1})(i,y)$ (4.11);
--   2. the function classes $B_0 \supseteq B_1 \supseteq C_1$ of §3: nonnegative pointwise limits of nonnegative continuous functions; those of linear growth; those that are also uniformly continuous in $x$;
--   3. the policy (3.3) generated by a feedback rule $\hat u_k(i,x)$;
--   4. the $(s,S)$ rule $(S - x)\delta(s - x)$ of (4.8), with extended real $s, S$ (Remark 4.4; $s = -\infty$ means never order);
--   5. the assumptions (4.1), $K^i_n \ge \sum_j p_{ij}K^j_{n+1} \ge 0$, and (4.2), $c^i_n x + F_{n+1}(f_{n+1})(i,x) \to +\infty$ as $x \to \infty$, for $n \in \langle 0, N-1\rangle$.
--
--   **Formalization Note**
--   1. Demand states are `Fin L` (zero based).
--   2. The Lean operator `F D n` is the paper's $F_{n+1}$: it integrates against $\varphi_{i,n}$.
--   3. Expectations are taken under the law in which, given $i_n = i$, the states $(i_n,\dots,i_N)$ and demands $(\xi_n,\dots,\xi_{N-1})$ have density $\prod_t p_{i_t i_{t+1}}\varphi_{i_t,t}(\xi_t)$ with respect to counting measure times Lebesgue measure. This is the reading of "ξ_k dependent on i_k" under which (3.1) is the conditional expectation in (3.2): $\xi_k$ is conditionally independent of $i_{k+1}$ and of the past given $i_k$.
--   4. $J$ is a `lintegral` in $[0,\infty]$.
--   5. (2.3) sums $c_k$ up to $k = N$ while $U$ stops at $u_{N-1}$; no order is placed in period $N$ ($u_N = 0$).
--   6. The DP uses real infima and Bochner integrals. The infimum is bounded below by $0$ because every cost is nonnegative, and Theorem 3.1 ($v_n \in C_1$) makes the integrals genuine.
--   7. Periods outside the horizon (`dpV` for $n > N$) carry junk values that no statement uses.
-- source:
--   Sethi and Cheng, Optimality of (s, S) policies in inventory models with Markovian demand, Oper. Res. 45(6) (1997), DOI 10.1287/opre.45.6.931, pp. 932–935, §2 (2.1)–(2.5), §3 (3.1)–(3.3), §4 (4.1), (4.2), (4.8), (4.11)

import Mathlib
import Definitions.Def_BertsekasKConvex
import Definitions.Def_SethiChengSS_Finite_KConvexity

namespace SethiChengSS.Finite

open MeasureTheory Filter Topology
open scoped ENNReal

/-- The data of the Markov-modulated inventory model of Sethi–Cheng (1997), §2, p. 932. Demand
states are `Fin L` (the paper's `I = {1, …, L}`, shifted to `{0, …, L − 1}`); periods are natural
numbers with the paper's base (`⟨0, N⟩ = {0, …, N}`).
* `P i j` is the transition probability `p_ij`;
* `φ k i` is the conditional density `φ_{i,k}` of the demand `ξ_k` given `i_k = i`;
* `K k i`, `c k i` are the fixed and variable ordering costs `K^i_k`, `c^i_k` of (2.1);
* `f k i` is the surplus cost `f_k(i, ·)`;
* `C` is the constant of (2.2) and `M` the bound on the conditional mean demand. -/
structure Data (L : ℕ) where
  P : Fin L → Fin L → ℝ
  φ : ℕ → Fin L → ℝ → ℝ
  K : ℕ → Fin L → ℝ
  c : ℕ → Fin L → ℝ
  f : ℕ → Fin L → ℝ → ℝ
  C : ℝ
  M : ℝ

variable {L : ℕ}

/-- The standing assumptions of §2 (pp. 932–933): `P` is a stochastic matrix; each `φ_{i,k}` is a
probability density of a nonnegative demand with `E{ξ_k | i_k = i} ≤ M`; `K^i_k ≥ 0`,
`c^i_k ≥ 0`; each `f_k(i, ·)` is convex, nonnegative, vanishes at `0`, and satisfies (2.2)
`f_k(i, x) ≤ C(1 + |x|)` with `C > 0`. -/
structure Standing (D : Data L) : Prop where
  P_nonneg : ∀ i j, 0 ≤ D.P i j
  P_sum : ∀ i, ∑ j, D.P i j = 1
  φ_meas : ∀ k i, Measurable (D.φ k i)
  φ_nonneg : ∀ k i z, 0 ≤ D.φ k i z
  φ_neg : ∀ k i z, z < 0 → D.φ k i z = 0
  φ_int : ∀ k i, ∫ z, D.φ k i z = 1
  mean_integrable : ∀ k i, Integrable (fun z => z * D.φ k i z)
  mean_le : ∀ k i, ∫ z, z * D.φ k i z ≤ D.M
  K_nonneg : ∀ k i, 0 ≤ D.K k i
  c_nonneg : ∀ k i, 0 ≤ D.c k i
  f_convex : ∀ k i, ConvexOn ℝ Set.univ (D.f k i)
  f_nonneg : ∀ k i x, 0 ≤ D.f k i x
  f_zero : ∀ k i, D.f k i 0 = 0
  C_pos : 0 < D.C
  f_growth : ∀ k i x, D.f k i x ≤ D.C * (1 + |x|)

/-- The ordering cost (2.1): `c_k(i, u) = K^i_k δ(u) + c^i_k u`. -/
noncomputable def orderCost (D : Data L) (k : ℕ) (i : Fin L) (u : ℝ) : ℝ :=
  D.K k i * delta u + D.c k i * u

/-- The operator (3.1). `F D n b i y = ∑_j p_ij ∫_0^∞ b(j, y − z) φ_{i,n}(z) dz`; this is the
paper's `F_{n+1}(b)(i, y)` (the index `n` here is the period whose demand `ξ_n` is integrated). -/
noncomputable def F (D : Data L) (n : ℕ) (b : Fin L → ℝ → ℝ) (i : Fin L) (y : ℝ) : ℝ :=
  ∑ j, D.P i j * ∫ z in Set.Ioi 0, b j (y - z) * D.φ n i z

/-- Auxiliary recursion for (3.2): `dpAux D N m` is `v_{N−m}`. -/
noncomputable def dpAux (D : Data L) (N : ℕ) : ℕ → Fin L → ℝ → ℝ
  | 0 => D.f N
  | m + 1 => fun i x => D.f (N - (m + 1)) i x +
      ⨅ u : {u : ℝ // 0 ≤ u},
        (orderCost D (N - (m + 1)) i u + F D (N - (m + 1)) (dpAux D N m) i (x + u))

/-- The functions defined by the dynamic programming equations (3.2):
`v_N(i, x) = f_N(i, x)` and, for `n < N`,
`v_n(i, x) = f_n(i, x) + inf_{u ≥ 0} {c_n(i, u) + F_{n+1}(v_{n+1})(i, x + u)}`.
For `n > N` the value is a junk value (`f_N`). -/
noncomputable def dpV (D : Data L) (N n : ℕ) : Fin L → ℝ → ℝ := dpAux D N (N - n)

/-- (4.1) for `n ∈ ⟨0, N − 1⟩`: `K^i_n ≥ K̄^i_{n+1} ≡ ∑_j p_ij K^j_{n+1} ≥ 0`. -/
def Cond41 (D : Data L) (N : ℕ) : Prop :=
  ∀ n < N, ∀ i, (∑ j, D.P i j * D.K (n + 1) j) ≤ D.K n i ∧ 0 ≤ ∑ j, D.P i j * D.K (n + 1) j

/-- (4.2) for `n ∈ ⟨0, N − 1⟩`: `c^i_n x + F_{n+1}(f_{n+1})(i, x) → +∞` as `x → ∞`. -/
def Cond42 (D : Data L) (N : ℕ) : Prop :=
  ∀ n < N, ∀ i, Tendsto (fun x => D.c n i * x + F D n (D.f (n + 1)) i x) atTop atTop

/-- `B_0` (§3, p. 933): nonnegative functions on `I × ℝ` that are pointwise limits of sequences of
nonnegative functions continuous in `x` (this includes the continuous ones). -/
def InB0 (b : Fin L → ℝ → ℝ) : Prop :=
  (∀ i x, 0 ≤ b i x) ∧
    ∃ g : ℕ → Fin L → ℝ → ℝ, (∀ k i, Continuous (g k i)) ∧ (∀ k i x, 0 ≤ g k i x) ∧
      ∀ i x, Tendsto (fun k => g k i x) atTop (𝓝 (b i x))

/-- `B_1`: functions of `B_0` of linear growth, `0 ≤ b(i, x) ≤ C_b(1 + |x|)` for some `C_b > 0`. -/
def InB1 (b : Fin L → ℝ → ℝ) : Prop :=
  InB0 b ∧ ∃ Cb : ℝ, 0 < Cb ∧ ∀ i x, b i x ≤ Cb * (1 + |x|)

/-- `C_1`: functions of `B_1` uniformly continuous in `x ∈ ℝ`. -/
def InC1 (b : Fin L → ℝ → ℝ) : Prop :=
  InB1 b ∧ ∀ i, UniformContinuous (b i)

/-- A history-dependent (nonanticipative) ordering policy for a problem started at period `n`:
`U t σ ξ` is the order quantity `u_{n+t}`, as a function of the demand states
`σ = (i_n, …, i_{n+t})` and the past demands `ξ = (ξ_n, …, ξ_{n+t−1})`. The initial surplus
`x_n = x` is fixed by the problem, so it is not an argument. -/
abbrev Policy (L : ℕ) : Type := (t : ℕ) → (Fin (t + 1) → Fin L) → (Fin t → ℝ) → ℝ

/-- A policy is admissible on a horizon of `m` periods (`u_n, …, u_{n+m−1}`) if every order is
nonnegative and measurable in the observed demands. -/
def Admissible (m : ℕ) (U : Policy L) : Prop :=
  ∀ t < m, (∀ σ ξ, 0 ≤ U t σ ξ) ∧ ∀ σ, Measurable (U t σ)

/-- The surplus `x_{n+t}` under policy `U` from `x_n = x`, by the balance equation (2.4)
`x_{k+1} = x_k + u_k − ξ_k`. -/
def surplus (U : Policy L) (x : ℝ) : (t : ℕ) → (Fin (t + 1) → Fin L) → (Fin t → ℝ) → ℝ
  | 0, _, _ => x
  | t + 1, σ, ξ => surplus U x t (Fin.init σ) (Fin.init ξ) + U t (Fin.init σ) (Fin.init ξ) -
      ξ (Fin.last t)

/-- The first `t + 1` states of a state path. -/
def initStates {m : ℕ} (σ : Fin (m + 1) → Fin L) (t : ℕ) (ht : t ≤ m) : Fin (t + 1) → Fin L :=
  fun j => σ ⟨j.1, by have := j.2; omega⟩

/-- The first `t` demands of a demand path. -/
def initDemands {m : ℕ} (ξ : Fin m → ℝ) (t : ℕ) (ht : t ≤ m) : Fin t → ℝ :=
  fun j => ξ ⟨j.1, by have := j.2; omega⟩

/-- The total cost `∑_{k=n}^{N} [c_k(i_k, u_k) + f_k(i_k, x_k)]` of (2.3) along the state path
`σ = (i_n, …, i_{n+m})` and demand path `ξ = (ξ_n, …, ξ_{n+m−1})`, `m = N − n`, with no order in
the last period `N` (`U = (u_n, …, u_{N−1})`, so `u_N = 0`). -/
noncomputable def pathCost (D : Data L) (N n : ℕ) (U : Policy L) (x : ℝ) {m : ℕ}
    (σ : Fin (m + 1) → Fin L) (ξ : Fin m → ℝ) : ℝ :=
  (∑ t : Fin m,
      (orderCost D (n + t) (σ t.castSucc)
          (U t (initStates σ t t.2.le) (initDemands ξ t t.2.le)) +
        D.f (n + t) (σ t.castSucc) (surplus U x t (initStates σ t t.2.le) (initDemands ξ t t.2.le)))) +
    D.f N (σ (Fin.last m)) (surplus U x m σ ξ)

/-- The joint weight of a state path and a demand path given `i_n = σ 0`:
`∏_{t<m} p_{i_{n+t} i_{n+t+1}} φ_{i_{n+t}, n+t}(ξ_{n+t})`, a density with respect to counting
measure on state paths times Lebesgue measure on demand paths. This encodes the Markov chain
`{i_k}` and the conditional independence of `ξ_k` (law `φ_{i_k,k}`) from `i_{k+1}` and from the
past, given `i_k`. -/
noncomputable def pathWeight (D : Data L) (n : ℕ) {m : ℕ} (σ : Fin (m + 1) → Fin L)
    (ξ : Fin m → ℝ) : ℝ :=
  ∏ t : Fin m, D.P (σ t.castSucc) (σ t.succ) * D.φ (n + t) (σ t.castSucc) (ξ t)

/-- The objective (2.3): `J_n(i, x; U) = E{∑_{k=n}^{N} [c_k(i_k, u_k) + f_k(i_k, x_k)]}` with
`i_n = i`, `x_n = x`, valued in `[0, ∞]`. -/
noncomputable def J (D : Data L) (N n : ℕ) (i : Fin L) (x : ℝ) (U : Policy L) : ℝ≥0∞ :=
  ∑ σ : Fin (N - n + 1) → Fin L,
    if σ 0 = i then
      ∫⁻ ξ : Fin (N - n) → ℝ,
        ENNReal.ofReal (pathWeight D n σ ξ) * ENNReal.ofReal (pathCost D N n U x σ ξ)
    else 0

/-- The value function (2.5): `v_n(i, x) = inf_{U ∈ 𝒰} J_n(i, x; U)`, the infimum over all
admissible history-dependent policies on the horizon `⟨n, N⟩`. -/
noncomputable def value (D : Data L) (N n : ℕ) (i : Fin L) (x : ℝ) : ℝ≥0∞ :=
  ⨅ U : Policy L, ⨅ (_ : Admissible (N - n) U), J D N n i x U

/-- The surplus `x̂_{n+t}` generated by the feedback rule `û` from `x̂_n = x` (3.3). -/
def fbSurplus (û : ℕ → Fin L → ℝ → ℝ) (n : ℕ) (x : ℝ) :
    (t : ℕ) → (Fin (t + 1) → Fin L) → (Fin t → ℝ) → ℝ
  | 0, _, _ => x
  | t + 1, σ, ξ =>
      fbSurplus û n x t (Fin.init σ) (Fin.init ξ) +
        û (n + t) (Fin.init σ (Fin.last t)) (fbSurplus û n x t (Fin.init σ) (Fin.init ξ)) -
        ξ (Fin.last t)

/-- The policy (3.3) generated by a feedback rule `û_k(i, x)` started at period `n` from
`x̂_n = x`: `û_k = û_k(i_k, x̂_k)`, `x̂_{k+1} = x̂_k + û_k − ξ_k`. -/
def feedback (û : ℕ → Fin L → ℝ → ℝ) (n : ℕ) (x : ℝ) : Policy L :=
  fun t σ ξ => û (n + t) (σ (Fin.last t)) (fbSurplus û n x t σ ξ)

/-- The `(s, S)` rule (4.8), `(S − x) δ(s − x)`, with extended real `s, S` (Remark 4.4): order up
to `S` when `x < s`, otherwise order nothing. With `s = −∞` it never orders. -/
noncomputable def orderSS (s S : EReal) (x : ℝ) : ℝ :=
  if (x : EReal) < s then S.toReal - x else 0

/-- (4.11): `z_n(i, y) = c^i_n y + F_{n+1}(v_{n+1})(i, y)`. -/
noncomputable def zFun (D : Data L) (N n : ℕ) (i : Fin L) (y : ℝ) : ℝ :=
  D.c n i * y + F D n (dpV D N (n + 1)) i y

end SethiChengSS.Finite


