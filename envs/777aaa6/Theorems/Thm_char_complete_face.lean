open scoped Classical

theorem char_complete_face :
    ∀ {SC : SpernerCube} {n1 : ℕ} {hn1 : n1 + 1 = SC.n} (I : Fin (n1 + 1) → SC.G) (J : Fin (SC.n + 1) → SC.G),
  simplex SC SC.n J →
    (complete_simplex SC n1 I ∧ is_face SC I J ↔
      ∃ (i : Fin (SC.n + 1)),
        I = delete_vertex SC (hn1 := hn1) i J ∧ ∀ c ≤ n1, ∃ (i2 : Fin (SC.n + 1)), i2 ≠ i ∧ SC.RL (J i2) = c)
:= by sorry
