-- title:
--   (2.23) — the one-step bound for Ψ(x^ag_k) under (2.9), Ψ convex
-- statement:
--   Let $\Psi:\mathbb R^n\to\mathbb R$ be convex and differentiable with $L_\Psi$-Lipschitz gradient, $L_\Psi>0$, and let $x_k,x^{md}_k,x^{ag}_k$ be generated by Algorithm 1 from $x_0$ with step sizes $\alpha_1=1$, $\alpha_k\in(0,1)$ ($k\ge2$), $\beta_k>0$, $\lambda_k>0$. Let $k\ge1$ satisfy (2.9), $\alpha_k\lambda_k\le\beta_k<1/L_\Psi$. Then for every $x\in\mathbb R^n$,
--   $$\Psi(x^{ag}_k)\le(1-\alpha_k)\Psi(x^{ag}_{k-1})+\alpha_k\Psi(x)+\frac{\alpha_k}{2\lambda_k}\Big[\|x_{k-1}-x\|^2-\|x_k-x\|^2\Big]-\frac{\beta_k}{2}(1-L_\Psi\beta_k)\|\nabla\Psi(x^{md}_k)\|^2 .$$
--
--   It has the form (2.5) of Lemma 1 with $\theta_k=\Psi(x^{ag}_k)-\Psi(x)$, which is how it is summed into (2.24).
--
--   **Formalization Note** The statement is the outer ends of the chain (2.23); (2.9) is assumed at the index $k$ only.
-- source:
--   Ghadimi & Lan, Accelerated Gradient Methods for Nonconvex Nonlinear and Stochastic Programming, arXiv:1310.3787v1, p. 7, (2.23)

import Mathlib
import Definitions.Def_ConvexOptAlg_SmoothGD_Defs
import Definitions.Def_NonconvexAG_Smooth_AGRun

namespace NonconvexAG.Smooth

/-- (2.23), p. 7 (outer ends of the chain), for convex `Ψ`, under (2.9) at step `k`,
for every `x ∈ ℝⁿ`. -/
theorem eq_2_23 {n : ℕ} (Ψ : E n → ℝ) (g : E n → E n) (LΨ : ℝ)
    (hΨ : ConvexOptAlg.SmoothGD.IsBetaSmooth Ψ g LΨ) (hL : 0 < LΨ)
    (α β lam : ℕ → ℝ) (hstep : AGStepsizes α β lam) (x0 : E n) (hconv : ConvexOn ℝ Set.univ Ψ) :
    ∀ k, 1 ≤ k → α k * lam k ≤ β k → β k < 1 / LΨ → ∀ x : E n,
      Ψ (xagSeq g α β lam x0 k) ≤ (1 - α k) * Ψ (xagSeq g α β lam x0 (k - 1)) + α k * Ψ x
        + α k / (2 * lam k) * (‖xSeq g α β lam x0 (k - 1) - x‖ ^ 2 - ‖xSeq g α β lam x0 k - x‖ ^ 2)
        - β k / 2 * (1 - LΨ * β k) * ‖g (xmdSeq g α β lam x0 k)‖ ^ 2 := by sorry

end NonconvexAG.Smooth
