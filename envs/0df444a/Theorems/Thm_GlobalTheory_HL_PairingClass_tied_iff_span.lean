variable {E : Type} [CommRing E] {n : ℕ}

theorem GlobalTheory.HL.PairingClass.tied_iff_span (O : Subring E) (θ : E) (A A' : Matrix (Fin n) (Fin n) E) :
    (((∀ a b, b < a → A a b = 0) ∧ (∀ a, A a a = 1) ∧ ∀ a b, A a b ∈ O) ∧
      ((∀ a b, b < a → A' a b = 0) ∧ (∀ a, A' a a = 1) ∧ ∀ a b, A' a b ∈ O) ∧
      (∀ a b, A a b - A' a b ∈ Submodule.span O {θ})) ↔ Tied O θ A A' := by sorry
