-- url     : https://prove2.me/theorems/8d58ca10-3058-4928-b300-4a47eabbf744
-- title:
--   The $n$-player game of §4: distributed controls $\alpha^i_t=\hat\alpha(t,X^i)$, $\mathbb F^n$, $\mathbb A_n$, $P_n(\beta)$, $J_{n,i}$ and $J'_n$
-- statement:
--   Assume (S), (C) and (F), and fix a solution $(\hat\mu,\hat q)$ of the MFG whose control is the closed-loop control $\hat\alpha(t,X)$, with $\hat\alpha:[0,T]\times\mathcal C\to A$ progressively measurable. Write $b(t,x,a)$ for the drift, which by (F.1) has no mean field term.
--
--   A probability space $(\Omega,\mathcal F,P)$ supports independent $d$-dimensional Wiener processes $W^1,W^2,\dots$, independent $\mathbb R^d$-valued random variables $\xi^1,\xi^2,\dots$ with common law $\lambda_0$, and processes $X^1,X^2,\dots$ satisfying
--   $$dX^i_t=b(t,X^i,\hat\alpha(t,X^i))\,dt+\sigma(t,X^i)\,dW^i_t,\qquad X^i_0=\xi^i.$$
--   For each $n$, $\mathbb F^n=(\mathcal F^n_t)$ is the filtration generated by $(X^1,\dots,X^n)$ completed by null sets. The **distributed controls** are $\alpha^i_t=\hat\alpha(t,X^i)$.
--
--   For fixed $n\ge1$, the control space $\mathbb A_n$ is the set of $\mathbb F^n$-progressively measurable $A$-valued processes; a strategy profile is $\beta=(\beta^1,\dots,\beta^n)\in\mathbb A_n^n$. The measure $P_n(\beta)$ is defined by
--   $$\frac{dP_n(\beta)}{dP}=\mathcal E\Big(\int_0^\cdot\sum_{i=1}^n\big(\sigma^{-1}b(t,X^i,\beta^i_t)-\sigma^{-1}b(t,X^i,\alpha^i_t)\big)\,dW^i_t\Big)_T,$$
--   and the value to player $i$ of the profile $\beta$ is
--   $$J_{n,i}(\beta)=\mathbb E^{P_n(\beta)}\Big[\int_0^Tf\big(t,X^i,\mu^n,q^n(\beta_t),\beta^i_t\big)\,dt+g(X^i,\mu^n)\Big],$$
--   where $\mu^n=\frac1n\sum_{j=1}^n\delta_{X^j}$ and $q^n(\beta_t)=\frac1n\sum_{j=1}^n\delta_{\beta^j_t}$. For $\beta\in\mathbb A_n$, $\beta^\alpha=(\beta,\alpha^2,\dots,\alpha^n)$ and
--   $$J'_n(\beta)=\mathbb E^{P_n(\beta^\alpha)}\Big[\int_0^Tf(t,X^1,\hat\mu,\hat q_t,\beta_t)\,dt+g(X^1,\hat\mu)\Big].$$
--
--   This is the game in which Theorem 4.2 shows the distributed controls to be an approximate Nash equilibrium; $J'_n$ is the auxiliary value of §8.1.
--
--   **Formalization Note** Everything above is bundled in one structure: the mean field data on the base space (with (S), (C), (F)), the solution $(\hat\mu,\hat q,\hat\alpha)$ with Definition 3.4's clauses for the control $\hat\alpha(t,X)$, and the game space. Players and the sequences are indexed from $0$, so player 1 is index $0$. "Independent" is encoded as mutual independence of the pairs $(\xi^i,W^i)$ together with independence of $\xi^i$ and $W^i$ for each $i$. Each $X^i-\xi^i$ is an $L^2$ Itô process for the augmented filtration of $(\xi^i,W^i)$. The densities are relations over versions of the Itô integrals (for the filtration $\mathbb F^n$), and $J_{n,i}$, $J'_n$ are computed as $\mathbb E^P[D(\cdots)]$ for a version $D$. $\mathbb A_n$-processes are typed with values in $A$.
-- source:
--   Carmona, Lacker, A probabilistic weak formulation of mean field games and applications, arXiv:1307.1152v2 (2014), §4, pp. 12–13 (the n-player game, P_n(β), J_{n,i}, q^n); §8.1, p. 32 (β^α, J'_n)

import Mathlib
import Definitions.Def_WeakMFG_Approx_Reward
import Definitions.Def_WeakMFG_Approx_Empirical

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal Matrix

namespace WeakMFG.Approx

variable {d : ℕ} {T : ℝ≥0} {EA : Type*} [NormedAddCommGroup EA] [NormedSpace ℝ EA]
  [MeasurableSpace EA] [BorelSpace EA]

/-- The setting of §4 (pp. 12–13) of Carmona–Lacker, arXiv:1307.1152v2.

*Mean field part.* On the base space `B` the standing assumptions (S) hold (`standing`, and the
driftless state `X` of (S.2)), and so do (C) and (F) (with `𝒳 = P ∘ X⁻¹`). `(μ̂, q̂)` is a solution of
the MFG (Definition 3.4) whose control is the closed-loop control `α̂(t, X)` (Remark 3.2), with
`α̂ : [0, T] × C → A` progressively measurable. `b₀` is the drift `b(t, x, a)` of (F.1).

*Game part.* A probability space `(Ω', P')` carries independent `d`-dimensional Wiener processes
`W¹, W², …`, independent `ℝ^d`-valued `ξ¹, ξ², …` with common law `λ₀ = P ∘ ξ⁻¹`, all mutually
independent, and processes `Xⁱ` solving `dXⁱ_t = b(t, Xⁱ, α̂(t, Xⁱ)) dt + σ(t, Xⁱ) dWⁱ_t`,
`Xⁱ_0 = ξⁱ` (strong solutions for the augmented filtration of `(ξⁱ, Wⁱ)`).
Formalization Note: players are indexed from `0` (D7); the SDEs are L² Itô processes (D2);
`Xpn i ω ∈ C` is the path of `Xⁱ(ω)` on `[0, T]`. -/
structure Game {Ω : Type*} [MeasurableSpace Ω] (B : Base d Ω) (Ω' : Type*) [MeasurableSpace Ω']
    (ψ : WeakMFG.Existence.Path d T → ℝ) (A : Set EA) (σ : ℝ≥0 → WeakMFG.Existence.Path d T → Matrix (Fin d) (Fin d) ℝ)
    (b : ℝ≥0 → WeakMFG.Existence.Path d T → Ppsi ψ → EA → (Fin d → ℝ))
    (f : ℝ≥0 → WeakMFG.Existence.Path d T → Ppsi ψ → PA A → EA → ℝ) (g : WeakMFG.Existence.Path d T → Ppsi ψ → ℝ) where
  /-- The horizon is positive. -/
  hT : 0 < T
  /-- The driftless state of (S.2) on the base space. -/
  X : Driftless B ψ A σ b
  standing : Standing A σ b f g
  condC : CondC A σ b f
  condF : CondF X.law b f g
  /-- The drift without mean field term, (F.1). -/
  b₀ : ℝ≥0 → WeakMFG.Existence.Path d T → EA → (Fin d → ℝ)
  hb₀ : ∀ t x μ a, b t x μ a = b₀ t x a
  /-- The fixed MFG solution `(μ̂, q̂)` and its closed-loop control `α̂`. -/
  μh : Ppsi ψ
  qh : ℝ≥0 → PA A
  αh : ℝ≥0 → WeakMFG.Existence.Path d T → A
  αh_prog : IsStronglyProgressive pathFilt αh
  sol_meas : Measurable[_, borel (PA A)] qh
  sol : SolvesMFGWith X f g μh qh (fun t ω => (αh t (X.Xp ω) : EA))
  /-- The game space. -/
  P' : Measure Ω'
  isProb' : IsProbabilityMeasure P'
  Wn : ℕ → ℝ≥0 → Ω' → Fin d → ℝ
  hWn : ∀ i, Peng1990.SMP.IsStdBrownian P' (Wn i)
  ξn : ℕ → Ω' → Fin d → ℝ
  ξn_meas : ∀ i, Measurable (ξn i)
  ξn_law : ∀ i, P'.map (ξn i) = B.P.map B.ξ
  indep : iIndepFun (fun i ω => (ξn i ω, fun t => Wn i t ω)) P'
  indep_ξW : ∀ i, IndepFun (ξn i) (fun ω t => Wn i t ω) P'
  Xn : ℕ → ℝ≥0 → Ω' → Fin d → ℝ
  Xpn : ℕ → Ω' → WeakMFG.Existence.Path d T
  hXpn : ∀ i ω s, Xpn i ω s = Xn i (s : ℝ).toNNReal ω
  Xn_meas : ∀ i t, Measurable (Xn i t)
  sde : ∀ i, Peng1990.SMP.IsItoProcess (augFilt P' (ξn i) (ξn_meas i) (hWn i)) P' T (Wn i) 0
    (fun s ω => b₀ s (Xpn i ω) (αh s (Xpn i ω) : EA))
    (fun j s ω k => σ s (Xpn i ω) k j) (fun t ω => Xn i t ω - ξn i ω)

namespace Game

variable {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω'] {B : Base d Ω}
  {ψ : WeakMFG.Existence.Path d T → ℝ} {A : Set EA} {σ : ℝ≥0 → WeakMFG.Existence.Path d T → Matrix (Fin d) (Fin d) ℝ}
  {b : ℝ≥0 → WeakMFG.Existence.Path d T → Ppsi ψ → EA → (Fin d → ℝ)}
  {f : ℝ≥0 → WeakMFG.Existence.Path d T → Ppsi ψ → PA A → EA → ℝ} {g : WeakMFG.Existence.Path d T → Ppsi ψ → ℝ}

/-- `𝔽ⁿ`: the filtration generated by `(X¹, …, Xⁿ)`, completed by the (measurable) `P'`-null sets
(p. 12). -/
noncomputable def filtN (G : Game B Ω' ψ A σ b f g) (n : ℕ) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace Ω') where
  seq t := Filtration.natural (fun t ω (j : Fin n) => G.Xn j t ω)
      (fun t => (measurable_pi_lambda (fun ω (j : Fin n) => G.Xn j t ω)
        fun j => G.Xn_meas j t).stronglyMeasurable) t ⊔
    WeakMFG.Existence.nullSigma G.P'
  mono' _ _ hst := sup_le_sup_right (Filtration.mono _ hst) _
  le' t := sup_le (Filtration.le _ t) (nullSigma_le _)

/-- The distributed controls `αⁱ_t = α̂(t, Xⁱ)` of the first `n` players (p. 13). -/
def αn (G : Game B Ω' ψ A σ b f g) (n : ℕ) : Fin n → ℝ≥0 → Ω' → A :=
  fun i t ω => G.αh t (G.Xpn i ω)

/-- `β ∈ 𝔸_n`: an `𝔽ⁿ`-progressively measurable `A`-valued process (p. 13). -/
def IsAdmissibleN (G : Game B Ω' ψ A σ b f g) (n : ℕ) (β : ℝ≥0 → Ω' → A) : Prop :=
  IsStronglyProgressive (G.filtN n) β

/-- The kernel `σ⁻¹ b(t, Xⁱ, βⁱ_t) − σ⁻¹ b(t, Xⁱ, αⁱ_t)` of `dP_n(β)/dP` (p. 13), coordinate `j`. -/
noncomputable def thetaN (G : Game B Ω' ψ A σ b f g) (n : ℕ) (β : Fin n → ℝ≥0 → Ω' → A)
    (i : Fin n) (j : Fin d) (s : ℝ≥0) (ω : Ω') : ℝ :=
  ((σ s (G.Xpn i ω))⁻¹ *ᵥ (G.b₀ s (G.Xpn i ω) (β i s ω : EA) -
    G.b₀ s (G.Xpn i ω) (G.αn n i s ω : EA))) j

/-- `D` is a version of `dP_n(β)/dP = 𝓔(∫₀^· Σᵢ (σ⁻¹ b(t, Xⁱ, βⁱ_t) − σ⁻¹ b(t, Xⁱ, αⁱ_t)) dWⁱ_t)_T`
(p. 13), for `β ∈ 𝔸ⁿ_n`: `D = exp(Σᵢ Σⱼ Jᵢⱼ(T) − ½ ∫₀ᵀ Σᵢ Σⱼ θᵢⱼ² dt)` for Itô integrals `Jᵢⱼ`
(filtration `𝔽ⁿ`) of the kernel coordinates against the coordinates of `Wⁱ` (D6). -/
def IsDensityN (G : Game B Ω' ψ A σ b f g) (n : ℕ) (β : Fin n → ℝ≥0 → Ω' → A) (D : Ω' → ℝ) :
    Prop :=
  ∃ J : Fin n → Fin d → ℝ≥0 → Ω' → ℝ,
    (∀ (i : Fin n) (j : Fin d), Peng1990.SMP.IsItoIntegral (G.filtN n) G.P' T (fun s ω => G.Wn i s ω j)
      (G.thetaN n β i j) (J i j)) ∧
    ∀ ω, D ω = Real.exp (∑ i : Fin n, ∑ j : Fin d, J i j T ω -
      (1 / 2) * ∫ s in Set.Icc (0 : ℝ) T,
        ∑ i : Fin n, ∑ j : Fin d, (G.thetaN n β i j s.toNNReal ω) ^ 2)

/-- The empirical measure `μⁿ = (1/n) Σ_{j ≤ n} δ_{Xʲ}` of the first `n` state processes (1.2). -/
noncomputable def empN (G : Game B Ω' ψ A σ b f g) (n : ℕ) [NeZero n] (ω : Ω') : Ppsi ψ :=
  empPath (fun j : Fin n => G.Xpn j ω)

/-- The value to player `i` of the profile `β ∈ 𝔸ⁿ_n` (p. 13),
`J_{n,i}(β) := E^{P_n(β)}[∫₀ᵀ f(t, Xⁱ, μⁿ, qⁿ(β_t), βⁱ_t) dt + g(Xⁱ, μⁿ)]`, computed with a version `D`
of `dP_n(β)/dP` as `E^{P'}[D (…)]`. -/
noncomputable def JN (G : Game B Ω' ψ A σ b f g) (n : ℕ) [NeZero n] (i : Fin n)
    (β : Fin n → ℝ≥0 → Ω' → A) (D : Ω' → ℝ) : ℝ :=
  ∫ ω, D ω * ((∫ t in Set.Icc (0 : ℝ) T,
      f t.toNNReal (G.Xpn i ω) (G.empN n ω) (empCtrl (fun j => β j t.toNNReal ω))
        (β i t.toNNReal ω : EA)) + g (G.Xpn i ω) (G.empN n ω)) ∂G.P'

/-- `J′_n(β) := E^{P_n(β^α)}[∫₀ᵀ f(t, X¹, μ̂, q̂_t, β_t) dt + g(X¹, μ̂)]` (§8.1, p. 32), where
`β^α = (β, α², …, αⁿ)` and `D` is a version of `dP_n(β^α)/dP`. Player 1 is index `0` (D7). -/
noncomputable def J'N (G : Game B Ω' ψ A σ b f g) (β : ℝ≥0 → Ω' → A) (D : Ω' → ℝ) : ℝ :=
  ∫ ω, D ω * ((∫ t in Set.Icc (0 : ℝ) T,
      f t.toNNReal (G.Xpn 0 ω) G.μh (G.qh t.toNNReal) (β t.toNNReal ω : EA)) +
    g (G.Xpn 0 ω) G.μh) ∂G.P'

end Game

end WeakMFG.Approx


