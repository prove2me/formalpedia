-- title:
--   Norm-sum lower bound on the dividing exponent
-- statement:
--   Let $x,y\in\mathbb Z[\omega]$ and $m\in\mathbb N$ satisfy $|x|^2+|y|^2=(\sqrt2)^m$. Write $v$ for the greatest dividing exponent at base $\sqrt2$, with $v(0)=\infty$. Then
--
--   $$
--   v(|x+y|^2)\ge\min\left\{m,\ 1+\left\lfloor\frac{v(|x|^2)+v(|y|^2)}2\right\rfloor\right\}.
--   $$
--
--   For extended exponents the half-floor of infinity is infinity. The assertion includes a zero summand and cancellation $x+y=0$, and provides the valuation estimate for a Hadamard combination.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 10, Lemma 5: norm-sum lower bound on dividing exponents

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Lemma 5, PDF p.10: the norm-sum exponent is m, not 2m. Extended-valued
gde includes x=0, y=0 and x+y=0; floor(infinity/2)=infinity. -/
theorem norm_sum_valuation_bound (x y : integralRing) (m : ℕ)
    (hsum : Complex.normSq (x : ℂ) + Complex.normSq (y : ℂ) = Real.sqrt 2 ^ m) :
    min (m : ℕ∞) (1 + halfValuation (gde (normSquared (x : ℂ)) +
      gde (normSquared (y : ℂ)))) ≤ gde (normSquared ((x : ℂ) + (y : ℂ))) := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
