theorem CerednikDrinfeld.QM.FakeEllipticCurve.hom_eq_of_comp_eq_of_isNilpotent_ker
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ}
    (B B₀ : Type) [CommRing B] [IsNoetherianRing B] [CommRing B₀] [Algebra B B₀]
    (hπ : Function.Surjective (algebraMap B B₀)) (hker : IsNilpotent (RingHom.ker (algebraMap B B₀)))
    (E E' : FakeEllipticCurve Λ N B) {A₀ : Scheme.{0}} (f₀ : A₀ ⟶ Spec (CommRingCat.of B₀)) (g : A₀ ⟶ E.A)
    (hg : CategoryTheory.IsPullback g f₀ E.f (Spec.map (CommRingCat.ofHom (algebraMap B B₀))))
    (φ₁ φ₂ : E.A ⟶ E'.A) (hg12 : g ≫ φ₁ = g ≫ φ₂)
    (hφ₁ : φ₁ ≫ E'.f = E.f) (hφ₂ : φ₂ ≫ E'.f = E.f)
    (hom₁ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t E.f),
      mapPt φ₁ hφ₁ (E.L.mul t P Q) = E'.L.mul t (mapPt φ₁ hφ₁ P) (mapPt φ₁ hφ₁ Q))
    (hom₂ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t E.f),
      mapPt φ₂ hφ₂ (E.L.mul t P Q) = E'.L.mul t (mapPt φ₂ hφ₂ P) (mapPt φ₂ hφ₂ Q)) :
    φ₁ = φ₂ := by
  refine GoodReductionJacobian.RelativeGroupLaw.eq_of_forall_comp_eq_of_isNilpotent_ker_of_isNoetherianRing
    (algebraMap B B₀) hπ hker E.L E'.L E.bundle E'.bundle φ₁ φ₂ hφ₁ hφ₂
    (fun t P Q => hom₁ t P Q) (fun t P Q => hom₂ t P Q) ?_
  intro T t P
  rw [← hg.lift_fst P.1 t P.2, Category.assoc, hg12, Category.assoc]

