-- url     : https://prove2.me/theorems/0163dc84-5623-42cb-8de7-da3cadab2167
-- title:
--   Multiple HNN extensions of a group (OpenAI Kaplansky counterexample split, definitions)
-- statement:
--   OpenAI's Lean construction of the multiple HNN extension, from `lean/OAI/RingTheory/DirectFiniteness/MultiHNN.lean` (OpenAI, *A Counterexample to Kaplansky's Direct-Finiteness Conjecture in Characteristic Two*, OpenAI Math Release, September 23, 2026, result family 197, [github.com/openai/math](https://github.com/openai/math) at commit adc7f12, Apache License 2.0), ported to Lean 4.33.1 and Mathlib 0df444a. It imports only Mathlib.
--
--   For a group `H : Type u`, an index type `I : Type v`, subgroups `A B : I → Subgroup H` and isomorphisms `φ : ∀ i, A i ≃* B i`, in namespace `OAI.KaplanskyCounterexample.MultipleHNN`:
--   - `con A B φ` is the congruence on the free product `Monoid.Coprod H (FreeGroup I)` generated by the relations $t_i\,a = \varphi_i(a)\,t_i$ for $i \in I$ and $a \in A_i$, where $t_i$ is the free generator `FreeGroup.of i`;
--   - `Extension A B φ` is the quotient, $\langle H, t_i\ (i \in I) \mid t_i a t_i^{-1} = \varphi_i(a)\rangle$, and `instGroupExtension` is its group structure;
--   - `of A B φ : H →* Extension A B φ` is the map from $H$, and `letter A B φ i` is the class of $t_i$;
--   - `lift A B φ f t ht` is the homomorphism to a group $G$ determined by `f : H →* G` and elements `t : I → G` with `t i * f a = f (φ i a) * t i`; the `@[simp]` lemmas `lift_of` and `lift_letter` compute it on $H$ and on the letters;
--   - `induction_on` (an `@[elab_as_elim]` induction principle) says that the extension is generated by the image of $H$ and the letters.
--
--   The published statements `OAI.KaplanskyCounterexample.MultipleHNN.of_injective` (the Higman–Neumann–Neumann embedding for finitely many letters) and `OAI.KaplanskyCounterexample.CurrentMain.multipleHNN_finitelyPresented` are stated with these definitions. The bundle is kept separate from the rest of the split so that those two statements depend on nothing else.
-- source:
--   OpenAI, A Counterexample to Kaplansky's Direct-Finiteness Conjecture in Characteristic Two, OpenAI Math Release, September 23, 2026, https://github.com/openai/math (result family 197; paper: https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/A-Counterexample-to-Kaplanskys-Direct-Finiteness-Conjecture-in-Characteristic-Two-September-23-2026/paper.pdf; Apache License 2.0); definitions from lean/OAI/RingTheory/DirectFiniteness/MultiHNN.lean at commit adc7f12. The construction is that of G. Higman, B. H. Neumann and H. Neumann, Embedding theorems for groups, J. London Math. Soc. 24 (1949), 247–254.

import Mathlib

section
-- module Solutions.OAIQW_Kaplansky.MultiHNN
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

universe u_1 u_2 u_3

noncomputable section
open scoped Classical
open Monoid Function
namespace KaplanskyCounterexample.MultipleHNN

universe u v
variable {H : Type u} [Group H] {I : Type v}
variable (A B : I → Subgroup H) (φ : ∀ i, A i ≃* B i)

def con : Con (Monoid.Coprod H (FreeGroup I)) := conGen fun x y =>
  ∃ (i : I) (a : A i), x = Coprod.inr (FreeGroup.of i) * Coprod.inl (a : H) ∧
    y = Coprod.inl (φ i a : H) * Coprod.inr (FreeGroup.of i)

abbrev Extension := (con A B φ).Quotient

instance instGroupExtension : Group (Extension A B φ) := by delta Extension; infer_instance

def of : H →* Extension A B φ := (con A B φ).mk'.comp Coprod.inl

def letter (i : I) : Extension A B φ := (con A B φ).mk' (Coprod.inr (FreeGroup.of i))

def lift {G : Type u_1} [Group G] (f : H →* G) (t : I → G)
    (ht : ∀ i (a : A i), t i * f a = f (φ i a) * t i) : Extension A B φ →* G :=
  Con.lift _ (Coprod.lift f (FreeGroup.lift t)) (Con.conGen_le.mpr (by
    rintro _ _ ⟨i, a, rfl, rfl⟩
    simp [ht]))

@[simp] lemma lift_of {G : Type u_2} [Group G] (f : H →* G) (t : I → G)
    (ht : ∀ i (a : A i), t i * f a = f (φ i a) * t i) (h : H) :
    lift A B φ f t ht (of A B φ h) = f h := by
  change Coprod.lift f (FreeGroup.lift t) (Coprod.inl h) = f h
  simp

@[simp] lemma lift_letter {G : Type u_3} [Group G] (f : H →* G) (t : I → G)
    (ht : ∀ i (a : A i), t i * f a = f (φ i a) * t i) (i : I) :
    lift A B φ f t ht (letter A B φ i) = t i := by
  change Coprod.lift f (FreeGroup.lift t) (Coprod.inr (FreeGroup.of i)) = t i
  simp

/-- The presentation is generated by the base group and the stable letters. -/
@[elab_as_elim]
theorem induction_on {P : Extension A B φ → Prop} (x : Extension A B φ)
    (hof : ∀ h, P (of A B φ h)) (ht : ∀ i, P (letter A B φ i))
    (hmul : ∀ x y, P x → P y → P (x * y)) (hinv : ∀ x, P x → P x⁻¹) : P x := by
  obtain ⟨w, rfl⟩ := (Con.mk'_surjective (c := con A B φ)) x
  induction w using Coprod.induction_on with
  | inl h => exact hof h
  | inr w =>
    induction w using FreeGroup.induction_on with
    | C1 => simpa only [map_one] using hof 1
    | of i => exact ht i
    | inv_of i ih => simpa only [map_inv] using hinv _ ih
    | mul a b ha hb => simpa only [map_mul] using hmul _ _ ha hb
  | mul a b ha hb => simpa only [map_mul] using hmul _ _ ha hb

end KaplanskyCounterexample.MultipleHNN
end

end OAI
end


