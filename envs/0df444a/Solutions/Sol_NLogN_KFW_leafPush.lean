    intro j hj
    have hjm : j < m := by omega
    have := loopT (hT j hjm) (hb j hjm) (ih (j + 1) (by omega))
    refine this.mono ?_
    rw [Finset.sum_eq_sum_Ico_succ_bot hjm]
