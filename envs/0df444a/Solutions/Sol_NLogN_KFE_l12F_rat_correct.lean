lemma decode_append (A B : Shape) {n : ℕ} (hn : n < AModel.vol A * AModel.vol B) :
    decode (A ++ B) n = decode A (n / AModel.vol B) ++ decode B (n % AModel.vol B) := by
  induction A generalizing n with
  | nil =>
    simp only [vol_nil, one_mul] at hn
    simp [decode, Nat.mod_eq_of_lt hn]
  | cons q A ih =>
    simp only [vol_cons] at hn
    have hAB : 0 < AModel.vol A * AModel.vol B := by
      rcases Nat.eq_zero_or_pos (AModel.vol A * AModel.vol B) with h | h
      · rw [mul_assoc, h] at hn; simp at hn
      · exact h
    simp only [List.cons_append, decode, vol_append]
    rw [ih (Nat.mod_lt _ hAB)]
    congr 2
    · rw [Nat.div_div_eq_div_mul, mul_comm (AModel.vol B)]
    · rw [mul_comm (AModel.vol A), Nat.mod_mul_right_div_self]
    · simp

lemma encode_append_len (X Y : Shape) {u w : List ℕ} (hu : u.length = X.length) :
    encode (X ++ Y) (u ++ w) = encode X u * AModel.vol Y + encode Y w := by
  rw [encode_append, List.drop_left' hu]
  congr 2
  apply encode_congr
  intro k hk
  rw [List.getD_append _ _ _ _ (by omega)]

/-- **Prefix transport.** A pull acting only on the digits after a prefix `X` is the same array
operation whatever field structure the prefix has (only `vol X` matters). -/
theorem pull_prefix {α : Type*} (X X' Y : Shape) (hX : AModel.vol X = AModel.vol X')
    (f : List ℕ → List ℕ) (d : α) (xs : List α) :
    AModel.pull (X ++ Y) (X ++ Y) (fun a => a.take X.length ++ f (a.drop X.length)) d xs =
      AModel.pull (X' ++ Y) (X' ++ Y) (fun a => a.take X'.length ++ f (a.drop X'.length)) d xs := by
  have key : ∀ Z : Shape, ∀ j < AModel.vol Z * AModel.vol Y,
      encode (Z ++ Y) ((fun a => a.take Z.length ++ f (a.drop Z.length)) (decode (Z ++ Y) j)) =
        j / AModel.vol Y * AModel.vol Y + encode Y (f (decode Y (j % AModel.vol Y))) := by
    intro Z j hj
    have hY : 0 < AModel.vol Y := by
      rcases Nat.eq_zero_or_pos (AModel.vol Y) with h | h
      · rw [h] at hj; simp at hj
      · exact h
    have hl : (decode Z (j / AModel.vol Y)).length = Z.length := length_decode _ _
    simp only [decode_append Z Y hj, List.take_left' hl, List.drop_left' hl]
    rw [encode_append_len Z Y (length_decode _ _), encode_decode
      ((Nat.div_lt_iff_lt_mul hY).2 hj)]
  apply List.ext_getElem (by simp [vol_append, hX])
  intro j h₁ h₂
  simp only [length_pull, vol_append] at h₁ h₂
  rw [getElem_pull, getElem_pull, key X j h₁, key X' j h₂]

/-- `blockSwap` after a prefix of `c` digits. -/
lemma blockSwap_shift {c i j r : ℕ} {a : List ℕ} (hc : c ≤ a.length) :
    blockSwap (c + i) (c + j) r a = a.take c ++ blockSwap i j r (a.drop c) := by
  apply List.ext_getElem (by simp; omega)
  intro k h₁ h₂
  rw [getElem_blockSwap]
  by_cases hk : k < c
  · rw [List.getElem_append_left (by simp; omega), List.getElem_take,
      bsIdx_out (by omega) (by omega), List.getD_eq_getElem]
  · simp only [length_blockSwap] at h₁
    rw [List.getElem_append_right (by simp; omega), getElem_blockSwap]
    simp only [List.length_take, min_eq_left hc]
    rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_drop]
    congr 2
    unfold bsIdx; split_ifs <;> omega

/-- **Block swap after a reshaped prefix.** -/
theorem pull_blockSwap_prefix {α : Type*} (X X' Y : Shape) (hX : AModel.vol X = AModel.vol X')
    (i j r : ℕ) (d : α) (xs : List α) :
    AModel.pull (X ++ Y) (X ++ Y) (blockSwap (X.length + i) (X.length + j) r) d xs =
      AModel.pull (X' ++ Y) (X' ++ Y) (blockSwap (X'.length + i) (X'.length + j) r) d xs := by
  have conv : ∀ Z : Shape, AModel.pull (Z ++ Y) (Z ++ Y) (blockSwap (Z.length + i) (Z.length + j) r) d xs
      = AModel.pull (Z ++ Y) (Z ++ Y) (fun a => a.take Z.length ++ blockSwap i j r (a.drop Z.length))
          d xs := by
    intro Z
    apply pull_congr
    intro a ha
    rw [blockSwap_shift (by rw [ha.length_eq]; simp)]
  rw [conv, conv]
  exact pull_prefix X X' Y hX _ d xs

end Prefix

