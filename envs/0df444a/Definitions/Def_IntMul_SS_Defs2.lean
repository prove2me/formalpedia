-- Source module: NLogNP.IEval
/-!
# A functional evaluator for item-language programs

`IOp.run` and `IStmt.run` compute the result state and cost of a program (with fuel for loops and
calls).  A successful evaluation gives an execution (`IStmt.run_exec`), so straight-line code can
be checked by `simp` evaluation instead of step-by-step reasoning.  Input and output operations
are not evaluated (`none`).
-/

namespace NLogN

open IntMul

variable {S P : ℕ}

/-- The exponent of a ruler. -/
def rulerExp (r : ℤ) : Option ℕ :=
  if r = 2 ^ (Nat.log2 r.toNat) then some (Nat.log2 r.toNat) else none

def IOp.run (s : IState S) : IOp S → Option (IState S × ℕ)
  | .add i j k =>
    match s.G i, s.G j with
    | .int a :: Li, .int b :: Lj =>
      if i = j then none else
        some ((((s.upd i Li).upd j Lj).upd k (.int (a + b) :: ((s.upd i Li).upd j Lj).G k)),
          addIntCost (zsz a + zsz b))
    | _, _ => none
  | .neg i =>
    match s.G i with
    | .int a :: L => some (s.upd i (.int (-a) :: L), 20)
    | _ => none
  | .dup i j =>
    match s.G i with
    | .int a :: _ => if i = j then none else some (s.upd j (.int a :: s.G j), dupCost (zsz a) + 17)
    | _ => none
  | .drop i =>
    match s.G i with
    | .int a :: L => some (s.upd i L, 2 * zsz a + 2)
    | _ => none
  | .mv i j =>
    match s.G i with
    | .int a :: L =>
      if i = j then none else some ((s.upd i L).upd j (.int a :: s.G j), 2 * moveCost (zsz a) + 19)
    | _ => none
  | .const i c => some (s.upd i (.int c :: s.G i), zsz c + 2)
  | .mark i => some (s.upd i (.mark :: s.G i), 1)
  | .unmark i =>
    match s.G i with
    | .mark :: L => some (s.upd i L, 1)
    | _ => none
  | .shl i j =>
    match s.G i, s.G j with
    | .int a :: Li, .int r :: _ =>
      match rulerExp r with
      | some m => if i = j then none else some (s.upd i (.int (a * 2 ^ m) :: Li), shlCost m)
      | none => none
    | _, _ => none
  | .split i j k =>
    match s.G i, s.G j with
    | .int a :: Li, .int r :: _ =>
      match rulerExp r with
      | some m =>
        if i = j ∨ i = k ∨ j = k then none else
          some ((s.upd i (.int (sg a (a.natAbs / 2 ^ m)) :: Li)).upd k
            (.int (sg a (a.natAbs % 2 ^ m)) :: s.G k), splitCost m + 17)
      | none => none
    | _, _ => none
  | .cat i j k =>
    match s.G i, s.G j, s.G k with
    | .int a :: Li, .int r :: _, .int b :: Lk =>
      match rulerExp r with
      | some m =>
        if i = j ∨ i = k ∨ j = k ∨ a = 0 ∨ b < 0 ∨ 2 ^ m ≤ b then none else
          some ((s.upd i (.int (sg a (a.natAbs * 2 ^ m + b.toNat)) :: Li)).upd k Lk, catCost m)
      | none => none
    | _, _, _ => none
  | .read _ _ _ => none
  | .write _ _ => none

/-- Evaluation with fuel (each loop iteration and call uses one unit). -/
def IStmt.run (iprog : Fin P → IStmt S P) : ℕ → IStmt S P → IState S → Option (IState S × ℕ)
  | _, .skip, s => some (s, 1)
  | _, .op o, s => o.run s
  | n, .seq p q, s =>
    match IStmt.run iprog n p s with
    | some (s₁, c₁) =>
      match IStmt.run iprog n q s₁ with
      | some (s₂, c₂) => some (s₂, c₁ + c₂)
      | none => none
    | none => none
  | n, .ite i f p q, s =>
    if f (s.cl i) then (IStmt.run iprog n p s).map (fun r => (r.1, r.2 + 25))
    else (IStmt.run iprog n q s).map (fun r => (r.1, r.2 + 25))
  | 0, .loop _ _ _, _ => none
  | n + 1, .loop i f p, s =>
    if f (s.cl i) then
      match IStmt.run iprog (n + 1) p s with
      | some (s₁, c₁) =>
        match IStmt.run iprog n (.loop i f p) s₁ with
        | some (s₂, c₂) => some (s₂, c₁ + c₂ + 30)
        | none => none
      | none => none
    else some (s, 30)
  | 0, .call _, _ => none
  | n + 1, .call j, s => (IStmt.run iprog n (iprog j) s).map (fun r => (r.1, r.2 + 2))

end NLogN

end

