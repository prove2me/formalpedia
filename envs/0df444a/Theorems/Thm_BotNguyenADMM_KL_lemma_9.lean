-- title:
--   Lemma 9 — D^{k+1} ∈ ∂F_r(x^{k+1}, z^{k+1}, y^{k+1}, x^k, y^k) with |||D^{k+1}||| ≤ C_8‖Δx‖ + C_9‖Δz‖ + C_10‖Δy‖
-- statement:
--   Suppose Assumption 1 holds and $\{(x^k,z^k,y^k)\}_{k\ge0}$ is generated by Algorithm 1 or Algorithm 2. For every $k\ge0$ the vector
--   $$D^{k+1}=\big(d_x^{k+1}+C_1(x^{k+1}-x^k),\ d_z^{k+1},\ d_y^{k+1}+2T_1AA^*(y^{k+1}-y^k),\ -C_1(x^{k+1}-x^k),\ -2T_1AA^*(y^{k+1}-y^k)\big),$$
--   built from $d^{k+1}$ of Lemma 8, belongs to the limiting subdifferential $\partial F_r(x^{k+1},z^{k+1},y^{k+1},x^k,y^k)$, and
--   $$|||D^{k+1}|||\le C_8\|x^{k+1}-x^k\|+C_9\|z^{k+1}-z^k\|+C_{10}\|y^{k+1}-y^k\|,$$
--   with $C_8=2C_1+C_5$, $C_9=C_6$, $C_{10}=C_7+4T_1\|A\|^2$.
--
--   This is the "relative error" condition of the KL convergence scheme for $F_r$.
--
--   **Formalization Note** $F_r$ lives on the 5-fold Euclidean (`WithLp 2`) product, whose norm is $|||\cdot|||$; with the sup norm the constants would differ.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, p. 17, Lemma 9, (58)–(60)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_BotNguyenADMM_KL_Setting
open NonconvexSplitting.Shared BotNguyenADMM.KL
open Filter Topology
open scoped RealInnerProductSpace

namespace BotNguyenADMM.KL

/-- Lemma 9 (p. 17). Under Assumption 1, for a sequence generated by Algorithm 1 or
Algorithm 2 and every `k ≥ 0`, the element `Dᵏ⁺¹` of (59) lies in the limiting subdifferential
`∂F_r(xᵏ⁺¹, zᵏ⁺¹, yᵏ⁺¹, xᵏ, yᵏ)` (58), and (60):
`|||Dᵏ⁺¹||| ≤ C₈‖xᵏ⁺¹ − xᵏ‖ + C₉‖zᵏ⁺¹ − zᵏ‖ + C₁₀‖yᵏ⁺¹ − yᵏ‖`. -/
theorem lemma_9 {n m : ℕ} (v : Variant) (P : Data n m) (hA : Assumption1 v P)
    (x : ℕ → E n) (z y : ℕ → E m) (hrun : IsRun v P x z y) (k : ℕ) :
    DVec v P x z y k ∈
        LimitingSubdiff (Fr v P) (pack5 (x (k + 1)) (z (k + 1)) (y (k + 1)) (x k) (y k)) ∧
    ‖DVec v P x z y k‖ ≤ C8 v P * ‖x (k + 1) - x k‖ + C9 P * ‖z (k + 1) - z k‖
      + C10 P * ‖y (k + 1) - y k‖ := by sorry

end BotNguyenADMM.KL
