set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

set_option maxHeartbeats 4000000 in
/-- **The block loop.** -/
theorem loopB2_runs_sol_aux {M : MulSpec} {pM : Fin Pp} (hM : MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {b pk φD B BH : ℕ} {φT : ℕ → ℕ} (hΦD : ∀ x y : ℤ, zsz x ≤ B → zsz y ≤ B → M.Φ x y ≤ φD)
    (hΦT : ∀ n, ∀ x y : ℤ, zsz x ≤ b * (2 * n) + 2 → zsz y ≤ b * (2 * n) + 2 → M.Φ x y ≤ φT n)
    (hb : 1 ≤ b) (P : ℕ) (s : IState HS) (G : Fin HS → List ℤ) (hG : GOK P pk b G)
    (tdi : TB (2 ^ pk) (G TDI)) (tgi : TB (2 ^ pk) (G TGI)) (tga : TB (2 ^ pk) (G TGA))
    (tdd : TB (2 ^ pk) (G TDD))
    (hBb : b + 4 ≤ B) (hBp : 2 * pk + 4 ≤ B) (hPB : P + 3 ≤ B) (dt : List ℤ) :
    ∀ (ds : List (ℕ × List ℤ × List ℤ)) (z : List GI) (r0 o du : List ℤ),
      (∀ d ∈ ds, 1 ≤ d.1 ∧ d.2.1.length = d.1 ∧ d.2.2.length = d.1 ∧ d.1 ≤ (G TDI).length ∧
        d.1 ≤ (G TGI).length ∧ d.1 ≤ (G TGA).length ∧ d.1 ≤ (G TDD).length ∧ TB (2 ^ pk) d.2.1 ∧
        TB (2 ^ pk) d.2.2 ∧ 2 * (2 * d.1) * 2 ^ (2 * pk) < 2 ^ (b - 1) ∧
        zsz ((2 * d.1 : ℕ) : ℤ) ≤ B ∧ (∀ v ∈ blkHdr2 d.1 b, zsz v ≤ BH)) →
      zsz (ds.length : ℤ) ≤ BH → sumN ds ≤ z.length → chunkOK P (2 ^ pk) (G TDI) (G TGI) (G TGA) (G TDD) ds z →
      IRuns I iprog (.loop BC isPos (blkI2 pM))
        (encK s (BF G (gflat z ++ r0) [] [] o (dsEnc2 b ds ++ dt) du [] [] [] [] []
          [(ds.length : ℤ)]))
        (encK s (BF G (gflat (z.drop (sumN ds)) ++ r0) [] [] (gflat (chunkB P (G TDI) (G TGI) (G TGA) (G TDD) ds z).reverse ++ o)
          dt ((dsEnc2 b ds).reverse ++ du) [] [] [] [] [] [0]))
        (cLoop2 pk b φD φT B BH ds)
  | [], z, r0, o, du, _, _, _, _ => by
    have h := IRuns.loopF (I := I) (iprog := iprog) (i := BC) (f := isPos) (p := blkI2 pM)
      (s := encK s (BF G (gflat z ++ r0) [] [] o (dsEnc2 b [] ++ dt) du [] [] [] [] [] [0]))
      (by rw [cl_encK (show BF G (gflat z ++ r0) [] [] o (dsEnc2 b [] ++ dt) du [] [] [] [] [] [0] BC
            = 0 :: [] from BF_bc), isPos_cls]; decide)
    refine h.mono' ?_ le_rfl
    simp [dsEnc2, sumN, chunkB]
  | (n, am, ap) :: ds, z, r0, o, du, hds, hlen, hsum, hok => by
    obtain ⟨hn1, ham, hap, hdi, hgi, hga, hdd, tam, tap, hbig, hBn, hBH⟩ :=
      hds (n, am, ap) (List.mem_cons_self ..)
    simp only at hn1 ham hap hdi hgi hga hdd tam tap hbig hBn hBH
    obtain ⟨hok1, hok2⟩ := hok
    simp only [sumN] at hsum
    have hzn : (z.take n).length = n := by simp; omega
    have hlen' : zsz (ds.length : ℤ) ≤ BH := le_trans (KIL.zsz_nat_le (by simp)) hlen
    have hc1 : zsz ((ds.length + 1 : ℕ) : ℤ) ≤ BH := by simpa using hlen
    have h1 := blkI2_runs (I := I) (iprog := iprog) hM hdom hΦD (hΦT n) hb hn1 hbig P s G hG
      am ap (z.take n) (gflat (z.drop n) ++ r0) o (dsEnc2 b ds ++ dt) du ds.length
      hzn ham hap hdi hgi hga hdd hok1 tdi tgi tga tdd tam tap hBb hBp hPB hBn hBH hc1
    have h2 := loopB2_runs_sol_aux hM hdom hΦD hΦT hb P s G hG tdi tgi tga tdd hBb hBp hPB dt ds (z.drop n) r0
      (gflat (blkG P (2 * n) (G TDI) (G TGI) (G TGA) (G TDD) am ap (z.take n)).reverse ++ o)
      ((blkHdr2 n b ++ am ++ ap).reverse ++ du)
      (fun d h => hds d (List.mem_cons_of_mem _ h)) hlen' (by simp; omega) hok2
    have e0 : BF G (gflat z ++ r0) [] [] o (dsEnc2 b ((n, am, ap) :: ds) ++ dt) du [] [] [] [] []
        [(((n, am, ap) :: ds).length : ℤ)] =
        BF G (gflat (z.take n) ++ (gflat (z.drop n) ++ r0)) [] [] o
          (blkHdr2 n b ++ (am ++ (ap ++ (dsEnc2 b ds ++ dt)))) du [] [] [] [] []
          [((ds.length + 1 : ℕ) : ℤ)] := by
      rw [← List.append_assoc, ← gflat_append, List.take_append_drop]
      simp [dsEnc2, encD2, List.append_assoc]
    have hf : isPos ((encK s (BF G (gflat (z.take n) ++ (gflat (z.drop n) ++ r0)) [] [] o
          (blkHdr2 n b ++ (am ++ (ap ++ (dsEnc2 b ds ++ dt)))) du [] [] [] [] []
          [((ds.length + 1 : ℕ) : ℤ)])).cl BC) = true := by
      rw [cl_encK BF_bc, isPos_cls]; simp only [decide_eq_true_eq]; omega
    rw [e0]
    refine (IRuns.loopT hf h1 h2).mono' ?_ ?_
    · congr 2
      · rw [List.drop_drop]; simp only [sumN]; try rw [Nat.add_comm]
      · simp [chunkB, gflat_append, List.reverse_append, List.append_assoc]
      · simp [dsEnc2, encD2, List.reverse_append, List.append_assoc]
    · simp only [cLoop2]; omega

end J6Seg.KR

end

theorem solution : type_of% @J6Seg.KR.loopB2_runs_sol_aux := @J6Seg.KR.loopB2_runs_sol_aux
