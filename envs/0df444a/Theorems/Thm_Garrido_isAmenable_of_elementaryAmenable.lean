-- title:
--   EG ⊆ AG (p. 11) — every elementary amenable group is amenable
-- statement:
--   Every elementary amenable group is amenable.
--
--   Elementary amenability is the published `Chou.ElementaryAmenable`: the smallest class of groups
--   containing all finite and all abelian groups and closed under isomorphism, subgroups,
--   quotients, extensions and directed unions of subgroups. Amenability is the mission's
--   `IsAmenable`.
--
--   This is the first of the two inclusions $EG \subseteq AG \subseteq NF$ that the source displays
--   on p. 11 without a theorem number. Only $EG \subseteq AG$ is asserted here; the second
--   inclusion is a separate statement and is not formalised in this mission.
-- source:
--   A. Garrido, "An introduction to amenable groups", lecture notes, Oxford Advanced Class in Algebra, Michaelmas 2013 (PDF, Feb 2015), p. 11, the unnumbered displayed inclusion EG ⊆ AG ⊆ NF in Section 4. The inclusion is displayed without a theorem number; the surrounding sentence speaks of "the class of groups EG generated by finite and amenable groups", where "abelian" is meant, as Theorem 4.3 on p. 12 states. Only the inclusion EG ⊆ AG is formalised here; https://web.archive.org/web/20260805000803/https://www.math.uni-duesseldorf.de/~garrido/amenable.pdf

import Mathlib
import Definitions.Def_Garrido_Amenability
import Definitions.Def_Chou_ElementaryAmenable
universe u

namespace Garrido

theorem isAmenable_of_elementaryAmenable {G : Type u} [Group G]
    (hG : Chou.ElementaryAmenable G) :
    IsAmenable G := by
  sorry

end Garrido
