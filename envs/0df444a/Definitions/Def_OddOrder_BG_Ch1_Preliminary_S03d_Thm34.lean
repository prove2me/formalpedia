        (Subgroup.mem_map_of_mem _ hn)
      exact Subtype.ext (by rw [hφval ψ n]; exact hcent)
    obtain ⟨hK'Z, -, hRirr, -, hKsp⟩ :=
      isSpecial_of_pprimeAction_trivialOnProper φ hKpgroup hHall.symm hψntriv hψ_proper
