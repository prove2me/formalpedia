open IntMul NLogN

theorem cR_zero (s t : ℕ) (hs : 0 < s) : cR s t 0 = 0 := by
  unfold cR; simp; omega

theorem cR_mono (s t : ℕ) {j k : ℕ} (h : j ≤ k) : cR s t j ≤ cR s t k := by
  unfold cR; apply Nat.div_le_div_right
  have := Nat.mul_le_mul_left (2 * t) h; omega

theorem cR_lt (s t l : ℕ) (hs : 0 < s) (hst : s ≤ t) (hl : l < s) : cR s t l < t := by
  unfold cR
  rw [Nat.div_lt_iff_lt_mul (by omega)]
  have h1 : 2 * t * l + 2 * t ≤ 2 * t * s := by
    have := Nat.mul_le_mul_left (2 * t) (show l + 1 ≤ s by omega); rw [Nat.mul_add] at this; omega
  have h2 : 2 * t * s = t * (2 * s) := by ring
  omega

theorem cR_succ_le (s t l : ℕ) (hs : 0 < s) : cR s t (l + 1) ≤ cR s t l + (t / s + 1) := by
  unfold cR
  have e : 2 * t * (l + 1) + s = (2 * t * l + s) + 2 * t := by ring
  rw [e]
  have h2 : 2 * t / (2 * s) = t / s := Nat.mul_div_mul_left t s (by omega)
  rw [← h2]
  generalize 2 * t * l + s = x; generalize 2 * t = y
  have hd : 0 < 2 * s := by omega
  have h3 := Nat.lt_mul_div_succ x hd
  have h4 := Nat.lt_mul_div_succ y hd
  have : (x + y) / (2 * s) < x / (2 * s) + y / (2 * s) + 2 := by
    rw [Nat.div_lt_iff_lt_mul hd]
    have e2 : (x / (2 * s) + y / (2 * s) + 2) * (2 * s) =
        2 * s * (x / (2 * s) + 1) + 2 * s * (y / (2 * s) + 1) := by ring
    rw [e2]; omega
  omega

theorem pre_cDel (s t : ℕ) (hs : 0 < s) : ∀ l, l < s → NLogN.Rsp.pre (cDel s t) (l + 1) = cR s t l
  | 0, h => by
    rw [pre_succ _ _ (by rw [cDel_length]; omega)]
    simp [NLogN.Rsp.pre, cDel, cR_zero s t hs]
  | l + 1, h => by
    rw [pre_succ _ _ (by rw [cDel_length]; omega), pre_cDel s t hs l (by omega)]
    simp only [cDel, List.getElem_map, List.getElem_range, Nat.add_sub_cancel]
    have := cR_mono s t (Nat.le_succ l); simp only [Nat.succ_eq_add_one] at *; omega

theorem pre_cDel_le (s t : ℕ) (hs : 0 < s) (hst : s ≤ t) : NLogN.Rsp.pre (cDel s t) s ≤ t := by
  obtain ⟨k, rfl⟩ : ∃ k, s = k + 1 := ⟨s - 1, by omega⟩
  rw [pre_cDel (k + 1) t hs k (by omega)]; exact (cR_lt _ _ _ hs hst (by omega)).le

theorem cDel_le (s t : ℕ) (hs : 0 < s) : ∀ d ∈ cDel s t, d ≤ t / s + 1 := by
  intro d hd
  simp only [cDel, List.mem_map, List.mem_range] at hd
  obtain ⟨k, _, rfl⟩ := hd
  cases k with
  | zero => simp
  | succ k => have := cR_succ_le s t k hs; simp; omega

theorem cTab_length (s : ℕ) : (cTab s).length = 1 := rfl

theorem cTab_rows (s : ℕ) : ∀ W ∈ cTab s, W.length = s := by simp [cTab]

theorem resL_C_getD (g : ℤ × ℤ → ℤ) (s t : ℕ) (v : List (ℤ × ℤ)) (hs : 0 < s) (hst : s ≤ t)
    (hv : v.length = t) (l : ℕ) (hl : l < s) :
    (resL 1 (cDel s t) (cTab s) (v.map g) 0 s).getD l 0 = g (v.getD (cR s t l) (0, 0)) := by
  unfold resL
  rw [bandF_getD _ _ _ _ _ l (by simp; exact hl)]
  have h0 : (List.replicate s (0 : ℤ)).getD l 0 = 0 := by simp [List.getD_eq_getElem?_getD]
  rw [h0, zero_add]
  have hc := cR_lt s t l hs hst hl
  simp only [cTab, List.length_singleton, Finset.sum_range_one, List.getD_cons_zero]
  rw [pre_cDel s t hs l hl, Nat.add_zero, cycL_getD _ _ _ _ (by simp [hv]; omega)]
  have hl' : (v.map g).length = t := by simp [hv]
  rw [hl']; simp only [Nat.zero_add, Nat.add_zero]; rw [Nat.mod_eq_of_lt hc]
  simp [List.getD_eq_getElem?_getD, hl, hv, hc]

theorem resL_C_fst (s t : ℕ) (v : List (ℤ × ℤ)) (hs : 0 < s) (hst : s ≤ t) (hv : v.length = t) :
    resL 1 (cDel s t) (cTab s) (v.map Prod.fst) 0 s = (cselL s t v).map Prod.fst := by
  apply List.ext_getElem (by simp [resL_length, cselL])
  intro l h1 h2
  rw [resL_length] at h1
  rw [← List.getD_eq_getElem _ 0, resL_C_getD Prod.fst s t v hs hst hv l h1]
  simp [cselL, h1]

theorem resL_C_snd (s t : ℕ) (v : List (ℤ × ℤ)) (hs : 0 < s) (hst : s ≤ t) (hv : v.length = t) :
    resL 1 (cDel s t) (cTab s) (v.map Prod.snd) 0 s = (cselL s t v).map Prod.snd := by
  apply List.ext_getElem (by simp [resL_length, cselL])
  intro l h1 h2
  rw [resL_length] at h1
  rw [← List.getD_eq_getElem _ 0, resL_C_getD Prod.snd s t v hs hst hv l h1]
  simp [cselL, h1]

theorem gresL_C (s t : ℕ) (v : List (ℤ × ℤ)) (hs : 0 < s) (hst : s ≤ t) (hv : v.length = t) :
    gresL 1 (cDel s t) (cTab s) v 0 s = cselL s t v := by
  rw [gresL, resL_C_fst s t v hs hst hv, resL_C_snd s t v hs hst hv, zip_fst_snd]

end NLogN.Rsp

end

