def gapCVPInstanceEquiv : GapCVPInstance ≃ RawGapCVPInstance where
  toFun I := ⟨I.dimension, I.basis, I.target, I.radius⟩
  invFun I :=
    { dimension := I.1
      basis := I.2.1
      target := I.2.2.1
      radius := I.2.2.2 }
  left_inv I := by cases I; rfl
  right_inv I := by rcases I with ⟨n, B, t, r⟩; rfl
