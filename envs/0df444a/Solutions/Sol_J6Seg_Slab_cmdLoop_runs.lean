section lane
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)}

theorem mvL (hL : LaneOK lin) (s : IState HS) (G : Fin HS → List ℤ) (inp tmp : List U)
    {i j : Fin HS} (hi : i ∈ skel) (hj : j ∈ skel) (hij : i ≠ j) {a : ℤ} {l : List ℤ}
    (hGi : G i = a :: l) :
    IRuns I iprog (.op (.mv i j)) (encK s (lin inp tmp G))
      (encK s (lin inp tmp (update (update G i l) j (a :: G j)))) (2 * moveCost (zsz a) + 19) := by
  have h := mvM (I := I) (iprog := iprog) s (lin inp tmp G) hij (a := a) (l := l)
    (by rw [hL.rd i hi]; exact hGi)
  refine h.mono' ?_ le_rfl
  rw [hL.up j hj, hL.up i hi, hL.rd j hj]

end lane

/-! ## One command -/

section cmd
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem skel_mem_C : rC ∈ skel := by decide
theorem skel_mem_CU : rCU ∈ skel := by decide
theorem skel_mem_OP : rOP ∈ skel := by decide
theorem skel_mem_ARG : rARG ∈ skel := by decide

variable {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)} {OkU : U → Prop}
  {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop} {g : ℤ → U → ℤ} {dr rd it bk : IStmt HS P}
  {cdr crd cit cbk : ℕ}

/-- **One command.** -/
theorem cmd_runs (H : UnitsOK (I := I) (iprog := iprog) lin OkU OkA KG g dr rd it bk cdr crd cit cbk)
    (s : IState HS) (G : Fin HS → List ℤ) (hK : ∀ C CU OP ARG ACC, KG (skS G C CU OP ARG ACC)) (hA : G lA = []) (hC : G lC = []) (hD : G lD = [])
    {m : ℕ} {LM : List ℤ} (hM : G rM = (m : ℤ) :: LM) {Ba : ℕ} (op a : ℤ) (hop : zsz op ≤ Ba)
    (hab : zsz a ≤ Ba) (C CU OP ARG ACC : List ℤ)
    (inp tmp : List U) (hlen : op ≠ 0 → m ≤ inp.length) (hok : ∀ u ∈ inp, OkU u)
    (ha : 0 < op → OkA a) :
    IRuns I iprog (cmdP dr rd it bk)
      (encK s (lin inp tmp (skS G (op :: a :: C) CU OP ARG ACC)))
      (encK s (lin (if op < 0 then inp.drop m else inp) tmp
        (skS G C (a :: op :: CU) OP ARG ((runC m g [(op, a)] inp).reverse ++ ACC))))
      (cmdC m Ba (cdr + crd + cit + cbk)) := by
  have hL := H.hL
  have h1 := mvL (I := I) (iprog := iprog) hL s (skS G (op :: a :: C) CU OP ARG ACC) inp tmp
    skel_mem_C skel_mem_OP (by decide) (skS_C _ _ _ _ _ _)
  rw [skS_OP, skS_upd_C, skS_upd_OP] at h1
  have h2 := mvL (I := I) (iprog := iprog) hL s (skS G (a :: C) CU (op :: OP) ARG ACC) inp tmp
    skel_mem_C skel_mem_ARG (by decide) (skS_C _ _ _ _ _ _)
  rw [skS_ARG, skS_upd_C, skS_upd_ARG] at h2
  have h3 := branch_runs H s G hK hA hC hD hM op a C CU OP ARG ACC inp tmp hlen hok ha
  have h4 := mvL (I := I) (iprog := iprog) hL s
    (skS G C CU (op :: OP) (a :: ARG) ((runC m g [(op, a)] inp).reverse ++ ACC))
    (if op < 0 then inp.drop m else inp) tmp skel_mem_OP skel_mem_CU (by decide)
    (skS_OP _ _ _ _ _ _)
  rw [skS_CU, skS_upd_OP, skS_upd_CU] at h4
  have h5 := mvL (I := I) (iprog := iprog) hL s
    (skS G C (op :: CU) OP (a :: ARG) ((runC m g [(op, a)] inp).reverse ++ ACC))
    (if op < 0 then inp.drop m else inp) tmp skel_mem_ARG skel_mem_CU (by decide)
    (skS_ARG _ _ _ _ _ _)
  rw [skS_CU, skS_upd_ARG, skS_upd_CU] at h5
  refine (h1.seq (h2.seq (h3.seq (h4.seq h5)))).mono ?_
  have e1 := moveCost_mono hop
  have e2 := moveCost_mono hab
  unfold cmdC
  omega

end cmd

/-! ## The command loop -/

theorem flatC_cons (c : ℤ × ℤ) (cs : List (ℤ × ℤ)) : flatC (c :: cs) = c.1 :: c.2 :: flatC cs := rfl
theorem flatC_append (a b : List (ℤ × ℤ)) : flatC (a ++ b) = flatC a ++ flatC b := by
  simp [flatC]

section loop
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)} {OkU : U → Prop}
  {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop} {g : ℤ → U → ℤ} {dr rd it bk : IStmt HS P}
  {cdr crd cit cbk : ℕ}

theorem nDrop_single (c : ℤ × ℤ) : nDrop [c] = if c.1 < 0 then 1 else 0 := by
  obtain ⟨o, b⟩ := c; simp [nDrop]

/-- **The command loop.** -/
theorem cmdLoop_runs_sol_aux (H : UnitsOK (I := I) (iprog := iprog) lin OkU OkA KG g dr rd it bk cdr crd cit cbk)
    (s : IState HS) (G : Fin HS → List ℤ) (hK : ∀ C CU OP ARG ACC, KG (skS G C CU OP ARG ACC)) (hA : G lA = []) (hC : G lC = []) (hD : G lD = [])
    {m : ℕ} {LM : List ℤ} (hM : G rM = (m : ℤ) :: LM) (cs : List (ℤ × ℤ)) {LN : List ℤ}
    (hN : G rNC = (cs.length : ℤ) :: LN) {Ba : ℕ} (hcs : CmdsOK OkA Ba cs) (n : ℕ)
    (hV : VC n cs 0) (RC CU OP ARG ACC : List ℤ) (inp tmp : List U) (hlen : n * m ≤ inp.length)
    (hok : ∀ u ∈ inp, OkU u) :
    IRuns I iprog (cmdLoop dr rd it bk)
      (encK s (lin inp tmp (skS G (flatC cs ++ RC) CU OP ARG ACC)))
      (encK s (lin (inp.drop (nDrop cs * m)) tmp
        (skS G RC ((flatC cs).reverse ++ CU) OP ARG ((runC m g cs inp).reverse ++ ACC))))
      ((cs.length + 1) * (cmdC m Ba (cdr + crd + cit + cbk) + 3000)) := by
  have hL := H.hL
  have Hl := laneLoopX (I := I) (iprog := iprog) hL (X := rNC) (by decide) (by decide)
    (cmdP dr rd it bk) (cmdC m Ba (cdr + crd + cit + cbk)) cs.length s
    (fun k => inp.drop (nDrop (cs.take k) * m)) (fun _ => tmp)
    (fun k => skS G (flatC (cs.drop k) ++ RC) ((flatC (cs.take k)).reverse ++ CU) OP ARG
      ((runC m g (cs.take k) inp).reverse ++ ACC))
    (fun k => by simp [hA]) (fun k => by simp [hC]) (fun k => by simp [hD]) (LM := LN) (by simp [hN]) ?_
  · unfold cmdLoop; simpa [nDrop, runC] using Hl
  · intro k hk s'
    have e : cs.drop k = cs[k] :: cs.drop (k + 1) := List.drop_eq_getElem_cons hk
    have et : cs.take (k + 1) = cs.take k ++ [cs[k]] := List.take_succ_eq_append_getElem hk
    have hc := hcs cs[k] (List.getElem_mem hk)
    have hlen' : cs[k].1 ≠ 0 → m ≤ (inp.drop (nDrop (cs.take k) * m)).length := by
      intro h0
      have h1 := VC_get n cs 0 k hV hk h0
      rw [List.length_drop]
      have h2 : (nDrop (cs.take k) + 1) * m ≤ n * m := Nat.mul_le_mul_right _ (by omega)
      rw [Nat.add_mul, one_mul] at h2
      omega
    have h := cmd_runs (I := I) (iprog := iprog) H s' G hK hA hC hD hM cs[k].1 cs[k].2 hc.1 hc.2.1
      (flatC (cs.drop (k + 1)) ++ RC) ((flatC (cs.take k)).reverse ++ CU) OP ARG
      ((runC m g (cs.take k) inp).reverse ++ ACC) (inp.drop (nDrop (cs.take k) * m)) tmp hlen'
      (fun u hu => hok u (List.mem_of_mem_drop hu)) hc.2.2
    rw [e, flatC_cons, List.cons_append, List.cons_append]
    refine h.mono' ?_ le_rfl
    have ea : (if cs[k].1 < 0 then (inp.drop (nDrop (cs.take k) * m)).drop m
        else inp.drop (nDrop (cs.take k) * m)) = inp.drop (nDrop (cs.take (k + 1)) * m) := by
      rw [et, nDrop_append, nDrop_single]
      by_cases hc0 : cs[k].1 < 0
      · rw [if_pos hc0, if_pos hc0, List.drop_drop]; congr 1; ring
      · rw [if_neg hc0, if_neg hc0, Nat.add_zero]
    have eb : cs[k].2 :: cs[k].1 :: ((flatC (cs.take k)).reverse ++ CU) =
        (flatC (cs.take (k + 1))).reverse ++ CU := by
      rw [et, flatC_append, flatC_cons, flatC_nil, List.reverse_append]; simp
    have ec : (runC m g [(cs[k].1, cs[k].2)] (inp.drop (nDrop (cs.take k) * m))).reverse ++
        ((runC m g (cs.take k) inp).reverse ++ ACC) = (runC m g (cs.take (k + 1)) inp).reverse ++ ACC := by
      rw [et, runC_append, List.reverse_append, List.append_assoc]
    rw [ea, eb, ec]

end loop

end J6Seg.Slab

end

theorem solution.{u_1} : type_of% @J6Seg.Slab.cmdLoop_runs_sol_aux.{u_1} := @J6Seg.Slab.cmdLoop_runs_sol_aux.{u_1}
