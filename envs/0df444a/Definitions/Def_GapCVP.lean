          congr 1
          ac_rfl
      _ = clause.val * (grid * field) + localRank / degree :=
        Nat.mul_add_div degreePositive
          (clause.val * (grid * field)) localRank
  rw [quotient]
  simp [Nat.add_mod, Nat.mod_eq_of_lt quotientBound]
