theorem exists_ν : ∃ (ν : (w S B u i j incL).A ⟶ (v₁ S B u j l).A)
    (_ : ν ≫ gA₁ S B u j l = gw S B u i j incL ≫ (e S r B u hover i j).hom ≫ gA₂ S B u i j)
    (hc : IsPullback ν (w S B u i j incL).f (v₁ S B u j l).f (Spec.map (CommRingCat.ofHom τj))),
    (∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of D)) (x y : SchemeHomOver t' (w S B u i j incL).f),
      ((w S B u i j incL).L.mul t' x y).1 ≫ ν =
        ((v₁ S B u j l).L.mul (t' ≫ Spec.map (CommRingCat.ofHom τj))
          ⟨x.1 ≫ ν, by rw [Category.assoc, hc.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ ν, by rw [Category.assoc, hc.w, ← Category.assoc, y.2]⟩).1) ∧
    (∀ m, ((w S B u i j incL).P m).1 ≫ ν = Spec.map (CommRingCat.ofHom τj) ≫ ((v₁ S B u j l).P m).1) ∧
    LocIsoOnBase (w S B u i j incL).f ((Scheme.Modules.pullback ν).obj (v₁ S B u j l).pol) (w S B u i j incL).pol := by
  obtain ⟨hpb₁, hmul₁, hP₁, hpol₁⟩ := (hv₁ S B u j l).choose_spec
  obtain ⟨hpb₂, hmul₂, hP₂, hpol₂⟩ := (hv₂ S B u i j).choose_spec
  obtain ⟨hpb₃, hmul₃, hP₃, hpol₃⟩ := (hw S B u i j incL).choose_spec
  obtain ⟨he, hemul, helev, hepol⟩ := (iso_v S r B u hover i j).choose_spec

  have b₁ := comp_isPullback (gA₂ S B u i j) hpb₂ (e S r B u hover i j) he
  have b₂ : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B i j))) (x y : SchemeHomOver t' (v₁ S B u i j).f), _ :=
    fun t' x y => comp_mul (gA₂ S B u i j) hpb₂ hmul₂ (e S r B u hover i j) he hemul t' x y
  have b₃ := comp_P (gA := gA₂ S B u i j) (hP := hP₂) (e := e S r B u hover i j) (helev := helev)
  have b₄ : LocIsoOnBase (v₁ S B u i j).f ((Scheme.Modules.pullback ((e S r B u hover i j).hom ≫ gA₂ S B u i j)).obj (u j).pol)
      (v₁ S B u i j).pol := comp_pol (gA₂ S B u i j) hpol₂ (e S r B u hover i j) hepol

  have a₁ := compg_isPullback ((e S r B u hover i j).hom ≫ gA₂ S B u i j) b₁ (gw S B u i j incL) hpb₃
  have a₂ : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of D)) (x y : SchemeHomOver t' (w S B u i j incL).f), _ :=
    fun t' x y => compg_mul ((e S r B u hover i j).hom ≫ gA₂ S B u i j) b₁ b₂ (gw S B u i j incL) hpb₃ hmul₃ t' x y
  have a₃ := compg_P (gA := (e S r B u hover i j).hom ≫ gA₂ S B u i j) (hP := b₃) (c := gw S B u i j incL) (hcP := hP₃)
  have a₄ := pol_local_comp ((e S r B u hover i j).hom ≫ gA₂ S B u i j) (gw S B u i j incL) hpb₃.w b₄
    (locIsoOnBase_of_iso _ hpol₃.some)
  obtain ⟨c₁, c₂, c₃⟩ := clauses_congr (gw S B u i j incL ≫ (e S r B u hover i j).hom ≫ gA₂ S B u i j) hτj₁ a₁ a₂ a₃
  exact AlgebraicGeometry.PolarisedAbelianScheme.exists_hom_comp_eq_isPullback_of_comp_of_locally (ρ₁ S B j l).toRingHom τj
    (u j) (v₁ S B u j l) (w S B u i j incL) (gA₁ S B u j l) hpb₁ hmul₁ hP₁ hpol₁ _ c₁ c₂ c₃ a₄

