    (hact₀₂ : ∀ j (y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))), ((galFC₂ j σ₀₂ • y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))) : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) = (w₂ j) • (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)))
    (hact₁₂ : ∀ j (y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))), ((galFC₂ j σ₁₂ • y : ↥(Mumford.invariantFieldOf A.valuation.Completion (ℍ[ℚ, ad, bd])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j))) : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) = (wbar₂ j) • (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂))),
    ∃ (E V : HeckeTower.Obj q q' → Type) (_ : ∀ j, Fintype (E j)) (_ : ∀ j, Fintype (V j))
      (_ : ∀ j, DecidableEq (E j)) (_ : ∀ j, DecidableEq (V j))

      (D : ∀ j : HeckeTower.Obj q q', DegeneracyData (E j) (V j))
