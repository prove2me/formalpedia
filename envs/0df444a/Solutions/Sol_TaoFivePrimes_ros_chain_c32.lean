theorem child32_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu142.lin : ℝ) ≤ (S : ℝ) * logProd gu142.lo) :
    (gu145.lfin : ℝ) ≤ (S : ℝ) * logProd gu145.top ∧
      (∀ x : ℝ, (gu142.lo : ℝ) < x → x ≤ (gu145.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u142 hγ hstate
  have s1 := sol_u143 hγ (by simpa [gu142, gu143] using s0.1)
  have s2 := sol_u144 hγ (by simpa [gu143, gu144] using s1.1)
  have s3 := sol_u145 hγ (by simpa [gu144, gu145] using s2.1)
  refine ⟨s3.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu142.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu143.lo : ℝ) < x := by
        have hb : (gu142.top : ℝ) = (gu143.lo : ℝ) := by simp [gu142, gu143]
        linarith
    by_cases h1 : x ≤ (gu143.top : ℝ)
    · exact s1.2 x hx1 h1
    · have hx2 : (gu144.lo : ℝ) < x := by
          have hb : (gu143.top : ℝ) = (gu144.lo : ℝ) := by simp [gu143, gu144]
          linarith
      by_cases h2 : x ≤ (gu144.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu145.lo : ℝ) < x := by
            have hb : (gu144.top : ℝ) = (gu145.lo : ℝ) := by simp [gu144, gu145]
            linarith
        exact s3.2 x hx3 htop

