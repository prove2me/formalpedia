section ax
variable {σ : Fin 19 → Fin HS} {dS dA : Fin HS} (hW : SwOK σ dS dA)
include hW

theorem axP2_sp_sol_aux (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D B k : ℕ) (hk : k ≤ D)
    (hb : SwB P n src D B) (s : IState HS) (F : Fin HS → List ℤ) (z ds c17 : List ℤ) :
    Sp (axP2 σ) (encK s (SS σ dS F z ds (wK P n src D k c17)))
      (encK s (SS σ dS F z ds (update (vK P n src D (k + 1)) 17 c17))) (cP2 B) := by
  have zle : ∀ x : ℕ, x ≤ B → zsz (x : ℤ) ≤ B := fun x hx =>
    le_trans (zsz_natCast_le_self x) hx
  obtain ⟨hpre, ht, hpost, hpt⟩ := le_TW_pre P n D k hk
  set b := (bsW P n D)[k]! with hbdef
  have hb01 : b = 0 ∨ b = 1 := by rw [hbdef, bit_eq P n D k hk]; split_ifs <;> simp
  have hbz : zsz b ≤ B := zsz_le_one hb01 (by linarith [hb.two])
  set w := wK P n src D k c17 with hw
  have S1 := popR_sp hW s F z ds w B 9 b [] (by rw [hw]; unfold wK; rw [← hbdef]; simp) hbz
  have S2 := popR_sp hW s F z ds (update w 9 []) B 10 (src k : ℤ) []
    (by rw [hw]; simp [wK, update_apply]) (hb.s k hk)
  have S3 := popR_sp hW s F z ds (update (update w 9 []) 10 []) B 7 (postT P n D k : ℤ) []
    (by rw [hw]; simp [wK, update_apply]) (zle_of hb.T hpost)
  set u3 := update (update (update w 9 []) 10 []) 7 [] with hu3
  have h6 : SS σ dS F z ds u3 (σ 6) = [(preT P n D k : ℤ)] := by
    rw [SS_at hW, hu3, hw]; simp [wK, vK, update_apply]
  have h11 : SS σ dS F z ds u3 (σ 11) = [(tF6 P n k : ℤ)] := by
    rw [SS_at hW, hu3, hw]; simp [wK, update_apply]
  have ept : (Ex.mul (.reg (σ 6)) (.reg (σ 11))).eval (encK s (SS σ dS F z ds u3)) =
      (preT P n D (k + 1) : ℤ) := by
    simp only [Ex.eval, eval_reg h6, top_encK h6, eval_reg h11, top_encK h11]; rw [preT_succ P n D k hk]; push_cast; ring
  have S4 := asgQ_sp hW s F z ds u3 B 6 (preT P n D k : ℤ)
    (by rw [hu3, hw]; simp [wK, vK, update_apply]) (zle_of hb.T hpre)
    (.mul (.reg (σ 6)) (.reg (σ 11))) (preT P n D (k + 1) : ℤ)
    (clean_mul (clean_reg (hW.lt 6)) (clean_reg (hW.lt 11))) ⟨ok_reg h6, ok_reg h11⟩
    ⟨bnd_reg h6 (zle_of hb.T hpre), bnd_reg h11 (zle_of hb.T ht), by
      simp only [Ex.eval, eval_reg h6, top_encK h6, eval_reg h11, top_encK h11]
      rw [show (preT P n D k : ℤ) * (tF6 P n k : ℤ) = ((preT P n D k * tF6 P n k : ℕ) : ℤ) by
        push_cast; ring]
      exact zle_of hb.T hpt⟩ ept
  set u4 := update u3 6 [(preT P n D (k + 1) : ℤ)] with hu4
  have S5 := popR_sp hW s F z ds u4 B 11 (tF6 P n k : ℤ) []
    (by rw [hu4, hu3, hw]; simp [wK, update_apply]) (zle_of hb.T ht)
  set u5 := update u4 11 [] with hu5
  have h8 : SS σ dS F z ds u5 (σ 8) = [(k : ℤ)] := by
    rw [SS_at hW, hu5, hu4, hu3, hw]; simp [wK, vK, update_apply]
  have hkB : k + 1 ≤ B := by have := hb.hB; nlinarith
  have S6 := asgQ_sp hW s F z ds u5 B 8 (k : ℤ)
    (by rw [hu5, hu4, hu3, hw]; simp [wK, vK, update_apply]) (zle k (by omega))
    (.add (.reg (σ 8)) (.lit 1)) ((k + 1 : ℕ) : ℤ) (clean_add (clean_reg (hW.lt 8)) (clean_lit 1))
    ⟨ok_reg h8, trivial⟩
    ⟨bnd_reg h8 (zle k (by omega)), zle 1 (by omega), by
      simp only [Ex.eval, eval_reg h8, top_encK h8]
      exact_mod_cast zle (k + 1) hkB⟩
    (by simp only [Ex.eval, eval_reg h8, top_encK h8]; push_cast; ring)
  have ev : update u5 8 [((k + 1 : ℕ) : ℤ)] = update (vK P n src D (k + 1)) 17 c17 := by
    rw [hu5, hu4, hu3, hw]
    unfold wK vK
    rw [take_succ_bs P n D k hk, take_succ_sv src D k hk]
    unfold vH
    ((funext i; fin_cases i <;> simp [Function.update_apply]))
  rw [ev] at S6
  refine (S1.seq (S2.seq (S3.seq (S4.seq (S5.seq S6))))).mono ?_
  simp only [Ex.size, cP2]
  nlinarith

end ax

