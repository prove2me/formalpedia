variable {I : Set ℝ} {f m N w p a : ℝ → ℝ}
theorem solution {y : Pt 5} (hf : f (y 1) ≠ 0) (hm : m (y 1) ≠ 0)
    (hN : N (y 1) ≠ 0) (he : eFun w p a (y 1) ≠ 0) {t lam : ℝ} (ht : t ≠ 0) (hl : lam ≠ 0)
    {v : Fin 5 → ℝ} (hv : v = t • principalCoord f m N w p a lam y) :
    f (y 1) * v 0 / eFun w p a (y 1) = t ∧ v 1 ≠ 0 ∧
      (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ v) 0 =
        -(t * deriv p (y 1)) ∧
      (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ v) 3 =
        -(t * (y 2 * deriv a (y 1))) ∧
      (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ v) 4 =
        -(t * ((1 - y 2) * deriv a (y 1))) := by
  have hlow := principal_lower (w := w) (p := p) (a := a) hf hm hN lam
  subst hv
  rw [Matrix.mulVec_smul, hlow]
  have h0 : (t • principalCoord f m N w p a lam y) 0 = t * (eFun w p a (y 1) / f (y 1)) := by
    rw [principalCoord_eq]; rfl
  have h1 : (t • principalCoord f m N w p a lam y) 1 = t * lam := by rw [principalCoord_eq]; rfl
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [h0]; field_simp
  · rw [h1]; exact mul_ne_zero ht hl
  · simp
  · simp
  · simp
