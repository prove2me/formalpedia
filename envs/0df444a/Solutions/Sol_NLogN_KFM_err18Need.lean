theorem e18_relabel {D : ℕ} [NeZero D] {a : Fin D → ℕ} {A B : List ℕ} (hA : SlotArr D a A)
    (hB : SlotArr D a B) {v : List ℕ} (hv : Valid (binSh B.length) v) :
    relabel A B v = addrS D A (coordS D a B v) := by
  unfold relabel addrS
