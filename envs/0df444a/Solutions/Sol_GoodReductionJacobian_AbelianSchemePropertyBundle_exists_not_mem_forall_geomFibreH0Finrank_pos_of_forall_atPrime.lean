theorem nonempty_orderedAffineCover (X : Scheme.{u}) [CompactSpace X] : Nonempty X.OrderedAffineCover := by
  classical
  let 𝒱 := X.affineCover.finiteSubcover
  letI : LinearOrder 𝒱.I₀ := LinearOrder.lift' (Fintype.equivFin 𝒱.I₀) (Fintype.equivFin 𝒱.I₀).injective
  exact ⟨Scheme.OrderedAffineCover.mk (ι := 𝒱.I₀) (U := fun j => (𝒱.f j).opensRange)
    (isAffineOpen := fun j => isAffineOpen_opensRange (𝒱.f j)) (iSup_eq_top := 𝒱.iSup_opensRange)⟩

theorem specMap_comp_eq (S κ k : Type u) [CommRing S] [CommRing κ] [CommRing k] [Algebra S κ] [Algebra κ k]
    [Algebra S k] [IsScalarTower S κ k] :
    Scheme.TwoAffineOpenCover.specMap κ k ≫ Scheme.TwoAffineOpenCover.specMap S κ = Scheme.TwoAffineOpenCover.specMap S k := by
  simp only [Scheme.TwoAffineOpenCover.specMap, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]

theorem isEmpty_idx {V : Scheme.{u}} (K : V.OrderedAffineCover) {i : ℕ} (hi : Fintype.card K.ι < i + 1) :
    IsEmpty (K.Idx i) := by
  refine ⟨fun s => ?_⟩
  have := Fintype.card_le_of_injective s.1 s.2.injective
  simp only [Fintype.card_fin] at this
  omega

theorem subsingleton_HSucc_of_card_le {R : Type u} [CommRing R] {V : Scheme.{u}} {π : V ⟶ Spec (.of R)}
    (F : OModulePresheaf π) (K : V.OrderedAffineCover) {i : ℕ} (hi : Fintype.card K.ι ≤ i + 1) :
    Subsingleton (F.HSucc K i) := by
  haveI : IsEmpty (K.Idx (i + 1)) := isEmpty_idx K (by omega)
  haveI : Subsingleton (F.cochain K (i + 1)) := inferInstance
  haveI : Subsingleton (LinearMap.ker (F.d K (i + 1))) := inferInstance
  exact Quot.Subsingleton

theorem cechFinrank_congr {R : Type u} [CommRing R] {V : Scheme.{u}} {π π' : V ⟶ Spec (.of R)} (hπ : π = π')
    {N N' : V.Modules} (e : N ≅ N') (K : V.OrderedAffineCover) (n : ℕ) :
    (OModulePresheaf.ofModules π N).cechFinrank K n = (OModulePresheaf.ofModules π' N').cechFinrank K n := by
  subst hπ
  obtain ⟨⟨e0⟩, hS, -⟩ := OModulePresheaf.nonempty_cechEquiv_ofModules_of_iso π e K
  cases n with
  | zero => rw [OModulePresheaf.cechFinrank_zero, OModulePresheaf.cechFinrank_zero]; exact e0.finrank_eq
  | succ i => rw [OModulePresheaf.cechFinrank_succ, OModulePresheaf.cechFinrank_succ]; exact (hS i).some.finrank_eq

theorem cechFinrank_iter {S : Type u} [CommRing S] {A : Scheme.{u}} (f : A ⟶ Spec (.of S)) [IsSeparated f]
    (κ k : Type u) [Field κ] [Field k] [Algebra S κ] [Algebra κ k]
    (ι : Spec (.of k) ⟶ Spec (.of S)) (hι : Scheme.TwoAffineOpenCover.specMap κ k ≫ Scheme.TwoAffineOpenCover.specMap S κ = ι)
    (𝓛 : A.Modules) (h𝓛 : Scheme.Modules.IsInvertible 𝓛)
    (𝔚 : (pullback (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S κ))
      (Scheme.TwoAffineOpenCover.specMap κ k)).OrderedAffineCover)
    (𝔚' : (pullback f ι).OrderedAffineCover) (n : ℕ) :
    (OModulePresheaf.ofModules
        (pullback.snd (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S κ)) (Scheme.TwoAffineOpenCover.specMap κ k))
        ((Scheme.Modules.pullback
          (pullback.fst (pullback.snd f (Scheme.TwoAffineOpenCover.specMap S κ)) (Scheme.TwoAffineOpenCover.specMap κ k))).obj
          ((Scheme.Modules.pullback (pullback.fst f (Scheme.TwoAffineOpenCover.specMap S κ))).obj 𝓛))).cechFinrank 𝔚 n =
      (OModulePresheaf.ofModules (pullback.snd f ι)
        ((Scheme.Modules.pullback (pullback.fst f ι)).obj 𝓛)).cechFinrank 𝔚' n := by
  subst hι
  let Φ := pullbackLeftPullbackSndIso f (Scheme.TwoAffineOpenCover.specMap S κ) (Scheme.TwoAffineOpenCover.specMap κ k)
  have hΦfst : Φ.hom ≫ pullback.fst f _ = pullback.fst _ _ ≫ pullback.fst f (Scheme.TwoAffineOpenCover.specMap S κ) :=
    pullbackLeftPullbackSndIso_hom_fst _ _ _
  have hΦsnd : Φ.hom ≫ pullback.snd f _ = pullback.snd _ _ := pullbackLeftPullbackSndIso_hom_snd _ _ _
  rw [← OModulePresheaf.cechFinrank_ofModules_pullback_eq_of_isIso (pullback.snd f _)
    Φ.hom ((Scheme.Modules.pullback (pullback.fst f _)).obj 𝓛) (h𝓛.pullback _) 𝔚 𝔚' n]
  refine cechFinrank_congr hΦsnd.symm ?_ 𝔚 n
  exact ((Scheme.Modules.pullbackComp _ _).app 𝓛) ≪≫ (Scheme.Modules.pullbackCongr hΦfst.symm).app 𝓛 ≪≫
    ((Scheme.Modules.pullbackComp Φ.hom _).app 𝓛).symm

theorem finite_setOf_comp_eq_id {k : Type u} [Field k] {Y : Scheme.{u}} (π : Y ⟶ Spec (CommRingCat.of k))
    [IsFinite π] : {κ : Spec (CommRingCat.of k) ⟶ Y | κ ≫ π = 𝟙 _}.Finite := by
  haveI : IsAffine Y := isAffine_of_isAffineHom π
  have hfin : π.appTop.hom.Finite := π.finite_appTop

  let ρ : k →+* Γ(Y, ⊤) := π.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom
  letI : Algebra k Γ(Y, ⊤) := ρ.toAlgebra
  have hρ : ρ.Finite := by
    refine RingHom.Finite.comp hfin ?_
    exact RingHom.Finite.of_surjective _ (fun y => ⟨(Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom y, by
      have h := congrArg (fun φ => φ.hom y) (Scheme.ΓSpecIso (CommRingCat.of k)).hom_inv_id
      simpa only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.coe_comp, Function.comp_apply, RingHom.id_apply] using h⟩)
  haveI : Module.Finite k Γ(Y, ⊤) := hρ

  have key : ∀ κ : {κ : Spec (CommRingCat.of k) ⟶ Y | κ ≫ π = 𝟙 _}, ∀ z : Γ(Spec (CommRingCat.of k), ⊤),
      κ.1.appTop.hom (π.appTop.hom z) = z := by
    intro κ z
    have h1 : (κ.1 ≫ π).appTop = Scheme.Hom.appTop (𝟙 (Spec (CommRingCat.of k))) := by rw [κ.2]
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.id_appTop] at h1
    have h2 := congrArg (fun φ => φ.hom z) h1
    simpa using h2
  have hinv : ∀ c : k, (Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom ((Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom c) = c :=
    fun c => by
      have h := congrArg (fun φ => φ.hom c) (Scheme.ΓSpecIso (CommRingCat.of k)).inv_hom_id
      simpa only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.coe_comp, Function.comp_apply, RingHom.id_apply] using h
  have hinv' : ∀ z, (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom ((Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom z) = z :=
    fun z => by
      have h := congrArg (fun φ => φ.hom z) (Scheme.ΓSpecIso (CommRingCat.of k)).hom_inv_id
      simpa only [CommRingCat.hom_comp, CommRingCat.hom_id, RingHom.coe_comp, Function.comp_apply, RingHom.id_apply] using h
  let Φ : {κ : Spec (CommRingCat.of k) ⟶ Y | κ ≫ π = 𝟙 _} → (Γ(Y, ⊤) →ₐ[k] k) := fun κ =>
    { toRingHom := (Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom.comp κ.1.appTop.hom
      commutes' := fun c => by
        show (Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom (κ.1.appTop.hom (ρ c)) = c
        show (Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom (κ.1.appTop.hom
          (π.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom c))) = c
        rw [key κ, hinv] }
  have hΦ : Function.Injective Φ := by
    intro κ₁ κ₂ h
    have h1 : ∀ y, (Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom (κ₁.1.appTop.hom y) =
        (Scheme.ΓSpecIso (CommRingCat.of k)).hom.hom (κ₂.1.appTop.hom y) := fun y => congrArg (fun ψ => ψ y) h
    have h2 : κ₁.1.appTop = κ₂.1.appTop := by
      ext y
      have h3 := congrArg (fun w => (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom w) (h1 y)
      simp only [hinv'] at h3
      exact h3
    apply Subtype.ext
    have h5 := Scheme.toSpecΓ_naturality κ₁.1
    have h6 := Scheme.toSpecΓ_naturality κ₂.1
    rw [h2] at h5
    rw [← h6] at h5
    exact (cancel_mono Y.toSpecΓ).mp h5
  haveI : Finite {κ : Spec (CommRingCat.of k) ⟶ Y | κ ≫ π = 𝟙 _} := Finite.of_injective Φ hΦ
  exact Set.toFinite _

