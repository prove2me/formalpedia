-- title:
--   Joint independence of Poisson count evaluation σ-algebras on successive disjoint time strips
-- statement:
--   For every monotone finite grid, the family of σ-algebras generated by all count evaluations Nω(C), C a measurable subset of the separate time strip (t_i,t_{i+1}]×B, is jointly independent. This strengthens the already proved two-region σ-algebra independence to a finite family, using the PoissonRandomMeasure.independent_disjoint field and a finite partition/π-system argument. Pairwise independence alone is not enough.
-- source:
--   Kyprianou (2006), Eq. (2.3), independent increments of the finite-activity marked Poisson integral; supporting sigma-independence from LevyStochCalc/Poisson/RegionIndependence.lean.

import Mathlib
import Definitions.Def_KLSModular_LevyStochCalc_Poisson_RandomMeasure
import Definitions.Def_LeanLevy_Processes_LevyProcess
open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal
set_option autoImplicit false

theorem Kyprianou.Ch02.prmFiniteRegionStripEvalSigmaJointIndependentV1
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ν : Measure ℝ) [SigmaFinite ν]
    (N : LevyStochCalc.Poisson.PoissonRandomMeasure.{0, 0, 0} P ν)
    (B : Set ℝ) (hB : MeasurableSet B) (hfinite : ν B < ⊤) :
    ∀ (n : ℕ) (t : Fin (n + 1) → ℝ≥0) (ht : Monotone t),
      iIndep (fun (i : Fin n) =>
        (⨆ C ∈ {C : Set (ℝ × ℝ) | C ⊆ (Set.Ioc (t i.castSucc : ℝ) (t i.succ : ℝ) ×ˢ B) ∧ MeasurableSet C},
          MeasurableSpace.comap (fun ω => N.N ω C) inferInstance)) P := by sorry
