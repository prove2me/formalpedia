    have : -1 ≤ (r - s : ℝ) / d := by rw [le_div_iff₀ hdR]; linarith
    linarith

lemma point (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime) (m : ℕ) (hm : Odd m) (n : ℕ) :
    ∑ t ∈ TS S m, (-1:ℝ) ^ t.card * (if (∏ p ∈ t, p) ∣ n then 1 else 0)
      ≤ if (∀ p ∈ S, ¬ p ∣ n) then 1 else 0 := by
  classical
  have hset : (TS S m).filter (fun t => (∏ p ∈ t, p) ∣ n) = TS (S.filter (· ∣ n)) m := by
    ext t
    simp only [TS, Finset.mem_filter, Finset.mem_powerset]
    constructor
    · rintro ⟨⟨hts, hc⟩, hd⟩
      refine ⟨fun p hp => Finset.mem_filter.mpr ⟨hts hp, ?_⟩, hc⟩
      exact (Finset.dvd_prod_of_mem _ hp).trans hd
    · rintro ⟨hts, hc⟩
      refine ⟨⟨fun p hp => (Finset.mem_filter.mp (hts hp)).1, hc⟩, ?_⟩
      exact Finset.prod_primes_dvd n (fun p hp => (hS p (Finset.mem_filter.mp (hts hp)).1).prime)
        (fun p hp => (Finset.mem_filter.mp (hts hp)).2)
  simp_rw [mul_ite, mul_one, mul_zero]
  rw [← Finset.sum_filter, hset]
  have hb := bonf_le (S.filter (· ∣ n)) m hm
  have hcast : ∑ t ∈ TS (S.filter (· ∣ n)) m, (-1:ℝ) ^ t.card
      = ((∑ t ∈ TS (S.filter (· ∣ n)) m, (-1:ℤ) ^ t.card : ℤ) : ℝ) := by push_cast; rfl
  rw [hcast]
  have hiff : (S.filter (· ∣ n) = ∅) ↔ (∀ p ∈ S, ¬ p ∣ n) := Finset.filter_eq_empty_iff
  by_cases h : ∀ p ∈ S, ¬ p ∣ n
  · rw [if_pos (hiff.mpr h)] at hb; rw [if_pos h]; exact_mod_cast hb
  · rw [if_neg (fun e => h (hiff.mp e))] at hb; rw [if_neg h]; exact_mod_cast hb

