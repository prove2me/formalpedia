namespace NLogN

open IntMul

variable {S P : ℕ}

/-! ## Compilation -/

variable {I : List Sym} {prog : Fin P → Stmt (S + 4) P}

theorem St.pop_push_top (σ : St S) (i : Fin S) (a : Sym) (h : (σ.stk i).head? = some a) :
    (σ.pop i).push i a = σ := by
  rw [St.ext_iff']; refine ⟨fun j => ?_, rfl, rfl⟩
  simp only [St.pop_stk, St.push_stk]
  split_ifs with hj
  · subst hj
    rcases hl : σ.stk j with _ | ⟨b, l⟩
    · rw [hl] at h; simp at h
    · rw [hl] at h; simp at h; simp [h]
  · rfl

theorem Runs.branchOn_sol_aux {i : Fin S} {k : Cls → Stmt (S + 4) P} {s : IState S} {σ' : St (S + 4)}
    {c : ℕ} (h : Runs I prog (k (s.cl i)) (encI s) σ' c) :
    Runs I prog (NLogN.branchOn i k) (encI s) σ' (c + 20) := by
  unfold NLogN.branchOn
  refine (Runs.caseTop (c := c + 3) ?_).mono (by omega)
  unfold IState.cl at h
  rcases hG : s.G i with _ | ⟨x, L⟩
  · rw [hG] at h
    have : (encI s).top (ι i) = none := by simp [St.top_eq, hG]
    rw [this]; exact h.mono (by omega)
  · rw [hG] at h
    simp only [List.head?_cons] at h
    rcases x with z | _
    · have ht : (encI s).top (ι i) = some (hdOf z) := by simp [St.top_eq, hG, Item.enc]
      rw [ht]
      by_cases hz : z < 0
      · have e : hdOf z = hdNeg := by simp [hdOf, hz]
        rw [e]
        simp only [Option.some_ne_none, if_false, show some hdNeg ≠ some hdMark by decide, if_true]
        have : cls (some (Item.int z)) = .neg := by simp [cls, hz]; omega
        rw [this] at h; exact h.mono (by omega)
      · have e : hdOf z = hdPos := by simp [hdOf, hz]
        rw [e]
        simp only [Option.some_ne_none, if_false, show some hdPos ≠ some hdMark by decide,
          show some hdPos ≠ some hdNeg by decide]
        have hp : ((encI s).pop (ι i)).push (ι i) hdPos = encI s :=
          St.pop_push_top _ _ _ (by simp [hG, Item.enc, e])
        have hstk : ((encI s).pop (ι i)).stk (ι i) = (zbits z).map codeBit ++ encL L := by
          simp [hG, Item.enc]
        by_cases h0 : z = 0
        · have : cls (some (Item.int z)) = .zero := by simp [cls, h0]
          rw [this] at h
          have hb : isBitT (((encI s).pop (ι i)).top (ι i)) = false := by
            rw [St.top_eq, hstk, top_bits_isBit (bitOf_encL L)]; simp [h0, zbits, nbits_zero]
          refine (Runs.seq (Runs.pop (encI s) (ι i))
            (Runs.iteF hb (Runs.seq (Runs.push _ (ι i) hdPos) (by rw [hp]; exact h)))).mono ?_
          omega
        · have : cls (some (Item.int z)) = .pos := by simp [cls, h0, hz]
          rw [this] at h
          have hb : isBitT (((encI s).pop (ι i)).top (ι i)) = true := by
            rw [St.top_eq, hstk, top_bits_isBit (bitOf_encL L)]; simp [zbits_eq_nil, h0]
          refine (Runs.seq (Runs.pop (encI s) (ι i))
            (Runs.iteT hb (Runs.seq (Runs.push _ (ι i) hdPos) (by rw [hp]; exact h)))).mono ?_
          omega
    · have : (encI s).top (ι i) = some hdMark := by simp [St.top_eq, hG, Item.enc]
      rw [this]
      simp only [Option.some_ne_none, if_false, if_true]
      exact h.mono (by omega)

