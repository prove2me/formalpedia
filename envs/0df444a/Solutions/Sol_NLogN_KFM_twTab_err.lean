theorem solution (P k j n : ℕ) (hk : 0 < k) (hu : n * (4 * (2 : ℝ)⁻¹ ^ P) ≤ 1) (m : ℕ)
    (hm : m < n) :
    ‖NLogN.KFM.vP P ((NLogN.KFM.twTab P k j n)[m]'(by rw [NLogN.KFM.length_twTab]; exact hm)) -
      exp (2 * Real.pi * I * j / k) ^ m‖ ≤ 4 * n * (2 : ℝ)⁻¹ ^ P := by
  have hu0 : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ P := by positivity
  have hC : ‖exp (2 * Real.pi * I * j / k)‖ ≤ 1 :=
    NLogN.KFM.norm_exp_phase (2 * Real.pi * j / k) _ (by push_cast; ring)
  have h := NLogN.KFM.geoL_err P _ _ hC (NLogN.KFM.vP_twiddle P k j hk) n (NLogN.KFM.oneP P) 1 0 (by simp)
    (by simp [NLogN.KFM.vP_oneP]) (by nlinarith) m hm
  rw [one_mul] at h
  refine h.trans ?_
  have : (m : ℝ) ≤ n := by exact_mod_cast hm.le
  nlinarith
end
