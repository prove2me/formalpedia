-- Source module: Solutions.J6SegKs1
/-!
# B3′, part 1: computing the Kronecker constants of a block in the kernel

`kgRS` (with `j` on `kK`, `m = b·2n` on `kJ`, `2^pk` on `kc`, `2^b` on `kB`, scratch `vX, vY, CN`):
`acc := 2^pk`, `ρ := 2^b`; `j` times `acc := acc + acc·ρ`, `ρ := ρ·ρ` (so `acc = KFV.kG b 2^k 2^pk`,
`ρ = 2^(b 2^k)`); then `kJ := 2^m`, `kK := acc mod 2^m = KFV.kG b (2n) 2^pk`, `kJ := 2^m · 2^m`.
Cost `O(j · b 2^j + pow2Cost m)` — linear in `n b` up to the factor `j = clog₂ 2n`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

/-! ## `kG` arithmetic -/

theorem kG_succ (b r : ℕ) (c : ℤ) : KFV.kG b (r + 1) c = KFV.kG b r c + c * (2 ^ b : ℤ) ^ r := by
  simp [KFV.kG, Finset.sum_range_succ]

theorem kG_zero (b : ℕ) (c : ℤ) : KFV.kG b 0 c = 0 := by simp [KFV.kG]

theorem kG_nonneg (b : ℕ) {c : ℤ} (hc : 0 ≤ c) : ∀ r, 0 ≤ KFV.kG b r c
  | 0 => by simp [kG_zero]
  | r + 1 => by rw [kG_succ]; have := kG_nonneg b hc r; positivity

theorem kG_lt (b : ℕ) {c : ℤ} (hc : 0 ≤ c) (hcb : c < 2 ^ b) : ∀ r, KFV.kG b r c < (2 ^ b : ℤ) ^ r
  | 0 => by simp [kG_zero]
  | r + 1 => by
    rw [kG_succ, pow_succ]
    have h1 := kG_lt b hc hcb r
    have h2 : (0 : ℤ) < (2 ^ b : ℤ) ^ r := by positivity
    nlinarith

/-! ## `2^m` by `pow2` -/

/-! ## The constants of one block -/

theorem zsz_lt_pow {x : ℤ} {M : ℕ} (h0 : 0 ≤ x) (h : x < 2 ^ M) : zsz x ≤ M :=
  NLogN.zsz_le_of_abs (by rw [abs_of_nonneg h0]; exact h)

end J6Seg.KR

end

