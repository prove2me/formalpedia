theorem solution :
    ∃ q₀ : ℕ, ∀ q', q'.Prime → q₀ < q' → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u w : ℕ) (sh : AModel.Shape) (p q : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) → p < q → q < sh.length →
      sh.getD p 0 = 2 ^ u → sh.getD q 0 = 2 ^ u →
      ∀ (I : List NLogN.Sym) (s : NLogN.IState NLogN.HS) (gS : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ),
      gS 0 = NLogN.KFB.gflat zs ++ l → zs.length = AModel.vol sh → NLogN.KFB.GB w zs →
      ∃ c : ℕ, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFS.swAxG q' w sh p q u) (NLogN.KIL.encK s gS)
        (NLogN.KIL.encK s (Function.update gS 0 (NLogN.KFB.gflat (AModel.pull sh sh (AModel.swapPos p q) 0 zs) ++ l))) c ∧
        (c : ℝ) ≤ K * ((w : ℝ) + 1) * ((AModel.vol sh : ℝ) + 1) * (u : ℝ) ^ τS := by
  obtain ⟨q₀, H⟩ := NLogN.KFS.swAx_spec
  refine ⟨q₀, fun q' hq' hq₀ => ?_⟩
  obtain ⟨K, hK, HK⟩ := H q' hq' hq₀
  refine ⟨2 * K, by positivity, fun u w sh p q hu hsh hpq hq hpF hqF I s gS zs l hg0 hzl hGB => ?_⟩
  have hp : p < sh.length := by omega
  have hsh2 : ∀ a ∈ sh ++ [2], 1 ≤ a := by
    intro a ha; simp only [List.mem_append, List.mem_singleton] at ha
    rcases ha with ha | rfl
    · exact hsh a ha
    · omega
  have gp : (sh ++ [2]).getD p 0 = sh.getD p 0 := List.getD_append _ _ _ _ hp
  have gq : (sh ++ [2]).getD q 0 = sh.getD q 0 := List.getD_append _ _ _ _ hq
  set R0 := NLogN.ints l ++ s.G 0
  have ht0 : (NLogN.KIL.encK s gS).G 0 = NLogN.ints (NLogN.KFB.gflat zs) ++ R0 := by simp [hg0, NLogN.ints_append, R0]
  obtain ⟨c, Hc, hc⟩ := HK u w (sh ++ [2]) p q hu hsh2 hpq (by simp; omega) (by rw [gp, hpF])
    (by rw [gq, hqF]) I (NLogN.KIL.encK s gS) (NLogN.KFB.gflat zs) R0 ht0
    (by rw [NLogN.KFB.length_gflat, hzl, AModel.vol_append]; simp; ring) (NLogN.KFS.zsz_gflat' hGB)
  have hs : sh.getD p 0 = sh.getD q 0 := by rw [hpF, hqF]
  rw [← NLogN.KFS.gflat_pull_swapPos sh hp hq hs 0 zs hzl] at Hc
  refine ⟨c, ?_, ?_⟩
  · refine Hc.mono' ?_ le_rfl
    rw [← NLogN.KIL.encK_upd s gS 0 (NLogN.KFB.gflat (AModel.pull sh sh (AModel.swapPos p q) 0 zs) ++ l), NLogN.ints_append,
      List.append_assoc]
  · have hV : (AModel.vol (sh ++ [2]) : ℝ) + 1 ≤ 2 * ((AModel.vol sh : ℝ) + 1) := by
      rw [AModel.vol_append]; push_cast; simp; linarith
    have hx : (0 : ℝ) ≤ (u : ℝ) ^ τS := Real.rpow_nonneg (Nat.cast_nonneg _) _
    have hw : (0 : ℝ) ≤ (w : ℝ) + 1 := by positivity
    calc (c : ℝ) ≤ K * ((w : ℝ) + 1) * ((AModel.vol (sh ++ [2]) : ℝ) + 1) * (u : ℝ) ^ τS := hc
      _ ≤ K * ((w : ℝ) + 1) * (2 * ((AModel.vol sh : ℝ) + 1)) * (u : ℝ) ^ τS := by
          apply mul_le_mul_of_nonneg_right _ hx
          exact mul_le_mul_of_nonneg_left hV (by positivity)
      _ = 2 * K * ((w : ℝ) + 1) * ((AModel.vol sh : ℝ) + 1) * (u : ℝ) ^ τS := by ring
end
