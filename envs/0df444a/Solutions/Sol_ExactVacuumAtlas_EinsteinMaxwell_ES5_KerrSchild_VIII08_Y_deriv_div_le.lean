    rw [interior_Ioi] at hx
    exact (hasDerivAt_aY hx).differentiableAt.differentiableWithinAt
  · intro x hx
    rw [interior_Ioi] at hx
    exact aY_deriv_nonneg hx

/-- **Lower bound** `R/3 ≤ Y R`. -/
theorem Y_ge_third {R : ℝ} (hR : 3 < R) : R / 3 ≤ Y R := by
  have hmono : Tendsto aY (𝓝[>] (3:ℝ)) (𝓝 (1 / 3)) := aY_tendsto_three
  have hev : ∀ᶠ s in 𝓝[>] (3:ℝ), aY s ≤ aY R := by
    filter_upwards [self_mem_nhdsWithin,
      mem_nhdsWithin_of_mem_nhds (isOpen_Iio.mem_nhds hR)] with s hs hsR
    exact aY_monotoneOn hs (mem_Ioi.mpr hR) hsR.le
  have hle : 1 / 3 ≤ aY R := le_of_tendsto hmono hev
  unfold aY at hle
  rw [le_div_iff₀ (by linarith : (0:ℝ) < R)] at hle
  linarith

/-! ## `aY ≥ 1/3`, positivity of `V`, and `Wfun 3 = 0` -/

theorem aY_ge_third {R : ℝ} (hR : 3 < R) : 1 / 3 ≤ aY R := by
  have h := Y_ge_third hR
  unfold aY
  rw [le_div_iff₀ (by linarith : (0:ℝ) < R)]
  linarith

/-! ## `Wfun` is continuous on `[3, R]` from the right at the horizon -/

/-! ## `Wfun R = ∫₃ᴿ 12 Y / t²` -/

/-! ## Pointwise comparison `Y t ≤ t · aY R` -/

theorem Y_le_mul_aY {R t : ℝ} (hR : 3 < R) (ht : t ∈ Icc 3 R) : Y t ≤ t * aY R := by
  rcases lt_or_eq_of_le ht.1 with h | h
  · have htpos : (0:ℝ) < t := by linarith
    have hmono : aY t ≤ aY R := aY_monotoneOn h (mem_Ioi.mpr hR) ht.2
    have hYt : Y t = t * aY t := by unfold aY; field_simp
    rw [hYt]
    exact mul_le_mul_of_nonneg_left hmono (le_of_lt htpos)
  · subst h
    rw [Y_three]
    have hge := aY_ge_third hR
    linarith

/-! ## The upper bound `Wfun R ≤ 4 aY R (R-3)` -/

/-! ## The derivative bound `aY' ≤ 4 aY / (R (R-1))` -/

/-! ## The comparison function `gY = aY · (R/(R-1))⁴` -/

/-! ## The upper sandwich `Y ≤ 27 R / 16` -/

/-! ## `0 < Y'` and `Y'/Y ≤ 3/R` -/

theorem Vfun_le_two_div {t : ℝ} (ht : 3 ≤ t) : Vfun t ≤ 2 / t := by
  have htpos : (0:ℝ) < t := by linarith
  have h9 : 9 / t ^ 3 ≤ 1 / t := by
    rw [div_le_div_iff₀ (by positivity : (0:ℝ) < t ^ 3) htpos]
    have hsq : (9:ℝ) ≤ t ^ 2 := by nlinarith
    nlinarith [hsq, htpos]
  unfold Vfun
  have h2 : (1:ℝ) / t + 1 / t = 2 / t := by ring
  linarith

