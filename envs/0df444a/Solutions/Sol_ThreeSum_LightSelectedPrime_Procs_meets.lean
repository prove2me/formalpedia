/-!
# Executing the deterministic square-root prime selection

The candidate pool is scanned by the verified primality program. Its first
entry is exactly the minimum used by `LocalCoverBounds.selectedPrime`.
The input threshold is positive; the routine has no primality oracle or
externally supplied list of candidates.
-/

namespace ThreeSum.LightSelectedPrime

open Light LocalCoverBounds LightResidues

set_option maxHeartbeats 1000000

theorem prime_zero_eq_selectedPrime (N : ℕ) :
    LightPrimePool.prime (rootCeiling N) 0 = selectedPrime N := by
  apply Nat.le_antisymm
  · have hs := selectedPrime_spec N
    apply LightPrimePool.prime_zero_le_mem
    exact LightPrimePool.mem_values.mpr ⟨hs.1,hs.2.1,by omega⟩
  · unfold selectedPrime
    apply Finset.min'_le
    exact mem_primeCandidates.mpr
      (LightPrimePool.prime_zero_spec (rootCeiling_pos N))


















variable {lim : Limits} {P : Program} {d : ℕ}

theorem Procs.meets_sourceProof {pMain : ℕ} (S : Procs P pMain)
    {μ : ℕ → ℤ} {N free : ℕ}
    (hw : (lim.space : ℤ) ≤ lim.word) (hd : d+2 < lim.depth)
    (hN : 0 < N) (hspace : space free N ≤ lim.space)
    (hword : (word N : ℤ) ≤ lim.word) :
    Meets lim P pMain d [N,free] μ (time N)
      (fun r μ' => r = (selectedPrime N : ℤ) ∧
        SegN μ' free (LightPrimePool.values (rootCeiling N)) ∧ Kept μ μ' free) := by
  have hypos := rootCeiling_pos N
  have hy : rootCeiling N ≤ N+1 := by
    unfold rootCeiling
    have hh := Nat.sqrt_le_self (N-1)
    omega
  have hwordZ : 100*((N : ℤ)+1) ≤ lim.word := by exact_mod_cast hword
  have hsub : (N : ℤ)-1 = ((N-1 : ℕ) : ℤ) := by omega
  have hrootWord : (rootCeiling N : ℤ) ≤ lim.word := by omega
  have hpoolWord : (LightPrimePool.word (rootCeiling N) : ℤ) ≤ lim.word := by
    unfold LightPrimePool.word
    push_cast
    omega
  have hfree : free < lim.space := by
    unfold space LightPrimePool.space at hspace
    omega
  have hselectedWord : (selectedPrime N : ℤ) ≤ lim.word := by
    have hp := (selectedPrime_spec N).2.2
    omega
  apply Meets.of_body S.main
  unfold body time
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (first
      |
        refine
          Light.Ends.callToThen
            ((sqrt_meets (d := d + 1) (K := N - 1) S.sqrt μ (by omega)) _
              (by omega))
            ?_ ?_ ?_ ?_
      |
        refine
          Light.Ends.callToThen
            (sqrt_meets (d := d + 1) (K := N - 1) S.sqrt μ (by omega)) ?_ ?_ ?_
            ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hsub,
                LightPrimePool.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [hsub, LightPrimePool.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 => omega);
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, hsub,
                LightPrimePool.time] <;>
              omega)));
    (on_goal -1 =>
        ((rintro root μ₁ ⟨hr, hmem₁⟩);
          (try with_unfolding_none refine Light.Ends.skip ?_)))
  subst μ₁
  have hr' : root+1 = (rootCeiling N : ℤ) := by
    simpa [rootCeiling] using congrArg (fun z : ℤ => z+1) hr
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (rootCeiling N : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hr',
                LightPrimePool.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [hr', LightPrimePool.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, hr',
                LightPrimePool.time] <;>
              omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (first
      |
        refine
          Light.Ends.callToThen
            ((S.pool.meets (d := d + 1) hw hd hypos hspace hpoolWord) _
              (by omega))
            ?_ ?_ ?_ ?_
      |
        refine
          Light.Ends.callToThen
            (S.pool.meets (d := d + 1) hw hd hypos hspace hpoolWord) ?_ ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                LightPrimePool.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [LightPrimePool.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 => omega);
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, LightPrimePool.time] <;>
              omega)));
    (on_goal -1 =>
        ((rintro count μ₂ ⟨hc, hseg, hkept⟩);
          (try with_unfolding_none refine Light.Ends.skip ?_)))
  have hlen : 0 < (LightPrimePool.values (rootCeiling N)).length :=
    LightPrimePool.size_pos hypos
  have hfirst : μ₂ free = (selectedPrime N : ℤ) := by
    have hh := hseg 0 (by simp; exact hlen)
    rw [← prime_zero_eq_selectedPrime]
    change μ₂ free = ((LightPrimePool.values (rootCeiling N)).getD 0 0 : ℤ)
    rw [List.getD_eq_getElem _ _ hlen]
    simpa using hh
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (selectedPrime N : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hfirst,
                LightPrimePool.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [hfirst, LightPrimePool.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, hfirst,
                LightPrimePool.time] <;>
              omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  exact ⟨rfl,hseg,hkept⟩

















































end ThreeSum.LightSelectedPrime

end


theorem solution : ∀ {lim : Light.Limits} {P : Light.Program} {d pMain : Nat} (S : ThreeSum.LightSelectedPrime.Procs P pMain)
  {μ : Nat → Int} {N free : Nat},
  @LE.le.{0} Int Int.instLEInt (@Nat.cast.{0} Int instNatCastInt lim.space) lim.word →
    @LT.lt.{0} Nat instLTNat
        (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) d
          (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
        lim.depth →
      @LT.lt.{0} Nat instLTNat (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) N →
        @LE.le.{0} Nat instLENat (ThreeSum.LightSelectedPrime.space free N) lim.space →
          @LE.le.{0} Int Int.instLEInt (@Nat.cast.{0} Int instNatCastInt (ThreeSum.LightSelectedPrime.word N))
              lim.word →
            Light.Meets lim P pMain d
              (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt N)
                (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt free) (@List.nil.{0} Int)))
              μ (ThreeSum.LightSelectedPrime.time N) fun (r : Int) (μ' : Nat → Int) =>
              And (@Eq.{1} Int r (@Nat.cast.{0} Int instNatCastInt (ThreeSum.LocalCoverBounds.selectedPrime N)))
                (And (Light.SegN μ' free (ThreeSum.LightPrimePool.values (ThreeSum.LocalCoverBounds.rootCeiling N)))
                  (Light.Kept μ μ' free)) := by
  exact @ThreeSum.LightSelectedPrime.Procs.meets_sourceProof

#print axioms solution
