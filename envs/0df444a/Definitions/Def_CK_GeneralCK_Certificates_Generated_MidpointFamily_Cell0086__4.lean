theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨184498051140,184717953467⟩ ⟨754327540990,754346948964⟩ ⟨91325435803,93282566501⟩ := rfl
noncomputable def centerUpper : ℝ := (382728582039 / 1099511627776)
