-- title:
--   Corollary 1.1 / abstract: stabilizer-code Rényi hierarchy
-- statement:
--   Let a finite stabilizer code encode $k$ logical qubits into $N$ physical qubits, and let $V$ be any isometry onto its full codespace. Apply a normalized stochastic Pauli law generated by finitely many independent Bernoulli events to the physical half of the encoded, normalized maximally entangled logical state. Event probabilities may take any value in $[0,1]$, and an event may act on several qubits. Write $\rho_{RQ}$ for the resulting state and $I_c^{(r)}=H_r(Q)-H_r(RQ)$, with natural logarithms, Shannon/von Neumann order one, and min-entropy order infinity. Then
--
--   $$I_c^{(r)}\le I_c^{(s)}\qquad(1\le r\le s\le\infty),$$
--
--   where finite orders are integers. No CSS, locality, nondegeneracy, or fixed logical-dimension assumption is required. This compares the actual noisy encoded state, including both endpoints of the hierarchy.
-- source:
--   Hierarchy of Rényi Coherent Information in Stabilizer Codes, arXiv:2609.11930v1, PDF p. 2, Corollary 1.1 / abstract: stabilizer-code Rényi hierarchy

import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P39

noncomputable section

namespace QAlgorithms.Papers.Independent.Information100.P39

open scoped Matrix ComplexConjugate

attribute [local instance] Classical.propDecidable

/-- Corollary 1.1, PDF pp.2,4, Eqs.(5),(32)–(33): the actual encoded noisy-state
coherent information increases through positive integer orders to infinity. -/
theorem stabilizerRenyiHierarchy {N k : ℕ} (C : StabilizerCode N k)
    (nu : PauliLabel N → ℝ) (hnu : Learning.IsDistribution nu)
    (hind : HasIndependentEvents nu) :
    ∀ r s : Order, 1 ≤ r → r ≤ s →
      coherentInformation r (noisyChoi C.encoder nu hnu) ≤
        coherentInformation s (noisyChoi C.encoder nu hnu) := by sorry

end QAlgorithms.Papers.Independent.Information100.P39

end
