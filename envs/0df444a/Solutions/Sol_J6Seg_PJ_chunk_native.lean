theorem affine_le {a c Q p X : ℕ} (hQ : Q ≤ 3 * p) (hp : p ≤ X) (hX : 1 ≤ X) :
    a * Q + c ≤ (3 * a + c) * X := by
  have h1 : a * Q ≤ a * (3 * X) := Nat.mul_le_mul_left _ (by omega)
  have h2 : c ≤ c * X := Nat.le_mul_of_pos_right _ hX
  nlinarith

theorem natZ {x B : ℕ} (h : x < 2 ^ B) : zsz (x : ℤ) ≤ B :=
  zsz_of_le (M := x) (by simp) h

theorem cost_pack {r K e Cs S X p t b : ℕ} (hK : r ≤ K * (S + 1) ^ e) (hS : S + 1 ≤ Cs * X)
    (hX : X = p ^ 7 * t ^ 2) (hb : 1 ≤ b) (ht : 1 ≤ t) :
    r ≤ K * Cs ^ e * b ^ (7 * e) * t ^ (7 * e) * p ^ (7 * e) := by
  have h1 : 1 ≤ b ^ (7 * e) := Nat.one_le_pow _ _ hb
  have h2 : t ^ (2 * e) ≤ t ^ (7 * e) := Nat.pow_le_pow_right ht (by omega)
  calc r ≤ K * (S + 1) ^ e := hK
    _ ≤ K * (Cs * X) ^ e := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hS e)
    _ = K * Cs ^ e * (p ^ (7 * e) * t ^ (2 * e)) := by
        rw [hX, mul_pow, mul_pow, ← pow_mul, ← pow_mul]; ring
    _ ≤ K * Cs ^ e * (b ^ (7 * e) * (t ^ (7 * e) * p ^ (7 * e))) := by
        apply Nat.mul_le_mul_left
        calc p ^ (7 * e) * t ^ (2 * e) ≤ p ^ (7 * e) * t ^ (7 * e) := Nat.mul_le_mul_left _ h2
          _ = 1 * (t ^ (7 * e) * p ^ (7 * e)) := by ring
          _ ≤ b ^ (7 * e) * (t ^ (7 * e) * p ^ (7 * e)) := Nat.mul_le_mul_right _ h1
    _ = K * Cs ^ e * b ^ (7 * e) * t ^ (7 * e) * p ^ (7 * e) := by ring

