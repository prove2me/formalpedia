-- Source module: Solutions.J6SegRes
/-!
# Segmented inverse (S2): the exact Woodbury residual identity (abstract form)

Abstract setting on positions `ℕ` (a position set `I`): a block-diagonal matrix `M` given by its
blocks `bl i` and entries `Mx`, its block inverse `Mi`, and a sparse coupling `Δ` given row-wise
by offsets `Hs i`, columns `cl i h` and coefficients `cf i h`, with every coupling column in the
capacitance index set `J`.

`res_bound` (report L8 + L10, residual form): if the four fixed-point stages of the segmented
inverse are accurate,
* `y ≈ M⁻¹ u` (`ε₁`), `W ≈ Δ z` (`ε₃`), `y₂ ≈ M⁻¹ W` (`ε₂`),
* `z + (M⁻¹ Δ z)|_J ≈ y|_J` (`ε₄`, the capacitance solve),

then `x = y - y₂` satisfies `|((M + Δ) x - u)_i| ≤ A(ε₁+ε₂) + ε₃ + d(ε₄ + μ ε₃ + ε₂)`
(`A`, `d`, `μ` bound `‖M‖`, `‖Δ‖`, `‖M⁻¹‖` row-wise). No exact intermediate solution is needed.
`Miv_bound`: `‖M⁻¹‖ ≤ 1/(1-m)` from `M M⁻¹ = I` and `‖M - I‖ ≤ m < 1` (via `near_id`).
-/

open Finset

namespace J6Seg

section res
variable (bl : ℕ → Finset ℕ) (Mx : ℕ → ℕ → ℝ) (Hs : ℕ → Finset ℤ) (cl : ℕ → ℤ → ℕ)
  (cf : ℕ → ℤ → ℝ)

/-- `M (M⁻¹ f) = f` from the entrywise block identity. -/
lemma Mv_Miv (Mi : ℕ → ℕ → ℝ) {i : ℕ} (hii : i ∈ bl i) (hbl : ∀ k ∈ bl i, bl k = bl i)
    (hinv : ∀ m ∈ bl i, ∑ j ∈ bl i, Mx i j * Mi j m = kd i m) (f : ℕ → ℝ) :
    Mv bl Mx (Mv bl Mi f) i = f i := by
  unfold Mv
  have e1 : ∑ j ∈ bl i, Mx i j * ∑ m ∈ bl j, Mi j m * f m =
      ∑ j ∈ bl i, ∑ m ∈ bl i, Mx i j * Mi j m * f m :=
    sum_congr rfl fun j hj => by rw [hbl j hj, mul_sum]; exact sum_congr rfl fun _ _ => by ring
  rw [e1, sum_comm]
  have e2 : ∑ m ∈ bl i, ∑ j ∈ bl i, Mx i j * Mi j m * f m = ∑ m ∈ bl i, kd i m * f m :=
    sum_congr rfl fun m hm => by rw [← hinv m hm, sum_mul]
  rw [e2]
  simp only [kd, ite_mul, one_mul, zero_mul]; rw [sum_ite_eq]; simp [hii]

/-- **`‖M⁻¹‖ ≤ 1/(1-m)`.** -/
theorem Miv_bound (Mi : ℕ → ℕ → ℝ) {m F : ℝ} (hm : m < 1) {i : ℕ} (hii : ∀ k ∈ bl i, k ∈ bl k)
    (hbl : ∀ k ∈ bl i, bl k = bl i)
    (hinv : ∀ k ∈ bl i, ∀ q ∈ bl i, ∑ j ∈ bl i, Mx k j * Mi j q = kd k q)
    (hrow : ∀ k ∈ bl i, ∑ j ∈ bl i, |Mx k j - kd k j| ≤ m)
    (f : ℕ → ℝ) (hF : ∀ k ∈ bl i, |f k| ≤ F) (hi : i ∈ bl i) :
    |Mv bl Mi f i| ≤ F / (1 - m) := by
  have key := near_id (I := bl i) (a := Mx) (z := fun k => Mv bl Mi f k) (r := f) (ρ := 0) hm
    hrow (fun k hk => by
      have := Mv_Miv bl Mx Mi (hii k hk) (fun q hq => by rw [hbl q (by rw [← hbl k hk]; exact hq),
        hbl k hk]) (fun q hq => by rw [hbl k hk]; exact hinv k hk q (by rw [← hbl k hk]; exact hq)) f
      have h' : ∑ q ∈ bl i, Mx k q * Mv bl Mi f q = f k := by rw [← hbl k hk]; exact this
      rw [h']; simp) hF i hi
  simpa using key

end res

end J6Seg

end

