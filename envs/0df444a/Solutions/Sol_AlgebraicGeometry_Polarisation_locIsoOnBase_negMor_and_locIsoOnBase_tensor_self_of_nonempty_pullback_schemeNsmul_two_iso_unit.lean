theorem solution
    {S : Type} [CommRing S] {A : Scheme} {f : A ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle S f)
    (hker : IsFinite (L.schemeKerStr 2) ∧ Flat (L.schemeKerStr 2) ∧ LocallyOfFinitePresentation (L.schemeKerStr 2))
    (R : Type) [CommRing R] (ι : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S))
    (N : RigidifiedLineBundle f (L.one (𝟙 _)) ι)
    (h2 : Nonempty ((Scheme.Modules.pullback ((L.baseChange ι).schemeNsmul 2)).obj N.L ≅ 𝟙_ _)) :
    LocIsoOnBase (pullback.snd f ι)
          ((Scheme.Modules.pullback (negMor (pullback.snd f ι) (L.baseChange ι))).obj N.L) N.L ∧
      LocIsoOnBase (pullback.snd f ι) (N.L ⊗ N.L) (𝟙_ _) := by
  classical
  obtain ⟨e2⟩ := h2
  have h2fl := GoodReductionJacobian.RelativeGroupLaw.isAffineHom_flat_surjective_schemeNsmul_two_of_isFinite_flat_schemeKerStr
    L hc hA hker
  obtain ⟨Φ, hΦ⟩ :=
    AlgebraicGeometry.Polarisation.exists_torsionCharacter_two_bijOn_pullback_schemeNsmul_two_trivial_rigidifiedLineBundle
      L hc hA hker h2fl
  dsimp only at hΦ
  obtain ⟨-, -, -, hIV, hV, hVI⟩ := hΦ

  obtain ⟨r⟩ := N.rigidified
  let N2 : RigidifiedLineBundle f (L.one (𝟙 _)) ι :=
    { L := N.L ⊗ N.L
      isInvertible := N.isInvertible.tensor_monoidalV2 N.isInvertible
      rigidified := ⟨Scheme.Modules.pullbackTensorObjIso _ N.L N.L ≪≫ (r ⊗ᵢ r) ≪≫ λ_ _⟩ }
  have hAdmN : Nonempty ((Scheme.Modules.pullback ((L.baseChange ι).schemeNsmul 2)).obj N.L ≅ 𝟙_ _) := ⟨e2⟩
  have hAdmN2 : Nonempty ((Scheme.Modules.pullback ((L.baseChange ι).schemeNsmul 2)).obj N2.L ≅ 𝟙_ _) :=
    ⟨Scheme.Modules.pullbackTensorObjIso _ N.L N.L ≪≫ (e2 ⊗ᵢ e2) ≪≫ λ_ _⟩
  have hAdmU : Nonempty ((Scheme.Modules.pullback ((L.baseChange ι).schemeNsmul 2)).obj
      (RigidifiedLineBundle.unit (c := f) (ε := L.one (𝟙 _)) ι).L ≅ 𝟙_ _) :=
    ⟨Scheme.Modules.pullbackTensorUnitObjIso _⟩

  have hΦeq : Φ R ι N2 = Φ R ι (RigidifiedLineBundle.unit (c := f) (ε := L.one (𝟙 _)) ι) := by
    apply GoodReductionJacobian.RelativeGroupLaw.TorsionCharacter.ext
    funext T _ κ x hx
    rw [hV R ι N N N2 hAdmN hAdmN ⟨Iso.refl _⟩ T κ x hx,
      hVI R ι (RigidifiedLineBundle.unit (c := f) (ε := L.one (𝟙 _)) ι) ⟨Iso.refl _⟩ T κ x hx]
    exact Ws23K3.val_mul_self_eq_one (Φ R ι N) T κ x hx

  obtain ⟨esq⟩ := hIV R ι N2 (RigidifiedLineBundle.unit (c := f) (ε := L.one (𝟙 _)) ι) hAdmN2 hAdmU hΦeq
  have esq' : N.L ⊗ N.L ≅ 𝟙_ _ := esq

  obtain ⟨eW⟩ := AlgebraicGeometry.Polarisation.nonempty_pullback_schemeNsmul_two_iso_tensor_pullback_negMor_of_rigidified
    L hc hA R ι N
  have eMP : N.L ⊗ (Scheme.Modules.pullback (negMor (pullback.snd f ι) (L.baseChange ι))).obj N.L ≅ 𝟙_ _ :=
    (((ρ_ N.L).symm ≪≫ (Iso.refl N.L ⊗ᵢ esq'.symm)) ⊗ᵢ Iso.refl _) ≪≫ eW.symm ≪≫ e2
  have eP : (Scheme.Modules.pullback (negMor (pullback.snd f ι) (L.baseChange ι))).obj N.L ≅ N.L :=
    (λ_ _).symm ≪≫ (esq'.symm ⊗ᵢ Iso.refl _) ≪≫ α_ _ _ _ ≪≫ (Iso.refl N.L ⊗ᵢ eMP) ≪≫ ρ_ N.L
  exact ⟨Ws23K3.locIso_of_iso _ eP, Ws23K3.locIso_of_iso _ esq'⟩

