theorem ModularCurve.natCard_torsion_eq_pow_height_add_toricRank_of_abelJacobiPin_tauFree
    (p : ℕ) [Fact p.Prime] (hp2 : p ≠ 2) (M : ℕ) [NeZero M] (hpM : p ∣ M) (hpM2 : ¬ p ^ 2 ∣ M)
