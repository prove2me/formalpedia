-- title:
--   Rules R₁ (stay on heads, switch on tails) and R₀ (random coin, then stick), p_i and E(S_n/n)
-- statement:
--   Let the two coins $A$, $B$ have head probabilities $\alpha, \beta$, and write $x_i\in\{0,1\}$ for the payoff of the $i$-th toss and $S_n = x_1+\dots+x_n$.
--
--   1. **Rule $R_1$.** For the first toss choose $A$ or $B$ at random, each with probability $\tfrac12$. Then, for $i = 1, 2, \dots$, if the $i$-th toss results in heads, use the same coin for the $(i+1)$-th toss; if it results in tails, switch to the other coin for the $(i+1)$-th toss.
--   2. **Rule $R_0$.** Choose one of the two coins at random, each with probability $\tfrac12$, and then use it for every toss, come what may.
--   3. For a rule $R$, $p_i$ is the probability of obtaining heads on the $i$-th toss ($i \ge 1$) when the coins are tossed according to $R$.
--   4. For a rule $R$, $\mathrm E(S_n/n)$ is the expected average payoff of the first $n$ tosses.
--
--   The probabilities and expectations are taken under the law of the whole infinite sequence of (coin, payoff) pairs generated by the rule and the coins.
--
--   **Formalization Note** Each rule is a published `BanditAlgorithm.BanditPolicy 2` (arm $0$ = coin $A$, arm $1$ = coin $B$), and the law of the infinite sequence of tosses is the published `banditTrajMeasure`, whose coordinate $t$ is toss $t+1$; so $p_i$ is the probability that coordinate $i-1$ has payoff $1$ (the value at $i = 0$ is not used by any statement). "At random" is read as the fair choice. Heads is the payoff value $1$. `expectedAverage π α β n` is the Bochner integral of $S_n/n$; at $n=0$ it is $0$ and is not used.
-- source:
--   Robbins, Some aspects of the sequential design of experiments, Bull. Amer. Math. Soc. 58 (1952), p. 530, Section 2 (rule R₁, p_i) and p. 531 (rule R₀, E(S_n/n))

import Mathlib
import Definitions.Def_BanditTrajectory
import Definitions.Def_RobbinsSeqDesign_StayOrSwitch_Coins

/-!
Robbins, *Some aspects of the sequential design of experiments*,
Bull. Amer. Math. Soc. 58 (1952), Section 2, pp. 530–531.

The sampling rules `R₁` ("stay on heads, switch on tails") and `R₀` ("choose a coin at random and
stick to it") as bandit policies on the two coins, the head probability `p_i` of the `i`-th toss,
and the expectation `E(S_n/n)` of the average payoff of the first `n` tosses. Toss `i` (`i ≥ 1`)
is coordinate `i − 1` of the infinite trajectory `banditTrajMeasure`.
-/

open MeasureTheory ProbabilityTheory

namespace RobbinsSeqDesign.StayOrSwitch

/-- The other coin: `A ↦ B`, `B ↦ A` (arm `0 ↦ 1`, `1 ↦ 0`). -/
def otherCoin (i : Fin 2) : Fin 2 := if i = 0 then 1 else 0

/-- The choice of `R₁` after a toss `(i, x)` of coin `i` with payoff `x`: the same coin after a
head (`x = 1`), the other coin after a tail. -/
noncomputable def stayOrSwitch (last : Fin 2 × ℝ) : Fin 2 :=
  if last.2 = 1 then last.1 else otherCoin last.1

lemma measurable_stayOrSwitch : Measurable stayOrSwitch := by
  unfold stayOrSwitch
  refine Measurable.ite ?_ measurable_fst ((measurable_of_countable otherCoin).comp measurable_fst)
  exact measurable_snd (measurableSet_singleton (1 : ℝ))

/-- The fair choice between the two coins: probability `1/2` each. -/
noncomputable def fairCoinChoice : Measure (Fin 2) := (PMF.uniformOfFintype (Fin 2)).toMeasure

instance fairCoinChoice.instIsProbabilityMeasure : IsProbabilityMeasure fairCoinChoice := by
  unfold fairCoinChoice
  infer_instance

/-- Rule `R₁` (p. 530): for the first toss choose `A` or `B` at random (fairly); then, if the
`i`-th toss results in heads, use the same coin for the `(i+1)`-th toss, and if it results in
tails, switch to the other coin. -/
noncomputable def ruleR1 : BanditAlgorithm.BanditPolicy 2 where
  select := fun n => match n with
    | 0 => Kernel.const _ fairCoinChoice
    | n + 1 => Kernel.deterministic (fun h : BanditAlgorithm.BanditHistory 2 (n + 1) =>
        stayOrSwitch (h (Fin.last n)))
        (measurable_stayOrSwitch.comp (measurable_pi_apply _))
  markov := fun n => by
    cases n with
    | zero => infer_instance
    | succ n => infer_instance

/-- Rule `R₀` (p. 531): choose one of the two coins at random (fairly) and then stick to it,
come what may. -/
noncomputable def ruleR0 : BanditAlgorithm.BanditPolicy 2 where
  select := fun n => match n with
    | 0 => Kernel.const _ fairCoinChoice
    | n + 1 => Kernel.deterministic (fun h : BanditAlgorithm.BanditHistory 2 (n + 1) =>
        (h 0).1) ((measurable_fst).comp (measurable_pi_apply _))
  markov := fun n => by
    cases n with
    | zero => infer_instance
    | succ n => infer_instance

/-- `p_i` (p. 530): the probability of obtaining heads (payoff `1`) on the `i`-th toss, `i ≥ 1`,
when the coins have head probabilities `α, β` and the rule `π` is used. Toss `i` is trajectory
coordinate `i − 1`; the value at `i = 0` is not used. -/
noncomputable def headProb (π : BanditAlgorithm.BanditPolicy 2) (α β : unitInterval) (i : ℕ) : ℝ :=
  (BanditAlgorithm.banditTrajMeasure (coins α β) π).real {ω | (ω (i - 1)).2 = 1}

/-- `S_n = x_1 + ⋯ + x_n`, the total payoff of the first `n` tosses of a trajectory. -/
def totalPayoff (n : ℕ) (ω : ℕ → Fin 2 × ℝ) : ℝ := ∑ t ∈ Finset.range n, (ω t).2

/-- `E(S_n/n)`: the expected average payoff of the first `n` tosses when the coins have head
probabilities `α, β` and the rule `π` is used. -/
noncomputable def expectedAverage (π : BanditAlgorithm.BanditPolicy 2) (α β : unitInterval)
    (n : ℕ) : ℝ :=
  ∫ ω, totalPayoff n ω / n ∂(BanditAlgorithm.banditTrajMeasure (coins α β) π)

end RobbinsSeqDesign.StayOrSwitch


