-- title:
--   The heat semigroup e^{−tA}, A = −Δ on L²(ℝⁿ) ((5.36)–(5.37))
-- statement:
--   Let $A = -\Delta$ on $L^2(\mathbb{R}^n)$ with domain $H^2(\mathbb{R}^n)$. The semigroup $\{e^{-tA} : t \ge 0\}$ it generates is the Fourier multiplier
--   $$\widehat{e^{-tA}h}(k) = e^{-t|k|^2}\,\hat h(k).$$
--   For $t > 0$ this is convolution with the **heat kernel**
--   $$\Gamma_t(x) = (4\pi t)^{-n/2}\, e^{-|x|^2/(4t)}, \qquad (e^{-tA}h)(x) = \int_{\mathbb{R}^n} \Gamma_t(x-y)\, h(y)\, dy,$$
--   and $e^{-0A} = I$.
--
--   This is the linear solution operator of the heat equation $u_t = \Delta u$, whose smoothing from $L^2$ into $H^{2\alpha}$ drives the local existence theory of §5.5.
--
--   **Formalization Note.** `heatSemigroup n t h` is the convolution with $\Gamma_t$ for $t > 0$ and $h$ itself for $t \le 0$ (negative times are never used); it is written for real- or complex-valued $h$ (`RCLike 𝕜`). For $h \in L^2$ the convolution integral converges absolutely at every $x$, and in the book's Fourier normalization $\widehat{\Gamma_t} = (2\pi)^{-n}e^{-t|k|^2}$, so this is the multiplier (5.37).
-- source:
--   Hunter, Notes on Partial Differential Equations (revised 6/18/2014), p. 153, Eqs. (5.36)–(5.37)

import Mathlib

open MeasureTheory

namespace HunterPDE.Semilinear

/-- The heat kernel on `ℝⁿ = EuclideanSpace ℝ (Fin n)`, for `t > 0`:
`Γ_t(x) = (4πt)^{−n/2} e^{−|x|²/(4t)}`. -/
noncomputable def heatKernel (n : ℕ) (t : ℝ) (x : EuclideanSpace ℝ (Fin n)) : ℝ :=
  (4 * Real.pi * t) ^ (-(n : ℝ) / 2) * Real.exp (-‖x‖ ^ 2 / (4 * t))

/-- The heat semigroup `{e^{−tA} : t ≥ 0}` generated by `−A = Δ` on `L²(ℝⁿ)`
(Hunter, *Notes on PDEs*, (5.36)–(5.37), p. 153), acting on `𝕜`-valued functions (`𝕜 = ℝ` or `ℂ`).

The book gives `e^{−tA}` as the Fourier multiplier `(e^{−tA}h)^(k) = e^{−t|k|²} ĥ(k)`. For
`t > 0` this operator is convolution with the heat kernel `Γ_t`,
`(e^{−tA}h)(x) = ∫_{ℝⁿ} Γ_t(x − y) h(y) dy`,
which is how it is written here (for `h ∈ L²(ℝⁿ)` the integral converges absolutely at every
`x`, since `Γ_t ∈ L²`); `e^{−0A} = I`. Negative times are never used; the definition returns `h`
there. -/
noncomputable def heatSemigroup {𝕜 : Type*} [RCLike 𝕜] (n : ℕ) (t : ℝ)
    (h : EuclideanSpace ℝ (Fin n) → 𝕜) (x : EuclideanSpace ℝ (Fin n)) : 𝕜 :=
  if t ≤ 0 then h x else ∫ y, ((heatKernel n t (x - y) : ℝ) : 𝕜) * h y

end HunterPDE.Semilinear


