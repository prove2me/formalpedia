    funext t; simp [Function.update_apply, show (2:Fin 5) ≠ 1 from by decide]
  rw [hslice]
  have h1c : HasDerivAt (fun _ : ℝ => (-1:ℝ)) 0 (x 2) := hasDerivAt_const _ _
  have hden : HasDerivAt (fun t : ℝ => 2 * (1 - t)) (-2) (x 2) :=
    (((hasDerivAt_const (x 2) (1:ℝ)).sub (hasDerivAt_id' (x 2))).const_mul 2).congr_deriv
      (by ring)
  exact (h1c.fun_div hden (mul_ne_zero two_ne_zero h1u.ne')).congr_deriv
