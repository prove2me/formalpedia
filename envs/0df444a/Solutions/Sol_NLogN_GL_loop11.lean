    RM.RepStates c n b s (lSt A1 A2 B1 B2 e1 e2 d1 d2 f1 f2 s L1 L2 R1 R2) ∧
    ∀ k < N, b.ok M (withCtr c s N k (lSt A1 A2 B1 B2 e1 e2 d1 d2 f1 f2 s L1 L2 R1 R2 k)) ∧
      b.cost M (withCtr c s N k (lSt A1 A2 B1 B2 e1 e2 d1 d2 f1 f2 s L1 L2 R1 R2 k)) ≤ C := by
  simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, not_or,
    List.nodup_nil, and_true] at hd
  obtain ⟨⟨a12, a1b1, a1b2, a1c⟩, ⟨a2b1, a2b2, a2c⟩, ⟨b1b2, b1c⟩, b2c, -⟩ := hd
  have hN : (n.eval s).toNat = N := by rw [hn]; simp
  -- the body facts at round `k`
  have key : ∀ k < N,
      b.run (withCtr c s N k (lSt A1 A2 B1 B2 e1 e2 d1 d2 f1 f2 s L1 L2 R1 R2 k)) =
        withCtr c s N k (lSt A1 A2 B1 B2 e1 e2 d1 d2 f1 f2 s L1 L2 R1 R2 (k + 1)) ∧
      b.ok M (withCtr c s N k (lSt A1 A2 B1 B2 e1 e2 d1 d2 f1 f2 s L1 L2 R1 R2 k)) ∧
      b.cost M (withCtr c s N k (lSt A1 A2 B1 B2 e1 e2 d1 d2 f1 f2 s L1 L2 R1 R2 k)) ≤ C := by
    intro k hk
    have hk1 : k < L1.length := by omega
    have hk2 : k < L2.length := by omega
    have dd1 : L1.drop k = L1[k] :: L1.drop (k + 1) := List.drop_eq_getElem_cons hk1
    have dd2 : L2.drop k = L2[k] :: L2.drop (k + 1) := List.drop_eq_getElem_cons hk2
    have tk1 := take_succ_of_lt L1 k hk1
    have tk2 := take_succ_of_lt L2 k hk2
    have hlt : (L1.take k).length = (L2.take k).length := by simp; omega
    obtain ⟨t, ht⟩ : ∃ t, t = withCtr c s N k (lSt A1 A2 B1 B2 e1 e2 d1 d2 f1 f2 s L1 L2 R1 R2 k) :=
      ⟨_, rfl⟩
    rw [← ht]
    have tA1 : t.G A1 = e1 L1[k] ++ ((L1.drop (k + 1)).flatMap e1 ++ R1) := by
      rw [ht]; simp only [withCtr, lSt, IState.upd_G, a1c, a12, a1b1, a1b2, if_false, if_true]
      rw [dd1, List.flatMap_cons, List.append_assoc]
    have tA2 : t.G A2 = e2 L2[k] ++ ((L2.drop (k + 1)).flatMap e2 ++ R2) := by
      rw [ht]; simp only [withCtr, lSt, IState.upd_G, a2c, a2b1, a2b2, if_false, if_true]
      rw [dd2, List.flatMap_cons, List.append_assoc]
    have tB1 : t.G B1 = ((List.zipWith f1 (L1.take k) (L2.take k)).flatMap d1).reverse ++
        s.G B1 := by
      simp [ht, withCtr, lSt, b1c, b1b2]
    have tB2 : t.G B2 = ((List.zipWith f2 (L1.take k) (L2.take k)).flatMap d2).reverse ++
        s.G B2 := by
      simp [ht, withCtr, lSt, b2c]
    have tfr : ∀ j, j ∉ [A1, A2, B1, B2, c] → t.G j = s.G j := by
      intro j hj
      simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hj
      simp [ht, withCtr, lSt, hj.1, hj.2.1, hj.2.2.1, hj.2.2.2.1, hj.2.2.2.2]
    obtain ⟨hr, hok, hc⟩ := hb L1[k] (List.getElem_mem hk1) L2[k] (List.getElem_mem hk2) t _ _ _ _
      tfr tA1 tA2 tB1 tB2
    refine ⟨?_, hok, hc⟩
    rw [hr]
    apply IState.ext' _ (by simp [ht, withCtr, lSt]) (by simp [ht, withCtr, lSt])
    intro j
    simp only [IState.upd_G]
    by_cases jc : j = c
    · rw [jc]
      simp [ht, withCtr, lSt, Ne.symm a1c, Ne.symm a2c, Ne.symm b1c, Ne.symm b2c]
    by_cases jB2 : j = B2
    · subst jB2
      simp only [if_pos rfl, tB2, withCtr, lSt, IState.upd_G, if_neg b2c, if_pos rfl, tk1, tk2]
      rw [List.zipWith_append hlt]
      simp
    by_cases jB1 : j = B1
    · subst jB1
      simp only [if_pos rfl, if_neg b1b2, tB1, withCtr, lSt, IState.upd_G, if_neg b1c, tk1, tk2]
      rw [List.zipWith_append hlt]
      simp
    by_cases jA2 : j = A2
    · subst jA2
      simp [withCtr, lSt, a2c, a2b1, a2b2]
    by_cases jA1 : j = A1
    · subst jA1
      simp [withCtr, lSt, a1c, a12, a1b1, a1b2]
    simp [ht, withCtr, lSt, jc, jB2, jB1, jA2, jA1]
  refine ⟨{ nonneg := by rw [hn]; omega
            hw := hw
            h0 := ?_
            hG := fun k => by simp [lSt, Ne.symm a1c, Ne.symm a2c, Ne.symm b1c, Ne.symm b2c]
            step := fun k hk => by rw [hN] at hk ⊢; exact (key k hk).1 }, ?_⟩
  · apply IState.ext' _ (by simp [lSt]) (by simp [lSt])
    intro j
    simp only [lSt, IState.upd_G, List.drop_zero, List.take_zero, List.zipWith_nil_left,
      List.flatMap_nil, List.reverse_nil, List.nil_append]
    split_ifs <;> simp_all
  · intro k hk; exact ⟨(key k hk).2.1, (key k hk).2.2⟩

/-- **Generic stream loop.** -/
theorem loop_spec (M : MulSpec) (b : RM) (A1 A2 B1 B2 c : Fin HS) (e1 : α1 → List Item)
    (e2 : α2 → List Item) (d1 : β1 → List Item) (d2 : β2 → List Item) (f1 : α1 → α2 → β1)
    (f2 : α1 → α2 → β2) (s : IState HS) (L1 : List α1) (L2 : List α2) (R1 R2 : List Item)
    (C N Bc : ℕ) (n : Ex HS)
    (hd : [A1, A2, B1, B2, c].Nodup) (h1 : s.G A1 = L1.flatMap e1 ++ R1)
    (h2 : s.G A2 = L2.flatMap e2 ++ R2) (hl1 : L1.length = N) (hl2 : L2.length = N)
    (hn : n.eval s = N) (hw : c ∉ b.writes)
    (hb : BodyOK M b A1 A2 B1 B2 c e1 e2 d1 d2 f1 f2 s L1 L2 C)
    (hc56 : c.val < 56) (hnc : n.Clean) (hno : n.ok s) (hnl : n.Lin) (hnB : n.Bnd s Bc) :
    (RM.rep c n b).run s =
      (((s.upd A1 R1).upd A2 R2).upd B1
        (((List.zipWith f1 L1 L2).flatMap d1).reverse ++ s.G B1)).upd B2
        (((List.zipWith f2 L1 L2).flatMap d2).reverse ++ s.G B2) ∧
    (RM.rep c n b).ok M s ∧
    (RM.rep c n b).cost M s ≤ (n.size + 1) * 2000 * (Bc + 2) +
      N * (C + 8000 * (Bc + 2) + 30) + 32 := by
  obtain ⟨H, Hk⟩ := lSt_states M b A1 A2 B1 B2 c e1 e2 d1 d2 f1 f2 s L1 L2 R1 R2 C N n hd h1 h2
    hl1 hl2 hn hw hb
  have hN : (n.eval s).toNat = N := by rw [hn]; simp
  refine ⟨?_, ?_, ?_⟩
  · rw [H.run, hN]
    simp only [lSt]
    rw [List.drop_of_length_le (by omega), List.drop_of_length_le (by omega),
      List.take_of_length_le (by omega), List.take_of_length_le (by omega)]
    simp
  · exact H.ok hc56 hnc hno (fun k hk => by rw [hN] at hk ⊢; exact (Hk k hk).1)
  · have := RM.RepStates.cost_le_lin H Bc C hnl hnB
      (fun k hk => by rw [hN] at hk ⊢; exact (Hk k hk).2)
    rw [hN] at this; exact this

end Generic

section Wrappers

variable {α α2 β β2 : Type*}

theorem zipWith_replicate_right {α γ : Type*} (f : α → Unit → γ) (L : List α) (N : ℕ)
    (h : L.length = N) : List.zipWith f L (List.replicate N ()) = L.map (fun x => f x ()) := by
  subst h
  induction L with
  | nil => rfl
  | cons a L ih => simp [List.replicate_succ, ih]

end Wrappers

end NLogN.GL

end

section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.GL
open IntMul NLogN
variable {α α2 β β2 : Type*}
theorem solution (M : NLogN.MulSpec) (b : NLogN.RM) (A B c dA dB : Fin NLogN.HS) (e : α → List NLogN.Item)
    (d : β → List NLogN.Item) (f : α → β) (s : NLogN.IState NLogN.HS) (L : List α) (R : List NLogN.Item)
    (C N Bc : ℕ) (n : NLogN.Ex NLogN.HS)
    (hd : [A, dA, B, dB, c].Nodup) (h1 : s.G A = L.flatMap e ++ R) (hl : L.length = N)
    (hn : n.eval s = N) (hw : c ∉ b.writes)
    (hb : ∀ x ∈ L, ∀ (t : NLogN.IState NLogN.HS) (r o : List NLogN.Item),
      (∀ j, j ∉ [A, dA, B, dB, c] → t.G j = s.G j) →
      t.G A = e x ++ r → t.G B = o ++ s.G B →
      b.run t = (t.upd A r).upd B ((d (f x)).reverse ++ t.G B) ∧ b.ok M t ∧ b.cost M t ≤ C)
    (hc56 : c.val < 56) (hnc : n.Clean) (hno : n.ok s) (hnl : n.Lin) (hnB : n.Bnd s Bc) :
    (NLogN.RM.rep c n b).run s = (s.upd A R).upd B (((L.map f).flatMap d).reverse ++ s.G B) ∧
    (NLogN.RM.rep c n b).ok M s ∧
    (NLogN.RM.rep c n b).cost M s ≤ (n.size + 1) * 2000 * (Bc + 2) +
      N * (C + 8000 * (Bc + 2) + 30) + 32 := by
  have H := NLogN.GL.loop_spec M b A dA B dB c e (fun (_ : Unit) => []) d (fun (_ : Unit) => [])
    (fun x _ => f x) (fun _ _ => ()) s L (List.replicate N ()) R (s.G dA) C N Bc n hd h1
    (by simp) hl (by simp) hn hw ?_ hc56 hnc hno hnl hnB
  · rw [NLogN.GL.zipWith_replicate_right _ L N hl, NLogN.GL.zipWith_replicate_right _ L N hl] at H
    refine ⟨?_, H.2⟩
    rw [H.1]
    apply NLogN.IState.ext' _ (by simp) (by simp)
    intro j
    simp only [NLogN.IState.upd_G, List.flatMap_map, List.flatMap_nil, List.reverse_nil,
      List.nil_append]
    split_ifs <;> simp_all
  · intro x hx y _ t r1 r2 o1 o2 hfr hA hA2 hB _
    simp only [List.nil_append] at hA2
    obtain ⟨e1, e2, e3⟩ := hb x hx t r1 o1 hfr hA hB
    refine ⟨?_, e2, e3⟩
    rw [e1]
    clear e1 e2 e3 hfr hb
    simp only [List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false, not_or,
      List.nodup_nil, and_true] at hd
    apply NLogN.IState.ext' _ (by simp) (by simp)
    intro j
    simp only [NLogN.IState.upd_G, List.nil_append, List.reverse_nil]
    split_ifs <;> simp_all
end
