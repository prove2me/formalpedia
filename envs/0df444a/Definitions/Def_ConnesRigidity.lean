    {I : Type u} {V : Type v} [NormedAddCommGroup V] [NormedSpace ℝ V]
    (orbit : I → V)
    (hzero : (0 : V) ∈ closedConvexHull ℝ (Set.range orbit))
    {ε : ℝ} (hε : 0 < ε) :
    ∃ (s : Finset I) (w : I → ℝ),
      (∀ i ∈ s, 0 ≤ w i) ∧
      (∑ i ∈ s, w i) = 1 ∧
      ‖∑ i ∈ s, w i • orbit i‖ < ε := by
  simpa using
    exists_finset_affineCombination_approx_of_mem_closedConvexHull
      orbit hzero hε
