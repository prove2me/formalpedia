-- Source module: Solutions.AModelL12
/-!
# Lemma 12 (arbitrary-width interchange), array model: the procedure and its denotation

Radix-`q` layer. The array lives on `qShape Pre G Suf q e = Pre ++ [q]*e ++ G ++ [q]*e ++ Suf`
(prefix, chunk `h`, gap, chunk `d`, suffix; the chunks are `e` radix-`q` digits each).
The procedure `l12q` (paper, proof of Lemma 12):
1. interchange the top `ρ` digits of the two chunks one pair at a time (`highSwaps`, `ρ` primitive
   single-digit swaps);
2. join: move `h⁺` next to `d⁺` (a field rotation; the result lives on `joinShape`);
3. reshape (free): prefix ↦ one field `P = vol Pre`, `d⁺h⁺` ↦ one row field `R = q^(2ρ)`;
4. pad the row field to `R' = padRows W Kp R` (a multiple of `W ^ Kp`, zero rows appended);
5. write `n = e - ρ` in base `m` and call the Prop. 11 oracle `child j` on each corresponding pair of
   pieces of width `m ^ j` (`pieceLevels`, `runPieces`), all with the shared row field `R'`;
6. unpad (scan away the padded rows), reshape back, reverse the joining rotation.
If `ρ > e` (bounded widths) the procedure does `e` single-digit interchanges instead.

Main theorem `l12q_correct`: for every Prop.-11 oracle `child` satisfying the block-swap spec
(as `prop11`'s first conjunct gives it, when `W ^ j ∣ rows`), `l12q` is the pull by the full
chunk interchange `blockSwap a (a + e + |G|) e`.

Binary layer (`l12bin`): pad each `[2^u]` chunk numerically to `[q^e]` (`embed`, zero outside),
run `l12q` on the radix-`q` digits (reshape is free), extract. `l12bin_correct`: the result is
the pull by the single-field interchange `swapPos a (a + 1 + |G|)` on
`Pre ++ [2^u] ++ G ++ [2^u] ++ Suf` — the paper's `(p,h,g,d,z) ↦ (p,d,g,h,z)`.
-/

namespace AModelL12

open AModel

/-! ## 1. Shapes -/

section Shapes

/-- `[q]*n ++ G ++ [q]*n ++ Suf`: the two remaining chunks with the gap and suffix. -/
def restShape (G Suf : Shape) (q n : ℕ) : Shape :=
  List.replicate n q ++ (G ++ (List.replicate n q ++ Suf))

/-- The radix-`q` shape `Pre ++ [q]*e ++ G ++ [q]*e ++ Suf`. -/
def qShape (Pre G Suf : Shape) (q e : ℕ) : Shape := Pre ++ restShape G Suf q e

/-- The shape after joining: `Pre ++ (d⁺ h⁺) ++ h⁻ ++ G ++ d⁻ ++ Suf` (all digits of size `q`). -/
def joinShape (Pre G Suf : Shape) (q ρ n : ℕ) : Shape :=
  (Pre ++ List.replicate (ρ + ρ) q) ++ restShape G Suf q n

/-- The shape with a single prefix field `P`, a row field `R`, and the remaining chunks. -/
def rowShape (P R : ℕ) (G Suf : Shape) (q n : ℕ) : Shape := P :: R :: restShape G Suf q n

/-- Row count padded to the next multiple of `W ^ K`. -/
def padRows (W K R : ℕ) : ℕ := W ^ K * ((R + W ^ K - 1) / W ^ K)

end Shapes

/-! ## 2. The pieces -/

section PiecesDef

/-- The piece levels: `digit m n j` pieces of width `m ^ j` for every base-`m` digit position `j`. -/
def pieceLevels (m n : ℕ) : List ℕ :=
  (List.range (Nat.digits m n).length).flatMap fun j => List.replicate (digit m n j) j

end PiecesDef

/-! ## 3. The procedure -/

section Procedure

variable {α : Type*}

/-- The oracle type: `child j P L A B Cs` acts on `P :: L :: hdShape A B Cs (m ^ j) q`
(the signature of `prog C q`). -/
abbrev Oracle (α : Type*) := ℕ → ℕ → ℕ → Shape → Shape → Shape → List α → List α

/-- The oracle specification (`prop11`'s first conjunct): at every level `j ≤ K`, with `W ^ j`
dividing the row count, the call is the block swap of the two `m ^ j`-digit chunks. -/
def OracleSpec (child : Oracle α) (d : α) (W m q K : ℕ) : Prop :=
  ∀ j ≤ K, ∀ (P L : ℕ) (A B Cs : Shape) (ys : List α), W ^ j ∣ L →
    ys.length = vol (P :: L :: hdShape A B Cs (m ^ j) q) →
    child j P L A B Cs ys =
      pull (P :: L :: hdShape A B Cs (m ^ j) q) (P :: L :: hdShape A B Cs (m ^ j) q)
        (blockSwap (A.length + 2) (A.length + B.length + m ^ j + 2) (m ^ j)) d ys

/-- `r` primitive single-digit interchanges of positions `i + t ↔ j + t`, `t < r`. -/
def highSwaps (sh : Shape) (i j r : ℕ) (d : α) (xs : List α) : List α :=
  (List.range r).foldl (fun ys t => pull sh sh (swapPos (i + t) (j + t)) d ys) xs

/-- The call on the piece at offset `o` of level `j` (width `m ^ j`): prefix `P`, rows `R'`,
`A = [q]*o`, `B = [q]*(n-o-m^j) ++ G ++ [q]*o`, `Cs = [q]*(n-o-m^j) ++ Suf`. -/
def pieceStep (child : Oracle α) (P R' : ℕ) (G Suf : Shape) (q m n o j : ℕ) (ys : List α) :
    List α :=
  child j P R' (List.replicate o q)
    (List.replicate (n - o - m ^ j) q ++ (G ++ List.replicate o q))
    (List.replicate (n - o - m ^ j) q ++ Suf) ys

/-- **The radix-`q` procedure of Lemma 12.** -/
noncomputable def l12q (child : Oracle α) (W m q Kp ρ : ℕ) (Pre G Suf : Shape) (e : ℕ) (d : α)
    (xs : List α) : List α :=
  if ρ ≤ e then
    let a := Pre.length
    let g := G.length
    let n := e - ρ
    let sh0 := qShape Pre G Suf q e
    let sh1 := joinShape Pre G Suf q ρ n
    let S := rowShape (vol Pre) (q ^ (ρ + ρ)) G Suf q n
    let R' := padRows W Kp (q ^ (ρ + ρ))
    let T := rowShape (vol Pre) R' G Suf q n
    let xs1 := highSwaps sh0 a (a + e + g) ρ d xs
    let xs2 := pull sh0 sh1 (permIdx (rotIdx (a + ρ) ρ (n + g))) d xs1
    let xs3 := AModelL12.embed S T d xs2
    let xs4 := runPieces (pieceStep child (vol Pre) R' G Suf q m n) (fun j => m ^ j) 0
      (pieceLevels m n) xs3
    let xs5 := extract S T d xs4
    pull sh1 sh0 (permIdx (rotIdx (a + ρ) (n + g) ρ)) d xs5
  else
    highSwaps (qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) e d xs

end Procedure

/-! ## 4. Correctness -/

section Correct

variable {α : Type*}

end Correct

/-! ## 5. Binary chunks: numeric padding `[2^u] → [q^e]` -/

section Binary

variable {α : Type*}

/-- `Pre ++ [F] ++ G ++ [F] ++ Suf`: the two chunks as single fields of size `F`. -/
def binShape (Pre G Suf : Shape) (F : ℕ) : Shape := Pre ++ (F :: (G ++ (F :: Suf)))

/-- **The binary procedure of Lemma 12**: pad both `[2^u]` chunks numerically to `[q^e]` (zero
outside), run the radix-`q` procedure on the digits (reshape is free), scan away the padding. -/
noncomputable def l12bin (child : Oracle α) (W m q Kp ρ e u : ℕ) (Pre G Suf : Shape) (d : α)
    (xs : List α) : List α :=
  extract (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (q ^ e)) d
    (l12q child W m q Kp ρ Pre G Suf e d
      (AModelL12.embed (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (q ^ e)) d xs))

end Binary

end AModelL12

end

section
-- Source module: Solutions.AModelL12Cost
/-!
# Lemma 12 (arbitrary-width interchange), array model: cost

Cost model (analogous to `progCost`): every primitive pass over the array is charged `c · V`
(`V` its current volume): each of the `ρ` single-digit swaps, each of the `ρ` single-field moves
of the joining and of the separating rotation, the row padding and unpadding (on the padded
volume `V'`). Each Prop. 11 call on a piece of level `j` costs `Tc j V'` (oracle cost at the
padded volume). The fallback (`ρ > e`) costs `e` passes.

* `l12qCost_le`: if `Tc j V ≤ K₀ V (m^j)^τ`, `W ^ Kp ≤ q^(2ρ)` (so `V' < 2V`) and `ρ ≤ D e^τ`,
  then `l12qCost ≤ K'' V e^τ` with `K''` depending only on `m, τ, K₀, c, D`.
* `clog_le_rpow`: `⌈log_m e⌉ ≤ C e^τ`, so `ρ = ρ₀ ⌈log_m e⌉` satisfies the hypothesis.
* `l12binCost`: adds the binary padding / extraction passes.
-/

namespace AModelL12

open AModel Finset

section Cost

/-- **Cost model of `l12q`.** `V = vol (qShape …)`, `V' = vol` of the padded row shape. -/
noncomputable def l12qCost (Tc : ℕ → ℝ → ℝ) (c : ℝ) (W m q Kp ρ : ℕ) (Pre G Suf : Shape)
    (e : ℕ) : ℝ :=
  if ρ ≤ e then
    -- `ρ` single-digit swaps, `ρ` joining moves
    c * (vol (qShape Pre G Suf q e) : ℝ) * ρ + c * (vol (qShape Pre G Suf q e) : ℝ) * ρ +
    -- padding
    c * (vol (rowShape (vol Pre) (padRows W Kp (q ^ (ρ + ρ))) G Suf q (e - ρ)) : ℝ) +
    -- the Prop. 11 calls on the pieces
    ((pieceLevels m (e - ρ)).map fun j =>
      Tc j (vol (rowShape (vol Pre) (padRows W Kp (q ^ (ρ + ρ))) G Suf q (e - ρ)) : ℝ)).sum +
    -- unpadding, `ρ` separating moves
    c * (vol (rowShape (vol Pre) (padRows W Kp (q ^ (ρ + ρ))) G Suf q (e - ρ)) : ℝ) +
    c * (vol (qShape Pre G Suf q e) : ℝ) * ρ
  else c * (vol (qShape Pre G Suf q e) : ℝ) * e

/-- **Cost model of the binary layer**: the padding and extraction passes (on the padded
volume `vol (binShape … (q^e)) = vol (qShape … e)`) plus the radix-`q` procedure. -/
noncomputable def l12binCost (Tc : ℕ → ℝ → ℝ) (c : ℝ) (W m q Kp ρ e : ℕ)
    (Pre G Suf : Shape) : ℝ :=
  c * (vol (binShape Pre G Suf (q ^ e)) : ℝ) + l12qCost Tc c W m q Kp ρ Pre G Suf e +
    c * (vol (binShape Pre G Suf (q ^ e)) : ℝ)

end Cost

end AModelL12

end

section
-- Source module: Solutions.AModelRat
/-!
# Proposition 11 for circuits with rational labels

The paper's circuit (Prop. 7) has rational labels (projections `P_U` with denominators). This
file proves Prop. 11 for a circuit `QCircuit R m W` whose labels are `Matrix (Fin m) (Fin m) ℚ`.

Route (scaling, with a scaled frame action): let `D` be a common denominator of all labels.
The integer circuit `C.toCircuit Q` has labels `D • M` (exact integers, `intM`), so every integer
frame change is exactly `D • A_e` (`A_e` the rational frame change) and the endpoint differences
are exactly `I0 = D • 1` over `ℤ`. The frame action at field size `N` is `φ_N X = D⁻¹ • (X mod N)`
(`phiD`), with `φ_N I0 = 1` and `φ_N (D • A) = A mod N`. The Lemma 10 data of an integer frame
change `X` is the lift mod `Q = q ^ m ^ K` of the rational Bruhat factorization of
`D⁻¹ • X = A_e` (`facD`). The correctness chain of `AModelFac` is re-proved with a general
additive frame action `φ` (`FacAtφ`, `OKφ`, `implΦ_eqφ`, ..., `prog_correctφ`); the cost chain
is reused unchanged (`prog_costZ`, `levelCost_eqZ`).

1. Rational Lemma 9 for rational matrices (`ratFacQ`, `facQ`), the bridge `facAtφ_facD`.
2. Pair-level frame bookkeeping (`FramesOK2`, `frameSum2`) and label maps.
3. The chain with a general frame action.
4. `QCircuit`, `QCircuit.toCircuit`, and `prop11_ratLabels`.
-/

namespace AModelRat

open Matrix AModel AModelFac

/-! ## 1. Rational factorizations of rational matrices; the bridge -/

section RatFac

variable {m : ℕ}

lemma exists_ratFacQ (A : QMat m) : ∃ F, RatFacSpec A F := by
  obtain ⟨E₁, P, E₂, h⟩ := bruhat_lower A
  exact ⟨(E₁, P, E₂), h⟩

/-- The rational Lemma 9 factorization of a rational matrix, chosen once. -/
noncomputable def ratFacQ (A : QMat m) : QMat m × QMat m × QMat m := (exists_ratFacQ A).choose

/-- `q` avoids the denominators of `A` and is good for `ratFacQ A`. -/
def GoodAtQ (q : ℕ) (A : QMat m) : Prop :=
  (∀ i j, Nat.Coprime (A i j).den q) ∧ GoodAt q (ratFacQ A)

/-- A bound beyond which every prime is good for `A`. -/
noncomputable def facBoundQ (A : QMat m) : ℕ :=
  (∑ i, ∑ j, (((ratFacQ A).1 i j).den + ((ratFacQ A).2.2 i j).den + (A i j).den)) +
  ∑ i, (((ratFacQ A).1 i i).num.natAbs + ((ratFacQ A).2.2 i i).num.natAbs)

/-- The `Π` of `ratFacQ A` as an integer `0/1` matrix. -/
noncomputable def piQ (A : QMat m) : IMat m :=
  fun i j => if (ratFacQ A).2.1 i j = 1 then 1 else 0

/-- Lemma 10 data at modulus `Q` for the rational matrix `A`. -/
noncomputable def facQ (Q : ℕ) (A : QMat m) : IMat m × IMat m × IMat m :=
  ((ratFacQ A).1.map (liftZ Q), piQ A, (ratFacQ A).2.2.map (liftZ Q))

/-- Lemma 10 data of an integer frame change `X = D • A`: that of `A = D⁻¹ • X`. -/
noncomputable def facD (Q D : ℕ) (X : IMat m) : IMat m × IMat m × IMat m :=
  facQ Q ((D : ℚ)⁻¹ • ratM X)

/-- The scaled frame action `X ↦ D⁻¹ • (X mod N)`. -/
noncomputable def phiD (N D : ℕ) : IMat m →+ Matrix (Fin m) (Fin m) (ZMod N) where
  toFun X := ((D : ZMod N)⁻¹) • castM N X
  map_zero' := by ext i j; simp [castM]
  map_add' X Y := by ext i j; simp [castM, mul_add]

/-- Lemma 10 data mod `N` for a general additive frame action `φ`: as `FacAtZ`, with the
identity `φ A = E₁ Π E₂` in `ZMod N`. -/
def FacAtφ (N : ℕ) (φ : IMat m →+ Matrix (Fin m) (Fin m) (ZMod N))
    (fac : IMat m → IMat m × IMat m × IMat m) (A : IMat m) : Prop :=
  (∀ i j, i < j → (fac A).1 i j = 0) ∧ (∀ i j, i < j → (fac A).2.2 i j = 0) ∧
  (∀ i, IsUnit (((fac A).1 i i : ℤ) : ZMod N)) ∧ (∀ i, IsUnit (((fac A).2.2 i i : ℤ) : ZMod N)) ∧
  (∀ i j, (fac A).2.1 i j = 0 ∨ (fac A).2.1 i j = 1) ∧
  φ A = castM N (fac A).1 * castM N (fac A).2.1 * castM N (fac A).2.2

end RatFac

/-! ## 2. Pair-level frame bookkeeping -/

section Pairs

variable {Wr R M M' : Type*} [Fintype Wr] [DecidableEq Wr]

/-- `FramesOK` on (new label, old label) pairs. -/
def FramesOK2 (Pr : M → M → Prop) : List (NGate Wr R M) → (Wr → M) → (Wr → M) → Prop
  | [], lab, Mout => ∀ w, Pr (Mout w) (lab w)
  | g :: gs, lab, Mout => (∀ w ∈ g.2.1, Pr g.2.2 (lab w)) ∧ FramesOK2 Pr gs (labStep lab g) Mout

/-- `frameSum` on pairs. -/
def frameSum2 {β : Type*} [AddCommMonoid β] (F : M → M → β) :
    List (NGate Wr R M) → (Wr → M) → (Wr → M) → β
  | [], lab, Mout => ∑ w, F (Mout w) (lab w)
  | g :: gs, lab, Mout => (∑ w ∈ g.2.1, F g.2.2 (lab w)) + frameSum2 F gs (labStep lab g) Mout

/-- Relabel the gates by `f`. -/
def mapG (f : M → M') (gates : List (NGate Wr R M)) : List (NGate Wr R M') :=
  gates.map fun g => (g.1, g.2.1, f g.2.2)

omit [Fintype Wr] in
lemma framesOK2_mono {P P' : M → M → Prop} (h : ∀ a b, P a b → P' a b) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      FramesOK2 P gates lab Mout → FramesOK2 P' gates lab Mout := by
  intro gates
  induction gates with
  | nil => intro lab Mout hF w; exact h _ _ (hF w)
  | cons g gs ih => intro lab Mout hF; exact ⟨fun w hw => h _ _ (hF.1 w hw), ih _ _ hF.2⟩

end Pairs

/-! ## 3. The correctness chain with a general frame action -/

section Level

variable {R : Type*} [CommRing R] {m W : ℕ}

/-- The circuit hypotheses at field size `N` with frame action `φ` and endpoint difference `I0`
(`φ I0 = 1`). -/
structure OKφ (C : Circuit R m W) (N : ℕ) (φ : IMat m →+ Matrix (Fin m) (Fin m) (ZMod N))
    (I0 : IMat m) : Prop where
  gatesOK : ∀ g ∈ C.gates, g.OK
  route : ∀ (v : Fin W → R) w, scalarRun C.gates v (C.ρ w) = v w
  unit : ∀ w, C.Mout (C.ρ w) - C.Min w = I0
  one : φ I0 = 1
  frames : FramesOK (FacAtφ N φ C.fac) C.gates C.Min C.Mout

variable (C : Circuit R m W) {N : ℕ} [NeZero N] (P L' : ℕ) (A B Cs : Shape)

variable [NeZero W]

end Level

section Recursion

variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]

end Recursion

/-! ## 4. Rational-label circuits and Proposition 11 -/

section QCirc

variable {m : ℕ}

/-- Product of the denominators of the entries of `M`. -/
def matDen (M : QMat m) : ℕ := ∏ i, ∏ j, (M i j).den

/-- All denominators of `M` divide `D`. -/
def LabOK (D : ℕ) (M : QMat m) : Prop := ∀ i j, (M i j).den ∣ D

/-- The integer matrix `D • M` (exact when `LabOK D M`). -/
def intM (D : ℕ) (M : QMat m) : IMat m := fun i j => ((D : ℚ) * M i j).num

end QCirc

/-- A circuit with **rational** matrix labels (the paper's Prop. 7 circuit): gates on `W` wires
with labels in `Matrix (Fin m) (Fin m) ℚ`, input/output labels, and the routing `ρ`. -/
structure QCircuit (R : Type*) [CommRing R] (m W : ℕ) where
  gates : List (NGate (Fin W) R (QMat m))
  Min : Fin W → QMat m
  Mout : Fin W → QMat m
  ρ : Fin W → Fin W

namespace QCircuit

variable {R : Type*} [CommRing R] {m W : ℕ}

/-- A common denominator of all labels. -/
def den (C : QCircuit R m W) : ℕ :=
  (C.gates.map fun g => matDen g.2.2).prod * (∏ w, matDen (C.Min w)) * ∏ w, matDen (C.Mout w)

/-- **The integer circuit run by the program at modulus `Q`**: labels `D • M` (`D = C.den`),
Lemma 10 data `facD Q D` (lifts mod `Q` of the rational Bruhat factors of `D⁻¹ • X`). -/
noncomputable def toCircuit (C : QCircuit R m W) (Q : ℕ) : Circuit R m W where
  gates := mapG (intM C.den) C.gates
  Min w := intM C.den (C.Min w)
  Mout w := intM C.den (C.Mout w)
  ρ := C.ρ
  fac := facD Q C.den

end QCircuit

section Main

variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]

end Main

end AModelRat

