-- title:
--   (IPAHD), p. 11, and (9), proof of Theorem 4, p. 12 — µ_k, y_k, runs of (IPAHD), δ_k, C_k, v_k and E_k
-- statement:
--   This file fixes the objects of §3.1.1 of Attouch, Chbani, Fadili and Riahi on the **Inertial Proximal Algorithm with Hessian Damping** (IPAHD).
--
--   Let $\mathcal H$ be a real Hilbert space, $f:\mathcal H\to\mathbb R$, $\alpha\in\mathbb R$, a step size $h>0$ with $s=h^2$, and two real sequences $(\beta_k)_{k\in\mathbb N}$, $(b_k)_{k\in\mathbb N}$.
--
--   1. **Step parameter.** $\mu_k:=\dfrac{k}{k+\alpha}\big(\beta_k\sqrt s+s\,b_k\big)$.
--   2. **Extrapolated point.** For a sequence $(x_k)_{k\in\mathbb N}$ in $\mathcal H$,
--   $$y_k=x_k+\Big(1-\frac{\alpha}{k+\alpha}\Big)(x_k-x_{k-1})+\beta_k\sqrt s\Big(1-\frac{\alpha}{k+\alpha}\Big)\nabla f(x_k).$$
--   3. **Runs of (IPAHD).** $(x_k)$ is generated by (IPAHD) if for every $k\ge1$
--   $$x_{k+1}=\mathrm{prox}_{\mu_k f}(y_k),\qquad\text{i.e. } x_{k+1}\text{ minimizes } z\mapsto \mu_k f(z)+\tfrac12\|z-y_k\|^2 .$$
--   4. **The sequence (9).** $\delta_k:=h\big(b_khk-\beta_{k+1}-k(\beta_{k+1}-\beta_k)\big)(k+1)$.
--   5. **Proof quantities of Theorem 4.** For a point $x^\star\in\mathcal H$:
--   $C_k=\beta_{k+1}+k(\beta_{k+1}-\beta_k)-b_khk$,
--   $v_k:=(\alpha-1)(x_k-x^\star)+k\big(x_k-x_{k-1}+\beta_kh\nabla f(x_k)\big)$, and
--   $$E_k:=\delta_k\big(f(x_k)-f(x^\star)\big)+\tfrac12\|v_k\|^2 .$$
--
--   (IPAHD) is the implicit time discretization of the inertial dynamic with Hessian-driven damping $\ddot x+\frac{\alpha}{t}\dot x+\beta(t)\nabla^2f(x)\dot x+b(t)\nabla f(x)=0$; $E_k$ is the discrete Lyapunov function used to prove its convergence rate.
--
--   **Formalization Note.** The proximal step is the published predicate `GoldenRatioVI.Shared.IsProxPoint`, applied to the real-valued function $z\mapsto\mu_kf(z)$ cast to `EReal`; no proximal *function* is defined. $\nabla f$ is Mathlib's `gradient f`. The recursion is required for $k\ge1$ only, with $x_0,x_1$ free: at $k=0$ the page's step gives $\mu_0=0$ and $y_0=x_0$, hence $x_1=x_0$, so leaving $x_1$ free is more general; in $y_k$ and $v_k$ the index $k-1$ is natural-number subtraction and is never read at $k=0$ by the theorems of this mission. $\sqrt s$ is `Real.sqrt s`, written as on the page.
-- source:
--   Attouch, Chbani, Fadili, Riahi, First-order optimization algorithms via inertial systems with Hessian driven damping, arXiv:1907.10536v2, p. 11, (IPAHD) and (9); p. 12, proof of Theorem 4 (E_k, v_k, C_k)

import Mathlib
import Definitions.Def_GoldenRatioVI_Shared_IsProxPoint

namespace HessianDamping.IPAHD

open GoldenRatioVI.Shared

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The proximal parameter of step `k` of (IPAHD), p. 11:
`µ_k := k/(k+α) (β_k √s + s b_k)`. -/
noncomputable def muK (α s : ℝ) (β b : ℕ → ℝ) (k : ℕ) : ℝ :=
  ((k : ℝ) / ((k : ℝ) + α)) * (β k * Real.sqrt s + s * b k)

/-- The extrapolated point of step `k` of (IPAHD), p. 11:
`y_k = x_k + (1 - α/(k+α)) (x_k - x_{k-1}) + β_k √s (1 - α/(k+α)) ∇f(x_k)`. -/
noncomputable def yK (f : H → ℝ) (α s : ℝ) (β : ℕ → ℝ) (x : ℕ → H) (k : ℕ) : H :=
  x k + (1 - α / ((k : ℝ) + α)) • (x k - x (k - 1))
    + (β k * Real.sqrt s * (1 - α / ((k : ℝ) + α))) • gradient f (x k)

/-- `x : ℕ → H` is a run of (IPAHD), p. 11: for every `k ≥ 1`,
`x_{k+1} = prox_{µ_k f}(y_k)`, i.e. `x_{k+1}` minimizes `z ↦ µ_k f(z) + ½‖z - y_k‖²`.
The first two terms `x 0`, `x 1` are free. -/
def IsIPAHDRun (f : H → ℝ) (α s : ℝ) (β b : ℕ → ℝ) (x : ℕ → H) : Prop :=
  ∀ k : ℕ, 1 ≤ k →
    IsProxPoint (fun z => ((muK α s β b k * f z : ℝ) : EReal)) (yK f α s β x k) (x (k + 1))

/-- The sequence (9), p. 11: `δ_k := h (b_k h k - β_{k+1} - k (β_{k+1} - β_k)) (k + 1)`. -/
noncomputable def deltaK (h : ℝ) (β b : ℕ → ℝ) (k : ℕ) : ℝ :=
  h * (b k * h * k - β (k + 1) - k * (β (k + 1) - β k)) * ((k : ℝ) + 1)

/-- The coefficient of the proof of Theorem 4, p. 12:
`C_k = β_{k+1} + k (β_{k+1} - β_k) - b_k h k`. -/
noncomputable def CK (h : ℝ) (β b : ℕ → ℝ) (k : ℕ) : ℝ :=
  β (k + 1) + k * (β (k + 1) - β k) - b k * h * k

/-- The vector of the proof of Theorem 4, p. 12:
`v_k := (α - 1)(x_k - x⋆) + k (x_k - x_{k-1} + β_k h ∇f(x_k))`. -/
noncomputable def vK (f : H → ℝ) (α h : ℝ) (β : ℕ → ℝ) (x : ℕ → H) (xstar : H) (k : ℕ) : H :=
  (α - 1) • (x k - xstar) + (k : ℝ) • (x k - x (k - 1) + (β k * h) • gradient f (x k))

/-- The energy of the proof of Theorem 4, p. 12:
`E_k := δ_k (f(x_k) - f(x⋆)) + ½‖v_k‖²`. -/
noncomputable def EK (f : H → ℝ) (α h : ℝ) (β b : ℕ → ℝ) (x : ℕ → H) (xstar : H) (k : ℕ) : ℝ :=
  deltaK h β b k * (f (x k) - f xstar) + 1 / 2 * ‖vK f α h β x xstar k‖ ^ 2

end HessianDamping.IPAHD


