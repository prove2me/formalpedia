namespace QEC.Coding.BDL26RXLocalReplacement
theorem _root_.solution
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (copy : Two) (edge : XStarEdge P x)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    word (copy, Sum.inl (xStarEdgeEnd P x edge)) =
      word (copy, Sum.inl (xStarEdgeStart P x edge)) := by
  classical
  let path := rxSubdivisionSegmentPath P x S edge S.half (le_refl S.half)
  let lifted := UndirectedPath.map
    (edgeStart := subdivisionEdgeStart P x S)
    (edgeEnd := subdivisionEdgeEnd P x S)
    (edgeStart' := tannerDoubleCylinderEdgeStart P x S)
    (edgeEnd' := tannerDoubleCylinderEdgeEnd P x S)
    (fun vertex => (copy, vertex)) (fun localEdge => Sum.inl (copy, localEdge))
    (fun _ => rfl) (fun _ => rfl) path
  have hgraph : wordLinearMapTranspose
      (graphBoundary (tannerDoubleCylinderEdgeStart P x S)
        (tannerDoubleCylinderEdgeEnd P x S)) word = 0 := by
    change wordLinearMapTranspose (doubleCylinderGraphBoundary P x S) word = 0
    rw [doubleCylinderGraphBoundary_eq_boundary1]
    simpa [rxCx, doubleCylinderChainComplex] using hword
  have hpath := word_eq_root_of_graphCoboundary_eq_zero_of_path
    (tannerDoubleCylinderEdgeStart P x S)
    (tannerDoubleCylinderEdgeEnd P x S)
    (copy, Sum.inl (xStarEdgeStart P x edge))
    (copy, rxSubdivisionSegmentVertex P x S edge S.half (le_refl S.half))
    lifted word hgraph
  simpa [lifted, path, rxSubdivisionSegmentVertex, S.half_pos.ne'] using hpath
end QEC.Coding.BDL26RXLocalReplacement
