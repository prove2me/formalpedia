  have hAB1 : A1_num < B1_num := by unfold A1_num B1_num; omega
  have hAB2 : A2_num < B2_num := by unfold A2_num B2_num; omega
  let cell : ℕ × ℕ × ℕ → Set (Fin 3 → ℝ) := fun ⟨i, j, k⟩ =>
    box3 (((A0_num + i * h0 : ℕ) : ℝ) / D_den) (((A0_num + i * h0 + h0 : ℕ) : ℝ) / D_den)
         (((A1_num + j * h1 : ℕ) : ℝ) / D_den) (((A1_num + j * h1 + h1 : ℕ) : ℝ) / D_den)
         (((A2_num + k * h2 : ℕ) : ℝ) / D_den) (((A2_num + k * h2 + h2 : ℕ) : ℝ) / D_den)
  let idxSet : Finset (ℕ × ℕ × ℕ) :=
    (Finset.range N) ×ˢ ((Finset.range N) ×ˢ (Finset.range N))
  have hcell_sub : ∀ c ∈ idxSet,
      cell c ⊆ box3 ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den)
                    ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den)
                    ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den) := by
    rintro ⟨i, j, k⟩ hc x hx
    simp only [idxSet, Finset.mem_product, Finset.mem_range] at hc
    rcases hc with ⟨hi, hj, hk⟩
    simp only [cell, box3, mem_univ_pi] at hx ⊢
    intro d
    have h0_le : A0_num + i * h0 + h0 ≤ B0_num := nat_grid_step_le (le_of_lt hAB0) hh0_eq hi
    have h1_le : A1_num + j * h1 + h1 ≤ B1_num := nat_grid_step_le (le_of_lt hAB1) hh1_eq hj
    have h2_le : A2_num + k * h2 + h2 ≤ B2_num := nat_grid_step_le (le_of_lt hAB2) hh2_eq hk
    fin_cases d
    · have hx0 : x 0 ∈ Icc (((A0_num + i * h0 : ℕ) : ℝ) / D_den) (((A0_num + i * h0 + h0 : ℕ) : ℝ) / D_den) := by
        simpa using hx 0
      refine ⟨le_trans (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDpos)) hx0.1,
              le_trans hx0.2 (div_le_div_of_nonneg_right (by exact_mod_cast h0_le) (le_of_lt hDpos))⟩
    · have hx1 : x 1 ∈ Icc (((A1_num + j * h1 : ℕ) : ℝ) / D_den) (((A1_num + j * h1 + h1 : ℕ) : ℝ) / D_den) := by
        simpa using hx 1
      refine ⟨le_trans (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDpos)) hx1.1,
