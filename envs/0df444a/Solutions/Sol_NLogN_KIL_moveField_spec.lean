theorem swapF_spec (t : IState HS) (xs : List ℤ) (A F G C : Shape) (Bb : ℕ)
    (R L1 L2 L3 L4 : List Item)
    (hlen : xs.length = AModel.vol (A ++ F ++ G ++ C)) (hb : Bnd Bb xs)
    (hC1 : 1 ≤ AModel.vol C) (hG1 : 1 ≤ AModel.vol G) (hF1 : 1 ≤ AModel.vol F) (hA1 : 1 ≤ AModel.vol A)
    (hV : zsz ((AModel.vol A * (AModel.vol F * (AModel.vol G * AModel.vol C)) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = ints xs ++ R) (h1 : t.G 1 = .int (AModel.vol A) :: L1) (h2 : t.G 2 = .int (AModel.vol F) :: L2)
    (h3 : t.G 3 = .int (AModel.vol G) :: L3) (h4 : t.G 4 = .int (AModel.vol C) :: L4) :
    fwdP.ok t ∧ fwdP.run t = t.upd 0 (ints (AModel.pull (A ++ F ++ G ++ C) (A ++ G ++ F ++ C)
        (swapMid A.length F.length G.length) 0 xs) ++ R) ∧
      fwdP.cost t ≤ cMove (AModel.vol A) (AModel.vol F) (AModel.vol G) (AModel.vol C) Bb := by
  rw [pull_swapMid]
  exact fwdP_spec t xs _ _ _ _ Bb R L1 L2 L3 L4 (by rw [hlen]; simp [vol_append]; ring) hb hC1 hG1 hF1
    hA1 hV h0 h1 h2 h3 h4

end KIL

end NLogN

