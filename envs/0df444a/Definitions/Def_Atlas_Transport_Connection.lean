/-! ### Calculus assembly: the Christoffel transformation -/

section transform

variable {U V : Set (Pt n)} {Φ : Pt n → Pt n} {J K : Pt n → Matrix (Fin n) (Fin n) ℝ}
  {g gi h hi : Metric n}

/-- Proof-internal matrix `Cᵢ a j = Σ_{b e} J_{bi} J_{ej} Γ[h]_{a b e}(Φ y)` (pulled-back first-kind symbols). -/
noncomputable def pullC (h : Metric n) (Φ : Pt n → Pt n) (J : Pt n → Matrix (Fin n) (Fin n) ℝ)
    (y : Pt n) (i : Fin n) : Matrix (Fin n) (Fin n) ℝ :=
  Matrix.of fun a j => ∑ b, ∑ e, J y b i * J y e j * chr1 h a b e (Φ y)

end transform

