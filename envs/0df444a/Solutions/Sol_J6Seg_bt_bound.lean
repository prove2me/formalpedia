* `cpl_abs_le`, `ccOf_abs_le`: the coupling entries are `≤ 2^P + 1`, the window coefficients
  `≤ (2w+1)(2^P+1)`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

lemma fmul_abs_le (P : ℕ) (x y : ℤ) :
    |(fmul P x y : ℝ)| ≤ |(x : ℝ)| * |(y : ℝ)| / 2 ^ P + 1 / 2 := by
  have h := fmul_err P x y
  have hS := two_pow_pos' P
  have h2 : |(fmul P x y : ℝ) / 2 ^ P| ≤ |(x : ℝ)| * |(y : ℝ)| / 2 ^ P / 2 ^ P + 1 / (2 * 2 ^ P) := by
    have := abs_sub_abs_le_abs_sub ((fmul P x y : ℝ) / 2 ^ P) ((x : ℝ) / 2 ^ P * ((y : ℝ) / 2 ^ P))
    have e2 : |(x : ℝ) / 2 ^ P * ((y : ℝ) / 2 ^ P)| = |(x : ℝ)| * |(y : ℝ)| / 2 ^ P / 2 ^ P := by
      rw [abs_mul, abs_div, abs_div, abs_of_pos hS]; ring
    linarith
  rw [abs_div, abs_of_pos hS, div_le_iff₀ hS] at h2
  have e3 : (|(x : ℝ)| * |(y : ℝ)| / 2 ^ P / 2 ^ P + 1 / (2 * 2 ^ P)) * 2 ^ P =
      |(x : ℝ)| * |(y : ℝ)| / 2 ^ P + 1 / 2 := by field_simp
  linarith

section vals
variable {P : ℕ} {S : ℕ → ℕ → Prop} [DecidableRel S] {L : List ℕ} {A : ℕ → ℕ → ℤ} {η : ℝ}

/-- **The forward values.** -/
theorem bt_bound_sol_aux (h : ElimOK P S L A η) (b : ℕ → ℤ) {Zm : ℝ}
    (hz : ∀ k, |(geSolveS P S L A b k : ℝ)| ≤ Zm) {r : ℕ} (hr : r < L.length) :
    |(btV P S L A b r : ℝ)| ≤ 2 * Zm + 3 / 4 + L.length / 2 := by
  have hS := two_pow_pos' P
  have hZ0 : 0 ≤ Zm := le_trans (abs_nonneg _) (hz 0)
  have hcl := geSolveS_closed P S L A b h.nd r hr
  set bs := ∑ k' ∈ (L.drop (r + 1)).toFinset.filter (fun k' => S (L.getD r 0) k'),
    fmul P (Aseq P S L A r (L.getD r 0) k') (geSolveS P S L A b k') with hbs
  set pv := Aseq P S L A r (L.getD r 0) (L.getD r 0) with hpvd
  set x := bseq P S L A b r (L.getD r 0) - bs with hxd
  have hmr := getD_mem_drop (L := L) le_rfl hr
  have hpos : 0 < pv := aseq_piv_pos h hr.le hmr
  have hpvR : (0 : ℝ) < pv := by exact_mod_cast hpos
  have hpv : (pv : ℝ) ≤ 3 / 2 * 2 ^ P := le_trans (le_abs_self _) (aseq_abs_le h hr.le hmr hmr)
  have herr := fdiv_err P x hpos
  rw [← hcl] at herr
  have e1 : (x : ℝ) / 2 ^ P / ((pv : ℝ) / 2 ^ P) = (x : ℝ) / pv := by field_simp
  rw [e1] at herr
  have hzr := hz (L.getD r 0)
  have h1 : |(x : ℝ) / pv| ≤ (Zm + 1 / 2) / 2 ^ P := by
    have := abs_sub_abs_le_abs_sub ((x : ℝ) / pv) ((geSolveS P S L A b (L.getD r 0) : ℝ) / 2 ^ P)
    have e2 : |(geSolveS P S L A b (L.getD r 0) : ℝ) / 2 ^ P| =
        |(geSolveS P S L A b (L.getD r 0) : ℝ)| / 2 ^ P := by rw [abs_div, abs_of_pos hS]
    have e3 : (Zm + 1 / 2) / 2 ^ P = Zm / 2 ^ P + 1 / (2 * 2 ^ P) := by field_simp
    have h4 := div_le_div_of_nonneg_right hzr hS.le
    rw [abs_sub_comm] at herr
    linarith
  have hx : |(x : ℝ)| ≤ 3 / 2 * (Zm + 1 / 2) := by
    have e : |(x : ℝ)| = |(x : ℝ) / pv| * pv := by
      rw [abs_div, abs_of_pos hpvR]; field_simp
    rw [e]
    calc |(x : ℝ) / pv| * pv ≤ (Zm + 1 / 2) / 2 ^ P * (3 / 2 * 2 ^ P) :=
          mul_le_mul h1 hpv hpvR.le (by positivity)
      _ = 3 / 2 * (Zm + 1 / 2) := by field_simp
  have hbsb : |(bs : ℝ)| ≤ Zm / 2 + L.length / 2 := by
    rw [hbs, Int.cast_sum]
    refine (abs_sum_le_sum_abs _ _).trans ?_
    refine (sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun _ _ _ => abs_nonneg _)).trans ?_
    have hterm : ∀ k ∈ (L.drop (r + 1)).toFinset,
        |(fmul P (Aseq P S L A r (L.getD r 0) k) (geSolveS P S L A b k) : ℝ)| ≤
          |(Aseq P S L A r (L.getD r 0) k : ℝ)| * Zm / 2 ^ P + 1 / 2 := by
      intro k _
      have h2 := fmul_abs_le P (Aseq P S L A r (L.getD r 0) k) (geSolveS P S L A b k)
      have h3 : |(Aseq P S L A r (L.getD r 0) k : ℝ)| * |(geSolveS P S L A b k : ℝ)| ≤
          |(Aseq P S L A r (L.getD r 0) k : ℝ)| * Zm := mul_le_mul_of_nonneg_left (hz k) (abs_nonneg _)
      have h4 := div_le_div_of_nonneg_right h3 hS.le
      linarith
    refine (sum_le_sum hterm).trans ?_
    rw [sum_add_distrib, sum_const, nsmul_eq_mul, ← sum_div, ← sum_mul]
    have hoff := aseq_offsum h hr
    have hcard : (((L.drop (r + 1)).toFinset.card : ℕ) : ℝ) ≤ L.length := by
      have h5 := List.toFinset_card_le (L.drop (r + 1))
      rw [List.length_drop] at h5
      exact_mod_cast h5.trans (by omega)
    have h6 : (∑ k ∈ (L.drop (r + 1)).toFinset, |(Aseq P S L A r (L.getD r 0) k : ℝ)|) * Zm / 2 ^ P
        ≤ Zm / 2 := by
      rw [div_le_iff₀ hS]
      have := mul_le_mul_of_nonneg_right hoff hZ0
      have e : 2 ^ P / 2 * Zm = Zm / 2 * 2 ^ P := by ring
      linarith
    linarith
  have e : (btV P S L A b r : ℝ) = (x : ℝ) + bs := by
    unfold btV; rw [hxd]; push_cast; ring
  rw [e]
  refine (abs_add_le _ _).trans ?_
  linarith

end vals

end J6Seg

