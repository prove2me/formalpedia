theorem FunctorialResolution.EmbeddedResolution.embeddedResolutionRuleOfPrincipalization_apply (A : PrincipalizationAlgorithm.{u}) (h : TransitionsAreBlowupsForEmbeddings A)
    (k : Type u) [Field k] [CharZero k] (Y : Scheme.{u})
    (pY : Y ⟶ Spec (CommRingCat.of k)) [AlgebraicGeometry.LocallyOfFiniteType pY]
    [AlgebraicGeometry.QuasiCompact pY] [AlgebraicGeometry.IsReduced Y]
    [AlgebraicGeometry.IsAffine Y] (D : EmbeddingDatum k Y pY) :
    embeddedResolutionRuleOfPrincipalization A h k Y pY D = (D.toEmbeddedBlowupSequence A).inducedBlowupsWithoutIso (h k Y pY D) := by sorry
