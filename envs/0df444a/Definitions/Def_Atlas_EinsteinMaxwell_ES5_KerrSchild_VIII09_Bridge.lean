/-! ## The test family -/

/-- `b_1 = b*` at the anchor. -/
noncomputable def b1f (j : ℝ) : ℝ → ℝ := bstar 3 1 (3 / 2) j

/-- `v_1 = v*` at the anchor. -/
noncomputable def v1f (j : ℝ) : ℝ → ℝ := vstar 3 1 j

/-- The cubic magnetic potential `c` (the actual response). -/
noncomputable def c3f (j : ℝ) : ℝ → ℝ := cj j

/-- The cubic rotation `d` (the actual response). -/
noncomputable def d3f (j : ℝ) : ℝ → ℝ := dj j

/-- `f_ε = f0 (1 + ε² u)`. -/
noncomputable def fE (j : ℝ) (ε : ℝ) : ℝ → ℝ := fun R => f0 3 1 R * (1 + ε ^ 2 * uA j R)

/-- `m_ε = m0 (1 + ε² z)`. -/
noncomputable def mE (j : ℝ) (ε : ℝ) : ℝ → ℝ := fun R => m0 3 1 R * (1 + ε ^ 2 * zA j R)

/-- `a_ε = ε b1 + ε³ c`. -/
noncomputable def aE (j : ℝ) (ε : ℝ) : ℝ → ℝ := fun R => ε * b1f j R + ε ^ 3 * c3f j R

/-- `w_ε = ε v1 + ε³ d`. -/
noncomputable def wE (j : ℝ) (ε : ℝ) : ℝ → ℝ := fun R => ε * v1f j R + ε ^ 3 * d3f j R

/-- `p_ε = Q/R + ε² p2`. -/
noncomputable def pE (j : ℝ) (ε : ℝ) : ℝ → ℝ := fun R => p0 (3 / 2) R + ε ^ 2 * pA j R

/-! ## Differentiability of the ingredients near a point of `I` -/

/-! ## The coefficient data at `R` -/

/-- `D1 = (m0 · b1')'` at `R`. -/
noncomputable def D1f (j : ℝ) (R : ℝ) : ℝ :=
  deriv (fun s => m0 3 1 s * deriv (b1f j) s) R

/-- `D3 = (m0 · (z b1' + c'))'` at `R`. -/
noncomputable def D3f (j : ℝ) (R : ℝ) : ℝ :=
  deriv (fun s => m0 3 1 s * (zA j s * deriv (b1f j) s + deriv (c3f j) s)) R

/-- `D5 = (m0 · z c')'` at `R`. -/
noncomputable def D5f (j : ℝ) (R : ℝ) : ℝ :=
  deriv (fun s => m0 3 1 s * (zA j s * deriv (c3f j) s)) R

/-- The `ε`-linear Maxwell coefficient. -/
noncomputable def MA1 (j : ℝ) (R : ℝ) : ℝ :=
  m0 3 1 R * D1f j R - f0 3 1 R * b1f j R
    - (2 * (3 / 2) * f0 3 1 R * (m0 3 1 R) ^ 2 / (N0 3 1 R) ^ 2) * (j + 2 * (3 / 2) * b1f j R)

/-- The `ε³` Maxwell coefficient. -/
noncomputable def MA3 (j : ℝ) (R : ℝ) : ℝ :=
  m0 3 1 R * (zA j R * D1f j R + D3f j R)
    - f0 3 1 R * (uA j R * b1f j R + c3f j R)
    - (2 * (3 / 2) * f0 3 1 R * (m0 3 1 R) ^ 2 / (N0 3 1 R) ^ 2)
        * (2 * (3 / 2) * c3f j R
          + (uA j R + 2 * zA j R) * (j + 2 * (3 / 2) * b1f j R))

/-! ## Smoothness of the ingredient profiles on `Ioi 3` -/

/-! ## The pointwise derivative of `a_ε` -/

/-! ## The `ε⁵`, `ε⁷`, `ε⁹` coefficients (transparent data) -/

/-- The `ε⁵` Maxwell coefficient. -/
noncomputable def MA5 (j : ℝ) (R : ℝ) : ℝ :=
  m0 3 1 R * (zA j R * D3f j R + D5f j R)
    - f0 3 1 R * (uA j R * c3f j R)
    - (2 * (3 / 2) * f0 3 1 R * (m0 3 1 R) ^ 2 / (N0 3 1 R) ^ 2)
        * ((2 * (3 / 2) * c3f j R) * (uA j R + 2 * zA j R)
          + (zA j R ^ 2 + 2 * uA j R * zA j R) * (j + 2 * (3 / 2) * b1f j R))

/-- The `ε⁷` Maxwell coefficient. -/
noncomputable def MA7 (j : ℝ) (R : ℝ) : ℝ :=
  m0 3 1 R * (zA j R * D5f j R)
    - (2 * (3 / 2) * f0 3 1 R * (m0 3 1 R) ^ 2 / (N0 3 1 R) ^ 2)
        * ((2 * (3 / 2) * c3f j R) * (zA j R ^ 2 + 2 * uA j R * zA j R)
          + (uA j R * zA j R ^ 2) * (j + 2 * (3 / 2) * b1f j R))

/-- The `ε⁹` Maxwell coefficient. -/
noncomputable def MA9 (j : ℝ) (R : ℝ) : ℝ :=
  -(2 * (3 / 2) * f0 3 1 R * (m0 3 1 R) ^ 2 / (N0 3 1 R) ^ 2)
    * ((2 * (3 / 2) * c3f j R) * (uA j R * zA j R ^ 2))

