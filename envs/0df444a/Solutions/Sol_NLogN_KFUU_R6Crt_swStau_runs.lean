section
-- Source module: Solutions.R6CrtSwap
/-!
# CRT reversal §3: the swap entry with exponent `τ`

`SwOKτ τ` is KFUU's `SwOKU` with the exponent `KFS.τS` replaced by `τ` (what `IL.SwapNeedτ tab τ`
provides inside a merged table); `swSτ_runs` is KFUU's `swS_runs` (descriptor
`[w, u, 1, 3, 5, a, 2^u, m, 2^u, c₂]` built from registers, one call) for it.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU.R6Crt

open IntMul KIL KFB KFC KFT KFU AModel AModelL12 NLogN.KFUU

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {τ : ℝ}

theorem swOKτ_run {eSw : Fin P} {dS : Fin HS} {K : ℝ} (hK : SwOKτ τ I iprog eSw dS K) (hdS : dS ≠ 0)
    {u w : ℕ} {sh : Shape} {p q : ℕ} (hu : 1 ≤ u) (hpos : ∀ a ∈ sh, 1 ≤ a) (hpq : p < q)
    (hq : q < sh.length) (gp : sh.getD p 0 = 2 ^ u) (gq : sh.getD q 0 = 2 ^ u)
    (t : IState HS) (zs : List GI) (R Ld : List Item) (h0 : t.G 0 = ints (gflat zs) ++ R)
    (hd : t.G dS = ints (KFM.descSw w u p q sh) ++ Ld) (hlen : zs.length = vol sh) (hgb : GB w zs) :
    ∃ c : ℕ, IRuns I iprog (.call eSw) t
      (t.upd 0 (ints (gflat (pull sh sh (swapPos p q) 0 zs)) ++ R)) c ∧ (c : ℝ) ≤ cSwNτ τ K w u sh := by
  set f : Fin HS → List ℤ := Function.update (Function.update (fun _ => []) 0 (gflat zs)) dS
    (KFM.descSw w u p q sh) with hf
  set s := (t.upd 0 R).upd dS Ld with hs
  have hf0 : f 0 = gflat zs ++ [] := by simp [f, Ne.symm hdS]
  have hfd : f dS = KFM.descSw w u p q sh := by simp [f]
  have hfj : ∀ j, j ≠ 0 → j ≠ dS → f j = [] := by
    intro j h1 h2; simp [f, h1, h2]
  obtain ⟨c, H, hc⟩ := hK u w sh p q hu hpos hpq hq gp gq s f zs [] hfj hfd hf0 hlen hgb
  refine ⟨c, ?_, hc⟩
  have e1 : encK s f = t := by
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases h1 : j = 0
    · subst h1; simp [s, f, h0, Ne.symm hdS]
    · by_cases h2 : j = dS
      · subst h2; simp [s, f, hd, h1]
      · simp [s, f, h1, h2]
  have e2 : encK s (Function.update f 0 (gflat (pull sh sh (swapPos p q) 0 zs) ++ [])) =
      t.upd 0 (ints (gflat (pull sh sh (swapPos p q) 0 zs)) ++ R) := by
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases h1 : j = 0
    · subst h1; simp [s, f, Ne.symm hdS]
    · by_cases h2 : j = dS
      · subst h2; simp [s, f, hd, h1]
      · simp [s, f, h1, h2]
  rwa [e1, e2] at H

/-! ## Moving and dropping a fixed number of items -/

theorem zsz_small {z : ℤ} (h0 : 0 ≤ z) (h : z ≤ 5) : zsz z ≤ 3 :=
  zsz_le_of_lt (by omega)

set_option maxHeartbeats 4000000 in
theorem swSτ_runs_sol_aux {eSw : Fin P} {dS : Fin HS} {K : ℝ} (hK : SwOKτ τ I iprog eSw dS K) (hdS : dS ≠ 0)
    {Dsc : Fin HS} (hD : Dsc = 18 ∨ Dsc = 19) (hDd : Dsc ≠ dS)
    {u w a m c2 Z : ℕ} (hu : 1 ≤ u) (ha : 1 ≤ a) (hm : 1 ≤ m) (hc : 1 ≤ c2) (hZ3 : 3 ≤ Z)
    (zw : zsz (w : ℤ) ≤ Z) (zu : zsz (u : ℤ) ≤ Z) (za : zsz (a : ℤ) ≤ Z) (zm : zsz (m : ℤ) ≤ Z)
    (zc : zsz (c2 : ℤ) ≤ Z) (zU : zsz ((2 ^ u : ℕ) : ℤ) ≤ Z)
    (t : IState HS) (xs : List ℤ) (R : List Item) (h0 : t.G 0 = ints xs ++ R)
    (hlen : xs.length = vol [a, 2 ^ u, m, 2 ^ u, c2] * 2) (hx : Bnd w xs)
    {LW LU LA L2 LM LB : List Item}
    (hW : t.G rW = .int (w : ℤ) :: LW) (hUu : t.G rU = .int (u : ℤ) :: LU)
    (hA : t.G rA = .int (a : ℤ) :: LA) (h2 : t.G rU2 = .int ((2 ^ u : ℕ) : ℤ) :: L2)
    (hM : t.G rM = .int (m : ℤ) :: LM) (hB : t.G rB = .int (c2 : ℤ) :: LB) :
    ∃ c : ℕ, IRuns I iprog (swS eSw dS Dsc) t
      (t.upd 0 (ints (pull [a, 2 ^ u, m, 2 ^ u, c2 * 2] [a, 2 ^ u, m, 2 ^ u, c2 * 2] (swapPos 1 3) 0 xs)
        ++ R)) c ∧
      (c : ℝ) ≤ cSwNτ τ K w u [a, 2 ^ u, m, 2 ^ u, c2] + 30 * cU Z + 3 := by
  have hD0 : Dsc ≠ 0 := by rcases hD with rfl | rfl <;> decide
  set desc := KFM.descSw w u 1 3 [a, 2 ^ u, m, 2 ^ u, c2] with hdesc
  have hdl : desc.length = 10 := by simp [desc, KFM.descSw]
  have hdE : desc = [(w : ℤ), (u : ℤ), 1, 3, 5, (a : ℤ), ((2 ^ u : ℕ) : ℤ), (m : ℤ),
      ((2 ^ u : ℕ) : ℤ), (c2 : ℤ)] := by
    simp [desc, KFM.descSw]
  have hbd : Bnd Z desc := by
    rw [hdE]
    intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact zw
    · exact zu
    · exact le_trans (zsz_small (by norm_num) (by norm_num)) hZ3
    · exact le_trans (zsz_small (by norm_num) (by norm_num)) hZ3
    · exact le_trans (zsz_small (by norm_num) (by norm_num)) hZ3
    · exact za
    · exact zU
    · exact zm
    · exact zU
    · exact zc
  have hF : List.Forall₂ (PushOK t Dsc) descSrc desc := by
    rw [hdE]
    rcases hD with rfl | rfl <;>
    exact .cons ⟨by decide, _, hW⟩ (.cons ⟨by decide, _, hUu⟩ (.cons (by simp [PushOK])
      (.cons (by simp [PushOK]) (.cons (by simp [PushOK]) (.cons ⟨by decide, _, hA⟩
      (.cons ⟨by decide, _, h2⟩ (.cons ⟨by decide, _, hM⟩ (.cons ⟨by decide, _, h2⟩
      (.cons ⟨by decide, _, hB⟩ .nil)))))))))
  have r1 := pushL_runs (I := I) (iprog := iprog) (D := Dsc) descSrc desc t hF hbd
  set t1 := t.upd Dsc (ints desc.reverse ++ t.G Dsc) with ht1
  have r2 := mvK_runs (I := I) (iprog := iprog) hDd desc.reverse t1 (t.G Dsc) (by simp [t1])
    (bnd_rev hbd)
  rw [List.length_reverse, hdl, List.reverse_reverse] at r2
  set t2 := t.upd dS (ints desc ++ t.G dS) with ht2
  have e2 : (t1.upd Dsc (t.G Dsc)).upd dS (ints desc ++ t1.G dS) = t2 := by
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases e1 : j = dS
    · subst e1; simp [t1, t2, Ne.symm hDd]
    · by_cases e3 : j = Dsc
      · subst e3; simp [t1, t2, e1]
      · simp [t1, t2, e1, e3]
  rw [e2] at r2
  have hev : xs.length % 2 = 0 := by rw [hlen]; simp
  have hpos5 : ∀ x ∈ [a, 2 ^ u, m, 2 ^ u, c2], 1 ≤ x := by
    intro x hx; simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl <;> first | assumption | exact Nat.one_le_two_pow
  obtain ⟨c3, r3, hc3⟩ := swOKτ_run (I := I) (iprog := iprog) hK hdS (u := u) (w := w)
    (sh := [a, 2 ^ u, m, 2 ^ u, c2]) (p := 1) (q := 3) hu hpos5 (by norm_num) (by simp)
    (by simp) (by simp) t2 (gpair xs) R (t.G dS) (by rw [gflat_gpair xs hev]; simp [t2, Ne.symm hdS, h0])
    (by simp [t2]; rfl) (by rw [length_gpair, hlen]; simp)
    (GB.of_bnd (by rw [gflat_gpair xs hev]; exact hx))
  rw [gflat_swap5 _ _ _ _ xs hlen] at r3
  set t3 := t2.upd 0 (ints (pull [a, 2 ^ u, m, 2 ^ u, c2 * 2] [a, 2 ^ u, m, 2 ^ u, c2 * 2]
    (swapPos 1 3) 0 xs) ++ R) with ht3
  have r4 := dropK_runs (I := I) (iprog := iprog) (X := dS) desc t3 (t.G dS)
    (by simp [t3, t2, hdS]) hbd
  rw [hdl] at r4
  refine ⟨_, (r1.seq (r2.seq (r3.seq r4))).mono' ?_ le_rfl, ?_⟩
  · refine IState.ext' (fun j => ?_) rfl rfl
    by_cases e1 : j = dS
    · subst e1; simp [t3, t2, hdS]
    · by_cases e3 : j = 0
      · subst e3; simp [t3, t2, e1]
      · simp [t3, t2, e1, e3]
  · simp only [descSrc, List.length_cons, List.length_nil] at *
    push_cast
    linarith

end Gen

end NLogN.KFUU.R6Crt

