variable {Q κ : Type} [AddCommGroup Q] [Fintype κ] {N : ℕ} [NeZero N]

theorem GlobalTheory.TorsionMatrix.ev_apply (pt : κ → Q) (h : ∀ i, N • pt i = 0) (t : κ → ZMod N) :
