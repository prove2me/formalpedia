theorem surjective_residue_comp_algebraMap_of_res
    {W₀ R k : Type} [CommRing W₀] [CommRing R] [IsLocalRing R] [Field k] [Algebra W₀ R]
    (resR : R →+* k) (hkerR : RingHom.ker resR = maximalIdeal R)
    (res₀ : W₀ →+* k) (hres₀ : Function.Surjective res₀) (hresR₀ : ∀ w : W₀, resR (algebraMap W₀ R w) = res₀ w) :
    Function.Surjective (⇑(residue R) ∘ ⇑(algebraMap W₀ R)) := by
  intro y
  obtain ⟨r, rfl⟩ := residue_surjective y
  obtain ⟨w, hw⟩ := hres₀ (resR r)
  refine ⟨w, ?_⟩
  show residue R (algebraMap W₀ R w) = residue R r
  rw [eq_comm, ← sub_eq_zero, ← map_sub, residue_eq_zero_iff, ← hkerR, RingHom.mem_ker, map_sub, hresR₀, hw, sub_self]

theorem surjective_residue_comp_algebraMap_trans
    {W₀ S A : Type} [CommRing W₀] [CommRing S] [IsLocalRing S] [CommRing A] [IsLocalRing A]
    [Algebra W₀ S] [Algebra S A] [Algebra W₀ A] [IsScalarTower W₀ S A]
    (hS : Function.Surjective (⇑(residue S) ∘ ⇑(algebraMap W₀ S)))
    (hA : Function.Surjective (⇑(residue A) ∘ ⇑(algebraMap S A)))
    (hle : (maximalIdeal S).map (algebraMap S A) ≤ maximalIdeal A) :
    Function.Surjective (⇑(residue A) ∘ ⇑(algebraMap W₀ A)) := by
  intro y
  obtain ⟨s, hs⟩ := hA y
  obtain ⟨w, hw⟩ := hS (residue S s)
  refine ⟨w, ?_⟩
  simp only [Function.comp_apply] at hs hw ⊢
  rw [← hs, IsScalarTower.algebraMap_apply W₀ S A, eq_comm, ← sub_eq_zero, ← map_sub, residue_eq_zero_iff, ← map_sub]
  refine hle (Ideal.mem_map_of_mem _ ?_)
  rw [← residue_eq_zero_iff, map_sub, sub_eq_zero]
  exact hw.symm

end OrdDefIgusaAux

