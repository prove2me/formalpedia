open IntMul RS KIL KFD KFE KFB KFL KFW KFH AModel Butterfly KFN P8Lift

theorem posR_lt' {K e k t : ℕ} (hK : 1 ≤ K) (het : e - e % K + K ≤ t) (p : Fin mC × Fin (mC ^ k)) :
    posR K e k p < t := by
  unfold posR
  have := Nat.mod_lt e (by omega : 0 < K)
  have := Nat.mod_le e K
  omega

theorem posR_inj' {K e k : ℕ} (hK : 1 ≤ K) (he : K * (mC ^ k * mC - 1) ≤ e) :
    Function.Injective (posR K e k) := by
  intro p p' h
  have a := posR_he he p
  have b := posR_he he p'
  rw [h] at a
  have h1 : K * (p.2.val + mC ^ k * p.1.val) = K * (p'.2.val + mC ^ k * p'.1.val) := by omega
  have h2 := Nat.eq_of_mul_eq_mul_left (by omega) h1
  have hf : 0 < mC ^ k := by positivity
  have hd : ∀ x : Fin mC × Fin (mC ^ k), (x.2.val + mC ^ k * x.1.val) / mC ^ k = x.1.val ∧
      (x.2.val + mC ^ k * x.1.val) % mC ^ k = x.2.val := fun x => by
    constructor
    · rw [Nat.add_mul_div_left _ _ hf, Nat.div_eq_of_lt x.2.isLt, zero_add]
    · rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt x.2.isLt]
  have e1 := (hd p).1; have e2 := (hd p').1; have e3 := (hd p).2; have e4 := (hd p').2
  rw [h2] at e1 e3
  exact Prod.ext (Fin.ext (e1.symm.trans e2)) (Fin.ext (e3.symm.trans e4))

/-- The Lemma 13 constant plus the header. -/
theorem bnd_add (Kc : ℝ) (K f n r w : ℕ) :
    KFR.bnd (Kc + 8 * 10 ^ 12) K f n r w = KFR.bnd Kc K f n r w + 8 * 10 ^ 12 *
      (((n * r : ℕ) : ℝ) * (w + 1) * (((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) + 1) +
      (n : ℝ) * ((zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) : ℝ) + 1) ^ 3 +
      min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * (n : ℝ) *
        ((zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) : ℝ) + 1) * ((r : ℝ) * (w + 1) +
          (zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) : ℝ) + 1)) := by
  unfold KFR.bnd; ring

/-- The header cost is absorbed by `8·10^12` times the Lemma 13 bracket. -/
theorem cHd_le_bnd (Kc : ℝ) {K f n r w : ℕ} (hn : 1 ≤ n) (hf : 1 ≤ f) :
    KFR.bnd Kc K f n r w + (cHd (zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1))) : ℝ) ≤
      KFR.bnd (Kc + 8 * 10 ^ 12) K f n r w := by
  rw [bnd_add]
  set X : ℝ := (zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) : ℝ) with hXd
  have hX0 : 0 ≤ X := Nat.cast_nonneg _
  have hc : (cHd (zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1))) : ℝ) = 10 ^ 12 * (X + 2) ^ 3 := by
    simp only [cHd, Nat.cast_mul, Nat.cast_pow, Nat.cast_add, Nat.cast_ofNat, hXd]
  rw [hc]
  have h1 : (X + 2) ^ 3 ≤ 8 * (X + 1) ^ 3 := by nlinarith [sq_nonneg (X + 1)]
  have hn' : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have h2 : (X + 1) ^ 3 ≤ (n : ℝ) * (X + 1) ^ 3 := le_mul_of_one_le_left (by positivity) hn'
  have hA : 0 ≤ ((n * r : ℕ) : ℝ) * (w + 1) * (((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) + 1) := by
    positivity
  have hm : 0 ≤ min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) := le_min (by norm_num) (by
    have : (1 : ℝ) ≤ f := by exact_mod_cast hf
    have : (0 : ℝ) ≤ 2⁻¹ ^ K := by positivity
    nlinarith)
  have hC : 0 ≤ min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * (n : ℝ) * (X + 1) * ((r : ℝ) * (w + 1) + X + 1) :=
    by positivity
  nlinarith

