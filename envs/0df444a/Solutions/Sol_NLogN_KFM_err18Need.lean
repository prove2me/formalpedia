theorem co_mul_ncm {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r : ℕ} (C : CoeffModel y r)
    (u v : R) : C.co (u * v) = ncm (C.co u) (C.co v) := by
  have : NeZero r := ⟨C.pos.ne'⟩
  funext c
  rw [Synth.co_mul C u v c, ncm_eq]
  refine Finset.sum_congr rfl fun i _ => ?_
  have hc := c.2
  have hi := i.2
  have hv : ∀ m m' : Fin r, m.val = m'.val → C.co v m = C.co v m' := fun m m' h => by
    rw [Fin.ext h]
  by_cases h : (i : ℕ) ≤ c
  · rw [dif_pos h, if_pos h, mul_one]
    exact congrArg (C.co u i * ·) (hv _ _ (by
      show (c : ℕ) - i = ((c : ℕ) + r - i) % r
      rw [show (c : ℕ) + r - i = ((c : ℕ) - i) + r by omega, Nat.add_mod_right,
        Nat.mod_eq_of_lt (by omega)]))
  · rw [dif_neg h, if_neg h]
    rw [hv ⟨(c : ℕ) + r - i, by omega⟩ ⟨((c : ℕ) + r - i) % r, Nat.mod_lt _ C.pos⟩
      (by show (c : ℕ) + r - i = ((c : ℕ) + r - i) % r; rw [Nat.mod_eq_of_lt (by omega)])]
    ring

theorem e18_wrap_sub {T x k : ℕ} (hx : x < T) (hk : k < T) : (k + (x + T - k) % T) % T = x := by
  rcases lt_or_ge x k with h | h
  · rw [Nat.mod_eq_of_lt (show x + T - k < T by omega), show k + (x + T - k) = x + T by omega,
      Nat.add_mod_right, Nat.mod_eq_of_lt hx]
  · rw [show x + T - k = (x - k) + T by omega, Nat.add_mod_right,
      Nat.mod_eq_of_lt (show x - k < T by omega), show k + (x - k) = x by omega,
      Nat.mod_eq_of_lt hx]

theorem e18_sub_wrap {T k m : ℕ} (hk : k < T) (hm : m < T) : m = ((k + m) % T + T - k) % T := by
  rcases lt_or_ge (k + m) T with h | h
  · rw [Nat.mod_eq_of_lt h, show k + m + T - k = m + T by omega, Nat.add_mod_right,
      Nat.mod_eq_of_lt hm]
  · rw [show k + m = (k + m - T) + T by omega, Nat.add_mod_right,
      Nat.mod_eq_of_lt (show k + m - T < T by omega),
      Nat.mod_eq_of_lt (show k + m - T + T - k < T by omega)]
    omega

section Box

variable {D : ℕ} [NeZero D]

theorem wrap_subB (a : Fin D → ℕ) {x k : Fin D → ℕ} (hx : x ∈ box a) (hk : k ∈ box a) :
    wrap a k (subB D a x k) = x := by
  funext i
  simp only [wrap, subB]
  exact e18_wrap_sub ((mem_box.1 hx) i) ((mem_box.1 hk) i)

theorem eq_subB (a : Fin D → ℕ) {x k m : Fin D → ℕ} (hk : k ∈ box a) (hm : m ∈ box a)
    (h : wrap a k m = x) : m = subB D a x k := by
  subst h
  funext i
  simp only [wrap, subB]
  exact e18_sub_wrap ((mem_box.1 hk) i) ((mem_box.1 hm) i)

/-- **The coefficients of `M_r(F, G)(x)`.** -/
theorem co_Mr {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r : ℕ} (C : CoeffModel y r)
    (a : Fin D → ℕ) (F G : (Fin D → ℕ) → R) {x : Fin D → ℕ} (hx : x ∈ box a) :
    C.co (Mr r a F G x) = ((r * Mv a : ℕ) : ℂ)⁻¹ •
      ∑ k ∈ box a, ncm (C.co (F k)) (C.co (G (subB D a x k))) := by
  unfold Mr conv
  rw [map_smul, map_sum]
  congr 1
  refine Finset.sum_congr rfl fun k hk => ?_
  rw [map_sum, Finset.sum_eq_single (subB D a x k)]
  · rw [if_pos (wrap_subB a hx hk), co_mul_ncm]
  · intro m hm hne
    rw [if_neg (fun h => hne (eq_subB a hk hm h)), map_zero]
  · intro h; exact absurd (subB_mem D a x k) h

end Box

theorem e18_getD_map {α β : Type*} (f : α → β) (l : List α) (d : α) (e : β) (he : f d = e)
    (n : ℕ) : (l.map f).getD n e = f (l.getD n d) := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases l[n]? <;> simp [he]

theorem e18_getD_norm {α : Type*} [SeminormedAddCommGroup α] (l : List α)
    (h : ∀ x ∈ l, ‖x‖ ≤ 1) (k : ℕ) : ‖l.getD k 0‖ ≤ 1 := by
  by_cases hk : k < l.length
  · rw [List.getD_eq_getElem _ _ hk]; exact h _ (List.getElem_mem hk)
  · rw [List.getD_eq_default _ _ (by omega)]; simp

theorem e18_procQ_len {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r : ℕ}
    (C : CoeffModel y r) (p : ℕ) {D : ℕ} {sh : Shape} {a : Fin D → ℕ} (L : CoordLayout sh a)
    (ℓ : ℕ) (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) :
    ∀ n (xs : List R), xs.length = vol sh → (procQ C p L ℓ P Sb n xs).length = vol sh
  | 0, xs, h => h
  | n + 1, xs, h => by
    have := e18_procQ_len C p L ℓ P Sb n (compR C p (Sb n) (roundEx L ℓ n (P n)) xs)
      (by unfold compR; exact length_twL _ _)
    unfold procQ at this ⊢
    rw [runDown]
    exact this

theorem e18_zip {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r : ℕ} (C : CoeffModel y r)
    (p : ℕ) {N : ℕ} {A B : List R} (hA : A.length = N) (hB : B.length = N) :
    List.zipWith (KFV.ppq r p) (A.map C.co) (B.map C.co) =
      (ofA (QQ y C p (GlueProp18.PP y C (toA C N A) (toA C N B)))).map C.co := by
  apply List.ext_getElem
  · simp [length_ofA, hA, hB]
  · intro j h1 h2
    have hj : j < N := by simpa [hA, hB] using h1
    simp only [List.getElem_zipWith, List.getElem_map, ofA, List.getElem_ofFn]
    show KFV.ppq r p (C.co A[j]) (C.co B[j]) =
      C.co (QpR C p (((r : ℂ)⁻¹) • (A.getD j 0 * B.getD j 0)))
    rw [KFV.co_ppq, List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ (by omega)]

theorem ncm_le {r : ℕ} [NeZero r] (u v : Fin r → ℂ) (hu : ‖u‖ ≤ 1) (hv : ‖v‖ ≤ 1) (c : Fin r) :
    ‖ncm u v c‖ ≤ r := by
  rw [ncm_eq]
  calc _ ≤ ∑ a : Fin r, ‖u a * v ⟨(c.val + r - a.val) % r,
          Nat.mod_lt _ (Nat.pos_of_ne_zero (NeZero.ne r))⟩ * (if a.val ≤ c.val then 1 else -1)‖ :=
        norm_sum_le _ _
    _ ≤ ∑ _a : Fin r, (1 : ℝ) := by
      refine Finset.sum_le_sum fun a _ => ?_
      have hs : ‖(if a.val ≤ c.val then (1 : ℂ) else -1)‖ = 1 := by split_ifs <;> simp
      rw [norm_mul, norm_mul, hs, mul_one]
      have h1 := (norm_le_pi_norm u a).trans hu
      have h2 := (norm_le_pi_norm v ⟨(c.val + r - a.val) % r,
        Nat.mod_lt _ (Nat.pos_of_ne_zero (NeZero.ne r))⟩).trans hv
      nlinarith [norm_nonneg (u a), norm_nonneg (v ⟨(c.val + r - a.val) % r,
        Nat.mod_lt _ (Nat.pos_of_ne_zero (NeZero.ne r))⟩)]
    _ = r := by simp

