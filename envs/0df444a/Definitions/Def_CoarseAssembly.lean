structure CoarseningMorphism (C D : Coarsening.{u}) where
  atScale : ∀ r, CocompactMap (C.space r) (D.space r)
  compatible : ∀ r s h,
    (atScale s).comp (C.inclusion r s h) = (D.inclusion r s h).comp (atScale r)


structure CompatibleIndexFamily (C : Coarsening.{u}) (A : Type v)
    [NonUnitalCStarAlgebra A] where
  atScale : ∀ r, LocallyFiniteK1 (C.space r) →+ OperatorKTheory.K1 A
  compatible : ∀ r s h a, atScale s (C.map r s h a) = atScale r a

namespace CompatibleIndexFamily

variable {C D : Coarsening.{u}} {A B : Type v}

variable [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B]

def assembly (I : CompatibleIndexFamily C A) : C.Homology →+ OperatorKTheory.K1 A :=
  AddCommGroup.DirectLimit.lift _ _ _ I.atScale I.compatible

end CompatibleIndexFamily

