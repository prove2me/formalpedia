theorem tYadj_comm (ℓ ℓ' : Nat.Primes) (x : ↥(ribbonKernel Q.D)) : Q.tYadj ℓ (Q.tYadj ℓ' x) = Q.tYadj ℓ' (Q.tYadj ℓ x) := by
  apply Subtype.ext
  show (Q.adjE ℓ).mulVec ((Q.adjE ℓ').mulVec x.1) = (Q.adjE ℓ').mulVec ((Q.adjE ℓ).mulVec x.1)
  rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, (Q.commAdjE ℓ ℓ').eq]
theorem tV_comm (ℓ ℓ' : Nat.Primes) (x : ↥(characterLattice V)) : Q.tV ℓ (Q.tV ℓ' x) = Q.tV ℓ' (Q.tV ℓ x) := by
  apply Subtype.ext
