    have e2 : X * ((V : ℝ) + (W : ℝ) ^ (j + 1)) * ((S : ℝ) / W * c + C) =
        X * ((V : ℝ) + (W : ℝ) ^ (j + 1)) * ((S : ℝ) / W * c) +
          X * ((V : ℝ) + (W : ℝ) ^ (j + 1)) * C := by ring
    rw [e2]
    have e3 : (K : ℝ) * (((V : ℝ) + 1) * X) + (S : ℝ) * ((ilCostU5 W K Kd S q Bb j (V / W) : ℝ) +
        (Kd : ℝ) * X) = ((K : ℝ) * (((V : ℝ) + 1) * X) + (S : ℝ) * ((Kd : ℝ) * X)) +
          (S : ℝ) * (ilCostU5 W K Kd S q Bb j (V / W) : ℝ) := by ring
    rw [e3]
    linarith

/-- **Closed oracle cost**: `ilCostU5 j V ≤ K₀ (Bb+2)² (V + W^j) (m^j)^τ` when `S/W < m^τ`. -/
theorem ilCostU5_le {m W S : ℕ} (K Kd q : ℕ) (hm : 2 ≤ m) (hW : 1 ≤ W) {τ : ℝ}
    (hτ : 0 < τ ∧ τ < 1) (hs : (S : ℝ) / W < (m : ℝ) ^ τ) :
    ∃ K₀ : ℝ, 0 ≤ K₀ ∧ ∀ Bb j V, (ilCostU5 W K Kd S q Bb j V : ℝ) ≤
      K₀ * (((Bb : ℝ) + 2) ^ 2 * ((V : ℝ) + (W : ℝ) ^ j)) * ((m : ℝ) ^ j) ^ τ := by
  set C : ℝ := (K : ℝ) * ((q : ℝ) + 1) + (S : ℝ) * Kd
  have hC0 : 0 ≤ C := by positivity
  obtain ⟨K₀, hK₀, hK⟩ := power_width_recurrence m W S τ C hm hW hτ hs hC0
  refine ⟨K₀, hK₀, fun Bb j V => ?_⟩
  have h1 := ilCostU5_le_coeff W K Kd S q Bb hW j V
  have h2 := hK (coeffSeq S W C) le_rfl (fun k => by simp [coeffSeq]) j
  have hp : (0 : ℝ) ≤ ((Bb : ℝ) + 2) ^ 2 * ((V : ℝ) + (W : ℝ) ^ j) := by positivity
  calc (ilCostU5 W K Kd S q Bb j V : ℝ)
      ≤ ((Bb : ℝ) + 2) ^ 2 * ((V : ℝ) + (W : ℝ) ^ j) * coeffSeq S W C j := h1
    _ ≤ ((Bb : ℝ) + 2) ^ 2 * ((V : ℝ) + (W : ℝ) ^ j) * (K₀ * ((m : ℝ) ^ j) ^ τ) :=
        mul_le_mul_of_nonneg_left h2 hp
    _ = K₀ * (((Bb : ℝ) + 2) ^ 2 * ((V : ℝ) + (W : ℝ) ^ j)) * ((m : ℝ) ^ j) ^ τ := by ring

theorem cPcs_le (m n : ℕ) (cO : ℕ → ℕ) (B : ℕ) (hm : 2 ≤ m) :
    cPcs m n cO B ≤ (∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * cO j) +
      ((3 * m + 3) * (Nat.digits m n).length + 2 * (n + 2)) * 10 ^ 9 * (B + 2) ^ 2 := by
  unfold cPcs cLvl
  set X := (B + 2) ^ 2
  set L := (Nat.digits m n).length
  have h : ∀ j ∈ range L, n / m ^ j % m * (cO j + 2 * 10 ^ 9 * X) + 10 ^ 9 * X +
      (m + 2) * 10 ^ 9 * X ≤ n / m ^ j % m * cO j + (3 * m + 3) * 10 ^ 9 * X := by
    intro j _
    have hd : n / m ^ j % m ≤ m := (Nat.mod_lt _ (by omega)).le
    have : n / m ^ j % m * (2 * 10 ^ 9 * X) ≤ m * (2 * 10 ^ 9 * X) := Nat.mul_le_mul_right _ hd
    rw [Nat.mul_add]
    nlinarith
  calc _ ≤ (∑ j ∈ range L, (n / m ^ j % m * cO j + (3 * m + 3) * 10 ^ 9 * X)) +
        2 * 10 ^ 9 * (n + 2) * X := Nat.add_le_add_right (sum_le_sum h) _
    _ = _ := by rw [sum_add_distrib, sum_const, card_range, smul_eq_mul]; ring

theorem digits_len_le {m n : ℕ} (hm : 2 ≤ m) (hn : 1 ≤ n) : (Nat.digits m n).length ≤ n := by
  have h1 : 1 ≤ (Nat.digits m n).length := by
    rw [Nat.digits_def' (by omega) (by omega)]; simp
  have h2 := pow_le_of_lt_len hm hn (j := (Nat.digits m n).length - 1) (by omega)
  have h3 : (Nat.digits m n).length - 1 < 2 ^ ((Nat.digits m n).length - 1) := Nat.lt_two_pow_self
  have h4 := Nat.pow_le_pow_left hm ((Nat.digits m n).length - 1)
  omega

set_option maxHeartbeats 4000000 in
theorem cL12_lin {q m W u e Kp r n Vb Vq V' : ℕ} (cO : ℕ → ℕ) (B : ℕ) (hm : 2 ≤ m)
    (hq : 2 ≤ q) (h1 : e ≤ u) (h2 : u ≤ Vb) (h3 : Vq ≤ q ^ 2 * Vb) (h4 : r ≤ W * Kp) (h5 : n ≤ e)
    (h6 : n ≠ 0 → V' ≤ 2 * Vq) :
    cL12 u e r Kp n Vq V' m q cO B ≤ Nc q m W * ((B + 2) ^ 2 * (Vb + 1) * (Kp + 1)) +
      ∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * cO j := by
  set X := (B + 2) ^ 2 with hXd
  have hX1 : 1 ≤ X := Nat.one_le_pow _ _ (by omega)
  have hBX : B + 2 ≤ X := Nat.le_self_pow (by norm_num) _
  set Z := X * (Vb + 1) * (Kp + 1) with hZ
  have hZ1 : X * (Vb + 1) ≤ Z := Nat.le_mul_of_pos_right _ (by omega)
  have hZ2 : X ≤ X * (Vb + 1) := Nat.le_mul_of_pos_right _ (by omega)
  have hq2 : 1 ≤ q ^ 2 := Nat.one_le_pow _ _ (by omega)
  have hVq1 : Vq + 1 ≤ (q ^ 2 + 1) * (Vb + 1) := by nlinarith
  -- 1. the descriptor
  have T1 : cPreA u e B ≤ 7 * 10 ^ 9 * Z := by
    unfold cPreA
    have : u + 2 * e + 4 ≤ 7 * (Vb + 1) := by omega
    calc 10 ^ 9 * (u + 2 * e + 4) * X ≤ 10 ^ 9 * (7 * (Vb + 1)) * X :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ this)
      _ = 7 * 10 ^ 9 * (X * (Vb + 1)) := by ring
      _ ≤ 7 * 10 ^ 9 * Z := Nat.mul_le_mul_left _ hZ1
  -- 2. the four paddings
  have T2 : 4 * (10 ^ 9 * X + cPad Vq B) ≤ (4 * 10 ^ 9 + 4 * 10 ^ 5 * (q ^ 2 + 1)) * Z := by
    unfold cPad
    have a : (Vq + 1) * (B + 2) ≤ (q ^ 2 + 1) * (X * (Vb + 1)) := by
      calc (Vq + 1) * (B + 2) ≤ ((q ^ 2 + 1) * (Vb + 1)) * X := Nat.mul_le_mul hVq1 hBX
        _ = (q ^ 2 + 1) * (X * (Vb + 1)) := by ring
    have b : (q ^ 2 + 1) * (X * (Vb + 1)) ≤ (q ^ 2 + 1) * Z := Nat.mul_le_mul_left _ hZ1
    have c : X ≤ Z := le_trans hZ2 hZ1
    nlinarith
  -- 3. the swaps
  have T3 : (r + 1) * (cSw1 q Vq B + 10 ^ 4 * (B + 2)) ≤
      (W + 1) * (2 * 10 ^ 9 * (q + 1) * (q ^ 2 + 1) + 10 ^ 4) * Z := by
    unfold cSw1
    have a : r + 1 ≤ (W + 1) * (Kp + 1) := by nlinarith
    have b : 2 * 10 ^ 9 * (q + 1) * ((Vq + 1) * X) + 10 ^ 4 * (B + 2) ≤
        (2 * 10 ^ 9 * (q + 1) * (q ^ 2 + 1) + 10 ^ 4) * (X * (Vb + 1)) := by
      have b1 : (Vq + 1) * X ≤ (q ^ 2 + 1) * (X * (Vb + 1)) := by
        calc (Vq + 1) * X ≤ ((q ^ 2 + 1) * (Vb + 1)) * X := Nat.mul_le_mul_right _ hVq1
          _ = (q ^ 2 + 1) * (X * (Vb + 1)) := by ring
      have b2 : B + 2 ≤ X * (Vb + 1) := le_trans hBX hZ2
      nlinarith
    calc (r + 1) * (2 * 10 ^ 9 * (q + 1) * ((Vq + 1) * X) + 10 ^ 4 * (B + 2))
        ≤ ((W + 1) * (Kp + 1)) * ((2 * 10 ^ 9 * (q + 1) * (q ^ 2 + 1) + 10 ^ 4) * (X * (Vb + 1))) :=
          Nat.mul_le_mul a b
      _ = (W + 1) * (2 * 10 ^ 9 * (q + 1) * (q ^ 2 + 1) + 10 ^ 4) * Z := by rw [hZ]; ring
  -- 4. the middle part
  set S := ∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * cO j with hSd
  have T4 : (if n = 0 then 0 else cMid Kp V' m n cO B) + 26 ≤
      (3 * 10 ^ 9 + 2 * 10 ^ 5 * (2 * q ^ 2 + 1) + (3 * m + 7) * 10 ^ 9 + 26) * Z + S := by
    split_ifs with hn
    · have : 1 ≤ Z := le_trans hX1 (le_trans hZ2 hZ1)
      nlinarith
    · unfold cMid cPad
      have hL := digits_len_le hm (show 1 ≤ n by omega)
      have hP := cPcs_le m n cO B hm
      rw [← hSd] at hP
      have hV' := h6 hn
      have a : 10 ^ 9 * (Kp + 3) * X ≤ 3 * 10 ^ 9 * Z := by
        calc 10 ^ 9 * (Kp + 3) * X ≤ 10 ^ 9 * (3 * (Kp + 1)) * (X * (Vb + 1)) :=
              Nat.mul_le_mul (Nat.mul_le_mul_left _ (by omega)) hZ2
          _ = 3 * 10 ^ 9 * Z := by rw [hZ]; ring
      have b : (V' + 1) * (B + 2) ≤ (2 * q ^ 2 + 1) * Z := by
        have hv : V' ≤ 2 * (q ^ 2 * Vb) := le_trans hV' (Nat.mul_le_mul_left 2 h3)
        have hv2 : V' + 1 ≤ (2 * q ^ 2 + 1) * (Vb + 1) := by
          have : 2 * (q ^ 2 * Vb) + 1 ≤ (2 * q ^ 2 + 1) * (Vb + 1) := by ring_nf; omega
          omega
        calc (V' + 1) * (B + 2) ≤ ((2 * q ^ 2 + 1) * (Vb + 1)) * X :=
              Nat.mul_le_mul hv2 hBX
          _ = (2 * q ^ 2 + 1) * (X * (Vb + 1)) := by ring
          _ ≤ (2 * q ^ 2 + 1) * Z := Nat.mul_le_mul_left _ hZ1
      have c : ((3 * m + 3) * (Nat.digits m n).length + 2 * (n + 2)) * 10 ^ 9 * X ≤
          (3 * m + 7) * 10 ^ 9 * Z := by
        have c1 : (3 * m + 3) * (Nat.digits m n).length + 2 * (n + 2) ≤ (3 * m + 7) * (Vb + 1) := by
          nlinarith
        calc ((3 * m + 3) * (Nat.digits m n).length + 2 * (n + 2)) * 10 ^ 9 * X
            ≤ ((3 * m + 7) * (Vb + 1)) * 10 ^ 9 * X :=
              Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ c1)
          _ = (3 * m + 7) * 10 ^ 9 * (X * (Vb + 1)) := by ring
          _ ≤ (3 * m + 7) * 10 ^ 9 * Z := Nat.mul_le_mul_left _ hZ1
      have d : 1 ≤ Z := le_trans hX1 (le_trans hZ2 hZ1)
      generalize cPcs m n cO B = CP at hP ⊢
      rw [← hXd] at hP ⊢
      linarith
  have T5 : 25 * (2 * B + 2) + 1 ≤ 51 * Z := by
    have : B + 2 ≤ Z := le_trans hBX (le_trans hZ2 hZ1)
    omega
  -- the constant
  have hN : 7 * 10 ^ 9 + (4 * 10 ^ 9 + 4 * 10 ^ 5 * (q ^ 2 + 1)) +
      (W + 1) * (2 * 10 ^ 9 * (q + 1) * (q ^ 2 + 1) + 10 ^ 4) +
      (3 * 10 ^ 9 + 2 * 10 ^ 5 * (2 * q ^ 2 + 1) + (3 * m + 7) * 10 ^ 9 + 26) + 51 ≤ Nc q m W := by
    unfold Nc
    have e1 : q ^ 2 + 1 ≤ (q + 1) ^ 3 := by nlinarith
    have e5 : (q + 1) * (q ^ 2 + 1) ≤ (q + 1) ^ 3 := by nlinarith
    have e6 : 1 ≤ (q + 1) ^ 3 := Nat.one_le_pow _ _ (by omega)
    set Q3 := (q + 1) ^ 3
    set T := Q3 * (m + 3) * (W + 1) with hT
    have p0 : Q3 ≤ Q3 * (m + 3) := Nat.le_mul_of_pos_right _ (by omega)
    have p0' : Q3 * (m + 3) ≤ T := Nat.le_mul_of_pos_right _ (by omega)
    have p1 : q ^ 2 + 1 ≤ T := by omega
    have p2 : (W + 1) * ((q + 1) * (q ^ 2 + 1)) ≤ T := by
      calc (W + 1) * ((q + 1) * (q ^ 2 + 1)) ≤ (W + 1) * Q3 := Nat.mul_le_mul_left _ e5
        _ ≤ (W + 1) * (Q3 * (m + 3)) := Nat.mul_le_mul_left _ p0
        _ = T := by rw [hT]; ring
    have p3 : W + 1 ≤ T := by
      calc W + 1 = 1 * 1 * (W + 1) := by ring
        _ ≤ Q3 * (m + 3) * (W + 1) := Nat.mul_le_mul_right _ (Nat.mul_le_mul e6 (by omega))
    have p5 : m + 3 ≤ T := by
      calc m + 3 = 1 * (m + 3) * 1 := by ring
        _ ≤ Q3 * (m + 3) * (W + 1) := Nat.mul_le_mul (Nat.mul_le_mul_right _ e6) (by omega)
    have p6 : 1 ≤ T := le_trans e6 (le_trans p0 p0')
    have hT' : 10 ^ 11 * (q + 1) ^ 3 * (m + 3) * (W + 1) = 10 ^ 11 * T := by rw [hT]; ring
    rw [hT']
    have q1 : (W + 1) * (2 * 10 ^ 9 * (q + 1) * (q ^ 2 + 1) + 10 ^ 4) =
        2 * 10 ^ 9 * ((W + 1) * ((q + 1) * (q ^ 2 + 1))) + 10 ^ 4 * (W + 1) := by ring
    have q2 : 2 * 10 ^ 5 * (2 * q ^ 2 + 1) ≤ 4 * 10 ^ 5 * (q ^ 2 + 1) := by linarith
    have q3 : (3 * m + 7) * 10 ^ 9 ≤ 3 * 10 ^ 9 * (m + 3) := by linarith
    rw [q1]
    linarith
  unfold cL12
  have hZ0 : 0 ≤ Z := Nat.zero_le _
  calc _ ≤ 7 * 10 ^ 9 * Z + (4 * 10 ^ 9 + 4 * 10 ^ 5 * (q ^ 2 + 1)) * Z +
        (W + 1) * (2 * 10 ^ 9 * (q + 1) * (q ^ 2 + 1) + 10 ^ 4) * Z +
        ((3 * 10 ^ 9 + 2 * 10 ^ 5 * (2 * q ^ 2 + 1) + (3 * m + 7) * 10 ^ 9 + 26) * Z + S) +
        51 * Z := by
          have := Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add T1 T2) T3) T4) T5
          simpa only [add_assoc] using this
    _ = (7 * 10 ^ 9 + (4 * 10 ^ 9 + 4 * 10 ^ 5 * (q ^ 2 + 1)) +
      (W + 1) * (2 * 10 ^ 9 * (q + 1) * (q ^ 2 + 1) + 10 ^ 4) +
      (3 * 10 ^ 9 + 2 * 10 ^ 5 * (2 * q ^ 2 + 1) + (3 * m + 7) * 10 ^ 9 + 26) + 51) * Z + S := by
          ring
    _ ≤ Nc q m W * Z + S := Nat.add_le_add_right (Nat.mul_le_mul_right _ hN) _

theorem e_le_u {q u : ℕ} (hq : 2 ≤ q) : Nat.clog q (2 ^ u) ≤ u :=
  Nat.clog_le_of_le_pow (Nat.pow_le_pow_left hq u)

theorem one_le_e {q u : ℕ} (hq : 2 ≤ q) (hu : 1 ≤ u) : 1 ≤ Nat.clog q (2 ^ u) := by
  have hTQ : 2 ^ u ≤ q ^ Nat.clog q (2 ^ u) := Nat.le_pow_clog (by omega) _
  by_contra h0
  have h : Nat.clog q (2 ^ u) = 0 := by omega
  rw [h, pow_zero] at hTQ
  have : 2 ≤ 2 ^ u := by
    calc 2 = 2 ^ 1 := rfl
      _ ≤ 2 ^ u := Nat.pow_le_pow_right (by omega) hu
  omega

theorem qe_le {q u : ℕ} (hq : 2 ≤ q) (hu : 1 ≤ u) : q ^ Nat.clog q (2 ^ u) ≤ q * 2 ^ u := by
  have h1 := one_le_e hq hu
  have h2 : 1 < 2 ^ u := Nat.one_lt_two_pow (by omega)
  have h3 := Nat.pow_pred_clog_lt_self (show 1 < q by omega) h2
  obtain ⟨d, hd⟩ : ∃ d, Nat.clog q (2 ^ u) = d + 1 := ⟨Nat.clog q (2 ^ u) - 1, by omega⟩
  rw [hd] at h3 ⊢
  simp only [Nat.pred_succ] at h3
  rw [pow_succ, mul_comm]
  exact Nat.mul_le_mul_left _ h3.le

theorem vq_le_vb {q u : ℕ} (hq : 2 ≤ q) (hu : 1 ≤ u) (Pre G Suf : Shape) :
    vol (qShape Pre G Suf q (Nat.clog q (2 ^ u))) ≤ q ^ 2 * vol (binShape Pre G Suf (2 ^ u)) := by
  rw [← vol_binShape_q, NLogN.KIL.vol_binShape, NLogN.KIL.vol_binShape]
  have h := qe_le hq hu
  set Q := q ^ Nat.clog q (2 ^ u)
  calc vol Pre * (Q * (vol G * (Q * vol Suf)))
      ≤ vol Pre * ((q * 2 ^ u) * (vol G * ((q * 2 ^ u) * vol Suf))) := by gcongr
    _ = q ^ 2 * (vol Pre * (2 ^ u * (vol G * (2 ^ u * vol Suf)))) := by ring

theorem u_le_vb {u : ℕ} (Pre G Suf : Shape) (hPre : ∀ a ∈ Pre, 1 ≤ a) (hG : ∀ a ∈ G, 1 ≤ a)
    (hS : ∀ a ∈ Suf, 1 ≤ a) : u ≤ vol (binShape Pre G Suf (2 ^ u)) := by
  rw [NLogN.KIL.vol_binShape]
  have h1 := NLogN.KIL.one_le_vol hPre; have h2 := NLogN.KIL.one_le_vol hG; have h3 := NLogN.KIL.one_le_vol hS
  have h4 : u < 2 ^ u := Nat.lt_two_pow_self
  calc u ≤ 1 * (2 ^ u * (1 * (1 * 1))) := by simp; omega
    _ ≤ vol Pre * (2 ^ u * (vol G * (2 ^ u * vol Suf))) := by
      gcongr
      · exact Nat.one_le_two_pow

end NLogN.KIL

