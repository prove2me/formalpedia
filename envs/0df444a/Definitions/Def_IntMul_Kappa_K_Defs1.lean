-- Source module: Solutions.AModelRuns
/-!
# Array model, Stage 2: runs of pivots as single interchanges of merged fields

Builds on `Solutions/AModel.lean` (whose definitions are unchanged).

* §1 Reshape (`mergeShape`, `mergeAddr`, `splitAddr`): merging adjacent fields is free —
  `pull_merge`, `pull_split`, general `pull_reshape`.
* §2 Block swap (`blockSwap`): it is the composition of the single position swaps
  (`chain_runPairs`), and after merging both runs it is one swap of two merged fields
  (`merge2_blockSwap`, `pull_blockSwap`).
* §3 A run of `r` consecutive pivots on contiguous active fields acts on arrays as that block swap
  (`runArr_pivotRun`), hence as one merged-field interchange (`runArr_pivotRun_merged`).
* §4 A pivot list splits into `numRuns` maximal runs (`groupRuns`, `flatMap_groupRuns`), and
  `runArr` over its swaps is the composition of one merged-field swap per run
  (`runArr_swapSteps_runs`).
-/

namespace AModel

/-! ## 1. Reshape -/

section Reshape

/-- Merge the fields `[i, i+r)` of `sh` into one field. -/
def mergeShape (sh : Shape) (i r : ℕ) : Shape :=
  sh.take i ++ [vol ((sh.drop i).take r)] ++ sh.drop (i + r)

/-- Merge the digits `[i, i+r)` of an address into one digit. -/
def mergeAddr (sh : Shape) (i r : ℕ) (a : List ℕ) : List ℕ :=
  a.take i ++ [encode ((sh.drop i).take r) ((a.drop i).take r)] ++ a.drop (i + r)

/-- Split digit `i` of a merged address back into `r` digits. -/
def splitAddr (sh : Shape) (i r : ℕ) (b : List ℕ) : List ℕ :=
  b.take i ++ decode ((sh.drop i).take r) (b.getD i 0) ++ b.drop (i + 1)

end Reshape

/-! ## 2. Block swaps -/

section BlockSwap

/-- Gather digits by an index map: digit `k` of the result is digit `f k` of `a`. -/
def permIdx (f : ℕ → ℕ) (a : List ℕ) : List ℕ :=
  (List.range a.length).map fun k => a.getD (f k) 0

/-- Exchange the digits at list positions `p` and `q` (same formula as `swapMap`). -/
def swapPos (p q : ℕ) (a : List ℕ) : List ℕ :=
  (a.set p (a.getD q 0)).set q (a.getD p 0)

/-- Index map of `swapPos`. -/
def swapIdx (p q k : ℕ) : ℕ := if k = q then p else if k = p then q else k

/-- Index map of `blockSwap`. -/
def bsIdx (i j r k : ℕ) : ℕ :=
  if i ≤ k ∧ k < i + r then k + j - i else if j ≤ k ∧ k < j + r then k + i - j else k

/-- Exchange the digit runs `[i, i+r)` and `[j, j+r)`. -/
def blockSwap (i j r : ℕ) (a : List ℕ) : List ℕ := permIdx (bsIdx i j r) a

/-! ### Segments of a block-swapped address -/

section Segments
variable {i j r : ℕ} {a : List ℕ} (hij : i + r ≤ j) (hj : j + r ≤ a.length)
include hij hj

end Segments

/-! ### Merging both runs -/

/-- Both runs merged (the later run first). -/
def merge2 (sh : Shape) (i j r : ℕ) (a : List ℕ) : List ℕ :=
  mergeAddr (mergeShape sh j r) i r (mergeAddr sh j r a)

/-- The shape with both runs merged. -/
def mergeShape2 (sh : Shape) (i j r : ℕ) : Shape := mergeShape (mergeShape sh j r) i r

/-- Inverse of `merge2`. -/
def split2 (sh : Shape) (i j r : ℕ) (b : List ℕ) : List ℕ :=
  splitAddr sh j r (splitAddr (mergeShape sh j r) i r b)

end BlockSwap

/-! ## 3. A run of consecutive pivots is one merged-field interchange -/

section PivotRun

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

variable [NeZero Q]

end PivotRun

/-! ## 4. Counting runs -/

section Runs

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) [NeZero Q]

end Runs

end AModel

