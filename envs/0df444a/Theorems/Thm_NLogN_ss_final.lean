theorem NLogN.ss_final (N k M : ℕ) (a b : ℤ) (hN : 1 ≤ N) (hKM : 2 ^ k * M = N)
    (ha : 0 ≤ a ∧ a ≤ 2 ^ N) (hb : 0 ≤ b ∧ b ≤ 2 ^ N) :
