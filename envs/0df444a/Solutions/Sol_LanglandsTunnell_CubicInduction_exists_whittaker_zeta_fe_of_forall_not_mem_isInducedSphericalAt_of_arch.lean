private theorem integral_eq_integral_sPart_mul_tprod {κ τ₀ : ℝ}
    (hW : ∀ L : List (HeightOneSpectrum (𝓞 ℚ)), (∀ v ∈ L, v ∉ T) → L.Nodup →
      ∀ a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ (↑T ∪ {v | v ∈ L}),
        Φ a = Φ (NumberField.Idele.partAt ℚ T a) * (L.map fun v => τ v (NumberField.Idele.ord ℚ v a)).prod)
    (hτ0 : ∀ v, v ∉ T → ∀ m : ℤ, m < 0 → τ v m = 0) (hτ1 : ∀ v, v ∉ T → τ v 0 = 1)
    (hτ : ∀ v, v ∉ T → ∀ n : ℕ, ‖τ v n‖ ≤ (2 * ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ κ) ^ n)
    (hχ : ∀ v, v ∉ T → ‖((χ (uniformizerIdele ℚ v) : ℂˣ) : ℂ)‖ ≤ ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ τ₀)
