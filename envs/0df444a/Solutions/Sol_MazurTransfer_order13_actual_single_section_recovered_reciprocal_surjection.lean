/-
Copyright (c) 2026 Vas and contributors. Released under Apache-2.0.
Design boundary: the literal R[T]-subalgebra generated by p=x*t and
q=x*(p+2), with T acting by t=y+x^3+x^2+1, is finite when two is a unit.
Named downstream consumer: identifying the actual single-section affine
complement and constructing full FiniteMapData. Free rank three and the
scheme identification are separate obligations, not asserted here.
-/

noncomputable section
universe u
namespace MazurTransfer.Order13SingleSectionFiniteAlgebra
open Polynomial Submodule
open MazurTorsion.XOneThirteenAffineCurve
open MazurTransfer.Order13SingleSectionFiniteMapIdentities
variable (R : Type u) [CommRing R]

noncomputable def parameterMap : Polynomial R →+* CoordinateRing R := (aeval (t R)).toRingHom
scoped instance parameterAlgebra : Algebra (Polynomial R) (CoordinateRing R) :=
  (parameterMap R).toAlgebra
scoped instance parameterSMul : SMul (Polynomial R) (CoordinateRing R) :=
  (parameterAlgebra R).toSMul
scoped instance parameterModule : Module (Polynomial R) (CoordinateRing R) :=
  @Algebra.toModule (Polynomial R) (CoordinateRing R) _ _ (parameterAlgebra R)

theorem parameter_algebraMap (s : Polynomial R) :
    algebraMap (Polynomial R) (CoordinateRing R) s = aeval (t R) s := rfl

def generators : Set (CoordinateRing R) := {1, p R, q R}
def spanningModule : Submodule (Polynomial R) (CoordinateRing R) :=
  Submodule.span (Polynomial R) (generators R)
noncomputable def candidateAlgebra : Subalgebra (Polynomial R) (CoordinateRing R) :=
  Algebra.adjoin (Polynomial R) ({p R, q R} : Set (CoordinateRing R))

private theorem one_mem_span : (1 : CoordinateRing R) ∈ spanningModule R :=
  Submodule.subset_span (by simp [generators])
private theorem p_mem_span : p R ∈ spanningModule R :=
  Submodule.subset_span (by simp [generators])
private theorem q_mem_span : q R ∈ spanningModule R :=
  Submodule.subset_span (by simp [generators])

private theorem p_mul_p_mem : p R * p R ∈ spanningModule R := by
  rw [← pow_two, p_squared]
  have ht : t R * q R = (X : Polynomial R) • q R := by
    simp [Algebra.smul_def, parameter_algebraMap, _root_.map_ofNat]
  have h2 : (2 : CoordinateRing R) * p R = (2 : Polynomial R) • p R := by
    simp [Algebra.smul_def, parameter_algebraMap, _root_.map_ofNat]
  rw [ht, h2]
  exact (spanningModule R).sub_mem ((spanningModule R).smul_mem _ (q_mem_span R))
    ((spanningModule R).smul_mem _ (p_mem_span R))

private theorem cancel_two_membership (h2 : IsUnit (2 : R)) (v : CoordinateRing R)
    (hv : (2 : CoordinateRing R) * v ∈ spanningModule R) : v ∈ spanningModule R := by
  obtain ⟨unit, hunit⟩ := h2
  let c : Polynomial R := C (↑(unit⁻¹) : R)
  have hc : (2 : Polynomial R) * c = 1 := by
    dsimp [c]
    rw [← C_ofNat, ← C_mul, ← hunit]
    simp
  have ha : (2 : CoordinateRing R) * algebraMap (Polynomial R) (CoordinateRing R) c = 1 := by
    simpa only [_root_.map_mul, _root_.map_ofNat, _root_.map_one] using
      congrArg (algebraMap (Polynomial R) (CoordinateRing R)) hc
  have h : c • ((2 : CoordinateRing R) * v) = v := by
    rw [Algebra.smul_def]
    calc
      _ = ((2 : CoordinateRing R) * algebraMap (Polynomial R) (CoordinateRing R) c) * v := by ring
      _ = v := by rw [ha, one_mul]
  rw [← h]
  exact (spanningModule R).smul_mem c hv

private theorem p_mul_q_mem (h2 : IsUnit (2 : R)) : p R * q R ∈ spanningModule R := by
  apply cancel_two_membership R h2
  rw [← mul_assoc, twice_p_mul_q]
  have h1 : t R ^ 3 - 2 * t R ^ 2 = (X ^ 3 - 2 * X ^ 2 : Polynomial R) • (1 : CoordinateRing R) := by
    simp [Algebra.smul_def, parameter_algebraMap, _root_.map_ofNat]
  have hq : 2 * t R * q R = (2 * X : Polynomial R) • q R := by
    simp [Algebra.smul_def, parameter_algebraMap, _root_.map_ofNat]
  rw [h1, hq]
  exact (spanningModule R).sub_mem ((spanningModule R).smul_mem _ (one_mem_span R))
    ((spanningModule R).smul_mem _ (q_mem_span R))

private theorem q_mul_q_mem (h2 : IsUnit (2 : R)) : q R * q R ∈ spanningModule R := by
  apply cancel_two_membership R h2
  rw [← pow_two, twice_q_squared]
  have hp : (t R ^ 2 - 2 * t R) * p R = (X ^ 2 - 2 * X : Polynomial R) • p R := by
    simp [Algebra.smul_def, parameter_algebraMap, _root_.map_ofNat]
  have hq : (2 * t R - 4) * q R = (2 * X - 4 : Polynomial R) • q R := by
    simp [Algebra.smul_def, parameter_algebraMap, _root_.map_ofNat]
  have hc : (2 - t R) * (t R ^ 2 - 2 * t R) =
      ((2 - X) * (X ^ 2 - 2 * X) : Polynomial R) • (1 : CoordinateRing R) := by
    simp [Algebra.smul_def, parameter_algebraMap, _root_.map_ofNat]
  rw [hp, hq, hc]
  exact (spanningModule R).add_mem
    ((spanningModule R).add_mem ((spanningModule R).smul_mem _ (p_mem_span R))
      ((spanningModule R).smul_mem _ (q_mem_span R)))
    ((spanningModule R).smul_mem _ (one_mem_span R))

theorem spanningModule_mul_closed (h2 : IsUnit (2 : R))
    (v w : CoordinateRing R) (hv : v ∈ spanningModule R) (hw : w ∈ spanningModule R) :
    v * w ∈ spanningModule R := by
  have hle : spanningModule R * spanningModule R ≤ spanningModule R := by
    change span (Polynomial R) (generators R) * span (Polynomial R) (generators R) ≤ _
    rw [Submodule.span_mul_span]
    apply Submodule.span_le.mpr
    rintro z ⟨v, hv, w, hw, rfl⟩
    simp only [generators, Set.mem_insert_iff, Set.mem_singleton_iff] at hv hw
    rcases hv with rfl | rfl | rfl <;> rcases hw with rfl | rfl | rfl
    · simpa using one_mem_span R
    · simpa using p_mem_span R
    · simpa using q_mem_span R
    · simpa using p_mem_span R
    · exact p_mul_p_mem R
    · exact p_mul_q_mem R h2
    · simpa using q_mem_span R
    · change q R * p R ∈ spanningModule R
      rw [mul_comm]
      exact p_mul_q_mem R h2
    · exact q_mul_q_mem R h2
  exact hle (Submodule.mul_mem_mul hv hw)

theorem candidateAlgebra_eq_span (h2 : IsUnit (2 : R)) :
    (candidateAlgebra R).toSubmodule = spanningModule R := by
  let S : Subalgebra (Polynomial R) (CoordinateRing R) :=
    (spanningModule R).toSubalgebra (one_mem_span R) (spanningModule_mul_closed R h2)
  have hBS : candidateAlgebra R ≤ S := by
    apply Algebra.adjoin_le
    intro z hz
    rcases hz with rfl | rfl
    · exact p_mem_span R
    · exact q_mem_span R
  apply le_antisymm
  · exact fun _ hz => hBS hz
  · apply Submodule.span_le.mpr
    intro z hz
    simp only [generators, Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    · exact (candidateAlgebra R).one_mem
    · exact Algebra.subset_adjoin (by simp)
    · exact Algebra.subset_adjoin (by simp)

theorem candidateAlgebra_finite (h2 : IsUnit (2 : R)) :
    Module.Finite (Polynomial R) (candidateAlgebra R) := by
  change Module.Finite (Polynomial R) (candidateAlgebra R).toSubmodule
  apply Module.Finite.of_fg
  rw [candidateAlgebra_eq_span R h2]
  exact Submodule.fg_span (by simp [generators])

end MazurTransfer.Order13SingleSectionFiniteAlgebra
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateAlgebra_eq_span
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateAlgebra_finite

end
end

