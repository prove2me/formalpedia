            (crankOnes partitionTwentyFourTwentyTwoTwo : Int))
        else (crankLargest partitionTwentyFourTwentyTwoTwo : Int)) = 22
  rw [if_neg (by decide : (1 : Nat) ∉ ({22, 2} : Multiset Nat))]
  show ((({22, 2} : Multiset Nat).fold max 0 : Nat) : Int) = 22
  decide

