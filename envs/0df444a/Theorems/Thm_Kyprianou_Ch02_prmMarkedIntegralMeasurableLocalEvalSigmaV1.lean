-- title:
--   Marked integral of a Poisson random measure is measurable in the count-evaluation σ-algebra of its region
-- statement:
--   For any measurable region R in time-mark space, the real marked integral ∫_R z.2 dNω is measurable with respect to the σ-algebra generated by all measurable subregion counting evaluations of the same random measure N. Establish via positive and negative parts, nonnegative simple approximations and integrability-set measurability, or reusable measure-kernel integration results. Crucially, use the actual LevyStochCalc arbitrary random measure N, not LeanLevy's different point-family construction.
-- source:
--   Kyprianou (2006), Eq. (2.3), independent increments of the finite-activity marked Poisson integral; supporting sigma-independence from LevyStochCalc/Poisson/RegionIndependence.lean.

import Mathlib
import Definitions.Def_KLSModular_LevyStochCalc_Poisson_RandomMeasure
import Definitions.Def_LeanLevy_Processes_LevyProcess
open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal
set_option autoImplicit false

theorem Kyprianou.Ch02.prmMarkedIntegralMeasurableLocalEvalSigmaV1
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ν : Measure ℝ) [SigmaFinite ν]
    (N : LevyStochCalc.Poisson.PoissonRandomMeasure.{0, 0, 0} P ν)
    (R : Set (ℝ × ℝ)) (hRm : MeasurableSet R) :
    Measurable[(⨆ C ∈ {C : Set (ℝ × ℝ) | C ⊆ R ∧ MeasurableSet C},
          MeasurableSpace.comap (fun ω => N.N ω C) inferInstance)]
      (fun ω => ∫ z in R, z.2 ∂(N.N ω)) := by sorry
