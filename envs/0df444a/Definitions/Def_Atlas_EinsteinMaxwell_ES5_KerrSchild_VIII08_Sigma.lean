/-! ## The continuous factor of the Green kernel -/

/-- `g_s(x) = B_s(x)/((1-x) AcK(x)^2)`, so `k_s(x) = x g_s(x)`. -/
noncomputable def gfun (j : ℝ) (q : ℝ → ℝ) (x : ℝ) : ℝ :=
  Bfun j q x / ((1 - x) * AcK x ^ 2)

