theorem Subalgebra.mem_ofPrime_toSubring_iff {R F : Type*} [CommRing R] [Field F] [Algebra R F]
    (B : Subalgebra R F) (P : Ideal ↥B) [P.IsPrime] (f : F) :
    f ∈ (LocalSubring.ofPrime B.toSubring P).toSubring ↔ ∃ b c : ↥B, c ∉ P ∧ f * (c : F) = (b : F) := by
  have key : ∀ (a : ↥B) (s : P.primeCompl) (v : F),
      IsLocalization.lift (M := P.primeCompl) (S := Localization.AtPrime P) (g := B.toSubring.subtype)
        (by simp [Ideal.primeCompl, not_imp_not]) (IsLocalization.mk' _ a s) = v ↔ v * (s : F) = (a : F) := by
    intro a s v
    rw [IsLocalization.lift_mk'_spec]
    constructor
    · intro h; rw [mul_comm]; exact h.symm
    · intro h; rw [mul_comm] at h; exact h.symm
  constructor
  · rintro ⟨y, rfl⟩
    obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq P.primeCompl y
    exact ⟨a, s, s.2, (key a s _).mp rfl⟩
  · rintro ⟨b, c, hc, e⟩
    exact ⟨IsLocalization.mk' _ b ⟨c, hc⟩, (key b ⟨c, hc⟩ f).mpr e⟩

end NodeSkelG

