open CategoryTheory

theorem AddCommGroup.natCard_addMonoidHom_eq_of_isAddCyclic {X Y : Type} [AddCommGroup X] [Finite X] [AddCommGroup Y] [Finite Y]
    [IsAddCyclic Y] (hX : ∀ x : X, Nat.card Y • x = 0) :
    Nat.card (X →+ Y) = Nat.card X := by sorry
