  have := Int.mul_ediv_add_emod (q j + rho H q j + H) (2 * H)
  rw [show q j + rho H q j - ((q j + rho H q j + H) % (2 * H) - H) =
    2 * H * ((q j + rho H q j + H) / (2 * H)) by linarith,
    Int.mul_ediv_cancel_left _ (by omega)]

theorem rho_bnd {H : ℤ} (hH : 0 < H) {q : ℕ → ℤ} (hq : ∀ j, 0 ≤ q j ∧ q j < 2 * H) :
    ∀ j, 0 ≤ rho H q j ∧ rho H q j ≤ 1
  | 0 => by simp [rho]
  | j + 1 => by
    rw [rho_succ_eq hH]
    have ih := rho_bnd hH hq j
    have := hq j
    constructor
    · exact Int.ediv_nonneg (by omega) (by omega)
    · rw [Int.ediv_le_iff_le_mul (by omega)]; omega

theorem two_pow_pred {b : ℕ} (hb : 1 ≤ b) : (2 : ℤ) ^ b = 2 * 2 ^ (b - 1) := by
  rw [← pow_succ']; congr 1; omega

/-- **Extraction of the coefficients from the digits of `zfix`.** -/
theorem extract_digits {b J : ℕ} (hb : 1 ≤ b) {h : ℕ → ℤ}
    (hh : ∀ j < J, -(2 : ℤ) ^ (b - 1) ≤ h j ∧ h j < 2 ^ (b - 1)) :
    0 ≤ zfix (2 ^ b) J (∑ j ∈ range J, h j * (2 ^ b : ℤ) ^ j) ∧
      zfix (2 ^ b) J (∑ j ∈ range J, h j * (2 ^ b : ℤ) ^ j) < (2 ^ b) ^ J ∧
      ∀ j < J, cent (2 ^ (b - 1))
        (NLogN.KFV.qd b (zfix (2 ^ b) J (∑ j ∈ range J, h j * (2 ^ b : ℤ) ^ j)).toNat j +
          rho (2 ^ (b - 1)) (NLogN.KFV.qd b (zfix (2 ^ b) J (∑ j ∈ range J, h j * (2 ^ b : ℤ) ^ j)).toNat) j)
        = h j := by
  set H : ℤ := 2 ^ (b - 1) with hHdef
  have hH : 0 < H := by positivity
  have hH1 : 1 ≤ H := by have : (1 : ℤ) ≤ 2 ^ (b - 1) := one_le_pow₀ (by norm_num); exact this
  have hB : (2 : ℤ) ^ b = 2 * H := two_pow_pred hb
  set Z := ∑ j ∈ range J, h j * (2 ^ b : ℤ) ^ j with hZ
  have hZ2 : Z = ∑ j ∈ range J, h j * (2 * H) ^ j := by rw [hZ, hB]
  have habs : |Z| < (2 * H) ^ J := by
    rw [hZ2]
    exact abs_sum_lt hH1 J (fun j hj => abs_le.2 ⟨(hh j hj).1, (hh j hj).2.le⟩)
  have hBJ : (0 : ℤ) < (2 ^ b) ^ J := by positivity
  rw [← hB] at habs
  have hlo := neg_abs_le Z
  have hhi := le_abs_self Z
  have h0 : 0 ≤ zfix (2 ^ b) J Z := by
    unfold zfix; split_ifs with hz <;> linarith
  have h1 : zfix (2 ^ b) J Z < (2 ^ b) ^ J := by
    unfold zfix; split_ifs with hz <;> linarith
  refine ⟨h0, h1, ?_⟩
  set N := (zfix (2 ^ b) J Z).toNat with hN
  have hNZ : (N : ℤ) = zfix (2 ^ b) J Z := Int.toNat_of_nonneg h0
  have hNlt : N < (2 ^ b) ^ J := by
    have : (N : ℤ) < ((2 ^ b) ^ J : ℕ) := by rw [hNZ]; push_cast; exact h1
    exact_mod_cast this
  -- the digit sum
  have hsum : (N : ℤ) = ∑ j ∈ range J, NLogN.KFV.qd b N j * (2 * H) ^ j := by
    have := congrArg (fun n : ℕ => (n : ℤ)) (sum_digits_nat (2 ^ b) N J)
    simp only [Nat.cast_sum, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] at this
    rw [Nat.mod_eq_of_lt hNlt] at this
    rw [← this, ← hB]
    refine sum_congr rfl fun j _ => ?_
    unfold NLogN.KFV.qd
    simp only [← pow_mul]
  set ε : ℤ := if Z < 0 then -1 else 0
  have hrep : ∑ j ∈ range J, h j * (2 * H) ^ j =
      ∑ j ∈ range J, NLogN.KFV.qd b N j * (2 * H) ^ j + ε * (2 * H) ^ J := by
    rw [← hZ2, ← hsum, hNZ]
    simp only [zfix, ε, ← hB]
    split_ifs <;> ring
  have hq : ∀ j, 0 ≤ NLogN.KFV.qd b N j ∧ NLogN.KFV.qd b N j < 2 * H := fun j => by
    rw [← hB]; exact qd_bnd b N j
  intro j hj
  exact (extract hH hh hq hrep J le_rfl).2.2 j hj

end Ext

end NLogN.KFV

