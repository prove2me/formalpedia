    refine CerednikDrinfeld.SpecialFormal.ModuliPackage.bijective_of_ringEquiv_noetherian_typeFamily
      (fun B _ ψ _ => Gobj B ψ) (fun _ _ f hf x => Gmap f hf x) (fun _ x => Gmap_id x)
      (fun _ _ _ g f hf hg x => Gmap_comp g f hf hg x)
      (fun B _ ψ _ => Hobj E₀ B ψ) (fun _ _ f hf x => Hmap f hf x) (fun _ x => Hmap_id x)
      (fun _ _ _ g f hf hg x => Hmap_comp g f hf hg x)
      (fun B _ _ ψ hB x => xi p hpO hpO0 D hB x)
      (fun B B' _ _ _ _ ψ ψ' hB hB' f hf x => xi_natural p hpO hpO0 D B B' ψ ψ' hB hB' f hf x)
