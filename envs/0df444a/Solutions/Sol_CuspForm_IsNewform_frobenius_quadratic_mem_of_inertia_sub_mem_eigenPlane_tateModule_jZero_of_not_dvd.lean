      (_hTlam : ∀ w ∈ W,
          (TM (ModularCurve.heckeGen ⟨lam, Fact.out⟩)).baseChange K w =
            algebraMap O'' K (algebraMap O' O''
              ((iota.comp chig.rangeRestrict)
                (CuspForm.heckeAlgebra.T (Fact.out : lam.Prime) hlamM (by simp)))) • w),
    ∀ A : ValuationSubring (AlgebraicClosure ℚ), A.LiesOverPrime lam →
      ∀ L : Submodule K (K ⊗[O''] (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M))),
        (∀ σ ∈ A.inertiaSubgroupIn ℚ, ∀ w ∈ W, (ρM σ).baseChange K w - w ∈ L) →
        ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, A.IsFrobeniusAt σ lam →
          ∀ w ∈ W,
            (ρM σ).baseChange K ((ρM σ).baseChange K w)
