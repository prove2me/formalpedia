  have hm : (⟨τ ((a : ↥k₀) : AlgebraicClosure ℚ), h⟩ - ⟨((a : ↥k₀) : AlgebraicClosure ℚ), a.2⟩ : ↥A) ∈ IsLocalRing.maximalIdeal ↥A := by
