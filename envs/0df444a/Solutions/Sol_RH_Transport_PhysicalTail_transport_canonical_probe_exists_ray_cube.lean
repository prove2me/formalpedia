        principalPhysicalPool η S T W (fun i=>Z^(length i)) W0 W1 (Z^TunedCandidate.lx) (Z^TunedCandidate.ly) Z-
        finitePhysicalRows S hmax η R T W (fun i=>Z^(length i)) W0 W1 (Z^TunedCandidate.lx) (Z^TunedCandidate.ly) Z‖≤
      C0*(η.modulus.absNorm:ℝ)^2*E :=
    h0'.trans (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hQδ hC0.le) hE)
  have h1'' := h1'.trans (mul_le_mul_of_nonneg_left hsave (mul_nonneg hC1 (sq_nonneg (η.modulus.absNorm:ℝ))))
  apply (norm_sub_le_norm_sub_add_norm_sub _
    (finitePhysicalRows S hmax η R T W (fun i=>Z^(length i)) W0 W1 (Z^TunedCandidate.lx) (Z^TunedCandidate.ly) Z) _).trans
  exact (add_le_add h0'' h1'').trans_eq (by dsimp [E];ring)

