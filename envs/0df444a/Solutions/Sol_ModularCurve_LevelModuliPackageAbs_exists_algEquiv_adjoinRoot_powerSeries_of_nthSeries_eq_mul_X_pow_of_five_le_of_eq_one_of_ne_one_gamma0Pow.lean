section HFAC_sec

open IsLocalRing

theorem glue_hfac_adicCompletion
    (W₀ : Type) [CommRing W₀] (k : Type) [Field k] (res₀ : W₀ →+* k) (hres₀ : Function.Surjective res₀)
    (C : Type) [CommRing C] [IsNoetherianRing C] [Algebra W₀ C]
    (χ : C →+* k) (hχ : ∀ w : W₀, χ (algebraMap W₀ C w) = res₀ w)
    (𝔫 : Ideal C) (h𝔫 : 𝔫 = RingHom.ker χ) [𝔫.IsMaximal] :
    ∃ (_ : IsLocalRing (AdicCompletion 𝔫 C)) (_ : IsNoetherianRing (AdicCompletion 𝔫 C))
      (_ : IsAdicComplete (maximalIdeal (AdicCompletion 𝔫 C)) (AdicCompletion 𝔫 C))
      (resS : AdicCompletion 𝔫 C →+* k),
      Function.Surjective resS ∧ RingHom.ker resS = maximalIdeal (AdicCompletion 𝔫 C) ∧
      (∀ c : C, resS (algebraMap C (AdicCompletion 𝔫 C) c) = χ c) ∧
      (∀ w : W₀, resS (algebraMap W₀ (AdicCompletion 𝔫 C) w) = res₀ w) ∧
      maximalIdeal (AdicCompletion 𝔫 C) = 𝔫.map (algebraMap C (AdicCompletion 𝔫 C)) ∧
      ∀ (T : Type) [CommRing T] [IsLocalRing T] [IsArtinianRing T] [Algebra W₀ T]
        (resT : T →+* k), Function.Surjective resT → RingHom.ker resT = maximalIdeal T →
        (∀ w : W₀, resT (algebraMap W₀ T w) = res₀ w) →
        ∀ φ : C →ₐ[W₀] T, (∀ c : C, resT (φ c) = χ c) →
          ∃! Φ : AdicCompletion 𝔫 C →ₐ[W₀] T,
            (∀ s : AdicCompletion 𝔫 C, resT (Φ s) = resS s) ∧ ∀ c : C, Φ (algebraMap C (AdicCompletion 𝔫 C) c) = φ c := by
  classical
  obtain ⟨instLoc, instNoe, instCpl, h𝔪, hsurj, hker, hlift⟩ :=
    AdicCompletion.exists_isLocalRing_and_existsUnique_lift_of_isArtinianRing C 𝔫
  set S := AdicCompletion 𝔫 C with hSdef
  set ι : C →+* S := algebraMap C S with hι

  have hχsurj : Function.Surjective χ := by
    intro a; obtain ⟨w, rfl⟩ := hres₀ a; exact ⟨algebraMap W₀ C w, hχ w⟩

  set r : C →+* ResidueField S := (residue S).comp ι with hr
  have hrker : RingHom.ker r = RingHom.ker χ := by rw [hr, hker, h𝔫]

  let e₁ : C ⧸ RingHom.ker r ≃+* ResidueField S := RingHom.quotientKerEquivOfSurjective hsurj
  let e₂ : C ⧸ RingHom.ker χ ≃+* k := RingHom.quotientKerEquivOfSurjective hχsurj
  let e : ResidueField S ≃+* k := (e₁.symm.trans (Ideal.quotEquivOfEq hrker)).trans e₂
  have he : ∀ c : C, e (r c) = χ c := by
    intro c
    show e₂ (Ideal.quotEquivOfEq hrker (e₁.symm (r c))) = χ c
    have : e₁.symm (r c) = Ideal.Quotient.mk _ c := by
      apply e₁.injective; rw [RingEquiv.apply_symm_apply]; rfl
    rw [this]; rfl
  let resS : S →+* k := (e : ResidueField S →+* k).comp (residue S)
  have hresS_ι : ∀ c : C, resS (ι c) = χ c := fun c => he c
  have hresS_surj : Function.Surjective resS := e.surjective.comp residue_surjective
  have hresS_ker : RingHom.ker resS = maximalIdeal S := by
    ext s
    rw [RingHom.mem_ker]
    change e (residue S s) = 0 ↔ s ∈ maximalIdeal S
    rw [map_eq_zero_iff e e.injective, residue_eq_zero_iff]
  have hresS₀ : ∀ w : W₀, resS (algebraMap W₀ S w) = res₀ w := by
    intro w
    rw [IsScalarTower.algebraMap_apply W₀ C S]
    exact (hresS_ι _).trans (hχ w)
  refine ⟨instLoc, instNoe, instCpl, resS, hresS_surj, hresS_ker, hresS_ι, hresS₀, h𝔪, ?_⟩
  intro T _ _ _ _ resT hresT hkerT hresT₀ φ hφ

  have hφ𝔫 : ∀ b ∈ 𝔫, (φ : C →+* T) b ∈ maximalIdeal T := by
    intro b hb
    rw [← hkerT, RingHom.mem_ker]
    have : χ b = 0 := by rw [h𝔫] at hb; exact hb
    rw [← this]; exact hφ b
  obtain ⟨Φ, ⟨hΦloc, hΦcomp⟩, hΦuniq⟩ := hlift T (φ : C →+* T) hφ𝔫
  have hΦι : ∀ c : C, Φ (ι c) = φ c := fun c => by
    have := congrArg (fun F : C →+* T => F c) hΦcomp
    simpa using this

  have hΦW : ∀ w : W₀, Φ (algebraMap W₀ S w) = algebraMap W₀ T w := by
    intro w; rw [IsScalarTower.algebraMap_apply W₀ C S, hΦι, AlgHom.commutes]
  let Φa : S →ₐ[W₀] T := { toRingHom := Φ, commutes' := hΦW }

  have hres : ∀ s : S, resT (Φ s) = resS s := by
    intro s

    obtain ⟨c, hc⟩ := hsurj (residue S s)
    have hsc : s - ι c ∈ maximalIdeal S := by
      rw [← residue_eq_zero_iff, map_sub, sub_eq_zero]; exact hc.symm
    have h1 : resT (Φ (s - ι c)) = 0 := by
      rw [← RingHom.mem_ker, hkerT]
      haveI := hΦloc
      exact map_nonunit Φ (s - ι c) hsc
    have h2 : resS (s - ι c) = 0 := by rw [← RingHom.mem_ker, hresS_ker]; exact hsc
    rw [map_sub, map_sub, sub_eq_zero] at h1
    rw [map_sub, sub_eq_zero] at h2
    rw [h1, h2, hΦι, hresS_ι, hφ]
  refine ⟨Φa, ⟨hres, hΦι⟩, ?_⟩
  rintro Ψ ⟨hΨres, hΨι⟩
  apply AlgHom.ext
  have hΨloc : IsLocalHom (Ψ : S →+* T) := by
    refine ⟨fun s hs => ?_⟩
    by_contra hns
    have hmem : s ∈ maximalIdeal S := (mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hns)
    have : resT (Ψ s) = 0 := by rw [hΨres, ← RingHom.mem_ker, hresS_ker]; exact hmem
    rw [← RingHom.mem_ker, hkerT] at this
    exact (mem_nonunits_iff.mp ((mem_maximalIdeal _).mp this)) hs
  have := hΦuniq (Ψ : S →+* T) ⟨hΨloc, by ext c; exact hΨι c⟩
  intro s
  exact congrArg (fun F : S →+* T => F s) this

end HFAC_sec

section S1d_sec

open IsLocalRing

theorem glue_S1d
    (W₀ : Type) [CommRing W₀] (k : Type) [Field k] (res₀ : W₀ →+* k) (hres₀ : Function.Surjective res₀)
    (B : Type) [CommRing B] [IsNoetherianRing B] [Algebra W₀ B]
    (C : Type) [CommRing C] [Algebra B C] [Module.Finite B C] [Module.Flat B C]
    [Algebra W₀ C] [IsScalarTower W₀ B C]
    (χ : C →+* k) (hχ : ∀ w : W₀, χ (algebraMap W₀ C w) = res₀ w)
    (𝔫 : Ideal C) (h𝔫 : 𝔫 = RingHom.ker χ) :
    ∃ (_ : IsLocalRing (AdicCompletion 𝔫 C)) (_ : IsNoetherianRing (AdicCompletion 𝔫 C))
      (_ : IsAdicComplete (maximalIdeal (AdicCompletion 𝔫 C)) (AdicCompletion 𝔫 C))
      (_ : IsLocalRing (AdicCompletion (𝔫.comap (algebraMap B C)) B))
      (_ : IsNoetherianRing (AdicCompletion (𝔫.comap (algebraMap B C)) B))
      (_ : IsAdicComplete (maximalIdeal (AdicCompletion (𝔫.comap (algebraMap B C)) B))
        (AdicCompletion (𝔫.comap (algebraMap B C)) B))
      (_ : Algebra (AdicCompletion (𝔫.comap (algebraMap B C)) B) (AdicCompletion 𝔫 C))
      (_ : IsScalarTower B (AdicCompletion (𝔫.comap (algebraMap B C)) B) (AdicCompletion 𝔫 C))
      (_ : IsScalarTower W₀ (AdicCompletion (𝔫.comap (algebraMap B C)) B) (AdicCompletion 𝔫 C))
      (_ : Module.Finite (AdicCompletion (𝔫.comap (algebraMap B C)) B) (AdicCompletion 𝔫 C))
      (resS : AdicCompletion 𝔫 C →+* k) (resS₀ : AdicCompletion (𝔫.comap (algebraMap B C)) B →+* k),

      Function.Injective (algebraMap (AdicCompletion (𝔫.comap (algebraMap B C)) B) (AdicCompletion 𝔫 C)) ∧

      (Function.Surjective resS ∧ RingHom.ker resS = maximalIdeal (AdicCompletion 𝔫 C) ∧
        (∀ c : C, resS (algebraMap C (AdicCompletion 𝔫 C) c) = χ c) ∧
        (∀ w : W₀, resS (algebraMap W₀ (AdicCompletion 𝔫 C) w) = res₀ w) ∧
        maximalIdeal (AdicCompletion 𝔫 C) = 𝔫.map (algebraMap C (AdicCompletion 𝔫 C)) ∧
        Function.Surjective (⇑(residue (AdicCompletion 𝔫 C)) ∘ ⇑(algebraMap W₀ (AdicCompletion 𝔫 C))) ∧
        ∀ (T : Type) [CommRing T] [IsLocalRing T] [IsArtinianRing T] [Algebra W₀ T]
          (resT : T →+* k), Function.Surjective resT → RingHom.ker resT = maximalIdeal T →
          (∀ w : W₀, resT (algebraMap W₀ T w) = res₀ w) →
          ∀ φ : C →ₐ[W₀] T, (∀ c : C, resT (φ c) = resS (IsScalarTower.toAlgHom W₀ C (AdicCompletion 𝔫 C) c)) →
            ∃! Φ : AdicCompletion 𝔫 C →ₐ[W₀] T,
              (∀ s : AdicCompletion 𝔫 C, resT (Φ s) = resS s) ∧
                ∀ c : C, Φ (IsScalarTower.toAlgHom W₀ C (AdicCompletion 𝔫 C) c) = φ c) ∧

      (Function.Surjective resS₀ ∧ RingHom.ker resS₀ = maximalIdeal (AdicCompletion (𝔫.comap (algebraMap B C)) B) ∧
        (∀ b : B, resS₀ (algebraMap B (AdicCompletion (𝔫.comap (algebraMap B C)) B) b) = χ (algebraMap B C b)) ∧
        (∀ w : W₀, resS₀ (algebraMap W₀ (AdicCompletion (𝔫.comap (algebraMap B C)) B) w) = res₀ w) ∧
        Function.Surjective (⇑(residue (AdicCompletion (𝔫.comap (algebraMap B C)) B)) ∘
          ⇑(algebraMap W₀ (AdicCompletion (𝔫.comap (algebraMap B C)) B))) ∧
        ∀ (T : Type) [CommRing T] [IsLocalRing T] [IsArtinianRing T] [Algebra W₀ T]
          (resT : T →+* k), Function.Surjective resT → RingHom.ker resT = maximalIdeal T →
          (∀ w : W₀, resT (algebraMap W₀ T w) = res₀ w) →
          ∀ φ : B →ₐ[W₀] T,
            (∀ b : B, resT (φ b) =
              resS₀ (IsScalarTower.toAlgHom W₀ B (AdicCompletion (𝔫.comap (algebraMap B C)) B) b)) →
            ∃! Φ : AdicCompletion (𝔫.comap (algebraMap B C)) B →ₐ[W₀] T,
              (∀ s : AdicCompletion (𝔫.comap (algebraMap B C)) B, resT (Φ s) = resS₀ s) ∧
                ∀ b : B, Φ (IsScalarTower.toAlgHom W₀ B (AdicCompletion (𝔫.comap (algebraMap B C)) B) b) = φ b) := by
  classical

  have hχsurj : Function.Surjective χ := by
    intro a; obtain ⟨w, rfl⟩ := hres₀ a; exact ⟨algebraMap W₀ C w, hχ w⟩
  haveI h𝔫max : 𝔫.IsMaximal := by rw [h𝔫]; exact RingHom.ker_isMaximal_of_surjective χ hχsurj
  haveI : IsNoetherianRing C := IsNoetherianRing.of_finite B C
  haveI h𝔪max : (𝔫.comap (algebraMap B C)).IsMaximal :=
    Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (R := B) (S := C) 𝔫

  set χ₀ : B →+* k := χ.comp (algebraMap B C) with hχ₀
  have hχ₀W : ∀ w : W₀, χ₀ (algebraMap W₀ B w) = res₀ w := by
    intro w; rw [hχ₀, RingHom.comp_apply, ← IsScalarTower.algebraMap_apply W₀ B C]; exact hχ w
  have h𝔪 : 𝔫.comap (algebraMap B C) = RingHom.ker χ₀ := by rw [h𝔫, hχ₀, RingHom.comap_ker]

  obtain ⟨locS, noeS, cplS, resS, hsurjS, hkerS, hresS_C, hresS_W, h𝔪S, hfacS⟩ :=
    glue_hfac_adicCompletion W₀ k res₀ hres₀ C χ hχ 𝔫 h𝔫
  obtain ⟨locS₀, noeS₀, cplS₀, resS₀, hsurjS₀, hkerS₀, hresS₀_B, hresS₀_W, -, hfacS₀⟩ :=
    glue_hfac_adicCompletion W₀ k res₀ hres₀ B χ₀ hχ₀W (𝔫.comap (algebraMap B C)) h𝔪

  obtain ⟨algS₀S, istB, hfin, hinj⟩ :=
    AdicCompletion.exists_algebra_moduleFinite_of_moduleFinite_of_isMaximal B C 𝔫
  letI := algS₀S
  haveI := istB

  have istW : IsScalarTower W₀ (AdicCompletion (𝔫.comap (algebraMap B C)) B) (AdicCompletion 𝔫 C) := by
    refine IsScalarTower.of_algebraMap_eq (fun w => ?_)
    rw [IsScalarTower.algebraMap_apply W₀ B (AdicCompletion (𝔫.comap (algebraMap B C)) B),
      ← IsScalarTower.algebraMap_apply B (AdicCompletion (𝔫.comap (algebraMap B C)) B) (AdicCompletion 𝔫 C),
      IsScalarTower.algebraMap_apply B C (AdicCompletion 𝔫 C),
      IsScalarTower.algebraMap_apply W₀ C (AdicCompletion 𝔫 C), ← IsScalarTower.algebraMap_apply W₀ B C]

  have hresW : ∀ (S' : Type) [CommRing S'] [IsLocalRing S'] [Algebra W₀ S'] (r : S' →+* k),
      RingHom.ker r = maximalIdeal S' → (∀ w : W₀, r (algebraMap W₀ S' w) = res₀ w) →
      Function.Surjective (⇑(residue S') ∘ ⇑(algebraMap W₀ S')) := by
    intro S' _ _ _ r hker hW x
    obtain ⟨s, rfl⟩ := residue_surjective x
    obtain ⟨w, hw⟩ := hres₀ (r s)
    refine ⟨w, ?_⟩
    show residue S' (algebraMap W₀ S' w) = residue S' s
    rw [← sub_eq_zero, ← map_sub, residue_eq_zero_iff, ← hker, RingHom.mem_ker, map_sub, hW, hw, sub_self]
  refine ⟨locS, noeS, cplS, locS₀, noeS₀, cplS₀, algS₀S, istB, istW, hfin, resS, resS₀, hinj inferInstance,
    ⟨hsurjS, hkerS, hresS_C, hresS_W, h𝔪S, hresW _ resS hkerS hresS_W, ?_⟩,
    ⟨hsurjS₀, hkerS₀, fun b => hresS₀_B b, hresS₀_W, hresW _ resS₀ hkerS₀ hresS₀_W, ?_⟩⟩
