variable {M : Type*} [Monoid M] [TopologicalSpace M] [T1Space M] [ContinuousMul M]

private theorem isCompact_preimage_of_comp_eq_embedProduct {X : Type*} [TopologicalSpace X] {τ : Mˣ → X}
    (hτ : Continuous τ) {ρ : X → M × Mᵐᵒᵖ} (hρ : Continuous ρ) (hρτ : ∀ a, ρ (τ a) = Units.embedProduct M a)
    {K : Set X} (hK : IsCompact K) (hKc : IsClosed K) : IsCompact (τ ⁻¹' K) := by
  have hemb : IsClosedEmbedding (Units.embedProduct M) := Units.isClosedEmbedding_embedProduct
  have hS : IsClosed (τ ⁻¹' K) := hKc.preimage hτ
  have himage : IsCompact (Units.embedProduct M '' (τ ⁻¹' K)) := by
    refine (hK.image hρ).of_isClosed_subset (hemb.isClosedMap _ hS) ?_
    rintro _ ⟨a, ha, rfl⟩
    exact ⟨τ a, ha, hρτ a⟩
  have hpre : τ ⁻¹' K = Units.embedProduct M ⁻¹' (Units.embedProduct M '' (τ ⁻¹' K)) :=
    (Set.preimage_image_eq _ hemb.injective).symm
  rw [hpre]
  exact hemb.isCompact_preimage himage

private theorem isCompact_preimage_of_comp_eq_embedProduct_prod {B X : Type*} [TopologicalSpace B] [TopologicalSpace X]
    {τ : Mˣ × B → X} (hτ : Continuous τ) {ρ : X → (M × Mᵐᵒᵖ) × B} (hρ : Continuous ρ)
    (hρτ : ∀ p, ρ (τ p) = (Units.embedProduct M p.1, p.2)) {K : Set X} (hK : IsCompact K) (hKc : IsClosed K) :
    IsCompact (τ ⁻¹' K) := by
  have hemb : IsClosedEmbedding (Prod.map (Units.embedProduct M) (id : B → B)) :=
    Units.isClosedEmbedding_embedProduct.prodMap IsClosedEmbedding.id
  have hS : IsClosed (τ ⁻¹' K) := hKc.preimage hτ
  have himage : IsCompact (Prod.map (Units.embedProduct M) (id : B → B) '' (τ ⁻¹' K)) := by
    refine (hK.image hρ).of_isClosed_subset (hemb.isClosedMap _ hS) ?_
    rintro _ ⟨p, hp, rfl⟩
    exact ⟨τ p, hp, by rw [hρτ p]; rfl⟩
  have hpre : τ ⁻¹' K = Prod.map (Units.embedProduct M) (id : B → B) ⁻¹'
      (Prod.map (Units.embedProduct M) (id : B → B) '' (τ ⁻¹' K)) :=
    (Set.preimage_image_eq _ hemb.injective).symm
  rw [hpre]
  exact hemb.isCompact_preimage himage

private theorem isCompact_preimage_embedProduct {K : Set (M × Mᵐᵒᵖ)} (hK : IsCompact K) (hKc : IsClosed K) :
    IsCompact (Units.embedProduct M ⁻¹' K) :=
  isCompact_preimage_of_comp_eq_embedProduct Units.continuous_embedProduct continuous_id (fun _ => rfl) hK hKc

end
