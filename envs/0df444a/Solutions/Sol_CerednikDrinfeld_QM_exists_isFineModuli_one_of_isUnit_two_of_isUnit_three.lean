    have h : Algebra.FiniteType ℤ (Z6 m) := inferInstance
    convert h <;> first | rfl | exact Subsingleton.elim _ _
  have hm₀ : IsUnit ((m : ℕ) : Z6 m) := isUnit_m m
  have hd₀ : IsUnit ((35 + 1 : ℕ) : Z6 m) := by
    have h := ((isUnit_two m).mul (isUnit_two m)).mul ((isUnit_three m).mul (isUnit_three m))
    have e : (2 : Z6 m) * 2 * (3 * 3) = ((35 + 1 : ℕ) : Z6 m) := by push_cast; norm_num
