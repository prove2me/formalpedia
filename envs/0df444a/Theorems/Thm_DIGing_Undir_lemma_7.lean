-- title:
--   Lemma 7, p. 12 — third arrow y̌ → x̌: ‖x̌‖^{λ,K}_F ≤ α(1−λᴮ)/((λᴮ−δ)(1−λ))‖y̌‖^{λ,K}_F + λᴮ/(λᴮ−δ)Σ_{t=1}^B λ^{1−t}‖x̌(t−1)‖_F
-- statement:
--   Let the mixing matrices satisfy Assumption 1 with integer $B\ge1$, and let $\delta=\sup_{k\ge B-1}\delta(k)$. Let $\lambda>0$ satisfy $\delta<\lambda^B<1$. Let $(\mathbf x(k),\mathbf y(k))$ be generated by DIGing (Algorithm 1) with step size $\alpha>0$, and write $\check{\mathbf v}=\mathbf v-\mathbf 1\bar v^\top$. Then for every $K=0,1,\dots$,
--   $$\|\check{\mathbf x}\|_F^{\lambda,K}\le\frac{\alpha(1-\lambda^B)}{(\lambda^B-\delta)(1-\lambda)}\|\check{\mathbf y}\|_F^{\lambda,K}+\frac{\lambda^B}{\lambda^B-\delta}\sum_{t=1}^B\lambda^{1-t}\|\check{\mathbf x}(t-1)\|_F.$$
--
--   This is the third arrow of the cycle used in the proof of Theorem 10. It is the only arrow whose gain depends on the step size, and the dependence is linear in $\alpha$; this is what lets a small step size close the small-gain loop.
--
--   **Formalization Note.** As in Lemma 6: $\delta$ is the least upper bound of $\{\delta(k):k\ge B-1\}$, $\lambda>0$ is stated as the standing range of the ergodic norm (6), and Assumption 1(ii) includes nonnegative entries. The page omits the proof as "almost identical to that of Lemma 6"; in that argument the role of $\mathbf z(k+1)$ is played by $-\alpha\mathbf y(k)$, one index earlier, which gives exactly the printed gain.
-- source:
--   Nedić, Olshevsky & Shi, arXiv:1607.03218v3, Lemma 7, p. 12

import Mathlib
import Definitions.Def_DIGing_Undir_Common
import Definitions.Def_DIGing_Undir_Setting

namespace DIGing.Undir

theorem lemma_7 {n p : ℕ} (f : Fin n → EuclideanSpace ℝ (Fin p) → ℝ)
    (E : ℕ → SimpleGraph (Fin n)) (W : ℕ → Matrix (Fin n) (Fin n) ℝ) (B : ℕ)
    (h1 : Assumption1 E W B)
    (δ : ℝ) (hδ : IsLUB {d | ∃ k, B - 1 ≤ k ∧ d = deltaK W B k} δ)
    (lam : ℝ) (hlam0 : 0 < lam) (hlam : δ < lam ^ B) (hlam1 : lam ^ B < 1)
    (α : ℝ) (hα : 0 < α) (x y : ℕ → Stack n p) (hrun : IsDIGingRun f W α x y) :
    ∀ K : ℕ, ergK lam K (fun k => frob (cons (x k))) ≤
      α * (1 - lam ^ B) / ((lam ^ B - δ) * (1 - lam)) * ergK lam K (fun k => frob (cons (y k))) +
        lam ^ B / (lam ^ B - δ) * ∑ t ∈ Finset.Icc 1 B, frob (cons (x (t - 1))) / lam ^ (t - 1) := by sorry

end DIGing.Undir
