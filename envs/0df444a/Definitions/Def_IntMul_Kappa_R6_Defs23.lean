-- Source module: Solutions.R6IL3Iface2
/-!
# Round six, item language (I3): the uniform Proposition 14 with explicit size hypotheses

`P14NeedH'` is `IL3.P14NeedH` (same descriptor, stacks, guarantees and cost shape
`C₀ · vol·r · (w+1) · (zsz p + 1) · D^lamp`) with three additional hypotheses on the caller:

1. `zsz (vol·r + w + Ew D) ≤ p`        — the precision dominates the local sizes;
2. `(p + K₀)^5 ≤ 2^K`                   — the chunk width dominates `log p` (field-width guards);
3. `K₀ · D · (zsz p + 1) ≤ K · D^lamp`  — the kernel (reserved) parts, `≈ D (zsz p) / K` levels
   of cost `O(n r (w+1) (zsz p + 1))` each, fit the `(zsz p + 1) D^lamp` budget.

`K₀` is a constant of the construction (existential in `P14UH'`).  All three hold at the
round-six parameters for large `n` and every `K₀` (`IL3.p14_hyps_r6`; (3) is
`ε (2 - lamp) < 1`).
-/

set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL3

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFH NLogN.KFV AModel Butterfly
  IntMul.Kappa.R6.IL

/-- **The uniform Proposition 14 with explicit size hypotheses** (see the module doc). -/
def P14NeedH' {Pp : ℕ} (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp) (e14 : Fin Pp)
    (dS14 : Fin HS) (Ew : ℕ → ℕ) (lamp : ℝ) (K₀ : ℕ) (C₀ : ℝ) : Prop :=
  ∀ {K r Z P D S ρ p w : ℕ} (hρ : ρ < K),
    6 ≤ K → 1 ≤ r → 80 * Z * (Z + 2) ≤ 2 ^ K → 1 ≤ S → 1 ≤ P → 1 ≤ D →
    zsz ((32 * (vol (layerShape P K D S) * r) : ℕ) : ℤ) ≤ Z → zsz (p : ℤ) ≤ Z →
    Ew D ≤ w + 1 → w + Ew D + 2 < 2 ^ Z →
    2 * (2 * Z + 4) ^ 3 + 2 ≤ r → (K * D + P + 10) * (Z + 2) ≤ vol (layerShape P K D S) * r →
    zsz ((vol (layerShape P K D S) * r + w + Ew D : ℕ) : ℤ) ≤ p →
    (p + K₀) ^ 5 ≤ 2 ^ K →
    ((K₀ * D * (zsz (p : ℤ) + 1) : ℕ) : ℝ) ≤ K * (D : ℝ) ^ lamp →
    ∀ (st : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
      (xs : List (Fin r → ℂ)), RecRep r p zs xs →
      xs.length = vol (layerShape P K D S) → f 0 = gflat zs ++ l →
      f dS14 = desc14 P K D S ρ r p w Z → (∀ j, p14Free dS14 j → f j = []) →
      GB w zs → (∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) →
      ∃ (zs' : List GI) (c : ℕ),
        RecRep r p zs' (prop14Proc (P := P) (S := S) hρ p (tens Cm : Butterfly.Op (Fin D)) xs) ∧
        GB (p + 1) zs' ∧
        (∀ j (h : j < (prop14Proc (P := P) (S := S) hρ p (tens Cm : Butterfly.Op (Fin D)) xs).length)
          (h' : j < (layerH P K D S ρ hρ xs).length), ∀ c,
          ‖(prop14Proc (P := P) (S := S) hρ p (tens Cm : Butterfly.Op (Fin D)) xs)[j] c -
            (layerH P K D S ρ hρ xs)[j] c‖ < Real.sqrt 2 * 2⁻¹ ^ p) ∧
        IRuns Isym tbl (.call e14) (encK st f) (encK st (Function.update f 0 (gflat zs' ++ l))) c ∧
        (c : ℝ) ≤ C₀ * ((vol (layerShape P K D S) * r : ℕ) : ℝ) * (w + 1) * ((zsz (p : ℤ) : ℝ) + 1) *
          (D : ℝ) ^ lamp

/-- **Uniform Proposition 14, round six, explicit-hypothesis form.** -/
def P14UH' (tab : Fin 1 → IStmt HS 1) (Ew : ℕ → ℕ) (lamp : ℝ) : Prop :=
  ∃ (nU : ℕ) (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
    (entry : Fin nU) (dS14 : Fin HS) (K₀ : ℕ) (C₀ : ℝ),
    dS14 = 36 ∧ 0 ≤ C₀ ∧
    ∀ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (idx : Fin nU → Fin (7 + E)),
      (∀ i, kTableP tab ext (idx i) = U E idx i) →
      ∀ Isym : List Sym, P14NeedH' Isym (kTableP tab ext) (idx entry) dS14 Ew lamp K₀ C₀

end IntMul.Kappa.R6.IL3

end

section
-- Source module: Solutions.R6IL3Top16
/-!
# Round six, item language (I3): the uniform Proposition 14 with explicit size hypotheses

**`p14UH'_of`**: for a configuration `c` (`CfgOK c`), exponents `0 ≤ τ ≤ θ ≤ lamp ≤ 1`, a
level constant `Cc` with the moment condition of `cbRec_of`, and compact-control row additions
`RowUCCP c.m τ tab` in every extension of `kTableP tab`, the uniform Proposition 14
`P14UH' tab (EwH c) lamp` holds, with `K₀ = K0c c = 2^{Zc c}` and `C₀ = C0c c Kc Cc`.

The procedure list `UUH` places the level procedure (`0`), the kernel loop (`1`), the
size loop (`2`), the field-width loop (`3`), the depth loop with the core and the body (`4`),
the entry (`5`), and then the row procedures.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

