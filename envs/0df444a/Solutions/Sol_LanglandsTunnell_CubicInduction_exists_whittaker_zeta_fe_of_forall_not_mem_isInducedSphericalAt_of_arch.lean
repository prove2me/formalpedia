variable {K : Type*} [Field K] [TopologicalSpace K] [IsTopologicalRing K] [LocallyCompactSpace K] [MeasurableSpace K]
  (μ : Measure K)

private theorem mulMeasure_apply_of_subset {s : Set K} (hs : MeasurableSet s) (hs0 : s ⊆ ({0}ᶜ : Set K)) :
    mulMeasure μ s = ∫⁻ x in s, dens x ∂μ := by
  unfold mulMeasure
  rw [withDensity_apply _ hs, Measure.restrict_restrict hs, Set.inter_eq_left.mpr hs0]
  rfl

end
