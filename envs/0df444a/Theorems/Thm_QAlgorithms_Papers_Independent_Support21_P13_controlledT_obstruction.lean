-- title:
--   Controlled-T cannot be implemented on two wires
-- statement:
--   Let $C_T=\operatorname{diag}(1,1,1,\omega)$, where $\omega=e^{i\pi/4}$. For every circuit $c$ on exactly two wires over the gates $H,P,T,\mathrm{CNOT}$, where $P=\operatorname{diag}(1,i)$, write $M(c)$ for its full matrix. Then
--
--   $$
--   M(c)\ne C_T,\qquad \nexists a\in\mathbb C:\ |a|=1\ \text{and}\ M(c)=aC_T.
--   $$
--
--   The scalar phase multiplies the whole four-dimensional matrix. This establishes the obstruction without an ancillary wire, independently of the multiqubit conjecture.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 3, §2 unnumbered: controlled-T cannot be synthesized on two qubits

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Section 2, PDF p.3: controlled-T is impossible on two wires, even up to a
single global scalar phase. No clean ancilla and no conjecture are assumed. -/
theorem controlledT_obstruction (c : QAlgorithms.Circuit cliffordTLibrary 2) :
    c.unitary ≠ controlledT ∧
      ¬ ∃ a : ℂ, ‖a‖ = 1 ∧ c.unitary = a • controlledT := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
