theorem NetScalar.bit_exchange_net {M : Type*} [AddGroup M] (hcard : ∀ t, #(ind t) = 3)
    (hinj : Function.Injective ind) (lab : NetScalar.GName T → M) :
    (∀ g ∈ bitGatesL ind lab, g.OK) ∧
      ∀ (v : NetScalar.Wr ind → ZMod 2) w, scalarRun (bitGatesL ind lab) v (NetScalar.ρ ind w) = v w := by sorry
