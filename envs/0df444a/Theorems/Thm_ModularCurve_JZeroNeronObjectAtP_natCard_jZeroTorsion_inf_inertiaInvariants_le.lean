theorem ModularCurve.JZeroNeronObjectAtP.natCard_jZeroTorsion_inf_inertiaInvariants_le
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (Λ : JZeroNeronObjectAtP.LevelData N₀ p A) (hΛ : Λ.IsJacobian)
    (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (n : ℕ) (hn : 0 < n) :
    Nat.card ↥(jZeroTorsion (N₀ * p) n ⊓ inertiaInvariants A (N₀ * p)) ≤
      Nat.card ↥(O.finPts n) * Nat.card (componentGroup O.width) := by sorry
