-- Source module: NLogN.HBd2
/-!
# Crude magnitude bounds, part 2: list plumbing, the Fermat convolution and the pipeline

* `chunkL_LB`, `transposeL_LB`, `flatMap_LB`, `tensorGo_LB` (general bound function `g`),
  `tensorGo_LB_mul` (factor `c` per axis).
* `kunpack_natAbs_le`, `decBlk_LB`, `fermatW_LB`: every output entry of `fermatW` has
  components `≤ 2^P`, unconditionally; `convL_LB`, `FtL_LB` (unconditional as well).
* `fwdL_stages`, `fwdL_LB`, `exactConvL` intermediates, `crtIn`/`crtOut`/`chunksL`.
* `refStep_bounds`: all intermediate lists of `refStep q x y` for a general `q` satisfying
  `HJ q` (every `jIter` is at most `Jm q`).
-/

set_option linter.unusedSimpArgs false

namespace NLogN.BD

open IntMul.HvdH IntMul.HvdH.Ref

/-! ## List plumbing -/

/-! ## Integer lists -/

/-! ## The Fermat convolution -/

/-- The bound `2 · 2^P / 2^(p+logT)` of the DFT oracle (unconditional). -/
def BC (q : Params) : ℕ := 2 * (2 ^ q.P / 2 ^ (q.p + q.logT))

/-! ## `fwdL` -/

/-- The `S̃` axes of `fwdL`. -/
def axS (q : Params) : List (ℕ × (List (ℤ × ℤ) → List (ℤ × ℤ))) :=
  (List.range q.K).map fun i => (2 ^ q.te i, sapL q.p (q.s.getD i 1) (2 ^ q.te i) q.α)

/-- The `B̃` axes of `fwdL`. -/
def axB (q : Params) : List (ℕ × (List (ℤ × ℤ) → List (ℤ × ℤ))) :=
  (List.range q.K).map fun i => (q.s.getD i 1, bapL q.p (q.s.getD i 1) (2 ^ q.te i) q.α)

/-- The FtL input inside `fwdL`. -/
def ftIn (q : Params) (U : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  List.zipWith (fun a u => mulZ q.p (conjZ a) u) (chirpL q) (tensorGo (axS q) q.sdims U)

/-- Uniform bound on the number of Neumann terms: `4Kp/α² + 1`. -/
def Jm (q : Params) : ℕ := 4 * q.K * q.p / q.α ^ 2 + 1

/-- Hypothesis: every axis has `jIter ≤ Jm q`. -/
def HJ (q : Params) : Prop := ∀ i < q.K, jIter q.p (q.s.getD i 1) (2 ^ q.te i) q.α ≤ Jm q

/-- Per-axis factors. -/
def cSq (q : Params) : ℕ := cS1 q.p q.α
def cBq (q : Params) : ℕ := cB1 q.p q.α (Jm q)

/-- `fwdL` output bound (independent of the input). -/
def BF (q : Params) : ℕ := cBq q ^ q.K * NLogN.BD.BC q

/-! ## `exactConvL` -/

/-- The scaled input `U` of `exactConvL`. -/
def ecU (q : Params) (u : List ℤ) : List (ℤ × ℤ) := u.map fun a => (a * 2 ^ (q.p - q.b), (0 : ℤ))

/-- The pointwise product `W` of `exactConvL`. -/
def ecW (q : Params) (u v : List ℤ) : List (ℤ × ℤ) :=
  List.zipWith (fun a b => conjZ (mulZ q.p a b)) (fwdL q (ecU q u)) (fwdL q (ecU q v))

/-- `Y = fwdL W`. -/
def ecY (q : Params) (u v : List ℤ) : List (ℤ × ℤ) := fwdL q (ecW q u v)

/-- The bound of `W`. -/
def BW (q : Params) : ℕ := 2 * BF q * BF q / 2 ^ q.p

/-- The output bound of `exactConvL`. -/
def BX (q : Params) : ℕ := BF q * q.S ^ 2 * 2 ^ (2 * q.b + 6 * q.K * q.α ^ 2) / 2 ^ q.p + 2

/-! ## The whole step -/

/-- The input digits on the source box. -/
def rU (q : Params) (x : ℕ) : List ℤ := crtIn q.s (chunksL q.b q.L x)

end NLogN.BD

end

