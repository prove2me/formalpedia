theorem solution (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (ζ : ℂ)
    (hζ : ζ ^ t (Fin.last D) = -1) (f g : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) :
    (fun j => (NLogN.KFM.twX t ζ j)⁻¹) * NLogN.KFM.mrX t (NLogN.KFM.twX t ζ * f) (NLogN.KFM.twX t ζ * g) =
      fun j => (∏ i, (t i : ℂ))⁻¹ * IntMul.OpenAI.RC.cconv t f g j := by
  have hζ0 : ζ ≠ 0 := by
    rintro rfl
    rw [zero_pow (NeZero.ne _)] at hζ; norm_num at hζ
  funext j
  simp only [Pi.mul_apply, NLogN.KFM.mrX, IntMul.OpenAI.RC.cconv, NLogN.KFM.twX]
  have key : ∀ k : (i : Fin (D + 1)) → ZMod (t i),
      ζ ^ (k (Fin.last D)).val * f k * (ζ ^ ((j - k) (Fin.last D)).val * g (j - k)) *
        (if (k (Fin.last D)).val ≤ (j (Fin.last D)).val then 1 else -1) =
      ζ ^ (j (Fin.last D)).val * (f k * g (j - k)) := by
    intro k
    rw [← NLogN.KFM.zeta_sgn ζ hζ (k (Fin.last D)) (j (Fin.last D))]
    simp only [Pi.sub_apply]
    ring
  simp_rw [key, ← Finset.mul_sum]
  field_simp
