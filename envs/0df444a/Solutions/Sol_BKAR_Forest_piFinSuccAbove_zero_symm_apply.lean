theorem _root_.solution
    {n : ℕ} (t : ℝ) (us : Fin n → ℝ) :
    (MeasurableEquiv.piFinSuccAbove
      (fun _ : Fin (n + 1) => ℝ) 0).symm (t, us) =
      Fin.cons t us := by
  ext i
  cases i using Fin.cases with
  | zero =>
      simp [MeasurableEquiv.piFinSuccAbove_symm_apply,
        Fin.insertNthEquiv]
  | succ i =>
      simp [MeasurableEquiv.piFinSuccAbove_symm_apply,
        Fin.insertNthEquiv]
end BKAR.Forest
