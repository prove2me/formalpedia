/-!
# B-line IL, `J` pre-table (B5-J), part 1: steps and triples on the register file

On top of the register file `RF v c` of `J6SegILPre2`:

* reads of arbitrary stacks: an expression may read a register of `rg` or the top of any
  non-empty stack outside `rg` (`Rd c e`); its value `ev v c e` does not depend on the base state;
* the elementary steps `sA` (assign a register), `sAo` (assign the top of a stack outside `rg`),
  `sU` (push), `sO` (pop), `sMv` (`mvK`), and `sRd` (random read of a list entry);
* Hoare triples `Tr p P Q C` (`∀ s`, from every `RF v c` with `P v c` to some `RF v' c'` with
  `Q v' c'`, cost `≤ C`), with `seq`, consequence and the counted loop `Tr.rep`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS

/-! ## Reads -/

/-- Expressions reading only stacks below `56` are clean. -/
theorem clean_of_regs {e : Ex HS} (h : ∀ i ∈ e.regs, i.val < 56) : e.Clean :=
  fun i hi => clean_of_lt (h i hi) i (by simp [Ex.regs])

/-! ## Elementary steps -/

section steps
variable (s : IState HS) (v : Vr) (c : Cs)

/-- Push onto a stack outside `rg`. -/
theorem sU {i : Fin HS} (hi : i ∉ rg) (hi5 : i.val < 56) {e : Ex HS} (hR : Rd c e) (hc : e.Clean)
    (ho : okR v c e) {V B : ℕ} (hv : ∀ j ∈ e.regs, |tp v c j| ≤ V) (hm : mg V e < 2 ^ B) :
    Sp (.push i e) (encK s (RF v c)) (encK s (RF v (Function.update c i (ev v c e :: c i))))
      (cE e B) := by
  have h := Sp.pushQ s (RF v c) hi5 hc (ok_RF hR ho) (bnd_RF hR hv hm)
  rw [upd_RF_out hi, RF_out hi, eval_RF hR] at h
  exact h

/-- Pop from a stack outside `rg`. -/
theorem sO {i : Fin HS} (hi : i ∉ rg) (hi5 : i.val < 56) {a : ℤ} {l : List ℤ} (hci : c i = a :: l)
    {B : ℕ} (ha : zsz a ≤ B) :
    Sp (.pop i) (encK s (RF v c)) (encK s (RF v (Function.update c i l))) (2 * B + 2) :=
  spO s v c hi hi5 hci ha

end steps

