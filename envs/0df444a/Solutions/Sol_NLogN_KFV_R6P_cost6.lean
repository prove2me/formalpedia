section
-- Source module: Solutions.R6P18Lay
/-!
# Round six, Proposition 18: the layout and round costs with one chunk per axis

At the round-six parameters `K = ℓ - 1` (Idea C), so `q = ⌊(ℓ-1)/K⌋ = 1` and
`b = (ℓ-1) mod K = 0`. Then

* phase 3 of the layout has `D` steps whose exchange is trivial (`xT t = t`, cost `1`):
  **`cLayIn_q1`**, **`cLayOut_q1`**: the layout programs cost `≤ 10^6 (D+1)(W+1) 2^{n+ℓ}`
  (no exchange is ever called, so the swap's exponent does not enter the cost);
* there are no prefix leaves: **`cFwd_q1`**, **`cOpp_q1`**: the Lemma 16 procedures cost
  `≤ 10^12 (W+1) X (ℓ + 2(D+1)) + ℓ · cCh`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV.R6P

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12 GlueLayout GlueP14 GlueError

theorem qq_one {ℓ K : ℕ} (hKl : K + 1 = ℓ) (hK : 0 < K) : qq ℓ K = 1 := by
  unfold qq; rw [show ℓ - 1 = K by omega]; exact Nat.div_self hK

theorem bb_zero {ℓ K : ℕ} (hKl : K + 1 = ℓ) : bb ℓ K = 0 := by
  unfold bb; rw [show ℓ - 1 = K by omega]; exact Nat.mod_self K

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

theorem xT_id (hq : qq ℓ K = 1) {t : ℕ} (ht : t < D) :
    xT (srcP D ℓ K) (D * qq ℓ K) t = t := by
  have hs : srcP D ℓ K t = t := by
    show srcT D (qq ℓ K) t = t
    rw [hq]; unfold srcT; rw [Nat.mod_eq_of_lt ht, Nat.div_eq_of_lt ht]; ring
  unfold xT; rw [hs]; exact chF_ge _ le_rfl _

theorem cBody3_q1 (Kc : ℝ) (hq : qq ℓ K = 1) {n W B t : ℕ} (hO : OvOK n ℓ B)
    (hN : D * qq ℓ K ≤ B) (ht : t < D) :
    cBody3 D ℓ K Kc n W B t + 64 ≤ 2 ^ (n + ℓ) := by
  have := chase_ovh_le (n := n) (ℓ := ℓ) hO hN
  have := asg_le sz_inc B
  unfold cBody3
  rw [if_pos (xT_id D ℓ K hq ht)]
  linarith

theorem cBody3R_q1 (Kc : ℝ) (hq : qq ℓ K = 1) {n W B j : ℕ} (hO : OvOK n ℓ B)
    (hN : D * qq ℓ K ≤ B) (hj : j < D) :
    cBody3R D ℓ K Kc n W B j + 64 ≤ 2 ^ (n + ℓ) := by
  have := chase_ovh_le (n := n) (ℓ := ℓ) hO hN
  have := asg_le sz_dec B
  unfold cBody3R
  rw [if_pos (xT_id D ℓ K hq (by rw [hq]; omega))]
  linarith

theorem cPh3_q1 (Kc : ℝ) (hq : qq ℓ K = 1) {n W B : ℕ} (hO : OvOK n ℓ B)
    (hN : D * qq ℓ K ≤ B) :
    cPh3 D ℓ K Kc n W B ≤ D * 2 ^ (n + ℓ) + 2 ^ (n + ℓ) := by
  have hs : ∑ t ∈ Finset.range (D * qq ℓ K), (cBody3 D ℓ K Kc n W B t + 64) ≤
      ∑ t ∈ Finset.range (D * qq ℓ K), 2 ^ (n + ℓ) :=
    Finset.sum_le_sum fun t ht => cBody3_q1 D ℓ K Kc hq hO hN (by
      rw [Finset.mem_range, hq, mul_one] at ht; exact ht)
  rw [Finset.sum_const, Finset.card_range, smul_eq_mul] at hs
  have := loop_ovh_le ℓ (W := W) hO hN
  unfold cPh3
  rw [hq, mul_one] at hs this ⊢
  omega

theorem cPh3R_q1 (Kc : ℝ) (hq : qq ℓ K = 1) {n W B : ℕ} (hO : OvOK n ℓ B)
    (hN : D * qq ℓ K ≤ B) :
    cPh3R D ℓ K Kc n W B ≤ D * 2 ^ (n + ℓ) + 2 ^ (n + ℓ) := by
  have hs : ∑ t ∈ Finset.range (D * qq ℓ K), (cBody3R D ℓ K Kc n W B t + 64) ≤
      ∑ t ∈ Finset.range (D * qq ℓ K), 2 ^ (n + ℓ) :=
    Finset.sum_le_sum fun t ht => cBody3R_q1 D ℓ K Kc hq hO hN (by
      rw [Finset.mem_range, hq, mul_one] at ht; exact ht)
  rw [Finset.sum_const, Finset.card_range, smul_eq_mul] at hs
  have := loop_ovh_le ℓ (W := W) hO hN
  unfold cPh3R
  rw [hq, mul_one] at hs this ⊢
  omega

/-- **The layout-in program with one chunk per axis.** -/
theorem cLayIn_q1 (Kc : ℝ) (hK : 0 < K) (hKl : K + 1 = ℓ) (hℓ : 2 ≤ ℓ)
    {n W B : ℕ} (hO : OvOK n ℓ B) (hn : n = (pLP D ℓ K long).n) (hB : n + ℓ + 5 ≤ B)
    (hNB : D * qq ℓ K + D + 1 ≤ B) :
    cLayIn D ℓ K long Kc n W B ≤ 10 ^ 6 * (D + 1) * (W + 1) * 2 ^ (n + ℓ) := by
  have hq := qq_one hKl hK
  have hb := bb_zero hKl
  have hn' : n = nLong D long + D * (ℓ - 1) := by rw [hn, pLP_n D ℓ K long hK (by omega)]
  have h1 := cPh1_le D ℓ long (W := W) hO hℓ hn' hB
  have h2 := cPh2_le D ℓ K long (W := W) hK hℓ (by omega) hO hn hB
  have h3 := cPh3_q1 D ℓ K Kc hq (W := W) hO (by omega)
  rw [hb, Nat.zero_mul, Nat.zero_mul] at h2
  unfold cLayIn
  set X := 2 ^ (n + ℓ)
  set Y := (W + 1) * X with hY
  have hXY : X ≤ Y := Nat.le_mul_of_pos_left _ (by omega)
  have hDXY : D * X ≤ D * Y := Nat.mul_le_mul_left _ hXY
  have e1 : D * (10 ^ 5 * (W + 1) * X) = 10 ^ 5 * (D * Y) := by rw [hY]; ring
  have e2 : 10 ^ 6 * (D + 1) * (W + 1) * X = 10 ^ 6 * (D * Y) + 10 ^ 6 * Y := by rw [hY]; ring
  rw [e1] at h1; rw [e2]
  omega

/-- **The layout-out program with one chunk per axis.** -/
theorem cLayOut_q1 (Kc : ℝ) (hK : 0 < K) (hKl : K + 1 = ℓ) (hℓ : 2 ≤ ℓ)
    {n W B : ℕ} (hO : OvOK n ℓ B) (hn : n = (pLP D ℓ K long).n) (hB : n + ℓ + 5 ≤ B)
    (hNB : D * qq ℓ K + D + 1 ≤ B) :
    cLayOut D ℓ K long Kc n W B ≤ 10 ^ 6 * (D + 1) * (W + 1) * 2 ^ (n + ℓ) := by
  have hq := qq_one hKl hK
  have hb := bb_zero hKl
  have hn' : n = nLong D long + D * (ℓ - 1) := by rw [hn, pLP_n D ℓ K long hK (by omega)]
  have h1 := cPh1R_le D ℓ long (W := W) hO hℓ hn' hB
  have h2 := cPh2R_le D ℓ K long (W := W) hK hℓ (by omega) hO hn hB
  have h3 := cPh3R_q1 D ℓ K Kc hq (W := W) hO (by omega)
  rw [hb, Nat.zero_mul, Nat.zero_mul] at h2
  unfold cLayOut
  set X := 2 ^ (n + ℓ)
  set Y := (W + 1) * X with hY
  have hXY : X ≤ Y := Nat.le_mul_of_pos_left _ (by omega)
  have hDXY : D * X ≤ D * Y := Nat.mul_le_mul_left _ hXY
  have e1 : D * (10 ^ 5 * (W + 1) * X) = 10 ^ 5 * (D * Y) := by rw [hY]; ring
  have e2 : 10 ^ 6 * (D + 1) * (W + 1) * X = 10 ^ 6 * (D * Y) + 10 ^ 6 * Y := by rw [hY]; ring
  rw [e1] at h1; rw [e2]
  omega

end Paper

end NLogN.KFV.R6P

