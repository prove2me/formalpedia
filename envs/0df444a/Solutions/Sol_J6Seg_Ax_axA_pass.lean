      rw [hf] at hl ⊢
      exact ⟨hgl q x hl, hgB q hq x hl hx.2⟩) hK.TBk hK.TL
  refine (axA_chain hA0 (M := t / (16 * H)) rfl hf ht0 hp hsG h1
    (fxF_ok w 5 1 (pre * (t * post)) (hy1 hpre0 (hy1 ht0 hp)) hFine hF0 hFA hA0 hS2)
    (fxB_ok w 5 pre (t * post) (hy1 ht0 hp) hFine hF0 hFA hA0 hS3)
    (slabId_ok hfree hsG (by positivity) hS4)
    (fxF_ok w 3 pre (t / (16 * H) * (8 * H) * post) (hy1 (hy1 hM0 hH8) hp) hFine hF0 hFA
      hA0 hS5)
    (fxB_ok w 3 (pre * (t / (16 * H))) (8 * H * post) (hy1 hH8 hp) hFine hF0 hFA hA0 hS6)
    h7
    (slabId_ok hfree hsC (by positivity) hS8)
    hK.AB hgl hgB).mono (le_of_eq ?_)
  unfold axACost cSlabA; ring

