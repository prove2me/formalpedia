variable [mT : MeasurableSpace Aˣ] [OpensMeasurableSpace Aˣ]

private theorem integrable_torusTranslate_mul (μ : Measure Aˣ) [IsFiniteMeasureOnCompacts μ] {W : GL (Fin 3) A → ℂ}
    (hW : Continuous W) (hWc : HasCompactSupport W) {c w : Aˣ → ℂ} (hc : Continuous c) (hw : Continuous w)
    (g : GL (Fin 3) A) : Integrable (fun a : Aˣ => W (iotaGL (diagUnitGL2 a) * g) * c a * w a) μ := by
  refine Continuous.integrable_of_hasCompactSupport ?_ ?_
  · exact ((hW.comp (continuous_torusTranslate g)).mul hc).mul hw
  · exact ((hasCompactSupport_torusTranslate hWc g).mul_right).mul_right

end
