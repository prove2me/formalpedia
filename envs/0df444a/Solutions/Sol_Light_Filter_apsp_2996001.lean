    (hsol : SolvesN lopCountTask P₀ pS Tn need) :
    SolvesN oracleTask (P₀ ++ oracleProcs pS P₀.length) (P₀.length + 12) (oracleTime Tn)
      (oracleNeed need) := by
  refine ⟨oracleBody (P₀.length) (P₀.length + 1) (P₀.length + 11), ?_,
    fun R lim d x μ fr hpre hok => ?_⟩
  · have htop := getElem?_append_append (P₀ := P₀) (B := oracleProcs pS P₀.length) [] (i := 12)
      rfl
    rwa [List.append_nil] at htop
  · rw [List.append_assoc]
    exact oracle_spec (oracleCtx_assembled hsol R) x μ fr hpre hok

