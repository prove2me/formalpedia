theorem solution
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (P : ValuationSubring (AlgebraicClosure ℚ)) (hP : P.LiesOverPrime q) :
    ∃ R₀ : AlgebraicCurve.ConstantReduction P ↥(ModularCurve.modularFunctionFieldBar M')
        (modularFunctionFieldC (IsLocalRing.ResidueField P) M'),
      ∀ (y : LaurentSeries ↥P) (hy : ModularCurve.coeffMap P.subtype y ∈ ModularCurve.modularFunctionFieldBar M'),
        ∃ h : (⟨ModularCurve.coeffMap P.subtype y, hy⟩ : ↥(ModularCurve.modularFunctionFieldBar M')) ∈ R₀.integers,
          ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (IsLocalRing.ResidueField P) M') :
              LaurentSeries (IsLocalRing.ResidueField P)) =
            ModularCurve.coeffMap (IsLocalRing.residue ↥P) y := by
  classical
  haveI : CharP (ResidueField P) q := charP_residueField q P hP

  obtain ⟨-, hRI⟩ := ModularCurve.exists_transcendental_and_reductionInputsQExpModL_gammaH_of_not_dvd M'
    (⊤ : Subgroup (ZMod M')ˣ) hqM' P hP
  have h0 : ModularCurve.ReductionInputsQExpModL P (CongruenceSubgroup.Gamma0 M') := by
    rw [← CohCarrier.GammaH_top]; exact hRI
  obtain ⟨R, -, -, hlaw⟩ := ModularCurve.exists_constantReduction_pic0Map_eq_reductionQExpModL
    (CongruenceSubgroup.Gamma0 M') (translation_mem_Gamma0 M') P h0

  obtain ⟨R', -, hR'⟩ := ModularCurve.exists_regularProlongation_laurentBaseChange_qExpFunctionFieldC
    (AlgebraicClosure ℚ) P (CongruenceSubgroup.Gamma0 M') (translation_mem_Gamma0 M')
  have law : ∀ (y : LaurentSeries P)
      (hy : ModularCurve.coeffMap P.subtype y ∈
        ModularCurve.laurentBaseChange (AlgebraicClosure ℚ) (ModularCurve.qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma0 M'))),
      ∃ h : (⟨ModularCurve.coeffMap P.subtype y, hy⟩ :
          ModularCurve.laurentBaseChange (AlgebraicClosure ℚ)
            (ModularCurve.qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma0 M'))) ∈ R.integers,
        ((R.residue ⟨_, h⟩ : ModularCurve.qExpFunctionFieldC (ResidueField P) (CongruenceSubgroup.Gamma0 M')) :
            LaurentSeries (ResidueField P)) = ModularCurve.coeffMap (IsLocalRing.residue P) y := by
    intro y hy
    obtain ⟨hO', hres'⟩ := hR' y hy
    have hyk : ModularCurve.coeffMap (IsLocalRing.residue P) y ∈
        ModularCurve.qExpFunctionFieldC (ResidueField P) (CongruenceSubgroup.Gamma0 M') := by
      rw [← hres']; exact (R'.residue _).2
    obtain ⟨hO, hres⟩ := hlaw y hy hyk
    exact ⟨hO, by rw [hres]⟩

  have hE : ModularCurve.laurentBaseChange (AlgebraicClosure ℚ)
      (ModularCurve.qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma0 M')) = ModularCurve.modularFunctionFieldBar M' := by
    rw [ModularCurve.qExpFunctionFieldC_rat_gamma0_eq_modularFunctionFieldFull]
  have hE' : ModularCurve.qExpFunctionFieldC (ResidueField P) (CongruenceSubgroup.Gamma0 M') =
      ModularCurve.modularFunctionFieldC (ResidueField P) M' :=
    ModularCurve.qExpFunctionFieldC_gamma0_eq_modularFunctionFieldC_of_not_dvd (ResidueField P) M' q hqM'
  exact transport P _ _ hE _ _ hE' (ModularCurve.coeffMap P.subtype) (ModularCurve.coeffMap (IsLocalRing.residue P)) R law

