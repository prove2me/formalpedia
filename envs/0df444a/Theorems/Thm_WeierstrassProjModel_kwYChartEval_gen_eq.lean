variable (R : Type u) [CommRing R] (W : WeierstrassCurve R)

theorem WeierstrassProjModel.kwYChartEval_gen_eq (m : Fin 3) :
    kwYChartEval R W (kw_lrChart_gen W 1 m) = ![(0:R), 1, 0] m := by sorry
