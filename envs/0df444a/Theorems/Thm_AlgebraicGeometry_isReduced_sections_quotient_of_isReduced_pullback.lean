    (V : X.Opens) (hV : IsAffineOpen V) :
    letI := ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ f.appLE ⊤ V le_top).hom.toAlgebra
    _root_.IsReduced (Γ(X, V) ⧸ Ideal.span {algebraMap R Γ(X, V) ϖ}) := by sorry
