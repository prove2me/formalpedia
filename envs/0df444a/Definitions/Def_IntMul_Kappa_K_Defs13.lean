section
-- Source module: Solutions.KFDShift
/-!
# KFD: closed bounds for the fine gather / scatter, fine shifts

* `sq_zsz_le`: `(zsz x + 2)² ≤ 18 x` for `x ≥ 1` (local per-block numbers cost `O(block)`).
* closed bounds of `cDivPgUF`, `cMulPgUF` with the local choices `b = 2c`, `bL = zsz (c·Q·B)`:
  `≤ 10^10 (c+1)^3 (V+1)(w+2) + 10^8 (c+1)(Bb+2)²`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KIL AModel

/-! ## Closed bounds of the gather / scatter pieces -/

section Bounds

variable {Q c B w b bL : ℕ}

end Bounds

section Bounds2

variable {P Q c B w b bL Bb : ℕ}

end Bounds2

/-! ## Fine `fdivPU` / `fmulPU` -/

/-- Closed cost of the fine `fdivPU d` / `fmulPU d`. -/
def cFrF (d V w Bb : ℕ) : ℕ :=
  10 ^ 10 * ((d + 1) ^ 3 * ((V + 1) * (w + 2))) + 10 ^ 8 * ((d + 1) * (Bb + 2) ^ 2)

/-! ## Fine table shifts -/

/-- Closed cost of the fine `shPU` / `shNU`. -/
def cShUF (nst V w Bb : ℕ) : ℕ :=
  2 * 10 ^ 12 * ((nst + 1) * ((V + 1) * (w + 2))) + 2 * 10 ^ 8 * (Bb + 2) ^ 2

section Body

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

/-- Closed cost of the fine `shFracU`. -/
def cShFF (k d nst V w Bb : ℕ) : ℕ := cFrF d V w Bb + cFrF k V w Bb + cShUF nst V w Bb

end Body

end KFD

end NLogN

end

section
-- Source module: Solutions.KFDStep
/-!
# KFD: the fine uniform level step

`stepG_fspec` / `stepU_fspec`: the KIL4 step programs (unchanged) with fine cost
`cStepGF`; the data bound `w` and the global bound `Bb` are separate.
`cStepGF_le`: `cStepGF ≤ tKF·(10^13 (V+1)(w+2) + 10^10 (Bb+2)²)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedVariables false

namespace NLogN

open IntMul RS

namespace KFD

open KIL AModel AModelL12

/-- Fine cost of `stepG`. -/
def cStepGF (k d nst V w Bb : ℕ) (pa pc : Ex HS) (stg : List (Ex HS × Ex HS)) : ℕ :=
  100 * pushCost Bb (prmL pa pc ++ stgPush stg) + cShFF k d nst V w Bb + 100 * (4 * (2 * Bb + 2) + 1)

section Body

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

end Body

variable {m : ℕ}

/-- Fine step weight of a template. -/
def tKF (rX : Fin HS) (T : TSh m) : ℕ :=
  pushSz (prmL (paT rX T) (pcT T) ++ stgPush (stgT rX T)) + (T.k + 1) ^ 3 + (T.d + 1) ^ 3 +
    (stgT rX T).length + 3

def cStepsUF (rX : Fin HS) (V w Bb : ℕ) : List (TSh m) → ℕ
  | [] => 1
  | T :: Ts => cStepGF T.k T.d (stgT rX T).length V w Bb (paT rX T) (pcT T) (stgT rX T) +
      cStepsUF rX V w Bb Ts

def tKFs (rX : Fin HS) (Ts : List (TSh m)) : ℕ := (Ts.map (tKF rX)).sum

end KFD

end NLogN

end

section
-- Source module: Solutions.KFDTab
/-!
# KFD: fine stream-table operations

The register programs `copyCU`, `accCU`, `accLU`, `buildCU`, `buildsCU`, `rebuildCU` of KIL5Tab
are unchanged; here they get *fine* specifications (`FSp`, i.e. compiled by `fcode`, unary loop
counters).  The cost unit is `cCF V Bb = O(V) + O((Bb + 2)^2)`: linear in the table volume
`V = W · v`, plus one multiplication (`w · v`) per operation.  `applyCF` is the fine `applyCU`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KIL

/-- Fine cost unit of an element loop over at most `V` bits. -/
def cOF (V Bb : ℕ) : ℕ := 10 ^ 6 * (V + 1) + 1000 * (Bb + 2)

/-- Fine cost unit of one table operation. -/
def cCF (V Bb : ℕ) : ℕ := 1000 * cOF V Bb + cPushT Bb + (2 * Bb + 2)

/-- Fine cost of a rebuild. -/
def cRebuildF (W V Bb : ℕ) : ℕ := (W * (2 * W + 2) + 202) * cCF V Bb

/-! ## Fine compilability of the table programs -/

/-! ## Applying a stream code in place (fine) -/

section Apply

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The fine `applyCU`. -/
def applyCF (w : ℕ) (code : IStmt HS Pp) : IStmt HS Pp :=
  .seq (fcode (RS.seq (.push NLogN.KIL.rT (.mul (.lit (w : ℤ)) (.reg NLogN.KIL.rV))) (NLogN.mvK 0 15 21 (.reg NLogN.KIL.rT))))
    (.seq code (fcode (RS.seq (NLogN.mvK 15 0 21 (.reg NLogN.KIL.rT)) (.pop NLogN.KIL.rT))))

end Apply

end KFD

end NLogN

end

section
-- Source module: Solutions.KFDNet
/-!
# KFD: the fine network of one level

KIL5Net's `framesU_runs`, `gateCU_runs`, `netCU_runs` for the fine table code (`applyCF`,
`fcode rebuildCU`, KFDTab).  Every frame change costs `cE X + cCF (W·v) Bb`, every gate
`cRebuildF W (W·v) Bb + 1`; `cCF V Bb = O(V) + O((Bb+2)^2)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFD

open IntMul RS AModel KIL

section Seq

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

end Seq

section Net

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {W v : ℕ} {M : Type*} [AddGroup M]

variable (E : M → IStmt HS Pp)

/-- Code of one gate (labels `lab` before it), register counts. -/
def gateCF (lab : Fin W → M) (g : NGate (Fin W) (ZMod 2) M) : IStmt HS Pp :=
  .seq (KIL.seqL ((touchL g.2.1).map fun (w : Fin W) => applyCF (w : ℕ) (E (g.2.2 - lab w))))
    (fcode (rebuildCU W (srcT g)))

/-- Code of the network, register counts: the gates, then the final frame changes.  It depends
only on `E`, the gates and the labels, not on the stream length. -/
def netCF (Mout : Fin W → M) : (Fin W → M) → List (NGate (Fin W) (ZMod 2) M) → IStmt HS Pp
  | lab, [] => KIL.seqL ((List.finRange W).map fun (w : Fin W) => applyCF (w : ℕ) (E (Mout w - lab w)))
  | lab, g :: gs => .seq (gateCF E lab g) (netCF Mout (labStep lab g) gs)

variable (cE : M → ℕ)

/-- Cost of the register-count network code. -/
def netCIF (V Bb : ℕ) (Mout : Fin W → M) : (Fin W → M) → List (NGate (Fin W) (ZMod 2) M) → ℕ
  | lab, [] => ((List.finRange W).map fun (w : Fin W) => cE (Mout w - lab w) + cCF V Bb).sum + 1
  | lab, g :: gs => ((touchL g.2.1).map fun (w : Fin W) => cE (g.2.2 - lab w) + cCF V Bb).sum +
      1 + cRebuildF W V Bb + netCIF V Bb Mout (labStep lab g) gs

variable {E cE}

end Net

end NLogN.KFD

end

section
-- Source module: Solutions.KFCPass
/-!
# KFC passes over a mark-delimited accumulator

Stack roles (all below 56, disjoint from the size parameters on `1 … 4`):
`sA` accumulator, `sT` temporary, `sO` output, `(sCB,sDB)` unary counter `B`,
`(sCM,sDM)` counter `M`, `(sCQ,sDQ)` counter `q`, `(sCP,sDP)` counter `P`, `sK, sK2` scratch.

The accumulator holds `encF g 0 n = g 0 ++ ▮ ++ g 1 ++ ▮ ++ …` (groups terminated by marks).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul

namespace KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

abbrev sX : Fin HS := 0
abbrev sA : Fin HS := 15
abbrev sT : Fin HS := 16
abbrev sO : Fin HS := 17
abbrev sCB : Fin HS := 18
abbrev sDB : Fin HS := 19
abbrev sCM : Fin HS := 20
abbrev sDM : Fin HS := 21
abbrev sCQ : Fin HS := 22
abbrev sDQ : Fin HS := 23
abbrev sCP : Fin HS := 24
abbrev sDP : Fin HS := 25
abbrev sK : Fin HS := 26
abbrev sK2 : Fin HS := 27

/-! ## Group lists given by functions -/

def encF (f : ℕ → List ℤ) (a n : ℕ) : List Item := enc ((List.range' a n).map f)
def flF (f : ℕ → List ℤ) (a n : ℕ) : List ℤ := (List.range' a n).flatMap f

@[simp] theorem encF_zero (f : ℕ → List ℤ) (a : ℕ) : encF f a 0 = [] := rfl
@[simp] theorem flF_zero (f : ℕ → List ℤ) (a : ℕ) : flF f a 0 = [] := rfl

/-! ## Forward zip column: `mvW A T; unmark A; mvB X T CB DB; mark T` -/

def zcol : IStmt HS Pp :=
  .seq (mvW sA NLogN.KFC.sT) (.seq (.op (.unmark sA)) (.seq (mvB sX NLogN.KFC.sT sCB sDB) (.op (.mark NLogN.KFC.sT))))

/-- Forward zip pass over `n` columns. -/
def zipA : IStmt HS Pp := uloop sCM sDM zcol

/-! ## Moving the groups back: `unmark T; mark A; mvW T A` -/

def bcol : IStmt HS Pp := .seq (.op (.unmark NLogN.KFC.sT)) (.seq (.op (.mark sA)) (mvW NLogN.KFC.sT sA))

/-- Move the `n` groups back from `T` to `A`. -/
def backB : IStmt HS Pp := uloop sCM sDM bcol

/-! ## Initialising and flushing the accumulator -/

def initA : IStmt HS Pp := uloop sCM sDM (.op (.mark sA))

def fcol : IStmt HS Pp := .seq (mvW sA NLogN.KFC.sO) (.op (.unmark sA))

def flushA : IStmt HS Pp := uloop sCM sDM fcol

end KFC

end NLogN

end

section
-- Source module: Solutions.KFCFwd
/-!
# KFC: fine-cost paper Lemma 3, forward direction `[P, q, M, B] → [P, M, q, B]`

`fwdF` computes the same denotation as `KIL.fwdP` (`pull [P,q,M,B] [P,M,q,B] gS 0 xs`), but every
per-element step is an item move with `O(1)` overhead: rows/columns/records are counted with unary
counters (marks), groups in the accumulator are delimited by marks.  The cost is
`(2q+16)·kap w·V + cUL P + cUL q + cUL M + cUL B + 1000 ≤ (2q+67)·kap w·V` (see `KFCFwdMain`)
where `w` bounds the bit size of the **data** entries only and `kap w = 76 w + 200`;
`cUL n = 1000(n+1) + 300·zsz n` is the one-time linear binary-to-unary conversion
(`KFCUnary.toUL`) of the four size parameters.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul

namespace KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## One row: zip into the accumulator, then move the groups back -/

def zrow : IStmt HS Pp := .seq zipA backB

/-! ## The rows of one block -/

/-- Group `m` of the accumulator after `k` rows (records `rr y m`, `y < k`). -/
def grpF (rr : ℕ → ℕ → List ℤ) (k m : ℕ) : List ℤ := (List.range k).flatMap fun y => rr y m

def rowsF : IStmt HS Pp := uloop sCQ sDQ zrow

/-- The block body in row order. -/
def rowsOf (rr : ℕ → ℕ → List ℤ) (M : ℕ) (y : ℕ) : List ℤ := flF (rr y) 0 M

/-! ## One block: init, rows, flush -/

def blkF : IStmt HS Pp := .seq initA (.seq rowsF flushA)

def cBlk (q M B w : ℕ) : ℕ := (2 * q + 8) * kap w * (q * M * B)

/-! ## All blocks -/

def allF : IStmt HS Pp := uloop sCP sDP blkF

end KFC

end NLogN

end

section
-- Source module: Solutions.KFCFwdMain
/-!
# KFC: the self-contained fine-cost forward field move `fwdF`

`fwdF_spec`: on `t` with `ints xs ++ R` on stack `0` and `P, q, M, B` on stacks `1 … 4`,
`fwdF` ends in `t.upd 0 (ints (pull [P,q,M,B] [P,M,q,B] gS 0 xs) ++ R)` (all scratch stacks
restored) with cost `≤ cFwdF P q M B w = (2q+16)·kap w·V + cUL P + cUL q + cUL M + cUL B + 1000`,
`V = P·q·M·B`, `w` a bound on the bit size of the entries of `xs` only.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN

open IntMul AModel

namespace KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Prologue / epilogue of a unary counter pair -/

/-- Push sentinels `0` on `C`, `D`, then `n` marks on `C` (`n` = top of `A`). -/
def pro (A C D : Fin HS) : IStmt HS Pp :=
  .seq (.op (.const C 0)) (.seq (.op (.const D 0)) (toUL A C))

/-- Drop the marks and the sentinels of a counter pair. -/
def epi (C D : Fin HS) : IStmt HS Pp := .seq (clrM C) (.seq (.op (.drop C)) (.op (.drop D)))

/-- Wrap a body with the counter pair `(C, D)` holding `n` = top of `A`. -/
def wrap (A C D : Fin HS) (b : IStmt HS Pp) : IStmt HS Pp := .seq (pro A C D) (.seq b (epi C D))

/-! ## The core: blocks, then copy the output back -/

def coreF : IStmt HS Pp :=
  .seq (.op (.mark NLogN.KFC.sO)) (.seq (.op (.mark NLogN.KFC.sT)) (.seq allF (.seq (mvW NLogN.KFC.sO sX)
    (.seq (.op (.unmark NLogN.KFC.sO)) (.op (.unmark NLogN.KFC.sT))))))

/-! ## The program -/

def fwdF : IStmt HS Pp :=
  NLogN.KFC.wrap 4 sCB sDB (NLogN.KFC.wrap 3 sCM sDM (NLogN.KFC.wrap 2 sCQ sDQ (NLogN.KFC.wrap 1 sCP sDP coreF)))

def cFwdF (P q M B w : ℕ) : ℕ :=
  (2 * q + 16) * kap w * (P * q * M * B) + cUL P + cUL q + cUL M + cUL B + 1000

end KFC

end NLogN

end


