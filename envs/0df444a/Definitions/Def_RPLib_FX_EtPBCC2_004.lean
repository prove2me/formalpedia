-- ===== S4.Def_RP_EtPBC_C2_Tow =====
section

/-! # S4-EtPBC-C2, part 2: tower maps (iterated `P^1`-bundles up to isomorphism)

`IsTower K gS h` for `h : Y ⟶ S`: generated by `qV K gS : P^1_S ⟶ S`, `qV K (h ≫ gS) ≫ h` and precomposition
with isomorphisms. Tower maps are proper, have Noetherian source over a Noetherian `S`, are `PBCGood` at every
`K`-rational geometric point (`IsTower.good`), are stable under base change (`IsTower.baseChange`) and under
composition of towers (`IsTower.comp`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits

noncomputable section

namespace RamanujanPetersson.EtPBC.C2

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtPBC.Z3

section Def

end Def

section Good
variable (K : Type) [Field K] [IsAlgClosed K] (Λ : Type) [CommRing Λ] [IsNoetherianRing Λ] [Finite Λ]
  (p : ℕ) [ExpChar K p] [PerfectRing K p] (l : ℕ) [Fact l.Prime] (hl : (l : K) ≠ 0) (m : ℕ)
  (hΛ : ∀ x : Λ, (l ^ m) • x = 0) {S : Scheme.{0}} [IsNoetherian S] (gS : S ⟶ Spec (CommRingCat.of K))
  [LocallyOfFiniteType gS] (s : GeomPt S) [IsIso (s.pt ≫ gS)]

include p l hl m hΛ in
/-- **Tower maps are `PBCGood`** at every `K`-rational geometric point. -/
theorem IsTower.good {Y : Scheme.{0}} {h : Y ⟶ S} (hh : IsTower K gS h) : PBCGood Λ h s := by
  induction hh with
  | base => exact good_qV K Λ p l hl m hΛ gS s
  | step h hh ih =>
    have := hh.isProper; have := hh.isNoetherian
    exact good_comp K Λ p l hl m hΛ h gS s ih
  | iso e h _ ih => exact pbcGood_iso Λ e h s ih

end Good

