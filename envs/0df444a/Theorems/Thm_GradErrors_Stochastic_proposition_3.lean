-- title:
--   Proposition 3, p. 635 — stochastic gradient method with zero-mean noise: a.s. f(x_t) → −∞, or f(x_t) converges and ∇f(x_t) → 0
-- statement:
--   Let $f:\mathbb R^n\to\mathbb R$ be continuously differentiable with an $L$-Lipschitz gradient,
--   $\|\nabla f(x)-\nabla f(\bar x)\|\le L\|x-\bar x\|$ for all $x,\bar x$. Let $(\Omega,\mathcal F,P)$ be a probability space with an increasing sequence of $\sigma$-fields $\mathcal F_0\subseteq\mathcal F_1\subseteq\cdots\subseteq\mathcal F$. Let $x_t$, $s_t$, $w_t$ be random vectors in $\mathbb R^n$ and $\gamma_t$ a deterministic positive stepsize, generated by the method
--   $$x_{t+1}=x_t+\gamma_t(s_t+w_t),$$
--   where $s_t$ is a descent direction and $w_t$ a random noise term. Assume:
--
--   1. (a) $x_t$ and $s_t$ are $\mathcal F_t$-measurable;
--   2. (b) there are positive scalars $c_1,c_2$ such that for all $t$
--   $$c_1\|\nabla f(x_t)\|^2\le-\nabla f(x_t)'s_t,\qquad\|s_t\|\le c_2\bigl(1+\|\nabla f(x_t)\|\bigr);$$
--   3. (c) for all $t$, with probability 1,
--   $$E[w_t\mid\mathcal F_t]=0,\qquad E\bigl[\|w_t\|^2\mid\mathcal F_t\bigr]\le A\bigl(1+\|\nabla f(x_t)\|^2\bigr),$$
--   where $A$ is a positive deterministic constant;
--   4. (d) $\sum_{t=0}^\infty\gamma_t=\infty$ and $\sum_{t=0}^\infty\gamma_t^2<\infty$.
--
--   Then, with probability 1, either $f(x_t)\to-\infty$, or else $f(x_t)$ converges to a finite value and $\lim_{t\to\infty}\nabla f(x_t)=0$. Furthermore, with probability 1, every limit point of $x_t$ is a stationary point of $f$.
--
--   This is the stochastic counterpart of the paper's Proposition 1. It covers stochastic gradient descent and its variants for nonconvex objectives without assuming that $f$ is bounded below or that the iterates stay bounded, and with a noise variance allowed to grow quadratically in $\|\nabla f(x_t)\|$.
--
--   **Formalization Note** $\mathbb R^n$ is `EuclideanSpace ℝ (Fin n)`, $\nabla f$ is `gradient f`, and $L$ is `L : ℝ≥0`. The recursion and the conditions (b) hold on every sample path, as on the page. The conditional expectations in (c) are encoded through set integrals rather than Mathlib's `condExp`: Mathlib's conditional expectation of a non-integrable function is $0$, and the page assumes no integrability of $w_t$ (the bound $A(1+\|\nabla f(x_t)\|^2)$ need not be integrable). The encoding is: for every $\mathcal F_t$-measurable set $S$, $\int_S\|w_t\|^2\,dP\le\int_S A(1+\|\nabla f(x_t)\|^2)\,dP$ as $[0,\infty]$-valued integrals, and $\int_S w_t\,dP=0$ whenever $\int_S\|w_t\|\,dP<\infty$. These are exactly the generalized conditional-expectation statements $E[\|w_t\|^2\mid\mathcal F_t]\le A(1+\|\nabla f(x_t)\|^2)$ and $E[w_t\mid\mathcal F_t]=0$ a.s. No measurability of $w_t$ is assumed; it follows from the recursion. $\sum\gamma_t=\infty$ is divergence of the partial sums to $+\infty$, and $\sum\gamma_t^2<\infty$ is `Summable`. "Limit point" is `MapClusterPt`. The almost-sure quantifier is outside the dichotomy: different sample paths may take different branches.
-- source:
--   Bertsekas and Tsitsiklis, Gradient Convergence in Gradient Methods with Errors, SIAM J. Optim. 10 (2000), https://doi.org/10.1137/S1052623497331063, p. 635, Proposition 3, displays (4.1)–(4.3), with Remark (b) ("with probability 1") and the standing assumption (2.1), p. 629

import Mathlib

open Filter Topology NNReal ENNReal MeasureTheory ProbabilityTheory InnerProductSpace

namespace GradErrors.Stochastic

theorem proposition_3 {n : ℕ} {Ω : Type*} {m0 : MeasurableSpace Ω} (P : Measure Ω)
    [IsProbabilityMeasure P] (ℱ : Filtration ℕ m0)
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f)
    (L : ℝ≥0) (hL : LipschitzWith L (gradient f))
    (x s w : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (γ : ℕ → ℝ) (hγ : ∀ t, 0 < γ t)
    (hx : ∀ t ω, x (t + 1) ω = x t ω + γ t • (s t ω + w t ω))
    (hxm : ∀ t, StronglyMeasurable[ℱ t] (x t)) (hsm : ∀ t, StronglyMeasurable[ℱ t] (s t))
    (c₁ c₂ : ℝ) (hc₁ : 0 < c₁) (hc₂ : 0 < c₂)
    (h41a : ∀ t ω, c₁ * ‖gradient f (x t ω)‖ ^ 2 ≤ -⟪gradient f (x t ω), s t ω⟫_ℝ)
    (h41b : ∀ t ω, ‖s t ω‖ ≤ c₂ * (1 + ‖gradient f (x t ω)‖))
    (A : ℝ) (hA : 0 < A)
    (h42 : ∀ t (S : Set Ω), MeasurableSet[ℱ t] S → ∫⁻ ω in S, ‖w t ω‖ₑ ∂P < ∞ →
      ∫ ω in S, w t ω ∂P = 0)
    (h43 : ∀ t (S : Set Ω), MeasurableSet[ℱ t] S →
      ∫⁻ ω in S, ‖w t ω‖ₑ ^ 2 ∂P ≤
        ∫⁻ ω in S, ENNReal.ofReal (A * (1 + ‖gradient f (x t ω)‖ ^ 2)) ∂P)
    (hsum : Tendsto (fun T => ∑ t ∈ Finset.range T, γ t) atTop atTop)
    (hsq : Summable (fun t => γ t ^ 2)) :
    ∀ᵐ ω ∂P,
      (Tendsto (fun t => f (x t ω)) atTop atBot ∨
        ((∃ l : ℝ, Tendsto (fun t => f (x t ω)) atTop (𝓝 l)) ∧
          Tendsto (fun t => gradient f (x t ω)) atTop (𝓝 0))) ∧
      ∀ xbar, MapClusterPt xbar atTop (fun t => x t ω) → gradient f xbar = 0 := by sorry

end GradErrors.Stochastic
