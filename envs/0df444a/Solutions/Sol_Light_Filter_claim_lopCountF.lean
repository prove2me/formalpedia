  omega

private theorem depth_leF (hQ : 1 ≤ Q) (hD : D ≤ Q) :
    88 * D + 12 ≤ 2 ^ (22 + ratParamsF.m₀) * Q ^ 80 := by
  have h1 : 1 ≤ Q ^ 80 := Nat.one_le_pow _ _ hQ
  have hD1 : D ≤ Q ^ 80 := le_pow_eightyF hQ 1 (by norm_num) (by simpa using hD)
  have habs := two_pow_absorbF (a := ratParamsF.m₀) h1 ratParamsF.hm₀
  generalize Q ^ 80 = R at *
  omega

end summands

private theorem le_prod_fourF {a b c e : ℕ} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (he : 0 < e) :
    a ≤ a * (b * (c * e)) ∧ b ≤ a * (b * (c * e)) ∧ e ≤ a * (b * (c * e)) :=
  ⟨Nat.le_mul_of_pos_right a (by positivity),
    (Nat.le_mul_of_pos_right b (by positivity)).trans (Nat.le_mul_of_pos_left _ ha),
    ((Nat.le_mul_of_pos_left e hc).trans (Nat.le_mul_of_pos_left _ hb)).trans
      (Nat.le_mul_of_pos_left _ ha)⟩

/-- The need is polynomial in the parameters. -/
theorem allInstancesNeedF_poly : PolyNeedN allInstancesNeedF := by
  refine ⟨22 + ratParamsF.m₀, 80, fun ps => ?_⟩
  match ps with
  | [N, D, w, U] =>
    obtain ⟨hN, hD, hU⟩ := le_prod_fourF N.succ_pos D.succ_pos w.succ_pos U.succ_pos
    rw [show polyBound (22 + ratParamsF.m₀) 80 [N, D, w, U] =
      2 ^ (22 + ratParamsF.m₀) * ((N + 1) * ((D + 1) * ((w + 1) * (U + 1)))) ^ 80 by
        simp [polyBound]]
    generalize (N + 1) * ((D + 1) * ((w + 1) * (U + 1))) = Q at *
    exact ⟨wordNeedF_le hN (by omega) (by omega), cells_leF hN (by omega),
      depth_leF (by omega) (by omega)⟩
  | [] | [_] | [_, _] | [_, _, _] | _ :: _ :: _ :: _ :: _ :: _ =>
    exact ⟨Nat.zero_le _, Nat.zero_le _, Nat.zero_le _⟩

/-- **The pruned thin product, for programs of the light language**: on the inputs with
`D^1249 ≤ N^71`, the wanted entries are computed in time
`O(w D^{0.4296471} (log D + 1) + N² (log D + 1)²/D^{0.0703531})`. -/
theorem claim_thinProductF : ∀ c : ℝ, ∃ (C : ℝ) (T : ℕ → ℕ → ℕ → ℝ → ℝ),
    lightModel.thinProduct T ∧ ∀ (N D w : ℕ) (u : ℝ), 1 ≤ D → D ^ 1249 ≤ N ^ 71 →
      u ≤ (N : ℝ) ^ c → T N D w u ≤ C * ((w : ℝ) * queryBoundF D + preBoundF N D) := by
  intro _
  obtain ⟨C, hC⟩ := allInstancesTimeF_le cShared30
  refine ⟨C, fun N D₀ w _ => (allInstancesTimeF cShared30 [N, D₀, w, 0] : ℝ),
    ⟨_, _, _, _, allInstancesNeedF_poly, allInstancesF_programF,
      fun N D₀ w w' U u _ _ _ hw _ => ?_⟩,
    fun N D₀ w u hD hN _ => hC N D₀ w 0 hD hN⟩
  change (allInstancesTimeF cShared30 [N, D₀, w, U] : ℝ) ≤
      (allInstancesTimeF cShared30 [N, D₀, w', 0] : ℝ)
  exact_mod_cast allInstancesTimeF_mono cShared30 N D₀ U 0 hw

end Light.Filter
end
end

section
-- Source module: ThreeSumApsp.Filter.ThinLop
@[expose] public section

open ThreeSumApsp

namespace Light.Filter

open Light.Sec3 Light.Sec4

/-- `log D + 1 ≤ (1 + 1/log 2) log D` for `D ≥ 2`. -/
private theorem log_add_one_leF {D : ℕ} (hD : 2 ≤ D) :
    Real.log D + 1 ≤ (1 + 1 / Real.log 2) * Real.log D := by
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlog : Real.log 2 ≤ Real.log D :=
    Real.log_le_log (by norm_num) (by exact_mod_cast hD)
  have : 1 ≤ Real.log D / Real.log 2 := (one_le_div h2).2 hlog
  have e : (1 + 1 / Real.log 2) * Real.log D = Real.log D + Real.log D / Real.log 2 := by ring
  linarith

end Light.Filter
end
end

section
open ThreeSumApsp
open Light
open Light.Filter
open Light.Sec3 Light.Sec4
theorem solution : ∃ (C : ℝ) (T : ℕ → ℕ → ℕ → ℝ), LopSolvedIn lopCountTask T ∧
    ∀ n D w : ℕ, 2 ≤ D → D ^ 1249 ≤ n ^ 71 →
      T n D w ≤ C * ((n : ℝ) ^ 2 * Real.log D ^ 2 / (D : ℝ) ^ (0.0703531 : ℝ)
        + (w : ℝ) * (D : ℝ) ^ (0.4296471 : ℝ) * Real.log D + (n : ℝ) * D + w + 1) := by
  obtain ⟨C₁, hlop⟩ := claim_lopCountFromThinProduct
  obtain ⟨C, T, hT, hb⟩ := claim_thinProductF 0
  set a : ℝ := 1 + 1 / Real.log 2 with ha
  have ha1 : 1 ≤ a := by
    have : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have : 0 ≤ 1 / Real.log 2 := by positivity
    linarith
  set C' : ℝ := max C 0
  refine ⟨C' * a ^ 2 + |C₁|, _, hlop T hT, fun n D w hD hDn => ?_⟩
  have hD1 : 1 ≤ D := by omega
  have hDR : (1 : ℝ) ≤ D := by exact_mod_cast hD1
  have hlog0 : 0 ≤ Real.log D := Real.log_nonneg hDR
  have hla := log_add_one_leF hD
  have hT1 := hb n D w 1 hD1 hDn (by rw [Real.rpow_zero])
  -- the shapes
  set X : ℝ := (n : ℝ) ^ 2 * Real.log D ^ 2 / (D : ℝ) ^ (0.0703531 : ℝ)
  set Y : ℝ := (w : ℝ) * (D : ℝ) ^ (0.4296471 : ℝ) * Real.log D
  have hDγ : 0 < (D : ℝ) ^ (0.0703531 : ℝ) := Real.rpow_pos_of_pos (by linarith) _
  have hDq : 0 ≤ (D : ℝ) ^ (0.4296471 : ℝ) := (Real.rpow_pos_of_pos (by linarith) _).le
  have hX0 : 0 ≤ X := by positivity
  have hY0 : 0 ≤ Y := by positivity
  have hq : (w : ℝ) * queryBoundF D ≤ a * Y := by
    unfold queryBoundF
    calc (w : ℝ) * ((D : ℝ) ^ (0.4296471 : ℝ) * (Real.log D + 1))
        ≤ (w : ℝ) * ((D : ℝ) ^ (0.4296471 : ℝ) * (a * Real.log D)) := by gcongr
      _ = a * Y := by simp only [Y]; ring
  have hp : preBoundF n D ≤ a ^ 2 * X := by
    unfold preBoundF
    have hsq : (Real.log D + 1) ^ 2 ≤ (a * Real.log D) ^ 2 :=
      pow_le_pow_left₀ (by linarith) hla 2
    calc (n : ℝ) ^ 2 * (Real.log D + 1) ^ 2 / (D : ℝ) ^ (0.0703531 : ℝ)
        ≤ (n : ℝ) ^ 2 * (a * Real.log D) ^ 2 / (D : ℝ) ^ (0.0703531 : ℝ) := by gcongr
      _ = a ^ 2 * X := by simp only [X]; ring
  have haa : a ≤ a ^ 2 := by nlinarith
  have hS0 : 0 ≤ (w : ℝ) * queryBoundF D + preBoundF n D := by
    have := one_le_queryBoundF (D₀ := D) hD1
    have : 0 ≤ preBoundF n D := by unfold preBoundF; positivity
    positivity
  have hTle : T n D w 1 ≤ C' * (a ^ 2 * (X + Y)) := by
    calc T n D w 1 ≤ C * ((w : ℝ) * queryBoundF D + preBoundF n D) := hT1
      _ ≤ C' * ((w : ℝ) * queryBoundF D + preBoundF n D) :=
          mul_le_mul_of_nonneg_right (le_max_left _ _) hS0
      _ ≤ C' * (a ^ 2 * (X + Y)) := by
          apply mul_le_mul_of_nonneg_left _ (le_max_right _ _)
          nlinarith
  have hrest : (0 : ℝ) ≤ (n : ℝ) * D + w + 1 := by positivity
  have h1 : C₁ * ((n : ℝ) * D + w + 1) ≤ |C₁| * ((n : ℝ) * D + w + 1) :=
    mul_le_mul_of_nonneg_right (le_abs_self _) hrest
  have hC'0 : 0 ≤ C' := le_max_right _ _
  have hA : 0 ≤ C' * a ^ 2 := by positivity
  have hfinal : C' * (a ^ 2 * (X + Y)) + |C₁| * ((n : ℝ) * D + w + 1)
      ≤ (C' * a ^ 2 + |C₁|) * (X + Y + (n : ℝ) * D + w + 1) := by
    have e : (C' * a ^ 2 + |C₁|) * (X + Y + (n : ℝ) * D + w + 1)
        = C' * (a ^ 2 * (X + Y)) + |C₁| * ((n : ℝ) * D + w + 1)
          + C' * a ^ 2 * ((n : ℝ) * D + w + 1) + |C₁| * (X + Y) := by ring
    rw [e]
    have : 0 ≤ C' * a ^ 2 * ((n : ℝ) * D + w + 1) := mul_nonneg hA hrest
    have : 0 ≤ |C₁| * (X + Y) := by positivity
    linarith
  calc T n D w 1 + C₁ * ((n : ℝ) * D + w + 1)
      ≤ C' * (a ^ 2 * (X + Y)) + |C₁| * ((n : ℝ) * D + w + 1) := by linarith
    _ ≤ (C' * a ^ 2 + |C₁|) * (X + Y + (n : ℝ) * D + w + 1) := hfinal
    _ = (C' * a ^ 2 + |C₁|) * ((n : ℝ) ^ 2 * Real.log D ^ 2 / (D : ℝ) ^ (0.0703531 : ℝ)
          + (w : ℝ) * (D : ℝ) ^ (0.4296471 : ℝ) * Real.log D + (n : ℝ) * D + w + 1) := rfl
end
