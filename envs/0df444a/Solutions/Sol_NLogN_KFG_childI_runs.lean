  rw [e] at hp
  have S3 := Sp.popsR Bb (evalP t l) (t.upd 0 (ints ys ++ R)) (fun q hq => by
    simp only [evalP_eq, List.mem_map] at hq
    obtain ⟨q', hq', rfl⟩ := hq
    exact ⟨(hl q' hq').1, hv q' hq'⟩)
