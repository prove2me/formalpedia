private theorem archHeight_frame (w₀ : 𝔸) (t₁ t₂ : 𝔸ˣ) (k : AdelicGL2 (𝓞 F) F) :
    archHeight F (glArch (𝓞 F) F (unipotentGL2 w₀ * diagGL2 t₁ t₂ * k))
      = (∏ v : InfinitePlace F, ‖((t₁ * t₂⁻¹ : 𝔸ˣ) : 𝔸).1 v‖ ^ v.mult) * archHeight F (glArch (𝓞 F) F k) := by
  have hu : archHeight F (glArch (𝓞 F) F (unipotentGL2 w₀ * (diagGL2 t₁ t₂ * k)))
      = archHeight F (glArch (𝓞 F) F (diagGL2 t₁ t₂ * k)) :=
    M4aP3B.Truncation.adelicArchHeight_unipotentGL2_mul F w₀ _
  rw [mul_assoc, hu, diagGL2_eq_mul_centralScalar, mul_assoc, M4aP3B.HighStructure.archHeight_glArch_diagGL2_mul,
    AutomorphicForm.archHeight_glArch_centralScalar_mul]

private theorem exists_archHeight_le {K : Set (AdelicGL2 (𝓞 F) F)} (hK : IsCompact K) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ k ∈ K, archHeight F (glArch (𝓞 F) F k) ≤ C := by
  obtain ⟨C, hC⟩ := hK.exists_bound_of_continuousOn
    (((continuous_archHeight F).comp (continuous_glArch (𝓞 F) F)).continuousOn (s := K))
  refine ⟨max C 1, le_max_right _ _, fun k hk => ?_⟩
  have h := hC k hk
  rw [Function.comp_apply, Real.norm_eq_abs, abs_of_pos (archHeight_pos F _)] at h
  exact h.trans (le_max_left _ _)

end Heights
