-- title:
--   Theorem 2.14 — Markovian projection (Gyöngy, Brunick–Shreve)
-- statement:
--   Let $(\Omega,\mathcal F,\mathbb F,\mathbb P)$ be a filtered probability space supporting an $\mathbb F$-adapted continuous process $X$ in $\mathbb R^d$ and an $\mathbb F$-Brownian motion $W$ in $\mathbb R^d$. Let $b=(b_t)_{t\in[0,T]}$ be a bounded $\mathbb F$-progressively measurable process such that, almost surely,
--   $$X_t=X_0+\int_0^t b_s\,ds+W_t,\qquad t\in[0,T].$$
--   Then there is a bounded Borel function $\widehat b:[0,T]\times\mathbb R^d\to\mathbb R^d$ such that
--   $$\widehat b(t,X_t)=\mathbb E[b_t\mid X_t]\quad\text{a.s., for each } t\in[0,T],$$
--   and the strong solution $Y$ of
--   $$dY_t=\widehat b(t,Y_t)\,dt+dW_t,\qquad Y_0=X_0,$$
--   exists and satisfies $Y_t\overset{d}{=}X_t$ for each $t\in[0,T]$.
--
--   The theorem replaces a path-dependent drift by a Markovian one without changing any one-dimensional time marginal. In the proof of Proposition 2.2 it is applied to the $nd$-dimensional state vector of the $n$-player game when one player deviates to a closed-loop control.
--
--   **Formalization Note** The paper quotes this from Gyöngy [32, Theorem 4.6] and Brunick–Shreve [9, Corollary 3.7]. It is stated for a general dimension $d$; the $n$-player application uses dimension $nd$ through the isometry $(\mathbb R^d)^n\cong\mathbb R^{nd}$. "The unique strong solution" is encoded as: a measurable continuous process $Y$ on the same space, adapted to the completed filtration generated by $X_0$ and $W$ (platform `EthierKurtz.completedBrownianPast`), with $Y_0=X_0$ a.s. and $Y_t=Y_0+\int_0^t\widehat b(s,Y_s)\,ds+W_t$ for all $t\in[0,T]$ a.s. The conclusion asserts that such a $Y$ exists (Veretennikov) and that every such $Y$ has $Y_t\overset d=X_t$. $\mathbb E[b_t\mid X_t]$ is the vector-valued (Bochner) conditional expectation with respect to $\sigma(X_t)$; it is meaningful because $b$ is bounded and $\mathcal F_t$-measurable. The process $b$ is indexed by $t\ge0$ and is required progressively measurable for all $t$ and bounded on $[0,T]$; a process on $[0,T]$ extends (e.g. by $0$) without loss. $\widehat b$ is bounded and Borel on $\mathbb R\times\mathbb R^d$.
-- source:
--   Lacker, On the convergence of closed-loop Nash equilibria to the mean field game limit, arXiv:1808.02745v1, p. 12, Theorem 2.14 (citing Gyöngy, Theorem 4.6, and Brunick–Shreve, Corollary 3.7)

import Mathlib
import Definitions.Def_EthierKurtz_completedBrownianPast
import Definitions.Def_ClosedLoopMFG_MarkovNash_Model

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace ClosedLoopMFG.MarkovNash

/-- Lacker, arXiv:1808.02745v1, Theorem 2.14 (Markovian projection, p. 12; Gyöngy, Brunick–Shreve).
On a filtered probability space with an `𝔽`-adapted continuous process `X` and an `𝔽`-Brownian
motion `W` in `ℝ^d`, let `b` be a bounded `𝔽`-progressively measurable process with
`X_t = X_0 + ∫_0^t b_s ds + W_t` for all `t ∈ [0, T]`, a.s. Then there is a bounded Borel
`b̂ : [0, T] × ℝ^d → ℝ^d` with `b̂(t, X_t) = E[b_t | X_t]` a.s. for each `t ∈ [0, T]`; moreover the
strong solution `Y` of `dY_t = b̂(t, Y_t) dt + dW_t`, `Y_0 = X_0` (on the same space, adapted to
the completed filtration of `(X_0, W)`) exists, and every such solution has `Y_t =ᵈ X_t` for each
`t ∈ [0, T]`. -/
theorem theorem_2_14 {d : ℕ} {T : ℝ≥0} (hT : 0 < T)
    {Ω : Type} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (𝓕 : Filtration ℝ≥0 mΩ)
    (X : Ω → Path d T) (hX_meas : Measurable X)
    (hX_adapted : ∀ s : Set.Icc (0 : ℝ) T, Measurable[𝓕 (s : ℝ).toNNReal] (fun ω => X ω s))
    (W : ℝ≥0 → Ω → E d) (hW : IsFBrownian 𝓕 P W)
    (bp : ℝ≥0 → Ω → E d) (hb_prog : IsStronglyProgressive 𝓕 bp)
    (hb_bdd : ∃ C : ℝ, ∀ t : ℝ≥0, t ≤ T → ∀ ω, ‖bp t ω‖ ≤ C)
    (hstate : ∀ᵐ ω ∂P, ∀ t : Set.Icc (0 : ℝ) T,
      X ω t = X ω (t0 T) + (∫ s in (0 : ℝ)..(t : ℝ), bp s.toNNReal ω) + W (t : ℝ).toNNReal ω) :
    ∃ bhat : ℝ → E d → E d,
      Measurable (Function.uncurry bhat) ∧
      (∃ C : ℝ, ∀ t x, ‖bhat t x‖ ≤ C) ∧
      (∀ t : Set.Icc (0 : ℝ) T,
        (fun ω => bhat t (X ω t)) =ᵐ[P]
          P[fun ω => bp (t : ℝ).toNNReal ω |
            MeasurableSpace.comap (fun ω => X ω t) inferInstance]) ∧
      let IsStrongSol : (Ω → Path d T) → Prop := fun Y =>
        Measurable Y ∧
        (∀ s : Set.Icc (0 : ℝ) T,
          Measurable[EthierKurtz.completedBrownianPast P W (fun ω => X ω (t0 T)) (s : ℝ).toNNReal]
            (fun ω => Y ω s)) ∧
        (∀ᵐ ω ∂P, Y ω (t0 T) = X ω (t0 T)) ∧
        (∀ᵐ ω ∂P, ∀ t : Set.Icc (0 : ℝ) T,
          Y ω t = Y ω (t0 T) + (∫ s in (0 : ℝ)..(t : ℝ), bhat s (ev (Y ω) s))
            + W (t : ℝ).toNNReal ω)
      (∃ Y, IsStrongSol Y) ∧
      ∀ Y, IsStrongSol Y → ∀ t : Set.Icc (0 : ℝ) T,
        P.map (fun ω => Y ω t) = P.map (fun ω => X ω t) := by sorry

end ClosedLoopMFG.MarkovNash
