-- ===== S4.Def_RP_EtPBC_C2_BcTow =====
section

/-! # S4-EtPBC-C2, part 4: sheaf-level proper base change for tower compactifications (E0Probe A2, geometric)

**`isIso_bcMor_tower`**: for `c : Cpt f` with `IsTower K gS c.fbar` (a tower Cpt over a Noetherian `S` of finite type
over `K = K̄`) and any `g : S' ⟶ S` with `S'` Noetherian of finite type over `K`, C1's base change morphism
`bcMor Λ c g q F : g^* R^q f_! F ⟶ R^q f'_! (g_X^* F)` is an isomorphism; `bcMorIso` is the named isomorphism.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits

noncomputable section

namespace RamanujanPetersson.EtPBC.C2

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtPBC.C1

variable (K : Type) [Field K] [IsAlgClosed K] (Λ : Type) [CommRing Λ] [IsNoetherianRing Λ] [Finite Λ]
  (p : ℕ) [ExpChar K p] [PerfectRing K p] (l : ℕ) [Fact l.Prime] (hl : (l : K) ≠ 0) (m : ℕ)
  (hΛ : ∀ x : Λ, (l ^ m) • x = 0) {S S' : Scheme.{0}} [IsNoetherian S] [IsNoetherian S']
  (gS : S ⟶ Spec (CommRingCat.of K)) [LocallyOfFiniteType gS] (g : S' ⟶ S) [LocallyOfFiniteType (g ≫ gS)]

include p l hl m hΛ in
/-- `PBCGood` of a tower and of its base change along `g` at the closed points of `S'`. -/
theorem good_tower_bc {Y : Scheme.{0}} {h : Y ⟶ S} (hh : IsTower K gS h) (x : S')
    (hx : IsClosed ({x} : Set S')) :
    PBCGood Λ h ((geomPtAt x).map g) ∧ PBCGood Λ (pullback.snd h g) (geomPtAt x) := by
  have h2 : IsIso ((geomPtAt x).pt ≫ g ≫ gS) := isIso_geomPtAt (g ≫ gS) x hx
  have h1 : IsIso (((geomPtAt x).map g).pt ≫ gS) := by
    change IsIso (((geomPtAt x).pt ≫ g) ≫ gS); rw [Category.assoc]; exact h2
  exact ⟨hh.good K Λ p l hl m hΛ gS _, (hh.baseChange g).good K Λ p l hl m hΛ (g ≫ gS) _⟩

include p l hl m hΛ in
/-- **Base change for `R^q f_!` of a tower Cpt is an isomorphism** (E0Probe A2, geometric part). -/
theorem isIso_bcMor_tower {X : Scheme.{0}} {f : X ⟶ S} (c : Cpt f) (hc : IsTower K gS c.fbar) (q : ℕ)
    (F : EtSh Λ X) : IsIso (bcMor Λ c g q F) := by
  rw [bcMor_eq]
  have := isIso_bcMorSq_bc (Λ := Λ) c.fbar g (g ≫ gS)
    (fun x hx => (good_tower_bc K Λ p l hl m hΛ gS g hc x hx).1)
    (fun x hx => (good_tower_bc K Λ p l hl m hΛ gS g hc x hx).2) q ((c.ext Λ).obj F)
  have h2 : IsIso (((push (pullback.snd c.fbar g) Λ).rightDerived q).map ((itExtNat Λ c g).hom.app F)) :=
    inferInstance
  exact IsIso.comp_isIso' this h2

include p l hl m hΛ in
/-- **The named sheaf base change isomorphism** `g^* R^q f_! F ≅ R^q f'_! (g_X^* F)` for a tower Cpt. -/
def bcMorIso {X : Scheme.{0}} {f : X ⟶ S} (c : Cpt f) (hc : IsTower K gS c.fbar) (q : ℕ) (F : EtSh Λ X) :
    (pull g Λ).obj ((c.Rshriek Λ q).obj F) ≅ ((itCpt c g).Rshriek Λ q).obj ((pull (itgX c g) Λ).obj F) :=
  have := isIso_bcMor_tower K Λ p l hl m hΛ gS g c hc q F
  asIso (bcMor Λ c g q F)

include p l hl m hΛ in
theorem bcMorIso_hom {X : Scheme.{0}} {f : X ⟶ S} (c : Cpt f) (hc : IsTower K gS c.fbar) (q : ℕ)
    (F : EtSh Λ X) : (bcMorIso K Λ p l hl m hΛ gS g c hc q F).hom = bcMor Λ c g q F := rfl

end RamanujanPetersson.EtPBC.C2

end

end


