/-- The defining formula for `TauCeti.rationalPrimeBelow`. -/
theorem TauCeti.rationalPrimeBelow_def (𝔭 : _root_.IsDedekindDomain.HeightOneSpectrum (𝓞 K)) :
    _root_.TauCeti.rationalPrimeBelow 𝔭 = _root_.Ideal.absNorm (_root_.Ideal.under ℤ 𝔭.asIdeal) := by
  rw [_root_.TauCeti.rationalPrimeBelow]

omit [_root_.NumberField K] in
/-- The prime of `ℤ` below a height-one prime `𝔭` of `𝓞 K` is the ideal generated by
`TauCeti.rationalPrimeBelow 𝔭`.  This is the bridge that lets a fibre of the map
`rationalPrimeBelow` be recognised as a set of primes over one ideal of `ℤ`. -/
theorem TauCeti.under_eq_span_rationalPrimeBelow (𝔭 : _root_.IsDedekindDomain.HeightOneSpectrum (𝓞 K)) :
    _root_.Ideal.under ℤ 𝔭.asIdeal = _root_.Ideal.span {(_root_.TauCeti.rationalPrimeBelow 𝔭 : ℤ)} := by
  rw [_root_.TauCeti.rationalPrimeBelow_def, _root_.Int.ideal_span_absNorm_eq_self]











/-! ### Fibring the primes over the rational primes below them -/

/-- In any finite set of height-one primes of `𝓞 K`, at most `[K : ℚ]` have a given rational
prime below them: this is the height-one-spectrum fibre form of
`TauCeti.NumberField.card_primesOverFinset_le_finrank`. -/
theorem solution (F : _root_.Finset (_root_.IsDedekindDomain.HeightOneSpectrum (𝓞 K))) (m : ℕ) :
    (F.filter fun 𝔮 ↦ _root_.TauCeti.rationalPrimeBelow 𝔮 = m).card ≤
      _root_.Module.finrank ℚ K := by
  rcases _root_.Finset.eq_empty_or_nonempty
    (F.filter fun 𝔮 ↦ _root_.TauCeti.rationalPrimeBelow 𝔮 = m) with h | ⟨𝔭, h𝔭⟩
  · simp [h]
  -- Every prime in the fibre lies over the ideal `span {m}` of `ℤ`, which is therefore maximal.
  have key : ∀ 𝔮 ∈ F.filter fun 𝔮 ↦ _root_.TauCeti.rationalPrimeBelow 𝔮 = m,
      _root_.Ideal.under ℤ 𝔮.asIdeal = _root_.Ideal.span {(m : ℤ)} := by
    intro 𝔮 h𝔮
    rw [← (Finset.mem_filter.mp h𝔮).2, _root_.TauCeti.under_eq_span_rationalPrimeBelow]
  have hspan : (_root_.Ideal.span {(m : ℤ)}).IsPrime := key 𝔭 h𝔭 ▸ _root_.Ideal.IsPrime.under ℤ 𝔭.asIdeal
  have hne : (_root_.Ideal.span {(m : ℤ)} : _root_.Ideal ℤ) ≠ ⊥ :=
    key 𝔭 h𝔭 ▸ _root_.Ideal.under_ne_bot (A := ℤ) 𝔭.ne_bot
  have : (_root_.Ideal.span {(m : ℤ)}).IsMaximal := hspan.isMaximal hne
  refine _root_.le_trans (_root_.Finset.card_le_card_of_injOn (fun 𝔮 ↦ 𝔮.asIdeal) (fun 𝔮 h𝔮 ↦ ?_)
    (fun 𝔮 _ 𝔮' _ h ↦ _root_.IsDedekindDomain.HeightOneSpectrum.ext h))
    (_root_.TauCeti.NumberField.card_primesOverFinset_le_finrank (K := K) hne)
  exact (_root_.IsDedekindDomain.mem_primesOverFinset_iff hne (𝓞 K)).mpr ⟨𝔮.isPrime, ⟨(key 𝔮 h𝔮).symm⟩⟩



