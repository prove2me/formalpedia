namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

theorem ρK_val (dF : Fin HS) (i : Fin 19) :
    (ρK dF i).val = if 10 + i.val < dF.val then 10 + i.val else 11 + i.val := rfl

theorem ρK_inj (dF : Fin HS) : Injective (ρK dF) := by
  intro a b h
  have h' := congrArg Fin.val h
  rw [ρK_val, ρK_val] at h'
  apply Fin.ext
  split_ifs at h' <;> omega

theorem ρK_ne {dF j : Fin HS} (hj : j.val < 10 ∨ 30 ≤ j.val) (i : Fin 19) : ρK dF i ≠ j := by
  intro h
  have h' := congrArg Fin.val h
  rw [ρK_val] at h'
  have := i.isLt
  split_ifs at h' <;> omega

theorem ρK_neF (dF : Fin HS) (i : Fin 19) : ρK dF i ≠ dF := by
  intro h
  have h' := congrArg Fin.val h
  rw [ρK_val] at h'
  split_ifs at h' with h1 <;> omega

theorem ρK_lt (dF : Fin HS) (i : Fin 19) : (ρK dF i).val < 56 := by
  rw [ρK_val]; have := i.isLt; split_ifs <;> omega

theorem ρK_regOK {dF dT : Fin HS} (hF0 : dF ≠ 0) (hT : dT.val < 10 ∨ 30 ≤ dT.val) (hT0 : dT ≠ 0)
    (hTlt : dT.val < 56) : RegOK (ρK dF) dT dF :=
  ⟨ρK_inj dF, ρK_ne (by left; decide), ρK_ne hT, ρK_neF dF, ρK_lt dF, hT0, hF0, hTlt⟩

/-! ## Procedure families -/

theorem famApp_left {m₁ m₂ E : ℕ} {U₁ : Fam m₁} {U₂ : Fam m₂} {tbl : Fin (7 + E) → IStmt HS (7 + E)}
    {idx : Fin (m₁ + m₂) → Fin (7 + E)} (h : ∀ i, tbl (idx i) = famApp U₁ U₂ E idx i) :
    ∀ i, tbl (idx (Fin.castAdd m₂ i)) = U₁ E (fun j => idx (Fin.castAdd m₂ j)) i := by
  intro i
  rw [h]; unfold famApp; rw [dif_pos (by simp)]; rfl

theorem famApp_right {m₁ m₂ E : ℕ} {U₁ : Fam m₁} {U₂ : Fam m₂}
    {tbl : Fin (7 + E) → IStmt HS (7 + E)}
