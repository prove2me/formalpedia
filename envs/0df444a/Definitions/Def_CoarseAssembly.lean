    let local_proof {X : Type _} {Y : Type _} [inst_local_2 : PseudoMetricSpace X] [inst_local_3 : PseudoMetricSpace Y] {r : ℝ} {s : ℝ} (hrs : r ≤ s) (e : X ↪ Y) (he)
        (p : OAI.CoarseAssembly.Rips.Point X r) : OAI.CoarseAssembly.Rips.coarsen hrs (OAI.CoarseAssembly.Rips.mapPoint e he p) = OAI.CoarseAssembly.Rips.mapPoint e he (OAI.CoarseAssembly.Rips.coarsen hrs p) :=
      open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Rips in
