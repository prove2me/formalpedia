section
-- Source module: Solutions.R6BitNBRk
/-!
# Round six, bit network: pivot lemmas

* `isPiv_block`: pivots of a block in the top-right part pass to the whole matrix.
* `isPiv_diag_of_lower`: a lower triangular matrix with nonzero diagonal pivots on its diagonal.
* `isPiv_mid`: an idempotent of rank `m - k` with invertible `k × k` corner pivots on the middle
  diagonal (`CornerLib.solution`).
* `isPiv_rank1_lower`: a matrix that is rank one strictly above the diagonal pivots at `(l, l)`.
* `rk_mul_lower`, `isPiv_side`: lower triangular factors keep the rank profile; the pivots of
  `B M A` (`B` with lower triangular top, `A` with lower triangular right end) are those of `M`,
  moved to the top-right corner.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset

variable {K : Type*} [Field K]

/-! ## Blocks -/

/-- The rank profile of a top-right block. -/
lemma rk_block {a b a' b' c0 : ℕ} (C : Matrix (Fin a) (Fin b) K) (B : Matrix (Fin a') (Fin b') K)
    (ha : a' ≤ a) (hb : c0 + b' = b)
    (hCB : ∀ (i : Fin a') (j : Fin b'),
      B i j = C ⟨i.val, lt_of_lt_of_le i.isLt ha⟩ ⟨c0 + j.val, by have := j.isLt; omega⟩)
    {X : ℕ} (hX : X ≤ a') (y : ℕ) : rk C X (c0 + y) = rk B X y := by
  unfold rk
  have e : B.submatrix (fun r : {r : Fin a' // r.val < X} => r.1)
      (fun c : {c : Fin b' // y ≤ c.val} => c.1) =
      C.submatrix (fun r : {r : Fin a' // r.val < X} => (⟨r.1.val, lt_of_lt_of_le r.1.isLt ha⟩ : Fin a))
        (fun c : {c : Fin b' // y ≤ c.val} =>
          (⟨c0 + c.1.val, by have := c.1.isLt; omega⟩ : Fin b)) := by
    ext r c; simp [hCB]
  rw [e]
  apply RunsLib.RunsAux.rank_submatrix_range
  · ext x
    simp only [Set.mem_range, Subtype.exists]
    constructor
    · rintro ⟨x', hx', rfl⟩
      exact ⟨⟨x'.val, by omega⟩, hx', rfl⟩
    · rintro ⟨x', hx', rfl⟩
      exact ⟨_, hx', rfl⟩
  · ext x
    simp only [Set.mem_range, Subtype.exists]
    constructor
    · rintro ⟨x', hx', rfl⟩
      refine ⟨⟨x'.val - c0, by have := x'.isLt; omega⟩, by simp only; omega, ?_⟩
      ext; simp only; omega
    · rintro ⟨x', hx', rfl⟩
      exact ⟨_, by simp only; omega, rfl⟩

lemma isPiv_block {a b a' b' c0 : ℕ} (C : Matrix (Fin a) (Fin b) K) (B : Matrix (Fin a') (Fin b') K)
    (ha : a' ≤ a) (hb : c0 + b' = b)
    (hCB : ∀ (i : Fin a') (j : Fin b'),
      B i j = C ⟨i.val, lt_of_lt_of_le i.isLt ha⟩ ⟨c0 + j.val, by have := j.isLt; omega⟩)
    {i j : ℕ} (h : IsPiv B i j) : IsPiv C i (c0 + j) := by
  have hi := (isPiv_lt h).1
  unfold IsPiv at h ⊢
  rw [show c0 + j + 1 = c0 + (j + 1) by omega, rk_block C B ha hb hCB (X := i + 1) (by omega),
    rk_block C B ha hb hCB (X := i + 1) (by omega), rk_block C B ha hb hCB (X := i) (by omega),
    rk_block C B ha hb hCB (X := i) (by omega)]
  exact h

/-! ## Lower triangular matrices -/

lemma isPiv_diag_of_lower [DecidableEq K] {k : ℕ} (C : Matrix (Fin k) (Fin k) K)
    (hC : ∀ i j, i < j → C i j = 0) (hd : ∀ i, C i i ≠ 0) (l : Fin k) : IsPiv C l l := by
  have e : C = C * 1 * 1 := by simp
  rw [e]
  refine (isPiv_iff C 1 1 hC hd (fun i j h => one_apply_ne (ne_of_lt h)) (fun i => by simp)
    (fun i j => ?_) (fun i j j' h h' => ?_) (fun i i' j h h' => ?_) l l).2 (by simp)
  · rcases eq_or_ne i j with h | h
    · subst h; simp
    · simp [one_apply_ne h]
  · by_cases e1 : i = j
    · by_cases e2 : i = j'
      · rw [← e1, ← e2]
      · simp [e2] at h'
    · simp [e1] at h
  · by_cases e1 : i = j
    · by_cases e2 : i' = j
      · rw [e1, e2]
      · simp [e2] at h'
    · simp [e1] at h

/-! ## The middle diagonal of an idempotent with invertible corner -/

/-! ## Rank one above the diagonal -/

/-! ## Lower triangular factors -/

/-! ## Side edges: low rank through lower triangular frames -/

