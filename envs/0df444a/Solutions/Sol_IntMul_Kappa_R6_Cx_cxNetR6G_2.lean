-- Source module: Solutions.R6CxNetSim
/-!
# Chunk programs with phase frames (the physical simulation, any wire type)

A **chunk** at label `V` first moves some wires to `V` (each move `U → V` is one merged frame
change `edgeStepsM`, needing `EdgeOK V U`), then applies elementary scalar gates
`z_dst += c · z_src` (pointwise on the addresses) whose two wires are at `V`.

* `Inv lab Λ F`: the physical state `F` is the logical state `Λ` in the frames `Φ_{q_{lab w}}`.
* `chunk_sim` / `prog_sim`: a valid chunk (program) maps `Inv lab Λ F` to
  `Inv lab' (runOps ops Λ) (den · F)`.
* `prog_widths`: the child widths are the residual dimensions `Fd V U` of the moves.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx

open Matrix Finset Complex Butterfly P8Lift NetComplexP8 NetComplexLabels

variable {m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]
variable {R : Type} [Fintype R] [DecidableEq R]

/-! ## Programs -/

lemma progValid_append :
    ∀ (a b : List (GChunk R m)) (lab : R → Lab m),
      ProgValid (a ++ b) lab ↔ ProgValid a lab ∧ ProgValid b (progLab a lab) := by
  intro a
  induction a with
  | nil => intro b lab; simp [ProgValid, progLab]
  | cons C a ih =>
    intro b lab
    simp only [List.cons_append, ProgValid, progLab, ih]
    tauto

lemma progLab_append (a b : List (GChunk R m)) (lab : R → Lab m) :
    progLab (a ++ b) lab = progLab b (progLab a lab) := by
  induction a generalizing lab with
  | nil => rfl
  | cons C a ih => simp [progLab, ih]

/-! ## Child widths -/

lemma widths_gates (ops : List (GOp R)) :
    (ops.map fun o => (HStep.gate o.mat : HStep R m)).filterMap HStep.width = [] := by
  induction ops with
  | nil => rfl
  | cons o ops ih => simp [HStep.width, ih]

theorem mvSteps_widths (V : Lab m) :
    ∀ (mv : List (R × Lab m)) (lab : R → Lab m), MvValid V mv lab →
      (mvSteps V mv).filterMap HStep.width = mvWidths V mv := by
  intro mv
  induction mv with
  | nil => intro _ _; rfl
  | cons p mv ih =>
    intro lab hv
    rw [mvSteps, List.flatMap_cons, List.filterMap_append, ← mvSteps, ih _ hv.2.2,
      edgeStepsM_widths p.1 hv.2.1]
    rfl

theorem chunk_widths (C : GChunk R m) (lab : R → Lab m) (hC : C.Valid lab) :
    C.steps.filterMap HStep.width = mvWidths C.V C.mv := by
  rw [GChunk.steps, List.filterMap_append, mvSteps_widths C.V C.mv lab hC.1, widths_gates,
    List.append_nil]

theorem prog_widths :
    ∀ (cs : List (GChunk R m)) (lab : R → Lab m), ProgValid cs lab →
      (progSteps cs).filterMap HStep.width = progWidths cs := by
  intro cs
  induction cs with
  | nil => intro _ _; rfl
  | cons C cs ih =>
    intro lab hv
    rw [progSteps, List.flatMap_cons, List.filterMap_append, ← progSteps, ih _ hv.2,
      chunk_widths C lab hv.1]
    rfl

end IntMul.Kappa.R6.Cx

end

