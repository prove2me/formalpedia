open TypeDensity
open scoped BigOperators ENNReal

theorem solution (R : Type) [CommRing R] (t x : R)
    (beta : TypeDensity.BlowupRestriction R t x) (D : TypeDensity.TwoChartCurveData R t x beta) (i : D.ι) :
    TypeDensity.leftMultiplicity D (Sum.inl i) = TypeDensity.commonMultiplicity D i ∧
      TypeDensity.rightMultiplicity D (Sum.inl i) = TypeDensity.commonMultiplicity D i := by
  constructor
  · unfold TypeDensity.leftMultiplicity TypeDensity.commonMultiplicity TypeDensity.leftLevelIdeal TypeDensity.commonLevelIdeal TypeDensity.finiteLocalCurveIdeal
    symm
    refine TypeDensity.length_quot_span_pair_toNat_eq (D.leftIso i) _ _ _ _ rfl ?_
    have := D.leftIso_compat i (TypeDensity.chartBase R t x t)
    unfold TypeDensity.overlapException
    rw [this]; rfl
  · unfold TypeDensity.rightMultiplicity TypeDensity.commonMultiplicity TypeDensity.rightLevelIdeal TypeDensity.commonLevelIdeal
      TypeDensity.finiteLocalCurveIdeal
    symm
    refine TypeDensity.length_quot_span_pair_toNat_eq (D.rightIso i) _ _ _ _ rfl ?_
    have hx := D.rightIso_compat i (TypeDensity.chartBase R x t x)
    have hrel : beta.right (TypeDensity.chartBase R x t x) = TypeDensity.overlapException R t x * TypeDensity.overlapSlope R t x := by
      have h1 : beta.right (TypeDensity.chartBase R x t x) = algebraMap R (TypeDensity.BlowupOverlap R t x) x :=
        beta.right.commutes x
      have h2 := congrArg (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x))
        (TypeDensity.blowup_chart_relation R t x)
      rw [h1]
      unfold TypeDensity.overlapException TypeDensity.overlapSlope
      rw [← map_mul, h2]
      exact (IsScalarTower.algebraMap_apply R (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) x).symm
    have hu : IsUnit (TypeDensity.overlapSlope R t x) := IsLocalization.Away.algebraMap_isUnit _
    have hu' : IsUnit (D.rightIso i
        (TypeDensity.completedPointMap (TypeDensity.BlowupOverlap R t x) (D.Q i) (TypeDensity.overlapSlope R t x))) :=
      (hu.map _).map _
    rw [hrel, map_mul, map_mul] at hx
    refine Eq.trans ?_ (congrArg Ideal.span (congrArg _ hx))
    exact Ideal.span_singleton_mul_right_unit hu' _ |>.symm
