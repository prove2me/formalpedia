private noncomputable def d049 {w : InfinitePlace K} (hw : w.IsComplex) (a : (AdeleRing (𝓞 K) K)ˣ) : ℂ :=
  ringEquivComplexOfIsComplex hw (((a : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w)

variable (archR : ∀ w : InfinitePlace K, w.IsReal → RealArchParam)
  (archC : ∀ w : InfinitePlace K, w.IsComplex → ComplexArchParam)
  (dR : ∀ (w : InfinitePlace K) (hw : w.IsReal), ArchDatumR (archR w hw))
  (dC : ∀ (w : InfinitePlace K) (hw : w.IsComplex), ArchDatumC (archC w hw))

private theorem t0542 (w : InfinitePlace K) (hw : w.IsReal) (a : (AdeleRing (𝓞 K) K)ˣ)
    (g : AdelicGL2 (𝓞 K) K) :
    d015 archR archC dR dC w (diagOne a * g) =
