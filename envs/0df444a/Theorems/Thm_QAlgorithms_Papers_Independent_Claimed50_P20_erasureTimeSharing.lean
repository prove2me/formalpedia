/-- Section 10 and Figure 3, PDF pp.18--19: exact straight CEF segment plus unit cone.
The two endpoints are the p=0 and p=1/2 input-entropy endpoints of Theorem 5. -/
theorem erasureTimeSharing (epsilon : ℝ) (he0 : 0 ≤ epsilon) (he1 : epsilon ≤ 1) :
    operationalDynamicRegion (qubitErasure epsilon) =
      {r | ∃ t : ℝ, 0 ≤ t ∧ t ≤ 1 ∧ ∃ u ∈ unitCone,
        r = (1 - t) • erasureCEF epsilon 0 + t • erasureCEF epsilon 1 + u} := by sorry

end QAlgorithms.Papers.Independent.Claimed50.P20

