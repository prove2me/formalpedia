section

variable {F : Type*} [CommRing F] {ψ : AddChar F ℂ} {W : GL (Fin 3) F → ℂ} {U : Subgroup (GL (Fin 3) F)}

private theorem apply_eq_zero_of_conj_secondRoot_mem (hW : IsGL3PsiWhittakerFn ψ W) (hU : IsRightInvariant U W)
    {g : GL (Fin 3) F} {y : F} (hy : g⁻¹ * upperUnipotent3 0 y 0 * g ∈ U) (hψ : ψ y ≠ 1) : W g = 0 := by
  have hlaw : W (upperUnipotent3 0 y 0 * g) = ψ y * W g := by
    have h := hW 0 y 0 g
    rwa [zero_add] at h
  have hconj : g * (g⁻¹ * upperUnipotent3 0 y 0 * g) = upperUnipotent3 0 y 0 * g := by group
  have hinv : W (upperUnipotent3 0 y 0 * g) = W g := by
    rw [← hconj]
    exact hU g _ hy
  have hzero : (ψ y - 1) * W g = 0 := by
    rw [sub_mul, one_mul, ← hlaw, hinv, sub_self]
  rcases mul_eq_zero.1 hzero with h | h
  · exact absurd (sub_eq_zero.1 h) hψ
  · exact h

private theorem apply_eq_zero_of_conj_firstRoot_mem (hW : IsGL3PsiWhittakerFn ψ W) (hU : IsRightInvariant U W)
    {g : GL (Fin 3) F} {y : F} (hy : g⁻¹ * upperUnipotent3 y 0 0 * g ∈ U) (hψ : ψ y ≠ 1) : W g = 0 := by
  have hlaw : W (upperUnipotent3 y 0 0 * g) = ψ y * W g := by
    have h := hW y 0 0 g
    rwa [add_zero] at h
  have hconj : g * (g⁻¹ * upperUnipotent3 y 0 0 * g) = upperUnipotent3 y 0 0 * g := by group
  have hinv : W (upperUnipotent3 y 0 0 * g) = W g := by
    rw [← hconj]
    exact hU g _ hy
  have hzero : (ψ y - 1) * W g = 0 := by
    rw [sub_mul, one_mul, ← hlaw, hinv, sub_self]
  rcases mul_eq_zero.1 hzero with h | h
  · exact absurd (sub_eq_zero.1 h) hψ
  · exact h

end

section

variable {A : Type*} [CommRing A]

private theorem val_mul_val_mul_val_inv_mul_val_inv (a x : Aˣ) :
    (a : A) * ((x : A) * (((a⁻¹ : Aˣ) : A) * ((x⁻¹ : Aˣ) : A))) = 1 := by
  rw [mul_left_comm (x : A), Units.mul_inv, mul_one, Units.mul_inv]

private def dualCell (a x : Aˣ) : GL (Fin 3) A where
  val := !![0, -((a : A) * ((x⁻¹ : Aˣ) : A)), 0; (x : A), 1, 0; 0, 0, 1]
  inv := !![((a⁻¹ : Aˣ) : A), ((x⁻¹ : Aˣ) : A), 0; -((x : A) * ((a⁻¹ : Aˣ) : A)), 0, 0; 0, 0, 1]
  val_inv := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_three, mul_assoc, mul_left_comm, mul_comm,
        val_mul_val_mul_val_inv_mul_val_inv]
  inv_val := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_three, mul_assoc, mul_left_comm, mul_comm,
        val_mul_val_mul_val_inv_mul_val_inv]

private theorem coe_dualCell (a x : Aˣ) :
    ((dualCell a x : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) =
      !![0, -((a : A) * ((x⁻¹ : Aˣ) : A)), 0; (x : A), 1, 0; 0, 0, 1] := rfl

private theorem coe_inv_dualCell (a x : Aˣ) :
    (((dualCell a x)⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) =
      !![((a⁻¹ : Aˣ) : A), ((x⁻¹ : Aˣ) : A), 0; -((x : A) * ((a⁻¹ : Aˣ) : A)), 0, 0; 0, 0, 1] := rfl

private theorem iotaGL_diagUnitGL2_mul_lowerUnipotent21_eq (a x : Aˣ) :
    iotaGL (diagUnitGL2 a) * lowerUnipotent21 (x : A) =
      upperUnipotent3 ((a : A) * ((x⁻¹ : Aˣ) : A)) 0 0 * dualCell a x := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul, coe_iotaGL, coe_diagUnitGL2, lowerUnipotent21_coe, coe_dualCell]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [embedMat2, upperUnipotent3, Matrix.mul_apply, Fin.sum_univ_three, mul_assoc]

private theorem inv_dualCell_mul_secondRoot_mul_dualCell (a x : Aˣ) (y : A) :
    (dualCell a x)⁻¹ * upperUnipotent3 0 y 0 * dualCell a x = upperUnipotent3 0 0 (y * ((x⁻¹ : Aˣ) : A)) := by
  apply Units.ext
  rw [Units.val_mul, Units.val_mul, coe_inv_dualCell, coe_dualCell]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [upperUnipotent3, Matrix.mul_apply, Fin.sum_univ_three, mul_assoc, mul_left_comm, mul_comm,
      val_mul_val_mul_val_inv_mul_val_inv]

private theorem inv_iotaGL_diagUnitGL2_mul_firstRoot_mul_iotaGL_diagUnitGL2 (d : Aˣ) (y : A) :
    (iotaGL (diagUnitGL2 d))⁻¹ * upperUnipotent3 y 0 0 * iotaGL (diagUnitGL2 d) =
      upperUnipotent3 (((d⁻¹ : Aˣ) : A) * y) 0 0 := by
  apply Units.ext
  have hinv : ((iotaGL (diagUnitGL2 d))⁻¹ : GL (Fin 3) A) = iotaGL (diagUnitGL2 d⁻¹) := by
    rw [← map_inv]
    congr 1
  rw [hinv, Units.val_mul, Units.val_mul, coe_iotaGL, coe_diagUnitGL2, coe_iotaGL, coe_diagUnitGL2]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [embedMat2, upperUnipotent3, Matrix.mul_apply, Fin.sum_univ_three, mul_comm]

end

