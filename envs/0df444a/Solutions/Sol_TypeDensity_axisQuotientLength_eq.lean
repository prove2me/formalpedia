    intro m hm
    rw [map_sub, hF0, if_pos hm, sub_self]
  have hX : Xt ^ d ∣ F0 := by
    rw [MvPowerSeries.X_pow_dvd_iff]
    intro m hm
    rw [hF0]
    split_ifs with h0
    · rw [TypeDensity.eq_single_of_apply_eq_zero hst h0]; exact hlow _ hm
    · rfl
