variable {E : Type*} [NormedAddCommGroup E]

private def fdiff (h : ℝ) (G : ℝ → E) : ℝ → E := fun t => G (t + h) - G t

private theorem fdiff_apply (h : ℝ) (G : ℝ → E) (t : ℝ) : fdiff h G t = G (t + h) - G t := rfl

variable [NormedSpace ℝ E]

private theorem contDiff_comp_add_const {G : ℝ → E} (hG : ContDiff ℝ ∞ G) (a : ℝ) : ContDiff ℝ ∞ (fun t => G (t + a)) :=
  hG.comp (contDiff_id.add contDiff_const)

private theorem contDiff_fdiff {G : ℝ → E} (hG : ContDiff ℝ ∞ G) (h : ℝ) : ContDiff ℝ ∞ (fdiff h G) :=
  (contDiff_comp_add_const hG h).sub hG

private theorem iteratedDeriv_fdiff {G : ℝ → E} (hG : ContDiff ℝ ∞ G) (h : ℝ) (n : ℕ) :
    iteratedDeriv n (fdiff h G) = fdiff h (iteratedDeriv n G) := by
  funext t
  have h1 : ContDiffAt ℝ n (fun t => G (t + h)) t := ((contDiff_comp_add_const hG h).of_le (by exact_mod_cast le_top)).contDiffAt
  have h2 : ContDiffAt ℝ n G t := (hG.of_le (by exact_mod_cast le_top)).contDiffAt
  show iteratedDeriv n ((fun t => G (t + h)) - G) t = iteratedDeriv n G (t + h) - iteratedDeriv n G t
  rw [iteratedDeriv_sub h1 h2, iteratedDeriv_comp_add_const n G h]

private theorem norm_fdiff_le {G : ℝ → E} (hG : Differentiable ℝ G) {M : ℝ} (hM : ∀ t, ‖deriv G t‖ ≤ M) {h : ℝ} (hh : 0 ≤ h) (t : ℝ) :
    ‖fdiff h G t‖ ≤ M * h := by
  have key := Convex.norm_image_sub_le_of_norm_deriv_le (s := Set.univ) (fun x _ => hG x) (fun x _ => hM x) convex_univ
    (Set.mem_univ t) (Set.mem_univ (t + h))
  rw [fdiff_apply]
  rwa [add_sub_cancel_left, Real.norm_of_nonneg hh] at key

private theorem norm_iterate_fdiff_le (k : ℕ) :
    ∀ {G : ℝ → E} (_ : ContDiff ℝ ∞ G) {M : ℝ} (_ : ∀ t, ‖iteratedDeriv k G t‖ ≤ M) {h : ℝ} (_ : 0 ≤ h) (t : ℝ),
      ‖(fdiff h)^[k] G t‖ ≤ M * h ^ k := by
  induction k with
  | zero =>
    intro G _ M hM h _ t
    simpa only [Function.iterate_zero, id_eq, pow_zero, mul_one, iteratedDeriv_zero] using hM t
  | succ k ih =>
    intro G hG M hM h hh t
    rw [Function.iterate_succ_apply]

    have hd : Differentiable ℝ (iteratedDeriv k G) := hG.differentiable_iteratedDeriv k (by exact_mod_cast ENat.coe_lt_top k)
    have hb : ∀ s, ‖iteratedDeriv k (fdiff h G) s‖ ≤ M * h := fun s => by
      rw [iteratedDeriv_fdiff hG h k]
      exact norm_fdiff_le hd (fun u => by rw [← iteratedDeriv_succ]; exact hM u) hh s
    have h1 := ih (contDiff_fdiff hG h) hb hh t
    rw [pow_succ, ← mul_assoc]
    rwa [mul_right_comm] at h1

end OneVar
