/-- The VII-07 actual acceleration is `Σ_c K^c (∇_c K)^a`. -/
theorem accel_eq_sum_covD (g gi : Metric 5) (K : Pt 5 → Fin 5 → ℝ) (x : Pt 5) (a : Fin 5) :
    accel g gi K x a = ∑ c, K x c * covD (christoffel g gi) K x c a := by
  simp only [accel, covD, mul_add, Finset.sum_add_distrib, Finset.mul_sum]
  congr 1
  exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun l _ => by ring

