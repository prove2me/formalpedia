private theorem not_isUnit_three_int :
    (Ideal.span ({2} : Set ℤ)).IsMaximal ∧ ¬ (2 : ℤ) ∣ 3 ∧ ¬ IsUnit (3 : ℤ) :=
  ⟨PrincipalIdealRing.isMaximal_of_irreducible Int.prime_two.irreducible,
