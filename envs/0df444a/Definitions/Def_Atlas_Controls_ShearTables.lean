/-- The sheared control metric `Jᵀ h(Φ) J` with `J = I + λ cos α E₃₂`: angular block
`[[1 + λ²c²s², λ c s²], [λ c s², s²]]`, `c = cos α`, `s = sin α`. -/
noncomputable def gCtl (lam : ℝ) : Metric 4
  | 0, 0 => fun _ => -1
  | 1, 1 => fun _ => 1
  | 2, 2 => fun x => 1 + lam ^ 2 * (cos (x 2) ^ 2 * sin (x 2) ^ 2)
  | 2, 3 => fun x => lam * (cos (x 2) * sin (x 2) ^ 2)
  | 3, 2 => fun x => lam * (cos (x 2) * sin (x 2) ^ 2)
  | 3, 3 => fun x => 1 * sin (x 2) ^ 2
  | _, _ => fun _ => 0

/-- Candidate inverse: angular block `[[1, −λ c], [−λ c, (1 + λ²c²s²)/s²]]` (block determinant `s²`). -/
noncomputable def giCtl (lam : ℝ) : Metric 4
  | 0, 0 => fun _ => -1
  | 1, 1 => fun _ => 1
  | 2, 2 => fun _ => 1
  | 2, 3 => fun x => -(lam * cos (x 2))
  | 3, 2 => fun x => -(lam * cos (x 2))
  | 3, 3 => fun x => (1 + lam ^ 2 * (cos (x 2) ^ 2 * sin (x 2) ^ 2)) / sin (x 2) ^ 2
  | _, _ => fun _ => 0

 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 
 

