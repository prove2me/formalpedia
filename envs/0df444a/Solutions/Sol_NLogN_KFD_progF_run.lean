      · rw [h, Nat.mul_zero] at hLW; omega
      · exact h
    have hL' : W ^ k ∣ L' := by
      rw [← hLW, pow_succ'] at hL
      exact Nat.dvd_of_mul_dvd_mul_left (NeZero.pos W) hL
    have hpow : N ^ m = q ^ m ^ (k + 1) := by rw [hNdef, ← pow_mul, ← pow_succ]
    have hvolB : AModel.vol (P :: W * L' :: AModel.hdShape A B Cs m N) =
        AModel.vol (P :: L :: AModel.swShape A B Cs (q ^ m ^ (k + 1))) := by
      rw [hLW]; simp only [AModel.vol_cons, AModel.vol_hdShape, hpow]
    have hvbig : AModel.vol (P :: W * L' :: AModel.hdShape A B Cs m N) =
        W * AModel.vol (P :: L' :: AModel.hdShape A B Cs m N) := by simp only [AModel.vol_cons]; ring
    have hposH : ∀ a ∈ P :: L' :: AModel.hdShape A B Cs m N, 1 ≤ a := by
      intro a ha
      simp only [AModel.hdShape, List.mem_cons, List.mem_append, List.mem_replicate] at ha
      rcases ha with rfl | rfl | ha | ⟨-, rfl⟩ | ha | ⟨-, rfl⟩ | ha
      all_goals first | omega | exact hA _ ‹_› | exact hB _ ‹_› | exact hC _ ‹_›
    have hposS := NLogN.KIL.vol_swShape_pos hP hL1 hA hB hC (show 1 ≤ q ^ m ^ (k + 1) by
      rw [← hpow]; exact Nat.one_le_pow _ _ (by omega))
    set v := AModel.vol (P :: L' :: AModel.hdShape A B Cs m N) with hv
    set V := AModel.vol (P :: L :: AModel.swShape A B Cs (q ^ m ^ (k + 1))) with hVd
    have hvV : v ≤ V := by
      rw [← hvolB, hvbig]; exact Nat.le_mul_of_pos_left _ hW1
    have hk' : NLogN.zsz (k : ℤ) ≤ Bb := le_trans (NLogN.KIL.zsz_nat_le (show k ≤ k + 1 by omega)) hk
    have hQ2 : NLogN.zsz ((2 * N : ℕ) : ℤ) ≤ Bb := by
      refine le_trans (NLogN.KIL.zsz_nat_le ?_) hV
      have h1 := NLogN.KIL.sq_le_vol_swShape hposS
      have h2 : N ≤ q ^ m ^ (k + 1) := by
        rw [← hpow]; exact Nat.le_self_pow (by omega) _
      have h3 : 2 ≤ q ^ m ^ (k + 1) := by omega
      nlinarith
    have hV' : NLogN.zsz ((AModel.vol (P :: W * L' :: AModel.hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb := by
      rw [hvolB]; exact hV
    have hvS : NLogN.zsz ((v : ℕ) : ℤ) ≤ Bb := le_trans (NLogN.KIL.zsz_nat_le hvV) hV
    have hLvk := hLv k (by omega)
    set Pr : AModel.IMat m → Prop := fun X => AModel.edgeSteps C N X = (tpl X).map (NLogN.KIL.TStep.eval N) ∧
      ∀ T, NLogN.KIL.TStep.sh T ∈ tpl X → NLogN.KIL.TOK T N Bb with hPr
    -- the child
    set child : Fin (m + m) → Fin (m + m) → List (ZMod 2) → List (ZMod 2) := fun a b =>
      AModel.prog C q k P L' (A ++ List.replicate a N)
        (List.replicate (m - 1 - a) N ++ (B ++ List.replicate (b - m) N))
        (List.replicate (m + m - 1 - b) N ++ Cs) with hchild
    have hprog : AModel.prog C q (k + 1) P L A B Cs xs = AModel.levelR C N P L' A B Cs child xs := rfl
    rw [hprog]
    set c0 := NLogN.KFD.ilCostF W (NLogN.KFD.KlevF C tpl + 10 ^ 5) (NLogN.KFD.KbF C tpl + 10 ^ 9 + 100) (NLogN.KIL.Kd m) (NLogN.KIL.SWn C tpl) q Bb k v with hc0
    set cC := c0 + NLogN.KIL.Kd m * (Bb + 2) ^ 2 with hcC
    -- selection
    set t0 := t.upd 0 (NLogN.ints (NLogN.KIL.enc2 xs) ++ R) with ht0
    obtain ⟨R1, h1⟩ := hD.j
    have hcl : (fun c => c == NLogN.Cls.zero) (t0.cl NLogN.KIL.dJ) = false := by
      have h0 : t0.G NLogN.KIL.dJ = .int ((k + 1 : ℕ) : ℤ) :: R1 := by
        rw [NLogN.IState.upd_G, if_neg (by decide)]; exact h1
      rw [NLogN.cl_int t0 NLogN.KIL.dJ _ R1 h0]
      have e1 : ((k + 1 : ℕ) : ℤ) ≠ 0 := by omega
      have e2 : ¬ ((k + 1 : ℕ) : ℤ) < 0 := by omega
      rw [if_neg e1, if_neg e2]; rfl
    -- entry
    obtain ⟨R7, h7, hbnd, SE⟩ := NLogN.KIL.entry_sp hm hq hW1 hWL t0 (hD.upd0 _) hposS Bb hV hk
    set T7 := NLogN.ints (NLogN.KIL.towerL q m k) ++ R7 with hT7
    set t1 := NLogN.KIL.entS t0 (q ^ m ^ (k + 1)) T7 with ht1
    set ev := NLogN.KIL.entV W m N P L k A B Cs with hev
    set t2 := NLogN.KIL.pushSt t1 ev with ht2
    have g1 : ∀ r : Fin NLogN.HS, r ≠ NLogN.KIL.rS → r ≠ NLogN.KIL.dT → r ≠ 0 → t1.G r = t.G r := fun r a b c => by
      simp [t1, NLogN.KIL.entS, t0, a, b, c]
    obtain ⟨R2, h2⟩ := hD.p
    have q1 : t2.G NLogN.KIL.sQQ = .int (N : ℤ) :: t1.G sQQ := by simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints]
    have q2 : t2.G NLogN.KIL.sNQ = .int (-(N : ℤ)) :: t1.G sNQ := by
      simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints]
    have q3 : t2.G NLogN.KIL.rLp = .int (L' : ℤ) :: t1.G rLp := by
      simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints, ← hL'def]
    have q4 : t2.G NLogN.KIL.rJ1 = .int (k : ℤ) :: t1.G rJ1 := by simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints]
    have q5 : t2.G NLogN.KIL.rVA = .int ((AModel.vol A : ℕ) : ℤ) :: t1.G rVA := by
      simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints]
    have q6 : t2.G NLogN.KIL.rVB = .int ((AModel.vol B : ℕ) : ℤ) :: t1.G rVB := by
      simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints]
    have q7 : t2.G NLogN.KIL.rVC = .int ((AModel.vol Cs : ℕ) : ℤ) :: t1.G rVC := by
      simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints]
    have q8 : t2.G NLogN.KIL.rXs = .int ((AModel.vol (P :: L' :: A) : ℕ) : ℤ) :: t1.G rXs := by
      simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints, ← hL'def]
    have q9 : t2.G NLogN.KIL.rXb = .int ((AModel.vol (P :: W * L' :: A) : ℕ) : ℤ) :: t1.G rXb := by
      simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints, ← hL'def]
    have q10 : t2.G NLogN.KIL.rV = .int ((v : ℕ) : ℤ) :: t1.G rV := by
      simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints, ← hL'def, v]
    have q11 : t2.G NLogN.KIL.rWV = .int ((W * v : ℕ) : ℤ) :: t1.G rWV := by
      simp +decide [t2, ev, NLogN.KIL.entV, NLogN.KIL.pushSt_G, NLogN.ints, ← hL'def, v]
    have q12 : t2.G NLogN.KIL.dP = .int (P : ℤ) :: R2 := by
      rw [ht2, NLogN.KIL.pushSt_G]; simp +decide [ev, NLogN.KIL.entV]; rw [g1 NLogN.KIL.dP (by decide) (by decide) (by decide), h2]
    have q13 : t2.G NLogN.KIL.dT = T7 := by
      rw [ht2, NLogN.KIL.pushSt_G]; simp +decide [ev, NLogN.KIL.entV, t1, NLogN.KIL.entS]
    have q0 : t2.G 0 = NLogN.ints (NLogN.KIL.enc2 xs) ++ R := by
      rw [ht2, NLogN.KIL.pushSt_G]; simp +decide [ev, NLogN.KIL.entV, t1, NLogN.KIL.entS, t0]
    have hG : NLogN.KIL.LevG t2.G m W N P L' A B Cs :=
      ⟨⟨_, q1⟩, ⟨_, q2⟩, ⟨_, q8⟩, ⟨_, q9⟩, ⟨_, q6⟩, ⟨_, q7⟩, ⟨_, q10⟩, ⟨_, q11⟩, ⟨_, q12⟩, ⟨_, q3⟩⟩
    -- the child calls
    have hsw : ∀ X, Pr X → ∀ (a b : Fin (m + m)), NLogN.KIL.TStep.sw a b ∈ tpl X → ∀ (t' : NLogN.IState NLogN.HS)
        (R' : List NLogN.Item) (ys : List (ZMod 2)), NLogN.KIL.Inv t2.G t' → ys.length = v →
        NLogN.IRuns I (NLogN.KFD.progF C tpl) (NLogN.KIL.swC m (0 : Fin 1) (a : ℕ) (b : ℕ))
          (t'.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R')) (t'.upd 0 (NLogN.ints (NLogN.KIL.enc2 (child a b ys)) ++ R')) cC ∧
        (child a b ys).length = v := by
      intro X hX a b hab t' R' ys ht' hys
      have hmem : AModel.Step.swap a b ∈ AModel.edgeSteps C N X := by
        rw [hX.1]; exact List.mem_map.2 ⟨_, hab, rfl⟩
      obtain ⟨i, j, rfl, rfl⟩ := NLogN.KIL.edgeSteps_swap_HD C N X hmem
      have pr : ∀ r : Fin NLogN.HS, 22 ≤ r.val → r.val ≠ 44 → NLogN.KIL.Prot r := fun r h1 h2 => ⟨h1, h2⟩
      have e1 : ((Fin.castAdd m i : Fin (m + m)) : ℕ) = i := by simp
      have e2 : ((Fin.natAdd m j : Fin (m + m)) : ℕ) - m = j := by simp
      have e3 : m + m - 1 - ((Fin.natAdd m j : Fin (m + m)) : ℕ) = m - 1 - j := by simp; omega
      have hsh := AModel.swShape_child A B Cs (N := N) i j
      have hvc : AModel.vol (P :: L' :: AModel.swShape (A ++ List.replicate i N)
          (List.replicate (m - 1 - i) N ++ (B ++ List.replicate j N))
          (List.replicate (m - 1 - j) N ++ Cs) (q ^ m ^ k)) = v := by
        rw [← hNdef, hsh]
      have hchild' : child (Fin.castAdd m i) (Fin.natAdd m j) = AModel.prog C q k P L'
          (A ++ List.replicate i N) (List.replicate (m - 1 - i) N ++ (B ++ List.replicate j N))
          (List.replicate (m - 1 - j) N ++ Cs) := by
        simp only [hchild, e1, e2, e3]
      have hrec : ∀ (t'' : NLogN.IState NLogN.HS) (R'' : List NLogN.Item) (ys' : List (ZMod 2)),
          NLogN.KIL.DescIn t'' q m k P L' (A ++ List.replicate ((Fin.castAdd m i : Fin (m + m)) : ℕ) N)
            (List.replicate (m - 1 - ((Fin.castAdd m i : Fin (m + m)) : ℕ)) N ++
              (B ++ List.replicate (((Fin.natAdd m j : Fin (m + m)) : ℕ) - m) N))
            (List.replicate (m + m - 1 - ((Fin.natAdd m j : Fin (m + m)) : ℕ)) N ++ Cs) →
          ys'.length = v →
          NLogN.IRuns I (NLogN.KFD.progF C tpl) (NLogN.KFD.progF C tpl 0) (t''.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys') ++ R''))
            (t''.upd 0 (NLogN.ints (NLogN.KIL.enc2 (child (Fin.castAdd m i) (Fin.natAdd m j) ys')) ++ R'')) c0 := by
        intro t'' R'' ys' hD' hys'
        rw [e1, e2, e3] at hD'
        rw [hchild']
        have IH := ih (fun j' hj' => hLv j' (by omega)) hk' P L' (A ++ List.replicate i N)
          (List.replicate (m - 1 - i) N ++ (B ++ List.replicate j N))
          (List.replicate (m - 1 - j) N ++ Cs) hP hL' hL1'
          (fun a ha => by
            simp only [List.mem_append, List.mem_replicate] at ha
            rcases ha with ha | ⟨-, rfl⟩
            · exact hA a ha
            · omega)
          (fun a ha => by
            simp only [List.mem_append, List.mem_replicate] at ha
            rcases ha with ⟨-, rfl⟩ | ha | ⟨-, rfl⟩
            · omega
            · exact hB a ha
            · omega)
          (fun a ha => by
            simp only [List.mem_append, List.mem_replicate] at ha
            rcases ha with ⟨-, rfl⟩ | ha
            · omega
            · exact hC a ha)
          (by rw [hvc]; exact hvS) t'' R'' ys' hD' (by rw [hvc]; exact hys')
        rw [hvc] at IH
        exact IH
      have gt : ∀ r : Fin NLogN.HS, NLogN.KIL.Prot r → t'.G r = t2.G r := ht'
      have S := NLogN.KIL.swC_runs (I := I) (iprog := NLogN.KFD.progF C tpl) (q := q) (k := k) (P := P) (L' := L')
        (A := A) (B := B) (Cs := Cs) ((Fin.castAdd m i : Fin (m + m)) : ℕ)
        ((Fin.natAdd m j : Fin (m + m)) : ℕ) (by simp) (by simp) (by simp)
        (0 : Fin 1) (child (Fin.castAdd m i) (Fin.natAdd m j)) c0 hrec Bb (by omega) hposH hvS hk'
        t' (by rw [gt NLogN.KIL.rJ1 (pr _ (by decide) (by decide))]; exact q4)
        (by rw [gt NLogN.KIL.rLp (pr _ (by decide) (by decide))]; exact q3)
        (by rw [gt NLogN.KIL.rVA (pr _ (by decide) (by decide))]; exact q5)
        (by rw [gt NLogN.KIL.rVB (pr _ (by decide) (by decide))]; exact q6)
        (by rw [gt NLogN.KIL.rVC (pr _ (by decide) (by decide))]; exact q7)
        (by rw [gt NLogN.KIL.sQQ (pr _ (by decide) (by decide))]; exact q1)
        (by rw [gt NLogN.KIL.dP (pr _ (by decide) (by decide))]; exact q12)
        (by rw [gt NLogN.KIL.dT (pr _ (by decide) (by decide))]; exact q13)
        R' ys hys
      refine ⟨S.mono (NLogN.KIL.cSwC_le (Fin.castAdd m i).2 (Fin.natAdd m j).2 Bb c0), ?_⟩
      rw [hchild', NLogN.KIL.length_prog C q P _ _ _ ys k L' hL', hvc]
    -- the body
    have HB := NLogN.KFD.bodyF_run (I := I) (iprog := NLogN.KFD.progF C tpl) C hN P L' A B Cs hposH tpl Pr
      hLvk.frames (fun X hX => hX.1) Bb (fun X hX => hX.2) hV' hQ2 hLvk.sub t2.G hG (0 : Fin 1)
      child cC hsw t2 (fun _ _ => rfl) R xs
      (by rw [hvolB]; exact hxs)
    rw [show t2.upd 0 (NLogN.ints (NLogN.KIL.enc2 xs) ++ R) = t2 by rw [← q0, NLogN.IState.upd_self]] at HB
    -- exit
    set Y := NLogN.ints (NLogN.KIL.enc2 (AModel.levelR C N P L' A B Cs child xs)) ++ R
    have zF : NLogN.zsz ((q ^ m ^ (k + 1) : ℕ) : ℤ) ≤ Bb := by
      refine le_trans (NLogN.KIL.zsz_nat_le ?_) hV
      have h1 := NLogN.KIL.sq_le_vol_swShape hposS
      have h3 : 1 ≤ q ^ m ^ (k + 1) := Nat.one_le_pow _ _ (by omega)
      nlinarith
    have SX := NLogN.KIL.exit_sp (W := W) t0 R7 h7 Y Bb hbnd zF
    have e0 : (0 : Fin NLogN.HS) ∉ ev.map Prod.fst := by simp +decide [ev, NLogN.KIL.entV]
    rw [← NLogN.KIL.pushSt_upd_comm _ _ _ _ e0] at HB
    rw [ht0, NLogN.IState.upd_upd_same] at SX
    have H := NLogN.IRuns.iteF (I := I) (iprog := NLogN.KFD.progF C tpl) (i := NLogN.KIL.dJ) (f := fun c => c == NLogN.Cls.zero)
      (p := NLogN.KFD.lev0F) (q := NLogN.KFD.levF C tpl) hcl (SE.toIRuns.seq (HB.seq SX.toIRuns))
    refine H.mono ?_
    -- cost
    have hr1 : 1 ≤ AModel.vol (AModel.hdShape A B Cs m N) := NLogN.KIL.vol_pos_of (fun a ha => hposH a
      (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ ha)))
    have hc := NLogN.KFD.levelCostF_le C tpl N P L' A B Cs cC Bb hP hL1' hr1
    rw [hvolB] at hc
    have hdiv : V / W = v := by
      rw [← hvolB, hvbig, Nat.mul_div_cancel_left _ (NeZero.pos W)]
    simp only [NLogN.KFD.ilCostF, hdiv]
    rw [← hc0, ← hcC]
    have hK := Nat.mul_le_mul_right (V + 1) (show NLogN.KFD.KlevF C tpl ≤ NLogN.KFD.KlevF C tpl + 10 ^ 5 by omega)
    have hK2 := Nat.mul_le_mul_right ((Bb + 2) ^ 2) (show NLogN.KFD.KbF C tpl ≤ NLogN.KFD.KbF C tpl + 10 ^ 9 + 100 by omega)
    omega
end
