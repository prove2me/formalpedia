theorem Runs.readUntil (σ : St S) (W : List Sym) (hW : stop ∉ W)
    (hk : ∀ k (hk : k < W.length), I.getD (σ.ip + k) codeEnd = W[k])
    (hstop : I.getD (σ.ip + W.length) codeEnd = stop) :
    NLogN.Runs I prog (NLogN.readUntil q x stop : Stmt S P) σ
      ((σ.set x (W.reverse ++ σ.stk x)).setIp (σ.ip + W.length + 1)) (readCost W.length) := by
  have hqx' := Ne.symm hqx
  -- first step: read one symbol
  have h0 : Reaches I q [x] (readδ q x stop) (σ.push q 0)
      (readCfg (q := q) (x := x) (σ.stk q) σ 1 (I.getD σ.ip codeEnd :: σ.stk x) (σ.ip + 1)) 1 := by
    refine Reaches.step' (by simp [St.top_eq, hlt]) ?_ (Reaches.refl _)
    simp [mstep, St.tops, St.top_eq, readδ, runOps, Op.run, readCfg, St.inRd_eq, St.push_eq_set,
      St.pop_eq_set, hqx, hqx', St.set, St.setIp, St.adv]
