# B-line axis budget 8: **`axBudget6_of`** (assembly of `AxBudget6`)

* `copy_facts`: the copy / swap descriptor facts at `Bs = axBcp6` (every value `≤ 2T`);
* **`axBudget6_of P hP ap : SideCost6 P ap → JBudget6 P ap → ChunkBudget6 P ap → AxBudget6 P ap`**
  (constants added, exponents maximised).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.ChB
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 J6Seg J6Seg.KR

section ax
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : Side.AxJ P n src D k)
include h

theorem copy_facts_sol_aux (hD : dP6 P n = D + 1) (hk : k ≤ D) :
    let post := axpost6 P n D k; let pre := axpre6 P n D k
    let Bs := axBcp6 P ap n src D k
    2 ≤ Bs ∧ zsz (k : ℤ) ≤ Bs ∧ zsz ((axs6 src k : ℕ) : ℤ) ≤ Bs ∧
    zsz ((axt6 P n k : ℕ) : ℤ) ≤ Bs ∧
    zsz ((axt6 P n k : ℤ) * post) ≤ Bs ∧ zsz ((pre : ℤ) * ((axt6 P n k : ℤ) * post)) ≤ Bs ∧
    zsz (2 * ((pre : ℤ) * ((axt6 P n k : ℤ) * post))) ≤ Bs := by
  dsimp only
  have hprod := h.base.prodT
  have htot := h.base.tot
  have hdT := h.base.dT
  have hst := h.st
  have hpre1 := h.base.pre1
  have hpost1 := h.base.post1
  have ht1 := h.base.t1
  have eB : axBcp6 P ap n src D k = axwd6 P n src k ap + Nat.size (2 * TP6 P n) + 2 := by
    unfold axBcp6; rw [hprod]
  rw [eB]
  have hS := Nat.lt_size_self (2 * TP6 P n)
  have key : ∀ (z : ℤ) (x : ℕ), z = (x : ℤ) → x ≤ 2 * TP6 P n →
      zsz z ≤ axwd6 P n src k ap + Nat.size (2 * TP6 P n) + 2 := by
    intro z x hz hx
    subst hz
    have : zsz (x : ℤ) ≤ Nat.size (2 * TP6 P n) :=
      zsz_le_of_lt (by simp only [Int.natAbs_natCast]; omega)
    omega
  set t := axt6 P n k
  set pre := axpre6 P n D k
  set post := axpost6 P n D k
  set T := TP6 P n
  have htp : t * post ≤ T := by
    rw [← htot]
    calc t * post = 1 * t * post := by ring
      _ ≤ pre * t * post := Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hpre1)
  have htT : t ≤ T := by
    have : t ≤ t * post := Nat.le_mul_of_pos_right _ hpost1
    omega
  have e3 : pre * (t * post) = T := by rw [← htot]; ring
  refine ⟨by omega, key _ k rfl (by omega), key _ _ rfl (by omega), key _ _ rfl (by omega),
    key _ (t * post) (by push_cast; ring) (by omega),
    key _ (pre * (t * post)) (by push_cast; ring) (by omega),
    key _ (2 * (pre * (t * post))) (by push_cast; ring) (by omega)⟩

end ax

end J6Seg.ChB
end

end

theorem solution : type_of% @J6Seg.ChB.copy_facts_sol_aux := @J6Seg.ChB.copy_facts_sol_aux
