end TFPThetaM1

theorem solution (t : Real) (h1 : 10 ^ 4 <= t) (h2 : t <= 10 ^ 6) :
    t * (1 - 1 / (2 * Real.log t)) < Chebyshev.theta t := by
  have ht0 : (0 : ℝ) ≤ t := by linarith
  have hm1 : 9999 ≤ ⌊t⌋₊ := Nat.le_floor (by norm_num at h1 ⊢; linarith)
  have hm2 : ⌊t⌋₊ < 1000001 := by
    have h := Nat.floor_le ht0
    have h' : (⌊t⌋₊ : ℝ) < 1000001 := by norm_num at h2; linarith
    exact_mod_cast h'
  exact TFPThetaM1.certB_sound TFPThetaM1.cond1 1000001
    (fun m => ∀ t : ℝ, ⌊t⌋₊ = m → 2 ≤ t → t * (1 - 1 / (2 * Real.log t)) < Chebyshev.theta t)
    TFPThetaM1.cond1_sound_real 9999 14276 TFPThetaM1.G0 TFPThetaM1.CP TFPThetaM1.CERT_ok ⌊t⌋₊ hm1 hm2 t rfl
    (by norm_num at h1; linarith)
