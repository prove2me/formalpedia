    (h0 : s.G 0 = ints (bitsL w xs) ++ R) (h2 : s.G cR2 = .int 2 :: L2)
    (hRW : s.G cRW = .int (2 ^ w) :: LRW)
    (hCw : s.G cCw = marks w ++ LCw) (hDw : s.G cDw = LDw) (hLCw : NM LCw) (hLDw : NM LDw)
    (hCN : s.G cCN = marks xs.length ++ LCN) (hDN : s.G cDN = LDN) (hLCN : NM LCN)
    (hLDN : NM LDN) :
    IRuns I iprog fromLoop s ((s.upd 0 R).upd cO (ints xs.reverse ++ s.G cO))
      (xs.length * (cBody2 w + 64) + 60) := by
  let T : ℕ → IState HS := fun k =>
    (s.upd 0 (ints (bitsL w (xs.drop k)) ++ R)).upd cO (ints (xs.take k).reverse ++ s.G cO)
  have hu := uloop_runs (I := I) (iprog := iprog) (C := cCN) (D := cDN) (by decide) xs.length T
    LCN LDN hLCN hLDN (cBody2 w) body2 (by
      intro k hk LC' LD'
      have hd : xs.drop k = xs[k] :: xs.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hb : bitsL w (xs.drop k) = encW w xs[k] ++ bitsL w (xs.drop (k + 1)) := by
        rw [hd, bitsL, List.flatMap_cons]; rfl
      have H := body2_runs (I := I) (iprog := iprog) (cf (T k) cCN cDN LC' LD') xs[k] w
        (hxs _ (List.getElem_mem hk)) (ints (bitsL w (xs.drop (k + 1))) ++ R) L2 LRW LCw LDw
        (by simp +decide only [T, cf, IState.upd_G, if_true, if_false]; rw [hb, ints_append,
          List.append_assoc])
        (by simp +decide [T, cf, h2]) (by simp +decide [T, cf, hRW]) (by simp +decide [T, cf, hCw])
        (by simp +decide [T, cf, hDw]) hLCw hLDw
      refine H.mono' ?_ le_rfl
      have ht : xs.take (k + 1) = xs.take k ++ [xs[k]] := by
        rw [List.take_add_one, List.getElem?_eq_getElem hk]; rfl
      have e : ints (xs.take (k + 1)).reverse = .int xs[k] :: ints (xs.take k).reverse := by
        rw [ht, List.reverse_append, ints_append]; rfl
      clear H hd hb
      simp only [T, cf, e]
      ((apply NLogN.IState.ext' <;> intros <;>
               simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
             split_ifs <;>
           simp_all +decide)))
  have e0 : cf (T 0) cCN cDN (marks xs.length ++ LCN) LDN = s := by
    simp only [T, cf, List.drop_zero, List.take_zero]
    rw [← h0, ← hCN, ← hDN]; simp
  have e1 : cf (T xs.length) cCN cDN (marks xs.length ++ LCN) LDN =
      (s.upd 0 R).upd cO (ints xs.reverse ++ s.G cO) := by
    rw [← hCN, ← hDN]; simp only [T, cf, List.drop_length, List.take_length]; simp [bitsL]; ((apply NLogN.IState.ext' <;> intros <;>
                                                                                                     simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                                                                                                   split_ifs <;>
                                                                                                 simp_all +decide))
  rw [e0, e1] at hu
  exact hu

theorem fromCore_runs (s : IState HS) (xs : List ℤ) (w : ℕ) (hxs : ∀ x ∈ xs, zsz x ≤ w)
    (R L2 LCw LDw LCN LDN : List Item)
    (h0 : s.G 0 = ints (bitsL w xs) ++ R) (h2 : s.G cR2 = .int 2 :: L2)
    (hCw : s.G cCw = marks w ++ LCw) (hDw : s.G cDw = LDw) (hLCw : NM LCw) (hLDw : NM LDw)
    (hCN : s.G cCN = marks xs.length ++ LCN) (hDN : s.G cDN = LDN) (hLCN : NM LCN)
    (hLDN : NM LDN) :
    IRuns I iprog fromCore s (s.upd 0 (ints xs ++ R))
      (cMkRW w + (xs.length * (cBody2 w + 64) + 60) + (xs.length * kap w + 60) + (2 * (w + 1) + 2))
      := by
  have h1 := mkRW_runs (I := I) (iprog := iprog) s w L2 LCw LDw h2 hCw hDw hLCw hLDw
  set s1 := s.upd cRW (.int (2 ^ w) :: s.G cRW)
  have h2' := fromLoop_runs (I := I) (iprog := iprog) s1 xs w hxs R L2 (s.G cRW) LCw LDw LCN LDN
    (by simp +decide [s1, h0]) (by simp +decide [s1, h2]) (by simp +decide [s1])
    (by simp +decide [s1, hCw]) (by simp +decide [s1, hDw]) hLCw hLDw
    (by simp +decide [s1, hCN]) (by simp +decide [s1, hDN]) hLCN hLDN
  set s2 := (s1.upd 0 R).upd cO (ints xs.reverse ++ s1.G cO)
  have h3 := mvB_runs (I := I) (iprog := iprog) (X := cO) (Y := 0) (C := cCN) (D := cDN)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s2 xs.reverse
    (s.G cO) LCN LDN w (by simp +decide [s2, s1]) (by simp +decide [s2, s1, hCN])
    (by simp +decide [s2, s1, hDN]) hLCN hLDN (fun x hx => hxs x (List.mem_reverse.1 hx))
  set s3 := (s2.upd cO (s.G cO)).upd 0 (ints xs.reverse.reverse ++ s2.G 0)
  have h4 := IRuns.drop (I := I) (iprog := iprog) (s := s3) (i := cRW) (a := 2 ^ w)
    (L := s.G cRW) (by simp +decide [s3, s2, s1])
  refine (h1.seq (h2'.seq (h3.seq h4))).mono' ?_ ?_
  · clear h1 h2' h3 h4
    simp only [s3, s2, s1, List.reverse_reverse]
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · have : zsz ((2 : ℤ) ^ w) = w + 1 := NLogN.zsz_two_pow w
    rw [this, List.length_reverse]; omega

end NLogN.KFL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFL
open IntMul KFC
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution (t : NLogN.IState NLogN.HS) (xs : List ℤ) (w : ℕ) (hxs : ∀ x ∈ xs, NLogN.zsz x ≤ w)
    (R : List NLogN.Item) (h0 : t.G 0 = NLogN.ints (NLogN.KFL.bitsL w xs) ++ R) :
    NLogN.IRuns I iprog (NLogN.KFL.fromBitsI xs.length w) t (t.upd 0 (NLogN.ints xs ++ R)) (NLogN.KFL.cFrom xs.length w) := by
  have c1 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := t) NLogN.KFL.cPN (xs.length : ℤ)
  set t1 := t.upd NLogN.KFL.cPN (.int (xs.length : ℤ) :: t.G NLogN.KFL.cPN)
  have c2 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := t1) NLogN.KFL.cPW (w : ℤ)
  set t2 := t1.upd NLogN.KFL.cPW (.int (w : ℤ) :: t1.G NLogN.KFL.cPW)
  have c3 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := t2) NLogN.KFL.cR2 2
  set t3 := t2.upd NLogN.KFL.cR2 (.int 2 :: t2.G NLogN.KFL.cR2)
  set u := (t3.upd NLogN.KFL.cCN (NLogN.KFC.marks xs.length ++ .int 0 :: t3.G NLogN.KFL.cCN)).upd NLogN.KFL.cDN (.int 0 :: t3.G NLogN.KFL.cDN)
  set v := (u.upd NLogN.KFL.cCw (NLogN.KFC.marks w ++ .int 0 :: u.G NLogN.KFL.cCw)).upd NLogN.KFL.cDw (.int 0 :: u.G NLogN.KFL.cDw)
  have hc := NLogN.KFL.fromCore_runs (I := I) (iprog := iprog) v xs w hxs R (t.G NLogN.KFL.cR2) (.int 0 :: t.G NLogN.KFL.cCw)
    (.int 0 :: t.G NLogN.KFL.cDw) (.int 0 :: t.G NLogN.KFL.cCN) (.int 0 :: t.G NLogN.KFL.cDN)
    (by simp +decide [v, u, t3, t2, t1, h0]) (by simp +decide [v, u, t3, t2, t1])
    (by simp +decide [v, u, t3, t2, t1]) (by simp +decide [v, u, t3, t2, t1]) (NLogN.KFC.NM_int _ _)
    (NLogN.KFC.NM_int _ _) (by simp +decide [v, u, t3, t2, t1]) (by simp +decide [v, u, t3, t2, t1])
    (NLogN.KFC.NM_int _ _) (NLogN.KFC.NM_int _ _)
  have wi := NLogN.KFC.wrap_runs (I := I) (iprog := iprog) (A := NLogN.KFL.cPW) (C := NLogN.KFL.cCw) (D := NLogN.KFL.cDw) (X := 0)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) u w (t1.G NLogN.KFL.cPW) _ (by simp +decide [u, t3, t2]) _ _ hc
  have wo := NLogN.KFC.wrap_runs (I := I) (iprog := iprog) (A := NLogN.KFL.cPN) (C := NLogN.KFL.cCN) (D := NLogN.KFL.cDN) (X := 0)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) t3 xs.length (t.G NLogN.KFL.cPN) _ (by simp +decide [t3, t2, t1]) _ _ wi
  set t4 := t3.upd 0 (NLogN.ints xs ++ R)
  have d1 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := t4) (i := NLogN.KFL.cR2) (a := 2) (L := t.G NLogN.KFL.cR2)
    (by simp +decide [t4, t3, t2, t1])
  have d2 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := t4.upd NLogN.KFL.cR2 (t.G NLogN.KFL.cR2)) (i := NLogN.KFL.cPW)
    (a := (w : ℤ)) (L := t.G NLogN.KFL.cPW) (by simp +decide [t4, t3, t2, t1])
  have d3 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := (t4.upd NLogN.KFL.cR2 (t.G NLogN.KFL.cR2)).upd NLogN.KFL.cPW (t.G NLogN.KFL.cPW))
    (i := NLogN.KFL.cPN) (a := (xs.length : ℤ)) (L := t.G NLogN.KFL.cPN) (by simp +decide [t4, t3, t2, t1])
  refine (c1.seq (c2.seq (c3.seq (wo.seq (d1.seq (d2.seq d3)))))).mono' ?_ ?_
  · clear c1 c2 c3 wo wi hc d1 d2 d3
    simp only [t4, t3, t2, t1]
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · have z2 : NLogN.zsz (2 : ℤ) = 2 := NLogN.zsz_two'
    rw [z2]; unfold NLogN.KFL.cFrom; omega
end
