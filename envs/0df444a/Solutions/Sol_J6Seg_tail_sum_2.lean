-- Source module: Solutions.J6SegGeom
/-!
# Segmented inverse (S2): exact structure of the resampling system (report L1, L2, L4, L8 tail)

Entries of `N = I + E` are `eEx s t α l h = e^{-πα² X/s²}`, `X = eKz s t l h`.
* `eKz_closed` (L1): `X = sn(sn + 2b_{l+h})` with `n = q_{l+h} - q_l`, and `|n| ≥ |h|`, so
  `eEx_le_cf`: `e_{l,h} ≤ e^{-πα²|h|(|h|-1)}` (cross-wrap / cut entries).
* `eEx_recentre` (L2/L4): inside a wrap-free run starting at `c`,
  `e_{c+u, v-u} = D_u T^{(b_c)}_{uv} D_v⁻¹` with `b_c = bOf c / s`, i.e. `MF` of `J6SegToep`.
* `tail_sum` (truncation): `Σ_{|h| > w} e_{l,h} ≤ 4 e^{-πα² w(w+1)}` for `α ≥ 2`.
* `bOf_periodic`, `eEx_periodic`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf

section geom
variable (s t α : ℕ)

/-- **Closed-form envelope.** `e_{l,h} ≤ e^{-πα²|h|(|h|-1)}`. -/
theorem eEx_le_cf (hs : 0 < s) (hst : s ≤ t) (l h : ℤ) :
    eEx s t α l h ≤ exp (-(π * (α : ℝ) ^ 2 * (|(h : ℝ)| * (|(h : ℝ)| - 1)))) := by
  unfold eEx
  split_ifs with h0
  · exact (exp_pos _).le
  · apply exp_le_exp.2
    have hK := eKz_ge s t hs hst l h
    have hKR : ((s : ℝ)) ^ 2 * (|(h : ℝ)| * (|(h : ℝ)| - 1)) ≤ (eKz s t l h : ℝ) := by
      have := (Int.cast_le (R := ℝ)).2 hK
      push_cast at this; exact this
    have hsR : (0 : ℝ) < (s : ℝ) ^ 2 := by positivity
    have : |(h : ℝ)| * (|(h : ℝ)| - 1) ≤ (eKz s t l h : ℝ) / (s : ℝ) ^ 2 := by
      rw [le_div_iff₀ hsR]; linarith
    have hpa : 0 ≤ π * (α : ℝ) ^ 2 := by positivity
    have := mul_le_mul_of_nonneg_left this hpa
    rw [neg_le_neg_iff]
    calc π * (α : ℝ) ^ 2 * (|(h : ℝ)| * (|(h : ℝ)| - 1)) ≤
        π * (α : ℝ) ^ 2 * ((eKz s t l h : ℝ) / (s : ℝ) ^ 2) := this
      _ = π * (α : ℝ) ^ 2 * (eKz s t l h : ℝ) / (s : ℝ) ^ 2 := by ring

/-! ### Truncation tail -/

lemma tail_point (hs : 0 < s) (hst : s ≤ t) (l h : ℤ) (w : ℕ) (hw : (w : ℤ) < |h|) :
    eEx s t α l h ≤ exp (-(π * (α : ℝ) ^ 2 * (w * (w + 1)))) *
      exp (-(π * (α : ℝ) ^ 2)) ^ (h.natAbs - (w + 1)) := by
  refine (eEx_le_cf s t α hs hst l h).trans ?_
  rw [← Real.exp_nat_mul, ← exp_add]
  apply exp_le_exp.2
  have hk : (h.natAbs : ℝ) = |(h : ℝ)| := by rw [Nat.cast_natAbs, Int.cast_abs]
  have hwk : w + 1 ≤ h.natAbs := by
    have : (w : ℤ) + 1 ≤ |h| := hw
    rw [Int.abs_eq_natAbs] at this; omega
  have hsub : ((h.natAbs - (w + 1) : ℕ) : ℝ) = |(h : ℝ)| - w - 1 := by
    rw [Nat.cast_sub hwk, hk]; push_cast; ring
  rw [hsub]
  have hwR : (w : ℝ) + 1 ≤ |(h : ℝ)| := by rw [← hk]; exact_mod_cast hwk
  have hpa : 0 ≤ π * (α : ℝ) ^ 2 := by positivity
  have hq : (w : ℝ) * (w + 1) + (|(h : ℝ)| - w - 1) ≤ |(h : ℝ)| * (|(h : ℝ)| - 1) := by
    have hw0 : (0 : ℝ) ≤ w := Nat.cast_nonneg w
    nlinarith
  nlinarith

/-- **Truncation tail.** `Σ_{|h| > w} e_{l,h} ≤ 4 e^{-πα²w(w+1)}` for `α ≥ 2`. -/
theorem tail_sum_sol_aux (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (l : ℤ) (w : ℕ) :
    Summable (fun h : ℤ => if (w : ℤ) < |h| then eEx s t α l h else 0) ∧
    ∑' h : ℤ, (if (w : ℤ) < |h| then eEx s t α l h else 0) ≤
      4 * exp (-(π * (α : ℝ) ^ 2 * (w * (w + 1)))) := by
  set E := exp (-(π * (α : ℝ) ^ 2 * (w * (w + 1))))
  set ρ := exp (-(π * (α : ℝ) ^ 2))
  have hρ0 : 0 ≤ ρ := (exp_pos _).le
  have hρ : ρ ≤ 1 / 2 := by
    have hαR : (2 : ℝ) ≤ α := by exact_mod_cast hα
    have h1 : exp (-(π * (α : ℝ) ^ 2)) ≤ exp (-1) := exp_le_exp.2 (by
      have := pi_gt_three; nlinarith)
    have h2 : exp (-1 : ℝ) ≤ 1 / 2 := by
      rw [exp_neg, inv_eq_one_div, div_le_div_iff₀ (exp_pos _) (by norm_num)]
      have := Real.add_one_le_exp (1 : ℝ); linarith
    linarith
  have hE0 : 0 ≤ E := (exp_pos _).le
  -- the majorant
  set m : ℤ → ℝ := fun h => if (w : ℤ) < |h| then E * ρ ^ (h.natAbs - (w + 1)) else 0
  set g : ℕ → ℝ := fun n => if w < n then E * ρ ^ (n - (w + 1)) else 0
  have hg : HasSum g (E / (1 - ρ)) := by
    have hgeo : HasSum (fun n : ℕ => g (n + (w + 1))) (E / (1 - ρ)) := by
      have : (fun n : ℕ => g (n + (w + 1))) = fun n => E * ρ ^ n := by
        funext n; simp only [g]; rw [if_pos (by omega)]; congr 2; omega
      rw [this, div_eq_mul_inv]
      exact (hasSum_geometric_of_lt_one hρ0 (by linarith)).mul_left E
    rw [hasSum_nat_add_iff] at hgeo
    have hz : ∑ i ∈ range (w + 1), g i = 0 :=
      sum_eq_zero fun i hi => by simp only [g]; rw [if_neg (by simp at hi; omega)]
    rwa [hz, add_zero] at hgeo
  have hm : HasSum m (E / (1 - ρ) + E / (1 - ρ)) := by
    refine HasSum.of_nat_of_neg_add_one ?_ ?_
    · have : (fun n : ℕ => m n) = g := by
        funext n; simp only [m, g, Int.natAbs_natCast]
        congr 1; simp only [Nat.abs_cast, Nat.cast_lt]
      rw [this]; exact hg
    · have : (fun n : ℕ => m (-(n + 1 : ℤ))) = fun n => g (n + 1) := by
        funext n; simp only [m, g]
        have e1 : |(-((n : ℤ) + 1))| = (n : ℤ) + 1 := by rw [abs_neg]; exact abs_of_pos (by omega)
        have e2 : (-((n : ℤ) + 1)).natAbs = n + 1 := by omega
        rw [e1, e2]; congr 1; simp only [eq_iff_iff]; omega
      rw [this]
      have := (hasSum_nat_add_iff (f := g) 1).2 (by simpa [g] using hg)
      simpa [g] using this
  have hle : ∀ h : ℤ, (if (w : ℤ) < |h| then eEx s t α l h else 0) ≤ m h := by
    intro h; simp only [m]; split_ifs with hw
    · exact tail_point s t α hs hst l h w hw
    · exact le_rfl
  have hnn : ∀ h : ℤ, 0 ≤ (if (w : ℤ) < |h| then eEx s t α l h else 0) := by
    intro h; split_ifs
    · exact eEx_nonneg s t α l h
    · exact le_rfl
  have hsum : Summable (fun h : ℤ => if (w : ℤ) < |h| then eEx s t α l h else 0) :=
    Summable.of_nonneg_of_le hnn hle hm.summable
  refine ⟨hsum, (hsum.tsum_le_tsum hle hm.summable).trans ?_⟩
  rw [hm.tsum_eq]
  have h1 : E / (1 - ρ) ≤ 2 * E := by
    rw [div_le_iff₀ (by linarith)]; nlinarith
  linarith

end geom

end J6Seg

end

theorem solution : type_of% @J6Seg.tail_sum_sol_aux := @J6Seg.tail_sum_sol_aux
