        Nat.card ↥((fun x : ModularCurve.JOne N => γ • x - x) '' (AlgebraicCurve.Pic0.torsion (AlgebraicClosure ℚ) ↥(ModularCurve.x1FunctionFieldBar N) (ℓ ^ k') : Set (ModularCurve.JOne N))) *
          Nat.card ↥{x : ModularCurve.JOne N | x ∈ AlgebraicCurve.Pic0.torsion (AlgebraicClosure ℚ) ↥(ModularCurve.x1FunctionFieldBar N) (ℓ ^ k') ∧ ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, I₁ σ → I₂ σ → σ • x = x})
    (hFIX : ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, I₁ σ → I₂ σ → ∀ m : ℕ, 0 < m → ¬ p ∣ m → ∀ x : ModularCurve.JOne N, m • x = 0 → FIN x → σ • x = x)
