  have zv : zsz (v : ℤ) ≤ Bb := zsz_nat_lt (by omega)
  -- step 1
  have t0q : (encK s G).top NLogN.KFL.rP = N := top_encK hGq
  have i0q : (encK s G).IsInt rP := isInt_encK hGq
  obtain ⟨ev1, ok1, bd1⟩ := uE_spec d0 Q ρ (encK s G) N t0q i0q hN hd0 hQ hBb1 zN zd0 zQ zr
  have S1 := Sp.pushQ s G (i := NLogN.KFL.rU) (by decide) (uE_clean d0 Q ρ) ok1 bd1
  rw [ev1] at S1
  set G1 := Function.update G NLogN.KFL.rU ((u : ℤ) :: G NLogN.KFL.rU)
  have g1q : G1 NLogN.KFL.rP = (N : ℤ) :: LP := by simp only [G1]; rw [upd_ne (by decide)]; exact hGq
  obtain ⟨ev2, ok2, bd2⟩ := uE_spec d1 Q ρ (encK s G1) N (top_encK g1q) (isInt_encK g1q) hN hd1
    hQ hBb1 zN zd1 zQ zr
  have S2 := Sp.pushQ s G1 (i := NLogN.KFL.rV) (by decide) (uE_clean d1 Q ρ) ok2 bd2
  rw [ev2] at S2
  set G2 := Function.update G1 NLogN.KFL.rV ((v : ℤ) :: G1 NLogN.KFL.rV)
  have S3 := Sp.pushQ s G2 (i := NLogN.KFL.rW) (e := .lit (2 ^ ρ)) (by decide) (clean_lit _) trivial zr
  simp only [Ex.eval] at S3
  set G3 := Function.update G2 NLogN.KFL.rW ((2 : ℤ) ^ ρ :: G2 NLogN.KFL.rW)
  have S4 := Sp.pushQ s G3 (i := rA) (e := .lit 0) (B := Bb) (by decide) (clean_lit _) trivial
    (by simp only [Ex.Bnd, zsz_zero]; omega)
  simp only [Ex.eval] at S4
  set G4 := Function.update G3 rA ((0 : ℤ) :: G3 rA)
  -- the segment loop
  have g4A : G4 rA = 0 :: G rA := by
    simp only [G4]; rw [Function.update_self]; simp only [G3, G2, G1]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]
  have g4W : G4 NLogN.KFL.rW = 2 ^ ρ :: G rW := by
    simp only [G4]; rw [upd_ne (by decide)]; simp only [G3]; rw [Function.update_self]
    simp only [G2, G1]; rw [upd_ne (by decide), upd_ne (by decide)]
  have g4V : G4 NLogN.KFL.rV = (v : ℤ) :: G rV := by
    simp only [G4]; rw [upd_ne (by decide)]; simp only [G3]; rw [upd_ne (by decide)]
    simp only [G2]; rw [Function.update_self]; simp only [G1]; rw [upd_ne (by decide)]
  have g4U : G4 NLogN.KFL.rU = (u : ℤ) :: G rU := by
    simp only [G4]; rw [upd_ne (by decide)]; simp only [G3]; rw [upd_ne (by decide)]
    simp only [G2]; rw [upd_ne (by decide)]; simp only [G1]; rw [Function.update_self]
  have g4o : ∀ j, j ≠ rA → j ≠ NLogN.KFL.rU → j ≠ NLogN.KFL.rV → j ≠ NLogN.KFL.rW → G4 j = G j := by
    intro j h1 h2 h3 h4
    simp only [G4, G3, G2, G1]; rw [upd_ne h1, upd_ne h4, upd_ne h3, upd_ne h2]
  have g4c : G4 rC = [] := by rw [g4o rC (by decide) (by decide) (by decide) (by decide)]; exact hGc
  have hn : (f - 1) * K + ρ ≤ f * K := by
    have : (f - 1) * K + K = f * K := by
      have : f = (f - 1) + 1 := by omega
      conv_rhs => rw [this]
      ring
    omega
  have hbig' : |(0 : ℤ)| + 2 * 2 ^ ρ * 2 ^ ((f - 1) * K) < 2 ^ Bb := by
    have e : (2 : ℤ) ^ ρ * 2 ^ ((f - 1) * K) ≤ M := by
      rw [← pow_add, hMdef]; push_cast
      exact pow_le_pow_right₀ (by norm_num) (by omega)
    have : (4 * M : ℤ) < 2 ^ Bb := by exact_mod_cast hbig
    simp only [abs_zero]; nlinarith
  have zK : zsz ((2 : ℤ) ^ K) ≤ Bb := by
    have h1 : 2 ^ K ≤ M := Nat.pow_le_pow_right (by norm_num) (by nlinarith)
    have := zsz_nat_lt (a := 2 ^ K) (Bb := Bb) (by omega); simpa using this
  have zf : zsz ((f - 1 : ℕ) : ℤ) ≤ Bb := zsz_nat_lt (by
    have h1 : f - 1 < 2 ^ (f - 1) := Nat.lt_two_pow_self
    have h2 : 2 ^ (f - 1) ≤ M := Nat.pow_le_pow_right (by norm_num) (by nlinarith)
    omega)
  have SL := segLoop_fsp hK (segT_offE l.b hB2) s G4 g4c 0 u v (2 ^ ρ) (by positivity)
    (by positivity) (by positivity) (f - 1) zu zv zK zf hbig'
  have e0 : segF G4 K (tfB l.b) 0 u v (2 ^ ρ) 0 = G4 :=
    segF_zero _ _ _ _ _ _ _ (by simp [g4A]) (by simp [g4U]) (by simp [g4V]) (by simp [g4W])
      (by simp [g4A]) (by simp [g4U]) (by simp [g4V]) (by simp [g4W])
  rw [e0] at SL
  set G5 := segF G4 K (tfB l.b) 0 u v (2 ^ ρ) (f - 1)
  set o := Butterfly.offset K ρ f (x : ℤ) (y : ℤ) l.b with ho_def
  have hu' : ((u : ℕ) : ℤ) = (x : ℤ) / 2 ^ ρ := by simp [u]
  have hv' : ((v : ℕ) : ℤ) = (y : ℤ) / 2 ^ ρ := by simp [v]
  have ho : 0 + segAcc K (tfB l.b) u v (2 ^ ρ) (f - 1) = o := by
    rw [ho_def, offset_seg K ρ f x y l.b hb, hu', hv', zero_add]
  have g5A : G5 rA = o :: G rA := by
    simp only [G5]; rw [segF_rA, ho, g4A]; rfl
  obtain ⟨ho0, hoM⟩ := offset_bounds (K := K) (ρ := ρ) (f := f) hK hρK hf (x : ℤ) (y : ℤ) l.b
  obtain ⟨ev6, ok6, bd6⟩ := amtE_spec l.sgn hs M hM0 (encK s G5) o (top_encK g5A)
    (isInt_encK g5A) ho0 (by exact_mod_cast hoM) hBb1 (by exact_mod_cast zM2)
  have S6 := Sp.pushQ s G5 (i := 14) (by decide) (clean_all _ (by
    intro i hi; simp [amtE, Ex.regs] at hi; subst hi; decide)) ok6 bd6
  rw [ev6] at S6
  set G6 := Function.update G5 14 ((l.sgn * o) % (M : ℤ) :: G5 14)
  -- pops
  have g6A : G6 rA = o :: G rA := by simp only [G6]; rw [upd_ne (by decide)]; exact g5A
  have S7 := Sp.pop s G6 (B := Bb) (by decide) g6A (zsz_le_of_abs (by
    rw [abs_of_nonneg ho0]; have : (M : ℤ) < 2 ^ Bb := by exact_mod_cast (by omega : M < 2 ^ Bb)
    linarith))
  set G7 := Function.update G6 rA (G rA)
  have g7W : G7 NLogN.KFL.rW = 2 ^ ρ * 2 ^ ((f - 1) * K) :: G rW := by
    simp only [G7, G6]
    rw [upd_ne (by decide), upd_ne (by decide)]; simp only [G5]; rw [segF_rW, g4W]; rfl
  have S8 := Sp.pop s G7 (B := Bb) (by decide) g7W (by
    have e : (2 : ℤ) ^ ρ * 2 ^ ((f - 1) * K) = ((2 ^ (ρ + (f - 1) * K) : ℕ) : ℤ) := by
      push_cast; rw [pow_add]
    rw [e]; apply zsz_nat_lt
    have : 2 ^ (ρ + (f - 1) * K) ≤ M := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega)
  set G8 := Function.update G7 NLogN.KFL.rW (G NLogN.KFL.rW)
  have g8V : G8 NLogN.KFL.rV = (v : ℤ) / 2 ^ ((f - 1) * K) :: G rV := by
    simp only [G8, G7, G6]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]; simp only [G5]
    rw [segF_rV, g4V]; rfl
  have S9 := Sp.pop s G8 (B := Bb) (by decide) g8V
    (le_trans (zsz_ediv_le (by positivity) (by positivity)) zv)
  set G9 := Function.update G8 NLogN.KFL.rV (G NLogN.KFL.rV)
  have g9U : G9 NLogN.KFL.rU = (u : ℤ) / 2 ^ ((f - 1) * K) :: G rU := by
    simp only [G9, G8, G7, G6]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]
    simp only [G5]; rw [segF_rU, g4U]; rfl
  have S10 := Sp.pop s G9 (B := Bb) (by decide) g9U
    (le_trans (zsz_ediv_le (by positivity) (by positivity)) zu)
  set G10 := Function.update G9 NLogN.KFL.rU (G NLogN.KFL.rU)
  have hG10 : G10 = Function.update G 14 ((l.sgn * o) % (M : ℤ) :: G 14) := by
    funext j
    simp only [G10]
    by_cases h1 : j = NLogN.KFL.rU
    · subst h1; rw [Function.update_self, upd_ne (by decide)]
    rw [upd_ne h1]; simp only [G9]
    by_cases h2 : j = NLogN.KFL.rV
    · subst h2; rw [Function.update_self, upd_ne (by decide)]
    rw [upd_ne h2]; simp only [G8]
    by_cases h3 : j = NLogN.KFL.rW
    · subst h3; rw [Function.update_self, upd_ne (by decide)]
    rw [upd_ne h3]; simp only [G7]
    by_cases h4 : j = rA
    · subst h4; rw [Function.update_self, upd_ne (by decide)]
    rw [upd_ne h4]
    simp only [G6]
    by_cases h5 : j = 14
    · subst h5; rw [Function.update_self, Function.update_self]; simp only [G5]
      rw [segF_ne _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide),
        g4o 14 (by decide) (by decide) (by decide) (by decide)]
    rw [upd_ne h5, upd_ne h5]; simp only [G5]
    rw [segF_ne _ _ _ _ _ _ _ _ h4 h1 h2 h3, g4o j h4 h1 h2 h3]
  have g10P : G10 NLogN.KFL.rP = (N : ℤ) :: LP := by rw [hG10, upd_ne (by decide)]; exact hGq
  have S11 := Sp.asgQ s G10 (i := NLogN.KFL.rP) (e := .add (.reg NLogN.KFL.rP) (.lit (-1))) (B := Bb) (by decide) g10P zN
    (clean_all _ (by intro i hi; simp [Ex.regs] at hi; subst hi; decide))
    ⟨ok_reg g10P, trivial⟩
    ⟨bnd_reg g10P zN, by rw [Ex.Bnd, zsz_neg, zsz_one]; exact hBb1, by
      simp only [Ex.eval]; rw [top_encK g10P]
      exact zsz_le_of_abs (by
        rw [abs_of_nonneg (by omega)]
        have := (zsz_le_iff (z := (N : ℤ)) (m := Bb)).1 zN
        simp only [Int.natAbs_natCast] at this
        have : (N : ℤ) < 2 ^ Bb := by exact_mod_cast this
        omega)⟩
  have ev11 : (Ex.add (.reg NLogN.KFL.rP) (.lit (-1)) : Ex HS).eval (encK s G10) = (N : ℤ) - 1 := by
    simp only [Ex.eval]; rw [top_encK g10P]; ring
  rw [ev11] at S11
  have H := (FSp.of_norep rfl S1).seq ((FSp.of_norep rfl S2).seq ((FSp.of_norep rfl S3).seq
    ((FSp.of_norep rfl S4).seq (SL.seq ((FSp.of_norep rfl S6).seq ((FSp.of_norep rfl S7).seq
    ((FSp.of_norep rfl S8).seq ((FSp.of_norep rfl S9).seq ((FSp.of_norep rfl S10).seq
    (FSp.of_norep rfl S11))))))))))
  have hamt : ((amt K ρ f l x y : ℕ) : ℤ) = (l.sgn * o) % (M : ℤ) := by
    simp only [amt]
    rw [Int.toNat_of_nonneg (Int.emod_nonneg _ (by positivity))]
    push_cast; rfl
  refine (H.congr ?_).mono ?_
  · rw [hG10, hamt]
  · simp only [NLogN.KFL.cTab, uE, amtE, Ex.size]
    have : 0 ≤ (Bb + 2) ^ 2 := Nat.zero_le _
    have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
    generalize (Bb + 2) ^ 2 = X at *
    generalize cLp (f - 1) (cSegIt (offE l.b) Bb) Bb = Y
    omega

theorem tabL_succ (as : ℕ → ℕ) (P k : ℕ) (hk : k < P) :
    NLogN.KFL.tabL as P (k + 1) = (as (P - k - 1) : ℤ) :: NLogN.KFL.tabL as P k := by
  simp only [NLogN.KFL.tabL, List.range_succ_eq_map, List.map_cons, List.map_map]
  refine congrArg₂ _ (by first | rfl | (congr 2; omega) | congr 2) (List.map_congr_left fun i hi => ?_)
  simp only [Function.comp_apply]; congr 2; omega

theorem tabL_full (as : ℕ → ℕ) (P : ℕ) : NLogN.KFL.tabL as P P = (List.range P).map fun p => (as p : ℤ) := by
  simp [NLogN.KFL.tabL]
end NLogN.KFL
end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD Butterfly
theorem solution {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {d0 d1 Q : ℕ}
    (hd0 : 0 < d0) (hd1 : 0 < d1) (hQ : 0 < Q) (l : Butterfly.Line) (hs : l.sgn = 1 ∨ l.sgn = -1)
    (hb : l.b = 0 ∨ l.b = 1) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb)
    (zd0 : NLogN.zsz (d0 : ℤ) ≤ Bb) (zd1 : NLogN.zsz (d1 : ℤ) ≤ Bb) (hQM : Q ≤ 2 ^ (f * K))
    (P : ℕ) (zP : NLogN.zsz (P : ℤ) ≤ Bb)
    (s : NLogN.IState NLogN.HS) (F : Fin NLogN.HS → List ℤ) (hq : F NLogN.KFL.rq = []) (hc : F NLogN.KFL.rC = []) :
    NLogN.KFD.FSp (NLogN.KFL.tabGen K ρ f d0 d1 Q P l.sgn l.b) (NLogN.KIL.encK s F)
      (NLogN.KIL.encK s (Function.update F 14
        ((List.range P).map (fun p => (NLogN.KFL.tabA K ρ f d0 d1 Q l p : ℤ)) ++ F 14)))
      (NLogN.KFL.cTabGen K f l.b P Bb) := by
  set as := NLogN.KFL.tabA K ρ f d0 d1 Q l
  have nq : NLogN.KFL.rP ≠ rq := by decide
  have n14 : (14 : Fin NLogN.HS) ≠ rq := by decide
  have n14P : (14 : Fin NLogN.HS) ≠ rP := by decide
  have S0 := NLogN.KIL.Sp.pushQ s F (i := NLogN.KFL.rP) (e := .lit (P : ℤ)) (B := Bb) (by decide) (NLogN.KIL.clean_lit _) trivial zP
  simp only [NLogN.Ex.eval] at S0
  set F0 := Function.update F NLogN.KFL.rP ((P : ℤ) :: F NLogN.KFL.rP)
  set Fk : ℕ → Fin NLogN.HS → List ℤ := fun k =>
    Function.update (Function.update F0 14 (NLogN.KFL.tabL as P k ++ F 14)) NLogN.KFL.rP (((P - k : ℕ) : ℤ) :: F NLogN.KFL.rP)
  have H := NLogN.KFD.FSp.repLit (C := NLogN.KFL.rq) (b := NLogN.KFL.tabBody K ρ f d0 d1 Q l.sgn l.b) (s := s)
    (F := Fk) (N := P) (c := NLogN.KFL.cTab K f l.b Bb) (Bb := Bb) (by decide)
    (fun k => by simp only [Fk, F0]; rw [NLogN.KFL.upd_ne nq.symm, NLogN.KFL.upd_ne n14.symm, NLogN.KFL.upd_ne nq.symm]; exact hq)
    (by unfold NLogN.KFL.tabBody NLogN.KFL.offE; split_ifs <;> simp +decide [NLogN.KFL.segLoop, NLogN.KFL.segBody, NLogN.RS.writes]) zP
    (fun k hk => ?_)
  · have e0 : Fk 0 = F0 := by
      funext j
      simp only [Fk, F0, NLogN.KFL.tabL, List.range_zero, List.map_nil, List.nil_append, Nat.sub_zero]
      by_cases h : j = NLogN.KFL.rP
      · subst h; rw [Function.update_self, Function.update_self]
      rw [NLogN.KFL.upd_ne h, NLogN.KFL.upd_ne h]
      by_cases h' : j = 14
      · subst h'; rw [Function.update_self]
      rw [NLogN.KFL.upd_ne h', NLogN.KFL.upd_ne h]
    rw [e0] at H
    have fP : Fk P NLogN.KFL.rP = 0 :: F rP := by simp only [Fk]; rw [Function.update_self]; simp
    have S2 := NLogN.KIL.Sp.pop s (Fk P) (B := Bb) (by decide) fP (by rw [NLogN.zsz_zero]; omega)
    have T := (NLogN.KFD.FSp.of_norep rfl S0).seq (H.seq (NLogN.KFD.FSp.of_norep rfl S2))
    refine (T.congr ?_).mono ?_
    · congr 1
      funext j
      simp only [Fk, F0]
      by_cases h : j = NLogN.KFL.rP
      · subst h; rw [Function.update_self, NLogN.KFL.upd_ne n14P.symm]
      rw [NLogN.KFL.upd_ne h, NLogN.KFL.upd_ne h]
      by_cases h' : j = 14
      · subst h'; rw [Function.update_self, Function.update_self, NLogN.KFL.tabL_full]
      rw [NLogN.KFL.upd_ne h', NLogN.KFL.upd_ne h', NLogN.KFL.upd_ne h]
    · simp only [NLogN.KFL.cTabGen, NLogN.Ex.size]
      have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
      omega
  · have hN : ((P : ℤ) - k) = ((P - k : ℕ) : ℤ) := by omega
    rw [hN]
    have T := NLogN.KFL.tabBody_fsp hK hρK hf hd0 hd1 hQ l hs hb hB2 hbig zd0 zd1 hQM s
      (Function.update (Fk k) NLogN.KFL.rq [((P - k : ℕ) : ℤ)])
      (P - k) (by omega) (le_trans (NLogN.KIL.zsz_nat_le (Nat.sub_le _ _)) zP)
      (LP := F NLogN.KFL.rP) (by rw [NLogN.KFL.upd_ne nq]; simp only [Fk]; rw [Function.update_self])
      (by rw [NLogN.KFL.upd_ne (by decide)]; simp only [Fk, F0]
          rw [NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide)]; exact hc)
    refine T.congr ?_
    congr 1
    funext j
    simp only [Fk]
    by_cases hr : j = NLogN.KFL.rq
    · subst hr; simp +decide [Function.update_apply]
    by_cases h : j = NLogN.KFL.rP
    · subst h
      simp +decide only [Function.update_apply, if_true]
      congr 1; push_cast [Nat.cast_sub hk.le, Nat.cast_sub (Nat.succ_le_of_lt hk)]; ring
    by_cases h' : j = 14
    · subst h'
      simp +decide only [Function.update_apply, if_true, if_false]
      rw [NLogN.KFL.tabL_succ as P k hk]
      have e : P - k - 1 = P - (k + 1) + 0 := by omega
      simp only [as, NLogN.KFL.tabA, List.cons_append]
    simp only [Function.update_apply, hr, h, h', if_false]
end
