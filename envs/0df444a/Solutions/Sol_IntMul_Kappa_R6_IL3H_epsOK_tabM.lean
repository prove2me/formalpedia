-- Source module: Solutions.KFWEps
/-!
# KFW: the exponent expressions of the uniform phase passes

The uniform phase pass `phLU … εE` reads, in iteration `k` (index on `kS`), the exponent
`εE = aE k mod 4`.  For the stride-`K` layouts of the level procedure,
`pos i = e - K φ(i)` with `φ : ι ≃ Fin N`, so

  `aEof pos a' p = if p ≤ e ∧ K ∣ e - p ∧ (e - p)/K < N then a' (φ⁻¹ ((e-p)/K)) else 0`

(`aEof_equiv`), which the expression `εAff eR KR NR G` computes from the run-time registers
`eR = e`, `KR = K`, `NR = N` (`εAff_spec`), with `G` the exponent of a given index:

* `εLit c` (`G = c`): `S_D` (`c = 1`), `ZD` (`c = 2`), `fixG` (any, `a' = 0` uses `lit 0`);
* `εTab fR a` (`G q = a (q / f) mod 4` through a lookup list, `f` on `fR`): the node phases
  `a' (a, c) = a_a` on `Fin mC × Fin (mC^k)` (`φ = finProdFinEquiv`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFN

/-! ## The lookup expression -/

theorem lookL_regs : ∀ (l : List ℕ) (i0 : ℕ) (x : Ex HS), ∀ j ∈ (lookL l i0 x).regs, j ∈ x.regs
  | [], _, _, j, hj => by simp [lookL, Ex.regs] at hj
  | v :: l, i0, x, j, hj => by
    have := lookL_regs l (i0 + 1) x j
    simp only [lookL, Ex.regs, List.mem_append, List.not_mem_nil, or_false, List.append_nil] at hj
    tauto

theorem lookL_mem : ∀ (l : List ℕ) (i0 : ℕ) (x : Ex HS), l ≠ [] → ∀ j ∈ x.regs,
    j ∈ (lookL l i0 x).regs
  | [], _, _, h, _, _ => absurd rfl h
  | v :: l, i0, x, _, j, hj => by
    simp only [lookL, Ex.regs, List.mem_append, List.append_nil]
    tauto

/-- `sel` with a negative test. -/
theorem selP {c x y : Ex HS} {s : IState HS} {B : ℕ} (h : c.eval s < 0) :
    (Ex.sel c x y).eval s = x.eval s ∧ ((Ex.sel c x y).ok s ↔ c.ok s ∧ x.ok s) ∧
    ((Ex.sel c x y).Bnd s B ↔ c.Bnd s B ∧ x.Bnd s B) := by
  refine ⟨if_pos h, ?_, ?_⟩
  · show (_ ∧ ite _ _ _) ↔ _
    rw [if_pos h]
  · show (_ ∧ ite _ _ _) ↔ _
    rw [if_pos h]

/-- `sel` with a nonnegative test. -/
theorem selN {c x y : Ex HS} {s : IState HS} {B : ℕ} (h : ¬ c.eval s < 0) :
    (Ex.sel c x y).eval s = y.eval s ∧ ((Ex.sel c x y).ok s ↔ c.ok s ∧ y.ok s) ∧
    ((Ex.sel c x y).Bnd s B ↔ c.Bnd s B ∧ y.Bnd s B) := by
  refine ⟨if_neg h, ?_, ?_⟩
  · show (_ ∧ ite _ _ _) ↔ _
    rw [if_neg h]
  · show (_ ∧ ite _ _ _) ↔ _
    rw [if_neg h]

theorem lookL_spec (s : IState HS) (x : Ex HS) (q B : ℕ) (hx : x.ok s) (hq : x.eval s = q)
    (hB : x.Bnd s B) (hqB : zsz ((q + 1 : ℕ) : ℤ) ≤ B) (h3 : zsz (3 : ℤ) ≤ B) :
    ∀ (l : List ℕ) (i0 : ℕ), i0 ≤ q → (lookL l i0 x).ok s ∧
      (lookL l i0 x).eval s = ((l.getD (q - i0) 0 % 4 : ℕ) : ℤ) ∧ (lookL l i0 x).Bnd s B
  | [], i0, _ => ⟨by simp [lookL, Ex.ok], by simp [lookL, Ex.eval], by simp [lookL, Ex.Bnd, zsz_zero]⟩
  | v :: l, i0, hi => by
    have IH := lookL_spec s x q B hx hq hB hqB h3 l (i0 + 1)
    have hc : (Ex.add x (.lit (-((i0 : ℤ) + 1)))).eval s = (q : ℤ) - i0 - 1 := by
      simp only [Ex.eval, hq]; ring
    have hcO : (Ex.add x (.lit (-((i0 : ℤ) + 1)))).ok s := ⟨hx, trivial⟩
    have hcB : (Ex.add x (.lit (-((i0 : ℤ) + 1)))).Bnd s B := by
      refine ⟨hB, ?_, ?_⟩
      · simp only [Ex.Bnd]
        rw [zsz_neg]
        exact le_trans (zsz_mono (by push_cast; omega)) hqB
      · rw [show x.eval s + (Ex.lit (-((i0 : ℤ) + 1))).eval s = (q : ℤ) - i0 - 1 by
          simp only [Ex.eval, hq]; ring]
        exact le_trans (zsz_mono (by push_cast; omega)) hqB
    have h4 : zsz (((v % 4 : ℕ) : ℤ)) ≤ B :=
      le_trans (zsz_mono (by have := Nat.mod_lt v (by norm_num : 0 < 4); push_cast; omega)) h3
    simp only [lookL]
    by_cases hqi : q = i0
    · subst hqi
      have hlt : (Ex.add x (.lit (-((q : ℤ) + 1)))).eval s < 0 := by rw [hc]; omega
      obtain ⟨e1, o1, b1⟩ := selP (x := Ex.lit ((v % 4 : ℕ) : ℤ)) (y := lookL l (q + 1) x)
        (B := B) hlt
      refine ⟨o1.2 ⟨hcO, trivial⟩, ?_, b1.2 ⟨hcB, h4⟩⟩
      rw [e1]; simp [Ex.eval]
    · have hlt : ¬ (Ex.add x (.lit (-((i0 : ℤ) + 1)))).eval s < 0 := by rw [hc]; omega
      obtain ⟨o2, e2, b2⟩ := IH (by omega)
      obtain ⟨e1, o1, b1⟩ := selN (x := Ex.lit ((v % 4 : ℕ) : ℤ)) (y := lookL l (i0 + 1) x)
        (B := B) hlt
      refine ⟨o1.2 ⟨hcO, o2⟩, ?_, b1.2 ⟨hcB, b2⟩⟩
      rw [e1, e2, show q - i0 = (q - (i0 + 1)) + 1 by omega, List.getD_cons_succ]

/-! ## The affine positions -/

theorem aEof_equiv {ι : Type*} [Fintype ι] (K e N : ℕ) (hK : 0 < K) (φ : ι ≃ Fin N)
    (hN : K * (N - 1) ≤ e) (a' : ι → ℕ) (p : ℕ) :
    aEof (fun i => e - K * (φ i).val) a' p =
      if h : p ≤ e ∧ (e - p) % K = 0 ∧ (e - p) / K < N then a' (φ.symm ⟨(e - p) / K, h.2.2⟩)
      else 0 := by
  have hle : ∀ i, K * (φ i).val ≤ e := fun i => by
    have := (φ i).isLt
    exact le_trans (Nat.mul_le_mul_left _ (by omega)) hN
  unfold aEof
  rw [Finset.sum_filter]
  split_ifs with h
  · obtain ⟨h1, h2, h3⟩ := h
    have hq : K * ((e - p) / K) = e - p := Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero h2)
    rw [Finset.sum_eq_single (φ.symm ⟨(e - p) / K, h3⟩)]
    · rw [if_pos]; simp only [Equiv.apply_symm_apply, Fin.val_mk]; omega
    · intro i _ hi
      rw [if_neg]
      intro hp
      dsimp only at hp
      apply hi
      rw [Equiv.eq_symm_apply]
      apply Fin.ext
      simp only
      have := hle i
      have h5 : K * (φ i).val = K * ((e - p) / K) := by omega
      exact Nat.eq_of_mul_eq_mul_left hK h5
    · intro h; exact absurd (Finset.mem_univ _) h
  · refine Finset.sum_eq_zero (fun i _ => ?_)
    rw [if_neg]
    intro hp
    dsimp only at hp
    apply h
    have := hle i
    have h5 : e - p = K * (φ i).val := by omega
    refine ⟨by omega, by rw [h5]; simp, ?_⟩
    rw [h5, Nat.mul_div_cancel_left _ hK]; exact (φ i).isLt

/-! ## The affine exponent expression -/

theorem εAff_regs (eR KR NR : Fin HS) (G : Ex HS → Ex HS) (j : Fin HS)
    (hj : j ∈ (εAff eR KR NR G).regs) :
    j = eR ∨ j = kS ∨ j = KR ∨ j = NR ∨ j ∈ (G (.ndiv (εD eR) (.reg KR))).regs := by
  simp only [εAff, εD, Ex.regs, List.mem_append, List.mem_cons, List.not_mem_nil,
    or_false] at hj
  tauto

/-! ## The two instances -/

theorem εTab_regs (eR KR NR fR : Fin HS) (a : List ℕ) (j : Fin HS)
    (hj : j ∈ (εTab eR KR NR fR a).regs) :
    j = eR ∨ j = kS ∨ j = KR ∨ j = NR ∨ j = fR := by
  rcases εAff_regs _ _ _ _ j hj with h | h | h | h | h
  · exact Or.inl h
  · exact Or.inr (Or.inl h)
  · exact Or.inr (Or.inr (Or.inl h))
  · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  · have := lookL_regs a 0 _ j h
    simp only [Ex.regs, εD, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at this
    tauto

theorem εTab_mem (eR KR NR fR : Fin HS) (L : List ℕ) (hL : L ≠ []) :
    eR ∈ (εTab eR KR NR fR L).regs ∧ KR ∈ (εTab eR KR NR fR L).regs ∧
    NR ∈ (εTab eR KR NR fR L).regs ∧ fR ∈ (εTab eR KR NR fR L).regs := by
  have h2 : fR ∈ (lookL L 0 (.ndiv (.ndiv (εD eR) (.reg KR)) (.reg fR))).regs :=
    lookL_mem _ _ _ hL _ (by simp [Ex.regs])
  simp only [εTab, εAff, Ex.regs, List.mem_append, List.mem_cons, εD]
  refine ⟨by tauto, by tauto, by tauto, by tauto⟩

/-- Reading background registers below an empty managed part. -/
theorem agree_top_encK {σ : Fin HS → Option ℤ} {s : IState HS} (hs : Agree σ s)
    {g : Fin HS → List ℤ} {j : Fin HS} {v : ℤ} (hj : σ j = some v) (hg : g j = []) :
    (encK s g).top j = v ∧ (encK s g).IsInt j := by
  obtain ⟨L, hL⟩ := hs j v hj
  have : (encK s g).G j = .int v :: L := by simp [hg, hL, ints]
  exact ⟨IState.top_eq this, IState.isInt_of this⟩

theorem aff_tops {σ : Fin HS → Option ℤ} {s : IState HS} (hs : Agree σ s) {eR KR NR : Fin HS}
    {e K N : ℕ} (hR : AffReg σ eR KR NR e K N) {k : ℕ} {g : Fin HS → List ℤ}
    (hk : g kS = [(k : ℤ)]) (he : g eR = []) (hK : g KR = []) (hN : g NR = []) :
    (encK s g).top eR = e ∧ (encK s g).IsInt eR ∧ (encK s g).top kS = k ∧
    (encK s g).IsInt kS ∧ (encK s g).top KR = K ∧ (encK s g).IsInt KR ∧
    (encK s g).top NR = N ∧ (encK s g).IsInt NR :=
  ⟨(agree_top_encK hs hR.e he).1, (agree_top_encK hs hR.e he).2, top_encK hk, isInt_encK hk,
    (agree_top_encK hs hR.K hK).1, (agree_top_encK hs hR.K hK).2,
    (agree_top_encK hs hR.N hN).1, (agree_top_encK hs hR.N hN).2⟩

theorem clean_of_lt {e : Ex HS} (h : ∀ j ∈ e.regs, j.val < 56) : e.Clean := by
  intro j hj hz
  have := h j hj
  simp only [zX_all, List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> exact absurd this (by decide)

end NLogN.KFW

