/-- Table of far offsets for the cell offset `(ex, ey) = (pi + 1 - qi, pj + 1 - qj)`. -/
def tab (ex ey : Nat) : Nat :=
  cond (Nat.beq ex 0) (cond (Nat.beq ey 0) X00 (cond (Nat.beq ey 1) X01 X02))
    (cond (Nat.beq ex 1) (cond (Nat.beq ey 0) X10 X12)
      (cond (Nat.beq ey 0) X20 (cond (Nat.beq ey 1) X21 X22)))

/-- `q` and `p` are distinct cells of the 5 × 5 grid with coordinates differing by at most 1. -/
def guard (qi qj pi pj : Nat) : Bool :=
  and (and (and (Nat.ble qi (Nat.succ pi)) (Nat.ble pi (Nat.succ qi)))
           (and (Nat.ble qj (Nat.succ pj)) (Nat.ble pj (Nat.succ qj))))
      (and (and (and (Nat.ble qi 4) (Nat.ble qj 4)) (and (Nat.ble pi 4) (Nat.ble pj 4)))
           (not (and (Nat.beq qi pi) (Nat.beq qj pj))))

/-- One propagation step: delete from cell `q` every unit square that is within the threshold of
every alive unit square of cell `p`. The product adds, for every alive square of `p`, the table of
squares that are too far from it; a square of `q` survives iff its field of the product is nonzero. -/
def step (S : State) (qi qj pi pj : Nat) : State :=
  cond (guard qi qj pi pj)
    (set5 S qi (set5 (get5 S qi) qj (Nat.land (get5 (get5 S qi) qj)
      (Nat.shiftRight (Nat.add (Nat.mul (tab (Nat.sub (Nat.succ pi) qi) (Nat.sub (Nat.succ pj) qj))
        (get5 (get5 S pi) pj)) MADD) 29145))))
    S

/-- Replay `n` steps; the steps are the base-625 digits `((qi*5+qj)*5+pi)*5+pj` of `c`,
lowest digit first. -/
def runCode : Nat → State → Nat → State
  | 0, S, _ => S
  | n+1, S, c => runCode n (step S (Nat.mod (Nat.div c 125) 5) (Nat.mod (Nat.div c 25) 5)
                   (Nat.mod (Nat.div c 5) 5) (Nat.mod c 5)) (Nat.div c 625)

/-- Restricting cell `(ci, cj)` to `mask` and replaying the steps empties cell `(ei, ej)`. -/
def refOK (R : State) (x : Item) : Bool :=
  Nat.beq (get5 (get5 (runCode x.2.2.2.2.2.1
    (set5 R x.1 (set5 (get5 R x.1) x.2.1 (Nat.land (get5 (get5 R x.1) x.2.1) x.2.2.1)))
    x.2.2.2.2.2.2.1) x.2.2.2.1) x.2.2.2.2.1) 0

/-- Delete `mask` from cell `(ci, cj)`, then replay the state steps. -/
def adv (R : State) (x : Item) : State :=
  runCode x.2.2.2.2.2.2.2.1
    (set5 R x.1 (set5 (get5 R x.1) x.2.1
      (Nat.xor (get5 (get5 R x.1) x.2.1) (Nat.land (get5 (get5 R x.1) x.2.1) x.2.2.1))))
    x.2.2.2.2.2.2.2.2

def chunkOK : State → List Item → Bool
  | _, [] => true
  | R, x :: xs => and (refOK R x) (chunkOK (adv R x) xs)

def chunkAdv : State → List Item → State
  | R, [] => R
  | R, x :: xs => chunkAdv (adv R x) xs

def R0 : State :=
