  have hR : IsEichlerOrder Λ 1 := ⟨Λ, Λ, hΛ, hΛ, (inf_idem Λ).symm, AddSubgroup.relIndex_self _⟩

  obtain ⟨Fc₀, iF₀, iA₀, iC₀, iE₀, U₀, h₀⟩ :=
    CerednikDrinfeld.exists_uniformizedHeckeCurve_fuchsianGroup (N := 1) hB Λ Λ hΛ hR le_rfl ι hι
  obtain ⟨perE, hPa, hPc, hPq, hPq'⟩ :=
    CerednikDrinfeld.QM.exists_periodMap_fakeEllipticCurve_complex_iso_iff_hecke_atkinLehner_levelOne hB Λ hΛ ι hι hqq'
      Fc₀ U₀ h₀

  have hbc : ∀ E : FakeEllipticCurve Λ 1 Qb, ∃ E' : FakeEllipticCurve Λ 1 ℂ, FakeEllipticCurve.IsPullback emb E E' := by
    intro E
    obtain ⟨E', g, hg, h1, h2, h3, -⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff emb E
    exact ⟨E', g, hg, h1, h2, h3⟩
  choose bcE hbcE using hbc

  let xP : Place Qb Fbar → SchemeHomOver sbar πX := fun P =>
    ⟨(𝔐.pointEquivPlace.symm P).1 ≫ e𝔐 ≫ CategoryTheory.Limits.pullback.fst πX sbar, by
      rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition, ← Category.assoc e𝔐, he𝔐_snd,
        ← Category.assoc, (𝔐.pointEquivPlace.symm P).2, Category.id_comp]⟩
  have hEP : ∀ P, ∃ E : FakeEllipticCurve Λ 1 Qb, pt _ sbar E = xP P := fun P => pt_surjective Qb sbar (xP P)
  choose EP hEPpt using hEP
  let bcPlace : Place Qb Fbar → Place ℂ Fc₀ := fun P => U₀.pt (perE (bcE (EP P)))

  have L0 : ∀ (E₁ E₂ : FakeEllipticCurve Λ 1 Qb) (E₁' E₂' : FakeEllipticCurve Λ 1 ℂ),
      FakeEllipticCurve.IsPullback emb E₁ E₁' → FakeEllipticCurve.IsPullback emb E₂ E₂' →
      (pt _ sbar E₁).1 = (pt _ sbar E₂).1 → U₀.pt (perE E₁') = U₀.pt (perE E₂') := by
    intro E₁ E₂ E₁' E₂' h₁ h₂ h12
    apply (hPa E₁' E₂').1
    apply pt_injective ℂ sC
    apply Subtype.ext
    rw [pt_pullback Qb ℂ emb sbar sC rfl E₁ E₁' h₁, pt_pullback Qb ℂ emb sbar sC rfl E₂ E₂' h₂, h12]
  have L1 : ∀ (E : FakeEllipticCurve Λ 1 Qb) (E' : FakeEllipticCurve Λ 1 ℂ), FakeEllipticCurve.IsPullback emb E E' →
      ∀ P, (pt _ sbar E).1 = (xP P).1 → U₀.pt (perE E') = bcPlace P := by
    intro E E' h P hP
    exact L0 E (EP P) E' (bcE (EP P)) h (hbcE _) (by rw [hP, ← hEPpt P])
  have hmap : ∀ (s : Multiset (GL (Fin 2) ℝ)) (τ : UpperHalfPlane),
      (s.map fun δ => Finsupp.single (U₀.pt (δ • τ)) (1 : ℤ)) =
        ((s.map fun δ => U₀.pt (δ • τ)).map fun Q₀ => Finsupp.single Q₀ (1 : ℤ)) := by
    intro s τ; rw [Multiset.map_map]; rfl
  obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := h₀
  refine ⟨Fc₀, iF₀, iA₀, iC₀, iE₀, U₀, bcPlace, h1, h2, h3, h4, h5, h6, h7, h8, h9, ?_, ?_, ?_, ?_⟩
  ·
    intro P Q hPQ
    have hIso : FakeEllipticCurve.Iso (bcE (EP P)) (bcE (EP Q)) := (hPa _ _).2 hPQ
    have hC : pt ℂ sC (bcE (EP P)) = pt ℂ sC (bcE (EP Q)) := pt_iso ℂ sC _ _ hIso
    have hQ : (xP P).1 = (xP Q).1 := by
