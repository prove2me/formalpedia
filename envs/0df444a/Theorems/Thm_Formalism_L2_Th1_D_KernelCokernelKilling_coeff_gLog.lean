variable {K : Type} [Field K] {τ : Type} [DecidableEq τ] {l d : ℕ}

theorem Formalism.L2.Th1.D.KernelCokernelKilling.coeff_gLog (φ : ZMod d → τ) (s : ZMod d) (n : τ →₀ ℕ) :
    coeff n (gLog K l φ s) = ∑ e ∈ Finset.range (n.degree + 1),
      if n = Finsupp.single (φ (s - 2 * (e : ZMod d))) ((l ^ 2) ^ e) then ((l : K) ^ e)⁻¹ else 0 := by sorry
