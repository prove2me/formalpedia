  set rest := AModel.hdShape A B Cs m N with hrest
  set v := AModel.vol (P :: L' :: rest) with hv
  set ΛB := (AModel.hdLayout A B Cs m N).cons2 P (W * L')
  set ΛS := (AModel.hdLayout A B Cs m N).cons2 P L'
  have hW1 : 1 ≤ W := NeZero.pos W
  have hP1 : 1 ≤ P := hpos P List.mem_cons_self
  have hL1 : 1 ≤ L' := hpos L' (List.mem_cons_of_mem _ List.mem_cons_self)
  have hr1 : 1 ≤ AModel.vol rest := NLogN.KIL.vol_le_of_pos rest (fun a ha =>
    hpos a (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ ha)))
  have hposB : ∀ a ∈ P :: W * L' :: rest, 1 ≤ a := by
    intro a ha
    simp only [List.mem_cons] at ha
    rcases ha with rfl | rfl | ha
    · exact hP1
    · exact Nat.mul_pos hW1 hL1
    · exact hpos a (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ ha))
  have hVv : AModel.vol (P :: W * L' :: rest) = W * v := by simp only [hv, AModel.vol_cons]; ring
  have hv1 : 1 ≤ v := by simp only [hv, AModel.vol_cons]; exact Nat.mul_pos hP1 (Nat.mul_pos hL1 hr1)
  have hvV : v ≤ AModel.vol (P :: W * L' :: rest) := by rw [hVv]; exact Nat.le_mul_of_pos_left v hW1
  have hB1 : 1 ≤ Bb := le_trans (by
    have := NLogN.zsz_natCast_le' (show 1 ≤ 2 * N by omega)
    simpa [NLogN.zsz_one] using this) hQ2
  have hle : ∀ k : ℕ, k ≤ AModel.vol (P :: W * L' :: rest) → NLogN.zsz (k : ℤ) ≤ Bb := fun k hk =>
    le_trans (NLogN.zsz_natCast_le' hk) hV
  have hVS : NLogN.zsz ((v : ℕ) : ℤ) ≤ Bb := hle v hvV
  have hVexp : AModel.vol (P :: W * L' :: rest) = P * (W * L') * AModel.vol rest := by
    simp only [AModel.vol_cons]; ring
  have hvexp : v = P * L' * AModel.vol rest := by simp only [hv, AModel.vol_cons]; ring
  have zW : NLogN.zsz (W : ℤ) ≤ Bb := hle W (by
    rw [hVexp]
    have h1 : W ≤ W * L' := Nat.le_mul_of_pos_right W hL1
    have h2 : W * L' ≤ P * (W * L') := Nat.le_mul_of_pos_left _ hP1
    have h3 : P * (W * L') ≤ P * (W * L') * AModel.vol rest := Nat.le_mul_of_pos_right _ hr1
    omega)
  have zv : NLogN.zsz ((P * L' * AModel.vol rest : ℕ) : ℤ) ≤ Bb := by rw [← hvexp]; exact hVS
  have hTab : NLogN.KIL.TabB W v Bb :=
    ⟨le_trans (NLogN.zsz_natCast_le' (by omega)) hQ2, by rw [← hVv]; exact hV, NeZero.pos W⟩
  -- the registers on `t` (and on every `t.upd 0 _`)
  have pr : ∀ r : Fin NLogN.HS, 22 ≤ r.val → r.val ≠ 44 → NLogN.KIL.Prot r := fun r h1 h2 => ⟨h1, h2⟩
  obtain ⟨LP, tP⟩ := NLogN.KIL.inv_get' ht (pr NLogN.KIL.dP (by decide) (by decide)) (X := [.int (P : ℤ)]) hG.p
  obtain ⟨LL, tL⟩ := NLogN.KIL.inv_get' ht (pr NLogN.KIL.rLp (by decide) (by decide)) (X := [.int (L' : ℤ)]) hG.lp
  obtain ⟨LV, tV⟩ := NLogN.KIL.inv_get' ht (pr NLogN.KIL.rV (by decide) (by decide))
    (X := [.int ((v : ℕ) : ℤ)]) hG.v
  have tV' : t.G NLogN.KIL.rV = .int ((P * L' * AModel.vol rest : ℕ) : ℤ) :: LV := by rw [← hvexp]; exact tV
  have regs : ∀ (t' : NLogN.IState NLogN.HS), NLogN.KIL.Inv G0 t' → ∀ Y : List NLogN.Item,
      (∃ L, (t'.upd 0 Y).G NLogN.KIL.sNQ = .int (-(N : ℤ)) :: L) ∧
      (∃ L, (t'.upd 0 Y).G NLogN.KIL.sQQ = .int (N : ℤ) :: L) ∧
      (∃ L, (t'.upd 0 Y).G NLogN.KIL.rXs = .int ((AModel.vol (P :: L' :: A) : ℕ) : ℤ) :: L) ∧
      (∃ L, (t'.upd 0 Y).G NLogN.KIL.rXb = .int ((AModel.vol (P :: W * L' :: A) : ℕ) : ℤ) :: L) ∧
      (∃ L, (t'.upd 0 Y).G NLogN.KIL.rVB = .int ((AModel.vol B : ℕ) : ℤ) :: L) ∧
      (∃ L, (t'.upd 0 Y).G NLogN.KIL.rVC = .int ((AModel.vol Cs : ℕ) : ℤ) :: L) := fun t' ht' Y =>
    ⟨NLogN.KIL.inv_get ht' (pr NLogN.KIL.sNQ (by decide) (by decide)) (X := [_]) hG.nq Y,
      NLogN.KIL.inv_get ht' (pr NLogN.KIL.sQQ (by decide) (by decide)) (X := [_]) hG.qq Y,
      NLogN.KIL.inv_get ht' (pr NLogN.KIL.rXs (by decide) (by decide)) (X := [_]) hG.xs Y,
      NLogN.KIL.inv_get ht' (pr NLogN.KIL.rXb (by decide) (by decide)) (X := [_]) hG.xb Y,
      NLogN.KIL.inv_get ht' (pr NLogN.KIL.rVB (by decide) (by decide)) (X := [_]) hG.vb Y,
      NLogN.KIL.inv_get ht' (pr NLogN.KIL.rVC (by decide) (by decide)) (X := [_]) hG.vc Y⟩
  -- Phase 1: D ← D − H
  obtain ⟨⟨_, r1⟩, ⟨_, r2⟩, -, ⟨_, r4⟩, ⟨_, r5⟩, ⟨_, r6⟩⟩ := regs t ht (NLogN.ints (NLogN.KIL.enc2 xs) ++ R)
  have H1 := NLogN.KIL.subU_spec A B Cs P (W * L') NLogN.KIL.rXb ⟨by decide, by decide⟩ hposB Bb R hV hQ2 hSB
    (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 xs) ++ R)) r1 r2 r4 r5 r6 (NLogN.KIL.enc2 xs)
    (by rw [NLogN.KIL.length_enc2]; exact hxs) (NLogN.KIL.bnd_enc2 xs hB1) (by simp)
  rw [NLogN.IState.upd_upd_same, NLogN.KIL.runArr_enc2] at H1
  set xs1 := AModel.runArr ΛB 0 (AModel.subSteps m) xs with hxs1
  have hxs1l : xs1.length = AModel.vol (P :: W * L' :: rest) := AModel.length_runArr ΛB 0 _ hxs
  -- Phase 2: the row split
  have H2 := NLogN.KIL.withSplit_sp NLogN.KIL.bwdP W P L' (AModel.vol rest) Bb t (NLogN.KIL.enc2 xs1)
    ((List.finRange W).flatMap fun w => AModel.rowSplit P W L' rest w 0 (NLogN.KIL.enc2 xs1)) R hP1 hL1 hr1
    zW zv hB1 tP tL tV'
    (fun u h0 h1 h2 h3 h4 => NLogN.KIL.rowSplit_spec u (NLogN.KIL.enc2 xs1) P W L' rest Bb R (t.G 1) (t.G 2) (t.G 3)
      (t.G 4) (by rw [NLogN.KIL.length_enc2]; exact hxs1l) (NLogN.KIL.bnd_enc2 xs1 hB1) hr1 (Nat.mul_pos hP1 hL1) hW1
      (hle _ (by rw [hVexp]; apply le_of_eq; ring)) h0 h1 h2 h3 h4)
  -- Phase 3: the network
  set Φ : AModel.IMat m → List (ZMod 2) → List (ZMod 2) := fun X ys => AModel.runC ΛS child 0 (AModel.edgeSteps C N X) ys
  set Y0 : Fin W → Fin v → ZMod 2 := fun w i => (AModel.rowSplit P W L' rest w 0 xs1).getD (i : ℕ) 0
  have hsplit : (List.finRange W).flatMap (fun w => AModel.rowSplit P W L' rest w 0 (NLogN.KIL.enc2 xs1)) =
      NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf Y0) := by
    rw [NLogN.KIL.flatMap_finRange_tabR]
    congr 1
    funext n
    simp only [NLogN.KIL.liftF, NLogN.KIL.tabOf]
    split_ifs with hn
    · rw [NLogN.KIL.rowSplit_enc2, NLogN.KIL.ofFn_getD_eq]; simp [hv]
    · rfl
  rw [hsplit] at H2
  have hswL : ∀ X, Pr X → ∀ a b, AModel.Step.swap a b ∈ AModel.edgeSteps C N X → ∀ ys : List (ZMod 2),
      ys.length = v → (child a b ys).length = v := fun X hX a b hab ys hys => by
    rw [hT X hX] at hab
    exact (hsw X hX a b (NLogN.KIL.sw_of_mem hab) t R ys ht hys).2
  have hΦl : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v →
      (Φ X ys).length = v :=
    fun X hX ys hys => NLogN.KIL.length_runC ΛS child _ (fun a b hab ys h => hswL X hX a b hab ys h) ys hys
  have hE : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v →
      ∀ (t' : NLogN.IState NLogN.HS) (R' : List NLogN.Item), NLogN.KIL.Inv G0 t' →
      NLogN.IRuns I iprog (NLogN.KIL.edgeCU m j0 (tpl X)) (t'.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R'))
        (t'.upd 0 (NLogN.ints (NLogN.KIL.enc2 (Φ X ys)) ++ R')) (NLogN.KIL.edgeCost (NLogN.KIL.cShT v Bb) cC (tpl X)) := by
    intro X hX ys hys t' R' ht'
    have H := NLogN.KIL.edgeCU_runs (I := I) (iprog := iprog) ΛS j0 G0 (NLogN.KIL.cShT v Bb) cC child (tpl X)
      (fun T hT' t'' R'' ys' ht'' hys' => by
        obtain ⟨⟨_, q1⟩, ⟨_, q2⟩, ⟨_, q3⟩, -, ⟨_, q5⟩, ⟨_, q6⟩⟩ :=
          regs t'' ht'' (NLogN.ints (NLogN.KIL.enc2 ys') ++ R'')
        have S := NLogN.KIL.stepU_spec A B Cs P L' T NLogN.KIL.rXs ⟨by decide, by decide⟩ hpos
          (t''.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys') ++ R'')) (NLogN.KIL.enc2 ys') Bb R'' (hTOK X hX T hT')
          (by rw [NLogN.KIL.length_enc2]; exact hys') (NLogN.KIL.bnd_enc2 ys' hB1) hVS hQ2 (by simp) q1 q2 q3 q5 q6
        rw [NLogN.IState.upd_upd_same, NLogN.KIL.arr_enc2] at S
        exact S.toIRuns)
      (fun a b hab t'' R'' ys' ht'' hys' => hsw X hX a b hab t'' R'' ys' ht'' hys')
      t' R' ys ht' hys
    rw [← hT X hX] at H
    exact H
  have hs0 : NLogN.KIL.Inv G0 (t.upd 0 R) := ht.upd (NLogN.KIL.not_prot (by decide)) R
  have H3 := NLogN.KIL.netCU_runs (I := I) (iprog := iprog) (E := fun X => NLogN.KIL.edgeCU m j0 (tpl X))
    (cE := fun X => NLogN.KIL.edgeCost (NLogN.KIL.cShT v Bb) cC (tpl X)) Φ Pr hΦl hE
    (t.upd 0 R) hs0 [] hTab hv1 C.Mout C.gates C.Min Y0
    (Function.update (fun _ => []) 0 (NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf Y0) ++ [])) hfr
    (NLogN.KIL.prot_upd0 (fun _ _ => rfl) _)
    ⟨by simp +decide, by simp +decide, by simp +decide, ⟨LV, by simp +decide [tV]⟩, by
      obtain ⟨LW, hLW⟩ := NLogN.KIL.inv_get ht (pr NLogN.KIL.rWV (by decide) (by decide)) (X := [_]) hG.wv R
      exact ⟨LW, hLW⟩⟩
    (by simp) (by simp)
  rw [Function.update_idem, List.append_nil, List.append_nil, ← NLogN.KIL.upd_as_encK, ← NLogN.KIL.upd_as_encK] at H3
  set Yn := AModel.netRunF (NLogN.KIL.funΦ v Φ) C.gates C.Min C.Mout Y0 with hYn
  -- Phase 4: routing
  have H4 := NLogN.KIL.rebuildCU_sp (NLogN.KIL.uni_tabOf Yn) (t.upd 0 R)
    (Function.update (fun _ => []) 0 (NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf Yn) ++ [])) [] (by simp) (by simp)
    ⟨by simp +decide, by simp +decide, by simp +decide, ⟨LV, by simp +decide [tV]⟩, by
      obtain ⟨LW, hLW⟩ := NLogN.KIL.inv_get ht (pr NLogN.KIL.rWV (by decide) (by decide)) (X := [_]) hG.wv R
      exact ⟨LW, hLW⟩⟩ hTab hv1 (NLogN.KIL.permT_ok C)
  rw [Function.update_idem, List.append_nil, List.append_nil, ← NLogN.KIL.upd_as_encK, ← NLogN.KIL.upd_as_encK] at H4
  set sM : Fin W → List ℤ := fun w => NLogN.KIL.enc2 (List.ofFn (Yn (C.ρ w)))
  have hperm : NLogN.KIL.tabR 0 W (fun n => NLogN.KIL.sumS (NLogN.KIL.tabOf Yn) v (NLogN.KIL.permT C n)) =
      (List.finRange W).flatMap sM := by
    rw [NLogN.KIL.flatMap_finRange_tabR]
    apply NLogN.KIL.tabR_congr
    intro n _ hn
    simp only [Nat.zero_add] at hn
    simp only [NLogN.KIL.permT, dif_pos hn, NLogN.KIL.liftF]
    rw [NLogN.KIL.sumS_single (NLogN.KIL.uni_tabOf Yn) (C.ρ _).2]
    simp [NLogN.KIL.tabOf, NLogN.KIL.liftF, sM]
  rw [hperm] at H4
  -- Phase 5: the row merge
  have H5 := NLogN.KIL.withSplit_sp NLogN.KIL.fwdP W P L' (AModel.vol rest) Bb t ((List.finRange W).flatMap sM)
    (AModel.rowMerge P W L' rest 0 sM) R hP1 hL1 hr1 zW zv hB1 tP tL tV'
    (fun u h0 h1 h2 h3 h4 => NLogN.KIL.rowMerge_spec u sM P L' rest Bb R (t.G 1) (t.G 2) (t.G 3)
      (t.G 4) (fun w => by simp only [sM, NLogN.KIL.length_enc2, List.length_ofFn, hv, AModel.vol_cons]; ring)
      (fun w => NLogN.KIL.bnd_enc2 _ hB1) hr1
      (Nat.mul_pos hP1 hL1) (hle _ (by rw [hVexp]; apply le_of_eq; ring)) h0 h1 h2 h3 h4)
  have hmerge : AModel.rowMerge P W L' rest 0 sM =
      NLogN.KIL.enc2 (AModel.rowMerge P W L' rest 0 fun w => List.ofFn (Yn (C.ρ w))) := NLogN.KIL.rowMerge_enc2 _ _ _ _
  rw [hmerge] at H5
  -- Phase 6: D ← H − D
  set xs5 := AModel.rowMerge P W L' rest 0 fun w => List.ofFn (Yn (C.ρ w))
  have hxs5 : xs5.length = AModel.vol (P :: W * L' :: rest) := by simp [xs5, AModel.rowMerge]
  obtain ⟨⟨_, p1⟩, ⟨_, p2⟩, -, ⟨_, p4⟩, ⟨_, p5⟩, ⟨_, p6⟩⟩ := regs t ht (NLogN.ints (NLogN.KIL.enc2 xs5) ++ R)
  have H6 := NLogN.KIL.flipU_spec A B Cs P (W * L') NLogN.KIL.rXb ⟨by decide, by decide⟩ hposB Bb R hV hQ2 hSB
    (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 xs5) ++ R)) p1 p2 p4 p5 p6 (NLogN.KIL.enc2 xs5)
    (by rw [NLogN.KIL.length_enc2]; exact hxs5) (NLogN.KIL.bnd_enc2 xs5 hB1) (by simp)
  rw [NLogN.IState.upd_upd_same, NLogN.KIL.runArr_enc2] at H6
  have H := H1.toIRuns.seq (H2.toIRuns.seq (H3.seq (H4.toIRuns.seq (H5.toIRuns.seq
    H6.toIRuns))))
  refine H.mono' rfl ?_
  simp only [NLogN.KIL.bodyCI, ← hrest, ← hv, ← hVv]
  omega
end
