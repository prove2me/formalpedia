namespace NLogN.KFUU

open IntMul KIL KFB KFC KFT KFU AModel AModelL12

theorem shape_lay0 (u cz : ℕ) (bs : List Bool) :
    (lay1 (bgB bs) bs.length 0).map (asz (mzB u bs.length cz)) =
      List.replicate bs.length (2 ^ u) ++ (ctB u cz bs ++ [cz]) := by
  have e1 : (mains (List.range bs.length)).map (asz (mzB u bs.length cz)) =
      List.replicate bs.length (2 ^ u) := by
    apply List.eq_replicate_iff.2
    refine ⟨by simp [mains], fun b hb => ?_⟩
    simp only [mains, List.map_map, List.mem_map, List.mem_range, Function.comp_apply] at hb
    obtain ⟨j, hj, rfl⟩ := hb
    exact asz_main hj
  simp only [lay1, List.take_zero, List.drop_zero, List.map_append, e1, ctB]
  simp [layA, asz_cid]

theorem lay0_nf (u cz : ℕ) (bs : List Bool) :
    (lay1 (bgB bs) bs.length 0).Nodup ∧
      Full (bgB bs) (List.range bs.length ++ [bs.length]) (lay1 (bgB bs) bs.length 0) := by
  have hp := lay1_perm (bgB bs) (bgB_n bs) 0
  exact ⟨hp.nodup_iff.2 (nodup_layA _ _ (nodup_ax0 _)),
    (full_layA _ _).mono (fun x hx => hp.symm.mem_iff.1 hx)⟩

theorem map_rv_lay0 (u cz : ℕ) (bs : List Bool) {m : ℕ} (hm : m ≤ bs.length) :
    (rv bs.length m (lay1 (bgB bs) bs.length 0)).map (asz (mzB u bs.length cz)) =
      (lay1 (bgB bs) bs.length 0).map (asz (mzB u bs.length cz)) := by
  set lay0 := lay1 (bgB bs) bs.length 0 with hlay0
  set mz := mzB u bs.length cz
  have hr : bs.length ≤ lay0.length := len_lay0 bs
  have hS : ∀ i < bs.length, asz mz (lay0.getD i 0) = 2 ^ u := by
    intro i hi
    have e : (lay0.map (asz mz)).getD i 0 = 2 ^ u := by
      rw [hlay0, shape_lay0, List.getD_append _ _ _ _ (by simp; omega)]
      simp [List.getD_eq_getElem?_getD, List.getElem?_replicate, hi]
    rw [← e, List.getD_eq_getElem _ _ (by omega),
      List.getD_eq_getElem _ _ (by rw [List.length_map]; omega), List.getElem_map]
  exact map_rv _ hr hm _ hS
end NLogN.KFUU

