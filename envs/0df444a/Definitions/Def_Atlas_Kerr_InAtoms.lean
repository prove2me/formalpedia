import Mathlib
import Definitions.Def_Atlas_Core_Basic
import Definitions.Def_Atlas_Core_Lift
import Definitions.Def_Atlas_Kerr_InDefs
/-!
# Ingoing Kerr: rational atoms and their derivatives

Notation wrappers (B3 class B): `Ui a r θ = (r² + a² cos²θ)⁻¹ = 1/Σ` and `Wi θ = (sin θ)⁻¹`.
Generated tables (`Atlas.Kerr.InTables`) are polynomials in `r, sin θ, cos θ, Ui, Wi`; these
wrappers make `ring` treat `1/Σ` and `1/sin θ` as atoms. The derivative rules below are the
only analytic input of the tables.
-/

open Real

namespace ExactVacuumAtlas.Kerr.In

/-- `1/Σ` with `Σ = r² + a² cos²θ`. -/
noncomputable def Ui (a r θ : ℝ) : ℝ := (r ^ 2 + a ^ 2 * cos θ ^ 2)⁻¹

/-- `1/sin θ`. -/
noncomputable def Wi (θ : ℝ) : ℝ := (sin θ)⁻¹

end ExactVacuumAtlas.Kerr.In


