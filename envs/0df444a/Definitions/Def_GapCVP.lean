      | true =>
          cases counterLength with
          | succ counterLength =>
              have hfailure := canonical_failFromStep
                (canonicalConfiguration
                  (canonicalPayloadLabel position)
                  [] (true :: List.replicate counterLength true)
                  field binary [] [])
                [] (true :: List.replicate counterLength true)
