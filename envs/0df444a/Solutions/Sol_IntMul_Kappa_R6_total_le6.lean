theorem desc_phi6 : ∀ x ∈ Q.dPh, 0 ≤ x ∧ x ≤ 2 ^ Q.b := by
  obtain ⟨a1, a2, a3, a4, a5, a6, a7⟩ := small_facts6 hQ hD
  intro x hx
  simp only [Q6.dPh, descPhi6, descPhi, List.mem_cons, List.mem_append, List.mem_map,
    List.mem_range] at hx
  rcases hx with rfl | rfl | rfl | ((hx | ⟨j, hj, rfl⟩) | ⟨j, hj, rfl⟩)
  · exact ⟨by positivity, by exact_mod_cast a1⟩
  · exact ⟨by positivity, by exact_mod_cast a2⟩
  · exact ⟨by positivity, by exact_mod_cast a3⟩
