-- title:
--   Proposition A.3, EC p. 4 — unique efficient rerouted supply
-- statement:
--   Fix a good $m$, a feasible profile of undelivered orders $\bar r_i^m$, and nonnegative market prices $\pi_i^m$. There is exactly one efficient rerouted supply profile $r_i^m$ in the sense of Definition 2.1. For every firm with $\bar r_i^m>0$ it is
--
--   $$r_i^m=\min\left\{\bar r_i^m,\frac{\bar r_i^m}{\sum_{j:\,\pi_j^m=\pi_i^m}\bar r_j^m}\left(d_m(\pi_i^m)-\sum_{j:\,\pi_j^m<\pi_i^m}\bar r_j^m\right)^+\right\}.$$
--
--   The formula identifies the allocation generated by the optimization and proportional tie rule; it is not used as the definition of efficiency.
--
--   **Formalization Note** Sums range over firms with positive undelivered orders. Inactive firms receive zero. Feasible orders arise from a matrix with entries between zero and the original orders; the denominator is positive for each active firm. The prices of active sellers are assumed nonnegative, the strategy space of Definition 3.1 (deviations $\pi\ge0$); the demand function is unconstrained at negative prices.
-- source:
--   Birge, Capponi & Chen, Disruption and Rerouting in Supply Chain Networks, SSRN 3669363 (version of October 31, 2022; Oper. Res. 2023, DOI 10.1287/opre.2022.2409), E-Companion, p. EC 4 (PDF p. 46), Proposition A.3, (A.6)

import Mathlib
import Definitions.Def_DisruptReroute_GenEq_Model

namespace DisruptReroute.GenEq

/-- Proposition A.3: existence, uniqueness, and formula (A.6). -/
theorem proposition_A_3 {N M : ℕ} (net : Network N M) (m : Fin M)
    (Γ : Matrix N M) (price : Fin N → ℝ)
    (h : Standing net) (hΓ : InBounds net Γ)
    (hp : ∀ i ∈ active N (rbar Γ m), 0 ≤ price i) :
    (∃! x : Fin N → ℝ, EfficientR net m (rbar Γ m) price x) ∧
    (∀ x : Fin N → ℝ, EfficientR net m (rbar Γ m) price x →
      ∀ i ∈ active N (rbar Γ m),
        x i = greedyR net m (rbar Γ m) price i) := by sorry

end DisruptReroute.GenEq
