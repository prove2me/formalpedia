private theorem continuous_integrand {φ : AdelicGL2 (𝓞 K) K → ℂ} (hφ : Continuous φ) :
    Continuous fun p : AdelicGL2 (𝓞 K) K × AdeleRing (𝓞 K) K => φ (unipotentGL2 p.2 * p.1) :=
