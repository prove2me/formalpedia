section Steps

variable {R : Type} [Fintype R] [DecidableEq R]

lemma prod_finRange_get (L : List (ℤ × (Fin m → ZMod 2))) :
    ((List.finRange L.length).map fun k => Tk (L.get k).1 (L.get k).2) =
      L.map fun p => Tk p.1 p.2 := by
  conv_rhs => rw [← List.map_get_finRange L]
  rw [List.map_map]; rfl

theorem mergedChunk_den (w : R) (L : List (ℤ × (Fin m → ZMod 2)))
    (hε : ∀ p ∈ L, p.1 = 1 ∨ p.1 = -1) (hL : LIndep L) :
    denListH (chEx (κ := κ)) (mergedChunk w L) = wireOp w (colT (L.map fun p => Tk p.1 p.2).prod) := by
  by_cases h0 : L = []
  · subst h0; simp [mergedChunk, colT_one, wireOp_one]
  have hc : L ≠ [] ∧ (∀ p ∈ L, p.1 = 1 ∨ p.1 = -1) ∧ LIndep L := ⟨h0, hε, hL⟩
  unfold mergedChunk
  rw [dif_pos hc]
  rw [(Classical.choose_spec (merge_chunk w (fun k => (L.get k).1)
      (fun k => hc.2.1 _ (List.get_mem L k)) _ hc.2.2)).2 κ, prod_finRange_get]

/-- **Conversion of single-slot chunks.** The merged chunk has exactly the denotation of the
`Prop8IfaceR` kernel chunks `frameSteps w L` (`|L|` single-slot children). -/
theorem mergedChunk_den_frameSteps_sol_aux (w : R) (L : List (ℤ × (Fin m → ZMod 2)))
    (hL : ∀ p ∈ L, (p.1 = 1 ∨ p.1 = -1) ∧ p.2 ≠ 0) (hind : LIndep L) :
    denListH (chEx (κ := κ)) (mergedChunk w L) =
      denListH (chEx (κ := κ)) ((frameSteps w L).map HStep.ofR) := by
  rw [mergedChunk_den w L (fun p hp => (hL p hp).1) hind, denListH_map_ofR, frameSteps_den w L hL]

end Steps

