-- title:
--   Polynomial logarithmic jet ideals and unrestricted packets
-- statement:
--   Defines truncated polynomial logarithmic coordinates, ideals generated by powers of those coordinates, their intersection over the prescribed centers, and the formal packet map on unrestricted polynomials.
-- source:
--   https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Approximation/AdmissibleMatrixGeometry.lean#L41-L44

import Definitions.Def_OAI_PiExponent_AdmissibleFormalInterpolation
import Mathlib.RingTheory.Ideal.Operations

namespace OAI.PiExponent.LogarithmicJetIdeals

noncomputable def jetCoordinate {m : ℕ} (c : Fin m → ℂ) (T : Fin m → ℕ) :
    Fin (m + 1) → MvPolynomial (Fin (m + 1)) ℂ :=
  Fin.cases (MvPolynomial.X 0 - 1) (fun i =>
    MvPolynomial.X i.succ - MvPolynomial.C (c i) -
      Polynomial.eval₂ MvPolynomial.C (MvPolynomial.X 0 - 1)
        (InterpolationMatrix.truncatedLog (T i)))

noncomputable def localJetIdeal {m : ℕ} (c : Fin m → ℂ) (T : Fin m → ℕ)
    (e : Fin (m + 1) → ℕ) : Ideal (MvPolynomial (Fin (m + 1)) ℂ) :=
  Ideal.span (Set.range (fun i => jetCoordinate c T i ^ e i))

noncomputable def simultaneousJetIdeal {m : ℕ} (K : ℕ) (r : Fin m → ℂ)
    (T : Fin m → ℕ) (e : Fin (m + 1) → ℕ) : Ideal (MvPolynomial (Fin (m + 1)) ℂ) :=
  ⨅ j : Fin K, localJetIdeal (fun i => (j.val : ℂ) * r i) T e

noncomputable def rawPacketMap {m : ℕ} (K : ℕ) (v0 theta : ℝ)
    (w : Fin m → ℝ) (H : ℝ) (r : Fin m → ℂ)
    (P : MvPolynomial (Fin (m + 1)) ℂ) :
    InterpolationMatrix.Row K v0 theta w H → ℂ :=
  fun rho => MvPowerSeries.coeff (InterpolationMatrix.exponentVector rho.2.val)
    (AdmissibleFormalInterpolation.formalJet (fun i => (rho.1.val : ℂ) * r i) P)

end OAI.PiExponent.LogarithmicJetIdeals


