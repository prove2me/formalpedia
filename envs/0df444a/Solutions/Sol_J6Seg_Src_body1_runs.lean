theorem tlT_end (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (n' : ℕ) : tlT src argOf n' n' = [] := by
  simp [tlT, drp_s]

theorem tab_loop (s0 : IState HS) (G : Fin HS → List ℤ) {iN : Fin HS} (fN : Free iN) {n' A c : ℕ}
    {LN : List ℤ} (hGN : G iN = (n' : ℤ) :: LN) (hnA : n' ≤ 2 ^ A) {b : RS} (hw : (43 : Fin HS) ∉ b.writes)
    (src : ℕ → Option ℕ) (argOf : ℕ → ℤ)
    (hb : ∀ j < n', Sp b (encK s0 (tbS G [(j : ℤ) + 1] (tlT src argOf n' (j + 1) ++ G 44)))
