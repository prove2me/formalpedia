import Mathlib

/-!
# Denominators of rational points on Mordell curves `E_N : y² = x³ + N`

This file develops the *denominator theory* of rational points on the Mordell
curve `E_N : y² = x³ + N` (`N : ℤ`), the arithmetic object behind the folklore
conjecture that denominators of multiples of a rational point only involve the
primes of bad reduction `{2, 3} ∪ {p : p ∣ N}`.

Main results.

* `MordellDenominators.den_sq_eq_den_cube` : for any rational point,
  `y.den ^ 2 = x.den ^ 3`.
* `MordellDenominators.exists_den_param` : consequently there is `e ≥ 1` with
  `x.den = e ^ 2` and `y.den = e ^ 3` (the classical `(e², e³)` shape).
* `MordellDenominators.prime_dvd_x_den_iff_dvd_y_den`, `sq_dvd_x_den`,
  `cube_dvd_y_den` : a prime dividing one denominator divides both, to order
  `≥ 2` resp. `≥ 3`; i.e. the point lies in the kernel of reduction there.
* `MordellDenominators.dbl_onCurve` : the duplication formula lands on the
  curve again.
* `MordellDenominators.dvd_den_dblX_of_dvd_den` : the kernel of reduction at
  any prime `ℓ` is stable under duplication — once a prime enters a
  denominator it stays for the whole doubling orbit.

Everything is elementary (no `EllipticCurve` API is needed) and explicit, so
that the counterexamples in `Counterexample.lean` and the infinite family in
`Family.lean` can be checked against these general theorems.
-/

namespace MordellDenominators

/-! ## Basic definitions -/

/-- The affine Mordell curve `E_N : y² = x³ + N` over `ℚ`. -/
def OnCurve (N : ℤ) (x y : ℚ) : Prop := y ^ 2 = x ^ 3 + (N : ℚ)

/-- Discriminant of `E_N`, namely `Δ = -432 N²`.  Its prime divisors are
`{2, 3} ∪ {p : p ∣ N}`; these are the "bad primes" of the conjecture. -/
def disc (N : ℤ) : ℤ := -432 * N ^ 2


/-- A prime is *good* for `E_N` when it does not divide `6N`. -/
def GoodPrime (N : ℤ) (l : ℕ) : Prop := l.Prime ∧ ¬ ((l : ℤ) ∣ 6 * N)

/-- `x`-coordinate of `2P` given `x = x(P)`, from the duplication formula
`x(2P) = (x⁴ - 8Nx) / (4(x³ + N))`. -/
def dblX (N : ℤ) (x : ℚ) : ℚ := (x ^ 4 - 8 * (N : ℚ) * x) / (4 * (x ^ 3 + (N : ℚ)))

/-- `y`-coordinate of `2P`, `y(2P) = λ (x - x(2P)) - y` with `λ = 3x²/(2y)`. -/
def dblY (N : ℤ) (x y : ℚ) : ℚ := (3 * x ^ 2 / (2 * y)) * (x - dblX N x) - y

/-- Duplication as a map on affine points. -/
def dbl (N : ℤ) (P : ℚ × ℚ) : ℚ × ℚ := (dblX N P.1, dblY N P.1 P.2)

/-- `2^n P`, obtained by iterating duplication. -/
def dblIter (N : ℤ) (n : ℕ) (P : ℚ × ℚ) : ℚ × ℚ := (dbl N)^[n] P

/-- The *only-bad-primes* conjecture for the doubling orbit of `P` on `E_N`:
every prime occurring in the denominator of an `x`-coordinate of `2^n P`
divides `6N`, i.e. is a prime of bad reduction.

The points `2^n P` are among the multiples `nP`, so refuting this statement
refutes the conjecture as usually stated (over all multiples of `P`); the
doubling orbit is used because it is generated by the single explicit
duplication formula. -/
def OnlyBadPrimes (N : ℤ) (P : ℚ × ℚ) : Prop :=
  ∀ n : ℕ, ∀ l : ℕ, l.Prime → l ∣ (dblIter N n P).1.den → (l : ℤ) ∣ 6 * N

