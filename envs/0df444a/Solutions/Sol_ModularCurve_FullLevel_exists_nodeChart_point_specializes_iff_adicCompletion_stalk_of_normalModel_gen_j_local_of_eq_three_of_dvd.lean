theorem Subalgebra.mem_adjoin_inv_iff {R F : Type*} [CommRing R] [Field F] [Algebra R F]
    (C : Subalgebra R F) (d : F) (hd : d ∈ C) (hd0 : d ≠ 0) (f : F) :
    f ∈ Algebra.adjoin R ((C : Set F) ∪ {d⁻¹}) ↔ ∃ b : F, b ∈ C ∧ ∃ n : ℕ, f * d ^ n = b := by
  constructor
  · intro hf
    induction hf using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with hx | hx
      · exact ⟨x, hx, 0, by rw [pow_zero, mul_one]⟩
      · rw [Set.mem_singleton_iff] at hx; subst hx
        exact ⟨1, C.one_mem, 1, by rw [pow_one, inv_mul_cancel₀ hd0]⟩
    | algebraMap r => exact ⟨algebraMap R F r, C.algebraMap_mem r, 0, by rw [pow_zero, mul_one]⟩
    | add x y _ _ hx hy =>
      obtain ⟨b, hb, n, hn⟩ := hx
      obtain ⟨b', hb', m, hm⟩ := hy
      refine ⟨b * d ^ m + b' * d ^ n, C.add_mem (C.mul_mem hb (C.pow_mem hd m)) (C.mul_mem hb' (C.pow_mem hd n)), n + m, ?_⟩
      rw [add_mul, pow_add, ← mul_assoc, hn, mul_comm (d ^ n) (d ^ m), ← mul_assoc, hm]
    | mul x y _ _ hx hy =>
      obtain ⟨b, hb, n, hn⟩ := hx
      obtain ⟨b', hb', m, hm⟩ := hy
      refine ⟨b * b', C.mul_mem hb hb', n + m, ?_⟩
      rw [pow_add, mul_mul_mul_comm, hn, hm]
  · rintro ⟨b, hb, n, hn⟩
    have : f = b * (d⁻¹) ^ n := by
      rw [← hn, mul_assoc, ← mul_pow, mul_inv_cancel₀ hd0, one_pow, mul_one]
    rw [this]
    have hb' : b ∈ Algebra.adjoin R ((C : Set F) ∪ {d⁻¹}) := Algebra.subset_adjoin (Set.mem_union_left _ hb)
    have hd' : d⁻¹ ∈ Algebra.adjoin R ((C : Set F) ∪ {d⁻¹}) := Algebra.subset_adjoin (Set.mem_union_right _ rfl)
    exact Subalgebra.mul_mem _ hb' (Subalgebra.pow_mem _ hd' n)

end NodeSkelG

