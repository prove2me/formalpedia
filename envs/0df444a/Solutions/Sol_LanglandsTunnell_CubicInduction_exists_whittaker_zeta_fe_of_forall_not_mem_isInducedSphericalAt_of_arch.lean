p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open NumberField IsDedekindDomain NumberField.TateGlobal LanglandsTunnell.TateLocal LanglandsTunnell.RankinSelberg

private theorem norm_stdRootNumberAt_localChar_eq_one (K : Type) [Field K] [NumberField K]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (hμc : Continuous μ) (hμu : AutomorphicForm.IsUnitaryChar (𝓞 K) K μ)
    (𝔓 : HeightOneSpectrum (𝓞 K)) : ‖stdRootNumberAt K 𝔓 (localChar μ 𝔓)‖ = 1 := by
  obtain ⟨c, hc⟩ :=
    exists_hasConductorExponentAt_of_continuous K 𝔓 (localChar μ 𝔓) (continuous_localChar μ hμc 𝔓)
  have hu : ‖((localChar μ 𝔓 (AdelicLevel.uniformizerUnit K 𝔓) : ℂˣ) : ℂ)‖ = 1 :=
    LanglandsTunnell.CubicInduction.TwistFibre.norm_localChar_apply_eq_one hμu 𝔓 _
  rcases Nat.eq_zero_or_pos c with rfl | hpos
  · have h := stdRootNumberAt_mul_of_hasConductorExponentAt_zero K 𝔓 1 (localChar μ 𝔓) 0
      (hasConductorExponentAt_one_zero K 𝔓) hc (by simp) hu (psiLocal_ne_one K 𝔓)
    have h1 : (1 : (𝔓.adicCompletion K)ˣ →* ℂˣ) * localChar μ 𝔓 = localChar μ 𝔓 :=
      MonoidHom.ext fun x => by simp
    rw [h1, stdRootNumberAt_one, mul_one] at h
    rw [h, norm_zpow, hu, one_zpow]
  · exact norm_stdRootNumberAt_eq_one K 𝔓 _ c hpos hc hu

private theorem norm_finprod_stdRootNumberAt_primeFibre_eq_one (K : Type) [Field K] [NumberField K]
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (hμc : Continuous μ)
    (hμu : AutomorphicForm.IsUnitaryChar (𝓞 K) K μ) (v : HeightOneSpectrum (𝓞 ℚ)) :
    ‖∏ᶠ 𝔓 ∈ primeFibre ℚ K v, stdRootNumberAt K 𝔓 (localChar μ 𝔓)‖ = 1 := by
  obtain rfl := LanglandsTunnell.CubicInduction.RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hF : (primeFibre ℚ K v).Finite := LanglandsTunnell.CubicInduction.FibreDegree.primeFibre_finite K v
  rw [finprod_mem_eq_finite_toFinset_prod _ hF, norm_prod]
  exact Finset.prod_eq_one fun 𝔓 _ => norm_stdRootNumberAt_localChar_eq_one K μ hμc hμu 𝔓

private theorem norm_prod_lambdaArch_eq_one (K : Type) [Field K] [NumberField K] :
    ‖∏ w : InfinitePlace K, LanglandsTunnell.CubicLambda.lambdaArch K w‖ = 1 := by
  rw [norm_prod]
  refine Finset.prod_eq_one fun w _ => ?_
  unfold LanglandsTunnell.CubicLambda.lambdaArch
  split_ifs <;> simp

end LanglandsTunnell.CubicInduction.ThetaUnit
