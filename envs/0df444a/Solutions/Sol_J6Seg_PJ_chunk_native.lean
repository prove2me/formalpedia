/-!
# B-line IL, pre-tables (B5′), part 29: size facts of the chunk-store output

For `T = tabsT (tabQ2 P R s t λ α pk b) nc` (the list `chunkStore2_sp` builds):

* `tabsT_tabQ2_length`: `|T| ≤ nc · (9 + 10 λ)`;
* `tabsT_tabQ2_bnd`: `NLogN.Bnd (BW A + P + pk + b + 2) T` (under `TabB … A`, `λ ≤ 2^A`, `2 ≤ A`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL J6Seg

theorem tabQ2_length {P R sN tN lam aN pk b : ℕ} (hl : 1 ≤ lam) (q : ℕ) :
    (tabQ2 P R sN tN lam aN pk b q).length ≤ 8 + 10 * lam := by
  simp only [tabQ2, KR.tabK2, List.length_append, List.length_cons, List.length_nil,
    List.length_reverse, diL, giL, gamL, ddL, List.length_map, List.length_range]
  set ds := J6Seg.descsOf sN tN lam (mkTables P R sN tN aN) q
  have hlen := dsEnc2_length b ds (fun d hd => by
    obtain ⟨_, h2, h3, _⟩ := J6Seg.KR.descsOf_ok hl _ q d hd; exact ⟨h2, h3⟩)
  have hdl : ds.length ≤ lam := by
    simp only [ds, J6Seg.descsOf, J6Seg.chunkBl, List.length_map]
    exact blFrom_len sN tN lam _ lam _
  have hds : J6Seg.KR.sumN ds ≤ lam := J6Seg.KR.sumN_descsOf hl _ _
  omega

/-- **The length of the chunk tables.** -/
theorem tabsT_tabQ2_length {P R sN tN lam aN pk b : ℕ} (hl : 1 ≤ lam) (nc : ℕ) :
    (tabsT (tabQ2 P R sN tN lam aN pk b) nc).length ≤ nc * (9 + 10 * lam) := by
  unfold tabsT
  induction nc with
  | zero => simp
  | succ n ih =>
    rw [List.range_succ, List.flatMap_append, List.length_append]
    have h1 : (([n] : List ℕ).flatMap (segT (tabQ2 P R sN tN lam aN pk b))).length ≤ 9 + 10 * lam := by
      simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil, segT, List.length_cons]
      have := tabQ2_length (P := P) (R := R) (sN := sN) (tN := tN) (aN := aN) (pk := pk) (b := b) hl n
      omega
    rw [Nat.succ_mul]; omega

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegTabBnd3
/-!
# Chunk-table sizes 3: the bounds in the form the chunk-table IL (B5) consumes

`PreT.TabB P R s t α λ A` (J6SegILPre12) at `A = P + R + 2`: generic (`tabB_of`) and on every
round-six axis (`tabB6_all`, `P = Q6`, `R = R6`, `λ = lamP d`).
-/

open Finset Real

namespace J6Seg.TabBnd
open IntMul IntMul.HvdH IntMul.HvdH.JPf J6QLU J6Seg IntMul.Kappa.R6

theorem tabB_of {P R s t α lam : ℕ} (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hP : 1 ≤ P)
    (hl : 1 ≤ lam) (hPl : 200 * (3 * (lam : ℝ) + 1) ≤ 2 ^ P)
    (hR : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ R) :
    PreT.TabB P R s t α lam (P + R + 2) := by
  have H := tab_bnd (R := R) hs hst hα hP hl hPl hR
  exact ⟨fun j => expNeg_le hs j, fun k hk => (H k hk).1, fun k hk => (H k hk).2.2.2.1,
    fun k hk => gam_le hs hst hα hP hPl hk, fun k hk => (H k hk).2.1,
    fun c k hk => ((H k hk).2.2.2.2 c).1, fun c k hk => ((H k hk).2.2.2.2 c).2⟩

/-- **`TabB` on every round-six axis**, at `A = Q + R + 2`. -/
theorem tabB6_all (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D,
    PreT.TabB (Q6 (pP6 P n) (dP6 P n) (src k)) (R6 (pP6 P n)) (src k) (tF6 P n k) (αN6 P n)
      (lamP (dP6 P n)) (Q6 (pP6 P n) (dP6 P n) (src k) + R6 (pP6 P n) + 2) := by
  obtain ⟨n₁, hR⟩ := r6_segReg P hP
  refine ⟨n₁, fun n hn src hsrc D hD k hk => ?_⟩
  have h := hR n hn src hsrc k (by omega)
  have hQ1 : 1 ≤ Q6 (pP6 P n) (dP6 P n) (src k) := by unfold Q6 segPF; omega
  have hPl : 200 * (3 * (lamP (dP6 P n) : ℝ) + 1) ≤ 2 ^ Q6 (pP6 P n) (dP6 P n) (src k) := by
    have := lam_P_le (pP6 P n) (dP6 P n) (src k)
    have h' : ((200 * (3 * lamP (dP6 P n) + 1) : ℕ) : ℝ) ≤
        ((2 ^ segPF (pP6 P n) (dP6 P n) (src k) : ℕ) : ℝ) := by exact_mod_cast this.le
    push_cast at h'; exact h'
  exact tabB_of h.hs h.hst h.hα hQ1 h.hl hPl h.hR

end J6Seg.TabBnd

