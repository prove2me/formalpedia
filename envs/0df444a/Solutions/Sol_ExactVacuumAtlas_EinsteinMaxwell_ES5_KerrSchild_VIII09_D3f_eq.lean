theorem solution (j : ℝ) {R : ℝ} (hR : 3 < R) :
    D3f j R = deriv (zA j) R * (P R * deriv (b1f j) R) + zA j R * D1f j R
      + (Lmag (c3f j) R + Vfun R * c3f j R) := by
  have hP : DifferentiableAt ℝ (fun s : ℝ => P s) R := diffAt_m0_three hR
  have hz : DifferentiableAt ℝ (zA j) R := diffAt_zA_Ioi j hR
  have hb : DifferentiableAt ℝ (deriv (b1f j)) R := diffAt_deriv_b1f j hR
  have hc : DifferentiableAt ℝ (deriv (c3f j)) R := diffAt_deriv_c3f j hR
  have hA1 : HasDerivAt (fun s => zA j s * (P s * deriv (b1f j) s))
      (deriv (zA j) R * (P R * deriv (b1f j) R)
        + zA j R * deriv (fun s => P s * deriv (b1f j) s) R) R := by
    have h := hz.hasDerivAt.mul (hP.mul hb).hasDerivAt
    convert h using 1 <;> first | rfl | (funext y; simp [Pi.mul_apply, Pi.add_apply])
  have hB1 : HasDerivAt (fun s => P s * deriv (c3f j) s)
      (deriv (fun s => P s * deriv (c3f j) s) R) R := (hP.mul hc).hasDerivAt
  have htot : HasDerivAt (fun s => zA j s * (P s * deriv (b1f j) s) + P s * deriv (c3f j) s)
      (deriv (zA j) R * (P R * deriv (b1f j) R)
        + zA j R * deriv (fun s => P s * deriv (b1f j) s) R
        + deriv (fun s => P s * deriv (c3f j) s) R) R := by
    have h := hA1.add hB1
    convert h using 1 <;> first | rfl | (funext y; simp [Pi.mul_apply, Pi.add_apply])
  have hstep1 : (fun s : ℝ => m0 3 1 s * (zA j s * deriv (b1f j) s + deriv (c3f j) s))
      =ᶠ[𝓝 R] fun s => zA j s * (P s * deriv (b1f j) s) + P s * deriv (c3f j) s := by
    filter_upwards with s
    unfold m0 P
    ring
  rw [show D3f j R = deriv (fun s : ℝ => m0 3 1 s * (zA j s * deriv (b1f j) s + deriv (c3f j) s)) R from rfl]
  rw [hstep1.deriv_eq, htot.deriv]
  have hD1 : deriv (fun s => P s * deriv (b1f j) s) R = D1f j R := rfl
  have hL : deriv (fun s => P s * deriv (c3f j) s) R = Lmag (c3f j) R + Vfun R * c3f j R := by
    unfold Lmag
    ring
  rw [hD1, hL]
