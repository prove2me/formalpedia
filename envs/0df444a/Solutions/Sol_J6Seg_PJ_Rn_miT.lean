        (by rw [q1 3 (by decide) (by decide), h3]) (by rw [q1 7 (by decide) (by decide), h7])
        (by rw [q1 26 (by decide) (by decide), h26]) hca hua) (by omega)
  obtain ⟨w2, hw2⟩ : ∃ w2 : Vr, w2 = update (update w1 29 ((lam - 1 - tv : ℕ) : ℤ)) 5
      ((D SGI).getD (lam - 1 - tv) 0) := ⟨_, rfl⟩
  have q2 : ∀ j : Fin HS, j ≠ 29 → j ≠ 4 → j ≠ 5 → w2 j = u j := fun j a b c' => by
    rw [hw2, update_of_ne c', update_of_ne a, q1 j a b]
  have e3 : (fmE (fmE (.r 4) (.r 5)) (fmE (.r 8) (.k 1))).den w2 =
