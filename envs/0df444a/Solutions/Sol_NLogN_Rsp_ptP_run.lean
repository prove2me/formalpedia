    (hU : τ.G NLogN.Rsp.CU = NLogN.gints V ++ RU) (h1 : ∃ L, τ.G 1 = .int (t : ℤ) :: L)
    (h2 : ∃ L, τ.G 2 = .int (kb : ℤ) :: L) (h3 : ∃ R, τ.G 3 = NLogN.natInts (NLogN.Rsp.ptKeys s t) ++ R) (B : ℕ)
    (hB : ∀ z ∈ V, NLogN.zsz z.1 ≤ B ∧ NLogN.zsz z.2 ≤ B) :
    NLogN.Rsp.ptP.ok τ ∧ NLogN.Rsp.ptP.run τ = τ.upd NLogN.Rsp.CU (NLogN.gints (NLogN.Rsp.ptL s t V) ++ RU) ∧
      NLogN.Rsp.ptP.cost τ ≤ 10 ^ 6 * (kb + 1) * (t + 1) * (2 + 1) * (B + kb + 2 + 4) := by
  obtain ⟨L1, h1⟩ := h1; obtain ⟨L2, h2⟩ := h2; obtain ⟨R3, h3⟩ := h3
  obtain ⟨e0, e1, e2, e3⟩ := NLogN.Rsp.σt_vals
  have hK := (NLogN.Rsp.ptKeys_spec s t ht hco []).1
  rw [NLogN.Rsp.ptKeys_length] at hK
  have h := NLogN.Rsp.permR_spec NLogN.Rsp.σt NLogN.Rsp.σt_fix 2 t kb B (NLogN.Rsp.ptKeys s t) (V.map NLogN.Rsp.gRec) RU R3 τ (NLogN.Rsp.ptKeys_length s t) hK
    (by simp [hV]) (NLogN.Rsp.gRecs_w V) hkb L1 L2 (by rw [e0, hU, NLogN.Rsp.gints_recs])
    (by rw [e1, h1]) (by rw [e2, h2]) (by rw [e3, h3])
    (by intro r hr x hx; simp only [List.mem_map] at hr; obtain ⟨z, hz, rfl⟩ := hr
        simp only [NLogN.Rsp.gRec, List.mem_cons, List.not_mem_nil, or_false] at hx
        rcases hx with rfl | rfl
        · exact (hB z hz).1
        · exact (hB z hz).2)
  unfold NLogN.Rsp.ptP
