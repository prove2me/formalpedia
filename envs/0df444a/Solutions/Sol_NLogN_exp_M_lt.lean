    rw [Int.abs_eq_natAbs]; linarith
  have hy : |y| + 1 ≤ 2 ^ m := by
    have h := NLogN.natAbs_lt_zsz y
    have : (2 : ℤ) ^ NLogN.zsz y ≤ 2 ^ m := pow_le_pow_right₀ (by norm_num) (by omega)
    have h' : (y.natAbs : ℤ) < 2 ^ NLogN.zsz y := by exact_mod_cast h
    rw [Int.abs_eq_natAbs]; linarith
  have hp : (1 : ℤ) ≤ 2 ^ (n + 9) := one_le_pow₀ (by norm_num)
  have hW : |x * 2 ^ (n + 9)| + |y * 2 ^ (n + 9)| + 1 ≤ 2 ^ E := by
    have e : (2 : ℤ) ^ E = 2 ^ m * 2 ^ (n + 9) * 2 := by
      show (2 : ℤ) ^ (m + n + 10) = _
      rw [show m + n + 10 = m + (n + 9) + 1 by omega, pow_succ, pow_add]
    rw [abs_mul, abs_mul, abs_of_pos (show (0 : ℤ) < 2 ^ (n + 9) by positivity), e]
    generalize (2 : ℤ) ^ (n + 9) = p at *
    generalize (2 : ℤ) ^ m = q at *
    nlinarith [abs_nonneg x, abs_nonneg y]
  have hW0 : (0 : ℤ) ≤ |x * 2 ^ (n + 9)| + |y * 2 ^ (n + 9)| + 1 := by positivity
  have hWK := pow_le_pow_left₀ hW0 hW K
  have hK : ((K : ℕ) + 1 : ℤ) ≤ 2 ^ K := by
