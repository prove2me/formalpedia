open Complex Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.Res IntMul.HvdH.P47
/-! ### Fitted parameters (cost row `d p^δ`): `λ = d k`, `w = 7k`, `k = ⌊√d⌋ + 1`, `R = ⌊p/7⌋` -/

lemma lamP_le (d : ℕ) (hd : 1 ≤ d) : lamP d ≤ lamF d := by
  unfold lamP
  have : 1 ≤ lamF d := by unfold lamF kF; nlinarith
  exact Nat.pow_log_le_self 2 (by omega)

lemma lamP_pos (d : ℕ) : 1 ≤ lamP d := Nat.one_le_two_pow

lemma kF_sq (d : ℕ) (hd : 1 ≤ d) : d < kF d ^ 2 ∧ kF d ^ 2 ≤ 4 * d := by
  have h1 := Nat.lt_succ_sqrt d
  have h2 : 1 ≤ Nat.sqrt d := Nat.le_sqrt.2 (by omega)
  have h3 := Nat.sqrt_le' d
  unfold kF
  constructor
  · nlinarith
  · nlinarith

