    have h1 := List.forall₂_take a.length h
    have h2 := List.forall₂_drop a.length h
    rw [List.take_left' rfl, List.take_left' ha.symm] at h1
    rw [List.drop_left' rfl, List.drop_left' ha.symm] at h2
    exact ⟨h1, h2⟩
