  rw [Finset.disjoint_left]
  intro d hd0 hd1
  simp only [initialOddDivisors, laterOddDivisors,
    Finset.mem_filter] at hd0 hd1
  omega
theorem firstTail_disjoint_later (M q : ℕ) :
