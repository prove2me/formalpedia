theorem rdS_sp (s : IState HS) (F : Fin HS → List ℤ) (z : List ℤ) (a : ℤ) (rest : List ℤ)
    (v : Fin 19 → List ℤ) (i : Fin 19) (hv : v i = []) (B : ℕ) (ha : zsz a ≤ B) :
    Sp (rdS σ dS i) (encK s (SS σ dS F z (a :: rest) v))
      (encK s (SS σ dS F z rest (update v i [a]))) (4000 * (B + 2) + (2 * B + 2)) := by
  have hS : SS σ dS F z (a :: rest) v dS = a :: rest := SS_atS hW ..
  have S1 := Sp.push s (SS σ dS F z (a :: rest) v) (i := σ i) (e := .reg dS) (B := B) (hW.lt i)
    (clean_reg hW.Slt) (ok_reg hS) trivial (bnd_reg hS ha)
  rw [eval_reg hS, SS_at hW, hv, SS_v hW] at S1
  have S2 := Sp.pop s (SS σ dS F z (a :: rest) (update v i [a])) (i := dS) (a := a) (l := rest)
    (B := B) hW.Slt (SS_atS hW ..) ha
  rw [SS_ds hW] at S2
  exact (S1.seq S2).mono (by simp only [Ex.size]; omega)

