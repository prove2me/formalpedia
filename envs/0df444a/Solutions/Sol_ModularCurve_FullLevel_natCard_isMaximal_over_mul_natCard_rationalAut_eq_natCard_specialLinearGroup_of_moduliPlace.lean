theorem card_mul_card_eq {G : Type*} [Group G] {B : Type*} [MulAction G B]
    (hfree : ∀ (g : G) (b : B), g • b = b → g = 1) {X : Type*} (ψ : X → B)
    (hinj : ∀ (y y' : X) (g : G), g • ψ y = ψ y' → y = y')
    (hsurj : ∀ b : B, ∃ (y : X) (g : G), g • ψ y = b) :
    Nat.card X * Nat.card G = Nat.card B := by
  let F : X × G → B := fun p => p.2 • ψ p.1
  have hF : Function.Bijective F := by
    constructor
    · rintro ⟨y, g⟩ ⟨y', g'⟩ h
      change g • ψ y = g' • ψ y' at h
      have h1 : (g'⁻¹ * g) • ψ y = ψ y' := by rw [mul_smul, h, inv_smul_smul]
      have hy : y = y' := hinj y y' _ h1
      subst hy
      have hg : g'⁻¹ * g = 1 := hfree _ _ h1
      have : g = g' := by
        have := congrArg (fun t => g' * t) hg
        simpa using this
      rw [this]
    · intro b
      obtain ⟨y, g, h⟩ := hsurj b
      exact ⟨(y, g), h⟩
  rw [← Nat.card_prod]
  exact Nat.card_congr (Equiv.ofBijective F hF)

