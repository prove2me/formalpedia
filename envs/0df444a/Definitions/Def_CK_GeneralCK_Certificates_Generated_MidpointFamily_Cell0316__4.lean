      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(47/20000:ℝ)^2/24 < 2*(469/2000:ℝ)/(1-(469/2000:ℝ)^2)^2)
