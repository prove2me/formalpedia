    · exact h

theorem gsNE_regs (Aw p m : ℕ) (x : NE) : ∀ i ∈ (gsNE Aw p m x).regs, i ∈ x.regs := by
  intro i hi
  have : i ∈ x.regs ∨ i ∈ (powNE (NE.add x (.lit 1)) p).regs := by
    simp [gsNE, NE.regs] at hi; tauto
  rcases this with h | h
