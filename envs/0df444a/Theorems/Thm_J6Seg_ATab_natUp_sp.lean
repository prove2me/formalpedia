    (Zn : Fin HS) (oN : Fin 19 → Fin HS) (hinj : Injective oN)
    (hO : ∀ i, (oN i).val < 31 ∨ (oN i).val = 55) (hZ : Zn.val = 49 ∨ Zn.val = 55)
    (hZo : ∀ i, oN i ≠ Zn)
    (hdL : ∀ x ∈ J6A.PA.dL k pre post s t p α d, |x| < 2 ^ W) (hp1 : 1 ≤ p) (hα1 : 1 ≤ α)
    (hmW : sWidth p α + 4 ≤ W) (hP : PBnd W p t α pkA pkC bA bC) (hA : ABnd W p s t α)
    (hrW : 2 * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α) < 2 ^ W)
    (hdB : Bnd B (J6A.PA.dL k pre post s t p α d)) (h8 : zsz 8 ≤ B)
    (hvB : ∀ a ∈ vsA (p + 2) (pkA * p + pkC + 1) (Nat.log 2 (sWidth p α) + 3) pre (ncA p t α)
      post, zsz a ≤ B)
    (hlB : zsz ((tabA p s t α (pkA * p + pkC) (bA * p + bC)).length : ℤ) ≤ B)
    (hTB : Bnd B (tabA p s t α (pkA * p + pkC) (bA * p + bC))) :
