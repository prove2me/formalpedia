-- ===== S4.Def_RP_EtPBC_A_O2L5b =====
section

/-!
# S4-EtPBC-A, L5b (Geo2): the graph-open `D̃ ⊆ W ×_P Z` and its fibre lemma

Generic setting: `i : S ⟶ P` a closed immersion with a retraction `g` (`i ≫ g = 𝟙`), `W : P.Etale`.
* `Vs = W ×_P S` (`etPull i`), `Zs = Vs ×_S P` (`etPull g`), `Es = W ×_P Zs` (`prd`);
* `jz : Vs ⟶ Zs` (`v ↦ (v, i v)`), `τz : Vs ⟶ Es` (`v ↦ (w v, jz v)`), `δz : Vs ⟶ Es ×_P S` (an open immersion:
  an etale section of `rz`, `δz_rz`);
* `Og Q = (κ '' (range δz)ᶜ)ᶜ ∩ Es⁻¹ Q` (`κ = pullback.fst _ i`, a closed immersion), `Dg = opn Es Og`,
  `wg : Dg ⟶ Zs`;
* **`fl_graph`**: at `x̄` with `x̄ = (x̄ ≫ g) ≫ i`, a point `d` of `Es` off `κ '' (range δz)ᶜ` is `τz` of its `Zs`-part;
* **`graph_unique`**, **`graph_exists`** (`x ∈ Q`): `wg` is bijective on fibres over such `x̄`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact.Cech
  RamanujanPetersson.EtPBC.GenGeo

universe u

section Graph

variable {P S : Scheme.{u}} (i : S ⟶ P) (g : P ⟶ S) (W : P.Etale)

variable {i g} (hig : i ≫ g = 𝟙 S)

variable (i g) in
theorem rz_fst : (rz i g W).left ≫ pullback.fst W.hom i = pullback.fst (Es i g W).hom i ≫ (prW W (Zs i g W)).left :=
  pullback.lift_fst _ _ _

variable (i g) in
theorem rz_snd : (rz i g W).left ≫ pullback.snd W.hom i = pullback.snd (Es i g W).hom i := pullback.lift_snd _ _ _

theorem δz_rz : (δz W hig).left ≫ (rz i g W).left = 𝟙 _ := by
  apply pullback.hom_ext
  · exact (Category.assoc _ _ _).trans ((whisker_eq _ (rz_fst i g W)).trans ((Category.assoc _ _ _).symm.trans
      ((eq_whisker (δz_fst W hig) _).trans ((τz_fst W hig).trans (Category.id_comp _).symm))))
  · exact (Category.assoc _ _ _).trans ((whisker_eq _ (rz_snd i g W)).trans
      ((δz_snd W hig).trans (Category.id_comp _).symm))

instance isOpenImmersion_δz : IsOpenImmersion (δz W hig).left := by
  have : Mono (δz W hig).left := mono_of_mono_fac (δz_rz W hig)
  exact IsOpenImmersion.of_flat_of_mono _

variable [IsClosedImmersion i]

theorem isClosed_Bz : IsClosed (Bz W hig) :=
  (pullback.fst (Es i g W).hom i).isClosedEmbedding.isClosedMap _
    (δz W hig).left.isOpenEmbedding.isOpen_range.isClosed_compl

omit [IsClosedImmersion i] in
/-- **Fibre lemma.** At `x̄ = (x̄ ≫ g) ≫ i`, a point of `Es` off the bad set is `τz` of its `Zs`-component. -/
theorem fl_graph (x : P) (hx : (geomPtAt x).pt = ((geomPtAt x).pt ≫ g) ≫ i)
    (d : (geomPtAt x).point.fiber.obj (Es i g W)) (hd : fpt x d ∉ Bz W hig) :
    fl x d = (fl x ((geomPtAt x).point.fiber.map (prT W (Zs i g W)) d) ≫ pullback.fst (Vs i W).hom g) ≫
      τz W hig := by
  have hd0 : fl x d ≫ (Es i g W).hom = ((geomPtAt x).pt ≫ g) ≫ i := (Over.w ((geomPtAt x).liftOf d)).trans hx
  have hr : Set.range (pullback.lift (fl x d) ((geomPtAt x).pt ≫ g) hd0) ⊆ Set.range (δz W hig).left := by
    rintro _ ⟨y, rfl⟩
    by_contra hy
    apply hd
    refine ⟨_, hy, ?_⟩
    exact (Scheme.Hom.comp_apply _ _ _).symm.trans ((congrArg (fun f => f y)
      (pullback.lift_fst (fl x d) ((geomPtAt x).pt ≫ g) hd0)).trans (congrArg (fl x d) (spec_pt_eq _ _)))
  obtain ⟨e', he'⟩ : ∃ e', e' ≫ (δz W hig).left = pullback.lift (fl x d) ((geomPtAt x).pt ≫ g) hd0 :=
    ⟨_, IsOpenImmersion.lift_fac (δz W hig).left _ hr⟩
  have h1 : fl x d = e' ≫ τz W hig :=
    (pullback.lift_fst (fl x d) ((geomPtAt x).pt ≫ g) hd0).symm.trans ((eq_whisker he'.symm _).trans
      ((Category.assoc _ _ _).trans (whisker_eq _ (δz_fst W hig))))
  have h2 : fl x ((geomPtAt x).point.fiber.map (prT W (Zs i g W)) d) = e' ≫ jz W hig := by
    change fl x d ≫ pullback.snd W.hom (Zs i g W).hom = _
    exact (eq_whisker h1 _).trans ((Category.assoc _ _ _).trans (whisker_eq _ (τz_snd W hig)))
  exact h1.trans (eq_whisker (((eq_whisker h2 _).trans ((Category.assoc _ _ _).trans
    ((whisker_eq _ (jz_fst W hig)).trans (Category.comp_id _)))).symm) _)

end Graph

end RamanujanPetersson.EtPBC.EtMV

end

