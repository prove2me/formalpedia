-- Source module: Solutions.J6SegKr4
/-!
# B3 (chunk kernel), part 4: the Toeplitz stage

`tsI pM IN OUTS`: with `n` on `bN`, `2n` on `bN2`, a Gaussian block `t` (reversed, `gflat t.reverse`)
on `IN`, the real table `am` (length `n`) on top of the table stack `dT`, and the record-product
parameters for records of length `r = 2n` on the parameter stacks `50 … 55` (managed), it leaves
`gflat (lwG P (2n) am t)` on `OUTS`, consumes `am` from `dT` onto the stack `DU` of consumed
descriptors, and uses one uniform Kronecker record product (`recU`, `Δ = 0`).

The parameter stacks are managed lists here; around `recU` they are moved into the base state
(`encK_split`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## The register file of the chunk kernel -/

/-- The table stack. -/
abbrev dT : Fin HS := 49
/-- Block length `n` and `2n`. -/
abbrev bN : Fin HS := 37
abbrev bN2 : Fin HS := 38
/-- Consumed descriptors (reversed). -/
abbrev DU : Fin HS := 45
/-- Work stacks. -/
abbrev W1 : Fin HS := 47
abbrev W2 : Fin HS := 48
/-- Loop counter of the register loops (`vL`), pair-move scratch (`vT`), table scratch (`vT2`). -/
abbrev CC : Fin HS := 23
abbrev TP : Fin HS := 18
abbrev TA : Fin HS := 19

/-! ## Moving the parameters into the base state -/

def pmask (F : Fin HS → List ℤ) : Fin HS → List ℤ := fun i => if 50 ≤ i.val ∧ i.val ≤ 55 then F i else []
def rmask (F : Fin HS → List ℤ) : Fin HS → List ℤ := fun i => if 50 ≤ i.val ∧ i.val ≤ 55 then [] else F i

/-! ## Entry bound of a record product -/

/-! ## The stage -/

/-- **The Toeplitz stage.** -/
def tsI (pM : Fin Pp) (IN OUTS : Fin HS) : IStmt HS Pp :=
  .seq (zeroR vX CC bN2).code <|
  .seq (mvP IN vX TP CC bN).code <|
  .seq (zeroR vY CC bN2).code <|
  .seq (dupR dT DU TA CC bN).code <|
  .seq (rgP TA vY CC bN).code <|
  .seq (recU pM) <|
  .seq (dropR vO CC bN2).code <|
  (rdP vO OUTS CC bN).code

/-- Cost of the Toeplitz stage. -/
def cTS (n pk b φ B : ℕ) : ℕ :=
  6 * cMvP (2 * n) B + (n + 1) * 200000 * (B + 2) + 2000 * cRec (2 * n) pk b 0 φ

end J6Seg.KR

end

