def lowerJRectangle : CertRectangle := ⟨1/4,4/5,1/4,4/5⟩
def lowerJPolyChecked (k : Fin 4) : Prop :=
  lowerJPolyCoefficients k = certBernsteinCoefficients (certCrossPolynomial (lowerJPolyHigher k) (lowerJPolyLower k)) lowerJRectangle ∧
  ∀ i j : Fin 3, 0 < certFieldLower (lowerJPolyCoefficients k i j)
noncomputable def lowerJPolyDifference (k : Fin 4) (r s : ℝ) : ℝ :=
  certThresholdVal (lowerJPolyHigher k) r s - certThresholdVal (lowerJPolyLower k) r s
