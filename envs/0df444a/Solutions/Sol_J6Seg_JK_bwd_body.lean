set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

section moves
variable {s : IState HS} {G : Fin HS → List ℤ}

theorem rdT_spec {X : Fin HS} (hX1 : X ≠ dTJ) (hX2 : X ≠ TT) (hX5 : X.val < 56) {x : ℤ}
    {rest : List ℤ} (hT : G dTJ = x :: rest) {B : ℕ} (hx : zsz x ≤ B) :
    Sp (rdT X) (encK s G)
      (encK s (update (update (update G X (x :: G X)) TT (x :: G TT)) dTJ rest))
      (10000 * (B + 2)) := by
  have s1 := Sp.push (s := s) (f := G) (i := X) (e := .reg dTJ) (B := B) hX5
    (RS.clean_of_lt (by decide)) (isInt_encK hT) trivial (by simp only [Ex.Bnd, top_encK hT]; exact hx)
  rw [show (Ex.reg (S := HS) dTJ).eval (encK s G) = x from top_encK hT] at s1
  have g1 : update G X (x :: G X) dTJ = x :: rest := by rw [update_of_ne (Ne.symm hX1), hT]
  have s2 := Sp.push (s := s) (f := update G X (x :: G X)) (i := TT) (e := .reg dTJ) (B := B)
    (by decide) (RS.clean_of_lt (by decide)) (isInt_encK g1) trivial
    (by simp only [Ex.Bnd, top_encK g1]; exact hx)
  rw [show (Ex.reg (S := HS) dTJ).eval (encK s (update G X (x :: G X))) = x from top_encK g1,
    update_of_ne (Ne.symm hX2)] at s2
  have g2 : update (update G X (x :: G X)) TT (x :: G TT) dTJ = x :: rest := by
    rw [update_of_ne (by decide), g1]
  have s3 := Sp.pop (s := s) (f := update (update G X (x :: G X)) TT (x :: G TT)) (i := dTJ)
    (B := B) (by decide) g2 hx
  refine (s1.seq (s2.seq s3)).mono ?_
  simp only [Ex.size]; omega

end moves

