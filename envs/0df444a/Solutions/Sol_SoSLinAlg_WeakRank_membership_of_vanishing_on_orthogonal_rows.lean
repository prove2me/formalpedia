section
open MvPolynomial
noncomputable section
namespace SoSLinAlg.WeakRank.Dev.Leaf.PartM
open SoSLinAlg.WeakRank SoSLinAlg.WeakRank.Dev.Leaf
theorem prod_scale {σ A : Type*} [CommRing A] (w : σ → ℕ) (c : A) (f : σ → A) (s : σ →₀ ℕ) :
    s.prod (fun v k => (c ^ (w v) * f v) ^ k) =
      c ^ (Finsupp.weight w s) * s.prod (fun v k => f v ^ k) := by
  simp only [mul_pow, ← pow_mul]
  rw [Finsupp.prod_mul]
  congr 1
  rw [Finsupp.weight_apply, Finsupp.prod, Finsupp.sum, Finset.prod_pow_eq_pow_sum]
  congr 1
  refine Finset.sum_congr rfl fun v _ => ?_
  rw [smul_eq_mul, mul_comm]

theorem aeval_scale {σ A : Type*} [CommRing A] [Algebra ℝ A] (w : σ → ℕ) (c : A) (f : σ → A)
    (p : MvPolynomial σ ℝ) (e : ℕ) (hp : IsWeightedHomogeneous w p e) :
    aeval (fun v => c ^ (w v) * f v) p = c ^ e * aeval f p := by
  conv_lhs => rw [p.as_sum]
  conv_rhs => rw [p.as_sum]
  rw [map_sum, map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun s hs => ?_
  rw [aeval_monomial, aeval_monomial, prod_scale, hp (mem_support_iff.mp hs)]
  ring

theorem eval_scale {σ : Type*} (w : σ → ℕ) (c : ℝ) (f : σ → ℝ)
    (p : MvPolynomial σ ℝ) (e : ℕ) (hp : IsWeightedHomogeneous w p e) :
    eval (fun v => c ^ (w v) * f v) p = c ^ e * eval f p :=
  aeval_scale (A := ℝ) w c f p e hp

theorem assignment_scale {n r : ℕ} (I : Finset (Fin n)) (X Y : Matrix (Fin n) (Fin r) ℝ) (t : ℝ) :
    assignment (Matrix.of fun i k => if i ∈ I then t * X i k else X i k) Y =
      fun v => t ^ (wx I r v) * assignment X Y v := by
  funext v
  rcases v with ⟨i, k⟩ | ⟨j, k⟩
  · simp only [assignment, Sum.elim_inl, wx, Matrix.of_apply]
    split_ifs <;> simp
  · simp [assignment, wx]

theorem van_comp {n r : ℕ} (I J : Finset (Fin n)) (F : Poly n r) (hF : Van I J F) (e : ℕ) :
    Van I J (weightedHomogeneousComponent (wx I r) e F) := by
  intro X Y hXY
  classical
  set z := assignment X Y
  let a : (Var n r →₀ ℕ) → ℝ := fun s => eval z (monomial s (coeff s F))
  let Q : Polynomial ℝ := ∑ s ∈ F.support, Polynomial.monomial (Finsupp.weight (wx I r) s) (a s)
  have hQ : Q = 0 := by
    apply Polynomial.funext
    intro t
    rw [Polynomial.eval_zero]
    have h := hF (Matrix.of fun i k => if i ∈ I then t * X i k else X i k) Y (by
      intro i hi j hj
      have := hXY i hi j hj
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.of_apply, if_pos hi] at this ⊢
      simp_rw [mul_assoc, ← Finset.mul_sum, this, mul_zero])
    rw [assignment_scale] at h
    conv_lhs at h => rw [F.as_sum]
    rw [map_sum] at h
    rw [← h, Polynomial.eval_finsetSum]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [Polynomial.eval_monomial, eval_scale (wx I r) t _ _ _
      (isWeightedHomogeneous_monomial _ _ _ rfl), mul_comm]
  have hc := congrArg (fun q => Polynomial.coeff q e) hQ
  simp only [Q, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial, Polynomial.coeff_zero] at hc
  rw [weightedHomogeneousComponent_apply, map_sum, Finset.sum_filter, ← hc]
  refine Finset.sum_congr rfl fun s _ => ?_
  split_ifs <;> simp_all [a]

end SoSLinAlg.WeakRank.Dev.Leaf.PartM
end
