namespace StripAssembly
p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open Polynomial
open LanglandsTunnell.LDatum (BoundedOnStrips badFactor)

section

variable {f g : ℂ → ℂ}

private theorem affine_re_mem {u a b : ℝ} (w : ℂ) {s : ℂ} (ha : a ≤ s.re) (hb : s.re ≤ b) :
    min (u * a) (u * b) + w.re ≤ ((u : ℂ) * s + w).re ∧ ((u : ℂ) * s + w).re ≤ max (u * a) (u * b) + w.re := by
  have hre : ((u : ℂ) * s + w).re = u * s.re + w.re := by simp [Complex.mul_re]
  rw [hre]
  rcases le_total 0 u with hu | hu
  · exact ⟨add_le_add ((min_le_left _ _).trans (mul_le_mul_of_nonneg_left ha hu)) le_rfl,
      add_le_add ((mul_le_mul_of_nonneg_left hb hu).trans (le_max_right _ _)) le_rfl⟩
  · exact ⟨add_le_add ((min_le_right _ _).trans (mul_le_mul_of_nonpos_left hb hu)) le_rfl,
      add_le_add ((mul_le_mul_of_nonpos_left ha hu).trans (le_max_left _ _)) le_rfl⟩

private theorem boundedOnStrips_const (c : ℂ) : BoundedOnStrips fun _ => c :=
  fun _ _ => ⟨‖c‖, fun _ _ _ => le_rfl⟩

private theorem boundedOnStrips_add (hf : BoundedOnStrips f) (hg : BoundedOnStrips g) :
    BoundedOnStrips fun s => f s + g s := by
  intro a b
  obtain ⟨C, hC⟩ := hf a b
  obtain ⟨D, hD⟩ := hg a b
  exact ⟨C + D, fun s ha hb => (norm_add_le _ _).trans (add_le_add (hC s ha hb) (hD s ha hb))⟩

private theorem boundedOnStrips_mul (hf : BoundedOnStrips f) (hg : BoundedOnStrips g) :
    BoundedOnStrips fun s => f s * g s := by
  intro a b
  obtain ⟨C, hC⟩ := hf a b
  obtain ⟨D, hD⟩ := hg a b
  exact ⟨C * D, fun s ha hb => (norm_mul_le _ _).trans
    (mul_le_mul (hC s ha hb) (hD s ha hb) (norm_nonneg _) ((norm_nonneg _).trans (hC s ha hb)))⟩

private theorem boundedOnStrips_pow (hf : BoundedOnStrips f) (n : ℕ) : BoundedOnStrips fun s => f s ^ n := by
  induction n with
  | zero => simpa only [pow_zero] using boundedOnStrips_const 1
  | succ n ih => simpa only [pow_succ] using boundedOnStrips_mul ih hf

private theorem boundedOnStrips_finset_prod {ι : Type*} (T : Finset ι) {F : ι → ℂ → ℂ}
    (h : ∀ i ∈ T, BoundedOnStrips (F i)) : BoundedOnStrips fun s => ∏ i ∈ T, F i s := by
  classical
  induction T using Finset.induction_on with
  | empty => simpa only [Finset.prod_empty] using boundedOnStrips_const 1
  | insert i T hi ih =>
    have e : (fun s => ∏ j ∈ insert i T, F j s) = fun s => F i s * ∏ j ∈ T, F j s :=
      funext fun s => Finset.prod_insert hi
    rw [e]
    exact boundedOnStrips_mul (h i (Finset.mem_insert_self i T))
      (ih fun j hj => h j (Finset.mem_insert_of_mem hj))

private theorem boundedOnStrips_polynomial_eval (p : ℂ[X]) (hf : BoundedOnStrips f) :
    BoundedOnStrips fun s => p.eval (f s) := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simpa only [Polynomial.eval_add] using boundedOnStrips_add hp hq
  | monomial n a =>
    simpa only [Polynomial.eval_monomial] using
      boundedOnStrips_mul (boundedOnStrips_const a) (boundedOnStrips_pow hf n)

private theorem boundedOnStrips_comp_affine (hf : BoundedOnStrips f) (u : ℝ) (w : ℂ) :
    BoundedOnStrips fun s => f ((u : ℂ) * s + w) := by
  intro a b
  obtain ⟨C, hC⟩ := hf (min (u * a) (u * b) + w.re) (max (u * a) (u * b) + w.re)
  exact ⟨C, fun s ha hb => hC _ (affine_re_mem w ha hb).1 (affine_re_mem w ha hb).2⟩

private theorem boundedOnStrips_const_cpow {r : ℝ} (hr : 0 < r) (u : ℝ) (w : ℂ) :
    BoundedOnStrips fun s => (r : ℂ) ^ ((u : ℂ) * s + w) := by
  intro a b
  refine ⟨r ^ (min (u * a) (u * b) + w.re) + r ^ (max (u * a) (u * b) + w.re), fun s ha hb => ?_⟩
  obtain ⟨hlo, hhi⟩ := affine_re_mem (u := u) w ha hb
  show ‖(r : ℂ) ^ ((u : ℂ) * s + w)‖ ≤ _
  rw [Complex.norm_cpow_eq_rpow_re_of_pos hr]
  have h0 : ∀ x : ℝ, 0 ≤ r ^ x := fun x => (Real.rpow_pos_of_pos hr x).le
  rcases le_total 1 r with h1 | h1
  · exact (Real.rpow_le_rpow_of_exponent_le h1 hhi).trans (le_add_of_nonneg_left (h0 _))
  · exact (Real.rpow_le_rpow_of_exponent_ge hr h1 hlo).trans (le_add_of_nonneg_right (h0 _))

private theorem boundedOnStrips_natCast_cpow_neg {n : ℕ} (hn : 0 < n) : BoundedOnStrips fun s => (n : ℂ) ^ (-s) := by
  have h := boundedOnStrips_const_cpow (Nat.cast_pos.2 hn : (0 : ℝ) < n) (-1) 0
  refine fun a b => (h a b).imp fun C hC s ha hb => ?_
  have e : ((n : ℝ) : ℂ) ^ (((-1 : ℝ) : ℂ) * s + 0) = (n : ℂ) ^ (-s) := by
    rw [Complex.ofReal_natCast, Complex.ofReal_neg, Complex.ofReal_one, neg_one_mul, add_zero]
  simpa only [e] using hC s ha hb

private theorem boundedOnStrips_badFactor {bad : Multiset (ℕ × ℂ[X])} (h : ∀ x ∈ bad, 0 < x.1) :
    BoundedOnStrips (badFactor bad) := by
  induction bad using Multiset.induction_on with
  | empty =>
    have e : badFactor 0 = fun _ => (1 : ℂ) := funext fun s => by simp [badFactor]
    simpa only [e] using boundedOnStrips_const 1
  | cons x bad ih =>
    have e : badFactor (x ::ₘ bad) = fun s => x.2.eval ((x.1 : ℂ) ^ (-s)) * badFactor bad s :=
      funext fun s => by simp [badFactor, Multiset.map_cons, Multiset.prod_cons]
    rw [e]
    exact boundedOnStrips_mul
      (boundedOnStrips_polynomial_eval x.2 (boundedOnStrips_natCast_cpow_neg (h x (Multiset.mem_cons_self x bad))))
      (ih fun y hy => h y (Multiset.mem_cons_of_mem hy))

end

section

variable {f g : ℂ → ℂ}

private theorem differentiable_finset_prod {ι : Type*} (T : Finset ι) {F : ι → ℂ → ℂ}
    (h : ∀ i ∈ T, Differentiable ℂ (F i)) : Differentiable ℂ fun s => ∏ i ∈ T, F i s := by
  classical
  induction T using Finset.induction_on with
  | empty => simpa only [Finset.prod_empty] using differentiable_const (1 : ℂ)
  | insert i T hi ih =>
    have e : (fun s => ∏ j ∈ insert i T, F j s) = fun s => F i s * ∏ j ∈ T, F j s :=
      funext fun s => Finset.prod_insert hi
    rw [e]
    have h1 := h i (Finset.mem_insert_self i T)
    have h2 := ih fun j hj => h j (Finset.mem_insert_of_mem hj)
    fun_prop

private theorem differentiable_polynomial_eval (p : ℂ[X]) (hf : Differentiable ℂ f) :
    Differentiable ℂ fun s => p.eval (f s) :=
  p.differentiable.comp hf

private theorem differentiable_const_cpow_affine {r : ℝ} (hr : 0 < r) (u : ℝ) (w : ℂ) :
    Differentiable ℂ fun s : ℂ => (r : ℂ) ^ ((u : ℂ) * s + w) :=
  Differentiable.const_cpow (by fun_prop) (Or.inl (Complex.ofReal_ne_zero.2 hr.ne'))

private theorem differentiable_natCast_cpow_neg {n : ℕ} (hn : 0 < n) : Differentiable ℂ fun s : ℂ => (n : ℂ) ^ (-s) :=
  Differentiable.const_cpow (by fun_prop) (Or.inl (Nat.cast_ne_zero.2 hn.ne'))

private theorem differentiable_natCast_cpow_mul {n : ℕ} (hn : 0 < n) (u : ℂ) :
    Differentiable ℂ fun s : ℂ => (n : ℂ) ^ (u * s) :=
  Differentiable.const_cpow (by fun_prop) (Or.inl (Nat.cast_ne_zero.2 hn.ne'))

private theorem differentiable_badFactor {bad : Multiset (ℕ × ℂ[X])} (h : ∀ x ∈ bad, 0 < x.1) :
    Differentiable ℂ (badFactor bad) := by
  induction bad using Multiset.induction_on with
  | empty =>
    have e : badFactor 0 = fun _ => (1 : ℂ) := funext fun s => by simp [badFactor]
    simpa only [e] using differentiable_const (1 : ℂ)
  | cons x bad ih =>
    have e : badFactor (x ::ₘ bad) = fun s => x.2.eval ((x.1 : ℂ) ^ (-s)) * badFactor bad s :=
      funext fun s => by simp [badFactor, Multiset.map_cons, Multiset.prod_cons]
    rw [e]
    exact (differentiable_polynomial_eval x.2
      (differentiable_natCast_cpow_neg (h x (Multiset.mem_cons_self x bad)))).mul
        (ih fun y hy => h y (Multiset.mem_cons_of_mem hy))

private theorem boundedOnStrips_natCast_cpow_mul {n : ℕ} (hn : 0 < n) (u : ℝ) :
    BoundedOnStrips fun s => (n : ℂ) ^ ((u : ℂ) * s) := by
  have h := boundedOnStrips_const_cpow (Nat.cast_pos.2 hn : (0 : ℝ) < n) u 0
  refine fun a b => (h a b).imp fun C hC s ha hb => ?_
  have e : ((n : ℝ) : ℂ) ^ ((u : ℂ) * s + 0) = (n : ℂ) ^ ((u : ℂ) * s) := by rw [Complex.ofReal_natCast, add_zero]
  simpa only [e] using hC s ha hb

end

