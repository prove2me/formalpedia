def qRank (k : Knot) : ℚ := (k.position:ℚ)/1000
def qValue (col : Knot → ℕ) (k : Knot) : ℚ := (col k:ℚ)/1000000
def qSlope (col : Knot → ℕ) (k l : Knot) : ℚ :=
  (qValue col l-qValue col k)/(qRank l-qRank k)
def lineRange (col : Knot → ℕ) (k l : Knot) (i : Bounds) : Bounds :=
  (point (qValue col k)).plus ((point (qSlope col k l)).times (i.minus (point (qRank k))))

theorem qRank_cast (k : Knot) : (qRank k : ℝ)=rank k := by norm_num [qRank,rank]
theorem qValue_cast (col : Knot → ℕ) (k : Knot) : (qValue col k : ℝ)=value col k := by norm_num [qValue,value]
theorem qSlope_cast (col : Knot → ℕ) (k l : Knot) :
    (qSlope col k l : ℝ)=(value col l-value col k)/(rank l-rank k) := by
  simp only [qSlope,Rat.cast_div,Rat.cast_sub,qRank_cast,qValue_cast]


end StableVotingDistortion.PaperMiddle
