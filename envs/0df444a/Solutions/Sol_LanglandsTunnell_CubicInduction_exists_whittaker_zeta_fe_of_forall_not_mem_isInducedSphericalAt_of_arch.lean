private theorem forall_eq_zero_of_prod_one_sub_C_mul_X_pow_eq_one {α : Type*} (s : Finset α) (c : α → ℂ) (f : α → ℕ)
    (hf : ∀ a ∈ s, 1 ≤ f a) (h : (∏ a ∈ s, (C 1 - C (c a) * X ^ f a)) = 1) : ∀ a ∈ s, c a = 0 := by
  have hne : ∀ a ∈ s, (C 1 - C (c a) * X ^ f a : ℂ[X]) ≠ 0 := by
    intro a ha h0
    have hfa : f a ≠ 0 := by have := hf a ha; omega
    have h1 := congrArg (Polynomial.eval 0) h0
    simp only [eval_sub, eval_mul, eval_pow, eval_C, eval_X, zero_pow hfa, mul_zero, sub_zero,
      eval_zero] at h1
    exact one_ne_zero h1
  have hdeg := congrArg Polynomial.natDegree h
  rw [Polynomial.natDegree_prod (f := fun a => C 1 - C (c a) * X ^ f a) (h := hne), natDegree_one] at hdeg
  intro a ha
  by_contra hc
  have hd : (C 1 - C (c a) * X ^ f a : ℂ[X]).natDegree = f a := by
    rw [natDegree_sub_eq_right_of_natDegree_lt] <;> rw [natDegree_C_mul_X_pow (f a) (c a) hc]
    rw [natDegree_C]; have := hf a ha; omega
  have hle : (C 1 - C (c a) * X ^ f a : ℂ[X]).natDegree ≤
      ∑ b ∈ s, (C 1 - C (c b) * X ^ f b : ℂ[X]).natDegree :=
    Finset.single_le_sum (f := fun b => (C 1 - C (c b) * X ^ f b : ℂ[X]).natDegree) (fun _ _ => Nat.zero_le _) ha
  rw [hdeg, hd] at hle
  have := hf a ha; omega

end

