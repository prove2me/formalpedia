-- title:
--   Rectangular affine jet ideal
-- statement:
--   The ideal generated by each coordinate difference from the affine center (1,c), raised to one more than its coordinate cutoff.
-- source:
--   https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Approximation/AdmissibleMatrixGeometry.lean#L41-L44

import Mathlib.Data.Complex.Basic
import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.RingTheory.Ideal.Operations

namespace OAI.PiExponent.LogarithmicJetIdeals

noncomputable def rectangularJetIdeal {m : Nat} (c : Fin m -> Complex)
    (degree : Fin (Nat.succ m) -> Nat) :
    Ideal (MvPolynomial (Fin (Nat.succ m)) Complex) := by
  classical
  exact Ideal.span (Set.range (fun (k : Fin (Nat.succ m)) =>
    ((MvPolynomial.X k : MvPolynomial (Fin (Nat.succ m)) Complex) -
      MvPolynomial.C (Fin.cases (1 : Complex) c k)) ^ Nat.succ (degree k)))

end OAI.PiExponent.LogarithmicJetIdeals


