private theorem galStable
    {M : ℕ} [NeZero M] (lam : ℕ) [Fact lam.Prime] (S : Finset ℕ)
    (O'' : Type) [CommRing O''] [Algebra ℤ_[lam] O'']
    (K : Type) [Field K] [Algebra O'' K]
    (a : ∀ (ℓ : ℕ), ℓ.Prime → ¬ ℓ ∣ M → ℓ ∉ (S : Set ℕ) → K) :
    letI := ModularCurve.heckeModuleBar M
    ∀ [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))]
      (hsmul : ∀ (a : ℤ_[lam]) (x : ModularCurve.TateModule lam (JZero M)) (n : ℕ),
        ((a • x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) n =
          (PadicInt.toZModPow n a).val • (x : ℕ → JZero M) n)
      (TM : ModularCurve.HeckeAlg →+* Module.End O'' (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M)))
      (_hT : ∀ (t : ModularCurve.HeckeAlg) (a : O'') (x : ModularCurve.TateModule lam (JZero M)),
        TM t (a ⊗ₜ[ℤ_[lam]] x) = a ⊗ₜ[ℤ_[lam]] (t • x))
      (E : Submodule K (K ⊗[O''] (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M))))
      (_hEiff : ∀ v : K ⊗[O''] (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M)),
        v ∈ E ↔
          ∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ M) (hℓS : ℓ ∉ ((S : Set ℕ))),
            (TM (ModularCurve.heckeGen ⟨ℓ, hℓ⟩)).baseChange K v = a ℓ hℓ hℓN hℓS • v)
      (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ),
      ∀ w ∈ E, (ρbc hsmul O'' σ).baseChange K w ∈ E := by
  intro _instZ hsmul TM _hT E _hEiff σ w hw
  haveI : SMulCommClass (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) HeckeAlg (JZero M) :=
    smulCommClass_JZero_of_heckeOperatorsCommuteBar M (heckeOperatorsCommuteBar M)
  have hTM : ∀ t, TM t = (heckeEndZp hsmul t).baseChange O'' := TM_eq_baseChange hsmul O'' TM _hT
  rw [_hEiff] at hw ⊢
  intro ℓ hℓ hℓN hℓS
  have h1 := hw ℓ hℓ hℓN hℓS
  have hb : ∀ v, (TM (heckeGen ⟨ℓ, hℓ⟩)).baseChange K v =
      ((heckeEndZp hsmul (heckeGen ⟨ℓ, hℓ⟩)).baseChange O'').baseChange K v :=
    LinearMap.congr_fun (congrArg
      (fun f : Module.End O'' (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M)) => f.baseChange K)
      (hTM (heckeGen ⟨ℓ, hℓ⟩)))
  calc (TM (heckeGen ⟨ℓ, hℓ⟩)).baseChange K ((ρbc hsmul O'' σ).baseChange K w)
      = ((heckeEndZp hsmul (heckeGen ⟨ℓ, hℓ⟩)).baseChange O'').baseChange K
          ((ρbc hsmul O'' σ).baseChange K w) := hb _
    _ = (ρbc hsmul O'' σ).baseChange K
          (((heckeEndZp hsmul (heckeGen ⟨ℓ, hℓ⟩)).baseChange O'').baseChange K w) :=
        baseChange_comm_of_smul_comm hsmul O'' K (heckeGen ⟨ℓ, hℓ⟩) σ w
    _ = (ρbc hsmul O'' σ).baseChange K ((TM (heckeGen ⟨ℓ, hℓ⟩)).baseChange K w) :=
        congrArg ((ρbc hsmul O'' σ).baseChange K) (hb w).symm
    _ = (ρbc hsmul O'' σ).baseChange K (a ℓ hℓ hℓN hℓS • w) :=
        congrArg ((ρbc hsmul O'' σ).baseChange K) h1
    _ = a ℓ hℓ hℓN hℓS • (ρbc hsmul O'' σ).baseChange K w := map_smul _ _ _

private def connSub {M : ℕ} [NeZero M] (lam : ℕ) [Fact lam.Prime] (A : ValuationSubring (AlgebraicClosure ℚ))
    [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))]
    (hsmul : ∀ (a : ℤ_[lam]) (x : ModularCurve.TateModule lam (JZero M)) (n : ℕ),
      ((a • x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) n =
        (PadicInt.toZModPow n a).val • (x : ℕ → JZero M) n) :
    Submodule ℤ_[lam] (ModularCurve.TateModule lam (JZero M)) :=
  tateSub hsmul (fun _ => (reductionModL A M).ker)

private theorem unitConn
    {M : ℕ} [NeZero M] (lam : ℕ) [Fact lam.Prime]
    (O'' : Type) [CommRing O''] [IsDomain O''] [IsDiscreteValuationRing O''] [CharZero O'']
    [Algebra ℤ_[lam] O''] (hmemO : (lam : O'') ∈ IsLocalRing.maximalIdeal O'')
    (K : Type) [Field K] [Algebra O'' K] [IsFractionRing O'' K]
    (u : O'') (hu : IsUnit u) (A : ValuationSubring (AlgebraicClosure ℚ)) :
    ∀ [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))]
      (hsmul : ∀ (a : ℤ_[lam]) (x : ModularCurve.TateModule lam (JZero M)) (n : ℕ),
        ((a • x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) n =
          (PadicInt.toZModPow n a).val • (x : ℕ → JZero M) n)
      (E : Submodule K (K ⊗[O''] (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M))))
      (_hEφ : ∀ e ∈ E, ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O'').baseChange K e =
        algebraMap O'' K u • e)
      (_hEconn : E ≤ Submodule.span K
          ((fun x : ModularCurve.TateModule lam (JZero M) =>
              (1 : K) ⊗ₜ[O''] ((1 : O'') ⊗ₜ[ℤ_[lam]] (x : ModularCurve.TateModule lam (JZero M)))) ''
            {x | ∀ n : ℕ, ModularCurve.reductionModL A M ((x : ℕ → JZero M) n) = 0})),
      E ≤ (((connSub lam A hsmul).map (πT lam hsmul)).baseChange O'').baseChange K := by
  intro _instZ hsmul E _hEφ _hEconn
  have hff := W54.finite_free_tateModule (p := lam) (J := JZero M) hsmul (finite_lamTorsion (M := M) lam)
  haveI : Module.Finite ℤ_[lam] (ModularCurve.TateModule lam (JZero M)) := hff.1
  haveI : Module.Free ℤ_[lam] (ModularCurve.TateModule lam (JZero M)) := hff.2
  have hEC : E ≤ ((connSub lam A hsmul).baseChange O'').baseChange K := by
    refine _hEconn.trans ?_
    rw [Submodule.span_le]
    rintro _ ⟨x, hx, rfl⟩
    refine Submodule.tmul_mem_baseChange_of_mem (1 : K) (Submodule.tmul_mem_baseChange_of_mem (1 : O'') ?_)
    refine (mem_tateSub_iff hsmul _ x).mpr fun n => ?_
    exact AddMonoidHom.mem_ker.mpr (hx n)
  have hnil := nil_baseChange (M := M) lam hsmul O''
  obtain ⟨m₁, hm₁⟩ := hnil
  have hr : algebraMap ℤ_[lam] O'' (lam : ℤ_[lam]) ∈ IsLocalRing.maximalIdeal O'' := by
    rw [map_natCast]; exact hmemO
  have hr0 : algebraMap ℤ_[lam] O'' (lam : ℤ_[lam]) ≠ 0 := by
    rw [map_natCast]; exact Nat.cast_ne_zero.mpr (Fact.out : lam.Prime).ne_zero
  have hπ : ∀ v, (πT lam hsmul).baseChange O'' ((πT lam hsmul).baseChange O'' v) =
      (πT lam hsmul).baseChange O'' v := by
    intro v
    induction v using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul b w => simp only [LinearMap.baseChange_tmul, πT_idem]
    | add v₁ v₂ h₁ h₂ => simp only [map_add, h₁, h₂]
  have hc : ∀ v, (heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O''
        ((πT lam hsmul).baseChange O'' v) =
      (πT lam hsmul).baseChange O'' ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O'' v) := by
    intro v
    induction v using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul b w => simp only [LinearMap.baseChange_tmul, πT_comm]
    | add v₁ v₂ h₁ h₂ => simp only [map_add, h₁, h₂]
  have hle := OrdConnFit.le_map_baseChange (O := O'') (K := K)
    ((πT lam hsmul).baseChange O'') ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O'')
    hπ hc m₁ (algebraMap ℤ_[lam] O'' (lam : ℤ_[lam])) hr hr0 hm₁ u hu ((connSub lam A hsmul).baseChange O'')
    E _hEφ hEC
  exact hle.trans (Submodule.baseChange_mono K
    (OrdConnFit.map_baseChange_le (A := O'') (πT lam hsmul) (connSub lam A hsmul)))

private theorem keyTransport
    {M : ℕ} [NeZero M] (lam : ℕ) [Fact lam.Prime] (hlamM : ¬ lam ∣ M)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime lam)
    [hEn : ∀ i : ℕ, HasEnoughRootsOfUnity (AlgebraicClosure ℚ) (lam ^ i)]
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hσI : σ ∈ A.inertiaSubgroupIn ℚ) :
    ∀ [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))]
      (hsmul : ∀ (a : ℤ_[lam]) (x : ModularCurve.TateModule lam (JZero M)) (n : ℕ),
        ((a • x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) n =
          (PadicInt.toZModPow n a).val • (x : ℕ → JZero M) n)
      (x : ModularCurve.TateModule lam (JZero M)) (_hx : x ∈ (connSub lam A hsmul).map (πT lam hsmul)),
      σ • (x : ℕ → JZero M) =
        ((((cyclotomicCharacter (AlgebraicClosure ℚ) lam σ.toRingEquiv : ℤ_[lam]ˣ) : ℤ_[lam]) • x :
          ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) := by
  intro _instZ hsmul x _hx
  haveI : CharP (IsLocalRing.ResidueField A) lam := charP_residueField_of_liesOverPrime' Fact.out hA
  have hCstab : ∀ y ∈ (reductionModL A M).ker, fT (M := M) lam y ∈ (reductionModL A M).ker := by
    intro y hy
    rw [AddMonoidHom.mem_ker] at hy ⊢
    rw [fT_eq_heckeOperatorBar, reductionModL_heckeOperatorBar M hlamM A hA
      (reductionInputsModL_of_not_dvd M hlamM A hA) y, hy, map_zero]
  have hx' := Submodule.mem_map.mp _hx
  obtain ⟨x₀, hx₀, rfl⟩ := hx'
  funext m
  rw [hsmul _ _ m, Pi.smul_apply]
  have hspec : ∀ τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, ∀ ζ : AlgebraicClosure ℚ,
      ζ ^ (lam ^ m) = 1 →
        τ ζ = ζ ^ (fun τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ =>
          (PadicInt.toZModPow m ((cyclotomicCharacter (AlgebraicClosure ℚ) lam τ.toRingEquiv :
            ℤ_[lam]ˣ) : ℤ_[lam])).val) τ :=
    fun τ ζ hζ => cyclotomicCharacter.spec lam τ.toRingEquiv ζ hζ
  have hred : reductionModL A M (((πT lam hsmul x₀ : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) m) = 0 :=
    AddMonoidHom.mem_ker.mp
      ((mem_tateSub_iff hsmul _ _).mp (πT_mem_tateSub lam hsmul _ hCstab x₀ hx₀) m)
  exact ModularCurve.inertia_smul_eq_nsmul_of_forall_exists_heckeOperatorBar_pow_apply_eq_of_reductionModL_eq_zero
    M lam hlamM A hA m _ hspec _ (fun m' => πT_unit lam hsmul x₀ m m') hred σ hσI

private theorem inertiaScalar
    {M : ℕ} [NeZero M] (lam : ℕ) [Fact lam.Prime] (hlamM : ¬ lam ∣ M)
    (O'' : Type) [CommRing O''] [IsDomain O''] [IsDiscreteValuationRing O''] [CharZero O'']
    [Algebra ℤ_[lam] O''] (hmemO : (lam : O'') ∈ IsLocalRing.maximalIdeal O'')
    (K : Type) [Field K] [Algebra O'' K] [IsFractionRing O'' K]
    (u : O'') (hu : IsUnit u)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime lam)
    [hEn : ∀ i : ℕ, HasEnoughRootsOfUnity (AlgebraicClosure ℚ) (lam ^ i)]
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hσI : σ ∈ A.inertiaSubgroupIn ℚ) :
    ∀ [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))]
      (hsmul : ∀ (a : ℤ_[lam]) (x : ModularCurve.TateModule lam (JZero M)) (n : ℕ),
        ((a • x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) n =
          (PadicInt.toZModPow n a).val • (x : ℕ → JZero M) n)
      (E : Submodule K (K ⊗[O''] (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M))))
      (_hEφ : ∀ e ∈ E, ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O'').baseChange K e =
        algebraMap O'' K u • e)
      (_hEconn : E ≤ Submodule.span K
          ((fun x : ModularCurve.TateModule lam (JZero M) =>
              (1 : K) ⊗ₜ[O''] ((1 : O'') ⊗ₜ[ℤ_[lam]] (x : ModularCurve.TateModule lam (JZero M)))) ''
            {x | ∀ n : ℕ, ModularCurve.reductionModL A M ((x : ℕ → JZero M) n) = 0})),
      ∀ w ∈ E, (ρbc hsmul O'' σ).baseChange K w =
        (algebraMap O'' K (algebraMap ℤ_[lam] O''
          ((cyclotomicCharacter (AlgebraicClosure ℚ) lam σ.toRingEquiv : ℤ_[lam]ˣ) : ℤ_[lam]))) • w := by
  intro _instZ hsmul E _hEφ _hEconn w hw
  exact baseChange_baseChange_eq_smul_of_smul_eq hsmul O'' ((connSub lam A hsmul).map (πT lam hsmul)) K σ _
    (fun x hx => keyTransport lam hlamM A hA σ hσI hsmul x hx)
    (unitConn lam O'' hmemO K u hu A hsmul E _hEφ _hEconn hw)

private theorem detRoad
    {M : ℕ} [NeZero M] (lam : ℕ) [Fact lam.Prime] (hlamM : ¬ lam ∣ M)
    {g : CuspForm (CongruenceSubgroup.Gamma0 M) 2} (hg : g.IsNewform)
    (S : Finset ℕ)
    (chig : CuspForm.heckeAlgebra M 2 (↑S : Set ℕ) →+* ℂ)
    (hchig : ∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓM : ¬ ℓ ∣ M) (hℓS : ℓ ∉ (↑S : Set ℕ)),
      chig (CuspForm.heckeAlgebra.T hℓ hℓM hℓS) = ModularFormClass.qCoeff g ℓ)
    (O'' : Type) [CommRing O''] [IsDomain O''] [IsDiscreteValuationRing O'']
    [IsAdicComplete (IsLocalRing.maximalIdeal O'') O''] [Finite (IsLocalRing.ResidueField O'')]
    [CharZero O''] [Algebra ℤ_[lam] O''] (hmemO : (lam : O'') ∈ IsLocalRing.maximalIdeal O'')
    (K : Type) [Field K] [CharZero K] [Algebra O'' K] [IsFractionRing O'' K]
    (φ : chig.range →+* K) (u : O'') (hu : IsUnit u)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime lam) :
    letI := ModularCurve.heckeModuleBar M
    ∀ [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))]
      (_hsmul : ∀ (a : ℤ_[lam]) (x : ModularCurve.TateModule lam (JZero M)) (n : ℕ),
        ((a • x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) n =
          (PadicInt.toZModPow n a).val • (x : ℕ → JZero M) n)
      (TM : ModularCurve.HeckeAlg →+* Module.End O'' (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M)))
      (_hT : ∀ (t : ModularCurve.HeckeAlg) (a : O'') (x : ModularCurve.TateModule lam (JZero M)),
        TM t (a ⊗ₜ[ℤ_[lam]] x) = a ⊗ₜ[ℤ_[lam]] (t • x))
      (E : Submodule K (K ⊗[O''] (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M))))
      (_hE2 : Module.finrank K E = 2)
      (_hEiff : ∀ v : K ⊗[O''] (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M)),
        v ∈ E ↔
          ∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ M) (hℓS : ℓ ∉ ((S : Set ℕ))),
            (TM (ModularCurve.heckeGen ⟨ℓ, hℓ⟩)).baseChange K v =
              φ (chig.rangeRestrict (CuspForm.heckeAlgebra.T hℓ hℓN hℓS)) • v)
      (_hEu : ∀ e ∈ E, (TM (ModularCurve.heckeGen ⟨lam, Fact.out⟩)).baseChange K e =
        algebraMap O'' K u • e)
      (_hEconn : E ≤ Submodule.span K
          ((fun x : ModularCurve.TateModule lam (JZero M) =>
              (1 : K) ⊗ₜ[O''] ((1 : O'') ⊗ₜ[ℤ_[lam]] (x : ModularCurve.TateModule lam (JZero M)))) ''
            {x | ∀ n : ℕ, ModularCurve.reductionModL A M ((x : ℕ → JZero M) n) = 0})),
    False := by
  intro _instZ hsmul TM _hT E _hE2 _hEiff _hEu _hEconn
  classical
  haveI : Module.Free K E := Module.Free.of_divisionRing K E
  haveI : Module.Finite K E := Module.finite_of_finrank_eq_succ _hE2

  have _hρ : ∀ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (x y : ModularCurve.TateModule lam (JZero M)),
      (y : ℕ → JZero M) = σ • (x : ℕ → JZero M) →
        ∀ b : O'', ρbc hsmul O'' σ (b ⊗ₜ[ℤ_[lam]] x) = b ⊗ₜ[ℤ_[lam]] y :=
    fun σ x y h b => ρbc_tie hsmul O'' σ x y h b

  have hW : ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, ∀ w ∈ E,
      (ρbc hsmul O'' σ).baseChange K w ∈ E :=
    galStable lam S O'' K
      (fun ℓ hℓ hℓN hℓS => φ (chig.rangeRestrict (CuspForm.heckeAlgebra.T hℓ hℓN hℓS)))
      hsmul TM _hT E _hEiff

  have hcont : GaloisActionIsAdicContinuous O'' (ρbc hsmul O'') :=
    adicContinuous_of_levelwise hsmul O'' hmemO
      (W54.tateModule_adicContinuity M lam (W54.jZeroPPowTorsion_factorsThroughFiniteLevel M lam Fact.out))

  have hkill := CuspForm.IsNewform.killedOffLevel_cyclotomicDet_of_eigenPlane_tateModule_jZero hg lam S
    chig hchig O'' K φ hsmul (ρbc hsmul O'') _hρ TM _hT E _hE2 hW
    (fun ℓ hℓ hℓN hℓS w hw => (_hEiff w).mp hw ℓ hℓ hℓN hℓS)
  have hfrob : ∀ (ℓ : ℕ), ℓ.Prime → ¬ ℓ ∣ M → ℓ ∉ insert lam S →
      ∀ B : ValuationSubring (AlgebraicClosure ℚ), B.LiesOverPrime ℓ →
        ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, B.IsFrobeniusAt σ ℓ →
              LinearMap.det (M := ↥E) (((ρbc hsmul O'' σ).baseChange K).restrict (hW σ)) = (ℓ : K) := by
    intro ℓ hℓ hℓN hℓS B hB σ hσ
    have hne : ℓ ≠ lam := fun h => hℓS (h ▸ Finset.mem_insert_self lam S)
    exact hkill.2 ℓ hℓ hne B hB σ hσ

  have hTM : ∀ t, TM t = (heckeEndZp hsmul t).baseChange O'' := TM_eq_baseChange hsmul O'' TM _hT
  have hb : ∀ v, (TM (heckeGen ⟨lam, Fact.out⟩)).baseChange K v =
      ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O'').baseChange K v :=
    LinearMap.congr_fun (congrArg
      (fun f : Module.End O'' (O'' ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M)) => f.baseChange K)
      (hTM (heckeGen ⟨lam, Fact.out⟩)))
  have hEφ : ∀ e ∈ E, ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O'').baseChange K e =
      algebraMap O'' K u • e := fun e he => (hb e).symm.trans (_hEu e he)

  have harmu := exists_inertiaSubgroupIn_rootOfUnity_pow_ne_one lam Fact.out A hA
  obtain ⟨σ, hσI, n, a, hμa, hnot1⟩ := harmu
  rcases n with _ | n'
  · exact hnot1 (by rw [pow_zero]; exact Nat.modEq_one)
  haveI : NeZero (lam ^ (n' + 1)) := ⟨pow_ne_zero _ (Fact.out : lam.Prime).ne_zero⟩
  haveI hEn : ∀ i, HasEnoughRootsOfUnity (AlgebraicClosure ℚ) (lam ^ i) := fun i => by
    haveI : NeZero (lam ^ i) := ⟨pow_ne_zero _ (Fact.out : lam.Prime).ne_zero⟩
    infer_instance
  obtain ⟨c, hcdef⟩ : ∃ c : ℤ_[lam],
      c = ((cyclotomicCharacter (AlgebraicClosure ℚ) lam σ.toRingEquiv : ℤ_[lam]ˣ) :
        ℤ_[lam]) := ⟨_, rfl⟩

  have hsc : ∀ w ∈ E, (ρbc hsmul O'' σ).baseChange K w =
      (algebraMap O'' K (algebraMap ℤ_[lam] O'' c)) • w := by
    rw [hcdef]
    exact inertiaScalar lam hlamM O'' hmemO K u hu A hA σ hσI hsmul E hEφ _hEconn

  obtain ⟨val, hval⟩ : ∃ v : ℕ, v = (PadicInt.toZModPow (n' + 1) c).val := ⟨_, rfl⟩
  have hcong := eigenPlane_det_congruent_cyclotomic_of_frobenius_det lam O'' K hsmul (insert lam S)
    (ρbc hsmul O'') _hρ hcont E _hE2 hW hfrob σ (n' + 1) val
    (fun μ hμ => by
      rw [hval, hcdef]
      exact cyclotomicCharacter.spec lam σ.toRingEquiv μ hμ)
  obtain ⟨d, hdK, hdcong⟩ := hcong

  have hdet2 := det_restrict_eq_sq_of_forall_smul E ((ρbc hsmul O'' σ).baseChange K) (hW σ)
    (algebraMap O'' K (algebraMap ℤ_[lam] O'' c)) hsc _hE2
  have hd : d = (algebraMap ℤ_[lam] O'' c) ^ 2 := by
    apply IsFractionRing.injective O'' K
    rw [hdK, hdet2, map_pow]

  have hcval : algebraMap ℤ_[lam] O'' c - (val : O'') ∈
      Ideal.span {((lam ^ (n' + 1) : ℕ) : O'')} := by
    have hvz : ((val : ℕ) : ZMod (lam ^ (n' + 1))) = PadicInt.toZModPow (n' + 1) c := by
      rw [hval, ZMod.natCast_val, ZMod.cast_id]
    have hker : c - (val : ℤ_[lam]) ∈ Ideal.span {((lam : ℤ_[lam]) ^ (n' + 1))} := by
      rw [← PadicInt.ker_toZModPow (n' + 1), RingHom.mem_ker, map_sub, map_natCast, hvz,
        sub_self]
    rw [Ideal.mem_span_singleton] at hker ⊢
    obtain ⟨t, ht⟩ := hker
    refine ⟨algebraMap ℤ_[lam] O'' t, ?_⟩
    have himg := congrArg (algebraMap ℤ_[lam] O'') ht
    rw [map_sub, map_mul, map_pow, map_natCast, map_natCast] at himg
    rw [Nat.cast_pow]
    exact himg

  have hfinal : ((val ^ 2 : ℕ) : O'') - (val : O'') ∈
      Ideal.span {((lam ^ (n' + 1) : ℕ) : O'')} := by
    have h1 : (algebraMap ℤ_[lam] O'' c) ^ 2 - ((val : O'')) ^ 2 ∈
        Ideal.span {((lam ^ (n' + 1) : ℕ) : O'')} := by
      have hfac : (algebraMap ℤ_[lam] O'' c) ^ 2 - ((val : O'')) ^ 2 =
          (algebraMap ℤ_[lam] O'' c - (val : O'')) *
            (algebraMap ℤ_[lam] O'' c + (val : O'')) := by ring
      rw [hfac]
      exact Ideal.mul_mem_right _ _ hcval
    have h2 : ((val ^ 2 : ℕ) : O'') - (val : O'') =
        -((algebraMap ℤ_[lam] O'' c) ^ 2 - ((val : O'')) ^ 2) + (d - (val : O'')) := by
      rw [hd]; push_cast; ring
    rw [h2]
    exact add_mem (neg_mem h1) hdcong
  have hmod : val ^ 2 ≡ val [MOD lam ^ (n' + 1)] :=
    nat_modEq_of_cast_sub_mem_span hmemO (n' + 1) (val ^ 2) val hfinal

  have hcop : Nat.Coprime val (lam ^ (n' + 1)) := by
    have hu := ZMod.val_coe_unit_coprime
      (Units.map (PadicInt.toZModPow (n' + 1)).toMonoidHom
        (cyclotomicCharacter (AlgebraicClosure ℚ) lam σ.toRingEquiv))
    simpa [hval, hcdef, Units.coe_map] using hu
  have hval1 : val ≡ 1 [MOD lam ^ (n' + 1)] := by
    have hmm : val * val ≡ val * 1 [MOD lam ^ (n' + 1)] := by
      rw [mul_one, ← pow_two]; exact hmod
    exact Nat.ModEq.cancel_left_of_coprime hcop.symm hmm
  have hprim := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure ℚ) (lam ^ (n' + 1))
  obtain ⟨ζ, hζ⟩ := hprim
  have hζpow : ζ ^ lam ^ (n' + 1) = 1 := hζ.pow_eq_one
  have e1 : σ ζ = ζ ^ val := by
    rw [hval, hcdef]
    exact cyclotomicCharacter.spec lam σ.toRingEquiv ζ hζpow
  have e2 : σ ζ = ζ ^ a := hμa ζ hζpow
  have hord : orderOf ζ = lam ^ (n' + 1) := hζ.eq_orderOf.symm
  have hfin : IsOfFinOrder ζ := isOfFinOrder_iff_pow_eq_one.mpr
    ⟨lam ^ (n' + 1), pow_pos (Fact.out : lam.Prime).pos _, hζpow⟩
  have hav : a ≡ val [MOD lam ^ (n' + 1)] := by
    rw [← hord]
    exact hfin.pow_eq_pow_iff_modEq.mp (e2.symm.trans e1)
  exact hnot1 (hav.trans hval1)

private theorem le_of_two_le_finrank
    {K V : Type} [Field K] [AddCommGroup V] [Module K V]
    (U E T : Submodule K V) (hUE : U ≤ E) (hE2 : Module.finrank K E = 2)
    (h2 : 2 ≤ Module.finrank K U) (hUT : U ≤ T) : E ≤ T := by
  haveI : FiniteDimensional K E := Module.finite_of_finrank_eq_succ hE2
  have hUeq : U = E := Submodule.eq_of_le_of_finrank_le hUE (hE2.trans_le h2)
  exact (le_of_eq hUeq.symm).trans hUT

end
