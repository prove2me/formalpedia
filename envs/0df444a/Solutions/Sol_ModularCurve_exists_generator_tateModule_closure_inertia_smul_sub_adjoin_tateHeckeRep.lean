theorem RingHom.exists_forall_pow_eq_one_apply_eq_pow {F : Type*} [CommRing F] [IsDomain F] (σ : F →+* F)
    (m : ℕ) (hm : m ≠ 0) :
    ∃ n : ℕ, ∀ ζ : F, ζ ^ m = 1 → σ ζ = ζ ^ n := by
  haveI : NeZero m := ⟨hm⟩
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := rootsOfUnity m F)

  have hmem : ∀ ζ : F, ζ ^ m = 1 → ∃ j : ℕ, ζ = ((g : Fˣ) : F) ^ j := by
    intro ζ hζ
    let z : rootsOfUnity m F := rootsOfUnity.mkOfPowEq ζ hζ
    obtain ⟨j, hj⟩ := (mem_powers_iff_mem_zpowers (G := rootsOfUnity m F)).mpr (hg z)
    refine ⟨j, ?_⟩
    have := congrArg (fun u : rootsOfUnity m F => ((u : Fˣ) : F)) hj
    simpa [z] using this.symm

  have hgm : ((g : Fˣ) : F) ^ m = 1 := by
    have := g.2
    rw [mem_rootsOfUnity] at this
    rw [← Units.val_pow_eq_pow_val, this, Units.val_one]
  obtain ⟨n, hn⟩ := hmem (σ (g : Fˣ)) (by rw [← map_pow, hgm, map_one])
  refine ⟨n, fun ζ hζ => ?_⟩
  obtain ⟨j, rfl⟩ := hmem ζ hζ
  rw [map_pow, hn, ← pow_mul, ← pow_mul, mul_comm]

