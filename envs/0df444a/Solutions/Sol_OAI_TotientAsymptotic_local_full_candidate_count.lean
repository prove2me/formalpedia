  obtain ⟨hq,hqp⟩ := hhead _ hD hlog _ z.1 hpr hcap z.2 hzq
  exact ⟨z.1,z.2,rfl,hpr,prime_coordinates_strictAnti hpr hr.1.2.1,
    hr,hcap,hzq,hq,hqp,hlog⟩

