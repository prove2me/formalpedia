noncomputable def sumProgram {α : Type} [Coding α] (k : ℕ) {f : α×List ℕ→ℚ}
    (leaf : PolyProgram Automatic.enc Ratio.encode f) :
    PolyProgram (encodePair Automatic.enc _root_.Integration9_9.TM2NativeFiniteSeries.ticksCode) Ratio.encode
      (fun x : α×List Unit => ((_root_.Integration9_9.TM2NativeTupleEnumeration.tuples k (List.range x.2.length)).map (fun word => f (x.1,word))).sum) := by
  let context := PolyProgram.fst (Automatic.enc (α := α)) _root_.Integration9_9.TM2NativeFiniteSeries.ticksCode
  let words := (PolyProgram.snd (Automatic.enc (α := α)) _root_.Integration9_9.TM2NativeFiniteSeries.ticksCode).comp (_root_.Integration9_9.TM2NativeTupleEnumeration.enumerationProgram k)
  exact (((context.fanout words).comp (leaf.listMapWith [] (0 : ℚ))).comp PolyProgram.ratSum)

