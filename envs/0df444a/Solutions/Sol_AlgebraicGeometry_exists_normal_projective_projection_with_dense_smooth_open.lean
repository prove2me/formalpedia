/-- Transport smoothness of a localized algebra to the corresponding dense affine open of an
integral affine chart. -/
lemma exists_dense_affine_smooth_open_of_smooth_localization
    (R A : Type u) [CommRing R] [CommRing A] [IsDomain A] [Algebra R A]
    {X : Scheme.{u}} [IsIntegral X] (e : X ≅ Spec (.of A))
    (b : A) (hb : b ≠ 0) [Algebra.Smooth R (Localization.Away b)] :
    ∃ W : X.Opens, IsAffineOpen W ∧ Nonempty W ∧ Dense (W : Set X) ∧
      Smooth (W.ι ≫ e.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R A))) := by
  classical
  let D : (Spec (.of A)).Opens := PrimeSpectrum.basicOpen b
  let W : X.Opens := e.hom ⁻¹ᵁ D
  let E : (W : Scheme) ≅ Spec (.of (Localization.Away b)) :=
    asIso (e.hom ∣_ D) ≪≫ basicOpenIsoSpecAway (R := .of A) b
  have hE : E.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Localization.Away b))) =
      W.ι ≫ e.hom := by
    dsimp only [E, Iso.trans_hom, asIso_hom]
    rw [Category.assoc, basicOpenIsoSpecAway_hom_SpecMap (R := .of A) b]
    exact morphismRestrict_ι e.hom D
  letI : IsAffine (W : Scheme) := IsAffine.of_isIso E.hom
  have hne : Nonempty W := by
    refine ⟨⟨e.inv (⊥ : PrimeSpectrum A), ?_⟩⟩
    change e.hom (e.inv (⊥ : PrimeSpectrum A)) ∈ D
    rw [Scheme.inv_hom_apply]
    change b ∉ (⊥ : Ideal A)
    simpa only [Ideal.mem_bot] using hb
  letI := hne
  have hdense : Dense (W : Set X) :=
    W.isOpen.dense ⟨(Classical.choice hne).val, (Classical.choice hne).property⟩
  have hmap : CommRingCat.ofHom (algebraMap R A) ≫
      CommRingCat.ofHom (algebraMap A (Localization.Away b)) =
      CommRingCat.ofHom (algebraMap R (Localization.Away b)) := by
    apply CommRingCat.hom_ext
    exact (IsScalarTower.algebraMap_eq R A (Localization.Away b)).symm
  haveI : Smooth (Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away b)))) := by
    apply (HasRingHomProperty.Spec_iff (P := @Smooth)).mpr
    change (algebraMap R (Localization.Away b)).Smooth
    exact RingHom.smooth_algebraMap.mpr inferInstance
  have h : Smooth (E.hom ≫
      Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away b)))) := inferInstance
  rw [← hmap, Spec.map_comp, ← Category.assoc, hE, Category.assoc] at h
  exact ⟨W, inferInstanceAs (IsAffine (W : Scheme)), hne, hdense, h⟩

end PhilipponAlterationProjection



