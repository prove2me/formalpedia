open NLogN
open NLogN.KFU
open IntMul KFC AModel AModelL12
variable {d : ℕ} {sF μ : ℕ → ℕ}
theorem solution (H : NLogN.KFU.CrtOK d sF μ) {b : List ℕ} (hb : AModel.Valid (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) b) :
    NLogN.KFU.kOf d sF μ b < IntMul.OpenAI.RCRT.Ppre sF d ∧ NLogN.KFU.phiAddr d sF μ (NLogN.KFU.kOf d sF μ b) (b.getD d 0) = b := by
  obtain ⟨hl, hlt⟩ := NLogN.KFU.valid_shR_lt hb
  have hb' : ∀ j < d, b.getD j 0 < sF j := fun j hj => by
    have := hlt j (by omega); simpa [NLogN.KFU.fnL, NLogN.KFU.sP, hj] using this
  have hex := NLogN.KFU.cover_take H b hb' (by omega)
  unfold NLogN.KFU.kOf
  rw [dif_pos hex]
  obtain ⟨hk, he⟩ := Classical.choose_spec hex
  refine ⟨hk, ?_⟩
  unfold NLogN.KFU.phiAddr
  rw [he]
  conv_rhs => rw [← List.take_append_drop d b]
  congr 1
  rw [List.drop_eq_getElem_cons (by omega), List.drop_of_length_le (by omega),
    List.getD_eq_getElem _ _ (by omega)]
end
