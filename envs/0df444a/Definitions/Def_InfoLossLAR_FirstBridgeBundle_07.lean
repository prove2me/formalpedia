/-- Unary requests are made by taking existing polynomially many slots. -/
def bundleRequestsFromSlots (slots : List Unit) : List Str :=
  (List.range slots.length).map (fun index => (slots.take index).map (fun _ => true))

@[fun_prop] theorem bundleRequestsFromSlots_poly : Poly _root_.InfoLossLAR.WorstCase.bundleRequestsFromSlots := by
  unfold _root_.InfoLossLAR.WorstCase.bundleRequestsFromSlots
  fun_prop

def bundleRequests (budget : Polynomial ℕ) (input : Str) : List Str :=
  _root_.InfoLossLAR.WorstCase.bundleRequestsFromSlots (List.replicate (budget.eval input.length+1) ())

@[fun_prop] theorem bundleRequests_poly (budget : Polynomial ℕ) : Poly (_root_.InfoLossLAR.WorstCase.bundleRequests budget) := by
  unfold _root_.InfoLossLAR.WorstCase.bundleRequests
  have hs : Poly (fun input : Str => List.replicate ((budget+1).eval input.length) ()) := by
    have h := Poly.comp (_root_.Integration9_9.TM2PolynomialBudget.polynomialSlots_poly (budget+1))
      (show Poly (fun input : Str => input.map (fun _ => ())) by fun_prop)
    simpa only [List.length_map] using h
  have h := Poly.comp _root_.InfoLossLAR.WorstCase.bundleRequestsFromSlots_poly hs
  simpa only [eval_add,eval_one] using h



/-- Keep the input beside an actual opaque stock subroutine result. -/
theorem stock_pairWithInput {α β : Type} {ea : α → Str} {eb : β → Str}
    {f : α → β} (P : TM2ComputableInPolyTime ea eb f) :
    Nonempty (TM2ComputableInPolyTime ea (encodePair ea eb) (fun a => (a,f a))) := by
  obtain ⟨thread⟩ := _root_.Integration9_9.TM2StockThread.thread_polynomial ea P
  let duplicate := (PolyProgram.identity ea).fanout (PolyProgram.identity ea)
  obtain ⟨first⟩ := _root_.Integration9_9.TM2Composition.comp duplicate.stock thread
  obtain ⟨whole⟩ := _root_.Integration9_9.TM2Composition.comp first (PolyProgram.exchange eb ea).stock
  exact ⟨_root_.Integration9_9.TM2StockLists.congrProgram whole _ (fun _ => rfl)⟩

/-- Quote/unquote are real native programs around the original raw stock machine. -/
theorem stock_quoted {f : Str → Str} (P : TM2ComputableInPolyTime id id f) :
    Nonempty (TM2ComputableInPolyTime (encodeList encodeBool) (encodeList encodeBool) f) := by
  obtain ⟨first⟩ := _root_.Integration9_9.TM2Composition.comp BooleanLists.unpackProgram.stock P
  obtain ⟨whole⟩ := _root_.Integration9_9.TM2Composition.comp first BooleanLists.packProgram.stock
  exact ⟨_root_.Integration9_9.TM2StockLists.congrProgram whole _ (fun _ => rfl)⟩

def generatedBundleDescriptions (generator : Str → Str) (budget : Polynomial ℕ) (input : Str) : List (Str × Str) :=
  (_root_.InfoLossLAR.WorstCase.bundleRequests budget input).map (fun request => (request,generator request))

/-- Every original-platform uniform generator can be called on the whole
polynomial list of unary requests by a single genuine stock machine. -/
theorem generatedBundleDescriptions_stock (generator : Str → Str) (h : PolyTimeComputable generator)
    (budget : Polynomial ℕ) :
    Nonempty (TM2ComputableInPolyTime id (encodeList (encodePair (encodeList encodeBool) (encodeList encodeBool)))
      (_root_.InfoLossLAR.WorstCase.generatedBundleDescriptions generator budget)) := by
  obtain ⟨P⟩ := h
  obtain ⟨quoted⟩ := _root_.InfoLossLAR.WorstCase.stock_quoted P
  obtain ⟨paired⟩ := _root_.InfoLossLAR.WorstCase.stock_pairWithInput quoted
  obtain ⟨mapped⟩ := _root_.Integration9_9.TM2StockLists.listMap paired []
  obtain ⟨requests⟩ := _root_.Integration9_9.TM2Composition.comp BooleanLists.packProgram.stock (_root_.InfoLossLAR.WorstCase.bundleRequests_poly budget).program.stock
  obtain ⟨whole⟩ := _root_.Integration9_9.TM2Composition.comp requests mapped
  exact ⟨_root_.Integration9_9.TM2StockLists.congrProgram whole _ (fun _ => rfl)⟩














