-- title:
--   Lemma 16 — descent inequality (80) under Assumption 2
-- statement:
--   Suppose Assumption 2 holds and $(x^k,z^k,y^k)_{k\ge0}$ is generated by Algorithm 1 or Algorithm 2. Then for every $k\ge1$
--   $$\begin{aligned} &L_r(x^{k+1},z^{k+1},y^{k+1}) + 2T_1\|A^*(y^{k+1}-y^k)\|^2 + \tfrac12\|x^{k+1}-x^k\|^2_{M_3^k} + \tfrac12\|z^{k+1}-z^k\|^2_{M_2^k} + \tfrac{1}{\rho r}\|y^{k+1}-y^k\|^2 \\ &\quad\le L_r(x^k,z^k,y^k) + 2T_1\|A^*(y^k - y^{k-1})\|^2 + C_1\|x^k - x^{k-1}\|^2. \end{aligned}\qquad (80)$$
--   Here $M_3^k = 2M_1^k + rA^*A - C_0\,\mathrm{Id}$ and $T_1, C_0, C_1$ are the constants of the setting.
--
--   This is the descent inequality behind the Section 3 regularized augmented Lagrangian: it is the sharpened form, available under Assumption 2, of Lemma 4.
--
--   **Formalization Note** The inequality is in `EReal` (since $g$, hence $L_r$, may take the value $+\infty$), with all real terms moved to the sides where they appear in (80); no subtraction of extended reals occurs. $\|w\|^2_{M_3^k}$ is written $2\langle M_1^kw,w\rangle + r\|Aw\|^2 - C_0\|w\|^2$.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, p. 25, Lemma 16, (80)

import Mathlib
import Definitions.Def_BotNguyenADMM_Rates_Setting
import Definitions.Def_BotNguyenADMM_Rates_Lojasiewicz

open Filter Topology
open scoped InnerProductSpace RealInnerProductSpace
open NonconvexSplitting.Shared

namespace BotNguyenADMM.Rates

/-- **Lemma 16** (Boţ–Nguyen, arXiv:1801.01994v2, p. 25, (80)). Under Assumption 2, for a
sequence generated by Algorithm 1 or Algorithm 2 and every `k ≥ 1`:
`L_r(x^{k+1}, z^{k+1}, y^{k+1}) + 2T₁‖A*(y^{k+1} − yᵏ)‖² + ½‖x^{k+1} − xᵏ‖²_{M₃ᵏ}
 + ½‖z^{k+1} − zᵏ‖²_{M₂ᵏ} + (1/(ρr))‖y^{k+1} − yᵏ‖²
 ≤ L_r(xᵏ, zᵏ, yᵏ) + 2T₁‖A*(yᵏ − y^{k−1})‖² + C₁‖xᵏ − x^{k−1}‖²`. -/
theorem lemma_16
    {n m : ℕ} (v : BotNguyenADMM.KL.Variant) (g : BotNguyenADMM.KL.E m → EReal) (h : BotNguyenADMM.KL.E n → ℝ) (A : BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E m)
    (L r ρ lam μ₁ μ₂ : ℝ) (M₁ : ℕ → BotNguyenADMM.KL.E n →L[ℝ] BotNguyenADMM.KL.E n) (M₂ : ℕ → BotNguyenADMM.KL.E m →L[ℝ] BotNguyenADMM.KL.E m)
    (hA2 : Assumption2 v g h A L r ρ lam μ₁ μ₂ M₁ M₂)
    (x : ℕ → BotNguyenADMM.KL.E n) (z y : ℕ → BotNguyenADMM.KL.E m) (hrun : IsRun v g h A r ρ M₁ M₂ x z y)
    (k : ℕ) (hk : 1 ≤ k) :
    augLag g h A r (x (k + 1)) (z (k + 1)) (y (k + 1)) +
        ((2 * T1 lam ρ r * ‖(ContinuousLinearMap.adjoint A) (y (k + 1) - y k)‖ ^ 2 +
          1 / 2 * normSqM3 v A (M₁ k) L μ₁ lam ρ r (x (k + 1) - x k) +
          1 / 2 * ⟪M₂ k (z (k + 1) - z k), z (k + 1) - z k⟫ +
          1 / (ρ * r) * ‖y (k + 1) - y k‖ ^ 2 : ℝ) : EReal) ≤
      augLag g h A r (x k) (z k) (y k) +
        ((2 * T1 lam ρ r * ‖(ContinuousLinearMap.adjoint A) (y k - y (k - 1))‖ ^ 2 +
          C1 v L μ₁ lam ρ r * ‖x k - x (k - 1)‖ ^ 2 : ℝ) : EReal) := by sorry

end BotNguyenADMM.Rates
