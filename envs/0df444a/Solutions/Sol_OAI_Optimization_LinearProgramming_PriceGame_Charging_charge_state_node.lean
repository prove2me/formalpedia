theorem solution.{u_1} : type_of% @OAI.Optimization.LinearProgramming.PriceGame.Charging.p2m_solution_aux.{u_1} := @OAI.Optimization.LinearProgramming.PriceGame.Charging.p2m_solution_aux.{u_1}
