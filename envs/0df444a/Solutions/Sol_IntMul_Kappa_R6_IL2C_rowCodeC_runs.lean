    · exact o4 kN (by decide) nn3
    · exact ⟨_, by rw [k24]; push_cast; rfl⟩
    · exact ⟨_, by rw [r24]; push_cast; rfl⟩
    · obtain ⟨L, hL⟩ := o4 kM (by decide) m3
