theorem solution (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)]
    [TopologicalSpace O] [IsTopologicalRing O] [CompactSpace O] [T2Space O]
    [SecondCountableTopology O] [MeasurableSpace O] [BorelSpace O]
    (htop : IsAdic (IsLocalRing.maximalIdeal O)) (L : ℕ)
    (g : Fin L → Polynomial (IsLocalRing.ResidueField O)) (hg : ∀ j, (g j).Monic)
    (hc : ∀ i j, i ≠ j → IsCoprime (g i) (g j)) (Dl : Fin L → TypeDensity.Law)
    (hnn : ∀ (j : Fin L) (τ : TypeDensity.FactorType), 0 ≤ (TypeDensity.lawCoeff (Dl j) τ).eval
      (Nat.card (IsLocalRing.ResidueField O)))
    (hlaw : ∀ (j : Fin L) (τ : TypeDensity.FactorType), MeasurableSet
      (TypeDensity.residueCell O (g j).natDegree (g j) ∩ TypeDensity.typeEvent O (g j).natDegree τ) ∧ TypeDensity.cellMeasure O
      (g j).natDegree (TypeDensity.residueCell O (g j).natDegree (g j)) (TypeDensity.typeEvent O (g j).natDegree τ) =
      TypeDensity.densityValue (TypeDensity.lawCoeff (Dl j) τ) (Nat.card (IsLocalRing.ResidueField O))) (σ : TypeDensity.FactorType) :
    MeasurableSet (TypeDensity.residueCell O (∑ j, (g j).natDegree) (∏ j, g j) ∩ TypeDensity.typeEvent O
      (∑ j, (g j).natDegree) σ) ∧ TypeDensity.cellMeasure O (∑ j, (g j).natDegree)
      (TypeDensity.residueCell O (∑ j, (g j).natDegree) (∏ j, g j)) (TypeDensity.typeEvent O (∑ j, (g j).natDegree) σ) =
      TypeDensity.densityValue (TypeDensity.lawCoeff (TypeDensity.lawProd (List.ofFn Dl)) σ)
      (Nat.card (IsLocalRing.ResidueField O)) := by
  let W : Fin L → Finset TypeDensity.FactorType := fun j =>
    (TypeDensity.finite_types_of_degree (g j).natDegree).toFinset ∪ ((Dl j).map Prod.fst).toFinset
  have hW : ∀ j τ, (TypeDensity.residueCell O (g j).natDegree (g j) ∩ TypeDensity.typeEvent O (g j).natDegree τ).Nonempty →
      τ ∈ W j := by
    intro j τ ⟨a, _, ha⟩
    have h1 := TypeDensity.polynomial_type_degree O _ τ ha
    have h2 := (TypeDensity.monic_polynomial_degree O _ a).2
    simp only [W, Finset.mem_union, Set.Finite.mem_toFinset, Set.mem_ofPred_eq]
    exact Or.inl ⟨h1.1, h1.2.trans h2⟩
  have hmeas := fun j τ ↦ (hlaw j τ).1
  have hcell := fun j ↦ TypeDensity.residue_cell_mass O htop _ (g j) (hg j) rfl
  have : ∀ j, MeasureTheory.IsProbabilityMeasure
      (TypeDensity.cellMeasure O _ (TypeDensity.residueCell O (g j).natDegree (g j))) := fun j ↦ (hcell j).2.2
  have hE := TypeDensity.measurableSet_product_cell_typeEvent O htop L g hg hc W hW hmeas σ
  refine ⟨hE, ?_⟩
  rw [← TypeDensity.cellMeasure_cell_inter (TypeDensity.residue_cell_mass O htop _ (∏ j, g j)
      (Polynomial.monic_prod_of_monic _ _ fun j _ ↦ hg j)
      (Polynomial.natDegree_prod_of_monic _ _ fun j _ ↦ hg j)).1,
    TypeDensity.measure_eq_sum_prod_of_preimage _ (TypeDensity.factor_cells_measure_preserving O htop (Fin L) g hg hc) _
      (TypeDensity.factor_cell_product_measure O htop (Fin L) g hg).2.1
      (fun j ↦ TypeDensity.cellMeasure_cell_inter (hcell j).1) _ hmeas
      (fun _ _ _ _ h1 h2 ↦ TypeDensity.polynomial_type_unique O _ _ _ h1 h2) hE _
      (TypeDensity.factorProduct_preimage_typeEvent_eq O L g hg hc W hW σ),
    Finset.sum_congr rfl fun τ _ ↦ Finset.prod_congr rfl fun j _ ↦ (hlaw j (τ j)).2]
  exact TypeDensity.sum_prod_densityValue_eq_lawProd Dl _ hnn W (fun _ ↦ Finset.subset_union_right) σ
