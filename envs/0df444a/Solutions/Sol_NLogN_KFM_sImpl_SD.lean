open NLogN
open NLogN.KFM
open IntMul RS AModel KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly
theorem solution {P K D S ρ r : ℕ} (hρ : ρ < K) (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P) (Z : ℕ)
    (hZ : NLogN.zsz ((16 * (AModel.vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ) ≤ Z) :
    NLogN.KFN.SImpl r (fun i : Fin D => NLogN.KFH.stT K D S ρ i) (AModel.vol (Butterfly.layerShape P K D S))
      (Butterfly.SD : Matrix (Fin D → Fin 2) (Fin D → Fin 2) ℂ) (NLogN.KFM.sdP P K D S ρ r) 0 0
      (fun w => NLogN.KFM.cSD P K D S r Z w) := by
  have hN : AModel.vol (Butterfly.layerShape P K D S) * r = P * (S * r * 2 ^ (K * D)) := by
    rw [NLogN.KFM.vol_layer_eq]; ring
  have hN1 : 1 ≤ P * (S * r * 2 ^ (K * D)) := by
    have : 1 ≤ S * r := Nat.mul_le_mul hS hr
    have : 1 ≤ S * r * 2 ^ (K * D) := Nat.mul_le_mul this (Nat.one_le_two_pow)
    exact Nat.mul_le_mul hP this
  have hSr : S * r ≤ P * (S * r * 2 ^ (K * D)) :=
    (Nat.le_mul_of_pos_right _ (Nat.two_pow_pos _)).trans (Nat.le_mul_of_pos_left _ (by omega))
  have hPN : P ≤ P * (S * r * 2 ^ (K * D)) := Nat.le_mul_of_pos_right _ (by positivity)
  have hZ' : NLogN.zsz ((4 * (P * (S * r * 2 ^ (K * D)) + S * r + P + 1) : ℕ) : ℤ) ≤ Z := by
    refine le_trans (NLogN.KIL.zsz_nat_le ?_) hZ
    rw [hN]; omega
  have H := NLogN.KFN.sImpl_phase (ι := Fin D) r S (K * D) P 0 (NLogN.KFM.posL K D ρ) (NLogN.KFM.posL_lt hρ) (fun _ => 1)
    (by omega) (by omega) hP Z hZ'
  have e1 : (fun i : Fin D => NLogN.KFH.stT K D S ρ i) = fun i => 2 ^ NLogN.KFM.posL K D ρ i * S :=
    funext fun i => NLogN.KFM.stT_posL i
  have e2 : AModel.vol (Butterfly.layerShape P K D S) = P * 2 ^ (K * D) * S := NLogN.KFM.vol_layer_eq P K D S
  rw [e1, e2, NLogN.KFM.SD_eq_diag]
  exact H
end
