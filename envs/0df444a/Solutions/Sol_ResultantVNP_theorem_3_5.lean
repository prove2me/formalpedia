  obtain ⟨r,hr⟩ := hmem
  obtain ⟨m,hm,hassoc⟩ := (dvd_prime_pow hP.prime r).mp (Ideal.mem_span_singleton.mp hr)
  obtain ⟨u,hu⟩ := hassoc.symm
