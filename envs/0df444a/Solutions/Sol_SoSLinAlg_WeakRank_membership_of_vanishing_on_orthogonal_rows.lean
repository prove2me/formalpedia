open MvPolynomial
noncomputable section
namespace SoSLinAlg.WeakRank.Dev.Leaf
variable {n r : ℕ} (I J : Finset (Fin n))
alias D_top := SoSLinAlg.WeakRank.Dev.Leaf.PartT.D_top

/-- Vanishing on the real variety `X_I Y_Jᵀ = 0`. -/
def Van (F : Poly n r) : Prop :=
  ∀ X Y : Matrix (Fin n) (Fin r) ℝ, (∀ i ∈ I, ∀ j ∈ J, (X * Y.transpose) i j = 0) →
    MvPolynomial.eval (assignment X Y) F = 0

/-- Degree in the variables `x_{i,k}`, `i ∈ I`. -/
def wx (I : Finset (Fin n)) (r : ℕ) : Var n r → ℕ
  | Sum.inl (i, _) => if i ∈ I then 1 else 0
  | Sum.inr _ => 0

end SoSLinAlg.WeakRank.Dev.Leaf
