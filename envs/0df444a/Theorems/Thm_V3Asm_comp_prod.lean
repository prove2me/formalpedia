open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

theorem V3Asm.comp_prod (p : ℕ) [Fact p.Prime] (𝔛 : ModularCurve.DRModelPackage p)
    (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (hϖ : IsLocalRing.maximalIdeal O = Ideal.span {((p : ℕ) : O)})
    (κ : Type) [Field κ] [CharP κ p] [IsAlgClosed κ] (toκ : O →+* κ)
    [Fintype (V3Glue.Site.Node p 𝔛 κ)] (H : V3Asm.SiteHyps p 𝔛 O κ toκ) (hξ : ∀ j, V3Asm.ξ p 𝔛 O κ toκ j ∈ (V3Asm.C p 𝔛 O κ toκ hϖ H).X0) :
    ∀ U : (V3Asm.Y p 𝔛 O κ toκ hϖ H).affineOpens, (∏ v, V3Asm.comp p 𝔛 O κ toκ hϖ H hξ v).ideal U = Ideal.span {((p : ℕ) : Γ((V3Asm.Y p 𝔛 O κ toκ hϖ H), U))} := by sorry
