def prodP : List (ℕ × ℕ) → ℕ
  | [] => 1
  | pr :: l => Nat.mul (Nat.pow pr.1 pr.2) (prodP l)

theorem prime_dvd_prodP (f : ℕ) (hf : f.Prime) :
    ∀ l : List (ℕ × ℕ), (∀ pr ∈ l, pr.1.Prime) → f ∣ prodP l → ∃ pr ∈ l, f = pr.1 := by
  intro l
  induction l with
  | nil =>
    intro _ h
    simp only [prodP] at h
    exact absurd (Nat.le_of_dvd one_pos h) (by have := hf.two_le; omega)
  | cons pr l ih =>
    intro hl h
    simp only [prodP] at h
    show _
    rcases (Nat.Prime.dvd_mul hf).1 h with h' | h'
    · have hp1 := hl pr (List.mem_cons_self ..)
      have := (Nat.prime_dvd_prime_iff_eq hf hp1).1 (hf.dvd_of_dvd_pow h')
      exact ⟨pr, List.mem_cons_self .., this⟩
    · obtain ⟨pr', hm, he⟩ := ih (fun x hx => hl x (List.mem_cons_of_mem _ hx)) h'
      exact ⟨pr', List.mem_cons_of_mem _ hm, he⟩

def zOK (q y F f : ℕ) : Bool := Nat.beq (Nat.gcd (Nat.sub (Nat.add (pw6 q y (Nat.div F f)) q) 1) q) 1

def certOK (q a R : ℕ) (ps : List (ℕ × ℕ)) : Bool :=
