    (w : ↥(modularFunctionFieldC (ResidueField ↥A) M) ≃ₐ[ResidueField ↥A] ↥(modularFunctionFieldC (ResidueField ↥A) M))
    (hw : w ⟨jqModC (ResidueField ↥A), jqModC_mem (ResidueField ↥A) M⟩ =
