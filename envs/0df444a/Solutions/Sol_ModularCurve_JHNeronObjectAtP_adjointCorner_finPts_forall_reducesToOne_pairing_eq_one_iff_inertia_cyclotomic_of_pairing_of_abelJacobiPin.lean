theorem exists_cycloExp (p : ℕ) [Fact p.Prime] (σ : Gal) : ∃ c : ℕ, ∀ ζ : ℚ̄, ζ ^ p = 1 → σ ζ = ζ ^ c := by
  haveI : NeZero ((p : ℕ) : ℚ) := ⟨Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero⟩
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure ℚ) p
  have hσζ₀ : (σ ζ₀) ^ p = 1 := by rw [← map_pow, hζ₀.pow_eq_one, map_one]
  obtain ⟨c, -, hc⟩ := hζ₀.eq_pow_of_pow_eq_one hσζ₀
  refine ⟨c, fun ζ hζ => ?_⟩
  obtain ⟨k, -, rfl⟩ := hζ₀.eq_pow_of_pow_eq_one hζ
  rw [map_pow, ← hc, ← pow_mul, ← pow_mul, mul_comm]

theorem not_dvd_cycloExp (p : ℕ) [Fact p.Prime] (σ : Gal) (c : ℕ) (hc : ∀ ζ : ℚ̄, ζ ^ p = 1 → σ ζ = ζ ^ c) :
    ¬ p ∣ c := by
  haveI : NeZero ((p : ℕ) : ℚ) := ⟨Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero⟩
  obtain ⟨ζ₀, hζ₀⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure ℚ) p
  rintro ⟨k, rfl⟩
  have h1 : σ ζ₀ = 1 := by rw [hc ζ₀ hζ₀.pow_eq_one, pow_mul, hζ₀.pow_eq_one, one_pow]
  have h2 : ζ₀ = 1 := σ.injective (by rw [h1, map_one])
  exact hζ₀.ne_one (Fact.out : p.Prime).one_lt h2

theorem eq_of_pow_eq_pow_of_not_dvd (p : ℕ) [Fact p.Prime] {a b : ℚ̄} (ha : a ^ p = 1) (hb : b ^ p = 1) {c : ℕ}
    (hc : ¬ p ∣ c) (h : a ^ c = b ^ c) : a = b := by
  have hcop : Nat.Coprime c p := (Nat.Prime.coprime_iff_not_dvd (Fact.out : p.Prime)).mpr hc |>.symm
  obtain ⟨u, -, hu⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop (Fact.out : p.Prime).one_lt
  have hcu : c * u = p * (c * u / p) + 1 := by
    have := Nat.div_add_mod (c * u) p
    rw [hu] at this
    exact this.symm
  have key : ∀ x : ℚ̄, x ^ p = 1 → x ^ (c * u) = x := fun x hx => by
    rw [hcu, pow_add, pow_mul, hx, one_pow, one_mul, pow_one]
  rw [← key a ha, ← key b hb, pow_mul, pow_mul, h]

