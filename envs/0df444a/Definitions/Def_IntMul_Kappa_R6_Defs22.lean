-- Source module: Solutions.R6IL3CB
/-!
# Round six, item language (I3): closed-form cost coefficients

`CBH E = (aK K + 1) · Φ(E)` with `Φ(E) = 10^14 (E + 1)` on the chain levels `E < 2m` and
`Φ(E) = Cc E^θ + D0` on the node levels.  **`cbRec_of`**: `CBH` satisfies the cost recursion
`CBRec` when `τ ≤ θ`, the `θ`-moment `α = ∑_{children} (s/m)^θ < W` holds, `D0 = 10^14 (2m+1)`
and `Cc (W - α) ≥ nC D0 + 18 W' L 2^τ + C1` (`C1 = W' (L MH + CnN + 10^12)`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- The level profile. -/
noncomputable def PhiH (m : ℕ) (Cc D0 θ : ℝ) (x : ℕ) : ℝ :=
  if x < 2 * m then 10 ^ 14 * ((x : ℝ) + 1) else Cc * (x : ℝ) ^ θ + D0

/-- The closed-form cost coefficients. -/
noncomputable def CBH (m : ℕ) (a Cc D0 θ : ℝ) (x : ℕ) : ℝ := a * PhiH m Cc D0 θ x

/-- The `θ`-moment of the child widths. -/
noncomputable def momH (c : Cfg) (θ : ℝ) : ℝ := ((chWs c).map fun s : ℕ => ((s : ℝ) / c.m) ^ θ).sum

/-- The constant of the node recursion. -/
noncomputable def C1H (c : Cfg) : ℝ :=
  (c.Wr : ℝ) * ((c.net.length : ℝ) * (MH c : ℝ) + (CnN c : ℝ) + 10 ^ 12)

end IntMul.Kappa.R6.IL3H

end

section
-- Source module: Solutions.R6IL3Top1
/-!
# Round six, item language (I3): the entry loops of the uniform Proposition 14

* `loopQ`: a generic continuation-passing loop (`testC 16 cond (push step; call j) cont`) from an
  invariant indexed by the number of remaining iterations.
* `gloopC cz`: with `Z` on `vG = 24`, finds `G = clog₂ (4 (Z + cz) (Z + cz + 2))` on `11`
  (`gloopQ`; the compact-controls field width).
* `dloopC c`: with `D` on `22`, finds `d = dep m D` on `12` and `W^d` on `13` (`dloopQ`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-! ## A generic loop -/

/-- Per-iteration cost of a loop with a test of size `≤ sz` and a step frame of length `L`. -/
def cLoopS (sz L Bz : ℕ) : ℕ :=
  2 + (cFrame 1 sz Bz + 25 + (1 * (2 * Bz + 2) + 1)) + (cFrame L 12 Bz + (L * (2 * Bz + 2) + 1))

/-- Per-iteration cost of a loop with a step frame of length `L`. -/
abbrev cLoop (L Bz : ℕ) : ℕ := cLoopS 12 L Bz

/-! ## Descriptor registers with one extra register `vG` -/

/-! ## The field-width loop -/

/-- The bound `4 (Z + cz) (Z + cz + 2)`. -/
def gBnd (cz Z : ℕ) : ℕ := 4 * (Z + cz) * (Z + cz + 2)

/-- The field width `G = clog₂ (4 (Z + cz) (Z + cz + 2))`. -/
def Gv (cz Z : ℕ) : ℕ := Nat.clog 2 (gBnd cz Z)

/-- The bound as a natural expression of `Z` on `vG`. -/
def gBndNE (cz : ℕ) : NE :=
  .mul (.mul (.lit 4) (.add (.reg vG) (.lit cz))) (.add (.reg vG) (.lit (cz + 2)))

/-- The loop test `2^g < bound` (value `0` when true). -/
def gCond (cz : ℕ) : NE := .lt (.reg 12) (gBndNE cz) (.lit 0) (.lit 1)

/-- One step: `g ↦ g + 1`, `2^g ↦ 2^{g+1}`. -/
def gStep : List (Fin HS × NE) := [(11, .add (.reg 11) (.lit 1)), (12, .mul (.reg 12) (.lit 2))]

/-- The field-width loop. -/
def gloopC {Pp : ℕ} (cz : ℕ) (jG : Fin Pp) (cont : IStmt HS Pp) : IStmt HS Pp :=
  testC 16 (gCond cz) (withPushI (fr gStep) (.call jG)) cont

/-! ## The depth loop -/

/-- The loop test `x < 2m` (value `0` when false, i.e. when a node level remains). -/
def dCond (m : ℕ) : NE := .lt (.reg 11) (.lit (2 * m)) (.lit 1) (.lit 0)

/-- One step: `x ↦ (m-1) ⌊x/m⌋`, `d ↦ d + 1`, `W^d ↦ W^{d+1}`. -/
def dStep (m W : ℕ) : List (Fin HS × NE) :=
  [(11, .mul (.lit (m - 1)) (.div (.reg 11) (.lit m))), (12, .add (.reg 12) (.lit 1)),
    (13, .mul (.reg 13) (.lit W))]

/-- The depth loop. -/
def dloopC {Pp : ℕ} (m W : ℕ) (jD : Fin Pp) (cont : IStmt HS Pp) : IStmt HS Pp :=
  testC 16 (dCond m) (withPushI (fr (dStep m W)) (.call jD)) cont

end IntMul.Kappa.R6.IL3H

end

section
-- Source module: Solutions.R6IL3Top2
/-!
# Round six, item language (I3): the kernel loop of the uniform Proposition 14

`kerLoopC jK jL` (at index `jK`): with `i` on `11` and `b` on `12`, while `i < b`, the level
procedure `jL` on the single bit `i` of the layer (a level frame `kerTF`: `E = 1` bit at
`e = ρ + K (D - 1 - i)`, `t = K D`, `B = P`), then `i ↦ i + 1`.

* `levRH_of6`: a six-register level frame on a `BaseR` state with `K, r, H` is a `LevRH`.
* **`kerQ`**: `kerLoopC` implements the kernels `C` on the bits `i ≤ x < b` of the layer.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- The values of a level frame. -/
def lev6 (c : Cfg) (t S0 E e B : ℕ) : List (Fin HS × ℤ) :=
  [(vT, (t : ℤ)), (vS, (S0 : ℤ)), (vk, (E : ℤ)), (vE, (e : ℤ)), (vB, (B : ℤ)),
    (vX, ((c.G E : ℕ) : ℤ))]

/-- The kernel frame on bit `i` (on `11`): `t = K D`, `S₀ = S`, `E = 1`, `e = ρ + K (D-1-i)`,
`B = P`, `Gs 1 = 1`. -/
def kerTF : List (Fin HS × NE) :=
  [(vT, .mul (.reg 1) (.reg 22)), (vS, .reg 3), (vk, .lit 1),
    (vE, .add (.reg 23) (.mul (.reg 1) (.sub (.sub (.reg 22) (.lit 1)) (.reg 11)))),
    (vB, .reg 21), (vX, .lit 1)]

/-- The kernel loop. -/
def kerLoopC {Pp : ℕ} (jK jL : Fin Pp) : IStmt HS Pp :=
  testC 16 (.lt (.reg 11) (.reg 12) (.lit 0) (.lit 1))
    (.seq (withPushI (fr kerTF) (.call jL)) (withPushI (fr [(11, .add (.reg 11) (.lit 1))]) (.call jK)))
    .skip

/-- Per-kernel overhead of the loop. -/
def cKO (Bz : ℕ) : ℕ :=
  2 + (cFrame 1 12 Bz + 25 + (1 * (2 * Bz + 2) + 1)) + (cFrame 6 12 Bz + 2 + (6 * (2 * Bz + 2) + 1)) +
    (cFrame 1 12 Bz + 2 + (1 * (2 * Bz + 2) + 1))

/-- End cost of the loop. -/
def cKE (Bz : ℕ) : ℕ := 2 + cFrame 1 12 Bz + (1 + 25) + (1 * (2 * Bz + 2) + 1)

end IntMul.Kappa.R6.IL3H

end

section
-- Source module: Solutions.R6IL3Top3
/-!
# Round six, item language (I3): the core registers of the uniform Proposition 14

After the field-width loop (`G` on `vG = 24`) and the depth loop (`d = dep m D` on `12`,
`W^d` on `13`), `coreCH c cW body` pushes

* `27 0`, `32 1`, `19 1` (a frozen `CoreR` at level `k = 0`),
  `28 q₀ = min(D, ⌈(cW d + 2 ⌊D/m⌋ G) / K⌉)`, `5 H = w + EwH D` (natural frame `coreF1`),
* `29 D - q₀`, `20 B' = padB (P 2^{K q₀}) (W^d 2^{2 ⌊D/m⌋ G})` (expression frame `core2H`),

and runs `body`.  **`coreQH`**: `body` runs on a `CoreR` assignment that keeps `G` on `vG`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-! ## Expressions and values -/

/-- `⌊D/m⌋ G`. -/
def gWNE (m : ℕ) : NE := .mul (.div (.reg 22) (.lit m)) (.reg vG)

/-- `⌈(cW d + 2 ⌊D/m⌋ G) / K⌉`. -/
def q0rNE (m cW : ℕ) : NE :=
  .div (.sub (.add (.add (.mul (.lit cW) (.reg 12)) (.mul (.lit 2) (gWNE m))) (.reg 1)) (.lit 1))
    (.reg 1)

/-- `q₀ = min(D, ⌈(cW d + 2 ⌊D/m⌋ G) / K⌉)`. -/
def q0NE (m cW : ℕ) : NE := .lt (.reg 22) (q0rNE m cW) (.reg 22) (q0rNE m cW)

/-- The guard of the round-six Proposition 14: `(W' + 4)(D + Gs D) + 4`. -/
def EwH (c : Cfg) (D : ℕ) : ℕ := (c.Wr + 4) * (D + c.G D) + 4

/-- `EwH D` from `D` on `22`. -/
def ewNE (c : Cfg) : NE :=
  .add (.mul (.lit (c.Wr + 4)) (.add (.reg 22) (gsNE c.Aw c.p c.m (.reg 22)))) (.lit 4)

/-- The first core frame. -/
def coreF1 (c : Cfg) (cW : ℕ) : List (Fin HS × NE) :=
  [(27, .lit 0), (32, .lit 1), (19, .lit 1), (28, q0NE c.m cW), (5, .add (.reg 25) (ewNE c))]

/-- `W^d 2^{2 ⌊D/m⌋ G}`. -/
def eWk (m : ℕ) : Ex HS := .mul (.reg 13) (.pow2 (.mul (.lit 2) (gWNE m).toEx))

/-- `padB (P 2^{K q₀}) Wk`. -/
def eBpH (m : ℕ) : Ex HS :=
  .mul (eWk m) (.ndiv (.add (.mul (.reg 21) (.pow2 (.mul (.reg 1) (.reg 28))))
    (.add (eWk m) (.lit (-1)))) (eWk m))

/-- The second core frame (expressions). -/
def core2HE (m : ℕ) : List (Fin HS × Ex HS) := [(29, eDq), (20, eBpH m)]

/-- The second core frame (values). -/
def core2H (m D q0 Bp : ℕ) : List (Fin HS × Ex HS × ℤ) :=
  [(29, eDq, ((D - q0 : ℕ) : ℤ)), (20, eBpH m, (Bp : ℤ))]

/-- The core stage. -/
noncomputable def coreCH {Pp : ℕ} (c : Cfg) (cW : ℕ) (body : IStmt HS Pp) : IStmt HS Pp :=
  withPushI (fr (coreF1 c cW)) (withPushI (core2HE c.m) body)

/-- The value of `q₀`. -/
def q0v (m cW K D d G : ℕ) : ℕ := min D ((cW * d + 2 * (D / m * G) + K - 1) / K)

/-- The value of `Wk`. -/
def WkV (W m D d G : ℕ) : ℕ := W ^ d * 2 ^ (2 * (D / m * G))

/-- The value of `B'`. -/
def BpV (W m K P D d G q0 : ℕ) : ℕ := padB (P * 2 ^ (K * q0)) (WkV W m D d G)

/-- The frame size bound of the core. -/
def szC (c : Cfg) : ℕ := (ewNE c).size + 64

/-! ## The core stage -/

/-- The cost of the core stage. -/
def cCoreH (cc Z Bz sz : ℕ) : ℕ :=
  cFrame 5 sz Bz + (cFrame 2 64 Z + cc + (2 * (2 * Z + 2) + 1)) + (5 * (2 * Bz + 2) + 1)

end IntMul.Kappa.R6.IL3H

end

section
-- Source module: Solutions.R6IL3Top4
/-!
# Round six, item language (I3): the local size loop of the uniform Proposition 14

`zloopC c jZ cont`: with the descriptor registers, finds `j = Nat.size a` on `11` (`2^j` on `12`;
`zloopQ`), where `a = 32 W' P S r + w + EwH D`.  The local size bound is then `Zl = j + K D`, so
`zsz (32 W' P 2^{K D} S r) ≤ Zl` and `H + 1 < 2^{Zl}` for `H = w + EwH D` (`zl_spec`).  The field
width `G` is computed from `Zl` (not from the caller's `Z`), so the per-row factor is
`≈ log` of the size of the array and of the width bound.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- `32 W' P S r`. -/
def a0NE (Wr : ℕ) : NE := .mul (.mul (.mul (.lit (32 * Wr)) (.reg 21)) (.reg 3)) (.reg 4)

/-- `a = 32 W' P S r + w + EwH D` from the descriptor registers. -/
def aNE (c : Cfg) : NE := .add (.add (a0NE c.Wr) (.reg 25)) (ewNE c)

/-- The value `a`. -/
def aV (c : Cfg) (P S r w D : ℕ) : ℕ := 32 * c.Wr * P * S * r + w + EwH c D

/-- The loop test `a < 2^j` (value `0` when false, i.e. when a step remains). -/
def zCond (c : Cfg) : NE := .lt (aNE c) (.reg 12) (.lit 1) (.lit 0)

/-- The test size of the size loop. -/
def szZ (c : Cfg) : ℕ := (zCond c).size

/-- The size loop. -/
def zloopC {Pp : ℕ} (c : Cfg) (jZ : Fin Pp) (cont : IStmt HS Pp) : IStmt HS Pp :=
  testC 16 (zCond c) (withPushI (fr gStep) (.call jZ)) cont

/-- The local size bound `Zl = size a + K D`. -/
def Zl (c : Cfg) (P K D S r w : ℕ) : ℕ := Nat.size (aV c P S r w D) + K * D

end IntMul.Kappa.R6.IL3H

end

section
-- Source module: Solutions.R6IL3Top5
/-!
# Round six, item language (I3): the middle part of the `C`-layer

With the core registers (`q₀` on `28`, `D - q₀` on `29`, `B'` on `20`), `qB` on `14` and
`Gs D''` on `15` (`D'' = D - q₀ - qB ≥ 1`), `midPart jL` pads the layer from `P 2^{K q₀}` to `B'`
blocks (`padCU` with the frozen frame `padE`) and runs the level procedure on the `D''` bits
`q₀ ≤ x < q₀ + D''` of the padded layout (level frame `midE`: `t = K D''`, `S₀ = S 2^{K qB}`,
`E = D''`, `e = ρ + K (D'' - 1)`, `B = B'`, `Gs D''`).

**`midQ`**: `midPart jL` implements `tens Cm` on those bits, scale `Gs D''`,
width `(W'+4) Gs D''`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- `D'' = (D - q₀) - qB`. -/
def dppNE : NE := .sub (.reg 29) (.reg 14)

def mtNE : NE := .mul (.reg 1) dppNE
def meNE : NE := .add (.reg 23) (.mul (.reg 1) (.sub dppNE (.lit 1)))
def mkNE : NE := .mul (.reg 1) (.reg 14)
def msE : Ex HS := .mul (.reg 3) (.pow2 mkNE.toEx)

/-- The middle level frame (expressions). -/
def midE : List (Fin HS × Ex HS) :=
  [(vT, mtNE.toEx), (vS, msE), (vk, dppNE.toEx), (vE, meNE.toEx), (vB, .reg 20), (vX, .reg 15)]

/-- The middle level frame (with values). -/
def midL (c : Cfg) (t S0 E e B : ℕ) : List (Fin HS × Ex HS × ℤ) :=
  [(vT, mtNE.toEx, (t : ℤ)), (vS, msE, (S0 : ℤ)), (vk, dppNE.toEx, (E : ℤ)), (vE, meNE.toEx, (e : ℤ)),
    (vB, .reg 20, (B : ℤ)), (vX, .reg 15, ((c.G E : ℕ) : ℤ))]

/-- The middle part. -/
def midPart {Pp : ℕ} (jL : Fin Pp) : IStmt HS Pp :=
  withPushI padE (padCU 17 18 (withPushI midE (.call jL)))

/-- The cost of the middle part (`n`, `n'` the layout sizes, `cl` the level cost). -/
def cMidI (cl Zf : ℕ) : ℕ := cFrame 6 32 Zf + (cl + 2) + (6 * (2 * Zf + 2) + 1)

def cMid (n np r Zf dw cl : ℕ) (w : ℕ) : ℕ :=
  cFrame 2 32 Zf + (400 * (cPadC (2 * (n * r)) (2 * ((np - n) * r)) Zf w dw (fun _ => cMidI cl Zf) + 0) +
    cMidI cl Zf) + (2 * (2 * Zf + 2) + 1)

/-- The canonical strides of the bits `q₀ ≤ x < q₀ + E` of the layer. -/
def stM (K D S ρ q0 E : ℕ) : Fin E → ℕ := fun y => 2 ^ (ρ + K * (D - 1 - (q0 + y.val))) * S

end IntMul.Kappa.R6.IL3H

end

section
-- Source module: Solutions.R6IL3Top6
/-!
# Round six, item language (I3): the `C`-layer of the uniform Proposition 14

With the core registers, `qB` on `14` and `Gs D''` on `15` (`D'' = D - q₀ - qB`), `clCH jK jL`
runs the kernel loop on the top bits `[0, q₀)`, the kernel loop on the bottom bits `[D - qB, D)`,
and, if `D'' > 0`, the middle part (`midPart`, the level procedure on the padded layout).

**`clQH`**: `clCH` implements `tens Cm` on the layer, scale `q₀ + (qB + Gs D'')`,
width `(W'+4)(q₀ + qB + Gs D'')`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

def ker1F : List (Fin HS × NE) := [(11, .lit 0), (12, .reg 28)]
def ker2F : List (Fin HS × NE) := [(11, .sub (.reg 22) (.reg 14)), (12, .reg 22)]
def midCond : NE := .lt (.add (.reg 28) (.reg 14)) (.reg 22) (.lit 0) (.lit 1)

/-- The `C`-layer. -/
def clCH {Pp : ℕ} (jK jL : Fin Pp) : IStmt HS Pp :=
  .seq (withPushI (fr ker1F) (.call jK))
    (.seq (withPushI (fr ker2F) (.call jK)) (testC 16 midCond (midPart jL) .skip))

/-- The cost of `d` kernels. -/
noncomputable def cKer (CB1 : ℝ) (n r Zr H Bz d : ℕ) : ℕ :=
  cFrame 2 12 Bz + (d * (⌊CB1 * ((n * Yu r Zr H : ℕ) : ℝ)⌋₊ + cKO Bz) + cKE Bz) +
    (2 * (2 * Bz + 2) + 1)

/-- The cost of the `C`-layer. -/
noncomputable def cCLH (c : Cfg) (CB : ℕ → ℝ) (K S r H P D q0 qB Bp Zf Zr Bz : ℕ) (w : ℕ) : ℕ :=
  cKer (CB 1) (P * 2 ^ (K * D) * S) r Zr H Bz q0 +
    (cKer (CB 1) (P * 2 ^ (K * D) * S) r Zr H Bz qB +
      (cFrame 1 12 Bz + (cMid (P * 2 ^ (K * D) * S) (Bp * 2 ^ (K * (D - q0)) * S) r Zf
        ((c.Wr + 4) * c.G (D - q0 - qB))
        ⌊CB (D - q0 - qB) * ((Bp * 2 ^ (K * (D - q0)) * S * Yu r Zr H : ℕ) : ℝ)⌋₊
        (w + (c.Wr + 4) * q0 + (c.Wr + 4) * qB) + 25) + (1 * (2 * Bz + 2) + 1)))

/-- The conditions of the middle part. -/
structure MidPre (c : Cfg) {Pp : ℕ} (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp) (jL : Fin Pp)
    (rowC : IStmt HS Pp) (CB : ℕ → ℝ) (K S r H P D ρ q0 Bp qB Z Zf Zr G : ℕ) : Prop where
  LV : LvH c Isym tbl jL rowC K r Z Zr H G CB (D - q0 - qB)
  hBpP : P * 2 ^ (K * q0) ≤ Bp
  hBp2 : Bp ≤ 2 * (P * 2 ^ (K * q0))
  hdvd : c.W ^ dep c.m (D - q0 - qB) * 2 ^ (2 * (((D - q0 - qB) / c.m - 1) * G)) ∣ Bp
  hSd : ((D - q0 - qB) / c.m - 1) * G ≤ K * qB
  hGH : c.G (D - q0 - qB) ≤ H
  hV : zsz ((VbH c K (K * (D - q0 - qB)) (S * 2 ^ (K * qB)) r H (D - q0 - qB)
      (ρ + K * (D - q0 - qB - 1)) Bp : ℕ) : ℤ) ≤ Zr

end IntMul.Kappa.R6.IL3H

end

section
-- Source module: Solutions.R6IL3Top7
/-!
# Round six, item language (I3): the layer body of the uniform Proposition 14

On a core assignment (`CoreR` at `k = 0`, `G` on `vG`), `bodyCH c jK jL` pushes

* `14 qB = min(D - q₀, ⌈⌊D/m⌋ G / K⌉)` (two natural frames `bF1`, `bF2`),
* `15 Gs D''` (`D'' = D - q₀ - qB`; frame `bF3`),
* `13 E = q₀ + (qB + Gs D'') + (⌊D/2⌋ + D mod 2)` (frame `bF4`),

then runs `S_D ; C ; S_D ; b^D ; Q_p` (the frozen `sdC`, `mdC`, `truncU`, and the round-six
`C`-layer `clCH`).  **`bodyCoreQ`**: the output is `prop14Proc … (tens Cm)` with the frozen
guarantees; **`bodyQH`**: the run of `bodyCH` as a `RunQ`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul AModel NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- `⌈⌊D/m⌋ G / K⌉`. -/
def qBrNE (m : ℕ) : NE := .div (.sub (.add (gWNE m) (.reg 1)) (.lit 1)) (.reg 1)

/-- The value `qB = min(D - q₀, ⌈⌊D/m⌋ G / K⌉)`. -/
def qBv (m K D G q0 : ℕ) : ℕ := min (D - q0) ((D / m * G + K - 1) / K)

def bF1 (m : ℕ) : List (Fin HS × NE) := [(14, qBrNE m)]
def bF2 : List (Fin HS × NE) := [(14, .lt (.reg 29) (.reg 14) (.reg 29) (.reg 14))]
def bF3 (c : Cfg) : List (Fin HS × NE) := [(15, gsNE c.Aw c.p c.m dppNE)]
def etNE : NE :=
  .add (.add (.reg 28) (.add (.reg 14) (.reg 15))) (.add (.div (.reg 22) (.lit 2)) (.mod (.reg 22) (.lit 2)))
def bF4 : List (Fin HS × NE) := [(13, etNE)]

/-- The truncation frame (`E` on `13`). -/
def trEH : List (Fin HS × Ex HS) := [(17, .pow2 (.reg 13)), (18, eL)]

/-- The body proper. -/
def bodyCore {Pp : ℕ} (jK jL : Fin Pp) : IStmt HS Pp :=
  .seq (.seq (.seq (.seq sdC (clCH jK jL)) sdC) mdC) (withPushI trEH (fcode (truncU 17 18)))

/-- The layer body. -/
def bodyCH {Pp : ℕ} (c : Cfg) (jK jL : Fin Pp) : IStmt HS Pp :=
  withPushI (fr (bF1 c.m)) (withPushI (fr bF2) (withPushI (fr (bF3 c))
    (withPushI (fr bF4) (bodyCore jK jL))))

/-- The total scale. -/
def Etot (c : Cfg) (D q0 qB : ℕ) : ℕ := q0 + (qB + c.G (D - q0 - qB)) + (D / 2 + D % 2)

/-- The width of the `C`-layer. -/
def dwCL (c : Cfg) (D q0 qB : ℕ) : ℕ :=
  (c.Wr + 4) * q0 + ((c.Wr + 4) * qB + (c.Wr + 4) * c.G (D - q0 - qB))

/-- The cost of the body proper. -/
noncomputable def cBodyC (c : Cfg) (CB : ℕ → ℝ) (K S r H P D q0 qB Bp Z Zr Bz : ℕ) (w : ℕ) : ℕ :=
  cSD K S r P D Z w + cCLH c CB K S r H P D q0 qB Bp Z Zr Bz w +
    cSD K S r P D Z (w + dwCL c D q0 qB) +
    (7 * cMdT Bz + cMdK (P * 2 ^ (K * D) * S * r) Z Bz (w + dwCL c D q0 qB)) +
  (cTrP (Etot c D q0 qB) Z +
    400 * (cTrunc (w + (dwCL c D q0 qB + 2)) (Etot c D q0 qB) (2 * (P * 2 ^ (K * D) * S * r)) Z + 0) +
    (2 * (2 * (Etot c D q0 qB + Z + 1) + 2) + 1))

end IntMul.Kappa.R6.IL3H

end

section
-- Source module: Solutions.R6IL3Top8
/-!
# Round six, item language (I3): the body frames of the uniform Proposition 14

**`bodyQH`**: on every core assignment (`CoreR` at `k = 0`, `G` on `vG`), `bodyCH c jK jL`
(the frames `bF1 … bF4`, then `bodyCore`) leaves `gflat zs* ++ l` on stack `0`, where `zs*` is
the representation of `prop14Proc … (tens Cm)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul AModel NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- A one-entry frame around a cost. -/
def cFr1 (sz Bz cc : ℕ) : ℕ := cFrame 1 sz Bz + cc + (1 * (2 * Bz + 2) + 1)

/-- The frame size of the scale frame. -/
def szB (c : Cfg) : ℕ := (gsNE c.Aw c.p c.m dppNE).size + 16

/-- The cost of the layer body. -/
noncomputable def cBodyH (c : Cfg) (CB : ℕ → ℝ) (K S r H P D q0 qB Bp Z Zr Bz : ℕ) (w : ℕ) : ℕ :=
  cFr1 12 Bz (cFr1 12 Bz (cFr1 (szB c) Bz (cFr1 16 Bz (cBodyC c CB K S r H P D q0 qB Bp Z Zr Bz w))))

/-- The register bound of the body frames. -/
def MbBody (c : Cfg) (K P D S G q0 qB : ℕ) : ℕ :=
  K * D + P + D + S + D / c.m * G + G + K + c.Aw * (D + 1) ^ c.p + (D + 1) ^ c.p + 2 * c.m +
    Etot c D q0 qB + 20

end IntMul.Kappa.R6.IL3H

end


