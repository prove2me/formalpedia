variable {M a Q : ℝ} {U : Set (Pt 4)} {τ : CTan} {x : Pt 4}
local notation "gK" => gKN M a Q
local notation "giK" => giKN M a Q
local notation "EK" => knE M a Q
local notation "ΘK" => knTh M a Q
local notation "FK" => faradayKN a Q
variable (hτ : KNCTan M a Q U τ)
include hτ
variable (hL : CLinEM M a Q U τ)
include hL
theorem solution (hg : ∀ y ∈ U, cPhi2 M a Q τ y = 0) (hx : x ∈ U) :
    0 = 2 * phi1 EK x FK * (2 * cPsi3 M a Q τ x - fdir EK 0 (cNu M a Q τ) x + fdir EK 2 (cLambda M a Q τ) x
            + (npPiB gK giK EK ΘK x + npTau gK giK EK ΘK x + 3 * npBeta gK giK EK ΘK x - npAlphaB gK giK EK ΘK x)
              * cLambda M a Q τ x
            - (3 * npEps gK giK EK ΘK x + npEpsB gK giK EK ΘK x + npRho gK giK EK ΘK x - npRhoB gK giK EK ΘK x)
              * cNu M a Q τ x)
        - cNu M a Q τ x * fdir EK 0 (fun z => phi1 EK z FK) x
        + cLambda M a Q τ x * fdir EK 2 (fun z => phi1 EK z FK) x := by
  have e := c_maxwell_neg_src hτ hx
  rw [fdir_eq_zero_of hτ.isOpen hx (cSrc4_zero hτ hL hg) 3, fdir_eq_zero_of hτ.isOpen hx (cSrc3_zero hτ hL hg) 1,
    cSrc4_zero hτ hL hg x hx, cSrc3_zero hτ hL hg x hx] at e
  linear_combination e
