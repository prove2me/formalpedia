-- title:
--   Reduced multicore criterion for maximal removable-hook weight
-- statement:
--   Let $F$ be a field, let $n,r\ge1$, let $q\in F^\times$ with $q\ne1$, and fix integer charges $c_1,\ldots,c_r$, with $Q_a=q^{c_a}$. Let $e$ be the least $k\ge2$ with $1+q+\cdots+q^{k-1}=0$, or $\infty$ if there is none. For an $r$-multipartition $\lambda$ of $n$, each node $(i,j,a)$ has charged residue $j-i+c_a$ modulo $e$, interpreted as an integer when $e=\infty$. Residue multiplicities count nodes individually. The relation $\sim_J$ is the equivalence relation generated by nonzero coefficients $J_{\alpha\beta}$ in Definition 2.5, with intermediate multipartitions of the same size.
--
--   Let $\lambda$ be a multipartition of $n$. Write $\overline\lambda$ for its componentwise $e$-core and $w_e(\lambda)$ for the number of removed $e$-hooks, equal to $(|\lambda|-|\overline\lambda|)/e$ for finite $e$, and zero for $e=\infty$. Define the attained finite maximum
--
--   $$
--   W_e(\lambda)=\max\{w_e(\mu):|\mu|=n,\ \mu\sim_C\lambda\}.
--   $$
--
--   A multipartition $\rho$ is a reduced multicore when every multipartition of size $|\rho|$ in its residue class is a multicore, as in Definition 3.15 and Proposition 3.14(a). Then
--
--   $$
--   \overline\lambda\text{ is a reduced multicore}
--   \quad\Longleftrightarrow\quad
--   w_e(\lambda)=W_e(\lambda).
--   $$
--
--   The maximum is taken over a nonempty same-size class, containing $\lambda$. This criterion distinguishes a reduced multicore from an arbitrary multicore and uses the bar on $\lambda$ in the first clause.
-- source:
--   Blocks of cyclotomic Hecke algebras, arXiv:math/0607451v4, PDF p. 16, Lemma 3.16

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P29

namespace QAlgorithms.Papers.Independent.Intake100.P29

noncomputable section

open scoped BigOperators Classical

variable {F : Type} [Field F]

/-- Lemma 3.16, PDF p. 16. The reduced-multicore clause applies to the core
of lambda. The maximum is computed over the nonempty same-size residue class. -/
theorem reduced_multicore_iff_maximum {r n : ℕ} (hr : 0 < r) (hn : 0 < n)
    (q : F) (hq : q ≠ 0) (hqOne : q ≠ 1) (c : Fin r → ℤ)
    (L : Multipartition r) (hL : size L = n) :
    ReducedMulticore (quantumCharacteristic q) c (multicore (quantumCharacteristic q) L) ↔
      coreWeight (quantumCharacteristic q) L =
        maximumCoreWeight (quantumCharacteristic q) c L := by sorry

end

end QAlgorithms.Papers.Independent.Intake100.P29
