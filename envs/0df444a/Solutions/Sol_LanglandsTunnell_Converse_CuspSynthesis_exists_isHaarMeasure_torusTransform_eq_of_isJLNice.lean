  refine Units.ext (Prod.ext (NumberField.Idele.partAt_fst K S _) (IsDedekindDomain.FiniteAdeleRing.ext K fun w => ?_))
  by_cases hw : w ∈ S
  · exact NumberField.Idele.partAt_snd_of_mem K S _ hw
