theorem _root_.solution (v : σ) {a b : ℕ} (ha : (∑ c, (Finsupp.single v 1 : σ →₀ ℕ) (w c)) = a)
    (hb : (∑ c, (Finsupp.single v 1 : σ →₀ ℕ) (e c)) = b) : BiHom w e a b (X v : MvPolynomial σ K) := by
  classical
  intro m hm
