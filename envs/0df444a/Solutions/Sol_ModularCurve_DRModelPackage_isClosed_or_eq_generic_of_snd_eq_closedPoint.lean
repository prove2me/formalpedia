theorem Scheme.exists_specializes_ne_of_one_le_ringKrullDim {X : Scheme.{u}} (η : X)
    (h : 1 ≤ ringKrullDim (X.presheaf.stalk η)) : ∃ w : X, w ⤳ η ∧ w ≠ η := by
  obtain ⟨a, b, hab⟩ := Order.one_le_krullDim_iff.mp h
  refine ⟨(X.fromSpecStalk η).base a, ?_, ?_⟩
  · have : (X.fromSpecStalk η).base a ∈ Set.range (X.fromSpecStalk η).base := ⟨a, rfl⟩
    rw [Scheme.range_fromSpecStalk] at this
    exact this
  · intro heq
    have hinj := (X.fromSpecStalk η).isEmbedding.injective
    have ha : a = closedPoint (X.presheaf.stalk η) :=
      hinj (heq.trans (Scheme.fromSpecStalk_closedPoint (x := η)).symm)
    have hb : b ≤ closedPoint (X.presheaf.stalk η) :=
      IsLocalRing.le_maximalIdeal b.isPrime.ne_top
    rw [ha] at hab
    exact lt_irrefl _ (hab.trans_le hb)

