    (hM : c 14 = matL (fun i k => A (Lg L i) (Lg L k)) m)
    (hE : ∀ j ∈ ([15, 16, 17, 18, 19, 27, 47, 48, 50, 51] : List (Fin HS)), c j = [])
    (hB : ∀ q ≤ m, ∀ i < m, ∀ k < m, |Mseq Q (bandS mw cB) L A q i k| ≤ 2 ^ B)
    (hBW : B ≤ W) (hW1 : 1 ≤ W) (hmW : m * m + m ≤ 2 ^ W) (hLb : ∀ j ∈ L, j ≤ 2 ^ W) :
    Rn elimP v c (fun v' => (∀ j ∈ ([9, 10, 20, 21, 22, 23, 24, 25, 26] : List (Fin HS)),
        v' j = v j) ∧ BV W v')
      (update c 14 (matL (Mseq Q (bandS mw cB) L A m) m)) (cElim W m) := by
  have h16 : c 16 = [] := hE 16 (by decide)
  have h50 : c 50 = [] := hE 50 (by decide)
  have h51 : c 51 = [] := hE 51 (by decide)
  have hmlt : m < 2 ^ W := by
