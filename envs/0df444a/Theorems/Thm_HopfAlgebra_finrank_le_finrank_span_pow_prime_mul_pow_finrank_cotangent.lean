-- title:
--   Frobenius image bounds the dimension of a finite Hopf algebra
-- statement:
--   Let $K$ be an algebraically closed field of characteristic $p$, where $p$ is a prime, and let $H$ be a commutative ring carrying the structure of a Hopf algebra over $K$ which is finite-dimensional as a $K$-module. Let $\varepsilon =$ `Bialgebra.counitAlgHom K H` be the counit, viewed as a $K$-algebra homomorphism $H \to K$, and let $I = \ker \varepsilon$ be its kernel, the augmentation ideal. Two finite-dimensional $K$-vector spaces are attached to $H$: first, the $K$-linear span inside $H$ of the set of all $p$-th powers $a^p$, $a \in H$ (the $K$-span of the image of the Frobenius map, taken over all of $H$, not merely over $I$); second, the cotangent module $I/I^2$ of the ideal $I$, a module over $H/I$ and hence over $K$. The assertion is the numerical inequality
--   $$\dim_K H \;\le\; \dim_K \operatorname{span}_K\{a^p : a \in H\} \cdot p^{\dim_K (I/I^2)}.$$
--
--   For $G = \operatorname{Spec} H$ a finite commutative group scheme over $K$, this bounds $\dim_K H$ by the dimension of the coordinate ring of the image of Frobenius times $p$ raised to the dimension of the cotangent space $\omega_G = I/I^2$ at the identity; the proof uses the computation of $\dim_K$ of $H$ modulo the ideal generated by the $p$-th powers of elements of the augmentation ideal, [`HopfAlgebra.finrank_quotient_span_pow_prime_eq_pow_finrank_cotangent`](thm.html#HopfAlgebra.finrank_quotient_span_pow_prime_eq_pow_finrank_cotangent). It feeds into [`HopfAlgebra.le_finrank_primitives_of_finrank_eq_pow_of_nsmulAlgHom_eq`](thm.html#HopfAlgebra.le_finrank_primitives_of_finrank_eq_pow_of_nsmulAlgHom_eq), a step towards bounding the dimension of the space of primitives of a finite Hopf algebra of $p$-power dimension.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_HopfAlgebra_finrank_le_finrank_span_pow_prime_mul_pow_finrank_cotangent.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u v

theorem HopfAlgebra.finrank_le_finrank_span_pow_prime_mul_pow_finrank_cotangent
    (K : Type u) [Field K] [IsAlgClosed K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (H : Type v) [CommRing H] [HopfAlgebra K H] [Module.Finite K H] :
    Module.finrank K H ≤
      Module.finrank K ↥(Submodule.span K (Set.range fun a : H => a ^ p)) *
        p ^ Module.finrank K (RingHom.ker (Bialgebra.counitAlgHom K H)).Cotangent := by sorry
