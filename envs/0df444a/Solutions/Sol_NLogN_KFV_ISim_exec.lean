-- Source module: Solutions.KFV8Sim
/-!
# KFV §12: literal-to-register simulation of item-language code

`ISim π c c'`: `c'` is `c` with some literal pushes `.const j v` replaced by copies `.dup i j` of a
parameter stack `i` holding `v` (`π i = some v`). It is the `IStmt`-level analogue of
`KIL.RSim` and covers compiled register programs (`Ex.code` compiles `.lit v` to `.const` and
`.reg i` to `.dup`) as well as hand-written codes such as KFT's `carI`/`digI`.

**`ISim.runs`**: if `c` does not write any parameter stack and makes no calls (`NW π c`), every
run of `c` from a state with the parameters on top (`PV π s`) is matched by a run of `c'` with
the same final state and at most `2000 ×` the cost. This turns old codes whose *shape* does not
depend on `n` into uniform codes reading their sizes from stacks.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KIL

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem op_frame {o : IOp HS} {s t : IState HS} {c : ℕ} (h : o.Step I s t c) (j : Fin HS)
    (hj : j ∉ opW o) : t.G j = s.G j := by
  cases h <;> simp_all [opW, IState.upd_G]

theorem exec_PV {π : PMap} {c : IStmt HS Pp} {s t : IState HS} {n : ℕ}
    (h : IExec I iprog c s t n) (hw : NW π c) (hs : PV π s) : PV π t := by
  induction h with
  | skip => exact hs
  | op hst =>
    rename_i o s1 t1 c1
    refine hs.of_G fun i v hv => op_frame hst i fun hm => ?_
    have := hw i hm; rw [hv] at this; exact absurd this (by simp)
  | seq _ _ ih1 ih2 => exact ih2 hw.2 (ih1 hw.1 hs)
  | iteT _ _ ih => exact ih hw.1 hs
  | iteF _ _ ih => exact ih hw.2 hs
  | loopT _ _ _ ih1 ih2 => exact ih2 hw (ih1 hw hs)
  | loopF _ => exact hs
  | call _ _ => exact absurd hw id

/-- **Simulation**: runs of `c` transfer to `c'` (same final state, `≤ 2000 ×` the cost). -/
theorem ISim.exec_sol_aux {π : PMap} {c : IStmt HS Pp} {s t : IState HS} {n : ℕ}
    (h : IExec I iprog c s t n) : ∀ {c' : IStmt HS Pp}, ISim I iprog π c c' → NW π c → PV π s →
    ∃ n' ≤ 2000 * n, IExec I iprog c' s t n' := by
  induction h with
  | skip s0 =>
    intro c' hc _ _
    cases hc
    exact ⟨1, by omega, .skip s0⟩
  | op hst =>
    rename_i o s1 t1 c1
    intro c' hc hw hs
    cases hc with
    | op => exact ⟨c1, by omega, .op hst⟩
    | par hv hij =>
      rename_i i j v
      cases hst
      obtain ⟨L, hL⟩ := hs i v hv
      refine ⟨dupCost (zsz v) + 17, ?_, .op (.dup hij hL)⟩
      have := dup_cost_le (zsz v); omega
    | parC hd =>
      cases hst
      obtain ⟨m, hm, e⟩ := hd s1 hs
      exact ⟨m, by omega, e⟩
  | seq h1 h2 ih1 ih2 =>
    intro c' hc hw hs
    cases hc with
    | seq ha hb =>
      obtain ⟨n1, hn1, e1⟩ := ih1 ha hw.1 hs
      obtain ⟨n2, hn2, e2⟩ := ih2 hb hw.2 (exec_PV h1 hw.1 hs)
      exact ⟨n1 + n2, by omega, .seq e1 e2⟩
  | iteT hf h1 ih =>
    intro c' hc hw hs
    cases hc with
    | ite ha hb =>
      obtain ⟨n1, hn1, e1⟩ := ih ha hw.1 hs
      exact ⟨n1 + 25, by omega, .iteT hf e1⟩
  | iteF hf h1 ih =>
    intro c' hc hw hs
    cases hc with
    | ite ha hb =>
      obtain ⟨n1, hn1, e1⟩ := ih hb hw.2 hs
      exact ⟨n1 + 25, by omega, .iteF hf e1⟩
  | loopT hf h1 h2 ih1 ih2 =>
    intro c' hc hw hs
    have hc' := hc
    cases hc with
    | loop ha =>
      obtain ⟨n1, hn1, e1⟩ := ih1 ha hw hs
      obtain ⟨n2, hn2, e2⟩ := ih2 hc' hw (exec_PV h1 hw hs)
      exact ⟨n1 + n2 + 30, by omega, .loopT hf e1 e2⟩
  | loopF hf =>
    intro c' hc hw hs
    cases hc with
    | loop ha => exact ⟨30, by omega, .loopF hf⟩
  | call _ _ =>
    intro c' hc hw hs
    exact absurd hw id

/-! ## Compiled register programs -/

end NLogN.KFV

end

theorem solution : type_of% @NLogN.KFV.ISim.exec_sol_aux := @NLogN.KFV.ISim.exec_sol_aux
