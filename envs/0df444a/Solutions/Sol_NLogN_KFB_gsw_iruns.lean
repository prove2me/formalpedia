    intro p hp; simp only [l2L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact (g1 ga).1
    · exact (g1 gq).1
    · exact (g1 gb).1
    · exact (g1 gqc).1)
  have v2' : ∀ p ∈ l2L, zsz (p.2.eval t1) ≤ Bb := by
    intro p hp
    have hp' := hp
    simp only [l2L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · rw [(g1 ga).2]; exact v2 _ hp'
    · rw [(g1 gq).2]; exact v2 _ hp'
    · rw [(g1 gb).2]; exact v2 _ hp'
    · rw [(g1 gqc).2]; exact v2 _ hp'
  have st2 : ∀ i : Fin HS, (pushSt t1 (evalP t1 l2L)).G i =
      if i = 1 then .int (vol A0) :: t.G 1 else if i = 2 then .int q :: t.G 2 else
      if i = 3 then .int (vol B) :: t.G 3 else
      if i = 4 then .int ((vol ([q] ++ Cs) : ℕ) : ℤ) :: t.G 4 else t1.G i := by
    intro i
    have e1 := (g1 ga).2; have e2 := (g1 gq).2; have e3 := (g1 gb).2; have e4 := (g1 gc).2
    simp only [l2L, evalP_eq, List.map_cons, List.map_nil, pushSt, Ex.eval] at e1 e2 e3 e4 ⊢
    rw [e1, e2, e3, e4, ea, eq', eb, ec, hqC]
    by_cases h1 : i = 1
    · subst h1; simp [hG1 1 (by decide)]
    by_cases h2 : i = 2
    · subst h2; simp [hG1 2 (by decide)]
    by_cases h3 : i = 3
    · subst h3; simp [hG1 3 (by decide)]
    by_cases h4 : i = 4
    · subst h4; simp [hG1 4 (by decide)]
    simp [h1, h2, h3, h4, Ne.symm h1, Ne.symm h2, Ne.symm h3, Ne.symm h4]
  have M2 := KFC.moveFieldBackF_spec (I := I) (iprog := iprog) (pushSt t1 (evalP t1 l2L)) mid A0 B ([q] ++ Cs) q w R (t.G 1)
    (t.G 2) (t.G 3) (t.G 4) hmid (NLogN.KIL.bnd_pull hb) hqC1 hB hq hA0
    (by rw [st2]; simp [t1]) (by rw [st2]; simp) (by rw [st2]; simp) (by rw [st2]; simp)
    (by rw [st2]; simp)
  have S2 := IRuns.withPushI (I := I) (iprog := iprog) l2L KFC.bwdF t1 Bb P2' v2' (by simp [l2L]) _ R _ M2
  rw [IState.upd_upd_same] at S2
  rw [pull_two_moves] at S2
  refine (S1.seq S2).mono ?_
  -- cost
  have c1 : KFC.cFwdF (vol A0) q (vol (B ++ [q])) (vol Cs) w ≤ (2 * q + 67) * KFC.kap w * V := by
    have := KFC.cFwdF_le (vol A0) q (vol (B ++ [q])) (vol Cs) w hC hBq1 hq hA0
    have e : vol A0 * q * vol (B ++ [q]) * vol Cs = V := by rw [hVe, hBq]; ring
    rw [e] at this; exact this
  have c2 : KFC.cBwdF (vol A0) q (vol B) (vol ([q] ++ Cs)) w ≤ (2 * q + 69) * KFC.kap w * V := by
    have := KFC.cBwdF_le (vol A0) q (vol B) (vol ([q] ++ Cs)) w hqC1 hB hq hA0
    have e : vol A0 * q * vol B * vol ([q] ++ Cs) = V := by rw [hVe, hqC]; ring
    rw [e] at this; exact this
  unfold cSwapEF
  simp only [l1L, l2L, List.length_cons, List.length_nil] at *
  omega

