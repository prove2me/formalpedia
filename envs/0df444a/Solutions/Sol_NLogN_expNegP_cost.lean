    have h1 : ((2 * (2 * n + 10) + 9 : ℕ) : ℤ) < 2 ^ (2 * (2 * n + 10) + 9) := by
      exact_mod_cast Nat.lt_two_pow_self
    have e : (2 : ℤ) ^ (3 * (2 * n + 10) + 14) =
        32 * 2 ^ (2 * (2 * n + 10) + 9) * 2 ^ (2 * n + 10) := by
      rw [show 3 * (2 * n + 10) + 14 = 5 + (2 * (2 * n + 10) + 9) + (2 * n + 10) by omega,
        pow_add, pow_add]; norm_num
    rw [e]
    have : (0 : ℤ) < 2 ^ (2 * n + 10) := by positivity
    nlinarith
  have hPj : zsz (piBits (2 * n + 10) * j) ≤ 3 * (2 * n + 10) + 14 + zsz (j : ℤ) :=
    le_trans (zsz_mul_le (piBits (2 * n + 10)) (j : ℤ)) (by omega)
  rw [zsz_neg]
  exact le_trans (zsz_ediv_le' (piBits (2 * n + 10) * j) (k : ℤ) (Int.natCast_nonneg k)) hPj

end NLogN

end

section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS IntMul.HvdH
set_option maxHeartbeats 4000000
theorem solution (n k j : ℕ) (s : NLogN.IState NLogN.HS) (L16 L17 L18 : List NLogN.Item)
    (h16 : s.G 16 = .int n :: L16) (h17 : s.G 17 = .int k :: L17)
    (h18 : s.G 18 = .int j :: L18) :
    NLogN.expNegP.cost s ≤ NLogN.expNegCost n (NLogN.zsz (k : ℤ)) (NLogN.zsz (j : ℤ)) := by
  have hc : (NLogN.Ex.add (.mul (.reg 17) (.reg 16)) (.neg (.reg 18)) : NLogN.Ex NLogN.HS).eval s =
      (k : ℤ) * n - j := by
    simp (config := {decide := true}) [NLogN.Ex.eval, NLogN.IState.top, h16, h17, h18]; ring
  have zn : NLogN.zsz (n : ℤ) ≤ n := NLogN.zsz_natCast_le_self' n
  have zkn : NLogN.zsz ((k : ℤ) * n) ≤ NLogN.zsz (k : ℤ) + n := le_trans (NLogN.zsz_mul_le _ _) (by omega)
  have zc : NLogN.zsz ((k : ℤ) * n + -j) ≤ NLogN.zsz (k : ℤ) + n + NLogN.zsz (j : ℤ) + 1 := by
    have := NLogN.zsz_add_le ((k : ℤ) * n) (-j); rw [NLogN.zsz_neg] at this; omega
  have hcc := NLogN.RS.pushCost_le (NLogN.Ex.add (.mul (.reg 17) (.reg 16)) (.neg (.reg 18))) s
    (NLogN.zsz (k : ℤ) + n + NLogN.zsz (j : ℤ) + 1) (by
      simp (config := {decide := true}) only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top, h16, h17, h18]
      refine ⟨⟨by omega, by omega, by omega⟩, by omega, zc⟩)
  simp only [NLogN.Ex.size] at hcc
  have hzc : NLogN.zsz ((NLogN.Ex.add (.mul (.reg 17) (.reg 16)) (.neg (.reg 18)) : NLogN.Ex NLogN.HS).eval s) ≤
      NLogN.zsz (k : ℤ) + n + NLogN.zsz (j : ℤ) + 1 := by
    rw [hc]; rw [show (k : ℤ) * n - j = (k : ℤ) * n + -j by ring]; exact zc
  simp only [NLogN.expNegP, NLogN.RS.cost]
  generalize hS : n + NLogN.zsz (k : ℤ) + NLogN.zsz (j : ℤ) + 30 = S
  have hS30 : 30 ≤ S := by omega
  have hS2 : (NLogN.zsz (k : ℤ) + n + NLogN.zsz (j : ℤ) + 1 + 2) ^ 2 ≤ S ^ 10 := by
    calc _ ≤ S ^ 2 := Nat.pow_le_pow_left (by omega) 2
      _ ≤ S ^ 10 := Nat.pow_le_pow_right (by omega) (by omega)
  have hS1 : S ≤ S ^ 10 := by
    calc S = S ^ 1 := (pow_one S).symm
      _ ≤ S ^ 10 := Nat.pow_le_pow_right (by omega) (by omega)
  split_ifs with hneg
  · -- the result is `0`
    have e : NLogN.Ex.cost s (NLogN.Ex.lit 0) + (2 * NLogN.moveCost (NLogN.zsz (NLogN.Ex.eval s (NLogN.Ex.lit 0))) + 19) ≤ 200 := by
      simp [NLogN.Ex.cost, NLogN.Ex.eval, NLogN.moveCost, NLogN.zsz_zero]
    simp only [NLogN.expNegCost]
    rw [hS]
    linarith
  · have hj : j ≤ k * n := by
      rw [hc] at hneg
      have : ¬ ((k : ℤ) * n < j) := by omega
      have : ¬ (((k * n : ℕ) : ℤ) < j) := by push_cast; exact this
      omega
    have hb := NLogN.expNegBody_cost n k j s L16 L17 L18 h16 h17 h18
    have hτ := NLogN.expNeg_tau n k j hj
    have hpi := NLogN.piCost_le 5 239 (2 * n + 10) (by norm_num) (by norm_num)
    have hX := NLogN.expNeg_X_zsz n k j
    have hnS : n + 30 ≤ S := by omega
    have hjS : NLogN.zsz (j : ℤ) + 30 ≤ S := by omega
    have hkS : NLogN.zsz (k : ℤ) + 30 ≤ S := by omega
    generalize NLogN.zsz (-(piBits (2 * n + 10) * j / k)) = A at hb hX
    generalize ((-(-(piBits (2 * n + 10) * j / k))) / log2Bits (2 * n + 10)).toNat = T at hb hτ
    have hT : T ≤ 252 * S ^ 2 := by nlinarith
    have hA : A ≤ 6 * S := by omega
    have hEB : NLogN.expB (2 * n + 10) (3 * (2 * n + 10) + 14) ≤ 40 * S ^ 2 := by
      unfold NLogN.expB; nlinarith
    have p1 : NLogN.expNegFixCost n (2 * n + 10) A T ≤ 10 ^ 20 * (300 * S ^ 2) ^ 5 := by
      unfold NLogN.expNegFixCost
      exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by nlinarith) 5)
    have p2 : NLogN.expNegBB n A T (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 4 ≤ 400 * S ^ 2 := by
      unfold NLogN.expNegBB NLogN.expNegB; nlinarith
    have p3 : (NLogN.expNegBB n A T (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 4) ^ 2 ≤ (400 * S ^ 2) ^ 2 :=
      Nat.pow_le_pow_left p2 2
    have p4 : (2 * n + 10 + 10) ^ 3 ≤ (2 * S) ^ 3 := Nat.pow_le_pow_left (by omega) 3
    have e1 : (300 * S ^ 2) ^ 5 = 300 ^ 5 * S ^ 10 := by ring
    have e2 : (400 * S ^ 2) ^ 2 = 400 ^ 2 * S ^ 4 := by ring
    have e3 : (2 * S) ^ 3 = 8 * S ^ 3 := by ring
    have q3 : S ^ 3 ≤ S ^ 10 := Nat.pow_le_pow_right (by omega) (by omega)
    have q4 : S ^ 4 ≤ S ^ 10 := Nat.pow_le_pow_right (by omega) (by omega)
    rw [e1] at p1; rw [e2] at p3; rw [e3] at p4
    generalize NLogN.expNegFixCost n (2 * n + 10) A T = F at hb p1
    generalize (NLogN.expNegBB n A T (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 4) ^ 2 = G at hb p3
    generalize NLogN.piCost 5 239 (2 * n + 10) = Pc at hb hpi
    simp only [NLogN.expNegCost]
    rw [hS]
    generalize S ^ 10 = W at *
    generalize S ^ 4 = W4 at *
    generalize S ^ 3 = W3 at *
    have : NLogN.zsz (NLogN.Ex.eval s (NLogN.Ex.add ((NLogN.Ex.reg 17).mul (NLogN.Ex.reg 16)) (NLogN.Ex.reg 18).neg)) ≤ S := by
      omega
    nlinarith
end
