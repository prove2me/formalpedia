  have hz1 : ((z : ℝ))⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by exact_mod_cast hz)
  calc 1 - (Q.card : ℝ) / z = 1 + (Q.card : ℝ) * (-((z : ℝ))⁻¹) := by ring
    _ ≤ (1 + (-((z : ℝ))⁻¹)) ^ Q.card := one_add_mul_le_pow (by linarith) _
    _ = ∏ q ∈ Q, (1 - ((z : ℝ))⁻¹) := by rw [Finset.prod_const]; ring
    _ ≤ ∏ q ∈ Q, (1 - ((q : ℝ))⁻¹) := by
        apply Finset.prod_le_prod
        · intro q _; linarith
        · intro q hq
          have : (z : ℝ) ≤ q := by exact_mod_cast (hQ q hq).le
          have : ((q : ℝ))⁻¹ ≤ ((z : ℝ))⁻¹ := inv_anti₀ hzR this
          linarith

