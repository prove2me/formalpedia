    · exact Or.inl ⟨p, List.mem_cons_of_mem _ hp, hpi⟩
    · by_cases hij : i = j
      · exact Or.inl ⟨(j, u), List.mem_cons_self, hij.symm⟩
      · rw [Function.update_of_ne hij] at h'; exact Or.inr h'

