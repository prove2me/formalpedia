theorem ediv_of_tdiv (a r : ℤ) (hr : 0 < r) :
    a.tdiv r + (if a.tmod r < 0 then -1 else 0) = a / r := by
  have h1 := Int.tmod_add_tdiv_mul a r
  have h2 := Int.tmod_lt_of_pos a hr
  have h3 := Int.lt_tmod_of_pos a hr
  split_ifs with h
  · have := ((Int.ediv_emod_unique (a := a) (q := a.tdiv r - 1) (r := a.tmod r + r) hr).2
      ⟨by linarith, by linarith, by linarith⟩).1
    rw [this]; ring
  · have := ((Int.ediv_emod_unique (a := a) (q := a.tdiv r) (r := a.tmod r) hr).2
      ⟨by linarith, by linarith, by linarith⟩).1
    rw [this]; ring

theorem rs_eq (P : ℕ) (x : ℤ) : J6Seg.rs P x = (x + x + 2 ^ P) / 2 ^ (P + 1) := by
  simp only [J6Seg.rs, J6Seg.rq, pow_succ]; ring_nf

section rsE
variable {s : IState HS} {f : Fin HS → List ℤ} {V : Fin HS} {P : ℕ} {x : ℤ} {lv l1 l2 : List ℤ}

theorem rsE_eval (hV : f V = x :: lv) (hP : f rP = 2 ^ P :: l1) (hP1 : f rP1 = 2 ^ (P + 1) :: l2) :
    (rsE V).eval (encK s f) = J6Seg.rs P x := by
  simp only [rsE, Ex.eval, top_encK hV, top_encK hP, top_encK hP1]
  rw [ediv_of_tdiv _ _ (by positivity), rs_eq]

theorem rsE_clean (hV5 : V.val < 56) : (rsE V).Clean := by
  intro i hi
  have : i = V ∨ i = rP ∨ i = rP1 := by simp [rsE, Ex.regs] at hi; tauto
  rcases this with rfl | rfl | rfl
  · exact clean_reg hV5 _ (by simp [Ex.regs])
  · exact clean_reg (i := rP) (by decide) _ (by simp [Ex.regs])
  · exact clean_reg (i := rP1) (by decide) _ (by simp [Ex.regs])

theorem rsE_lin : (rsE V).Lin := by simp [rsE, Ex.Lin]

theorem rsE_ok (hV : f V = x :: lv) (hP : f rP = 2 ^ P :: l1) (hP1 : f rP1 = 2 ^ (P + 1) :: l2) :
    (rsE V).ok (encK s f) := by
  simp only [rsE, Ex.ok, Ex.eval, top_encK hV, top_encK hP, top_encK hP1]
  and_intros <;> (try exact isInt_encK hV) <;> (try exact isInt_encK hP) <;>
    (try exact isInt_encK hP1) <;> (try exact ⟨P + 1, rfl⟩) <;> (try (split_ifs <;> trivial))

theorem zsz_rs_le (P : ℕ) (x : ℤ) : zsz (J6Seg.rs P x) ≤ zsz (x + x + 2 ^ P) := by
  rw [rs_eq]
  apply zsz_le_iff.2
  exact lt_of_le_of_lt (Int.natAbs_ediv_le_natAbs _ _) (zsz_le_iff.1 le_rfl)

theorem rsE_bnd {B : ℕ} (hV : f V = x :: lv) (hP : f rP = 2 ^ P :: l1)
    (hP1 : f rP1 = 2 ^ (P + 1) :: l2) (hx : zsz x + 2 ≤ B) (hPB : P + 3 ≤ B) :
    (rsE V).Bnd (encK s f) B := by
  have e1 : zsz (x + x) ≤ B := by have := zsz_add_le x x; omega
  have e2 : zsz ((2 : ℤ) ^ P) ≤ B := by rw [zsz_two_pow]; omega
  have e3 : zsz (x + x + 2 ^ P) ≤ B := by
    have := zsz_add_le (x + x) (2 ^ P); have := zsz_add_le x x; rw [zsz_two_pow] at *; omega
  have e4 : zsz ((2 : ℤ) ^ (P + 1)) ≤ B := by rw [zsz_two_pow]; omega
  have e5 : zsz (-1 : ℤ) ≤ B := by rw [zsz_neg, zsz_one]; omega
  have e6 : zsz (0 : ℤ) ≤ B := by rw [zsz_zero]; omega
  have e7 := (zsz_rs_le P x).trans e3
  have e8 := ediv_of_tdiv (x + x + 2 ^ P) (2 ^ (P + 1)) (by positivity)
  rw [← rs_eq] at e8
  simp only [rsE, Ex.Bnd, Ex.eval, top_encK hV, top_encK hP, top_encK hP1, e8]
  and_intros <;> (try assumption) <;> (try (split_ifs <;> assumption))
  all_goals omega

end rsE

theorem sp_rdP_sol_aux {V O C R : Fin HS} (hVO : V ≠ O) (hVC : V ≠ C) (hOC : O ≠ C) (hRC : R ≠ C)
    (hRV : R ≠ V) (hRO : R ≠ O) (hPV : rP ≠ V) (hPO : rP ≠ O) (hPC : rP ≠ C) (hQV : rP1 ≠ V)
    (hQO : rP1 ≠ O) (hQC : rP1 ≠ C)
    (hV5 : V.val < 56) (hO5 : O.val < 56) (hC5 : C.val < 56) (hR5 : R.val < 56)
    (s : IState HS) (f : Fin HS → List ℤ) (P : ℕ) (u : List GI) (lv lr l1 l2 : List ℤ)
    (hV : f V = gsw u ++ lv) (hC : f C = []) (hR : f R = (u.length : ℤ) :: lr)
    (hP : f rP = 2 ^ P :: l1) (hP1 : f rP1 = 2 ^ (P + 1) :: l2) (B : ℕ)
    (hu : ∀ z ∈ u, zsz z.1 + 2 ≤ B ∧ zsz z.2 + 2 ≤ B) (hPB : P + 3 ≤ B)
    (hn : zsz (u.length : ℤ) ≤ B) :
    Sp (rdP V O C R) (encK s f)
      (encK s (Function.update (Function.update f V lv) O
        (gflat (u.reverse.map (rsG P)) ++ f O))) ((u.length + 1) * 200000 * (B + 2)) := by
  set N := u.length with hN
  let F : ℕ → Fin HS → List ℤ := fun k => Function.update (Function.update f V
    (gsw (u.drop k) ++ lv)) O (gflat ((u.take k).reverse.map (rsG P)) ++ f O)
  have hF0 : F 0 = f := by
    funext j; simp only [F, Function.update_apply, List.drop_zero, List.take_zero, List.reverse_nil,
      List.map_nil, gflat_nil, List.nil_append]
    split_ifs with h1 h2 <;> (try subst h1) <;> (try subst h2) <;> simp_all
  have hFN : F N = Function.update (Function.update f V lv) O
      (gflat (u.reverse.map (rsG P)) ++ f O) := by
    simp only [F, hN, List.drop_length, List.take_length, gsw_nil, List.nil_append]
  have hFC : ∀ k, F k C = [] := fun k => by
    simp only [F, Function.update_apply, if_neg hVC.symm, if_neg hOC.symm, hC]
  have hFR : F 0 R = (N : ℤ) :: lr := by rw [hF0, hR]
  have hsz : (rsE V).size = 18 := rfl
  have hbody : ∀ k < N, Sp (.seq (.push O (rsE V)) (.seq (.pop V) (.seq (.push O (rsE V)) (.pop V))))
      (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) (100000 * (B + 2)) := by
    intro k hk
    have hd : u.drop k = u[k] :: u.drop (k + 1) := List.drop_eq_getElem_cons hk
    have ht : u.take (k + 1) = u.take k ++ [u[k]] := (List.take_concat_get' u k hk).symm
    have hb := hu _ (List.getElem_mem hk)
    set G := Function.update (F k) C [(N : ℤ) - k] with hG
    have gV : G V = u[k].2 :: u[k].1 :: (gsw (u.drop (k + 1)) ++ lv) := by
      simp only [hG, F, Function.update_apply, if_neg hVC, if_neg hVO, if_true, hd, gsw_cons,
        List.cons_append]
    have gP : G rP = 2 ^ P :: l1 := by
      simp only [hG, F, Function.update_apply, if_neg hPC, if_neg hPO, if_neg hPV, hP]
    have gQ : G rP1 = 2 ^ (P + 1) :: l2 := by
      simp only [hG, F, Function.update_apply, if_neg hQC, if_neg hQO, if_neg hQV, hP1]
    have s1 := Sp.push s G (i := O) (e := rsE V) (B := B) hO5 (rsE_clean hV5) (rsE_ok gV gP gQ)
      rsE_lin (rsE_bnd gV gP gQ (by omega) hPB)
    rw [rsE_eval gV gP gQ, hsz] at s1
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G O (J6Seg.rs P u[k].2 :: G O) := ⟨_, rfl⟩
    rw [← hG1] at s1
    have s2 := sp_pop (s := s) G1 (i := V) hV5 (by rw [hG1, Function.update_apply, if_neg hVO, gV])
      (show zsz u[k].2 ≤ B by omega)
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 V (u[k].1 :: (gsw (u.drop (k + 1)) ++ lv)) :=
      ⟨_, rfl⟩
    rw [← hG2] at s2
    have g2V : G2 V = u[k].1 :: (gsw (u.drop (k + 1)) ++ lv) := by rw [hG2, Function.update_apply, if_pos rfl]
    have g2P : G2 rP = 2 ^ P :: l1 := by
      rw [hG2, Function.update_apply, if_neg hPV, hG1, Function.update_apply, if_neg hPO, gP]
    have g2Q : G2 rP1 = 2 ^ (P + 1) :: l2 := by
      rw [hG2, Function.update_apply, if_neg hQV, hG1, Function.update_apply, if_neg hQO, gQ]
    have s3 := Sp.push s G2 (i := O) (e := rsE V) (B := B) hO5 (rsE_clean hV5) (rsE_ok g2V g2P g2Q)
      rsE_lin (rsE_bnd g2V g2P g2Q (by omega) hPB)
    rw [rsE_eval g2V g2P g2Q, hsz] at s3
    obtain ⟨G3, hG3⟩ : ∃ G3, G3 = Function.update G2 O (J6Seg.rs P u[k].1 :: G2 O) := ⟨_, rfl⟩
    rw [← hG3] at s3
    have s4 := sp_pop (s := s) G3 (i := V) hV5 (by rw [hG3, Function.update_apply, if_neg hVO, g2V])
      (show zsz u[k].1 ≤ B by omega)
    refine ((s1.seq (s2.seq (s3.seq s4))).congr ?_).mono (by omega)
    congr 1; funext j
    simp only [hG3, hG2, hG1, hG, F, Function.update_apply]
    by_cases h1 : j = C
    · subst h1; simp [hVC.symm, hOC.symm]
    by_cases h2 : j = V
    · subst h2; simp [hVC, hVO]
    by_cases h3 : j = O
    · subst h3; simp only [hVO.symm, hOC, if_false, if_true, ↓reduceIte, ht,
        List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
        List.singleton_append, List.map_cons, gflat_cons, List.cons_append, rsG]
    · simp [h1, h2, h3]
  have H := Sp.rep (C := C) (n := .reg R) (b := .seq (.push O (rsE V)) (.seq (.pop V)
    (.seq (.push O (rsE V)) (.pop V)))) (s := s) (F := F) (N := N) (B := B) (c := 100000 * (B + 2))
    hC5 hFC (by simp [RS.writes, hVC.symm, hOC.symm]) (clean_reg hR5) (ok_reg hFR)
    trivial (bnd_reg hFR hn) (by rw [eval_reg hFR]) hbody
  rw [hF0, hFN] at H
  refine H.mono ?_
  simp only [Ex.size]; nlinarith

end J6Seg.KR

