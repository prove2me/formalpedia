/-! ## Section 16: Term Size and Cost Model -/

/-- Size of a higher-order term (number of constructors). -/
def termSize : ∀ {Γ : Ctx} {τ : HOType}, HOTerm Γ τ → Nat
  | _, _, .var _ => 1
  | _, _, .lam body => 1 + termSize body
  | _, _, .app f arg => 1 + termSize f + termSize arg


