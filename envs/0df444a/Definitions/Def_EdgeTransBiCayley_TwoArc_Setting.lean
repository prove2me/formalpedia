-- title:
--   pp. 1–4 — BiCay(H, R, L, S), R(H) and its normaliser, σ_{α,g}, δ_{α,x,y}, F, I, s-arcs and transitivity
-- statement:
--   This file fixes the objects of M. Conder, J.-X. Zhou, Y.-Q. Feng and M.-M. Zhang, *Edge-transitive bi-Cayley graphs*. Throughout, $H$ is a finite group with identity $1$.
--
--   **Bi-Cayley graphs.** Let $R, L, S \subseteq H$ with $|R| = |L|$, $1 \notin R = R^{-1}$ and $1 \notin L = L^{-1}$. The bi-Cayley graph $\Gamma = \mathrm{BiCay}(H,R,L,S)$ has vertex set $H_0 \cup H_1$, two disjoint copies of $H$ (the copy of $h$ in $H_i$ is written $h_i$), and edges
--   $$\{h_0,(xh)_0\},\qquad \{h_1,(yh)_1\},\qquad \{h_0,(zh)_1\}\qquad (h\in H,\ x\in R,\ y\in L,\ z\in S).$$
--   The side conditions on $R$ and $L$ make these edges undirected and loop-free.
--
--   **Right multiplication and its normaliser.** For $g \in H$ the map $R(g) : h_i \mapsto (hg)_i$ ($i = 0,1$) is an automorphism of $\Gamma$; $R(H) = \{R(g) : g \in H\}$ is the subgroup of $\mathrm{Aut}(\Gamma)$ it forms, and $X = N_{\mathrm{Aut}(\Gamma)}(R(H))$ is its normaliser in the full automorphism group.
--
--   **The permutations (2.1) and the sets (2.2).** For $\alpha \in \mathrm{Aut}(H)$ and $x, y, g \in H$ (exponents denote images under $\alpha$):
--   $$\delta_{\alpha,x,y} : h_0 \mapsto (xh^\alpha)_1,\ h_1 \mapsto (yh^\alpha)_0, \qquad \sigma_{\alpha,g} : h_0 \mapsto (h^\alpha)_0,\ h_1 \mapsto (gh^\alpha)_1 .$$
--   The pair $(\alpha, g)$ satisfies the condition of $\mathrm{F}$ when $R^\alpha = R$, $L^\alpha = g^{-1}Lg$ and $S^\alpha = g^{-1}S$; the triple $(\alpha,x,y)$ satisfies the condition of $\mathrm{I}$ when $R^\alpha = x^{-1}Lx$, $L^\alpha = y^{-1}Ry$ and $S^\alpha = y^{-1}S^{-1}x$.
--
--   **Arcs and transitivity.** For $s \ge 0$, an $s$-arc is a tuple $(v_0,\dots,v_s)$ of vertices with $v_{i-1}$ adjacent to $v_i$ for $1 \le i \le s$ and $v_{i-1} \ne v_{i+1}$ for $1 \le i \le s-1$. A subgroup $K \le \mathrm{Aut}(\Gamma)$ is transitive on vertices, on edges, on arcs (ordered pairs of adjacent vertices) or on $s$-arcs if any one such object can be mapped to any other by an element of $K$. $K$ acts *semisymmetrically* if it is edge-transitive but not vertex-transitive. $\Gamma$ is *normal locally arc-transitive* if the stabiliser $X_{1_0}$ of the vertex $1_0$ in $X$ is transitive on the neighbourhood $\Gamma(1_0)$. For $\Delta \subseteq H$, $\mathrm{Aut}(H,\Delta)$ is the setwise stabiliser $\{\alpha \in \mathrm{Aut}(H) : \Delta^\alpha = \Delta\}$.
--
--   These objects are shared by every statement of the mission.
--
--   **Formalization Note** The vertex set is `H ⊕ H`, with `Sum.inl h` $= h_0$ and `Sum.inr h` $= h_1$. Adjacency is defined directly by the three edge rules, so no symmetrisation happens: the side conditions on $R$ and $L$ are fields of the data structure. $R(H)$ is the subgroup generated by the automorphisms $R(g)$, and $X$ is `Subgroup.normalizer` of it in the group `Γ ≃g Γ`. Automorphisms of $H$ are `MulAut H`; the paper's right-exponent notation $h^\alpha$ is written `α h`, and $\Delta^\alpha$ is the image `Δ.image α`. $\sigma_{\alpha,g}$ and $\delta_{\alpha,x,y}$ are permutations of `H ⊕ H`; the conditions of (2.2) are predicates on $(\alpha,g)$ and $(\alpha,x,y)$, with $g^{-1}Lg$ written as the pointwise product $(g^{-1}L)\{g\}$. An $s$-arc is a function on `Fin (s+1)` with the adjacency and the "three consecutive distinct" conditions. The paper's standing assumption that groups and graphs are finite is imposed in each theorem.
-- source:
--   Conder, Zhou, Feng and Zhang, Edge-transitive bi-Cayley graphs, arXiv:1606.04625v1, pp. 1–4, §1 (definition of BiCay, R(H), normal locally arc-transitive) and §2.1–2.2 (s-arcs, semisymmetric, setwise stabiliser, R(g), (2.1), (2.2))

import Mathlib
open Pointwise

namespace EdgeTransBiCayley.TwoArc

/-- The data of `BiCay(H,R,L,S)` in §1, p. 1. -/
structure BiCayData (H : Type*) [Group H] [DecidableEq H] where
  R : Finset H
  L : Finset H
  S : Finset H
  inv_R : R⁻¹ = R
  inv_L : L⁻¹ = L
  one_notMem_R : (1 : H) ∉ R
  one_notMem_L : (1 : H) ∉ L
  card_R_eq_card_L : R.card = L.card

private theorem inv_mem_iff {H : Type*} [Group H] [DecidableEq H]
    (A : Finset H) (hA : A⁻¹ = A) (x : H) : x⁻¹ ∈ A ↔ x ∈ A := by
  calc
    x⁻¹ ∈ A ↔ x⁻¹ ∈ A⁻¹ := by rw [hA]
    _ ↔ x ∈ A := by simp

/-- The two copies of `H` have internal edges from `R,L` and cross edges from `S`. -/
def BiCayData.graph {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H) :
    SimpleGraph (H ⊕ H) where
  Adj
    | .inl h, .inl h' => h' * h⁻¹ ∈ D.R
    | .inr h, .inr h' => h' * h⁻¹ ∈ D.L
    | .inl h, .inr h' => h' * h⁻¹ ∈ D.S
    | .inr h, .inl h' => h * h'⁻¹ ∈ D.S
  symm := by
    constructor
    intro a b hab
    cases a with
    | inl a =>
      cases b with
      | inl b =>
        change a * b⁻¹ ∈ D.R
        change b * a⁻¹ ∈ D.R at hab
        rw [← inv_mem_iff D.R D.inv_R (b * a⁻¹)] at hab
        simpa only [mul_inv_rev, inv_inv] using hab
      | inr b => exact hab
    | inr a =>
      cases b with
      | inl b => exact hab
      | inr b =>
        change a * b⁻¹ ∈ D.L
        change b * a⁻¹ ∈ D.L at hab
        rw [← inv_mem_iff D.L D.inv_L (b * a⁻¹)] at hab
        simpa only [mul_inv_rev, inv_inv] using hab
  loopless := by
    constructor
    intro a haa
    cases a with
    | inl a =>
      change a * a⁻¹ ∈ D.R at haa
      exact D.one_notMem_R (by simpa using haa)
    | inr a =>
      change a * a⁻¹ ∈ D.L at haa
      exact D.one_notMem_L (by simpa using haa)

instance {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H) :
    DecidableRel D.graph.Adj := by
  intro a b
  cases a <;> cases b <;> dsimp [BiCayData.graph] <;> infer_instance

/-- Right multiplication by `g`, the paper's `R(g)`. -/
def rightMulPerm {H : Type*} [Group H] (g : H) : Equiv.Perm (H ⊕ H) where
  toFun := fun v => match v with
    | .inl h => .inl (h * g)
    | .inr h => .inr (h * g)
  invFun := fun v => match v with
    | .inl h => .inl (h * g⁻¹)
    | .inr h => .inr (h * g⁻¹)
  left_inv := by intro v; cases v <;> simp
  right_inv := by intro v; cases v <;> simp

/-- `R(g)` as an automorphism of the bi-Cayley graph. -/
def rightMul {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H) (g : H) :
    D.graph ≃g D.graph where
  toEquiv := rightMulPerm g
  map_rel_iff' := by
    intro a b
    cases a <;> cases b <;>
      simp only [BiCayData.graph, rightMulPerm, Equiv.coe_fn_mk] <;>
      group

/-- The right regular subgroup `R(H)`. -/
def RH {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H) :
    Subgroup (D.graph ≃g D.graph) := Subgroup.closure (Set.range (rightMul D))

/-- The normaliser `N_{Aut(Γ)}(R(H))`. -/
def normRH {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H) :
    Subgroup (D.graph ≃g D.graph) := Subgroup.normalizer (RH D : Set (D.graph ≃g D.graph))

/-- The permutation `σ_{α,g}` from (2.1). -/
def sigmaPerm {H : Type*} [Group H] (α : MulAut H) (g : H) : Equiv.Perm (H ⊕ H) where
  toFun := fun v => match v with
    | .inl h => .inl (α h)
    | .inr h => .inr (g * α h)
  invFun := fun v => match v with
    | .inl h => .inl (α.symm h)
    | .inr h => .inr (α.symm (g⁻¹ * h))
  left_inv := by intro v; cases v <;> simp
  right_inv := by intro v; cases v <;> simp

/-- The permutation `δ_{α,x,y}` from (2.1). -/
def deltaPerm {H : Type*} [Group H] (α : MulAut H) (x y : H) : Equiv.Perm (H ⊕ H) where
  toFun := fun v => match v with
    | .inl h => .inr (x * α h)
    | .inr h => .inl (y * α h)
  invFun := fun v => match v with
    | .inl h => .inr (α.symm (y⁻¹ * h))
    | .inr h => .inl (α.symm (x⁻¹ * h))
  left_inv := by intro v; cases v <;> simp
  right_inv := by intro v; cases v <;> simp

/-- The condition defining membership in `F` in (2.2). -/
def IsF {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H)
    (α : MulAut H) (g : H) : Prop :=
  D.R.image α = D.R ∧
  D.L.image α = (g⁻¹ • D.L) * ({g} : Finset H) ∧
  D.S.image α = g⁻¹ • D.S

/-- The condition defining membership in `I` in (2.2). -/
def IsI {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H)
    (α : MulAut H) (x y : H) : Prop :=
  D.R.image α = (x⁻¹ • D.L) * ({x} : Finset H) ∧
  D.L.image α = (y⁻¹ • D.R) * ({y} : Finset H) ∧
  D.S.image α = (y⁻¹ • D.S⁻¹) * ({x} : Finset H)

/-- A subgroup acts transitively on the vertices. -/
def IsVertexTransitiveOn {V : Type*} (G : SimpleGraph V)
    (K : Subgroup (G ≃g G)) : Prop :=
  ∀ u v : V, ∃ φ ∈ K, φ u = v

/-- A subgroup acts transitively on the undirected edges. -/
def IsEdgeTransitiveOn {V : Type*} (G : SimpleGraph V)
    (K : Subgroup (G ≃g G)) : Prop :=
  ∀ e ∈ G.edgeSet, ∀ e' ∈ G.edgeSet, ∃ φ ∈ K, Sym2.map φ e = e'

/-- A subgroup acts transitively on directed edges. -/
def IsArcTransitiveOn {V : Type*} (G : SimpleGraph V)
    (K : Subgroup (G ≃g G)) : Prop :=
  ∀ u v u' v', G.Adj u v → G.Adj u' v' →
    ∃ φ ∈ K, φ u = u' ∧ φ v = v'

/-- An `s`-arc of `G` (§2.1, p. 4): an `(s+1)`-tuple `(v₀, …, v_s)` of vertices in which any two
consecutive entries are adjacent and any three consecutive entries are distinct, i.e.
`v_{i-1} ≠ v_{i+1}` for `1 ≤ i ≤ s - 1`. -/
structure SArc {V : Type*} (G : SimpleGraph V) (s : ℕ) where
  toFun : Fin (s + 1) → V
  adj : ∀ i : Fin s, G.Adj (toFun i.castSucc) (toFun i.succ)
  ne : ∀ i j : Fin (s + 1), j.val = i.val + 2 → toFun i ≠ toFun j

/-- A subgroup `K ≤ Aut(G)` acts transitively on the `s`-arcs of `G`. -/
def IsSArcTransitiveOn {V : Type*} (G : SimpleGraph V)
    (K : Subgroup (G ≃g G)) (s : ℕ) : Prop :=
  ∀ a b : SArc G s, ∃ φ ∈ K, ∀ i, φ (a.toFun i) = b.toFun i

/-- A subgroup acts semisymmetrically: transitive on edges but not on vertices
(Proposition 3.3(b), the sense of "semisymmetric", p. 4, restricted to `K`). -/
def IsSemisymmetricOn {V : Type*} (G : SimpleGraph V)
    (K : Subgroup (G ≃g G)) : Prop :=
  IsEdgeTransitiveOn G K ∧ ¬ IsVertexTransitiveOn G K

/-- `Γ = BiCay(H,R,L,S)` is normal locally arc-transitive (p. 2): the stabiliser in
`N_{Aut(Γ)}(R(H))` of the vertex `1₀` is transitive on the neighbourhood of `1₀`. -/
def IsNormalLocallyArcTransitive {H : Type*} [Group H] [DecidableEq H]
    (D : BiCayData H) : Prop :=
  ∀ u ∈ D.graph.neighborSet (.inl 1), ∀ v ∈ D.graph.neighborSet (.inl 1),
    ∃ φ ∈ normRH D, φ (.inl 1) = .inl 1 ∧ φ u = v

/-- `Aut(H, Δ)`: the setwise stabiliser of `Δ ⊆ H` in `Aut(H)` (§2.1, p. 4). -/
def autStab {H : Type*} [Group H] [DecidableEq H] (Δ : Finset H) : Set (MulAut H) :=
  {α | Δ.image α = Δ}

end EdgeTransBiCayley.TwoArc


