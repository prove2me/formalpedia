/-! ### Part 1: Elementary Buchstab Bounds & Six-Variable AM-GM Tangent Lower Bound -/

private lemma mul_le_mean_sq (x y : ℝ) : x * y ≤ ((x + y) / 2) ^ 2 := by
  have h : ((x + y) / 2) ^ 2 - x * y = (x - y) ^ 2 / 4 := by ring
  have hnn : 0 ≤ (x - y) ^ 2 / 4 := div_nonneg (sq_nonneg (x - y)) (by norm_num)
  linarith

private lemma buchstab_integral_eq {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {a b : ℝ} (ha : 2 ≤ a) (hab : a ≤ b) :
    b * ω b - a * ω a = ∫ s in (a - 1)..(b - 1), ω s := by
  have hcont_w : ContinuousOn ω (Icc a b) :=
    hω.1.mono (fun x hx => by change 1 ≤ x; linarith [hx.1])
  have hcont_mul : ContinuousOn (fun t => t * ω t) (Icc a b) :=
    continuousOn_id.mul hcont_w
  have hderiv_open : ∀ x ∈ Ioo a b, HasDerivAt (fun t => t * ω t) (ω (x - 1)) x :=
    fun x hx => hω.2.2 x (lt_of_le_of_lt ha hx.1)
  have hcont_shift : ContinuousOn (fun t => ω (t - 1)) (Icc a b) := by
    apply hω.1.comp (continuousOn_id.sub continuousOn_const)
    intro x hx; change 1 ≤ x - 1; linarith [hx.1]
  have hint : IntervalIntegrable (fun t => ω (t - 1)) volume a b :=
    hcont_shift.intervalIntegrable_of_Icc hab
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hab hcont_mul hderiv_open hint
  rw [← hftc, intervalIntegral.integral_comp_sub_right]

private lemma buchstab_nonneg_on_Icc {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    ∀ n : ℕ, ∀ u : ℝ, 1 ≤ u → u ≤ (n : ℝ) + 2 → 0 ≤ ω u := by
  intro n
  induction n with
  | zero =>
    intro u hu1 hu2
    push_cast at hu2
    rw [hω.2.1 u hu1 (by linarith)]
    positivity
  | succ n ih =>
    intro u hu1 hu2
    by_cases hle : u ≤ (n : ℝ) + 2
    · exact ih u hu1 hle
    · push Not at hle
      set b : ℝ := (n : ℝ) + 2
      have hb2 : 2 ≤ b := by dsimp only [b]; linarith [Nat.cast_nonneg (α := ℝ) n]
      have hbu : b ≤ u := le_of_lt hle
      have heq := buchstab_integral_eq hω hb2 hbu
      have hwb : 0 ≤ ω b := ih b (by linarith) (le_refl b)
      have hint_nn : 0 ≤ ∫ s in (b - 1)..(u - 1), ω s := by
        apply intervalIntegral.integral_nonneg (by linarith)
        intro s hs
        exact ih s (by linarith [hs.1]) (by push_cast at hu2; linarith [hs.2])
      have hu_pos : 0 < u := by linarith
      have hbw : 0 ≤ b * ω b := mul_nonneg (by linarith) hwb
      have hmul : 0 ≤ u * ω u := by linarith
      exact nonneg_of_mul_nonneg_right hmul hu_pos

private lemma buchstab_nonneg {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    (u : ℝ) : 0 ≤ ω u := by
  by_cases h1 : u < 1
  · rw [hz u h1]
  · push Not at h1
    exact buchstab_nonneg_on_Icc hω (Nat.ceil u) u h1 (by linarith [Nat.le_ceil u])

private lemma integral_inv_le_trapezoid {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, (1 / s : ℝ) ≤ (b - a) / 2 * (1 / a + 1 / b) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont1 : ContinuousOn (fun s : ℝ => 1 / s) (Icc a b) :=
    continuousOn_const.div continuousOn_id (fun s hs => ne_of_gt (lt_of_lt_of_le ha hs.1))
  have hcont2 : ContinuousOn (fun s : ℝ => (a + b - s) / (a * b)) (Icc a b) :=
    (continuousOn_const.sub continuousOn_id).div_const (a * b)
  have hmono : ∫ s in a..b, (1 / s : ℝ) ≤ ∫ s in a..b, (a + b - s) / (a * b) := by
    apply intervalIntegral.integral_mono_on hab
      (hcont1.intervalIntegrable_of_Icc hab) (hcont2.intervalIntegrable_of_Icc hab)
    intro s hs
    have hs_pos : 0 < s := lt_of_lt_of_le ha hs.1
    rw [div_le_div_iff₀ hs_pos (mul_pos ha hb)]
    have hfac : (a + b - s) * s - 1 * (a * b) = (s - a) * (b - s) := by ring
    have hnn : 0 ≤ (s - a) * (b - s) := mul_nonneg (sub_nonneg.mpr hs.1) (sub_nonneg.mpr hs.2)
    linarith
  have heval : ∫ s in a..b, (a + b - s) / (a * b) = (b - a) / 2 * (1 / a + 1 / b) := by
    have hderiv : ∀ x ∈ uIcc a b,
        HasDerivAt (fun s : ℝ => ((a + b) * s - s ^ 2 / 2) / (a * b)) ((a + b - x) / (a * b)) x := by
      intro x _
      have h1 : HasDerivAt (fun s : ℝ => (a + b) * s) (a + b) x := by
        simpa using (hasDerivAt_id x).const_mul (a + b)
      have h2 : HasDerivAt (fun s : ℝ => s ^ 2 / 2) x x := by
        simpa [mul_comm] using ((hasDerivAt_pow 2 x).div_const 2)
      exact (h1.sub h2).div_const (a * b)
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont2.intervalIntegrable_of_Icc hab)]
    field_simp
    ring
  linarith

private lemma buchstab_max_propagate {ω : ℝ → ℝ} (hω : IsBuchstab ω) {a M : ℝ}
    (ha : 1 ≤ a) (hbase : ∀ u ∈ Icc a (a + 1), ω u ≤ M) :
    ∀ u : ℝ, a ≤ u → ω u ≤ M := by
  have hstep : ∀ n : ℕ, ∀ u ∈ Icc a (a + 1 + n), ω u ≤ M := by
    intro n
    induction n with
    | zero =>
      intro u hu; exact hbase u (by simpa using hu)
    | succ n ih =>
      intro u hu
      by_cases hle : u ≤ a + 1 + n
      · exact ih u ⟨hu.1, hle⟩
      · push Not at hle
        set b : ℝ := a + 1 + n
        have hn_nn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
        have hb2 : 2 ≤ b := by dsimp only [b]; linarith
        have hbu : b ≤ u := le_of_lt hle
        have heq := buchstab_integral_eq hω hb2 hbu
        have hwb : ω b ≤ M := ih b ⟨by dsimp only [b]; linarith, le_refl b⟩
        have hcont_sub : ContinuousOn ω (Icc (b - 1) (u - 1)) :=
          hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
        have hint_le : ∫ s in (b - 1)..(u - 1), ω s ≤ (u - b) * M := by
          have h1 : ∫ s in (b - 1)..(u - 1), ω s ≤ ∫ _ in (b - 1)..(u - 1), M := by
            apply intervalIntegral.integral_mono_on (by linarith)
              (hcont_sub.intervalIntegrable_of_Icc (by linarith))
              intervalIntegrable_const
            intro s hs
            exact ih s ⟨by dsimp only [b] at hs; linarith [hs.1],
              by dsimp only [b]; push_cast at hu; linarith [hs.2, hu.2]⟩
          rw [intervalIntegral.integral_const, smul_eq_mul] at h1
          linarith
        have hu_pos : 0 < u := by linarith
        have hbw : b * ω b ≤ b * M := mul_le_mul_of_nonneg_left hwb (by linarith)
        have hlin_M : b * M + (u - b) * M = u * M := by ring
        have hmul : u * ω u ≤ u * M := by linarith
        exact le_of_mul_le_mul_left hmul hu_pos
  intro u hu
  exact hstep (Nat.ceil (u - a)) u ⟨hu, by linarith [Nat.le_ceil (u - a)]⟩

private lemma buchstab_le_seven_twelfths {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {u : ℝ} (hu : 2 ≤ u) : ω u ≤ 7 / 12 := by
  apply buchstab_max_propagate hω (a := 2) (M := 7 / 12) (by norm_num) _ u hu
  intro t ht
  have ht2 : 2 ≤ t := ht.1
  have ht3 : t ≤ 3 := by linarith [ht.2]
  have heq := buchstab_integral_eq hω (le_refl 2) ht2
  have hw2 : ω 2 = 1 / 2 := hω.2.1 2 (by norm_num) (by norm_num)
  have hint_eq : ∫ s in (2 - 1 : ℝ)..(t - 1), ω s = ∫ s in (1 : ℝ)..(t - 1), (1 / s : ℝ) := by
    have h1 : (2 - 1 : ℝ) = 1 := by norm_num
    rw [h1]
    apply intervalIntegral.integral_congr
    intro s hs
    rw [uIcc_of_le (by linarith)] at hs
    exact hω.2.1 s hs.1 (by linarith [hs.2])
  have htrap := integral_inv_le_trapezoid (a := (1 : ℝ)) (b := t - 1) (by norm_num) (by linarith)
  have hsubt : t - 1 - 1 = t - 2 := by ring
  rw [hsubt] at htrap
  have ht_pos : 0 < t := by linarith
  have ht1_pos : 0 < t - 1 := by linarith
  have hle : t * ω t ≤ 1 + (t - 2) / 2 * (1 / 1 + 1 / (t - 1)) := by
    rw [hw2, hint_eq] at heq; linarith
  have hmul : (t - 1) * (t * ω t) ≤ (t - 1) * (t * (7 / 12)) := by
    have h1 : (t - 1) * (1 + (t - 2) / 2 * (1 / 1 + 1 / (t - 1))) = (t * t - 2) / 2 := by
      field_simp; ring
    have h2 : (t - 1) * (t * ω t) ≤ (t * t - 2) / 2 := by
      have hm := mul_le_mul_of_nonneg_left hle (le_of_lt ht1_pos)
      rwa [h1] at hm
    have h3 : (t * t - 2) / 2 ≤ (t - 1) * (t * (7 / 12)) := by
      have hsq : 0 ≤ (3 - t) * (4 - t) := mul_nonneg (by linarith) (by linarith)
      linarith
    linarith
  have hmul2 : t * ω t ≤ t * (7 / 12) := le_of_mul_le_mul_left hmul ht1_pos
  exact le_of_mul_le_mul_left hmul2 ht_pos

private lemma buchstab_affine_envelope {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {u0 u : ℝ} (h0 : 1 ≤ u0) (h2 : u0 ≤ 2) (hu : u0 ≤ u) :
    ω u ≤ (5 / 6 : ℝ) / u0 + 1 / 6 := by
  have hp : 0 < u0 := by linarith
  have hlin : (5 / 6 : ℝ) / u0 + 1 / 6 = (5 / 6 : ℝ) * (1 / u0) + 1 / 6 := by ring
  rw [hlin]
  by_cases hu2 : u ≤ 2
  · rw [hω.2.1 u (by linarith) hu2]
    have hi : 1 / u ≤ 1 / u0 := one_div_le_one_div_of_le hp hu
    have hi0 : (1 : ℝ) / u0 ≤ 1 := (div_le_iff₀ hp).2 (by linarith)
    linarith
  · push Not at hu2
    have hw := buchstab_le_seven_twelfths hω (le_of_lt hu2)
    have hi0 : (1 : ℝ) / 2 ≤ 1 / u0 := (le_div_iff₀ hp).2 (by linarith)
    linarith

private lemma am_gm_4 {a b c d : ℝ} (_ha : 0 ≤ a) (_hb : 0 ≤ b) (hc : 0 ≤ c) (hd : 0 ≤ d) :
    a * b * c * d ≤ ((a + b + c + d) / 4) ^ 4 := by
  have hab := mul_le_mean_sq a b
  have hcd := mul_le_mean_sq c d
  have hprod : (a * b) * (c * d) ≤ ((a + b) / 2) ^ 2 * ((c + d) / 2) ^ 2 :=
    mul_le_mul hab hcd (mul_nonneg hc hd) (sq_nonneg _)
  have hm := mul_le_mean_sq ((a + b) / 2) ((c + d) / 2)
  have hm_nn : 0 ≤ ((a + b) / 2) * ((c + d) / 2) := by positivity
  have hm2 : (((a + b) / 2) * ((c + d) / 2)) ^ 2 ≤ ((((a + b) / 2 + (c + d) / 2) / 2) ^ 2) ^ 2 :=
    pow_le_pow_left₀ hm_nn hm 2
  have e1 : a * b * c * d = (a * b) * (c * d) := by ring
  have e2 : ((a + b) / 2) ^ 2 * ((c + d) / 2) ^ 2 = (((a + b) / 2) * ((c + d) / 2)) ^ 2 := by ring
  have e3 : ((((a + b) / 2 + (c + d) / 2) / 2) ^ 2) ^ 2 = ((a + b + c + d) / 4) ^ 4 := by ring
  rw [e1]; rw [e2] at hprod; rw [e3] at hm2
  exact le_trans hprod hm2

private lemma prod5_le_pow5_mean {u0 u1 u2 u3 u4 s : ℝ}
    (hu0 : 0 ≤ u0) (hu1 : 0 ≤ u1) (hu2 : 0 ≤ u2) (hu3 : 0 ≤ u3) (hu4 : 0 ≤ u4) (hs : 0 < s)
    (hmean : u0 + u1 + u2 + u3 + u4 = 5 * s) :
    u0 * u1 * u2 * u3 * u4 ≤ s ^ 5 := by
  have p1 := am_gm_4 hu0 hu1 hu2 hu3
  have p2 := am_gm_4 hu4 hs.le hs.le hs.le
  have p12 := mul_le_mul p1 p2
    (mul_nonneg (mul_nonneg (mul_nonneg hu4 hs.le) hs.le) hs.le)
    (pow_nonneg (by linarith) 4)
  have hm := mul_le_mean_sq ((u0 + u1 + u2 + u3) / 4) ((u4 + s + s + s) / 4)
  have hm4 := pow_le_pow_left₀ (mul_nonneg (by linarith) (by linarith)) hm 4
  have e1 : u0 * u1 * u2 * u3 * u4 * s ^ 3 = (u0 * u1 * u2 * u3) * (u4 * s * s * s) := by ring
  have e2 : ((u0 + u1 + u2 + u3) / 4) ^ 4 * ((u4 + s + s + s) / 4) ^ 4 =
      (((u0 + u1 + u2 + u3) / 4) * ((u4 + s + s + s) / 4)) ^ 4 := by ring
  have e3 : ((((u0 + u1 + u2 + u3) / 4 + (u4 + s + s + s) / 4) / 2) ^ 2) ^ 4 = s ^ 5 * s ^ 3 := by
    have hs_eq : ((u0 + u1 + u2 + u3) / 4 + (u4 + s + s + s) / 4) / 2 = s := by linarith
    rw [hs_eq]; ring
  rw [e2] at p12; rw [e3] at hm4
  have h8 : (u0 * u1 * u2 * u3 * u4) * s ^ 3 ≤ s ^ 5 * s ^ 3 := by
    rw [e1]; exact le_trans p12 hm4
  exact le_of_mul_le_mul_right h8 (pow_pos hs 3)

private lemma five_var_tangent {u0 u1 u2 u3 u4 : ℝ}
    (hu0 : 0 < u0) (hu1 : 0 < u1) (hu2 : 0 < u2) (hu3 : 0 < u3) (hu4 : 0 < u4) :
    (u0 * u1 * u2 * u3 * u4) * (6 - (u0 + u1 + u2 + u3 + u4)) ≤ 1 := by
  by_cases h6 : 6 - (u0 + u1 + u2 + u3 + u4) ≤ 0
  · exact le_trans (mul_nonpos_of_nonneg_of_nonpos
      (mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hu0.le hu1.le) hu2.le) hu3.le) hu4.le) h6) zero_le_one
  · push Not at h6
    have hs : 0 < (u0 + u1 + u2 + u3 + u4) / 5 := by linarith
    have hp5 := prod5_le_pow5_mean hu0.le hu1.le hu2.le hu3.le hu4.le hs (by ring)
    have hm := mul_le_mul_of_nonneg_right hp5 h6.le
    have hpoly : ∀ t : ℝ, 0 ≤ t → 0 ≤ 1 - t ^ 5 * (6 - 5 * t) := fun t ht => by
      have hf : 1 - t ^ 5 * (6 - 5 * t) = (t - 1) ^ 2 * (5 * t ^ 4 + 4 * t ^ 3 + 3 * t ^ 2 + 2 * t + 1) := by ring
      rw [hf]; exact mul_nonneg (sq_nonneg _) (by positivity)
    have hpt := hpoly ((u0 + u1 + u2 + u3 + u4) / 5) hs.le
    have h5 : 6 - 5 * ((u0 + u1 + u2 + u3 + u4) / 5) = 6 - (u0 + u1 + u2 + u3 + u4) := by ring
    rw [h5] at hpt
    linarith

private lemma anchored_tangent_5 {d0 d1 d2 d3 d4 r0 r1 r2 r3 r4 : ℝ}
    (hd0 : 0 < d0) (hd1 : 0 < d1) (hd2 : 0 < d2) (hd3 : 0 < d3) (hd4 : 0 < d4)
    (hr0 : 0 < r0) (hr1 : 0 < r1) (hr2 : 0 < r2) (hr3 : 0 < r3) (hr4 : 0 < r4) :
    (6 - (d0 / r0 + d1 / r1 + d2 / r2 + d3 / r3 + d4 / r4)) / (r0 * r1 * r2 * r3 * r4) ≤
      1 / (d0 * d1 * d2 * d3 * d4) := by
  have hkey := five_var_tangent (div_pos hd0 hr0) (div_pos hd1 hr1) (div_pos hd2 hr2) (div_pos hd3 hr3) (div_pos hd4 hr4)
  have hd_pos : 0 < d0 * d1 * d2 * d3 * d4 := mul_pos (mul_pos (mul_pos (mul_pos hd0 hd1) hd2) hd3) hd4
  have hr_pos : 0 < r0 * r1 * r2 * r3 * r4 := mul_pos (mul_pos (mul_pos (mul_pos hr0 hr1) hr2) hr3) hr4
  have hprod : (d0 / r0) * (d1 / r1) * (d2 / r2) * (d3 / r3) * (d4 / r4) =
      (d0 * d1 * d2 * d3 * d4) / (r0 * r1 * r2 * r3 * r4) := by ring
  rw [hprod, div_mul_eq_mul_div, div_le_one hr_pos] at hkey
  rw [div_le_div_iff₀ hr_pos hd_pos]
  linarith

private lemma tangent_le_f_smooth {φ : ℝ} {x : R4}
    (hx0 : 0 < x.1) (hx1 : 0 < x.2.1) (hx2 : 0 < x.2.2.1) (hx3 : 0 < x.2.2.2)
    (hx4 : 0 < φ - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2)) :
    BuchstabArithmetic.tangent φ x.1 x.2.1 x.2.2.1 x.2.2.2 ≤ f_smooth φ x := by
  unfold BuchstabArithmetic.tangent f_smooth
  rw [show φ - x.1 - x.2.1 - x.2.2.1 - x.2.2.2 = φ - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2) by ring]
  exact anchored_tangent_5 hx0 hx1 hx2 hx3 hx4
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)

/-! ### Part 2: Pointwise & Integral 1D Hermite-Simpson Majorants -/

def H3_herm (u v x : ℝ) : ℝ :=
  let m := (u + v) / 2
  1 / m - (x - m) / m ^ 2 + (x - m) ^ 2 / (u * m * v) - (x - m) ^ 3 / (u * m ^ 2 * v)

private lemma H3_herm_ge_inv {u v x : ℝ} (hu : 0 < u) (hx : x ∈ Icc u v) :
    1 / x ≤ H3_herm u v x := by
  have huv : u ≤ v := le_trans hx.1 hx.2
  have hv : 0 < v := lt_of_lt_of_le hu huv
  have hx_pos : 0 < x := lt_of_lt_of_le hu hx.1
  set m := (u + v) / 2
  have hm : 0 < m := by dsimp [m]; linarith
  have hdiff : H3_herm u v x - 1 / x = (x - m) ^ 2 * (x - u) * (v - x) / (x * u * m ^ 2 * v) := by
    unfold H3_herm; dsimp only
    change (1 / m - (x - m) / m ^ 2 + (x - m) ^ 2 / (u * m * v) - (x - m) ^ 3 / (u * m ^ 2 * v)) - 1 / x = _
    field_simp [ne_of_gt hx_pos, ne_of_gt hu, ne_of_gt hv, ne_of_gt hm]
    ring
  have hnn : 0 ≤ (x - m) ^ 2 * (x - u) * (v - x) / (x * u * m ^ 2 * v) := by
    apply div_nonneg
    · exact mul_nonneg (mul_nonneg (sq_nonneg _) (sub_nonneg.mpr hx.1)) (sub_nonneg.mpr hx.2)
    · positivity
  linarith

private lemma cont_H3_herm (u v : ℝ) : Continuous (H3_herm u v) := by
  unfold H3_herm; dsimp only
  exact (((continuous_const.sub ((continuous_id.sub continuous_const).div_const _)).add
    (((continuous_id.sub continuous_const).pow 2).div_const _)).sub
    (((continuous_id.sub continuous_const).pow 3).div_const _))

private lemma integral_H3_herm {u v : ℝ} (hu : 0 < u) (huv : u ≤ v) :
    ∫ x in u..v, H3_herm u v x = (v - u) / 6 * (1 / u + 4 / ((u + v) / 2) + 1 / v) := by
  have hv : 0 < v := lt_of_lt_of_le hu huv
  set m := (u + v) / 2
  have hm : 0 < m := by dsimp [m]; linarith
  let F4 : ℝ → ℝ := fun x =>
    (x - m) / m - (x - m) ^ 2 / (2 * m ^ 2) + (x - m) ^ 3 / (3 * u * m * v) -
      (x - m) ^ 4 / (4 * u * m ^ 2 * v)
  have hcont : Continuous (H3_herm u v) := cont_H3_herm u v
  have hderiv : ∀ x ∈ uIcc u v, HasDerivAt F4 (H3_herm u v x) x := by
    intro x _
    unfold H3_herm; dsimp only [F4]
    change HasDerivAt F4 (1 / m - (x - m) / m ^ 2 + (x - m) ^ 2 / (u * m * v) - (x - m) ^ 3 / (u * m ^ 2 * v)) x
    have d0 : HasDerivAt (fun t : ℝ => t - m) 1 x := by simpa using (hasDerivAt_id x).sub_const m
    have d1 : HasDerivAt (fun t : ℝ => (t - m) / m) (1 / m) x := d0.div_const m
    have d2 : HasDerivAt (fun t : ℝ => (t - m) ^ 2 / (2 * m ^ 2)) ((x - m) / m ^ 2) x := by
      rw [show (x - m) / m ^ 2 = ((2 : ℕ) * (x - m) ^ (2 - 1) * 1) / (2 * m ^ 2) by
        push_cast; field_simp [ne_of_gt hm]]
      exact (d0.pow 2).div_const (2 * m ^ 2)
    have d3 : HasDerivAt (fun t : ℝ => (t - m) ^ 3 / (3 * u * m * v))
        ((x - m) ^ 2 / (u * m * v)) x := by
      rw [show (x - m) ^ 2 / (u * m * v) = ((3 : ℕ) * (x - m) ^ (3 - 1) * 1) / (3 * u * m * v) by
        push_cast; field_simp [ne_of_gt hu, ne_of_gt hm, ne_of_gt hv]]
      exact (d0.pow 3).div_const (3 * u * m * v)
    have d4 : HasDerivAt (fun t : ℝ => (t - m) ^ 4 / (4 * u * m ^ 2 * v))
        ((x - m) ^ 3 / (u * m ^ 2 * v)) x := by
      rw [show (x - m) ^ 3 / (u * m ^ 2 * v) = ((4 : ℕ) * (x - m) ^ (4 - 1) * 1) / (4 * u * m ^ 2 * v) by
        push_cast; field_simp [ne_of_gt hu, ne_of_gt hm, ne_of_gt hv]]
      exact (d0.pow 4).div_const (4 * u * m ^ 2 * v)
    exact ((d1.sub d2).add d3).sub d4
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable u v)]
  dsimp only [F4]
  have hvm : v - m = (v - u) / 2 := by dsimp only [m]; ring
  have hum : u - m = -((v - u) / 2) := by dsimp only [m]; ring
  have hm_def : 2 * m = u + v := by dsimp only [m]; ring
  rw [hvm, hum]
  field_simp [ne_of_gt hu, ne_of_gt hv, ne_of_gt hm]
  linear_combination (-(v - u) ^ 3 * (v - u + 4 * m)) * hm_def

def S1d_herm (H x : ℝ) : ℝ :=
  (1 / H) * (H3_herm a0 b0 x + H3_herm (H - b0) (H - a0) (H - x))

private lemma hab0 : a0 ≤ b0 := by norm_num [a0, b0, BuchstabArithmetic.a, BuchstabArithmetic.b]
private lemma ha0_pos : 0 < a0 := by norm_num [a0, BuchstabArithmetic.a]
private lemma hb0_pos : 0 < b0 := by norm_num [b0, BuchstabArithmetic.b]
private lemma hm0_pos : 0 < m0 := by norm_num [m0, BuchstabArithmetic.mid, BuchstabArithmetic.a, BuchstabArithmetic.b]
private lemma hw0_pos : 0 < w0 := by norm_num [w0, BuchstabArithmetic.w, BuchstabArithmetic.a, BuchstabArithmetic.b]

private lemma inv_mul_sub_le_S1d_herm {H x : ℝ} (hH : b0 < H) (hx : x ∈ Icc a0 b0) :
    1 / (x * (H - x)) ≤ S1d_herm H x := by
  have hx_pos : 0 < x := lt_of_lt_of_le ha0_pos hx.1
  have hHx_pos : 0 < H - x := by linarith [hx.2]
  have hH_pos : 0 < H := lt_of_lt_of_le hb0_pos (le_of_lt hH)
  have hHb_pos : 0 < H - b0 := sub_pos.mpr hH
  have h1 := H3_herm_ge_inv ha0_pos hx
  have h2 := H3_herm_ge_inv hHb_pos (show H - x ∈ Icc (H - b0) (H - a0) from ⟨by linarith [hx.2], by linarith [hx.1]⟩)
  have hpf : 1 / (x * (H - x)) = (1 / H) * (1 / x + 1 / (H - x)) := by
    field_simp [ne_of_gt hx_pos, ne_of_gt hHx_pos, ne_of_gt hH_pos]; ring
  rw [hpf, S1d_herm]
  exact mul_le_mul_of_nonneg_left (add_le_add h1 h2) (by positivity)

private def ν3 (i : Fin 3) : ℝ := a0 + (i.1 : ℝ) * (w0 / 2)

private def γ3 : Fin 3 → ℝ
  | ⟨0, _⟩ => w0 / (6 * a0)
  | ⟨1, _⟩ => 4 * w0 / (6 * m0)
  | ⟨2, _⟩ => w0 / (6 * b0)

private lemma γ3_nonneg (i : Fin 3) : 0 ≤ γ3 i := by
  fin_cases i <;> simp only [γ3] <;>
    norm_num [w0, a0, b0, m0, BuchstabArithmetic.w, BuchstabArithmetic.a, BuchstabArithmetic.b, BuchstabArithmetic.mid]

private lemma ν3_le_b0 (i : Fin 3) : ν3 i ≤ b0 := by
  fin_cases i <;> simp only [ν3] <;>
    norm_num [w0, a0, b0, BuchstabArithmetic.w, BuchstabArithmetic.a, BuchstabArithmetic.b]

private lemma pf_step {H t : ℝ} (hH : H ≠ 0) (ht : t ≠ 0) (hHt : H - t ≠ 0) :
    (1 / H) * (1 / t + 1 / (H - t)) = (1 / t) / (H - t) := by
  field_simp [hH, ht, hHt]; ring

private lemma integral_S1d_herm {H : ℝ} (hH : b0 < H) :
    ∫ x in a0..b0, S1d_herm H x = ∑ i : Fin 3, γ3 i / (H - ν3 i) := by
  have hH_pos : 0 < H := lt_of_lt_of_le hb0_pos (le_of_lt hH)
  have hHb_pos : 0 < H - b0 := sub_pos.mpr hH
  have hHa_pos : 0 < H - a0 := by linarith [hab0]
  have hHm_pos : 0 < H - m0 := by unfold m0 BuchstabArithmetic.mid; linarith [hab0]
  have hc1 : Continuous (H3_herm a0 b0) := cont_H3_herm a0 b0
  have hc2 : Continuous (fun x => H3_herm (H - b0) (H - a0) (H - x)) :=
    (cont_H3_herm (H - b0) (H - a0)).comp (continuous_const.sub continuous_id)
  unfold S1d_herm
  rw [intervalIntegral.integral_const_mul,
      intervalIntegral.integral_add (hc1.intervalIntegrable a0 b0) (hc2.intervalIntegrable a0 b0),
      integral_H3_herm ha0_pos hab0]
  have hsub : ∫ x in a0..b0, H3_herm (H - b0) (H - a0) (H - x) =
      ∫ y in (H - b0)..(H - a0), H3_herm (H - b0) (H - a0) y :=
    intervalIntegral.integral_comp_sub_left (H3_herm (H - b0) (H - a0)) H
  rw [hsub, integral_H3_herm hHb_pos (by linarith [hab0])]
  simp only [Fin.sum_univ_three, γ3, ν3, Fin.val_zero, Fin.val_one, Fin.val_two]
  have h0 : ((0 : ℕ) : ℝ) = 0 := by norm_num
  have h1 : ((1 : ℕ) : ℝ) = 1 := by norm_num
  have h2 : ((2 : ℕ) : ℝ) = 2 := by norm_num
  rw [h0, h1, h2]
  have ha_eq : a0 + 0 * (w0 / 2) = a0 := by ring
  have hm_eq : a0 + 1 * (w0 / 2) = m0 := by unfold w0 m0 BuchstabArithmetic.w BuchstabArithmetic.mid; ring
  have hb_eq : a0 + 2 * (w0 / 2) = b0 := by unfold w0 BuchstabArithmetic.w; ring
  have hmid1 : (a0 + b0) / 2 = m0 := rfl
  have hmid2 : (H - b0 + (H - a0)) / 2 = H - m0 := by unfold m0 BuchstabArithmetic.mid; ring
  have hw1 : b0 - a0 = w0 := rfl
  have hw2 : H - a0 - (H - b0) = w0 := by unfold w0 BuchstabArithmetic.w; ring
  rw [ha_eq, hm_eq, hb_eq, hmid1, hmid2, hw1, hw2]
  have pfa := pf_step (ne_of_gt hH_pos) (ne_of_gt ha0_pos) (ne_of_gt hHa_pos)
  have pfm := pf_step (ne_of_gt hH_pos) (ne_of_gt hm0_pos) (ne_of_gt hHm_pos)
  have pfb := pf_step (ne_of_gt hH_pos) (ne_of_gt hb0_pos) (ne_of_gt hHb_pos)
  have e_rearr : (1 / H) * (w0 / 6 * (1 / a0 + 4 / m0 + 1 / b0) +
      w0 / 6 * (1 / (H - b0) + 4 / (H - m0) + 1 / (H - a0))) =
      (w0 / 6) * ((1 / H) * (1 / a0 + 1 / (H - a0))) +
      (4 * w0 / 6) * ((1 / H) * (1 / m0 + 1 / (H - m0))) +
      (w0 / 6) * ((1 / H) * (1 / b0 + 1 / (H - b0))) := by ring
  rw [e_rearr, pfa, pfm, pfb]
  have t1 : (w0 / 6) * ((1 / a0) / (H - a0)) = w0 / (6 * a0) / (H - a0) := by
    field_simp [ne_of_gt ha0_pos, ne_of_gt hHa_pos]
  have t2 : (4 * w0 / 6) * ((1 / m0) / (H - m0)) = 4 * w0 / (6 * m0) / (H - m0) := by
    field_simp [ne_of_gt hm0_pos, ne_of_gt hHm_pos]
  have t3 : (w0 / 6) * ((1 / b0) / (H - b0)) = w0 / (6 * b0) / (H - b0) := by
    field_simp [ne_of_gt hb0_pos, ne_of_gt hHb_pos]
  rw [t1, t2, t3]

/-! ### Part 3: Domain Equivalence, Coordinate Swaps, `S_4` Symmetry, and 4D Cube Simpson Bounds -/

private def D_set : Set R4 :=
  {x : R4 | a0 ≤ x.1 ∧ x.1 ≤ x.2.1 ∧ x.2.1 ≤ x.2.2.1 ∧ x.2.2.1 ≤ x.2.2.2 ∧ x.2.2.2 ≤ b0}

private def B_box : Set R4 := Icc a0 b0 ×ˢ Icc a0 b0 ×ˢ Icc a0 b0 ×ˢ Icc a0 b0
private def B3_box : Set R3 := Icc a0 b0 ×ˢ Icc a0 b0 ×ˢ Icc a0 b0
private def B2_box : Set R2 := Icc a0 b0 ×ˢ Icc a0 b0

private lemma D_subset_B : D_set ⊆ B_box := by
  intro x ⟨h0, h01, h12, h23, h3⟩
  exact ⟨⟨h0, by linarith⟩, ⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩, ⟨by linarith, h3⟩⟩

private lemma isClosed_D : IsClosed D_set := by
  show IsClosed ({x : R4 | a0 ≤ x.1} ∩ ({x : R4 | x.1 ≤ x.2.1} ∩ ({x : R4 | x.2.1 ≤ x.2.2.1} ∩
    ({x : R4 | x.2.2.1 ≤ x.2.2.2} ∩ {x : R4 | x.2.2.2 ≤ b0}))))
  exact (isClosed_le continuous_const c_x0).inter
    ((isClosed_le c_x0 c_x1).inter ((isClosed_le c_x1 c_x2).inter
      ((isClosed_le c_x2 c_x3).inter (isClosed_le c_x3 continuous_const))))

private lemma isClosed_B : IsClosed B_box :=
  isClosed_Icc.prod (isClosed_Icc.prod (isClosed_Icc.prod isClosed_Icc))

private lemma isCompact_B : IsCompact B_box :=
  isCompact_Icc.prod (isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc))

private lemma isCompact_B3 : IsCompact B3_box :=
  isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc)

private lemma isCompact_B2 : IsCompact B2_box :=
  isCompact_Icc.prod isCompact_Icc

private lemma isCompact_D : IsCompact D_set :=
  isCompact_B.of_isClosed_subset isClosed_D D_subset_B

private def e3_equiv : (Fin 3 → ℝ) ≃ᵐ R3 :=
  (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) MeasurableEquiv.finTwoArrow)

private def e4_equiv : (Fin 4 → ℝ) ≃ᵐ R4 :=
  (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 4 => ℝ) 0).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) e3_equiv)

private lemma hmp_e3 : MeasurePreserving e3_equiv volume volume := by
  have h1 := MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0
  have h2 : MeasurePreserving
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) (MeasurableEquiv.finTwoArrow (α := ℝ)))
      (volume.prod volume) (volume.prod (volume.prod volume)) :=
    (MeasurePreserving.id volume).prod (MeasureTheory.volume_preserving_finTwoArrow ℝ)
  exact h2.comp h1

private lemma hmp_e4 : MeasurePreserving e4_equiv volume volume := by
  have h1 := MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin 4 => ℝ) 0
  have h2 : MeasurePreserving (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) e3_equiv)
      (volume.prod volume) (volume.prod volume) :=
    (MeasurePreserving.id volume).prod hmp_e3
  exact h2.comp h1

private lemma e4_apply (x : Fin 4 → ℝ) : e4_equiv x = (x 0, x 1, x 2, x 3) := rfl

private lemma buchstabIntegral_eq_D (ω : ℝ → ℝ) (φ : ℝ) :
    buchstabIntegral ω 2 (fun j => (r2j16_lo j : ℝ)) (fun j => (r2j16_hi j : ℝ)) φ =
      ∫ x in D_set, integrand4 ω φ x := by
  have hlo : ∀ j : Fin 4, (r2j16_lo j : ℝ) = a0 := fun j => by
    fin_cases j <;> simp [r2j16_lo, a0, BuchstabArithmetic.a]
  have hhi : ∀ j : Fin 4, (r2j16_hi j : ℝ) = b0 := fun j => by
    fin_cases j <;> simp [r2j16_hi, b0, BuchstabArithmetic.b]
  have hdom : domain (fun j => (r2j16_lo j : ℝ)) (fun j => (r2j16_hi j : ℝ)) = e4_equiv ⁻¹' D_set := by
    ext x
    simp only [domain, D_set, mem_ofPred_eq, mem_preimage, e4_apply, hlo, hhi]
    constructor
    · rintro ⟨hmono, hbox⟩
      exact ⟨(hbox 0).1, hmono (by decide : (0 : Fin 4) ≤ 1), hmono (by decide : (1 : Fin 4) ≤ 2),
        hmono (by decide : (2 : Fin 4) ≤ 3), (hbox 3).2⟩
    · rintro ⟨h0, h01, h12, h23, h3⟩
      refine ⟨?_, ?_⟩
      · intro i j hij; fin_cases i <;> fin_cases j <;> simp at hij ⊢ <;> linarith
      · intro j; fin_cases j <;> simp <;> constructor <;> linarith
  have hfun : (fun x : Fin 4 → ℝ =>
      ω ((φ - ∑ j, x j) / x ⟨2, by omega⟩) / ((∏ j, x j) * x ⟨2, by omega⟩)) =
      (fun x : Fin 4 → ℝ => integrand4 ω φ (e4_equiv x)) := by
    ext x
    simp only [integrand4, e4_apply, Fin.sum_univ_four, Fin.prod_univ_four]
    have hnum : (φ - (x 0 + x 1 + x 2 + x 3)) / x ⟨2, by omega⟩ =
        (φ - (x 0 + x 1 + x 2 + x 3)) / x 2 := rfl
    have hden : (x 0 * x 1 * x 2 * x 3) * x ⟨2, by omega⟩ = x 0 * x 1 * x 2 * x 2 * x 3 := by
      change (x 0 * x 1 * x 2 * x 3) * x 2 = x 0 * x 1 * x 2 * x 2 * x 3; ring
    rw [hnum, hden]
  unfold buchstabIntegral
  rw [hdom, hfun]
  exact hmp_e4.setIntegral_preimage_emb e4_equiv.measurableEmbedding (integrand4 ω φ) D_set

private def swap12_3 {α β γ : Type*} [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ] :
    α × (β × γ) ≃ᵐ β × (α × γ) :=
  (MeasurableEquiv.prodAssoc.symm.trans
    (MeasurableEquiv.prodCongr MeasurableEquiv.prodComm (MeasurableEquiv.refl γ))).trans
    MeasurableEquiv.prodAssoc

private lemma hmp_swap12_3 {α β γ : Type*} [MeasureSpace α] [MeasureSpace β] [MeasureSpace γ]
    [SFinite (volume : Measure α)] [SFinite (volume : Measure β)] [SFinite (volume : Measure γ)] :
    MeasurePreserving (swap12_3 (α := α) (β := β) (γ := γ)) volume volume :=
  MeasureTheory.volume_preserving_prodAssoc.comp
    ((Measure.measurePreserving_swap.prod (MeasurePreserving.id volume)).comp
      MeasureTheory.volume_preserving_prodAssoc.symm)

private def s01 : R4 ≃ᵐ R4 := swap12_3
private def s12 : R4 ≃ᵐ R4 := MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) swap12_3
private def s23 : R4 ≃ᵐ R4 :=
  MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ)
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) MeasurableEquiv.prodComm)

private lemma hmp_s01 : MeasurePreserving s01 volume volume := hmp_swap12_3
private lemma hmp_s12 : MeasurePreserving s12 volume volume :=
  (MeasurePreserving.id volume).prod hmp_swap12_3
private lemma hmp_s23 : MeasurePreserving s23 volume volume :=
  (MeasurePreserving.id volume).prod ((MeasurePreserving.id volume).prod Measure.measurePreserving_swap)

private lemma s01_apply (x : R4) : s01 x = (x.2.1, x.1, x.2.2.1, x.2.2.2) := rfl
private lemma s12_apply (x : R4) : s12 x = (x.1, x.2.2.1, x.2.1, x.2.2.2) := rfl
private lemma s23_apply (x : R4) : s23 x = (x.1, x.2.1, x.2.2.2, x.2.2.1) := rfl

private lemma setIntegral_slice {β : Type*} [MeasureSpace β] [SFinite (volume : Measure β)]
    {a b : ℝ} (hab : a ≤ b) {T : ℝ → Set β} {f : ℝ × β → ℝ}
    (hT : ∀ x, MeasurableSet (T x))
    (hmeas : MeasurableSet {p : ℝ × β | p.1 ∈ Icc a b ∧ p.2 ∈ T p.1})
    (hint : IntegrableOn f {p : ℝ × β | p.1 ∈ Icc a b ∧ p.2 ∈ T p.1} volume) :
    ∫ p in {p : ℝ × β | p.1 ∈ Icc a b ∧ p.2 ∈ T p.1}, f p =
      ∫ x in a..b, ∫ y in T x, f (x, y) := by
  change ∫ p in {p : ℝ × β | p.1 ∈ Icc a b ∧ p.2 ∈ T p.1}, f p ∂(volume.prod volume) = _
  have hint' : IntegrableOn f {p : ℝ × β | p.1 ∈ Icc a b ∧ p.2 ∈ T p.1} (volume.prod volume) := hint
  rw [← integral_indicator hmeas, MeasureTheory.integral_prod _ (hint'.integrable_indicator hmeas)]
  have heq : (fun x => ∫ y, {p : ℝ × β | p.1 ∈ Icc a b ∧ p.2 ∈ T p.1}.indicator f (x, y)) =
      (Icc a b).indicator (fun x => ∫ y in T x, f (x, y)) := by
    ext x
    by_cases hx : x ∈ Icc a b
    · simp only [indicator_of_mem hx, ← integral_indicator (hT x)]
      congr 1; ext y
      by_cases hy : y ∈ T x
      · have hxy : (x, y) ∈ {p : ℝ × β | p.1 ∈ Icc a b ∧ p.2 ∈ T p.1} := ⟨hx, hy⟩
        rw [indicator_of_mem hxy, indicator_of_mem hy]
      · have hnxy : (x, y) ∉ {p : ℝ × β | p.1 ∈ Icc a b ∧ p.2 ∈ T p.1} := fun h => hy h.2
        rw [indicator_of_notMem hnxy, indicator_of_notMem hy]
    · simp only [indicator_of_notMem hx]
      have h0 : ∀ y, {p : ℝ × β | p.1 ∈ Icc a b ∧ p.2 ∈ T p.1}.indicator f (x, y) = 0 :=
        fun y => indicator_of_notMem (show (x, y) ∉ {p : ℝ × β | p.1 ∈ Icc a b ∧ p.2 ∈ T p.1} from fun h => hx h.1) f
      simp only [h0, integral_zero]
  rw [heq, integral_indicator measurableSet_Icc,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab]

private lemma setIntegral_slice_Ioo {β : Type*} [MeasureSpace β] [SFinite (volume : Measure β)]
    {a b : ℝ} (hab : a ≤ b) {T : ℝ → Set β} {f : ℝ × β → ℝ}
    (hT : ∀ x, MeasurableSet (T x))
    (hmeas : MeasurableSet {p : ℝ × β | p.1 ∈ Ioo a b ∧ p.2 ∈ T p.1})
    (hint : IntegrableOn f {p : ℝ × β | p.1 ∈ Ioo a b ∧ p.2 ∈ T p.1} volume) :
    ∫ p in {p : ℝ × β | p.1 ∈ Ioo a b ∧ p.2 ∈ T p.1}, f p =
      ∫ x in a..b, ∫ y in T x, f (x, y) := by
  change ∫ p in {p : ℝ × β | p.1 ∈ Ioo a b ∧ p.2 ∈ T p.1}, f p ∂(volume.prod volume) = _
  have hint' : IntegrableOn f {p : ℝ × β | p.1 ∈ Ioo a b ∧ p.2 ∈ T p.1} (volume.prod volume) := hint
  rw [← integral_indicator hmeas, MeasureTheory.integral_prod _ (hint'.integrable_indicator hmeas)]
  have heq : (fun x => ∫ y, {p : ℝ × β | p.1 ∈ Ioo a b ∧ p.2 ∈ T p.1}.indicator f (x, y)) =
      (Ioo a b).indicator (fun x => ∫ y in T x, f (x, y)) := by
    ext x
    by_cases hx : x ∈ Ioo a b
    · simp only [indicator_of_mem hx, ← integral_indicator (hT x)]
      congr 1; ext y
      by_cases hy : y ∈ T x
      · have hxy : (x, y) ∈ {p : ℝ × β | p.1 ∈ Ioo a b ∧ p.2 ∈ T p.1} := ⟨hx, hy⟩
        rw [indicator_of_mem hxy, indicator_of_mem hy]
      · have hnxy : (x, y) ∉ {p : ℝ × β | p.1 ∈ Ioo a b ∧ p.2 ∈ T p.1} := fun h => hy h.2
        rw [indicator_of_notMem hnxy, indicator_of_notMem hy]
    · simp only [indicator_of_notMem hx]
      have h0 : ∀ y, {p : ℝ × β | p.1 ∈ Ioo a b ∧ p.2 ∈ T p.1}.indicator f (x, y) = 0 :=
        fun y => indicator_of_notMem (show (x, y) ∉ {p : ℝ × β | p.1 ∈ Ioo a b ∧ p.2 ∈ T p.1} from fun h => hx h.1) f
      simp only [h0, integral_zero]
  rw [heq, integral_indicator measurableSet_Ioo,
      ← MeasureTheory.integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le hab]

private lemma setIntegral_B_eq_iter {g : R4 → ℝ} (hg : ContinuousOn g B_box) :
    ∫ x in B_box, g x =
      ∫ x0 in a0..b0, ∫ x1 in a0..b0, ∫ x2 in a0..b0, ∫ x3 in a0..b0, g (x0, x1, x2, x3) := by
  have hS2m : MeasurableSet B2_box := measurableSet_Icc.prod measurableSet_Icc
  have hS1m : MeasurableSet B3_box := measurableSet_Icc.prod hS2m
  rw [show B_box = {p : R4 | p.1 ∈ Icc a0 b0 ∧ p.2 ∈ B3_box} from rfl]
  rw [setIntegral_slice hab0 (T := fun _ => B3_box) (fun _ => hS1m) isClosed_B.measurableSet (hg.integrableOn_compact isCompact_B)]
  apply intervalIntegral.integral_congr; intro x0 hx0; dsimp only
  rw [uIcc_of_le hab0] at hx0
  have hg1 : ContinuousOn (fun y : R3 => g (x0, y)) B3_box :=
    hg.comp (continuous_const.prodMk continuous_id).continuousOn (fun y hy => ⟨hx0, hy⟩)
  rw [show B3_box = {p : R3 | p.1 ∈ Icc a0 b0 ∧ p.2 ∈ B2_box} from rfl]
  rw [setIntegral_slice hab0 (T := fun _ => B2_box) (fun _ => hS2m) hS1m (hg1.integrableOn_compact isCompact_B3)]
  apply intervalIntegral.integral_congr; intro x1 hx1; dsimp only
  rw [uIcc_of_le hab0] at hx1
  have hg2 : ContinuousOn (fun z : R2 => g (x0, x1, z)) B2_box :=
    hg.comp (continuous_const.prodMk (continuous_const.prodMk continuous_id)).continuousOn
      (fun z hz => ⟨hx0, hx1, hz⟩)
  rw [show B2_box = {p : R2 | p.1 ∈ Icc a0 b0 ∧ p.2 ∈ Icc a0 b0} from rfl]
  rw [setIntegral_slice hab0 (T := fun _ => Icc a0 b0) (fun _ => measurableSet_Icc) hS2m (hg2.integrableOn_compact isCompact_B2)]
  apply intervalIntegral.integral_congr; intro x2 _; dsimp only
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab0]

private def D_S2 (x1 : ℝ) : Set R2 := {p : R2 | p.1 ∈ Icc x1 b0 ∧ p.2 ∈ Icc p.1 b0}
private def D_S1 (x0 : ℝ) : Set R3 := {p : R3 | p.1 ∈ Icc x0 b0 ∧ p.2 ∈ D_S2 p.1}
private def U_S2 (x1 : ℝ) : Set R2 := {p : R2 | p.1 ∈ Ioo x1 b0 ∧ p.2 ∈ Ioo p.1 b0}
private def U_S1 (x0 : ℝ) : Set R3 := {p : R3 | p.1 ∈ Ioo x0 b0 ∧ p.2 ∈ U_S2 p.1}
private def C00_set : Set R4 :=
  {x : R4 | a0 < x.1 ∧ x.1 < x.2.1 ∧ x.2.1 < x.2.2.1 ∧ x.2.2.1 < x.2.2.2 ∧ x.2.2.2 < b0}

private lemma isClosed_D_S2 (x1 : ℝ) : IsClosed (D_S2 x1) := by
  show IsClosed ({p : R2 | p.1 ∈ Icc x1 b0} ∩ ({p : R2 | p.1 ≤ p.2} ∩ {p : R2 | p.2 ≤ b0}))
  exact (isClosed_Icc.preimage continuous_fst).inter
    ((isClosed_le continuous_fst continuous_snd).inter (isClosed_le continuous_snd continuous_const))

private lemma isClosed_D_S1 (x0 : ℝ) : IsClosed (D_S1 x0) := by
  have hsub2 : D_S1 x0 = {p : R3 | p.1 ∈ Icc x0 b0} ∩
      (({p : R3 | p.1 ≤ p.2.1} ∩ {p : R3 | p.2.1 ≤ b0}) ∩
       ({p : R3 | p.2.1 ≤ p.2.2} ∩ {p : R3 | p.2.2 ≤ b0})) := by
    ext p; simp only [D_S1, D_S2, mem_ofPred_eq, mem_Icc, mem_inter_iff]
  rw [hsub2]
  exact (isClosed_Icc.preimage c_y0).inter
    (((isClosed_le c_y0 c_y1).inter (isClosed_le c_y1 continuous_const)).inter
     ((isClosed_le c_y1 c_y2).inter (isClosed_le c_y2 continuous_const)))

private lemma isOpen_U_S2 (x1 : ℝ) : IsOpen (U_S2 x1) := by
  show IsOpen ({p : R2 | p.1 ∈ Ioo x1 b0} ∩ ({p : R2 | p.1 < p.2} ∩ {p : R2 | p.2 < b0}))
  exact (isOpen_Ioo.preimage continuous_fst).inter
    ((isOpen_lt continuous_fst continuous_snd).inter (isOpen_lt continuous_snd continuous_const))

private lemma isOpen_U_S1 (x0 : ℝ) : IsOpen (U_S1 x0) := by
  have hsub2 : U_S1 x0 = {p : R3 | p.1 ∈ Ioo x0 b0} ∩
      (({p : R3 | p.1 < p.2.1} ∩ {p : R3 | p.2.1 < b0}) ∩
       ({p : R3 | p.2.1 < p.2.2} ∩ {p : R3 | p.2.2 < b0})) := by
    ext p; simp only [U_S1, U_S2, mem_ofPred_eq, mem_Ioo, mem_inter_iff]
  rw [hsub2]
  exact (isOpen_Ioo.preimage c_y0).inter
    (((isOpen_lt c_y0 c_y1).inter (isOpen_lt c_y1 continuous_const)).inter
     ((isOpen_lt c_y1 c_y2).inter (isOpen_lt c_y2 continuous_const)))

private lemma isOpen_C00 : IsOpen C00_set := by
  show IsOpen ({x : R4 | a0 < x.1} ∩ ({x : R4 | x.1 < x.2.1} ∩ ({x : R4 | x.2.1 < x.2.2.1} ∩
    ({x : R4 | x.2.2.1 < x.2.2.2} ∩ {x : R4 | x.2.2.2 < b0}))))
  exact (isOpen_lt continuous_const c_x0).inter
    ((isOpen_lt c_x0 c_x1).inter ((isOpen_lt c_x1 c_x2).inter
      ((isOpen_lt c_x2 c_x3).inter (isOpen_lt c_x3 continuous_const))))

private lemma D_eq_slice : D_set = {p : R4 | p.1 ∈ Icc a0 b0 ∧ p.2 ∈ D_S1 p.1} := by
  ext x; simp only [D_set, D_S1, D_S2, mem_ofPred_eq, mem_Icc]
  exact ⟨fun ⟨h0, h01, h12, h23, h3⟩ => ⟨⟨h0, by linarith⟩, ⟨h01, by linarith⟩, ⟨h12, by linarith⟩, ⟨h23, h3⟩⟩,
         fun ⟨⟨h0, _⟩, ⟨h01, _⟩, ⟨h12, _⟩, ⟨h23, h3⟩⟩ => ⟨h0, h01, h12, h23, h3⟩⟩

private lemma D_S1_sub_B3 {x0 : ℝ} (hx0 : x0 ∈ Icc a0 b0) : D_S1 x0 ⊆ B3_box := by
  intro y hy
  have hmem : (x0, y) ∈ D_set := by rw [D_eq_slice]; exact ⟨hx0, hy⟩
  exact (D_subset_B hmem).2

private lemma setIntegral_D_eq_iter {g : R4 → ℝ} (hg : ContinuousOn g B_box) :
    ∫ x in D_set, g x =
      ∫ x0 in a0..b0, ∫ x1 in x0..b0, ∫ x2 in x1..b0, ∫ x3 in x2..b0, g (x0, x1, x2, x3) := by
  have hint0 : IntegrableOn g {p : R4 | p.1 ∈ Icc a0 b0 ∧ p.2 ∈ D_S1 p.1} volume := by
    rw [← D_eq_slice]; exact (hg.mono D_subset_B).integrableOn_compact isCompact_D
  have hm0' : MeasurableSet {p : R4 | p.1 ∈ Icc a0 b0 ∧ p.2 ∈ D_S1 p.1} := by
    rw [← D_eq_slice]; exact isClosed_D.measurableSet
  rw [D_eq_slice, setIntegral_slice hab0 (T := D_S1) (fun x0 => (isClosed_D_S1 x0).measurableSet) hm0' hint0]
  apply intervalIntegral.integral_congr; intro x0 hx0; dsimp only
  rw [uIcc_of_le hab0] at hx0
  have hS1_sub : D_S1 x0 ⊆ B3_box := D_S1_sub_B3 hx0
  have hg1 : ContinuousOn (fun y : R3 => g (x0, y)) (D_S1 x0) :=
    hg.comp (continuous_const.prodMk continuous_id).continuousOn (fun y hy => ⟨hx0, hS1_sub hy⟩)
  have hint1 : IntegrableOn (fun y : R3 => g (x0, y)) (D_S1 x0) volume :=
    hg1.integrableOn_compact (isCompact_B3.of_isClosed_subset (isClosed_D_S1 x0) hS1_sub)
  have hm1' : MeasurableSet (D_S1 x0) := (isClosed_D_S1 x0).measurableSet
  rw [show D_S1 x0 = {p : R3 | p.1 ∈ Icc x0 b0 ∧ p.2 ∈ D_S2 p.1} from rfl] at hm1' hint1 ⊢
  rw [setIntegral_slice hx0.2 (T := D_S2) (fun x1 => (isClosed_D_S2 x1).measurableSet) hm1' hint1]
  apply intervalIntegral.integral_congr; intro x1 hx1; dsimp only
  rw [uIcc_of_le hx0.2] at hx1
  have hS2_sub : D_S2 x1 ⊆ B2_box := fun z hz => (hS1_sub (show (x1, z) ∈ D_S1 x0 from ⟨hx1, hz⟩)).2
  have hg2 : ContinuousOn (fun z : R2 => g (x0, x1, z)) (D_S2 x1) :=
    hg.comp (continuous_const.prodMk (continuous_const.prodMk continuous_id)).continuousOn
      (fun z hz => ⟨hx0, ⟨le_trans hx0.1 hx1.1, hx1.2⟩, hS2_sub hz⟩)
  have hint2 : IntegrableOn (fun z : R2 => g (x0, x1, z)) (D_S2 x1) volume :=
    hg2.integrableOn_compact (isCompact_B2.of_isClosed_subset (isClosed_D_S2 x1) hS2_sub)
  have hm2' : MeasurableSet (D_S2 x1) := (isClosed_D_S2 x1).measurableSet
  rw [show D_S2 x1 = {p : R2 | p.1 ∈ Icc x1 b0 ∧ p.2 ∈ Icc p.1 b0} from rfl] at hm2' hint2 ⊢
  rw [setIntegral_slice hx1.2 (T := fun x2 => Icc x2 b0) (fun _ => measurableSet_Icc) hm2' hint2]
  apply intervalIntegral.integral_congr; intro x2 hx2; dsimp only
  rw [uIcc_of_le hx1.2] at hx2
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hx2.2]

private lemma setIntegral_C00_eq_iter {g : R4 → ℝ} (hg : ContinuousOn g B_box) :
    ∫ x in C00_set, g x =
      ∫ x0 in a0..b0, ∫ x1 in x0..b0, ∫ x2 in x1..b0, ∫ x3 in x2..b0, g (x0, x1, x2, x3) := by
  have hC00_eq : C00_set = {p : R4 | p.1 ∈ Ioo a0 b0 ∧ p.2 ∈ U_S1 p.1} := by
    ext x; simp only [C00_set, U_S1, U_S2, mem_ofPred_eq, mem_Ioo]
    exact ⟨fun ⟨h0, h01, h12, h23, h3⟩ => ⟨⟨h0, by linarith⟩, ⟨h01, by linarith⟩, ⟨h12, by linarith⟩, ⟨h23, h3⟩⟩,
           fun ⟨⟨h0, _⟩, ⟨h01, _⟩, ⟨h12, _⟩, ⟨h23, h3⟩⟩ => ⟨h0, h01, h12, h23, h3⟩⟩
  have hC00_sub : C00_set ⊆ B_box := fun x ⟨h0, h01, h12, h23, h3⟩ =>
    D_subset_B ⟨le_of_lt h0, le_of_lt h01, le_of_lt h12, le_of_lt h23, le_of_lt h3⟩
  have hint0 : IntegrableOn g {p : R4 | p.1 ∈ Ioo a0 b0 ∧ p.2 ∈ U_S1 p.1} volume := by
    rw [← hC00_eq]; exact (hg.integrableOn_compact isCompact_B).mono_set hC00_sub
  have hm0' : MeasurableSet {p : R4 | p.1 ∈ Ioo a0 b0 ∧ p.2 ∈ U_S1 p.1} := by
    rw [← hC00_eq]; exact isOpen_C00.measurableSet
  rw [hC00_eq, setIntegral_slice_Ioo hab0 (T := U_S1) (fun x0 => (isOpen_U_S1 x0).measurableSet) hm0' hint0]
  apply intervalIntegral.integral_congr; intro x0 hx0; dsimp only
  rw [uIcc_of_le hab0] at hx0
  have hS1_sub : D_S1 x0 ⊆ B3_box := D_S1_sub_B3 hx0
  have hU1_sub : U_S1 x0 ⊆ D_S1 x0 := fun y ⟨⟨a, b⟩, ⟨c, d⟩, ⟨e, f⟩⟩ =>
    ⟨⟨le_of_lt a, le_of_lt b⟩, ⟨le_of_lt c, le_of_lt d⟩, ⟨le_of_lt e, le_of_lt f⟩⟩
  have hg1 : ContinuousOn (fun y : R3 => g (x0, y)) (D_S1 x0) :=
    hg.comp (continuous_const.prodMk continuous_id).continuousOn (fun y hy => ⟨hx0, hS1_sub hy⟩)
  have hint1 : IntegrableOn (fun y : R3 => g (x0, y)) (U_S1 x0) volume :=
    (hg1.integrableOn_compact (isCompact_B3.of_isClosed_subset (isClosed_D_S1 x0) hS1_sub)).mono_set hU1_sub
  have hm1u : MeasurableSet (U_S1 x0) := (isOpen_U_S1 x0).measurableSet
  rw [show U_S1 x0 = {p : R3 | p.1 ∈ Ioo x0 b0 ∧ p.2 ∈ U_S2 p.1} from rfl] at hm1u hint1 ⊢
  rw [setIntegral_slice_Ioo hx0.2 (T := U_S2) (fun x1 => (isOpen_U_S2 x1).measurableSet) hm1u hint1]
  apply intervalIntegral.integral_congr; intro x1 hx1; dsimp only
  rw [uIcc_of_le hx0.2] at hx1
  have hU2_sub : U_S2 x1 ⊆ D_S2 x1 := fun z ⟨⟨c, d⟩, ⟨e, f⟩⟩ =>
    ⟨⟨le_of_lt c, le_of_lt d⟩, ⟨le_of_lt e, le_of_lt f⟩⟩
  have hS2_sub : D_S2 x1 ⊆ B2_box := fun z hz => (hS1_sub (show (x1, z) ∈ D_S1 x0 from ⟨hx1, hz⟩)).2
  have hg2 : ContinuousOn (fun z : R2 => g (x0, x1, z)) (D_S2 x1) :=
    hg.comp (continuous_const.prodMk (continuous_const.prodMk continuous_id)).continuousOn
      (fun z hz => ⟨hx0, ⟨le_trans hx0.1 hx1.1, hx1.2⟩, hS2_sub hz⟩)
  have hint2 : IntegrableOn (fun z : R2 => g (x0, x1, z)) (U_S2 x1) volume :=
    (hg2.integrableOn_compact (isCompact_B2.of_isClosed_subset (isClosed_D_S2 x1) hS2_sub)).mono_set hU2_sub
  have hm2u : MeasurableSet (U_S2 x1) := (isOpen_U_S2 x1).measurableSet
  rw [show U_S2 x1 = {p : R2 | p.1 ∈ Ioo x1 b0 ∧ p.2 ∈ Ioo p.1 b0} from rfl] at hm2u hint2 ⊢
  rw [setIntegral_slice_Ioo hx1.2 (T := fun x2 => Ioo x2 b0) (fun _ => measurableSet_Ioo) hm2u hint2]
  apply intervalIntegral.integral_congr; intro x2 hx2; dsimp only
  rw [uIcc_of_le hx1.2] at hx2
  rw [← MeasureTheory.integral_Ioc_eq_integral_Ioo, ← intervalIntegral.integral_of_le hx2.2]

private lemma setIntegral_D_eq_C00 {g : R4 → ℝ} (hg : ContinuousOn g B_box) :
    ∫ x in D_set, g x = ∫ x in C00_set, g x := by
  rw [setIntegral_D_eq_iter hg, setIntegral_C00_eq_iter hg]

private def D112_set : Set R4 := {x : R4 | x ∈ B_box ∧ x.2.2.1 < x.2.2.2}
private def A0_set : Set R4 := {x : R4 | x ∈ B_box ∧ x.2.1 < x.2.2.1 ∧ x.2.2.1 < x.2.2.2}
private def C0_set : Set R4 := {x : R4 | x ∈ B_box ∧ x.1 < x.2.1 ∧ x.2.1 < x.2.2.1 ∧ x.2.2.1 < x.2.2.2}

private lemma measurableSet_D112 : MeasurableSet D112_set := by
  show MeasurableSet (B_box ∩ {x : R4 | x.2.2.1 < x.2.2.2})
  exact isClosed_B.measurableSet.inter (isOpen_lt c_x2 c_x3).measurableSet

private lemma measurableSet_A0 : MeasurableSet A0_set := by
  show MeasurableSet (B_box ∩ ({x : R4 | x.2.1 < x.2.2.1} ∩ {x : R4 | x.2.2.1 < x.2.2.2}))
  exact isClosed_B.measurableSet.inter
    ((isOpen_lt c_x1 c_x2).inter (isOpen_lt c_x2 c_x3)).measurableSet

private lemma measurableSet_C0 : MeasurableSet C0_set := by
  show MeasurableSet (B_box ∩ ({x : R4 | x.1 < x.2.1} ∩ ({x : R4 | x.2.1 < x.2.2.1} ∩ {x : R4 | x.2.2.1 < x.2.2.2})))
  exact isClosed_B.measurableSet.inter
    ((isOpen_lt c_x0 c_x1).inter
      ((isOpen_lt c_x1 c_x2).inter (isOpen_lt c_x2 c_x3))).measurableSet

private lemma sym_pull {g : R4 → ℝ} (e : R4 ≃ᵐ R4) (hmp : MeasurePreserving e volume volume)
    (hinv : ∀ x, g (e x) = g x) (S : Set R4) :
    ∫ x in e ⁻¹' S, g x = ∫ x in S, g x := by
  have h1 := hmp.setIntegral_preimage_emb e.measurableEmbedding g S
  simp_rw [hinv] at h1
  exact h1

private lemma sym4_step1 {g : R4 → ℝ} (hintB : IntegrableOn g B_box volume)
    (hnn : ∀ x ∈ B_box, 0 ≤ g x) (hs23 : ∀ x, g (s23 x) = g x) :
    2 * ∫ x in D112_set, g x ≤ ∫ x in B_box, g x := by
  have hm1 : MeasurableSet (s23 ⁻¹' D112_set) := s23.measurable measurableSet_D112
  have hsub1 : D112_set ∪ (s23 ⁻¹' D112_set) ⊆ B_box := by
    rintro x (hx | hx)
    · exact hx.1
    · simp only [mem_preimage, D112_set, mem_ofPred_eq, s23_apply, B_box, mem_prod] at hx ⊢
      exact ⟨hx.1.1, hx.1.2.1, hx.1.2.2.2, hx.1.2.2.1⟩
  have hdisj1 : Disjoint D112_set (s23 ⁻¹' D112_set) := by
    rw [Set.disjoint_left]; intro x hx1 hx2
    simp only [mem_preimage, D112_set, mem_ofPred_eq, s23_apply] at hx1 hx2
    linarith
  have hu : ∫ x in D112_set ∪ (s23 ⁻¹' D112_set), g x =
      (∫ x in D112_set, g x) + ∫ x in s23 ⁻¹' D112_set, g x :=
    setIntegral_union hdisj1 hm1 (hintB.mono_set (fun x hx => hx.1))
      (hintB.mono_set (fun x hx => hsub1 (Or.inr hx)))
  have hm : ∫ x in D112_set ∪ (s23 ⁻¹' D112_set), g x ≤ ∫ x in B_box, g x :=
    setIntegral_mono_set hintB (ae_restrict_of_forall_mem isClosed_B.measurableSet hnn) hsub1.eventuallyLE
  have he := sym_pull s23 hmp_s23 hs23 D112_set
  linarith

private def eA2 : R4 ≃ᵐ R4 := s12.trans s23
private lemma hmp_eA2 : MeasurePreserving eA2 volume volume := hmp_s23.comp hmp_s12

private lemma sym4_step2 {g : R4 → ℝ} (hintB : IntegrableOn g B_box volume)
    (hnn : ∀ x ∈ B_box, 0 ≤ g x) (hs12 : ∀ x, g (s12 x) = g x) (hs23 : ∀ x, g (s23 x) = g x) :
    3 * ∫ x in A0_set, g x ≤ ∫ x in D112_set, g x := by
  have hsA2 : ∀ x, g (eA2 x) = g x := fun x => by change g (s23 (s12 x)) = g x; rw [hs23, hs12]
  have hmA1 : MeasurableSet (s12 ⁻¹' A0_set) := s12.measurable measurableSet_A0
  have hmA2 : MeasurableSet (eA2 ⁻¹' A0_set) := eA2.measurable measurableSet_A0
  have hsubA : (A0_set ∪ (s12 ⁻¹' A0_set)) ∪ (eA2 ⁻¹' A0_set) ⊆ D112_set := by
    rintro x ((hx | hx) | hx)
    · exact ⟨hx.1, hx.2.2⟩
    · simp only [mem_preimage, A0_set, mem_ofPred_eq, s12_apply, B_box, mem_prod] at hx
      exact ⟨⟨hx.1.1, hx.1.2.2.1, hx.1.2.1, hx.1.2.2.2⟩, by linarith⟩
    · simp only [eA2, MeasurableEquiv.trans_apply, mem_preimage, A0_set, mem_ofPred_eq,
        s12_apply, s23_apply, B_box, mem_prod] at hx
      exact ⟨⟨hx.1.1, hx.1.2.2.2, hx.1.2.1, hx.1.2.2.1⟩, hx.2.1⟩
  have hd01 : Disjoint A0_set (s12 ⁻¹' A0_set) := by
    rw [Set.disjoint_left]; intro x hx0 hx1
    simp only [mem_preimage, A0_set, mem_ofPred_eq, s12_apply] at hx0 hx1; linarith
  have hd012 : Disjoint (A0_set ∪ (s12 ⁻¹' A0_set)) (eA2 ⁻¹' A0_set) := by
    rw [Set.disjoint_left]; rintro x (hx0 | hx1) hx2 <;>
    simp only [eA2, MeasurableEquiv.trans_apply, mem_preimage, A0_set, mem_ofPred_eq,
      s12_apply, s23_apply] at * <;> linarith
  have hintD112 : IntegrableOn g D112_set volume := hintB.mono_set (fun x hx => hx.1)
  have hu1 : ∫ x in A0_set ∪ (s12 ⁻¹' A0_set), g x =
      (∫ x in A0_set, g x) + ∫ x in s12 ⁻¹' A0_set, g x :=
    setIntegral_union hd01 hmA1 (hintD112.mono_set (fun x hx => hsubA (Or.inl (Or.inl hx))))
      (hintD112.mono_set (fun x hx => hsubA (Or.inl (Or.inr hx))))
  have hu2 : ∫ x in (A0_set ∪ (s12 ⁻¹' A0_set)) ∪ (eA2 ⁻¹' A0_set), g x =
      (∫ x in A0_set ∪ (s12 ⁻¹' A0_set), g x) + ∫ x in eA2 ⁻¹' A0_set, g x :=
    setIntegral_union hd012 hmA2 (hintD112.mono_set (fun x hx => hsubA (Or.inl hx)))
      (hintD112.mono_set (fun x hx => hsubA (Or.inr hx)))
  have hm : ∫ x in (A0_set ∪ (s12 ⁻¹' A0_set)) ∪ (eA2 ⁻¹' A0_set), g x ≤ ∫ x in D112_set, g x :=
    setIntegral_mono_set hintD112
      (ae_restrict_of_forall_mem measurableSet_D112 (fun x hx => hnn x hx.1)) hsubA.eventuallyLE
  have he1 := sym_pull s12 hmp_s12 hs12 A0_set
  have he2 := sym_pull eA2 hmp_eA2 hsA2 A0_set
  linarith

private def eC2 : R4 ≃ᵐ R4 := s01.trans s12
private def eC3 : R4 ≃ᵐ R4 := s01.trans eA2
private lemma hmp_eC2 : MeasurePreserving eC2 volume volume := hmp_s12.comp hmp_s01
private lemma hmp_eC3 : MeasurePreserving eC3 volume volume := hmp_eA2.comp hmp_s01

private lemma sym4_step3 {g : R4 → ℝ} (hintB : IntegrableOn g B_box volume)
    (hnn : ∀ x ∈ B_box, 0 ≤ g x)
    (hs01 : ∀ x, g (s01 x) = g x) (hs12 : ∀ x, g (s12 x) = g x) (hs23 : ∀ x, g (s23 x) = g x) :
    4 * ∫ x in C0_set, g x ≤ ∫ x in A0_set, g x := by
  have hsA2 : ∀ x, g (eA2 x) = g x := fun x => by change g (s23 (s12 x)) = g x; rw [hs23, hs12]
  have hsC2 : ∀ x, g (eC2 x) = g x := fun x => by change g (s12 (s01 x)) = g x; rw [hs12, hs01]
  have hsC3 : ∀ x, g (eC3 x) = g x := fun x => by change g (eA2 (s01 x)) = g x; rw [hsA2, hs01]
  have hmC1 : MeasurableSet (s01 ⁻¹' C0_set) := s01.measurable measurableSet_C0
  have hmC2 : MeasurableSet (eC2 ⁻¹' C0_set) := eC2.measurable measurableSet_C0
  have hmC3 : MeasurableSet (eC3 ⁻¹' C0_set) := eC3.measurable measurableSet_C0
  have hsubC : ((C0_set ∪ (s01 ⁻¹' C0_set)) ∪ (eC2 ⁻¹' C0_set)) ∪ (eC3 ⁻¹' C0_set) ⊆ A0_set := by
    rintro x (((hx | hx) | hx) | hx)
    · exact ⟨hx.1, hx.2.2.1, hx.2.2.2⟩
    · simp only [mem_preimage, C0_set, mem_ofPred_eq, s01_apply, B_box, mem_prod] at hx
      exact ⟨⟨hx.1.2.1, hx.1.1, hx.1.2.2.1, hx.1.2.2.2⟩, by linarith, hx.2.2.2⟩
    · simp only [eC2, MeasurableEquiv.trans_apply, mem_preimage, C0_set, mem_ofPred_eq,
        s01_apply, s12_apply, B_box, mem_prod] at hx
      exact ⟨⟨hx.1.2.2.1, hx.1.1, hx.1.2.1, hx.1.2.2.2⟩, hx.2.1, by linarith⟩
    · simp only [eC3, eA2, MeasurableEquiv.trans_apply, mem_preimage, C0_set, mem_ofPred_eq,
        s01_apply, s12_apply, s23_apply, B_box, mem_prod] at hx
      exact ⟨⟨hx.1.2.2.2, hx.1.1, hx.1.2.1, hx.1.2.2.1⟩, hx.2.1, hx.2.2.1⟩
  have hd01 : Disjoint C0_set (s01 ⁻¹' C0_set) := by
    rw [Set.disjoint_left]; intro x hx0 hx1
    simp only [mem_preimage, C0_set, mem_ofPred_eq, s01_apply] at hx0 hx1; linarith
  have hd012 : Disjoint (C0_set ∪ (s01 ⁻¹' C0_set)) (eC2 ⁻¹' C0_set) := by
    rw [Set.disjoint_left]; rintro x (hx0 | hx1) hx2 <;>
    simp only [eC2, MeasurableEquiv.trans_apply, mem_preimage, C0_set, mem_ofPred_eq,
      s01_apply, s12_apply] at * <;> linarith
  have hd0123 : Disjoint ((C0_set ∪ (s01 ⁻¹' C0_set)) ∪ (eC2 ⁻¹' C0_set)) (eC3 ⁻¹' C0_set) := by
    rw [Set.disjoint_left]; rintro x ((hx0 | hx1) | hx2) hx3 <;>
    simp only [eC2, eC3, eA2, MeasurableEquiv.trans_apply, mem_preimage, C0_set,
      mem_ofPred_eq, s01_apply, s12_apply, s23_apply] at * <;> linarith
  have hintA0 : IntegrableOn g A0_set volume := hintB.mono_set (fun x hx => hx.1)
  have hu1 : ∫ x in C0_set ∪ (s01 ⁻¹' C0_set), g x =
      (∫ x in C0_set, g x) + ∫ x in s01 ⁻¹' C0_set, g x :=
    setIntegral_union hd01 hmC1
      (hintA0.mono_set (fun x hx => hsubC (Or.inl (Or.inl (Or.inl hx)))))
      (hintA0.mono_set (fun x hx => hsubC (Or.inl (Or.inl (Or.inr hx)))))
  have hu2 : ∫ x in (C0_set ∪ (s01 ⁻¹' C0_set)) ∪ (eC2 ⁻¹' C0_set), g x =
      (∫ x in C0_set ∪ (s01 ⁻¹' C0_set), g x) + ∫ x in eC2 ⁻¹' C0_set, g x :=
    setIntegral_union hd012 hmC2
      (hintA0.mono_set (fun x hx => hsubC (Or.inl (Or.inl hx))))
      (hintA0.mono_set (fun x hx => hsubC (Or.inl (Or.inr hx))))
  have hu3 : ∫ x in ((C0_set ∪ (s01 ⁻¹' C0_set)) ∪ (eC2 ⁻¹' C0_set)) ∪ (eC3 ⁻¹' C0_set), g x =
      (∫ x in (C0_set ∪ (s01 ⁻¹' C0_set)) ∪ (eC2 ⁻¹' C0_set), g x) + ∫ x in eC3 ⁻¹' C0_set, g x :=
    setIntegral_union hd0123 hmC3
      (hintA0.mono_set (fun x hx => hsubC (Or.inl hx)))
      (hintA0.mono_set (fun x hx => hsubC (Or.inr hx)))
  have hm : ∫ x in ((C0_set ∪ (s01 ⁻¹' C0_set)) ∪ (eC2 ⁻¹' C0_set)) ∪ (eC3 ⁻¹' C0_set), g x ≤
      ∫ x in A0_set, g x :=
    setIntegral_mono_set hintA0
      (ae_restrict_of_forall_mem measurableSet_A0 (fun x hx => hnn x hx.1)) hsubC.eventuallyLE
  have he1 := sym_pull s01 hmp_s01 hs01 C0_set
  have he2 := sym_pull eC2 hmp_eC2 hsC2 C0_set
  have he3 := sym_pull eC3 hmp_eC3 hsC3 C0_set
  linarith

private lemma sym4_le_cube {g : R4 → ℝ} (hg : ContinuousOn g B_box)
    (hnn : ∀ x ∈ B_box, 0 ≤ g x)
    (hs01 : ∀ x, g (s01 x) = g x) (hs12 : ∀ x, g (s12 x) = g x) (hs23 : ∀ x, g (s23 x) = g x) :
    24 * ∫ x in D_set, g x ≤ ∫ x in B_box, g x := by
  have hintB : IntegrableOn g B_box volume := hg.integrableOn_compact isCompact_B
  have h1 := sym4_step1 hintB hnn hs23
  have h2 := sym4_step2 hintB hnn hs12 hs23
  have h3 := sym4_step3 hintB hnn hs01 hs12 hs23
  have hC00_sub : C00_set ⊆ C0_set := fun x ⟨h0, h01, h12, h23, h3'⟩ =>
    ⟨⟨⟨le_of_lt h0, by linarith⟩, ⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩, ⟨by linarith, le_of_lt h3'⟩⟩,
     h01, h12, h23⟩
  have heqD : ∫ x in D_set, g x = ∫ x in C00_set, g x := setIntegral_D_eq_C00 hg
  have hleC0 : ∫ x in C00_set, g x ≤ ∫ x in C0_set, g x :=
    setIntegral_mono_set (hintB.mono_set (fun x hx => hx.1))
      (ae_restrict_of_forall_mem measurableSet_C0 (fun x hx => hnn x hx.1)) hC00_sub.eventuallyLE
  linarith

private lemma B_box_s23 : s23 ⁻¹' B_box = B_box := by
  ext x; simp only [mem_preimage, B_box, mem_prod, s23_apply]
  exact ⟨fun ⟨h0, h1, h3, h2⟩ => ⟨h0, h1, h2, h3⟩, fun ⟨h0, h1, h2, h3⟩ => ⟨h0, h1, h3, h2⟩⟩

private lemma B_box_s12 : s12 ⁻¹' B_box = B_box := by
  ext x; simp only [mem_preimage, B_box, mem_prod, s12_apply]
  exact ⟨fun ⟨h0, h2, h1, h3⟩ => ⟨h0, h1, h2, h3⟩, fun ⟨h0, h1, h2, h3⟩ => ⟨h0, h2, h1, h3⟩⟩

private lemma B_box_s01 : s01 ⁻¹' B_box = B_box := by
  ext x; simp only [mem_preimage, B_box, mem_prod, s01_apply]
  exact ⟨fun ⟨h1, h0, h2, h3⟩ => ⟨h0, h1, h2, h3⟩, fun ⟨h0, h1, h2, h3⟩ => ⟨h1, h0, h2, h3⟩⟩

private def proj3 (x : R4) : R3 := (x.1, x.2.1, x.2.2.1)

private lemma cont_S1d_herm_comp {H_fn : R4 → ℝ} (hH_c : ContinuousOn H_fn B_box)
    (hH_gt : ∀ x ∈ B_box, b0 < H_fn x) :
    ContinuousOn (fun x : R4 => S1d_herm (H_fn x) x.2.2.2) B_box := by
  have hc_x3 : ContinuousOn (fun x : R4 => x.2.2.2) B_box := c_x3.continuousOn
  have hH_pos : ∀ x ∈ B_box, 0 < H_fn x := fun x hx => lt_trans hb0_pos (hH_gt x hx)
  have hHb_pos : ∀ x ∈ B_box, 0 < H_fn x - b0 := fun x hx => sub_pos.mpr (hH_gt x hx)
  have hHa_pos : ∀ x ∈ B_box, 0 < H_fn x - a0 := fun x hx => by linarith [hH_gt x hx, hab0]
  have hM_c : ContinuousOn (fun x => ((H_fn x - b0) + (H_fn x - a0)) / 2) B_box :=
    ((hH_c.sub continuousOn_const).add (hH_c.sub continuousOn_const)).div_const 2
  have hHm_pos : ∀ x ∈ B_box, 0 < ((H_fn x - b0) + (H_fn x - a0)) / 2 := fun x hx => by
    linarith [hHb_pos x hx, hHa_pos x hx]
  have hc1 : ContinuousOn (fun x : R4 => H3_herm a0 b0 x.2.2.2) B_box :=
    ((cont_H3_herm a0 b0).comp c_x3).continuousOn
  have hc2 : ContinuousOn (fun x : R4 => H3_herm (H_fn x - b0) (H_fn x - a0) (H_fn x - x.2.2.2)) B_box := by
    unfold H3_herm; dsimp only
    have hd1_c : ContinuousOn (fun x => (H_fn x - b0) * (((H_fn x - b0) + (H_fn x - a0)) / 2) * (H_fn x - a0)) B_box :=
      ((hH_c.sub continuousOn_const).mul hM_c).mul (hH_c.sub continuousOn_const)
    have hd2_c : ContinuousOn (fun x => (H_fn x - b0) * (((H_fn x - b0) + (H_fn x - a0)) / 2) ^ 2 * (H_fn x - a0)) B_box :=
      ((hH_c.sub continuousOn_const).mul (hM_c.pow 2)).mul (hH_c.sub continuousOn_const)
    have hdiff_c : ContinuousOn (fun x => (H_fn x - x.2.2.2) - ((H_fn x - b0) + (H_fn x - a0)) / 2) B_box :=
      (hH_c.sub hc_x3).sub hM_c
    exact (((continuousOn_const.div hM_c (fun x hx => ne_of_gt (hHm_pos x hx))).sub
      (hdiff_c.div (hM_c.pow 2) (fun x hx => ne_of_gt (pow_pos (hHm_pos x hx) 2)))).add
      ((hdiff_c.pow 2).div hd1_c
        (fun x hx => ne_of_gt (mul_pos (mul_pos (hHb_pos x hx) (hHm_pos x hx)) (hHa_pos x hx))))).sub
      ((hdiff_c.pow 3).div hd2_c
        (fun x hx => ne_of_gt (mul_pos (mul_pos (hHb_pos x hx) (pow_pos (hHm_pos x hx) 2)) (hHa_pos x hx))))
  exact (continuousOn_const.div hH_c (fun x hx => ne_of_gt (hH_pos x hx))).mul (hc1.add hc2)

private lemma peel_slot4 {φ : ℝ} (hφ : 2 ≤ φ)
    {c3 s3 : ℝ → ℝ → ℝ → ℝ}
    (hc3 : ContinuousOn (fun p : R3 => c3 p.1 p.2.1 p.2.2) B3_box)
    (hs3 : ContinuousOn (fun p : R3 => s3 p.1 p.2.1 p.2.2) B3_box)
    (hnn : ∀ x ∈ B_box, 0 ≤ c3 x.1 x.2.1 x.2.2.1)
    (hs_ub : ∀ x ∈ B_box, s3 x.1 x.2.1 x.2.2.1 ≤ 3 * b0) :
    ∫ x in B_box, c3 x.1 x.2.1 x.2.2.1 / (x.2.2.2 * (φ - s3 x.1 x.2.1 x.2.2.1 - x.2.2.2)) ≤
      ∑ i : Fin 3, γ3 i * ∫ x in B_box,
        (c3 x.1 x.2.1 x.2.2.1 / w0) / (φ - (s3 x.1 x.2.1 x.2.2.1 + ν3 i)) := by
  have hp3_cont : Continuous proj3 := c_x0.prodMk (c_x1.prodMk c_x2)
  have hp3_maps : MapsTo proj3 B_box B3_box := fun _ ⟨h0, h1, h2, _⟩ => ⟨h0, h1, h2⟩
  have hc3_4 : ContinuousOn (fun x : R4 => c3 x.1 x.2.1 x.2.2.1) B_box := hc3.comp hp3_cont.continuousOn hp3_maps
  have hs3_4 : ContinuousOn (fun x : R4 => s3 x.1 x.2.1 x.2.2.1) B_box := hs3.comp hp3_cont.continuousOn hp3_maps
  have hc_x3 : ContinuousOn (fun x : R4 => x.2.2.2) B_box := c_x3.continuousOn
  have hH_gt : ∀ x ∈ B_box, b0 < φ - s3 x.1 x.2.1 x.2.2.1 := by
    intro x hx; have := hs_ub x hx; norm_num [b0, BuchstabArithmetic.b] at this ⊢; linarith
  have hLHS_cont : ContinuousOn
      (fun x : R4 => c3 x.1 x.2.1 x.2.2.1 / (x.2.2.2 * (φ - s3 x.1 x.2.1 x.2.2.1 - x.2.2.2))) B_box := by
    apply hc3_4.div (hc_x3.mul ((continuousOn_const.sub hs3_4).sub hc_x3))
    intro x hx
    have p3 : 0 < x.2.2.2 := lt_of_lt_of_le ha0_pos hx.2.2.2.1
    have p4 : 0 < φ - s3 x.1 x.2.1 x.2.2.1 - x.2.2.2 := by linarith [hH_gt x hx, hx.2.2.2.2]
    exact ne_of_gt (mul_pos p3 p4)
  have hF_cont : ContinuousOn
      (fun x : R4 => c3 x.1 x.2.1 x.2.2.1 * S1d_herm (φ - s3 x.1 x.2.1 x.2.2.1) x.2.2.2) B_box :=
    hc3_4.mul (cont_S1d_herm_comp (continuousOn_const.sub hs3_4) hH_gt)
  have hmono : ∫ x in B_box, c3 x.1 x.2.1 x.2.2.1 / (x.2.2.2 * (φ - s3 x.1 x.2.1 x.2.2.1 - x.2.2.2)) ≤
      ∫ x in B_box, c3 x.1 x.2.1 x.2.2.1 * S1d_herm (φ - s3 x.1 x.2.1 x.2.2.1) x.2.2.2 := by
    apply setIntegral_mono_on (hLHS_cont.integrableOn_compact isCompact_B)
      (hF_cont.integrableOn_compact isCompact_B) isClosed_B.measurableSet
    intro x hx
    rw [div_eq_mul_one_div]
    exact mul_le_mul_of_nonneg_left (inv_mul_sub_le_S1d_herm (hH_gt x hx) hx.2.2.2) (hnn x hx)
  refine le_trans hmono (le_of_eq ?_)
  rw [setIntegral_B_eq_iter hF_cont]
  have hRHS_cont : ∀ i : Fin 3, ContinuousOn
      (fun x : R4 => (c3 x.1 x.2.1 x.2.2.1 / w0) / (φ - (s3 x.1 x.2.1 x.2.2.1 + ν3 i))) B_box := by
    intro i
    apply (hc3_4.div_const w0).div (continuousOn_const.sub (hs3_4.add continuousOn_const))
    intro x hx
    have hi := ν3_le_b0 i
    have hs := hs_ub x hx
    norm_num [b0, BuchstabArithmetic.b] at hi hs
    change φ - (s3 x.1 x.2.1 x.2.2.1 + ν3 i) ≠ 0
    exact ne_of_gt (by linarith)
  have hsum_eq : ∑ i : Fin 3, γ3 i * ∫ x in B_box,
        (c3 x.1 x.2.1 x.2.2.1 / w0) / (φ - (s3 x.1 x.2.1 x.2.2.1 + ν3 i)) =
      ∫ x in B_box, ∑ i : Fin 3, γ3 i *
        ((c3 x.1 x.2.1 x.2.2.1 / w0) / (φ - (s3 x.1 x.2.1 x.2.2.1 + ν3 i))) := by
    rw [integral_finsetSum _ (fun i _ => ((hRHS_cont i).const_mul (γ3 i)).integrableOn_compact isCompact_B)]
    refine Finset.sum_congr rfl fun i _ => (integral_const_mul _ _).symm
  rw [hsum_eq, setIntegral_B_eq_iter (continuousOn_finsetSum _ fun i _ => (hRHS_cont i).const_mul (γ3 i))]
  apply intervalIntegral.integral_congr; intro x0 hx0; dsimp only; rw [uIcc_of_le hab0] at hx0
  apply intervalIntegral.integral_congr; intro x1 hx1; dsimp only; rw [uIcc_of_le hab0] at hx1
  apply intervalIntegral.integral_congr; intro x2 hx2; dsimp only; rw [uIcc_of_le hab0] at hx2
  have hH_here : b0 < φ - s3 x0 x1 x2 := hH_gt (x0, x1, x2, a0) ⟨hx0, hx1, hx2, ⟨le_refl _, hab0⟩⟩
  rw [intervalIntegral.integral_const_mul, integral_S1d_herm hH_here,
      intervalIntegral.integral_const, smul_eq_mul, Finset.mul_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  have hw_eq : b0 - a0 = w0 := rfl
  rw [hw_eq]
  have hw_ne : w0 ≠ 0 := ne_of_gt hw0_pos
  have hden_ne : φ - (s3 x0 x1 x2 + ν3 i) ≠ 0 := by
    have hi := ν3_le_b0 i; linarith [hH_here]
  have hden_eq : φ - s3 x0 x1 x2 - ν3 i = φ - (s3 x0 x1 x2 + ν3 i) := by ring
  rw [hden_eq]
  field_simp [hw_ne, hden_ne]

private lemma f_smooth_cont {φ : ℝ} (hφ : 2 ≤ φ) : ContinuousOn (f_smooth φ) B_box := by
  unfold f_smooth
  apply continuousOn_const.div
    ((((c_x0.mul c_x1).mul c_x2).mul c_x3).mul
      ((((continuous_const.sub c_x0).sub c_x1).sub c_x2).sub c_x3)).continuousOn
  intro x ⟨hx0, hx1, hx2, hx3⟩
  change x.1 * x.2.1 * x.2.2.1 * x.2.2.2 * (φ - x.1 - x.2.1 - x.2.2.1 - x.2.2.2) ≠ 0
  have p0 : 0 < x.1 := lt_of_lt_of_le ha0_pos hx0.1
  have p1 : 0 < x.2.1 := lt_of_lt_of_le ha0_pos hx1.1
  have p2 : 0 < x.2.2.1 := lt_of_lt_of_le ha0_pos hx2.1
  have p3 : 0 < x.2.2.2 := lt_of_lt_of_le ha0_pos hx3.1
  have p4 : 0 < φ - x.1 - x.2.1 - x.2.2.1 - x.2.2.2 := by
    norm_num [b0, BuchstabArithmetic.b] at hx0 hx1 hx2 hx3; linarith [hx0.2, hx1.2, hx2.2, hx3.2]
  positivity

private lemma prod_inv4_cont : ContinuousOn prod_inv4 B_box := by
  unfold prod_inv4
  apply continuousOn_const.div (((c_x0.mul c_x1).mul c_x2).mul c_x3).continuousOn
  intro x ⟨h0, h1, h2, h3⟩
  change x.1 * x.2.1 * x.2.2.1 * x.2.2.2 ≠ 0
  have q0 := lt_of_lt_of_le ha0_pos h0.1; have q1 := lt_of_lt_of_le ha0_pos h1.1
  have q2 := lt_of_lt_of_le ha0_pos h2.1; have q3 := lt_of_lt_of_le ha0_pos h3.1
  positivity

private lemma J_peel1 {φ : ℝ} (hφ : 2 ≤ φ) :
    ∫ x in B_box, f_smooth φ x ≤
      ∑ i3 : Fin 3, γ3 i3 * ∫ x in B_box,
        ((1 / (x.1 * x.2.1 * x.2.2.1)) / w0) / (φ - (x.1 + x.2.1 + x.2.2.1 + ν3 i3)) := by
  have hrew0 : ∫ x in B_box, f_smooth φ x =
      ∫ x in B_box, (1 / (x.1 * x.2.1 * x.2.2.1)) / (x.2.2.2 * (φ - (x.1 + x.2.1 + x.2.2.1) - x.2.2.2)) := by
    apply setIntegral_congr_fun isClosed_B.measurableSet; intro x _
    unfold f_smooth; simp only [div_div]; congr 1; ring
  rw [hrew0]
  have hc3 : ContinuousOn (fun p : R3 => 1 / (p.1 * p.2.1 * p.2.2)) B3_box := by
    apply continuousOn_const.div ((c_y0.mul c_y1).mul c_y2).continuousOn
    intro p ⟨h0, h1, h2⟩
    change p.1 * p.2.1 * p.2.2 ≠ 0
    have q0 := lt_of_lt_of_le ha0_pos h0.1; have q1 := lt_of_lt_of_le ha0_pos h1.1; have q2 := lt_of_lt_of_le ha0_pos h2.1
    positivity
  have hs3 : ContinuousOn (fun p : R3 => p.1 + p.2.1 + p.2.2) B3_box :=
    ((c_y0.add c_y1).add c_y2).continuousOn
  exact peel_slot4 hφ (c3 := fun x0 x1 x2 => 1 / (x0 * x1 * x2)) (s3 := fun x0 x1 x2 => x0 + x1 + x2)
    hc3 hs3
    (fun x ⟨h0, h1, h2, _⟩ => by
      have q0 := lt_of_lt_of_le ha0_pos h0.1; have q1 := lt_of_lt_of_le ha0_pos h1.1; have q2 := lt_of_lt_of_le ha0_pos h2.1
      positivity)
    (fun x ⟨h0, h1, h2, _⟩ => by linarith [h0.2, h1.2, h2.2])

private lemma J_peel2 {φ : ℝ} (hφ : 2 ≤ φ) (i3 : Fin 3) :
    ∫ x in B_box, ((1 / (x.1 * x.2.1 * x.2.2.1)) / w0) / (φ - (x.1 + x.2.1 + x.2.2.1 + ν3 i3)) ≤
      ∑ i2 : Fin 3, γ3 i2 * ∫ x in B_box,
        ((1 / (w0 * x.1 * x.2.1)) / w0) / (φ - (x.1 + x.2.1 + ν3 i3 + ν3 i2)) := by
  have hs := hmp_s23.setIntegral_preimage_emb s23.measurableEmbedding
    (fun x : R4 => ((1 / (x.1 * x.2.1 * x.2.2.1)) / w0) / (φ - (x.1 + x.2.1 + x.2.2.1 + ν3 i3))) B_box
  rw [B_box_s23] at hs; rw [← hs]
  have hrew : ∫ x in B_box, ((1 / ((s23 x).1 * (s23 x).2.1 * (s23 x).2.2.1)) / w0) /
        (φ - ((s23 x).1 + (s23 x).2.1 + (s23 x).2.2.1 + ν3 i3)) =
      ∫ x in B_box, (1 / (w0 * x.1 * x.2.1)) / (x.2.2.2 * (φ - (x.1 + x.2.1 + ν3 i3) - x.2.2.2)) := by
    apply setIntegral_congr_fun isClosed_B.measurableSet; intro x _
    simp only [s23_apply, div_div]; congr 1; ring
  rw [hrew]
  have hc3 : ContinuousOn (fun p : R3 => 1 / (w0 * p.1 * p.2.1)) B3_box := by
    apply continuousOn_const.div ((continuous_const.mul c_y0).mul c_y1).continuousOn
    intro p ⟨h0, h1, _⟩
    change w0 * p.1 * p.2.1 ≠ 0
    have q0 := lt_of_lt_of_le ha0_pos h0.1; have q1 := lt_of_lt_of_le ha0_pos h1.1; have qw := hw0_pos
    positivity
  have hs3 : ContinuousOn (fun p : R3 => p.1 + p.2.1 + ν3 i3) B3_box :=
    ((c_y0.add c_y1).add continuous_const).continuousOn
  exact peel_slot4 hφ (c3 := fun x0 x1 _ => 1 / (w0 * x0 * x1)) (s3 := fun x0 x1 _ => x0 + x1 + ν3 i3)
    hc3 hs3
    (fun x ⟨h0, h1, _, _⟩ => by
      have q0 := lt_of_lt_of_le ha0_pos h0.1; have q1 := lt_of_lt_of_le ha0_pos h1.1; have qw := hw0_pos
      positivity)
    (fun x ⟨h0, h1, _, _⟩ => by linarith [h0.2, h1.2, ν3_le_b0 i3])

private def e13 : R4 ≃ᵐ R4 := s23.trans s12
private lemma hmp13 : MeasurePreserving e13 volume volume := hmp_s12.comp hmp_s23
private lemma hB13 : e13 ⁻¹' B_box = B_box := by
  change s23 ⁻¹' (s12 ⁻¹' B_box) = B_box; rw [B_box_s12, B_box_s23]

private lemma J_peel3 {φ : ℝ} (hφ : 2 ≤ φ) (i3 i2 : Fin 3) :
    ∫ x in B_box, ((1 / (w0 * x.1 * x.2.1)) / w0) / (φ - (x.1 + x.2.1 + ν3 i3 + ν3 i2)) ≤
      ∑ i1 : Fin 3, γ3 i1 * ∫ x in B_box,
        ((1 / (w0 ^ 2 * x.1)) / w0) / (φ - (x.1 + ν3 i3 + ν3 i2 + ν3 i1)) := by
  have hs := hmp13.setIntegral_preimage_emb e13.measurableEmbedding
    (fun x : R4 => ((1 / (w0 * x.1 * x.2.1)) / w0) / (φ - (x.1 + x.2.1 + ν3 i3 + ν3 i2))) B_box
  rw [hB13] at hs; rw [← hs]
  have hrew : ∫ x in B_box, ((1 / (w0 * (e13 x).1 * (e13 x).2.1)) / w0) /
        (φ - ((e13 x).1 + (e13 x).2.1 + ν3 i3 + ν3 i2)) =
      ∫ x in B_box, (1 / (w0 ^ 2 * x.1)) / (x.2.2.2 * (φ - (x.1 + ν3 i3 + ν3 i2) - x.2.2.2)) := by
    apply setIntegral_congr_fun isClosed_B.measurableSet; intro x _
    simp only [e13, MeasurableEquiv.trans_apply, s12_apply, s23_apply, div_div]; congr 1; ring
  rw [hrew]
  have hc3 : ContinuousOn (fun p : R3 => 1 / (w0 ^ 2 * p.1)) B3_box := by
    apply continuousOn_const.div (continuous_const.mul c_y0).continuousOn
    intro p ⟨h0, _, _⟩
    change w0 ^ 2 * p.1 ≠ 0
    have q0 := lt_of_lt_of_le ha0_pos h0.1; have qw := hw0_pos; positivity
  have hs3 : ContinuousOn (fun p : R3 => p.1 + ν3 i3 + ν3 i2) B3_box :=
    ((c_y0.add continuous_const).add continuous_const).continuousOn
  exact peel_slot4 hφ (c3 := fun x0 _ _ => 1 / (w0 ^ 2 * x0)) (s3 := fun x0 _ _ => x0 + ν3 i3 + ν3 i2)
    hc3 hs3
    (fun x ⟨h0, _, _, _⟩ => by
      have q0 := lt_of_lt_of_le ha0_pos h0.1; have qw := hw0_pos; positivity)
    (fun x ⟨h0, _, _, _⟩ => by linarith [h0.2, ν3_le_b0 i3, ν3_le_b0 i2])

private def e03 : R4 ≃ᵐ R4 := e13.trans s01
private lemma hmp03 : MeasurePreserving e03 volume volume := hmp_s01.comp hmp13
private lemma hB03 : e03 ⁻¹' B_box = B_box := by
  change e13 ⁻¹' (s01 ⁻¹' B_box) = B_box; rw [B_box_s01, hB13]

private lemma hvol_B (c : ℝ) : ∫ _ in B_box, c = w0 ^ 4 * c := by
  rw [setIntegral_B_eq_iter continuousOn_const]
  simp only [intervalIntegral.integral_const, smul_eq_mul]
  have hw_eq : b0 - a0 = w0 := rfl
  rw [hw_eq]; ring

private lemma J_peel4 {φ : ℝ} (hφ : 2 ≤ φ) (i3 i2 i1 : Fin 3) :
    ∫ x in B_box, ((1 / (w0 ^ 2 * x.1)) / w0) / (φ - (x.1 + ν3 i3 + ν3 i2 + ν3 i1)) ≤
      ∑ i0 : Fin 3, γ3 i0 / (φ - (ν3 i3 + ν3 i2 + ν3 i1 + ν3 i0)) := by
  have hs := hmp03.setIntegral_preimage_emb e03.measurableEmbedding
    (fun x : R4 => ((1 / (w0 ^ 2 * x.1)) / w0) / (φ - (x.1 + ν3 i3 + ν3 i2 + ν3 i1))) B_box
  rw [hB03] at hs; rw [← hs]
  have hrew : ∫ x in B_box, ((1 / (w0 ^ 2 * (e03 x).1)) / w0) /
        (φ - ((e03 x).1 + ν3 i3 + ν3 i2 + ν3 i1)) =
      ∫ x in B_box, (1 / w0 ^ 3) / (x.2.2.2 * (φ - (ν3 i3 + ν3 i2 + ν3 i1) - x.2.2.2)) := by
    apply setIntegral_congr_fun isClosed_B.measurableSet; intro x _
    simp only [e03, e13, MeasurableEquiv.trans_apply, s01_apply, s12_apply, s23_apply, div_div]; congr 1; ring
  rw [hrew]
  have hp := peel_slot4 hφ
    (c3 := fun _ _ _ => 1 / w0 ^ 3)
    (s3 := fun _ _ _ => ν3 i3 + ν3 i2 + ν3 i1)
    continuousOn_const continuousOn_const
    (fun _ _ => by have qw := hw0_pos; positivity)
    (fun _ _ => by linarith [ν3_le_b0 i3, ν3_le_b0 i2, ν3_le_b0 i1])
  refine le_trans hp (le_of_eq (Finset.sum_congr rfl fun i0 _ => ?_))
  rw [hvol_B]
  have hw_ne : w0 ≠ 0 := ne_of_gt hw0_pos
  field_simp [hw_ne]

private lemma J_sum81_eq (φ : ℝ) :
    (∑ i3 : Fin 3, γ3 i3 * (∑ i2 : Fin 3, γ3 i2 * (∑ i1 : Fin 3, γ3 i1 *
      (∑ i0 : Fin 3, γ3 i0 / (φ - (ν3 i3 + ν3 i2 + ν3 i1 + ν3 i0)))))) =
      24 * BuchstabArithmetic.Q φ := by
  have hg0 : γ3 0 = 47 / 1440 := by norm_num [γ3, w0, a0, BuchstabArithmetic.w, BuchstabArithmetic.a, BuchstabArithmetic.b]
  have hg1 : γ3 1 = 188 / 1581 := by norm_num [γ3, w0, m0, BuchstabArithmetic.w, BuchstabArithmetic.mid, BuchstabArithmetic.a, BuchstabArithmetic.b]
  have hg2 : γ3 2 = 47 / 1722 := by norm_num [γ3, w0, b0, BuchstabArithmetic.w, BuchstabArithmetic.a, BuchstabArithmetic.b]
  have hnu : ∀ i3 i2 i1 i0 : Fin 3,
      ν3 i3 + ν3 i2 + ν3 i1 + ν3 i0 = (400 / 287 : ℝ) + ((i3.1 + i2.1 + i1.1 + i0.1 : ℕ) : ℝ) * (235 / 6888 : ℝ) := by
    intro i3 i2 i1 i0
    unfold ν3
    have ha : a0 = 100 / 287 := rfl
    have hw : w0 = 235 / 3444 := by norm_num [w0, BuchstabArithmetic.w, BuchstabArithmetic.a, BuchstabArithmetic.b]
    rw [ha, hw]; push_cast; ring
  simp_rw [hnu]
  simp only [Fin.sum_univ_three, hg0, hg1, hg2, Fin.val_zero, Fin.val_one, Fin.val_two,
             Nat.add_zero, Nat.zero_add, Nat.reduceAdd]
  have p0 : φ - ((400 / 287 : ℝ) + ((0 : ℕ) : ℝ) * (235 / 6888 : ℝ)) = φ - (400 / 287) := by norm_num
  have p1 : φ - ((400 / 287 : ℝ) + ((1 : ℕ) : ℝ) * (235 / 6888 : ℝ)) = φ - (1405 / 984) := by norm_num
  have p2 : φ - ((400 / 287 : ℝ) + ((2 : ℕ) : ℝ) * (235 / 6888 : ℝ)) = φ - (5035 / 3444) := by norm_num
  have p3 : φ - ((400 / 287 : ℝ) + ((3 : ℕ) : ℝ) * (235 / 6888 : ℝ)) = φ - (3435 / 2296) := by norm_num
  have p4 : φ - ((400 / 287 : ℝ) + ((4 : ℕ) : ℝ) * (235 / 6888 : ℝ)) = φ - (2635 / 1722) := by norm_num
  have p5 : φ - ((400 / 287 : ℝ) + ((5 : ℕ) : ℝ) * (235 / 6888 : ℝ)) = φ - (10775 / 6888) := by norm_num
  have p6 : φ - ((400 / 287 : ℝ) + ((6 : ℕ) : ℝ) * (235 / 6888 : ℝ)) = φ - (1835 / 1148) := by norm_num
  have p7 : φ - ((400 / 287 : ℝ) + ((7 : ℕ) : ℝ) * (235 / 6888 : ℝ)) = φ - (11245 / 6888) := by norm_num
  have p8 : φ - ((400 / 287 : ℝ) + ((8 : ℕ) : ℝ) * (235 / 6888 : ℝ)) = φ - (5 / 3) := by norm_num
  have q0 : ∀ x : ℝ, x / (φ - (400 / 287)) = x * (φ - (400 / 287))⁻¹ := fun x => div_eq_mul_inv x _
  have q1 : ∀ x : ℝ, x / (φ - (1405 / 984)) = x * (φ - (1405 / 984))⁻¹ := fun x => div_eq_mul_inv x _
  have q2 : ∀ x : ℝ, x / (φ - (5035 / 3444)) = x * (φ - (5035 / 3444))⁻¹ := fun x => div_eq_mul_inv x _
  have q3 : ∀ x : ℝ, x / (φ - (3435 / 2296)) = x * (φ - (3435 / 2296))⁻¹ := fun x => div_eq_mul_inv x _
  have q4 : ∀ x : ℝ, x / (φ - (2635 / 1722)) = x * (φ - (2635 / 1722))⁻¹ := fun x => div_eq_mul_inv x _
  have q5 : ∀ x : ℝ, x / (φ - (10775 / 6888)) = x * (φ - (10775 / 6888))⁻¹ := fun x => div_eq_mul_inv x _
  have q6 : ∀ x : ℝ, x / (φ - (1835 / 1148)) = x * (φ - (1835 / 1148))⁻¹ := fun x => div_eq_mul_inv x _
  have q7 : ∀ x : ℝ, x / (φ - (11245 / 6888)) = x * (φ - (11245 / 6888))⁻¹ := fun x => div_eq_mul_inv x _
  have q8 : ∀ x : ℝ, x / (φ - (5 / 3)) = x * (φ - (5 / 3))⁻¹ := fun x => div_eq_mul_inv x _
  simp only [p0, p1, p2, p3, p4, p5, p6, p7, p8, BuchstabArithmetic.Q,
             q0, q1, q2, q3, q4, q5, q6, q7, q8]
  ring

private lemma J_le_Q {φ : ℝ} (hφ : 2 ≤ φ) :
    ∫ x in D_set, f_smooth φ x ≤ BuchstabArithmetic.Q φ := by
  have hsym := sym4_le_cube (f_smooth_cont hφ)
    (fun x ⟨hx0, hx1, hx2, hx3⟩ => by
      unfold f_smooth
      have p0 : 0 < x.1 := lt_of_lt_of_le ha0_pos hx0.1
      have p1 : 0 < x.2.1 := lt_of_lt_of_le ha0_pos hx1.1
      have p2 : 0 < x.2.2.1 := lt_of_lt_of_le ha0_pos hx2.1
      have p3 : 0 < x.2.2.2 := lt_of_lt_of_le ha0_pos hx3.1
      have p4 : 0 < φ - x.1 - x.2.1 - x.2.2.1 - x.2.2.2 := by
        norm_num [b0, BuchstabArithmetic.b] at hx0 hx1 hx2 hx3; linarith [hx0.2, hx1.2, hx2.2, hx3.2]
      positivity)
    (fun x => by simp only [f_smooth, s01_apply]; ring)
    (fun x => by simp only [f_smooth, s12_apply]; ring)
    (fun x => by simp only [f_smooth, s23_apply]; ring)
  have hchain : ∫ x in B_box, f_smooth φ x ≤
      ∑ i3 : Fin 3, γ3 i3 * (∑ i2 : Fin 3, γ3 i2 * (∑ i1 : Fin 3, γ3 i1 *
        (∑ i0 : Fin 3, γ3 i0 / (φ - (ν3 i3 + ν3 i2 + ν3 i1 + ν3 i0))))) := by
    refine le_trans (J_peel1 hφ) (Finset.sum_le_sum fun i3 _ => mul_le_mul_of_nonneg_left ?_ (γ3_nonneg i3))
    refine le_trans (J_peel2 hφ i3) (Finset.sum_le_sum fun i2 _ => mul_le_mul_of_nonneg_left ?_ (γ3_nonneg i2))
    refine le_trans (J_peel3 hφ i3 i2) (Finset.sum_le_sum fun i1 _ =>
      mul_le_mul_of_nonneg_left (J_peel4 hφ i3 i2 i1) (γ3_nonneg i1))
  rw [J_sum81_eq φ] at hchain
  linarith

private def G_prod (x : R4) : ℝ :=
  H3_herm a0 b0 x.1 * H3_herm a0 b0 x.2.1 * H3_herm a0 b0 x.2.2.1 * H3_herm a0 b0 x.2.2.2

private lemma W_prod_inv4_bound :
    (1 / a0) * ∫ x in D_set, prod_inv4 x ≤ BuchstabArithmetic.Wupper := by
  have hsym := sym4_le_cube prod_inv4_cont
    (fun x ⟨h0, h1, h2, h3⟩ => by
      unfold prod_inv4
      have q0 := lt_of_lt_of_le ha0_pos h0.1; have q1 := lt_of_lt_of_le ha0_pos h1.1
      have q2 := lt_of_lt_of_le ha0_pos h2.1; have q3 := lt_of_lt_of_le ha0_pos h3.1
      positivity)
    (fun x => by simp only [prod_inv4, s01_apply]; ring)
    (fun x => by simp only [prod_inv4, s12_apply]; ring)
    (fun x => by simp only [prod_inv4, s23_apply]; ring)
  have hcH : Continuous (H3_herm a0 b0) := cont_H3_herm a0 b0
  have hG_cont : Continuous G_prod :=
    (((hcH.comp c_x0).mul (hcH.comp c_x1)).mul (hcH.comp c_x2)).mul (hcH.comp c_x3)
  have hmono : ∫ x in B_box, prod_inv4 x ≤ ∫ x in B_box, G_prod x := by
    apply setIntegral_mono_on (prod_inv4_cont.integrableOn_compact isCompact_B)
      (hG_cont.continuousOn.integrableOn_compact isCompact_B) isClosed_B.measurableSet
    intro x ⟨h0, h1, h2, h3⟩
    have i0 := H3_herm_ge_inv ha0_pos h0
    have i1 := H3_herm_ge_inv ha0_pos h1
    have i2 := H3_herm_ge_inv ha0_pos h2
    have i3 := H3_herm_ge_inv ha0_pos h3
    have q0 : 0 ≤ 1 / x.1 := by have := lt_of_lt_of_le ha0_pos h0.1; positivity
    have q1 : 0 ≤ 1 / x.2.1 := by have := lt_of_lt_of_le ha0_pos h1.1; positivity
    have q2 : 0 ≤ 1 / x.2.2.1 := by have := lt_of_lt_of_le ha0_pos h2.1; positivity
    have q3 : 0 ≤ 1 / x.2.2.2 := by have := lt_of_lt_of_le ha0_pos h3.1; positivity
    have m01 : (1 / x.1) * (1 / x.2.1) ≤ H3_herm a0 b0 x.1 * H3_herm a0 b0 x.2.1 :=
      mul_le_mul i0 i1 q1 (le_trans q0 i0)
    have m23 : (1 / x.2.2.1) * (1 / x.2.2.2) ≤ H3_herm a0 b0 x.2.2.1 * H3_herm a0 b0 x.2.2.2 :=
      mul_le_mul i2 i3 q3 (le_trans q2 i2)
    have e_lhs : prod_inv4 x = ((1 / x.1) * (1 / x.2.1)) * ((1 / x.2.2.1) * (1 / x.2.2.2)) := by
      unfold prod_inv4; ring
    have e_rhs : (H3_herm a0 b0 x.1 * H3_herm a0 b0 x.2.1) *
        (H3_herm a0 b0 x.2.2.1 * H3_herm a0 b0 x.2.2.2) = G_prod x := by
      unfold G_prod; ring
    rw [e_lhs, ← e_rhs]
    exact mul_le_mul m01 m23 (mul_nonneg q2 q3) (mul_nonneg (le_trans q0 i0) (le_trans q1 i1))
  have hG_eval : ∫ x in B_box, G_prod x = BuchstabArithmetic.scalarSimpson ^ 4 := by
    rw [setIntegral_B_eq_iter hG_cont.continuousOn]
    have h1 := integral_H3_herm ha0_pos hab0
    have hss : (b0 - a0) / 6 * (1 / a0 + 4 / ((a0 + b0) / 2) + 1 / b0) =
        BuchstabArithmetic.scalarSimpson := rfl
    rw [hss] at h1
    have s3 : ∀ x0 x1 x2 : ℝ, ∫ x3 in a0..b0, G_prod (x0, x1, x2, x3) =
        (H3_herm a0 b0 x0 * H3_herm a0 b0 x1 * H3_herm a0 b0 x2) * BuchstabArithmetic.scalarSimpson := by
      intro x0 x1 x2; dsimp only [G_prod]; rw [intervalIntegral.integral_const_mul, h1]
    simp_rw [s3, intervalIntegral.integral_mul_const]
    have s2 : ∀ x0 x1 : ℝ, ∫ x2 in a0..b0, H3_herm a0 b0 x0 * H3_herm a0 b0 x1 * H3_herm a0 b0 x2 =
        (H3_herm a0 b0 x0 * H3_herm a0 b0 x1) * BuchstabArithmetic.scalarSimpson := by
      intro x0 x1; rw [intervalIntegral.integral_const_mul, h1]
    simp_rw [s2, intervalIntegral.integral_mul_const]
    have s1 : ∀ x0 : ℝ, ∫ x1 in a0..b0, H3_herm a0 b0 x0 * H3_herm a0 b0 x1 =
        H3_herm a0 b0 x0 * BuchstabArithmetic.scalarSimpson := by
      intro x0; rw [intervalIntegral.integral_const_mul, h1]
    simp_rw [s1, intervalIntegral.integral_mul_const, h1]; ring
  rw [hG_eval] at hmono
  have hB : ∫ x in D_set, prod_inv4 x ≤ BuchstabArithmetic.scalarSimpson ^ 4 / 24 := by linarith
  have hmul := mul_le_mul_of_nonneg_left hB (div_nonneg zero_le_one (le_of_lt ha0_pos))
  refine le_trans hmul (le_of_eq ?_)
  unfold BuchstabArithmetic.Wupper a0; ring

