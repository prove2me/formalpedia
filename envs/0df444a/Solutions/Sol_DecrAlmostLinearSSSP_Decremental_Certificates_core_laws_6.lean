open Structured
lemma store_eval (b : Core) (B : ℕ) (K : ℝ) (v : ReturnVertex b) (s : Data) (hB : b.input.n ≤ B)
    (hc : InputCapture.Captured b.input s) (hp : CoreParameters.Values b K s) (h : Loaded b B v s)
    (hy1 : s.realReg 608 = 0) (hy2 : s.realReg 610 = 0) :
    ∃ cost t, Eval storeCode s cost t ∧ cost ≤ 27 ∧ CoreRecord.Initialized b B (.inr v) t ∧
      stored t.machine v.val.val = readout b (initialLabel b v.val) ∧
      t.natMem v.val.val ≤ 1 ∧ (t.natMem v.val.val = 0 → 0 ≤ t.realMem v.val.val) ∧
      t.realReg 612 = capacity b Finset.univ (initialLabel b) (.inr v) ∧
      (∀ j, j ≠ v.val.val → (∀ offset < 5, j ≠ CoreMemory.field b B (.inr v) offset) →
        t.natMem j = s.natMem j ∧ t.realMem j = s.realMem j) := by
  let p := CoreRefresh.result s
  have he := CoreRefresh.eval_code s hc.zeroR
  have hpN (k : ℕ) : p.natReg k = s.natReg k := he.nat_frame (CoreRefresh.nat_frame k)
  have hpR (k : ℕ) (hk : k ≠ 612 ∧ k ≠ 614 ∧ k ≠ 616 ∧ k ≠ 618) : p.realReg k = s.realReg k := he.real_frame (CoreRefresh.real_frame k hk.1 hk.2.1 hk.2.2.1 hk.2.2.2)
  have hload : Loaded b B v p := h.after_capacity b B v s hc.zeroR
  have hpf := h.capacity_value b B v s hp.kappaValue hy1 hy2
  have hps := h.sample_value b B v s hy1 hy2
  let a := CoreRecord.result p
  have ha := CoreRecord.eval_code p
  have haN (k : ℕ) : a.natReg k = p.natReg k := ha.nat_frame (CoreRecord.nat_frame k)
  have haR (k : ℕ) : a.realReg k = p.realReg k := ha.real_frame (CoreRecord.real_frame k)
  let sampleAddress := CoreMemory.field b B (.inr v) 3
  have hsampleAddress : a.natReg 578 = sampleAddress := by
    rw [haN 578,hload.addresses.head]
    unfold sampleAddress CoreMemory.field
    omega
  have hsampleNe : sampleAddress ≠ v.val.val := by
    have hh := CoreMemory.field_above_base b B (.inr v) 3
    have hv := v.val.isLt
    dsimp [sampleAddress]
    omega
  obtain ⟨cr,t,ht,hcr,hto,htsample,htnorm,htpos,htNat,htReal⟩ := CoreReturn.eval_code b a v.val.val sampleAddress (initialLabel b v.val)
    ((haN 626).trans hload.tail) hsampleAddress hsampleNe ((haR 616).trans hps)
    ((haN 56).trans ((hpN 56).trans hc.zeroN))
    ((haR 56).trans ((hpR 56 (by omega)).trans hc.zeroR))
    ((haR 502).trans ((hpR 502 (by omega)).trans hp.Qvalue))
    ((haR 534).trans ((hpR 534 (by omega)).trans hp.infinityThreshold))
    ((haR 518).trans ((hpR 518 (by omega)).trans hp.readoutFactor))
  have hNat (offset : ℕ) : t.natMem (CoreMemory.field b B (.inr v) offset) = a.natMem (CoreMemory.field b B (.inr v) offset) := by
    apply htNat
    have hh := CoreMemory.field_above_base b B (.inr v) offset
    have hv := v.val.isLt
    omega
  have hReal (offset : ℕ) (ho : offset < 5) (h3 : offset ≠ 3) : t.realMem (CoreMemory.field b B (.inr v) offset) = a.realMem (CoreMemory.field b B (.inr v) offset) := by
    apply htReal
    · have hh := CoreMemory.field_above_base b B (.inr v) offset
      have hv := v.val.isLt
      omega
    · intro hh
      have hx := CoreMemory.field_injective b B (.inr v) (.inr v) offset 3 ho (by omega) hh
      exact h3 hx.2
  obtain ⟨h0,h1,h2,h3,h4,hf0,hf1,hf2,hf3,hf4⟩ := CoreRecord.fields _ p hload.addresses ((hpN 56).trans hc.zeroN)
  have hoff (offset : ℕ) := CoreRecord.field_add_offset b B (.inr v) offset
  have htinit : CoreRecord.Initialized b B (.inr v) t := by
    refine ⟨(hNat 0).trans h0,?_,?_,?_,?_,(hReal 0 (by omega) (by omega)).trans (hf0.trans hpf),?_,?_,?_,htsample⟩
    · rw [hNat 1]
      simpa only [hoff 1] using h1
    · rw [hNat 2]
      simpa only [hoff 2,hload.tail,tail] using h2
    · rw [hNat 3]
      simpa only [hoff 3,hload.head,head] using h3
    · rw [hNat 4]
      simpa only [hoff 4,hload.returnFlag,CoreGeometry.returnBit] using h4
    · rw [hReal 1 (by omega) (by omega)]
      simpa only [hoff 1,hload.coefficient] using hf1
    · rw [hReal 2 (by omega) (by omega)]
      simpa only [hoff 2,hload.cost,cost] using hf2
    · rw [hReal 4 (by omega) (by omega)]
      simpa only [hoff 4,hload.initial,tail,head] using hf4
  refine ⟨7+(9+cr),t,Eval.seq he (Eval.seq ha ht),by omega,htinit,hto,htnorm,htpos,?_,?_⟩
  · exact (ht.real_frame (CoreReturn.real_frame 612 (by omega) (by omega))).trans ((haR 612).trans hpf)
  · intro j hj hout
    have hfr := CoreRecord.frame _ p hload.addresses j
      (by simpa only [Nat.mul_zero,Nat.add_zero] using hout 0 (by omega))
      (by have hh := hout 1 (by omega);dsimp only [CoreMemory.field] at hh ⊢;omega)
      (by have hh := hout 2 (by omega);dsimp only [CoreMemory.field] at hh ⊢;omega)
      (by have hh := hout 3 (by omega);dsimp only [CoreMemory.field] at hh ⊢;omega)
      (by have hh := hout 4 (by omega);dsimp only [CoreMemory.field] at hh ⊢;omega)
    have hpm := he.no_memory CoreRefresh.no_memory
    exact ⟨(htNat j hj).trans (hfr.1.trans (congrFun hpm.2 j)),
      (htReal j hj (hout 3 (by omega))).trans (hfr.2.trans (congrFun hpm.1 j))⟩
end DecrAlmostLinearSSSP.Decremental.CoreInitializeReturn
