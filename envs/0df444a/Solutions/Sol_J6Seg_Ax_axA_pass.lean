namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function J6Seg.KR.AK

/-- **The `A` kernel as a row body.** -/
theorem aK_row {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {e pM : Fin Pp}
    {M : MulSpec} (hM : MulOK Isym tbl pM M) (hdom : ∀ x y, M.dom x y) (hE : tbl e = aKprog2 pM)
    {w2 bk win Q pk b φ1 φ2 B BH : ℕ}
    (hΦ1 : ∀ x y : ℤ, zsz x ≤ B → zsz y ≤ B → M.Φ x y ≤ φ1)
    (hΦ2 : ∀ x y : ℤ, zsz x ≤ b * (2 * (w2 + bk)) + 2 → zsz y ≤ b * (2 * (w2 + bk)) + 2 →
      M.Φ x y ≤ φ2)
    (hb : 1 ≤ b) (hn1 : 1 ≤ w2 + bk) (hbig : 2 * (2 * (w2 + bk)) * 2 ^ (2 * pk) < 2 ^ (b - 1))
    (hw2 : w2 ≤ win) (hbk : bk ≤ win)
    {aT rT cT : ℕ → List ℤ} (hal : ∀ q, (aT q).length = w2) (hrl : ∀ q, (rT q).length = w2 + bk)
    (hcl : ∀ q, (cT q).length = bk)
    {Ka Kr Kc X0 : ℤ} (hKa : 0 ≤ Ka) (hKr : 0 ≤ Kr) (hKc : 0 ≤ Kc) (hX0 : 0 ≤ X0)
    (hta : ∀ q, KR.TB (2 ^ Q * Ka) (aT q)) (htr : ∀ q, KR.TB (2 ^ Q * Kr) (rT q))
    (htc : ∀ q, KR.TB (2 ^ Q * Kc) (cT q))
    (hea : 2 ^ Q * Ka ≤ 2 ^ pk) (her : 2 ^ Q * Kr ≤ 2 ^ pk) (hec : 2 ^ Q * Kc ≤ 2 ^ pk)
    (he0 : X0 ≤ 2 ^ pk) (he1 : Ka * X0 + 1 ≤ 2 ^ pk)
    (he2 : ((w2 + bk : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1 ≤ 2 ^ pk)
    (he3 : Kc * (((w2 + bk : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1) + 1 ≤ 2 ^ pk)
    (hBz : 2 * (pk + 1) + 2 ≤ B) (hBb : b + 4 ≤ B) (hPB : Q + 3 ≤ B)
    (hBc : zsz ((2 * win + 2 * (w2 + bk) : ℕ) : ℤ) ≤ B)
    (hBH : ∀ v ∈ aHdr2 w2 bk win Q pk b, zsz v ≤ BH) :
    RowBody6 Isym tbl e KR.dT (fun q => aKTab2 w2 bk win Q pk b (aT q) (rT q) (cT q))
      (fun x => x.length = win ∧ KR.AB X0 x) (fun q => J6A.aKerL w2 bk win Q (aT q) (rT q) (cT q))
      ((cAK2 w2 bk win pk b φ1 φ2 B BH : ℕ) + 2) := by
  intro q s F x l hF hd h0 ⟨hxl, hx⟩
  have r := aK2_runs (I := Isym) (iprog := tbl) hM hdom hΦ1 hΦ2 hb hn1 hbig hw2 hbk (hal q)
    (hrl q) (hcl q) hKa hKr hKc hX0 (hta q) (htr q) (htc q) hea her hec he0 he1 he2 he3 hBz hBb
    hPB hBc hBH s F x l hF hd h0 hxl hx
  exact ⟨_, IRuns.call (by rw [hE]; exact r), by push_cast; linarith⟩

end J6Seg.Ax

