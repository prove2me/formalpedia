      have hm_lt : m < 128 := (Nat.floor_lt (by linarith)).mpr (by push_cast; linarith)
      have hfl1 : (m : ℝ) ≤ s * 120 - 206 := Nat.floor_le (by linarith)
      have hfl2 : s * 120 - 206 < (m : ℝ) + 1 := Nat.lt_floor_add_one _
      have h1 := F_fn_le_getF hω hz hm_lt (s := s)
        (by rw [div_le_iff₀ hDpos, hD1656]; push_cast; linarith)
        (by rw [le_div_iff₀ hDpos, hD1656]; push_cast; linarith)
      have h2 : getF m ≤ F_tree.rangeMax 7 m0 127 :=
        SegTree.get_le_rangeMax validF_tree hm0_le (by omega) (by simpa using hm_lt)
      have h3 : getF m ≤ max (F_tree.rangeMax 7 m0 127) F_tail_val := le_trans h2 (le_max_left _ _)
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h3) (le_of_lt hSpos))

