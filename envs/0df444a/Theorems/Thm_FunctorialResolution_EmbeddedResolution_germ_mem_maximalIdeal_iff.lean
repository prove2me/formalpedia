theorem FunctorialResolution.EmbeddedResolution.germ_mem_maximalIdeal_iff {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U)
    (x : X) (hx : x ∈ U) (s : Γ(X, U)) :
    X.presheaf.germ U x hx s ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ↔
      s ∈ (hU.primeIdealOf ⟨x, hx⟩).asIdeal := by sorry
