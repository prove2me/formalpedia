  obtain ⟨i, h, hh, rfl⟩ := (hA.mem_iff s).1 hs
  have e : addrS D B (coordS D a B v) = v := (slotLayout hB).addr_coord v hv
  have e2 := getD_addrS (D := D) (arr := B) (coordS D a B v) (hB.spos_lt hh)
  rw [e, hB.getD_spos hh, nm_div, axOf_nm] at e2
