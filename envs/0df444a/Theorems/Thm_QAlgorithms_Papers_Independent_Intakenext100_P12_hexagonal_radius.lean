-- title:
--   §VI (68)–(69): hexagonal correction radius
-- statement:
--   Let $n\ge1$. In the source's phase-label units let $L$ be generated by
--
--   $$M=\sqrt{\frac{2n}{\sqrt3}}\begin{pmatrix}1&0\\1/2&\sqrt3/2\end{pmatrix}.$$
--
--   Its symplectic dual is generated by $M/n$, and its shortest nonzero vector has length $\sqrt{2/(n\sqrt3)}$. The equal-area square dual has shortest length $1/\sqrt n$. In physical displacement units multiply by $\sqrt{2\pi}$; the sharp disjoint-open-ball correction radius of the hexagonal code is $\sqrt{\pi/(n\sqrt3)}$. Relative to the square radius $\sqrt{\pi/(2n)}$, the gain is $\sqrt{2/\sqrt3}$.
--
--   The chosen dual basis need not pair as the identity with this particular displayed hexagonal basis.
-- source:
--   Encoding a qubit in an oscillator, arXiv:quant-ph/0008040v3, PDF p. 9, §VI (68)–(69): hexagonal correction radius

import Definitions.Def_QAlgorithms_Papers_Independent_Intakenext100_P12

noncomputable section

open scoped BigOperators

open MeasureTheory Matrix ComplexConjugate

open QAlgorithms.Papers.Independent.Dependency50.P10 (Phase sigma)

namespace QAlgorithms.Papers.Independent.Intakenext100.P12

/-- Section VI (68)–(69), PDF p.9: the exact dual lattice and sharp correction-radius gain.
Physical radii include sqrt(2*pi); strict inequalities give unambiguous decoding. -/
theorem hexagonal_radius (n : ℕ) (hn : 0 < n) :
    ({u : ℝ × ℝ | ∀ z : ℤ × ℤ, ∃ k : ℤ,
      u.1 * (hexVector n z).2 - u.2 * (hexVector n z).1 = k} =
      Set.range (hexDualVector n)) ∧
    (∀ z : ℤ × ℤ, z ≠ (0, 0) →
      Real.sqrt (2 / (n * Real.sqrt 3)) ≤ planeNorm (hexDualVector n z)) ∧
    planeNorm (hexDualVector n (1, 0)) = Real.sqrt (2 / (n * Real.sqrt 3)) ∧
    (∀ z : ℤ × ℤ, z ≠ (0, 0) → (Real.sqrt n)⁻¹ ≤ planeNorm (squareDualVector n z)) ∧
    planeNorm (squareDualVector n (1, 0)) = (Real.sqrt n)⁻¹ ∧
    IsSharpRadius (Set.range (fun z =>
      (Real.sqrt (2 * Real.pi) * (hexDualVector n z).1,
       Real.sqrt (2 * Real.pi) * (hexDualVector n z).2)))
      (Real.sqrt (Real.pi / (n * Real.sqrt 3))) ∧
    Real.sqrt (2 * Real.pi) / 2 * Real.sqrt (2 / (n * Real.sqrt 3)) =
      Real.sqrt (Real.pi / (n * Real.sqrt 3)) ∧
    Real.sqrt (Real.pi / (n * Real.sqrt 3)) =
      Real.sqrt (2 / Real.sqrt 3) * Real.sqrt (Real.pi / (2 * n)) := by sorry

end QAlgorithms.Papers.Independent.Intakenext100.P12

