theorem isPullback_fst_of_isPullback {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (u : FakeEllipticCurve.WithFullLevel Λ N m S) (u' : FakeEllipticCurve.WithFullLevel Λ N m S')
    (h : FakeEllipticCurve.WithFullLevel.IsPullback φ u u') :
    FakeEllipticCurve.IsPullback φ u.1 u'.1 := by
  obtain ⟨g, hg, hmul, hact, hlev, -⟩ := h
  exact ⟨g, hg, hmul, hact, hlev⟩

theorem exists_ptF_eq_and_isFormalModuleOf
    {B₀ : Type} [CommRing B₀] {M : Scheme.{0}} {πM : M ⟶ Spec (CommRingCat.of B₀)}
    {ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B₀)),
      FakeEllipticCurve.WithFullLevel Λ N m S → SchemeHomOver s πM}
    (hM : IsFineModuli Λ N m M πM ptF)
    (coord : ↥Λ → Zp2 q × Zp2 q)
    (k : Type) [Field k] (s : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of B₀))
    (u : FakeEllipticCurve.WithFullLevel Λ N m k)
    (hcov : ∃ t : Finset k, Ideal.span (t : Set k) = ⊤ ∧
      ∀ c ∈ t, ∀ E' : FakeEllipticCurve Λ N (Localization.Away c),
        FakeEllipticCurve.IsPullback (algebraMap k (Localization.Away c)) u.1 E' →
        ∃ X : FormalODModule q (Localization.Away c), E'.IsFormalModuleOf coord X) :
    ∃ (u'' : FakeEllipticCurve.WithFullLevel Λ N m k) (X : FormalODModule q k),
      (ptF k s u'').1 = (ptF k s u).1 ∧ u''.1.IsFormalModuleOf coord X := by
  classical
  obtain ⟨t, ht, hcov⟩ := hcov
  have hc : ∃ c ∈ t, c ≠ 0 := by
    by_contra h
    have h' : ∀ c ∈ t, c = 0 := fun c hc => by
      by_contra h0
      exact h ⟨c, hc, h0⟩
    have : Ideal.span (t : Set k) = ⊥ := Ideal.span_eq_bot.mpr fun x hx => h' x hx
    exact top_ne_bot (ht.symm.trans this)
  obtain ⟨c, hct, hc0⟩ := hc
  set L : Type := Localization.Away c with hL
  obtain ⟨u', hu'⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_isPullback (algebraMap k L) u
  obtain ⟨X', hX'⟩ := hcov c hct u'.1 (isPullback_fst_of_isPullback _ u u' hu')
  have hunits : Submonoid.powers c ≤ IsUnit.submonoid k := by
    rintro y ⟨n, rfl⟩
    exact (isUnit_iff_ne_zero.mpr hc0).pow n
  let e : k ≃ₐ[k] L := IsLocalization.atUnits k (Submonoid.powers c) (S := L) hunits
  let ψ : L →+* k := (e.symm : L ≃ₐ[k] k).toRingEquiv.toRingHom
  have hψ : ψ.comp (algebraMap k L) = RingHom.id k := by
    ext y
    change e.symm (algebraMap k L y) = y
    rw [← e.commutes y]
    exact e.symm_apply_apply y
  obtain ⟨u'', hu''⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_isPullback ψ u'
  refine ⟨u'', X'.map ψ, ?_, CerednikDrinfeld.QM.FakeEllipticCurve.IsFormalModuleOf.map_of_isPullback coord ψ
    u'.1 u''.1 (isPullback_fst_of_isPullback _ u' u'' hu'') X' hX'⟩
  set sL : Spec (CommRingCat.of L) ⟶ Spec (CommRingCat.of B₀) :=
    Spec.map (CommRingCat.ofHom (algebraMap k L)) ≫ s with hsL
  have hs2 : Spec.map (CommRingCat.ofHom ψ) ≫ sL = s := by
    rw [hsL, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hψ, CommRingCat.ofHom_id,
      Spec.map_id, Category.id_comp]
  have h1 := hM.ptF_pullback k L (algebraMap k L) s sL rfl u u' hu'
  have h2 := hM.ptF_pullback L k ψ sL s hs2 u' u'' hu''
  rw [h2, h1, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hψ, CommRingCat.ofHom_id,
    Spec.map_id, Category.id_comp]

theorem exists_basePoint_isFormalModuleOf
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N₀ n : ℕ)
    {M₁ : Scheme.{0}} {π₁ : M₁ ⟶ Spec (CommRingCat.of ℤ_[q])}
    {ptF₁ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of ℤ_[q])),
      FakeEllipticCurve.WithFullLevel Λ N₀ n S → SchemeHomOver s π₁}
    (hM₁ : IsFineModuli Λ N₀ n M₁ π₁ ptF₁)
    (coord : ↥Λ → Zp2 q × Zp2 q) (hcoord : IsOrderCoord Λ q coord)
    (k : Type) [Field k] [CharP k q] (s₀ : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of ℤ_[q]))
    (xpt : SchemeHomOver s₀ π₁) :
    ∃ (u₀ : FakeEllipticCurve.WithFullLevel Λ N₀ n k) (_ : (ptF₁ k s₀ u₀).1 = xpt.1)
      (X₀ : FormalODModule q k),
      u₀.1.IsFormalModuleOf coord X₀ ∧ (∀ j : Zp2 q →+* k, X₀.IsSpecial j) ∧ X₀.HasHeight 4 := by
  classical
  obtain ⟨u, hu⟩ := hM₁.ptF_surjective k s₀ xpt
  have hq0 : ((q : ℕ) : k) = 0 := CharP.cast_eq_zero k q
  have hnil : IsNilpotent ((q : ℕ) : k) := by rw [hq0]; exact IsNilpotent.zero
  obtain ⟨u₀, X₀, hpt, hX₀⟩ := exists_ptF_eq_and_isFormalModuleOf hM₁ coord k s₀ u
    (CerednikDrinfeld.QM.FakeEllipticCurve.exists_cover_isFormalModuleOf coord hcoord k hnil u.1)
  refine ⟨u₀, ?_, X₀, hX₀, fun j => ?_, ?_⟩
  · rw [hpt, hu]
  · exact CerednikDrinfeld.QM.FakeEllipticCurve.IsFormalModuleOf.isSpecial coord hcoord k hnil j u₀.1 X₀ hX₀
  · obtain ⟨θ, hθ⟩ := hX₀
    exact CerednikDrinfeld.QM.FakeEllipticCurve.hasHeight_four_of_isFormalModuleVia_of_one_mem coord hcoord
      hΛ.isOrder.one_mem k hnil u₀.1 X₀ θ hθ

