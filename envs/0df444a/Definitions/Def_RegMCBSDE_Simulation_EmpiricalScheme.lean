-- url     : https://prove2.me/theorems/acb709dd-e456-49d6-8dcc-6e3c677c1db0
-- title:
--   §2.2–2.3, (4), (27), pp. 6–7, 16, 18 — simulations, the empirical regression scheme, V^M, P^M and the event A^M_k
-- statement:
--   This file fixes the simulation-based scheme of Gobet, Lemor and Warin (§2.3) and the objects of Section 5.
--
--   **Simulations** (p. 6). $M\ge1$ paths $((P^{N,m}_{t_k})_{k\le N},(\Delta W^m_k)_{k<N})$, $m=1,\dots,M$, on the same probability space, each with the law of the reference path $((P^N_{t_k})_k,(\Delta W_k)_k)$, the $M+1$ paths (reference and simulations) being mutually independent. $S^{N,m}$ is the Euler scheme driven by $\Delta W^m$, $p^m_{l,k}=p_{l,k}(P^{N,m}_{t_k})$ and $f^m_k(\alpha)=f(t_k,S^{N,m}_{t_k},\alpha_0\cdot p^m_{0,k},\dots,\alpha_q\cdot p^m_{q,k})$.
--
--   **Truncations** (p. 7). $\hat\rho^N_{l,k}(x)=\rho^N_{l,k}(P^N_{t_k})\,\xi(x/\rho^N_{l,k}(P^N_{t_k}))$ and $\hat\rho^{N,m}_{l,k}(x)=\rho^N_{l,k}(P^{N,m}_{t_k})\,\xi(x/\rho^N_{l,k}(P^{N,m}_{t_k}))$.
--
--   **The empirical scheme (4).** The coefficients $\alpha^{i,I,M}_k$ are measurable functions of the simulations, $\alpha^{0,I,M}_k=0$, and for every $i\ge1$ and every outcome, $\alpha^{i,I,M}_k$ is a minimizer of
--   $$\frac1M\sum_{m=1}^M\Big(Y^{N,I,I,M,m}_{t_{k+1}}-\alpha_0\cdot p^m_{0,k}+hf^m_k(\alpha^{i-1,I,M}_k)-\sum_{l=1}^q\alpha_l\cdot p^m_{l,k}\Delta W^m_{l,k}\Big)^2,$$
--   where $Y^{N,I,I,M,m}_{t_{k+1}}=\hat\rho^{N,m}_{0,k+1}(\alpha^{I,I,M}_{0,k+1}\cdot p^m_{0,k+1})$ for $k+1<N$ and $Y^{N,I,I,M,m}_{t_N}=\Phi^N(P^{N,m}_{t_N})$. On the reference path,
--   $$Y^{N,i,I,M}_{t_k}=\hat\rho^N_{0,k}(\alpha^{i,I,M}_{0,k}\cdot p_{0,k}),\qquad \sqrt hZ^{N,i,I,M}_{l,t_k}=\hat\rho^N_{l,k}(\sqrt h\alpha^{i,I,M}_{l,k}\cdot p_{l,k}).$$
--
--   **Regression matrices and the good event.** $[v_k]^*=(p^*_{0,k},p^*_{1,k}\Delta W_{1,k}/\sqrt h,\dots,p^*_{q,k}\Delta W_{q,k}/\sqrt h)$, $V^M_k=\frac1M\sum_m v^m_k[v^m_k]^*$, $P^M_{l,k}=\frac1M\sum_m p^m_{l,k}[p^m_{l,k}]^*$, and (27)
--   $$\mathbf A^M_k=\{\forall j\in\{k,\dots,N-1\}:\ \|V^M_j-\mathrm{Id}\|\le h,\ \|P^M_{0,j}-\mathrm{Id}\|\le h,\ \|P^M_{l,j}-\mathrm{Id}\|\le1\ (1\le l\le q)\}.$$
--   The rescaled coefficients (p. 18) are $\theta^*=(\alpha_0^*,\sqrt h\alpha_1^*,\dots,\sqrt h\alpha_q^*)$, so that $\theta\cdot v_k=\alpha_0\cdot p_{0,k}+\sum_{l\ge1}\alpha_l\cdot p_{l,k}\Delta W_{l,k}$.
--
--   **Formalization Note** The paper takes "$M$ independent simulations" without stating their relation to the reference path at which the fitted coefficients are evaluated; independence of the reference path from the simulations is made explicit. The paper's choice among multiple least-squares solutions is "arbitrary", so any measurable minimizer is allowed (no inverse formula is used). $\|A\|$ is the largest absolute eigenvalue of a symmetric matrix; $\|A\|\le c$ is written as the equivalent bound $|x^*Ax|\le c|x|^2$ for all $x$.
-- source:
--   Gobet, Lemor and Warin, A regression-based Monte Carlo method to solve backward stochastic differential equations, arXiv:math/0508491v1, pp. 6–7, §2.2 (simulations, v_k^m, V_k^M, P_{l,k}^M, truncations) and §2.3 Eq. (4); p. 16, Eq. (27); p. 18 (θ)

import Mathlib
import Definitions.Def_RegMCBSDE_Simulation_Setting
import Definitions.Def_RegMCBSDE_Simulation_ProjectionScheme

namespace RegMCBSDE.Simulation

open MeasureTheory ProbabilityTheory

section

variable {d q d' : ℕ} {Ω : Type*} [MeasurableSpace Ω]

/-- The whole path `((P_{t_k})_{0 ≤ k ≤ N}, (ΔW_k)_{0 ≤ k ≤ N-1})` of a run, as one random
variable. -/
def pathOf (N : ℕ) (ΔW : ℕ → Ω → E q) (PN : ℕ → Ω → E d') (ω : Ω) :
    (Fin (N + 1) → E d') × (Fin N → E q) :=
  (fun k => PN k ω, fun k => ΔW k ω)

/-- `M` independent simulations (p. 6): the paths `(ΔWs m, PNs m)`, `m = 1, …, M` (indexed by
`Fin M`), each have the law of the reference path `(ΔW, P^N)` of `D`, and the `M + 1` paths
(reference copy first, then the `M` simulations) are mutually independent. -/
def IsSimulation (D : RefData d q d' Ω) (P : Measure Ω) (M : ℕ) (ΔWs : Fin M → ℕ → Ω → E q)
    (PNs : Fin M → ℕ → Ω → E d') : Prop :=
  (∀ s, IdentDistrib (pathOf D.N (ΔWs s) (PNs s)) (pathOf D.N D.ΔW D.PN) P P) ∧
  iIndepFun (β := fun _ : Fin (M + 1) => (Fin (D.N + 1) → E d') × (Fin D.N → E q))
    (Fin.cases (pathOf D.N D.ΔW D.PN) (fun s : Fin M => pathOf D.N (ΔWs s) (PNs s))) P

/-- The σ-algebra generated by the `M` simulated paths. -/
abbrev simSigma (D : RefData d q d' Ω) {M : ℕ} (ΔWs : Fin M → ℕ → Ω → E q)
    (PNs : Fin M → ℕ → Ω → E d') : MeasurableSpace Ω :=
  ⨆ s : Fin M, MeasurableSpace.comap (pathOf D.N (ΔWs s) (PNs s)) inferInstance

/-- The truncation function of p. 7 at the point `y ∈ ℝ^{d'}` of the chain:
`ρ̂_{l,k}(x) = ρ^N_{l,k}(y) ξ(x / ρ^N_{l,k}(y))`. With `y = P^N_{t_k}` it is `ρ̂^N_{l,k}`, with
`y = P^{N,m}_{t_k}` it is `ρ̂^{N,m}_{l,k}`. -/
noncomputable def rhoHat (B : Basis q d') (C0 : ℝ) (ξ : ℝ → ℝ) (l : Fin (q + 1)) (k : ℕ) (y : E d')
    (x : ℝ) : ℝ :=
  rho B C0 l k y * ξ (x / rho B C0 l k y)

/-- The response of the empirical scheme along the `m`-th simulation at time `t_{k+1}`:
`Y^{N,I,I,M,m}_{t_{k+1}} = ρ̂^{N,m}_{0,k+1}(α^{I,I,M}_{0,k+1} · p^m_{0,k+1})` if `k+1 < N`, and the
(untruncated) terminal value `Φ^N(P^{N,m}_{t_N})` if `k+1 = N`. Here `αMI k ω` stands for
`α^{I,I,M}_k(ω)`. -/
noncomputable def empResp (D : RefData d q d' Ω) (B : Basis q d') (C0 : ℝ) (ξ : ℝ → ℝ) {M : ℕ}
    (PNs : Fin M → ℕ → Ω → E d') (αMI : (k : ℕ) → Ω → Coeff B k) (m : Fin M) (k : ℕ) (ω : Ω) : ℝ :=
  if k + 1 < D.N then
    rhoHat B C0 ξ 0 (k + 1) (PNs m (k + 1) ω) (αMI (k + 1) ω 0 ⬝ᵥ B.p 0 (k + 1) (PNs m (k + 1) ω))
  else D.ΦN (PNs m D.N ω)

/-- The empirical regression scheme (4) of §2.3 (p. 7), with `I` Picard iterations; `αM i k ω`
stands for `α^{i,I,M}_k(ω)`:
* every `α^{i,I,M}_k` is a measurable function of the `M` simulations;
* for `k ≤ N-1`: `α^{0,I,M}_k = 0`, and for every `i ≥ 1` and every outcome `ω`,
  `α^{i,I,M}_k(ω)` is *a* minimizer (any choice) over `(α_0, …, α_q)` of
  `(1/M) ∑_m (Y^{N,I,I,M,m}_{t_{k+1}} - α_0·p^m_{0,k} + h f^m_k(α^{i-1,I,M}_k) - ∑_{l≥1} α_l·p^m_{l,k} ΔW^m_{l,k})²`. -/
def IsEmpiricalScheme (m : Model d q) (D : RefData d q d' Ω) (B : Basis q d') (C0 : ℝ) (ξ : ℝ → ℝ)
    {M : ℕ} (ΔWs : Fin M → ℕ → Ω → E q) (PNs : Fin M → ℕ → Ω → E d') (I : ℕ)
    (αM : ℕ → (k : ℕ) → Ω → Coeff B k) : Prop :=
  (∀ i k, Measurable[simSigma D ΔWs PNs] (αM i k)) ∧
  ∀ k < D.N, (∀ ω, αM 0 k ω = 0) ∧ ∀ i, 1 ≤ i → ∀ ω,
    IsMinOn (fun a : Coeff B k => (1 / (M : ℝ)) * ∑ s : Fin M,
        (empResp D B C0 ξ PNs (αM I) s k ω
          + m.h D.N * drv m (D.withPath (ΔWs s) (PNs s)) B k (αM (i - 1) k ω) ω
          - regr (D.withPath (ΔWs s) (PNs s)) B k a ω) ^ 2)
      Set.univ (αM i k ω)

/-- `Y^{N,i,I,M}_{t_k} = ρ̂^N_{0,k}(α^{i,I,M}_{0,k} · p_{0,k})` on the reference path (p. 7);
`a` stands for `α^{i,I,M}_k`. -/
noncomputable def empY (D : RefData d q d' Ω) (B : Basis q d') (C0 : ℝ) (ξ : ℝ → ℝ) (k : ℕ)
    (a : Ω → Coeff B k) (ω : Ω) : ℝ :=
  rhoHat B C0 ξ 0 k (D.PN k ω) (a ω 0 ⬝ᵥ B.p 0 k (D.PN k ω))

/-- `Z^{N,i,I,M}_{l,t_k} = ρ̂^N_{l,k}(√h α^{i,I,M}_{l,k} · p_{l,k}) / √h` on the reference path
(p. 7), for the component `j` of `Z` (basis index `l = j+1`). -/
noncomputable def empZ (m : Model d q) (D : RefData d q d' Ω) (B : Basis q d') (C0 : ℝ) (ξ : ℝ → ℝ)
    (k : ℕ) (a : Ω → Coeff B k) (j : Fin q) (ω : Ω) : ℝ :=
  rhoHat B C0 ξ j.succ k (D.PN k ω)
      (Real.sqrt (m.h D.N) * (a ω j.succ ⬝ᵥ B.p j.succ k (D.PN k ω))) / Real.sqrt (m.h D.N)

/-- Index set of the stacked regression vector `v_k`: pairs `(l, j)` with `j < n_{l,k}`. -/
abbrev Idx {q d' : ℕ} (B : Basis q d') (k : ℕ) := Σ l : Fin (q + 1), Fin (B.n l k)

/-- The regression vector `v_k` of p. 6 on the path of `D`:
`[v_k]^* = (p_{0,k}^*, p_{1,k}^* ΔW_{1,k}/√h, …, p_{q,k}^* ΔW_{q,k}/√h)`. -/
noncomputable def vvec (m : Model d q) (D : RefData d q d' Ω) (B : Basis q d') (k : ℕ) (ω : Ω) :
    Idx B k → ℝ :=
  fun x => B.p x.1 k (D.PN k ω) x.2 *
    Fin.cases 1 (fun j : Fin q => D.ΔW k ω j / Real.sqrt (m.h D.N)) x.1

/-- The empirical regression matrix `V^M_k = (1/M) ∑_m v^m_k [v^m_k]^*` (p. 6). -/
noncomputable def VM (m : Model d q) (D : RefData d q d' Ω) (B : Basis q d') {M : ℕ}
    (ΔWs : Fin M → ℕ → Ω → E q) (PNs : Fin M → ℕ → Ω → E d') (k : ℕ) (ω : Ω) :
    Matrix (Idx B k) (Idx B k) ℝ :=
  (1 / (M : ℝ)) • ∑ s : Fin M,
    Matrix.vecMulVec (vvec m (D.withPath (ΔWs s) (PNs s)) B k ω) (vvec m (D.withPath (ΔWs s) (PNs s)) B k ω)

/-- The empirical Gram matrix `P^M_{l,k} = (1/M) ∑_m p^m_{l,k} [p^m_{l,k}]^*` (p. 6). -/
noncomputable def PM (B : Basis q d') {M : ℕ} (PNs : Fin M → ℕ → Ω → E d') (l : Fin (q + 1)) (k : ℕ)
    (ω : Ω) : Matrix (Fin (B.n l k)) (Fin (B.n l k)) ℝ :=
  (1 / (M : ℝ)) • ∑ s : Fin M, Matrix.vecMulVec (B.p l k (PNs s k ω)) (B.p l k (PNs s k ω))

/-- `‖A‖ ≤ c` for the spectral norm (maximum absolute eigenvalue) of a real symmetric matrix `A`,
written as the equivalent quadratic-form bound `|x^* A x| ≤ c |x|²` for all `x`. -/
def SpecNormLe {ι : Type*} [Fintype ι] (A : Matrix ι ι ℝ) (c : ℝ) : Prop :=
  ∀ x : ι → ℝ, |x ⬝ᵥ A.mulVec x| ≤ c * sqn x

/-- The event `𝐀^M_k` of (27), p. 16: for all `j ∈ {k, …, N-1}`, `‖V^M_j - Id‖ ≤ h`,
`‖P^M_{0,j} - Id‖ ≤ h` and `‖P^M_{l,j} - Id‖ ≤ 1` for `1 ≤ l ≤ q`. -/
def goodEvent (m : Model d q) (D : RefData d q d' Ω) (B : Basis q d') {M : ℕ}
    (ΔWs : Fin M → ℕ → Ω → E q) (PNs : Fin M → ℕ → Ω → E d') (k : ℕ) : Set Ω :=
  {ω | ∀ j, k ≤ j → j < D.N →
    SpecNormLe (VM m D B ΔWs PNs j ω - 1) (m.h D.N) ∧
    SpecNormLe (PM B PNs 0 j ω - 1) (m.h D.N) ∧
    ∀ l : Fin q, SpecNormLe (PM B PNs l.succ j ω - 1) 1}

/-- The rescaled coefficients of p. 18:
`θ^* = (α_0^*, √h α_1^*, …, √h α_q^*)`, so that `θ · v_k = α_0·p_{0,k} + ∑_{l≥1} α_l·p_{l,k} ΔW_{l,k}`. -/
noncomputable def theta (m : Model d q) (D : RefData d q d' Ω) (B : Basis q d') {k : ℕ} (a : Coeff B k) :
    Idx B k → ℝ :=
  fun x => Fin.cases 1 (fun _ : Fin q => Real.sqrt (m.h D.N)) x.1 * a x.1 x.2

/-- The inverse of `theta`: `α_0 = θ_0`, `α_l = θ_l / √h` for `l ≥ 1`. -/
noncomputable def unTheta (m : Model d q) (D : RefData d q d' Ω) (B : Basis q d') {k : ℕ}
    (θ : Idx B k → ℝ) : Coeff B k :=
  fun l j => θ ⟨l, j⟩ / Fin.cases 1 (fun _ : Fin q => Real.sqrt (m.h D.N)) l

end

end RegMCBSDE.Simulation


