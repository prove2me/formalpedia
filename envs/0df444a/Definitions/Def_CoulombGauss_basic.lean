-- title:
--   Coulomb field of a charge density, divergence, and flux through a sphere in $\mathbb R^3$
-- statement:
--   This file fixes the objects used in the derivation of Gauss's law from Coulomb's law.
--
--   1. **Space.** $\mathbb R^3$ is the Euclidean space of triples with the usual inner product $\langle\cdot,\cdot\rangle$ and norm $|\cdot|$.
--   2. **Coulomb kernel.** For $r, r' \in \mathbb R^3$,
--   $$
--   e(r,r') \;=\; \frac{r-r'}{|r-r'|^{3}},
--   $$
--   the field (up to the factor $1/(4\pi\varepsilon_0)$) of a unit point charge at $r'$, evaluated at $r$.
--   3. **Electric field of a charge distribution.** For a constant $\varepsilon_0$, a charge density $\rho:\mathbb R^3\to\mathbb R$ and a region $\Omega\subseteq\mathbb R^3$,
--   $$
--   \mathbf E(r) \;=\; \frac{1}{4\pi\varepsilon_0}\int_{\Omega}\rho(r')\,\frac{r-r'}{|r-r'|^{3}}\,d^3r' ,
--   $$
--   the integral being the Lebesgue integral over $\Omega$.
--   4. **Divergence.** For a vector field $F:\mathbb R^3\to\mathbb R^3$, $\nabla\cdot F(r)=\sum_{i=1}^{3}\partial_i F_i(r)$, computed from the (Fréchet) derivative of each coordinate function at $r$.
--   5. **Flux through a sphere.** For a centre $c$ and radius $R$, the outward flux of $F$ through the sphere $\partial B_R(c)$ is
--   $$
--   \Phi_F(c,R) \;=\; \oint_{\partial B_R(c)} F\cdot dS \;=\; R^{2}\int_{S^{2}} \langle F(c+Ru),\,u\rangle\,d\sigma(u),
--   $$
--   where $\sigma$ is the standard surface-area measure on the unit sphere $S^2$ (total mass $4\pi$).
--
--   These definitions are shared by the goal theorem and all milestones of the mission.
--
--   **Formalization Note** Lean's total-function conventions apply: the kernel takes the value $0$ at $r=r'$ (where $|r-r'|^{-3}$ is read as $0$), a non-integrable integrand integrates to $0$, and the derivative of a function that is not differentiable at a point is taken to be $0$. The surface measure is Mathlib's `Measure.toSphere` of Lebesgue measure, which assigns $S^2$ the mass $3\cdot|B_1(0)| = 4\pi$.
-- source:
--   Wikipedia, "Coulomb's law", https://en.wikipedia.org/wiki/Coulomb%27s_law (snapshot supplied as PDF, 30 Sep 2026), section "Relation to Gauss's law" -> "Deriving Gauss's law from Coulomb's law", box "Proof (without Dirac Delta)" (PDF pp. 8-9).

import Mathlib

namespace CoulombGauss

open MeasureTheory

/-- Physical three-dimensional Euclidean space `ℝ³`. -/
abbrev Vec3 : Type := EuclideanSpace ℝ (Fin 3)

/-- The Coulomb kernel `(r - r') / |r - r'|³`: the field direction-and-falloff of a unit point
charge located at `r'`, evaluated at `r` (without the factor `1 / (4π ε₀)`). At `r = r'` Lean's
conventions give the value `0`. -/
noncomputable def coulombKernel (r r' : Vec3) : Vec3 :=
  (‖r - r'‖ ^ 3)⁻¹ • (r - r')

/-- The electrostatic field generated by a charge density `ρ` occupying the region `Ω`:
`E(r) = 1/(4π ε₀) ∫_Ω ρ(r') (r - r') / |r - r'|³ d³r'`. -/
noncomputable def electricField (ε₀ : ℝ) (ρ : Vec3 → ℝ) (Ω : Set Vec3) (r : Vec3) : Vec3 :=
  (1 / (4 * Real.pi * ε₀)) • ∫ r' in Ω, ρ r' • coulombKernel r r'

/-- The divergence `∇ · F (r) = ∑ᵢ ∂ Fᵢ / ∂ xᵢ (r)` of a vector field on `ℝ³`, computed from the
Fréchet derivatives of the coordinate functions. -/
noncomputable def divergence (F : Vec3 → Vec3) (r : Vec3) : ℝ :=
  ∑ i : Fin 3, fderiv ℝ (fun x => F x i) r (EuclideanSpace.single i 1)

/-- The outward flux `∮_{∂B_R(c)} F · dS` of a vector field `F` through the sphere of radius `R`
centred at `c`, written via the standard surface measure `σ` on the unit sphere `S²`
(total mass `4π`): `R² ∫_{S²} F(c + R u) · u dσ(u)`. -/
noncomputable def sphereFlux (F : Vec3 → Vec3) (c : Vec3) (R : ℝ) : ℝ :=
  R ^ 2 * ∫ u : Metric.sphere (0 : Vec3) 1,
    inner ℝ (F (c + R • (u : Vec3))) (u : Vec3) ∂(volume.toSphere)

end CoulombGauss


