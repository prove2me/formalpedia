-- title:
--   Omniprediction error (Definition 2.1), Decision and Hypothesis OI, proper calibration (Definition 2.4), $\mathrm{ECE}_1$ and $\Delta\mathcal L\circ\mathcal H$
-- statement:
--   Let $\mathcal X$ be a measurable context space, $\mathcal D$ a distribution on $\mathcal X\times\mathcal Y$, and $p$ a **randomized predictor**: a Markov kernel assigning to each context $x$ a distribution on $\Delta_K$, whose draw $p(x)$ is the reported vector (footnote 3, p. 19). All expectations below are over $(x,y)\sim\mathcal D$ and the reported vector $p(x)$, drawn independently of $y$ given $x$; the modeled label $\tilde y\sim p(x)$ enters through its exact expectation $\mathbb E_{\tilde y\sim p(x)}\ell(a,\tilde y)=\langle p(x),\ell(a,\cdot)\rangle$.
--
--   For a class $\mathcal L$ of losses on an action space $\mathcal A$ (each with its fixed best response) and a class $\mathcal H$ of benchmark rules $h:\mathcal X\to\mathcal A$:
--
--   1. **Omniprediction error** (Definition 2.1, no absolute value):
--   $$\mathrm{OmniReg}_{\mathcal L,\mathcal H;\mathcal D}(p)=\sup_{\ell\in\mathcal L,\,h\in\mathcal H}\mathbb E\big[\ell(\mathrm{BR}_\ell(p(x)),y)-\ell(h(x),y)\big].$$
--   2. **Decision OI**: $\mathrm{DecOI}_{\mathcal L}(p)=\sup_{\ell\in\mathcal L}\big|\mathbb E[\ell(\mathrm{BR}_\ell(p(x)),y)-\ell(\mathrm{BR}_\ell(p(x)),\tilde y)]\big|$; $\mathrm{DecOI}_{\mathcal L_{\mathrm{All}}}$ takes the supremum over $\mathcal L_{\mathrm{All}}$.
--   3. **Hypothesis OI**: $\mathrm{HypOI}_{\mathcal L,\mathcal H}(p)=\sup_{\ell\in\mathcal L,\,h\in\mathcal H}\big|\mathbb E[\ell(h(x),y)-\ell(h(x),\tilde y)]\big|$.
--   4. **Proper calibration** (Definition 2.4): $\mathrm{PCal}_K(p)=\sup_{\ell\in\mathcal L_{\mathrm{prop}}}\big|\mathbb E\langle\Delta\ell(p(x)),e_y-p(x)\rangle\big|$.
--   5. **$\ell_1$ expected calibration error**: $\mathrm{ECE}_1(p)=\mathbb E\big\|\mathbb E[e_y-p(x)\mid p(x)]\big\|_1$, the conditional expectation given the reported vector.
--   6. **Hypothesis tests**: $\Delta\mathcal L\circ\mathcal H=\{x\mapsto\Delta\ell(h(x)):\ \ell\in\mathcal L,\ h\in\mathcal H\}$, maps $\mathcal X\to[-2,2]^K$.
--
--   $p$ is an $\varepsilon$-omnipredictor for $(\mathcal L,\mathcal H)$ under $\mathcal D$ when $\mathrm{OmniReg}\le\varepsilon$. These are the quantities the Loss OI reduction, Proposition 2.5, the smoothing lemmas and the main theorem compare.
--
--   **Formalization Note.** `jointLaw D p` is the law of $((x,y),a)$, `D ⊗ₘ Kernel.prodMkRight (Fin K) p`. Suprema are real `⨆` over subtypes; every term is bounded by $2$ in absolute value (the empty supremum is $0$). `ECE1` uses Mathlib's `condExp` with respect to the σ-algebra generated by $a$; the paper's equivalent supremum form is not part of the definition.
-- source:
--   Rivkin, Okoroafor, Kim, The Sample Complexity of Multi-Class Omniprediction, STOC 2027 submission (manuscript sha256 135d9904…), p. 19, Definition 2.1; p. 20, §2.1 (DecOI, HypOI); p. 22, Definition 2.4 and ECE₁; p. 24, §2.4 (ΔL∘H)

import Mathlib
import Definitions.Def_MultiOmniRate_Lipschitz_Setting

set_option autoImplicit false

namespace MultiOmniRate.Lipschitz

open MeasureTheory ProbabilityTheory

noncomputable section

/-!
# Omniprediction error, Decision OI, Hypothesis OI, proper calibration, ECE₁
(Rivkin–Okoroafor–Kim, Definition 2.1 p. 19, §2.1 p. 20, Definition 2.4 p. 22, §2.4 p. 24)

A randomized predictor is a Markov kernel `p : X → Δ(Δ_K)` (footnote 3, p. 19); `p(x)` is the
reported vector. `jointLaw D p` is the law of `((x, y), a)` with `(x, y) ∼ D` and `a ∼ p(x)`
(prediction randomness independent of the label given `x`). The modeled label `ỹ ∼ a` enters
through its exact expectation `E_{ỹ∼a} ℓ(·, ỹ) = ⟨a, ℓ(·, ·)⟩`. Suprema are taken in `ℝ` over
classes whose terms are bounded by `2` in absolute value.
-/

variable {K : ℕ} {X : Type*} [MeasurableSpace X]

/-- Law of `((x, y), a)`: `(x, y) ∼ D`, then the reported vector `a ∼ p(x)`. -/
def jointLaw (D : Measure (X × Fin K)) (p : Kernel X (Simplex K)) :
    Measure ((X × Fin K) × Simplex K) :=
  D ⊗ₘ Kernel.prodMkRight (Fin K) p

/-- The omniprediction error (Definition 2.1):
`OmniReg_{L,H;D}(p) = sup_{ℓ ∈ L, h ∈ H} E_{(x,y)∼D}[ℓ(BR_ℓ(p(x)), y) − ℓ(h(x), y)]`
(no absolute value), the expectation including the prediction randomness. -/
def OmniReg {A : Type*} (L : Set (BRLoss K A)) (H : Set (X → A))
    (D : Measure (X × Fin K)) (p : Kernel X (Simplex K)) : ℝ :=
  ⨆ lh : L × H, ∫ ω, ((lh.1 : BRLoss K A).loss ((lh.1 : BRLoss K A).BR ω.2) ω.1.2 -
      (lh.1 : BRLoss K A).loss ((lh.2 : X → A) ω.1.1) ω.1.2) ∂(jointLaw D p)

/-- The Decision OI discrepancy of a properized loss `ℓ^pr`:
`E[ℓ^pr(p(x), y) − E_{ỹ∼p(x)} ℓ^pr(p(x), ỹ)]`. -/
def decTerm [NeZero K] (lpr : Simplex K → Fin K → ℝ) (D : Measure (X × Fin K))
    (p : Kernel X (Simplex K)) : ℝ :=
  ∫ ω, (lpr ω.2 ω.1.2 - dot (ω.2 : Fin K → ℝ) (lpr ω.2)) ∂(jointLaw D p)

/-- Decision OI error (§2.1, p. 20):
`DecOI_L(p) = sup_{ℓ ∈ L} |E[ℓ(BR_ℓ(p(x)), y) − ℓ(BR_ℓ(p(x)), ỹ)]|`, `ỹ ∼ p(x)`. -/
def DecOI [NeZero K] {A : Type*} (L : Set (BRLoss K A)) (D : Measure (X × Fin K))
    (p : Kernel X (Simplex K)) : ℝ :=
  ⨆ ℓ : L, |decTerm (ℓ : BRLoss K A).pr D p|

universe u

/-- `DecOI_{L_All}(p)`: Decision OI over all bounded decision losses with measurable best
responses on arbitrary action spaces (in universe `u`). -/
def DecOIAll [NeZero K] (D : Measure (X × Fin K)) (p : Kernel X (Simplex K)) : ℝ :=
  ⨆ ℓ : AllLoss.{u} K, |decTerm ℓ.ℓ.pr D p|

/-- Hypothesis OI error (§2.1, p. 20):
`HypOI_{L,H}(p) = sup_{ℓ ∈ L, h ∈ H} |E[ℓ(h(x), y) − ℓ(h(x), ỹ)]|`, `ỹ ∼ p(x)`. -/
def HypOI {A : Type*} (L : Set (BRLoss K A)) (H : Set (X → A))
    (D : Measure (X × Fin K)) (p : Kernel X (Simplex K)) : ℝ :=
  ⨆ lh : L × H, |∫ ω, ((lh.1 : BRLoss K A).loss ((lh.2 : X → A) ω.1.1) ω.1.2 -
      dot (ω.2 : Fin K → ℝ) ((lh.1 : BRLoss K A).loss ((lh.2 : X → A) ω.1.1))) ∂(jointLaw D p)|

/-- Proper-calibration error (Definition 2.4):
`PCal_K(p) = sup_{ℓ ∈ L_prop} |E⟨Δℓ(p(x)), e_y − p(x)⟩|`. -/
def PCal [NeZero K] (D : Measure (X × Fin K)) (p : Kernel X (Simplex K)) : ℝ :=
  ⨆ ℓ : LProp K, |∫ ω, dot (dLoss ((ℓ : Simplex K → Fin K → ℝ) ω.2)) (resid ω.1.2 ω.2)
      ∂(jointLaw D p)|

/-- The `ℓ₁` expected calibration error (§2.2, p. 22):
`ECE₁(p) = E ‖E[e_y − p(x) | p(x)]‖₁`, the conditional expectation given the reported vector
(σ-algebra generated by `a`). -/
def ECE1 (D : Measure (X × Fin K)) (p : Kernel X (Simplex K)) : ℝ :=
  ∫ ω, ∑ k, |condExp (MeasurableSpace.comap (fun ω : (X × Fin K) × Simplex K => ω.2) inferInstance)
      (jointLaw D p) (fun ω : (X × Fin K) × Simplex K => resid ω.1.2 ω.2 k) ω| ∂(jointLaw D p)

/-- The hypothesis-test class `ΔL ∘ H = {x ↦ Δℓ(h(x)) : ℓ ∈ L, h ∈ H}` (§2.4, p. 24). -/
def testClass [NeZero K] {A : Type*} (L : Set (BRLoss K A)) (H : Set (X → A)) :
    Set (X → Fin K → ℝ) :=
  {g | ∃ ℓ ∈ L, ∃ h ∈ H, g = fun x => dLoss (ℓ.loss (h x))}

end

end MultiOmniRate.Lipschitz


