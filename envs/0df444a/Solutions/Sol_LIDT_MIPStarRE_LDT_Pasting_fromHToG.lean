@[expose] public section

open LIDT.MIPStarRE.LDT.Pasting

open MIPStarRE.LDT
open MIPStarRE.LDT.ExpansionHypercubeGraph
open MIPStarRE.LDT.CommutativityPoints
open scoped BigOperators MatrixOrder _root_.Matrix ComplexOrder

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem solution
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters)
    [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (strategy : _root_.LIDT.MIPStarRE.LDT.SymStrat params.next ι)
    (family : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily params ι)
    (eps delta gamma zeta : _root_.LIDT.MIPStarRE.LDT.Error)
    (hgamma_nonneg : 0 ≤ gamma) (hzeta_nonneg : 0 ≤ zeta)
    (hgamma_le : gamma ≤ 1) (hzeta_le_one : zeta ≤ 1)
    (hdq_le : params.d ≤ params.q)
    (hgood : strategy.IsGood eps delta gamma)
    (hcons : family.ConsistentWithPoints strategy zeta)
    (hself : family.StronglySelfConsistent strategy.state zeta)
    (hbound : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily.SliceBoundednessInput strategy family zeta)
    (k : ℕ) :
    _root_.LIDT.MIPStarRE.LDT.Pasting.FromHToGStatement params strategy strategy.state family gamma zeta k := by
  have hfacts : _root_.LIDT.MIPStarRE.LDT.Pasting.GHatFactsStatement params strategy.state family gamma zeta :=
    _root_.LIDT.MIPStarRE.LDT.Pasting.gHatFacts params strategy family eps delta gamma zeta
      hgamma_nonneg hgamma_le hzeta_nonneg hzeta_le_one hdq_le
      hgood hcons hself hbound
  have hhalf : ∀ j : ℕ, 2 ≤ j →
      _root_.LIDT.MIPStarRE.LDT.Pasting.CommuteGHalfSandwichStatement params strategy.state family gamma zeta j := by
    intro j hj
    exact _root_.LIDT.MIPStarRE.LDT.Pasting.commuteGHalfSandwich params strategy family eps delta gamma zeta
      hgamma_nonneg hgamma_le hzeta_nonneg hzeta_le_one hdq_le
      hgood hcons hself hbound j hj
  exact _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToG_ofGHatFactsAndHalfSandwich params strategy strategy.state
    strategy.isNormalized family gamma zeta hgamma_nonneg hzeta_nonneg
    hzeta_le_one hfacts hhalf k
