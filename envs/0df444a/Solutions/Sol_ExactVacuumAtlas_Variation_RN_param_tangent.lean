-- ==== solution ====
open Real
open scoped ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.RN
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
open ExactVacuumAtlas.Variation.RN
theorem solution (M Q m q : ℝ) {x : Pt 4} (hx : x ∈ domRN) :
    (∀ a b, linEinstein (gRN M (Q ^ 2)) (giRN M (Q ^ 2)) (faradayRN Q) (tanRN Q m q) (tanFRN q) a b x = 0) ∧
    (∀ b, linMaxwell (gRN M (Q ^ 2)) (giRN M (Q ^ 2)) (faradayRN Q) (tanRN Q m q) (tanFRN q) b x = 0) ∧
    (∀ a b c, linFaraday (tanFRN q) a b c x = 0) := by
  have hfam := familyData_param M Q m q
  have ht := isTangent_param M Q m q
  have hcert : ∀ p ∈ domJ, EinsteinMaxwellCertificate (gRN (M + p.1 * m) ((Q + p.1 * q) ^ 2))
      (giRN (M + p.1 * m) ((Q + p.1 * q) ^ 2)) (faradayRN (Q + p.1 * q)) domRN :=
    fun p _ => EF.cert (M + p.1 * m) (Q + p.1 * q)
  refine ⟨fun a b => ?_, fun b => ?_, fun a b c => ?_⟩
  · have := linEinstein_eq_zero_of_onShell hfam ht (fun p hp i j => (hcert p hp).einstein p.2 hp i j)
      (mem_domJ hx 0) a b
    simpa only [zero_mul, add_zero] using this
  · have := linMaxwell_eq_zero_of_onShell hfam ht (fun p hp j => (hcert p hp).maxwell p.2 hp j)
      (mem_domJ hx 0) b
    simpa only [zero_mul, add_zero] using this
  · exact linFaraday_eq_zero_of_onShell hfam ht (fun p hp i j k => (hcert p hp).closed p.2 hp i j k)
      (mem_domJ hx 0) a b c
