                exact_mod_cast hnz t₀ ht₀
              have : ((w₀ + t : ℝ) : ℂ)
                  = (((w₀ + t) / (w₀ + t₀) : ℝ) : ℂ) * ((w₀ + t₀ : ℝ) : ℂ) := by
                push_cast
                rw [div_mul_cancel₀ _ hne₀]
              rw [this]
              ring
            rw [hρ]
            exact Complex.arg_real_mul _ (div_pos_iff.2 (by
              rcases lt_or_gt_of_ne (hnz t ht) with hneg | hpos
              · exact Or.inr ⟨hneg, by nlinarith⟩
              · exact Or.inl ⟨hpos, by nlinarith⟩))
        have hz := hne t ht
        rw [Complex.ofReal_neg, neg_mul, ← harg]
        rw [show Complex.exp (-(↑(Complex.arg (c₀ + t * c₁)) * Complex.I)) * (c₀ + t * c₁)
            = Complex.exp (-(↑(Complex.arg (c₀ + t * c₁)) * Complex.I))
              * (‖c₀ + t * c₁‖ * Complex.exp (↑(Complex.arg (c₀ + t * c₁)) * Complex.I))
            from by rw [Complex.norm_mul_exp_arg_mul_I]]
        rw [show Complex.exp (-(↑(Complex.arg (c₀ + t * c₁)) * Complex.I))
            * (↑‖c₀ + t * c₁‖ * Complex.exp (↑(Complex.arg (c₀ + t * c₁)) * Complex.I))
            = ↑‖c₀ + t * c₁‖ * (Complex.exp (-(↑(Complex.arg (c₀ + t * c₁)) * Complex.I))
              * Complex.exp (↑(Complex.arg (c₀ + t * c₁)) * Complex.I)) from by ring,
          ← Complex.exp_add, neg_add_cancel, Complex.exp_zero, mul_one]
      · intro k t
        rw [iteratedDeriv_succ_const, abs_zero]
        positivity

