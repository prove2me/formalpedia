  obtain ⟨g₀, hg₀0, hg₀⟩ := hprin

  obtain ⟨c₀, hc₀mem, hc₀res⟩ := Rpd.R₁.exists_smul_mem g₀ hg₀0
  have hc₀0 : c₀ ≠ 0 := Rpd.R₁.smul_const_ne_zero hc₀mem hc₀res
  set u₀ : ↥(xHFunctionFieldBar M H) := c₀ • g₀ with hu₀_def
  have hu₀gu : ∃ h : u₀ ∈ Rpd.R₁.integers, Rpd.R₁.residue ⟨u₀, h⟩ ≠ 0 := ⟨hc₀mem, hc₀res⟩
