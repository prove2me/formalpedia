abbrev incR (w : HeightOneSpectrum (𝓞 ℚ)) : (w.adicCompletion ℚ)ˣ →* (Loc a b w)ˣ :=
  Units.map (Algebra.TensorProduct.includeRight (R := ℚ) (A := ℍ[ℚ, a, b]) (B := w.adicCompletion ℚ)).toRingHom.toMonoidHom

theorem scalarUnits_eq_range (w : HeightOneSpectrum (𝓞 ℚ)) : scalarUnits (a := a) (b := b) w = (incR w).range := rfl

def qv (w : HeightOneSpectrum (𝓞 ℚ)) (q : ℚ) (hq : q ≠ 0) : (w.adicCompletion ℚ)ˣ :=
  Units.map (algebraMap ℚ (w.adicCompletion ℚ)).toMonoidHom (Units.mk0 q hq)

@[scoped simp] theorem val_qv (w : HeightOneSpectrum (𝓞 ℚ)) (q : ℚ) (hq : q ≠ 0) :
    ((qv w q hq : (w.adicCompletion ℚ)ˣ) : w.adicCompletion ℚ) = algebraMap ℚ (w.adicCompletion ℚ) q := rfl

theorem incR_mem_localBoxUnits {Λ : Submodule ℤ ℍ[ℚ, a, b]} (hΛ : QuaternionAlgebra.IsOrder Λ)
    (w : HeightOneSpectrum (𝓞 ℚ)) (t : (w.adicCompletion ℚ)ˣ)
    (ht : (t : w.adicCompletion ℚ) ∈ w.adicCompletionIntegers ℚ)
    (ht' : ((t⁻¹ : (w.adicCompletion ℚ)ˣ) : w.adicCompletion ℚ) ∈ w.adicCompletionIntegers ℚ) :
    incR w t ∈ Submodule.localBoxUnits Λ w := by
  refine ⟨?_, ?_⟩
  · rw [Units.coe_map]
    exact AddSubgroup.subset_closure ⟨1, hΛ.one_mem, _, ht, rfl⟩
  · rw [Units.coe_map_inv]
    exact AddSubgroup.subset_closure ⟨1, hΛ.one_mem, _, ht', rfl⟩

theorem classSet_mk_mul_insertAt_incR_of_integral {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R)
    (v : HeightOneSpectrum (𝓞 ℚ)) (x : (𝔸ℍ)ˣ) (t : (v.adicCompletion ℚ)ˣ)
    (ht : (t : v.adicCompletion ℚ) ∈ v.adicCompletionIntegers ℚ)
    (ht' : ((t⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) ∈ v.adicCompletionIntegers ℚ) :
    ClassSet.mk (Submodule.finiteIdeleStabilizer R) (x * insertAt v (incR v t)) =
      ClassSet.mk (Submodule.finiteIdeleStabilizer R) x :=
  ClassSet.mk_mul_of_mem _ _ (insertAt_mem_finiteIdeleStabilizer hR v (incR_mem_localBoxUnits hR v t ht ht'))

theorem unitsMap_finiteAdeleEvalAt_diagonal_ratUnit (w : HeightOneSpectrum (𝓞 ℚ)) (q : ℚ) (hq : q ≠ 0) :
    Units.map (ev w).toRingHom.toMonoidHom (Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] (HeckeLevel.ratUnit q hq)) =
      incR w (qv w q hq) := by
  apply Units.ext
  rw [Units.coe_map, Units.coe_map]
  show (ev w) ((Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] (HeckeLevel.ratUnit q hq) : (𝔸ℍ)ˣ) : 𝔸ℍ) =
    Algebra.TensorProduct.includeRight (algebraMap ℚ (w.adicCompletion ℚ) q)
  rw [Submodule.val_finiteIdeleDiagonal_apply, HeckeLevel.val_ratUnit, Submodule.finiteAdeleEvalAt_tmul,
    Algebra.TensorProduct.includeRight_apply]
  have h1 : ((1 : FiniteAdeleRing (𝓞 ℚ) ℚ) w) = 1 := rfl
  rw [h1, HeckeLevel.coe_rat_eq_smul_one, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]

theorem classSet_mk_mul_insertAt_incR_qv {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R)
    (v : HeightOneSpectrum (𝓞 ℚ)) (x : (𝔸ℍ)ˣ) (q : ℚ) (hq : q ≠ 0)
    (hqw : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v →
      algebraMap ℚ (w.adicCompletion ℚ) q ∈ w.adicCompletionIntegers ℚ ∧
        algebraMap ℚ (w.adicCompletion ℚ) q⁻¹ ∈ w.adicCompletionIntegers ℚ) :
    ClassSet.mk (Submodule.finiteIdeleStabilizer R) (x * insertAt v (incR v (qv v q hq))) =
      ClassSet.mk (Submodule.finiteIdeleStabilizer R) x := by
  set d : (𝔸ℍ)ˣ := Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] (HeckeLevel.ratUnit q hq) with hd
  set e : (𝔸ℍ)ˣ := d⁻¹ * insertAt v (incR v (qv v q hq)) with he
  have hcomm : ∀ y : (𝔸ℍ)ˣ, y * d = d * y := fun y => by
    apply Units.ext
    rw [Units.val_mul, Units.val_mul, hd, HeckeLevel.diagonal_ratUnit_mul_eq_smul]
    rw [show ((Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] (HeckeLevel.ratUnit q hq) : (𝔸ℍ)ˣ) : 𝔸ℍ) = q • (1 : 𝔸ℍ) by
      rw [← mul_one ((Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] (HeckeLevel.ratUnit q hq) : (𝔸ℍ)ˣ) : 𝔸ℍ),
        HeckeLevel.diagonal_ratUnit_mul_eq_smul], mul_smul_comm, mul_one]
  have he_mem : e ∈ Submodule.finiteIdeleStabilizer R := by
    refine (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
      R hR _).mpr fun w => ?_
    rw [he, map_mul, map_inv, unitsMap_finiteAdeleEvalAt_diagonal_ratUnit]
    by_cases hw : w = v
    · subst hw
      have : Units.map (ev w).toRingHom.toMonoidHom (insertAt w (incR w (qv w q hq))) = incR w (qv w q hq) :=
        Units.ext (finiteAdeleEvalAt_insertAt_self w _)
      rw [this, inv_mul_cancel]
      exact one_mem_localBoxUnits hR w
    · have : Units.map (ev w).toRingHom.toMonoidHom (insertAt v (incR v (qv v q hq))) = 1 :=
        Units.ext (finiteAdeleEvalAt_insertAt_of_ne v _ hw)
      rw [this, mul_one, ← map_inv]
      refine incR_mem_localBoxUnits hR w _ ?_ ?_
      · rw [Units.val_inv_eq_inv_val, val_qv, ← map_inv₀]; exact (hqw w hw).2
      · rw [inv_inv, val_qv]; exact (hqw w hw).1
  have hsplit : insertAt v (incR v (qv v q hq)) = d * e := by rw [he, mul_inv_cancel_left]
  rw [hsplit, ← mul_assoc, hcomm, mul_assoc, ClassSet.mk_diagonal_mul, ClassSet.mk_mul_of_mem _ _ he_mem]

theorem natGenerator_pow_integral_of_ne (v : HeightOneSpectrum (𝓞 ℚ)) (n : ℕ)
    (w : HeightOneSpectrum (𝓞 ℚ)) (hw : w ≠ v) :
    algebraMap ℚ (w.adicCompletion ℚ) (((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℚ) ^ n) ∈ w.adicCompletionIntegers ℚ ∧
      algebraMap ℚ (w.adicCompletion ℚ) ((((Rat.HeightOneSpectrum.natGenerator v : ℕ) : ℚ) ^ n)⁻¹) ∈
        w.adicCompletionIntegers ℚ := by
  set p : ℕ := Rat.HeightOneSpectrum.natGenerator v with hp
  have hpp : p.Prime := Rat.HeightOneSpectrum.prime_natGenerator v
  refine ⟨?_, ?_⟩
  · rw [map_pow, map_natCast]; exact pow_mem (natCast_mem _ _) _
  · rw [← inv_pow, map_pow]
    refine pow_mem ?_ _
    refine Nat.inv_natCast_mem_adicCompletionIntegers_of_not_mem_placesOf hpp.ne_zero fun hmem => hw ?_
    rw [Nat.mem_placesOf_iff hpp.ne_zero] at hmem
    exact Nat.HeightOneSpectrum.eq_of_natCast_prime_mem hpp hmem (L2Lift.natGenerator_mem v)

theorem classSet_mk_mul_insertAt_incR_of_mem {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R)
    (v : HeightOneSpectrum (𝓞 ℚ)) (x : (𝔸ℍ)ˣ) (t : (v.adicCompletion ℚ)ˣ)
    (ht : (t : v.adicCompletion ℚ) ∈ v.adicCompletionIntegers ℚ) :
    ClassSet.mk (Submodule.finiteIdeleStabilizer R) (x * insertAt v (incR v t)) =
      ClassSet.mk (Submodule.finiteIdeleStabilizer R) x := by
  set p : ℕ := Rat.HeightOneSpectrum.natGenerator v with hp
  have hpp : p.Prime := Rat.HeightOneSpectrum.prime_natGenerator v
  obtain ⟨n, u, hu⟩ := L2Lift.exists_unit_mul_pow hpp v (L2Lift.natGenerator_mem v) (t : v.adicCompletion ℚ) ht t.ne_zero
  have hq : (((p : ℕ) : ℚ) ^ n) ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr hpp.ne_zero)
  set u' : (v.adicCompletion ℚ)ˣ := Units.map (v.adicCompletionIntegers ℚ).subtype.toMonoidHom u with hu'
  have ht_eq : t = u' * qv v _ hq := by
    apply Units.ext
    rw [Units.val_mul, hu', Units.coe_map, val_qv, map_pow, map_natCast]
    exact hu
  rw [ht_eq, map_mul, insertAt_mul, ← mul_assoc,
    classSet_mk_mul_insertAt_incR_qv hR v _ _ hq (fun w hw => natGenerator_pow_integral_of_ne v n w hw),
    classSet_mk_mul_insertAt_incR_of_integral hR v x u' u.1.2 (u⁻¹).1.2]

theorem classSet_mk_mul_insertAt_scalar {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R)
    (v : HeightOneSpectrum (𝓞 ℚ)) (x : (𝔸ℍ)ˣ) {c : (Loc a b v)ˣ} (hc : c ∈ scalarUnits v) :
    ClassSet.mk (Submodule.finiteIdeleStabilizer R) (x * insertAt v c) =
      ClassSet.mk (Submodule.finiteIdeleStabilizer R) x := by
  obtain ⟨t, rfl⟩ := hc
  rcases (v.adicCompletionIntegers ℚ).mem_or_inv_mem (t : v.adicCompletion ℚ) with ht | ht
  · exact classSet_mk_mul_insertAt_incR_of_mem hR v x t ht
  · have h := classSet_mk_mul_insertAt_incR_of_mem hR v (x * insertAt v (incR v t)) t⁻¹
      (by rw [Units.val_inv_eq_inv_val]; exact ht)
    rw [mul_assoc, ← insertAt_mul, ← map_mul, mul_inv_cancel, map_one, insertAt_one, mul_one] at h
    exact h.symm

theorem includeRight_mul_comm (v : HeightOneSpectrum (𝓞 ℚ)) (c : v.adicCompletion ℚ) (x : Loc a b v) :
    (Algebra.TensorProduct.includeRight (R := ℚ) (A := ℍ[ℚ, a, b]) c) * x =
      x * (Algebra.TensorProduct.includeRight (R := ℚ) (A := ℍ[ℚ, a, b]) c) := by
  induction x using TensorProduct.induction_on with
  | zero => rw [mul_zero, zero_mul]
  | tmul y d =>
    rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul,
      Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one, mul_comm]
  | add y z hy hz => rw [mul_add, add_mul, hy, hz]

scoped instance scalarUnits_normal (v : HeightOneSpectrum (𝓞 ℚ)) : (scalarUnits (a := a) (b := b) v).Normal where
  conj_mem := by
    rintro n ⟨c, rfl⟩ g
    refine ⟨c, ?_⟩
    apply Units.ext
    rw [Units.val_mul, Units.val_mul]
    show _ = (g : Loc a b v) * (Algebra.TensorProduct.includeRight (R := ℚ) (A := ℍ[ℚ, a, b]) (c : v.adicCompletion ℚ)) * ↑g⁻¹
    rw [← includeRight_mul_comm, mul_assoc, Units.mul_inv, mul_one]
    rfl

theorem exists_mul_eq_of_mem_level (R : Submodule ℤ ℍ[ℚ, a, b]) (v : HeightOneSpectrum (𝓞 ℚ)) {k : (Loc a b v)ˣ}
    (hk : k ∈ level R v) :
    ∃ k₁ ∈ Subgroup.closure (Submodule.localBoxUnits R v), ∃ k₂ ∈ scalarUnits v, k₁ * k₂ = k := by
  have h : (k : (Loc a b v)ˣ) ∈ ((level R v : Subgroup (Loc a b v)ˣ) : Set (Loc a b v)ˣ) := hk
  rw [level, Subgroup.mul_normal] at h
  obtain ⟨k₁, hk₁, k₂, hk₂, e⟩ := Set.mem_mul.mp h
  exact ⟨k₁, hk₁, k₂, hk₂, e⟩

theorem classSet_mk_mul_insertAt_of_mem_level {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R)
    (v : HeightOneSpectrum (𝓞 ℚ)) (x : (𝔸ℍ)ˣ) {k : (Loc a b v)ˣ} (hk : k ∈ level R v) :
    ClassSet.mk (Submodule.finiteIdeleStabilizer R) (x * insertAt v k) =
      ClassSet.mk (Submodule.finiteIdeleStabilizer R) x := by
  obtain ⟨k₁, hk₁, k₂, hk₂, rfl⟩ := exists_mul_eq_of_mem_level R v hk
  rw [insertAt_mul, ← mul_assoc, classSet_mk_mul_insertAt_scalar hR v _ hk₂]
  clear hk hk₂
  induction hk₁ using Subgroup.closure_induction generalizing x with
  | mem k hk' => exact ClassSet.mk_mul_of_mem _ _ (insertAt_mem_finiteIdeleStabilizer hR v hk')
  | one => rw [insertAt_one, mul_one]
  | mul k k' _ _ ih ih' => rw [insertAt_mul, ← mul_assoc, ih', ih]
  | inv k _ ih =>
    have h := ih (x * insertAt v k⁻¹)
    rw [mul_assoc, ← insertAt_mul, inv_mul_cancel, insertAt_one, mul_one] at h
    exact h.symm

theorem classSet_mk_insertAt_mul_of_mem_level {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R)
    (v : HeightOneSpectrum (𝓞 ℚ)) (g : (Loc a b v)ˣ) {k : (Loc a b v)ˣ} (hk : k ∈ level R v) :
    ClassSet.mk (Submodule.finiteIdeleStabilizer R) (insertAt v (g * k)) =
      ClassSet.mk (Submodule.finiteIdeleStabilizer R) (insertAt v g) := by
  rw [insertAt_mul]; exact classSet_mk_mul_insertAt_of_mem_level hR v _ hk

def localUnits {Λ : Submodule ℤ ℍ[ℚ, a, b]} (hΛ : QuaternionAlgebra.IsOrder Λ) (w : HeightOneSpectrum (𝓞 ℚ)) :
    Subgroup (Loc a b w)ˣ where
  carrier := Submodule.localBoxUnits Λ w
  one_mem' := one_mem_localBoxUnits hΛ w
  mul_mem' := by
    intro x y hx hy
    refine ⟨?_, ?_⟩
    · rw [Units.val_mul]; exact HeckeLocal.localBox_mul_mem hΛ w hx.1 hy.1
    · rw [mul_inv_rev, Units.val_mul]; exact HeckeLocal.localBox_mul_mem hΛ w hy.2 hx.2
  inv_mem' := by
    intro x hx
    exact ⟨hx.2, by rw [inv_inv]; exact hx.1⟩

theorem closure_localBoxUnits_eq {Λ : Submodule ℤ ℍ[ℚ, a, b]} (hΛ : QuaternionAlgebra.IsOrder Λ)
    (w : HeightOneSpectrum (𝓞 ℚ)) :
    Subgroup.closure (Submodule.localBoxUnits Λ w) = localUnits hΛ w :=
  (localUnits hΛ w).closure_eq

theorem mem_closure_localBoxUnits_iff {Λ : Submodule ℤ ℍ[ℚ, a, b]} (hΛ : QuaternionAlgebra.IsOrder Λ)
    (w : HeightOneSpectrum (𝓞 ℚ)) (k : (Loc a b w)ˣ) :
    k ∈ Subgroup.closure (Submodule.localBoxUnits Λ w) ↔ k ∈ Submodule.localBoxUnits Λ w := by
  rw [closure_localBoxUnits_eq hΛ w]; rfl

theorem mem_awayUnits_iff {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (v : HeightOneSpectrum (𝓞 ℚ))
    (γ : (ℍ[ℚ, a, b])ˣ) :
    γ ∈ awayUnits R v ↔ ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → toLoc w γ ∈ Submodule.localBoxUnits R w := by
  simp only [awayUnits, Subgroup.mem_iInf, Subgroup.mem_comap, mem_closure_localBoxUnits_iff hR]

theorem unitsMap_finiteAdeleEvalAt_diagonal (w : HeightOneSpectrum (𝓞 ℚ)) (γ : (ℍ[ℚ, a, b])ˣ) :
    Units.map (ev w).toRingHom.toMonoidHom (Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] γ) = toLoc w γ := by
  apply Units.ext
  rw [Units.coe_map]
  show (ev w) ((Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] γ : (𝔸ℍ)ˣ) : 𝔸ℍ) = Algebra.TensorProduct.includeLeft (γ : ℍ[ℚ, a, b])
  rw [Submodule.val_finiteIdeleDiagonal_apply, Submodule.finiteAdeleEvalAt_tmul, Algebra.TensorProduct.includeLeft_apply]
  rfl

def vertToClass {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (v : HeightOneSpectrum (𝓞 ℚ)) :
    Vert R v → ClassSet (Submodule.finiteIdeleStabilizer R) :=
  Quotient.lift (s := QuotientGroup.leftRel (level R v))
    (fun g => ClassSet.mk (Submodule.finiteIdeleStabilizer R) (insertAt v g))
    (fun g h hgh => by
      replace hgh := QuotientGroup.leftRel_apply.mp hgh
      have e : h = g * (g⁻¹ * h) := by rw [mul_inv_cancel_left]
      show ClassSet.mk _ (insertAt v g) = ClassSet.mk _ (insertAt v h)
      rw [e]
      exact (classSet_mk_insertAt_mul_of_mem_level hR v g hgh).symm)

theorem vertToClass_mk {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (v : HeightOneSpectrum (𝓞 ℚ))
    (g : (Loc a b v)ˣ) :
    vertToClass hR v ((g : (Loc a b v)ˣ) : Vert R v) = ClassSet.mk (Submodule.finiteIdeleStabilizer R) (insertAt v g) := rfl

theorem diagonal_inv_mul_insertAt_toLoc_mem {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R)
    (v : HeightOneSpectrum (𝓞 ℚ)) {γ : (ℍ[ℚ, a, b])ˣ} (hγ : γ ∈ awayUnits R v) :
    (Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] γ)⁻¹ * insertAt v (toLoc v γ) ∈ Submodule.finiteIdeleStabilizer R := by
  refine (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
    R hR _).mpr fun w => ?_
  rw [map_mul, map_inv, unitsMap_finiteAdeleEvalAt_diagonal]
  by_cases hw : w = v
  · subst hw
    have : Units.map (ev w).toRingHom.toMonoidHom (insertAt w (toLoc w γ)) = toLoc w γ :=
      Units.ext (finiteAdeleEvalAt_insertAt_self w _)
    rw [this, inv_mul_cancel]; exact one_mem_localBoxUnits hR w
  · have : Units.map (ev w).toRingHom.toMonoidHom (insertAt v (toLoc v γ)) = 1 :=
      Units.ext (finiteAdeleEvalAt_insertAt_of_ne v _ hw)
    rw [this, mul_one]
    exact ((localUnits hR w).inv_mem ((mem_awayUnits_iff hR v γ).mp hγ w hw))

theorem mul_insertAt_comm_of_evalAt_eq_one (v : HeightOneSpectrum (𝓞 ℚ)) {u : (𝔸ℍ)ˣ}
    (hu : (ev v) (u : 𝔸ℍ) = 1) (g : (Loc a b v)ˣ) :
    u * insertAt v g = insertAt v g * u := by
  apply Units.ext
  apply Submodule.eq_of_forall_finiteAdeleEvalAt_eq
  intro w
  rw [Units.val_mul, Units.val_mul, map_mul, map_mul]
  by_cases hw : w = v
  · subst hw; rw [hu, one_mul, mul_one]
  · rw [finiteAdeleEvalAt_insertAt_of_ne v g hw, one_mul, mul_one]

theorem vertToClass_smul {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (v : HeightOneSpectrum (𝓞 ℚ))
    (γ : awayUnits R v) (x : Vert R v) : vertToClass hR v (γ • x) = vertToClass hR v x := by
  induction x using QuotientGroup.induction_on with
  | H g =>
    rw [coe_smul_vert_mk, vertToClass_mk, vertToClass_mk, insertAt_mul]
    set δ : (𝔸ℍ)ˣ := Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] (γ : (ℍ[ℚ, a, b])ˣ) with hδ
    set u : (𝔸ℍ)ˣ := δ⁻¹ * insertAt v (toLoc v (γ : (ℍ[ℚ, a, b])ˣ)) with hu
    have hu_mem : u ∈ Submodule.finiteIdeleStabilizer R := diagonal_inv_mul_insertAt_toLoc_mem hR v γ.2
    have hu_v : (ev v) (u : 𝔸ℍ) = 1 := by
      have h := congrArg (fun z : (Loc a b v)ˣ => (z : Loc a b v))
        (show Units.map (ev v).toRingHom.toMonoidHom u = 1 by
          rw [hu, map_mul, map_inv, unitsMap_finiteAdeleEvalAt_diagonal,
            show Units.map (ev v).toRingHom.toMonoidHom (insertAt v (toLoc v (γ : (ℍ[ℚ, a, b])ˣ))) = toLoc v γ from
              Units.ext (finiteAdeleEvalAt_insertAt_self v _), inv_mul_cancel])
      simpa using h
    have e : insertAt v (toLoc v (γ : (ℍ[ℚ, a, b])ˣ)) = δ * u := by rw [hu, mul_inv_cancel_left]
    rw [e, mul_assoc, mul_insertAt_comm_of_evalAt_eq_one v hu_v, ← mul_assoc, hδ, mul_assoc,
      ClassSet.mk_diagonal_mul, ClassSet.mk_mul_of_mem _ _ hu_mem]

def eVfun {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (v : HeightOneSpectrum (𝓞 ℚ)) :
    Mumford.QuotVert (ProjAwayUnits R v) (Vert R v) → ClassSet (Submodule.finiteIdeleStabilizer R) :=
  Quotient.lift (s := MulAction.orbitRel (ProjAwayUnits R v) (Vert R v)) (vertToClass hR v) (by
    intro x y hxy
    obtain ⟨q, rfl⟩ := MulAction.orbitRel_apply.mp hxy
    induction q using QuotientGroup.induction_on with
    | H γ => exact vertToClass_smul hR v γ y)

theorem eVfun_mk {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (v : HeightOneSpectrum (𝓞 ℚ))
    (x : Vert R v) :
    eVfun hR v (Quotient.mk (MulAction.orbitRel (ProjAwayUnits R v) (Vert R v)) x) = vertToClass hR v x := rfl

theorem eVfun_injective {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (v : HeightOneSpectrum (𝓞 ℚ)) :
    Function.Injective (eVfun hR v) := by
  intro X Y hXY
  induction X using Quotient.inductionOn with
  | h x =>
  induction Y using Quotient.inductionOn with
  | h y =>
  induction x using QuotientGroup.induction_on with
  | H g =>
  induction y using QuotientGroup.induction_on with
  | H g' =>
  rw [eVfun_mk, eVfun_mk, vertToClass_mk, vertToClass_mk] at hXY
  obtain ⟨δ', hδ', u, hu, huv⟩ := (DoubleCoset.eq _ _ _ _).mp hXY
  obtain ⟨γ, rfl⟩ := MonoidHom.mem_range.mp hδ'

  have hcomp : ∀ w, Units.map (ev w).toRingHom.toMonoidHom (insertAt v g') =
      toLoc w γ * Units.map (ev w).toRingHom.toMonoidHom (insertAt v g) * Units.map (ev w).toRingHom.toMonoidHom u := by
    intro w; rw [huv, map_mul, map_mul, unitsMap_finiteAdeleEvalAt_diagonal]
  have hu' := (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
    R hR u).mp hu
  have hγ : γ ∈ awayUnits R v := by
    rw [mem_awayUnits_iff hR v]
    intro w hw
    have h := hcomp w
    rw [show Units.map (ev w).toRingHom.toMonoidHom (insertAt v g') = 1 from Units.ext (finiteAdeleEvalAt_insertAt_of_ne v _ hw),
      show Units.map (ev w).toRingHom.toMonoidHom (insertAt v g) = 1 from Units.ext (finiteAdeleEvalAt_insertAt_of_ne v _ hw),
      mul_one] at h
    have : toLoc w γ = (Units.map (ev w).toRingHom.toMonoidHom u)⁻¹ := eq_inv_of_mul_eq_one_left h.symm
    rw [this]
    exact (localUnits hR w).inv_mem (hu' w)

  have hv : (g' : Vert R v) = (⟨γ, hγ⟩ : awayUnits R v) • (g : Vert R v) := by
    rw [coe_smul_vert_mk]
    apply QuotientGroup.eq.mpr
    have h := hcomp v
    rw [show Units.map (ev v).toRingHom.toMonoidHom (insertAt v g') = g' from Units.ext (finiteAdeleEvalAt_insertAt_self v _),
      show Units.map (ev v).toRingHom.toMonoidHom (insertAt v g) = g from Units.ext (finiteAdeleEvalAt_insertAt_self v _)] at h
    set T := toLoc v (γ : (ℍ[ℚ, a, b])ˣ)
    set uv := Units.map (ev v).toRingHom.toMonoidHom u
    have e : (T * g * uv)⁻¹ * (T * g) = uv⁻¹ := by group
    rw [h]
    show (T * g * uv)⁻¹ * (T * g) ∈ level R v
    rw [e]
    exact inv_mem (Subgroup.mem_sup_left (Subgroup.subset_closure (hu' v)))
  rw [hv]
  exact Quotient.sound ((MulAction.orbitRel (ProjAwayUnits R v) (Vert R v)).symm (MulAction.orbitRel_apply.mpr
    (MulAction.mem_orbit (g : Vert R v) (QuotientGroup.mk (⟨γ, hγ⟩ : awayUnits R v) : ProjAwayUnits R v))))

theorem insertAt_unitsMap_of_forall_ne (v : HeightOneSpectrum (𝓞 ℚ)) (g : (𝔸ℍ)ˣ)
    (hg : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → (ev w) (g : 𝔸ℍ) = 1) :
    insertAt v (Units.map (ev v).toRingHom.toMonoidHom g) = g := by
  apply Units.ext
  apply Submodule.eq_of_forall_finiteAdeleEvalAt_eq
  intro w
  by_cases hw : w = v
  · subst hw; rw [finiteAdeleEvalAt_insertAt_self]; rfl
  · rw [finiteAdeleEvalAt_insertAt_of_ne v _ hw, hg w hw]

def StrongApproxAt (R : Submodule ℤ ℍ[ℚ, a, b]) (v : HeightOneSpectrum (𝓞 ℚ)) : Prop :=
  ∀ x : (𝔸ℍ)ˣ, ∃ (γ : (ℍ[ℚ, a, b])ˣ) (g u : (𝔸ℍ)ˣ), u ∈ Submodule.finiteIdeleStabilizer R ∧
    (∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → (ev w) (g : 𝔸ℍ) = 1) ∧
    x = Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] γ * g * u

theorem eVfun_surjective {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (v : HeightOneSpectrum (𝓞 ℚ))
    (hSA : StrongApproxAt R v) : Function.Surjective (eVfun hR v) := by
  intro c
  obtain ⟨x, rfl⟩ := ClassSet.mk_surjective c
  obtain ⟨γ, g, u, hu, hg, rfl⟩ := hSA x
  refine ⟨Quotient.mk _ ((Units.map (ev v).toRingHom.toMonoidHom g : (Loc a b v)ˣ) : Vert R v), ?_⟩
  rw [eVfun_mk, vertToClass_mk, insertAt_unitsMap_of_forall_ne v g hg, mul_assoc, ClassSet.mk_diagonal_mul,
    ClassSet.mk_mul_of_mem _ _ hu]

def eV {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (v : HeightOneSpectrum (𝓞 ℚ))
    (hSA : StrongApproxAt R v) :
    Mumford.QuotVert (ProjAwayUnits R v) (Vert R v) ≃ ClassSet (Submodule.finiteIdeleStabilizer R) :=
  Equiv.ofBijective (eVfun hR v) ⟨eVfun_injective hR v, eVfun_surjective hR v hSA⟩

theorem eV_pin {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (v : HeightOneSpectrum (𝓞 ℚ))
    (hSA : StrongApproxAt R v) (x : (𝔸ℍ)ˣ)
    (hx : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → (ev w) (x : 𝔸ℍ) = 1) :
    eV hR v hSA (Quotient.mk (MulAction.orbitRel (ProjAwayUnits R v) (Vert R v))
      ((QuotientGroup.mk (Units.map (ev v).toRingHom.toMonoidHom x) : Vert R v))) =
      ClassSet.mk (Submodule.finiteIdeleStabilizer R) x := by
  rw [eV, Equiv.ofBijective_apply, eVfun_mk]
  show vertToClass hR v ((Units.map (ev v).toRingHom.toMonoidHom x : (Loc a b v)ˣ) : Vert R v) = _
  rw [vertToClass_mk, insertAt_unitsMap_of_forall_ne v x hx]

def LocalAL (R S : Submodule ℤ ℍ[ℚ, a, b]) (v : HeightOneSpectrum (𝓞 ℚ)) (nv : (Loc a b v)ˣ) : Prop :=
  nv * nv ∈ level R v ∧ nv ∉ level R v ∧ ∀ k : (Loc a b v)ˣ, (k ∈ level R v ∧ nv⁻¹ * k * nv ∈ level R v) ↔ k ∈ level S v

def DartRep {R : Submodule ℤ ℍ[ℚ, a, b]} {v : HeightOneSpectrum (𝓞 ℚ)} {nv : (Loc a b v)ˣ} (d : (graph R v nv).Dart) :
    Set (Loc a b v)ˣ :=
  {h | ((h : (Loc a b v)ˣ) : Vert R v) = d.fst ∧ ((h * nv : (Loc a b v)ˣ) : Vert R v) = d.snd}

theorem dartRep_nonempty {R S : Submodule ℤ ℍ[ℚ, a, b]} {v : HeightOneSpectrum (𝓞 ℚ)} {nv : (Loc a b v)ˣ}
    (hAL : LocalAL R S v nv) (d : (graph R v nv).Dart) : (DartRep d).Nonempty := by
  obtain ⟨-, g, k, hk, h⟩ := d.adj
  rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · refine ⟨g * k, ?_, ?_⟩
    · rw [h1]; apply QuotientGroup.eq.mpr
      rw [mul_inv_rev, inv_mul_cancel_right]; exact inv_mem hk
    · rw [h2]
  · refine ⟨g * k * nv, ?_, ?_⟩
    · rw [h2]
    · rw [h1]; apply QuotientGroup.eq.mpr
      have e : (g * k * nv * nv)⁻¹ * g = (nv * nv)⁻¹ * k⁻¹ := by group
      rw [e]; exact mul_mem (inv_mem hAL.1) (inv_mem hk)

theorem dartRep_rel {R S : Submodule ℤ ℍ[ℚ, a, b]} {v : HeightOneSpectrum (𝓞 ℚ)} {nv : (Loc a b v)ˣ}
    (hAL : LocalAL R S v nv) {d : (graph R v nv).Dart} {h h' : (Loc a b v)ˣ} (hh : h ∈ DartRep d)
    (hh' : h' ∈ DartRep d) : h⁻¹ * h' ∈ level S v := by
  refine (hAL.2.2 _).mp ⟨QuotientGroup.eq.mp (hh.1.trans hh'.1.symm), ?_⟩
  have e : nv⁻¹ * (h⁻¹ * h') * nv = (h * nv)⁻¹ * (h' * nv) := by group
  rw [e]; exact QuotientGroup.eq.mp (hh.2.trans hh'.2.symm)

def dartToClass {R : Submodule ℤ ℍ[ℚ, a, b]} (S : Submodule ℤ ℍ[ℚ, a, b]) {v : HeightOneSpectrum (𝓞 ℚ)} {nv : (Loc a b v)ˣ}
    (hAL : LocalAL R S v nv) (d : (graph R v nv).Dart) : ClassSet (Submodule.finiteIdeleStabilizer S) :=
  ClassSet.mk _ (insertAt v (dartRep_nonempty hAL d).some)

theorem dartToClass_eq {R S : Submodule ℤ ℍ[ℚ, a, b]} (hS : QuaternionAlgebra.IsOrder S) {v : HeightOneSpectrum (𝓞 ℚ)}
    {nv : (Loc a b v)ˣ} (hAL : LocalAL R S v nv) (d : (graph R v nv).Dart) {h : (Loc a b v)ˣ} (hh : h ∈ DartRep d) :
    dartToClass S hAL d = ClassSet.mk (Submodule.finiteIdeleStabilizer S) (insertAt v h) := by
  have hrel := dartRep_rel hAL (dartRep_nonempty hAL d).some_mem hh
  have e : h = (dartRep_nonempty hAL d).some * ((dartRep_nonempty hAL d).some⁻¹ * h) := by rw [mul_inv_cancel_left]
  rw [dartToClass, e]
  exact (classSet_mk_insertAt_mul_of_mem_level hS v _ hrel).symm

theorem dartToClass_smul {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) {v : HeightOneSpectrum (𝓞 ℚ)}
    {n : (𝔸ℍ)ˣ} {q : ℕ} (hq : q ≠ 0) (hn : n ∈ QuaternionAlgebra.primeHeckeSet R q)
    (hvq : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → w ∉ Nat.placesOf q)
    (hAL : LocalAL R (CerednikDrinfeld.meetOrder R n) v (Units.map (ev v).toRingHom.toMonoidHom n))
    (γ : awayUnits R v) (d : (graph R v (Units.map (ev v).toRingHom.toMonoidHom n)).Dart) :
    dartToClass (CerednikDrinfeld.meetOrder R n) hAL ((QuotientGroup.mk γ : ProjAwayUnits R v) • d) =
      dartToClass (CerednikDrinfeld.meetOrder R n) hAL d := by
  have hS : QuaternionAlgebra.IsOrder (CerednikDrinfeld.meetOrder R n) :=
    hR.inf (QuaternionAlgebra.IsOrder.conjByFiniteIdele R hR n)
  obtain ⟨h, hh⟩ := dartRep_nonempty hAL d
  have hh' : toLoc v (γ : (ℍ[ℚ, a, b])ˣ) * h ∈ DartRep ((QuotientGroup.mk γ : ProjAwayUnits R v) • d) := by
    refine ⟨?_, ?_⟩
    · show _ = (QuotientGroup.mk γ : ProjAwayUnits R v) • d.fst
      rw [mk_smul_vert, ← hh.1, coe_smul_vert_mk]
    · show _ = (QuotientGroup.mk γ : ProjAwayUnits R v) • d.snd
      rw [mk_smul_vert, ← hh.2, coe_smul_vert_mk, mul_assoc]
  rw [dartToClass_eq hS hAL _ hh', dartToClass_eq hS hAL _ hh, insertAt_mul]

  set δ : (𝔸ℍ)ˣ := Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] (γ : (ℍ[ℚ, a, b])ˣ) with hδ
  set u : (𝔸ℍ)ˣ := δ⁻¹ * insertAt v (toLoc v (γ : (ℍ[ℚ, a, b])ˣ)) with hu
  have hu_R : u ∈ Submodule.finiteIdeleStabilizer R := diagonal_inv_mul_insertAt_toLoc_mem hR v γ.2
  have hu_v1 : Units.map (ev v).toRingHom.toMonoidHom u = 1 := by
    rw [hu, map_mul, map_inv, unitsMap_finiteAdeleEvalAt_diagonal,
      show Units.map (ev v).toRingHom.toMonoidHom (insertAt v (toLoc v (γ : (ℍ[ℚ, a, b])ˣ))) = toLoc v γ from
        Units.ext (finiteAdeleEvalAt_insertAt_self v _), inv_mul_cancel]
  have hu_v : (ev v) (u : 𝔸ℍ) = 1 := by
    have h := congrArg (fun z : (Loc a b v)ˣ => (z : Loc a b v)) hu_v1
    simpa using h
  have hu_S : u ∈ Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n) := by
    rw [HeckeLevel.mem_finiteIdeleStabilizer_meetOrder_iff R hR]
    refine ⟨hu_R, ?_⟩
    have hu' := (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
      R hR u).mp hu_R
    refine (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
      R hR _).mpr fun w => ?_
    rw [map_mul, map_mul, map_inv]
    by_cases hw : w = v
    · subst hw; rw [hu_v1, mul_one, inv_mul_cancel]; exact one_mem_localBoxUnits hR w
    · have hnw := GOODEQ.unitsMap_mem_localBoxUnits_of_mem_primeHeckeSet hq hn (hvq w hw)
      exact (localUnits hR w).mul_mem ((localUnits hR w).mul_mem ((localUnits hR w).inv_mem hnw) (hu' w)) hnw
  have e : insertAt v (toLoc v (γ : (ℍ[ℚ, a, b])ˣ)) = δ * u := by rw [hu, mul_inv_cancel_left]
  rw [e, mul_assoc, mul_insertAt_comm_of_evalAt_eq_one v hu_v, ← mul_assoc, hδ, mul_assoc,
    ClassSet.mk_diagonal_mul, ClassSet.mk_mul_of_mem _ _ hu_S]

def eEfun {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) {v : HeightOneSpectrum (𝓞 ℚ)}
    {n : (𝔸ℍ)ˣ} {q : ℕ} (hq : q ≠ 0) (hn : n ∈ QuaternionAlgebra.primeHeckeSet R q)
    (hvq : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → w ∉ Nat.placesOf q)
    (hAL : LocalAL R (CerednikDrinfeld.meetOrder R n) v (Units.map (ev v).toRingHom.toMonoidHom n)) :
    Mumford.QuotEdge (ProjAwayUnits R v) (graph R v (Units.map (ev v).toRingHom.toMonoidHom n)) →
      ClassSet (Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n)) :=
  Quotient.lift (s := MulAction.orbitRel (ProjAwayUnits R v) (graph R v (Units.map (ev v).toRingHom.toMonoidHom n)).Dart)
    (dartToClass (CerednikDrinfeld.meetOrder R n) hAL) (by
      intro x y hxy
      obtain ⟨γq, rfl⟩ := MulAction.orbitRel_apply.mp hxy
      induction γq using QuotientGroup.induction_on with
      | H γ => exact dartToClass_smul hR hq hn hvq hAL γ y)

theorem eEfun_mk {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) {v : HeightOneSpectrum (𝓞 ℚ)}
    {n : (𝔸ℍ)ˣ} {q : ℕ} (hq : q ≠ 0) (hn : n ∈ QuaternionAlgebra.primeHeckeSet R q)
    (hvq : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → w ∉ Nat.placesOf q)
    (hAL : LocalAL R (CerednikDrinfeld.meetOrder R n) v (Units.map (ev v).toRingHom.toMonoidHom n))
    (d : (graph R v (Units.map (ev v).toRingHom.toMonoidHom n)).Dart) :
    eEfun hR hq hn hvq hAL (Quotient.mk _ d) = dartToClass (CerednikDrinfeld.meetOrder R n) hAL d := rfl

theorem eEfun_injective {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) {v : HeightOneSpectrum (𝓞 ℚ)}
    {n : (𝔸ℍ)ˣ} {q : ℕ} (hq : q ≠ 0) (hn : n ∈ QuaternionAlgebra.primeHeckeSet R q)
    (hvq : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → w ∉ Nat.placesOf q)
    (hAL : LocalAL R (CerednikDrinfeld.meetOrder R n) v (Units.map (ev v).toRingHom.toMonoidHom n)) :
    Function.Injective (eEfun hR hq hn hvq hAL) := by
  set nv := Units.map (ev v).toRingHom.toMonoidHom n with hnv
  have hS : QuaternionAlgebra.IsOrder (CerednikDrinfeld.meetOrder R n) :=
    hR.inf (QuaternionAlgebra.IsOrder.conjByFiniteIdele R hR n)
  intro X Y hXY
  induction X using Quotient.inductionOn with
  | h d =>
  induction Y using Quotient.inductionOn with
  | h d' =>
  obtain ⟨h, hh⟩ := dartRep_nonempty hAL d
  obtain ⟨h', hh'⟩ := dartRep_nonempty hAL d'
  rw [eEfun_mk, eEfun_mk, dartToClass_eq hS hAL d hh, dartToClass_eq hS hAL d' hh'] at hXY
  obtain ⟨δ', hδ', u, hu, huv⟩ := (DoubleCoset.eq _ _ _ _).mp hXY
  obtain ⟨γ, rfl⟩ := MonoidHom.mem_range.mp hδ'
  have hcomp : ∀ w, Units.map (ev w).toRingHom.toMonoidHom (insertAt v h') =
      toLoc w γ * Units.map (ev w).toRingHom.toMonoidHom (insertAt v h) * Units.map (ev w).toRingHom.toMonoidHom u := by
    intro w; rw [huv, map_mul, map_mul, unitsMap_finiteAdeleEvalAt_diagonal]
  have huR : u ∈ Submodule.finiteIdeleStabilizer R := ((HeckeLevel.mem_finiteIdeleStabilizer_meetOrder_iff R hR n u).mp hu).1
  have hu' := (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
    R hR u).mp huR
  have huS' := (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
    _ hS u).mp hu
  have hγ : γ ∈ awayUnits R v := by
    rw [mem_awayUnits_iff hR v]
    intro w hw
    have hc := hcomp w
    rw [show Units.map (ev w).toRingHom.toMonoidHom (insertAt v h') = 1 from Units.ext (finiteAdeleEvalAt_insertAt_of_ne v _ hw),
      show Units.map (ev w).toRingHom.toMonoidHom (insertAt v h) = 1 from Units.ext (finiteAdeleEvalAt_insertAt_of_ne v _ hw),
      mul_one] at hc
    have : toLoc w γ = (Units.map (ev w).toRingHom.toMonoidHom u)⁻¹ := eq_inv_of_mul_eq_one_left hc.symm
    rw [this]
    exact (localUnits hR w).inv_mem (hu' w)

  have huv_S : Units.map (ev v).toRingHom.toMonoidHom u ∈ level (CerednikDrinfeld.meetOrder R n) v :=
    Subgroup.mem_sup_left (Subgroup.subset_closure (huS' v))
  have hv' : h' = toLoc v γ * h * Units.map (ev v).toRingHom.toMonoidHom u := by
    have hc := hcomp v
    rwa [show Units.map (ev v).toRingHom.toMonoidHom (insertAt v h') = h' from Units.ext (finiteAdeleEvalAt_insertAt_self v _),
      show Units.map (ev v).toRingHom.toMonoidHom (insertAt v h) = h from Units.ext (finiteAdeleEvalAt_insertAt_self v _)] at hc

  have hlev := (hAL.2.2 _).mpr huv_S
  have hd' : d' = (QuotientGroup.mk (⟨γ, hγ⟩ : awayUnits R v) : ProjAwayUnits R v) • d := by
    apply SimpleGraph.Dart.ext
    apply Prod.ext
    · show d'.fst = (QuotientGroup.mk (⟨γ, hγ⟩ : awayUnits R v) : ProjAwayUnits R v) • d.fst
      rw [mk_smul_vert, ← hh'.1, ← hh.1, coe_smul_vert_mk, hv']
      apply Eq.symm; apply QuotientGroup.eq.mpr
      have e : (toLoc v γ * h)⁻¹ * (toLoc v γ * h * Units.map (ev v).toRingHom.toMonoidHom u) =
          Units.map (ev v).toRingHom.toMonoidHom u := by group
      show (toLoc v γ * h)⁻¹ * _ ∈ _
      rw [e]; exact hlev.1
    · show d'.snd = (QuotientGroup.mk (⟨γ, hγ⟩ : awayUnits R v) : ProjAwayUnits R v) • d.snd
      rw [mk_smul_vert, ← hh'.2, ← hh.2, coe_smul_vert_mk, hv']
      apply Eq.symm; apply QuotientGroup.eq.mpr
      have e : (toLoc v ↑(⟨γ, hγ⟩ : awayUnits R v) * (h * nv))⁻¹ * (toLoc v γ * h * Units.map (ev v).toRingHom.toMonoidHom u * nv) =
          nv⁻¹ * Units.map (ev v).toRingHom.toMonoidHom u * nv := by
        show (toLoc v γ * (h * nv))⁻¹ * _ = _; group
      rw [e]; exact hlev.2
  rw [hd']
  exact Quotient.sound ((MulAction.orbitRel (ProjAwayUnits R v) _).symm (MulAction.orbitRel_apply.mpr (MulAction.mem_orbit _ _)))

def mkDart {R S : Submodule ℤ ℍ[ℚ, a, b]} {v : HeightOneSpectrum (𝓞 ℚ)} {nv : (Loc a b v)ˣ} (hAL : LocalAL R S v nv)
    (h : (Loc a b v)ˣ) : (graph R v nv).Dart :=
  ⟨(((h : (Loc a b v)ˣ) : Vert R v), ((h * nv : (Loc a b v)ˣ) : Vert R v)),
    ⟨fun e => hAL.2.1 (by have := QuotientGroup.eq.mp e; rwa [inv_mul_cancel_left] at this),
      h, 1, one_mem _, Or.inl ⟨rfl, by rw [mul_one]⟩⟩⟩

theorem mem_dartRep_mkDart {R S : Submodule ℤ ℍ[ℚ, a, b]} {v : HeightOneSpectrum (𝓞 ℚ)} {nv : (Loc a b v)ˣ}
    (hAL : LocalAL R S v nv) (h : (Loc a b v)ˣ) : h ∈ DartRep (mkDart hAL h) := ⟨rfl, rfl⟩

theorem eEfun_surjective {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) {v : HeightOneSpectrum (𝓞 ℚ)}
    {n : (𝔸ℍ)ˣ} {q : ℕ} (hq : q ≠ 0) (hn : n ∈ QuaternionAlgebra.primeHeckeSet R q)
    (hvq : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → w ∉ Nat.placesOf q)
    (hAL : LocalAL R (CerednikDrinfeld.meetOrder R n) v (Units.map (ev v).toRingHom.toMonoidHom n))
    (hSA : StrongApproxAt (CerednikDrinfeld.meetOrder R n) v) :
    Function.Surjective (eEfun hR hq hn hvq hAL) := by
  have hS : QuaternionAlgebra.IsOrder (CerednikDrinfeld.meetOrder R n) :=
    hR.inf (QuaternionAlgebra.IsOrder.conjByFiniteIdele R hR n)
  intro c
  obtain ⟨x, rfl⟩ := ClassSet.mk_surjective c
  obtain ⟨γ, g, u, hu, hg, rfl⟩ := hSA x
  refine ⟨Quotient.mk _ (mkDart hAL (Units.map (ev v).toRingHom.toMonoidHom g)), ?_⟩
  rw [eEfun_mk, dartToClass_eq hS hAL _ (mem_dartRep_mkDart hAL _), insertAt_unitsMap_of_forall_ne v g hg, mul_assoc,
    ClassSet.mk_diagonal_mul, ClassSet.mk_mul_of_mem _ _ hu]

def eE {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) {v : HeightOneSpectrum (𝓞 ℚ)}
    {n : (𝔸ℍ)ˣ} {q : ℕ} (hq : q ≠ 0) (hn : n ∈ QuaternionAlgebra.primeHeckeSet R q)
    (hvq : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → w ∉ Nat.placesOf q)
    (hAL : LocalAL R (CerednikDrinfeld.meetOrder R n) v (Units.map (ev v).toRingHom.toMonoidHom n))
    (hSA : StrongApproxAt (CerednikDrinfeld.meetOrder R n) v) :
    Mumford.QuotEdge (ProjAwayUnits R v) (graph R v (Units.map (ev v).toRingHom.toMonoidHom n)) ≃
      ClassSet (Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n)) :=
  Equiv.ofBijective (eEfun hR hq hn hvq hAL) ⟨eEfun_injective hR hq hn hvq hAL, eEfun_surjective hR hq hn hvq hAL hSA⟩

theorem eE_pin {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) {v : HeightOneSpectrum (𝓞 ℚ)}
    {n : (𝔸ℍ)ˣ} {q : ℕ} (hq : q ≠ 0) (hn : n ∈ QuaternionAlgebra.primeHeckeSet R q)
    (hvq : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → w ∉ Nat.placesOf q)
    (hAL : LocalAL R (CerednikDrinfeld.meetOrder R n) v (Units.map (ev v).toRingHom.toMonoidHom n))
    (hSA : StrongApproxAt (CerednikDrinfeld.meetOrder R n) v)
    (d : (graph R v (Units.map (ev v).toRingHom.toMonoidHom n)).Dart) (x : (𝔸ℍ)ˣ)
    (hx : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → (ev w) (x : 𝔸ℍ) = 1)
    (h₁ : d.fst = ((Units.map (ev v).toRingHom.toMonoidHom x : (Loc a b v)ˣ) : Vert R v))
    (h₂ : d.snd = ((Units.map (ev v).toRingHom.toMonoidHom x * Units.map (ev v).toRingHom.toMonoidHom n :
      (Loc a b v)ˣ) : Vert R v)) :
    eE hR hq hn hvq hAL hSA (Quotient.mk _ d) = ClassSet.mk (Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n)) x := by
  have hS : QuaternionAlgebra.IsOrder (CerednikDrinfeld.meetOrder R n) :=
    hR.inf (QuaternionAlgebra.IsOrder.conjByFiniteIdele R hR n)
  rw [eE, Equiv.ofBijective_apply, eEfun_mk, dartToClass_eq hS hAL d ⟨h₁.symm, h₂.symm⟩, insertAt_unitsMap_of_forall_ne v x hx]

def WidthDict (R : Submodule ℤ ℍ[ℚ, a, b]) (v : HeightOneSpectrum (𝓞 ℚ)) (n : (𝔸ℍ)ˣ) : Prop :=
  ∀ (z : (𝔸ℍ)ˣ), (∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → (ev w) (z : 𝔸ℍ) = 1) →
    ∀ d : (graph R v (Units.map (ev v).toRingHom.toMonoidHom n)).Dart,
      d.fst = ((Units.map (ev v).toRingHom.toMonoidHom z : (Loc a b v)ˣ) : Vert R v) →
      d.snd = ((Units.map (ev v).toRingHom.toMonoidHom z * Units.map (ev v).toRingHom.toMonoidHom n : (Loc a b v)ˣ) :
        Vert R v) →
      Finite (MulAction.stabilizer (ProjAwayUnits R v) d) ∧
        Nat.card (MulAction.stabilizer (ProjAwayUnits R v) d) =
          Nat.card {u : ℍ[ℚ, a, b] // QuaternionAlgebra.IsUnitOf
            (Submodule.conjByFiniteIdele (CerednikDrinfeld.meetOrder R n) z) u} / 2

theorem natCard_isUnitOf_conjByFiniteIdele_diagonal_mul (S : Submodule ℤ ℍ[ℚ, a, b]) (γ : (ℍ[ℚ, a, b])ˣ) (β : (𝔸ℍ)ˣ) :
    Nat.card {u : ℍ[ℚ, a, b] // QuaternionAlgebra.IsUnitOf
        (Submodule.conjByFiniteIdele S (Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] γ * β)) u} =
      Nat.card {u : ℍ[ℚ, a, b] // QuaternionAlgebra.IsUnitOf (Submodule.conjByFiniteIdele S β) u} := by
  have key : ∀ u : ℍ[ℚ, a, b], QuaternionAlgebra.IsUnitOf
      (Submodule.conjByFiniteIdele S (Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] γ * β)) u ↔
      QuaternionAlgebra.IsUnitOf (Submodule.conjByFiniteIdele S β) ((↑γ⁻¹ : ℍ[ℚ, a, b]) * u * γ) := by
    intro u
    constructor
    · rintro ⟨hu, w, hw, h1, h2⟩
      refine ⟨(Submodule.mem_conjByFiniteIdele_diagonal_mul_iff S γ β u).mp hu, (↑γ⁻¹ : ℍ[ℚ, a, b]) * w * γ,
        (Submodule.mem_conjByFiniteIdele_diagonal_mul_iff S γ β w).mp hw, ?_, ?_⟩
      · rw [show (↑γ⁻¹ : ℍ[ℚ, a, b]) * u * ↑γ * (↑γ⁻¹ * w * ↑γ) = ↑γ⁻¹ * (u * (↑γ * ↑γ⁻¹) * w) * ↑γ by noncomm_ring,
          Units.mul_inv, mul_one, h1, mul_one, Units.inv_mul]
      · rw [show (↑γ⁻¹ : ℍ[ℚ, a, b]) * w * ↑γ * (↑γ⁻¹ * u * ↑γ) = ↑γ⁻¹ * (w * (↑γ * ↑γ⁻¹) * u) * ↑γ by noncomm_ring,
          Units.mul_inv, mul_one, h2, mul_one, Units.inv_mul]
    · rintro ⟨hu, w, hw, h1, h2⟩
      refine ⟨(Submodule.mem_conjByFiniteIdele_diagonal_mul_iff S γ β u).mpr hu, (γ : ℍ[ℚ, a, b]) * w * ↑γ⁻¹, ?_, ?_, ?_⟩
      · apply (Submodule.mem_conjByFiniteIdele_diagonal_mul_iff S γ β _).mpr
        rw [show (↑γ⁻¹ : ℍ[ℚ, a, b]) * (↑γ * w * ↑γ⁻¹) * ↑γ = (↑γ⁻¹ * ↑γ) * w * (↑γ⁻¹ * ↑γ) by noncomm_ring,
          Units.inv_mul, one_mul, mul_one]
        exact hw
      · calc u * ((γ : ℍ[ℚ, a, b]) * w * ↑γ⁻¹) = ↑γ * ((↑γ⁻¹ * u * ↑γ) * w) * ↑γ⁻¹ := by
              rw [show (γ : ℍ[ℚ, a, b]) * ((↑γ⁻¹ * u * ↑γ) * w) * ↑γ⁻¹ = (↑γ * ↑γ⁻¹) * u * (↑γ * w * ↑γ⁻¹) by noncomm_ring,
                Units.mul_inv, one_mul]
          _ = 1 := by rw [h1, mul_one, Units.mul_inv]
      · calc (γ : ℍ[ℚ, a, b]) * w * ↑γ⁻¹ * u = ↑γ * (w * (↑γ⁻¹ * u * ↑γ)) * ↑γ⁻¹ := by
              rw [show (γ : ℍ[ℚ, a, b]) * (w * (↑γ⁻¹ * u * ↑γ)) * ↑γ⁻¹ = (↑γ * w * ↑γ⁻¹) * u * (↑γ * ↑γ⁻¹) by noncomm_ring,
                Units.mul_inv, mul_one]
          _ = 1 := by rw [h2, mul_one, Units.mul_inv]
  refine Nat.card_congr
    { toFun := fun u => ⟨(↑γ⁻¹ : ℍ[ℚ, a, b]) * u.1 * γ, (key u.1).mp u.2⟩
      invFun := fun u => ⟨(γ : ℍ[ℚ, a, b]) * u.1 * ↑γ⁻¹, (key _).mpr (by
        rw [show (↑γ⁻¹ : ℍ[ℚ, a, b]) * (↑γ * u.1 * ↑γ⁻¹) * ↑γ = (↑γ⁻¹ * ↑γ) * u.1 * (↑γ⁻¹ * ↑γ) by noncomm_ring,
          Units.inv_mul, one_mul, mul_one]; exact u.2)⟩
      left_inv := fun u => Subtype.ext (by
        show (γ : ℍ[ℚ, a, b]) * (↑γ⁻¹ * u.1 * ↑γ) * ↑γ⁻¹ = u.1
        rw [show (γ : ℍ[ℚ, a, b]) * (↑γ⁻¹ * u.1 * ↑γ) * ↑γ⁻¹ = (↑γ * ↑γ⁻¹) * u.1 * (↑γ * ↑γ⁻¹) by noncomm_ring,
          Units.mul_inv, one_mul, mul_one])
      right_inv := fun u => Subtype.ext (by
        show (↑γ⁻¹ : ℍ[ℚ, a, b]) * (↑γ * u.1 * ↑γ⁻¹) * ↑γ = u.1
        rw [show (↑γ⁻¹ : ℍ[ℚ, a, b]) * (↑γ * u.1 * ↑γ⁻¹) * ↑γ = (↑γ⁻¹ * ↑γ) * u.1 * (↑γ⁻¹ * ↑γ) by noncomm_ring,
          Units.inv_mul, one_mul, mul_one]) }

theorem natCard_isUnitOf_conjByFiniteIdele_out {S : Submodule ℤ ℍ[ℚ, a, b]} (hS : QuaternionAlgebra.IsOrder S) (z : (𝔸ℍ)ˣ) :
    Nat.card {u : ℍ[ℚ, a, b] // QuaternionAlgebra.IsUnitOf
        (Submodule.conjByFiniteIdele S (ClassSet.mk (Submodule.finiteIdeleStabilizer S) z).out) u} =
      Nat.card {u : ℍ[ℚ, a, b] // QuaternionAlgebra.IsUnitOf (Submodule.conjByFiniteIdele S z) u} := by
  have hmk : ClassSet.mk (Submodule.finiteIdeleStabilizer S) (ClassSet.mk (Submodule.finiteIdeleStabilizer S) z).out =
      ClassSet.mk (Submodule.finiteIdeleStabilizer S) z := Quotient.out_eq _
  obtain ⟨δ', hδ', s, hs, hout⟩ := (DoubleCoset.eq _ _ _ _).mp hmk.symm
  obtain ⟨δ, rfl⟩ := MonoidHom.mem_range.mp hδ'
  rw [hout, Submodule.conjByFiniteIdele_mul_eq_of_mem_finiteIdeleStabilizer S hS.one_mem (fun x y hx hy => hS.mul_mem hx hy) _ s hs,
    natCard_isUnitOf_conjByFiniteIdele_diagonal_mul]

theorem strongApproxAt_meetOrder {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) {v : HeightOneSpectrum (𝓞 ℚ)}
    {n : (𝔸ℍ)ˣ} {q : ℕ} (hq : q ≠ 0) (hn : n ∈ QuaternionAlgebra.primeHeckeSet R q)
    (hvq : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → w ∉ Nat.placesOf q)
    (hSA : StrongApproxAt R v) : StrongApproxAt (CerednikDrinfeld.meetOrder R n) v := by
  intro x
  obtain ⟨γ, g, u, hu, hg, rfl⟩ := hSA x
  set uv := Units.map (ev v).toRingHom.toMonoidHom u with huv
  set u' : (𝔸ℍ)ˣ := (insertAt v uv)⁻¹ * u with hu'
  have hu_loc := (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
    R hR u).mp hu
  have huvR : insertAt v uv ∈ Submodule.finiteIdeleStabilizer R := insertAt_mem_finiteIdeleStabilizer hR v (hu_loc v)
  have hu'R : u' ∈ Submodule.finiteIdeleStabilizer R := mul_mem (inv_mem huvR) hu
  have hu'v1 : Units.map (ev v).toRingHom.toMonoidHom u' = 1 := by
    rw [hu', map_mul, map_inv, show Units.map (ev v).toRingHom.toMonoidHom (insertAt v uv) = uv from
      Units.ext (finiteAdeleEvalAt_insertAt_self v _), huv, inv_mul_cancel]
  have hu'S : u' ∈ Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n) := by
    rw [HeckeLevel.mem_finiteIdeleStabilizer_meetOrder_iff R hR]
    refine ⟨hu'R, ?_⟩
    have hu'' := (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
      R hR u').mp hu'R
    refine (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
      R hR _).mpr fun w => ?_
    rw [map_mul, map_mul, map_inv]
    by_cases hw : w = v
    · subst hw; rw [hu'v1, mul_one, inv_mul_cancel]; exact one_mem_localBoxUnits hR w
    · have hnw := GOODEQ.unitsMap_mem_localBoxUnits_of_mem_primeHeckeSet hq hn (hvq w hw)
      exact (localUnits hR w).mul_mem ((localUnits hR w).mul_mem ((localUnits hR w).inv_mem hnw) (hu'' w)) hnw
  refine ⟨γ, g * insertAt v uv, u', hu'S, fun w hw => ?_, ?_⟩
  · rw [Units.val_mul, map_mul, hg w hw, one_mul, finiteAdeleEvalAt_insertAt_of_ne v _ hw]
  · rw [hu']; group

theorem insertAt_inv_mul_mem_finiteIdeleStabilizer {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R)
    {v : HeightOneSpectrum (𝓞 ℚ)} {n : (𝔸ℍ)ˣ} {q : ℕ} (hq : q ≠ 0) (hn : n ∈ QuaternionAlgebra.primeHeckeSet R q)
    (hvq : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v → w ∉ Nat.placesOf q) :
    (insertAt v (Units.map (ev v).toRingHom.toMonoidHom n))⁻¹ * n ∈ Submodule.finiteIdeleStabilizer R := by
  refine (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
    R hR _).mpr fun w => ?_
  rw [map_mul, map_inv]
  by_cases hw : w = v
  · subst hw
    rw [show Units.map (ev w).toRingHom.toMonoidHom (insertAt w (Units.map (ev w).toRingHom.toMonoidHom n)) =
        Units.map (ev w).toRingHom.toMonoidHom n from Units.ext (finiteAdeleEvalAt_insertAt_self w _), inv_mul_cancel]
    exact one_mem_localBoxUnits hR w
  · rw [show Units.map (ev w).toRingHom.toMonoidHom (insertAt v (Units.map (ev v).toRingHom.toMonoidHom n)) = 1 from
      Units.ext (finiteAdeleEvalAt_insertAt_of_ne v _ hw), inv_one, one_mul]
    exact GOODEQ.unitsMap_mem_localBoxUnits_of_mem_primeHeckeSet hq hn (hvq w hw)

theorem classSetForget_mk_meetOrder {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (n z : (𝔸ℍ)ˣ) :
    CerednikDrinfeld.classSetForget (Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n))
      (Submodule.finiteIdeleStabilizer R) (ClassSet.mk _ z) = ClassSet.mk (Submodule.finiteIdeleStabilizer R) z := by
  unfold CerednikDrinfeld.classSetForget
  have hmk : ClassSet.mk (Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n))
      (ClassSet.mk (Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n)) z).out = ClassSet.mk _ z :=
    Quotient.out_eq _
  obtain ⟨δ', hδ', s, hs, hout⟩ := (DoubleCoset.eq _ _ _ _).mp hmk.symm
  obtain ⟨δ, rfl⟩ := MonoidHom.mem_range.mp hδ'
  rw [hout, mul_assoc, ClassSet.mk_diagonal_mul,
    ClassSet.mk_mul_of_mem _ _ ((HeckeLevel.mem_finiteIdeleStabilizer_meetOrder_iff R hR n s).mp hs).1]

theorem classSet_mk_out_mul_eq {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsOrder R) (n z : (𝔸ℍ)ˣ) :
    ClassSet.mk (Submodule.finiteIdeleStabilizer R)
        ((ClassSet.mk (Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n)) z).out * n) =
      ClassSet.mk (Submodule.finiteIdeleStabilizer R) (z * n) := by
  have hmk : ClassSet.mk (Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n))
      (ClassSet.mk (Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R n)) z).out = ClassSet.mk _ z :=
    Quotient.out_eq _
  obtain ⟨δ', hδ', s, hs, hout⟩ := (DoubleCoset.eq _ _ _ _).mp hmk.symm
  obtain ⟨δ, rfl⟩ := MonoidHom.mem_range.mp hδ'
  have hs' := ((HeckeLevel.mem_finiteIdeleStabilizer_meetOrder_iff R hR n s).mp hs).2
  rw [hout, show Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] δ * z * s * n =
      Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] δ * ((z * n) * (n⁻¹ * s * n)) by group,
    ClassSet.mk_diagonal_mul, ClassSet.mk_mul_of_mem _ _ hs']

def vertToClassRaw (R : Submodule ℤ ℍ[ℚ, a, b]) (v : HeightOneSpectrum (𝓞 ℚ)) (g : (Loc a b v)ˣ) :
    ClassSet (Submodule.finiteIdeleStabilizer R) :=
