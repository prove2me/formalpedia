    Ideal.Quotient.lift _ (RingHom.id L) (fun a ha => by rw [hbot, Ideal.mem_bot] at ha; simpa using ha)
  haveI : (Ideal.comap (τ.comp e) 𝔮).IsPrime := Ideal.IsPrime.comap _
  refine ⟨(⟨Ideal.comap (τ.comp e) 𝔮, inferInstance⟩ : PrimeSpectrum (L ⧸ Ideal.span {algebraMap 𝒪 L π})),
    fun a ha hmem => ?_⟩
  have hmem' : τ (e (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 L π}) a)) ∈ 𝔮 := hmem
  rw [show e (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 L π}) a) = a from Ideal.Quotient.lift_mk _ _ _] at hmem'
  exact h𝔮.ne_top (Ideal.eq_top_of_isUnit_mem _ hmem' ha)

