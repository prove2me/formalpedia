/-! ### Part 3: Analytic Soundness of the `K = 256` Buchstab Upper Envelope -/

noncomputable section

private lemma buchstab_integral_eq {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {a b : ℝ} (ha : 2 ≤ a) (hab : a ≤ b) :
    b * ω b - a * ω a = ∫ s in (a - 1)..(b - 1), ω s := by
  rcases hω with ⟨hcont, _, hderiv⟩
  have hsub : Icc a b ⊆ Ici (1 : ℝ) := fun x hx => le_trans (by linarith) hx.1
  have hcont_mul : ContinuousOn (fun v => v * ω v) (Icc a b) :=
    continuousOn_id.mul (hcont.mono hsub)
  have hderiv_open : ∀ x ∈ Ioo a b, HasDerivAt (fun v => v * ω v) (ω (x - 1)) x :=
    fun x hx => hderiv x (by linarith [hx.1])
  have hcont_shift : ContinuousOn (fun t => ω (t - 1)) (Icc a b) := by
    refine hcont.comp (continuousOn_id.sub continuousOn_const) ?_
    intro x hx; change 1 ≤ x - 1; linarith [hx.1]
  have hint : IntervalIntegrable (fun t => ω (t - 1)) volume a b :=
    hcont_shift.intervalIntegrable_of_Icc hab
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hab hcont_mul hderiv_open hint
  rw [← hftc, intervalIntegral.integral_comp_sub_right]

private lemma buchstab_nonneg_on_Icc {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    ∀ n : ℕ, ∀ u : ℝ, 1 ≤ u → u ≤ (n : ℝ) + 2 → 0 ≤ ω u := by
  intro n
  induction n with
  | zero =>
    intro u hu1 hu2
    push_cast at hu2
    rw [hω.2.1 u hu1 (by linarith)]
    positivity
  | succ n ih =>
    intro u hu1 hu2
    by_cases hle : u ≤ (n : ℝ) + 2
    · exact ih u hu1 hle
    · push Not at hle
      set b : ℝ := (n : ℝ) + 2
      have hb2 : 2 ≤ b := by dsimp only [b]; linarith [Nat.cast_nonneg (α := ℝ) n]
      have hbu : b ≤ u := le_of_lt hle
      have heq := buchstab_integral_eq hω hb2 hbu
      have hwb : 0 ≤ ω b := ih b (by linarith) (le_refl b)
      have hint_nn : 0 ≤ ∫ s in (b - 1)..(u - 1), ω s := by
        apply intervalIntegral.integral_nonneg (by linarith)
        intro s hs
        exact ih s (by linarith [hs.1]) (by push_cast at hu2; linarith [hs.2])
      have hu_pos : 0 < u := by linarith
      have hmul : 0 ≤ u * ω u := by nlinarith
      exact nonneg_of_mul_nonneg_right hmul hu_pos

private lemma buchstab_nonneg {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    (u : ℝ) : 0 ≤ ω u := by
  by_cases h1 : u < 1
  · rw [hz u h1]
  · push Not at h1
    exact buchstab_nonneg_on_Icc hω (Nat.ceil u) u h1 (by linarith [Nat.le_ceil u])

private lemma integral_inv_le_trapezoid {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, (1 / s : ℝ) ≤ (b - a) / 2 * (1 / a + 1 / b) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont1 : ContinuousOn (fun s : ℝ => 1 / s) (Icc a b) :=
    continuousOn_const.div continuousOn_id (fun s hs => ne_of_gt (lt_of_lt_of_le ha hs.1))
  have hcont2 : ContinuousOn (fun s : ℝ => (a + b - s) / (a * b)) (Icc a b) :=
    (continuousOn_const.sub continuousOn_id).div_const (a * b)
  have hmono : ∫ s in a..b, (1 / s : ℝ) ≤ ∫ s in a..b, (a + b - s) / (a * b) := by
    apply intervalIntegral.integral_mono_on hab
      (hcont1.intervalIntegrable_of_Icc hab) (hcont2.intervalIntegrable_of_Icc hab)
    intro s hs
    have hs_pos : 0 < s := lt_of_lt_of_le ha hs.1
    rw [div_le_div_iff₀ hs_pos (mul_pos ha hb)]
    nlinarith [hs.1, hs.2]
  have heval : ∫ s in a..b, (a + b - s) / (a * b) = (b - a) / 2 * (1 / a + 1 / b) := by
    have hderiv : ∀ x ∈ uIcc a b,
        HasDerivAt (fun s : ℝ => ((a + b) * s - s ^ 2 / 2) / (a * b)) ((a + b - x) / (a * b)) x := by
      intro x _
      have h1 : HasDerivAt (fun s : ℝ => (a + b) * s) (a + b) x := by
        simpa using (hasDerivAt_id x).const_mul (a + b)
      have h2 : HasDerivAt (fun s : ℝ => s ^ 2 / 2) x x := by
        simpa [mul_comm] using ((hasDerivAt_pow 2 x).div_const 2)
      exact (h1.sub h2).div_const (a * b)
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont2.intervalIntegrable_of_Icc hab)]
    field_simp; ring
  linarith

private lemma integral_inv_sq_eq {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, (1 / (s * s) : ℝ) = 1 / a - 1 / b := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont : ContinuousOn (fun s : ℝ => 1 / (s * s)) (Icc a b) :=
    continuousOn_const.div (continuousOn_id.mul continuousOn_id)
      (fun s hs => mul_ne_zero (ne_of_gt (lt_of_lt_of_le ha hs.1)) (ne_of_gt (lt_of_lt_of_le ha hs.1)))
  have hderiv : ∀ x ∈ uIcc a b, HasDerivAt (fun s : ℝ => -1 / s) (1 / (x * x)) x := by
    intro x hx
    rw [uIcc_of_le hab] at hx
    have hx_ne : x ≠ 0 := ne_of_gt (lt_of_lt_of_le ha hx.1)
    have h : HasDerivAt (fun s : ℝ => -(s⁻¹)) (-(-(x ^ 2)⁻¹)) x := (hasDerivAt_inv hx_ne).neg
    have hfun : (fun s : ℝ => (-1 : ℝ) / s) = (fun s : ℝ => -(s⁻¹)) := by
      funext s; rw [neg_div, one_div]
    have hval : (1 : ℝ) / (x * x) = -(-(x ^ 2)⁻¹) := by rw [neg_neg, ← one_div, sq]
    rw [hfun, hval]; exact h
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable_of_Icc hab)]
  ring

private lemma integral_sub_div_cube_eq {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, ((b - s) / (s * s * s) : ℝ) = (b - a) ^ 2 / (2 * a * a * b) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont : ContinuousOn (fun s : ℝ => (b - s) / (s * s * s)) (Icc a b) :=
    (continuousOn_const.sub continuousOn_id).div
      ((continuousOn_id.mul continuousOn_id).mul continuousOn_id)
      (fun s hs => by
        have hp : 0 < s := lt_of_lt_of_le ha hs.1
        positivity)
  have hderiv : ∀ x ∈ uIcc a b,
      HasDerivAt (fun s : ℝ => -b / (2 * s ^ 2) + 1 / s) ((b - x) / (x * x * x)) x := by
    intro x hx
    rw [uIcc_of_le hab] at hx
    have hx_ne : x ≠ 0 := ne_of_gt (lt_of_lt_of_le ha hx.1)
    have hsq : HasDerivAt (fun s : ℝ => s ^ 2) (2 * x) x := by
      simpa using hasDerivAt_pow 2 x
    have h1 : HasDerivAt (fun s : ℝ => (2 * s ^ 2 : ℝ)) (4 * x) x := by
      have := hsq.const_mul (2 : ℝ)
      rwa [show (2 : ℝ) * (2 * x) = 4 * x by ring] at this
    have h2x2 : (2 * x ^ 2 : ℝ) ≠ 0 := mul_ne_zero two_ne_zero (pow_ne_zero 2 hx_ne)
    have hq1 := (hasDerivAt_const x (-b)).div h1 h2x2
    have hq2 := (hasDerivAt_const x (1 : ℝ)).div (hasDerivAt_id x) hx_ne
    have hadd : HasDerivAt (fun s : ℝ => -b / (2 * s ^ 2) + 1 / s)
        ((0 * (2 * x ^ 2) - -b * (4 * x)) / (2 * x ^ 2) ^ 2 + (0 * x - 1 * 1) / x ^ 2) x :=
      hq1.add hq2
    have hval : (0 * (2 * x ^ 2) - -b * (4 * x)) / (2 * x ^ 2) ^ 2 +
        (0 * x - 1 * 1) / x ^ 2 = (b - x) / (x * x * x) := by
      field_simp [hx_ne]; ring
    rwa [hval] at hadd
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable_of_Icc hab)]
  field_simp; ring

private lemma buchstab_max_propagate {ω : ℝ → ℝ} (hω : IsBuchstab ω) {a M : ℝ}
    (ha : 1 ≤ a) (hbase : ∀ u ∈ Icc a (a + 1), ω u ≤ M) :
    ∀ u : ℝ, a ≤ u → ω u ≤ M := by
  have hstep : ∀ n : ℕ, ∀ u ∈ Icc a (a + 1 + n), ω u ≤ M := by
    intro n
    induction n with
    | zero => intro u hu; exact hbase u (by simpa using hu)
    | succ n ih =>
      intro u hu
      by_cases hle : u ≤ a + 1 + n
      · exact ih u ⟨hu.1, hle⟩
      · push Not at hle
        set b : ℝ := a + 1 + n
        have hn_nn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
        have hb2 : 2 ≤ b := by dsimp only [b]; linarith
        have hbu : b ≤ u := le_of_lt hle
        have heq := buchstab_integral_eq hω hb2 hbu
        have hwb : ω b ≤ M := ih b ⟨by dsimp only [b]; linarith, le_refl b⟩
        have hcont_sub : ContinuousOn ω (Icc (b - 1) (u - 1)) :=
          hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
        have hint_le : ∫ s in (b - 1)..(u - 1), ω s ≤ (u - b) * M := by
          have h1 : ∫ s in (b - 1)..(u - 1), ω s ≤ ∫ _ in (b - 1)..(u - 1), M := by
            apply intervalIntegral.integral_mono_on (by linarith)
              (hcont_sub.intervalIntegrable_of_Icc (by linarith))
              intervalIntegrable_const
            intro s hs
            exact ih s ⟨by dsimp only [b] at hs; linarith [hs.1],
              by dsimp only [b]; push_cast at hu; linarith [hs.2, hu.2]⟩
          rw [intervalIntegral.integral_const, smul_eq_mul] at h1
          linarith
        have hu_pos : 0 < u := by linarith
        have hmul : u * ω u ≤ u * M := by nlinarith
        exact le_of_mul_le_mul_left hmul hu_pos
  intro u hu
  exact hstep (Nat.ceil (u - a)) u ⟨hu, by linarith [Nat.le_ceil (u - a)]⟩

private lemma affine_div_le_of_endpoints {a b u c va M : ℝ} (hab : a < b)
    (hau : a ≤ u) (hub : u ≤ b)
    (h1 : va ≤ c * a) (h2 : va + (b - a) * M ≤ c * b) :
    va + (u - a) * M ≤ c * u := by
  have hba : 0 < b - a := sub_pos.mpr hab
  have hlam0 : 0 ≤ (u - a) / (b - a) := div_nonneg (sub_nonneg.mpr hau) (le_of_lt hba)
  have hlam1 : 0 ≤ (b - u) / (b - a) := div_nonneg (sub_nonneg.mpr hub) (le_of_lt hba)
  have hcomb : ((b - u) / (b - a)) * va + ((u - a) / (b - a)) * (va + (b - a) * M)
      ≤ ((b - u) / (b - a)) * (c * a) + ((u - a) / (b - a)) * (c * b) := by
    nlinarith
  have hlhs : ((b - u) / (b - a)) * va + ((u - a) / (b - a)) * (va + (b - a) * M)
      = va + (u - a) * M := by field_simp; ring
  have hrhs : ((b - u) / (b - a)) * (c * a) + ((u - a) / (b - a)) * (c * b)
      = c * u := by field_simp; ring
  linarith

private def tk (k : Nat) : ℝ := 1 + (k : ℝ) / 256

private lemma buchstab_table_sound_aux {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    (gV gU : ℕ → ℕ)
    (hV256 : S_scale ≤ gV 256)
    (hall : ∀ k < 1024, checkBuchstabStepWith gV gU k = true) :
    (∀ k ≤ 1024, tk k * ω (tk k) ≤ (gV k : ℝ) / S_scale) ∧
    (∀ k < 1024, ∀ u ∈ Icc (tk k) (tk (k + 1)), ω u ≤ (gU k : ℝ) / S_scale) := by
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hmain : ∀ m : ℕ, m ≤ 1024 →
      (∀ k ≤ m, tk k * ω (tk k) ≤ (gV k : ℝ) / S_scale) ∧
      (∀ k < m, ∀ u ∈ Icc (tk k) (tk (k + 1)), ω u ≤ (gU k : ℝ) / S_scale) := by
    intro m
    induction m with
    | zero =>
      intro _
      refine ⟨?_, fun k hk => by omega⟩
      intro k hk
      have hk0 : k = 0 := by omega
      subst hk0
      have hstep0 := hall 0 (by omega)
      simp only [checkBuchstabStepWith, (by omega : 0 < 256), ↓reduceIte, Bool.and_eq_true,
        decide_eq_true_eq] at hstep0
      have htk0 : tk 0 = 1 := by unfold tk; norm_num
      rw [htk0, hω.2.1 1 (le_refl 1) (by norm_num)]
      have hV0 : (S_scale : ℝ) ≤ (gV 0 : ℝ) := by exact_mod_cast hstep0.1
      rw [le_div_iff₀ hSpos]; linarith
    | succ m ih =>
      intro hm
      have ⟨ihV, ihU⟩ := ih (by omega)
      have hstep := hall m (by omega)
      have hUm : ∀ u ∈ Icc (tk m) (tk (m + 1)), ω u ≤ (gU m : ℝ) / S_scale := by
        intro u hu
        by_cases hm1 : m < 256
        · simp only [checkBuchstabStepWith, hm1, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hstep
          have hu1 : 1 ≤ u := by unfold tk at hu; linarith [hu.1, (show (0 : ℝ) ≤ (m : ℝ) / 256 by positivity)]
          have hu2 : u ≤ 2 := by
            unfold tk at hu
            have hm_le : (m : ℝ) + 1 ≤ 256 := by exact_mod_cast (by omega : m + 1 ≤ 256)
            have htk_le : 1 + ((m + 1 : ℕ) : ℝ) / 256 ≤ 2 := by push_cast; linarith
            linarith [hu.2]
          rw [hω.2.1 u hu1 hu2]
          have htk_pos : 0 < tk m := by unfold tk; positivity
          have hinv : 1 / u ≤ 1 / tk m := one_div_le_one_div_of_le htk_pos hu.1
          have hnat : (S_scale : ℝ) * K_grid ≤ (gU m : ℝ) * ((K_grid : ℝ) + m) := by
            exact_mod_cast hstep.2
          have htk_eq : tk m = ((K_grid : ℝ) + m) / K_grid := by
            unfold tk K_grid; push_cast; ring
          have hKm_pos : (0 : ℝ) < (K_grid : ℝ) + m := by unfold K_grid; positivity
          have h2 : 1 / tk m ≤ (gU m : ℝ) / S_scale := by
            rw [htk_eq, one_div_div, div_le_div_iff₀ hKm_pos hSpos]; linarith
          linarith
        · by_cases hm2 : m < 512
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨_, _⟩, hU1⟩, hU2⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk; have : (256 : ℝ) ≤ m := by exact_mod_cast (by omega : 256 ≤ m)
              linarith
            have heq := buchstab_integral_eq hω htm2 hu.1
            have hVm := ihV m (le_refl m)
            have htm_sub_pos : (0 : ℝ) < tk m - 1 := by linarith
            have hint_le : ∫ s in (tk m - 1)..(u - 1), ω s ≤ (u - tk m) * (1 / (tk m - 1)) := by
              have hcont_w : ContinuousOn ω (Icc (tk m - 1) (u - 1)) :=
                hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
              have h1 : ∫ s in (tk m - 1)..(u - 1), ω s ≤
                  ∫ _ in (tk m - 1)..(u - 1), (1 / (tk m - 1) : ℝ) := by
                apply intervalIntegral.integral_mono_on (by linarith [hu.1])
                  (hcont_w.intervalIntegrable_of_Icc (by linarith [hu.1]))
                  intervalIntegrable_const
                intro s hs
                have hs1 : 1 ≤ s := by linarith [hs.1]
                have hs2 : s ≤ 2 := by
                  unfold tk at hu
                  have : (m : ℝ) + 1 ≤ 512 := by exact_mod_cast (by omega : m + 1 ≤ 512)
                  have : u ≤ 3 := by push_cast at hu; linarith [hu.2]
                  linarith [hs.2]
                rw [hω.2.1 s hs1 hs2]
                exact one_div_le_one_div_of_le htm_sub_pos hs.1
              rw [intervalIntegral.integral_const, smul_eq_mul] at h1; linarith
            have huw_le : u * ω u ≤ (gV m : ℝ) / S_scale + (u - tk m) * (1 / (tk m - 1)) := by linarith
            have htm_lt : tk m < tk (m + 1) := by unfold tk; push_cast; linarith
            have htm_pos : 0 < tk m := by linarith
            have hU1r : (256 : ℝ) * gV m ≤ (gU m : ℝ) * (256 + (m : ℝ)) := by
              have : (K_grid : ℝ) * gV m ≤ (gU m : ℝ) * ((K_grid : ℝ) + m) := by exact_mod_cast hU1
              unfold K_grid at this; norm_num at this; linarith
            have hU2r : (256 : ℝ) * ((m : ℝ) * gV m + S_scale) ≤
                (m : ℝ) * (256 + (m : ℝ) + 1) * gU m := by
              have : (K_grid : ℝ) * ((m : ℝ) * gV m + S_scale) ≤
                  (m : ℝ) * ((K_grid : ℝ) + m + 1) * gU m := by exact_mod_cast hU2
              unfold K_grid at this; norm_num at this; linarith
            have he1 : (gV m : ℝ) / S_scale ≤ ((gU m : ℝ) / S_scale) * tk m := by
              unfold tk; rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSpos]; linarith
            have he2 : (gV m : ℝ) / S_scale + (tk (m + 1) - tk m) * (1 / (tk m - 1)) ≤
                ((gU m : ℝ) / S_scale) * tk (m + 1) := by
              have hm_pos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
              have hdiff : tk (m + 1) - tk m = 1 / 256 := by unfold tk; push_cast; ring
              have hsub1 : tk m - 1 = (m : ℝ) / 256 := by unfold tk; ring
              rw [hdiff, hsub1]
              have hterm : (1 / 256 : ℝ) * (1 / ((m : ℝ) / 256)) = 1 / m := by field_simp
              rw [hterm]
              unfold tk; push_cast; rw [div_mul_eq_mul_div]
              have hS_ne : (S_scale : ℝ) ≠ 0 := ne_of_gt hSpos
              have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
              rw [div_add_div _ _ hS_ne hm_ne, div_le_div_iff₀ (mul_pos hSpos hm_pos) hSpos]
              nlinarith
            have hlin := affine_div_le_of_endpoints htm_lt hu.1 hu.2 he1 he2
            have hu_pos : 0 < u := lt_of_lt_of_le htm_pos hu.1
            exact le_of_mul_le_mul_left (by nlinarith) hu_pos
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨⟨hVle, hVstep⟩, hU1⟩, hU2⟩, _⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk; have : (512 : ℝ) ≤ m := by exact_mod_cast (by omega : 512 ≤ m)
              linarith
            have heq := buchstab_integral_eq hω htm2 hu.1
            have hVm := ihV m (le_refl m)
            have htm_sub : tk m - 1 = tk (m - 256) := by
              unfold tk; have hm256 : 256 ≤ m := by omega
              have hcast : ((m - 256 : ℕ) : ℝ) = (m : ℝ) - 256 := by rw [Nat.cast_sub hm256, Nat.cast_ofNat]
              rw [hcast]; ring
            have htm1_sub : tk (m + 1) - 1 = tk (m - 256 + 1) := by
              unfold tk; have hm256 : 256 ≤ m := by omega
              have hcast : ((m - 256 : ℕ) : ℝ) = (m : ℝ) - 256 := by rw [Nat.cast_sub hm256, Nat.cast_ofNat]
              push_cast; rw [hcast]; ring
            have hint_le : ∫ s in (tk m - 1)..(u - 1), ω s ≤
                (u - tk m) * ((gU (m - 256) : ℝ) / S_scale) := by
              have hcont_w : ContinuousOn ω (Icc (tk m - 1) (u - 1)) :=
                hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
              have h1 : ∫ s in (tk m - 1)..(u - 1), ω s ≤
                  ∫ _ in (tk m - 1)..(u - 1), ((gU (m - 256) : ℝ) / S_scale) := by
                apply intervalIntegral.integral_mono_on (by linarith [hu.1])
                  (hcont_w.intervalIntegrable_of_Icc (by linarith [hu.1]))
                  intervalIntegrable_const
                intro s hs
                exact ihU (m - 256) (by omega) s ⟨by linarith [hs.1, htm_sub],
                  by linarith [hs.2, hu.2, htm1_sub]⟩
              rw [intervalIntegral.integral_const, smul_eq_mul] at h1; linarith
            have huw_le : u * ω u ≤
                (gV m : ℝ) / S_scale + (u - tk m) * ((gU (m - 256) : ℝ) / S_scale) := by linarith
            have htm_lt : tk m < tk (m + 1) := by unfold tk; push_cast; linarith
            have htm_pos : 0 < tk m := by linarith
            have hU1r : (256 : ℝ) * gV m ≤ (gU m : ℝ) * (256 + (m : ℝ)) := by
              have : (K_grid : ℝ) * gV m ≤ (gU m : ℝ) * ((K_grid : ℝ) + m) := by exact_mod_cast hU1
              unfold K_grid at this; norm_num at this; linarith
            have hU2r : (256 : ℝ) * gV (m + 1) ≤ (gU m : ℝ) * (256 + (m : ℝ) + 1) := by
              have : (K_grid : ℝ) * gV (m + 1) ≤ (gU m : ℝ) * ((K_grid : ℝ) + m + 1) := by exact_mod_cast hU2
              unfold K_grid at this; norm_num at this; linarith
            have hVstepr : (gU (m - 256) : ℝ) ≤ (256 : ℝ) * ((gV (m + 1) : ℝ) - gV m) := by
              have h1 : (gU (m - 256) : ℝ) ≤ (K_grid : ℝ) * ((gV (m + 1) - gV m : ℕ) : ℝ) := by
                exact_mod_cast hVstep
              rw [Nat.cast_sub hVle] at h1; unfold K_grid at h1; norm_num at h1; linarith
            have he1 : (gV m : ℝ) / S_scale ≤ ((gU m : ℝ) / S_scale) * tk m := by
              unfold tk; rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSpos]; linarith
            have he2 : (gV m : ℝ) / S_scale + (tk (m + 1) - tk m) * ((gU (m - 256) : ℝ) / S_scale) ≤
                ((gU m : ℝ) / S_scale) * tk (m + 1) := by
              have hdiff : tk (m + 1) - tk m = 1 / 256 := by unfold tk; push_cast; ring
              rw [hdiff]; unfold tk; push_cast
              have h1 : (gV m : ℝ) / S_scale + 1 / 256 * ((gU (m - 256) : ℝ) / S_scale) ≤
                  (gV (m + 1) : ℝ) / S_scale := by
                rw [← mul_div_assoc, ← add_div, div_le_div_iff_of_pos_right hSpos]; linarith
              have h2 : (gV (m + 1) : ℝ) / S_scale ≤
                  (gU m : ℝ) / S_scale * (1 + ((m : ℝ) + 1) / 256) := by
                rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSpos]; linarith
              linarith
            have hlin := affine_div_le_of_endpoints htm_lt hu.1 hu.2 he1 he2
            have hu_pos : 0 < u := lt_of_lt_of_le htm_pos hu.1
            exact le_of_mul_le_mul_left (by nlinarith) hu_pos
      have hVm1 : tk (m + 1) * ω (tk (m + 1)) ≤ (gV (m + 1) : ℝ) / S_scale := by
        by_cases hm1 : m < 256
        · have htk_le2 : tk (m + 1) ≤ 2 := by
            unfold tk; have : (m : ℝ) + 1 ≤ 256 := by exact_mod_cast (by omega : m + 1 ≤ 256)
            push_cast; linarith
          have htk_ge1 : 1 ≤ tk (m + 1) := by unfold tk; linarith [Nat.cast_nonneg (α := ℝ) (m + 1)]
          rw [hω.2.1 (tk (m + 1)) htk_ge1 htk_le2]
          have htk_ne : tk (m + 1) ≠ 0 := ne_of_gt (by linarith)
          rw [mul_one_div_cancel htk_ne]
          have hVge : S_scale ≤ gV (m + 1) := by
            by_cases hm255 : m + 1 < 256
            · have hs := hall (m + 1) (by omega)
              simp only [checkBuchstabStepWith, hm255, ↓reduceIte, Bool.and_eq_true,
                decide_eq_true_eq] at hs
              exact hs.1
            · have : m + 1 = 256 := by omega
              rw [this]; exact hV256
          have hVr : (S_scale : ℝ) ≤ gV (m + 1) := by exact_mod_cast hVge
          rw [le_div_iff₀ hSpos]; linarith
        · by_cases hm2 : m < 512
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨hVle, hVstep⟩, _⟩, _⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk; have : (256 : ℝ) ≤ m := by exact_mod_cast (by omega : 256 ≤ m)
              linarith
            have htm_le : tk m ≤ tk (m + 1) := by unfold tk; push_cast; linarith
            have heq := buchstab_integral_eq hω htm2 htm_le
            have hVm := ihV m (le_refl m)
            have hint_eq : ∫ s in (tk m - 1)..(tk (m + 1) - 1), ω s =
                ∫ s in (tk m - 1)..(tk (m + 1) - 1), (1 / s : ℝ) := by
              apply intervalIntegral.integral_congr
              intro s hs
              rw [uIcc_of_le (by linarith)] at hs
              have hs1 : 1 ≤ s := by linarith [hs.1]
              have hs2 : s ≤ 2 := by
                unfold tk at hs; have : (m : ℝ) + 1 ≤ 512 := by exact_mod_cast (by omega : m + 1 ≤ 512)
                push_cast at hs; linarith [hs.2]
              exact hω.2.1 s hs1 hs2
            have htrap := integral_inv_le_trapezoid (a := tk m - 1) (b := tk (m + 1) - 1)
              (by linarith) (by linarith)
            have hsub0 : tk m - 1 = (m : ℝ) / 256 := by unfold tk; ring
            have hsub1 : tk (m + 1) - 1 = ((m : ℝ) + 1) / 256 := by unfold tk; push_cast; ring
            have hm_pos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
            have htrap_simp : (tk (m + 1) - 1 - (tk m - 1)) / 2 *
                (1 / (tk m - 1) + 1 / (tk (m + 1) - 1)) =
                (2 * (m : ℝ) + 1) / (2 * (m : ℝ) * ((m : ℝ) + 1)) := by
              rw [hsub0, hsub1]; field_simp; ring
            have hVstepr : (S_scale : ℝ) * (2 * (m : ℝ) + 1) ≤
                2 * (m : ℝ) * ((m : ℝ) + 1) * ((gV (m + 1) : ℝ) - gV m) := by
              have h1 : (S_scale : ℝ) * (2 * (m : ℝ) + 1) ≤
                  2 * (m : ℝ) * ((m : ℝ) + 1) * ((gV (m + 1) - gV m : ℕ) : ℝ) := by
                exact_mod_cast hVstep
              rw [Nat.cast_sub hVle] at h1; exact h1
            have hstep_r : (2 * (m : ℝ) + 1) / (2 * (m : ℝ) * ((m : ℝ) + 1)) ≤
                ((gV (m + 1) : ℝ) - gV m) / S_scale := by
              rw [div_le_div_iff₀ (by positivity) hSpos]; linarith
            have hcomb : (gV m : ℝ) / S_scale + ((gV (m + 1) : ℝ) - gV m) / S_scale =
                (gV (m + 1) : ℝ) / S_scale := by ring
            linarith
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨⟨hVle, hVstep⟩, _⟩, _⟩, _⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk; have : (512 : ℝ) ≤ m := by exact_mod_cast (by omega : 512 ≤ m)
              linarith
            have htm_le : tk m ≤ tk (m + 1) := by unfold tk; push_cast; linarith
            have heq := buchstab_integral_eq hω htm2 htm_le
            have hVm := ihV m (le_refl m)
            have htm_sub : tk m - 1 = tk (m - 256) := by
              unfold tk; have hm256 : 256 ≤ m := by omega
              have hcast : ((m - 256 : ℕ) : ℝ) = (m : ℝ) - 256 := by rw [Nat.cast_sub hm256, Nat.cast_ofNat]
              rw [hcast]; ring
            have htm1_sub : tk (m + 1) - 1 = tk (m - 256 + 1) := by
              unfold tk; have hm256 : 256 ≤ m := by omega
              have hcast : ((m - 256 : ℕ) : ℝ) = (m : ℝ) - 256 := by rw [Nat.cast_sub hm256, Nat.cast_ofNat]
              push_cast; rw [hcast]; ring
            have hint_le : ∫ s in (tk m - 1)..(tk (m + 1) - 1), ω s ≤
                (1 / 256 : ℝ) * ((gU (m - 256) : ℝ) / S_scale) := by
              have hcont_w : ContinuousOn ω (Icc (tk m - 1) (tk (m + 1) - 1)) :=
                hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
              have h1 : ∫ s in (tk m - 1)..(tk (m + 1) - 1), ω s ≤
                  ∫ _ in (tk m - 1)..(tk (m + 1) - 1), ((gU (m - 256) : ℝ) / S_scale) := by
                apply intervalIntegral.integral_mono_on (by linarith)
                  (hcont_w.intervalIntegrable_of_Icc (by linarith))
                  intervalIntegrable_const
                intro s hs
                exact ihU (m - 256) (by omega) s ⟨by linarith [hs.1, htm_sub],
                  by linarith [hs.2, htm1_sub]⟩
              rw [intervalIntegral.integral_const, smul_eq_mul] at h1
              have hdiff : tk (m + 1) - 1 - (tk m - 1) = 1 / 256 := by unfold tk; push_cast; ring
              rw [hdiff] at h1; exact h1
            have hVstepr : (gU (m - 256) : ℝ) ≤ (256 : ℝ) * ((gV (m + 1) : ℝ) - gV m) := by
              have h1 : (gU (m - 256) : ℝ) ≤ (K_grid : ℝ) * ((gV (m + 1) - gV m : ℕ) : ℝ) := by
                exact_mod_cast hVstep
              rw [Nat.cast_sub hVle] at h1; unfold K_grid at h1; norm_num at h1; linarith
            have hstep_r : (1 / 256 : ℝ) * ((gU (m - 256) : ℝ) / S_scale) ≤
                ((gV (m + 1) : ℝ) - gV m) / S_scale := by
              rw [← mul_div_assoc, div_le_div_iff_of_pos_right hSpos]; linarith
            have hcomb : (gV m : ℝ) / S_scale + ((gV (m + 1) : ℝ) - gV m) / S_scale =
                (gV (m + 1) : ℝ) / S_scale := by ring
            linarith
      refine ⟨?_, ?_⟩
      · intro k hk
        by_cases hkm : k ≤ m
        · exact ihV k hkm
        · have : k = m + 1 := by omega
          subst this; exact hVm1
      · intro k hk
        by_cases hkm : k < m
        · exact ihU k hkm
        · have : k = m := by omega
          subst this; exact hUm
  exact hmain 1024 (le_refl 1024)

private lemma buchstab_table_sound {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    (∀ k ≤ 1024, tk k * ω (tk k) ≤ (getV k : ℝ) / S_scale) ∧
    (∀ k < 1024, ∀ u ∈ Icc (tk k) (tk (k + 1)), ω u ≤ (getU k : ℝ) / S_scale) :=
  buchstab_table_sound_aux hω getV getU validBuchstab_V256 (fun _ hk => validBuchstab_all hk)

private lemma buchstab_le_M4 {ω : ℝ → ℝ} (hω : IsBuchstab ω) {u : ℝ} (hu : 4 ≤ u) :
    ω u ≤ (M4_val : ℝ) / S_scale := by
  have hU := (buchstab_table_sound hω).2
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  apply buchstab_max_propagate hω (a := 4) (by norm_num) _ u hu
  intro x hx
  have hx_le5 : x ≤ 5 := by linarith [hx.2]
  by_cases hx5 : x = 5
  · subst hx5
    have hx_in : (5 : ℝ) ∈ Icc (tk 1023) (tk 1024) := by unfold tk; constructor <;> norm_num
    have h1 := hU 1023 (by omega) 5 hx_in
    have hle : (getU 1023 : ℝ) ≤ M4_val := by exact_mod_cast getU1023_le_M4
    exact le_trans h1 (div_le_div_of_nonneg_right hle (le_of_lt hSpos))
  · have hx_lt5 : x < 5 := lt_of_le_of_ne hx_le5 hx5
    set k : ℕ := Nat.floor ((x - 1) * 256)
    have hk_ge : 768 ≤ k := Nat.le_floor (by push_cast; linarith [hx.1])
    have hk_lt : k < 1024 := (Nat.floor_lt (by linarith [hx.1])).mpr (by push_cast; linarith)
    have hfl1 : (k : ℝ) ≤ (x - 1) * 256 := Nat.floor_le (by linarith [hx.1])
    have hfl2 : (x - 1) * 256 < (k : ℝ) + 1 := Nat.lt_floor_add_one _
    have hx_in : x ∈ Icc (tk k) (tk (k + 1)) := by unfold tk; push_cast; constructor <;> linarith
    have h1 := hU k hk_lt x hx_in
    have hst := validBuchstab_all hk_lt
    have hn1 : ¬ k < 256 := by omega
    have hn2 : ¬ k < 512 := by omega
    simp only [checkBuchstabStepWith, hn1, hn2, hk_ge, ↓reduceIte, Bool.and_eq_true,
      decide_eq_true_eq] at hst
    have hle : (getU k : ℝ) ≤ M4_val := by exact_mod_cast hst.2
    exact le_trans h1 (div_le_div_of_nonneg_right hle (le_of_lt hSpos))

private lemma getU_le_buchstabUB {k0 k1 k : ℕ} (h0 : k0 ≤ k) (h1 : k ≤ k1) (hk : k < 768) :
    getU k ≤ buchstabUB k0 k1 := by
  have hm0 : ∀ i j, i ≤ j → j ≤ 255 → getU j ≤ getU i := by
    intro i j hij hj
    exact mono_dec_le (f := getU) (a := 0) (b := 255) (fun t _ ht => monoU_0_spec ht) (Nat.zero_le i) hij hj
  have hm1 : ∀ i j, 256 ≤ i → i ≤ j → j ≤ 450 → getU i ≤ getU j := by
    intro i j hi hij hj
    exact mono_inc_le (f := getU) (a := 256) (b := 450) (fun t ht1 ht2 => monoU_1_spec ht1 ht2) hi hij hj
  have hm2 : ∀ i j, 450 ≤ i → i ≤ j → j ≤ 631 → getU j ≤ getU i := by
    intro i j hi hij hj
    exact mono_dec_le (f := getU) (a := 450) (b := 631) (fun t ht1 ht2 => monoU_2_spec ht1 ht2) hi hij hj
  have hm3 : ∀ i j, 631 ≤ i → i ≤ j → j ≤ 767 → getU i ≤ getU j := by
    intro i j hi hij hj
    exact mono_inc_le (f := getU) (a := 631) (b := 767) (fun t ht1 ht2 => monoU_3_spec ht1 ht2) hi hij hj
  unfold buchstabUB
  have hk0_lt : Nat.ble 768 k0 = false := by rw [ble_false_iff]; omega
  rw [hk0_lt]; dsimp only
  split
  · rename_i h; rw [Nat.ble_eq] at h; exact hm0 k0 k h0 (by omega)
  · split
    · rename_i ha hb; rw [Nat.ble_eq] at ha hb; exact hm1 k k1 (by omega) h1 (by omega)
    · split
      · rename_i ha hb; rw [Nat.ble_eq] at ha hb; exact hm2 k0 k (by omega) h0 (by omega)
      · split
        · rename_i ha hb; rw [Nat.ble_eq] at ha hb; exact hm3 k k1 (by omega) h1 (by omega)
        · exact getU_le_buchstabUB_fallback hm0 hm1 hm2 hm3 h0 h1 hk

private lemma M4_le_buchstabUB {k0 k1 : ℕ} (hk1 : 768 ≤ k1) :
    M4_val ≤ buchstabUB k0 k1 := by
  have hfb : M4_val ≤ buchstabUB_fallback k0 k1 := by
    unfold buchstabUB_fallback; dsimp only
    have h768 : Nat.ble 768 k1 = true := by rw [Nat.ble_eq]; omega
    rw [h768]; dsimp only
    exact le_trans (le_trans (le_trans (le_max2_right _ _) (le_max2_right _ _)) (le_max2_right _ _)) (le_max2_right _ _)
  unfold buchstabUB
  split
  · exact le_refl _
  · split
    · rename_i h; rw [Nat.ble_eq] at h; omega
    · split
      · rename_i _ h; rw [Nat.ble_eq] at h; omega
      · split
        · rename_i _ h; rw [Nat.ble_eq] at h; omega
        · split
          · rename_i _ h; rw [Nat.ble_eq] at h; omega
          · exact hfb

private lemma buchstab_le_buchstabUB {ω : ℝ → ℝ} (hω : IsBuchstab ω) {k0 k1 : ℕ}
    (hk01 : k0 ≤ k1) {u : ℝ} (hlo : tk k0 ≤ u) (hhi : u ≤ tk (k1 + 1)) :
    ω u ≤ (buchstabUB k0 k1 : ℝ) / S_scale := by
  have hU := (buchstab_table_sound hω).2
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  by_cases hu4 : 4 < u
  · have hk1_ge : 768 ≤ k1 := by
      unfold tk at hhi; push_cast at hhi
      have : (768 : ℝ) < (k1 : ℝ) + 1 := by linarith
      have : (768 : ℕ) < k1 + 1 := by exact_mod_cast this
      omega
    exact le_trans (buchstab_le_M4 hω (le_of_lt hu4))
      (div_le_div_of_nonneg_right (by exact_mod_cast M4_le_buchstabUB hk1_ge) (le_of_lt hSpos))
  · push Not at hu4
    by_cases hu4eq : u = 4
    · subst hu4eq
      by_cases hk0_ge : 768 ≤ k0
      · have hM : M4_val ≤ buchstabUB k0 k1 := by
          unfold buchstabUB; have : Nat.ble 768 k0 = true := by rw [Nat.ble_eq]; omega
          rw [this]
        exact le_trans (buchstab_le_M4 hω (le_refl 4))
          (div_le_div_of_nonneg_right (by exact_mod_cast hM) (le_of_lt hSpos))
      · have hk1_ge : 767 ≤ k1 := by
          unfold tk at hhi; push_cast at hhi
          have : (768 : ℝ) ≤ (k1 : ℝ) + 1 := by linarith
          have : (768 : ℕ) ≤ k1 + 1 := by exact_mod_cast this
          omega
        have hx_in : (4 : ℝ) ∈ Icc (tk 767) (tk 768) := by unfold tk; constructor <;> norm_num
        have h1 := hU 767 (by omega) 4 hx_in
        have h2 : getU 767 ≤ buchstabUB k0 k1 := getU_le_buchstabUB (by omega) hk1_ge (by omega)
        exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
    · have hu_lt4 : u < 4 := lt_of_le_of_ne hu4 hu4eq
      have hu1 : 1 ≤ u := by unfold tk at hlo; linarith [(show (0 : ℝ) ≤ (k0 : ℝ) / 256 by positivity)]
      by_cases heq : u = tk (k1 + 1)
      · have hk1_lt : k1 < 768 := by
          rw [heq] at hu_lt4; unfold tk at hu_lt4; push_cast at hu_lt4
          have : (k1 : ℝ) + 1 < 768 := by linarith
          have : k1 + 1 < 768 := by exact_mod_cast this
          omega
        have hx_in : u ∈ Icc (tk k1) (tk (k1 + 1)) := by
          rw [heq]; unfold tk; push_cast; constructor <;> linarith
        have h1 := hU k1 (by omega) u hx_in
        have h2 : getU k1 ≤ buchstabUB k0 k1 := getU_le_buchstabUB hk01 (le_refl k1) hk1_lt
        exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
      · have hu_lt : u < tk (k1 + 1) := lt_of_le_of_ne hhi heq
        set k : ℕ := Nat.floor ((u - 1) * 256)
        have hk0_le : k0 ≤ k := Nat.le_floor (by unfold tk at hlo; linarith)
        have hk_le1 : k ≤ k1 := by
          have hlt : (u - 1) * 256 < ((k1 + 1 : ℕ) : ℝ) := by unfold tk at hu_lt; push_cast at *; linarith
          have := (Nat.floor_lt (by linarith)).mpr hlt; omega
        have hk_lt : k < 768 := (Nat.floor_lt (by linarith)).mpr (by push_cast; linarith)
        have hx_in : u ∈ Icc (tk k) (tk (k + 1)) := by
          unfold tk; push_cast
          constructor <;> linarith [Nat.floor_le (a := (u - 1) * 256) (by linarith),
                                    Nat.lt_floor_add_one ((u - 1) * 256)]
        have h1 := hU k (by omega) u hx_in
        have h2 : getU k ≤ buchstabUB k0 k1 := getU_le_buchstabUB hk0_le hk_le1 hk_lt
        exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))

/-! ### Part 4: 2D Triangle Decomposition & 1D-`F(s)` Factorization -/

private lemma sumUpTo_eq_finset_sum (n : ℕ) (f : ℕ → ℕ) :
    (sumUpTo n f : ℝ) = ∑ i ∈ Finset.range n, (f i : ℝ) := by
  induction n with
  | zero => simp [sumUpTo]
  | succ n ih => simp only [sumUpTo, Finset.sum_range_succ, Nat.cast_add, ih]

private lemma sumRange_eq_finset_sum (lo len : ℕ) (f : ℕ → ℕ) :
    (sumRange lo len f : ℝ) = ∑ k ∈ Finset.Ico lo (lo + len), (f k : ℝ) := by
  unfold sumRange
  rw [sumUpTo_eq_finset_sum]
  symm
  refine Finset.sum_bij (fun k _ => k - lo) ?_ ?_ ?_ ?_
  · intro k hk; simp only [Finset.mem_Ico] at hk; simp only [Finset.mem_range]; omega
  · intro a ha b hb hab; simp only [Finset.mem_Ico] at ha hb; omega
  · intro t ht; simp only [Finset.mem_range] at ht
    exact ⟨lo + t, by simp only [Finset.mem_Ico]; omega, by omega⟩
  · intro k hk; simp only [Finset.mem_Ico] at hk; rw [Nat.add_sub_of_le hk.1]

private lemma sum_upper_tri {α : Type*} [AddCommMonoid α] (N : ℕ) (f : ℕ × ℕ → α) :
    ∑ c ∈ ((Finset.range N) ×ˢ (Finset.range N)).filter (fun p => p.1 ≤ p.2), f c =
      ∑ j ∈ Finset.range N, (f (j, j) + ∑ k ∈ Finset.Ico (j + 1) N, f (j, k)) := by
  rw [Finset.sum_filter, Finset.sum_product]
  apply Finset.sum_congr rfl; intro j hj
  simp only [Finset.mem_range] at hj
  rw [← Finset.sum_filter]
  have hfilt : (Finset.range N).filter (fun k => j ≤ k) = insert j (Finset.Ico (j + 1) N) := by
    ext k; simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_insert, Finset.mem_Ico]; omega
  rw [hfilt, Finset.sum_insert (by simp)]

private lemma setIntegral_union_le_of_nonneg {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {A B : Set α} {f : α → ℝ} (hA : MeasurableSet A) (hB : MeasurableSet B)
    (hnnB : ∀ x ∈ B, 0 ≤ f x) (hintA : IntegrableOn f A μ) (hintB : IntegrableOn f B μ) :
    ∫ x in A ∪ B, f x ∂μ ≤ (∫ x in A, f x ∂μ) + (∫ x in B, f x ∂μ) := by
  have hAB : A ∪ B = A ∪ (B \ A) := (Set.union_sdiff_self).symm
  rw [hAB, setIntegral_union disjoint_sdiff_self_right (hB.diff hA) hintA
    (hintB.mono_set Set.sdiff_subset)]
  have hle : ∫ x in B \ A, f x ∂μ ≤ ∫ x in B, f x ∂μ :=
    setIntegral_mono_set hintB
      (ae_restrict_of_forall_mem hB hnnB)
      (Filter.Eventually.of_forall Set.sdiff_subset)
  linarith

private lemma integrableOn_biUnion_finset {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {ι : Type*} [DecidableEq ι] (s : Finset ι) (A : ι → Set α) {f : α → ℝ}
    (hint : ∀ i ∈ s, IntegrableOn f (A i) μ) :
    IntegrableOn f (⋃ i ∈ s, A i) μ := by
  induction s using Finset.induction_on with
  | empty => simp [integrableOn_empty]
  | insert a s ha ih =>
    have hun : (⋃ i ∈ insert a s, A i) = A a ∪ ⋃ i ∈ s, A i := by ext x; simp
    rw [hun]
    exact (hint a (Finset.mem_insert_self a s)).union
      (ih (fun i hi => hint i (Finset.mem_insert_of_mem hi)))

private lemma setIntegral_le_sum_biUnion {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {ι : Type*} [DecidableEq ι] (s : Finset ι) (A : ι → Set α) (D : Set α) {f : α → ℝ}
    (hD : D ⊆ ⋃ i ∈ s, A i)
    (hmeas : ∀ i ∈ s, MeasurableSet (A i))
    (hnn : ∀ i ∈ s, ∀ x ∈ A i, 0 ≤ f x)
    (hint : ∀ i ∈ s, IntegrableOn f (A i) μ) :
    ∫ x in D, f x ∂μ ≤ ∑ i ∈ s, ∫ x in A i, f x ∂μ := by
  have hunion_meas : MeasurableSet (⋃ i ∈ s, A i) := Finset.measurableSet_biUnion s hmeas
  have hunion_nn : ∀ x ∈ ⋃ i ∈ s, A i, 0 ≤ f x := by
    intro x hx; simp only [mem_iUnion, exists_prop] at hx
    rcases hx with ⟨i, hi, hxi⟩; exact hnn i hi x hxi
  have hunion_int : IntegrableOn f (⋃ i ∈ s, A i) μ := integrableOn_biUnion_finset s A hint
  have hsub : ∫ x in D, f x ∂μ ≤ ∫ x in ⋃ i ∈ s, A i, f x ∂μ :=
    setIntegral_mono_set hunion_int
      (ae_restrict_of_forall_mem hunion_meas hunion_nn)
      (Filter.Eventually.of_forall hD)
  refine le_trans hsub ?_
  clear hD hunion_meas hunion_nn hunion_int hsub
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    have hun : (⋃ i ∈ insert a s, A i) = A a ∪ ⋃ i ∈ s, A i := by ext x; simp
    rw [hun, Finset.sum_insert ha]
    have hms : MeasurableSet (⋃ i ∈ s, A i) :=
      Finset.measurableSet_biUnion s (fun i hi => hmeas i (Finset.mem_insert_of_mem hi))
    have hnns : ∀ x ∈ ⋃ i ∈ s, A i, 0 ≤ f x := by
      intro x hx; simp only [mem_iUnion, exists_prop] at hx
      rcases hx with ⟨i, hi, hxi⟩; exact hnn i (Finset.mem_insert_of_mem hi) x hxi
    have hints : IntegrableOn f (⋃ i ∈ s, A i) μ :=
      integrableOn_biUnion_finset s A (fun i hi => hint i (Finset.mem_insert_of_mem hi))
    have h1 := setIntegral_union_le_of_nonneg
      (hmeas a (Finset.mem_insert_self a s)) hms hnns
      (hint a (Finset.mem_insert_self a s)) hints
    have h2 := ih
      (fun i hi => hmeas i (Finset.mem_insert_of_mem hi))
      (fun i hi => hnn i (Finset.mem_insert_of_mem hi))
      (fun i hi => hint i (Finset.mem_insert_of_mem hi))
    linarith

private lemma wInv_bound_den {D a b : ℕ} (hD : 0 < D) (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in ((a : ℝ) / D)..((b : ℝ) / D), (1 / t : ℝ) ≤ (wInv a b : ℝ) / W_scale := by
  have hDpos : (0 : ℝ) < D := by exact_mod_cast hD
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) / D ≤ (b : ℝ) / D :=
    div_le_div_of_nonneg_right (by exact_mod_cast hab) (le_of_lt hDpos)
  have htrap := integral_inv_le_trapezoid (div_pos har hDpos) habr
  have hsimp : ((b : ℝ) / D - (a : ℝ) / D) / 2 *
      (1 / ((a : ℝ) / D) + 1 / ((b : ℝ) / D)) =
      ((b : ℝ) * b - (a : ℝ) * a) / (2 * (a : ℝ) * b) := by field_simp; ring
  have h2ab_pos : 0 < 2 * a * b := Nat.mul_pos (Nat.mul_pos (by omega) ha) hb
  have hceil : W_scale * (b * b - a * a) ≤ (2 * a * b) * wInv a b := le_mul_ceilDiv h2ab_pos
  have hsub : ((b * b - a * a : ℕ) : ℝ) = (b : ℝ) * b - (a : ℝ) * a := by
    rw [Nat.cast_sub (Nat.mul_le_mul hab hab)]; push_cast; ring
  have hceilr : (W_scale : ℝ) * ((b : ℝ) * b - (a : ℝ) * a) ≤
      (2 * (a : ℝ) * b) * (wInv a b : ℝ) := by rw [← hsub]; exact_mod_cast hceil
  have hle : ((b : ℝ) * b - (a : ℝ) * a) / (2 * (a : ℝ) * b) ≤ (wInv a b : ℝ) / W_scale := by
    rw [div_le_div_iff₀ (by positivity) hWpos]; linarith
  linarith

private lemma wInvSqIn_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in ((a : ℝ) / D_in)..((b : ℝ) / D_in), (1 / (t * t) : ℝ) ≤ (wInvSqIn a b : ℝ) / W_scale := by
  have hDpos : (0 : ℝ) < D_in := by unfold D_in; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) / D_in ≤ (b : ℝ) / D_in :=
    div_le_div_of_nonneg_right (by exact_mod_cast hab) (le_of_lt hDpos)
  rw [integral_inv_sq_eq (div_pos har hDpos) habr]
  have hsimp : 1 / ((a : ℝ) / D_in) - 1 / ((b : ℝ) / D_in) =
      (D_in : ℝ) * ((b : ℝ) - a) / ((a : ℝ) * b) := by field_simp
  rw [hsimp]
  have hceil : W_scale * D_in * (b - a) ≤ (a * b) * wInvSqIn a b :=
    le_mul_ceilDiv (Nat.mul_pos ha hb)
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * D_in * ((b : ℝ) - a) ≤ (a : ℝ) * b * (wInvSqIn a b : ℝ) := by
    rw [← hsub]; exact_mod_cast hceil
  rw [div_le_div_iff₀ (by positivity) hWpos]; linarith

private def tri2 (a b : ℝ) : Set (ℝ × ℝ) :=
  {p | a ≤ p.1 ∧ p.1 ≤ p.2 ∧ p.2 ≤ b}

private lemma tri2_measurable (a b : ℝ) : MeasurableSet (tri2 a b) := by
  have heq : tri2 a b = {p : ℝ × ℝ | a ≤ p.1} ∩ ({p : ℝ × ℝ | p.1 ≤ p.2} ∩ {p : ℝ × ℝ | p.2 ≤ b}) := by
    ext p; simp [tri2]
  rw [heq]
  exact (measurableSet_le measurable_const measurable_fst).inter
    ((measurableSet_le measurable_fst measurable_snd).inter
     (measurableSet_le measurable_snd measurable_const))

private lemma tri2_compact (a b : ℝ) : IsCompact (tri2 a b) := by
  have hclosed : IsClosed (tri2 a b) := by
    have heq : tri2 a b = {p : ℝ × ℝ | a ≤ p.1} ∩ ({p : ℝ × ℝ | p.1 ≤ p.2} ∩ {p : ℝ × ℝ | p.2 ≤ b}) := by
      ext p; simp [tri2]
    rw [heq]
    exact (isClosed_le continuous_const continuous_fst).inter
      ((isClosed_le continuous_fst continuous_snd).inter
       (isClosed_le continuous_snd continuous_const))
  have hsub : tri2 a b ⊆ Icc a b ×ˢ Icc a b := fun p hp =>
    ⟨⟨hp.1, le_trans hp.2.1 hp.2.2⟩, ⟨le_trans hp.1 hp.2.1, hp.2.2⟩⟩
  exact (isCompact_Icc.prod isCompact_Icc).of_isClosed_subset hclosed hsub

private lemma tri2_weight_le {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ p in tri2 a b, (1 / (p.1 * p.1 * p.2) : ℝ) ≤ (b - a) ^ 2 / (2 * a * a * b) := by
  have hint1 : IntegrableOn (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.2) : ℝ)) (tri2 a b) volume := by
    apply ContinuousOn.integrableOn_compact (tri2_compact a b)
    refine continuousOn_const.div ((continuous_fst.mul continuous_fst).mul continuous_snd).continuousOn ?_
    intro p hp
    have h1 : 0 < p.1 := lt_of_lt_of_le ha hp.1
    have h2 : 0 < p.2 := lt_of_lt_of_le h1 hp.2.1
    positivity
  have hint2 : IntegrableOn (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.1) : ℝ)) (tri2 a b) volume := by
    apply ContinuousOn.integrableOn_compact (tri2_compact a b)
    refine continuousOn_const.div ((continuous_fst.mul continuous_fst).mul continuous_fst).continuousOn ?_
    intro p hp
    have h1 : 0 < p.1 := lt_of_lt_of_le ha hp.1
    positivity
  have hmono : ∫ p in tri2 a b, (1 / (p.1 * p.1 * p.2) : ℝ) ≤
      ∫ p in tri2 a b, (1 / (p.1 * p.1 * p.1) : ℝ) := by
    apply setIntegral_mono_on hint1 hint2 (tri2_measurable a b)
    intro p hp
    have h1 : 0 < p.1 := lt_of_lt_of_le ha hp.1
    have h2 : 0 < p.2 := lt_of_lt_of_le h1 hp.2.1
    exact one_div_le_one_div_of_le (by positivity) (by nlinarith [hp.2.1])
  have hsub : tri2 a b ⊆ Icc a b ×ˢ Icc a b := fun p hp =>
    ⟨⟨hp.1, le_trans hp.2.1 hp.2.2⟩, ⟨le_trans hp.1 hp.2.1, hp.2.2⟩⟩
  have hind : ∫ p in tri2 a b, (1 / (p.1 * p.1 * p.1) : ℝ) =
      ∫ p in Icc a b ×ˢ Icc a b, (tri2 a b).indicator (fun p : ℝ × ℝ => 1 / (p.1 * p.1 * p.1)) p := by
    rw [setIntegral_indicator (tri2_measurable a b), inter_eq_right.mpr hsub]
  have hint_ind : IntegrableOn ((tri2 a b).indicator (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.1) : ℝ)))
      (Icc a b ×ˢ Icc a b) volume := by
    rw [integrableOn_indicator_iff (tri2_measurable a b), inter_eq_left.mpr hsub]
    exact hint2
  rw [hind, show (volume : Measure (ℝ × ℝ)) = volume.prod volume from rfl,
      setIntegral_prod _ hint_ind] at hmono
  have hinner : ∀ x1 ∈ Icc a b,
      ∫ x2 in Icc a b, (tri2 a b).indicator (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.1) : ℝ)) (x1, x2) =
        (b - x1) / (x1 * x1 * x1) := by
    intro x1 hx1
    have hset : (fun x2 : ℝ => (tri2 a b).indicator (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.1) : ℝ)) (x1, x2)) =
        (Icc x1 b).indicator (fun _ => (1 / (x1 * x1 * x1) : ℝ)) := by
      funext x2
      by_cases h : x1 ≤ x2 ∧ x2 ≤ b
      · have h1 : (x1, x2) ∈ tri2 a b := ⟨hx1.1, h.1, h.2⟩
        have h2 : x2 ∈ Icc x1 b := h
        simp [Set.indicator_of_mem h1, Set.indicator_of_mem h2]
      · have h1 : (x1, x2) ∉ tri2 a b := fun hm => h ⟨hm.2.1, hm.2.2⟩
        have h2 : x2 ∉ Icc x1 b := h
        simp [Set.indicator_of_notMem h1, Set.indicator_of_notMem h2]
    have hsub2 : Icc x1 b ⊆ Icc a b := fun x2 hx2 => ⟨le_trans hx1.1 hx2.1, hx2.2⟩
    rw [hset, setIntegral_indicator measurableSet_Icc,
        inter_eq_right.mpr hsub2,
        MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hx1.2,
        intervalIntegral.integral_const, smul_eq_mul]
    ring
  have heq_int : (∫ x1 in Icc a b,
      ∫ x2 in Icc a b, (tri2 a b).indicator (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.1) : ℝ)) (x1, x2)) =
      ∫ x1 in a..b, ((b - x1) / (x1 * x1 * x1) : ℝ) := by
    rw [setIntegral_congr_fun measurableSet_Icc hinner,
        MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab]
  rw [heq_int, integral_sub_div_cube_eq ha hab] at hmono
  exact hmono

private lemma wDiagIn_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ p in tri2 ((a : ℝ) / D_in) ((b : ℝ) / D_in), (1 / (p.1 * p.1 * p.2) : ℝ) ≤
      (wDiagIn a b : ℝ) / ((W_scale : ℝ) * W_scale) := by
  have hDpos : (0 : ℝ) < D_in := by unfold D_in; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) / D_in ≤ (b : ℝ) / D_in :=
    div_le_div_of_nonneg_right (by exact_mod_cast hab) (le_of_lt hDpos)
  have htri := tri2_weight_le (div_pos har hDpos) habr
  have hsimp : ((b : ℝ) / D_in - (a : ℝ) / D_in) ^ 2 / (2 * ((a : ℝ) / D_in) * ((a : ℝ) / D_in) * ((b : ℝ) / D_in)) =
      (D_in : ℝ) * ((b : ℝ) - a) * ((b : ℝ) - a) / (2 * (a : ℝ) * a * b) := by field_simp
  have hden_pos : 0 < 2 * a * a * b := Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (by omega) ha) ha) hb
  have hceil : W_scale * W_scale * D_in * (b - a) * (b - a) ≤ (2 * a * a * b) * wDiagIn a b :=
    le_mul_ceilDiv hden_pos
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * W_scale * D_in * ((b : ℝ) - a) * ((b : ℝ) - a) ≤
      (2 * (a : ℝ) * a * b) * (wDiagIn a b : ℝ) := by
    have h1 : ((W_scale * W_scale * D_in * (b - a) * (b - a) : ℕ) : ℝ) ≤
        ((2 * a * a * b * wDiagIn a b : ℕ) : ℝ) := by exact_mod_cast hceil
    push_cast [hsub] at h1
    exact h1
  have hle : (D_in : ℝ) * ((b : ℝ) - a) * ((b : ℝ) - a) / (2 * (a : ℝ) * a * b) ≤
      (wDiagIn a b : ℝ) / ((W_scale : ℝ) * W_scale) := by
    rw [div_le_div_iff₀ (by positivity) (mul_pos hWpos hWpos)]
    nlinarith
  linarith

private lemma rect2_weight_eq {a1 b1 a2 b2 : ℝ} (h1 : a1 ≤ b1) (h2 : a2 ≤ b2) :
    ∫ p in Icc a1 b1 ×ˢ Icc a2 b2, (1 / (p.1 * p.1 * p.2) : ℝ) =
      (∫ t in a1..b1, (1 / (t * t) : ℝ)) * (∫ t in a2..b2, (1 / t : ℝ)) := by
  have hfun : (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.2) : ℝ)) =
      (fun p : ℝ × ℝ => (1 / (p.1 * p.1)) * (1 / p.2)) := by
    funext p; ring
  rw [hfun, show (volume : Measure (ℝ × ℝ)) = volume.prod volume from rfl,
      MeasureTheory.setIntegral_prod_mul (f := fun t : ℝ => (1 / (t * t) : ℝ)) (g := fun t : ℝ => (1 / t : ℝ))]
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h1,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h2]

private def F_fn (ω : ℝ → ℝ) (s : ℝ) : ℝ :=
  ∫ p in tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in),
    ω ((s - p.1 - p.2) / p.1) / (p.1 * p.1 * p.2)

private lemma nat_grid_step_le {A B N hh i : ℕ} (hAB : A ≤ B) (hNh : N * hh = B - A) (hi : i < N) :
    A + i * hh + hh ≤ B := by
  have h1 : (i + 1) * hh ≤ N * hh := Nat.mul_le_mul_right hh hi
  have h2 : i * hh + hh = (i + 1) * hh := by ring
  omega

private lemma nat_grid_step_pos {A B N hh : ℕ} (hAB : A < B) (hNh : N * hh = B - A) : 0 < hh := by
  by_contra h
  have h0 : hh = 0 := by omega
  rw [h0, Nat.mul_zero] at hNh
  omega

private lemma cover1d_nat {D A B N hh : ℕ} (hD : 0 < D) (hN : 0 < N) (hhh : 0 < hh)
    (hNh : N * hh = B - A) (hAB : A ≤ B) {x : ℝ}
    (hxlo : (A : ℝ) / D ≤ x) (hxhi : x ≤ (B : ℝ) / D) :
    ∃ i < N, ((A + i * hh : ℕ) : ℝ) / D ≤ x ∧ x ≤ ((A + i * hh + hh : ℕ) : ℝ) / D := by
  have hDpos : (0 : ℝ) < D := by exact_mod_cast hD
  by_cases htop : x = (B : ℝ) / D
  · refine ⟨N - 1, by omega, ?_, ?_⟩
    · rw [htop]; apply div_le_div_of_nonneg_right _ (le_of_lt hDpos)
      have : (N - 1) * hh ≤ N * hh := Nat.mul_le_mul_right hh (by omega)
      exact_mod_cast (by omega : A + (N - 1) * hh ≤ B)
    · rw [htop]; apply div_le_div_of_nonneg_right _ (le_of_lt hDpos)
      have h1 : (N - 1) * hh + hh = N * hh := by
        cases N with | zero => omega | succ m => simp [Nat.succ_mul]
      exact_mod_cast (by omega : B ≤ A + (N - 1) * hh + hh)
  · have hxlt : x < (B : ℝ) / D := lt_of_le_of_ne hxhi htop
    set i : ℕ := Nat.floor ((x * D - A) / hh)
    have hhh_r : (0 : ℝ) < hh := by exact_mod_cast hhh
    have hnonneg : 0 ≤ (x * D - A) / hh := by
      apply div_nonneg _ (le_of_lt hhh_r)
      have := (div_le_iff₀ hDpos).mp hxlo; linarith
    have hi_lt : i < N := by
      apply (Nat.floor_lt hnonneg).mpr
      rw [div_lt_iff₀ hhh_r]
      have h1 : x * D < B := (lt_div_iff₀ hDpos).mp hxlt
      have h2 : (N : ℝ) * hh = (B : ℝ) - A := by rw [← Nat.cast_sub hAB]; exact_mod_cast hNh
      linarith
    refine ⟨i, hi_lt, ?_, ?_⟩
    · have hfl := Nat.floor_le hnonneg
      rw [le_div_iff₀ hhh_r] at hfl; rw [div_le_iff₀ hDpos]; push_cast; linarith
    · have hfl := Nat.lt_floor_add_one ((x * D - A) / hh)
      rw [div_lt_iff₀ hhh_r] at hfl; rw [le_div_iff₀ hDpos]; push_cast; linarith

private lemma inner2d_integrableOn {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {s : ℝ} (hs : (206 * 1656 : ℝ) / D_in ≤ s)
    {E : Set (ℝ × ℝ)} (hE : IsCompact E)
    (hsub : E ⊆ Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
                Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in)) :
    IntegrableOn (fun p : ℝ × ℝ => ω ((s - p.1 - p.2) / p.1) / (p.1 * p.1 * p.2)) E volume := by
  apply ContinuousOn.integrableOn_compact hE
  have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
  have hBsum : 3 * ((B1_num : ℝ) / D_in) ≤ (206 * 1656 : ℝ) / D_in := by
    unfold B1_num D_in; norm_num
  have hp_ok : ∀ p ∈ E, 0 < p.1 ∧ 0 < p.2 ∧ 1 ≤ (s - p.1 - p.2) / p.1 := by
    intro p hp
    have hm := hsub hp
    have h1p : 0 < p.1 := lt_of_lt_of_le hA1 hm.1.1
    have h2p : 0 < p.2 := lt_of_lt_of_le hA1 hm.2.1
    refine ⟨h1p, h2p, ?_⟩
    rw [le_div_iff₀ h1p]
    linarith [hm.1.2, hm.2.2]
  have harg : ContinuousOn (fun p : ℝ × ℝ => (s - p.1 - p.2) / p.1) E :=
    ((continuousOn_const.sub continuous_fst.continuousOn).sub continuous_snd.continuousOn).div
      continuous_fst.continuousOn (fun p hp => ne_of_gt (hp_ok p hp).1)
  have hnum : ContinuousOn (fun p : ℝ × ℝ => ω ((s - p.1 - p.2) / p.1)) E :=
    hω.1.comp harg (fun p hp => (hp_ok p hp).2.2)
  have hden : ContinuousOn (fun p : ℝ × ℝ => p.1 * p.1 * p.2) E :=
    ((continuous_fst.mul continuous_fst).mul continuous_snd).continuousOn
  exact hnum.div hden (fun p hp => by rcases hp_ok p hp with ⟨h1, h2, _⟩; positivity)

private lemma F_fn_bound_of_sum {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    (ub : ℕ → ℕ → ℕ)
    (hub : ∀ k0 k1 : ℕ, k0 ≤ k1 → ∀ u : ℝ, tk k0 ≤ u → u ≤ tk (k1 + 1) → ω u ≤ (ub k0 k1 : ℝ) / S_scale)
    {m N12 : ℕ} (hN : 0 < N12) (hd : N12 ∣ (B1_num - A1_num))
    {s : ℝ}
    (hs_lo : (((206 + m) * 1656 : ℕ) : ℝ) / D_in ≤ s)
    (hs_hi : s ≤ (((207 + m) * 1656 : ℕ) : ℝ) / D_in) :
    F_fn ω s ≤ (F_sumWith ub m N12 : ℝ) / ((S_scale : ℝ) * W_scale * W_scale) := by
  have hDpos : (0 : ℝ) < D_in := by unfold D_in; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  set sa := (206 + m) * 1656
  set sb := (207 + m) * 1656
  set h := (B1_num - A1_num) / N12
  have hh_eq : N12 * h = B1_num - A1_num := Nat.mul_div_cancel' hd
  have hAB : A1_num < B1_num := by unfold A1_num B1_num; omega
  have hh_pos : 0 < h := nat_grid_step_pos hAB hh_eq
  have hs_base : (206 * 1656 : ℝ) / D_in ≤ s := by
    have : (206 * 1656 : ℝ) / D_in ≤ (sa : ℝ) / D_in := by
      apply div_le_div_of_nonneg_right _ (le_of_lt hDpos)
      dsimp only [sa]; push_cast; linarith
    linarith
  let cell2 : ℕ × ℕ → Set (ℝ × ℝ) := fun ⟨j, k⟩ =>
    if j = k then
      tri2 (((A1_num + j * h : ℕ) : ℝ) / D_in) (((A1_num + j * h + h : ℕ) : ℝ) / D_in)
    else
      Icc (((A1_num + j * h : ℕ) : ℝ) / D_in) (((A1_num + j * h + h : ℕ) : ℝ) / D_in) ×ˢ
      Icc (((A1_num + k * h : ℕ) : ℝ) / D_in) (((A1_num + k * h + h : ℕ) : ℝ) / D_in)
  let idx2 : Finset (ℕ × ℕ) :=
    ((Finset.range N12) ×ˢ (Finset.range N12)).filter (fun p => p.1 ≤ p.2)
  have hcell_sub : ∀ c ∈ idx2,
      cell2 c ⊆ Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
                Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) := by
    rintro ⟨j, k⟩ hc p hp
    simp only [idx2, Finset.mem_filter, Finset.mem_product, Finset.mem_range] at hc
    rcases hc with ⟨⟨hj, hk⟩, _⟩
    have hj_le := nat_grid_step_le (le_of_lt hAB) hh_eq hj
    have hk_le := nat_grid_step_le (le_of_lt hAB) hh_eq hk
    dsimp only [cell2] at hp
    split_ifs at hp with hjk
    · refine ⟨⟨le_trans (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDpos)) hp.1,
               le_trans (le_trans hp.2.1 hp.2.2) (div_le_div_of_nonneg_right (by exact_mod_cast hj_le) (le_of_lt hDpos))⟩,
              ⟨le_trans (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDpos)) (le_trans hp.1 hp.2.1),
               le_trans hp.2.2 (div_le_div_of_nonneg_right (by exact_mod_cast hj_le) (le_of_lt hDpos))⟩⟩
    · refine ⟨⟨le_trans (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDpos)) hp.1.1,
               le_trans hp.1.2 (div_le_div_of_nonneg_right (by exact_mod_cast hj_le) (le_of_lt hDpos))⟩,
              ⟨le_trans (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDpos)) hp.2.1,
               le_trans hp.2.2 (div_le_div_of_nonneg_right (by exact_mod_cast hk_le) (le_of_lt hDpos))⟩⟩
  have hcover : tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ⊆ ⋃ c ∈ idx2, cell2 c := by
    intro p hp
    obtain ⟨j, hj, hj0, hj1⟩ := cover1d_nat (by unfold D_in; omega) hN hh_pos hh_eq (le_of_lt hAB)
      hp.1 (le_trans hp.2.1 hp.2.2)
    obtain ⟨k, hk, hk0, hk1⟩ := cover1d_nat (by unfold D_in; omega) hN hh_pos hh_eq (le_of_lt hAB)
      (le_trans hp.1 hp.2.1) hp.2.2
    -- Note: if k < j, then p.2 ≤ hi(k) ≤ lo(j) ≤ p.1 ≤ p.2, so p.1 = p.2 = lo(j) ∈ cell2 (j, j)!
    by_cases hjk : j ≤ k
    · simp only [mem_iUnion, exists_prop]
      refine ⟨(j, k), by simp [idx2, hj, hk, hjk], ?_⟩
      dsimp only [cell2]
      split_ifs with heq
      · subst heq; exact ⟨hj0, hp.2.1, hk1⟩
      · exact ⟨⟨hj0, hj1⟩, ⟨hk0, hk1⟩⟩
    · push Not at hjk
      have hkj1 : k + 1 ≤ j := by omega
      have hle_grid : A1_num + k * h + h ≤ A1_num + j * h := by
        have : (k + 1) * h ≤ j * h := Nat.mul_le_mul_right h hkj1
        have : k * h + h = (k + 1) * h := by ring
        omega
      have hp_eq : p.1 = p.2 := by
        have h1 : p.2 ≤ ((A1_num + j * h : ℕ) : ℝ) / D_in :=
          le_trans hk1 (div_le_div_of_nonneg_right (by exact_mod_cast hle_grid) (le_of_lt hDpos))
        linarith [hp.2.1]
      simp only [mem_iUnion, exists_prop]
      refine ⟨(j, j), by simp [idx2, hj], ?_⟩
      simp only [cell2, ↓reduceIte]
      exact ⟨hj0, hp.2.1, by rw [← hp_eq]; exact hj1⟩
  let g : ℝ × ℝ → ℝ := fun p => ω ((s - p.1 - p.2) / p.1) / (p.1 * p.1 * p.2)
  have hsum_le : F_fn ω s ≤ ∑ c ∈ idx2, ∫ p in cell2 c, g p := by
    unfold F_fn
    apply setIntegral_le_sum_biUnion idx2 cell2 _ hcover
    · rintro ⟨j, k⟩ _; dsimp only [cell2]; split_ifs
      · exact tri2_measurable _ _
      · exact measurableSet_Icc.prod measurableSet_Icc
    · rintro c hc p hp
      have hm := hcell_sub c hc hp
      have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
      have h1p : 0 < p.1 := lt_of_lt_of_le hA1 hm.1.1
      have h2p : 0 < p.2 := lt_of_lt_of_le hA1 hm.2.1
      exact div_nonneg (buchstab_nonneg hω hz _) (by positivity)
    · rintro ⟨j, k⟩ hc
      apply inner2d_integrableOn hω hs_base _ (hcell_sub (j, k) hc)
      dsimp only [cell2]; split_ifs
      · exact tri2_compact _ _
      · exact isCompact_Icc.prod isCompact_Icc
  -- Bound pointwise ω on any sub-region contained in [lo1/D, hi1/D] × [lo2/D, hi2/D]
  have hcell_omega : ∀ (lo1 hi1 lo2 hi2 : ℕ),
      0 < lo1 → lo1 ≤ hi1 → lo2 ≤ hi2 → 2 * hi1 + hi2 ≤ sa →
      ∀ p : ℝ × ℝ,
        ((lo1 : ℝ) / D_in ≤ p.1 ∧ p.1 ≤ (hi1 : ℝ) / D_in) →
        ((lo2 : ℝ) / D_in ≤ p.2 ∧ p.2 ≤ (hi2 : ℝ) / D_in) →
        ω ((s - p.1 - p.2) / p.1) ≤
          (ub (((sa - 2 * hi1 - hi2) * 256) / hi1) (((sb - 2 * lo1 - lo2) * 256) / lo1) : ℝ) / S_scale := by
    intro lo1 hi1 lo2 hi2 hlo1_pos hlo1_le hlo2_le hsum_le_sa p hp1 hp2
    have hhi1_pos : 0 < hi1 := lt_of_lt_of_le hlo1_pos hlo1_le
    have hsab : sa ≤ sb := by dsimp only [sa, sb]; omega
    set nlo := sa - 2 * hi1 - hi2
    set nhi := sb - 2 * lo1 - lo2
    set k0 := (nlo * 256) / hi1
    set k1 := (nhi * 256) / lo1
    have hk01 : k0 ≤ k1 := by
      have hnl : nlo ≤ nhi := by dsimp only [nlo, nhi]; omega
      exact le_trans (Nat.div_le_div_left hlo1_le hlo1_pos)
        (Nat.div_le_div_right (Nat.mul_le_mul_right 256 hnl))
    have hp1_pos : 0 < p.1 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo1_pos) hDpos) hp1.1
    apply hub k0 k1 hk01 ((s - p.1 - p.2) / p.1)
    · unfold tk
      have hdiv : (k0 : ℝ) * (hi1 : ℝ) ≤ (nlo : ℝ) * 256 := by
        exact_mod_cast Nat.div_mul_le_self (nlo * 256) hi1
      have hnlo_eq : (nlo : ℝ) = (sa : ℝ) - 2 * hi1 - hi2 := by
        have : nlo + (2 * hi1 + hi2) = sa := by dsimp only [nlo]; omega
        have hc : (nlo : ℝ) + (2 * (hi1 : ℝ) + hi2) = (sa : ℝ) := by exact_mod_cast this
        linarith
      have h1 : (sa : ℝ) - hi1 - hi2 ≤ (s - p.1 - p.2) * D_in := by
        have hs1 := (div_le_iff₀ hDpos).mp hs_lo
        have h1b := (le_div_iff₀ hDpos).mp hp1.2
        have h2b := (le_div_iff₀ hDpos).mp hp2.2
        linarith
      have h2 : p.1 * D_in ≤ hi1 := (le_div_iff₀ hDpos).mp hp1.2
      rw [le_div_iff₀ hp1_pos]
      have h3 : (1 + (k0 : ℝ) / 256) * (hi1 : ℝ) ≤ (sa : ℝ) - hi1 - hi2 := by linarith
      have h4 : (1 + (k0 : ℝ) / 256) * (p.1 * D_in) ≤ (1 + (k0 : ℝ) / 256) * hi1 := by
        have hnn : (0 : ℝ) ≤ 1 + (k0 : ℝ) / 256 :=
          add_nonneg zero_le_one (div_nonneg (Nat.cast_nonneg k0) (by norm_num))
        exact mul_le_mul_of_nonneg_left h2 hnn
      exact le_of_mul_le_mul_right (by linarith : (1 + (k0 : ℝ) / 256) * p.1 * D_in ≤ (s - p.1 - p.2) * D_in) hDpos
    · unfold tk
      have hdiv : (nhi : ℝ) * 256 < ((k1 : ℝ) + 1) * (lo1 : ℝ) := by
        have hlt : nhi * 256 < (k1 + 1) * lo1 := by
          dsimp only [k1]; rw [Nat.add_mul, Nat.one_mul]; exact Nat.lt_div_mul_add (a := nhi * 256) hlo1_pos
        have hc := (Nat.cast_lt (α := ℝ)).mpr hlt
        push_cast at hc; exact hc
      have hnhi_eq : (nhi : ℝ) = (sb : ℝ) - 2 * lo1 - lo2 := by
        have : nhi + (2 * lo1 + lo2) = sb := by dsimp only [nhi]; omega
        have hc : (nhi : ℝ) + (2 * (lo1 : ℝ) + lo2) = (sb : ℝ) := by exact_mod_cast this
        linarith
      have h1 : (s - p.1 - p.2) * D_in ≤ (sb : ℝ) - lo1 - lo2 := by
        have hs2 := (le_div_iff₀ hDpos).mp hs_hi
        have h1b := (div_le_iff₀ hDpos).mp hp1.1
        have h2b := (div_le_iff₀ hDpos).mp hp2.1
        linarith
      have h2 : (lo1 : ℝ) ≤ p.1 * D_in := (div_le_iff₀ hDpos).mp hp1.1
      rw [div_le_iff₀ hp1_pos]; push_cast
      have h3 : (sb : ℝ) - lo1 - lo2 ≤ (1 + ((k1 : ℝ) + 1) / 256) * (lo1 : ℝ) := by linarith
      have h4 : (1 + ((k1 : ℝ) + 1) / 256) * (lo1 : ℝ) ≤ (1 + ((k1 : ℝ) + 1) / 256) * (p.1 * D_in) := by
        have hnn : (0 : ℝ) ≤ 1 + ((k1 : ℝ) + 1) / 256 :=
          add_nonneg zero_le_one (div_nonneg (add_nonneg (Nat.cast_nonneg k1) zero_le_one) (by norm_num))
        exact mul_le_mul_of_nonneg_left h2 hnn
      exact le_of_mul_le_mul_right (by linarith : (s - p.1 - p.2) * D_in ≤ (1 + ((k1 : ℝ) + 1) / 256) * p.1 * D_in) hDpos
  have hB3_le_sa : 3 * B1_num ≤ sa := by dsimp only [sa]; unfold B1_num; omega
  have hsplit_idx : ∑ c ∈ idx2, ∫ p in cell2 c, g p =
      ∑ j ∈ Finset.range N12,
        ((∫ p in cell2 (j, j), g p) +
         ∑ k ∈ Finset.Ico (j + 1) N12, ∫ p in cell2 (j, k), g p) :=
    sum_upper_tri N12 (fun c => ∫ p in cell2 c, g p)
  rw [hsplit_idx] at hsum_le
  have hrow_le : ∀ j ∈ Finset.range N12,
      (∫ p in cell2 (j, j), g p) + ∑ k ∈ Finset.Ico (j + 1) N12, ∫ p in cell2 (j, k), g p ≤
      ((ub (((sa - 3 * (A1_num + j * h + h)) * 256) / (A1_num + j * h + h))
           (((sb - 3 * (A1_num + j * h)) * 256) / (A1_num + j * h)) : ℝ) *
        (wDiagIn (A1_num + j * h) (A1_num + j * h + h) : ℝ) +
       (wInvSqIn (A1_num + j * h) (A1_num + j * h + h) : ℝ) *
        ∑ k ∈ Finset.Ico (j + 1) N12,
          (ub (((sa - 2 * (A1_num + j * h + h) - (A1_num + k * h + h)) * 256) / (A1_num + j * h + h))
              (((sb - 2 * (A1_num + j * h) - (A1_num + k * h)) * 256) / (A1_num + j * h)) : ℝ) *
          (wInv (A1_num + k * h) (A1_num + k * h + h) : ℝ)) /
      ((S_scale : ℝ) * W_scale * W_scale) := by
    intro j hj
    simp only [Finset.mem_range] at hj
    set lo1 := A1_num + j * h
    set hi1 := lo1 + h
    have hhi1_le : hi1 ≤ B1_num := nat_grid_step_le (le_of_lt hAB) hh_eq hj
    have hlo1_le : lo1 ≤ hi1 := Nat.le_add_right _ _
    have hlo1_pos : 0 < lo1 := by dsimp only [lo1]; unfold A1_num; omega
    -- 1. Diagonal cell (j, j)
    have hdiag_le : ∫ p in cell2 (j, j), g p ≤
        ((ub (((sa - 3 * hi1) * 256) / hi1) (((sb - 3 * lo1) * 256) / lo1) : ℝ) *
          (wDiagIn lo1 hi1 : ℝ)) / ((S_scale : ℝ) * W_scale * W_scale) := by
      simp only [cell2, ↓reduceIte]
      set Md : ℝ := (ub (((sa - 3 * hi1) * 256) / hi1) (((sb - 3 * lo1) * 256) / lo1) : ℝ) / S_scale
      have hMd_nn : 0 ≤ Md := div_nonneg (Nat.cast_nonneg _) (le_of_lt hSpos)
      have hpt : ∀ p ∈ tri2 ((lo1 : ℝ) / D_in) ((hi1 : ℝ) / D_in),
          g p ≤ Md * (1 / (p.1 * p.1 * p.2)) := by
        intro p hp
        have h1p : 0 < p.1 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo1_pos) hDpos) hp.1
        have h2p : 0 < p.2 := lt_of_lt_of_le h1p hp.2.1
        have hw := hcell_omega lo1 hi1 lo1 hi1 hlo1_pos hlo1_le hlo1_le (by omega) p
          ⟨hp.1, le_trans hp.2.1 hp.2.2⟩ ⟨le_trans hp.1 hp.2.1, hp.2.2⟩
        have heq1 : sa - 2 * hi1 - hi1 = sa - 3 * hi1 := by
          rw [Nat.sub_sub, show 2 * hi1 + hi1 = 3 * hi1 by ring]
        have heq2 : sb - 2 * lo1 - lo1 = sb - 3 * lo1 := by
          rw [Nat.sub_sub, show 2 * lo1 + lo1 = 3 * lo1 by ring]
        rw [heq1, heq2] at hw
        dsimp only [g, Md]; rw [mul_one_div]
        exact div_le_div_of_nonneg_right hw (by positivity)
      have hsub_jj : tri2 ((lo1 : ℝ) / D_in) ((hi1 : ℝ) / D_in) ⊆
          Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
          Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) := by
        have := hcell_sub (j, j) (by simp only [idx2, Finset.mem_filter, Finset.mem_product, Finset.mem_range]; exact ⟨⟨hj, hj⟩, le_refl j⟩)
        simp only [cell2, ↓reduceIte] at this
        exact this
      have hint_g := inner2d_integrableOn hω hs_base (tri2_compact _ _) hsub_jj
      have hint_w : IntegrableOn (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.2) : ℝ))
          (tri2 ((lo1 : ℝ) / D_in) ((hi1 : ℝ) / D_in)) volume := by
        apply ContinuousOn.integrableOn_compact (tri2_compact _ _)
        refine continuousOn_const.div ((continuous_fst.mul continuous_fst).mul continuous_snd).continuousOn ?_
        intro p hp
        have h1p : 0 < p.1 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo1_pos) hDpos) hp.1
        have h2p : 0 < p.2 := lt_of_lt_of_le h1p hp.2.1
        positivity
      have hmono := setIntegral_mono_on hint_g (hint_w.const_mul Md) (tri2_measurable _ _) hpt
      rw [integral_const_mul] at hmono
      have hdw := wDiagIn_bound hlo1_pos hlo1_le
      refine le_trans hmono (le_trans (mul_le_mul_of_nonneg_left hdw hMd_nn) ?_)
      apply le_of_eq; dsimp only [Md]; ring
    -- 2. Off-diagonal cells k ∈ Ico (j + 1) N12
    have hoff_le : ∀ k ∈ Finset.Ico (j + 1) N12,
        ∫ p in cell2 (j, k), g p ≤
          ((wInvSqIn lo1 hi1 : ℝ) *
           ((ub (((sa - 2 * hi1 - (A1_num + k * h + h)) * 256) / hi1)
                (((sb - 2 * lo1 - (A1_num + k * h)) * 256) / lo1) : ℝ) *
            (wInv (A1_num + k * h) (A1_num + k * h + h) : ℝ))) /
          ((S_scale : ℝ) * W_scale * W_scale) := by
      intro k hk
      simp only [Finset.mem_Ico] at hk
      have hne : j ≠ k := by omega
      simp only [cell2, hne, ↓reduceIte]
      set lo2 := A1_num + k * h
      set hi2 := lo2 + h
      have hhi2_le : hi2 ≤ B1_num := nat_grid_step_le (le_of_lt hAB) hh_eq hk.2
      have hlo2_le : lo2 ≤ hi2 := Nat.le_add_right _ _
      have hlo2_pos : 0 < lo2 := by dsimp only [lo2]; unfold A1_num; omega
      set Mo : ℝ := (ub (((sa - 2 * hi1 - hi2) * 256) / hi1) (((sb - 2 * lo1 - lo2) * 256) / lo1) : ℝ) / S_scale
      have hMo_nn : 0 ≤ Mo := div_nonneg (Nat.cast_nonneg _) (le_of_lt hSpos)
      set R := Icc ((lo1 : ℝ) / D_in) ((hi1 : ℝ) / D_in) ×ˢ Icc ((lo2 : ℝ) / D_in) ((hi2 : ℝ) / D_in)
      have hpt : ∀ p ∈ R, g p ≤ Mo * (1 / (p.1 * p.1 * p.2)) := by
        intro p hp
        have h1p : 0 < p.1 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo1_pos) hDpos) hp.1.1
        have h2p : 0 < p.2 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo2_pos) hDpos) hp.2.1
        have hw := hcell_omega lo1 hi1 lo2 hi2 hlo1_pos hlo1_le hlo2_le (by omega) p hp.1 hp.2
        dsimp only [g, Mo]; rw [mul_one_div]
        exact div_le_div_of_nonneg_right hw (by positivity)
      have hsub_jk : R ⊆
          Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
          Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) := by
        have := hcell_sub (j, k) (by simp only [idx2, Finset.mem_filter, Finset.mem_product, Finset.mem_range]; exact ⟨⟨hj, hk.2⟩, by omega⟩)
        simp only [cell2, hne, ↓reduceIte] at this
        exact this
      have hint_g := inner2d_integrableOn hω hs_base (isCompact_Icc.prod isCompact_Icc) hsub_jk
      have hint_w : IntegrableOn (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.2) : ℝ)) R volume := by
        apply ContinuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
        refine continuousOn_const.div ((continuous_fst.mul continuous_fst).mul continuous_snd).continuousOn ?_
        intro p hp
        have h1p : 0 < p.1 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo1_pos) hDpos) hp.1.1
        have h2p : 0 < p.2 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo2_pos) hDpos) hp.2.1
        positivity
      have hmono := setIntegral_mono_on hint_g (hint_w.const_mul Mo)
        (measurableSet_Icc.prod measurableSet_Icc) hpt
      rw [integral_const_mul, rect2_weight_eq
        (div_le_div_of_nonneg_right (by exact_mod_cast hlo1_le) (le_of_lt hDpos))
        (div_le_div_of_nonneg_right (by exact_mod_cast hlo2_le) (le_of_lt hDpos))] at hmono
      have hw1 := wInvSqIn_bound hlo1_pos hlo1_le
      have hw2 := wInv_bound_den (D := D_in) (by unfold D_in; omega) hlo2_pos hlo2_le
      have hi2_nn : 0 ≤ ∫ t in ((lo2 : ℝ) / D_in)..((hi2 : ℝ) / D_in), (1 / t : ℝ) := by
        apply intervalIntegral.integral_nonneg
          (div_le_div_of_nonneg_right (by exact_mod_cast hlo2_le) (le_of_lt hDpos))
        intro t ht
        exact div_nonneg zero_le_one (le_of_lt (lt_of_lt_of_le (div_pos (by exact_mod_cast hlo2_pos) hDpos) ht.1))
      have hw1_nn : 0 ≤ (wInvSqIn lo1 hi1 : ℝ) / W_scale :=
        div_nonneg (Nat.cast_nonneg _) (le_of_lt hWpos)
      have hprod := mul_le_mul hw1 hw2 hi2_nn hw1_nn
      refine le_trans hmono (le_trans (mul_le_mul_of_nonneg_left hprod hMo_nn) ?_)
      apply le_of_eq; dsimp only [Mo]; ring
    have hoff_sum := Finset.sum_le_sum hoff_le
    rw [← Finset.sum_div, ← Finset.mul_sum] at hoff_sum
    have hcomb := add_le_add hdiag_le hoff_sum
    rw [← add_div] at hcomb
    exact hcomb
  refine le_trans hsum_le (le_trans (Finset.sum_le_sum hrow_le) ?_)
  rw [← Finset.sum_div]
  have hden_nn : 0 ≤ (S_scale : ℝ) * W_scale * W_scale :=
    mul_nonneg (mul_nonneg (le_of_lt hSpos) (le_of_lt hWpos)) (le_of_lt hWpos)
  apply div_le_div_of_nonneg_right _ hden_nn
  unfold F_sumWith
  dsimp only
  rw [sumUpTo_eq_finset_sum]
  apply le_of_eq
  apply Finset.sum_congr rfl; intro j hj
  simp only [Finset.mem_range] at hj
  rw [Nat.cast_add, Nat.cast_mul, Nat.cast_mul, sumRange_eq_finset_sum]
  have hico_eq : j + 1 + (N12 - (j + 1)) = N12 := by omega
  rw [hico_eq]
  congr 1
  congr 1
  apply Finset.sum_congr rfl; intro k _
  rw [Nat.cast_mul]

private lemma F_fn_le_getF {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {m : ℕ} (hm : m < 128) {s : ℝ}
    (hs_lo : (((206 + m) * 1656 : ℕ) : ℝ) / D_in ≤ s)
    (hs_hi : s ≤ (((207 + m) * 1656 : ℕ) : ℝ) / D_in) :
    F_fn ω s ≤ (getF m : ℝ) / S_scale := by
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hNpos : 0 < N12_of m := by
    unfold N12_of; split_ifs <;> omega
  have hd : N12_of m ∣ (B1_num - A1_num) := by
    unfold N12_of B1_num A1_num; split_ifs <;> decide
  have h1 := F_fn_bound_of_sum hω hz buchstabUB
    (fun _ _ hk01 _ hlo hhi => buchstab_le_buchstabUB hω hk01 hlo hhi)
    hNpos hd hs_lo hs_hi
  have hcert : (F_sumWith buchstabUB m (N12_of m) : ℝ) ≤
      (getF m : ℝ) * W_scale * W_scale := by
    have hc := checkF_all hm
    exact_mod_cast hc
  refine le_trans h1 ?_
  rw [div_le_div_iff₀ (mul_pos (mul_pos hSpos hWpos) hWpos) hSpos]
  nlinarith

private lemma F_fn_le_tail {ω : ℝ → ℝ} (hω : IsBuchstab ω) (_hz : ZeroBelowOne ω)
    {s : ℝ} (hs : ((334 * 1656 : ℕ) : ℝ) / D_in ≤ s) :
    F_fn ω s ≤ (F_tail_val : ℝ) / S_scale := by
  have hDpos : (0 : ℝ) < D_in := by unfold D_in; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hs_base : (206 * 1656 : ℝ) / D_in ≤ s := by
    have : (206 * 1656 : ℝ) / D_in ≤ ((334 * 1656 : ℕ) : ℝ) / D_in := by unfold D_in; norm_num
    linarith
  -- Everywhere on tri2 (A1/D_in) (B1/D_in), u = (s - p.1 - p.2) / p.1 ≥ 4!
  have hpt : ∀ p ∈ tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in),
      ω ((s - p.1 - p.2) / p.1) / (p.1 * p.1 * p.2) ≤
        ((M4_val : ℝ) / S_scale) * (1 / (p.1 * p.1 * p.2)) := by
    intro p hp
    have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
    have h1p : 0 < p.1 := lt_of_lt_of_le hA1 hp.1
    have h2p : 0 < p.2 := lt_of_lt_of_le h1p hp.2.1
    have h6B : 6 * ((B1_num : ℝ) / D_in) ≤ ((334 * 1656 : ℕ) : ℝ) / D_in := by
      unfold B1_num D_in; norm_num
    have hu4 : 4 ≤ (s - p.1 - p.2) / p.1 := by
      rw [le_div_iff₀ h1p]
      linarith [hp.2.1, hp.2.2]
    have hw := buchstab_le_M4 hω hu4
    rw [mul_one_div]
    exact div_le_div_of_nonneg_right hw (by positivity)
  have htri_sub : tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ⊆
      Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ×ˢ
      Icc ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) := fun p hp =>
    ⟨⟨hp.1, le_trans hp.2.1 hp.2.2⟩, ⟨le_trans hp.1 hp.2.1, hp.2.2⟩⟩
  have hint_g := inner2d_integrableOn hω hs_base (tri2_compact _ _) htri_sub
  have hint_w : IntegrableOn (fun p : ℝ × ℝ => (1 / (p.1 * p.1 * p.2) : ℝ))
      (tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in)) volume := by
    apply ContinuousOn.integrableOn_compact (tri2_compact _ _)
    refine continuousOn_const.div ((continuous_fst.mul continuous_fst).mul continuous_snd).continuousOn ?_
    intro p hp
    have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
    have h1p : 0 < p.1 := lt_of_lt_of_le hA1 hp.1
    have h2p : 0 < p.2 := lt_of_lt_of_le h1p hp.2.1
    positivity
  have hmono : F_fn ω s ≤ ((M4_val : ℝ) / S_scale) *
      ∫ p in tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in), (1 / (p.1 * p.1 * p.2) : ℝ) := by
    unfold F_fn; rw [← integral_const_mul]
    exact setIntegral_mono_on hint_g (hint_w.const_mul _) (tri2_measurable _ _) hpt
  -- Bound the weight integral over tri2 using N=8 decomposition (= W12_ub8 / W_scale^2)
  have hW12 : ∫ p in tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in), (1 / (p.1 * p.1 * p.2) : ℝ) ≤
      (W12_ub8 : ℝ) / ((W_scale : ℝ) * W_scale) := by
    -- Apply the same triangle covering with ω_const = 1, ub = 1? Even simpler: direct 8-panel cover!
    set h := (B1_num - A1_num) / 8
    have hh_eq : 8 * h = B1_num - A1_num := by unfold h A1_num B1_num; decide
    have hAB : A1_num < B1_num := by unfold A1_num B1_num; omega
    have hh_pos : 0 < h := nat_grid_step_pos hAB hh_eq
    let cell2 : ℕ × ℕ → Set (ℝ × ℝ) := fun ⟨j, k⟩ =>
      if j = k then
        tri2 (((A1_num + j * h : ℕ) : ℝ) / D_in) (((A1_num + j * h + h : ℕ) : ℝ) / D_in)
      else
        Icc (((A1_num + j * h : ℕ) : ℝ) / D_in) (((A1_num + j * h + h : ℕ) : ℝ) / D_in) ×ˢ
        Icc (((A1_num + k * h : ℕ) : ℝ) / D_in) (((A1_num + k * h + h : ℕ) : ℝ) / D_in)
    let idx2 : Finset (ℕ × ℕ) :=
      ((Finset.range 8) ×ˢ (Finset.range 8)).filter (fun p => p.1 ≤ p.2)
    have hcover : tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in) ⊆ ⋃ c ∈ idx2, cell2 c := by
      intro p hp
      obtain ⟨j, hj, hj0, hj1⟩ := cover1d_nat (by unfold D_in; omega) (by omega) hh_pos hh_eq (le_of_lt hAB)
        hp.1 (le_trans hp.2.1 hp.2.2)
      obtain ⟨k, hk, hk0, hk1⟩ := cover1d_nat (by unfold D_in; omega) (by omega) hh_pos hh_eq (le_of_lt hAB)
        (le_trans hp.1 hp.2.1) hp.2.2
      by_cases hjk : j ≤ k
      · simp only [mem_iUnion, exists_prop]
        refine ⟨(j, k), by simp [idx2, hj, hk, hjk], ?_⟩
        dsimp only [cell2]; split_ifs with heq
        · subst heq; exact ⟨hj0, hp.2.1, hk1⟩
        · exact ⟨⟨hj0, hj1⟩, ⟨hk0, hk1⟩⟩
      · push Not at hjk
        have hle_grid : A1_num + k * h + h ≤ A1_num + j * h := by
          have : (k + 1) * h ≤ j * h := Nat.mul_le_mul_right h (by omega)
          have : k * h + h = (k + 1) * h := by ring
          omega
        have hp_eq : p.1 = p.2 := by
          have h1 : p.2 ≤ ((A1_num + j * h : ℕ) : ℝ) / D_in :=
            le_trans hk1 (div_le_div_of_nonneg_right (by exact_mod_cast hle_grid) (le_of_lt hDpos))
          linarith [hp.2.1]
        simp only [mem_iUnion, exists_prop]
        refine ⟨(j, j), by simp [idx2, hj], ?_⟩
        simp only [cell2, ↓reduceIte]; exact ⟨hj0, hp.2.1, by rw [← hp_eq]; exact hj1⟩
    have hsum_le : ∫ p in tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in), (1 / (p.1 * p.1 * p.2) : ℝ) ≤
        ∑ c ∈ idx2, ∫ p in cell2 c, (1 / (p.1 * p.1 * p.2) : ℝ) := by
      apply setIntegral_le_sum_biUnion idx2 cell2 _ hcover
      · rintro ⟨j, k⟩ _; dsimp only [cell2]; split_ifs
        · exact tri2_measurable _ _
        · exact measurableSet_Icc.prod measurableSet_Icc
      · rintro ⟨j, k⟩ hc p hp
        have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
        dsimp only [cell2] at hp; split_ifs at hp
        · have h1p : 0 < p.1 := lt_of_lt_of_le (lt_of_lt_of_le hA1
            (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDpos))) hp.1
