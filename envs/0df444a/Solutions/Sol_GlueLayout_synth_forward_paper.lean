theorem solution (hK : 0 < K) (hℓ : 1 ≤ ℓ) (hy : y ^ (2 ^ ℓ) = -1) {xs : List R}
    (hlen : xs.length = AModel.vol (Synth.binSh (Synth.tgtL D ℓ K long).length))
    {v : List ℕ} (hv : AModel.Valid (Synth.binSh (Synth.tgtL D ℓ K long).length) v) :
    (Synth.procL y (GlueLayout.paperLayout D ℓ K long hK hℓ) ℓ (Synth.partAxes (Synth.al D ℓ long))
      (GlueLayout.paperSel D ℓ K long hK hℓ) ℓ xs).getD (AModel.encode (Synth.binSh (Synth.tgtL D ℓ K long).length) v) 0 =
      Synth.Fm y ℓ (Synth.al D ℓ long) (Synth.fn (GlueLayout.paperLayout D ℓ K long hK hℓ) xs)
        (Synth.revV (Synth.al D ℓ long) ((GlueLayout.paperLayout D ℓ K long hK hℓ).coord v)) :=
  GlueLayout.synth_forward_slots y (GlueLayout.paperArr D ℓ K long hK hℓ) hy (GlueLayout.al_le D ℓ long) hlen hv
