open NLogN
open NLogN.KFG
open IntMul RS AModel KIL KFD KFB Complex
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution (PT : NLogN.IStmt NLogN.HS Pp) (F : List NLogN.KFB.GI → List NLogN.KFB.GI) (Q : (Fin NLogN.HS → List ℤ) → Prop)
    (hQs : ∀ g v0 vP vR, Q g → Q (Function.update (Function.update (Function.update g 0 v0) NLogN.KFB.qP vP)
      NLogN.KFB.rP vR))
    (N off A q M Bb Z w w' cP : ℕ) (hN : N = A * M * q)
    (hA : NLogN.zsz (A : ℤ) ≤ Bb) (hq : NLogN.zsz (q : ℤ) ≤ Bb) (hM : NLogN.zsz (M : ℤ) ≤ Bb) (h2 : NLogN.zsz (2 : ℤ) ≤ Bb)
    (hA1 : 1 ≤ A) (hq1 : 1 ≤ q) (hM1 : 1 ≤ M)
    (hPT : ∀ (s' : NLogN.IState NLogN.HS) (g : Fin NLogN.HS → List ℤ) (ys : List NLogN.KFB.GI) (R : List ℤ),
      g 0 = NLogN.KFB.gflat ys ++ R → Q g → ys.length = N → NLogN.KFB.GB w ys →
      NLogN.IRuns I iprog PT (NLogN.KIL.encK s' g) (NLogN.KIL.encK s' (Function.update g 0 (NLogN.KFB.gflat (F ys) ++ R))) cP ∧
        (F ys).length = N ∧ NLogN.KFB.GB w' (F ys))
    (s : NLogN.IState NLogN.HS) (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ)
    (hlen : off + N ≤ zs.length) (h0 : f 0 = NLogN.KFB.gflat zs ++ l) (hQ : Q f) (hP : f NLogN.KFB.qP = [])
    (hR : f NLogN.KFB.rP = []) (hb : NLogN.KFB.GB w zs) (hZ : NLogN.zsz ((2 * off : ℕ) : ℤ) ≤ Z) :
    NLogN.IRuns I iprog (NLogN.KFG.childI off A q M PT) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat (NLogN.KFB.chL N off q M F zs) ++ l)))
      (NLogN.KFG.cChild w w' off A q M Bb Z + cP) := by
  set pre := zs.take off with hpre
  set seg := (zs.drop off).take N with hseg
  set rest := zs.drop (off + N) with hrest
  have hpl : pre.length = off := by rw [hpre, List.length_take]; exact Nat.min_eq_left (by omega)
  have hsl : seg.length = N := by
    rw [hseg, List.length_take, List.length_drop]; exact Nat.min_eq_left (by omega)
  have hsplit : zs = pre ++ (seg ++ rest) := by
    rw [hpre, hseg, hrest, ← List.drop_drop, List.take_append_drop, List.take_append_drop]
  have hb' := hb
  rw [hsplit] at hb'
  obtain ⟨hbp, hb2⟩ := NLogN.KFB.GB_append.1 hb'
  obtain ⟨hbs, hbr⟩ := NLogN.KFB.GB_append.1 hb2
  -- 1. park
  have K1 := NLogN.KFG.parkP_fsp s f pre (NLogN.KFB.gflat seg ++ (NLogN.KFB.gflat rest ++ l)) hbp
    (by rw [h0]; conv_lhs => rw [hsplit]
        simp only [NLogN.KFB.gflat_append, List.append_assoc]) hP hR Z (by rw [hpl]; exact hZ)
  rw [hpl] at K1
  have R1 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (NLogN.KFG.fok_parkP off) K1
  set f1 := Function.update (Function.update (Function.update f NLogN.KFB.rP [((2 * off : ℕ) : ℤ)]) 0
    (NLogN.KFB.gflat seg ++ (NLogN.KFB.gflat rest ++ l))) NLogN.KFB.qP (NLogN.KFB.gflat pre).reverse
  -- 2. forward move
  have hN' : seg.length = A * M * q := by rw [hsl, hN]
  have R2 := NLogN.KFG.fwd_runs (I := I) (iprog := iprog) A q M Bb w hA hq hM h2 hA1 hq1 hM1 s f1 seg
    (NLogN.KFB.gflat rest ++ l) hN' hbs (by simp +decide [f1])
  set f2 := Function.update f1 0 (NLogN.KFB.gflat (NLogN.KFB.mvL M q seg) ++ (NLogN.KFB.gflat rest ++ l))
  -- 3. the called program
  have hf2 : f2 = Function.update (Function.update (Function.update f 0
      (NLogN.KFB.gflat (NLogN.KFB.mvL M q seg) ++ (NLogN.KFB.gflat rest ++ l))) NLogN.KFB.qP (NLogN.KFB.gflat pre).reverse) NLogN.KFB.rP
      [((2 * off : ℕ) : ℤ)] := by
    funext x; simp only [f2, f1, Function.update_apply]
    by_cases x0 : x = 0
    · subst x0; simp +decide
    by_cases x1 : x = NLogN.KFB.qP
    · subst x1; simp +decide
    by_cases x2 : x = NLogN.KFB.rP
    · subst x2; simp +decide
    simp [x0, x1, x2]
  obtain ⟨R3, hFl, hFb⟩ := hPT s f2 (NLogN.KFB.mvL M q seg) (NLogN.KFB.gflat rest ++ l) (by simp [f2])
    (by rw [hf2]; exact hQs _ _ _ _ hQ) (by rw [NLogN.KFB.length_mvL, hsl]) (NLogN.KFB.GB_mvL _ _ _ hbs)
  set ys := F (NLogN.KFB.mvL M q seg)
  set f3 := Function.update f2 0 (NLogN.KFB.gflat ys ++ (NLogN.KFB.gflat rest ++ l))
  -- 4. backward move
  have R4 := NLogN.KFG.bwd_runs (I := I) (iprog := iprog) A q M Bb w' hA hq hM h2 hA1 hq1 hM1 s f3 ys
    (NLogN.KFB.gflat rest ++ l) (by rw [hFl, hN]; ring) hFb (by simp [f3])
  set f4 := Function.update f3 0 (NLogN.KFB.gflat (NLogN.KFB.mvL q M ys) ++ (NLogN.KFB.gflat rest ++ l))
  -- 5. unpark
  have K5 := NLogN.KFG.unparkP_fsp s f4 pre (NLogN.KFB.gflat (NLogN.KFB.mvL q M ys) ++ (NLogN.KFB.gflat rest ++ l)) hbp
    (by simp [f4]) (by simp +decide [f4, f3, f2, f1]) (by simp +decide [f4, f3, f2, f1, hpl])
    Z (by rw [hpl]; exact hZ)
  have R5 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) NLogN.KFG.fok_unparkP K5
  refine (R1.seq (R2.seq (R3.seq (R4.seq R5)))).mono' ?_ ?_
  · congr 1; funext x
    simp only [f4, f3, f2, f1, Function.update_apply]
    by_cases x0 : x = 0
    · subst x0; simp +decide [NLogN.KFB.chL, NLogN.KFB.gflat_append, ← hpre, ← hseg, ← hrest]; rfl
    by_cases x1 : x = NLogN.KFB.qP
    · subst x1; simp +decide [hP]
    by_cases x2 : x = NLogN.KFB.rP
    · subst x2; simp +decide [hR]
    simp [x0, x1, x2]
  · unfold NLogN.KFG.cChild
    nlinarith
end
