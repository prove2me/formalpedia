open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (s : NLogN.IState NLogN.NS) (n M Q k K : ℕ) (D : List ℤ)
    (RX LW L2 LH LY LM LQ LC LN LF : List NLogN.Item)
    (hn : 1 ≤ n) (hM1 : 1 ≤ M) (hM : M ≤ n) (hKQ : K * Q = n) (hk : k ≤ n)
    (hK : NLogN.zsz (K : ℤ) ≤ n) (hDl : D.length = K) (hD : NLogN.Canon (2 ^ n + 1) D)
    (hX : s.G NLogN.DX = NLogN.ints D ++ RX) (hW : s.G NLogN.W = .int (2 ^ n) :: LW)
    (h2 : s.G NLogN.W2 = .int (2 ^ (n - k)) :: L2) (hH : s.G NLogN.HB = .int (2 ^ (n - 1)) :: LH)
    (hY : s.G NLogN.CYS = .int 0 :: LY) (hRM : s.G NLogN.RMs = .int (2 ^ M) :: LM)
    (hRQ : s.G NLogN.RQ = .int (2 ^ Q) :: LQ) (hC : s.G NLogN.CC = .int K :: LC)
    (hN : s.G NLogN.RN = .int (2 ^ n) :: LN) (hF : s.G NLogN.RF = .int (2 ^ n + 1) :: LF) :
    NLogN.IRuns I iprog (.loop NLogN.CC (fun c => c != .zero) NLogN.postStep) s
      (((((s.upd NLogN.DX RX).upd NLogN.DG ((NLogN.ints (NLogN.carZ M (NLogN.liftL n k Q K D) 0).1).reverse ++ s.G NLogN.DG)).upd NLogN.CYS
        (.int (NLogN.carZ M (NLogN.liftL n k Q K D) 0).2 :: LY)).upd NLogN.W (.int 1 :: LW)).upd NLogN.CC (.int 0 :: LC))
      (K * (60000 * (n + 3) + 30) + 30) := by
  set f : ℕ → ℤ := fun i => NLogN.liftE n k ((K - i) * Q) (D.getD i 0) with hf
  let ss : ℕ → NLogN.IState NS := fun i =>
    ((((s.upd NLogN.DX (NLogN.ints (D.drop i) ++ RX)).upd NLogN.DG
      ((NLogN.ints (NLogN.carZ M ((List.range i).map f) 0).1).reverse ++ s.G NLogN.DG)).upd NLogN.CYS
        (.int (NLogN.carZ M ((List.range i).map f) 0).2 :: LY)).upd NLogN.W (.int (2 ^ ((K - i) * Q)) :: LW)).upd
          NLogN.CC (.int ((K - i : ℕ) : ℤ) :: LC)
  have h0 : ss 0 = s := by
    apply NLogN.IState.ext' <;> intros <;> simp [ss, NLogN.carZ, hX, hY, hC, hW, hKQ] <;> split_ifs <;> simp_all
  have hk' : ss K = (((((s.upd NLogN.DX RX).upd NLogN.DG ((NLogN.ints (NLogN.carZ M (NLogN.liftL n k Q K D) 0).1).reverse ++
      s.G NLogN.DG)).upd NLogN.CYS (.int (NLogN.carZ M (NLogN.liftL n k Q K D) 0).2 :: LY)).upd NLogN.W (.int 1 :: LW)).upd NLogN.CC
        (.int 0 :: LC)) := by
    have : D.drop K = [] := List.drop_eq_nil_of_le (by omega)
    simp [ss, this, NLogN.liftL, hf]
  have := NLogN.IRuns.loop' (I := I) (iprog := iprog) (i := NLogN.CC) (f := fun c => c != .zero)
    (p := NLogN.postStep) ss (60000 * (n + 3)) K
    (by intro i hi; simp +decide [ss]; omega)
    (by simp +decide [ss])
    (by
      intro i hi
      have hiQ : (K - (i + 1)) * Q + Q = (K - i) * Q := by
        rw [← Nat.succ_mul]; congr 1; omega
      have hle : (K - i) * Q ≤ n := by rw [← hKQ]; exact Nat.mul_le_mul_right _ (by omega)
      have hc : NLogN.zsz (((K - i : ℕ) : ℤ)) ≤ n := le_trans (NLogN.zsz_natCast_le (by omega)) hK
      have hdi : D.drop i = D.getD i 0 :: D.drop (i + 1) := by
        rw [List.drop_eq_getElem_cons (by omega), List.getD_eq_getElem _ _ (by omega)]
      have hdc := hD (D.getD i 0) (by rw [List.getD_eq_getElem _ _ (by omega)]; simp)
      have hcb := NLogN.carZ_bound n M hn hM1 ((List.range i).map f) 0 (by simp) (by
        intro e he
        simp only [List.mem_map] at he
        obtain ⟨j, _, rfl⟩ := he
        exact abs_le.mpr (NLogN.liftE_bound n k _ _ hn))
      have hst := NLogN.postStep_runs (I := I) (iprog := iprog) (ss i) n M ((K - (i + 1)) * Q) Q k
        (D.getD i 0) (NLogN.carZ M ((List.range i).map f) 0).2 ((K - i : ℕ) : ℤ)
        (NLogN.ints (D.drop (i + 1)) ++ RX) LW L2 LH LY LM LQ LC LN LF hn hM1 hM (by omega) hk
        hdc hcb hc
        (by simp +decide [ss, hdi]) (by simp +decide [ss, hiQ]) (by simp +decide [ss, h2])
        (by simp +decide [ss, hH]) (by simp +decide [ss]) (by simp +decide [ss, hRM])
        (by simp +decide [ss, hRQ]) (by simp +decide [ss]) (by simp +decide [ss, hN])
        (by simp +decide [ss, hF])
      refine hst.mono' ?_ le_rfl
      have e1 : (List.range (i + 1)).map f = (List.range i).map f ++ [f i] := by
        rw [List.range_succ, List.map_append]; rfl
      have e2 := NLogN.carZ_snoc M ((List.range i).map f) (f i) 0
      have e5 : (((K - i : ℕ) : ℤ) + -1) = ((K - (i + 1) : ℕ) : ℤ) := by omega
      have e6 : f i = NLogN.liftE n k ((K - (i + 1)) * Q + Q) (D.getD i 0) := by rw [hiQ]
      simp only [ss]
      rw [e1, e2, e5, ← e6]
      apply NLogN.IState.ext' <;> intros <;> simp [NLogN.ints, List.map_append] <;> split_ifs <;> simp_all)
  rw [h0, hk'] at this
  exact this
end
