    (h2 : s.G W2 = .int (2 ^ (n - k)) :: L2) (hH : s.G HB = .int (2 ^ (n - 1)) :: LH)
    (hY : s.G CY = .int 0 :: LY) (hRM : s.G RM = .int (2 ^ M) :: LM)
    (hRQ : s.G RQ = .int (2 ^ Q) :: LQ) (hC : s.G CC = .int K :: LC)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog (.loop CC (fun c => c != .zero) postStep) s
      (((((s.upd DX RX).upd DG ((ints (carZ M (liftL n k Q K D) 0).1).reverse ++ s.G DG)).upd CY
        (.int (carZ M (liftL n k Q K D) 0).2 :: LY)).upd W (.int 1 :: LW)).upd CC (.int 0 :: LC))
      (K * (60000 * (n + 3) + 30) + 30) := by
  set f : ℕ → ℤ := fun i => liftE n k ((K - i) * Q) (D.getD i 0) with hf
  let ss : ℕ → IState NS := fun i =>
    ((((s.upd DX (ints (D.drop i) ++ RX)).upd DG
      ((ints (carZ M ((List.range i).map f) 0).1).reverse ++ s.G DG)).upd CY
        (.int (carZ M ((List.range i).map f) 0).2 :: LY)).upd W (.int (2 ^ ((K - i) * Q)) :: LW)).upd
          CC (.int ((K - i : ℕ) : ℤ) :: LC)
  have h0 : ss 0 = s := by
    apply IState.ext' <;> intros <;> simp [ss, carZ, hX, hY, hC, hW, hKQ] <;> split_ifs <;> simp_all
  have hk' : ss K = (((((s.upd DX RX).upd DG ((ints (carZ M (liftL n k Q K D) 0).1).reverse ++
      s.G DG)).upd CY (.int (carZ M (liftL n k Q K D) 0).2 :: LY)).upd W (.int 1 :: LW)).upd CC
        (.int 0 :: LC)) := by
    have : D.drop K = [] := List.drop_eq_nil_of_le (by omega)
    simp [ss, this, liftL, hf]
  have := IRuns.loop' (I := I) (iprog := iprog) (i := CC) (f := fun c => c != .zero)
    (p := postStep) ss (60000 * (n + 3)) K
    (by intro i hi; simp +decide [ss]; omega)
    (by simp +decide [ss])
    (by
      intro i hi
      have hiQ : (K - (i + 1)) * Q + Q = (K - i) * Q := by
        rw [← Nat.succ_mul]; congr 1; omega
      have hle : (K - i) * Q ≤ n := by rw [← hKQ]; exact Nat.mul_le_mul_right _ (by omega)
      have hc : zsz (((K - i : ℕ) : ℤ)) ≤ n := le_trans (zsz_natCast_le (by omega)) hK
      have hdi : D.drop i = D.getD i 0 :: D.drop (i + 1) := by
        rw [List.drop_eq_getElem_cons (by omega), List.getD_eq_getElem _ _ (by omega)]
      have hdc := hD (D.getD i 0) (by rw [List.getD_eq_getElem _ _ (by omega)]; simp)
      have hcb := carZ_bound n M hn hM1 ((List.range i).map f) 0 (by simp) (by
        intro e he
        simp only [List.mem_map] at he
        obtain ⟨j, _, rfl⟩ := he
        exact abs_le.mpr (liftE_bound n k _ _ hn))
      have hst := postStep_runs (I := I) (iprog := iprog) (ss i) n M ((K - (i + 1)) * Q) Q k
        (D.getD i 0) (carZ M ((List.range i).map f) 0).2 ((K - i : ℕ) : ℤ)
        (ints (D.drop (i + 1)) ++ RX) LW L2 LH LY LM LQ LC LN LF hn hM1 hM (by omega) hk
        hdc hcb hc
        (by simp +decide [ss, hdi]) (by simp +decide [ss, hiQ]) (by simp +decide [ss, h2])
        (by simp +decide [ss, hH]) (by simp +decide [ss]) (by simp +decide [ss, hRM])
        (by simp +decide [ss, hRQ]) (by simp +decide [ss]) (by simp +decide [ss, hN])
        (by simp +decide [ss, hF])
      refine hst.mono' ?_ le_rfl
      have e1 : (List.range (i + 1)).map f = (List.range i).map f ++ [f i] := by
        rw [List.range_succ, List.map_append]; rfl
      have e2 := carZ_snoc M ((List.range i).map f) (f i) 0
      have e5 : (((K - i : ℕ) : ℤ) + -1) = ((K - (i + 1) : ℕ) : ℤ) := by omega
      have e6 : f i = liftE n k ((K - (i + 1)) * Q + Q) (D.getD i 0) := by rw [hiQ]
      simp only [ss]
      rw [e1, e2, e5, ← e6]
      apply IState.ext' <;> intros <;> simp [ints, List.map_append] <;> split_ifs <;> simp_all)
  rw [h0, hk'] at this
  exact this

end NLogN

end

section
open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (s : IState NS) (n M Q k : ℕ) (D : List ℤ)
    (RX LL L2 LH LM LQ LN LF : List Item)
    (hn : 1 ≤ n) (hM1 : 1 ≤ M) (hM : M ≤ n) (hKQ : 2 ^ k * Q = n) (hk : k + 1 ≤ n)
    (hDl : D.length = 2 ^ k) (hD : Canon (2 ^ n + 1) D)
    (hX : s.G DX = ints D ++ RX) (hDL : s.G DL = .int (2 ^ k) :: LL)
    (h2 : s.G W2 = .int (2 ^ (n - k)) :: L2) (hH : s.G HB = .int (2 ^ (n - 1)) :: LH)
    (hRM : s.G RM = .int (2 ^ M) :: LM) (hRQ : s.G RQ = .int (2 ^ Q) :: LQ)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog fmPost s
      (((s.upd DX RX).upd DG ((ints (carZ M (liftL n k Q (2 ^ k) D) 0).1).reverse ++ s.G DG)).upd
        CY (.int (carZ M (liftL n k Q (2 ^ k) D) 0).2 :: s.G CY))
      (2 ^ k * (60000 * (n + 3) + 30) + 2000 * (n + 3)) := by
  set K := 2 ^ k with hK
  have hzK : zsz (K : ℤ) ≤ n := by
    have : ((K : ℕ) : ℤ) = (2 : ℤ) ^ k := by rw [hK]; push_cast; rfl
    rw [this, zsz_two_pow]; omega
  have eK : ((2 : ℤ) ^ k) = ((K : ℕ) : ℤ) := by rw [hK]; push_cast; rfl
  set s1 := ((s.upd W (.int (2 ^ n) :: s.G W)).upd CY (.int 0 :: s.G CY)).upd CC
    (.int (K : ℤ) :: s.G CC) with hs1
  have h1 : IRuns I iprog (.seq (.op (.dup RN W)) (.seq (.op (.const CY 0)) (.op (.dup DL CC))))
      s s1 (1000 * (n + 2)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hN, hDL, eK, zsz_zero]
    refine ⟨by rw [hs1], ?_⟩
    have := dupCost_le (zsz ((2 : ℤ) ^ n)); have := dupCost_le (zsz ((K : ℕ) : ℤ))
    rw [zsz_two_pow] at *
    omega
  have h2' := postLoop_runs (I := I) (iprog := iprog) s1 n M Q k K D RX (s.G W) L2 LH (s.G CY) LM
    LQ (s.G CC) LN LF hn hM1 hM hKQ (by omega) hzK hDl hD (by simp +decide [s1, hX])
    (by simp +decide [s1]) (by simp +decide [s1, h2]) (by simp +decide [s1, hH])
    (by simp +decide [s1]) (by simp +decide [s1, hRM]) (by simp +decide [s1, hRQ])
    (by simp +decide [s1]) (by simp +decide [s1, hN]) (by simp +decide [s1, hF])
  have h3g : ∀ s' : IState NS, s'.G CC = .int 0 :: s.G CC → s'.G W = .int 1 :: s.G W →
      IRuns I iprog (.seq (.op (.drop CC)) (.op (.drop W))) s'
        ((s'.upd CC (s.G CC)).upd W (s.G W)) 10 := by
    intro s' hc hw
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hc, hw, zsz_zero, zsz_one]
  refine (IRuns.seq h1 (IRuns.seq h2' (h3g _ ?_ ?_))).mono' ?_ ?_
  · simp
  · simp +decide
  swap; · omega
  simp only [hs1]
  clear * -
  (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
end
