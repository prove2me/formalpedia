set_option maxHeartbeats 4000000
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII05
theorem solution {j Aq Ar : ℝ} {q r : ℝ → ℝ}
    (hqc : ContDiffOn ℝ 1 q UG) (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq)
    (hr : ContinuousOn r UG) (hrb : ∀ x ∈ KG, |r x| ≤ Ar) (hAr : 0 ≤ Ar) :
    -- the magnetic potential solves the actual equation and lies in `MagClass 3`
    (MagClass 3 (bfun j q) ∧ ∀ R ∈ Ioi (3:ℝ), Lmag (bfun j q) R = sfun j q (1 / R) / R ^ 3)
    -- the sharp value and derivative bounds hold on all of `I`
    ∧ (∀ R : ℝ, 3 < R → |R * bfun j q R| ≤ (3 * |j| + Aq) / 8)
    ∧ (∀ R : ℝ, 3 < R → |R ^ 2 * deriv (bfun j q) R| ≤ 3 * |j| + Aq)
    -- the rotation solves the actual angular-momentum equation and lies in `VClass 3`
    ∧ (VClass 3 (vfun j q r) ∧ ∀ R ∈ Ioi (3:ℝ), Dell j (bfun j q) (vfun j q r) R = r (1 / R) / R)
    -- the rotation bounds
    ∧ (∀ R : ℝ, 3 < R → |R ^ 3 * (vfun j q r R - j / R ^ 2)| ≤ (3 * |j| + Aq) / 4 + Ar / 3)
    ∧ (∀ R : ℝ, 3 < R → |R ^ 4 * (deriv (vfun j q r) R + 2 * j / R ^ 3)|
        ≤ 3 * (3 * |j| + Aq) / 4 + Ar)
    -- the four far-field limits
    ∧ Tendsto (fun R : ℝ => R * bfun j q R) atTop (𝓝 (sigmaB j q))
    ∧ Tendsto (fun R : ℝ => R ^ 2 * vfun j q r R) atTop (𝓝 j)
    ∧ Tendsto (fun R : ℝ => R ^ 3 * (vfun j q r R - j / R ^ 2)) atTop
        (𝓝 (2 * sigmaB j q - r 0 / 3))
    ∧ Tendsto (fun R : ℝ => R ^ 4 * (deriv (vfun j q r) R + 2 * j / R ^ 3)) atTop
        (𝓝 (r 0 - 6 * sigmaB j q)) := by
  have hM : MagClass 3 (bfun j q) ∧ ∀ R ∈ Ioi (3:ℝ), Lmag (bfun j q) R = sfun j q (1 / R) / R ^ 3 :=
    ⟨magClass_bfun (j := j) hqc hq hAq, fun R hR => Lmag_bfun hqc.continuousOn hR⟩
  have hval : ∀ R : ℝ, 3 < R → |R * bfun j q R| ≤ (3 * |j| + Aq) / 8 := by
    intro R hR
    have hR0 : (0:ℝ) < R := by linarith
    have h := bfun_abs_le_sharp (j := j) hqc hq hAq hR
    rw [abs_mul, abs_of_pos hR0]
    calc R * |bfun j q R| ≤ R * ((3 * |j| + Aq) / (8 * R)) :=
          mul_le_mul_of_nonneg_left h (le_of_lt hR0)
      _ = (3 * |j| + Aq) / 8 := by field_simp
  have hderiv : ∀ R : ℝ, 3 < R → |R ^ 2 * deriv (bfun j q) R| ≤ 3 * |j| + Aq :=
    fun R hR => bfun_deriv_abs_le_sharp (j := j) hqc hq hAq hR
  have hV : VClass 3 (vfun j q r) ∧
      ∀ R ∈ Ioi (3:ℝ), Dell j (bfun j q) (vfun j q r) R = r (1 / R) / R :=
    ⟨vClass_vfun hqc hq hAq hr hrb hAr, fun R hR => Dell_vfun hqc hq hAq hr hR⟩
  have hsh : ∀ R : ℝ, 3 < R → |R ^ 3 * (vfun j q r R - j / R ^ 2)| ≤ (3 * |j| + Aq) / 4 + Ar / 3 :=
    fun R hR => vfun_sub_j_abs_le (j := j) hqc hq hAq hr hrb hAr hR
  have hd4 : ∀ R : ℝ, 3 < R → |R ^ 4 * (deriv (vfun j q r) R + 2 * j / R ^ 3)|
      ≤ 3 * (3 * |j| + Aq) / 4 + Ar :=
    fun R hR => vfun_deriv_abs_le (j := j) hqc hq hAq hr hrb hAr hR
  exact ⟨hM, hval, hderiv, hV, hsh, hd4,
    tendsto_Rbfun hqc.continuousOn, tendsto_Rsq_vfun hqc hq hAq hr,
    tendsto_Rcu_vshift hqc hq hAq hr, tendsto_Rfour_vderiv hqc hq hAq hr⟩
