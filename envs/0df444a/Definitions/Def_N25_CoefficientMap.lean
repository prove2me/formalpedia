-- title:
--   Extension of coefficients for the modular function field
-- statement:
--   For fields $k⊂K$, the file defines the coefficient-extension homomorphism $$F_k→F_K$$ on the selected level-$25$ modular function fields by applying $k→K$ coefficientwise to Laurent series. It verifies at the definition level that the image remains in the field generated by integral modular-form ratios. This is the base-change map used to transport the modular units and their plane relation between coefficient fields.
-- source:
--   B. Mazur, Modular curves and the Eisenstein ideal, Publ. IHES 47 (1977); Lean formalization of the order-25 case for this mission. Modules in the MazurProof/Keystone/Tate families are adapted from anthropics/fermats-last-theorem (Apache-2.0) via the xiangyazi24/FLT fork.

import Definitions.Def_N25_Endgame
set_option autoImplicit false
noncomputable section
namespace N25.Endgame

private theorem coeffMap_mem (k K : Type*) [Field k] [Field K] [Algebra k K]
    (f : FBase k) :
    ModularCurve.coeffMap (algebraMap k K) (f : LaurentSeries k) ∈
      ModularCurve.qExpFunctionFieldC K Γ25 := by
  have hseries (p : PowerSeries ℤ) :
      ModularCurve.coeffMap (algebraMap k K) (ModularCurve.intSeriesC k p) =
        ModularCurve.intSeriesC K p := by
    ext n
    simp only [ModularCurve.intSeriesC, ModularCurve.coeffMap_coeff]
    rw [PowerSeries.coeff_coe, PowerSeries.coeff_coe]
    split_ifs <;> simp [PowerSeries.coeff_map, map_intCast]
  have hf : (f : LaurentSeries k) ∈
      IntermediateField.adjoin k (ModularCurve.intFormRatiosC k Γ25) := f.property
  generalize hfx : (f : LaurentSeries k) = x at hf ⊢
  clear hfx
  induction hf using IntermediateField.adjoin_induction with
  | mem z hz =>
    rcases hz with ⟨w, F, G, pf, pg, hF, hG, hg, rfl⟩
    rw [map_div₀, hseries, hseries]
    apply ModularCurve.intFormRatiosC_subset
    refine ⟨w, F, G, pf, pg, hF, hG, ?_, rfl⟩
    intro h
    apply hg
    apply (ModularCurve.coeffMap (algebraMap k K)).injective
    rw [hseries, h, map_zero]
  | algebraMap c =>
    rw [ModularCurve.algebraMap_laurentSeries_eq_single, ModularCurve.coeffMap_single,
      ← ModularCurve.algebraMap_laurentSeries_eq_single]
    exact IntermediateField.algebraMap_mem _ _
  | add z w _ _ hz hw =>
    rw [map_add]
    exact add_mem hz hw
  | mul z w _ _ hz hw =>
    rw [map_mul]
    exact mul_mem hz hw
  | inv z _ hz =>
    rw [map_inv₀]
    exact inv_mem hz

/-- Extension of the coefficient field on the selected modular function field. -/
noncomputable def FBaseCoeffMap25
    (k K : Type*) [Field k] [Field K] [Algebra k K] :
    FBase k →+* FBase K where
  toFun f := ⟨ModularCurve.coeffMap (algebraMap k K) f, coeffMap_mem k K f⟩
  map_zero' := Subtype.ext (map_zero _)
  map_one' := Subtype.ext (map_one _)
  map_add' f g := Subtype.ext (map_add _ (f : LaurentSeries k) (g : LaurentSeries k))
  map_mul' f g := Subtype.ext (map_mul _ (f : LaurentSeries k) (g : LaurentSeries k))

end N25.Endgame


