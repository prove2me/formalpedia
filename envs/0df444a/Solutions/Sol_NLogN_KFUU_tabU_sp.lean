    (by simp (config := {decide := true}) [t1, IState.upd_G, hSC]) zc
  have S4 := Sp.popI ((t1.upd NLogN.KIL.sSA LA).upd sSC LC) (i := sSM) (by decide) (a := (T.length : ℤ))
