lemma fullJetBox_mem (i : Fin 20) (col : Fin 23) : (fullJetBox i col).Mem (fullJetMatrix i col) := by
  have hh := (CI.mem_sum (fun j => CI.mem_mul (jetTable_mem_x (if col.val=22 then 0 else 1) i j)
    (columnTable_mem col j))).1
  by_cases hc : col.val=22
  · simpa [fullJetBox, fullJetMatrix, jet, damping, hc] using hh
  · simpa [fullJetBox, fullJetMatrix, jet, damping, hc] using hh

lemma fullJetRow5_calc (col : Fin 23) : fullJetBox 5 col = fullJetRow5 col := by
  revert col
  decide +kernel
lemma fullJetRow5_mem_x_oai (col : Fin 23) : (fullJetRow5 col).Mem (fullJetMatrix 5 col) := by
  rw [← fullJetRow5_calc]
  exact fullJetBox_mem 5 col
end AtomicTriangular.FiniteCertificate
end

