/-! ### piece ArA8a -/
section Piece_ArA8a


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA8a: a presentation of `A` centred at the point `χ`

`exists_surj_origin`: a finite type `K`-algebra `A` with a `K`-point `χ` is a quotient `π : K[x] → A` with
`χ ∘ π = constantCoeff`; then `ker χ = π(idealOfVars)` (`ker_eq_map_vars`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Origin

variable {K : Type u} [Field K] {A : Type u} [CommRing A] [Algebra K A]

theorem mem_idealOfVars_of_cc {n : ℕ} {p : MvPolynomial (Fin n) K} (hp : MvPolynomial.constantCoeff p = 0) :
    p ∈ MvPolynomial.idealOfVars (Fin n) K := by
  have h := (MvPolynomial.mem_pow_idealOfVars_iff' 1 p).mpr fun x hx => by
    have hx0 : x = 0 := (Finsupp.degree_eq_zero_iff x).mp (by omega)
    rw [hx0]
    exact hp
  rwa [pow_one] at h

theorem exists_surj_origin [Algebra.FiniteType K A] (χ : A →ₐ[K] K) :
    ∃ (n : ℕ) (π : MvPolynomial (Fin n) K →ₐ[K] A), Function.Surjective π ∧
      ∀ p, χ (π p) = MvPolynomial.constantCoeff p := by
  obtain ⟨n, π₀, hπ₀⟩ := (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := K) (S := A)).mp inferInstance
  let π : MvPolynomial (Fin n) K →ₐ[K] A := MvPolynomial.aeval fun i : Fin n => π₀ (MvPolynomial.X i) - algebraMap K A (χ (π₀ (MvPolynomial.X i)))
  let τ : MvPolynomial (Fin n) K →ₐ[K] MvPolynomial (Fin n) K :=
    MvPolynomial.aeval fun i => MvPolynomial.X i + MvPolynomial.C (χ (π₀ (MvPolynomial.X i)))
  have hτ : π.comp τ = π₀ := MvPolynomial.algHom_ext fun i => by
    simp [π, τ, MvPolynomial.aeval_X]
  have hχ : χ.comp π = MvPolynomial.aeval (fun _ => (0 : K)) := MvPolynomial.algHom_ext fun i => by
    simp [π]
  refine ⟨n, π, fun b => ?_, fun p => ?_⟩
  · obtain ⟨p, hp⟩ := hπ₀ b
    exact ⟨τ p, by rw [← AlgHom.comp_apply, hτ, hp]⟩
  · rw [← AlgHom.comp_apply, hχ, MvPolynomial.aeval_zero', Algebra.algebraMap_self, RingHom.id_apply]

theorem ker_eq_map_vars {n : ℕ} (χ : A →ₐ[K] K) (π : MvPolynomial (Fin n) K →ₐ[K] A) (hπ : Function.Surjective π)
    (hχ : ∀ p, χ (π p) = MvPolynomial.constantCoeff p) :
    RingHom.ker χ = Ideal.map π (MvPolynomial.idealOfVars (Fin n) K) := by
  apply le_antisymm
  · intro a ha
    obtain ⟨p, rfl⟩ := hπ a
    have hp : MvPolynomial.constantCoeff p = 0 := by rw [← hχ p]; exact RingHom.mem_ker.mp ha
    exact Ideal.mem_map_of_mem _ (mem_idealOfVars_of_cc hp)
  · rw [Ideal.map_le_iff_le_comap, MvPolynomial.idealOfVars, Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    show χ (π (MvPolynomial.X i)) = 0
    rw [hχ, MvPolynomial.constantCoeff_X]

end Origin

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA8a

/-! ### piece ArA8b -/
section Piece_ArA8b


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA8b: the completed presentation `π̂ : K[[x]] → Â`

For `π : K[x] →ₐ[K] A` with `χ ∘ π = constantCoeff`, `hat χ π hχ : K[[x]] →+* Â` (`Â = AdicCompletion (ker χ) A`)
is the lift of the levels `p ↦ π (truncTotal k p) mod (ker χ)^k`.
* `evalₐ_hat`, `hat_coe` (`π̂ ∘ coe = algebraMap ∘ π`), `hat_comp`, `evalOne_hat` (residue of `π̂ p`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Hat

variable {K : Type u} [Field K] {A : Type u} [CommRing A] [Algebra K A] {n : ℕ}
  (χ : A →ₐ[K] K) (π : MvPolynomial (Fin n) K →ₐ[K] A)
  (hχ : ∀ p, χ (π p) = MvPolynomial.constantCoeff p)

include hχ in
theorem map_vars_le_ker : Ideal.map π (MvPolynomial.idealOfVars (Fin n) K) ≤ RingHom.ker χ := by
  rw [Ideal.map_le_iff_le_comap, MvPolynomial.idealOfVars, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  show χ (π (MvPolynomial.X i)) = 0
  rw [hχ, MvPolynomial.constantCoeff_X]

include hχ in
theorem pow_vars_le (k : ℕ) : MvPolynomial.idealOfVars (Fin n) K ^ k ≤
    Ideal.comap (π : MvPolynomial (Fin n) K →+* A) (RingHom.ker χ ^ k) := by
  intro p hp
  have h1 : (π : MvPolynomial (Fin n) K →+* A) p ∈ Ideal.map π (MvPolynomial.idealOfVars (Fin n) K ^ k) :=
    Ideal.mem_map_of_mem _ hp
  rw [Ideal.map_pow] at h1
  exact Ideal.pow_right_mono (map_vars_le_ker χ π hχ) k h1

/-- Level `k` of `π̂`: truncate, apply `π`, reduce mod `(ker χ)^k`. -/
def hatLevel (k : ℕ) : MvPowerSeries (Fin n) K →+* A ⧸ RingHom.ker χ ^ k :=
  (Ideal.quotientMap (RingHom.ker χ ^ k) (π : MvPolynomial (Fin n) K →+* A) (pow_vars_le χ π hχ k)).comp
    (MvPowerSeries.truncTotalAlgHom (Fin n) K k).toRingHom

theorem hatLevel_apply (k : ℕ) (p : MvPowerSeries (Fin n) K) :
    hatLevel χ π hχ k p = Ideal.Quotient.mk _ (π (MvPowerSeries.truncTotal k p)) := by
  show Ideal.quotientMap (RingHom.ker χ ^ k) (π : MvPolynomial (Fin n) K →+* A) (pow_vars_le χ π hχ k)
    (Ideal.Quotient.mk (MvPolynomial.idealOfVars (Fin n) K ^ k) (MvPowerSeries.truncTotal k p)) = _
  exact Ideal.quotientMap_mk

theorem hatLevel_compat {m k : ℕ} (hle : m ≤ k) :
    (Ideal.Quotient.factorPow (RingHom.ker χ) hle).comp (hatLevel χ π hχ k) = hatLevel χ π hχ m := by
  refine RingHom.ext fun p => ?_
  rw [RingHom.comp_apply, hatLevel_apply, hatLevel_apply]
  simp only [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
  rw [Ideal.Quotient.eq, ← map_sub]
  exact pow_vars_le χ π hχ m (MvPowerSeries.truncTotal_sub_truncTotal_mem_pow_idealOfVars hle le_rfl p)

/-- **`π̂ : K[[x]] → Â`**, the completion of `π`. -/
def hat : MvPowerSeries (Fin n) K →+* AdicCompletion (RingHom.ker χ) A :=
  AdicCompletion.liftRingHom (RingHom.ker χ) (hatLevel χ π hχ) fun hle => hatLevel_compat χ π hχ hle

theorem evalₐ_hat (k : ℕ) (p : MvPowerSeries (Fin n) K) :
    AdicCompletion.evalₐ (RingHom.ker χ) k (hat χ π hχ p) =
      Ideal.Quotient.mk _ (π (MvPowerSeries.truncTotal k p)) := by
  rw [hat, AdicCompletion.evalₐ_liftRingHom, hatLevel_apply]

theorem truncTotal_coe_sub_mem (k : ℕ) (q : MvPolynomial (Fin n) K) :
    MvPowerSeries.truncTotal k (q : MvPowerSeries (Fin n) K) - q ∈ MvPolynomial.idealOfVars (Fin n) K ^ k :=
  (MvPolynomial.mem_pow_idealOfVars_iff' k _).mpr fun x hx => by
    rw [MvPolynomial.coeff_sub, MvPowerSeries.coeff_truncTotal _ hx, MvPolynomial.coeff_coe, sub_self]

theorem hat_coe (q : MvPolynomial (Fin n) K) :
    hat χ π hχ (q : MvPowerSeries (Fin n) K) = algebraMap A (AdicCompletion (RingHom.ker χ) A) (π q) := by
  refine AdicCompletion.ext_evalₐ fun k => ?_
  rw [evalₐ_hat, AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
    AdicCompletion.evalₐ_of, Ideal.Quotient.eq, ← map_sub]
  exact pow_vars_le χ π hχ k (truncTotal_coe_sub_mem k q)

theorem hat_comp : (hat χ π hχ).comp (algebraMap (MvPolynomial (Fin n) K) (MvPowerSeries (Fin n) K)) =
    (algebraMap A (AdicCompletion (RingHom.ker χ) A)).comp (π : MvPolynomial (Fin n) K →+* A) :=
  RingHom.ext fun q => by
    rw [RingHom.comp_apply, RingHom.comp_apply, algebraMap_mvPolynomial_eq, hat_coe]
    rfl

theorem evalOne_hat (p : MvPowerSeries (Fin n) K) :
    AdicCompletion.evalₐ (RingHom.ker χ) 1 (hat χ π hχ p) =
      Ideal.Quotient.mk _ (algebraMap K A (MvPowerSeries.constantCoeff p)) := by
  rw [evalₐ_hat, Ideal.Quotient.eq, pow_one, RingHom.mem_ker, map_sub, hχ, AlgHom.commutes,
    Algebra.algebraMap_self, RingHom.id_apply, MvPolynomial.constantCoeff_eq,
    MvPowerSeries.coeff_truncTotal (x := 0) (n := 1) _ (by simp), MvPowerSeries.coeff_zero_eq_constantCoeff_apply, sub_self]

end Hat

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA8b

/-! ### piece ArA8c -/
section Piece_ArA8c


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA8c: `π̂` is surjective with kernel `J·K[[x]]`

For a surjective `π : K[x] →ₐ[K] A` with `χ ∘ π = constantCoeff` (`J = ker π`):
* `hat_surjective` (`A` noetherian): `π̂ : K[[x]] → Â` is surjective (`surjective_of_mk_map_comp_surjective`).
* `mem_map_of_hat_eq_zero`: `π̂ p = 0 → p ∈ J·K[[x]]` (`Â_R ≅ R̂ ⊗[R] A`, `ofTensorProduct_bijective_of_finite_of_isNoetherian`,
  then `Algebra.TensorProduct.lTensor_ker`).
-/

set_option autoImplicit false

noncomputable section

open TensorProduct

namespace RamanujanPetersson.EtPBC.Cov

universe u

section HatProps

variable {K : Type u} [Field K] {A : Type u} [CommRing A] [Algebra K A] {n : ℕ}
  (χ : A →ₐ[K] K) (π : MvPolynomial (Fin n) K →ₐ[K] A)
  (hχ : ∀ p, χ (π p) = MvPolynomial.constantCoeff p)

theorem span_X_eq_map :
    Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K)) =
      (MvPolynomial.idealOfVars (Fin n) K).map
        (algebraMap (MvPolynomial (Fin n) K) (MvPowerSeries (Fin n) K)) := by
  rw [MvPolynomial.idealOfVars, Ideal.map_span, ← Set.range_comp]
  congr 2
  funext i
  rw [Function.comp_apply, algebraMap_mvPolynomial_eq, MvPolynomial.coe_X]

theorem map_span_X_hat (hπ : Function.Surjective π) :
    (Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K))).map (hat χ π hχ) =
      (RingHom.ker χ).map (algebraMap A (AdicCompletion (RingHom.ker χ) A)) := by
  rw [span_X_eq_map, Ideal.map_map, hat_comp, ← Ideal.map_map, ← AlgHom.coe_ideal_map,
    ← ker_eq_map_vars χ π hπ hχ]

theorem hat_surjective [IsNoetherianRing A] (hπ : Function.Surjective π) : Function.Surjective (hat χ π hχ) := by
  have hfg : (RingHom.ker χ).FG := IsNoetherian.noetherian _
  haveI hc : IsAdicComplete ((RingHom.ker χ).map (algebraMap A (AdicCompletion (RingHom.ker χ) A)))
      (AdicCompletion (RingHom.ker χ) A) :=
    by rw [IsAdicComplete.map_algebraMap_iff]; exact AdicCompletion.isAdicComplete hfg
  haveI : IsHausdorff ((Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K))).map
      (hat χ π hχ)) (AdicCompletion (RingHom.ker χ) A) := by
    rw [map_span_X_hat χ π hχ hπ]
    infer_instance
  refine surjective_of_mk_map_comp_surjective
    (I := Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K))) (hat χ π hχ) ?_
  rw [map_span_X_hat χ π hχ hπ, ← AdicCompletion.ker_evalOneₐ_eq_map (RingHom.ker χ) hfg]
  intro q
  obtain ⟨â, rfl⟩ := Ideal.Quotient.mk_surjective q
  obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalOneₐ (RingHom.ker χ) â)
  refine ⟨((MvPolynomial.C (χ a) : MvPolynomial (Fin n) K) : MvPowerSeries (Fin n) K), ?_⟩
  rw [RingHom.comp_apply, Ideal.Quotient.eq, RingHom.mem_ker, map_sub, hat_coe]
  show Ideal.Quotient.mk _ (π (MvPolynomial.C (χ a))) - AdicCompletion.evalOneₐ (RingHom.ker χ) â = 0
  rw [← ha, ← map_sub, Ideal.Quotient.eq_zero_iff_mem, RingHom.mem_ker, map_sub, hχ,
    MvPolynomial.constantCoeff_C, sub_self]

theorem mem_map_of_hat_eq_zero (hπ : Function.Surjective π) {p : MvPowerSeries (Fin n) K}
    (hp : hat χ π hχ p = 0) :
    p ∈ (RingHom.ker π).map (algebraMap (MvPolynomial (Fin n) K) (MvPowerSeries (Fin n) K)) := by
  classical
  letI : Algebra (MvPolynomial (Fin n) K) A := (π : MvPolynomial (Fin n) K →+* A).toAlgebra
  let I := MvPolynomial.idealOfVars (Fin n) K
  let e := MvPowerSeries.toAdicCompletionAlgEquiv (Fin n) K
  let πₗ : MvPolynomial (Fin n) K →ₗ[MvPolynomial (Fin n) K] A := Algebra.linearMap _ A
  haveI : Module.Finite (MvPolynomial (Fin n) K) A := Module.Finite.of_surjective πₗ hπ
  have h1 : AdicCompletion.map I πₗ (e p) = 0 := by
    refine AdicCompletion.ext fun k => ?_
    have hk := congrArg (AdicCompletion.evalₐ (RingHom.ker χ) k) hp
    rw [evalₐ_hat, map_zero, Ideal.Quotient.eq_zero_iff_mem, ker_eq_map_vars χ π hπ hχ, ← Ideal.map_pow,
      AlgHom.coe_ideal_map] at hk
    show Submodule.Quotient.mk (πₗ (MvPowerSeries.truncTotal k p)) = 0
    rw [Submodule.Quotient.mk_eq_zero, Ideal.smul_top_eq_map, Submodule.restrictScalars_mem]
    exact hk
  have h31 : AdicCompletion.of I (MvPolynomial (Fin n) K) 1 = 1 := by
    rw [← map_one (algebraMap (MvPolynomial (Fin n) K) (AdicCompletion I (MvPolynomial (Fin n) K))),
      AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
  have h2 : AdicCompletion.ofTensorProduct I A (e p ⊗ₜ[MvPolynomial (Fin n) K] (1 : A)) = 0 := by
    calc AdicCompletion.ofTensorProduct I A (e p ⊗ₜ[MvPolynomial (Fin n) K] (1 : A))
        = e p • AdicCompletion.of I A 1 := by rw [AdicCompletion.ofTensorProduct_tmul]
      _ = e p • AdicCompletion.map I πₗ (AdicCompletion.of I (MvPolynomial (Fin n) K) 1) := by
          rw [AdicCompletion.map_of, Algebra.linearMap_apply, map_one (algebraMap (MvPolynomial (Fin n) K) A)]
      _ = AdicCompletion.map I πₗ (e p • AdicCompletion.of I (MvPolynomial (Fin n) K) 1) := (map_smul _ _ _).symm
      _ = AdicCompletion.map I πₗ (e p) := by rw [h31, smul_eq_mul, mul_one]
      _ = 0 := h1
  have h4 : e p ⊗ₜ[MvPolynomial (Fin n) K] (1 : A) = 0 :=
    (AdicCompletion.ofTensorProduct_bijective_of_finite_of_isNoetherian I A).1 (h2.trans (map_zero _).symm)
  have h5 : e p ⊗ₜ[MvPolynomial (Fin n) K] (1 : MvPolynomial (Fin n) K) ∈
      (RingHom.ker (Algebra.ofId (MvPolynomial (Fin n) K) A)).map
        (Algebra.TensorProduct.includeRight : MvPolynomial (Fin n) K →ₐ[MvPolynomial (Fin n) K]
          AdicCompletion I (MvPolynomial (Fin n) K) ⊗[MvPolynomial (Fin n) K] MvPolynomial (Fin n) K) := by
    rw [← Algebra.TensorProduct.lTensor_ker (A := AdicCompletion I (MvPolynomial (Fin n) K))
      (Algebra.ofId (MvPolynomial (Fin n) K) A) hπ, RingHom.mem_ker, Algebra.TensorProduct.map_tmul,
      AlgHom.id_apply, map_one]
    exact h4
  have hle : (RingHom.ker (Algebra.ofId (MvPolynomial (Fin n) K) A)).map
      (Algebra.TensorProduct.includeRight : MvPolynomial (Fin n) K →ₐ[MvPolynomial (Fin n) K]
        AdicCompletion I (MvPolynomial (Fin n) K) ⊗[MvPolynomial (Fin n) K] MvPolynomial (Fin n) K) ≤
      ((RingHom.ker π).map (algebraMap (MvPolynomial (Fin n) K) (AdicCompletion I (MvPolynomial (Fin n) K)))).comap
        (Algebra.TensorProduct.rid (MvPolynomial (Fin n) K) (MvPolynomial (Fin n) K)
          (AdicCompletion I (MvPolynomial (Fin n) K))) := by
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, Ideal.mem_comap, Algebra.TensorProduct.includeRight_apply,
      Algebra.TensorProduct.rid_tmul, Algebra.smul_def, mul_one]
    exact Ideal.mem_map_of_mem _ hr
  have h8 := hle h5
  rw [Ideal.mem_comap, Algebra.TensorProduct.rid_tmul, one_smul] at h8
  have h9 := Ideal.mem_map_of_mem e.symm h8
  rw [AlgEquiv.symm_apply_apply] at h9
  have hle2 : ((RingHom.ker π).map (algebraMap (MvPolynomial (Fin n) K)
      (AdicCompletion I (MvPolynomial (Fin n) K)))).map e.symm ≤
      (RingHom.ker π).map (algebraMap (MvPolynomial (Fin n) K) (MvPowerSeries (Fin n) K)) := by
    rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap, Ideal.mem_comap, AlgEquiv.commutes]
    exact Ideal.mem_map_of_mem _ hr
  exact hle2 h9

end HatProps

end RamanujanPetersson.EtPBC.Cov
end

