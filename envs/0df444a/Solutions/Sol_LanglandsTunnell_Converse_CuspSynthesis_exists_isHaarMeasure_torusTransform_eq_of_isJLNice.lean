open scoped WithZeroTopology

variable [MeasurableSpace (v.adicCompletion K)] [BorelSpace (v.adicCompletion K)]

private theorem t0642 (n : ℤ) : MeasurableSet (d067 v n) := by
  have h : d067 v n = (Valued.v : v.adicCompletion K → ℤᵐ⁰) ⁻¹' Set.Iic (WithZero.exp n) := rfl
  rw [h]
  have hcl : IsClosed (Set.Iic (WithZero.exp n : ℤᵐ⁰)) :=
    WithZeroTopology.isClosed_iff.2 (Or.inl (Set.mem_Iic.2 zero_le'))
  have hc : Continuous (Valued.v : v.adicCompletion K → ℤᵐ⁰) :=
    Valued.continuous_valuation_of_surjective (v.valuedAdicCompletion_surjective K)
  exact (hcl.preimage hc).measurableSet

end Measurable
