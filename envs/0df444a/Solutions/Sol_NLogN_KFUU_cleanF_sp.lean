theorem popsL_sp (s : IState HS) (B : ℕ) :
    ∀ (L : List (Fin HS)) (F : Fin HS → List ℤ), L.Nodup → (∀ i ∈ L, i.val < 56) →
      (∀ i ∈ L, ∃ a, F i = [a] ∧ zsz a ≤ B) →
      Sp (NLogN.KFUU.popsL L) (NLogN.KIL.encK s F) (NLogN.KIL.encK s (clrF F L)) (L.length * (2 * B + 2) + 1)
  | [], F, _, _, _ => by
      have : clrF F [] = F := by funext j; simp [clrF]
      rw [this]; exact (Sp.skip _).mono (by simp)
  | i :: L, F, hnd, h56, hF => by
      obtain ⟨a, ha, hb⟩ := hF i List.mem_cons_self
      have hiL : i ∉ L := (List.nodup_cons.1 hnd).1
      have S1 := Sp.pop s F (i := i) (B := B) (h56 i List.mem_cons_self) ha hb
      have S2 := popsL_sp s B L (Function.update F i []) (List.nodup_cons.1 hnd).2
        (fun j hj => h56 j (List.mem_cons_of_mem _ hj))
        (fun j hj => by
          have hji : j ≠ i := fun e => hiL (e ▸ hj)
          rw [Function.update_of_ne hji]; exact hF j (List.mem_cons_of_mem _ hj))
      have e : clrF (Function.update F i []) L = clrF F (i :: L) := by
        funext j; by_cases h1 : j = i
        · subst h1; simp [clrF, hiL]
        · simp [clrF, h1, Function.update_of_ne h1]
      rw [e] at S2
      refine (S1.seq S2).mono ?_
      simp only [List.length_cons]; ring_nf; omega

end NLogN.KFUU

