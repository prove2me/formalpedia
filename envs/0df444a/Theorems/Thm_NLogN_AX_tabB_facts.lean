theorem NLogN.AX.tabB_facts (p s t α Bq : ℕ) (H : TabHypB p s t α Bq) (hs : 1 ≤ s) (hst : s ≤ t) :
    4 * (α ^ 2 + s + t + 2) ^ 6 < 2 ^ Bq ∧ 4 * (s + t + 2) ^ 2 < 2 ^ Bq ∧
    (∀ u < t, 4 * (u + t + 2) ^ 2 < 2 ^ Bq) ∧
    2 * HvdH.eWidth p α + 2 < 2 ^ Bq ∧ s ^ 2 < 2 ^ Bq ∧ 2 * α ^ 2 + 2 < 2 ^ Bq ∧
    s * (2 * HvdH.eWidth p α + 1) < 2 ^ Bq ∧ 2 * t * s + s < 2 ^ Bq ∧ t < 2 ^ Bq := by sorry
