-- name    : NesterovODE.GenScheme.one_step
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-09T00:51:08.874452+00:00
-- url     : https://prove2.me/theorems/e8e8e094-a7fd-4ac0-80b6-60d7280034c3
-- title:
--   p. 14, proof of Theorem 6 — f(x_k) ≤ ((k−1)/(k+r−2))f(x_{k−1}) + ((r−1)/(k+r−2))f⋆ + ((r−1)²/(2s(k+r−2)²))(‖z_{k−1}−x⋆‖² − ‖z_k−x⋆‖²)
-- statement:
--   Let $\mathcal H$ be a real Hilbert space. Let $f=g+h$, where $g:\mathcal H\to\mathbb R$ is convex and continuously differentiable with $L$-Lipschitz gradient for some $L>0$, and $h:\mathcal H\to\mathbb R\cup\{+\infty\}$ is proper, lower semicontinuous and convex. Let $0<s\le 1/L$, $r>3$, let $(x_k)$ be generated by the generalized Nesterov scheme (19) from $y_0=x_0$, and let $x^\star$ be a minimizer of $f$, $f^\star=f(x^\star)$. With $z_k$ as in (19)–(20) ($z_k=x_k+\frac{k-1}{r-1}(x_k-x_{k-1})$, $z_0=x_0$), for every $k\ge1$,
--
--   $$
--   f(x_k)\le \frac{k-1}{k+r-2}\,f(x_{k-1})+\frac{r-1}{k+r-2}\,f^\star+\frac{(r-1)^2}{2s(k+r-2)^2}\Big(\|z_{k-1}-x^\star\|^2-\|z_k-x^\star\|^2\Big).
--   $$
--
--   This is the one-step inequality behind the discrete energy estimate (20): it is the convex combination, with weights $\frac{k-1}{k+r-2}$ and $\frac{r-1}{k+r-2}$, of the basic proximal-gradient inequality (22) taken at $x=x_{k-1}$ and at $x=x^\star$.
--
--   **Formalization Note.** Values of $f$ lie in $\mathbb R\cup\{\pm\infty\}$ (`EReal`) and real coefficients enter through the coercion; at $k=1$ the coefficient of $f(x_0)$ is $0$ and $0\cdot(+\infty)=0$, so $x_0$ may lie outside the domain of $h$. The proximal map is any $P$ with `IsProx s h P`; requiring $h$ lower semicontinuous (closed) is what makes the paper's $\operatorname{argmin}$ in $G_s$ exist. $s\le1/L$ is written $sL\le1$. $r>3$ is the standing assumption of §4.1.
-- source:
--   Su, Boyd, Candès, A Differential Equation for Modeling Nesterov's Accelerated Gradient Method, arXiv:1503.01243v2, p. 14, proof of Theorem 6 (last display)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm
import Definitions.Def_NesterovODE_GenScheme_Run

open InnerProductSpace NesterovFB.Rates ThreeOpSplitting.ConvexRates

namespace NesterovODE.GenScheme

theorem one_step {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : NNReal) (s r : ℝ) (P : H → H) (x : ℕ → H) (xstar : H)
    (hΨ : IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL0 : 0 < L) (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * L ≤ 1)
    (hP : IsProx s Ψ P)
    (hr : 3 < r)
    (hrun : IsGenNesterovRun Φ P r s x)
    (hmin : ∀ y : H, theta Ψ Φ xstar ≤ theta Ψ Φ y) :
    ∀ k : ℕ, 1 ≤ k →
      theta Ψ Φ (x k) ≤
        ((((k : ℝ) - 1) / ((k : ℝ) + r - 2) : ℝ) : EReal) * theta Ψ Φ (x (k - 1))
        + (((r - 1) / ((k : ℝ) + r - 2) : ℝ) : EReal) * theta Ψ Φ xstar
        + (((r - 1) ^ 2 / (2 * s * ((k : ℝ) + r - 2) ^ 2)
            * (‖zSeq r x (k - 1) - xstar‖ ^ 2 - ‖zSeq r x k - xstar‖ ^ 2) : ℝ) : EReal) := by sorry

end NesterovODE.GenScheme
