theorem NLogN.KFB.gate2_iruns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    (s : IState HS) (wb : ℕ) {W m n : ℕ} (T : Butterfly.Op (Fin n)) (r : ℕ) (hr : r + 1 < W)
    (M : M2G) (hM : M.Ok) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : Rep zs x) (h0 : f 0 = gflat zs ++ l)
    (hC : Cl f) (hb : NLogN.KFB.GB wb zs) :
    ∃ zs', Rep zs' ((P8Lift.RStep.den T
        (P8Lift.RStep.gate (g2Mat W r M) : P8Lift.RStep (Fin W) m)).mulVec x) ∧
      NLogN.KFB.GB (wb + 2) zs' ∧ zs' = g2L (2 ^ (m * n)) r M zs ∧
      IRuns I iprog (fcode (qopW [M] (2 ^ (m * n)) 1 (r * 2 ^ (m * n)))) (encK s f)
        (encK s (Function.update f 0 (gflat zs' ++ l)))
        (NLogN.KFB.cPass wb (2 * 2 ^ (m * n)) (r * 2 ^ (m * n))
          (zsz (((4 * (3 * (2 * 2 ^ (m * n)) + r * 2 ^ (m * n))) : ℕ) : ℤ))) := by sorry
