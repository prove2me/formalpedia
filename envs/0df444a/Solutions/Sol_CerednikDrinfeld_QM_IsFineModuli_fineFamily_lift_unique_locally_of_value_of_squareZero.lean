theorem natCast_isNilpotent {𝒪 : Type} [CommRing 𝒪] {π : 𝒪} {r : ℕ}
    (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π})
    (C : Type) [CommRing C] [Algebra 𝒪 C] (hC : IsNilpotent (algebraMap 𝒪 C π)) :
    IsNilpotent ((r : ℕ) : C) := by
  have hmem : ((r : ℕ) : 𝒪) ∈ Ideal.span {π} := by
    rw [← hunr]; exact Ideal.mem_span_singleton_self _
  obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.1 hmem
  obtain ⟨k, hk⟩ := hC
  refine ⟨k, ?_⟩
  have : ((r : ℕ) : C) = algebraMap 𝒪 C t * algebraMap 𝒪 C π := by
    rw [← map_mul, ht, map_natCast]
  rw [this, mul_pow, hk, mul_zero]

theorem natCast_isUnit_of_not_dvd {𝒪 : Type} [CommRing 𝒪] {π : 𝒪} {r : ℕ} (hr : r.Prime)
    (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π})
    (C : Type) [CommRing C] [Algebra 𝒪 C] (hC : IsNilpotent (algebraMap 𝒪 C π))
    {m : ℕ} (hm : ¬ r ∣ m) : IsUnit ((m : ℕ) : C) := by
  obtain ⟨k, hk⟩ := natCast_isNilpotent hunr C hC
  have hcop : Nat.Coprime (r ^ k) m := Nat.Coprime.pow_left k ((Nat.Prime.coprime_iff_not_dvd hr).2 hm)
  obtain ⟨u, v, huv⟩ := Nat.isCoprime_iff_coprime.2 hcop
  have h1 : (u : C) * ((r : ℕ) : C) ^ k + (v : C) * ((m : ℕ) : C) = 1 := by
    have := congrArg (Int.cast : ℤ → C) huv
    push_cast at this
    exact this
  rw [hk, mul_zero, zero_add, mul_comm] at h1
  exact isUnit_iff_exists_inv.2 ⟨_, h1⟩

theorem conn_of_squareZero {C C₀ : Type} [CommRing C] [CommRing C₀] (p : C →+* C₀)
    (hp : Function.Surjective p) (hsq : ∀ s t : C, p s = 0 → p t = 0 → s * t = 0)
    (hconn : ∀ e : C, IsIdempotentElem e → e = 0 ∨ e = 1) :
    ∀ e : C₀, IsIdempotentElem e → e = 0 ∨ e = 1 := by
  intro e he
  obtain ⟨x, rfl⟩ := hp e
  have hx2 : p x * p x = p x := he
  have ht : p (x * x - x) = 0 := by rw [map_sub, map_mul, hx2, sub_self]
  have hy : IsIdempotentElem (3 * x ^ 2 - 2 * x ^ 3) := by
    have h0 : (x * x - x) * (x * x - x) = 0 := hsq _ _ ht ht
    have : (3 * x ^ 2 - 2 * x ^ 3) * (3 * x ^ 2 - 2 * x ^ 3) - (3 * x ^ 2 - 2 * x ^ 3)
        = (x * x - x) * (x * x - x) * (4 * (x * x - x) - 3) := by ring
    rw [h0, zero_mul, sub_eq_zero] at this
    exact this
  have hpy : p (3 * x ^ 2 - 2 * x ^ 3) = p x := by
    have h2 : p x ^ 2 = p x := by rw [pow_two, hx2]
    have h3 : p x ^ 3 = p x := by rw [pow_succ, h2, hx2]
    rw [map_sub, map_mul, map_mul, map_pow, map_pow, h2, h3, map_ofNat, map_ofNat]; ring
  rcases hconn _ hy with h | h
  · left; rw [← hpy, h, map_zero]
  · right; rw [← hpy, h, map_one]

