theorem _root_.solution {μ ν : ℕ → ℤ} {offsets flat NR M i dst previous : ℕ} {left right : ℕ → ℕ}
    (H : Stored μ right NR M offsets flat) (hr : ∀ j < NR, right j < M) (hi : left i < M)
    (hout :
      ∀ t < LightHistogram.count right (left i) NR,
        ν (dst + 2 * (previous + t)) = (i : ℤ) ∧
          ν (dst + 2 * (previous + t) + 1) = μ (flat + offset right NR (left i) + t)) :
    Seg ν (dst + 2 * previous) (cells (row μ offsets flat left i)) :=
  by
  unfold cells row
  rw [List.flatMap_map]
  apply LocalKeyArraySemantics.seg_flatMap_rows _ _ 2 (dst + 2 * previous) (by simp)
  intro j hj a ha
  have hj' : j < LightHistogram.count right (left i) NR := by simpa only [SourceBucketView.indices_length H hi] using hj
  obtain ⟨b, hb, hkb, hpos, hread⟩ := H.read_bucket hr hi hj'
  have hindex : (SourceBucketView.indices μ offsets flat (left i))[j] = b :=
    by
    simp only [SourceBucketView.indices_eq H hi, bucketList, List.getElem_ofFn]
    rw [hread, Int.toNat_natCast]
  have haddress : dst + 2 * previous + j * 2 = dst + 2 * (previous + j) := by ring
  have hacases : a = 0 ∨ a = 1 := by omega
  rcases hacases with rfl | rfl
  · change ν (dst + 2 * previous + j * 2 + 0) = (i : ℤ)
    simpa only [Nat.add_zero, haddress] using (hout j hj').1
  · change ν (dst + 2 * previous + j * 2 + 1) = ((SourceBucketView.indices μ offsets flat (left i))[j] : ℤ)
    rw [haddress, hindex]
    exact (hout j hj').2.trans hread
end ThreeSum.WantedPairs
