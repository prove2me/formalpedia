-- title:
--   Discriminant $D_G$, endoscopic subsystem $\Phi_H$ and resultant $R^G_H$
-- statement:
--   This file sets up the root-theoretic objects of §1.10 of Ngo's paper.
--
--   Let $\Phi$ be the root system of a split reductive group $G$ with maximal torus $T$. Roots are
--   indexed by a type $\iota$; the character module $M$ plays the role of $X^*(T)$ and the module
--   $N$ the role of the cocharacter lattice $X_*(T)$, which is also the Cartan on which each root
--   is evaluated. For an index $i$ corresponding to a root $\alpha$, the linear form $d\alpha$ on
--   the Cartan is the evaluation $x \mapsto \langle \alpha, x\rangle$.
--
--   The file introduces:
--
--   - $\mathrm{negIdx}(i)$, the index of the opposite root $-\alpha$;
--   - the **discriminant** $D_G(x) = \prod_{\alpha \in \Phi} d\alpha(x)$;
--   - the discriminant $D_H(x) = \prod_{\alpha \in \Phi_H} d\alpha(x)$ of a subsystem indexed by a
--     finite set $s$;
--   - the **resultant** $R^G_H(x) = \prod_{\alpha \in \Lambda} d\alpha(x)$ attached to a finite set
--     $\Lambda$ of indices;
--   - the predicate *closed subsystem*: a set of indices stable under $\alpha \mapsto -\alpha$ and
--     under its own reflections;
--   - the predicate *half system*: $\Lambda \subseteq T$ contains exactly one index out of each pair
--     $\{\alpha,-\alpha\}$ with $\alpha$ indexed by $T$, and $T$ is stable under $\alpha \mapsto
--     -\alpha$;
--   - the Weyl group $W_H$ of a subsystem, as the subgroup of linear automorphisms of the Cartan
--     generated by the reflections attached to the roots of the subsystem;
--   - the **endoscopic subsystem** $\Phi_H = \{\alpha \in \Phi : \kappa(\alpha^\vee) = 1\}$ attached
--     to an element $\kappa$ of the dual torus $\hat T = \operatorname{Hom}(X_*(T), \mathbb{G}_m)$,
--     for a root datum with integral coefficients.
--
--   These are the objects out of which the transfer factor of the Langlands-Shelstad conjecture is
--   built, and they are the common vocabulary of every statement in this mission.
-- source:
--   Bao Chau Ngo, *Le lemme fondamental pour les algebres de Lie*, Publications mathematiques de l'IHES 111 (2010), 1-169, DOI 10.1007/s10240-010-0026-7, pp. 17-21, §1.8 and §1.10 (definition of $D_G$, of the endoscopic root system, and of $R^G_H$)

import Mathlib

/-!
# Discriminant and resultant for an endoscopic pair of root data

Formalization layer for §1.10 of B.-C. Ngô, *Le lemme fondamental pour les algèbres de
Lie*, Publ. Math. IHÉS **111** (2010), 1–169.

For a split reductive group `G` with maximal torus `T`, Ngô writes `Φ` for the root
system, and for each root `α ∈ Φ` he writes `dα` for the differential of the character
`α : T → 𝔾ₘ`, a linear form on the Cartan `t = Lie T`.  The discriminant is
`D_G = ∏_{α ∈ Φ} dα`.  An endoscopic datum is an element `κ` of the dual torus
`T̂ = Hom(X_*(T), 𝔾ₘ)`; the endoscopic group `H` has root system
`Φ_H = {α ∈ Φ : κ(α^∨) = 1}`, and `R^G_H = ∏_{α ∈ Λ} dα` for a set `Λ` of
representatives of the pairs `{±α} ⊆ Φ - Φ_H`.

Here roots are modelled by `RootPairing ι R M N`: `M` plays the role of the character
module `X^*(T)`, `N` the role of the cocharacter module `X_*(T)`, and the Cartan on
which the `dα` are evaluated is `N`.  `P.root' i : N →ₗ[R] R` is the linear form `dα`
attached to the root indexed by `i`.
-/

namespace NgoFL

open scoped BigOperators

variable {ι R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N]

/-- The index of the root `-α`, for `α` the root indexed by `i`. -/
def negIdx (P : RootPairing ι R M N) (i : ι) : ι := P.reflectionPerm i i

/-- The discriminant `D_G = ∏_{α ∈ Φ} dα`, evaluated at a point of the Cartan. -/
def discriminant [Fintype ι] (P : RootPairing ι R M N) (x : N) : R := ∏ i, P.root' i x

/-- The discriminant of the subsystem indexed by `s`, i.e. `D_H = ∏_{α ∈ Φ_H} dα`. -/
def subDiscriminant (P : RootPairing ι R M N) (s : Finset ι) (x : N) : R :=
  ∏ i ∈ s, P.root' i x

/-- The resultant `R^G_H = ∏_{α ∈ Λ} dα` attached to a set `Λ` of representatives of the
pairs of opposite roots outside the endoscopic subsystem. -/
def resultant (P : RootPairing ι R M N) (L : Finset ι) (x : N) : R := ∏ i ∈ L, P.root' i x

/-- `s` indexes a closed subsystem: it is stable under `α ↦ -α` and under its own
reflections.  This is the property enjoyed by the root system `Φ_H` of an endoscopic
group. -/
structure IsClosedSubsystem (P : RootPairing ι R M N) (s : Set ι) : Prop where
  neg_mem : ∀ i ∈ s, negIdx P i ∈ s
  reflectionPerm_mem : ∀ i ∈ s, ∀ j ∈ s, P.reflectionPerm i j ∈ s

/-- `L` picks exactly one root out of each pair `{α, -α}` of opposite roots indexed by
`T`.  (The exclusive-or condition forces `α ≠ -α` for every `α` indexed by `T`.) -/
structure IsHalfSystem (P : RootPairing ι R M N) (T L : Finset ι) : Prop where
  subset : L ⊆ T
  neg_mem : ∀ i ∈ T, negIdx P i ∈ T
  xor_mem : ∀ i ∈ T, Xor (i ∈ L) (negIdx P i ∈ L)

/-- The Weyl group `W_H` of the subsystem indexed by `s`, acting on the Cartan `N`. -/
def weylSubgroup (P : RootPairing ι R M N) (s : Set ι) : Subgroup (N ≃ₗ[R] N) :=
  Subgroup.closure {f | ∃ i ∈ s, f = P.coreflection i}

/-- The root subsystem `Φ_H = {α ∈ Φ : κ(α^∨) = 1}` cut out by an element `κ` of the dual
torus `T̂ = Hom(X_*(T), 𝔾ₘ)`, for a root datum (coefficients in `ℤ`). -/
def endoscopicIndex {ι M N A : Type*} [AddCommGroup M] [AddCommGroup N] [CommGroup A]
    (P : RootPairing ι ℤ M N) (κ : Multiplicative N →* A) : Set ι :=
  {i | κ (Multiplicative.ofAdd (P.coroot i)) = 1}

end NgoFL


