import Definitions.Def_FourColor_DischargeRules
import Definitions.Def_FourColor_Configuration

/-!
A Lean-native, deliberately simple reference certificate language for local unavoidability.
Gonthier (2005), Section 5.5, PDF pp. 44–48, describes interval splits, local configuration
matching, discharging bounds, and reuse of previous branches. The pinned Rocq counterparts
are `part.v`, `redpart.v`, `hubcap.v`, `present.v`, and `present5.v` through `present11.v`.

This language does not reproduce the optimized source implementation. Its certificates
contain finite syntax only: permutation equality derivations, interval witnesses, kernel
maps and paths, and finite branching trees. Soundness is a separate theorem obligation.
Acceptance of the 633 reducibility jobs or of all seven unavoidability cases is not asserted.
More efficient source-style quizzes and hubcaps may replace it after a refinement proof.
-/

namespace FourColor.Discharge

/-- A permutation or its inverse, for navigating a hypermap. -/
inductive DartOperation
  | edge | node | face | edgeInv | nodeInv | faceInv
  deriving DecidableEq, Repr

namespace DartOperation

def inverse : DartOperation → DartOperation
  | .edge => .edgeInv | .node => .nodeInv | .face => .faceInv
  | .edgeInv => .edge | .nodeInv => .node | .faceInv => .face

def eval {n : ℕ} (H : Hypermap n) : DartOperation → Equiv.Perm (Fin n)
  | .edge => H.edge | .node => H.node | .face => H.face
  | .edgeInv => H.edge.symm | .nodeInv => H.node.symm | .faceInv => H.face.symm

end DartOperation

/-- A dart expression based at the hub anchor. -/
inductive DartExpression
  | anchor
  | apply (operation : DartOperation) (argument : DartExpression)
  deriving DecidableEq, Repr

namespace DartExpression

def eval {n : ℕ} (H : Hypermap n) (anchor : Fin n) : DartExpression → Fin n
  | .anchor => anchor
  | .apply op t => op.eval H (t.eval H anchor)

def faceIterate : ℕ → DartExpression → DartExpression
  | 0, t => t
  | n + 1, t => .apply .face (faceIterate n t)

def faceInverseTwice (t : DartExpression) : DartExpression :=
  .apply .faceInv (.apply .faceInv t)

def localFace (t : DartExpression) : ℕ → DartExpression
  | 0 => .apply .edge t
  | i + 1 => .apply .edge (faceIterate (i + 2) (.apply .edge t))

end DartExpression

structure ArityConstraint where
  expression : DartExpression
  range : ArityRange
  deriving DecidableEq, Repr

namespace ArityConstraint

def Holds {n : ℕ} (c : ArityConstraint) (H : Hypermap n) (x : Fin n) : Prop :=
  c.range.Contains (H.faceArity (c.expression.eval H x))

end ArityConstraint

namespace Part

private def sectorConstraints (t : DartExpression) (s : Sector) : List ArityConstraint :=
  [⟨t.localFace 0, s.spoke⟩, ⟨t.localFace 1, s.hat⟩] ++
    s.fans.zipIdx.map (fun (r, i) ↦ ⟨t.localFace (i + 2), r⟩)

private def tailConstraints : DartExpression → Part → List ArityConstraint
  | _, [] => []
  | t, s :: rest => sectorConstraints t s ++ tailConstraints (.apply .face t) rest

/-- Every exact-match test, expanded to concrete arity constraints on dart expressions. -/
def constraints (p : Part) (t : DartExpression) : List ArityConstraint :=
  ⟨t, .exactly p.length⟩ :: tailConstraints t p

end Part

/-- The semantic context of a certificate branch; every field is finite syntax. -/
structure CertificateContext where
  arities : List ArityConstraint := []
  equalities : List (DartExpression × DartExpression) := []
  inequalities : List (DartExpression × DartExpression) := []
  deriving DecidableEq, Repr

namespace CertificateContext

def Holds {n : ℕ} (Γ : CertificateContext) (H : Hypermap n) (x : Fin n) : Prop :=
  (∀ c ∈ Γ.arities, c.Holds H x) ∧
  (∀ p ∈ Γ.equalities, p.1.eval H x = p.2.eval H x) ∧
  (∀ p ∈ Γ.inequalities, p.1.eval H x ≠ p.2.eval H x)

end CertificateContext

/-- Syntax for elementary equality reasoning; no Lean proofs occur in a packet. -/
inductive EqualityCertificate
  | given (index : ℕ)
  | reflexivity (expression : DartExpression)
  | symmetry (proof : EqualityCertificate)
  | transitivity (left right : EqualityCertificate)
  | congruence (operation : DartOperation) (proof : EqualityCertificate)
  | cancel (operation : DartOperation) (expression : DartExpression)
  | plain (expression : DartExpression)
  | cubic (expression : DartExpression)
  | triangle (expression : DartExpression)
  | facePeriod (arityIndex : ℕ)
  deriving Repr

/-- Return the equality checked by a derivation, rejecting malformed compositions. -/
def checkEquality (Γ : CertificateContext) :
    EqualityCertificate → Option (DartExpression × DartExpression)
  | .given i => Γ.equalities[i]?
  | .reflexivity t => some (t, t)
  | .symmetry p => (checkEquality Γ p).map fun (a, b) ↦ (b, a)
  | .transitivity p q => do
    let (a, b) ← checkEquality Γ p
    let (c, d) ← checkEquality Γ q
    if b = c then some (a, d) else none
  | .congruence op p => (checkEquality Γ p).map fun (a, b) ↦ (.apply op a, .apply op b)
  | .cancel op t => some (.apply op (.apply op.inverse t), t)
  | .plain t => some (.apply .edge (.apply .edge t), t)
  | .cubic t => some (.apply .node (.apply .node (.apply .node t)), t)
  | .triangle t => some (.apply .node (.apply .face (.apply .edge t)), t)
  | .facePeriod i => do
    let c ← Γ.arities[i]?
    let u ← c.range.upper
    if c.range.lower = u then some (c.expression.faceIterate u, c.expression) else none

/-- Closed intervals are disjoint if one upper endpoint is below the other's lower endpoint. -/
def ArityRange.disjoint (r s : ArityRange) : Bool :=
  (r.upper.any fun u ↦ decide (u < s.lower)) ||
    (s.upper.any fun u ↦ decide (u < r.lower))

inductive InequalityCertificate
  | given (index : ℕ)
  | symmetry (proof : InequalityCertificate)
  | transport (left : EqualityCertificate) (proof : InequalityCertificate)
      (right : EqualityCertificate)
  | injectivity (operation : DartOperation) (proof : InequalityCertificate)
  | edgeNotFixed (expression : DartExpression)
  | distinctArities (leftIndex rightIndex : ℕ)
  deriving Repr

/-- Inequality proofs use injectivity, plainness, branch facts, or incompatible arities. -/
def checkInequality (Γ : CertificateContext) :
    InequalityCertificate → Option (DartExpression × DartExpression)
  | .given i => Γ.inequalities[i]?
  | .symmetry p => (checkInequality Γ p).map fun (a, b) ↦ (b, a)
  | .transport p q r => do
    let (a, b) ← checkEquality Γ p
    let (c, d) ← checkInequality Γ q
    let (e, f) ← checkEquality Γ r
    if b = c ∧ d = e then some (a, f) else none
  | .injectivity op p => (checkInequality Γ p).map fun (a, b) ↦ (.apply op a, .apply op b)
  | .edgeNotFixed t => some (.apply .edge t, t)
  | .distinctArities i j => do
    let a ← Γ.arities[i]?
    let b ← Γ.arities[j]?
    if a.range.disjoint b.range then some (a.expression, b.expression) else none

/-- Interval intersection, also representing empty intervals explicitly. -/
def ArityRange.intersection (r s : ArityRange) : ArityRange :=
  ⟨max r.lower s.lower, match r.upper, s.upper with
    | none, v => v | v, none => v | some u, some v => some (min u v)⟩

inductive RangeCertificate
  | given (index : ℕ)
  | pentagonal (expression : DartExpression)
  | faceStep (inverse : Bool) (range : RangeCertificate)
  | intersection (left right : RangeCertificate)
  | transport (equality : EqualityCertificate) (range : RangeCertificate)
  deriving Repr

/-- Produce a checked arity interval. Pentagonal facts require the independent ≥5 premise. -/
def checkRange (Γ : CertificateContext) : RangeCertificate → Option ArityConstraint
  | .given i => Γ.arities[i]?
  | .pentagonal t => some ⟨t, .free⟩
  | .faceStep inverse p => (checkRange Γ p).map fun c ↦
    ⟨.apply (if inverse then .faceInv else .face) c.expression, c.range⟩
  | .intersection p q => do
    let a ← checkRange Γ p
    let b ← checkRange Γ q
    if a.expression = b.expression then
      some ⟨a.expression, a.range.intersection b.range⟩ else none
  | .transport p q => do
    let (a, b) ← checkEquality Γ p
    let c ← checkRange Γ q
    if b = c.expression then some ⟨a, c.range⟩ else none

def checkEntails (Γ : CertificateContext) (needed : ArityConstraint)
    (certificate : RangeCertificate) : Bool :=
  match checkRange Γ certificate with
  | none => false
  | some c => decide (c.expression = needed.expression) && c.range.subset needed.range

structure MatchCertificate where
  constraints : List RangeCertificate
  deriving Repr

structure MissCertificate where
  constraintIndex : ℕ
  disjointRange : RangeCertificate
  deriving Repr

/-- All atoms must be justified; list length is checked before zipping. -/
def checkMatch (Γ : CertificateContext) (p : Part) (t : DartExpression)
    (certificate : MatchCertificate) : Bool :=
  let atoms := p.constraints t
  decide (certificate.constraints.length = atoms.length) &&
    (atoms.zip certificate.constraints).all (fun (a, c) ↦ checkEntails Γ a c)

/-- One provably incompatible atom suffices to exclude a rule. -/
def checkMiss (Γ : CertificateContext) (p : Part) (t : DartExpression)
    (certificate : MissCertificate) : Bool :=
  match (p.constraints t)[certificate.constraintIndex]?, checkRange Γ certificate.disjointRange with
  | some a, some b => decide (a.expression = b.expression) && a.range.disjoint b.range
  | _, _ => false

/-- Bound every incoming rule from above and every outgoing rule from below.
`none` deliberately gives the conservative bound 1 incoming or 0 outgoing. -/
structure FlowCertificate where
  incoming : List (Option MissCertificate)
  outgoing : List (Option MatchCertificate)
  deriving Repr

private def incidentTests (degree : ℕ) (incoming : Bool) : List (Part × DartExpression) :=
  (List.range degree).flatMap fun i ↦
    let hub := DartExpression.faceIterate i .anchor
    let dart := if incoming then DartExpression.apply .edge hub else hub
    rules.map fun p ↦ (p, dart.faceInverseTwice)

/-- Explicit charge bound using the fixed 71-rule list; it is intentionally unoptimized. -/
def checkFlow (Γ : CertificateContext) (degree : ℕ) (certificate : FlowCertificate) : Bool :=
  let ins := incidentTests degree true
  let outs := incidentTests degree false
  let bound : ℤ := 60 - 10 * degree +
    certificate.incoming.countP Option.isNone - certificate.outgoing.countP Option.isSome
  decide (certificate.incoming.length = ins.length) &&
  decide (certificate.outgoing.length = outs.length) &&
  (ins.zip certificate.incoming).all (fun ((p, t), c) ↦
    match c with | none => true | some c => checkMiss Γ p t c) &&
  (outs.zip certificate.outgoing).all (fun ((p, t), c) ↦
    match c with | none => true | some c => checkMatch Γ p t c) &&
  decide (bound ≤ 0)

/-- The actual preserved-edge set is certified in both directions on kernel darts. -/
inductive EdgeCertificate
  | preserved (equality : EqualityCertificate)
  | excluded (inequality : InequalityCertificate)
  deriving Repr

namespace EdgeCertificate

def isPreserved : EdgeCertificate → Bool
  | .preserved _ => true | .excluded _ => false

def check (Γ : CertificateContext) (left right : DartExpression) : EdgeCertificate → Bool
  | .preserved p => decide (checkEquality Γ p = some (left, right))
  | .excluded p => decide (checkInequality Γ p = some (left, right))

end EdgeCertificate

/-- A kernel-only source-preembedding witness. Neither reducibility nor occurrence is a field. -/
structure OccurrenceCertificate (C : Configuration) where
  mirrored : Bool
  image : Fin C.dartCount → DartExpression
  faceEqualities : Fin C.dartCount → EqualityCertificate
  arityCertificates : Fin C.dartCount → RangeCertificate
  edgeCertificates : Fin C.dartCount → EdgeCertificate
  faceCover : Fin C.dartCount → Fin C.dartCount
  paths : Fin C.dartCount → Fin C.dartCount → List (Fin C.dartCount)

private def targetFace (mirrored : Bool) (t : DartExpression) : DartExpression :=
  if mirrored then .apply .faceInv t else .apply .face t

private def targetEdge (mirrored : Bool) (t : DartExpression) : DartExpression :=
  if mirrored then .apply .face (.apply .node t) else .apply .edge t

private def checkPath (C : Configuration) (certificate : OccurrenceCertificate C)
    (x y : Fin C.dartCount) : Bool :=
  let p := certificate.paths x y
  let r := C.map.node (C.map.face x) :: (p ++ [y])
  (r.zip r.tail).all (fun (a, b) ↦ decide (C.map.SameFace (C.map.edge a) b)) &&
    p.all (fun z ↦ decide (C.InKernel z) && (certificate.edgeCertificates z).isPreserved)

/-- Check precisely the source preembedding obligations, restricted to the kernel.
When `mirrored` is true, the target face is inverted and the target edge is `face ∘ node`.
Geometric admissibility of the fixed configuration is supplied by the catalogue-validity theorem. -/
def checkOccurrence (Γ : CertificateContext) (C : Configuration)
    (certificate : OccurrenceCertificate C) : Bool :=
  decide (∀ x : Fin C.dartCount, C.InKernel x →
    checkEquality Γ (certificate.faceEqualities x) =
      some (certificate.image (C.map.face x), targetFace certificate.mirrored (certificate.image x)) ∧
    checkEntails Γ ⟨certificate.image x, .exactly (faceArity C.map x)⟩
      (certificate.arityCertificates x) = true ∧
    (certificate.edgeCertificates x).check Γ
      (certificate.image (C.map.edge x))
      (targetEdge certificate.mirrored (certificate.image x)) = true ∧
    C.map.SameFace x (certificate.faceCover x) ∧
    (certificate.edgeCertificates (certificate.faceCover x)).isPreserved = true) &&
  decide (∀ x y : Fin C.dartCount,
    C.InKernel x → (certificate.edgeCertificates x).isPreserved = true →
    C.InKernel y → (certificate.edgeCertificates y).isPreserved = true →
    checkPath C certificate x y = true)

/-- Complete finite branching, with contradiction, charge, and occurrence leaves. -/
inductive PresentationCertificate (catalogue : List Configuration)
  | emptyRange (range : RangeCertificate)
  | contradiction (equality : EqualityCertificate) (inequality : InequalityCertificate)
  | charge (certificate : FlowCertificate)
  | occurrence (index : Fin catalogue.length)
      (certificate : OccurrenceCertificate catalogue[index])
  | splitArity (expression : DartExpression) (threshold : ℕ)
      (lower upper : PresentationCertificate catalogue)
  | splitEquality (left right : DartExpression)
      (equal unequal : PresentationCertificate catalogue)
  | strengthen (range : RangeCertificate) (child : PresentationCertificate catalogue)

/-- Total, syntax-directed checking. Every split checks both exhaustive branches. -/
def checkPresentationIn (catalogue : List Configuration) (degree : ℕ)
    (Γ : CertificateContext) : PresentationCertificate catalogue → Bool
  | .emptyRange p => match checkRange Γ p with
    | some c => c.range.upper.any fun u ↦ decide (u < c.range.lower)
    | none => false
  | .contradiction p q => match checkEquality Γ p, checkInequality Γ q with
    | some (a, b), some (c, d) => decide (a = c ∧ b = d)
    | _, _ => false
  | .charge p => checkFlow Γ degree p
  | .occurrence i p => checkOccurrence Γ catalogue[i] p
  | .splitArity t k l r =>
    checkPresentationIn catalogue degree
      { Γ with arities := Γ.arities ++ [⟨t, ⟨0, some k⟩⟩] } l &&
    checkPresentationIn catalogue degree
      { Γ with arities := Γ.arities ++ [⟨t, ⟨k + 1, none⟩⟩] } r
  | .splitEquality a b l r =>
    checkPresentationIn catalogue degree { Γ with equalities := Γ.equalities ++ [(a, b)] } l &&
    checkPresentationIn catalogue degree { Γ with inequalities := Γ.inequalities ++ [(a, b)] } r
  | .strengthen p child => match checkRange Γ p with
    | none => false
    | some c => checkPresentationIn catalogue degree { Γ with arities := Γ.arities ++ [c] } child

/-- The starting branch fixes the actual hub degree. -/
def checkPresentation (catalogue : List Configuration) (degree : ℕ)
    (certificate : PresentationCertificate catalogue) : Bool :=
  checkPresentationIn catalogue degree { arities := [⟨.anchor, .exactly degree⟩] } certificate

end FourColor.Discharge


