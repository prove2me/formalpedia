theorem NLogN.KFM.lemma19_base (p s t α : ℕ) [NeZero s] [NeZero t] (hst : s < t) (hcop : Nat.Coprime s t)
    (hα : 2 ≤ α) (hαp : α ^ 2 ≤ p) (hx : s ≤ α ^ 2 * (t - s))
    (hp : 100 * (IntMul.HvdH.jIter p s t α * (10 * IntMul.HvdH.eWidth p α + 12) + 1) ≤ 2 ^ p) :
    ∃ (A : (ZMod s → ℂ) →L[ℂ] (ZMod t → ℂ)) (B₀ : (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ)),
      ‖A‖ ≤ 1 ∧ ‖B₀‖ ≤ 1 ∧
      (∀ u, IntMul.OpenAI.RH.permS s t ((s : ℂ)⁻¹ • ZMod.dft u) =
        (2 : ℂ) ^ (2 * α ^ 2) • B₀ (IntMul.OpenAI.RH.permT s t ((t : ℂ)⁻¹ • ZMod.dft (A u)))) ∧
      (∀ U : ℕ → ℤ × ℤ, (∀ i, ‖IntMul.HvdH.P47.toC (U i)‖ ≤ 2 ^ p) → ∀ k : ZMod t,
        ‖IntMul.HvdH.P47.toC (IntMul.HvdH.Sapprox p s t α U k.val) -
          2 ^ p * A (fun j => IntMul.HvdH.P47.toC (U j.val) / 2 ^ p) k‖
          ≤ 6 * IntMul.HvdH.sWidth p α + 4) ∧
      (∀ W : ℕ → ℤ × ℤ, (∀ i, ‖IntMul.HvdH.P47.toC (W i)‖ ≤ 2 ^ p) → ∀ l : ZMod s,
        ‖IntMul.HvdH.P47.toC (B0approx p s t α W l.val) -
          2 ^ p * B₀ (fun k => IntMul.HvdH.P47.toC (W k.val) / 2 ^ p) l‖
          ≤ IntMul.HvdH.jIter p s t α * (10 * IntMul.HvdH.eWidth p α + 12) + 4) := by sorry
