theorem solution (A S : Type) [CommRing A] [CommRing S] [Algebra A S]
    (M : Submonoid A) [IsLocalization M S] (ι : Type) [Finite ι] (P : ι → Ideal A)
    [∀ i, (P i).IsPrime] (J : ∀ i, Ideal (TypeDensity.CompletedLocalAt A (P i))) (σ : ι → Prop)
    (T : ι → Type) [∀ i, CommRing (T i)] (ψ : ∀ i, S →+* T i)
    (Φ : ∀ i, TypeDensity.CompletedLocalAt A (P i) ≃+* T i)
    (hΦ : ∀ i, σ i → ∀ a : A, Φ i (TypeDensity.completedPointMap A (P i) a) = ψ i (algebraMap A S a))
    (hcollapse : ∀ i, ¬ σ i → ∃ m ∈ M, m ∈ P i) (L : ι → ℕ)
    (hL : ∀ i, (P i)^(L i) ≤ (J i).comap (TypeDensity.completedPointMap A (P i))) :
    (TypeDensity.finiteSupportKernel A ι P J).map (algebraMap A S) = ⨅ i : {i // σ i},
    ((J i.val).map (Φ i.val)).comap (ψ i.val) := by
  have key : ∀ i, σ i → ((J i).comap (TypeDensity.completedPointMap A (P i))).map (algebraMap A S)
      = ((J i).map (Φ i)).comap (ψ i) := by
    intro i hi
    have hc : (J i).comap (TypeDensity.completedPointMap A (P i))
        = ((J i).map (Φ i)).comap ((ψ i).comp (algebraMap A S)) := by
      ext x
      rw [← Ideal.comap_symm, Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap,
        RingHom.comp_apply, ← hΦ i hi]
      simp
    rw [hc]
    exact TypeDensity.localization_map_comap_comp A S M (T i) (ψ i) _
  have top : ∀ i, ¬ σ i → ((J i).comap (TypeDensity.completedPointMap A (P i))).map (algebraMap A S) = ⊤ := by
    intro i hi
    obtain ⟨m, hm, hmP⟩ := hcollapse i hi
    exact TypeDensity.contracted_ideal_map_localization_top A S M (P i) _ (L i) (hL i) m hm hmP
  unfold TypeDensity.finiteSupportKernel
  rw [TypeDensity.localization_map_finite_iInf A S M ι]
  apply le_antisymm
  · exact le_iInf fun i ↦ iInf_le_of_le i.val (by rw [key i.val i.property])
  · refine le_iInf fun i ↦ ?_
