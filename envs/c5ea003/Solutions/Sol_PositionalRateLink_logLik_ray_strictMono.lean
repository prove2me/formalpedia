lemma logisticTerm_ray_strictMono {s : ℝ} (hs : 0 < s) :
    StrictMono (fun t : ℝ => -Real.log (1 + Real.exp (-(t * s)))) := by
  intro a b hab
  have hexp : Real.exp (-(b * s)) < Real.exp (-(a * s)) := by
    apply Real.exp_lt_exp.2
    nlinarith
  have hpos : (0:ℝ) < 1 + Real.exp (-(b * s)) := by have := Real.exp_pos (-(b*s)); linarith
  have hlog := Real.log_lt_log hpos (by linarith : 1 + Real.exp (-(b*s)) < 1 + Real.exp (-(a*s)))
  simpa using by linarith [hlog]




lemma score_smul {n d : ℕ} (x : Fin n → Fin d → ℝ) (w : Fin d → ℝ) (t : ℝ) (i : Fin n) :
    (∑ j, (t * w j) * x i j) = t * ∑ j, w j * x i j := by
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun j _ => by ring







