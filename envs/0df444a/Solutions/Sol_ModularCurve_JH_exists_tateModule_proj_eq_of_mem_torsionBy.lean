theorem solution (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) (p : ℕ) [Fact p.Prime] (n : ℕ) :
    ∀ m ∈ Submodule.torsionBy ℤ (ModularCurve.JH M H) ((p ^ n : ℕ) : ℤ),
      ∃ x : TateModule p (ModularCurve.JH M H), TateModule.proj p (ModularCurve.JH M H) n x = m := by
  intro m hm
  classical

  haveI : AlgebraicCurve.IsCurveOver (AlgebraicClosure ℚ) ↥(ModularCurve.xHFunctionFieldBar M H) :=
    (ModularCurve.isCurveOver_and_essFiniteType_laurentBaseChange_xHFunctionField (AlgebraicClosure ℚ) M H).1
  have hfg : ∃ x : ↥(ModularCurve.xHFunctionFieldBar M H), Transcendental (AlgebraicClosure ℚ) x ∧
      FiniteDimensional ↥(IntermediateField.adjoin (AlgebraicClosure ℚ) ({x} : Set ↥(ModularCurve.xHFunctionFieldBar M H)))
        ↥(ModularCurve.xHFunctionFieldBar M H) :=
    ModularCurve.JOneES.exists_transcendental_finiteDimensional_laurentBaseChange (AlgebraicClosure ℚ)
      (CohCarrier.GammaH M H) (ModularCurve.translation_mem_GammaH M H)
  have hdiv : ∀ z : ModularCurve.JH M H, ∃ y : ModularCurve.JH M H, ((p : ℕ) : ℤ) • y = z := by
    intro z
    obtain ⟨y, hy⟩ := AlgebraicCurve.Pic0.exists_nsmul_eq (AlgebraicClosure ℚ) ↥(ModularCurve.xHFunctionFieldBar M H) hfg p
      (Fact.out : p.Prime).ne_zero z
    exact ⟨y, by rw [← hy, natCast_zsmul]⟩

  have hnext : ∀ (k : ℕ) (m' : ↥(Submodule.torsionBy ℤ (ModularCurve.JH M H) ((p ^ k : ℕ) : ℤ))),
      ∃ m'' : ↥(Submodule.torsionBy ℤ (ModularCurve.JH M H) ((p ^ (k + 1) : ℕ) : ℤ)),
        ((p : ℕ) : ℤ) • (m'' : ModularCurve.JH M H) = m' := by
    intro k m'
    obtain ⟨y, hy⟩ := hdiv m'
    refine ⟨⟨y, ?_⟩, hy⟩
    rw [Submodule.mem_torsionBy_iff, pow_succ, Nat.cast_mul, mul_smul, hy]
    exact (Submodule.mem_torsionBy_iff _ _).mp m'.2
  choose next hnext' using hnext

  refine ⟨⟨TateModule.liftFun next n ⟨m, hm⟩, TateModule.liftFun_mem hnext' n ⟨m, hm⟩⟩, ?_⟩
  rw [TateModule.proj_apply]
  change TateModule.liftFun next n ⟨m, hm⟩ n = m
  rw [TateModule.liftFun_of_le le_rfl, TateModule.coe_liftAux_congr (Nat.sub_self n)]
  rfl

