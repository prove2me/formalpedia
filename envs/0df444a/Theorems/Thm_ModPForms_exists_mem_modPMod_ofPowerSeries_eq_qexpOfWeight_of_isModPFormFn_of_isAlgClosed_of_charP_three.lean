open ModularCurve

theorem ModPForms.exists_mem_modPMod_ofPowerSeries_eq_qexpOfWeight_of_isModPFormFn_of_isAlgClosed_of_charP_three
    (N : ℕ) [NeZero N] (hpN : ¬ 3 ∣ N) (hε : ∃ q : ℕ, q.Prime ∧ q ∣ N ∧ q % 3 = 2)
    (K : Type) [Field K] [CharP K 3] [IsAlgClosed K] (m : ℕ) (hm : 1 ≤ m)
    (G : ↥(modularFunctionFieldC K N)) (hG : IsModPFormFn K m (G : LaurentSeries K)) :
    ∃ φ : PowerSeries K, φ ∈ ModPForms.modPMod N (2 * (m : ℤ)) K ∧
      HahnSeries.ofPowerSeries ℤ K φ = qexpOfWeight K (m : ℤ) (G : LaurentSeries K) := by sorry
