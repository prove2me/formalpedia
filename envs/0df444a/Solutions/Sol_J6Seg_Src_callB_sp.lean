    IState.top, IState.IsInt, h16, h17, h18, h27, Ex.ok, m10E]
  all_goals positivity

theorem expPosP_spec (n k j σ : ℕ) (s : IState HS) (L16 L17 L18 L27 : List Item)
    (h16 : s.G 16 = .int n :: L16) (h17 : s.G 17 = .int k :: L17)
    (h18 : s.G 18 = .int j :: L18) (h27 : s.G 27 = .int σ :: L27) :
    expPosP.ok s ∧ expPosP.run s = s.upd 19 (.int (expPos n k j σ) :: s.G 19) :=
  ⟨expPosP_ok n k j σ s L16 L17 L18 L27 h16 h17 h18 h27,
    expPosP_run n k j σ s L16 L17 L18 L27 h16 h17 h18 h27⟩

