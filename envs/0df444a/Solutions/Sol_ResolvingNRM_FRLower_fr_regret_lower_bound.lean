open Matrix Finset ProbabilityTheory

namespace ResolvingNRM.FRLower.ProofPlan

/-! ### Classical Indicator Helper -/

noncomputable def indR (P : Prop) : ℝ := by
  classical exact if P then 1 else 0

lemma indR_true {P : Prop} (hP : P) : indR P = 1 := by
  unfold indR; classical simp [hP]

lemma indR_false {P : Prop} (hP : ¬ P) : indR P = 0 := by
  unfold indR; classical simp [hP]

lemma indR_nonneg (P : Prop) : 0 ≤ indR P := by
  by_cases hP : P <;> simp [indR_true, indR_false, hP]

lemma indR_le_one (P : Prop) : indR P ≤ 1 := by
  by_cases hP : P <;> simp [indR_true, indR_false, hP]

lemma abs_indR_le_one (P : Prop) : |indR P| ≤ 1 := by
  rw [abs_of_nonneg (indR_nonneg P)]
  exact indR_le_one P

/-! ### List Slice & Replay Helpers -/

lemma list_take_add {α : Type*} (i j : ℕ) (l : List α) :
    l.take (i + j) = l.take i ++ (l.drop i).take j := by
  induction i generalizing l with
  | zero => simp
  | succ i ih =>
    cases l with
    | nil => simp
    | cons a tl =>
      rw [Nat.succ_add]
      simp [ih tl]

lemma admHigh_append_le (T : ℕ) (h₁ h₂ : History) :
    admHigh T (h₁ ++ h₂) ≤ admHigh T h₁ + histOffered 0 h₂ := by
  have hinv := (replayListAux_invariants (replayHistory T h₁) (h₂.flatMap windowList)).2.2.2.2.1
  have h1 : admHigh T (h₁ ++ h₂) ≤ admHigh T h₁ + histEnabled 0 h₂ := by
    simpa [admHigh, replayHistory, replayList, List.flatMap_append, replayListAux_append, histEnabled]
      using hinv
  exact le_trans h1 (Nat.add_le_add_left (histEnabled_le_histOffered 0 h₂) _)

lemma ExtSupported.length_eq {p : Policy} {k : ℕ} {h₀ h : History}
    (hs : ExtSupported p k h₀ h) :
    h.length = h₀.length + k := by
  rcases hs.exists_suffix with ⟨s, hslen, rfl⟩
  simp [hslen]

lemma ExtSupported.getElem_markWeight_pos {p : Policy} {m : ℕ} {h₀ h : History}
    (hs : ExtSupported p m h₀ h) :
    ∀ k < m, ∀ (hj : h₀.length + k < h.length),
      0 < markWeight (p (h.take (h₀.length + k))) (h[h₀.length + k]).1
        (h[h₀.length + k]).2.1 (h[h₀.length + k]).2.2 := by
  induction hs with
  | zero _ =>
    intro k hk; omega
  | @succ m' h₀ h w hw hk ih =>
    rcases hk.exists_suffix with ⟨s, _, h_eq⟩
    intro k hklt hj
    cases k with
    | zero =>
      have htake : h.take (h₀.length + 0) = h₀ := by
        rw [h_eq, List.append_assoc]
        simp
      have hget : h[h₀.length + 0] = w := by
        have h_eq' : h = h₀ ++ w :: s := by simpa [List.append_assoc] using h_eq
        subst h_eq'
        simp
      rw [htake, hget]
      exact hw
    | succ k' =>
      have hidx : (h₀ ++ [w]).length + k' = h₀.length + (k' + 1) := by
        simp; omega
      have hj' : (h₀ ++ [w]).length + k' < h.length := by omega
      have ih' := ih k' (by omega) hj'
      have hget_aux : ∀ (i : ℕ) (hi : i < h.length),
          i = h₀.length + (k' + 1) → h[i]'hi = h[h₀.length + (k' + 1)]'hj := by
        rintro _ _ rfl; rfl
      have hget' := hget_aux _ hj' hidx
      have htake' : h.take ((h₀ ++ [w]).length + k') = h.take (h₀.length + (k' + 1)) := by
        rw [hidx]
      rwa [htake', hget'] at ih'

/-! ### Four-Phase Event Definitions -/

def EventQ1 (T : ℕ) (h : History) : Prop :=
  let n := T / 3
  let s := Real.sqrt (n : ℝ)
  let a := (histOffered 0 (h.take n) : ℝ)
  (n : ℝ) - 4 * s ≤ a ∧ a ≤ (n : ℝ) - 3 * s

def EventQ2 (T : ℕ) (h : History) : Prop :=
  let n := T / 3
  let s := Real.sqrt (n : ℝ)
  ∀ i ≤ n, |(histOffered 0 ((h.drop n).take i) : ℝ) - (i : ℝ)| ≤ 2 * s

def EventQ3 (T : ℕ) (h : History) : Prop :=
  let n := T / 3
  let s := Real.sqrt (n : ℝ)
  let a := (histOffered 0 ((h.drop (2 * n)).take n) : ℝ)
  (n : ℝ) + 6 * s ≤ a ∧ a ≤ (n : ℝ) + 7 * s

def EventQ4 (T : ℕ) (h : History) : Prop :=
  let n := T / 3
  let r := T % 3
  histOffered 0 ((h.drop (3 * n)).take r) = r

def EventBStar (T : ℕ) (h : History) : Prop :=
  let n := T / 3
  let s := Real.sqrt (n : ℝ)
  s / 6 ≤ (admLow T (h.take (2 * n)) : ℝ)

def EventB1 (T : ℕ) (h : History) : Prop :=
  let n := T / 3
  let s := Real.sqrt (n : ℝ)
  (admHigh T (h.take n) : ℝ) < (n : ℝ) - 10 * s

def EventGPre (T : ℕ) (h : History) : Prop :=
  EventQ1 T h ∧ EventQ2 T h ∧ (EventBStar T h ∨ EventB1 T h)

def EventE (T : ℕ) (h : History) : Prop :=
  EventQ1 T h ∧ EventQ2 T h ∧ ¬ EventBStar T h ∧ ¬ EventB1 T h

def EventG (T : ℕ) (h : History) : Prop :=
  EventGPre T h ∧ EventQ3 T h ∧ EventQ4 T h

lemma indR_Q1_inter_Q2_eq (T : ℕ) (h : History) :
    indR (EventQ1 T h ∧ EventQ2 T h) = indR (EventGPre T h) + indR (EventE T h) := by
  by_cases hq : EventQ1 T h ∧ EventQ2 T h
  · by_cases hb : EventBStar T h ∨ EventB1 T h
    · have hg : EventGPre T h := ⟨hq.1, hq.2, hb⟩
      have he : ¬ EventE T h := by
        rintro ⟨_, _, hnb, hnb1⟩
        rcases hb with h1 | h2 <;> contradiction
      rw [indR_true hq, indR_true hg, indR_false he]; ring
    · push Not at hb
      have hg : ¬ EventGPre T h := by
        rintro ⟨_, _, h1 | h2⟩
        · exact hb.1 h1
        · exact hb.2 h2
      have he : EventE T h := ⟨hq.1, hq.2, hb.1, hb.2⟩
      rw [indR_true hq, indR_false hg, indR_true he]; ring
  · have hg : ¬ EventGPre T h := fun hh => hq ⟨hh.1, hh.2.1⟩
    have he : ¬ EventE T h := fun hh => hq ⟨hh.1, hh.2.1⟩
    rw [indR_false hq, indR_false hg, indR_false he]; ring

/-! ### Prefix Invariance of Phase Events -/

lemma eventQ1_append_of_len (T : ℕ) {h₁ : History} (hlen : T / 3 ≤ h₁.length) (s : History) :
    EventQ1 T (h₁ ++ s) ↔ EventQ1 T h₁ := by
  simp only [EventQ1, List.take_append_of_le_length hlen]

lemma eventGPre_append_of_len (T : ℕ) {h₂ : History} (hlen : 2 * (T / 3) ≤ h₂.length) (s : History) :
    EventGPre T (h₂ ++ s) ↔ EventGPre T h₂ := by
  have hn : T / 3 ≤ h₂.length := by omega
  have hq1 : EventQ1 T (h₂ ++ s) ↔ EventQ1 T h₂ := eventQ1_append_of_len T hn s
  have hq2 : EventQ2 T (h₂ ++ s) ↔ EventQ2 T h₂ := by
    unfold EventQ2
    refine forall_congr' fun i => imp_congr_right fun hi => ?_
    have htake : (h₂ ++ s).take (T / 3 + i) = h₂.take (T / 3 + i) :=
      List.take_append_of_le_length (by omega)
    have h1 := list_take_add (T / 3) i (h₂ ++ s)
    have h2 := list_take_add (T / 3) i h₂
    rw [htake, List.take_append_of_le_length hn] at h1
    have hdrop : ((h₂ ++ s).drop (T / 3)).take i = (h₂.drop (T / 3)).take i :=
      List.append_cancel_left (h1.symm.trans h2)
    rw [hdrop]
  have hbstar : EventBStar T (h₂ ++ s) ↔ EventBStar T h₂ := by
    simp only [EventBStar, List.take_append_of_le_length hlen]
  have hb1 : EventB1 T (h₂ ++ s) ↔ EventB1 T h₂ := by
    simp only [EventB1, List.take_append_of_le_length hn]
  simp only [EventGPre, hq1, hq2, hbstar, hb1]

lemma eventQ3_append_of_len (T : ℕ) {h₃ : History} (hlen : 3 * (T / 3) ≤ h₃.length) (s : History) :
    EventQ3 T (h₃ ++ s) ↔ EventQ3 T h₃ := by
  unfold EventQ3
  dsimp only
  have h2n : 2 * (T / 3) ≤ h₃.length := by omega
  have htake : (h₃ ++ s).take (2 * (T / 3) + T / 3) = h₃.take (2 * (T / 3) + T / 3) :=
    List.take_append_of_le_length (by omega)
  have h1 := list_take_add (2 * (T / 3)) (T / 3) (h₃ ++ s)
  have h2 := list_take_add (2 * (T / 3)) (T / 3) h₃
  rw [htake, List.take_append_of_le_length h2n] at h1
  have hdrop : ((h₃ ++ s).drop (2 * (T / 3))).take (T / 3) = (h₃.drop (2 * (T / 3))).take (T / 3) :=
    List.append_cancel_left (h1.symm.trans h2)
  rw [hdrop]

/-! ### Pointwise Regret Lower Bound on `EventG` -/

theorem pointwise_loss_bound
    (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁)
    (T : ℕ) (h : History) (hlen : h.length = T) :
    let n := T / 3
    let s := Real.sqrt (n : ℝ)
    ((r₁ - r₂) * s / 6) * indR (EventG T h) ≤
      RLPBidPrice.Unbiased.piValue
        (tcInst r₁ r₂ hr₂ hr).A (tcInst r₁ r₂ hr₂ hr).r (initialCapacity T)
        ![(histOffered 0 h : ℝ), (histOffered 1 h : ℝ)] -
        histRev T r₁ r₂ h := by
  intro n s
  have hnonneg : 0 ≤
      RLPBidPrice.Unbiased.piValue
        (tcInst r₁ r₂ hr₂ hr).A (tcInst r₁ r₂ hr₂ hr).r (initialCapacity T)
        ![(histOffered 0 h : ℝ), (histOffered 1 h : ℝ)] -
        histRev T r₁ r₂ h :=
    sub_nonneg.mpr (histRev_le_piValue r₁ r₂ hr₂ hr T h)
  by_cases hG : EventG T h
  · rw [indR_true hG, mul_one]
    rcases hG with ⟨⟨hq1, hq2, hB⟩, hq3, hq4⟩
    set r := T % 3
    have hT_eq : 3 * n + r = T := Nat.div_add_mod T 3
    -- Decompose `h` into the 4 slices
    have hsplit : h = h.take n ++ (h.drop n).take n ++
        (h.drop (2 * n)).take n ++ (h.drop (3 * n)).take r := by
      have hfull : h.take (3 * n + r) = h := by
        rw [hT_eq, ← hlen, List.take_length]
      have ha1 := list_take_add (3 * n) r h
      have ha2 := list_take_add (2 * n) n h
      have ha3 := list_take_add n n h
      have h2n : n + n = 2 * n := by omega
      have h3n : 2 * n + n = 3 * n := by omega
      rw [h2n] at ha3
      rw [h3n] at ha2
      conv_lhs => rw [← hfull]
      rw [ha1, ha2, ha3]
    have hoff_sum : histOffered 0 h =
        histOffered 0 (h.take n) + histOffered 0 ((h.drop n).take n) +
          histOffered 0 ((h.drop (2 * n)).take n) + histOffered 0 ((h.drop (3 * n)).take r) := by
      conv_lhs => rw [hsplit]
      simp [histOffered_append, Nat.add_assoc]
    unfold EventQ1 at hq1; dsimp only at hq1
    unfold EventQ2 at hq2; dsimp only at hq2
    unfold EventQ3 at hq3; dsimp only at hq3
    have hq2_n := abs_le.mp (hq2 n le_rfl)
    have hT_le_off : T ≤ histOffered 0 h := by
      have hreal : (T : ℝ) ≤ (histOffered 0 h : ℝ) := by
        have hT_cast : (T : ℝ) = 3 * (n : ℝ) + (r : ℝ) := by exact_mod_cast hT_eq.symm
        have hoff_cast : (histOffered 0 h : ℝ) =
            (histOffered 0 (h.take n) : ℝ) + (histOffered 0 ((h.drop n).take n) : ℝ) +
              (histOffered 0 ((h.drop (2 * n)).take n) : ℝ) +
              (histOffered 0 ((h.drop (3 * n)).take r) : ℝ) := by
          exact_mod_cast hoff_sum
        have hq4_cast : (histOffered 0 ((h.drop (3 * n)).take r) : ℝ) = (r : ℝ) := by
          exact_mod_cast hq4
        change (n : ℝ) - 4 * s ≤ _ ∧ _ ≤ (n : ℝ) - 3 * s at hq1
        change -(2 * s) ≤ (histOffered 0 ((h.drop n).take n) : ℝ) - (n : ℝ) ∧
          (histOffered 0 ((h.drop n).take n) : ℝ) - (n : ℝ) ≤ 2 * s at hq2_n
        change (n : ℝ) + 6 * s ≤ _ ∧ _ ≤ (n : ℝ) + 7 * s at hq3
        linarith [hq1.1, hq2_n.1, hq3.1]
      exact_mod_cast hreal
    rw [piValue_tcInst_eq_of_ge r₁ r₂ hr₂ hr T _ _ hT_le_off]
    have hadm_sum : (admHigh T h : ℝ) + (admLow T h : ℝ) ≤ (T : ℝ) := by
      have hc := capAfter_add_adm T h
      have hle : admHigh T h + admLow T h ≤ T := by omega
      exact_mod_cast hle
    unfold histRev
    rcases hB with hbstar | hb1
    · unfold EventBStar at hbstar; dsimp only at hbstar
      change s / 6 ≤ (admLow T (h.take (2 * n)) : ℝ) at hbstar
      have hmono : admLow T (h.take (2 * n)) ≤ admLow T h := by
        conv_rhs => rw [← List.take_append_drop (2 * n) h]
        exact admLow_mono_append T _ _
      have hlow : s / 6 ≤ (admLow T h : ℝ) :=
        le_trans hbstar (by exact_mod_cast hmono)
      have hr₁ : 0 < r₁ := lt_trans hr₂ hr
      nlinarith
    · unfold EventB1 at hb1; dsimp only at hb1
      change (admHigh T (h.take n) : ℝ) < (n : ℝ) - 10 * s at hb1
      change -(2 * s) ≤ (histOffered 0 ((h.drop n).take n) : ℝ) - (n : ℝ) ∧
        (histOffered 0 ((h.drop n).take n) : ℝ) - (n : ℝ) ≤ 2 * s at hq2_n
      change (n : ℝ) + 6 * s ≤ _ ∧ _ ≤ (n : ℝ) + 7 * s at hq3
      have hrest : h = h.take n ++
          ((h.drop n).take n ++ (h.drop (2 * n)).take n ++ (h.drop (3 * n)).take r) := by
        simpa [List.append_assoc] using hsplit
      have hadm_ub : admHigh T h ≤ admHigh T (h.take n) +
          (histOffered 0 ((h.drop n).take n) + histOffered 0 ((h.drop (2 * n)).take n) +
            histOffered 0 ((h.drop (3 * n)).take r)) := by
        have h1 : admHigh T h ≤ admHigh T (h.take n) +
            histOffered 0 ((h.drop n).take n ++ (h.drop (2 * n)).take n ++ (h.drop (3 * n)).take r) := by
          conv_lhs => rw [hrest]
          exact admHigh_append_le T _ _
        simpa [histOffered_append, Nat.add_assoc] using h1
      have hadm_lt : (admHigh T h : ℝ) < (T : ℝ) - s := by
        have hT_cast : (T : ℝ) = 3 * (n : ℝ) + (r : ℝ) := by exact_mod_cast hT_eq.symm
        have hub_cast : (admHigh T h : ℝ) ≤ (admHigh T (h.take n) : ℝ) +
            ((histOffered 0 ((h.drop n).take n) : ℝ) +
              (histOffered 0 ((h.drop (2 * n)).take n) : ℝ) +
              (histOffered 0 ((h.drop (3 * n)).take r) : ℝ)) := by
          exact_mod_cast hadm_ub
        have hq4_cast : (histOffered 0 ((h.drop (3 * n)).take r) : ℝ) = (r : ℝ) := by
          exact_mod_cast hq4
        linarith [hb1, hq2_n.2, hq3.2]
      have hs_nn : 0 ≤ s := Real.sqrt_nonneg _
      nlinarith
  · rw [indR_false hG, mul_zero]
    exact hnonneg

/-! ### Accumulators for `frozenQ2` and `gatedLowSum` -/

noncomputable def frozenQ2Step (T : ℕ) (st : History × ℝ) (w : Window) : History × ℝ :=
  let h := st.1
  let n := T / 3
  let s := Real.sqrt (n : ℝ)
  let dy := if n ≤ h.length ∧ h.length < 2 * n ∧ |st.2| ≤ 2 * s then
      (winOffered 0 w : ℝ) - 1
    else 0
  (h ++ [w], st.2 + dy)

noncomputable def frozenQ2 (T : ℕ) (h : History) : ℝ :=
  (h.foldl (frozenQ2Step T) ([], 0)).2

private lemma foldl_frozenQ2Step_fst (T : ℕ) (h₀ s : History) (acc : ℝ) :
    (s.foldl (frozenQ2Step T) (h₀, acc)).1 = h₀ ++ s := by
  induction s generalizing h₀ acc with
  | nil => simp
  | cons w tl ih =>
    simp only [List.foldl_cons, frozenQ2Step]
    rw [ih]
    simp [List.append_assoc]

lemma frozenQ2_append_singleton (T : ℕ) (h : History) (w : Window) :
    let n := T / 3
    let s := Real.sqrt (n : ℝ)
    frozenQ2 T (h ++ [w]) = frozenQ2 T h +
      (if n ≤ h.length ∧ h.length < 2 * n ∧ |frozenQ2 T h| ≤ 2 * s then
        (winOffered 0 w : ℝ) - 1
      else 0) := by
  unfold frozenQ2
  rw [List.foldl_append]
  rcases hst : h.foldl (frozenQ2Step T) ([], 0) with ⟨h_out, y_out⟩
  have hfst := foldl_frozenQ2Step_fst T [] h 0
  rw [hst, List.nil_append] at hfst
  dsimp only at hfst
  subst hfst
  simp [frozenQ2Step]

lemma frozenQ2_of_len_le (T : ℕ) {h : History} (hlen : h.length ≤ T / 3) :
    frozenQ2 T h = 0 := by
  induction h using List.reverseRecOn with
  | nil => simp [frozenQ2]
  | append_singleton h' w ih =>
    simp only [List.length_append, List.length_singleton] at hlen
    rw [frozenQ2_append_singleton, ih (by omega)]
    have hnot : ¬ (T / 3 ≤ h'.length) := by omega
    simp [hnot]

lemma frozenQ2_gt_of_not_eventQ2 (T : ℕ) {h₁ s₂ : History}
    (hlen₁ : h₁.length = T / 3) (hlen₂ : s₂.length = T / 3)
    (hnot : ¬ EventQ2 T (h₁ ++ s₂)) :
    2 * Real.sqrt ((T / 3 : ℕ) : ℝ) < |frozenQ2 T (h₁ ++ s₂)| := by
  classical
  set n := T / 3
  set s := Real.sqrt (n : ℝ)
  unfold EventQ2 at hnot
  dsimp only at hnot
  push Not at hnot
  have hex : ∃ i, i ≤ n ∧ 2 * s < |(histOffered 0 (((h₁ ++ s₂).drop n).take i) : ℝ) - (i : ℝ)| := hnot
  -- Notice `(h₁ ++ s₂).drop n = s₂` since `h₁.length = n`.
  have hdrop : (h₁ ++ s₂).drop n = s₂ := by simp [hlen₁]
  rw [hdrop] at hex
  let i₀ := Nat.find hex
  have hi₀_spec := Nat.find_spec hex
  have hi₀_min : ∀ j < i₀, |(histOffered 0 (s₂.take j) : ℝ) - (j : ℝ)| ≤ 2 * s := by
    intro j hj
    have hlt := Nat.find_min hex hj
    push Not at hlt
    exact hlt (le_trans (le_of_lt hj) hi₀_spec.1)
  -- Up to `i₀`, `frozenQ2 T (h₁ ++ s₂.take j)` equals `(histOffered 0 (s₂.take j) : ℝ) - j`.
  have htrack : ∀ j ≤ i₀,
      frozenQ2 T (h₁ ++ s₂.take j) = (histOffered 0 (s₂.take j) : ℝ) - (j : ℝ) := by
    intro j hj
    induction j with
    | zero =>
      simp [frozenQ2_of_len_le T (le_of_eq hlen₁)]
    | succ j ih =>
      have hjlt : j < i₀ := Nat.lt_of_succ_le hj
      have hjs₂ : j < s₂.length := by omega
      have htake_succ : s₂.take (j + 1) = s₂.take j ++ [s₂[j]] := List.take_succ_eq_append_getElem hjs₂
      rw [htake_succ, ← List.append_assoc, frozenQ2_append_singleton]
      have hprev := ih (le_of_lt hjlt)
      have hlen_cur : (h₁ ++ s₂.take j).length = n + j := by
        simp [hlen₁, List.length_take, min_eq_left (le_of_lt hjs₂)]
      have hcond : n ≤ (h₁ ++ s₂.take j).length ∧ (h₁ ++ s₂.take j).length < 2 * n ∧
          |frozenQ2 T (h₁ ++ s₂.take j)| ≤ 2 * s := by
        refine ⟨by omega, by omega, ?_⟩
        rw [hprev]
        exact hi₀_min j hjlt
      rw [if_pos hcond, hprev, histOffered_append, histOffered_singleton]
      push_cast; ring
  -- From `i₀` to `n`, `frozenQ2` stays frozen at `frozenQ2 T (h₁ ++ s₂.take i₀)`.
  have hfreeze : ∀ j, i₀ ≤ j → j ≤ n →
      frozenQ2 T (h₁ ++ s₂.take j) = frozenQ2 T (h₁ ++ s₂.take i₀) := by
    intro j hji hjn
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hji
    induction d with
    | zero => simp
    | succ d ih =>
      have hlt : i₀ + d < s₂.length := by omega
      have htake_succ : s₂.take (i₀ + (d + 1)) = s₂.take (i₀ + d) ++ [s₂[i₀ + d]] := by
        rw [← Nat.add_assoc]; exact List.take_succ_eq_append_getElem hlt
      rw [htake_succ, ← List.append_assoc, frozenQ2_append_singleton]
      have hprev := ih (by omega) (by omega)
      have hbig : ¬ (|frozenQ2 T (h₁ ++ s₂.take (i₀ + d))| ≤ 2 * s) := by
        rw [hprev, htrack i₀ le_rfl]
        exact not_le.mpr hi₀_spec.2
      have hcond : ¬ (n ≤ (h₁ ++ s₂.take (i₀ + d)).length ∧
          (h₁ ++ s₂.take (i₀ + d)).length < 2 * n ∧
          |frozenQ2 T (h₁ ++ s₂.take (i₀ + d))| ≤ 2 * s) :=
        fun hc => hbig hc.2.2
      rw [if_neg hcond, add_zero, hprev]
  have hfinal := hfreeze n hi₀_spec.1 le_rfl
  have htake_all : s₂.take n = s₂ := by simp [hlen₂]
  rw [htake_all, htrack i₀ le_rfl] at hfinal
  rw [hfinal]
  exact hi₀_spec.2

noncomputable def gatedLowStep (T : ℕ) (st : History × ℝ) (w : Window) : History × ℝ :=
  let h := st.1
  let n := T / 3
  let s := Real.sqrt (n : ℝ)
  let p_low := canonicalPolicy T h 1
  let xi := if n ≤ h.length ∧ h.length < 2 * n ∧ p_low ≤ 12 / s then
      p_low - (winEnabled 1 w : ℝ)
    else 0
  (h ++ [w], st.2 + xi)

noncomputable def gatedLowSum (T : ℕ) (h : History) : ℝ :=
  (h.foldl (gatedLowStep T) ([], 0)).2

private lemma foldl_gatedLowStep_fst (T : ℕ) (h₀ s : History) (acc : ℝ) :
    (s.foldl (gatedLowStep T) (h₀, acc)).1 = h₀ ++ s := by
  induction s generalizing h₀ acc with
  | nil => simp
  | cons w tl ih =>
    simp only [List.foldl_cons, gatedLowStep]
    rw [ih]
    simp [List.append_assoc]

lemma gatedLowSum_append_singleton (T : ℕ) (h : History) (w : Window) :
    let n := T / 3
    let s := Real.sqrt (n : ℝ)
    let p_low := canonicalPolicy T h 1
    gatedLowSum T (h ++ [w]) = gatedLowSum T h +
      (if n ≤ h.length ∧ h.length < 2 * n ∧ p_low ≤ 12 / s then
        p_low - (winEnabled 1 w : ℝ)
      else 0) := by
  unfold gatedLowSum
  rw [List.foldl_append]
  rcases hst : h.foldl (gatedLowStep T) ([], 0) with ⟨h_out, y_out⟩
  have hfst := foldl_gatedLowStep_fst T [] h 0
  rw [hst, List.nil_append] at hfst
  dsimp only at hfst
  subst hfst
  simp [gatedLowStep]

lemma gatedLowSum_of_len_le (T : ℕ) {h : History} (hlen : h.length ≤ T / 3) :
    gatedLowSum T h = 0 := by
  induction h using List.reverseRecOn with
  | nil => simp [gatedLowSum]
  | append_singleton h' w ih =>
    simp only [List.length_append, List.length_singleton] at hlen
    rw [gatedLowSum_append_singleton, ih (by omega)]
    have hnot : ¬ (T / 3 ≤ h'.length) := by omega
    simp [hnot]

/-! ### Deterministic Phase-Two Argument on Supported Paths in `EventE` -/

theorem gatedLowSum_gt_on_EventE
    (T : ℕ) (hn4 : 4 ≤ T / 3) {h : History}
    (hsupp : ExtSupported (canonicalPolicy T) (2 * (T / 3)) [] h)
    (hE : EventE T h) :
    Real.sqrt ((T / 3 : ℕ) : ℝ) / 6 < gatedLowSum T h := by
  set n := T / 3
  set r := T % 3
  set s := Real.sqrt (n : ℝ)
  have hT_eq : 3 * n + r = T := Nat.div_add_mod T 3
  have hr_le : r ≤ 2 := Nat.lt_succ_iff.mp (Nat.mod_lt T (by norm_num))
  have hlen : h.length = 2 * n := by simpa using hsupp.length_eq
  have hs_pos : 0 < s := Real.sqrt_pos.mpr (by exact_mod_cast (by omega : 0 < n))
  have hs_sq : s * s = (n : ℝ) := Real.mul_self_sqrt (Nat.cast_nonneg n)
  have hs_ge2 : 2 ≤ s := by
    have h4 : (4 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn4
    have hsq4 : Real.sqrt 4 ≤ s := Real.sqrt_le_sqrt h4
    have h2 : Real.sqrt 4 = 2 := by norm_num
    linarith
  rcases hE with ⟨hq1, hq2, hnbstar, hnb1⟩
  unfold EventQ1 at hq1; dsimp only at hq1
  change (n : ℝ) - 4 * s ≤ (histOffered 0 (h.take n) : ℝ) ∧
    (histOffered 0 (h.take n) : ℝ) ≤ (n : ℝ) - 3 * s at hq1
  unfold EventQ2 at hq2; dsimp only at hq2
  change ∀ i ≤ n, |(histOffered 0 ((h.drop n).take i) : ℝ) - (i : ℝ)| ≤ 2 * s at hq2
  have htake_all : h.take (2 * n) = h := by simp [hlen]
  have hlow_lt : (admLow T h : ℝ) < s / 6 := by
    unfold EventBStar at hnbstar; dsimp only at hnbstar
    change ¬ (s / 6 ≤ (admLow T (h.take (2 * n)) : ℝ)) at hnbstar
    rw [htake_all] at hnbstar
    exact not_le.mp hnbstar
  have hhigh_n_ge : (n : ℝ) - 10 * s ≤ (admHigh T (h.take n) : ℝ) := by
    unfold EventB1 at hnb1; dsimp only at hnb1
    change ¬ ((admHigh T (h.take n) : ℝ) < (n : ℝ) - 10 * s) at hnb1
    exact not_lt.mp hnb1
  -- Step 1: No capacity truncation (`1 ≤ capAfter T h`).
  have hcap_pos : 1 ≤ capAfter T h := by
    have hsplit2 : h = h.take n ++ (h.drop n).take n := by
      have ha := list_take_add n n h
      have h2n : n + n = 2 * n := by omega
      rw [h2n, htake_all] at ha
      exact ha
    have hoff2 : histOffered 0 h =
        histOffered 0 (h.take n) + histOffered 0 ((h.drop n).take n) := by
      conv_lhs => rw [hsplit2]
      exact histOffered_append 0 _ _
    have hq2_n := (abs_le.mp (hq2 n le_rfl)).2
    have hadm_high_ub : (admHigh T h : ℝ) ≤ 2 * (n : ℝ) - s := by
      have h1 : (admHigh T h : ℝ) ≤ (histOffered 0 h : ℝ) := by
        exact_mod_cast admHigh_le_offered T h
      have h2 : (histOffered 0 h : ℝ) =
          (histOffered 0 (h.take n) : ℝ) + (histOffered 0 ((h.drop n).take n) : ℝ) := by
        exact_mod_cast hoff2
      linarith [hq1.2, hq2_n]
    have hsum_adm := capAfter_add_adm T h
    have hsum_cast : (capAfter T h : ℝ) + (admHigh T h : ℝ) + (admLow T h : ℝ) = (T : ℝ) := by
      exact_mod_cast hsum_adm
    have hT_ge : 3 * (n : ℝ) ≤ (T : ℝ) := by
      have : 3 * n ≤ T := by omega
      exact_mod_cast this
    have hcap_real : (0 : ℝ) < (capAfter T h : ℝ) := by nlinarith
    have hcap_ne : capAfter T h ≠ 0 := by
      intro hz; simp [hz] at hcap_real
    omega
  -- Every prefix `h.take m` (`m ≤ 2 * n`) has positive capacity, hence `adm = histEnabled`.
  have hprefix_notrunc : ∀ m ≤ 2 * n,
      admHigh T (h.take m) = histEnabled 0 (h.take m) ∧
        admLow T (h.take m) = histEnabled 1 (h.take m) := by
    intro m _
    have hcap_m : 1 ≤ capAfter T (h.take m) := by
      have hm : capAfter T h ≤ capAfter T (h.take m) := by
        conv_lhs => rw [← List.take_append_drop m h]
        exact capAfter_mono_append T _ _
      omega
    exact adm_eq_enabled_of_pos_cap T (h.take m) hcap_m
  -- Step 2: Lower bound on `b(n + i) - 1` and `p_high(n + i) = 1` for all `i < n`.
  have h_b_lower : ∀ i < n,
      let ht := h.take (n + i)
      1 / (3 * s) ≤ (capAfter T ht : ℝ) / ((T - (n + i) : ℕ) : ℝ) - 1 ∧
        canonicalPolicy T ht 0 = 1 := by
    intro i hi
    dsimp only
    set ht := h.take (n + i)
    have hlen_ht : ht.length = n + i := by
      simp [ht, List.length_take, hlen, min_eq_left (by omega : n + i ≤ 2 * n)]
    have hsplit_i : ht = h.take n ++ (h.drop n).take i := list_take_add n i h
    have hoff_i : (histOffered 0 ht : ℝ) ≤ (n : ℝ) + (i : ℝ) - s := by
      have heq : histOffered 0 ht =
          histOffered 0 (h.take n) + histOffered 0 ((h.drop n).take i) := by
        rw [hsplit_i, histOffered_append]
      have hcast : (histOffered 0 ht : ℝ) =
          (histOffered 0 (h.take n) : ℝ) + (histOffered 0 ((h.drop n).take i) : ℝ) := by
        exact_mod_cast heq
      have hq2_i := (abs_le.mp (hq2 i (le_of_lt hi))).2
      linarith [hq1.2, hq2_i]
    have hadm_hi : (admHigh T ht : ℝ) ≤ (n : ℝ) + (i : ℝ) - s :=
      le_trans (by exact_mod_cast admHigh_le_offered T ht) hoff_i
    have hadm_lo : (admLow T ht : ℝ) < s / 6 := by
      refine lt_of_le_of_lt ?_ hlow_lt
      have hm : admLow T ht ≤ admLow T h := by
        conv_rhs => rw [← List.take_append_drop (n + i) h]
        exact admLow_mono_append T _ _
      exact_mod_cast hm
    have hrem_pos : 0 < T - (n + i) := by omega
    have hrem_posR : (0 : ℝ) < ((T - (n + i) : ℕ) : ℝ) := by exact_mod_cast hrem_pos
    have hcap_ht : ((T - (n + i) : ℕ) : ℝ) + 5 * s / 6 < (capAfter T ht : ℝ) := by
      have hc := capAfter_add_adm T ht
      have hcR : (capAfter T ht : ℝ) + (admHigh T ht : ℝ) + (admLow T ht : ℝ) = (T : ℝ) := by
        exact_mod_cast hc
      have hsubR : ((T - (n + i) : ℕ) : ℝ) = (T : ℝ) - ((n : ℝ) + (i : ℝ)) := by
        rw [Nat.cast_sub (by omega : n + i ≤ T), Nat.cast_add]
      linarith
    have hrem_ub : ((T - (n + i) : ℕ) : ℝ) ≤ (5 / 2 : ℝ) * (n : ℝ) := by
      have hnat : 2 * (T - (n + i)) ≤ 5 * n := by omega
      have hR : (2 : ℝ) * ((T - (n + i) : ℕ) : ℝ) ≤ 5 * (n : ℝ) := by exact_mod_cast hnat
      linarith
    have hratio : 1 / (3 * s) ≤ (capAfter T ht : ℝ) / ((T - (n + i) : ℕ) : ℝ) - 1 := by
      have h1 : (5 * s / 6) / ((T - (n + i) : ℕ) : ℝ) ≤
          (capAfter T ht : ℝ) / ((T - (n + i) : ℕ) : ℝ) - 1 := by
        rw [le_sub_iff_add_le, div_add_one (ne_of_gt hrem_posR),
          div_le_div_iff_of_pos_right hrem_posR]
        linarith
      refine le_trans ?_ h1
      rw [div_le_div_iff₀ (by positivity : 0 < 3 * s) hrem_posR]
      calc
        1 * ((T - (n + i) : ℕ) : ℝ) ≤ (5 / 2 : ℝ) * (n : ℝ) := by linarith
        _ = (5 / 2 : ℝ) * (s * s) := by rw [hs_sq]
        _ = (5 * s / 6) * (3 * s) := by ring
    refine ⟨hratio, ?_⟩
    unfold canonicalPolicy canonicalProb
    rw [hlen_ht]
    simp only [Matrix.cons_val_zero]
    exact min_eq_right (by linarith [div_nonneg zero_le_one (by positivity : 0 ≤ 3 * s)])
  -- Step 3: Supported Phase-2 windows have `winEnabled 0 = winOffered 0`.
  have hwin_eq : ∀ i < n, ∀ (hj : n + i < h.length),
      winEnabled 0 (h[n + i]) = winOffered 0 (h[n + i]) := by
    intro i hi hj
    have hmw := hsupp.getElem_markWeight_pos (n + i) (by omega) (by simpa using hj)
    have hget0 : h[List.length ([] : History) + (n + i)]'(by simpa using hj) = h[n + i] := by
      simp
    have htake0 : List.take (List.length ([] : History) + (n + i)) h = h.take (n + i) := by
      simp
    rw [hget0, htake0] at hmw
    exact winEnabled_zero_eq_winOffered_of_markWeight_pos (h_b_lower i hi).2 hmw
  have hphase2_enabled_eq : ∀ i ≤ n,
      histEnabled 0 ((h.drop n).take i) = histOffered 0 ((h.drop n).take i) := by
    intro i hi
    induction i with
    | zero => simp
    | succ k ih =>
      have hklt : k < n := Nat.lt_of_succ_le hi
      have hdrop_len : k < (h.drop n).length := by simp [hlen]; omega
      have htake_succ : (h.drop n).take (k + 1) = (h.drop n).take k ++ [(h.drop n)[k]] :=
        List.take_succ_eq_append_getElem hdrop_len
      have hget_eq : (h.drop n)[k] = h[n + k]'(by omega) := by simp
      rw [htake_succ, hget_eq, histEnabled_append, histOffered_append,
        histEnabled_singleton, histOffered_singleton, ih (le_of_lt hklt),
        hwin_eq k hklt (by omega)]
  -- Step 4: Upper bound on `b(n + i) - 1 ≤ 12 / s` and `1 / (3 * s) ≤ p_low(n + i) ≤ 12 / s`.
  have hp_low_bounds : ∀ i < n,
      let ht := h.take (n + i)
      1 / (3 * s) ≤ canonicalPolicy T ht 1 ∧ canonicalPolicy T ht 1 ≤ 12 / s := by
    intro i hi
    dsimp only
    set ht := h.take (n + i)
    have hlen_ht : ht.length = n + i := by
      simp [ht, List.length_take, hlen, min_eq_left (by omega : n + i ≤ 2 * n)]
    have hnotrunc_ht : admHigh T ht = histEnabled 0 ht := (hprefix_notrunc (n + i) (by omega)).1
    have hnotrunc_n := (hprefix_notrunc n (by omega)).1
    have hsplit_i : ht = h.take n ++ (h.drop n).take i := list_take_add n i h
    have hadm_lb : (n : ℝ) + (i : ℝ) - 12 * s ≤ (admHigh T ht : ℝ) := by
      have heq : admHigh T ht = admHigh T (h.take n) + histOffered 0 ((h.drop n).take i) := by
        rw [hnotrunc_ht, hsplit_i, histEnabled_append, ← hnotrunc_n,
          hphase2_enabled_eq i (le_of_lt hi)]
      have hcast : (admHigh T ht : ℝ) =
          (admHigh T (h.take n) : ℝ) + (histOffered 0 ((h.drop n).take i) : ℝ) := by
        exact_mod_cast heq
      have hq2_i := (abs_le.mp (hq2 i (le_of_lt hi))).1
      linarith [hhigh_n_ge, hq2_i]
    have hrem_pos : 0 < T - (n + i) := by omega
    have hrem_posR : (0 : ℝ) < ((T - (n + i) : ℕ) : ℝ) := by exact_mod_cast hrem_pos
    have hrem_lb : (n : ℝ) ≤ ((T - (n + i) : ℕ) : ℝ) := by
      have : n ≤ T - (n + i) := by omega
      exact_mod_cast this
    have hcap_ub : (capAfter T ht : ℝ) ≤ ((T - (n + i) : ℕ) : ℝ) + 12 * s := by
      have hc := capAfter_add_adm T ht
      have hcR : (capAfter T ht : ℝ) + (admHigh T ht : ℝ) + (admLow T ht : ℝ) = (T : ℝ) := by
        exact_mod_cast hc
      have hsubR : ((T - (n + i) : ℕ) : ℝ) = (T : ℝ) - ((n : ℝ) + (i : ℝ)) := by
        rw [Nat.cast_sub (by omega : n + i ≤ T), Nat.cast_add]
      have hlo_nn : (0 : ℝ) ≤ (admLow T ht : ℝ) := by positivity
      linarith
    have h_b_upper : (capAfter T ht : ℝ) / ((T - (n + i) : ℕ) : ℝ) - 1 ≤ 12 / s := by
      have h1 : (capAfter T ht : ℝ) / ((T - (n + i) : ℕ) : ℝ) - 1 ≤
          (12 * s) / ((T - (n + i) : ℕ) : ℝ) := by
        rw [sub_le_iff_le_add]
        have hcomb : (12 * s) / ((T - (n + i) : ℕ) : ℝ) + 1 =
            (((T - (n + i) : ℕ) : ℝ) + 12 * s) / ((T - (n + i) : ℕ) : ℝ) := by
          field_simp [ne_of_gt hrem_posR]; ring
        rw [hcomb, div_le_div_iff_of_pos_right hrem_posR]
        exact hcap_ub
      refine le_trans h1 ?_
      rw [div_le_div_iff₀ hrem_posR hs_pos]
      calc
        12 * s * s = 12 * (s * s) := by ring
        _ = 12 * (n : ℝ) := by rw [hs_sq]
        _ ≤ 12 * ((T - (n + i) : ℕ) : ℝ) := by linarith
    have h_b_lo := (h_b_lower i hi).1
    have h1_3s_nn : 0 ≤ 1 / (3 * s) := by positivity
    have h1_3s_le1 : 1 / (3 * s) ≤ 1 := by
      rw [div_le_one (by positivity : 0 < 3 * s)]
      linarith
    have hpol1 : canonicalPolicy T ht 1 =
        min (max ((capAfter T ht : ℝ) / ((T - (n + i) : ℕ) : ℝ) - 1) 0) 1 := by
      unfold canonicalPolicy canonicalProb
      rw [hlen_ht]
      simp
    rw [hpol1, max_eq_left (le_trans h1_3s_nn h_b_lo)]
    exact ⟨le_min h_b_lo h1_3s_le1, le_trans (min_le_left _ _) h_b_upper⟩
  -- Step 5: Accumulate `gatedLowSum` across Phase 2 (`i = 0 .. n`).
  have hacc : ∀ i ≤ n,
      (i : ℝ) / (3 * s) - (histEnabled 1 ((h.drop n).take i) : ℝ) ≤
        gatedLowSum T (h.take (n + i)) := by
    intro i hi
    induction i with
    | zero =>
      have hlen_n : (h.take n).length ≤ n := List.length_take_le n h
      simp [gatedLowSum_of_len_le T hlen_n]
    | succ k ih =>
      have hklt : k < n := Nat.lt_of_succ_le hi
      have htake_step : h.take (n + (k + 1)) = h.take (n + k) ++ [h[n + k]'(by omega)] := by
        rw [← Nat.add_assoc]
        exact List.take_succ_eq_append_getElem (by omega)
      have hdrop_len : k < (h.drop n).length := by simp [hlen]; omega
      have hdrop_step : (h.drop n).take (k + 1) = (h.drop n).take k ++ [h[n + k]'(by omega)] := by
        rw [List.take_succ_eq_append_getElem hdrop_len]
        simp
      rw [htake_step, gatedLowSum_append_singleton, hdrop_step, histEnabled_append,
        histEnabled_singleton]
      have hlen_nk : (h.take (n + k)).length = n + k := by
        simp [List.length_take, hlen, min_eq_left (by omega : n + k ≤ 2 * n)]
      have hpb := hp_low_bounds k hklt
      dsimp only at hpb
      have hgate : n ≤ (h.take (n + k)).length ∧ (h.take (n + k)).length < 2 * n ∧
          canonicalPolicy T (h.take (n + k)) 1 ≤ 12 / s :=
        ⟨by omega, by omega, hpb.2⟩
      rw [if_pos hgate]
      have hprev := ih (le_of_lt hklt)
      have h1 : (k : ℝ) / (3 * s) + 1 / (3 * s) = ((k + 1 : ℕ) : ℝ) / (3 * s) := by
        push_cast; ring
      push_cast at h1 ⊢
      linarith [hpb.1, hprev, h1]
  have hfinal := hacc n le_rfl
  have h2n_eq : n + n = 2 * n := by omega
  rw [h2n_eq, htake_all] at hfinal
  have hns : (n : ℝ) / (3 * s) = s / 3 := by
    have hs_ne : s ≠ 0 := ne_of_gt hs_pos
    rw [← hs_sq]
    field_simp [hs_ne]
  have hen_low_le : (histEnabled 1 ((h.drop n).take n) : ℝ) < s / 6 := by
    have hsplit2 : h = h.take n ++ (h.drop n).take n := by
      have ha := list_take_add n n h
      rw [h2n_eq, htake_all] at ha
      exact ha
    have hnt := (hprefix_notrunc (2 * n) le_rfl).2
    rw [htake_all] at hnt
    have hle_nat : histEnabled 1 ((h.drop n).take n) ≤ admLow T h := by
      rw [hnt]
      conv_rhs => rw [hsplit2]
      rw [histEnabled_append]
      omega
    exact lt_of_le_of_lt (by exact_mod_cast hle_nat) hlow_lt
  linarith

end ResolvingNRM.FRLower.ProofPlan
