  have hFrob : ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, P.IsFrobeniusAt σ lam →
      ∀ v : ρ.V, ρ.ρ σ v - algebraMap O' O'' α₀ • v ∈ L := by
    intro σ hσ
    have hσD : σ ∈ P.decompositionSubgroup ℚ := hσ.fst
    have hfL : ∀ x ∈ L, ρ.ρ σ x ∈ L := hD σ hσD

    let β : O'' := π (ρ.ρ σ (b 1))
