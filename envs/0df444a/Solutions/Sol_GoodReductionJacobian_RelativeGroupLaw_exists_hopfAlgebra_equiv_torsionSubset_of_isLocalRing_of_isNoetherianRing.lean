theorem solution
    {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) (hA : AbelianSchemePropertyBundle S f) (n : ℕ) (hn : n ≠ 0)
    {R : Type} [CommRing R] [IsNoetherianRing R] [IsLocalRing R]
    (ι : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S)) :
    ∃ (H : Type) (_ : CommRing H) (_ : HopfAlgebra R H) (_ : Module.Finite R H) (_ : Module.Free R H)
      (_ : Coalgebra.IsCocomm R H)
      (e : ∀ (T : Type) [CommRing T] [Algebra R T],
        WithConv (H →ₐ[R] T) ≃ L.torsionSubset (Spec.map (CommRingCat.ofHom (algebraMap R T)) ≫ ι) n),
      (∀ (T : Type) [CommRing T] [Algebra R T] (φ ψ : WithConv (H →ₐ[R] T)),
        ((e T (φ * ψ)).val : SchemeHomOver _ f) = L.mul _ (e T φ).val (e T ψ).val) ∧
      (∀ (T T' : Type) [CommRing T] [Algebra R T] [CommRing T'] [Algebra R T']
          (g : T →ₐ[R] T') (φ : WithConv (H →ₐ[R] T)),
        ((e T' (.toConv (g.comp φ.ofConv))).val : SchemeHomOver _ f).1 =
          Spec.map (CommRingCat.ofHom g.toRingHom) ≫ (e T φ).val.1) := by

  let f' : pullback f ι ⟶ Spec (CommRingCat.of R) := pullback.snd f ι
  let L' : RelativeGroupLaw R f' := L.baseChange ι
  have hA' : AbelianSchemePropertyBundle R f' :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.of_isPullback hA (IsPullback.of_hasPullback f ι)
  have hc' : L'.IsCommutative := GoodReductionJacobian.AbelianSchemePropertyBundle.isCommutative hA' L'
  haveI : Smooth f' := hA'.smooth
  obtain ⟨g, hg⟩ := GoodReductionJacobian.RelativeGroupLaw.exists_smoothOfRelativeDimension_of_smooth_of_isLocalRing L'
  haveI := hg
  obtain ⟨-, -, -, -, hfin, hflat, -, -⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.isFinite_flat_schemeKerStr_and_schemeNsmul_of_abelianSchemePropertyBundle
      L' hc' hA' g n hn
  obtain ⟨H, iH, hopf, hfinH, hflatH, hcoc, e', he'_mul, he'_nat⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_hopfAlgebra_torsion_of_isFinite_of_flat_schemeNsmul
      L' (fun t x y => hc' t x y) n hfin hflat
  haveI := hfinH; haveI := hflatH
  haveI hfree : Module.Free R H := Module.free_of_flat_of_isLocalRing
  refine ⟨H, iH, hopf, hfinH, hfree, hcoc,
    fun T _ _ => (e' T).trans (torsionEquiv L ι (Spec.map (CommRingCat.ofHom (algebraMap R T))) n), ?_, ?_⟩
  · intro T _ _ φ ψ
    show baseChangePointToBase ι (e' T (φ * ψ)).val = _
    rw [he'_mul, baseChangePointToBase_mul]
    rfl
  · intro T T' _ _ _ _ g φ
    show (baseChangePointToBase ι (e' T' (.toConv (g.comp φ.ofConv))).val).1 = _
    rw [baseChangePointToBase_coe, he'_nat, Category.assoc]
    rfl

end S_GoodReductionJacobian_RelativeGroupLaw_exists_hopfAlgebra_equiv_torsionSubset_of_isLocalRing_of_isNoetherianRing
