-- Source module: Solutions.J6SegILSlab7
/-!
# B-line IL, B1 (streaming slab pass) §7: the passes on plain register states

* **`passZ_runs`** (integer lane): from `encK s F` with `F 0 = xs ++ l` and the skeleton inputs
  (`rC` the control list `flatC cs ++ RC`, `rACC` empty, the counts on `rNB rNC rM rTOT`, the
  `rptX` counters empty) the pass leaves `passOut … ++ l` on stack `0`, everything else as it was.
* **`passP_runs`** (pair lane): the same with `F 0 = xs.map fst ++ l`, `F rZ = xs.map snd ++ l₂`;
  stack `rZ` ends as `l₂`.
* `mem_slabPass`, `length_slabPass`: the entries and the length of a slab pass.
* `blockC_le`, `passC_le`: the cost bounds `blockC ≤ 20000 (L+1)(m+1)(cu+Ba+1)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

section runsP
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {OkU : ℤ × ℤ → Prop} {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop} {g : ℤ → ℤ × ℤ → ℤ}
  {dr rd it bk : IStmt HS P} {cdr crd cit cbk : ℕ}

/-- **The pass on the pair lane.** -/
theorem passP_runs_sol_aux
    (H : UnitsOK (I := I) (iprog := iprog) linP OkU OkA KG g dr rd it bk cdr crd cit cbk)
    (s : IState HS) (F : Fin HS → List ℤ) (xs : List (ℤ × ℤ)) (l l₂ : List ℤ)
    (hF0 : F 0 = xs.map Prod.fst ++ l) (hFZ : F rZ = xs.map Prod.snd ++ l₂)
    (hK : ∀ C CU OP ARG ACC, KG (skS (update (update F 0 l) rZ l₂) C CU OP ARG ACC))
    (hA : F lA = []) (hC : F lC = []) (hD : F lD = []) (cs : List (ℤ × ℤ)) (RC : List ℤ)
    (hFC : F rC = flatC cs ++ RC) (hACC : F rACC = [])
    {m : ℕ} {LM : List ℤ} (hM : F rM = (m : ℤ) :: LM) {LN : List ℤ}
    (hN : F rNC = (cs.length : ℤ) :: LN) {Ba : ℕ} (hcs : CmdsOK OkA Ba cs) (n : ℕ)
    (hV : VC n cs 0) (hND : nDrop cs = n) (pre : ℕ) {LB : List ℤ}
    (hB : F rNB = (pre : ℤ) :: LB) (hxs : xs.length = pre * (n * m)) (hok : ∀ u ∈ xs, OkU u)
    {LT : List ℤ} (hT : F rTOT = ((passOut m g cs n pre xs).length : ℤ) :: LT) {Bo : ℕ}
    (hBo : ∀ y ∈ passOut m g cs n pre xs, zsz y ≤ Bo) :
    IRuns I iprog (passP dr rd it bk) (encK s F)
      (encK s (update (update F 0 (passOut m g cs n pre xs ++ l)) rZ l₂))
      (passC pre cs.length m Ba (cdr + crd + cit + cbk) (passOut m g cs n pre xs).length Bo) := by
  set G := update (update F 0 l) rZ l₂ with hG
  have hGx : ∀ j : Fin HS, j ≠ 0 → j ≠ rZ → G j = F j := fun j h0 hz => by
    rw [hG, update_of_ne hz, update_of_ne h0]
  have h := pass_runs H s G hK (by rw [hGx _ (by decide) (by decide)]; exact hA)
    (by rw [hGx _ (by decide) (by decide)]; exact hC) (by rw [hGx _ (by decide) (by decide)]; exact hD)
    (by rw [hGx _ (by decide) (by decide)]; exact hM) cs
    (by rw [hGx _ (by decide) (by decide)]; exact hN) hcs n hV hND
    pre (by rw [hGx _ (by decide) (by decide)]; exact hB) xs hxs hok
    (by rw [hGx _ (by decide) (by decide)]; exact hT) hBo RC (F rCU) (F rOP) (F rARG)
  have hs1 : skS G (flatC cs ++ RC) (F rCU) (F rOP) (F rARG) [] = G := by
    rw [← hFC, ← hACC, ← hGx rC (by decide) (by decide), ← hGx rCU (by decide) (by decide),
      ← hGx rOP (by decide) (by decide), ← hGx rARG (by decide) (by decide),
      ← hGx rACC (by decide) (by decide)]
    simp only [skS, update_eq_self]
  have hG0 : G 0 = l := by rw [hG, update_of_ne (by decide), update_self]
  have hGZ : G rZ = l₂ := by rw [hG, update_self]
  have e1 : linP xs [] (skS G (flatC cs ++ RC) (F rCU) (F rOP) (F rARG) []) = F := by
    rw [hs1]
    unfold linP
    rw [hG0, hGZ, ← hF0, ← hFZ]
    simp only [List.map_nil, List.nil_append]
    clear h hs1 hGx
    funext x; simp only [hG, update_apply]; split_ifs <;> (try subst_vars) <;> simp_all +decide
  have e2 : skS (update G 0 (passOut m g cs n pre xs ++ G 0)) (flatC cs ++ RC) (F rCU) (F rOP)
      (F rARG) [] = update (update F 0 (passOut m g cs n pre xs ++ l)) rZ l₂ := by
    rw [← skS_upd_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide),
      hs1, hG0]
    clear h hs1 hGx
    funext x; simp only [hG, update_apply]; split_ifs <;> (try subst_vars) <;> simp_all +decide
  rw [e1, e2] at h
  exact h

end runsP

