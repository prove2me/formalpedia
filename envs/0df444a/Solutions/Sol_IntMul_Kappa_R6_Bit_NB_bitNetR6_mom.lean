section
-- Source module: R6Pk.R6BitNBNetE
/-!
# Round six, bit network: the child-width histogram and `BitNetR6MomStmt`

Every edge of the network contributes the moment of its runs: side edges of rank `r` give
`f (2r - 23) + (23 - r) f 1` (`2r > 23`) or `r f 1`, aux edges `f 23 + f 483`, data edges
`f 439 + f 21 + 24 f 1`. The per-rank move counts of the two stage words are the base-`2³²` digits
of the kernel-checked packed counts `CNs1`, `CNs2` (no overflow: `touch1`, `touch2`). The total
moment equals Jain's `bitR6` moment.
-/

set_option linter.unusedSectionVars false
set_option maxRecDepth 10000
set_option linter.constructorNameAsVariable false

namespace IntMul.Kappa.R6.Bit.NB

open Matrix R6Chk R6Chk.Bit R6Chk.Bit.Loc AModel AModelFac

/-! ## Generic list facts -/

theorem sum_flatMap_map {α β : Type*} (l : List α) (g : α → List β) (F : β → ℝ) :
    ((l.flatMap g).map F).sum = (l.map fun x => ((g x).map F).sum).sum := by
  induction l with
  | nil => rfl
  | cons x l ih => rw [List.flatMap_cons, List.map_append, List.sum_append, ih, List.map_cons, List.sum_cons]

theorem sum_const_of {α : Type*} (l : List α) (F : α → ℝ) (c : ℝ) (h : ∀ x ∈ l, F x = c) :
    (l.map F).sum = l.length * c := by
  induction l with
  | nil => simp
  | cons x l ih =>
    rw [List.map_cons, List.sum_cons, h x List.mem_cons_self,
      ih (fun y hy => h y (List.mem_cons_of_mem _ hy)), List.length_cons]
    push_cast; ring

section Gen

variable {Wr' : Type*} [Fintype Wr'] [DecidableEq Wr'] {m : ℕ}

theorem pe_append (p q : List (Instr Wr' (ZMod 2) m)) : progEdges (p ++ q) = progEdges p ++ progEdges q :=
  List.filterMap_append

theorem pe_flatMap {α : Type*} (l : List α) (g : α → List (Instr Wr' (ZMod 2) m)) :
    progEdges (l.flatMap g) = l.flatMap fun x => progEdges (g x) := by
  induction l with
  | nil => rfl
  | cons x l ih => rw [List.flatMap_cons, pe_append, ih, List.flatMap_cons]

theorem pe_map_edge {α : Type*} (l : List α) (ι : α → Wr') (E : α → Edge m) :
    progEdges (l.map fun x => (Instr.edge (ι x) (E x) : Instr Wr' (ZMod 2) m)) = l.map E := by
  induction l with
  | nil => rfl
  | cons x l ih =>
    rw [List.map_cons, show Instr.edge (ι x) (E x) :: l.map (fun x => (Instr.edge (ι x) (E x) :
      Instr Wr' (ZMod 2) m)) = [Instr.edge (ι x) (E x)] ++ l.map (fun x => (Instr.edge (ι x) (E x) :
      Instr Wr' (ZMod 2) m)) from rfl, pe_append, ih]
    rfl

theorem pe_map_xor {α : Type*} (l : List α) (d s : α → Wr') :
    progEdges (l.map fun x => (xorG (d x) (s x) : Instr Wr' (ZMod 2) m)) = [] := by
  induction l with
  | nil => rfl
  | cons x l ih =>
    rw [List.map_cons, show xorG (d x) (s x) :: l.map (fun x => (xorG (d x) (s x) :
      Instr Wr' (ZMod 2) m)) = [xorG (d x) (s x)] ++ l.map (fun x => (xorG (d x) (s x) :
      Instr Wr' (ZMod 2) m)) from rfl, pe_append, ih]
    rfl

theorem pe_chunk (ι : ℕ → Wr') (E : ℕ → ℕ → Edge m) (cs : List LChunk) :
    progEdges (chunkProg (R := ZMod 2) ι E cs) = cs.flatMap fun chk => chk.2.1.map fun mv => E mv.2 chk.1 := by
  unfold chunkProg
  rw [pe_flatMap]
  congr 1
  funext chk
  unfold chunkInstrs
  rw [pe_append, pe_map_edge _ (fun mv : ℕ × ℕ => ι mv.1) (fun mv => E mv.2 chk.1),
    pe_map_xor _ (fun p : ℕ × ℕ => ι p.1) (fun p => ι p.2), List.append_nil]

end Gen

/-! ## Edge moments -/

section Mom

variable (τ : ℝ)

theorem sum_ones (rs : List (ℕ × ℕ × ℕ)) (h : ∀ ρ ∈ rs, ρ.2.2 = 1) :
    (rs.map fun ρ => fw τ ρ.2.2).sum = rs.length * fw τ 1 :=
  sum_const_of rs _ _ fun ρ hρ => by rw [h ρ hρ]

theorem EM_side {r : ℕ} {e : Edge 529} (h : SideR r e.runs) : EM τ e = sideV τ r := by
  obtain ⟨rs', hr, h1, hlen⟩ := h
  rw [EM, hr, List.map_append, List.sum_append, sum_ones τ rs' h1, sideV]
  unfold sideRuns at hlen ⊢
  by_cases hc : 23 < 2 * r
  · rw [if_pos hc] at hlen ⊢
    rw [if_pos hc]
    have hl : (runPairs [(23 - r, 529 - r, 2 * r - 23)]).length = 2 * r - 23 := by simp [runPairs]
    rw [hl] at hlen
    rw [show rs'.length = 23 - r by omega]
    simp
  · rw [if_neg hc] at hlen ⊢
    rw [if_neg hc]
    have hl : (runPairs ([] : List (ℕ × ℕ × ℕ))).length = 0 := rfl
    rw [hl, zero_add] at hlen
    rw [hlen]
    simp

theorem EM_aux {e : Edge 529} (h : AuxR e.runs) : EM τ e = auxV τ := by
  rw [EM, h, auxV]
  simp only [auxRuns, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero]

theorem EM_data {e : Edge 529} (h : DataR e.runs) : EM τ e = dataV τ := by
  obtain ⟨rs', hr, h1, hlen⟩ := h
  rw [EM, hr, List.map_append, List.sum_append, sum_ones τ rs' h1, hlen, dataV]
  simp only [dataRuns, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero]
  norm_num

end Mom

/-! ## The moment of the network -/

section Net

variable (τ : ℝ)

theorem EM_e1 {b o c : ℕ} (hb : b < 1771) (ho : o < 38286) (hc : c < 38286) (h : nestOK o c = true) :
    EM τ (ch0.e1 b o c) = sideV τ (rkC o c) := EM_side τ (e1_spec hb ho hc h).2

theorem EM_e2 {a o c : ℕ} (ha : a < 1771) (ho : o < 38286) (hc : c < 38286) (h : nestOK o c = true) :
    EM τ (ch0.e2 a o c) = sideV τ (rkC o c) := EM_side τ (e2_spec ha ho hc h).2

/-- Moment of a stage's chunk edges. -/
theorem chunk_mom (E : ℕ → ℕ → Edge 529) (cs : List LChunk) (hcs : MovesV cs)
    (hE : ∀ o c, o < 38286 → c < 38286 → nestOK o c = true → EM τ (E o c) = sideV τ (rkC o c)) :
    (((cs.flatMap fun chk => chk.2.1.map fun mv => E mv.2 chk.1)).map (EM τ)).sum =
      ((mvRanks cs).map (sideV τ)).sum := by
  unfold mvRanks
  rw [sum_flatMap_map, sum_flatMap_map]
  congr 1
  refine List.map_congr_left fun chk hchk => ?_
  rw [List.map_map, List.map_map]
  congr 1
  refine List.map_congr_left fun mv hmv => ?_
  obtain ⟨h1, h2, h3⟩ := hcs chk hchk mv hmv
  exact hE _ _ h2 h3 h1

theorem blk1_mom {b : ℕ} (hb : b < 1771) :
    ((progEdges (blk1 ch0 b)).map (EM τ)).sum = RS τ cs1 + 40077 * auxV τ := by
  unfold blk1
  rw [pe_append, pe_chunk, pe_map_edge, List.map_append, List.sum_append,
    chunk_mom τ _ cs1 seg1.2.2.1 (fun o c ho hc h => EM_e1 τ hb ho hc h),
    sum_const_of _ (EM τ) (auxV τ) (fun x hx => by
      obtain ⟨w, -, rfl⟩ := List.mem_map.1 hx; exact EM_aux τ (ex_spec hb).2),
    List.length_map, List.length_range']
  simp only [RS, Nat.cast_ofNat]

theorem entE_mom {a : ℕ} (ha : a < 1771) :
    (((List.range 43619).map (entE ch0 a)).map (EM τ)).sum = 3542 * dataV τ + 40077 * auxV τ := by
  have h1 : ∀ w ∈ List.range 3542, (EM τ ∘ entE ch0 a) w = dataV τ := by
    intro w hw
    rw [List.mem_range] at hw
    show EM τ (entE ch0 a w) = _
    unfold entE
    split_ifs with hc1
    · exact EM_data τ (en_spec ha hc1).2
    · exact EM_data τ (en_spec ha (by omega)).2
  have h2 : ∀ w ∈ List.range 40077, ((EM τ ∘ entE ch0 a) ∘ fun k => 3542 + k) w = auxV τ := by
    intro w hw
    rw [List.mem_range] at hw
    show EM τ (entE ch0 a (3542 + w)) = _
    rw [entE, if_neg (by omega), if_neg (by omega)]
