open DeciSigma1 DeciSigma1.Logic
variable {T : Type → Type} {D V : Type} (I : Interpretation T D)
open DeciSigma1.Logic.QuantifierFreeFormula
namespace DeciSigma1.Logic.QuantifierFreeFormula
theorem _root_.solution (ρ : V → D) (φs : List (QuantifierFreeFormula T V)) :
    (conj φs).Holds I ρ ↔ ∀ φ ∈ φs, φ.Holds I ρ := by
  induction φs with
  | nil => simp [conj, Holds]
  | cons φ φs ih => simp [conj, Holds, ih]
end DeciSigma1.Logic.QuantifierFreeFormula
