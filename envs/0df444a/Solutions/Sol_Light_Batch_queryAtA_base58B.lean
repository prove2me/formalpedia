theorem Ends.setTo {x : ℕ} {e : Expr} (z : ℤ) (h : Q ⟨Light.frame (setLocal l x z), μ⟩)
    (he : e.Gives lim ⟨Light.frame l, μ⟩ z := by (( (try have := Light.Std.space_le (by assumption))
                                                    (try have := Light.Std.const_le (by assumption))
                                                    (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega))))
    (hT : e.cost + 1 ≤ T := by (first
                                | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil,
                                        List.sum_cons, List.sum_nil, ])
                                    (first
                                      | omega
                                      | ((ring_nf); (omega))))
                                | omega
                                |
                                  (simp [] <;>
                                      first
                                      | omega
                                      | ((ring_nf); (omega))))) :
    Ends lim P d (.set x e) ⟨Light.frame l, μ⟩ T Q := by
  refine Ends.set he.1 hT ?_
  rw [he.2]
  simp only [update_frame_setLocal]
  exact h

/-- `x := e ; s`, where e gives z.  The rest s of the text gets the steps that are left. -/
theorem Ends.setToThen {x : ℕ} {e : Expr} {s : Stmt} (z : ℤ)
    (h : Ends lim P d s ⟨Light.frame (setLocal l x z), μ⟩ (T - (e.cost + 1)) Q)
    (he : e.Gives lim ⟨Light.frame l, μ⟩ z := by (( (try have := Light.Std.space_le (by assumption))
                                                    (try have := Light.Std.const_le (by assumption))
                                                    (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega))))
    (hT : e.cost + 1 ≤ T := by (first
                                | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil,
                                        List.sum_cons, List.sum_nil, ])
                                    (first
                                      | omega
