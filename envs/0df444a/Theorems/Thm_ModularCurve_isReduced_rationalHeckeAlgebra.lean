theorem ModularCurve.isReduced_rationalHeckeAlgebra
    (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime] :
    letI := heckeModuleBar p
    IsReduced ↥(rationalHeckeAlgebra ℓ (JZero p)) := by sorry
