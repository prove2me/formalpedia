  · have := zsmall (((M : ℤ) + -((n : ℤ) + 1)).toNat + T + 1) (by omega)
    rw [hsvT]; push_cast at this ⊢; exact this
  · refine le_trans (NLogN.zsz_add_le _ _) ?_
    rw [NLogN.zsz_two_pow]
    omega
end
