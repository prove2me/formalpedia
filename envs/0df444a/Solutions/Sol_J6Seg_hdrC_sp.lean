      (encK s (SS σ dS F z ((pP6 P n : ℤ) :: (αN6 P n : ℤ) :: (hN6 P n : ℤ) ::
        ((D + 1 : ℕ) : ℤ) :: (bsW P n D ++ svW src D)) (fun _ => [])))
      (10 ^ 6 * (B + 2) * (D + 2)) := by
  have zle : ∀ x : ℕ, x ≤ B → zsz (x : ℤ) ≤ B := fun x hx =>
    le_trans (zsz_natCast_le_self x) hx
  have hkB : D + 1 ≤ B := by have := hb.hB; omega
  have hhB : hN6 P n ≤ B := by have := hb.hB; nlinarith
  have hcB : cntB P n (D + 1) ≤ B := le_trans (cntB_le P n _) hkB
  set v := vK P n src D (D + 1) with hv
  have h3 : SS σ dS F z [] v (σ 3) = [((D + 1 : ℕ) : ℤ)] := by
    rw [SS_at hW, hv]; simp [vK, vH, update_apply]
  have hsvl : (svW src D).take (D + 1) = svW src D := by
    rw [List.take_of_length_le (by rw [svW_len])]
  have hbsl : (bsW P n D).take (D + 1) = bsW P n D := by
    rw [List.take_of_length_le (by rw [bsW_len])]
  have hsvB : Bnd B (svW src D).reverse := by
    intro x hx
    simp only [svW, List.mem_reverse, List.mem_map, List.mem_range] at hx
    obtain ⟨j, hj, rfl⟩ := hx
    exact hb.s j (by omega)
  have S1 := Sp.mvK (hW.neS 15) (hW.inj.ne (by decide : (15 : Fin 19) ≠ 18))
    (Ne.symm (hW.neS 18)) (hW.lt 15) hW.Slt (hW.lt 18) s (SS σ dS F z [] v) (.reg (σ 3))
    (clean_reg (hW.lt 3)) (ok_reg h3) (svW src D).reverse []
    (by rw [SS_at hW, hv]; simp [vK, update_apply, hsvl])
    (by rw [eval_reg h3, List.length_reverse, svW_len]) B hsvB trivial (bnd_reg h3 (zle _ hkB))
  rw [SS_atS hW, SS_v hW, SS_ds hW, List.reverse_reverse, List.append_nil] at S1
  set v1 := update v 15 [] with hv1
  have h3' : SS σ dS F z (svW src D) v1 (σ 3) = [((D + 1 : ℕ) : ℤ)] := by
    rw [SS_at hW, hv1, hv]; simp [vK, vH, update_apply]
  have S2 := Sp.mvK (hW.neS 14) (hW.inj.ne (by decide : (14 : Fin 19) ≠ 18))
    (Ne.symm (hW.neS 18)) (hW.lt 14) hW.Slt (hW.lt 18) s (SS σ dS F z (svW src D) v1)
    (.reg (σ 3)) (clean_reg (hW.lt 3)) (ok_reg h3') (bsW P n D).reverse []
    (by rw [SS_at hW, hv1, hv]; simp [vK, update_apply, hbsl])
    (by rw [eval_reg h3', List.length_reverse, bsW_len]) B
    (fun x hx => zsz_le_one (bits01 _ _ x (List.mem_reverse.1 hx)) (by linarith [hb.two]))
    trivial (bnd_reg h3' (zle _ hkB))
  rw [SS_atS hW, SS_v hW, SS_ds hW, List.reverse_reverse] at S2
  set v2 := update v1 14 [] with hv2
  have S3 := pushD_sp hW s F z (bsW P n D ++ svW src D) v2 3 ((D + 1 : ℕ) : ℤ)
    (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply]) B (zle _ hkB)
  have S4 := pushD_sp hW s F z (((D + 1 : ℕ) : ℤ) :: (bsW P n D ++ svW src D)) v2 2 (hN6 P n : ℤ)
    (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply]) B (zle _ hhB)
  have S5 := pushD_sp hW s F z ((hN6 P n : ℤ) :: ((D + 1 : ℕ) : ℤ) :: (bsW P n D ++ svW src D))
    v2 1 (αN6 P n : ℤ)
    (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply]) B hb.α
  have S6 := pushD_sp hW s F z ((αN6 P n : ℤ) :: (hN6 P n : ℤ) :: ((D + 1 : ℕ) : ℤ) ::
    (bsW P n D ++ svW src D)) v2 0 (pP6 P n : ℤ)
    (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply]) B hb.p
  set ds := (pP6 P n : ℤ) :: (αN6 P n : ℤ) :: (hN6 P n : ℤ) :: ((D + 1 : ℕ) : ℤ) ::
    (bsW P n D ++ svW src D) with hds
  have P0 := popR_sp hW s F z ds v2 B 0 (pP6 P n : ℤ) []
    (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply]) hb.p
  have P1 := popR_sp hW s F z ds (update v2 0 []) B 1 (αN6 P n : ℤ) []
    (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply]) hb.α
  have P2 := popR_sp hW s F z ds (update (update v2 0 []) 1 []) B 2 (hN6 P n : ℤ) []
    (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply]) (zle _ hhB)
  have P3 := popR_sp hW s F z ds (update (update (update v2 0 []) 1 []) 2 []) B 3
    ((D + 1 : ℕ) : ℤ) [] (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply]) (zle _ hkB)
  have P4 := popR_sp hW s F z ds (update (update (update (update v2 0 []) 1 []) 2 []) 3 []) B 4
    (cntB P n (D + 1) : ℤ) [] (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply]) (zle _ hcB)
  have P5 := popR_sp hW s F z ds
    (update (update (update (update (update v2 0 []) 1 []) 2 []) 3 []) 4 []) B 5
    ((2 : ℤ) ^ (hN6 P n * (D + 1) + cntB P n (D + 1))) []
    (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply]) (by rw [T_eq]; exact hb.T)
  have P6 := popR_sp hW s F z ds
    (update (update (update (update (update (update v2 0 []) 1 []) 2 []) 3 []) 4 []) 5 []) B 6
    (preT P n D (D + 1) : ℤ) [] (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply])
