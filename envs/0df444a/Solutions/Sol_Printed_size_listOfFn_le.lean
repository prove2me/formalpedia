namespace Printed
theorem _root_.solution {α : Type} [HasSize α] {g : ℕ} (f : Fin g → α) (M : ℕ) (h : ∀ a, size (f a) ≤ M) : size (List.ofFn f) ≤ g * (M + 1) + 1 := by
  rw [size_list]
  have := Table.sum_map_le (List.ofFn f) (fun l => size l + 1) (M + 1) (fun l hl => by
    obtain ⟨a, rfl⟩ : ∃ a, f a = l := by simpa [List.mem_ofFn] using hl
    exact Nat.succ_le_succ (h a))
  rw [List.length_ofFn] at this
  omega
end Printed
