section
-- Source module: NLogNP.SSMath
/-!
# Arithmetic around the Fermat-ring FFT: pieces, twisting, recomposition and carries
-/

namespace NLogN

open IntMul

/-- `∑ A_i B^i`. -/
def zev (B : ℤ) : List ℤ → ℤ
  | [] => 0
  | a :: A => a + B * zev B A

/-- The `K` signed `M`-bit pieces of `x` (least significant first). -/
def pcs (M : ℕ) : ℕ → ℤ → List ℤ
  | 0, _ => []
  | K + 1, x => sg x (x.natAbs % 2 ^ M) :: pcs M K (sg x (x.natAbs / 2 ^ M))

/-- Twisting by powers of `2^Q`. -/
def wtZ (F : ℤ) (Q : ℕ) : ℕ → List ℤ → List ℤ
  | _, [] => []
  | i, a :: A => (a * 2 ^ (i * Q)) % F :: wtZ F Q (i + 1) A

/-- Negacyclic convolution of length `K`. -/
def ncZ (K : ℕ) (A B : List ℤ) : List ℤ :=
  (List.range K).map fun m => ∑ i ∈ Finset.range K, ∑ l ∈ Finset.range K,
    ((if i + l = m then A.getD i 0 * B.getD l 0 else 0) -
      (if i + l = m + K then A.getD i 0 * B.getD l 0 else 0))

section ring

variable (n : ℕ)

end ring

/-- Carry propagation into `M`-bit digits. -/
def carZ (M : ℕ) : List ℤ → ℤ → List ℤ × ℤ
  | [], c => ([], c)
  | e :: E, c => ((e + c) % 2 ^ M :: (carZ M E ((e + c) / 2 ^ M)).1,
      (carZ M E ((e + c) / 2 ^ M)).2)

end NLogN

end

section
-- Source module: NLogNP.SSUtil
/-!
# Helper procedures: bit length and powers of two
-/

namespace NLogN

open IntMul

abbrev RM : Fin NS := 18
abbrev RQ : Fin NS := 19
abbrev QS : Fin NS := 20
abbrev XA : Fin NS := 21
abbrev W2 : Fin NS := 22
abbrev HB : Fin NS := 23
abbrev CY : Fin NS := 24
abbrev DG : Fin NS := 25
abbrev ZZ : Fin NS := 26
abbrev PW : Fin NS := 27
abbrev PB : Fin NS := 28
abbrev T5 : Fin NS := 29
abbrev T6 : Fin NS := 30
abbrev T7 : Fin NS := 31

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

/-! ## Bit length -/

/-- Push the bit length of the (nonnegative) top of `X` onto `C`. -/
def blenS (X C : Fin NS) : IStmt NS P :=
  .seq (.seq (.op (.dup X T5)) (.seq (.op (.const C 0)) (.op (.const T7 2))))
    (.seq (.loop T5 (fun c => c != .zero) (.seq (.op (.split T5 T7 T6)) (.seq (.op (.drop T6))
      (.seq (.op (.const T6 1)) (.op (.add T6 C C))))))
    (.seq (.op (.drop T5)) (.op (.drop T7))))

end NLogN

end

section
-- Source module: NLogNP.SSPow
/-! # Powers of two: `PW : m :: L ↦ 2^m :: L` (recursive on the bits of `m`) -/

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

def pow2Base : IStmt NS P := .seq (.op (.drop PW)) (.op (.const PW 1))

def pow2A : IStmt NS P :=
  .seq (.op (.const T7 2)) (.seq (.op (.split PW T7 T6)) (.seq (.op (.drop T7)) (.op (.mv T6 PB))))

def pow2D : IStmt NS P :=
  .seq (.op (.dup PW T6)) (.seq (.op (.shl PW T6)) (.seq (.op (.drop T6)) (.op (.mv PB T6))))

def pow2E : IStmt NS P :=
  .ite T6 (fun c => c == .pos) (.seq (.op (.const T7 2)) (.seq (.op (.shl PW T7)) (.op (.drop T7))))
    .skip

def pow2Body (pP : Fin P) : IStmt NS P :=
  .ite PW (fun c => c == .zero) pow2Base
    (.seq pow2A (.seq (.call pP) (.seq pow2D (.seq pow2E (.op (.drop T6))))))

def pow2Cost (m : ℕ) : ℕ := 20000 * (m + 1)

end NLogN

end

section
-- Source module: NLogNP.ISchool
/-!
# Schoolbook multiplication in the item language (base case)
-/

namespace NLogN

open IntMul

variable {S P : ℕ} {I : List Sym} {iprog : Fin P → IStmt S P}

def smulBody (X Y W Q R T : Fin S) : IStmt S P :=
  .seq (.op (.split Y Q R)) (.seq (.ite R (fun c => c == .zero) .skip
    (.ite R (fun c => c == .pos) (.seq (.op (.dup X T)) (.op (.add T W W)))
      (.seq (.op (.dup X T)) (.seq (.op (.neg T)) (.op (.add T W W))))))
    (.seq (.op (.drop R)) (.op (.shl X Q))))

/-- `A : x :: y :: L  ↦  x*y :: L`. -/
def smul (A X Y W Q R T : Fin S) : IStmt S P :=
  .seq (.op (.mv A X)) (.seq (.op (.mv A Y)) (.seq (.op (.const W 0)) (.seq (.op (.const Q 2))
    (.seq (.loop Y (fun c => c != .zero) (smulBody X Y W Q R T))
      (.seq (.op (.drop Y)) (.seq (.op (.drop X)) (.seq (.op (.drop Q)) (.op (.mv W A)))))))))

/-- The frame of the schoolbook loop. -/
def schoolSt (s : IState S) (A X Y W Q : Fin S) (L : List Item) (a b c : ℤ) : IState S :=
  ((((s.upd A L).upd X (.int a :: s.G X)).upd Y (.int b :: s.G Y)).upd W (.int c :: s.G W)).upd Q
    (.int 2 :: s.G Q)

def schoolIter (L : ℕ) : ℕ := 1500 * (L + 2)

end NLogN

namespace NLogN

variable {S P : ℕ} {I : List Sym} {iprog : Fin P → IStmt S P}

def smulCost (N : ℕ) : ℕ := 2000 * (N + 2) ^ 2

end NLogN

end

section
-- Source module: NLogNP.SSProg
/-!
# The Schönhage–Strassen procedure `FM`: program text

`FM` multiplies modulo `2^N+1`: `ARG : a :: b :: L ↦ (a*b mod 2^N+1) :: L`, with `N` on top of
`PRM` and the ring rulers `2^N`, `2^N+1` on top of `RN`, `RF`.  Small `N` use schoolbook
multiplication; otherwise the inputs are cut into `K = 2^k` pieces of `M` bits, twisted and
transformed in the ring `ℤ/(2^N'+1)`, multiplied pointwise by recursive calls, transformed back,
untwisted, lifted to signed coefficients, carried into `M`-bit digits and recombined.
-/

namespace NLogN

open IntMul

variable {P : ℕ}

/-- `ARG : a :: b :: L ↦ a'' :: b'' :: L` with `x'' = (x mod 2^N) - ⌊x/2^N⌋`. -/
def fmPre : IStmt NS P :=
  .seq (.op (.split ARG RN T1)) (.seq (.op (.neg ARG)) (.seq (.op (.add T1 ARG ARG))
    (.seq (.op (.mv ARG T1)) (.seq (.op (.split ARG RN T2)) (.seq (.op (.neg ARG))
      (.seq (.op (.add T2 ARG ARG)) (.op (.mv T1 ARG))))))))

/-- Move `K` integers (`K` on top of `DL`) from `X` to `Y`. -/
def mvK (X Y : Fin NS) : IStmt NS P := .seq (.op (.dup DL CC)) (.seq (mvN X Y CC) (.op (.drop CC)))

/-- One piece: cut `M` bits off `XA`, twist by `W = 2^(iQ)`, reduce, push to `QS`. -/
def prepStep : IStmt NS P :=
  .seq (.op (.split XA RM T4)) (.seq (.op (.shl T4 W)) (.seq (fred T4) (.seq (.op (.mv T4 QS))
    (.seq (.op (.shl W RQ)) (decC CC)))))

/-- `ARG : x :: L ↦ L`, `DX : R ↦ (forward transform of the twisted pieces of x) ++ R`. -/
def fmPrep (pD : Fin P) : IStmt NS P :=
  .seq (.seq (.op (.mv ARG XA)) (.seq (.op (.const W 1)) (.op (.dup DL CC))))
    (.seq (.loop CC (fun c => c != .zero) prepStep)
      (.seq (.seq (.op (.drop CC)) (.seq (.op (.drop W)) (.op (.drop XA))))
        (.seq (mvK QS DX) (.call pD))))

/-- One pointwise product by a recursive call. -/
def pwStep (pF : Fin P) : IStmt NS P :=
  .seq (.op (.mv DX ARG)) (.seq (.op (.mv V ARG)) (.seq (.call pF) (.seq (.op (.mv ARG P1))
    (decC CC))))

def fmPw (pF : Fin P) : IStmt NS P :=
  .seq (.op (.dup DL CC)) (.seq (.loop CC (fun c => c != .zero) (pwStep pF)) (.op (.drop CC)))

/-- Fix a negative remainder of the signed split. -/
def fixS : IStmt NS P :=
  .seq (.op (.dup RM T6)) (.seq (.op (.add T6 T5 T5)) (.seq (.op (.const T6 (-1)))
    (.op (.add T6 T4 T4))))

/-- Untwist, lift to the symmetric range, add the carry and split off an `M`-bit digit. -/
def postStep : IStmt NS P :=
  .seq (.seq (.op (.mv DX T4)) (.op (.shl T4 W))) (.seq (fred T4)
    (.seq (.seq (.op (.shl T4 W2)) (.seq (.op (.dup HB T5)) (.op (.add T5 T4 T4)))) (.seq (fred T4)
      (.seq (.seq (.op (.dup HB T5)) (.seq (.op (.neg T5)) (.seq (.op (.add T5 T4 T4))
        (.seq (.op (.mv CY T5)) (.seq (.op (.add T5 T4 T4)) (.op (.split T4 RM T5)))))))
      (.seq (.ite T5 (fun c => c == .neg) fixS .skip)
        (.seq (.op (.mv T5 DG)) (.seq (.op (.mv T4 CY)) (.seq (.op (.split W RQ T5))
          (.seq (.op (.drop T5)) (decC CC))))))))))

def fmPost : IStmt NS P :=
  .seq (.seq (.op (.dup RN W)) (.seq (.op (.const CY 0)) (.op (.dup DL CC))))
    (.seq (.loop CC (fun c => c != .zero) postStep) (.seq (.op (.drop CC)) (.op (.drop W))))

def hornerStep : IStmt NS P := .seq (.op (.cat ZZ RM DG)) (decC CC)

def fmHorner : IStmt NS P :=
  .seq (.seq (.op (.const ZZ 1)) (.op (.dup DL CC)))
    (.seq (.loop CC (fun c => c != .zero) hornerStep) (.op (.drop CC)))

/-- `ZZ := (ZZ - 2^N - CY) mod (2^N+1)`, pushed to `ARG`. -/
def fmFinal : IStmt NS P :=
  .seq (.seq (.op (.dup RN T4)) (.seq (.op (.neg T4)) (.seq (.op (.add T4 ZZ ZZ))
    (.seq (.op (.mv CY T4)) (.seq (.op (.neg T4)) (.op (.add T4 ZZ ZZ)))))))
    (.seq (fred ZZ) (.op (.mv ZZ ARG)))

/-! ## Parameters -/

/-- `ZZ := ℓ = blen N`, `T1 := k = ℓ/2 - blen ℓ`, `DL := K = 2^k` (the latter via `pow2`). -/
def parA (pP : Fin P) : IStmt NS P :=
  .seq (.seq (blenS PRM ZZ) (.seq (blenS ZZ CY) (.seq (.op (.const T4 2)) (.seq (.op (.dup ZZ T1))
    (.seq (.op (.split T1 T4 T2)) (.seq (.op (.drop T2)) (.seq (.op (.drop T4))
      (.seq (.op (.mv CY T2)) (.seq (.op (.neg T2)) (.seq (.op (.add T2 T1 T1))
        (.op (.dup T1 PW))))))))))))
    (.seq (.call pP) (.op (.mv PW DL)))

/-- `T2 := M = N/K`, `RM := 2^M`. -/
def parB (pP : Fin P) : IStmt NS P :=
  .seq (.seq (.op (.dup PRM T2)) (.seq (.op (.split T2 DL T3)) (.seq (.op (.drop T3))
    (.op (.dup T2 PW)))))
    (.seq (.call pP) (.op (.mv PW RM)))

/-- `T2 := Q = (2M+2k+3)/K + 1`, `T3 := N' = Q*K`, `RQ := 2^Q`, `DE := 2^(2Q)`. -/
def parC (pP : Fin P) : IStmt NS P :=
  .seq (.seq (.op (.dup T2 T3)) (.seq (.op (.add T3 T2 T2)) (.seq (.op (.dup T1 T3))
    (.seq (.op (.dup T1 T4)) (.seq (.op (.add T3 T4 T4)) (.seq (.op (.add T4 T2 T2))
      (.seq (.op (.const T3 3)) (.seq (.op (.add T3 T2 T2)) (.seq (.op (.split T2 DL T3))
        (.seq (.op (.drop T3)) (.seq (.op (.const T3 1)) (.seq (.op (.add T3 T2 T2))
          (.seq (.op (.dup T2 T3)) (.seq (.op (.shl T3 DL)) (.op (.dup T2 PW))))))))))))))))
    (.seq (.call pP) (.seq (.op (.mv PW RQ)) (.seq (.op (.dup RQ T4)) (.seq (.op (.shl T4 RQ))
      (.op (.mv T4 DE))))))

/-- The ring `2^N'+1` on `RN`, `RF`. -/
def parD (pP : Fin P) : IStmt NS P :=
  .seq (.op (.dup T3 PW)) (.seq (.call pP) (.seq (.op (.dup PW T4)) (.seq (.op (.mv PW RN))
    (.seq (.op (.const T5 1)) (.seq (.op (.add T5 T4 T4)) (.op (.mv T4 RF)))))))

/-- `W2 := 2^(N'-k)`, `HB := 2^(N'-1)`, `PRM := N'`, and the temporaries are dropped. -/
def parE (pP : Fin P) : IStmt NS P :=
  .seq (.seq (.op (.dup T3 PW)) (.seq (.op (.dup T1 T4)) (.seq (.op (.neg T4))
    (.op (.add T4 PW PW)))))
    (.seq (.call pP) (.seq (.seq (.op (.mv PW W2)) (.seq (.op (.dup T3 PW))
      (.seq (.op (.const T4 (-1))) (.op (.add T4 PW PW)))))
    (.seq (.call pP) (.seq (.op (.mv PW HB)) (.seq (.op (.mv T3 PRM)) (.seq (.op (.drop T2))
      (.seq (.op (.drop T1)) (.op (.drop ZZ)))))))))

def fmParams (pP : Fin P) : IStmt NS P :=
  .seq (parA pP) (.seq (parB pP) (.seq (parC pP) (.seq (parD pP) (parE pP))))

/-- Drop the inner ring and the transform parameters (keeping `RM`, `DL`). -/
def fmUnpar : IStmt NS P :=
  .seq (.op (.drop RN)) (.seq (.op (.drop RF)) (.seq (.op (.drop PRM)) (.seq (.op (.drop W2))
    (.seq (.op (.drop HB)) (.seq (.op (.drop DE)) (.op (.drop RQ)))))))

def fmMain (pF pD pT pP : Fin P) : IStmt NS P :=
  .seq fmPre (.seq (fmParams pP) (.seq (fmPrep pD) (.seq (mvK DX U) (.seq (mvK U V)
    (.seq (fmPrep pD) (.seq (fmPw pF) (.seq (mvK P1 DX) (.seq (.call pT) (.seq fmPost
      (.seq fmUnpar (.seq fmHorner (.seq fmFinal (.seq (.op (.drop RM)) (.op (.drop DL)))))))))))))))

/-- Schoolbook multiplication and reduction for small `N`. -/
def fmBase : IStmt NS P := .seq (smul ARG XA QS W CC U V) (fred ARG)

/-- Threshold on the bit length of `N`. -/
def fmThr : ℕ := 2048

def fmBody (pF pD pT pP : Fin P) : IStmt NS P :=
  .seq (.seq (blenS PRM ZZ) (.seq (.op (.const T4 (-(fmThr : ℤ)))) (.op (.add T4 ZZ ZZ))))
    (.ite ZZ (fun c => c == .neg) (.seq (.op (.drop ZZ)) fmBase)
      (.seq (.op (.drop ZZ)) (fmMain pF pD pT pP)))

end NLogN

end

section
-- Source module: NLogNP.SSFM1
/-!
# `FM`: correctness of the preprocessing segments
-/

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

/-! ## Pieces -/

/-- The quotient after `i` cuts of `M` bits. -/
def qit (M i : ℕ) (x : ℤ) : ℤ := (fun y : ℤ => sg y (y.natAbs / 2 ^ M))^[i] x

def prepCost (N n k : ℕ) : ℕ := difCost n k + 40000 * 2 ^ k * (n + 3) + 1000 * (N + n + 10)

end NLogN

end

section
-- Source module: NLogNP.SSFM2
/-!
# `FM`: pointwise products, untwisting with carries, and recombination
-/

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

/-- The specification of a call of `FM` in the ring `2^n+1`, with cost at most `C`. -/
def FMSpec (pF : Fin P) (iprog : Fin P → IStmt NS P) (I : List Sym) (n C : ℕ) : Prop :=
  ∀ (s : IState NS) (a b : ℤ) (LA LP LN LF : List Item), 0 ≤ a ∧ a ≤ 2 ^ n → 0 ≤ b ∧ b ≤ 2 ^ n →
    s.G ARG = .int a :: .int b :: LA → s.G PRM = .int n :: LP → s.G RN = .int (2 ^ n) :: LN →
    s.G RF = .int (2 ^ n + 1) :: LF →
    IRuns I iprog (.call pF) s (s.upd ARG (.int ((a * b) % (2 ^ n + 1)) :: LA)) C

end NLogN

end

section
-- Source module: NLogNP.SSFM3
/-!
# `FM`: untwisting, lifting and carrying
-/

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

/-- Untwist by `2^e`, unweight by `2^(n-k)` and lift to the symmetric range. -/
def liftE (n k e : ℕ) (d : ℤ) : ℤ :=
  (((d * 2 ^ e) % (2 ^ n + 1)) * 2 ^ (n - k) + 2 ^ (n - 1)) % (2 ^ n + 1) - 2 ^ (n - 1)

/-- The lifted coefficients of the inverse transform `D` (with `K` entries). -/
def liftL (n k Q K : ℕ) (D : List ℤ) : List ℤ :=
  (List.range K).map fun i => liftE n k ((K - i) * Q) (D.getD i 0)

end NLogN

end

section
-- Source module: NLogNP.SSFM4
/-!
# `FM`: parameter computation
-/

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

/-- The parameters of `FM` at size `N`. -/
def fmL (N : ℕ) : ℕ := zsz (N : ℤ)
def fmB (N : ℕ) : ℕ := zsz (fmL N : ℤ)
def fmK (N : ℕ) : ℕ := fmL N / 2 - fmB N
def fmM (N : ℕ) : ℕ := N / 2 ^ fmK N
def fmQ (N : ℕ) : ℕ := (2 * fmM N + 2 * fmK N + 3) / 2 ^ fmK N + 1
def fmN' (N : ℕ) : ℕ := fmQ N * 2 ^ fmK N

end NLogN

end

section
-- Source module: NLogNP.SSCorrect
/-!
# Correctness of one Schönhage–Strassen level
-/

namespace NLogN

open IntMul

/-- The folded input `x mod 2^N - ⌊x / 2^N⌋`. -/
def fold (N : ℕ) (x : ℤ) : ℤ := x % 2 ^ N + -(x / 2 ^ N)

end NLogN

end

section
-- Source module: NLogNP.SSFM5
/-!
# One level of `FM`
-/

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

/-- The cost of one level of `FM` beyond the recursive calls. -/
def fmLevelCost (N : ℕ) : ℕ :=
  2 * difCost (fmN' N) (fmK N) + ditCost (fmN' N) (fmK N) +
    200000 * 2 ^ fmK N * (fmN' N + 3) + 2000 * (fmL N + 1) ^ 2 + 400000 * (N + 3)

end NLogN

end

section
-- Source module: NLogNP.SSParam
/-!
# Parameter inequalities for `FM`

For `ℓ = fmL N ≥ 2048` and `2^k ∣ N` (`k = fmK N`), the recursive size `fmN' N` is smaller,
keeps the divisibility invariant, and the potential `fmPhi` absorbs one level.
-/

namespace NLogN

/-- `λ = blen (ℓ^4)`. -/
def fmLam (N : ℕ) : ℕ := zsz (((fmL N) ^ 4 : ℕ) : ℤ)

/-- The constant of the potential. -/
def fmA : ℕ := 2 ^ 2100

/-- The potential `A · N · ℓ · λ`. -/
def fmPhi (N : ℕ) : ℕ := fmA * N * fmL N * fmLam N

/-! ## Arithmetic helpers -/

end NLogN

end

section
-- Source module: NLogNP.SSMain
/-!
# The top-level Schönhage–Strassen program
-/

namespace NLogN

open IntMul

section blen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

end blen

/-- Procedure 0: read `x`, `y`; `N0 = 2^(blen(n+1)+1)`; call `FM`; write `bin_{2n}`. -/
def mainBody : IStmt NS 5 :=
  .seq (.op (.read ARG T1 codeSep)) (.seq (.op (.read ARG T2 codeEnd)) (.seq mainA
    (.seq (.call 1) (.seq (.op (.shl T1 T2)) (.op (.write ARG T1))))))
where
  mainA : IStmt NS 5 :=
    .seq (blenS T1 ZZ) (.seq (blenS ZZ PW) (.seq (.seq (.op (.const T4 1)) (.op (.add T4 PW PW)))
      (.seq (.call 4) (.seq (.seq (.op (.mv PW PRM)) (.op (.dup PRM PW))) (.seq (.call 4)
        (.seq (.op (.dup PW T4)) (.seq (.op (.mv PW RN)) (.seq (.op (.const T5 1))
          (.seq (.op (.add T5 T4 T4)) (.op (.mv T4 RF)))))))))))

def ssProg : Fin 5 → IStmt NS 5 :=
  ![mainBody, fmBody 1 2 3 4, difBody 2, ditBody 3, pow2Body 4]

/-- The FM size used for `n`-bit inputs. -/
def mainN0 (n : ℕ) : ℕ := 2 ^ (zsz ((n + 1 : ℕ) : ℤ) + 1)

def mainACost (n : ℕ) : ℕ :=
  2000 * (n + 2) * (zsz ((n + 1 : ℕ) : ℤ) + 2) + 2000 * (zsz ((n + 1 : ℕ) : ℤ) + 1) *
    (zsz (zsz ((n + 1 : ℕ) : ℤ) : ℤ) + 2) + 60000 * (mainN0 n + 3)

def mainCost (n : ℕ) : ℕ :=
  2 * readRCost n + mainACost n + fmPhi (mainN0 n) + shlCost n + outRCost (2 * n)

end NLogN

end

