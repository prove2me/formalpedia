variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem cornerUnipotent_mem_localMaximalCompact3 {z : v.adicCompletion ℚ} (hz : Valued.v z ≤ 1) :
    upperUnipotent3 0 0 z ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := by
  rw [mem_localMaximalCompact3_iff]
  refine ⟨fun i j => ?_, fun i j => ?_⟩ <;> fin_cases i <;> fin_cases j <;> simp [upperUnipotent3, hz]

variable {v}

private theorem apply_dualCell_mul_eq_zero
    {ψ : AddChar (v.adicCompletion ℚ) ℂ} {W : GL (Fin 3) (v.adicCompletion ℚ) → ℂ}
    (hW : IsGL3PsiWhittakerFn ψ W) (hU : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) W)
    (a x : (v.adicCompletion ℚ)ˣ) {y : v.adicCompletion ℚ} (hy : Valued.v (y * ((x⁻¹ : (v.adicCompletion ℚ)ˣ) :
      v.adicCompletion ℚ)) ≤ 1) (hψ : ψ y ≠ 1) {k : GL (Fin 3) (v.adicCompletion ℚ)}
    (hk : k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) : W (dualCell a x * k) = 0 := by
  rw [hU _ k hk]
  refine apply_eq_zero_of_conj_secondRoot_mem hW hU (y := y) ?_ hψ
  rw [inv_dualCell_mul_secondRoot_mul_dualCell]
  exact cornerUnipotent_mem_localMaximalCompact3 v hy

private theorem apply_iotaGL_diagUnitGL2_mul_lowerUnipotent21_mul_eq_zero {ψ : AddChar (v.adicCompletion ℚ) ℂ}
    {W : GL (Fin 3) (v.adicCompletion ℚ) → ℂ} (hW : IsGL3PsiWhittakerFn ψ W)
    (hU : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) W) (a x : (v.adicCompletion ℚ)ˣ)
    {y : v.adicCompletion ℚ} (hy : Valued.v (y * ((x⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)) ≤ 1)
    (hψ : ψ y ≠ 1) {k : GL (Fin 3) (v.adicCompletion ℚ)} (hk : k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    W (iotaGL (diagUnitGL2 a) * lowerUnipotent21 (x : v.adicCompletion ℚ) * k) = 0 := by
  rw [iotaGL_diagUnitGL2_mul_lowerUnipotent21_eq, mul_assoc]
  have h := hW ((a : v.adicCompletion ℚ) * ((x⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)) 0 0
    (dualCell a x * k)
  rw [h, apply_dualCell_mul_eq_zero hW hU a x hy hψ hk, mul_zero]

private theorem firstRootUnipotent_mem_localMaximalCompact3 (v : HeightOneSpectrum (𝓞 ℚ)) {z : v.adicCompletion ℚ}
    (hz : Valued.v z ≤ 1) :
    upperUnipotent3 z 0 0 ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := by
  rw [mem_localMaximalCompact3_iff]
  refine ⟨fun i j => ?_, fun i j => ?_⟩ <;> fin_cases i <;> fin_cases j <;> simp [upperUnipotent3, hz]

private theorem apply_iotaGL_diagUnitGL2_mul_eq_zero {ψ : AddChar (v.adicCompletion ℚ) ℂ}
    {W : GL (Fin 3) (v.adicCompletion ℚ) → ℂ} (hW : IsGL3PsiWhittakerFn ψ W)
    (hU : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) W)
    (d : (v.adicCompletion ℚ)ˣ) {y : v.adicCompletion ℚ}
    (hy : Valued.v (((d⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) * y) ≤ 1) (hψ : ψ y ≠ 1)
    {k : GL (Fin 3) (v.adicCompletion ℚ)} (hk : k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    W (iotaGL (diagUnitGL2 d) * k) = 0 := by
  rw [hU _ k hk]
  refine apply_eq_zero_of_conj_firstRoot_mem hW hU (y := y) ?_ hψ
  rw [inv_iotaGL_diagUnitGL2_mul_firstRoot_mul_iotaGL_diagUnitGL2]
  exact firstRootUnipotent_mem_localMaximalCompact3 v hy

end

