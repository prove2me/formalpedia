section pointwise

variable {g ginv : ℝ → Metric n} {F : ℝ → TwoForm n} {h : Metric n} {f : TwoForm n} {y : Pt n}

theorem hasDerivAt_faradayCyclic_of
    (hpF : ∀ i a b, HasDerivAt (fun ε => pd i (F ε a b) y) (pd i (f a b) y) 0) (a b c : Fin n) :
    HasDerivAt (fun ε => faradayCyclic (F ε) a b c y) (linFaraday f a b c y) 0 :=
  ((hpF a b c).add (hpF b c a)).add (hpF c a b)

end pointwise

