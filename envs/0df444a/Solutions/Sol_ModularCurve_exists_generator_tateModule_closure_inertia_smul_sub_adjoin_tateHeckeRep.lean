theorem TateModule.bilin_apply_eq_zero_of_forall_proj_mem
    {M : Type} [AddCommGroup M] {G : Type} [Monoid G] [DistribMulAction G M]
    (cyc : ℕ → G → ℕ → Prop) (I : Set G) (C : AddSubgroup M)
    (hC : ∀ (k : ℕ) (n : G → ℕ), (∀ σ, cyc k σ (n σ)) → ∀ σ ∈ I, ∀ c ∈ C, 2 ^ k • c = 0 → σ • c = n σ • c)
    (hexp : ∀ k : ℕ, ∃ n : G → ℕ, ∀ σ, cyc k σ (n σ))
    {σ₀ : G} (hσ₀ : σ₀ ∈ I) (h3 : ∀ k : ℕ, 2 ≤ k → ∀ m : ℕ, cyc k σ₀ m → m % 4 = 3)
    (Bf : TateModule 2 M →ₗ[ℤ_[2]] TateModule 2 M →ₗ[ℤ_[2]] ℤ_[2])
    (hGal : ∀ (σ : G) (k nk : ℕ), cyc k σ nk → ∀ x y : TateModule 2 M,
      Bf (TateModule.rep 2 M G σ x) (TateModule.rep 2 M G σ y) - (nk : ℤ_[2]) * Bf x y ∈
        Ideal.span {((2 : ℕ) : ℤ_[2]) ^ k})
    (s s' : TateModule 2 M) (hs : ∀ k, TateModule.proj 2 M k s ∈ C) (hs' : ∀ k, TateModule.proj 2 M k s' ∈ C) :
    Bf s s' = 0 := by
  classical

  let n : ℕ → ℕ := fun k => Classical.choose (hexp k) σ₀
  have hn : ∀ k, ∀ σ, cyc k σ (Classical.choose (hexp k) σ) := fun k => Classical.choose_spec (hexp k)
  refine PadicInt.eq_zero_of_forall_sq_sub_self_mul_mem_span_two_pow (Bf s s') n
    (fun k hk => h3 k hk (n k) (hn k σ₀)) (fun k hk => ?_)

  have decomp : ∀ x : TateModule 2 M, (∀ k, TateModule.proj 2 M k x ∈ C) →
      ∃ u : TateModule 2 M, TateModule.rep 2 M G σ₀ x = (n k : ℤ_[2]) • x + ((2 : ℕ) : ℤ_[2]) ^ k • u := by
    intro x hx
    have h0 : TateModule.proj 2 M k (TateModule.rep 2 M G σ₀ x - (n k : ℤ_[2]) • x) = 0 := by
      rw [map_sub, sub_eq_zero]
      change σ₀ • (x : ℕ → M) k = (((n k : ℤ_[2]) • x : TateModule 2 M) : ℕ → M) k
      rw [TateModule.natCast_padicInt_smul_apply, natCast_zsmul]
      refine hC k _ (hn k) σ₀ hσ₀ _ (hx k) ?_
      have := TateModule.torsion x k
      rwa [natCast_zsmul] at this
    refine ⟨TateModule.shiftOfProjEqZero k _ h0, ?_⟩
    rw [TateModule.pow_smul_shiftOfProjEqZero k _ h0, add_sub_cancel]
  obtain ⟨u, hu⟩ := decomp s hs
  obtain ⟨u', hu'⟩ := decomp s' hs'
  have h1 := hGal σ₀ k (n k) (hn k σ₀) s s'
  have h2 : Bf (TateModule.rep 2 M G σ₀ s) (TateModule.rep 2 M G σ₀ s') - (n k : ℤ_[2]) ^ 2 * Bf s s' ∈
      Ideal.span {((2 : ℕ) : ℤ_[2]) ^ k} := by
    refine Ideal.mem_span_singleton.mpr
      ⟨(n k : ℤ_[2]) * Bf s u' + ((n k : ℤ_[2]) * Bf u s' + ((2 : ℕ) : ℤ_[2]) ^ k * Bf u u'), ?_⟩
    rw [hu, hu']
    simp only [map_add, map_smul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul]
    ring
  have h12 := Ideal.sub_mem _ h1 h2
  have h12' : ((n k : ℤ_[2]) ^ 2 - n k) * Bf s s' ∈ Ideal.span {((2 : ℕ) : ℤ_[2]) ^ k} := by
    convert h12 using 1
    ring
  simpa only [Nat.cast_ofNat] using h12'

