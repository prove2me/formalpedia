theorem second_denominator_isUnit (z w : A) (h2 : IsUnit (2 : A))
    (hd : IsUnit (w - 1 - z - z ^ 3)) (hz : IsUnit (1 + z))
    (heq : (w + 1 + z - z ^ 3) * (w - 1 - z + z ^ 3) = 4 * z ^ 3 * (1 + z) ^ 2) :
    IsUnit (w - 1 - z + z ^ 3) := by
  have hfactor : (w - 1 - z + z ^ 3) *
      (2 * (1 + z) ^ 2 - (w + 1 + z - z ^ 3)) =
        2 * (1 + z) ^ 2 * (w - 1 - z - z ^ 3) := by
    linear_combination -heq
  have hu := (h2.mul (hz.pow 2)).mul hd
  rw [← hfactor] at hu
  exact isUnit_of_mul_isUnit_left hu

