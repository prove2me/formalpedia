namespace S02EFX

/-- Completeness gives an owner for every good; disjointness makes these owners
recover every bundle exactly. Empty bundles and empty finite types are allowed. -/
theorem exists_owner {n m : ℕ} (X : Fin n → Finset (Fin m))
    (hX : EFXCounterex.Submodular.IsAllocation X) :
    ∃ owner : Fin m → Fin n, X = bundle owner := by
  classical
  have hex : ∀ g : Fin m, ∃ i : Fin n, g ∈ X i := by
    intro g
    have hmem : g ∈ Finset.univ.biUnion X := by
      by_contra hnot
      have hpool : g ∈ LittleCharity.EFX.pool X := by
        simp [LittleCharity.EFX.pool, hnot]
      simpa [hX.2] using hpool
    simpa only [Finset.mem_biUnion, Finset.mem_univ, true_and] using hmem
  let owner : Fin m → Fin n := fun g => Classical.choose (hex g)
  have howner : ∀ g : Fin m, g ∈ X (owner g) := fun g => Classical.choose_spec (hex g)
  refine ⟨owner, ?_⟩
  funext i
  apply Finset.ext
  intro g
  rw [mem_bundle]
  constructor
  · intro hg
    by_contra hne
    exact (Finset.disjoint_left.mp (hX.1 hne)) (howner g) hg
  · intro heq
    simpa only [heq] using howner g

/-- Every total owner map gives a complete pairwise disjoint allocation. -/
theorem allocation_bundle {n m : ℕ} (owner : Fin m → Fin n) :
    EFXCounterex.Submodular.IsAllocation (bundle owner) := by
  constructor
  · intro i j hij
    apply Finset.disjoint_left.mpr
    intro g hi hj
    exact hij (((mem_bundle owner i g).mp hi).symm.trans
      ((mem_bundle owner j g).mp hj))
  · apply Finset.eq_empty_iff_forall_notMem.mpr
    intro g hg
    have hnot := (Finset.mem_sdiff.mp hg).2
    apply hnot
    exact Finset.mem_biUnion.mpr ⟨owner g, Finset.mem_univ _,
      (mem_bundle owner (owner g) g).mpr rfl⟩

/-- The bundles determine every good's owner. -/
theorem bundle_injective {n m : ℕ} : Function.Injective (@bundle n m) := by
  intro owner owner' heq
  funext g
  have hg : g ∈ bundle owner (owner g) := (mem_bundle owner (owner g) g).mpr rfl
  rw [heq] at hg
  exact ((mem_bundle owner' (owner g) g).mp hg).symm

theorem existsUnique_owner {n m : ℕ} (X : Fin n → Finset (Fin m))
    (hX : EFXCounterex.Submodular.IsAllocation X) :
    ∃! owner : Fin m → Fin n, X = bundle owner := by
  obtain ⟨owner, heq⟩ := exists_owner X hX
  refine ⟨owner, heq, ?_⟩
  intro owner' heq'
  exact bundle_injective (heq'.symm.trans heq)

end S02EFX

