-- Source module: Solutions.J6SegJPre4
/-!
# `J` kernel precondition (JPre), part 4: the intermediates of the kernel in closed form

For the streams `fsOf`/`bsOf` of a sorted line `L` (pattern `bandS mw c`, border `c ≤ ·`) and an
input `v` (`|L| ≤ |v|`), with the right-hand side `bv L v` (`bv (L_r) = v_r`):

* `fA_eq`: the forward accumulator after `r` rows is `accF r = [bt_{r-1}, …, bt_0]`;
* `bwdS_eq`: the backward state after `j` records is `(accZ (m-j), accB (m-j))` (the solution
  values `z_{m-j}, …, z_{m-1}` and their border part);
* the shapes of the streams (`fsOf_getElem_length`, `bsOf_getElem`, `WbOf_le`,
  `czOf_length`, `flOf_01`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK

section line
variable {P : ℕ} {L : List ℕ} {mw c : ℕ} {A : ℕ → ℕ → ℤ}

lemma bsOf_length : (bsOf P L mw c A).length = L.length := by simp [bsOf]

lemma bsOf_getElem {j : ℕ} (hj : j < (bsOf P L mw c A).length) :
    (bsOf P L mw c A)[j] =
      (cbOf P (bandS mw c) L A (c ≤ ·) (WbOf L mw (L.length - 1 - j)) (L.length - 1 - j),
        czOf P (bandS mw c) L A (c ≤ ·) (L.length - 1 - j),
        Aseq P (bandS mw c) L A (L.length - 1 - j) (L.getD (L.length - 1 - j) 0)
          (L.getD (L.length - 1 - j) 0), flOf L (c ≤ ·) (L.length - 1 - j)) := by
  simp [bsOf, List.getElem_reverse]

/-- **The backward states.** -/
theorem bwdS_eq_sol_aux (hsort : L.Pairwise (· < ·)) (Y : ℕ → ℤ) : ∀ j ≤ L.length,
    bwdS P (bsOf P L mw c A) (accF (P := P) (S := bandS mw c) (L := L) (A := A) (b := Y)
      L.length) j =
      (accZ P (bandS mw c) L A Y (L.length - j),
        accB P (bandS mw c) L A Y (flOf L (c ≤ ·)) (L.length - j)) := by
  have hnd : L.Nodup := hsort.imp (fun h => ne_of_lt h)
  intro j
  induction j with
  | zero =>
    intro _
    rw [bwdS_zero]
    simp [accZ, accB]
  | succ j ih =>
    intro hj
    have hb : j < (bsOf P L mw c A).length := by rw [bsOf_length]; omega
    have ht : j < (accF (P := P) (S := bandS mw c) (L := L) (A := A) (b := Y)
        L.length).length := by simp [accF]; omega
    rw [bwdS_succ P _ _ hb ht, ih (by omega), bsOf_getElem hb]
    obtain ⟨r, hr⟩ : ∃ r, r = L.length - 1 - j := ⟨_, rfl⟩
    have hrm : r < L.length := by omega
    have e1 : L.length - j = r + 1 := by omega
    have e2 : L.length - (j + 1) = r := by omega
    have hbt : (accF (P := P) (S := bandS mw c) (L := L) (A := A) (b := Y) L.length)[j] =
        btV P (bandS mw c) L A Y r := by
      have := accF_getD (P := P) (S := bandS mw c) (L := L) (A := A) (b := Y)
        (k := L.length) (i := j) (by omega)
      rw [List.getD_eq_getElem _ _ ht] at this
      rw [this, hr]
    rw [hbt, e1, e2, ← hr]
    have e : fdiv P (btV P (bandS mw c) L A Y r -
        dotF P (cbOf P (bandS mw c) L A (c ≤ ·) (WbOf L mw r) r)
          (accZ P (bandS mw c) L A Y (r + 1)) -
        dotF P (czOf P (bandS mw c) L A (c ≤ ·) r)
          (accB P (bandS mw c) L A Y (flOf L (c ≤ ·)) (r + 1)))
        (Aseq P (bandS mw c) L A r (L.getD r 0) (L.getD r 0)) = zW P (bandS mw c) L A Y r := by
      unfold zW btV
      rw [geSolveS_closed P (bandS mw c) L A Y hnd r hrm, sub_sub,
        ← hsplit_of Y (WbOf L mw r) hsort r hrm (bwin_of hsort hrm)]
      rfl
    simp only [J6Seg.JK.stepB]
    rw [e, accZ_succ hrm, accB_succ (flOf L (c ≤ ·)) hrm]

end line

end J6Seg.JK

end

theorem solution : type_of% @J6Seg.JK.bwdS_eq_sol_aux := @J6Seg.JK.bwdS_eq_sol_aux
