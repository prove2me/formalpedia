section R05Seg3
/-! # VII-02 (F2a): the actual VI radial residuals give two conserved quantities and Eq. 24c

The left-hand sides below are the VI definitions `Generic.redJ_t`, `Generic.redE_tσ`,
`Generic.redJ_σ` (Atlas VI-02/02) evaluated on the paper-gauge dictionary. The identities

* `redJ_t = -(4f/m) q'`,
* `redE_tσ - 2a redJ_t = -(2f/m) ℓ'`,
* `redJ_σ = (4f/m²) [m (m a')' - f a - (N m/f) w' e]`

hold pointwise on the open set `I` (no connectedness, no sign). From the actual reduced
equations the derivatives of `q` and `ℓ` vanish on `I`; on a preconnected `I` this gives one
common pair of constants `Q = -q(r₀)`, `J = -ℓ(r₀)/2` with `q = -Q`, `ℓ = -2J` on all of `I`,
and then `e = -Q f/N`, `w' = -2(J + 2Qa) f m/N²` and the paper's Eq. 24c. `Q`, `J` are named
by the paper's normalisation only; no ADM/Komar charge statement is made. -/

open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial

variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}

/-! ## The three residual identities (local, on any open `I`) -/

/-- `redJ_t = -(4f/m) q'` for the actual VI residual. -/
theorem redJ_t_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    Generic.redJ_t f (Dfun f m N) (Afun f m) (Hfun m N) w p a r =
      -4 * f r / m r * deriv (qFun f N w p a) r := by
  have hf := hP.nf r hr; have hm := hP.nm r hr; have hN := hP.nN r hr
  rw [(hasDerivAt_qFun hP hr).deriv]
  unfold Generic.redJ_t
  rw [(hasDerivAt_Dfun hP hr).deriv, (hasDerivAt_Afun hP hr).deriv,
    (hasDerivAt_Hfun hP hr).deriv]
  simp only [Dfun, Afun, Hfun]
  field_simp
  ring

/-- `redE_tσ - 2a redJ_t = -(2f/m) ℓ'` for the actual VI residuals. -/
theorem redE_tσ_sub_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    Generic.redE_tσ f (Dfun f m N) (Afun f m) (Hfun m N) w p a r -
        2 * a r * Generic.redJ_t f (Dfun f m N) (Afun f m) (Hfun m N) w p a r =
      -2 * f r / m r * deriv (ellFun f m N w p a) r := by
  have hf := hP.nf r hr; have hm := hP.nm r hr; have hN := hP.nN r hr
  rw [(hasDerivAt_ellFun hP hr).deriv]
  unfold Generic.redE_tσ Generic.redJ_t
  rw [(hasDerivAt_Dfun hP hr).deriv, (hasDerivAt_Afun hP hr).deriv,
    (hasDerivAt_Hfun hP hr).deriv]
  simp only [Dfun, Afun, Hfun, Kfun, qFun, eFun]
  field_simp
  ring

/-! ## From the actual reduced equations: `q' = ℓ' = 0` and common constants -/

theorem deriv_qFun_eq_zero (hP : PaperData I f m N w p a) (hr : r ∈ I)
    (hJt : Generic.redJ_t f (Dfun f m N) (Afun f m) (Hfun m N) w p a r = 0) :
    deriv (qFun f N w p a) r = 0 := by
  have h := redJ_t_eq hP hr
  rw [hJt] at h
  have hc : -4 * f r / m r ≠ 0 :=
    div_ne_zero (mul_ne_zero (by norm_num) (hP.nf r hr)) (hP.nm r hr)
  exact (mul_eq_zero.mp h.symm).resolve_left hc

theorem deriv_ellFun_eq_zero (hP : PaperData I f m N w p a) (hr : r ∈ I)
    (hJt : Generic.redJ_t f (Dfun f m N) (Afun f m) (Hfun m N) w p a r = 0)
    (hEts : Generic.redE_tσ f (Dfun f m N) (Afun f m) (Hfun m N) w p a r = 0) :
    deriv (ellFun f m N w p a) r = 0 := by
  have h := redE_tσ_sub_eq hP hr
  rw [hJt, hEts, mul_zero, sub_zero] at h
  have hc : -2 * f r / m r ≠ 0 :=
    div_ne_zero (mul_ne_zero (by norm_num) (hP.nf r hr)) (hP.nm r hr)
  exact (mul_eq_zero.mp h.symm).resolve_left hc

theorem differentiableOn_qFun (hP : PaperData I f m N w p a) :
    DifferentiableOn ℝ (qFun f N w p a) I := fun _ hr =>
  (hasDerivAt_qFun hP hr).differentiableAt.differentiableWithinAt

theorem differentiableOn_ellFun (hP : PaperData I f m N w p a) :
    DifferentiableOn ℝ (ellFun f m N w p a) I := fun _ hr =>
  (hasDerivAt_ellFun hP hr).differentiableAt.differentiableWithinAt

/-- On a preconnected `I`, `q` and `ℓ` take their base-point values everywhere on `I`. -/
theorem conserved_q_ell (hP : PaperData I f m N w p a) (hI : IsPreconnected I) {r₀ : ℝ}
    (hr₀ : r₀ ∈ I)
    (hJt : ∀ r ∈ I, Generic.redJ_t f (Dfun f m N) (Afun f m) (Hfun m N) w p a r = 0)
    (hEts : ∀ r ∈ I, Generic.redE_tσ f (Dfun f m N) (Afun f m) (Hfun m N) w p a r = 0) :
    ∀ r ∈ I, qFun f N w p a r = qFun f N w p a r₀ ∧
      ellFun f m N w p a r = ellFun f m N w p a r₀ := fun _ hr =>
  ⟨hP.isOpen.is_const_of_deriv_eq_zero hI (differentiableOn_qFun hP)
      (fun s hs => deriv_qFun_eq_zero hP hs (hJt s hs)) hr hr₀,
    hP.isOpen.is_const_of_deriv_eq_zero hI (differentiableOn_ellFun hP)
      (fun s hs => deriv_ellFun_eq_zero hP hs (hJt s hs) (hEts s hs)) hr hr₀⟩

