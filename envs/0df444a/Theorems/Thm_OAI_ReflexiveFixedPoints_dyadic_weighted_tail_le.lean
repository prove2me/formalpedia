theorem OAI.ReflexiveFixedPoints.dyadic_weighted_tail_le (M : ℕ → ℝ)
    (hM_nonneg : ∀ d, 0 ≤ M d) (hM_anti : Antitone M)
    (k N : ℕ) (hkN : k ≤ N) :
    (∑ d ∈ Finset.Ico k N, (1 / 2 : ℝ) ^ (d + 1) * M d) ≤
      (1 / 2 : ℝ) ^ k * M k := by sorry
