-- title:
--   Coordinate monomial ideal powers transport to local jet ideal powers
-- statement:
--   The polynomial substitution defining `localCoordinatePolynomial` is triangular and has a polynomial inverse. Consequently, if the substituted polynomial belongs to the $n$th power of the ideal generated by $X_i^{e_i}$, the original polynomial belongs to the $n$th power of the local jet ideal generated by the corresponding inverse-coordinate polynomials.
-- source:
--   https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Approximation/AdmissibleMatrixGeometry.lean#L41-L44

import Definitions.Def_OAI_PiExponent_AdmissibleFormalInterpolation
import Definitions.Def_OAI_PiExponent_LogarithmicJetIdeals
import Definitions.Def_OAI_PiExponent_LogarithmicJetIdeals_LocalCoordinatePolynomial

open OAI.PiExponent
open OAI.PiExponent.LogarithmicJetIdeals
open scoped BigOperators

theorem OAI.PiExponent.LogarithmicJetIdeals.coordinate_monomial_power_implies_local_power
    {m : ℕ} (c : Fin m → ℂ) (T : Fin m → ℕ)
    (e : Fin (m + 1) → ℕ) (n : ℕ)
    (P : MvPolynomial (Fin (m + 1)) ℂ)
    (hcoord : localCoordinatePolynomial c T P ∈
      (Ideal.span (Set.range (fun i : Fin (m + 1) =>
        MvPolynomial.X i ^ e i)) : Ideal (MvPolynomial (Fin (m + 1)) ℂ)) ^ n) :
    P ∈ (localJetIdeal c T e) ^ n := by sorry
