-- Source module: NLogN.HSt3
/-!
# The recursive step, part 3: the program `stepP K` (namespace `NLogN.ST`)

Phases (each one stack-neutral except for its documented outputs):

* `fetchP`   : `a` (XA), `b` (XB) ↦ `a :: b` on `30`.
* `nbP`      : `N` (XN) ↦ `N` on `34`, `Nat.size N` on `35` (via `blenRM`).
* `parPh K`  : `CR.parP K` (all parameters of `mkParams K N`), `kb = logT + 2` on `2`.
* `keyPh K`  : CRT keys on `3`, the source lengths (reversed) on `41`; records consumed.
* `chirpPh`  : `S` on `1`, the chirp table on `28`.
* `crtPh`    : `u = crtIn (chunks a)` on `0`, `v = crtIn (chunks b)` on `30`.
* `midP K`   : temporaries, environment (`GL`, `Glob`, `FwCtx` registers), descriptors, the
  exact convolution `exCore` (= `EX.exactLW`), teardown.
* `tailP`    : drop chirp, `crtOutP`, drop keys, `evalP`, result onto `XR`.
* `popPar`   : pop the parameter registers and `34`, `35`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.ST

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref

/-- The exact convolution program; definitionally `EX.exactLW M q kbw hMB …` for every `M`. -/
def exCore : RM :=
  RM.seqL [GL.scaleP GL.gPM,
    RM.seqL [EX.sPhase, RM.seqL [GL.copyP GL.gPN, GL.zipP GL.sgConjMul GL.gPN, GL.copyP GL.gPN,
      RM.seqL [GL.xferP GL.gD FWW.wI1 (GL.cnt2 GL.gPN), GL.xferP GL.gZA FWW.wI2 (GL.cnt2 GL.gPN), FWW.fwWrap,
        GL.xferP FWW.wO GL.gD (GL.cnt2 GL.gPN), GL.tdivP GL.gPN], GL.copyP GL.gPN, GL.zipP GL.sgConjMul GL.gPN], EX.bPhase],
    GL.xferP GL.gD GL.gSA (GL.cnt2 GL.gPM), GL.xferP GL.gV GL.gD (.reg GL.gPM),
    GL.scaleP GL.gPM,
    RM.seqL [EX.sPhase, RM.seqL [GL.copyP GL.gPN, GL.zipP GL.sgConjMul GL.gPN, GL.copyP GL.gPN,
      RM.seqL [GL.xferP GL.gD FWW.wI1 (GL.cnt2 GL.gPN), GL.xferP GL.gZA FWW.wI2 (GL.cnt2 GL.gPN), FWW.fwWrap,
        GL.xferP FWW.wO GL.gD (GL.cnt2 GL.gPN), GL.tdivP GL.gPN], GL.copyP GL.gPN, GL.zipP GL.sgConjMul GL.gPN], EX.bPhase],
    GL.xferP GL.gSA GL.gZA (GL.cnt2 GL.gPM), GL.zipP GL.sgMulConj GL.gPM,
    RM.seqL [EX.sPhase, RM.seqL [GL.copyP GL.gPN, GL.zipP GL.sgConjMul GL.gPN, GL.copyP GL.gPN,
      RM.seqL [GL.xferP GL.gD FWW.wI1 (GL.cnt2 GL.gPN), GL.xferP GL.gZA FWW.wI2 (GL.cnt2 GL.gPN), FWW.fwWrap,
        GL.xferP FWW.wO GL.gD (GL.cnt2 GL.gPN), GL.tdivP GL.gPN], GL.copyP GL.gPN, GL.zipP GL.sgConjMul GL.gPN], EX.bPhase],
    GL.roundP GL.gPM]

/-! ## The phases -/

def fetchP : RM :=
  RM.seqL [.rs (.push 30 (.reg Top.XB)), .rs (.pop Top.XB), .rs (.push 30 (.reg Top.XA)),
    .rs (.pop Top.XA)]

def nbP : RM :=
  RM.seqL [.rs (.push 4 (.reg Top.XN)), Top.blenRM, .rs (.push 35 (.reg 26)), .rs (.pop 26),
    .rs (.pop 4), .rs (.push 34 (.reg Top.XN))]

def parPh (K : ℕ) : RM := RM.seqL [.rs (CR.parP K), .rs (.push 2 (.add (.reg 37) (.lit 2)))]

def keyPh (K : ℕ) : RM :=
  RM.seqL [GL.xferP 40 4 (.lit ((4 * K : ℕ) : ℤ)),
    .rs (EX.pushes [(15, .reg 28), (16, .lit (K : ℤ)), (17, .lit ((4 * K : ℕ) : ℤ))]),
    .rs CR.keyGen, .rs (EX.pops [15, 16, 17]), slLoop K]

def chirpPh : RM :=
  RM.seqL [.rs (.push 1 (.reg 28)), CR.chirpP CR.twR, GL.xferP 0 28 (.add (.reg 9) (.reg 9))]

def crtPh : RM := RM.seqL [CR.crtInP, CR.crtInP, GL.xferP 0 30 (.reg 1)]

/-- Temporaries: `p` (43), `S` (45), `logT` (46), `r` (47), `r/2` (48), `K - dh` (49), `T` (50),
`logOuter` (51), `fn` (54). -/
def tmpL : List (Fin HS × Ex HS) :=
  [(43, .reg 17), (45, .reg 1), (46, .reg 37), (47, .reg 5), (48, .reg 6), (49, .reg 7),
    (50, .reg 9), (51, .reg 39), (54, .reg 26)]

/-- `eWidth p α = (cs + α - 1) / α + 1` with `cs = ceilSqrt p` on `41`, `α` on `42`. -/
def ewE : Ex HS := .add (.ndiv (.add (.reg 41) (.add (.reg 42) (.lit (-1)))) (.reg 42)) (.lit 1)

/-- The environment of `exCore`: `GL` constants (20–27), `Glob` (5–18), `FwCtx` scalars. -/
def envL (K : ℕ) : List (Fin HS × Ex HS) :=
  [(20, .pow2 (.reg 43)), (21, .pow2 (.add (.reg 43) (.reg 46))),
    (22, .ndiv (.pow2 (.reg 43)) (.reg 31)), (23, .mul (.reg 45) (.reg 45)),
    (24, .mul (.mul (.reg 31) (.reg 31))
      (.pow2 (.add (.mul (.lit ((6 * K : ℕ) : ℤ)) (.mul (.reg 42) (.reg 42))) (.lit 1)))),
    (25, .pow2 (.add (.reg 43) (.lit 1))), (26, .reg 50), (27, .reg 45),
    (5, .reg 43), (6, .mul (.reg 42) (.reg 42)), (7, .mul (.reg 41) (.reg 42)),
    (8, .add (.mul (.lit 2) (.mul (.reg 41) (.reg 42))) (.lit 1)),
    (9, ewE), (10, .add (.mul (.lit 2) ewE) (.lit 1)),
    (11, .ndiv (.pow2 (.reg 43)) (.add (.reg 42) (.reg 42))),
    (12, .pow2 (.add (.reg 43) (.reg 43))), (13, .pow2 (.reg 43)), (14, .reg 2),
    (15, .lit (K : ℤ)), (16, .reg 49), (17, .reg 48), (18, .reg 47),
    (32, .pow2 (.reg 44)), (33, .pow2 (.reg 54)), (34, .reg 47),
    (52, .pow2 (.mul (.add (.reg 47) (.reg 47)) (.reg 44))),
    (53, .add (.pow2 (.reg 54)) (.lit 1)), (35, .pow2 (.reg 51)), (36, .reg 2),
    (37, .lit ((K : ℤ) - 1)), (38, .pow2 (.add (.reg 54) (.neg (.reg 51))))]

/-- `ceilSqrt p` onto `41` (`p` on `43`). -/
def csP : RM := .rs (CR.srch 41 19 (.reg 43) (CR.csE 43 41))

/-- The environment, `exCore`, and the environment pops. -/
def envP (K : ℕ) : RM :=
  RM.seqL [.rs (EX.pushes (envL K)), exCore, .rs (EX.pops ((envL K).map Prod.fst))]

/-- Between the temporaries: descriptors, environment, `exCore`, teardown. -/
def innerP (K : ℕ) : RM :=
  RM.seqL [csP, descLoop K, envP K, .rs (CR.dropN 39 19 (.lit ((8 * (K - 1) : ℕ) : ℤ))),
    .rs (.pop 41)]

def midCore (K : ℕ) : RM :=
  RM.seqL [.rs (.pop 1), .rs (mvList 41 1 19 (.lit (K : ℤ))), innerP K,
    .rs (CR.dropN 1 19 (.lit (K : ℤ))), .rs (.push 1 (.reg 45))]

def midP (K : ℕ) : RM :=
  RM.seqL [.rs (EX.pushes tmpL), midCore K, .rs (EX.pops (tmpL.map Prod.fst))]

def tailP : RM :=
  RM.seqL [.rs (CR.dropN 28 19 (.add (.reg 9) (.reg 9))), .rs CR.crtOutP,
    .rs (CR.dropN 3 19 (.reg 1)), .rs (.pop 1), .rs (.pop 2), GL.xferP 0 20 (.reg 33),
    .rs (.push 23 (.reg 31)), .rs (.push 26 (.reg 33)), CR.evalP, .rs (.pop 26), .rs (.pop 23),
    .rs (.push Top.XR (.reg 22)), .rs (.pop 22)]

/-- The parameter registers, in the order they are popped. -/
def parRegs : List (Fin HS) := [28, 26, 44, 17, 42, 33, 31, 39, 9, 4, 6, 5, 7, 8, 38, 37, 32, 36, 34, 35]

def popPar : RM := .rs (EX.pops parRegs)

/-- **The recursive step.** -/
def stepP (K : ℕ) : RM :=
  RM.seqL [fetchP, nbP, parPh K, keyPh K, chirpPh, crtPh, midP K, tailP, popPar]

end NLogN.ST

end

