theorem NLogN.KFW.stepQ_phase (hN : NodeR σ K t S0 r H k e B Bn) (hQ : ∀ s, Q s → Agree σ s)
    (hr : 1 ≤ r) (hS : 1 ≤ S0) (hBn : 1 ≤ Bn) (hK : 1 ≤ K)
    (hKe : K * (mC ^ (k + 1) - 1) ≤ e) (het : e - e % K + K ≤ t) (Z : ℕ)
