  have hT : pre * t * post = TP6 P n := g.tot
  have hpre : 1 ≤ pre := g.pre1
  have hpost : 1 ≤ post := g.post1
  have ht1 : 1 ≤ t := g.t1
  have hx1 : 1 ≤ (P.x + 8) ^ 2 := Nat.one_le_pow _ _ (by omega)
  have hp1 := g.p1
  have hpT := g.pT
  have hsz := g.sizeT
  have hβp := g.βp
  have htM : t = M * 8 * (2 * H) := h.tM
  have hf8 : 2 ^ f = 8 * H := h.f8
  have hfl : f + 1 ≤ (P.x + 8) * (Nat.log 2 (bP6 n) + 1) := h.fl
  have hc : 4000 * (P.x + 8) ^ 2 ≤ 2 * 10 ^ 11 * (P.x + 8) ^ 2 := by
    have : 0 ≤ (P.x + 8) ^ 2 := Nat.zero_le _
    nlinarith
  have hf5 : 5 + 1 ≤ (P.x + 8) * (Nat.log 2 (bP6 n) + 1) := by nlinarith
  have hf3 : 3 + 1 ≤ (P.x + 8) * (Nat.log 2 (bP6 n) + 1) := by nlinarith
  have hw : w ≤ 8 * pP6 P n + 17 := by show pP6 P n + 2 ≤ _; omega
  have hpk : pk + 1 ≤ 8 * pP6 P n + 17 := by show 8 * pP6 P n + 16 + 1 ≤ _; omega
  -- the fine exposures
  have F : ∀ {w' f' a y : ℕ}, a * 2 ^ f' * y ≤ 32 * TP6 P n → w' ≤ 8 * pP6 P n + 17 →
      f' + 1 ≤ (P.x + 8) * (Nat.log 2 (bP6 n) + 1) → cFine w' f' a y ≤ K := by
    intro w' f' a y hV hw' hf'
    rw [fineN]
    exact toU P hD (fineA_le hV hw' hf' hβp hsz hp1 hpT) (K_big P hc)
  have e4 : pre * (M * 8) * 2 ^ f * post = 4 * TP6 P n := by
    rw [hf8, ← hT, htM]; ring
  refine ⟨F (by rw [← hT]; ring_nf; omega) hw hf5, F (by rw [← hT]; ring_nf; omega) hw hf5,
    F (by rw [← hT, htM]; ring_nf; omega) hw hf3, F (by rw [← hT, htM]; ring_nf; omega) hw hf3,
    F (by rw [e4]; omega) hw hfl, F (by rw [e4]; omega) hpk hfl, ?_, ?_⟩
  · -- gather
    have hsG := J6A.monoSrc_G h.H1 h.M0 (by have := h.H1; omega : 0 < 8 * H) h.tM h.Ws h.st h.sep
      h.Ww
    have hn' : 8 * (M * (8 * H)) ≤ 3 * (32 * t) := by
      rw [htM]; linarith only [Nat.zero_le (M * H)]
    have hb := slabA_le (Bu := w) (tt := 32 * t) hsG hpre hpost (by omega) (by omega) hn'
    refine toU P hD (c := 1400000 * 32 * 1000 * 4) (hb.trans ?_) (K_big P (Nat.le_trans
      (by norm_num : 1400000 * 32 * 1000 * 4 ≤ 2 * 10 ^ 11 * 1) (Nat.mul_le_mul_left _ hx1)))
    have e : pre * (32 * t) * post = 32 * TP6 P n := by rw [← hT]; ring
    rw [e]
    have hβ1 : 1 ≤ Nat.log 2 (bP6 n) + 1 := by omega
    show 1400000 * (32 * TP6 P n) * (1000 * (pP6 P n + 2 + 1)) ≤ _
    have : 1400000 * (32 * TP6 P n) * (1000 * (pP6 P n + 2 + 1)) ≤
        1400000 * 32 * 1000 * 4 * (TP6 P n * pP6 P n) := by
      have := Nat.mul_le_mul_left (TP6 P n) (show pP6 P n + 2 + 1 ≤ 4 * pP6 P n by omega)
      linarith only [this]
    calc _ ≤ 1400000 * 32 * 1000 * 4 * (TP6 P n * pP6 P n) := this
      _ ≤ _ := Nat.mul_le_mul_left _ (Nat.le_mul_of_pos_right _ (by omega))
  · -- compress
    have hsC := J6A.monoSrc_C h.H1 (by omega : 2 * H ≤ 8 * H) h.tM
    have hn : M * 8 * (8 * H) ≤ 3 * (2 * t) := by
      rw [htM]; linarith only [Nat.zero_le (M * H)]
    have hb := slabA_le (Bu := pk + 1) (tt := 2 * t) hsC hpre hpost (by omega) hn (by omega)
    refine toU P hD (c := 1400000 * 2 * 1000 * 26) (hb.trans ?_) (K_big P (Nat.le_trans
      (by norm_num : 1400000 * 2 * 1000 * 26 ≤ 2 * 10 ^ 11 * 1) (Nat.mul_le_mul_left _ hx1)))
    have e : pre * (2 * t) * post = 2 * TP6 P n := by rw [← hT]; ring
    rw [e]
    show 1400000 * (2 * TP6 P n) * (1000 * (8 * pP6 P n + 16 + 1 + 1)) ≤ _
    have : 1400000 * (2 * TP6 P n) * (1000 * (8 * pP6 P n + 16 + 1 + 1)) ≤
        1400000 * 2 * 1000 * 26 * (TP6 P n * pP6 P n) := by
      have := Nat.mul_le_mul_left (TP6 P n) (show 8 * pP6 P n + 16 + 1 + 1 ≤ 26 * pP6 P n by omega)
      linarith only [this]
    calc _ ≤ 1400000 * 2 * 1000 * 26 * (TP6 P n * pP6 P n) := this
      _ ≤ _ := Nat.mul_le_mul_left _ (Nat.le_mul_of_pos_right _ (by omega))

end J6Seg.AC

