-- ===== S4.Def_RP_EtPBC_A_CovAs5e =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As5e): the two-chart package descends to one f.g. subalgebra

**`desc_pack`**: square systems `g₀` over `S ⊗ B₀`, `g₁` over `S ⊗ B₁` with etale and finite witnesses, and
substitution data `u v` over `S ⊗ N` between their base changes along `bcS S φᵢ = id_S ⊗ φᵢ`, all come from data
`gC₀ gC₁ uC vC` over one f.g. `C ≤ S` (`gmap (tvC _ C) gCᵢ = gᵢ`, `map (tvC N C) ∘ uC = u`, ...), for which the
witnesses and the substitution memberships (between `gmap (bcC φᵢ C) gCᵢ`) already hold over `C`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open TensorProduct

universe u

section BcS

variable {A : Type u} [CommRing A]

/-- `id_S ⊗ φ : S ⊗ B → S ⊗ N`. -/
abbrev bcS (S : Type u) [CommRing S] [Algebra A S] {B N : Type u} [CommRing B] [Algebra A B] [CommRing N]
    [Algebra A N] (φ : B →ₐ[A] N) : S ⊗[A] B →+* S ⊗[A] N :=
  (Algebra.TensorProduct.map (AlgHom.id A S) φ : S ⊗[A] B →+* S ⊗[A] N)

end BcS

section Congr

variable {P : Type u} [CommRing P]

/-- Transport the substitution memberships along equalities of the two systems. -/
theorem subst_congr {r r' : ℕ} {g g₂ : Fin r → MvPolynomial (Fin r) P} {g' g₂' : Fin r' → MvPolynomial (Fin r') P}
    (e : g = g₂) (e' : g' = g₂') (u : Fin r' → MvPolynomial (Fin r) P) (v : Fin r → MvPolynomial (Fin r') P)
    (h : (∀ j, MvPolynomial.bind₁ u (g' j) ∈ Ideal.span (Set.range g)) ∧
      (∀ i, MvPolynomial.bind₁ v (g i) ∈ Ideal.span (Set.range g')) ∧
      (∀ i, MvPolynomial.bind₁ u (v i) - MvPolynomial.X i ∈ Ideal.span (Set.range g)) ∧
      (∀ j, MvPolynomial.bind₁ v (u j) - MvPolynomial.X j ∈ Ideal.span (Set.range g'))) :
    (∀ j, MvPolynomial.bind₁ u (g₂' j) ∈ Ideal.span (Set.range g₂)) ∧
      (∀ i, MvPolynomial.bind₁ v (g₂ i) ∈ Ideal.span (Set.range g₂')) ∧
      (∀ i, MvPolynomial.bind₁ u (v i) - MvPolynomial.X i ∈ Ideal.span (Set.range g₂)) ∧
      (∀ j, MvPolynomial.bind₁ v (u j) - MvPolynomial.X j ∈ Ideal.span (Set.range g₂')) := by
  subst e e'
  exact h

end Congr

section Pack

end Pack

end RamanujanPetersson.EtPBC.Cov

end

