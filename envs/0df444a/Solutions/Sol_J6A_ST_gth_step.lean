  have he : (eE iS iT iH iW iM iN).ok σ := ⟨⟨hjc, iW'⟩, hr⟩
  have hqv := qE_ev hS hT hH' hW hM' hN h43
  refine ⟨⟨hr, iW', iW'⟩, ?_⟩
  split_ifs
  · refine ⟨⟨⟨hq, iM', by rw [hqv]; positivity, by simp only [Ex.eval, hM']; exact_mod_cast hM⟩, trivial, iT'⟩, ?_⟩
    refine ⟨he, ?_⟩
    split_ifs
    · exact ⟨iS', he⟩
    · refine ⟨⟨he, iS'⟩, ?_⟩
      split_ifs
      · exact ⟨iT', he⟩
      · exact ⟨⟨⟨iT', iT'⟩, he⟩, iS'⟩
  · trivial

end okS

/-! ## Registers, degree, size -/

theorem gE_regs (iS iT iH iW iM iN : Fin HS) : ∀ r ∈ (gE iS iT iH iW iM iN).regs,
    r = iS ∨ r = iT ∨ r = iH ∨ r = iW ∨ r = iM ∨ r = iN ∨ r = 43 := by
  intro r hr
  simp only [gE, valE, posEE, eE, jcE, kcE, blkE, qE, rE, jB, Ex.regs, List.mem_append,
    List.mem_cons, List.not_mem_nil, or_false, List.append_nil] at hr
  repeat' rcases hr with hr | hr
  all_goals simp

theorem gE_poly (iS iT iH iW iM iN : Fin HS) : J6Seg.PreT.Poly (gE iS iT iH iW iM iN) = true ∧
    J6Seg.PreT.dg (gE iS iT iH iW iM iN) ≤ 32 ∧ (gE iS iT iH iW iM iN).size ≤ 300 := by
  refine ⟨?_, ?_, ?_⟩
  · simp +decide [gE, valE, posEE, eE, jcE, kcE, blkE, qE, rE, jB, J6Seg.PreT.Poly]
  · simp +decide [gE, valE, posEE, eE, jcE, kcE, blkE, qE, rE, jB, J6Seg.PreT.dg]
  · simp +decide [gE, valE, posEE, eE, jcE, kcE, blkE, qE, rE, jB, Ex.size]

/-! ## The gather producer -/

theorem push0_sp (s0 : IState HS) (Y : Fin HS → List ℤ) {A : ℕ} (hA : 2 ≤ A) :
    Sp (.push 44 (.lit 0)) (encK s0 Y) (encK s0 (update Y 44 (0 :: Y 44))) (2 * uC A 32) := by
  have h := pushP s0 Y (i := 44) (e := .lit 0) (v := 0) (A := A) (D := 32) (by decide)
    (fun r hr => by simp [Ex.regs] at hr) trivial rfl (fun r hr => by simp [Ex.regs] at hr) hA
    (by simp [J6Seg.PreT.Poly]) (by simp [J6Seg.PreT.dg])
  exact h.mono (by simp [Ex.size])

set_option maxHeartbeats 1000000 in
theorem gth_step_sol_aux (s0 : IState HS) (G : Fin HS → List ℤ) {iS iT iH iW iM iV : Fin HS}
    (fS : Free iS) (fT : Free iT) (fH : Free iH) (fW : Free iW) (fM : Free iM) (fV : Free iV)
    {s t H W M win A : ℕ} {LS LT LH LW LM LV : List ℤ}
    (hGS : G iS = (s : ℤ) :: LS) (hGT : G iT = (t : ℤ) :: LT) (hGH : G iH = (H : ℤ) :: LH)
    (hGW : G iW = (W : ℤ) :: LW) (hGM : G iM = (M : ℤ) :: LM) (hGV : G iV = (win : ℤ) :: LV)
    (hH : 1 ≤ H) (hWs : W ≤ s) (hwin : 0 < win) (hM : 0 < M) (ht : 0 < t)
    (hsA : s ≤ 2 ^ A) (htA : t ≤ 2 ^ A) (hHA : H ≤ 2 ^ A) (hWA : W ≤ 2 ^ A) (hMA : M ≤ 2 ^ A)
    (hVA : win ≤ 2 ^ A) (hA : 2 ≤ A) {n' j : ℕ} (hj : j < n') (hjA : j + 1 ≤ 2 ^ A) :
    Sp (gthB iS iT iH iW iM iV)
      (encK s0 (tbS G [(j : ℤ) + 1] (tlT (J6A.srcG s t H W M win) (fun _ => 0) n' (j + 1) ++ G 44)))
      (encK s0 (tbS G [(j : ℤ) + 1] (tlT (J6A.srcG s t H W M win) (fun _ => 0) n' j ++ G 44)))
      (303 * uC A 32) := by
  set X := tlT (J6A.srcG s t H W M win) (fun _ => 0) n' (j + 1) ++ G 44 with hX
  have h1 := push0_sp s0 (tbS G [(j : ℤ) + 1] X) hA
  simp only [tbS] at h1
  (simp only [J6Seg.Src.bS_13, J6Seg.Src.bS_14, J6Seg.Src.bS_15, J6Seg.Src.bS_30, J6Seg.Src.bS_31, J6Seg.Src.bS_32, J6Seg.Src.bS_33, J6Seg.Src.bS_43, J6Seg.Src.bS_44, J6Seg.Src.bS_upd_13, J6Seg.Src.bS_upd_14, J6Seg.Src.bS_upd_15, J6Seg.Src.bS_upd_30, J6Seg.Src.bS_upd_31, J6Seg.Src.bS_upd_32, J6Seg.Src.bS_upd_33, J6Seg.Src.bS_upd_43, J6Seg.Src.bS_upd_44] at h1)
  obtain ⟨Y, hY⟩ : ∃ Y, Y = bS G (G 13) (G 14) (G 15) (G 30) (G 31) (G 32) (G 33) [(j : ℤ) + 1]
      ((0 : ℤ) :: X) := ⟨_, rfl⟩
  rw [← hY] at h1
  have tS := free_top (s0 := s0) fS hGS (G 13) (G 14) (G 15) (G 30) (G 31) (G 32) (G 33)
    [(j : ℤ) + 1] ((0 : ℤ) :: X)
  have tT := free_top (s0 := s0) fT hGT (G 13) (G 14) (G 15) (G 30) (G 31) (G 32) (G 33)
    [(j : ℤ) + 1] ((0 : ℤ) :: X)
  have tH := free_top (s0 := s0) fH hGH (G 13) (G 14) (G 15) (G 30) (G 31) (G 32) (G 33)
    [(j : ℤ) + 1] ((0 : ℤ) :: X)
  have tW := free_top (s0 := s0) fW hGW (G 13) (G 14) (G 15) (G 30) (G 31) (G 32) (G 33)
    [(j : ℤ) + 1] ((0 : ℤ) :: X)
  have tM := free_top (s0 := s0) fM hGM (G 13) (G 14) (G 15) (G 30) (G 31) (G 32) (G 33)
    [(j : ℤ) + 1] ((0 : ℤ) :: X)
  have tV := free_top (s0 := s0) fV hGV (G 13) (G 14) (G 15) (G 30) (G 31) (G 32) (G 33)
    [(j : ℤ) + 1] ((0 : ℤ) :: X)
  rw [← hY] at tS tT tH tW tM tV
  have t43 : (encK s0 Y).top 43 = (j : ℤ) + 1 := topv (by rw [hY, bS_43])
  have i43 : (encK s0 Y).IsInt 43 := isInt_encK (by rw [hY, bS_43])
  have hv := gE_ev tS.1 tT.1 tH.1 tW.1 tM.1 tV.1 t43 hH hWs
  have hok := gE_ok tS.1 tT.1 tH.1 tW.1 tM.1 tV.1 t43 tS.2 tT.2 tH.2 tW.2 tM.2 tV.2 i43 hwin hM ht hH
  have hR : RB (encK s0 Y) A (gE iS iT iH iW iM iV) := fun r hr => by
    rcases gE_regs iS iT iH iW iM iV r hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · rw [tS.1]; exact abs_nat_le hsA
    · rw [tT.1]; exact abs_nat_le htA
    · rw [tH.1]; exact abs_nat_le hHA
    · rw [tW.1]; exact abs_nat_le hWA
    · rw [tM.1]; exact abs_nat_le hMA
    · rw [tV.1]; exact abs_nat_le hVA
    · rw [t43]; have := abs_nat_le hjA; push_cast at this; exact this
  obtain ⟨hp, hd, hsz⟩ := gE_poly iS iT iH iW iM iV
  have h2 := pushP s0 Y (i := 44) (e := gE iS iT iH iW iM iV)
    (v := J6Seg.Slab.code (J6A.srcG s t H W M win j)) (A := A) (D := 32) (by decide)
    (fun r hr => by
      rcases gE_regs iS iT iH iW iM iV r hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl
      exacts [fS.1, fT.1, fH.1, fW.1, fM.1, fV.1, by decide])
    hok hv hR hA hp hd
  rw [hY] at h2 h1
  (simp only [J6Seg.Src.bS_13, J6Seg.Src.bS_14, J6Seg.Src.bS_15, J6Seg.Src.bS_30, J6Seg.Src.bS_31, J6Seg.Src.bS_32, J6Seg.Src.bS_33, J6Seg.Src.bS_43, J6Seg.Src.bS_44, J6Seg.Src.bS_upd_13, J6Seg.Src.bS_upd_14, J6Seg.Src.bS_upd_15, J6Seg.Src.bS_upd_30, J6Seg.Src.bS_upd_31, J6Seg.Src.bS_upd_32, J6Seg.Src.bS_upd_33, J6Seg.Src.bS_upd_43, J6Seg.Src.bS_upd_44] at h2)
  have e : J6Seg.Slab.code (J6A.srcG s t H W M win j) :: (0 : ℤ) :: X =
      tlT (J6A.srcG s t H W M win) (fun _ => 0) n' j ++ G 44 := by
    rw [tlT_pred hj, hX]; rfl
  rw [e] at h2
  refine (h1.seq h2).mono ?_
  generalize (gE iS iT iH iW iM iV).size = z at hsz ⊢
  generalize uC A 32 = u
  nlinarith

