def activationBoundaryMemory {n : ℕ} (g : InputGraph n) (source : Fin n) (active : Finset (Fin n))
    (boundary level : ℕ) (I : ℤ → ℤ) : ℤ → ℤ :=
  if level=0 then Function.update I 7
    ((boundary+(g.neighbors source).length-2*((g.neighbors source).filter (fun v => v ∈ active)).length : ℕ) : ℤ) else I

end
