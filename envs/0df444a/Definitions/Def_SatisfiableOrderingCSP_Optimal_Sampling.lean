-- title:
--   Consistent sampling matrices and the folded ordering test
-- statement:
--   Sampling matrices have one row per scope argument and one supported tuple per column. Tuple counts are positive and even exactly on the old support; row histograms agree at every occurrence of each variable and have even counts. Approximation bounds compare all normalized counts with the fixed real local model using one constant divided by the length. An empirical local model has exactly those normalized probabilities. A sampling sequence includes these uniform approximation bounds and positive definite SDP realizations for all sufficiently large even lengths. Bucket value averages over uniform column permutations and independent conditional bucket labels, weighted by the original constraint weights. Long-code entries retain their vertex, base variable, and large or halved histogram. The equivalence relation generated by edge pullbacks folds entries separately for each base variable. Folded satisfiability is an injective natural rank on the quotient satisfying every test at every left vertex and column permutation. These are exactly the positive-weight tests of §7.3.
-- source:
--   Yury Makarychev (2026), Optimal Approximation Algorithms For Satisfiable Ordering CSPs, held STOC 2027 submission (not an acceptance claim), sha256:e49b7905adb41a36b93abcbd7818d1b18ca86a77dff069da884ba2f8e85775cc; citation_basis: published; §§7.2–7.4, Lemmas 7.2, 7.3, 7.7; pp. 40–43, 47 (PDF 43–46, 50)

import Definitions.Def_SatisfiableOrderingCSP_Optimal_Lifts
import Definitions.Def_SatisfiableOrderingCSP_Optimal_Multislices

open scoped BigOperators

namespace SatisfiableOrderingCSP.Optimal
noncomputable section
attribute [local instance] Classical.propDecidable

structure SamplingMatrices {n q : ℕ} {S : Scopes n} (M : LocalModel S q) (N : ℕ) where
  histogram : Fin n → Histogram N q
  matrix : (c : Fin S.count) → Fin (S.arity c) → Fin N → Fin q
  supported : ∀ c j, 0 < M.joint c (fun i => matrix c i j)
  rows : ∀ c i a, (Finset.univ.filter fun j => matrix c i j = a).card =
    (histogram (S.scope c i)).count a
  even_rows : ∀ v, (histogram v).EvenCounts
  even_tuples : ∀ c x, Even ((Finset.univ.filter fun j => (fun i => matrix c i j) = x).card)
  positive_tuples : ∀ c x, 0 < M.joint c x →
    0 < (Finset.univ.filter fun j => (fun i => matrix c i j) = x).card

def SamplingMatrices.tupleCount {n q N : ℕ} {S : Scopes n} {M : LocalModel S q}
    (A : SamplingMatrices M N) (c : Fin S.count) (x : Fin (S.arity c) → Fin q) : ℕ :=
  (Finset.univ.filter fun j => (fun i => A.matrix c i j) = x).card

def SamplingMatrices.Approximates {n q N : ℕ} {S : Scopes n} {M : LocalModel S q}
    (A : SamplingMatrices M N) (C : ℝ) : Prop :=
  (∀ v a, |((A.histogram v).count a : ℝ) / N - M.singleton v a| ≤ C / N) ∧
  ∀ c x, |(A.tupleCount c x : ℝ) / N - M.joint c x| ≤ C / N

def SamplingMatrices.Empirical {n q N : ℕ} {S : Scopes n} {M : LocalModel S q}
    (A : SamplingMatrices M N) (M' : LocalModel S q) : Prop :=
  (∀ v a, M'.singleton v a = ((A.histogram v).count a : ℝ) / N) ∧
  ∀ c x, M'.joint c x = (A.tupleCount c x : ℝ) / N

structure SamplingSequence {n q : ℕ} {S : Scopes n} (M : LocalModel S q) where
  threshold : ℕ
  error : ℝ
  error_nonnegative : 0 ≤ error
  matrices : (N : ℕ) → 0 < N → Even N → threshold ≤ N → SamplingMatrices M N
  approximation : ∀ N hN hE hT, (matrices N hN hE hT).Approximates error
  realization : ∀ N hN hE hT, ∃ (M' : LocalModel S q) (V : SDPVectors M')
      (G : CovarianceMatrix n q),
    (matrices N hN hE hT).Empirical M' ∧ M'.ExactCovariance G ∧
      M'.PositiveDefinite G ∧ V.CovarianceIs G

def SamplingMatrices.bucketValue {q N K : ℕ} (I : Instance) {M : LocalModel I.scopes q}
    (A : SamplingMatrices M N) (B : OrderedBuckets K)
    (g : Fin I.n → (Fin N → Fin q) → Fin K → ℝ) : ℝ :=
  ∑ c, I.weight c *
    ((∑ σ : Order N, ∑ labels : Fin (I.constraint c).predicate.arity → Fin K,
      (if bucketAccepts B (I.constraint c).predicate labels then 1 else 0) *
        ∏ i, g ((I.constraint c).scope i) (fun j => A.matrix c i (σ j)) (labels i)) /
      (Fintype.card (Order N) : ℝ))

/-- Long-code entries, with their base variable retained through every identification. -/
def Entry {n q : ℕ} {S : Scopes n} {M : LocalModel S q}
    (G : TwoOneGame) (A : SamplingMatrices M G.alphabet) :=
  (Σ v : Fin n, Fin G.leftSize × {x : Fin G.alphabet → Fin q // x ∈ (A.histogram v).strings}) ⊕
  (Σ v : Fin n, Fin G.rightSize × {y : Fin (G.alphabet/2) → Fin q //
    ∀ a, 2 * (Finset.univ.filter fun j => y j = a).card = (A.histogram v).count a})

def FoldEdge {n q : ℕ} {S : Scopes n} {M : LocalModel S q}
    (G : TwoOneGame) (A : SamplingMatrices M G.alphabet) : Entry G A → Entry G A → Prop :=
  fun x y => match x, y with
  | .inl ⟨v,u,x⟩, .inr ⟨w,z,y⟩ => v = w ∧
      ∃ e, G.left e = u ∧ G.right e = z ∧ ∀ i, x.val i = y.val (G.projection e i)
  | _, _ => False

def foldSetoid {n q : ℕ} {S : Scopes n} {M : LocalModel S q}
    (G : TwoOneGame) (A : SamplingMatrices M G.alphabet) : Setoid (Entry G A) :=
  Relation.EqvGen.setoid (FoldEdge G A)

/-- Completeness of exactly the folded tests of §7.3, independent of their positive weights. -/
def FoldedSatisfiable {q : ℕ} (I : Instance) {M : LocalModel I.scopes q}
    (G : TwoOneGame) (A : SamplingMatrices M G.alphabet) : Prop :=
  ∃ rank : Quotient (foldSetoid G A) → ℕ, Function.Injective rank ∧
    ∀ (u : Fin G.leftSize) (c : Fin I.m) (σ : Order G.alphabet)
      (x : (i : Fin (I.constraint c).predicate.arity) →
        {x : Fin G.alphabet → Fin q // x ∈ (A.histogram ((I.constraint c).scope i)).strings}),
      (∀ i j, (x i).val j = A.matrix c i (σ j)) →
      (I.constraint c).predicate.Accepts (fun i =>
        rank (Quotient.mk (foldSetoid G A) (.inl ⟨(I.constraint c).scope i,u,x i⟩)))

end
end SatisfiableOrderingCSP.Optimal


