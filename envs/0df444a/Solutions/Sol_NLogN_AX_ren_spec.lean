open NLogN
open NLogN.AX
open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.Rsp
theorem solution (π : Equiv.Perm (Fin NLogN.HS)) (hπ : NLogN.FixHi π) (P : NLogN.RS) (st : NLogN.IState NLogN.HS) (T : Fin NLogN.HS)
    (X : List NLogN.Item) (C : ℕ)
    (h : P.ok (st.rn π⁻¹) ∧ P.run (st.rn π⁻¹) = (st.rn π⁻¹).upd T (X ++ (st.rn π⁻¹).G T) ∧
      P.cost (st.rn π⁻¹) ≤ C) :
    (NLogN.RS.ren π P).ok st ∧ (NLogN.RS.ren π P).run st = st.upd (π T) (X ++ st.G (π T)) ∧
      (NLogN.RS.ren π P).cost st ≤ C := by
  refine ⟨(NLogN.AX.rs_ok_any π hπ P st).2 h.1, ?_, by rw [NLogN.AX.rs_cost_any]; exact h.2.2⟩
  rw [NLogN.RS.run_ren_any, h.2.1, NLogN.Rsp.rn_inv_upd, NLogN.Rsp.rn_inv_G]
end
