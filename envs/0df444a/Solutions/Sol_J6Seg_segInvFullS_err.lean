-- Source module: Solutions.J6SegSparse
/-!
# Segmented inverse (S2): the sparse algorithm

`segInvS P lam T B U` is `segInv` with the capacitance solved by `geSolveS` on the pattern
`bandS (λ + w) (s - λ - w)`: a band of half-width `λ + w` (blocks of length `≤ λ`, coupling width
`w`) plus the border of positions `≥ s - λ - w` (the cyclic wrap). Per row of the capacitance
at most `2(λ+w)+1` band entries plus the border are touched.

* `capI_band`: the capacitance vanishes off the pattern;
* `segInvS_eq`: under the hypotheses of `segInv_err`, `segInvS = segInv`;
* `segInvFullS_err`: the fully instantiated sparse algorithm satisfies the bound of
  `segInvFull_err`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section sp
variable {P s t α lam : ℕ} {B : Blocks} {T : Tables}

/-- **Main theorem, sparse and fully instantiated.** -/
theorem segInvFullS_err_sol_aux {R w : ℕ} {Bu εin Wm : ℝ}
    (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hx : 3 ≤ xθ s t α) (hl : 1 ≤ lam) (hw : w ≤ s)
    (hR : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ R)
    (U : ℕ → ℤ × ℤ) (hBu : 0 ≤ Bu)
    (hU : ∀ i < s, |((U i).1 : ℝ) / 2 ^ P| ≤ Bu ∧ |((U i).2 : ℝ) / 2 ^ P| ≤ Bu)
    (v ww : ℕ → ℂ) (hww : ∀ i < s, ‖ww i‖ ≤ Wm)
    (hsys : ∀ i < s, ww i + Eexact s t α ww i = v i)
    (hin : ∀ i < s, |((U i).1 : ℝ) / 2 ^ P - (v i).re| ≤ εin ∧
      |((U i).2 : ℝ) / 2 ^ P - (v i).im| ≤ εin)
    (hP : 1000 * fullG lam w s t α Bu ≤ 2 ^ P) :
    ∀ i < s,
      |((segInvFullS P R lam w s t α U i).1 : ℝ) / 2 ^ P - (ww i).re| ≤
          60 * fullG lam w s t α Bu / 2 ^ P +
          3 * (4 * exp (-(π * (α : ℝ) ^ 2 * (w * (w + 1))))) * (Bu + 1) + 8 / 7 * εin ∧
      |((segInvFullS P R lam w s t α U i).2 : ℝ) / 2 ^ P - (ww i).im| ≤
          60 * fullG lam w s t α Bu / 2 ^ P +
          3 * (4 * exp (-(π * (α : ℝ) ^ 2 * (w * (w + 1))))) * (Bu + 1) + 8 / 7 * εin ∧
      ‖toC (segInvFullS P R lam w s t α U i) / 2 ^ P - ww i‖ ≤
          2 * (60 * fullG lam w s t α Bu / 2 ^ P +
          3 * (4 * exp (-(π * (α : ℝ) ^ 2 * (w * (w + 1))))) * (Bu + 1) + 8 / 7 * εin) := by
  have heq : ∀ i, segInvFullS P R lam w s t α U i = segInvFull P R lam w s t α U i := by
    -- reuse the hypotheses established for the dense theorem
    have hS := two_pow_pos' P
    have hσ : 1 ≤ (t : ℝ) / s := sigma_ge hs hst
    have hDm1 := one_le_ddR (α := (α : ℝ)) hσ (lam - 1)
    have hJ : ((Jlist (mkBlocks s t lam w)).length : ℝ) ≤ s := by
      exact_mod_cast Jlist_length_le (mkBlocks s t lam w)
    have hGle : segG (mkBlocks s t lam w) lam (3 * lam + 3)
        (ddR (α : ℝ) ((t : ℝ) / s) (lam - 1)) Bu ≤ fullG lam w s t α Bu := by
      unfold segG fullG
      have hsq : (((Jlist (mkBlocks s t lam w)).length : ℝ) + 1) ^ 2 ≤ ((s : ℝ) + 1) ^ 2 :=
        pow_le_pow_left₀ (by positivity) (by linarith) 2
      have h0 : 0 ≤ ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) * (((lam : ℝ) + 1) * (3 * lam + 3) + 1) *
          (Bu + 1) * ((lam : ℝ) + 1) * (2 * ((mkBlocks s t lam w).w : ℝ) + 1) := by positivity
      have := mul_le_mul_of_nonneg_left hsq h0
      simpa [mkBlocks] using this
    have hlam1 : (1 : ℝ) ≤ lam := by exact_mod_cast hl
    have hG1 : 200 * (3 * (lam : ℝ) + 1) ≤ 2 ^ P := by
      have hb' : ((lam : ℝ) + 1) * (3 * lam + 3) + 1 ≤ fullG lam w s t α Bu := by
        unfold fullG
        have a1 : (1 : ℝ) ≤ Bu + 1 := by linarith
        have a2 : (1 : ℝ) ≤ (lam : ℝ) + 1 := by linarith
        have a3 : (1 : ℝ) ≤ 2 * (w : ℝ) + 1 := by have := Nat.cast_nonneg (α := ℝ) w; linarith
        have a4 : (1 : ℝ) ≤ ((s : ℝ) + 1) ^ 2 :=
          one_le_pow₀ (by have := Nat.cast_nonneg (α := ℝ) s; linarith)
        have h1 := one_le_mul' (one_le_mul' (one_le_mul' a1 a2) a3) a4
        have h2 : (((lam : ℝ) + 1) * (3 * lam + 3) + 1) ≤
            ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) * (((lam : ℝ) + 1) * (3 * lam + 3) + 1) :=
          le_mul_of_one_le_left (by positivity) hDm1
        have h3 := mul_le_mul h2 h1 zero_le_one (by positivity)
        calc (((lam : ℝ) + 1) * (3 * lam + 3) + 1) = (((lam : ℝ) + 1) * (3 * lam + 3) + 1) * 1 :=
              by ring
          _ ≤ _ := h3
          _ = _ := by ring
      nlinarith
    have hP1 : 1 ≤ P := by
      rcases Nat.eq_zero_or_pos P with h | h
      · subst h; simp at hG1; nlinarith
      · exact h
    have hT := mkTables_ok (P := P) (R := R) hs hst hα hP1 hl hG1 hR (mkBlocks s t lam w)
      (fun i _ => mkBlocks_len hl w i)
    have hB := mkBlocks_ok (s := s) (t := t) (lam := lam) hs w hw
    intro i
    have e := fun V => segInvS_eq (P := P) hs hst hα hx hB (fun i _ => mkBlocks_len hl w i) hT
      (by positivity) hBu (by linarith) V
    simp only [segInvFullS, segInvFull, segInvCS, segInvC, e]
  intro i hi
  have h := segInvFull_err hs hst hα hx hl hw hR U hBu hU v ww hww hsys hin hP i hi
  simp only [heq]
  exact h

end sp

