theorem vol_rev_drop (S : Shape) (j : ℕ) : vol (S.reverse.drop j) = vol (S.take (S.length - j)) := by
  rw [List.drop_reverse]; simp [vol]

theorem zl_rev_get (S : Shape) {k i : ℕ} (h : i + k + 1 = S.length) :
    (NLogN.KFUU.zl S.reverse).drop k = ((S[i]'(by omega) : ℕ) : ℤ) :: (NLogN.KFUU.zl S.reverse).drop (k + 1) := by
  rw [zl_drop, zl_drop, List.drop_eq_getElem_cons (by simp; omega)]
  simp only [NLogN.KFUU.zl_cons, List.getElem_reverse]
  congr 3; omega

theorem sufV_beyond (S : Shape) {j : ℕ} (hj : S.length < j) : sufV S j = [] := by
  simp [sufV, List.drop_eq_nil_of_le (show (List.range (S.length + 1)).length ≤ j by simp; omega)]

