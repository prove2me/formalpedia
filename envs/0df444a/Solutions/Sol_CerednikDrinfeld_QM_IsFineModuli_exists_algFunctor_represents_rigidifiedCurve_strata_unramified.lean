namespace RelRepInd

private structure _root_.RelRepInd.Pt {C : Type} [CommRing C] (πC : C) {MC : Scheme.{0}} (g : MC ⟶ Spec (CommRingCat.of C))
    (X : ℕ → Scheme.{0}) (ξ : ∀ d, X d ⟶ MC) (T : Type) [CommRing T] [Algebra C T] where
  t : Spec (CommRingCat.of T) ⟶ MC
  ht : t ≫ g = Spec.map (CommRingCat.ofHom (algebraMap C T))
  d : ℕ
  x : Spec (CommRingCat.of (T ⧸ Ideal.span {algebraMap C T πC})) ⟶ X d
  hx : x ≫ ξ d = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C T πC}))) ≫ t

p2m_export "RelRepInd" "Pt"
p2m_export_all "RelRepInd" "Pt"
theorem span_le_comap {C : Type} [CommRing C] (πC : C) {T T' : Type} [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T']
    (φ : T →ₐ[C] T') :
    Ideal.span {algebraMap C T πC} ≤ (Ideal.span {algebraMap C T' πC}).comap (φ : T →+* T') := by
  rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap]
  have : (φ : T →+* T') (algebraMap C T πC) = algebraMap C T' πC := φ.commutes πC
  rw [this]
  exact Ideal.subset_span rfl

private def _root_.RelRepInd.qmap {C : Type} [CommRing C] (πC : C) {T T' : Type} [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T']
    (φ : T →ₐ[C] T') : (T ⧸ Ideal.span {algebraMap C T πC}) →+* (T' ⧸ Ideal.span {algebraMap C T' πC}) :=
  Ideal.quotientMap _ (φ : T →+* T') (span_le_comap πC φ)

p2m_export "RelRepInd" "qmap"
private theorem _root_.RelRepInd.qmap_comp_mk {C : Type} [CommRing C] (πC : C) {T T' : Type} [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T']
    (φ : T →ₐ[C] T') :
    (qmap πC φ).comp (Ideal.Quotient.mk _) = (Ideal.Quotient.mk _).comp (φ : T →+* T') := by
  ext x; rfl

p2m_export "RelRepInd" "qmap_comp_mk"
namespace Pt

private noncomputable def _root_.RelRepInd.Pt.map {C : Type} [CommRing C] {πC : C} {MC : Scheme.{0}} {g : MC ⟶ Spec (CommRingCat.of C)}
    {X : ℕ → Scheme.{0}} {ξ : ∀ d, X d ⟶ MC} {T T' : Type} [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T']
    (φ : T →ₐ[C] T') (p : Pt πC g X ξ T) : Pt πC g X ξ T' where
  t := Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ p.t
  ht := by
    rw [Category.assoc, p.ht, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    exact φ.comp_algebraMap
  d := p.d
  x := Spec.map (CommRingCat.ofHom (qmap πC φ)) ≫ p.x
  hx := by
    rw [Category.assoc, p.hx, ← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, qmap_comp_mk]

end Pt
p2m_export "RelRepInd" "Pt.map"
end RelRepInd

namespace IotaBlock

variable {𝒪 : Type} [CommRing 𝒪] (M : Scheme.{0}) (fM : M ⟶ Spec (CommRingCat.of 𝒪))
  (C : Type) [CommRing C] [Algebra 𝒪 C] (IC : Ideal C)

theorem isPullback_iota
    (ι : pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))) ⟶
      pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))))
    (h1 : ι ≫ pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
      pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))))
    (h2 : ι ≫ pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
      pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))) ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IC))) :
    IsPullback ι (pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))))
      (pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IC))) := by
  have hqC : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IC)) ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)) =
      Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  have outer : IsPullback (ι ≫ pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))))
      (pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC))))) fM
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IC)) ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) := by
    rw [h1, hqC]
    exact IsPullback.of_hasPullback _ _
  exact IsPullback.of_right outer h2 (IsPullback.of_hasPullback _ _)

theorem formallyUnramified_quotientMap :
    FormallyUnramified (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IC))) := by
  rw [HasRingHomProperty.Spec_iff (P := @FormallyUnramified)]
  exact RingHom.FormallyUnramified.of_surjective Ideal.Quotient.mk_surjective

theorem locallyOfFinitePresentation_quotientMap (hIC : IC.FG) :
    LocallyOfFinitePresentation (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IC))) := by
  rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)]
  show (Ideal.Quotient.mk IC).FinitePresentation
  rw [← Ideal.Quotient.algebraMap_eq, RingHom.finitePresentation_algebraMap]
  exact Algebra.FinitePresentation.quotient hIC

theorem iota_unramified_lfp (hIC : IC.FG)
    (ι : pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))) ⟶
      pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))))
    (h1 : ι ≫ pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
      pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))))
    (h2 : ι ≫ pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
      pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))) ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IC))) :
    FormallyUnramified ι ∧ LocallyOfFinitePresentation ι := by
  have sq := (isPullback_iota M fM C IC ι h1 h2).flip
  exact ⟨MorphismProperty.of_isPullback sq (formallyUnramified_quotientMap C IC),
    MorphismProperty.of_isPullback sq (locallyOfFinitePresentation_quotientMap C IC hIC)⟩

theorem comp_iota {X : Scheme.{0}} (hIC : IC.FG)
    (ι : pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))) ⟶
      pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))))
    (h1 : ι ≫ pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
      pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))))
    (h2 : ι ≫ pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
      pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))) ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk IC)))
    (q : X ⟶ pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 (C ⧸ IC)))))
    [LocallyOfFinitePresentation q] [FormallyUnramified q] :
    LocallyOfFinitePresentation (q ≫ ι) ∧ FormallyUnramified (q ≫ ι) := by
  obtain ⟨hu, hl⟩ := iota_unramified_lfp M fM C IC hIC ι h1 h2
  haveI := hu; haveI := hl
  exact ⟨inferInstance, MorphismProperty.comp_mem @FormallyUnramified q ι ‹_› hu⟩

end IotaBlock

