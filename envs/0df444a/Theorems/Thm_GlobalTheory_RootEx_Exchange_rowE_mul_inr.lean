variable {k : Type*} [Field k] {n : Type*} [Fintype n] [DecidableEq n] {c : ℕ}

theorem GlobalTheory.RootEx.Exchange.rowE_mul_inr (p : ℕ) (u : n → k) (M : Matrix (n ⊕ Fin c) (n ⊕ Fin c) k) (r : Fin c) (s) :
    ((rowE c p u).val * M) (Sum.inr r) s =
      M (Sum.inr r) s + if r.val + 1 = p then ∑ t, u t * M (Sum.inl t) s else 0 := by sorry
