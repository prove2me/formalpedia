-- Source module: Solutions.J6AIL2
/-!
# A lines, IL side 2: copies and regrouping of line representations

* `dupL K L`: `K` copies of `L` concatenated (what the IL duplication leaves on stack `0`);
* **`LRep_cpy`**: `K = 2^f` copies of a `(pre, n, post)` array, followed by the two fine
  exposures `(1, K, N) → (1, N, K)` and `(pre, n·post, K) → (pre, K, n·post)`, are the
  `(pre, K·n, post)` array whose lines are `K` copies of the old lines;
* **`LRep_rgp`**: a `(pre, K·M·w, post)` array (`K = 2^f` classes of `M` windows of length `w`),
  after the exposures `(pre, K, M·w·post) → (pre, M·w·post, K)` and
  `(pre·M, w·post, K) → (pre·M, K, w·post)`, is the `(pre·(M·K), w, post)` array whose row
  `b·(M K) + j K + r` is window `j` of class `r` of line `b`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open IntMul.HvdH IntMul.HvdH.Ref

namespace J6A

open J6Seg

section lists
variable {α : Type*} [Inhabited α]

theorem LRep_rgp_sol_aux {K M w post pre : ℕ} (hK : 0 < K) (hM : 0 < M) (hw : 0 < w) (hp : 0 < post)
    {L : List α} {φ : ℕ → ℕ → List α} (hL : LRep pre (K * (M * w)) post L φ) :
    LRep (pre * (M * K)) w post (rgp K M w post pre L)
      (fun b' c => (((φ (b' / (M * K)) c).drop ((b' % K * M + b' % (M * K) / K) * w)).take w)) := by
  have hT1 : (blkTg K (M * w * post) pre L).length = pre * (M * w * post * K) := by
    rw [length_blkTg]
  refine ⟨?_, fun b' hb' c hc => ?_, fun b' hb' e he c hc => ?_⟩
  · unfold rgp; rw [length_blkTg]; ring
  · have hb : b' / (M * K) < pre := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm (M * K) pre]; exact hb')
    have hq : b' % (M * K) < M * K := Nat.mod_lt _ (by positivity)
    have hj : b' % (M * K) / K < M := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm K M]; exact hq)
    have hr : b' % K < K := Nat.mod_lt _ hK
    have hlen := hL.2.1 _ hb c hc
    have : (b' % K * M + b' % (M * K) / K + 1) * w ≤ K * (M * w) := by
      have : b' % K * M + b' % (M * K) / K + 1 ≤ K * M := by
        have : (b' % K + 1) * M ≤ K * M := Nat.mul_le_mul_right _ hr
        rw [Nat.succ_mul] at this; omega
      calc _ ≤ K * M * w := Nat.mul_le_mul_right _ this
        _ = K * (M * w) := by ring
    simp only [List.length_take, List.length_drop, hlen]
    rw [Nat.succ_mul] at this; omega
  -- decompose `b' = (b M + j) K + r`
  beta_reduce
  set b := b' / (M * K) with hbdef
  set q := b' % (M * K) with hqdef
  set j := q / K with hjdef
  set r := q % K with hrdef
  have hq : q < M * K := Nat.mod_lt _ (by positivity)
  have hj : j < M := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm K M]; exact hq)
  have hr : r < K := Nat.mod_lt _ hK
  have hb : b < pre := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm (M * K) pre]; exact hb')
  have hrr : b' % K = r := by
    rw [hrdef, hqdef, Nat.mod_mul_left_mod]
  have hb'e : b' = (b * M + j) * K + r := by
    have h1 := Nat.div_add_mod' b' (M * K)
    have h2 := Nat.div_add_mod' q K
    rw [← hbdef, ← hqdef] at h1
    rw [← hjdef, ← hrdef] at h2
    nlinarith
  clear_value r j q b
  rw [hrr]
  have hep : e * post + c < w * post := lt_mul_of_split he hc
  unfold rgp
  rw [hb'e, show ((b * M + j) * K + r) * (w * post) + e * post + c =
      (b * M + j) * (K * (w * post)) + r * (w * post) + (e * post + c) by ring,
    blkTg_getD (w * post) K (pre * M) _ (by nlinarith) hr hep]
  have hy : j * (w * post) + (e * post + c) < M * w * post := by
    have := lt_mul_of_split hj hep; nlinarith
  rw [show (b * M + j) * (w * post * K) + (e * post + c) * K + r =
      b * (M * w * post * K) + (j * (w * post) + (e * post + c)) * K + r by ring,
    blkTg_getD K (M * w * post) pre _ hb hy hr]
  have ha : (r * M + j) * w + e < K * (M * w) := by
    have h1 : (r * M + j) * w + e < (r * M + j + 1) * w := by nlinarith
    have h2 : r * M + j + 1 ≤ K * M := by
      have : (r + 1) * M ≤ K * M := Nat.mul_le_mul_right _ hr
      rw [Nat.succ_mul] at this; omega
    have : (r * M + j + 1) * w ≤ K * M * w := Nat.mul_le_mul_right _ h2
    nlinarith
  rw [show b * (K * (M * w * post)) + r * (M * w * post) + (j * (w * post) + (e * post + c)) =
      b * (K * (M * w) * post) + ((r * M + j) * w + e) * post + c by ring,
    hL.2.2 b hb _ ha c hc, getD_drop_take _ _ _ _ he]

end lists

end J6A

