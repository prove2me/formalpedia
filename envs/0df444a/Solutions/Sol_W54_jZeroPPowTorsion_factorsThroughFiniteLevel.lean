theorem solution (M p : ℕ) [NeZero M] (hp : p.Prime) :
    ∀ n : ℕ,
    ∃ L : IntermediateField ℚ (AlgebraicClosure ℚ), FiniteDimensional ℚ L ∧
      ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, (∀ x ∈ L, σ x = x) →
        ∀ v : JZero M,
          v ∈ Pic0.torsion (AlgebraicClosure ℚ) (modularFunctionFieldBar M) (p ^ n) →
          σ • v = v := by
  intro n
  obtain ⟨L, hL, h⟩ := ModularCurve.JZero.exists_finiteDimensional_smul_eq_self_of_torsion M
    (p ^ n) (pow_pos hp.pos n)
  refine ⟨L, hL, fun σ hσ v hv => h σ hσ v ?_⟩
  exact (Pic0.mem_torsion).mp hv

