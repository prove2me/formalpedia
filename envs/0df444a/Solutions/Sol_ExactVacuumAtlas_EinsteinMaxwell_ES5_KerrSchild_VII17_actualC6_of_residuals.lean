/-- `ExtV` from right limits of derivatives (VII16 glue). -/
theorem extV_of_RL {k : ℕ} {g : ℝ → ℝ} (hg : PS g) (hR : RL k g) {L : ℝ}
    (hL : Tendsto g (𝓝[>] (0:ℝ)) (𝓝 L)) : ExtV k g L := by
  obtain ⟨δ, hδ, hc⟩ := hg.contDiffOn
  choose! Lf hLf using RL_iter hR
  have hglue := VII16.contDiffOn_glue k hδ (hc.of_le (by exact_mod_cast le_top)) hLf
  refine ⟨VII16.glue Lf k g, hglue.contDiffAt (Ioo_mem_nhds (by linarith) hδ), ?_, ?_⟩
  · filter_upwards [VII16.Ioo_mem_nhdsGT' hδ] with x hx using VII16.glue_of_pos hx.1
  · rw [VII16.glue_zero]
    have h0 := hLf 0 (Nat.zero_le _)
    rw [iteratedDeriv_zero] at h0
    exact tendsto_nhds_unique h0 hL

