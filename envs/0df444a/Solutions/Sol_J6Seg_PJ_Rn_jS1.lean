/-- `ljP` on the managed state. -/
theorem Rn.ljP {v : Vr} {c : Cs} {s t lam w A : ℕ} (h22 : v 22 = s) (h23 : v 23 = t)
    (h24 : v 24 = lam) (h26 : v 26 = w) (hs : 0 < s) (hl : 0 < lam)
    (hsA : s ≤ 2 ^ A) (htA : t ≤ 2 ^ A) (hlA : lam ≤ 2 ^ A) (hwA : w ≤ 2 ^ A) (hA : 2 ≤ A) :
    Rn (Src.ljP 22 23 24 26) v c (· = v) (Src.ljOut c s t lam w) (Src.ljCost s A) := by
  refine ⟨v, rfl, fun s0 => ?_⟩
  have H := Src.ljP_sp s0 (RF v c) (iS := 22) (iT := 23) (iL := 24) (iW := 26)
    (by unfold Src.Free; decide) (by unfold Src.Free; decide) (by unfold Src.Free; decide)
    (by unfold Src.Free; decide) (LS := []) (LT := []) (LL := []) (LW := [])
    (by rw [RF_in (by decide), h22]) (by rw [RF_in (by decide), h23])
    (by rw [RF_in (by decide), h24]) (by rw [RF_in (by decide), h26]) hs hl hsA htA hlA hwA hA
  have e : Src.ljOut (RF v c) s t lam w = RF v (Src.ljOut c s t lam w) := by
    unfold Src.ljOut
    rw [RF_out (j := 30) (by decide), RF_out (j := 31) (by decide), RF_out (j := 32) (by decide),
      RF_out (j := 33) (by decide), upd_RF_out (by decide), upd_RF_out (by decide),
      upd_RF_out (by decide), upd_RF_out (by decide)]
  rw [e] at H
  exact H

/-- **Stage 1.** -/
theorem Rn.jS1_sol_aux {W N : ℕ} {v : Vr} {c : Cs} {s t lam w : ℕ} (hN : N ≤ 2 ^ W) (hN1 : 1 ≤ N)
    (hv : BV W v) (h22 : v 22 = s) (h23 : v 23 = t) (h24 : v 24 = lam) (h26 : v 26 = w)
    (hs : 0 < s) (hl : 0 < lam) (hsW : s ≤ 2 ^ W) (htW : t ≤ 2 ^ W) (hlW : lam ≤ 2 ^ W)
    (hwW : w ≤ 2 ^ W) (hW2 : 2 ≤ W)
    (hSt : c sSt = []) (h30 : c 30 = []) (h31 : c 31 = []) (h32 : c 32 = []) (h33 : c 33 = []) :
    Rn jS1 v c (fun v' => v' = update (update v 29 0) 28
        ((Jlist (mkBlocks s t lam w)).length : ℤ) ∧ BV W v')
      (cS1 c v s t lam w) (cJS1 W N s) := by
  unfold PJ.jS1 cJS1
  have eA : runL jA (v, c) = (v, update c sSt [v 12, v 11, v 7, v 4, v 3]) := by
    simp only [jA, runL, Ins.run, E.den, update_self, update_idem, hSt]
  have RA := Rn.insL (c := c) hN jA hv (by
    simp only [jA, OkL, Ins.ok, Ins.run]
    refine ⟨⟨by decide, by decide, rfl, Nat.one_le_two_pow⟩, ⟨by decide, by decide, rfl,
      Nat.one_le_two_pow⟩, ⟨by decide, by decide, rfl, Nat.one_le_two_pow⟩,
      ⟨by decide, by decide, rfl, Nat.one_le_two_pow⟩, ⟨by decide, by decide, rfl,
      Nat.one_le_two_pow⟩, trivial⟩)
  rw [eA] at RA
  dsimp only at RA
  refine Rn.seq RA (fun v1 ⟨e1, b1⟩ => ?_)
  subst v1
  have RL := Rn.ljP (c := update c sSt [v 12, v 11, v 7, v 4, v 3]) h22 h23 h24 h26 hs hl hsW
    htW hlW hwW hW2
  refine Rn.seq RL (fun v2 e2 => ?_)
  subst v2
  set c1 := update c sSt [v 12, v 11, v 7, v 4, v 3] with hc1
  set m := (Jlist (mkBlocks s t lam w)).length with hm
  have hms : m ≤ s := Jlist_length_le _
  have l31 : Src.ljOut c1 s t lam w 31 = [(m : ℤ)] := by
    simp only [Src.ljOut]
    rw [update_of_ne (by decide), update_of_ne (by decide), update_self, hc1,
      update_of_ne (by decide), h31]
  have eR : runL jR (v, Src.ljOut c1 s t lam w) =
      (update (update v 29 0) 28 (m : ℤ), Src.ljOut c1 s t lam w) := by
    simp only [jR, runL, Ins.run, E.den, l31, Int.toNat_zero, List.getD_cons_zero]
  have RR := Rn.insL (c := Src.ljOut c1 s t lam w) hN jR hv (by
    simp only [jR, OkL, Ins.ok, Ins.run, E.den, l31]
    refine ⟨⟨by decide, by decide, by decide, by decide, by decide, by decide, rfl,
      by simp only [E.lb]; norm_num <;> exact Nat.one_le_two_pow, by simp, by simp, by simpa using hN1, ?_⟩, trivial⟩
    intro x hx
    simp only [List.mem_singleton] at hx
    subst hx
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast (by omega : m ≤ 2 ^ W))
  rw [eR] at RR
  dsimp only at RR
  refine RR.congr ?_
  unfold Src.ljOut cS1
  rw [hc1]
  simp only [update_of_ne (show (30 : Fin HS) ≠ sSt by decide),
    update_of_ne (show (31 : Fin HS) ≠ sSt by decide), update_of_ne (show (32 : Fin HS) ≠ sSt by decide),
    update_of_ne (show (33 : Fin HS) ≠ sSt by decide), h30, h31, h32, h33, List.append_nil]
  congr 4
  generalize Jlist (mkBlocks s t lam w) = L
  induction L with
  | nil => rfl
  | cons a L ih => simp_all

