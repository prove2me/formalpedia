set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-! Canonical count words and the conversion from encoded length to declared input size. -/

namespace OAI.Algorithms.SubexponentialSAT.SqrtLogSpace

theorem powerWord_countWord (n : ℕ) :
    List.replicate n false ++ [true] = countWord (2 ^ n) := by
  rw [countWord, ite_eq_right (pow_ne_zero _ (by decide : (2 : ℕ) ≠ 0))]
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ', Nat.bit0_bits _ (pow_ne_zero _ (by decide : (2 : ℕ) ≠ 0))]
      simpa [List.replicate_succ] using congrArg (List.cons false) ih

end OAI.Algorithms.SubexponentialSAT.SqrtLogSpace
end

section
-- module Solutions.OAIQ081_SAT.SubexponentialSAT_SqrtLogSpace_DisjointReuse_DFSVisit
attribute [-instance] _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.IrreducibleSearch.primeThree _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.RingCore.primeThree
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-! One complete native DFS visit. The leaf callback below is an intermediate
implementation contract for a fixed finite command, not a final theorem premise.
The actual streamed leaf program must instantiate it at integration.
-/
namespace OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.DisjointReuse.DFSVisit

open BitProgram StructuredCalls SparseDFSProgram SparseDFSRefinement

namespace BoundedEval
variable {command first second yes no : Code} {t u B : ℕ} {a b c : Data}

theorem final_bound (h : BoundedEval command t a b B) :
    ∀ i, (b.stacks i).length ≤ B :=
  h.space t _ le_rfl (compiled_trace h.eval 256 256)

theorem seq (h : BoundedEval first t a b B) (g : BoundedEval second u b c B) :
    BoundedEval (.seq first second) (t + u) a c B :=
  ⟨h.eval.seq g.eval, StructuredSpace.sequence_stack_bound h.eval g.eval 256 256 h.space g.space
    (compiled (.seq first second) 256 256) (siteAddress (.seq first second))
    (exitAddress (.seq first second)) (compiled_site (.seq first second) 256 256)⟩

end BoundedEval

end OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.DisjointReuse.DFSVisit
end

section
-- module Solutions.OAIQ081_SAT.SubexponentialSAT_SqrtLogSpace_NativeCorrect
attribute [-instance] _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.IrreducibleSearch.primeThree _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.RingCore.primeThree
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.Native

open BitProgram StructuredCalls

theorem powerBody_eval (n : ℕ) (output : List Bool) :
    Eval powerBody 3 (powerBoundary (n + 1) output)
      (powerBoundary n (false :: output)) := by
  have h := (StructuredProgram.Eval.atom (.set (0 : Fin 2) false)
      (powerBoundary (n + 1) output)).seq
    ((StructuredProgram.Eval.atom (.push (1 : Fin 2) 0) _).seq
      (StructuredProgram.Eval.atom (.pop (0 : Fin 2) 0 1) _))
  apply Eval.base
  convert h using 1
  all_goals try with_reducible_and_instances rfl
  cases n <;> apply CounterForPrograms.data_ext <;> funext i <;> fin_cases i <;>
    simp [powerBoundary, powerState, StructuredProgram.Atom.eval,
      StructuredProgram.Atom.instr, StructuredProgram.State.ofCfg,
      execInstr, readRegs, Encoding.encodeNat,
      List.replicate_succ]

theorem powerLoop_eval (n : ℕ) (output : List Bool) :
    Eval (.while 0 powerBody) (4 * n + 1) (powerBoundary n output)
      (powerState false [] (List.replicate n false ++ output)) := by
  induction n generalizing output with
  | zero => exact .while_false rfl
  | succ n ih =>
      have h := Eval.while_true (test := (0 : Fin 2)) (by rfl)
        (powerBody_eval n output) (ih (false :: output))
      convert h using 1
      · omega
      · congr 1
        simp [List.replicate_succ', List.append_assoc]

theorem powerSeed_eval (regs : Fin 2 → Bool) (n : ℕ) :
    Eval powerSeed 3 ⟨regs, ![Encoding.encodeNat n, []]⟩ (powerBoundary n [true]) := by
  have h := (StructuredProgram.Eval.atom (.set (0 : Fin 2) true)
      (⟨regs, ![Encoding.encodeNat n, []]⟩ : State 2 2)).seq
    ((StructuredProgram.Eval.atom (.push (1 : Fin 2) 0) _).seq
      (StructuredProgram.Eval.atom (.pop (0 : Fin 2) 0 1) _))
  apply Eval.base
  convert h using 1
  all_goals try with_reducible_and_instances rfl
  cases n <;> apply CounterForPrograms.data_ext <;> funext i <;> fin_cases i <;>
    simp [powerBoundary, powerState, StructuredProgram.Atom.eval,
      StructuredProgram.Atom.instr, StructuredProgram.State.ofCfg,
      execInstr, readRegs, Encoding.encodeNat,
      List.replicate_succ]

theorem powerCommand_eval (regs : Fin 2 → Bool) (n : ℕ) :
    Eval powerCommand (4 * n + 4) ⟨regs, ![Encoding.encodeNat n, []]⟩
      (powerState false [] (List.replicate n false ++ [true])) := by
  convert (powerSeed_eval regs n).seq (powerLoop_eval n [true]) using 1
  · rfl
  · omega

theorem power_count_trace (regs : Fin 2 → Bool) (n : ℕ) :
    Trace powerProgram (4 * n + 5)
      ((⟨regs, ![Encoding.encodeNat n, []]⟩ : State 2 2).withPC
        (some powerProgram.entry))
      ((powerState false [] (countWord (2 ^ n))).withPC none) := by
  simpa only [powerProgram, powerWord_countWord, Nat.add_assoc] using
    compiled_halt_trace (powerCommand_eval regs n) 0 1

theorem copyWord_eval (src dst scratch : Fin 1220) (a : State 80 1220)
    (hsd : src ≠ dst) (hst : src ≠ scratch) (htd : scratch ≠ dst)
    (hblank : a.stacks scratch = []) :
    Eval (copyWord src dst scratch) (7 * (a.stacks src).length + 5) a
      (copiedWord src dst a) :=
  Eval.call _ (ListRegisterProgram.copy_run src dst scratch 72 73 hsd hst htd
    (by decide) a.regs a.stacks hblank)

end OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.Native
end

section
-- module Solutions.OAIQ081_SAT.SubexponentialSAT_SqrtLogSpace_NativeLeaf
attribute [-instance] _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.IrreducibleSearch.primeThree _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.RingCore.primeThree
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-! Actual adapters for the streamed counting leaf. Both initial code rows
and newly generated rows use the canonical modulus word's exact width. -/

namespace OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.Native

open BitProgram StructuredCalls

/-- The copy table preserves its source and never needs a word longer than
that source when its destination and scratch are initially empty. -/
theorem copyWord_space (src dst scratch : Fin 1220) {steps bound : ℕ}
    {a b : State 80 1220} (he : Eval (copyWord src dst scratch) steps a b)
    (hsd : src ≠ dst) (hst : src ≠ scratch) (htd : scratch ≠ dst)
    (hdst : a.stacks dst = []) (htmp : a.stacks scratch = [])
    (ha : ∀ i, (a.stacks i).length ≤ bound) :
    ∀ prefixSteps c, prefixSteps ≤ steps →
      Trace (compiled (copyWord src dst scratch) 256 256) prefixSteps
        (a.withPC (some (compiled (copyWord src dst scratch) 256 256).entry)) c →
      ∀ i, (c.stacks i).length ≤ bound := by
  cases he with
  | call p ht =>
      apply StructuredSpace.call_stack_bound (StackRoutines.copyProgram src dst scratch 72 73)
        (compiled (copyWord src dst scratch) 256 256) (siteAddress (copyWord src dst scratch))
        (exitAddress (copyWord src dst scratch))
        (compiled_site (copyWord src dst scratch) 256 256) ht
      intro prefixSteps c _ hc
      exact CopySpace.copyProgram_no_growth src dst scratch 72 73 hsd hst htd
        rfl hdst htmp ha hc

end OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.Native
end

section
-- module Solutions.OAIQ081_SAT.SubexponentialSAT_SqrtLogSpace_NativeTerminal
attribute [-instance] _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.IrreducibleSearch.primeThree _root_.OAI.Algorithms.SubexponentialSAT.SqrtLog.RingCore.primeThree
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

/-! Actual outer-CNF terminal handling. The ambient unary header is retained;
an empty formula emits its full count 2^n, and an empty clause emits zero. -/

namespace OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.NativeTerminal

open BitProgram StructuredCalls
open scoped BigOperators

/-- The power producer's local footprint is independent of retained DFS words. -/
theorem powerCall_space {steps bound : ℕ} {a b : Data}
    (he : Eval powerCall steps a b) (n : ℕ)
    (hn : a.stacks 268 = Encoding.encodeNat n) (hout : a.stacks 263 = [])
    (hframe : ∀ i, (a.stacks i).length ≤ bound) (hbudget : 5 * n + 6 ≤ bound) :
    ∀ prefixSteps c, prefixSteps ≤ steps →
      Trace (compiled powerCall 256 256) prefixSteps
        (a.withPC (some (compiled powerCall 256 256).entry)) c →
      ∀ i, (c.stacks i).length ≤ bound := by
  let localData := projectState powerRegs powerStacks a
  have hp : localData = (⟨localData.regs, ![Encoding.encodeNat n, []]⟩ : State 2 2) := by
    apply CounterForPrograms.data_ext
    · rfl
    · funext i; fin_cases i <;> simp [localData, projectState, hn, hout]
  have hrun := Native.power_count_trace localData.regs n
  rw [← hp] at hrun
  have hsize : dataBits (localData.withPC (some Native.powerProgram.entry)) ≤ n + 1 := by
    simp [dataBits, stackBits, localData, projectState,
      Fin.sum_univ_two, hn, hout]
  have hlocal : ∀ prefixSteps c, prefixSteps ≤ 4 * n + 5 →
      Trace Native.powerProgram prefixSteps
        (localData.withPC (some Native.powerProgram.entry)) c →
      ∀ i, (c.stacks i).length ≤ bound := by
    intro prefixSteps c hprefix htrace i
    have hg := StructuredSpace.local_stack_bound Native.powerProgram hsize
      prefixSteps c hprefix htrace i
    omega
  have hcall := eval_call_from_state Native.powerProgram powerRegs powerStacks a
    powerRegs.injective powerStacks.injective hrun
  have hsteps : steps = 4 * n + 5 := StreamResources.eval_steps_eq 256 256 he hcall
  subst steps
  have hinit : ProgramLinking.embedCfg powerRegs powerStacks id none (a.withPC none)
      (localData.withPC (some Native.powerProgram.entry)) =
      a.withPC (some (ProgramLinking.liftProgram Native.powerProgram powerRegs powerStacks).entry) := by
    change (embedState powerRegs powerStacks a localData).withPC _ = _
    rw [show embedState powerRegs powerStacks a localData = a from
      embedState_project _ _ a powerRegs.injective powerStacks.injective]
    rfl
  have hglobal := StructuredSpace.liftProgram_stack_bound Native.powerProgram
    powerRegs powerStacks (a.withPC none) powerRegs.injective powerStacks.injective
    hrun hlocal hframe
  rw [hinit] at hglobal
  simp only [Nat.max_self] at hglobal
  cases he with
  | call p ht =>
      exact StructuredSpace.call_stack_bound _ (compiled powerCall 256 256)
        (siteAddress powerCall) (exitAddress powerCall) (compiled_site powerCall 256 256)
        ht hglobal


open DisjointReuse.DFSVisit

/-- Copy and power synthesis retain the caller's same per-stack envelope. -/
theorem power_bounded_oai (a : Data) (n bound : ℕ)
    (hn : a.stacks 258 = Encoding.encodeNat n)
    (houtput : a.stacks 263 = []) (hwork : a.stacks 268 = [])
    (hscratch : a.stacks 269 = [])
    (hframe : ∀ i, (a.stacks i).length ≤ bound) (hbudget : 5 * n + 6 ≤ bound) :
    BoundedEval power (11 * n + 17) a (powered a n) bound := by
  let d := Native.copiedWord 258 268 a
  have hc := Native.copyWord_eval 258 268 269 a (by decide) (by decide) (by decide) hscratch
  have hcopy : BoundedEval (Native.copyWord 258 268 269)
      (7 * (a.stacks 258).length + 5) a d bound :=
    ⟨hc, Native.copyWord_space 258 268 269 hc (by decide) (by decide) (by decide)
      hwork hscratch hframe⟩
  have hp : projectState powerRegs powerStacks d =
      (⟨d.regs ∘ powerRegs, ![Encoding.encodeNat n, []]⟩ : State 2 2) := by
    apply CounterForPrograms.data_ext
    · rfl
    · funext i
      fin_cases i <;> simp [projectState, d, Native.copiedWord,
        StackRoutines.copyStacks, hn, hwork, houtput]
  have ht := Native.power_count_trace (d.regs ∘ powerRegs) n
  rw [← hp] at ht
  have he := eval_call_from_state Native.powerProgram powerRegs powerStacks d
    powerRegs.injective powerStacks.injective ht
  have hpow : BoundedEval powerCall (4 * n + 5) d (powered a n) bound :=
    ⟨he, powerCall_space he n
      (by simp [d, Native.copiedWord, StackRoutines.copyStacks, hn, hwork])
      (by simp [d, Native.copiedWord, StackRoutines.copyStacks, houtput])
      hcopy.final_bound hbudget⟩
  have whole := hcopy.seq hpow
  convert whole using 1
  · rfl
  · rw [hn]
    simp only [Encoding.length_encodeNat]
    omega

end OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.NativeTerminal
end

theorem solution : type_of% @OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.NativeTerminal.power_bounded_oai := @OAI.Algorithms.SubexponentialSAT.SqrtLogSpace.NativeTerminal.power_bounded_oai
