namespace CLRS.SCC

open Algo2LeanGenerated CLRS.GraphTraversal

/-- The same returning call supplies a fresh component array and a contiguous,
nonempty label for every strongly connected component of the original graph.
Labels themselves are not canonical. The result object is the DFS result of
the second pass on the transpose; only its component fields are specified here.
All previously allocated caller storage and every other clock are preserved. -/
def Post (before after : Heap) (result : ObjectRef) (g : Graph) : Prop :=
  Algo.dfs.Algo2LeanGenerated.is_DFSResult after result ∧
  FreshObject before after result ∧
  Preserves before after ∧
  ∃ (component : SeqRef) (count : Nat),
    Algo.dfs.Algo2LeanGenerated.field_DFSResult_component after result = some component ∧
    Algo.dfs.Algo2LeanGenerated.field_DFSResult_components after result = some (count : Int) ∧
    FreshArrays before after [component] ∧
    count ≤ g.size ∧
    (count = 0 ↔ g.size = 0) ∧
    (∀ vertex, Vertex g vertex →
      0 ≤ after.read component vertex ∧ after.read component vertex < (count : Int)) ∧
    (∀ label : Nat, label < count →
      ∃ vertex, Vertex g vertex ∧ after.read component vertex = (label : Int)) ∧
    (∀ u v, Vertex g u → Vertex g v →
      (after.read component u = after.read component v ↔ StronglyConnected g u v))

/-- Transposition returns a newly allocated graph representing all reversed
adjacency occurrences, including their multiplicities. Its vertex and total
occurrence counts are unchanged. The original caller storage is preserved. -/
def TransposePost (before after : Heap) (result : ObjectRef) (g : Graph) : Prop :=
  FreshObject before after result ∧
  Preserves before after ∧
  ∃ transposed : Graph,
    GraphRep after result transposed ∧
    IsTranspose g transposed ∧
    edgeCount transposed = edgeCount g

end CLRS.SCC


