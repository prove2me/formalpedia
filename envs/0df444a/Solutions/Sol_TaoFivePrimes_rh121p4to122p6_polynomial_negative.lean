attribute [local irreducible] a r b
lemma polynomial_negative (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
    (ha : (607/5:ℝ) ≤ s.im) (hb : s.im ≤ (613/5:ℝ)) :
    10 ≤ -(TaoFivePrimes_RHLocalRationalPolynomial TaoFivePrimes_RH123RoundedCoefficients12 (10^12)
      40 (246/2) s).re := by
  let x : Set.Icc (0:ℝ) 1 := ⟨4*(s.re-1/2)^2,⟨by positivity,by
    nlinarith [mul_nonneg h0 (show 0≤1-s.re by linarith)]⟩⟩
  let y : Set.Icc (0:ℝ) 1 := ⟨(5/6)*(s.im-(607/5)),⟨by linarith,by linarith⟩⟩
  have hr : ∀ i, r i=TaoZetaNumerics.bernsteinTransform 19 (a i) := by
    intro i
    funext j
    exact bernstein_checked.1 i j
  have hc : ∀ j, (fun i => b i j)=TaoZetaNumerics.bernsteinTransform 9
      (fun i => r i j) := by
    intro j
    funext i
    exact bernstein_checked.2.1 i j
  have hl : ∀ i j, (10:ℝ)≤(b i j:ℝ) := by
    intro i j
    exact_mod_cast bernstein_checked.2.2 i j
  have hh := CertifiedLocalPolynomial.bivariate_bernstein_lower 9 19 a r b hr hc 10 hl x y
  rw [power_identity]
  exact hh
end Negative107

theorem solution (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
