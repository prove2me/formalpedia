theorem solution (O V : Type) [CommRing O] [AddCommGroup V]
    [Module O V] (I : Ideal O) [MeasurableSpace V]
    (hgen : ‹MeasurableSpace V› = TypeDensity.adicCylinderSpace I V) (F : V → V) (honto : Function.Surjective F)
    (hcong : ∀ j x y, TypeDensity.adicCongr I j (F x) (F y) ↔ TypeDensity.adicCongr I j x y) (mu : MeasureTheory.Measure V)
    [MeasureTheory.IsProbabilityMeasure mu]
    (hball : ∀ j (x y : V), mu {z | adicCongr I j z x} = mu {z | adicCongr I j z y}) :
    MeasureTheory.MeasurePreserving F mu mu := by
  have hF : Measurable F := TypeDensity.congruence_bijection_measurable O V I hgen F honto hcong
  refine ⟨hF, ?_⟩
  have : MeasureTheory.IsFiniteMeasure (mu.map F) := inferInstance
  refine TypeDensity.finite_measures_from_cylinders O V I (mu.map F) mu hgen ?_
  intro j x
  have hmeas : MeasurableSet {y | adicCongr I j y x} := by
    rw [hgen]
    exact MeasurableSpace.measurableSet_generateFrom (Or.inr ⟨j, x, rfl⟩)
  rw [MeasureTheory.Measure.map_apply hF hmeas]
  obtain ⟨w, rfl⟩ := honto x
  have : F ⁻¹' {y | adicCongr I j y (F w)} = {z | adicCongr I j z w} := by
    ext z; simp [hcong]
  rw [this]
  exact hball j w (F w)
