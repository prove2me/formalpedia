theorem child01_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu002.lin : ℝ) ≤ (S : ℝ) * logProd gu002.lo) :
    (gu006.lfin : ℝ) ≤ (S : ℝ) * logProd gu006.top ∧
      (∀ x : ℝ, (gu002.lo : ℝ) < x → x ≤ (gu006.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
