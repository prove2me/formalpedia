theorem MIPRE.Introspection.BinaryComplete.strategy_value (hm : m ∣ Fintype.card F) (b : Module.Basis (Fin t) (ZMod 2) F) (hb : LowDegree.IsSelfDualBasis b)
    (hd : 1 ≤ d) (hL : ∀ w, (L w).SupportedOn univ) (hR : R.IsPCC) (hv : R.value = 1) :
    (strategy (d := d) L D R hm b hL).value = 1 := by sorry
