namespace DecrAlmostLinearSSSP.Decremental.CoreInitialize
open Structured
lemma boot_records_eval (b : Core) (N : ℕ) (p : Program) :
    let B := b.input.n+3*b.input.k+2
    let K := computableCutQuality N (2*b.input.size)
    ∃ cost t, Eval (bootRecordsCode N) (data (initialMachine p b.input)) cost t ∧
      cost ≤ (80000*(N+1)+180)*b.input.size+
        4*⌈32*logarithm2 (b.input.size+1)/b.input.accuracy⌉₊+86 ∧
      CoreHost.Image b B K (initializeState b) t ∧
      (∀ j, t.natMem (B+4*j+2) = 0 ∧ t.realMem (B+4*j+2) = 0) ∧
      t.natMem (CoreMemory.sourceRecord b B+6) = 0 ∧
      (∀ j, t.natReg (shadowReg j) = 0 ∧ t.realReg (shadowReg j) = 0) := by
  dsimp only
  let B := b.input.n+3*b.input.k+2
  let K := computableCutQuality N (2*b.input.size)
  obtain ⟨cu,u,hu,hcu,huc,hup,hul,huhead,hucount,hurun,huthresh,hun,hur,hutail⟩ := register_eval b N p
  have hB : b.input.n+3*b.input.k ≤ B := by dsimp [B];omega
  have hG (v : Fin b.input.n) : b.input.n+3*b.input.k ≤ CoreMemory.gradientCell b B v := by
    dsimp [CoreMemory.gradientCell,CoreMemory.gradientBase,B];omega
  have hzeros : ∀ v : Fin b.input.n, u.natMem (CoreMemory.gradientCell b B v) = 0 ∧ u.realMem (CoreMemory.gradientCell b B v) = 0 := by
    intro v
    rw [hun,hur]
    exact ⟨initial_nat_above_tape p b.input _ (hG v),rfl⟩
  have hsrcN : u.natMem b.input.source.val = 0 := by
    rw [hun]
    simp [initialMachine,Nat.not_le.mpr b.input.source.isLt]
  have hsrcR : u.realMem b.input.source.val = 0 := by rw [hur];rfl
  have htape : Exact.Adjacency.Tape b.input u := by
    simpa only [Exact.Adjacency.Tape,hun,data] using Exact.Adjacency.tape_initial p b.input
  obtain ⟨cr,t,ht,hcr,hti,htf⟩ := records_eval b B K u hB huc hup hul htape hucount hzeros hsrcN hsrcR
  have himage := CoreHost.initial_image b B K t hti
    ((ht.nat_frame records_head_frame).trans huhead) hti.captured.base
  have hguest (j : ℕ) : t.natMem (B+4*j+2) = 0 ∧ t.realMem (B+4*j+2) = 0 := by
    have hf := htf (B+4*j+2) (CoreMemory.protected_guest b B j) (by dsimp [B];omega)
    exact ⟨hf.1.trans (by rw [hun];exact initial_nat_above_tape p b.input _ (by dsimp [B];omega)),
      hf.2.trans (by rw [hur];rfl)⟩
  have hw : t.natMem (CoreMemory.sourceRecord b B+6) = 0 := by
    have ha : CoreMemory.sourceRecord b B ≤ CoreMemory.sourceRecord b B+6 := by omega
    have hf := htf _ (CoreMemory.protected_after b B _ ha)
      (by dsimp [CoreMemory.sourceRecord,CoreMemory.gradientBase,B];omega)
    have hb : b.input.n+3*b.input.k ≤ CoreMemory.sourceRecord b B+6 := by
      dsimp [CoreMemory.sourceRecord,CoreMemory.gradientBase,B];omega
    exact hf.1.trans (by rw [hun];exact initial_nat_above_tape p b.input _ hb)
  refine ⟨cu+cr,t,Eval.seq hu ht,by nlinarith only [hcu,hcr],himage,hguest,hw,?_⟩
  intro j
  have hodd : shadowReg j%2 = 1 := by simp [shadowReg]
  have hf := evenRegisters_frames _ records_even (shadowReg j) hodd
  rw [ht.nat_frame hf.1,ht.real_frame hf.2]
  exact hutail j
end DecrAlmostLinearSSSP.Decremental.CoreInitialize
