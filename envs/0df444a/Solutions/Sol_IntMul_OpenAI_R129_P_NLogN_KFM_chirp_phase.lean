theorem pushLoop_run (B : RS) (dst : Fin HS) (hdO : dst ≠ mOc) (s : IState HS) (d : ℕ)
    (LD : List Item) (hD : s.G NLogN.KFM.zD = .int (d : ℤ) :: LD) (hw : mOc ∉ B.writes) (v : ℕ → ℤ)
