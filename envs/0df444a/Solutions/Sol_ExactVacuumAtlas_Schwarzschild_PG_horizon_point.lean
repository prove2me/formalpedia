theorem solution (M ε : ℝ) (hM : 0 < M) (hε : ε ^ 2 = 1) :
    ∃ x ∈ domEF, x 1 = 2 * M ∧ ∀ b d, ricciOf (gPG M ε) (giPG M ε) b d x = 0 :=
  ⟨_, (horizon_mem_domEF hM).1, (horizon_mem_domEF hM).2,
