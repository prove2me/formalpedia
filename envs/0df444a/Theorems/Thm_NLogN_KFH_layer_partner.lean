variable {P K D S ρ : ℕ}

theorem NLogN.KFH.layer_partner (hρ : ρ < K) (i : Fin D) {j : ℕ}
    (hj : j < vol (Butterfly.layerShape P K D S)) (b : Fin 2) :
    ((Butterfly.layerSel P K D S ρ hρ).bits (decode (Butterfly.layerShape P K D S) j) i : ℕ) =
      j / stT K D S ρ i % 2 ∧
    ((encode (Butterfly.layerShape P K D S) ((Butterfly.layerSel P K D S ρ hρ).set
      (decode (Butterfly.layerShape P K D S) j)
      (Function.update ((Butterfly.layerSel P K D S ρ hρ).bits
        (decode (Butterfly.layerShape P K D S) j)) i b)) : ℕ) : ℤ) =
      j + ((b : ℤ) - (j / stT K D S ρ i % 2 : ℕ)) * stT K D S ρ i := by sorry
