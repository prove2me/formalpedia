theorem encK_fIn_eq (t : IState HS) (xs ys : List ℤ) (P q M B : ℕ) (R L1 L2 L3 L4 : List Item)
    (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int q :: L2) (h3 : t.G 3 = .int M :: L3)
    (h4 : t.G 4 = .int B :: L4) :
    NLogN.KIL.encK (baseOf t R L1 L2 L3 L4) (toF (fIn ys P q M B)) = t.upd 0 (ints ys ++ R) := by
  refine IState.ext' (fun j => ?_) rfl rfl
  fin_cases j <;> simp +decide [baseOf, toF, fIn, h1, h2, h3, h4]
  all_goals first | exact h1.symm | exact h2.symm | exact h3.symm | exact h4.symm

theorem encK_fIn_eq' (t : IState HS) (xs : List ℤ) (P q M B : ℕ) (R L1 L2 L3 L4 : List Item)
    (h0 : t.G 0 = ints xs ++ R)
    (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int q :: L2) (h3 : t.G 3 = .int M :: L3)
    (h4 : t.G 4 = .int B :: L4) :
    NLogN.KIL.encK (baseOf t R L1 L2 L3 L4) (toF (fIn xs P q M B)) = t := by
  rw [encK_fIn_eq t xs xs P q M B R L1 L2 L3 L4 h1 h2 h3 h4, ← h0, IState.upd_self]

theorem bnd_getD {Bb : ℕ} {xs : List ℤ} (h : Bnd Bb xs) (j : ℕ) : zsz (xs.getD j 0) ≤ Bb := by
  rcases Nat.lt_or_ge j xs.length with hj | hj
  · rw [List.getD_eq_getElem _ _ hj]; exact h _ (List.getElem_mem hj)
  · rw [List.getD_eq_default _ _ hj, zsz_zero]; omega

