/-! ## Pointwise algebra -/

/-- `Σ_{a,b} g^{ab} g_{ab} = 4` for a symmetric `g` with left inverse `ginv`. -/
theorem trace_ginv_g {g ginv : Metric 4} {x : Pt 4} (hs : ∀ i j, g i j x = g j i x)
    (hinv : metricMatrix ginv x * metricMatrix g x = 1) :
    ∑ a : Fin 4, ∑ b : Fin 4, ginv a b x * g a b x = 4 := by
  have h : ∀ a : Fin 4, ∑ b : Fin 4, ginv a b x * g a b x = 1 := by
    intro a
    have e := congrFun (congrFun hinv a) a
    simp only [Matrix.mul_apply, metricMatrix, Matrix.of_apply, Matrix.one_apply_eq] at e
    rw [← e]
    exact Finset.sum_congr rfl fun b _ => by rw [hs a b]
  simp only [h, Finset.sum_const, Finset.card_univ, Fintype.card_fin]
  norm_num

theorem raise2_of_zero {n : ℕ} {ginv : Metric n} {F : TwoForm n} {x : Pt n}
    (hF : ∀ i j, F i j x = 0) (a b : Fin n) : raise2 ginv F a b x = 0 := by
  simp [raise2, hF]

theorem emStress_of_zero {g ginv : Metric 4} {F : TwoForm 4} {x : Pt 4}
    (hF : ∀ i j, F i j x = 0) (a b : Fin 4) : emStress g ginv F a b x = 0 := by
  simp [emStress, fieldSq, raise2_of_zero hF, hF]

/-- With `F = 0` at `x`, the Einstein–Maxwell residual is the Einstein tensor `R_{ab} - (1/2) g_{ab} R`. -/
theorem einsteinMaxwell_of_zero {g ginv : Metric 4} {F : TwoForm 4} {x : Pt 4}
    (hF : ∀ i j, F i j x = 0) (a b : Fin 4) :
    einsteinMaxwell g ginv F a b x = ricciOf g ginv a b x - g a b x * ricciScalar g ginv x / 2 := by
  simp [einsteinMaxwell, emStress_of_zero hF]

