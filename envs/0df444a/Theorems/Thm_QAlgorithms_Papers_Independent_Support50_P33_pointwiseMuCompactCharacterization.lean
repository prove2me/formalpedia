-- title:
--   Pointwise µ-compactness is characterized by ordinary convex-hull monotone continuity
-- statement:
--   Let $E$ be a real Hausdorff locally convex topological vector space, and let $A\subseteq E$ be convex and von Neumann bounded. Assume the relative topology of $A$ is generated by a countable subfamily of the ambient defining seminorms, and that $A$ is complete and separable in the resulting metrizable additive uniformity. The set $A$ is allowed to be empty. All regularity and convergence below are relative to $A$.
--
--   Write $M(A)$ for the Borel probability measures on $A$ with the weak convergence topology. The barycenter $b(\mu)\in A$ is the Pettis integral of inclusion: every continuous real linear functional $\ell$ is integrable against $\mu$, and $\ell(b(\mu))=\int_A\ell(x)\,\mu(dx)$. The set $A$ is $\mu$-compact when the barycenter preimage of every compact subset of $A$ is compact in $M(A)$; it is pointwise $\mu$-compact when every barycenter fiber is compact.
--
--   Write $C_b(A)$ for the bounded continuous real functions on $A$. For an extended-valued cost $f$, let $\operatorname{co}f$ be its greatest convex minorant and $\overline{\operatorname{co}}f$ its greatest lower semicontinuous convex minorant. A finite lower bound means $f(x)\ge c$ for all $x\in A$ for some $c\in\mathbb R$, so positive infinity is permitted but negative infinity is excluded on $A$.
--
--   The set $A$ is pointwise $\mu$-compact if and only if every pointwise nondecreasing sequence $(f_n)$ in $C_b(A)$ whose pointwise limit is a separate function $f_0\in C_b(A)$ satisfies
--   $$
--   \lim_{n\to\infty}\operatorname{co}f_n(x)=\operatorname{co}f_0(x)\qquad(x\in A).
--   $$
--   Each function is individually bounded; no common bound on the whole sequence is added. These are ordinary convex hulls, which are not required to be lower semicontinuous.
--
--   This detects compactness of individual barycenter fibers through continuity of the ordinary convex-hull operation.
-- source:
--   Characterization of convex $μ$-compact sets, arXiv:1004.3792v1, PDF p. 6, Remark 2 continuation: equivalence (i)–(ii)

import Definitions.Def_QAlgorithms_Papers_Independent_Support50_P33

noncomputable section

open Set Filter MeasureTheory TopologicalSpace

open scoped Topology ENNReal

namespace QAlgorithms.Papers.Independent.Support50.P33

open QAlgorithms.Papers.Independent.Frontier18.P10

open QAlgorithms.Papers.Independent.Dependency50.P25

attribute [local instance] QAlgorithms.Papers.Independent.Support50.P33.paperMeasurable

attribute [local instance] QAlgorithms.Papers.Independent.Support50.P33.paperBorel

section LocallyConvexResults

variable {E : Type*} [UniformSpace E] [AddCommGroup E] [Module ℝ E]
    [hgroup : IsUniformAddGroup E] [hsmul : ContinuousSMul ℝ E]
    [hlc : LocallyConvexSpace ℝ E] [hhaus : T2Space E]

include hgroup hsmul hlc hhaus

/-- Remark 2 continuation, arXiv:1004.3792v1, PDF p.6. There are no
bars on the convex hulls in this equivalence. Inputs and the separate
pointwise limit are bounded continuous real functions on A. -/
theorem pointwiseMuCompactCharacterization (A : Set E)
    (hA : GeneralBarycenterSpace A) (hc : Convex ℝ A) :
    PointwiseMuCompact A ↔
      ∀ (f : ℕ → E → ℝ) (fLimit : E → ℝ),
        (∀ n, BoundedContinuousOn A (f n)) → BoundedContinuousOn A fLimit →
        (∀ x ∈ A, Monotone (fun n => f n x)) →
        (∀ x ∈ A, Tendsto (fun n => f n x) atTop (𝓝 (fLimit x))) →
        ∀ x ∈ A, Tendsto
          (fun n => convexHullFunction A (fun y => (f n y : EReal)) x)
          atTop (𝓝 (convexHullFunction A (fun y => (fLimit y : EReal)) x)) := by sorry

end LocallyConvexResults

end QAlgorithms.Papers.Independent.Support50.P33

end
