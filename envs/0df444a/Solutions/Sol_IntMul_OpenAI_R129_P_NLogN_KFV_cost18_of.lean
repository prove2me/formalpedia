theorem sq_le_cube (B : ℕ) : (B + 2) ^ 2 ≤ (B + 2) ^ 3 := by
  have : 1 ≤ B + 2 := by omega
  calc (B + 2) ^ 2 = (B + 2) ^ 2 * 1 := by ring
    _ ≤ (B + 2) ^ 2 * (B + 2) := Nat.mul_le_mul_left _ this
    _ = (B + 2) ^ 3 := by ring

theorem lin_le_cube (B : ℕ) : B + 2 ≤ (B + 2) ^ 3 := by
  have := sq_le_cube B
  have : B + 2 ≤ (B + 2) ^ 2 := by nlinarith
  omega

/-- A move step with its register updates fits `10^5 (W+1) V`. -/
theorem step_le {cm a1 a2 W B n ℓ : ℕ} (hO : OvOK n ℓ B)
    (hm : cm ≤ 29200 * (W + 1) * 2 ^ (n + ℓ) +
      (206 * 10 ^ 7 * (B + 2) ^ 2 + 6 * B + 6 + 8 * KFUU.cU B))
    (h1 : a1 ≤ 201 * 10 ^ 7 * (B + 2) ^ 2) (h2 : a2 ≤ 201 * 10 ^ 7 * (B + 2) ^ 2) :
    cm + (a1 + a2) + 64 ≤ 10 ^ 5 * (W + 1) * 2 ^ (n + ℓ) := by
  unfold OvOK at hO
  have := sq_le_cube B; have := lin_le_cube B
  have hW : 2 ^ (n + ℓ) ≤ (W + 1) * 2 ^ (n + ℓ) := Nat.le_mul_of_pos_left _ (by omega)
  nlinarith

