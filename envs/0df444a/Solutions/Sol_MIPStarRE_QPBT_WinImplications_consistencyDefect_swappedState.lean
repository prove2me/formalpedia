/-! ## Transport of the consistency defect -/

theorem solution {X α ιA ιB : Type*}
    [Fintype X] [DecidableEq X] [Fintype α] [DecidableEq α]
    [Fintype ιA] [DecidableEq ιA] [Fintype ιB] [DecidableEq ιB]
    (μ : _root_.LIDT.MIPStarRE.LDT.Distribution X) (M : X → α → _root_.LIDT.MIPStarRE.Quantum.Op ιA) (N : X → α → _root_.LIDT.MIPStarRE.Quantum.Op ιB)
    (ψ : EuclideanSpace ℂ (ιA × ιB)) :
    _root_.MIPStarRE.QPBT.consistencyDefect μ (fun x a => _root_.MIPStarRE.QPBT.heteroKron (N x a) 1)
        (fun x a => _root_.MIPStarRE.QPBT.heteroKron 1 (M x a))
        (_root_.MIPStarRE.QPBT.reindexState (Equiv.prodComm ιA ιB) ψ) =
      _root_.MIPStarRE.QPBT.consistencyDefect μ (fun x a => _root_.MIPStarRE.QPBT.heteroKron (M x a) 1)
        (fun x a => _root_.MIPStarRE.QPBT.heteroKron 1 (N x a)) ψ := by
  classical
  unfold _root_.MIPStarRE.QPBT.consistencyDefect
  refine _root_.LIDT.MIPStarRE.LDT.avgOver_congr _ _ _ ?_
  intro x
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl ?_
  intro a _
  refine Finset.sum_congr rfl ?_
  intro b _
  by_cases hab : b = a
  · simp [hab]
  · have hba : a ≠ b := fun h => hab h.symm
    simp only [if_neg hab, if_neg hba]
    rw [_root_.MIPStarRE.QPBT.DistanceCalculus.consistency_term_eq_stateQForm,
      _root_.MIPStarRE.QPBT.DistanceCalculus.consistency_term_eq_stateQForm,
      _root_.MIPStarRE.QPBT.WinImplications.stateQForm_reindexState, _root_.MIPStarRE.QPBT.WinImplications.reindexOp_mul,
      _root_.MIPStarRE.QPBT.WinImplications.reindexOp_prodComm_heteroKron, _root_.MIPStarRE.QPBT.WinImplications.reindexOp_prodComm_heteroKron,
      _root_.MIPStarRE.QPBT.WinImplications.heteroKron_left_right_comm]
