  have hl0 : L0.length = lo.length := by simp [L0, hlen]
  let St : List (ℤ × ℤ) → List (ℤ × ℤ) → IState NS := fun D R =>
    ((((((s.upd V (ints (R.map Prod.fst) ++ RV)).upd DX (ints (R.map Prod.snd) ++ RX)).upd P1
      ((ints (bflyT F (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G P1)).upd P2
      ((ints (bflyB F E 0 (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G P2)).upd W
