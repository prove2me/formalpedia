    muHom q ζ = ⟨_, one_mem_hSubgroup_of_mem q ζ⟩ := rfl

private theorem algebraMap_norm (c : (GaloisField q 2)ˣ) :
    algebraMap (ZMod q) (GaloisField q 2) (Algebra.norm (ZMod q) (c : GaloisField q 2)) =
      (c : GaloisField q 2) ^ (q + 1) := by
