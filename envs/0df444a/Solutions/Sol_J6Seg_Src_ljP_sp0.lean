-- Source module: Solutions.J6SegILSrc2
/-!
# B-line IL, source-table producers, part 2: the block structure, recursively

For the streaming computation of `mkBlocks s t λ w` and `LJ = Jlist (mkBlocks …)`:

* `rrZ s t x = (2 t x + s) / (2 s)`; `stepOK_iff`: `stepOK l ↔ rrZ (l+1) = rrZ l + 1` (`s > 0`);
  `cut_iff`: for `j ≥ 1`, `cutP j ↔ j % λ = 0 ∨ rrZ j ≠ rrZ (j-1) + 1`.
* `stF_zero`, `stF_succ` (the forward recursion), `stF_eq_iff` (`stF j = j ↔ cutP j`).
* `eB j = stF j + len j` (the end of the block of `j`): `eB_last` (`= s` at `s - 1`),
  `eB_step` (`eB j = if cutP (j+1) then j+1 else eB (j+1)`), the backward recursion.
* `nearB_eq`: `nearB (mkBlocks …) j ↔ j < stF j + w ∨ eB j < j + w + 1`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.Src

open J6Seg

variable {s t lam : ℕ}

theorem no_cut {i j : ℕ} (h1 : stF s t lam i < j) (h2 : j ≤ i) : ¬ cutP s t lam j :=
  Nat.findGreatest_is_greatest h1 h2

theorem enF_eq {c k : ℕ} (hk : cutP s t lam (c + 1 + k) ∨ s ≤ c + 1 + k)
    (hmin : ∀ k' < k, ¬ cutP s t lam (c + 1 + k') ∧ c + 1 + k' < s) : enF s t lam c = k := by
  unfold enF
  rw [Nat.find_eq_iff]
  refine ⟨hk, fun n hn => ?_⟩
  have := hmin n hn
  push Not
  exact ⟨this.1, this.2⟩

theorem eB_last (hs : 0 < s) : eB s t lam (s - 1) = s := by
  unfold eB
  have hc := stF_le (s := s) (t := t) (lam := lam) (s - 1)
  rw [enF_eq (k := s - 1 - stF s t lam (s - 1)) (Or.inr (by omega))
    (fun k' hk' => ⟨no_cut (i := s - 1) (by omega) (by omega), by omega⟩)]
  omega

end J6Seg.Src

end

