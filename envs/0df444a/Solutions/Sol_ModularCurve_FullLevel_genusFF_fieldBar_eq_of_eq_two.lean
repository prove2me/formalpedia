namespace GenusFieldBarQ2

open AlgebraicCurve ModularCurve ModularCurve.FullLevel

theorem units_zmod_two (u : (ZMod 2)ˣ) : u = 1 := by
  revert u; decide

theorem levelH_two (M' : ℕ) : levelH 2 M' = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro u
  rw [mem_levelH_iff]
  exact units_zmod_two _

scoped instance neZero_sq_mul (M' : ℕ) [NeZero M'] : NeZero (2 ^ 2 * M') :=
  ⟨mul_ne_zero (by norm_num) (NeZero.ne M')⟩

theorem fieldBar_two (M' : ℕ) [NeZero M'] :
    fieldBar 2 M' = modularFunctionFieldBar (2 ^ 2 * M') := by
  show laurentBaseChange (AlgebraicClosure ℚ) (xHFunctionFieldC ℚ (2 ^ 2 * M') (levelH 2 M')) =
    laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionFieldFull (2 ^ 2 * M'))
  rw [levelH_two, xHFunctionFieldC_top, qExpFunctionFieldC_rat_gamma0_eq_modularFunctionFieldFull]

theorem genusFF_modularFunctionFieldBar (N : ℕ) [NeZero N] :
    (genusFF (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar N) : ℚ) = genusFormula N := by
  haveI := hasCanonicalDivisor_modularFunctionFieldBar N
  have h3 := genus_eq_genusFF_modularFunctionFieldBar N
  have h4 := genus_modularFunctionFieldBar_eq_genusFormula N
  rw [← h3]
  exact h4

theorem nuTwo_sq_mul (M' : ℕ) : nuTwo (2 ^ 2 * M') = 0 := by
  have h4 : 4 ∣ 2 ^ 2 * M' := ⟨M', by norm_num⟩
  have key : ∀ y : ZMod 4, y ^ 2 + 1 ≠ 0 := by decide
  unfold nuTwo
  haveI : IsEmpty {x : ZMod (2 ^ 2 * M') // x ^ 2 + 1 = 0} := by
    refine ⟨fun x => ?_⟩
    obtain ⟨x, hx⟩ := x
    have := congrArg (ZMod.castHom h4 (ZMod 4)) hx
    rw [map_add, map_pow, map_one, map_zero] at this
    exact key _ this
  exact Nat.card_of_isEmpty

theorem nuThree_sq_mul (M' : ℕ) : nuThree (2 ^ 2 * M') = 0 := by
  have h4 : 4 ∣ 2 ^ 2 * M' := ⟨M', by norm_num⟩
  have key : ∀ y : ZMod 4, y ^ 2 + y + 1 ≠ 0 := by decide
  unfold nuThree
  haveI : IsEmpty {x : ZMod (2 ^ 2 * M') // x ^ 2 + x + 1 = 0} := by
    refine ⟨fun x => ?_⟩
    obtain ⟨x, hx⟩ := x
    have := congrArg (ZMod.castHom h4 (ZMod 4)) hx
    rw [map_add, map_add, map_pow, map_one, map_zero] at this
    exact key _ this
  exact Nat.card_of_isEmpty

theorem dedekindPsi_sq_mul (M' : ℕ) (hM' : ¬ 2 ∣ M') :
    dedekindPsi (2 ^ 2 * M') = 6 * dedekindPsi M' := by
  have hcop : Nat.Coprime (2 ^ 2) M' :=
    Nat.Coprime.pow_left 2 (Nat.prime_two.coprime_iff_not_dvd.mpr hM')
  rw [dedekindPsi_mul_of_coprime _ _ hcop, dedekindPsi_prime_pow 2 2 Nat.prime_two two_ne_zero]
  norm_num

theorem cuspCount_four : cuspCount (2 ^ 2) = 3 := by
  decide

theorem cuspCount_sq_mul (M' : ℕ) [NeZero M'] (hM' : ¬ 2 ∣ M') :
    cuspCount (2 ^ 2 * M') = 3 * cuspCount M' := by
  have hcop : Nat.Coprime (2 ^ 2) M' :=
    Nat.Coprime.pow_left 2 (Nat.prime_two.coprime_iff_not_dvd.mpr hM')
  rw [cuspCount_mul_of_coprime (by norm_num) (NeZero.ne M') hcop, cuspCount_four]

theorem genusFormula_sq_mul (M' : ℕ) [NeZero M'] (hM' : ¬ 2 ∣ M') :
    genusFormula (2 ^ 2 * M') = 1 + (dedekindPsi M' : ℚ) / 2 - 3 * (cuspCount M' : ℚ) / 2 := by
  unfold genusFormula
  rw [nuTwo_sq_mul, nuThree_sq_mul, dedekindPsi_sq_mul M' hM', cuspCount_sq_mul M' hM']
  push_cast
  ring

end GenusFieldBarQ2
