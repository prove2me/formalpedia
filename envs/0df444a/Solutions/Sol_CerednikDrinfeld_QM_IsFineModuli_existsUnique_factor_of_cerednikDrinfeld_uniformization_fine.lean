    have e1 := ρnat1 C (C' i) hC (hCi i) (IsScalarTower.toAlgHom 𝒪 C (C' i)) x₁
    have e2 := ρnat1 C (C' i) hC (hCi i) (IsScalarTower.toAlgHom 𝒪 C (C' i)) x₂
    change Spec.map (CommRingCat.ofHom (algebraMap C (C' i))) ≫ _ = _ at e1
