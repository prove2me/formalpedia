    ⟨isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30]); simp), by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30]); positivity⟩ (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30])) hA2
    (by simp only [exSm]; (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30])
        exact ⟨absA (by positivity) (by push_cast; omega), by positivity, hpA⟩)
    (powD_lt hA2 hB (by decide))) ?_
  -- 11: 2^(2dα²)
  have eG : (2 : ℤ) * d * (α * α) = ((2 * d * α ^ 2 : ℕ) : ℤ) := by push_cast; ring
  refine Sp.seq (sp_pushS (v := (2 : ℤ) ^ (2 * d * α ^ 2)) (by decide) (clean_of_regs _ (by decide))
    ⟨⟨⟨trivial, isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h25]); simp)⟩, isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h35]); simp),
      isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h35]); simp)⟩, by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h25, h35]); positivity⟩
    (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h25, h35]); rw [eG, Int.toNat_natCast]) hA2
    (by simp only [exSm, Ex.eval]; (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h25, h35])
        rw [eG, Int.toNat_natCast]
        exact ⟨⟨⟨by simp; omega, absA (by positivity) (by push_cast; omega)⟩,
          absA (by positivity) (by push_cast; omega), absA (by positivity) (by push_cast; omega)⟩,
          by positivity, hGA⟩)
    (powD_lt hA2 hB (by decide))) ?_
  -- 12: 2^(p-b'-2)
  have eE : (p : ℤ) + -(b' : ℤ) + -2 = ((p - b' - 2 : ℕ) : ℤ) := by omega
  refine Sp.seq (sp_pushS (v := (2 : ℤ) ^ (p - b' - 2)) (by decide) (clean_of_regs _ (by decide))
    ⟨⟨⟨isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30]); simp), isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h29]); simp)⟩, trivial⟩,
      by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30, h29]); omega⟩
    (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30, h29]); rw [eE, Int.toNat_natCast]) hA2
    (by simp only [exSm, Ex.eval]; (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30, h29])
        rw [eE, Int.toNat_natCast]
        exact ⟨⟨⟨absA (by positivity) (by push_cast; omega), absA (by positivity) (by push_cast; omega)⟩,
          by simp; omega⟩, by positivity, hE2A⟩)
    (powD_lt hA2 hB (by decide))) ?_
  -- 13: 2^b'
  refine Sp.seq (sp_pushS (v := (2 : ℤ) ^ b') (by decide) (clean_of_regs _ (by decide))
    ⟨isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h29]); simp), by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h29]); positivity⟩ (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h29])) hA2
    (by simp only [exSm]; (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h29])
        exact ⟨absA (by positivity) (by push_cast; omega), by positivity, hb'A⟩)
    (powD_lt hA2 hB (by decide))) ?_
  -- 14: 2(S - M)
  refine Sp.seq (sp_pushS (v := 2 * ((S : ℤ) - ((M : ℕ) : ℤ))) (by decide)
    (clean_of_regs _ (by decide))
    ⟨trivial, isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast]); simp), isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast]); simp)⟩ (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast]); ring) hA2
    (by simp only [exSm]; (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast])
        exact ⟨by simp; omega, absA (by positivity) (by push_cast; omega),
          absA (by positivity) (by push_cast; omega)⟩)
    (powD_lt hA2 hB (by decide))) ?_
  -- 15: 2^(p-1)
  have eH : (p : ℤ) + -1 = ((p - 1 : ℕ) : ℤ) := by omega
  refine Sp.seq (sp_pushS (v := (2 : ℤ) ^ (p - 1)) (by decide) (clean_of_regs _ (by decide))
    ⟨⟨isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30]); simp), trivial⟩, by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30]); omega⟩
    (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30]); rw [eH, Int.toNat_natCast]) hA2
    (by simp only [exSm, Ex.eval]; (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30])
        rw [eH, Int.toNat_natCast]
        exact ⟨⟨absA (by positivity) (by push_cast; omega), by simp; omega⟩, by positivity, hHA⟩)
    (powD_lt hA2 hB (by decide))) ?_
  -- 16: 2^(2b'+4)
  have eF : (2 : ℤ) * b' + 4 = ((2 * b' + 4 : ℕ) : ℤ) := by push_cast; ring
  refine Sp.seq (sp_pushS (v := (2 : ℤ) ^ (2 * b' + 4)) (by decide) (clean_of_regs _ (by decide))
    ⟨⟨⟨trivial, isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h29]); simp)⟩, trivial⟩, by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h29]); positivity⟩
    (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h29]); rw [eF, Int.toNat_natCast]) hA2
    (by simp only [exSm, Ex.eval]; (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h29])
        rw [eF, Int.toNat_natCast]
        exact ⟨⟨⟨by simp; omega, absA (by positivity) (by push_cast; omega)⟩, by simp; omega⟩,
          by positivity, hFA⟩)
    (powD_lt hA2 hB (by decide))) ?_
  -- 18: p + 2
  refine Sp.seq (sp_pushS (v := (p : ℤ) + 2) (by decide) (clean_of_regs _ (by decide))
    ⟨isInt_ne (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30]); simp), trivial⟩ (by (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30])) hA2
    (by simp only [exSm]; (simp (disch := decide) only [Ex.eval, top_encK', Function.update_self, Function.update_of_ne, List.headD_cons, Int.toNat_natCast, h30])
        exact ⟨absA (by positivity) (by push_cast; omega), by simp; omega⟩)
    (powD_lt hA2 hB (by decide))) ?_
  -- 19: 1
  refine (sp_push (v := 1) (by decide) (clean_lit 1) trivial rfl
    (by simp only [Ex.Bnd]; exact zszA hA2 hB (absA (by norm_num) (by push_cast; omega)))).congr ?_
  all_goals (congr 1; try (funext r; fin_cases r <;> simp (config := {decide := true}) only [update_apply, ↓reduceIte]))

end

