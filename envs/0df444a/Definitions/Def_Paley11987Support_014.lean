variable {V : Type*} [Fintype V] [DecidableEq V]



def markedWeightedLoad (R : V → V → Prop) (a m : ℕ)
    (w : Finset V → V → ℚ) (x y : V) : ℚ :=
  ∑ M ∈ (Finset.univ : Finset V).powersetCard m,
    ∑ A ∈ (Mᶜ.powersetCard a).filter (fun A => (x,y) ∈ markedSupport R A M),
      ∏ z ∈ A, w M z



end
