open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- **A level frame** on a base assignment with `K`, `r`, `H`. -/
theorem levRH_of6 {σ : Fin HS → Option ℤ} (hb : BaseR σ) {K r H : ℕ} (hK : σ vK = some (K : ℤ))
    (hr : σ vR = some (r : ℤ)) (hH : σ vH = some (H : ℤ)) (c : Cfg) (t S0 E e B : ℕ) :
    LevRH c (σPush σ (lev6 c t S0 E e B)) K t S0 r H E e B := by
  have hb' := hb.push (lev6 c t S0 E e B) (fun p hp => by
    simp only [lev6, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> ((try dsimp only); decide))
  have hnd : ((lev6 c t S0 E e B).map Prod.fst).Nodup := by
    simp only [lev6, List.map_cons, List.map_nil]; decide
  have hne : ∀ i : Fin HS, i ∉ [vT, vS, vk, vE, vB, vX] → σPush σ (lev6 c t S0 E e B) i = σ i :=
    fun i hi => σPush_ne _ σ i (fun p hp e => hi (by
      simp only [lev6, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> (subst e; (try dsimp only); decide)))
  exact ⟨hb'.off, hb'.offp, hb'.lt, by rw [hne _ (by decide)]; exact hK,
    σPush_mem _ σ _ _ hnd (by simp [lev6]), σPush_mem _ σ _ _ hnd (by simp [lev6]),
    by rw [hne _ (by decide)]; exact hr, by rw [hne _ (by decide)]; exact hH,
    σPush_mem _ σ _ _ hnd (by simp [lev6]), σPush_mem _ σ _ _ hnd (by simp [lev6]),
    σPush_mem _ σ _ _ hnd (by simp [lev6]), σPush_mem _ σ _ _ hnd (by simp [lev6])⟩

section Ker

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

/-- **The kernel loop.** -/
theorem kerQ_sol_aux {c : Cfg} (hc : CfgOK c) (jK jL : Fin Pp) (rowC : IStmt HS Pp)
    (hK : tbl jK = kerLoopC jK jL) (hL : tbl jL = levCH c jL rowC)
    {K S r H P D ρ q0 Bp Z Zr G b : ℕ} {CB : ℕ → ℝ}
    (L1 : LvH c Isym tbl jL rowC K r Z Zr H G CB 1) (hρ : ρ < K) (hS : 1 ≤ S) (hP : 1 ≤ P)
    (hb : b ≤ D) (hZ16 : zsz ((16 * (c.Wr * (P * 2 ^ (K * D) * S * r)) : ℕ) : ℤ) ≤ Z)
    (hV : zsz ((VbH c K (K * D) S r H 1 (ρ + K * (D - 1)) P : ℕ) : ℤ) ≤ Zr) (hH1 : 1 ≤ H)
    (Mb Bz : ℕ) (hMb : zsz (Mb : ℤ) ≤ Bz) (hM : K * D + P + D + S + 2 ≤ Mb) :
    ∀ (d i : ℕ) (σ : Fin HS → Option ℤ), CoreR σ K S r H P D ρ 0 q0 Bp → σ vG = some (G : ℤ) →
      σ 11 = some (i : ℤ) → σ 12 = some (b : ℤ) → i + d = b →
      SImplQ Isym tbl (fun s => Agree σ s) 0 H r (fun x : Fin D => KFH.stT K D S ρ x)
        (P * 2 ^ (K * D) * S)
        (tensF fun x : Fin D => if i ≤ x.val ∧ x.val < b then Cm else 1) (.call jK) d
        ((c.Wr + 4) * d)
        (fun _ => d * (⌊CB 1 * ((nN P (K * D) S * Yu r Zr H : ℕ) : ℝ)⌋₊ + cKO Bz) + cKE Bz) := by
  have hsl : SLaws (fun x : Fin D => KFH.stT K D S ρ x) (P * 2 ^ (K * D) * S) := by
    have := slaws_layer (P := P) (D := D) (S := S) hρ
    rwa [← pow_mul] at this
  have hK1 : 1 ≤ K := by omega
  have hm := hc.m1
  have hG1 : c.G 1 = 1 := Gs_lt (by omega)
  intro d
  induction d with
  | zero =>
    intro i σ hC hG hi hbr hid
    simp only [Nat.add_zero] at hid
    subst hid
    have hσ0 : σ 0 = none := hC.base.off 0 (by decide)
    have hv : (NE.lt (.reg 11) (.reg 12) (.lit 0) (.lit 1)).val (vOf σ) = 1 := by
      simp [NE.val, vOf_eq hi, vOf_eq hbr]
    have H0 := sImplQ_test (I := Isym) (iprog := tbl) (lo := 0) (hi := H) (r := r)
      (st := fun x : Fin D => KFH.stT K D S ρ x) (n := P * 2 ^ (K * D) * S) hσ0 16 (by decide)
      (by decide) (.lt (.reg 11) (.reg 12) (.lit 0) (.lit 1)) Mb Bz 12 hMb
      (regsLt_of_all (by decide)) (by decide)
      (fun j hj => by
        simp only [NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false] at hj
        rcases hj with rfl | rfl
        exacts [⟨_, hi⟩, ⟨_, hbr⟩])
      (by simp [NE.OK, NE.val, vOf_eq hi, vOf_eq hbr] <;> omega)
      (T := tensF fun x : Fin D => if i ≤ x.val ∧ x.val < i then Cm else 1)
      (p := .seq (withPushI (fr kerTF) (.call jL))
        (withPushI (fr [(11, .add (.reg 11) (.lit 1))]) (.call jK))) (q := .skip)
      (e := 0) (dw := 0)
      (by
        rw [if_neg (by rw [hv]; norm_num)]
        exact sImplQ_skip _ (by
          rw [← tensF_one]; congr 1; funext x; rw [if_neg (by omega)]))
    refine (((sImplQ_call hK H0).congrC rfl).congrE rfl (by ring)).mono (fun w _ _ => ?_)
    simp only [cKE]; omega
  | succ d IH =>
    intro i σ hC hG hi hbr hid
    have hib : i < b := by omega
    have hσ0 : σ 0 = none := hC.base.off 0 (by decide)
    set cnd : NE := .lt (.reg 11) (.reg 12) (.lit 0) (.lit 1) with hcdef
    have hv : cnd.val (vOf σ) = 0 := by
      simp [hcdef, NE.val, vOf_eq hi, vOf_eq hbr, hib]
    set σ1 := σPush σ [(16, ((cnd.val (vOf σ) : ℕ) : ℤ))] with hσ1
    have hk16 : ∀ p ∈ [((16 : Fin HS), ((cnd.val (vOf σ) : ℕ) : ℤ))], p.1 ∈ KFW.scr := fun p hp => by
      simp only [List.mem_singleton] at hp; subst hp; (try dsimp only); decide
    have hC1 : CoreR σ1 K S r H P D ρ 0 q0 Bp := hC.push _ hk16
    have hG1' : σ1 vG = some (G : ℤ) := by rw [hσ1, σPush_scr_ne hk16 (by decide)]; exact hG
    have hi1 : σ1 11 = some (i : ℤ) := by rw [hσ1, σPush16_ne σ _ (by decide)]; exact hi
    have hb1 : σ1 12 = some (b : ℤ) := by rw [hσ1, σPush16_ne σ _ (by decide)]; exact hbr
    have hσ10 : σ1 0 = none := hC1.base.off 0 (by decide)
    have hnat1 : ∀ j ∈ (11 : Fin HS) :: coreL, ∃ n : ℕ, σ1 j = some (n : ℤ) := by
      intro j hj
      rcases List.mem_cons.1 hj with rfl | hj
      · exact ⟨i, hi1⟩
      · exact hC1.nat j hj
    have hD1 : 1 ≤ D := by omega
    have hKD : K ≤ K * D := Nat.le_mul_of_pos_right _ (by omega)
    have hDK : D ≤ K * D := Nat.le_mul_of_pos_left _ (by omega)
    have hKe : K * (D - 1 - i) + K ≤ K * D := by
      rw [← Nat.mul_succ]; exact Nat.mul_le_mul_left _ (by omega)
    -- the level call on bit `i`
    set e := ρ + K * (D - 1 - i) with he
    have hfr : frV σ1 kerTF = lev6 c (K * D) S 1 e P := by
      simp [frV, kerTF, lev6, NE.val, vOf_eq hC1.hK, vOf_eq hC1.hD, vOf_eq hC1.hρ, vOf_eq hi1,
        vOf_eq hC1.hP, vOf_eq hC1.hS, he, hG1]
    have hLev : LevRH c (σPush σ1 (frV σ1 kerTF)) K (K * D) S r H 1 e P := by
      rw [hfr]; exact levRH_of6 hC1.base hC1.hK hC1.hr hC1.hH c _ _ _ _ _
    have hGL : σPush σ1 (frV σ1 kerTF) vG = some (G : ℤ) := by
      rw [σPush_frV_ne σ1 σ1 kerTF (by decide)]; exact hG1'
    have hem : e % K = ρ := by
      rw [he, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hρ]
    have hVe : VbH c K (K * D) S r H 1 e P ≤ VbH c K (K * D) S r H 1 (ρ + K * (D - 1)) P :=
      VbH_mono c le_rfl (by
        have : K * (D - 1 - i) ≤ K * (D - 1) := Nat.mul_le_mul_left _ (by omega)
        omega) le_rfl
    have h1m : 1 / c.m - 1 = 0 := by have := Nat.div_le_self 1 c.m; omega
    have LV := L1 _ (K * D) S e P hLev hGL hS hP
      (by rw [dep_lt (show 1 < 2 * c.m by omega), h1m]; simp) (by rw [h1m]; simp)
      (by simp) (by rw [hem]; omega) hZ16 (le_trans (zsz_natCast_le hVe) hV) (by rw [hG1]; exact hH1)
    have LVc := sImplQ_call hL LV
    set g : Fin 1 → Fin D := fun _ => ⟨i, by omega⟩ with hg
    have hginj : Function.Injective g := fun a b _ => Fin.ext (by
      have := a.isLt; have := b.isLt; omega)
    have hst : (fun c : Fin 1 => 2 ^ (e - K * c.val) * S) =
        (fun x : Fin D => KFH.stT K D S ρ x) ∘ g := by
      funext c
      have hc : c.val = 0 := by have := c.isLt; omega
      simp only [Function.comp, hg, hc, Nat.mul_zero, Nat.sub_zero]
      rw [show KFH.stT K D S ρ i = 2 ^ (ρ + K * (D - (i + 1))) * S from
        stT_eq (⟨i, by omega⟩ : Fin D)]
      have hDi : D - 1 - i = D - (i + 1) := by omega
      rw [he, hDi]
    rw [hst] at LVc
    have LVs := sImplQ_subOp hginj LVc
    rw [subOp_tens hginj] at LVs
    have hFr : FrOK σ1 Mb 12 kerTF := by
      intro x hx
      simp only [kerTF, List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl | rfl | rfl | rfl | rfl
      all_goals refine ⟨by decide, regsLt_of_all (by decide), by decide, natR_of _ hnat1 (by decide), ?_⟩
      all_goals simp only [NE.OK, NE.val, vOf_eq hC1.hK, vOf_eq hC1.hD, vOf_eq hC1.hρ,
        vOf_eq hi1, vOf_eq hC1.hP, vOf_eq hC1.hS]
      all_goals omega
    have Hlev := sImplQ_fr hσ10 kerTF Mb Bz 12 hMb hFr (noRdN_of_B _ _ (by decide)) (by decide) LVs
    -- the recursive call
    have hfr2 : frV σ1 [((11 : Fin HS), NE.add (.reg 11) (.lit 1))] = [(11, ((i + 1 : ℕ) : ℤ))] := by
      simp [frV, NE.val, vOf_eq hi1]
    set σ2 := σPush σ1 (frV σ1 [((11 : Fin HS), NE.add (.reg 11) (.lit 1))]) with hσ2
    have hk11 : ∀ p ∈ [((11 : Fin HS), ((i + 1 : ℕ) : ℤ))], p.1 ∈ KFW.scr := fun p hp => by
      simp only [List.mem_singleton] at hp; subst hp; (try dsimp only); decide
    have hC2 : CoreR σ2 K S r H P D ρ 0 q0 Bp := by rw [hσ2, hfr2]; exact hC1.push _ hk11
    have hG2 : σ2 vG = some (G : ℤ) := by rw [hσ2, hfr2, σPush_scr_ne hk11 (by decide)]; exact hG1'
    have hi2 : σ2 11 = some ((i + 1 : ℕ) : ℤ) := by rw [hσ2, hfr2]; exact σPush_one _ _ _
    have hb2 : σ2 12 = some (b : ℤ) := by
      rw [hσ2, hfr2, σPush_ne _ _ _ (fun p hp => by
        simp only [List.mem_singleton] at hp; subst hp; (try dsimp only); decide)]; exact hb1
    have R := IH (i + 1) σ2 hC2 hG2 hi2 hb2 (by omega)
    have hFr2 : FrOK σ1 Mb 12 [((11 : Fin HS), NE.add (.reg 11) (.lit 1))] := by
      intro x hx
      simp only [List.mem_singleton] at hx
      subst hx
      refine ⟨by decide, regsLt_of_all (by decide), by decide, natR_of _ hnat1 (by decide), ?_⟩
      simp only [NE.OK, NE.val, vOf_eq hi1]
      omega
    have Hrec := sImplQ_fr hσ10 _ Mb Bz 12 hMb hFr2 (noRdN_of_B _ _ (by decide)) (by decide) R
    have C := Hlev.comp hsl Hrec
    have hTT : (tensF fun x : Fin D => if i + 1 ≤ x.val ∧ x.val < b then Cm else 1) *
        (tensF fun x : Fin D => @ite _ (∃ k, g k = x) Fintype.decidableExistsFintype Cm 1) =
        tensF fun x : Fin D => if i ≤ x.val ∧ x.val < b then Cm else 1 := by
      rw [← tensF_mul]
      congr 1; funext x
      have hex : (∃ k, g k = x) ↔ x.val = i := by
        constructor
        · rintro ⟨k, hk⟩; rw [← hk]
        · intro h; exact ⟨⟨0, by omega⟩, Fin.ext (by rw [h])⟩
      by_cases h1 : x.val = i
      · rw [if_neg (by omega), if_pos (hex.2 h1), if_pos (by omega), one_mul]
      · rw [if_neg (fun h => h1 (hex.1 h)), mul_one]
        by_cases h2 : i + 1 ≤ x.val ∧ x.val < b
        · rw [if_pos h2, if_pos (by omega)]
        · rw [if_neg h2, if_neg (by omega)]
    have C' := (C.congrT hTT).congrE (show c.G 1 + d = d + 1 by rw [hG1]; omega)
      (show (c.Wr + 4) * c.G 1 + (c.Wr + 4) * d = (c.Wr + 4) * (d + 1) by rw [hG1]; ring)
    have H0 := sImplQ_test (I := Isym) (iprog := tbl) (lo := 0) (hi := H) (r := r)
      (st := fun x : Fin D => KFH.stT K D S ρ x) (n := P * 2 ^ (K * D) * S) hσ0 16 (by decide)
      (by decide) cnd Mb Bz 12 hMb (regsLt_of_all (by decide)) (by decide)
      (fun j hj => by
        simp only [hcdef, NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
          or_false] at hj
        rcases hj with rfl | rfl
        exacts [⟨_, hi⟩, ⟨_, hbr⟩])
      (by simp [hcdef, NE.OK, NE.val, vOf_eq hi, vOf_eq hbr] <;> omega)
      (p := .seq (withPushI (fr kerTF) (.call jL))
        (withPushI (fr [(11, .add (.reg 11) (.lit 1))]) (.call jK))) (q := .skip)
      (by rw [if_pos hv]; exact C')
    refine ((sImplQ_call hK H0).congrC rfl).mono (fun w _ _ => ?_)
    simp only [cKO, kerTF, List.length_cons, List.length_nil]
    nlinarith

end Ker

end IntMul.Kappa.R6.IL3H

end

theorem solution : type_of% @IntMul.Kappa.R6.IL3H.kerQ_sol_aux := @IntMul.Kappa.R6.IL3H.kerQ_sol_aux
