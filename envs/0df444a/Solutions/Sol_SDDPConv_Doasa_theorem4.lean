lemma exists_pos_le_finset {ι : Type*} (s : Finset ι) (q : ι → ℝ)
    (hq : ∀ i ∈ s, 0 < q i) : ∃ e : ℝ, 0 < e ∧ ∀ i ∈ s, e ≤ q i := by
  classical
  induction s using Finset.induction_on with
  | empty => exact ⟨1, by norm_num, by simp⟩
  | @insert i s hi ih =>
    obtain ⟨e, he, hs⟩ := ih (fun j hj => hq j (Finset.mem_insert_of_mem hj))
    refine ⟨min (q i) e, lt_min (hq i (Finset.mem_insert_self _ _)) he, ?_⟩
    intro j hj
    rcases Finset.mem_insert.mp hj with rfl | hj
    · exact min_le_left _ _
    · exact (min_le_right _ _).trans (hs j hj)

/-- A direction which does not increase active inequalities admits a positive feasible step. -/
theorem finite_feasible_step {ι E : Type*} [Fintype ι]
    [AddCommGroup E] [Module ℝ E]
    (a : ι → E →ₗ[ℝ] ℝ) (b : ι → ℝ) (x d : E)
    (hx : ∀ i, a i x ≤ b i)
    (hd : ∀ i, a i x = b i → a i d ≤ 0) :
    ∃ e : ℝ, 0 < e ∧ ∀ t : ℝ, 0 ≤ t → t ≤ e → ∀ i, a i (x + t • d) ≤ b i := by
  classical
  let q : ι → ℝ := fun i => if a i x = b i then 1 else
    (b i - a i x) / (|a i d| + 1)
  have hq (i : ι) : 0 < q i := by
    dsimp [q]
    split_ifs with h
    · norm_num
    · exact div_pos (sub_pos.mpr (lt_of_le_of_ne (hx i) h)) (by positivity)
  obtain ⟨e, he, hle⟩ := exists_pos_le_finset Finset.univ q (fun i _ => hq i)
  refine ⟨e, he, ?_⟩
  intro t ht hte i
  rw [map_add, map_smul, smul_eq_mul]
  by_cases h : a i x = b i
  · have hh := mul_nonpos_of_nonneg_of_nonpos ht (hd i h)
    linarith
  · have hti : t ≤ (b i - a i x) / (|a i d| + 1) := by
      simpa [q, h] using hte.trans (hle i (Finset.mem_univ i))
    have hh := (le_div_iff₀ (show 0 < |a i d| + 1 by positivity)).mp hti
    have ha := mul_le_mul_of_nonneg_left (le_abs_self (a i d)) ht
    nlinarith only [hh, ha, ht]

/-- A finite system of linear inequalities has finitely many extreme points. -/
theorem polyhedron_extremePoints_finite {ι E : Type*} [Fintype ι]
    [AddCommGroup E] [Module ℝ E]
    (a : ι → E →ₗ[ℝ] ℝ) (b : ι → ℝ) :
    (Set.extremePoints ℝ {x : E | ∀ i, a i x ≤ b i}).Finite := by
  classical
  let P : Set E := {x | ∀ i, a i x ≤ b i}
  let active : E → Finset ι := fun x => Finset.univ.filter (fun i => a i x = b i)
  apply Set.Finite.of_injOn (f := active) (t := Set.univ) (fun _ _ => Set.mem_univ _) _ (Set.toFinite _)
  intro x hx y _ hxy
  by_contra hne
  have hxP : ∀ i, a i x ≤ b i := hx.1
  have hdir (i : ι) (hi : a i x = b i) : a i (y - x) = 0 := by
    have hm : i ∈ active x := by simp [active, hi]
    rw [hxy] at hm
    have hh : a i y = b i := (Finset.mem_filter.mp hm).2
    simp [map_sub, hi, hh]
  obtain ⟨e₁, he₁, h₁⟩ := finite_feasible_step a b x (y - x) hxP
    (fun i hi => (hdir i hi).le)
  obtain ⟨e₂, he₂, h₂⟩ := finite_feasible_step a b x (-(y - x)) hxP
    (fun i hi => by rw [map_neg, hdir i hi]; norm_num)
  let e := min e₁ e₂
  have he : 0 < e := lt_min he₁ he₂
  have hp : x + e • (y - x) ∈ P := h₁ e he.le (min_le_left _ _)
  have hm : x + e • (-(y - x)) ∈ P := h₂ e he.le (min_le_right _ _)
  have hseg : x ∈ openSegment ℝ (x + e • (y - x)) (x + e • (-(y - x))) := by
    refine ⟨(1 / 2 : ℝ), (1 / 2 : ℝ), by norm_num, by norm_num, by norm_num, ?_⟩
    module
  have hEq := hx.2 hp hm hseg
  have hz : e • (y - x) = 0 := by
    exact add_left_cancel (show x + e • (y - x) = x + 0 by simpa using hEq)
  have hd0 : y - x = 0 := (smul_eq_zero.mp hz).resolve_left (ne_of_gt he)
  exact hne (sub_eq_zero.mp hd0).symm

end DOASAProof

