theorem solution (k : Type) [CommRing k] (m : ℕ) (P Q : Polynomial k)
    (h : P.toLaurent =
      LaurentPolynomial.T (m : ℤ) * LaurentPolynomial.invert (R := k) Q.toLaurent) :
    P.natDegree ≤ m ∧ ∀ i : ℕ, Q.coeff i = if i ≤ m then P.coeff (m - i) else 0 := by
  have key := TypeDensity.toLaurent_coeff_of_eq_T_mul_invert m P Q h
  simp only [TypeDensity.laurent_twist_kernel_coeff_toLaurent] at key
  refine ⟨?_, fun i ↦ ?_⟩
  · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro n hn
    have := key n
    simp only [Nat.cast_nonneg, if_true, Int.toNat_natCast] at this
    rw [this, if_neg]
    have : (m : ℕ) < n := by exact_mod_cast hn
    omega
  · split_ifs with hi
    · have := key ((m - i : ℕ) : ℤ)
      simp only [Nat.cast_nonneg, if_true, Int.toNat_natCast] at this
      rw [this, if_pos (by omega)]
      congr 1; omega
    · have := key ((m : ℤ) - i)
      rw [if_neg (by omega), if_pos (by omega)] at this
      rw [show ((m : ℤ) - ((m : ℤ) - i)).toNat = i by omega] at this
      exact this.symm
