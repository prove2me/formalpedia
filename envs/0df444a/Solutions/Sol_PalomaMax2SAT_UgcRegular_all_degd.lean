        (e * c + 1) * ((e + 2 + 1) * n + m + a) := by
  have h2 : 2 * ((e + 2 + 1) * n + m) = (3 * (e + 2) + 2) * n := by nlinarith [hm]
  have h1 : (3 * (e + 2) + 2) * (2 * a) ≤ (3 * (e + 2) + 2) * n :=
