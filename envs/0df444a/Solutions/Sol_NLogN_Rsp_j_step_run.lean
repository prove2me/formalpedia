theorem solution (p s t α : ℕ) (hs : 0 < s) (u : List (ℤ × ℤ)) (hu : u.length = s)
    (s1 : NLogN.IState NLogN.HS) (RU RA LS LL : List NLogN.Item) (hE : NLogN.Rsp.EParams s1 p s t α)
    (hL : s1.G NLogN.Rsp.JL = .int ((2 * s : ℕ) : ℤ) :: LL) (S0 : NLogN.IState NLogN.HS) (N j : ℕ) :
    NLogN.Rsp.jBody.run (NLogN.withCtr NLogN.Rsp.JC S0 N j (NLogN.Rsp.jSt s1 p s t α u RU RA LS j)) =
      NLogN.withCtr NLogN.Rsp.JC S0 N j (NLogN.Rsp.jSt s1 p s t α u RU RA LS (j + 1)) := by
  generalize ht : NLogN.withCtr NLogN.Rsp.JC S0 N j (NLogN.Rsp.jSt s1 p s t α u RU RA LS j) = τ
  have hvl := NLogN.Rsp.vL_length p s t α u hu j
  have hal := NLogN.Rsp.accL_length p s t α u j
  have tCU : τ.G NLogN.Rsp.CU = NLogN.ints (NLogN.pairInts (NLogN.Rsp.vL p s t α u j)) ++ RU := by
    rw [← ht]; simp (config := {decide := true}) [NLogN.withCtr, NLogN.Rsp.jSt, NLogN.Rsp.gints_eq_ints']
  have tJA : τ.G NLogN.Rsp.JA = NLogN.ints (NLogN.pairInts (NLogN.Rsp.accL p s t α u j)) ++ RA := by
    rw [← ht]; simp (config := {decide := true}) [NLogN.withCtr, NLogN.Rsp.jSt]
  have tJS : τ.G NLogN.Rsp.JS = .int (NLogN.Rsp.sgV (decide (j % 2 = 1))) :: LS := by
    rw [← ht]; simp (config := {decide := true}) [NLogN.withCtr, NLogN.Rsp.jSt]
  have tJL : τ.G NLogN.Rsp.JL = .int ((NLogN.pairInts (NLogN.Rsp.vL p s t α u j)).length : ℤ) :: LL := by
    rw [← ht, NLogN.Rsp.pairInts_length', hvl]; simp (config := {decide := true}) [NLogN.withCtr, NLogN.Rsp.jSt, hL]
  set Lw := NLogN.pairInts (NLogN.Rsp.vL p s t α u j) with hLw
  set La := NLogN.pairInts (NLogN.Rsp.accL p s t α u j) with hLa
  set Z := List.zipWith (NLogN.Rsp.sgF (decide (j % 2 = 1))) La Lw with hZ
  have sm : ∀ (L : List ℤ), ∀ y ∈ L, NLogN.zsz y ≤ (L.map NLogN.zsz).sum := fun L y hy =>
    List.le_sum_of_mem (List.mem_map.2 ⟨y, hy, rfl⟩)
  have hA := NLogN.Rsp.addP_all NLogN.Rsp.dist_J (by decide) (by decide) τ (decide (j % 2 = 1))
    Lw La RU RA LS LL tJS tCU tJA
    (by rw [hLw, hLa, NLogN.Rsp.pairInts_length', NLogN.Rsp.pairInts_length', hvl, hal]) tJL
    (1 + (Lw.map NLogN.zsz).sum + (La.map NLogN.zsz).sum + (Z.map NLogN.zsz).sum + NLogN.zsz (Lw.length : ℤ)) (by omega)
    (fun y hy => le_trans (sm Lw y hy) (by omega)) (fun y hy => le_trans (sm La y hy) (by omega))
    (fun y hy => le_trans (sm Z y hy) (by omega)) (by omega)
  have hacc : Z = NLogN.pairInts (NLogN.Rsp.accL p s t α u (j + 1)) := by
    rw [hZ, NLogN.Rsp.accL_succ p s t α u hu j, NLogN.Rsp.pairInts_zipWith _ _ _ (by rw [hal, hvl])]
  rw [← hZ, hacc] at hA
  set τ1 := τ.upd NLogN.Rsp.JA (NLogN.ints (NLogN.pairInts (NLogN.Rsp.accL p s t α u (j + 1))) ++ RA) with hτ1
  have hE1 : NLogN.Rsp.EParams τ1 p s t α := hE.of_eq (NLogN.Rsp.jSt_eRegs s1 p s t α u RU RA LS j S0 N j τ1 (by
    intro x hx; rw [hτ1, ← ht]
    simp only [NLogN.Rsp.eRegs, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp (config := {decide := true})))
  have hg := NLogN.Rsp.gresP_E_run p s t α τ1 (NLogN.Rsp.vL p s t α u j) RU hs hvl hE1
    (by rw [hτ1]; simp (config := {decide := true}) [tCU, NLogN.Rsp.gints_eq_ints', hLw])
  simp only [NLogN.Rsp.jBody, NLogN.RM.seqL, NLogN.RM.run_seq, NLogN.RM.run_rs, hA.2.1, hg]
  apply NLogN.IState.ext' _ (by rw [hτ1, ← ht]; simp [NLogN.withCtr, NLogN.Rsp.jSt]) (by rw [hτ1, ← ht]; simp [NLogN.withCtr, NLogN.Rsp.jSt])
  intro x
  by_cases x1 : x = NLogN.Rsp.JS
  · rw [x1, hτ1, ← ht]
    simp (config := {decide := true}) [hτ1, NLogN.withCtr, NLogN.Rsp.jSt, NLogN.Ex.eval, NLogN.IState.top, NLogN.Rsp.sgV_neg]
  by_cases x2 : x = NLogN.Rsp.CU
  · rw [x2, hτ1, ← ht]; simp (config := {decide := true}) [hτ1, NLogN.withCtr, NLogN.Rsp.jSt, NLogN.Rsp.vL]
  by_cases x3 : x = NLogN.Rsp.JA
  · rw [x3, hτ1, ← ht]; simp (config := {decide := true}) [hτ1, NLogN.withCtr, NLogN.Rsp.jSt]
