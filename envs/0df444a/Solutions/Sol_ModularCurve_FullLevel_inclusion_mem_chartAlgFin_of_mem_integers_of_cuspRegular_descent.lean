  have hinjB : Function.Injective (algebraMap ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (AlgebraicClosure ℚ)) := (algebraMap ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (AlgebraicClosure ℚ)).injective
  have hej : e (e.symm j₁) = j₁ := e.apply_symm_apply j₁
  have hj : ((e.symm j₁ : ↥(laurentBaseChange ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (xHFunctionField (q ^ 2 * M') (levelH q M')))) : LaurentSeries ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ))) = coeffEmb ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) jq := by
    apply E153C.coeffMap_injective (algebraMap ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (AlgebraicClosure ℚ)) hinjB
    rw [← he, hej, hj₁]
