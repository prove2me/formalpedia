lemma contDiff_divergence {F : Cover → Cover} (hF : ContDiff ℝ (⊤ : ℕ∞) F) :
    ContDiff ℝ (⊤ : ℕ∞) (divergence F) := by
  have hd := hF.fderiv_right (m := (⊤ : ℕ∞)) (by simp)
  unfold divergence
  apply ContDiff.sum
  intro i _
  exact (EuclideanSpace.proj i).contDiff.comp (hd.clm_apply contDiff_const)

