import Mathlib
import Definitions.Def_DiazModulus
import Theorems.Thm_DiazModulus_exists_noncandidate_transcendental_on_circle

open Complex ComplexConjugate

/-! # The field generated by `ℒ̃` is countable, so every circle has a point transcendental over it

`ℒ` is countable: it is the union, over the countably many algebraic numbers `a`, of the fibres
`exp⁻¹ {a}`, and each fibre is a translate of `2πiℤ` (`Complex.exp_eq_exp_iff_exists_int`).
`Q̄` is countable (`Algebraic.countable`). The span `ℒ̃ = span Q̄ (insert 1 ℒ)` is the range of
`Finsupp.linearCombination` on `insert 1 ℒ →₀ Q̄` (`Finsupp.span_eq_range_linearCombination`),
and finitely supported functions from a countable type to a countable type form a countable
type. So `ℒ̃` is countable, and the subfield `F` it generates has cardinality at most
`max #ℒ̃ ℵ₀ = ℵ₀` (`Subfield.cardinalMk_closure_le_max`). The circle point is then the one
`exists_noncandidate_transcendental_on_circle` gives for `K = F`, its third clause dropped. -/

namespace R19_M2

open DiazModulus

/-- Each fibre of `Complex.exp` is countable: two of its points differ by an integer
multiple of `2πi`. -/
theorem countable_exp_preimage (a : ℂ) : (Complex.exp ⁻¹' {a}).Countable := by
  rcases (Complex.exp ⁻¹' {a}).eq_empty_or_nonempty with h | ⟨z0, hz0⟩
  · rw [h]
    exact Set.countable_empty
  · refine (Set.countable_range (fun n : ℤ => z0 + n * (2 * Real.pi * Complex.I))).mono ?_
    intro z hz
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hz hz0
    obtain ⟨n, hn⟩ := Complex.exp_eq_exp_iff_exists_int.mp (hz.trans hz0.symm)
    exact ⟨n, hn.symm⟩

/-- `ℒ` is countable. -/
theorem countable_logAlg : LogAlg.Countable := by
  have hU : (⋃ a ∈ {a : ℂ | IsAlgebraic ℚ a}, Complex.exp ⁻¹' {a}).Countable :=
    (Algebraic.countable ℚ ℂ).biUnion (fun a _ => countable_exp_preimage a)
  refine hU.mono ?_
  intro z hz
  exact Set.mem_biUnion (x := Complex.exp z) hz rfl

/-- `Q̄` is countable. -/
theorem countable_qbar : Countable ↥Qbar := by
  have h : (Qbar : Set ℂ).Countable :=
    (Algebraic.countable ℚ ℂ).mono (fun _ hx => mem_Qbar_iff.mp hx)
  exact h.to_subtype

/-- `ℒ̃` is countable. -/
theorem countable_logAlgTilde : (LogAlgTilde : Set ℂ).Countable := by
  have hs : (insert (1 : ℂ) LogAlg).Countable := countable_logAlg.insert 1
  have : Countable ↥(insert (1 : ℂ) LogAlg) := hs.to_subtype
  have : Countable ↥Qbar := countable_qbar
  rw [LogAlgTilde, Finsupp.span_eq_range_linearCombination, LinearMap.coe_range]
  exact Set.countable_range _

/-- The subfield generated by `ℒ̃` is countable. -/
theorem countable_closure : Countable ↥(Subfield.closure (LogAlgTilde : Set ℂ)) := by
  have hT : Cardinal.mk ↥(LogAlgTilde : Set ℂ) ≤ Cardinal.aleph0 :=
    Cardinal.mk_le_aleph0_iff.mpr countable_logAlgTilde.to_subtype
  have h := (Subfield.cardinalMk_closure_le_max (LogAlgTilde : Set ℂ)).trans
    (max_le hT le_rfl)
  exact Cardinal.mk_le_aleph0_iff.mp h

end R19_M2

open DiazModulus R19_M2 in
theorem solution
    (ρ : ℝ) (hρ : 0 < ρ) :
    Countable ↥(Subfield.closure (LogAlgTilde : Set ℂ)) ∧
      ∃ u : ℂ, u * conj u = (ρ : ℂ) ∧ Transcendental (Subfield.closure (LogAlgTilde : Set ℂ)) u := by
  refine ⟨countable_closure, ?_⟩
  obtain ⟨t, ht, htr, -⟩ :=
    DiazModulus.exists_noncandidate_transcendental_on_circle
      (Subfield.closure (LogAlgTilde : Set ℂ)) countable_closure hρ
  exact ⟨t, ht, htr⟩
