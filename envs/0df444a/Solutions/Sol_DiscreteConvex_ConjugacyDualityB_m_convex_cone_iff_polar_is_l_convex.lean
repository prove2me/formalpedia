    have hpol : ∀ p ∈ P R, ∑ v, (z v : ℝ) * p v ≤ 0 := fun p hp => K_sub_polarP R hz p hp
    have c1 := hpol (fun _ => 1) (by intro i j _; exact le_refl _)
    have c2 := hpol (fun _ => -1) (by intro i j _; exact le_refl _)
    refine ⟨?_, ?_⟩
    · have : (∑ v, (z v : ℝ)) = 0 := by
        simp only [mul_one, mul_neg] at c1 c2
        rw [Finset.sum_neg_distrib] at c2; linarith
      exact_mod_cast this
    · intro S hS
      have := hpol (fun v => if v ∈ S then 1 else 0) (by
        intro i j hij; dsimp only; split_ifs with h1 h2 <;> norm_num
        exact h2 (hS i j hij h1))
      simp only [mul_ite, mul_one, mul_zero, Finset.sum_ite_mem, Finset.univ_inter] at this
      exact_mod_cast this
  · rintro ⟨hsum, hS⟩
    show (fun v => (z v : ℝ)) ∈ K R
    rw [K_eq_polarP]
    intro p hp
    -- reduce to integer points
    have hconv : Convex ℝ {p : V → ℝ | ∑ v, (z v : ℝ) * p v ≤ 0} := by
      intro a ha b hb s t hs ht hst
      simp only [Set.mem_ofPred_eq, Pi.add_apply, Pi.smul_apply, smul_eq_mul] at ha hb ⊢
      have e : ∑ v, (z v : ℝ) * (s * a v + t * b v) =
          s * ∑ v, (z v : ℝ) * a v + t * ∑ v, (z v : ℝ) * b v := by
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl; intro v _; ring
      rw [e]; nlinarith
    have hint : IntPts ∩ P R ⊆ {p : V → ℝ | ∑ v, (z v : ℝ) * p v ≤ 0} := by
      rintro p ⟨hpi, hpP⟩
      choose k hk using hpi
      simp only [Set.mem_ofPred_eq]
      by_cases hV : Nonempty V
      · obtain ⟨m, hm⟩ : ∃ m : ℤ, (∃ v, k v = m) ∧ ∀ v, m ≤ k v := by
          refine ⟨univ.inf' (Finset.univ_nonempty) k, ?_, fun v => Finset.inf'_le _ (mem_univ v)⟩
          obtain ⟨v, _, hv⟩ := Finset.exists_mem_eq_inf' (Finset.univ_nonempty (α := V)) k
          exact ⟨v, hv.symm⟩
        let q : V → ℕ := fun v => (k v - m).toNat
