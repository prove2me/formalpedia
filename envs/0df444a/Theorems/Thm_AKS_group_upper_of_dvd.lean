-- status  : Proved
-- author  : @Shuze Chen
-- created : 2026-10-21T15:52:46.538405+00:00
-- url     : https://prove2.me/theorems/bf23e93e-59b7-43dc-92ed-b0d29f6d865d
-- title:
--   The Kalai-Sahai-Sudan collision bound for the group (Lemma 4.8)
-- statement:
--   This is Lemma 4.8 of Agrawal, Kayal and Saxena, *PRIMES is in P* (the upper bound on the size of the group $\mathcal{G}$, with the proof attributed to Kalai, Sahai and Sudan), stated with the standing assumption of Section 4 that $p$ is a prime factor of $n$.
--
--   Let $n \ge 1$ and let $p$ be a prime dividing $n$ such that $n$ is not a power of $p$. Let $r \ge 1$ with $\gcd(n/p, r) = \gcd(p, r) = 1$, and let $h \in \mathbb{F}_p[X]$ be an irreducible factor of $X^r - 1$, so that $F = \mathbb{F}_p[X]/(h)$ is a finite field. Let $\ell \ge 0$ and let $P$ be the multiplicative monoid generated by $X, X+1, \dots, X+\ell$ in $\mathbb{F}_p[X]$. Let
--
--   $$
--   I = \{(n/p)^i p^j : i, j \ge 0\}, \qquad G = \{\, m \bmod r : m \in I \,\} \subseteq (\mathbb{Z}/r\mathbb{Z})^{\times}, \qquad t = |G| ,
--   $$
--
--   and assume that every $m \in I$ is introspective for every $f \in P$, that is, $f(X)^m \equiv f(X^m) \pmod{X^r - 1,\, p}$. Then there are two numbers $m_2 < m_1 \le n^{\lfloor \sqrt{t} \rfloor}$ such that every element of $\mathcal{G}$, the image of $P$ in $F$, is a root of $Y^{m_1} - Y^{m_2}$:
--
--   $$
--   \exists\, m_1, m_2 \in \mathbb{N},\quad m_2 < m_1 \le n^{\lfloor \sqrt t \rfloor} \;\wedge\; \forall f \in P:\; f(\alpha)^{m_1} = f(\alpha)^{m_2} \quad\text{in } F = \mathbb{F}_p[X]/(h),
--   $$
--
--   where $\alpha$ is the class of $X$ in $F$.
--
--   Since a nonzero polynomial of degree $m_1$ over the field $F$ has at most $m_1$ roots, this collision yields the bound $|\mathcal{G}| \le n^{\sqrt t}$ of the paper, which combined with the lower bound of Lemma 4.7 forces $n$ to be a prime power whenever the algorithm accepts; it is the step that makes the AKS test correct.
--
--   **Formalization Note** The set $P$ is the predicate `inP p ℓ`, introspection is `introspective p r f m`, $I$ is `inI n p`, and $G$ is realised as the finite set `Gfin n p r` of residues $(n/p)^i p^j \bmod r$ with witnesses $i, j < r$, which exhausts $G$ under the coprimality hypotheses. The field $F$ is `AdjoinRoot h` and $\lfloor \sqrt t \rfloor$ is `Nat.sqrt t`. This theorem replaces `AKS.group_upper`, which omitted the hypotheses $p \mid n$ and $0 < n$ and was false without them (for instance $n = 3$, $p = 2$, $r = 7$, $\ell = 0$); nothing else changes.
-- source:
--   M. Agrawal, N. Kayal, N. Saxena, PRIMES is in P, Ann. of Math. 160 (2004) 781-793, Section 4 (Lemma 4.8, proof by Kalai, Sahai, and Sudan).

import Mathlib
import Definitions.Def_AKS_poly
import Definitions.Def_AKS_alg

namespace AKS

/-!  Lemma 4.8 of the paper (Kalai, Sahai, and Sudan): if n is not a power
of p, the group G-cal lies in the roots of Y^(m_1) - Y^(m_2) for two
colliding elements m_2 < m_1 of the bounded set I-hat.  This statement replaces `AKS.group_upper`, which omitted the paper's
standing assumption that `p` is a prime factor of `n`; the hypotheses
`p ∣ n` and `0 < n` are added and nothing else changes.
-/
theorem group_upper_of_dvd (n p r t ℓ : ℕ) [Fact (Nat.Prime p)]
    (hpn : p ∣ n) (hn : 0 < n)
    (h : Polynomial (ZMod p)) [Fact (Irreducible h)]
    (hdiv : h ∣ (Polynomial.X ^ r - 1 : Polynomial (ZMod p)))
    (hintros : ∀ m, inI n p m → ∀ f, inP p ℓ f → introspective p r f m)
    (hnpow : ¬ ∃ k, 0 < k ∧ n = p ^ k)
    (ht : t = (Gfin n p r).card)
    (hcop : Nat.gcd (n / p) r = 1 ∧ Nat.gcd p r = 1) :
    ∃ m₁ m₂ : ℕ, m₂ < m₁ ∧ m₁ ≤ n ^ (Nat.sqrt t) ∧
      ∀ f, inP p ℓ f →
        Polynomial.aeval (AdjoinRoot.root h) f ^ m₁
          = Polynomial.aeval (AdjoinRoot.root h) f ^ m₂ := by sorry

end AKS
