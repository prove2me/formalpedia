    hD hDQ hpoinc ajQ hajQε hajQ kQ hkQ₁ hkQ₂ ajbar hajbar hajbar_over εbar hεbar hεbar_aj O.pts hpts_law O.pts_galois hAJ A hA ρ hρ
    W c hgood m hdeg Dg hDx
  rw [hσA, ← hDgx]
  exact hE

