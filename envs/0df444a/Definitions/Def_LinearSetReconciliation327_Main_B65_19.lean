theorem rootSeedProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (P : Program) (E : RAMEnv)
    (pc Q0 Q1 src cap t : ℕ) (σ : F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootSeedProcedure pc))
    (hmeta : (107 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W) (ht : 1 ≤ t) (hcap : 1 ≤ cap)
    (hQ0 : 128 ≤ Q0) (hQ1 : Q1 < 2 ^ E.W) (hsrc : 128 ≤ src)
    (hQword : Q0 + t * cap ≤ 2 ^ E.W) (hSword : src + cap ≤ 2 ^ E.W)
    (hdisj : src + cap ≤ Q0 ∨ Q0 + t * cap ≤ src) (hdeg : σ.natDegree < cap)
    (hf : PolynomialStored b m src cap σ) (hm75 : m 75 = src) (hm83 : m 83 = Q0)
    (hm107 : m 107 = Q1) (hm81 : m 81 = cap) :
    Sem P E pc (pc + 317) (boundaryState pc m)
      (fun k z => k ≤ 29 * cap + 275 ∧ ∃ m', z = boundaryState (pc + 317) m' ∧
        FrontierStored b m' Q0 cap (keepFactor σ) ∧ m' 83 = Q0 ∧ m' 84 = Q1 ∧ m' 89 = (keepFactor σ).length ∧
        MemoryFrame (rootSeedWritable Q0 cap t) m m') := by
  have hmul : cap ≤ t * cap := by simpa only [Nat.one_mul] using Nat.mul_le_mul_right cap ht
  have hQ0Word : Q0 < 2 ^ E.W := by omega
  have hSrcWord : src < 2 ^ E.W := by omega
  let m1 := Function.update m 97 src
  let m2 := Function.update m1 84 Q0
  let m3 := Function.update m2 90 0
  have hf03 : MemoryFrame (rootSeedWritable Q0 cap t) m m3 :=
    MemoryFrame.trans
      (MemoryFrame.trans (MemoryFrame.update_allowed _ m 97 src (by left; dsimp [rootSeedMeta]; omega))
        (MemoryFrame.update_allowed _ _ 84 Q0 (by left; dsimp [rootSeedMeta]; omega)))
      (MemoryFrame.update_allowed _ _ 90 0 (by left; dsimp [rootSeedMeta]; omega))
  obtain ⟨hCopySourceAt, hRest1⟩ := At.seqStmt hAt
  obtain ⟨hCopyBaseAt, hRest2⟩ := At.seqStmt hRest1
  obtain ⟨hZeroAt, hRest3⟩ := At.seqStmt hRest2
  obtain ⟨hKeepAt, hRest4⟩ := At.seqStmt hRest3
  obtain ⟨hCountAt, hRestoreAt⟩ := At.seqStmt hRest4
  have hCopySource : Sem P E pc (pc + 22) (boundaryState pc m)
      (fun k z => k ≤ 22 ∧ z = boundaryState (pc + 22) m1) :=
    Sem.boundary_block P E _ (copyMetaCode 75 97) m m1 hCopySourceAt
      (by simp [copyMetaCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (copyMeta_spec E _ 75 97 src (by omega) (by omega) hSrcWord hm75)
  have hCopyBase : Sem P E (pc + 22) (pc + 44) (boundaryState (pc + 22) m1)
      (fun k z => k ≤ 22 ∧ z = boundaryState (pc + 44) m2) :=
    Sem.boundary_block P E _ (copyMetaCode 83 84) m1 m2 hCopyBaseAt
      (by simp [copyMetaCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (copyMeta_spec E _ 83 84 Q0 (by omega) (by omega) hQ0Word (by simpa [boundaryState, m1] using hm83))
  have hZero : Sem P E (pc + 44) (pc + 64) (boundaryState (pc + 44) m2)
      (fun k z => k ≤ 20 ∧ z = boundaryState (pc + 64) m3) :=
    Sem.boundary_block P E _ (setMetaCode 90 0) m2 m3 hZeroAt
      (by simp [setMetaCode, metaStoreCode, zeroRegsCode]) (setMeta_spec E _ 90 0 (by omega) (by omega))
  have hfactor3 := ((hf.meta_update hsrc 97 src (by norm_num)).meta_update hsrc 84 Q0 (by norm_num)).meta_update hsrc 90 0 (by norm_num)
  have hKeep := queueKeepProcedure_spec b P E (pc + 64) Q0 src cap t [] σ m3 hKeepAt
    (by omega) hwe hcap hQ0 hsrc hQword hSword (by intro _; simp only [List.length_nil]; omega) hdisj
    (by intro j hj; simp at hj) hfactor3 hdeg (by simp [m3, m2]) (by simp [m3])
    (by simpa [m3, m2, m1] using hm81) (by simp [m3, m2, m1])
  obtain ⟨_, k4, z4, hRun4, hPc4, hCost4, hRegs4, hCount4, hQueue4, hf34raw⟩ := hKeep
  let m4 := z4.mem
  have hz4 : z4 = boundaryState (pc + 273) m4 := by
    apply ramState_eq_of
    · exact hPc4
    · rfl
    · intro r; exact congrFun hRegs4 r
  have hf34 : MemoryFrame (rootSeedWritable Q0 cap t) m3 m4 := hf34raw.mono (by
    intro addr ha
    have hh := queue_keep_writable_le_whole Q0 t cap 0 σ.natDegree addr (by intro _; omega) ha
    dsimp [wholeQueueWritable] at hh
    dsimp [rootSeedWritable, rootSeedMeta]
    omega)
  have hf04 := MemoryFrame.trans hf03 hf34
  have hfixed4 (slot : ℕ) (hs : slot < 128) (hn : ¬ rootSeedMeta slot) : m4 slot = m slot :=
    hf04 slot (root_seed_meta_readonly Q0 cap t slot hQ0 hs hn)
  have hcountWord : (keepFactor σ).length < 2 ^ E.W := by
    have hh : (keepFactor σ).length ≤ 1 := by by_cases h : σ.natDegree = 0 <;> simp [keepFactor, h]
    omega
  let m5 := Function.update m4 89 (keepFactor σ).length
  let m6 := Function.update m5 84 Q1
  have hCount : Sem P E (pc + 273) (pc + 295) (boundaryState (pc + 273) m4)
      (fun k z => k ≤ 22 ∧ z = boundaryState (pc + 295) m5) :=
    Sem.boundary_block P E _ (copyMetaCode 90 89) m4 m5 hCountAt
      (by simp [copyMetaCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (copyMeta_spec E _ 90 89 (keepFactor σ).length (by omega) (by omega) hcountWord (by simpa [boundaryState, m4] using hCount4))
  have hRestore : Sem P E (pc + 295) (pc + 317) (boundaryState (pc + 295) m5)
