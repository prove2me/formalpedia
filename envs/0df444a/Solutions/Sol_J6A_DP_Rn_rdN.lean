  have r2 := Rn.rdK (W := W) (X := X) (dst := 2) (c := c) hXr hX5 hXT hXC
    (by decide) (by decide) hc (j := 2) (by simp [J6A.PA.dL]) b1 hL (by omega) (by simp [rIx])
  apply Rn.seq r2; intro v2 h2; subst h2
  have b2 := BV_upd (BV_upd b1 (i := rIx) (a := ((2 : ℕ) : ℤ)) (small_le8 hW (by norm_num)))
    (i := 2) (a := ((J6A.PA.dL k pre post s t p α d)[2]'(by simp [J6A.PA.dL])))
    (by have := hL _ (List.getElem_mem (l := J6A.PA.dL k pre post s t p α d) (by simp [J6A.PA.dL]) (n := 2)); exact this.le)
  have r4 := Rn.rdK (W := W) (X := X) (dst := 4) (c := c) hXr hX5 hXT hXC
    (by decide) (by decide) hc (j := 4) (by simp [J6A.PA.dL]) b2 hL (by omega)
    (by simp [rIx, Function.update_apply, Fin.ext_iff, HS] <;> positivity)
