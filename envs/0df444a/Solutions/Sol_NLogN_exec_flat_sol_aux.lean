namespace NLogN.Steps
variable {S : ℕ} {I : List NLogN.Sym} {code : ℕ → NLogN.Instr S}
lemma one {c c' : NLogN.Cfg S} (h : NLogN.fstep I code c = some c') : NLogN.Steps I code c 1 c' :=
  NLogN.Steps.step h (.refl _)
lemma trans {c c' c'' : NLogN.Cfg S} {m n : ℕ}
    (h : NLogN.Steps I code c m c') (g : NLogN.Steps I code c' n c'') :
    NLogN.Steps I code c (m+n) c'' := by
  induction h with
  | refl _ => simpa using g
  | step hh ht ih => simpa [Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using NLogN.Steps.step hh (ih g)
end NLogN.Steps
