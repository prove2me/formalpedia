-- title:
--   §2, §5, §C.3–C.4, pp. 4–5, 18–20, 39–42 — instances, solutions, quota compliance, house monotonicity, the LP (1)-(4), ℰ, A, 𝒜, S_k, k⋆, τ, Φ, ℒ, 𝒰
-- statement:
--   This file fixes the objects of the network-flow characterization of house-monotone and quota-compliant apportionments.
--
--   **Instances (§2, p. 4).** An instance is a pair $(p,H)$ with $p=(p_1,\dots,p_n)$ a vector of $n\ge 1$ strictly positive integers (the *populations* of the $n$ *states*) and $H$ a positive integer (the *house size*). Write $P=\sum_{i=1}^n p_i$ and $q_i=\frac{p_i}{P}H$ for the *quota* of state $i$.
--
--   **Solutions and axioms (§2, pp. 4–5; §5, p. 18).** A *solution* $f$ assigns to every instance $(p,H)$, of every length $n$, one vector $f(p,H)\in\mathbb N_0^n$ with $\sum_i f_i(p,H)=H$. It is *quota-compliant* if $f_i(p,H)\in\{\lfloor q_i\rfloor,\lceil q_i\rceil\}$ for every instance and state, and *house-monotone* if $f(p,H_1)\le f(p,H_2)\le f(p,H_3)$ (componentwise) whenever $H_1<H_2<H_3$. The set of apportionments generated by such solutions is
--   $$\mathcal A(p,H)=\{f(p,H): f \text{ a house-monotone and quota-compliant solution}\}.$$
--
--   **The linear program (1)-(4) (§5, p. 19).** For $L$ seats, $K(p,L)$ is the set of $x=(x(i,t))_{i\in[n],t\in[L]}$ with
--   $$\sum_{i=1}^n x(i,t)=1,\qquad \Big\lfloor \tfrac{t p_i}{P}\Big\rfloor\le\sum_{\ell=1}^t x(i,\ell)\le\Big\lceil \tfrac{t p_i}{P}\Big\rceil,\qquad x(i,t)\ge 0$$
--   for all $i\in[n]$, $t\in[L]$. $\mathcal E(p,L)$ is the set of extreme points of $K(p,L)$, and $A_i(x,T)=\sum_{\ell=1}^{T}x(i,\ell)$ (with $A(x,0)=0$) counts the seats of state $i$ among the first $T$.
--
--   **Lookahead (§5, p. 20).** For a vector $y$ and $k\ge1$, $S_k(p,H,y)=\{i:\lfloor p_i(H+k)/P\rfloor>y_i\}$; $k^\star(p,H,y)$ is the least $k\ge1$ with $\sum_{i\in S_k(p,H,y)}(\lfloor p_i(H+k)/P\rfloor-y_i)\ge k$; $\tau(p,H,y)=k^\star(p,H,y)$ unless $S_{k^\star}(p,H,y)=[n]$, in which case $\tau(p,H,y)=1$. Then $\Phi(p,0)=0$, $\Phi(p,1)=\min\{k\ge1:\sum_i\lfloor p_ik/P\rfloor\ge k\}$ and, for $H\ge1$,
--   $$\Phi(p,H+1)=\max_{T\in[H]}\Big\{T+\max\{\tau(p,T,A(x,T)) : x\in\mathcal E(p,\Phi(p,H))\}\Big\}.$$
--
--   **The Balinski–Young sets (§C.4, p. 42).** $\mathcal L(p,H,y)=\{i:\lfloor \frac{p_i}{P}(H+k^\star(p,H,y))\rfloor>y_i\}$ and $\mathcal U(p,H,y)=\{i:\frac{p_i}{P}(H+1)>y_i\}$. A solution is extended to house size $0$ by $f(p,0)=0$.
--
--   **Constraint matrix (§C.3, pp. 39–40).** The integer matrix with rows $e_{i,t}$, $-e_{i,t}$, $e'_t$, $-e'_t$ ($i\in[n]$, $t\in[L]$) over the coordinates $x(j,\ell)$, where $(e_{i,t})_{(j,\ell)}=1$ iff $j=i$ and $\ell\le t$, and $(e'_t)_{(j,\ell)}=1$ iff $\ell=t$.
--
--   These objects are shared by every statement of the mission.
--
--   **Formalization Note.** Populations are `p : Fin n → ℕ` with `IsPop p` ($n>0$, every $p_i>0$). A solution is one Lean function on vectors of every length (`Solution`), so $\mathcal A(p,H)$ quantifies over families, as in the paper. Seats are 0-indexed: column `t : Fin L` is seat $t+1$, so (2)–(3) at column $t$ use $t+1$. Floors and ceilings are `Nat.floor`/`Nat.ceil` of the nonnegative rational quantity computed in $\mathbb R$. The minima and maxima defining $k^\star$ and $\Phi$ are `sInf`/`sSup` on $\mathbb N$; their sets are nonempty (and the maximized set finite, since $\mathcal E$ is finite) wherever the paper uses them. $S$, $k^\star$, $\tau$, $\mathcal L$, $\mathcal U$ take a real vector $y$, so that both integer apportionments and $A(x,T)$ can be fed in; $\mathcal U$ keeps the paper's strict rational inequality.
-- source:
--   Cembrano, Correa, Schmidt-Kraepelin, Tsigonias-Dimitriadis & Verdugo, New Combinatorial Insights for Monotone Apportionment, arXiv:2410.23869v1, §2, pp. 4–5; §5, pp. 18–20; §C.3, pp. 39–40; §C.4, p. 42

import Mathlib

namespace MonoApport.Flow

/-!
Cembrano, Correa, Schmidt-Kraepelin, Tsigonias-Dimitriadis & Verdugo, *New Combinatorial Insights
for Monotone Apportionment*, arXiv:2410.23869v1: instances, solutions, quota compliance and house
monotonicity (§2, pp. 4–5; §5, p. 18), the linear program (1)-(4), `ℰ`, `A` and `𝒜` (§5, p. 19),
the lookahead `S_k`, `k⋆`, `τ`, `Φ` (§5, p. 20), and `ℒ`, `𝒰`, `K` (§C.4, p. 42).

Seats are 0-indexed: a point of the LP with `L` seats is `x : Fin n → Fin L → ℝ`, and column
`t : Fin L` is seat `t + 1`.
-/

open Finset

/-- `p ∈ ℕⁿ` with `n` a positive integer: a population vector with `n ≥ 1` states, each of
strictly positive population (§2, p. 4; `ℕ` there is the set of positive integers). -/
def IsPop {n : ℕ} (p : Fin n → ℕ) : Prop := 0 < n ∧ ∀ i, 0 < p i

/-- The total population `P = ∑ᵢ pᵢ`. -/
def totalPop {n : ℕ} (p : Fin n → ℕ) : ℕ := ∑ i, p i

/-- The quota `qᵢ = (pᵢ / P) H` of state `i` (§2, p. 4). -/
noncomputable def quota {n : ℕ} (p : Fin n → ℕ) (H : ℕ) (i : Fin n) : ℝ :=
  (p i : ℝ) * H / totalPop p

/-- A single-valued apportionment method, given on every instance of every size `n`
(a *solution*, §5, p. 18: `|f(p, H)| = 1`, written `f(p, H) = x`). Values off the instances
(`n = 0`, a zero population, `H = 0`) play no role. -/
abbrev Solution := ∀ {n : ℕ}, (Fin n → ℕ) → ℕ → (Fin n → ℕ)

/-- The method requirement `∑ᵢ xᵢ = H` for every instance `(p, H) ∈ ℕⁿ × ℕ` (§2, p. 4). -/
def IsSolution (f : Solution) : Prop :=
  ∀ (n : ℕ) (p : Fin n → ℕ) (H : ℕ), IsPop p → 0 < H → ∑ i, f p H i = H

/-- Axiom (a), quota compliance (§2, pp. 4–5): `xᵢ ∈ {⌊qᵢ⌋, ⌈qᵢ⌉}` for every instance and state. -/
def QuotaCompliant (f : Solution) : Prop :=
  ∀ (n : ℕ) (p : Fin n → ℕ) (H : ℕ), IsPop p → 0 < H → ∀ i,
    f p H i = ⌊quota p H i⌋₊ ∨ f p H i = ⌈quota p H i⌉₊

/-- Axiom (c), house monotonicity (§2, p. 5), for a single-valued method: for all house sizes
`H₁ < H₂ < H₃`, `f(p, H₁) ≤ f(p, H₂) ≤ f(p, H₃)` componentwise. -/
def HouseMonotone (f : Solution) : Prop :=
  ∀ (n : ℕ) (p : Fin n → ℕ), IsPop p → ∀ H₁ H₂ H₃ : ℕ, 0 < H₁ → H₁ < H₂ → H₂ < H₃ →
    f p H₁ ≤ f p H₂ ∧ f p H₂ ≤ f p H₃

/-- `𝒜(p, H) = {f(p, H) : f is a house-monotone and quota-compliant solution}` (§5, p. 19). -/
def calA {n : ℕ} (p : Fin n → ℕ) (H : ℕ) : Set (Fin n → ℕ) :=
  {y | ∃ f : Solution, IsSolution f ∧ HouseMonotone f ∧ QuotaCompliant f ∧ f p H = y}

/-- The feasible region `K(p, L)` of the linear program (1)-(4) with `L` seats (§5, p. 19;
§C.4, p. 42). Column `t` is seat `t + 1`:
(1) `∑ᵢ x(i, t) = 1`; (2) `∑_{ℓ ≤ t} x(i, ℓ) ≥ ⌊(t + 1) pᵢ / P⌋`;
(3) `∑_{ℓ ≤ t} x(i, ℓ) ≤ ⌈(t + 1) pᵢ / P⌉`; (4) `x(i, t) ≥ 0`. -/
def K {n : ℕ} (p : Fin n → ℕ) (L : ℕ) : Set (Fin n → Fin L → ℝ) :=
  {x | (∀ t : Fin L, ∑ i, x i t = 1) ∧
    (∀ (i : Fin n) (t : Fin L), (⌊((t : ℕ) + 1 : ℝ) * p i / totalPop p⌋₊ : ℝ) ≤
      ∑ ℓ ∈ univ.filter (· ≤ t), x i ℓ) ∧
    (∀ (i : Fin n) (t : Fin L), ∑ ℓ ∈ univ.filter (· ≤ t), x i ℓ ≤
      (⌈((t : ℕ) + 1 : ℝ) * p i / totalPop p⌉₊ : ℝ)) ∧
    (∀ (i : Fin n) (t : Fin L), 0 ≤ x i t)}

/-- `ℰ(p, L)`, the set of extreme points of the feasible region of (1)-(4) (§5, p. 19). -/
def calE {n : ℕ} (p : Fin n → ℕ) (L : ℕ) : Set (Fin n → Fin L → ℝ) :=
  Set.extremePoints ℝ (K p L)

/-- `A(x, T)`: `Aᵢ(x, T) = ∑_{ℓ = 1}^{T} x(i, ℓ)`, the seats of state `i` among the first `T`
seats (§5, p. 19); `A(x, 0) = 0`. Only existing columns are summed. -/
def A {n L : ℕ} (x : Fin n → Fin L → ℝ) (T : ℕ) : Fin n → ℝ :=
  fun i => ∑ ℓ ∈ univ.filter (fun ℓ : Fin L => ℓ.val < T), x i ℓ

/-- `⌊pᵢ (H + k) / P⌋`. -/
noncomputable def lq {n : ℕ} (p : Fin n → ℕ) (H k : ℕ) (i : Fin n) : ℕ :=
  ⌊(p i : ℝ) * ((H : ℝ) + k) / totalPop p⌋₊

/-- `S_k(p, H, y) = {i ∈ [n] : ⌊pᵢ (H + k) / P⌋ > yᵢ}` (§5, p. 20). -/
noncomputable def S {n : ℕ} (p : Fin n → ℕ) (H : ℕ) (y : Fin n → ℝ) (k : ℕ) : Finset (Fin n) :=
  univ.filter fun i => y i < lq p H k i

/-- `k⋆(p, H, y)`, the minimum integer `k ≥ 1` with
`∑_{i ∈ S_k(p, H, y)} (⌊pᵢ (H + k) / P⌋ − yᵢ) ≥ k` (§5, p. 20). -/
noncomputable def kStar {n : ℕ} (p : Fin n → ℕ) (H : ℕ) (y : Fin n → ℝ) : ℕ :=
  sInf {k : ℕ | 1 ≤ k ∧ (k : ℝ) ≤ ∑ i ∈ S p H y k, ((lq p H k i : ℝ) - y i)}

/-- `τ(p, H, y) = k⋆(p, H, y)` if `S_{k⋆}(p, H, y) ≠ [n]`, and `1` otherwise (§5, p. 20). -/
noncomputable def tau {n : ℕ} (p : Fin n → ℕ) (H : ℕ) (y : Fin n → ℝ) : ℕ :=
  if S p H y (kStar p H y) = univ then 1 else kStar p H y

/-- The lookahead `Φ(p, ·)` (§5, p. 20): `Φ(p, 0) = 0`,
`Φ(p, 1) = min {k ∈ ℕ : ∑ᵢ ⌊pᵢ k / P⌋ ≥ k}`, and for every `H ≥ 1`,
`Φ(p, H + 1) = max_{T ∈ [H]} {T + max {τ(p, T, A(x, T)) : x ∈ ℰ(p, Φ(p, H))}}`. -/
noncomputable def Phi {n : ℕ} (p : Fin n → ℕ) : ℕ → ℕ
  | 0 => 0
  | 1 => sInf {k : ℕ | 1 ≤ k ∧ k ≤ ∑ i, ⌊(p i : ℝ) * k / totalPop p⌋₊}
  | H + 2 => sSup {v : ℕ | ∃ T : ℕ, 1 ≤ T ∧ T ≤ H + 1 ∧
      ∃ x ∈ calE p (Phi p (H + 1)), v = T + tau p T (A x T)}

/-- `ℒ(p, H, y) = {i ∈ [n] : ⌊(pᵢ / P)(H + k⋆(p, H, y))⌋ > yᵢ}` (§C.4, p. 42). -/
noncomputable def calL {n : ℕ} (p : Fin n → ℕ) (H : ℕ) (y : Fin n → ℝ) : Finset (Fin n) :=
  univ.filter fun i => y i < lq p H (kStar p H y) i

/-- `𝒰(p, H, y) = {i ∈ [n] : (pᵢ / P)(H + 1) > yᵢ}` (§C.4, p. 42). -/
noncomputable def calU {n : ℕ} (p : Fin n → ℕ) (H : ℕ) (y : Fin n → ℝ) : Finset (Fin n) :=
  univ.filter fun i => y i < (p i : ℝ) * ((H : ℝ) + 1) / totalPop p

/-- A solution extended by the convention `f(p, 0) = 0` of §C.4, p. 42. -/
def ext (f : Solution) {n : ℕ} (p : Fin n → ℕ) (H : ℕ) : Fin n → ℕ :=
  if H = 0 then 0 else f p H

/-- The constraint matrix of (1)-(4) written as in the proof of Lemma 3 (§C.3, p. 39–40), with
`L` seats: rows `e_{i,t}`, `−e_{i,t}`, `e′_t`, `−e′_t` for `i ∈ [n]`, `t ∈ [L]`, and columns the
coordinates `x(j, ℓ)`; `(e_{i,t})_{(j,ℓ)} = 1` iff `j = i` and `ℓ ≤ t`, and `(e′_t)_{(j,ℓ)} = 1`
iff `ℓ = t`. -/
def constraintMatrix (n L : ℕ) :
    Matrix ((Fin n × Fin L) ⊕ (Fin n × Fin L) ⊕ Fin L ⊕ Fin L) (Fin n × Fin L) ℤ :=
  fun r c =>
    match r with
    | Sum.inl it => if c.1 = it.1 ∧ c.2 ≤ it.2 then 1 else 0
    | Sum.inr (Sum.inl it) => if c.1 = it.1 ∧ c.2 ≤ it.2 then -1 else 0
    | Sum.inr (Sum.inr (Sum.inl t)) => if c.2 = t then 1 else 0
    | Sum.inr (Sum.inr (Sum.inr t)) => if c.2 = t then -1 else 0

end MonoApport.Flow


