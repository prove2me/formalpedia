    (k : ℕ) (p : Fin 2 → ℤ) (u : CutRing) (h : B.TangentChartLaws k p u)
    (d : Fin 2) (z : CutRing × CutRing) (s t : TrackStar (Fin (m+1))) :
    Commute (B.tangentSign hlarge k p u h d z true s)
