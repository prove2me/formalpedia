    pow_le_pow_left₀ (Real.rpow_nonneg (by linarith) _) (b_rpow_le_two_ell P hG) _
  have : (bP6 n : ℝ) ≤ ((2 * ℓP6 P n) ^ mExp P : ℕ) := by push_cast; linarith
  exact_mod_cast this

