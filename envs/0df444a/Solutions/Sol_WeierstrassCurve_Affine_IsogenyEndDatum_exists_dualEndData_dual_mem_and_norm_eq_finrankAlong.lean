theorem mmr73_cs_geomMorph_ne_zero (D : IsogenyEndDatum W) (Q : W.Point)
    (hx : D.ι (polyToFunctionField W X) ∈ (placeOfPoint Q).toValuationSubring) :
    D.geomMorph Q ≠ 0 := by
