set_option autoImplicit true
namespace StableVotingDistortion.PaperMiddle
open Set
noncomputable section

private theorem rank_lt {a b : Knot} (h : a.position < b.position) : rank a < rank b :=
  div_lt_div_of_pos_right (by exact_mod_cast h) (by norm_num)

private theorem interpolate_left (col : Knot → ℕ) {a b : Knot} (h : rank a < rank b) :
    interpolate col a b (rank a)=value col a := by simp [interpolate_eq _ _ _ _ h ⟨le_rfl,h.le⟩]
private theorem interpolate_right (col : Knot → ℕ) {a b : Knot} (h : rank a < rank b) :
    interpolate col a b (rank b)=value col b := by
  rw [interpolate_eq _ _ _ _ h ⟨h.le,le_rfl⟩];field_simp [sub_ne_zero.mpr h.ne'];ring

private theorem first_le_cell (a : Knot) (xs : List Knot) (k l : Knot)
    (ho : (a::xs).IsChain (fun x y=>x.position<y.position)) (hm : (k,l)∈(a::xs).zip xs) :
    a.position ≤ k.position := by
  induction xs generalizing a with
  | nil => simp at hm
  | cons b ys ih =>
    rcases List.mem_cons.mp hm with he|hm
    · cases he; exact le_rfl
    · exact ho.rel.le.trans (ih b ho.tail hm)

private theorem lookup_on_cell (col : Knot → ℕ) (k l : Knot) (p : ℝ) (hp : p∈Icc (rank k) (rank l))
    (xs : List Knot) (a : Knot) (ho : (a::xs).IsChain (fun x y=>x.position<y.position))
    (hm : (k,l)∈(a::xs).zip xs) : lookup col p a xs=interpolate col k l p := by
  induction xs generalizing a with
  | nil => simp at hm
  | cons b ys ih =>
    rcases List.mem_cons.mp hm with he|hm
    · cases he
      simp only [lookup,if_pos hp.2]
    · have hbl := first_le_cell b ys k l ho.tail hm
      have hbk : rank b ≤ rank k := div_le_div_of_nonneg_right (by exact_mod_cast hbl) (by norm_num)
      have hbp : rank b ≤ p := hbk.trans hp.1
      by_cases hb : p ≤ rank b
      · have eq := le_antisymm hb hbp
        have ek : b=k := by
          cases ys with
          | nil => simp at hm
          | cons c zs =>
            rcases List.mem_cons.mp hm with he|hm
            · exact (congrArg Prod.fst he).symm
            · have hh := (rank_lt ho.tail.rel).trans_le
                (div_le_div_of_nonneg_right (by exact_mod_cast first_le_cell c zs k l ho.tail.tail hm) (by norm_num) : rank c ≤ rank k)
              exact False.elim (hh.not_ge (hp.1.trans hb))
        subst k
        have hsl : rank b < rank l := by
          cases ys with
          | nil => simp at hm
          | cons c zs =>
            rcases List.mem_cons.mp hm with he|hm
            · cases he; exact rank_lt ho.tail.rel
            · exact False.elim (ho.tail.rel.not_ge (first_le_cell c zs b l ho.tail.tail hm))
        rw [lookup,if_pos hb,eq,interpolate_right _ (rank_lt ho.rel),interpolate_left _ hsl]
      · simpa only [lookup,if_neg hb] using ih b ho.tail hm

theorem entry_on_adjacent (col : Knot → ℕ) {k l : Knot} (hm : (k,l)∈adjacentCells)
    {p : ℝ} (hp : p∈Icc (rank k) (rank l)) : entry col p=interpolate col k l p := by
  have h : knots.IsChain (fun x y=>x.position<y.position) := (List.isChain_map Knot.position).mp knot_order
  have eq : knots.head!::knots.tail=knots := by rfl
  exact lookup_on_cell col k l p hp knots.tail knots.head! (by rw [eq];exact h) (by rw [eq];exact hm)

end
end StableVotingDistortion.PaperMiddle
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperMiddle
open Set PaperBox PaperBox.Bounds
noncomputable section

def physicalRectTest (b : Box 3) : Bool := physicalAccept (b 0) (b 1) (b 2)

theorem physicalCover_sound (tree : Cover 3) (b c d : Bounds)
    (ok : tree.verify physicalRectTest ![b,c,d]=true)
    {p q z : ℝ} (hp : b.Holds p) (hq : c.Holds q) (hz : d.Holds z) (hqp : q ≤ p) (hpz : p ≤ z)
    (base : physicalResidual p q 1 ≤ 0) : physicalResidual p q z ≤ 0 := by
  have h := cover_sound (P:=fun t => t 1 ≤ t 0 → t 0 ≤ t 2 → physicalResidual (t 0) (t 1) 1 ≤ 0 →
    physicalResidual (t 0) (t 1) (t 2) ≤ 0) (ok:=physicalRectTest)
    (fun _ yes _ hx a b' c' => physicalAccept_sound (hx 0) (hx 1) (hx 2) a b' c' yes) tree ![b,c,d] ok
  exact h ![p,q,z] (by intro i;fin_cases i <;> first | exact hp | exact hq | exact hz) hqp hpz base

theorem cell_of_tree (k l : Knot) (T : Cover 3)
    (ok : T.verify physicalRectTest ![⟨qRank k,qRank l⟩,⟨0,min (qRank l) PaperCurve.lamQ⟩,
      ⟨max (qRank k) PaperCurve.lamQ,1⟩]=true) : CellCovered k l := by
  intro p q z hp hq hz base
  have h := physicalCover_sound _ _ _ _ ok (p:=p) (q:=q) (z:=z)
  apply h _ _ _ (hq.2.trans (min_le_left _ _)) ((le_max_left _ _).trans hz.1) base
  · simpa [Holds,qRank_cast] using hp
  · simp only [Holds,Rat.cast_min,Rat.cast_zero,qRank_cast]
    exact ⟨hq.1,hq.2.trans (min_le_min_right _ hp.2)⟩
  · simp only [Holds,Rat.cast_max,Rat.cast_one,qRank_cast]
    exact ⟨(max_le_max_right _ hp.1).trans hz.1,hz.2⟩

theorem all_physical_of_cells (all : ∀ cd∈adjacentCells,CellCovered cd.1 cd.2)
    {p q z : ℝ} (hp : p∈Icc pA pC) (hq : q∈Icc 0 (min p PaperCurve.lam))
    (hz : z∈Icc (max p PaperCurve.lam) 1) (base : physicalResidual p q 1 ≤ 0) :
    physicalResidual p q z ≤ 0 := by
  obtain ⟨k,l,hm,_,hd,_⟩ := lp_cell hp
  exact all (k,l) hm p q z hd hq hz base

end
end StableVotingDistortion.PaperMiddle
