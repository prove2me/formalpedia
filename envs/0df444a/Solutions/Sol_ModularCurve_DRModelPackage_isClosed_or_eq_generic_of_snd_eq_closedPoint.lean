theorem solution
    (p : ℕ) [Fact p.Prime] (𝔛 : DRModelPackage p)
    (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (hϖ : IsLocalRing.maximalIdeal O = Ideal.span {((p : ℕ) : O)})
    (k : Type) [Field k] [CharP k p] [IsAlgClosed k] (toκ : O →+* k)
    (y : ↥(pullback (DRModel.toBase p) (Spec.map (CommRingCat.ofHom (algebraMap ℤ O)))))
    (hy : (pullback.snd (DRModel.toBase p) (Spec.map (CommRingCat.ofHom (algebraMap ℤ O)))).base y = IsLocalRing.closedPoint O) :
    IsClosed ({y} : Set ↥(pullback (DRModel.toBase p) (Spec.map (CommRingCat.ofHom (algebraMap ℤ O))))) ∨
      y = (𝔛.compInf k ≫ DRModel.baseChangeMap toκ).base (genericPoint ↥(𝔛.ratModel k).C) ∨
      y = (𝔛.compZero k ≫ DRModel.baseChangeMap toκ).base (genericPoint ↥(𝔛.ratModel k).C) := by

  have hpm : ((p : ℕ) : O) ∈ IsLocalRing.maximalIdeal O := by
    rw [hϖ]; exact Ideal.mem_span_singleton_self _
  have hy' : y ∉ (pullback.snd (DRModel.toBase p) (Spec.map (CommRingCat.ofHom (algebraMap ℤ O)))) ⁻¹ᵁ (PrimeSpectrum.basicOpen ((p : ℕ) : O) : (Spec (CommRingCat.of O)).Opens) := by
    intro h
    change (pullback.snd (DRModel.toBase p) (Spec.map (CommRingCat.ofHom (algebraMap ℤ O)))).base y ∈ PrimeSpectrum.basicOpen ((p : ℕ) : O) at h
    rw [hy] at h
    exact (PrimeSpectrum.mem_basicOpen _ _).mp h hpm
  have hdim : ∀ z : ↥(pullback (DRModel.toBase p) (Spec.map (CommRingCat.ofHom (algebraMap ℤ O)))), y ⤳ z → ringKrullDim ((pullback (DRModel.toBase p) (Spec.map (CommRingCat.ofHom (algebraMap ℤ O)))).presheaf.stalk z) ≤ 2 :=
    fun z _ => ModularCurve.DRModelPackage.ringKrullDim_stalk_pullback_toBase_le_two p 𝔛 O z
  obtain ⟨hd₁, hd₂⟩ :=
    ModularCurve.DRModelPackage.ringKrullDim_stalk_baseChangeMap_genericPoint_eq_one p 𝔛 O hϖ k toκ
  rcases ModularCurve.DRModelPackage.baseChangeMap_genericPoint_specializes_or p 𝔛 O hϖ k toκ y hy' with h | h
  · by_cases he : y = (𝔛.compInf k ≫ DRModel.baseChangeMap toκ).base (genericPoint ↥(𝔛.ratModel k).C)
    · exact Or.inr (Or.inl he)
    · left
      obtain ⟨w, hw, hw'⟩ :=
        AlgebraicGeometry.Scheme.exists_specializes_ne_of_one_le_ringKrullDim _ (le_of_eq hd₁.symm)
      exact AlgebraicGeometry.Scheme.isClosed_singleton_of_specializes_of_ringKrullDim_le_two
        hw hw' h (Ne.symm he) hdim
  · by_cases he : y = (𝔛.compZero k ≫ DRModel.baseChangeMap toκ).base (genericPoint ↥(𝔛.ratModel k).C)
    · exact Or.inr (Or.inr he)
    · left
      obtain ⟨w, hw, hw'⟩ :=
        AlgebraicGeometry.Scheme.exists_specializes_ne_of_one_le_ringKrullDim _ (le_of_eq hd₂.symm)
      exact AlgebraicGeometry.Scheme.isClosed_singleton_of_specializes_of_ringKrullDim_le_two
        hw hw' h (Ne.symm he) hdim

end S_ModularCurve_DRModelPackage_isClosed_or_eq_generic_of_snd_eq_closedPoint
