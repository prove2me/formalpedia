              omega
            · exact h
          have hm'lt : m' < n := by
            have h2 : 2 * m' ≤ P.p * m' := Nat.mul_le_mul_right m' hp.two_le
            omega
          obtain ⟨t', u, hu, hpu⟩ := ih m' hm'lt hm'pos
          refine ⟨t' + 1, u, ?_, hpu⟩
          rw [hm', hu, pow_succ]
          ring
        · exact ⟨0, n, by rw [pow_zero, one_mul], hdvd⟩
    obtain ⟨t, u, hNsplit, hpu⟩ := hsplit N₀ hN₀pos
    have htlt : t < N₀ := by
      have h1 : P.p ^ t ∣ N₀ := Dvd.intro u hNsplit.symm
      have h2 : P.p ^ t ≤ N₀ := Nat.le_of_dvd hN₀pos h1
      have h3 : P.p ^ t < P.p ^ N₀ := lt_of_le_of_lt h2 hN₀lt
      exact (Nat.pow_lt_pow_iff_right hp.one_lt).mp h3

    obtain ⟨y, hy1, hy2⟩ := tw_psmul_surj P.p hp t (hcard (t + 1)) (hcard t) (hcard 1) e hpe
    have hyN : P.p ^ N₀ • y = 0 := by
      obtain ⟨d, hd⟩ : ∃ d, N₀ = (t + 1) + d := ⟨N₀ - (t + 1), by omega⟩
      rw [hd, pow_add, mul_nsmul, hy1, nsmul_zero]
    have hNyK : (N₀ : ℤ) • y ∈ K := hN₀K y hyN

    have hNue : (N₀ : ℤ) • y = u • e := by
      rw [natCast_zsmul, hNsplit, mul_nsmul, hy2]
    have hueK : u • e ∈ K := hNue ▸ hNyK
    have hpue : P.p • (u • e) = 0 := by
      rw [← mul_nsmul, mul_comm, mul_nsmul, hpe, nsmul_zero]
    have hueNA : u • e ∈ NA := hKdown _ hueK hpue

    have hcop : Nat.gcd u P.p = 1 := Nat.Coprime.gcd_eq_one
      ((Nat.Prime.coprime_iff_not_dvd hp).mpr hpu).symm
    have hbez := Nat.gcd_eq_gcd_ab u P.p
    rw [hcop] at hbez
    have he : e = (Nat.gcdA u P.p) • ((u : ℤ) • e) + (Nat.gcdB u P.p) • ((P.p : ℤ) • e) := by
      calc e = (1 : ℤ) • e := (one_smul ℤ e).symm
        _ = ((u : ℤ) * Nat.gcdA u P.p + (P.p : ℤ) * Nat.gcdB u P.p) • e := by
            rw [← hbez]; norm_num
        _ = (Nat.gcdA u P.p) • ((u : ℤ) • e) + (Nat.gcdB u P.p) • ((P.p : ℤ) • e) := by
            rw [mul_comm (u : ℤ), mul_comm (P.p : ℤ), add_zsmul, mul_zsmul, mul_zsmul]
    rw [he]
    have h1 : (u : ℤ) • e ∈ NA := by
      rw [natCast_zsmul]
      exact hueNA
    have h2 : (P.p : ℤ) • e = 0 := by
      rw [natCast_zsmul]
      exact hpe
    refine AddSubgroup.add_mem NA (AddSubgroup.zsmul_mem NA h1 _) ?_
    rw [h2, zsmul_zero]
    exact NA.zero_mem

  haveI : Finite ↥(Submodule.torsionBy ℤ
      ((P.freyCurveInt.map (Int.castRingHom ℚ))⁄(AlgebraicClosure ℚ)).Point ((P.p : ℕ) : ℤ)) :=
    Nat.finite_of_card_ne_zero (hcard1 ▸ pow_ne_zero _ hp.pos.ne')
  haveI : Finite ↥NA := Nat.finite_of_card_ne_zero (hNAcard ▸ hp.pos.ne')
  have hmapE : ∀ s : ↥(Submodule.torsionBy ℤ
      ((P.freyCurveInt.map (Int.castRingHom ℚ))⁄(AlgebraicClosure ℚ)).Point ((P.p : ℕ) : ℤ)),
      ((s : _) : ((P.freyCurveInt.map (Int.castRingHom ℚ))⁄(AlgebraicClosure ℚ)).Point) ∈ NA :=
    by
    intro s
    exact hEpNA _ ((tw_mem_tor P.p _).mp s.2)
  have hinj2 : Function.Injective (fun s : ↥(Submodule.torsionBy ℤ
      ((P.freyCurveInt.map (Int.castRingHom ℚ))⁄(AlgebraicClosure ℚ)).Point ((P.p : ℕ) : ℤ)) =>
      (⟨(s : _), hmapE s⟩ : ↥NA)) := by
    intro a b hab
    have hab' : (⟨(a : _), hmapE a⟩ : ↥NA) = ⟨(b : _), hmapE b⟩ := hab
    have hv : ((a : _) : ((P.freyCurveInt.map
        (Int.castRingHom ℚ))⁄(AlgebraicClosure ℚ)).Point) = ((b : _)) :=
      congrArg (fun z : ↥NA => (z : ((P.freyCurveInt.map
        (Int.castRingHom ℚ))⁄(AlgebraicClosure ℚ)).Point)) hab'
    exact Subtype.ext hv
  have hle2 : P.p ^ 2 ≤ P.p := by
    calc P.p ^ 2 = Nat.card ↥(Submodule.torsionBy ℤ
          ((P.freyCurveInt.map (Int.castRingHom ℚ))⁄(AlgebraicClosure ℚ)).Point
          ((P.p : ℕ) : ℤ)) := hcard1.symm
      _ ≤ Nat.card ↥NA := Nat.card_le_card_of_injective _ hinj2
      _ = P.p := hNAcard
  have hple1 : P.p ≤ 1 := by
    rw [pow_two] at hle2
    exact Nat.le_of_mul_le_mul_left (by omega) hp.pos
  have := hp.two_le
  omega

