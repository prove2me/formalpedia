-- title:
--   Structural Classification of Subterms of `r = nf(t F₁ ... Fₖ α)`
-- statement:
--   In any β-normal term `r` of type `0 → 0` whose free variables lie in `{F₁, ..., Fₖ : ν} ∪ {α : 0 → 0}`, every subterm has type `0`, `0 → 0`, or `ν`; the only subterms of type `ν` are the variables `Fᵢ`; and every subterm of type `0 → 0` belongs to the inductive grammar `IsType00Subterm` (clauses (1)-(3), p. 114).
-- source:
--   Helmut Schwichtenberg, 'Definierbare Funktionen im λ-Kalkül mit Typen', Archiv für mathematische Logik und Grundlagenforschung 17, 1975/1976, pp. 113-114 (doi:10.1007/BF02011242). p. 114, lines 3-13.

import Definitions.Def_Schwichtenberg1976_Lambda

namespace Schwichtenberg1976

/-- Structural classification of subterms of a β-normal term `r` of type `0 → 0`
whose free variables are contained in `F₁, ..., Fₖ` (of type `ν`) and `α` (of type `0 → 0`)
(p. 114, lines 3–13):
1. Every well-typed subterm `s` of `r` has type `0`, `0 → 0`, or `ν`.
2. Every subterm `s` of `r` of type `ν` is one of the variables `Fᵢ ∈ Fs`.
3. Every subterm `s` of `r` of type `0 → 0` is generated by clauses (1)–(3)
   (`IsType00Subterm Fs α s`). -/
theorem normal_subterm_structure
    (Fs : List Var) (α : Var) (r : Term)
    (hFs : ∀ F ∈ Fs, F.ty = Ty.nu)
    (hα : α.ty = Ty.endo)
    (hr_ty : HasType r Ty.endo)
    (hr_norm : IsBetaNormal r)
    (hr_fv : ∀ v ∈ freeVars r, v ∈ Fs ∨ v = α) :
    (∀ s τ, IsSubterm s r → HasType s τ → τ = .zero ∨ τ = Ty.endo ∨ τ = Ty.nu) ∧
    (∀ s, IsSubterm s r → HasType s Ty.nu → ∃ F ∈ Fs, s = .var F) ∧
    (∀ s, IsSubterm s r → HasType s Ty.endo → IsType00Subterm Fs α s) := by
  sorry

end Schwichtenberg1976
