      · have huval : ((Units.map (A.subtype : ↥A →+* AlgebraicClosure ℚ).toMonoidHom hζunit.unit : (AlgebraicClosure ℚ)ˣ) :
            AlgebraicClosure ℚ) = ζ.val := by
          rw [Units.coe_map, IsUnit.unit_spec]; rfl
        obtain ⟨k, hk⟩ := ModularCurve.FullLevel.exists_coe_levelAutBar_apply_eq_qTwist_of_not_dvd_of_mem_laurentBaseChange_gamma0
          q M' hqM' ζ γ hγ hdvd _ huval
        have hτJ := hk _ hjmem Jf hJfcoe
        refine ⟨qTwist (hζunit.unit ^ k) (jqModC ↥A) - HahnSeries.C ⟨(c : AlgebraicClosure ℚ), hcA⟩, ?_, ?_⟩
        · have htw : coeffMap A.subtype (qTwist (hζunit.unit ^ k) (jqModC ↥A)) =
              qTwist ((Units.map (A.subtype : ↥A →+* AlgebraicClosure ℚ).toMonoidHom hζunit.unit) ^ k) (coeffEmb (AlgebraicClosure ℚ) jq) := by
            rw [← hmapA]; ext n
            rw [coeffMap_coeff, qTwist_coeff, qTwist_coeff, coeffMap_coeff, map_mul, ← map_zpow, ← map_zpow, Units.coe_map]
            rfl
          rw [map_sub, htw, cmC, AddSubgroupClass.coe_sub, hτJ, hcC]; rfl
        · intro h0
          have h1 := congrArg (fun z : LaurentSeries (ResidueField ↥A) => z.coeff (-1)) h0
          have htw' : coeffMap (IsLocalRing.residue ↥A) (qTwist (hζunit.unit ^ k) (jqModC ↥A)) =
              qTwist ((Units.map (IsLocalRing.residue ↥A).toMonoidHom hζunit.unit) ^ k) (jqModC (ResidueField ↥A)) := by
            rw [← map_jqModC (IsLocalRing.residue ↥A)]; ext n
            rw [coeffMap_coeff, qTwist_coeff, qTwist_coeff, map_mul, ← map_zpow, ← map_zpow, Units.coe_map]
            rfl
          simp only [map_sub, HahnSeries.coeff_sub, HahnSeries.coeff_zero, htw', cmC, qTwist_coeff, coeff_jqModC_neg_one,
            mul_one] at h1
          rw [HahnSeries.C_apply, HahnSeries.coeff_single_of_ne (show (-1 : ℤ) ≠ 0 by omega), sub_zero] at h1
          exact (Units.ne_zero _) h1
    obtain ⟨T, hTmap, hTres⟩ := hT

    have hT0 : coeffMap A.subtype T ≠ 0 := by
      intro h0; apply hTres
      have hT' : T = 0 := by
        ext n
        have hn := congrArg (fun z : LaurentSeries (AlgebraicClosure ℚ) => z.coeff n) h0
        simp only [coeffMap_coeff, HahnSeries.coeff_zero] at hn
