-- title:
--   Lemma 5.5 — continuous semi-Markov controls approximate relaxed ones in law and in value
-- statement:
--   Work in the setting of §5.5: Assumption A holds; $(\alpha^n)$ is a sequence of admissible profiles with solutions of (5.1); along a subsequence the flows $\mu^{n_k}$ converge in law to a flow $\mu$, defined on a probability space carrying $X$ and $W$ that satisfy (i)–(v) of Theorem 5.4 for a semi-Markov $\Lambda^*$, together with (5.8). For a $\mathcal P(A)$-valued semi-Markov $\Lambda$ let $X[\Lambda]$ be the solution of
--   $$dX_t[\Lambda]=\int_Ab(t,X_t[\Lambda],\mu_t,a)\,\Lambda(t,X_t[\Lambda],\mu)(da)\,dt+dW_t,\qquad X_0[\Lambda]=X_0, \tag{5.10}$$
--   and $J(\Lambda)=\mathbb E\big[\int_0^T\int_Af(t,X_t[\Lambda],\mu_t,a)\Lambda(t,X_t[\Lambda],\mu)(da)dt+g(X_T[\Lambda],\mu_T)\big]$.
--
--   Then for every $\Lambda\in\mathcal R_{\rm semi}$ there is a sequence $\beta^n\in\mathcal A^c_{\rm semi}$ of continuous $A$-valued semi-Markov functions such that
--   $$(\mu,X[\beta^n])\to(\mu,X[\Lambda])\ \text{in law},\qquad J(\beta^n)\to J(\Lambda).$$
--
--   It reduces the supremum of $J$ over relaxed semi-Markov controls to continuous strict ones, (5.12).
--
--   **Formalization Note** The paper prints "$(\mu,X[\Lambda^n])$ converges in law in to $(\mu,X[\Lambda])$"; $X[\Lambda^n]$ is a slip for $X[\beta^n]$, and we state it so. $X[\cdot]$ ranges over the solutions of (5.10) in the sense of Remark 2.6 (adapted to the completed filtration generated by $(X_0,W,\mu)$, $X_0[\Lambda]=X_0$ a.s.); "$J(\Lambda)=v$" reads "every such solution has reward $v$", which is the paper's $J$ because the solution is unique (Lemma A.2). $\beta^n$ acts through the embedding $a\mapsto\delta_a$, so $J(\beta^n)$ is the strict reward. Convergence in law is stated as convergence of $\mathbb E[h(\mu,X[\beta^n])]$ for every bounded continuous $h$ on $C([0,T];\mathcal P(\mathbb R^d))\times\mathcal C^d$. Continuity of $\beta^n$ is on $[0,T]\times\mathbb R^d\times C([0,T];\mathcal P(\mathbb R^d))$.
-- source:
--   Lacker, On the convergence of closed-loop Nash equilibria to the mean field game limit, arXiv:1808.02745v1, p. 31, Lemma 5.5 (context: §5.5, p. 30, (5.10))

import Mathlib
import Definitions.Def_ClosedLoopMFG_Limit_Model
import Definitions.Def_ClosedLoopMFG_Limit_Game
import Definitions.Def_ClosedLoopMFG_Limit_Equilibrium
import Definitions.Def_ClosedLoopMFG_Limit_Relaxed

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace ClosedLoopMFG.Limit

/-- **Lemma 5.5** (p. 31), in the standing context of §5.5. For every `P(A)`-valued semi-Markov
`Λ` there are continuous `A`-valued semi-Markov `βⁿ` such that, for the solutions `X[βⁿ]`,
`X[Λ]` of (5.10), `(μ, X[βⁿ]) → (μ, X[Λ])` in law and `J(βⁿ) → J(Λ)`. -/
theorem lemma_5_5 {d : ℕ} {T : ℝ≥0} (hT : 0 < T) {EA : Type} [NormedAddCommGroup EA]
    [NormedSpace ℝ EA] [MeasurableSpace EA] [BorelSpace EA] (A : Set EA) (lam : PR d)
    (b : ℝ → E d → PR d → EA → E d) (f : ℝ → E d → PR d → EA → ℝ) (g : E d → PR d → ℝ)
    (hA : AssumptionA T A b f g)
    (α : (n : ℕ) → Fin (n + 1) → ℝ → (Fin (n + 1) → Path d T) → EA)
    (hα : ∀ n i, IsAdmissible A (α n i))
    (S : (n : ℕ) → NSol (n + 1) d T lam (drift b (α n))) (φ : ℕ → ℕ)
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) (W : ℝ≥0 → Ω → E d) (X : Ω → Path d T)
    (μ : Ω → Flow d T) (Λstar : ℝ → E d → Flow d T → PA A)
    (hctx : IsSec55Context lam b f g α S φ P W X μ Λstar)
    (Λ : ℝ → E d → Flow d T → PA A) (hΛ : IsSemiMarkov Λ) :
    ∃ β : ℕ → ℝ → E d → Flow d T → EA, (∀ n, IsContSemiMarkovCtrl A (β n)) ∧
      ∀ Xβ : ℕ → Ω → Path d T,
        (∀ n, IsGenSol P W (fun ω => ev (X ω) 0) μ (strictDrift b (β n)) (Xβ n)) →
        ∀ XΛ : Ω → Path d T, IsGenSol P W (fun ω => ev (X ω) 0) μ (relaxDrift b Λ) XΛ →
          (∀ h : BoundedContinuousFunction (Flow d T × Path d T) ℝ,
            Tendsto (fun n => ∫ ω, h (μ ω, Xβ n ω) ∂P) atTop (𝓝 (∫ ω, h (μ ω, XΛ ω) ∂P))) ∧
          Tendsto (fun n => reward P (Xβ n) μ (strictRun f (β n)) g) atTop
            (𝓝 (reward P XΛ μ (relaxRun f Λ) g)) := by sorry

end ClosedLoopMFG.Limit
