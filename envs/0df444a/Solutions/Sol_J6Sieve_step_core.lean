def TS (S : Finset ℕ) (m : ℕ) : Finset (Finset ℕ) := S.powerset.filter (fun t => t.card ≤ m)

lemma bonf_eq (U : Finset ℕ) (m : ℕ) :
    ∑ t ∈ TS U m, (-1:ℤ) ^ t.card = ∑ j ∈ range (m + 1), (-1:ℤ) ^ j * (U.card.choose j : ℤ) := by
  classical
  rw [TS, Finset.sum_filter]
  have e := Finset.sum_powerset_apply_card (fun j => if j ≤ m then (-1:ℤ) ^ j else 0) (x := U)
  rw [e]
  set n := U.card
  let h : ℕ → ℤ := fun j => if j ≤ m then (-1:ℤ) ^ j * (n.choose j : ℤ) else 0
  have L : ∑ j ∈ range (n + 1), n.choose j • (if j ≤ m then (-1:ℤ) ^ j else 0)
      = ∑ j ∈ range (n + m + 1), h j := by
    rw [← Finset.sum_subset (Finset.range_subset_range.mpr (by omega : n + 1 ≤ n + m + 1))]
    · apply Finset.sum_congr rfl; intro j _
      simp only [h, nsmul_eq_mul]; split_ifs <;> ring
    · intro j _ hj
      simp only [Finset.mem_range, not_lt] at hj
      simp only [h, Nat.choose_eq_zero_of_lt (by omega : n < j)]; simp
  have R : ∑ j ∈ range (m + 1), (-1:ℤ) ^ j * (n.choose j : ℤ) = ∑ j ∈ range (n + m + 1), h j := by
    rw [← Finset.sum_subset (Finset.range_subset_range.mpr (by omega : m + 1 ≤ n + m + 1))]
    · apply Finset.sum_congr rfl; intro j hj
      simp only [Finset.mem_range] at hj
      simp only [h, if_pos (by omega : j ≤ m)]
    · intro j _ hj
      simp only [Finset.mem_range, not_lt] at hj
      simp only [h, if_neg (by omega : ¬ j ≤ m)]
  rw [L, R]

lemma bonf_le (U : Finset ℕ) (m : ℕ) (hm : Odd m) :
    ∑ t ∈ TS U m, (-1:ℤ) ^ t.card ≤ if U = ∅ then 1 else 0 := by
  rw [bonf_eq]
  split_ifs with hU
  · subst hU
    simp only [Finset.card_empty]
    rw [Finset.sum_range_succ']
    simp only [pow_zero, Nat.choose_zero_right, Nat.cast_one, mul_one]
    have : ∀ i ∈ range m, (-1:ℤ) ^ (i + 1) * ((Nat.choose 0 (i + 1) : ℕ) : ℤ) = 0 := by
      intro i _; simp
    rw [Finset.sum_eq_zero this]; simp
  · obtain ⟨n', hn'⟩ : ∃ n', U.card = n' + 1 :=
      ⟨U.card - 1, by have := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr hU); omega⟩
    rw [hn', Int.alternating_sum_range_choose_eq_choose, hm.neg_one_pow]
    have : (0:ℤ) ≤ (n'.choose m : ℤ) := by positivity
    linarith

lemma count_mul (A H d : ℕ) :
    ((Ioc A (A + H)).filter (d ∣ ·)).card = (A + H) / d - A / d := by
  have hs : (Ioc A (A + H)).filter (d ∣ ·) =
      ((Ioc 0 (A + H)).filter (d ∣ ·)) \ ((Ioc 0 A).filter (d ∣ ·)) := by
    ext x; simp only [Finset.mem_filter, Finset.mem_Ioc, Finset.mem_sdiff]; omega
  have hsub : (Ioc 0 A).filter (d ∣ ·) ⊆ (Ioc 0 (A + H)).filter (d ∣ ·) := by
    intro x; simp only [Finset.mem_filter, Finset.mem_Ioc]; omega
  rw [hs, Finset.card_sdiff_of_subset hsub, Nat.Ioc_filter_dvd_card_eq_div,
    Nat.Ioc_filter_dvd_card_eq_div]

