  have hbig : 35 * (2 * ((pP6 P n) / 2) + 1) ^ 2 ≤ 2 ^ ((pP6 P n) / 2) := sq_le_two_pow _ (by omega)
  have hp2 : (pP6 P n) ≤ 2 * ((pP6 P n) / 2) + 1 := by omega
