      ((Nat.card (TypeDensity.patternDivisors k s P) : ℕ) : ℚ) = (TypeDensity.tangentCount s P).eval (Nat.card k) := by
  obtain ⟨e⟩ := TypeDensity.patternDivisors_equiv_colorings k s P hP.2.1
    (fun a c hs ↦ by subst hs; exact hP.2.2.2.1)
  have hfin : ∀ i : Fin s.degree, Finite
      {Q : TypeDensity.ClosedDirection k // Q ∉ TypeDensity.boundaryDirections k s ∧ TypeDensity.directionDegree k Q = i.val + 1} :=
    fun i ↦ have := TypeDensity.finite_directionDegree_le k (i.val + 1)
      Finite.of_injective (fun Q ↦ (⟨Q.1, Q.2.2.le⟩ : {Q // TypeDensity.directionDegree k Q ≤ i.val + 1}))
        fun _ _ h ↦ Subtype.ext (Subtype.mk.inj h)
  refine ⟨Finite.of_equiv _ e.symm, ?_⟩
  rw [Nat.card_congr e, Nat.card_pi, Nat.cast_prod]
  unfold TypeDensity.tangentCount TypeDensity.divisorCount
  rw [TypeDensity.expression_prod_eval, List.map_map, Finset.prod_map_toList]
