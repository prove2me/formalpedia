theorem NLogN.KFG.phaseT_iruns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    (s : IState HS) (wb : ℕ) {W m n : ℕ} (T : Butterfly.Op (Fin n))
    (w : Fin W) (k₀ k₁ : ℕ) (a : Fin m → ℕ) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : Rep zs x) (h0 : f 0 = gflat zs ++ l)
    (hC : ClT f) (hb : NLogN.KFB.GB wb zs) (Z : ℕ)
    (hZ : zsz ((4 * (w.val * 2 ^ (m * n) + 2 ^ (m * n)) : ℕ) : ℤ) ≤ Z) :
    ∃ zs', Rep zs' ((P8Lift.RStep.den T (P8Lift.RStep.phase w k₀ k₁ a)).mulVec x) ∧ NLogN.KFB.GB wb zs' ∧
      IRuns I iprog (fcode (phaseT m n w.val k₀ k₁ a)) (encK s f)
        (encK s (Function.update f 0 (gflat zs' ++ l)))
        (cPhT wb (m * n) (w.val * 2 ^ (m * n)) Z) := by sorry
