lemma PhaseFlowOn.selectedConeTriangle_physical_sum {s : Solution} {T w : ℝ}
    (F : PhaseFlowOn s.E s.B T) (hs : EnergyPrefix s T) (hT : 0≤T)
    (zX : Phase) (Q : Set (Fin 4→ℕ)) {A : ConeKernelState→Vec}
