theorem solution{n d : ℕ} (hn : 0 < n) {x : Fin n → Fin d → ℝ} {y : Fin n → Bool}
    {w : Fin d → ℝ} (hsep : Separates x y w) :
    StrictMono (fun t : ℝ => logLik x y (fun j => t * w j)) := by
  intro a b hab
  have hne : (Finset.univ : Finset (Fin n)).Nonempty := by
    simpa [Finset.univ_nonempty_iff, ← Fin.pos_iff_nonempty] using hn
  refine Finset.sum_lt_sum_of_nonempty hne ?_
  intro i _
  have hs := hsep i
  cases hy : y i
  · have hneg : (∑ j, w j * x i j) < 0 := hs.2 hy
    have hmono := logisticTerm_ray_strictMono (s := -(∑ j, w j * x i j)) (by linarith) hab
    simp only [logisticTerm, score_smul, Bool.false_eq_true, if_false]
    have hrw : ∀ t : ℝ, -(t * -(∑ j, w j * x i j)) = t * ∑ j, w j * x i j := fun t => by ring
    simp only [hrw] at hmono
    exact hmono
  · have hpos : 0 < (∑ j, w j * x i j) := hs.1 hy
    have hmono := logisticTerm_ray_strictMono (s := (∑ j, w j * x i j)) hpos hab
    simp only [logisticTerm, score_smul, if_true]
    exact hmono
