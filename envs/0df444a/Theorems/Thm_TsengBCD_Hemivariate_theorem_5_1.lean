-- title:
--   Theorem 5.1, p. 488 — under B1–B3, C1 or C2 and a bounded level set, essentially cyclic BCD is defined, bounded, and its cluster points are coordinatewise minima
-- statement:
--   Let $f=f_0+\sum_{k=1}^N f_k$ satisfy Assumptions B1–B3, and let $f_0$ satisfy either Assumption C1 or C2. Let $x^0\in\operatorname{dom}f$ and assume that the level set
--   $$\{x: f(x)\le f(x^0)\}$$
--   is bounded. Then the sequence $\{x^r\}$ generated by the BCD method (2)–(3) from $x^0$ using the essentially cyclic rule is defined, bounded, and every cluster point of $\{x^r\}$ is a coordinatewise minimum point of $f$.
--
--   This is the main convergence theorem of §5. It extends a result of Auslender for strongly convex $f_0$ on a product of closed convex sets to the nonconvex, nondifferentiable setting where only quasiconvexity and hemivariance in each block are assumed.
--
--   **Formalization Note.** "Defined" is stated as: for every sequence of block choices there is a BCD run from $x^0$ (this is stronger than asking it only for essentially cyclic choices). "Bounded" and the cluster-point conclusion are stated for every BCD run from $x^0$ whose block choices follow the essentially cyclic rule. $f_0,f_k$ never take the value $-\infty$; blocks are 0-based; $x^0\in\operatorname{dom}f$ is the initialization of the method.
-- source:
--   Tseng, Convergence of a block coordinate descent method for nondifferentiable minimization, J. Optim. Theory Appl. 109 (2001), p. 488, Theorem 5.1

import Mathlib
import Definitions.Def_TsengBCD_Hemivariate_Setting

namespace TsengBCD.Hemivariate

open Filter Topology

theorem theorem_5_1 {N : ℕ} [NeZero N] {n : Fin N → ℕ} (f0 : TsengBCD.Stationary.X n → EReal)
    (fk : (k : Fin N) → EuclideanSpace ℝ (Fin (n k)) → EReal)
    (h0bot : ∀ x, f0 x ≠ ⊥) (hkbot : ∀ k y, fk k y ≠ ⊥)
    (hB : AssumptionB f0 fk) (hC : AssumptionC1 f0 ∨ AssumptionC2 f0)
    (x0 : TsengBCD.Stationary.X n) (hx0 : TsengBCD.Stationary.fSum f0 fk x0 ≠ ⊤)
    (hbdd : Bornology.IsBounded (TsengBCD.Stationary.levelSet (TsengBCD.Stationary.fSum f0 fk) x0)) :
    (∀ s : ℕ → Fin N, ∃ x : ℕ → TsengBCD.Stationary.X n, x 0 = x0 ∧ TsengBCD.Stationary.IsBCDRun (TsengBCD.Stationary.fSum f0 fk) s x) ∧
      ∀ (s : ℕ → Fin N) (x : ℕ → TsengBCD.Stationary.X n), TsengBCD.Stationary.IsEssCyclic s → x 0 = x0 → TsengBCD.Stationary.IsBCDRun (TsengBCD.Stationary.fSum f0 fk) s x →
        Bornology.IsBounded (Set.range x) ∧
          ∀ z, MapClusterPt z atTop x → TsengBCD.Stationary.IsCoordMin (TsengBCD.Stationary.fSum f0 fk) z := by sorry

end TsengBCD.Hemivariate
