section mono
variable {s t H W M win : ℕ}

lemma blkW_lt (hM : 0 < M) {Q' : ℕ} (hQ : Q' < 8 * M) : blkW M Q' < 8 * M := by
  unfold blkW
  have h1 : Q' / M < 8 := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hQ)
  have h2 : Q' % M < M := Nat.mod_lt _ hM
  omega

lemma kc_lt (hH : 1 ≤ H) (ht : t = M * 8 * (2 * H)) {b : ℕ} (hb : b < 8 * M) :
    kcB H (kkA H b) < t := by
  unfold kcB kkA; rw [Nat.mul_div_cancel _ (by omega)]
  have : (b + 1) * (2 * H) ≤ 8 * M * (2 * H) := Nat.mul_le_mul_right _ hb
  rw [ht]; nlinarith

/-- The value of the gather source (window position `Q'`, offset `e`). -/
lemma srcG_val (hwin : 0 < win) {l : ℕ} (he : l % win < 2 * W) :
    srcG s t H W M win l = some (l / win / M * (4 * t) +
      posE s t (jcB s t H (kkA H (blkW M (l / win))) - W + ((l % win : ℕ) : ℤ))) := by
  unfold srcG; rw [if_pos he]

lemma srcG_bound (hH : 1 ≤ H) (hM : 0 < M) (hwin : 0 < win) (ht : t = M * 8 * (2 * H))
    (hWs : W ≤ s) (hst : s ≤ t) {l : ℕ} (hl : l < 8 * (M * win)) (he : l % win < 2 * W) :
    l / win / M < 8 ∧ posE s t (jcB s t H (kkA H (blkW M (l / win))) - W + ((l % win : ℕ) : ℤ))
      < 3 * t := by
  have hq : l / win < 8 * M := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; linarith [hl])
  refine ⟨Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hq), ?_⟩
  have ht0 : 0 < t := by rw [ht]; positivity
  have hj0 := jcB_nonneg s t H (kkA H (blkW M (l / win)))
  have hj1 := jcB_le s t H (kkA H (blkW M (l / win))) ht0 (kc_lt hH ht (blkW_lt hM hq))
  apply posE_lt s t W hWs hst <;> push_cast <;> omega

theorem monoSrc_G_sol_aux (hH : 1 ≤ H) (hM : 0 < M) (hwin : 0 < win) (ht : t = M * 8 * (2 * H))
    (hWs : W ≤ s) (hst : s ≤ t) (hsep : 2 * W * t ≤ 16 * H * s) (hWw : 2 * W ≤ win) :
    MonoSrc (32 * t) (8 * (M * win)) (srcG s t H W M win) := by
  have ht0 : 0 < t := by rw [ht]; positivity
  refine ⟨fun l hl k hk => ?_, fun l₁ l₂ k₁ k₂ h12 hl₂ hk₁ hk₂ => ?_⟩
  · by_cases he : l % win < 2 * W
    · rw [srcG_val hwin he] at hk
      obtain ⟨h1, h2⟩ := srcG_bound hH hM hwin ht hWs hst hl he
      have := Option.some.inj hk
      have : l / win / M * (4 * t) ≤ 7 * (4 * t) := Nat.mul_le_mul_right _ (by omega)
      omega
    · unfold srcG at hk; rw [if_neg he] at hk; exact absurd hk (by simp)
  · have hl₁ : l₁ < 8 * (M * win) := by omega
    have he₁ : l₁ % win < 2 * W := by
      by_contra h; unfold srcG at hk₁; rw [if_neg h] at hk₁; exact absurd hk₁ (by simp)
    have he₂ : l₂ % win < 2 * W := by
      by_contra h; unfold srcG at hk₂; rw [if_neg h] at hk₂; exact absurd hk₂ (by simp)
    rw [srcG_val hwin he₁] at hk₁
    rw [srcG_val hwin he₂] at hk₂
    rw [← Option.some.inj hk₁, ← Option.some.inj hk₂]
    obtain ⟨a1, a2⟩ := srcG_bound hH hM hwin ht hWs hst hl₁ he₁
    obtain ⟨b1, b2⟩ := srcG_bound hH hM hwin ht hWs hst hl₂ he₂
    have f1 := Nat.div_add_mod l₁ win
    have f2 := Nat.div_add_mod l₂ win
    have e1 := Nat.div_add_mod (l₁ / win) M
    have e2 := Nat.div_add_mod (l₂ / win) M
    set q₁ := l₁ / win with hq₁
    set q₂ := l₂ / win with hq₂
    have hqq : q₁ ≤ q₂ := Nat.div_le_div_right h12.le
    have hq₂8 : q₂ < 8 * M := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; linarith [hl₂])
    set r₁ := q₁ / M
    set r₂ := q₂ / M
    have hrr : r₁ ≤ r₂ := Nat.div_le_div_right hqq
    rcases Nat.lt_or_ge r₁ r₂ with hr | hr
    · -- different classes
      have : (r₁ + 1) * (4 * t) ≤ r₂ * (4 * t) := Nat.mul_le_mul_right _ hr
      rw [Nat.succ_mul] at this
      omega
    · have hreq : r₁ = r₂ := le_antisymm hrr hr
      rw [hreq]
      apply Nat.add_le_add_left
      -- same class: the blocks
      have hj : q₁ % M ≤ q₂ % M := by
        have : M * r₁ = M * r₂ := by rw [hreq]
        omega
      have hjc0 := jcB_nonneg s t H (kkA H (blkW M q₁))
      have hjc1 := jcB_le s t H (kkA H (blkW M q₂)) ht0 (kc_lt hH ht (blkW_lt hM hq₂8))
      rcases Nat.lt_or_ge (q₁ % M) (q₂ % M) with hjl | hjl
      · -- different blocks of one class: disjoint windows
        have hsep' := jcB_sep s t H W (blkW M q₁) (blkW M q₂) ht0 hH hsep (by
          unfold blkW; rw [show q₁ / M = r₁ from rfl, show q₂ / M = r₂ from rfl, hreq]; omega)
        apply posE_mono s t W hWs hst <;> push_cast <;> omega
      · -- the same block
        have hjeq : q₁ % M = q₂ % M := le_antisymm hj hjl
        have hq : q₁ = q₂ := by
          have : M * r₁ = M * r₂ := by rw [hreq]
          omega
        have hee : l₁ % win ≤ l₂ % win := by
          have : win * q₁ = win * q₂ := by rw [hq]
          omega
        rw [hq]
        have := jcB_nonneg s t H (kkA H (blkW M q₂))
        apply posE_mono s t W hWs hst <;> push_cast <;> omega

end mono

