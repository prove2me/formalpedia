    have : (SH n Q T)[p] = Q := by
      simp only [SH, List.getElem_append_left (by simp; omega : p < (List.replicate n Q).length),
        List.getElem_replicate]
    rw [this]; exact Nat.mod_lt _ (by omega)
  · exact hlt p h1 h2

/-! ## The rotation sets -/

theorem ctl_lt (sig : Bool) {m j : ℕ} (hj : j < m) : ctl sig m j < m := by
  unfold ctl; split_ifs <;> omega

/-! ## The block swap -/

/-! ## The word -/

/-! ## The reversal identity -/

/-! ## The block swap as a composite Lemma 12 swap -/

theorem vol_rep (m Q : ℕ) : vol (List.replicate m Q) = Q ^ m := by simp [vol, List.prod_replicate]

theorem vol_SH (n Q : ℕ) (T : Shape) : vol (SH n Q T) = Q ^ n * vol T := by
  rw [SH, vol_append, vol_rep]

