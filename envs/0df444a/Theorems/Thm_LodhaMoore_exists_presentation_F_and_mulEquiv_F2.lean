-- title:
--   §3 (external) — the relations (1) and (2) present F, and x_{1ⁿ} corresponds to the nth standard generator
-- statement:
--   The group $F$ generated by the $x_s$ is presented by the generators $x_s$ ($s$ a finite binary sequence) and the relations (1) and (2): the homomorphism from that presented group sending each generator $x_s$ to the function $x_s$ is injective with image $F$. Moreover there is an isomorphism from the standard infinite presentation $\langle X_0, X_1, \dots \mid X_k^{-1}X_nX_k = X_{n+1}\ (k < n)\rangle$ (`CannonFloydParry.F2`) onto $F$ sending $X_n$ to $x_{1^n}$.
--
--   **Formalization Note.** $F$ is the group generated by the $x_s$, as the paper defines it in its next sentence ("We will use $F$ to denote the group generated by $\{x_s : s \in 2^{<\mathbb N}\}$"); the isomorphism with the standard presentation identifies it with Thompson's group.
-- source:
--   Lodha, Y. and Moore, J. T., A nonamenable finitely presented group of piecewise projective homeomorphisms, Groups Geom. Dyn. 10 (2016) 177–200, https://doi.org/10.4171/GGD/347 (arXiv:1308.4250v3, whose page numbers are used), p. 6, §3

import Mathlib
import Definitions.Def_LodhaMoore
import Definitions.Def_CannonFloydParry_Presentations

namespace LodhaMoore

theorem exists_presentation_F_and_mulEquiv_F2 :
    (∃ phi : PresentedGroup RX →* SeqGroup,
      (∀ s, phi (PresentedGroup.of s) = xs s) ∧ Function.Injective phi ∧ phi.range = F) ∧
    ∃ e : CannonFloydParry.F2 ≃* ↥F, ∀ n : ℕ, (e (PresentedGroup.of n) : SeqGroup) = xs (List.replicate n true) := by
  sorry

end LodhaMoore
