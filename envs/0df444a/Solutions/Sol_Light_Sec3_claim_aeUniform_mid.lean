over the instances with at most `⌊n²/√D⌋` query pairs. -/
private theorem polyBounded_sup' {D E : ℕ → ℕ} (hE : PolyBounded fun n _ => E n) {f : List ℕ → ℕ}
    {s k : ℕ} (hf : ∀ ps, f ps ≤ polyBound s k ps) :
    PolyBounded fun n _ => (Finset.range (queryCapNat n (D n) + 1)).sup fun w => f [n, E n, w] := by
