theorem gmulT_oneP (Δ : ℕ) (z : GI) : gmulT Δ z (oneP Δ) = z := by
  obtain ⟨a, b⟩ := z
  simp only [gmulT, oneP, mul_zero, sub_zero, zero_add]
  have h2 : (2 : ℤ) ^ Δ ≠ 0 := by positivity
  simp [Int.mul_tdiv_cancel _ h2]

theorem geoL_eq_chirpL (Δ : ℕ) (c : GI) : ∀ (n : ℕ) (x : GI),
    geoL Δ c x n = chirpL Δ (oneP Δ) c x n
  | 0, x => rfl
  | n + 1, x => by
    simp only [geoL, chirpL, gmulT_oneP]
    rw [geoL_eq_chirpL Δ c n]

