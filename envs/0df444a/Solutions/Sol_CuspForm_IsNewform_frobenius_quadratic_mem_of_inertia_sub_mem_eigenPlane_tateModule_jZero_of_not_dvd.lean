      (_hHecke : ∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ M) (hℓS : ℓ ∉ ((S : Set ℕ))), ∀ w ∈ W,
          (TM (ModularCurve.heckeGen ⟨ℓ, hℓ⟩)).baseChange K w =
            algebraMap O'' K (algebraMap O' O''
              ((iota.comp chig.rangeRestrict) (CuspForm.heckeAlgebra.T hℓ hℓN
