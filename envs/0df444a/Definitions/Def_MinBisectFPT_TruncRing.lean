-- title:
--   The truncated polynomial ring $R_t$, its monomials, the ideal $J_t$
-- statement:
--   $$R_t=\mathbb{Q}\bigl[x,y,z,(u_v)_{v\in\sigma}\bigr]\big/\bigl(x^{q'+1},\,y^{|\alpha(t)|+1},\,z^{k+1},\,u_v^2\ (v\in\sigma)\bigr),$$
--   where the paper has $q'=q$ and, in Lemma 4.2 and Algorithm 1, also other values of $q'$. For $T\subseteq\sigma$ the monomial $x^iy^\ell z^ju^T$ uses $u^T=\prod_{v\in T}u_v$. The ideal $J_t$ is generated by $x$ and $z$.
--
--   **Formalization Note** The ring is a quotient of a polynomial ring by the printed monomial ideal, not an array of coefficients. The verification file of the mission proves that the monomials with $i\le q'$, $\ell\le|\alpha(t)|$, $j\le k$, $T\subseteq\sigma$ are linearly independent, so the ring is not the zero ring and coefficients are well defined.
-- source:
--   Anand, Kipouridis, Węgrzycki, Counting over Unbreakable Decompositions, STOC 2027 submission (manuscript sha256 8db80a52…), §4.1, p.11; §4.2, p.12

import Mathlib

open scoped Classical

namespace MinBisectFPT

/-- The variables `x, y, z, (u_v)_{v∈S}` of `R_t`. Anand, Kipouridis, Węgrzycki, *Counting over
Unbreakable Decompositions*, STOC 2027 submission (manuscript sha256 8db80a52…), §4.1, p.11. -/
inductive RVar {n : ℕ} (S : Finset (Fin n)) : Type
  | x | y | z
  | u (v : S)

variable {n : ℕ}

open MvPolynomial in
/-- The ideal `(x^{q′+1}, y^{a+1}, z^{k+1}, u_v² (v ∈ S))` (p.11, with `q′` in place of `q`, which
Lemma 4.2 and Line 1 of Algorithm 1 use). -/
noncomputable def truncIdeal (S : Finset (Fin n)) (a k q' : ℕ) : Ideal (MvPolynomial (RVar S) ℚ) :=
  Ideal.span (({X RVar.x ^ (q' + 1), X RVar.y ^ (a + 1), X RVar.z ^ (k + 1)} :
      Set (MvPolynomial (RVar S) ℚ)) ∪ Set.range fun v : S => X (RVar.u v) ^ 2)

/-- **The truncated polynomial ring**
`R_t = Q[x, y, z, (u_v)_{v∈σ}] / (x^{q+1}, y^{|α(t)|+1}, z^{k+1}, u_v² (v ∈ σ))` (p.11), with `S = σ`,
`a = |α(t)|`. That it is not the zero ring is proved in the verification file of the mission. -/
abbrev TruncRing (S : Finset (Fin n)) (a k q' : ℕ) : Type :=
  MvPolynomial (RVar S) ℚ ⧸ truncIdeal S a k q'

open MvPolynomial in
/-- The monomial `x^i y^l z^j u^T`, `u^T = ∏_{v∈T} u_v` (p.11), in `R_t`. Vertices of `T` outside `S`
contribute nothing; all uses have `T ⊆ S`. -/
noncomputable def mono (S : Finset (Fin n)) (a k q' i l j : ℕ) (T : Finset (Fin n)) :
    TruncRing S a k q' :=
  Ideal.Quotient.mk _ (X RVar.x ^ i * X RVar.y ^ l * X RVar.z ^ j *
    ∏ v ∈ S.attach.filter (fun v => v.1 ∈ T), X (RVar.u v))

open MvPolynomial in
/-- `J_t`, "the ideal generated by {x, z}" (§4.2, p.12). -/
noncomputable def idealJ (S : Finset (Fin n)) (a k q' : ℕ) : Ideal (TruncRing S a k q') :=
  Ideal.span {Ideal.Quotient.mk _ (X RVar.x), Ideal.Quotient.mk _ (X RVar.z)}

end MinBisectFPT


