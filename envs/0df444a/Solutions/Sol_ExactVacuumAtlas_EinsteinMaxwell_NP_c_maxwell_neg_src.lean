/-!
# Atlas V-03: complex-valued parameter calculus (joint smoothness, interchange, frame derivatives)

Complex-valued analogues of IV's `Atlas/EinsteinMaxwell/Variation/Joint.lean` (which treats real-valued families):
for a family `Φ : ℝ → Pt n → ℂ` that is jointly `C^∞` in `(ε, y)` on an open `W ⊆ ℝ × ℝⁿ`

* `contDiffOn_cpdC_joint`: coordinate derivatives `cpdC i (Φ ε) y` are again jointly `C^∞`;
* `hasDerivAt_param_of_jointC`: `ε ↦ Φ ε y` has a genuine derivative at every point of `W`;
* `hasDerivAt_cpdC_param` (**interchange**): `d/dε|_{ε₀} cpdC i (Φ ε) x = cpdC i ψ x` whenever `ψ y` is the
  genuine parameter derivative of `ε ↦ Φ ε y` on the open slice (symmetry of the second derivative);
* `contDiffOn_deriv_slice`: the parameter derivative `y ↦ ∂_ε Φ(ε₀, y)` is `C^∞` on the slice;
* `hasDerivAt_fdir_param`: the first variation of a frame derivative keeps the frame-variation term,
  `δ(D_A f) = Σ_μ b_A^μ ∂_μ f₀ + D_A δf`;
* complex matrix determinant / adjugate / left-inverse smoothness (copies of IV's real versions).

No new geometric object is defined here. -/

open Complex Filter Topology
open scoped ComplexConjugate Matrix ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.Variation

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {n : ℕ}

theorem differentiableAt_jointC {φ : ℝ × Pt n → ℂ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hφ : ContDiffOn ℝ ∞ φ W) {p : ℝ × Pt n} (hp : p ∈ W) : DifferentiableAt ℝ φ p :=
  (hφ.contDiffAt (hW.mem_nhds hp)).differentiableAt (by simp)

theorem hasDerivAt_param_jointC {φ : ℝ × Pt n → ℂ} {p : ℝ × Pt n} (hd : DifferentiableAt ℝ φ p) :
    HasDerivAt (fun ε : ℝ => φ (ε, p.2)) (fderiv ℝ φ p ((1 : ℝ), (0 : Pt n))) p.1 := by
  have h1 : HasDerivAt (fun ε : ℝ => (ε, p.2)) ((1 : ℝ), (0 : Pt n)) p.1 :=
    (hasDerivAt_id p.1).prodMk (hasDerivAt_const p.1 p.2)
  have h2 : HasFDerivAt φ (fderiv ℝ φ p) (p.1, p.2) := hd.hasFDerivAt
  exact h2.comp_hasDerivAt p.1 h1

/-- The parameter derivative of a jointly `C^∞` complex family is `C^∞` on the open slice. -/
theorem contDiffOn_deriv_slice {Φ : ℝ → Pt n → ℂ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hΦ : ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => Φ p.1 p.2) W) (ε₀ : ℝ) :
    ContDiffOn ℝ ∞ (fun y => deriv (fun ε => Φ ε y) ε₀) {y | (ε₀, y) ∈ W} := by
  have hd : ContDiffOn ℝ ∞ (fun p => fderiv ℝ (fun p : ℝ × Pt n => Φ p.1 p.2) p ((1 : ℝ), (0 : Pt n))) W :=
    (hΦ.fderiv_of_isOpen hW (by simp)).clm_apply contDiffOn_const
  have hc : ContDiffOn ℝ ∞ (fun y : Pt n => ((ε₀, y) : ℝ × Pt n)) {y | (ε₀, y) ∈ W} :=
    (contDiff_const.prodMk contDiff_id).contDiffOn
  refine (hd.comp hc fun y hy => hy).congr fun y hy => ?_
  exact (hasDerivAt_param_jointC (p := (ε₀, y)) (differentiableAt_jointC hW hΦ hy)).deriv

/-- Frame derivatives of jointly `C^∞` families are jointly `C^∞`. -/
theorem contDiffOn_fdir_joint {E : ℝ → Fin n → Fin n → Pt n → ℂ} {Φ : ℝ → Pt n → ℂ} {W : Set (ℝ × Pt n)}
    (hW : IsOpen W) (hE : ∀ A μ, ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => E p.1 A μ p.2) W)
    (hΦ : ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => Φ p.1 p.2) W) (A : Fin n) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => fdir (E p.1) A (Φ p.1) p.2) W := by
  simp only [fdir]
  exact ContDiffOn.sum fun μ _ => (hE A μ).mul (contDiffOn_cpdC_joint hW hΦ μ)

