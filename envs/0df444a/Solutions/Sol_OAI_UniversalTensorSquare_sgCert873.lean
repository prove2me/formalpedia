theorem solveCompact_step {rsT rsA rsB : List ℕ} (k : ℕ) (D : CompactDomains rsT) (E : CompactDomains rsA)
    (F : CompactDomains rsB) (edges : List (Edge rsT rsA rsB)) (flag : Finset (ℕ × ℕ × ℕ))
    (c : Edge rsT rsA rsB) (cs : List (Edge rsT rsA rsB))
    (hv : (D.vanished || E.vanished || F.vanished) = false)
    (ho : compactOrderEdges D E F edges flag = c :: cs) :
    solveCompact (k+1) D E F edges flag = ∑ v ∈ compactEdgeOptions D E F c flag,
      solveCompact k (D.atValue c.1 v.1) (E.atValue c.2.1 v.2.1) (F.atValue c.2.2 v.2.2) cs flag := by
  rw [solveCompact]; simp only [hv, ho]; rfl

