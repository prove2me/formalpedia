open AModelRat AModelFac

lemma le_pow_two_mul (W q : ℕ) (hq : 2 ≤ q) : W ≤ q ^ (2 * W) :=
  calc W ≤ 2 ^ W := (Nat.lt_two_pow_self).le
    _ ≤ q ^ W := Nat.pow_le_pow_left hq W
    _ ≤ q ^ (2 * W) := Nat.pow_le_pow_right (by omega) (by omega)

/-- **Lemma 12 with the Prop. 11 program.** For a rational-label circuit satisfying the
hypotheses of `prop11_ratLabels`, for every large prime `q`, the Lemma 12 procedure whose
piece calls are `prog (C.toCircuit (q ^ m ^ Kp)) q j` (`Kp = kOf m q u`) and `ρ₀ = W`
interchanges the two `[2^u]` fields and costs `O(V u^τ)` (oracle cost `progCost`). -/
theorem lemma12_rat {R : Type*} [CommRing R] {m W : ℕ} [NeZero W] (C : QCircuit R m W)
    (hm : 2 ≤ m) (gatesOK : ∀ g ∈ C.gates, g.OK)
    (route : ∀ (v : Fin W → R) w, scalarRun C.gates v (C.ρ w) = v w)
    (unit : ∀ w, C.Mout (C.ρ w) - C.Min w = 1) {τ : ℝ} (hτ : 0 < τ ∧ τ < 1)
    (hs : ((frameSum (fun A : QMat m => A.rank) C.gates C.Min C.Mout : ℕ) : ℝ) / W <
      (m : ℝ) ^ τ) {c : ℝ} (hc : 0 ≤ c) :
    ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ u : ℕ, 1 ≤ u → ∀ Pre G Suf : Shape,
        (∀ xs : List R,
          lemma12Prog (fun K => AModel.prog (C.toCircuit (q ^ m ^ K)) q) W m q W Pre G Suf u 0 xs =
            pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
              (swapPos Pre.length (Pre.length + 1 + G.length)) 0 xs) ∧
        lemma12Cost (fun K => progCost (C.toCircuit (q ^ m ^ K)) q) c W m q W Pre G Suf u ≤
          K * (vol (binShape Pre G Suf (2 ^ u)) : ℝ) * (u : ℝ) ^ τ := by
  obtain ⟨q₀, hq₀⟩ := prop11_ratLabels C hm gatesOK route unit hτ hs
  refine ⟨q₀, fun q hq hlt => ?_⟩
  obtain ⟨hcorr, K₀, hK₀, hcost⟩ := hq₀ q hq hlt
  exact lemma12 (fun K => AModel.prog (C.toCircuit (q ^ m ^ K)) q)
    (fun K => progCost (C.toCircuit (q ^ m ^ K)) q) 0 hm (NeZero.pos W) hq.two_le
    (le_pow_two_mul W q hq.two_le) hτ.1 hK₀ hc
    (fun K j hj P L A B Cs ys hL hys => hcorr K j hj P L A B Cs ys hL hys)
    (fun K j V hV => hcost K j V hV)

end Rat

