  have hkWord : (k : ℤ) ≤ lim.word := (Int.ofNat_le.mpr hk).trans hVWord
  have hmWord := hbudget m (by unfold word; omega)
  have hJWord := hbudget J (by unfold word; omega)
  have h1Word := hbudget 1 (by unfold word; omega)
