-- title:
--   Theorem 4, (3.11) — RCDM$(1,x_0)$ on $f_\mu$, $\mu=\epsilon/(4R_0^2(x_0))$: $\mathrm{Prob}(f(x_k)-f^*\le\epsilon)\ge\beta$
-- statement:
--   Let $\mathbb R^N=\mathbb R^{n_1}\times\cdots\times\mathbb R^{n_n}$ with $n\ge1$ blocks carrying Euclidean norms $\|h^{(i)}\|_{(i)}^2=\langle B_ih^{(i)},h^{(i)}\rangle$ (3.4), and $\|h\|_0^2=\sum_i\|h^{(i)}\|_{(i)}^2$ (3.9). Let $f:\mathbb R^N\to\mathbb R$ be convex with coordinate-wise Lipschitz gradient, constants $L_i>0$ (2.2), and $S_1(f)=\sum_iL_i$. Let $x_*$ be a minimizer, $f^*=f(x_*)$, and let $R>0$ bound the size of the initial level set in $\|\cdot\|_0$:
--   $$\|x-x_*\|_0\le R\quad\text{whenever }f(x)\le f(x_0)\text{ and }x_*\text{ minimizes }f,$$
--   that is, $R_0(x_0)\le R$. Fix the accuracy $\epsilon>0$ and the confidence level $\beta\in(0,1)$, define $\mu=\epsilon/(4R^2)$ and the regularized objective $f_\mu(x)=f(x)+\frac\mu2\|x-x_0\|_0^2$, and choose $k$ with
--   $$k\ \ge\ 2\Big[n+\frac{4S_1(f)R^2}{\epsilon}\Big]\cdot\Big(\ln\frac1{1-\beta}+\ln\Big(\frac12+\frac{2S_1(f)R^2}{\epsilon}\Big)\Big).$$
--   Let $x_k$ be generated by RCDM$(1,x_0)$ as applied to $f_\mu$: block $i$ is drawn with probability $(L_i+\mu)/(S_1(f)+n\mu)$, independently at each step, and $x_{s+1}=x_s-\frac1{L_{i_s}+\mu}U_{i_s}(f_\mu)'_{i_s}(x_s)^\#$, with any choice of the vectors $s^\#$ of (1.8). Then
--   $$\mathrm{Prob}\big(f(x_k)-f^*\le\epsilon\big)\ \ge\ \beta .$$
--
--   A single run of randomized coordinate descent on the regularized problem therefore returns an $\epsilon$-solution of the original problem with high probability, after a number of iterations that depends only logarithmically on the confidence level.
--
--   **Formalization Note** The paper takes $R=R_0(x_0)$; here $R$ is any positive upper bound of $R_0(x_0)$ and $\mu=\epsilon/(4R^2)$ is defined from it. The proof uses $R_0(x_0)$ only through $\|x-x_*\|_0\le R$ on the level set, so the paper's statement is the case $R=R_0(x_0)$; $R>0$ excludes $R_0(x_0)=0$, where the paper's $\mu$ is undefined. Explicit hypotheses: $n\ge1$, $L_i>0$, $f$ convex, existence of a minimizer (standing assumptions of §2). The event concerns $f$ and $f^*$ of the original problem, while $x_k$ comes from the run on $f_\mu$ with $f_\mu$'s constants $L_i+\mu$ (step and sampling). The probability is the finite sum $\sum_{(i_0,\dots,i_{k-1})}\prod_sp(i_s)\,\mathbf 1[f(x_k)-f^*\le\epsilon]$ over draw sequences; blocks are `Fin n`, 0-based; Euclidean blocks are inner-product spaces $E_i$.
-- source:
--   Nesterov, Efficiency of coordinate descent methods on huge-scale optimization problems, CORE Discussion Paper 2010/2, p. 11, Theorem 4, (3.11); ϵ > 0 and β ∈ (0,1) fixed on p. 10

import Mathlib
import Definitions.Def_NesterovRCD_HighProb_Basic

open Classical

namespace NesterovRCD.HighProb

variable {n : ℕ} {E : Fin n → Type*} [∀ i, NormedAddCommGroup (E i)] [∀ i, InnerProductSpace ℝ (E i)]
  [∀ i, FiniteDimensional ℝ (E i)]

theorem theorem4 (hn : 0 < n) (f : NesterovRCD.Sublinear.Blocks E → ℝ) (hconv : ConvexOn ℝ Set.univ f)
    (L : Fin n → ℝ) (hL : NesterovRCD.Sublinear.CoordLipschitz f L)
    (sharp : ∀ i, (E i →L[ℝ] ℝ) → E i) (hsharp : NesterovRCD.Sublinear.IsSharpSelection sharp)
    (x0 xs : NesterovRCD.Sublinear.Blocks E) (hxs : NesterovRCD.Sublinear.IsMinimizer f xs)
    (R : ℝ) (hRpos : 0 < R) (hR : NesterovRCD.Sublinear.LevelRadiusLE f L 0 x0 R)
    (ε β : ℝ) (hε : 0 < ε) (hβ0 : 0 < β) (hβ1 : β < 1)
    (μ : ℝ) (hμ : μ = ε / (4 * R ^ 2)) (k : ℕ)
    (hk : 2 * ((n : ℝ) + 4 * NesterovRCD.Sublinear.S L 1 * R ^ 2 / ε) *
        (Real.log (1 / (1 - β)) + Real.log (1 / 2 + 2 * NesterovRCD.Sublinear.S L 1 * R ^ 2 / ε)) ≤ k) :
    β ≤ NesterovRCD.Sublinear.expect (NesterovRCD.Sublinear.prob (fun i => L i + μ) 1) k
      (fun idx => if f (NesterovRCD.Sublinear.rcdm (fReg f L μ x0) (fun i => L i + μ) sharp x0 k idx) - f xs ≤ ε
        then 1 else 0) := by sorry

end NesterovRCD.HighProb
