    (x : ↥(xHFunctionFieldBar N H)) (y : LaurentSeries ℚ)
    (hy : y ∈ qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma0 N))
    (hx : (x : LaurentSeries (AlgebraicClosure ℚ)) = coeffEmb (AlgebraicClosure ℚ) y) :
    diamondAutHBar N H c x = x := by sorry
