variable {R : Type} [CommRing R]

def IsHom {A A' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (L' : RelativeGroupLaw R f') (Φ : A ⟶ A') (hΦ : Φ ≫ f' = f) : Prop :=
  ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
    mapPt Φ hΦ (L.mul t P Q) = L'.mul t (mapPt Φ hΦ P) (mapPt Φ hΦ Q)

theorem IsHom.comp {A A' A'' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    {f'' : A'' ⟶ Spec (CommRingCat.of R)}
    {L : RelativeGroupLaw R f} {L' : RelativeGroupLaw R f'} {L'' : RelativeGroupLaw R f''}
    {Φ : A ⟶ A'} {hΦ : Φ ≫ f' = f} {Ψ : A' ⟶ A''} {hΨ : Ψ ≫ f'' = f'}
    (h1 : IsHom L L' Φ hΦ) (h2 : IsHom L' L'' Ψ hΨ) (hc : (Φ ≫ Ψ) ≫ f'' = f) :
    IsHom L L'' (Φ ≫ Ψ) hc := by
  intro T t P Q
  have e : ∀ X : SchemeHomOver t f, mapPt (Φ ≫ Ψ) hc X = mapPt Ψ hΨ (mapPt Φ hΦ X) := fun X =>
    Subtype.ext (by simp only [mapPt_coe, Category.assoc])
  rw [e, e, e, h1, h2]

theorem IsHom.val {A A' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    {L : RelativeGroupLaw R f} {L' : RelativeGroupLaw R f'} {Φ : A ⟶ A'} {hΦ : Φ ≫ f' = f} (h : IsHom L L' Φ hΦ) :
    ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
      (L.mul t P Q).1 ≫ Φ =
        (L'.mul t ⟨P.1 ≫ Φ, by rw [Category.assoc, hΦ]; exact P.2⟩ ⟨Q.1 ≫ Φ, by rw [Category.assoc, hΦ]; exact Q.2⟩).1 :=
  fun t P Q => congrArg Subtype.val (h t P Q)

theorem eq_one_of_mul_self {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f)
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (x : SchemeHomOver t f) (h : L.mul t x x = x) :
    x = L.one t := by
  have h2 : L.mul t (L.inv t x) (L.mul t x x) = L.mul t (L.inv t x) x := by rw [h]
  rw [← L.mul_assoc, L.inv_mul_cancel, L.one_mul] at h2
  exact h2

theorem IsHom.map_one {A A' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    {L : RelativeGroupLaw R f} {L' : RelativeGroupLaw R f'} {Φ : A ⟶ A'} {hΦ : Φ ≫ f' = f} (h : IsHom L L' Φ hΦ)
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) : mapPt Φ hΦ (L.one t) = L'.one t := by
  apply eq_one_of_mul_self
  rw [← h, L.one_mul]

theorem nsmulPt_eq_nsmul {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f)
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (n : ℕ) (P : SchemeHomOver t f) :
    nsmulPt L t n P = L.nsmul t n P := by
  induction n with
  | zero => rw [RelativeGroupLaw.nsmul_zero]; rfl
  | succ n ih => rw [RelativeGroupLaw.nsmul_succ, ← ih]; rfl

theorem val_comp_schemeNsmul {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f)
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (n : ℕ) (Q : SchemeHomOver t f) :
    Q.1 ≫ L.schemeNsmul n = (nsmulPt L t n Q).1 := by
  have h := L.nsmul_natural f t Q.1 Q.2 n RelativeGroupLaw.idPoint
  have hid : schemeHomOverComp Q.1 Q.2 (RelativeGroupLaw.idPoint (f := f)) = Q :=
    Subtype.ext (by rw [schemeHomOverComp_coe]; exact Category.comp_id _)
  rw [hid, ← nsmulPt_eq_nsmul L t n Q] at h
  rw [← h, schemeHomOverComp_coe]
  rfl

theorem act_natCast_eq_schemeNsmul {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} (E : FakeEllipticCurve Λ N R)
    (h1 : (1 : ℍ[ℚ, a, b]) ∈ Λ) (n : ℕ) (hn : ((n : ℚ) : ℍ[ℚ, a, b]) ∈ Λ) :
    E.act ⟨((n : ℚ) : ℍ[ℚ, a, b]), hn⟩ = E.L.schemeNsmul n := by
  have h := CerednikDrinfeld.QM.FakeEllipticCurve.pushPt_act_natCast_eq_nsmulPt E h1 n hn E.f RelativeGroupLaw.idPoint
  have h' := congrArg Subtype.val h
  rw [← val_comp_schemeNsmul] at h'
  simpa [pushPt, mapPt_coe] using h'

theorem aeval_mem_of_coeff_zero {S C : Type} [CommRing S] [CommRing C] [Algebra S C] {σ : Type} (J : Ideal C)
    (p : MvPolynomial σ S) (hp : p.coeff 0 = 0) (a : σ → C) (ha : ∀ i, a i ∈ J) : MvPolynomial.aeval a p ∈ J := by
  classical
  rw [p.as_sum, map_sum]
  refine Ideal.sum_mem _ fun d _ => ?_
  rw [MvPolynomial.aeval_monomial]
  by_cases hd0 : d = 0
  · subst hd0
    rw [hp, map_zero, zero_mul]
    exact J.zero_mem
  · obtain ⟨s, hs⟩ : ∃ s, d s ≠ 0 := by
      by_contra h
      push Not at h
      exact hd0 (Finsupp.ext fun s => by simpa using h s)
    refine Ideal.mul_mem_left _ _ ?_
    rw [Finsupp.prod, ← Finset.mul_prod_erase _ _ (Finsupp.mem_support_iff.mpr hs)]
    refine Ideal.mul_mem_right _ _ ?_
    obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hs
    rw [hk, pow_succ]
    exact Ideal.mul_mem_left _ _ (ha s)

theorem nilEval_mem {S C : Type} [CommRing S] [CommRing C] [Algebra S C] {σ : Type} [Fintype σ] [DecidableEq σ]
    (J : Ideal C) (n : ℕ) (φ : MvPowerSeries σ S) (hφ : MvPowerSeries.constantCoeff φ = 0) (a : σ → C)
    (ha : ∀ i, a i ∈ J) : MvFormalGroup.nilEval n φ a ∈ J := by
  unfold MvFormalGroup.nilEval
  refine aeval_mem_of_coeff_zero J _ ?_ a ha
  rw [MvPowerSeries.coeff_trunc', if_pos (Finsupp.le_def.2 fun _ => Nat.zero_le _),
    MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hφ]

theorem nilEval_zero {σ : Type} [Fintype σ] [DecidableEq σ] {S C : Type} [CommRing S] [CommRing C] [Algebra S C]
    (m : ℕ) (φ : MvPowerSeries σ S) (hφ : MvPowerSeries.constantCoeff φ = 0) :
    MvFormalGroup.nilEval m φ (0 : σ → C) = 0 := by
  have h := nilEval_mem (⊥ : Ideal C) m φ hφ 0 (fun _ => Ideal.zero_mem _)
  rwa [Ideal.mem_bot] at h

theorem nilMul_zero {g : ℕ} {S C : Type} [CommRing S] [CommRing C] [Algebra S C] (F : MvFormalGroup g S) (m : ℕ) :
    F.nilMul m (0 : Fin g → C) 0 = 0 := by
  funext i
  show MvFormalGroup.nilEval m (F.toPowerSeries i) (Sum.elim 0 0) = 0
  have : (Sum.elim (0 : Fin g → C) (0 : Fin g → C)) = 0 := by funext x; cases x <;> rfl
  rw [this]
  exact nilEval_zero m _ (F.constantCoeff_eq_zero i)

open MvPowerSeries in

theorem nilEval_map {σ : Type} [Fintype σ] [DecidableEq σ] {S S' B'' : Type} [CommRing S] [CommRing S'] [CommRing B'']
    [Algebra S B''] [Algebra S' B''] (f : S →+* S') (h : algebraMap S B'' = (algebraMap S' B'').comp f)
    (n : ℕ) (φ : MvPowerSeries σ S) (a : σ → B'') :
    MvFormalGroup.nilEval n (MvPowerSeries.map f φ) a = MvFormalGroup.nilEval n φ a := by
  unfold MvFormalGroup.nilEval
  rw [MvPowerSeries.trunc'_map, MvPolynomial.aeval_def, MvPolynomial.aeval_def, MvPolynomial.eval₂_map, ← h]

theorem germ_unique {k : Type} [CommRing k] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of k)} (L : RelativeGroupLaw k f)
    (F : MvFormalGroup 2 k) (θ : RelativeGroupLaw.FormalCoordinates f 2) (hθ : L.IsFormalCoordinates F θ)
    (σ₁ σ₂ : Series k) (h₁ : ∀ i, MvPowerSeries.constantCoeff (σ₁ i) = 0) (h₂ : ∀ i, MvPowerSeries.constantCoeff (σ₂ i) = 0)
    (h : ∀ (B'' : Type) [CommRing B''] [Algebra k B''] (J : Ideal B'') (m : ℕ), J ^ (m + 1) = ⊥ →
      ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
        θ B'' (fun i => MvFormalGroup.nilEval m (σ₁ i) s) = θ B'' (fun i => MvFormalGroup.nilEval m (σ₂ i) s)) :
    σ₁ = σ₂ := by
  classical
  set mk : k →+* k ⧸ (⊥ : Ideal k) := Ideal.Quotient.mk ⊥ with hmk
  have hinj : Function.Injective mk := by
    rw [hmk, RingHom.injective_iff_ker_eq_bot, Ideal.mk_ker]
  have key := GoodReductionJacobian.RelativeGroupLaw.IsFormalCoordinates.funext_of_forall_apply_nilEval_eq_of_constantCoeff_eq_zero
    L F θ hθ (⊥ : Ideal k) (σ₁.map mk) (σ₂.map mk)
    (fun i => by show MvPowerSeries.constantCoeff (MvPowerSeries.map mk (σ₁ i)) = 0
                 rw [MvPowerSeries.constantCoeff_map, h₁ i, map_zero])
    (fun i => by show MvPowerSeries.constantCoeff (MvPowerSeries.map mk (σ₂ i)) = 0
                 rw [MvPowerSeries.constantCoeff_map, h₂ i, map_zero])
    (fun B'' _ _ _ hc J m hJ s hs => by
      have e₁ : (fun i => MvFormalGroup.nilEval m ((σ₁.map mk) i) s) = fun i => MvFormalGroup.nilEval m (σ₁ i) s :=
        funext fun i => nilEval_map mk hc m (σ₁ i) s
      have e₂ : (fun i => MvFormalGroup.nilEval m ((σ₂.map mk) i) s) = fun i => MvFormalGroup.nilEval m (σ₂ i) s :=
        funext fun i => nilEval_map mk hc m (σ₂ i) s
      rw [e₁, e₂]
      exact h B'' J m hJ s hs)
  funext i
  ext d
  have hc := congrArg (fun (τ : Series (k ⧸ (⊥ : Ideal k))) => MvPowerSeries.coeff d (τ i)) key
  simp only [Series.map, MvPowerSeries.coeff_map] at hc
  exact hinj hc

theorem act_comm_natCast {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} (E : FakeEllipticCurve Λ N R) (x : ↥Λ) (n : ℕ)
    (hn : ((n : ℚ) : ℍ[ℚ, a, b]) ∈ Λ) :
    E.act x ≫ E.act ⟨((n : ℚ) : ℍ[ℚ, a, b]), hn⟩ = E.act ⟨((n : ℚ) : ℍ[ℚ, a, b]), hn⟩ ≫ E.act x := by
  have hnx : ((n : ℚ) : ℍ[ℚ, a, b]) * (x : ℍ[ℚ, a, b]) ∈ Λ := by
    rw [QuaternionAlgebra.coe_natCast, ← nsmul_eq_mul]; exact nsmul_mem x.2 n
  have hxn : (x : ℍ[ℚ, a, b]) * ((n : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
    rw [QuaternionAlgebra.coe_natCast, ← nsmul_eq_mul']; exact nsmul_mem x.2 n
  have h1 := E.act_mul ⟨((n : ℚ) : ℍ[ℚ, a, b]), hn⟩ x hnx
  have h2 := E.act_mul x ⟨((n : ℚ) : ℍ[ℚ, a, b]), hn⟩ hxn
  have h3 : (⟨((n : ℚ) : ℍ[ℚ, a, b]) * (x : ℍ[ℚ, a, b]), hnx⟩ : ↥Λ) = ⟨(x : ℍ[ℚ, a, b]) * ((n : ℚ) : ℍ[ℚ, a, b]), hxn⟩ :=
    Subtype.ext (QuaternionAlgebra.coe_commutes _ _)
  rw [← h1, h3, h2]

end SFKSol

open SFKSol

theorem solution
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {r : ℕ} [Fact r.Prime]
    (hΛ1 : (1 : ℍ[ℚ, a, b]) ∈ Λ) (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    (coord : ↥Λ → Zp2 r × Zp2 r) (hcoord : IsOrderCoord Λ r coord)
    (k : Type) [Field k] [IsAlgClosed k] (hkr : IsNilpotent ((r : ℕ) : k))

    (A : FakeEllipticCurve Λ N k) (XA : FormalODModule r k) (θA : RelativeGroupLaw.FormalCoordinates A.f 2)
    (hA : A.IsFormalModuleVia coord XA θA) (hA4 : XA.HasHeight 4)

    (E E' : FakeEllipticCurve Λ N k) (X X' : FormalODModule r k)
    (θ : RelativeGroupLaw.FormalCoordinates E.f 2) (θ' : RelativeGroupLaw.FormalCoordinates E'.f 2)
    (hX : E.IsFormalModuleVia coord X θ) (hX' : E'.IsFormalModuleVia coord X' θ')

    (d d' : ℕ) (α : A.A ⟶ E.A) (αv : E.A ⟶ A.A) (hα : FakeEllipticCurve.IsIsogenyPair (r ^ d) A E α αv)
    (α' : A.A ⟶ E'.A) (αv' : E'.A ⟶ A.A) (hα' : FakeEllipticCurve.IsIsogenyPair (r ^ d') A E' α' αv')

    (σ σ' : Series k) (hσ0 : ∀ i, MvPowerSeries.constantCoeff (σ i) = 0) (hσ'0 : ∀ i, MvPowerSeries.constantCoeff (σ' i) = 0)
    (hσ : ∀ (B'' : Type) [CommRing B''] [Algebra k B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
      ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
        (θA B'' s).1 ≫ α = (θ B'' (fun i => MvFormalGroup.nilEval n (σ i) s)).1)
    (hσ' : ∀ (B'' : Type) [CommRing B''] [Algebra k B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
      ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
        (θA B'' s).1 ≫ α' = (θ' B'' (fun i => MvFormalGroup.nilEval n (σ' i) s)).1)

    (T₀ : FormalODModule.Hom X X') (hT₀ : T₀.IsIso) (hTσ : T₀.toSeries.comp σ = σ') :
    ∃ (e : E.A ≅ E'.A) (he : e.hom ≫ E'.f = E.f),
      α ≫ e.hom = α' ∧
      (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k)) (P Q : SchemeHomOver t E.f),
        mapPt e.hom he (E.L.mul t P Q) = E'.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q)) ∧
      (∀ x : ↥Λ, E.act x ≫ e.hom = e.hom ≫ E'.act x) ∧
      (∀ (B'' : Type) [CommRing B''] [Algebra k B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
        ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
          (θ B'' s).1 ≫ e.hom = (θ' B'' (fun i => MvFormalGroup.nilEval n (T₀.toSeries i) s)).1) := by
  classical

  obtain ⟨hαf, hαvf, hαmul, hαvmul, hαact, hαvact, hαdeg⟩ := hα
  obtain ⟨hα'f, hαv'f, hα'mul, hαv'mul, hα'act, hαv'act, hα'deg⟩ := hα'
  have hdΛ : (((r ^ d : ℕ) : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
    have := hΛℤ ((r ^ d : ℕ) : ℤ); rwa [Int.cast_natCast] at this
  have hdΛ' : (((r ^ d' : ℕ) : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
    have := hΛℤ ((r ^ d' : ℕ) : ℤ); rwa [Int.cast_natCast] at this
  obtain ⟨hααv, hαvα⟩ := hαdeg hdΛ
  obtain ⟨hα'αv', hαv'α'⟩ := hα'deg hdΛ'
  have hrd : 0 < r ^ d := pow_pos (Fact.out : r.Prime).pos d
  have hrd' : 0 < r ^ d' := pow_pos (Fact.out : r.Prime).pos d'

  have hNE : E.act ⟨(((r ^ d : ℕ) : ℚ) : ℍ[ℚ, a, b]), hdΛ⟩ = E.L.schemeNsmul (r ^ d) := act_natCast_eq_schemeNsmul E hΛ1 _ hdΛ
  have hNA : A.act ⟨(((r ^ d : ℕ) : ℚ) : ℍ[ℚ, a, b]), hdΛ⟩ = A.L.schemeNsmul (r ^ d) := act_natCast_eq_schemeNsmul A hΛ1 _ hdΛ
  have hNE' : E'.act ⟨(((r ^ d' : ℕ) : ℚ) : ℍ[ℚ, a, b]), hdΛ'⟩ = E'.L.schemeNsmul (r ^ d') := act_natCast_eq_schemeNsmul E' hΛ1 _ hdΛ'
  have hNA' : A.act ⟨(((r ^ d' : ℕ) : ℚ) : ℍ[ℚ, a, b]), hdΛ'⟩ = A.L.schemeNsmul (r ^ d') := act_natCast_eq_schemeNsmul A hΛ1 _ hdΛ'

  obtain ⟨hfinE, hflatE⟩ := GoodReductionJacobian.RelativeGroupLaw.isFinite_and_flat_schemeNsmul E.L E.bundle
    E.comm (r ^ d) hrd
  obtain ⟨hfinE', hflatE'⟩ := GoodReductionJacobian.RelativeGroupLaw.isFinite_and_flat_schemeNsmul E'.L E'.bundle
    E'.comm (r ^ d') hrd'
  obtain ⟨hfinA, hflatA⟩ := GoodReductionJacobian.RelativeGroupLaw.isFinite_and_flat_schemeNsmul A.L A.bundle
    A.comm (r ^ d) hrd
  obtain ⟨hfinA', hflatA'⟩ := GoodReductionJacobian.RelativeGroupLaw.isFinite_and_flat_schemeNsmul A.L A.bundle
    A.comm (r ^ d') hrd'
  haveI := hfinE; haveI := hflatE; haveI := hfinE'; haveI := hflatE'; haveI := hfinA; haveI := hflatA
  haveI := hfinA'; haveI := hflatA'
  haveI : Surjective (E.L.schemeNsmul (r ^ d)) := GoodReductionJacobian.RelativeGroupLaw.surjective_schemeNsmul E.L E.comm E.bundle _ hrd
  haveI : Surjective (E'.L.schemeNsmul (r ^ d')) := GoodReductionJacobian.RelativeGroupLaw.surjective_schemeNsmul E'.L E'.comm E'.bundle _ hrd'
  haveI : Surjective (A.L.schemeNsmul (r ^ d)) := GoodReductionJacobian.RelativeGroupLaw.surjective_schemeNsmul A.L A.comm A.bundle _ hrd
  haveI : Surjective (A.L.schemeNsmul (r ^ d')) := GoodReductionJacobian.RelativeGroupLaw.surjective_schemeNsmul A.L A.comm A.bundle _ hrd'
  haveI : QuasiCompact (E.L.schemeNsmul (r ^ d)) := inferInstance
  haveI : QuasiCompact (E'.L.schemeNsmul (r ^ d')) := inferInstance
  haveI : QuasiCompact (A.L.schemeNsmul (r ^ d)) := inferInstance
  haveI : QuasiCompact (A.L.schemeNsmul (r ^ d')) := inferInstance

  have hαH : IsHom A.L E.L α hαf := fun t P Q => hαmul t P Q
  have hαvH : IsHom E.L A.L αv hαvf := fun t P Q => hαvmul t P Q
  have hα'H : IsHom A.L E'.L α' hα'f := fun t P Q => hα'mul t P Q
  have hαv'H : IsHom E'.L A.L αv' hαv'f := fun t P Q => hαv'mul t P Q

  obtain ⟨S₀, hS₀1, hS₀2⟩ := hT₀
  have hSσ : S₀.toSeries.comp σ' = σ := by
    rw [← hTσ, ← Series.comp_assoc _ _ _ T₀.isODHom.constantCoeff hσ0,
      show S₀.toSeries.comp T₀.toSeries = Series.id k from congrArg FormalODModule.Hom.toSeries hS₀1,
      Series.id_comp _ hσ0]

  have affine_suffices : ∀ {B₁ B₂ : Scheme.{0}} {g₁ : B₁ ⟶ Spec (CommRingCat.of k)} {g₂ : B₂ ⟶ Spec (CommRingCat.of k)}
      (L₁ : RelativeGroupLaw k g₁) (L₂ : RelativeGroupLaw k g₂) (n : ℕ) (F : B₁ ⟶ B₂) (hF : F ≫ g₂ = g₁),
      (∀ (C : Type) [CommRing C] [Algebra k C] (P : SchemeHomOver (Scheme.specOver (𝒪 := k) C) g₁),
          L₁.IsTorsionPoint (Scheme.specOver (𝒪 := k) C) n P → P.1 ≫ F = (L₂.one (Scheme.specOver (𝒪 := k) C)).1) →
      ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k)) (P : SchemeHomOver t g₁),
          L₁.IsTorsionPoint t n P → P.1 ≫ F = (L₂.one t).1 :=
    fun L₁ L₂ n F _hF haff => L₁.forall_isTorsionPoint_comp_eq_one_of_forall_specOver L₂ F n haff

  have kernel_kill_affine :
      ∀ (E₁ E₂ : FakeEllipticCurve Λ N k) (X₁ X₂ : FormalODModule r k)
        (θ₁ : RelativeGroupLaw.FormalCoordinates E₁.f 2) (θ₂ : RelativeGroupLaw.FormalCoordinates E₂.f 2)
        (hX₁ : E₁.IsFormalModuleVia coord X₁ θ₁) (hX₂ : E₂.IsFormalModuleVia coord X₂ θ₂)
        (d₁ : ℕ) (β : A.A ⟶ E₁.A) (hβ : β ≫ E₁.f = A.f) (βv : E₁.A ⟶ A.A) (hβv : βv ≫ A.f = E₁.f)
        (hβH : IsHom A.L E₁.L β hβ) (hβvH : IsHom E₁.L A.L βv hβv)
        (hββv : β ≫ βv = A.L.schemeNsmul (r ^ d₁)) (hβvβ : βv ≫ β = E₁.L.schemeNsmul (r ^ d₁))
        (β' : A.A ⟶ E₂.A) (hβ' : β' ≫ E₂.f = A.f)
        (τ τ' : Series k) (hτ0 : ∀ i, MvPowerSeries.constantCoeff (τ i) = 0)
        (hτ : ∀ (B'' : Type) [CommRing B''] [Algebra k B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
          ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) → (θA B'' s).1 ≫ β = (θ₁ B'' (fun i => MvFormalGroup.nilEval n (τ i) s)).1)
        (hτ' : ∀ (B'' : Type) [CommRing B''] [Algebra k B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
          ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) → (θA B'' s).1 ≫ β' = (θ₂ B'' (fun i => MvFormalGroup.nilEval n (τ' i) s)).1)
        (U : Series k) (hU0 : ∀ i, MvPowerSeries.constantCoeff (U i) = 0) (hUτ : U.comp τ = τ'),
      ∀ (C : Type) [CommRing C] [Algebra k C] (P : SchemeHomOver (Scheme.specOver (𝒪 := k) C) E₁.f),
        E₁.L.IsTorsionPoint (Scheme.specOver (𝒪 := k) C) (r ^ d₁) P →
          P.1 ≫ (βv ≫ β') = (E₂.L.one (Scheme.specOver (𝒪 := k) C)).1 := by
    intro E₁ E₂ X₁ X₂ θ₁ θ₂ hX₁ hX₂ d₁ β hβ βv hβv hβH hβvH hββv hβvβ β' hβ' τ τ' hτ0 hτ hτ' U hU0 hUτ C _ _ P hP

    have hPval : (nsmulPt E₁.L (Scheme.specOver (𝒪 := k) C) (r ^ d₁) P).1 = (E₁.L.one (Scheme.specOver (𝒪 := k) C)).1 := by
      rw [nsmulPt_eq_nsmul]; exact congrArg Subtype.val hP
    have hQβ : (P.1 ≫ βv) ≫ β = (E₁.L.one (Scheme.specOver (𝒪 := k) C)).1 := by
      rw [Category.assoc, hβvβ, val_comp_schemeNsmul, hPval]
    have hQtor : nsmulPt A.L (Scheme.specOver (𝒪 := k) C) (r ^ d₁) (mapPt βv hβv P) = A.L.one (Scheme.specOver (𝒪 := k) C) := by
      apply Subtype.ext
      rw [← val_comp_schemeNsmul, ← hββv, mapPt_coe, ← Category.assoc, hQβ]
      exact congrArg Subtype.val (hβvH.map_one (Scheme.specOver (𝒪 := k) C))

    obtain ⟨J, hJnil, hQinf⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_isNilpotent_isInfinitesimal_of_nsmulPt_pow_eq_one_of_one_mem
        coord hcoord hΛ1 k hkr A XA θA hA C d₁ (mapPt βv hβv P) hQtor
    obtain ⟨m, hm⟩ := hJnil
    have hJm : J ^ (m + 1) = ⊥ := by rw [pow_succ, hm, zero_mul]; rfl
    obtain ⟨-, -, hontoA, -⟩ := hA.1.2 C J m hJm
    obtain ⟨s, hs, hsQ⟩ := hontoA (mapPt βv hβv P) hQinf

    have h1 := hτ C J m hJm s hs
    have h2 := hτ' C J m hJm s hs
    rw [hsQ, mapPt_coe] at h1 h2

    obtain ⟨-, hinj₁, -, hhom₁⟩ := hX₁.1.2 C J m hJm
    obtain ⟨-, -, -, hhom₂⟩ := hX₂.1.2 C J m hJm
    have hzero : ∀ i, (0 : Fin 2 → C) i ∈ J := fun _ => J.zero_mem
    have hθ₁0 : θ₁ C 0 = E₁.L.one (Scheme.specOver (𝒪 := k) C) := by
      apply eq_one_of_mul_self
      rw [← hhom₁ 0 0 hzero hzero, nilMul_zero]
    have hθ₂0 : θ₂ C 0 = E₂.L.one (Scheme.specOver (𝒪 := k) C) := by
      apply eq_one_of_mul_self
      rw [← hhom₂ 0 0 hzero hzero, nilMul_zero]
    have hvJ : ∀ i, MvFormalGroup.nilEval m (τ i) s ∈ J :=
      (MvFormalGroup.nilEval_subst_of_mem J m hJm s hs τ hτ0 (MvPowerSeries.X 0)).1
    have hv0 : (fun i => MvFormalGroup.nilEval m (τ i) s) = 0 := by
      apply hinj₁ _ _ hvJ hzero
      rw [hθ₁0]
      exact Subtype.ext (h1.symm.trans hQβ)

    have hev : (fun i => MvFormalGroup.nilEval m (τ' i) s) = 0 := by
      funext i
      rw [← hUτ]
      show MvFormalGroup.nilEval m (MvPowerSeries.subst τ (U i)) s = 0
      rw [(MvFormalGroup.nilEval_subst_of_mem J m hJm s hs τ hτ0 (U i)).2, hv0]
      exact nilEval_zero m (U i) (hU0 i)
    rw [← Category.assoc, h2, hev, hθ₂0]

  have hβf : (αv ≫ α') ≫ E'.f = E.f := by rw [Category.assoc, hα'f, hαvf]
  have hβH : IsHom E.L E'.L (αv ≫ α') hβf := IsHom.comp hαvH hα'H hβf
  have hββ : α ≫ αv = A.L.schemeNsmul (r ^ d) := by rw [hααv, hNA]
  have hββ' : αv ≫ α = E.L.schemeNsmul (r ^ d) := by rw [hαvα, hNE]
  have hker : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of k)) (P : SchemeHomOver t E.f),
      E.L.IsTorsionPoint t (r ^ d) P → P.1 ≫ (αv ≫ α') = (E'.L.one t).1 :=
    affine_suffices E.L E'.L (r ^ d) (αv ≫ α') hβf
