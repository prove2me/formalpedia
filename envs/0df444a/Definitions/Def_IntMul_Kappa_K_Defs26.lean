-- Source module: Solutions.KFY6Gen
/-!
# KFY 6: generic combinators for the line passes

* **`brk l P`**: push the register list `l`, run `P`, pop the registers again. If `P` changes
  only one stack `j ∉ l` (`P.run t' = t'.upd j Z`), so does the bracket (**`brk_all`**).
* **`trBlk X Kc rw rm`**: the axis rotation of `TransNeed` as an `RM` block: mark `X`, build the
  rotation descriptor (KFMSE `descTrP`, `w` from `rw`, rotation count from `rm`), run the
  procedure node `trPrc` (KFY2) (**`trBlk_all`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN

/-! ## Brackets -/

/-- Push `l`, run `P`, pop `l`. -/
def brk (l : List (Fin HS × Ex HS)) (P : RM) : RM :=
  .seq (.rs (NLogN.KFY.pushL l)) (.seq P (.rs (popL (l.map Prod.fst))))

/-- The cost of a bracket around a program of cost `C`. -/
def brkC (n K B C : ℕ) : ℕ := n * ((K + 1) * 10 ^ 7 * (B + 2) ^ 2) + 1 + C + (n * (2 * B + 2) + 1)

/-! ## The rotation block -/

open NLogN.KFM in
/-- Mark `X`, build the rotation descriptor on `X`, rotate. -/
noncomputable def trBlk (X : Fin HS) (Kc : ℝ) (rw rm : Fin HS) : RM :=
  .seq (.op (.mark X)) (.seq (.rs (descTrP X rw rm)) (trPrc X Kc))

end NLogN.KFY

end

