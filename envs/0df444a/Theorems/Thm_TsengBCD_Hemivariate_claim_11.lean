-- title:
--   Proof of Proposition 5.1, pp. 485–487, claim (10) ⇒ (11) — if x^r → z along ℛ, then x^{r+1} → z along ℛ
-- statement:
--   Let $f=f_0+\sum_{k=1}^N f_k$ satisfy Assumptions B1–B3 and either C1 or C2, and let $\{x^r\}$ be generated by the BCD method (2)–(3) from $x^0\in\operatorname{dom}f$, with values $\{f(x^r)\}$ that do not decrease to $-\infty$. If $\mathcal R\subseteq\{0,1,\dots\}$ is an infinite index set with
--   $$\{x^r\}_{r\in\mathcal R}\to z,\tag{10}$$
--   then also
--   $$\{x^{r+1}\}_{r\in\mathcal R}\to z.\tag{11}$$
--
--   Consecutive iterates therefore cannot stay apart along a convergent subsequence. This is where the quasiconvexity and hemivariance of $f$ in each block (B2) enter the proof.
--
--   **Formalization Note.** The subsequence $\mathcal R$ is given by a strictly increasing map $\rho:\mathbb N\to\mathbb N$. The block-selection rule plays no role in this claim, so no rule is assumed.
-- source:
--   Tseng, Convergence of a block coordinate descent method for nondifferentiable minimization, J. Optim. Theory Appl. 109 (2001), pp. 485–487, proof of Proposition 5.1, claim (10) ⇒ (11)

import Mathlib
import Definitions.Def_TsengBCD_Hemivariate_Setting

namespace TsengBCD.Hemivariate

open Filter Topology

theorem claim_11 {N : ℕ} [NeZero N] {n : Fin N → ℕ} (f0 : TsengBCD.Stationary.X n → EReal)
    (fk : (k : Fin N) → EuclideanSpace ℝ (Fin (n k)) → EReal)
    (h0bot : ∀ x, f0 x ≠ ⊥) (hkbot : ∀ k y, fk k y ≠ ⊥)
    (hB : AssumptionB f0 fk) (hC : AssumptionC1 f0 ∨ AssumptionC2 f0)
    (s : ℕ → Fin N) (x : ℕ → TsengBCD.Stationary.X n) (hrun : TsengBCD.Stationary.IsBCDRun (TsengBCD.Stationary.fSum f0 fk) s x)
    (hfin : ¬ Tendsto (fun r => TsengBCD.Stationary.fSum f0 fk (x r)) atTop (𝓝 ⊥))
    (ρ : ℕ → ℕ) (hρ : StrictMono ρ) (z : TsengBCD.Stationary.X n)
    (hz : Tendsto (fun m => x (ρ m)) atTop (𝓝 z)) :
    Tendsto (fun m => x (ρ m + 1)) atTop (𝓝 z) := by sorry

end TsengBCD.Hemivariate
