import Mathlib
import Definitions.Def_AvgLMS_Expect_Model

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option warn.classDefReducibility false

open MeasureTheory ProbabilityTheory
open scoped InnerProductSpace RealInnerProductSpace

namespace AvgLMSOR

open AvgLMS.Expect


/-- The σ-algebra generated by the observation pair `(x (j+1), z (j+1))`. -/
noncomputable def obsSig {Ω : Type*} {d : ℕ} (x z : ℕ → Ω → Hs d) (j : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω => (x (j + 1) ω, z (j + 1) ω)) inferInstance

/-- The σ-algebra of the first `k` observation pairs. -/
noncomputable def past {Ω : Type*} {d : ℕ} (x z : ℕ → Ω → Hs d) (k : ℕ) : MeasurableSpace Ω :=
  ⨆ j ∈ {j : ℕ | j < k}, obsSig x z j

/-- The noise driving `η^r` at step `k + 1`. -/
noncomputable def noise {Ω : Type*} {d : ℕ} (γ : ℝ) (H : Hs d →L[ℝ] Hs d) (x z : ℕ → Ω → Hs d)
    (θstar : Hs d) : ℕ → ℕ → Ω → Hs d
  | 0, k => residual x z θstar (k + 1)
  | r + 1, k => fun ω => H (etaR γ H x (residual x z θstar) r k ω) -
      ⟪x (k + 1) ω, etaR γ H x (residual x z θstar) r k ω⟫_ℝ • x (k + 1) ω

theorem eta_succ {Ω : Type*} {d : ℕ} (γ : ℝ) (H : Hs d →L[ℝ] Hs d) (x z : ℕ → Ω → Hs d)
    (θstar : Hs d) (r k : ℕ) (ω : Ω) :
    etaR γ H x (residual x z θstar) r (k + 1) ω =
      (1 - γ • H) (etaR γ H x (residual x z θstar) r k ω) + γ • noise γ H x z θstar r k ω := by
  cases r <;> rfl

theorem eta_zero {Ω : Type*} {d : ℕ} (γ : ℝ) (H : Hs d →L[ℝ] Hs d) (x z : ℕ → Ω → Hs d)
    (θstar : Hs d) (r : ℕ) (ω : Ω) : etaR γ H x (residual x z θstar) r 0 ω = 0 := by
  cases r <;> rfl

theorem meas0 {Ω' : Type*} [m : MeasurableSpace Ω'] {d : ℕ} (H : Hs d →L[ℝ] Hs d) (γ : ℝ)
    (f g : Ω' → Hs d) (hf : Measurable f) (hg : Measurable g) :
    Measurable fun ω => (1 - γ • H) (f ω) + γ • g ω :=
  (Continuous.measurable (by fun_prop :
    Continuous fun p : Hs d × Hs d => (1 - γ • H) p.1 + γ • p.2)).comp (hf.prodMk hg)

theorem measN {Ω' : Type*} [m : MeasurableSpace Ω'] {d : ℕ} (H : Hs d →L[ℝ] Hs d)
    (g y : Ω' → Hs d) (hg : Measurable g) (hy : Measurable y) :
    Measurable fun ω => H (g ω) - ⟪y ω, g ω⟫_ℝ • y ω :=
  (Continuous.measurable (by fun_prop :
    Continuous fun p : Hs d × Hs d => H p.1 - ⟪p.2, p.1⟫_ℝ • p.2)).comp (hg.prodMk hy)

theorem meas1 {Ω' : Type*} [m : MeasurableSpace Ω'] {d : ℕ} (H : Hs d →L[ℝ] Hs d) (γ : ℝ)
    (f g y : Ω' → Hs d) (hf : Measurable f) (hg : Measurable g) (hy : Measurable y) :
    Measurable fun ω => (1 - γ • H) (f ω) + γ • (H (g ω) - ⟪y ω, g ω⟫_ℝ • y ω) :=
  (Continuous.measurable (by fun_prop :
    Continuous fun p : Hs d × Hs d × Hs d =>
      (1 - γ • H) p.1 + γ • (H p.2.1 - ⟪p.2.2, p.2.1⟫_ℝ • p.2.2))).comp
    (hf.prodMk (hg.prodMk hy))

theorem measR {Ω' : Type*} [m : MeasurableSpace Ω'] {d : ℕ} (θ : Hs d)
    (f g : Ω' → Hs d) (hf : Measurable f) (hg : Measurable g) :
    Measurable fun ω => g ω - ⟪θ, f ω⟫_ℝ • f ω :=
  (Continuous.measurable (by fun_prop :
    Continuous fun p : Hs d × Hs d => p.2 - ⟪θ, p.1⟫_ℝ • p.1)).comp (hf.prodMk hg)

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {d : ℕ}
    {x z : ℕ → Ω → Hs d} {H : Hs d →L[ℝ] Hs d} {θstar : Hs d} {R σ : ℝ}

theorem q_eq (hA : LMSAssumptions μ x z H θstar R σ) (v : Hs d) :
    ⟪v, H v⟫_ℝ = ∫ ω, ⟪x 1 ω, v⟫_ℝ ^ 2 ∂μ := by
  rw [hA.cov_eq v v]; congr 1; funext ω; ring

theorem q_nonneg (hA : LMSAssumptions μ x z H θstar R σ) (v : Hs d) : 0 ≤ ⟪v, H v⟫_ℝ := by
  rw [q_eq hA]; exact integral_nonneg fun _ => sq_nonneg _

theorem int_sq (hA : LMSAssumptions μ x z H θstar R σ) (v : Hs d) :
    Integrable (fun ω => ⟪x 1 ω, v⟫_ℝ ^ 2) μ :=
  (hA.integrable_cov v v).congr (Filter.Eventually.of_forall fun ω => by dsimp only; ring)

theorem symm (hA : LMSAssumptions μ x z H θstar R σ) (v w : Hs d) :
    ⟪H v, w⟫_ℝ = ⟪v, H w⟫_ℝ := by
  rw [real_inner_comm, hA.cov_eq w v, hA.cov_eq v w]; congr 1; funext ω; ring

theorem normH_sq [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (v : Hs d) :
    ‖H v‖ ^ 2 ≤ R ^ 2 * ⟪v, H v⟫_ℝ := by
  have e : ‖H v‖ ^ 2 = ∫ ω, ⟪x 1 ω, H v⟫_ℝ * ⟪x 1 ω, v⟫_ℝ ∂μ := by
    rw [← hA.cov_eq (H v) v, real_inner_self_eq_norm_sq]
  have hpt : ∀ ω, ⟪x 1 ω, H v⟫_ℝ * ⟪x 1 ω, v⟫_ℝ ≤
      (‖x 1 ω‖ ^ 2 * ⟪x 1 ω, v⟫_ℝ ^ 2 + ‖H v‖ ^ 2) / 2 := by
    intro ω
    set a := ⟪x 1 ω, H v⟫_ℝ
    set b := ⟪x 1 ω, v⟫_ℝ
    have h1 : a * b ≤ |a| * |b| := by rw [← abs_mul]; exact le_abs_self _
    have h2 : |a| * |b| ≤ ‖x 1 ω‖ * ‖H v‖ * |b| :=
      mul_le_mul_of_nonneg_right (abs_real_inner_le_norm _ _) (abs_nonneg _)
    have h3 : ‖x 1 ω‖ * ‖H v‖ * |b| ≤ (‖x 1 ω‖ ^ 2 * b ^ 2 + ‖H v‖ ^ 2) / 2 := by
      nlinarith [sq_nonneg (‖x 1 ω‖ * |b| - ‖H v‖), sq_abs b]
    linarith
  have hi : Integrable (fun ω => (‖x 1 ω‖ ^ 2 * ⟪x 1 ω, v⟫_ℝ ^ 2 + ‖H v‖ ^ 2) / 2) μ :=
    ((hA.integrable_fourth v).add (integrable_const _)).div_const 2
  have hle := integral_mono (hA.integrable_cov (H v) v) hi hpt
  rw [← e, integral_div, integral_add (hA.integrable_fourth v) (integrable_const _),
    integral_const] at hle
  simp only [probReal_univ, one_smul] at hle
  have h4 := hA.fourth_le v
  linarith

theorem M_apply (γ : ℝ) (v : Hs d) : (1 - γ • H) v = v - γ • H v := by simp

theorem inner_M (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ) (a v : Hs d) :
    ⟪(1 - γ • H) a, v⟫_ℝ = ⟪a, (1 - γ • H) v⟫_ℝ := by
  rw [M_apply, M_apply, inner_sub_left, inner_sub_right, real_inner_smul_left,
    real_inner_smul_right, symm hA]

theorem normM [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ)
    (hγ0 : 0 < γ) (hγR : γ * R ^ 2 ≤ 1) (v : Hs d) :
    ‖(1 - γ • H) v‖ ^ 2 + γ * ⟪v, H v⟫_ℝ ≤ ‖v‖ ^ 2 := by
  rw [M_apply, norm_sub_sq_real, real_inner_smul_right, norm_smul, mul_pow, Real.norm_eq_abs,
    sq_abs]
  have h1 := normH_sq hA v
  have h2 := q_nonneg hA v
  have : γ ^ 2 * ‖H v‖ ^ 2 ≤ γ * ⟪v, H v⟫_ℝ := by
    calc γ ^ 2 * ‖H v‖ ^ 2 ≤ γ ^ 2 * (R ^ 2 * ⟪v, H v⟫_ℝ) := by gcongr
      _ = γ * (γ * R ^ 2) * ⟪v, H v⟫_ℝ := by ring
      _ ≤ γ * 1 * ⟪v, H v⟫_ℝ := by gcongr
      _ = _ := by ring
  linarith

theorem obj_formula [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (θ : Hs d) :
    lsObjective μ x z θ = (1 / 2) * ⟪θ, H θ⟫_ℝ - ⟪θ, ∫ ω, z 1 ω ∂μ⟫_ℝ := by
  have hz : Integrable (z 1) μ := hA.memLp_z.integrable (by norm_num)
  have h1 : Integrable (fun ω => ⟪θ, x 1 ω⟫_ℝ ^ 2) μ := by
    refine (hA.integrable_cov θ θ).congr (Filter.Eventually.of_forall fun ω => ?_)
    simp only [real_inner_comm θ (x 1 ω)]; ring
  have h2 : Integrable (fun ω => 2 * ⟪θ, z 1 ω⟫_ℝ) μ := (hz.inner_const θ |>.congr
    (Filter.Eventually.of_forall fun ω => by simp [real_inner_comm])).const_mul 2
  unfold lsObjective
  rw [integral_sub h1 h2, integral_const_mul, ← integral_inner hz, hA.cov_eq θ θ]
  have : ∫ ω, ⟪θ, x 1 ω⟫_ℝ ^ 2 ∂μ = ∫ ω, ⟪x 1 ω, θ⟫_ℝ * ⟪x 1 ω, θ⟫_ℝ ∂μ := by
    congr 1; funext ω; rw [real_inner_comm θ (x 1 ω)]; ring
  rw [this]; ring

theorem grad [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (v : Hs d) :
    ⟪v, H θstar⟫_ℝ = ⟪v, ∫ ω, z 1 ω ∂μ⟫_ℝ := by
  set b : Hs d := ∫ ω, z 1 ω ∂μ with hb
  have hf : ∀ θ, lsObjective μ x z θ = (1 / 2) * ⟪θ, H θ⟫_ℝ - ⟪θ, b⟫_ℝ := obj_formula hA
  have hsymm : ∀ v w : Hs d, ⟪v, H w⟫_ℝ = ⟪w, H v⟫_ℝ := by
    intro v w; rw [hA.cov_eq v w, hA.cov_eq w v]; congr 1; funext ω; ring
  have key : ∀ t : ℝ, 0 ≤ t * (⟪v, H θstar⟫_ℝ - ⟪v, b⟫_ℝ) + t ^ 2 / 2 * ⟪v, H v⟫_ℝ := by
    intro t
    have h := hA.isMin (θstar + t • v)
    rw [hf, hf] at h
    simp only [map_add, map_smul, inner_add_left, inner_add_right, inner_smul_left,
      inner_smul_right, RCLike.conj_to_real] at h
    rw [hsymm θstar v] at h
    nlinarith
  set c := ⟪v, H θstar⟫_ℝ - ⟪v, b⟫_ℝ
  set a := ⟪v, H v⟫_ℝ
  have ha := q_nonneg hA v
  have hk := key (-c / (a + 1))
  have ha1 : 0 < a + 1 := by linarith
  have e : -c / (a + 1) * c + (-c / (a + 1)) ^ 2 / 2 * a
      = c ^ 2 / (a + 1) * (a / (2 * (a + 1)) - 1) := by field_simp; ring
  rw [e] at hk
  have hneg : a / (2 * (a + 1)) - 1 < 0 := by
    rw [sub_neg, div_lt_one (by linarith)]; linarith
  have hc : c = 0 := by
    by_contra hcon
    have hcon' : 0 < c ^ 2 := by positivity
    have : 0 < c ^ 2 / (a + 1) := div_pos hcon' ha1
    nlinarith
  linarith

theorem resid_mean [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (u : Hs d) :
    ∫ ω, ⟪residual x z θstar 1 ω, u⟫_ℝ ∂μ = 0 := by
  have hz : Integrable (z 1) μ := hA.memLp_z.integrable (by norm_num)
  have e : (fun ω => ⟪residual x z θstar 1 ω, u⟫_ℝ) =
      fun ω => ⟪u, z 1 ω⟫_ℝ - ⟪x 1 ω, u⟫_ℝ * ⟪x 1 ω, θstar⟫_ℝ := by
    funext ω
    simp only [AvgLMS.Expect.residual, inner_sub_left, real_inner_smul_left]
    rw [real_inner_comm u, real_inner_comm θstar]; ring
  rw [e, integral_sub (hz.const_inner u) (hA.integrable_cov u θstar), integral_inner hz,
    ← hA.cov_eq u θstar, grad hA u, sub_self]

theorem x_meas_obs (k : ℕ) : Measurable[obsSig x z k] (x (k + 1)) :=
  measurable_fst.comp (comap_measurable (fun ω => (x (k + 1) ω, z (k + 1) ω)))

theorem z_meas_obs (k : ℕ) : Measurable[obsSig x z k] (z (k + 1)) :=
  measurable_snd.comp (comap_measurable (fun ω => (x (k + 1) ω, z (k + 1) ω)))

theorem obs_le_past {j k : ℕ} (h : j < k) : obsSig x z j ≤ past x z k :=
  le_iSup₂ (f := fun j (_ : j ∈ {j : ℕ | j < k}) => obsSig x z j) j h

theorem past_mono (k : ℕ) : past x z k ≤ past x z (k + 1) :=
  iSup₂_le fun j hj => obs_le_past (Nat.lt_succ_of_lt hj)

theorem obs_le (hA : LMSAssumptions μ x z H θstar R σ) (j : ℕ) :
    obsSig x z j ≤ ‹MeasurableSpace Ω› :=
  ((hA.measurable_x (j + 1)).prodMk (hA.measurable_z (j + 1))).comap_le

theorem past_le (hA : LMSAssumptions μ x z H θstar R σ) (k : ℕ) :
    past x z k ≤ ‹MeasurableSpace Ω› :=
  iSup₂_le fun j _ => obs_le hA j

theorem resid_meas_obs (k : ℕ) : Measurable[obsSig x z k] (residual x z θstar (k + 1)) :=
  measR (m := obsSig x z k) θstar _ _ (x_meas_obs k) (z_meas_obs k)

theorem eta_meas_past (γ : ℝ) :
    ∀ r n, Measurable[past x z n] (etaR γ H x (residual x z θstar) r n)
  | 0, 0 => measurable_const
  | 0, n + 1 => by
      have h1 := (eta_meas_past γ 0 n).mono
        (past_mono n) le_rfl
      have h2 : Measurable[past x z (n + 1)] (residual x z θstar (n + 1)) :=
        (resid_meas_obs n).mono (obs_le_past (Nat.lt_succ_self n)) le_rfl
      exact meas0 (m := past x z (n + 1)) H γ _ _ h1 h2
  | r + 1, 0 => measurable_const
  | r + 1, n + 1 => by
      have h1 := (eta_meas_past γ (r + 1) n).mono
        (past_mono n) le_rfl
      have h2 := (eta_meas_past γ r n).mono (past_mono n) le_rfl
      have h3 : Measurable[past x z (n + 1)] (x (n + 1)) :=
        (x_meas_obs n).mono (obs_le_past (Nat.lt_succ_self n)) le_rfl
      exact meas1 (m := past x z (n + 1)) H γ _ _ _ h1 h2 h3

theorem noise_meas_past (γ : ℝ) (r k : ℕ) :
    Measurable[past x z (k + 1)] (noise γ H x z θstar r k) := by
  cases r with
  | zero => exact (resid_meas_obs k).mono (obs_le_past (Nat.lt_succ_self k)) le_rfl
  | succ r =>
      have h2 := (eta_meas_past (H := H) (x := x) (z := z) (θstar := θstar) γ r k).mono
        (past_mono k) le_rfl
      have h3 : Measurable[past x z (k + 1)] (x (k + 1)) :=
        (x_meas_obs k).mono (obs_le_past (Nat.lt_succ_self k)) le_rfl
      exact measN (m := past x z (k + 1)) H _ _ h2 h3

theorem indep_past [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (k : ℕ) :
    Indep (past x z k) (obsSig x z k) μ := by
  have hind : iIndep (obsSig x z) μ := (iIndepFun_iff_iIndep _ _ μ).1 hA.indep
  have hI := indep_iSup_of_disjoint (obs_le hA) hind (S := {j : ℕ | j < k}) (T := {k})
    (Set.disjoint_singleton_right.2 (lt_irrefl k))
  refine indep_of_indep_of_le_right hI ?_
  exact le_iSup₂ (f := fun j (_ : j ∈ ({k} : Set ℕ)) => obsSig x z j) k rfl

theorem indepFun_past [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (k : ℕ)
    {β δ : Type*} [MeasurableSpace β] [MeasurableSpace δ] (f : Ω → β) (g : Ω → δ)
    (hf : Measurable[past x z k] f) (hg : Measurable[obsSig x z k] g) : IndepFun f g μ := by
  rw [IndepFun_iff_Indep]
  exact indep_of_indep_of_le_right (indep_of_indep_of_le_left (indep_past hA k) hf.comap_le)
    hg.comap_le

theorem int_mul {f g : Ω → ℝ} (hf : AEStronglyMeasurable f μ) (hg : AEStronglyMeasurable g μ)
    (hf2 : Integrable (fun ω => f ω ^ 2) μ) (hg2 : Integrable (fun ω => g ω ^ 2) μ) :
    Integrable (fun ω => f ω * g ω) μ := by
  have hb : Integrable (fun ω => (f ω ^ 2 + g ω ^ 2) / 2) μ := (hf2.add hg2).div_const 2
  refine hb.mono' (hf.mul hg) (Filter.Eventually.of_forall fun ω => ?_)
  rw [Real.norm_eq_abs, abs_mul]
  nlinarith [sq_abs (f ω), sq_abs (g ω), sq_nonneg (|f ω| - |g ω|)]

theorem int_sq_add {f g : Ω → ℝ} (hf : AEStronglyMeasurable f μ) (hg : AEStronglyMeasurable g μ)
    (hf2 : Integrable (fun ω => f ω ^ 2) μ) (hg2 : Integrable (fun ω => g ω ^ 2) μ) (c : ℝ) :
    Integrable (fun ω => (f ω + c * g ω) ^ 2) μ := by
  have e : (fun ω => (f ω + c * g ω) ^ 2) =
      fun ω => f ω ^ 2 + (2 * c) * (f ω * g ω) + c ^ 2 * g ω ^ 2 := by funext ω; ring
  rw [e]
  exact (hf2.add ((int_mul hf hg hf2 hg2).const_mul _)).add (hg2.const_mul _)

theorem ident_resid [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (k : ℕ)
    (g : Hs d → ℝ) (hg : Continuous g) :
    (Integrable (fun ω => g (residual x z θstar (k + 1) ω)) μ ↔
      Integrable (fun ω => g (residual x z θstar 1 ω)) μ) ∧
    ∫ ω, g (residual x z θstar (k + 1) ω) ∂μ = ∫ ω, g (residual x z θstar 1 ω) ∂μ := by
  have hc : Measurable (fun p : Hs d × Hs d => g (p.2 - ⟪θstar, p.1⟫_ℝ • p.1)) :=
    (hg.comp (by fun_prop)).measurable
  have h := (hA.identDistrib k).comp hc
  exact ⟨h.integrable_iff, h.integral_eq⟩

theorem noise0_bound [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ)
    (k : ℕ) (u : Hs d) :
    Integrable (fun ω => ⟪noise γ H x z θstar 0 k ω, u⟫_ℝ ^ 2) μ ∧
    ∫ ω, ⟪noise γ H x z θstar 0 k ω, u⟫_ℝ ^ 2 ∂μ ≤ σ ^ 2 * ⟪u, H u⟫_ℝ := by
  obtain ⟨h1, h2⟩ := ident_resid hA k (fun w => ⟪w, u⟫_ℝ ^ 2) (by fun_prop)
  exact ⟨h1.2 (hA.integrable_noise u), h2.trans_le (hA.noise_le u)⟩

theorem noise0_mean [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ)
    (k : ℕ) (u : Hs d) : ∫ ω, ⟪noise γ H x z θstar 0 k ω, u⟫_ℝ ∂μ = 0 := by
  obtain ⟨_, h2⟩ := ident_resid hA k (fun w => ⟪w, u⟫_ℝ) (by fun_prop)
  exact h2.trans (resid_mean hA u)

theorem orth0 [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ)
    (k : ℕ) (u : Hs d) (Y : Ω → ℝ) (hY : Measurable[past x z k] Y) :
    ∫ ω, Y ω * ⟪noise γ H x z θstar 0 k ω, u⟫_ℝ ∂μ = 0 := by
  have hg : Measurable[obsSig x z k] (fun ω => ⟪noise γ H x z θstar 0 k ω, u⟫_ℝ) :=
    (Continuous.measurable (by fun_prop : Continuous fun w : Hs d => ⟪w, u⟫_ℝ)).comp
      (resid_meas_obs k)
  have hI := indepFun_past hA k Y _ hY hg
  rw [hI.integral_fun_mul_eq_mul_integral (hY.mono (past_le hA k) le_rfl).aestronglyMeasurable
    (hg.mono (obs_le hA k) le_rfl).aestronglyMeasurable, noise0_mean hA γ k u, mul_zero]

theorem orthS [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ)
    (r k : ℕ) (u : Hs d) (Y : Ω → ℝ) (hY : Measurable[past x z k] Y)
    (hint : Integrable (fun ω => Y ω * ⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ) μ) :
    ∫ ω, Y ω * ⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ ∂μ = 0 := by
  set η := etaR γ H x (residual x z θstar) r k with hη
  have hηp : Measurable[past x z k] η := eta_meas_past (H := H) (x := x) (z := z) γ r k
  have hWp : Measurable[past x z k] (fun ω => (Y ω, η ω)) := hY.prodMk hηp
  have hW : Measurable (fun ω => (Y ω, η ω)) := hWp.mono (past_le hA k) le_rfl
  have hX : Measurable (x (k + 1)) := hA.measurable_x (k + 1)
  have hI : IndepFun (fun ω => (Y ω, η ω)) (x (k + 1)) μ :=
    indepFun_past hA k _ _ hWp (x_meas_obs k)
  let F : (ℝ × Hs d) × Hs d → ℝ := fun q =>
    q.1.1 * (⟪H q.1.2, u⟫_ℝ - ⟪q.2, q.1.2⟫_ℝ * ⟪q.2, u⟫_ℝ)
  have hF : Continuous F := by fun_prop
  have hfun : (fun ω => Y ω * ⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ) =
      fun ω => F ((Y ω, η ω), x (k + 1) ω) := by
    funext ω
    show Y ω * ⟪H (η ω) - ⟪x (k + 1) ω, η ω⟫_ℝ • x (k + 1) ω, u⟫_ℝ = _
    simp only [F, inner_sub_left, real_inner_smul_left]
  have hmap : μ.map (x (k + 1)) = μ.map (x 1) :=
    ((hA.identDistrib k).comp measurable_fst).map_eq
  have hprod := hI.map_prod_eq_prod_map_map hW.aemeasurable hX.aemeasurable
  rw [hfun] at hint ⊢
  have hint' : Integrable F (μ.map fun ω => ((Y ω, η ω), x (k + 1) ω)) :=
    (integrable_map_measure hF.aestronglyMeasurable (hW.prodMk hX).aemeasurable).2 hint
  rw [← integral_map (hW.prodMk hX).aemeasurable hF.aestronglyMeasurable]
  rw [hprod] at hint' ⊢
  rw [integral_prod F hint', hmap]
  have hinner : ∀ w : ℝ × Hs d, ∫ y, F (w, y) ∂(μ.map (x 1)) = 0 := by
    intro w
    have hFw : AEStronglyMeasurable (fun y : Hs d => F (w, y)) (μ.map (x 1)) :=
      (hF.comp (by fun_prop : Continuous fun y : Hs d => (w, y))).aestronglyMeasurable
    rw [integral_map (hA.measurable_x 1).aemeasurable hFw]
    simp only [F]
    rw [integral_const_mul, integral_sub (integrable_const _) (hA.integrable_cov w.2 u),
      integral_const, ← hA.cov_eq w.2 u, symm hA]
    simp
  simp only [hinner, integral_zero]

theorem noiseS_bound [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ)
    (r k : ℕ) (c : ℝ) (hc : 0 ≤ c)
    (hη : ∀ v : Hs d, Integrable (fun ω => ⟪etaR γ H x (residual x z θstar) r k ω, v⟫_ℝ ^ 2) μ ∧
      ∫ ω, ⟪etaR γ H x (residual x z θstar) r k ω, v⟫_ℝ ^ 2 ∂μ ≤ c * ‖v‖ ^ 2) (u : Hs d) :
    Integrable (fun ω => ⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ ^ 2) μ ∧
    ∫ ω, ⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ ^ 2 ∂μ ≤ c * R ^ 2 * ⟪u, H u⟫_ℝ := by
  set η := etaR γ H x (residual x z θstar) r k with hη_def
  have hηm : Measurable η :=
    (eta_meas_past (H := H) (x := x) (z := z) (θstar := θstar) γ r k).mono (past_le hA k) le_rfl
  have hX : Measurable (x (k + 1)) := hA.measurable_x (k + 1)
  have hI : IndepFun η (x (k + 1)) μ :=
    indepFun_past hA k _ _ (eta_meas_past (H := H) (x := x) (z := z) (θstar := θstar) γ r k)
      (x_meas_obs k)
  have hmap : μ.map (x (k + 1)) = μ.map (x 1) :=
    ((hA.identDistrib k).comp measurable_fst).map_eq
  let G : Hs d × Hs d → ℝ := fun p => (⟪H p.1, u⟫_ℝ - ⟪p.2, p.1⟫_ℝ * ⟪p.2, u⟫_ℝ) ^ 2
  have hG : Continuous G := by fun_prop
  have hfun : ∀ ω, ⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ ^ 2 = G (η ω, x (k + 1) ω) := by
    intro ω
    show ⟪H (η ω) - ⟪x (k + 1) ω, η ω⟫_ℝ • x (k + 1) ω, u⟫_ℝ ^ 2 = _
    simp only [G, inner_sub_left, real_inner_smul_left]
  have hin : ∀ a : Hs d, ∫⁻ y, ENNReal.ofReal (G (a, y)) ∂(μ.map (x 1)) ≤
      ∫⁻ y, ENNReal.ofReal (⟪y, a⟫_ℝ ^ 2 * ⟪y, u⟫_ℝ ^ 2) ∂(μ.map (x 1)) := by
    intro a
    have hB : Integrable (fun ω => ⟪x 1 ω, a⟫_ℝ ^ 2 * ⟪x 1 ω, u⟫_ℝ ^ 2) μ := by
      refine ((hA.integrable_fourth u).const_mul (‖a‖ ^ 2)).mono' ?_ ?_
      · exact ((((hA.measurable_x 1).inner measurable_const).pow_const 2).mul
          (((hA.measurable_x 1).inner measurable_const).pow_const 2)).aestronglyMeasurable
      · refine Filter.Eventually.of_forall fun ω => ?_
        rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        have h0 := abs_real_inner_le_norm (x 1 ω) a
        have h1 : ⟪x 1 ω, a⟫_ℝ ^ 2 ≤ ‖x 1 ω‖ ^ 2 * ‖a‖ ^ 2 := by
          rw [← mul_pow, ← sq_abs]
          exact pow_le_pow_left₀ (abs_nonneg _) h0 2
        calc ⟪x 1 ω, a⟫_ℝ ^ 2 * ⟪x 1 ω, u⟫_ℝ ^ 2
            ≤ (‖x 1 ω‖ ^ 2 * ‖a‖ ^ 2) * ⟪x 1 ω, u⟫_ℝ ^ 2 := by gcongr
          _ = ‖a‖ ^ 2 * (‖x 1 ω‖ ^ 2 * ⟪x 1 ω, u⟫_ℝ ^ 2) := by ring
    have hBm : Integrable (fun ω => ⟪x 1 ω, a⟫_ℝ * ⟪x 1 ω, u⟫_ℝ) μ := hA.integrable_cov a u
    have e1 : (fun ω => G (a, x 1 ω)) = fun ω => ⟪x 1 ω, a⟫_ℝ ^ 2 * ⟪x 1 ω, u⟫_ℝ ^ 2 -
        ((2 * ⟪H a, u⟫_ℝ) * (⟪x 1 ω, a⟫_ℝ * ⟪x 1 ω, u⟫_ℝ) - ⟪H a, u⟫_ℝ ^ 2) := by
      funext ω; simp only [G]; ring
    have hC1 : Integrable (fun ω => (2 * ⟪H a, u⟫_ℝ) * (⟪x 1 ω, a⟫_ℝ * ⟪x 1 ω, u⟫_ℝ)) μ :=
      hBm.const_mul (2 * ⟪H a, u⟫_ℝ)
    have hC2 : Integrable (fun ω => (2 * ⟪H a, u⟫_ℝ) * (⟪x 1 ω, a⟫_ℝ * ⟪x 1 ω, u⟫_ℝ) -
        ⟪H a, u⟫_ℝ ^ 2) μ := hC1.sub (integrable_const _)
    have hGi : Integrable (fun ω => G (a, x 1 ω)) μ := by
      rw [e1]; exact hB.sub hC2
    have hGm : Measurable fun y : Hs d => ENNReal.ofReal (G (a, y)) :=
      ENNReal.measurable_ofReal.comp (hG.comp (by fun_prop)).measurable
    have hBm' : Measurable fun y : Hs d => ENNReal.ofReal (⟪y, a⟫_ℝ ^ 2 * ⟪y, u⟫_ℝ ^ 2) :=
      ENNReal.measurable_ofReal.comp (Continuous.measurable (by fun_prop))
    rw [lintegral_map hGm (hA.measurable_x 1), lintegral_map hBm' (hA.measurable_x 1),
      ← ofReal_integral_eq_lintegral_ofReal hGi (Filter.Eventually.of_forall fun ω => sq_nonneg _),
      ← ofReal_integral_eq_lintegral_ofReal hB
        (Filter.Eventually.of_forall fun ω => by positivity)]
    apply ENNReal.ofReal_le_ofReal
    rw [e1, integral_sub hB hC2, integral_sub hC1 (integrable_const _), integral_const_mul,
      ← hA.cov_eq a u,
      integral_const]
    simp only [probReal_univ, one_smul]
    rw [symm hA]
    nlinarith [sq_nonneg ⟪a, H u⟫_ℝ]
  have hΦm : Measurable fun p : Hs d × Hs d => ENNReal.ofReal (G p) :=
    ENNReal.measurable_ofReal.comp hG.measurable
  have hK : Measurable fun p : Hs d × Hs d =>
      ENNReal.ofReal (⟪p.2, p.1⟫_ℝ ^ 2 * ⟪p.2, u⟫_ℝ ^ 2) :=
    ENNReal.measurable_ofReal.comp (Continuous.measurable (by fun_prop))
  have hlin : ∫⁻ ω, ENNReal.ofReal (⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ ^ 2) ∂μ ≤
      ENNReal.ofReal (c * R ^ 2 * ⟪u, H u⟫_ℝ) := by
    calc _ = ∫⁻ ω, ENNReal.ofReal (G (η ω, x (k + 1) ω)) ∂μ := by simp only [hfun]
      _ = ∫⁻ p, ENNReal.ofReal (G p) ∂(μ.map fun ω => (η ω, x (k + 1) ω)) :=
          (lintegral_map hΦm (hηm.prodMk hX)).symm
      _ = ∫⁻ a, ∫⁻ y, ENNReal.ofReal (G (a, y)) ∂(μ.map (x 1)) ∂(μ.map η) := by
          rw [hI.map_prod_eq_prod_map_map hηm.aemeasurable hX.aemeasurable,
            lintegral_prod _ hΦm.aemeasurable, hmap]
      _ ≤ ∫⁻ a, ∫⁻ y, ENNReal.ofReal (⟪y, a⟫_ℝ ^ 2 * ⟪y, u⟫_ℝ ^ 2) ∂(μ.map (x 1)) ∂(μ.map η) :=
          lintegral_mono fun a => hin a
      _ = ∫⁻ y, ∫⁻ a, ENNReal.ofReal (⟪y, a⟫_ℝ ^ 2 * ⟪y, u⟫_ℝ ^ 2) ∂(μ.map η) ∂(μ.map (x 1)) :=
          lintegral_lintegral_swap hK.aemeasurable
      _ ≤ ∫⁻ y, ENNReal.ofReal (c * (‖y‖ ^ 2 * ⟪y, u⟫_ℝ ^ 2)) ∂(μ.map (x 1)) := by
          refine lintegral_mono fun y => ?_
          have hm : Measurable fun a : Hs d => ENNReal.ofReal (⟪y, a⟫_ℝ ^ 2 * ⟪y, u⟫_ℝ ^ 2) :=
            ENNReal.measurable_ofReal.comp (Continuous.measurable (by fun_prop))
          rw [lintegral_map hm hηm]
          obtain ⟨hi, hle⟩ := hη y
          have e : (fun ω => ENNReal.ofReal (⟪y, η ω⟫_ℝ ^ 2 * ⟪y, u⟫_ℝ ^ 2)) =
              fun ω => ENNReal.ofReal (⟪y, u⟫_ℝ ^ 2) * ENNReal.ofReal (⟪η ω, y⟫_ℝ ^ 2) := by
            funext ω
            rw [real_inner_comm (η ω) y, ENNReal.ofReal_mul (sq_nonneg _)]
            exact mul_comm _ _
          rw [e, lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
            ← ofReal_integral_eq_lintegral_ofReal hi
              (Filter.Eventually.of_forall fun ω => sq_nonneg _),
            ← ENNReal.ofReal_mul (sq_nonneg _)]
          apply ENNReal.ofReal_le_ofReal
          calc ⟪y, u⟫_ℝ ^ 2 * ∫ ω, ⟪η ω, y⟫_ℝ ^ 2 ∂μ ≤ ⟪y, u⟫_ℝ ^ 2 * (c * ‖y‖ ^ 2) := by
                gcongr
            _ = _ := by ring
      _ = ENNReal.ofReal (∫ ω, c * (‖x 1 ω‖ ^ 2 * ⟪x 1 ω, u⟫_ℝ ^ 2) ∂μ) := by
          have hm2 : Measurable fun y : Hs d => ENNReal.ofReal (c * (‖y‖ ^ 2 * ⟪y, u⟫_ℝ ^ 2)) :=
            ENNReal.measurable_ofReal.comp (Continuous.measurable (by fun_prop))
          rw [lintegral_map hm2 (hA.measurable_x 1),
            ofReal_integral_eq_lintegral_ofReal ((hA.integrable_fourth u).const_mul c)
              (Filter.Eventually.of_forall fun ω => by positivity)]
      _ ≤ ENNReal.ofReal (c * R ^ 2 * ⟪u, H u⟫_ℝ) := by
          apply ENNReal.ofReal_le_ofReal
          rw [integral_const_mul]
          calc c * ∫ ω, ‖x 1 ω‖ ^ 2 * ⟪x 1 ω, u⟫_ℝ ^ 2 ∂μ ≤ c * (R ^ 2 * ⟪u, H u⟫_ℝ) := by
                gcongr; exact hA.fourth_le u
            _ = _ := by ring
  have hNm : Measurable fun ω => ⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ ^ 2 :=
    (((noise_meas_past (H := H) (x := x) (z := z) (θstar := θstar) γ (r + 1) k).mono
      (past_le hA (k + 1)) le_rfl).inner measurable_const).pow_const 2
  have hfin : ∫⁻ ω, ENNReal.ofReal (⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ ^ 2) ∂μ < ⊤ :=
    lt_of_le_of_lt hlin ENNReal.ofReal_lt_top
  refine ⟨⟨hNm.aestronglyMeasurable,
    (hasFiniteIntegral_iff_ofReal (Filter.Eventually.of_forall fun ω => sq_nonneg _)).2 hfin⟩, ?_⟩
  rw [integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun ω => sq_nonneg _)
    hNm.aestronglyMeasurable]
  exact ENNReal.toReal_le_of_le_ofReal
    (mul_nonneg (mul_nonneg hc (sq_nonneg R)) (q_nonneg hA u)) hlin

theorem eta_cov [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ)
    (hγ0 : 0 < γ) (hγR : γ * R ^ 2 ≤ 1) (r : ℕ) (c : ℝ) (hc : 0 ≤ c)
    (hN : ∀ k (u : Hs d), Integrable (fun ω => ⟪noise γ H x z θstar r k ω, u⟫_ℝ ^ 2) μ ∧
      ∫ ω, ⟪noise γ H x z θstar r k ω, u⟫_ℝ ^ 2 ∂μ ≤ c * ⟪u, H u⟫_ℝ)
    (hO : ∀ k (u : Hs d) (Y : Ω → ℝ), Measurable[past x z k] Y →
      Integrable (fun ω => Y ω * ⟪noise γ H x z θstar r k ω, u⟫_ℝ) μ →
      ∫ ω, Y ω * ⟪noise γ H x z θstar r k ω, u⟫_ℝ ∂μ = 0) :
    ∀ n (v : Hs d), Integrable (fun ω => ⟪etaR γ H x (residual x z θstar) r n ω, v⟫_ℝ ^ 2) μ ∧
      ∫ ω, ⟪etaR γ H x (residual x z θstar) r n ω, v⟫_ℝ ^ 2 ∂μ ≤ γ * c * ‖v‖ ^ 2 := by
  intro n
  induction n with
  | zero =>
    intro v
    have e : (fun ω => ⟪etaR γ H x (residual x z θstar) r 0 ω, v⟫_ℝ ^ 2) = fun _ => (0 : ℝ) := by
      funext ω; rw [eta_zero]; simp
    rw [e, integral_zero]
    exact ⟨integrable_const _, mul_nonneg (mul_nonneg hγ0.le hc) (sq_nonneg _)⟩
  | succ n ih =>
    intro v
    set η := etaR γ H x (residual x z θstar) r n with hη_def
    have hηm : Measurable[past x z n] η := eta_meas_past γ r n
    set Mv := (1 - γ • H) v with hMv
    have e : ∀ ω, ⟪etaR γ H x (residual x z θstar) r (n + 1) ω, v⟫_ℝ =
        ⟪η ω, Mv⟫_ℝ + γ * ⟪noise γ H x z θstar r n ω, v⟫_ℝ := by
      intro ω; rw [eta_succ, inner_add_left, inner_M hA, real_inner_smul_left]
    simp only [e]
    obtain ⟨hA2, hAle⟩ := ih Mv
    obtain ⟨hB2, hBle⟩ := hN n v
    have hAm : Measurable fun ω => ⟪η ω, Mv⟫_ℝ :=
      (hηm.mono (past_le hA n) le_rfl).inner measurable_const
    have hBm : Measurable fun ω => ⟪noise γ H x z θstar r n ω, v⟫_ℝ :=
      ((noise_meas_past γ r n).mono (past_le hA (n + 1)) le_rfl).inner measurable_const
    have hAB := int_mul hAm.aestronglyMeasurable hBm.aestronglyMeasurable hA2 hB2
    have hO' := hO n v (fun ω => ⟪η ω, Mv⟫_ℝ)
      ((Continuous.measurable (by fun_prop : Continuous fun w : Hs d => ⟪w, Mv⟫_ℝ)).comp hηm) hAB
    refine ⟨int_sq_add hAm.aestronglyMeasurable hBm.aestronglyMeasurable hA2 hB2 γ, ?_⟩
    have ex : (fun ω => (⟪η ω, Mv⟫_ℝ + γ * ⟪noise γ H x z θstar r n ω, v⟫_ℝ) ^ 2) =
        fun ω => (⟪η ω, Mv⟫_ℝ ^ 2 + (2 * γ) * (⟪η ω, Mv⟫_ℝ * ⟪noise γ H x z θstar r n ω, v⟫_ℝ)) +
          γ ^ 2 * ⟪noise γ H x z θstar r n ω, v⟫_ℝ ^ 2 := by funext ω; ring
    have hc1 : Integrable (fun ω => (2 * γ) *
        (⟪η ω, Mv⟫_ℝ * ⟪noise γ H x z θstar r n ω, v⟫_ℝ)) μ := hAB.const_mul (2 * γ)
    have hc2 : Integrable (fun ω => γ ^ 2 * ⟪noise γ H x z θstar r n ω, v⟫_ℝ ^ 2) μ :=
      hB2.const_mul (γ ^ 2)
    have hc3 : Integrable (fun ω => ⟪η ω, Mv⟫_ℝ ^ 2 + (2 * γ) *
        (⟪η ω, Mv⟫_ℝ * ⟪noise γ H x z θstar r n ω, v⟫_ℝ)) μ := hA2.add hc1
    rw [ex, integral_add hc3 hc2, integral_add hA2 hc1, integral_const_mul, integral_const_mul, hO']
    have hM := normM hA γ hγ0 hγR v
    have h1 := mul_le_mul_of_nonneg_left hBle (sq_nonneg γ)
    have h2 : γ * c * ‖Mv‖ ^ 2 + γ ^ 2 * (c * ⟪v, H v⟫_ℝ) ≤ γ * c * ‖v‖ ^ 2 := by
      have := mul_le_mul_of_nonneg_left hM (mul_nonneg hγ0.le hc)
      calc _ = γ * c * (‖Mv‖ ^ 2 + γ * ⟪v, H v⟫_ℝ) := by ring
        _ ≤ _ := this
    linarith

theorem cnn {γ : ℝ} (hγ : 0 ≤ γ) (r : ℕ) : 0 ≤ γ ^ r * R ^ (2 * r) * σ ^ 2 := by
  have h1 : 0 ≤ R ^ (2 * r) := by rw [pow_mul]; exact pow_nonneg (sq_nonneg R) r
  exact mul_nonneg (mul_nonneg (pow_nonneg hγ r) h1) (sq_nonneg σ)

theorem level [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ)
    (hγ0 : 0 < γ) (hγR : γ * R ^ 2 ≤ 1) : ∀ r : ℕ,
    (∀ k (u : Hs d), Integrable (fun ω => ⟪noise γ H x z θstar r k ω, u⟫_ℝ ^ 2) μ ∧
      ∫ ω, ⟪noise γ H x z θstar r k ω, u⟫_ℝ ^ 2 ∂μ ≤
        γ ^ r * R ^ (2 * r) * σ ^ 2 * ⟪u, H u⟫_ℝ) ∧
    (∀ n (v : Hs d), Integrable (fun ω => ⟪etaR γ H x (residual x z θstar) r n ω, v⟫_ℝ ^ 2) μ ∧
      ∫ ω, ⟪etaR γ H x (residual x z θstar) r n ω, v⟫_ℝ ^ 2 ∂μ ≤
        γ * (γ ^ r * R ^ (2 * r) * σ ^ 2) * ‖v‖ ^ 2)
  | 0 => by
    have hN : ∀ k (u : Hs d), Integrable (fun ω => ⟪noise γ H x z θstar 0 k ω, u⟫_ℝ ^ 2) μ ∧
        ∫ ω, ⟪noise γ H x z θstar 0 k ω, u⟫_ℝ ^ 2 ∂μ ≤
          γ ^ 0 * R ^ (2 * 0) * σ ^ 2 * ⟪u, H u⟫_ℝ := by
      intro k u; simp only [pow_zero, mul_zero, one_mul]; exact noise0_bound hA γ k u
    exact ⟨hN, eta_cov hA γ hγ0 hγR 0 _ (cnn hγ0.le 0) hN
      fun k u Y hY _ => orth0 hA γ k u Y hY⟩
  | r + 1 => by
    obtain ⟨_, hη⟩ := level hA γ hγ0 hγR r
    have hN : ∀ k (u : Hs d), Integrable (fun ω => ⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ ^ 2) μ ∧
        ∫ ω, ⟪noise γ H x z θstar (r + 1) k ω, u⟫_ℝ ^ 2 ∂μ ≤
          γ ^ (r + 1) * R ^ (2 * (r + 1)) * σ ^ 2 * ⟪u, H u⟫_ℝ := by
      intro k u
      have h := noiseS_bound hA γ r k _ (mul_nonneg hγ0.le (cnn hγ0.le r)) (hη k) u
      refine ⟨h.1, h.2.trans_eq ?_⟩
      ring
    exact ⟨hN, eta_cov hA γ hγ0 hγR (r + 1) _ (cnn hγ0.le (r + 1)) hN
      fun k u Y hY hint => orthS hA γ r k u Y hY hint⟩

theorem past_mono' {j k : ℕ} (h : j ≤ k) : past x z j ≤ past x z k :=
  iSup₂_le fun i hi => obs_le_past (lt_of_lt_of_le hi h)

theorem orth_r [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ)
    (r k : ℕ) (u : Hs d) (Y : Ω → ℝ) (hY : Measurable[past x z k] Y)
    (hint : Integrable (fun ω => Y ω * ⟪noise γ H x z θstar r k ω, u⟫_ℝ) μ) :
    ∫ ω, Y ω * ⟪noise γ H x z θstar r k ω, u⟫_ℝ ∂μ = 0 := by
  cases r with
  | zero => exact orth0 hA γ k u Y hY
  | succ r => exact orthS hA γ r k u Y hY hint

theorem orth_sum [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ)
    (s : ℕ → Ω → ℝ) (hsm : ∀ k, Measurable[past x z (k + 1)] (s k))
    (hs2 : ∀ k, Integrable (fun ω => s k ω ^ 2) μ)
    (hO : ∀ k (Y : Ω → ℝ), Measurable[past x z k] Y → Integrable (fun ω => Y ω * s k ω) μ →
      ∫ ω, Y ω * s k ω ∂μ = 0)
    (c : ℕ → ℝ) : ∀ m, Integrable (fun ω => (∑ k ∈ Finset.range m, c k * s k ω) ^ 2) μ ∧
      ∫ ω, (∑ k ∈ Finset.range m, c k * s k ω) ^ 2 ∂μ =
        ∑ k ∈ Finset.range m, c k ^ 2 * ∫ ω, s k ω ^ 2 ∂μ
  | 0 => by simp
  | m + 1 => by
    obtain ⟨ih1, ih2⟩ := orth_sum hA s hsm hs2 hO c m
    have hXm : Measurable[past x z m] (fun ω => ∑ k ∈ Finset.range m, c k * s k ω) :=
      Finset.measurable_sum _ fun k hk =>
        ((hsm k).mono (past_mono' (Finset.mem_range.1 hk)) le_rfl).const_mul _
    have hXm' := hXm.mono (past_le hA m) le_rfl
    have hsm' : Measurable (s m) := (hsm m).mono (past_le hA (m + 1)) le_rfl
    have hXs := int_mul hXm'.aestronglyMeasurable hsm'.aestronglyMeasurable ih1 (hs2 m)
    have h0 := hO m _ hXm hXs
    simp only [Finset.sum_range_succ]
    refine ⟨int_sq_add hXm'.aestronglyMeasurable hsm'.aestronglyMeasurable ih1 (hs2 m) (c m), ?_⟩
    have ex : (fun ω => (∑ k ∈ Finset.range m, c k * s k ω + c m * s m ω) ^ 2) =
        fun ω => ((∑ k ∈ Finset.range m, c k * s k ω) ^ 2 +
          (2 * c m) * ((∑ k ∈ Finset.range m, c k * s k ω) * s m ω)) + c m ^ 2 * s m ω ^ 2 := by
      funext ω; ring
    have hc1 : Integrable (fun ω => (2 * c m) *
        ((∑ k ∈ Finset.range m, c k * s k ω) * s m ω)) μ := hXs.const_mul (2 * c m)
    have hc2 : Integrable (fun ω => c m ^ 2 * s m ω ^ 2) μ := (hs2 m).const_mul (c m ^ 2)
    have hc3 : Integrable (fun ω => (∑ k ∈ Finset.range m, c k * s k ω) ^ 2 + (2 * c m) *
        ((∑ k ∈ Finset.range m, c k * s k ω) * s m ω)) μ := ih1.add hc1
    rw [ex, integral_add hc3 hc2, integral_add ih1 hc1, integral_const_mul, integral_const_mul,
      h0, ih2]
    ring

theorem scalar_ident (ρ γ l : ℝ) (hρ : ρ = 1 - γ * l) (a s : ℕ → ℝ) (ha0 : a 0 = 0)
    (ha : ∀ m, a (m + 1) = ρ * a m + γ * s m) : ∀ m,
    a m = γ * ∑ k ∈ Finset.range m, ρ ^ (m - 1 - k) * s k ∧
    l * ∑ k ∈ Finset.range m, a k = ∑ k ∈ Finset.range m, (1 - ρ ^ (m - 1 - k)) * s k
  | 0 => by simp [ha0]
  | m + 1 => by
    obtain ⟨h1, h2⟩ := scalar_ident ρ γ l hρ a s ha0 ha m
    have hpow : ∀ k ∈ Finset.range m, ρ ^ (m + 1 - 1 - k) = ρ * ρ ^ (m - 1 - k) := by
      intro k hk
      have hk' := Finset.mem_range.1 hk
      rw [show m + 1 - 1 - k = (m - 1 - k) + 1 by omega, pow_succ]; ring
    have e1 : ∑ k ∈ Finset.range m, ρ ^ (m + 1 - 1 - k) * s k =
        ρ * ∑ k ∈ Finset.range m, ρ ^ (m - 1 - k) * s k := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun k hk => by rw [hpow k hk]; ring
    have e2 : ∑ k ∈ Finset.range m, (1 - ρ ^ (m + 1 - 1 - k)) * s k =
        ∑ k ∈ Finset.range m, (1 - ρ ^ (m - 1 - k)) * s k +
          (1 - ρ) * ∑ k ∈ Finset.range m, ρ ^ (m - 1 - k) * s k := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun k hk => by rw [hpow k hk]; ring
    have e0 : m + 1 - 1 - m = 0 := by omega
    constructor
    · rw [ha m, Finset.sum_range_succ, e1, e0, pow_zero, h1]; ring
    · rw [Finset.sum_range_succ, Finset.sum_range_succ, e2, e0, pow_zero, mul_add, h2, h1, hρ]
      ring

theorem main [IsProbabilityMeasure μ] (hA : LMSAssumptions μ x z H θstar R σ) (γ : ℝ)
    (hγ0 : 0 < γ) (hγR : γ * R ^ 2 ≤ 1) (r m : ℕ) :
    Integrable (fun ω => ⟪avg (etaR γ H x (residual x z θstar) r) m ω,
      H (avg (etaR γ H x (residual x z θstar) r) m ω)⟫_ℝ) μ ∧
    ∫ ω, ⟪avg (etaR γ H x (residual x z θstar) r) m ω,
        H (avg (etaR γ H x (residual x z θstar) r) m ω)⟫_ℝ ∂μ ≤
      1 / ((m : ℝ) + 1) * γ ^ r * R ^ (2 * r) * d * σ ^ 2 := by
  set c' := γ ^ r * R ^ (2 * r) * σ ^ 2 with hc'
  have hN := (level hA γ hγ0 hγR r).1
  have hT : (H : Hs d →ₗ[ℝ] Hs d).IsSymmetric := fun v w => symm hA v w
  have hdim : Module.finrank ℝ (Hs d) = d := finrank_euclideanSpace_fin
  set b := hT.eigenvectorBasis hdim with hb
  set lam := hT.eigenvalues hdim with hlam_def
  have hHb : ∀ i, H (b i) = lam i • b i := fun i => by
    have h := hT.apply_eigenvectorBasis hdim i
    exact h
  have hb1 : ∀ i, ‖b i‖ = 1 := fun i => b.orthonormal.1 i
  have hlam : ∀ i, lam i = ⟪b i, H (b i)⟫_ℝ := fun i => by
    rw [hHb, real_inner_smul_right, real_inner_self_eq_norm_sq, hb1]; ring
  have hlpos : ∀ i, 0 < lam i := by
    intro i
    rcases (q_nonneg hA (b i)).lt_or_eq with h | h
    · rwa [hlam]
    · exfalso
      obtain ⟨Hinv, _, h2⟩ := hA.H_invertible
      have h0 : lam i = 0 := by rw [hlam]; exact h.symm
      have hz : H (b i) = 0 := by rw [hHb, h0, zero_smul]
      have h3 := congrArg (fun T : Hs d →L[ℝ] Hs d => T (b i)) h2
      simp only [ContinuousLinearMap.comp_apply, hz, map_zero,
        ContinuousLinearMap.id_apply] at h3
      have h4 := hb1 i
      rw [← h3, norm_zero] at h4
      exact zero_ne_one h4
  have hlle : ∀ i, γ * lam i ≤ 1 := by
    intro i
    have h1 := normH_sq hA (b i)
    rw [← hlam i, hHb, norm_smul, hb1, mul_one, Real.norm_eq_abs, sq_abs] at h1
    have h2 : lam i ≤ R ^ 2 := by nlinarith [hlpos i]
    calc γ * lam i ≤ γ * R ^ 2 := mul_le_mul_of_nonneg_left h2 hγ0.le
      _ ≤ 1 := hγR
  have hu : ∀ i, Integrable (fun ω => (lam i * ∑ k ∈ Finset.range (m + 1),
        ⟪etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ) ^ 2) μ ∧
      ∫ ω, (lam i * ∑ k ∈ Finset.range (m + 1),
        ⟪etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ) ^ 2 ∂μ ≤ ((m : ℝ) + 1) * (c' * lam i) := by
    intro i
    set ρ := 1 - γ * lam i with hρ
    have hρ0 : 0 ≤ ρ := by linarith [hlle i]
    have hρ1 : ρ ≤ 1 := by linarith [mul_pos hγ0 (hlpos i)]
    have hrec : ∀ ω k, ⟪etaR γ H x (residual x z θstar) r (k + 1) ω, b i⟫_ℝ =
        ρ * ⟪etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ +
          γ * ⟪noise γ H x z θstar r k ω, b i⟫_ℝ := by
      intro ω k
      rw [eta_succ, inner_add_left, inner_M hA, M_apply, hHb, smul_smul, inner_sub_right,
        real_inner_smul_right, real_inner_smul_left]
      ring
    have hid : ∀ ω, lam i * ∑ k ∈ Finset.range (m + 1),
        ⟪etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ =
        ∑ k ∈ Finset.range (m + 1), (1 - ρ ^ (m + 1 - 1 - k)) *
          ⟪noise γ H x z θstar r k ω, b i⟫_ℝ := by
      intro ω
      exact (scalar_ident ρ γ (lam i) hρ
        (fun k => ⟪etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ)
        (fun k => ⟪noise γ H x z θstar r k ω, b i⟫_ℝ)
        (by show ⟪etaR γ H x (residual x z θstar) r 0 ω, b i⟫_ℝ = 0
            rw [eta_zero, inner_zero_left]) (fun k => hrec ω k) (m + 1)).2
    simp only [hid]
    have hO := orth_sum hA (fun k ω => ⟪noise γ H x z θstar r k ω, b i⟫_ℝ)
      (fun k => (Continuous.measurable (by fun_prop : Continuous fun w : Hs d => ⟪w, b i⟫_ℝ)).comp
        (noise_meas_past γ r k))
      (fun k => (hN k (b i)).1) (fun k Y hY hint => orth_r hA γ r k (b i) Y hY hint)
      (fun k => 1 - ρ ^ (m + 1 - 1 - k)) (m + 1)
    refine ⟨hO.1, ?_⟩
    rw [hO.2]
    calc ∑ k ∈ Finset.range (m + 1), (1 - ρ ^ (m + 1 - 1 - k)) ^ 2 *
          ∫ ω, ⟪noise γ H x z θstar r k ω, b i⟫_ℝ ^ 2 ∂μ
        ≤ ∑ k ∈ Finset.range (m + 1), (c' * lam i) := by
          apply Finset.sum_le_sum
          intro k _
          have hp0 : 0 ≤ ρ ^ (m + 1 - 1 - k) := pow_nonneg hρ0 _
          have hp1 : ρ ^ (m + 1 - 1 - k) ≤ 1 := pow_le_one₀ hρ0 hρ1
          have hc1 : (1 - ρ ^ (m + 1 - 1 - k)) ^ 2 ≤ 1 := by nlinarith
          have hE := (hN k (b i)).2
          rw [← hlam i] at hE
          have hE0 : 0 ≤ ∫ ω, ⟪noise γ H x z θstar r k ω, b i⟫_ℝ ^ 2 ∂μ :=
            integral_nonneg fun ω => sq_nonneg _
          calc _ ≤ 1 * ∫ ω, ⟪noise γ H x z θstar r k ω, b i⟫_ℝ ^ 2 ∂μ := by gcongr
            _ ≤ c' * lam i := by rw [one_mul]; exact hE
      _ = ((m : ℝ) + 1) * (c' * lam i) := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]; push_cast; ring
  have hpt : ∀ ω, ⟪avg (etaR γ H x (residual x z θstar) r) m ω,
      H (avg (etaR γ H x (residual x z θstar) r) m ω)⟫_ℝ =
      ((m : ℝ) + 1)⁻¹ ^ 2 * ∑ i, (lam i * ∑ k ∈ Finset.range (m + 1),
        ⟪etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ) ^ 2 / lam i := by
    intro ω
    unfold avg
    rw [map_smul, real_inner_smul_left, real_inner_smul_right,
      ← b.sum_inner_mul_inner (∑ k ∈ Finset.range (m + 1), etaR γ H x (residual x z θstar) r k ω)
        (H (∑ k ∈ Finset.range (m + 1), etaR γ H x (residual x z θstar) r k ω))]
    have e : ∀ i, ⟪∑ k ∈ Finset.range (m + 1), etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ *
        ⟪b i, H (∑ k ∈ Finset.range (m + 1), etaR γ H x (residual x z θstar) r k ω)⟫_ℝ =
        (lam i * ∑ k ∈ Finset.range (m + 1),
          ⟪etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ) ^ 2 / lam i := by
      intro i
      rw [← symm hA, hHb, real_inner_smul_left,
        real_inner_comm (∑ k ∈ Finset.range (m + 1), etaR γ H x (residual x z θstar) r k ω),
        sum_inner]
      field_simp [(hlpos i).ne']
    simp only [e]
    ring
  have hint_i : ∀ i, Integrable (fun ω => (lam i * ∑ k ∈ Finset.range (m + 1),
      ⟪etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ) ^ 2 / lam i) μ :=
    fun i => (hu i).1.div_const _
  have hfun : (fun ω => ⟪avg (etaR γ H x (residual x z θstar) r) m ω,
      H (avg (etaR γ H x (residual x z θstar) r) m ω)⟫_ℝ) =
      fun ω => ((m : ℝ) + 1)⁻¹ ^ 2 * ∑ i, (lam i * ∑ k ∈ Finset.range (m + 1),
        ⟪etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ) ^ 2 / lam i := funext hpt
  rw [hfun]
  refine ⟨(integrable_finsetSum _ fun i _ => hint_i i).const_mul _, ?_⟩
  rw [integral_const_mul, integral_finsetSum _ fun i _ => hint_i i]
  have hm1 : (0 : ℝ) < (m : ℝ) + 1 := by positivity
  calc ((m : ℝ) + 1)⁻¹ ^ 2 * ∑ i, ∫ ω, (lam i * ∑ k ∈ Finset.range (m + 1),
          ⟪etaR γ H x (residual x z θstar) r k ω, b i⟫_ℝ) ^ 2 / lam i ∂μ
      ≤ ((m : ℝ) + 1)⁻¹ ^ 2 * ∑ _i : Fin d, ((m : ℝ) + 1) * c' := by
        gcongr with i
        rw [integral_div, div_le_iff₀ (hlpos i)]
        calc _ ≤ ((m : ℝ) + 1) * (c' * lam i) := (hu i).2
          _ = _ := by ring
    _ = 1 / ((m : ℝ) + 1) * γ ^ r * R ^ (2 * r) * d * σ ^ 2 := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, hc']
        field_simp

end AvgLMSOR

open MeasureTheory ProbabilityTheory InnerProductSpace RealInnerProductSpace AvgLMS.Expect in
theorem solution {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ] {d : ℕ}
    (x z : ℕ → Ω → Hs d) (H : Hs d →L[ℝ] Hs d) (θstar : Hs d) (R σ : ℝ)
    (hA : LMSAssumptions μ x z H θstar R σ)
    (γ : ℝ) (hγ0 : 0 < γ) (hγR : γ * R ^ 2 ≤ 1) (r n : ℕ) (hn : 1 ≤ n) :
    Integrable (fun ω => ⟪avg (etaR γ H x (residual x z θstar) r) (n - 1) ω,
      H (avg (etaR γ H x (residual x z θstar) r) (n - 1) ω)⟫_ℝ) μ ∧
    ∫ ω, ⟪avg (etaR γ H x (residual x z θstar) r) (n - 1) ω,
        H (avg (etaR γ H x (residual x z θstar) r) (n - 1) ω)⟫_ℝ ∂μ ≤
      1 / n * γ ^ r * R ^ (2 * r) * d * σ ^ 2 := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  simp only [Nat.add_sub_cancel]
  have h := AvgLMSOR.main hA γ hγ0 hγR r m
  push_cast
  exact h
