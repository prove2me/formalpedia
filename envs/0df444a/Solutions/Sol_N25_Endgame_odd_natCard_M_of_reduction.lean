namespace N25.Endgame

/-- Cauchy's theorem turns absence of rational two-torsion into odd cardinality. -/
theorem _root_.solution (hfin : Finite ↥N25.M) (D₃ : RedDatum25 3) :
    Odd (Nat.card ↥N25.M) := by
  let : Finite ↥N25.M := hfin
  apply Nat.not_even_iff_odd.mp
  intro heven
  obtain ⟨x, hx⟩ := exists_prime_addOrderOf_dvd_card' (G := ↥N25.M) 2
    (even_iff_two_dvd.mp heven)
  have hk : (2 : ℕ) • x = 0 := by rw [← hx]; exact addOrderOf_nsmul_eq_zero x
  have hz := rational_eq_zero_of_two_nsmul D₃ x hk
  rw [hz, addOrderOf_zero] at hx
  norm_num at hx

end N25.Endgame
