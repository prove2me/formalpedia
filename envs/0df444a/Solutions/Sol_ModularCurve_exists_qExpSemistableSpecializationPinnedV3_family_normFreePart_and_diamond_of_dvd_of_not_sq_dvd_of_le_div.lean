    (P : ValuationSubring (AlgebraicClosure ℚ)) (hP : P.LiesOverPrime p) :
    FAMGoalE M p hpM hp2 hMp P hP (ModularCurve.x1FunctionFieldC (IsLocalRing.ResidueField P) M) ↔ FAMGoal M p hpM hp2 hMp P hP :=
