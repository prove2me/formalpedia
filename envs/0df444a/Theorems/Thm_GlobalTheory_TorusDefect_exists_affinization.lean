    ∃ (C : Type) (_ : CommRing C) (_ : Algebra A C) (p : Z ⟶ sp C),
      (∀ a : Z ⟶ splitTorus (Spec (CommRingCat.of A)) X, ∃ a', p ≫ a' = a) ∧
      ∀ (J : Ideal A) (s : Z.left ⟶ Spec (CommRingCat.of (A ⧸ J))),
