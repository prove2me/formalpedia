namespace Sensitivity5591Packed
open ThreeBoundPackedBits

def base:ℕ:
def lanes:ℕ:

def out(v:ℕ):ℕ:=((base <<< (16*v)) % (2^(16*5591))) ||| (base >>> (16*(5591-v)))
def intersection(v:ℕ):ℕ:=(base &&& out 1) &&& out v
def euler(v:ℕ):ℕ:=v^2795%5591
def checkAt(v:ℕ):Bool:=
  (decide (euler v=1)==base.testBit (16*v)) &&
    (if v< 2 then true else decide (intersection v%65535≤ 800))
def checkRange(start count:ℕ):Bool:=(List.range count).all (fun d=>checkAt (start+d))

theorem lanes_eq:mask 5591=lanes:=by rfl
theorem base_mask:base &&& lanes=base:=by decide +kernel
theorem base_lt:base< 2^(16*5591):=by decide +kernel

theorem checkRange_sound(start count:ℕ)(h:checkRange start count=true)
    (v:ℕ)(hv:start≤ v)(hv':v< start+count):checkAt v=true:=by
  have hd:v-start< count:=by omega
  have hh:=List.all_eq_true.mp h (v-start) (List.mem_range.mpr hd)
  simpa only [Nat.add_sub_of_le hv] using hh

end Sensitivity5591Packed


