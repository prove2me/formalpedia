variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ) {D : ℕ}

lemma wrap_mem (a k m : Fin D → ℕ) : wrap a k m ∈ box a :=
  mem_box.2 fun i => Nat.mod_lt _ (by positivity)

lemma pair_wrap (ℓ : ℕ) (a : Fin D → ℕ) (ha : ∀ i, a i ≤ ℓ + 1) (j k m : Fin D → ℕ) :
    ∃ n : ℤ, pair ℓ a j (wrap a k m) =
      pair ℓ a j k + pair ℓ a j m + 2 * ((2 ^ ℓ : ℕ) : ℤ) * n := by
  refine ⟨-∑ i, (j i : ℤ) * (((k i + m i) / 2 ^ a i : ℕ) : ℤ), ?_⟩
  unfold pair wrap
  rw [mul_neg, mul_sum, ← sum_neg_distrib, ← sum_add_distrib, ← sum_add_distrib]
  refine sum_congr rfl fun i _ => ?_
  have h1 := congrArg (fun n : ℕ => (n : ℤ)) (Nat.mod_add_div (k i + m i) (2 ^ a i))
  have h2 := cexp_mul_t (ha i)
  simp only [Nat.cast_add, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] at h1 ⊢
  generalize (((k i + m i) / 2 ^ a i : ℕ) : ℤ) = q at *
  linear_combination (cexp ℓ (a i) * (j i : ℤ)) * h1 - ((j i : ℤ) * q) * h2

variable {y}

/-- **The convolution theorem** `F^-(f ∗ g) = M (F^- f)(F^- g)`. -/
theorem Fm_conv {ℓ : ℕ} (hy : y ^ (2 ^ ℓ) = -1) {a : Fin D → ℕ} (ha : ∀ i, a i ≤ ℓ + 1)
    (f g : (Fin D → ℕ) → R) (j : Fin D → ℕ) :
    Fm y ℓ a (conv a f g) j = (Mv a : ℂ) • (Fm y ℓ a f j * Fm y ℓ a g j) := by
  have key : ∀ k m, yp y (-pair ℓ a j (wrap a k m)) =
      yp y (-pair ℓ a j k) * yp y (-pair ℓ a j m) := by
    intro k m
    obtain ⟨n, hn⟩ := pair_wrap ℓ a ha j k m
    rw [hn, show -(pair ℓ a j k + pair ℓ a j m + 2 * ((2 ^ ℓ : ℕ) : ℤ) * n) =
      (-pair ℓ a j k + -pair ℓ a j m) + 2 * ((2 ^ ℓ : ℕ) : ℤ) * (-n) by ring,
      yp_periodic y hy, yp_add]
  have lhs : ∑ x ∈ box a, yp y (-pair ℓ a j x) * conv a f g x =
      ∑ k ∈ box a, ∑ m ∈ box a, yp y (-pair ℓ a j (wrap a k m)) * (f k * g m) := by
    unfold conv
    simp_rw [mul_sum, mul_ite, mul_zero]
    rw [sum_comm]
    refine sum_congr rfl fun k _ => ?_
    rw [sum_comm]
    refine sum_congr rfl fun m _ => ?_
    rw [sum_ite_eq, if_pos (wrap_mem a k m)]
  unfold Fm
  rw [lhs, mul_smul_comm, smul_mul_assoc, smul_smul, smul_smul, sum_mul_sum]
  have hM : (Mv a : ℂ) ≠ 0 := by exact_mod_cast (Mv_pos (a := a)).ne'
  congr 1
  · field_simp
  · refine sum_congr rfl fun k _ => sum_congr rfl fun m _ => ?_
    rw [key]; ring

lemma Fp_smul (ℓ : ℕ) (a : Fin D → ℕ) (c : ℂ) (z : (Fin D → ℕ) → R) (j : Fin D → ℕ) :
    Fp y ℓ a (fun x => c • z x) j = c • Fp y ℓ a z j := by
  unfold Fp
  simp_rw [mul_smul_comm, ← smul_sum, smul_smul, mul_comm]

/-- **Normalization**: `M F^+((F^- f)(F^- g)/r) = (f ∗ g)/(rM)` on the box. -/
theorem normalization {ℓ : ℕ} (hy : y ^ (2 ^ ℓ) = -1) {a : Fin D → ℕ} (ha : ∀ i, a i ≤ ℓ + 1)
    (r : ℕ) (hr : 0 < r) (f g : (Fin D → ℕ) → R) {x : Fin D → ℕ} (hx : x ∈ box a) :
    (Mv a : ℂ) • Fp y ℓ a (fun j => (r : ℂ)⁻¹ • (Fm y ℓ a f j * Fm y ℓ a g j)) x =
      Mr r a f g x := by
  have hM : (Mv a : ℂ) ≠ 0 := by exact_mod_cast (Mv_pos (a := a)).ne'
  have hr' : (r : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
  have e : (fun j => (r : ℂ)⁻¹ • (Fm y ℓ a f j * Fm y ℓ a g j)) =
      fun j => ((r : ℂ)⁻¹ * (Mv a : ℂ)⁻¹) • Fm y ℓ a (conv a f g) j := by
    funext j
    rw [Fm_conv hy ha, smul_smul]
    congr 1; field_simp
  rw [e, Fp_smul, Fp_Fm y hy ha _ hx, smul_smul, smul_smul, Mr]
  congr 1; push_cast; field_simp

section Model

variable {r : ℕ} (C : CoeffModel y r)

end Model

/-- **The error estimate of Proposition 18.** `u, v` are the exact stored forward outputs and
`ut, vt` the returned ones (all disk arrays, forward errors `< δ`); `P` is the exact normalized
pointwise product (bilinear, `‖P(x,y)‖ ≤ ‖x‖‖y‖`); `Q` the grid truncation (error `< η`); `T` the
exact opposite map `T₊` (a contraction); `ht` the returned opposite output, within `δ` of `T₊`
applied to its input. -/
theorem prop18_error {E F G : Type*} [SeminormedAddCommGroup E] [SeminormedAddCommGroup F]
    [SeminormedAddCommGroup G] (P : E → E → F) (Q : F → F) (T : F → G)
    (hPsub : ∀ x x' z z', P x z - P x' z' = P (x - x') z + P x' (z - z'))
    (hPb : ∀ x z, ‖P x z‖ ≤ ‖x‖ * ‖z‖) (hT : ∀ a b, ‖T a - T b‖ ≤ ‖a - b‖)
    {u v ut vt : E} {ht : G} {δ η : ℝ} (hu : ‖u‖ ≤ 1) (hvt : ‖vt‖ ≤ 1)
    (hdu : ‖ut - u‖ < δ) (hdv : ‖vt - v‖ < δ) (hQ : ‖Q (P ut vt) - P ut vt‖ < η)
    (hh : ‖ht - T (Q (P ut vt))‖ < δ) :
    ‖P ut vt - P u v‖ < 2 * δ ∧ ‖Q (P ut vt) - P u v‖ < 2 * δ + η ∧
      ‖ht - T (P u v)‖ < 3 * δ + η := by
  have h1 : ‖P ut vt - P u v‖ < 2 * δ := by
    rw [hPsub]
    have a1 := hPb (ut - u) vt
    have a2 := hPb u (vt - v)
    have b1 : ‖ut - u‖ * ‖vt‖ ≤ ‖ut - u‖ := mul_le_of_le_one_right (norm_nonneg _) hvt
    have b2 : ‖u‖ * ‖vt - v‖ ≤ ‖vt - v‖ := mul_le_of_le_one_left (norm_nonneg _) hu
    linarith [norm_add_le (P (ut - u) vt) (P u (vt - v))]
  have h2 : ‖Q (P ut vt) - P u v‖ < 2 * δ + η := by
    have := norm_sub_le_norm_sub_add_norm_sub (Q (P ut vt)) (P ut vt) (P u v)
    linarith
  refine ⟨h1, h2, ?_⟩
  have := norm_sub_le_norm_sub_add_norm_sub ht (T (Q (P ut vt))) (T (P u v))
  linarith [hT (Q (P ut vt)) (P u v)]

end Synth

