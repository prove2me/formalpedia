  have eg : Block.Eval (Good P) (.op (.addrLoad 42 0)) f 1 g := Block.Eval.op_addrLoad _ _ _ eh eh
  have et : Block.Eval (Good P) (.op (.add 3 1 2)) g 1 t := Block.Eval.op_add _ _ _ _ eh ht
