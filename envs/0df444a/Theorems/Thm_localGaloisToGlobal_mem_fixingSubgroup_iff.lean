-- title:
--   Local-to-global restriction and fixing subgroups of ℚ_q(ι F)
-- statement:
--   Let $q$ be a prime, let $\overline{\mathbb{Q}} =$ `AlgebraicClosure ℚ` and let `PadicAlgCl q` be the chosen algebraic closure $\overline{\mathbb{Q}}_q$ of $\mathbb{Q}_q$; write $\iota_q =$ [`padicEmbedding q`](def/GaloisRep_CompletionBridge.html#L17) for the $\mathbb{Q}$-algebra homomorphism $\overline{\mathbb{Q}} \to \overline{\mathbb{Q}}_q$ obtained by lifting along algebraic closedness, and $r_q =$ [`localGaloisToGlobal q`](def/GaloisRep_CompletionBridge.html#L41) for the monoid homomorphism from $\mathbb{Q}_q$-automorphisms of $\overline{\mathbb{Q}}_q$ to $\mathbb{Q}$-automorphisms of $\overline{\mathbb{Q}}$ given by restricting scalars to $\mathbb{Q}$ and then applying `AlgEquiv.restrictNormalHom` to the normal subextension $\overline{\mathbb{Q}}$. Then for every intermediate field $F$ of $\overline{\mathbb{Q}}/\mathbb{Q}$ and every $\mathbb{Q}_q$-algebra automorphism $s$ of $\overline{\mathbb{Q}}_q$, the automorphism $r_q(s)$ lies in the fixing subgroup of $F$, i.e. fixes $F$ pointwise, if and only if $s$ lies in the fixing subgroup of the intermediate field $\mathbb{Q}_q(\iota_q(F))$ of $\overline{\mathbb{Q}}_q/\mathbb{Q}_q$ generated by the image $\iota_q(F)$, i.e. fixes that field pointwise. No finiteness hypothesis is imposed on $F$.
--
--   This identifies the preimage under $r_q$ of $\mathrm{Gal}(\overline{\mathbb{Q}}/F)$ with the local decomposition-type subgroup $\mathrm{Gal}(\overline{\mathbb{Q}}_q/\mathbb{Q}_q(\iota_q F))$, so that global level subgroups pull back to fixing subgroups of subextensions of $\overline{\mathbb{Q}}_q/\mathbb{Q}_q$. It is used in the treatment of local level subgroups and solvability of local Galois groups, and in the construction of finite-dimensional subfields whose fixing subgroups sit inside a given one.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_localGaloisToGlobal_mem_fixingSubgroup_iff.lean

import Definitions.Def_GaloisRep_CompletionBridge

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
open scoped IntermediateField

theorem localGaloisToGlobal_mem_fixingSubgroup_iff
    (q : ℕ) [Fact q.Prime]
    (F : IntermediateField ℚ (AlgebraicClosure ℚ)) (s : PadicAlgCl q ≃ₐ[ℚ_[q]] PadicAlgCl q) :
    localGaloisToGlobal q s ∈ F.fixingSubgroup ↔
      s ∈ (IntermediateField.adjoin ℚ_[q]
        (padicEmbedding q '' (F : Set (AlgebraicClosure ℚ)))).fixingSubgroup := by sorry
