theorem gA₁_ι (i j : Fin k) : gA₁ S B u i j ≫ ι i = (e S r B u hover i j).hom ≫ gA₂ S B u i j ≫ ι j := by
  rw [← cancel_epi (θ S r B u i j).hom, ← Category.assoc, θ_hom_gA₁, ← hιt]
  simp only [t, Category.assoc]

include hover hιt in

theorem sections_agree (i j : Fin k) (C' : Type) [CommRing C'] [Algebra S C']
    (σ₁ : B i →ₐ[S] C') (σ₂ : B j →ₐ[S] C') (m : Fin (2 * g)) :
    Spec.map (CommRingCat.ofHom σ₁.toRingHom) ≫ ((u i).P m).1 ≫ ι i =
      Spec.map (CommRingCat.ofHom σ₂.toRingHom) ≫ ((u j).P m).1 ≫ ι j := by
  obtain ⟨hpb₁, hmul₁, hP₁, hpol₁⟩ := (hv₁ S B u i j).choose_spec
  obtain ⟨hpb₂, hmul₂, hP₂, hpol₂⟩ := (hv₂ S B u i j).choose_spec
  obtain ⟨he, hemul, helev, hepol⟩ := (iso_v S r B u hover i j).choose_spec

  let lam : C S B i j →ₐ[S] C' := Algebra.TensorProduct.lift σ₁ σ₂ (fun _ _ => Commute.all _ _)
  have h₁ : σ₁.toRingHom = lam.toRingHom.comp (ρ₁ S B i j).toRingHom :=
    RingHom.ext fun x => by show σ₁ x = lam (x ⊗ₜ 1); rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
  have h₂ : σ₂.toRingHom = lam.toRingHom.comp (ρ₂ S B i j).toRingHom :=
    RingHom.ext fun x => by show σ₂ x = lam (1 ⊗ₜ x); rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
  rw [h₁, h₂, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp, Category.assoc, Category.assoc]
  congr 1
  have hP₁' : ∀ m, ((v₁ S B u i j).P m).1 ≫ gA₁ S B u i j = Spec.map (CommRingCat.ofHom (ρ₁ S B i j).toRingHom) ≫ ((u i).P m).1 := hP₁
  have hP₂' : ∀ m, ((v₂ S B u i j).P m).1 ≫ gA₂ S B u i j = Spec.map (CommRingCat.ofHom (ρ₂ S B i j).toRingHom) ≫ ((u j).P m).1 := hP₂
  have helev' : ∀ m, ((v₁ S B u i j).P m).1 ≫ (e S r B u hover i j).hom = ((v₂ S B u i j).P m).1 := helev
  rw [← Category.assoc, ← hP₁', Category.assoc, gA₁_ι S r B u hover ι hιt, ← Category.assoc, helev',
    ← Category.assoc, hP₂', Category.assoc]

include hover hιf hιrange hιt in

theorem laws_agree (i j : Fin k) {T : Scheme.{0}} (tᵢ : T ⟶ Spec (CommRingCat.of (B i))) (tⱼ : T ⟶ Spec (CommRingCat.of (B j)))
    (a b : SchemeHomOver tᵢ (u i).f) (a' b' : SchemeHomOver tⱼ (u j).f)
    (ha : a.1 ≫ ι i = a'.1 ≫ ι j) (hb : b.1 ≫ ι i = b'.1 ≫ ι j) :
    ((u i).L.mul tᵢ a b).1 ≫ ι i = ((u j).L.mul tⱼ a' b').1 ≫ ι j := by
  obtain ⟨hpb₁, hmul₁, hP₁, hpol₁⟩ := (hv₁ S B u i j).choose_spec
  obtain ⟨hpb₂, hmul₂, hP₂, hpol₂⟩ := (hv₂ S B u i j).choose_spec
  obtain ⟨he, hemul, helev, hepol⟩ := (iso_v S r B u hover i j).choose_spec
  have hmul₁' : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B i j))) (x y : SchemeHomOver t' (v₁ S B u i j).f),
      ((v₁ S B u i j).L.mul t' x y).1 ≫ gA₁ S B u i j =
        ((u i).L.mul (t' ≫ Spec.map (CommRingCat.ofHom (ρ₁ S B i j).toRingHom))
          ⟨x.1 ≫ gA₁ S B u i j, by rw [Category.assoc, (gA₁_isPullback S B u i j).w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ gA₁ S B u i j, by rw [Category.assoc, (gA₁_isPullback S B u i j).w, ← Category.assoc, y.2]⟩).1 := hmul₁
  have hmul₂' : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B i j))) (x y : SchemeHomOver t' (v₂ S B u i j).f),
      ((v₂ S B u i j).L.mul t' x y).1 ≫ gA₂ S B u i j =
        ((u j).L.mul (t' ≫ Spec.map (CommRingCat.ofHom (ρ₂ S B i j).toRingHom))
          ⟨x.1 ≫ gA₂ S B u i j, by rw [Category.assoc, (gA₂_isPullback S B u i j).w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ gA₂ S B u i j, by rw [Category.assoc, (gA₂_isPullback S B u i j).w, ← Category.assoc, y.2]⟩).1 := hmul₂
  haveI := isOpenImmersion_gA₁ S r B u i j
  haveI : IsOpenImmersion (Spec.map (CommRingCat.ofHom (ρ₁ S B i j).toRingHom)) := isOpenImmersion_specρ₁ S r B i j

  have hlift : ∀ (c : SchemeHomOver tᵢ (u i).f) (c' : SchemeHomOver tⱼ (u j).f), c.1 ≫ ι i = c'.1 ≫ ι j →
      ∃ c₁ : T ⟶ (v₁ S B u i j).A, c₁ ≫ gA₁ S B u i j = c.1 := by
    intro c c' hc
    have hr : Set.range c.1.base ⊆ Set.range (gA₁ S B u i j).base := by
      rintro _ ⟨x, rfl⟩
      rw [range_gA₁ S r B u i j]
      show (p S B u i).base (c.1.base x) ∈ PrimeSpectrum.basicOpen (r j)
      rw [← hιf i, Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply _ (ι i), hc, Scheme.Hom.comp_apply]
      have : (ι j).base (c'.1.base x) ∈ Set.range (ι j).base := ⟨_, rfl⟩
      rw [hιrange j] at this
      exact this
    exact ⟨IsOpenImmersion.lift (gA₁ S B u i j) c.1 hr, IsOpenImmersion.lift_fac _ _ _⟩
  obtain ⟨a₁, ha₁⟩ := hlift a a' ha
  obtain ⟨b₁, hb₁⟩ := hlift b b' hb

  let t₁ : T ⟶ Spec (CommRingCat.of (C S B i j)) := a₁ ≫ (v₁ S B u i j).f
  have ht₁ : t₁ ≫ Spec.map (CommRingCat.ofHom (ρ₁ S B i j).toRingHom) = tᵢ := by
    rw [Category.assoc, ← (gA₁_isPullback S B u i j).w, ← Category.assoc, ha₁, a.2]
  have hb₁f : b₁ ≫ (v₁ S B u i j).f = t₁ := by
    rw [← cancel_mono (Spec.map (CommRingCat.ofHom (ρ₁ S B i j).toRingHom)), ht₁, Category.assoc,
      ← (gA₁_isPullback S B u i j).w, ← Category.assoc, hb₁, b.2]
  let x₁ : SchemeHomOver t₁ (v₁ S B u i j).f := ⟨a₁, rfl⟩
  let y₁ : SchemeHomOver t₁ (v₁ S B u i j).f := ⟨b₁, hb₁f⟩

  have eL : ((u i).L.mul tᵢ a b).1 = ((v₁ S B u i j).L.mul t₁ x₁ y₁).1 ≫ gA₁ S B u i j := by
    rw [hmul₁']
    exact mul_val_congr' (u i).L ht₁.symm _ _ _ _ ha₁.symm hb₁.symm

  have ha' : (a₁ ≫ (e S r B u hover i j).hom) ≫ gA₂ S B u i j = a'.1 := by
    rw [← cancel_mono (ι j), Category.assoc, Category.assoc, ← gA₁_ι S r B u hover ι hιt, ← Category.assoc, ha₁, ha]
  have hb' : (b₁ ≫ (e S r B u hover i j).hom) ≫ gA₂ S B u i j = b'.1 := by
    rw [← cancel_mono (ι j), Category.assoc, Category.assoc, ← gA₁_ι S r B u hover ι hιt, ← Category.assoc, hb₁, hb]
  have ht₂ : t₁ ≫ Spec.map (CommRingCat.ofHom (ρ₂ S B i j).toRingHom) = tⱼ := by
    rw [← a'.2, ← ha']
    simp only [Category.assoc]
    rw [(gA₂_isPullback S B u i j).w, ← Category.assoc (e S r B u hover i j).hom, e_over S r B u hover i j]
    rfl
  have hemul' : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B i j))) (x y : SchemeHomOver t' (v₁ S B u i j).f),
      ((v₁ S B u i j).L.mul t' x y).1 ≫ (e S r B u hover i j).hom =
        ((v₂ S B u i j).L.mul t' ⟨x.1 ≫ (e S r B u hover i j).hom, by rw [Category.assoc, e_over S r B u hover i j]; exact x.2⟩
          ⟨y.1 ≫ (e S r B u hover i j).hom, by rw [Category.assoc, e_over S r B u hover i j]; exact y.2⟩).1 := hemul
  rw [eL, Category.assoc, gA₁_ι S r B u hover ι hιt, ← Category.assoc, hemul', ← Category.assoc, hmul₂']
  congr 1
  exact mul_val_congr' (u j).L ht₂ _ _ _ _ ha' hb'

include hover hιf hιrange hιt in

theorem pol_agree (i j : Fin k) (q : ↥(pullback (ι i) (ι j))) : ∃ U : (Spec (CommRingCat.of S)).Opens,
    (pullback.fst (ι i) (ι j) ≫ ι i ≫ f).base q ∈ U ∧
    Nonempty ((Scheme.Modules.pullback ((pullback.fst (ι i) (ι j) ≫ ι i ≫ f) ⁻¹ᵁ U).ι).obj
        ((Scheme.Modules.pullback (pullback.fst (ι i) (ι j))).obj (u i).pol) ≅
      (Scheme.Modules.pullback ((pullback.fst (ι i) (ι j) ≫ ι i ≫ f) ⁻¹ᵁ U).ι).obj
        ((Scheme.Modules.pullback (pullback.snd (ι i) (ι j))).obj (u j).pol)) := by
  classical
  haveI := isOpenImmersion_gA₁ S r B u i j
  obtain ⟨hpb₁, hmul₁, hP₁, ⟨ψ₁⟩⟩ := (hv₁ S B u i j).choose_spec
  obtain ⟨hpb₂, hmul₂, hP₂, ⟨ψ₂⟩⟩ := (hv₂ S B u i j).choose_spec
  obtain ⟨he, hemul, helev, hepol⟩ := (iso_v S r B u hover i j).choose_spec
  have hψ₁ : Nonempty ((Scheme.Modules.pullback (gA₁ S B u i j)).obj (u i).pol ≅ (v₁ S B u i j).pol) := ⟨ψ₁⟩
  have hψ₂ : Nonempty ((Scheme.Modules.pullback (gA₂ S B u i j)).obj (u j).pol ≅ (v₂ S B u i j).pol) := ⟨ψ₂⟩
  obtain ⟨φ₁⟩ := hψ₁; obtain ⟨φ₂⟩ := hψ₂

  let F := pullback.fst (ι i) (ι j)
  let G := pullback.snd (ι i) (ι j)
  let π := F ≫ ι i ≫ f
  let αC := Spec.map (CommRingCat.ofHom (algebraMap S (C S B i j)))
  haveI : IsOpenImmersion αC := IsOpenImmersion.of_isLocalization (r i * r j)

  have hrange : Set.range (gA₁ S B u i j).base = Set.range F.base := by
    rw [range_gA₁ S r B u i j, Scheme.Pullback.range_fst, hιrange j]
    show (((p S B u i) ⁻¹ᵁ PrimeSpectrum.basicOpen (r j) : (u i).A.Opens) : Set _) =
      (ι i).base ⁻¹' ((f ⁻¹ᵁ PrimeSpectrum.basicOpen (r j) : Y.Opens) : Set _)
    rw [← hιf i]; rfl
  let PP := IsOpenImmersion.isoOfRangeEq (gA₁ S B u i j) F hrange
  have hP1 : PP.hom ≫ F = gA₁ S B u i j := IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _
  have hP2 : PP.hom ≫ G = (e S r B u hover i j).hom ≫ gA₂ S B u i j := by
    rw [← cancel_mono (ι j), Category.assoc, ← pullback.condition, ← Category.assoc, hP1,
      gA₁_ι S r B u hover ι hιt, Category.assoc]
  have hPpi : PP.hom ≫ π = (v₁ S B u i j).f ≫ αC := by
    show PP.hom ≫ F ≫ ι i ≫ f = _
    rw [← Category.assoc, hP1, hιf i, ← Category.assoc, (gA₁_isPullback S B u i j).w, Category.assoc, specρ₁_alg]

  let y := PP.inv.base q
  have hyq : PP.hom.base y = q := by
    show (PP.inv ≫ PP.hom).base q = q
    rw [PP.inv_hom_id]; rfl
  obtain ⟨U', hyU', ⟨η⟩⟩ := hepol ((v₁ S B u i j).f.base y)
  let U : (Spec (CommRingCat.of S)).Opens := ⟨αC.base '' (U' : Set _), αC.isOpenEmbedding.isOpenMap _ U'.2⟩
  have hPpi' : ∀ z, π.base (PP.hom.base z) = αC.base ((v₁ S B u i j).f.base z) := fun z => by
    have := congrArg (fun φ => φ.base z) hPpi
    simp only [Scheme.Hom.comp_base, TopCat.comp_app] at this
    exact this
  have hπy : π.base q = αC.base ((v₁ S B u i j).f.base y) := by rw [← hyq]; exact hPpi' y
  refine ⟨U, ⟨_, hyU', hπy.symm⟩, ?_⟩

  let W : (pullback (ι i) (ι j)).Opens := π ⁻¹ᵁ U
  let W' : (v₁ S B u i j).A.Opens := (v₁ S B u i j).f ⁻¹ᵁ U'
  have hinj : Function.Injective αC.base := αC.isOpenEmbedding.injective
  have hsurj : Function.Surjective PP.hom.base := (TopCat.homeoOfIso (Scheme.forgetToTop.mapIso PP)).surjective
  have hWW : Set.range (W'.ι ≫ PP.hom).base = Set.range W.ι.base := by
    rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, Scheme.Opens.range_ι, Scheme.Opens.range_ι]
    ext x
    constructor
    · rintro ⟨z, hz, rfl⟩
      show π.base (PP.hom.base z) ∈ αC.base '' (U' : Set _)
      exact ⟨_, hz, (hPpi' z).symm⟩
    · rintro ⟨w, hw, hx⟩
      obtain ⟨z, rfl⟩ := hsurj x
      refine ⟨z, ?_, rfl⟩
      show (v₁ S B u i j).f.base z ∈ (U' : Set _)
      have : αC.base ((v₁ S B u i j).f.base z) = αC.base w := by rw [← hPpi' z]; exact hx.symm
      rwa [hinj this]
  let θ' := IsOpenImmersion.isoOfRangeEq (W'.ι ≫ PP.hom) W.ι hWW
  have hθ' : θ'.inv ≫ W'.ι ≫ PP.hom = W.ι := IsOpenImmersion.isoOfRangeEq_inv_fac _ _ _

  have pbc := fun {X₁ X₂ X₃ : Scheme.{0}} (a : X₁ ⟶ X₂) (b : X₂ ⟶ X₃) (M : X₃.Modules) =>
    ((Scheme.Modules.pullbackComp a b).symm).app M
  have T := fun (M : (pullback (ι i) (ι j)).Modules) =>
    (Scheme.Modules.pullbackCongr hθ'.symm).app M ≪≫ pbc θ'.inv (W'.ι ≫ PP.hom) M ≪≫
      (Scheme.Modules.pullback θ'.inv).mapIso (pbc W'.ι PP.hom M)
  have I₁ : (Scheme.Modules.pullback PP.hom).obj ((Scheme.Modules.pullback F).obj (u i).pol) ≅ (v₁ S B u i j).pol :=
    (pbc PP.hom F _).symm ≪≫ (Scheme.Modules.pullbackCongr hP1).app _ ≪≫ φ₁
  have I₂ : (Scheme.Modules.pullback PP.hom).obj ((Scheme.Modules.pullback G).obj (u j).pol) ≅
      (Scheme.Modules.pullback (e S r B u hover i j).hom).obj (v₂ S B u i j).pol :=
    (pbc PP.hom G _).symm ≪≫ (Scheme.Modules.pullbackCongr hP2).app _ ≪≫ pbc _ _ _ ≪≫
      (Scheme.Modules.pullback _).mapIso φ₂
  exact ⟨T _ ≪≫ (Scheme.Modules.pullback θ'.inv).mapIso ((Scheme.Modules.pullback W'.ι).mapIso I₁ ≪≫ η.symm ≪≫
    ((Scheme.Modules.pullback W'.ι).mapIso I₂).symm) ≪≫ (T _).symm⟩

end Glued

end G2ChartData
