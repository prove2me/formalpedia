/-!
# S4-EtPBC-A, O2 C-plan S4a: rings of finite type and unramified over a Dedekind domain

`A` Dedekind, `B` of finite type and formally unramified over `A` (e.g. etale).
* **`maximalIdeal_eq_map`**: at a prime `q` over a maximal `p`, `𝔪(B_q) = p B_q` (Mathlib's proof for finite `B`,
  with the Artinian fibre from `FormallyUnramified.finite_of_free`);
* **`isDedekindDomain_of_unramified`**: a domain `B` (with `A ↪ B`) is a Dedekind domain (incomparability from
  `Algebra.QuasiFinite.eq_of_le_of_under_eq` instead of integrality);
* **`isDomain_atPrime`**: if `B` is flat and `q` lies over `(π) ≠ 0`, then `B_q` is a domain (`𝔪 = (π)`, `π` regular,
  Krull intersection);
* **`exists_away_isDomain`**: if `B` is noetherian and `B_q` is a domain, some `B_g` (`g ∉ q`) is a domain;
* **`span_eq_of_unique`**: if `q` is the only maximal ideal containing `π`, then `π B = q`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson.EtPBC.EtDed

open IsLocalRing

section Max

variable (A B : Type*) [CommRing A] [CommRing B] [Algebra A B] [Algebra.EssFiniteType A B]
  [Algebra.FormallyUnramified A B]

/-- `𝔪(B_q) = (π)` when `q` lies over `(π)` maximal. -/
theorem maximalIdeal_eq_span (q : Ideal B) [q.IsPrime] (π : A) (hπ : q.under A = Ideal.span {π})
    (hp : (q.under A).IsMaximal) :
    maximalIdeal (Localization.AtPrime q) =
      Ideal.span {algebraMap B (Localization.AtPrime q) (algebraMap A B π)} := by
  rw [maximalIdeal_eq_map A B q hp, hπ, Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]

end Max

section Ded

variable (A B : Type*) [CommRing A] [CommRing B] [Algebra A B] [IsDedekindDomain A] [IsDomain B]
  [Algebra.FiniteType A B] [Algebra.FormallyUnramified A B]

theorem isDVR_of_ne_bot (hinj : Function.Injective (algebraMap A B)) (q : Ideal B) [hqp : q.IsPrime]
    (hq : q ≠ ⊥) : IsDiscreteValuationRing (Localization.AtPrime q) := by
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing A B
  let q' := IsLocalRing.maximalIdeal (Localization.AtPrime q)
  suffices q'.IsPrincipal from ((IsDiscreteValuationRing.TFAE (Localization.AtPrime q)
    (IsLocalization.AtPrime.not_isField B hq (Localization.AtPrime q))).out 4 0).mp this
  let p := q.under A
  let := Localization.AtPrime.algebraOfLiesOver p q
  have hpm : p.IsMaximal := (hqp.under A).isMaximal (under_ne_bot A B hinj q hq)
  have e := maximalIdeal_eq_map A B q hpm
  show (maximalIdeal (Localization.AtPrime q)).IsPrincipal
  rw [e, Ideal.map_map, ← IsScalarTower.algebraMap_eq,
    IsScalarTower.algebraMap_eq A (Localization.AtPrime p) (Localization.AtPrime q), ← Ideal.map_map]
  infer_instance

end Ded

