-- Source module: Solutions.J6SegSw3
/-!
# B-line machine, sweep 3: the `B₀` axis map as seven passes

On a `(pre, N, post)` array of Gaussian items (`N = n_c λ`), the in-place `B₀` line map of the
axis (`axisL N post (lineB …)`) is computed by (`axisPipe`):

1. a selection slab pass (row `rowSel l`, scaled by `2^{P-p-1}`, zeros for `l ≥ s`);
2. the chunk kernel `chunkK` on every `λ`-chunk (one `λ`-exposure);
3. a slab gather of the `m` near-boundary rows `LJ` (padded to `G` rows);
4. the `J` kernel (`fwdK`, `bwdK`, coupling window) on every `G`-row (one `G`-exposure);
5. a slab scatter back to the `N` rows;
6. the chunk kernel again;
7. the output slab pass on the pair `(Y, Y₂)`: `outE l (Y - Y₂)`.

Real and imaginary parts are carried together (`liftG`). **`axisPipe_eq`** proves the equality.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

/-! ## Pairs of arrays -/

section zipS
variable {α β : Type*} [Inhabited α] [Inhabited β]

lemma getD_zip_of_lt {a : List α} {b : List β} {k : ℕ} (ha : k < a.length) (hb : k < b.length) :
    (List.zip a b).getD k default = (a.getD k default, b.getD k default) := by
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_zip,
    List.getD_eq_getElem _ _ ha, List.getD_eq_getElem _ _ hb]

end zipS

/-! ## Gaussian lifts -/

lemma default_GI : (default : ℤ × ℤ) = (0, 0) := rfl

lemma getD_fst (x : List (ℤ × ℤ)) (k : ℕ) : (x.getD k (0, 0)).1 = (x.map Prod.fst).getD k 0 := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases x[k]? <;> rfl

lemma getD_snd (x : List (ℤ × ℤ)) (k : ℕ) : (x.getD k (0, 0)).2 = (x.map Prod.snd).getD k 0 := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases x[k]? <;> rfl

lemma liftG_fst (f : List ℤ → List ℤ) (x : List (ℤ × ℤ))
    (hf : (f (x.map Prod.fst)).length = (f (x.map Prod.snd)).length) :
    (liftG f x).map Prod.fst = f (x.map Prod.fst) := List.map_fst_zip (by omega)

lemma liftG_snd (f : List ℤ → List ℤ) (x : List (ℤ × ℤ))
    (hf : (f (x.map Prod.fst)).length = (f (x.map Prod.snd)).length) :
    (liftG f x).map Prod.snd = f (x.map Prod.snd) := List.map_snd_zip (by omega)

/-- The chunk kernel on pairs, by parts. -/
lemma chunksG_lift (g : ℕ → List ℤ → List ℤ) (lam nc : ℕ)
    (hg : ∀ q y, y.length = lam → (g q y).length = lam) (x : List (ℤ × ℤ))
    (hx : nc * lam ≤ x.length) :
    (chunksG (fun q => liftG (g q)) lam nc x).map Prod.fst = chunksG g lam nc (x.map Prod.fst) ∧
    (chunksG (fun q => liftG (g q)) lam nc x).map Prod.snd = chunksG g lam nc (x.map Prod.snd) := by
  unfold chunksG
  rw [List.map_flatMap, List.map_flatMap]
  have hz : ∀ q ∈ List.range nc, ((x.drop (q * lam)).take lam).length = lam := by
    intro q hq
    rw [List.mem_range] at hq
    simp only [List.length_take, List.length_drop]
    have : (q + 1) * lam ≤ nc * lam := Nat.mul_le_mul_right _ hq
    rw [Nat.succ_mul] at this; omega
  have hl : ∀ q ∈ List.range nc, (g q (((x.drop (q * lam)).take lam).map Prod.fst)).length =
      (g q (((x.drop (q * lam)).take lam).map Prod.snd)).length := by
    intro q hq
    rw [hg _ _ (by rw [List.length_map]; exact hz q hq), hg _ _ (by rw [List.length_map]; exact hz q hq)]
  constructor
  · apply List.flatMap_congr
    intro q hq
    rw [liftG_fst _ _ (hl q hq), List.map_take, List.map_drop]
  · apply List.flatMap_congr
    intro q hq
    rw [liftG_snd _ _ (hl q hq), List.map_take, List.map_drop]

/-! ## The passes of the `B₀` axis map -/

section pipe
variable (p P R s t lam w α K nc G : ℕ)

variable {p P R s t lam w α K nc G}

lemma length_wOf (v : List ℤ) : (wOf P R s t lam w α K v).length = (LJ s t lam w).length := by
  simp [wOf]

lemma length_jKer (hG : (LJ s t lam w).length ≤ G) (v : List ℤ) :
    (jKer P R s t lam w α K G v).length = G := by
  simp only [jKer, List.length_append, length_wOf, List.length_replicate]; omega

/-! ## The line identity -/

lemma segLineC_getD (x : List ℤ) {l : ℕ} (hl : l < nc * lam) :
    (segLineC P R s t lam w α K nc x).getD l 0 =
      (applyL P R s t lam α nc x).getD l 0 - (applyL P R s t lam α nc (wpOf P R s t lam w α K nc x)).getD l 0 := by
  unfold segLineC
  rw [List.getD_eq_getElem _ _ (by simp; exact hl), List.getElem_map, List.getElem_range]
  rfl

/-- **One line through the seven passes is `lineB`.** -/
theorem pipeLine_eq_sol_aux (hl : 1 ≤ lam) (hst : s ≤ t) (hN : nc * lam = t)
    (hG : (LJ s t lam w).length ≤ G) (y : List (ℤ × ℤ)) :
    let N := nc * lam
    let S := slabLine N (selSrc s t) (selH p P) y
    let Y := chunksG (fun q => liftG (chunkK P R s t lam α q)) lam nc S
    let Jl := slabLine G (jSrc s t lam w) (fun _ z => z) Y
    let W := liftG (jKer P R s t lam w α K G) Jl
    let Wp := slabLine N (scSrc s t lam w) (fun _ z => z) W
    let Y2 := chunksG (fun q => liftG (chunkK P R s t lam α q)) lam nc Wp
    slabLine N (fun l => some l) (outH p P s t α) (List.zip Y Y2) =
      lineB p P R s t lam w α K nc y := by
  intro N S Y Jl W Wp Y2
  have hck : ∀ q (z : List ℤ), z.length = lam → (chunkK P R s t lam α q z).length = lam :=
    fun q z hz => by rw [length_chunkK P hl, hz]
  set m := (LJ s t lam w).length with hm
  set xr := selC p P s t N Prod.fst y with hxr
  set xi := selC p P s t N Prod.snd y with hxi
  -- pass 1
  have hSl : S.length = N := by simp [S, slabLine]
  have hS1 : S.map Prod.fst = xr := by
    simp only [S, slabLine, selC, hxr, List.map_map]
    apply List.map_congr_left
    intro l _
    simp only [Function.comp, selSrc, selH]
    split_ifs <;> rfl
  have hS2 : S.map Prod.snd = xi := by
    simp only [S, slabLine, selC, hxi, List.map_map]
    apply List.map_congr_left
    intro l _
    simp only [Function.comp, selSrc, selH]
    split_ifs <;> rfl
  -- pass 2
  obtain ⟨hY1, hY2⟩ := chunksG_lift (chunkK P R s t lam α) lam nc hck S (by rw [hSl])
  rw [hS1] at hY1
  rw [hS2] at hY2
  have hYl : Y.length = N := by
    have := congrArg List.length hY1
    rw [List.length_map] at this
    rw [this]; exact length_chunksL (fun c z hz => hck c z hz) nc (by simp [xr, selC, N])
  -- passes 3–5 by parts
  have hJ : ∀ (pr : ℤ × ℤ → ℤ), (∀ z : ℤ × ℤ, z = (0, 0) → pr z = 0) →
      Jl.map pr = (List.range G).map fun r =>
        if r < m then pr (Y.getD ((LJ s t lam w).getD r 0) (0, 0)) else 0 := by
    intro pr hpr
    simp only [Jl, slabLine, List.map_map]
    apply List.map_congr_left
    intro r _
    simp only [Function.comp, jSrc, ← hm]
    split_ifs
    · rfl
    · exact hpr _ rfl
  have hJl : Jl.length = G := by simp [Jl, slabLine]
  have hWlen : (jKer P R s t lam w α K G (Jl.map Prod.fst)).length =
      (jKer P R s t lam w α K G (Jl.map Prod.snd)).length := by
    rw [length_jKer hG, length_jKer hG]
  have hvr : (Jl.map Prod.fst).take m = (List.range m).map fun r =>
      (applyL P R s t lam α nc xr).getD ((LJ s t lam w).getD r 0) 0 := by
    rw [hJ Prod.fst (fun z hz => by rw [hz]), ← List.map_take, List.take_range, Nat.min_eq_left hG]
    apply List.map_congr_left
    intro r hr
    rw [List.mem_range] at hr
    rw [if_pos hr, getD_fst, hY1]; rfl
  have hvi : (Jl.map Prod.snd).take m = (List.range m).map fun r =>
      (applyL P R s t lam α nc xi).getD ((LJ s t lam w).getD r 0) 0 := by
    rw [hJ Prod.snd (fun z hz => by rw [hz]), ← List.map_take, List.take_range, Nat.min_eq_left hG]
    apply List.map_congr_left
    intro r hr
    rw [List.mem_range] at hr
    rw [if_pos hr, getD_snd, hY2]; rfl
  have hW1 : W.map Prod.fst = jKer P R s t lam w α K G (Jl.map Prod.fst) := liftG_fst _ _ hWlen
  have hW2 : W.map Prod.snd = jKer P R s t lam w α K G (Jl.map Prod.snd) := liftG_snd _ _ hWlen
  have hWp : ∀ (pr : ℤ × ℤ → ℤ), (∀ z : ℤ × ℤ, z = (0, 0) → pr z = 0) →
      (∀ k, pr (W.getD k (0, 0)) = (W.map pr).getD k 0) →
      Wp.map pr = (List.range N).map fun u =>
        if u ∈ LJ s t lam w then (W.map pr).getD ((LJ s t lam w).idxOf u) 0 else 0 := by
    intro pr hpr hget
    simp only [Wp, slabLine, List.map_map]
    apply List.map_congr_left
    intro u _
    simp only [Function.comp, scSrc]
    split_ifs
    · exact hget _
    · exact hpr _ rfl
  have hWpl : Wp.length = N := by simp [Wp, slabLine]
  have hjk : ∀ v : List ℤ, ∀ u ∈ LJ s t lam w,
      (jKer P R s t lam w α K G v).getD ((LJ s t lam w).idxOf u) 0 =
        (wOf P R s t lam w α K (v.take m)).getD ((LJ s t lam w).idxOf u) 0 := by
    intro v u hu
    have hi : (LJ s t lam w).idxOf u < m := List.idxOf_lt_length_of_mem hu
    unfold jKer
    rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by rw [length_wOf]; exact hi),
      ← List.getD_eq_getElem?_getD]
  -- pass 6
  obtain ⟨hY21, -⟩ := chunksG_lift (chunkK P R s t lam α) lam nc hck Wp (by rw [hWpl])
  obtain ⟨-, hY22⟩ := chunksG_lift (chunkK P R s t lam α) lam nc hck Wp (by rw [hWpl])
  have hY2l : Y2.length = N := by
    have := congrArg List.length hY21
    rw [List.length_map] at this
    rw [this]; exact length_chunksL (fun c z hz => hck c z hz) nc (by simp [hWpl, N])
  have hwp1 : Wp.map Prod.fst = wpOf P R s t lam w α K nc xr := by
    rw [hWp Prod.fst (fun z hz => by rw [hz]) (fun k => getD_fst W k), hW1]
    unfold wpOf
    apply List.map_congr_left
    intro u _
    split_ifs with hu
    · rw [hjk _ u hu, hvr]
    · rfl
  have hwp2 : Wp.map Prod.snd = wpOf P R s t lam w α K nc xi := by
    rw [hWp Prod.snd (fun z hz => by rw [hz]) (fun k => getD_snd W k), hW2]
    unfold wpOf
    apply List.map_congr_left
    intro u _
    split_ifs with hu
    · rw [hjk _ u hu, hvi]
    · rfl
  -- assemble
  unfold lineB
  simp only [slabLine]
  apply List.map_congr_left
  intro l hl'
  rw [List.mem_range] at hl'
  rw [getD_zip_of_lt (by rw [hYl]; exact hl') (by rw [hY2l]; exact hl'), default_GI]
  unfold outH
  by_cases hls : l < s
  · rw [if_pos hls, if_pos hls, segLineC_getD _ hl', segLineC_getD _ hl', getD_fst, getD_fst,
      getD_snd, getD_snd, hY1, hY2, hY21, hY22, hwp1, hwp2]
    rfl
  · rw [if_neg hls, if_neg hls]

end pipe

end J6Seg

end

theorem solution : type_of% @J6Seg.pipeLine_eq_sol_aux := @J6Seg.pipeLine_eq_sol_aux
