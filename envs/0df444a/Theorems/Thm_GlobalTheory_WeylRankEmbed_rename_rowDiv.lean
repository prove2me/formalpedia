variable (R : Type) [CommRing R] {a b : ℕ} (hab : a ≤ b)

theorem GlobalTheory.WeylRankEmbed.rename_rowDiv (x y : Fin a) (k : ℕ) (f : MvPolynomial (Fin a × Fin a) R) :
    rename (corner hab) (rowDiv R x y k f) =
      rowDiv R (Fin.castLE hab x) (Fin.castLE hab y) k (rename (corner hab) f) := by sorry
