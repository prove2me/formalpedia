private theorem e_frob (hinj : Function.Injective ιT)
    (hgal : ∀ (τ : ↥(A.decompositionSubgroup ℚ)) (c : J),
      ιT (gal (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) c) = galT τ (ιT c))
    (shift : E → E) (hsq : ∀ c, shift (shift c) = c)
    (χ : ↥(A.decompositionSubgroup ℚ) →* Multiplicative (ZMod 2))
    (hfrobχ : ∀ φ : ↥(A.decompositionSubgroup ℚ),
      A.IsFrobeniusAt (φ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) r → χ φ ≠ 1)
    (hact2 : ∀ τ, χ τ ≠ 1 → ∀ x : ↥(ribbonKernel D),
      ((actZ τ x : ↥(ribbonKernel D)) : E → ℤ) = fun c => - (x : E → ℤ) (shift c))
    (hsign : ∀ x : ↥(ribbonKernel D),
      ((heckeKernelMap H ⟨r, Fact.out⟩ x : ↥(ribbonKernel D)) : E → ℤ) = fun c => - (x : E → ℤ) (shift c)) :
    ∀ φ : ↥(A.decompositionSubgroup ℚ),
      A.IsFrobeniusAt (φ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) r →
      ∀ s : A.valuation.Completion ≃ₐ[ℚ] A.valuation.Completion, (∀ c, s c = φ • c) →
        ∀ (u : ↥𝒰.P.U) (hu : 𝒰.P.precomp (heckeKernelMap H ⟨r, Fact.out⟩)
            (𝒰.P.coeffMap (s : A.valuation.Completion →+* A.valuation.Completion) (u : 𝒰.P.TorusPoints)) ∈
              𝒰.P.U),
          e ⟨𝒰.P.precomp (heckeKernelMap H ⟨r, Fact.out⟩)
              (𝒰.P.coeffMap (s : A.valuation.Completion →+* A.valuation.Completion) (u : 𝒰.P.TorusPoints)),
              hu⟩ =
            gal (φ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (e u) := by
  intro φ hφ s hs u hu
  apply hinj
  rw [he, hgal, he]
  have hχ : χ φ ≠ 1 := hfrobχ φ hφ

  have hinv : (actZ φ)⁻¹ = actZ φ := by
    rw [inv_eq_iff_mul_eq_one]
    apply LinearEquiv.ext
    intro w
    apply Subtype.ext
    show ((actZ φ (actZ φ w) : ↥(ribbonKernel D)) : E → ℤ) = (w : E → ℤ)
    rw [hact2 φ hχ, hact2 φ hχ]
    funext c
    simp [hsq]

  have hK : ∀ z : ↥(ribbonKernel D), heckeKernelMap H ⟨r, Fact.out⟩ z = (actZ φ)⁻¹ z := by
    intro z
    rw [hinv]
    apply Subtype.ext
    rw [hsign, hact2 φ hχ]
  have hpre : 𝒰.P.precomp (heckeKernelMap H ⟨r, Fact.out⟩)
        (𝒰.P.coeffMap (s : A.valuation.Completion →+* A.valuation.Completion) (u : 𝒰.P.TorusPoints)) =
      𝒰.P.coeffMap (s : A.valuation.Completion →+* A.valuation.Completion)
        (𝒰.P.precomp (((actZ φ)⁻¹ : ↥(ribbonKernel D) ≃ₗ[ℤ] ↥(ribbonKernel D)) :
          ↥(ribbonKernel D) →ₗ[ℤ] ↥(ribbonKernel D)) (u : 𝒰.P.TorusPoints)) := by
    apply LinearMap.ext
    intro z
    simp only [PeriodDatum.precomp_apply, PeriodDatum.coeffMap_apply, LinearEquiv.coe_coe]
    rw [hK z]
  show 𝒰.eFull (𝒰.P.precomp (heckeKernelMap H ⟨r, Fact.out⟩)
    (𝒰.P.coeffMap (s : A.valuation.Completion →+* A.valuation.Completion) (u : 𝒰.P.TorusPoints))) = _
  rw [hpre]
  exact 𝒰.eFull_equiv φ s hs (u : 𝒰.P.TorusPoints)

