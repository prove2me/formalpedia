theorem _root_.solution
    {r : ℕ} (target pivot : Fin (r + 1)) :
    Disjoint (precedingRows pivot)
      (diamondSucceedingRows target pivot) := by
  apply Finset.disjoint_left.mpr
  intro a ha hb
  exact (not_lt_of_ge
