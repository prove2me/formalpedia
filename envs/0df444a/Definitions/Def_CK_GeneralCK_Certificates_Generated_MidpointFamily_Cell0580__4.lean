theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨476088534827,477188046455⟩ ⟨708581472291,708841796524⟩ ⟨235658327181,240979963460⟩ := rfl
noncomputable def centerUpper : ℝ := (304370237577 / 274877906944)
