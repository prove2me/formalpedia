-- title:
--   Local splitting of an Eichler order away from its level
-- statement:
--   Let $a,b\in\mathbb{Q}$ and $q'\in\mathbb{N}$ be such that [`QuaternionAlgebra.IsDefiniteRamifiedExactlyAt a b q'`](def/QuaternionAlgebra_EichlerOrder.html#L87) holds, that is: $a<0$, $b<0$, and for every height one prime $v$ of $\mathcal{O}_{\mathbb{Q}}$ the completed algebra $\mathbb{H}[\mathbb{Q},a,b]\otimes_{\mathbb{Q}}\mathbb{Q}_v$ has all its nonzero elements invertible precisely when $q'$ lies in the prime ideal $v$. Let $R$ be a $\mathbb{Z}$-submodule of $\mathbb{H}[\mathbb{Q},a,b]$ and $N\in\mathbb{N}$ with [`QuaternionAlgebra.IsEichlerOrder R N`](def/QuaternionAlgebra_EichlerOrder.html#L69), i.e. there are submodules $\Lambda_1,\Lambda_2$, each satisfying `IsOrder` and maximal among submodules satisfying `IsOrder` that contain it, with $R=\Lambda_1\cap\Lambda_2$ and with the relative index of the additive group of $R$ in that of $\Lambda_1$ equal to $N$. Let $v$ be a height one prime of $\mathcal{O}_{\mathbb{Q}}$ with neither $q'$ nor $N$ in $v$. Then there exists a ring isomorphism $\varphi : \mathbb{H}[\mathbb{Q},a,b]\otimes_{\mathbb{Q}}\mathbb{Q}_v \to M_2(\mathbb{Q}_v)$ such that $\varphi(1\otimes r)=r\cdot 1$ for every $r\in\mathbb{Q}_v$, and such that an element $x$ of $\mathbb{H}[\mathbb{Q},a,b]\otimes_{\mathbb{Q}}\mathbb{Q}_v$ lies in [`Submodule.localBox R v`](def/Submodule_LocalBox.html#L40) — the additive subgroup generated by the elements $z\otimes c$ with $z\in R$ and $c$ a $v$-adic integer — if and only if all four entries $\varphi(x)_{ij}$ are $v$-adic integers.
--
--   This is the standard local description of an Eichler order: at a finite place $v$ dividing neither the discriminant nor the level, the completion of $R$ is carried to $M_2(\mathbb{Z}_v)$ by a splitting of the quaternion algebra at $v$. It is the local input used throughout the Čerednik–Drinfeld coset-graph constructions, where matrix computations at places away from the level are performed.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_QuaternionAlgebra_IsEichlerOrder_exists_ringEquiv_mem_localBox_iff_of_notMem.lean

import Mathlib
import Definitions.Def_QuaternionAlgebra_EichlerOrder
import Definitions.Def_Submodule_LocalBox

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open scoped TensorProduct Quaternion
open IsDedekindDomain NumberField

theorem QuaternionAlgebra.IsEichlerOrder.exists_ringEquiv_mem_localBox_iff_of_notMem
    {a b : ℚ} {q' : ℕ} (hdef : QuaternionAlgebra.IsDefiniteRamifiedExactlyAt a b q')
    {R : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} (hR : QuaternionAlgebra.IsEichlerOrder R N)
    (v : HeightOneSpectrum (𝓞 ℚ)) (hq'v : (q' : 𝓞 ℚ) ∉ v.asIdeal) (hNv : (N : 𝓞 ℚ) ∉ v.asIdeal) :
    ∃ φ : ℍ[ℚ, a, b] ⊗[ℚ] v.adicCompletion ℚ ≃+* Matrix (Fin 2) (Fin 2) (v.adicCompletion ℚ),
      (∀ r : v.adicCompletion ℚ,
        φ ((1 : ℍ[ℚ, a, b]) ⊗ₜ[ℚ] r) = r • (1 : Matrix (Fin 2) (Fin 2) (v.adicCompletion ℚ))) ∧
      ∀ x : ℍ[ℚ, a, b] ⊗[ℚ] v.adicCompletion ℚ,
        x ∈ Submodule.localBox R v ↔ ∀ i j, φ x i j ∈ v.adicCompletionIntegers ℚ := by sorry
