private theorem s002.t0869 (D : s002 (S := S) b)
    {L₁ L₂ : List (HeightOneSpectrum (𝓞 K))} (hL : D.L = L₁ ++ L₂) :
    D.idele = (L₁.map fun v => d004 v (uniformizerUnit K v ^ (-D.c v))).prod
      * (L₂.map fun v => d004 v (uniformizerUnit K v ^ (-D.c v))).prod := by
