      (fun k => b.cost (NLogN.RS.repSt i n b s k) + asgCost i (decE i) (b.run (NLogN.RS.repSt i n b s k))) N
      (fun k hk => by
        rw [cl_int _ i _ _ (hG k)]
        have : n.eval s - k ≠ 0 := by omega
