  have h2 : zsz (((zsz ((m + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1 ≤ (m + 3) ^ 4 + 1 := by
    have := zN ((zsz ((m + 1 : ℕ) : ℤ) + 2) ^ 4)
    have := Nat.pow_le_pow_left h1 4
    omega
  have h3 : (m + 3) ^ 4 + 1 ≤ 2 * (m + 3) ^ 4 := by
    have : 1 ≤ (m + 3) ^ 4 := Nat.one_le_pow _ _ (by omega)
    omega
  exact le_trans (Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul le_rfl
    (show m + 1 ≤ m + 3 by omega)) h1) (h2.trans h3)) (le_of_eq (by ring))

theorem cU_le (Z : ℕ) : NLogN.KFUU.cU Z ≤ Kf * (Z + 3) ^ 6 := by
  unfold NLogN.KFUU.cU Kf
  have h1 := fmB_le (2 * Z)
  have h2 : (2 * Z + 3) ^ 6 ≤ (2 * (Z + 3)) ^ 6 := Nat.pow_le_pow_left (by omega) 6
