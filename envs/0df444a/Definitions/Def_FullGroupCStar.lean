-- title:
--   The full group C*-algebra C*(G) of a discrete group
-- statement:
--   The full group $C^*$-algebra of a group $G$ (with the discrete topology), with its canonical unitaries.
--
--   **The source's definition.** Choi, *The full $C^*$-algebra of the free group on two generators*, Pacific J. Math. 87 (1980) 41–48, https://doi.org/10.2140/pjm.1980.87.41, p. 41: “If $\pi$ is the universal unitary representation of $F_2$ on a Hilbert space $\mathscr H$, then the *full group $C^*$-algebra* $C^*(F_2)$ is the $C^*$-subalgebra of $\mathscr B(\mathscr H)$ generated by the set $\{\pi(g) : g \in F_2\}$ (see [4, §13.9]).” Chen–Garza-Vargas–Tropp–van Handel (p. 12) refer to “the standard definition in terms of the norm in the full $C^*$-algebra of the free group” and cite this paper.
--
--   **The construction.** `FullGroupCStar G` is the completion of the complex group algebra $\mathbb C[G]$ under
--   $$\|x\| = \sup_\pi \|\pi(x)\|,$$
--   the supremum over all unitary representations $\pi$ of $G$ on complex Hilbert spaces $H$ in the same universe as $G$ (`FullGroupCStar.Rep G`), with $\pi$ extended linearly to $\mathbb C[G]$. The supremum is bounded by the $\ell^1$ norm $\sum_g |c_g|$, so it is a real supremum and not a junk value. The involution is $(\sum_g c_g g)^* = \sum_g \overline{c_g}\, g^{-1}$, extended to the completion by continuity. The bundle proves that the result is a unital $C^*$-algebra (`CStarAlgebra (FullGroupCStar G)`), so that matrices over it form the $C^*$-algebra `CStarMatrix (Fin D) (Fin D) (FullGroupCStar G)`, Mathlib's $\mathrm M_D(C^*(G))$.
--
--   - `FullGroupCStar.of : G →* unitary (FullGroupCStar G)` sends $g$ to its image in $C^*(G)$, a unitary.
--   - `FullGroupCStar.lift π` extends a unitary representation `π : FullGroupCStar.Rep G` to a unital $*$-homomorphism $C^*(G) \to \mathscr B(H)$ with `lift π (of g) = π.ρ g` (`FullGroupCStar.lift_of`). This is the universal property of the norm's definition, for Hilbert spaces in the universe of $G$. That every unitary representation, on a Hilbert space in any universe, extends in the same way, onto the $C^*$-algebra its unitaries generate, is the statement `FullGroupCStar.exists_starAlgHom_comp_of_eq_and_range_eq`. It is the property in Choi's alternative definition (p. 41): “**Definition.** Let $U, V$ be two unitary operators on a Hilbert space $\mathscr H$. We say that $(U, V)$ is a *universal pair of unitaries* iff for each pair of unitary operators $(U_1, V_1)$ on a Hilbert space $\mathscr H_1$, the assignment $U \mapsto U_1$, $V \mapsto V_1$ extends to a $*$-homomorphism from $C^*(U, V)$ onto $C^*(U_1, V_1)$.” and “**Definition.** We let $C^*(F_2)$ denote the abstract $C^*$-algebra which is $*$-isomorphic with the $C^*$-algebra generated by a universal pair of unitaries.” For a general group the pair becomes the family $(g)_{g \in G}$.
--
--   The bundle also keeps its intermediate objects public, since its proofs use them: `FullGroupCStar.PreAlg G` (the group algebra with the seminorm), `FullGroupCStar.maxNorm`, `FullGroupCStar.l1`, and the order `CStarAlgebra.spectralOrder` that Mathlib's `CStarMatrix` requires.
-- source:
--   Choi, M. D., The full C*-algebra of the free group on two generators, Pacific J. Math. 87 (1980) 41–48, https://doi.org/10.2140/pjm.1980.87.41, p. 41, the full group C*-algebra C*(F_2) (Introduction), as Chen–Garza-Vargas–Tropp–van Handel use it on p. 12

import Mathlib

/-!
# The full group C*-algebra of a discrete group

For a group `G` (with the discrete topology), `FullGroupCStar G` is the full group C*-algebra
`C*(G)`: the completion of the complex group algebra `ℂ[G]` under the maximal C*-seminorm

  `‖x‖ = sup_π ‖π(x)‖`,

the supremum over all unitary representations `π` of `G` on complex Hilbert spaces, with the
involution `(∑ c_g g)* = ∑ conj(c_g) g⁻¹`.

The supremum runs over Hilbert spaces `H : Type u` for `G : Type u`. It is a genuine supremum in
`ℝ`: it is bounded by the `ℓ¹` norm `∑ |c_g|`
(`FullGroupCStar.norm_extend_le_l1`).

Main declarations:
* `FullGroupCStar.Rep G`: unitary representations of `G` on Hilbert spaces in `Type u`.
* `FullGroupCStar.PreAlg G`: a type synonym of `MonoidAlgebra ℂ G`, carrying the maximal
  seminorm and the involution.
* `FullGroupCStar G`: the completion, with `CStarAlgebra (FullGroupCStar G)`.
* `FullGroupCStar.of : G →* unitary (FullGroupCStar G)`: the canonical unitaries.
* `FullGroupCStar.lift π : FullGroupCStar G →⋆ₐ[ℂ] (π.H →L[ℂ] π.H)`: the extension of a
  representation `π : Rep G` (on a Hilbert space in `Type u`), with `FullGroupCStar.lift_of : lift π (of g) = π.ρ g`.
-/

universe u

noncomputable section

open scoped ComplexConjugate
open UniformSpace

namespace FullGroupCStar

/-- A unitary representation of the group `G` on a complex Hilbert space `H` in `Type u`. -/
structure Rep (G : Type u) [Group G] where
  /-- The Hilbert space of the representation. -/
  H : Type u
  /-- The norm of `H`. -/
  [instNormed : NormedAddCommGroup H]
  /-- The inner product of `H`. -/
  [instInner : InnerProductSpace ℂ H]
  /-- `H` is complete. -/
  [instComplete : CompleteSpace H]
  /-- The representation, a homomorphism into the unitary group of `B(H)`. -/
  ρ : G →* unitary (H →L[ℂ] H)

attribute [instance] Rep.instNormed Rep.instInner Rep.instComplete

variable {G : Type u} [Group G]

/-! ## The involution on `ℂ[G]` -/

/-- The involution `(∑ c_g g)* = ∑ conj(c_g) g⁻¹` on the group algebra. -/
def starMA (x : MonoidAlgebra ℂ G) : MonoidAlgebra ℂ G :=
  MonoidAlgebra.ofCoeff
    (Finsupp.equivMapDomain (Equiv.inv G) (x.coeff.mapRange (starRingEnd ℂ) (map_zero _)))

@[simp]
lemma coeff_starMA (x : MonoidAlgebra ℂ G) (g : G) :
    (starMA x).coeff g = conj (x.coeff g⁻¹) := by
  simp [starMA, Finsupp.equivMapDomain_apply]

lemma starMA_single (g : G) (c : ℂ) :
    starMA (MonoidAlgebra.single g c) = MonoidAlgebra.single g⁻¹ (conj c) := by
  simp only [starMA, MonoidAlgebra.coeff_single, Finsupp.mapRange_single,
    Finsupp.equivMapDomain_single, MonoidAlgebra.ofCoeff_single, Equiv.inv_apply]

lemma starMA_zero : starMA (0 : MonoidAlgebra ℂ G) = 0 := by
  ext g; simp

lemma starMA_add (x y : MonoidAlgebra ℂ G) : starMA (x + y) = starMA x + starMA y := by
  ext g; simp [MonoidAlgebra.coeff_add]

lemma starMA_starMA (x : MonoidAlgebra ℂ G) : starMA (starMA x) = x := by
  ext g; simp

lemma starMA_smul (c : ℂ) (x : MonoidAlgebra ℂ G) : starMA (c • x) = conj c • starMA x := by
  ext g; simp

lemma starMA_mul (x y : MonoidAlgebra ℂ G) : starMA (x * y) = starMA y * starMA x := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp [starMA_zero]
  | add x x' hx hx' => simp only [add_mul, mul_add, starMA_add, hx, hx']
  | single g a =>
    induction y using MonoidAlgebra.induction_linear with
    | zero => simp [starMA_zero]
    | add y y' hy hy' => simp only [add_mul, mul_add, starMA_add, hy, hy']
    | single h b =>
      simp only [MonoidAlgebra.single_mul_single, starMA_single, mul_inv_rev, map_mul, mul_comm]

/-! ## Representations, extended to `ℂ[G]` -/

namespace Rep

variable (π : Rep G)

/-- The representation as a monoid homomorphism into `B(H)`. -/
def toHom : G →* (π.H →L[ℂ] π.H) := (unitary (π.H →L[ℂ] π.H)).subtype.comp π.ρ

/-- The representation extended linearly to the group algebra: `π(∑ c_g g) = ∑ c_g π(g)`. -/
def extend : MonoidAlgebra ℂ G →ₐ[ℂ] (π.H →L[ℂ] π.H) := MonoidAlgebra.lift ℂ _ G π.toHom

lemma extend_single (g : G) (c : ℂ) :
    π.extend (MonoidAlgebra.single g c) = c • (π.ρ g : π.H →L[ℂ] π.H) :=
  MonoidAlgebra.lift_single _ _ _

lemma coe_ρ_inv (g : G) :
    (π.ρ g⁻¹ : π.H →L[ℂ] π.H) = star (π.ρ g : π.H →L[ℂ] π.H) := by
  rw [map_inv, ← Unitary.star_eq_inv, Unitary.coe_star]

lemma extend_starMA (x : MonoidAlgebra ℂ G) : π.extend (starMA x) = star (π.extend x) := by
  induction x using MonoidAlgebra.induction_linear with
  | zero => simp [starMA_zero]
  | add x y hx hy => rw [starMA_add, map_add, map_add, star_add, hx, hy]
  | single g c =>
    rw [starMA_single, extend_single, extend_single, star_smul, coe_ρ_inv]
    rfl

end Rep

/-- A unitary in a C*-ring has norm at most one. -/
lemma norm_coe_unitary_le {E : Type*} [NormedRing E] [StarRing E] [CStarRing E]
    (U : unitary E) : ‖(U : E)‖ ≤ 1 := by
  rcases subsingleton_or_nontrivial E with hE | hE
  · rw [Subsingleton.elim (U : E) 0, norm_zero]; exact zero_le_one
  · exact (CStarRing.norm_coe_unitary U).le

/-- The `ℓ¹` norm `∑ |c_g|` of an element of the group algebra. -/
def l1 (x : MonoidAlgebra ℂ G) : ℝ := x.coeff.sum fun _ c => ‖c‖

omit [Group G] in
lemma l1_nonneg (x : MonoidAlgebra ℂ G) : 0 ≤ l1 x :=
  Finset.sum_nonneg fun _ _ => norm_nonneg _

lemma norm_extend_le_l1 (π : Rep G) (x : MonoidAlgebra ℂ G) : ‖π.extend x‖ ≤ l1 x := by
  rw [Rep.extend, MonoidAlgebra.lift_apply]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun g _ => ?_)
  refine (norm_smul_le _ _).trans ?_
  exact mul_le_of_le_one_right (norm_nonneg _) (norm_coe_unitary_le (π.ρ g))

/-! ## The maximal C*-seminorm -/

/-- The maximal C*-seminorm `‖x‖ = sup_π ‖π(x)‖` over unitary representations on Hilbert spaces
in `Type u`. -/
def maxNorm (x : MonoidAlgebra ℂ G) : ℝ := ⨆ π : Rep G, ‖π.extend x‖

lemma bddAbove_norm_extend (x : MonoidAlgebra ℂ G) :
    BddAbove (Set.range fun π : Rep G => ‖π.extend x‖) :=
  ⟨l1 x, by rintro _ ⟨π, rfl⟩; exact norm_extend_le_l1 π x⟩

lemma norm_extend_le_maxNorm (π : Rep G) (x : MonoidAlgebra ℂ G) : ‖π.extend x‖ ≤ maxNorm x :=
  le_ciSup (bddAbove_norm_extend x) π

lemma maxNorm_le {x : MonoidAlgebra ℂ G} {a : ℝ} (ha : 0 ≤ a)
    (h : ∀ π : Rep G, ‖π.extend x‖ ≤ a) : maxNorm x ≤ a :=
  Real.iSup_le h ha

lemma maxNorm_nonneg (x : MonoidAlgebra ℂ G) : 0 ≤ maxNorm x :=
  Real.iSup_nonneg fun _ => norm_nonneg _

lemma maxNorm_le_l1 (x : MonoidAlgebra ℂ G) : maxNorm x ≤ l1 x :=
  maxNorm_le (l1_nonneg x) fun π => norm_extend_le_l1 π x

lemma maxNorm_starMA (x : MonoidAlgebra ℂ G) : maxNorm (starMA x) = maxNorm x := by
  simp only [maxNorm, Rep.extend_starMA, norm_star]

lemma maxNorm_mul_self_le (x : MonoidAlgebra ℂ G) :
    maxNorm x * maxNorm x ≤ maxNorm (starMA x * x) := by
  have hs := maxNorm_nonneg (starMA x * x)
  have key : maxNorm x ≤ √(maxNorm (starMA x * x)) := by
    refine maxNorm_le (Real.sqrt_nonneg _) fun π => ?_
    rw [← Real.sqrt_mul_self (norm_nonneg (π.extend x)), ← CStarRing.norm_star_mul_self,
      ← Rep.extend_starMA, ← map_mul]
    exact Real.sqrt_le_sqrt (norm_extend_le_maxNorm π _)
  calc maxNorm x * maxNorm x ≤ √(maxNorm (starMA x * x)) * √(maxNorm (starMA x * x)) :=
        mul_self_le_mul_self (maxNorm_nonneg x) key
    _ = maxNorm (starMA x * x) := Real.mul_self_sqrt hs

/-- The maximal C*-seminorm as a ring seminorm on `ℂ[G]`. -/
def maxSeminorm : RingSeminorm (MonoidAlgebra ℂ G) where
  toFun := maxNorm
  map_zero' := le_antisymm (maxNorm_le le_rfl fun π => by simp) (maxNorm_nonneg 0)
  add_le' x y := maxNorm_le (add_nonneg (maxNorm_nonneg x) (maxNorm_nonneg y)) fun π => by
    rw [map_add]
    exact (norm_add_le _ _).trans
      (add_le_add (norm_extend_le_maxNorm π x) (norm_extend_le_maxNorm π y))
  neg' x := by simp only [maxNorm, map_neg, norm_neg]
  mul_le' x y := maxNorm_le (mul_nonneg (maxNorm_nonneg x) (maxNorm_nonneg y)) fun π => by
    rw [map_mul]
    exact (norm_mul_le _ _).trans (mul_le_mul (norm_extend_le_maxNorm π x)
      (norm_extend_le_maxNorm π y) (norm_nonneg _) (maxNorm_nonneg x))

/-! ## The pre-C*-algebra `ℂ[G]` with the maximal seminorm -/

/-- The complex group algebra `ℂ[G]`, as a type synonym carrying the maximal C*-seminorm. -/
def PreAlg (G : Type u) [Group G] : Type u := MonoidAlgebra ℂ G

namespace PreAlg

instance : Ring (PreAlg G) := inferInstanceAs (Ring (MonoidAlgebra ℂ G))

instance : Algebra ℂ (PreAlg G) := inferInstanceAs (Algebra ℂ (MonoidAlgebra ℂ G))

/-- The identification of `PreAlg G` with the group algebra, as an algebra isomorphism. -/
def equiv : PreAlg G ≃ₐ[ℂ] MonoidAlgebra ℂ G := AlgEquiv.refl

instance : SeminormedRing (PreAlg G) := RingSeminorm.toSeminormedRing (R := PreAlg G) maxSeminorm

lemma norm_def (x : PreAlg G) : ‖x‖ = maxNorm (equiv x) := rfl

instance : NormedAlgebra ℂ (PreAlg G) where
  norm_smul_le c x := by
    rw [norm_def, norm_def, map_smul]
    refine maxNorm_le (mul_nonneg (norm_nonneg c) (maxNorm_nonneg _)) fun π => ?_
    rw [map_smul, norm_smul]
    exact mul_le_mul_of_nonneg_left (norm_extend_le_maxNorm π _) (norm_nonneg c)

instance : StarRing (PreAlg G) where
  star x := equiv.symm (starMA (equiv x))
  star_involutive x := starMA_starMA (G := G) x
  star_mul x y := starMA_mul (G := G) x y
  star_add x y := starMA_add (G := G) x y

lemma equiv_star (x : PreAlg G) : equiv (star x) = starMA (equiv x) := rfl

instance : StarModule ℂ (PreAlg G) where
  star_smul c x := starMA_smul (G := G) c x

instance : NormedStarGroup (PreAlg G) where
  norm_star_le x := by rw [norm_def, norm_def, equiv_star, maxNorm_starMA]

lemma norm_mul_self_le (x : PreAlg G) : ‖x‖ * ‖x‖ ≤ ‖star x * x‖ := by
  rw [norm_def, norm_def, map_mul, equiv_star]
  exact maxNorm_mul_self_le _

end PreAlg

end FullGroupCStar

/-! ## The full group C*-algebra -/

/-- The full group C*-algebra `C*(G)` of a discrete group `G`: the completion of `ℂ[G]` under the
maximal C*-seminorm. -/
abbrev FullGroupCStar (G : Type u) [Group G] : Type u :=
  UniformSpace.Completion (FullGroupCStar.PreAlg G)

namespace FullGroupCStar

variable {G : Type u} [Group G]

open PreAlg

instance : NormedAlgebra ℂ (FullGroupCStar G) where
  norm_smul_le := norm_smul_le

instance : Star (FullGroupCStar G) := ⟨Completion.map star⟩

lemma uniformContinuous_star_preAlg : UniformContinuous (star : PreAlg G → PreAlg G) :=
  star_isometry.uniformContinuous

lemma star_coe (a : PreAlg G) : star (a : FullGroupCStar G) = ((star a : PreAlg G) : _) :=
  Completion.map_coe uniformContinuous_star_preAlg a

instance : ContinuousStar (FullGroupCStar G) := ⟨Completion.continuous_map⟩

instance : StarRing (FullGroupCStar G) where
  star_involutive x := by
    induction x using Completion.induction_on with
    | hp => exact isClosed_eq (by fun_prop) (by fun_prop)
    | ih a => rw [star_coe, star_coe, star_star]
  star_mul x y := by
    induction x, y using Completion.induction_on₂ with
    | hp => exact isClosed_eq (by fun_prop) (by fun_prop)
    | ih a b => rw [← Completion.coe_mul, star_coe, star_coe, star_coe, star_mul,
        Completion.coe_mul]
  star_add x y := by
    induction x, y using Completion.induction_on₂ with
    | hp => exact isClosed_eq (by fun_prop) (by fun_prop)
    | ih a b => rw [← Completion.coe_add, star_coe, star_coe, star_coe, star_add,
        Completion.coe_add]

instance : StarModule ℂ (FullGroupCStar G) where
  star_smul c x := by
    induction x using Completion.induction_on with
    | hp =>
      exact isClosed_eq (continuous_star.comp (continuous_const_smul c : Continuous
        fun y : FullGroupCStar G => c • y)) ((continuous_const_smul (star c) : Continuous
        fun y : FullGroupCStar G => star c • y).comp continuous_star)
    | ih a => rw [← Completion.coe_smul, star_coe, star_coe, star_smul, Completion.coe_smul]

instance : CStarRing (FullGroupCStar G) where
  norm_mul_self_le x := by
    induction x using Completion.induction_on with
    | hp => exact isClosed_le (by fun_prop) (by fun_prop)
    | ih a =>
      rw [Completion.norm_coe, star_coe, ← Completion.coe_mul, Completion.norm_coe]
      exact PreAlg.norm_mul_self_le a

/-- The full group C*-algebra is a unital C*-algebra. -/
instance : CStarAlgebra (FullGroupCStar G) where

/-- The canonical (spectral) order of the C*-algebra. -/
instance : PartialOrder (FullGroupCStar G) := CStarAlgebra.spectralOrder _

instance : StarOrderedRing (FullGroupCStar G) := CStarAlgebra.spectralOrderedRing _

/-! ## The canonical unitaries -/

/-- `g ↦ δ_g`, the group elements inside `C*(G)`, as a monoid homomorphism into `C*(G)`. -/
def ofHom : G →* FullGroupCStar G :=
  (Completion.coeRingHom : PreAlg G →+* FullGroupCStar G).toMonoidHom.comp
    (equiv (G := G)).symm.toAlgHom.toRingHom.toMonoidHom |>.comp (MonoidAlgebra.of ℂ G)

lemma ofHom_apply (g : G) :
    ofHom g = ((equiv.symm (MonoidAlgebra.single g 1) : PreAlg G) : FullGroupCStar G) := rfl

lemma star_ofHom (g : G) : star (ofHom g) = ofHom g⁻¹ := by
  rw [ofHom_apply, ofHom_apply, star_coe]
  congr 1
  exact (starMA_single (G := G) g 1).trans (by rw [map_one]; rfl)

lemma ofHom_mem_unitary (g : G) : ofHom g ∈ unitary (FullGroupCStar G) := by
  rw [Unitary.mem_iff, star_ofHom, ← map_mul, ← map_mul, inv_mul_cancel, mul_inv_cancel, map_one]
  exact ⟨rfl, rfl⟩

/-- The canonical unitaries `G →* unitary (C*(G))`. -/
def of : G →* unitary (FullGroupCStar G) := ofHom.codRestrict _ ofHom_mem_unitary

@[simp]
lemma coe_of (g : G) : (of g : FullGroupCStar G) = ofHom g := rfl

/-! ## The universal property -/

namespace Rep

variable (π : Rep G)

/-- The representation extended to `PreAlg G`, as a ring homomorphism. -/
def extendPre : PreAlg G →+* (π.H →L[ℂ] π.H) := π.extend.toRingHom.comp equiv.toAlgHom.toRingHom

lemma extendPre_apply (a : PreAlg G) : π.extendPre a = π.extend (equiv a) := rfl

lemma norm_extendPre_le (a : PreAlg G) : ‖π.extendPre a‖ ≤ ‖a‖ :=
  norm_extend_le_maxNorm π _

lemma continuous_extendPre : Continuous π.extendPre :=
  AddMonoidHomClass.continuous_of_bound π.extendPre 1 fun a => by
    rw [one_mul]; exact π.norm_extendPre_le a

end Rep

/-- The universal property of `C*(G)`: a unitary representation `π` of `G` on a Hilbert space
(in `Type u`) extends to a unital *-homomorphism `C*(G) → B(H)` sending `of g` to `π g`. -/
def lift (π : Rep G) : FullGroupCStar G →⋆ₐ[ℂ] (π.H →L[ℂ] π.H) where
  __ := Completion.extensionHom π.extendPre π.continuous_extendPre
  commutes' r := by
    change Completion.extensionHom π.extendPre π.continuous_extendPre
      ((algebraMap ℂ (PreAlg G) r : PreAlg G) : FullGroupCStar G) = _
    rw [Completion.extensionHom_coe]
    exact π.extend.commutes r
  map_star' x := by
    have hc : Continuous (Completion.extensionHom π.extendPre π.continuous_extendPre) :=
      Completion.continuous_extension
    induction x using Completion.induction_on with
    | hp => exact isClosed_eq (hc.comp continuous_star) (continuous_star.comp hc)
    | ih a =>
      simp only [RingHom.toMonoidHom_eq_coe, OneHom.toFun_eq_coe, MonoidHom.toOneHom_coe,
        MonoidHom.coe_coe]
      rw [star_coe, Completion.extensionHom_coe, Completion.extensionHom_coe,
        Rep.extendPre_apply, Rep.extendPre_apply, equiv_star, Rep.extend_starMA]

lemma lift_coe (π : Rep G) (a : PreAlg G) :
    lift π (a : FullGroupCStar G) = π.extend (equiv a) :=
  Completion.extensionHom_coe π.extendPre π.continuous_extendPre a

@[simp]
lemma lift_of (π : Rep G) (g : G) : lift π (of g) = π.ρ g := by
  rw [coe_of, ofHom_apply, lift_coe]
  change π.extend (MonoidAlgebra.single g 1) = _
  rw [Rep.extend_single, one_smul]

lemma continuous_lift (π : Rep G) : Continuous (lift π) :=
  Completion.continuous_extension

end FullGroupCStar


