-- title:
--   Corollaire — if (1) has a unique solution x̄, the regularized iterates converge weakly to x̄
-- statement:
--   Let $H$ be a real Hilbert space, $C\subseteq H$ convex, closed and bounded, $T:H\to H'$ monotone and hemicontinuous on $C$, and let $(x^n)$ be a sequence generated by the regularization algorithm (2) from $x^0\in C$. If the variational inequality (1) has a unique solution $\bar x$, i.e. $M=\{\bar x\}$, then
--   $$
--   x^n\rightharpoonup\bar x\qquad(n\to\infty)
--   $$
--   weakly in $H$.
--
--   **Formalization Note.** Uniqueness is the hypothesis `solSet T C = {xbar}` (which includes existence). Weak convergence is convergence in `WeakSpace ℝ H`. The standing hypotheses are bundled in `Standing T C`.
-- source:
--   Martinet, Régularisation d'inéquations variationnelles par approximations successives, R.I.R.O. 4(R-3) (1970), p. 156, Corollaire

import Mathlib
import Definitions.Def_MartinetReg_VI_Setting

namespace MartinetReg.VI

open Filter Topology

/-- Corollaire, p. 156: if (1) has a unique solution `x̄`, the sequence `xⁿ`
converges weakly to `x̄`. -/
theorem corollary {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : H → StrongDual ℝ H) (C : Set H) (hS : Standing T C)
    (x : ℕ → H) (hx : IsRegSeq T C x) (xbar : H) (huniq : solSet T C = {xbar}) :
    Tendsto (fun n => toWeakSpace ℝ H (x n)) atTop (𝓝 (toWeakSpace ℝ H xbar)) := by sorry

end MartinetReg.VI
