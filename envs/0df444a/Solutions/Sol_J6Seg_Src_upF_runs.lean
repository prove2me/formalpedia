theorem pushZ_sp (s0 : IState HS) : ∀ (l : List (Fin HS)) (F : Fin HS → List ℤ), l.Nodup →
    (∀ i ∈ l, i.val < 56) →
    Sp (pushZ l) (encK s0 F) (encK s0 (fun j => if j ∈ l then 0 :: F j else F j))
      ((l.length + 1) * (2 * uC 2 DD))
  | [], F, _, _ => by
    have hu := uC_ge 2 DD
    simp only [pushZ, List.not_mem_nil, if_false]
    exact (Sp.skip _).mono (by simp; omega)
  | i :: l, F, hn, hl => by
    have hi : i ∉ l := (List.nodup_cons.1 hn).1
    have h1 := lit_sp s0 F (i := i) (hl i (by simp)) 0 (by simp) (by decide) le_rfl
    have h2 := pushZ_sp s0 l (update F i (0 :: F i)) (List.nodup_cons.1 hn).2
      (fun j hj => hl j (by simp [hj]))
    have e : (fun j => if j ∈ l then 0 :: update F i (0 :: F i) j else update F i (0 :: F i) j) =
        (fun j => if j ∈ i :: l then 0 :: F j else F j) := by
      funext j
      by_cases hj : j = i
      · subst hj; simp [hi]
      · by_cases hjl : j ∈ l <;> simp [hj, hjl, update_of_ne hj]
    rw [e] at h2
    refine (h1.seq h2).mono (le_of_eq ?_)
    simp only [List.length_cons]; ring

theorem popL_sp (s0 : IState HS) {A : ℕ} : ∀ (l : List (Fin HS)) (G : Fin HS → List ℤ), l.Nodup →
    (∀ i ∈ l, i.val < 56 ∧ ∃ a r, G i = a :: r ∧ |a| ≤ 2 ^ A) →
    Sp (popL l) (encK s0 G) (encK s0 (fun j => if j ∈ l then (G j).tail else G j))
      ((l.length + 1) * uC A DD)
