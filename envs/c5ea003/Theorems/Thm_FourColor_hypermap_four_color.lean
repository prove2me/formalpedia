import Definitions.Def_FourColor_Hypermap

namespace FourColor
universe u
theorem hypermap_four_color :
  ∀ (n : ℕ) (H : Hypermap n), H.Planar → H.Bridgeless → H.FourColorable := by sorry
end FourColor
