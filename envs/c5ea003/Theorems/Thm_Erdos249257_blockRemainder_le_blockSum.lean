open Erdos249257

open Erdos249257.TotientTailPeriodKiller

theorem Erdos249257.blockRemainder_le_blockSum
    (x : ℕ → ℝ) (h : ℕ) (blockSum : ℝ) (hh : 0 < h)
    (hx0 : ∀ n : ℕ, 0 ≤ x n)
    (hblock : ∀ q : ℕ,
      ∑ j ∈ Finset.range h, x (q * h + j) = blockSum)
    (N : ℕ) :
    blockRemainder x h N ≤ blockSum := by sorry
