-- Source module: Solutions.R6IL2CCorrU
/-!
# Round six, compact controls (I2C): the register-driven correction

`corrV kp` is `corrG kp B M A` with `B, M, A` read from the registers `1, 2, 3`;
`corrVC = corrV keyProgC`; `corrLC eB eM eA` pushes the three parameters and runs it.

**`corrLC_runs`**: on `flR recs M` (layout in the registers, `KEnv`), `corrLC` computes
`flR (recs ∘ corrC) M`, where `corrC = stepP (Sfw ∘ TlS)` inverts the key `keyC`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX IntMul RS AModel

/-! ## The uniform program -/

/-! ## The inverse of the key -/

namespace Lay

variable {l : Lay} {K ρ G n L : ℕ}

theorem stepP_congr {F F' : ℕ → CS → CS} (h : ∀ x c, l.BoxL c → F x c = F' x c) (hok : l.OK)
    (m : ℕ) : l.stepP F m = l.stepP F' m := by
  unfold stepP; rw [h _ _ (box_cs hok m)]

theorem box_TlS' (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K) (hL : ρ + n * K ≤ L)
    {c : CS} (hc : l.BoxL c) (x : ℕ) : l.BoxL (TlS K ρ n x c) := by
  rw [boxL_iff hQC hQL] at hc ⊢
  exact ⟨hc.1, hc.2.1, (Tl_spec hK hL x hc.2.2).1⟩

theorem box_Psi' (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) {c : CS} (hc : l.BoxL c) (x : ℕ) :
    l.BoxL (Psi K ρ G n L x c) := by
  rw [boxL_iff hQC hQL] at hc ⊢; exact box_Psi (K := K) (ρ := ρ) (G := G) (n := n) (L := L) x hc

theorem box_Sfw' (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) {c : CS} (hc : l.BoxL c) (x : ℕ) :
    l.BoxL (Sfw K ρ G n L x c) := by
  rw [boxL_iff hQC hQL] at hc ⊢; exact box_Sfw (K := K) (ρ := ρ) (G := G) (n := n) (L := L) x hc

end Lay

section Inv

variable {l : Lay} {K ρ G n L : ℕ}

/-- The pull of the ten steps followed by the correction is the ideal map. -/
theorem psi_corrC (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K)
    (hL : ρ + n * K ≤ L) (m : ℕ) :
    l.stepP (fun x c => Psi K ρ G n L x c) (corrC l K ρ G n L m) =
      l.stepP (fun x c => TlS K ρ n x c) m := by
  unfold corrC
  rw [Lay.stepP_stepP h (fun x c hc => Lay.box_Psi' hQC hQL hc x)
    (fun x c hc => Lay.box_Sfw' hQC hQL (Lay.box_TlS' hQC hQL hK hL hc x) x)]
  exact Lay.stepP_congr (fun x c hc => Psi_Sfw (K := K) (ρ := ρ) (G := G) (n := n) (L := L) x
    ((Lay.boxL_iff hQC hQL _).1 (Lay.box_TlS' hQC hQL hK hL hc x))) h m

end Inv

/-! ## The run -/

end IntMul.Kappa.R6.IL2C

end

