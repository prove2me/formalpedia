  have hmon : ∀ φ₁ φ₂ : TypeDensity.AffineDirection k, Ideal.span {φ₁.val} = Ideal.span {φ₂.val} → φ₁ = φ₂ := by
    intro φ₁ φ₂ h
    rw [Ideal.span_singleton_eq_span_singleton] at h
    exact Subtype.ext (Polynomial.eq_of_monic_of_associated φ₁.2.1 φ₂.2.1 h)
  have hbase : ∀ r : R, ψ (TypeDensity.chartBase R S.t S.x r) = Polynomial.C (IsLocalRing.residue R r) := he
  refine ⟨?_, ?_, ?_, hmap φ, ?_, ?_⟩
