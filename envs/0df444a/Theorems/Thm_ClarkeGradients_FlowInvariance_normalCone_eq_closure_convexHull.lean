-- title:
--   Proposition (3.2) — normal cone as closed convex hull of limits of proximal normals
-- statement:
--   Let $E$ be a nonempty closed subset of $\mathbb R^n$ and $e\in E$. Then the cone of normals (3.1) is
--
--   $$
--   N_E(e)=\operatorname{cl}\operatorname{co}\Big\{\lim_{i\to\infty}s_i(x_i-e_i)\Big\},
--   $$
--
--   where the limits range over all sequences with $s_i\ge 0$, $x_i\to e$, and $e_i$ a point of $E$ closest to $x_i$, for which $s_i(x_i-e_i)$ converges; $\operatorname{cl}\operatorname{co}$ is the closure of the convex hull.
--
--   Vectors of the form $s(x-e')$ with $e'$ a closest point of $E$ to $x$ are *proximal normals*; the proposition says the Clarke normal cone is generated by limits of proximal normals at nearby points. In the proof of Theorem (4.4) it certifies that $x(t)-y$ is normal to $F$ at a closest point $y$.
--
--   **Formalization Note** Unlike Corollary (2.5), the points $x_i$ may lie in $E$ (then $e_i=x_i$ and $x_i-e_i=0$). Closest points need not be unique; any choice is allowed. $N_E$ is the definition (3.1), built from the generalized gradient of `Metric.infDist · E`.
-- source:
--   Clarke, Generalized gradients and applications, Trans. Amer. Math. Soc. 205 (1975), p. 254, Proposition (3.2)

import Mathlib
import Definitions.Def_ClarkeGradients_FlowInvariance_normalCone

open Filter Topology

namespace ClarkeGradients.FlowInvariance

/-- Clarke (1975), Proposition (3.2): for `E ⊆ ℝⁿ` nonempty and closed and `e ∈ E`,
`N_E(e) = cl co {lim sᵢ (xᵢ - eᵢ)}`, where the limits range over all sequences with
`sᵢ ≥ 0`, `xᵢ → e`, and `eᵢ` a closest point to `xᵢ` in `E`, for which `sᵢ (xᵢ - eᵢ)` converges. -/
theorem normalCone_eq_closure_convexHull {n : ℕ} (E : Set (EuclideanSpace ℝ (Fin n)))
    (hE : E.Nonempty) (hEc : IsClosed E) (e : EuclideanSpace ℝ (Fin n)) (he : e ∈ E) :
    normalCone E e =
      closure (convexHull ℝ
        {p | ∃ (s : ℕ → ℝ) (xs es : ℕ → EuclideanSpace ℝ (Fin n)),
          (∀ i, 0 ≤ s i) ∧
          Tendsto xs atTop (𝓝 e) ∧
          (∀ i, es i ∈ E ∧ dist (xs i) (es i) = Metric.infDist (xs i) E) ∧
          Tendsto (fun i => s i • (xs i - es i)) atTop (𝓝 p)}) := by sorry

end ClarkeGradients.FlowInvariance
