-- title:
--   Canonical Hom bijection when denominators split
-- statement:
--   Let $\mathcal C$ be a category and $R$ a class containing identities and closed under composition and base change, with pullbacks along its morphisms. Fix $X$ such that every $r:V\to X$ in $R$ admits a section. Maps $f,g:X\to Y$ are elementary $R$-homotopic if there are such an $r$, sections $t,t':X\to V$, and $k:V\to Y$ with $kt=f$ and $kt'=g$. Let $\sim$ be the equivalence relation generated by these elementary homotopies. For every $Y$, the canonical map is a bijection:
--
--   $$\operatorname{Hom}_{\mathcal C}(X,Y)/{\sim}\ \xrightarrow{\cong}\operatorname{Hom}_{R^{-1}\mathcal C}(X,Y),\qquad [f]\longmapsto Q(f).$$
--
--   Here $Q$ is the actual localization functor. The representative equation fixes the canonical bijection, including well-definedness. This calculates localized maps out of objects over which every denominator splits.
-- source:
--   Homotopy types of topological stacks, arXiv:0808.3799v2, PDF p. 29, Lemma 13.2

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P19

noncomputable section

namespace QAlgorithms.Papers.Independent.Intake100.P19

open CategoryTheory CategoryTheory.Limits

universe uB vB uC vC

/-- Lemma 13.2 (PDF p. 29): if all R-maps into X admit sections, the
canonical map from generated R-homotopy classes to localized Hom is bijective.
The displayed representative equation pins this equivalence to the canonical
map, rather than asserting an unspecified equality of cardinalities. -/
theorem homotopyQuotient_localizedHom
    {C : Type uC} [Category.{vC} C] (R : MorphismProperty C)
    [R.ContainsIdentities] [R.IsStableUnderComposition]
    [R.IsStableUnderBaseChange] [R.HasPullbacks]
    (X : C) (hX : ∀ (V : C) (r : V ⟶ X), R r → ∃ t : X ⟶ V, t ≫ r = 𝟙 X)
    (Y : C) :
    ∃ e : RHomotopyQuotient R X Y ≃ (R.Q.obj X ⟶ R.Q.obj Y),
      ∀ f : X ⟶ Y, e (Quot.mk _ f) = R.Q.map f := by sorry

end QAlgorithms.Papers.Independent.Intake100.P19

end
