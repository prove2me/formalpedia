-- Source module: Solutions.R6IL2CKey
/-!
# Round six, compact controls (I2C): the key program of the correction

`keyProgC` computes, for the record index `m` on register `rm`, the key
`κ m = l.stepP (fun x c => TlS x (Psi x c)) m` (the pull composite of the program followed by the
ideal map) and pushes it on `rK` (`keyProgC_fsp`).  The layout parameters are read from the
registers `24 … 35` and `13` (`QL`); the values `x, t, u, y` live on `4, 5, 9, 12`.
Each of the eleven value updates is one segment loop (`vStep`, `vStep_fsp`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## The segment step with register radices -/

def segStepR (eu ev ew ea T : Ex HS) (tgt : Fin HS) (efin : Ex HS) : RS :=
  .seq (.push rU eu) (.seq (.push rV ev) (.seq (.push rW ew) (.seq (.push rA ea)
  (.seq (segLoopR T) (.seq (.asg tgt efin) (.seq (.pop rA) (.seq (.pop rW)
  (.seq (.pop rV) (.pop rU)))))))))

def cStepR (T : Ex HS) (Bb n c : ℕ) : ℕ :=
  cLp n (cSegItR T Bb) Bb + (c + 20) * 10 ^ 7 * (Bb + 2) ^ 2

/-! ## One value update -/

/-- `(tgt + c · rA + q²) mod q`. -/
def finE (tgt : Fin HS) (c : ℤ) (q : Fin HS) : Ex HS :=
  .nmod (.add (.add (.reg tgt) (.mul (.lit c) (.reg rA))) (.mul (.reg q) (.reg q))) (.reg q)

/-- Push the radices, one segment step into `tgt`, pop the radices. -/
def vStep (eru erv erw eu ev ew T : Ex HS) (tgt : Fin HS) (c : ℤ) (q : Fin HS) : RS :=
  .seq (.push pRu eru) (.seq (.push pRv erv) (.seq (.push pRw erw)
  (.seq (segStepR eu ev ew (.lit 0) T tgt (finE tgt c q))
  (.seq (.pop pRw) (.seq (.pop pRv) (.pop pRu))))))

def cV (T : Ex HS) (Bb n : ℕ) : ℕ := cStepR T Bb n 100 + 10 ^ 9 * (Bb + 2) ^ 2

/-- Reads none of the radix registers `6, 7, 8`. -/
def NoRad (e : Ex HS) : Prop := ∀ i ∈ e.regs, i ≠ pRu ∧ i ≠ pRv ∧ i ≠ pRw

/-! ## The ideal toggle as a reduced update -/

/-! ## The term of the ideal toggle -/

/-- `(a mod 2) (1 - 2 (b mod 2))`. -/
def tmT : Ex HS :=
  .mul (.nmod (.reg rU) (.lit 2)) (.add (.lit 1) (.mul (.lit (-2)) (.nmod (.reg rV) (.lit 2))))
def tfT (a b : ℤ) : ℤ := (a % 2) * (1 - 2 * (b % 2))

/-! ## The key program -/

abbrev kx : Fin HS := 4
abbrev kt : Fin HS := 5
abbrev ku : Fin HS := 9
abbrev ky : Fin HS := 12
abbrev kQL : Fin HS := 13
abbrev kSU : Fin HS := 24
abbrev kST : Fin HS := 25
abbrev kSX : Fin HS := 26
abbrev kSY : Fin HS := 27
abbrev kQC : Fin HS := 28
abbrev kRR : Fin HS := 29
abbrev kN : Fin HS := 32
abbrev kK2 : Fin HS := 34
abbrev kR2 : Fin HS := 35

/-- `(r / S) mod Q`. -/
def gcK (r S Q : Fin HS) : Ex HS := .nmod (.ndiv (.reg r) (.reg S)) (.reg Q)

/-- `sc Q S v n`. -/
def scK (Q S v n : Fin HS) : Ex HS :=
  .add (.add (.mul (.ndiv (.reg n) (.mul (.reg Q) (.reg S))) (.mul (.reg Q) (.reg S)))
    (.mul (.reg v) (.reg S))) (.nmod (.reg n) (.reg S))

/-- `r / 2^ρ`. -/
def hiK (r : Fin HS) : Ex HS := .ndiv (.reg r) (.reg kR2)

def stU (c : ℤ) : RS := vStep (.reg kK2) (.reg kK2) (.reg kRR) (hiK kx) (hiK kx) (.lit 1) tmS ku c kQC
def stC : RS := vStep (.reg kK2) (.reg kRR) (.reg kRR) (hiK ky) (.reg ku) (.lit 1) tmC kt 1 kQC
def stB : RS := vStep (.reg kRR) (.reg kRR) (.reg kK2) (.reg ku) (.reg kt) (.reg kR2) tmB ky (-1) kQL
def stS : RS := vStep (.reg kK2) (.reg kK2) (.reg kRR) (hiK ky) (hiK ky) (.lit 1) tmS kt (-1) kQC
def stA : RS := vStep (.reg kRR) (.reg kRR) (.reg kK2) (.reg ku) (.reg kt) (.reg kR2) tmA ky (-1) kQL
def stT : RS := vStep (.reg kK2) (.reg kK2) (.reg kK2) (hiK kx) (hiK ky) (.reg kR2) tmT ky 1 kQL

def phK : RS := .seq stC (.seq stB (.seq stS stA))

/-- **The key program.** -/
def keyProgC : RS :=
  .seq (.push pN (.reg kN)) (.seq (.push pR (.reg kRR))
  (.seq (.push kx (gcK rm kSX kQL)) (.seq (.push kt (gcK rm kST kQC))
  (.seq (.push ku (gcK rm kSU kQC)) (.seq (.push ky (gcK rm kSY kQL))
  (.seq (stU 1) (.seq phK (.seq (stU (-1)) (.seq phK (.seq stT
  (.seq (.asg ky (scK kQL kSY ky rm)) (.seq (.asg ku (scK kQC kSU ku ky))
  (.seq (.push rK (scK kQC kST kt ku))
  (.seq (.pop ky) (.seq (.pop ku) (.seq (.pop kt) (.seq (.pop kx)
  (.seq (.pop pR) (.pop pN)))))))))))))))))))

end IntMul.Kappa.R6.IL2C

