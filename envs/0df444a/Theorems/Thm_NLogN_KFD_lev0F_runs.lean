variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem NLogN.KFD.lev0F_runs {q m P L : ℕ} {A B Cs : Shape} (t : IState HS) (xs : List ℤ) (R : List Item)
    (Bb w : ℕ) (hD : DescIn t q m 0 P L A B Cs) (h0 : t.G 0 = ints xs ++ R)
    (hpos : ∀ a ∈ P :: L :: swShape A B Cs q, 1 ≤ a)
    (hlen : xs.length = vol (P :: L :: swShape A B Cs q)) (hb : Bnd w xs)
    (hV : zsz ((vol (P :: L :: swShape A B Cs q) : ℕ) : ℤ) ≤ Bb) :
    IRuns I iprog lev0F t
      (t.upd 0 (ints (AModel.pull (P :: L :: swShape A B Cs q) (P :: L :: swShape A B Cs q)
        (swapPos (A.length + 2) (A.length + B.length + 3)) 0 xs) ++ R))
      (cLev0F q (vol (P :: L :: swShape A B Cs q)) Bb w) := by sorry
