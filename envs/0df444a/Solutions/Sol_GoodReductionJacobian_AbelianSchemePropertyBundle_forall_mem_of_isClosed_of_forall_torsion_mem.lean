theorem card_le_of_cosets {GA GB : Type} [AddCommGroup GA] [AddCommGroup GB] (φ : GB →+ GA)
    (hφ : Function.Injective φ) (S : Set GA) (hS : S.Finite) (T : Set GA) (n : ℕ)
    (hTn : ∀ x ∈ T, (n : ℤ) • x = 0)
    (hcos : ∀ x ∈ T, ∃ s ∈ S, ∃ b : GB, x = s + φ b)
    [Finite (Submodule.torsionBy ℤ GB (n : ℤ))] :
    T.Finite ∧ Nat.card T ≤ Nat.card S * Nat.card (Submodule.torsionBy ℤ GB (n : ℤ)) := by
  classical
  haveI : Finite S := hS.to_subtype

  have hch : ∀ x : T, ∃ sb : S × GB, (x : GA) = sb.1 + φ sb.2 := fun x => by
    obtain ⟨s, hs, b, hb⟩ := hcos x x.2; exact ⟨(⟨s, hs⟩, b), hb⟩
  choose sb hsb using hch
  have hbase : ∀ s : S, ∃ b₀ : GB, (∃ x : T, (sb x).1 = s) → ∃ x : T, (sb x).1 = s ∧ (sb x).2 = b₀ := fun s => by
    by_cases h : ∃ x : T, (sb x).1 = s
    · obtain ⟨x, hx⟩ := h; exact ⟨(sb x).2, fun _ => ⟨x, hx, rfl⟩⟩
    · exact ⟨0, fun h' => (h h').elim⟩
  choose b₀ hb₀ using hbase

  have htor : ∀ x : T, (sb x).2 - b₀ (sb x).1 ∈ Submodule.torsionBy ℤ GB (n : ℤ) := by
    intro x
    obtain ⟨x₀, hx₀, hb⟩ := hb₀ (sb x).1 ⟨x, rfl⟩
    rw [Submodule.mem_torsionBy_iff]
    apply hφ
    rw [map_zsmul, map_zero, map_sub, ← hb]
    have e1 := hsb x
    have e2 := hsb x₀
    rw [hx₀] at e2
    have : φ (sb x).2 - φ (sb x₀).2 = (x : GA) - (x₀ : GA) := by rw [e1, e2]; abel
    rw [this, smul_sub, hTn x x.2, hTn x₀ x₀.2, sub_zero]
  let ψ : T → S × Submodule.torsionBy ℤ GB (n : ℤ) := fun x => ((sb x).1, ⟨_, htor x⟩)
  have hψ : Function.Injective ψ := by
    intro x y hxy
    simp only [ψ, Prod.mk.injEq, Subtype.mk.injEq] at hxy
    obtain ⟨h1, h2⟩ := hxy
    rw [h1, sub_left_inj] at h2
    apply Subtype.ext
    rw [hsb x, hsb y, h1, h2]
  haveI : Finite T := Finite.of_injective ψ hψ
  refine ⟨Set.toFinite T, ?_⟩
  calc Nat.card T ≤ Nat.card (S × Submodule.torsionBy ℤ GB (n : ℤ)) := Nat.card_le_card_of_injective ψ hψ
    _ = Nat.card S * Nat.card (Submodule.torsionBy ℤ GB (n : ℤ)) := Nat.card_prod _ _

theorem absurd_of_pow_le {ℓ g n m : ℕ} (hℓ : 2 ≤ ℓ) (hng : n < g)
    (h : ∀ r : ℕ, (ℓ ^ r) ^ (2 * g) ≤ m * (ℓ ^ r) ^ (2 * n)) : False := by

  have hr := h m
  have hsplit : (ℓ ^ m) ^ (2 * g) = (ℓ ^ m) ^ (2 * n) * (ℓ ^ m) ^ (2 * (g - n)) := by
    rw [← pow_add]; congr 1; omega
  rw [hsplit, mul_comm] at hr
  have hpos : 0 < (ℓ ^ m) ^ (2 * n) := by positivity
  have hle : (ℓ ^ m) ^ (2 * (g - n)) ≤ m := Nat.le_of_mul_le_mul_right hr hpos
  have h1 : 1 ≤ 2 * (g - n) := by omega
  have hge : ℓ ^ m ≤ (ℓ ^ m) ^ (2 * (g - n)) := by
    calc ℓ ^ m = (ℓ ^ m) ^ 1 := (pow_one _).symm
      _ ≤ (ℓ ^ m) ^ (2 * (g - n)) := Nat.pow_le_pow_right (Nat.one_le_pow _ _ (by omega)) h1
  have h2m : 2 ^ m ≤ ℓ ^ m := Nat.pow_le_pow_left hℓ m
  have hlt : m < 2 ^ m := Nat.lt_two_pow_self
  omega

theorem exists_lift_of_mem_range {k : Type} [Field k] {X Y : Scheme.{0}} (i : X ⟶ Y) [IsClosedImmersion i] [IsReduced X]
    (x : Spec (CommRingCat.of k) ⟶ Y) (hx : x.base (IsLocalRing.closedPoint k) ∈ Set.range i.base) :
    ∃ x' : Spec (CommRingCat.of k) ⟶ X, x' ≫ i = x := by
  refine ⟨IsClosedImmersion.lift i x ?_, IsClosedImmersion.lift_fac _ _ _⟩

  have hX : (⊥ : X.IdealSheafData) = Scheme.IdealSheafData.vanishingIdeal ⊤ := by
    rw [Scheme.IdealSheafData.vanishingIdeal_top, Scheme.nilradical_eq_bot]
  have hi : i.ker = Scheme.IdealSheafData.vanishingIdeal ⟨Set.range i.base, i.isClosedEmbedding.isClosed_range⟩ := by
    rw [← Scheme.IdealSheafData.map_bot, hX, Scheme.IdealSheafData.map_vanishingIdeal]
    congr 1; ext1
    simp [i.isClosedEmbedding.isClosed_range.closure_eq]
  have hSpec : (⊥ : (Spec (CommRingCat.of k)).IdealSheafData) = Scheme.IdealSheafData.vanishingIdeal ⊤ := by
    rw [Scheme.IdealSheafData.vanishingIdeal_top, Scheme.nilradical_eq_bot]
  have hxk : x.ker = Scheme.IdealSheafData.vanishingIdeal ⟨closure (Set.range x.base), isClosed_closure⟩ := by
    rw [← Scheme.IdealSheafData.map_bot, hSpec, Scheme.IdealSheafData.map_vanishingIdeal]
    congr 1; ext1; simp
  rw [hi, hxk]
  apply Scheme.IdealSheafData.vanishingIdeal_antimono

  change closure (Set.range x.base) ⊆ Set.range i.base
  rw [(i.isClosedEmbedding.isClosed_range).closure_subset_iff]
  rintro _ ⟨p, rfl⟩
  rw [Subsingleton.elim p (IsLocalRing.closedPoint k)]
  exact hx

