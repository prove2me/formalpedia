  have hs : Nat.Coprime s p := by
    obtain ⟨w, hw⟩ := (Units.isUnit (cyclotomicCharacter (AlgebraicClosure ℚ) p σ.toRingEquiv)).map
      (PadicInt.toZModPow 1)
    have : Nat.Coprime s (p ^ 1) := by
