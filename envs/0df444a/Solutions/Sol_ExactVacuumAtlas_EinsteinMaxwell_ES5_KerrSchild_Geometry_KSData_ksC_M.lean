  rfl

/-- Raised form of the difference connection (genuine KS inverse `gi · g = 1`). -/
theorem ksC_eq {x : Pt 5} (hx : x ∈ U) (a p q : Fin 5) :
    ksC b bi v k a p q x = ∑ d, ksInverse bi v k a d x *
      ((nablaH b bi v k x q d p + nablaH b bi v k x p d q - nablaH b bi v k x d p q) / 2) := by
  have h := raise_lower (hD.ks_inv hx) (fun i => ksC b bi v k i p q x) a
  simp only [hD.lower_ksC hx] at h
  exact h.symm

theorem inv_accL {x : Pt 5} (hx : x ∈ U) (a : Fin 5) :
    ∑ d, ksInverse bi v k a d x * accL b bi k x d = accel b bi k x a := by
  have e : ∑ d, ksInverse bi v k a d x * accL b bi k x d =
      ∑ d, bi a d x * accL b bi k x d - v x * k x a * ∑ d, k x d * accL b bi k x d := by
    simp only [ksInverse]
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun d _ => by ring
  rw [e, hD.k_dot_accL hx, mul_zero, sub_zero]
  exact raise_lower (hD.inv x hx) (accel b bi k x) a

