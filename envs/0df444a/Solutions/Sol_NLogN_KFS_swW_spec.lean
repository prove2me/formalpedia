theorem mem_pull_of_valid {α : Type*} {sh : Shape} {g : List ℕ → List ℕ}
    (hg : ∀ a, Valid sh a → Valid sh (g a)) {d : α} {xs : List α} (hxs : xs.length = vol sh)
    {y : α} (hy : y ∈ AModel.pull sh sh g d xs) : y ∈ xs := by
  simp only [AModel.pull, List.mem_map, List.mem_range] at hy
  obtain ⟨j, hj, rfl⟩ := hy
  have he := encode_lt (hg _ (valid_decode hj))
  rw [List.getD_eq_getElem _ _ (by omega)]
  exact List.getElem_mem _

theorem binShape_snoc (Pre G Suf : Shape) (F B : ℕ) :
    binShape Pre G (Suf ++ [B]) F = binShape Pre G Suf F ++ [B] := by
  simp [binShape]

theorem vol_binShape_snoc (Pre G Suf : Shape) (F B : ℕ) :
    vol (binShape Pre G (Suf ++ [B]) F) = vol (binShape Pre G Suf F) * B := by
  rw [binShape_snoc, vol_append]; simp

theorem binShape_len_ok (Pre G Suf : Shape) (F : ℕ) :
    Pre.length < (binShape Pre G Suf F).length ∧
      Pre.length + 1 + G.length < (binShape Pre G Suf F).length := by
  rw [length_binShape]; omega

theorem binShape_getD_eq (Pre G Suf : Shape) (F : ℕ) :
    (binShape Pre G Suf F).getD Pre.length 0 =
      (binShape Pre G Suf F).getD (Pre.length + 1 + G.length) 0 := by
  rw [(binShape_getD Pre G Suf F).1, (binShape_getD Pre G Suf F).2]

theorem cost_comb {cto cfr c N w : ℕ} {K x : ℝ} (hK : 0 ≤ K) (hx : 1 ≤ x)
    (hto : cto ≤ 10 ^ 4 * ((N + 1) * (w + 1))) (hfr : cfr ≤ 10 ^ 4 * ((N + 1) * (w + 1)))
    (hc : (c : ℝ) ≤ K * (((N * (w + 1) : ℕ) : ℝ) + 1) * x) :
    ((cto + (c + cfr) : ℕ) : ℝ) ≤ (2 * 10 ^ 4 + K) * ((w : ℝ) + 1) * ((N : ℝ) + 1) * x := by
  have h1 : (cto : ℝ) ≤ 10 ^ 4 * (((N : ℝ) + 1) * ((w : ℝ) + 1)) := by exact_mod_cast hto
  have h2 : (cfr : ℝ) ≤ 10 ^ 4 * (((N : ℝ) + 1) * ((w : ℝ) + 1)) := by exact_mod_cast hfr
  have hN : (0 : ℝ) ≤ N := Nat.cast_nonneg _
  have hw : (0 : ℝ) ≤ w := Nat.cast_nonneg _
  have hP : (0 : ℝ) ≤ ((N : ℝ) + 1) * ((w : ℝ) + 1) := by positivity
  have h3 : (((N * (w + 1) : ℕ) : ℝ) + 1) ≤ ((w : ℝ) + 1) * ((N : ℝ) + 1) := by
    push_cast; nlinarith
  have h4 : K * (((N * (w + 1) : ℕ) : ℝ) + 1) * x ≤ K * (((w : ℝ) + 1) * ((N : ℝ) + 1)) * x := by
    apply mul_le_mul_of_nonneg_right _ (by linarith)
    exact mul_le_mul_of_nonneg_left h3 hK
  have h5 : 2 * 10 ^ 4 * (((N : ℝ) + 1) * ((w : ℝ) + 1)) ≤
      2 * 10 ^ 4 * (((N : ℝ) + 1) * ((w : ℝ) + 1)) * x := by nlinarith
  push_cast
  nlinarith

end NLogN.KFS

