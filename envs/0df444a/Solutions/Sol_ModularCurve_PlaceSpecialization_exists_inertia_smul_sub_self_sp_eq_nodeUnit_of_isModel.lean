  letI := instAlgebraResidueFieldModularFunctionFieldCSemistable A N
  intro W hW hstab data hKr hα hβ P R hR hRL hNV hO e comp sp hsurj hker hsp
  have hC1 := IsGluedSpecialization.isGoodClass_and_toPic0Pair_apply_smul_sub_self_of_isModel N q hq hqN
    A hA W hW hstab data hKr hα hβ P R hR hRL hNV hO sp hsp
