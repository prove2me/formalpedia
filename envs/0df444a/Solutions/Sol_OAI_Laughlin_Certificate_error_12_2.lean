def UT (z n m : ℕ) : ℤ := ((Utab.getD z []).getD n []).getD m 0

def UT' (z n m : ℕ) : ℤ := if z < 13 ∧ n < 25 ∧ m < 9 then UT z n m else UFast 1 z n m

theorem U_eq : U = UFast := by
  funext c z T p
  simp only [U, UFast, Nat.choose_eq_fast_choose]

theorem table_ok : ∀ z < 13, ∀ n < 25, ∀ m < 9, UFast 1 z n m = UT z n m := by
  decide +kernel

theorem U1_eq (z n m : ℕ) : U 1 z n m = UT' z n m := by
  unfold UT'
  rw [U_eq]
  split_ifs with h
  · exact table_ok z h.1 n h.2.1 m h.2.2
  · rfl

def VT (r D T p j k : ℕ) : ℤ :=
  if r ≤ j+k then UT' r (j+k) j * UT' (D-r) (T-r) p else 0

theorem V_eq : V = VT := by
  funext r D T p j k
  simp only [V, VT, U1_eq]

def yE (D r s t : ℕ) (e f : ℕ × ℕ × ℤ) : ℚ :=
  let (p,j,a) := e
  let (q,l,b) := f
  let i := p+j-t
  let k := q+l-t
  let T := p+j+k
  if D ≤ T then
    let vr := VT r D T p j k
    let vs := VT s D T q l i
    if vr = 0 ∨ vs = 0 then 0 else
      ((a*b*vr*vs*(i.factorial : ℤ)*(k.factorial : ℤ)*(t.factorial : ℤ) : ℤ) : ℚ) *
        (2 : ℚ) ^ (1-2*(T : ℤ)+(p : ℤ)+(q : ℤ)-(t : ℤ)+((r+s)/2 : ℕ)) /
        ((T-D).factorial : ℚ)
  else 0

def yR (D r s : ℕ) (row : ℕ × ℤ × List (ℕ × ℕ × ℤ)) : ℚ :=
  (row.2.2.map (fun e => (row.2.2.map (fun f => yE D r s row.1 e f)).sum)).sum

def YY (D r s : ℕ) : ℚ :=
  -(rows.map (yR D r s)).sum / (10^14 : ℚ)

theorem yEntry_eq (D r s t : ℕ) (e f : ℕ × ℕ × ℤ) :
    yEntry D r s t e f = yE D r s t e f := by
  obtain ⟨p, j, a⟩ := e
  obtain ⟨q, l, b⟩ := f
  simp only [yEntry, yE, ← V_eq]
  by_cases hD : D ≤ p + j + (q + l - t)
  · rw [if_pos hD, if_pos hD]
    by_cases hv : V r D (p + j + (q + l - t)) p j (q + l - t) = 0 ∨
        V s D (p + j + (q + l - t)) q l (p + j - t) = 0
    · rw [if_pos hv]
      rcases hv with hv | hv <;> simp [hv]
    · rw [if_neg hv]
      push_cast
      ring
  · rw [if_neg hD, if_neg hD]

theorem yRow_eq : yRow = yR := by
  funext D r s row
  simp only [yRow, yR, yEntry_eq]

theorem Y_eq : Y = YY := by
  funext D r s
  simp only [Y, YY, yRow_eq]


def yEI (D r s t : ℕ) (e f : ℕ × ℕ × ℤ) : ℤ :=
  let (p,j,a) := e
  let (q,l,b) := f
  let i := p+j-t
  let k := q+l-t
  let T := p+j+k
  if D ≤ T then
    let vr := VT r D T p j k
    let vs := VT s D T q l i
    if vr = 0 ∨ vs = 0 then 0 else
      a*b*vr*vs*(i.factorial : ℤ)*(k.factorial : ℤ)*(t.factorial : ℤ) *
        (2 : ℤ)^((65-2*(T : ℤ)+(p : ℤ)+(q : ℤ)-(t : ℤ)+((r+s)/2 : ℕ)).toNat) *
        ((24 : ℕ).descFactorial (24-(T-D)) : ℤ)
  else 0

def yRI (D r s : ℕ) (row : ℕ × ℤ × List (ℕ × ℕ × ℤ)) : ℤ :=
  (row.2.2.map (fun e => (row.2.2.map (fun f => yEI D r s row.1 e f)).sum)).sum

def YI (D r s : ℕ) : ℤ := (rows.map (yRI D r s)).sum

def scale : ℚ := 2^64 * ((24 : ℕ).factorial : ℚ)

theorem key (X E : ℤ) (m : ℕ) (hE : 0 ≤ E + 64) (hm : m ≤ 24) :
    (X : ℚ) * (2 : ℚ) ^ E / (m.factorial : ℚ) =
      ((X * (2 : ℤ) ^ ((E + 64).toNat) * ((24 : ℕ).descFactorial (24 - m) : ℤ) : ℤ) : ℚ) *
        scale⁻¹ := by
  have h1 : ((2 : ℚ) ^ ((E + 64).toNat)) = 2 ^ E * 2 ^ (64 : ℕ) := by
    rw [← zpow_natCast, Int.toNat_of_nonneg hE, zpow_add₀ two_ne_zero]
    norm_cast
  have h2 : (m.factorial : ℚ) * ((24 : ℕ).descFactorial (24 - m) : ℚ) =
      ((24 : ℕ).factorial : ℚ) := by
    have := Nat.factorial_mul_descFactorial (show 24 - m ≤ 24 by omega)
    rw [show 24 - (24 - m) = m by omega] at this
    exact_mod_cast this
  have hf : (m.factorial : ℚ) ≠ 0 := by positivity
  have hd : ((24 : ℕ).descFactorial (24 - m) : ℚ) ≠ 0 := by
    have : 0 < (24 : ℕ).descFactorial (24 - m) := Nat.descFactorial_pos.mpr (by omega)
    positivity
  unfold scale
  push_cast
  rw [h1, ← h2]
  field_simp

def rowsOK : Prop :=
  ∀ row ∈ rows, ∀ e ∈ row.2.2, ∀ f ∈ row.2.2,
    e.1 + e.2.1 + (f.1 + f.2.1 - row.1) ≤ 24 ∧
      2 * (e.1 + e.2.1 + (f.1 + f.2.1 - row.1)) + row.1 ≤ 65

theorem rowsOK_true : rowsOK := by
  unfold rowsOK
  decide +kernel

theorem yE_int (D r s t : ℕ) (e f : ℕ × ℕ × ℤ)
    (h1 : e.1 + e.2.1 + (f.1 + f.2.1 - t) ≤ 24)
    (h2 : 2 * (e.1 + e.2.1 + (f.1 + f.2.1 - t)) + t ≤ 65) :
    yE D r s t e f = (yEI D r s t e f : ℚ) * scale⁻¹ := by
  obtain ⟨p, j, a⟩ := e
  obtain ⟨q, l, b⟩ := f
  simp only at h1 h2
  simp only [yE, yEI]
  by_cases hD : D ≤ p + j + (q + l - t)
  · rw [if_pos hD, if_pos hD]
    by_cases hv : VT r D (p + j + (q + l - t)) p j (q + l - t) = 0 ∨
        VT s D (p + j + (q + l - t)) q l (p + j - t) = 0
    · rw [if_pos hv, if_pos hv]
      simp
    · rw [if_neg hv, if_neg hv]
      have hk := key (a * b * VT r D (p + j + (q + l - t)) p j (q + l - t) *
          VT s D (p + j + (q + l - t)) q l (p + j - t) * ((p + j - t).factorial : ℤ) *
          ((q + l - t).factorial : ℤ) * (t.factorial : ℤ))
        (1 - 2 * ((p + j + (q + l - t) : ℕ) : ℤ) + (p : ℤ) + (q : ℤ) - (t : ℤ) +
          (((r + s) / 2 : ℕ) : ℤ))
        (p + j + (q + l - t) - D) (by push_cast; omega) (by omega)
      rw [hk]
      congr 2
      rw [show (65 - 2 * ((p + j + (q + l - t) : ℕ) : ℤ) + (p : ℤ) + (q : ℤ) - (t : ℤ) +
          (((r + s) / 2 : ℕ) : ℤ)) = (1 - 2 * ((p + j + (q + l - t) : ℕ) : ℤ) + (p : ℤ) +
          (q : ℤ) - (t : ℤ) + (((r + s) / 2 : ℕ) : ℤ)) + 64 by ring]
  · rw [if_neg hD, if_neg hD]
    simp

theorem Y_int (D r s : ℕ) : Y D r s = -((YI D r s : ℤ) : ℚ) * scale⁻¹ / (10^14 : ℚ) := by
  rw [Y_eq]
  unfold YY YI
  have hrow : ∀ row ∈ rows, yR D r s row = (yRI D r s row : ℚ) * scale⁻¹ := by
    intro row hrow
    unfold yR yRI
    rw [Int.cast_list_sum, ← List.sum_map_mul_right, List.map_map]
    congr 1
    apply List.map_congr_left
    intro e he
    simp only [Function.comp_apply]
    rw [Int.cast_list_sum, ← List.sum_map_mul_right, List.map_map]
    congr 1
    apply List.map_congr_left
    intro f hf
    simp only [Function.comp_apply]
    exact yE_int D r s row.1 e f (rowsOK_true row hrow e he f hf).1
      (rowsOK_true row hrow e he f hf).2
  rw [List.map_congr_left hrow, Int.cast_list_sum, List.map_map, List.sum_map_mul_right, neg_mul]
  rfl


def rowsSym : Prop := ∀ row ∈ rows, ∀ e ∈ row.2.2, row.1 ≤ e.1 + e.2.1

theorem rowsSym_true : rowsSym := by
  unfold rowsSym
  decide +kernel

theorem yEI_symm (D r s t p j q l : ℕ) (a b : ℤ) (h1 : t ≤ p + j) (h2 : t ≤ q + l) :
    yEI D r s t (p, j, a) (q, l, b) = yEI D s r t (q, l, b) (p, j, a) := by
  simp only [yEI]
  have hT : q + l + (p + j - t) = p + j + (q + l - t) := by omega
  rw [hT, Nat.add_comm s r]
  by_cases hD : D ≤ p + j + (q + l - t)
  · rw [if_pos hD, if_pos hD]
    by_cases hv : VT r D (p + j + (q + l - t)) p j (q + l - t) = 0 ∨
        VT s D (p + j + (q + l - t)) q l (p + j - t) = 0
    · rw [if_pos hv, if_pos hv.symm]
    · rw [if_neg hv, if_neg (fun h => hv h.symm)]
      have he : (65 - 2 * ((p + j + (q + l - t) : ℕ) : ℤ) + (q : ℤ) + (p : ℤ) - (t : ℤ) +
          (((r + s) / 2 : ℕ) : ℤ)) = 65 - 2 * ((p + j + (q + l - t) : ℕ) : ℤ) + (p : ℤ) +
          (q : ℤ) - (t : ℤ) + (((r + s) / 2 : ℕ) : ℤ) := by ring
      rw [he]
      ring
  · rw [if_neg hD, if_neg hD]

theorem dswap {β : Type*} (l1 l2 : List β) (g : β → β → ℤ) :
    (l1.map fun e => (l2.map fun f => g e f).sum).sum =
      (l2.map fun f => (l1.map fun e => g e f).sum).sum := by
  induction l1 with
  | nil => simp
  | cons a l ih => simp [List.sum_map_add, ih]

theorem YI_symm (D r s : ℕ) : YI D r s = YI D s r := by
  unfold YI
  congr 1
  apply List.map_congr_left
  intro row hrow
  unfold yRI
  rw [dswap]
  congr 1
  apply List.map_congr_left
  intro f hf
  congr 1
  apply List.map_congr_left
  intro e he
  obtain ⟨p, j, a⟩ := e
  obtain ⟨q, l, b⟩ := f
  exact yEI_symm D r s row.1 p j q l a b (rowsSym_true row hrow _ he) (rowsSym_true row hrow _ hf)

end Aux_LaughlinY

