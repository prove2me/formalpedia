theorem _root_.solution (F : ℝ → ℂ) :
    paperRadialFourier F 0 = (2 * Real.pi / Real.sqrt 3 : ℂ) *
      ∫ t : ℝ in Ioi 0, F t := by
  have he : paperE 0 = 1 := by simp [paperE_eq_exp]
