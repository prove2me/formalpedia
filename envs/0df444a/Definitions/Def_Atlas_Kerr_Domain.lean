import Mathlib
import Definitions.Def_Atlas_Core_Basic
import Definitions.Def_KerrBL_CoordGeometry
import Definitions.Def_KerrBL_Kerr_Metric
/-!
# Kerr, Boyer–Lindquist coordinates: domain facts

Coordinates `(t, r, θ, φ) = (x 0, x 1, x 2, x 3)`; `Σ = r² + a² cos²θ`, `Δ = r² − 2Mr + a²`
(`KerrBL.Sig`, `KerrBL.Del`). The regular domain is `Σ ≠ 0`, `Δ ≠ 0`, `sin θ ≠ 0`, for every real
`M` and `a`. It contains both signs of `Δ`, negative `r` and the set `g_tt ≥ 0`; the only exclusions
are `Δ = 0` and `sin θ = 0` (where the chart matrix is singular) and `Σ = 0` (for `M ≠ 0` the ring
singularity, a genuine curvature singularity; here only a point set where the data are undefined).
No causal or global statement is made about any of these loci.
-/

open Real

namespace ExactVacuumAtlas.Kerr

/-- Regular Boyer–Lindquist domain `Σ ≠ 0 ∧ Δ ≠ 0 ∧ sin θ ≠ 0`. This is the proposition
`KerrBL.RegKerr M a x` of the verified Kerr path, written out as a set. -/
def domBL (M a : ℝ) : Set (Pt 4) :=
  {x | KerrBL.Sig a (x 1) (cos (x 2)) ≠ 0 ∧ KerrBL.Del M a (x 1) ≠ 0 ∧ sin (x 2) ≠ 0}

/-- Equatorial reference point `(0, ρ, π/2, 0)`. -/
noncomputable def eqPt (ρ : ℝ) : Pt 4 := ![0, ρ, π / 2, 0]

end ExactVacuumAtlas.Kerr


