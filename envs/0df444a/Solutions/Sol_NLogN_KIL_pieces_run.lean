          (IState.isInt_of hGb)
        refine (hbk.seq hd).mono' ?_ le_rfl
        simp only [NLogN.RS.repSt, Function.iterate_succ_apply']
        simp only [NLogN.RS.repSt] at hGb
        simp only [decSt, decE, Ex.eval, sub_eq_add_neg])
