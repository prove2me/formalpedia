open Complex

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

/-! ### `etaNull` and index bookkeeping -/

theorem etaNull_symm (i j : Fin 4) : etaNull i j = etaNull j i := by
  fin_cases i <;> fin_cases j <;> rfl

namespace NullFrameData

variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}

/-- Inverse metric from the frame: `g⁻¹ = E η Eᵀ`. -/
theorem cmat_gi_eq (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) :
    cmat gi x = frMat E x * etaNull * (frMat E x)ᵀ := by
  have hgg : cmat g x * cmat gi x = 1 := by
    have h := hN.metric.mul_inv hx
    have e : cmat g x * cmat gi x = (metricMatrix g x * metricMatrix gi x).map (fun t : ℝ => (t : ℂ)) :=
      (Matrix.map_mul (f := Complex.ofRealHom)).symm
    rw [e, h, Matrix.map_one _ (by simp) (by simp)]
  have hc := hN.compl hx
  rw [hN.coMat_eq hx] at hc
  calc cmat gi x = (frMat E x * (etaNull * (frMat E x)ᵀ * cmat g x)) * cmat gi x := by rw [hc, Matrix.one_mul]
    _ = frMat E x * etaNull * (frMat E x)ᵀ * (cmat g x * cmat gi x) := by simp only [Matrix.mul_assoc]
    _ = frMat E x * etaNull * (frMat E x)ᵀ := by rw [hgg, Matrix.mul_one]

