-- title:
--   Functional convergence to a continuous Gaussian process
-- statement:
--   A joint realization with the correct complete prelimit path laws, centered Gaussian finite-dimensional limit laws with covariance C(min(s,t)), and almost-sure compact-uniform convergence.
-- source:
--   Stewart N. Ethier and Thomas G. Kurtz, Markov Processes: Characterization and Convergence, Wiley, 1986. Chapter 7, Section 1, Theorems 1.1 and 1.4, printed pp. 338–340 (PDF pp. 347–349); Chapter 3, Theorem 1.8 and Proposition 5.3, printed pp. 102, 119.

import Mathlib

set_option autoImplicit true

open MeasureTheory ProbabilityTheory Filter TopologicalSpace
open scoped ENNReal NNReal Topology BigOperators

namespace EthierKurtz

/-- Full functional convergence to the continuous centered Gaussian process
with covariance C(min(s,t)). A joint canonical realization carries a continuous
limit and cadlag copies of EVERY prelimit with the correct entire path laws.
Compact-uniform a.s. convergence on this realization is equivalent to weak
Skorohod convergence to a continuous limit (Ch. 3 Thm. 1.8 and Prop. 5.3).
The ambient path sigma algebras are generated by time evaluations. -/
def ConvergesToContinuousGaussian {Ω : ℕ → Type*}
    [∀ n, MeasurableSpace (Ω n)] {d : ℕ}
    (P : ∀ n, Measure (Ω n))
    (M : ∀ n, ℝ≥0 → Ω n → EuclideanSpace ℝ (Fin d))
    (C : ℝ≥0 → Matrix (Fin d) (Fin d) ℝ) : Prop :=
  ∃ Q : Measure
      ({x : ℝ≥0 → EuclideanSpace ℝ (Fin d) // Continuous x} ×
        (ℕ → {x : ℝ≥0 → EuclideanSpace ℝ (Fin d) //
          (∀ t, ContinuousWithinAt x (Set.Ici t) t) ∧
          ∀ t : ℝ≥0, 0 < t → ∃ a, Tendsto x (𝓝[<] t) (𝓝 a)})),
    IsProbabilityMeasure Q ∧
    (∀ n, Measure.map (fun z => (z.2 n).val) Q =
      Measure.map (fun ω t => M n t ω) (P n)) ∧
    (∀ (k : ℕ) (t : Fin k → ℝ≥0),
      Measure.map (fun z => WithLp.toLp 2
        (fun ki : Fin k × Fin d => z.1.val (t ki.1) ki.2)) Q =
      multivariateGaussian 0 (fun ki lj => C (min (t ki.1) (t lj.1)) ki.2 lj.2)) ∧
    (∀ᵐ z ∂Q, ∀ T : ℝ≥0, ∀ ε : ℝ, 0 < ε →
      ∀ᶠ n in atTop, ∀ t : ℝ≥0, t ≤ T → ‖(z.2 n).val t - z.1.val t‖ < ε)

end EthierKurtz


