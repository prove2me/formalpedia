  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx IntMul.Kappa.R6.IL IntMul.Kappa.R6.IL3

/-- **Compact-control row additions as procedures** of any extension of `kTableP tab`
(the table form of `RowUCC`). -/
def RowUCCP (m : ℕ) (τ : ℝ) (tab : Fin 1 → IStmt HS 1) : Prop :=
  ∃ (nR : ℕ) (UR : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → Fin nR → IStmt HS (7 + E))
    (rowC : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → IStmt HS (7 + E)) (Kc : ℝ), 0 ≤ Kc ∧
    ∀ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (idx : Fin nR → Fin (7 + E)),
      (∀ q, kTableP tab ext (idx q) = UR E idx q) →
      ∀ Isym : List Sym, RowUCC m τ Isym (kTableP tab ext) (rowC E idx) Kc

/-- The row-procedure placement inside the list. -/
def iRH {nR E : ℕ} (idx : Fin (6 + nR) → Fin (7 + E)) : Fin nR → Fin (7 + E) :=
  fun q => idx ⟨q.val + 6, by omega⟩

/-- **The procedure list** of the round-six uniform Proposition 14. -/
noncomputable def UUH (c : Cfg) (nR : ℕ) (UR : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → Fin nR → IStmt HS (7 + E))
    (rowC : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → IStmt HS (7 + E)) (E : ℕ)
    (idx : Fin (6 + nR) → Fin (7 + E)) (i : Fin (6 + nR)) : IStmt HS (7 + E) :=
  if h6 : i.val < 6 then
  (if i.val = 0 then levCH c (idx ⟨0, by omega⟩) (rowC E (iRH idx))
  else if i.val = 1 then kerLoopC (idx ⟨1, by omega⟩) (idx ⟨0, by omega⟩)
  else if i.val = 2 then zloopC c (idx ⟨2, by omega⟩) (zcontC (idx ⟨3, by omega⟩))
  else if i.val = 3 then gloopC czH (idx ⟨3, by omega⟩) (gcontC (idx ⟨4, by omega⟩))
  else if i.val = 4 then dloopC c.m c.W (idx ⟨4, by omega⟩)
    (coreCH c (cWc c) (bodyCH c (idx ⟨1, by omega⟩) (idx ⟨0, by omega⟩)))
  else p14CH (idx ⟨2, by omega⟩))
  else UR E (iRH idx) ⟨i.val - 6, by have := i.isLt; omega⟩

end IntMul.Kappa.R6.IL3H

end

