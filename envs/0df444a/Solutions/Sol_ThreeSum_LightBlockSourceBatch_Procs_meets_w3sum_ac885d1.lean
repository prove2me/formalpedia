      [J, 512 * h, h, localPrime h, localBucketCap h, cut, modulus h J, occ, maps, candidates, histL, histR,
        sourceHistL, sourceHistR, base, downsetCap (J * (512 * h)) cut, count, banks base count,
        stride (J * (512 * h)) cut, maskBase base count (J * (512 * h)) cut, bitBase base count (J * (512 * h)) cut,
        rowOut base count (J * (512 * h)) cut, work base count (J * (512 * h)) cut]
