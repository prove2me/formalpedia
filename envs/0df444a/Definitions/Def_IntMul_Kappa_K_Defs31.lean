section
-- Source module: Solutions.KFV60LogNeed
/-!
# KFV §60: the logarithmic factor of the Kronecker products (`Log18Need`)

The Kronecker stage multiplies `2^n` pairs of integers of `m = 2 (kb · 2^ℓ + 2)` bits
(`kb = 2p + ℓ + 3`), each at cost `≤ fmB m = c (m+1) L₁ L₂` with
`L₁ = zsz(m+1) + 2 ≈ ℓ + log p` and `L₂ = zsz(L₁^4) + 1 ≈ log log`. **`Log18Need`**:
`L₁ L₂ ≤ c (ℓ + log₂ p + 1)(log p + 1)` for the paper's parameters (`p = 6 lg n` as in `Ncost`).
-/

namespace NLogN.KFV

open IntMul IntMul.OpenAI.Glue

/-- **The logarithmic factor of the Kronecker products** (pure arithmetic). -/
def Log18Need : Prop :=
  ∃ (c : ℝ) (n₁ : ℕ), ∀ n : ℕ, IntMul.OpenAI.Glue.n0 ≤ n → n₁ ≤ n →
    let p := pP n
    let ℓ := ℓP n
    let m := 2 * (NLogN.KFV.kb p ℓ * 2 ^ ℓ + 2)
    (((zsz ((m + 1 : ℕ) : ℤ) + 2) * (zsz (((zsz ((m + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1) : ℕ) : ℝ) ≤
      c * ((ℓ : ℝ) + Real.logb 2 (6 * (IntMul.lg n : ℝ)) + 1) *
        (Real.log (6 * (IntMul.lg n : ℝ)) + 1)

end NLogN.KFV

end

section
-- Source module: Solutions.KFAzGate
/-!
# KFAz: an explicit gate-class constant for the complex network

`GOKN`: a `GOK` gate whose atom list has pairwise distinct `(target, source)` pairs.  Every gate
of the complex schedule is `GOKN` (the coefficient maps `x ↦ (r x, c x)` of the four `egM`
gates are injective by `Inv.Good`), so its atom list has length at most `|W × W| = W_c²`.

**`complexIface_gclass_explicit`**: `GClass P8Lift.complexIface (Wc * Wc)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 512

namespace NLogN.KFAz

open Matrix Finset Complex NLogN.KFN

section Generic

variable {W : Type*} [Fintype W] [DecidableEq W]

/-- A `GOK` gate with pairwise distinct `(target, source)` pairs. -/
def GOKN (G : Matrix W W ℂ) : Prop :=
  ∃ l : List (W × W × ℤ × ℕ), G = 1 + eMat l ∧ (∀ x ∈ l, ∀ y ∈ l, x.1 ≠ y.2.1) ∧
    (∀ x ∈ l, (x.2.2.1 = 1 ∨ x.2.2.1 = -1) ∧ x.2.2.2 ≤ 1) ∧
    (l.map fun x => (x.1, x.2.1)).Nodup

end Generic

section Complex

variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}
variable {Wt : Type*} [Fintype Wt] [DecidableEq Wt]

end Complex

/-- The explicit atom bound `W_c²`. -/
abbrev A0 : ℕ := P8Lift.Wc * P8Lift.Wc

end NLogN.KFAz

end

section
-- Source module: Solutions.KFAzLen
/-!
# KFAz: an explicit bound on the length of the complex network

Every edge chunk (`chunkFor`) has at most `2m + 1` steps and exactly one child call when it is
non-empty, so the step list of a labelled net has length `≤ (2m+1)·#children + #gates`.  With
`#children = s_c` (`complexIface.count`), `#gates = 3·|T₀|²·(4|T₀|+4) + 1` and the `2W_c` phase
steps, **`net_length_le`**: `complexIface.net.length ≤ Lb`.  The kernel never evaluates the net.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 512

namespace NLogN.KFAz

open Finset P8Lift NetComplexP8

section Chunk

variable {R : Type} [Fintype R] [DecidableEq R] {m : ℕ}

end Chunk

section Net

variable {R : Type} [Fintype R] [DecidableEq R] {h : ℕ}

end Net

section Prog

variable {h : ℕ} {T : Type} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}

end Prog

/-- The explicit length bound. -/
def Lb : ℕ := 2 * Wc + 2 + 3 * (161700 * 161700) * (4 * 161700 + 4) + (2 * 100 ^ 3 + 1) * P8Lift.sc

end NLogN.KFAz

end

section
-- Source module: Solutions.KFAzEw
/-!
# KFAz: the width condition `EwB18` for the explicit constant `A0 = W_c²`

* `Gb_le`: `Gb(L, s_c, W_c, W_c²) ≤ 10^48 = (10^6)^8` (`net_length_le`: `L ≤ Lb < 10^34`).
* `ewb_le`: with `G ≤ (10^6)^8`, `EwB A D ≤ 2D + C (D+1)^11 + 2`, `C = 4000020 · 10^96`
  (`G^{log_{10^6} D} ≤ (D+1)^8`).
* **`ewB18_A0`**: `KFV.EwB18 A0` (`D = d - 1`, `d ≤ b^ε`, so `d^{2^75} ≤ b`).
* **`complexIface_gclass_ewB18`**: `∃ A, GClass complexIface A ∧ EwB18 A`.

The kernel never evaluates the net: its length only enters through `net_length_le`.
-/

namespace NLogN.KFAz

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RCost P8Lift

/-- The constant `C = (4·10^6 + 20) · 10^96`. -/
def Cw : ℕ := 4000020 * 10 ^ 96

/-- The threshold on `D + 1` above which `EwB ≤ d^12`. -/
def K0 : ℕ := Cw + 4
/-- The bound on `EwB` below the threshold. -/
def Mw : ℕ := 2 * NLogN.KFAz.K0 + Cw * NLogN.KFAz.K0 ^ 11 + 2

end NLogN.KFAz

end

section
-- Source module: Solutions.KFWImpl
/-!
# KFW: implementations by a single (uniform) program, parameters in the background

`SImplQ I iprog Q lo hi r st n T U e dw cost`: as `KFN.SImplI`, but

* the code `U` is **one** `IStmt` (not a family indexed by the width);
* the background `s` satisfies `Q s` (it holds the run-time parameters in registers);
* every managed stack other than the data stack `0` is empty (`Clean0 f`);
* the input width `w` lies in a window: `lo ≤ w` and `w + dw ≤ hi`.

`RImplQ` likewise.  Composition lemmas: `SImplQ.comp`, `RImplQ.comp`, `rImplQ_list`,
`sImplQ_of_rImplQ_roleDiag`; leaves from register programs: `sImplQ_leaf`, `rImplQ_leaf`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

/-- All managed stacks but the data stack are empty. -/
def Clean0 (f : Fin HS → List ℤ) : Prop := ∀ j : Fin HS, j ≠ 0 → f j = []

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- `U` implements the selected-bit operator `T` on backgrounds satisfying `Q`. -/
def SImplQ (I : List Sym) (iprog : Fin Pp → IStmt HS Pp) (Q : IState HS → Prop) (lo hi : ℕ)
    {ι : Type*} [Fintype ι] [DecidableEq ι]
    (r : ℕ) (st : ι → ℕ) (n : ℕ) (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (U : IStmt HS Pp)
    (e dw : ℕ) (cost : ℕ → ℕ) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ))
    (F w : ℕ), Q s → Clean0 f → f 0 = gflat zs ++ l → RecRep r F zs xs → xs.length = n →
    NLogN.KFB.GB w zs → lo ≤ w → w + dw ≤ hi →
    ∃ zs', RecRep r (F + e) zs' (selOpF st n T xs) ∧ NLogN.KFB.GB (w + dw) zs' ∧
      IRuns I iprog U (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 (gflat zs' ++ l))) (cost w)

section SQ

variable {Q : IState HS → Prop} {lo hi : ℕ}
variable {ι : Type*} [Fintype ι] [DecidableEq ι] {r : ℕ} {st : ι → ℕ} {n : ℕ}

end SQ

section RQ

variable {Q : IState HS → Prop} {lo hi : ℕ}
variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ] {r n : ℕ} {st : Fin m × κ → ℕ}

/-- `U` implements the network operator `A` on `W` role streams of `n` records each. -/
def RImplQ (I : List Sym) (iprog : Fin Pp → IStmt HS Pp) (Q : IState HS → Prop) (lo hi : ℕ)
    (r n : ℕ) (st : Fin m × κ → ℕ) (A : ROp (Fin W) m κ) (U : IStmt HS Pp) (e dw : ℕ)
    (cost : ℕ → ℕ) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (X : Fin W → List (Fin r → ℂ)) (F w : ℕ), Q s → Clean0 f → f 0 = gflat zs ++ l →
    RecRep r F zs (flatR X) → (∀ v, (X v).length = n) → NLogN.KFB.GB w zs → lo ≤ w → w + dw ≤ hi →
    ∃ zs', RecRep r (F + e) zs' (flatR (roleOpF st n A X)) ∧ NLogN.KFB.GB (w + dw) zs' ∧
      IRuns I iprog U (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 (gflat zs' ++ l))) (cost w)

/-- A sequence of programs. -/
def seqLQ {α : Type*} (code : α → IStmt HS Pp) : List α → IStmt HS Pp
  | [] => .skip
  | a :: l => .seq (code a) (seqLQ code l)

end RQ

section DiagQ

variable {Q : IState HS → Prop} {lo hi : ℕ}
variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ] {r n : ℕ} {st : Fin m × κ → ℕ}

end DiagQ

end NLogN.KFW

end

section
-- Source module: Solutions.KFWGate
/-!
# KFW: uniform pair passes, gates, swaps and leveling

The role length `L` of the pair passes (`KFG.pairW M L i j`) is read from a register `ρ`:

* `pairPz z`: `KFG.pairP` with the zip body `z` (`pairPz (zbS M) = pairP M`);
* `pairWG z ρ i j`: the counts `L, 2L, 2iL, 2(j-i-1)L` computed from `ρ`;
* `gatePG as e ρ`, `swapsG ρ l`: `gateP`, `swapsP` with `pairWG`;
* `zbLev ρE`, `levG W ρ ρE`: the leveling pass of `KFN.wrapCI` with the shift `2^e` read from
  the register `ρE` (`levG_href`).

Each comes with `HRef` to the literal instance after substituting the registers (`*_href`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex

/-- Stacks touched by the pair passes (other than the zip body and the role-length register). -/
def gT : List (Fin HS) := [0, 30, 31, 33, 34, 35, 36, 37, 38, 39, 40, 41, 48, 49, 50, 51, 52, 53, 54]

/-- The pair pass with zip body `z`. -/
def pairPz (z : RS) : RS :=
  .seq (NLogN.mvK 0 qP NLogN.KFB.c1 (.reg NLogN.KFB.rP)) (.seq (NLogN.mvK 0 NLogN.KFB.qT NLogN.KFB.c1 (.reg NLogN.KFB.rB2)) (.seq (distB rUr rUi)
  (.seq (NLogN.mvK 0 qQ NLogN.KFB.c1 (.reg rQ)) (.seq (NLogN.mvK 0 NLogN.KFB.qT NLogN.KFB.c1 (.reg NLogN.KFB.rB2)) (.seq (distB rVr rVi)
  (.seq (.rep NLogN.KFB.c1 (.reg NLogN.KFB.rB) z) (.seq (NLogN.mvK qO 0 NLogN.KFB.c1 (.reg NLogN.KFB.rB2)) (.seq (NLogN.mvK qQ 0 NLogN.KFB.c1 (.reg rQ))
  (.seq (NLogN.mvK NLogN.KFB.qA 0 NLogN.KFB.c1 (.reg NLogN.KFB.rB2)) (NLogN.mvK qP 0 NLogN.KFB.c1 (.reg NLogN.KFB.rP)))))))))))

/-- The pair pass with the role length read from `ρ`. -/
def pairWG (z : RS) (ρ : Fin HS) (i j : ℕ) : RS :=
  .seq (.push NLogN.KFB.rB (.reg ρ)) (.seq (.push NLogN.KFB.rB2 (.add (.reg ρ) (.reg ρ)))
  (.seq (.push NLogN.KFB.rP (.mul (.lit ((2 * i : ℕ) : ℤ)) (.reg ρ)))
  (.seq (.push rQ (.mul (.lit ((2 * (j - i - 1) : ℕ) : ℤ)) (.reg ρ)))
  (.seq (pairPz z) (.seq (.pop NLogN.KFB.rB) (.seq (.pop NLogN.KFB.rB2) (.seq (.pop NLogN.KFB.rP) (.pop rQ))))))))

/-- Registers off the pair-pass stacks. -/
def OffG (σ : Fin HS → Option ℤ) : Prop := ∀ i ∈ NLogN.KFW.gT, σ i = none

/-- The push overhead of one pair pass. -/
def Xq (Z : ℕ) : ℕ := 3 * 10 ^ 7 * (Z + 2) ^ 2

/-- The push overhead of one pair pass. -/
def Xp (Z : ℕ) : ℕ := 3 * Xq Z

/-! ## Fixed parts are unchanged by the substitution -/

/-! ## Gates -/

/-- `gateP` with the role length read from `ρ`. -/
def gatePG : List Atom → (ℕ → ℕ) → Fin HS → RS
  | [], _, _ => .skip
  | a :: as, e, ρ => .seq (if a.t < a.s then pairWG (zbS (a.M e)) ρ a.t a.s
      else pairWG (zbS (a.M e)) ρ a.s a.t) (gatePG as (a.sc e) ρ)

/-- `swapsP` with the role length read from `ρ`. -/
def swapsG (ρ : Fin HS) : List (ℕ × ℕ) → RS
  | [] => .skip
  | (i, j) :: l => .seq (pairWG (zbS NLogN.KFG.swS) ρ i j) (swapsG ρ l)

/-! ## Leveling -/

/-- `Σ c_t · x_t · top(r_t)` with shift expressions `x_t`. -/
def lsEx : List (ℤ × Ex HS × Fin HS) → Ex HS
  | [] => .lit 0
  | (c, x, r) :: l => .add (.shl (tmE c r) x) (lsEx l)

/-- The leveling matrix: `y_t ← 2^e y_t` (target role `t`, source role `0` with coefficient `0`). -/
def Mlev (e : ℕ) : M2S := ⟨scOne, scZero, ⟨(0, 0), 0⟩, ⟨(1, 0), e⟩⟩

/-- The zip body of the leveling pass with the shift `2^e` read from `ρE`. -/
def zbLev (ρE : Fin HS) : RS :=
  .seq (.push NLogN.KFB.qA (lsE (reS scOne scZero))) (.seq (.push NLogN.KFB.qA (lsE (imS scOne scZero)))
    (.seq (.push qO (lsEx [((0 : ℤ), .lit ((2 : ℤ) ^ 0), rUr), (-(0 : ℤ), .lit ((2 : ℤ) ^ 0), rUi),
        ((1 : ℤ), .reg ρE, rVr), (-(0 : ℤ), .reg ρE, rVi)]))
    (.seq (.push qO (lsEx [((0 : ℤ), .lit ((2 : ℤ) ^ 0), rUr), ((0 : ℤ), .lit ((2 : ℤ) ^ 0), rUi),
        ((0 : ℤ), .reg ρE, rVr), ((1 : ℤ), .reg ρE, rVi)]))
      (.seq (.pop rUr) (.seq (.pop rUi) (.seq (.pop rVr) (.pop rVi)))))))

/-- The leveling pass: targets `t = 1, …, W-1`, source `0`. -/
def levG (W : ℕ) (ρ ρE : Fin HS) : RS :=
  ((List.range W).filter fun t => t ≠ 0).foldr (fun t p => .seq (pairWG (zbLev ρE) ρ 0 t) p) .skip

/-! ## Written stacks -/

end NLogN.KFW

end

