/-! # Kinnersley-frame projections of the Kerr–Newman Faraday field (ATLAS-V-01)

IV's `KN.faradayKN a Q` (from the potential `A = −(Qr/Σ)(dt − a sin²θ dφ)`, `F = dA` proved in IV) is used unchanged; no
constant is rescaled. `F(u, v) = Σ F_{μν} u^μ v^ν` is the complex-**bilinear** contraction `ccontr`.
On `domReg M a Q`, every real `M a Q` (`a = 0`, `Q = 0` allowed):

    F(l,n)  = Q(r² − a²cos²θ)/Σ²,         F(m,m̄) = −2i Q a r cosθ/Σ²,
    F(l,m) = F(l,m̄) = F(n,m) = F(n,m̄) = 0,

and the full 4×4 frame matrix follows by antisymmetry (`faraday_frame`). With Hintz's convention
`Φ₀ = F₁₃ = F(l,m)`, `Φ₁ = ½(F₁₂ + F₄₃) = ½(F(l,n) + F(m̄,m))`, `Φ₂ = F₄₂ = F(m̄,n)` (arXiv:2609.33661v1, archived HTML;
see `notes/ATLAS_V_SOURCE_DICTIONARY.md`) we define the raw contractions `phi0K`, `phiC`, `phi2K` and prove
`Φ₀ = Φ₂ = 0`, `phiC = Q/(2 q̄²)` (the value stated in the source, `q̄ = ρ̄*`), `phiC ≠ 0` iff `Q ≠ 0`. The name `phiC`
marks a local definition (formula above), not a claim about other references' `φ₁` normalisation. -/

open Real
open scoped ComplexConjugate Matrix
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del faradayKN domReg)

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin

/-! ### Real contractions -/

section RealF
variable {M a Q : ℝ} {x : Pt 4}

end RealF

/-! ### The six independent frame components -/

section Frame
variable {M a Q : ℝ} {x : Pt 4}

end Frame

/-! ### Maxwell scalars in Hintz's convention (raw contractions) -/

/-- `Φ₀ = F₁₃ = F(l, m)`. -/
noncomputable def phi0K (M a Q : ℝ) (x : Pt 4) : ℂ := ccontr (faradayKN a Q) x (knL M a Q x) (knM a x)

/-- `Φ₁ = ½(F₁₂ + F₄₃) = ½(F(l,n) + F(m̄,m))` — local name `phiC` (see module docstring). -/
noncomputable def phiC (M a Q : ℝ) (x : Pt 4) : ℂ :=
  (ccontr (faradayKN a Q) x (knL M a Q x) (knN M a Q x) + ccontr (faradayKN a Q) x (knMbar a x) (knM a x)) / 2

/-- `Φ₂ = F₄₂ = F(m̄, n)`. -/
noncomputable def phi2K (M a Q : ℝ) (x : Pt 4) : ℂ := ccontr (faradayKN a Q) x (knMbar a x) (knN M a Q x)

section Scalars
variable {M a Q : ℝ} {x : Pt 4}

end Scalars

end ExactVacuumAtlas.EinsteinMaxwell.NP


