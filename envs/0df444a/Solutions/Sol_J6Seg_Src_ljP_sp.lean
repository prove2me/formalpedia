/-!
# B-line IL, source-table producers, part 4: `ljP`, the backward pass

State after `k` backward steps (`m = s - k` positions left, the next one `j = m - 1`): `14` holds
the forward starts of `0, …, m-1` (last first) over the sentinel, `15` the block end
`ncv m = eB (m-1)`, and `30, 31, 32, 33` the outputs on positions `m, …, s-1`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg.PreT J6Seg

section lists
variable (s t lam w : ℕ)

variable {s t lam w}

theorem drp_zero : drp s 0 = List.range s := by simp [drp]

end lists

end J6Seg.Src

