-- title:
--   Norms to ℚ(j) are integer polynomials in j
-- statement:
--   Let $p$ be a prime. Write $F$ for the intermediate field [`ModularCurve.modularFunctionFieldFull p`](def/ModularCurve_X0.html#L305) of $\mathbb{Q} \subseteq \mathrm{LaurentSeries}\,\mathbb{Q}$, namely the field generated over $\mathbb{Q}$ by the $q$-expansions $\mathrm{qExpand}\,\mathbb{Q}\,d\,(jq)$ for the nonzero divisors $d$ of $p$, and let $j =$ `IgusaScheme.jFull p` be the element of $F$ given by the $q$-expansion of the modular invariant. Let $y \in F$ lie in [`AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ℤ F j`](def/AlgebraicCurve_TwoChartIntegralModel.html#L142), that is, in the subalgebra of those elements of $F$ that are integral over the $\mathbb{Z}$-subalgebra $\mathbb{Z}[j] =$ `Algebra.adjoin ℤ {j}` of $F$. Let $\mathbb{Q}(j) =$ `IntermediateField.adjoin ℚ {j}` be the subfield of $F$ generated by $j$ over $\mathbb{Q}$. The conclusion asserts the existence of a polynomial $M \in \mathbb{Z}[X]$ whose value at $j$, computed in $F$, equals the image in $F$ of the relative algebra norm $\mathrm{N}_{F/\mathbb{Q}(j)}(y) \in \mathbb{Q}(j)$, the determinant of multiplication by $y$ on the finite-dimensional $\mathbb{Q}(j)$-vector space $F$.
--
--   This is the integrality ("norm trick") step for the $j$-finite chart of the integral model of the modular curve: the norm down to $\mathbb{Q}(j)$ of a function integral over $\mathbb{Z}[j]$ again lies in $\mathbb{Z}[j]$, because $j$ is transcendental, so $\mathbb{Z}[j]$ is a polynomial ring, hence integrally closed with fraction field $\mathbb{Q}(j)$, and $F/\mathbb{Q}(j)$ is finite. It feeds the degree computation [`ModularCurve.HpoolLevelRing.finrank_rat_tensorProduct_quotient_span_aeval`](thm.html#ModularCurve.HpoolLevelRing.finrank_rat_tensorProduct_quotient_span_aeval) and the leading-coefficient analysis [`ModularCurve.exists_leadingCoeff_eq_mul_pow_of_aeval_jFull_eq_norm_aeval_modularUnitSeries`](thm.html#ModularCurve.exists_leadingCoeff_eq_mul_pow_of_aeval_jFull_eq_norm_aeval_modularUnitSeries).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_exists_aeval_jFull_eq_norm_of_mem_chartAlgFin.lean

import Mathlib
import Definitions.Def_ModularCurve_IgusaScheme
import Definitions.Def_AlgebraicCurve_TwoChartIntegralModel

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open ModularCurve Polynomial

theorem ModularCurve.exists_aeval_jFull_eq_norm_of_mem_chartAlgFin
    (p : ℕ) [Fact p.Prime] [NeZero p]
    (y : ↥(ModularCurve.modularFunctionFieldFull p))
    (hy : y ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ℤ ↥(ModularCurve.modularFunctionFieldFull p) (IgusaScheme.jFull p)) :
    ∃ M : Polynomial ℤ,
      (Polynomial.aeval (IgusaScheme.jFull p) M : ↥(ModularCurve.modularFunctionFieldFull p)) =
        algebraMap ↥(IntermediateField.adjoin ℚ ({IgusaScheme.jFull p} : Set ↥(ModularCurve.modularFunctionFieldFull p))) ↥(ModularCurve.modularFunctionFieldFull p)
          (Algebra.norm ↥(IntermediateField.adjoin ℚ ({IgusaScheme.jFull p} : Set ↥(ModularCurve.modularFunctionFieldFull p))) y) := by sorry
