theorem child05_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu022.lin : ℝ) ≤ (S : ℝ) * logProd gu022.lo) :
    (gu026.lfin : ℝ) ≤ (S : ℝ) * logProd gu026.top ∧
      (∀ x : ℝ, (gu022.lo : ℝ) < x → x ≤ (gu026.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u022 hγ hstate
  have s1 := sol_u023 hγ (by simpa [gu022, gu023] using s0.1)
  have s2 := sol_u024 hγ (by simpa [gu023, gu024] using s1.1)
  have s3 := sol_u025 hγ (by simpa [gu024, gu025] using s2.1)
  have s4 := sol_u026 hγ (by simpa [gu025, gu026] using s3.1)
  refine ⟨s4.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu022.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu023.lo : ℝ) < x := by
        have hb : (gu022.top : ℝ) = (gu023.lo : ℝ) := by simp [gu022, gu023]
        linarith
    by_cases h1 : x ≤ (gu023.top : ℝ)
    · exact s1.2 x hx1 h1
    · have hx2 : (gu024.lo : ℝ) < x := by
          have hb : (gu023.top : ℝ) = (gu024.lo : ℝ) := by simp [gu023, gu024]
          linarith
      by_cases h2 : x ≤ (gu024.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu025.lo : ℝ) < x := by
            have hb : (gu024.top : ℝ) = (gu025.lo : ℝ) := by simp [gu024, gu025]
            linarith
        by_cases h3 : x ≤ (gu025.top : ℝ)
        · exact s3.2 x hx3 h3
        · have hx4 : (gu026.lo : ℝ) < x := by
              have hb : (gu025.top : ℝ) = (gu026.lo : ℝ) := by simp [gu025, gu026]
              linarith
