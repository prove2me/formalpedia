-- Source module: Solutions.J6SegVal3
/-!
# B-line value bounds 3: the arrays of one axis (`arrS6 … arrY26`)

Entrywise bounds `PB (2^e)` through the passes of `axisPipe` at the round-six parameters, with the
stage-table bound (`TabB`) and the `J`-kernel row bound as hypotheses:

* `val_S`: `GB (p+2) L` and `p + 1 ≤ Q` give `S ≤ 2^(Q+1)`;
* `val_Y`, `val_Y2`: the chunk pass adds `7a + 2ℓ` (`λ = 2^ℓ`, tables `≤ 2^(Q+a)`);
* `val_J`, `val_Wp`: gather / scatter keep bounds;
* `val_W`: the `J` pass, from a per-row bound of `liftG jKer`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Val
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function J6Seg

section arr
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) (L : List GI)

theorem abs_le_of_zsz {a : ℤ} {e : ℕ} (h : zsz a ≤ e) : |a| ≤ 2 ^ e :=
  ((abs_lt_two_pow_zsz a).trans_le (pow_le_pow_right₀ (by norm_num) h)).le

theorem val_S (hQ : axp6 P n + 1 ≤ axQ6 P n src k) (hL : GB (pP6 P n + 2) L) :
    ∀ z ∈ arrS6 P n src D k L, PB (2 ^ (axQ6 P n src k + 1)) z := by
  unfold arrS6
  refine slabPass_pr (Pr := fun z : GI => zsz z.1 ≤ pP6 P n + 2 ∧ zsz z.2 ≤ pP6 P n + 2)
    (PB_default (by positivity)) ?_ hL
  intro l z hz
  have e : axQ6 P n src k + 1 = (pP6 P n + 2) + (axQ6 P n src k - axp6 P n - 1) := by
    unfold axp6 at hQ ⊢; omega
  have hk : ∀ a : ℤ, zsz a ≤ pP6 P n + 2 →
      |a * 2 ^ (axQ6 P n src k - axp6 P n - 1)| ≤ 2 ^ (axQ6 P n src k + 1) := by
    intro a ha
    rw [abs_mul, e, pow_add, abs_of_pos (by positivity : (0 : ℤ) < 2 ^ _)]
    exact mul_le_mul_of_nonneg_right (abs_le_of_zsz ha) (by positivity)
  exact ⟨hk _ hz.1, hk _ hz.2⟩

/-- The chunk pass on any input: `PB (2^e)` to `PB (2^(e + 7a + 2ℓ))`. -/
theorem val_chunkPass {a ℓ e : ℕ} (hl : axl6 P n = 2 ^ ℓ)
    (hT : TabB (2 ^ (axQ6 P n src k + a)) (axl6 P n)
      (TT (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)))
    {X : List GI} (hX : ∀ z ∈ X, PB (2 ^ e) z) :
    ∀ z ∈ kerPass (axl6 P n) (axpost6 P n D k) (axpre6 P n D k * axnc6 P n k)
      (fun b => liftG (chunkK (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
        (axα6 P n) (b % axnc6 P n k))) X, PB (2 ^ (e + 7 * a + 2 * ℓ)) z := by
  refine kerPass_pr (PB_default (by positivity)) (PB_default (by positivity)) ?_ hX
  intro b Y hYl hY
  exact liftG_pr (n := axl6 P n) (fun v hv hvb => chunkK_bnd hl hT _ hv.le hvb) hYl hY

theorem val_Y {a ℓ e : ℕ} (hl : axl6 P n = 2 ^ ℓ)
    (hT : TabB (2 ^ (axQ6 P n src k + a)) (axl6 P n)
      (TT (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)))
    (hS : ∀ z ∈ arrS6 P n src D k L, PB (2 ^ e) z) :
    ∀ z ∈ arrY6 P n src D k L, PB (2 ^ (e + 7 * a + 2 * ℓ)) z :=
  val_chunkPass P n src D k hl hT hS

theorem val_Y2 {a ℓ e : ℕ} (hl : axl6 P n = 2 ^ ℓ)
    (hT : TabB (2 ^ (axQ6 P n src k + a)) (axl6 P n)
      (TT (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axα6 P n)))
    (hS : ∀ z ∈ arrWp6 P n src D k L, PB (2 ^ e) z) :
    ∀ z ∈ arrY26 P n src D k L, PB (2 ^ (e + 7 * a + 2 * ℓ)) z :=
  val_chunkPass P n src D k hl hT hS

theorem val_J {B : ℤ} (hB : 0 ≤ B) (hY : ∀ z ∈ arrY6 P n src D k L, PB B z) :
    ∀ z ∈ arrJ6 P n src D k L, PB B z := by
  unfold arrJ6; exact slabPass_pr (Pr := PB B) (PB_default hB) (fun _ _ h => h) hY

theorem val_Wp {B : ℤ} (hB : 0 ≤ B) (hW : ∀ z ∈ arrW6 P n src D k L, PB B z) :
    ∀ z ∈ arrWp6 P n src D k L, PB B z := by
  unfold arrWp6; exact slabPass_pr (Pr := PB B) (PB_default hB) (fun _ _ h => h) hW

theorem val_W {B B' : ℤ} (hB : 0 ≤ B) (hB' : 0 ≤ B')
    (hJ : ∀ x : List GI, x.length = axG6 P n src k → (∀ z ∈ x, PB B z) →
      ∀ y ∈ liftG (jKer (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
        (axw6 P n) (axα6 P n) (axw6 P n) (axG6 P n src k)) x, PB B' y)
    (hJg : ∀ z ∈ arrJ6 P n src D k L, PB B z) :
    ∀ z ∈ arrW6 P n src D k L, PB B' z := by
  unfold arrW6; exact kerPass_pr (PB_default hB') (PB_default hB) (fun _ X hX hXp => hJ X hX hXp) hJg

/-- `PB (2^e)` gives `GB w` once `e + 1 ≤ w`. -/
theorem GB_of_PB {e w : ℕ} (hw : e + 1 ≤ w) {X : List GI} (h : ∀ z ∈ X, PB (2 ^ e) z) : GB w X :=
  fun z hz => ⟨(zsz_of_abs (h z hz).1).trans hw, (zsz_of_abs (h z hz).2).trans hw⟩

/-- `PB A` is `KR.AB A`. -/
theorem AB_of_PB {A : ℤ} {X : List GI} (h : ∀ z ∈ X, PB A z) : KR.AB A X := h

end arr

end J6Seg.Val
end

end

section
-- Source module: Solutions.J6SegVal4
/-!
# B-line value bounds 4: size arithmetic at `Q = segPF p d s`

All from the definition `segPF p d s = p + 1 + p/7 + size (NF d s)`, with
`NF d s ≥ (λ_F + 1)(2w + 1)(s + 1)²` (no regime hypotheses):
`p + 1 ≤ Q`, `7(R + 2) ≤ Q + 13`, `log₂ λ_F < Q`, `size (2w+1) ≤ Q`, `(s+1)² < 2^Q`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.Val
open J6Seg

section ar
variable (p d s : ℕ)

theorem NF_pos_factors : (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2 ≤ NF d s := by
  unfold NF
  have h1 : 1 ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) := by omega
  calc (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2
      = 1 * (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2 := by ring
    _ ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) *
        (s + 1) ^ 2 := by
        apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right
        exact h1

theorem NF_lt_Q : NF d s < 2 ^ segPF p d s := by
  have h := Nat.lt_size_self (NF d s)
  exact h.trans_le (Nat.pow_le_pow_right (by norm_num) (by unfold segPF; omega))

theorem le_NF_lam : lamF d + 1 ≤ NF d s := by
  have := NF_pos_factors d s
  have h2 : 1 ≤ (2 * wF d + 1) * (s + 1) ^ 2 := Nat.one_le_iff_ne_zero.2 (by positivity)
  calc lamF d + 1 = (lamF d + 1) * 1 := by ring
    _ ≤ (lamF d + 1) * ((2 * wF d + 1) * (s + 1) ^ 2) := Nat.mul_le_mul_left _ h2
    _ = _ := by ring
    _ ≤ _ := this

theorem le_NF_w : 2 * wF d + 1 ≤ NF d s := by
  have := NF_pos_factors d s
  have h2 : 1 ≤ (lamF d + 1) * (s + 1) ^ 2 := Nat.one_le_iff_ne_zero.2 (by positivity)
  calc 2 * wF d + 1 = (2 * wF d + 1) * 1 := by ring
    _ ≤ (2 * wF d + 1) * ((lamF d + 1) * (s + 1) ^ 2) := Nat.mul_le_mul_left _ h2
    _ = _ := by ring
    _ ≤ _ := this

theorem le_NF_s : (s + 1) ^ 2 ≤ NF d s := by
  have := NF_pos_factors d s
  have h2 : 1 ≤ (lamF d + 1) * (2 * wF d + 1) := Nat.one_le_iff_ne_zero.2 (by positivity)
  calc (s + 1) ^ 2 = 1 * (s + 1) ^ 2 := by ring
    _ ≤ (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2 := Nat.mul_le_mul_right _ h2
    _ ≤ _ := this

theorem p_succ_le_Q : p + 1 ≤ segPF p d s := by unfold segPF; omega

theorem sevenR_le_Q : 7 * (p / 7 + 2) ≤ segPF p d s + 13 := by
  unfold segPF; omega

theorem log_lam_lt_Q : Nat.log 2 (lamF d) < segPF p d s := by
  have h1 : lamF d < 2 ^ segPF p d s :=
    lt_of_lt_of_le (by have := le_NF_lam d s; omega) (NF_lt_Q p d s).le
  by_cases h0 : lamF d = 0
  · rw [h0, Nat.log_zero_right]; unfold segPF; omega
  · have h2 := Nat.pow_log_le_self 2 h0
    have h3 : 2 ^ Nat.log 2 (lamF d) < 2 ^ segPF p d s := lt_of_le_of_lt h2 h1
    exact (Nat.pow_lt_pow_iff_right (by norm_num)).1 h3

theorem size_w_le_Q : Nat.size (2 * wF d + 1) ≤ segPF p d s := by
  rw [Nat.size_le]
  exact lt_of_le_of_lt (le_NF_w d s) (NF_lt_Q p d s)

theorem s_sq_lt_Q : (s + 1) ^ 2 < 2 ^ segPF p d s :=
  lt_of_le_of_lt (le_NF_s d s) (NF_lt_Q p d s)

/-- `2^⌈log₂ m⌉ ≤ 2m + 1`. -/
theorem pow_clog_le (m : ℕ) : 2 ^ Nat.clog 2 m ≤ 2 * m + 1 := by
  rcases Nat.lt_or_ge 1 m with h | h
  · have h1 := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) h
    have hc : 0 < Nat.clog 2 m := Nat.clog_pos (by norm_num) h
    have e : 2 ^ Nat.clog 2 m = 2 * 2 ^ (Nat.clog 2 m).pred := by
      rw [← pow_succ']; congr 1; exact (Nat.succ_pred_eq_of_pos hc).symm
    omega
  · have : Nat.clog 2 m = 0 := Nat.clog_of_right_le_one h 2
    rw [this]; omega

end ar

end J6Seg.Val

end

