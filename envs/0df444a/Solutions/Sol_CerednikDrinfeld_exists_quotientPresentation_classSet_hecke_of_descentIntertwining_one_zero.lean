    obtain ⟨hsq0, hsq1, hcomm⟩ := hrel_img j

    have hconj0 : ∀ x : PGL(2, ↥(ValuationSubring.ratClosure A₁)), x ∈ (Γ₁ j).map ρ₁ → ρ₁ (w₁ j) * x * (ρ₁ (w₁ j))⁻¹ ∈ (Γ₁ j).map ρ₁ := fun x hx => by
      rw [hnormimg j (w₁ j) (hAL j).1]; have e0 : (ρ₁ (w₁ j))⁻¹ * (ρ₁ (w₁ j) * x * (ρ₁ (w₁ j))⁻¹) * ρ₁ (w₁ j) = x := by group
      rw [e0]; exact hx
    have hconj1 : ∀ x : PGL(2, ↥(ValuationSubring.ratClosure A₁)), x ∈ (Γ₁ j).map ρ₁ → ρ₁ (wbar₁ j) * x * (ρ₁ (wbar₁ j))⁻¹ ∈ (Γ₁ j).map ρ₁ := fun x hx => by
      rw [hnormimg j (wbar₁ j) (hAL j).2.1]; have e0 : (ρ₁ (wbar₁ j))⁻¹ * (ρ₁ (wbar₁ j) * x * (ρ₁ (wbar₁ j))⁻¹) * ρ₁ (wbar₁ j) = x := by group
      rw [e0]; exact hx

    have eqE : ∀ (p p' : Equiv.Perm (E j)), (∀ e : E j, ((p e).1 : Mumford.QuotEdge ↥((Γ₁ j).map ρ₁) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁))) = (p' e).1) → p = p' :=
      fun p p' h => Equiv.ext fun e => Subtype.ext (h e)
    have e00 : h₀ * h₀ = 1 := by
      apply eqE; intro e
      show ((h₀ (h₀ e)).1 : Mumford.QuotEdge _ _) = e.1
      rw [hh₀ (h₀ e), hh₀ e]
      obtain ⟨x, hx, hxe⟩ := houtrel j (((ρ₁ (w₁ j)) • e.1.out).symm)
      rw [hxe]
      simp only [Mumford.smul_dart_symm, SimpleGraph.Dart.symm_symm, smul_smul]
      have e1 : (ρ₁ (w₁ j)) * (x * (ρ₁ (w₁ j))) = ((ρ₁ (w₁ j)) * x * ((ρ₁ (w₁ j)))⁻¹) * ((ρ₁ (w₁ j)) * (ρ₁ (w₁ j))) := by group
      have e2 : (ρ₁ (w₁ j)) * x * (ρ₁ (w₁ j)) = ((ρ₁ (w₁ j)) * x * ((ρ₁ (w₁ j)))⁻¹) * ((ρ₁ (w₁ j)) * (ρ₁ (w₁ j))) := by group
      first
        | (rw [e1]; exact (horbD j _ (Subgroup.mul_mem _ (hconj0 x hx) hsq0) e.1.out).trans (Quotient.out_eq e.1))
        | (rw [e2]; exact (horbD j _ (Subgroup.mul_mem _ (hconj0 x hx) hsq0) e.1.out).trans (Quotient.out_eq e.1))
    have e11 : h₁ * h₁ = 1 := by
      apply eqE; intro e
      show ((h₁ (h₁ e)).1 : Mumford.QuotEdge _ _) = e.1
      rw [hh₂ (h₁ e), hh₂ e]
      obtain ⟨x, hx, hxe⟩ := houtrel j ((ρ₁ (wbar₁ j)) • e.1.out)
      rw [hxe]
      simp only [smul_smul]
      have e1 : (ρ₁ (wbar₁ j)) * (x * (ρ₁ (wbar₁ j))) = ((ρ₁ (wbar₁ j)) * x * ((ρ₁ (wbar₁ j)))⁻¹) * ((ρ₁ (wbar₁ j)) * (ρ₁ (wbar₁ j))) := by group
      have e2 : (ρ₁ (wbar₁ j)) * x * (ρ₁ (wbar₁ j)) = ((ρ₁ (wbar₁ j)) * x * ((ρ₁ (wbar₁ j)))⁻¹) * ((ρ₁ (wbar₁ j)) * (ρ₁ (wbar₁ j))) := by group
      first
        | (rw [e1]; exact (horbD j _ (Subgroup.mul_mem _ (hconj1 x hx) hsq1) e.1.out).trans (Quotient.out_eq e.1))
        | (rw [e2]; exact (horbD j _ (Subgroup.mul_mem _ (hconj1 x hx) hsq1) e.1.out).trans (Quotient.out_eq e.1))
    have e01 : h₀ * h₁ = h₁ * h₀ := by
      apply eqE; intro e
      show ((h₀ (h₁ e)).1 : Mumford.QuotEdge _ _) = (h₁ (h₀ e)).1
      rw [hh₀ (h₁ e), hh₂ e, hh₂ (h₀ e), hh₀ e]
      obtain ⟨x, hx, hxe⟩ := houtrel j ((ρ₁ (wbar₁ j)) • e.1.out)
      obtain ⟨y, hy, hye⟩ := houtrel j (((ρ₁ (w₁ j)) • e.1.out).symm)
      rw [hxe, hye]
      simp only [Mumford.smul_dart_symm, smul_smul]

      have eL : ∀ z : PGL(2, ↥(ValuationSubring.ratClosure A₁)), (ρ₁ (w₁ j)) * (x * (ρ₁ (wbar₁ j))) = z ∨ (ρ₁ (w₁ j)) * x * (ρ₁ (wbar₁ j)) = z → z = ((ρ₁ (w₁ j)) * x * ((ρ₁ (w₁ j)))⁻¹) * ((ρ₁ (w₁ j)) * (ρ₁ (wbar₁ j))) := by
        rintro z (rfl | rfl) <;> group
      have eR : ∀ z : PGL(2, ↥(ValuationSubring.ratClosure A₁)), (ρ₁ (wbar₁ j)) * (y * (ρ₁ (w₁ j))) = z ∨ (ρ₁ (wbar₁ j)) * y * (ρ₁ (w₁ j)) = z →
          z = (((ρ₁ (wbar₁ j)) * y * ((ρ₁ (wbar₁ j)))⁻¹) * ((ρ₁ (w₁ j)) * (ρ₁ (wbar₁ j)) * ((ρ₁ (w₁ j)))⁻¹ * ((ρ₁ (wbar₁ j)))⁻¹)⁻¹) * ((ρ₁ (w₁ j)) * (ρ₁ (wbar₁ j))) := by
        rintro z (rfl | rfl) <;> group
      have hmL : (ρ₁ (w₁ j)) * x * ((ρ₁ (w₁ j)))⁻¹ ∈ (Γ₁ j).map ρ₁ := hconj0 x hx
      have hmR : ((ρ₁ (wbar₁ j)) * y * ((ρ₁ (wbar₁ j)))⁻¹) * ((ρ₁ (w₁ j)) * (ρ₁ (wbar₁ j)) * ((ρ₁ (w₁ j)))⁻¹ * ((ρ₁ (wbar₁ j)))⁻¹)⁻¹ ∈ (Γ₁ j).map ρ₁ :=
        Subgroup.mul_mem _ (hconj1 y hy) (Subgroup.inv_mem _ hcomm)
      have kL : (Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart) (((ρ₁ (w₁ j)) * (x * (ρ₁ (wbar₁ j)))) • e.1.out.symm) : Mumford.QuotEdge _ _) =
          Quotient.mk _ (((ρ₁ (w₁ j)) * (ρ₁ (wbar₁ j))) • e.1.out.symm) := by
        rw [eL ((ρ₁ (w₁ j)) * (x * (ρ₁ (wbar₁ j)))) (Or.inl rfl), mul_smul]; exact horbD j _ hmL _
      have kL' : (Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart) (((ρ₁ (w₁ j)) * x * (ρ₁ (wbar₁ j))) • e.1.out.symm) : Mumford.QuotEdge _ _) =
          Quotient.mk _ (((ρ₁ (w₁ j)) * (ρ₁ (wbar₁ j))) • e.1.out.symm) := by
        rw [eL ((ρ₁ (w₁ j)) * x * (ρ₁ (wbar₁ j))) (Or.inr rfl), mul_smul]; exact horbD j _ hmL _
      have kR : (Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart) (((ρ₁ (wbar₁ j)) * (y * (ρ₁ (w₁ j)))) • e.1.out.symm) : Mumford.QuotEdge _ _) =
          Quotient.mk _ (((ρ₁ (w₁ j)) * (ρ₁ (wbar₁ j))) • e.1.out.symm) := by
        rw [eR ((ρ₁ (wbar₁ j)) * (y * (ρ₁ (w₁ j)))) (Or.inl rfl), mul_smul]; exact horbD j _ hmR _
      have kR' : (Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart) (((ρ₁ (wbar₁ j)) * y * (ρ₁ (w₁ j))) • e.1.out.symm) : Mumford.QuotEdge _ _) =
          Quotient.mk _ (((ρ₁ (w₁ j)) * (ρ₁ (wbar₁ j))) • e.1.out.symm) := by
        rw [eR ((ρ₁ (wbar₁ j)) * y * (ρ₁ (w₁ j))) (Or.inr rfl), mul_smul]; exact horbD j _ hmR _
      first | rw [kL, kR] | rw [kL', kR'] | rw [kL, kR'] | rw [kL', kR]
    obtain ⟨f, hf⟩ := liftχ (Equiv.Perm (E j)) h₀ e00
    have hf0 : ∀ τ, f τ * h₀ = h₀ * f τ := fun τ => by
      rw [hf]; by_cases h : χ₁ τ = 1 <;> simp only [h, if_true, if_false, one_mul, mul_one]
    have hf1 : ∀ τ, f τ * h₁ = h₁ * f τ := fun τ => by
      rw [hf]; by_cases h : χ₁ τ = 1
      · simp only [h, if_true, one_mul, mul_one]
      · simp only [h, if_false]; exact e01
    obtain ⟨F, hFι, hF0, hF1⟩ := huniv₁ (Equiv.Perm (E j)) f h₀ h₁ e00 e11 e01 hf0 hf1
    refine ⟨F, fun e => by rw [hF0]; exact hh₀ e, fun e => by rw [hF1]; exact hh₂ e, fun τ hτ => ?_, fun τ hτ => ?_⟩
    · rw [hFι, hf, if_pos hτ]
    · rw [hFι, hf, if_neg hτ, hF0]
  choose πE₁ hπE0 hπE1 hπEe hπEo using πEdata

  let D : ∀ j : HeckeTower.Obj q q', DegeneracyData (E j) (V j) := fun j =>
    { a := fun e => Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₁))) e.1.out.fst
      b := fun e => Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₁))) e.1.out.snd
      w := fun e => Nat.toPNat' (Nat.card (MulAction.stabilizer ↥((Γ₁ j).map ρ₁) e.1.out)) }

  have hstab_conj : ∀ (X : Subgroup PGL(2, ↥(ValuationSubring.ratClosure A₁))) (m : PGL(2, ↥(ValuationSubring.ratClosure A₁))), (∀ d : PGL(2, ↥(ValuationSubring.ratClosure A₁)), d ∈ X ↔ m⁻¹ * d * m ∈ X) →
      ∀ d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart, Nat.card (MulAction.stabilizer (↥X) (m • d)) = Nat.card (MulAction.stabilizer (↥X) d) := by
    intro X m hm d
    have hm' : ∀ x : PGL(2, ↥(ValuationSubring.ratClosure A₁)), x ∈ X → m * x * m⁻¹ ∈ X := fun x hx => by
      rw [hm]; have e0 : m⁻¹ * (m * x * m⁻¹) * m = x := by group
      rw [e0]; exact hx
    refine Nat.card_congr
      ⟨fun s => ⟨⟨m⁻¹ * (s.1 : PGL(2, ↥(ValuationSubring.ratClosure A₁))) * m, (hm _).1 s.1.2⟩, ?_⟩, fun s => ⟨⟨m * (s.1 : PGL(2, ↥(ValuationSubring.ratClosure A₁))) * m⁻¹, hm' _ s.1.2⟩, ?_⟩, ?_, ?_⟩
    · have hs : (s.1 : PGL(2, ↥(ValuationSubring.ratClosure A₁))) • (m • d) = m • d := s.2
      show (m⁻¹ * (s.1 : PGL(2, ↥(ValuationSubring.ratClosure A₁))) * m) • d = d
      rw [mul_smul, mul_smul, hs, inv_smul_smul]
    · have hs : (s.1 : PGL(2, ↥(ValuationSubring.ratClosure A₁))) • d = d := s.2
      show (m * (s.1 : PGL(2, ↥(ValuationSubring.ratClosure A₁))) * m⁻¹) • (m • d) = m • d
      rw [mul_smul, mul_smul, inv_smul_smul, hs]
    · intro s; apply Subtype.ext; apply Subtype.ext; show m * (m⁻¹ * (s.1 : PGL(2, ↥(ValuationSubring.ratClosure A₁))) * m) * m⁻¹ = s.1; group
    · intro s; apply Subtype.ext; apply Subtype.ext; show m⁻¹ * (m * (s.1 : PGL(2, ↥(ValuationSubring.ratClosure A₁))) * m⁻¹) * m = s.1; group
  have hstab_symm : ∀ (X : Subgroup PGL(2, ↥(ValuationSubring.ratClosure A₁))) (d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart),
      Nat.card (MulAction.stabilizer (↥X) d.symm) = Nat.card (MulAction.stabilizer (↥X) d) := by
    intro X d
    refine Nat.card_congr ⟨fun s => ⟨s.1, ?_⟩, fun s => ⟨s.1, ?_⟩, fun s => rfl, fun s => rfl⟩
    · have hs : s.1 • d.symm = d.symm := s.2
      show s.1 • d = d
      have := congrArg SimpleGraph.Dart.symm hs
      rwa [← Mumford.smul_dart_symm, SimpleGraph.Dart.symm_symm, SimpleGraph.Dart.symm_symm] at this
    · have hs : s.1 • d = d := s.2
      show s.1 • d.symm = d.symm
      rw [← Mumford.smul_dart_symm, hs]
  have hmem_norm : ∀ (j : HeckeTower.Obj q q') (x : PGL(2, ↥(ValuationSubring.ratClosure A₁))), x ∈ (Γ₁ j).map ρ₁ → ∀ d : PGL(2, ↥(ValuationSubring.ratClosure A₁)), d ∈ (Γ₁ j).map ρ₁ ↔ x⁻¹ * d * x ∈ (Γ₁ j).map ρ₁ := by
    intro j x hx d; constructor
    · intro hd; exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.inv_mem _ hx) hd) hx
    · intro hd; have : x * (x⁻¹ * d * x) * x⁻¹ = d := by group
      rw [← this]; exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hx hd) (Subgroup.inv_mem _ hx)
  have hw_out : ∀ (j : HeckeTower.Obj q q') (d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart),
      Nat.card (MulAction.stabilizer ↥((Γ₁ j).map ρ₁) (Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart) d : Mumford.QuotEdge _ _).out) =
        Nat.card (MulAction.stabilizer ↥((Γ₁ j).map ρ₁) d) := by
    intro j d
    obtain ⟨x, hx, hxe⟩ := houtrel j d
    rw [hxe]; exact hstab_conj _ x (hmem_norm j x hx) d

  have hDw_rep : ∀ (j : HeckeTower.Obj q q') (e : E j) (d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart),
      (e.1 : Mumford.QuotEdge _ _) = Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart) d →
      ((D j).w e : ℕ) = Nat.card (MulAction.stabilizer ↥((Γ₁ j).map ρ₁) d) := by
    intro j e d he
    haveI := hIMG2 j e.1.out
    show ((Nat.toPNat' (Nat.card (MulAction.stabilizer ↥((Γ₁ j).map ρ₁) e.1.out)) : ℕ+) : ℕ) = _
    rw [Nat.toPNat'_coe, if_pos Nat.card_pos, ← hw_out j d, ← he]
  have hwgen : ∀ (j : HeckeTower.Obj q q') (σ : S₁) (m : PGL(2, ↥(ValuationSubring.ratClosure A₁))), (∀ d : PGL(2, ↥(ValuationSubring.ratClosure A₁)), d ∈ (Γ₁ j).map ρ₁ ↔ m⁻¹ * d * m ∈ (Γ₁ j).map ρ₁) →
      ((∀ e : E j, ((πE₁ j σ e).1 : Mumford.QuotEdge _ _) = Quotient.mk _ (m • e.1.out)) ∨
       (∀ e : E j, ((πE₁ j σ e).1 : Mumford.QuotEdge _ _) = Quotient.mk _ (m • e.1.out).symm)) →
      ∀ e : E j, (D j).w (πE₁ j σ e) = (D j).w e := by
    intro j σ m hm hpin e
    apply PNat.coe_injective
    rcases hpin with hpin | hpin
    · rw [hDw_rep j _ _ (hpin e), hDw_rep j e e.1.out (Quotient.out_eq e.1).symm, hstab_conj _ m hm]
    · rw [hDw_rep j _ _ (hpin e), hDw_rep j e e.1.out (Quotient.out_eq e.1).symm, hstab_symm, hstab_conj _ m hm]
  have hw0 : ∀ j (e : E j), (D j).w (πE₁ j σ₀₁ e) = (D j).w e :=
    fun j => hwgen j σ₀₁ (ρ₁ (w₁ j)) (hnormimg j (w₁ j) (hAL j).1) (Or.inr (hπE0 j))
  have hw1 : ∀ j (e : E j), (D j).w (πE₁ j σ₁₁ e) = (D j).w e :=
    fun j => hwgen j σ₁₁ (ρ₁ (wbar₁ j)) (hnormimg j (wbar₁ j) (hAL j).2.1) (Or.inl (hπE1 j))
  have hwι : ∀ j τ (e : E j), (D j).w (πE₁ j (ιS₁ τ) e) = (D j).w e := by
    intro j τ e
    by_cases h : χ₁ τ = 1
    · rw [hπEe j τ h]; rfl
    · rw [hπEo j τ h]; exact hw0 j e
  have hwpow : ∀ j (p : Equiv.Perm (E j)), (∀ e, (D j).w (p e) = (D j).w e) → ∀ (n : ℕ) e, (D j).w ((p ^ n) e) = (D j).w e := by
    intro j p hp n
    induction n with
    | zero => intro e; rfl
    | succ n ih => intro e; rw [pow_succ, Equiv.Perm.mul_apply, ih, hp]
  have hLAWw : ∀ j σ (e' : E j), (D j).w (πE₁ j σ e') = (D j).w e' := by
    intro j σ e'
    obtain ⟨τ, u, v, rfl⟩ := hgen₁ σ
    rw [map_mul, map_mul, map_pow, map_pow, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hwι, hwpow j _ (hw0 j) u, hwpow j _ (hw1 j) v]

  have hDa_rep : ∀ (j : HeckeTower.Obj q q') (e : E j) (d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart),
      (e.1 : Mumford.QuotEdge _ _) = Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart) d →
      (D j).a e = Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₁))) d.fst ∧
      (D j).b e = Quotient.mk (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₁))) d.snd := by
    intro j e d he
    have hr : (MulAction.orbitRel ↥((Γ₁ j).map ρ₁) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₁)).Dart).r e.1.out d := by
      rw [he]; exact Quotient.mk_out d
    obtain ⟨x, hx, hxe⟩ := (hrelD _ _ _).1 hr
    constructor
    · show Quotient.mk _ e.1.out.fst = _
      rw [hxe, Mumford.smul_dart_fst]; exact horbV j x hx _
    · show Quotient.mk _ e.1.out.snd = _
      rw [hxe, Mumford.smul_dart_snd]; exact horbV j x hx _
  have hQ : ∀ (j : HeckeTower.Obj q q') (σ : S₁),
      (sgn₁ σ = 1 → ∀ e', (D j).a (πE₁ j σ e') = πV₁ j σ ((D j).a e') ∧ (D j).b (πE₁ j σ e') = πV₁ j σ ((D j).b e')) ∧
      (sgn₁ σ = -1 → ∀ e', (D j).a (πE₁ j σ e') = πV₁ j σ ((D j).b e') ∧ (D j).b (πE₁ j σ e') = πV₁ j σ ((D j).a e')) := by
    intro j
    have hne1 : (1 : ℤˣ) ≠ -1 := by decide

    have Q0 : ∀ e', (D j).a (πE₁ j σ₀₁ e') = πV₁ j σ₀₁ ((D j).b e') ∧ (D j).b (πE₁ j σ₀₁ e') = πV₁ j σ₀₁ ((D j).a e') := by
      intro e'
      obtain ⟨ha, hb⟩ := hDa_rep j (πE₁ j σ₀₁ e') _ (hπE0 j e')
      obtain ⟨ha', hb'⟩ := hDa_rep j e' e'.1.out (Quotient.out_eq e'.1).symm
      rw [ha, hb, ha', hb', hπV0, hπV0, SimpleGraph.Dart.symm_toProd]
      exact ⟨rfl, rfl⟩
    have Q1 : ∀ e', (D j).a (πE₁ j σ₁₁ e') = πV₁ j σ₁₁ ((D j).a e') ∧ (D j).b (πE₁ j σ₁₁ e') = πV₁ j σ₁₁ ((D j).b e') := by
      intro e'
      obtain ⟨ha, hb⟩ := hDa_rep j (πE₁ j σ₁₁ e') _ (hπE1 j e')
      obtain ⟨ha', hb'⟩ := hDa_rep j e' e'.1.out (Quotient.out_eq e'.1).symm
      rw [ha, hb, ha', hb', hπV1, hπV1]
      exact ⟨rfl, rfl⟩

    let P : S₁ → Prop := fun σ =>
      (sgn₁ σ = 1 → ∀ e', (D j).a (πE₁ j σ e') = πV₁ j σ ((D j).a e') ∧ (D j).b (πE₁ j σ e') = πV₁ j σ ((D j).b e')) ∧
      (sgn₁ σ = -1 → ∀ e', (D j).a (πE₁ j σ e') = πV₁ j σ ((D j).b e') ∧ (D j).b (πE₁ j σ e') = πV₁ j σ ((D j).a e'))
    have hu : ∀ u : ℤˣ, u = 1 ∨ u = -1 := fun u => Int.units_eq_one_or u
    have Pmul : ∀ σ σ', P σ → P σ' → P (σ * σ') := by
      intro σ σ' hσ hσ'
      constructor
      · intro hs e'
        rw [map_mul, map_mul, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply]
        rcases hu (sgn₁ σ) with h | h
        · have h' : sgn₁ σ' = 1 := by rw [map_mul, h, one_mul] at hs; exact hs
          obtain ⟨a1, b1⟩ := hσ.1 h (πE₁ j σ' e'); obtain ⟨a2, b2⟩ := hσ'.1 h' e'
          exact ⟨by rw [a1, a2], by rw [b1, b2]⟩
