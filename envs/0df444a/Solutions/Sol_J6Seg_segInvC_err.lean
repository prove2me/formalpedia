  field_simp; ring

/-- Key inequality of Lemma 4.6. -/
lemma key_ineq {q b1 b2 : ℝ} (hq : 1 ≤ q) (hb1 : |b1| ≤ 1 / 2) (hb2 : |b2| ≤ 1 / 2) {h : ℤ}
