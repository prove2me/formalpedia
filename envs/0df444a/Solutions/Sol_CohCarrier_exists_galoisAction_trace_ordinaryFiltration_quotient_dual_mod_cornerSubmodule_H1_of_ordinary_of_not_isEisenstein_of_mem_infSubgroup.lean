  map_add' x y := by
    obtain ⟨q, hq⟩ := Θ_add hfaith op hop hgen T u bO hbO hk θbar Sp i₀ πk hπk hEis r p huindO huspanO huindp huspanp N hpN x y
    rw [hq, map_add, map_add, πk_smul_r Sp i₀ πk r hrk, add_zero]

local notation "χχ" => χ₁ hfaith op hop hgen T u c c₁ bO hbO hk θbar Sp i₀ πk hπk hEis r p huindO huspanO huindp huspanp hu_mul hu_one N hpN hrk

