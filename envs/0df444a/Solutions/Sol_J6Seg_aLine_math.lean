# A lines (PR #5 block chirp), part 5: the configured chirp map

Precision `P = 2p`, output exponent `σ = ⌊p/2⌋`, half-block `1 ≤ H ≤ 2m` (`m = sWidth p α`),
window half-width `W = H + m + 3`.

* `chirpA_congr`: `chirpA` reads only `[0, s)`.
* `chirp_sigma`: `exp(π s(t-s)H²/(t²α²)) ≤ 2^{⌊p/2⌋}` once `300 (t-s) ≤ s`.
* **`chirpC_fp`**: `chirpC` is an `FPApprox` of `liftL L` within `12 m + 11` for every line map
  `L` fitted to `Sapprox` within `6m+4` (the `FitSpec6` clause).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open Complex

namespace J6A

open IntMul.HvdH

lemma chirpA_congr (P σ W s t α H : ℕ) (U U' : ℕ → ℤ × ℤ) (hs : 0 < s)
    (h : ∀ j < s, U j = U' j) : chirpA P σ W s t α H U = chirpA P σ W s t α H U' := by
  have e : ∀ j : ℤ, U (j % (s : ℤ)).toNat = U' (j % (s : ℤ)).toNat := by
    intro j
    apply h
    have h0 : 0 ≤ j % (s : ℤ) := Int.emod_nonneg _ (by exact_mod_cast hs.ne')
    have h1 : j % (s : ℤ) < s := Int.emod_lt_of_pos _ (by exact_mod_cast hs)
    omega
  funext k
  simp only [chirpA, cTerm, e]

lemma ceilSqrt_le (p : ℕ) (hp : 1 ≤ p) : ceilSqrt p * ceilSqrt p ≤ 4 * p := by
  have h1 : Nat.sqrt p * Nat.sqrt p ≤ p := Nat.sqrt_le p
  have h2 : 1 ≤ Nat.sqrt p := Nat.le_sqrt.2 (by omega)
  unfold ceilSqrt
  split_ifs <;> nlinarith

end J6A

end

