theorem geoL_err_aux (P : ℕ) (c : NLogN.KFB.GI) (C : ℂ) (hC : ‖C‖ ≤ 1) {ec : ℝ}
    (hc : ‖NLogN.KFM.vP P c - C‖ ≤ ec) :
    ∀ (n : ℕ) (x : NLogN.KFB.GI) (X : ℂ) (e0 : ℝ), ‖X‖ ≤ 1 → ‖NLogN.KFM.vP P x - X‖ ≤ e0 →
      e0 + n * (2 * ec + 2 * (2 : ℝ)⁻¹ ^ P) ≤ 1 →
      ∀ k (hk : k < n), ‖NLogN.KFM.vP P ((NLogN.KFM.geoL P c x n)[k]'(by rw [NLogN.KFM.length_geoL]; exact hk)) - X * C ^ k‖ ≤
        e0 + k * (2 * ec + 2 * (2 : ℝ)⁻¹ ^ P) 
  | 0, _, _, _, _, _, _, k, hk => absurd hk (Nat.not_lt_zero _)
  | n + 1, x, X, e0, hX, hx, hs, k, hk => by
    have hu : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ P := by positivity
    have hec : 0 ≤ ec := (norm_nonneg _).trans hc
    rcases k with _ | k
    · simp only [NLogN.KFM.geoL, List.getElem_cons_zero, pow_zero, mul_one, Nat.cast_zero, zero_mul,
        add_zero]
      exact hx
    · simp only [NLogN.KFM.geoL, List.getElem_cons_succ]
      have he1 : e0 ≤ 1 := by
        have : (0 : ℝ) ≤ (n + 1 : ℕ) * (2 * ec + 2 * (2 : ℝ)⁻¹ ^ P) := by positivity
        linarith
      have hstep := NLogN.KFM.step_err P x c X C hX hC hx he1 hc
      have hXC : ‖X * C‖ ≤ 1 := by
        rw [norm_mul]; nlinarith [norm_nonneg X, norm_nonneg C]
      have ih := geoL_err_aux P c C hC hc n (NLogN.KFM.gmulT P x c) (X * C) (e0 + 2 * ec + 2 * (2 : ℝ)⁻¹ ^ P)
        hXC (by linarith) (by push_cast at hs ⊢; nlinarith) k (by omega)
      rw [show X * C ^ (k + 1) = X * C * C ^ k by ring]
      push_cast at ih ⊢
      linarith

theorem solution (P : ℕ) (c : NLogN.KFB.GI) (C : ℂ) (hC : ‖C‖ ≤ 1) {ec : ℝ}
    (hc : ‖NLogN.KFM.vP P c - C‖ ≤ ec) :
    ∀ (n : ℕ) (x : NLogN.KFB.GI) (X : ℂ) (e0 : ℝ), ‖X‖ ≤ 1 → ‖NLogN.KFM.vP P x - X‖ ≤ e0 →
      e0 + n * (2 * ec + 2 * (2 : ℝ)⁻¹ ^ P) ≤ 1 →
      ∀ k (hk : k < n), ‖NLogN.KFM.vP P ((NLogN.KFM.geoL P c x n)[k]'(by rw [NLogN.KFM.length_geoL]; exact hk)) - X * C ^ k‖ ≤
        e0 + k * (2 * ec + 2 * (2 : ℝ)⁻¹ ^ P) := by
  first
  | exact geoL_err_aux
  | exact geoL_err_aux P c C hC hc
  | (intros; apply geoL_err_aux <;> assumption)
end
