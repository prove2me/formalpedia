private theorem t1026 {α : Type*} [MeasurableSpace α] {ν : Measure α} {F : ℂ → ℂ}
    (hF : Differentiable ℂ F) (hord : d117 F) (G G' : α → ℂ) (t : α → ℝ) (c₁ c₂ : ℝ)
    (hright : ∀ s : ℂ, c₁ < s.re → Integrable (fun p => G p * Complex.exp (s * (t p : ℂ))) ν ∧
      ∫ p, G p * Complex.exp (s * (t p : ℂ)) ∂ν = F s)
    (hleft : ∀ s : ℂ, s.re < -c₂ → Integrable (fun p => G' p * Complex.exp (s * (t p : ℂ))) ν ∧
      ∫ p, G' p * Complex.exp (s * (t p : ℂ)) ∂ν = F s) :
    LDatum.BoundedOnStrips F := by
  refine t1002 F hF (max c₁ c₂) hord ?_ ?_
  · intro σ hσ
    have hσ₁ : c₁ < (σ : ℂ).re := by
      rw [Complex.ofReal_re]
      exact lt_of_le_of_lt (le_max_left _ _) hσ
    refine ⟨∫ p, ‖G p * Complex.exp ((σ : ℂ) * (t p : ℂ))‖ ∂ν, fun s hs => ?_⟩
    have hs₁ : c₁ < s.re := by
      rw [hs]
      exact lt_of_le_of_lt (le_max_left _ _) hσ
    rw [← (hright s hs₁).2]
    exact t1025 G t (hright (σ : ℂ) hσ₁).1 hs
  · intro σ hσ
    have hσ₂ : (σ : ℂ).re < -c₂ := by
