open MeasureTheory
open scoped ENNReal NNReal





variable {alpha : Type*} [PseudoMetricSpace alpha]
















variable (U : Set alpha) (t : NNReal)



open MarkovProcess.ContinuousPath in

theorem MarkovProcess.ContinuousPath.preimage_coordinate_killAtExit_of_mem {S : Set (Cemetery U)}
    (hS : (Cemetery.delta : Cemetery U) ∈ S) :
    (fun omega ↦ LifetimePath.coordinate t (killAtExit U omega)) ⁻¹' S =
      {omega : ContinuousPath alpha | (t : ℝ≥0∞) < exitTime U omega ∧
          omega t ∈ Subtype.val '' (Cemetery.alive ⁻¹' S)} ∪
        {omega : ContinuousPath alpha | ¬ (t : ℝ≥0∞) < exitTime U omega} := by sorry
