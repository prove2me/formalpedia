theorem pow2_runs (pP : Fin P) (hP : iprog pP = pow2Body pP) :
    ∀ (m : ℕ) (s : IState NS) (L : List Item), s.G PW = .int (m : ℤ) :: L →
      IRuns I iprog (.call pP) s (s.upd PW (.int (2 ^ m) :: L)) (pow2CostS m) := by
  intro m
  induction m using Nat.strong_induction_on with
  | _ m ih =>
  intro s L hW
  rcases Nat.eq_zero_or_pos m with h0 | hpos
  · subst h0
    have hb : IRuns I iprog pow2Base s (s.upd PW (.int (2 ^ 0) :: L)) 100 := by
      apply IRuns.of_runsTo 0
      simp [pow2Base, IStmt.run, IOp.run, hW, zsz_zero, zsz_one]
    have hi := IRuns.iteT (i := PW) (f := fun c => c == .zero)
      (q := .seq pow2A (.seq (.call pP) (.seq pow2D (.seq pow2E (.op (.drop T6))))))
      (by simp [hW]) hb
    exact (IRuns.call (by rw [hP]; exact hi)).mono (by simp [pow2CostS])
  · obtain ⟨h, hh⟩ : ∃ h, h = m / 2 := ⟨_, rfl⟩
    obtain ⟨b, hbd⟩ : ∃ b, b = m % 2 := ⟨_, rfl⟩
    have hm : m = 2 * h + b := by omega
    have hh' : h < m := by omega
    have hb01 : b = 0 ∨ b = 1 := by omega
    have e1' : sg (m : ℤ) (m / 2) = (h : ℤ) := by unfold sg; simp [hh]
    have e2' : sg (m : ℤ) (m % 2) = (b : ℤ) := by unfold sg; simp [hbd]
    -- before the call
    have hA : IRuns I iprog pow2A s ((s.upd PW (.int (h : ℤ) :: L)).upd PB (.int (b : ℤ) :: s.G PB))
        (2000 * (m + 1)) := by
      apply IRuns.of_runsTo 0
      simp only [pow2A, IStmt.run, IOp.run]
      simp +decide only [IState.upd_G, if_true, if_false, hW]
      simp only [rulerExp_two]
      simp [e1', e2']
      refine ⟨by clear * -; ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
      have := splitCost_le 1; have := moveIntCost_le (zsz (b : ℤ))
      have : zsz (b : ℤ) ≤ 1 := zsz_le_of_lt (by simp; omega)
      have := zsz_two
      omega
    have hC := ih h hh' ((s.upd PW (.int (h : ℤ) :: L)).upd PB (.int (b : ℤ) :: s.G PB)) L
      (by simp +decide)
    -- after the call
    have hD : IRuns I iprog pow2D
        (((s.upd PW (.int (h : ℤ) :: L)).upd PB (.int (b : ℤ) :: s.G PB)).upd PW (.int (2 ^ h) :: L))
        ((s.upd PW (.int (2 ^ h * 2 ^ h) :: L)).upd T6 (.int (b : ℤ) :: s.G T6))
        (2000 * (h + 1)) := by
      apply IRuns.of_runsTo 0
      simp only [pow2D, IStmt.run, IOp.run]
      simp +decide only [IState.upd_G, if_true, if_false]
      simp only [rulerExp_two_pow]
      simp [NLogN.zsz_two_pow]
      refine ⟨by clear * -; ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
      have := dupCost_le (h + 1); have := shlCost_le h; have := NLogN.zsz_two_pow h
      have : zsz (b : ℤ) ≤ 1 := zsz_le_of_lt (by simp; omega)
      have := moveIntCost_le (zsz (b : ℤ))
      omega
    have hE : IRuns I iprog pow2E ((s.upd PW (.int (2 ^ h * 2 ^ h) :: L)).upd T6 (.int (b : ℤ) :: s.G T6))
        ((s.upd PW (.int (2 ^ m) :: L)).upd T6 (.int (b : ℤ) :: s.G T6)) 1000 := by
      rcases hb01 with hb0 | hb1
      · have e3 : (2 : ℤ) ^ h * 2 ^ h = 2 ^ m := by rw [← pow_add, hm, hb0]; ring_nf
        have := IRuns.iteF (i := T6) (f := fun c => c == .pos)
          (p := .seq (.op (.const T7 2)) (.seq (.op (.shl PW T7)) (.op (.drop T7))))
          (s := (s.upd PW (.int (2 ^ h * 2 ^ h) :: L)).upd T6 (.int (b : ℤ) :: s.G T6))
          (by simp +decide [hb0]) (IRuns.skip (I := I) (iprog := iprog) _)
        exact this.mono' (by rw [e3]) (by omega)
      · have e3 : (2 : ℤ) ^ h * 2 ^ h * 2 = 2 ^ m := by
          rw [← pow_add, ← pow_succ, hm, hb1]; ring_nf
        have hp : IRuns I iprog (.seq (.op (.const T7 2)) (.seq (.op (.shl PW T7)) (.op (.drop T7))))
            ((s.upd PW (.int (2 ^ h * 2 ^ h) :: L)).upd T6 (.int (b : ℤ) :: s.G T6))
            ((s.upd PW (.int (2 ^ m) :: L)).upd T6 (.int (b : ℤ) :: s.G T6)) 900 := by
          apply IRuns.of_runsTo 0
          simp only [IStmt.run, IOp.run]
          simp +decide only [IState.upd_G, if_true, if_false]
          simp only [rulerExp_two]
          simp [e3]
          refine ⟨by clear * -; ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
          have := shlCost_le 1; have := zsz_two
          omega
        have := IRuns.iteT (i := T6) (f := fun c => c == .pos) (q := .skip)
          (by simp +decide [hb1]) hp
        exact this.mono (by omega)
    have hF : IRuns I iprog (.op (.drop T6))
        ((s.upd PW (.int (2 ^ m) :: L)).upd T6 (.int (b : ℤ) :: s.G T6))
        (s.upd PW (.int (2 ^ m) :: L)) 10 := by
      apply IRuns.of_runsTo 0
      simp +decide [IStmt.run, IOp.run]
      have : zsz (b : ℤ) ≤ 1 := zsz_le_of_lt (by simp; omega)
      omega
    have hbody := IRuns.seq hA (IRuns.seq hC (IRuns.seq hD (IRuns.seq hE hF)))
    have hne : m ≠ 0 := by omega
    have hite := IRuns.iteF (i := PW) (f := fun c => c == .zero) (p := pow2Base)
      (by simp [hW, hne]) hbody
    refine (IRuns.call (j := pP) (by rw [hP]; exact hite)).mono ?_
    simp only [pow2CostS] at *
    omega

end NLogN

end

section
open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (pP : Fin P) (hP : iprog pP = NLogN.pow2Body pP) (s : NLogN.IState NLogN.NS) (N : ℕ)
    (LP : List NLogN.Item) (hB : NLogN.fmB N ≤ NLogN.fmL N / 2) (hPRM : s.G NLogN.PRM = .int N :: LP) :
    NLogN.IRuns I iprog (NLogN.parA pP) s
      (((s.upd NLogN.ZZ (.int (NLogN.fmL N) :: s.G NLogN.ZZ)).upd NLogN.T1 (.int (NLogN.fmK N) :: s.G NLogN.T1)).upd NLogN.DL
        (.int (2 ^ NLogN.fmK N) :: s.G NLogN.DL))
      (1000 * (NLogN.fmL N + 1) ^ 2 + 1000 * (NLogN.fmB N + 1) ^ 2 + 30000 * (NLogN.fmL N + 3)) := by
  set ℓ := NLogN.fmL N with hℓ
  set β := NLogN.fmB N with hβ
  set k := NLogN.fmK N with hk
  have hk' : k = ℓ / 2 - β := rfl
  have h1 := NLogN.blenS_runs (I := I) (iprog := iprog) (X := NLogN.PRM) (C := NLogN.ZZ) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s N LP hPRM
  set s1 := s.upd NLogN.ZZ (.int (NLogN.zsz (N : ℤ)) :: s.G NLogN.ZZ) with hs1
  have h2 := NLogN.blenS_runs (I := I) (iprog := iprog) (X := NLogN.ZZ) (C := NLogN.CYS) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s1 ℓ (s.G NLogN.ZZ) (by simp [s1, hℓ, NLogN.fmL])
  set s2 := s1.upd NLogN.CYS (.int (NLogN.zsz (ℓ : ℤ)) :: s1.G NLogN.CYS) with hs2
  have hzβ : NLogN.zsz (ℓ : ℤ) = β := rfl
  have hzl : NLogN.zsz (N : ℤ) = ℓ := rfl
  have hβl : β ≤ ℓ := by omega
  have hzz : NLogN.zsz (ℓ : ℤ) ≤ ℓ := NLogN.zsz_natCast_le_self ℓ
  have hz2 : NLogN.zsz ((ℓ / 2 : ℕ) : ℤ) ≤ ℓ := le_trans (NLogN.zsz_natCast_le (Nat.div_le_self _ _)) hzz
  have hzk : NLogN.zsz (k : ℤ) ≤ ℓ := le_trans (NLogN.zsz_natCast_le (by omega)) hzz
  have ek : -(β : ℤ) + ((ℓ / 2 : ℕ) : ℤ) = (k : ℤ) := by omega
  have ek' : -(β : ℤ) + (ℓ : ℤ) / 2 = (k : ℤ) := by omega
  have hzb : NLogN.zsz (β : ℤ) ≤ ℓ := le_trans (NLogN.zsz_natCast_le_self β) hβl
  have e2 : (ℓ : ℤ) / 2 = ((ℓ / 2 : ℕ) : ℤ) := by omega
  have hz2' : NLogN.zsz ((ℓ : ℤ) / 2) ≤ ℓ := by rw [e2]; exact hz2
  have h3g : ∀ s' : NLogN.IState NLogN.NS, s'.G NLogN.ZZ = .int ℓ :: s.G NLogN.ZZ → s'.G NLogN.CYS = .int β :: s.G NLogN.CYS →
      NLogN.IRuns I iprog (.seq (.op (.const NLogN.T4 2)) (.seq (.op (.dup NLogN.ZZ NLogN.T1))
        (.seq (.op (.split NLogN.T1 NLogN.T4 NLogN.T2)) (.seq (.op (.drop NLogN.T2)) (.seq (.op (.drop NLogN.T4))
        (.seq (.op (.mv NLogN.CYS NLogN.T2)) (.seq (.op (.neg NLogN.T2)) (.seq (.op (.add NLogN.T2 NLogN.T1 NLogN.T1))
          (.op (.dup NLogN.T1 NLogN.PW)))))))))) s'
        (((s'.upd NLogN.CYS (s.G NLogN.CYS)).upd NLogN.T1 (.int k :: s'.G NLogN.T1)).upd NLogN.PW (.int k :: s'.G NLogN.PW))
        (5000 * (ℓ + 3)) := by
    intro s' hz hc
    apply NLogN.IRuns.of_runsTo 0
    simp +decide [NLogN.IStmt.run, NLogN.IOp.run, hz, hc, NLogN.zsz_two, NLogN.sg_natCast, ek, ek']
    refine ⟨by clear * -; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
    have := NLogN.dupCost_le (NLogN.zsz (ℓ : ℤ)); have := NLogN.dupCost_le (NLogN.zsz (k : ℤ))
    have := NLogN.splitCost_le 1
    have := NLogN.moveIntCost_le (NLogN.zsz (β : ℤ))
    have := NLogN.addIntCost_mono (show NLogN.zsz (-(β : ℤ)) + NLogN.zsz ((ℓ / 2 : ℕ) : ℤ) ≤ 2 * ℓ by
      rw [NLogN.zsz_neg]; omega)
    have := NLogN.addIntCost_mono (show NLogN.zsz (-(β : ℤ)) + NLogN.zsz ((ℓ : ℤ) / 2) ≤ 2 * ℓ by
      rw [NLogN.zsz_neg]; omega)
    have := NLogN.addIntCost_le (2 * ℓ)
    have : 2 * NLogN.zsz ((ℓ % 2 : ℕ) : ℤ) ≤ 2 * ℓ + 2 := by
      have := NLogN.zsz_natCast_le (show ℓ % 2 ≤ ℓ from Nat.mod_le _ _); omega
    have : 2 * NLogN.zsz ((ℓ : ℤ) % 2) ≤ 2 * ℓ + 2 := by
      have := NLogN.zsz_natCast_le (show ℓ % 2 ≤ ℓ from Nat.mod_le _ _)
      rw [show (ℓ : ℤ) % 2 = ((ℓ % 2 : ℕ) : ℤ) by omega]; omega
    omega
  have h3 := h3g s2 (by simp +decide [s2, s1, hzl]) (by simp +decide [s2, s1, hzβ])
  set s3 := ((s2.upd NLogN.CYS (s.G NLogN.CYS)).upd NLogN.T1 (.int k :: s2.G NLogN.T1)).upd NLogN.PW (.int k :: s2.G NLogN.PW) with hs3
  have h4 := NLogN.pow2_runs (I := I) pP hP k s3 (s2.G NLogN.PW) (by simp +decide [s3])
  have h5g : ∀ s' : NLogN.IState NLogN.NS, s'.G NLogN.PW = .int (2 ^ k) :: s.G NLogN.PW →
      NLogN.IRuns I iprog (.op (.mv NLogN.PW NLogN.DL)) s' ((s'.upd NLogN.PW (s.G NLogN.PW)).upd NLogN.DL (.int (2 ^ k) :: s'.G NLogN.DL))
        (200 * (ℓ + 2)) := by
    intro s' h
    apply NLogN.IRuns.of_runsTo 0
    simp +decide [NLogN.IStmt.run, NLogN.IOp.run, h]
    have := NLogN.moveIntCost_le (NLogN.zsz ((2 : ℤ) ^ k)); have := NLogN.zsz_two_pow k
    omega
  have h5 := h5g (s3.upd NLogN.PW (.int (2 ^ k) :: s2.G NLogN.PW)) (by simp +decide [s2, s1])
  have hall := NLogN.IRuns.seq (NLogN.IRuns.seq h1 (NLogN.IRuns.seq h2 h3)) (NLogN.IRuns.seq h4 h5)
  refine hall.mono' ?_ ?_
  · simp only [hs3, hs2, hs1, hzl]
    clear * -
    ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
  · simp only [NLogN.pow2CostS]; rw [← hzl, ← hzβ]; rw [hzl, hzβ]; omega
end
