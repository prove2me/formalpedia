  Spec.map (CommRingCat.ofHom
    ((infinityLocalizedInclusion R).comp (recoveredReciprocalPatchEquiv R h104).toAlgHom).toRingHom)

theorem ordinaryInfinityChartMap_comparison (h104 : IsUnit (104 : R)) :
    ordinaryInfinityChartMap R ≫ ordinaryToFiniteAffineScheme R =
      ordinaryInfinityToReciprocalPatch R h104 ≫ reciprocalToFiniteAffineScheme R h104 := by
  change Spec.map (CommRingCat.ofHom (algebraMap (CoordinateRing R) (ordinaryInfinityLocalization R))) ≫
    Spec.map (CommRingCat.ofHom (candidateAlgebra R).val.toRingHom) =
    Spec.map (CommRingCat.ofHom
      ((infinityLocalizedInclusion R).comp (recoveredReciprocalPatchEquiv R h104).toAlgHom).toRingHom) ≫
      (Spec.map (CommRingCat.ofHom (recoveredReciprocalPatchEquiv R h104).symm.toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap (candidateAlgebra R) (infinityLocalization R))))
  rw [← Category.assoc,← Spec.map_comp,← Spec.map_comp,← Spec.map_comp]
