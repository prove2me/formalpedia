-- Source module: Solutions.KILBase
/-!
# KIL base: register programs on "managed" stacks

`encK s f` is the state `s` with the list of integers `f j` pushed on top of every stack `j`
(`f j = []` for unmanaged stacks).  All programs of the KIL files are specified on such states;
updates are `Function.update`s of `f`, which keeps the bookkeeping small.

`Sp p s t c` : the register program `p` is executable from `s` (`RS.ok`), ends in `t`, and costs
at most `c`.  `Sp.irun` turns it into an `IRuns` of the compiled item-language code.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

namespace KIL

theorem top_encK_r6c {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {l : List ℤ}
    (h : f i = a :: l) : (encK s f).top i = a :=
  IState.top_eq_r6c (L := ints l ++ s.G i) (by simp [h])

theorem isInt_encK {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {l : List ℤ}
    (h : f i = a :: l) : (encK s f).IsInt i :=
  IState.isInt_of_r6c (L := ints l ++ s.G i) (a := a) (by simp [h])

theorem encK_upd (s : IState HS) (f : Fin HS → List ℤ) (i : Fin HS) (l : List ℤ) :
    (encK s f).upd i (ints l ++ s.G i) = encK s (Function.update f i l) := by
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases h : j = i
  · subst h; simp
  · simp [h]

theorem Sp.mono {p : RS} {s t : IState HS} {c c' : ℕ} (h : Sp p s t c) (hc : c ≤ c') :
    Sp p s t c' := ⟨h.1, h.2.1, le_trans h.2.2 hc⟩

theorem Sp.seq_r6c {a b : RS} {s t u : IState HS} {c1 c2 : ℕ} (ha : Sp a s t c1) (hb : Sp b t u c2) :
    Sp (.seq a b) s u (c1 + c2) := by
  refine ⟨⟨ha.1, ?_⟩, ?_, ?_⟩
  · rw [ha.2.1]; exact hb.1
  · simp only [run, ha.2.1, hb.2.1]
  · simp only [cost]; rw [ha.2.1]; have := ha.2.2; have := hb.2.2; omega

theorem Sp.irun_r6c {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {p : RS} {s t : IState HS}
    {c : ℕ} (h : Sp p s t c) : ∃ c' ≤ c, IRuns I iprog p.code s t c' :=
  ⟨p.cost s, h.2.2, h.2.1 ▸ RS.code_runs p s h.1⟩

theorem Sp.congr {p : RS} {s t t' : IState HS} {c : ℕ} (h : Sp p s t c) (e : t = t') :
    Sp p s t' c := e ▸ h

theorem Sp.skip (s : IState HS) : Sp .skip s s 1 := ⟨trivial, rfl, le_rfl⟩

/-! ## Elementary statements -/

section
variable (s : IState HS) (f : Fin HS → List ℤ)

theorem Sp.push {i : Fin HS} {e : Ex HS} {B : ℕ} (hi : i.val < 56) (hc : e.Clean)
    (hok : e.ok (encK s f)) (hl : e.Lin) (hB : e.Bnd (encK s f) B) :
    Sp (.push i e) (encK s f) (encK s (Function.update f i (e.eval (encK s f) :: f i)))
      ((e.size + 1) * 2000 * (B + 2)) := by
  refine ⟨⟨hi, hc, hok⟩, ?_, ?_⟩
  · simp only [run]
    rw [← encK_upd]; simp [ints]
  · exact pushCost_le_lin e _ B hl hB

end

/-! ## Moving integers between stacks -/

/-! ## Counted loops through a family of managed states -/

theorem withCtr_encK (C : Fin HS) (s : IState HS) (f g : Fin HS → List ℤ)
    (hf : f C = []) (hg : g C = []) (N k : ℕ) :
    withCtr C (encK s f) N k (encK s g) =
      encK s (Function.update g C [(N : ℤ) - k]) := by
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases h : j = C
  · subst h; simp [withCtr, hf, hg]
  · simp [withCtr, h]

theorem Sp.rep {C : Fin HS} {n : Ex HS} {b : RS} {s : IState HS} {F : ℕ → Fin HS → List ℤ}
    {N B c : ℕ} (hC5 : C.val < 56) (hC : ∀ k, F k C = []) (hw : C ∉ b.writes) (hnc : n.Clean)
    (hno : n.ok (encK s (F 0))) (hnl : n.Lin) (hnb : n.Bnd (encK s (F 0)) B)
    (hn : n.eval (encK s (F 0)) = N)
    (hb : ∀ k < N, Sp b (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) c) :
    Sp (.rep C n b) (encK s (F 0)) (encK s (F N))
      ((n.size + 1) * 2000 * (B + 2) + N * (c + 8000 * (B + 2) + 30) + 32) := by
  have hN : (n.eval (encK s (F 0))).toNat = N := by rw [hn]; simp
  have H : RepStates C n b (encK s (F 0)) (fun k => encK s (F k)) :=
    { nonneg := by rw [hn]; positivity
      hw := hw
      h0 := rfl
      hG := fun k => by simp [hC]
      step := by
        intro k hk
        rw [hN] at hk ⊢
        rw [withCtr_encK C s _ _ (hC 0) (hC k), withCtr_encK C s _ _ (hC 0) (hC (k + 1))]
        exact (hb k hk).2.1 }
  refine ⟨?_, ?_, ?_⟩
  · refine H.ok hC5 hnc hno ?_
    intro k hk
    rw [hN] at hk ⊢
    rw [withCtr_encK C s _ _ (hC 0) (hC k)]
    exact (hb k hk).1
  · rw [H.run, hN]
  · have := H.cost_le_lin B c hnl hnb (by
      intro k hk
      rw [hN] at hk ⊢
      rw [withCtr_encK C s _ _ (hC 0) (hC k)]
      exact (hb k hk).2.2)
    rw [hN] at this
    exact this

/-! ## Expression side conditions on managed states -/

theorem ok_reg_r6c {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {l : List ℤ}
    (h : f i = a :: l) : (Ex.reg i).ok (encK s f) := isInt_encK h

theorem bnd_reg_r6c {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {l : List ℤ}
    {B : ℕ} (h : f i = a :: l) (ha : zsz a ≤ B) : (Ex.reg i).Bnd (encK s f) B := by
  simp only [Ex.Bnd, top_encK_r6c h]; exact ha

theorem clean_reg_r6c {i : Fin HS} (hi : i.val < 56) : (Ex.reg i).Clean := clean_of_lt hi

theorem clean_add_r6c {a b : Ex HS} (ha : a.Clean) (hb : b.Clean) : (Ex.add a b).Clean := by
  intro j hj
  simp only [Ex.regs, List.mem_append] at hj
  rcases hj with hj | hj
  · exact ha j hj
  · exact hb j hj

theorem clean_mul {a b : Ex HS} (ha : a.Clean) (hb : b.Clean) : (Ex.mul a b).Clean := by
  intro j hj
  simp only [Ex.regs, List.mem_append] at hj
  rcases hj with hj | hj
  · exact ha j hj
  · exact hb j hj

theorem clean_neg {a : Ex HS} (ha : a.Clean) : (Ex.neg a).Clean := by
  intro j hj
  simp only [Ex.regs] at hj
  exact ha j hj

theorem clean_lit_r6c (c : ℤ) : (Ex.lit (S := HS) c).Clean := by
  intro j hj; simp [Ex.regs] at hj

end KIL

end NLogN

end

