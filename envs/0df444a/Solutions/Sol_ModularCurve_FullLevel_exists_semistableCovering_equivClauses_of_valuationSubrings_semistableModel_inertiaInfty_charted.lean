theorem exists_two_radii (A : ValuationSubring (AlgebraicClosure ℚ)) (m : ↥A) (hm : m ∈ maximalIdeal ↥A) (hm0 : (m : AlgebraicClosure ℚ) ≠ 0) :
    ∃ c₁ c₂ : ↥A, c₁ ∈ maximalIdeal ↥A ∧ c₂ ∈ maximalIdeal ↥A ∧ (c₁ : AlgebraicClosure ℚ) ≠ 0 ∧ (c₂ : AlgebraicClosure ℚ) ≠ 0 ∧
      (∃ m₁ ∈ maximalIdeal ↥A, (m : AlgebraicClosure ℚ) = c₁ * m₁) ∧ (∃ m₂ ∈ maximalIdeal ↥A, (m : AlgebraicClosure ℚ) = c₂ * m₂) ∧
      A.valuation (c₁ : AlgebraicClosure ℚ) ≠ A.valuation (c₂ : AlgebraicClosure ℚ) := by

  obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq (m : AlgebraicClosure ℚ) (by norm_num : 0 < 2)
  obtain ⟨t, ht⟩ := IsAlgClosed.exists_pow_nat_eq (m : AlgebraicClosure ℚ) (by norm_num : 0 < 3)
  have hmA : A.valuation (m : AlgebraicClosure ℚ) < 1 := (A.valuation_lt_one_iff _).mp hm
  have hmv0 : A.valuation (m : AlgebraicClosure ℚ) ≠ 0 := (Valuation.ne_zero_iff _).mpr hm0
  have hr0 : r ≠ 0 := by rintro rfl; apply hm0; rw [← hr]; simp
  have ht0 : t ≠ 0 := by rintro rfl; apply hm0; rw [← ht]; simp

  have hrle : A.valuation r ≤ 1 := by
    by_contra h; push_neg at h
    have : 1 < A.valuation (r ^ 2) := by rw [map_pow]; exact one_lt_pow₀ h (by norm_num)
    rw [hr] at this; exact absurd (lt_trans this hmA) (lt_irrefl _)
  have htle : A.valuation t ≤ 1 := by
    by_contra h; push_neg at h
    have : 1 < A.valuation (t ^ 3) := by rw [map_pow]; exact one_lt_pow₀ h (by norm_num)
    rw [ht] at this; exact absurd (lt_trans this hmA) (lt_irrefl _)
  have hrA : r ∈ A := (A.valuation_le_one_iff _).mp hrle
  have htA : t ∈ A := (A.valuation_le_one_iff _).mp htle
  have hrlt : A.valuation r < 1 := by
    by_contra h; push_neg at h
    have h1 : A.valuation r = 1 := le_antisymm hrle h
    have : A.valuation (r ^ 2) = 1 := by rw [map_pow, h1, one_pow]
    rw [hr] at this; exact absurd (this ▸ hmA) (lt_irrefl _)
  have htlt : A.valuation t < 1 := by
    by_contra h; push_neg at h
    have h1 : A.valuation t = 1 := le_antisymm htle h
    have : A.valuation (t ^ 3) = 1 := by rw [map_pow, h1, one_pow]
    rw [ht] at this; exact absurd (this ▸ hmA) (lt_irrefl _)
  refine ⟨⟨r, hrA⟩, ⟨t, htA⟩, (A.valuation_lt_one_iff _).mpr hrlt, (A.valuation_lt_one_iff _).mpr htlt, hr0, ht0,
    ⟨⟨r, hrA⟩, (A.valuation_lt_one_iff _).mpr hrlt, by push_cast; rw [← hr]; ring⟩,
    ⟨⟨t ^ 2, pow_mem htA 2⟩, ?_, by push_cast; rw [← ht]; ring⟩, ?_⟩
  · apply (A.valuation_lt_one_iff _).mpr
    push_cast
    rw [map_pow]; exact pow_lt_one₀ zero_le' htlt (by norm_num)
  ·
    intro h
    push_cast at h
    have e1 : A.valuation (m : AlgebraicClosure ℚ) ^ 3 = A.valuation r ^ (2 * 3) := by rw [← hr, map_pow, pow_mul]
    have e2 : A.valuation (m : AlgebraicClosure ℚ) ^ 2 = A.valuation t ^ (2 * 3) := by
      rw [← ht, map_pow, ← pow_mul]
    rw [h] at e1
    have e3 : A.valuation (m : AlgebraicClosure ℚ) ^ 3 = A.valuation (m : AlgebraicClosure ℚ) ^ 2 := by rw [e1, e2]
    have : A.valuation (m : AlgebraicClosure ℚ) ^ 2 * A.valuation (m : AlgebraicClosure ℚ) = A.valuation (m : AlgebraicClosure ℚ) ^ 2 * 1 := by
      rw [mul_one, ← pow_succ]; exact e3
    have hne : A.valuation (m : AlgebraicClosure ℚ) ^ 2 ≠ 0 := pow_ne_zero _ hmv0
    have := mul_left_cancel₀ hne this
    exact absurd (this ▸ hmA) (lt_irrefl _)

