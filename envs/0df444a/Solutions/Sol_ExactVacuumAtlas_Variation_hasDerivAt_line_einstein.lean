open ExactVacuumAtlas.Variation
variable {n : ℕ}
variable {U : Set (Pt 4)} {g gi h : Metric 4} {F f : TwoForm 4}
  (hU : IsOpen U) (hg : ∀ i j, ContDiffOn ℝ ∞ (g i j) U)
  (hinv : ∀ y ∈ U, metricMatrix gi y * metricMatrix g y = 1) (hF : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
  (hh : ∀ i j, ContDiffOn ℝ ∞ (h i j) U) (hf : ∀ i j, ContDiffOn ℝ ∞ (f i j) U)
include hU hg hinv hF hh hf
theorem solution {x : Pt 4} (hx : x ∈ U) (a b : Fin 4) :
    HasDerivAt (fun ε => einsteinMaxwell (lineMetric g h ε) (lineInv g h ε) (lineMetric F f ε) a b x)
      (linEinstein g gi F h f a b x) 0 := by
  have hb := (familyData_line hU hg hh hF hf).bridge_einstein isTangent_line (zero_mem_lineDom hinv hx) a b
  rwa [lineMetric_zero, lineMetric_zero,
    linEinstein_congr hU (fun _ _ => Set.eqOn_refl _ _) (lineInv_zero_eqOn hinv)
      (fun _ _ => Set.eqOn_refl _ _) (fun _ _ => Set.eqOn_refl _ _) (fun _ _ => Set.eqOn_refl _ _) hx a b] at hb
