  {f'' : A'' ⟶ Spec (CommRingCat.of R)}

def fibreHom (Φ : A ⟶ A') (hΦ : Φ ≫ f' = f) (s : (Spec (CommRingCat.of R) : Scheme.{u})) :
    fibreScheme f s ⟶ fibreScheme f' s :=
  pullback.lift (pullback.fst f (basePointInclusion s) ≫ Φ) (fibreStr f s)
    (by rw [Category.assoc, hΦ]; exact pullback.condition)

variable (Φ : A ⟶ A') (hΦ : Φ ≫ f' = f) (s : (Spec (CommRingCat.of R) : Scheme.{u}))

@[scoped simp]
theorem fibreHom_fst : fibreHom Φ hΦ s ≫ pullback.fst f' (basePointInclusion s) =
    pullback.fst f (basePointInclusion s) ≫ Φ :=
  pullback.lift_fst _ _ _

@[scoped simp]
theorem fibreHom_over : fibreHom Φ hΦ s ≫ fibreStr f' s = fibreStr f s :=
  pullback.lift_snd _ _ _

theorem isPullback_fibreHom :
    IsPullback (fibreHom Φ hΦ s) (pullback.fst f (basePointInclusion s))
      (pullback.fst f' (basePointInclusion s)) Φ := by
  refine IsPullback.of_right (h₁₂ := fibreStr f' s) (v₁₃ := basePointInclusion s) (h₂₂ := f') ?_
    (fibreHom_fst Φ hΦ s) (IsPullback.of_hasPullback f' (basePointInclusion s)).flip
  rw [fibreHom_over, hΦ]
  exact (IsPullback.of_hasPullback f (basePointInclusion s)).flip

theorem fibreHom_iff_pullback_snd_fiberι (P : MorphismProperty Scheme.{u}) [P.RespectsIso] :
    P (fibreHom Φ hΦ s) ↔ P (pullback.snd Φ (f'.fiberι s)) := by
  have key : pullback.snd Φ (f'.fiberι s) =
      (isPullback_fibreHom Φ hΦ s).flip.isoPullback.inv ≫ fibreHom Φ hΦ s :=
    ((isPullback_fibreHom Φ hΦ s).flip.isoPullback_inv_snd).symm
  rw [key]
  exact (P.cancel_left_of_respectsIso _ _).symm

theorem fibreHom_comp (Ψ : A' ⟶ A'') (hΨ : Ψ ≫ f'' = f') :
    fibreHom Φ hΦ s ≫ fibreHom Ψ hΨ s = fibreHom (Φ ≫ Ψ) (by rw [Category.assoc, hΨ, hΦ]) s := by
  apply pullback.hom_ext
  · simp only [Category.assoc, fibreHom_fst]
    rw [← Category.assoc, fibreHom_fst, Category.assoc]
  · simp only [Category.assoc, fibreHom_over]

theorem fibreHom_id : fibreHom (𝟙 A) (Category.id_comp f) s = 𝟙 (fibreScheme f s) := by
  apply pullback.hom_ext
  · rw [fibreHom_fst, Category.comp_id, Category.id_comp]
  · rw [fibreHom_over, Category.id_comp]

theorem fibrePointToBase_mapPt_fibreHom {T : Scheme.{u}}
    {t' : T ⟶ Spec (CommRingCat.of (baseResidueField s))} (x : SchemeHomOver t' (fibreStr f s)) :
    fibrePointToBase s (mapPt (fibreHom Φ hΦ s) (fibreHom_over Φ hΦ s) x) =
      mapPt Φ hΦ (fibrePointToBase s x) :=
  Subtype.ext (by simp only [fibrePointToBase_coe, mapPt_coe, Category.assoc, fibreHom_fst])

theorem mapPt_fibreHom_eq {T : Scheme.{u}}
    {t' : T ⟶ Spec (CommRingCat.of (baseResidueField s))} (x : SchemeHomOver t' (fibreStr f s)) :
    mapPt (fibreHom Φ hΦ s) (fibreHom_over Φ hΦ s) x =
      fibrePointOfBase s (mapPt Φ hΦ (fibrePointToBase s x)) := by
  rw [← fibrePointToBase_mapPt_fibreHom, fibrePointOfBase_toBase]

theorem mapPt_fibreHom_mul (L : RelativeGroupLaw R f) (L' : RelativeGroupLaw R f')
    (hΦmul : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
      mapPt Φ hΦ (L.mul t P Q) = L'.mul t (mapPt Φ hΦ P) (mapPt Φ hΦ Q))
    {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of (baseResidueField s)))
    (x y : SchemeHomOver t' (fibreStr f s)) :
    mapPt (fibreHom Φ hΦ s) (fibreHom_over Φ hΦ s) ((L.fibre s).mul t' x y) =
      (L'.fibre s).mul t' (mapPt (fibreHom Φ hΦ s) (fibreHom_over Φ hΦ s) x)
        (mapPt (fibreHom Φ hΦ s) (fibreHom_over Φ hΦ s) y) := by
  rw [mapPt_fibreHom_eq, fibre_mul, fibre_mul, fibrePointToBase_ofBase, hΦmul,
    fibrePointToBase_mapPt_fibreHom, fibrePointToBase_mapPt_fibreHom]

theorem nsmulPt_fibre (L : RelativeGroupLaw R f) {T : Scheme.{u}}
    (t' : T ⟶ Spec (CommRingCat.of (baseResidueField s))) (n : ℕ) (x : SchemeHomOver t' (fibreStr f s)) :
    nsmulPt (L.fibre s) t' n x = fibrePointOfBase s (nsmulPt L _ n (fibrePointToBase s x)) := by
  induction n with
  | zero => rfl
  | succ n ih =>
      show (L.fibre s).mul t' (nsmulPt (L.fibre s) t' n x) x = fibrePointOfBase s (L.mul _ _ _)
      rw [ih, fibre_mul, fibrePointToBase_ofBase]

theorem mapPt_fibreHom_mapPt_fibreHom_eq_nsmulPt (L : RelativeGroupLaw R f)
    (Ψ : A' ⟶ A) (hΨ : Ψ ≫ f = f') (n : ℕ)
    (hΨΦ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P : SchemeHomOver t f),
      mapPt Ψ hΨ (mapPt Φ hΦ P) = nsmulPt L t n P)
    {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of (baseResidueField s)))
    (x : SchemeHomOver t' (fibreStr f s)) :
    mapPt (fibreHom Ψ hΨ s) (fibreHom_over Ψ hΨ s) (mapPt (fibreHom Φ hΦ s) (fibreHom_over Φ hΦ s) x) =
      nsmulPt (L.fibre s) t' n x := by
  rw [mapPt_fibreHom_eq, fibrePointToBase_mapPt_fibreHom, hΨΦ, nsmulPt_fibre]

end GoodReductionJacobian.RelativeGroupLaw
