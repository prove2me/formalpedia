lemma qlu_qpoch_succ (q : K) (n : ℕ) : qpoch q (n + 1) = qpoch q n * (1 - q ^ (n + 1)) := by
  simp [qpoch, Finset.prod_range_succ]

lemma qlu_qbin_zero_of_lt (q : K) : ∀ (n k : ℕ), n < k → qbin q n k = 0 := by
  intro n
  induction n with
  | zero => intro k hk; obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩; rfl
  | succ n ih =>
    intro k hk
    obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    show qbin q n k + q ^ (k + 1) * qbin q n (k + 1) = 0
    rw [ih k (by omega), ih (k + 1) (by omega)]; ring

lemma qlu_qbin_mul (q : K) : ∀ (n k : ℕ), k ≤ n →
    qbin q n k * qpoch q k * qpoch q (n - k) = qpoch q n := by
  intro n
  induction n with
  | zero => intro k hk; obtain rfl : k = 0 := by omega
            simp [qbin, qpoch]
  | succ n ih =>
    intro k hk
    rcases k with _ | k
    · simp [qbin, qpoch]
    · show (qbin q n k + q ^ (k + 1) * qbin q n (k + 1)) * qpoch q (k + 1) * qpoch q (n + 1 - (k + 1))
          = qpoch q (n + 1)
      rcases Nat.eq_or_lt_of_le (show k ≤ n by omega) with h | h
      · subst h
        rw [qlu_qbin_zero_of_lt q k (k + 1) (by omega)]
        have := ih k le_rfl
        simp only [Nat.sub_self] at this ⊢
        rw [qlu_qpoch_succ]
        simp [qpoch] at this ⊢
        linear_combination (1 - q ^ (k + 1)) * this
      · obtain ⟨m, rfl⟩ : ∃ m, n = k + 1 + m := ⟨n - (k + 1), by omega⟩
        have h1 := ih k (by omega)
        have h2 := ih (k + 1) (by omega)
        have e1 : k + 1 + m - k = m + 1 := by omega
        have e2 : k + 1 + m - (k + 1) = m := by omega
        have e3 : k + 1 + m + 1 - (k + 1) = m + 1 := by omega
        rw [e1] at h1; rw [e2] at h2; rw [e3]
        rw [qlu_qpoch_succ q k] at h2 ⊢
        rw [qlu_qpoch_succ q m] at h1 ⊢
        rw [qlu_qpoch_succ q (k + 1 + m)]
        linear_combination (1 - q ^ (k + 1)) * h1 + q ^ (k + 1) * (1 - q ^ (m + 1)) * h2

lemma qlu_qfall (q : K) (b : ℕ) : ∀ k : ℕ, qpoch q (k + b) = qpoch q b * qfall q (k + b) k := by
  intro k
  induction k with
  | zero => simp [qfall]
  | succ k ih =>
    have : qfall q (k + 1 + b) (k + 1) = (1 - q ^ (k + b + 1)) * qfall q (k + b) k := by
      unfold qfall
      rw [Finset.prod_range_succ']
      rw [mul_comm]
      congr 1
      · congr 2; omega
      · apply Finset.prod_congr rfl
        intro i hi
        congr 2
        omega
    rw [this, show k + 1 + b = (k + b) + 1 by omega, qlu_qpoch_succ, ih]; ring

lemma qlu_qfall_zero (q : K) (v k : ℕ) (h : v < k) : qfall q v k = 0 := by
  unfold qfall
  apply Finset.prod_eq_zero (i := v) (by simp; omega)
  simp

lemma qlu_term (x z : K) (hz : z ≠ 0) (k a b : ℕ) (hk : qpoch (x ^ 2) k ≠ 0)
    (ha : qpoch (x ^ 2) a ≠ 0) (hb : qpoch (x ^ 2) b ≠ 0) :
    qpoch (x ^ 2) (k + a) * (bP x z⁻¹ a * (qpoch (x ^ 2) k)⁻¹ * bP x z b) * qpoch (x ^ 2) (k + b)
      = x ^ ((((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)).natAbs ^ 2) *
          z ^ (((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)) *
          (qbin (x ^ 2) (k + a) k * qfall (x ^ 2) (k + b) k * (x ^ 2) ^ (a * b)) := by
  have h1 := qlu_qbin_mul (x ^ 2) (k + a) k (by omega)
  rw [Nat.add_sub_cancel_left] at h1
  have h2 := qlu_qfall (x ^ 2) b k
  set N := (((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)).natAbs with hNdef
  have hN0 : (N : ℤ) ^ 2 = ((b : ℤ) - a) ^ 2 := by
    rw [hNdef, Int.natAbs_sq]; push_cast; ring
  have hN : N ^ 2 + 2 * (a * b) = a ^ 2 + b ^ 2 := by
    zify; linear_combination hN0
  have hx : x ^ (N ^ 2) * (x ^ 2) ^ (a * b) = x ^ (a ^ 2) * x ^ (b ^ 2) := by
    rw [← pow_mul, ← pow_add, ← pow_add, hN]
  have hzz : z ^ (((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)) = z ^ b * (z ^ a)⁻¹ := by
    rw [show ((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ) = (b : ℤ) - (a : ℤ) by push_cast; ring,
      zpow_sub₀ hz, zpow_natCast, zpow_natCast, div_eq_mul_inv]
  rw [hzz, ← h1, h2]
  unfold bP
  rw [show x ^ (N ^ 2) * (z ^ b * (z ^ a)⁻¹) *
      (qbin (x ^ 2) (k + a) k * qfall (x ^ 2) (k + b) k * (x ^ 2) ^ (a * b)) =
      (x ^ (N ^ 2) * (x ^ 2) ^ (a * b)) * (z ^ b * (z ^ a)⁻¹) *
      (qbin (x ^ 2) (k + a) k * qfall (x ^ 2) (k + b) k) by ring, hx]
  rw [inv_pow]
  field_simp

theorem qlu_main (x z : K) (n : ℕ) (hz : z ≠ 0) (hq : ∀ i < n, qpoch (x ^ 2) i ≠ 0) :
    gaussToep x z n =
      Gam (x ^ 2) n * lowT (bP x z⁻¹) * GamInv (x ^ 2) n * upT (bP x z) * Gam (x ^ 2) n := by
  ext ⟨u, hu⟩ ⟨v, hv⟩
  simp only [Gam, GamInv]
  rw [mul_diagonal, mul_apply]
  simp only [mul_diagonal, diagonal_mul, gaussToep, lowT, upT]
  rw [Finset.sum_mul, Fin.sum_univ_eq_sum_range (fun k : ℕ =>
    (qpoch (x ^ 2) u * if k ≤ u then bP x z⁻¹ (u - k) else 0) * (qpoch (x ^ 2) k)⁻¹ *
      (if k ≤ v then bP x z (v - k) else 0) * qpoch (x ^ 2) v) n]
  rw [← Finset.sum_subset (range_subset_range.2 (show u + 1 ≤ n by omega)) ?_]
  · conv_lhs => rw [← mul_one (_ * _), ← qpascal_identity (x ^ 2) u v, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k hk
    rw [mem_range] at hk
    rw [if_pos (by omega)]
    by_cases hkv : k ≤ v
    · rw [if_pos hkv]
      obtain ⟨a, rfl⟩ : ∃ a, u = k + a := ⟨u - k, by omega⟩
      obtain ⟨b, rfl⟩ : ∃ b, v = k + b := ⟨v - k, by omega⟩
      simp only [Nat.add_sub_cancel_left]
      rw [← qlu_term x z hz k a b (hq k (by omega)) (hq a (by omega)) (hq b (by omega))]
      ring
    · rw [if_neg hkv, qlu_qfall_zero _ _ _ (by omega)]; ring
  · intro k hk hk'
    simp only [mem_range] at hk hk'
    rw [if_neg (by omega)]; ring

lemma qlu_alt (x : K) (h : ℕ) :
    ∑ j ∈ range (h + 2), (-1 : K) ^ j * x ^ (j * (j - 1)) * qbin (x ^ 2) (h + 1) j = 0 := by
  set g : ℕ → K := fun j => (-1 : K) ^ j * x ^ (j * (j + 1)) * qbin (x ^ 2) h j with hg
  have hf : ∀ j : ℕ, (-1 : K) ^ (j + 1) * x ^ ((j + 1) * (j + 1 - 1)) * qbin (x ^ 2) (h + 1) (j + 1)
      = g (j + 1) - g j := by
    intro j
    simp only [hg, Nat.add_sub_cancel]
    show (-1 : K) ^ (j + 1) * x ^ ((j + 1) * j) *
        (qbin (x ^ 2) h j + (x ^ 2) ^ (j + 1) * qbin (x ^ 2) h (j + 1)) = _
    have e : x ^ ((j + 1) * j) * (x ^ 2) ^ (j + 1) = x ^ ((j + 1) * (j + 1 + 1)) := by
      rw [← pow_mul, ← pow_add]; congr 1; ring
    have e2 : x ^ ((j + 1) * j) = x ^ (j * (j + 1)) := by rw [mul_comm]
    rw [← e, e2]; ring
  rw [Finset.sum_range_succ', Finset.sum_congr rfl (fun j _ => hf j), Finset.sum_range_sub]
  simp only [hg, qlu_qbin_zero_of_lt (x ^ 2) h (h + 1) (by omega)]
  simp [qbin]

lemma qlu_conv_term (x w : K) (m r : ℕ) (hm : qpoch (x ^ 2) m ≠ 0) (hr : qpoch (x ^ 2) r ≠ 0)
    (hmr : qpoch (x ^ 2) (m + r) ≠ 0) :
    bP x w m * aP x w r = (-(x * w)) ^ (m + r) / qpoch (x ^ 2) (m + r) *
      ((-1 : K) ^ m * x ^ (m * (m - 1)) * qbin (x ^ 2) (m + r) m) := by
  have h1 := qlu_qbin_mul (x ^ 2) (m + r) m (by omega)
  rw [Nat.add_sub_cancel_left] at h1
  have hkey : x ^ (m ^ 2) * w ^ m = (-(x * w)) ^ m * ((-1 : K) ^ m * x ^ (m * (m - 1))) := by
    have : (-(x * w)) ^ m * (-1 : K) ^ m = (x * w) ^ m := by
      rw [← mul_pow]; congr 1; ring
    rw [← mul_assoc, this, mul_pow]
    rcases m with _ | m
    · simp
    · rw [Nat.add_sub_cancel, show (m + 1) ^ 2 = (m + 1) + (m + 1) * m by ring, pow_add]; ring
  have hb : qbin (x ^ 2) (m + r) m ≠ 0 := by
    intro h0; rw [h0] at h1; simp at h1; exact hmr h1.symm
  unfold bP aP
  rw [pow_add (-(x * w)) m r, ← h1]
  calc x ^ (m ^ 2) * w ^ m / qpoch (x ^ 2) m * ((-(x * w)) ^ r / qpoch (x ^ 2) r)
      = (x ^ (m ^ 2) * w ^ m) * (-(x * w)) ^ r / (qpoch (x ^ 2) m * qpoch (x ^ 2) r) := by
        rw [div_mul_div_comm]
    _ = ((-(x * w)) ^ m * ((-1 : K) ^ m * x ^ (m * (m - 1)))) * (-(x * w)) ^ r /
          (qpoch (x ^ 2) m * qpoch (x ^ 2) r) := by rw [hkey]
    _ = _ := by field_simp

lemma qlu_conv (x w : K) (h : ℕ) (hq : ∀ i ≤ h, qpoch (x ^ 2) i ≠ 0) :
    conv (bP x w) (aP x w) h = delta0 h := by
  rcases h with _ | h
  · simp [conv, bP, aP, delta0, qpoch]
  · unfold conv
    calc ∑ m ∈ range (h + 1 + 1), bP x w m * aP x w (h + 1 - m)
        = ∑ m ∈ range (h + 2), (-(x * w)) ^ (h + 1) / qpoch (x ^ 2) (h + 1) *
            ((-1 : K) ^ m * x ^ (m * (m - 1)) * qbin (x ^ 2) (h + 1) m) := by
          apply Finset.sum_congr rfl
          intro m hm
          rw [mem_range] at hm
          have := qlu_conv_term x w m (h + 1 - m) (hq m (by omega)) (hq _ (by omega))
            (by rw [show m + (h + 1 - m) = h + 1 by omega]; exact hq _ le_rfl)
          rwa [show m + (h + 1 - m) = h + 1 by omega] at this
      _ = 0 := by rw [← Finset.mul_sum, qlu_alt, mul_zero]
      _ = delta0 (h + 1) := by simp [delta0]

lemma qlu_lowT_mul (c d : ℕ → K) (n : ℕ) :
    (lowT c : Matrix (Fin n) (Fin n) K) * lowT d = lowT (conv c d) := by
  ext ⟨i, hi⟩ ⟨j, hj⟩
  simp only [mul_apply, lowT]
  rw [Fin.sum_univ_eq_sum_range (fun k => (if k ≤ i then c (i - k) else 0) *
    (if j ≤ k then d (k - j) else 0)) n]
  split_ifs with hji
  · rw [← Finset.sum_subset (range_subset_range.2 (show i + 1 ≤ n by omega)) ?_]
    · rw [← Finset.sum_range_reflect]
      unfold conv
      rw [← Finset.sum_subset (range_subset_range.2 (show i - j + 1 ≤ i + 1 by omega)) ?_]
      · apply Finset.sum_congr rfl
        intro m hm
        rw [mem_range] at hm
        rw [if_pos (by omega), if_pos (by omega)]
        congr 2 <;> omega
      · intro m hm hm'
        simp only [mem_range] at hm hm'
        split_ifs <;> first | (exfalso; omega) | simp
    · intro k hk hk'
      simp only [mem_range] at hk hk'
      rw [if_neg (by omega)]; ring
  · apply Finset.sum_eq_zero
    intro k _
    split_ifs <;> first | (exfalso; omega) | simp

lemma qlu_upT_mul (c d : ℕ → K) (n : ℕ) :
    (upT c : Matrix (Fin n) (Fin n) K) * upT d = upT (conv c d) := by
  ext ⟨i, hi⟩ ⟨j, hj⟩
  simp only [mul_apply, upT]
  rw [Fin.sum_univ_eq_sum_range (fun k => (if i ≤ k then c (k - i) else 0) *
    (if k ≤ j then d (j - k) else 0)) n]
  split_ifs with hij
  · rw [← Finset.sum_subset (range_subset_range.2 (show j + 1 ≤ n by omega)) ?_]
    · rw [show j + 1 = i + (j - i + 1) by omega, Finset.sum_range_add]
      rw [Finset.sum_eq_zero (s := range i), zero_add]
      · unfold conv
        apply Finset.sum_congr rfl
        intro m hm
        rw [mem_range] at hm
        rw [if_pos (by omega), if_pos (by omega)]
        congr 2 <;> omega
      · intro k hk
        rw [mem_range] at hk
        rw [if_neg (by omega)]; ring
    · intro k hk hk'
      simp only [mem_range] at hk hk'
      rw [if_neg (show ¬ k ≤ j by omega)]; ring
  · apply Finset.sum_eq_zero
    intro k _
    split_ifs <;> first | (exfalso; omega) | simp

lemma qlu_lowT_one (c : ℕ → K) (n : ℕ) (h : ∀ k < n, c k = delta0 k) :
    (lowT c : Matrix (Fin n) (Fin n) K) = 1 := by
  ext ⟨i, hi⟩ ⟨j, hj⟩
  simp only [lowT, one_apply, Fin.mk.injEq]
  split_ifs with h1 h2 h2
  · rw [h _ (by omega)]; simp [delta0]; omega
  · rw [h _ (by omega)]; simp [delta0]; omega
  · omega
  · rfl

lemma qlu_upT_one (c : ℕ → K) (n : ℕ) (h : ∀ k < n, c k = delta0 k) :
    (upT c : Matrix (Fin n) (Fin n) K) = 1 := by
  ext ⟨i, hi⟩ ⟨j, hj⟩
  simp only [upT, one_apply, Fin.mk.injEq]
  split_ifs with h1 h2 h2
  · rw [h _ (by omega)]; simp [delta0]; omega
  · rw [h _ (by omega)]; simp [delta0]; omega
  · omega
  · rfl

theorem qlu_inv_main (x z : K) (n : ℕ) (hz : z ≠ 0) (hq : ∀ i < n, qpoch (x ^ 2) i ≠ 0) :
    (gaussToep x z n)⁻¹ =
      GamInv (x ^ 2) n * upT (aP x z) * Gam (x ^ 2) n * lowT (aP x z⁻¹) * GamInv (x ^ 2) n := by
  have hT := qlu_main x z n hz hq
  have hΓ : Gam (x ^ 2) n * GamInv (x ^ 2) n = 1 := by
    rw [Gam, GamInv, diagonal_mul_diagonal, ← diagonal_one]
    congr 1; funext i; exact mul_inv_cancel₀ (hq i i.isLt)
  have hΓ' : GamInv (x ^ 2) n * Gam (x ^ 2) n = 1 := by
    rw [Gam, GamInv, diagonal_mul_diagonal, ← diagonal_one]
    congr 1; funext i; exact inv_mul_cancel₀ (hq i i.isLt)
  have hL : (lowT (bP x z⁻¹) : Matrix (Fin n) (Fin n) K) * lowT (aP x z⁻¹) = 1 := by
    rw [qlu_lowT_mul]; apply qlu_lowT_one
    intro k hk; exact qlu_conv x z⁻¹ k (fun i hi => hq i (by omega))
  have hU : (upT (bP x z) : Matrix (Fin n) (Fin n) K) * upT (aP x z) = 1 := by
    rw [qlu_upT_mul]; apply qlu_upT_one
    intro k hk; exact qlu_conv x z k (fun i hi => hq i (by omega))
  apply Matrix.inv_eq_right_inv
  rw [hT]
  simp only [Matrix.mul_assoc]
  rw [← Matrix.mul_assoc (Gam (x ^ 2) n) (GamInv (x ^ 2) n), hΓ, Matrix.one_mul,
    ← Matrix.mul_assoc (upT (bP x z)) (upT (aP x z)), hU, Matrix.one_mul,
    ← Matrix.mul_assoc (GamInv (x ^ 2) n) (Gam (x ^ 2) n), hΓ', Matrix.one_mul,
    ← Matrix.mul_assoc (lowT (bP x z⁻¹)) (lowT (aP x z⁻¹)), hL, Matrix.one_mul, hΓ]

end QLUField

lemma qlu_xR_sq : xR α σ ^ 2 = qR α σ := by
  unfold xR qR
  rw [← Real.exp_nat_mul]; congr 1; push_cast; ring

lemma qlu_zR_ne : zR α b ≠ 0 := (Real.exp_pos _).ne'

lemma qlu_qpoch_ne (h : 0 < α ^ 2 * σ) (i : ℕ) : qpoch (qR α σ) i ≠ 0 := by
  unfold qpoch
  rw [Finset.prod_ne_zero_iff]
  intro k _
  have h0 : 0 < qR α σ := Real.exp_pos _
  have h1 : qR α σ < 1 := by
    unfold qR
    have := Real.pi_pos
    have h2 := Real.exp_lt_exp.mpr (show -(2 * π * α ^ 2 * σ) < 0 by nlinarith)
    rwa [Real.exp_zero] at h2
  have : qR α σ ^ (k + 1) < 1 := pow_lt_one₀ h0.le h1 (by omega)
  linarith

lemma qlu_realToep_eq (n : ℕ) : realToep α σ b n = gaussToep (xR α σ) (zR α b) n := by
  ext u v
  unfold realToep gaussToep xR zR
  rw [← Real.exp_nat_mul, ← Real.rpow_intCast, ← Real.exp_mul, ← Real.exp_add]
  congr 1
  push_cast
  rw [Nat.cast_natAbs, Int.cast_abs, sq_abs]
  push_cast
  ring

lemma qlu_bplus_eq : bplus α σ b = bP (xR α σ) (zR α b) := by
  funext h
  unfold bplus bP xR zR
  rw [qlu_xR_sq]
  congr 1
  rw [← Real.exp_nat_mul, ← Real.exp_nat_mul, ← Real.exp_add]
  congr 1; push_cast; ring

lemma qlu_bminus_eq : bminus α σ b = bP (xR α σ) (zR α b)⁻¹ := by
  funext h
  unfold bminus bP xR zR
  rw [qlu_xR_sq]
  congr 1
  rw [← Real.exp_neg, ← Real.exp_nat_mul, ← Real.exp_nat_mul, ← Real.exp_add]
  congr 1; push_cast; ring

lemma qlu_aplus_eq : aplus α σ b = aP (xR α σ) (zR α b) := by
  funext h
  unfold aplus aP xR zR
  rw [qlu_xR_sq]
  congr 1
  rw [← Real.exp_add, neg_pow (Real.exp _) h, ← Real.exp_nat_mul]
  congr 2; ring

lemma qlu_aminus_eq : aminus α σ b = aP (xR α σ) (zR α b)⁻¹ := by
  funext h
  unfold aminus aP xR zR
  rw [qlu_xR_sq]
  congr 1
  rw [← Real.exp_neg, ← Real.exp_add, neg_pow (Real.exp _) h, ← Real.exp_nat_mul]
  congr 2; ring

theorem h50_realToep_inv (h : 0 < α ^ 2 * σ) (n : ℕ) :
    (realToep α σ b n)⁻¹ = GamInv (qR α σ) n * upT (aplus α σ b) * Gam (qR α σ) n *
      lowT (aminus α σ b) * GamInv (qR α σ) n := by
  rw [qlu_realToep_eq, qlu_aminus_eq, qlu_aplus_eq, ← qlu_xR_sq]
  exact qlu_inv_main _ _ n (qlu_zR_ne α b) (fun i _ => by rw [qlu_xR_sq]; exact qlu_qpoch_ne α σ h i)

end h50qlu
theorem h50_TinvM_entry (α σ b : ℝ) (n : ℕ) (u v : Fin n) :
    J6Seg.TinvM α σ b n u v = J6Seg.TinvF α σ b n u v := by
  unfold J6Seg.TinvM J6Seg.TinvF J6Seg.giR J6Seg.gamR
  simp only [J6QLU.GamInv, J6QLU.Gam]
  rw [Matrix.mul_diagonal, Matrix.mul_apply]
  simp only [Matrix.mul_diagonal, Matrix.diagonal_mul, J6QLU.upT, J6QLU.lowT]
  have h1 : ∀ k : Fin n, (J6QLU.qpoch (J6QLU.qR α σ) (u : ℕ))⁻¹ *
      (if (u : ℕ) ≤ k then J6QLU.aplus α σ b (k - u) else 0) * J6QLU.qpoch (J6QLU.qR α σ) (k : ℕ) *
      (if (v : ℕ) ≤ k then J6QLU.aminus α σ b (k - v) else 0) =
      (J6QLU.qpoch (J6QLU.qR α σ) (u : ℕ))⁻¹ * (fun k : ℕ => if max (u : ℕ) v ≤ k then
        J6QLU.aplus α σ b (k - u) * J6QLU.qpoch (J6QLU.qR α σ) k * J6QLU.aminus α σ b (k - v) else 0) k := by
    intro k
    simp only
    by_cases hu : (u : ℕ) ≤ k <;> by_cases hv : (v : ℕ) ≤ k
    · rw [if_pos hu, if_pos hv, if_pos (max_le hu hv)]; ring
    · rw [if_neg hv, if_neg (fun h => hv ((le_max_right _ _).trans h))]; ring
    · rw [if_neg hu, if_neg (fun h => hu ((le_max_left _ _).trans h))]; ring
    · rw [if_neg hu, if_neg (fun h => hu ((le_max_left _ _).trans h))]; ring
  rw [Finset.sum_congr rfl (fun k _ => h1 k), ← Finset.mul_sum,
    Fin.sum_univ_eq_sum_range (fun k : ℕ => if max (u : ℕ) v ≤ k then
        J6QLU.aplus α σ b (k - u) * J6QLU.qpoch (J6QLU.qR α σ) k * J6QLU.aminus α σ b (k - v) else 0) n,
    ← Finset.sum_filter]
  have hf : (Finset.range n).filter (fun k => max (u : ℕ) v ≤ k) = Finset.Ico (max (u : ℕ) v) n := by
    ext k; simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_Ico]; omega
  rw [hf]; ring

theorem h50_persym (α σ b : ℝ) (hp : 0 < α ^ 2 * σ) (n u v : ℕ) (hu : u < n) (hv : v < n) :
    J6Seg.TinvF α σ b n u v = J6Seg.TinvF α σ b n (n - 1 - v) (n - 1 - u) := by
  have hT : Matrix.transpose (J6QLU.realToep α σ b n) =
      (J6QLU.realToep α σ b n).submatrix Fin.revPerm Fin.revPerm := by
    ext i j
    simp only [Matrix.transpose_apply, Matrix.submatrix_apply, Fin.revPerm_apply, J6QLU.realToep,
      Fin.val_rev]
    have hi := i.isLt; have hj := j.isLt
    rw [Nat.cast_sub (by omega), Nat.cast_sub (by omega)]
    push_cast
    congr 4 <;> ring
  have hI := congrArg (fun M => M⁻¹) hT
  rw [← Matrix.transpose_nonsing_inv, Matrix.inv_submatrix_equiv] at hI
  have hE := congrFun (congrFun hI ⟨v, hv⟩) ⟨u, hu⟩
  simp only [Matrix.transpose_apply, Matrix.submatrix_apply, Fin.revPerm_apply] at hE
  rw [h50_realToep_inv α σ b hp n] at hE
  change J6Seg.TinvM α σ b n _ _ = J6Seg.TinvM α σ b n _ _ at hE
  rw [h50_TinvM_entry, h50_TinvM_entry] at hE
  simp only [Fin.val_rev] at hE
  rw [hE]; congr 1 <;> omega
theorem h50_TinvF_bd {A S Bb : ℝ} (hα : 2 ≤ A) (hσ : 1 ≤ S)
    (hx : 2 ≤ A ^ 2 * (S - 1)) (hb : |Bb| ≤ 1 / 2) (n u v : ℕ) :
    |J6Seg.TinvF A S Bb n u v| ≤ 1.01 := by
  obtain ⟨-, -, gu1, gu2⟩ := h4_gam A S hα hσ u
  obtain ⟨-, -, gv1, gv2⟩ := h4_gam A S hα hσ v
  have hg : |J6Seg.giR A S u * J6Seg.giR A S v| ≤ 1.0005 := by
    rw [abs_of_nonneg (by nlinarith)]; nlinarith
  set s := ∑ k ∈ Finset.Ico (max u v) n,
    J6QLU.aplus A S Bb (k - u) * (J6Seg.gamR A S k * J6QLU.aminus A S Bb (k - v)) with hs
  have hsb : |s| ≤ 1.0028 := by
    rw [hs]
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    have : ∀ k ∈ Finset.Ico (max u v) n,
        |J6QLU.aplus A S Bb (k - u) * (J6Seg.gamR A S k * J6QLU.aminus A S Bb (k - v))| ≤
          1.0001 * 1.0001 * (1 / 400 : ℝ) ^ (k - u) := by
      intro k hk
      obtain ⟨g1, g2, -, -⟩ := h4_gam A S hα hσ k
      obtain ⟨-, cm⟩ := h4_coef A S Bb hα hσ hx hb (k - v)
      obtain ⟨cp, -⟩ := h4_coef A S Bb hα hσ hx hb (k - u)
      have r1 : (1 / 400 : ℝ) ^ (k - v) ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
      have r0 : (0 : ℝ) ≤ (1 / 400 : ℝ) ^ (k - u) := by positivity
      rw [abs_mul, abs_mul, abs_of_nonneg (by linarith : (0:ℝ) ≤ J6Seg.gamR A S k)]
      have : J6Seg.gamR A S k * |J6QLU.aminus A S Bb (k - v)| ≤ 1.0001 := by
        nlinarith [abs_nonneg (J6QLU.aminus A S Bb (k - v))]
      have h0 : 0 ≤ J6Seg.gamR A S k * |J6QLU.aminus A S Bb (k - v)| := by
        have := abs_nonneg (J6QLU.aminus A S Bb (k - v)); nlinarith
      calc _ ≤ (1.0001 * (1 / 400 : ℝ) ^ (k - u)) * 1.0001 := mul_le_mul cp this h0 (by positivity)
        _ = _ := by ring
    refine (Finset.sum_le_sum this).trans ?_
    rw [← Finset.mul_sum]
    have := h4_geo (max u v) u n (le_max_left _ _)
    nlinarith
  have hTinv : J6Seg.TinvF A S Bb n u v = (J6Seg.giR A S u * J6Seg.giR A S v) * s := by
    unfold J6Seg.TinvF; rw [hs]; congr 1; apply Finset.sum_congr rfl; intros; ring
  rw [hTinv, abs_mul]
  nlinarith [abs_nonneg s, abs_nonneg (J6Seg.giR A S u * J6Seg.giR A S v)]
theorem h50_MinvE {P : ℕ} {α σ b : ℝ} {T : Tables} {a n w : ℕ} {E Dm : ℝ} (hα : 2 ≤ α) (hσ : 1 ≤ σ)
    (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2) (hT : BlkTab P α σ b T a n E) (hE : 0 ≤ E)
    (hDm : ∀ u < n, ddR α σ u ≤ Dm)
    (hP : 100 * (((n : ℝ) + 1) * E + 1) ≤ 2 ^ P) {u v : ℕ} (hu : u < n) (hv : v < n) :
    |(fmul P (fmul P (T.dd u) (T.di v)) (TinvI P T w a n u v) : ℝ) / 2 ^ P -
      MinvF α σ b n u v| ≤ 12 * Dm * (((n : ℝ) + 1) * E + 1) / 2 ^ P := by
  have hN : (0 : ℝ) < 2 ^ P := by positivity
  have hn : 0 < n := by omega
  set K : ℝ := ((n : ℝ) + 1) * E + 1 with hK
  have hn0 : (0 : ℝ) ≤ n := by positivity
  have hK1 : 1 ≤ K := by rw [hK]; nlinarith
  have hEK : E ≤ K := by rw [hK]; nlinarith
  have hDm1 : 1 ≤ Dm := by
    have := hDm 0 hn; unfold ddR at this; simp at this; linarith
  have hN100 : 100 * K ≤ 2 ^ P := hP
  -- t ≈ 2^P τ
  have ht : |(TinvI P T w a n u v : ℝ) - 2 ^ P * TinvF α σ b n u v| ≤ 7 * K := by
    unfold TinvI
    split_ifs with hc
    · have h := h4_tinvd hα hσ hx hb hT hE hP (show n - 1 - v < n by omega) (show n - 1 - u < n by omega)
      have hps := h50_persym α σ b (by nlinarith) n u v hu hv
      rw [hps]; exact h
    · exact h4_tinvd hα hσ hx hb hT hE hP hu hv
  have hτ := h50_TinvF_bd (Bb := b) hα hσ hx hb n u v
  have hdd0 : 0 < ddR α σ u := Real.exp_pos _
  have hdi0 : 0 < diR α σ v := Real.exp_pos _
  have hdi1 : diR α σ v ≤ 1 := by
    unfold diR; rw [Real.exp_le_one_iff]
    have : 0 ≤ π * α ^ 2 * (σ - 1) * (v : ℝ) ^ 2 := by
      have := Real.pi_pos; have : 0 ≤ σ - 1 := by linarith
      positivity
    linarith
  have hddD : ddR α σ u ≤ Dm := hDm u hu
  have e1 := h4_fmul_err P (hT.dd u hu) (hT.di v hv)
    (show |ddR α σ u| ≤ ddR α σ u by rw [abs_of_pos hdd0])
    (show |diR α σ v| ≤ 1 by rw [abs_of_pos hdi0]; exact hdi1)
  have hEN : E * ddR α σ u * E / 2 ^ P ≤ 0.01 * E * Dm := by
    rw [div_le_iff₀ hN]
    have : 100 * E ≤ 2 ^ P := by nlinarith
    have h2 : 0 ≤ E * ddR α σ u := by positivity
    nlinarith [mul_le_mul_of_nonneg_left this h2, mul_le_mul_of_nonneg_left hddD hE]
  have e1' : |(fmul P (T.dd u) (T.di v) : ℝ) - 2 ^ P * (ddR α σ u * diR α σ v)| ≤ 2.01 * E * Dm + 1 / 2 := by
    have : E * ddR α σ u ≤ E * Dm := mul_le_mul_of_nonneg_left hddD hE
    nlinarith
  have hm : |ddR α σ u * diR α σ v| ≤ Dm := by
    rw [abs_of_pos (by positivity)]; nlinarith
  have e2 := h4_fmul_err P e1' ht hm hτ
  have h7 : (2.01 * E * Dm + 1 / 2) * (7 * K) / 2 ^ P ≤ 0.07 * (2.01 * E * Dm + 1 / 2) := by
    rw [div_le_iff₀ hN]
    have : 0 ≤ 2.01 * E * Dm + 1 / 2 := by positivity
    nlinarith [mul_le_mul_of_nonneg_left hN100 this]
  have hEDm : E * Dm ≤ Dm * K := by nlinarith
  have hfin : |(fmul P (fmul P (T.dd u) (T.di v)) (TinvI P T w a n u v) : ℝ) -
      2 ^ P * MinvF α σ b n u v| ≤ 12 * Dm * K := by
    have eq : MinvF α σ b n u v = ddR α σ u * diR α σ v * TinvF α σ b n u v := by
      unfold MinvF; ring
    rw [eq]
    have : 1 ≤ Dm * K := by nlinarith
    nlinarith
  have e : (fmul P (fmul P (T.dd u) (T.di v)) (TinvI P T w a n u v) : ℝ) / 2 ^ P - MinvF α σ b n u v
      = ((fmul P (fmul P (T.dd u) (T.di v)) (TinvI P T w a n u v) : ℝ) - 2 ^ P * MinvF α σ b n u v) / 2 ^ P := by
    field_simp
  rw [e, abs_div, abs_of_pos hN]
  exact div_le_div_of_nonneg_right hfin hN.le
theorem h4_bOf_bd (S T : ℕ) (hS : 0 < S) (l : ℤ) :
    -(S : ℤ) ≤ 2 * bOf S T l ∧ 2 * bOf S T l ≤ S := by
  unfold bOf
  have hS' : (0 : ℤ) < 2 * S := by omega
  have h1 := Int.ediv_mul_le (2 * (T : ℤ) * l + S) (ne_of_gt hS')
  have h2 := Int.lt_ediv_add_one_mul_self (2 * (T : ℤ) * l + S) hS'
  constructor <;> nlinarith

theorem h4_eKz_ge (S T : ℕ) (hS : 0 < S) (hST : S ≤ T) (l h : ℤ) :
    (S : ℤ) ^ 2 * (|h| * (|h| - 1)) ≤ eKz S T l h := by
  rcases eq_or_ne h 0 with h0 | h0
  · subst h0; simp [eKz]
  unfold eKz
  obtain ⟨a1, a2⟩ := h4_bOf_bd S T hS l
  obtain ⟨b1, b2⟩ := h4_bOf_bd S T hS (l + h)
  have hS0 : (0 : ℤ) < S := by exact_mod_cast hS
  have hST' : (S : ℤ) ≤ T := by exact_mod_cast hST
  set x := bOf S T l
  set y := bOf S T (l + h)
  rcases lt_trichotomy h 0 with hh | hh | hh
  · rw [abs_of_neg hh]
    have e1 : 2 * (T * h + x) ≤ -(S : ℤ) * (2 * -h - 1) := by nlinarith
    have e2 : (S : ℤ) * (2 * -h - 1) ≥ 0 := by nlinarith
    nlinarith
  · exact absurd hh h0
  · rw [abs_of_pos hh]
    have e1 : 2 * (T * h + x) ≥ (S : ℤ) * (2 * h - 1) := by nlinarith
    have e2 : (S : ℤ) * (2 * h - 1) ≥ 0 := by nlinarith
    nlinarith

theorem h50_params {s t α : ℕ} {B : Blocks} (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α)
    (hx : 3 ≤ xθ s t α) (a : ℕ) :
    (2 : ℝ) ≤ (α : ℝ) ∧ (1 : ℝ) ≤ (t : ℝ) / s ∧ 2 ≤ (α : ℝ) ^ 2 * ((t : ℝ) / s - 1) ∧
      |(bOf s t (B.st a) : ℝ) / s| ≤ 1 / 2 := by
  have hs' : (0:ℝ) < s := by exact_mod_cast hs
  refine ⟨by exact_mod_cast hα, ?_, ?_, ?_⟩
  · rw [le_div_iff₀ hs']; simp only [one_mul]; exact_mod_cast hst
  · have : xθ s t α = (α:ℝ)^2 * ((t:ℝ)/s - 1) := by
      unfold xθ; push_cast [Nat.cast_sub hst]; field_simp
    linarith
  · obtain ⟨h1, h2⟩ := h4_bOf_bd s t hs (B.st a)
    have h1' : -(s:ℝ) ≤ 2 * (bOf s t (B.st a) : ℝ) := by exact_mod_cast h1
    have h2' : 2 * (bOf s t (B.st a) : ℝ) ≤ s := by exact_mod_cast h2
    rw [abs_div, abs_of_pos hs', div_le_iff₀ hs', abs_le]
    constructor <;> linarith

theorem h50_eEx_bd {s t α : ℕ} (hs : 0 < s) (hst : s ≤ t) (l h : ℤ) :
    0 ≤ eEx s t α l h ∧ eEx s t α l h ≤ 1 := by
  unfold eEx
  split_ifs
  · simp
  · refine ⟨(Real.exp_pos _).le, ?_⟩
    rw [Real.exp_le_one_iff]
    have hk := h4_eKz_ge s t hs hst l h
    have h0 : (0:ℤ) ≤ (s : ℤ) ^ 2 * (|h| * (|h| - 1)) := by
      apply mul_nonneg (by positivity)
      rcases (abs_nonneg h).eq_or_lt with e | e
      · rw [← e]; simp
      · have : 1 ≤ |h| := e; nlinarith
    have : (0:ℝ) ≤ (eKz s t l h : ℝ) := by exact_mod_cast h0.trans hk
    have := Real.pi_pos
    have : 0 ≤ Real.pi * (α:ℝ) ^ 2 * (eKz s t l h : ℝ) / (s:ℝ) ^ 2 := by positivity
    linarith

theorem h50_cap_term {P s t α : ℕ} {B : Blocks} {T : Tables} {E Dm : ℝ}
    (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α)
    (hx : 3 ≤ xθ s t α) (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E) {lam : ℕ}
    (hlam : ∀ i < s, B.len i ≤ lam) (hP : 100 * (((lam : ℝ) + 1) * E + 1) ≤ 2 ^ P)
    {a : ℕ} (ha : a < s) {i : ℕ} (hia : i ∈ blS B a) {h : ℤ} (hh : h ∈ Hset B i) :
    |(fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P - MiG s t α B a i * eEx s t α i h| ≤
      15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P := by
  obtain ⟨hα', hσ, hx', hb⟩ := h50_params (B := B) hs hst hα hx a
  have hN : (0 : ℝ) < 2 ^ P := by positivity
  obtain ⟨c1, c2, c3⟩ := hB.cover a ha
  have hi := Finset.mem_Ico.mp hia
  have his : i < s := by omega
  have hl : B.len a ≤ lam := hlam a ha
  have hl' : (B.len a : ℝ) ≤ lam := by exact_mod_cast hl
  set K : ℝ := ((lam : ℝ) + 1) * E + 1 with hK
  have hKn : ((B.len a : ℝ) + 1) * E + 1 ≤ K := by rw [hK]; nlinarith
  have hP' : 100 * (((B.len a : ℝ) + 1) * E + 1) ≤ 2 ^ P := by linarith
  have hlam0 : (0:ℝ) ≤ lam := by positivity
  have hK1 : 1 ≤ K := by rw [hK]; nlinarith
  have hEK : E ≤ K := by rw [hK]; nlinarith
  have hDm1 : 1 ≤ Dm := by
    have := hT.dm a ha 0 (by omega); unfold ddR at this; simp at this; linarith
  have hM := h50_MinvE (w := B.w) hα' hσ hx' hb (hT.blk a ha) hE (hT.dm a ha) hP'
    (u := a - B.st a) (v := i - B.st a) (by omega) (by omega)
  have hM' : |(MinvI P T B a i : ℝ) - 2 ^ P * MiG s t α B a i| ≤ 12 * Dm * K := by
    have e : (MinvI P T B a i : ℝ) - 2 ^ P * MiG s t α B a i =
        2 ^ P * ((fmul P (fmul P (T.dd (a - B.st a)) (T.di (i - B.st a)))
          (TinvI P T B.w (B.st a) (B.len a) (a - B.st a) (i - B.st a)) : ℝ) / 2 ^ P -
          MinvF (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st a) : ℝ) / s) (B.len a) (a - B.st a) (i - B.st a)) := by
      unfold MinvI MiG; field_simp
    rw [e, abs_mul, abs_of_pos hN]
    have : 12 * Dm * (((B.len a : ℝ) + 1) * E + 1) ≤ 12 * Dm * K := by
      have : 0 ≤ Dm := by linarith
      nlinarith
    calc _ ≤ 2 ^ P * (12 * Dm * (((B.len a : ℝ) + 1) * E + 1) / 2 ^ P) :=
          mul_le_mul_of_nonneg_left hM hN.le
      _ = 12 * Dm * (((B.len a : ℝ) + 1) * E + 1) := by field_simp
      _ ≤ _ := this
  have hMiG : |MiG s t α B a i| ≤ 1.01 * Dm := by
    unfold MiG MinvF
    have hτ := h50_TinvF_bd hα' hσ hx' hb (B.len a) (a - B.st a) (i - B.st a)
    have hdd := hT.dm a ha (a - B.st a) (by omega)
    have hdd0 : 0 < ddR (α:ℝ) ((t:ℝ)/s) (a - B.st a) := Real.exp_pos _
    have hdi0 : 0 < diR (α:ℝ) ((t:ℝ)/s) (i - B.st a) := Real.exp_pos _
    have hdi1 : diR (α:ℝ) ((t:ℝ)/s) (i - B.st a) ≤ 1 := by
      unfold diR; rw [Real.exp_le_one_iff]
      have : 0 ≤ π * (α:ℝ) ^ 2 * ((t:ℝ)/s - 1) * ((i - B.st a : ℕ) : ℝ) ^ 2 := by
        have := Real.pi_pos; have : 0 ≤ (t:ℝ)/s - 1 := by linarith
        positivity
      linarith
    rw [abs_mul, abs_mul, abs_of_pos hdd0, abs_of_pos hdi0]
    have := abs_nonneg (TinvF (α:ℝ) ((t:ℝ)/s) ((bOf s t (B.st a) : ℝ) / s) (B.len a) (a - B.st a) (i - B.st a))
    calc _ ≤ Dm * 1.01 * 1 := by gcongr
      _ = _ := by ring
  obtain ⟨he0, he1⟩ := h50_eEx_bd (α := α) hs hst (i : ℤ) h
  have e2 := h4_fmul_err P hM' (hT.cpl i his h hh) hMiG
    (show |eEx s t α i h| ≤ 1 by rw [abs_of_nonneg he0]; exact he1)
  have h3 : 12 * Dm * K * E / 2 ^ P ≤ 0.12 * Dm * K := by
    rw [div_le_iff₀ hN]
    have : 100 * E ≤ 2 ^ P := by nlinarith
    have h0 : 0 ≤ 12 * Dm * K := by positivity
    nlinarith [mul_le_mul_of_nonneg_left this h0]
  have hfin : |(fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) - 2 ^ P * (MiG s t α B a i * eEx s t α i h)|
      ≤ 15 * Dm * K := by
    have : 1 ≤ Dm * K := by nlinarith
    have : E * Dm ≤ K * Dm := by nlinarith
    nlinarith
  have e : (fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P - MiG s t α B a i * eEx s t α i h
      = ((fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) - 2 ^ P * (MiG s t α B a i * eEx s t α i h)) / 2 ^ P := by
    field_simp
  rw [e, abs_div, abs_of_pos hN]
  exact div_le_div_of_nonneg_right hfin hN.le
theorem h50_col_mem {s t : ℕ} {B : Blocks} (hB : BlocksOK s t B) (hs : 0 < s) {i : ℕ} (hi : i < s)
    {h : ℤ} (hh : h ∈ Hset B i) : col B.s i h ∈ (Jlist B).toFinset ∧ col B.s i h < s := by
  unfold Hset at hh
  simp only [Finset.mem_filter, Finset.mem_image, Finset.mem_range] at hh
  obtain ⟨⟨j, hj, hjh⟩, hne, hout⟩ := hh
  have hw := hB.hw
  have key : ∀ (m : ℕ) (q : ℤ), m < s → (i : ℤ) + h = m + s * q → col B.s i h = m := by
    intro m q hm he
    unfold col
    rw [hB.hs, he, Int.add_mul_emod_self_left, Int.emod_eq_of_lt (by positivity) (by exact_mod_cast hm)]
    simp
  have fin : ∀ m : ℕ, m < s → col B.s i h = m →
      (m < B.st m + B.w ∨ B.st m + B.len m < m + B.w + 1) →
      col B.s i h ∈ (Jlist B).toFinset ∧ col B.s i h < s := by
    intro m hm hc hn
    rw [hc]
    refine ⟨?_, hm⟩
    unfold Jlist
    rw [List.mem_toFinset, List.mem_filter, List.mem_range, hB.hs]
    refine ⟨hm, ?_⟩
    unfold nearB; simpa using hn
  obtain ⟨ci1, ci2, ci3⟩ := hB.cover i hi
  rcases lt_or_ge ((i : ℤ) + h) 0 with hA | hA
  · -- wrap below
    have hm : ((i : ℤ) + h + s).toNat < s := by omega
    refine fin _ hm (key _ (-1) hm (by omega)) ?_
    right
    obtain ⟨-, -, c3⟩ := hB.cover _ hm
    omega
  rcases lt_or_ge ((i : ℤ) + h) s with hC | hC
  · have hm : ((i : ℤ) + h).toNat < s := by omega
    refine fin _ hm (key _ 0 hm (by omega)) ?_
    set m := ((i : ℤ) + h).toNat with hmdef
    have hmi : (m : ℤ) = i + h := by omega
    obtain ⟨cm1, cm2, cm3⟩ := hB.cover m hm
    have hout' : m < B.st i ∨ B.st i + B.len i ≤ m := by
      by_contra hc; push_neg at hc; apply hout; omega
    rcases hout' with ho | ho
    · right
      have : B.st m + B.len m ≤ B.st i := by
        by_contra hc; push_neg at hc
        have e1 := (hB.cons m hm (B.st i) (by omega) hc).1
        have e2 := (hB.cons i hi (B.st i) le_rfl (by omega)).1
        omega
      omega
    · left
      have : B.st i + B.len i ≤ B.st m := by
        by_contra hc; push_neg at hc
        rcases le_or_gt (B.st i) (B.st m) with hsm | hsm
        · have e1 := hB.cons i hi (B.st m) hsm hc
          have e2 := hB.cons m hm (B.st m) le_rfl (by omega)
          omega
        · have e1 := (hB.cons m hm (B.st i) hsm.le (by omega)).1
          have e2 := (hB.cons i hi (B.st i) le_rfl (by omega)).1
          omega
      omega
  · have hm : ((i : ℤ) + h - s).toNat < s := by omega
    refine fin _ hm (key _ 1 hm (by omega)) ?_
    left; omega
theorem h50_Hset_card (B : Blocks) (i : ℕ) : ((Hset B i).card : ℝ) ≤ 2 * B.w + 1 := by
  have h3 : (Hset B i).card ≤ 2 * B.w + 1 := by
    unfold Hset
    exact (Finset.card_filter_le _ _).trans (Finset.card_image_le.trans (by simp))
  exact_mod_cast h3

theorem h50_capsum {P : ℕ} {T : Tables} {B : Blocks} (a : ℕ) (zr : ℕ → ℝ)
    (hcol : ∀ i ∈ Finset.Ico (B.st a) (B.st a + B.len a), ∀ h ∈ Hset B i, col B.s i h ∈ (Jlist B).toFinset)
    (ha : a ∈ (Jlist B).toFinset) :
    ∑ k ∈ (Jlist B).toFinset, (capI P T B a k : ℝ) / 2 ^ P * zr k =
      zr a + ∑ i ∈ Finset.Ico (B.st a) (B.st a + B.len a), ∑ h ∈ Hset B i,
        (fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P * zr (col B.s i h) := by
  have hN : (2:ℝ) ^ P ≠ 0 := by positivity
  have hk : ∀ k, (capI P T B a k : ℝ) / 2 ^ P * zr k = (if a = k then zr k else 0) +
      ∑ i ∈ Finset.Ico (B.st a) (B.st a + B.len a), ∑ h ∈ Hset B i,
        (if col B.s i h = k then (fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P * zr k else 0) := by
    intro k
    unfold capI
    push_cast
    rw [add_div, add_mul, Finset.sum_div, Finset.sum_mul]
    congr 1
    · split_ifs <;> simp [hN]
    · apply Finset.sum_congr rfl; intro i _
      rw [Finset.sum_div, Finset.sum_mul]
      apply Finset.sum_congr rfl; intro h _
      split_ifs <;> simp
  rw [Finset.sum_congr rfl (fun k _ => hk k), Finset.sum_add_distrib, Finset.sum_ite_eq, if_pos ha]
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl; intro i hi
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl; intro h hh
  rw [Finset.sum_ite_eq, if_pos (hcol i hi h hh)]

theorem h50_cap_apply {P s t α : ℕ} {B : Blocks} {T : Tables} {E Dm : ℝ}
    (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α)
    (hx : 3 ≤ xθ s t α) (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E) {lam : ℕ}
    (hlam : ∀ i < s, B.len i ≤ lam) (hP : 100 * (((lam : ℝ) + 1) * E + 1) ≤ 2 ^ P)
    {a : ℕ} (ha : a ∈ (Jlist B).toFinset) (ha' : a < s) (zr : ℕ → ℝ) {Z : ℝ} (hZ0 : 0 ≤ Z)
    (hz : ∀ k ∈ (Jlist B).toFinset, |zr k| ≤ Z) :
    |∑ k ∈ (Jlist B).toFinset, (capI P T B a k : ℝ) / 2 ^ P * zr k -
      (zr a + Mv (blS B) (MiG s t α B) (Dv (Hset B) (col B.s) (cfG s t α) zr) a)| ≤
      lam * (2 * B.w + 1) * (15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P) * Z := by
  obtain ⟨c1, c2, c3⟩ := hB.cover a ha'
  have hcolm : ∀ i ∈ Finset.Ico (B.st a) (B.st a + B.len a), ∀ h ∈ Hset B i,
      col B.s i h ∈ (Jlist B).toFinset := by
    intro i hi h hh
    have := Finset.mem_Ico.mp hi
    exact (h50_col_mem hB hs (by omega) hh).1
  rw [h50_capsum a zr hcolm ha]
  set δ : ℝ := 15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P with hδ
  have hMv : Mv (blS B) (MiG s t α B) (Dv (Hset B) (col B.s) (cfG s t α) zr) a =
      ∑ i ∈ Finset.Ico (B.st a) (B.st a + B.len a), ∑ h ∈ Hset B i,
        MiG s t α B a i * eEx s t α i h * zr (col B.s i h) := by
    unfold Mv Dv blS cfG
    apply Finset.sum_congr rfl; intro i _
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro h _; ring
  rw [hMv]
  have hd : ∀ i ∈ Finset.Ico (B.st a) (B.st a + B.len a),
      |∑ h ∈ Hset B i, ((fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P * zr (col B.s i h) -
        MiG s t α B a i * eEx s t α i h * zr (col B.s i h))| ≤ (2 * B.w + 1) * (δ * Z) := by
    intro i hi
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    have : ∀ h ∈ Hset B i, |(fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P * zr (col B.s i h) -
        MiG s t α B a i * eEx s t α i h * zr (col B.s i h)| ≤ δ * Z := by
      intro h hh
      have e1 := h50_cap_term hB hs hst hα hx hT hE hlam hP ha' (by unfold blS; exact hi) hh
      have e2 := hz _ (hcolm i hi h hh)
      rw [show (fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P * zr (col B.s i h) -
        MiG s t α B a i * eEx s t α i h * zr (col B.s i h) =
        ((fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P - MiG s t α B a i * eEx s t α i h) *
          zr (col B.s i h) by ring, abs_mul]
      exact mul_le_mul e1 e2 (abs_nonneg _) (by rw [hδ]; exact (abs_nonneg _).trans e1)
    refine (Finset.sum_le_sum this).trans ?_
    rw [Finset.sum_const, nsmul_eq_mul]
    have hδ0 : 0 ≤ δ * Z := by
      have : 0 ≤ δ := by
        have h0 := h50_cap_term hB hs hst hα hx hT hE hlam hP ha' (i := a) (h := 0)
        rw [hδ]
        have : 1 ≤ Dm := by
          have := hT.dm a ha' 0 (by omega); unfold ddR at this; simp at this; linarith
        have : (0:ℝ) ≤ lam := by positivity
        positivity
      positivity
    exact mul_le_mul_of_nonneg_right (h50_Hset_card B i) hδ0
  rw [show ∀ x y z : ℝ, x + y - (x + z) = y - z by intros; ring, ← Finset.sum_sub_distrib]
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  rw [Finset.sum_congr rfl (fun i _ => by rw [← Finset.sum_sub_distrib])]
  refine (Finset.sum_le_sum hd).trans ?_
  rw [Finset.sum_const, nsmul_eq_mul, Nat.card_Ico]
  have hl : ((B.st a + B.len a - B.st a : ℕ) : ℝ) ≤ lam := by
    rw [Nat.add_sub_cancel_left]; exact_mod_cast hlam a ha'
  have h0 : 0 ≤ (2 * (B.w : ℝ) + 1) * (δ * Z) := by
    have : 0 ≤ δ := by
      rw [hδ]
      have : 1 ≤ Dm := by
        have := hT.dm a ha' 0 (by omega); unfold ddR at this; simp at this; linarith
      have : (0:ℝ) ≤ lam := by positivity
      positivity
    positivity
  calc _ ≤ (lam : ℝ) * ((2 * B.w + 1) * (δ * Z)) := mul_le_mul_of_nonneg_right hl h0
    _ = _ := by ring

theorem solution (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α)
    (hx : 3 ≤ xθ s t α) (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E) {lam : ℕ}
    (hlam : ∀ i < s, B.len i ≤ lam) (hP : 100 * (((lam : ℝ) + 1) * E + 1) ≤ 2 ^ P)
    {a : ℕ} (ha : a ∈ (Jlist B).toFinset) (ha' : a < s) (zr : ℕ → ℝ) {Z : ℝ} (hZ0 : 0 ≤ Z)
    (hz : ∀ k ∈ (Jlist B).toFinset, |zr k| ≤ Z) :
    |∑ k ∈ (Jlist B).toFinset, (capI P T B a k : ℝ) / 2 ^ P * zr k -
      (zr a + Mv (blS B) (MiG s t α B) (Dv (Hset B) (col B.s) (cfG s t α) zr) a)| ≤
      lam * (2 * B.w + 1) * (15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P) * Z := by
  exact h50_cap_apply hB hs hst hα hx hT hE hlam hP ha ha' zr hZ0 hz

