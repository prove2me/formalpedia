-- title:
--   Dilatation of a polynomial ring along (π, Zⱼ) is polynomial
-- statement:
--   Let $R$ be a commutative ring, let $\pi \in R$ be such that multiplication by $\pi$ on $R$ is injective (`IsSMulRegular R π`), and let $\sigma$, $\tau$ be index types. Put $P = R[X_s : s \in \sigma \oplus \tau]$, write $Y_i = X_{\mathrm{inl}\,i}$ and $Z_j = X_{\mathrm{inr}\,j}$, and let $I \subseteq P$ be the ideal generated by the constant $\pi$ together with all $Z_j$, $j \in \tau$. Consider the dilatation ring [`AffineDilatation.Ring I (C π)`](def/RingTheory_AffineDilatation.html#L20), that is, the $P$-subalgebra of the localisation $P[1/\pi]$ generated by the elements $g/\pi$ with $g \in I$. The assertion is that there exists an isomorphism $e$ of $R$-algebras from this dilatation ring onto $P$ itself with the following three properties: $e$ sends the image of $Y_i$ under the structure map $P \to$ [`AffineDilatation.Ring I (C π)`](def/RingTheory_AffineDilatation.html#L20) to $Y_i$ for every $i \in \sigma$; $e$ sends, for each $j \in \tau$, the element $Z_j/\pi$ of the dilatation (the element `divElem` attached to $Z_j \in I$) to $Z_j$; and $e$ sends the image of $Z_j$ under the structure map to $\pi Z_j$ for every $j \in \tau$.
--
--   This is the model computation underlying the statement that the dilatation of a smooth scheme along a centre smooth over the residue field is again smooth: the dilatation of an affine space along the ideal $(\pi, Z_1, \dots, Z_n)$ with respect to $\pi$ is again an affine space, with the $Z_j$ replaced by $Z_j/\pi$. It is used in [`AffineDilatation.exists_basis_kaehlerDifferential_of_smooth_of_basis`](thm.html#AffineDilatation.exists_basis_kaehlerDifferential_of_smooth_of_basis) to produce a basis of the module of Kähler differentials of a dilatation.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AffineDilatation_nonempty_algEquiv_mvPolynomial_sum.lean

import Mathlib
import Definitions.Def_RingTheory_AffineDilatation

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u v

theorem AffineDilatation.nonempty_algEquiv_mvPolynomial_sum
    {R : Type u} [CommRing R] (π : R) (hπ : IsSMulRegular R π) (σ : Type v) (τ : Type v) :
    ∃ e : AffineDilatation.Ring
          (Ideal.span (insert (MvPolynomial.C π) (Set.range fun j : τ => (MvPolynomial.X (Sum.inr j) : MvPolynomial (σ ⊕ τ) R))))
          (MvPolynomial.C π) ≃ₐ[R] MvPolynomial (σ ⊕ τ) R,
      (∀ i : σ, e (algebraMap (MvPolynomial (σ ⊕ τ) R) _ (MvPolynomial.X (Sum.inl i))) = MvPolynomial.X (Sum.inl i)) ∧
      (∀ j : τ, e (AffineDilatation.divElem _ (MvPolynomial.C π) (MvPolynomial.X (Sum.inr j))
          (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨j, rfl⟩))) = MvPolynomial.X (Sum.inr j)) ∧
      (∀ j : τ, e (algebraMap (MvPolynomial (σ ⊕ τ) R) _ (MvPolynomial.X (Sum.inr j))) =
          MvPolynomial.C π * MvPolynomial.X (Sum.inr j)) := by sorry
