  rw [hE, map_sub]
  have hz : Agree (d.degree + 1) ((-f) ^ (d.degree + 1)) 0 := by
    intro e he
    rw [map_zero]
    exact coeff_pow_eq_zero (by rw [map_neg, hf, neg_zero]) _ e he
  have := hz.mul_right (eulFun f) d (by omega)
