-- title:
--   Completed natural filtration $\mathcal F^B$ of a process
-- statement:
--   For a real process $B=(B_t)_{t\ge0}$ on $(\Omega,\mathcal F,\mathbb P)$, the **completed natural filtration** is
--   $$
--   \mathcal F^B_t:=\overline{\sigma(B_s:\ s\le t)}^{\mathbb P},\qquad t\ge0,
--   $$
--   the $\sigma$-algebra generated by the path up to time $t$, completed by the $\mathbb P$-null sets. The Brownian control value $E_\star(\kappa)$ is an infimum over controls that are progressively measurable for this filtration.
-- source:
--   Jo, Lee, The Exact Online Threshold for the Asymmetric Binary Perceptron, arXiv:2609.02124 (artifact sha256 bd5e2bdb18a47b7e806191ae9b888a6e4e7e150a9bd50e541b7587007d07a7a2), §2.2, p.6 (PDF p.7)

import Mathlib
import Definitions.Def_ABPOnline_augmentSigma

set_option autoImplicit false

open MeasureTheory
open scoped NNReal

namespace ABPOnline

/-- The **completed natural filtration** `F^B = (F^B_t)` of a real process `B` indexed by `ℝ≥0`
(arXiv:2609.02124, §2.2, printed p.6, PDF p.7): `F^B_t` is the σ-algebra generated by
`(B_s)_{s ≤ t}`, completed by the `P`-null sets (see `augmentSigma`). -/
def brownFiltration {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) (B : ℝ≥0 → Ω → ℝ) :
    Filtration ℝ≥0 mΩ where
  seq t := augmentSigma P (⨆ s ≤ t, MeasurableSpace.comap (B s) inferInstance)
  mono' _ _ hst := augmentSigma_mono P (iSup₂_mono' fun s hs => ⟨s, hs.trans hst, le_rfl⟩)
  le' _ := augmentSigma_le P _

end ABPOnline


