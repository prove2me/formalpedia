(metric `−dt² + dr² + dθ² + sin²θ dφ²` pulled back by `β ↦ β + λ sin α`). Same role as
`Atlas/Core/Deriv.lean` (first release, unchanged). -/

open Real

namespace ExactVacuumAtlas.Deriv

theorem mul_cos_mul_sin_sq (K θ : ℝ) :
    HasDerivAt (fun t => K * (cos t * sin t ^ 2)) (K * (2 * cos θ ^ 2 * sin θ - sin θ ^ 3)) θ := by
  have h := ((Real.hasDerivAt_cos θ).fun_mul ((Real.hasDerivAt_sin θ).fun_pow 2)).const_mul K
  refine h.congr_deriv ?_
  push_cast; ring

end ExactVacuumAtlas.Deriv

