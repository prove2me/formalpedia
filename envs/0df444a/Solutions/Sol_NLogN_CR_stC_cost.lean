    simp only [Ex.regs] at h; simp only [Ex.Bnd, Ex.bnd_upd s j L B a h, Ex.eval_upd s j L a h]
  | .sel c x y, h => by
    simp only [Ex.regs, List.mem_append, not_or] at h
    simp only [Ex.Bnd, Ex.bnd_upd s j L B c h.1.1, Ex.bnd_upd s j L B x h.1.2,
