theorem eE_eval {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {sN lam q : ℕ}
    (h6 : v 6 = q) (h22 : v 22 = sN) (h24 : v 24 = lam) :
    eE.eval (encK s (RF v c)) = ((min sN (q * lam + lam) : ℕ) : ℤ) := by
  simp only [eE, qE, Ex.eval, top_RF (show (6 : Fin HS) ∈ rg by decide),
    top_RF (show (22 : Fin HS) ∈ rg by decide), top_RF (show (24 : Fin HS) ∈ rg by decide),
    h6, h22, h24]
  split_ifs with h <;> push_cast <;> omega

end J6Seg.PreT

