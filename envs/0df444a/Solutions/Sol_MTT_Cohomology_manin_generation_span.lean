import Definitions.Def_MTT_Cohomology
import Mathlib.RingTheory.Flat.Basic

set_option autoImplicit false
set_option maxHeartbeats 1000000
noncomputable section
open scoped BigOperators TensorProduct
open MTT.Cohomology

namespace P2MMGS

variable {N n : ℕ} {R : Type*} [CommRing R]

/-! ### Explicit unimodular matrices and their action on the two base cusps -/

def mk2 (a b c d : ℤ) (h : a * d - b * c = 1) : Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  ⟨!![a, b; c, d], by simp [Matrix.det_fin_two_of]; linarith⟩

theorem ent (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) (i j : Fin 2) :
    ((Matrix.SpecialLinearGroup.mapGL ℚ g : Matrix.GeneralLinearGroup (Fin 2) ℚ) :
      Matrix (Fin 2) (Fin 2) ℚ) i j = ((g.val i j : ℤ) : ℚ) := rfl

theorem e00 (a b c d : ℤ) (h : a * d - b * c = 1) : ((mk2 a b c d h).val 0 0 : ℤ) = a := rfl
theorem e01 (a b c d : ℤ) (h : a * d - b * c = 1) : ((mk2 a b c d h).val 0 1 : ℤ) = b := rfl
theorem e10 (a b c d : ℤ) (h : a * d - b * c = 1) : ((mk2 a b c d h).val 1 0 : ℤ) = c := rfl
theorem e11 (a b c d : ℤ) (h : a * d - b * c = 1) : ((mk2 a b c d h).val 1 1 : ℤ) = d := rfl

theorem cuspAct_infty (a b c d : ℤ) (h : a * d - b * c = 1) (hc : (c : ℚ) ≠ 0) :
    cuspAct (mk2 a b c d h) OnePoint.infty = (((a : ℚ) / (c : ℚ) : ℚ) : Cusp) := by
  rw [cuspAct, OnePoint.smul_infty_eq_ite]
  simp only [ent, e00, e10]
  simp [hc]

theorem cuspAct_infty_of_zero (a b d : ℤ) (h : a * d - b * 0 = 1) :
    cuspAct (mk2 a b 0 d h) OnePoint.infty = OnePoint.infty := by
  rw [cuspAct, OnePoint.smul_infty_eq_ite]
  simp only [ent, e10]
  simp

theorem cuspAct_zero (a b c d : ℤ) (h : a * d - b * c = 1) (hd : (d : ℚ) ≠ 0) :
    cuspAct (mk2 a b c d h) ((0 : ℚ) : Cusp) = (((b : ℚ) / (d : ℚ) : ℚ) : Cusp) := by
  rw [cuspAct, OnePoint.smul_some_eq_ite]
  simp only [ent, e00, e01, e10, e11]
  simp [hd]

/-! ### The subgroup generated by the unimodular values -/

def Gens (φ : Hc N n R) : Set (Binary R) :=
  Set.range fun g : Matrix.SpecialLinearGroup (Fin 2) ℤ =>
    φ.val (cuspAct g ((0 : ℚ) : Cusp), cuspAct g OnePoint.infty)

theorem gen_mem (φ : Hc N n R) (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) :
    φ.val (cuspAct g ((0 : ℚ) : Cusp), cuspAct g OnePoint.infty)
      ∈ AddSubgroup.closure (Gens φ) :=
  AddSubgroup.subset_closure ⟨g, rfl⟩

theorem diag_zero (φ : Hc N n R) (x : Cusp) : φ.val (x, x) = 0 := by
  have h := φ.2.2.1 x x x
  have h2 : φ.val (x, x) + φ.val (x, x) - φ.val (x, x) = 0 := by rw [h]; simp
  simpa using h2

theorem val_sub (φ : Hc N n R) (c a b : Cusp) :
    φ.val (a, b) = φ.val (c, b) - φ.val (c, a) := by
  have h := φ.2.2.1 c a b
  rw [← h]; ring

/-- The value on the unimodular path joining `b/d` to `a/c`. -/
theorem path_mem (φ : Hc N n R) (a b c d : ℤ) (h : a * d - b * c = 1)
    (hc : (c : ℚ) ≠ 0) (hd : (d : ℚ) ≠ 0) :
    φ.val ((((b : ℚ) / (d : ℚ) : ℚ) : Cusp), (((a : ℚ) / (c : ℚ) : ℚ) : Cusp))
      ∈ AddSubgroup.closure (Gens φ) := by
  have hg := gen_mem φ (mk2 a b c d h)
  rwa [cuspAct_zero a b c d h hd, cuspAct_infty a b c d h hc] at hg

/-- The path from infinity to an integer. -/
theorem int_path_mem (φ : Hc N n R) (p : ℤ) :
    φ.val (OnePoint.infty, (((p : ℚ) / ((1 : ℕ) : ℚ) : ℚ) : Cusp))
      ∈ AddSubgroup.closure (Gens φ) := by
  have hdet : (1 : ℤ) * 1 - p * 0 = 1 := by ring
  have hg := gen_mem φ (mk2 1 p 0 1 hdet)
  rw [cuspAct_zero 1 p 0 1 hdet (by norm_num), cuspAct_infty_of_zero] at hg
  have hsplit := φ.2.2.1 OnePoint.infty (((p : ℚ) / ((1 : ℤ) : ℚ) : ℚ) : Cusp) OnePoint.infty
  rw [diag_zero] at hsplit
  have hval : φ.val (OnePoint.infty, (((p : ℚ) / ((1 : ℤ) : ℚ) : ℚ) : Cusp))
      = -φ.val ((((p : ℚ) / ((1 : ℤ) : ℚ) : ℚ) : Cusp), OnePoint.infty) := by
    rw [eq_neg_iff_add_eq_zero, hsplit]
  have hcast : (((1 : ℕ) : ℚ)) = (((1 : ℤ) : ℚ)) := by norm_num
  rw [hcast, hval]
  exact neg_mem hg

/-! ### Euclidean descent -/

theorem main (φ : Hc N n R) : ∀ d : ℕ, ∀ p : ℤ, 0 < d → Int.gcd p (d : ℤ) = 1 →
    φ.val (OnePoint.infty, (((p : ℚ) / (d : ℚ) : ℚ) : Cusp))
      ∈ AddSubgroup.closure (Gens φ) := by
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
    intro p hd hgcd
    rcases eq_or_lt_of_le (Nat.one_le_iff_ne_zero.mpr hd.ne') with h1 | h1
    · subst h1
      exact int_path_mem φ p
    · obtain ⟨q', p', hq'0, hq'd, hdet⟩ :
          ∃ q' p' : ℤ, 0 ≤ q' ∧ q' < (d : ℤ) ∧ p * q' - p' * (d : ℤ) = 1 := by
        refine ⟨Int.gcdA p (d : ℤ) % (d : ℤ),
          -(Int.gcdB p (d : ℤ)) - p * (Int.gcdA p (d : ℤ) / (d : ℤ)), ?_, ?_, ?_⟩
        · exact Int.emod_nonneg _ (by exact_mod_cast hd.ne')
        · exact Int.emod_lt_of_pos _ (by exact_mod_cast hd)
        · have hbez : (1 : ℤ) = p * Int.gcdA p (d : ℤ) + (d : ℤ) * Int.gcdB p (d : ℤ) := by
            have hg := Int.gcd_eq_gcd_ab p (d : ℤ)
            rw [hgcd] at hg
            exact_mod_cast hg
          have hq : Int.gcdA p (d : ℤ) % (d : ℤ)
              = Int.gcdA p (d : ℤ) - (d : ℤ) * (Int.gcdA p (d : ℤ) / (d : ℤ)) :=
            Int.emod_def _ _
          rw [hq]
          have hring : p * (Int.gcdA p (d : ℤ) - (d : ℤ) * (Int.gcdA p (d : ℤ) / (d : ℤ)))
              - (-(Int.gcdB p (d : ℤ)) - p * (Int.gcdA p (d : ℤ) / (d : ℤ))) * (d : ℤ)
              = p * Int.gcdA p (d : ℤ) + (d : ℤ) * Int.gcdB p (d : ℤ) := by ring
          rw [hring, ← hbez]
      have hdpos : (0 : ℤ) < (d : ℤ) := by exact_mod_cast hd
      have hq'ne : q' ≠ 0 := by
        rintro rfl
        have hdvd : (d : ℤ) ∣ 1 := ⟨-p', by linarith⟩
        have hle := Int.le_of_dvd one_pos hdvd
        omega
      have hgcd' : Int.gcd p' q' = 1 := by
        rw [← Int.isCoprime_iff_gcd_eq_one]
        exact ⟨-(d : ℤ), p, by linear_combination hdet⟩
      have heq : ((q'.toNat : ℕ) : ℤ) = q' := Int.toNat_of_nonneg hq'0
      have hepos : 0 < q'.toNat := by omega
      have helt : q'.toNat < d := by omega
      have hIH := ih q'.toNat helt p' hepos (by rw [heq]; exact hgcd')
      have hqQ : ((q'.toNat : ℕ) : ℚ) = ((q' : ℤ) : ℚ) := by exact_mod_cast heq
      rw [hqQ] at hIH
      have hq'Q : ((q' : ℤ) : ℚ) ≠ 0 := Int.cast_ne_zero.mpr hq'ne
      have hdQ : (((d : ℕ) : ℤ) : ℚ) ≠ 0 := by
        simpa using (Nat.cast_ne_zero (R := ℚ)).mpr hd.ne'
      have hpath := path_mem φ p p' (d : ℤ) q' hdet hdQ hq'Q
      have hdQ' : (((d : ℕ) : ℤ) : ℚ) = ((d : ℕ) : ℚ) := by push_cast; ring
      rw [hdQ'] at hpath
      have hsplit := φ.2.2.1 OnePoint.infty
        ((((p' : ℚ) / ((q' : ℤ) : ℚ) : ℚ)) : Cusp) (((p : ℚ) / ((d : ℕ) : ℚ) : ℚ) : Cusp)
      rw [← hsplit]
      exact add_mem hIH hpath

end P2MMGS

open P2MMGS in
theorem solution {N n : ℕ} {R : Type*} [CommRing R] (φ : Hc N n R) (x y : Cusp) :
    φ.val (x, y) ∈ AddSubgroup.closure
      (Set.range fun g : Matrix.SpecialLinearGroup (Fin 2) ℤ =>
        φ.val (cuspAct g ((0 : ℚ) : Cusp), cuspAct g OnePoint.infty)) := by
  have hall : ∀ z : Cusp, φ.val (OnePoint.infty, z) ∈ AddSubgroup.closure (Gens φ) := by
    intro z
    induction z using OnePoint.rec with
    | infty => rw [diag_zero]; exact zero_mem _
    | coe r =>
        have hco : Int.gcd r.num (r.den : ℤ) = 1 := by
          simpa [Int.gcd] using r.reduced
        have hm := main φ r.den r.num r.pos hco
        rwa [Rat.num_div_den] at hm
  rw [val_sub φ OnePoint.infty x y]
  exact sub_mem (hall y) (hall x)
