        star '' ((d • Submodule.ofFiniteIdele Λ₁ (x * g) : Submodule ℤ ℍ[ℚ, a, b]) : Set ℍ[ℚ, a, b]) ∧
      Nat.card ψ.ker ^ 2 = (Submodule.ofFiniteIdele Λ₁ (x * g)).toAddSubgroup.relIndex (Submodule.ofFiniteIdele Λ₁ x).toAddSubgroup := by sorry
