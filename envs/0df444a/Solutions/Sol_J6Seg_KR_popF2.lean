section BFl
variable {G : Fin HS → List ℤ} {r0 w1 w2 o dt du bn bn2 vr vk vj bc : List ℤ}

theorem BFu_bn (v : List ℤ) : Function.update (BF G r0 w1 w2 o dt du bn bn2 vr vk vj bc) bN v = BF G r0 w1 w2 o dt du v bn2 vr vk vj bc := by
  unfold BF; rw [Function.update_comm (show BC ≠ bN by decide), Function.update_comm (show kJ ≠ bN by decide), Function.update_comm (show kK ≠ bN by decide), Function.update_comm (show kr ≠ bN by decide), Function.update_comm (show bN2 ≠ bN by decide), Function.update_idem]
theorem BFu_bn2 (v : List ℤ) : Function.update (BF G r0 w1 w2 o dt du bn bn2 vr vk vj bc) bN2 v = BF G r0 w1 w2 o dt du bn v vr vk vj bc := by
  unfold BF; rw [Function.update_comm (show BC ≠ bN2 by decide), Function.update_comm (show kJ ≠ bN2 by decide), Function.update_comm (show kK ≠ bN2 by decide), Function.update_comm (show kr ≠ bN2 by decide), Function.update_idem]
theorem BFu_vr (v : List ℤ) : Function.update (BF G r0 w1 w2 o dt du bn bn2 vr vk vj bc) kr v = BF G r0 w1 w2 o dt du bn bn2 v vk vj bc := by
  unfold BF; rw [Function.update_comm (show BC ≠ kr by decide), Function.update_comm (show kJ ≠ kr by decide), Function.update_comm (show kK ≠ kr by decide), Function.update_idem]
theorem BFu_vk (v : List ℤ) : Function.update (BF G r0 w1 w2 o dt du bn bn2 vr vk vj bc) kK v = BF G r0 w1 w2 o dt du bn bn2 vr v vj bc := by
  unfold BF; rw [Function.update_comm (show BC ≠ kK by decide), Function.update_comm (show kJ ≠ kK by decide), Function.update_idem]
theorem BFu_vj (v : List ℤ) : Function.update (BF G r0 w1 w2 o dt du bn bn2 vr vk vj bc) kJ v = BF G r0 w1 w2 o dt du bn bn2 vr vk v bc := by
  unfold BF; rw [Function.update_comm (show BC ≠ kJ by decide), Function.update_idem]
theorem BFu_bc (v : List ℤ) : Function.update (BF G r0 w1 w2 o dt du bn bn2 vr vk vj bc) BC v = BF G r0 w1 w2 o dt du bn bn2 vr vk vj v := by
  unfold BF; rw [Function.update_idem]

end BFl

