section
-- Source module: Solutions.KFMS6
/-!
# KFM S6: the sources and their inverses (math side)

* `srcN n i = s_i`, `prodN n i = ∏_{j<i} s_j`, `muN n i = μ_i = (prodN n i)^{-1} mod s_i`.
* **`indZ_eq`**: for `0 ≤ m < s`, `(s − ((m + s − 1) mod s)) / s = [m = 1]`. This is the
  indicator the IL sum uses (only `nmod`/`ndiv`).
* **`sum_mu`**: `Σ_{y=1}^{s} y·[y·(P mod s) mod s = 1] = muInv P s` for coprime `P, s`, `s ≥ 2`.
* **`prod_mod_seq`**: the running product `c ↦ (c·s_{i−1−k}) mod s_i` ends at `prodN n i mod s_i`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP

/-- `d' = dℓ − L`. -/
noncomputable def dpN (n : ℕ) : ℕ := mcnt (IntMul.OpenAI.Glue.LP n) (IntMul.OpenAI.Glue.dP n)

/-- The source `s_i`. -/
noncomputable def srcN (n i : ℕ) : ℕ := srcS (IntMul.OpenAI.Glue.dP n) (dpN n) (IntMul.OpenAI.Glue.rP n) i

/-- `P_i = ∏_{j<i} s_j`. -/
noncomputable def prodN (n i : ℕ) : ℕ := ∏ j ∈ Finset.range i, srcN n j

/-- `μ_i = P_i^{-1} mod s_i`. -/
noncomputable def muN (n i : ℕ) : ℕ := muInv (prodN n i) (srcN n i)

/-- The running product modulo `s`. -/
def pmSeq (s : ℕ) (g : ℕ → ℕ) : ℕ → ℕ
  | 0 => 1
  | k + 1 => (pmSeq s g k * g k) % s

end NLogN.KFM

end

section
-- Source module: Solutions.KFMS7
/-!
# KFM S7: the source and inverse lists in IL (run lemmas)

Scratch stacks `1–5` (setup is a leaf procedure, UNIFORM amendment): `mOc = 1` outer counter,
`mS = 2` the source `s_i`, `mP = 3` the running product, `mM = 4` the sum, `mIc = 5` the inner
counter. The parameters are read from `zDp, zQ, zMh, zMf` (KFMS3).

* `srcE ix`: `s_j = 1 + Q·(j < d' ? M_h − j : M_f − (j − d'))` for `j = ix` (**`srcE_spec`**).
* `muB dst`: for `i = (top of mOc) − 1`, computes `P_i mod s_i` by a product loop, then
  `μ_i = Σ_{y=1}^{s_i} y·[y P_i ≡ 1]` by a sum loop, and pushes `μ_i` on `dst`
  (**`muB_run`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul RS

abbrev mOc : Fin HS := 1
abbrev mS : Fin HS := 2
abbrev mP : Fin HS := 3
abbrev mM : Fin HS := 4
abbrev mIc : Fin HS := 5

/-- The source value for generic parameters. -/
def srcV (d' Q Mh Mf j : ℕ) : ℕ := 1 + Q * (if j < d' then Mh - j else Mf - (j - d'))

/-- `s_j` for `j = ix`. -/
def srcE (ix : Ex HS) : Ex HS :=
  .add (.lit 1) (.mul (.reg zQ) (.sel (.add ix (.neg (.reg zDp))) (.add (.reg zMh) (.neg ix))
    (.add (.reg zMf) (.neg (.add ix (.neg (.reg zDp)))))))

def ixO : Ex HS := .add (.reg mOc) (.lit (-1))
def ixI : Ex HS := .add (.reg mIc) (.lit (-1))

/-- The product body: `P ← (P · s_j) mod s_i`, `j = (top of mIc) − 1`. -/
def pmB : RS := .asg mP (.nmod (.mul (.reg mP) (NLogN.KFM.srcE ixI)) (.reg mS))

/-- `[y·P mod s = 1]` for `y` on `mIc`. -/
def indE : Ex HS :=
  .ndiv (.add (.reg mS) (.neg (.nmod (.add (.nmod (.mul (.reg mIc) (.reg mP)) (.reg mS))
    (.add (.reg mS) (.lit (-1)))) (.reg mS)))) (.reg mS)

/-- The sum body: `M ← M + y·[y P ≡ 1]`. -/
def sumB : RS := .asg mM (.add (.reg mM) (.mul (.reg mIc) indE))

/-- One inverse: push `μ_i` on `dst`. -/
def muB (dst : Fin HS) : RS :=
  .seq (.push mS (NLogN.KFM.srcE ixO)) (.seq (.push mP (.lit 1)) (.seq (.rep mIc ixO pmB)
    (.seq (.push mM (.lit 0)) (.seq (.rep mIc (.reg mS) NLogN.KFM.sumB) (.seq (.push dst (.reg mM))
      (.seq (.pop mM) (.seq (.pop mP) (.pop mS))))))))

/-- All inverses: `μ_{d−1}, …, μ_0` pushed on `dst` (so `μ_0` ends on top). -/
def muP (dst : Fin HS) : RS := .rep mOc (.reg NLogN.KFM.zD) (muB dst)

/-- All sources: `s_{d−1}, …, s_0` pushed on `dst`. -/
def srcP (dst : Fin HS) : RS := .rep mOc (.reg NLogN.KFM.zD) (.push dst (NLogN.KFM.srcE ixO))

/-- The parameter registers hold `d', Q, M_h, M_f`. -/
structure SrcRegs (u : IState HS) (d' Q Mh Mf : ℕ) : Prop where
  hDp : ∃ L, u.G zDp = .int (d' : ℤ) :: L
  hQ : ∃ L, u.G zQ = .int (Q : ℤ) :: L
  hMh : ∃ L, u.G zMh = .int (Mh : ℤ) :: L
  hMf : ∃ L, u.G zMf = .int (Mf : ℤ) :: L

/-! ## The product loop -/

/-! ## The sum loop -/

/-! ## One inverse -/

/-- `dst` is not one of the stacks the source/inverse code reads or uses. -/
structure DstOk (dst : Fin HS) : Prop where
  lt : dst.val < 56
  ge : 6 ≤ dst.val
  ne : dst ≠ NLogN.KFM.zD ∧ dst ≠ zDp ∧ dst ≠ zQ ∧ dst ≠ zMh ∧ dst ≠ zMf

/-! ## Loops that push one value per index -/

/-- The values pushed after `k` of `d` iterations: `v (d−k), …, v (d−1)`. -/
def pushL (v : ℕ → ℤ) (d k : ℕ) : List ℤ := (List.range k).map fun t => v (d - k + t)

end NLogN.KFM

