variable {k : Type} [CommRing k] {d : ℕ}

theorem GlobalTheory.AdditiveSeries.ev_addOf {m n : ℕ} {V : Fin m → Pt k n d} (hV : ∀ j, GP (V j)) (F : Fin d → PS k 2 d)
    (a b : Fin m) (i : Fin d) :
    ev V (addOf F (pt k d a) (pt k d b) i) = addOf F (V a) (V b) i := by sorry
