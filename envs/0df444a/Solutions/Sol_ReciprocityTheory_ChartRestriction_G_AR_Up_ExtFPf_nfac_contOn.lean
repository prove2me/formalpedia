    fun τ i => cont_dmin X τ i
  have hne : ∀ x ∈ X.dom, ∀ (τ : X.Ψ) (i : Fin (r + 1)), dmin X.Gm x τ i ≠ 0 := by
    intro x hx τ i h0
    have h1 := (hx τ).2 i
    rw [h0] at h1
    simp at h1
  unfold Data.nfac
