section
-- Source module: Solutions.KIL6Desc
/-!
# KIL6: the descriptor computations

Closed forms of the counted assignment loops used for the run-time descriptor of Lemma 12:

* `mulL X c`: `X := X · c` (powers `2^u`, `q^e`, `q^r`, `W^Kp`);
* `clogL b Y K`: `if 1 < Y then (K := K + 1; Y := ⌈Y / b⌉)`; iterated `N ≥ ⌈log_b y⌉` times
  from `(y, 0)` it leaves `K = ⌈log_b y⌉ = Nat.clog b y`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

/-! ## Multiplication loops -/

theorem iter_mulL (X : Fin HS) (c : ℕ) (v : Fin HS → ℕ) :
    ∀ k, (evalA (mulL X c))^[k] v = Function.update v X (v X * c ^ k)
  | 0 => by simp
  | k + 1 => by
      rw [Function.iterate_succ_apply', iter_mulL X c v k]
      simp only [mulL, evalA, NE.val, Function.update_self, Function.update_idem]
      congr 1; ring

theorem okA_mulL {F : Fin HS → List ℤ} {D : List (Fin HS)} {M : ℕ} {X : Fin HS} {c : ℕ}
