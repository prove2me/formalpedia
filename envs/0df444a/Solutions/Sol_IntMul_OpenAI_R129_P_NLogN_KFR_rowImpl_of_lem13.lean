      (((2 * (v / 2 ^ (ρ + 1)) + (Butterfly.getBit ρ v : ℕ)) * 2 ^ ρ + v % 2 ^ ρ : ℕ) : ℤ) := by
    rw [← h1]; nth_rewrite 2 [h2]; rfl
  rw [this]; push_cast; ring

