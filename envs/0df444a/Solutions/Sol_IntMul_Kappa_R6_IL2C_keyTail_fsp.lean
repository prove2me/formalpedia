theorem fin_upd (G0 : Fin HS → List ℤ) (nv R x t u y k3 : ℤ) :
    Function.update (Function.update (Function.update (Function.update (Function.update
      (Function.update (Function.update (KS G0 nv R x t u y) rK (k3 :: G0 rK)) ky (G0 ky))
      ku (G0 ku)) kt (G0 kt)) kx (G0 kx)) pR (G0 pR)) pN (G0 pN) =
