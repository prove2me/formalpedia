-- title:
--   The polygon, fans, type I and type II rays, and the fixed snake
-- statement:
--   Let the vertices of an $(n+3)$-gon be positions in cyclic order. A diagonal is an unordered pair of nonadjacent positions. A triangulation is a maximal noncrossing set of diagonals. For a ray assignment $v$, its fan consists of the nonnegative cones spanned by the rays indexed by every noncrossing diagonal set. Two such fans are **normally isomorphic** when a real linear equivalence sends each cone of the first to a cone of the second.
--
--   The Hohlweg–Lange data use the sign word $\widetilde\sigma=(+,-,\sigma,-,+)$ on vertex labels $0,\ldots,n+2$. The lower-chain labels in increasing order followed by the upper-chain labels in decreasing order give cyclic positions. For a diagonal with endpoint labels $i<j$, $R_{ij}$ is the set of labels on the open counterclockwise arc from $i$ to $j$; $S_{ij}$ replaces $0$ by $i$ and $n+2$ by $j$ when present. Its ray is the characteristic vector of $S_{ij}$, expressed in quotient coordinates $x_k-x_{n+1}$, $1\le k\le n$. The type I fan uses these rays.
--
--   For a seed triangulation $T_0$, the type II ray $v_e$ is $-\alpha_e$ when $e\in T_0$ and otherwise the sum of $\alpha_d$ over seed diagonals $d$ crossing $e$. The fixed **snake** joins alternating positions $1,n+2,2,n+1,3,\ldots$. Rotations and reflections are the maps $p\mapsto r+p$ and $p\mapsto r-p$ on cyclic positions. A flip deletes one seed diagonal and inserts the other diagonal of its quadrilateral.
--
--   $$v_e^{II}=-α_e\quad(e∈T_0),\qquad v_e^{II}=\sum_{d∈T_0,\,d\text{ crosses }e}α_d\quad(e∉T_0).$$
--
--   These definitions give a common interface for comparing the two normal fans and their parallel facet pairs. **Formalization Note** The published Chvátal triangulation supplies diagonals, crossings, and triangles. The cone constructor is `PointedCone.hull`, Mathlib's name for the nonnegative span. The fan encoding uses Hohlweg–Lange Proposition 4.3 to identify cones indexed by triangulations with normal cones.
-- source:
--   Ceballos, Santos and Ziegler, Many non-equivalent realizations of the associahedron, arXiv:1109.5544v2, pp. 5, 13, 15–19, 23, 28; Definitions 2.1 and 4.1, Figure 7, Santos vectors

import Mathlib
import Definitions.Def_ChvatalArtGallery_FanPartition_Triangulation

namespace AssocRealizations.TypesMeet

open ChvatalArtGallery.FanPartition

/-- A rotation or reflection of the cyclically ordered polygon. -/
def dihedral {N : ℕ} [NeZero N] (r : Fin N) (refl : Bool) : Fin N → Fin N :=
  fun i => if refl then r - i else r + i

def IsDihedralImage {N : ℕ} [NeZero N]
    (T T' : Finset (Sym2 (Fin N))) : Prop :=
  ∃ r refl, T' = T.image (Sym2.map (dihedral r refl))

/-- The diagonals inserted by one flip of the triangulation. -/
def flipSet (N : ℕ) (T : Finset (Sym2 (Fin N))) : Finset (Sym2 (Fin N)) :=
  Finset.univ.filter (fun e => IsDiagonal e ∧ e ∉ T ∧
    ∃ d ∈ T, IsTriangulation N (insert e (T.erase d)))

/-- Cones generated by non-crossing sets of the assigned diagonal rays. -/
def rayFan {N : ℕ} {V : Type*} [AddCommGroup V] [Module ℝ V]
    (v : Sym2 (Fin N) → V) : Set (Set V) :=
  {C | ∃ D : Finset (Sym2 (Fin N)),
      (∀ e ∈ D, IsDiagonal e) ∧
      (∀ e ∈ D, ∀ f ∈ D, ¬ Crosses e f) ∧
      C = (PointedCone.hull ℝ (v '' (↑D : Set (Sym2 (Fin N)))) : Set V)}

/-- Definition 2.1, expressed for normal fans. -/
def NormallyIsomorphic {V W : Type*} [AddCommGroup V] [Module ℝ V]
    [AddCommGroup W] [Module ℝ W] (F : Set (Set V)) (G : Set (Set W)) : Prop :=
  ∃ L : V ≃ₗ[ℝ] W, ∀ C ∈ F, L '' C ∈ G

/-- Two nonzero facet normals lie on opposite rays. -/
def Opposite {V : Type*} [AddCommGroup V] [Module ℝ V] (v w : V) : Prop :=
  ∃ c : ℝ, 0 < c ∧ v = -(c • w)

/-- Santos' vector for a diagonal relative to the seed triangulation. -/
def santosVec {N : ℕ} (T₀ : Finset (Sym2 (Fin N)))
    (e : Sym2 (Fin N)) : {d // d ∈ T₀} → ℝ :=
  fun d => if e ∈ T₀ then (if e = d.1 then -1 else 0)
    else (if Crosses e d.1 then 1 else 0)

def santosFan {N : ℕ} (T₀ : Finset (Sym2 (Fin N))) :
    Set (Set ({d // d ∈ T₀} → ℝ)) := rayFan (santosVec T₀)

/-- The alternating vertices of the fixed snake, with positions starting at zero. -/
def snakePt (n m : ℕ) : Fin (n + 3) :=
  if m % 2 = 0 then ⟨(1 + m / 2) % (n + 3), Nat.mod_lt _ (by omega)⟩
  else ⟨(n + 2 - (m - 1) / 2) % (n + 3), Nat.mod_lt _ (by omega)⟩

def snake (n : ℕ) : Finset (Sym2 (Fin (n + 3))) :=
  (Finset.range n).image (fun m => s(snakePt n m, snakePt n (m + 1)))

/-- The extended sign word `+, -, σ, -, +` on the labels 0,...,n+2. -/
def hlSign {n : ℕ} (σ : Fin (n - 1) → Bool) (k : Fin (n + 3)) : Bool :=
  if k.val = 0 ∨ k.val = n + 2 then true
  else if k.val = 1 ∨ k.val = n + 1 then false
  else if h : k.val - 2 < n - 1 then σ ⟨k.val - 2, h⟩ else false

/-- Labels in counterclockwise boundary order: lower chain then upper chain. -/
def hlOrder {n : ℕ} (σ : Fin (n - 1) → Bool) : List (Fin (n + 3)) :=
  ((List.finRange (n + 3)).filter (fun k => !hlSign σ k)) ++
    ((List.finRange (n + 3)).filter (hlSign σ)).reverse

/-- The label at a cyclic position of the polygon. -/
def hlLabel {n : ℕ} (σ : Fin (n - 1) → Bool) (p : Fin (n + 3)) : Fin (n + 3) :=
  (hlOrder σ).getD p.val 0

/-- Labels on the open counterclockwise arc from the smaller endpoint label to the larger. -/
def hlR {n : ℕ} (σ : Fin (n - 1) → Bool)
    (e : Sym2 (Fin (n + 3))) : Finset (Fin (n + 3)) :=
  Finset.univ.filter (fun k => ∃ a b : Fin (n + 3),
    e = s(a, b) ∧ hlLabel σ a < hlLabel σ b ∧
    ∃ p : Fin (n + 3), hlLabel σ p = k ∧
      0 < cdist a p ∧ cdist a p < cdist a b)

/-- Definition 4.1: replace 0 by i and n+2 by j in the below-diagonal labels. -/
def hlS {n : ℕ} (σ : Fin (n - 1) → Bool)
    (e : Sym2 (Fin (n + 3))) : Finset (Fin (n + 3)) :=
  Finset.univ.filter (fun k => ∃ a b : Fin (n + 3),
    e = s(a, b) ∧ hlLabel σ a < hlLabel σ b ∧
    ((k ∈ hlR σ e ∧ k.val ≠ 0 ∧ k.val ≠ n + 2) ∨
      (k = hlLabel σ a ∧ (⟨0, by omega⟩ : Fin (n + 3)) ∈ hlR σ e) ∨
      (k = hlLabel σ b ∧ (⟨n + 2, by omega⟩ : Fin (n + 3)) ∈ hlR σ e)))

/-- The facet normal modulo the all-ones line, in coordinates xₖ-xₙ₊₁. -/
def hlVec {n : ℕ} (σ : Fin (n - 1) → Bool)
    (e : Sym2 (Fin (n + 3))) : Fin n → ℝ :=
  fun k => (if (⟨k.val + 1, by omega⟩ : Fin (n + 3)) ∈ hlS σ e then 1 else 0) -
    (if (⟨n + 1, by omega⟩ : Fin (n + 3)) ∈ hlS σ e then 1 else 0)

def hlFan {n : ℕ} (σ : Fin (n - 1) → Bool) : Set (Set (Fin n → ℝ)) :=
  rayFan (hlVec σ)

def altSigma (n : ℕ) : Fin (n - 1) → Bool := fun i => i.val % 2 = 0

def hlSignPos {n : ℕ} (σ : Fin (n - 1) → Bool) (p : Fin (n + 3)) : Bool :=
  hlSign σ (hlLabel σ p)

def hlSignNat {n : ℕ} (σ : Fin (n - 1) → Bool) (k : ℕ) : Bool :=
  if h : k < n + 3 then hlSign σ ⟨k, h⟩ else false

/-- The preceding vertex of the opposite chain in Proposition 4.7. -/
def hlI {n : ℕ} (σ : Fin (n - 1) → Bool) (j : ℕ) : ℕ :=
  (((List.range j).filter (fun r => hlSignNat σ r ≠ hlSignNat σ j)).reverse).headD 0

/-- The following vertex of the opposite chain in Proposition 4.7. -/
def hlK {n : ℕ} (σ : Fin (n - 1) → Bool) (j : ℕ) : ℕ :=
  ((List.range (n + 3)).filter
    (fun r => j + 1 < r ∧ hlSignNat σ r ≠ hlSignNat σ (j + 1))).headD 0

/-- The two chains have opposite signs at every diagonal of `T` and its flips. -/
def OppositeSignB {n : ℕ} (σ : Fin (n - 1) → Bool)
    (T : Finset (Sym2 (Fin (n + 3)))) : Prop :=
  ∀ e ∈ T ∪ flipSet (n + 3) T,
    ∀ a b : Fin (n + 3), e = s(a, b) → hlSignPos σ a ≠ hlSignPos σ b

end AssocRealizations.TypesMeet


