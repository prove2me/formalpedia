section PointCongr
variable {F : Type u} [Field F] [DecidableEq F]

def pointCongr {W₁ W₂ : WeierstrassCurve F} (h : W₁ = W₂) : W₁.toAffine.Point ≃+ W₂.toAffine.Point := by
  subst h
  exact AddEquiv.refl _

@[scoped simp] theorem pointCongr_rfl {W : WeierstrassCurve F} (P : W.toAffine.Point) : pointCongr rfl P = P := rfl

@[scoped simp] theorem pointCongr_zero {W₁ W₂ : WeierstrassCurve F} (h : W₁ = W₂) :
    pointCongr h (0 : W₁.toAffine.Point) = 0 := by
  subst h; rfl

theorem pointCongr_some {W₁ W₂ : WeierstrassCurve F} (h : W₁ = W₂) {x y : F} (hxy : W₁.toAffine.Nonsingular x y) :
    pointCongr h (Affine.Point.some x y hxy) = Affine.Point.some x y (h ▸ hxy) := by
  subst h; rfl

theorem pointCongr_some' {W₁ W₂ : WeierstrassCurve F} (h : W₁ = W₂) {x y : F} (hxy : W₁.toAffine.Nonsingular x y)
    (hxy' : W₂.toAffine.Nonsingular x y) :
    pointCongr h (Affine.Point.some x y hxy) = Affine.Point.some x y hxy' := by
  subst h; rfl

@[scoped simp] theorem addOrderOf_pointCongr {W₁ W₂ : WeierstrassCurve F} (h : W₁ = W₂) (P : W₁.toAffine.Point) :
    addOrderOf (pointCongr h P) = addOrderOf P := by
  subst h; rfl

theorem pointCongr_nsmul {W₁ W₂ : WeierstrassCurve F} (h : W₁ = W₂) (n : ℕ) (P : W₁.toAffine.Point) :
    pointCongr h (n • P) = n • pointCongr h P :=
  map_nsmul _ n P

theorem mapPoint_pointCongr {k : Type v} [Field k] [DecidableEq k] (σ : F →+* k) {W₁ W₂ : WeierstrassCurve F}
    (h : W₁ = W₂) (P : W₁.toAffine.Point) :
    mapPoint σ (pointCongr h P) = pointCongr (congrArg (fun W : WeierstrassCurve F => W.map σ) h) (mapPoint σ P) := by
  subst h; rfl

end PointCongr

section Descend

theorem exists_finite_subfield_point
    (κ Ω Λ : Type u) [Field κ] [Field Ω] [Field Λ] [DecidableEq Ω] [DecidableEq Λ]
    [Algebra κ Ω] [Algebra Ω Λ] [Algebra κ Λ] [IsScalarTower κ Ω Λ] [Algebra.IsAlgebraic Ω Λ]
    (E : WeierstrassCurve Ω) (M' : ℕ) [NeZero M'] (ι : Type v) (tuple : ι → Polynomial Ω) (pe : ι → ℕ)
    (gΛ : (E.map (algebraMap Ω Λ)).toAffine.Point)
    (hgΛ : addOrderOf gΛ = M' ∧ ∀ (i : ι) (n : ℕ) (x₁ y₁ : Λ) (h₁ : (E.map (algebraMap Ω Λ)).toAffine.Nonsingular x₁ y₁),
        n • gΛ = Affine.Point.some x₁ y₁ h₁ → addOrderOf (n • gΛ) = pe i → ((tuple i).map (algebraMap Ω Λ)).IsRoot x₁) :
    ∃ (Ω₁ : Type u) (_ : Field Ω₁) (_ : DecidableEq Ω₁) (_ : Algebra κ Ω₁) (_ : Algebra Ω Ω₁) (_ : IsScalarTower κ Ω Ω₁)
      (_ : Module.Finite Ω Ω₁)
      (g₁ : (E.map (algebraMap Ω Ω₁)).toAffine.Point),
      addOrderOf g₁ = M' ∧ ∀ (i : ι) (n : ℕ) (x₁ y₁ : Ω₁) (h₁ : (E.map (algebraMap Ω Ω₁)).toAffine.Nonsingular x₁ y₁),
        n • g₁ = Affine.Point.some x₁ y₁ h₁ → addOrderOf (n • g₁) = pe i → ((tuple i).map (algebraMap Ω Ω₁)).IsRoot x₁ := by
  classical

  obtain ⟨S, hSfin, hS⟩ : ∃ S : Set Λ, S.Finite ∧ ∀ (x y : Λ) (h : (E.map (algebraMap Ω Λ)).toAffine.Nonsingular x y),
      gΛ = Affine.Point.some x y h → x ∈ S ∧ y ∈ S := by
    rcases gΛ with _ | ⟨x, y, h⟩
    · exact ⟨∅, Set.finite_empty, fun _ _ _ h => absurd h (by rintro ⟨⟩)⟩
    · refine ⟨{x, y}, (Set.finite_singleton y).insert x, fun x' y' h' e => ?_⟩
      rw [Affine.Point.some.injEq] at e
      obtain ⟨rfl, rfl⟩ := e
      simp
  haveI : Finite S := hSfin.to_subtype
  let K₁ : IntermediateField Ω Λ := IntermediateField.adjoin Ω S
  haveI : Module.Finite Ω K₁ :=
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)

  have hE : (E.map (algebraMap Ω K₁)).map (algebraMap K₁ Λ) = E.map (algebraMap Ω Λ) := by
    rw [WeierstrassCurve.map_map, ← IsScalarTower.algebraMap_eq]
  have hinj : Function.Injective (algebraMap K₁ Λ) := (algebraMap K₁ Λ).injective

  obtain ⟨g₁, hg₁⟩ : ∃ g₁ : (E.map (algebraMap Ω K₁)).toAffine.Point,
      pointCongr hE (mapPoint (algebraMap K₁ Λ) g₁) = gΛ := by
    rcases hg : gΛ with _ | ⟨x, y, h⟩
    · exact ⟨0, by rw [mapPoint_zero, pointCongr_zero]; rfl⟩
    · obtain ⟨hx, hy⟩ := hS x y h hg
      have hx' : x ∈ K₁ := IntermediateField.subset_adjoin Ω S hx
      have hy' : y ∈ K₁ := IntermediateField.subset_adjoin Ω S hy
      have h' : (E.map (algebraMap Ω K₁)).toAffine.Nonsingular ⟨x, hx'⟩ ⟨y, hy'⟩ := by
        rw [← (E.map (algebraMap Ω K₁)).toAffine.map_nonsingular hinj]
        show ((E.map (algebraMap Ω ↥K₁)).map (algebraMap ↥K₁ Λ)).toAffine.Nonsingular x y
        rw [hE]; exact h
      exact ⟨.some ⟨x, hx'⟩ ⟨y, hy'⟩ h', by rw [mapPoint_some]; exact pointCongr_some' hE _ h⟩
  refine ⟨K₁, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance, g₁, ?_, ?_⟩
  · rw [← hgΛ.1, ← hg₁, addOrderOf_pointCongr, addOrderOf_mapPoint]
  · intro i n x₁ y₁ h₁ hn hord
    have h₁' : (E.map (algebraMap Ω Λ)).toAffine.Nonsingular (algebraMap K₁ Λ x₁) (algebraMap K₁ Λ y₁) := by
      rw [← hE]; exact ((E.map (algebraMap Ω K₁)).toAffine.map_nonsingular hinj x₁ y₁).mpr h₁
    have hmap : n • gΛ = Affine.Point.some (algebraMap K₁ Λ x₁) (algebraMap K₁ Λ y₁) h₁' := by
      rw [← hg₁, ← pointCongr_nsmul, ← mapPoint_nsmul, hn, mapPoint_some, pointCongr_some' hE]
    have hord' : addOrderOf (n • gΛ) = pe i := by
      rw [← hg₁, ← pointCongr_nsmul, ← mapPoint_nsmul, addOrderOf_pointCongr, addOrderOf_mapPoint, hord]
    have hroot := hgΛ.2 i n _ _ h₁' hmap hord'
    rw [IsScalarTower.algebraMap_eq Ω K₁ Λ, ← Polynomial.map_map] at hroot
    exact hroot.of_map hinj

end Descend

