  have hY : 6 ^ 12 * (Q.T : ℝ) ≤ 6 ^ 12 * ((Q.T : ℝ) * Q.p * Lg ^ 2) := by
    have : (Q.T : ℝ) ≤ (Q.T : ℝ) * Q.p * Lg ^ 2 := by
