theorem not_mem_zmultiples_add {P : W.toAffine.Point}
    (hPmem : P ∉ AddSubgroup.zmultiples Q) {K : W.toAffine.Point}
    (hK : K ∈ AddSubgroup.zmultiples Q) : P + K ∉ AddSubgroup.zmultiples Q := fun hmem =>
