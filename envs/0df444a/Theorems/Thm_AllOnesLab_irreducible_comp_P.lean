-- title:
--   All Ones Lab: irreducible comp P
-- statement:
--   **Core of the hard direction.**  Suppose `K` is a finite extension of `𝔽₂` generated by
--   `α`, that `Tr(α + 1) = 1`, and that `f : 𝔽₂[X]` kills `α`.  If `f.comp P` is monic of degree
--   `2 · [K : 𝔽₂]`, then `f.comp P` is irreducible.
--
--   Source: https://github.com/BrandonMYates/allones-comparator/blob/76f3a65407c45de21228824f7a41430acec473a4/AllOnesLab/Hard.lean#L76-L169
-- source:
--   https://github.com/BrandonMYates/allones-comparator/blob/76f3a65407c45de21228824f7a41430acec473a4/AllOnesLab/Hard.lean#L76-L169

import Definitions.Def_AllOnesLab_Trace
import Definitions.Def_AllOnesLab_Hard
set_option autoImplicit true
open Polynomial
open AllOnesLab
variable {K : Type*} [Field K] [Algebra (ZMod 2) K] [FiniteDimensional (ZMod 2) K]

theorem AllOnesLab.irreducible_comp_P (α : K)
    (hgenK : Algebra.adjoin (ZMod 2) ({α} : Set K) = ⊤)
    (htr : Algebra.trace (ZMod 2) K (α + 1) = 1)
    (f : (ZMod 2)[X]) (hfa : aeval α f = 0)
    (hmon : (f.comp P).Monic)
    (hdeg : (f.comp P).natDegree = 2 * Module.finrank (ZMod 2) K) :
    Irreducible (f.comp P) := by sorry
