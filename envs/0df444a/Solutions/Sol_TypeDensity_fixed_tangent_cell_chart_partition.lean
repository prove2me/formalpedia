theorem solution (O R : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [CommRing R] [IsDomain R] [Algebra O R] [IsRegularLocalRing R]
    (S : TypeDensity.SurfaceData O R) (st : TypeDensity.State) (n : ℕ) (b : Fin n → R) (f : R)
    (hf : Ideal.span {f} ∈ TypeDensity.surfaceStateSet O R S st)
    (hinj : Function.Injective (TypeDensity.coordinateIdeal S.pi f b)) (d M : ℕ) (hM : d ≤ M)
    (D : TypeDensity.ExceptionalDivisor (IsLocalRing.ResidueField R)) (reps : Finset (Fin n → O))
    (hreps : ∀ z : Fin n → O, ∃! z₀, z₀ ∈ reps ∧ TypeDensity.adicCongr (Ideal.span {S.pi}) M z z₀) :
    TypeDensity.fixedTangentCell O R S st d D ∩ Set.range (TypeDensity.coordinateIdeal S.pi f b) = ⋃ z₀ ∈ reps.filter
      (fun z₀ => TypeDensity.HasTangentDivisor O R S (TypeDensity.coordinateIdeal S.pi f b z₀) d D), TypeDensity.coordinateIdeal S.pi f
      b '' TypeDensity.coordinateCoset S.pi M z₀ ∧ (reps : Set (Fin n → O)).PairwiseDisjoint
      (fun z₀ => TypeDensity.coordinateIdeal S.pi f b '' TypeDensity.coordinateCoset S.pi M z₀) := by
  have hsymm : ∀ z z' : Fin n → O, TypeDensity.adicCongr (Ideal.span {S.pi}) M z z' →
      TypeDensity.adicCongr (Ideal.span {S.pi}) M z' z := by
    intro z z' h
    unfold TypeDensity.adicCongr at *
    rw [← neg_sub]; exact Submodule.neg_mem _ h
  have hstate : ∀ z, TypeDensity.coordinateIdeal S.pi f b z ∈ TypeDensity.surfaceStateSet O R S st := by
    intro z
    unfold TypeDensity.coordinateIdeal TypeDensity.normalizedIdeal TypeDensity.normalizedGenerator
    rw [TypeDensity.coordinateLift_smul_eq_mul]
    exact TypeDensity.surface_state_vertical_perturbation O R S st f _ hf
  refine ⟨?_, ?_⟩
  · ext J
    simp only [Set.mem_inter_iff, Set.mem_range, Set.mem_iUnion, Finset.mem_filter,
      exists_prop, Set.mem_image]
    constructor
    · rintro ⟨⟨_, htd⟩, z, rfl⟩
      obtain ⟨z₀, ⟨hz₀, hc⟩, _⟩ := hreps z
      exact ⟨z₀, ⟨hz₀, TypeDensity.hasTangentDivisor_of_adicCongr O R S n b f d M hM D z₀ z (hsymm _ _ hc) htd⟩,
          z, hc, rfl⟩
    · rintro ⟨z₀, ⟨_, htd⟩, z, hz, rfl⟩
      exact ⟨⟨hstate z, TypeDensity.hasTangentDivisor_of_adicCongr O R S n b f d M hM D z z₀ hz htd⟩, z, rfl⟩
  · intro a ha a' ha' hne
    simp only [Function.onFun]
    rw [Set.disjoint_image_iff hinj]
    refine Set.disjoint_left.mpr fun z hz hz' => hne ?_
    obtain ⟨w, _, huniq⟩ := hreps z
    rw [huniq a ⟨ha, hz⟩, huniq a' ⟨ha', hz'⟩]
