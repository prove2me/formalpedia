-- name    : AdaptiveProtection.Convergence.theorem1_convergence
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-06T23:05:59.692638+00:00
-- url     : https://prove2.me/theorems/278bb47e-9528-4559-a37a-439c3d9af131
-- title:
--   Theorem 1, p. 765 — under A1, A2 (windowed) and A3, θ^n_i → θ*_i a.s., p_i(θ*) = θ*_i, and E|θ^n_i − θ*_i|² ≤ Cγ_n^{β/2^{i−1}}
-- statement:
--   Consider a single flight leg with $k + 1$ fare classes, fares $f_1 > f_2 > \cdots > f_{k+1} > 0$ and discount ratios $r_{i+1} = f_{i+1}/f_1$. The class demands $X_1, \dots, X_{k+1}$ of a flight are independent, nonnegative, and have continuous distributions; successive flights are independent and identically distributed. Let $\theta^*$ satisfy the optimality condition (3), $P(A_i(\theta^*, X)) = r_{i+1}$ for $i = 1, \dots, k$, where $A_i$ is the fill event (2). Let $\theta^n$ be generated by the recursion (4),
--   $$\theta^{n+1} = \theta^n - \gamma_n H(\theta^n, X^n), \qquad H_i(\theta, X) = r_{i+1} - \mathbf 1(A_i(\theta, X)),$$
--   from an arbitrary initial vector $\theta^1$, with step sizes $\gamma_n = A/(n + B)$, $A > 0$, $B \ge 0$. Assume
--
--   1. **A1** each $X_i$ has bounded support: $P(X_i < C) = 1$ for some constant $C$;
--   2. **A2** (windowed) for every $R > 0$ there is $\delta_R > 0$ such that, for $i = 1, \dots, k$ and every $\theta_i$ with $|\theta_i - \theta^*_i| \le R$,
--   $$(\theta_i - \theta^*_i)\, h_i(\theta_i, \theta^*_{i-1}, \dots, \theta^*_1) \ge \delta_R |\theta_i - \theta^*_i|^2,$$
--   where $h_i(\theta) = r_{i+1} - P(A_i(\theta, X))$;
--   3. **A3** the distributions of the partial sums are Lipschitz: for some $L$, all $i = 1, \dots, k$ and all $x, y$, $|P(X_1 + \cdots + X_i < x) - P(X_1 + \cdots + X_i < y)| \le L|x - y|$.
--
--   Then for $i = 1, \dots, k$,
--   $$\theta^n_i \to \theta^*_i \ \text{(a.s.)} \tag{8}$$
--   $$p_i(\theta^*) = \theta^*_i, \tag{9}$$
--   where $p_i(\theta) = \max\{\theta_j : 1 \le j \le i\}$; and there are $\beta > 0$ and $C$ such that for $i = 1, \dots, k$ and all $n \ge 1$, $|\theta^n_i - \theta^*_i|^2$ is integrable and
--   $$E|\theta^n_i - \theta^*_i|^2 \le C\gamma_n^{\beta/2^{i-1}}. \tag{10}$$
--
--   The theorem says that updating the protection levels from fill events alone, with no demand forecast and no optimization, recovers the optimal nested protection levels, which are moreover ordered.
--
--   **Formalization Note** As printed, A2 asks for one $\delta$ valid for all $\theta_i$; since $|h_i| \le 1$ this cannot hold for $|\theta_i - \theta^*_i| > 1/\delta$, so no instance satisfies it and the printed theorem is vacuous. A2 is pinned to bounded windows with a $\delta$ per window, which is what the proof uses (the iterates stay bounded by Lemma 3) and what the paper's sufficient condition (a density bounded below near $\theta^*$) gives. Continuity of the demand laws is stated as "every singleton is null". Lean's `iterate … n` is the paper's $\theta^{n+1}$, so (10) pairs it with `stepSize A B (n + 1)`, i.e. $\gamma_{n+1}$. Integrability is part of the conclusion, so the bound cannot hold through Lean's convention that a non-integrable function has integral $0$.
-- source:
--   van Ryzin & McGill, Management Science 46(6), 2000, p. 765, Theorem 1; proof pp. 765–766

import Mathlib
import Definitions.Def_NestedSeatAlloc_ProbCond_Model
import Definitions.Def_AdaptiveProtection_Convergence_Setting

open MeasureTheory Filter Topology

namespace AdaptiveProtection.Convergence

/-- Theorem 1 (van Ryzin–McGill 2000, p. 765), with Assumption A2 pinned to bounded windows
(as printed, A2 is unsatisfiable). Lean's `iterate … n` is the paper's `θ^{n+1}`, so the rate (10)
pairs it with `stepSize A B (n + 1) = γ_{n+1}`. -/
theorem theorem1_convergence
    (k : ℕ) (f : ℕ → ℝ) (hf : ∀ i, 1 ≤ i → i ≤ k → f (i + 1) < f i) (hfpos : 0 < f (k + 1))
    (ν : ℕ → Measure ℝ) [∀ i, IsProbabilityMeasure (ν i)]
    (hnonneg : ∀ i, 1 ≤ i → i ≤ k + 1 → ∀ᵐ t ∂(ν i), 0 ≤ t)
    (hcont : ∀ i, 1 ≤ i → i ≤ k + 1 → NullSingletonClass (ν i))
    (A B : ℝ) (hA : 0 < A) (hB : 0 ≤ B)
    (θ₁ θstar : ℕ → ℝ)
    (hopt : ∀ i, 1 ≤ i → i ≤ k → (flightLaw ν).real (fillEvent θstar i) = ratio f (i + 1))
    (hA1 : ∃ Cb : ℝ, ∀ i, 1 ≤ i → i ≤ k + 1 → ∀ᵐ t ∂(ν i), t < Cb)
    (hA2 : ∀ R > 0, ∃ δ > 0, ∀ i, 1 ≤ i → i ≤ k → ∀ t : ℝ, |t - θstar i| ≤ R →
      δ * (t - θstar i) ^ 2 ≤ (t - θstar i) * meanAdj f ν (Function.update θstar i t) i)
    (hA3 : ∃ L : ℝ, ∀ i, 1 ≤ i → i ≤ k → ∀ x y : ℝ,
      |(flightLaw ν).real {z | partialSum z i < x} - (flightLaw ν).real {z | partialSum z i < y}|
        ≤ L * |x - y|) :
    (∀ i, 1 ≤ i → i ≤ k → ∀ᵐ ω ∂(pathLaw ν),
        Tendsto (fun n => iterate f k (stepSize A B) θ₁ ω n i) atTop (𝓝 (θstar i))) ∧
    (∀ i, 1 ≤ i → i ≤ k → interim θstar i = θstar i) ∧
    (∃ β > 0, ∃ C : ℝ, ∀ i, 1 ≤ i → i ≤ k → ∀ n : ℕ,
        Integrable (fun ω => (iterate f k (stepSize A B) θ₁ ω n i - θstar i) ^ 2) (pathLaw ν) ∧
        ∫ ω, (iterate f k (stepSize A B) θ₁ ω n i - θstar i) ^ 2 ∂(pathLaw ν)
          ≤ C * stepSize A B (n + 1) ^ (β / 2 ^ (i - 1))) := by sorry

end AdaptiveProtection.Convergence
