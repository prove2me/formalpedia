theorem AlgebraicCurve.isCurveOver_and_essFiniteType_intermediateField_of_transcendental_mem
    (K F : Type) [Field K] [Field F] [Algebra K F] [IsAlgClosed K]
    (E : IntermediateField K F) (t : F) (htE : t ∈ E) (ht : Transcendental K t)
    (hfg : ∃ x : F, Transcendental K x ∧ FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F) :
    AlgebraicCurve.IsCurveOver K E ∧ Algebra.EssFiniteType K E ∧
      (∃ x : E, Transcendental K x ∧ FiniteDimensional (IntermediateField.adjoin K ({x} : Set E)) E) := by sorry
