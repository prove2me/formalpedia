private theorem coef_periodic {p : ℝ} (hper : Function.Periodic ρ p) (i : Fin n) :
    Function.Periodic (coef K φ ρ hρK b i) p := by
  intro θ
  have hk : ρK K ρ hρK (θ + p) = ρK K ρ hρK θ := Subtype.ext (hper θ)
  simp only [coef, hk]

private theorem norm_le_of_periodic {E : Type*} [SeminormedAddCommGroup E] {f : ℝ → E} {p : ℝ} (hp : 0 < p)
    (hper : Function.Periodic f p) (hf : Continuous f) : ∃ C, ∀ θ, ‖f θ‖ ≤ C := by
  obtain ⟨C, hC⟩ := (isCompact_Icc : IsCompact (Set.Icc (0 : ℝ) p)).exists_bound_of_continuousOn hf.continuousOn
  refine ⟨C, fun θ => ?_⟩
  obtain ⟨y, hy, hfy⟩ := hper.exists_mem_Ico₀ hp θ
  rw [hfy]
  exact hC y (Set.Ico_subset_Icc_self hy)

private theorem iteratedDeriv_periodic {f : ℝ → ℂ} {p : ℝ} (hper : Function.Periodic f p) (j : ℕ) :
    Function.Periodic (iteratedDeriv j f) p := by
  intro θ
  have hf : (fun z => f (z + p)) = f := funext hper
  have h := iteratedDeriv_comp_add_const j f p
  rw [hf] at h
  exact (congrFun h θ).symm

private theorem norm_iteratedDeriv_coef_le [FiniteDimensional ℂ (V K φ)] (hφ : Continuous φ) (hρ0 : ρ 0 = 1)
    (hρadd : ∀ s t, ρ (s + t) = ρ s * ρ t) (hρc : Continuous ρ) {p : ℝ} (hp : 0 < p)
    (hper : Function.Periodic ρ p) (i : Fin n) (j : ℕ) :
    ∃ C, ∀ θ, ‖iteratedDeriv j (coef K φ ρ hρK b i) θ‖ ≤ C :=
  norm_le_of_periodic hp (iteratedDeriv_periodic (coef_periodic K φ ρ hρK b hper i) j)
    ((contDiff_coef K φ ρ hρK b hφ hρ0 hρadd hρc i).continuous_iteratedDeriv j (by exact_mod_cast le_top))

end Continuity
