theorem getD_of_map_eq {R : Type*} [Zero R] {L1 L2 : List ℤ} {f g : ℤ → R} (hf : f 0 = 0)
    (hg : g 0 = 0) (h : L1.map f = L2.map g) (m : ℕ) : f (L1.getD m 0) = g (L2.getD m 0) := by
  calc f (L1.getD m 0) = (L1.map f).getD m (f 0) := (List.getD_map ..).symm
    _ = (L2.map g).getD m (g 0) := by rw [hf, h, hg]
    _ = g (L2.getD m 0) := List.getD_map ..

