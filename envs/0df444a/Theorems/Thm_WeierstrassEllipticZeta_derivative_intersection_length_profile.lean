-- title:
--   Explicit lengths and stopping criterion for derivative intersections
-- statement:
--   Let $g_2,g_3\in\mathbb C$, let $A=\mathbb C[t,x_1,x_2,x_3]$, and choose either of the elliptic-extension chart derivations
--
--   $$D_0=\partial_t+x_2\partial_{x_1}+(6x_1^2-g_2/2)\partial_{x_2}-x_1\partial_{x_3},$$
--
--   $$D_1=\partial_t+(-6x_2^2+(g_2/2)x_1^2)\partial_{x_1}+(-1/2-g_2x_1x_2-(3g_3/2)x_1^2)\partial_{x_2}+(-2g_2x_2^2-3g_3x_1x_2)\partial_{x_3}.$$
--
--   Write $D=D_c$. For each $v\in\mathbb C^4$ and $n\in\mathbb N$, let $C(v,n)$ be the chart contact ideal generated by polynomials whose first $n$ $D$-jets vanish at $v$. Assume its exact membership property, for all $v,n,p$:
--
--   $$p\in C(v,n)\quad\Longleftrightarrow\quad D^jp(v)=0\quad(0\le j<n).$$
--
--   Let $V\subseteq\mathbb C^4$ be finite with distinct first coordinates $t_v=v_0$, and choose nonnegative integers $n_v$. Put
--
--   $$I=\bigcap_{v\in V}C(v,n_v),\qquad M(T)=\prod_{v\in V}(T-t_v)^{n_v}.$$
--
--   Fix three polynomials $r_1,r_2,r_3\in\mathbb C[T]$ and assume the time-substitution presentation
--
--   $$\Phi(p)=p(T,r_1(T),r_2(T),r_3(T)),\qquad p\in I\ \Longleftrightarrow\ M\mid\Phi(p)\quad(p\in A).$$
--
--   Fix $p\in A$ and a natural number $B$. Suppose every point of $V$ has a nonzero jet below this cutoff:
--
--   $$\forall v\in V\ \exists j<B:\quad D^jp(v)\ne0.$$
--
--   Then there are natural numbers $t_v<B$ such that
--
--   $$D^{t_v}p(v)\ne0,\qquad D^jp(v)=0\quad(0\le j<t_v).$$
--
--   For every integer $s>0$, put
--
--   $$J_s=I+(p,Dp,\ldots,D^{s-1}p).$$
--
--   The quotient $A/J_s$ is finite-dimensional over $\mathbb C$, and its exact dimension is
--
--   $$\dim_{\mathbb C}(A/J_s)=\sum_{v\in V}\min\{n_v,\max(t_v+1-s,0)\}.$$
--
--   Its zero-quotient criterion is
--
--   $$J_s=A\quad\Longleftrightarrow\quad\forall v\in V:\ n_v=0\ \text{or}\ t_v<s.$$
--
--   In particular, $J_s=A$ whenever $B\le s$.
--
--   **Formalization Note** The same first nonzero orders $t_v$ work for every positive $s$. All contact and time-substitution hypotheses above are retained explicitly. Natural-number subtraction in Lean means $\max(t_v+1-s,0)$. Zero contact orders and empty $V$ are included. If $V$ is nonempty, the nonzero-jet hypothesis excludes the zero polynomial and forces $B>0$; for empty $V$, $B=0$ is allowed. The displayed profile concerns $s>0$; the no-equation case is $J_0=I$ with the previously proved contact length. The upper cutoff is supplied, not estimated here. The theorem is a local exact length calculation and does not bound the cutoff in terms of degree or prove the global algebraic-group obstruction.
-- source:
--   Derived finite-contact result for the approach associated with Senthil Kumar K (2026), Appendix A, https://doi.org/10.1017/S001309152610145X. Uses the proved finite_contact_jet_intersection_length under its explicit hypotheses. The first nonzero local jet orders give an exact truncated-linear length formula for all derivative prefixes and the exact zero-quotient criterion. This is not quoted as Theorem A.2. Primary formal references: Nat.find_spec, Nat.find_min, Function.iterate_add_apply, Module.finrank_zero_iff, Ideal.Quotient.subsingleton_iff and Finset.sum_eq_zero_iff.

import Definitions.Def_WeierstrassEllipticZeta_ProjectiveContactIdeal
import Mathlib.Algebra.Polynomial.Derivation
import Mathlib.Algebra.Polynomial.Taylor
import Mathlib.Algebra.Polynomial.Splits
import Mathlib.RingTheory.Polynomial.Content
import Mathlib.Tactic.FinCases
import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.PrincipalIdealDomain
import Mathlib.RingTheory.Ideal.Quotient.Operations

open WeierstrassEllipticZeta
open scoped Classical

theorem WeierstrassEllipticZeta.derivative_intersection_length_profile
    (g₂ g₃ : ℂ) (c : Fin 2)
    (hcontact : ∀ (v : Fin 4 → ℂ) (n : ℕ) (p : MvPolynomial (Fin 4) ℂ),
      p ∈ extensionChartContactIdeal g₂ g₃ c v n ↔
        ∀ k < n, MvPolynomial.eval v ((extensionChartDerivation g₂ g₃ c)^[k] p) = 0)
    (V : Finset (Fin 4 → ℂ))
    (hV : Function.Injective (fun v : V => v.val 0)) (n : V → ℕ)
    (r : Fin 3 → Polynomial ℂ)
    (hmem : ∀ p : MvPolynomial (Fin 4) ℂ,
      p ∈ (⨅ v : V, extensionChartContactIdeal g₂ g₃ c v.val (n v)) ↔
        (∏ v : V, (Polynomial.X - Polynomial.C (v.val 0)) ^ n v) ∣
          MvPolynomial.aeval (Fin.cons Polynomial.X r) p)
    (p : MvPolynomial (Fin 4) ℂ) (B : ℕ)
    (hB : ∀ v : V, ∃ j < B,
      MvPolynomial.eval v.val ((extensionChartDerivation g₂ g₃ c)^[j] p) ≠ 0) :
    ∃ t : V → ℕ,
      (∀ v : V, t v < B ∧
        MvPolynomial.eval v.val ((extensionChartDerivation g₂ g₃ c)^[t v] p) ≠ 0 ∧
        ∀ j < t v, MvPolynomial.eval v.val ((extensionChartDerivation g₂ g₃ c)^[j] p) = 0) ∧
      ∀ s : ℕ, 0 < s →
        let I := ⨅ v : V, extensionChartContactIdeal g₂ g₃ c v.val (n v)
        let J := I ⊔ Ideal.span (Set.range (fun i : Fin s =>
          (extensionChartDerivation g₂ g₃ c)^[i.val] p))
        FiniteDimensional ℂ (MvPolynomial (Fin 4) ℂ ⧸ J) ∧
        Module.finrank ℂ (MvPolynomial (Fin 4) ℂ ⧸ J) =
          ∑ v : V, min (n v) (t v + 1 - s) ∧
        (J = ⊤ ↔ ∀ v : V, n v = 0 ∨ t v < s) ∧
        (B ≤ s → J = ⊤) := by sorry
