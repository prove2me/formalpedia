theorem IntMul.Kappa.R6.sp_sum (s : IState HS) (f : Fin HS → List ℤ) (Cy Rc Rg Rm : Fin HS) (c g A Bb : ℕ)
    (lc lg lm : List ℤ) (hC5 : Cy.val < 56) (hc5 : Rc.val < 56) (hg5 : Rg.val < 56)
    (hm5 : Rm.val < 56) (h1 : Cy ≠ Rc) (h2 : Cy ≠ Rg) (h3 : Cy ≠ Rm) (h4 : Rc ≠ Rg)
    (h5 : Rc ≠ Rm) (h6 : Rg ≠ Rm) (hfC : f Cy = []) (hfc : f Rc = (c : ℤ) :: lc)
    (hfg : f Rg = (g : ℤ) :: lg) (hfm : f Rm = 0 :: lm) (hc : 2 ≤ c) (hg : g < c)
    (hA : 2 ≤ A) (hcA : c * c ≤ A) (hB : A ^ 6 < 2 ^ Bb) :
    Sp (sumR Cy Rc Rg Rm) (encK s f)
      (encK s (update f Rm ((∑ y ∈ Icc 1 c, sumT c g y) :: lm))) ((c * 22 + 1) * kU Bb) := by sorry
