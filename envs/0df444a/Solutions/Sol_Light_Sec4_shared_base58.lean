       (refine Light.Ends.setToThen (d4 + (bs.take (l + 1)).count true : ℕ) ?_ ?_ ?_)
       (on_goal -1 =>
           first
           | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                   List.map_nil, List.sum_cons, List.sum_nil, htrue])
