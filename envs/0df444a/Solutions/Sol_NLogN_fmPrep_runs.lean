theorem IOp.run_step {I : List Sym} {o : IOp S} {s s' : IState S} {c : ℕ}
    (h : o.run s = some (s', c)) : o.Step I s s' c := by
  cases o with
  | add i j k =>
    simp only [IOp.run] at h
    split at h
    · rename_i a Li b Lj hi hj
      split_ifs at h with hij
      simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h; exact .add hij hi hj
    · simp at h
  | neg i =>
    simp only [IOp.run] at h; split at h <;> simp at h
    rename_i a L hi; obtain ⟨rfl, rfl⟩ := h; exact .neg hi
  | dup i j =>
    simp only [IOp.run] at h; split at h <;> simp at h
    rename_i a L hi; obtain ⟨hij, rfl, rfl⟩ := h; exact .dup hij hi
  | drop i =>
    simp only [IOp.run] at h; split at h <;> simp at h
    rename_i a L hi; obtain ⟨rfl, rfl⟩ := h; exact .drop hi
  | mv i j =>
    simp only [IOp.run] at h; split at h <;> simp at h
    rename_i a L hi; obtain ⟨hij, rfl, rfl⟩ := h; exact .mv hij hi
  | const i c => simp only [IOp.run, Option.some.injEq, Prod.mk.injEq] at h
                 obtain ⟨rfl, rfl⟩ := h; exact .const c
  | mark i => simp only [IOp.run, Option.some.injEq, Prod.mk.injEq] at h
              obtain ⟨rfl, rfl⟩ := h; exact .mark
  | unmark i =>
    simp only [IOp.run] at h; split at h <;> simp at h
    rename_i L hi; obtain ⟨rfl, rfl⟩ := h; exact .unmark hi
  | shl i j =>
    simp only [IOp.run] at h; split at h
    · rename_i a Li r Lj hi hj
      split at h
      · rename_i m hm
        simp at h; obtain ⟨hij, rfl, rfl⟩ := h
        exact .shl hij hi (by rw [hj, rulerExp_eq hm])
      · simp at h
    · simp at h
  | split i j k =>
    simp only [IOp.run] at h; split at h
    · rename_i a Li r Lj hi hj
      split at h
      · rename_i m hm
        simp at h; obtain ⟨⟨h1, h2, h3⟩, rfl, rfl⟩ := h
        exact .split h1 h2 h3 hi (by rw [hj, rulerExp_eq hm])
      · simp at h
    · simp at h
  | cat i j k =>
    simp only [IOp.run] at h; split at h
    · rename_i a Li r Lj b Lk hi hj hk
      split at h
      · rename_i m hm
        simp at h; obtain ⟨⟨h1, h2, h3, h4, h5, h6⟩, rfl, rfl⟩ := h
        have hb : b = ((b.toNat : ℕ) : ℤ) := by omega
        have e2 : ((2 ^ m : ℕ) : ℤ) = (2 : ℤ) ^ m := by push_cast; rfl
        refine .cat (b := b.toNat) h1 h2 h3 h4 (by omega) hi (by rw [hj, rulerExp_eq hm])
          (by rw [hk, ← hb])
      · simp at h
    · simp at h
  | read => simp [IOp.run] at h
  | write => simp [IOp.run] at h

theorem IStmt.run_exec {I : List Sym} {iprog : Fin P → IStmt S P} :
    ∀ (n : ℕ) (p : IStmt S P) (s s' : IState S) (c : ℕ), IStmt.run iprog n p s = some (s', c) →
      IExec I iprog p s s' c := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ihn =>
  intro p
  induction p with
  | skip => intro s s' c h; simp [IStmt.run] at h; obtain ⟨rfl, rfl⟩ := h; exact .skip s
  | op o => intro s s' c h; simp only [IStmt.run] at h; exact .op (IOp.run_step h)
  | seq p q ihp ihq =>
    intro s s' c h
    simp only [IStmt.run] at h
    split at h <;> try simp at h
    rename_i s₁ c₁ h₁
    split at h <;> try simp at h
    rename_i s₂ c₂ h₂
    obtain ⟨rfl, rfl⟩ := h
    exact .seq (ihp _ _ _ h₁) (ihq _ _ _ h₂)
  | ite i f p q ihp ihq =>
    intro s s' c h
    simp only [IStmt.run] at h
    split_ifs at h with hf
    · obtain ⟨⟨s₁, c₁⟩, h₁, he⟩ := Option.map_eq_some_iff.mp h
      simp only [Prod.mk.injEq] at he; obtain ⟨rfl, rfl⟩ := he
      exact .iteT hf (ihp _ _ _ h₁)
    · obtain ⟨⟨s₁, c₁⟩, h₁, he⟩ := Option.map_eq_some_iff.mp h
      simp only [Prod.mk.injEq] at he; obtain ⟨rfl, rfl⟩ := he
      exact .iteF (by simpa using hf) (ihq _ _ _ h₁)
  | loop i f p ihp =>
    intro s s' c h
    rcases n with _ | n
    · simp [IStmt.run] at h
    simp only [IStmt.run] at h
    split_ifs at h with hf
    · split at h <;> try simp at h
      rename_i s₁ c₁ h₁
      split at h <;> try simp at h
      rename_i s₂ c₂ h₂
      obtain ⟨rfl, rfl⟩ := h
      exact .loopT hf (ihp _ _ _ h₁) (ihn n (by omega) _ _ _ _ h₂)
    · simp at h; obtain ⟨rfl, rfl⟩ := h; exact .loopF (by simpa using hf)
  | call j =>
    intro s s' c h
    rcases n with _ | n
    · simp [IStmt.run] at h
    simp only [IStmt.run] at h
    obtain ⟨⟨s₁, c₁⟩, h₁, he⟩ := Option.map_eq_some_iff.mp h
    simp only [Prod.mk.injEq] at he; obtain ⟨rfl, rfl⟩ := he
    exact .call (ihn n (by omega) _ _ _ _ h₁)

