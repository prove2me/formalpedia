    cPair w D L P Q ≤ cPair w' D' L P' Q' := by
  unfold cPair cZS cD
  gcongr

theorem sum_atoms {W : ℕ} (p : Fin W) (Y : Fin W → ℂ) (YN : ℕ → ℂ) (hY : ∀ q : Fin W, YN q.val = Y q) :
    ∀ (as : List Atom), (∀ a ∈ as, a.s < W) →
    ∑ q, (as.map fun a => if a.t = p.val ∧ a.s = q.val then NLogN.KFB.toC a.c / 2 ^ a.h else 0).sum * Y q =
      (as.map fun a => if a.t = p.val then NLogN.KFB.toC a.c / 2 ^ a.h * YN a.s else 0).sum
  | [], _ => by simp
  | a :: as, h => by
    simp only [List.map_cons, List.sum_cons, add_mul, Finset.sum_add_distrib]
    rw [sum_atoms p Y YN hY as fun b hb => h b (List.mem_cons_of_mem _ hb)]
    congr 1
    have hs := h a List.mem_cons_self
    by_cases e1 : a.t = p.val
    · rw [if_pos e1, Finset.sum_eq_single ⟨a.s, hs⟩]
      · rw [if_pos ⟨e1, rfl⟩, ← hY ⟨a.s, hs⟩]
      · intro q _ hq
        rw [if_neg (fun h => hq (Fin.ext (by simp [h.2])))]; ring
      · simp
    · rw [if_neg e1]
      exact Finset.sum_eq_zero fun q _ => by rw [if_neg (fun h => e1 h.1)]; ring

theorem gateMat_sum {W : ℕ} (as : List Atom) (hok : ∀ a ∈ as, a.Ok W) (Y : Fin W → ℂ)
    (YN : ℕ → ℂ) (hY : ∀ q : Fin W, YN q.val = Y q) (p : Fin W) :
    ∑ q, gateMat W as p q * Y q =
      Y p + (as.map fun a => if a.t = p.val then NLogN.KFB.toC a.c / 2 ^ a.h * YN a.s else 0).sum := by
  simp only [gateMat, add_mul, Finset.sum_add_distrib, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq, Finset.mem_univ, if_true]
  rw [sum_atoms p Y YN hY as fun a ha => (hok a ha).2.1]

