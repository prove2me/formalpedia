-- title:
--   Integral Eichler–Shimura: Hecke algebra acting on H¹ₚₐᵣ
-- statement:
--   Fix an integer $N$ with $N \neq 0$ and an arbitrary set $S$ of natural numbers. Here $\Gamma =$ [`CohCarrier.GammaH N ⊤`](def/CohCarrier_Level.html#L133) is the subgroup of $\mathrm{SL}_2(\mathbb{Z})$ obtained as the image of the full unit subgroup under the character `gamma0Units M` of $\Gamma_0(N)$, $H^1 =$ [`CohCarrier.H1 N ⊤ ℤ`](def/CohCarrier_Level.html#L162) is the group $\mathrm{Hom}(\Gamma^{\mathrm{ab}},\mathbb{Z})$ of additive homomorphisms from `Additive Γ` to $\mathbb{Z}$, and [`ModularCurve.Period.parabolicHoms ℤ Γ ℤ`](def/ModularCurve_PeriodMap.html#L62) is the $\mathbb{Z}$-submodule of those $\varphi$ vanishing on every $\gamma \in \Gamma$ with $(\mathrm{tr}\,\gamma)^2 = 4$. For $\ell \neq 0$, [`CohCarrier.heckeT N ⊤ ℓ ℤ`](def/CohCarrier_Level.html#L250) is the additive endomorphism of $H^1$ given by the transfer to $\Gamma$ of the composite of $\varphi$ with the conjugation map [`CohCarrier.conjL`](def/CohCarrier_Level.html#L228) from the subgroup `GammaHUpper`. The assertion is twofold. First, for every $\ell \neq 0$ the operator `heckeT` carries parabolic homomorphisms to parabolic homomorphisms. Second, there is an injective ring homomorphism $\rho$ from [`CuspForm.heckeAlgebra N 2 S`](def/CuspForm_HeckeAlgebra.html#L18), the $\mathbb{Z}$-subalgebra of $\mathrm{End}_{\mathbb{C}}$ of weight-two cusp forms on $\Gamma_0(N)$ generated by the operators $T_\ell$ for primes $\ell \nmid N$, $\ell \notin S$ and $U_q$ for primes $q \mid N$, $q \notin S$, into $\mathrm{End}_{\mathbb{Z}}$ of the parabolic lattice, such that for each such prime $\ell$ and each parabolic $\varphi$ the element $\rho(T_\ell)\varphi$ equals `heckeT N ⊤ ℓ ℤ φ` in $H^1$, and likewise $\rho(U_q)\varphi$ equals `heckeT N ⊤ q ℤ φ`.
--
--   This is the integral, Hecke-equivariant form of the Eichler–Shimura correspondence: the weight-two Hecke algebra of level $N$ away from $S$ acts faithfully on the lattice of parabolic integral homomorphisms of $\Gamma_0(N)$, with the abstract generators $T_\ell$ and $U_q$ realised by the transfer-theoretic cohomological Hecke operators. It supplies the ring-theoretic input for the later passage from cusp forms to maximal ideals of the Hecke algebra and the associated mod-$p$ representations.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CohCarrier_exists_injective_ringHom_heckeAlgebra_moduleEnd_parabolicHoms.lean

import Definitions.Def_CohCarrier_Level
import Definitions.Def_CuspForm_HeckeAlgebra
import Definitions.Def_ModularCurve_PeriodMap

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

theorem CohCarrier.exists_injective_ringHom_heckeAlgebra_moduleEnd_parabolicHoms
    (N : ℕ) [NeZero N] (S : Set ℕ) :
    (∀ (ℓ : ℕ) [NeZero ℓ] (φ : CohCarrier.H1 N ⊤ ℤ),
        φ ∈ ModularCurve.Period.parabolicHoms ℤ (CohCarrier.GammaH N ⊤) ℤ →
          CohCarrier.heckeT N ⊤ ℓ ℤ φ ∈ ModularCurve.Period.parabolicHoms ℤ (CohCarrier.GammaH N ⊤) ℤ) ∧
    ∃ ρ : ↥(CuspForm.heckeAlgebra N 2 S) →+*
        Module.End ℤ ↥(ModularCurve.Period.parabolicHoms ℤ (CohCarrier.GammaH N ⊤) ℤ),
      Function.Injective ρ ∧
      (∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S)
          (φ : ↥(ModularCurve.Period.parabolicHoms ℤ (CohCarrier.GammaH N ⊤) ℤ)),
        haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
        ((ρ (CuspForm.heckeAlgebra.T hℓ hℓN hℓS) φ :
            ↥(ModularCurve.Period.parabolicHoms ℤ (CohCarrier.GammaH N ⊤) ℤ)) : CohCarrier.H1 N ⊤ ℤ) =
          CohCarrier.heckeT N ⊤ ℓ ℤ φ) ∧
      (∀ (q : ℕ) (hq : q.Prime) (hqN : q ∣ N) (hqS : q ∉ S)
          (φ : ↥(ModularCurve.Period.parabolicHoms ℤ (CohCarrier.GammaH N ⊤) ℤ)),
        haveI : NeZero q := ⟨hq.ne_zero⟩
        ((ρ (CuspForm.heckeAlgebra.U hq hqN hqS) φ :
            ↥(ModularCurve.Period.parabolicHoms ℤ (CohCarrier.GammaH N ⊤) ℤ)) : CohCarrier.H1 N ⊤ ℤ) =
          CohCarrier.heckeT N ⊤ q ℤ φ) := by sorry
