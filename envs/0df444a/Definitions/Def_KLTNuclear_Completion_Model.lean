-- title:
--   USR matrix completion: uniform design on the basis (1.3), $L_2(\Pi)$, the stochastic error $\mathbf M$ (2.2), model (1.1), estimator (3.1), $\sigma_Z$
-- statement:
--   This file fixes the probabilistic objects of the matrix completion part of Koltchinskii, Lounici and Tsybakov. Throughout, $(\Omega,\mathcal F,\mathbb P)$ is a probability space, $n, m_1, m_2$ are positive integers, and $\mathbb R^{m_1\times m_2}$ is the space of real $m_1\times m_2$ matrices with the scalar product $\langle A,B\rangle=\operatorname{tr}(A^\top B)$, Frobenius norm $\|A\|_2$, nuclear norm $\|A\|_1$ and operator norm $\|A\|_\infty$ (largest singular value), all taken from the published `MatrixCompletion` definitions.
--
--   1. **Entrywise expectation.** For a random matrix $F:\Omega\to\mathbb R^{a\times b}$, $\mathbb E(F)$ is the matrix of entrywise expectations, $\mathbb E(F)_{jk}=\int F_{jk}\,d\mathbb P$. A random matrix is *measurable* when its entries are jointly measurable, and random matrices $Z_1,\dots,Z_n$ are *independent* when their entry arrays are mutually independent random elements.
--   2. **The quantity $\sigma_Z$** of Proposition 1: for random matrices $Z_1,\dots,Z_n\in\mathbb R^{m_1\times m_2}$,
--   $$\sigma_Z=\max\Big\{\Big\|\frac1n\sum_{i=1}^n\mathbb E(Z_iZ_i^\top)\Big\|_\infty^{1/2},\ \Big\|\frac1n\sum_{i=1}^n\mathbb E(Z_i^\top Z_i)\Big\|_\infty^{1/2}\Big\}.$$
--   3. **Uniform sampling from the matrix completion basis.** The matrix completion basis is $\mathcal X=\{e_j(m_1)e_k^\top(m_2): 1\le j\le m_1,\ 1\le k\le m_2\}$ (1.3). A design is given by random indices $I_i=(j_i,k_i)$, $i=1,\dots,n$, and $X_i=e_{j_i}(m_1)e_{k_i}^\top(m_2)$. The index $I_i$ is *uniform* when it is measurable and $\mathbb P(I_i=(j,k))=1/(m_1m_2)$ for every $(j,k)$, i.e. $X_i$ is uniformly distributed on $\mathcal X$.
--   4. **The $L_2(\Pi)$ semi-norm** (p. 2), kept squared:
--   $$\|A\|_{L_2(\Pi)}^2=\frac1n\sum_{i=1}^n\mathbb E\big(\langle A,X_i\rangle^2\big).$$
--   5. **The stochastic error** (2.2):
--   $$\mathbf M=\frac1n\sum_{i=1}^n\big(Y_iX_i-\mathbb E(Y_iX_i)\big).$$
--   6. **The trace regression model** (1.1): $\mathbb E(Y_i\mid X_i)=\operatorname{tr}(X_i^\top A_0)$ for every $i$, the conditional expectation being taken given the $\sigma$-algebra generated by $X_i$.
--   7. **The estimator** (3.1): for $\lambda\in\mathbb R$ and each sample point, $\hat A^\lambda$ is a minimizer over all of $\mathbb R^{m_1\times m_2}$ of
--   $$\frac{1}{m_1m_2}\|A\|_2^2-\Big\langle\frac2n\sum_{i=1}^nY_iX_i,\,A\Big\rangle+\lambda\|A\|_1 .$$
--
--   These are the objects in which Theorem 4, Lemma 1, Proposition 1 and the identities (1.4) and (6.2) are stated.
--
--   **Formalization Note** Mathlib has no measurable-space structure on `Matrix`, so measurability, independence and conditioning on $X_i$ go through the entry array `Matrix.of.symm X : Fin m₁ → Fin m₂ → ℝ` with the product $\sigma$-algebra. Expectations of matrices are entrywise Bochner integrals. The design is encoded by the index $I_i\in[m_1]\times[m_2]$; $X_i$ and $I_i$ generate the same $\sigma$-algebra. The estimator is the argmin form of (3.1), not the soft-thresholding formula (3.2). Sizes $n, m_1, m_2$ are natural numbers; positivity is a hypothesis of each theorem.
-- source:
--   Koltchinskii, Lounici, Tsybakov, Nuclear-Norm Penalization and Optimal Rates for Noisy Low-Rank Matrix Completion, arXiv:1011.6256v4, pp. 1–2, (1.1), (1.3), L₂(Π); p. 6, (2.2); p. 12, (3.1); p. 27, Proposition 1 (σ_Z)

import Mathlib
import Definitions.Def_matrix_completion_tangent
import Definitions.Def_KLTNuclear_Oracle_Model

namespace KLTNuclear.Completion

open MatrixCompletion MeasureTheory ProbabilityTheory

/-- Entrywise expectation `𝔼 F` of a random `a × b` real matrix `F : Ω → ℝ^{a×b}`:
the `(j, k)` entry is `∫ ω, F ω j k ∂P`. (Koltchinskii–Lounici–Tsybakov, arXiv:1011.6256v4,
the expectations `𝔼(Y_i X_i)` of (2.2), p. 6, and `𝔼(Z_i Z_iᵀ)` of Proposition 1, p. 27.) -/
noncomputable def matrixMean {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {a b : ℕ}
    (F : Ω → Matrix (Fin a) (Fin b) ℝ) : Matrix (Fin a) (Fin b) ℝ :=
  Matrix.of fun j k => ∫ ω, F ω j k ∂P

/-- A random matrix `F : Ω → ℝ^{a×b}` is measurable when its entry function
`ω ↦ (j ↦ k ↦ F ω j k)` is measurable for the product σ-algebra. -/
def MeasurableMatrix {Ω : Type*} [MeasurableSpace Ω] {a b : ℕ}
    (F : Ω → Matrix (Fin a) (Fin b) ℝ) : Prop :=
  Measurable fun ω => Matrix.of.symm (F ω)

/-- The random matrices `Z_1, …, Z_n` are (mutually) independent: their entry functions are
independent random elements of `ℝ^{a} → ℝ^{b}` (product σ-algebra). -/
def IndepMatrices {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n a b : ℕ}
    (Z : Fin n → Ω → Matrix (Fin a) (Fin b) ℝ) : Prop :=
  iIndepFun (fun i ω => Matrix.of.symm (Z i ω)) P

/-- The quantity `σ_Z` of Proposition 1 (arXiv:1011.6256v4, p. 27):
`σ_Z = max { ‖(1/n) Σ_i 𝔼(Z_i Z_iᵀ)‖^{1/2}, ‖(1/n) Σ_i 𝔼(Z_iᵀ Z_i)‖^{1/2} }`,
with `‖·‖` the operator (spectral) norm and the expectations taken entrywise. -/
noncomputable def sigmaZ {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (Z : Fin n → Ω → RealMatrix m₁ m₂) : ℝ :=
  max (Real.sqrt (spectralNorm ((1 / (n : ℝ)) • ∑ i, matrixMean P fun ω => Z i ω * (Z i ω).transpose)))
    (Real.sqrt (spectralNorm ((1 / (n : ℝ)) • ∑ i, matrixMean P fun ω => (Z i ω).transpose * Z i ω)))

/-- The design matrices of uniform sampling from the matrix completion basis (1.3):
the index `I i ω = (j, k)` selects `X_i(ω) = e_j(m₁) e_kᵀ(m₂)`. -/
def designMatrix {Ω : Type*} {n m₁ m₂ : ℕ} (I : Fin n → Ω → Fin m₁ × Fin m₂) (i : Fin n)
    (ω : Ω) : RealMatrix m₁ m₂ :=
  coordinateMatrix (I i ω).1 (I i ω).2

/-- Each index `I i` is a measurable random element of `[m₁] × [m₂]` uniformly distributed:
`P(I_i = (j, k)) = 1/(m₁ m₂)` for every `(j, k)`. Equivalently, `X_i = designMatrix I i` is
uniformly distributed on the matrix completion basis `𝒳` of (1.3), p. 2. -/
def UniformIndex {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {m₁ m₂ : ℕ}
    (J : Ω → Fin m₁ × Fin m₂) : Prop :=
  Measurable J ∧ ∀ jk : Fin m₁ × Fin m₂, P (J ⁻¹' {jk}) = ((m₁ * m₂ : ℕ) : ENNReal)⁻¹

/-- The semi-norm `‖A‖²_{L₂(Π)} = (1/n) Σ_i 𝔼(⟨A, X_i⟩²)` (p. 2), kept squared. -/
noncomputable def l2NormSq {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (A : RealMatrix m₁ m₂) : ℝ :=
  (1 / (n : ℝ)) * ∑ i, ∫ ω, (matrixInner A (X i ω)) ^ 2 ∂P

/-- The trace regression model (1.1), p. 1: `𝔼(Y_i | X_i) = tr(X_iᵀ A₀) = ⟨A₀, X_i⟩` for every
`i`, the conditional expectation being taken given the σ-algebra generated by `X_i`
(the σ-algebra pulled back from the product σ-algebra on the entries of `X_i`). -/
def TraceRegressionModel {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (Y : Fin n → Ω → ℝ) (A₀ : RealMatrix m₁ m₂) : Prop :=
  ∀ i, P[Y i | MeasurableSpace.comap (fun ω => Matrix.of.symm (X i ω)) inferInstance]
    =ᵐ[P] fun ω => matrixInner A₀ (X i ω)

/-- The matrix completion objective of (3.1), p. 12 (first line):
`(1/(m₁m₂)) ‖A‖₂² − ⟨(2/n) Σ_i Y_i X_i, A⟩ + λ ‖A‖₁`, at the sample point `ω`. -/
noncomputable def completionObjective {Ω : Type*} {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (Y : Fin n → Ω → ℝ) (lam : ℝ) (ω : Ω)
    (A : RealMatrix m₁ m₂) : ℝ :=
  (1 / ((m₁ : ℝ) * m₂)) * frobeniusNormSq A
    - matrixInner ((2 / (n : ℝ)) • ∑ i, Y i ω • X i ω) A + lam * nuclearNorm A

/-- `Â` is the estimator `Â^λ` of (3.1) at `ω`: a minimizer of `completionObjective` over all of
`ℝ^{m₁×m₂}` (𝔸 = ℝ^{m₁×m₂} in matrix completion, p. 12). -/
def IsCompletionEstimator {Ω : Type*} {n m₁ m₂ : ℕ}
    (X : Fin n → Ω → RealMatrix m₁ m₂) (Y : Fin n → Ω → ℝ) (lam : ℝ) (ω : Ω)
    (Â : RealMatrix m₁ m₂) : Prop :=
  ∀ A : RealMatrix m₁ m₂, completionObjective X Y lam ω Â ≤ completionObjective X Y lam ω A

end KLTNuclear.Completion


