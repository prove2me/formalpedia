-- url     : https://prove2.me/theorems/56a37e51-5029-4746-b20f-e83e52df1cf9
-- title:
--   p-groups of class 2, direct-sum decompositions, ranks, coefficients, $D_{p^\delta}(G)$, binary codes and the time bound
-- statement:
--   A finite group $G$ is a **$p$-group of class 2** if $|G|$ is a power of the prime $p$, $[G,G]\le Z(G)$, and $G$ is not abelian (nilpotency class exactly 2). $[g,h]=ghg^{-1}h^{-1}$, $\tilde g=gZ(G)$, $\mathrm{ord}(g)$ is the order of $g$.
--
--   For a subgroup $A$, elements $x_1,\dots,x_k$ and a subgroup $B$, **$A=\langle x_1\rangle\oplus\cdots\oplus\langle x_k\rangle\oplus B$** means: all $x_i$ and $B$ lie in $A$, and every $a\in A$ is $x_1^{m_1}\cdots x_k^{m_k}b$ for exactly one choice of $0\le m_i<\mathrm{ord}(x_i)$ and $b\in B$ (in the abelian groups where it is used, this is the internal direct sum). The **coefficients** of $a$ are these $m_i$; the $B$-part is $b$. **$A/B=\bigoplus\langle x_iB\rangle$** means every $a\in A$ is $\prod x_i^{m_i}$ modulo $B$ for exactly one $m$ with $0\le m_i<\mathrm{ord}(x_iB)$. The **rank** of a finite abelian $p$-group is the least number of cyclic summands of a decomposition.
--
--   $(G/Z(G))_{p^\delta}$ is the subgroup of $G/Z(G)$ generated by its elements of order at most $p^\delta$, and **$D_{p^\delta}(G)$** the subgroup of $G$ of all $g$ with $\tilde g\in (G/Z(G))_{p^\delta}$.
--
--   The **normal-form map** of Lemma 3.1 sends $g_1^{m_1}\cdots g_\ell^{m_\ell}$ ($0\le m_i<t_i$) to $h_1^{m_1}\cdots h_\ell^{m_\ell}$, and the **three conditions of Lemma 3.1** are bundled as `CPConds`.
--
--   **Codes.** Numbers use the published self-delimiting `encodeNat`; lists are length then entries; a labelled group $e:G\simeq\{0,\dots,N-1\}$ is $N$ followed by its Cayley table (published `GroupIsoPoly.encTable`); elements by label, subsets by membership bits, elements of $\mathbb Z/q$ by their representative in $[0,q)$, and the parameters $\tau,\delta$ in unary. The **time bound of Theorem 1.1** is $\lceil N^{C(\log N)^{25/26}\log\log N}\rceil$ (natural logarithms), and $\mathrm{ppow}(p,x)=\lceil p^x\rceil$.
--
--   **Formalization Note** `abRank` and `relRank` are `sInf` over a nonempty set of natural numbers for every finite abelian group. Coefficients are chosen by `Classical.choose` and are unique whenever the decomposition holds.
-- source:
--   Sun 2026, arXiv:2611.05920 (held version, sha256 22193308…), §1 p. 1 (PDF 3); §2.2 p. 9 (PDF 11); Lemma 3.1 p. 11 (PDF 13); §4.3 p. 19 (PDF 21)

import Mathlib
import Definitions.Def_GroupIsoPoly_encPair

set_option autoImplicit false

noncomputable section

open scoped Classical commutatorElement

namespace SunGroupIso.Class2

open ExponomialAssortment.FPTAS (encodeNat)

/-- **p-group of nilpotency class 2** (Sun 2026, arXiv:2611.05920, §1, p. 1, PDF p. 3: "a group
has class at most 2 if and only if [G, G] ≤ Z(G)"). A finite group of `p`-power order (`IsPGroup p G`)
whose commutator subgroup lies in the centre and which is not abelian: nilpotency class exactly 2. -/
def IsPGroupClass2 (p : ℕ) (G : Type*) [Group G] [Finite G] : Prop :=
  IsPGroup p G ∧ commutator G ≤ Subgroup.center G ∧ ∃ a b : G, a * b ≠ b * a

/-- **The time bound of Theorem 1.1**: `⌈N ^ (C · (log N)^(25/26) · log log N)⌉`, natural logarithms,
real powers, rounded up. For every class-2 `p`-group `N ≥ p³ ≥ 8`, so `log log N > 0`. -/
def timeBound (C N : ℕ) : ℕ :=
  ⌈(N : ℝ) ^ ((C : ℝ) * Real.log N ^ ((25 : ℝ) / 26) * Real.log (Real.log N))⌉₊

/-- `⌈p ^ x⌉` for a real exponent `x`: the shape `p^{O(·)}` of every milestone bound. -/
def ppow (p : ℕ) (x : ℝ) : ℕ := ⌈(p : ℝ) ^ x⌉₊

/-- One-based access to a vector, as on the page: `at1 v i = v_i` for `1 ≤ i ≤ n`, and `1` outside. -/
def at1 {α : Type*} [One α] {n : ℕ} (v : Fin n → α) (i : ℕ) : α :=
  if h : 1 ≤ i ∧ i ≤ n then v ⟨i - 1, by omega⟩ else 1

/-- Zero-based access to a vector of naturals, `0` outside. -/
def atN {n : ℕ} (f : Fin n → ℕ) (i : ℕ) : ℕ := if h : i < n then f ⟨i, h⟩ else 0

/-- The ordered product `x_1^{m_1} ⋯ x_k^{m_k}`, factors in increasing index (§2.2, p. 9). -/
def prodPow {A : Type*} [Monoid A] {k : ℕ} (x : Fin k → A) (m : Fin k → ℕ) : A :=
  (List.ofFn fun i => x i ^ m i).prod

/-- `mb = (m, b)` is a normal form of `a` with respect to `x_1, …, x_k` and the subgroup `B`:
`a = x_1^{m_1} ⋯ x_k^{m_k} · b` with `0 ≤ m_i < ord(x_i)` and `b ∈ B`. -/
def NormalForm {Q : Type*} [Group Q] {k : ℕ} (x : Fin k → Q) (B : Subgroup Q) (a : Q)
    (mb : (Fin k → ℕ) × Q) : Prop :=
  (∀ i, mb.1 i < orderOf (x i)) ∧ mb.2 ∈ B ∧ a = prodPow x mb.1 * mb.2

/-- **Direct-sum decomposition** `A = ⟨x_1⟩ ⊕ ⋯ ⊕ ⟨x_k⟩ ⊕ B` of an abelian subgroup `A` (all uses:
`Z(G)`, subgroups of `Z(G)`, subgroups of `G/Z(G)` for class-2 `G`): the `x_i` and `B` lie in `A`, and
every element of `A` has exactly one normal form. With `B = ⊥` this is `A = ⊕ ⟨x_i⟩`. -/
def DecompWith {Q : Type*} [Group Q] (A : Subgroup Q) {k : ℕ} (x : Fin k → Q) (B : Subgroup Q) :
    Prop :=
  (∀ i, x i ∈ A) ∧ B ≤ A ∧ ∀ a ∈ A, ∃! mb : (Fin k → ℕ) × Q, NormalForm x B a mb

/-- **Rank** of a finite abelian `p`-group (§2.2, p. 9): the number `r` of cyclic factors of
`A ≅ ⊕_{i=1}^r Z/p^{α_i}Z`, i.e. the least number of cyclic summands of a direct-sum decomposition
(a least one has no trivial summand). -/
def abRank {Q : Type*} [Group Q] (A : Subgroup Q) : ℕ :=
  sInf {k | ∃ x : Fin k → Q, DecompWith A x ⊥}

/-- **Coefficients** (§2.2, p. 9): the exponents `0 ≤ α_i < ord(x_i)` of the normal form of `a` with
respect to `x_1, …, x_k` and `B` (unique when `DecompWith A x B` and `a ∈ A`; `0` if there is none). -/
def coeffsWith {Q : Type*} [Group Q] {k : ℕ} (x : Fin k → Q) (B : Subgroup Q) (a : Q) : Fin k → ℕ :=
  if h : ∃ mb, NormalForm x B a mb then (Classical.choose h).1 else fun _ => 0

/-- The `B`-component of the normal form of `a` (the projection onto the summand `B`). -/
def partWith {Q : Type*} [Group Q] {k : ℕ} (x : Fin k → Q) (B : Subgroup Q) (a : Q) : Q :=
  if h : ∃ mb, NormalForm x B a mb then (Classical.choose h).2 else 1

/-- The order of `x` modulo a subgroup `B`: the least `e > 0` with `x^e ∈ B` (the order of `xB`). -/
def ordMod {Q : Type*} [Group Q] (B : Subgroup Q) (x : Q) : ℕ := sInf {e | 0 < e ∧ x ^ e ∈ B}

/-- **Direct-sum decomposition of a quotient** `A/B = ⟨x_1 B⟩ ⊕ ⋯ ⊕ ⟨x_k B⟩` (for `B ≤ A`, `A`
abelian): the `x_i` lie in `A` and every `a ∈ A` is `x_1^{m_1} ⋯ x_k^{m_k}` modulo `B` for exactly one
`m` with `0 ≤ m_i < ord(x_i B)`. -/
def DecompMod {Q : Type*} [Group Q] (A B : Subgroup Q) {k : ℕ} (x : Fin k → Q) : Prop :=
  (∀ i, x i ∈ A) ∧
    ∀ a ∈ A, ∃! m : Fin k → ℕ, (∀ i, m i < ordMod B (x i)) ∧ (prodPow x m)⁻¹ * a ∈ B

/-- The rank of the quotient `A/B`: the least number of cyclic summands of a decomposition. -/
def relRank {Q : Type*} [Group Q] (A B : Subgroup Q) : ℕ :=
  sInf {k | ∃ x : Fin k → Q, DecompMod A B x}

/-- The central quotient `G/Z(G)`. -/
abbrev Qt (G : Type*) [Group G] := G ⧸ Subgroup.center G

/-- `g̃ = gZ(G)` (§2.2, p. 9). -/
def tl {G : Type*} [Group G] (g : G) : Qt G := QuotientGroup.mk g

/-- The quotient map `G → G/Z(G)`. -/
def qmap (G : Type*) [Group G] : G →* Qt G := QuotientGroup.mk' (Subgroup.center G)

/-- `(G/Z(G))_{p^δ}`: the subgroup of `G/Z(G)` generated by its elements of order at most `p^δ`
(§4.3, p. 19, PDF p. 21). -/
def lowQuot (p δ : ℕ) (G : Type*) [Group G] : Subgroup (Qt G) :=
  Subgroup.closure {x | orderOf x ≤ p ^ δ}

/-- **`D_{p^δ}(G)`** (§4.3, p. 19, PDF p. 21): the subgroup of `G` generated by all `g ∈ G` with
`g̃ ∈ (G/Z(G))_{p^δ}`. -/
def Dsub (p δ : ℕ) (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure {g | tl g ∈ lowQuot p δ G}

/-- The exponents of the ordered normal form `x = g_1^{m_1} ⋯ g_ℓ^{m_ℓ}`, `0 ≤ m_i < t_i` (Lemma 3.1,
p. 11, PDF p. 13); `0` if `x` has no such form. -/
def nfExps {Q : Type*} [Group Q] {l : ℕ} (g : Fin l → Q) (t : Fin l → ℕ) (x : Q) : Fin l → ℕ :=
  if h : ∃ m : Fin l → ℕ, (∀ i, m i < t i) ∧ x = prodPow g m then Classical.choose h else fun _ => 0

/-- **The normal-form map of Lemma 3.1** (p. 11, PDF p. 13): `f(g_1^{m_1} ⋯ g_ℓ^{m_ℓ}) = h_1^{m_1} ⋯ h_ℓ^{m_ℓ}`
for `0 ≤ m_i < t_i`. -/
def nfMap {Q Q' : Type*} [Group Q] [Group Q'] {l : ℕ} (g : Fin l → Q) (h : Fin l → Q') (t : Fin l → ℕ)
    (x : Q) : Q' :=
  prodPow h (nfExps g t x)

/-- **The three conditions of Lemma 3.1** (p. 11, PDF p. 13) on `g_1, …, g_ℓ ∈ G`, `h_1, …, h_ℓ ∈ H`,
`ℓ = k + k'` (zero-based: the first `k` are central generators, the last `k'` quotient generators):
1. `Z(G) = ⊕_{i≤k} ⟨g_i⟩`, `Z(H) = ⊕_{i≤k} ⟨h_i⟩`, `ord(g_i) = ord(h_i)`;
2. `G/Z(G) = ⊕_{i>k} ⟨g̃_i⟩`, `H/Z(H) = ⊕_{i>k} ⟨h̃_i⟩`, `ord(g̃_i) = ord(h̃_i)`;
3. with `t_i = ord(g_i)` (`i ≤ k`), `t_i = ord(g̃_i)` (`i > k`) and `f` the normal-form map,
   (a) `f(g_i^{t_i}) = f(g_i)^{t_i}` for `i > k`; (b) `f([g_i, g_j]) = [f(g_i), f(g_j)]` for all `i, j`. -/
def CPConds {Q Q' : Type*} [Group Q] [Group Q'] (k k' : ℕ) (g : Fin (k + k') → Q) (h : Fin (k + k') → Q') :
    Prop :=
  let t : Fin (k + k') → ℕ := fun i => if i.val < k then orderOf (g i) else orderOf (tl (g i))
  let f : Q → Q' := nfMap g h t
  (DecompWith (Subgroup.center Q) (fun i : Fin k => g (Fin.castAdd k' i)) ⊥ ∧
    DecompWith (Subgroup.center Q') (fun i : Fin k => h (Fin.castAdd k' i)) ⊥ ∧
    ∀ i : Fin k, orderOf (g (Fin.castAdd k' i)) = orderOf (h (Fin.castAdd k' i))) ∧
  (DecompWith ⊤ (fun i : Fin k' => tl (g (Fin.natAdd k i))) ⊥ ∧
    DecompWith ⊤ (fun i : Fin k' => tl (h (Fin.natAdd k i))) ⊥ ∧
    ∀ i : Fin k', orderOf (tl (g (Fin.natAdd k i))) = orderOf (tl (h (Fin.natAdd k i)))) ∧
  (∀ i : Fin k', f (g (Fin.natAdd k i) ^ t (Fin.natAdd k i)) = f (g (Fin.natAdd k i)) ^ t (Fin.natAdd k i)) ∧
  (∀ i j : Fin (k + k'), f ⁅g i, g j⁆ = ⁅f (g i), f (g j)⁆)

/-! ### Binary codes of algorithmic inputs and outputs, built from the published `encodeNat`. -/

/-- A list: its length, then the codes of its entries. -/
def encList {α : Type*} (f : α → List Bool) (l : List α) : List Bool :=
  encodeNat l.length ++ (l.map f).flatten

/-- A vector `v : Fin k → α`, as the list of its entries. -/
def encVec {α : Type*} {k : ℕ} (f : α → List Bool) (v : Fin k → α) : List Bool :=
  encList f (List.ofFn v)

/-- A parameter in unary (`n` ones, then a zero). -/
def encUnary (n : ℕ) : List Bool := List.replicate n true ++ [false]

/-- A labelled finite group `e : G ≃ Fin N`: `N`, then its Cayley table (`GroupIsoPoly.encTable`). -/
def encGroup {G : Type*} [Group G] {N : ℕ} (e : G ≃ Fin N) : List Bool :=
  encodeNat N ++ GroupIsoPoly.encTable N (GroupIsoPoly.cayley e)

/-- A group element, by its label. -/
def encElem {G : Type*} {N : ℕ} (e : G ≃ Fin N) (g : G) : List Bool := encodeNat (e g : ℕ)

/-- A subset of a labelled group, by its membership bits in label order. -/
def encSet {G : Type*} {N : ℕ} (e : G ≃ Fin N) (S : Set G) : List Bool :=
  List.ofFn fun i : Fin N => decide (e.symm i ∈ S)

/-- An element of `Z/qZ`, by its representative in `[0, q)`. -/
def encZMod {q : ℕ} (x : ZMod q) : List Bool := encodeNat x.val

/-- A function on a subset `S` of a labelled group: for each label in order whose element lies in `S`,
the code of the value (nothing for the other labels). -/
def encOn {G : Type*} {N : ℕ} (e : G ≃ Fin N) (S : Set G) (f : G → List Bool) : List Bool :=
  (List.ofFn fun i : Fin N => if e.symm i ∈ S then f (e.symm i) else []).flatten

end SunGroupIso.Class2


