    inferInstance, inferInstance, inferInstance, hloc, hinj, ρ, hcharpoly, L, algebraMap O' O'' α₀,
    ⟨b, hLb⟩, hD, hI, RingHom.isUnit_map (algebraMap O' O'') hα₀unit, ?_, hFrob⟩
  have h := congrArg (algebraMap O' O'') hα₀eq
  rwa [map_add, map_sub, map_mul, map_mul, map_natCast, map_zero] at h

