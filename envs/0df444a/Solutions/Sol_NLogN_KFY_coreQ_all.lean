theorem GB.mono {B B' : ℕ} {L : List (ℤ × ℤ)} (h : NLogN.GL.GB B L) (hB : B ≤ B') : NLogN.GL.GB B' L :=
  fun z hz => ⟨(h z hz).1.trans hB, (h z hz).2.trans hB⟩

