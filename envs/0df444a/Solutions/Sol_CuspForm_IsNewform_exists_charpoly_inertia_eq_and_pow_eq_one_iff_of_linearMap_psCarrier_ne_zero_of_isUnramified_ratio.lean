    by_cases hqM'1 : q ∣ M'
    · exact GaloisRepAdic.isUnipotentOnInertiaAt_of_isNewform_of_dvd_of_not_sq_dvd hh lam S₁ O' hlamO' chih₁
        hchih₁ iota₁ ρ' hρ' q hq hqlam hqM'1 hqM'
    · exact GaloisRepAdic.isUnipotentOnInertiaAt_of_charpoly_frobenius_eq_of_not_dvd lam S₁ O' hlamO'
        (iota₁.comp chih₁.rangeRestrict) ρ' hρ' q hq hqlam hqM'1

