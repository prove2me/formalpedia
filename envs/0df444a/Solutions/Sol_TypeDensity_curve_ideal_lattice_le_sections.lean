theorem solution (R : Type) [CommRing R] (t x : R)
    (beta : TypeDensity.BlowupRestriction R t x) (d : ℕ) (G : TypeDensity.GluedGenerators R t x beta d) (j : ℕ) :
    TypeDensity.curveIdealLattice R t x beta G j ≤ TypeDensity.curveSections R t x beta G j := by
  have hrel := TypeDensity.blowup_chart_relation R t x
  set I := TypeDensity.overlapCurveIdeal R t x beta G j
  set alg := algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)
