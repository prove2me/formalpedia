lemma cent_eq {H x y : ℤ} (hH : 0 < H) (hy : -H ≤ y ∧ y < H) (hd : 2 * H ∣ x - y) :
    cent H x = y := by
  obtain ⟨t, ht⟩ := hd
  unfold cent
  rw [show x + H = (y + H) + 2 * H * t by linarith, Int.add_mul_emod_self_left,
    Int.emod_eq_of_lt (by omega) (by omega)]
  ring

lemma tail_succ (B : ℤ) (f : ℕ → ℤ) {J j : ℕ} (hj : j < J) :
    tail B f J j = f j + B * tail B f J (j + 1) := by
  unfold tail
  rw [show J - j = (J - (j + 1)) + 1 by omega, sum_range_succ', mul_sum]
  simp only [add_zero, pow_zero, mul_one]
  rw [add_comm]; congr 1
  refine sum_congr rfl fun k _ => ?_
  rw [show j + (k + 1) = j + 1 + k by ring, pow_succ]; ring

/-- **Centered extraction (Lemma 17).** If `Z = ∑_{j<J} h_j B^j = ∑_{j<J} q_j B^j + ε B^J`
with `B = 2H`, `h_j ∈ [-H, H)`, `0 ≤ q_j < B`, then for every `j ≤ J` the residual identity
holds, the carry is in `{0,1}`, and every centered residue below `j` equals `h_k`. -/
theorem extract_sol_aux {H : ℤ} (hH : 0 < H) {h q : ℕ → ℤ} {ε : ℤ} {J : ℕ}
    (hh : ∀ j < J, -H ≤ h j ∧ h j < H) (hq : ∀ j, 0 ≤ q j ∧ q j < 2 * H)
    (hZ : ∑ j ∈ range J, h j * (2 * H) ^ j = ∑ j ∈ range J, q j * (2 * H) ^ j + ε * (2 * H) ^ J) :
    ∀ j ≤ J, tail (2 * H) h J j = tail (2 * H) q J j + rho H q j + ε * (2 * H) ^ (J - j) ∧
      (rho H q j = 0 ∨ rho H q j = 1) ∧ ∀ k < j, cent H (q k + rho H q k) = h k := by
  intro j
  induction j with
  | zero =>
    intro _
    refine ⟨?_, Or.inl rfl, fun k hk => absurd hk (Nat.not_lt_zero _)⟩
    simp only [tail, Nat.sub_zero, zero_add, rho, add_zero]; exact hZ
  | succ j ih =>
    intro hj
    obtain ⟨hid, hρ, hrec⟩ := ih (by omega)
    rw [tail_succ _ h (by omega), tail_succ _ q (by omega),
      show J - j = (J - (j + 1)) + 1 by omega, pow_succ] at hid
    set Th := tail (2 * H) h J (j + 1)
    set Tq := tail (2 * H) q J (j + 1)
    set P := (2 * H) ^ (J - (j + 1))
    set x := q j + rho H q j with hx
    have hdiff : x - h j = 2 * H * (Th - Tq - ε * P) := by rw [hx]; linear_combination -hid
    have hc : cent H x = h j := cent_eq hH (hh j (by omega)) ⟨_, hdiff⟩
    have hρ' : rho H q (j + 1) = Th - Tq - ε * P := by
      show (x - cent H x) / (2 * H) = _
      rw [hc, hdiff, Int.mul_ediv_cancel_left _ (by omega)]
    refine ⟨by rw [hρ']; ring, ?_, ?_⟩
    · have e1 : 2 * H * rho H q (j + 1) = x - h j := by rw [hρ', hdiff]
      have hhj := hh j (by omega)
      have hqj := hq j
      have hx0 : 0 ≤ x ∧ x ≤ 2 * H := by rcases hρ with h' | h' <;> rw [hx, h'] <;> omega
      have hlo : 0 ≤ rho H q (j + 1) := by
        by_contra hn; push Not at hn; nlinarith
      have hhi : rho H q (j + 1) ≤ 1 := by
        by_contra hn; push Not at hn; nlinarith
      omega
    · intro k hk
      rcases Nat.lt_or_ge k j with hkj | hkj
      · exact hrec k hkj
      · rw [show k = j by omega]; exact hc

