/-- **`PreNeed6` holds** (for every plan). -/
theorem preNeed6_holds (P : Prm) (hP : P.Ok) (pl : Plan6) : PreNeed6 P pl :=
  fun tab _ _ _ => preU6_holds P hP pl tab

