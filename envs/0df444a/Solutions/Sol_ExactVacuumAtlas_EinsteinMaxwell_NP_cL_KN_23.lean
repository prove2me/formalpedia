variable {M a Q : ℝ} {x : Pt 4}
theorem solution (hx : x ∈ domReg M a Q) :
    cL (knE M a Q) (knTh M a Q) 0 2 3 x = -1 / qK a x + 1 / qbarK a x ∧
    cL (knE M a Q) (knTh M a Q) 1 2 3 x = ((Del M a Q (x 1) : ℝ) : ℂ) / (2 * ((Sig a (x 1) (x 2) : ℝ) : ℂ) * qbarK a x)
      - ((Del M a Q (x 1) : ℝ) : ℂ) / (2 * ((Sig a (x 1) (x 2) : ℝ) : ℂ) * qK a x) ∧
    cL (knE M a Q) (knTh M a Q) 2 2 3 x = -(I * ((a * Real.sin (x 2) : ℝ) : ℂ)) / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x ^ 2)
      - ((Real.cos (x 2) / Real.sin (x 2) : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qK a x) ∧
    cL (knE M a Q) (knTh M a Q) 3 2 3 x = ((Real.cos (x 2) / Real.sin (x 2) : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a x)
      - I * ((a * Real.sin (x 2) : ℝ) : ℂ) / (((Real.sqrt 2 : ℝ) : ℂ) * qbarK a x ^ 2) := by
  ( (
  obtain ⟨d00r, d00t⟩ := dE_0_0 hx; obtain ⟨d03r, d03t⟩ := dE_0_3 hx
  obtain ⟨d10r, d10t⟩ := dE_1_0 hx; obtain ⟨d11r, d11t⟩ := dE_1_1 hx; obtain ⟨d13r, d13t⟩ := dE_1_3 hx
  obtain ⟨d20r, d20t⟩ := dE_2_0 hx; obtain ⟨d22r, d22t⟩ := dE_2_2 hx; obtain ⟨d23r, d23t⟩ := dE_2_3 hx
  have d01 : ∀ i, cpdC i (knE M a Q 0 1) x = 0 := fun i => dE_const M a Q 0 1 i 1 (knE_0_1 M a Q) x
  have d02 : ∀ i, cpdC i (knE M a Q 0 2) x = 0 := fun i => dE_const M a Q 0 2 i 0 (knE_0_2 M a Q) x
  have d12 : ∀ i, cpdC i (knE M a Q 1 2) x = 0 := fun i => dE_const M a Q 1 2 i 0 (knE_1_2 M a Q) x
  have d21 : ∀ i, cpdC i (knE M a Q 2 1) x = 0 := fun i => dE_const M a Q 2 1 i 0 (knE_2_1 M a Q) x
  obtain ⟨c00, c01, c02, c03⟩ := knCov_0 hx; obtain ⟨c10, c11, c12, c13⟩ := knCov_1 hx
  obtain ⟨c20, c21, c22, c23⟩ := knCov_2 hx; obtain ⟨c30, c31, c32, c33⟩ := knCov_3 hx))
  ( (
  have hq := kn_hq a x; have hqb := kn_hqb a x; have hSg := kn_hSg a x; have hDl := kn_hDl M a Q x
  have hsc := kn_hsc x; have hr2 := kn_hr2
  have hq0 : qK a x ≠ 0 := qK_ne_zero (domReg_S hx)
  have hqb0 : qbarK a x ≠ 0 := qbarK_ne_zero (domReg_S hx)
  have hs0 := kn_hs0 hx
  have hSg0 : ((Sig a (x 1) (x 2) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (domReg_S hx)
  have hDl0 : ((Del M a Q (x 1) : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (domReg_D hx)
