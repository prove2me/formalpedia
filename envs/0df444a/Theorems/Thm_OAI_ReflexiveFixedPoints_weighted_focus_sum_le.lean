theorem OAI.ReflexiveFixedPoints.weighted_focus_sum_le {ι : Type*} (s : Finset ι) (w D : ι → ℝ)
    (v : ι) (hv : v ∈ s)
    (hw : ∀ i ∈ s, 0 ≤ w i) (hsum : ∑ i ∈ s, w i = 1)
    (hD : ∀ i ∈ s, i ≠ v → D i ≤ 1) :
    (∑ i ∈ s, w i * D i) ≤ w v * D v + (1 - w v) := by sorry
