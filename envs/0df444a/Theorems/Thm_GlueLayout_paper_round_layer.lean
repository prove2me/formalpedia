variable {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]
variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)
variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ)

theorem GlueLayout.paper_round_layer (hK : 0 < K) (hℓ : 1 ≤ ℓ) {h : ℕ} (hb : bb ℓ K ≤ h)
    (hh : h < bb ℓ K + qq ℓ K * K) (M : M2) {X : Type*} [AddCommMonoid X] [Module ℂ X]
    (xs : List X) :
    selOp (paperSel D ℓ K long hK hℓ h) (tens M) xs =
      selOp (layerSel (2 ^ preA D ℓ K long h) K D (2 ^ sufB D ℓ K h) (rhoOf ℓ K h)
        (rhoOf_lt ℓ K hK h)) (tens M) xs := by sorry
