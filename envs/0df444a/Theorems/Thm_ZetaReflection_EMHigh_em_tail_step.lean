/-! ## M2. The general saw-order-raising step on the tail `[N, ∞)`. -/

theorem ZetaReflection.EMHigh.em_tail_step (k : ℕ) (hk : 1 ≤ k) {s : ℂ} (hs : 0 < s.re) {N : ℕ} (hN : 1 ≤ N) :
    emTail s N k
      = (bernoulli (k + 1) : ℂ) * (-(emC s k * ((N : ℝ) : ℂ) ^ (-s - k))) / (k + 1)
        - emTail s N (k + 1) / (k + 1) := by sorry
