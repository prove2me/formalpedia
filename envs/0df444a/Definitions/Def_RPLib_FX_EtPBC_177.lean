-- ===== S4.Def_RP_EtPBC_A_O2S1 =====
section

/-!
# S4-EtPBC-A, O2 M5 C-split: every class of `H²(P¹, F)` is a sum of one-point MV classes

* `opEt_ext` (maps into `opEt U` are unique), `toOpEt`, `opEtMap`, `freeMap_id`;
* `mvC_shortExact'`: the MV criterion with "surjective onto the fibre of `Z`" instead of "nonempty";
* `locC`, **`locC_shortExact`**: the one-point MV complex `Λ[D ×_P Uo] ⟶ Λ[D] ⊞ Λ[P ∖ z] ⟶ Λ[P]` for an etale `D`
  with one geometric point over `z` and all other points over `Uo` (`Uo ⊆ P ∖ z`);
* `IsLoc Λ F z β` (one-point MV class `ε_loc ∘ κ`), `locSpan Λ F` (the subgroup they generate);
* `exists_good_one`, **`split_step`** (a class dying on `U` differs from a one-point class at `z ∉ U` by a class
  dying on `U ∪ {z}`), **`mem_locSpan_of_dies`** (induction on `#(P ∖ U)`), **`mem_locSpan_P1`**:
  `H²(P¹, F) = locSpan` (with `claimD`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech RamanujanPetersson.EtCompact.CurveHn RamanujanPetersson.EtPBC.GenGeo

universe u

section Gen

end Gen

section P1

variable (k : Type) [Field k] [IsAlgClosed k] {Λ : Type} [CommRing Λ]
  (l : ℕ) [Fact l.Prime] (hl : (l : k) ≠ 0) (m : ℕ) (hΛ : ((l ^ m : ℕ) : Λ) = 0)

include hl hΛ

/-- **C-split on `P¹`**: `H²(P¹, F)` is generated by one-point MV classes. -/
theorem mem_locSpan_P1 (F : EtSh Λ (P1 k)) (β : Ext (freeSh Λ (etId (P1 k))) F 2) : β ∈ locSpan Λ F := by
  obtain ⟨f, hf0, hf⟩ := claimD k l hl m hΛ F β
  exact mem_locSpan_of_dies F _ (U' k f) β rfl (finite_compl_U' k f hf0)
    (fun x hx => isClosed_of_not_mem_U' k f hf0 x hx)
    (fun x hx => P1.gal_closed k x (isClosed_of_not_mem_U' k f hf0 x hx)) hf

end P1

end RamanujanPetersson.EtPBC.EtMV

end

end

-- ===== S4.Def_RP_EtPBC_A_O2T5 =====
section

/-!
# S4-EtPBC-A, O2 S5e: splitting off finitely many disjoint sections

* `secLiftOI g σ h`: a section `σ` of `N` lifted through an open immersion `g : R ⟶ N` containing its range;
* **`clsD_splitAll`**: for sections `σ i` (`i ∈ S`, a finset) of a separated etale `N` over `D = Spec B` with
  pairwise disjoint ranges, `clsD f Y` is a sum of section summands `clsD (Λ[σ i] ≫ f) Y'` plus one residual
  summand `clsD (Λ[g] ≫ f) Y_R` through an open immersion `g : R ⟶ N` missing every range `σ i`, `i ∈ S`;
  `R` is affine when `N` is (`isAffine_opn_secV`: section ranges are clopen).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.GalTrE RamanujanPetersson.EtPBC.GenAlg RamanujanPetersson.EtCompact.Cech
  RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.FreeStk

universe u

section LiftOI

end LiftOI

section Aff

end Aff

section SplitAll

variable {k : Type} [Field k] {Λ : Type} [CommRing Λ] {P : Scheme.{0}} (c : A1 k ⟶ P) [IsOpenImmersion c]
  {B : CommRingCat.{0}} (φ : CommRingCat.of k[X] ⟶ B) [Etale (Spec.map φ ≫ c)] (a : k)
  {Uz : P.Opens} (hUz : ∀ u : Spec B, (chEt c φ).hom u ∈ Uz ↔ φ.hom (X - C a) ∉ u.asIdeal)
  (hS : (locC Λ (chEt c φ) (le_refl Uz)).ShortExact)

set_option backward.isDefEq.respectTransparency false in
/-- **Splitting off finitely many disjoint sections.** -/
theorem clsD_splitAll {F : EtSh Λ P} {N : (chEt c φ).left.Etale} [IsSeparated N.hom] {ι : Type}
    [DecidableEq ι] (σ : ι → (etId (chEt c φ).left ⟶ N))
    (hd : ∀ i j, i ≠ j → Disjoint (Set.range (σ i).left) (Set.range (σ j).left))
    (f : freeSh Λ N ⟶ (res (chEt c φ).hom Λ).obj F) (Y : H Λ ((res (toD1 c φ a).left Λ).obj (freeSh Λ N)) 1)
    (S : Finset ι) :
    ∃ (R : (chEt c φ).left.Etale) (g : R ⟶ N) (_ : IsOpenImmersion g.left) (_ : IsSeparated R.hom)
      (_ : IsAffine N.left → IsAffine R.left) (YR : H Λ ((res (toD1 c φ a).left Λ).obj (freeSh Λ R)) 1),
      (∀ r, ∀ i ∈ S, g.left r ∉ Set.range (σ i).left) ∧
      (∀ i, i ∉ S → Set.range (σ i).left ⊆ Set.range g.left) ∧
      clsD c φ a hUz hS f Y - clsD c φ a hUz hS (freeMap Λ g ≫ f) YR ∈
        AddSubgroup.closure {x | ∃ i ∈ S, ∃ Y' : H Λ ((res (toD1 c φ a).left Λ).obj
          (freeSh Λ (etId (chEt c φ).left))) 1, x = clsD c φ a hUz hS (freeMap Λ (σ i) ≫ f) Y'} := by
  induction S using Finset.induction_on with
  | empty =>
    refine ⟨N, 𝟙 N, ?_, inferInstance, id, Y, fun r i hi => absurd hi (Finset.notMem_empty i),
      fun i _ x _ => ?_, ?_⟩
    · show IsOpenImmersion (𝟙 N.left)
      infer_instance
    · first
      | exact ⟨x, rfl⟩
      | exact ⟨x, by simp⟩
    · rw [freeMap_id, Category.id_comp, sub_self]
      exact zero_mem _
  | insert i S hiS ih =>
    obtain ⟨R, g, hg, hR, hRa, YR, h1, h2, h3⟩ := ih
    have := hg
    have := hR
    have hσ := h2 i hiS
    have hτ : secLiftOI g (σ i) hσ ≫ g = σ i := secLiftOI_comp g (σ i) hσ
    set τ := secLiftOI g (σ i) hσ with hτdef
    have ginj : Function.Injective g.left := g.left.isOpenEmbedding.injective
    have hcomp : ∀ r : (opn R (secV τ)).left,
        (opnι R (secV τ) ≫ g).left r = g.left ((opnι R (secV τ)).left r) := fun r => by
      rw [MorphismProperty.Comma.comp_left, Scheme.Hom.comp_apply]
    refine ⟨opn R (secV τ), opnι R (secV τ) ≫ g, ?_, inferInstance,
      fun hN => (have := hRa hN; isAffine_opn_secV τ), YR.comp (Ext.mk₀ ((res (toD1 c φ a).left Λ).map ((secSplitIso Λ τ).inv ≫ biprod.snd))) (add_zero 1),
      ?_, ?_, ?_⟩
    · show IsOpenImmersion ((secV τ).ι ≫ g.left)
      infer_instance
    · intro r j hj hr
      rw [hcomp] at hr
      rcases Finset.mem_insert.1 hj with rfl | hjS
      · obtain ⟨x, hx⟩ := hr
        have e : g.left (τ.left x) = g.left ((opnι R (secV τ)).left r) := by
          rw [← hx, ← hτ, MorphismProperty.Comma.comp_left, Scheme.Hom.comp_apply]
        have hm : (opnι R (secV τ)).left r ∉ Set.range τ.left := opnι_mem R (secV τ) r
        exact hm ⟨x, ginj e⟩
      · exact h1 _ j hjS hr
    · intro j hj p hp
      have hji : j ≠ i := fun e => hj (e ▸ Finset.mem_insert_self i S)
      have hjS : j ∉ S := fun e => hj (Finset.mem_insert_of_mem e)
      obtain ⟨y, hy⟩ := h2 j hjS hp
      have hyV : y ∈ secV τ := by
        rintro ⟨x, hx⟩
        have hpi : p ∈ Set.range (σ i).left := ⟨x, by
          rw [← hτ, MorphismProperty.Comma.comp_left, Scheme.Hom.comp_apply, hx, hy]⟩
        exact Set.disjoint_left.1 (hd i j hji.symm) hpi hp
      refine ⟨(⟨y, hyV⟩ : secV τ), ?_⟩
      rw [hcomp]
      exact hy
    · have hsplit := clsD_secSplit c φ a hUz hS τ (freeMap Λ g ≫ f) YR
      have e1 : freeMap Λ τ ≫ freeMap Λ g ≫ f = freeMap Λ (σ i) ≫ f := by
        rw [← Category.assoc, ← freeMap_comp, hτ]
      have e2 : freeMap Λ (opnι R (secV τ) ≫ g) ≫ f = freeMap Λ (opnι R (secV τ)) ≫ freeMap Λ g ≫ f := by
        rw [freeMap_comp, Category.assoc]
      rw [e1] at hsplit
      rw [e2]
      have hmono := AddSubgroup.closure_mono (G := Ext.{0} (freeSh Λ (etId P)) F 2)
        (h := {x | ∃ i ∈ S, ∃ Y' : H Λ ((res (toD1 c φ a).left Λ).obj
          (freeSh Λ (etId (chEt c φ).left))) 1, x = clsD c φ a hUz hS (freeMap Λ (σ i) ≫ f) Y'})
        (k := {x | ∃ i' ∈ insert i S, ∃ Y' : H Λ ((res (toD1 c φ a).left Λ).obj
          (freeSh Λ (etId (chEt c φ).left))) 1, x = clsD c φ a hUz hS (freeMap Λ (σ i') ≫ f) Y'})
        (by rintro x ⟨j, hj, Y', hx⟩; exact ⟨j, Finset.mem_insert_of_mem hj, Y', hx⟩)
      have hgen : clsD c φ a hUz hS (freeMap Λ (σ i) ≫ f)
          (YR.comp (Ext.mk₀ ((res (toD1 c φ a).left Λ).map ((secSplitIso Λ τ).inv ≫ biprod.fst))) (add_zero 1)) ∈
          AddSubgroup.closure {x | ∃ i' ∈ insert i S, ∃ Y' : H Λ ((res (toD1 c φ a).left Λ).obj
            (freeSh Λ (etId (chEt c φ).left))) 1, x = clsD c φ a hUz hS (freeMap Λ (σ i') ≫ f) Y'} :=
        AddSubgroup.subset_closure ⟨i, Finset.mem_insert_self i S, _, rfl⟩
      have hsum := add_mem (hmono h3) hgen
      convert hsum using 1
      rw [hsplit]
      abel

end SplitAll

end RamanujanPetersson.EtPBC.EtMV

end

end


