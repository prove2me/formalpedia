    exact kfun_mono hqc.continuousOn hq'c.continuousOn hle ⟨hx.1, hx.2.trans h1Ra⟩

/-- **Order reversal**: a pointwise larger source gives a pointwise smaller potential. -/
theorem bfun_anti {j j' : ℝ} {q q' : ℝ → ℝ} {Aq Aq' : ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq'c : ContDiffOn ℝ 1 q' UG) (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq)
