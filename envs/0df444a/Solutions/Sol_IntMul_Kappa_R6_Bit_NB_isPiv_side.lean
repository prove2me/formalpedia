lemma sum_sub {p : Fin m → Prop} [DecidablePred p] (f : Fin m → K) (hf : ∀ a, ¬ p a → f a = 0) :
    ∑ a, f a = ∑ a : {a // p a}, f a.1 := by
  rw [← Finset.sum_subtype (univ.filter p) (by simp) f, Finset.sum_filter]
  refine Finset.sum_congr rfl fun a _ => ?_
  split_ifs with h
  · rfl
  · exact hf a h

