theorem solution
    (p : ℕ) [Fact p.Prime] (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (hqp : q ≠ p)
    (Aq : ValuationSubring (AlgebraicClosure ℚ)) (_hAq : Aq.LiesOverPrime q) :
    letI := heckeModuleBar p
    ∀ k M : ℕ, ∀ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
      (∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (q ^ k) = 1 → σ ζ = ζ ^ n σ) →
      heckeTorsion (JZero p)
          (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ (M + 1)) =
        heckeTorsion (JZero p)
          (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M) →
      (Ideal.span {((q : ℕ) ^ k : ↥(heckeLatticeAlgebra p ∅))} ⊔
          (Ideal.map ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2))
            (eisensteinMaximalIdeal p q)) ^ (M + 1)) =
        (Ideal.span {((q : ℕ) ^ k : ↥(heckeLatticeAlgebra p ∅))} ⊔
          (Ideal.map ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2))
            (eisensteinMaximalIdeal p q)) ^ M) →
      ∃ e₀ : ↥(heckeTorsion (JZero p)
              (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M)) →
            (AlgebraicClosure ℚ)ˣ,
        (∀ v₁ v₂, e₀ (v₁ + v₂) = e₀ v₁ * e₀ v₂) ∧
        (∀ v : ↥(heckeTorsion (JZero p)
              (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M)),
          (∀ σ ∈ Aq.inertiaSubgroupIn ℚ,
            σ • (v : JZero p) = n σ • (v : JZero p)) → e₀ v = 1) ∧
        (∀ v, (∀ t : HeckeAlg, e₀ (t • v) = 1) →
          ∀ σ ∈ Aq.inertiaSubgroupIn ℚ, σ • (v : JZero p) = n σ • (v : JZero p)) := by
  letI := heckeModuleBar p
  haveI hNZp : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  haveI : SMulCommClass (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) HeckeAlg (JZero p) :=
    ModularCurve.smulCommClass_JZero_of_heckeOperatorsCommuteBar p
      (ModularCurve.heckeOperatorsCommuteBar p)
  intro k M n hn hM hM'

  let V₀ : Submodule HeckeAlg (JZero p) :=
    { carrier := {x | ∀ σ ∈ Aq.inertiaSubgroupIn ℚ, σ • x = n σ • x}
      add_mem' := fun {a b} ha hb σ hσ =>
        (smul_add σ a b).trans
          (((congrArg₂ (· + ·) (ha σ hσ) (hb σ hσ))).trans (smul_add (n σ) a b).symm)
      zero_mem' := fun σ _ => (smul_zero σ).trans (smul_zero (n σ)).symm
      smul_mem' := fun t y hy σ hσ => by
        rw [smul_comm σ t y, hy σ hσ]
        exact (smul_comm (n σ) t y).symm }
  have hV₀mem : ∀ x : JZero p,
      x ∈ V₀ ↔ ∀ σ ∈ Aq.inertiaSubgroupIn ℚ, σ • x = n σ • x := fun x => Iff.rfl

  have hFin : Finite ↥(heckeTorsion (JZero p)
      (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M)) :=
    ModularCurve.heckeTorsion_jZero_finite_of_natCast_mem p _ (q ^ k)
      (pow_pos (Fact.out : q.Prime).pos k)
      (by rw [Nat.cast_pow]; exact Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))

  have hnil : ∀ g ∈ (eisensteinMaximalIdeal p q) ^ M,
      ∀ v ∈ heckeTorsion (JZero p)
        (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M),
      g • v = 0 := fun g hg v hv =>
    ((mem_heckeTorsion_iff _ _ _).mp hv) g (Ideal.mem_sup_right hg)

  have hq𝔓 : (q : HeckeAlg) ∈ eisensteinMaximalIdeal p q :=
    natCast_mem_eisensteinMaximalIdeal p q

  obtain ⟨y₀, hy₀V, hy₀soc, hgen⟩ :=
    ModularCurve.exists_nsmul_generator_heckeTorsion_span_sup_of_inertia_smul_eisensteinMaximalIdeal_smul_eq_nsmul_of_ne_two
      p q hq2 hqp Aq _hAq k M n hn hM hM'

  obtain ⟨e₀, h1, h2, h3⟩ :=
    Cyc3Engine.exists_char
      (heckeTorsion (JZero p)
        (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M))
      V₀ hFin (eisensteinMaximalIdeal p q) M hnil q Fact.out hq𝔓
      y₀ hy₀V
      (fun g hg => (hV₀mem _).mpr (hy₀soc g hg))
      (fun y hyV hys =>
        (hgen y hyV (fun g hg => (hV₀mem _).mp (hys g hg))).imp
          (fun m hm => (hV₀mem _).mpr hm))
  exact ⟨e₀, h1, fun v hv => h2 v ((hV₀mem _).mpr hv), fun v hv => (hV₀mem _).mp (h3 v hv)⟩

end S_ModularCurve_exists_character_generator_heckeTorsion_span_sup_inertiaSubgroupIn_of_ne_two
end P2MW
