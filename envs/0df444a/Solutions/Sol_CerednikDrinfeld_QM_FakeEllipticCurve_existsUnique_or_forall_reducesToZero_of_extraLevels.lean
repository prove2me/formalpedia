section RedHom
variable (O : ValuationSubring (AlgebraicClosure ℚ))
    (𝒜 : FakeEllipticCurve Λ N ↥O) (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ))
    (Abar : FakeEllipticCurve Λ N (IsLocalRing.ResidueField ↥O))
    (gE : E.A ⟶ 𝒜.A) (hgE : CategoryTheory.IsPullback gE E.f 𝒜.f (Spec.map (CommRingCat.ofHom O.subtype)))
    (hgE_mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (P Q : SchemeHomOver t' E.f),
      (E.L.mul t' P Q).1 ≫ gE =
        (𝒜.L.mul (t' ≫ Spec.map (CommRingCat.ofHom O.subtype))
          ⟨P.1 ≫ gE, by rw [Category.assoc, hgE.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ gE, by rw [Category.assoc, hgE.w, ← Category.assoc, Q.2]⟩).1)
    (hgE_act : ∀ x : ↥Λ, E.act x ≫ gE = gE ≫ 𝒜.act x)
    (gbar : Abar.A ⟶ 𝒜.A)
    (hgbar : CategoryTheory.IsPullback gbar Abar.f 𝒜.f (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O))))
    (hgbar_mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (IsLocalRing.ResidueField ↥O))) (P Q : SchemeHomOver t' Abar.f),
      (Abar.L.mul t' P Q).1 ≫ gbar =
        (𝒜.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)))
          ⟨P.1 ≫ gbar, by rw [Category.assoc, hgbar.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ gbar, by rw [Category.assoc, hgbar.w, ← Category.assoc, Q.2]⟩).1)
    (hgbar_act : ∀ x : ↥Λ, Abar.act x ≫ gbar = gbar ≫ 𝒜.act x)

theorem mul_comp_eq {B : Scheme.{0}} (ψ : B ⟶ Spec (CommRingCat.of ↥O))
    (xt yt : SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥O))) 𝒜.f) :
    ψ ≫ (𝒜.L.mul (𝟙 _) xt yt).1 =
      (𝒜.L.mul (𝟙 B ≫ ψ) ⟨ψ ≫ xt.1, by rw [Category.assoc, xt.2, Category.id_comp, Category.comp_id]⟩
        ⟨ψ ≫ yt.1, by rw [Category.assoc, yt.2, Category.id_comp, Category.comp_id]⟩).1 := by
  have h := 𝒜.L.mul_natural (𝟙 _) (𝟙 B ≫ ψ) ψ (by rw [Category.comp_id, Category.id_comp]) xt yt
  exact congrArg Subtype.val h

include hgE_mul in

theorem lift_mul (x y : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f) :
    lift O 𝒜 E gE hgE (E.L.mul (𝟙 _) x y) = 𝒜.L.mul (𝟙 _) (lift O 𝒜 E gE hgE x) (lift O 𝒜 E gE hgE y) := by
  symm
  apply lift_unique
  rw [mul_comp_eq O 𝒜 (Spec.map (CommRingCat.ofHom O.subtype)), hgE_mul]
  have hx : (⟨Spec.map (CommRingCat.ofHom O.subtype) ≫ (lift O 𝒜 E gE hgE x).1, by
        rw [Category.assoc, (lift O 𝒜 E gE hgE x).2, Category.id_comp, Category.comp_id]⟩ :
        SchemeHomOver (𝟙 _ ≫ Spec.map (CommRingCat.ofHom O.subtype)) 𝒜.f) =
      ⟨x.1 ≫ gE, by rw [Category.assoc, hgE.w, ← Category.assoc, x.2]⟩ := Subtype.ext (lift_spec O 𝒜 E gE hgE x)
  have hy : (⟨Spec.map (CommRingCat.ofHom O.subtype) ≫ (lift O 𝒜 E gE hgE y).1, by
        rw [Category.assoc, (lift O 𝒜 E gE hgE y).2, Category.id_comp, Category.comp_id]⟩ :
        SchemeHomOver (𝟙 _ ≫ Spec.map (CommRingCat.ofHom O.subtype)) 𝒜.f) =
      ⟨y.1 ≫ gE, by rw [Category.assoc, hgE.w, ← Category.assoc, y.2]⟩ := Subtype.ext (lift_spec O 𝒜 E gE hgE y)
  rw [hx, hy]

include hgE_mul hgbar_mul in

theorem red_mul (x y : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f) :
    red O 𝒜 E Abar gE hgE gbar hgbar (E.L.mul (𝟙 _) x y) =
      Abar.L.mul (𝟙 _) (red O 𝒜 E Abar gE hgE gbar hgbar x) (red O 𝒜 E Abar gE hgE gbar hgbar y) := by
  apply eq_of_comp_gbar_eq O 𝒜 Abar gbar hgbar
  rw [red, redOf_comp, lift_mul O 𝒜 E gE hgE hgE_mul, hgbar_mul,
    mul_comp_eq O 𝒜 (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)))]
  have hx : (⟨Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)) ≫ (lift O 𝒜 E gE hgE x).1, by
        rw [Category.assoc, (lift O 𝒜 E gE hgE x).2, Category.id_comp, Category.comp_id]⟩ :
        SchemeHomOver (𝟙 _ ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O))) 𝒜.f) =
      ⟨(red O 𝒜 E Abar gE hgE gbar hgbar x).1 ≫ gbar, by rw [Category.assoc, hgbar.w, ← Category.assoc, (red O 𝒜 E Abar gE hgE gbar hgbar x).2]⟩ :=
    Subtype.ext (redOf_comp O 𝒜 Abar gbar hgbar _).symm
  have hy : (⟨Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)) ≫ (lift O 𝒜 E gE hgE y).1, by
        rw [Category.assoc, (lift O 𝒜 E gE hgE y).2, Category.id_comp, Category.comp_id]⟩ :
        SchemeHomOver (𝟙 _ ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O))) 𝒜.f) =
      ⟨(red O 𝒜 E Abar gE hgE gbar hgbar y).1 ≫ gbar, by rw [Category.assoc, hgbar.w, ← Category.assoc, (red O 𝒜 E Abar gE hgE gbar hgbar y).2]⟩ :=
    Subtype.ext (redOf_comp O 𝒜 Abar gbar hgbar _).symm
  rw [hx, hy]

include hgE_act in

theorem lift_act (m : ↥Λ) (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f) :
    lift O 𝒜 E gE hgE (pushPt (E.act m) (E.act_over m) x) = pushPt (𝒜.act m) (𝒜.act_over m) (lift O 𝒜 E gE hgE x) := by
  symm
  apply lift_unique
  show Spec.map (CommRingCat.ofHom O.subtype) ≫ ((lift O 𝒜 E gE hgE x).1 ≫ 𝒜.act m) = (x.1 ≫ E.act m) ≫ gE
  rw [← Category.assoc, lift_spec, Category.assoc, Category.assoc, hgE_act]

include hgE_act hgbar_act in

theorem red_act (m : ↥Λ) (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f) :
    red O 𝒜 E Abar gE hgE gbar hgbar (pushPt (E.act m) (E.act_over m) x) =
      pushPt (Abar.act m) (Abar.act_over m) (red O 𝒜 E Abar gE hgE gbar hgbar x) := by
  apply eq_of_comp_gbar_eq O 𝒜 Abar gbar hgbar
  rw [red, redOf_comp, lift_act O 𝒜 E gE hgE hgE_act]
  show Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)) ≫ ((lift O 𝒜 E gE hgE x).1 ≫ 𝒜.act m) =
    ((red O 𝒜 E Abar gE hgE gbar hgbar x).1 ≫ Abar.act m) ≫ gbar
  rw [Category.assoc, hgbar_act, ← Category.assoc, ← Category.assoc, red, redOf_comp]

include hgE_mul hgbar_mul in

theorem red_one : red O 𝒜 E Abar gE hgE gbar hgbar (E.L.one (𝟙 _)) = Abar.L.one (𝟙 _) := by
  have h := red_mul O 𝒜 E Abar gE hgE hgE_mul gbar hgbar hgbar_mul (E.L.one (𝟙 _)) (E.L.one (𝟙 _))
  rw [E.L.one_mul] at h
  letI := Abar.L.pointGroup (𝟙 (Spec (CommRingCat.of (IsLocalRing.ResidueField ↥O))))
  have h' : red O 𝒜 E Abar gE hgE gbar hgbar (E.L.one (𝟙 _)) * red O 𝒜 E Abar gE hgE gbar hgbar (E.L.one (𝟙 _)) =
      red O 𝒜 E Abar gE hgE gbar hgbar (E.L.one (𝟙 _)) := h.symm
  have h'' : red O 𝒜 E Abar gE hgE gbar hgbar (E.L.one (𝟙 _)) * red O 𝒜 E Abar gE hgE gbar hgbar (E.L.one (𝟙 _)) =
      red O 𝒜 E Abar gE hgE gbar hgbar (E.L.one (𝟙 _)) * 1 := by rw [mul_one]; exact h'
  exact mul_left_cancel h''

