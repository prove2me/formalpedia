set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

noncomputable section

namespace J6Seg.Side

open IntMul NLogN IntMul.Kappa.R6 J6Seg

theorem fmB_FB (n : ℕ) : NLogN.KFM.fmB n ≤ FB * (n + 3) ^ 6 := NLogN.KFV.P18M.fmB_le n

theorem pow_le_X10 {X k : ℕ} (hX : 1 ≤ X) (hk : k ≤ 10) : X ^ k ≤ X ^ 10 :=
  Nat.pow_le_pow_right hX hk

/-- `Ut p α ≤ CUt · X^10` when `p ≤ X`, `α² ≤ p`. -/
theorem Ut_le_X_sol_aux {p α X : ℕ} (hX : 1 ≤ X) (hp : p ≤ X) (hα : α ^ 2 ≤ p) :
    J6Seg.Src.uC (4 * p) J6Seg.Src.DD + J6Seg.Src.ePC (4 * p) p α + NLogN.KFUU.cU (4 * p + 1) +
      20000 ≤ CUt * X ^ 10 := by
  have h1 : J6Seg.Src.uC (4 * p) J6Seg.Src.DD ≤ 10 ^ 7 * 67 ^ 2 * X ^ 10 := by
    unfold J6Seg.Src.uC J6Seg.Src.DD
    have a : 4 * p * 16 + 3 ≤ 67 * X := by omega
    have b := Nat.pow_le_pow_left a 2
    have c := pow_le_X10 hX (show 2 ≤ 10 by norm_num)
    calc 10 ^ 7 * (4 * p * 16 + 3) ^ 2 ≤ 10 ^ 7 * (67 * X) ^ 2 := Nat.mul_le_mul_left _ b
      _ = 10 ^ 7 * 67 ^ 2 * X ^ 2 := by ring
      _ ≤ 10 ^ 7 * 67 ^ 2 * X ^ 10 := Nat.mul_le_mul_left _ c
  have h2 : J6Seg.Src.ePC (4 * p) p α ≤ 10 ^ 35 * 161 ^ 10 * X ^ 10 := by
    unfold J6Seg.Src.ePC J6Seg.Src.DD expPosCost
    have a : p + (4 * p * 16 + 1) + (4 * p * 16 + 1) + (2 * α ^ 2 - 2) + 30 ≤ 161 * X := by
      omega
    have b := Nat.pow_le_pow_left a 10
    calc 10 ^ 35 * (p + (4 * p * 16 + 1) + (4 * p * 16 + 1) + (2 * α ^ 2 - 2) + 30) ^ 10
        ≤ 10 ^ 35 * (161 * X) ^ 10 := Nat.mul_le_mul_left _ b
      _ = 10 ^ 35 * 161 ^ 10 * X ^ 10 := by ring
  have h3 : NLogN.KFUU.cU (4 * p + 1) ≤
      (6 * 10 ^ 4 + FB * 13 ^ 6) * X ^ 10 := by
    unfold NLogN.KFUU.cU
    have f := fmB_FB (2 * (4 * p + 1))
    have a : 2 * (4 * p + 1) + 3 ≤ 13 * X := by omega
    have b := Nat.pow_le_pow_left a 6
    have c6 := pow_le_X10 hX (show 6 ≤ 10 by norm_num)
    have c1 := pow_le_X10 hX (show 1 ≤ 10 by norm_num)
    have e1 : 10 ^ 4 * (4 * p + 1 + 1) ≤ 6 * 10 ^ 4 * X ^ 10 := by
      rw [pow_one] at c1; omega
    have e2 : KFM.fmB (2 * (4 * p + 1)) ≤ FB * 13 ^ 6 * X ^ 10 :=
      calc _ ≤ FB * (2 * (4 * p + 1) + 3) ^ 6 := f
        _ ≤ FB * (13 * X) ^ 6 := Nat.mul_le_mul_left _ b
        _ = FB * 13 ^ 6 * X ^ 6 := by ring
        _ ≤ FB * 13 ^ 6 * X ^ 10 := Nat.mul_le_mul_left _ c6
    calc 10 ^ 4 * (4 * p + 1 + 1) + KFM.fmB (2 * (4 * p + 1))
        ≤ 6 * 10 ^ 4 * X ^ 10 + FB * 13 ^ 6 * X ^ 10 := Nat.add_le_add e1 e2
      _ = _ := by ring
  have h4 : 20000 ≤ 20000 * X ^ 10 := Nat.le_mul_of_pos_right _ (Nat.one_le_pow _ _ hX)
  calc _ ≤ 10 ^ 7 * 67 ^ 2 * X ^ 10 + 10 ^ 35 * 161 ^ 10 * X ^ 10 +
        (6 * 10 ^ 4 + FB * 13 ^ 6) * X ^ 10 + 20000 * X ^ 10 :=
        Nat.add_le_add (Nat.add_le_add (Nat.add_le_add h1 h2) h3) h4
    _ = CUt * X ^ 10 := by unfold CUt; ring

end J6Seg.Side
end

