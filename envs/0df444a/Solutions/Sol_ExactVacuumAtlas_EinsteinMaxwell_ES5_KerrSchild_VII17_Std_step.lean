-- ==== solution ====
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII17
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII17.Std
open Filter Set Topology ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Compact
open scoped ContDiff
variable {h Q J f₁ b₁ a₁ : ℝ} {F b A : ℝ → ℝ} (S : Std h Q J f₁ b₁ a₁ F b A)
include S
theorem solution (k : ℕ) (H : Std.Inv (h := h) (f₁ := f₁) (a₁ := a₁) (F := F) (b := b) (A := A) k) :
    Std.Inv (h := h) (f₁ := f₁) (a₁ := a₁) (F := F) (b := b) (A := A) (k + 1) := by
  obtain ⟨eF, eb, eZ, eV, eW, eD⟩ := H
  -- Hadamard quotients (lose one order)
  obtain ⟨L₁, eP₁⟩ := hadamard' (k := k) ((S.cF.div S.cb S.eb).sub PS.const)
    (((eF.div eb one_ne_zero).sub (ExtV.const (c := (1:ℝ)))).val (by norm_num))
  obtain ⟨L₂, eP₂⟩ := hadamard' (k := k) ((PS.const.div S.cb S.eb).sub PS.const)
    ((((ExtV.const (c := (1:ℝ))).div eb one_ne_zero).sub (ExtV.const (c := (1:ℝ)))).val
      (by norm_num))
  obtain ⟨L₃, eP₃⟩ := hadamard' (k := k) (S.cF.sub PS.const)
    ((eF.sub (ExtV.const (c := (1:ℝ)))).val (by norm_num))
  -- S = V + W: primitive gain
  obtain ⟨_, eSd⟩ := compS (h := h) (Q := Q) (J := J) eF.mono eb.mono eV eW eP₁ eP₂
  have eS : ExtV (k + 1) (fun x => Vf A x + Wf b A x) (a₁ + a₁) :=
    extV_succ (S.psV.add S.psW) (eSd.congr S.sder).RL (eV.add eW).tendsto
  -- T = V - W: Euler gain
  obtain ⟨_, eHT⟩ := compT (h := h) (Q := Q) (J := J) eF.mono eb.mono eV eW eP₁ eP₂
  have tT : Tendsto (fun x => Vf A x - Wf b A x) (𝓝[>] (0:ℝ)) (𝓝 0) := by
    simpa using (eV.sub eW).tendsto
  have eT : ExtV (k + 1) (fun x => Vf A x - Wf b A x) 0 :=
    euler_gain (S.psV.sub S.psW) tT S.tder eHT
  have eV' : ExtV (k + 1) (Vf A) a₁ :=
    (((eS.add eT).div (ExtV.const (c := (2:ℝ))) two_ne_zero).val (by ring)).congr
      (Eventually.of_forall fun x => by dsimp only; ring)
  have eW' : ExtV (k + 1) (Wf b A) a₁ :=
    (((eS.sub eT).div (ExtV.const (c := (2:ℝ))) two_ne_zero).val (by ring)).congr
      (Eventually.of_forall fun x => by dsimp only; ring)
  -- D: Euler gain
  have er : ExtV k (rf b) (b₁ / 1) := (extV_deriv S.cb eb S.db).div eb.mono one_ne_zero
  obtain ⟨_, eHD⟩ := compD (h := h) (Q := Q) (J := J) eF.mono eb.mono eZ.mono eV eW eD er eP₃
  have tD : Tendsto (fun x => Df F b x + h) (𝓝[>] (0:ℝ)) (𝓝 0) := by
    simpa using eD.tendsto.add_const h
  have eDh : ExtV (k + 1) (fun x => Df F b x + h) 0 :=
    euler_gain (S.psD.add PS.const) tD S.dder eHD
  have eD' : ExtV (k + 1) (Df F b) (-h) :=
    ((eDh.sub (ExtV.const (c := h))).val (by ring)).congr
      (Eventually.of_forall fun x => by dsimp only; ring)
  -- F, b, Z gain one order
  obtain ⟨_, eR⟩ := compR (h := h) (Q := Q) (J := J) eF eb eZ eV' eW' eD'
  have eb' : ExtV (k + 1 + 1) b 1 := extV_succ S.cb ((eb.mul eR).congr S.bder).RL S.tb
  obtain ⟨_, eFd⟩ := compF (h := h) eF eZ
  have eF' : ExtV (k + 1 + 1) F 1 := extV_succ S.cF (eFd.congr S.fder).RL S.tF
  obtain ⟨_, eZd⟩ := compZ (h := h) (Q := Q) (J := J) eF eb eV' eW'
  have eZ' : ExtV (k + 1 + 1) (Zf h F) f₁ := extV_succ S.psZ (eZd.congr S.zder).RL S.tZ
  exact ⟨eF', eb', eZ', eV', eW', eD'⟩
