  rw [List.take_add_one, List.getElem?_eq_getElem hk]; simp

theorem zsz_two_pow (j : ℕ) : zsz ((2 : ℤ) ^ j) ≤ j + 1 := by
  apply zsz_le_of_lt
  rw [Int.natAbs_pow]; simp only [Int.reduceAbs]
  exact Nat.pow_lt_pow_right (by norm_num) (by omega)

