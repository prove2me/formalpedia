    [MeasurableSingletonClass α] [MeasurableSingletonClass β] [MeasurableSingletonClass γ]
    {X : Ω → α} {Y : Ω → β} {Z : Ω → γ}
    (hX : Measurable X) (hY : Measurable Y) (hZ : Measurable Z)
    (μ : Measure Ω) [IsProbabilityMeasure μ] :
    I[X : Y; μ] + I[X : Z; μ]
      = I[X : ⟨Y, Z⟩; μ] + I[Y : Z; μ] - I[Y : Z | X; μ] := by
