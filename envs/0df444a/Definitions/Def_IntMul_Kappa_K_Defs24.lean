-- Source module: Solutions.KFMSF
/-!
# KFM SF: the line-map and chirp descriptors

* **`descLineP dst`** pushes `descLineN n = [p, α, ℓ−1, d, b_0..b_{d−1}, s_0..s_{d−1}]`
  (`LineNeed`); **`descChirpP dst`** pushes `descChirpN n = K :: descLineN n` (`ChirpNeed`).
* Run (`descLineP_run_n`, `descChirpP_run_n`) and cost (`descLineP_cost_n`,
  `descChirpP_cost_n`, `≤ 2·10^12 (b+1)^3`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS

/-- **The line-map descriptor.** -/
def descLineP (dst : Fin HS) : RS :=
  .seq (NLogN.KFM.srcP dst) (.seq (bitP dst) (.seq (.push dst (.reg zD)) (.seq (.push dst NLogN.KFM.hE)
    (.seq (.push dst (.reg zAl)) (.push dst pE)))))

/-- **The chirp descriptor.** -/
def descChirpP (dst : Fin HS) : RS := .seq (descLineP dst) (.push dst (.reg zK))

/-- Where the descriptor code may write. -/
structure LOk (dst : Fin HS) : Prop where
  d : DstOk dst
  ne : dst ≠ zEl ∧ dst ≠ zAl ∧ dst ≠ NLogN.KFM.zB ∧ dst ≠ zK

/-- The registers the descriptor code reads. -/
structure LRegs (t : IState HS) (n : ℕ) : Prop where
  src : SrcRegs t (dpN n) (srcQ (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n)) (srcM (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n) (IntMul.OpenAI.Glue.rP n / 2))
    (srcM (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n) (IntMul.OpenAI.Glue.rP n))
  hD : ∃ L, t.G zD = .int (IntMul.OpenAI.Glue.dP n : ℤ) :: L
  hEl : ∃ L, t.G zEl = .int (ℓP n : ℤ) :: L
  hAl : ∃ L, t.G zAl = .int (αP n : ℤ) :: L
  hB : ∃ L, t.G NLogN.KFM.zB = .int (bP n : ℤ) :: L
  hK : ∃ L, t.G zK = .int (KP n : ℤ) :: L

end NLogN.KFM

end

