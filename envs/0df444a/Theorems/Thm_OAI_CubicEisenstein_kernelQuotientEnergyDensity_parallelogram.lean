theorem OAI.CubicEisenstein.kernelQuotientEnergyDensity_parallelogram (f g : kernelSmoothTests) (q : KernelQuotient) :
    kernelQuotientEnergyDensity (f+g) q+kernelQuotientEnergyDensity (f-g) q=
      2*(kernelQuotientEnergyDensity f q+kernelQuotientEnergyDensity g q) := by sorry
