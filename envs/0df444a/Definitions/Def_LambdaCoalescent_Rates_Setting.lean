-- title:
--   §§2 and 3.1 — partitions 𝒫_n, 𝒫_∞, restriction R_n, merger generators, coalescent paths, consistency, and the rates λ_{b,k}(Λ)
-- statement:
--   This module fixes the objects shared by every statement drawn from Sections 2 and 3.1 of Pitman's paper.
--
--   1. **Partitions.** For $n\in\mathbb N$, $\mathcal P_n$ is the finite set of partitions of $[n]=\{1,\dots,n\}$, and $\mathcal P_\infty$ is the set of partitions of $\mathbb N=\{1,2,\dots\}$. A partition is identified with its equivalence relation "$i$ and $j$ lie in the same block". $\mathcal P_\infty$ carries the Borel $\sigma$-algebra of the product-discrete topology, which is the $\sigma$-algebra generated by the events $\{i\sim j\}$, equivalently by the restriction maps.
--   2. **Restriction.** For $\pi\in\mathcal P_\infty$, $R_n(\pi)\in\mathcal P_n$ is the restriction of $\pi$ to $[n]$; for $n\le m$ and $\pi\in\mathcal P_m$, $R_n(\pi)$ is likewise its restriction to $[n]$. The number of blocks of $\pi\in\mathcal P_n$ is written $\#\pi$.
--   3. **Mergers and the generator.** A transition $\pi\to\pi'$ in $\mathcal P_n$ is a *merger* if $\pi$ refines $\pi'$, $\pi\ne\pi'$, and exactly one block of $\pi'$ is a union of two or more blocks of $\pi$, every other block of $\pi'$ being a block of $\pi$. Such a merger joins $k=\#\pi-\#\pi'+1$ of the $b=\#\pi$ blocks. Given an array $(\lambda_{b,k})$, the generator $Q_n$ on $\mathcal P_n$ has off-diagonal entries
--   $$
--   Q_n(\pi,\pi')=\begin{cases}\lambda_{\#\pi,\;\#\pi-\#\pi'+1}, & \pi\to\pi' \text{ a merger},\\ 0, & \text{otherwise},\end{cases}
--   \qquad Q_n(\pi,\pi)=-\sum_{\pi'\neq\pi}Q_n(\pi,\pi'),
--   $$
--   so that, when the partition has $b$ blocks, each $k$-tuple of blocks merges into a single block at rate $\lambda_{b,k}$.
--   4. **Coalescent paths.** A path $(p(t),t\ge0)$ in $\mathcal P_\infty$ is a coalescent path if $p(s)$ refines $p(t)$ for $s\le t$ and, for every $n$, the restriction $R_n(p(t))$ is right-continuous with a step at each time (it is constant on some $[t,t+\varepsilon)$).
--   5. **Consistency.** The array $(\lambda_{b,k})$ is *consistent* if for all $n<m$, all $\pi\in\mathcal P_m$, $\sigma\in\mathcal P_n$ and $t\ge0$,
--   $$
--   \sum_{\pi'\in\mathcal P_m:\,R_n(\pi')=\sigma} e^{tQ_m}(\pi,\pi')=e^{tQ_n}\bigl(R_n(\pi),\sigma\bigr),
--   $$
--   that is, $R_n$ of the $m$-chain started at $\pi$ has, at each time, the law of the $n$-chain started at $R_n(\pi)$.
--   6. **Rates from a measure.** For a measure $\Lambda$ on $[0,1]$,
--   $$
--   \lambda_{b,k}(\Lambda)=\int_{[0,1]}x^{k-2}(1-x)^{b-k}\,\Lambda(dx),\qquad 2\le k\le b,
--   $$
--   which is display (1) of Theorem 1.
--
--   These definitions are the common vocabulary of Theorem 1 and Lemma 18 (characterization of the rates of a coalescent with multiple collisions) and of the coagulation–fragmentation results of Section 4, which use the same space $\mathcal P_\infty$ and its $\sigma$-algebra.
--
--   **Formalization Note** The paper numbers labels from $1$; Lean's `Fin n` and `ℕ` number them from $0$ by $i\mapsto i-1$, which preserves the order of labels. $\mathcal P_\infty$ is the type synonym `PInf := Setoid ℕ`, with the $\sigma$-algebra pulled back from the pairwise relation coordinates; each $\mathcal P_n$ is `Setoid (Fin n)`, a finite type with the discrete $\sigma$-algebra and classical decidable equality. Refinement is Mathlib's order on `Setoid` ($\pi\le\pi'$ iff $\pi$ refines $\pi'$). The paper's definition of consistency compares full laws of the processes; the Lean identity compares one-time laws from every initial state, which is equivalent by the Markov property (induct over the time points). The case $n=0$ is allowed; it holds automatically since $\mathcal P_0$ is a single point and the rows of $e^{tQ_m}$ sum to one. The rate function `lamOf` is a Bochner integral over $[0,1]$ against a measure $\Lambda$ on $\mathbb R$; statements using it assume $\Lambda$ finite (so the bounded integrand is integrable) and supported in $[0,1]$, and use it only for $2\le k\le b$, where the natural-number exponents $k-2$ and $b-k$ are exact. Lean's $0^0=1$ is the paper's convention: for $\Lambda=\delta_0$ it gives $\lambda_{b,k}=\mathbf 1(k=2)$. The module imports the companion module defining Markov chains with a given generator through their finite-dimensional laws, so that statements importing this module have both.
-- source:
--   Pitman, Coalescents with multiple collisions, Ann. Probab. 27 (1999), p. 1871, §2; p. 1882, §3.1 and Lemma 18, eq. (1)

import Definitions.Def_LambdaCoalescent_Rates_FiniteChain

namespace LambdaCoalescent.Rates

open MeasureTheory
open scoped BigOperators
open scoped NNReal

/-- The paper's partitions of the positive integers, relabelled by zero-based naturals. -/
def PInf := Setoid ℕ

/-- The Borel sigma algebra generated by finite restrictions, via the pairwise relation coordinates. -/
noncomputable instance : MeasurableSpace PInf :=
  MeasurableSpace.comap
    (fun π : PInf => fun p : ℕ × ℕ => π.r p.1 p.2) inferInstance

/-- Restriction of a partition of naturals to the first `n` labels. -/
def restrict (n : ℕ) (π : PInf) : Setoid (Fin n) := π.comap Fin.val

/-- Restriction of a partition of `Fin m` to `Fin n`. -/
def restrictLE {n m : ℕ} (h : n ≤ m) (π : Setoid (Fin m)) : Setoid (Fin n) :=
  π.comap (Fin.castLE h)

noncomputable instance (n : ℕ) : Finite (Setoid (Fin n)) :=
  Finite.of_injective (fun π : Setoid (Fin n) => π.r) (by
    intro a b h
    cases a with | mk ar are =>
      cases b with | mk br bre =>
        congr)

noncomputable instance (n : ℕ) : Fintype (Setoid (Fin n)) :=
  Fintype.ofFinite (Setoid (Fin n))

noncomputable instance (n : ℕ) : DecidableEq (Setoid (Fin n)) := Classical.decEq _

/-- Every finite partition is a measurable state. -/
instance (n : ℕ) : MeasurableSpace (Setoid (Fin n)) := ⊤

/-- Number of blocks of a finite partition. -/
noncomputable def numBlocks {n : ℕ} (π : Setoid (Fin n)) : ℕ :=
  by
    classical
    exact Fintype.card (Quotient π)

/-- Exactly one group of at least two blocks is merged. -/
def IsMerge {n : ℕ} (π π' : Setoid (Fin n)) : Prop :=
  π ≤ π' ∧ π ≠ π' ∧
    ∀ i j i' j', π'.r i j → ¬ π.r i j → π'.r i' j' → ¬ π.r i' j' → π'.r i i'

/-- Generator of the finite coalescent on partitions of `Fin n`. -/
noncomputable def rateMatrix (lam : ℕ → ℕ → ℝ) (n : ℕ) :
    Matrix (Setoid (Fin n)) (Setoid (Fin n)) ℝ :=
  by
  classical
  let off : Setoid (Fin n) → Setoid (Fin n) → ℝ :=
    fun π π' => if IsMerge π π' then lam (numBlocks π) (numBlocks π - numBlocks π' + 1) else 0
  exact fun π π' => if π = π' then -(∑ τ : Setoid (Fin n), if τ = π then 0 else off π τ) else off π π'

/-- Refining paths with right-continuous finite restrictions. -/
def IsCoalescentPath (p : ℝ≥0 → PInf) : Prop :=
  (∀ (s t : ℝ≥0), s ≤ t → ∀ i j, (p s).r i j → (p t).r i j) ∧
  ∀ (n : ℕ) (t : ℝ≥0), ∃ ε : ℝ≥0, 0 < ε ∧
    ∀ (u : ℝ≥0), t ≤ u → u < t + ε → restrict n (p u) = restrict n (p t)

/-- Semigroup consistency of all finite partition chains. -/
def Consistent (lam : ℕ → ℕ → ℝ) : Prop :=
  ∀ n m (h : n < m) (π : Setoid (Fin m)) (σ : Setoid (Fin n)) (t : ℝ), 0 ≤ t →
    (∑ π' : Setoid (Fin m),
      if restrictLE h.le π' = σ then
        NormedSpace.exp (t • rateMatrix lam m) π π' else 0) =
    NormedSpace.exp (t • rateMatrix lam n) (restrictLE h.le π) σ

/-- The paper's rate array obtained from a measure on `[0,1]`. -/
noncomputable def lamOf (Λ : Measure ℝ) (b k : ℕ) : ℝ :=
  ∫ x in Set.Icc (0 : ℝ) 1, x ^ (k - 2) * (1 - x) ^ (b - k) ∂Λ

end LambdaCoalescent.Rates


