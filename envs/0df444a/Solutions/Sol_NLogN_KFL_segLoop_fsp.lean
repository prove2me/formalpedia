theorem cost_lit (t : IState HS) (c : ℤ) : (Ex.lit (S := HS) c).cost t = zsz c + 2 := rfl

theorem cRep_le {N Bb : ℕ} (h : zsz (N : ℤ) ≤ Bb) : cRep N ≤ 400 * (Bb + 2) + 1100 * N + 400 := by
  unfold cRep; omega

/-- Fine counted loop with a literal count. -/
theorem FSp.repLit {C : Fin HS} {b : RS} {s : IState HS} {F : ℕ → Fin HS → List ℤ}
    {N c Bb : ℕ} (hC5 : C.val < 56) (hC : ∀ k, F k C = []) (hw : C ∉ b.writes)
    (hNB : zsz (N : ℤ) ≤ Bb)
    (hb : ∀ k < N, FSp b (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) c) :
    FSp (.rep C (.lit (N : ℤ)) b) (encK s (F 0)) (encK s (F N)) (cLp N c Bb) := by
  have H := FSp.rep (n := .lit (N : ℤ)) hC5 hC hw (clean_lit _) trivial rfl hb
  refine H.mono ?_
  rw [cost_lit]
  have := cRep_le hNB
  unfold cLp; nlinarith

end KFD

end NLogN

end

section
-- Source module: Solutions.KFLLoop
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD

theorem clean_all (e : Ex HS) (h : ∀ i ∈ e.regs, i.val < 56) : e.Clean := fun i hi hz => by
  have := h i hi
  simp only [ExSt.all, zX, List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> exact absurd this (by decide)

theorem zsz_le_of_abs {v : ℤ} {B : ℕ} (h : |v| < 2 ^ B) : zsz v ≤ B := by
  apply zsz_le_of_lt
  have : (v.natAbs : ℤ) < 2 ^ B := by rw [Int.natCast_natAbs]; exact h
  exact_mod_cast this

theorem geom_lt {K : ℕ} (hK : 1 ≤ K) (k : ℕ) :
    ∑ i ∈ Finset.range k, (2 : ℤ) ^ (i * K) ≤ 2 ^ (k * K) - 1 := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Finset.sum_range_succ]
    have : (2 : ℤ) ^ (k * K) * 2 ≤ 2 ^ ((k + 1) * K) := by
      rw [← pow_succ]; exact pow_le_pow_right₀ (by norm_num) (by nlinarith)
    linarith

theorem segAcc_abs {K : ℕ} (hK : 1 ≤ K) {tf : ℤ → ℤ → ℤ} (htf : ∀ a b, |tf a b| ≤ 2)
    (u v w : ℤ) (hw : 0 ≤ w) (k : ℕ) : |segAcc K tf u v w k| ≤ 2 * w * (2 ^ (k * K) - 1) := by
  unfold segAcc
  refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
  have h1 : ∀ i ∈ Finset.range k, |w * 2 ^ (i * K) * tf (u / 2 ^ (i * K)) (v / 2 ^ (i * K))| ≤
      2 * w * 2 ^ (i * K) := by
    intro i _
    rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ w * 2 ^ (i * K))]
    have := htf (u / 2 ^ (i * K)) (v / 2 ^ (i * K))
    have hp : (0 : ℤ) ≤ w * 2 ^ (i * K) := by positivity
    nlinarith
  refine le_trans (Finset.sum_le_sum h1) ?_
  rw [← Finset.mul_sum]
  have := geom_lt hK k
  have h2 : 0 ≤ 2 * w := by linarith
  nlinarith

theorem segT_clean {T : Ex HS} {tf : ℤ → ℤ → ℤ} {Bb : ℕ} (h : SegT T tf Bb) : T.Clean :=
  clean_all T (fun i hi => by rcases h.regs i hi with rfl | rfl <;> decide)

theorem zsz_ediv_le {u d : ℤ} (hu : 0 ≤ u) (hd : 0 < d) : zsz (u / d) ≤ zsz u := by
  apply zsz_mono
  have h1 := Int.ediv_nonneg hu hd.le
  have h2 := Int.ediv_le_self d hu
  rw [← Int.ofNat_le, Int.natCast_natAbs, Int.natCast_natAbs, abs_of_nonneg h1, abs_of_nonneg hu]
  exact h2

theorem upd_ne {F : Fin HS → List ℤ} {i j : Fin HS} (h : j ≠ i) (x : List ℤ) :
    Function.update F i x j = F j := Function.update_of_ne h _ _

theorem segBody_sp {K : ℕ} (hK : 1 ≤ K) {T : Ex HS} {tf : ℤ → ℤ → ℤ} {Bb : ℕ} (hT : SegT T tf Bb)
    (s : IState HS) (F : Fin HS → List ℤ) (a u v w : ℤ) (hu : 0 ≤ u) (hv : 0 ≤ v) (hw : 0 < w)
    (n : ℕ) (hub : zsz u ≤ Bb) (hvb : zsz v ≤ Bb) (hKb : zsz ((2 : ℤ) ^ K) ≤ Bb)
    (hbig : |a| + 2 * w * 2 ^ (n * K) < 2 ^ Bb)
    (k : ℕ) (hk : k < n) (Ck : List ℤ) :
    Sp (segBody K T) (encK s (Function.update (segF F K tf a u v w k) rC Ck))
      (encK s (Function.update (segF F K tf a u v w (k + 1)) rC Ck)) (cSegIt T Bb) := by
  set G := Function.update (segF F K tf a u v w k) rC Ck with hG
  have hp : (0 : ℤ) < 2 ^ (k * K) := by positivity
  have hpK : (0 : ℤ) < 2 ^ K := by positivity
  have hkn : (2 : ℤ) ^ (k * K) * 2 ^ K ≤ 2 ^ (n * K) := by
    rw [← pow_add]; exact pow_le_pow_right₀ (by norm_num) (by nlinarith)
  have hacc := segAcc_abs hK hT.abs u v w hw.le k
  have hacc1 := segAcc_abs hK hT.abs u v w hw.le (k + 1)
  have hkn1 : (2 : ℤ) ^ ((k + 1) * K) ≤ 2 ^ (n * K) := by
    rw [show (k + 1) * K = k * K + K by ring, pow_add]; exact hkn
  have h2pos : (0:ℤ) ≤ 2 ^ (n * K) := by positivity
  -- register values in G
  have gA : G rA = (a + segAcc K tf u v w k) :: (F rA).tail := by simp +decide [G, segF, Function.update_apply]
  have gU : G NLogN.KFL.rU = (u / 2 ^ (k * K)) :: (F NLogN.KFL.rU).tail := by simp +decide [G, segF, Function.update_apply]
  have gV : G NLogN.KFL.rV = (v / 2 ^ (k * K)) :: (F NLogN.KFL.rV).tail := by simp +decide [G, segF, Function.update_apply]
  have gW : G NLogN.KFL.rW = (w * 2 ^ (k * K)) :: (F NLogN.KFL.rW).tail := by simp +decide [G, segF, Function.update_apply]
  set uk := u / 2 ^ (k * K)
  set vk := v / 2 ^ (k * K)
  have huk : 0 ≤ uk := Int.ediv_nonneg hu hp.le
  have hvk : 0 ≤ vk := Int.ediv_nonneg hv hp.le
  have hukb : zsz uk ≤ Bb := le_trans (zsz_ediv_le hu hp) hub
  have hvkb : zsz vk ≤ Bb := le_trans (zsz_ediv_le hv hp) hvb
  have hwk : zsz (w * 2 ^ (k * K)) ≤ Bb := zsz_le_of_abs (by
    rw [abs_of_pos (by positivity)]
    have : w * 2 ^ (k * K) ≤ w * 2 ^ (n * K) := by
      have : (2 : ℤ) ^ (k * K) ≤ 2 ^ (n * K) := pow_le_pow_right₀ (by norm_num) (by nlinarith)
      nlinarith
    have := abs_nonneg a
    nlinarith)
  have hab : zsz (a + segAcc K tf u v w k) ≤ Bb := zsz_le_of_abs (by
    have := abs_add_le a (segAcc K tf u v w k)
    have : (2 : ℤ) ^ (k * K) ≤ 2 ^ (n * K) := pow_le_pow_right₀ (by norm_num) (by nlinarith)
    nlinarith)
  -- step 1: acc
  have eT : T.eval (encK s G) = tf uk vk := hT.ev _ _ _ (top_encK gU) (top_encK gV)
  obtain ⟨hTo, hTb⟩ := hT.ok (encK s G) uk vk (top_encK gU) (top_encK gV) (isInt_encK gU)
    (isInt_encK gV) huk hvk hukb hvkb
  have htf := hT.abs uk vk
  have hkn' : (2 : ℤ) ^ (k * K) ≤ 2 ^ (n * K) := pow_le_pow_right₀ (by norm_num) (by nlinarith)
  have hmulb : zsz (w * 2 ^ (k * K) * tf uk vk) ≤ Bb := by
    apply zsz_le_of_abs
    have e1 : |w * 2 ^ (k * K) * tf uk vk| = w * 2 ^ (k * K) * |tf uk vk| := by
      rw [abs_mul, abs_of_pos (by positivity : (0:ℤ) < w * 2 ^ (k * K))]
    have e2 : w * 2 ^ (k * K) * |tf uk vk| ≤ w * 2 ^ (k * K) * 2 :=
      mul_le_mul_of_nonneg_left htf (by positivity)
    have e3 : w * 2 ^ (k * K) ≤ w * 2 ^ (n * K) := mul_le_mul_of_nonneg_left hkn' hw.le
    have := abs_nonneg a
    linarith
  have hnew : a + segAcc K tf u v w (k + 1) = a + segAcc K tf u v w k + w * 2 ^ (k * K) * tf uk vk := by
    simp only [segAcc, Finset.sum_range_succ]; ring
  have hnewb : zsz (a + segAcc K tf u v w (k + 1)) ≤ Bb := by
    apply zsz_le_of_abs
    have h1 := abs_add_le a (segAcc K tf u v w (k + 1))
    have h2 : 2 * w * (2 ^ ((k + 1) * K) - 1) ≤ 2 * w * 2 ^ (n * K) :=
      mul_le_mul_of_nonneg_left (by linarith) (by linarith)
    linarith
  have S1 := Sp.asgQ s G (i := rA) (e := .add (.reg rA) (.mul (.reg NLogN.KFL.rW) T)) (by decide) gA hab
    (clean_add (clean_reg (by decide)) (clean_mul (clean_reg (by decide)) (segT_clean hT)))
    ⟨ok_reg gA, ok_reg gW, hTo⟩
    ⟨bnd_reg gA hab, ⟨bnd_reg gW hwk, hTb, by simp only [Ex.eval]; rw [top_encK gW, eT]; exact hmulb⟩,
      by simp only [Ex.eval]; rw [top_encK gA, top_encK gW, eT, ← hnew]; exact hnewb⟩
  have ev1 : (Ex.add (.reg rA) (.mul (.reg NLogN.KFL.rW) T)).eval (encK s G) = a + segAcc K tf u v w (k + 1) := by
    simp only [Ex.eval]; rw [top_encK gA, top_encK gW, eT, hnew]
  rw [ev1] at S1
  -- step 2: u
  set G1 := Function.update G rA ((a + segAcc K tf u v w (k + 1)) :: (F rA).tail)
  have g1U : G1 NLogN.KFL.rU = uk :: (F NLogN.KFL.rU).tail := by simp only [G1]; rw [upd_ne (by decide)]; exact gU
  have hK2 : (2 : ℤ) ^ K = 2 ^ K := rfl
  have euq : (Ex.quo (.reg NLogN.KFL.rU) (.lit ((2 : ℤ) ^ K))).eval (encK s G1) = u / 2 ^ ((k + 1) * K) := by
    simp only [Ex.eval]; rw [top_encK g1U]
    rw [Int.tdiv_eq_ediv_of_nonneg huk, Int.ediv_ediv_of_nonneg hp.le, ← pow_add]
    congr 2; ring
  have S2 := Sp.asgQ s G1 (i := NLogN.KFL.rU) (e := .quo (.reg NLogN.KFL.rU) (.lit ((2 : ℤ) ^ K))) (by decide) g1U hukb
    (clean_all _ (by intro i hi; simp only [Ex.regs, List.mem_append, List.mem_singleton,
      List.not_mem_nil, or_false] at hi; subst hi; decide)) ⟨ok_reg g1U, trivial, ⟨K, by simp [Ex.eval]⟩⟩
    ⟨bnd_reg g1U hukb, by simpa [Ex.Bnd] using hKb⟩
  rw [euq] at S2
  -- step 3: v
  set G2 := Function.update G1 NLogN.KFL.rU ((u / 2 ^ ((k + 1) * K)) :: (F NLogN.KFL.rU).tail)
  have g2V : G2 NLogN.KFL.rV = vk :: (F NLogN.KFL.rV).tail := by
    simp only [G2, G1]; rw [upd_ne (by decide), upd_ne (by decide)]; exact gV
  have evq : (Ex.quo (.reg NLogN.KFL.rV) (.lit ((2 : ℤ) ^ K))).eval (encK s G2) = v / 2 ^ ((k + 1) * K) := by
    simp only [Ex.eval]; rw [top_encK g2V]
    rw [Int.tdiv_eq_ediv_of_nonneg hvk, Int.ediv_ediv_of_nonneg hp.le, ← pow_add]
    congr 2; ring
  have S3 := Sp.asgQ s G2 (i := NLogN.KFL.rV) (e := .quo (.reg NLogN.KFL.rV) (.lit ((2 : ℤ) ^ K))) (by decide) g2V hvkb
    (clean_all _ (by intro i hi; simp only [Ex.regs, List.mem_append, List.mem_singleton,
      List.not_mem_nil, or_false] at hi; subst hi; decide)) ⟨ok_reg g2V, trivial, ⟨K, by simp [Ex.eval]⟩⟩
    ⟨bnd_reg g2V hvkb, by simpa [Ex.Bnd] using hKb⟩
  rw [evq] at S3
  -- step 4: w
  set G3 := Function.update G2 NLogN.KFL.rV ((v / 2 ^ ((k + 1) * K)) :: (F NLogN.KFL.rV).tail)
  have g3W : G3 NLogN.KFL.rW = (w * 2 ^ (k * K)) :: (F NLogN.KFL.rW).tail := by
    simp only [G3, G2, G1]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]; exact gW
  have ewm : (Ex.mul (.reg NLogN.KFL.rW) (.lit ((2 : ℤ) ^ K))).eval (encK s G3) = w * 2 ^ ((k + 1) * K) := by
    simp only [Ex.eval]; rw [top_encK g3W, mul_assoc, ← pow_add]; congr 2; ring
  have hw1 : zsz (w * 2 ^ ((k + 1) * K)) ≤ Bb := by
    apply zsz_le_of_abs
    rw [abs_of_pos (by positivity)]
    have : w * 2 ^ ((k + 1) * K) ≤ w * 2 ^ (n * K) := mul_le_mul_of_nonneg_left hkn1 hw.le
    have := abs_nonneg a
    have hX : 0 ≤ w * 2 ^ (n * K) := by positivity
    have : w * 2 ^ (n * K) ≤ 2 * w * 2 ^ (n * K) := by linarith
    linarith
  have S4 := Sp.asgQ s G3 (i := NLogN.KFL.rW) (e := .mul (.reg NLogN.KFL.rW) (.lit ((2 : ℤ) ^ K))) (by decide) g3W hwk
    (clean_all _ (by intro i hi; simp only [Ex.regs, List.mem_append, List.mem_singleton,
      List.not_mem_nil, or_false] at hi; subst hi; decide)) ⟨ok_reg g3W, trivial⟩
    ⟨bnd_reg g3W hwk, by simpa [Ex.Bnd] using hKb, by
      have := ewm; simp only [Ex.eval] at this ⊢; rw [this]; exact hw1⟩
  rw [ewm] at S4
  have H := S1.seq (S2.seq (S3.seq S4))
  refine (H.congr ?_).mono ?_
  · congr 1; funext j
    simp only [G3, G2, G1, G, segF, Function.update_apply]
    by_cases h1 : j = NLogN.KFL.rW
    · subst h1; simp +decide
    by_cases h2 : j = NLogN.KFL.rV
    · subst h2; simp +decide
    by_cases h3 : j = NLogN.KFL.rU
    · subst h3; simp +decide
    by_cases h4 : j = rA
    · subst h4; simp +decide
    simp only [h1, h2, h3, h4, if_false]
  · simp only [cSegIt, Ex.size]
    have hB : 0 ≤ (Bb + 2) ^ 2 := Nat.zero_le _
    generalize (Bb + 2) ^ 2 = X at *
    generalize T.size = t
    ring_nf; omega

theorem segF_rC {F : Fin HS → List ℤ} (hF : F rC = []) (K : ℕ) (tf : ℤ → ℤ → ℤ) (a u v w : ℤ)
    (k : ℕ) : segF F K tf a u v w k rC = [] := by
  simp only [segF, Function.update_apply]; simp +decide [hF]
end NLogN.KFL
