/-!
# The Brownian increment vector of a Lévy driver

`LevyDriver.isBrownianFiltration` says that each coordinate's increment is independent of the
joint filtration. The vector of all `d` increments is a stronger statement, and it does not follow
from the coordinatewise ones by joining: the second coordinate's increment would have to be
independent of `ℱ_s ⊔ σ(ΔW¹)`, which sits inside `ℱ_t`, of which it is itself measurable. It
follows instead from the driver's own independence structure — the coordinates generate
independent σ-algebras and `σ(W) ⟂ σ(N)` — so that `σ(ΔWʲ)` is independent of the join of `Wʲ`'s
own past with *everything* the other coordinates and `N` generate.

## Main statements

* `LevyDriver.indep_incrementSigma_rest` — `σ(ΔWʲ)` against that join.
* `LevyDriver.indep_iSup_incrementSigma` — the whole increment vector against `ℱ s`.
* `LevyDriver.indep_iSup_incrementSigma_rightCont` — the same against `ℱ₊ s`.
* `LevyDriver.indep_iSup_regionSigma` — the Poisson counterpart, for the counts on a finite
  family of measurable regions lying after `s`. Arbitrary regions, not just products `(s, t] × A`:
  `sigmaPoisson` is generated by counts on all measurable subsets of `ℝ × E`.
* `LevyDriver.indep_stepSigma`, `LevyDriver.indep_stepSigma_rightCont` — the mixed tuple.
-/

open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace LevyStochCalc.Driver

universe u v w

variable {Ω : Type u} [MeasurableSpace Ω] {E : Type v} [MeasurableSpace E]
  {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν] {d : ℕ}

namespace LevyDriver

variable (D : LevyDriver.{u, v, w} P d ν)


theorem _root_.Prove2MeSourceProof.h_8ea16c26ab6d2ef36877b0b6 {m : ℕ} (C : Fin m → Set (ℝ × E))
    (hCm : ∀ k, MeasurableSet (C k)) {s t : ℝ} (hs : 0 ≤ s) (hst : s < t)
    (hCs : ∀ k, C k ⊆ Set.Ioi s ×ˢ Set.univ) :
    Indep (D.stepSigma C s t) (D.filtration.rightCont s) P := by
  obtain ⟨r, hr_anti, hr_mem, hr_tend⟩ := exists_seq_strictAnti_tendsto' hst
  have hle : ∀ n, D.filtration.rightCont s ≤ D.filtration (r n) := fun n => by
    rw [Filtration.rightCont_eq_of_neBot_nhdsGT D.filtration s]
    exact iInf₂_le (r n) (hr_mem n).1
  set C' : ℕ → Fin m → Set (ℝ × E) := fun n k => C k ∩ Set.Ioi (r n) ×ˢ Set.univ with hC'
  have hC'm : ∀ n k, MeasurableSet (C' n k) := fun n k =>
    (hCm k).inter (measurableSet_Ioi.prod MeasurableSet.univ)
  have hC's : ∀ n k, C' n k ⊆ Set.Ioi (r n) ×ˢ Set.univ := fun n k => Set.inter_subset_right
  set Z : ℕ → Ω → (Fin d → ℝ) × (Fin m → ℝ≥0∞) := fun n ω =>
    (fun j => (D.W.W j).W t ω - (D.W.W j).W (r n) ω, fun k => D.N.N ω (C' n k)) with hZ
  set Y : Ω → (Fin d → ℝ) × (Fin m → ℝ≥0∞) := fun ω =>
    (fun j => (D.W.W j).W t ω - (D.W.W j).W s ω, fun k => D.N.N ω (C k)) with hY
  have hZ_meas : ∀ n, Measurable (Z n) := fun n =>
    (measurable_pi_lambda _ fun j =>
      ((D.W.W j).measurable_eval t).sub ((D.W.W j).measurable_eval (r n))).prodMk
    (measurable_pi_lambda _ fun k => D.N.measurable_eval (hC'm n k))
  have hY_meas : Measurable Y :=
    (measurable_pi_lambda _ fun j =>
      ((D.W.W j).measurable_eval t).sub ((D.W.W j).measurable_eval s)).prodMk
    (measurable_pi_lambda _ fun k => D.N.measurable_eval (hCm k))
  have hZcomap : ∀ n, MeasurableSpace.comap (Z n) inferInstance = D.stepSigma (C' n) (r n) t := by
    intro n
    rw [hZ, LevyStochCalc.Probability.comap_prod_eq_sup]
    exact congrArg₂ (· ⊔ ·)
      (LevyStochCalc.Probability.comap_pi_eq_iSup fun j ω => (D.W.W j).W t ω - (D.W.W j).W (r n) ω)
      (LevyStochCalc.Probability.comap_pi_eq_iSup fun k ω => D.N.N ω (C' n k))
  have hYcomap : MeasurableSpace.comap Y inferInstance = D.stepSigma C s t := by
    rw [hY, LevyStochCalc.Probability.comap_prod_eq_sup]
    exact congrArg₂ (· ⊔ ·)
      (LevyStochCalc.Probability.comap_pi_eq_iSup fun j ω => (D.W.W j).W t ω - (D.W.W j).W s ω)
      (LevyStochCalc.Probability.comap_pi_eq_iSup fun k ω => D.N.N ω (C k))
  have key : Indep (D.filtration.rightCont s)
      (MeasurableSpace.comap Y inferInstance) P := by
    refine _root_.Prove2MeSourceProof.h_0bb5f8f4daf066d260b6996b (D.filtration.rightCont.le s)
      hZ_meas hY_meas (fun n => ?_) ?_
    · rw [hZcomap n]
      exact indep_of_indep_of_le_left
        ((_root_.Prove2MeSourceProof.h_b5912c738affc5f69d2adbcb D) (C' n) (hC'm n) (hs.trans (hr_mem n).1.le) (hr_mem n).2
          (hC's n)).symm (hle n)
    · filter_upwards [ae_all_iff.2 fun j : Fin d => (D.W.W j).continuous_paths] with ω hω
      refine Filter.Tendsto.prodMk_nhds (tendsto_pi_nhds.2 fun j =>
        tendsto_const_nhds.sub (((hω j).tendsto s).comp hr_tend)) (tendsto_pi_nhds.2 fun k => ?_)
      have hmono : Monotone fun n => C' n k := fun a b hab =>
        Set.inter_subset_inter_right _ (Set.prod_mono (Set.Ioi_subset_Ioi (hr_anti.antitone hab))
          le_rfl)
      have hunion : ⋃ n, C' n k = C k := by
        refine Set.Subset.antisymm (Set.iUnion_subset fun n => Set.inter_subset_left) fun x hx => ?_
        obtain ⟨n, hn⟩ := (hr_tend.eventually (eventually_lt_nhds (hCs k hx).1)).exists
        exact Set.mem_iUnion.2 ⟨n, hx, hn, Set.mem_univ _⟩
      have := tendsto_measure_iUnion_atTop (μ := D.N.N ω) hmono
      rwa [hunion] at this
  rw [hYcomap] at key
  exact key.symm
end LevyDriver

end LevyStochCalc.Driver


