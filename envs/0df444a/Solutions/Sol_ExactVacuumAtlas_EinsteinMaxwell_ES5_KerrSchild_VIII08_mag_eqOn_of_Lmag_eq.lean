open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII05
theorem solution {b1 b2 : ℝ → ℝ} (h1 : MagClass 3 b1) (h2 : MagClass 3 b2)
    (e : ∀ R ∈ Ioi (3:ℝ), Lmag b1 R = Lmag b2 R) : EqOn b1 b2 (Ioi (3:ℝ)) := by
  set h : ℝ → ℝ := fun s => b1 s - b2 s with hdef
  have hMh : MagClass 3 h := magClass_sub h1 h2
  have hLh : ∀ R ∈ Ioi (3:ℝ), Lop 3 1 (3 / 2) h R = 2 * (3 / 2) * 0 / R ^ 3 := by
    intro R hR
    have hsub := Lop_sub (Rh := 3) (Ri := 1) (Q := 3 / 2) h1.1 h2.1 (by norm_num : (0:ℝ) ≤ 3) hR
    have eR : Lop 3 1 (3 / 2) b1 R = Lop 3 1 (3 / 2) b2 R := by
      rw [← Lmag_eq_Lop, ← Lmag_eq_Lop]
      exact e R hR
    rw [hdef, hsub, eR, sub_self]
    ring
  have hL0 : ∀ R ∈ Ioi (3:ℝ), Lop 3 1 (3 / 2) (fun _ : ℝ => 0) R = 2 * (3 / 2) * 0 / R ^ 3 := by
    intro R _
    have hz : Lop 3 1 (3 / 2) (fun _ : ℝ => 0) R = Lmag (fun _ : ℝ => 0) R :=
      (Lmag_eq_Lop (fun _ : ℝ => 0) R).symm
    rw [hz, Lmag_zero]
    ring
  have hres := mag_unique (Rh := 3) (Ri := 1) (Q := 3 / 2) (j := 0)
    (by norm_num : (0:ℝ) ≤ 1) (by norm_num : (1:ℝ) < 3) hMh magClass_zero hLh hL0
  intro R hR
  have hval := hres hR
  simp only [Pi.sub_apply, Pi.zero_apply] at hval
  linarith
