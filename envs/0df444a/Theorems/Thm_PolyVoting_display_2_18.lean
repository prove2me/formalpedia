-- title:
--   (2.18) — the conditional expectation of the next share
-- statement:
--   For each $k\in[K]$ and $t\ge0$,
--   $$\mathbb E(\pi_{k,t+1}\mid\mathcal F_t)=\frac{n_{k,t}}{N_t}\Big(1-\frac1{N_t^\alpha}\Big)+\frac{n_{k,t}}{N_t+1}\,\frac{N_t-n_{k,t}}{N_t^{1+\alpha}}+\frac{n_{k,t}+1}{N_t+1}\,\frac{n_{k,t}}{N_t^{1+\alpha}}.$$
--
--   The three terms are the outcomes "nobody is rewarded", "another bidder is rewarded" and "bidder $k$ is rewarded". The identity yields the martingale property of the shares.
--
--   Differences from the source:
--   - encoding: the Poly(α) rule described by (2.3)–(2.6), K ∈ ℕ₊ bidders, stakes n_{k,t} → `Model μ K α n₀`: the joint conditional one-step law, stakes in Fin K → ℕ, real α ≥ 0 with Real.rpow, and 1 ≤ N; reason: the conditional one-step law and n₀ determine the law of the chain; 1 ≤ N only keeps N_t^{−α} defined
--   - generalization: F_t generated by the events S_{k,r}, r ≤ t → any filtration ℱ to which n is adapted and for which the one-step law holds; reason: the natural filtration of n is one such ℱ, so the statement specializes to the paper's F_t
-- source:
--   Tang & Yao, Polynomial Voting Rules, arXiv:2206.10105v5, proof of Theorem 6 (i), display (2.18), p.11

import Mathlib
import Definitions.Def_PolyVoting_Model

open MeasureTheory ProbabilityTheory

namespace PolyVoting

/-- **Display (2.18)** (Tang & Yao, *Polynomial Voting Rules*, arXiv:2206.10105v5, p.11): the
conditional expectation of the next share, term by term as printed. -/
theorem display_2_18 {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    [IsProbabilityMeasure μ] {K : ℕ} {α : ℝ} {n₀ : Fin K → ℕ} (M : Model μ K α n₀)
    (k : Fin K) (t : ℕ) :
    μ[M.share k (t + 1) | M.ℱ t] =ᵐ[μ] fun ω =>
      (M.n t ω k : ℝ) / (M.total t ω : ℝ) * (1 - 1 / (M.total t ω : ℝ) ^ α) +
        (M.n t ω k : ℝ) / ((M.total t ω : ℝ) + 1) *
          (((M.total t ω : ℝ) - (M.n t ω k : ℝ)) / (M.total t ω : ℝ) ^ (1 + α)) +
        ((M.n t ω k : ℝ) + 1) / ((M.total t ω : ℝ) + 1) *
          ((M.n t ω k : ℝ) / (M.total t ω : ℝ) ^ (1 + α)) := by sorry

end PolyVoting
