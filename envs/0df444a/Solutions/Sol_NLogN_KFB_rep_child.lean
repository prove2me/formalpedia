open NLogN
open NLogN.KFB
open IntMul RS AModel KIL KFD Complex
theorem solution {W m n : ℕ} (w : Fin W) (h : Fin m) (U : Butterfly.Op (Fin n))
    (F : List NLogN.KFB.GI → List NLogN.KFB.GI) (hF : NLogN.KFB.BlkT U F) (zs : List NLogN.KFB.GI)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : NLogN.KFB.Rep zs x) :
    NLogN.KFB.Rep (NLogN.KFB.chL (2 ^ (m * n)) (w.val * 2 ^ (m * n)) (2 ^ n) (2 ^ (n * h.val)) F zs)
      ((P8Lift.RStep.childR w h U).mulVec x) := by
  obtain ⟨hl, hv⟩ := hx
  set N := 2 ^ (m * n) with hN
  set q := 2 ^ n with hq
  set M := 2 ^ (n * h.val) with hM
  have hq0 : 0 < q := by positivity
  have hM0 : 0 < M := by positivity
  set A := 2 ^ (n * (m - 1 - h.val)) with hA
  have hNA : N = A * M * q := by
    rw [hN, hA, hM, hq, ← pow_add, ← pow_add]; congr 1
    have := h.isLt
    obtain ⟨k, hk⟩ : ∃ k, m = h.val + 1 + k := ⟨m - h.val - 1, by omega⟩
    rw [show m - 1 - h.val = k by omega]
    generalize h.val = H at hk ⊢
    subst hk; ring
  have hlen : w.val * N + N ≤ zs.length := by
    rw [hl, ← Nat.succ_mul]; exact Nat.mul_le_mul_right _ w.isLt
  set seg := (zs.drop (w.val * N)).take N with hseg
  have hsl : seg.length = N := by simp [hseg]; omega
  have hseg_get : ∀ i, i < N → seg.getD i 0 = zs.getD (w.val * N + i) 0 := fun i hi => by
    rw [hseg, NLogN.KFB.getD_take' _ _ _ hi, NLogN.KFB.getD_drop']
  have hy : (NLogN.KFB.mvL M q seg).length = N := by rw [NLogN.KFB.length_mvL, hsl]
  have hdv : q ∣ (NLogN.KFB.mvL M q seg).length := ⟨A * M, by rw [hy, hNA]; ring⟩
  obtain ⟨hFl, hFv⟩ := hF _ hdv
  have hFl' : (F (NLogN.KFB.mvL M q seg)).length = N := by rw [hFl, hy]
  refine ⟨by rw [NLogN.KFB.length_chL _ _ _ _ _ _ hFl' hlen, hl], fun w' b => ?_⟩
  have hb : NLogN.KFB.aidx b < N := NLogN.KFB.aidx_lt b
  rw [NLogN.KFB.getD_chL _ _ _ _ _ _ hFl' hlen, NLogN.KFB.den_child_mulVec]
  by_cases e : w' = w
  · subst e
    rw [if_pos ((NLogN.KFB.seg_iff hb).2 rfl), if_pos rfl, Nat.add_sub_cancel_left,
      NLogN.KFB.getD_mvL _ _ _ _ (by rw [hFl']; exact hb)]
    have hg : NLogN.KFB.g4 q M (NLogN.KFB.aidx b) = ((NLogN.KFB.aidx b) / (q * M) * M + (NLogN.KFB.aidx b) % M) * q + NLogN.KFB.sidx (Butterfly.slotBits b h) := by
      unfold NLogN.KFB.g4; rw [← NLogN.KFB.aidx_slot b h]
    have hβ : ((NLogN.KFB.aidx b) / (q * M) * M + (NLogN.KFB.aidx b) % M) * q + q ≤ (NLogN.KFB.mvL M q seg).length := by
      rw [hy, hNA]
      have h1 : (NLogN.KFB.aidx b) / (q * M) < A := by
        rw [Nat.div_lt_iff_lt_mul (by positivity)]; rw [hNA] at hb; nlinarith
      have h2 := Nat.mod_lt (NLogN.KFB.aidx b) hM0
      have : (NLogN.KFB.aidx b) / (q * M) * M + (NLogN.KFB.aidx b) % M + 1 ≤ A * M := by nlinarith
      nlinarith
    rw [hg, hFv _ _ hβ]
    refine Finset.sum_congr rfl fun σ' _ => ?_
    congr 1
    have hk : ((NLogN.KFB.aidx b) / (q * M) * M + (NLogN.KFB.aidx b) % M) * q + NLogN.KFB.sidx σ' < (NLogN.KFB.mvL M q seg).length := by
      have := NLogN.KFB.sidx_lt σ'; omega
    have hu := NLogN.KFB.aidx_lt (NLogN.KFB.updS b h σ')
    rw [NLogN.KFB.aidx_updS_g4 b h σ'] at hu
    rw [NLogN.KFB.getD_mvL _ _ _ _ (by rwa [NLogN.KFB.length_mvL] at hk), NLogN.KFB.g4_child _ _ _ _ hq0 hM0 (NLogN.KFB.sidx_lt σ'),
      hseg_get _ hu, ← hv, NLogN.KFB.aidx_updS_g4 b h σ']
  · rw [if_neg (fun h' => e (Fin.ext ((NLogN.KFB.seg_iff hb).1 h'))), if_neg e, hv]
end
