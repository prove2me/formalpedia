-- title:
--   Generator, generated and marked languages, closure (§2.1, pp. 207–208; §3.1, p. 211)
-- statement:
--   A **generator** is a 5-tuple $\mathcal G = (Q, \Sigma, \delta, q_0, Q_m)$: $Q$ is a set of states (not necessarily finite), $\Sigma$ is a finite alphabet of event labels, $\delta : \Sigma \times Q \to Q$ is a **partial** transition function, $q_0 \in Q$ is the initial state and $Q_m \subseteq Q$ is the set of marker states.
--
--   Writing $\Sigma^*$ for the finite strings over $\Sigma$ (with empty string $1$), the transition function extends to strings by $\delta(1, q) = q$ and $\delta(s\sigma, q) = \delta(\sigma, \delta(s, q))$ whenever both steps are defined. The **generated** and **marked** languages are
--
--   $$L(\mathcal G) = \{ w \in \Sigma^* : \delta(w, q_0) \text{ is defined}\}, \qquad L_m(\mathcal G) = \{ w \in L(\mathcal G) : \delta(w, q_0) \in Q_m\}.$$
--
--   $\mathcal G$ is **accessible** if every state is reached from $q_0$ by some string, **co-accessible** if every $w \in L(\mathcal G)$ extends to some $ws \in L_m(\mathcal G)$, and **trim** if both hold.
--
--   For a language $K \subseteq \Sigma^*$, its **closure** is the set of prefixes of its words,
--   $$\bar K = \{ s \in \Sigma^* : \exists t \in \Sigma^*,\ st \in K\},$$
--   and $K$ is **closed** if $K = \bar K$.
--
--   These are the basic objects of the Ramadge–Wonham theory: a generator models the uncontrolled plant, and also the automaton of a supervisor.
--
--   This definition is shared by both missions of this series: 1 (synthesis: Propositions 4.1, p. 212, and 5.1, p. 214; Theorem 6.1, p. 216; Proposition 7.1 and the supremal elements of §7, p. 218; Theorem 7.1, pp. 218–219) and 2 (quotient structure: Proposition 8.1, p. 219; Theorem 10.1 and the steps of its proof, pp. 222–224, including the recognizer of §4, p. 212, and the $\bar K$-reduced / $\bar K$-trim automata of §9, p. 222).
--
--   **Formalization Note.** The alphabet $\Sigma$ is a type `α` (finiteness is a hypothesis `[Fintype α]` of each theorem). The state set is a field `Q : Type`; the partial map $\delta$ is `δ : α → Q → Option Q`, with `none` meaning undefined. The extended transition function is a left fold over the string, so appending an event applies one more step. Strings are `List α`, the empty string is `[]` and $s\sigma$ is `s ++ [σ]`. The closure is `pre`.
-- source:
--   Ramadge and Wonham, Supervisory Control of a Class of Discrete Event Processes, SIAM J. Control Optim. 25(1), 1987, pp. 207–208, §2.1 (generator, extended transition function, L(G), L_m(G), accessible, co-accessible, trim); p. 211, §3.1 (closure, closed language)

import Mathlib

namespace RamadgeWonham.Shared

/-- A generator `𝒢 = (Q, Σ, δ, q₀, Q_m)` (Ramadge–Wonham 1987, §2.1, p. 207). The alphabet `Σ` is the
type parameter `α`; the state set `Q` is an arbitrary type (not assumed finite); the transition
function `δ : Σ × Q → Q` is partial, encoded as `δ σ q : Option Q` (`none` = undefined); `q0` is the
initial state and `Qm` the set of marker states. -/
structure Generator (α : Type) where
  /-- State set. -/
  Q : Type
  /-- Partial transition function: `δ σ q = none` means `δ(σ, q)` is undefined. -/
  δ : α → Q → Option Q
  /-- Initial state. -/
  q0 : Q
  /-- Marker states. -/
  Qm : Set Q

namespace Generator

variable {α : Type}

/-- Extended transition function `δ(s, q)` (p. 208): `δ(1, q) = q` and `δ(sσ, q) = δ(σ, δ(s, q))`
whenever both are defined; `none` means undefined. -/
def runFrom (G : Generator α) (q : G.Q) (s : List α) : Option G.Q :=
  s.foldl (fun o σ => o.bind (G.δ σ)) (some q)

/-- `δ(s, q₀)`. -/
def run (G : Generator α) (s : List α) : Option G.Q :=
  G.runFrom G.q0 s

/-- The language generated by `𝒢`: `L(𝒢) = {w ∈ Σ* | δ(w, q₀) is defined}` (p. 208). -/
def L (G : Generator α) : Set (List α) :=
  {w | (G.run w).isSome}

/-- The language marked by `𝒢`: `L_m(𝒢) = {w ∈ L(𝒢) | δ(w, q₀) ∈ Q_m}` (p. 208). -/
def Lm (G : Generator α) : Set (List α) :=
  {w | ∃ q, G.run w = some q ∧ q ∈ G.Qm}

/-- `𝒢` is accessible: every state is reachable from `q₀` (p. 208). -/
def Accessible (G : Generator α) : Prop :=
  ∀ q : G.Q, ∃ w : List α, G.run w = some q

/-- `𝒢` is co-accessible: every string of `L(𝒢)` can be completed to a string of `L_m(𝒢)` (p. 208). -/
def CoAccessible (G : Generator α) : Prop :=
  ∀ w ∈ G.L, ∃ s : List α, w ++ s ∈ G.Lm

/-- `𝒢` is trim: accessible and co-accessible (p. 208). -/
def IsTrim (G : Generator α) : Prop :=
  G.Accessible ∧ G.CoAccessible

end Generator

/-- The closure (prefix closure) of a language: `K̄ = {s ∈ Σ* | ∃ t ∈ Σ*, st ∈ K}` (§3.1, p. 211). -/
def pre {α : Type} (K : Set (List α)) : Set (List α) :=
  {s | ∃ t : List α, s ++ t ∈ K}

/-- A language `K` is closed if `K = K̄` (§3.1, p. 211). -/
def IsClosedLang {α : Type} (K : Set (List α)) : Prop :=
  K = pre K

end RamadgeWonham.Shared


