-- Source module: Solutions.ButterflyTensor
/-!
# §5.1 Phase-frame identities and tensor products on selected bits

The `2 × 2` matrices of §5.1 of the OpenAI preprint "Integer multiplication below n log n":
`H0 = ½[[1,1],[1,-1]]`, `S = diag(1,i)`, `Z = diag(1,-1)`, `X = [[0,1],[1,0]]`,
`C = HSH = aI + bX` with `a = (1+i)/2`, `b = (1-i)/2`, and the identities (13), (14), (17), (18).

Tensor products over an arbitrary finite set `ι` of selected bits:
`tensF A x y = ∏ i, A i (x i) (y i)` for a family `A : ι → M₂`.
-/

namespace Butterfly

open Matrix Complex Finset

/-! ## Tensor products on selected bits -/

section Tensor

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem tensF_one : tensF (fun _ : ι => (1 : M2)) = 1 := by
  ext x y
  simp only [tensF, Matrix.one_apply]
  rw [Finset.prod_boole]
  by_cases h : x = y
  · subst h; simp
  · have : ¬ ∀ i ∈ (univ : Finset ι), x i = y i := fun h' => h (funext fun i => h' i (mem_univ _))
    rw [if_neg this, if_neg h]

end Tensor

/-! ## (15): address permutations conjugate translations -/

section Translate

variable {K V : Type*} [Ring K] [AddCommGroup V] [Module K V] {β : Type*}

end Translate

/-! ## Elementary row additions generate `GL(m, F₂)` -/

/-- Over `F₂`, every invertible matrix is a product of elementary row additions
`1 + E_{ij}` (`i ≠ j`) — the binary changes of basis of §5.1 use only these. -/
theorem gl_f2_row_additions {m : Type*} [Fintype m] [DecidableEq m]
    (M : Matrix m m (ZMod 2)) (hM : M.det ≠ 0) :
    ∃ L : List (m × m), (∀ p ∈ L, p.1 ≠ p.2) ∧
      M = (L.map fun p => transvection p.1 p.2 (1 : ZMod 2)).prod := by
  obtain ⟨L, L', D, hD⟩ := Matrix.Pivot.exists_list_transvec_mul_diagonal_mul_list_transvec M
  have hD1 : diagonal D = 1 := by
    have hdet : (diagonal D).det ≠ 0 := by
      intro h0
      apply hM
      rw [hD, det_mul, det_mul, h0]; simp
    rw [det_diagonal] at hdet
    ext i j
    simp only [diagonal_apply, one_apply]
    split_ifs with h
    · subst h
      have : D i ≠ 0 := fun h0 => hdet (Finset.prod_eq_zero (mem_univ i) h0)
      exact (show ∀ a : ZMod 2, a ≠ 0 → a = 1 by decide) _ this
    · rfl
  -- each transvection over `F₂` is `1` or a row addition
  have key : ∀ t : TransvectionStruct m (ZMod 2), ∃ l : List (m × m), (∀ p ∈ l, p.1 ≠ p.2) ∧
      t.toMatrix = (l.map fun p => transvection p.1 p.2 (1 : ZMod 2)).prod := by
    intro t
    have hc : t.c = 0 ∨ t.c = 1 := by
      exact (show ∀ a : ZMod 2, a = 0 ∨ a = 1 by decide) _
    rcases hc with h | h
    · refine ⟨[], by simp, ?_⟩
      simp [TransvectionStruct.toMatrix, h, transvection_zero]
    · refine ⟨[(t.i, t.j)], by simpa using t.hij, ?_⟩
      simp [TransvectionStruct.toMatrix, h]
  have keyL : ∀ L : List (TransvectionStruct m (ZMod 2)), ∃ l : List (m × m),
      (∀ p ∈ l, p.1 ≠ p.2) ∧
      (L.map TransvectionStruct.toMatrix).prod =
        (l.map fun p => transvection p.1 p.2 (1 : ZMod 2)).prod := by
    intro L
    induction L with
    | nil => exact ⟨[], by simp, by simp⟩
    | cons t L ih =>
      obtain ⟨l₁, h₁, e₁⟩ := key t
      obtain ⟨l₂, h₂, e₂⟩ := ih
      refine ⟨l₁ ++ l₂, fun p hp => ?_, ?_⟩
      · rcases List.mem_append.1 hp with hp | hp
        exacts [h₁ p hp, h₂ p hp]
      · simp [e₁, e₂, List.prod_append]
  obtain ⟨l₁, h₁, e₁⟩ := keyL L
  obtain ⟨l₂, h₂, e₂⟩ := keyL L'
  refine ⟨l₁ ++ l₂, fun p hp => ?_, ?_⟩
  · rcases List.mem_append.1 hp with hp | hp
    exacts [h₁ p hp, h₂ p hp]
  · rw [hD, hD1, mul_one, e₁, e₂, List.map_append, List.prod_append]

end Butterfly

end

