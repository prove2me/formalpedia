-- ===== S4.Def_RP_EtPBC_A_O2UK1 =====
section

/-!
# S4-EtPBC-A, O2 M6 (O2UK1): `1 + t e` is a `d`-th power over an etale neighbourhood (ring level)

Km DESIGN v3 step UK, ring level. Let `χ : B → K` be a point with `χ t = 0`, `d` a unit of `B`, and `g ∈ B[X]` monic of
degree `n > 0`. In the coordinates `y_0 … y_{n-1}` of `B[X] ⧸ (g)`, the equation `(Σ y_i X^i)^d = 1 + t X` is the
system `ukF g d t` (coefficients of the remainder mod `g`). At `y₀ = (1, 0, …, 0)` its Jacobian is `d · 1`
(`uk_jac`, computed with dual numbers, `aeval_dual`) and its value is `-t · (X mod g)`, divisible by `det² = d^{2n}`.
* **`uk_root`** (Tougeron, `tougeron_nbhd_strong`): there are an etale `B → B'` with a point `χ'` over `χ` and
  `y : Fin n → B'` such that `(Σ y_i e^i)^d = 1 + t e` for every root `e` of `g` in every `B'`-algebra.
* `exists_monic_of_isIntegral`: an integral element has a monic equation of positive degree.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtKum

open RamanujanPetersson.EtPBC.Cov

universe u v

section Dual

end Dual

section UK

variable {B : Type u} [CommRing B]

/-- Value and Jacobian of `ukF` at `y₀`. -/
theorem uk_jac [Nontrivial B] (g : B[X]) (hg : g.Monic) (hn : 0 < g.natDegree) (d : ℕ) (t : B)
    (j k : Fin g.natDegree) :
    MvPolynomial.eval (ukY0 hn) (ukF g d t j) = -(t * (X %ₘ g).coeff j) ∧
      MvPolynomial.eval (ukY0 hn) (MvPolynomial.pderiv k (ukF g d t j)) = if j = k then (d : B) else 0 := by
  have key := aeval_dual (ukY0 hn) k (ukF g d t j)
  rw [ukF_map g hg d t] at key
  simp only [MvPolynomial.aeval_X] at key
  rw [uk_sum hn k] at key
  have hε2 : (C (DualNumber.eps : DualNumber B) * X ^ (k : ℕ)) ^ 2 = 0 := by
    have e1 : (C (DualNumber.eps : DualNumber B) * X ^ (k : ℕ)) ^ 2 =
        C (DualNumber.eps * DualNumber.eps) * X ^ (2 * (k : ℕ)) := by
      rw [C_mul]
      ring
    rw [e1, DualNumber.eps_mul_eps, map_zero, zero_mul]
  rw [one_add_pow_of_sq hε2 d] at key
  have hexp : (1 + (d : (DualNumber B)[X]) * (C DualNumber.eps * X ^ (k : ℕ)) - 1 -
      C (algebraMap B (DualNumber B) t) * X) =
      C ((d : DualNumber B) * DualNumber.eps) * X ^ (k : ℕ) - C (algebraMap B (DualNumber B) t) * X := by
    rw [C_mul, map_natCast]
    ring
  rw [hexp] at key
  have hq := hg.map (algebraMap B (DualNumber B))
  have hsub := (modByMonicHom (g.map (algebraMap B (DualNumber B)))).map_sub
    (C ((d : DualNumber B) * DualNumber.eps) * X ^ (k : ℕ)) (C (algebraMap B (DualNumber B) t) * X)
  simp only [modByMonicHom_apply] at hsub
  have hA : (C ((d : DualNumber B) * DualNumber.eps) * X ^ (k : ℕ)) %ₘ g.map (algebraMap B (DualNumber B)) =
      C ((d : DualNumber B) * DualNumber.eps) * X ^ (k : ℕ) := by
    refine (modByMonic_eq_self_iff hq).2 ((degree_C_mul_X_pow_le _ _).trans_lt ?_)
    rw [hg.degree_map, degree_eq_natDegree hg.ne_zero]
    exact_mod_cast k.2
  have hB : (C (algebraMap B (DualNumber B) t) * X) %ₘ g.map (algebraMap B (DualNumber B)) =
      C (algebraMap B (DualNumber B) t) * (X %ₘ g).map (algebraMap B (DualNumber B)) := by
    rw [← smul_eq_C_mul, smul_modByMonic, smul_eq_C_mul]
    congr 1
    rw [map_modByMonic _ hg, map_X]
  rw [hsub, hA, hB, coeff_sub, coeff_C_mul_X_pow, coeff_C_mul, coeff_map] at key
  by_cases hjk : j = k
  · subst hjk
    rw [if_pos rfl] at key
    have k1 := congrArg TrivSqZeroExt.fst key
    have k2 := congrArg TrivSqZeroExt.snd key
    simp [TrivSqZeroExt.algebraMap_eq_inl] at k1 k2
    refine ⟨?_, ?_⟩
    · first | linear_combination k1 | linear_combination -k1
    · rw [if_pos rfl]
      first | linear_combination k2 | linear_combination -k2
  · have hjk' : (j : ℕ) ≠ k := fun h => hjk (Fin.ext h)
    rw [if_neg hjk'] at key
    have k1 := congrArg TrivSqZeroExt.fst key
    have k2 := congrArg TrivSqZeroExt.snd key
    simp [TrivSqZeroExt.algebraMap_eq_inl] at k1 k2
    refine ⟨?_, ?_⟩
    · first | linear_combination k1 | linear_combination -k1
    · rw [if_neg hjk]
      first | linear_combination k2 | linear_combination -k2

end UK

end RamanujanPetersson.EtPBC.EtKum

end

end

-- ===== S4.Def_RP_EtPBC_A_O2T9a =====
section

/-!
# S4-EtPBC-A, O2 S6a (O2T9a): naturality of `resFreeIso` and `clsD` in the coefficients; `clsD` is one-point

* `resFreeIso_natural r`: `resFreeIso_{T'} ≫ res Λ[r] = Λ[e⁻¹ r] ≫ resFreeIso_T`;
* `clsD_natF f h Y`: `clsD (f ≫ res h) Y = clsD f Y ∘ h` for `h : F' ⟶ F` on `P`;
* **`clsD_isLoc`**: every `clsD f Y` is a one-point class `IsLoc` at `c (X = a)`.
-/

