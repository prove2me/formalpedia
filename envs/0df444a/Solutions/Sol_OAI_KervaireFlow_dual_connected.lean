variable {D Z : Type*}


theorem solution (b : D → Z) (hb : Function.Surjective b)
    (σ θ : Equiv.Perm D) (hθ : ∀ d, θ (θ d) = d)
    (hcycle : ∀ d, b (σ (θ d)) = b d)
    (hconn : ∀ d e, Relation.ReflTransGen (fun d e => e = σ d ∨ e = θ d) d e) :
    ∀ x y, Relation.ReflTransGen (Adj b θ) x y := by
  intro x y
  obtain ⟨d, rfl⟩ := hb x
  obtain ⟨e, rfl⟩ := hb y
  refine Relation.ReflTransGen.lift (p := Adj b θ) b ?_ d e (hconn d e)
  rintro a c (rfl | rfl)
  · refine ⟨a, rfl, ?_⟩
    have := hcycle (θ a)
    rw [hθ] at this
    exact this.symm
  · exact ⟨a, rfl, rfl⟩

