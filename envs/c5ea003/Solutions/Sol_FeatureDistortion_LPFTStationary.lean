  let ε : ℝ := 1 / (2 * ((K : ℝ) + 1))
  have hε : 0 < ε := by dsimp [ε]; positivity
  have hlocal (x : E) : ∃ γ : ℝ → E,
      γ 0 = x ∧ IsMIntegralCurveOn (I := 𝓘(ℝ, E)) γ (fun x ↦ F x) (Ioo (-ε) ε) := by
    let a : ℝ≥0 := 1 + ‖F x‖₊
