-- Source module: Solutions.J6SegJCost2
/-!
# J cost 2: the stream sizes of the `J` kernel from a window bound

For a sorted line `L` (`m = |L|`) whose windows `[x, x + mw]` hold at most `W0` positions and
with at most `Bd` border positions (`≥ c`), the part cost of the `J` kernel is
**`partC_le`**: `partC k K G fs bs cc u ≤ (4m(W0+Bd) + 2m(2K+1) + 22m + G + 3K + 13) u`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK
open IntMul NLogN NLogN.KIL Function J6Seg

theorem length_flatMap_sum {α : Type*} (d : α) (f : α → List ℤ) :
    ∀ l : List α, (l.flatMap f).length = ∑ r ∈ range l.length, (f (l.getD r d)).length
  | [] => by simp
  | a :: l => by
    rw [List.flatMap_cons, List.length_append, length_flatMap_sum d f l, List.length_cons,
      sum_range_succ']
    simp only [List.getD_cons_succ, List.getD_cons_zero]
    ring

theorem flatT_length (l : List (List ℤ)) :
    (flatT l).length = ∑ r ∈ range l.length, ((l.getD r []).length + 1) := by
  unfold flatT
  rw [length_flatMap_sum [] rowT l]
  apply sum_congr rfl; intro r _; simp [rowT]

theorem flatB_length (k : ℕ) (bs : List (List ℤ × List ℤ × ℤ × ℤ)) :
    (flatB k bs).length = ∑ j ∈ range bs.length, (recL bs j + 5) := by
  unfold flatB
  rw [length_flatMap_sum ([], [], 0, 0) (recT k) bs]
  apply sum_congr rfl; intro j _; simp [recT, rowT, recL]; ring

section gen
variable {L : List ℕ} {mw c : ℕ}

theorem cfOf_le_win (hsort : L.Pairwise (· < ·)) {r : ℕ} (hr : r < L.length) (hb : ¬ c ≤ L.getD r 0) :
    cfOf L mw c r ≤ ((range L.length).filter
      (fun q => L.getD r 0 - mw ≤ L.getD q 0 ∧ L.getD q 0 ≤ L.getD r 0 - mw + mw)).card := by
  unfold cfOf
  rw [if_neg hb]
  apply card_le_card
  intro q hq
  simp only [mem_filter, mem_range] at hq ⊢
  have := getD_lt_getD hsort hq.1 hr
  refine ⟨by omega, by omega, by omega⟩

theorem WbOf_le_win (hsort : L.Pairwise (· < ·)) {r : ℕ} (hr : r < L.length) :
    WbOf L mw r ≤ ((range L.length).filter
      (fun q => L.getD r 0 ≤ L.getD q 0 ∧ L.getD q 0 ≤ L.getD r 0 + mw)).card := by
  unfold WbOf
  apply card_le_card
  intro q hq
  simp only [mem_filter, mem_Ioo, mem_range] at hq ⊢
  have := getD_lt_getD hsort hq.1.1 hq.1.2
  refine ⟨hq.1.2, by omega, hq.2⟩

theorem bIdx_le (r : ℕ) :
    (bIdx L (c ≤ ·) r).length ≤ ((range L.length).filter (fun q => c ≤ L.getD q 0)).card := by
  unfold bIdx
  rw [← List.toFinset_card_of_nodup ((List.nodup_range' 1 (by norm_num)).filter _)]
  apply card_le_card
  intro q hq
  simp only [List.mem_toFinset, List.mem_filter, List.mem_range', decide_eq_true_eq] at hq
  simp only [mem_filter, mem_range]
  obtain ⟨⟨i, hi, rfl⟩, hf⟩ := hq
  refine ⟨by omega, ?_⟩
  unfold flOf at hf
  split_ifs at hf with h
  · exact h
  · simp at hf

variable (W0 Bd : ℕ)

theorem sum_cfOf (hsort : L.Pairwise (· < ·))
    (hW : ∀ x, ((range L.length).filter (fun q => x ≤ L.getD q 0 ∧ L.getD q 0 ≤ x + mw)).card ≤ W0)
    (hBd : ((range L.length).filter (fun q => c ≤ L.getD q 0)).card ≤ Bd) :
    ∑ r ∈ range L.length, cfOf L mw c r ≤ L.length * W0 + L.length * Bd := by
  have h1 : ∀ r ∈ range L.length, cfOf L mw c r ≤
      W0 + (if c ≤ L.getD r 0 then L.length else 0) := by
    intro r hr
    rw [mem_range] at hr
    by_cases hb : c ≤ L.getD r 0
    · rw [if_pos hb]; unfold cfOf; rw [if_pos hb]; omega
    · rw [if_neg hb]; exact (cfOf_le_win hsort hr hb).trans (hW _) |>.trans (by omega)
  refine (sum_le_sum h1).trans ?_
  rw [sum_add_distrib, sum_const, card_range, smul_eq_mul, ← sum_filter, sum_const, smul_eq_mul]
  have := Nat.mul_le_mul_right L.length hBd
  rw [Nat.mul_comm Bd] at this
  omega

theorem fsOf_sum (hsort : L.Pairwise (· < ·)) (P : ℕ) (A : ℕ → ℕ → ℤ)
    (hW : ∀ x, ((range L.length).filter (fun q => x ≤ L.getD q 0 ∧ L.getD q 0 ≤ x + mw)).card ≤ W0)
    (hBd : ((range L.length).filter (fun q => c ≤ L.getD q 0)).card ≤ Bd) :
    ∑ r ∈ range (fsOf P L mw c A).length, ((fsOf P L mw c A).getD r []).length ≤
      L.length * W0 + L.length * Bd := by
  rw [fsOf_length]
  refine le_trans (le_of_eq (sum_congr rfl fun r hr => ?_)) (sum_cfOf W0 Bd hsort hW hBd)
  rw [mem_range] at hr
  rw [List.getD_eq_getElem _ _ (by rw [fsOf_length]; exact hr), fsOf_getElem]
  simp [fsW]

theorem bsOf_sum (hsort : L.Pairwise (· < ·)) (P : ℕ) (A : ℕ → ℕ → ℤ)
    (hW : ∀ x, ((range L.length).filter (fun q => x ≤ L.getD q 0 ∧ L.getD q 0 ≤ x + mw)).card ≤ W0)
    (hBd : ((range L.length).filter (fun q => c ≤ L.getD q 0)).card ≤ Bd) :
    ∑ j ∈ range (bsOf P L mw c A).length, recL (bsOf P L mw c A) j ≤
      L.length * W0 + L.length * Bd := by
  rw [bsOf_length]
  have h1 : ∀ j ∈ range L.length, recL (bsOf P L mw c A) j ≤ W0 + Bd := by
    intro j hj
    rw [mem_range] at hj
    unfold recL
    rw [List.getD_eq_getElem _ _ (by rw [bsOf_length]; exact hj), bsOf_getElem]
    simp only [cbOf, czOf, List.length_map, List.length_range]
    have h1 := (WbOf_le_win (mw := mw) hsort (r := L.length - 1 - j) (by omega)).trans (hW _)
    have h2 := (bIdx_le (L := L) (c := c) (L.length - 1 - j)).trans hBd
    omega
  refine (sum_le_sum h1).trans ?_
  rw [sum_const, card_range, smul_eq_mul]; ring_nf; omega

/-- **The part cost.** -/
theorem partC_le (hsort : L.Pairwise (· < ·)) (P k K G u : ℕ) (A : ℕ → ℕ → ℤ)
    (cc : List (List ℤ)) (hcl : cc.length = L.length)
    (hcc : ∀ r < cc.length, (cc.getD r []).length = 2 * K + 1)
    (hW : ∀ x, ((range L.length).filter (fun q => x ≤ L.getD q 0 ∧ L.getD q 0 ≤ x + mw)).card ≤ W0)
    (hBd : ((range L.length).filter (fun q => c ≤ L.getD q 0)).card ≤ Bd) :
    partC k K G (fsOf P L mw c A) (bsOf P L mw c A) cc u ≤
      (4 * L.length * (W0 + Bd) + 2 * L.length * (2 * K + 1) + 22 * L.length + G + 3 * K + 13) *
        u := by
  unfold partC
  apply Nat.mul_le_mul_right
  have hF := fsOf_sum W0 Bd hsort P A hW hBd
  have hB := bsOf_sum W0 Bd hsort P A hW hBd
  have hC : ∑ r ∈ range cc.length, (cc.getD r []).length = L.length * (2 * K + 1) := by
    rw [sum_congr rfl (fun r hr => hcc r (mem_range.1 hr)), sum_const, card_range, smul_eq_mul,
      hcl]
  unfold jBody
  simp only [List.length_append, flatT_length, flatB_length, sum_add_distrib, sum_const,
    card_range, smul_eq_mul, fsOf_length, bsOf_length, hcl] at hF hB hC ⊢
  have e : 4 * L.length * (W0 + Bd) = 4 * (L.length * W0 + L.length * Bd) := by ring
  have e2 : 2 * L.length * (2 * K + 1) = 2 * (L.length * (2 * K + 1)) := by ring
  rw [e, e2]
  omega

end gen

end J6Seg.JK

end

