section Gauge

variable {d : Type*} [Fintype d] {W : Type*} [Fintype W]

private theorem norm_mFourierCoeff_le_of_gauge {f : UnitAddTorus d → ℂ} (v : (d → ℤ) →+ (W → ℝ)) {k : ℕ} {B : ℝ}
    (hB : ∀ m w, |v m w| ^ k * ‖mFourierCoeff f m‖ ≤ B) {m : d → ℤ} (hm : 0 < ‖v m‖) :
    ‖mFourierCoeff f m‖ ≤ B * ‖v m‖⁻¹ ^ k := by
  obtain ⟨w, hw⟩ : ∃ w, ‖v m‖ ≤ |v m w| := by
    by_contra h
    simp only [not_exists, not_le] at h
    exact absurd ((pi_norm_lt_iff hm).mpr fun w => by rw [Real.norm_eq_abs]; exact h w) (lt_irrefl _)
  have hw' : |v m w| = ‖v m‖ :=
    le_antisymm (by simpa only [Real.norm_eq_abs] using norm_le_pi_norm (v m) w) hw
  have hpow : 0 < ‖v m‖ ^ k := pow_pos hm k
  have h := hB m w
  rw [hw'] at h
  calc ‖mFourierCoeff f m‖ = (‖v m‖ ^ k)⁻¹ * (‖v m‖ ^ k * ‖mFourierCoeff f m‖) := by
        field_simp
    _ ≤ (‖v m‖ ^ k)⁻¹ * B := mul_le_mul_of_nonneg_left h (by positivity)
    _ = B * ‖v m‖⁻¹ ^ k := by rw [inv_pow, mul_comm]

private theorem summable_and_tsum_norm_mFourierCoeff_le_of_gauge {f : UnitAddTorus d → ℂ} (v : (d → ℤ) →+ (W → ℝ))
    {k : ℕ} (hk : Fintype.card W < k) {B : ℝ} (hB0 : 0 ≤ B) {r : ℝ} (hr : 0 < r)
    (hB : ∀ m w, |v m w| ^ k * ‖mFourierCoeff f m‖ ≤ B) (hfar : ∀ m, m ≠ 0 → r ≤ ‖v m‖) :
    Summable (mFourierCoeff f) ∧
      ∑' m : {m : d → ℤ // m ≠ 0}, ‖mFourierCoeff f m‖ ≤ B * ((3 / r) ^ k * latticeConst W k) := by
  have hk0 : k ≠ 0 := by omega

  set b : (d → ℤ) → ℝ := fun m => B * ‖v m‖⁻¹ ^ k with hb_def
  have hle : ∀ m, m ≠ 0 → ‖mFourierCoeff f m‖ ≤ b m := fun m hm =>
    norm_mFourierCoeff_le_of_gauge v hB (hr.trans_le (hfar m hm))
  have hb0 : b 0 = 0 := by
    simp only [hb_def, map_zero, norm_zero, inv_zero, zero_pow hk0, mul_zero]

  have hsep : ∀ i j : {m : d → ℤ // m ≠ 0}, i ≠ j → r ≤ ‖v i - v j‖ := fun i j hij => by
    rw [← map_sub]
    exact hfar _ (sub_ne_zero.mpr fun h => hij (Subtype.ext h))
  obtain ⟨hsumP, htsumP⟩ :=
    summable_and_tsum_inv_norm_pow_le_of_separated (v := fun i : {m : d → ℤ // m ≠ 0} => v i) hr hsep
      (fun i => hfar i.1 i.2) hk
  have hbsub : Summable fun i : {m : d → ℤ // m ≠ 0} => b i := hsumP.mul_left B

  have hb : Summable b := by
    refine (Subtype.val_injective.summable_iff (f := b) fun m hm => ?_).mp hbsub
    have hm0 : m = 0 := by
      by_contra h
      exact hm ⟨⟨m, h⟩, rfl⟩
    rw [hm0, hb0]

  have hsum : Summable (mFourierCoeff f) := by
    refine summable_mFourierCoeff_of_norm_le
      (b := fun m => b m + if m = 0 then ‖mFourierCoeff f 0‖ else 0)
      (hb.add (summable_of_ne_finset_zero (s := {0}) fun m hm => if_neg (by simpa using hm))) fun m => ?_
    by_cases hm : m = 0
    · subst hm
      show ‖mFourierCoeff f 0‖ ≤ b 0 + (if (0 : d → ℤ) = 0 then ‖mFourierCoeff f 0‖ else 0)
      rw [if_pos rfl, hb0, zero_add]
    · show ‖mFourierCoeff f m‖ ≤ b m + (if m = 0 then ‖mFourierCoeff f 0‖ else 0)
      rw [if_neg hm, add_zero]
      exact hle m hm
  refine ⟨hsum, ?_⟩
  calc ∑' m : {m : d → ℤ // m ≠ 0}, ‖mFourierCoeff f m‖ ≤ ∑' m : {m : d → ℤ // m ≠ 0}, b m :=
        (summable_norm_mFourierCoeff_off_zero hsum).tsum_le_tsum (fun m => hle m.1 m.2) hbsub
    _ = B * ∑' m : {m : d → ℤ // m ≠ 0}, ‖v m‖⁻¹ ^ k := tsum_mul_left
    _ ≤ B * ((3 / r) ^ k * latticeConst W k) := mul_le_mul_of_nonneg_left htsumP hB0

private theorem norm_apply_sub_mFourierCoeff_torusLift_zero_le_of_gauge {A : Type*} [AddCommGroup A] [TopologicalSpace A]
    {Θ : A →+ UnitAddTorus d} (hΘ : IsOpenQuotientMap Θ) {H : A → ℂ} (hH : IsKerPeriodic Θ H) (hc : Continuous H)
    (v : (d → ℤ) →+ (W → ℝ)) {k : ℕ} (hk : Fintype.card W < k) {B : ℝ} (hB0 : 0 ≤ B) {r : ℝ} (hr : 0 < r)
    (hB : ∀ m w, |v m w| ^ k * ‖mFourierCoeff (torusLift Θ hΘ.surjective H) m‖ ≤ B)
    (hfar : ∀ m, m ≠ 0 → r ≤ ‖v m‖) (a : A) :
    ‖H a - mFourierCoeff (torusLift Θ hΘ.surjective H) 0‖ ≤ B * ((3 / r) ^ k * latticeConst W k) := by
  obtain ⟨hsum, htsum⟩ :=
    summable_and_tsum_norm_mFourierCoeff_le_of_gauge (f := torusLift Θ hΘ.surjective H) v hk hB0 hr hB hfar
  exact (norm_apply_sub_mFourierCoeff_torusLift_zero_le hΘ hH hc hsum a).trans htsum

