open OAI

set_option autoImplicit false

/-!
# Actual realization of the two-stage small Hilbert tower

The first small Hilbert class field is the actual finite abelian
subextension selected in `HilbertClassFieldRealization`.  Over its actual
fixed field, the closed finite-index small-Hilbert norm subgroup has a
finite Galois norm neighbourhood.  We embed that neighbourhood in the
rational separable closure compatibly with the already chosen first
stage.  Finite abelian classification then selects the second small
Hilbert class field over the literal first-stage subgroup.

The compatibility of the embedding is essential: an unrelated chosen
copy of the middle number field would produce a class field over a
conjugate closed subgroup rather than over the first-stage subgroup
itself.
-/

open scoped Classical NumberField

noncomputable section

namespace GlobalClassFieldTheory
namespace IdealClassFieldTheory

open AlgebraicNumberTheory
open ClassFormation
open CyclicCohomology
open GlobalClassFields
open KummerTheory
open LocalClassFieldTheory
open RamificationTheory
open Reciprocity

/-- The ordinary idèle-class operations used by the two-stage transport,
fixed at the canonical principal-subgroup quotient. -/
@[instance_reducible]
private noncomputable def smallHilbertTowerIdeleClassCommGroup
    (F : Type) [Field F] [NumberField F] :
    CommGroup (IdeleClassGroup F) :=
  QuotientGroup.Quotient.commGroup (IdeleGroup.principalSubgroup F)

attribute [local instance] smallHilbertTowerIdeleClassCommGroup

end IdealClassFieldTheory
end GlobalClassFieldTheory
end
end

section
-- module Solutions.OAIQ244_DUKE.DukePrimeDegree_Arithmetic_ClassFieldBridge
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-!
# The arithmetic Artin map realizes the actual ideal character

Prime-to-modulus ideals are generated by primes outside the modulus.
At unramified primes the arithmetic Artin element agrees with the
Frobenius used by the ideal-character Dirichlet series. Thus principal
ray ideals lie in the kernel of the actual ideal character.
-/

noncomputable section
open scoped NumberField Classical

namespace DukePrimeDegree

open GlobalClassFieldTheory GlobalClassFieldTheory.GlobalClassFields
  GlobalClassFieldTheory.IdealClassFieldTheory
open PrimeDegreePackets PrimeDegreePackets.GaloisIdealCharacter

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L]
variable [Algebra K L] [FiniteDimensional K L] [IsAbelianGalois K L]

/-- Agreement at unramified primes identifies the genuine ideal
character with composition through the arithmetic Artin map. -/
theorem idealCharacter_eq_artin_comp
    (m : RayClass.Modulus K)
    (hm : m.congruenceSubgroup ≤ (ideleClassNorm K L).range)
    (hunram : ∀ v : IsDedekindDomain.HeightOneSpectrum (𝓞 K),
      v ∉ m.finitePart.support →
      Algebra.IsUnramifiedAt (𝓞 K) (primeAbove K L v).val)
    (χ : (L ≃ₐ[K] L) →* ℂˣ) :
    (idealHom K L χ).comp (RayClass.primeToModulusIdeals m).subtype =
      χ.comp (arithmeticIdealArtinGaloisMap (K := K) (L := L) m hm) := by
  apply RayClass.primeToModulusIdeals_hom_ext m
  intro v hv
  let Q := primeAbove K L v
  let w : IsDedekindDomain.HeightOneSpectrum (𝓞 L) :=
    ⟨Q.val, Q.property.1, primeAbove_ne_bot K L v⟩
  have hw : w.asIdeal.LiesOver v.asIdeal := Q.property.2
  have hwu : Algebra.IsUnramifiedAt (𝓞 K) w.asIdeal := hunram v hv
  change idealHom K L χ (FractionalIdealGroup.prime v) =
    χ (arithmeticIdealArtinGaloisMap (K := K) (L := L) m hm
      (RayClass.primeToModulusIdeal m v hv))
  rw [arithmeticIdealArtinGaloisMap_primeIdeal_eq_arithmeticFinitePlacePrimeArtin,
    ClassFieldTheory.GlobalClassFieldComparison.arithmeticPrimeArtin_eq_arithmeticFrobeniusAt v w hw hwu]
  change idealHom K L χ (integralIdealFractionalUnit v.asIdeal v.ne_bot) = _
  rw [idealHom_prime]
  rfl

/-- No extra normalization hypothesis remains for a principal ray ideal. -/
theorem idealCharacter_principalRay_eq_one
    (m : RayClass.Modulus K)
    (hm : m.congruenceSubgroup ≤ (ideleClassNorm K L).range)
    (hunram : ∀ v : IsDedekindDomain.HeightOneSpectrum (𝓞 K),
      v ∉ m.finitePart.support →
      Algebra.IsUnramifiedAt (𝓞 K) (primeAbove K L v).val)
    (χ : (L ≃ₐ[K] L) →* ℂˣ)
    (I : RayClass.primeToModulusIdeals m)
    (hI : I ∈ RayClass.principalRayIdealSubgroup m) :
    idealHom K L χ I = 1 := by
  have h := DFunLike.congr_fun (idealCharacter_eq_artin_comp m hm hunram χ) I
  change idealHom K L χ I = χ (arithmeticIdealArtinGaloisMap m hm I) at h
  rw [arithmetic_artin_eq_one_of_principal_ray m hm I hI, map_one] at h
  exact h

end DukePrimeDegree

end

end OAI
end

section
-- module Solutions.OAIQ244_DUKE.DukePrimeDegree_Arithmetic_ClassFieldRealization
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-!
# Unconditional even ray realization of cyclic ideal characters

The conductor of a totally real cyclic extension has no infinite part.
Arithmetic Artin reciprocity and the common rational congruence modulus
therefore supply the kernel law for every actual Frobenius ideal
character. This gives their realization as even ray characters.
-/

noncomputable section
open scoped NumberField Classical

namespace DukePrimeDegree
open GlobalClassFieldTheory GlobalClassFieldTheory.GlobalClassFields
open PrimeDegreePackets PrimeDegreePackets.GaloisIdealCharacter

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L]
variable [Algebra K L] [FiniteDimensional K L] [IsAbelianGalois K L]

theorem idealCharacter_kernelLaw_of_even_modulus_oai
    (m : RayClass.Modulus K) (hm : m.infinitePart = ∅)
    (hnorm : m.congruenceSubgroup ≤ (ideleClassNorm K L).range)
    (hunram : ∀ v : IsDedekindDomain.HeightOneSpectrum (𝓞 K),
      v ∉ m.finitePart.support →
      Algebra.IsUnramifiedAt (𝓞 K) (primeAbove K L v).val)
    (N : ℕ)
    (hN : ∀ v ∈ m.finitePart.support,
      algebraMap (𝓞 K) (v.adicCompletionIntegers K) (N : 𝓞 K) ∈
        IsLocalRing.maximalIdeal (v.adicCompletionIntegers K) ^ m.finitePart v)
    (χ : (L ≃ₐ[K] L) →* ℂˣ) : PrincipalRay.KernelLaw (idealHom K L χ) N := by
  intro a ha hcong
  let x : Kˣ := Units.mk0 (a : K) (by exact_mod_cast ha)
  have hx : IdeleGroup.principalIdele K x ∈ RayClass.idelePrimeToModulusSubgroup m :=
    principalIdele_mem_even_ray_of_congruence m hm N hN a ha hcong
  let y : RayClass.idelePrimeToModulusSubgroup m := ⟨IdeleGroup.principalIdele K x, hx⟩
  let I := RayClass.primeToIdealMap m y
  have hI : I ∈ RayClass.principalRayIdealSubgroup m := by
    refine ⟨y, ?_, rfl⟩
    exact ⟨x, rfl⟩
  have H := idealCharacter_principalRay_eq_one m hnorm hunram χ I hI
  have hval : (I : FractionalIdealGroup K) = integralIdealFractionalUnit
      (Ideal.span {a}) (by simpa only [ne_eq, Ideal.span_singleton_eq_bot] using ha) := by
    change IdeleGroup.fractionalIdeal (IdeleGroup.principalIdele K x) = _
    rw [IdeleGroup.fractionalIdeal_principalIdele]
    apply Units.ext
    rw [coe_toPrincipalIdeal]
    exact (FractionalIdeal.coeIdeal_span_singleton a).symm
  change idealHom K L χ (I : FractionalIdealGroup K) = 1 at H
  change idealHom K L χ (integralIdealFractionalUnit (Ideal.span {a}) _) = 1
  rwa [hval] at H

end DukePrimeDegree

end

end OAI
end

theorem solution : type_of% @OAI.DukePrimeDegree.idealCharacter_kernelLaw_of_even_modulus_oai := @OAI.DukePrimeDegree.idealCharacter_kernelLaw_of_even_modulus_oai
