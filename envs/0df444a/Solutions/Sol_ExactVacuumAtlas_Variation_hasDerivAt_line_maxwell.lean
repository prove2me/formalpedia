open scoped ContDiff

namespace ExactVacuumAtlas

variable {n : ℕ}

theorem christoffel_congr_of_eqOn {g g' ginv ginv' : Metric n} {V : Set (Pt n)} (hV : IsOpen V)
    (hg : ∀ i j, Set.EqOn (g i j) (g' i j) V) (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) V)
    (a b c : Fin n) : Set.EqOn (christoffel g ginv a b c) (christoffel g' ginv' a b c) V := by
  intro x hx
  unfold christoffel
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [hgi a k hx, pd_congr_of_eqOn hV hx (hg k b) c, pd_congr_of_eqOn hV hx (hg k c) b,
    pd_congr_of_eqOn hV hx (hg b c) k]

end ExactVacuumAtlas

