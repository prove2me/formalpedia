theorem solution
    (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (ℓ M' : ℕ) [Fact ℓ.Prime] (hℓ3 : 3 ≤ ℓ) [NeZero M']
    (A₀ : Type) [CommRing A₀]
    (hℓ : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (D : ModularCurve.LevelPData T), ModularCurve.IsLevelPStructure W ℓ D →
        ModularCurve.IsLevelPStructure (C • W) ℓ (D.variableChange C))
    (hM : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (p k : ℕ) (h : Polynomial T), ModularCurve.IsGamma0PowAt W p k h →
        ModularCurve.IsGamma0PowAt (C • W) p k (ModularCurve.kernelVariableChangeDeg C (ModularCurve.gamma0PowDeg p k) h))
    (𝒢 : GroupLaws A₀) (h𝒢 : 𝒢.IsChordTangent) (h𝒢O : 𝒢.IsOriginIdentity)
    (𝒯 : LevelTransport A₀ 𝒢 q) (h𝒯 : 𝒯.IsSectionTransport)
    {C C' : Type} [CommRing C] [Algebra A₀ C] [CommRing C'] [Algebra A₀ C']
    (π : C →ₐ[A₀] C') (hπ : Function.Surjective π) (hnil : ∃ n : ℕ, RingHom.ker π.toRingHom ^ n = ⊥)
    (hqC : IsUnit ((q : ℕ) : C)) (hℓC : IsUnit ((ℓ : ℕ) : C)) (hM'C : IsUnit ((M' : ℕ) : C)) :
    Function.Surjective ((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).toLevelModuliDatum.map π) := by
  classical
  have hℓ2 : ℓ ≠ 2 := by omega

  have hker : IsNilpotent (RingHom.ker π.toRingHom) := by obtain ⟨n, hn⟩ := hnil; exact ⟨n, hn⟩
  have unit_lift : ∀ c : C, IsUnit (π c) → IsUnit c := by
    intro c hc
    have hker' : IsNilpotent (RingHom.ker (π : C →+* C')) := hker
    rw [← IsNilpotent.isUnit_quotient_mk_iff hker']
    have h1 : Ideal.quotientKerAlgEquivOfSurjective hπ (Ideal.Quotient.mk (RingHom.ker (π : C →+* C')) c) = π c :=
      Ideal.quotientKerAlgEquivOfSurjective_apply hπ c
    have h2 : IsUnit (Ideal.quotientKerAlgEquivOfSurjective hπ (Ideal.Quotient.mk (RingHom.ker (π : C →+* C')) c)) := by
      rw [h1]; exact hc
    have h3 := h2.map (Ideal.quotientKerAlgEquivOfSurjective hπ).symm
    first | simpa using h3 | (simp at h3; exact h3) | exact h3
  intro y
  induction y using Quot.ind with
  | mk y' =>
  obtain ⟨W', hΔ', ⟨h', D', z'⟩, ⟨hh', hD', hz'⟩⟩ := y'

  obtain ⟨W, rfl⟩ : ∃ W : WeierstrassCurve C, W.map π.toRingHom = W' := by
    obtain ⟨a₁, h₁⟩ := hπ W'.a₁
    obtain ⟨a₂, h₂⟩ := hπ W'.a₂
    obtain ⟨a₃, h₃⟩ := hπ W'.a₃
    obtain ⟨a₄, h₄⟩ := hπ W'.a₄
    obtain ⟨a₆, h₆⟩ := hπ W'.a₆
    exact ⟨⟨a₁, a₂, a₃, a₄, a₆⟩, by cases W'; simp_all [WeierstrassCurve.map]⟩
  have hΔ : IsUnit W.Δ := by
    apply unit_lift
    have : (W.map π.toRingHom).Δ = π W.Δ := W.map_Δ π.toRingHom
    rw [← this]; exact hΔ'

  obtain ⟨h, ⟨hh1, hh2⟩, -⟩ :=
    ModularCurve.IsGamma0PowAt.existsUnique_tuple_map_eq_of_surjective_of_ker_pow_eq_bot π.toRingHom hπ hnil W hΔ M' hM'C h' hh'
  obtain ⟨D, ⟨hD1, hD2⟩, -⟩ :=
    ModularCurve.IsLevelPStructure.existsUnique_map_eq_of_surjective_of_ker_pow_eq_bot π.toRingHom hπ hnil W hΔ ℓ hℓ2 hℓC D' hD'
  obtain ⟨z, ⟨hz1, hz2⟩, -⟩ :=
    WeierstrassCurve.DrinfeldGlobal.existsUnique_isLevel_map_eq_of_surjective_of_ker_pow_eq_bot_of_isUnit_of_ne_two
      q hq2 A₀ 𝒢 h𝒢 h𝒢O 𝒯 h𝒯 π hπ hnil W hΔ hqC z' hz'
  refine ⟨Quot.mk _ ⟨W, hΔ, ⟨h, D, z⟩, ⟨hh2, hD2, hz1⟩⟩, ?_⟩
  change (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).map π (Quot.mk _ _) = _
  rw [RigidWeierstrassData.map_mk]
  congr 1
  exact LevelComponent.Raw.ext' rfl (by
    change ((fun p => (h p).map π.toRingHom), (D.map π.toRingHom, 𝒯.map π z)) = (h', (D', z'))
    rw [hh1, hD1, hz2]
    try rfl)

