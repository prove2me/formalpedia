theorem NLogN.KFY.brk_all (M : MulSpec) (l : List (Fin HS × Ex HS)) (P : RM) (t : IState HS) (j : Fin HS)
    (Z : List Item) (C B K : ℕ) (hl : PushOk l t) (hj : j ∉ l.map Prod.fst)
    (hB : ∀ p ∈ l, p.2.Bnd t B ∧ p.2.size ≤ K ∧ zsz (p.2.eval t) ≤ B)
    (hP : P.run ((NLogN.KFY.pushL l).run t) = ((NLogN.KFY.pushL l).run t).upd j Z ∧ P.ok M ((NLogN.KFY.pushL l).run t) ∧
      P.cost M ((NLogN.KFY.pushL l).run t) ≤ C) :
    (brk l P).run t = t.upd j Z ∧ (brk l P).ok M t ∧
      (brk l P).cost M t ≤ brkC l.length K B C := by sorry
