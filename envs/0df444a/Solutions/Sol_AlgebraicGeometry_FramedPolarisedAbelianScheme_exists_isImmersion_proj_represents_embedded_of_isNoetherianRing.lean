theorem holeJ {B : Type} [CommRing B] [IsNoetherianRing B] {M : ℕ}
    {H C₂ V₁ C₁ W₀ : Scheme.{0}}
    (j₄ : H ⟶ C₂) [IsOpenImmersion j₄] (j₃ : C₂ ⟶ V₁) [IsClosedImmersion j₃]
    (j₂ : V₁ ⟶ C₁) [IsOpenImmersion j₂] (j₁ : C₁ ⟶ W₀) [IsClosedImmersion j₁]
    (jW : W₀ ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B)) [IsClosedImmersion jW] :
    IsImmersion (j₄ ≫ j₃ ≫ j₂ ≫ j₁ ≫ jW) ∧ LocallyOfFiniteType (j₄ ≫ j₃ ≫ j₂ ≫ j₁ ≫ jW) ∧
      QuasiCompact (j₄ ≫ j₃ ≫ j₂ ≫ j₁ ≫ jW) := by

  haveI : IsLocallyNoetherian (Proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) B)) :=
    LocallyOfFiniteType.isLocallyNoetherian (ProjSpace.π B M)
  haveI : IsLocallyNoetherian W₀ := LocallyOfFiniteType.isLocallyNoetherian jW
  haveI : IsLocallyNoetherian C₁ := LocallyOfFiniteType.isLocallyNoetherian j₁
  haveI : IsLocallyNoetherian V₁ := LocallyOfFiniteType.isLocallyNoetherian j₂
  haveI : IsLocallyNoetherian C₂ := LocallyOfFiniteType.isLocallyNoetherian j₃
  haveI : QuasiCompact j₄ := inferInstance
  haveI : QuasiCompact j₂ := inferInstance
  exact ⟨inferInstance, inferInstance, inferInstance⟩

