abbrev QSpec {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} (E : FakeEllipticCurve Λ 1 (AlgebraicClosure ℚ))
    (H : Set (SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f))
    (C : FakeEllipticCurve Λ 1 (AlgebraicClosure ℚ)) (p : E.A ⟶ C.A) (hp : p ≫ C.f = E.f) (K : Scheme.{0}) (κ : K ⟶ E.A) : Prop :=
      (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (P Q : SchemeHomOver t E.f),
        mapPt p hp (E.L.mul t P Q) = C.L.mul t (mapPt p hp P) (mapPt p hp Q)) ∧
      (∀ x : ↥Λ, E.act x ≫ p = p ≫ C.act x) ∧
      IsFinite p ∧ Flat p ∧ Surjective p ∧
      (∀ R : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) C.f, ∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f, mapPt p hp P = R) ∧
      IsClosedImmersion κ ∧ IsReduced K ∧ IsFinite (κ ≫ E.f) ∧
      (∀ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f, FactorsThrough κ P ↔ P ∈ H) ∧
      (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q : SchemeHomOver t E.f),
        mapPt p hp Q = C.L.one t ↔ FactorsThrough κ Q)

theorem spec_id {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} (E : FakeEllipticCurve Λ 1 (AlgebraicClosure ℚ)) :
    QSpec E {E.L.one (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))} E (𝟙 E.A) (Category.id_comp _)
      (Spec (CommRingCat.of (AlgebraicClosure ℚ))) (E.L.one (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1 := by
  have mapPt_id : ∀ {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))} (P : SchemeHomOver t E.f),
      mapPt (𝟙 E.A) (Category.id_comp _) P = P := fun P => Subtype.ext (by simp [mapPt])
  set e₀ := (E.L.one (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))).1 with he₀
  have he₀f : e₀ ≫ E.f = 𝟙 _ := (E.L.one (𝟙 _)).2
  haveI : IsProper E.f := E.bundle.proper
  haveI : IsClosedImmersion (e₀ ≫ E.f) := by rw [he₀f]; infer_instance
  haveI hci : IsClosedImmersion e₀ := IsClosedImmersion.of_comp e₀ E.f
  have hone_t : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))), (E.L.one t).1 = t ≫ e₀ := by
    intro T t
    have hn := GoodReductionJacobian.RelativeGroupLaw.one_natural E.L (𝟙 _) t t (Category.comp_id _)
    rw [← hn]; rfl
  have hFT : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q : SchemeHomOver t E.f),
      FactorsThrough e₀ Q ↔ Q = E.L.one t := by
    intro T t Q
    constructor
    · rintro ⟨c, hc⟩
      apply Subtype.ext
      rw [hone_t, ← hc]
      congr 1
      rw [← Category.comp_id c, ← he₀f, ← Category.assoc, hc]; exact Q.2
    · rintro rfl; exact ⟨t, (hone_t t).symm⟩
  refine ⟨fun t P Q => by rw [mapPt_id, mapPt_id, mapPt_id], fun x => by simp, inferInstance, inferInstance, inferInstance,
    fun R => ⟨R, mapPt_id R⟩, hci, inferInstance, by rw [he₀f]; infer_instance, ?_, ?_⟩
  · intro P; rw [hFT, Set.mem_singleton_iff]
  · intro T t Q; rw [mapPt_id, hFT]

