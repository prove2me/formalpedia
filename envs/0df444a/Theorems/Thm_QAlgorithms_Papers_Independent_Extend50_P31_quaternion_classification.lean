open QAlgorithms.Papers.Independent.Information100.P75 (phase)

variable {G A : Type*} [Group G] [Fintype G] [Fintype A] [DecidableEq A] {n : ℕ}

/-- PDF pp.24--26 Section 8.2 Eqs.(125),(127)--(134).
SOURCE CORRECTIONS: the TP Eq.(127) avoids Eq.(126)'s premature l_id=1;
Eq.(131)'s row-three final +1 is -1; Eq.(134)'s first three t4 labels are t1,t2,t3.
The cube bound is only necessary; the four tetrahedron inequalities remain the iff domain. -/
theorem quaternion_classification (U : UnitaryIrrep (QuaternionGroup 2) 2)
    (hU : U.rho = quaternionRepresentation) :
    QuaternionDecomposition U ∧ Module.finrank ℂ (representationCommutant (tensorConjugate U)) = 4 ∧
    (∀ Phi : EndMat 2, (IsIrrepCovariant U Phi ∧ IsPaperChannel Phi) ↔
      ∃ a b c : ℝ, Phi = quaternionMap a b c ∧ QuaternionCP a b c) ∧
    (∀ a b c : ℝ, IsIrrepCovariant U (quaternionMap a b c) ∧ TracePreserving (quaternionMap a b c) ∧
      quaternionMap a b c 1 = 1 ∧
      rowMatrixRepresentative (quaternionMap a b c) = tensorFour (quaternionSuperMatrix a b c) ∧
      choi (quaternionMap a b c) = tensorFour (quaternionChoiMatrix a b c) ∧
      HasOrthonormalSpectrum (choi (quaternionMap a b c)) (quaternionEigenvalues a b c) ∧
      (IsPaperChannel (quaternionMap a b c) ↔ QuaternionCP a b c) ∧
      quaternionTransform.mulVec ![1,(a:ℂ),(b:ℂ),(c:ℂ)] =
        (fun r => (quaternionEigenvalues a b c r : ℂ)) ∧
      quaternionTransform.mulVec (fun r => (quaternionEigenvalues a b c r : ℂ)) =
        ![1,(a:ℂ),(b:ℂ),(c:ℂ)] ∧
      (∑ r : Fin 4, quaternionEigenvalues a b c r) = 2 ∧
      (QuaternionCP a b c → |a| ≤ 1 ∧ |b| ≤ 1 ∧ |c| ≤ 1 ∧
        QAlgorithms.IsKrausFamily (quaternionKraus a b c) ∧
        (∑ r : Fin 4, quaternionKraus a b c r * (quaternionKraus a b c r)ᴴ) = 1 ∧
        ∀ X : Mat 2, quaternionMap a b c X = QAlgorithms.krausApply (quaternionKraus a b c) X)) ∧
    quaternionTransformᵀ = quaternionTransform ∧ quaternionTransform * quaternionTransform = 1 := by sorry

end QAlgorithms.Papers.Independent.Extend50.P31

end
