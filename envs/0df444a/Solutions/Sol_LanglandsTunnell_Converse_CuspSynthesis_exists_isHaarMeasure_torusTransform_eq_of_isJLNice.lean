  have hI : ∫ z in d020 S, ‖d043 archR archC dR dC epsS dF 1 g μ s z‖
        ∂(NumberField.Idele.idelicHaar K) =
      ‖((ideleNorm K (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) :
            ℝ) : ℂ) ^ s‖ *
        ∫ z in d020 S, ‖d043 archR archC dR dC epsS dF r g μ s z‖ ∂(NumberField.Idele.idelicHaar
              K) := by
    rw [← t0486 S (fun z => ‖d043 archR archC dR dC epsS dF 1 g μ s z‖)
      (t0484 (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r))]
    simp only [t0485 archR archC dR dC dF r g μ s, norm_mul, hμu, one_mul]
    exact integral_const_mul _ _
  calc _ = ‖d.a r‖ * (‖sWeight K S μ r (s + 1 / 2)‖ *
          ‖((ideleNorm K (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K)
                r)) : ℝ) : ℂ) ^ s‖) *
        ∫ z in d020 S, ‖d043 archR archC dR dC epsS dF r g μ s z‖ ∂(NumberField.Idele.idelicHaar
              K) := by
          rw [hw, mul_one]
    _ = ‖d.a r‖ * ‖sWeight K S μ r (s + 1 / 2)‖ *
        (‖((ideleNorm K (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) :
              ℝ) : ℂ) ^ s‖ *
          ∫ z in d020 S, ‖d043 archR archC dR dC epsS dF r g μ s z‖
                ∂(NumberField.Idele.idelicHaar K)) := by
