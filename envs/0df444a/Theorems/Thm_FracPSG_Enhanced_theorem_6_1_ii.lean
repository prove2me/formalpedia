-- title:
--   Theorem 6.1(ii) — the iterates are bounded and asymptotically regular
-- statement:
--   Let $(x_n)$ be generated by Algorithm 2 under Assumptions 1 and 2′, and suppose $S_0=\{x\in S: f(x)/g(x)\le f(x_0)/g(x_0)\}$ is bounded. Then $(x_n)_{n\in\mathbb N}$ is bounded and asymptotically regular, i.e. $\|x_{n+1}-x_n\|\to0$. In particular,
--   $$\sum_{n=0}^{+\infty}\|x_{n+1}-x_n\|^2<+\infty .$$
--
--   Asymptotic regularity is what lets the analysis pass to the limit along subsequences in part (iii).
-- source:
--   Boţ, Dao, Li, Extrapolated Proximal Subgradient Algorithms for Nonconvex and Nonsmooth Fractional Programs, arXiv:2003.04124v2, p. 22, Theorem 6.1(ii)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_FracPSG_Enhanced_Basic
import Definitions.Def_FracPSG_Enhanced_Algorithm2

open Filter Topology
open scoped InnerProductSpace

namespace FracPSG.Enhanced

open NonconvexSplitting.Shared

/-- Theorem 6.1(ii) (Boţ–Dao–Li, arXiv:2003.04124v2, p. 22): for a run of Algorithm 2 under
Assumptions 1 and 2′ with bounded `S₀`, the iterates are bounded and asymptotically regular
(`‖xₙ₊₁ − xₙ‖ → 0`); in particular `Σ ‖xₙ₊₁ − xₙ‖² < +∞`. -/
theorem theorem_6_1_ii
    {N p : ℕ} [NeZero p] {S : Set (EuclideanSpace ℝ (Fin N))}
    {fs : EuclideanSpace ℝ (Fin N) → ℝ} {fn : EuclideanSpace ℝ (Fin N) → EReal}
    {gi : Fin p → EuclideanSpace ℝ (Fin N) → ℝ} {ℓ β δ ζ ε μbar κbar m M : ℝ}
    {x : ℕ → EuclideanSpace ℝ (Fin N)} {w : ℕ → Fin p → EuclideanSpace ℝ (Fin N)}
    {ihat : ℕ → Fin p} {τ κ μ : ℕ → ℝ}
    (hS : IsClosed S) (hSconv : Convex ℝ S)
    (hA1 : FracPSG.Subseq.Assumption1 S fs fn ℓ) (hA2 : Assumption2' S (FracPSG.Subseq.objF fs fn) gi β m M)
    (hpar : Step1Params ℓ β δ ε ζ μbar κbar m M)
    (hrun : IsEnhancedRun S fs fn gi ℓ β δ ζ ε μbar κbar m M x w ihat τ κ μ)
    (hS0 : Bornology.IsBounded (FracPSG.Subseq.S0 S (FracPSG.Subseq.objF fs fn) (maxFn gi) (x 0))) :
    Bornology.IsBounded (Set.range x) ∧
    Tendsto (fun n => ‖x (n + 1) - x n‖) atTop (𝓝 0) ∧
    Summable (fun n => ‖x (n + 1) - x n‖ ^ 2) := by sorry

end FracPSG.Enhanced
