def fnd (d : ℕ) : ℕ × ℕ × ℕ :=
  match ktree.find d with
  | some x => x
  | none => (0, 0, 0)

def lower (d : ℕ) : ℚ := -((fnd d).2.1 : ℚ) / 10 ^ 20

def upper (d : ℕ) : ℚ := -((fnd d).2.2 : ℚ) / 10 ^ 20

def L5 : ℚ := 80471895621701628147 / 50000000000000000000

theorem log_ok : ∀ x ∈ ktree.toList,
    let q : ℚ := (x.1 : ℚ) / 10 ^ 12
    let k : ℤ := (x.2.1 : ℤ)
    let n := 14
    let t := ((2 : ℚ) ^ k * q - 1) / ((2 : ℚ) ^ k * q + 1)
    let twoCenter := 2 * ∑ i ∈ Finset.range n, (1 / 3 : ℚ) ^ (2 * i + 1) / (2 * i + 1)
    let twoError := 2 * ((1 / 3 : ℚ) ^ (2 * n + 1) / (1 - (1 / 3 : ℚ) ^ 2))
    let center := (2 * ∑ i ∈ Finset.range n, t ^ (2 * i + 1) / (2 * i + 1)) -
      (k : ℚ) * twoCenter
    let error := 2 * (|t| ^ (2 * n + 1) / (1 - t ^ 2)) + |(k : ℚ)| * twoError
    (-((x.2.2.1 : ℚ)) / 10 ^ 20) ≤ center - error ∧ center + error ≤ -((x.2.2.2 : ℚ)) / 10 ^ 20 := by
  decide +kernel

theorem fnd_spec (d : ℕ) (h : (ktree.find d).isSome = true) :
    ∃ x ∈ ktree.toList, x.1 = d ∧ fnd d = x.2 := by
  obtain ⟨v, hv⟩ := Option.isSome_iff_exists.mp h
  refine ⟨(d, v), KT.find_mem _ _ _ hv, rfl, ?_⟩
  unfold fnd; rw [hv]

theorem log_bounds (d : ℕ) (hd : 0 < d) (h : (ktree.find d).isSome = true) :
    ((lower d : ℚ) : ℝ) ≤ Real.log (((d : ℚ) / 10 ^ 12 : ℚ) : ℝ) ∧
      Real.log (((d : ℚ) / 10 ^ 12 : ℚ) : ℝ) ≤ ((upper d : ℚ) : ℝ) := by
  obtain ⟨x, hmem, hx1, hx2⟩ := fnd_spec d h
  have hl := log_ok x hmem
  have hq : 0 < (x.1 : ℚ) / 10 ^ 12 := by
    rw [hx1]; exact div_pos (by exact_mod_cast hd) (by norm_num)
  have := mme_rational_log_series_certificate ((x.1 : ℚ) / 10 ^ 12) hq (x.2.1 : ℤ) 14
    (-((x.2.2.1 : ℚ)) / 10 ^ 20) (-((x.2.2.2 : ℚ)) / 10 ^ 20) hl.1 hl.2
  unfold lower upper
  rw [hx2, ← hx1]
  exact this

theorem cell_ok : ∀ z : Z, (∑ w, dv z.1 w = 10 ^ 12) ∧
    ∀ w : CompleteSplit.CompleteWord 2, dv z.1 w ≠ 0 →
      (ktree.find (dv z.1 w)).isSome = true := by
  decide +kernel

def g (z : Z) : ℚ :=
  (Mc z.1 : ℚ) * (-(∑ w, pq z.1 w * upper (dv z.1 w))) +
    ((Mc z.1 / D * ∑ w, dv z.1 w * Boundary.ones w : ℕ) : ℚ) * L5

theorem sum_ok : ((2085458999691735000000000000000000000000000000000000000000000 : ℕ) : ℚ) ≤ ∑ z : Z, g z := by
  decide +kernel

theorem cell_bound (z : Z) :
    ((g z : ℚ) : ℝ) ≤ MME.RegionRate.massEntropy (fun w ↦ (mu3 2 (md z.1) z.1 w : ℝ)) +
      ((∑ w, mu3 2 (md z.1) z.1 w * Boundary.ones w : ℕ) : ℝ) * Real.log 5 := by
  obtain ⟨hsum, hin⟩ := cell_ok z
  have hMD : ((Mc z.1 / D : ℕ) : ℝ) * 10 ^ 12 = (Mc z.1 : ℝ) := by
    have := Nat.div_mul_cancel (D_dvd z.1)
    have hD : (D : ℝ) = 10 ^ 12 := by norm_num [D]
    rw [← hD]; exact_mod_cast this
  have hfun : (fun w ↦ (mu3 2 (md z.1) z.1 w : ℝ)) =
      fun w ↦ (Mc z.1 : ℝ) * ((pq z.1 w : ℚ) : ℝ) := by
    funext w
    rw [mu3_eq, ← hMD]
    unfold pq
    push_cast
    field_simp
  have hpsum : ∑ w, ((pq z.1 w : ℚ) : ℝ) = 1 := by
    unfold pq
    push_cast
    rw [← Finset.sum_div]
    have : (∑ w, (dv z.1 w : ℝ)) = 10 ^ 12 := by exact_mod_cast hsum
    rw [this]
    norm_num
  have hME : MME.RegionRate.massEntropy (fun w ↦ (mu3 2 (md z.1) z.1 w : ℝ)) =
      (Mc z.1 : ℝ) * MME.RegionRate.entropy (fun w ↦ ((pq z.1 w : ℚ) : ℝ)) := by
    rw [hfun]
    exact C8Gen.massEntropy_smul _ _ hpsum
  have hOnes : (∑ w, mu3 2 (md z.1) z.1 w * Boundary.ones w) =
      Mc z.1 / D * ∑ w, dv z.1 w * Boundary.ones w := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro w _
    rw [mu3_eq, mul_assoc]
  have hlog : ∀ w, 0 < pq z.1 w →
      ((lower (dv z.1 w) : ℚ) : ℝ) ≤ Real.log (pq z.1 w : ℝ) ∧
        Real.log (pq z.1 w : ℝ) ≤ ((upper (dv z.1 w) : ℚ) : ℝ) := by
    intro w hp
    have hd : 0 < dv z.1 w := by
      unfold pq at hp
      by_contra h0
      push_neg at h0
      have : dv z.1 w = 0 := by omega
      rw [this] at hp
      norm_num at hp
    exact log_bounds (dv z.1 w) hd (hin w hd.ne')
  have hEnt := (mme_rational_entropy_log_bounds (pq z.1)
    (fun w ↦ div_nonneg (Nat.cast_nonneg _) (by norm_num)) (fun w ↦ lower (dv z.1 w))
    (fun w ↦ upper (dv z.1 w)) hlog).1
  have h5 : ((L5 : ℚ) : ℝ) ≤ Real.log 5 := C8Gen.log5_lower L5 (by decide +kernel)
  rw [hME, hOnes]
  unfold g
  generalize (-(∑ w, pq z.1 w * upper (dv z.1 w)) : ℚ) = E at hEnt ⊢
  generalize (Mc z.1 / D * ∑ w, dv z.1 w * Boundary.ones w) = A
  generalize Mc z.1 = M
  have hM : (0 : ℝ) ≤ M := Nat.cast_nonneg M
  have t1 := mul_le_mul_of_nonneg_left hEnt hM
  have t2 := mul_le_mul_of_nonneg_left h5 (Nat.cast_nonneg A : (0 : ℝ) ≤ A)
  push_cast
  linarith

end C8R2

open C8R2 in
theorem solution :
    ((2085458999691735000000000000000000000000000000000000000000000 : ℕ) : ℝ) ≤
      ∑ c : {c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 2) // ∃ j, (c.2.val j).val = 0},
        (MME.RegionRate.massEntropy (fun w ↦ (RecStage.mu3 2
            (if (c.1.2.val 0).val = 0 then 1 else if (c.1.2.val 1).val = 0 then 2 else 0)
            c.1 w : ℝ)) +
          ((∑ w, RecStage.mu3 2
            (if (c.1.2.val 0).val = 0 then 1 else if (c.1.2.val 1).val = 0 then 2 else 0)
            c.1 w * Boundary.ones w : ℕ) : ℝ) * Real.log 5) := by
  have hs := sum_ok
  have h1 : ((∑ z : Z, g z : ℚ) : ℝ) ≤ ∑ z : Z,
      (MME.RegionRate.massEntropy (fun w ↦ (RecStage.mu3 2 (md z.1) z.1 w : ℝ)) +
        ((∑ w, RecStage.mu3 2 (md z.1) z.1 w * Boundary.ones w : ℕ) : ℝ) * Real.log 5) := by
    rw [Rat.cast_sum]
    exact Finset.sum_le_sum (fun z _ ↦ cell_bound z)
  have h2 : ((2085458999691735000000000000000000000000000000000000000000000 : ℕ) : ℝ) ≤ ((∑ z : Z, g z : ℚ) : ℝ) := by exact_mod_cast hs
  exact h2.trans h1
