theorem solution (M : Model) {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (ε : ℕ → Ω → ℝ) (σ : ℝ)
    (hε : LightTailedNoise P ε σ) (β : ℝ) (hβ : β ∈ M.B) (hψ : M.psi β ≠ 0)
    (κ₁ : ℝ) (hκ₁ : 0 < κ₁) (t₀ : ℕ) (ht₀ : 1 ≤ t₀) :
    ∃ N : ℕ, ∀ π : Policy M,
      (∀ᵐ ω ∂P, ∀ t : ℕ, t₀ ≤ t →
        ∑ s ∈ Finset.Icc 1 t, (M.psi (truncEst π β ε s ω) - dev π β ε (s + 1) ω) ^ 2 ≤
          κ₁ * Real.log t) →
      ∀ t : ℕ, N ≤ t →
        ∫ ω, (M.psi β - M.psi (truncEst π β ε t ω)) ^ 2 ∂P ≤
          512 * (M.DHat ^ 2 / (4 * M.bMax ^ 4)) * σ ^ 2 * (M.u - M.l) ^ 2 / M.psi β ^ 4 / t +
            4 * (M.u - M.l) ^ 2 * (P (goodEvent π β ε t)ᶜ).toReal := by
  have hm := hε.measurable
  have hψ2 : 0 < M.psi β ^ 2 := by positivity
  set R := 32 * κ₁ / M.psi β ^ 2 with hR
  have hR0 : 0 ≤ R := by positivity
  refine ⟨⌈R ^ 2⌉₊ + t₀ + 5, ?_⟩
  intro π hii t ht
  set y : ℝ := (t : ℝ) - 1 with hy
  have htR : (t : ℝ) ≥ ⌈R ^ 2⌉₊ + t₀ + 5 := by exact_mod_cast ht
  have hceil := Nat.le_ceil (R ^ 2)
  have ht0R : (1 : ℝ) ≤ t₀ := by exact_mod_cast ht₀
  have hyR : R ^ 2 ≤ y := by rw [hy]; linarith
  have hy4 : (3 : ℝ) ≤ y := by rw [hy]; linarith
  have hy0 : 0 < y := by linarith
  have ht3 : 3 ≤ t := by omega
  -- the logarithmic term is small
  have hlog : κ₁ * Real.log y ≤ M.psi β ^ 2 / 16 * y := by
    have h1 := log_le_two_sqrt y hy0
    have hsq : R ≤ Real.sqrt y := Real.le_sqrt_of_sq_le hyR
    have hsy : Real.sqrt y * Real.sqrt y = y := Real.mul_self_sqrt (le_of_lt hy0)
    have h2 : 2 * κ₁ = M.psi β ^ 2 / 16 * R := by rw [hR]; field_simp; ring
    have hs0 : 0 ≤ Real.sqrt y := Real.sqrt_nonneg _
    calc κ₁ * Real.log y ≤ κ₁ * (2 * Real.sqrt y) := mul_le_mul_of_nonneg_left h1 hκ₁.le
      _ = M.psi β ^ 2 / 16 * R * Real.sqrt y := by rw [← h2]; ring
      _ ≤ M.psi β ^ 2 / 16 * Real.sqrt y * Real.sqrt y := by
          apply mul_le_mul_of_nonneg_right _ hs0
          exact mul_le_mul_of_nonneg_left hsq (by positivity)
      _ = M.psi β ^ 2 / 16 * y := by rw [mul_assoc, hsy]
  -- measurability of A_t
  set A := goodEvent π β ε t with hA
  have hAm : MeasurableSet A := by
    have : A = ⋂ s ∈ Finset.Icc ((t - 1) / 2) (t - 1),
        {ω | (M.psi β - M.psi (truncEst π β ε s ω)) ^ 2 ≤ M.psi β ^ 2 / 12} := by
      ext ω; simp [hA, goodEvent]
    rw [this]
    exact Finset.measurableSet_biInter _ (fun s _ =>
      measurableSet_le ((measurable_const.sub (psiTrunc_meas π β ε hm s)).pow_const 2)
        measurable_const)
  set c := M.DHat ^ 2 / (4 * M.bMax ^ 4) * (16 / (M.psi β ^ 2 * y)) ^ 2 with hc
  have hc0 : 0 ≤ c := by positivity
  obtain ⟨hMint, hMeq⟩ := noiseSum_sq P ε σ hε π β t
  -- pointwise bound
  have hpt : ∀ᵐ ω ∂P, (M.psi β - M.psi (truncEst π β ε t ω)) ^ 2 ≤
      A.indicator (fun ω => c * noiseSum π β ε t ω ^ 2) ω +
        Aᶜ.indicator (fun _ => 4 * (M.u - M.l) ^ 2) ω := by
    filter_upwards [hii] with ω hω
    by_cases hωA : ω ∈ A
    · rw [Set.indicator_of_mem hωA, Set.indicator_of_notMem (by simpa using hωA), add_zero]
      have hii' : ∑ s ∈ Finset.Icc 1 (t - 1),
          (M.psi (truncEst π β ε s ω) - dev π β ε (s + 1) ω) ^ 2 ≤
            κ₁ * Real.log ((t : ℝ) - 1) := by
        have := hω (t - 1) (by omega)
        rwa [Nat.cast_sub (by omega), Nat.cast_one] at this
      have hJ := Jhat_linear_growth_on_goodEvent M π β ε κ₁ t ht3 ω hii' hωA
      have hJ' : M.psi β ^ 2 * y / 16 ≤ Jhat π β ε t ω := by
        have : (M.psi β ^ 2 / 8 - κ₁ * Real.log ((t : ℝ) - 1) / ((t : ℝ) - 1)) * ((t : ℝ) - 1)
            = M.psi β ^ 2 / 8 * y - κ₁ * Real.log y := by rw [← hy]; field_simp
        rw [this] at hJ
        linarith
      have hJpos : 0 < M.psi β ^ 2 * y / 16 := by positivity
      have hJne : Jhat π β ε t ω ≠ 0 := ne_of_gt (lt_of_lt_of_le hJpos hJ')
      have hratio := ls_error_eq_ratio M π β ε t ω hJne
      have hb := truncEst_mem π β ε t ω
      have h1 := psi_lip M β _ hβ hb
      have h2 : (β - truncEst π β ε t ω) ^ 2 ≤ (betaHat π β ε t ω - β) ^ 2 := by
        rw [← sq_abs, ← sq_abs (betaHat π β ε t ω - β), abs_sub_comm]
        exact pow_le_pow_left₀ (abs_nonneg _) (trunc_close M β _ hβ) 2
      have h3 : (betaHat π β ε t ω - β) ^ 2 ≤ noiseSum π β ε t ω ^ 2 * (16 / (M.psi β ^ 2 * y)) ^ 2 := by
        rw [hratio, div_pow]
        rw [show noiseSum π β ε t ω ^ 2 * (16 / (M.psi β ^ 2 * y)) ^ 2 =
          noiseSum π β ε t ω ^ 2 / (M.psi β ^ 2 * y / 16) ^ 2 by field_simp]
        apply div_le_div_of_nonneg_left (sq_nonneg _) (by positivity)
        exact pow_le_pow_left₀ hJpos.le hJ' 2
      have hK0 : 0 ≤ M.DHat ^ 2 / (4 * M.bMax ^ 4) := by positivity
      calc (M.psi β - M.psi (truncEst π β ε t ω)) ^ 2
          ≤ M.DHat ^ 2 / (4 * M.bMax ^ 4) * (β - truncEst π β ε t ω) ^ 2 := h1
        _ ≤ M.DHat ^ 2 / (4 * M.bMax ^ 4) *
            (noiseSum π β ε t ω ^ 2 * (16 / (M.psi β ^ 2 * y)) ^ 2) :=
            mul_le_mul_of_nonneg_left (h2.trans h3) hK0
        _ = c * noiseSum π β ε t ω ^ 2 := by rw [hc]; ring
    · rw [Set.indicator_of_notMem hωA, Set.indicator_of_mem (by simpa using hωA), zero_add]
      have h := psi_psi_abs M β _ hβ (truncEst_mem π β ε t ω)
      have h' : (M.psi β - M.psi (truncEst π β ε t ω)) ^ 2 ≤ (M.u - M.l) ^ 2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h 2
      nlinarith [sq_nonneg (M.u - M.l)]
  have hgint : Integrable (fun ω => (M.psi β - M.psi (truncEst π β ε t ω)) ^ 2) P := by
    refine Integrable.of_bound
      ((measurable_const.sub (psiTrunc_meas π β ε hm t)).pow_const 2).aestronglyMeasurable
      ((M.u - M.l) ^ 2) (Filter.Eventually.of_forall (fun ω => ?_))
    have h := psi_psi_abs M β _ hβ (truncEst_mem π β ε t ω)
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), ← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) h 2
  have hI1 : Integrable (A.indicator (fun ω => c * noiseSum π β ε t ω ^ 2)) P :=
    (hMint.const_mul c).indicator hAm
  have hI2 : Integrable (Aᶜ.indicator (fun _ => 4 * (M.u - M.l) ^ 2)) P :=
    (integrable_const _).indicator hAm.compl
  have hstep : ∫ ω, (M.psi β - M.psi (truncEst π β ε t ω)) ^ 2 ∂P ≤
      ∫ ω, (A.indicator (fun ω => c * noiseSum π β ε t ω ^ 2) ω +
        Aᶜ.indicator (fun _ => 4 * (M.u - M.l) ^ 2) ω) ∂P :=
    integral_mono_ae hgint (hI1.add hI2) hpt
  rw [integral_add hI1 hI2, integral_indicator_const _ hAm.compl] at hstep
  have hA1 : ∫ ω, A.indicator (fun ω => c * noiseSum π β ε t ω ^ 2) ω ∂P ≤
      c * ∫ ω, noiseSum π β ε t ω ^ 2 ∂P := by
    rw [← integral_const_mul]
    apply integral_mono hI1 (hMint.const_mul c)
    intro ω
    exact Set.indicator_le_self' (fun ω _ => mul_nonneg hc0 (sq_nonneg _)) ω
  have hdev2 : ∑ s ∈ Finset.Icc 1 t, ∫ ω, dev π β ε s ω ^ 2 ∂P ≤ t * (M.u - M.l) ^ 2 := by
    have : ∀ s ∈ Finset.Icc 1 t, ∫ ω, dev π β ε s ω ^ 2 ∂P ≤ (M.u - M.l) ^ 2 := by
      intro s _
      have := integral_mono_of_nonneg (μ := P) (Filter.Eventually.of_forall (fun ω => sq_nonneg (dev π β ε s ω)))
        (integrable_const ((M.u - M.l) ^ 2)) (Filter.Eventually.of_forall (fun ω => by
          have h := dev_abs π β ε s ω
          show dev π β ε s ω ^ 2 ≤ (M.u - M.l) ^ 2
          rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h 2))
      simpa using this
    refine (Finset.sum_le_sum this).trans ?_
    simp
  -- final arithmetic
  have hσ : 0 ≤ σ ^ 2 := sq_nonneg _
  have hfinal : c * (σ ^ 2 * (t * (M.u - M.l) ^ 2)) ≤
      512 * (M.DHat ^ 2 / (4 * M.bMax ^ 4)) * σ ^ 2 * (M.u - M.l) ^ 2 / M.psi β ^ 4 / t := by
    set Q := M.DHat ^ 2 / (4 * M.bMax ^ 4) * σ ^ 2 * (M.u - M.l) ^ 2 / M.psi β ^ 4 with hQ
    have hQ0 : 0 ≤ Q := by positivity
    have htpos : (0 : ℝ) < t := by linarith
    have e1 : c * (σ ^ 2 * (t * (M.u - M.l) ^ 2)) = 256 * Q * (t / y ^ 2) := by
      rw [hc, hQ]; field_simp; ring
    have e2 : 512 * (M.DHat ^ 2 / (4 * M.bMax ^ 4)) * σ ^ 2 * (M.u - M.l) ^ 2 / M.psi β ^ 4 / t
        = 256 * Q * (2 / t) := by
      rw [hQ]; field_simp; ring
    rw [e1, e2]
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    rw [div_le_div_iff₀ (by positivity) htpos]
    have : (t : ℝ) = y + 1 := by rw [hy]; ring
    rw [this]; nlinarith
  have hA1' := hA1.trans (mul_le_mul_of_nonneg_left (hMeq ▸ (mul_le_mul_of_nonneg_left hdev2 hσ)) hc0)
  simp only [smul_eq_mul, measureReal_def] at hstep
  linarith
