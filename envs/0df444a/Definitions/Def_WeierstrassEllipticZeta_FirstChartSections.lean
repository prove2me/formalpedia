-- title:
--   Bihomogeneous section spaces in the first Weierstrass cubic chart
-- statement:
--   FirstCubicCoordinateRing is C[t,x,y,u] modulo the ideal generated by y^2-4x^3+g2*x+g3. The quotient map is a C-algebra homomorphism.
--
--   For nonnegative m,n, firstChartSectionSpace is the C-linear span, in this quotient ring, of all normalized bihomogeneous polynomials Q of bidegree (m,n). Normalization substitutes (1,t,1,x,y,u,y*u+2*x^2) in the seven homogeneous variables. These are restrictions of the original polynomial sections to the first affine cubic chart.
--
--   The definition asserts neither finite dimension nor a dimension formula. Both finiteness and an explicit upper bound are proved separately. It is a concrete section space, not the entire infinite-dimensional coordinate ring or a definition of component multiplicity.
-- source:
--   Philippon (1986), Lemmes de zeros dans les groupes algebriques commutatifs, Bull. Soc. Math. France 114, 355-383, section 3, pp. 362-365, section-space/Hilbert-function setup and Lemma 3.2 on primary multiplicities: https://www.numdam.org/item/10.24033/bsmf.2060.pdf. The present elementary supporting calculation uses the explicit first-chart cubic and weights 2,3,1 on x,y,u. It constructs a rectangular spanning family and proves dim S_(m,n)<=2*(m+1)*(2*n+1)*(4*n+1), hence <=30*(m+1)*n^2 for n>=1. It is not a proof of Lemma 3.2 or of the required geometric multiplicity-to-dimension comparison. The frontier reduction turns a C-times-section-dimension bound into the original numeric bound with coefficient 60*C and exponent 2. Application: Senthil Kumar K (2026), Appendix A, Theorem A.2, https://doi.org/10.1017/S001309152610145X. Global geometric selection and the component multiplicity comparison remain Open.

import Definitions.Def_WeierstrassEllipticZeta_CappedChartJets
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.LinearAlgebra.Dimension.Constructions

noncomputable section
namespace WeierstrassEllipticZeta

/-- The affine coordinate ring of the first Weierstrass cubic chart. -/
abbrev FirstCubicCoordinateRing (L : PeriodPair) :=
  MvPolynomial (Fin 4) ℂ ⧸ Ideal.span {extensionChartCubic L.g₂ L.g₃ 0}

def firstCubicQuotient (L : PeriodPair) :
    MvPolynomial (Fin 4) ℂ →ₐ[ℂ] FirstCubicCoordinateRing L :=
  Ideal.Quotient.mkₐ ℂ (Ideal.span {extensionChartCubic L.g₂ L.g₃ 0})

/-- Restrictions of bihomogeneous sections of bidegree (m,n) to the cubic chart. -/
def firstChartSectionSpace (L : PeriodPair) (m n : ℕ) :
    Submodule ℂ (FirstCubicCoordinateRing L) :=
  Submodule.span ℂ {r | ∃ Q : MvPolynomial (Fin 7) ℂ,
    (∀ d ∈ Q.support, d 0 + d 1 = m ∧ d 2 + d 3 + d 4 + d 5 + d 6 = n) ∧
      firstCubicQuotient L (extensionChartNormalize 0 Q) = r}

end WeierstrassEllipticZeta


