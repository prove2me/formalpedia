-- title:
--   Stable quotient spans from monomial reduction relations
-- statement:
--   Let $K$ be a field, let $\sigma$ be a set of variables, and let $S$ be a finite set of monomial exponents containing zero. For every coordinate $i\in\sigma$ and exponent $d\in S$, let $r_{i,d}\in K[\sigma]$ be a polynomial all of whose monomial exponents belong to $S$.
--
--   Let $J$ be the ideal generated by
--   $$X_iX^d-r_{i,d}\qquad(i\in\sigma,\ d\in S).$$
--   Then there is a family of $|S|$ elements of $K[\sigma]/J$ whose $K$-linear span contains $1$ and contains every coordinate multiple of every element of the family.
--
--   No independence or uniqueness of reductions is assumed. When $\sigma$ is finite, the displayed family of ideal generators is finite.
-- source:
--   Derived monomial-reduction criterion for the frontier https://prove2.me/theorems/c7882fcd-3ca4-4e4c-af49-45dbffcebe04. The mission setting is Senthil Kumar K (2026), Algebraic independence of values of Weierstrass elliptic and zeta functions, Appendix A.2 and Theorem A.2, https://doi.org/10.1017/S001309152610145X. The algebraic criterion uses finite monomial expansions and ideals generated by reduction relations in Mathlib commit 0df444a360eaa60ab8c11dca51a86af692955474. The geometric construction with a uniform monomial-count bound remains open.

import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.Data.Fintype.EquivFin

noncomputable section

theorem WeierstrassEllipticZeta.monomial_reduction_stable_span
    (K σ : Type*) [Field K] (S : Finset (σ →₀ ℕ)) (hzero : 0 ∈ S)
    (r : σ → (σ →₀ ℕ) → MvPolynomial σ K)
    (hsupport : ∀ i : σ, ∀ d ∈ S, (r i d).support ⊆ S) :
    let J : Ideal (MvPolynomial σ K) := Ideal.span
      {p | ∃ i : σ, ∃ d ∈ S, p = MvPolynomial.X i * MvPolynomial.monomial d 1 - r i d}
    ∃ v : Fin S.card → MvPolynomial σ K ⧸ J,
      (1 : MvPolynomial σ K ⧸ J) ∈ Submodule.span K (Set.range v) ∧
      ∀ i : σ, ∀ j : Fin S.card,
        Ideal.Quotient.mk J (MvPolynomial.X i) * v j ∈ Submodule.span K (Set.range v) := by sorry
