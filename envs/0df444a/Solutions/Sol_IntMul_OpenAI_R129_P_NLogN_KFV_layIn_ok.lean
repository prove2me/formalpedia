    zsz_nat_lt (Nat.pow_lt_pow_right (by norm_num) hk)
  have P1 := Sp.pop (s := S) (f := mvFr v a b c) (i := qZ) (a := ((2 ^ c : ℕ) : ℤ)) (l := [])
