theorem affine_unpaired_transport {n : ℕ} (S T : Finset (ZMod n))
    (u : (ZMod n)ˣ) (v h z : ZMod n)
    (hh : (u : ZMod n)*h=h)
    (hST : S.image (fun a => (u : ZMod n)*a+v)=T)
    (hz : z+h ∉ S) : ((u : ZMod n)*z+v)+h ∉ T := by
  intro ht
  rw [← hST] at ht
  obtain ⟨a,ha,he⟩ := Finset.mem_image.mp ht
  have hf : (u : ZMod n)*a+v=(u : ZMod n)*(z+h)+v := by
    rw [he,mul_add,hh]
    ring
  have heq := unit_affine_injective u v hf
  exact hz (heq ▸ ha)

theorem p2m_local_affine_common_point_image (q : ℕ) (hq : 0 < q) (x : ZMod (4*q))
    (hx : x ∉ badParameters q) (u : (ZMod (4*q))ˣ) (v z : ZMod (4*q))
    (hAB : (patternA q x).image (fun a => (u : ZMod (4*q))*a+v)=patternB q x)
    (hz : z=0 ∨ z=q) : (u : ZMod (4*q))*z+v=0 ∨ (u : ZMod (4*q))*z+v=q := by
  apply patternB_unpaired_common
  · rw [← hAB]
    apply Finset.mem_image.mpr
    refine ⟨z,?_,rfl⟩
    rcases hz with rfl|rfl <;> simp [patternA]
  · exact affine_unpaired_transport _ _ u v _ z (unit_preserves_half q hq u) hAB
      (common_point_has_no_partner q hq x hx z hz)

