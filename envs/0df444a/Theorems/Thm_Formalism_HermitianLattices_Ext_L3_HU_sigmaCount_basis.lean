theorem Formalism.HermitianLattices.Ext.L3.HU.sigmaCount_basis [hFF : Fact (IsFixF K F)] (h : V →ₗ⋆[K] V →ₗ[K] K) (b : Basis κ K V)
    {H : Matrix κ κ (𝓞 K)} (hH : ∀ i j, jK (H i j) = h (b i) (b j)) {𝔭 : Ideal (𝓞 F)}
    (h𝔭 : 𝔭.IsMaximal) (j : ℕ) :
    sigmaCount h (locF 𝔭 (spanO b)) 𝔭 j = Nat.card {Y : Matrix κ κ (𝓞 K ⧸ extP K 𝔭 ^ j) //
      Hq H 𝔭 j * Y + Yᴴ * Hq H 𝔭 j = 0} := by sorry
