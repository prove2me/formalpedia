variable {K m k e : ℕ} {pos : Fin m × Fin (m ^ k) → ℕ}
variable {t S0 B : ℕ} {σ : Fin 3 → Fin m}
  (he : ∀ p, pos p + K * (p.2.val + m ^ k * p.1.val) = e) (htop : e - e % K + K ≤ t)
  (hσ : σ 0 < σ 1 ∧ σ 1 < σ 2)
include he htop hσ

theorem NLogN.KFR.encode_rowAddAddr (hK : 1 ≤ K) {q : ℕ} (hq : q < B * 2 ^ t * S0) {px py : Fin 3}
    {i j : Fin m} (hi : σ px = i) (hj : σ py = j) (hij : i ≠ j) :
    ((encode (NLogN.KFR.shR K (m ^ k) e t S0 B σ)
        (rowAddAddr K (e % K) (m ^ k) px py (decode (NLogN.KFR.shR K (m ^ k) e t S0 B σ) q)) : ℕ) : ℤ) =
      fsetZ (fun p => 2 ^ pos p * S0) q (rowAddr i j (fbit (fun p => 2 ^ pos p * S0) q)) := by sorry
