  · simp [CF, update_of_ne e, e]
theorem CFu_a2 (v : List ℤ) : update (CF dA f u a1 a2 a3 cn d) cA2 v = CF dA f u a1 v a3 cn d := by
  funext i; by_cases e : i = cA2
  · subst e; simp (config := {decide := true}) [CF]
  · simp [CF, update_of_ne e, e]
theorem CFu_a3 (v : List ℤ) : update (CF dA f u a1 a2 a3 cn d) cA3 v = CF dA f u a1 a2 v cn d := by
  funext i; by_cases e : i = cA3
