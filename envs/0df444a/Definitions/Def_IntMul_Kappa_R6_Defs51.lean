section
-- Source module: Solutions.R6BitNBProjA
/-!
# Round six, bit network: `G`-orthogonal projectors on the point space

On `ℚ^23` the form `B(u, v) = u·v - (Σu)(Σv)/9` (the Gram form `G = I - J/9` of the labels). A
subspace inside a centre hyperplane `{v | Σ v = 3 v_c}` is `B`-positive definite, hence
complemented by its `B`-orthogonal; its `B`-orthogonal projector `P` is characterized by
`P v = v` on the subspace and `P w = 0` on the orthogonal (`IsPrj`). Consequences: `P² = P`,
nesting of subspaces gives both product relations, `rank P = dim`.

Line projectors `Pl T = x_T y_Tᵀ` (`x_T` the triple indicator, `y_T = G x_T / 2`, `y_T·x_T = 1`)
project onto the line of `x_T`.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Module R6Chk R6Chk.Bit

/-- Points space. -/
abbrev V23 := Fin 23 → ℚ

/-- The label form. -/
def bfF (u v : V23) : ℚ := u ⬝ᵥ v - (∑ p, u p) * (∑ p, v p) / 9

/-- The label form as a bilinear form. -/
noncomputable def Bf : LinearMap.BilinForm ℚ V23 :=
  LinearMap.mk₂ ℚ bfF
    (fun u u' v => by simp only [bfF, add_dotProduct, Pi.add_apply, Finset.sum_add_distrib]; ring)
    (fun c u v => by simp only [bfF, smul_dotProduct, Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum]; ring)
    (fun u v v' => by simp only [bfF, dotProduct_add, Pi.add_apply, Finset.sum_add_distrib]; ring)
    (fun c u v => by simp only [bfF, dotProduct_smul, Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum]; ring)

theorem Bf_apply (u v : V23) : Bf u v = bfF u v := rfl

theorem bfF_comm (u v : V23) : bfF u v = bfF v u := by
  simp only [bfF, dotProduct_comm]; ring

theorem Bf_refl : Bf.IsRefl := fun u v h => by rw [Bf_apply, bfF_comm, ← Bf_apply]; exact h

theorem mem_orth {V : Submodule ℚ V23} {w : V23} : w ∈ Bf.orthogonal V ↔ ∀ v ∈ V, bfF v w = 0 :=
  LinearMap.BilinForm.mem_orthogonal_iff

/-- Positivity on a centre hyperplane. -/
theorem bf_pos {c : Fin 23} {v : V23} (hv : ∑ p, v p = 3 * v c) (h0 : bfF v v = 0) : v = 0 := by
  have hsq : ∑ p, v p * v p = v c * v c + ∑ p ∈ Finset.univ.erase c, v p * v p :=
    (Finset.add_sum_erase _ _ (Finset.mem_univ c)).symm
  have hsum : ∑ p, v p = v c + ∑ p ∈ Finset.univ.erase c, v p :=
    (Finset.add_sum_erase _ _ (Finset.mem_univ c)).symm
  have h1 : ∑ p ∈ Finset.univ.erase c, v p * v p = 0 := by
    have : bfF v v = ∑ p ∈ Finset.univ.erase c, v p * v p := by
      simp only [bfF, dotProduct]; rw [hsq, hv]; ring
    rw [← this, h0]
  have h2 : ∀ p ∈ Finset.univ.erase c, v p = 0 := by
    intro p hp
    have := (Finset.sum_eq_zero_iff_of_nonneg (fun q _ => mul_self_nonneg (v q))).1 h1 p hp
    exact mul_self_eq_zero.1 this
  have h3 : ∑ p ∈ Finset.univ.erase c, v p = 0 := Finset.sum_eq_zero h2
  have hc : v c = 0 := by rw [hsum, h3] at hv; linarith
  funext p
  by_cases hp : p = c
  · rw [hp, hc]; rfl
  · exact h2 p (Finset.mem_erase.2 ⟨hp, Finset.mem_univ p⟩)

/-- Subspaces of a centre hyperplane are complemented by their orthogonal. -/
theorem compl_of_centre {V : Submodule ℚ V23} {c : Fin 23} (hV : ∀ v ∈ V, ∑ p, v p = 3 * v c) :
    IsCompl V (Bf.orthogonal V) := by
  rw [LinearMap.BilinForm.isCompl_orthogonal_iff_disjoint Bf_refl, Submodule.disjoint_def]
  intro x hx hxo
  exact bf_pos (hV x hx) (mem_orth.1 hxo x hx)

/-! ## Projector characterization -/

/-- `P` is the `B`-orthogonal projector onto `V`. -/
def IsPrj (P : Matrix (Fin 23) (Fin 23) ℚ) (V : Submodule ℚ V23) : Prop :=
  (∀ v ∈ V, P *ᵥ v = v) ∧ ∀ w ∈ Bf.orthogonal V, P *ᵥ w = 0

/-- The projector of a complemented subspace. -/
noncomputable def prjM (V : Submodule ℚ V23) (h : IsCompl V (Bf.orthogonal V)) :
    Matrix (Fin 23) (Fin 23) ℚ :=
  LinearMap.toMatrix' (V.projection (Bf.orthogonal V) h)

/-! ## Triples -/

theorem sum_tvQ {i : ℕ} (hi : i < 1771) : ∑ p, tvQ i p = 3 := by
  have h := (tri_spec hi).2
  have : ∑ p, tvQ i p = ((F (tri i)).card : ℚ) := by
    rw [F, Finset.card_filter, Nat.cast_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    simp only [tvQ]; split_ifs <;> simp_all
  rw [this, h]; norm_num

/-! ## Line projectors -/

def xv (T : ℕ) : V23 := tvQ T

def yv (T : ℕ) : V23 := fun p => (tvQ T p - (∑ q, tvQ T q) / 9) / 2

/-- The line projector `x_T y_Tᵀ`. -/
def Pl (T : ℕ) : Matrix (Fin 23) (Fin 23) ℚ := vecMulVec (xv T) (yv T)

/-- The line of a triple. -/
noncomputable def lineS (T : ℕ) : Submodule ℚ V23 := ℚ ∙ xv T

/-- Centre hyperplane condition for a support mask. -/
def HasCentre (sup : ℕ) : Prop :=
  ∃ c < 23, ∀ i, sup.testBit i = true → i < 1771 ∧ (tri i).testBit c = true

theorem centre_span {sup : ℕ} (h : HasCentre sup) : ∃ c : Fin 23, ∀ v ∈ spanS sup, ∑ p, v p = 3 * v c := by
  obtain ⟨c, hc, hsup⟩ := h
  refine ⟨⟨c, hc⟩, fun v hv => ?_⟩
  let H : Submodule ℚ V23 :=
    { carrier := {v | ∑ p, v p = 3 * v ⟨c, hc⟩}
      add_mem' := fun {a b} ha hb => by
        simp only [Set.mem_ofPred_eq, Pi.add_apply, Finset.sum_add_distrib] at *; rw [ha, hb]; ring
      zero_mem' := by simp
      smul_mem' := fun r a ha => by
        simp only [Set.mem_ofPred_eq, Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum] at *; rw [ha]; ring }
  have hle : spanS sup ≤ H := by
    rw [spanS, Submodule.span_le]
    rintro _ ⟨i, hi, rfl⟩
    obtain ⟨hi1, hic⟩ := hsup i hi
    show ∑ p, tvQ i p = 3 * tvQ i ⟨c, hc⟩
    rw [sum_tvQ hi1]
    simp [tvQ, hic]
  exact hle hv

theorem compl_spanS {sup : ℕ} (h : HasCentre sup) : IsCompl (spanS sup) (Bf.orthogonal (spanS sup)) := by
  obtain ⟨c, hc⟩ := centre_span h
  exact compl_of_centre hc

open Classical in
/-- The projector of a node support (`0` without a centre). -/
noncomputable def Pnd (sup : ℕ) : Matrix (Fin 23) (Fin 23) ℚ :=
  if h : HasCentre sup then prjM (spanS sup) (compl_spanS h) else 0

end IntMul.Kappa.R6.Bit.NB

end

section
-- Source module: Solutions.R6BitNBLoc
/-!
# Round six, bit network: the local invocation programs (h = 23), definitions

Local wires: `x_t = t`, `y_T = v + T`, slot `q ↦ 2v + q`, temporary `c ↦ 2v + R + c`.
Codes: `0` (zero label), `1` (full label), `2 + T` (`t_T^⊥`), `2 + v + n` (span of node `n`).
-/

set_option maxRecDepth 100000

namespace R6Chk.Bit.Loc

noncomputable section

open R6Chk R6Chk.Bit

def NV : ℕ := 1771
def NR : ℕ := 40077

def wX (t : ℕ) : ℕ := t
def wY (T : ℕ) : ℕ := Nat.add 1771 T
def wS (q : ℕ) : ℕ := Nat.add 3542 q
def wT (c : ℕ) : ℕ := Nat.add 43619 c

def cLOW : ℕ := 0
def cHIGH : ℕ := 1
def cPT (T : ℕ) : ℕ := Nat.add 2 T
def cND (n : ℕ) : ℕ := Nat.add 1773 n

/-! ## Decoding -/

/-- A producer record: node, pivot slot, second slot + 1 (`0`: leaf), extra slots. -/
abbrev Rec := ℕ × ℕ × ℕ × List ℕ

def exDec (k : ℕ) : ℕ → List ℕ :=
  Nat.rec (motive := fun _ => ℕ → List ℕ) (fun _ => [])
    (fun _ ih s => fieldOf s 16 0 :: ih (Nat.shiftRight s 16)) k

def recsDec (cnt : ℕ) : ℕ → List Rec :=
  Nat.rec (motive := fun _ => ℕ → List Rec) (fun _ => [])
    (fun _ ih s =>
      let ne := fieldOf s 8 6
      (fieldOf s 16 0, fieldOf s 16 1, fieldOf s 16 2, exDec ne (Nat.shiftRight s 56)) ::
        ih (Nat.shiftRight s (Nat.add 56 (Nat.mul 16 ne)))) cnt

def chunkDec (x : ℕ) : List Rec := recsDec (Nat.land x 65535) (Nat.shiftRight x 16)

/-- All producer records, in topological order. -/
def recs : List Rec := GREC.flatMap chunkDec

def injS (T k : ℕ) : ℕ := fieldOf INJ 16 (Nat.add (Nat.mul 3 T) k)
def pts (T k : ℕ) : ℕ := fieldOf TPTS 5 (Nat.add (Nat.mul 3 T) k)
def retS (c : ℕ) : ℕ := fieldOf RETS 16 c
def retN (c : ℕ) : ℕ := fieldOf RETN 16 c
def srcS (t : ℕ) : ℕ := fieldOf SRC 16 t
def dimN (n : ℕ) : ℕ := fieldOf DIMT 5 n

/-! ## The word -/

/-- An instruction: code, touched wires, elementary gates `dst += src`. -/
abbrev LInstr := ℕ × List ℕ × List (ℕ × ℕ)

def touch (el : List (ℕ × ℕ)) : List ℕ := el.flatMap fun p => [p.1, p.2]

def mk (c : ℕ) (el : List (ℕ × ℕ)) : LInstr := (c, touch el, el)

/-- Elementary gates of one producer record. -/
def recEl (r : Rec) : List (ℕ × ℕ) :=
  (if r.2.2.1 = 0 then [] else [(wS r.2.1, wS (r.2.2.1 - 1))]) ++ r.2.2.2.map fun o => (wS o, wS r.2.1)

def mixF (code : ℕ → ℕ) : List LInstr := recs.map fun r => mk (code r.1) (recEl r)
def mixI (code : ℕ → ℕ) : List LInstr := recs.reverse.map fun r => mk (code r.1) (recEl r).reverse

def tri3 : List ℕ := [0, 1, 2]

def scatEl (rd : ℕ → ℕ) (T : ℕ) : List (ℕ × ℕ) := tri3.map fun k => (wY T, rd (pts T k))
def scat (rd : ℕ → ℕ) (code : ℕ → ℕ) : List LInstr :=
  (List.range NV).map fun T => mk (code T) (scatEl rd T)
def injo (code : ℕ → ℕ) : List LInstr :=
  (List.range NV).map fun T => mk (code T) (tri3.map fun k => (wY T, wS (injS T k)))
def copyo (code : ℕ → ℕ) : List LInstr :=
  (List.range NV).map fun t => mk (code t) [(wS (srcS t), wX t)]

/-- Copies of the retained slots into the temporaries. -/
def tcopy : List LInstr := (List.range 23).map fun c => mk (cND (retN c)) [(wT c, wS (retS c))]

def rdS (c : ℕ) : ℕ := wS (retS c)

/-- The ten ops of the stage-one word (plain: scatters read the retained slots). -/
def P1 : List (List LInstr) :=
  [mixF fun _ => cLOW, scat rdS fun _ => cLOW, injo fun _ => cLOW, mixI fun _ => cLOW,
    copyo fun t => cND (t + 1), mixF cND, scat rdS fun _ => cLOW, injo cPT,
    mixI fun _ => cHIGH, copyo fun _ => cHIGH]

/-- Reversal (stage two). -/
def revW (W : List (List LInstr)) : List (List LInstr) :=
  W.reverse.map fun op => op.reverse.map fun i => (i.1, i.2.1, i.2.2.reverse)

/-- The designated scatter with temporaries. -/
def scatT : List LInstr := tcopy ++ scat wT fun _ => cLOW

def W1 : List LInstr := (P1.set 6 scatT).flatten
def W2 : List LInstr := ((revW P1).set 3 (tcopy ++ (scat wT fun _ => cLOW).reverse.map
  fun i => (i.1, i.2.1, i.2.2.reverse))).flatten

/-! ## Label state -/

inductive LT where
  | leaf (x : ℕ)
  | node (l r : LT)

def ltGet (t : LT) : ℕ → ℕ → ℕ :=
  LT.rec (motive := fun _ => ℕ → ℕ → ℕ) (fun x _ _ => x)
    (fun _ _ ihl ihr d i => cond (tb i (Nat.sub d 1)) (ihr (Nat.sub d 1) i) (ihl (Nat.sub d 1) i)) t

def ltSet (t : LT) : ℕ → ℕ → ℕ → LT :=
  LT.rec (motive := fun _ => ℕ → ℕ → ℕ → LT) (fun _ _ _ x => LT.leaf x)
    (fun l r ihl ihr d i x => cond (tb i (Nat.sub d 1)) (LT.node l (ihr (Nat.sub d 1) i x))
      (LT.node (ihl (Nat.sub d 1) i x) r)) t

def ltFull (x : ℕ) : ℕ → LT :=
  Nat.rec (motive := fun _ => LT) (LT.leaf x) (fun _ ih => LT.node ih ih)

def DEP : ℕ := 16

/-- Move bookkeeping: for each touched wire not at `c`, record `(w, old)` and set it to `c`. -/
def mvStep (c : ℕ) (acc : LT × List (ℕ × ℕ)) (w : ℕ) : LT × List (ℕ × ℕ) :=
  let o := ltGet acc.1 DEP w
  cond (Nat.beq o c) acc (ltSet acc.1 DEP w c, (w, o) :: acc.2)

/-- A chunk: code, moves `(wire, old code)`, gates. -/
abbrev LChunk := ℕ × List (ℕ × ℕ) × List (ℕ × ℕ)

def genStep (acc : LT × List LChunk) (i : LInstr) : LT × List LChunk :=
  let r := i.2.1.foldl (mvStep i.1) (acc.1, [])
  (r.1, (i.1, r.2.reverse, i.2.2) :: acc.2)

def gen (st : LT) (W : List LInstr) : LT × List LChunk :=
  let r := W.foldl genStep (st, [])
  (r.1, r.2.reverse)

/-! ## Initial labels -/

def init1 : LT :=
  let t0 := (List.range NV).foldl (fun t x => ltSet t DEP (wX x) (cND (x + 1))) (ltFull cLOW DEP)
  (List.range 23).foldl (fun t c => ltSet t DEP (wT c) (cND (retN c))) t0

def init2 : LT :=
  let t0 := (List.range NV).foldl (fun t x => ltSet t DEP (wX x) cHIGH) (ltFull cLOW DEP)
  let t1 := (List.range NV).foldl (fun t T => ltSet t DEP (wY T) (cPT T)) t0
  let t2 := (List.range NR).foldl (fun t q => ltSet t DEP (wS q) cHIGH) t1
  (List.range 23).foldl (fun t c => ltSet t DEP (wT c) (cND (retN c))) t2

/-- Final sweep: every slot to code `f`. -/
def sweep (f : ℕ) : List LInstr := (List.range NR).map fun q => (f, [wS q], [])

def G1 : LT × List LChunk := gen init1 (W1 ++ sweep cHIGH)
def G2 : LT × List LChunk := gen init2 (W2 ++ sweep cLOW)

/-! ## Checks -/

end

end R6Chk.Bit.Loc

namespace R6Chk.Bit.Loc

noncomputable section

/-! ## Mask simulation of the producer on `C x` -/

end

end R6Chk.Bit.Loc

end

section
-- Source module: Solutions.R6BitNBDimCov
/-!
# Round six, bit network: the node dimension table `DIMT` is certified

The dimension records of `R6ChkBitDim0..2` list the nodes `0, 1, 2, …` in order; the kernel
checks that they cover all `36513` nodes and agree with `dimN` (the 5-bit table used by the
local programs). Hence `finrank ℚ (spanS (supG n)) = dimN n` for every node `n`.
-/

set_option maxRecDepth 100000
set_option Elab.async false

namespace R6Chk.Bit.Loc

open R6Chk R6Chk.Bit

noncomputable def dimChunks : List (List ℕ) := Dim0.chunks ++ Dim1.chunks ++ Dim2.chunks

noncomputable def dimAll : List (ℕ × ℕ) := dimChunks.flatMap fun c => c.flatMap dimList

def covStep (a : Bool × ℕ) (p : ℕ × ℕ) : Bool × ℕ :=
  (a.1 && Nat.beq p.1 a.2 && Nat.beq (dimN p.1) p.2, Nat.succ a.2)

end R6Chk.Bit.Loc

end

section
-- Source module: Solutions.R6BitNBIdSim
/-!
# Round six, bit network: node-id simulation of the producer (kernel checker)

The producer `A` (records of `recs`) runs on slots holding values of DAG nodes. The checker
tracks, for every slot, the id of the node whose value it holds (`0`: zero), packed in 16-bit
fields of one number, and checks each record against the support table `supG`:
a gate record `(n, p, b + 1, ex)` needs `supG (id p) xor supG (id b) = supG n`; a leaf record
`(n, p, 0, ex)` needs `id p = n`; the extra slots must be empty. At the end the six slots read
for target `T` hold supports xoring to `{T}`.
-/

set_option maxRecDepth 100000

namespace R6Chk.Bit.Loc

noncomputable section

open R6Chk R6Chk.Bit

/-- Set the 16-bit field `i` of `S` to `v`. -/
def setF (S i v : ℕ) : ℕ := Nat.xor S (Nat.shiftLeft (Nat.xor (fieldOf S 16 i) v) (Nat.mul 16 i))

/-- Slot ids, packed in 16-bit fields. -/
def idF (S : ℕ) (q : ℕ) : ℕ := fieldOf S 16 q

def idSet (S : ℕ) (q v : ℕ) : ℕ := setF S q v

/-- One extra slot `o` receives node `n` (it must be empty and differ from the pivot `p`). -/
def exStep (n p : ℕ) (a : Bool × ℕ) (o : ℕ) : Bool × ℕ :=
  (a.1 && Nat.blt o NR && Nat.beq (idF a.2 o) 0 && !(Nat.beq o p), idSet a.2 o n)

/-- The DAG gates `(k, a, b)`, in record order (`R6ChkBitDagC`, each `GateOK supG`). -/
def dagGL : List (ℕ × ℕ × ℕ) := DagC.gs.flatMap fun c => c.flatMap gchunkDec

/-- The pivot check of a record against the next DAG gate `g`. -/
def pivOK (S : ℕ) (r : Rec) (g : ℕ × ℕ × ℕ) : Bool :=
  Nat.blt r.2.1 NR && cond (Nat.beq r.2.2.1 0) (Nat.beq (idF S r.2.1) r.1)
    (Nat.blt (Nat.sub r.2.2.1 1) NR && !(Nat.beq r.2.1 (Nat.sub r.2.2.1 1)) &&
      Nat.beq g.1 r.1 && Nat.beq (idF S r.2.1) g.2.1 && Nat.beq (idF S (Nat.sub r.2.2.1 1)) g.2.2)

/-- Remaining gates after a record. -/
def glNext (r : Rec) (l : List (ℕ × ℕ × ℕ)) : List (ℕ × ℕ × ℕ) := cond (Nat.beq r.2.2.1 0) l l.tail

def recStep (acc : (Bool × ℕ) × List (ℕ × ℕ × ℕ)) (r : Rec) : (Bool × ℕ) × List (ℕ × ℕ × ℕ) :=
  (r.2.2.2.foldl (exStep r.1 r.2.1) (acc.1.1 && pivOK acc.1.2 r (acc.2.headD (0, 0, 0)),
    idSet acc.1.2 r.2.1 r.1), glNext r acc.2)

/-- Initial ids: source slot of triple `t` holds leaf `t + 1`. -/
def initStep (a : Bool × ℕ) (t : ℕ) : Bool × ℕ :=
  (a.1 && Nat.blt (srcS t) NR && Nat.beq (idF a.2 (srcS t)) 0, idSet a.2 (srcS t) (Nat.add t 1))

def idInit : Bool × ℕ := (List.range NV).foldl initStep (true, 0)

/-- Read check for target `T`. -/
def readOK (S : ℕ) (T : ℕ) : Bool :=
  tri3.all (fun k => Nat.blt (retS (pts T k)) NR && Nat.blt (injS T k) NR && Nat.blt (pts T k) 23) &&
  Nat.beq (tri3.foldl (fun a k => Nat.xor a (Nat.xor (supG (idF S (retS (pts T k))))
    (supG (idF S (injS T k))))) 0) (Nat.shiftLeft 1 T)

/-! ## Chained checks (three producer blocks, then the reads) -/

/-- Records of the record chunks `a, …, b - 1`. -/
def blkRecs (a b : ℕ) : List Rec := ((GREC.drop a).take (b - a)).flatMap chunkDec

/-- A block run from ids `S` (gates from position `g`) succeeds and ends at `S'`. -/
def blkChk (a b g S S' : ℕ) : Bool :=
  let r := (blkRecs a b).foldl recStep ((true, S), dagGL.drop g)
  r.1.1 && Nat.beq r.1.2 S'

def readsChk (S : ℕ) : Bool := (List.range NV).all (readOK S)

end

end R6Chk.Bit.Loc

end

section
-- Source module: Solutions.R6BitNBGenP
/-!
# Round six, bit network: the label generator on packed code states (definitions, checks)

The local code state is packed in 16-bit fields (`pget`, `setF`). `genP S W` processes the
instructions of `W`: for every touched wire whose code differs from the instruction's code it
emits a move `(wire, old code)` and updates the state; the chunk keeps the instruction's gates.

`segChk S S' cnt W`: the run from `S` ends at `S'`, every move is nested (`nestOK`), and the
move ranks are counted by `cnt`. The stage words are cut into the segments `segW1 j`, `segW2 j`.
-/

set_option maxRecDepth 100000

namespace R6Chk.Bit.Loc

noncomputable section

open R6Chk R6Chk.Bit

/-- Code states: a depth-4 tree of leaves packing 4096 codes (16-bit fields) each. -/
def pget (t : LT) (w : ℕ) : ℕ := fieldOf (ltGet t 4 (Nat.shiftRight w 12)) 16 (Nat.land w 4095)

def pset (t : LT) (w v : ℕ) : LT :=
  ltSet t 4 (Nat.shiftRight w 12) (setF (ltGet t 4 (Nat.shiftRight w 12)) (Nat.land w 4095) v)

/-- The depth-`d` tree of the leaves `k 2^d + j` (`j < 2^d`) of width `lw` of a packed number. -/
def mkTree (S lw : ℕ) : ℕ → ℕ → LT :=
  Nat.rec (motive := fun _ => ℕ → LT) (fun k => LT.leaf (fieldOf S lw k))
    (fun _ ih k => LT.node (ih (Nat.mul 2 k)) (ih (Nat.add (Nat.mul 2 k) 1)))

/-- The tree of a packed code state (leaf `k` = bits `65536 k, …`). -/
def toLT (S : ℕ) : LT := mkTree S 65536 4 0

/-- Packed number of a tree. -/
def ofLT (t : LT) : ℕ :=
  (List.range 16).foldr (fun k acc => Nat.lor (ltGet t 4 k) (Nat.shiftLeft acc 65536)) 0

def mvP (c : ℕ) (acc : LT × List (ℕ × ℕ)) (w : ℕ) : LT × List (ℕ × ℕ) :=
  cond (Nat.beq (pget acc.1 w) c) acc (pset acc.1 w c, (w, pget acc.1 w) :: acc.2)

def genStepP (acc : LT × List LChunk) (i : LInstr) : LT × List LChunk :=
  let r := i.2.1.foldl (mvP i.1) (acc.1, [])
  (r.1, (i.1, r.2.reverse, i.2.2) :: acc.2)

def genP (S : LT) (W : List LInstr) : LT × List LChunk :=
  let r := W.foldl genStepP (S, [])
  (r.1, r.2.reverse)

/-! ## Nesting of moves -/

/-- The argument table as a tree (2048 entries per leaf). -/
def argTr : LT := mkTree ARGT 65536 5 0

def argF (n : ℕ) : ℕ := fieldOf (ltGet argTr 5 (Nat.shiftRight n 11)) 32 (Nat.land n 2047)

/-- `a` is an argument of the gate `n`. -/
def argRel (a n : ℕ) : Bool :=
  Nat.beq (Nat.land (argF n) 65535) a || Nat.beq (Nat.shiftRight (argF n) 16) a

/-- The dimension table as a tree (8192 entries per leaf). -/
def dimTr : LT := mkTree DIMT 40960 3 0

def dimF (n : ℕ) : ℕ := fieldOf (ltGet dimTr 3 (Nat.shiftRight n 13)) 5 (Nat.land n 8191)

def dimCF (c : ℕ) : ℕ :=
  cond (Nat.beq c 0) 0 (cond (Nat.beq c 1) 23 (cond (Nat.blt c 1773) 22 (dimF (Nat.sub c 1773))))

/-- Count vector: rank `r` in the 32-bit field `r`. -/
def cntF (cs : List LChunk) : ℕ :=
  cs.foldl (fun acc ch => ch.2.1.foldl (fun a m =>
    Nat.add a (Nat.shiftLeft 1 (Nat.mul 32 (let a1 := dimCF m.2; let b1 := dimCF ch.1;
      cond (Nat.blt a1 b1) (Nat.sub b1 a1) (Nat.sub a1 b1))))) acc) 0

/-- Triples meeting the triple `T` in exactly one point. -/
def orthT (T : ℕ) : ℕ :=
  Nat.lor (Nat.lor (exclT (pts T 0) (pts T 1) (pts T 2)) (exclT (pts T 1) (pts T 0) (pts T 2)))
    (exclT (pts T 2) (pts T 0) (pts T 1))

def orthOK (n T : ℕ) : Bool := Nat.beq (Nat.land (supG n) (orthT T)) (supG n)

def isND (c : ℕ) : Bool := Nat.ble 1773 c && Nat.blt c 38286
def isPT (c : ℕ) : Bool := Nat.ble 2 c && Nat.blt c 1773

/-- A move between nested codes. -/
def nestOK (o c : ℕ) : Bool :=
  Nat.ble o 1 || Nat.ble c 1 ||
  (isND o && isND c && (argRel (Nat.sub o 1773) (Nat.sub c 1773) || argRel (Nat.sub c 1773) (Nat.sub o 1773))) ||
  (isND o && isPT c && orthOK (Nat.sub o 1773) (Nat.sub c 2)) ||
  (isPT o && isND c && orthOK (Nat.sub c 1773) (Nat.sub o 2))

def movesOK (cs : List LChunk) : Bool := cs.all fun ch => ch.2.1.all fun m => nestOK m.2 ch.1

def segRes (r : LT × List LChunk) (S' cnt : ℕ) : Bool :=
  Nat.beq (ofLT r.1) S' && movesOK r.2 && Nat.beq (cntF r.2) cnt

def segChk (S S' cnt : ℕ) (W : List LInstr) : Bool := segRes (genP (toLT S) W) S' cnt

/-! ## The segments -/

def mixFB (a b : ℕ) (code : ℕ → ℕ) : List LInstr := (blkRecs a b).map fun r => mk (code r.1) (recEl r)

/-- Reversal of an op (instruction order and gate order; touch lists kept). -/
def revI (op : List LInstr) : List LInstr := op.reverse.map fun i => (i.1, i.2.1, i.2.2.reverse)

/-- Sweep of the slots `a, …, b - 1` to code `f`. -/
def sweepR (a b f : ℕ) : List LInstr := (List.range' a (b - a)).map fun q => (f, [wS q], [])

def segW1 : ℕ → List LInstr
  | 0 => copyo (fun t => cND (t + 1)) ++ mixFB 0 12 cND
  | 1 => mixFB 12 24 cND
  | 2 => mixFB 24 48 cND
  | 3 => mixFB 48 72 cND
  | 4 => mixFB 72 96 cND
  | 5 => mixFB 96 120 cND
  | 6 => mixFB 120 143 cND
  | 7 => scatT ++ injo cPT
  | 8 => sweepR 0 20000 cHIGH
  | 9 => sweepR 20000 NR cHIGH
  | _ => copyo fun _ => cHIGH

def segW2 : ℕ → List LInstr
  | 0 => revI (injo cPT) ++ (tcopy ++ revI (scat wT fun _ => cLOW))
  | 1 => revI (mixFB 120 143 cND)
  | 2 => revI (mixFB 96 120 cND)
  | 3 => revI (mixFB 72 96 cND)
  | 4 => revI (mixFB 48 72 cND)
  | 5 => revI (mixFB 24 48 cND)
  | 6 => revI (mixFB 12 24 cND)
  | 7 => revI (mixFB 0 12 cND)
  | 8 => revI (copyo fun t => cND (t + 1)) ++ sweepR 0 20000 cLOW
  | _ => sweepR 20000 NR cLOW

end

end R6Chk.Bit.Loc

end

section
-- Source module: Solutions.R6BitNBArgk
/-! Round-six bit network: kernel checks tying the generator tables to the DAG data.
* `argChk`: the argument table `ARGT` lists, for every node `n ≥ 1772`, the two arguments of the
  DAG gate with head `n` (the gates of `dagGL` have heads `1772, 1773, …, 36512` in order), and `0`
  for the nodes `n < 1772`;
* `ptsChk`: the three points `pts T k` of triple `T` are the points of `tri T`. -/

set_option maxRecDepth 100000
set_option Elab.async false

namespace R6Chk.Bit.Loc

open R6Chk R6Chk.Bit

noncomputable section

def argOK (p : (ℕ × ℕ × ℕ) × ℕ) : Bool :=
  Nat.beq p.1.1 p.2 && Nat.blt p.1.2.1 65536 && Nat.blt p.1.2.2 65536 &&
    Nat.beq (argF p.2) (Nat.add p.1.2.1 (Nat.mul 65536 p.1.2.2))

def argChk : Bool :=
  Nat.beq dagGL.length 34741 && (dagGL.zip (List.range' 1772 34741)).all argOK &&
    (List.range 1772).all fun n => Nat.beq (argF n) 0

def ptsChk : Bool :=
  (List.range 1771).all fun T => Nat.blt (pts T 0) 23 && Nat.blt (pts T 1) 23 && Nat.blt (pts T 2) 23 &&
    Nat.beq (tri T) (Nat.lor (Nat.lor (Nat.shiftLeft 1 (pts T 0)) (Nat.shiftLeft 1 (pts T 1)))
      (Nat.shiftLeft 1 (pts T 2)))

end

end R6Chk.Bit.Loc

end

section
-- Source module: Solutions.R6BitNBChunk
/-!
# Round six, bit network: the label generator, soundness of the packed representation

* bit lemmas for `fieldOf` / `setF` and the trees `LT` (`ltGet`, `ltSet`, `mkTree`, `ofLT`);
* `genF`: the generator on code states `ℕ → ℕ` (the specification of `genP`);
  `genP_eq`: on trees of depth 4 with 65536-bit leaves, `genP` computes `genF` of the code
  function `pget t`;
* `segChk_sound`: the kernel segment checks give the chunks of `genF` from `fieldOf S 16`.
-/

set_option maxRecDepth 100000

namespace R6Chk.Bit.Loc

open R6Chk R6Chk.Bit

/-! ## Bits -/

/-! ## Trees -/

/-- A tree with all leaves at depth `d`, each below `2 ^ W`. -/
def Good (W : ℕ) : LT → ℕ → Prop
  | .leaf x, 0 => x < 2 ^ W
  | .leaf _, _ + 1 => False
  | .node _ _, 0 => False
  | .node l r, d + 1 => Good W l d ∧ Good W r d

/-! ## Packed code states -/

/-- Concatenation of `B`-bit words. -/
def catB (B : ℕ) (l : List ℕ) : ℕ := l.foldr (fun x acc => x ||| (acc <<< B)) 0

/-! ## The generator on code functions -/

/-- One touched wire: move it to `c` unless it is there. -/
def mvF (c : ℕ) (acc : (ℕ → ℕ) × List (ℕ × ℕ)) (w : ℕ) : (ℕ → ℕ) × List (ℕ × ℕ) :=
  if acc.1 w = c then acc else (Function.update acc.1 w c, (w, acc.1 w) :: acc.2)

def genStepF (acc : (ℕ → ℕ) × List LChunk) (i : LInstr) : (ℕ → ℕ) × List LChunk :=
  let r := i.2.1.foldl (mvF i.1) (acc.1, [])
  (r.1, (i.1, r.2.reverse, i.2.2) :: acc.2)

/-- **The label generator** (specification). -/
def genF (f : ℕ → ℕ) (W : List LInstr) : (ℕ → ℕ) × List LChunk :=
  let r := W.foldl genStepF (f, [])
  (r.1, r.2.reverse)

/-- Touched wires and codes fit 16 bits. -/
def Fits (W : List LInstr) : Prop := ∀ i ∈ W, i.1 < 65536 ∧ ∀ w ∈ i.2.1, w < 65536

/-- The code function of a packed state. -/
def codeOf (S : ℕ) : ℕ → ℕ := fun w => fieldOf S 16 w

end R6Chk.Bit.Loc

end

section
-- Source module: Solutions.R6BitNBLabGen
/-!
# Round six, bit network: programs from generated chunks

A local program is a list of chunks `(code, moves, gates)` over local wires `ℕ`. Mapped to global
wires by `ι`, a chunk becomes: one frame-change edge per move (`E old code`), then one XOR gate
`x_d ← x_d + x_s` per gate.

* `genF_labGates`: for chunks produced by `genF` (the label generator), all gates are label
  consistent (`LabGates`) as soon as every move edge maps the frame of its old code to the
  frame of its new code; the final labels are the frames of the final codes.
* `chunkProg_scalar`: the (module-valued) scalar circuit of a mapped chunk program is the local
  XOR run `xrL` of its gates.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open R6Chk.Bit.Loc Matrix

section Prog

variable {Wr : Type*} [DecidableEq Wr] {R : Type*} [CommRing R] {m : ℕ}

/-- The XOR gate `x_d ← x_d + x_s`. -/
def xorG (d s : Wr) : Instr Wr R m :=
  Instr.gate (fun x y => if x = y then 1 else if x = d ∧ y = s then 1 else 0) {d, s}

/-- The instructions of one chunk. -/
def chunkInstrs (ι : ℕ → Wr) (E : ℕ → ℕ → Edge m) (ch : LChunk) : List (Instr Wr R m) :=
  ch.2.1.map (fun mv => Instr.edge (ι mv.1) (E mv.2 ch.1)) ++ ch.2.2.map fun p => xorG (ι p.1) (ι p.2)

/-- The program of a chunk list. -/
def chunkProg (ι : ℕ → Wr) (E : ℕ → ℕ → Edge m) (cs : List LChunk) : List (Instr Wr R m) :=
  cs.flatMap (chunkInstrs ι E)

end Prog

/-! ## The scalar circuit of a chunk program -/

section Scalar

variable {Wr : Type*} [DecidableEq Wr] {R : Type*} [CommRing R] {m : ℕ}
  {M : Type*} [AddCommGroup M] [Module R M]

/-- Local XOR run: `u_d ← u_d + u_s` for each gate `(d, s)`. -/
def xrL (l : List (ℕ × ℕ)) (u : ℕ → M) : ℕ → M :=
  l.foldl (fun u p => Function.update u p.1 (u p.1 + u p.2)) u

variable (ι : ℕ → Wr) (D : ℕ → Prop) (E : ℕ → ℕ → Edge m)

end Scalar

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitNBScalA
/-!
# Round six, bit network: the producer computes the node values (`B A C = I`)

Over a module `M` of characteristic two, for inputs `x : ℕ → M`:

* XOR-run algebra: `xrL` is additive, is inverted by the reversed run, and acts on read/write
  separated gate lists by adding the sources;
* `msum x mask = Σ_{i ∈ mask} x_i`;
* `prod_vals`: after copying `x_t` into the source slots (`Cg`) and running the producer
  (`Ag`), slot `q` holds `msum x (supG (idF IDS3 q))` (the node-id simulation, checked by the
  kernel in `R6BitNBIdB0..2`);
* `reads_eq`: the six slots read for target `T` sum to `x_T` (`R6BitNBIdRd`).
-/

set_option linter.unusedSectionVars false
set_option maxRecDepth 100000

namespace IntMul.Kappa.R6.Bit

open R6Chk R6Chk.Bit R6Chk.Bit.Loc

/-! ## Masks -/

section Msum

variable {M : Type*} [AddCommGroup M]

/-- `Σ_{i ∈ mask} x_i` (masks below `2 ^ 1792`). -/
def msum (x : ℕ → M) (mask : ℕ) : M := ∑ i ∈ Finset.range 1792, if mask.testBit i then x i else 0

end Msum

/-! ## The node-id simulation -/

section IdSim

variable {M : Type*} [AddCommGroup M] (h2 : ∀ a : M, a + a = 0) (x : ℕ → M)

/-- Slot `q` holds the value of node `idF S q`. -/
def IdInv (S : ℕ) (z : ℕ → M) : Prop := ∀ q < NR, z (wS q) = msum x (supG (idF S q))

/-- The source copies `x_t ↦ slot srcS t`. -/
def Cg : List (ℕ × ℕ) := (List.range NV).map fun t => (wS (srcS t), wX t)

/-- The producer gates. -/
def Ag : List (ℕ × ℕ) := recs.flatMap recEl

/-- The reads for target `T`: retained slots of its points, then its injection slots. -/
def readSum (z : ℕ → M) (T : ℕ) : M :=
  (tri3.map fun k => z (wS (retS (pts T k)))).sum + (tri3.map fun k => z (wS (injS T k))).sum

end IdSim

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitNBScalB
/-!
# Round six, bit network: the scalar effect of one invocation

The gate lists of the two stage words (`G1`, `G2`) act on local wires (inputs `x`, targets `y`,
slots, temporaries) of any module of characteristic two. With the temporaries starting at `0`:
the inputs and slots are unchanged and the targets receive the inputs, `y_T ← y_T + x_T`.

The proof splits the start values into the input part and the rest. On the rest, both read blocks
add the same reads of the producer values, which cancel. On the inputs, the producer computes the
node values (`prod_vals`) and the reads give back `x_T` (`reads_eq`).
-/

set_option maxRecDepth 100000

namespace IntMul.Kappa.R6.Bit

open R6Chk R6Chk.Bit R6Chk.Bit.Loc

/-! ## Small table facts -/

/-- The retained slots and nodes of the 23 points. -/
def retChk : Bool := (List.range 23).all fun c => Nat.blt (retS c) NR && Nat.blt (retN c) 36513

/-! ## Well-formedness of the producer gates -/

/-- A slot-to-slot gate between distinct slots. -/
def SlotG (p : ℕ × ℕ) : Prop := ∃ q q', p = (wS q, wS q') ∧ q < NR ∧ q' < NR ∧ q ≠ q'

/-! ## Wire ranges -/

/-- Slot wires. -/
def IsSlot (w : ℕ) : Prop := 3542 ≤ w ∧ w < 43619

/-! ## XOR-run helpers -/

/-! ## The gate lists -/

/-- Scatter from the retained slots. -/
def Sg : List (ℕ × ℕ) := (List.range NV).flatMap (scatEl rdS)

/-- Injections. -/
def injEl (T : ℕ) : List (ℕ × ℕ) := tri3.map fun k => (wY T, wS (injS T k))

def Ig : List (ℕ × ℕ) := (List.range NV).flatMap injEl

/-- Copies of the retained slots into the temporaries. -/
def Tg : List (ℕ × ℕ) := (List.range 23).map fun c => (wT c, wS (retS c))

/-- Scatter from the temporaries. -/
def STg : List (ℕ × ℕ) := (List.range NV).flatMap (scatEl wT)

/-- The gates of the stage-one word. -/
def G1 : List (ℕ × ℕ) :=
  Ag ++ (Sg ++ Ig) ++ Ag.reverse ++ Cg ++ (Ag ++ (Tg ++ STg ++ Ig) ++ Ag.reverse) ++ Cg

/-- The gates of the stage-two word. -/
def G2 : List (ℕ × ℕ) :=
  Cg.reverse ++ (Ag ++ (Ig.reverse ++ (Tg ++ STg.reverse)) ++ Ag.reverse) ++ Cg.reverse ++
    (Ag ++ (Ig.reverse ++ Sg.reverse) ++ Ag.reverse)

/-- Target wires. -/
def IsTgt (w : ℕ) : Prop := 1771 ≤ w ∧ w < 3542

/-! ## Read blocks -/

section Reads

variable {M : Type*} [AddCommGroup M]

/-- The effect of a read block: inputs and slots kept, targets receive the reads. -/
def ReadsP (R : List (ℕ × ℕ)) (z z' : ℕ → M) : Prop :=
  (∀ w, w < 1771 ∨ IsSlot w → z' w = z w) ∧ ∀ T < NV, z' (wY T) = z (wY T) + readSum z T

/-- Temporaries hold `0`. -/
def TmpZ (z : ℕ → M) : Prop := ∀ c < 23, z (wT c) = 0

end Reads

/-! ## The sandwich `A · R · A⁻¹` -/

/-! ## The two stages -/

section Stages

variable {M : Type*} [AddCommGroup M] (h2 : ∀ a : M, a + a = 0)

/-- Input part: zero off the inputs. -/
def xPart (u : ℕ → M) : ℕ → M := fun w => if w < 1771 then u w else 0

end Stages

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitNBStWD
/-!
# Round six, bit network: the full stage words (definitions) and table checks

`W1F` (stage one) and `W2F` (stage two): the static ops and the generator segments of
`R6BitNBGenP` in order. Stage one: ops `0–3` (all touched wires at code `LOW`), segments `0–9`,
op `8` (`mixI` at `HIGH`), segment `10`. Stage two: the reversed ops `9, 8` (at `HIGH`), segments
`0–9`, the reversed ops `3, …, 0` (at `LOW`).
-/

set_option maxRecDepth 100000

namespace R6Chk.Bit.Loc

noncomputable section

open R6Chk R6Chk.Bit

/-- Stage-one word. -/
def W1F : List LInstr :=
  (mixF fun _ => cLOW) ++ (scat rdS fun _ => cLOW) ++ (injo fun _ => cLOW) ++ (mixI fun _ => cLOW) ++
    (segW1 0 ++ segW1 1 ++ segW1 2 ++ segW1 3 ++ segW1 4 ++ segW1 5 ++ segW1 6 ++ segW1 7 ++
      segW1 8 ++ segW1 9) ++ (mixI fun _ => cHIGH) ++ segW1 10

/-- Stage-two word. -/
def W2F : List LInstr :=
  revI (copyo fun _ => cHIGH) ++ revI (mixI fun _ => cHIGH) ++
    (segW2 0 ++ segW2 1 ++ segW2 2 ++ segW2 3 ++ segW2 4 ++ segW2 5 ++ segW2 6 ++ segW2 7 ++
      segW2 8 ++ segW2 9) ++
    revI (mixI fun _ => cLOW) ++ revI (injo fun _ => cLOW) ++ revI (scat rdS fun _ => cLOW) ++
      revI (mixF fun _ => cLOW)

/-- Number of touched wires. -/
def touchCnt (W : List LInstr) : ℕ := W.foldl (fun a i => Nat.add a i.2.1.length) 0

/-- Code facts of a packed state on the inputs, targets and slots. -/
def sgFacts (t : LT) (fx fy fs : ℕ → ℕ) : Bool :=
  (List.range NV).all (fun i => Nat.beq (pget t (wX i)) (fx i) && Nat.beq (pget t (wY i)) (fy i)) &&
    (List.range NR).all fun q => Nat.beq (pget t (wS q)) (fs q)

/-- All local codes are valid (`< 38286`). -/
def sgValid (t : LT) : Bool := (List.range 43642).all fun w => Nat.blt (pget t w) 38286

end

end R6Chk.Bit.Loc

end

section
-- Source module: Solutions.R6BitNBStW
/-!
# Round six, bit network: the generated chunks of the two stage words

For the stage words `W1F`, `W2F`:
* their gates are the lists `G1`, `G2` of `R6BitNBScalB`;
* every instruction has a valid code, touches local wires (`< NL`) and its gates join distinct
  touched wires;
* the generator, started at the packed states `SG1_0`, `SG2_0`, ends at `SG1_11`, `SG2_10`; all
  its moves are nested (`nestOK`) between valid codes, and the move ranks are counted by the sums
  of the segment counts.

The segments are the kernel checks `seg1_j`, `seg2_j`; the static ops are handled by
`genF_static` with the code facts `sgk*` of the packed states.
-/

set_option maxRecDepth 100000

namespace IntMul.Kappa.R6.Bit

open R6Chk R6Chk.Bit R6Chk.Bit.Loc

/-- Local wires. -/
def NL : ℕ := 43642

/-! ## Gates -/

/-- The gates of a word. -/
def gatesW (W : List LInstr) : List (ℕ × ℕ) := W.flatMap fun i => i.2.2

/-! ## Well-formed instructions -/

/-- A valid code, local touched wires, gates between distinct touched wires. -/
def InstrOK (i : LInstr) : Prop :=
  i.1 < 38286 ∧ (∀ w ∈ i.2.1, w < NL) ∧ ∀ p ∈ i.2.2, p.1 ∈ i.2.1 ∧ p.2 ∈ i.2.1 ∧ p.1 ≠ p.2

def WFw (W : List LInstr) : Prop := ∀ i ∈ W, InstrOK i

/-- Touched wires satisfy `P`, and the instruction code is `c`. -/
def TouchC (P : ℕ → Prop) (c : ℕ → Prop) (W : List LInstr) : Prop := ∀ i ∈ W, c i.1 ∧ ∀ w ∈ i.2.1, P w

/-- Wire classes. -/
def IsS (w : ℕ) : Prop := ∃ q < NR, w = wS q
def IsY (w : ℕ) : Prop := ∃ T < NV, w = wY T
def IsX (w : ℕ) : Prop := ∃ t < NV, w = wX t

/-! ## The generator: validity, ranks, counts -/

/-- Valid codes on the local wires. -/
def ValidOn (f : ℕ → ℕ) : Prop := ∀ w < NL, f w < 38286

/-- Moves between valid codes. -/
def MovesV (cs : List LChunk) : Prop :=
  ∀ ch ∈ cs, ∀ mv ∈ ch.2.1, nestOK mv.2 ch.1 = true ∧ mv.2 < 38286 ∧ ch.1 < 38286

/-- Move ranks. -/
noncomputable def rkC (a b : ℕ) : ℕ := let a1 := dimCF a; let b1 := dimCF b
  cond (Nat.blt a1 b1) (Nat.sub b1 a1) (Nat.sub a1 b1)

noncomputable def mvRanks (cs : List LChunk) : List ℕ := cs.flatMap fun ch => ch.2.1.map fun m => rkC m.2 ch.1

/-! ## Segments -/

/-- A piece of a stage word from packed state `S` to `S'` with rank count `c`. -/
def Seg (S S' c : ℕ) (W : List LInstr) : Prop :=
  WFw W ∧ ∀ f : ℕ → ℕ, (∀ w < 65536, f w = codeOf S w) → ValidOn f →
    (∀ w < 65536, (genF f W).1 w = codeOf S' w) ∧ ValidOn (genF f W).1 ∧ MovesV (genF f W).2 ∧
      cntF (genF f W).2 = c

