theorem centerBoxes_contains : centerBoxes.ContainsAt centerS centerT := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · obtain ⟨a, ha, hpos, hy⟩ := E8TAxisProd0431EndpointWitnesses.centerA_covers
    have hh := E8TAxisProd0431GraphCenterA.qJetBox_contains ha hpos
    rw [hy] at hh
    exact hh
  · obtain ⟨a, ha, hpos, hy⟩ := E8TAxisProd0431EndpointWitnesses.centerB_covers
    have hh := E8TAxisProd0431GraphCenterB.qJetBox_contains ha hpos
