/-!
# Finite generation: the two directions across a finite-index subgroup

Mathlib has Schreier's lemma `Subgroup.fg_of_index_ne_zero`, that a finite-index subgroup of a
finitely generated group is finitely generated.  Wolf's Proposition 4.1 needs the converse as
well, that finite generation passes *up* from a finite-index subgroup, and the standard
"generators of the quotient together with the kernel" principle.
-/

namespace Wolf
namespace Lib

open Subgroup

end Lib
end Wolf

/-!
# The lower central series: plumbing

The terms `Γ_k` of the lower central series, the canonical surjection `Γ_k → Γ_k/Γ_{k+1}` of the
definition bundle, and the consequence that a finitely generated factor is witnessed by finitely
many elements of `Γ_k` together with `Γ_{k+1}`.

These were part of the nilpotent-groups module, which imports Wolf's Theorem 3.2; they are
separated out because a solution *of* Theorem 3.2 needs them and cannot import it.
-/

namespace Wolf
namespace Lib

open Subgroup

variable {Γ : Type*} [Group Γ]

/-- `Γ_{k+1} ≤ Γ_k`. -/
theorem lcs_succ_le (k : ℕ) : MilnorWolf.lcs Γ (k + 1) ≤ MilnorWolf.lcs Γ k := by
  show ⁅MilnorWolf.lcs Γ k, (⊤ : Subgroup Γ)⁆ ≤ MilnorWolf.lcs Γ k
  exact Subgroup.commutator_le_left _ _

end Lib
end Wolf

/-!
# Lemma 3.7: the commutator step

Wolf's computation on p. 428.  In `Δ = Γ/Γ_{k+2}` the factor `Γ_{k+1}/Γ_{k+2}` is central, so
the commutator is bilinear in each slot there; consequently `Γ_{k+1}/Γ_{k+2}` is generated by
the images of the commutators `⁅x, y⁆` with `x` running over a generating set of `Γ` and `y`
over a set whose image generates `Γ_k/Γ_{k+1}`.

This is the half of Lemma 3.7 that Wolf's proof really establishes, and it is needed on any
route to the lemma.  The other half — extracting from that generating family an *independent*
one consisting of commutators — is the step whose justification in the paper ("choose any
independent generating subset") does not follow from finite generation alone; see
`wolf/NOTES-lemma37-choice-gap.md`.
-/

namespace Wolf
namespace Lib

open scoped commutatorElement

variable {Γ : Type*} [Group Γ]

/-- Conjugation moves an element of `Γ_{k+1}` only by an element of `Γ_{k+2}`. -/
theorem conj_mem_of_mem_lcs_succ {k : ℕ} {H : Subgroup Γ}
    (hH : MilnorWolf.lcs Γ (k + 2) ≤ H) (g : Γ) {c : Γ}
    (hc : c ∈ MilnorWolf.lcs Γ (k + 1)) (hcH : c ∈ H) : g * c * g⁻¹ ∈ H := by
  have h1 : ⁅g, c⁆ ∈ MilnorWolf.lcs Γ (k + 2) := by
    have h : ⁅g, c⁆ ∈ ⁅(⊤ : Subgroup Γ), MilnorWolf.lcs Γ (k + 1)⁆ :=
      Subgroup.commutator_mem_commutator (Subgroup.mem_top g) hc
    rwa [Subgroup.commutator_comm] at h
  have h2 : g * c * g⁻¹ = ⁅g, c⁆ * c := by group
  rw [h2]
  exact H.mul_mem (hH h1) hcH

/-- `⁅a, b⁆` lies in `Γ_{k+1}` when `b` lies in `Γ_k`. -/
theorem commutatorElement_mem_lcs_succ {k : ℕ} (a : Γ) {b : Γ}
    (hb : b ∈ MilnorWolf.lcs Γ k) : ⁅a, b⁆ ∈ MilnorWolf.lcs Γ (k + 1) := by
  have h : ⁅a, b⁆ ∈ ⁅(⊤ : Subgroup Γ), MilnorWolf.lcs Γ k⁆ :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top a) hb
  rwa [Subgroup.commutator_comm] at h

/-- Bilinearity in the second slot, modulo `Γ_{k+2}`: the `b` for which `⁅a, b⁆` lies in `H`
form a subgroup of `Γ_k`. -/
theorem commutator_mem_of_mem_closure_right {k : ℕ} {H : Subgroup Γ}
    (hH : MilnorWolf.lcs Γ (k + 2) ≤ H) (a : Γ)
    (Y : Set Γ) (hY : Y ⊆ MilnorWolf.lcs Γ k) (hYH : ∀ y ∈ Y, ⁅a, y⁆ ∈ H) :
    ∀ b ∈ Subgroup.closure (Y ∪ (MilnorWolf.lcs Γ (k + 1) : Set Γ)), ⁅a, b⁆ ∈ H := by
  intro b hb
  have hsub : Subgroup.closure (Y ∪ (MilnorWolf.lcs Γ (k + 1) : Set Γ))
      ≤ MilnorWolf.lcs Γ k := by
    rw [Subgroup.closure_le]
    rintro z (hz | hz)
    · exact hY hz
    · exact (⊤ : Subgroup Γ).lowerCentralSeries_antitone (Nat.le_succ k) hz
  induction hb using Subgroup.closure_induction with
  | mem z hz =>
      rcases hz with hz | hz
      · exact hYH z hz
      · exact hH (by
          have h : ⁅a, z⁆ ∈ ⁅(⊤ : Subgroup Γ), MilnorWolf.lcs Γ (k + 1)⁆ :=
            Subgroup.commutator_mem_commutator (Subgroup.mem_top a) hz
          rwa [Subgroup.commutator_comm] at h)
  | one => simpa using H.one_mem
  | mul u v hu hv ihu ihv =>
      have hfac : ⁅a, u * v⁆ = ⁅a, u⁆ * (u * ⁅a, v⁆ * u⁻¹) := by group
      rw [hfac]
      exact H.mul_mem ihu
        (conj_mem_of_mem_lcs_succ hH u (commutatorElement_mem_lcs_succ a (hsub hv)) ihv)
  | inv u hu ihu =>
      have hfac : ⁅a, u⁻¹⁆ = u⁻¹ * ⁅a, u⁆⁻¹ * u := by group
      rw [hfac]
      have hconj := conj_mem_of_mem_lcs_succ hH u⁻¹
        ((MilnorWolf.lcs Γ (k + 1)).inv_mem (commutatorElement_mem_lcs_succ a (hsub hu)))
        (H.inv_mem ihu)
      simpa using hconj

/-- Bilinearity in the first slot, modulo `Γ_{k+2}`. -/
theorem commutator_mem_of_mem_closure_left {k : ℕ} {H : Subgroup Γ}
    (hH : MilnorWolf.lcs Γ (k + 2) ≤ H)
    {b : Γ} (hb : b ∈ MilnorWolf.lcs Γ k) (X : Set Γ) (hXH : ∀ x ∈ X, ⁅x, b⁆ ∈ H) :
    ∀ a ∈ Subgroup.closure X, ⁅a, b⁆ ∈ H := by
  intro a ha
  induction ha using Subgroup.closure_induction with
  | mem z hz => exact hXH z hz
  | one => simpa using H.one_mem
  | mul u v hu hv ihu ihv =>
      have hfac : ⁅u * v, b⁆ = ⁅u, ⁅v, b⁆⁆ * ⁅v, b⁆ * ⁅u, b⁆ := by group
      rw [hfac]
      refine H.mul_mem (H.mul_mem (hH ?_) ihv) ihu
      have h : ⁅u, ⁅v, b⁆⁆ ∈ ⁅(⊤ : Subgroup Γ), MilnorWolf.lcs Γ (k + 1)⁆ :=
        Subgroup.commutator_mem_commutator (Subgroup.mem_top u)
          (commutatorElement_mem_lcs_succ v hb)
      rwa [Subgroup.commutator_comm] at h
  | inv u hu ihu =>
      have hfac : ⁅u⁻¹, b⁆ = u⁻¹ * ⁅u, b⁆⁻¹ * u := by group
      rw [hfac]
      have hconj := conj_mem_of_mem_lcs_succ hH u⁻¹
        ((MilnorWolf.lcs Γ (k + 1)).inv_mem (commutatorElement_mem_lcs_succ u hb))
        (H.inv_mem ihu)
      simpa using hconj

/-- **Wolf's commutator step.**  If `X` generates `Γ` and the image of `Y ⊆ Γ_k` generates
`Γ_k/Γ_{k+1}`, then the images of the commutators `⁅x, y⁆` generate `Γ_{k+1}/Γ_{k+2}`. -/
theorem lcs_succ_le_closure_commutators (k : ℕ) (X Y : Set Γ)
    (hX : Subgroup.closure X = ⊤) (hY : Y ⊆ MilnorWolf.lcs Γ k)
    (hYgen : MilnorWolf.lcs Γ k ≤ Subgroup.closure Y ⊔ MilnorWolf.lcs Γ (k + 1)) :
    MilnorWolf.lcs Γ (k + 1)
      ≤ Subgroup.closure {g : Γ | ∃ x ∈ X, ∃ y ∈ Y, ⁅x, y⁆ = g}
          ⊔ MilnorWolf.lcs Γ (k + 2) := by
  set H : Subgroup Γ := Subgroup.closure {g : Γ | ∃ x ∈ X, ∃ y ∈ Y, ⁅x, y⁆ = g}
      ⊔ MilnorWolf.lcs Γ (k + 2) with hHdef
  have hH : MilnorWolf.lcs Γ (k + 2) ≤ H := fun z hz => Subgroup.mem_sup_right hz
  have hCH : ∀ x ∈ X, ∀ y ∈ Y, ⁅x, y⁆ ∈ H := fun x hx y hy =>
    Subgroup.mem_sup_left (Subgroup.subset_closure ⟨x, hx, y, hy, rfl⟩)
  -- every `⁅x, b⁆` with `x ∈ X` and `b ∈ Γ_k` lies in `H`
  have hstep : ∀ x ∈ X, ∀ b ∈ MilnorWolf.lcs Γ k, ⁅x, b⁆ ∈ H := by
    intro x hx b hb
    have hclosure : MilnorWolf.lcs Γ k
        ≤ Subgroup.closure (Y ∪ (MilnorWolf.lcs Γ (k + 1) : Set Γ)) := by
      rw [Subgroup.closure_union, Subgroup.closure_eq]
      exact hYgen
    exact commutator_mem_of_mem_closure_right hH x Y hY (fun y hy => hCH x hx y hy) b (hclosure hb)
  -- hence every `⁅a, b⁆` with `a ∈ Γ` and `b ∈ Γ_k` lies in `H`
  have hall : ∀ (a : Γ), ∀ b ∈ MilnorWolf.lcs Γ k, ⁅a, b⁆ ∈ H := by
    intro a b hb
    refine commutator_mem_of_mem_closure_left hH hb X (fun x hx => hstep x hx b hb) a ?_
    rw [hX]; trivial
  -- and `Γ_{k+1} = ⁅Γ_k, ⊤⁆`
  rw [show MilnorWolf.lcs Γ (k + 1) = ⁅MilnorWolf.lcs Γ k, (⊤ : Subgroup Γ)⁆ from rfl,
    Subgroup.commutator_le]
  intro p hp q _
  have h := hall q p hp
  have : ⁅p, q⁆ = ⁅q, p⁆⁻¹ := by group
  rw [this]
  exact H.inv_mem h

/-! ### Bilinearity as a homomorphism

The membership lemmas above say that `⁅a, b⁆` *lands in* a subgroup lying above `Γ_{k+2}`.
Wolf's word-length induction in Theorem 3.2 needs more: that `⁅a, bᵖ⁆` and `⁅a, b⁆ᵖ` are *equal*
modulo `Γ_{k+2}`.  That is the statement that `b ↦ ⁅a, b⁆` is a homomorphism into
`Γ / Γ_{k+2}`, which is what the centrality of `Γ_{k+1}/Γ_{k+2}` really buys.
-/

/-- Conjugation is invisible modulo `Γ_{k+2}` on elements of `Γ_{k+1}`. -/
theorem mk_conj_eq_mk {k : ℕ} (g : Γ) {c : Γ} (hc : c ∈ MilnorWolf.lcs Γ (k + 1)) :
    (QuotientGroup.mk (g * c * g⁻¹) : Γ ⧸ MilnorWolf.lcs Γ (k + 2))
      = QuotientGroup.mk c := by
  rw [QuotientGroup.eq]
  have h2 : (g * c * g⁻¹)⁻¹ * c = ⁅g, c⁻¹⁆ := by group
  rw [h2]
  have h3 : ⁅g, c⁻¹⁆ ∈ ⁅(⊤ : Subgroup Γ), MilnorWolf.lcs Γ (k + 1)⁆ :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top g)
      ((MilnorWolf.lcs Γ (k + 1)).inv_mem hc)
  rwa [Subgroup.commutator_comm] at h3

/-- **Bilinearity in the second slot.**  For a fixed `a`, taking the commutator with `a` is a
homomorphism from `Γ_k` to `Γ / Γ_{k+2}`. -/
noncomputable def commutatorHom (a : Γ) (k : ℕ) :
    ↥(MilnorWolf.lcs Γ k) →* Γ ⧸ MilnorWolf.lcs Γ (k + 2) where
  toFun b := QuotientGroup.mk ⁅a, (b : Γ)⁆
  map_one' := by
    simp only [OneMemClass.coe_one, commutatorElement_one_right]
    rfl
  map_mul' b b' := by
    have hfac : ⁅a, (b : Γ) * (b' : Γ)⁆
        = ⁅a, (b : Γ)⁆ * ((b : Γ) * ⁅a, (b' : Γ)⁆ * (b : Γ)⁻¹) := by group
    show (QuotientGroup.mk ⁅a, ((b * b' : ↥(MilnorWolf.lcs Γ k)) : Γ)⁆ : Γ ⧸ _) = _
    rw [Subgroup.coe_mul, hfac, QuotientGroup.mk_mul,
      mk_conj_eq_mk (k := k) (b : Γ) (commutatorElement_mem_lcs_succ a b'.2)]

@[simp] theorem commutatorHom_apply (a : Γ) (k : ℕ) (b : ↥(MilnorWolf.lcs Γ k)) :
    commutatorHom a k b = QuotientGroup.mk ⁅a, (b : Γ)⁆ := rfl

/-- Modulo `Γ_{k+2}`, the image of `Γ_{k+1}` is central. -/
theorem mk_commute_of_mem_lcs_succ {k : ℕ} {c : Γ} (hc : c ∈ MilnorWolf.lcs Γ (k + 1)) (g : Γ) :
    Commute (QuotientGroup.mk c : Γ ⧸ MilnorWolf.lcs Γ (k + 2)) (QuotientGroup.mk g) := by
  have h := mk_conj_eq_mk (k := k) g hc
  rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv] at h
  have h2 := congrArg (fun z => z * (QuotientGroup.mk g : Γ ⧸ MilnorWolf.lcs Γ (k + 2))) h
  simp only [inv_mul_cancel_right] at h2
  exact h2.symm

/-- **Bilinearity in the first slot.**  For `b` in `Γ_k`, taking the commutator with `b` is a
homomorphism from `Γ` to `Γ / Γ_{k+2}`.  Wolf's induction uses this together with the second-slot
version to spread an exponent `am` across the two arguments as `⁅aᵐ, bᵃ⁆`. -/
noncomputable def commutatorHomLeft {k : ℕ} {b : Γ} (hb : b ∈ MilnorWolf.lcs Γ k) :
    Γ →* Γ ⧸ MilnorWolf.lcs Γ (k + 2) where
  toFun a := QuotientGroup.mk ⁅a, b⁆
  map_one' := by
    simp only [commutatorElement_one_left]
    rfl
  map_mul' a a' := by
    have hfac : ⁅a * a', b⁆ = ⁅a, ⁅a', b⁆⁆ * (⁅a', b⁆ * ⁅a, b⁆) := by group
    have hmem : ⁅a, ⁅a', b⁆⁆ ∈ MilnorWolf.lcs Γ (k + 2) :=
      commutatorElement_mem_lcs_succ a (commutatorElement_mem_lcs_succ a' hb)
    show (QuotientGroup.mk ⁅a * a', b⁆ : Γ ⧸ _) = _
    rw [hfac, QuotientGroup.mk_mul, (QuotientGroup.eq_one_iff _).2 hmem, one_mul,
      QuotientGroup.mk_mul]
    exact mk_commute_of_mem_lcs_succ (k := k) (commutatorElement_mem_lcs_succ a' hb) ⁅a, b⁆

@[simp] theorem commutatorHomLeft_apply {k : ℕ} {b : Γ} (hb : b ∈ MilnorWolf.lcs Γ k) (a : Γ) :
    commutatorHomLeft hb a = QuotientGroup.mk ⁅a, b⁆ := rfl

/-! ### Wolf's collection step

The mechanism behind (3.10), p. 430: "if the previously introduced word is `η = η₁ ⋯ η_s` with
`η_k` a word on `T_k`, then `η τ^{±1} = τ^{±1} η'` where `η'_k = ⁅η_{k-1}, τ^{∓1}⁆ η_k`."  In
other words, moving a generator past an element of `Γ_j` leaves that element where it was and
introduces a correction one level up.  Iterating this is what makes the exponent double. -/

end Lib
end Wolf

/-!
# Lemma 3.7 with a weakened condition (i)

Wolf's Lemma 3.7 asks for finite subsets `T_k ⊆ Γ_k` whose images form an *independent*
generating set of `Γ_k/Γ_{k+1}`, with `T_{k+1}` consisting of commutators of elements of `T₀`
with elements of `T_k`, and `T₀` generating `Γ`.  Asking for an independent generating set is
too much in general (see `wolf/NOTES-lemma37-choice-gap.md`).  This module proves the version in
which condition (i) is weakened to:

* the images of `T_k` generate `Γ_k/Γ_{k+1}`, and
* some subfamily `J ⊆ T_k` has independent images, each of infinite order, spanning a subgroup of
  finite index.

The proof:

1. `T₀` lifts a finite generating set of `Γ/Γ₁` (`hfg`).
2. `T₀` generates `Γ`: a subgroup `H` with `H ⊔ Γ₁ = ⊤` satisfies `H ⊔ Γ_{j+1} = ⊤` for every `j`
   (`sup_lcs_succ_eq_top`), and `Γ_{s+1} = 1`.
3. `T_{k+1}` is the family of all commutators `⁅t, u⁆`, `t ∈ T₀`, `u ∈ T_k`
   (`lcsCommutatorFamily`); that it generates `Γ_{k+1}/Γ_{k+2}` is Wolf's commutator step
   `lcs_succ_le_closure_commutators`.
4. The subfamily `J` is a maximal `ℤ`-linearly independent subfamily of a finite generating family
   of a commutative group (`exists_indep_finiteIndex_subfamily`): every generator has a nonzero
   power in the span of `J`, so the quotient by that span is a finitely generated torsion abelian
   group, hence finite.
-/

namespace Wolf
namespace Lib

open scoped commutatorElement

/-! ### Finite generating families of commutative groups -/

/-- The subgroup generated by the range of a family is the supremum of the cyclic subgroups. -/
theorem closure_range_eq_iSup_zpowers' {G : Type*} [Group G] {ι : Type*} (x : ι → G) :
    Subgroup.closure (Set.range x) = ⨆ i, Subgroup.zpowers (x i) := by
  rw [← Set.iUnion_singleton_eq_range, Subgroup.closure_iUnion]
  simp_rw [← Subgroup.zpowers_eq_closure]

/-- **A free subfamily of finite index.**  If the finitely many elements `x i` generate the
commutative group `Q`, then some subfamily `J` generates an internal direct sum of infinite cyclic
groups (the cyclic subgroups are independent and each `x j`, `j ∈ J`, has infinite order), and
that sum has finite index in `Q`.  `J` is a maximal `ℤ`-linearly independent subfamily. -/
theorem exists_indep_finiteIndex_subfamily {Q : Type*} [CommGroup Q] {n : ℕ} (x : Fin n → Q)
    (hx : (⨆ i, Subgroup.zpowers (x i)) = ⊤) :
    ∃ J : Finset (Fin n),
      iSupIndep (fun j : J => Subgroup.zpowers (x j)) ∧
      (∀ j ∈ J, ¬ IsOfFinOrder (x j)) ∧
      (⨆ j : J, Subgroup.zpowers (x j)).FiniteIndex := by
  classical
  set v : Fin n → Additive Q := fun i => Additive.ofMul (x i) with hv
  obtain ⟨s, hs, hmax⟩ := exists_maximal_linearIndepOn ℤ v
  set J : Finset (Fin n) := (Set.toFinite s).toFinset with hJdef
  have hJs : ∀ j, j ∈ J ↔ j ∈ s := fun j => Set.Finite.mem_toFinset _
  have hli : LinearIndependent ℤ (fun j : J => v j) := by
    have hJ : (J : Set (Fin n)) = s := Set.Finite.coe_toFinset _
    have h : LinearIndepOn ℤ v (J : Set (Fin n)) := hJ ▸ hs
    exact h
  refine ⟨J, ?_, ?_, ?_⟩
  · -- independence, transported from `ℤ`-linear independence
    have h1 := hli.iSupIndep_span_singleton
    let e : Subgroup Q ≃o Submodule ℤ (Additive Q) :=
      Subgroup.toAddSubgroup.trans AddSubgroup.toIntSubmodule
    rw [← iSupIndep_map_orderIso_iff e]
    convert h1 using 1
    funext j
    ext y
    change Additive.toMul y ∈ Subgroup.zpowers (x j) ↔ y ∈ ℤ ∙ v j
    rw [Subgroup.mem_zpowers_iff, Submodule.mem_span_singleton]
    exact ⟨fun ⟨k, hk⟩ => ⟨k, hk⟩, fun ⟨k, hk⟩ => ⟨k, hk⟩⟩
  · -- infinite order: a linearly independent vector has no nonzero integer multiple equal to 0
    intro j hj hfin
    obtain ⟨m, hm, hxm⟩ := hfin.exists_pow_eq_one
    have h0 := linearIndependent_iff'.1 hli {⟨j, hj⟩} (fun _ => (m : ℤ)) (by
      rw [Finset.sum_singleton]
      show Additive.ofMul (x j ^ (m : ℤ)) = 0
      rw [zpow_natCast, hxm, ofMul_one]) ⟨j, hj⟩ (Finset.mem_singleton_self _)
    have : (m : ℤ) = 0 := h0
    omega
  · -- finite index: the quotient is a finitely generated torsion abelian group
    set S := ⨆ j : J, Subgroup.zpowers (x j) with hSdef
    have hmemS : ∀ j ∈ s, x j ∈ S := fun j hj =>
      Subgroup.mem_iSup_of_mem (⟨j, (hJs j).2 hj⟩ : J)
        (Subgroup.mem_zpowers _)
    have hspan : ∀ y ∈ Submodule.span ℤ (v '' s), Additive.toMul y ∈ S := by
      intro y hy
      induction hy using Submodule.span_induction with
      | mem z hz =>
          obtain ⟨j, hj, rfl⟩ := hz
          exact hmemS j hj
      | zero => exact S.one_mem
      | add a b _ _ ha hb => exact S.mul_mem ha hb
      | smul c a _ ha => exact S.zpow_mem ha c
    have hpow : ∀ i, ∃ a : ℤ, a ≠ 0 ∧ x i ^ a ∈ S := by
      intro i
      by_cases hi : i ∈ s
      · exact ⟨1, one_ne_zero, by simp [hmemS i hi]⟩
      · obtain ⟨a, ha, hmem⟩ := hmax i hi
        exact ⟨a, ha, hspan _ hmem⟩
    have htors : IsMulTorsion (Q ⧸ S) := by
      have hle : (⊤ : Subgroup (Q ⧸ S)) ≤ CommGroup.torsion (Q ⧸ S) := by
        rw [← Subgroup.map_top_of_surjective (QuotientGroup.mk' S)
          (QuotientGroup.mk'_surjective S), ← hx, Subgroup.map_iSup]
        refine iSup_le fun i => ?_
        rw [MonoidHom.map_zpowers, Subgroup.zpowers_le, CommGroup.mem_torsion]
        obtain ⟨a, ha, hxa⟩ := hpow i
        refine isOfFinOrder_iff_zpow_eq_one.2 ⟨a, ha, ?_⟩
        rw [← map_zpow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
        exact hxa
      intro g
      exact hle (Subgroup.mem_top g)
    have : Group.FG Q := by
      rw [Group.fg_iff]
      exact ⟨Set.range x, by rw [closure_range_eq_iSup_zpowers', hx], Set.finite_range x⟩
    have : Group.FG (Q ⧸ S) := Group.fg_of_surjective (QuotientGroup.mk'_surjective S)
    have : Finite (Q ⧸ S) := CommGroup.finite_of_fg_isMulTorsion _ htors
    exact Subgroup.finiteIndex_of_finite_quotient

/-! ### A supplement of `Γ₁` is everything -/

/-- Central factors do not affect a commutator. -/
theorem commutatorElement_mul_central {G : Type*} [Group G] (a b z w : G)
    (hz : ∀ g, z * g = g * z) (hw : ∀ g, w * g = g * w) : ⁅a * z, b * w⁆ = ⁅a, b⁆ := by
  rw [commutatorElement_def, commutatorElement_def]
  calc a * z * (b * w) * (a * z)⁻¹ * (b * w)⁻¹
      = a * (z * (b * w)) * z⁻¹ * a⁻¹ * (b * w)⁻¹ := by group
    _ = a * ((b * w) * z) * z⁻¹ * a⁻¹ * (b * w)⁻¹ := by rw [hz]
    _ = a * b * (w * a⁻¹) * w⁻¹ * b⁻¹ := by group
    _ = a * b * (a⁻¹ * w) * w⁻¹ * b⁻¹ := by rw [hw]
    _ = a * b * a⁻¹ * b⁻¹ := by group

/-- If `H ⊔ Γ₁ = Γ` then `H ⊔ Γ_{j+1} = Γ` for every `j`.  From `H ⊔ Γ_{j+1} = Γ`: modulo
`Γ_{j+2}` the factor `Γ_{j+1}` is central, so every commutator of `Γ` agrees modulo `Γ_{j+2}` with
a commutator of elements of `H`; hence `Γ₁ ≤ H ⊔ Γ_{j+2}`. -/
theorem sup_lcs_succ_eq_top {Γ : Type*} [Group Γ] (H : Subgroup Γ)
    (hH : H ⊔ MilnorWolf.lcs Γ 1 = ⊤) : ∀ j : ℕ, H ⊔ MilnorWolf.lcs Γ (j + 1) = ⊤ := by
  intro j
  induction j with
  | zero => exact hH
  | succ j ih =>
    set N := MilnorWolf.lcs Γ (j + 1 + 1) with hN
    -- elements of `Γ_{j+1}` are central modulo `N`
    have hcentral : ∀ n ∈ MilnorWolf.lcs Γ (j + 1), ∀ g : Γ ⧸ N,
        (QuotientGroup.mk n : Γ ⧸ N) * g = g * QuotientGroup.mk n := by
      intro n hn g
      induction g using QuotientGroup.induction_on with
      | H g0 =>
        rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq]
        have h := commutatorElement_mem_lcs_succ g0⁻¹
          ((MilnorWolf.lcs Γ (j + 1)).inv_mem hn)
        have heq : (n * g0)⁻¹ * (g0 * n) = ⁅g0⁻¹, n⁻¹⁆ := by
          rw [commutatorElement_def]; group
        rw [heq]
        exact h
    have hkey : MilnorWolf.lcs Γ 1 ≤ H ⊔ N := by
      rw [show MilnorWolf.lcs Γ 1 = ⁅(⊤ : Subgroup Γ), (⊤ : Subgroup Γ)⁆ from rfl,
        Subgroup.commutator_le]
      intro p _ q _
      have hp : p ∈ H ⊔ MilnorWolf.lcs Γ (j + 1) := ih ▸ Subgroup.mem_top p
      have hq : q ∈ H ⊔ MilnorWolf.lcs Γ (j + 1) := ih ▸ Subgroup.mem_top q
      obtain ⟨h, hh, n, hn, rfl⟩ := Subgroup.mem_sup_of_normal_right.1 hp
      obtain ⟨h', hh', n', hn', rfl⟩ := Subgroup.mem_sup_of_normal_right.1 hq
      have hc : ⁅h, h'⁆⁻¹ * ⁅h * n, h' * n'⁆ ∈ N := by
        rw [← QuotientGroup.eq]
        show QuotientGroup.mk' N ⁅h, h'⁆ = QuotientGroup.mk' N ⁅h * n, h' * n'⁆
        simp only [map_commutatorElement, map_mul, QuotientGroup.mk'_apply]
        rw [commutatorElement_mul_central _ _ _ _ (hcentral n hn) (hcentral n' hn')]
      have hH' : ⁅h, h'⁆ ∈ H := by
        rw [commutatorElement_def]
        exact H.mul_mem (H.mul_mem (H.mul_mem hh hh') (H.inv_mem hh)) (H.inv_mem hh')
      have hfac : ⁅h * n, h' * n'⁆ = ⁅h, h'⁆ * (⁅h, h'⁆⁻¹ * ⁅h * n, h' * n'⁆) := by group
      rw [hfac]
      exact (H ⊔ N).mul_mem (Subgroup.mem_sup_left hH') (Subgroup.mem_sup_right hc)
    refine eq_top_iff.2 ?_
    rw [← hH]
    exact sup_le le_sup_left hkey

/-! ### Generation of a factor `A/N` in terms of `Γ` -/

/-- The images of a family `y` in `A` generate `A/N` exactly when `y`, together with `N`,
generates `A`. -/
theorem iSup_zpowers_mk_eq_top_iff {Γ : Type*} [Group Γ] {A N : Subgroup Γ} (hNA : N ≤ A)
    [(N.subgroupOf A).Normal] {ι : Type*} (y : ι → A) :
    (⨆ i, Subgroup.zpowers (QuotientGroup.mk' (N.subgroupOf A) (y i))) = ⊤ ↔
      A ≤ Subgroup.closure (Set.range fun i => (y i : Γ)) ⊔ N := by
  set f := QuotientGroup.mk' (N.subgroupOf A)
  have h1 : (⨆ i, Subgroup.zpowers (f (y i))) =
      Subgroup.map f (Subgroup.closure (Set.range y)) := by
    rw [closure_range_eq_iSup_zpowers', Subgroup.map_iSup]
    simp_rw [MonoidHom.map_zpowers]
  have h2 : Subgroup.map f (Subgroup.closure (Set.range y)) = ⊤ ↔
      Subgroup.closure (Set.range y) ⊔ N.subgroupOf A = ⊤ := by
    rw [← (Subgroup.comap_injective (QuotientGroup.mk'_surjective (N.subgroupOf A))).eq_iff,
      Subgroup.comap_map_eq, Subgroup.comap_top, QuotientGroup.ker_mk']
  have h3 : Subgroup.map A.subtype (Subgroup.closure (Set.range y) ⊔ N.subgroupOf A) =
      Subgroup.closure (Set.range fun i => (y i : Γ)) ⊔ N := by
    rw [Subgroup.map_sup, MonoidHom.map_closure, Subgroup.map_subgroupOf_eq_of_le hNA,
      ← Set.range_comp]
    rfl
  have h4 : Subgroup.map A.subtype ⊤ = A := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  rw [h1, h2, ← (Subgroup.map_injective A.subtype_injective).eq_iff, h3, h4]
  have hle : Subgroup.closure (Set.range fun i => (y i : Γ)) ⊔ N ≤ A := by
    refine sup_le ?_ hNA
    rw [Subgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    exact (y i).2
  exact ⟨fun h => h.ge, fun h => le_antisymm hle h⟩

/-! ### The commutator families -/

/-- Given `t : Fin r₀ → Γ`, the families `T_k ⊆ Γ_k`: `T₀ = t`, and `T_{k+1}` lists all
commutators `⁅t i, u⁆` with `u ∈ T_k`, indexed by `Fin (r₀ * r_k)` via `finProdFinEquiv`. -/
noncomputable def lcsCommutatorFamily {Γ : Type*} [Group Γ] {r₀ : ℕ} (t : Fin r₀ → Γ) :
    (k : ℕ) → Σ r : ℕ, (Fin r → ↥(MilnorWolf.lcs Γ k))
  | 0 => ⟨r₀, fun i => ⟨t i, Subgroup.mem_top _⟩⟩
  | k + 1 => ⟨r₀ * (lcsCommutatorFamily t k).1, fun l =>
      ⟨⁅t (finProdFinEquiv.symm l).1,
          ((lcsCommutatorFamily t k).2 (finProdFinEquiv.symm l).2 : Γ)⁆,
        commutatorElement_mem_lcs_succ _ ((lcsCommutatorFamily t k).2 _).2⟩⟩

/-- **Lemma 3.7, with condition (i) weakened.**  For a group `Γ` with `Γ_{s+1} = 1` and `Γ/Γ₁`
finitely generated there are finite families `τ k` in `Γ_k` such that

* (i') each `Γ_k/Γ_{k+1}` is a finitely generated abelian group generated by the images of
  `τ k`, and some subfamily `J` has independent images of infinite order spanning a subgroup of
  finite index;
* (ii) every member of `τ (k+1)` is a commutator `⁅τ 0 i, τ k j⁆`;
* (iii) `τ 0` generates `Γ`. -/
theorem exists_commutator_generating_sets_with_free_finiteIndex_subfamily_lowerCentralSeries'
    {Γ : Type*} [Group Γ] (s : ℕ)
    (hs : MilnorWolf.lcs Γ (s + 1) = ⊥)
    (hfg : Group.FG (↥(MilnorWolf.lcs Γ 0) ⧸
      (MilnorWolf.lcs Γ 1).subgroupOf (MilnorWolf.lcs Γ 0))) :
    ∃ (r : ℕ → ℕ) (τ : ∀ k, Fin (r k) → ↥(MilnorWolf.lcs Γ k)),
      (∀ k : ℕ,
        letI Q := ↥(MilnorWolf.lcs Γ k) ⧸ ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
          (MilnorWolf.lcs Γ k))
        Group.FG Q ∧ (∀ x y : Q, x * y = y * x) ∧
          (⨆ i : Fin (r k), Subgroup.zpowers
            (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
              (MilnorWolf.lcs Γ k)) (τ k i))) = ⊤ ∧
          ∃ J : Finset (Fin (r k)),
            iSupIndep (fun j : J => Subgroup.zpowers
              (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
                (MilnorWolf.lcs Γ k)) (τ k j))) ∧
            (∀ j ∈ J, ¬ IsOfFinOrder
              (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
                (MilnorWolf.lcs Γ k)) (τ k j))) ∧
            (⨆ j : J, Subgroup.zpowers
              (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
                (MilnorWolf.lcs Γ k)) (τ k j))).FiniteIndex) ∧
      (∀ k : ℕ, ∀ l : Fin (r (k + 1)), ∃ (i : Fin (r 0)) (j : Fin (r k)),
        ((τ (k + 1) l : Γ)) =
          (τ 0 i : Γ) * (τ k j : Γ) * (τ 0 i : Γ)⁻¹ * (τ k j : Γ)⁻¹) ∧
      Subgroup.closure (Set.range fun i : Fin (r 0) => ((τ 0 i : Γ))) = ⊤ := by
  classical
  -- Step 1: lift a finite generating family of `Γ/Γ₁`
  obtain ⟨S, hS, hSfin⟩ := Group.fg_iff.1 hfg
  obtain ⟨n, emb, hemb⟩ := hSfin.fin_embedding
  choose u hu using fun i : Fin n =>
    QuotientGroup.mk'_surjective ((MilnorWolf.lcs Γ 1).subgroupOf (MilnorWolf.lcs Γ 0)) (emb i)
  set t : Fin n → Γ := fun i => (u i : Γ) with ht
  set F := lcsCommutatorFamily (Γ := Γ) t with hF
  refine ⟨fun k => (F k).1, fun k => (F k).2, ?_⟩
  -- generation of `Γ/Γ₁` by the images of `τ 0`
  have hgen0 : (⨆ i : Fin (F 0).1, Subgroup.zpowers
      (QuotientGroup.mk' ((MilnorWolf.lcs Γ 1).subgroupOf (MilnorWolf.lcs Γ 0)) ((F 0).2 i)))
        = ⊤ := by
    show (⨆ i : Fin n, Subgroup.zpowers
      (QuotientGroup.mk' ((MilnorWolf.lcs Γ 1).subgroupOf (MilnorWolf.lcs Γ 0)) (u i))) = ⊤
    simp_rw [hu]
    rw [← closure_range_eq_iSup_zpowers']
    have : Set.range (fun i => emb i) = S := hemb
    rw [this, hS]
  -- Step 2: `τ 0` generates `Γ`
  have hX : Subgroup.closure (Set.range t) = ⊤ := by
    have h0 := (iSup_zpowers_mk_eq_top_iff (lcs_succ_le 0) _).1 hgen0
    have hsup : Subgroup.closure (Set.range t) ⊔ MilnorWolf.lcs Γ 1 = ⊤ :=
      eq_top_iff.2 h0
    have := sup_lcs_succ_eq_top _ hsup s
    rwa [hs, sup_bot_eq] at this
  -- Step 3/4: generation at every level, in `Γ`
  have hgenΓ : ∀ k, MilnorWolf.lcs Γ k ≤
      Subgroup.closure (Set.range fun i => ((F k).2 i : Γ)) ⊔ MilnorWolf.lcs Γ (k + 1) := by
    intro k
    induction k with
    | zero => exact (iSup_zpowers_mk_eq_top_iff (lcs_succ_le 0) _).1 hgen0
    | succ k ih =>
      refine (lcs_succ_le_closure_commutators k (Set.range t)
        (Set.range fun i => ((F k).2 i : Γ)) hX ?_ ih).trans (sup_le_sup_right ?_ _)
      · rintro _ ⟨i, rfl⟩
        exact ((F k).2 i).2
      · apply Subgroup.closure_mono
        rintro _ ⟨_, ⟨i, rfl⟩, _, ⟨j, rfl⟩, rfl⟩
        refine ⟨finProdFinEquiv (i, j), ?_⟩
        show ⁅t (finProdFinEquiv.symm (finProdFinEquiv (i, j))).1,
          ((F k).2 (finProdFinEquiv.symm (finProdFinEquiv (i, j))).2 : Γ)⁆ = _
        rw [Equiv.symm_apply_apply]
  refine ⟨fun k => ?_, fun k l => ?_, hX⟩
  · -- condition (i')
    have hgen := (iSup_zpowers_mk_eq_top_iff (lcs_succ_le k) (F k).2).2 (hgenΓ k)
    have hcomm : ∀ x y : ↥(MilnorWolf.lcs Γ k) ⧸ ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
        (MilnorWolf.lcs Γ k)), x * y = y * x := by
      intro x y
      induction x using QuotientGroup.induction_on with
      | H a =>
      induction y using QuotientGroup.induction_on with
      | H b =>
        rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, QuotientGroup.eq,
          Subgroup.mem_subgroupOf]
        have heq : (((a * b)⁻¹ * (b * a) : ↥(MilnorWolf.lcs Γ k)) : Γ) =
            ⁅(b : Γ)⁻¹, (a : Γ)⁻¹⁆ := by
          rw [commutatorElement_def]; push_cast; group
        rw [heq]
        exact commutatorElement_mem_lcs_succ _ ((MilnorWolf.lcs Γ k).inv_mem a.2)
    refine ⟨?_, hcomm, hgen, ?_⟩
    · rw [Group.fg_iff]
      exact ⟨_, by rw [closure_range_eq_iSup_zpowers', hgen], Set.finite_range _⟩
    · let _ : CommGroup (↥(MilnorWolf.lcs Γ k) ⧸ ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
          (MilnorWolf.lcs Γ k))) := { mul_comm := hcomm }
      exact exists_indep_finiteIndex_subfamily _ hgen
  · -- condition (ii)
    exact ⟨(finProdFinEquiv.symm l).1, (finProdFinEquiv.symm l).2, commutatorElement_def _ _⟩

end Lib
end Wolf

open Wolf

theorem solution
    {Γ : Type*} [Group Γ] (s : ℕ)
    (hs : MilnorWolf.lcs Γ (s + 1) = ⊥)
    (hfg : Group.FG (↥(MilnorWolf.lcs Γ 0) ⧸
      (MilnorWolf.lcs Γ 1).subgroupOf (MilnorWolf.lcs Γ 0))) :
    ∃ (r : ℕ → ℕ) (τ : ∀ k, Fin (r k) → ↥(MilnorWolf.lcs Γ k)),
      (∀ k : ℕ,
        letI Q := ↥(MilnorWolf.lcs Γ k) ⧸ ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
          (MilnorWolf.lcs Γ k))
        Group.FG Q ∧ (∀ x y : Q, x * y = y * x) ∧
          (⨆ i : Fin (r k), Subgroup.zpowers
            (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
              (MilnorWolf.lcs Γ k)) (τ k i))) = ⊤ ∧
          ∃ J : Finset (Fin (r k)),
            iSupIndep (fun j : J => Subgroup.zpowers
              (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
                (MilnorWolf.lcs Γ k)) (τ k j))) ∧
            (∀ j ∈ J, ¬ IsOfFinOrder
              (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
                (MilnorWolf.lcs Γ k)) (τ k j))) ∧
            (⨆ j : J, Subgroup.zpowers
              (QuotientGroup.mk' ((MilnorWolf.lcs Γ (k + 1)).subgroupOf
                (MilnorWolf.lcs Γ k)) (τ k j))).FiniteIndex) ∧
      (∀ k : ℕ, ∀ l : Fin (r (k + 1)), ∃ (i : Fin (r 0)) (j : Fin (r k)),
        ((τ (k + 1) l : Γ)) =
          (τ 0 i : Γ) * (τ k j : Γ) * (τ 0 i : Γ)⁻¹ * (τ k j : Γ)⁻¹) ∧
      Subgroup.closure (Set.range fun i : Fin (r 0) => ((τ 0 i : Γ))) = ⊤ :=
  Wolf.Lib.exists_commutator_generating_sets_with_free_finiteIndex_subfamily_lowerCentralSeries' s hs hfg
