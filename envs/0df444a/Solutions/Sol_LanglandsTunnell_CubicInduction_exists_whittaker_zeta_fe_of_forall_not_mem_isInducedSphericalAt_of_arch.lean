open IsDedekindDomain NumberField

section

private def archIdeleHom : (InfiniteAdeleRing ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ where
  toFun a :=
    { val := ((a : InfiniteAdeleRing ℚ), 1)
      inv := (((a⁻¹ : (InfiniteAdeleRing ℚ)ˣ) : InfiniteAdeleRing ℚ), 1)
      val_inv := Prod.ext (Units.mul_inv a) (one_mul 1)
      inv_val := Prod.ext (Units.inv_mul a) (one_mul 1) }
  map_one' := Units.ext rfl
  map_mul' _ _ := Units.ext (Prod.ext rfl (one_mul 1).symm)

private theorem archIdeleHom_apply_coe (a : (InfiniteAdeleRing ℚ)ˣ) :
    ((archIdeleHom a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ) = ((a : InfiniteAdeleRing ℚ), 1) :=
  rfl

private theorem continuous_archIdeleHom :
    Continuous (archIdeleHom : (InfiniteAdeleRing ℚ)ˣ → (AdeleRing (𝓞 ℚ) ℚ)ˣ) :=
  Units.continuous_iff.mpr
    ⟨Units.continuous_val.prodMk continuous_const, Units.continuous_coe_inv.prodMk continuous_const⟩

end

end LanglandsTunnell.CubicInduction

