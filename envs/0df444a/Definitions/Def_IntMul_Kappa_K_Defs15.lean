/-!
# KFG: index semantics of the pair pass, and the scaled role encoding

* `getD_pairL`: entry `p` of `pairL M L i j zs`.
* `Enc W L e zs y`: the Gaussian array `zs` (role-major, role length `L`) encodes the complex
  role streams `y w p` with per-role scales: `toC zs[w L + p] = 2^{e w} · y w p`.
* `enc_pairL`: the pair pass on the encoding, for any new scales `e'` and streams `y'` that
  satisfy the two pointwise identities.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFG

open IntMul RS AModel KIL KFD KFB Complex

/-! ## The scaled encoding -/

/-- `zs` encodes the role streams `y` with per-role scales `e`. -/
def Enc (W L : ℕ) (e : ℕ → ℕ) (zs : List GI) (y : ℕ → ℕ → ℂ) : Prop :=
  zs.length = W * L ∧ ∀ w < W, ∀ p < L, NLogN.KFB.toC (zs.getD (w * L + p) 0) = 2 ^ (e w) * y w p

end NLogN.KFG

end

