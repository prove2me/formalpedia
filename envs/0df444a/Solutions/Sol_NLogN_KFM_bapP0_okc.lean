  unfold HvdH.eWidth; exact Nat.le_add_left 1 _

end NLogN.Rsp

end

section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.KFM
open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.Rsp NLogN.AX
set_option maxHeartbeats 16000000
theorem solution (M : NLogN.MulSpec) (mm Φ B : ℕ) (hM : NLogN.MulBnd M mm Φ) (p s t α kb : ℕ) (hs : 0 < s)
    (hst : s ≤ t) (V : List (ℤ × ℤ))
    (hV : V.length = t) (s0 : NLogN.IState NLogN.HS) (RU : List NLogN.Item)
    (hU : s0.G NLogN.Rsp.CU = NLogN.gints V ++ RU) (hP : NLogN.Rsp.BParams s0 p s t α kb)
    (hVm : ∀ z ∈ V, NLogN.zsz z.1 ≤ mm ∧ NLogN.zsz z.2 ≤ mm) (hmm : 1 ≤ mm) (hmB : 2 * mm ≤ B)
    (hAcc : (2 * IntMul.HvdH.eWidth p α + 2) * 2 ^ (2 * mm) ≤ 2 ^ B) (hpB : p + 1 ≤ B)
    (hT : NLogN.zsz ((t + 1 : ℕ) : ℤ) ≤ B)
    (hSW : NLogN.zsz (((s + 1) * (2 * IntMul.HvdH.eWidth p α + 1) : ℕ) : ℤ) ≤ B)
    (hJ : NLogN.zsz (IntMul.HvdH.jIter p s t α : ℤ) ≤ B)
    (hWE : ∀ W ∈ NLogN.Rsp.eTab p s t α, ∀ y ∈ W, NLogN.zsz y ≤ mm)
    (hWD : ∀ W ∈ NLogN.Rsp.dTab p s t α, ∀ y ∈ W, NLogN.zsz y ≤ mm)
    (hv : ∀ j ≤ IntMul.HvdH.jIter p s t α, ∀ z ∈ NLogN.Rsp.vL p s t α (NLogN.Rsp.cselL s t V) j,
      NLogN.zsz z.1 ≤ mm ∧ NLogN.zsz z.2 ≤ mm)
    (hac : ∀ j ≤ IntMul.HvdH.jIter p s t α, ∀ z ∈ NLogN.Rsp.accL p s t α (NLogN.Rsp.cselL s t V) j,
      NLogN.zsz z.1 ≤ B ∧ NLogN.zsz z.2 ≤ B)
    (hJm : ∀ z ∈ NLogN.Rsp.japL p s t α (NLogN.Rsp.cselL s t V), NLogN.zsz z.1 ≤ mm ∧ NLogN.zsz z.2 ≤ mm) :
    NLogN.KFM.bapP0.ok M s0 ∧ NLogN.KFM.bapP0.cost M s0 ≤ NLogN.KFM.bap0Cost p s t α mm Φ B := by
  have he := NLogN.Rsp.eWidth_pos p α
  set E := IntMul.HvdH.eWidth p α with hE
  set L2 := NLogN.Rsp.cselL s t V with hL2
  set L3 := NLogN.Rsp.japL p s t α L2 with hL3
  have hAcc2 : 2 * 2 ^ (2 * mm) ≤ 2 ^ B :=
    le_trans (Nat.mul_le_mul_right _ (by omega)) hAcc
  have hS : NLogN.zsz ((s + 1 : ℕ) : ℤ) ≤ B := le_trans (NLogN.zsz_natCast_le' (by omega)) hT
  have zs : NLogN.zsz (s : ℤ) ≤ B := le_trans (NLogN.zsz_natCast_le' (by omega)) hT
  have hle : ∀ a : ℕ, a ≤ (s + 1) * (2 * E + 1) → NLogN.zsz (a : ℤ) ≤ B :=
    fun a ha => le_trans (NLogN.zsz_natCast_le' ha) hSW
  have hL2m : ∀ z ∈ L2, NLogN.zsz z.1 ≤ mm ∧ NLogN.zsz z.2 ≤ mm := fun z hz =>
    hVm z (NLogN.Rsp.mem_cselL s t hs hst V hV z hz)
  have o2 := NLogN.Rsp.cStage_okc M mm Φ B hM s t kb p α hs hst V hV s0 RU hU hP hVm hmm hAcc2 hmB hT
  have r2 := NLogN.Rsp.cStage_run s t kb p α hs hst V hV s0 RU hU hP
  have hP2 := hP.upd_CU (NLogN.gints L2 ++ RU)
  have o3 := NLogN.Rsp.JP_okc M mm Φ B hM p s t α (IntMul.HvdH.jIter p s t α) hs L2 (NLogN.Rsp.cselL_length s t _) _ RU _ _
    hP2.e (by simp) hP2.jl.choose_spec hP2.jn.choose_spec
    (fun z hz => ⟨le_trans (hL2m z hz).1 (by omega), le_trans (hL2m z hz).2 (by omega)⟩)
    hv hac hWE hAcc hmB (hle _ (by nlinarith)) hpB (hle _ (by nlinarith)) zs
    (hle _ (by nlinarith)) hJ (by omega)
  have r3 := NLogN.Rsp.JP_run p s t α (IntMul.HvdH.jIter p s t α) hs L2 (NLogN.Rsp.cselL_length s t _) _ RU _ _ hP2.e
    (by simp) hP2.jl.choose_spec hP2.jn.choose_spec
  rw [NLogN.Rsp.accL_japL p s t α hs L2 (NLogN.Rsp.cselL_length s t _)] at r3
  have hP3 := hP.upd_CU (NLogN.gints L3 ++ RU)
  have o4 := NLogN.Rsp.dStage_okc M mm Φ B hM s t kb p α hs L3 (NLogN.Rsp.japL_length p s t α _) _ RU (by simp) hP3
    hJm hWD hAcc2 hmB hS hpB
  have e2 : ((NLogN.Rsp.stageP NLogN.Rsp.Ac).ren NLogN.Rsp.σc).run s0 = s0.upd NLogN.Rsp.CU (NLogN.gints L2 ++ RU) := r2
  have e3 : NLogN.Rsp.JP.run (s0.upd NLogN.Rsp.CU (NLogN.gints L2 ++ RU)) = s0.upd NLogN.Rsp.CU (NLogN.gints L3 ++ RU) := by
    rw [r3, NLogN.IState.upd_upd_same]
  have k2 := o2.2.1; have k3 := o3.2; have k4 := o4.2.1
  clear_value L2 L3 E
  refine ⟨?_, ?_⟩
  · simp only [NLogN.KFM.bapP0, NLogN.RM.seqL, NLogN.RM.ok, NLogN.RM.run_seq, e2, e3]
    exact ⟨o2.1, o3.1, o4.1⟩
  · simp only [NLogN.KFM.bapP0, NLogN.RM.seqL, NLogN.RM.cost_seq', NLogN.RM.run_seq, e2, e3]
    unfold NLogN.KFM.bap0Cost
    rw [← hE]; rw [← hE] at k3
    omega
end
