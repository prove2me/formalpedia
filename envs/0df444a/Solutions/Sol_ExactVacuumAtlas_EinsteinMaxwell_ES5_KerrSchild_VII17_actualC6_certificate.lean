section R05Seg4
/-! # VII-03 (F2b): genuine second derivatives of the paper-gauge dictionary

For `PaperData I f m N w p a` and `r ∈ I`: `HasDerivAt` statements for `f'`, `m'`, `N'`, for the
derivative functions `(Afun f m)' = (m' f - m f')/f²` and `(Hfun m N)' = (N' m - N m')/m²`, and for
the two composite functions `m f'/f²` and `N m'/m` of the paper's Eqs. 24a/24b. Derivative
functions are identified with their closed forms only on the open neighbourhood `I` of `r`
(`EventuallyEq`), never from a value at a single point. Only regularity and `f, m, N ≠ 0` are used. -/

open scoped ContDiff Topology
open ExactVacuumAtlas.EinsteinMaxwell.ES5

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial

variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}

namespace PaperData

theorem d2f (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (deriv f) (deriv (deriv f) r) r :=
  hasDerivAt_of_cd hP.isOpen (cd_deriv hP.isOpen hP.cf) hr
theorem d2m (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (deriv m) (deriv (deriv m) r) r :=
  hasDerivAt_of_cd hP.isOpen (cd_deriv hP.isOpen hP.cm) hr
theorem d2N (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (deriv N) (deriv (deriv N) r) r :=
  hasDerivAt_of_cd hP.isOpen (cd_deriv hP.isOpen hP.cN) hr

end PaperData

/-- `(g²)' = 2 g g'`. -/
theorem hasDerivAt_sq' {g : ℝ → ℝ} {g' : ℝ} (h : HasDerivAt g g' r) :
    HasDerivAt (fun s => g s ^ 2) (2 * g r * g') r :=
  (h.pow 2).congr_deriv (by norm_num)

/-- On the open set `I`, the derivative function of `A = m/f` is `(m' f - m f')/f²`. -/
theorem deriv_Afun_eventuallyEq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    deriv (Afun f m) =ᶠ[𝓝 r] fun s => (deriv m s * f s - m s * deriv f s) / f s ^ 2 :=
  Filter.mem_of_superset (hP.isOpen.mem_nhds hr) fun _ hs => (hasDerivAt_Afun hP hs).deriv

/-- On the open set `I`, the derivative function of `H = N/m` is `(N' m - N m')/m²`. -/
theorem deriv_Hfun_eventuallyEq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    deriv (Hfun m N) =ᶠ[𝓝 r] fun s => (deriv N s * m s - N s * deriv m s) / m s ^ 2 :=
  Filter.mem_of_superset (hP.isOpen.mem_nhds hr) fun _ hs => (hasDerivAt_Hfun hP hs).deriv

/-- Genuine `A''` for `A = m/f`. -/
theorem hasDerivAt_deriv_Afun (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (deriv (Afun f m))
      (((deriv (deriv m) r * f r + deriv m r * deriv f r -
          (deriv m r * deriv f r + m r * deriv (deriv f) r)) * f r ^ 2 -
        (deriv m r * f r - m r * deriv f r) * (2 * f r * deriv f r)) / (f r ^ 2) ^ 2) r :=
  ((((hP.d2m hr).mul (hP.df hr)).sub ((hP.dm hr).mul (hP.d2f hr))).div
    (hasDerivAt_sq' (hP.df hr)) (pow_ne_zero 2 (hP.nf r hr))).congr_of_eventuallyEq
    (deriv_Afun_eventuallyEq hP hr)

/-- Genuine `H''` for `H = N/m`. -/
theorem hasDerivAt_deriv_Hfun (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (deriv (Hfun m N))
      (((deriv (deriv N) r * m r + deriv N r * deriv m r -
          (deriv N r * deriv m r + N r * deriv (deriv m) r)) * m r ^ 2 -
        (deriv N r * m r - N r * deriv m r) * (2 * m r * deriv m r)) / (m r ^ 2) ^ 2) r :=
  ((((hP.d2N hr).mul (hP.dm hr)).sub ((hP.dN hr).mul (hP.d2m hr))).div
    (hasDerivAt_sq' (hP.dm hr)) (pow_ne_zero 2 (hP.nm r hr))).congr_of_eventuallyEq
    (deriv_Hfun_eventuallyEq hP hr)

/-- The paper's `(m f'/f²)'` (Eq. 24a). -/
theorem hasDerivAt_mDf (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (fun s => m s / f s ^ 2 * deriv f s)
      ((deriv m r * f r ^ 2 - m r * (2 * f r * deriv f r)) / (f r ^ 2) ^ 2 * deriv f r +
        m r / f r ^ 2 * deriv (deriv f) r) r :=
  ((hP.dm hr).div (hasDerivAt_sq' (hP.df hr)) (pow_ne_zero 2 (hP.nf r hr))).mul (hP.d2f hr)

/-- The paper's `(N m'/m)'` (Eq. 24b). -/
theorem hasDerivAt_NDm (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (fun s => N s / m s * deriv m s)
      ((deriv N r * m r - N r * deriv m r) / m r ^ 2 * deriv m r +
        N r / m r * deriv (deriv m) r) r :=
  ((hP.dN hr).div (hP.dm hr) (hP.nm r hr)).mul (hP.d2m hr)

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
end R05Seg4

