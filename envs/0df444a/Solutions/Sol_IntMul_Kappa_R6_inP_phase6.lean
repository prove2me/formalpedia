theorem sCmp_eq {n D : ℕ} (hn : n0 ≤ n) (hD : dP n = D + 1) (hlt : ∀ i, sBD n D i < tBD n D i) :
    sCmp n = ∏ i, sBD n D i := by
  have hLb := (setup_facts hn).2.2.2.2.2.1
  have e1 : ∏ j ∈ Finset.range (dP n), srcN n j = ∏ i, sBD n D i := by
    rw [hD, ← Fin.prod_univ_eq_prod_range]; rfl
  have h2 : ∏ i, sBD n D i ≤ ∏ i, tBD n D i :=
    Finset.prod_le_prod (fun i _ => Nat.zero_le _) (fun i _ => (hlt i).le)
  rw [KFQ.prod_tBD hn hD, TP] at h2
  have h3 : 2 ^ LP n < 2 ^ bP n := Nat.pow_lt_pow_right (by norm_num) hLb
  unfold sCmp; rw [e1]; exact Nat.mod_eq_of_lt (by omega)

/-! ## The digit cut -/

theorem withD_runsX {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {src dst W : Fin HS}
    (hsd : src ≠ dst) (hd0 : dst ≠ 0) (hdW : dst ≠ W) {p : IStmt HS P} {t : IState HS} {a : ℤ}
    (hs : Hold t src a) {X LW : List Item} {c : ℕ}
    (hp : IRuns I iprog p (t.upd dst (.int a :: t.G dst))
      (((t.upd dst (.int a :: t.G dst)).upd W LW).upd 0 X) c) :
    IRuns I iprog (withD src dst p) t ((t.upd W LW).upd 0 X) (c + cW a) := by
  obtain ⟨L, hL⟩ := hs
  have r1 := IRuns.dup (I := I) (iprog := iprog) hsd hL
  have r3 := IRuns.drop (I := I) (iprog := iprog)
    (s := ((t.upd dst (.int a :: t.G dst)).upd W LW).upd 0 X) (i := dst) (a := a) (L := t.G dst)
    (by simp [IState.upd_G, hd0, hdW])
  refine (r1.seq (hp.seq r3)).mono' ?_ (by unfold cW; omega)
  refine IState.ext' (fun j => ?_) (by simp) (by simp)
  simp only [IState.upd_G]
  split_ifs <;> simp_all

end

end NLogN.KFM

