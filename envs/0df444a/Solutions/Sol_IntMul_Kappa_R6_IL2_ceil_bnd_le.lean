    have a1 : (f : ℝ) ^ τ ≤ F := Real.rpow_le_rpow (by positivity) (by linarith) hτ0
    have a2 : (K : ℝ) ^ τ ≤ K := by
      calc (K : ℝ) ^ τ ≤ (K : ℝ) ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hK' hτ1
