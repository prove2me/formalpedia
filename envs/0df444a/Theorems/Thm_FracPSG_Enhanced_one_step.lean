-- title:
--   Proof of Theorem 6.1 — one-step decrease of the ratio (display after (32))
-- statement:
--   Let $(x_n)$ be generated by Algorithm 2 under Assumptions 1 and 2′, with Step 1 parameters as in the algorithm and bounded sublevel set $S_0$. Then for all $n\in\mathbb N$ the iterate $x_{n+1}$ lies in $S\cap\operatorname{dom}f$ and
--   $$\frac{f(x_{n+1})}{g(x_{n+1})}+\Big(\frac{\delta(1-\sqrt\beta\zeta)}{2M}-\frac{\bar\mu}{2\sqrt{mM}}\Big)\|x_{n+1}-x_n\|^2\ \le\ \frac{f(x_n)}{g(x_n)}+\Big(\frac{\ell\kappa_n^2}{2m}+\frac{\bar\mu}{2\sqrt{mM}}\Big)\|x_n-x_{n-1}\|^2 ,$$
--   with $x_{-1}=x_0$.
--
--   This is the sufficient-decrease estimate behind the monotonicity of the Lyapunov sequence (27).
--
--   **Formalization Note** The ratios are real numbers `(f x).toReal / g x`; the conclusion $x_{n+1}\in S\cap\operatorname{dom}f$ is stated explicitly so that the ratio on the left is the true one.
-- source:
--   Boţ, Dao, Li, Extrapolated Proximal Subgradient Algorithms for Nonconvex and Nonsmooth Fractional Programs, arXiv:2003.04124v2, p. 23, display after (32) (proof of Theorem 6.1(i)&(ii))

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_FracPSG_Enhanced_Basic
import Definitions.Def_FracPSG_Enhanced_Algorithm2

open Filter Topology
open scoped InnerProductSpace

namespace FracPSG.Enhanced

open NonconvexSplitting.Shared

/-- One-step decrease (Boţ–Dao–Li, arXiv:2003.04124v2, p. 23, display after (32)): for a run of
Algorithm 2 under the hypotheses of Theorem 6.1, for all `n`, `xₙ₊₁ ∈ S ∩ dom f` and
`f(xₙ₊₁)/g(xₙ₊₁) + (δ(1 − √βζ)/(2M) − μ̄/(2√(mM)))‖xₙ₊₁ − xₙ‖²
  ≤ f(xₙ)/g(xₙ) + (ℓκₙ²/(2m) + μ̄/(2√(mM)))‖xₙ − xₙ₋₁‖²`. -/
theorem one_step
    {N p : ℕ} [NeZero p] {S : Set (EuclideanSpace ℝ (Fin N))}
    {fs : EuclideanSpace ℝ (Fin N) → ℝ} {fn : EuclideanSpace ℝ (Fin N) → EReal}
    {gi : Fin p → EuclideanSpace ℝ (Fin N) → ℝ} {ℓ β δ ζ ε μbar κbar m M : ℝ}
    {x : ℕ → EuclideanSpace ℝ (Fin N)} {w : ℕ → Fin p → EuclideanSpace ℝ (Fin N)}
    {ihat : ℕ → Fin p} {τ κ μ : ℕ → ℝ}
    (hS : IsClosed S) (hSconv : Convex ℝ S)
    (hA1 : FracPSG.Subseq.Assumption1 S fs fn ℓ) (hA2 : Assumption2' S (FracPSG.Subseq.objF fs fn) gi β m M)
    (hpar : Step1Params ℓ β δ ε ζ μbar κbar m M)
    (hrun : IsEnhancedRun S fs fn gi ℓ β δ ζ ε μbar κbar m M x w ihat τ κ μ)
    (hS0 : Bornology.IsBounded (FracPSG.Subseq.S0 S (FracPSG.Subseq.objF fs fn) (maxFn gi) (x 0))) :
    ∀ n, x (n + 1) ∈ S ∧ FracPSG.Subseq.objF fs fn (x (n + 1)) ≠ ⊤ ∧
      FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) (x (n + 1))
          + (δ * (1 - Real.sqrt β * ζ) / (2 * M) - μbar / (2 * Real.sqrt (m * M)))
            * ‖x (n + 1) - x n‖ ^ 2 ≤
        FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) (x n)
          + (ℓ * κ n ^ 2 / (2 * m) + μbar / (2 * Real.sqrt (m * M))) * ‖x n - FracPSG.Subseq.xPrev x n‖ ^ 2 := by sorry

end FracPSG.Enhanced
