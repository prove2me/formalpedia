open PaddedDescent PaddedDescent.F PaddedDescent.F.Table
open Groundwork Groundwork.Prog Finset
namespace PaddedDescent.F.Table
theorem _root_.solution {ℓ : ℕ} : ∀ (L : List (List Bool)) (j : ℕ), (∀ w ∈ L, w.length = ℓ) → j < L.length →
    block ℓ j L.flatten = L.getD j []
  | [], j, _, hj => by simp at hj
  | a :: L, 0, h, _ => by
    have ha : a.length = ℓ := h a List.mem_cons_self
    simp [block, ha]
  | a :: L, j + 1, h, hj => by
    have ha : a.length = ℓ := h a List.mem_cons_self
    have ih := solution L j (fun w hw => h w (List.mem_cons_of_mem _ hw)) (by simpa using hj)
    have e : (j + 1) * ℓ = a.length + j * ℓ := by rw [ha]; ring
    unfold block at ih ⊢
    rw [List.flatten_cons, e, ← List.drop_drop, List.drop_left, ih]
    simp
end PaddedDescent.F.Table
