variable {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
  (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (n : ℕ)
  (U : (L.schemeKer n).Opens) (hU : IsClosed (U : Set ↥(L.schemeKer n)))

theorem factorsThrough_iff {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f) :
    CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P ↔
      ∃ x : T ⟶ L.schemeKer n, x ≫ KerOps.ι L n = P.1 ∧ Set.range x.base ⊆ (U : Set ↥(L.schemeKer n)) := by
  constructor
  · rintro ⟨P₀, hP₀⟩
    refine ⟨P₀ ≫ U.ι, by rw [Category.assoc, hP₀], ?_⟩
    rintro _ ⟨τ, rfl⟩
    rw [← Scheme.Opens.range_ι U]
    exact ⟨P₀.base τ, rfl⟩
  · rintro ⟨x, hx, hr⟩
    refine ⟨IsOpenImmersion.lift U.ι x (by rw [Scheme.Opens.range_ι]; exact hr), ?_⟩
    rw [← Category.assoc, IsOpenImmersion.lift_fac, hx]

theorem factorsThrough_iff_of_lift {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f)
    (x : T ⟶ L.schemeKer n) (hx : x ≫ KerOps.ι L n = P.1) :
    CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P ↔
      Set.range x.base ⊆ (U : Set ↥(L.schemeKer n)) := by
  rw [factorsThrough_iff L n U P]
  constructor
  · rintro ⟨y, hy, hr⟩
    obtain rfl : x = y := KerOps.lift_unique L n x y (hx.trans hy.symm)
    exact hr
  · exact fun hr => ⟨x, hx, hr⟩

theorem sub_of_loci [IsFinite (L.schemeKerStr n)] [Etale (L.schemeKerStr n)]
    (h1 : ∀ t : ↥(Spec (CommRingCat.of R)), t ∈ Loci.locOne L n (U : Set ↥(L.schemeKer n)))
    (h2 : ∀ t : ↥(Spec (CommRingCat.of R)), t ∈ Loci.locInv L hc n (U : Set ↥(L.schemeKer n)))
    (h3 : ∀ t : ↥(Spec (CommRingCat.of R)), t ∈ Loci.locMul L hc n (U : Set ↥(L.schemeKer n))) :
    (∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
      CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P →
      CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) Q →
        CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) (L.mul t P Q) ∧
        CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) (L.inv t P)) ∧
    (∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)),
      CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) (L.one t)) := by
  refine ⟨?_, ?_⟩
  · intro T t P Q hP hQ
    obtain ⟨x, hx, hxr⟩ := (factorsThrough_iff L n U P).1 hP
    obtain ⟨y, hy, hyr⟩ := (factorsThrough_iff L n U Q).1 hQ
    have hxs := KerOps.comp_str_of_comp_ι L n P x hx
    have hys := KerOps.comp_str_of_comp_ι L n Q y hy
    have hPe : P = KerOps.toPt L n x hxs := Subtype.ext hx.symm
    have hQe : Q = KerOps.toPt L n y hys := Subtype.ext hy.symm
    subst hPe hQe
    constructor
    · obtain ⟨z, hzx, hzy⟩ : ∃ z : T ⟶ pullback (L.schemeKerStr n) (L.schemeKerStr n),
          z ≫ pullback.fst _ _ = x ∧ z ≫ pullback.snd _ _ = y :=
        ⟨pullback.lift x y (hxs.trans hys.symm), pullback.lift_fst _ _ _, pullback.lift_snd _ _ _⟩
      rw [factorsThrough_iff_of_lift L n U _ (z ≫ KerOps.mulK L n hc)
        (KerOps.comp_mulK_ι L n hc z x y hzx hzy hxs hys)]
      refine Loci.range_comp_subset_of_locus (pullback.fst _ _ ≫ L.schemeKerStr n) (KerOps.mulK L n hc)
        _ _ h3 z ?_
      rintro _ ⟨τ, rfl⟩
      refine ⟨?_, ?_⟩
      · show (z ≫ pullback.fst _ _).base τ ∈ (U : Set ↥(L.schemeKer n))
        rw [hzx]; exact hxr ⟨τ, rfl⟩
      · show (z ≫ pullback.snd _ _).base τ ∈ (U : Set ↥(L.schemeKer n))
        rw [hzy]; exact hyr ⟨τ, rfl⟩
    · rw [factorsThrough_iff_of_lift L n U _ (x ≫ KerOps.invK L n hc) (KerOps.comp_invK_ι L n hc x hxs)]
      exact Loci.range_comp_subset_of_locus (L.schemeKerStr n) (KerOps.invK L n hc) _ _ h2 x hxr
  · intro T t
    rw [factorsThrough_iff_of_lift L n U _ (t ≫ KerOps.oneK L n) (KerOps.comp_oneK_ι L n t)]
    rintro _ ⟨τ, rfl⟩
    exact h1 (t.base τ)

theorem loci_of_sub [IsFinite (L.schemeKerStr n)] [Etale (L.schemeKerStr n)]
    (hsub : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
      CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) P →
      CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) Q →
        CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) (L.mul t P Q) ∧
        CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) (L.inv t P))
    (hone : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)),
      CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n) (L.one t)) :
    (∀ t : ↥(Spec (CommRingCat.of R)), t ∈ Loci.locOne L n (U : Set ↥(L.schemeKer n))) ∧
    (∀ t : ↥(Spec (CommRingCat.of R)), t ∈ Loci.locInv L hc n (U : Set ↥(L.schemeKer n))) ∧
    (∀ t : ↥(Spec (CommRingCat.of R)), t ∈ Loci.locMul L hc n (U : Set ↥(L.schemeKer n))) := by

  have hPU : CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι L n)
      (KerOps.toPt L n U.ι (rfl : U.ι ≫ L.schemeKerStr n = U.ι ≫ L.schemeKerStr n)) := by
    rw [factorsThrough_iff_of_lift L n U _ U.ι rfl, Scheme.Opens.range_ι]
  refine ⟨?_, ?_, ?_⟩
  ·
    intro t
    have h := (factorsThrough_iff_of_lift L n U (L.one (𝟙 _)) (KerOps.oneK L n) (KerOps.oneK_ι L n)).1
      (hone (𝟙 _))
    show (KerOps.oneK L n).base t ∈ (U : Set ↥(L.schemeKer n))
    exact h ⟨t, rfl⟩
  ·
    intro t
    refine Loci.locus_of_range_comp_subset (L.schemeKerStr n) (KerOps.invK L n hc) _ _ U.ι
      (Scheme.Opens.range_ι U) ?_ t
    rw [← factorsThrough_iff_of_lift L n U _ (U.ι ≫ KerOps.invK L n hc) (KerOps.comp_invK_ι L n hc U.ι rfl)]
    exact (hsub _ _ _ hPU hPU).2
  ·
    intro t
    obtain ⟨W, hW⟩ : ∃ W : (pullback (L.schemeKerStr n) (L.schemeKerStr n)).Opens,
        (W : Set ↥(pullback (L.schemeKerStr n) (L.schemeKerStr n))) =
          (pullback.fst (L.schemeKerStr n) (L.schemeKerStr n)).base ⁻¹' (U : Set ↥(L.schemeKer n)) ∩
          (pullback.snd (L.schemeKerStr n) (L.schemeKerStr n)).base ⁻¹' (U : Set ↥(L.schemeKer n)) :=
      ⟨pullback.fst (L.schemeKerStr n) (L.schemeKerStr n) ⁻¹ᵁ U ⊓
        pullback.snd (L.schemeKerStr n) (L.schemeKerStr n) ⁻¹ᵁ U, rfl⟩
    have hi : Set.range W.ι.base = _ := (Scheme.Opens.range_ι W).trans hW
