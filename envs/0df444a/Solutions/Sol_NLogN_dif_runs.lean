        rw [e4, NLogN.ints_append, List.append_assoc]
        simp only [hs4, hs1]
        clear * - hL hDE
        ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
      · have := NLogN.zsz_natCast_le_self h
