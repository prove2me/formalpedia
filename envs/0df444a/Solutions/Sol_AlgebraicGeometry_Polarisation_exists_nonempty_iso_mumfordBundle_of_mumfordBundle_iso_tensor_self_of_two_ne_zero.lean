namespace Halving
section Monoidal
variable {C : Type*} [Category C] [MonoidalCategory C] [SymmetricCategory C]

def swapMiddle (X₁ X₂ Y₁ Y₂ : C) : (X₁ ⊗ X₂) ⊗ (Y₁ ⊗ Y₂) ≅ (X₁ ⊗ Y₁) ⊗ (X₂ ⊗ Y₂) :=
  calc (X₁ ⊗ X₂) ⊗ (Y₁ ⊗ Y₂) ≅ X₁ ⊗ (X₂ ⊗ (Y₁ ⊗ Y₂)) := α_ _ _ _
    _ ≅ X₁ ⊗ ((X₂ ⊗ Y₁) ⊗ Y₂) := whiskerLeftIso _ (α_ _ _ _).symm
    _ ≅ X₁ ⊗ ((Y₁ ⊗ X₂) ⊗ Y₂) := whiskerLeftIso _ (whiskerRightIso (β_ _ _) _)
    _ ≅ X₁ ⊗ (Y₁ ⊗ (X₂ ⊗ Y₂)) := whiskerLeftIso _ (α_ _ _ _)
    _ ≅ (X₁ ⊗ Y₁) ⊗ (X₂ ⊗ Y₂) := (α_ _ _ _).symm

def isoOfInv {X P Q : C} (eP : X ⊗ P ≅ 𝟙_ C) (eQ : X ⊗ Q ≅ 𝟙_ C) : P ≅ Q :=
  calc P ≅ P ⊗ 𝟙_ C := (ρ_ _).symm
    _ ≅ P ⊗ (X ⊗ Q) := whiskerLeftIso _ eQ.symm
    _ ≅ (P ⊗ X) ⊗ Q := (α_ _ _ _).symm
    _ ≅ (X ⊗ P) ⊗ Q := whiskerRightIso (β_ _ _) _
    _ ≅ 𝟙_ C ⊗ Q := whiskerRightIso eP _
    _ ≅ Q := λ_ _

def tensorInvIso {Am Bm A' B' : C} (eA : Am ⊗ A' ≅ 𝟙_ C) (eB : Bm ⊗ B' ≅ 𝟙_ C) : (Am ⊗ Bm) ⊗ (A' ⊗ B') ≅ 𝟙_ C :=
  swapMiddle Am Bm A' B' ≪≫ (eA ⊗ᵢ eB) ≪≫ λ_ _

def isoOfTensorDual {X Y D : C} (e : X ⊗ D ≅ 𝟙_ C) (eY : Y ⊗ D ≅ 𝟙_ C) : X ≅ Y :=
  isoOfInv ((β_ _ _) ≪≫ e) ((β_ _ _) ≪≫ eY)

end Monoidal

section Rigid
variable {X Y : Scheme.{0}}

theorem rigid_tensor {P Q : Y.Modules} (g : X ⟶ Y)
    (hP : Nonempty ((Scheme.Modules.pullback g).obj P ≅ 𝟙_ _)) (hQ : Nonempty ((Scheme.Modules.pullback g).obj Q ≅ 𝟙_ _)) :
    Nonempty ((Scheme.Modules.pullback g).obj (P ⊗ Q) ≅ 𝟙_ _) := by
  obtain ⟨eP⟩ := hP; obtain ⟨eQ⟩ := hQ
  exact ⟨Scheme.Modules.pullbackTensorObjIso g P Q ≪≫ (eP ⊗ᵢ eQ) ≪≫ λ_ _⟩

theorem rigid_dual {P : Y.Modules} (hPinv : Scheme.Modules.IsInvertible P) (g : X ⟶ Y)
    (hP : Nonempty ((Scheme.Modules.pullback g).obj P ≅ 𝟙_ _)) :
    Nonempty ((Scheme.Modules.pullback g).obj (Scheme.Modules.dual P) ≅ 𝟙_ _) := by
  obtain ⟨eP⟩ := hP
  obtain ⟨e1⟩ := hPinv.pullback_dual_monoidalV2 g
  obtain ⟨-, ⟨e2⟩⟩ := (hPinv.pullback g).dual_monoidalV2

  exact ⟨e1 ≪≫ (λ_ _).symm ≪≫ whiskerRightIso eP.symm _ ≪≫ e2⟩

end Rigid

theorem nonempty_mumfordBundle_congr {k : Type} [Field k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) {M M' : A.Modules} (hM : Scheme.Modules.IsInvertible M) (hM' : Scheme.Modules.IsInvertible M')
    (e : M ≅ M') : Nonempty (mumfordBundle f L M ≅ mumfordBundle f L M') := by
  obtain ⟨-, ⟨eD⟩⟩ := hM.dual_monoidalV2
  obtain ⟨-, ⟨eD'⟩⟩ := hM'.dual_monoidalV2
  have eDD : Scheme.Modules.dual M ≅ Scheme.Modules.dual M' := isoOfInv eD (whiskerRightIso e _ ≪≫ eD')
  exact ⟨((Scheme.Modules.pullback _).mapIso e) ⊗ᵢ
    (((Scheme.Modules.pullback _).mapIso eDD) ⊗ᵢ ((Scheme.Modules.pullback _).mapIso eDD))⟩

end Halving

open Halving in
theorem solution
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle k f)
    (g : ℕ) (hdim : ∀ s : ↥(Spec (CommRingCat.of k)), topologicalKrullDim ↥(f.base ⁻¹' {s}) = g)
    (h2 : (2 : k) ≠ 0)
    (𝓟 : (pullback f f).Modules) (h𝓟 : Scheme.Modules.IsInvertible 𝓟)
    (h₁ : Nonempty ((Scheme.Modules.pullback (sliceAt f (RelativeGroupLaw.AlgPoints.toPoint (0 : L.AlgPoints hc k)))).obj 𝓟 ≅ 𝟙_ _))
    (h₂ : Nonempty ((Scheme.Modules.pullback (sliceAt f (RelativeGroupLaw.AlgPoints.toPoint (0 : L.AlgPoints hc k)))).obj
        ((Scheme.Modules.pullback (pullbackSymmetry f f).hom).obj 𝓟) ≅ 𝟙_ _))
    (h₃ : Nonempty ((Scheme.Modules.pullback (pullbackSymmetry f f).hom).obj 𝓟 ≅ 𝓟))
    (𝓛₀ : A.Modules) (h𝓛₀ : Scheme.Modules.IsInvertible 𝓛₀) (hΛ : Nonempty (mumfordBundle f L 𝓛₀ ≅ 𝓟 ⊗ 𝓟)) :
    ∃ 𝓜 : A.Modules, Scheme.Modules.IsInvertible 𝓜 ∧ Nonempty (𝓟 ≅ mumfordBundle f L 𝓜) := by
  classical
  let s0 := sliceAt f (RelativeGroupLaw.AlgPoints.toPoint (0 : L.AlgPoints hc k))
  let S := Scheme.Modules.pullback s0
  let σ := (pullbackSymmetry f f).hom
  let Sσ := Scheme.Modules.pullback σ

  have hK2 : ∀ Q : L.AlgPoints hc k, 2 • Q = 0 →
      Nonempty ((Scheme.Modules.pullback (translation f L (RelativeGroupLaw.AlgPoints.toPoint Q))).obj 𝓛₀ ≅ 𝓛₀) :=
    fun Q hQ => AlgebraicGeometry.Polarisation.nonempty_pullback_translation_iso_of_mumfordBundle_iso_tensor_self
      k f L hc hA g hdim 𝓟 h𝓟 h₁ h₂ 𝓛₀ h𝓛₀ hΛ Q hQ

  obtain ⟨K, hKinj, hKpt⟩ := AlgebraicGeometry.Polarisation.exists_subgroup_thetaGroup_tensor_self_injOn_pt_image_eq_two_torsion k f L hc hA g hdim 𝓛₀ h𝓛₀ hK2
  have h𝓛₀₀ : Scheme.Modules.IsInvertible (𝓛₀ ⊗ 𝓛₀) := h𝓛₀.tensor_monoidalV2 h𝓛₀
  obtain ⟨𝓜, h𝓜, ⟨e𝓜⟩⟩ := AlgebraicGeometry.Polarisation.exists_pullback_schemeNsmul_two_iso_of_levelSubgroup
    k f L hc hA g hdim h2 (𝓛₀ ⊗ 𝓛₀) h𝓛₀₀ K hKinj hKpt
  let 𝓜2 : A.Modules := 𝓜.tensorPow 2
  have h𝓜2 : Scheme.Modules.IsInvertible 𝓜2 := h𝓜.tensorPow_monoidalV2 2
  have hΛinv : ∀ {N : A.Modules}, Scheme.Modules.IsInvertible N → Scheme.Modules.IsInvertible (mumfordBundle f L N) :=
    fun hN => (hN.pullback _).tensor_monoidalV2 ((hN.dual_monoidalV2.1.pullback _).tensor_monoidalV2 (hN.dual_monoidalV2.1.pullback _))

  obtain ⟨eD⟩ := AlgebraicGeometry.Polarisation.nonempty_mumfordBundle_pullback_schemeNsmul_two_iso_tensor k f L hc hA g hdim 𝓜 h𝓜
  obtain ⟨eC⟩ := nonempty_mumfordBundle_congr f L (h𝓜.pullback _) h𝓛₀₀ e𝓜
  obtain ⟨eT⟩ := AlgebraicGeometry.Polarisation.nonempty_mumfordBundle_tensor_iso_tensor k f L 𝓛₀ 𝓛₀ h𝓛₀ h𝓛₀
  obtain ⟨eΛ⟩ := hΛ
  have e45 : mumfordBundle f L 𝓜2 ⊗ mumfordBundle f L 𝓜2 ≅ (𝓟 ⊗ 𝓟) ⊗ (𝓟 ⊗ 𝓟) :=
    eD.symm ≪≫ eC ≪≫ eT ≪≫ (eΛ ⊗ᵢ eΛ)

  have hPP : Scheme.Modules.IsInvertible (𝓟 ⊗ 𝓟) := h𝓟.tensor_monoidalV2 h𝓟
  obtain ⟨hPPD, ⟨ePP⟩⟩ := hPP.dual_monoidalV2
  let 𝓠₁ : (pullback f f).Modules := mumfordBundle f L 𝓜2 ⊗ Scheme.Modules.dual (𝓟 ⊗ 𝓟)
  have h𝓠₁ : Scheme.Modules.IsInvertible 𝓠₁ := (hΛinv h𝓜2).tensor_monoidalV2 hPPD
  have hsq₁ : Nonempty (𝓠₁ ⊗ 𝓠₁ ≅ 𝟙_ _) := ⟨swapMiddle _ _ _ _ ≪≫ whiskerRightIso e45 _ ≪≫ tensorInvIso ePP ePP⟩
  obtain ⟨r1, r2⟩ := AlgebraicGeometry.Polarisation.nonempty_sliceAt_zero_mumfordBundle_iso_unit_and_swap k f L hc 𝓜2 h𝓜2

  have p1 : Nonempty (S.obj (Scheme.Modules.dual (𝓟 ⊗ 𝓟)) ≅ 𝟙_ _) := rigid_dual hPP s0 (rigid_tensor s0 h₁ h₁)
  have p2 : Nonempty (S.obj (Sσ.obj (Scheme.Modules.dual (𝓟 ⊗ 𝓟))) ≅ 𝟙_ _) := by
    obtain ⟨eσD⟩ := hPP.pullback_dual_monoidalV2 σ
    have q : Nonempty (S.obj (Scheme.Modules.dual (Sσ.obj (𝓟 ⊗ 𝓟))) ≅ 𝟙_ _) :=
      rigid_dual (hPP.pullback σ) s0 (by
        obtain ⟨e⟩ := rigid_tensor s0 h₂ h₂
        exact ⟨S.mapIso (Scheme.Modules.pullbackTensorObjIso σ 𝓟 𝓟) ≪≫ e⟩)
    obtain ⟨e⟩ := q
    exact ⟨S.mapIso eσD ≪≫ e⟩
  have q1 : Nonempty (S.obj 𝓠₁ ≅ 𝟙_ _) := rigid_tensor s0 r1 p1
  have q2 : Nonempty (S.obj (Sσ.obj 𝓠₁) ≅ 𝟙_ _) := by
    obtain ⟨e⟩ := rigid_tensor s0 r2 p2
    exact ⟨S.mapIso (Scheme.Modules.pullbackTensorObjIso σ _ _) ≪≫ e⟩
  obtain ⟨e𝓠₁⟩ := AlgebraicGeometry.Polarisation.nonempty_iso_unit_of_tensor_self_iso_unit_of_birigidified
    k f L hc hA g hdim 𝓠₁ h𝓠₁ q1 q2 hsq₁

  have e7 : mumfordBundle f L 𝓜2 ≅ 𝓟 ⊗ 𝓟 := isoOfTensorDual e𝓠₁ ePP

  obtain ⟨hPD, ⟨eP⟩⟩ := h𝓟.dual_monoidalV2
  let 𝓠₂ : (pullback f f).Modules := mumfordBundle f L 𝓜 ⊗ Scheme.Modules.dual 𝓟
  have h𝓠₂ : Scheme.Modules.IsInvertible 𝓠₂ := (hΛinv h𝓜).tensor_monoidalV2 hPD
  obtain ⟨eT2⟩ := AlgebraicGeometry.Polarisation.nonempty_mumfordBundle_tensor_iso_tensor k f L 𝓜 𝓜 h𝓜 h𝓜

  have e22 : 𝓜2 ≅ 𝓜 ⊗ 𝓜 := whiskerRightIso (λ_ 𝓜) 𝓜
  obtain ⟨eC2⟩ := nonempty_mumfordBundle_congr f L h𝓜2 (h𝓜.tensor_monoidalV2 h𝓜) e22
  have hsq₂ : Nonempty (𝓠₂ ⊗ 𝓠₂ ≅ 𝟙_ _) :=
    ⟨swapMiddle _ _ _ _ ≪≫ whiskerRightIso (eT2.symm ≪≫ eC2.symm ≪≫ e7) _ ≪≫ tensorInvIso eP eP⟩
  obtain ⟨r1', r2'⟩ := AlgebraicGeometry.Polarisation.nonempty_sliceAt_zero_mumfordBundle_iso_unit_and_swap k f L hc 𝓜 h𝓜
  have p1' : Nonempty (S.obj (Scheme.Modules.dual 𝓟) ≅ 𝟙_ _) := rigid_dual h𝓟 s0 h₁
  have p2' : Nonempty (S.obj (Sσ.obj (Scheme.Modules.dual 𝓟)) ≅ 𝟙_ _) := by
    obtain ⟨eσD⟩ := h𝓟.pullback_dual_monoidalV2 σ
    obtain ⟨e⟩ := rigid_dual (h𝓟.pullback σ) s0 h₂
    exact ⟨S.mapIso eσD ≪≫ e⟩
  have q1' : Nonempty (S.obj 𝓠₂ ≅ 𝟙_ _) := rigid_tensor s0 r1' p1'
  have q2' : Nonempty (S.obj (Sσ.obj 𝓠₂) ≅ 𝟙_ _) := by
    obtain ⟨e⟩ := rigid_tensor s0 r2' p2'
    exact ⟨S.mapIso (Scheme.Modules.pullbackTensorObjIso σ _ _) ≪≫ e⟩
  obtain ⟨e𝓠₂⟩ := AlgebraicGeometry.Polarisation.nonempty_iso_unit_of_tensor_self_iso_unit_of_birigidified
    k f L hc hA g hdim 𝓠₂ h𝓠₂ q1' q2' hsq₂
  have e8 : mumfordBundle f L 𝓜 ≅ 𝓟 := isoOfTensorDual e𝓠₂ eP
  exact ⟨𝓜, h𝓜, ⟨e8.symm⟩⟩

end
