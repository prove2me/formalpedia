section DinhSharpnessBundleModule4
/-!
Dinh et al., arXiv:1703.04933v2, Section 4.2, Theorem 4,
PDF pp. 5--6: arbitrary Hessian sharpness at equivalent critical local minima.
-/

namespace DinhSharpness

theorem arbitrarilySharpEquivalentMinima :
    ∀ (d h : ℕ), 0 < d → 0 < h →
      ∀ (ℓ : (Input d → ℝ) → ℝ), Continuous (parameterLoss (h := h) ℓ) →
        ∀ (θ : Parameter d h), TwiceDifferentiableAt (parameterLoss ℓ) θ →
          IsLocalMin (parameterLoss ℓ) θ → fderiv ℝ (parameterLoss ℓ) θ = 0 →
            hessian (parameterLoss ℓ) θ ≠ 0 →
              ∀ M : ℝ, 0 < M → ∃ α : ℝ, 0 < α ∧
                prediction (scale α θ) = prediction θ ∧
                parameterLoss ℓ (scale α θ) = parameterLoss ℓ θ ∧
                IsLocalMin (parameterLoss ℓ) (scale α θ) ∧
                TwiceDifferentiableAt (parameterLoss ℓ) (scale α θ) ∧
                fderiv ℝ (parameterLoss ℓ) (scale α θ) = 0 ∧
                M ≤ ‖hessian (parameterLoss ℓ) (scale α θ)‖ := by
  intro d h _ _ ℓ _ θ hθ hmin hcrit hne M hM
  obtain ⟨i, hi⟩ := hessian_exists_positive_diagonal hθ hmin hne
  obtain ⟨α, ha, hlarge⟩ := exists_rescaling_large_norm
    (hessian (parameterLoss ℓ) θ)
    (fun α ↦ hessian (parameterLoss ℓ) (scale α θ))
    (fun α ha u v ↦ hessian_scale ℓ θ ha u v) i hi M hM
  refine ⟨α, ha, prediction_scale θ ha, loss_scale ℓ θ ha,
    (localMin_scale_iff ℓ θ ha).2 hmin, hθ.scale ha, ?_, hlarge⟩
  ext u
  rw [fderiv_scale ℓ θ ha u, hcrit]
  rfl

end DinhSharpness

end DinhSharpnessBundleModule4
/- END Definitions.DinhSharpness.Complete -/


open DinhSharpness
theorem solution :
  ∀ (d h : ℕ), 0 < d → 0 < h →
    ∀ (ℓ : (Input d → ℝ) → ℝ), Continuous (parameterLoss (h := h) ℓ) →
      ∀ (θ : Parameter d h), TwiceDifferentiableAt (parameterLoss ℓ) θ →
        IsLocalMin (parameterLoss ℓ) θ → fderiv ℝ (parameterLoss ℓ) θ = 0 →
          hessian (parameterLoss ℓ) θ ≠ 0 →
            ∀ M : ℝ, 0 < M → ∃ α : ℝ, 0 < α ∧
              prediction (scale α θ) = prediction θ ∧
              parameterLoss ℓ (scale α θ) = parameterLoss ℓ θ ∧
              IsLocalMin (parameterLoss ℓ) (scale α θ) ∧
              TwiceDifferentiableAt (parameterLoss ℓ) (scale α θ) ∧
              fderiv ℝ (parameterLoss ℓ) (scale α θ) = 0 ∧
              M ≤ ‖hessian (parameterLoss ℓ) (scale α θ)‖ := by
  exact DinhSharpness.arbitrarilySharpEquivalentMinima
