-- title:
--   Proposition 4.2, p. 15 — under (6) the planted permutation π* is good with probability → 1
-- statement:
--   Let $0 < \alpha < 1$ and let $q = q_n$, $s = s_n$ satisfy $0 \le q_n < s_n \le 1$ for every $n$. Suppose there exist $\beta > 0$ and $\gamma > 0$ such that, for all large enough $n$, conditions (6) hold:
--   $$nqs \ge \max\Big\{20,\ 84\log\frac{2}{1-\alpha},\ \frac{16}{\min(\gamma,\beta)(1-\alpha)}\Big\},\quad s > \frac{8}{1-\alpha}\,q,\quad \frac{2q(1-s^2)}{s} \le n^{-\beta},\quad qs \le n^{-2\gamma}.$$
--   Let $(A,B)$ be generated by the correlated Erdős–Rényi model $(n, q_n, s_n)$ with planted permutation $\pi^*_n$. Then $\pi^*_n$ is good (Definition 2) with high probability:
--   $$\mathbb P\big[\pi^*_n \text{ is good for } (A,B)\big] \longrightarrow 1 \qquad (n \to \infty).$$
--
--   It guarantees that the algorithm "enumerate all permutations until a good one is found" terminates with high probability.
--
--   **Formalization Note** The statement holds for every sequence of planted permutations $\pi^*_n$ (Proposition 4.2 does not say how $\pi^*$ is drawn; the uniform case follows). For $\pi = \pi^*$, $\sum_{j\ne i} A_{ij}B_{\pi^*(i)\pi^*(j)} = \sum_{j \ne i} A_{ij}B'_{ij}$ is the degree of $i$ in the intersection graph of $G_A$ and $G_{B'}$. No assumption that $nqs$ is constant or that $nqs/2$ is an integer is made; none appears in the statement.
-- source:
--   Hall, Massoulié, Partial Recovery in the Graph Alignment Problem, arXiv:2007.00533v5, p. 15, Proposition 4.2; conditions (6), p. 8

import Mathlib
import Definitions.Def_GraphAlignment_Possible_Setting

namespace GraphAlignment.Possible

open Filter Topology

theorem proposition_4_2 (α : ℝ) (hα : 0 < α ∧ α < 1) (q s : ℕ → ℝ)
    (hqs : ∀ n, 0 ≤ q n ∧ q n < s n ∧ s n ≤ 1)
    (h6 : ∃ βe > 0, ∃ γe > 0, ∀ᶠ n : ℕ in atTop, Cond6 α βe γe n (q n) (s n))
    (πstar : ∀ n : ℕ, Equiv.Perm (Fin n)) :
    Tendsto (fun n : ℕ => prob (q n) (s n)
        (fun ω : Config n => good n (q n) (s n) α (A ω) (B (πstar n) ω) (πstar n)))
      atTop (𝓝 1) := by sorry

end GraphAlignment.Possible
