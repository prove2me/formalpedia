namespace UresRam

private theorem map_eq_one_of_map_conj_eq_one {G M : Type} [Group G] [Monoid M] (f : G →* M)
    (g τ : G) (h : f (g⁻¹ * τ * g) = 1) : f τ = 1 := by
  have hτ : τ = g * (g⁻¹ * τ * g) * g⁻¹ := by group
  rw [hτ, map_mul, map_mul, h, mul_one, ← map_mul, mul_inv_cancel, map_one]

end UresRam

theorem UresMain.exists_mem_inertia_ne_one_of_not_isUnramifiedAt
    {k : Type} [Field k] (ρbar : ResidualGaloisRep k) (q : ℕ) (hq : q.Prime)
    (hram : ¬ ρbar.IsUnramifiedAt q)
    (P : ValuationSubring (AlgebraicClosure ℚ)) (hP : P.LiesOverPrime q) :
    ∃ τ ∈ P.inertiaSubgroupIn ℚ, ρbar.ρ τ ≠ 1 := by
  classical
  simp only [ResidualGaloisRep.IsUnramifiedAt, not_forall] at hram
  obtain ⟨A, hA, τ, hτ, hne⟩ := hram
  obtain ⟨g, hg⟩ := ValuationSubring.exists_algEquiv_smul_eq_of_liesOverPrime hq P A hP hA
  subst hg
  refine ⟨g⁻¹ * τ * g,
    ValuationSubring.conj_mem_inertiaSubgroupIn_of_mem_inertiaSubgroupIn_smul P g hτ, fun h => hne ?_⟩
  exact UresRam.map_eq_one_of_map_conj_eq_one ρbar.ρ g τ h

