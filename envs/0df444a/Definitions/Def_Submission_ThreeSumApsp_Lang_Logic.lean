abbrev Cond.le (a b : Expr) : Cond := a <' b +' k 1
@[inherit_doc] infix:50 " ≤' " => Cond.le
abbrev Stmt.iteNe (a b : Expr) (s₁ s₂ : Stmt) : Stmt := .ite (a =' b) s₂ s₁
