  lA : pkA ≤ 2 ^ W
  lC : pkC + 1 ≤ 2 ^ W
  lbA : bA ≤ 2 ^ W
  lbC : bC ≤ 2 ^ W
  hp : 2 * p ≤ W
  hQ : J6A.QA p ≤ W
  hpk : pkA * p + pkC ≤ W
  hb : bA * p + bC ≤ W
  hbig : (bA * p + bC) * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α) ≤ 2 ^ W
  ht3 : t ^ 3 * α ^ 2 ≤ 2 ^ W
  ht2 : t ^ 2 * α ^ 2 ≤ 2 ^ W
