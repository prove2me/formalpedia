section
-- Source module: Solutions.R6ILCostR
/-!
# Round six, item language: the cost of the general procedure against `costH`

`costN_real`: `costN e V ≤ (2 cq + Kv) · V · cH e + KA · ovN e · (Bb + 2)²` for `e ≥ 1`, where
`ovN` counts `(e + 1)` per node of the call tree; `ovN_le`: `ovN e ≤ (e + 1) (S + 1) ^ depH e`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

noncomputable section

variable {W T m : ℕ} [NeZero W]

theorem ovN_eq (C : Bit.QHNet (ZMod 2) W T m) (e : ℕ) :
    ovN C e = (e + 1) + (if m ≤ e then ((runsL C).map fun ρ => if h : ρ.2.2 * (e / m) < e then
      ovN C (ρ.2.2 * (e / m)) else 0).sum else 0) := by
  rw [ovN]

theorem K0_ge (C : Bit.QHNet (ZMod 2) W T m) : (2 : ℝ) ≤ Bit.K0 C := by
  unfold Bit.K0
  have : 0 ≤ ((T : ℝ) + C.gateWork + 2 * (m + m) * C.numEdges) / W := by positivity
  linarith

theorem runsL_widths (C : Bit.QHNet (ZMod 2) W T m) (g : ℕ → ℝ) :
    ((runsL C).map fun ρ => g ρ.2.2).sum = (C.widths.map g).sum := by
  simp [Bit.QHNet.widths, runsL, List.map_flatMap, Function.comp_def]

theorem run_facts (C : Bit.QHNet (ZMod 2) W T m) (hruns : C.RunsOK) {e : ℕ} (hm : 2 ≤ m)
    (hme : m ≤ e) {ρ : ℕ × ℕ × ℕ} (hρ : ρ ∈ runsL C) :
    ρ.2.2 * (e / m) < e ∧ 1 ≤ ρ.2.2 * (e / m) ∧ ρ.2.2 < m := by
  obtain ⟨e', he', hρ'⟩ := List.mem_flatMap.1 hρ
  obtain ⟨hr0, hrm, hi, hj⟩ := hruns e' he' ρ hρ'
  have hf : 1 ≤ e / m := (Nat.le_div_iff_mul_le (by omega)).2 (by omega)
  exact ⟨Bit.width_lt hme hrm, Nat.mul_pos hr0 hf, hrm⟩

set_option maxHeartbeats 2000000 in
/-- **The cost of the general procedure against the structural cost.** -/
theorem costN_real_sol_aux (C : Bit.QHNet (ZMod 2) W T m) (q Bb : ℕ) (hm : 2 ≤ m) (hruns : C.RunsOK) :
    ∀ e, 1 ≤ e → ∀ V : ℕ, (costN C q Bb e V : ℝ) ≤
      (2 * cq q + Kv C : ℝ) * ((V : ℝ) * Bit.cH C e) + (KA C q : ℝ) * ovN C e * ((Bb : ℝ) + 2) ^ 2 := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  intro he V
  have hm1 : 1 ≤ m := by omega
  set K1 : ℝ := 2 * cq q + Kv C with hK1
  obtain ⟨X, hX⟩ : ∃ X : ℝ, X = ((Bb : ℝ) + 2) ^ 2 := ⟨_, rfl⟩
  rw [← hX]
  have hX0 : 0 ≤ X := by rw [hX]; positivity
  have hcq : (0 : ℝ) ≤ cq q := Nat.cast_nonneg _
  have hKv : (0 : ℝ) ≤ Kv C := Nat.cast_nonneg _
  have hKA : (0 : ℝ) ≤ KA C q := Nat.cast_nonneg _
  have hK1p : 0 ≤ K1 := by rw [hK1]; linarith
  have hV0 : (0 : ℝ) ≤ V := by positivity
  by_cases hme : m ≤ e
  · have h1 := costN_le_big C q Bb e V hm1 hme
    rw [ovN_eq, if_pos hme]
    rw [Bit.cH_rec C hruns hme]
    set f := e / m with hf
    set r := e % m with hr
    set v := V / W with hv
    have hvV : (v : ℝ) ≤ (V : ℝ) / W := Nat.cast_div_le
    have hvV' : (v : ℝ) ≤ V := by
      have : v ≤ V := Nat.div_le_self _ _
      exact_mod_cast this
    have hW : (0 : ℝ) < W := by exact_mod_cast NeZero.pos W
    -- the children
    have hch : ∀ ρ ∈ runsL C, ((if h : ρ.2.2 * f < e then costN C q Bb (ρ.2.2 * f) v else 0 : ℕ) : ℝ)
        ≤ K1 * ((V : ℝ) / W * Bit.cH C (ρ.2.2 * f)) +
          (KA C q : ℝ) * ((if h : ρ.2.2 * f < e then ovN C (ρ.2.2 * f) else 0 : ℕ) : ℝ) * X := by
      intro ρ hρ
      obtain ⟨hlt, h1e, -⟩ := run_facts C hruns hm hme hρ
      rw [dif_pos hlt, dif_pos hlt]
      have hih := ih _ hlt h1e v
      rw [← hX] at hih
      have hc0 : 0 ≤ Bit.cH C (ρ.2.2 * f) := Bit.cH_nonneg C hruns _
      have : K1 * ((v : ℝ) * Bit.cH C (ρ.2.2 * f)) ≤ K1 * ((V : ℝ) / W * Bit.cH C (ρ.2.2 * f)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hvV hc0) hK1p
      linarith
    have hsum := List.sum_le_sum hch
    rw [List.sum_map_add] at hsum
    have e1 : ((runsL C).map fun ρ => K1 * ((V : ℝ) / W * Bit.cH C (ρ.2.2 * f))).sum =
        K1 * ((V : ℝ) / W) * (C.widths.map fun w => Bit.cH C (w * f)).sum := by
      rw [← runsL_widths C (fun w => Bit.cH C (w * f)), ← List.sum_map_mul_left]
      congr 1; apply List.map_congr_left; intro ρ _; ring
    have e2 : ((runsL C).map fun ρ => (KA C q : ℝ) *
        ((if h : ρ.2.2 * f < e then ovN C (ρ.2.2 * f) else 0 : ℕ) : ℝ) * X).sum =
        (KA C q : ℝ) * X * (((runsL C).map fun ρ =>
          if h : ρ.2.2 * f < e then ovN C (ρ.2.2 * f) else 0).sum : ℕ) := by
      rw [Nat.cast_list_sum, List.map_map, ← List.sum_map_mul_left]
      congr 1; apply List.map_congr_left; intro ρ _; simp only [Function.comp_apply]; ring
    rw [e1, e2] at hsum
    have hcast : ((((runsL C).map fun ρ => if h : ρ.2.2 * f < e then
        costN C q Bb (ρ.2.2 * f) v else 0).sum : ℕ) : ℝ) =
        ((runsL C).map fun ρ => ((if h : ρ.2.2 * f < e then
          costN C q Bb (ρ.2.2 * f) v else 0 : ℕ) : ℝ)).sum := by
      rw [Nat.cast_list_sum, List.map_map]; rfl
    have h1' : (costN C q Bb e V : ℝ) ≤ (cq q : ℝ) * (r + 1) * V + (Kv C : ℝ) * v +
        ((runsL C).map fun ρ => ((if h : ρ.2.2 * f < e then
          costN C q Bb (ρ.2.2 * f) v else 0 : ℕ) : ℝ)).sum + (KA C q : ℝ) * ((e + 1) * X) := by
      rw [← hcast, hX]; exact_mod_cast h1
    set Sw := (C.widths.map fun w => Bit.cH C (w * f)).sum
    set So := ((runsL C).map fun ρ => if h : ρ.2.2 * f < e then ovN C (ρ.2.2 * f) else 0).sum
    have hK0 := K0_ge C
    have hr0 : (0 : ℝ) ≤ r := by positivity
    have hA : K1 * (V * (r + Bit.K0 C + Sw / W)) =
        K1 * V * r + K1 * V * Bit.K0 C + K1 * (V / W) * Sw := by ring
    have hB : K1 * V * 2 ≤ K1 * V * Bit.K0 C := mul_le_mul_of_nonneg_left hK0 (mul_nonneg hK1p hV0)
    have hC : (cq q : ℝ) * (r + 1) * V + (Kv C : ℝ) * v ≤ K1 * V * r + K1 * V * 2 := by
      have : (Kv C : ℝ) * v ≤ (Kv C : ℝ) * V := mul_le_mul_of_nonneg_left hvV' hKv
      have : (cq q : ℝ) * r * V ≤ (2 * cq q + Kv C) * r * V := by
        have : (cq q : ℝ) ≤ 2 * cq q + Kv C := by linarith
        exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right this hr0) hV0
      rw [hK1]; nlinarith
    have hD : (KA C q : ℝ) * (((e + 1 + So : ℕ) : ℝ)) * X =
        (KA C q : ℝ) * ((e + 1) * X) + (KA C q : ℝ) * X * (So : ℝ) := by push_cast; ring
    rw [hA, hD]
    linarith
  · have h1 := costN_le_small C q Bb e V hm1 hme
    rw [ovN_eq, if_neg hme, Bit.cH_lt C hme]
    have h1' : (costN C q Bb e V : ℝ) ≤ (cq q : ℝ) * (e + 1) * V + (KA C q : ℝ) * ((e + 1) * X) := by
      rw [hX]; exact_mod_cast h1
    have he1 : (1 : ℝ) ≤ e := by exact_mod_cast he
    have : (cq q : ℝ) * (e + 1) * V ≤ K1 * (V * e) := by
      rw [hK1]
      have : (cq q : ℝ) * (e + 1) ≤ (2 * cq q + Kv C) * e := by nlinarith
      nlinarith
    push_cast
    nlinarith

end

end IntMul.Kappa.R6.IL

