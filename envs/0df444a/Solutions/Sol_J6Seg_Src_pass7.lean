open J6Seg.Slab (flatC)

theorem dn7_sp (s0 : IState HS) (F : Fin HS → List ℤ) {Cm : Fin HS} (hC5 : Cm.val < 56)
    (hCm : Cm ≠ 37 ∧ Cm ≠ 38 ∧ Cm ≠ 39 ∧ Cm ≠ 40 ∧ Cm ≠ 41 ∧ Cm ≠ 42 ∧ Cm ≠ 45) (hFC : F Cm = [])
    (h37 : F 37 = []) (h38 : F 38 = []) (h39 : F 39 = []) (h40 : F 40 = []) (h45 : F 45 = [])
    (h41 : F 41 = []) (h42 : F 42 = [])
    (cs : List (ℤ × ℤ)) (pre post n' : ℕ) (x y : ℤ) {A : ℕ}
    (hcs : ∀ y ∈ flatC cs, |y| ≤ 2 ^ A) (hm : cs.length ≤ 2 ^ A) (hpre : pre ≤ 2 ^ A)
    (hpost : 2 * post ≤ 2 ^ A) (htot : pre * (n' * (2 * post)) ≤ 2 ^ A) (hx : |x| ≤ 2 ^ A)
    (hy : |y| ≤ 2 ^ A) :
    Sp (dn7 Cm) (encK s0 (regOut F cs pre post n' [x] [y])) (encK s0 F)
      (dnC A cs.length + (uC A DD + uC A DD)) := by
  have h := dnCore_sp s0 F hC5 hCm hFC h37 h38 h39 h40 h45 cs pre post n' [x] [y] hcs hm hpre
    hpost htot
  have k1 := popP s0 (update (update F 41 ([x] ++ F 41)) 42 ([y] ++ F 42)) (i := 41) (l := F 41)
    (D := DD) (by decide) (by simp [update_apply]) hx (by decide)
  have k2 := popP s0 (update (update (update F 41 ([x] ++ F 41)) 42 ([y] ++ F 42)) 41 (F 41))
    (i := 42) (l := F 42) (D := DD) (by decide) (by simp [update_apply]) hy (by decide)
  have e : update (update (update (update F 41 ([x] ++ F 41)) 42 ([y] ++ F 42)) 41 (F 41)) 42
      (F 42) = F := by
    funext j
    by_cases j41 : j = 41
    · subst j41; simp [update_apply]
    by_cases j42 : j = 42
    · subst j42; simp [update_apply]
    simp [update_apply, j41, j42]
  rw [e] at k2
  exact h.seq (k1.seq k2)

end J6Seg.Src

