    _ ≤ Real.log ((2 + A) * (2 + r) ^ b) := Real.log_le_log (by positivity) hp
    _ = Real.log (2 + A) + (b : ℝ) * Real.log (2 + r) := by
      rw [Real.log_mul (by positivity) (by positivity), Real.log_pow]
    _ ≤ _ := by nlinarith

