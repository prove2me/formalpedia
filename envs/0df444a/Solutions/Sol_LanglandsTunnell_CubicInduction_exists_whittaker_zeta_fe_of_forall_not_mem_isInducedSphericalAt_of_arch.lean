variable (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)]
  [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

private theorem ramificationIdx_eq_one_of_not_isBadPlace (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (v : HeightOneSpectrum (𝓞 ℚ)) (hv : ¬ IsBadPlace K μ v) :
    ∀ 𝔓 ∈ primeFibre ℚ K v, Ideal.ramificationIdx' v.asIdeal 𝔓.asIdeal = 1 := by
  intro 𝔓 h𝔓
  by_contra hne
  exact hv (Or.inl ⟨𝔓, h𝔓, hne⟩)

private theorem ramificationIdx_under_eq_one_of_not_isBadPlace (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (v : HeightOneSpectrum (𝓞 ℚ)) (hv : ¬ IsBadPlace K μ v) :
    ∀ 𝔓 ∈ primeFibre ℚ K v, (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1 := by
  intro 𝔓 h𝔓
  have hu : 𝔓.under (𝓞 ℚ) = v := h𝔓
  rw [hu]
  exact ramificationIdx_eq_one_of_not_isBadPlace K μ v hv 𝔓 h𝔓

private theorem isUnramifiedCharAt_of_not_isBadPlace (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (v : HeightOneSpectrum (𝓞 ℚ)) (hv : ¬ IsBadPlace K μ v) :
    ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt μ 𝔓 := by
  intro 𝔓 h𝔓
  by_contra hram
  exact hv (Or.inr ⟨𝔓, h𝔓, hram⟩)

end LanglandsTunnell.CubicInduction.BadPlaceBridges

