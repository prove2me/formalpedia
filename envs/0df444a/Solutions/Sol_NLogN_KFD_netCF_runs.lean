theorem withCtr_encK (C : Fin HS) (s : IState HS) (f g : Fin HS → List ℤ)
    (hf : f C = []) (hg : g C = []) (N k : ℕ) :
    withCtr C (NLogN.KIL.encK s f) N k (NLogN.KIL.encK s g) =
      NLogN.KIL.encK s (Function.update g C [(N : ℤ) - k]) := by
