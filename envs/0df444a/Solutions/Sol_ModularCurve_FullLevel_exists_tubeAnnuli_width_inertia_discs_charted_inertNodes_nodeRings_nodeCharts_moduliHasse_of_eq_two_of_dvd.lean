    have hgR' : ∀ f : ↥(fieldBar q M'), g • f ∈ R.integers ↔ f ∈ R.integers :=
      fun f => (hO (g • f)).trans ((hst f).symm.trans (hO f).symm)

    have hψ : ∀ a : ↥A, (RingEquiv.refl (ResidueField ↥A)) (IsLocalRing.residue ↥A a) =
        IsLocalRing.residue ↥A ⟨SemilinearAut.baseAut g (a : AlgebraicClosure ℚ), (hgA (a : AlgebraicClosure ℚ)).mpr a.2⟩ := by
      intro a
      obtain ⟨h, hm⟩ := hgtriv a
      rw [RingEquiv.refl_apply]
      have e : IsLocalRing.residue ↥A (⟨SemilinearAut.baseAut g (a : AlgebraicClosure ℚ), h⟩ - a) = 0 :=
        (IsLocalRing.residue_eq_zero_iff _).mpr hm
      rw [map_sub, sub_eq_zero] at e
      exact e.symm

    let φ' : FSS ≃+* FSS := ι.toRingEquiv.trans (φ.toRingEquiv.trans ι.toRingEquiv.symm)
    have hφ'ι : ∀ y : FSS, ι (φ' y) = φ (ι y) := fun y => by
      show ι (ι.toRingEquiv.symm (φ.toRingEquiv (ι.toRingEquiv y))) = φ (ι y)
      exact ι.toRingEquiv.apply_symm_apply _
    have hφ'ιs : ∀ y : FSS, ι (φ'.symm y) = φ.symm (ι y) := fun y => by
      apply φ.injective
      rw [AlgEquiv.apply_symm_apply, ← hφ'ι, RingEquiv.apply_symm_apply]
    have hφ' : ∀ (f : ↥(fieldBar q M')) (hf : f ∈ R.integers),
        R.residue ⟨g • f, (hgR' f).mpr hf⟩ = φ' (R.residue ⟨f, hf⟩) := by
      intro f hf
      apply ι.injective
      rw [hφ'ι, hι, hι]
      exact hφ f ((hO f).mp hf)
    have hQN : corr Q ∉ N := fun h => hQ ((hN Q).mpr h)
    have hQ' : ∀ y : FSS, y ∈ (corr (φ • Q)).toValuationSubring ↔ φ'.symm y ∈ (corr Q).toValuationSubring := by
      intro y
      rw [hcorr, hcorr, Place.Transport.mem_smul_iff, hφ'ιs]
    obtain ⟨-, -, -, hdiscs⟩ := hLφ g hgA hgR' hgj (RingEquiv.refl _) hψ φ' hφ' (corr Q) (corr (φ • Q)) hQN hQ'
    exact hdiscs P
  ·
    intro Q hQ
    exact hcusp (corr Q) (fun h => hQ ((hN Q).mpr h))
  ·
    intro P hrat htube
    rcases hCOVER P hrat htube with ⟨Q', hQ'N, hPQ'⟩ | ⟨x, hxN, hPx⟩
    ·
      have hcQ : corr (RedII.placeComap ι.symm Q') = Q' := by
        apply Place.ext
        ext y
        show y ∈ (RedII.placeComap ι (RedII.placeComap ι.symm Q')).toValuationSubring ↔ _
        rw [RedII.mem_placeComap, RedII.mem_placeComap, AlgEquiv.symm_apply_apply]
      refine Or.inl ⟨RedII.placeComap ι.symm Q', fun h => hQ'N (hcQ ▸ (hN _).mp h), ?_⟩
      show P ∈ Dx (corr (RedII.placeComap ι.symm Q'))
      rw [hcQ]
      exact hPQ'
    ·
      obtain ⟨ℓ, hℓ⟩ := hnd_surj x hxN
      refine Or.inr ⟨ℓ, (hdomA ℓ P).mpr ?_⟩
      rw [hℓ]
      exact hPx

set_option autoImplicit false

open AlgebraicCurve IsLocalRing

namespace Ws33

variable {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]
  {FIg : Type*} [Field FIg] [Algebra (ResidueField ↥A) FIg]
  {FIx : Type*} [Field FIx] [Algebra (ResidueField ↥A) FIx]

abbrev chartProlongation (C : ComponentChart A F FIg) : RegularProlongation A F FIg :=
  ⟨C.integers, C.residue, C.algebraMap_mem_iff, C.residue_surjective, C.ker_residue, C.residue_algebraMap, C.exists_smul_mem⟩

theorem residue_eq_zero_transport (C : ComponentChart A F FIg) (Rx : RegularProlongation A F FIx)
    (hint : ∀ f : F, f ∈ C.integers ↔ f ∈ Rx.integers)
    (ι : FIg ≃ₐ[ResidueField ↥A] FIx)
    (hι : ∀ (f : F) (h₁ : f ∈ C.integers), ι (C.residue ⟨f, h₁⟩) = Rx.residue ⟨f, (hint f).mp h₁⟩)
    (f : F) (hf : f ∈ Rx.integers) (h0 : Rx.residue ⟨f, hf⟩ = 0) :
    C.residue ⟨f, (hint f).mpr hf⟩ = 0 := by
  apply ι.injective
  rw [hι, map_zero]
  exact h0

theorem ord_residue_transport (C : ComponentChart A F FIg) (Rx : RegularProlongation A F FIx)
    (hint : ∀ f : F, f ∈ C.integers ↔ f ∈ Rx.integers)
    (ι : FIg ≃ₐ[ResidueField ↥A] FIx)
    (hι : ∀ (f : F) (h₁ : f ∈ C.integers), ι (C.residue ⟨f, h₁⟩) = Rx.residue ⟨f, (hint f).mp h₁⟩)
    (xs : Place (ResidueField ↥A) FIg) (bx : Place (ResidueField ↥A) FIx)
    (hx : ∀ y : FIg, y ∈ xs.toValuationSubring ↔ ι y ∈ bx.toValuationSubring)
    (f : F) (hf : f ∈ Rx.integers) :
    xs.ord (C.residue ⟨f, (hint f).mpr hf⟩) = bx.ord (Rx.residue ⟨f, hf⟩) := by
  rw [← RedIIPress.ord_iota ι xs bx hx, hι]

theorem isAttached_of_attached_transport (C : ComponentChart A F FIg) (Rx : RegularProlongation A F FIx)
    (hint : ∀ f : F, f ∈ C.integers ↔ f ∈ Rx.integers)
    (ι : FIg ≃ₐ[ResidueField ↥A] FIx)
    (hι : ∀ (f : F) (h₁ : f ∈ C.integers), ι (C.residue ⟨f, h₁⟩) = Rx.residue ⟨f, (hint f).mp h₁⟩)
    (xs : Place (ResidueField ↥A) FIg) (hxs : xs ∈ C.nodes) (bx : Place (ResidueField ↥A) FIx)
    (hx : ∀ y : FIg, y ∈ xs.toValuationSubring ↔ ι y ∈ bx.toValuationSubring)
    (An : Annulus A F)
    (h : ∃ hz : An.param ∈ Rx.integers, bx.ord (Rx.residue ⟨An.param, hz⟩) = 1 ∧
      ∀ (f : F) (hf : f ∈ Rx.integers), Rx.residue ⟨f, hf⟩ ≠ 0 → (∀ P ∈ An.dom, P.ord f = 0) →
        ∀ P ∈ An.dom, ∃ h : P.evalAt f * (P.evalAt An.param) ^ (-(bx.ord (Rx.residue ⟨f, hf⟩))) ∈ A, IsUnit (⟨_, h⟩ : ↥A)) :
    An.IsAttached C xs :=
  ⟨hxs, RedIIPress.attach_transport (chartProlongation C) Rx hint ι hι xs bx hx An h⟩

end Ws33

namespace Ws33D

variable {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]
  {Fbar : Type*} [Field Fbar] [Algebra (ResidueField ↥A) Fbar]
  {Fbar' : Type*} [Field Fbar'] [Algebra (ResidueField ↥A) Fbar']

section places
variable {K F₁ F₂ : Type*} [Field K] [Field F₁] [Field F₂] [Algebra K F₁] [Algebra K F₂]

theorem tie_symm (ι : F₁ ≃ₐ[K] F₂) (b : Place K F₁) (b' : Place K F₂)
    (hx : ∀ y : F₂, y ∈ b'.toValuationSubring ↔ ι.symm y ∈ b.toValuationSubring) (x : F₁) :
    x ∈ b.toValuationSubring ↔ ι x ∈ b'.toValuationSubring := by
  rw [hx, AlgEquiv.symm_apply_apply]

noncomputable def tieRingEquiv (ι : F₁ ≃ₐ[K] F₂) (b : Place K F₁) (b' : Place K F₂)
    (hx : ∀ y : F₂, y ∈ b'.toValuationSubring ↔ ι.symm y ∈ b.toValuationSubring) :
    ↥b.toValuationSubring ≃+* ↥b'.toValuationSubring where
  toFun x := ⟨ι x, (tie_symm ι b b' hx x).mp x.2⟩
  invFun y := ⟨ι.symm y, (hx y).mp y.2⟩
  left_inv x := Subtype.ext (ι.symm_apply_apply (x : F₁))
  right_inv y := Subtype.ext (ι.apply_symm_apply (y : F₂))
  map_mul' x y := Subtype.ext (map_mul ι _ _)
  map_add' x y := Subtype.ext (map_add ι _ _)

noncomputable def tieResidueAlgEquiv (ι : F₁ ≃ₐ[K] F₂) (b : Place K F₁) (b' : Place K F₂)
    (hx : ∀ y : F₂, y ∈ b'.toValuationSubring ↔ ι.symm y ∈ b.toValuationSubring) :
    b.ResidueField ≃ₐ[K] b'.ResidueField :=
  AlgEquiv.ofRingEquiv (f := IsLocalRing.ResidueField.mapEquiv (tieRingEquiv ι b b' hx)) <| fun a => by
    have h3 : (tieRingEquiv ι b b' hx) (algebraMap K b.toValuationSubring a)
        = algebraMap K b'.toValuationSubring a := by
      ext
      show ι ((algebraMap K b.toValuationSubring a : ↥b.toValuationSubring) : F₁) = _
      rw [Place.coe_algebraMap, Place.coe_algebraMap, ι.commutes]
    show IsLocalRing.ResidueField.mapEquiv _ (IsLocalRing.residue _ _) = IsLocalRing.residue _ _
    rw [IsLocalRing.ResidueField.mapEquiv_apply, IsLocalRing.ResidueField.map_residue]
    exact congrArg _ h3

theorem isRational_transport (ι : F₁ ≃ₐ[K] F₂) (b : Place K F₁) (b' : Place K F₂)
    (hx : ∀ y : F₂, y ∈ b'.toValuationSubring ↔ ι.symm y ∈ b.toValuationSubring)
    (hb : b.IsRational) : b'.IsRational := by
  unfold Place.IsRational at hb ⊢
  have h : (algebraMap K b'.ResidueField) = (tieResidueAlgEquiv ι b b' hx).toAlgHom.toRingHom.comp
      (algebraMap K b.ResidueField) := by
    ext a; simp
  rw [h, RingHom.coe_comp]
  exact (tieResidueAlgEquiv ι b b' hx).surjective.comp hb

end places

theorem residue_eq_zero_transport' (R : RegularProlongation A F Fbar) (R' : RegularProlongation A F Fbar')
    (hint : ∀ f : F, f ∈ R.integers ↔ f ∈ R'.integers)
    (ι : Fbar ≃ₐ[ResidueField ↥A] Fbar')
    (hι : ∀ (f : F) (h₁ : f ∈ R.integers), ι (R.residue ⟨f, h₁⟩) = R'.residue ⟨f, (hint f).mp h₁⟩)
    (f : F) (h : ∀ h₁ : f ∈ R.integers, R.residue ⟨f, h₁⟩ = 0) :
    ∀ h₂ : f ∈ R'.integers, R'.residue ⟨f, h₂⟩ = 0 := by
  intro h₂
  rw [← hι f ((hint f).mpr h₂), h, map_zero]

theorem residue_ne_zero_iff_transport (R : RegularProlongation A F Fbar) (R' : RegularProlongation A F Fbar')
    (hint : ∀ f : F, f ∈ R.integers ↔ f ∈ R'.integers)
    (ι : Fbar ≃ₐ[ResidueField ↥A] Fbar')
    (hι : ∀ (f : F) (h₁ : f ∈ R.integers), ι (R.residue ⟨f, h₁⟩) = R'.residue ⟨f, (hint f).mp h₁⟩)
    (f : F) (h₂ : f ∈ R'.integers) :
    R'.residue ⟨f, h₂⟩ ≠ 0 ↔ R.residue ⟨f, (hint f).mpr h₂⟩ ≠ 0 := by
  rw [← hι f ((hint f).mpr h₂), map_ne_zero_iff _ ι.injective]

theorem ord_residue_eq_transport (R : RegularProlongation A F Fbar) (R' : RegularProlongation A F Fbar')
    (hint : ∀ f : F, f ∈ R.integers ↔ f ∈ R'.integers)
    (ι : Fbar ≃ₐ[ResidueField ↥A] Fbar')
    (hι : ∀ (f : F) (h₁ : f ∈ R.integers), ι (R.residue ⟨f, h₁⟩) = R'.residue ⟨f, (hint f).mp h₁⟩)
    (b : Place (ResidueField ↥A) Fbar) (b' : Place (ResidueField ↥A) Fbar')
    (hx : ∀ y : Fbar', y ∈ b'.toValuationSubring ↔ ι.symm y ∈ b.toValuationSubring)
    (f : F) (n : ℤ) (h : ∀ h₁ : f ∈ R.integers, b.ord (R.residue ⟨f, h₁⟩) = n) :
    ∀ h₂ : f ∈ R'.integers, b'.ord (R'.residue ⟨f, h₂⟩) = n := by
  intro h₂
  rw [← hι f ((hint f).mpr h₂), RedIIPress.ord_iota ι b b' (tie_symm ι b b' hx)]
  exact h (_)

theorem ord_residue_transport' (R : RegularProlongation A F Fbar) (R' : RegularProlongation A F Fbar')
    (hint : ∀ f : F, f ∈ R.integers ↔ f ∈ R'.integers)
    (ι : Fbar ≃ₐ[ResidueField ↥A] Fbar')
    (hι : ∀ (f : F) (h₁ : f ∈ R.integers), ι (R.residue ⟨f, h₁⟩) = R'.residue ⟨f, (hint f).mp h₁⟩)
    (b : Place (ResidueField ↥A) Fbar) (b' : Place (ResidueField ↥A) Fbar')
    (hx : ∀ y : Fbar', y ∈ b'.toValuationSubring ↔ ι.symm y ∈ b.toValuationSubring)
    (f : F) (h₂ : f ∈ R'.integers) :
    b'.ord (R'.residue ⟨f, h₂⟩) = b.ord (R.residue ⟨f, (hint f).mpr h₂⟩) := by
  rw [← hι f ((hint f).mpr h₂), RedIIPress.ord_iota ι b b' (tie_symm ι b b' hx)]

theorem residueLaw_transport (R : RegularProlongation A F Fbar) (R' : RegularProlongation A F Fbar')
    (hint : ∀ f : F, f ∈ R.integers ↔ f ∈ R'.integers)
    (ι : Fbar ≃ₐ[ResidueField ↥A] Fbar')
    (hι : ∀ (f : F) (h₁ : f ∈ R.integers), ι (R.residue ⟨f, h₁⟩) = R'.residue ⟨f, (hint f).mp h₁⟩)
    (b : Place (ResidueField ↥A) Fbar) (b' : Place (ResidueField ↥A) Fbar')
    (hx : ∀ y : Fbar', y ∈ b'.toValuationSubring ↔ ι.symm y ∈ b.toValuationSubring)
    {X : Type*} (val : X → F) (Φ : X → ℕ → Prop)
    (hlaw : ∀ (f : X) (n : ℕ) (h₁ : val f ∈ R.integers), R.residue ⟨val f, h₁⟩ ≠ 0 →
      b.ord (R.residue ⟨val f, h₁⟩) = (n : ℤ) → Φ f n) :
    ∀ (f : X) (n : ℕ) (h₂ : val f ∈ R'.integers), R'.residue ⟨val f, h₂⟩ ≠ 0 →
      b'.ord (R'.residue ⟨val f, h₂⟩) = (n : ℤ) → Φ f n := by
  intro f n h₂ hne hord
  refine hlaw f n ((hint _).mpr h₂) ?_ ?_
  · exact (residue_ne_zero_iff_transport R R' hint ι hι (val f) h₂).mp hne
  · rw [← ord_residue_transport' R R' hint ι hι b b' hx (val f) h₂]; exact hord

theorem nodeRing_mem_transport {𝒩 : Subring F} {OIx OIg' O O' : ValuationSubring F} {rest : F → Prop}
    (h : ∀ f : F, f ∈ 𝒩 ↔ f ∈ OIx ∧ f ∈ O ∧ rest f)
    (hIg : ∀ f : F, f ∈ OIx ↔ f ∈ OIg') (hint : ∀ f : F, f ∈ O ↔ f ∈ O') :
    ∀ f : F, f ∈ 𝒩 ↔ f ∈ OIg' ∧ f ∈ O' ∧ rest f := by
  intro f; rw [h f, hIg f, hint f]

theorem hι_symm (R : RegularProlongation A F Fbar) (R' : RegularProlongation A F Fbar')
    (hint : ∀ f : F, f ∈ R.integers ↔ f ∈ R'.integers)
    (ι : Fbar ≃ₐ[ResidueField ↥A] Fbar')
    (hι : ∀ (f : F) (h₁ : f ∈ R.integers), ι (R.residue ⟨f, h₁⟩) = R'.residue ⟨f, (hint f).mp h₁⟩) :
    ∀ (f : F) (h₂ : f ∈ R'.integers), ι.symm (R'.residue ⟨f, h₂⟩) = R.residue ⟨f, (hint f).mpr h₂⟩ := by
  intro f h₂
  apply ι.injective
  rw [AlgEquiv.apply_symm_apply, hι]

end Ws33D

namespace C1E5b

open AlgebraicCurve IsLocalRing

theorem exists_transcendental_of_isCurveOver {K F : Type*} [Field K] [Field F] [Algebra K F] [PerfectField K]
    [IsCurveOver K F] : ∃ x : F, Transcendental K x := by
  by_contra h
  push Not at h
  haveI : Algebra.IsAlgebraic K F :=
    ⟨fun x => by have := h x; unfold Transcendental at this; push Not at this; exact this⟩
  haveI : Algebra.IsSeparable K F := Algebra.IsAlgebraic.isSeparable_of_perfectField
  haveI : Algebra.FormallyUnramified K F := Algebra.FormallyUnramified.of_isSeparable K F
  have hs : Subsingleton (Ω[F⁄K]) := Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
  exact not_nontrivial_iff_subsingleton.mpr hs (IsCurveOver.instNontrivialKaehler)

theorem transcendental_residue_of_typeII {L : Type*} [Field L] {A : ValuationSubring L}
    [IsAlgClosed (ResidueField A)] {F : Type*} [Field F] [Algebra L F]
    {Fbar : Type*} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (C : ComponentChart A F Fbar) (t : F) (ht : t ∈ C.integers)
    (htu : ∀ a : A, ∃ h : t - algebraMap L F (a : L) ∈ C.integers, IsUnit (⟨_, h⟩ : C.integers)) :
    Transcendental (ResidueField A) (C.residue ⟨t, ht⟩) := by
  intro halg
  have hint : IsIntegral (ResidueField A) (C.residue ⟨t, ht⟩) := halg.isIntegral
  have hdeg : (minpoly (ResidueField A) (C.residue ⟨t, ht⟩)).degree = 1 :=
    IsAlgClosed.degree_eq_one_of_irreducible (ResidueField A) (minpoly.irreducible hint)
  obtain ⟨c, hc⟩ := (minpoly.degree_eq_one_iff).mp hdeg
  obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective c
  rw [← C.residue_algebraMap a] at hc
  obtain ⟨h, hu⟩ := htu a
  have hsub : (⟨t - algebraMap L F (a : L), h⟩ : C.integers) =
      ⟨t, ht⟩ - ⟨algebraMap L F (a : L), (C.algebraMap_mem_iff (a : L)).mpr a.2⟩ := rfl
  have hmax : (⟨t - algebraMap L F (a : L), h⟩ : C.integers) ∈ maximalIdeal C.integers := by
    rw [← C.ker_residue, RingHom.mem_ker, hsub, map_sub, hc, sub_self]
  exact (IsLocalRing.mem_maximalIdeal _).mp hmax hu

end C1E5b

