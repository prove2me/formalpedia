      have hq0 : 0 ≤ ((t - s : ℕ) : ℝ) / s := by positivity
      have hα0 : (0 : ℝ) ≤ (α : ℝ) ^ 2 := by positivity
      have h1 : (α : ℝ) ^ 2 * (((t - s : ℕ) : ℝ) / s) * (((lam - 1 : ℕ) : ℝ)) ^ 2 ≤
          (α : ℝ) ^ 2 * (1 / (3 * (d : ℝ) ^ 2)) * (4 * (d : ℝ) ^ 3) := by
        gcongr
      have h2 : (α : ℝ) ^ 2 * (1 / (3 * (d : ℝ) ^ 2)) * (4 * (d : ℝ) ^ 3) =
