lemma g2_nonneg (m : ℕ) : ∀ x : ℝ, 1 ≤ x → 0 ≤ g2 m x := by
  apply nonneg_from_derivative (hasDerivAt_g2 m) (g2_one_nonneg m)
  intro x hx
  apply mul_nonneg _ (g3_nonneg m x hx)
  have hx0 : 0 ≤ x := le_trans (by norm_num) hx
  calc
    (0 : ℝ) ≤ (2 * (m : ℝ) + 12) := by positivity
    _ = (let k : ℝ := (m : ℝ)+5; (2 * k + 2)) := by ring

lemma g1_nonneg (m : ℕ) : ∀ x : ℝ, 1 ≤ x → 0 ≤ g1 m x := by
  apply nonneg_from_derivative (hasDerivAt_g1 m) (g1_one_nonneg m)
  intro x hx
  apply mul_nonneg _ (g2_nonneg m x hx)
  have hx0 : 0 ≤ x := le_trans (by norm_num) hx
  calc
    (0 : ℝ) ≤ (1) * x^(m+3) := by positivity
    _ = (1 * x^(m+3)) := by ring

lemma g0_nonneg (m : ℕ) : ∀ x : ℝ, 1 ≤ x → 0 ≤ g0 m x := by
  apply nonneg_from_derivative (hasDerivAt_g0 m) (g0_one_nonneg m)
  intro x hx
  apply mul_nonneg _ (g1_nonneg m x hx)
  have hx0 : 0 ≤ x := le_trans (by norm_num) hx
  calc
    (0 : ℝ) ≤ (1) := by positivity
    _ = (1) := by ring

end UniversalBarrier.NSC.GPolyProof

-- Complete inline local helper: Factorization.lean

set_option maxHeartbeats 0

namespace UniversalBarrier.NSC.GPolyProof

/-- Exact algebraic factorization connecting the original polynomial to `g0`.
It holds for every real argument, without sign or nonvanishing assumptions. -/
theorem gpoly_factorization (m : ℕ) (x : ℝ) :
    gpoly (m + 5) x = ((m : ℝ) + 6)^3 * (x - 1)^2 * x^(m + 5) * g0 m x := by
  dsimp only [gpoly, g0]
  norm_num only [Nat.cast_add, Nat.cast_ofNat, pow_add, pow_mul]
  ring

end UniversalBarrier.NSC.GPolyProof

-- Complete inline local helper: Boundary.lean

namespace UniversalBarrier.NSC.GpolyBoundary

lemma gpoly_two_factor (x : ℝ) :
    gpoly 2 x = 108*(x-1)^12*x^2*(1+6*x+x^2) := by
  norm_num [gpoly]
  ring

lemma gpoly_three_factor (x : ℝ) :
    gpoly 3 x = 512*(x-1)^12*x^3*(2+15*x+60*x^2+96*x^3+60*x^4+15*x^5+2*x^6) := by
  norm_num [gpoly]
  ring

lemma gpoly_four_factor (x : ℝ) :
    gpoly 4 x = 4500*(x-1)^12*x^4*
      (1+8*x+35*x^2+110*x^3+212*x^4+268*x^5+212*x^6+110*x^7+35*x^8+8*x^9+x^10) := by
  norm_num [gpoly]
  ring

lemma gpoly_two (x : ℝ) (hx : 1 ≤ x) : 0 ≤ gpoly 2 x := by
  have hx0 : 0 ≤ x := by linarith
  rw [gpoly_two_factor]
  positivity

lemma gpoly_three (x : ℝ) (hx : 1 ≤ x) : 0 ≤ gpoly 3 x := by
  have hx0 : 0 ≤ x := by linarith
  rw [gpoly_three_factor]
  positivity

lemma gpoly_four (x : ℝ) (hx : 1 ≤ x) : 0 ≤ gpoly 4 x := by
  have hx0 : 0 ≤ x := by linarith
  rw [gpoly_four_factor]
  positivity

lemma gpoly_small (k : ℕ) (hk : 2 ≤ k) (hk4 : k ≤ 4) (x : ℝ) (hx : 1 ≤ x) :
    0 ≤ gpoly k x := by
  interval_cases k
  · exact gpoly_two x hx
  · exact gpoly_three x hx
  · exact gpoly_four x hx

end UniversalBarrier.NSC.GpolyBoundary


namespace UniversalBarrier.NSC.GPolyProof

lemma gpoly_succ_nonneg (m : ℕ) (x : ℝ) (hx : 1 ≤ x) : 0 ≤ gpoly (m+5) x := by
  rw [gpoly_factorization]
  have hx0 : 0 ≤ x := le_trans (by norm_num) hx
  exact mul_nonneg (by positivity) (g0_nonneg m x hx)

end UniversalBarrier.NSC.GPolyProof

namespace UniversalBarrier.NSC

theorem _root_.solution (k : ℕ) (hk : 2 ≤ k) (γ : ℝ) (hγ : 1 ≤ γ) : 0 ≤ gpoly k γ := by
  by_cases hk5 : 5 ≤ k
  · obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le hk5
    simpa only [Nat.add_comm 5] using GPolyProof.gpoly_succ_nonneg m γ hγ
  · exact GpolyBoundary.gpoly_small k hk (by omega) γ hγ

end UniversalBarrier.NSC
