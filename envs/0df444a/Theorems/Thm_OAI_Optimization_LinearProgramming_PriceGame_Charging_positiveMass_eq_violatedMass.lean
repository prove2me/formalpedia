variable {V I : Type*}

theorem positiveMass_eq_violatedMass [Fintype V] (vertex : V → I) (m : V → ℚ)
    (P y : I → ℚ) (h : Bool) (t : ℚ) :
    positiveMass m (fun v => probeSurplus P y h t (vertex v)) =
      violatedMass m h (fun v => signed h (P (vertex v) - t)) (fun v => y (vertex v)) := by sorry
