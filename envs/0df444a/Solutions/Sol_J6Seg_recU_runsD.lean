section
-- Source module: Solutions.KFV6Pack
/-!
# KFV §10: packing, the four ring products, and the extraction of one record product

* `carE`, `digE`, `mvE`, `mulE`: KFT's packer `carI` and digit cutter `digI`, an `mv`, and one
  `MulOK` product (`KFM.mulC`) on managed states `encK s f`.
* **`packI_runs`**: `mvK` a reversed offset record onto stack `0`, `carI`, subtract the offset
  constant: the signed Kronecker integer `∑_h a_h 2^{b h}` on stack `P` (Lemma 17's packing).
* **`extI_runs`**: from two products `m₁, m₂` with `m₁ ± m₂ = ∑_{j<2r} h_j 2^{b j}`
  (`h_j ∈ [-2^{b-1}, 2^{b-1})`): `zfix`, `digI`, the centered carry pass `carL`, two `mvK`, and the
  fold-and-truncate `fldP`; pushes `((h_j - h_{j+r}).tdiv 2^Δ)_{j<r}` on stack `O`
  (`KFV6Math.extract_digits`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 10000

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFT Synth

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## 1. IState-level pieces on managed states -/

theorem mulE {M : MulSpec} {pM : Fin Pp} (hM : MulOK I iprog pM M) (k i j : Fin HS)
    (hk : k.val < 55) (hi : i.val < 55) (hj : j.val < 55) (s : IState HS) (f : Fin HS → List ℤ)
    (a c : ℤ) (li lj : List ℤ) (hA : f i = a :: li) (hC : f j = c :: lj) (hd : M.dom c a) :
    IRuns I iprog (KFM.mulC pM k i j) (encK s f)
      (encK s (Function.update f k (c * a :: f k))) (KFM.cMulC M a c) := by
  refine (KFM.mulC_runs hM k i j hk hi hj (encK s f) a c (ints li ++ s.G i) (ints lj ++ s.G j)
    (by simp [hA, ints]) (by simp [hC, ints]) hd).mono' ?_ le_rfl
  rw [← encK_upd]; simp [ints]

/-! ## 2. Packing one offset part -/

/-- The packed integer: offset part minus the offset constant is the signed evaluation. -/
theorem carOut_offG (b : ℕ) (c : ℤ) (zs : List GI) (hc : ∀ z ∈ zs, 0 ≤ z.1 + c) :
    (carOut b (zs.map (offG c)) : ℤ) -
        ∑ h ∈ Finset.range zs.length, c * (2 ^ b : ℤ) ^ h =
      ∑ h ∈ Finset.range zs.length, reF zs h * (2 ^ b : ℤ) ^ h := by
  rw [carOut_eq_sum]
  push_cast
  rw [List.length_map, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun h hh => ?_
  have hh' := Finset.mem_range.1 hh
  have e : (((reN (zs.map (offG c))).getD h 0 : ℕ) : ℤ) = reF zs h + c := by
    simp only [reN, List.map_map, reF]
    rw [List.getD_eq_getElem _ _ (by simpa using hh'), List.getD_eq_getElem _ _ hh']
    simp only [List.getElem_map, Function.comp, offG]
    exact Int.toNat_of_nonneg (hc _ (List.getElem_mem hh'))
  rw [e]; ring

theorem carOut_offG_swap (b : ℕ) (c : ℤ) (zs : List GI) (hc : ∀ z ∈ zs, 0 ≤ z.2 + c) :
    (carOut b (zs.map (fun z => offG c z.swap)) : ℤ) -
        ∑ h ∈ Finset.range zs.length, c * (2 ^ b : ℤ) ^ h =
      ∑ h ∈ Finset.range zs.length, imF zs h * (2 ^ b : ℤ) ^ h := by
  rw [carOut_eq_sum]
  push_cast
  rw [List.length_map, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun h hh => ?_
