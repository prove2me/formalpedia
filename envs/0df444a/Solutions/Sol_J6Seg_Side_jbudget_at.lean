theorem w1_le : axw6 P n + 1 ≤ 15 * dP6 P n := by
  have hd1 := h.base.d1
  have hk : kF (dP6 P n) ≤ 2 * dP6 P n := by unfold kF; have := Nat.sqrt_le_self (dP6 P n); omega
  show 7 * kF (dP6 P n) + 1 ≤ _
  omega

theorem kJ_le : axkJ6 P n src k ap ≤ W2c ap * pP6 P n := by
  have hQ := h.base.Qp
  have hp := h.base.p1
  show ap.pl.kA * axQ6 P n src k + ap.pl.kC ≤ (3 * ap.pl.kA + ap.pl.kC) * pP6 P n
  have h1 : ap.pl.kA * axQ6 P n src k ≤ ap.pl.kA * (3 * pP6 P n) := Nat.mul_le_mul_left _ hQ
  have h2 : ap.pl.kC ≤ ap.pl.kC * pP6 P n := Nat.le_mul_of_pos_right _ hp
  have e : (3 * ap.pl.kA + ap.pl.kC) * pP6 P n = ap.pl.kA * (3 * pP6 P n) + ap.pl.kC * pP6 P n := by
    ring
  omega

theorem n_Bc : (axw6 P n + 1) * (axBc6 P n src k ap + 2) ^ 2 ≤
    30 * (10 + ap.bcC) ^ 2 * (pP6 P n * ℓP6 P n) := by
  have h1 := w1_le h
  have h2 := (bc_ax ap h).2
  have hl1 := h.ℓ1
  have hld := h.ℓd
  have h3 : axBc6 P n src k ap + 2 ≤ (10 + ap.bcC) * ℓP6 P n := by
    have : (10 + ap.bcC) * ℓP6 P n = 10 * ℓP6 P n + ap.bcC * ℓP6 P n := by ring
    have : ap.bcC ≤ ap.bcC * ℓP6 P n := Nat.le_mul_of_pos_right _ hl1
    omega
  calc (axw6 P n + 1) * (axBc6 P n src k ap + 2) ^ 2
      ≤ (15 * dP6 P n) * ((10 + ap.bcC) * ℓP6 P n) ^ 2 :=
        Nat.mul_le_mul h1 (Nat.pow_le_pow_left h3 2)
    _ = 15 * (10 + ap.bcC) ^ 2 * (ℓP6 P n * dP6 P n) * ℓP6 P n := by ring
    _ ≤ 15 * (10 + ap.bcC) ^ 2 * (2 * pP6 P n) * ℓP6 P n :=
        Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hld)
    _ = 30 * (10 + ap.bcC) ^ 2 * (pP6 P n * ℓP6 P n) := by ring

theorem n_Bx : (axw6 P n + 1) * (3 * axkJ6 P n src k ap + 10 + 2) ≤
    15 * (3 * W2c ap + 12) * (dP6 P n * pP6 P n) := by
  have h1 := w1_le h
  have h2 := kJ_le ap h
  have hp := h.base.p1
  have h3 : 3 * axkJ6 P n src k ap + 10 + 2 ≤ (3 * W2c ap + 12) * pP6 P n := by
    have : (3 * W2c ap + 12) * pP6 P n = 3 * (W2c ap * pP6 P n) + 12 * pP6 P n := by ring
    omega
  calc (axw6 P n + 1) * (3 * axkJ6 P n src k ap + 10 + 2)
      ≤ (15 * dP6 P n) * ((3 * W2c ap + 12) * pP6 P n) := Nat.mul_le_mul h1 h3
    _ = _ := by ring

theorem n_B : (BkJ6 P n src k ap + 2) * (axw6 P n + 1) ≤ 15 * W3c ap * (dP6 P n * pP6 P n) := by
  have h1 := w1_le h
  have h2 := kJ_le ap h
  have hw := wd_le ap h.base
  have hb := (bc_ax ap h).1
  have hQ := h.base.Qp
  have hp := h.base.p1
