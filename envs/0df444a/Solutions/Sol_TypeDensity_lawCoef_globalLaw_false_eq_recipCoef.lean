  rw [(TypeDensity.coeff_succ_clusterSer 1 m)] at h1
  rw [show TypeDensity.rootLaw (m + 1) = TypeDensity.stateLaw (.single 1 (m + 1)) by simp [TypeDensity.rootLaw]]
  refine TypeDensity.scalar_mul_left_cancel (pow_ne_zero (m + 1) (RatFunc.X_ne_zero (K := ℚ))) ?_
