namespace OAI

noncomputable section
open scoped BigOperators

namespace MUB6

def weightMultiset (w : Coord → ℕ) : Multiset Coord :=
  ∑ i, Multiset.replicate (w i) i

def positivePositions (a : Charge) : Multiset Coord := weightMultiset (fun i => (a i).toNat)
def negativePositions (a : Charge) : Multiset Coord := weightMultiset (fun i => (-a i).toNat)

end MUB6

