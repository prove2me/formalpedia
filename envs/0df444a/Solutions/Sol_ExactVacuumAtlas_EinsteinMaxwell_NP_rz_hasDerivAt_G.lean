theorem transpose_mul_cmat_mul_apply2 (T : Fin 4 → Fin 4 → Pt 4 → ℝ) (x : Pt 4)
    (X Y : Matrix (Fin 4) (Fin 4) ℂ) (A B : Fin 4) :
