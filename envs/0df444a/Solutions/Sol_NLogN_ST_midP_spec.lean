      rw [hw, withCtr]; exact Ex.eval_upd _ _ _ c hcC
    have wm : w.G m = .int (min k μ : ℕ) :: s.G m := by
      simp [hw, withCtr, IState.upd_G, hmC]
    simp only [srchBody, RS.run, Ex.eval, e1, IState.top_eq wm, wm, List.tail_cons]
    have e2 : (((min k μ : ℕ) : ℤ) + if c.eval (s.upd m (.int (min k μ : ℕ) :: s.G m)) < 0 then 0
        else 1) = ((min (k + 1) μ : ℕ) : ℤ) := by
      by_cases h : μ ≤ min k μ
      · rw [if_pos ((hc _).2 h)]; push_cast; omega
      · rw [if_neg (fun h' => h ((hc _).1 h'))]; push_cast; omega
    rw [e2, hw]
    apply IState.ext' _ (by simp [withCtr]) (by simp [withCtr])
    intro y
    simp only [withCtr, IState.upd_G]
    clear * - hmC
    split_ifs <;> (try subst_vars) <;> simp_all

