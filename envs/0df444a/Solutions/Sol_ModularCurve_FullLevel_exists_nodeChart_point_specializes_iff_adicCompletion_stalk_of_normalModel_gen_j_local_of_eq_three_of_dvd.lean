theorem Subalgebra.common_denominator {R F : Type*} [CommRing R] [Field F] [Algebra R F]
    (C O : Subalgebra R F) (hCO : C ≤ O)
    (hloc : ∀ f : F, f ∈ O → ∃ g h : F, g ∈ C ∧ h ∈ C ∧ (∀ hh : h ∈ O, IsUnit (⟨h, hh⟩ : ↥O)) ∧ f * h = g)
    (S : Finset F) (hS : ∀ f ∈ S, f ∈ O) :
    ∃ d : F, d ∈ C ∧ (∀ hd : d ∈ O, IsUnit (⟨d, hd⟩ : ↥O)) ∧ ∀ f ∈ S, f * d ∈ C := by
  classical
  induction S using Finset.induction_on with
  | empty => exact ⟨1, C.one_mem, fun hd => by { have : (⟨(1:F), hd⟩ : ↥O) = 1 := Subtype.ext rfl; rw [this]; exact isUnit_one }, fun f hf => absurd hf (Finset.notMem_empty f)⟩
  | insert a s ha ih =>
    obtain ⟨d, hdC, hdu, hd⟩ := ih (fun f hf => hS f (Finset.mem_insert_of_mem hf))
    obtain ⟨g, d', hg, hd'C, hd'u, e⟩ := hloc a (hS a (Finset.mem_insert_self a s))
    refine ⟨d * d', C.mul_mem hdC hd'C, fun hdd => ?_, fun f hf => ?_⟩
    · have : (⟨d * d', hdd⟩ : ↥O) = ⟨d, hCO hdC⟩ * ⟨d', hCO hd'C⟩ := Subtype.ext rfl
      rw [this]; exact (hdu (hCO hdC)).mul (hd'u (hCO hd'C))
    · rcases Finset.mem_insert.mp hf with rfl | hf
      · rw [mul_comm d d', ← mul_assoc, e]; exact C.mul_mem hg hdC
      · rw [← mul_assoc]; exact C.mul_mem (hd f hf) hd'C

end NodeSkelG

