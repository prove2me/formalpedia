  obtain ⟨v1, hv1, v1P, v1G, v1S, v1U, v1T, v1E, v1Q, v1K, v1R, v1N, v1QR, v1QN, v1GR, v1Qt, v1Qr,
    S1⟩ := NLogN.KIL.preA_sp (W := W) s F hM hq hm ⟨LP, FP⟩ ⟨LG, FG⟩ ⟨LS, FS⟩ ⟨LU, FU⟩ hg1 F23
      a1 a2 a3 a4 a5
  -- 2. the binary embedding
  obtain ⟨v2, fr2, hv2, S2⟩ := NLogN.KFE.preB_fsp s F v1 hM hv1 FP FG FS v1P v1G v1S v1T v1Q hP1 hg1 hS1 hT1
    hTQ (by rw [← hVqb]; omega) xs F0 F15 F20 F21 hxs hB1
  have k2 : ∀ i, i ∉ [NLogN.KIL.pX, NLogN.KIL.pB, NLogN.KIL.pZ, NLogN.KIL.pT] → v2 i = v1 i := fr2
  set ys1 := AModelL12.embed (AModelL12.binShape Pre G Suf (2 ^ u)) (AModelL12.binShape Pre G Suf (q ^ e)) 0 xs with hys1
  have hys1l : ys1.length = Vq := by rw [hys1, AModelL12.length_embed, hVqb]
  set F1 := Function.update F 0 (NLogN.KIL.enc2 ys1) with hF1
  have F1n : ∀ i, i ≠ 0 → F1 i = F i := fun i hi => Function.update_of_ne hi _ _
  -- 3. the high-digit swaps
  have hre : r ≤ e := min_le_right _ _
  have S3 := NLogN.KFE.swapCF_runs (I := I) (iprog := iprog) s F1 v2 Pre G Suf hq hP1 hg1 hS1 hre ys1 (by rw [hF1, Function.update_self])
    hys1l hB1 (le_trans (NLogN.KIL.zsz_nat_le (by omega)) hM) (by rw [F1n _ (by decide), F24])
    (by rw [F1n _ (by decide), FP]) (by rw [F1n _ (by decide), FG]) (by rw [F1n _ (by decide), FS])
    (by rw [k2 _ (by decide), v1Qt]) (by rw [k2 _ (by decide), v1Qr]) (by rw [k2 _ (by decide), v1R])
  set hs := AModelL12.highSwaps (AModelL12.qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) r 0 ys1
    with hhs
  have hhsl : hs.length = Vq := NLogN.KIL.length_highSwaps hys1l r
  set v3 := Function.update (Function.update v2 NLogN.KIL.kQt (q ^ r)) NLogN.KIL.kQr (q ^ (e - r) / q) with hv3
  have k3 : ∀ i, i ∉ [NLogN.KIL.kQt, NLogN.KIL.kQr, NLogN.KIL.pX, NLogN.KIL.pB, NLogN.KIL.pZ, NLogN.KIL.pT] → v3 i = v1 i := fun i hi => by
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    rw [hv3, Function.update_of_ne hi.2.1, Function.update_of_ne hi.1, k2 i (by simp [hi])]
  have hqr : q ^ r ≤ q ^ e := Nat.pow_le_pow_right hq0 hre
  have hv3b : ∀ i ∈ NLogN.KIL.regD, v3 i ≤ M := by
    intro i hi
    rw [hv3]; simp only [Function.update_apply]
    split_ifs
    · exact le_trans (Nat.div_le_self _ _) (le_trans (Nat.pow_le_pow_right hq0 (Nat.sub_le _ _))
        (by omega))
    · omega
    · exact hv2 i hi
  set F2 := Function.update F 0 (NLogN.KIL.enc2 hs) with hF2
  have F2n : ∀ i, i ≠ 0 → F2 i = F i := fun i hi => Function.update_of_ne hi _ _
  have hF12 : Function.update F1 0 (NLogN.KIL.enc2 hs) = F2 := by rw [hF1, Function.update_idem]
  rw [hF12] at S3
  -- 4. the middle part
  have hrn : r + n = e := by omega
  obtain ⟨v4, hv4, fr4, H4⟩ := NLogN.KFE.iteF_run (I := I) (iprog := iprog) s F2 v3 hM hv3b (K := K) (r := r)
    (n := n) Pre G Suf child cO hs hq hm hW hPre hG hS (LP := LP) (LS := LS)
    (by rw [F2n _ (by decide), FP]) (by rw [F2n _ (by decide), FS])
    (by rw [k3 _ (by decide), v1P]) (by rw [k3 _ (by decide), v1S]) (by rw [k3 _ (by decide), v1K])
    (by rw [k3 _ (by decide), v1QR]) (by rw [k3 _ (by decide), v1N])
    (by rw [k3 _ (by decide), v1QN]) (by rw [k3 _ (by decide), v1GR])
    (by rw [hF2, Function.update_self]) (by rw [F2n _ (by decide), F15])
    (by rw [F2n _ (by decide), F20]) (by rw [F2n _ (by decide), F21])
    (by rw [F2n _ (by decide), F23]) (by rw [F2n _ (by decide), F8])
    (by rw [F2n _ (by decide), F9]) (by rw [F2n _ (by decide), F10])
    (by rw [F2n _ (by decide), F11]) (by rw [hrn]; exact hhsl)
    (fun h1 => by
      have : r = W * K := by
        rw [hr]; apply min_eq_left; omega
      rw [this]; exact NLogN.KIL.pow_le_q_pow hq)
    (by rw [hrn]; omega) (by omega) (by omega) hB1 hO hlenP
  set D := if n = 0 then hs else NLogN.KIL.l12mid child W m q K r Pre G Suf n 0 hs with hD
  have hDl : D.length = Vq := by
    rw [hD]; split_ifs
    · exact hhsl
    · rw [NLogN.KIL.l12mid, AModelL12.length_extract, hVq, ← hrn, NLogN.KIL.vol_qShape_row, AModelL12.vol_rowShape]; ring
  set F3 := Function.update F 0 (NLogN.KIL.enc2 D) with hF3
  have hF23 : Function.update F2 0 (NLogN.KIL.enc2 D) = F3 := by rw [hF2, Function.update_idem]
  rw [hF23] at H4
  have F3n : ∀ i, i ≠ 0 → F3 i = F i := fun i hi => Function.update_of_ne hi _ _
  have k4 : ∀ i ∈ [NLogN.KIL.kP, NLogN.KIL.kG, NLogN.KIL.kS, NLogN.KIL.aT2, NLogN.KIL.aQE], v4 i = v1 i := by
    intro i hi; simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl <;> rw [fr4 _ (by decide), k3 _ (by decide)]
  -- 5. the binary extraction
  obtain ⟨v5, fr5, hv5, S5⟩ := NLogN.KFE.postB_fsp s F3 v4 hM hv4 (by rw [F3n _ (by decide), FP])
    (by rw [F3n _ (by decide), FG]) (by rw [F3n _ (by decide), FS])
    (by rw [k4 _ (by decide), v1P]) (by rw [k4 _ (by decide), v1G]) (by rw [k4 _ (by decide), v1S])
    (by rw [k4 _ (by decide), v1T]) (by rw [k4 _ (by decide), v1Q]) hP1 hg1 hS1 hT1 hTQ
    (by rw [← hVqb]; omega) D (by rw [hF3, Function.update_self]) (by rw [F3n _ (by decide), F15])
    (by rw [F3n _ (by decide), F20]) (by rw [F3n _ (by decide), F21]) (by rw [hDl, hVqb]) hB1
  have hF34 : Function.update F3 0 (NLogN.KIL.enc2 (AModelL12.extract (AModelL12.binShape Pre G Suf (2 ^ u))
      (AModelL12.binShape Pre G Suf (q ^ e)) 0 D)) = Function.update F 0 (NLogN.KIL.enc2 (AModelL12.extract
        (AModelL12.binShape Pre G Suf (2 ^ u)) (AModelL12.binShape Pre G Suf (q ^ e)) 0 D)) := by
    rw [hF3, Function.update_idem]
  rw [hF34] at S5
  -- 6. removing the file
  have S6 := NLogN.KIL.Sp.popD s B NLogN.KIL.regD (Function.update F 0 (NLogN.KIL.enc2 (AModelL12.extract (AModelL12.binShape Pre G Suf (2 ^ u))
      (AModelL12.binShape Pre G Suf (q ^ e)) 0 D))) v5 NLogN.KIL.regD_lt NLogN.KIL.regD_nodup
    (fun i hi => le_trans (NLogN.KIL.zsz_nat_le (hv5 i hi)) hM)
  have H := (S1.toIRuns (I := I) (iprog := iprog)).seq ((S2.irun (I := I) (iprog := iprog)
    (by decide)).seq (S3.seq (H4.seq ((S5.irun (I := I) (iprog := iprog) (by decide)).seq
      (S6.toIRuns (I := I) (iprog := iprog))))))
  refine H.mono' ?_ ?_
  · congr 3
  · unfold NLogN.KFE.cL12F
    simp only [NLogN.KIL.regD, List.length_cons, List.length_nil]
    rw [← hVqb, ← he]
    generalize (if n = 0 then 0 else NLogN.KFE.cMidF K _ m n cO B) = X
    generalize NLogN.KFE.cPadF Vq B = C
    generalize NLogN.KFE.cSw1F q Vq B = A
    generalize NLogN.KIL.cPreA u e B = D
    generalize (B + 2) ^ 2 = Y
    ring_nf
    omega
end
