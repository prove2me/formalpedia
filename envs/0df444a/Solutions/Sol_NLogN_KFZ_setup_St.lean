theorem take_succ_rev (l : List ℕ) (i : ℕ) (hi : i < l.length) :
    (NLogN.KFZ.zl (l.take (i + 1))).reverse = (l[i] : ℤ) :: (NLogN.KFZ.zl (l.take i)).reverse := by
  have e : l.take (i + 1) = l.take i ++ [l[i]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem hi]; rfl
  rw [e, NLogN.KFZ.zl_append, List.reverse_append]; simp [NLogN.KFZ.zl]

theorem drop_zl (l : List ℕ) (i : ℕ) (hi : i < l.length) :
    NLogN.KFZ.zl (l.drop i) = (l[i] : ℤ) :: NLogN.KFZ.zl (l.drop (i + 1)) := by
  rw [List.drop_eq_getElem_cons hi]; rfl

set_option maxHeartbeats 4000000 in
theorem dtLoop_sp (s : IState HS) (G : Fin HS → List ℤ) (h d : ℕ) (bs ss : List ℕ)
    (X lH lD : List ℤ) (hbl : bs.length = d) (hsl : ss.length = d) (hb1 : ∀ b ∈ bs, b ≤ 1)
    (hst : ∀ (i : ℕ) (hi : i < d), ss[i]'(by omega) ≤ 2 ^ (h + bs[i]'(by omega)))
    (gH : G rgH = (h : ℤ) :: lH) (gD : G rgD = (d : ℤ) :: lD)
    (gE : G lfE = [(NLogN.KFZ.eS h bs d : ℤ)]) (gB : G lfB = (NLogN.KFZ.zl bs).reverse)
    (gS : G lfS = (NLogN.KFZ.zl ss).reverse) (gB2 : G lfB2 = []) (gS2 : G lfS2 = []) (gC : G lfC = [])
    (gT : G tD = X) (B : ℕ) (hB : NLogN.KFZ.eS h bs d + h + 6 ≤ B) (hdB : d + 2 ≤ B) :
    Sp (.rep lfC (.reg rgD) dtB) (NLogN.KIL.encK s G)
      (NLogN.KIL.encK s (Function.update (Function.update (Function.update (Function.update
        (Function.update (Function.update G tD (descA 1 (axD h bs ss) ++ X)) lfE [0]) lfB [])
        lfS []) lfB2 (NLogN.KFZ.zl bs)) lfS2 (NLogN.KFZ.zl ss)))
      (2 * 2000 * (B + 2) + d * (100 * 10 ^ 7 * (B + 2) ^ 2 + 8000 * (B + 2) + 30) + 32) := by
  have hLl : (axD h bs ss).length = d := by rw [length_axD h bs ss (by omega), hbl]
  have hnK := nK_axD h bs ss (by omega)
  let Gm : ℕ → Fin HS → List ℤ := fun m =>
    Function.update (Function.update (Function.update (Function.update (Function.update
      (Function.update G tD (descA (nK (axD h bs ss) m) ((axD h bs ss).drop m) ++ X)) lfE [(NLogN.KFZ.eS h bs m : ℤ)]) lfB
      (NLogN.KFZ.zl (bs.take m)).reverse) lfS (NLogN.KFZ.zl (ss.take m)).reverse) lfB2 (NLogN.KFZ.zl (bs.drop m))) lfS2
      (NLogN.KFZ.zl (ss.drop m))
  let F : ℕ → Fin HS → List ℤ := fun k => Gm (d - k)
  have e1 : (axD h bs ss).drop d = [] := List.drop_of_length_le (by omega)
  have e2 : bs.take d = bs := List.take_of_length_le (by omega)
  have e3 : ss.take d = ss := List.take_of_length_le (by omega)
  have e4 : bs.drop d = [] := List.drop_of_length_le (by omega)
  have e5 : ss.drop d = [] := List.drop_of_length_le (by omega)
  have hF0 : F 0 = G := by
    simp only [F, Gm, Nat.sub_zero]
    rw [e1, e2, e3, e4, e5]
    simp only [descA, zl_nil, List.nil_append]
    funext j
    simp only [Function.update_apply]
    split_ifs <;> subst_vars <;> simp_all +decide
  have hFd : F d = Function.update (Function.update (Function.update (Function.update
      (Function.update (Function.update G tD (descA 1 (axD h bs ss) ++ X)) lfE [0]) lfB []) lfS [])
      lfB2 (NLogN.KFZ.zl bs)) lfS2 (NLogN.KFZ.zl ss) := by
    simp only [F, Gm, Nat.sub_self, List.drop_zero, List.take_zero, zl_nil, List.reverse_nil]
    rw [show nK (axD h bs ss) 0 = 1 by simp +decide [nK]]
    simp [NLogN.KFZ.eS]
  have H := Sp.rep (s := s) (C := lfC) (n := .reg rgD) (b := dtB) (F := F) (N := d) (B := B)
    (c := 100 * 10 ^ 7 * (B + 2) ^ 2) (by decide)
    (fun k => by simp +decide [F, Gm, Function.update_apply, gC]) (by decide) (clean_reg (by decide))
    (by rw [hF0]; exact ok_reg gD) trivial
    (by rw [hF0]; exact bnd_reg gD (zszS (by omega))) (by rw [hF0]; exact eval_reg gD)
    (by
      intro k hk
      set i := d - k - 1 with hi
      have hid : i < d := by omega
      have hm : d - k = i + 1 := by omega
      have hm' : d - (k + 1) = i := by omega
      have hib : i < bs.length := by omega
      have his : i < ss.length := by omega
      have hiL : i < (axD h bs ss).length := by omega
      set u := Function.update (F k) lfC [(d : ℤ) - k] with hu
      have hE1 : NLogN.KFZ.eS h bs (i + 1) = NLogN.KFZ.eS h bs i + h + bs[i] := by rw [eS_succ h bs i hib]; ring
      have uH : u rgH = (h : ℤ) :: lH := by simp +decide [hu, F, Gm, Function.update_apply, gH]
      have uE : u lfE = [((NLogN.KFZ.eS h bs i + h + bs[i] : ℕ) : ℤ)] := by
        simp +decide [hu, F, Gm, Function.update_apply, hm, hE1]
      have uB : u lfB = (bs[i] : ℤ) :: (NLogN.KFZ.zl (bs.take i)).reverse := by
        have : u lfB = (NLogN.KFZ.zl (bs.take (i + 1))).reverse := by
          simp +decide [hu, F, Gm, Function.update_apply, hm]
        rw [this, take_succ_rev bs i hib]
      have uS : u lfS = (ss[i] : ℤ) :: (NLogN.KFZ.zl (ss.take i)).reverse := by
        have : u lfS = (NLogN.KFZ.zl (ss.take (i + 1))).reverse := by
          simp +decide [hu, F, Gm, Function.update_apply, hm]
        rw [this, take_succ_rev ss i his]
      have uB2 : u lfB2 = NLogN.KFZ.zl (bs.drop (i + 1)) := by
        simp +decide [hu, F, Gm, Function.update_apply, hm]
      have uS2 : u lfS2 = NLogN.KFZ.zl (ss.drop (i + 1)) := by
        simp +decide [hu, F, Gm, Function.update_apply, hm]
      have uT : u tD = descA (nK (axD h bs ss) (i + 1)) ((axD h bs ss).drop (i + 1)) ++ X := by
        simp +decide [hu, F, Gm, Function.update_apply, hm]
      have hsi := hst i hid
      have hEB : NLogN.KFZ.eS h bs i + h + bs[i] + 4 ≤ B := by
        have := eS_mono h bs (m := i + 1) (m' := d) (by omega) (by omega)
        omega
      have K := dtB_sp s u h bs[i] ss[i] (NLogN.KFZ.eS h bs i) lH _ _ _ _ _ hsi uH uE uB uS uB2 uS2 uT B hEB
      refine K.congr ?_
      congr 1
      have hdA := descA_drop (axD h bs ss) i hiL
      rw [getElem_axD h bs ss (by omega) i hiL, hnK i (by omega)] at hdA
      simp only at hdA
      simp only [hu, F, Gm, hm']
      rw [hnK i (by omega), hdA, List.append_assoc, drop_zl bs i hib, drop_zl ss i his]
      (((funext j_m2); (simp only [Function.update_apply]);
         ((try split_ifs) <;> (try subst_vars) <;> (try simp_all +decide)))))
  rw [hF0, hFd] at H
  exact H.mono (by simp only [Ex.size]; omega)

end NLogN.KFZ

