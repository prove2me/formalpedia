section Residue

variable {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]
  {Fbar₁ : Type*} [Field Fbar₁] [Algebra (ResidueField A) Fbar₁]
  {Fbar₂ : Type*} [Field Fbar₂] [Algebra (ResidueField A) Fbar₂]

def residueFieldEquiv (C : ComponentChart A F Fbar₁) : ResidueField C.integers ≃+* Fbar₁ :=
  (Ideal.quotEquivOfEq C.ker_residue.symm).trans (RingHom.quotientKerEquivOfSurjective C.residue_surjective)

@[scoped simp] theorem residueFieldEquiv_residue (C : ComponentChart A F Fbar₁) (x : C.integers) :
    residueFieldEquiv C (IsLocalRing.residue C.integers x) = C.residue x := rfl

def integersEquivOfEq (C₁ : ComponentChart A F Fbar₁) (C₂ : ComponentChart A F Fbar₂)
    (h : C₁.integers = C₂.integers) : C₁.integers ≃+* C₂.integers where
  toFun x := ⟨x, h ▸ x.2⟩
  invFun y := ⟨y, h.symm ▸ y.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl

@[scoped simp] theorem coe_integersEquivOfEq (C₁ : ComponentChart A F Fbar₁) (C₂ : ComponentChart A F Fbar₂)
    (h : C₁.integers = C₂.integers) (x : C₁.integers) : ((integersEquivOfEq C₁ C₂ h x : C₂.integers) : F) = x := rfl

def algEquivOfIntegersEq (C₁ : ComponentChart A F Fbar₁) (C₂ : ComponentChart A F Fbar₂)
    (h : C₁.integers = C₂.integers) : Fbar₁ ≃ₐ[ResidueField A] Fbar₂ :=
  AlgEquiv.ofRingEquiv
    (f := (residueFieldEquiv C₁).symm.trans
      ((IsLocalRing.ResidueField.mapEquiv (integersEquivOfEq C₁ C₂ h)).trans (residueFieldEquiv C₂)))
    (by
      intro k
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective k
      have h₁ := C₁.residue_algebraMap a
      have h₂ := C₂.residue_algebraMap a
      rw [← h₁, RingEquiv.trans_apply, RingEquiv.trans_apply, ← residueFieldEquiv_residue, RingEquiv.symm_apply_apply,
        IsLocalRing.ResidueField.mapEquiv_apply, IsLocalRing.ResidueField.map_residue, residueFieldEquiv_residue, ← h₂]
      rfl)

theorem algEquivOfIntegersEq_residue (C₁ : ComponentChart A F Fbar₁) (C₂ : ComponentChart A F Fbar₂)
    (h : C₁.integers = C₂.integers) (x : C₁.integers) :
    algEquivOfIntegersEq C₁ C₂ h (C₁.residue x) = C₂.residue ⟨x, h ▸ x.2⟩ := by
  show ((residueFieldEquiv C₁).symm.trans
      ((IsLocalRing.ResidueField.mapEquiv (integersEquivOfEq C₁ C₂ h)).trans (residueFieldEquiv C₂))) (C₁.residue x) = _
  rw [RingEquiv.trans_apply, RingEquiv.trans_apply, ← residueFieldEquiv_residue, RingEquiv.symm_apply_apply,
    IsLocalRing.ResidueField.mapEquiv_apply, IsLocalRing.ResidueField.map_residue, residueFieldEquiv_residue]
  rfl

theorem residue_eq_algebraMap_of_sub_mem_maximalIdeal (C : ComponentChart A F Fbar₁) {f : F} (hf : f ∈ C.integers)
    (a : A) (h : ∃ h : f - algebraMap L F (a : L) ∈ C.integers, (⟨_, h⟩ : C.integers) ∈ maximalIdeal C.integers) :
    C.residue ⟨f, hf⟩ = algebraMap (ResidueField A) Fbar₁ (IsLocalRing.residue A a) := by
  obtain ⟨h1, h2⟩ := h
  have ha : algebraMap L F (a : L) ∈ C.integers := (C.algebraMap_mem_iff a).mpr a.2
  have hker : (⟨_, h1⟩ : C.integers) ∈ RingHom.ker C.residue := by rw [C.ker_residue]; exact h2
  have hsub : (⟨f - algebraMap L F (a : L), h1⟩ : C.integers) = ⟨f, hf⟩ - ⟨algebraMap L F (a : L), ha⟩ := rfl
  rw [RingHom.mem_ker, hsub, map_sub, sub_eq_zero] at hker
  rw [hker, C.residue_algebraMap]

theorem exists_residue_eq_algebraMap_of_forall_sub_mem (C : ComponentChart A F Fbar₁) {O : ValuationSubring F}
    (hO : C.integers = O) {f : F} (hf : f ∈ O) (v : ResidueField A)
    (h : ∀ a : A, IsLocalRing.residue A a = v →
      ∃ h : f - algebraMap L F (a : L) ∈ O, (⟨_, h⟩ : O) ∈ maximalIdeal O) :
    ∃ hC : f ∈ C.integers, C.residue ⟨f, hC⟩ = algebraMap (ResidueField A) Fbar₁ v := by
  subst hO
  obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective v
  exact ⟨hf, residue_eq_algebraMap_of_sub_mem_maximalIdeal C hf a (h a rfl)⟩

end Residue

section Arithmetic

theorem genus_identity_of_closed_forms {PL ι : Type*} [Fintype PL] [Fintype ι]
    (q w gF gIg : ℕ) (gI : PL → ℕ) (g e : ι → ℕ)
    (hPL : Fintype.card PL = q + 1) (hw : Fintype.card ι = w)
    (hIg : ∀ ℓ, gI ℓ = gIg) (he : ∀ s, 1 ≤ e s)
    (hSS : ∀ s, 2 * e s * (2 * g s + q) + 1 = q ^ 2 + 2 * e s)
    (μ : ℚ) (hmass : ∑ s, (1 / (e s : ℚ)) = μ)
    (hF : (gF : ℚ) = (q + 1) * gIg + (q ^ 2 - 1) / 4 * μ + (q + 1) / 2 * w - q) :
    gF + (q + 1) + w = ∑ ℓ, gI ℓ + ∑ s, g s + (q + 1) * w + 1 := by

  have hsumI : ∑ ℓ, gI ℓ = (q + 1) * gIg := by
    rw [Finset.sum_congr rfl (fun ℓ _ => hIg ℓ), Finset.sum_const, Finset.card_univ, hPL, smul_eq_mul]

  have hg : ∀ s, (g s : ℚ) = (q ^ 2 - 1) / 4 * (1 / (e s : ℚ)) - (q - 1) / 2 := by
    intro s
    have hes : (e s : ℚ) ≠ 0 := by exact_mod_cast (Nat.one_le_iff_ne_zero.mp (he s))
    have h := hSS s
    have h' : (2 * (e s : ℚ) * (2 * g s + q) + 1 = (q : ℚ) ^ 2 + 2 * e s) := by exact_mod_cast h
    have h4 : (g s : ℚ) = ((q : ℚ) ^ 2 - 1 - 2 * (q - 1) * e s) / (4 * e s) := by
      rw [eq_div_iff (mul_ne_zero four_ne_zero hes)]
      linear_combination h'
    rw [h4]
    field_simp
    ring
  have hsumS : (∑ s, (g s : ℚ)) = (q ^ 2 - 1) / 4 * μ - (q - 1) / 2 * w := by
    rw [Finset.sum_congr rfl (fun s _ => hg s), Finset.sum_sub_distrib, ← Finset.mul_sum, hmass, Finset.sum_const,
      Finset.card_univ, hw, nsmul_eq_mul]
    ring

  have key : ((gF + (q + 1) + w : ℕ) : ℚ) = ((∑ ℓ, gI ℓ + ∑ s, g s + (q + 1) * w + 1 : ℕ) : ℚ) := by
    rw [hsumI]
    push_cast
    rw [hsumS, hF]
    ring
  exact_mod_cast key

end Arithmetic

