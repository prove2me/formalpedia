    rw [COMB_eq]; exact digit_sum e (fun _ => 1) 6806 (fun _ => by norm_num) he
  have h2 := and_digit M COMB e
  rw [hM, h1, Nat.and_one_is_mod] at h2
  have h3 : M.testBit (13 * e) = decide (M / 2 ^ (13 * e) % 2 = 1) :=
    Nat.testBit_eq_decide_div_mod_eq
  rw [h3, ← pow8192]
  have h4 : M / 8192 ^ e % 8192 % 2 = M / 8192 ^ e % 2 := Nat.mod_mod_of_dvd _ (by norm_num)
  split_ifs with h <;> simp at h <;> omega

theorem prod_expand (x μ : ℕ → ℕ) (mK mP : ℕ) :
    (∑ i ∈ range mK, x i * 8192 ^ i) * (∑ j ∈ range mP, μ j * 8192 ^ j) =
      ∑ e ∈ range (mK + mP),
        (∑ q ∈ (range mK ×ˢ range mP) with q.1 + q.2 = e, x q.1 * μ q.2) * 8192 ^ e := by
  rw [Finset.sum_mul_sum, ← Finset.sum_product',
    ← Finset.sum_fiberwise_of_maps_to (g := fun q : ℕ × ℕ => q.1 + q.2) (t := range (mK + mP))]
  · refine Finset.sum_congr rfl fun e _ => ?_
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun q hq => ?_
    rw [← (Finset.mem_filter.1 hq).2]; ring
  · intro q hq
    simp only [Finset.mem_product, Finset.mem_range] at hq ⊢
    omega

theorem coef_ge (x μ : ℕ → ℕ) (mK mP k t : ℕ) (hk : k < mK) (ht : t < mP) :
    x k * μ t ≤ ∑ q ∈ (range mK ×ˢ range mP) with q.1 + q.2 = k + t, x q.1 * μ q.2 := by
  have hmem : (k, t) ∈ (range mK ×ˢ range mP).filter (fun q : ℕ × ℕ => q.1 + q.2 = k + t) := by
    rw [Finset.mem_filter, Finset.mem_product, Finset.mem_range, Finset.mem_range]
    exact ⟨⟨hk, ht⟩, rfl⟩
  exact Finset.single_le_sum (f := fun q : ℕ × ℕ => x q.1 * μ q.2) (fun _ _ => Nat.zero_le _) hmem

theorem coef_le (x μ : ℕ → ℕ) (hx : ∀ i, x i ≤ 1) (hμ : ∀ i, μ i ≤ 1) (mK mP e : ℕ) :
    ∑ q ∈ (range mK ×ˢ range mP) with q.1 + q.2 = e, x q.1 * μ q.2 ≤ mP := by
  calc ∑ q ∈ (range mK ×ˢ range mP) with q.1 + q.2 = e, x q.1 * μ q.2
      ≤ ∑ q ∈ (range mK ×ˢ range mP) with q.1 + q.2 = e, 1 := by
        refine Finset.sum_le_sum fun q _ => ?_
        calc x q.1 * μ q.2 ≤ 1 * 1 := Nat.mul_le_mul (hx _) (hμ _)
          _ = 1 := rfl
    _ = ((range mK ×ˢ range mP).filter (fun q => q.1 + q.2 = e)).card := by simp
    _ ≤ (range mP).card := by
        refine Finset.card_le_card_of_injOn Prod.snd ?_ ?_
        · intro q hq
          simp only [Finset.coe_filter, Finset.mem_product, Finset.mem_range, Set.mem_ofPred_eq] at hq
          simpa using hq.1.2
        · intro q hq q' hq'
          simp only [Finset.coe_filter, Finset.mem_product, Finset.mem_range, Set.mem_ofPred_eq] at hq hq'
          intro h
          have h' : q.2 = q'.2 := h
          ext
          · omega
          · exact h'
    _ = mP := by simp

theorem lt_of_testBit (X k m : ℕ) (hX : X < 8192 ^ m) (hk : X.testBit (13 * k) = true) : k < m := by
  by_contra h
  have h1 : X < 2 ^ (13 * k) := by
    refine lt_of_lt_of_le hX ?_
    rw [pow8192]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
  rw [Nat.testBit_lt_two_pow h1] at hk
  exact absurd hk (by simp)

/-- If `X` has field `k` set and `M` has field `t` set, the field `k + t` of the product is
nonzero, so its flag bit survives the shift. -/
theorem survive (X M k t e : ℕ) (hX : X &&& COMB = X) (hM : M &&& COMB = M)
    (hXlt : X < 8192 ^ 4510) (hMlt : M < 8192 ^ 2296)
    (hk : X.testBit (13 * k) = true) (ht : M.testBit (13 * t) = true) (hkt : k + t = e + 2241) :
    ((X * M + MADD) >>> 29145).testBit (13 * e) = true := by
  have hk' := lt_of_testBit X k _ hXlt hk
  have ht' := lt_of_testBit M t _ hMlt ht
  set x : ℕ → ℕ := fun i => if X.testBit (13 * i) = true then 1 else 0 with hx
  set μ : ℕ → ℕ := fun i => if M.testBit (13 * i) = true then 1 else 0 with hμ
  have hXe : X = ∑ i ∈ range 4510, x i * 8192 ^ i := by
    conv_lhs => rw [base_expand 4510 X hXlt]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [digit_of_clean X i hX (by have := Finset.mem_range.1 hi; omega)]
  have hMe : M = ∑ i ∈ range 2296, μ i * 8192 ^ i := by
    conv_lhs => rw [base_expand 2296 M hMlt]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [digit_of_clean M i hM (by have := Finset.mem_range.1 hi; omega)]
  set c : ℕ → ℕ := fun e => ∑ q ∈ (range 4510 ×ˢ range 2296) with q.1 + q.2 = e, x q.1 * μ q.2
    with hc
  have hprod : X * M = ∑ e ∈ range 6806, c e * 8192 ^ e := by
    conv_lhs => rw [hXe, hMe]
    exact prod_expand x μ 4510 2296
  have hx1 : ∀ i, x i ≤ 1 := fun i => by simp only [hx]; split_ifs <;> simp
  have hμ1 : ∀ i, μ i ≤ 1 := fun i => by simp only [hμ]; split_ifs <;> simp
  have hcle : ∀ e, c e ≤ 2296 := fun e => coef_le x μ hx1 hμ1 4510 2296 e
  have hc1 : 1 ≤ c (k + t) := by
    have hxk : x k = 1 := by simp [hx, hk]
    have hμt : μ t = 1 := by simp [hμ, ht]
    have h1 := coef_ge x μ 4510 2296 k t hk' ht'
    rw [hxk, hμt] at h1
    exact h1
  have hY : X * M + MADD = ∑ e ∈ range 6806, (c e + 4095) * 8192 ^ e := by
    rw [hprod, MADD_eq, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun e _ => ?_
    ring
  have hdig : (X * M + MADD) / 8192 ^ (k + t) % 8192 = c (k + t) + 4095 := by
    rw [hY]
    exact digit_sum (k + t) (fun e => c e + 4095) 6806 (fun e => by have := hcle e; omega) (by omega)
  rw [Nat.testBit_shiftRight, Nat.testBit_eq_decide_div_mod_eq]
  have he : 29145 + 13 * e = 13 * (k + t) + 12 := by omega
  rw [he, pow_add, ← pow8192, ← Nat.div_div_eq_div_mul]
  have := hcle (k + t)
  simp only [decide_eq_true_eq]
  generalize (X * M + MADD) / 8192 ^ (k + t) = z at hdig
  omega

