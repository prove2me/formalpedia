-- title:
--   §2.2 — the SVT iterates $Y^k$ vanish outside $\Omega$
-- statement:
--   Let $\tau>0$, let $\{\delta_k\}_{k\ge1}$ be positive step sizes, and let $(X^k, Y^k)$ be generated by the SVT iteration (2.7) from $Y^0=0$:
--   $$X^k=\mathcal D_\tau(Y^{k-1}),\qquad Y^k=Y^{k-1}+\delta_kP_\Omega(M-X^k).$$
--   Then for every $k\ge0$,
--   $$Y^k=P_\Omega(Y^k),$$
--   i.e. $Y^k$ vanishes outside $\Omega$.
--
--   This sparsity is used in the paper both computationally and to identify (2.7) with Uzawa's algorithm, where the minimizer $\mathcal D_\tau(P_\Omega(Y^{k-1}))$ of the Lagrangian reduces to $\mathcal D_\tau(Y^{k-1})$.
-- source:
--   Cai, Candès, Shen, A Singular Value Thresholding Algorithm for Matrix Completion, SIAM J. Optim. 20 (2010), p. 1961, §2.2 (Sparsity); also p. 1964 ('since Y^k = P_Ω(Y^k) for all k ≥ 0')

import Mathlib
import Definitions.Def_CaiCandesShen_Convergence_Iterations

namespace CaiCandesShen.Convergence

/-- §2.2, p. 1961 (Sparsity): since `Y⁰ = 0`, every iterate `Y^k` of (2.7) vanishes outside `Ω`,
i.e. `Y^k = P_Ω(Y^k)` for all `k ≥ 0`. -/
theorem svt_iterate_supported_on_omega {n₁ n₂ : ℕ} (τ : ℝ) (hτ : 0 < τ)
    (Ω : Finset (Fin n₁ × Fin n₂)) (M : Mat n₁ n₂) (δ : ℕ → ℝ) (hδ : ∀ k, 1 ≤ k → 0 < δ k)
    (X Y : ℕ → Mat n₁ n₂) (hXY : IsSVTSeq τ Ω M δ X Y) :
    ∀ k : ℕ, projΩ Ω (Y k) = Y k := by sorry

end CaiCandesShen.Convergence
