  -- step 2
  have saT : sa.G gZT = (gints x).reverse ++ t.G gZT := by simp [hsa]
  have san : sa.G ax.rn = .int ax.n :: Ln := by
    simp [hsa, rn1, notW rn1 |>.1, (notW rn1).2.2.2.2.2.2.1, tn]
