theorem J6Seg.blkI_err {T : Tables} {a n : ℕ} {E B Dm : ℝ} (hα : 2 ≤ α) (hσ : 1 ≤ σ)
    (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2) (hT : BlkTab P α σ b T a n E)
    (hE : 0 ≤ E) (hB : 0 ≤ B) (hDm : ∀ u < n, ddR α σ u ≤ Dm)
    (hP : 8 * (((n : ℝ) + 1) * E + 1) * (B + 1) ≤ 2 ^ P)
    (z : ℕ → ℤ) (hz : ∀ u < n, |(z u : ℝ) / 2 ^ P| ≤ B) :
    ∀ u < n, |(blkI P T a n z u : ℝ) / 2 ^ P - blkE α σ b n (fun k => (z k : ℝ) / 2 ^ P) u| ≤
      9 * Dm * (((n : ℝ) + 1) * E + 1) * (B + 1) / 2 ^ P := by sorry
