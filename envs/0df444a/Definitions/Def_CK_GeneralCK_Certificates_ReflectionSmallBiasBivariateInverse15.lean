theorem inversePower15_eval (k : ℂ) (z : ℂ × ℂ) :
    eval k (mulTrunc 24 (parameter (-15)) inverseSum15) z = eval k inversePower15 z := by
  have he := eval_eq_of_degrees 24 k inversePower15_raw inversePower15 z
    (degreeBound_sound inversePower15_raw_bound) (degreeBound_sound inversePower15_result_bound)
    inversePower15_degrees
  change eval k (normalize inversePower15_raw) z = eval k inversePower15 z
  rw [eval_normalize]
  exact he

theorem inversePower15_approximates {k : ℂ} (hk : k ≠ 0) (hklog : k = (Real.log 2:ℂ)) :
    Approximates 24 k (fun z => ((meanFunction z)⁻¹)^15) inversePower15 := by
  have h23 := (lossPower23_approximates hk hklog).scale (6107086800 : ℚ)
  have h22 := ((lossPower22_approximates hk hklog).scale (3796297200 : ℚ)).addAppend h23
  have h21 := ((lossPower21_approximates hk hklog).scale (2319959400 : ℚ)).addAppend h22
  have h20 := ((lossPower20_approximates hk hklog).scale (1391975640 : ℚ)).addAppend h21
  have h19 := ((lossPower19_approximates hk hklog).scale (818809200 : ℚ)).addAppend h20
  have h18 := ((lossPower18_approximates hk hklog).scale (471435600 : ℚ)).addAppend h19
  have h17 := ((lossPower17_approximates hk hklog).scale (265182525 : ℚ)).addAppend h18
  have h16 := ((lossPower16_approximates hk hklog).scale (145422675 : ℚ)).addAppend h17
  have h15 := ((lossPower15_approximates hk hklog).scale (77558760 : ℚ)).addAppend h16
  have h14 := ((lossPower14_approximates hk hklog).scale (40116600 : ℚ)).addAppend h15
  have h13 := ((lossPower13_approximates hk hklog).scale (20058300 : ℚ)).addAppend h14
  have h12 := ((lossPower12_approximates hk hklog).scale (9657700 : ℚ)).addAppend h13
  have h11 := ((lossPower11_approximates hk hklog).scale (4457400 : ℚ)).addAppend h12
  have h10 := ((lossPower10_approximates hk hklog).scale (1961256 : ℚ)).addAppend h11
  have h9 := ((lossPower9_approximates hk hklog).scale (817190 : ℚ)).addAppend h10
  have h8 := ((lossPower8_approximates hk hklog).scale (319770 : ℚ)).addAppend h9
  have h7 := ((lossPower7_approximates hk hklog).scale (116280 : ℚ)).addAppend h8
  have h6 := ((lossPower6_approximates hk hklog).scale (38760 : ℚ)).addAppend h7
  have h5 := ((lossPower5_approximates hk hklog).scale (11628 : ℚ)).addAppend h6
  have h4 := ((lossPower4_approximates hk hklog).scale (3060 : ℚ)).addAppend h5
  have h3 := ((lossPower3_approximates hk hklog).scale (680 : ℚ)).addAppend h4
  have h2 := ((lossPower2_approximates hk hklog).scale (120 : ℚ)).addAppend h3
  have h1 := ((lossPower1_approximates hk hklog).scale (15 : ℚ)).addAppend h2
  have h0 := ((lossPower0_approximates hk hklog).scale (1 : ℚ)).addAppend h1
  have hraw := h0.replacePolynomial (inverseSum15_eval k)
  have ht : Approximates 24 k (fun z => eval k seed15 (lossFunction k z,0)) inverseSum15 := by
    convert hraw using 1
    funext z
    norm_num [seed15,eval,evalTerm]
    <;> ring
  have hu := (loss_approximates hk hklog).comp_finite (Approximates.const 24 k 0)
    (loss_zero hk hklog) (by simp) (seed15_approximates hk) ht
  have hh := ((Approximates.parameter 24 k (-15)).mul hk hu).replacePolynomial
    (inversePower15_eval k)
  convert hh using 1
  funext z
  rw [mean_inverse_eq hk, mul_pow]
  simp only [Rat.cast_zero,zpow_neg,zpow_natCast,inv_pow] <;> rfl

