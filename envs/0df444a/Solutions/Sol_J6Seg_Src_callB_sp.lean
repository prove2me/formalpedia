namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg.PreT J6Seg IntMul.HvdH

section es
variable (F : Fin HS → List ℤ) (a16 a17 a18 a19 a27 a44 v : List ℤ)

theorem eS_self : eS F (F 16) (F 17) (F 18) (F 19) (F 27) (F 44) = F := by
  simp only [eS, update_eq_self]
theorem eS_other {r : Fin HS} (h : r ≠ 16 ∧ r ≠ 17 ∧ r ≠ 18 ∧ r ≠ 19 ∧ r ≠ 27 ∧ r ≠ 44) :
    eS F a16 a17 a18 a19 a27 a44 r = F r := by
  obtain ⟨h1, h2, h3, h4, h5, h6⟩ := h
  simp [eS, update_apply, h1, h2, h3, h4, h5, h6]
end es

theorem eS_upd_F (F : Fin HS → List ℤ) (v : List ℤ) :
    update F 44 v = eS F (F 16) (F 17) (F 18) (F 19) (F 27) v := by
  have := eS_upd_44 F (F 16) (F 17) (F 18) (F 19) (F 27) (F 44) v
  rwa [eS_self] at this

theorem CIn.tr {s0 : IState HS} {F : Fin HS → List ℤ} {A : ℕ} {e : Ex HS} {v : ℤ}
    (h : CIn s0 F A e v) (a16 a17 a18 a19 a27 a44 : List ℤ) :
    CIn s0 (eS F a16 a17 a18 a19 a27 a44) A e v := by
  have hG : ∀ r ∈ e.regs, (encK s0 F).G r = (encK s0 (eS F a16 a17 a18 a19 a27 a44)).G r :=
    fun r hr => by simp only [encK_G, eS_other F a16 a17 a18 a19 a27 a44 (h.reg r hr).2]
  refine ⟨h.reg, (NLogN.KFD.ok_congr e hG).1 h.ok, (NLogN.KFD.eval_congr e hG).symm.trans h.ev,
    fun r hr => ?_, h.poly, h.dg⟩
  rw [← NLogN.KFD.top_congr (hG r hr)]; exact h.rb r hr

theorem CIn.zsz {s0 : IState HS} {F : Fin HS → List ℤ} {A : ℕ} {e : Ex HS} {v : ℤ}
    (h : CIn s0 F A e v) (hA : 2 ≤ A) : zsz v ≤ A * DD + 1 := by
  rw [← h.ev]; exact Ex.zsz_eval_le _ _ _ (bnd_P h.rb hA h.poly h.dg)

theorem pushC {s0 : IState HS} {F : Fin HS → List ℤ} {A : ℕ} {e : Ex HS} {v : ℤ}
    (h : CIn s0 F A e v) {i : Fin HS} (hi : i.val < 56) (hA : 2 ≤ A) :
    Sp (.push i e) (encK s0 F) (encK s0 (update F i (v :: F i))) ((e.size + 1) * uC A DD) :=
  pushP s0 F hi (fun r hr => (h.reg r hr).1) h.ok h.ev h.rb hA h.poly h.dg

theorem popZ (s : IState HS) (G : Fin HS → List ℤ) {i : Fin HS} {a : ℤ} {l : List ℤ} {A : ℕ}
    (hi : i.val < 56) (hf : G i = a :: l) (ha : zsz a ≤ A * DD + 1) :
    Sp (.pop i) (encK s G) (encK s (update G i l)) (uC A DD) :=
  (Sp.pop s G hi hf ha).mono (by have := uC_ge A DD; omega)

theorem expPosCost_mono {n a b a' b' σ : ℕ} (ha : a ≤ a') (hb : b ≤ b') :
    expPosCost n a b σ ≤ expPosCost n a' b' σ := by
  unfold expPosCost
  exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) _)

/-- **The call of `expPosP`.** -/
theorem callB_sp_sol_aux (s0 : IState HS) (F : Fin HS → List ℤ) {e16 e17 e18 e27 : Ex HS}
    {n k jj σ A : ℕ} (hA : 2 ≤ A) (c16 : CIn s0 F A e16 n) (c17 : CIn s0 F A e17 k)
    (c18 : CIn s0 F A e18 jj) (c27 : CIn s0 F A e27 σ) (hvA : |expPos n k jj σ| ≤ 2 ^ A) :
    Sp (callB e16 e17 e18 e27) (encK s0 F) (encK s0 (update F 44 (expPos n k jj σ :: F 44)))
      ((e16.size + e17.size + e18.size + e27.size + 12) * uC A DD +
