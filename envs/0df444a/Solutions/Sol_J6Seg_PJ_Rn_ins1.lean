  simp (config := {decide := true}) only [RS.run_push_G, RS.run_pop_G, IState.upd_G, Ex.eval,
    IState.top, h16, h17, h18, if_true, if_false, List.tail_cons, Ex.ediv_eval, m10E, xNegE,
    Int.toNat_natCast, e10]
