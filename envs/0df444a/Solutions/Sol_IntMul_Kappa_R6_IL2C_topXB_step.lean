theorem le_of_eq_mul {a b c : ℕ} (h : b = a * c) (hc : 0 < c) : a ≤ b := by
  rw [h]; exact Nat.le_mul_of_pos_right _ hc

theorem Lay.OK.yq_le {l : Lay} (h : l.OK) : l.sY * l.QL ≤ l.M := by
  obtain ⟨kM, hkM, eM⟩ := h.kMT; obtain ⟨b, hb, eb⟩ := h.kTY
  exact le_of_eq_mul (c := b * l.QC * kM) (by rw [eM, eb]; ring) (by have := h.qc; positivity)

theorem Lay.OK.xq_le {l : Lay} (h : l.OK) : l.sX * l.QL ≤ l.M := by
  obtain ⟨kM, hkM, eM⟩ := h.kMT; obtain ⟨b, hb, eb⟩ := h.kTX
  exact le_of_eq_mul (c := b * l.QC * kM) (by rw [eM, eb]; ring) (by have := h.qc; positivity)

theorem TopOK.xM {l : Lay} {L q Br : ℕ} (h : TopOK l L q Br) :
    ∃ P, 0 < P ∧ l.M = P * 2 * (l.sX * 2 ^ q) := by
  obtain ⟨kM, hkM, eM⟩ := h.ok.kMT
  obtain ⟨b, hb, eb⟩ := h.ok.kTX
  have hQ := h.ql
  have e : l.QL = 2 * 2 ^ q * 2 ^ (L - q - 1) := by
    rw [hQ, ← pow_succ', ← pow_add]; congr 1; have := h.hq; omega
  refine ⟨2 ^ (L - q - 1) * b * l.QC * kM, by have := h.ok.qc; positivity, ?_⟩
  rw [eM, eb, e]; ring

/-- `eTP r` evaluates to `M / (2 S 2^q)` for the stride `S` on `r`. -/
theorem eTP_sp {t : IState HS} (hE : CEnv t l K ρ G n q Br fl) {rS : Fin HS} {S : ℕ}
    (hS : ∃ L, t.G rS = .int (S : ℤ) :: L) (hr : rS.val < 56) {Bb : ℕ}
    (hBb : Bb = zsz ((l.M * Br : ℕ) : ℤ) + 3) (hBr : 1 ≤ Br) (hS0 : 0 < S)
    (hSM : 2 * (S * 2 ^ q) ≤ l.M) :
    ESp (eTP rS) t Bb ((l.M / (2 * (S * 2 ^ q)) : ℕ) : ℤ) := by
  obtain ⟨LM, hM⟩ := hE.m
  obtain ⟨LS, hS'⟩ := hS
  obtain ⟨LJ, hJ⟩ := hE.j2
  have hMV : l.M ≤ l.M * Br := Nat.le_mul_of_pos_right _ hBr
  have hS1 : S ≤ S * 2 ^ q := Nat.le_mul_of_pos_right _ (by positivity)
  have hJ1 : 2 ^ q ≤ S * 2 ^ q := Nat.le_mul_of_pos_left _ hS0
  have hdl := Nat.div_le_self l.M (2 * (S * 2 ^ q))
  have a1 := ESp.ofG' hM (by decide) (zsz_le_of hBb (by omega))
  have a2 := ESp.ofG' hS' hr (zsz_le_of hBb (by omega))
  have a3 := ESp.ofG' hJ (by decide) (zsz_le_of hBb (by omega))
  have a4 := ESp.mulN a2 a3 (zsz_le_of hBb (by omega))
  have l2 : ESp (.lit 2) t Bb ((2 : ℕ) : ℤ) :=
    ESp.of_eq (ESp.lit (by simpa using zsz_le_of hBb (z := 2) (by omega))) (by norm_num)
  have a5 := ESp.mulN l2 a4 (zsz_le_of hBb (by omega))
  exact ESp.ndivN a1 a5 (by positivity) (zsz_le_of hBb (by omega))

theorem eTB_sp {t : IState HS} (hE : CEnv t l K ρ G n q Br fl) {rS : Fin HS} {S : ℕ}
    (hS : ∃ L, t.G rS = .int (S : ℤ) :: L) (hr : rS.val < 56) {Bb : ℕ}
    (hBb : Bb = zsz ((l.M * Br : ℕ) : ℤ) + 3) (hBr : 1 ≤ Br) (hS0 : 0 < S) (hSM : S * 2 ^ q ≤ l.M) :
    ESp (eTB rS) t Bb ((S * 2 ^ q * Br : ℕ) : ℤ) := by
  obtain ⟨LS, hS'⟩ := hS
  obtain ⟨LJ, hJ⟩ := hE.j2
  obtain ⟨LB, hB⟩ := hE.br
  have hb1 : S * 2 ^ q * Br ≤ l.M * Br := Nat.mul_le_mul_right _ hSM
  have hMV : l.M ≤ l.M * Br := Nat.le_mul_of_pos_right _ hBr
  have hS1 : S ≤ S * 2 ^ q := Nat.le_mul_of_pos_right _ (by positivity)
  have hJ1 : 2 ^ q ≤ S * 2 ^ q := Nat.le_mul_of_pos_left _ hS0
  have hM1 : 1 ≤ l.M := le_trans (Nat.mul_pos hS0 (by positivity)) hSM
  have hBM : Br ≤ l.M * Br := Nat.le_mul_of_pos_left _ hM1
  have a2 := ESp.ofG' hS' hr (zsz_le_of hBb (by omega))
  have a3 := ESp.ofG' hJ (by decide) (zsz_le_of hBb (by omega))
  have a4 := ESp.mulN a2 a3 (zsz_le_of hBb (by omega))
  have a5 := ESp.ofG' hB (by decide) (zsz_le_of hBb (by omega))
  exact ESp.mulN a4 a5 (zsz_le_of hBb (by omega))

theorem TopOK.e2L {l : Lay} {L q Br : ℕ} (hT : TopOK l L q Br) :
    l.QL = 2 * 2 ^ q * 2 ^ (L - q - 1) := by
  rw [hT.ql, ← pow_succ', ← pow_add]; congr 1; have := hT.hq; omega

theorem TopOK.s2 {l : Lay} {L q Br : ℕ} (hT : TopOK l L q Br) (S : ℕ) :
    2 * (S * 2 ^ q) ≤ S * l.QL := by
  rw [hT.e2L]
  calc 2 * (S * 2 ^ q) = S * (2 * 2 ^ q) * 1 := by ring
    _ ≤ S * (2 * 2 ^ q) * 2 ^ (L - q - 1) := Nat.mul_le_mul_left _ Nat.one_le_two_pow
    _ = _ := by ring

theorem TopOK.L1 {l : Lay} {L q Br : ℕ} (hT : TopOK l L q Br) : l.QL = 2 * 2 ^ (L - 1) := by
  rw [hT.ql, ← pow_succ']; congr 1; have := hT.hq; omega

/-- **The lower bit flipped by the upper bit** (`X` below `Y`, after the swap). -/
theorem topXB_step_sol_aux (hT : TopOK l L q Br) {k : ℕ} (hk : 0 < k) (hYX : l.sY = l.sX * l.QL * k) :
    RecStep I tab (xorU (eTP kSX) (eTB kSX) eTm (.lit 2) (.lit 1)) (fun t => CEnv t l K ρ G n q Br fl)
      l.M Br (rotP 2 (l.sX * 2 ^ q) (xorA (2 ^ (L - 1) * k) 2 0))
      (cXorU (l.M / (2 * (l.sX * 2 ^ q))) (l.sX * 2 ^ q * Br) 1 (zsz ((l.M * Br : ℕ) : ℤ) + 3) : ℕ) := by
  intro t recs R0 ht hl hb h0
  set Bb := zsz ((l.M * Br : ℕ) : ℤ) + 3 with hBb
  have hOK := hT.ok
  have pY := hOK.pY
  have pX := hOK.pX
  have hBr := hT.br
  obtain ⟨P, hP, eM⟩ := hT.xM
  set S := l.sX * 2 ^ q with hSd
  set Mid := 2 ^ (L - 1) * k with hMidd
  have hMid0 : 0 < Mid := by positivity
  have hS0 : 0 < S := by positivity
  have eY : l.sY = Mid * 2 * l.sX := by rw [hYX, hT.L1, hMidd]; ring
  have hPM : l.M / (2 * S) = P := by
    rw [eM, show P * 2 * S = (2 * S) * P by ring, Nat.mul_div_cancel_left _ (by positivity)]
  have hMd : l.sY / (2 * l.sX) = Mid := by
    rw [eY, show Mid * 2 * l.sX = (2 * l.sX) * Mid by ring, Nat.mul_div_cancel_left _ (by positivity)]
  have hMV : l.M ≤ l.M * Br := Nat.le_mul_of_pos_right _ hBr
  have h2X : 2 * S ≤ l.M := le_trans (hT.s2 _) hOK.xq_le
  have hYM : l.sY ≤ l.M := le_trans (Nat.le_mul_of_pos_right _ hOK.ql) hOK.yq_le
  have hXM : l.sX ≤ l.M := le_trans (Nat.le_mul_of_pos_right _ hOK.ql) hOK.xq_le
  have hMidM : Mid ≤ l.M := by rw [← hMd]; have := Nat.div_le_self l.sY (2 * l.sX); omega
  obtain ⟨LX, hX⟩ := ht.key.sx
  obtain ⟨LY, hY⟩ := ht.key.sy
  have E1 := eTP_sp ht ht.key.sx (by decide) hBb hBr pX h2X
  rw [hPM] at E1
  have E2 := eTB_sp ht ht.key.sx (by decide) hBb hBr pX (by omega)
  have l2 : ESp (.lit 2) t Bb ((2 : ℕ) : ℤ) :=
    ESp.of_eq (ESp.lit (by simpa using zsz_le_of hBb (z := 2) (by omega))) (by norm_num)
  have E3 : ESp eTm t Bb (Mid : ℤ) := by
    rw [← hMd]
    exact ESp.ndivN (ESp.ofG' hY (by decide) (zsz_le_of hBb (by omega)))
      (ESp.mulN l2 (ESp.ofG' hX (by decide) (zsz_le_of hBb (by omega))) (zsz_le_of hBb (by omega)))
      (by positivity) (zsz_le_of hBb (by omega))
  have E5 : ESp (.lit 1) t Bb ((2 : ℤ) ^ 0) :=
    ESp.of_eq (ESp.lit (by simpa using zsz_le_of hBb (z := 1) (by omega))) (by norm_num)
  have hlen : (flR recs l.M).length = P * 2 * (S * Br) := by rw [length_flR hl, eM]; ring
  have W := xorU_runs (I := I) (iprog := tab) (d := Mid) (Q := 2) (j := 0) hMid0 (by norm_num)
    (by omega) (zsz_le_of hBb (by omega)) (by simpa using zsz_le_of hBb (z := 2) (by omega))
    (by simpa using zsz_le_of hBb (z := 1) (by omega))
    P (S * Br) 1 (zsz_le_of hBb (by rw [← hPM]; have := Nat.div_le_self l.M (2 * S); omega))
    t (flR recs l.M) R0 hlen (bnd_bits (bits_flR hb _)) h0 (by decide)
    (by unfold NoLow; decide) (by unfold NoLow; decide) (by unfold NoLow; decide)
    (by unfold NoLow; decide) (by unfold NoLow; decide) E1 E2 E3 l2 E5
  rw [show flR recs l.M = flR recs (P * 2 * S) by rw [eM], rot_flR (by norm_num) hS0 hBr _ hl,
    ← eM] at W
  exact ⟨_, W, by rw [hPM]⟩

