-- title:
--   Proof of Theorem 4.3, p. 14 — (x_k) is bounded and ‖x_k − x_{k+1}‖ → 0
-- statement:
--   Let $H$ be a real inner product space, $A:H\rightrightarrows H$ monotone with resolvents $J_{\gamma A}$ ($\gamma>0$), and $B:H\to H$ monotone with $(A+B)^{-1}(0)\neq\varnothing$. Let $L>0$, $\alpha\in[0,1)$, $\beta\in(0,1]$, $\lambda>0$, and suppose either
--
--   1. $B$ is $L$-Lipschitz and $\lambda<\min\Big\{\dfrac{2-\beta-\alpha\beta-2\alpha}{2L},\dfrac{1-\alpha-\alpha\beta}{\beta L}\Big\}$, or
--   2. $B$ is $\tfrac1L$-cocoercive, $\alpha<\dfrac{2-\beta}{2+\beta}$ and $\lambda<\min\Big\{\dfrac{2-\beta-\alpha\beta+2\alpha}{2L},\dfrac{1-\alpha+\alpha\beta}{\beta L}\Big\}$.
--
--   Let $(x_k)$, $(z_k)$ be generated by the relaxed inertial scheme (34) from arbitrary $x_0,x_{-1}\in H$. Then $(x_k)$ is bounded and
--
--   $$\lim_{k\to\infty}\|x_k-x_{k+1}\|=0 .$$
--
--   These are the two facts from which, as in Theorem 2.5, weak convergence to a zero of $A+B$ is derived.
--
--   **Formalization Note.** Index shift as throughout (`x j` is $x_{j-1}$); neither conclusion is affected by it. $A$ is only assumed monotone and $H$ need not be complete. $L>0$ is assumed because the bounds divide by $L$.
-- source:
--   Malitsky & Tam, A Forward-Backward Splitting Method for Monotone Inclusions Without Cocoercivity, arXiv:1808.04162v4, p. 14, proof of Theorem 4.3

import Mathlib
import Definitions.Def_ThreeOpSplitting_Accel_MonotoneOperators
import Definitions.Def_FRBSplitting_Inertial_Setting
open InnerProductSpace ThreeOpSplitting.Accel

namespace FRBSplitting.Inertial

theorem bounded_and_steps_vanish {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H → Set H) (B : H → H) (J : ℝ → H → H) (L α β lam : ℝ)
    (hA : IsMonotoneOp A)
    (hJ : IsResolventFamily A J)
    (hBm : IsMonotoneFun B)
    (hzer : (FRBSplitting.Weak.zeroSet A B).Nonempty)
    (hα0 : 0 ≤ α) (hα1 : α < 1) (hβ0 : 0 < β) (hβ1 : β ≤ 1) (hlam : 0 < lam) (hL : 0 < L)
    (hcase : (IsLipschitzOp L B ∧
        lam < min ((2 - β - α * β - 2 * α) / (2 * L)) ((1 - α - α * β) / (β * L))) ∨
      (IsCocoercive L⁻¹ B ∧ α < (2 - β) / (2 + β) ∧
        lam < min ((2 - β - α * β + 2 * α) / (2 * L)) ((1 - α + α * β) / (β * L))))
    (x z : ℕ → H) (hrun : IsRelaxedInertialRun J B α β lam x z) :
    Bornology.IsBounded (Set.range x) ∧
      Filter.Tendsto (fun k => ‖x k - x (k + 1)‖) Filter.atTop (nhds 0) := by sorry

end FRBSplitting.Inertial
