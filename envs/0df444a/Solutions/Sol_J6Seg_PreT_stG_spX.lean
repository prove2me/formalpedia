/-!
# B-line IL, pre-tables (B5), part 6: the call loop

`cLoop O cl` = `U := 0; repeat N = v 24 times { cl; push X on O; U := U + 1 }` where the call `cl`
sets `X = v 11 := f U`. `cLoop_sp`: it pushes `f 0, …, f (N-1)` onto `O` (so `O` gains `rv f N`);
the registers end as `wS v f N` (only `11, 12` change).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

theorem VB_upd {v : Fin HS → ℤ} {A : ℕ} (h : VB v A) (j : Fin HS) {a : ℤ} (ha : |a| ≤ 2 ^ A) :
    VB (Function.update v j a) A := by
  intro i hi
  by_cases e : i = j
  · subst e; simpa using ha
  · rw [Function.update_of_ne e]; exact h i hi

theorem mgB {A : ℕ} (hA : 2 ≤ A) {e : Ex HS} (hp : Poly e = true) (hd : dg e ≤ 40) :
    mg (fun _ => 2 ^ A) e < 2 ^ BW A := mg_lt (fun _ => le_rfl) hA hp hd

theorem vb_regs {v : Fin HS → ℤ} {A : ℕ} (h : VB v A) {e : Ex HS} (he : InRg e) :
    ∀ j ∈ e.regs, |v j| ≤ (fun _ => 2 ^ A) j := fun j hj => h j (he j hj)

theorem inRg_reg {j : Fin HS} (h : j ∈ rg) : InRg (.reg j) := by
  intro i hi; simp [Ex.regs] at hi; subst hi; exact h

theorem cLoop_sp (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {O : Fin HS} (hO : O ∉ rg)
    (hO5 : O.val < 56) (hOC : O ≠ Cu) (hc : c Cu = []) {cl : RS} (hw : Cu ∉ cl.writes)
    {A N : ℕ} (hA : 2 ≤ A) (hv : VB v A) (h24 : v 24 = N) (hN : N ≤ 2 ^ A) (f : ℕ → ℤ)
    (W W' : ℕ → Fin HS → ℤ) (hW0 : W 0 = Function.update v 12 0)
    (hWs : ∀ k, W (k + 1) = Function.update (W' k) 12 (k + 1))
    (hW11 : ∀ k < N, W' k 11 = f k) (hW12 : ∀ k < N, W' k 12 = k)
    (hWV : ∀ k < N, VB (W' k) A) {Cc : ℕ}
    (hcl : ∀ k < N, ∀ cc : Fin HS → List ℤ,
      Sp cl (encK s (RF (W k) cc)) (encK s (RF (W' k) cc)) Cc) :
    Sp (cLoop O cl) (encK s (RF v c)) (encK s (RF (W N) (Function.update c O (rv f N ++ c O))))
      (cE (.lit 0) (BW A) + (2 * 2000 * (BW A + 2) + N * (Cc + cE (.reg 11) (BW A) +
        cE (.add (.reg 12) (.lit 1)) (BW A) + 8000 * (BW A + 2) + 30) + 32)) :=
  cLoopR_sp (by decide) (by decide) s v c hO hO5 hOC hc hw hA hv h24 hN f W W' hW0 hWs hW11 hW12
    hWV hcl

end J6Seg.PreT

