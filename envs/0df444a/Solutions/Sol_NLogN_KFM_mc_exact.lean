lemma zeta_sgn {r : ℕ} [NeZero r] (ζ : ℂ) (hζ : ζ ^ r = -1) (k m : ZMod r) :
    ζ ^ k.val * ζ ^ (m - k).val * (if k.val ≤ m.val then 1 else -1) = ζ ^ m.val := by
  by_cases h : k.val ≤ m.val
  · rw [if_pos h, mul_one, ZMod.val_sub h, ← pow_add, Nat.add_sub_cancel' h]
  · rw [if_neg h]
    have hk := ZMod.val_lt k
    have e : (m - k).val = m.val + r - k.val := by
      have h1 : (((m.val + r - k.val : ℕ)) : ZMod r) = m - k := by
        rw [Nat.cast_sub (by omega), Nat.cast_add, ZMod.natCast_self, add_zero,
          ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
      rw [← h1, ZMod.val_natCast, Nat.mod_eq_of_lt (by omega)]
    rw [e, ← pow_add, show k.val + (m.val + r - k.val) = m.val + r by omega, pow_add, hζ]
    ring

