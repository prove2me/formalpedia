        (NLogN.KFM.lpSt s i a La N k (NLogN.KFM.accSeq G a0 k)).upd a (.int (G k (NLogN.KFM.accSeq G a0 k)) :: La)) :
    (NLogN.RS.rep i n body).ok s ∧ (NLogN.RS.rep i n body).run s = s.upd a (.int (NLogN.KFM.accSeq G a0 N) :: La) := by
  have hinv := NLogN.RS.repSt_inv i n body s (fun k t => t = NLogN.KFM.lpSt s i a La N k (NLogN.KFM.accSeq G a0 k))
    (by
      rw [hN]
      refine NLogN.IState.ext' (fun j => ?_) (by simp [NLogN.KFM.lpSt]) (by simp [NLogN.KFM.lpSt])
      by_cases hj : j = a
      · subst hj; simp [NLogN.KFM.lpSt, NLogN.IState.upd_G, Ne.symm hia, ha, NLogN.KFM.accSeq]
      · simp [NLogN.KFM.lpSt, NLogN.IState.upd_G, hj])
    (by
      intro k hk ht
      rw [hN, Int.toNat_natCast] at hk
      rw [ht, (hb k hk).2]
      apply NLogN.IState.ext' _ (by simp [NLogN.RS.decSt, NLogN.KFM.lpSt]) (by simp [NLogN.RS.decSt, NLogN.KFM.lpSt])
      intro j
      simp only [NLogN.RS.decSt_G]
      by_cases hj : j = i
      · subst hj
        have : ((NLogN.KFM.lpSt s j a La N k (NLogN.KFM.accSeq G a0 k)).upd a
