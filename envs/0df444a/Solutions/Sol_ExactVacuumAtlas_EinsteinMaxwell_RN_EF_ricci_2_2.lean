/-! # One-variable derivative shapes

Explicit `HasDerivAt` witnesses for the few expression shapes that occur in closed-form
metric and Christoffel tables. Closed forms are written in exactly these shapes, so each table
entry is certified by one of these lemmas (no symbolic differentiation is trusted).
-/

open Real

namespace ExactVacuumAtlas.Deriv

theorem div_self_prime (K r : ℝ) (hr : r ≠ 0) : HasDerivAt (fun u => K / u) (-K / r ^ 2) r := by
  refine ((hasDerivAt_const r K).fun_div (hasDerivAt_id' r) hr).congr_deriv ?_
  field_simp
  ring

theorem affine (K L r : ℝ) : HasDerivAt (fun u => K * u + L) K r := by
  refine (((hasDerivAt_id' r).const_mul K).fun_add (hasDerivAt_const r L)).congr_deriv ?_
  ring

theorem sq (r : ℝ) : HasDerivAt (fun u => u ^ 2) (2 * r) r := by
  refine ((hasDerivAt_id' r).fun_pow 2).congr_deriv ?_
  push_cast
  ring

theorem sq_mul (W r : ℝ) : HasDerivAt (fun u => u ^ 2 * W) (2 * r * W) r :=
  (sq r).mul_const W

theorem cos_div_sin (θ : ℝ) (hs : sin θ ≠ 0) :
    HasDerivAt (fun t => cos t / sin t) (-1 / sin θ ^ 2) θ := by
  refine ((Real.hasDerivAt_cos θ).fun_div (Real.hasDerivAt_sin θ) hs).congr_deriv ?_
  have := sin_sq_add_cos_sq θ
  field_simp
  linear_combination (-1 : ℝ) * this

end ExactVacuumAtlas.Deriv

