-- title:
--   The multiplicative cyclotomic Hecke quotient
-- statement:
--   Let $r\ge1$, and let $S$ be a commutative unital ground ring with units $\rho,q,\delta_0,u_1,\ldots,u_r$, parameters $\delta_a\in S$ for $a\ge0$, and
--   $$\rho^{-1}-\rho=(q^{-1}-q)(\delta_0-1).$$
--   Write $W_n=W_{n,S,r}(u_1,\ldots,u_r)$ for the cyclotomic BMW algebra of Definitions 2.1 and 2.8, with affine generator $y_1$ and tangle generators $e_i$.
--
--   Let $n\ge1$, and let $I_n$ be the ideal generated by $e_{n-1}$ for $n\ge2$, with $I_1=0$. Then there is an $S$-algebra isomorphism
--   $$W_n/I_n\cong H_{n,S,r}(q^2;u_1,\ldots,u_r).$$
--   The Hecke algebra has invertible affine braid generators $t_1,g_1,\ldots,g_{n-1}$, the affine braid relations, $g_i-g_i^{-1}=q-q^{-1}$, and $\prod_j(t_1-u_j)=0$. No admissibility or semisimplicity is required. This identifies the Hecke quotient of the BMW algebra.
-- source:
--   Cyclotomic Birman--Wenzl--Murakami algebras, II: Admissibility Relations and Freeness, arXiv:math/0612065v5, PDF p. 33, Lemma 4.4: the cyclotomic Hecke quotient

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P14

noncomputable section

open scoped BigOperators Classical

namespace QAlgorithms.Papers.Independent.Support21.P14

/-- Lemma 4.4, PDF p.33. Actual multiplicative cyclotomic Hecke quotient;
no admissibility, integrality, or semisimplicity hypothesis is added. -/
theorem cyclotomicHecke_quotient {S : Type*} [CommRing S] {r : ℕ}
    (P : GroundParameters S r) (n : ℕ) (hn : 1 ≤ n) :
    Nonempty (BMWHeckeQuotient P n ≃ₐ[S] MultiplicativeCyclotomicHecke P n) := by sorry

end QAlgorithms.Papers.Independent.Support21.P14

end
