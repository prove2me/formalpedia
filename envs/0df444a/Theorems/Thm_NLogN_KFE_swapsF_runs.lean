theorem NLogN.KFE.swapsF_runs {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} (s : IState HS) (f : Fin HS → List ℤ) (Pre G Suf : Shape) {q e r : ℕ}
    (xs rest : List ℤ) (hq : 2 ≤ q) (hP : 1 ≤ vol Pre) (hG : 1 ≤ vol G) (hS : 1 ≤ vol Suf)
    (hre : r ≤ e) (hxs : xs.length = vol (qShape Pre G Suf q e)) (Bb : ℕ) (hb : Bnd 1 xs) (hB1 : 1 ≤ Bb)
    (hV : zsz ((vol (qShape Pre G Suf q e) : ℕ) : ℤ) ≤ Bb)
    {lP lG lS l1 l2 lR : List ℤ}
    (h0 : f 0 = xs ++ rest) (h24 : f 24 = []) (hfP : f kP = (vol Pre : ℤ) :: lP)
    (hfG : f kG = (vol G : ℤ) :: lG) (hfS : f NLogN.KIL.kS = (vol Suf : ℤ) :: lS)
    (hfQt : f kQt = ((q ^ 0 : ℕ) : ℤ) :: l1) (hfQr : f kQr = ((q ^ (e - 0) / q : ℕ) : ℤ) :: l2)
    (hfR : f kR = (r : ℤ) :: lR) :
    IRuns I iprog (NLogN.KFE.swapsF q) (encK s f)
      (encK s (swF f (qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) q e xs rest
        l1 l2 r))
      ((r + 1) * (cSw1F q (vol (qShape Pre G Suf q e)) Bb + 10 ^ 4 * (Bb + 2))) := by sorry
