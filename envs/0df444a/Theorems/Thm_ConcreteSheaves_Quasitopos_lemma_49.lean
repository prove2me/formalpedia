-- title:
--   Lemma 49, p. 39 — the plus construction of a concrete presheaf is a concrete sheaf
-- statement:
--   Let $D$ be a small category with a coverage $K$ and a terminal object $T$ (written $1$ in the paper), and suppose $(D,K,T)$ is a **concrete site**: representables are sheaves, $\operatorname{hom}(1,-)$ is faithful, and covering families are jointly surjective on points. Write $\underline{X}=X(1)$ for the underlying set of a presheaf $X$ and $\underline{\varphi}:\underline{D}\to\underline{X}$, $d\mapsto X(d)(\varphi)$, for the underlying function of a plot $\varphi\in X(D)$.
--
--   Let $X^+$ denote Grothendieck's plus construction of a presheaf $X$ with respect to the Grothendieck topology generated by $K$ (which has the same sheaves as $K$). If $X$ is a concrete presheaf, then
--
--   $$
--   X^+\ \text{is a concrete sheaf, i.e. a } D \text{ space.}
--   $$
--
--   Together with Lemma 47, this gives a left adjoint from presheaves to $D$ spaces, used for colimits.
--
--   **Formalization Note** The site is small ($D$ in universe $u$, presheaves valued in $\mathrm{Type}_u$), covering families are presieves, and the terminal domain is passed explicitly as $(T, h_T)$. $X^+$ is Mathlib's `GrothendieckTopology.plusObj` for `K.toGrothendieck`, as in the paper's proof, which switches to the generated Grothendieck topology. The conclusion is the coverage form of the sheaf condition together with concreteness.
-- source:
--   Baez–Hoffnung, Convenient categories of smooth spaces, arXiv:0807.1704v4, p. 39, Lemma 49

import Mathlib
import Definitions.Def_ConcreteSheaves_Quasitopos_Setting

namespace ConcreteSheaves.Quasitopos

open CategoryTheory CategoryTheory.Limits Opposite

universe u
variable {D : Type u} [SmallCategory D]

/-- Baez–Hoffnung, Lemma 49, p. 39. -/
theorem lemma_49 (K : Coverage D) (T : D) (hT : IsTerminal T)
    (hK : IsConcreteSite K T hT) (P : Dᵒᵖ ⥤ Type u) (hP : IsConcrete T P) :
    IsDSpace K T ((K.toGrothendieck).plusObj P) := by sorry

end ConcreteSheaves.Quasitopos
