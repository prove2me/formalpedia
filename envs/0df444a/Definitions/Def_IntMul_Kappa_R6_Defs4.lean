-- Source module: Solutions.R6BitNBEdges
/-!
# Round six, bit network: edges of the classes (over ℚ)

`EdgeQ e q`: valid runs, lower triangular `E₁, E₂` with nonzero diagonals, and frame
`E₁ σ E₂ = pswQ q`. For each class, under the genericity conditions on the transformed labels,
an edge with the claimed runs exists.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset
open scoped Kronecker

/-- An edge realizing the partial swap of `q` over `ℚ`. -/
def EdgeQ {m : ℕ} (e : Edge m) (q : Matrix (Fin m) (Fin m) ℚ) : Prop :=
  (∀ ρ ∈ e.runs, RunOK m ρ) ∧
    (∀ i j, i < j → e.E₁ i j = 0) ∧ (∀ i, e.E₁ i i ≠ 0) ∧
    (∀ i j, i < j → e.E₂ i j = 0) ∧ (∀ i, e.E₂ i i ≠ 0) ∧
    e.E₁ * ((e.runs.flatMap (runPiv m)).map fun p => Equiv.swap p.1 p.2).prod.permMatrix ℚ *
      e.E₂ = pswQ q

/-! ## Labels -/

/-! ## Aux edges -/

/-! ## Side edges -/

section Side

variable {h : ℕ}

/-- The side runs of a rank-`r` idempotent of size `n`. -/
def sideRuns (n m r : ℕ) : List (ℕ × ℕ × ℕ) := if n < 2 * r then [(n - r, m - r, 2 * r - n)] else []

end Side

/-! ## Data entrance edges -/

section Data

variable {h : ℕ}

/-- The data runs: the middle block and the corner run. -/
def dataRuns (n m : ℕ) : List (ℕ × ℕ × ℕ) :=
  [(2 * n - 1, 2 * n - 1, m - 2 * (2 * n - 1)), (1, m - n + 1, n - 2)]

end Data

end IntMul.Kappa.R6.Bit.NB

end

section
-- Source module: Solutions.R6BitNBFormal
/-!
# Round six, bit side: the formal-frame calculus (`FormalOK`), replacing `LabOK`

`R6BitNBObst` shows that single-label networks (`LabOK`: every gate touches wires with equal
frames) cannot save anything. S. Jain's two-stage network needs wires whose content is a **sum of
terms at different frames**: after the two stages the data outputs are `A = F y` and
`B = F x + E y`, and the copy correction (copy `A`, frame change `T` on the copy, `T F = E`, XOR
into `B`) cancels `E y` in characteristic two.

The calculus: a wire's content is tracked as a **formal value**, a finite `R`-combination of
framed inputs `(F, u)`, meaning `Φ(F)(ins u)` (`frameArr`). Edges multiply every frame on the left
by the edge matrix (`lmulF`), gates act linearly; no label condition on gates. If every role
`ρ w` ends with the single term `(swapMat, w)`, the ideal network is correct
(`idealOK_of_formal`), and the generalized Prop. 11 follows (`prop11H_formal`).

For proofs about concrete networks:
* `formal_labels`: on a program segment whose gates are label consistent (the old `LabGates`),
  formal values of the form `L_w · φ_w` evolve as `L'_w · (scalar circuit on φ)_w`, where the
  scalar circuit runs on **module**-valued wires (`scalarStepM`; here the module of formal
  values). So each stage of the two-stage motif is handled by its frame labels plus its scalar
  identity, and the stages compose through formal values.
* partial swaps `psw p = [[1-p, p], [p, 1-p]]`: `psw p * psw q = psw (p + q - 2pq)`,
  `psw 0 = 1`, `psw 1 = swapMat` (`psw_mul`, …);
* `correction_gadget`: the copy correction on formal values.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

/-- Frame matrices at field size `N`. -/
abbrev FMat (m N : ℕ) := Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N)

/-- Formal values: finite `R`-combinations of framed inputs `(F, u)`. -/
abbrev FV (R : Type*) [CommRing R] (U : Type*) (m N : ℕ) := (FMat m N × U) →₀ R

section Formal

variable {R : Type*} [CommRing R] {U : Type*} {m N : ℕ}

/-- Left multiplication of every frame by `L`. -/
noncomputable def lmulF (L : FMat m N) : FV R U m N →ₗ[R] FV R U m N :=
  Finsupp.lmapDomain R R (fun p : FMat m N × U => (L * p.1, p.2))

end Formal

/-! ## Module-valued scalar circuits -/

section ModuleScalar

variable {R : Type*} [CommRing R] {m : ℕ} {Wr : Type*} [DecidableEq Wr]
  {M : Type*} [AddCommGroup M] [Module R M]

/-- A gate on module-valued wires. -/
def gateVecM (g : Matrix Wr Wr R) (S : Finset Wr) (v : Wr → M) : Wr → M :=
  fun w => if w ∈ S then ∑ w' ∈ S, g w w' • v w' else v w

/-- The scalar circuit on module-valued wires (edges act trivially). -/
def scalarStepM (v : Wr → M) : Instr Wr R m → Wr → M
  | .gate g S => gateVecM g S v
  | .edge _ _ => v

end ModuleScalar

/-! ## Formal execution -/

section FormalRun

variable {R : Type*} [CommRing R] {m : ℕ} {Wr : Type*} [Fintype Wr] [DecidableEq Wr] {U : Type*}
  (N : ℕ)

/-- One instruction on formal values: gates linearly, edges by left multiplication. -/
noncomputable def fStep (f : Wr → FV R U m N) : Instr Wr R m → Wr → FV R U m N
  | .gate g S => gateVecM g S f
  | .edge w e => Function.update f w (lmulF (edgeMat N e) (f w))

end FormalRun

/-! ## Denotation and soundness -/

section Sound

variable {R : Type*} [CommRing R] {m : ℕ} {Wr : Type*} [Fintype Wr] [DecidableEq Wr] {U : Type*}
  {sh : Shape} {N : ℕ} [NeZero N] (Λ : Layout sh (m + m) N) (ins : U → List R)

/-- Entry `i` of the array denoted by a formal value. -/
noncomputable def den (i : ℕ) : FV R U m N →ₗ[R] R :=
  Finsupp.linearCombination R (fun p : FMat m N × U => (frameArr Λ p.1 (ins p.2)).getD i 0)

end Sound

namespace QHNet

variable {R : Type*} [CommRing R] {W T m : ℕ}

/-- Initial formal values: role `u` holds `(1, u)`, temporaries `0`. -/
noncomputable def fInit (N : ℕ) : Fin W ⊕ Fin T → FV R (Fin W) m N :=
  Sum.elim (fun u => Finsupp.single (1, u) 1) fun _ => 0

/-- **Formal correctness**: role `ρ w` ends with the single framed term `(swapMat, w)`. -/
def FormalOK (C : QHNet R W T m) (N : ℕ) : Prop :=
  ∀ w, C.prog.foldl (fStep N) (fInit N) (.inl (C.ρ w)) = Finsupp.single (swapMat, w) 1

end QHNet

/-! ## Partial swaps and the copy correction -/

section PSwap

variable {N m : ℕ}

/-- The partial swap `[[1 - p, p], [p, 1 - p]]`. -/
def psw (p : Matrix (Fin m) (Fin m) (ZMod N)) : FMat m N := blk (1 - p) p p (1 - p)

end PSwap

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitNBSim
/-!
# Round six, bit network: similarity of idempotents, explicit corner idempotent, transitivity

* `idem_similar`: idempotent matrices over `ℚ` of equal rank are similar.
* `eIdem n r`: an explicit idempotent of rank `r` whose top-right `(n-r)`-corner is the identity
  (for `n < 2r`).
* `conj_rank_one`: for `y ⬝ x = 1 = y' ⬝ x'` some invertible `Q` has `Q (x yᵀ) Q⁻¹ = x' y'ᵀ`.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset

section EIdem

/-- The explicit idempotent: rows `i < n - r` are `e_{r+i}`, the others `e_i`. -/
def eIdem (n r : ℕ) : Matrix (Fin n) (Fin n) ℚ :=
  Matrix.of fun i j => if i.val < n - r then (if j.val = r + i.val then 1 else 0)
    else (if j = i then 1 else 0)

variable {n r : ℕ}

end EIdem

end IntMul.Kappa.R6.Bit.NB

end

section
-- Source module: Solutions.R6BitNBGen
/-!
# Round six, bit network: genericity of the flag basis

Polynomials in the entries of two generic matrices `U, V` (`MvPolynomial (Bool × Fin n × Fin n) ℚ`)
encode the genericity conditions through the scaled conjugate `sconj W A = Wᵀ A adj(W)ᵀ`
(`= det W • Wᵀ A W⁻ᵀ`). Each condition polynomial is nonzero (witness via `idem_similar`), so a
rational point avoids all of them (`exists_eval_ne`).
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset MvPolynomial
open scoped Kronecker

section Poly

variable {n : ℕ}

abbrev Vr (n : ℕ) := Bool × Fin n × Fin n
abbrev Rp (n : ℕ) := MvPolynomial (Vr n) ℚ

noncomputable def XU : Matrix (Fin n) (Fin n) (Rp n) := Matrix.of fun i j => X (false, i, j)
noncomputable def XV : Matrix (Fin n) (Fin n) (Rp n) := Matrix.of fun i j => X (true, i, j)
noncomputable def cm {ι κ : Type*} (A : Matrix ι κ ℚ) : Matrix ι κ (Rp n) := A.map C

def Uf (f : Vr n → ℚ) : Matrix (Fin n) (Fin n) ℚ := Matrix.of fun i j => f (false, i, j)
def Vf (f : Vr n → ℚ) : Matrix (Fin n) (Fin n) ℚ := Matrix.of fun i j => f (true, i, j)
def ptUV (U V : Matrix (Fin n) (Fin n) ℚ) : Vr n → ℚ :=
  fun p => if p.1 then V p.2.1 p.2.2 else U p.2.1 p.2.2

/-- Scaled conjugate `Wᵀ A adj(W)ᵀ`. -/
def sconj {S : Type*} [CommRing S] (W A : Matrix (Fin n) (Fin n) S) : Matrix (Fin n) (Fin n) S :=
  Wᵀ * A * W.adjugateᵀ

end Poly

/-! ## Condition polynomials -/

section Conds

variable {n : ℕ}

/-- Label entry `(β, last)` of the scaled conjugate. -/
noncomputable def pA (W : Matrix (Fin n) (Fin n) (Rp n)) (P : Matrix (Fin n) (Fin n) ℚ) (β l : Fin n) :
    Rp n := sconj W (cm P) β l

/-- Corner minor of the scaled conjugate. -/
noncomputable def pCor (W : Matrix (Fin n) (Fin n) (Rp n)) (A : Matrix (Fin n) (Fin n) ℚ) (r : ℕ) :
    Rp n := ((sconj W (cm A)).submatrix (fun l : Fin (n - r) => (⟨l.val, by omega⟩ : Fin n))
      (fun c : Fin (n - r) => (⟨n - (n - r) + c.val, by omega⟩ : Fin n))).det

/-- The mixed condition `x₁'_l y₁'_last + x₂'_l y₂'_last ≠ 0`, scaled. -/
noncomputable def pT (P₁ P₂ : Matrix (Fin n) (Fin n) ℚ) (l e : Fin n) : Rp n :=
  pA XU P₁ l e * (XV (n := n)).det + pA XV P₂ l e * (XU (n := n)).det

end Conds

/-! ## Witnesses -/

section Wit

variable {n : ℕ}

/-- The model rank-one label: `x = 1`, `y = e_last`. -/
def wP (n : ℕ) (hn : 0 < n) : Matrix (Fin n) (Fin n) ℚ :=
  vecMulVec (fun _ => 1) (Pi.single (⟨n - 1, by omega⟩ : Fin n) 1)

end Wit

end IntMul.Kappa.R6.Bit.NB

end

section
-- Source module: Solutions.R6BitNBMain
/-!
# Round six, bit network: the flag basis (main theorem of part (c))

`flagBasis`: for any finite set of labels `(x, y)` (`y ⬝ x = 1`) and any finite set of
idempotents, at `h = 23` (`n = 23`, `m = 529`) there is one rational basis change `S`
(`S * Sinv = 1 = Sinv * S`) in which every edge of every class has the claimed Bruhat runs:
* aux `1 ⊗ (1 - x yᵀ)`, `(1 - x yᵀ) ⊗ 1`: exactly `[(0, m-n, n), (n, n, m-2n)]`;
* side `A ⊗ x yᵀ`, `x yᵀ ⊗ A`: `sideRuns n m (rank A)` plus singletons, total `rank A` pivots;
* data `(1 - x₁ y₁ᵀ) ⊗ (1 - x₂ y₂ᵀ)`: `dataRuns n m` plus `n + 1` singletons.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset MvPolynomial
open scoped Kronecker

section Data

variable {h : ℕ}

noncomputable def kM (P₁ P₂ : Matrix (Fin (h + 4)) (Fin (h + 4)) ℚ) :
    Matrix (Pr (h + 4)) (Pr (h + 4)) (Rp (h + 4)) :=
  ((XU (n := h + 4)).det • 1 - sconj XU (cm P₁)) ⊗ₖ ((XV (n := h + 4)).det • 1 - sconj XV (cm P₂))

noncomputable def pDat (P₁ P₂ : Matrix (Fin (h + 4)) (Fin (h + 4)) ℚ) : Rp (h + 4) :=
  (Matrix.of fun i j : Fin (2 * h + 7) =>
    (cm (n := h + 4) (Te (h := h)) * kM P₁ P₂ * cm (n := h + 4) (Te' (h := h)))
      ⟨i.val, by have := two_k_le (h := h); omega⟩
      ⟨(h + 4) * (h + 4) - (2 * h + 7) + j.val, by have := two_k_le (h := h); omega⟩).det

end Data

/-! ## Conjugation algebra -/

/-! ## The frame -/

section Frame

variable {h : ℕ}

noncomputable def Kf (U V : Matrix (Fin (h + 4)) (Fin (h + 4)) ℚ) : Matrix (Pr (h + 4)) (Pr (h + 4)) ℚ :=
  Uᵀ ⊗ₖ Vᵀ
noncomputable def Kfi (U V : Matrix (Fin (h + 4)) (Fin (h + 4)) ℚ) : Matrix (Pr (h + 4)) (Pr (h + 4)) ℚ :=
  U⁻¹ᵀ ⊗ₖ V⁻¹ᵀ

noncomputable def Sb (U V : Matrix (Fin (h + 4)) (Fin (h + 4)) ℚ) :
    Matrix (Fin ((h + 4) * (h + 4))) (Pr (h + 4)) ℚ := Te (h := h) * Kf U V
noncomputable def Sbi (U V : Matrix (Fin (h + 4)) (Fin (h + 4)) ℚ) :
    Matrix (Pr (h + 4)) (Fin ((h + 4) * (h + 4))) ℚ := Kfi U V * Te' (h := h)

end Frame

/-! ## Main theorem -/

section Main

variable {h : ℕ}

def auxRuns (h : ℕ) : List (ℕ × ℕ × ℕ) :=
  [(0, (h + 4) * (h + 4) - (h + 4), h + 4), (h + 4, h + 4, (h + 4) * (h + 4) - 2 * (h + 4))]

/-- An aux-class edge. -/
def AuxE (q : Matrix (Fin ((h + 4) * (h + 4))) (Fin ((h + 4) * (h + 4))) ℚ) : Prop :=
  ∃ e : Edge ((h + 4) * (h + 4)), EdgeQ e q ∧ e.runs = auxRuns h

/-- A side-class edge of rank `r`. -/
def SideE (q : Matrix (Fin ((h + 4) * (h + 4))) (Fin ((h + 4) * (h + 4))) ℚ) (r : ℕ) : Prop :=
  ∃ e : Edge ((h + 4) * (h + 4)), EdgeQ e q ∧ ∃ rs',
    e.runs = sideRuns (h + 4) ((h + 4) * (h + 4)) r ++ rs' ∧ (∀ ρ ∈ rs', ρ.2.2 = 1) ∧
    (runPairs (sideRuns (h + 4) ((h + 4) * (h + 4)) r)).length + rs'.length = r

/-- A data-class edge. -/
def DataE (q : Matrix (Fin ((h + 4) * (h + 4))) (Fin ((h + 4) * (h + 4))) ℚ) : Prop :=
  ∃ e : Edge ((h + 4) * (h + 4)), EdgeQ e q ∧ ∃ rs',
    e.runs = dataRuns (h + 4) ((h + 4) * (h + 4)) ++ rs' ∧ (∀ ρ ∈ rs', ρ.2.2 = 1) ∧
    rs'.length = h + 5

def lst (h : ℕ) : Fin (h + 4) := ⟨h + 4 - 1, by omega⟩

end Main

end IntMul.Kappa.R6.Bit.NB

end


