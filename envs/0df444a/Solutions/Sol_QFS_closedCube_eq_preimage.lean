/-- The closed cube as a box. -/
theorem solution {h : ℝ} (hh : 0 ≤ h) (u : EuclideanSpace ℝ (Fin d)) :
    QFS.closedCube h u = (WithLp.ofLp : EuclideanSpace ℝ (Fin d) → (Fin d → ℝ)) ⁻¹'
        (Set.pi Set.univ (fun i => Icc (u i - h / 2) (u i + h / 2))) := by
  ext x
  simp only [Set.mem_preimage, Set.mem_univ_pi, Set.mem_Icc, QFS.closedCube, Set.mem_ofPred_eq]
  constructor
  · intro hx i
    have h1 : |(x - u) i| ≤ QFS.infNorm (x - u) := QFS.le_infNorm _ i
    have h2 : (x - u) i = x i - u i := by simp
    rw [h2] at h1
    have h3 := abs_le.mp (le_trans h1 hx)
    constructor <;> [linarith [h3.1]; linarith [h3.2]]
  · intro hx
    rcases isEmpty_or_nonempty (Fin d) with hd | hd
    · simp only [QFS.infNorm, Real.iSup_of_isEmpty]
      linarith
    · obtain ⟨i, hi⟩ := QFS.exists_infNorm_eq (x - u)
      rw [hi]
      have h2 : (x - u) i = x i - u i := by simp
      rw [h2, abs_le]
      obtain ⟨ha, hb⟩ := hx i
      constructor <;> linarith
