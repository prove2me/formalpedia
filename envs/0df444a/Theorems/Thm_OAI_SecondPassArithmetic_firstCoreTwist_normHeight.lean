theorem OAI.SecondPassArithmetic.firstCoreTwist_normHeight (negative : Bool) (χ : RayFourExpansion.RayCharacter)
    (Ψ : ActualEisensteinCubic.O →* ℂ) (r : FirstCoreIndex) (t : ℝ) :
    firstCoreTwist negative χ (normHeightTwist Ψ t) r=
      normHeightTwist (firstCoreTwist negative χ Ψ r) t := by sorry
