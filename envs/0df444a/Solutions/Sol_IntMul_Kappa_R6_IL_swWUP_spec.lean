/-!
# KFV §12: literal-to-register simulation of item-language code

`ISim π c c'`: `c'` is `c` with some literal pushes `.const j v` replaced by copies `.dup i j` of a
parameter stack `i` holding `v` (`π i = some v`). It is the `IStmt`-level analogue of
`KIL.RSim` and covers compiled register programs (`Ex.code` compiles `.lit v` to `.const` and
`.reg i` to `.dup`) as well as hand-written codes such as KFT's `carI`/`digI`.

**`ISim.runs`**: if `c` does not write any parameter stack and makes no calls (`NW π c`), every
run of `c` from a state with the parameters on top (`PV π s`) is matched by a run of `c'` with
the same final state and at most `2000 ×` the cost. This turns old codes whose *shape* does not
depend on `n` into uniform codes reading their sizes from stacks.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KIL

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem op_frame {o : IOp HS} {s t : IState HS} {c : ℕ} (h : o.Step I s t c) (j : Fin HS)
    (hj : j ∉ opW o) : t.G j = s.G j := by
  cases h <;> simp_all [opW, IState.upd_G]

theorem exec_PV {π : PMap} {c : IStmt HS Pp} {s t : IState HS} {n : ℕ}
    (h : IExec I iprog c s t n) (hw : NW π c) (hs : PV π s) : PV π t := by
  induction h with
  | skip => exact hs
  | op hst =>
    rename_i o s1 t1 c1
    refine hs.of_G fun i v hv => op_frame hst i fun hm => ?_
    have := hw i hm; rw [hv] at this; exact absurd this (by simp)
  | seq _ _ ih1 ih2 => exact ih2 hw.2 (ih1 hw.1 hs)
  | iteT _ _ ih => exact ih hw.1 hs
  | iteF _ _ ih => exact ih hw.2 hs
  | loopT _ _ _ ih1 ih2 => exact ih2 hw (ih1 hw hs)
  | loopF _ => exact hs
  | call _ _ => exact absurd hw id

/-- **Simulation of runs.** -/
theorem ISim.runs {π : PMap} {c c' : IStmt HS Pp} (hc : ISim I iprog π c c') (hw : NW π c)
    {s t : IState HS} (hs : PV π s) {n : ℕ} (h : IRuns I iprog c s t n) :
    IRuns I iprog c' s t (2000 * n) := by
  obtain ⟨m, hm, e⟩ := h
  obtain ⟨m', hm', e'⟩ := ISim.exec e hc hw hs
  exact ⟨m', by nlinarith, e'⟩

/-- Runs of a code that writes no parameter stack keep the parameters. -/
theorem NW.PV {π : PMap} {c : IStmt HS Pp} (hw : NW π c) {s t : IState HS} (hs : PV π s) {n : ℕ}
    (h : IRuns I iprog c s t n) : PV π t := by
  obtain ⟨m, -, e⟩ := h; exact exec_PV e hw hs

/-! ## Compiled register programs -/

end NLogN.KFV

end

section
-- Source module: Solutions.KFV9Gen
/-!
# KFV §13: generalized literal substitution and the write analysis

* `wl c` (stacks written, calls ignored) and `nc c` (no calls): `NW_of` gives `NW π c` when no
  parameter stack is written. `wl_ecode`: compiled expressions write only the scratch `56…63`;
  `wl_fcode`: compiled register programs write `p.writes`, the scratch, and the `toUL` stacks.
* `EG π e e'`: `e'` is `e` with literals `v` replaced by any clean expression over the parameters
  that evaluates to `v` at cost `≤ 2000 (zsz v + 2)` (e.g. `2r = r + r`, `-K`, `B / 2`).
  `GSim` is the register-program version. **`ISim.fcodeG`**: `GSim π p p'` gives
  `ISim π (fcode p) (fcode p')`. **`ISim.pushE`**: a literal push `const j v` on any stack
  `j ≠ 56` may be replaced by `e.code; mv 56 j`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open IntMul KIL KFD

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Write analysis -/

theorem NW_of {π : PMap} (c : IStmt HS Pp) (hc : nc c = true) (h : ∀ i ∈ wl c, π i = none) :
    NW π c := by
  induction c with
  | skip => trivial
  | op o => exact h
  | seq a b iha ihb =>
    simp only [nc, Bool.and_eq_true] at hc
    exact ⟨iha hc.1 fun i hi => h i (by simp [wl, hi]), ihb hc.2 fun i hi => h i (by simp [wl, hi])⟩
  | ite _ _ a b iha ihb =>
    simp only [nc, Bool.and_eq_true] at hc
    exact ⟨iha hc.1 fun i hi => h i (by simp [wl, hi]), ihb hc.2 fun i hi => h i (by simp [wl, hi])⟩
  | loop _ _ a ih => exact ih hc h
  | call _ => simp [nc] at hc

/-! ## Generalized substitution -/

end NLogN.KFV

end

section
-- Source module: Solutions.KFWSwap1
/-!
# KFW: uniform Lemma 12 on integer arrays (parameters in registers)

The integer-array swap `KFS.swW q w Pre G Suf u` (to bits, Lemma 12, back to integers) with its
size-dependent literals read from registers:

* `toBitsU` / `fromBitsU`: `KFL.toBitsI N w` / `fromBitsI N w` with `N`, `w` copied from the
  registers `sN`, `sW` (`ISim`, at most `2000 ×` the cost);
* `swIU q`: the Lemma 12 wrapper `KFL.swI` with the four parameters pushed from the registers
  `sP, sG, sS, sU` (**`swIU_spec`**);
* `swWU q`: the composite (**`swWU_spec`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KIL KFD KFE KFB KFL KFS KFV AModel AModelL12 NetProp7

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Conversions -/

theorem πNW_none {N w : ℕ} {i : Fin HS} (h : 7 ≤ i.val ∨ i.val = 0) : πNW N w i = none := by
  unfold πNW
  rw [if_neg (by intro e; subst e; revert h; decide), if_neg (by intro e; subst e; revert h; decide)]

theorem PV_πNW {t : IState HS} {N w : ℕ} {L1 L2 : List Item} (h1 : t.G sN = .int (N : ℤ) :: L1)
    (h2 : t.G sW = .int (w : ℤ) :: L2) : PV (πNW N w) t := by
  intro i v hv
  unfold πNW at hv
  split_ifs at hv with a b
  · subst a; cases hv; exact ⟨_, h1⟩
  · subst b; cases hv; exact ⟨_, h2⟩

theorem nw_toBitsI (N w : ℕ) : NW (πNW N w) (toBitsI N w : IStmt HS Pp) := by
  refine NW_of _ (by rfl) fun i hi => πNW_none ?_
  have e : wl (toBitsI N w : IStmt HS Pp) = wl (toBitsI 0 0 : IStmt HS 1) := rfl
  rw [e] at hi
  revert i hi; decide

theorem nw_fromBitsI (N w : ℕ) : NW (πNW N w) (fromBitsI N w : IStmt HS Pp) := by
  refine NW_of _ (by rfl) fun i hi => πNW_none ?_
  have e : wl (fromBitsI N w : IStmt HS Pp) = wl (fromBitsI 0 0 : IStmt HS 1) := rfl
  rw [e] at hi
  revert i hi; decide

theorem isim_toBits (N w : ℕ) : ISim I iprog (πNW N w) (toBitsI N w) toBitsU :=
  .seq (.par (by simp [πNW]) (by decide)) (.seq (.par (by simp +decide [πNW]) (by decide))
    (ISim.refl _ _))

theorem isim_fromBits (N w : ℕ) : ISim I iprog (πNW N w) (fromBitsI N w) fromBitsU :=
  .seq (.par (by simp [πNW]) (by decide)) (.seq (.par (by simp +decide [πNW]) (by decide))
    (ISim.refl _ _))

theorem toBitsU_spec (t : IState HS) (xs : List ℤ) (w : ℕ) (hxs : ∀ x ∈ xs, zsz x ≤ w)
    (R : List Item) (h0 : t.G 0 = ints xs ++ R) {L1 L2 : List Item}
    (h1 : t.G sN = .int (xs.length : ℤ) :: L1) (h2 : t.G sW = .int (w : ℤ) :: L2) :
    IRuns I iprog toBitsU t (t.upd 0 (ints (bitsL w xs) ++ R)) (2000 * cTo xs.length w) :=
  (isim_toBits xs.length w).runs (nw_toBitsI _ _) (PV_πNW h1 h2) (toBitsI_spec t xs w hxs R h0)

theorem fromBitsU_spec (t : IState HS) (xs : List ℤ) (w : ℕ) (hxs : ∀ x ∈ xs, zsz x ≤ w)
    (R : List Item) (h0 : t.G 0 = ints (bitsL w xs) ++ R) {L1 L2 : List Item}
    (h1 : t.G sN = .int (xs.length : ℤ) :: L1) (h2 : t.G sW = .int (w : ℤ) :: L2) :
    IRuns I iprog fromBitsU t (t.upd 0 (ints xs ++ R)) (2000 * cFrom xs.length w) :=
  (isim_fromBits xs.length w).runs (nw_fromBitsI _ _) (PV_πNW h1 h2) (fromBitsI_spec t xs w hxs R h0)

/-! ## The Lemma 12 wrapper with register parameters -/

/-! ## The integer-array swap -/

theorem cost_comb2 {cto cfr c N w : ℕ} {K x : ℝ} (hK : 0 ≤ K) (hx : 1 ≤ x)
    (hto : cto ≤ 2 * 10 ^ 7 * ((N + 1) * (w + 1))) (hfr : cfr ≤ 2 * 10 ^ 7 * ((N + 1) * (w + 1)))
    (hc : (c : ℝ) ≤ K * (((N * (w + 1) : ℕ) : ℝ) + 1) * x) :
    ((cto + (c + cfr) : ℕ) : ℝ) ≤ (4 * 10 ^ 7 + K) * ((w : ℝ) + 1) * ((N : ℝ) + 1) * x := by
  have h1 : (cto : ℝ) ≤ 2 * 10 ^ 7 * (((N : ℝ) + 1) * ((w : ℝ) + 1)) := by exact_mod_cast hto
  have h2 : (cfr : ℝ) ≤ 2 * 10 ^ 7 * (((N : ℝ) + 1) * ((w : ℝ) + 1)) := by exact_mod_cast hfr
  have hN : (0 : ℝ) ≤ N := Nat.cast_nonneg _
  have hw : (0 : ℝ) ≤ w := Nat.cast_nonneg _
  have hP : (0 : ℝ) ≤ ((N : ℝ) + 1) * ((w : ℝ) + 1) := by positivity
  have h3 : (((N * (w + 1) : ℕ) : ℝ) + 1) ≤ ((w : ℝ) + 1) * ((N : ℝ) + 1) := by
    push_cast; nlinarith
  have h4 : K * (((N * (w + 1) : ℕ) : ℝ) + 1) * x ≤ K * (((w : ℝ) + 1) * ((N : ℝ) + 1)) * x := by
    apply mul_le_mul_of_nonneg_right _ (by linarith)
    exact mul_le_mul_of_nonneg_left h3 hK
  have h5 : 4 * 10 ^ 7 * (((N : ℝ) + 1) * ((w : ℝ) + 1)) ≤
      4 * 10 ^ 7 * (((N : ℝ) + 1) * ((w : ℝ) + 1)) * x := by nlinarith
  push_cast
  nlinarith

end NLogN.KFW

end

section
-- Source module: Solutions.R6ILSwapU
/-!
# Round six, item language: `SwapNeedτ` from fine Lemma 12 (parametric copy of KFW's chain)

`KFW.swIU_spec`, `KFW.swWU_spec`, `KFW.swGU_spec` and `KFW.swapNeed` with the OpenAI Lemma 12
(`KFB.lemma12_fine_canon`, table `KFL.l12prog`, code `KFL.l12C q`, `τS`) replaced by any
`L12Canon tab l12 τ`. The register programs (`toBitsU`, `fromBitsU`, `descP`, `popP`) are the
frozen ones.

**`swapNeedτ_of_l12Canon : L12Canon tab l12 τ → SwapNeedτ tab τ`** (`0 ≤ τ`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFS NLogN.KFL NLogN.KFW AModel AModelL12

section Chain

variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}

theorem swWUP_spec_sol_aux (hτ : 0 ≤ τ) (h : L12Canon tab l12 τ) :
    ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u w : ℕ) (Pre G Suf : Shape), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      ∀ (I : List Sym) (t : IState HS) (xs : List ℤ) (R : List Item),
      t.G 0 = ints xs ++ R → xs.length = vol (binShape Pre G Suf (2 ^ u)) →
      (∀ x ∈ xs, zsz x ≤ w) →
      ∀ {L1 L2 L3 L4 L5 L6 : List Item},
      t.G sN = .int (vol (binShape Pre G Suf (2 ^ u)) : ℤ) :: L1 → t.G sW = .int (w : ℤ) :: L2 →
      t.G sP = .int (vol Pre : ℤ) :: L3 → t.G sG = .int (vol G : ℤ) :: L4 →
      t.G sS = .int ((vol Suf * (w + 1) : ℕ) : ℤ) :: L5 → t.G sU = .int (u : ℤ) :: L6 →
      ∃ c : ℕ, IRuns I tab (swWUP l12) t
        (t.upd 0 (ints (pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
          (swapPos Pre.length (Pre.length + 1 + G.length)) 0 xs) ++ R)) c ∧
        (c : ℝ) ≤ K * ((w : ℝ) + 1) * ((vol (binShape Pre G Suf (2 ^ u)) : ℝ) + 1) *
          (u : ℝ) ^ τ := by
  obtain ⟨K, hK, HK⟩ := swIUP_spec hτ h
  refine ⟨4 * 10 ^ 7 + K, by positivity,
    fun u w Pre G Suf hu hPre hG hS I t xs R h0 hxl hxw L1 L2 L3 L4 L5 L6 r1 r2 r3 r4 r5 r6 => ?_⟩
  set sh := binShape Pre G Suf (2 ^ u) with hsh
  set N := vol sh
  set pp := Pre.length
  set qq := Pre.length + 1 + G.length
  obtain ⟨hp, hq'⟩ := binShape_len_ok Pre G Suf (2 ^ u)
  have hs := binShape_getD_eq Pre G Suf (2 ^ u)
  -- 1. to bits
  have S1 := toBitsU_spec (I := I) (iprog := tab) t xs w hxw R h0 (by rw [hxl]; exact r1) r2
  rw [hxl] at S1
  set xb := bitsL w xs
  set t1 := t.upd 0 (ints xb ++ R)
  -- 2. Lemma 12 on the bit array
  have hSuf' : ∀ a ∈ Suf ++ [w + 1], 1 ≤ a := by
    intro a ha; simp only [List.mem_append, List.mem_singleton] at ha
    rcases ha with ha | rfl
    · exact hS a ha
    · omega
  have hxbb : KFL.Bits xb := bits_bitsL w xs
  set xz : List (ZMod 2) := xb.map fun z : ℤ => (Int.cast z : ZMod 2)
  have hxz : enc2 xz = xb := bits_enc2 xb hxbb
  have hxzl : xz.length = vol (binShape Pre G (Suf ++ [w + 1]) (2 ^ u)) := by
    rw [List.length_map, length_bitsL, hxl, vol_binShape_snoc]
  have ev : vol (Suf ++ [w + 1]) = vol Suf * (w + 1) := by rw [vol_append]; simp
  obtain ⟨c2, S2, hc2⟩ := HK u Pre G (Suf ++ [w + 1]) hu hPre hG hSuf' I t1 xz R
    (by simp [t1, hxz]) hxzl (L1 := L3) (L2 := L4) (L3 := L5) (L4 := L6)
    (by simp +decide [t1, r3]) (by simp +decide [t1, r4]) (by simp +decide [t1, r5, ev])
    (by simp +decide [t1, r6])
  rw [hxz, binShape_snoc, ← bitsL_pull_swapPos sh hp hq' hs w xs hxl] at S2
  set ys := pull sh sh (swapPos pp qq) 0 xs
  set t2 := t1.upd 0 (ints (bitsL w ys) ++ R)
  -- 3. back to integers
  have hval : ∀ a, Valid sh a → Valid sh (swapPos pp qq a) := fun a ha =>
    valid_swapPos hp hq' hs ha
  have hyw : ∀ y ∈ ys, zsz y ≤ w := fun y hy => hxw y (mem_pull_of_valid hval hxl hy)
  have hyl : ys.length = N := length_pull _ _ _ _ _
  have S3 := fromBitsU_spec (I := I) (iprog := tab) t2 ys w hyw R (by simp [t2]) (L1 := L1)
    (L2 := L2) (by rw [hyl]; simp +decide [t2, t1, r1]) (by simp +decide [t2, t1, r2])
  rw [hyl] at S3
  refine ⟨_, (S1.seq (S2.seq S3)).mono' ?_ le_rfl, ?_⟩
  · simp [t2, t1]
  · rw [vol_binShape_snoc] at hc2
    have h1 := cTo_le N w
    have h2 := cFrom_le N w
    have hx : (1 : ℝ) ≤ (u : ℝ) ^ τ := Real.one_le_rpow (by exact_mod_cast hu) hτ
    have hc := cost_comb2 (cto := 2000 * cTo N w) (cfr := 2000 * cFrom N w) (c := c2) (N := N)
      (w := w) (K := K) (x := (u : ℝ) ^ τ) hK hx (by omega) (by omega)
      (by simpa [N, mul_comm] using hc2)
    refine le_trans hc (le_of_eq ?_)
    ring

end Chain

end IntMul.Kappa.R6.IL

end

theorem solution : type_of% @IntMul.Kappa.R6.IL.swWUP_spec_sol_aux := @IntMul.Kappa.R6.IL.swWUP_spec_sol_aux
