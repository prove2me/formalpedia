private theorem eval_gl3LFactorPoly_scaled_eq_eval_inducedEulerPoly
    (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (hdeg : Module.finrank ℚ K ≤ 3) (c : HeightOneSpectrum (𝓞 K) → ℂ) (v : HeightOneSpectrum (𝓞 ℚ))
    (u Y : ℂ) :
    (gl3LFactorPoly (u * inducedE1 ℚ c v) (u ^ 2 * inducedE2 ℚ c v) (u ^ 3 * inducedE3 ℚ c v)).eval Y =
      (inducedEulerPoly ℚ c v).eval (u * Y) := by
  rw [eval_inducedEulerPoly_eq_of_finrank_le_three K hdeg c v (u * Y), gl3LFactorPoly_def]
  simp only [eval_sub, eval_add, eval_mul, eval_pow, eval_C, eval_X, eval_one]
  ring

