-- title:
--   Theorem 4.7 proof, unnumbered: scalar spectral measure and cyclic isometry
-- statement:
--   Let $k$ be $\mathbb R$ or $\mathbb C$, let $H$ be a Hilbert space, and let $(X,\Sigma)$ be a measurable space. Write $M(X)$ for the finite $k$-valued measurable functions with pointwise equality, and $M_b(X)$ for its bounded functions. Let $\Phi:M(X)\to C(H)$ satisfy axioms MFC1–MFC5, where $C(H)$ consists of closed functional linear graphs. All operator equalities include equality of domains; an overline on an operator denotes graph closure.
--
--   For every $x\in H$ there is a finite measure $\mu_x$ on $(X,\Sigma)$ such that
--
--   $$\mu_x(A)=\langle x,\Phi(1_A)x\rangle,\qquad\mu_x(X)=\|x\|^2,\qquad\langle x,\Phi(f)x\rangle=\int_X f\,d\mu_x\quad(f\in M_b(X)).$$
--
--   The first pairing is nonnegative real. Bounded symbols and their squared moduli are integrable, and $\|\Phi(f)x\|^2=\int_X|f|^2\,d\mu_x$. Let $Z_x$ be the closed cyclic subspace generated by $\{\Phi(f)x:f\in M_b(X)\}$. There is a unitary $V_x:L^2(\mu_x;k)\to Z_x$ satisfying $V_x[f]=\Phi(f)x$ for every bounded measurable $f$. This map is defined on almost-everywhere classes, not injectively on pointwise symbols. The vector $x$ may be zero, and $\mu_x$ need not be a probability measure.
--
--   This is the finite scalar spectral measure and bounded-symbol cyclic representation explicitly established in the source proof.
-- source:
--   The Functional Calculus Approach to the Spectral Theorem, arXiv:2003.06130v2, PDF p. 18, Theorem 4.7 proof, unnumbered: scalar spectral measure and cyclic isometry

import Definitions.Def_QAlgorithms_Papers_Independent_Claimed50_P05

noncomputable section

attribute [local instance] Classical.propDecidable

open Set Filter MeasureTheory

open scoped Topology ENNReal InnerProductSpace

namespace QAlgorithms.Papers.Independent.Claimed50.P05

universe u v w

variable {k : Type*} [RCLike k]

variable {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y]

variable {H K : Type*} [NormedAddCommGroup H] [InnerProductSpace k H]
  [CompleteSpace H] [NormedAddCommGroup K] [InnerProductSpace k K] [CompleteSpace K]

/-- Theorem 4.7 proof, PDF pp.18–19: finite scalar measure and the full cyclic L2 unitary. -/
theorem calculus_scalar_measure (F : Symbol X k → Relation H) (hF : Calculus F) (x : H) :
    ∃ mu : Measure X,
      mu Set.univ < ⊤ ∧ mu Set.univ = ENNReal.ofReal (‖x‖ ^ 2) ∧
      (∀ A (hA : MeasurableSet A),
        mu A = ENNReal.ofReal (RCLike.re (inner k x (value (F (indicator A hA)) x)))) ∧
      (∀ f, BoundedSymbol f → Integrable f.val mu ∧
        inner k x (value (F f) x) = ∫ t, f.val t ∂mu) ∧
      (∀ f, BoundedSymbol f → Integrable (fun t => ‖f.val t‖ ^ 2) mu ∧
        ‖value (F f) x‖ ^ 2 = ∫ t, ‖f.val t‖ ^ 2 ∂mu) ∧
      (∃ V : Lp k 2 mu ≃ₗᵢ[k] cyclic F x,
        ∀ f, BoundedSymbol f → ∃ u : Lp k 2 mu,
          (∀ᵐ t ∂mu, u t = f.val t) ∧ (V u).val = value (F f) x) := by sorry

end QAlgorithms.Papers.Independent.Claimed50.P05

end
