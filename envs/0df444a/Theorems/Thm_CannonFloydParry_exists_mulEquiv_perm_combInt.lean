-- title:
--   p. 241 — $\pi_0, \dots, \pi_{n-1}$ (and $C_n$) generate symmetric groups on comb intervals
-- statement:
--   Let $n \ge 1$ and let $I_j = [1 - 2^{-j}, 1 - 2^{-(j+1)})$ for $j \le n$, $I_{n+1} = [1 - 2^{-(n+1)}, 1)$.
--
--   1. The subgroup of $V$ generated by $\pi_0, \dots, \pi_{n-1}$ is isomorphic to the symmetric group on $\{0, \dots, n\}$ by an isomorphism $e$ recording how it permutes $I_0, \dots, I_n$: each element $g$ maps $I_j$ into $I_{e(g)(j)}$.
--   2. The subgroup generated by $\pi_0, \dots, \pi_{n-1}$ and $C_n$ is isomorphic to the symmetric group on $\{0, \dots, n+1\}$ in the same way, permuting $I_0, \dots, I_{n+1}$.
--
--   **Formalization Note.** The source's intervals are closed; the half-open ones here are the same up to endpoints and fit the right-continuous maps. Since $e(g)$ is a permutation and $g$ a bijection, "into" gives "onto". The subgroups are generated inside the group of all permutations of the circle; that they lie in $V$ is the milestone $T \le V$, $\pi_0 \in V$, since the $\pi_i$ and $C_n$ are words in $A$, $B$, $C$, $\pi_0$.
-- source:
--   Cannon, J. W., Floyd, W. J., Parry, W. R., Introductory notes on Richard Thompson's groups, L'Enseignement Mathématique (2) 42 (1996) 215–256, https://doi.org/10.5169/seals-87877, section 6, p. 241, the symmetric groups in V

import Mathlib
import Definitions.Def_CannonFloydParry_V

namespace CannonFloydParry

theorem exists_mulEquiv_perm_combInt (n : ℕ) (hn : 0 < n) :
    (∃ e : Subgroup.closure (piV '' Set.Iio n) ≃* Equiv.Perm (Fin (n + 1)),
      ∀ g (j : Fin (n + 1)), ∀ z ∈ combInt (n + 1) j,
        ∃ w ∈ combInt (n + 1) (e g j), (g : Equiv.Perm UnitAddCircle) (z : UnitAddCircle) = (w : UnitAddCircle)) ∧
    (∃ e : Subgroup.closure (insert (CV n) (piV '' Set.Iio n)) ≃* Equiv.Perm (Fin (n + 2)),
      ∀ g (j : Fin (n + 2)), ∀ z ∈ combInt (n + 1) j,
        ∃ w ∈ combInt (n + 1) (e g j), (g : Equiv.Perm UnitAddCircle) (z : UnitAddCircle) = (w : UnitAddCircle)) := by
  sorry

end CannonFloydParry
