theorem plumbP2
    (p : ℕ) (M : ℕ) (L : Type) [Field L]
    (K₁ : IntermediateField L (LaurentSeries L)) (K₂ : IntermediateField L (LaurentSeries L))
    (A : Type) [CommRing A] [Algebra A ↥K₁] [Algebra A ↥K₂]
