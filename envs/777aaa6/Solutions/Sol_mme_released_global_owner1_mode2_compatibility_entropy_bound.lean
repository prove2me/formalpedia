    rw [hid]
    change ((∑ s : Fin 45,
      if ¬ yzBoundary (half := 8) (parent := fun (_ : Fin 1) (_ : Fin 3) ↦ 8) 1 ⟨0, shape s⟩ ∧ (shape s).val 2 = j then rowMass s w else 0 : ℚ) : ℝ) = _
    rw [Rat.cast_sum, ← shapeEquiv.sum_comp]
    apply Finset.sum_congr rfl
    intro s hs
    change ((if ¬ yzBoundary (half := 8) (parent := fun (_ : Fin 1) (_ : Fin 3) ↦ 8) 1 ⟨0, shape s⟩ ∧
      (shape s).val 2 = j then rowMass s w else 0 : ℚ) : ℝ) =
