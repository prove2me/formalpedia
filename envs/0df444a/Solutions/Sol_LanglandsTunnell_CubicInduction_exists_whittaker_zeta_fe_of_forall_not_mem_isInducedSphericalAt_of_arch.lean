private theorem exists_finset_forall_valued_algebraMap_eq_one {a : ℚ} (ha : a ≠ 0) :
    ∃ S : Finset (HeightOneSpectrum (𝓞 ℚ)), ∀ v, v ∉ S → Valued.v (algebraMap ℚ (v.adicCompletion ℚ) a) = 1 := by
  refine ⟨((HeightOneSpectrum.Support.finite (𝓞 ℚ) a).union
    (HeightOneSpectrum.Support.finite (𝓞 ℚ) a⁻¹)).toFinset, fun v hv => ?_⟩
  simp only [Set.Finite.mem_toFinset, Set.mem_union, HeightOneSpectrum.Support, Set.mem_setOf_eq, not_or, not_lt,
    map_inv₀] at hv
  have h0 : 0 < v.valuation ℚ a := zero_lt_iff.2 ((Valuation.ne_zero_iff _).2 ha)
  have e : Valued.v (algebraMap ℚ (v.adicCompletion ℚ) a) = v.valuation ℚ a :=
    HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v a
  rw [e]
  exact le_antisymm hv.1 ((inv_le_one₀ h0).1 hv.2)

private theorem diagonal_map_sq {E : Type*} [Semiring E] (f : ℚ →+* E) (a : ℚ) :
    Matrix.diagonal (f ∘ ![a ^ 2, a, 1]) = Matrix.diagonal ![f a * f a, f a, 1] := by
  congr 1
  funext i
  fin_cases i <;> simp [pow_two]

