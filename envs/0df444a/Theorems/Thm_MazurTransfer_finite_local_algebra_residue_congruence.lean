-- title:
--   Residue congruence for points of a finite local algebra
-- statement:
--   Let $A$ be a finite local algebra over a local commutative ring $R$, and suppose the maximal ideal of $R$ is generated by an element $t$. Choose an $R$-algebra augmentation $\varepsilon:A\to R$. For any local $R$-algebra $B$ in which $t$ belongs to the maximal ideal and any $R$-algebra map $f:A\to B$, one has $f(a)\equiv\varepsilon(a)$ modulo the maximal ideal of $B$ for every $a\in A$. Thus every such point reduces to the augmentation. This reduction is used for connected finite-flat Hopf models in the order-13 descent.
-- source:
--   MazurTheorem local connected-Hopf reduction bridge, using Mathlib integral-algebra maximal-ideal contraction and residue fields. Mathematical context: official Anthropic FLT source at 6e837e75355538c7f80bab5b956861e86c4eacc2, P2M/Sol/S_HopfAlgebra_point_eq_one_of_forall_mem_inertiaSubgroupIn_of_isLocalRing.lean, congruence section; the statement here is a general finite-local algebra lemma.

import Mathlib

theorem MazurTransfer.finite_local_algebra_residue_congruence {R A B : Type*} [CommRing R] [IsLocalRing R]
    [CommRing A] [Algebra R A] [Module.Finite R A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B] [Algebra R B]
    (t : R) (hmax : IsLocalRing.maximalIdeal R = Ideal.span {t})
    (ε : A →ₐ[R] R) (f : A →ₐ[R] B)
    (ht : algebraMap R B t ∈ IsLocalRing.maximalIdeal B) (a : A) :
    f a - algebraMap R B (ε a) ∈ IsLocalRing.maximalIdeal B := by sorry
