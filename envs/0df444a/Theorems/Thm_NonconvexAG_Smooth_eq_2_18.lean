-- url     : https://prove2.me/theorems/0b9b838b-5ce9-4421-9ff1-33fe10b5ef98
-- title:
--   (2.18) — Ψ(x_k) ≤ Ψ(x_{k−1}) − λ_k(1 − L_Ψλ_k)‖∇Ψ(x^md_k)‖² + (L_ΨΓ_k/2) Σ_{τ≤k} ((λ_τ−β_τ)²/(Γ_τα_τ))‖∇Ψ(x^md_τ)‖²
-- statement:
--   Let $\Psi:\mathbb R^n\to\mathbb R$ be differentiable with $L_\Psi$-Lipschitz gradient, $L_\Psi>0$, and let $x_k,x^{md}_k,x^{ag}_k$ be generated by Algorithm 1 from $x_0$ with step sizes $\alpha_1=1$, $\alpha_k\in(0,1)$ ($k\ge2$), $\beta_k>0$, $\lambda_k>0$; $\Gamma_k$ as in (2.6). Then for every $k\ge1$,
--   $$\Psi(x_k)\le\Psi(x_{k-1})-\lambda_k(1-L_\Psi\lambda_k)\|\nabla\Psi(x^{md}_k)\|^2+\frac{L_\Psi\Gamma_k}{2}\sum_{\tau=1}^k\frac{(\lambda_\tau-\beta_\tau)^2}{\Gamma_\tau\alpha_\tau}\|\nabla\Psi(x^{md}_\tau)\|^2 .$$
--
--   Summing this one-step bound over $k=1,\dots,N$ gives (2.19).
--
--   **Formalization Note** The statement is the outer ends of the chain (2.18).
-- source:
--   Ghadimi & Lan, Accelerated Gradient Methods for Nonconvex Nonlinear and Stochastic Programming, arXiv:1310.3787v1, p. 6, (2.18)

import Mathlib
import Definitions.Def_ConvexOptAlg_SmoothGD_Defs
import Definitions.Def_NonconvexAG_Smooth_AGRun

namespace NonconvexAG.Smooth

/-- (2.18), p. 6 (outer ends of the chain). -/
theorem eq_2_18 {n : ℕ} (Ψ : E n → ℝ) (g : E n → E n) (LΨ : ℝ)
    (hΨ : ConvexOptAlg.SmoothGD.IsBetaSmooth Ψ g LΨ) (hL : 0 < LΨ)
    (α β lam : ℕ → ℝ) (hstep : AGStepsizes α β lam) (x0 : E n) :
    ∀ k, 1 ≤ k →
      Ψ (xSeq g α β lam x0 k) ≤ Ψ (xSeq g α β lam x0 (k - 1)) - lam k * (1 - LΨ * lam k) * ‖g (xmdSeq g α β lam x0 k)‖ ^ 2
        + LΨ * Gamma α k / 2 * ∑ τ ∈ Finset.Icc 1 k,
            (lam τ - β τ) ^ 2 / (Gamma α τ * α τ) * ‖g (xmdSeq g α β lam x0 τ)‖ ^ 2 := by sorry

end NonconvexAG.Smooth
