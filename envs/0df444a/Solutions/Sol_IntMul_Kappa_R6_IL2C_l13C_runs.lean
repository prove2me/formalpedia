  have hq := hP.ok.qc
  rw [hP.sb] at ek ⊢
  exact swW_RS hP (P := a * l.QC * P) H hnG (Or.inl rfl) (fun t ht => ht.key.su) (by rw [ek]; ring)
    (by rw [eP, ea]; ring) (by positivity) hk

/-- `A ↦ A` through two swaps. -/
theorem thru_RS {r : Fin HS} {p : IStmt HS 1} {π1 π2 : ℕ → ℕ} {c1 c2 : ℝ}
    (hW : RecStep I tab (swW l12 r) (fun t => CEnv t l K ρ G n q Br fl) l.M Br π1 c1)
    (hp : RecStep I tab p (fun t => CEnv t l K ρ G n q Br fl) l.M Br π2 c2) :
    RecStep I tab (thru l12 r p) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (fun m => π1 (π2 (π1 m))) (c2 + 2 * c1) :=
  (RecStep.seq CEnv.stab hW (RecStep.seq CEnv.stab hp hW)).congr (fun m => rfl) (le_of_eq (by ring))

theorem dvd_cancel {a b : ℕ} (h : a ∣ b) : a * (b / a) = b := Nat.mul_div_cancel' h

/-- **One phase** is `phInv`. -/
theorem phaseC_step {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) (hnG : 1 ≤ n * G) :
    RecStep I tab (phaseC l12) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (l.stepP (fun _ c => phInv K ρ G n L c)) (cPh Ksw τ l n G Br) := by
  have hV := hP.kv
  have hOK := hP.ok
  have hR4 := hV.R4
  have sA := rotY_RS (I := I) (tab := tab) (q := q) (fl := fl) hP (segTR_A (by positivity) hR4)
    (by decide +kernel) (by decide)
  have sB := rotY_RS (I := I) (tab := tab) (q := q) (fl := fl) hP (segTR_B (by positivity) hR4)
    (by decide +kernel) (by decide)
  have sS := rotS_RS (I := I) (tab := tab) (q := q) (fl := fl) hP
  have sC := rotC_RS (I := I) (tab := tab) (q := q) (fl := fl) hP
  have sw := swT_RS (I := I) (tab := tab) (q := q) (fl := fl) hP H hnG
  have S := RecStep.seq CEnv.stab sA (RecStep.seq CEnv.stab (thru_RS hP sw sS)
    (RecStep.seq CEnv.stab sB (thru_RS hP sw sC)))
  obtain ⟨c, hc, ec⟩ := hOK.kUY
  obtain ⟨b, hb, eb⟩ := hOK.kTY
  obtain ⟨k, hk, ek⟩ := hOK.kYB
  obtain ⟨k', hk', ek'⟩ := hOK.kUB
  have d1 : l.QL * l.sY * (l.sU / (l.QL * l.sY)) = l.sU := dvd_cancel hP ⟨c, by rw [ec]; ring⟩
  have d2 : l.QL * l.sY * (l.sT / (l.QL * l.sY)) = l.sT := dvd_cancel hP ⟨b, by rw [eb]; ring⟩
  have d3 : l.QC * l.sB * (l.sY * 2 ^ ρ / l.QC) = l.sY * 2 ^ ρ := by
    rw [hP.sb, mul_one]; exact dvd_cancel hP ⟨k * 2 ^ ρ, by rw [ek, hP.sb]; ring⟩
  have d4 : l.QC * l.sB * (l.sU / l.QC) = l.sU := by
    rw [hP.sb, mul_one]; exact dvd_cancel hP ⟨k', by rw [ek', hP.sb]; ring⟩
  have eA := Lay.rotA_pull (K := K) (ρ := ρ) hOK hV.qc hV.ql hV.hG d1 d2
  have eB := Lay.rotB_pull (K := K) (ρ := ρ) hOK hV.qc hV.ql hV.hG d1 d2
  have eS := Lay.rotS_pull (G := G) hOK hV.qc hV.ql hV.hK hV.hL d3
  have eC := Lay.rotC_pull hOK hV.qc hV.ql hV.hK hV.hG hV.hL d3 d4
  simp only [hP.sb] at eS eC
  refine S.congr (fun m => ?_) (le_of_eq (by unfold cPh; ring))
  try simp only [hP.sb]
  rw [eC, eB, eS, eA]
  exact Lay.phase_pull hOK hV.qc hV.ql m

/-- **The ten pulls** are `Psi`. -/
theorem psiC_step {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) (hnG : 1 ≤ n * G) :
    RecStep I tab (psiC l12) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (l.stepP (fun x c => Psi K ρ G n L x c)) (cPsi Ksw τ l n G Br) := by
  have hV := hP.kv
  have hOK := hP.ok
  have sP := phaseC_step (I := I) (q := q) (fl := fl) (L := L) hP H hnG
  have sw := swU_RS (I := I) (tab := tab) (q := q) (fl := fl) hP H hnG
  have s1 := rotL_RS (I := I) (tab := tab) (q := q) (fl := fl) hP 1 (Or.inl rfl) (by decide +kernel)
  have s2 := rotL_RS (I := I) (tab := tab) (q := q) (fl := fl) hP (-1) (Or.inr rfl)
    (by decide +kernel)
  have S := RecStep.seq CEnv.stab sP (RecStep.seq CEnv.stab (thru_RS hP sw s1)
    (RecStep.seq CEnv.stab sP (thru_RS hP sw s2)))
  obtain ⟨k, hk, ek⟩ := hOK.kXB
  have d3 : l.QC * l.sB * (l.sX * 2 ^ ρ / l.QC) = l.sX * 2 ^ ρ := by
    rw [hP.sb, mul_one]; exact dvd_cancel hP ⟨k * 2 ^ ρ, by rw [ek, hP.sb]; ring⟩
  have e1 := Lay.rotL_pull (G := G) hOK hV.qc hV.ql hV.hK hV.hL d3 1 (Or.inl rfl)
  have e2 := Lay.rotL_pull (G := G) hOK hV.qc hV.ql hV.hK hV.hL d3 (-1) (Or.inr rfl)
  simp only [hP.sb] at e1 e2
  refine S.congr (fun m => ?_) (le_of_eq (by unfold cPsi; ring))
  try simp only [hP.sb]
  rw [e2, e1]
  exact Lay.psi_pull hOK hV.qc hV.ql m

/-- **The correction** is `corrC`. -/
theorem corr_RS :
    RecStep I tab (corrLC (.reg kBr) (.reg kM) (.reg kA)) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (corrC l K ρ G n L) (cCo l K ρ G n L Br) := by
  intro t recs R0 ht hl hb h0
  have hM1 : 1 ≤ l.M := hP.ok.pM
  refine ⟨_, corrLC_runs hP.br hP.kv t recs hl (fun m => bnd_bits (hb m)) R0 h0 ht.key
    (by decide) (by unfold NoLow; decide) (by unfold NoLow; decide) (by unfold NoLow; decide)
    (sp_reg ht.br (by decide) (hP.zB (by nlinarith [hP.br])))
    (sp_reg ht.m (by decide) (hP.z3 (by omega)))
    (sp_reg ht.a (by decide) (le_trans (NLogN.zsz_natCast_le_self _) (by omega))), le_rfl⟩

/-- **The compact phase** is `TlS` on every record. -/
theorem compactC_step {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) (hnG : 1 ≤ n * G) :
    RecStep I tab (compactC l12) (fun t => CEnv t l K ρ G n q Br fl) l.M Br
      (l.stepP (fun x c => TlS K ρ n x c)) (cCmp Ksw τ l K ρ G n L Br) := by
  have hV := hP.kv
  refine (RecStep.seq CEnv.stab (psiC_step (I := I) (q := q) (fl := fl) hP H hnG)
    (corr_RS (I := I) (tab := tab) (q := q) (fl := fl) hP)).congr
    (fun m => psi_corrC hP.ok hV.qc hV.ql hV.hK hV.hL m) le_rfl

end Steps

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CCore
/-!
# Round six, compact controls (I2C): the compact Lemma 13 code

* `layR`: the record layout of a row addition (`T`, `U` in the top of `N0`, the bit-control field
  `Bk` at stride `1` in the bottom of `N3`, `X`, `Y` the slots `px`, `py`), `layR_ok`, `layR_kval`.
* `midC`: the compact phase (only when `n = f - 1 > 0`) and the top bit; `midC_step`: it is the
  record pull `stepP (TlS ∘ flipS)`.
* `l13C`: to bits, `midC`, from bits; **`l13C_runs`**: it is the row addition
  `permRecs (rect …) (rowAddAddr K ρ f px py)`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX NLogN.KFB NLogN.KFH IntMul RS AModel AModelL12 Butterfly

/-! ## The layout of a row addition -/

section Lay

variable {N0 N1 N2 N3 L G n : ℕ}

theorem strd_nest (h1 : 0 < N1) (h2 : 0 < N2) {t t' : Fin 3} (h : t < t') :
    ∃ k, 0 < k ∧ strd (gR N0 N1 N2 N3 L) t = strd (gR N0 N1 N2 N3 L) t' * 2 ^ L * k := by
  obtain ⟨a, ha⟩ := t
  obtain ⟨b, hb⟩ := t'
  simp only [Fin.mk_lt_mk] at h
  have : (a = 0 ∧ b = 1) ∨ (a = 0 ∧ b = 2) ∨ (a = 1 ∧ b = 2) := by omega
  rcases this with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact ⟨N1, h1, show (gR N0 N1 N2 N3 L).S0 = (gR N0 N1 N2 N3 L).S1 * 2 ^ L * N1 by
      simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩
  · exact ⟨2 ^ L * N2 * N1, by positivity, show (gR N0 N1 N2 N3 L).S0 =
      (gR N0 N1 N2 N3 L).S2 * 2 ^ L * (2 ^ L * N2 * N1) by simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩
  · exact ⟨N2, h2, show (gR N0 N1 N2 N3 L).S1 = (gR N0 N1 N2 N3 L).S2 * 2 ^ L * N2 by
      simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩

theorem strd_U (h1 : 0 < N1) (h2 : 0 < N2) (t : Fin 3) :
    ∃ k, 0 < k ∧ 2 ^ L * (gR N0 N1 N2 N3 L).S0 = strd (gR N0 N1 N2 N3 L) t * 2 ^ L * k := by
  obtain ⟨a, ha⟩ := t
  have : a = 0 ∨ a = 1 ∨ a = 2 := by omega
  rcases this with rfl | rfl | rfl
  · exact ⟨1, Nat.one_pos, show 2 ^ L * (gR N0 N1 N2 N3 L).S0 = (gR N0 N1 N2 N3 L).S0 * 2 ^ L * 1 by
      ring⟩
  · exact ⟨2 ^ L * N1, by positivity, show 2 ^ L * (gR N0 N1 N2 N3 L).S0 =
      (gR N0 N1 N2 N3 L).S1 * 2 ^ L * (2 ^ L * N1) by simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩
  · exact ⟨2 ^ L * 2 ^ L * N2 * N1, by positivity, show 2 ^ L * (gR N0 N1 N2 N3 L).S0 =
      (gR N0 N1 N2 N3 L).S2 * 2 ^ L * (2 ^ L * 2 ^ L * N2 * N1) by
      simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩

theorem strd_B {C : ℕ} (h1 : 0 < N1) (h2 : 0 < N2) {b : ℕ} (hb : 0 < b) (h3 : N3 = C * b)
    (t : Fin 3) : ∃ k, 0 < k ∧ strd (gR N0 N1 N2 N3 L) t = 1 * C * k := by
  obtain ⟨a, ha⟩ := t
  have : a = 0 ∨ a = 1 ∨ a = 2 := by omega
  subst h3
  rcases this with rfl | rfl | rfl
  · exact ⟨2 ^ L * (2 ^ L * b * N2) * N1, by positivity, show (gR N0 N1 N2 (C * b) L).S0 = _ by
      simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩
  · exact ⟨2 ^ L * b * N2, by positivity, show (gR N0 N1 N2 (C * b) L).S1 = _ by
      simp only [gR, Geo.S0, Geo.S1, Geo.S2]; ring⟩
  · exact ⟨b, hb, show (gR N0 N1 N2 (C * b) L).S2 = _ by simp only [gR, Geo.S2]; ring⟩

theorem qc_pos : 0 < Qc G n := by unfold Qc; positivity

theorem layR_ok {px py : Fin 3} (hpxy : px ≠ py) {a b : ℕ} (ha : 0 < a)
    (h0 : N0 = Qc G n * Qc G n * a) (h1 : 0 < N1) (h2 : 0 < N2) (hb : 0 < b)
    (h3 : N3 = Qc G n * b) : (layR N0 N1 N2 N3 L G n px py).OK := by
  have hC : 0 < Qc G n := qc_pos
  refine ⟨hC, by simp only [layR]; positivity, Nat.one_pos,
    ⟨1, Nat.one_pos, by simp only [layR]; ring⟩, strd_U h1 h2 px, strd_U h1 h2 py,
    strd_B h1 h2 hb h3 px, strd_B h1 h2 hb h3 py, ?_, ⟨a, ha, ?_⟩⟩
  · rcases lt_or_gt_of_ne hpxy with h | h
    · exact Or.inl (strd_nest h1 h2 h)
    · exact Or.inr (strd_nest h1 h2 h)
  · show (gR N0 N1 N2 N3 L).V = Qc G n * (2 ^ L * (gR N0 N1 N2 N3 L).S0) * Qc G n * a
    simp only [gR, Geo.V]; rw [h0]; ring

end Lay

namespace RP

variable {N0 N1 N2 N3 K f ρ G : ℕ} {px py : Fin 3} (hp : RP N0 N1 N2 N3 K f ρ G px py)
include hp

theorem ok : (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).OK := by
  obtain ⟨a, ha, ea⟩ := hp.n0
  obtain ⟨b, hb, eb⟩ := hp.n3
  exact layR_ok hp.hpxy ha ea hp.n1 hp.n2 hb eb

theorem pos : (gR N0 N1 N2 N3 (f * K)).Pos := by
  obtain ⟨a, ha, ea⟩ := hp.n0
  obtain ⟨b, hb, eb⟩ := hp.n3
  have := qc_pos (G := G) (n := f - 1)
  refine ⟨by simp only [gR]; positivity, ?_, hp.n1, hp.n2, ?_, Nat.one_pos⟩
  · show 0 < N0
    rw [ea]; exact Nat.mul_pos (Nat.mul_pos this this) ha
  · show 0 < N3
    rw [eb]; exact Nat.mul_pos this hb

theorem QQM : 2 ^ (f * K) * 2 ^ (f * K) ≤ (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).M := by
  have hg := hp.pos
  show 2 ^ (f * K) * 2 ^ (f * K) ≤ (gR N0 N1 N2 N3 (f * K)).V
  have e : (gR N0 N1 N2 N3 (f * K)).V = 2 ^ (f * K) * 2 ^ (f * K) *
      ((gR N0 N1 N2 N3 (f * K)).N0 * (gR N0 N1 N2 N3 (f * K)).N1 * (gR N0 N1 N2 N3 (f * K)).S1) := by
    simp only [Geo.V, Geo.S0]; simp only [gR]; ring
  rw [e]
  exact Nat.le_mul_of_pos_right _ (Nat.mul_pos (Nat.mul_pos hg.n0 hg.n1) hg.s1)

/-- The value facts of the compact phase. -/
theorem kval (Br : ℕ) (hBr : 1 ≤ Br) :
    KVal (layR N0 N1 N2 N3 (f * K) G (f - 1) px py) K ρ G (f - 1) (f * K)
      (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).M
      (zsz (((layR N0 N1 N2 N3 (f * K) G (f - 1) px py).M * Br : ℕ) : ℤ) + 3) := by
  have hK := hp.hK
  have hρ := hp.hρ
  have hf := hp.hf
  have hG := hp.hG
  have hGK := hp.hGK
  set n := f - 1 with hn
  have hfn : f = n + 1 := by omega
  have hnK : n * K + K = f * K := by rw [hfn]; ring
  have hp2 : ∀ {a b : ℕ}, a ≤ b → 2 ^ a ≤ 2 ^ b := fun h => Nat.pow_le_pow_right (by norm_num) h
  refine ⟨hp.ok, rfl, rfl, rfl, by omega, hG, by nlinarith, ?_, ?_, hp2 (by nlinarith),
    hp2 (by nlinarith), hp2 (by nlinarith), ?_, ?_, hp.QQM, ?_⟩
  · have e : 2 * 2 ^ G * 2 ^ ρ * (2 ^ K) ^ n = 2 ^ (1 + G + ρ + K * n) := by
      rw [pow_add, pow_add, pow_add, pow_mul]; ring
    rw [e, ← pow_add]
    exact hp2 (by nlinarith)
  · have e : 2 ^ ρ * (2 ^ K) ^ n = 2 ^ (ρ + K * n) := by rw [pow_add, pow_mul]
    rw [e, ← pow_add]
    exact hp2 (by nlinarith)
  · exact le_trans (Nat.lt_two_pow_self).le (hp2 (by nlinarith))
  · show (2 ^ G) ^ n ≤ 2 ^ (f * K)
    rw [← pow_mul]; exact hp2 (by nlinarith)
  · set V := (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).M
    have h1 := natAbs_lt_zsz (((V * Br : ℕ) : ℤ))
    rw [Int.natAbs_natCast] at h1
    have h2 : V ≤ V * Br := Nat.le_mul_of_pos_right _ hBr
    rw [pow_add]; omega

theorem phok (Br : ℕ) (hBr : 1 ≤ Br) :
    PhOK (layR N0 N1 N2 N3 (f * K) G (f - 1) px py) K ρ G (f - 1) (f * K) Br :=
  ⟨hp.kval Br hBr, rfl, hBr⟩

theorem topok (Br : ℕ) (hBr : 1 ≤ Br) :
    TopOK (layR N0 N1 N2 N3 (f * K) G (f - 1) px py) (f * K) (ρ + (f - 1) * K) Br := by
  refine ⟨hp.ok, rfl, ?_, hBr⟩
  have := hp.hρ; have := hp.hf
  have e : f * K = (f - 1) * K + K := by
    conv_lhs => rw [show f = (f - 1) + 1 by omega]
    ring
  omega

end RP

/-! ## The middle part: the compact phase and the top bit -/

section Mid

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}
  {l : Lay} {K ρ G n L Br : ℕ} {fl : ℤ}

theorem cW_nonneg {Ksw : ℝ} (h : 0 ≤ Ksw) : 0 ≤ cW Ksw τ l n G Br := by unfold cW; positivity

theorem cCmp_nonneg {Ksw : ℝ} (h : 0 ≤ Ksw) : 0 ≤ cCmp Ksw τ l K ρ G n L Br := by
  have := cW_nonneg (τ := τ) (l := l) (n := n) (G := G) (Br := Br) h
  unfold cCmp cPsi cPh cCo cR
  positivity

theorem TlS_zero (K ρ x : ℕ) (c : CS) : TlS K ρ 0 x c = c := by
  have h : Tl K ρ 0 x c.y = c.y := by
    rcases Nat.eq_zero_or_pos K with hK | hK
    · unfold Tl oT; simp [segSum]
    · rw [Tl_xor hK]; simp [selM]
  unfold TlS; rw [h]

/-- **The middle part** is `stepP (TlS ∘ flipS q)`. -/
theorem midC_step {Ksw : ℝ} (hKsw : 0 ≤ Ksw) (H : SwOK tab l12 τ Ksw) (hP : PhOK l K ρ G n L Br)
    (hT : TopOK l L (ρ + n * K) Br)
    (hpos : 0 < fl → ∃ k, 0 < k ∧ l.sX = l.sY * l.QL * k)
    (hneg : ¬ 0 < fl → ∃ k, 0 < k ∧ l.sY = l.sX * l.QL * k) :
    RecStep I tab (midC l12) (fun t => CEnv t l K ρ G n (ρ + n * K) Br fl) l.M Br
      (l.stepP (fun x c => TlS K ρ n x (flipS (ρ + n * K) x c)))
      (26 + cCmp Ksw τ l K ρ G n L Br + cTop Ksw l (ρ + n * K) Br) := by
  have hV := hP.kv
  have hOK := hP.ok
  have hq : ρ + n * K < L := hT.hq
  have T := topC_step (I := I) (K := K) (ρ := ρ) (G := G) (n := n) hKsw H hT hpos hneg
  have h0 := cCmp_nonneg (τ := τ) (l := l) (K := K) (ρ := ρ) (G := G) (n := n) (L := L) (Br := Br)
    hKsw
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn
    have S := RecStep.seq CEnv.stab (RecStep.iteF (r := kN) (f := NLogN.KFX.isPos) (p := compactC l12)
      (fun t ht => by rw [isPos_of ht.key.nn]; simp) (RecStep.skip (I := I) (tab := tab))) T
    refine S.congr (fun m => ?_) ?_
    · exact Lay.stepP_congr (F := flipS (ρ + 0 * K)) (fun x c hc => (TlS_zero K ρ x _).symm) hOK m
    · unfold cTop; linarith
  · have hnG : 1 ≤ n * G := Nat.mul_pos hn hV.hG
    have S := RecStep.seq CEnv.stab (RecStep.iteT (r := kN) (f := NLogN.KFX.isPos) (q := .skip)
      (fun t ht => by rw [isPos_of ht.key.nn]; simp; omega)
      (compactC_step (I := I) (tab := tab) (q := ρ + n * K) (fl := fl) hP H hnG)) T
    refine S.congr (fun m => ?_) ?_
    · exact Lay.stepP_stepP hOK (fun x c hc => Lay.box_TlS' hV.qc hV.ql hV.hK hV.hL hc x)
        (fun x c hc => Lay.flip_box hV.ql hq hc x) m
    · unfold cTop; linarith

end Mid

/-! ## The compact Lemma 13 code -/

theorem bits_recsB {R w M : ℕ} {zs : List GI} (m : ℕ) : KFL.Bits (recsB R w M zs m) := by
  unfold recsB; split_ifs
  · exact bits_bitsL _ _
  · intro z hz; exact Or.inl (List.eq_of_mem_replicate hz)

set_option maxHeartbeats 2000000 in
/-- **The compact Lemma 13 code runs** as the row addition. -/
theorem l13C_runs_sol_aux {Ksw : ℝ} (hKsw : 0 ≤ Ksw) {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1}
    {τ : ℝ} (H : SwOK tab l12 τ Ksw) {N0 N1 N2 N3 K f ρ G R w : ℕ} {px py : Fin 3} {fl : ℤ}
    (hp : RP N0 N1 N2 N3 K f ρ G px py) (hR : 1 ≤ R) (hfl : 0 < fl ↔ px < py)
    (I : List Sym) (t : IState HS) (zs : List GI) (R0 : List Item)
    (hE : CEnv t (layR N0 N1 N2 N3 (f * K) G (f - 1) px py) K ρ G (f - 1) (ρ + (f - 1) * K)
      (R * (2 * (w + 1))) fl)
    (hN : ∃ L, t.G sN = .int ((2 * (vol (rect N0 N1 N2 N3 (f * K)) * R) : ℕ) : ℤ) :: L)
    (hW : ∃ L, t.G sW = .int (w : ℤ) :: L)
    (hg0 : t.G 0 = ints (gflat zs) ++ R0) (hl : zs.length = vol (rect N0 N1 N2 N3 (f * K)) * R)
    (hGB : GB w zs) :
    ∃ c, IRuns I tab (l13C l12) t
        (t.upd 0 (ints (gflat (permRecs (rect N0 N1 N2 N3 (f * K))
          (rowAddAddr K ρ f px py) R zs)) ++ R0)) c ∧
      (c : ℝ) ≤ cL13 Ksw τ N0 N1 N2 N3 K f ρ G R w px py := by
  unfold cL13
  have hg : (geoB N0 N1 N2 N3 (f * K) R w).Pos := geoB_pos hp.pos.n0 hp.n1 hp.n2 hp.pos.n3 hR
  have hBr1 : 1 ≤ R * (2 * (w + 1)) := Nat.mul_pos hR (by omega)
  have hgV : (geoB N0 N1 N2 N3 (f * K) R w).recG.V = vol (rect N0 N1 N2 N3 (f * K)) :=
    (vol_rect (R := R) (w := w)).symm
  have hlM : (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).M = vol (rect N0 N1 N2 N3 (f * K)) := hgV
  have hxs : ∀ x ∈ gflat zs, zsz x ≤ w := zsz_gflat hGB
  have hlen : ∀ m, (recsB R w (vol (rect N0 N1 N2 N3 (f * K))) zs m).length = R * (2 * (w + 1)) :=
    fun m => length_recsB hl m
  have hfl1 : bitsL w (gflat zs) = flR (recsB R w (vol (rect N0 N1 N2 N3 (f * K))) zs)
      (vol (rect N0 N1 N2 N3 (f * K))) := bits_flR_recsB hl
  -- 1. to bits
  obtain ⟨L1, hL1⟩ := hN
  obtain ⟨L2, hL2⟩ := hW
  have S1 := toBitsU_spec (I := I) (iprog := tab) t (gflat zs) w hxs R0 hg0
    (L1 := L1) (L2 := L2) (by rw [length_gflat, hl]; exact hL1) hL2
  rw [length_gflat, hl, hfl1] at S1
  -- the facts of the layout
  have hT := hp.topok (R * (2 * (w + 1))) hBr1
  have hP := hp.phok (R * (2 * (w + 1))) hBr1
  have hpos : 0 < fl → ∃ k, 0 < k ∧ (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).sX =
      (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).sY *
        (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).QL * k := fun h =>
    strd_nest hp.n1 hp.n2 (hfl.1 h)
  have hneg : ¬ 0 < fl → ∃ k, 0 < k ∧ (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).sY =
      (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).sX *
        (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).QL * k := fun h => by
    have : py < px := by
      rcases lt_or_gt_of_ne hp.hpxy with h' | h'
      · exact absurd (hfl.2 h') h
      · exact h'
    exact strd_nest hp.n1 hp.n2 this
  have hπ : ∀ m, (layR N0 N1 N2 N3 (f * K) G (f - 1) px py).stepP
      (fun x c => TlS K ρ (f - 1) x (flipS (ρ + (f - 1) * K) x c)) m =
      phi (geoB N0 N1 N2 N3 (f * K) R w).recG (Fpp K ρ f px py) m := by
    intro m
    have e := tlflip_phi (g := (geoB N0 N1 N2 N3 (f * K) R w).recG) hg.recG hp.ok (K := K)
      (ρ := ρ) (n := f - 1) (L := f * K) (px := px) (py := py) rfl rfl rfl rfl hp.hpxy
      (by have := hp.hK; omega) hT.hq m
    rw [e, show f - 1 + 1 = f by have := hp.hf; omega]
  generalize layR N0 N1 N2 N3 (f * K) G (f - 1) px py = l at hE hP hT hpos hneg hπ hlM ⊢
  -- 2. the middle part
  obtain ⟨c2, S2, hc2⟩ := midC_step (I := I) (tab := tab) (τ := τ) hKsw H hP hT hpos hneg
    (t.upd 0 (ints (flR (recsB R w (vol (rect N0 N1 N2 N3 (f * K))) zs)
      (vol (rect N0 N1 N2 N3 (f * K)))) ++ R0))
    (recsB R w (vol (rect N0 N1 N2 N3 (f * K))) zs) R0
    (CEnv.stab t _ hE) hlen (fun m => bits_recsB m) (by rw [hlM]; simp [IState.upd_G])
  have hF : ∀ c, TV (geoB N0 N1 N2 N3 (f * K) R w).Q c →
      TV (geoB N0 N1 N2 N3 (f * K) R w).Q (Fpp K ρ f px py c) := fun c hc => TV_Fpp px py c hc
  have hz : flR (fun m => recsB R w (vol (rect N0 N1 N2 N3 (f * K))) zs
      (l.stepP (fun x c => TlS K ρ (f - 1) x (flipS (ρ + (f - 1) * K) x c)) m)) l.M =
      bitsL w (gflat (permRecs (rect N0 N1 N2 N3 (f * K)) (rowAddAddr K ρ f px py) R zs)) := by
    calc _ = flR (fun m => recsB R w (vol (rect N0 N1 N2 N3 (f * K))) zs
          (phi (geoB N0 N1 N2 N3 (f * K) R w).recG (Fpp K ρ f px py) m))
          (geoB N0 N1 N2 N3 (f * K) R w).recG.V := by
          rw [hlM, hgV]; exact flR_congr (fun m _ => by rw [hπ])
      _ = rixT (geoB N0 N1 N2 N3 (f * K) R w) (Fpp K ρ f px py)
          (flR (recsB R w (vol (rect N0 N1 N2 N3 (f * K))) zs)
            (geoB N0 N1 N2 N3 (f * K) R w).recG.V) :=
          (rixT_flR hg hF (fun m => hlen m)).symm
      _ = rixT (geoB N0 N1 N2 N3 (f * K) R w) (Fpp K ρ f px py) (bitsL w (gflat zs)) := by
          rw [hgV, hfl1]
      _ = _ := (bits_permRecs hp.pos.n0 hp.n1 hp.n2 hp.pos.n3 hR px py zs hl).symm
  rw [hz] at S2
  -- 3. from bits
  set P := permRecs (rect N0 N1 N2 N3 (f * K)) (rowAddAddr K ρ f px py) R zs with hPd
  have hPl : P.length = vol (rect N0 N1 N2 N3 (f * K)) * R := by
    have e1 := congrArg List.length hz
    rw [length_flR (fun m => hlen _), length_bitsL, length_gflat, hlM] at e1
    have : P.length * (2 * (w + 1)) = vol (rect N0 N1 N2 N3 (f * K)) * R * (2 * (w + 1)) := by
      calc P.length * (2 * (w + 1)) = 2 * P.length * (w + 1) := by ring
        _ = _ := e1.symm
        _ = _ := by ring
    exact Nat.eq_of_mul_eq_mul_right (by positivity) this
  have hPx : ∀ x ∈ gflat P, zsz x ≤ w := zsz_gflat (fun z hz => hGB z (mem_permRecs hz))
  have S3 := fromBitsU_spec (I := I) (iprog := tab)
    ((t.upd 0 (ints (flR (recsB R w (vol (rect N0 N1 N2 N3 (f * K))) zs)
      (vol (rect N0 N1 N2 N3 (f * K)))) ++ R0)).upd 0 (ints (bitsL w (gflat P)) ++ R0))
    (gflat P) w hPx R0 (by simp [IState.upd_G])
    (L1 := L1) (L2 := L2) (by
      rw [length_gflat, hPl, IState.upd_G, IState.upd_G, if_neg (by decide), if_neg (by decide)]
      exact hL1)
    (by rw [IState.upd_G, IState.upd_G, if_neg (by decide), if_neg (by decide)]; exact hL2)
  rw [length_gflat, hPl] at S3
  refine ⟨_, (S1.seq (S2.seq S3)).mono' ?_ le_rfl, ?_⟩
  · simp only [IState.upd_upd_same]
  · push_cast
    linarith

end IntMul.Kappa.R6.IL2C

