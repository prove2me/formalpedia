-- Source module: Solutions.R6BitLab
/-!
# Round six, bit side: `IdealOK` from frame labels and a scalar routing identity

A sufficient condition for `QHNet.IdealOK N` in the style of OpenAI's network theorem
(`AModel.network_realizes`), but with **multiplicative** (non-commuting) frames:

* every edge `e` has lower triangular rational Bruhat factors with unit diagonals mod `N`
  (`EdgesOK`); its frame matrix is `X_e = E₁ · σ_e · E₂` mod `N` (`edgeMat`);
* labels (frames) are tracked along the program: initially `1` on every wire, an edge on `w`
  multiplies the label of `w` on the left by `X_e`; every gate touches wires with equal labels,
  and the final label of every role `ρ w` is `swapMat` (`LabOK`);
* the scalar circuit (gates only; temporaries start at `0`) routes role `w` to role `ρ w`
  (`ScalarOK`).

Then `C.IdealOK N` (`idealOK_of_labels`). The physical content of each wire is the array
permutation `Φ(F) = pull (amap F⁻¹)` of its logical content (`frameArr`), `Φ` is multiplicative
(`frameArr_mul`), commutes with pointwise gates (`frameArr_gate`), and the ideal edge is
`Φ(X_e)` (`runArr_steps_eq`, from `AModel.linear_via_bruhat_array`).
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R] {m : ℕ}

/-! ## Frames as array permutations -/

section Frame

variable {sh : Shape} {N : ℕ} [NeZero N] (Λ : Layout sh (m + m) N)

lemma frameArr_mul (F G : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N)) (xs : List R) :
    frameArr Λ F (frameArr Λ G xs) = frameArr Λ (F * G) xs := by
  unfold frameArr
  rw [pull_comp _ _ (fun a ha => valid_amap Λ _ ha)]
  refine pull_congr (fun a ha => ?_) _ _
  rw [Function.comp_apply, amap_mul Λ _ _ ha, Matrix.mul_inv_rev]

lemma getD_frameArr (F : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N)) (xs : List R) {i : ℕ}
    (hi : i < vol sh) :
    (frameArr Λ F xs).getD i 0 = xs.getD (encode sh (amap Λ F⁻¹ (decode sh i))) 0 := by
  rw [List.getD_eq_getElem _ _ (by simpa using hi)]
  simp [frameArr, getElem_pull]

/-- Pointwise gates commute with frames. -/
lemma frameArr_gate {Wr : Type*} (g : Wr → R) (S : Finset Wr)
    (F : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N)) (st : Wr → List R) :
    List.ofFn (fun i : Fin (vol sh) => ∑ w' ∈ S, g w' * (frameArr Λ F (st w')).getD i 0) =
      frameArr Λ F (List.ofFn fun i : Fin (vol sh) => ∑ w' ∈ S, g w' * (st w').getD i 0) := by
  apply List.ext_getElem (by simp)
  intro i h₁ h₂
  simp only [List.length_ofFn] at h₁
  have hv := valid_amap Λ F⁻¹ (valid_decode h₁)
  have hlt := encode_lt hv
  rw [List.getElem_ofFn]
  simp only [frameArr, getElem_pull]
  rw [List.getD_eq_getElem _ _ (by simpa using hlt), List.getElem_ofFn]
  refine Finset.sum_congr rfl fun w' _ => ?_
  rw [← frameArr, getD_frameArr Λ F _ h₁]

lemma redM_lower {E : QMat2 m} (h : ∀ i j, i < j → E i j = 0) :
    ∀ i j, i < j → redM N E i j = 0 := by
  intro i j hij; simp [redM, h i j hij, redQ_zero]

/-- The ideal edge is the frame permutation of its matrix. -/
theorem runArr_steps_eq {e : Edge m} (he : EdgeOK N e) {xs : List R} (hxs : xs.length = vol sh) :
    runArr Λ 0 (e.steps N) xs = frameArr Λ (edgeMat N e) xs := by
  obtain ⟨h1, h2, h3, h4⟩ := he
  rw [frameArr, edgeMat, Edge.steps]
  exact (linear_via_bruhat_array Λ (redM_lower h1) (redM_lower h2) (fun i => by simpa [redM] using h3 i)
    (fun i => by simpa [redM] using h4 i) _ _ rfl 0 xs hxs).symm

end Frame

/-! ## Labels and the scalar circuit -/

namespace QHNet

variable {W T : ℕ}

end QHNet

/-! ## The invariant and `idealOK_of_labels` -/

section Main

variable {Wr : Type*} [Fintype Wr] [DecidableEq Wr] {sh : Shape} {N : ℕ} [NeZero N]
  (Λ : Layout sh (m + m) N)

/-- **Frame invariant.** Physical content = frame permutation (by the tracked label) of the
logical content. -/
theorem physical_inv_sol_aux :
    ∀ (prog : List (Instr Wr R m)), (∀ e ∈ progEdges prog, EdgeOK N e) →
      ∀ (st lg : Wr → List R) (F : Wr → Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N)),
        (∀ w, (lg w).length = vol sh) → (∀ w, st w = frameArr Λ (F w) (lg w)) →
        LabGates N prog F →
        ∀ w, netRunH (vol sh) (fun e => runArr Λ 0 (e.steps N)) prog st w =
          frameArr Λ (prog.foldl (labStepH N) F w)
            (netRunH (vol sh) (fun _ ys => ys) prog lg w) := by
  intro prog
  induction prog with
  | nil => intro _ st lg F _ hst _ w; exact hst w
  | cons ins l ih =>
    intro hE st lg F hlen hst hlab
    have hE' : ∀ e ∈ progEdges l, EdgeOK N e :=
      fun e he => hE e (by rw [progEdges_cons]; exact List.mem_append_right _ he)
    simp only [netRunH, List.foldl_cons] at ih ⊢
    apply ih hE'
    · intro w
      cases ins with
      | gate g S =>
        simp only [instrRun, gateApply]; split_ifs <;> simp [hlen w]
      | edge w0 e =>
        simp only [instrRun]
        by_cases h : w = w0
        · subst h; simp [hlen]
        · rw [Function.update_of_ne h]; exact hlen w
    · intro w
      cases ins with
      | gate g S =>
        have hS := hlab.1
        simp only [instrRun, gateApply, labStepH]
        split_ifs with hw
        · rw [← frameArr_gate Λ (fun w' => g w w') S (F w) lg]
          congr 1
          funext i
          refine Finset.sum_congr rfl fun w' hw' => ?_
          rw [hst w', hS w hw w' hw']
        · exact hst w
      | edge w0 e =>
        have he : EdgeOK N e := hE e (by rw [progEdges_cons]; simp [Instr.edgeOf])
        simp only [instrRun, labStepH]
        by_cases h : w = w0
        · subst h
          simp only [Function.update_self]
          rw [hst w, runArr_steps_eq Λ he (by simp), frameArr_mul]
        · rw [Function.update_of_ne h, Function.update_of_ne h, Function.update_of_ne h]
          exact hst w
    · exact hlab.2

end Main

end IntMul.Kappa.R6.Bit

end

