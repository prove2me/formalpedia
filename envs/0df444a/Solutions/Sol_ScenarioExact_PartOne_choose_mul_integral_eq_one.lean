theorem se_card_support {d m : ℕ} {Δ : Type*}
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hΘ_convex : Convex ℝ Θ)
    (ω : Fin m → Δ) (hΘδ_convex : ∀ i, Convex ℝ (Θδ (ω i)))
    (θstar : EuclideanSpace ℝ (Fin d)) (hθstar : IsSolution c Θ Θδ ω θstar) :
    numSupportConstraints c Θ Θδ ω θstar ≤ d := by
  classical
  by_contra hlt
  push Not at hlt
  unfold numSupportConstraints at hlt
  set S := (Finset.univ.filter fun i : Fin m => IsSupportConstraint c Θ Θδ ω θstar i) with hS
  obtain ⟨T, hTS, hTcard⟩ := Finset.exists_subset_card_eq (s := S) (n := d + 1) (by omega)
  let g : Fin (d + 1) → Fin m := fun j => ((T.equivFin.symm (Fin.cast hTcard.symm j)) : Fin m)
  have ginj : Function.Injective g := by
    intro a b hab
    have := Subtype.ext hab
    have := T.equivFin.symm.injective this
    exact Fin.cast_injective _ this
  have gS : ∀ j, IsSupportConstraint c Θ Θδ ω θstar (g j) := by
    intro j
    have h1 : g j ∈ S := hTS (T.equivFin.symm (Fin.cast hTcard.symm j)).2
    rw [hS, Finset.mem_filter] at h1
    exact h1.2
  choose θ hθΘ hθδ hθc using gS
  let p : Option (Fin (d + 1)) → EuclideanSpace ℝ (Fin d) := fun o =>
    match o with
    | none => θstar
    | some j => θ j
  have hfeas := hθstar.1
  have hstarΘ : θstar ∈ Θ := hfeas.1
  have hstarδ : ∀ l, θstar ∈ Θδ (ω l) := by
    intro l; exact Set.mem_iInter.mp hfeas.2 l
  have hnot : ¬ AffineIndependent ℝ p := by
    intro hai
    have := hai.card_le_finrank_succ
    have h2 := Submodule.finrank_le (vectorSpan ℝ (Set.range p))
    rw [finrank_euclideanSpace_fin] at h2
    simp at this
    omega
  obtain ⟨I, q, hq1, hq2⟩ := Convex.radon_partition hnot
  have hpΘ : ∀ o, p o ∈ Θ := by
    intro o; cases o with
    | none => exact hstarΘ
    | some j => exact hθΘ j
  have hqΘ : q ∈ Θ := (convexHull_min (by rintro _ ⟨o, -, rfl⟩; exact hpΘ o) hΘ_convex) hq1
  have hqδ : ∀ l, q ∈ Θδ (ω l) := by
    intro l
    by_cases hA : ∃ j, some j ∈ I ∧ g j = l
    · obtain ⟨j, hjI, hjl⟩ := hA
      refine (convexHull_min ?_ (hΘδ_convex _)) hq2
      rintro _ ⟨o, ho, rfl⟩
      cases o with
      | none => exact hstarδ l
      | some j' =>
        apply hθδ j' l
        intro h
        rw [← hjl] at h
        have := ginj h
        subst this
        exact ho hjI
    · push Not at hA
      refine (convexHull_min ?_ (hΘδ_convex _)) hq1
      rintro _ ⟨o, ho, rfl⟩
      cases o with
      | none => exact hstarδ l
      | some j' =>
        apply hθδ j' l
        intro h
        exact hA j' ho h.symm
  have hqfeas : q ∈ feasibleSet Θ Θδ ω := ⟨hqΘ, Set.mem_iInter.mpr hqδ⟩
  have hle := hθstar.2 q hqfeas
  have hconv : Convex ℝ {x : EuclideanSpace ℝ (Fin d) | inner ℝ c x < inner ℝ c θstar} :=
    convex_halfSpace_lt (f := fun x => inner ℝ c x) (innerₛₗ ℝ c).isLinear _
  have hlt' : inner ℝ c q < inner ℝ c θstar := by
    by_cases hn : none ∈ I
    · refine (convexHull_min ?_ hconv) hq2
      rintro _ ⟨o, ho, rfl⟩
      cases o with
      | none => exact absurd hn ho
      | some j => exact hθc j
    · refine (convexHull_min ?_ hconv) hq1
      rintro _ ⟨o, ho, rfl⟩
      cases o with
      | none => exact absurd ho hn
      | some j => exact hθc j
  linarith

/-- If the support constraints contain the `d` indices `g`, then the solution generated by
the constraints `g` is feasible for all constraints. -/
theorem se_helly {d N : ℕ} {Δ : Type*}
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hΘ_convex : Convex ℝ Θ) (hΘδ_convex : ∀ δ, Convex ℝ (Θδ δ))
    (hexu : ∀ (k : ℕ) (ω : Fin k → Δ), ∃! θ, IsSolution c Θ Θδ ω θ)
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d))
    (hθs : ∀ (k : ℕ) (ω : Fin k → Δ), IsSolution c Θ Θδ ω (θs k ω))
    (ω : Fin N → Δ) (g : Fin d → Fin N) (hg : Function.Injective g)
    (hsupp : ∀ i, IsSupportConstraint c Θ Θδ ω (θs N ω) (g i)) :
    ∀ j, θs d (ω ∘ g) ∈ Θδ (ω j) := by
  classical
  set θst := θs N ω with hθst
  set θ' := θs d (ω ∘ g) with hθ'
  have hst := hθs N ω
  have hsub := hθs d (ω ∘ g)
  have hstδ : ∀ j, θst ∈ Θδ (ω j) := fun j => Set.mem_iInter.mp hst.1.2 j
  have h'δ : ∀ i, θ' ∈ Θδ (ω (g i)) := fun i => Set.mem_iInter.mp hsub.1.2 i
  have hle : inner ℝ c θst ≤ inner ℝ c θ' := by
    by_contra hlt
    push Not at hlt
    let B : Set (EuclideanSpace ℝ (Fin d)) := {θ | ∀ j, j ∉ Set.range g → θ ∈ Θδ (ω j)}
    let ω' : Fin (d + 1) → Set (EuclideanSpace ℝ (Fin d)) :=
      Fin.cons B (fun i => Θδ (ω (g i)))
    have hconv : ∀ k, Convex ℝ ((id : Set (EuclideanSpace ℝ (Fin d)) → _) (ω' k)) := by
      intro k
      refine Fin.cases ?_ (fun i => ?_) k
      · simp only [id, ω', Fin.cons_zero]
        intro x hx y hy a b ha hb hab j hj
        exact hΘδ_convex _ (hx j hj) (hy j hj) ha hb hab
      · simp only [id, ω', Fin.cons_succ]
        exact hΘδ_convex _
    have hfull : ∀ θ, (∀ k, θ ∈ ω' k) → ∀ j, θ ∈ Θδ (ω j) := by
      intro θ hk j
      by_cases hj : j ∈ Set.range g
      · obtain ⟨i, rfl⟩ := hj
        have := hk i.succ
        simpa [ω'] using this
      · have := hk 0
        simp only [ω', Fin.cons_zero] at this
        exact this j hj
    have hsol : IsSolution c Θ id ω' θst := by
      refine ⟨⟨hst.1.1, Set.mem_iInter.mpr fun k => ?_⟩, fun θ hθ => ?_⟩
      · refine Fin.cases ?_ (fun i => ?_) k
        · simp only [id, ω', Fin.cons_zero]
          intro j _; exact hstδ j
        · simp only [id, ω', Fin.cons_succ]; exact hstδ _
      · apply hst.2
        exact ⟨hθ.1, Set.mem_iInter.mpr (hfull θ fun k => Set.mem_iInter.mp hθ.2 k)⟩
    have hcard := se_card_support c Θ id hΘ_convex ω' hconv θst hsol
    have hall : ∀ k, IsSupportConstraint c Θ id ω' θst k := by
      intro k
      refine Fin.cases ?_ (fun i => ?_) k
      · refine ⟨θ', hsub.1.1, fun k' hk' => ?_, hlt⟩
        obtain ⟨i, rfl⟩ := Fin.exists_succ_eq.mpr hk'
        simp only [id, ω', Fin.cons_succ]; exact h'δ i
      · obtain ⟨θ'', h1, h2, h3⟩ := hsupp i
        refine ⟨θ'', h1, fun k' hk' => ?_, h3⟩
        refine Fin.cases (motive := fun k' => k' ≠ i.succ → θ'' ∈ id (ω' k')) ?_ ?_ k' hk'
        · intro _
          simp only [id, ω', Fin.cons_zero]
          intro j hj
          apply h2 j
          intro hji; exact hj ⟨i, hji.symm⟩
        · intro i' hi'
          simp only [id, ω', Fin.cons_succ]
          apply h2
          intro hgi
          exact hi' (by rw [hg hgi])
    unfold numSupportConstraints at hcard
    rw [Finset.filter_true_of_mem (fun k _ => hall k), Finset.card_univ, Fintype.card_fin] at hcard
    omega
  have hle2 : inner ℝ c θ' ≤ inner ℝ c θst := by
    apply hsub.2
    exact ⟨hst.1.1, Set.mem_iInter.mpr fun i => hstδ (g i)⟩
  have hsol2 : IsSolution c Θ Θδ (ω ∘ g) θst := by
    refine ⟨⟨hst.1.1, Set.mem_iInter.mpr fun i => hstδ (g i)⟩, fun θ hθ => ?_⟩
    have := hsub.2 θ hθ
    linarith
  obtain ⟨u, -, hu⟩ := hexu d (ω ∘ g)
  have : θst = θ' := (hu _ hsol2).trans (hu _ hsub).symm
  intro j
  rw [← this]; exact hstδ j

/-- If the solution generated by the constraints `g` is feasible for all, it is the solution,
and all support constraints are among `g`. -/
theorem se_reduce {d N : ℕ} {Δ : Type*}
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hexu : ∀ (k : ℕ) (ω : Fin k → Δ), ∃! θ, IsSolution c Θ Θδ ω θ)
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d))
    (hθs : ∀ (k : ℕ) (ω : Fin k → Δ), IsSolution c Θ Θδ ω (θs k ω))
    (ω : Fin N → Δ) (g : Fin d → Fin N)
    (hfe : ∀ j, θs d (ω ∘ g) ∈ Θδ (ω j)) (θ0 : EuclideanSpace ℝ (Fin d))
    (hθ0 : IsSolution c Θ Θδ ω θ0) :
    θ0 = θs d (ω ∘ g) ∧
      ∀ j, IsSupportConstraint c Θ Θδ ω θ0 j → j ∈ Set.range g := by
  have hsub := hθs d (ω ∘ g)
  have hsol : IsSolution c Θ Θδ ω (θs d (ω ∘ g)) := by
    refine ⟨⟨hsub.1.1, Set.mem_iInter.mpr hfe⟩, fun θ hθ => ?_⟩
    apply hsub.2
    exact ⟨hθ.1, Set.mem_iInter.mpr fun i => Set.mem_iInter.mp hθ.2 (g i)⟩
  obtain ⟨u, -, hu⟩ := hexu N ω
  have heq : θ0 = θs d (ω ∘ g) := (hu _ hθ0).trans (hu _ hsol).symm
  refine ⟨heq, fun j hj => ?_⟩
  by_contra hjr
  obtain ⟨θ'', h1, h2, h3⟩ := hj
  have := hsub.2 θ'' ⟨h1, Set.mem_iInter.mpr fun i => h2 (g i) (fun h => hjr ⟨i, h⟩)⟩
  rw [heq] at h3
  linarith

theorem subset_Stilde_core {d m : ℕ} {Δ : Type*}
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hΘ_convex : Convex ℝ Θ) (hΘδ_convex : ∀ δ, Convex ℝ (Θδ δ))
    (hexu : ∀ (k : ℕ) (ω : Fin k → Δ), ∃! θ, IsSolution c Θ Θδ ω θ)
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d))
    (hθs : ∀ (k : ℕ) (ω : Fin k → Δ), IsSolution c Θ Θδ ω (θs k ω))
    (hm : d ≤ m) :
    S c Θ Θδ θs (Ibar d m) ⊆ Stilde Θδ θs hm := by
  classical
  intro ω hω j _
  have key := se_helly c Θ Θδ hΘ_convex hΘδ_convex hexu θs hθs ω (Fin.castLE hm)
    (Fin.castLE_injective hm) (fun i => by
      have hmem : Fin.castLE hm i ∈ Ibar d m := by
        simp [Ibar]
      rw [← hω] at hmem
      unfold supportIndexSet at hmem
      simpa using hmem) j
  exact key

theorem se_viol_meas {d : ℕ} {Δ : Type*} [MeasurableSpace Δ] (P : Measure Δ) [IsProbabilityMeasure P]
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hmeas : MeasurableSet {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2})
    {X : Type*} [MeasurableSpace X] (f : X → EuclideanSpace ℝ (Fin d)) (hf : Measurable f) :
    Measurable fun x => violation P Θδ (f x) := by
  have hC : MeasurableSet {q : X × Δ | f q.1 ∉ Θδ q.2} := by
    have : {q : X × Δ | f q.1 ∉ Θδ q.2} =
        (fun q : X × Δ => (f q.1, q.2)) ⁻¹'
          {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2}ᶜ := rfl
    rw [this]
    exact ((hf.comp measurable_fst).prodMk measurable_snd) hmeas.compl
  have := measurable_measure_prodMk_left (ν := P) hC
  exact this.ennreal_toReal

theorem se_viol_le {d : ℕ} {Δ : Type*} [MeasurableSpace Δ] (P : Measure Δ) [IsProbabilityMeasure P]
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d))) (θ : EuclideanSpace ℝ (Fin d)) :
    0 ≤ violation P Θδ θ ∧ violation P Θδ θ ≤ 1 := by
  refine ⟨ENNReal.toReal_nonneg, ?_⟩
  unfold violation
  have := ENNReal.toReal_mono ENNReal.one_ne_top (prob_le_one (μ := P) (s := violationSet Θδ θ))
  simpa using this

theorem se_good_prob {d : ℕ} {Δ : Type*} [MeasurableSpace Δ] (P : Measure Δ) [IsProbabilityMeasure P]
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hmeas : MeasurableSet {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2})
    (θ : EuclideanSpace ℝ (Fin d)) :
    MeasurableSet {δ | θ ∈ Θδ δ} ∧ P {δ | θ ∈ Θδ δ} = ENNReal.ofReal (1 - violation P Θδ θ) := by
  have hm : MeasurableSet {δ | θ ∈ Θδ δ} := measurable_prodMk_left hmeas
  refine ⟨hm, ?_⟩
  have hc : violationSet Θδ θ = {δ | θ ∈ Θδ δ}ᶜ := rfl
  have hP : P (violationSet Θδ θ) = 1 - P {δ | θ ∈ Θδ δ} := by rw [hc, prob_compl_eq_one_sub hm]
  unfold violation
  rw [hP, ENNReal.toReal_sub_of_le prob_le_one ENNReal.one_ne_top, ENNReal.toReal_one, sub_sub_cancel,
    ENNReal.ofReal_toReal (measure_ne_top _ _)]

theorem se_prob_E {d : ℕ} {Δ : Type*} [MeasurableSpace Δ] (P : Measure Δ) [IsProbabilityMeasure P]
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hmeas : MeasurableSet {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2})
    {N : ℕ} (I : Finset (Fin N)) (hI : I.card = d)
    (f : (Fin d → Δ) → EuclideanSpace ℝ (Fin d)) (hf : Measurable f)
    (hfe : ∀ x i, f x ∈ Θδ (x i)) (T : Set ℝ) (hT : MeasurableSet T) :
    Measure.pi (fun _ : Fin N => P)
      {ω | (∀ j, f (ω ∘ I.orderEmbOfFin hI) ∈ Θδ (ω j)) ∧
        violation P Θδ (f (ω ∘ I.orderEmbOfFin hI)) ∈ T} =
      ∫⁻ x, T.indicator (fun α => ENNReal.ofReal ((1 - α) ^ (N - d)))
        (violation P Θδ (f x)) ∂(Measure.pi fun _ : Fin d => P) := by
  classical
  set g := I.orderEmbOfFin hI with hg
  let e := MeasurableEquiv.piEquivPiSubtypeProd (fun _ : Fin N => Δ) (fun i => i ∈ I)
  have hmp := measurePreserving_piEquivPiSubtypeProd (fun _ : Fin N => P) (fun i => i ∈ I)
  let g' : Fin d → {i // i ∈ I} := fun k => ⟨g k, I.orderEmbOfFin_mem hI k⟩
  let E' : Set (({i // i ∈ I} → Δ) × ({i // i ∉ I} → Δ)) :=
    {q | (∀ j, f (q.1 ∘ g') ∈ Θδ (q.2 j)) ∧ violation P Θδ (f (q.1 ∘ g')) ∈ T}
  have hg'm : Measurable fun x : {i // i ∈ I} → Δ => x ∘ g' :=
    by fun_prop
  have hE' : MeasurableSet E' := by
    refine MeasurableSet.inter ?_ ?_
    · have hii : {q : ({i // i ∈ I} → Δ) × ({i // i ∉ I} → Δ) | ∀ j, f (q.1 ∘ g') ∈ Θδ (q.2 j)} =
          ⋂ j : {i // i ∉ I}, {q : ({i // i ∈ I} → Δ) × ({i // i ∉ I} → Δ) |
            f (q.1 ∘ g') ∈ Θδ (q.2 j)} := by ext; simp
      show MeasurableSet {q : ({i // i ∈ I} → Δ) × ({i // i ∉ I} → Δ) | ∀ j, f (q.1 ∘ g') ∈ Θδ (q.2 j)}
      rw [hii]
      refine MeasurableSet.iInter fun j => ?_
      have : {q : ({i // i ∈ I} → Δ) × ({i // i ∉ I} → Δ) | f (q.1 ∘ g') ∈ Θδ (q.2 j)} =
          (fun q : ({i // i ∈ I} → Δ) × ({i // i ∉ I} → Δ) => (f (q.1 ∘ g'), q.2 j)) ⁻¹'
            {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2} := rfl
      rw [this]
      exact ((hf.comp (hg'm.comp measurable_fst)).prodMk
        ((measurable_pi_apply j).comp measurable_snd)) hmeas
    · exact (se_viol_meas P Θδ hmeas _ (hf.comp (hg'm.comp measurable_fst))) hT
  have hEq : {ω : Fin N → Δ | (∀ j, f (ω ∘ g) ∈ Θδ (ω j)) ∧
        violation P Θδ (f (ω ∘ g)) ∈ T} = e ⁻¹' E' := by
    ext ω
    have h1 : (e ω).1 ∘ g' = ω ∘ g := rfl
    simp only [Set.mem_setOf_eq, Set.mem_preimage, E', h1]
    refine ⟨fun ⟨h, hv⟩ => ⟨fun j => h j, hv⟩, fun ⟨h, hv⟩ => ⟨fun j => ?_, hv⟩⟩
    by_cases hj : j ∈ I
    · have : j ∈ Set.range g := by rw [hg, Finset.range_orderEmbOfFin]; exact hj
      obtain ⟨k, rfl⟩ := this
      exact hfe (ω ∘ g) k
    · exact h ⟨j, hj⟩
  rw [hEq, hmp.measure_preimage hE'.nullMeasurableSet, Measure.prod_apply hE']
  -- inner measure
  have hinner : ∀ x : {i // i ∈ I} → Δ,
      (Measure.pi fun _ : {i // i ∉ I} => P) (Prod.mk x ⁻¹' E') =
        T.indicator (fun α => ENNReal.ofReal ((1 - α) ^ (N - d)))
          (violation P Θδ (f (x ∘ g'))) := by
    intro x
    by_cases hv : violation P Θδ (f (x ∘ g')) ∈ T
    · have : Prod.mk x ⁻¹' E' = Set.pi Set.univ (fun _ : {i // i ∉ I} => {δ | f (x ∘ g') ∈ Θδ δ}) := by
        ext y; simp [E', hv]
      rw [this, Measure.pi_pi, Set.indicator_of_mem hv, (se_good_prob P Θδ hmeas _).2,
        Finset.prod_const, Finset.card_univ, ← ENNReal.ofReal_pow
          (by linarith [(se_viol_le P Θδ (f (x ∘ g'))).2])]
      congr 2
      rw [Fintype.card_subtype_compl, Fintype.card_coe, hI, Fintype.card_fin]
    · have : Prod.mk x ⁻¹' E' = ∅ := by
        ext y; simp [E', hv]
      rw [this, measure_empty, Set.indicator_of_notMem hv]
  simp_rw [hinner]
  -- change of variables
  let e2 := MeasurableEquiv.piCongrLeft (fun _ : {i // i ∈ I} => Δ) (I.orderIsoOfFin hI).toEquiv
  have hmp2 := measurePreserving_piCongrLeft (fun _ : {i // i ∈ I} => P) (I.orderIsoOfFin hI).toEquiv
  have hpt : ∀ z, T.indicator (fun α => ENNReal.ofReal ((1 - α) ^ (N - d)))
      (violation P Θδ (f ((e2 z) ∘ g'))) = T.indicator (fun α => ENNReal.ofReal ((1 - α) ^ (N - d)))
      (violation P Θδ (f z)) := by
    intro z
    have : (e2 z) ∘ g' = z := by
      funext k
      have hk : g' k = (I.orderIsoOfFin hI).toEquiv k := by
        apply Subtype.ext
        simp [g', hg, Finset.coe_orderIsoOfFin_apply]
      simp only [Function.comp_apply, hk]
      exact MeasurableEquiv.piCongrLeft_apply_apply (β := fun _ => Δ) (I.orderIsoOfFin hI).toEquiv z k
    rw [this]
  have key := hmp2.lintegral_comp_emb e2.measurableEmbedding (fun x =>
    T.indicator (fun α => ENNReal.ofReal ((1 - α) ^ (N - d))) (violation P Θδ (f (x ∘ g'))))
  rw [← lintegral_congr hpt, key]
  congr 2
  exact Subsingleton.elim _ _

theorem se_ae_unique {d : ℕ} {Δ : Type*} [MeasurableSpace Δ]
    (P : Measure Δ) [IsProbabilityMeasure P]
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hΘ_convex : Convex ℝ Θ) (hΘδ_convex : ∀ δ, Convex ℝ (Θδ δ))
    (hexu : ∀ (k : ℕ) (ω : Fin k → Δ), ∃! θ, IsSolution c Θ Θδ ω θ)
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d))
    (hθs : ∀ (k : ℕ) (ω : Fin k → Δ), IsSolution c Θ Θδ ω (θs k ω))
    (hfs : FullySupported c Θ Θδ P) {N : ℕ} (hN : d ≤ N) :
    ∀ᵐ ω ∂(Measure.pi fun _ : Fin N => P),
      ∃ hI : (supportIndexSet c Θ Θδ ω (θs N ω)).card = d,
        (∀ (J : Finset (Fin N)) (hJ : J.card = d),
          (∀ j, θs d (ω ∘ J.orderEmbOfFin hJ) ∈ Θδ (ω j)) ↔ J = supportIndexSet c Θ Θδ ω (θs N ω)) ∧
        θs N ω = θs d (ω ∘ (supportIndexSet c Θ Θδ ω (θs N ω)).orderEmbOfFin hI) := by
  classical
  filter_upwards [hfs N hN] with ω hω
  have hcard := hω (θs N ω) (hθs N ω)
  set I := supportIndexSet c Θ Θδ ω (θs N ω) with hIdef
  have hI : I.card = d := by
    rw [← hcard, hIdef]; unfold supportIndexSet numSupportConstraints; rfl
  have hmemI : ∀ i, i ∈ I ↔ IsSupportConstraint c Θ Θδ ω (θs N ω) i := by
    intro i; rw [hIdef]; unfold supportIndexSet; simp
  have hfeasI : ∀ j, θs d (ω ∘ I.orderEmbOfFin hI) ∈ Θδ (ω j) :=
    se_helly c Θ Θδ hΘ_convex hΘδ_convex hexu θs hθs ω _ (I.orderEmbOfFin hI).injective
      (fun k => (hmemI _).1 (I.orderEmbOfFin_mem hI k))
  refine ⟨hI, fun J hJ => ⟨fun hf => ?_, fun h => ?_⟩, ?_⟩
  · have := (se_reduce c Θ Θδ hexu θs hθs ω _ hf (θs N ω) (hθs N ω)).2
    have hsub : I ⊆ J := by
      intro i hi
      have := this i ((hmemI i).1 hi)
      rwa [Finset.range_orderEmbOfFin] at this
    exact (Finset.eq_of_subset_of_card_le hsub (by rw [hI, hJ])).symm
  · subst h; exact hfeasI
  · exact (se_reduce c Θ Θδ hexu θs hθs ω _ hfeasI (θs N ω) (hθs N ω)).1

theorem se_E_meas {d : ℕ} {Δ : Type*} [MeasurableSpace Δ] (P : Measure Δ) [IsProbabilityMeasure P]
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hmeas : MeasurableSet {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2})
    {N : ℕ} (g : Fin d → Fin N)
    (f : (Fin d → Δ) → EuclideanSpace ℝ (Fin d)) (hf : Measurable f) (T : Set ℝ) (hT : MeasurableSet T) :
    MeasurableSet {ω : Fin N → Δ | (∀ j, f (ω ∘ g) ∈ Θδ (ω j)) ∧ violation P Θδ (f (ω ∘ g)) ∈ T} := by
  have hgm : Measurable fun ω : Fin N → Δ => ω ∘ g := by fun_prop
  refine MeasurableSet.inter ?_ ?_
  · have hii : {ω : Fin N → Δ | ∀ j, f (ω ∘ g) ∈ Θδ (ω j)} =
        ⋂ j, {ω : Fin N → Δ | f (ω ∘ g) ∈ Θδ (ω j)} := by ext; simp
    show MeasurableSet {ω : Fin N → Δ | ∀ j, f (ω ∘ g) ∈ Θδ (ω j)}
    rw [hii]
    refine MeasurableSet.iInter fun j => ?_
    have : {ω : Fin N → Δ | f (ω ∘ g) ∈ Θδ (ω j)} =
        (fun ω : Fin N → Δ => (f (ω ∘ g), ω j)) ⁻¹'
          {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2} := rfl
    rw [this]
    exact ((hf.comp hgm).prodMk (measurable_pi_apply j)) hmeas
  · exact (se_viol_meas P Θδ hmeas _ (hf.comp hgm)) hT

theorem se_tail {d : ℕ} {Δ : Type*} [MeasurableSpace Δ]
    (P : Measure Δ) [IsProbabilityMeasure P]
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hΘ_convex : Convex ℝ Θ) (hΘδ_convex : ∀ δ, Convex ℝ (Θδ δ))
    (hexu : ∀ (k : ℕ) (ω : Fin k → Δ), ∃! θ, IsSolution c Θ Θδ ω θ)
    (hmeas : MeasurableSet {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2})
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d))
    (hθs : ∀ (k : ℕ) (ω : Fin k → Δ), IsSolution c Θ Θδ ω (θs k ω))
    (hfs : FullySupported c Θ Θδ P) {N : ℕ} (hN : d ≤ N)
    (hmd : Measurable (θs d)) (hmN : Measurable (θs N)) (T : Set ℝ) (hT : MeasurableSet T) :
    Measure.pi (fun _ : Fin N => P) {ω | violation P Θδ (θs N ω) ∈ T} =
      (N.choose d : ℝ≥0∞) * ∫⁻ x, T.indicator (fun α => ENNReal.ofReal ((1 - α) ^ (N - d)))
        (violation P Θδ (θs d x)) ∂(Measure.pi fun _ : Fin d => P) := by
  classical
  set μ := Measure.pi (fun _ : Fin N => P) with hμ
  let E : Finset (Fin N) → Set (Fin N → Δ) := fun J =>
    if h : J.card = d then
      {ω | (∀ j, θs d (ω ∘ J.orderEmbOfFin h) ∈ Θδ (ω j)) ∧
        violation P Θδ (θs d (ω ∘ J.orderEmbOfFin h)) ∈ T}
    else ∅
  have hEm : ∀ J, MeasurableSet (E J) := by
    intro J
    by_cases h : J.card = d
    · simp only [E, dif_pos h]; exact se_E_meas P Θδ hmeas _ _ hmd T hT
    · simp only [E, dif_neg h]; exact MeasurableSet.empty
  have hEval : ∀ J ∈ (Finset.univ : Finset (Fin N)).powersetCard d,
      μ (E J) = ∫⁻ x, T.indicator (fun α => ENNReal.ofReal ((1 - α) ^ (N - d)))
        (violation P Θδ (θs d x)) ∂(Measure.pi fun _ : Fin d => P) := by
    intro J hJ
    have h : J.card = d := (Finset.mem_powersetCard.mp hJ).2
    simp only [E, dif_pos h]
    exact se_prob_E P Θδ hmeas J h (θs d) hmd (fun x i => Set.mem_iInter.mp (hθs d x).1.2 i) T hT
  have hA : MeasurableSet {ω | violation P Θδ (θs N ω) ∈ T} :=
    (se_viol_meas P Θδ hmeas _ hmN) hT
  have hsum : μ {ω | violation P Θδ (θs N ω) ∈ T} =
      ∑ J ∈ (Finset.univ : Finset (Fin N)).powersetCard d, μ (E J) := by
    rw [← lintegral_indicator_one hA]
    simp_rw [← lintegral_indicator_one (hEm _)]
    rw [← lintegral_finset_sum _ (fun J _ => measurable_one.indicator (hEm J))]
    apply lintegral_congr_ae
    filter_upwards [se_ae_unique P c Θ Θδ hΘ_convex hΘδ_convex hexu θs hθs hfs hN]
      with ω ⟨hI, hiff, heq⟩
    set I := supportIndexSet c Θ Θδ ω (θs N ω) with hIdef
    rw [Finset.sum_eq_single I]
    · simp only [E, dif_pos hI, Set.indicator_apply, Set.mem_setOf_eq]
      by_cases hv : violation P Θδ (θs N ω) ∈ T
      · rw [if_pos hv, if_pos ⟨(hiff I hI).2 rfl, heq ▸ hv⟩]
      · rw [if_neg hv, if_neg (fun hm => hv (heq ▸ hm.2))]
    · intro J hJ hJI
      have h : J.card = d := (Finset.mem_powersetCard.mp hJ).2
      simp only [E, dif_pos h]
      rw [Set.indicator_of_notMem]
      intro hm; exact hJI ((hiff J h).1 hm.1)
    · intro hI'
      exfalso; exact hI' (Finset.mem_powersetCard.mpr ⟨Finset.subset_univ _, hI⟩)
  rw [hsum, Finset.sum_congr rfl hEval, Finset.sum_const, Finset.card_powersetCard,
    Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]

theorem se_law_int {d : ℕ} {Δ : Type*} [MeasurableSpace Δ] (P : Measure Δ) [IsProbabilityMeasure P]
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hmeas : MeasurableSet {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2})
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d)) (hmd : Measurable (θs d))
    (s : Set ℝ) (hs : MeasurableSet s) (h : ℝ → ℝ≥0∞) (hh : Measurable h) :
    ∫⁻ α in s, h α ∂(violationLaw P Θδ θs) =
      ∫⁻ x, s.indicator h (violation P Θδ (θs d x)) ∂(Measure.pi fun _ : Fin d => P) := by
  rw [← lintegral_indicator hs, violationLaw, lintegral_map (hh.indicator hs)
    (se_viol_meas P Θδ hmeas _ hmd)]

theorem tail_core
    {d : ℕ} {Δ : Type*} [MeasurableSpace Δ]
    (P : Measure Δ) [IsProbabilityMeasure P]
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hΘ_convex : Convex ℝ Θ) (hΘδ_convex : ∀ δ, Convex ℝ (Θδ δ))
    (hexu : ∀ (k : ℕ) (ω : Fin k → Δ), ∃! θ, IsSolution c Θ Θδ ω θ)
    (hmeas : MeasurableSet {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2})
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d))
    (hθs : ∀ (k : ℕ) (ω : Fin k → Δ), IsSolution c Θ Θδ ω (θs k ω))
    (hfs : FullySupported c Θ Θδ P)
    {N : ℕ} (hN : d ≤ N) (hmd : Measurable (θs d)) (hmN : Measurable (θs N)) (ε : ℝ) :
    Measure.pi (fun _ : Fin N => P) {ω | ε < violation P Θδ (θs N ω)} =
      (N.choose d : ℝ≥0∞) *
        ∫⁻ α in Set.Ioc ε 1, ENNReal.ofReal ((1 - α) ^ (N - d)) ∂(violationLaw P Θδ θs) := by
  have h1 := se_tail P c Θ Θδ hΘ_convex hΘδ_convex hexu hmeas θs hθs hfs hN hmd hmN (Set.Ioi ε)
    measurableSet_Ioi
  have hh : Measurable fun α : ℝ => ENNReal.ofReal ((1 - α) ^ (N - d)) := by fun_prop
  rw [se_law_int P Θδ hmeas θs hmd _ measurableSet_Ioc _ hh]
  refine h1.trans ?_
  congr 1
  apply lintegral_congr
  intro x
  have hv := se_viol_le P Θδ (θs d x)
  by_cases h : ε < violation P Θδ (θs d x)
  · rw [Set.indicator_of_mem (show _ ∈ Set.Ioi ε from h),
      Set.indicator_of_mem (show _ ∈ Set.Ioc ε 1 from ⟨h, hv.2⟩)]
  · rw [Set.indicator_of_notMem (show _ ∉ Set.Ioi ε from h),
      Set.indicator_of_notMem (show _ ∉ Set.Ioc ε 1 from fun h' => h h'.1)]

theorem one_core
    {d : ℕ} {Δ : Type*} [MeasurableSpace Δ]
    (P : Measure Δ) [IsProbabilityMeasure P]
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hΘ_convex : Convex ℝ Θ) (hΘδ_convex : ∀ δ, Convex ℝ (Θδ δ))
    (hexu : ∀ (k : ℕ) (ω : Fin k → Δ), ∃! θ, IsSolution c Θ Θδ ω θ)
    (hmeas : MeasurableSet {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2})
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d))
    (hθs : ∀ (k : ℕ) (ω : Fin k → Δ), IsSolution c Θ Θδ ω (θs k ω))
    (hfs : FullySupported c Θ Θδ P)
    (hθs_meas : ∀ k, Measurable (θs k)) :
    ∀ m : ℕ, d ≤ m →
      (m.choose d : ℝ≥0∞) *
          ∫⁻ α in Set.Icc (0 : ℝ) 1, ENNReal.ofReal ((1 - α) ^ (m - d)) ∂(violationLaw P Θδ θs) =
        1 := by
  intro m hm
  have h1 := se_tail P c Θ Θδ hΘ_convex hΘδ_convex hexu hmeas θs hθs hfs hm (hθs_meas d)
    (hθs_meas m) Set.univ MeasurableSet.univ
  have hh : Measurable fun α : ℝ => ENNReal.ofReal ((1 - α) ^ (m - d)) := by fun_prop
  rw [se_law_int P Θδ hmeas θs (hθs_meas d) _ measurableSet_Icc _ hh]
  have e1 : {ω : Fin m → Δ | violation P Θδ (θs m ω) ∈ Set.univ} = Set.univ := by ext; simp
  rw [e1, measure_univ] at h1
  rw [h1]
  congr 1
  apply lintegral_congr
  intro x
  have hv := se_viol_le P Θδ (θs d x)
  rw [Set.indicator_of_mem (Set.mem_univ _), Set.indicator_of_mem (show _ ∈ Set.Icc (0:ℝ) 1 from hv)]

theorem probS_core
    {d : ℕ} {Δ : Type*} [MeasurableSpace Δ]
    (P : Measure Δ) [IsProbabilityMeasure P]
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hΘ_convex : Convex ℝ Θ) (hΘδ_convex : ∀ δ, Convex ℝ (Θδ δ))
    (hexu : ∀ (k : ℕ) (ω : Fin k → Δ), ∃! θ, IsSolution c Θ Θδ ω θ)
    (hmeas : MeasurableSet {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2})
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d))
    (hθs : ∀ (k : ℕ) (ω : Fin k → Δ), IsSolution c Θ Θδ ω (θs k ω))
    (hθs_meas : ∀ k, Measurable (θs k))
    (hfs : FullySupported c Θ Θδ P)
    {m : ℕ} (hm : d ≤ m) (I : Finset (Fin m)) (hI : I.card = d) :
    Measure.pi (fun _ : Fin m => P) (S c Θ Θδ θs I) =
      ∫⁻ α in Set.Icc (0 : ℝ) 1, ENNReal.ofReal ((1 - α) ^ (m - d)) ∂(violationLaw P Θδ θs) := by
  have hh : Measurable fun α : ℝ => ENNReal.ofReal ((1 - α) ^ (m - d)) := by fun_prop
  rw [se_law_int P Θδ hmeas θs (hθs_meas d) _ measurableSet_Icc _ hh]
  have hae : (S c Θ Θδ θs I : Set (Fin m → Δ)) =ᵐ[Measure.pi (fun _ : Fin m => P)]
      {ω | (∀ j, θs d (ω ∘ I.orderEmbOfFin hI) ∈ Θδ (ω j)) ∧
        violation P Θδ (θs d (ω ∘ I.orderEmbOfFin hI)) ∈ Set.Icc (0:ℝ) 1} := by
    filter_upwards [se_ae_unique P c Θ Θδ hΘ_convex hΘδ_convex hexu θs hθs hfs hm]
      with ω ⟨hI', hiff, heq⟩
    apply propext
    change supportIndexSet c Θ Θδ ω (θs m ω) = I ↔ (_ ∧ _)
    rw [hiff I hI]
    exact ⟨fun h => ⟨h.symm, se_viol_le P Θδ _⟩, fun h => h.1.symm⟩
  rw [measure_congr hae, se_prob_E P Θδ hmeas I hI (θs d) (hθs_meas d)
    (fun x i => Set.mem_iInter.mp (hθs d x).1.2 i) _ measurableSet_Icc]

end ScenarioExact.PartOne

open ScenarioExact.PartOne


theorem solution
    {d : ℕ} {Δ : Type*} [MeasurableSpace Δ]
    (P : Measure Δ) [IsProbabilityMeasure P]
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    -- Assumption 1 / (1.1): `𝒳` and every `𝒳_δ` are convex and closed
    (hΘ_convex : Convex ℝ Θ) (hΘ_closed : IsClosed Θ)
    (hΘδ_convex : ∀ δ, Convex ℝ (Θδ δ)) (hΘδ_closed : ∀ δ, IsClosed (Θδ δ))
    -- Assumption 1: for every number `k` of constraints and every sample, `P_k` has a unique solution
    (hexu : ∀ (k : ℕ) (ω : Fin k → Δ), ∃! θ, IsSolution c Θ Θδ ω θ)
    -- measurability ("assumed for granted", p. 4): the constraint relation is jointly measurable
    (hmeas : MeasurableSet {p : EuclideanSpace ℝ (Fin d) × Δ | p.1 ∈ Θδ p.2})
    -- `θs k ω` is the solution `x*_k` of `P_k` with the sampled constraints `ω`; measurable in `ω`
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d))
    (hθs : ∀ (k : ℕ) (ω : Fin k → Δ), IsSolution c Θ Θδ ω (θs k ω))
    (hθs_meas : ∀ k, Measurable (θs k))
    -- Definition 2.3: the problem is fully-supported
    (hfs : FullySupported c Θ Θδ P) :
    ∀ m : ℕ, d ≤ m →
      (m.choose d : ℝ≥0∞) *
          ∫⁻ α in Set.Icc (0 : ℝ) 1, ENNReal.ofReal ((1 - α) ^ (m - d)) ∂(violationLaw P Θδ θs) =
        1 := by
  exact one_core P c Θ Θδ hΘ_convex hΘδ_convex hexu hmeas θs hθs hfs hθs_meas
