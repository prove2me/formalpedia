open MIPStarRE.QPBT
open LIDT.MIPStarRE.LDT

theorem MIPStarRE.QPBT.dLinePointDist_zero_direction_mass_le (L : _root_.MIPStarRE.QPBT.LdParams) :
    _root_.LIDT.MIPStarRE.LDT.avgOver (_root_.MIPStarRE.QPBT.dLinePointDist L) (fun sample =>
      if sample.1.direction = 0 then 1 else 0) ≤
      1 / Fintype.card (_root_.MIPStarRE.QPBT.ScalarQ L) := by sorry
