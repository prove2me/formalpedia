variable {p : ℕ} [Fact p.Prime] {N r n : ℕ}

theorem Formalism.InvariantFactorPaths.PW.hwc_iff (LL : Letters N) (j : ℕ) (Cs : Finset (Fin r)) (la : Fin r → ℤ)
    (x : MvPolynomial (Fin N × Fin r) ℚ_[p]) :
    x ∈ HWC p LL j Cs la ↔ (GAe p LL j (enumC Cs)).IsHW (la ∘ enumC Cs) x := by sorry
