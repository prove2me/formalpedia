    (17, ((2 ^ (q.e - 1) : ℕ) : ℤ)), (18, ((2 ^ q.e : ℕ) : ℤ)),
    (32, 2 ^ q.P), (33, 2 ^ q.fn), (34, (q.r : ℤ)), (52, 2 ^ (2 * q.r * q.P)), (53, 2 ^ q.fn + 1),
    (35, ((2 ^ q.logOuter : ℕ) : ℤ)), (36, (kb : ℤ)), (37, ((q.K - 1 : ℕ) : ℤ)),
