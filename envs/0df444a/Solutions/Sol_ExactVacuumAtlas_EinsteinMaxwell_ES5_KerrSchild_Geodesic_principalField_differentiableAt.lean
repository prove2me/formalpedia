theorem solution (hP : PaperData I f m N w p a) {x : Pt 5}
    (hx1 : x 1 ∈ I) {lam : ℝ → ℝ} (hlam : DifferentiableAt ℝ lam (x 1)) (i : Fin 5) :
    DifferentiableAt ℝ (fun y => principalField f m N w p a lam y i) x := by
  have he : DifferentiableAt ℝ (eFun w p a) (x 1) := (hasDerivAt_eFun hP hx1).differentiableAt
  have hT : DifferentiableAt ℝ (fun r => eFun w p a r / f r) (x 1) :=
    he.div (hP.df hx1).differentiableAt (hP.nf _ hx1)
  have hH : DifferentiableAt ℝ (Hfun m N) (x 1) := (hasDerivAt_Hfun hP hx1).differentiableAt
  have hHn : Hfun m N (x 1) ≠ 0 := div_ne_zero (hP.nN _ hx1) (hP.nm _ hx1)
  have hΩ : DifferentiableAt ℝ
      (fun r => w r * (eFun w p a r / f r) - deriv a r / Hfun m N r) (x 1) :=
    ((hP.dw hx1).differentiableAt.mul hT).sub ((hP.d2a hx1).differentiableAt.div hH hHn)
  simp only [principalField_apply]
  fin_cases i
  · exact radial_differentiableAt hT
  · exact radial_differentiableAt hlam
  · exact differentiableAt_const _
  · exact radial_differentiableAt hΩ
  · exact radial_differentiableAt hΩ
