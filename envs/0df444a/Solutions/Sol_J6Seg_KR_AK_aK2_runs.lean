variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

lemma bnd_gflat2 {B : ℕ} : ∀ {u : List GI}, GB B u → Bnd B (gflat u)
  | [], _ => by intro a ha; simp at ha
  | w :: u, h => by
    intro a ha
    rw [gflat_cons] at ha
    rcases List.mem_cons.1 ha with rfl | ha
    · exact (h w (by simp)).1
    rcases List.mem_cons.1 ha with rfl | ha
    · exact (h w (by simp)).2
    · exact bnd_gflat2 (fun z hz => h z (List.mem_cons_of_mem _ hz)) a ha

lemma AB_padG2 {X : ℤ} (hX : 0 ≤ X) {r : ℕ} {y : List GI} (h : AB X y) : AB X (J6Seg.padG r y) := by
  intro w hw
  rcases List.mem_append.1 hw with hw | hw
  · exact h w hw
  · rw [List.eq_of_mem_replicate hw]; simpa using hX

set_option maxHeartbeats 8000000 in
/-- **The `A` kernel v2 in IL.** -/
theorem aK2_runs_sol_aux {M : MulSpec} {pM : Fin Pp} (hM : MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {w2 bk win Q pk b φ1 φ2 B BH : ℕ}
    (hΦ1 : ∀ x y : ℤ, zsz x ≤ B → zsz y ≤ B → M.Φ x y ≤ φ1)
    (hΦ2 : ∀ x y : ℤ, zsz x ≤ b * (2 * (w2 + bk)) + 2 → zsz y ≤ b * (2 * (w2 + bk)) + 2 →
      M.Φ x y ≤ φ2)
    (hb : 1 ≤ b) (hn1 : 1 ≤ w2 + bk) (hbig : 2 * (2 * (w2 + bk)) * 2 ^ (2 * pk) < 2 ^ (b - 1))
    (hw2 : w2 ≤ win) (hbk : bk ≤ win)
    {aTab rTab cTab : List ℤ} (hal : aTab.length = w2) (hrl : rTab.length = w2 + bk)
    (hcl : cTab.length = bk)
    {Ka Kr Kc X0 : ℤ} (hKa : 0 ≤ Ka) (hKr : 0 ≤ Kr) (hKc : 0 ≤ Kc) (hX0 : 0 ≤ X0)
    (hta : TB (2 ^ Q * Ka) aTab) (htr : TB (2 ^ Q * Kr) rTab) (htc : TB (2 ^ Q * Kc) cTab)
    (hea : 2 ^ Q * Ka ≤ 2 ^ pk) (her : 2 ^ Q * Kr ≤ 2 ^ pk) (hec : 2 ^ Q * Kc ≤ 2 ^ pk)
    (he0 : X0 ≤ 2 ^ pk) (he1 : Ka * X0 + 1 ≤ 2 ^ pk)
    (he2 : ((w2 + bk : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1 ≤ 2 ^ pk)
    (he3 : Kc * (((w2 + bk : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1) + 1 ≤ 2 ^ pk)
    (hBz : 2 * (pk + 1) + 2 ≤ B) (hBb : b + 4 ≤ B) (hPB : Q + 3 ≤ B)
    (hBc : zsz ((2 * win + 2 * (w2 + bk) : ℕ) : ℤ) ≤ B)
    (hBH : ∀ v ∈ aHdr2 w2 bk win Q pk b, zsz v ≤ BH)
    (s : IState HS) (F : Fin HS → List ℤ) (x : List GI) (l : List ℤ)
    (hF : ∀ j, j ≠ 0 → j ≠ dT → F j = []) (hdT : F dT = aKTab2 w2 bk win Q pk b aTab rTab cTab)
    (h0 : F 0 = gflat x ++ l) (hxl : x.length = win) (hx : AB X0 x) :
    IRuns I iprog (aKprog2 pM) (encK s F)
      (encK s (Function.update F 0 (gflat (J6A.aKerL w2 bk win Q aTab rTab cTab x) ++ l)))
      (cAK2 w2 bk win pk b φ1 φ2 B BH) := by
  -- counts
  have zc : ∀ m : ℕ, m ≤ 2 * win + 2 * (w2 + bk) → zsz (m : ℤ) ≤ B :=
    fun m hm => le_trans (KIL.zsz_nat_le hm) hBc
  have hpkB : pk + 1 ≤ B := by omega
  set G := aGx w2 bk win Q pk b with hGdef
  set body := aTab ++ (rTab ++ cTab) with hbody
  set hdr := aHdr2 w2 bk win Q pk b with hhdr
  have gT := aGx_tmp (w2 := w2) (bk := bk) (win := win) (Q := Q) (pk := pk) (b := b)
  -- the initial frame
  have hF0 : F = AF (fun _ => []) (gflat x ++ l) [] [] [] (hdr ++ body) [] := by
    funext j
    by_cases h1 : j = 0
    · subst h1; rw [AF_r0, h0]
    by_cases h2 : j = dT
    · subst h2; rw [AF_dt, hdT]; rfl
    rw [hF j h1 h2]
    by_cases h3 : j ∈ ([(0 : Fin HS), W1, W2, OUT, dT, DU] : List (Fin HS))
    · simp only [List.mem_cons, List.mem_nil_iff, or_false] at h3
      rcases h3 with rfl | rfl | rfl | rfl | rfl | rfl
      · exact absurd rfl h1
      · rw [AF_w1]
      · rw [AF_w2]
      · rw [AF_o]
      · exact absurd rfl h2
      · rw [AF_du]
    · rw [AF_ne (fun k hk e => h3 (by rw [e]; exact hk))]
  -- the header
  have hfree : ∀ R ∈ aRegs, FFree R := by unfold FFree aRegs; decide
  set G0 := aG2s w2 bk win Q pk b with hG0
  have H0 : IRuns I iprog (tkL aRegs).code
      (encK s (AF (fun _ => []) (gflat x ++ l) [] [] [] (hdr ++ body) []))
      (encK s (AF G0 (gflat x ++ l) [] [] [] body [])) (17 * (5000 * (BH + 2)) + 1) :=
    Sp.ir (tkL_sp (s := s) (B := BH) aRegs hdr (fun _ => []) body (by simp [aRegs, hhdr, aHdr2])
      hfree hBH)
  -- the Kronecker constants
  set jj := jA w2 bk with hjj
  set mm := b * (2 * (w2 + bk)) with hmm
  have hzj : zsz ((jj : ℕ) : ℤ) ≤ BH := hBH _ (by simp [hhdr, aHdr2, hjj])
  have hzm : zsz ((mm : ℕ) : ℤ) ≤ BH := hBH _ (by simp [hhdr, aHdr2, hmm])
  have hpk : pk < b := by
    have h1 : 2 ^ (2 * pk) < 2 ^ (b - 1) :=
      lt_of_le_of_lt (Nat.le_mul_of_pos_left _ (by omega)) hbig
    have := (Nat.pow_lt_pow_iff_right (by norm_num)).1 h1
    omega
  have S1 : Sp (.push aS1 (.reg kK)) (encK s (AF G0 (gflat x ++ l) [] [] [] body []))
      (encK s (AF (Function.update G0 aS1 [((jj : ℕ) : ℤ)]) (gflat x ++ l) [] [] [] body []))
      (4000 * (BH + 2)) := by
    have h := sp_pushR (s := s) (AF G0 (gflat x ++ l) [] [] [] body []) (i := aS1) (j := kK)
      (B := BH) (by decide) (by decide) (by rw [AF_ne (by decide), hG0, aG2s_kK]) hzj
    rwa [AF_ne (show ∀ k ∈ ([(0 : Fin HS), W1, W2, OUT, dT, DU] : List (Fin HS)), aS1 ≠ k by decide),
      hG0, aG2s_nil (by decide), AFu_ne (by decide)] at h
  have S2 : Sp (.push aS2 (.reg kJ))
      (encK s (AF (Function.update G0 aS1 [((jj : ℕ) : ℤ)]) (gflat x ++ l) [] [] [] body []))
      (encK s (AF (Function.update (Function.update G0 aS1 [((jj : ℕ) : ℤ)]) aS2 [((mm : ℕ) : ℤ)])
        (gflat x ++ l) [] [] [] body [])) (4000 * (BH + 2)) := by
    have h := sp_pushR (s := s) (AF (Function.update G0 aS1 [((jj : ℕ) : ℤ)]) (gflat x ++ l) [] [] []
      body []) (i := aS2) (j := kJ) (B := BH) (by decide) (by decide)
      (by rw [AF_ne (by decide), Function.update_of_ne (by decide), hG0, aG2s_kJ]) hzm
    rwa [AF_ne (show ∀ k ∈ ([(0 : Fin HS), W1, W2, OUT, dT, DU] : List (Fin HS)), aS2 ≠ k by decide),
      Function.update_of_ne (by decide), hG0, aG2s_nil (by decide), AFu_ne (by decide)] at h
  obtain ⟨cl1, cl2⟩ := clog_facts hn1
  have hbj : b * 2 ^ jj ≤ b * (4 * (w2 + bk)) := Nat.mul_le_mul_left _ cl2.le
  have hjz : zsz (jj : ℤ) ≤ BkA w2 bk b := by
    have : jj < 2 ^ jj := Nat.lt_two_pow_self
    have h := zsz_lt_pow (x := (jj : ℤ)) (M := jj) (by positivity) (by exact_mod_cast this)
    unfold BkA BkN; nlinarith
  set G1 := Function.update (Function.update G0 aS1 [((jj : ℕ) : ℤ)]) aS2 [((mm : ℕ) : ℤ)] with hG1
  have g1 : ∀ r : Fin HS, r ≠ aS1 → r ≠ aS2 → G1 r = G0 r := fun r h1 h2 => by
    rw [hG1, Function.update_of_ne h2, Function.update_of_ne h1]
  have K := sp_kg s (AF G1 (gflat x ++ l) [] [] [] body []) (pk := pk) (b := b) (j := jj)
    (n := w2 + bk) (Bk := BkA w2 bk b)
    (by rw [AF_ne (by decide), g1 _ (by decide) (by decide), hG0, aG2s_nil (by decide)])
    (by rw [AF_ne (by decide), g1 _ (by decide) (by decide), hG0, aG2s_nil (by decide)])
    (by rw [AF_ne (by decide), g1 _ (by decide) (by decide), hG0, aG2s_nil (by decide)])
    (by rw [AF_ne (by decide), g1 _ (by decide) (by decide), hG0,
      aG2s_off (by decide) (by decide), aG_kc])
    (by rw [AF_ne (by decide), g1 _ (by decide) (by decide), hG0,
      aG2s_off (by decide) (by decide), aG_kB])
    (by rw [AF_ne (by decide), g1 _ (by decide) (by decide), hG0, aG2s_kK])
    (by rw [AF_ne (by decide), g1 _ (by decide) (by decide), hG0, aG2s_kJ])
    hpk cl1 (by unfold BkA BkN; nlinarith) (by unfold BkA BkN; nlinarith) hjz
  rw [AFu_ne (by decide), AFu_ne (by decide), hG1, hG0, hjj, hmm, aGx_eq, ← hGdef] at K
  have Hsv : IRuns I iprog kSave.code
      (encK s (AF G0 (gflat x ++ l) [] [] [] body []))
      (encK s (AF G1 (gflat x ++ l) [] [] [] body [])) (2 * (4000 * (BH + 2))) :=
    Sp.ir (I := I) (iprog := iprog) ((S1.seq S2).mono (by omega))
  have HK : IRuns I iprog kgRS.code (encK s (AF G1 (gflat x ++ l) [] [] [] body []))
      (encK s (AF G (gflat x ++ l) [] [] [] body [])) (cKG jj mm (BkA w2 bk b)) :=
    Sp.ir (I := I) (iprog := iprog) K
  -- stage 1: scale
  have hzl : (x.take w2).length = w2 := by simp; omega
  set y := dgG Q aTab (x.take w2) with hydef
  have hyl : y.length = w2 := by rw [hydef, length_dgG Q (by omega), hzl]
  have abz : AB X0 (x.take w2) := fun w hw => hx w (List.mem_of_mem_take hw)
  have aby : AB (Ka * X0 + 1) y := AB_dgG Q hta abz hX0
  have d1 : IRuns I iprog (dgI pM 0 dT TU W1 CN CC R1)
      (encK s (AF G (gflat x ++ l) [] [] [] body []))
      (encK s (AF G (gflat (x.drop w2) ++ l) (gflat y.reverse) [] [] body [])) (cDG w2 φ1 B) := by
    have h := dgI_runs (I := I) (iprog := iprog) hM hdom hΦ1 (X := 0) (T := dT) (U := TU) (Y := W1)
      (CN := CN) (CC := CC) (N := R1) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      Q s (AF G (gflat x ++ l) [] [] [] body []) (x.take w2) aTab (gflat (x.drop w2) ++ l)
      (rTab ++ cTab) [] [] []
      (by rw [AF_r0, ← List.append_assoc, ← gflat_append, List.take_append_drop])
      (by rw [AF_dt])
      (by rw [hzl, hal])
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide), hGdef, aGx_R1, hzl])
      (by rw [AF_ne (by decide), hGdef, aGx_rP])
      (by rw [AF_ne (by decide), hGdef, aGx_rP1])
      (pk + 1) (gb_AB (AB_mono abz he0) le_rfl) (bnd_TB (TB_mono hta hea) le_rfl) hBz hPB
      (by rw [hzl]; exact zc _ (by omega))
    simp only [AFu_r0, AFu_w1, AF_w1, List.append_nil, hzl] at h
    exact h
  -- stage 2: drop the rest of the row, pad
  have z1 : IRuns I iprog (dropR 0 CC R2).code
      (encK s (AF G (gflat (x.drop w2) ++ l) (gflat y.reverse) [] [] body []))
      (encK s (AF G l (gflat y.reverse) [] [] body [])) (cMvP (2 * (win - w2)) B) := by
    have hL : (gflat (x.drop w2)).length = 2 * (win - w2) := by
      rw [length_gflat, List.length_drop, hxl]
    have h := sp_dropR (X := 0) (C := CC) (R := R2) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) s (AF G (gflat (x.drop w2) ++ l) (gflat y.reverse) [] [] body [])
      (gflat (x.drop w2)) l [] (by rw [AF_r0])
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide), hGdef, aGx_R2, hL]) B
      (bnd_gflat2 (gb_AB (AB_mono (fun w hw => hx w (List.mem_of_mem_drop hw)) he0) hpkB))
      (by rw [hL]; exact zc _ (by omega))
    rw [AFu_r0, hL] at h
    exact Sp.ir h
  set t := J6Seg.padG (w2 + bk) y with htdef
  have htl : t.length = w2 + bk := by simp [htdef, J6Seg.padG, hyl]
  have hgt : gflat t.reverse = List.replicate (2 * bk) 0 ++ gflat y.reverse := by
    rw [htdef, J6Seg.padG, List.reverse_append, List.reverse_replicate, gflat_append,
      gflat_replicate0, hyl, show w2 + bk - w2 = bk by omega]
  have z2 : IRuns I iprog (zeroR W1 CC R3).code
      (encK s (AF G l (gflat y.reverse) [] [] body []))
      (encK s (AF G l (gflat t.reverse) [] [] body [])) (cMvP (2 * bk) B) := by
    have h := sp_zeroR (Y := W1) (C := CC) (R := R3) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) s (AF G l (gflat y.reverse) [] [] body []) (2 * bk) []
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide), hGdef, aGx_R3]) B (zc _ (by omega))
    rw [AFu_w1, AF_w1, ← hgt] at h
    exact Sp.ir h
  -- stage 3: `aTab` off the table, the Toeplitz stage
  have m1 : IRuns I iprog (NLogN.mvK dT DU CC (.reg R1)).code
      (encK s (AF G l (gflat t.reverse) [] [] body []))
      (encK s (AF G l (gflat t.reverse) [] [] (rTab ++ cTab) aTab.reverse))
      (2 * 2000 * (B + 2) + w2 * (14000 * (B + 2)) + 32) := by
    have hr1 : AF G l (gflat t.reverse) [] [] body [] R1 = (w2 : ℤ) :: [] := by
      rw [AF_ne (by decide), hGdef, aGx_R1]
    have h := Sp.mvK (X := dT) (Y := DU) (C := CC) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) s (AF G l (gflat t.reverse) [] [] body []) (.reg R1)
      (clean_reg (by decide)) (ok_reg hr1) aTab (rTab ++ cTab) (by rw [AF_dt])
      (by rw [eval_reg hr1, hal]) B (bnd_TB (TB_mono hta hea) hpkB) trivial
      (bnd_reg hr1 (zc _ (by omega)))
    rw [AFu_dt, AFu_du, AF_du, List.append_nil, hal] at h
    exact Sp.ir (h.mono (by simp only [Ex.size]; omega))
  have abt : AB (Ka * X0 + 1) t := AB_padG2 (by positivity) aby
  set Z := lwG Q (2 * (w2 + bk)) rTab t with hZdef
  have hZl : Z.length = w2 + bk := by rw [hZdef, length_lwG Q (by omega), htl]
  have abZ : AB (((w2 + bk : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1) Z :=
    AB_lwG Q htr abt (by positivity) hKr (by omega) (by omega)
  have ts : IRuns I iprog (tsI pM W1 W2)
      (encK s (AF G l (gflat t.reverse) [] [] (rTab ++ cTab) aTab.reverse))
      (encK s (AF G l [] (gflat Z) [] cTab (rTab.reverse ++ aTab.reverse)))
      (cTS (w2 + bk) pk b φ2 B) := by
    have h := tsI_runs (I := I) (iprog := iprog) (b := b) (n := w2 + bk) (pk := pk) (φ := φ2) hM
      hdom hΦ2 hb hn1 hbig (IN := W1) (OUTS := W2) (Or.inl ⟨rfl, rfl⟩) Q s
      (AF G l (gflat t.reverse) [] [] (rTab ++ cTab) aTab.reverse) t rTab [] cTab [] [] [] []
      (by rw [AF_w1, List.append_nil]) htl (by rw [AF_dt]) hrl
      (by rw [AF_ne (by decide), hGdef, aGx_bN])
      (by rw [AF_ne (by decide), hGdef, aGx_bN2])
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (Tmp_AF gT)
      (by rw [AF_ne (by decide), hGdef, aGx_kc])
      (by rw [AF_ne (by decide), hGdef, aGx_kr])
      (by rw [AF_ne (by decide), hGdef, aGx_kK])
      (by rw [AF_ne (by decide), hGdef, aGx_kB])
      (by rw [AF_ne (by decide), hGdef, aGx_kJ])
      (by rw [AF_ne (by decide), hGdef, aGx_kD])
      (by rw [AF_ne (by decide), hGdef, aGx_rP])
      (by rw [AF_ne (by decide), hGdef, aGx_rP1])
      (AB_mono abt he1) (TB_mono htr her) B hBb (by omega) hPB (zc _ (by omega))
    simp only [AFu_w1, AFu_w2, AFu_dt, AFu_du, AF_w2, AF_du, List.append_nil] at h
    exact h
  -- stage 4: drop the first `w2` outputs, rescale
  have z3 : IRuns I iprog (dropR W2 CC R4).code
      (encK s (AF G l [] (gflat Z) [] cTab (rTab.reverse ++ aTab.reverse)))
      (encK s (AF G l [] (gflat (Z.drop w2)) [] cTab (rTab.reverse ++ aTab.reverse)))
      (cMvP (2 * w2) B) := by
    have hL : (gflat (Z.take w2)).length = 2 * w2 := by
      rw [length_gflat, List.length_take, hZl, Nat.min_eq_left (by omega)]
    have h := sp_dropR (X := W2) (C := CC) (R := R4) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) s
      (AF G l [] (gflat Z) [] cTab (rTab.reverse ++ aTab.reverse)) (gflat (Z.take w2))
      (gflat (Z.drop w2)) [] (by rw [AF_w2, ← gflat_append, List.take_append_drop])
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide), hGdef, aGx_R4, hL]) B
      (bnd_gflat2 (gb_AB (AB_mono (fun w hw => abZ w (List.mem_of_mem_take hw)) he2) hpkB))
      (by rw [hL]; exact zc _ (by omega))
    rw [AFu_w2, hL] at h
    exact Sp.ir h
  have hZd : (Z.drop w2).length = bk := by rw [List.length_drop, hZl]; omega
  set w := dgG Q cTab (Z.drop w2) with hwdef
  have hwl : w.length = bk := by rw [hwdef, length_dgG Q (by omega), hZd]
  have abw : AB (Kc * (((w2 + bk : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1) + 1) w :=
    AB_dgG Q htc (fun v hv => abZ v (List.mem_of_mem_drop hv)) (by positivity)
  have d2 : IRuns I iprog (dgI pM W2 dT TU OUT CN CC R5)
      (encK s (AF G l [] (gflat (Z.drop w2)) [] cTab (rTab.reverse ++ aTab.reverse)))
      (encK s (AF G l [] [] (gflat w.reverse) cTab (rTab.reverse ++ aTab.reverse)))
      (cDG bk φ1 B) := by
    have h := dgI_runs (I := I) (iprog := iprog) hM hdom hΦ1 (X := W2) (T := dT) (U := TU)
      (Y := OUT) (CN := CN) (CC := CC) (N := R5) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide)
      Q s (AF G l [] (gflat (Z.drop w2)) [] cTab (rTab.reverse ++ aTab.reverse)) (Z.drop w2) cTab
      [] [] [] [] []
      (by rw [AF_w2, List.append_nil]) (by rw [AF_dt, List.append_nil]) (by rw [hZd, hcl])
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide)]; exact aGx_nil (by decide))
      (by rw [AF_ne (by decide), hGdef, aGx_R5, hZd])
      (by rw [AF_ne (by decide), hGdef, aGx_rP])
      (by rw [AF_ne (by decide), hGdef, aGx_rP1])
      (pk + 1) (gb_AB (AB_mono (fun v hv => abZ v (List.mem_of_mem_drop hv)) he2) le_rfl)
      (bnd_TB (TB_mono htc hec) le_rfl) hBz hPB (by rw [hZd]; exact zc _ (by omega))
    simp only [AFu_w2, AFu_o, AF_o, List.append_nil, hZd] at h
    exact h
  -- stage 5: zeros, the outputs back on stack `0`
