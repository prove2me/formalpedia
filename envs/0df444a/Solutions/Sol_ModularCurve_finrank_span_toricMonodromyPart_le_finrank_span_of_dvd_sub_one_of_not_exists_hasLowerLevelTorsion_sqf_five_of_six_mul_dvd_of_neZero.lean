variable {J : Type*} [AddCommGroup J] [Module HeckeAlg J] {𝒯 : Submodule HeckeAlg J} {p : ℕ}
  {L : Type*} [AddCommGroup L] {K : Type*} [CommMonoid K]

private def jg2_inc (y : ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg))) : ↥𝒯 :=
  ⟨y.1, (Submodule.mem_inf.mp y.2).1⟩

private theorem jg2_inc_add (y y' : ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg))) :
    jg2_inc (y + y') = jg2_inc y + jg2_inc y' := rfl

private theorem jg2_inc_smul (t : HeckeAlg) (y : ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg))) :
    jg2_inc (t • y) = t • jg2_inc y := rfl

private theorem jg2_pow_eq_one (ε₁ : ↥𝒯 ≃+ (L →+ Additive Kˣ))
    (y : ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg))) (l : L) :
    Additive.toMul (ε₁ (jg2_inc y) l) ^ p = 1 := by
  have hx : p • jg2_inc y = 0 := by
    apply Subtype.ext
    rw [Submodule.coe_smul_of_tower, Submodule.coe_zero, ← Nat.cast_smul_eq_nsmul HeckeAlg]
    exact (Submodule.mem_torsionBy_iff _ _).mp (Submodule.mem_inf.mp y.2).2
  have h := map_nsmul ε₁ p (jg2_inc y)
  rw [hx, map_zero] at h
  have hl : (p • ε₁ (jg2_inc y)) l = 0 := by rw [← h]; rfl
  rw [AddMonoidHom.nsmul_apply] at hl
  rw [← toMul_nsmul, hl, toMul_zero]

private noncomputable def jg2_fwd (ε₁ : ↥𝒯 ≃+ (L →+ Additive Kˣ))
    (y : ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg))) :
    L →+ Additive ↥(rootsOfUnity p K) where
  toFun l := Additive.ofMul ⟨Additive.toMul (ε₁ (jg2_inc y) l),
    (mem_rootsOfUnity p _).mpr (jg2_pow_eq_one ε₁ y l)⟩
  map_zero' := by
    apply Additive.toMul.injective
    apply Subtype.ext
    simp
  map_add' a b := by
    apply Additive.toMul.injective
    apply Subtype.ext
    simp [toMul_add]

private theorem jg2_fwd_coe (ε₁ : ↥𝒯 ≃+ (L →+ Additive Kˣ))
    (y : ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg))) (l : L) :
    ((Additive.toMul (jg2_fwd ε₁ y l) : ↥(rootsOfUnity p K)) : Kˣ) = Additive.toMul (ε₁ (jg2_inc y) l) :=
  rfl

private theorem jg2_incl_comp_fwd (ε₁ : ↥𝒯 ≃+ (L →+ Additive Kˣ))
    (y : ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg))) :
    (MonoidHom.toAdditive (rootsOfUnity p K).subtype).comp (jg2_fwd ε₁ y) = ε₁ (jg2_inc y) :=
  AddMonoidHom.ext fun _ => rfl

private theorem jg2_nsmul_incl_comp (f : L →+ Additive ↥(rootsOfUnity p K)) :
    p • (MonoidHom.toAdditive (rootsOfUnity p K).subtype).comp f = 0 := by
  refine AddMonoidHom.ext fun l => ?_
  rw [AddMonoidHom.nsmul_apply, AddMonoidHom.zero_apply, AddMonoidHom.comp_apply, ← map_nsmul]
  have hfl : p • f l = 0 := by
    apply Additive.toMul.injective
    rw [toMul_nsmul, toMul_zero]
    exact Subtype.ext (by
      rw [Subgroup.coe_pow, Subgroup.coe_one]
      exact (mem_rootsOfUnity p _).mp (Additive.toMul (f l)).2)
  rw [hfl, map_zero]

private noncomputable def jg2_bwd (ε₁ : ↥𝒯 ≃+ (L →+ Additive Kˣ)) (f : L →+ Additive ↥(rootsOfUnity p K)) :
    ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg)) :=
  ⟨(ε₁.symm ((MonoidHom.toAdditive (rootsOfUnity p K).subtype).comp f)).1,
    Submodule.mem_inf.mpr ⟨(ε₁.symm _).2, (Submodule.mem_torsionBy_iff _ _).mpr (by
      rw [Nat.cast_smul_eq_nsmul, ← Submodule.coe_smul_of_tower, ← map_nsmul, jg2_nsmul_incl_comp,
        map_zero, Submodule.coe_zero])⟩⟩

private theorem jg2_inc_bwd (ε₁ : ↥𝒯 ≃+ (L →+ Additive Kˣ)) (f : L →+ Additive ↥(rootsOfUnity p K)) :
    jg2_inc (jg2_bwd ε₁ f) = ε₁.symm ((MonoidHom.toAdditive (rootsOfUnity p K).subtype).comp f) :=
  rfl

private noncomputable def jg2_eps (ε₁ : ↥𝒯 ≃+ (L →+ Additive Kˣ)) :
    ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg)) ≃+ (L →+ Additive ↥(rootsOfUnity p K)) where
  toFun := jg2_fwd ε₁
  invFun := jg2_bwd ε₁
  left_inv y := by
    apply Subtype.ext
    show ((jg2_inc (jg2_bwd ε₁ (jg2_fwd ε₁ y)) : ↥𝒯) : J) = (jg2_inc y : J)
    rw [jg2_inc_bwd, jg2_incl_comp_fwd, AddEquiv.symm_apply_apply]
  right_inv f := by
    refine AddMonoidHom.ext fun l => ?_
    apply Additive.toMul.injective
    apply Subtype.ext
    rw [jg2_fwd_coe, jg2_inc_bwd, AddEquiv.apply_symm_apply]
    rfl
  map_add' y y' := by
    refine AddMonoidHom.ext fun l => ?_
    apply Additive.toMul.injective
    apply Subtype.ext
    rw [jg2_fwd_coe, jg2_inc_add, map_add, AddMonoidHom.add_apply, toMul_add, AddMonoidHom.add_apply,
      toMul_add, Subgroup.coe_mul, jg2_fwd_coe, jg2_fwd_coe]

private theorem jg2_eps_coe (ε₁ : ↥𝒯 ≃+ (L →+ Additive Kˣ))
    (y : ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg))) (l : L) :
    ((Additive.toMul (jg2_eps ε₁ y l) : ↥(rootsOfUnity p K)) : Kˣ) = Additive.toMul (ε₁ (jg2_inc y) l) :=
  rfl

private theorem jg2_eps_smul (ε₁ : ↥𝒯 ≃+ (L →+ Additive Kˣ)) (t : HeckeAlg)
    (y : ↥(𝒯 ⊓ Submodule.torsionBy HeckeAlg J (p : HeckeAlg))) (l l' : L)
    (h : ε₁ (t • jg2_inc y) l = ε₁ (jg2_inc y) l') :
    jg2_eps ε₁ (t • y) l = jg2_eps ε₁ y l' := by
  apply Additive.toMul.injective
  apply Subtype.ext
  rw [jg2_eps_coe, jg2_eps_coe, jg2_inc_smul, h]

end TorsionDual

private theorem jg2_card_rootsOfUnity (K : Type*) [Field K] [IsAlgClosed K] (p : ℕ) [NeZero p]
    (hpK : ((p : ℕ) : K) ≠ 0) : Nat.card (Additive ↥(rootsOfUnity p K)) = p := by
  haveI : NeZero ((p : ℕ) : K) := ⟨hpK⟩
  exact HasEnoughRootsOfUnity.natCard_rootsOfUnity K p

private theorem jg2_finite (ι : Type*) [Fintype ι] :
    @Module.Finite ℤ ↥(characterLattice ι) _ _ (AddCommGroup.toIntModule _) := by
  have h : Module.Finite ℤ ↥(characterLattice ι) := inferInstance
  convert h

