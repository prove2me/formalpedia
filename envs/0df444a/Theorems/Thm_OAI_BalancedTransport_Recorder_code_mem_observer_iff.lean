variable {Q Γ : Type*} [Fintype Q] [Fintype Γ]
variable [DecidableEq Q]

theorem OAI.BalancedTransport.Recorder.code_mem_observer_iff (M : Machine Q Γ) (c : Configuration Q Γ) :
