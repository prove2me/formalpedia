        (by simp +decide [T, cf3, h2]) (by simp +decide [T, cf3, hR]) (by simp +decide [T, cf3, hX])
        (by simp +decide [T, cf3, hX2]) (hA _ hmem) hB
        (hC.sub (fun z hz => by
          simp only [oprod, List.mem_flatMap]; exact ⟨A[k], hmem, hz⟩))
      refine Hb.mono' ?_ le_rfl
      have e2 : ints (gflat (oprod Δ (A.take (k + 1)) B)).reverse =
          ints (gflat (B.map (gmulT Δ A[k]))).reverse ++
            ints (gflat (oprod Δ (A.take k) B)).reverse := by
        rw [oprod_take_succ Δ A B k hk, gflat_append, List.reverse_append]; simp [ints]
      simp only [T, cf3, e2]
      clear Hb e2 hd
      ((apply NLogN.IState.ext' <;> intros <;>
               simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
             split_ifs <;>
           simp_all +decide))) LN (by rw [e0]; exact hN)
  have e1 : T A.length = (s.upd pQ1 R1).upd pQ3 (ints (gflat (oprod Δ A B)).reverse ++ s.G pQ3) := by
    simp only [T, List.drop_length, List.take_length]; simp [ints]
  rw [e0, e1] at H
  exact H.mono (by unfold cCnt; omega)

