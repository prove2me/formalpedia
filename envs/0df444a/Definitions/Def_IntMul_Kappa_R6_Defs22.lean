-- Source module: Solutions.R6IL3Net
/-!
# Round six, item language (I3): the network in the item-language numbering

* `mapR e`: transport of a step along a role equivalence; `denListH_mapR`: the denotation
  is reindexed.
* **`netF J`**: the normalized network (`R6IL3Norm`) with roles `Fin (W + T)` (data first,
  `roleEqv`); `netF_child` (children are forward prefix children of width `< m`), `netF_gate`
  (gate class), **`netF_data`** (the data-to-data block is `C^{⊗}` on every data role),
  `netF_widths`.
* `Gs A p m x`: the closed-form scale bound (`x` below `2m`, `A((x+1)^p - 1)` above);
  **`Gs_node`**: a node on `E = mF + r ≥ 2m` bits whose children have widths `s F` (`s` in
  `ws`, `2 Σ (2s+1)^p ≤ (2m)^p`) has local scale `c` plus child scales plus leftover scale at
  most `Gs E`.
* `dep m x`: the number of node levels below `x` bits (`dep_child`, `dep_mono`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL3H

open Matrix Finset Complex Butterfly P8Lift IntMul.Kappa.R6.Cx

/-! ## Role transport -/

section Map

variable {R R' : Type} [Fintype R] [DecidableEq R] [Fintype R'] [DecidableEq R'] {m : ℕ}

/-- Reindex an operator along a role equivalence. -/
def reidx {κ : Type} (e : R ≃ R') (A : ROp R m κ) : ROp R' m κ :=
  A.submatrix (fun p => (e.symm p.1, p.2)) (fun p => (e.symm p.1, p.2))

/-- Transport of a step. -/
def mapR (e : R ≃ R') : HStep R m → HStep R' m
  | .gate G => .gate (G.submatrix e.symm e.symm)
  | .rowAdd w i j hij => .rowAdd (e w) i j hij
  | .phase w k₀ k₁ a => .phase (e w) k₀ k₁ a
  | .perm σ => .perm (e.permCongr σ)
  | .child w S neg => .child (e w) S neg

end Map

/-! ## The item-language network -/

section NetF

variable {W T m : ℕ} {h : List (ℕ × ℕ)}

/-- **The item-language network**: normalized, roles `Fin (W + T)`, data first. -/
noncomputable def netF (J : Prop8IfaceH W T m h) : List (HStep (Fin (W + T)) m) :=
  (Prop8IfaceH'.norm J).net.map (mapR (roleEqv W T))

end NetF

/-! ## The closed-form scale bound -/

section Scale

/-- The scale bound: exact below `2m` (chains of single kernels), `A((x+1)^p - 1)` above. -/
def Gs (A p m x : ℕ) : ℕ := if x < 2 * m then x else A * ((x + 1) ^ p - 1)

end Scale

/-! ## The depth -/

section Dep

/-- The number of node levels below `x` bits (children have at most `(m-1)⌊x/m⌋` bits). -/
def dep (m : ℕ) (x : ℕ) : ℕ :=
  if h : 2 * m ≤ x ∧ 1 ≤ m then 1 + dep m ((m - 1) * (x / m)) else 0
termination_by x
decreasing_by
  have hm := h.2
  have h1 : (m - 1) * (x / m) + x / m = m * (x / m) := by
    rw [← Nat.succ_mul, Nat.succ_eq_add_one, Nat.sub_add_cancel hm, mul_comm]
  have h2 : m * (x / m) ≤ x := Nat.mul_div_le x m
  have h3 : 1 ≤ x / m := by rw [Nat.le_div_iff_mul_le (by omega)]; linarith
  omega

end Dep

end IntMul.Kappa.R6.IL3H

end

