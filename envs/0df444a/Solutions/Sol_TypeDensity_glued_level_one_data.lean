    (heZ : e (Ideal.Quotient.mk (TypeDensity.chartExceptional R S.t S.x) (TypeDensity.chartSlope R S.t S.x)) = Polynomial.X)
    (hm : TypeDensity.MatchesDivisor e D Dv) [IsNoetherianRing (TypeDensity.BlowupChart R S.t S.x)]
    [IsNoetherianRing (TypeDensity.BlowupChart R S.x S.t)] (hreg : TypeDensity.RegularParameterPair R S.t S.x)
    (hregSwap : TypeDensity.RegularParameterPair R S.x S.t) (f : R)
    (G : TypeDensity.GluedGenerators R S.t S.x beta (TypeDensity.curveDataDegree D))
    (hf : ∀ j : ℕ, TypeDensity.surfaceToCechInput R S.t S.x j f =
      (TypeDensity.cechInputLattice R S.t S.x j).mkQ (TypeDensity.gluedFunctionPair R S.t S.x G j))
    (hG : ∀ j : ℕ,
      Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R S.t S.x)^j) (G.left j)} =
        TypeDensity.leftLevelKernel D j ∧
      Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R S.x S.t)^j) (G.right j)} =
        TypeDensity.rightLevelKernel D j) :
    ∃ (c : Fin (TypeDensity.curveDataDegree D+1) → R) (a : IsLocalRing.ResidueField R),
      f = ∑ i : Fin (TypeDensity.curveDataDegree D+1), c i * S.t^(TypeDensity.curveDataDegree D - i.val) * S.x^i.val ∧
      a ≠ 0 ∧ (TypeDensity.divisorAffinePolynomial (IsLocalRing.ResidueField R) Dv).Monic ∧
      (TypeDensity.divisorAffinePolynomial (IsLocalRing.ResidueField R) Dv).natDegree + Dv none =
