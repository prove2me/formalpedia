  nlinarith

/-- **Closed bound of the cost coefficients.** -/
theorem cb_le (hm : 1 ≤ m) (hCR : 0 ≤ CR) (hτ0 : 0 ≤ τ) (hτ1 : τ ≤ 1) :
    ∀ k, cb L s W A m CR τ k ≤ (100000 + k * ((((s + L) * alN W A + 1 : ℕ)) : ℝ) +
