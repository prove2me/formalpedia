/-! ## The equal-volume shell peeling of a ball -/


lemma shellRadius_nonneg {R : ℝ} (hR : 0 ≤ R) (d N k : ℕ) : 0 ≤ shellRadius R d N k :=
  mul_nonneg hR (Real.rpow_nonneg (le_max_left _ _) _)












/-! ## Rigidity of ball peelings -/







open Catalog.Geometry.Peel in
theorem solution(d N k : ℕ) (hd : 0 < d) {R : ℝ} (hR : 0 ≤ R) :
    (shellPeel d R N).size k = ballVol d (shellRadius R d N k) := by
  have ht0 : (0 : ℝ) ≤ max 0 (1 - (k : ℝ) / (N : ℝ)) := le_max_left _ _
  have hrad : 0 ≤ shellRadius R d N k := shellRadius_nonneg hR d N k
  have hR' : ballVol d R = R ^ d * ballVol d 1 := ballVol_eq d hd hR
  rw [ballVol_eq d hd hrad, shellRadius, mul_pow, Real.rpow_inv_natCast_pow ht0 hd.ne']
  show ballVol d R * max 0 (1 - (k : ℝ) / (N : ℝ))
      = R ^ d * max 0 (1 - (k : ℝ) / (N : ℝ)) * ballVol d 1
  rw [hR']
  ring
