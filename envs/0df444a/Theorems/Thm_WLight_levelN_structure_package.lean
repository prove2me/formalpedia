-- title:
--   Fixer of the Fricke functions and structure of A_N
-- statement:
--   Let $N$ be a positive natural number, and let $L$ assign to each $\tau$ in the upper half-plane $\mathbb{H}$ a period pair with $\omega_1 = \tau$ and $\omega_2 = 1$. Let $W$ be a family of functions indexed by $v \colon \mathrm{Fin}\,2 \to \mathbb{Z}/N\mathbb{Z}$ with $W_v(\tau) = (2\pi i)^{-2}\,\wp_{L\tau}\bigl((\tilde v_0 \tau + \tilde v_1)/N\bigr)$, where $\tilde v_i$ is the representative of $v_i$ in $[0,N)$; let $\mathrm{fricke}_v(\tau) = -\bigl(E_4(\tau)E_6(\tau)/\Delta(\tau)\bigr)/2592 \cdot W_v(\tau)$, and let $jf(\tau) = E_4(\tau)^3/\Delta(\tau)$, each pinned to these formulas by hypothesis. Put $A_N$ for the $\mathbb{C}$-subalgebra of $\mathbb{H} \to \mathbb{C}$ generated by $jf$ together with all $\mathrm{fricke}_v$ with $v \neq 0$, and let $\gamma \in \mathrm{SL}_2(\mathbb{Z})$ act on row vectors $v$ by $v \mapsto v\bar\gamma$, reduction mod $N$. Six assertions are made. First, the set of $\gamma$ with $\mathrm{fricke}_{v\bar\gamma} = \mathrm{fricke}_v$ for all $v \neq 0$ is exactly $\{\gamma : \gamma \in \Gamma(N) \text{ or } -\gamma \in \Gamma(N)\}$. Second, if $a, b \in A_N$, $b \neq 0$, and $a \cdot (b \circ \gamma) = (a \circ \gamma) \cdot b$ for every $\gamma$, then there are polynomials $p, q$ over $\mathbb{C}$ with $q \neq 0$ and $a \cdot q(jf) = b \cdot p(jf)$. Third, each $\mathrm{fricke}_v$ with $v \neq 0$ satisfies a monic equation of some degree $d$ with coefficients polynomial in $jf$. Fourth, any polynomial vanishing at $jf(\tau)$ for all $\tau$ is zero. Fifth, every element of $A_N$ is holomorphic on $\mathbb{H}$. Sixth, $A_N$ has no zero divisors.
--
--   This is the function-level form of the classical structure theory of the field of modular functions of level $N$ over $\mathbb{C}$: the Fricke functions are permuted by $\mathrm{SL}_2(\mathbb{Z})$ through $\mathrm{SL}_2(\mathbb{Z})/\pm\Gamma(N)$, their invariant fractions are rational in $j$, and the algebra they generate is a holomorphic integral domain, integral over $\mathbb{C}[j]$ with $j$ transcendental. It supports the later rationality and $q$-expansion statements for forms of level $N$, such as the description of the span of Fricke-rational products of $E_4$ and $E_6$ and the construction of algebra homomorphisms into Laurent series.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_WLight_levelN_structure_package.lean

import Mathlib.Analysis.SpecialFunctions.Elliptic.Weierstrass
import Mathlib.NumberTheory.ModularForms.Discriminant
import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
import Mathlib.Geometry.Manifold.Notation

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
open Complex Real UpperHalfPlane
open scoped Manifold MatrixGroups ModularForm

theorem WLight.levelN_structure_package
    (N : ℕ) [NeZero N]
    (L : ℍ → PeriodPair) (hL : ∀ τ : ℍ, (L τ).ω₁ = (τ : ℂ) ∧ (L τ).ω₂ = 1)
    (W : (Fin 2 → ZMod N) → ℍ → ℂ)
    (hW : ∀ (v : Fin 2 → ZMod N) (τ : ℍ), W v τ = ((2 * (Real.pi : ℂ) * Complex.I) ^ 2)⁻¹ *
      PeriodPair.weierstrassP (L τ) ((((v 0).val : ℂ) * (τ : ℂ) + ((v 1).val : ℂ)) / (N : ℂ)))
    (fricke : (Fin 2 → ZMod N) → ℍ → ℂ)
    (hfricke : ∀ (v : Fin 2 → ZMod N) (τ : ℍ), fricke v τ =
      -(ModularForm.E₄ τ * ModularForm.E₆ τ / ModularForm.discriminant τ) / 2592 * W v τ)
    (jf : ℍ → ℂ)
    (hjf : ∀ τ : ℍ, jf τ = ModularForm.E₄ τ ^ 3 / ModularForm.discriminant τ) :
    let A_N : Subalgebra ℂ (ℍ → ℂ) := Algebra.adjoin ℂ
      (insert jf {g : ℍ → ℂ | ∃ v : Fin 2 → ZMod N, v ≠ 0 ∧ g = fricke v})
    let vecMul : (Fin 2 → ZMod N) → SL(2, ℤ) → Fin 2 → ZMod N := fun v γ ↦
      Matrix.vecMul v ((γ : Matrix (Fin 2) (Fin 2) ℤ).map ((↑) : ℤ → ZMod N))

    ({γ : SL(2, ℤ) | ∀ v : Fin 2 → ZMod N, v ≠ 0 → fricke (vecMul v γ) = fricke v} =
      {γ : SL(2, ℤ) | γ ∈ CongruenceSubgroup.Gamma N ∨ -γ ∈ CongruenceSubgroup.Gamma N})

    ∧ (∀ a b : ℍ → ℂ, a ∈ A_N → b ∈ A_N → b ≠ 0 →
        (∀ γ : SL(2, ℤ), a * (b ∘ (γ • ·)) = (a ∘ (γ • ·)) * b) →
        ∃ p q : Polynomial ℂ, q ≠ 0 ∧ a * (fun τ ↦ q.eval (jf τ)) = b * (fun τ ↦ p.eval (jf τ)))

    ∧ (∀ v : Fin 2 → ZMod N, v ≠ 0 → ∃ d : ℕ, ∃ c : ℕ → Polynomial ℂ,
        ∀ τ, fricke v τ ^ d
          + ∑ k ∈ Finset.range d, (c k).eval (jf τ) * fricke v τ ^ k = 0)

    ∧ (∀ P : Polynomial ℂ, (∀ τ : ℍ, P.eval (jf τ) = 0) → P = 0)

    ∧ (∀ F ∈ A_N, MDifferentiable 𝓘(ℂ) 𝓘(ℂ) F)

    ∧ (∀ a b : ℍ → ℂ, a ∈ A_N → b ∈ A_N → a * b = 0 → a = 0 ∨ b = 0) := by sorry
