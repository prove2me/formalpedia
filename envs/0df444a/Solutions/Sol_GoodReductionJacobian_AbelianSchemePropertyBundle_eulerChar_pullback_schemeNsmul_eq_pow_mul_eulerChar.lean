abbrev cmp (U : V.Opens) : Γ(M, U) ⊗[Γ(V, U)] Γ(N, U) →ₗ[Γ(V, U)] Γ(M ⊗ N, U) :=
  TensorProduct.lift (Scheme.Modules.tensorSectionsBilin M N U)

theorem cmp_tmul (U : V.Opens) (s : Γ(M, U)) (t : Γ(N, U)) :
    cmp M N U (s ⊗ₜ t) = Scheme.Modules.tensorSections s t := by
  simp [cmp]

def resTw {U U' : V.Opens} (h : U ≤ U') :
    Γ(M, U') ⊗[Γ(V, U')] Γ(N, U') →ₛₗ[(V.presheaf.map (homOfLE h).op).hom] Γ(M, U) ⊗[Γ(V, U)] Γ(N, U) :=
  (ofModules π M).tensorResₛₗ (ofModules π N) h

theorem resTw_tmul {U U' : V.Opens} (h : U ≤ U') (x : Γ(M, U')) (y : Γ(N, U')) :
    resTw π M N h (x ⊗ₜ y) = M.presheaf.map (homOfLE h).op x ⊗ₜ N.presheaf.map (homOfLE h).op y := rfl

theorem cmp_resTw {U U' : V.Opens} (h : U ≤ U') (t : Γ(M, U') ⊗[Γ(V, U')] Γ(N, U')) :
    cmp M N U (resTw π M N h t) = (M ⊗ N).presheaf.map (homOfLE h).op (cmp M N U' t) := by
  induction t using TensorProduct.induction_on with
  | zero => simp only [map_zero]
  | tmul x y =>
    rw [resTw_tmul, cmp_tmul, cmp_tmul]
    exact (Scheme.Modules.map_homOfLE_tensorSections h x y).symm
  | add a b ha hb => simp only [map_add, ha, hb]

theorem cmp_res {U U' : V.Opens} (h : U ≤ U') (t : ((ofModules π M).twist N).obj U') :
    cmp M N U (((ofModules π M).twist N).res h t) = (M ⊗ N).presheaf.map (homOfLE h).op (cmp M N U' t) :=
  cmp_resTw π M N h t

def cmpHom : AffHom ((ofModules π M).twist N) (ofModules π (M ⊗ N)) where
  app U :=
    { toFun := cmp M N U.1
      map_add' := fun a b => map_add _ a b
      map_smul' := fun r t => map_smul (cmp M N U.1)
        ((Scheme.TwoAffineOpenCover.algebraOfHom π U.1).algebraMap r) t }
  app_smul U a t := map_smul (cmp M N U.1) a t
  naturality h := LinearMap.ext fun t => cmp_res π M N h t

theorem cmpHom_bijective (hM : (ofModules π M).IsQuasicoherent) (hN : (ofModules π N).IsQuasicoherent)
    (U : V.affineOpens) : Function.Bijective ((cmpHom π M N).app U) :=
  Scheme.Modules.bijective_lift_tensorSectionsBilin_of_isQuasicoherent_monoidalV2 π hM hN U

end Compare

section Comm

variable {π} (F G : OModulePresheaf π)

def commHom : AffHom (F.tensor G) (G.tensor F) where
  app U :=
    { toFun := fun t => TensorProduct.comm Γ(V, U.1) (F.obj U.1) (G.obj U.1) t
      map_add' := fun a b => map_add _ a b
      map_smul' := fun r t => (TensorProduct.comm Γ(V, U.1) (F.obj U.1) (G.obj U.1)).map_smul
        ((Scheme.TwoAffineOpenCover.algebraOfHom π U.1).algebraMap r) t }
  app_smul U a t := (TensorProduct.comm Γ(V, U.1) (F.obj U.1) (G.obj U.1)).map_smul a t
  naturality {U U'} h := by
    refine LinearMap.ext fun t => ?_
    show TensorProduct.comm Γ(V, U.1) (F.obj U.1) (G.obj U.1) (F.tensorResₛₗ G h t) =
      G.tensorResₛₗ F h (TensorProduct.comm Γ(V, U'.1) (F.obj U'.1) (G.obj U'.1) t)
    induction t using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul x y => rw [tensorResₛₗ_tmul, TensorProduct.comm_tmul, TensorProduct.comm_tmul, tensorResₛₗ_tmul]
    | add a b ha hb => simp only [map_add]; rw [ha, hb]

theorem commHom_bijective (U : V.affineOpens) : Function.Bijective ((commHom F G).app U) :=
  (TensorProduct.comm Γ(V, U.1) (F.obj U.1) (G.obj U.1)).bijective

end Comm

section Zero

variable {π} (G : OModulePresheaf π) (K : V.OrderedAffineCover)

theorem zero_tensor_obj_eq_zero (U : V.Opens) (t : ((zero π).tensor G).obj U) : t = 0 := by
  induction t using TensorProduct.induction_on with
  | zero => rfl
  | tmul x y => rw [Subsingleton.elim x 0]; exact TensorProduct.zero_tmul _ y
  | add a b ha hb => rw [ha, hb]; exact add_zero _

scoped instance subsingleton_zero_tensor_obj (U : V.Opens) : Subsingleton (((zero π).tensor G).obj U) :=
  ⟨fun a b => by rw [zero_tensor_obj_eq_zero G U a, zero_tensor_obj_eq_zero G U b]⟩

scoped instance subsingleton_zero_tensor_cochain (i : ℕ) : Subsingleton (((zero π).tensor G).cochain K i) :=
  Pi.instSubsingleton

scoped instance subsingleton_zero_tensor_H0 : Subsingleton (((zero π).tensor G).H0 K) :=
  inferInstance

scoped instance subsingleton_zero_tensor_HSucc (i : ℕ) : Subsingleton (((zero π).tensor G).HSucc K i) :=
  (Submodule.Quotient.mk_surjective _).subsingleton

theorem cechFinite_zero_tensor : ((zero π).tensor G).CechFinite K := by
  refine ⟨?_, fun i => ?_⟩
  · exact Module.Finite.of_surjective (0 : R →ₗ[R] ((zero π).tensor G).H0 K) fun x => ⟨0, Subsingleton.elim _ _⟩
  · exact Module.Finite.of_surjective (0 : R →ₗ[R] ((zero π).tensor G).HSucc K i)
      fun x => ⟨0, Subsingleton.elim _ _⟩

theorem cechFinrank_zero_tensor [Nontrivial R] (i : ℕ) : ((zero π).tensor G).cechFinrank K i = 0 := by
  cases i with
  | zero => exact Module.finrank_zero_of_subsingleton
  | succ j => exact Module.finrank_zero_of_subsingleton

theorem eulerChar_zero_tensor [Nontrivial R] : ((zero π).tensor G).eulerChar K = 0 := by
  rw [eulerChar_def]
  exact Finset.sum_eq_zero fun i _ => by rw [cechFinrank_zero_tensor G K i]; simp

end Zero

section OfModules

variable (M : V.Modules)

theorem supportedIn_top : (ofModules π M).SupportedIn ⊤ := by
  intro U hU
  have hU' : ((U : V.Opens) : Set V) = ∅ := by simpa using hU
  have hbot : (U : V.Opens) = ⊥ := TopologicalSpace.Opens.ext (by simpa using hU')
  haveI : Subsingleton Γ(V, (U : V.Opens)) := by rw [hbot]; infer_instance
  exact Module.subsingleton Γ(V, (U : V.Opens)) _

theorem flat_obj_ofModules
    (htriv : ∀ x : V, ∃ (U : V.Opens), x ∈ U ∧
      Nonempty ((Scheme.Modules.pullback U.ι).obj M ≅ SheafOfModules.unit U.toScheme.ringCatSheaf))
    (U : V.affineOpens) : Module.Flat Γ(V, U.1) ((ofModules π M).obj U.1) := by
  show Module.Flat Γ(V, U.1) Γ(M, U.1)
  haveI := Scheme.Modules.projective_sections_of_locallyTrivial M htriv U
  exact Module.Flat.of_projective

end OfModules

theorem main
    (K : Type u) [Field K] [IsAlgClosed K] {A : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of K))
    (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle K f)
    (g : ℕ) [SmoothOfRelativeDimension g f]
    (n : ℕ) (hn : (n : K) ≠ 0)
    (𝓕 : A.Modules) (h𝓕 : Scheme.Modules.IsInvertible 𝓕)
    (𝓕' : A.Modules) (e : 𝓕' ≅ (Scheme.Modules.pullback (L.schemeNsmul n)).obj 𝓕)
    (𝒦 𝒦' : A.OrderedAffineCover) :
    (OModulePresheaf.ofModules f 𝓕').eulerChar 𝒦' = (n : ℤ) ^ (2 * g) * (OModulePresheaf.ofModules f 𝓕).eulerChar 𝒦 := by
  classical
  haveI := hA.proper
  have hn0 : n ≠ 0 := by
    rintro rfl
    exact hn (by simp)
  have hnpos : 0 < n := Nat.pos_of_ne_zero hn0
  obtain ⟨-, -, hfinγ, -, -, -⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.isFinite_schemeKerStr_and_finrank_eq_pow_and_finrank_schemeNsmul_eq_pow
      K f L hc hA g n hn0
  haveI := hfinγ
  have hover : L.schemeNsmul n ≫ f = f := L.schemeNsmul_over n
  haveI : IsSeparated (L.schemeNsmul n ≫ f) := by rw [hover]; infer_instance

  have h𝓕loc := h𝓕.1
  have h𝓕'loc : ∀ x : A, ∃ (U : A.Opens), x ∈ U ∧
      Nonempty ((Scheme.Modules.pullback U.ι).obj 𝓕' ≅ SheafOfModules.unit U.toScheme.ringCatSheaf) := fun x => by
    obtain ⟨U, hx, ⟨eU⟩⟩ := (h𝓕.pullback (L.schemeNsmul n)).1 x
    exact ⟨U, hx, ⟨(Scheme.Modules.pullback U.ι).mapIso e ≪≫ eU⟩⟩
  have hq𝓕 : (ofModules f 𝓕).IsQuasicoherent := isQuasicoherent_ofModules_of_locallyTrivial f 𝓕 h𝓕loc
  have hc𝓕 : (ofModules f 𝓕).IsCoherent := isCoherent_ofModules_of_locallyTrivial f 𝓕 h𝓕loc
  have hdim : topologicalKrullDim ((⊤ : TopologicalSpace.Closeds A) : Set A) ≤ g :=
    (topologicalKrullDim_subspace_le A _).trans (SmoothOfRelativeDimension.topologicalKrullDim_le f g)

  have hA1 : (ofModules f 𝓕').eulerChar 𝒦' = (ofModules (L.schemeNsmul n ≫ f) 𝓕').eulerChar 𝒦' := by
    rw [hover]
  have hq' : (ofModules (L.schemeNsmul n ≫ f) 𝓕').IsQuasicoherent :=
    isQuasicoherent_ofModules_of_locallyTrivial _ 𝓕' h𝓕'loc
  obtain ⟨h0a, hSa⟩ :=
    nonempty_cechEquiv_ofModules_of_isQuasicoherent_of_isSeparated (L.schemeNsmul n ≫ f) 𝓕' hq' 𝒦'
      (𝒦.comap (L.schemeNsmul n))
  obtain ⟨h0b, hSb, -⟩ :=
    nonempty_cechEquiv_ofModules_of_iso (L.schemeNsmul n ≫ f) e (𝒦.comap (L.schemeNsmul n))
  obtain ⟨h0c, hSc⟩ :=
    nonempty_cechEquiv_ofModules_pullback_comap_twist_pushforwardUnit f (L.schemeNsmul n) 𝒦 𝓕 h𝓕loc
  have hA2 : (ofModules (L.schemeNsmul n ≫ f) 𝓕').eulerChar 𝒦' =
      ((pushforwardUnit f (L.schemeNsmul n)).tensor (ofModules f 𝓕)).eulerChar 𝒦 :=
    eulerChar_eq_of_forall_cechFinrank_eq _ _ _ _ fun i =>
      ((cechFinrank_eq_of_cechEquiv h0a hSa i).trans (cechFinrank_eq_of_cechEquiv h0b hSb i)).trans
        (cechFinrank_eq_of_cechEquiv h0c hSc i)

  obtain ⟨E, M, hE0, hEd, hstep⟩ :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.exists_affSES_filtration_pushforwardUnit_schemeNsmul
      K f L hc hA g n hn
  have hflat : ∀ U : A.affineOpens, Module.Flat Γ(A, U.1) ((ofModules f 𝓕).obj U.1) :=
    flat_obj_ofModules f 𝓕 h𝓕loc

  have hpiece : ∀ j : ℕ, j < n ^ (2 * g) →
      ((ofModules f (M j)).tensor (ofModules f 𝓕)).eulerChar 𝒦 = (ofModules f 𝓕).eulerChar 𝒦 ∧
        ((ofModules f (M j)).tensor (ofModules f 𝓕)).CechFinite 𝒦 := by
    intro j hj
    obtain ⟨hMinv, ⟨eM⟩, -⟩ := hstep j hj
    have hqM : (ofModules f (M j)).IsQuasicoherent := isQuasicoherent_ofModules_of_locallyTrivial f (M j) hMinv.1
    let φ : AffHom ((ofModules f (M j)).tensor (ofModules f 𝓕)) (ofModules f (𝓕 ⊗ M j)) :=
      (cmpHom f 𝓕 (M j)).comp (commHom (ofModules f (M j)) (ofModules f 𝓕))
    have hφ : ∀ U : A.affineOpens, Function.Bijective (φ.app U) := fun U =>
      (cmpHom_bijective f 𝓕 (M j) hq𝓕 hqM U).comp (commHom_bijective (ofModules f (M j)) (ofModules f 𝓕) U)
    have hinv : Scheme.Modules.IsInvertible (𝓕 ⊗ M j) := h𝓕.tensor_monoidalV2 hMinv
    refine ⟨?_, ?_⟩
    · rw [eulerChar_eq_of_bijective 𝒦 φ hφ]
      exact eulerChar_ofModules_tensor_eq_of_tensorPow_iso_unit f 𝒦 𝓕 hc𝓕 hq𝓕 ⊤ (supportedIn_top f 𝓕) g hdim
        (M j) hMinv.1 n hnpos eM
    · exact cechFinite_of_bijective 𝒦 φ hφ (cechFinite_ofModules_of_locallyTrivial f (𝓕 ⊗ M j) hinv.1 𝒦)

  have hind : ∀ j : ℕ, j ≤ n ^ (2 * g) →
      ((E j).tensor (ofModules f 𝓕)).eulerChar 𝒦 = (j : ℤ) * (ofModules f 𝓕).eulerChar 𝒦 ∧
        ((E j).tensor (ofModules f 𝓕)).CechFinite 𝒦 := by
    intro j
    induction j with
    | zero =>
      intro _
      rw [hE0]
      exact ⟨by rw [eulerChar_zero_tensor]; simp, cechFinite_zero_tensor _ _⟩
    | succ j ih =>
      intro hj
      have hj' : j < n ^ (2 * g) := hj
      obtain ⟨ihχ, ihfin⟩ := ih hj'.le
      obtain ⟨-, -, ⟨S⟩⟩ := hstep j hj'
      obtain ⟨S', -⟩ := exists_affSES_tensor_of_flat S (ofModules f 𝓕) hflat
      obtain ⟨hχM, hfinM⟩ := hpiece j hj'
      have hfin : ((E (j + 1)).tensor (ofModules f 𝓕)).CechFinite 𝒦 := cechFinite_of_affSES_mid S' 𝒦 ihfin hfinM
      refine ⟨?_, hfin⟩
      rw [eulerChar_eq_add_of_affSES S' 𝒦 ihfin hfin hfinM, ihχ, hχM]
      push_cast
      ring

  obtain ⟨hχd, -⟩ := hind (n ^ (2 * g)) le_rfl
  rw [hEd] at hχd
  rw [hA1, hA2, hχd, Nat.cast_pow]

end Ws23ISOG
