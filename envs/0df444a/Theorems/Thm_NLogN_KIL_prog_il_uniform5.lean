open NLogN
open NLogN.KIL
open IntMul RS AModel AModelL12 AModelRat AModelFac
variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W) (tpl : IMat m → List (TStep m))

theorem NLogN.KIL.prog_il_uniform5 (hm : 1 ≤ m) :
    ∃ (iprog : Fin 1 → IStmt HS 1) (K Kd S : ℕ), iprog = progU C tpl ∧
      ∀ (q : ℕ), 2 ≤ q → ∀ (Bb k : ℕ), (∀ j < k, LvOK C tpl (q ^ m ^ j) Bb) →
      zsz (k : ℤ) ≤ Bb →
      ∀ (P L : ℕ) (A B Cs : Shape), 1 ≤ P → W ^ k ∣ L → 1 ≤ L →
      (∀ a ∈ A, 1 ≤ a) → (∀ a ∈ B, 1 ≤ a) → (∀ a ∈ Cs, 1 ≤ a) →
      zsz ((vol (P :: L :: swShape A B Cs (q ^ m ^ k)) : ℕ) : ℤ) ≤ Bb →
      ∀ (I : List Sym) (t : IState HS) (R : List Item) (xs : List (ZMod 2)),
        DescIn t q m k P L A B Cs →
        xs.length = vol (P :: L :: swShape A B Cs (q ^ m ^ k)) →
        IRuns I iprog (iprog 0) (t.upd 0 (ints (enc2 xs) ++ R))
          (t.upd 0 (ints (enc2 (AModel.prog C q k P L A B Cs xs)) ++ R))
          (ilCostU5 W K Kd S q Bb k (vol (P :: L :: swShape A B Cs (q ^ m ^ k)))) := by sorry
