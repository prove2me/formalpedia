-- title:
--   Independent cyclic generators of a finitely generated abelian group
-- statement:
--   Every finitely generated abelian group is generated by finitely many independent cyclic subgroups: there exist $n$ and elements $g_1, \dots, g_n$ such that the cyclic subgroups $\langle g_i \rangle$ are independent (each one meets the subgroup generated by the others trivially) and together they generate the whole group. This is the key algebraic input for Wolf's Lemma 3.7, which needs independent generating sets to control growth in the lower central series.

import Mathlib.GroupTheory.FiniteAbelian.Basic
import Mathlib.Order.SupIndep
import Mathlib.Algebra.Group.Pi.Lemmas
import Mathlib.Algebra.Notation.Pi.Basic
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Algebra.Group.TypeTags.Basic

set_option autoImplicit false

open scoped BigOperators

theorem Wolf.indep_gens_of_fg_comm {G : Type*} [Group G] [IsMulCommutative G] [Group.FG G] : ∃ (n : ℕ) (f : Fin n → G), iSupIndep (fun i => Subgroup.zpowers (f i)) ∧ (⨆ i, Subgroup.zpowers (f i)) = ⊤ := by sorry
