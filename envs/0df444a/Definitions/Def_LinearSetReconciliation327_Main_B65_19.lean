/-- Every factor `1 − vX` has degree at most one. -/
theorem pdec_one_sub_C_mul_X_natDegree_le {F : Type} [Field F] (v : F) :
    (1 - C v * X : F[X]).natDegree ≤ 1 := by
  have h1 : (C v * X : F[X]).natDegree ≤ 1 := by
    refine le_trans (Polynomial.natDegree_mul_le) ?_
    rw [Polynomial.natDegree_C, Polynomial.natDegree_X]
  have h2 : (1 : F[X]).natDegree ≤ 1 := by
    rw [Polynomial.natDegree_one]
    omega
  refine le_trans (Polynomial.natDegree_sub_le (1 : F[X]) (C v * X)) (max_le h2 h1)

/-- `1 − vX` is nonzero when `v ≠ 0`. -/
theorem pdec_one_sub_C_mul_X_ne_zero {F : Type} [Field F] {v : F} (hv : v ≠ 0) :
    (1 - C v * X : F[X]) ≠ 0 := by
  intro h
  have h1 : (1 - C v * X : F[X]).coeff 1 = -v := by
    rw [Polynomial.coeff_sub, Polynomial.coeff_one, Polynomial.coeff_C_mul, Polynomial.coeff_X]
    simp
  rw [h] at h1
  simp at h1
  exact hv (by simpa using h1)

theorem locDual_ne_zero {F : Type} [Field F] [DecidableEq F] (D : Finset F)
    (h0 : ∀ v ∈ D, v ≠ 0) : locDual D ≠ 0 := by
  classical
  rw [locDual]
  intro h
  obtain ⟨v, hv, hz⟩ := Finset.prod_eq_zero_iff.mp h
  exact pdec_one_sub_C_mul_X_ne_zero (h0 v hv) hz

/-- `deg σ ≤ #D`: the dual locator has at most `#D` factors of degree one. -/
theorem locDual_natDegree_le {F : Type} [Field F] [DecidableEq F] (D : Finset F) :
    (locDual D).natDegree ≤ D.card :=
  pdec_natDegree_finset_prod_le D (fun v => 1 - C v * X)
    (fun v _ => pdec_one_sub_C_mul_X_natDegree_le v)

/-- Each summand of `ω` spans `D.erase v`. -/
theorem pdec_omegaD_term_le {F : Type} [Field F] [DecidableEq F] (D : Finset F) (v : F) :
    (C v * ∏ w ∈ D.erase v, (1 - C w * X) : F[X]).natDegree ≤ (D.erase v).card := by
  have h1 : (C v * ∏ w ∈ D.erase v, (1 - C w * X) : F[X]).natDegree
      ≤ (C v : F[X]).natDegree + (∏ w ∈ D.erase v, (1 - C w * X)).natDegree :=
    Polynomial.natDegree_mul_le
  have h2 : (C v : F[X]).natDegree = 0 := Polynomial.natDegree_C v
  have h3 : (∏ w ∈ D.erase v, (1 - C w * X)).natDegree ≤ (D.erase v).card :=
    pdec_natDegree_finset_prod_le _ _ (fun w _ => pdec_one_sub_C_mul_X_natDegree_le w)
  omega

/-- **`deg ω < #D`** for a nonempty support: each cofactor spans `D.erase v`. -/
theorem omegaD_natDegree_lt {F : Type} [Field F] [DecidableEq F] (D : Finset F)
    (hne : D.Nonempty) : (omegaD D).natDegree < D.card := by
  have hcard : 0 < D.card := Finset.card_pos.mpr hne
  have hle : (omegaD D).natDegree ≤ D.card - 1 := by
    refine pdec_natDegree_finset_sum_le D
      (fun v => C v * ∏ w ∈ D.erase v, (1 - C w * X)) (D.card - 1) (fun v hv => ?_)
    have hlt : (D.erase v).card < D.card := Finset.card_erase_lt_of_mem hv
    have := pdec_omegaD_term_le D v
    omega
  omega

/-- `deg ω < t` as soon as `#D ≤ t` --- the empty support included (`ω = 0`, `deg 0 = 0 < t`). -/
theorem omegaD_natDegree_lt_of_card {F : Type} [Field F] [DecidableEq F] (D : Finset F) (t : ℕ)
    (ht : 1 ≤ t) (hcard : D.card ≤ t) : (omegaD D).natDegree < t := by
  by_cases h : D = ∅
  · subst h
    have : omegaD (∅ : Finset F) = 0 := by simp [omegaD]
    rw [this, Polynomial.natDegree_zero]
    omega
  · have hne : D.Nonempty := Finset.nonempty_iff_ne_empty.mpr h
    have := omegaD_natDegree_lt D hne
    omega

theorem locDual_eval {F : Type} [Field F] [DecidableEq F] (D : Finset F) (u : F) :
    (locDual D).eval u = ∏ v ∈ D, (1 - v * u) := by
  rw [locDual, eval_prod]
  exact Finset.prod_congr rfl (fun v _ => by simp)

/-- The dual locator vanishes at the inverse of every support point. -/
theorem locDual_eval_inv {F : Type} [Field F] [DecidableEq F] (D : Finset F) {v : F} (hv : v ≠ 0)
    (hmem : v ∈ D) : (locDual D).eval v⁻¹ = 0 := by
  rw [locDual_eval, Finset.prod_eq_zero_iff]
  exact ⟨v, hmem, by simp [hv]⟩

theorem omegaD_eval {F : Type} [Field F] [DecidableEq F] (D : Finset F) (u : F) :
    (omegaD D).eval u = ∑ v ∈ D, v * ∏ w ∈ D.erase v, (1 - w * u) := by
  classical
  have hsum : (omegaD D).eval u
      = ∑ v ∈ D, (C v * ∏ w ∈ D.erase v, (1 - C w * X) : F[X]).eval u := by
    unfold omegaD
    rw [show (∑ v ∈ D, C v * ∏ w ∈ D.erase v, (1 - C w * X) : F[X]).eval u
        = Polynomial.evalRingHom u (∑ v ∈ D, C v * ∏ w ∈ D.erase v, (1 - C w * X)) from rfl,
      map_sum]
    exact Finset.sum_congr rfl (fun v _ => rfl)
  rw [hsum]
  refine Finset.sum_congr rfl (fun v _ => ?_)
  rw [eval_mul, eval_C, eval_prod]
  congr 1
  exact Finset.prod_congr rfl (fun w _ => by simp)

/-- **`ω` does not vanish at the inverse of a support point.**  Every term of the sum except the
`v`-th contains the factor `1 − v v⁻¹ = 0`; the `v`-th term is a product of nonzero factors. -/
theorem omegaD_eval_inv_ne {F : Type} [Field F] [DecidableEq F] (D : Finset F) {v : F} (hv : v ≠ 0)
    (hmem : v ∈ D) : (omegaD D).eval v⁻¹ ≠ 0 := by
  classical
  have hsingle : (∑ v' ∈ D, v' * ∏ w ∈ D.erase v', (1 - w * v⁻¹))
      = v * ∏ w ∈ D.erase v, (1 - w * v⁻¹) := by
    refine Finset.sum_eq_single v ?_ ?_
    · intro w _ hwv
      refine mul_eq_zero.mpr (Or.inr ?_)
      refine Finset.prod_eq_zero_iff.mpr ⟨v, ?_, ?_⟩
      · rw [Finset.mem_erase]
        exact ⟨Ne.symm hwv, hmem⟩
      · rw [mul_inv_cancel₀ hv]
        ring
    · intro hnot
      exact absurd hmem hnot
  rw [omegaD_eval, hsingle]
  have hprod : (∏ w ∈ D.erase v, (1 - w * v⁻¹)) ≠ 0 := by
    intro hz
    obtain ⟨w, hw, hwz⟩ := Finset.prod_eq_zero_iff.mp hz
    rw [Finset.mem_erase] at hw
    exact hw.1 (by
      have h1 : w * v⁻¹ = 1 := (sub_eq_zero.mp hwz).symm
      calc w = w * v⁻¹ * v := by rw [mul_assoc, inv_mul_cancel₀ hv, mul_one]
        _ = 1 * v := by rw [h1]
        _ = v := one_mul v)
  intro hzero
  rcases mul_eq_zero.mp hzero with h | h
  · exact hv h
  · exact hprod h

/-- A solution of the key equation for the stored power sums is one for the support they come from. -/
theorem keySol_of_keySolE {F : Type} [Field F] [DecidableEq F] {D : Finset F} {e : ℕ → F} {t : ℕ}
    {σ ω : F[X]} (he : ∀ j < 2 * t, e j = ∑ v ∈ D, v ^ (j + 1)) (h : KeySolE e t σ ω) :
    KeySol D t σ ω := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  refine ⟨h1, h2, h3, ?_⟩
  have hs : synP D (2 * t) = ∑ j ∈ Finset.range (2 * t), C (e j) * X ^ j := by
    unfold synP
    exact Finset.sum_congr rfl (fun j hj => by rw [← he j (Finset.mem_range.mp hj)])
  rw [hs]
  exact h4

/-- The locator pair of a support of size `≤ t` **is** a key solution. -/
theorem locator_isKeySol {F : Type} [Field F] [DecidableEq F] (D : Finset F) (t : ℕ)
    (h0 : ∀ v ∈ D, v ≠ 0) (ht : 1 ≤ t) (hcard : D.card ≤ t) :
    KeySol D t (locDual D) (omegaD D) :=
  ⟨locDual_ne_zero D h0, le_trans (locDual_natDegree_le D) hcard,
    omegaD_natDegree_lt_of_card D t ht hcard, locator_key_equation D (2 * t)⟩

/-- **Root containment**: for *any* key solution and any support point `v`, `v⁻¹` is a root of
`σ`.  The cross-multiplied uniqueness of the key equation gives `σ ω₀ = σ₀ ω`; at `v⁻¹` the right
side vanishes (the locator has a root there) while `ω₀(v⁻¹) ≠ 0`. -/
theorem keySol_root_containment {F : Type} [Field F] [DecidableEq F] (D : Finset F) (t : ℕ)
    (h0 : ∀ v ∈ D, v ≠ 0) (ht : 1 ≤ t) (hcard : D.card ≤ t)
    {σ ω : F[X]} (hσ : KeySol D t σ ω) :
    ∀ v ∈ D, σ.eval v⁻¹ = 0 := by
  intro v hv
  have hσ₀ : KeySol D t (locDual D) (omegaD D) := locator_isKeySol D t h0 ht hcard
  have huniq : σ * omegaD D = locDual D * ω :=
    key_equation_unique (synP D (2 * t)) t hσ.1 hσ₀.1 hσ.2.1 hσ₀.2.1 hσ.2.2.1 hσ₀.2.2.1
      hσ.2.2.2 hσ₀.2.2.2
  have hev : σ.eval v⁻¹ * (omegaD D).eval v⁻¹ = (locDual D).eval v⁻¹ * ω.eval v⁻¹ := by
    rw [← eval_mul, huniq, eval_mul]
  rw [locDual_eval_inv D (h0 v hv) hv, zero_mul] at hev
  rcases mul_eq_zero.mp hev with h | h
  · exact h
  · exact absurd h (omegaD_eval_inv_ne D (h0 v hv) hv)

theorem pdec_finProdFinEquiv_val {t w : ℕ} (j : Fin t) (k : Fin w) :
    (finProdFinEquiv (j, k)).val = j.val * w + k.val := by
  simp [finProdFinEquiv, Nat.mul_comm, Nat.add_comm]

theorem pdec_finProdFinEquiv_mk {t w : ℕ} (j : Fin t) (k : Fin w)
    (h : j.val * w + k.val < t * w) :
    finProdFinEquiv (j, k) = (⟨j.val * w + k.val, h⟩ : Fin (t * w)) := by
  refine Fin.ext ?_
  rw [pdec_finProdFinEquiv_val]

theorem pdec_finProdFinEquiv_symm {t w : ℕ} (j : Fin t) (k : Fin w)
    (h : j.val * w + k.val < t * w) :
    finProdFinEquiv.symm (⟨j.val * w + k.val, h⟩ : Fin (t * w)) = (j, k) := by
  have hp := pdec_finProdFinEquiv_mk j k h
  rw [← hp, Equiv.symm_apply_apply]

/-- The bit of the payload at position `j·w + k` is the `k`-th coordinate of the `j`-th field. -/
theorem payloadField_apply_bits {F : Type} [Field F] [Algebra (ZMod 2) F] {w t : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (y : Fin (t * w) → ZMod 2) (j : Fin t) (k : Fin w)
    (h : j.val * w + k.val < t * w) :
    y (⟨j.val * w + k.val, h⟩ : Fin (t * w)) = b.repr (payloadField b y j) k := by
  rw [payloadField_apply]
  unfold payloadAt
  rw [dif_pos h]

/-- **Stage B, finished**: the `j`-th field of the packed payload is the `j`-th syndrome
coordinate. -/
theorem payloadField_pinBits {F : Type} [Field F] [Algebra (ZMod 2) F] {w t : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (s : Fin t → F) (j : Fin t) :
    payloadField b (pinBits b s) j = s j := by
  apply b.repr.injective
  refine Finsupp.ext (fun k => ?_)
  rw [payloadField_apply]
  have hlt : j.val * w + k.val < t * w := by
    have h1 : j.val < t := j.isLt
    have h2 : k.val < w := k.isLt
    have hstep : j.val * w + k.val < j.val * w + w := Nat.add_lt_add_left h2 _
    have hstep2 : j.val * w + w = (j.val + 1) * w := by rw [Nat.add_mul, Nat.one_mul]
    have hstep3 : (j.val + 1) * w ≤ t * w := Nat.mul_le_mul_right _ h1
    calc j.val * w + k.val < j.val * w + w := hstep
      _ = (j.val + 1) * w := hstep2
      _ ≤ t * w := hstep3
  unfold payloadAt
  rw [dif_pos hlt]
  show b.repr (s (finProdFinEquiv.symm ⟨j.val * w + k.val, hlt⟩).1)
      (finProdFinEquiv.symm ⟨j.val * w + k.val, hlt⟩).2 = b.repr (s j) k
  rw [pdec_finProdFinEquiv_symm j k hlt]

/-- The converse bridge: a syndrome whose payload fields are `payloadField b y` has payload `y`. -/
theorem pinBits_payloadField {F : Type} [Field F] [Algebra (ZMod 2) F] {w t : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) {y : Fin (t * w) → ZMod 2} {s : Fin t → F}
    (h : ∀ j : Fin t, s j = payloadField b y j) : pinBits b s = y := by
  funext p
  set q : Fin t × Fin w := finProdFinEquiv.symm p with hq
  have hp : finProdFinEquiv q = p := Equiv.apply_symm_apply _ _
  obtain ⟨j, k⟩ := q
  have hval : j.val * w + k.val = p.val := by
    have := congrArg Fin.val hp
    rwa [pdec_finProdFinEquiv_val] at this
  have hlt : j.val * w + k.val < t * w := by rw [hval]; exact p.isLt
  have hp' : p = (⟨j.val * w + k.val, hlt⟩ : Fin (t * w)) := by
    rw [← hp, pdec_finProdFinEquiv_mk j k hlt]
  show b.repr (s (finProdFinEquiv.symm p).1) (finProdFinEquiv.symm p).2 = y p
  have hsymm : finProdFinEquiv.symm p = (j, k) := by
    rw [hp', pdec_finProdFinEquiv_symm j k hlt]
  rw [hsymm, h j, ← payloadField_apply_bits b y j k hlt, hp']

/-- **The numbers the verifier compares against are the true power sums.**  The machine stores
`s_j = e j` for `j < 2t`: odd-indexed power sums `s_{2k} = P_{2k+1}` are read out of the packed
payload (`hodd`), and the even-indexed ones are squares, `s_{2a-1} = s_{a-1}²` (`heven`, the paper's
`P_{2a} = P_a²`).  Then `e (a-1)` is the true power sum `P_a` for every `a ∈ [1, 2t]`. -/
theorem expected_eq_pinPower {F : Type} [Field F] [Algebra (ZMod 2) F] {N t : ℕ}
    (ι : ℕ → F) (x : Fin N → ZMod 2) (e : ℕ → F)
    (hodd : ∀ k : Fin t, e (2 * k.val) = pin ι t x k)
    (heven : ∀ a : ℕ, 0 < a → e (2 * a - 1) = e (a - 1) ^ 2) :
    ∀ a : ℕ, 1 ≤ a → a ≤ 2 * t → e (a - 1) = pinPower ι a x := by
  intro a
  induction a using Nat.strong_induction_on with
  | _ a ih =>
    intro ha1 ha2
    rcases Nat.even_or_odd a with ⟨k, rfl⟩ | ⟨k, rfl⟩
    · -- even: `e (2k-1) = e (k-1)² = P_k² = P_{2k}`
      have hkpos : 0 < k := by omega
      have hklt : k < k + k := by omega
      have hk1 : 1 ≤ k := hkpos
      have hk2 : k ≤ 2 * t := by omega
      have hidx : k + k - 1 = 2 * k - 1 := by omega
      rw [hidx, heven k hkpos, ih k hklt hk1 hk2]
      rw [show k + k = 2 * k by omega, pinPower_frobenius]
    · -- odd: read out of the payload
      have hkt : k < t := by omega
      have hidx : 2 * k + 1 - 1 = 2 * k := by omega
      rw [hidx, hodd ⟨k, hkt⟩]
      rfl

theorem mem_binSupp_vecOf {F : Type} [Field F] [DecidableEq F] (N : ℕ) (ι : ℕ → F)
    (D : Finset F) (i : Fin N) : i ∈ binSupp (vecOf N ι D) ↔ ι i.val ∈ D := by
  rw [mem_binSupp]
  by_cases h : ι i.val ∈ D <;> simp [vecOf, h]

/-- **The power sums of a support**, read off a vector whose support is that set. -/
theorem pinPower_eq_sum_support {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F]
    {N : ℕ} (ι : ℕ → F) (x : Fin N → ZMod 2) (D : Finset F)
    (hD : ∀ v, v ∈ D ↔ ∃ i : Fin N, ι i.val = v ∧ x i = 1)
    (hinj : Set.InjOn ι (Set.Iio N)) (a : ℕ) :
    pinPower ι a x = ∑ v ∈ D, v ^ a := by
  rw [pinPower_eq_sum_supp]
  have himg : (binSupp x).image (fun i => ι i.val) = D := by
    ext v
    rw [hD v, Finset.mem_image]
    constructor
    · rintro ⟨i, hi, hv⟩
      exact ⟨i, hv, mem_binSupp.mp hi⟩
    · rintro ⟨i, hv, hi⟩
      exact ⟨i, mem_binSupp.mpr hi, hv⟩
  have hinj' : ∀ i ∈ binSupp x, ∀ j ∈ binSupp x, ι i.val = ι j.val → i = j := by
    intro i _ j _ h
    exact Fin.ext (hinj i.isLt j.isLt h)
  rw [← himg, Finset.sum_image hinj']

/-- The power sums of the answer vector are the power sums of the candidate set. -/
theorem pinPower_vecOf {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {N : ℕ}
    (ι : ℕ → F) (D : Finset F) (hinj : Set.InjOn ι (Set.Iio N))
    (hD : ∀ v ∈ D, ∃ i : Fin N, ι i.val = v) (a : ℕ) :
    pinPower ι a (vecOf N ι D) = ∑ v ∈ D, v ^ a := by
  refine pinPower_eq_sum_support ι _ D ?_ hinj a
  intro v
  constructor
  · intro hv
    obtain ⟨i, hi⟩ := hD v hv
    have hmem : ι i.val ∈ D := by rw [hi]; exact hv
    exact ⟨i, hi, mem_binSupp.mp ((mem_binSupp_vecOf N ι D i).mpr hmem)⟩
  · rintro ⟨i, hi, hx⟩
    have hmem : ι i.val ∈ D := (mem_binSupp_vecOf N ι D i).mp (mem_binSupp.mpr hx)
    exact hi ▸ hmem

/-- The answer vector has exactly `#D` support points. -/
theorem card_binSupp_vecOf {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {N : ℕ}
    (ι : ℕ → F) (D : Finset F) (hinj : Set.InjOn ι (Set.Iio N))
    (hD : ∀ v ∈ D, ∃ i : Fin N, ι i.val = v) :
    (binSupp (vecOf N ι D)).card = D.card := by
  have himg : (binSupp (vecOf N ι D)).image (fun i => ι i.val) = D := by
    ext v
    rw [Finset.mem_image]
    constructor
    · rintro ⟨i, hi, rfl⟩
      exact (mem_binSupp_vecOf N ι D i).mp hi
    · intro hv
      obtain ⟨i, hi⟩ := hD v hv
      have hmem : i ∈ binSupp (vecOf N ι D) := by
        rw [mem_binSupp_vecOf]
        rw [hi]
        exact hv
      exact ⟨i, hmem, hi⟩
  have hinj' : ∀ i ∈ binSupp (vecOf N ι D), ∀ j ∈ binSupp (vecOf N ι D),
      ι i.val = ι j.val → i = j := by
    intro i _ j _ h
    exact Fin.ext (hinj i.isLt j.isLt h)
  conv_rhs => rw [← himg]
  rw [Finset.card_image_of_injOn hinj']

/-- A solution of the key equation for a support is one for the power sums it stores. -/
theorem keySolE_of_keySol {F : Type} [Field F] [DecidableEq F] {D : Finset F} {e : ℕ → F} {t : ℕ}
    {σ ω : F[X]} (he : ∀ j < 2 * t, e j = ∑ v ∈ D, v ^ (j + 1)) (h : KeySol D t σ ω) :
    KeySolE e t σ ω := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  refine ⟨h1, h2, h3, ?_⟩
  have hs : synP D (2 * t) = ∑ j ∈ Finset.range (2 * t), C (e j) * X ^ j := by
    unfold synP
    exact Finset.sum_congr rfl (fun j hj => by rw [← he j (Finset.mem_range.mp hj)])
  rwa [hs] at h4

/-- **Accept**: if the verification test passes on the candidate `D'`, then the answer vector has
weight `≤ t` and exactly the right sketch --- so it *is* the light vector, and `OutputsSupport`
follows from the list of positions (`outputsSupport_of_mem` in the calculus). -/
theorem decoder_accept {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {N t w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (y : Fin (t * w) → ZMod 2) (e : ℕ → F)
    (hinj : Set.InjOn ι (Set.Iio N))
    (hodd : ∀ k : Fin t, e (2 * k.val) = payloadField b y k)
    (D' : Finset F) (hD' : ∀ v ∈ D', ∃ i : Fin N, ι i.val = v) (hcard : D'.card ≤ t)
    (hver : ∀ a ∈ Finset.Icc 1 (2 * t), ∑ v ∈ D', v ^ a = e (a - 1)) :
    ∃ x : Fin N → ZMod 2, (binSupp x).card ≤ t ∧ pinBits b (pin ι t x) = y ∧
      ∀ i : Fin N, x i = 1 ↔ ι i.val ∈ D' := by
  refine ⟨vecOf N ι D', ?_, ?_, ?_⟩
  · rw [card_binSupp_vecOf ι D' hinj hD']
    exact hcard
  · refine pinBits_payloadField b (s := pin ι t (vecOf N ι D')) (fun k => ?_)
    have h1 : pin ι t (vecOf N ι D') k = pinPower ι (2 * k.val + 1) (vecOf N ι D') := rfl
    rw [h1, pinPower_vecOf ι D' hinj hD']
    rw [← hodd k]
    have h2 := hver (2 * k.val + 1) (by
      rw [Finset.mem_Icc]
      have := k.isLt
      omega)
    have h3 : 2 * k.val + 1 - 1 = 2 * k.val := by omega
    rw [h3] at h2
    exact h2
  · intro i
    by_cases h : ι i.val ∈ D' <;> simp [vecOf, h]

@[simp] theorem traceValue_zero {F : Type} [Field F] (n : ℕ) :
    traceValue n (0 : F) = 0 := by
  induction n with
  | zero => rfl
  | succ n ih => simp [traceValue, ih]

theorem traceValue_add {F : Type} [Field F] [Algebra (ZMod 2) F]
    (n : ℕ) (x y : F) : traceValue n (x + y) = traceValue n x + traceValue n y := by
  haveI : CharP F 2 := pinsketch_charP_detFor65
  induction n with
  | zero => simp [traceValue]
  | succ n ih =>
      simp only [traceValue, ih, CharTwo.add_sq]
      ring

/-- Trace is an `F₂`-linear map. -/
def traceLinear {F : Type} [Field F] [Algebra (ZMod 2) F] (n : ℕ) : F →ₗ[ZMod 2] F where
  toFun := traceValue n
  map_add' := traceValue_add n
  map_smul' := by
    intro c x
    rcases zmod2_eq_zero_or_one c with hc | hc <;> simp [hc]

theorem tracePolynomial_eval {F : Type} [Field F] (a x : F) (n : ℕ) :
    (tracePolynomial a n).eval x = traceValue n (a * x) := by
  induction n with
  | zero => simp [tracePolynomial, traceValue]
  | succ n ih => simp [tracePolynomial, traceValue, ih]

/-- The sparse trace polynomial has degree strictly below the field size.
The implementation evaluates it modulo the current factor by `n` squarings. -/
theorem tracePolynomial_natDegree_lt {F : Type} [Field F] (a : F) (n : ℕ) :
    (tracePolynomial a n).natDegree < 2 ^ n := by
  induction n with
  | zero => simp [tracePolynomial]
  | succ n ih =>
      have hsq : ((tracePolynomial a n) ^ 2).natDegree ≤
          2 * (tracePolynomial a n).natDegree := by
        simpa only [pow_two, two_mul] using
          (Polynomial.natDegree_mul_le (p := tracePolynomial a n) (q := tracePolynomial a n))
      have hlin : (C a * X : F[X]).natDegree ≤ 1 := by
        simpa only [pow_one] using Polynomial.natDegree_C_mul_X_pow_le a 1
      have hsum := Polynomial.natDegree_add_le ((tracePolynomial a n) ^ 2) (C a * X)
      change (((tracePolynomial a n) ^ 2) + C a * X).natDegree < 2 ^ (n + 1)
      rw [Nat.pow_succ]
      have hp := Nat.two_pow_pos n
      omega

/-- Its derivative is nonzero whenever at least one term is present. -/
theorem tracePolynomial_derivative {F : Type} [Field F] [Algebra (ZMod 2) F] (n : ℕ) :
    Polynomial.derivative (tracePolynomial (1 : F) (n + 1)) = 1 := by
  simp [tracePolynomial, Polynomial.derivative_sq, pinsketch_two_eq_zero (F := F)]

theorem traceValue_square_add {F : Type} [Field F] [Algebra (ZMod 2) F]
    (n : ℕ) (z : F) : traceValue n z ^ 2 + traceValue n z = z ^ (2 ^ n) + z := by
  haveI : CharP F 2 := pinsketch_charP_detFor65
  induction n with
  | zero => simp [traceValue, CharTwo.add_self_eq_zero]
  | succ n ih =>
      have hs := congrArg (fun a : F => a ^ 2) ih
      rw [CharTwo.add_sq, CharTwo.add_sq] at hs
      have hp : z ^ (2 ^ (n + 1)) = (z ^ (2 ^ n)) ^ 2 := by
        rw [Nat.pow_succ, pow_mul]
      calc
        traceValue (n + 1) z ^ 2 + traceValue (n + 1) z
            = ((traceValue n z ^ 2) ^ 2 + traceValue n z ^ 2) + z ^ 2 + z := by
              simp only [traceValue, CharTwo.add_sq]
              ring
        _ = ((z ^ (2 ^ n)) ^ 2 + z ^ 2) + z ^ 2 + z := by rw [hs]
        _ = (z ^ (2 ^ n)) ^ 2 + ((z ^ 2 + z ^ 2) + z) := by ring
        _ = z ^ (2 ^ (n + 1)) + z := by rw [CharTwo.add_self_eq_zero, zero_add, ← hp]

/-- Cardinality and Frobenius follow from the supplied basis, independent of
which concrete finite field represents the coordinates. -/
theorem field_pow_two_dim {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (z : F) : z ^ (2 ^ w) = z := by
  letI : Fintype F := Fintype.ofEquiv (Fin w → ZMod 2) b.equivFun.toEquiv.symm
  have hcard : Fintype.card F = 2 ^ w := by
    calc
      Fintype.card F = Fintype.card (Fin w → ZMod 2) :=
        Fintype.card_congr b.equivFun.toEquiv
      _ = 2 ^ w := by simp
  rw [← hcard]
  exact FiniteField.pow_card z

/-- Every trace value is a bit. -/
theorem traceValue_bit {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (z : F) :
    traceValue w z = 0 ∨ traceValue w z = 1 := by
  haveI : CharP F 2 := pinsketch_charP_detFor65
  have h := traceValue_square_add w z
  rw [field_pow_two_dim b z, CharTwo.add_self_eq_zero] at h
  have hs : traceValue w z ^ 2 = traceValue w z := pinsketch_eq_of_add_eq_zero h
  have hp : traceValue w z * (traceValue w z - 1) = 0 := by
    calc
      traceValue w z * (traceValue w z - 1) = traceValue w z ^ 2 - traceValue w z := by ring
      _ = 0 := by rw [hs, sub_self]
  rcases mul_eq_zero.mp hp with h0 | h1
  · exact Or.inl h0
  · exact Or.inr (sub_eq_zero.mp h1)

/-- Trace is a nonzero functional.  The proof uses a degree bound; the
algorithm itself never enumerates the field. -/
theorem traceValue_nonzero {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (hw : 0 < w) :
    ∃ z : F, traceValue w z ≠ 0 := by
  classical
  letI : Fintype F := Fintype.ofEquiv (Fin w → ZMod 2) b.equivFun.toEquiv.symm
  have hcard : Fintype.card F = 2 ^ w := by
    calc
      Fintype.card F = Fintype.card (Fin w → ZMod 2) :=
        Fintype.card_congr b.equivFun.toEquiv
      _ = 2 ^ w := by simp
  by_contra h
  push_neg at h
  have hp : tracePolynomial (1 : F) w = 0 := by
    apply pdec_eq_zero_of_card (s := Finset.univ)
    · rw [Finset.card_univ, hcard]
      exact tracePolynomial_natDegree_lt 1 w
    · intro z _
      simpa only [tracePolynomial_eval, one_mul] using h z
  obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hw.ne'
  rw [hn] at hp
  have hd := tracePolynomial_derivative (F := F) n
  rw [hp, Polynomial.derivative_zero] at hd
  exact zero_ne_one hd

/-- Traces against basis vectors detect every nonzero element. -/
theorem basis_trace_detects {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (hw : 0 < w) {z : F} (hz : z ≠ 0) :
    ∃ j : Fin w, traceValue w (b j * z) ≠ 0 := by
  classical
  obtain ⟨c, hc⟩ := traceValue_nonzero b hw
  by_contra h
  push_neg at h
  let L : F →ₗ[ZMod 2] F :=
    { toFun := fun a => traceValue w (a * z)
      map_add' := fun a d => by rw [add_mul, traceValue_add]
      map_smul' := by
        intro a d
        rcases zmod2_eq_zero_or_one a with ha | ha <;> simp [ha] }
  have hL : L = 0 := b.ext (fun j => by
    change traceValue w (b j * z) = 0
    exact h j)
  have hcz := congrArg (fun f : F →ₗ[ZMod 2] F => f (c / z)) hL
  change traceValue w (c / z * z) = 0 at hcz
  rw [div_mul_cancel₀ c hz] at hcz
  exact hc hcz

/-- The `w` trace splitters separate all field elements. -/
theorem basis_trace_separates {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (hw : 0 < w) {u v : F} (h : u ≠ v) :
    ∃ j : Fin w, (tracePolynomial (b j) w).eval u ≠ (tracePolynomial (b j) w).eval v := by
  obtain ⟨j, hj⟩ := basis_trace_detects b hw (sub_ne_zero.mpr h)
  refine ⟨j, ?_⟩
  rw [tracePolynomial_eval, tracePolynomial_eval]
  intro heq
  apply hj
  rw [mul_sub]
  change traceLinear w (b j * u - b j * v) = 0
  rw [map_sub]
  change traceValue w (b j * u) - traceValue w (b j * v) = 0
  rw [heq, sub_self]

/-- Evaluation form of membership in the finite root set. -/
theorem rootSet_mem_iff {F : Type} [Field F] [DecidableEq F]
    {f : F[X]} (hf : f ≠ 0) (u : F) :
    u ∈ f.roots.toFinset ↔ f.eval u = 0 := by
  rw [Multiset.mem_toFinset, Polynomial.mem_roots hf, Polynomial.IsRoot.def]

theorem constant_eval_ne_zero {F : Type} [Field F] {f : F[X]}
    (hf : f ≠ 0) (hdeg : f.natDegree = 0) (u : F) : f.eval u ≠ 0 := by
  obtain ⟨a, ha⟩ := Polynomial.natDegree_eq_zero.mp hdeg
  intro hu
  rw [← ha, Polynomial.eval_C] at hu
  exact hf (by rw [← ha, hu, Polynomial.C_0])

/-- Splitting is correct on a square-free split input.  The condition is only
needed for completeness; the later syndrome verifier certifies every accepted
answer independently. -/
theorem rootSearch_spec {F : Type} [Field F] [DecidableEq F]
    (ps : List F[X]) (f : F[X]) (hf : f ≠ 0) (hsplit : f.Splits) (hsep : f.Separable)
    (hbit : ∀ p ∈ ps, ∀ u : F, p.eval u = 0 ∨ p.eval u = 1)
    (hsepar : SeparatesRoots ps f) :
    (rootSearch ps f).Nodup ∧ ∀ u : F, u ∈ rootSearch ps f ↔ f.eval u = 0 := by
  induction ps generalizing f with
  | nil =>
      have hcard : f.roots.toFinset.card ≤ 1 := by
        apply Finset.card_le_one.mpr
        intro u hu v hv
        by_contra hne
        obtain ⟨p, hp, _⟩ := hsepar u v ((rootSet_mem_iff hf u).mp hu)
          ((rootSet_mem_iff hf v).mp hv) hne
        simp at hp
      rw [Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hsep)] at hcard
      have hdeg : f.natDegree ≤ 1 := by
        rw [hsplit.natDegree_eq_card_roots]
        exact hcard
      by_cases hone : f.natDegree = 1
      · rw [rootSearch, if_pos hone]
        refine ⟨by simp, ?_⟩
        intro u
        simpa only [List.mem_singleton] using (linearRoot_eval_iff hf hone u).symm
      · have hzero : f.natDegree = 0 := by omega
        rw [rootSearch, if_neg hone]
        refine ⟨by simp, ?_⟩
        intro u
        simp [constant_eval_ne_zero hf hzero u]
  | cons p ps ih =>
      by_cases hzero : f.natDegree = 0
      · rw [rootSearch, if_pos hzero]
        refine ⟨by simp, ?_⟩
        intro u
        simp [constant_eval_ne_zero hf hzero u]
      · let g0 := EuclideanDomain.gcd f p
        let g1 := EuclideanDomain.gcd f (p - 1)
        have h0ne : g0 ≠ 0 := gcd_ne_zero_left hf p
        have h1ne : g1 ≠ 0 := gcd_ne_zero_left hf (p - 1)
        have h0dvd : g0 ∣ f := EuclideanDomain.gcd_dvd_left f p
        have h1dvd : g1 ∣ f := EuclideanDomain.gcd_dvd_left f (p - 1)
        have h0root (u : F) : g0.eval u = 0 ↔ f.eval u = 0 ∧ p.eval u = 0 :=
          gcd_eval_iff f p u
        have h1root (u : F) : g1.eval u = 0 ↔ f.eval u = 0 ∧ p.eval u = 1 := by
          change (EuclideanDomain.gcd f (p - 1)).eval u = 0 ↔ f.eval u = 0 ∧ p.eval u = 1
          rw [gcd_eval_iff]
          simp only [Polynomial.eval_sub, Polynomial.eval_one, sub_eq_zero]
        have htailbit : ∀ q ∈ ps, ∀ u : F, q.eval u = 0 ∨ q.eval u = 1 := by
          intro q hq u
          exact hbit q (List.mem_cons_of_mem p hq) u
        have htail (g : F[X]) (hsub : ∀ u, g.eval u = 0 → f.eval u = 0)
            (hsame : ∀ u v, g.eval u = 0 → g.eval v = 0 → p.eval u = p.eval v) :
            SeparatesRoots ps g := by
          intro u v hu hv huv
          obtain ⟨q, hq, hne⟩ := hsepar u v (hsub u hu) (hsub v hv) huv
          rcases List.mem_cons.mp hq with hq | hq
          · subst q
            exact False.elim (hne (hsame u v hu hv))
          · exact ⟨q, hq, hne⟩
        have hsep0 : SeparatesRoots ps g0 := htail g0
          (fun u hu => ((h0root u).mp hu).1)
          (fun u v hu hv => (((h0root u).mp hu).2).trans ((((h0root v).mp hv).2).symm))
        have hsep1 : SeparatesRoots ps g1 := htail g1
          (fun u hu => ((h1root u).mp hu).1)
          (fun u v hu hv => (((h1root u).mp hu).2).trans ((((h1root v).mp hv).2).symm))
        obtain ⟨hnd0, hmem0⟩ := ih g0 h0ne (hsplit.of_dvd hf h0dvd)
          (hsep.of_dvd h0dvd) htailbit hsep0
        obtain ⟨hnd1, hmem1⟩ := ih g1 h1ne (hsplit.of_dvd hf h1dvd)
          (hsep.of_dvd h1dvd) htailbit hsep1
        have hdisj : List.Disjoint (rootSearch ps g0) (rootSearch ps g1) := by
          apply List.disjoint_left.mpr
          intro u hu0 hu1
          have h0 := ((h0root u).mp ((hmem0 u).mp hu0)).2
          have h1 := ((h1root u).mp ((hmem1 u).mp hu1)).2
          exact zero_ne_one (h0.symm.trans h1)
        rw [rootSearch, if_neg hzero]
        refine ⟨List.nodup_append'.mpr ⟨hnd0, hnd1, hdisj⟩, ?_⟩
        intro u
        change (u ∈ rootSearch ps g0 ++ rootSearch ps g1) ↔ f.eval u = 0
        rw [List.mem_append, hmem0, hmem1, h0root, h1root]
        constructor
        · rintro (h | h) <;> exact h.1
        · intro hu
          rcases hbit p (List.mem_cons_self) u with h0 | h1
          · exact Or.inl ⟨hu, h0⟩
          · exact Or.inr ⟨hu, h1⟩

/-- The output list fits in the degree budget. -/
theorem rootSearch_length_le {F : Type} [Field F] [DecidableEq F]
    (ps : List F[X]) (f : F[X]) (hf : f ≠ 0) (hsplit : f.Splits) (hsep : f.Separable)
    (hbit : ∀ p ∈ ps, ∀ u : F, p.eval u = 0 ∨ p.eval u = 1)
    (hsepar : SeparatesRoots ps f) : (rootSearch ps f).length ≤ f.natDegree := by
  obtain ⟨hnd, hmem⟩ := rootSearch_spec ps f hf hsplit hsep hbit hsepar
  have heq : (rootSearch ps f).toFinset = f.roots.toFinset := by
    ext u
    rw [List.mem_toFinset, hmem, rootSet_mem_iff hf]
  calc
    (rootSearch ps f).length = (rootSearch ps f).toFinset.card :=
      (List.toFinset_card_of_nodup hnd).symm
    _ = f.roots.toFinset.card := congrArg Finset.card heq
    _ ≤ f.roots.card := Multiset.toFinset_card_le _
    _ ≤ f.natDegree := Polynomial.card_roots' f

theorem traceSplitters_bit {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) :
    ∀ p ∈ traceSplitters b, ∀ u : F, p.eval u = 0 ∨ p.eval u = 1 := by
  intro p hp u
  obtain ⟨j, rfl⟩ := List.mem_ofFn.mp hp
  rw [tracePolynomial_eval]
  exact traceValue_bit b (b j * u)

theorem traceSplitters_separates {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (hw : 0 < w) (f : F[X]) :
    SeparatesRoots (traceSplitters b) f := by
  intro u v _ _ huv
  obtain ⟨j, hj⟩ := basis_trace_separates b hw huv
  exact ⟨tracePolynomial (b j) w, List.mem_ofFn.mpr ⟨j, rfl⟩, hj⟩

theorem rootsByBasis_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (hw : 0 < w) (f : F[X])
    (hf : f ≠ 0) (hsplit : f.Splits) (hsep : f.Separable) :
    (rootsByBasis b f).Nodup ∧
      (∀ u : F, u ∈ rootsByBasis b f ↔ f.eval u = 0) ∧
      (rootsByBasis b f).length ≤ f.natDegree := by
  have heq : rootsByBasis b f = rootSearch (traceSplitters b) f := by
    rw [rootsByBasis, traceRootSearch_eq]
    congr 1
    simp [traceSplitters, List.map_ofFn, Function.comp_def]
  rw [heq]
  have h := rootSearch_spec (traceSplitters b) f hf hsplit hsep
    (traceSplitters_bit b) (traceSplitters_separates b hw f)
  exact ⟨h.1, h.2, rootSearch_length_le (traceSplitters b) f hf hsplit hsep
    (traceSplitters_bit b) (traceSplitters_separates b hw f)⟩

/-- On a decodable sequence, a minimum key solution has exactly the inverse
support roots, with neither missing roots nor multiplicities. -/
theorem minimum_key_roots {F : Type} [Field F] [DecidableEq F]
    (D : Finset F) (e : ℕ → F) (t : ℕ) (ht : 1 ≤ t)
    (h0 : ∀ v ∈ D, v ≠ 0) (hcard : D.card ≤ t)
    (he : ∀ j < 2 * t, e j = ∑ v ∈ D, v ^ (j + 1))
    {σ ω : F[X]} (hmin : KeySolEMin e t σ ω) :
    σ.Splits ∧ σ.Separable ∧ ∀ u : F, σ.eval u = 0 ↔ u⁻¹ ∈ D := by
  let R := D.image (fun v => v⁻¹)
  have hRcard : R.card = D.card := Finset.card_image_of_injOn (fun a _ b _ hab => by
    rw [← inv_inv a, hab, inv_inv])
  have hsub : R ⊆ σ.roots.toFinset := by
    intro u hu
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hu
    rw [rootSet_mem_iff hmin.1.1]
    exact keySol_root_containment D t h0 ht hcard (keySol_of_keySolE he hmin.1) v hv
  have htrue : KeySolE e t (locDual D) (omegaD D) :=
    keySolE_of_keySol he (locator_isKeySol D t h0 ht hcard)
  have hdeg : σ.natDegree ≤ D.card :=
    le_trans (hmin.2 _ _ htrue) (locDual_natDegree_le D)
  have hcard0 := Finset.card_le_card hsub
  have hcard1 := Multiset.toFinset_card_le σ.roots
  have hcard2 := Polynomial.card_roots' σ
  have hsplit : σ.Splits := Polynomial.splits_iff_card_roots.mpr (by omega)
  have hnodup : σ.roots.Nodup :=
    Multiset.toFinset_card_eq_card_iff_nodup.mp (by omega)
  have hsep : σ.Separable :=
    (Polynomial.nodup_roots_iff_of_splits hmin.1.1 hsplit).mp hnodup
  have hset : R = σ.roots.toFinset := Finset.eq_of_subset_of_card_le hsub (by omega)
  refine ⟨hsplit, hsep, ?_⟩
  intro u
  rw [← rootSet_mem_iff hmin.1.1, ← hset]
  constructor
  · intro hu
    obtain ⟨v, hv, hvi⟩ := Finset.mem_image.mp hu
    have hvu : v = u⁻¹ := by rw [← hvi, inv_inv]
    rw [← hvu]
    exact hv
  · intro hu
    exact Finset.mem_image.mpr ⟨u⁻¹, hu, inv_inv u⟩

theorem supportCandidate_eq {F : Type} [Field F] [DecidableEq F]
    [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (hw : 0 < w)
    (D : Finset F) (e : ℕ → F) (t : ℕ) (ht : 1 ≤ t)
    (h0 : ∀ v ∈ D, v ≠ 0) (hcard : D.card ≤ t)
    (he : ∀ j < 2 * t, e j = ∑ v ∈ D, v ^ (j + 1)) :
    supportCandidate b (padeSolve e t).curC = D := by
  have hmin := padeSolve_minimal e t ht
  obtain ⟨hsplit, hsep, hroots⟩ := minimum_key_roots D e t ht h0 hcard he hmin
  obtain ⟨_, hmem, _⟩ := rootsByBasis_spec b hw (padeSolve e t).curC hmin.1.1 hsplit hsep
  ext v
  simp only [supportCandidate, List.mem_toFinset, List.mem_map]
  constructor
  · rintro ⟨u, hu, huv⟩
    have hv := (hroots u).mp ((hmem u).mp hu)
    rwa [huv] at hv
  · intro hv
    refine ⟨v⁻¹, ?_, inv_inv v⟩
    exact (hmem v⁻¹).mpr ((hroots v⁻¹).mpr (by simpa using hv))

/-- A successful verifier supplies a valid light-vector answer. -/
theorem verified_candidate_accept {F : Type} [Field F] [DecidableEq F]
    [Algebra (ZMod 2) F] {N t w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F)
    (y : Fin (t * w) → ZMod 2) (e : ℕ → F) (D : Finset F)
    (hinj : Set.InjOn ι (Set.Iio N))
    (hodd : ∀ k : Fin t, e (2 * k.val) = payloadField b y k)
    (hverified : CandidateVerified N t ι e D) :
    ∃ x : Fin N → ZMod 2, (binSupp x).card ≤ t ∧ pinBits b (pin ι t x) = y ∧
      ∀ i : Fin N, x i = 1 ↔ ι i.val ∈ D :=
  decoder_accept b ι y e hinj hodd D hverified.2.1 hverified.1 hverified.2.2

/-- Rejection of the computed candidate is complete.  Splitting and
separability are derived only under the hypothetical existence of a valid
answer; arbitrary input polynomials do not need to split. -/
theorem computed_candidate_reject {F : Type} [Field F] [DecidableEq F]
    [Algebra (ZMod 2) F] {N t w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F)
    (y : Fin (t * w) → ZMod 2) (e : ℕ → F) (ht : 1 ≤ t) (hw : 0 < w)
    (h0 : ∀ v < N, ι v ≠ 0) (hinj : Set.InjOn ι (Set.Iio N))
    (hodd : ∀ k : Fin t, e (2 * k.val) = payloadField b y k)
    (heven : ∀ a : ℕ, 0 < a → e (2 * a - 1) = e (a - 1) ^ 2)
    (hfail : ¬ CandidateVerified N t ι e (supportCandidate b (padeSolve e t).curC)) :
    ¬ ∃ x : Fin N → ZMod 2, (binSupp x).card ≤ t ∧ pinBits b (pin ι t x) = y := by
  rintro ⟨x, hx, hxy⟩
  let D := (binSupp x).image (fun i => ι i.val)
  have hDmem : ∀ v, v ∈ D ↔ ∃ i : Fin N, ι i.val = v ∧ x i = 1 := by
    intro v
    simp only [D, Finset.mem_image, mem_binSupp]
    constructor
    · rintro ⟨i, hi, hv⟩
      exact ⟨i, hv, hi⟩
    · rintro ⟨i, hv, hi⟩
      exact ⟨i, hi, hv⟩
  have hDcard : D.card ≤ t := le_trans (Finset.card_image_le) hx
  have hD0 : ∀ v ∈ D, v ≠ 0 := by
    intro v hv
    obtain ⟨i, hi, _⟩ := (hDmem v).mp hv
    rw [← hi]
    exact h0 i.val i.isLt
  have he : ∀ a : ℕ, 1 ≤ a → a ≤ 2 * t → e (a - 1) = pinPower ι a x := by
    refine expected_eq_pinPower ι x e (fun k => ?_) heven
    rw [hodd k, ← hxy]
    exact payloadField_pinBits b (pin ι t x) k
  have hsum : ∀ a : ℕ, 1 ≤ a → a ≤ 2 * t → ∑ v ∈ D, v ^ a = e (a - 1) := by
    intro a ha1 ha2
    rw [he a ha1 ha2, pinPower_eq_sum_support ι x D hDmem hinj a]
  have heD : ∀ j < 2 * t, e j = ∑ v ∈ D, v ^ (j + 1) := by
    intro j hj
    simpa only [Nat.add_sub_cancel] using (hsum (j + 1) (by omega) (by omega)).symm
  have hcandidate := supportCandidate_eq b hw D e t ht hD0 hDcard heD
  apply hfail
  rw [hcandidate]
  refine ⟨hDcard, ?_, ?_⟩
  · intro v hv
    obtain ⟨i, hi, _⟩ := (hDmem v).mp hv
    exact ⟨i, hi⟩
  · intro a ha
    rw [Finset.mem_Icc] at ha
    exact hsum a ha.1 ha.2

