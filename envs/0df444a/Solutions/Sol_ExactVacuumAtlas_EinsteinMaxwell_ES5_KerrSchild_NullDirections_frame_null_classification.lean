      (f * a1 * v 0 + H * e * v 3) ^ 2 / (D * f * H) +
        (alphaSqFrame f D H e a1 + betaSqFrame A a0) *
          (A / (4 * u * (1 - u)) * v 2 ^ 2 + A * u * (1 - u) * v 4 ^ 2) := by
  simp only [frameQ, frameZ, alphaSqFrame, betaSqFrame, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Matrix.head_cons,
    Matrix.tail_cons]
  field_simp
  ring

/-- `q(K_λ) = D (λ² - α²)`. -/
theorem frameQ_principal {f D A H u : ℝ} (hf : f ≠ 0) (hD : D ≠ 0) (hH : H ≠ 0)
    (e a1 lam : ℝ) :
    frameQ f D A H u (principalFrame f H e a1 lam) = D * (lam ^ 2 - alphaSqFrame f D H e a1) := by
  simp only [frameQ, principalFrame, alphaSqFrame, Matrix.cons_val_zero, Matrix.cons_val_one,
