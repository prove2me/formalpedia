variable {A' : Type} [AddCommGroup A'] (e : ℕ) {n : ℕ} (ε : Idx n ≃ A') (h' : A' →+ Additive (HGrp e))
  (hs : Function.Surjective h') (a' : A') (hk : ∀ k : ℤ, h' (k • a') = 0 → k • a' = 0)
variable [Fintype A']

theorem Formalism.HC.Frame.ofGroup_h (t : (ofGroup e h' hs a' hk).A) :
