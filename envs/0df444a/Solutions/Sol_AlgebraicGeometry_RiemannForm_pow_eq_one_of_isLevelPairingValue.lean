theorem solution
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle k f)
    (𝓛 : A.Modules) (h𝓛 : Scheme.Modules.IsInvertible 𝓛)
    (n : ℕ) (hn : (n : k) ≠ 0) (P Q : L.AlgPoints hc k) (hP : n • P = 0) (hQ : n • Q = 0) (c : k)
    (h : IsLevelPairingValue f L 𝓛 n (RelativeGroupLaw.AlgPoints.toPoint P) (RelativeGroupLaw.AlgPoints.toPoint Q) c) :
    c ^ n = 1 := by
  have hn0 : n ≠ 0 := by rintro rfl; exact hn Nat.cast_zero

  have hjQ : ∀ j : ℕ, n • (j • Q) = 0 := fun j => by rw [← mul_nsmul', mul_comm, mul_nsmul', hQ, nsmul_zero]
  have hiter : ∀ j : ℕ, IsLevelPairingValue f L 𝓛 n (RelativeGroupLaw.AlgPoints.toPoint P)
      (RelativeGroupLaw.AlgPoints.toPoint ((j + 1) • Q)) (c ^ (j + 1)) := by
    intro j
    induction j with
    | zero => simpa [one_nsmul, pow_one] using h
    | succ j ih =>
      have h2 := (AlgebraicGeometry.RiemannForm.isLevelPairingValue_add_left_and_add_right k f L hc hA 𝓛 h𝓛 n hn
        P P Q ((j + 1) • Q) hP hP hQ (hjQ (j + 1)) c c (c ^ (j + 1)) h).2 ih
      rw [show (j + 1 + 1) • Q = Q + (j + 1) • Q by rw [add_comm Q, succ_nsmul], pow_succ', ]
      exact h2
  have hnQ : IsLevelPairingValue f L 𝓛 n (RelativeGroupLaw.AlgPoints.toPoint P)
      (RelativeGroupLaw.AlgPoints.toPoint (0 : L.AlgPoints hc k)) (c ^ n) := by
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn0
    rw [← hQ]
    exact hiter m

  have h0 : translation f L (RelativeGroupLaw.AlgPoints.toPoint (0 : L.AlgPoints hc k)) = 𝟙 A :=
    (AlgebraicGeometry.RiemannForm.translation_zero_and_translation_add k f L hc 0 0).1
  have hx := AlgebraicGeometry.RiemannForm.translation_comp_schemeNsmul_of_nsmul_eq_zero k f L hc P n hP
  let α : (Scheme.Modules.pullback (translation f L (RelativeGroupLaw.AlgPoints.toPoint (0 : L.AlgPoints hc k)))).obj 𝓛 ≅ 𝓛 :=
    (Scheme.Modules.pullbackCongr h0).app 𝓛 ≪≫ (Scheme.Modules.pullbackId A).app 𝓛
  have hone : IsLevelPairingValue f L 𝓛 n (RelativeGroupLaw.AlgPoints.toPoint P)
      (RelativeGroupLaw.AlgPoints.toPoint (0 : L.AlgPoints hc k)) 1 := by
    refine ⟨hx, (Scheme.Modules.pullback (L.schemeNsmul n)).mapIso α, ?_⟩
    rw [transport_conj hx α]
    exact isConstScalar_id f _

  exact (AlgebraicGeometry.RiemannForm.existsUnique_isLevelPairingValue k f L hc hA 𝓛 h𝓛 n hn P 0 hP (by rw [nsmul_zero] )).unique hnQ hone

end S_AlgebraicGeometry_RiemannForm_pow_eq_one_of_isLevelPairingValue
