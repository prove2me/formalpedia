  haveI : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap A (↥(ModularCurve.TwoChart.chartAlgFin A Kf j) ⧸ I)))) := by
    rw [IsFinite.SpecMap_iff]
    exact (RingHom.finite_algebraMap (A := A) (B := ↥(ModularCurve.TwoChart.chartAlgFin A Kf j) ⧸ I)).mpr inferInstance
  haveI : UniversallyClosed (ζ I ≫ ModularCurve.TwoChart.modelTo A Kf j) := by rw [ζ_toBase]; infer_instance
  haveI : UniversallyClosed (ζ I) := .of_comp_of_isSeparated _ (ModularCurve.TwoChart.modelTo A Kf j)
