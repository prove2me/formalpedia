/-- The full Nat-indexed product factor is multipliable for `‖q‖ < 1`. -/
theorem multipliable_jacobiProductNatFactor (q z : ℂ) (hq : ‖q‖ < 1) :
    Multipliable fun n : ℕ => jacobiProductNatFactor q z n := by
