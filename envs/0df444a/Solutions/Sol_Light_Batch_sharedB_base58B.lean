theorem base58B_append (R : Program) :
    base58B ++ R = (base58P ++ R).set Sec2.pBandArray bandArrayBBody := by
  rw [base58B, List.set_append_left _ _ (by rw [length_base58]; decide)]

theorem at_base58B {i : ℕ} {body : Stmt} (h : base58P[i]? = some body) (hi : i ≠ Sec2.pBandArray)
    (R : Program) : (base58B ++ R)[i]? = some body := by
