theorem solution
    {r rbar : ℕ} [Fact r.Prime] [Fact rbar.Prime] (hrr : rbar ≠ r)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b r rbar)
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) {N : ℕ} (n ℓ : ℕ) (hn : 3 ≤ n)
    {𝒪 : Type} [CommRing 𝒪]
    (M : Scheme.{0}) (fM : M ⟶ Spec (CommRingCat.of 𝒪))
    (ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
      FakeEllipticCurve.WithFullLevel Λ N n S → SchemeHomOver s fM)
    (hM : IsFineModuli Λ N n M fM ptF)
    (Mℓ : Scheme.{0}) (fMℓ : Mℓ ⟶ Spec (CommRingCat.of 𝒪))
    (ptFℓ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)) (u : FakeEllipticCurve.WithFullLevel Λ N n S),
      u.1.ExtraLevel ℓ → SchemeHomOver s fMℓ)
    (hMℓ : IsFineModuliT Λ N n ℓ Mℓ fMℓ ptFℓ)
    (πℓ : Mℓ ⟶ M) (hπℓf : πℓ ≫ fM = fMℓ)
    (hπℓ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)) (u : FakeEllipticCurve.WithFullLevel Λ N n S)
      (C : u.1.ExtraLevel ℓ), (ptFℓ S s u C).1 ≫ πℓ = (ptF S s u).1)
    {S S₀ : Type} [CommRing S] [CommRing S₀] (p : S →+* S₀) (hp : Function.Surjective p) (hI : IsNilpotent (RingHom.ker p))
    (hnS : IsUnit ((n : ℕ) : S)) (hℓS : IsUnit ((ℓ : ℕ) : S))
    (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)) (y y' : SchemeHomOver s fMℓ)
    (hπ : y.1 ≫ πℓ = y'.1 ≫ πℓ)
    (h₀ : Spec.map (CommRingCat.ofHom p) ≫ y.1 = Spec.map (CommRingCat.ofHom p) ≫ y'.1) :
    y = y' := by
  classical

  obtain ⟨u, C, rfl⟩ := hMℓ.ptFℓ_surjective S s y
  obtain ⟨u', C', rfl⟩ := hMℓ.ptFℓ_surjective S s y'

  have hF : ptF S s u = ptF S s u' := by
    apply Subtype.ext
    rw [← hπℓ S s u C, ← hπℓ S s u' C', hπ]
  obtain ⟨i, hi, hiso⟩ := hM.ptF_injective S s u u' hF
  have hisoVia : FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi := hiso

  obtain ⟨D, hT⟩ :=
    FakeEllipticCurve.WithFullLevel.exists_extraLevel_isoTVia_of_isoVia u u' i hi hisoVia ℓ C'
  have hy' : ptFℓ S s u D = ptFℓ S s u' C' := hMℓ.ptFℓ_iso S s u u' D C' i hi hT
  have h₀' : Spec.map (CommRingCat.ofHom p) ≫ (ptFℓ S s u C).1 =
      Spec.map (CommRingCat.ofHom p) ≫ (ptFℓ S s u D).1 := by
    rw [hy']; exact h₀

  suffices hCC : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t u.1.f),
      FactorsThrough C.levK P ↔ FactorsThrough D.levK P by
    exact hMℓ.ptFℓ_iso S s u u' C C' i hi ⟨hisoVia, fun t P => (hCC t P).trans (hT.2 t P)⟩

  obtain ⟨u₀, C₀, g, hg, hPg, -, hC₀⟩ :=
    FakeEllipticCurve.WithFullLevel.exists_extraLevel_isPullbackVia_forall_factorsThrough_iff p u C
  obtain ⟨D₀, hD₀⟩ :=
    FakeEllipticCurve.ExtraLevel.exists_forall_factorsThrough_iff_of_isPullbackVia p u.1 u₀.1 g hg ℓ D
  have e₀ : (ptFℓ S₀ (Spec.map (CommRingCat.ofHom p) ≫ s) u₀ C₀).1 =
      Spec.map (CommRingCat.ofHom p) ≫ (ptFℓ S s u C).1 :=
    hMℓ.ptFℓ_pullback S S₀ p s _ rfl u u₀ C C₀ g hg hPg (fun t' P h => (hC₀ t' P).1 h)
  have eD₀ : (ptFℓ S₀ (Spec.map (CommRingCat.ofHom p) ≫ s) u₀ D₀).1 =
      Spec.map (CommRingCat.ofHom p) ≫ (ptFℓ S s u D).1 :=
    hMℓ.ptFℓ_pullback S S₀ p s _ rfl u u₀ D D₀ g hg hPg (fun t' P h => by
      obtain ⟨P₀, hP₀⟩ := (hD₀ t' P).1 h
      exact ⟨P₀, hP₀⟩)
  obtain ⟨j, hj, hjiso, hjK⟩ :=
    hMℓ.ptFℓ_injective S₀ _ u₀ u₀ C₀ D₀ (Subtype.ext (by rw [e₀, eD₀, h₀']))

  have hnS₀ : IsUnit ((n : ℕ) : S₀) := by simpa using hnS.map p
  have hj1 : j = Iso.refl _ :=
    FakeEllipticCurve.WithFullLevel.eq_refl_of_mapPt_eq_of_three_le hrr hB Λ hΛ hn hnS₀ u₀ j hj
      hjiso.1 hjiso.2.1 hjiso.2.2.2
  subst hj1
  have hK₀ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S₀)) (P : SchemeHomOver t u₀.1.f),
      FactorsThrough C₀.levK P ↔ FactorsThrough D₀.levK P := by
    intro T t P
    have hm : mapPt (Iso.refl u₀.1.A).hom hj P = P := Subtype.ext (by simp)
    have h__af := hjK t P
    simp [hm] at h__af
    exact h__af

  have hgpb := hg.1

  have hgeom : ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : S →+* k)
      (Q : SchemeHomOver (geomPoint k sk) u.1.f),
      FactorsThrough C.levK Q ↔ FactorsThrough D.levK Q := by
    intro k _ _ sk Q

    have hker : RingHom.ker p ≤ RingHom.ker sk := by
      intro x hx
      obtain ⟨m, hm⟩ := hI
      have hxm : x ^ m ∈ RingHom.ker p ^ m := Ideal.pow_mem_pow hx m
      rw [hm] at hxm
      have hx0 : x ^ m = 0 := by simpa using hxm
      have hnil : IsNilpotent (sk x) := ⟨m, by rw [← map_pow, hx0, map_zero]⟩
      simpa [RingHom.mem_ker] using hnil.eq_zero
    obtain ⟨sk₀, hsk₀⟩ : ∃ sk₀ : S₀ →+* k, sk₀.comp p = sk :=
      ⟨p.liftOfSurjective hp ⟨sk, hker⟩, p.liftOfRightInverse_comp _ _ ⟨sk, hker⟩⟩
    have hgeq : geomPoint k sk = geomPoint k sk₀ ≫ Spec.map (CommRingCat.ofHom p) := by
      rw [geomPoint, geomPoint, ← hsk₀, CommRingCat.ofHom_comp, Spec.map_comp]

    obtain ⟨Q', hQ'g, hQ'f⟩ : ∃ Q' : Spec (CommRingCat.of k) ⟶ u₀.1.A,
        Q' ≫ g = Q.1 ∧ Q' ≫ u₀.1.f = geomPoint k sk₀ :=
      ⟨hgpb.lift Q.1 (geomPoint k sk₀) (by rw [Q.2, hgeq]), hgpb.lift_fst _ _ _, hgpb.lift_snd _ _ _⟩
    have h1 := hC₀ (geomPoint k sk₀) ⟨Q', hQ'f⟩
    have h2 := hD₀ (geomPoint k sk₀) ⟨Q', hQ'f⟩
    have h3 := hK₀ (geomPoint k sk₀) ⟨Q', hQ'f⟩
    simp only [FactorsThrough, hQ'g] at h1 h2 h3 ⊢
    exact h1.symm.trans (h3.trans h2)

  have hid : CategoryTheory.IsPullback (𝟙 u.1.A) u.1.f u.1.f (Spec.map (CommRingCat.ofHom (RingHom.id S))) := by
    rw [CommRingCat.ofHom_id, Spec.map_id]
    exact IsPullback.of_horiz_isIso ⟨by simp⟩
  have key : ∀ {T : Scheme.{0}} (t t' : T ⟶ Spec (CommRingCat.of S)) (_ : t = t') (P Q : SchemeHomOver t u.1.f)
      (P' Q' : SchemeHomOver t' u.1.f), P.1 = P'.1 → Q.1 = Q'.1 →
      (u.1.L.mul t P Q).1 = (u.1.L.mul t' P' Q').1 := by
