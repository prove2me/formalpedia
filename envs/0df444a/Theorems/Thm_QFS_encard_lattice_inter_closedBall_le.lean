/-! ## Upper bound for balls -/

theorem QFS.encard_lattice_inter_closedBall_le (a : EuclideanSpace ℝ (Fin d)) (M : ℝ) :
    (lattice d ∩ closedBall a M).encard ≤ (((2 * ⌈M⌉₊ + 1) ^ d : ℕ) : ℕ∞) := by sorry
