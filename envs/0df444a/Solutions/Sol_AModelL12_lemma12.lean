section Shapes

lemma length_restShape (G Suf : Shape) (q n : ℕ) :
    (restShape G Suf q n).length = n + G.length + n + Suf.length := by
  simp [restShape]; omega

lemma length_qShape (Pre G Suf : Shape) (q e : ℕ) :
    (qShape Pre G Suf q e).length = Pre.length + e + G.length + e + Suf.length := by
  simp [qShape, length_restShape]; omega

lemma getD_replicate_lt {n q k : ℕ} (hk : k < n) : (List.replicate n q).getD k 0 = q := by
  rw [List.getD_eq_getElem _ _ (by simpa using hk), List.getElem_replicate]

lemma restShape_getD (G Suf : Shape) (q n : ℕ) {k : ℕ} (hk : k < n) :
    (restShape G Suf q n).getD k 0 = q ∧
      (restShape G Suf q n).getD (n + G.length + k) 0 = q := by
  unfold restShape
  constructor
  · rw [List.getD_append _ _ _ _ (by simpa using hk), getD_replicate_lt hk]
  · rw [List.getD_append_right _ _ _ _ (by simp; omega), List.length_replicate,
      List.getD_append_right _ _ _ _ (by omega),
      List.getD_append _ _ _ _ (by simp; omega), getD_replicate_lt (by omega)]

lemma qShape_getD (Pre G Suf : Shape) (q e : ℕ) {k : ℕ} (hk : k < e) :
    (qShape Pre G Suf q e).getD (Pre.length + k) 0 =
      (qShape Pre G Suf q e).getD (Pre.length + e + G.length + k) 0 := by
  unfold qShape
  rw [List.getD_append_right _ _ _ _ (by omega), List.getD_append_right _ _ _ _ (by omega),
    Nat.add_sub_cancel_left, show Pre.length + e + G.length + k - Pre.length = e + G.length + k
      by omega, (restShape_getD G Suf q e hk).1, (restShape_getD G Suf q e hk).2]

lemma rowShape_getD (P R : ℕ) (G Suf : Shape) (q n : ℕ) {k : ℕ} (hk : k < n) :
    (rowShape P R G Suf q n).getD (2 + k) 0 = (rowShape P R G Suf q n).getD (n + G.length + 2 + k) 0 := by
  have h := restShape_getD G Suf q n hk
  simp only [rowShape, show 2 + k = k + 1 + 1 by omega,
    show n + G.length + 2 + k = n + G.length + k + 1 + 1 by omega, List.getD_cons_succ]
  rw [h.1, h.2]

lemma length_rowShape (P R : ℕ) (G Suf : Shape) (q n : ℕ) :
    (rowShape P R G Suf q n).length = n + G.length + n + Suf.length + 2 := by
  simp [rowShape, length_restShape]

/-- The block decomposition of `qShape` used by the joining rotation. -/
lemma qShape_blocks (Pre G Suf : Shape) (q ρ n : ℕ) :
    qShape Pre G Suf q (ρ + n) = (Pre ++ List.replicate ρ q) ++
      ((List.replicate n q ++ G) ++ (List.replicate ρ q ++ (List.replicate n q ++ Suf))) := by
  simp only [qShape, restShape, List.replicate_add, List.append_assoc]

lemma joinShape_blocks (Pre G Suf : Shape) (q ρ n : ℕ) :
    joinShape Pre G Suf q ρ n = (Pre ++ List.replicate ρ q) ++
      (List.replicate ρ q ++ ((List.replicate n q ++ G) ++ (List.replicate n q ++ Suf))) := by
  simp only [joinShape, restShape, List.replicate_add, List.append_assoc]

lemma vol_joinShape (Pre G Suf : Shape) (q ρ n : ℕ) :
    vol (joinShape Pre G Suf q ρ n) = vol (qShape Pre G Suf q (ρ + n)) := by
  rw [joinShape_blocks, qShape_blocks]
  simp only [vol_append]; ring

lemma joinShape_eq_append (Pre G Suf : Shape) (q ρ n : ℕ) :
    joinShape Pre G Suf q ρ n = (Pre ++ List.replicate (ρ + ρ) q) ++ restShape G Suf q n := rfl

lemma rowShape_eq_append (P R : ℕ) (G Suf : Shape) (q n : ℕ) :
    rowShape P R G Suf q n = [P, R] ++ restShape G Suf q n := rfl

lemma vol_rowShape (P R : ℕ) (G Suf : Shape) (q n : ℕ) :
    vol (rowShape P R G Suf q n) = P * R * vol (restShape G Suf q n) := by
  simp [rowShape, mul_assoc]

lemma le_padRows {W K R : ℕ} (hW : 1 ≤ W) : R ≤ padRows W K R := by
  unfold padRows
  have hp : 0 < W ^ K := by positivity
  have := Nat.div_add_mod (R + W ^ K - 1) (W ^ K)
  have := Nat.mod_lt (R + W ^ K - 1) hp
  have : W ^ K * ((R + W ^ K - 1) / W ^ K) + (R + W ^ K - 1) % W ^ K = R + W ^ K - 1 := by
    omega
  omega

lemma padRows_lt {W K R : ℕ} (hW : 1 ≤ W) : padRows W K R < R + W ^ K := by
  unfold padRows
  have hp : 0 < W ^ K := by positivity
  have := Nat.div_mul_le_self (R + W ^ K - 1) (W ^ K)
  rw [mul_comm]; omega

lemma dvd_padRows {W K j R : ℕ} (hj : j ≤ K) : W ^ j ∣ padRows W K R :=
  (pow_dvd_pow W hj).trans (dvd_mul_right _ _)

/-- `S ≤ T` for the row padding. -/
lemma shapeLE_rowShape {P R R' : ℕ} (G Suf : Shape) (q n : ℕ) (h : R ≤ R') :
    ShapeLE (rowShape P R G Suf q n) (rowShape P R' G Suf q n) := by
  refine ⟨by simp [rowShape], fun k h₁ h₂ => ?_⟩
  rcases k with _ | _ | k
  · simp [rowShape]
  · simpa [rowShape] using h
  · simp [rowShape]

end Shapes

section PiecesDef

lemma sum_flatMap_replicate {M : Type*} [Semiring M] (a : ℕ → ℕ) (F : ℕ → M) (N : ℕ) :
    (((List.range N).flatMap fun j => List.replicate (a j) j).map F).sum =
      ∑ j ∈ Finset.range N, (a j : M) * F j := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [List.range_succ, List.flatMap_append, List.map_append, List.sum_append, ih,
      Finset.sum_range_succ]
    simp [List.sum_replicate, nsmul_eq_mul]

lemma sum_pieceLevels (m n : ℕ) : ((pieceLevels m n).map fun j => m ^ j).sum = n := by
  rw [pieceLevels, sum_flatMap_replicate]
  exact digit_decomposition m n

end PiecesDef

