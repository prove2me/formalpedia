theorem NLogN.KFS.swAxG_spec :
    ∃ q₀ : ℕ, ∀ q', q'.Prime → q₀ < q' → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u w : ℕ) (sh : Shape) (p q : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) → p < q → q < sh.length →
      sh.getD p 0 = 2 ^ u → sh.getD q 0 = 2 ^ u →
      ∀ (I : List Sym) (s : IState HS) (gS : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
      gS 0 = gflat zs ++ l → zs.length = vol sh → NLogN.KFB.GB w zs →
      ∃ c : ℕ, IRuns I l12prog (swAxG q' w sh p q u) (encK s gS)
        (encK s (Function.update gS 0 (gflat (AModel.pull sh sh (swapPos p q) 0 zs) ++ l))) c ∧
        (c : ℝ) ≤ K * ((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ τS := by sorry
