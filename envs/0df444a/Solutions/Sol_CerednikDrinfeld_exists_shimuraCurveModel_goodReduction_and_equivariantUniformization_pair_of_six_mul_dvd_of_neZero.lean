open AlgebraicCurve CerednikDrinfeld.Mumford

theorem heckeAdj_of_involutive_isometry
    {E V : Type} [Fintype E] [DecidableEq V] {D : DegeneracyData E V}
    {K L : Type} [Field K] [Field L] [Algebra K L] {ord : Additive Kˣ →+ ℤ} (P : PeriodDatum D K L ord)
    (T : ↥(ribbonKernel D) →ₗ[ℤ] ↥(ribbonKernel D)) (hinv : ∀ z, T (T z) = z)
    (hQT : ∀ x y, P.Q (T x) (T y) = P.Q x y) (y : ↥(ribbonKernel D)) :
    ∃ y' : ↥(ribbonKernel D), ∀ z, P.Q y (T z) = P.Q y' z :=
  ⟨T y, fun z => by rw [← hQT (T y) z, hinv]⟩

theorem heckeAdj_at_AL
    {r : ℕ} [Fact r.Prime] {A : ValuationSubring (AlgebraicClosure ℚ)} {hA : A.LiesOverPrime r}
    {S : Type} [Group S] {scalar : S →* ↥(A.decompositionSubgroup ℚ)}
    {E₁ V₁ : Type} [Fintype E₁] [DecidableEq V₁] {D₁ : DegeneracyData E₁ V₁}
    {T : Type} [AddCommGroup T] {galT : S →* AddAut T}
    {actZ : S →* (↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₁))}
    (𝒰₀ : EquivariantUniformization r D₁ A hA T S scalar actZ galT)
    [Fact (A.DecompositionIsometric ℚ)]
    (σ : S) (hσ : scalar σ = 1) (hσ2 : σ * σ = 1)
    {E₂ V₂ : Type} [Fintype E₂] [DecidableEq V₂] {D₂ : DegeneracyData E₂ V₂}
    (e : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₂))
    (hiso : ∀ x y : ↥(ribbonKernel D₁), ribbonGram D₂ (e x) (e y) = ribbonGram D₁ x y)
    (K : ↥(ribbonKernel D₂) →ₗ[ℤ] ↥(ribbonKernel D₂))
    (hK : ∀ z : ↥(ribbonKernel D₂), K z = conjAct e actZ σ z)
    (y : ↥(ribbonKernel D₂)) :
    ∃ y' : ↥(ribbonKernel D₂), ∀ z, (pdTransport 𝒰₀.P e hiso).Q y (K z) = (pdTransport 𝒰₀.P e hiso).Q y' z := by
  refine ⟨conjAct e actZ σ y, fun z => ?_⟩
  have hinjC : Function.Injective (fun k : Additive (↥𝒰₀.K)ˣ =>
      (((Additive.toMul k : (↥𝒰₀.K)ˣ) : ↥𝒰₀.K) : A.valuation.Completion)) := by
    intro k k' h
    exact Additive.toMul.injective (Units.ext (Subtype.ext h))
  apply hinjC
  have key := 𝒰₀.Q_equiv σ AlgEquiv.refl
    (by intro c; rw [hσ]; exact (one_smul (↥(A.decompositionSubgroup ℚ)) c).symm)
    (actZ σ (e.symm y)) (e.symm z)
  have hσσ : ∀ w : ↥(ribbonKernel D₁), actZ σ (actZ σ w) = w := fun w => by
    rw [← LinearEquiv.mul_apply, ← map_mul, hσ2, map_one]; rfl
  simp only [hσσ] at key
  simp only [pdTransport_Q, hK, conjAct_apply, LinearEquiv.symm_apply_apply]
  exact key.symm

theorem heckePic0_eq_correspondence
    {a b : ℚ} {R : Submodule ℤ ℍ[ℚ, a, b]} {ιR : ℍ[ℚ, a, b] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ℝ}
    {𝒮 : ℕ → Set (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ}
    (M : ShimuraCurveModel R ιR 𝒮) (ℓ : ℕ) (hℓ : ℓ.Prime)
    {F' : Type} [Field F'] [Algebra (AlgebraicClosure ℚ) F'] [HasPrincipalDivisors (AlgebraicClosure ℚ) F']
    (φ ψ : M.Fbar →ₐ[AlgebraicClosure ℚ] F') (hφ : φ.toRingHom.IsIntegral) (hψ : ψ.toRingHom.IsIntegral)
    (hFI : FundamentalIdentityAlong (AlgebraicClosure ℚ) φ hφ)
    (hfin : FiniteAlong (AlgebraicClosure ℚ) ψ) (hN : NormFormulaAlong (AlgebraicClosure ℚ) ψ hfin)
    (hident : ∀ D : Divisor (AlgebraicClosure ℚ) M.Fbar, M.corrBar ℓ hℓ D = Divisor.correspondence φ ψ hφ hψ D)
    (c : M.J) :
    M.heckePic0 ℓ hℓ c = Pic0.correspondence φ ψ hφ hψ hFI hfin hN c := by
  obtain ⟨D, rfl⟩ := Pic0.mk_surjective c
  have hD : M.corrBar ℓ hℓ (D : Divisor (AlgebraicClosure ℚ) M.Fbar) ∈
      Divisor.degZero (K := AlgebraicClosure ℚ) (F := M.Fbar) := by
    rw [hident]; exact Divisor.correspondence_mem_degZero φ ψ hφ hψ hFI D.2
  rw [M.heckePic0_mk ℓ hℓ D hD, Pic0.correspondence_mk]
  congr 1
  exact Subtype.ext (hident _)

end moreAdj
