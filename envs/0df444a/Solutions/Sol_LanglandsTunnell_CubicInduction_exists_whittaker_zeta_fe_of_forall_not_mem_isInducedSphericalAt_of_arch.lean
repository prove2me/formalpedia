private theorem psiLoc_apply_of_forall_apply_eq {ψ ψ₀ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ} {a : ℚ}
    (hψ : ∀ x, ψ x = ψ₀ (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * x)) (v : HeightOneSpectrum (𝓞 ℚ))
    (s : v.adicCompletion ℚ) :
    psiLoc ψ v s = psiLoc ψ₀ v (algebraMap ℚ (v.adicCompletion ℚ) a * s) := by
  simp only [psiLoc, AddChar.compAddMonoidHom_apply]
  rw [hψ, StandardAddChar.adeleSingleAt_apply, StandardAddChar.adeleSingleAt_apply]
  refine congrArg ψ₀ (Prod.ext ?_ ?_)
  · show (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a).1 * 0 = 0
    exact mul_zero _
  · show (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a).2 * StandardAddChar.finAdeleSingleAt ℚ v s =
      StandardAddChar.finAdeleSingleAt ℚ v (algebraMap ℚ (v.adicCompletion ℚ) a * s)
    refine FiniteAdeleRing.ext ℚ fun w => ?_
    show (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a).2 w * StandardAddChar.finAdeleSingleAt ℚ v s w =
      StandardAddChar.finAdeleSingleAt ℚ v (algebraMap ℚ (v.adicCompletion ℚ) a * s) w
    by_cases hw : w = v
    · subst hw
      rw [StandardAddChar.finAdeleSingleAt_apply_self, StandardAddChar.finAdeleSingleAt_apply_self]
      exact congrArg (· * s) (FiniteAdeleRing.algebraMap_apply (𝓞 ℚ) ℚ a w)
    · rw [StandardAddChar.finAdeleSingleAt_apply_of_ne ℚ v s hw,
        StandardAddChar.finAdeleSingleAt_apply_of_ne ℚ v _ hw, mul_zero]

private theorem inv_apply_of_forall_apply_eq {ψ ψ₀ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ} {a : ℚ}
    (hψ : ∀ x, ψ x = ψ₀ (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * x)) (x : AdeleRing (𝓞 ℚ) ℚ) :
    ψ⁻¹ x = ψ₀⁻¹ (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * x) := by
  rw [AddChar.inv_apply, AddChar.inv_apply, hψ, mul_neg]

private theorem isPrincipalInvariantAddChar_inv {ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ}
    (hψ : IsPrincipalInvariantAddChar ℚ ψ) : IsPrincipalInvariantAddChar ℚ ψ⁻¹ := fun q => by
  rw [AddChar.inv_apply, ← map_neg]
  exact hψ (-q)

