noncomputable def completedLocalCast {A : Type} [CommRing A] {P' P : Ideal A} [P'.IsPrime]
    [P.IsPrime] (h : P' = P) :
    CompletedLocalAt A P' ≃+* CompletedLocalAt A P := by
  subst h; exact RingEquiv.refl _

/-- At the prime `P` of `A`, every element `g` of the completed local ring such that `(g, z)` has
finite colength `n` is transverse to `z` (multiplication by `z` is injective modulo `g`), and the
ideal `(g, z)` contains a power of the maximal ideal. -/
def TransverseFiniteAt (A : Type) [CommRing A] (P : Ideal A) [P.IsPrime] (z : A) : Prop :=
  ∀ (g : CompletedLocalAt A P) (n : ℕ),
    Module.length (CompletedLocalAt A P) (CompletedLocalAt A P ⧸
      (Ideal.span {g} ⊔ Ideal.span {completedPointMap A P z})) = n →
    Function.Injective (fun w : CompletedLocalAt A P ⧸ Ideal.span {g} =>
      Ideal.Quotient.mk (Ideal.span {g}) (completedPointMap A P z) * w) ∧
    ∃ L : ℕ, ((IsLocalRing.maximalIdeal (Localization.AtPrime P)).map
      (localCompletionMap (Localization.AtPrime P)))^L ≤ finiteLocalCurveIdeal A P z g 1

/-- The nonzero affine directions in the support of the divisor `Dv`. -/
abbrev CommonDirections {k : Type} [Field k] (Dv : ExceptionalDivisor k) : Type :=
  {φ : AffineDirection k // φ ≠ zeroAffine k ∧ 0 < Dv (some φ)}

/-- The overlap point of a nonzero direction (a named function, so that the instance arguments
in the curve datum built below stay syntactically uniform). -/
noncomputable def commonPoint (R : Type) [CommRing R] [IsLocalRing R] (t x : R)
    (e : (BlowupChart R t x ⧸ chartExceptional R t x) ≃+* Polynomial (IsLocalRing.ResidueField R))
    {Dv : ExceptionalDivisor (IsLocalRing.ResidueField R)} (i : CommonDirections Dv) :
    Ideal (BlowupOverlap R t x) :=
  (directionPoint R t x e i.1).map (algebraMap (BlowupChart R t x) (BlowupOverlap R t x))

