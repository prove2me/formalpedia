  show Ideal.Quotient.lift (RingHom.ker f) g (fun a ha => h ha) ((RingHom.quotientKerEquivOfSurjective hf).symm (f a)) = g a
  rw [RingHom.quotientKerEquivOfSurjective_symm_apply, Ideal.Quotient.lift_mk]

theorem Adm.apply_eq_zero_of_isNilpotent {A : Type} [CommRing A] {ψA : O →+* A} (ρ : Adm A ψA) {x : A}
    (hx : IsNilpotent x) : ρ.1 x = 0 :=
  (hx.map ρ.1).eq_zero

noncomputable def Adm.descend {A B : Type} [CommRing A] [CommRing B] {ψA : O →+* A} {ψB : O →+* B} (f : A →+* B)
    (hf : Function.Surjective f) (hfn : ∀ a ∈ RingHom.ker f, IsNilpotent a) (hψ : f.comp ψA = ψB) (ρ : Adm A ψA) :
    Adm B ψB :=
  ⟨descendHom f hf ρ.1 (fun a ha => (RingHom.mem_ker).mpr (Adm.apply_eq_zero_of_isNilpotent ρ (hfn a ha))), by
    rw [← hψ, ← RingHom.comp_assoc, descendHom_comp, ρ.2]⟩

theorem Adm.comap_descend {A B : Type} [CommRing A] [CommRing B] {ψA : O →+* A} {ψB : O →+* B} (f : A →+* B)
    (hf : Function.Surjective f) (hfn : ∀ a ∈ RingHom.ker f, IsNilpotent a) (hψ : f.comp ψA = ψB) (ρ : Adm A ψA) :
    Adm.comap f hψ (Adm.descend f hf hfn hψ ρ) = ρ :=
  Subtype.ext (descendHom_comp f hf ρ.1 _)

theorem isNilpotent_of_mem_of_isNilpotent_ideal {A : Type} [CommRing A] {I : Ideal A} (hI : IsNilpotent I) {a : A}
    (ha : a ∈ I) : IsNilpotent a := by
  obtain ⟨n, hn⟩ := hI
  refine ⟨n, ?_⟩
  have h := Ideal.pow_mem_pow ha n
  rw [hn] at h
  exact h

section PB
variable {B B' B'' : Type} [CommRing B] [CommRing B'] [CommRing B''] (φ' : B' →+* B) (φ'' : B'' →+* B)

theorem pullbackFst_surjective (hφ''s : Function.Surjective φ'') : Function.Surjective (pullbackFst φ' φ'') := by
  intro b'
  obtain ⟨b'', h⟩ := hφ''s (φ' b')
  exact ⟨⟨(b', b''), show φ' b' = φ'' b'' from h.symm⟩, rfl⟩

theorem pullbackSnd_surjective (hφ's : Function.Surjective φ') : Function.Surjective (pullbackSnd φ' φ'') := by
  intro b''
  obtain ⟨b', h⟩ := hφ's (φ'' b'')
  exact ⟨⟨(b', b''), show φ' b' = φ'' b'' from h⟩, rfl⟩

theorem isNilpotent_of_mem_ker_pullbackFst (hφ''n : IsNilpotent (RingHom.ker φ''))
    (z : pullbackRing φ' φ'') (hz : z ∈ RingHom.ker (pullbackFst φ' φ'')) : IsNilpotent z := by
  have hz1 : z.1.1 = 0 := hz
  have hz2 : z.1.2 ∈ RingHom.ker φ'' := by
    rw [RingHom.mem_ker, ← show φ' z.1.1 = φ'' z.1.2 from z.2, hz1, map_zero]
  obtain ⟨n, hn⟩ := isNilpotent_of_mem_of_isNilpotent_ideal hφ''n hz2
  refine ⟨n + 1, Subtype.ext ?_⟩
  rw [SubmonoidClass.coe_pow]
  show z.1 ^ (n + 1) = 0
  ext
  · rw [Prod.pow_fst, hz1, zero_pow (Nat.succ_ne_zero n), Prod.fst_zero]
  · rw [Prod.pow_snd, pow_succ, hn, zero_mul, Prod.snd_zero]

theorem isNilpotent_of_mem_ker_pullbackSnd (hφ'n : IsNilpotent (RingHom.ker φ'))
    (z : pullbackRing φ' φ'') (hz : z ∈ RingHom.ker (pullbackSnd φ' φ'')) : IsNilpotent z := by
  have hz2 : z.1.2 = 0 := hz
  have hz1 : z.1.1 ∈ RingHom.ker φ' := by
    rw [RingHom.mem_ker, show φ' z.1.1 = φ'' z.1.2 from z.2, hz2, map_zero]
  obtain ⟨n, hn⟩ := isNilpotent_of_mem_of_isNilpotent_ideal hφ'n hz1
  refine ⟨n + 1, Subtype.ext ?_⟩
  rw [SubmonoidClass.coe_pow]
  show z.1 ^ (n + 1) = 0
  ext
  · rw [Prod.pow_fst, pow_succ, hn, zero_mul, Prod.fst_zero]
  · rw [Prod.pow_snd, hz2, zero_pow (Nat.succ_ne_zero n), Prod.snd_zero]

end PB
