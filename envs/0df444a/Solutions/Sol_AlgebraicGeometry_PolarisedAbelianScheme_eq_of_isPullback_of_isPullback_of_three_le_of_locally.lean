    (h₂P : ∀ i, (u'.P i).1 ≫ g₂ = Spec.map (CommRingCat.ofHom φ) ≫ (u.P i).1)
    (h₂pol : (∀ s : ↥(Spec (CommRingCat.of S')), ∃ U : (Spec (CommRingCat.of S')).Opens, s ∈ U ∧
