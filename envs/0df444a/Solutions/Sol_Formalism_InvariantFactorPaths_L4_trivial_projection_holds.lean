  obtain ⟨hPP, hran, hker⟩ := hP
  by_cases hT : la ∈ T
  · left
    intro F hF
    have hFr : F ∈ LinearMap.range P := by
      rw [hran]
      exact Submodule.mem_iSup_of_mem la (Submodule.mem_iSup_of_mem hT (hla hF))
    obtain ⟨y, rfl⟩ := hFr
    have h1 := congrArg (fun f => f y) hPP
    simpa using h1
  · right
    intro F hF
    have hFk : F ∈ LinearMap.ker P := by
      rw [hker]
      exact Submodule.mem_iSup_of_mem la (Submodule.mem_iSup_of_mem hT (hla hF))
    exact hFk
