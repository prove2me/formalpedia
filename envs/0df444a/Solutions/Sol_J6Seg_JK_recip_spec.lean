theorem abs_lt_of_natAbs {z : ℤ} {k : ℕ} (h : z.natAbs < 2 ^ k) : |z| < 2 ^ k := by
  rw [Int.abs_eq_natAbs]; exact_mod_cast h

theorem ivOf_nonneg (k : ℕ) {pv : ℤ} (hpv : 0 < pv) : 0 ≤ ivOf k pv :=
  Int.ediv_nonneg (by positivity) (by omega)

theorem ivOf_le (k : ℕ) {pv : ℤ} (hpv : 0 < pv) : ivOf k pv ≤ 2 ^ k := by
  unfold ivOf
  exact Int.ediv_le_self _ (by positivity)

theorem q0_natAbs_le (k : ℕ) {N iv : ℤ} (h0 : 0 ≤ iv) (hiv : iv ≤ 2 ^ k) :
    (N * iv / 2 ^ k).natAbs ≤ N.natAbs := by
  have hK : (0 : ℤ) < 2 ^ k := by positivity
  have j1 : N * iv / 2 ^ k * 2 ^ k ≤ N * iv := Int.ediv_mul_le _ hK.ne'
  have j2 : N * iv < (N * iv / 2 ^ k + 1) * 2 ^ k := Int.lt_ediv_add_one_mul_self _ hK
  have hN : |N| = (N.natAbs : ℤ) := Int.abs_eq_natAbs N
  have a1 : N * iv ≤ |N| * 2 ^ k := by
    calc N * iv ≤ |N| * iv := mul_le_mul_of_nonneg_right (le_abs_self N) h0
      _ ≤ |N| * 2 ^ k := mul_le_mul_of_nonneg_left hiv (abs_nonneg N)
  have a2 : -(|N| * 2 ^ k) ≤ N * iv := by
    have : -|N| ≤ N := neg_abs_le N
    calc -(|N| * 2 ^ k) ≤ -(|N| * iv) := by
          have := mul_le_mul_of_nonneg_left hiv (abs_nonneg N); linarith
      _ = (-|N|) * iv := by ring
      _ ≤ N * iv := mul_le_mul_of_nonneg_right this h0
  have u1 : N * iv / 2 ^ k ≤ |N| := by
    by_contra hc
    have : (|N| + 1) * 2 ^ k ≤ N * iv / 2 ^ k * 2 ^ k :=
      mul_le_mul_of_nonneg_right (by linarith) hK.le
    nlinarith
  have u2 : -|N| ≤ N * iv / 2 ^ k := by
    by_contra hc
    have : (N * iv / 2 ^ k + 1) * 2 ^ k ≤ (-|N|) * 2 ^ k :=
      mul_le_mul_of_nonneg_right (by linarith) hK.le
    nlinarith
  have : |N * iv / 2 ^ k| ≤ |N| := abs_le.2 ⟨u2, u1⟩
  rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs] at this
  exact_mod_cast this

