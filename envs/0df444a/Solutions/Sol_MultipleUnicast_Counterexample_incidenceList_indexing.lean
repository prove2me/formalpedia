theorem incidenceList_nodup : incidenceList.Nodup := by
  unfold incidenceList
  rw [List.nodup_flatMap]
  refine ⟨?_, ?_⟩
  · intro i _
    exact ((List.nodup_finRange 91).filter _).map (fun a b h => by simpa using h)
  · refine (List.nodup_finRange 91).imp ?_
    intro i j hij
    show List.Disjoint _ _
    rw [List.disjoint_left]
    intro x hx hx'
    simp only [List.mem_map] at hx hx'
    obtain ⟨a, _, rfl⟩ := hx
    obtain ⟨b, _, hb⟩ := hx'
    exact hij (by simpa using (congrArg Prod.fst hb).symm)

theorem edgePair_injective : Function.Injective edgePair := by
  have hlen : incidenceList.length = 910 := incLen
  intro a b h
  have hn := incidenceList_nodup
  unfold edgePair at h
  have ha : a.val < incidenceList.length := by omega
  have hb : b.val < incidenceList.length := by omega
  rw [List.getD_eq_getElem _ _ ha, List.getD_eq_getElem _ _ hb] at h
  exact Fin.ext ((hn.getElem_inj_iff).1 h)


