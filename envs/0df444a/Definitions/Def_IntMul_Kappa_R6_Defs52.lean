-- Source module: Solutions.R6BitNBNetC
/-!
# Round six, bit network: the scalar circuit and formal correctness (`FormalOK`)

The module-valued scalar circuit (formal values over `ZMod 2`) of the whole program: stage one
adds `X(T, b)` into `Y(T, b)`, stage two adds `Y(a, S)` into `X(a, S)`, the correction adds
`X` into `τ` and `τ` into `Y`. With the labels of `R6BitNBNetB` and `formal_labels`, every role
`ρ w` ends with `(swapMat, w)`.
-/

set_option linter.unusedSectionVars false
set_option maxRecDepth 10000
set_option linter.constructorNameAsVariable false

namespace IntMul.Kappa.R6.Bit.NB

open Matrix R6Chk R6Chk.Bit R6Chk.Bit.Loc AModel AModelFac

section Scalar

variable {N : ℕ}

abbrev FVN (N : ℕ) := FV (ZMod 2) (Fin 148225616) 529 N

/-- Initial scalar values. -/
noncomputable def φ0 (ch : Ch) (N : ℕ) : Wr → FVN N
  | .inl g => if g.val < 3136441 then Finsupp.single (L0 ch N (.inl g), g) 1 else Finsupp.single (1, g) 1
  | .inr _ => 0

variable (ch : Ch)

noncomputable def u1 (ch : Ch) (N b w : ℕ) : FVN N := φ0 ch N (ι1 b w)

/-- Stage-two initial local values. -/
noncomputable def u2 (ch : Ch) (N a w : ℕ) : FVN N :=
  if w < 1771 then φ0 ch N (ι1 w (wY a)) + φ0 ch N (ι1 w (wX a)) else φ0 ch N (ι2 a w)

/-- The correction block on scalars. -/
noncomputable def cfS (ch : Ch) (N a s j : ℕ) : FVN N :=
  if j = 0 then 0 else if j = 1 then xrL G2 (u2 ch N a) (wY s) else xrL G2 (u2 ch N a) (wX s)
noncomputable def cgS (ch : Ch) (N a s j : ℕ) : FVN N :=
  if j = 0 then xrL G2 (u2 ch N a) (wY s) else if j = 1 then xrL G2 (u2 ch N a) (wY s)
  else xrL G2 (u2 ch N a) (wX s) + xrL G2 (u2 ch N a) (wY s)

noncomputable def fin2S (ch : Ch) (N a w : ℕ) : FVN N :=
  if w < 1771 then xrL G2 (u2 ch N a) w + xrL G2 (u2 ch N a) (wY w)
  else if w < 43642 then xrL G2 (u2 ch N a) w else xrL G2 (u2 ch N a) (wY (w - 43642))

end Scalar

/-! ## Formal correctness -/

end IntMul.Kappa.R6.Bit.NB

end

