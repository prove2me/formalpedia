-- title:
--   A Pauli string for each body phase
-- statement:
--   For n≥1 let V be an invariant n-qubit unitary, and let φ_l∈(-π,π] be the principal real representative of Φ_l(V). Let G_0 be generated by exp(2πiD_l), and let G_2 be generated by exchange (XX+YY)/2 and single-site Z evolutions. There exist V_0∈G_0 and V_2∈G_2 such that
--
--   $$V=V_0\left[\prod_{l=0}^{n}\exp\left(i\frac{\varphi_l}{2^n}Z^{\otimes l}\otimes I^{\otimes(n-l)}\right)\right]V_2.$$
--
--   The l=0 string is the identity. This is the displayed D17, including its factor i.
-- source:
--   Restrictions on realizable unitary operations imposed by symmetry and locality, arXiv:2003.05524v3, PDF p. 33, D.2 Eq.(D17): one Pauli string for each phase

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P14

noncomputable section

namespace QAlgorithms.Papers.Independent.Extend50.P14

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius

open MeasureTheory

-- Exact accepted aliases and physical operators, without local redeclarations.

open QAlgorithms.Papers.Independent.Information100.P60 (Mat)

open QAlgorithms.Papers.Independent.Advance50.P49 (onWire multiSwap)

attribute [local instance 100] LieRing.ofAssociativeRing

/-- PDF p.33, D17: retain i, use principal representatives, and include I at l=0. -/
theorem phase_string_decomposition (n : ℕ) (hn : 1 ≤ n) (V : QMat n) (hV : U1Unitary V) :
    ∃ V0 V2 : QMat n, V0 ∈ u1FinitePhaseGroup n ∧ V2 ∈ xyZGroup n ∧
      V = V0 * stringPhaseFactor V * V2 := by sorry

end QAlgorithms.Papers.Independent.Extend50.P14

end
