theorem weighted_norm_sq_eq_sub_pairwise_dist_sq
    {ι V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    (s : Finset ι) (w : ι → ℝ) (v : ι → V)
    (hw : ∑ i ∈ s, w i = 1) :
    ‖∑ i ∈ s, w i • v i‖ ^ 2 =
      (∑ i ∈ s, w i * ‖v i‖ ^ 2) -
        (1 / 2 : ℝ) *
          ∑ i ∈ s, ∑ j ∈ s, w i * w j * ‖v i - v j‖ ^ 2 := by
