-- title:
--   Galois-fixed adapted basis for the pole filtration at ∞̄
-- statement:
--   Fix $N\ge 1$ and $m\in\mathbb{N}$. Write $\bar F_N$ for `modularFunctionFieldBar N`, the intermediate field of $\mathrm{LaurentSeries}(\overline{\mathbb{Q}})$ over $\overline{\mathbb{Q}}$ generated by the coefficientwise images of `modularFunctionFieldFull N`, the latter being the subfield of $\mathrm{LaurentSeries}(\mathbb{Q})$ generated over $\mathbb{Q}$ by the series $\mathrm{qExpand}\,\mathbb{Q}\,d\,j_q$ for the divisors $d$ of $N$. The assertion is that there are an $n\in\mathbb{N}$, a family $f : \mathrm{Fin}(n+1) \to \bar F_N$ and orders $o : \mathrm{Fin}(n+1)\to\mathbb{N}$ with: $f_0 = 1$; every $f_i \neq 0$; each $f_i$ is fixed by `arithmeticGalois (modularFunctionFieldFull N) σ` for every $\sigma \in \mathrm{Aut}(\overline{\mathbb{Q}}/\mathbb{Q})$, i.e. invariant under the coefficientwise semilinear automorphism of $\bar F_N$ induced by $\sigma$; and, for every $k \le m$, the subfamily indexed by $\{i : o_i \le k\}$ is linearly independent over $\overline{\mathbb{Q}}$ and its $\overline{\mathbb{Q}}$-span is exactly `riemannRochSpace` of the divisor $k\cdot\bar\infty$, that is the space of $g \in \bar F_N$ with $v(g) \le \exp(k\cdot\bar\infty)(v)$ for every place $v$ of $\bar F_N$ over $\overline{\mathbb{Q}}$, where $\bar\infty$ is the place `cuspInftyBar N`. One single family thus simultaneously yields bases of all the spaces $L(k\cdot\bar\infty)$, $k \le m$, filtered by the orders $o_i$.
--
--   This is the statement that the increasing family of Riemann–Roch spaces $L(k\cdot\bar\infty)$ at the cusp at infinity of $X_0(N)$, over $\overline{\mathbb{Q}}$, admits a basis adapted to the pole-order filtration and consisting of functions invariant under the arithmetic Galois action, so in effect defined over $\mathbb{Q}$, and normalised so that the first member is the constant $1$. It is used in the construction of the embedding underlying [`ModularCurve.JZero.chowReciprocity_embedding`](thm.html#ModularCurve.JZero.chowReciprocity_embedding).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_exists_adapted_family_modularFunctionFieldBar.lean

import Definitions.Def_ModularCurve_ArithmeticGalois
import Definitions.Def_ModularCurve_AtkinLehner
import Definitions.Def_AlgebraicCurve_Repartitions

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open ModularCurve AlgebraicCurve

theorem ModularCurve.exists_adapted_family_modularFunctionFieldBar (N : ℕ) [NeZero N] (m : ℕ) :
    ∃ (n : ℕ) (f : Fin (n + 1) → modularFunctionFieldBar N) (o : Fin (n + 1) → ℕ),
      f 0 = 1 ∧ (∀ i, f i ≠ 0) ∧
      (∀ (i : Fin (n + 1)) (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ),
        arithmeticGalois (modularFunctionFieldFull N) σ • f i = f i) ∧
      (∀ k ≤ m, LinearIndependent (AlgebraicClosure ℚ)
            (fun i : {i : Fin (n + 1) // o i ≤ k} => f i) ∧
          Submodule.span (AlgebraicClosure ℚ)
              (Set.range (fun i : {i : Fin (n + 1) // o i ≤ k} => f i))
            = riemannRochSpace ((k : ℤ) • Finsupp.single (cuspInftyBar N) (1 : ℤ))) := by sorry
