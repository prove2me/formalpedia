open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section cx
variable {s t α : ℕ}

lemma Eexact_summable (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) (w : ℕ → ℂ) (Wm : ℝ)
    (hw : ∀ k < s, ‖w k‖ ≤ Wm) (i : ℕ) :
    Summable (fun h : ℤ => ((eEx s t α i h : ℝ) : ℂ) * w ((((i : ℤ) + h) % s).toNat)) := by
  have hsum := eEx_sum (s := s) (t := t) (α := α) hs hst hx1 (i : ℤ)
  refine (hsum.1.mul_right Wm).of_norm_bounded fun h => ?_
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (eEx_nonneg s t α _ _)]
  exact mul_le_mul_of_nonneg_left (hw _ (toNat_emod_lt hs _)) (eEx_nonneg s t α _ _)

lemma NxR_re (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) (w : ℕ → ℂ) (Wm : ℝ)
    (hw : ∀ k < s, ‖w k‖ ≤ Wm) (i : ℕ) :
    NxR s t α (fun k => (w k).re) i = (w i + Eexact s t α w i).re := by
  unfold NxR Eexact
  rw [Complex.add_re, Complex.re_tsum (Eexact_summable hs hst hx1 w Wm hw i)]
  congr 1
  refine tsum_congr fun h => ?_
  simp [Complex.mul_re]

lemma NxR_im (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) (w : ℕ → ℂ) (Wm : ℝ)
    (hw : ∀ k < s, ‖w k‖ ≤ Wm) (i : ℕ) :
    NxR s t α (fun k => (w k).im) i = (w i + Eexact s t α w i).im := by
  unfold NxR Eexact
  rw [Complex.add_im, Complex.im_tsum (Eexact_summable hs hst hx1 w Wm hw i)]
  congr 1
  refine tsum_congr fun h => ?_
  simp [Complex.mul_im]

/-- **Main theorem (segmented inverse, complex form).** -/
theorem segInvC_err_sol_aux {P lam : ℕ} {B : Blocks} {T : Tables} {E Dm Bu εin Wm : ℝ}
    (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hx : 3 ≤ xθ s t α)
    (hB : BlocksOK s t B) (hlam : ∀ i < s, B.len i ≤ lam)
    (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E)
    (U : ℕ → ℤ × ℤ) (hBu : 0 ≤ Bu)
    (hU : ∀ i < s, |((U i).1 : ℝ) / 2 ^ P| ≤ Bu ∧ |((U i).2 : ℝ) / 2 ^ P| ≤ Bu)
    (v w : ℕ → ℂ) (hw : ∀ i < s, ‖w i‖ ≤ Wm)
    (hsys : ∀ i < s, w i + Eexact s t α w i = v i)
    (hin : ∀ i < s, |((U i).1 : ℝ) / 2 ^ P - (v i).re| ≤ εin ∧
      |((U i).2 : ℝ) / 2 ^ P - (v i).im| ≤ εin)
    (hP : 1000 * segG B lam E Dm Bu ≤ 2 ^ P) :
    ∀ i < s,
      |((segInvC P T B U i).1 : ℝ) / 2 ^ P - (w i).re| ≤ 60 * segG B lam E Dm Bu / 2 ^ P +
          3 * (4 * exp (-(π * (α : ℝ) ^ 2 * (B.w * (B.w + 1))))) * (Bu + 1) + 8 / 7 * εin ∧
      |((segInvC P T B U i).2 : ℝ) / 2 ^ P - (w i).im| ≤ 60 * segG B lam E Dm Bu / 2 ^ P +
          3 * (4 * exp (-(π * (α : ℝ) ^ 2 * (B.w * (B.w + 1))))) * (Bu + 1) + 8 / 7 * εin ∧
      ‖toC (segInvC P T B U i) / 2 ^ P - w i‖ ≤ 2 * (60 * segG B lam E Dm Bu / 2 ^ P +
          3 * (4 * exp (-(π * (α : ℝ) ^ 2 * (B.w * (B.w + 1))))) * (Bu + 1) + 8 / 7 * εin) := by
  have hx1 : 1 ≤ xθ s t α := by linarith
  have hre := segInv_err hs hst hα hx hB hlam hT hE (fun j => (U j).1) hBu
    (fun i hi => (hU i hi).1) (fun k => (v k).re) (fun k => (w k).re) (Wm := Wm)
