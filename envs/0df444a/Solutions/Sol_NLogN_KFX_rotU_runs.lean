-- Source module: Solutions.KFX2Rot
/-!
# KFX §2: register-driven table rotations (the lines (22) and the last bit)

* `pushSt_G_mem`, `pushOK_of`: pushed parameter lists built from `KFL.ESp` facts.
* `tabRot_runs`: a generic `withPushI pl (fcode U ; rotF)` where `U` pushes the rotation table.
* `tabGenU sgn b`: `KFL.tabGen` with the literals `P, Q, d0, d1, 2^ρ, f-1, 2^K` read from the
  registers `1, 2, 3, 5, 6, 7, 8` (`tabGenU_sub`: the literal instance is `RS.sub`).
* **`rotU_geo`**: one line `rixT g (rot2 Q (amt K ρ f l))` with parameters from expressions.
* `xorGenU`, **`xorU_geo`**: the last-bit step `rixT g (XLc K ρ f)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL KFW AModel Butterfly

/-! ## Pushed parameter lists -/

theorem pushSt_G_mem (t : IState HS) (l : List (Fin HS × ℤ)) (hnd : (l.map Prod.fst).Nodup)
    {i : Fin HS} {v : ℤ} (hm : (i, v) ∈ l) : (pushSt t l).G i = .int v :: t.G i := by
  rw [pushSt_G]
  have hf : l.filter (fun p => p.1 = i) = [(i, v)] := by
    induction l with
    | nil => simp at hm
    | cons p l ih =>
      obtain ⟨j, u⟩ := p
      simp only [List.map_cons, List.nodup_cons, List.mem_map] at hnd
      rcases List.mem_cons.1 hm with h | h
      · cases h
        rw [List.filter_cons_of_pos (by simp), List.filter_eq_nil_iff.2]
        intro q hq hq'
        exact hnd.1 ⟨q, hq, by simpa using hq'⟩
      · have hj : j ≠ i := fun e => hnd.1 ⟨(i, v), h, by simp [e]⟩
        rw [List.filter_cons_of_neg (by simpa using hj)]
        exact ih hnd.2 h
  rw [hf]; simp [ints]

/-- A push list whose expressions read none of the pushed stacks and are specified by `ESp`. -/
theorem pushOK_of {t : IState HS} {Bb : ℕ} {l : List (Fin HS × Ex HS)}
    (hlow : ∀ p ∈ l, p.1.val < 56) (hreg : ∀ p ∈ l, ∀ r ∈ p.2.regs, r ∉ l.map Prod.fst)
    (hE : ∀ p ∈ l, ∃ v, ESp p.2 t Bb v) : PushOK t Bb l := by
  intro p hp
  obtain ⟨v, hv⟩ := hE p hp
  exact ⟨hlow p hp, hv.clean, hreg p hp, hv.ok, hv.bnd⟩

theorem pushVals_le {t : IState HS} {Bb : ℕ} {l : List (Fin HS × Ex HS)}
    (hE : ∀ p ∈ l, ∃ v, ESp p.2 t Bb v) : ∀ q ∈ l, zsz (q.2.eval t) ≤ Bb := by
  intro q hq
  obtain ⟨v, hv⟩ := hE q hq
  exact Ex.zsz_eval_le t Bb _ hv.bnd

/-! ## A table generator followed by `rotF` -/

theorem tabRot_runs {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {pl : List (Fin HS × Ex HS)} {U : RS} (hfU : fok U = true) (t : IState HS) (Bb : ℕ)
    (hl : PushOK t Bb pl) (hv : ∀ q ∈ pl, zsz (q.2.eval t) ≤ Bb)
    (h0 : (0 : Fin HS) ∉ pl.map Prod.fst) (h14 : (14 : Fin HS) ∉ pl.map Prod.fst)
    (hnd : (pl.map Prod.fst).Nodup) {P Q B w : ℕ}
    (m1 : ((1 : Fin HS), (P : ℤ)) ∈ evalP t pl) (m2 : ((2 : Fin HS), (Q : ℤ)) ∈ evalP t pl)
    (m4 : ((4 : Fin HS), (B : ℤ)) ∈ evalP t pl) (as : ℕ → ℕ) (has : ∀ p, as p ≤ Q) {cU : ℕ}
    (HU : FSp U (pushSt t (evalP t pl)) ((pushSt t (evalP t pl)).upd 14
      (ints ((List.range P).map fun p => (as p : ℤ)) ++ (pushSt t (evalP t pl)).G 14)) cU)
    (xs : List ℤ) (R : List Item) (hlen : xs.length = P * Q * B) (hbw : Bnd w xs)
    (hx0 : t.G 0 = ints xs ++ R) :
    IRuns I iprog (withPushI pl (.seq (fcode U) KFC.rotF)) t
      (t.upd 0 (ints (pull [P, Q, B] [P, Q, B] (KIL.rotAddr Q as) 0 xs) ++ R))
      (pushCost Bb pl + (cU + KFC.cRotF P Q B w) + (pl.length * (2 * Bb + 2) + 1)) := by
  set u := pushSt t (evalP t pl)
  have hnd' : ((evalP t pl).map Prod.fst).Nodup := by rw [evalP_fst]; exact hnd
  have u1 := pushSt_G_mem t _ hnd' m1
  have u2 := pushSt_G_mem t _ hnd' m2
  have u4 := pushSt_G_mem t _ hnd' m4
  have u0 : u.G 0 = ints xs ++ R := by
    rw [pushSt_G_of_not_mem _ _ _ (by rw [evalP_fst]; exact h0), hx0]
  set tbl := (List.range P).map (fun p => (as p : ℤ))
  have T1 := HU.irun (I := I) (iprog := iprog) hfU
  set t1 := u.upd 14 (ints tbl ++ u.G 14)
  have t1G : ∀ {r : Fin HS}, r ≠ 14 → t1.G r = u.G r := fun h => by
    simp only [t1, IState.upd_G]; simp [h]
  set ys := pull [P, Q, B] [P, Q, B] (KIL.rotAddr Q as) 0 xs
  have RT := KFC.rotF_spec (I := I) (iprog := iprog) t1 xs as P Q B w R (t.G 1) (t.G 2) (t.G 4)
    (u.G 14) has hlen hbw (by rw [t1G (by decide)]; exact u0) (by rw [t1G (by decide)]; exact u1)
    (by rw [t1G (by decide)]; exact u2) (by rw [t1G (by decide)]; exact u4)
    (by simp only [t1, IState.upd_G, Function.update_self]; rfl)
  have eout : (t1.upd 0 (ints ys ++ R)).upd 14 (u.G 14) = u.upd 0 (ints ys ++ R) := by
    refine IState.ext' (fun j => ?_) rfl rfl
    simp only [t1, IState.upd_G, Function.update_apply]
    split_ifs with h1 h2 <;> simp_all
  rw [eout] at RT
  exact KFD.IRuns.withPushI (I := I) (iprog := iprog) pl _ t Bb hl hv h0 ys R _ (T1.seq RT)

/-- The cost of a push list of bounded total size. -/
theorem pushCost_le_size (Bb : ℕ) (l : List (Fin HS × Ex HS)) (S : ℕ)
    (hS : (l.map fun p => p.2.size + 1).sum ≤ S) : pushCost Bb l ≤ S * 10 ^ 7 * (Bb + 2) ^ 2 + 1 := by
  unfold pushCost
  have : (l.map fun p => (p.2.size + 1) * 10 ^ 7 * (Bb + 2) ^ 2).sum =
      (l.map fun p => p.2.size + 1).sum * (10 ^ 7 * (Bb + 2) ^ 2) := by
    rw [← List.sum_map_mul_right]; congr 1; apply List.map_congr_left; intro p _; ring
  rw [this]
  have := Nat.mul_le_mul_right (10 ^ 7 * (Bb + 2) ^ 2) hS
  nlinarith

/-! ## The uniform table generator of a line -/

theorem offE_sub (P Q d0 d1 r2 fm k2 b : ℤ) : Ex.sub (σT P Q d0 d1 r2 fm k2) (offE b) = offE b := by
  unfold offE; split_ifs <;> rfl

theorem tabGenU_sub (K ρ f d0 d1 P : ℕ) (sgn b : ℤ) :
    RS.sub (σT P (2 ^ (f * K) : ℕ) d0 d1 (2 ^ ρ) (f - 1 : ℕ) (2 ^ K)) (tabGenU sgn b) =
      tabGen K ρ f d0 d1 (2 ^ (f * K)) P sgn b := by
  simp only [tabGenU, tabBodyU, segLoopU, segBodyU, uEU, amtEU, RS.sub, Ex.sub, offE_sub]
  rfl

theorem fok_tabGenU (sgn b : ℤ) : fok (tabGenU sgn b) = true := by
  unfold tabGenU tabBodyU segLoopU segBodyU offE
  split_ifs <;> simp +decide [fok, touch, Ex.regs, uEU, amtEU, KFD.scr]

theorem σT_none (P Q d0 d1 r2 fm k2 : ℤ) {i : Fin HS} (h : 9 ≤ i.val) :
    σT P Q d0 d1 r2 fm k2 i = none := by
  simp only [σT]
  split_ifs <;> subst_vars <;> first | rfl | (exfalso; revert h; decide)

theorem σT_low (P Q d0 d1 r2 fm k2 : ℤ) {i : Fin HS} (h : (σT P Q d0 d1 r2 fm k2 i).isSome) :
    i.val ≤ 8 := by
  by_contra hc
  rw [σT_none P Q d0 d1 r2 fm k2 (by omega)] at h
  simp at h

theorem writes_tabGenU (sgn b : ℤ) : (tabGenU sgn b).writes = (tabGenU 0 0).writes := rfl

theorem noW_tabGenU (P Q d0 d1 r2 fm k2 sgn b : ℤ) :
    NoW (σT P Q d0 d1 r2 fm k2) (tabGenU sgn b) := by
  intro i hi
  rw [writes_tabGenU] at hi
  have : ∀ j ∈ (tabGenU 0 0).writes, 9 ≤ j.val := by decide
  exact σT_none _ _ _ _ _ _ _ (this i hi)

theorem notMem_zX {i : Fin HS} (h : i.val < 56) : i ∉ zX.all := by
  intro hz
  simp only [ExSt.all, zX, List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> exact absurd h (by decide)

theorem sclean_σT (P Q d0 d1 r2 fm k2 : ℤ) : SClean (σT P Q d0 d1 r2 fm k2) := by
  intro i hi
  have := σT_low P Q d0 d1 r2 fm k2 hi
  exact notMem_zX (by omega)

/-! ## One line, register-driven -/

theorem noLow_rotPl {eP eQ eB ed0 ed1 er ef eK : Ex HS} (h1 : NoLow eP) (h2 : NoLow eQ)
    (h3 : NoLow eB) (h4 : NoLow ed0) (h5 : NoLow ed1) (h6 : NoLow er) (h7 : NoLow ef)
    (h8 : NoLow eK) : ∀ p ∈ rotPl eP eQ eB ed0 ed1 er ef eK, ∀ r ∈ p.2.regs,
      r ∉ (rotPl eP eQ eB ed0 ed1 er ef eK).map Prod.fst := by
  intro p hp r hr hm
  simp only [rotPl, List.mem_cons, List.not_mem_nil, or_false] at hp
  simp only [rotPl, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false] at hm
  have : 13 ≤ r.val := by
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact h1 r hr
    · exact h2 r hr
    · exact h3 r hr
    · exact h4 r hr
    · exact h5 r hr
    · exact h6 r hr
    · exact h7 r hr
    · exact h8 r hr
  rcases hm with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> revert this <;> decide

theorem rotU_runs_sol_aux {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {d0 d1 : ℕ}
    (hd0 : 0 < d0) (hd1 : 0 < d1) (l : Line) (hs : l.sgn = 1 ∨ l.sgn = -1)
    (hb : l.b = 0 ∨ l.b = 1) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb)
    (zd0 : zsz (d0 : ℤ) ≤ Bb) (zd1 : zsz (d1 : ℤ) ≤ Bb)
    (P B w : ℕ) (zP : zsz (P : ℤ) ≤ Bb)
    (t : IState HS) (xs : List ℤ) (R : List Item) (hlen : xs.length = P * 2 ^ (f * K) * B)
    (hbw : Bnd w xs) (h0 : t.G 0 = ints xs ++ R)
    {eP eQ eB ed0 ed1 er ef eK : Ex HS}
    (hsz : ((rotPl eP eQ eB ed0 ed1 er ef eK).map fun p => p.2.size + 1).sum ≤ 100)
    (n1 : NoLow eP) (n2 : NoLow eQ) (n3 : NoLow eB) (n4 : NoLow ed0) (n5 : NoLow ed1)
    (n6 : NoLow er) (n7 : NoLow ef) (n8 : NoLow eK)
    (E1 : ESp eP t Bb (P : ℤ)) (E2 : ESp eQ t Bb ((2 ^ (f * K) : ℕ) : ℤ)) (E3 : ESp eB t Bb (B : ℤ))
    (E4 : ESp ed0 t Bb (d0 : ℤ)) (E5 : ESp ed1 t Bb (d1 : ℤ)) (E6 : ESp er t Bb ((2 : ℤ) ^ ρ))
    (E7 : ESp ef t Bb ((f - 1 : ℕ) : ℤ)) (E8 : ESp eK t Bb ((2 : ℤ) ^ K)) :
    IRuns I iprog (rotU l.sgn l.b eP eQ eB ed0 ed1 er ef eK) t
      (t.upd 0 (ints (pull [P, 2 ^ (f * K), B] [P, 2 ^ (f * K), B]
        (KIL.rotAddr (2 ^ (f * K)) (tabA K ρ f d0 d1 (2 ^ (f * K)) l)) 0 xs) ++ R))
      (cRotU K f l.b P (2 ^ (f * K)) B w Bb) := by
  set Q := 2 ^ (f * K) with hQe
  have hQ0 : 0 < Q := by positivity
  set pl := rotPl eP eQ eB ed0 ed1 er ef eK
  have hE : ∀ p ∈ pl, ∃ v, ESp p.2 t Bb v := by
    intro p hp
    simp only [pl, rotPl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    exacts [⟨_, E1⟩, ⟨_, E2⟩, ⟨_, E3⟩, ⟨_, E4⟩, ⟨_, E5⟩, ⟨_, E6⟩, ⟨_, E7⟩, ⟨_, E8⟩]
  have hl : PushOK t Bb pl := pushOK_of (by
    intro p hp; simp only [pl, rotPl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> (dsimp only; decide))
    (noLow_rotPl n1 n2 n3 n4 n5 n6 n7 n8) hE
  have ev : evalP t pl = [(1, (P : ℤ)), (2, ((Q : ℕ) : ℤ)), (4, (B : ℤ)), (3, (d0 : ℤ)),
      (5, (d1 : ℤ)), (6, (2 : ℤ) ^ ρ), (7, ((f - 1 : ℕ) : ℤ)), (8, (2 : ℤ) ^ K)] := by
    simp only [evalP, pl, rotPl, List.map_cons, List.map_nil, E1.ev, E2.ev, E3.ev, E4.ev, E5.ev,
      E6.ev, E7.ev, E8.ev]
  have hnd : (pl.map Prod.fst).Nodup := by simp only [pl, rotPl, List.map_cons, List.map_nil]; decide
  set u := pushSt t (evalP t pl)
  -- the table, uniformly
  have TG := tabGen_fsp hK hρK hf hd0 hd1 hQ0 l hs hb hB2 hbig zd0 zd1 le_rfl P zP u
    (fun _ => []) rfl rfl
  rw [encK_nil, ← encK_upd, encK_nil] at TG
  simp only [List.append_nil] at TG
  set σ := σT P (Q : ℕ) d0 d1 (2 ^ ρ) (f - 1 : ℕ) (2 ^ K)
  have hag : Agree σ u := by
    refine agree_pushSt t _ (by rw [evalP_fst]; exact hnd) (fun i v hv => ?_)
    rw [ev]
    simp only [σ, σT] at hv
    split_ifs at hv <;> subst_vars <;> cases hv <;> simp
  have hO : HRef (tabGen K ρ f d0 d1 Q P l.sgn l.b) (RS.sub σ (tabGenU l.sgn l.b)) 0 := by
    rw [tabGenU_sub]; exact HRef.refl _
  have TU := FSp.uni (sclean_σT _ _ _ _ _ _ _) (noW_tabGenU _ _ _ _ _ _ _ _ _) hO hag TG
  have has : ∀ p, tabA K ρ f d0 d1 Q l p ≤ Q := by
    intro p
    simp only [tabA, amt]
    have h1 := Int.emod_nonneg (l.sgn * offset K ρ f ↑(p / d0 % Q) ↑(p / d1 % Q) l.b)
      (by positivity : (2 : ℤ) ^ (f * K) ≠ 0)
    have h2 := Int.emod_lt_of_pos (l.sgn * offset K ρ f ↑(p / d0 % Q) ↑(p / d1 % Q) l.b)
      (by positivity : (0 : ℤ) < 2 ^ (f * K))
    have : ((2 : ℤ) ^ (f * K)) = ((Q : ℕ) : ℤ) := by rw [hQe]; push_cast; rfl
    omega
  have W := tabRot_runs (I := I) (iprog := iprog) (pl := pl) (fok_tabGenU l.sgn l.b) t Bb hl
    (pushVals_le hE) (by simp only [pl, rotPl, List.map_cons, List.map_nil]; decide) (by simp only [pl, rotPl, List.map_cons, List.map_nil]; decide) hnd
    (P := P) (Q := Q) (B := B) (w := w) (by rw [ev]; simp) (by rw [ev]; simp) (by rw [ev]; simp)
    (tabA K ρ f d0 d1 Q l) has TU xs R hlen hbw h0
  refine W.mono ?_
  have hpc := pushCost_le_size Bb pl 100 hsz
  have hl8 : pl.length = 8 := rfl
  rw [hl8]
  simp only [cRotU]
  have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
  generalize (Bb + 2) ^ 2 = X at *
  omega

