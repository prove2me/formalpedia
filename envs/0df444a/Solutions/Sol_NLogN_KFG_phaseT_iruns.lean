open NLogN
open NLogN.KFG
open IntMul RS AModel KIL KFD KFB Complex
theorem solution {Pp : ℕ} {I : List NLogN.Sym} {iprog : Fin Pp → NLogN.IStmt NLogN.HS Pp}
    (s : NLogN.IState NLogN.HS) (wb : ℕ) {W m n : ℕ} (T : Butterfly.Op (Fin n))
    (w : Fin W) (k₀ k₁ : ℕ) (a : Fin m → ℕ) (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : NLogN.KFB.Rep zs x) (h0 : f 0 = NLogN.KFB.gflat zs ++ l)
    (hC : NLogN.KFG.ClT f) (hb : NLogN.KFB.GB wb zs) (Z : ℕ)
    (hZ : NLogN.zsz ((4 * (w.val * 2 ^ (m * n) + 2 ^ (m * n)) : ℕ) : ℤ) ≤ Z) :
    ∃ zs', NLogN.KFB.Rep zs' ((P8Lift.RStep.den T (P8Lift.RStep.phase w k₀ k₁ a)).mulVec x) ∧ NLogN.KFB.GB wb zs' ∧
      NLogN.IRuns I iprog (NLogN.KFD.fcode (NLogN.KFG.phaseT m n w.val k₀ k₁ a)) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat zs' ++ l)))
        (NLogN.KFG.cPhT wb (m * n) (w.val * 2 ^ (m * n)) Z) := by
  have hw : w.val * 2 ^ (m * n) + 2 ^ (m * n) ≤ zs.length := by
    rw [hx.1, ← Nat.succ_mul]; exact Nat.mul_le_mul_right _ w.isLt
  unfold NLogN.KFG.phaseT
  generalize hoff : w.val * 2 ^ (m * n) = off at hw hZ ⊢
  have hN1 : 1 ≤ 2 ^ (m * n) := Nat.one_le_two_pow
  have hsplit : zs = zs.take off ++ ((zs.drop off).take (2 ^ (m * n)) ++ zs.drop (off + 2 ^ (m * n))) := by
    rw [← List.drop_drop, List.take_append_drop, List.take_append_drop]
  have hb' := hb
  rw [hsplit] at hb'
  obtain ⟨hbp, hb2⟩ := NLogN.KFB.GB_append.1 hb'
  obtain ⟨hbs, hbr⟩ := NLogN.KFB.GB_append.1 hb2
  have H := NLogN.KFG.phT_fsp s f (m * n) off (k₀ + k₁ * n) (NLogN.KFB.phE (n := n) a) (zs.take off)
    ((zs.drop off).take (2 ^ (m * n))) (NLogN.KFB.gflat (zs.drop (off + 2 ^ (m * n))) ++ l)
    (by rw [List.length_take]; exact Nat.min_eq_left (by omega))
    (by rw [List.length_take, List.length_drop]; exact Nat.min_eq_left (by omega))
    (by rw [h0]; conv_lhs => rw [hsplit]
        simp only [NLogN.KFB.gflat_append, List.append_assoc]) hC hbp hbs Z hZ
  refine ⟨NLogN.KFG.phOut (m * n) off (k₀ + k₁ * n) (NLogN.KFB.phE (n := n) a) zs, hoff ▸ NLogN.KFG.rep_phaseT T w k₀ k₁ a zs x hx,
    ?_, ?_⟩
  · unfold NLogN.KFG.phOut
    exact NLogN.KFB.GB_append.2 ⟨hbp, NLogN.KFB.GB_append.2 ⟨NLogN.KFG.GB_mulL _ _ (NLogN.KFG.ex4_tbl _ _ _) hbs, hbr⟩⟩
  · refine NLogN.KFD.FSp.irun (NLogN.KFG.fok_phT _ _ _ _) (H.congr ?_)
    unfold NLogN.KFG.phOut
    simp [NLogN.KFB.gflat_append]
end
