open LIDT.MIPStarRE.LDT.Pasting

open MIPStarRE.LDT
open MIPStarRE.LDT.ExpansionHypercubeGraph
open MIPStarRE.LDT.CommutativityPoints
open scoped BigOperators MatrixOrder _root_.Matrix ComplexOrder

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem solution
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters) [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    {k : ℕ}
    (u : _root_.LIDT.MIPStarRE.LDT.Point params)
    (xs : _root_.LIDT.MIPStarRE.LDT.PointTuple params k)
    (hxs : Function.Injective xs)
    (gs : _root_.LIDT.MIPStarRE.LDT.Pasting.GHatTupleOutcome params k)
    (hEligible : _root_.LIDT.MIPStarRE.LDT.Pasting.InterpolationEligible params gs)
    (f : _root_.LIDT.MIPStarRE.LDT.AxisLinePolynomial params.next)
    (hNoMismatch : ¬ (∃ i : Fin k, ∃ hiSome : (gs i).isSome = true,
      ((gs i).get hiSome) u ≠ f (xs i))) :
    _root_.LIDT.MIPStarRE.LDT.Pasting.tupleInterpolatedVerticalLine params u xs gs = f := by
  classical
  by_contra hne
  let σ := _root_.LIDT.MIPStarRE.LDT.Pasting.interpolationSupportSubset gs hEligible
  have hσcard : σ.card = params.d + 1 := _root_.LIDT.MIPStarRE.LDT.Pasting.interpolationSupportSubset_card gs hEligible
  rcases _root_.LIDT.MIPStarRE.LDT.Pasting.axisLinePolynomial_ne_gives_support_eval_ne params xs hxs σ hσcard hne with
    ⟨i, hiσ, hEvalNe⟩
  have hiSupport : i ∈ _root_.LIDT.MIPStarRE.LDT.Pasting.gHatTupleSupport gs := _root_.LIDT.MIPStarRE.LDT.Pasting.interpolationSupportSubset_subset gs hEligible hiσ
  have hiSome : (gs i).isSome = true := by
    simpa [_root_.LIDT.MIPStarRE.LDT.Pasting.gHatTupleSupport] using hiSupport
  have hslicePoly :
      (_root_.LIDT.MIPStarRE.LDT.Polynomial.restrictAtHeight params
        (_root_.LIDT.MIPStarRE.LDT.Pasting.interpolateCompletedSlices params k xs gs) (xs i)).poly =
      ((gs i).get hiSome).poly := by
    simpa [hiSome] using
      _root_.LIDT.MIPStarRE.LDT.Pasting.interpolateCompletedSlices_restrictAtHeight_eq_get_of_mem_supportSubset
        params xs hxs gs hEligible hiσ
  have hsliceEval :
      (_root_.LIDT.MIPStarRE.LDT.Polynomial.restrictAtHeight params
        (_root_.LIDT.MIPStarRE.LDT.Pasting.interpolateCompletedSlices params k xs gs) (xs i)) u =
      ((gs i).get hiSome) u := by
    simpa [_root_.LIDT.MIPStarRE.LDT.Polynomial.toFun, _root_.LIDT.MIPStarRE.LDT.evalPolynomialModel] using congrArg
      (fun p : _root_.LIDT.MIPStarRE.LDT.PolynomialModel params => _root_.LIDT.MIPStarRE.LDT.encodeScalar (MvPolynomial.eval (_root_.LIDT.MIPStarRE.LDT.decodePoint u) p))
      hslicePoly
  have hlineEval :
      _root_.LIDT.MIPStarRE.LDT.Pasting.tupleInterpolatedVerticalLine params u xs gs (xs i) = ((gs i).get hiSome) u := by
    calc
      _root_.LIDT.MIPStarRE.LDT.Pasting.tupleInterpolatedVerticalLine params u xs gs (xs i)
        = (_root_.LIDT.MIPStarRE.LDT.Polynomial.restrictAtHeight params
            (_root_.LIDT.MIPStarRE.LDT.Pasting.interpolateCompletedSlices params k xs gs) (xs i)) u := by
              simpa [_root_.LIDT.MIPStarRE.LDT.Pasting.tupleInterpolatedVerticalLine] using
                _root_.LIDT.MIPStarRE.LDT.Pasting.restrictToVerticalLine_eval_eq_restrictAtHeight_eval
                  params (_root_.LIDT.MIPStarRE.LDT.Pasting.interpolateCompletedSlices params k xs gs) u (xs i)
      _ = ((gs i).get hiSome) u := hsliceEval
  have hmismatch : ((gs i).get hiSome) u ≠ f (xs i) := by
    intro hEq
    exact hEvalNe (hlineEval.trans hEq)
  exact hNoMismatch ⟨i, hiSome, hmismatch⟩
