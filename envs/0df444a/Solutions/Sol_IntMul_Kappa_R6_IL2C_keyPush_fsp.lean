  obtain ⟨L6, eQC⟩ := hE.qc
  obtain ⟨L7, eRR⟩ := hE.rr
  obtain ⟨L8, eN⟩ := hE.nn
  have zM : ∀ z : ℕ, z ≤ M → zsz (z : ℤ) ≤ Bb := fun z hz => zB z (Nat.le_trans hz (Nat.le_mul_of_pos_left M (by norm_num)))
  have zQL := zM _ hV.qlM
  have zQC := zM _ (le_trans hV.qcQL hV.qlM)
  have zST := zM _ (le_trans hT1 hQT)
  have zSU := zM l.sU (by nlinarith)
  have zSX := zM l.sX (by nlinarith)
  have zSY := zM l.sY (by nlinarith)
  have zk := zM k hk.le
  have hkm : (encK s G0).G rm = .int (k : ℤ) :: (ints lm ++ s.G rm) := by rw [encK_G, hm]; rfl
  -- pushes
  have E1 : ESp (.reg kN) (encK s G0) Bb (n : ℤ) := ESp.ofG' eN (by decide) (zM _ hV.nM)
  have S1 := Sp.pushQ s G0 (i := pN) (by decide) E1.clean E1.ok E1.bnd
  rw [E1.ev] at S1
  set G1 := Function.update G0 pN ((n : ℤ) :: G0 pN) with hG1
  have E2 : ESp (.reg kRR) (encK s G1) Bb ((2 : ℤ) ^ G) :=
    ESp.ofG' (by rw [encK_upd_ne (by decide)]; exact eRR) (by decide) (by
      have := zM _ hV.RM; push_cast at this; exact this)
  have S2 := Sp.pushQ s G1 (i := pR) (by decide) E2.clean E2.ok E2.bnd
  rw [E2.ev, show G1 pR = G0 pR from upd_ne (by decide) _] at S2
  set G2 := Function.update G1 pR ((2 : ℤ) ^ G :: G0 pR) with hG2
  have E3 : ESp (gcK rm kSX kQL) (encK s G2) Bb (x : ℤ) :=
    eGc (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide)]; exact hkm)
      (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide)]; exact eSX)
      (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide)]; exact eQL) pX hQL1
      (by decide) (by decide) (by decide) zk zSX zQL
  have S3 := Sp.pushQ s G2 (i := kx) (by decide) E3.clean E3.ok E3.bnd
  rw [E3.ev, show G2 kx = G0 kx by simp only [G2, G1]; rw [upd_ne (by decide), upd_ne (by decide)]]
    at S3
  set G3 := Function.update G2 kx ((x : ℤ) :: G0 kx) with hG3
  have E4 : ESp (gcK rm kST kQC) (encK s G3) Bb (t : ℤ) :=
    eGc (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide), encK_upd_ne (by decide)]; exact hkm)
      (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide), encK_upd_ne (by decide)]; exact eST)
      (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide), encK_upd_ne (by decide)]; exact eQC)
      pT hQC1 (by decide) (by decide) (by decide) zk zST zQC
  have S4 := Sp.pushQ s G3 (i := kt) (by decide) E4.clean E4.ok E4.bnd
  rw [E4.ev, show G3 kt = G0 kt by
    simp only [G3, G2, G1]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]] at S4
  set G4 := Function.update G3 kt ((t : ℤ) :: G0 kt) with hG4
  have E5 : ESp (gcK rm kSU kQC) (encK s G4) Bb (u : ℤ) :=
    eGc (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide), encK_upd_ne (by decide),
        encK_upd_ne (by decide)]; exact hkm)
      (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide), encK_upd_ne (by decide),
        encK_upd_ne (by decide)]; exact eSU)
      (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide), encK_upd_ne (by decide),
        encK_upd_ne (by decide)]; exact eQC)
      pU hQC1 (by decide) (by decide) (by decide) zk zSU zQC
  have S5 := Sp.pushQ s G4 (i := ku) (by decide) E5.clean E5.ok E5.bnd
  rw [E5.ev, show G4 ku = G0 ku by
    simp only [G4, G3, G2, G1]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]] at S5
  set G5 := Function.update G4 ku ((u : ℤ) :: G0 ku) with hG5
  have E6 : ESp (gcK rm kSY kQL) (encK s G5) Bb (y : ℤ) :=
    eGc (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide), encK_upd_ne (by decide),
        encK_upd_ne (by decide), encK_upd_ne (by decide)]; exact hkm)
      (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide), encK_upd_ne (by decide),
        encK_upd_ne (by decide), encK_upd_ne (by decide)]; exact eSY)
      (by rw [encK_upd_ne (by decide), encK_upd_ne (by decide), encK_upd_ne (by decide),
        encK_upd_ne (by decide), encK_upd_ne (by decide)]; exact eQL)
      pY hQL1 (by decide) (by decide) (by decide) zk zSY zQL
  have S6 := Sp.pushQ s G5 (i := ky) (by decide) E6.clean E6.ok E6.bnd
  rw [E6.ev, show G5 ky = G0 ky by
    simp only [G5, G4, G3, G2, G1]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
      upd_ne (by decide)]] at S6
  have e6 : Function.update G5 ky ((y : ℤ) :: G0 ky) = KS G0 n ((2 : ℤ) ^ G) x t u y := rfl
  rw [e6] at S6
  have F := (FSp.of_norep rfl S1).seq ((FSp.of_norep rfl S2).seq ((FSp.of_norep rfl S3).seq
    ((FSp.of_norep rfl S4).seq ((FSp.of_norep rfl S5).seq ((FSp.of_norep rfl S6).seq hr)))))
  refine F.mono ?_
  simp only [cPush, gcK, Ex.size]
  clear * -
  omega

end IntMul.Kappa.R6.IL2C

