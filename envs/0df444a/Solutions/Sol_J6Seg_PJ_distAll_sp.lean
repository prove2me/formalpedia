/-!
# B5 set-up, part 6: the final distribution (plain `Sp`)

From `45 = [ρ0 … ρ8]`, `42 = [|T|]`, `41 = T`: put `[ρi]` on `oN i` (`i < 9`), `[|T|]` on `oN 9`
and `T` (in order, through `43`) on `oN 10`; `41, 42, 45` end empty (`distAll_sp`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

theorem putL_get : ∀ (l : List (Fin HS)) (as : List ℤ) (f : Cs), l.Nodup → l.length = as.length →
    ∀ (i : ℕ) (hi : i < l.length), putL l as f l[i] = [as.getD i 0]
  | [], _, _, _, _, i, hi => by simp at hi
  | j :: l, [], _, _, hl, i, hi => by simp at hl
  | j :: l, a :: as, f, hnd, hl, i, hi => by
    rw [List.nodup_cons] at hnd
    simp only [putL]
    rcases i with _ | i
    · simp only [List.getElem_cons_zero, List.getD_cons_zero]
      rw [putL_out l as _ hnd.1, update_self]
    · simp only [List.getElem_cons_succ, List.getD_cons_succ]
      exact putL_get l as _ hnd.2 (by simpa using hl) i (by simpa using hi)

theorem l9_get (oN : Fin 19 → Fin HS) (i : Fin 9) :
    (l9 oN)[i.val]'(by simp [l9]) = oN (Fin.castLE (by omega) i) := by
  simp only [l9, List.getElem_ofFn]

theorem mem_l9 {oN : Fin 19 → Fin HS} {j : Fin HS} : j ∈ l9 oN ↔ ∃ i : Fin 9, oN (Fin.castLE (by omega) i) = j := by
  simp only [l9, List.mem_ofFn, Set.mem_range]

/-- **The final distribution.** -/
theorem distAll_sp_sol_aux (s : IState HS) (oN : Fin 19 → Fin HS) (hinj : Injective oN)
    (hlt : ∀ i, (oN i).val < 56)
    (hx : ∀ i, oN i ≠ sX ∧ oN i ≠ sLn ∧ oN i ≠ sOut ∧ oN i ≠ sT2 ∧ oN i ≠ cLC)
    (f : Cs) (vs T : List ℤ) (hvs : vs.length = 9) (hfX : f sX = vs)
    (hfL : f sLn = [(T.length : ℤ)]) (hfO : f sOut = T) (h43 : f sT2 = []) (hfo : ∀ i, f (oN i) = [])
    (V : Fin 19 → List ℤ) (hVs : ∀ i : Fin 9, V (Fin.castLE (by omega) i) = [vs.getD i 0])
    (hV9 : V 9 = [(T.length : ℤ)]) (hV10 : V 10 = T) (hVr : ∀ i : Fin 19, 11 ≤ i.val → V i = [])
    (B : ℕ) (hvB : ∀ a ∈ vs, zsz a ≤ B) (hlB : zsz (T.length : ℤ) ≤ B) (hTB : Bnd B T) :
    Sp (distAll oN) (encK s f)
      (encK s (update (update (update (extend oN V f) sX []) sLn []) sOut [])) (cDistAll B T.length) := by
  have hnd : (l9 oN).Nodup := List.nodup_ofFn.mpr (hinj.comp (Fin.castLE_injective _))
  have hXl : sX ∉ l9 oN := by
    rw [mem_l9]; rintro ⟨i, hi⟩; exact (hx _).1 hi
  have hLl : sLn ∉ l9 oN := by
    rw [mem_l9]; rintro ⟨i, hi⟩; exact (hx _).2.1 hi
  have hOl : sOut ∉ l9 oN := by
    rw [mem_l9]; rintro ⟨i, hi⟩; exact (hx _).2.2.1 hi
  have h43l : sT2 ∉ l9 oN := by
    rw [mem_l9]; rintro ⟨i, hi⟩; exact (hx _).2.2.2.1 hi
  have hCl : cLC ∉ l9 oN := by
    rw [mem_l9]; rintro ⟨i, hi⟩; exact (hx _).2.2.2.2 hi
  have hNl : ∀ k : Fin 19, 9 ≤ k.val → oN k ∉ l9 oN := by
    intro k hk; rw [mem_l9]; rintro ⟨i, hi⟩
    have := hinj hi; rw [Fin.ext_iff] at this; simp at this; omega
  have S1 := distP_sp s sX (by decide) B (l9 oN) vs [] f (by simp [l9, hvs]) hXl
    (fun j hj => by obtain ⟨i, rfl⟩ := mem_l9.mp hj; exact hlt _) hnd
    (fun j hj => by obtain ⟨i, rfl⟩ := mem_l9.mp hj; exact hfo _) (by simp [hfX]) hvB
  set f1 := update (putL (l9 oN) vs f) sX [] with hf1
  have f1L : f1 sLn = [(T.length : ℤ)] := by
    rw [hf1, update_of_ne (by decide), putL_out _ _ _ hLl, hfL]
  have f1O : f1 sOut = T := by rw [hf1, update_of_ne (by decide), putL_out _ _ _ hOl, hfO]
  have f19 : f1 (oN 9) = [] := by
    rw [hf1, update_of_ne (hx 9).1, putL_out _ _ _ (hNl 9 (by decide)), hfo]
  have S2 := Sp.push (i := oN 9) (e := .reg sLn) (B := B) s f1 (hlt 9) (clean_reg (by decide))
    (ok_reg f1L) trivial (bnd_reg f1L hlB)
  rw [eval_reg f1L, f19] at S2
  set f2 := update f1 (oN 9) [(T.length : ℤ)] with hf2
  have f2O : f2 sOut = T ++ [] := by rw [hf2, update_of_ne (hx 9).2.2.1.symm, f1O, List.append_nil]
  have f2L : f2 sLn = [(T.length : ℤ)] := by rw [hf2, update_of_ne (hx 9).2.1.symm, f1L]
  have f243 : f2 sT2 = [] := by
    rw [hf2, update_of_ne (hx 9).2.2.2.1.symm, hf1, update_of_ne (by decide), putL_out _ _ _ h43l, h43]
  have S3 := Sp.mvK (X := sOut) (Y := sT2) (C := cLC) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s f2 (.reg sLn) (clean_reg (by decide)) (ok_reg f2L) T [] f2O
    (eval_reg f2L) B hTB trivial (bnd_reg f2L hlB)
  rw [f243, List.append_nil] at S3
  set f3 := update (update f2 sOut []) sT2 T.reverse with hf3
  have f343 : f3 sT2 = T.reverse ++ [] := by rw [hf3, update_self, List.append_nil]
  have f3L : f3 sLn = [(T.length : ℤ)] := by
    rw [hf3, update_of_ne (by decide), update_of_ne (by decide), f2L]
  have f310 : f3 (oN 10) = [] := by
    rw [hf3, update_of_ne (hx 10).2.2.2.1, update_of_ne (hx 10).2.2.1, hf2,
      update_of_ne (hinj.ne (by decide)), hf1, update_of_ne (hx 10).1,
      putL_out _ _ _ (hNl 10 (by decide)), hfo]
  have S4 := Sp.mvK (X := sT2) (Y := oN 10) (C := cLC) (hx 10).2.2.2.1.symm (by decide)
    (hx 10).2.2.2.2 (by decide) (hlt 10) (by decide) s f3 (.reg sLn) (clean_reg (by decide))
    (ok_reg f3L) T.reverse [] f343 (by rw [eval_reg f3L, List.length_reverse]) B
    (fun a ha => hTB a (List.mem_reverse.mp ha)) trivial (bnd_reg f3L hlB)
  rw [f310, List.append_nil, List.reverse_reverse, List.length_reverse] at S4
  set f4 := update (update f3 sT2 []) (oN 10) T with hf4
  have f4L : f4 sLn = [(T.length : ℤ)] := by
    rw [hf4, update_of_ne (hx 10).2.1.symm, update_of_ne (by decide), f3L]
  have S5 := Sp.pop (i := sLn) (B := B) s f4 (by decide) f4L hlB
  unfold distAll
  refine ((S1.seq (S2.seq (S3.seq (S4.seq S5)))).congr ?_).mono ?_
  · congr 1
    funext j
    symm
    by_cases hj : ∃ i, oN i = j
    · obtain ⟨i, rfl⟩ := hj
      obtain ⟨a1, a2, a3, a4, a5⟩ := hx i
      rw [update_of_ne a3, update_of_ne a2, update_of_ne a1, hinj.extend_apply,
        update_of_ne a2, hf4]
      by_cases i10 : i = 10
      · subst i10; rw [update_self, hV10]
      rw [update_of_ne (hinj.ne i10), update_of_ne a4, hf3, update_of_ne a4, update_of_ne a3, hf2]
      by_cases i9 : i = 9
      · subst i9; rw [update_self, hV9]
      rw [update_of_ne (hinj.ne i9), hf1, update_of_ne a1]
      by_cases ilt : i.val < 9
      · have e : i = Fin.castLE (by omega) (⟨i.val, ilt⟩ : Fin 9) := Fin.ext rfl
        rw [e, hVs, ← l9_get oN ⟨i.val, ilt⟩]
        rw [putL_get _ vs _ hnd (by simp [l9, hvs])]
      · have h11 : 11 ≤ i.val := by
          have : i.val ≠ 9 := fun h => i9 (Fin.ext h)
          have : i.val ≠ 10 := fun h => i10 (Fin.ext h)
          omega
        rw [putL_out _ _ _ (hNl i (by omega)), hfo, hVr i h11]
    · have hE : extend oN V f j = f j := extend_apply' _ _ _ hj
      have n10 : j ≠ oN 10 := fun h => hj ⟨10, h.symm⟩
      have n9 : j ≠ oN 9 := fun h => hj ⟨9, h.symm⟩
      have nl : j ∉ l9 oN := by rw [mem_l9]; rintro ⟨i, hi⟩; exact hj ⟨_, hi⟩
      by_cases jL : j = sLn
      · subst jL; rw [update_of_ne (by decide), update_self, update_self]
      rw [update_of_ne jL, hf4, update_of_ne n10]
      by_cases jO : j = sOut
      · subst jO; rw [update_self, update_of_ne (by decide), hf3, update_of_ne (by decide), update_self]
      rw [update_of_ne jO, update_of_ne jL]
      by_cases j43 : j = sT2
      · subst j43; rw [update_self, update_of_ne (by decide), hE, h43]
      rw [update_of_ne j43, hf3, update_of_ne j43, update_of_ne jO, hf2, update_of_ne n9, hf1]
      by_cases jX : j = sX
      · subst jX; rw [update_self, update_self]
      rw [update_of_ne jX, update_of_ne jX, putL_out _ _ _ nl, hE]
  · simp only [cDistAll, cMv, List.length_ofFn, l9]; omega

end J6Seg.PJ

end

