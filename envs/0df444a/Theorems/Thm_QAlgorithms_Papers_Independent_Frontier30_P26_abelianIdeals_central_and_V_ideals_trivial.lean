/-- Lemma 2.7, PDF p. 5. Both clauses are retained. -/
theorem abelianIdeals_central_and_V_ideals_trivial (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) :
    (∀ I : LieIdeal ℝ G, (∀ x y : I, ⁅x, y⁆ = 0) → I ≤ LieAlgebra.center ℝ G) ∧
    (∀ I : LieIdeal ℝ G, I.toSubmodule ≤ P.V → I = ⊥) := by sorry

