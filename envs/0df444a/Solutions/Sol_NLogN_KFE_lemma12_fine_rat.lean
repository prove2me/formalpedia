-- Source module: Solutions.AModelCost
namespace AModel

open Finset

/-- `((m:ℝ)^k)^τ = (m^τ)^k`. -/
lemma pow_rpow_eq (m : ℕ) (k : ℕ) (τ : ℝ) :
    (((m : ℝ) ^ k) ^ τ) = ((m : ℝ) ^ τ) ^ k :=
  (Real.rpow_pow_comm (Nat.cast_nonneg m) τ k).symm

lemma one_le_base_rpow {m : ℕ} (hm : 2 ≤ m) {τ : ℝ} (hτ : 0 ≤ τ) :
    1 ≤ (m : ℝ) ^ τ :=
  Real.one_le_rpow (by exact_mod_cast (by omega : 1 ≤ m)) hτ

/-- Abstract version: `F (k+1) ≤ a F k + C`, `0 ≤ a < b`, `1 ≤ b` gives `F k ≤ K b^k`. -/
lemma linear_recurrence_bound {a b C : ℝ} (ha : 0 ≤ a) (hab : a < b) (hb : 1 ≤ b)
    (hC : 0 ≤ C) (F : ℕ → ℝ) (h0 : F 0 ≤ C) (hstep : ∀ k, F (k + 1) ≤ a * F k + C) :
    ∀ k, F k ≤ max C (C / (b - a)) * b ^ k := by
  set K := max C (C / (b - a))
  have hba : 0 < b - a := by linarith
  have hKC : C ≤ K := le_max_left _ _
  have hK2 : C ≤ K * (b - a) := by
    have : C / (b - a) ≤ K := le_max_right _ _
    rwa [div_le_iff₀ hba] at this
  have hK0 : 0 ≤ K := le_trans hC hKC
  intro k
  induction k with
  | zero => simpa using h0.trans hKC
  | succ k ih =>
    have hbk : 1 ≤ b ^ k := one_le_pow₀ hb
    have h1 : a * F k ≤ a * (K * b ^ k) := mul_le_mul_of_nonneg_left ih ha
    have h2 : C ≤ K * (b - a) * b ^ k := by
      nlinarith [mul_nonneg hK0 hba.le]
    calc F (k + 1) ≤ a * F k + C := hstep k
      _ ≤ a * (K * b ^ k) + K * (b - a) * b ^ k := by linarith
      _ = K * b ^ (k + 1) := by ring

/-- **Prop. 11, eq. (12)** (power widths). -/
theorem power_width_recurrence (m W s : ℕ) (τ C : ℝ) (hm : 2 ≤ m) (_hW : 1 ≤ W)
    (hτ : 0 < τ ∧ τ < 1) (hs : (s : ℝ) / W < (m : ℝ) ^ τ) (hC : 0 ≤ C) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ F : ℕ → ℝ, F 0 ≤ C → (∀ k, F (k + 1) ≤ ((s : ℝ) / W) * F k + C) →
      ∀ k, F k ≤ K * ((m : ℝ) ^ k) ^ τ := by
  refine ⟨max C (C / ((m : ℝ) ^ τ - (s : ℝ) / W)), le_trans hC (le_max_left _ _), ?_⟩
  intro F h0 hstep k
  rw [pow_rpow_eq]
  exact linear_recurrence_bound (by positivity) hs (one_le_base_rpow hm hτ.1.le) hC F h0
    hstep k

/-- The time recurrence is dominated by `V * coeffSeq`. -/
lemma time_le_vol_mul_coeff (s W : ℕ) (C : ℝ) (T : ℕ → ℝ → ℝ)
    (h0 : ∀ V, 0 ≤ V → T 0 V ≤ C * V)
    (hstep : ∀ k V, 0 ≤ V → T (k + 1) V ≤ C * V + s * T k (V / W)) :
    ∀ k V, 0 ≤ V → T k V ≤ V * coeffSeq s W C k := by
  intro k
  induction k with
  | zero => intro V hV; simpa [coeffSeq, mul_comm] using h0 V hV
  | succ k ih =>
    intro V hV
    have h1 := ih (V / W) (by positivity)
    have h2 : (s : ℝ) * T k (V / W) ≤ s * (V / W * coeffSeq s W C k) :=
      mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg s)
    calc T (k + 1) V ≤ C * V + s * T k (V / W) := hstep k V hV
      _ ≤ C * V + s * (V / W * coeffSeq s W C k) := by linarith
      _ = V * coeffSeq s W C (k + 1) := by simp only [coeffSeq]; ring

/-- **Prop. 11, eq. (12)**, time form with volumes:
`T 0 V ≤ C V`, `T (k+1) V ≤ C V + s T k (V/W)` gives `T k V ≤ K V (m^k)^τ`. -/
theorem power_width_time (m W s : ℕ) (τ C : ℝ) (hm : 2 ≤ m) (hW : 1 ≤ W)
    (hτ : 0 < τ ∧ τ < 1) (hs : (s : ℝ) / W < (m : ℝ) ^ τ) (hC : 0 ≤ C) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ T : ℕ → ℝ → ℝ, (∀ V, 0 ≤ V → T 0 V ≤ C * V) →
      (∀ k V, 0 ≤ V → T (k + 1) V ≤ C * V + s * T k (V / W)) →
      ∀ k V, 0 ≤ V → T k V ≤ K * V * ((m : ℝ) ^ k) ^ τ := by
  obtain ⟨K, hK0, hK⟩ := power_width_recurrence m W s τ C hm hW hτ hs hC
  refine ⟨K, hK0, ?_⟩
  intro T h0 hstep k V hV
  have hG := hK (coeffSeq s W C) le_rfl (fun k => by simp [coeffSeq]) k
  calc T k V ≤ V * coeffSeq s W C k := time_le_vol_mul_coeff s W C T h0 hstep k V hV
    _ ≤ V * (K * ((m : ℝ) ^ k) ^ τ) := mul_le_mul_of_nonneg_left hG hV
    _ = K * V * ((m : ℝ) ^ k) ^ τ := by ring

end AModel

end

