variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem foldl_eq_iterL {α : Type*} (F : ℕ → α → α) : ∀ (n : ℕ) (x : α),
    (List.range n).foldl (fun u k => F k u) x = NLogN.KFV.iterL F n x
  | 0, x => rfl
  | n + 1, x => by
    rw [List.range_succ, List.foldl_append, foldl_eq_iterL F n x]; rfl

theorem cf3_encK_o0 {S : IState HS} {A C D : Fin HS} (hA : A ≠ 0) (hC : C ≠ 0) (hD : D ≠ 0)
    (v : List ℤ) (LA LC LD : List Item) :
    cf3 (encK S (o0 v)) A C D LA LC LD = encK (cf3 S A C D LA LC LD) (o0 v) := by
  refine IState.ext' (fun j => ?_) rfl rfl
  simp only [cf3, IState.upd_G, encK_G]
  by_cases h1 : j = D
  · subst h1; simp [o0_ne v hD, ints]
  by_cases h2 : j = C
  · subst h2; simp [h1, o0_ne v hC, ints]
  by_cases h3 : j = A
  · subst h3; simp [h1, h2, o0_ne v hA, ints]
  · simp [h1, h2, h3]

section Loop

variable {r : ℕ}

theorem iterL_ok {F : ℕ → List (Fin r → ℂ) → List (Fin r → ℂ)} {N p W n : ℕ}
    {b : IStmt HS Pp} {Q : IState HS → Prop} {Bk : ℕ → IState HS → IState HS} {cs : ℕ → ℕ}
    (H : LoopBody I iprog b Q Bk F N p W cs n) (s1 : IState HS) (hQ : Q s1) (l : List ℤ)
    {zs : List GI} {xs : List (Fin r → ℂ)} (hx : RecRep r p zs xs) (hl : xs.length = N)
    (hb : NLogN.KFB.GB W zs) (hd : Disk xs) :
    ∀ k ≤ n, ∃ zs', RecRep r p zs' (NLogN.KFV.iterL F k xs) ∧ NLogN.KFB.GB W zs' ∧ (NLogN.KFV.iterL F k xs).length = N ∧
      Disk (NLogN.KFV.iterL F k xs)
  | 0, _ => ⟨zs, hx, hb, hl, hd⟩
  | k + 1, hk => by
    obtain ⟨z1, a1, b1, c1, d1⟩ := iterL_ok H s1 hQ l hx hl hb hd k (by omega)
    obtain ⟨z2, a2, b2, c2, d2, -⟩ := H k (by omega) s1 hQ z1 l _ a1 c1 b1 d1
    exact ⟨z2, a2, b2, c2, d2⟩

/-- **A unary loop over layers.** -/
theorem rptX_layers {X A C D : Fin HS} (hXA : X ≠ A) (hAC : A ≠ C) (hAD : A ≠ D) (hCD : C ≠ D)
    (hAK : A ≠ NLogN.KFC.sK) (hCK : C ≠ NLogN.KFC.sK) (hCK2 : C ≠ NLogN.KFC.sK2) (hCY : C ≠ uY) (hCB : C ≠ uB)
    (hA0 : A ≠ 0) (hC0 : C ≠ 0) (hD0 : D ≠ 0)
    {F : ℕ → List (Fin r → ℂ) → List (Fin r → ℂ)} {N p W n : ℕ}
    {b : IStmt HS Pp} {Q : IState HS → Prop} {Bk : ℕ → IState HS → IState HS} {cs : ℕ → ℕ}
    (H : LoopBody I iprog b Q Bk F N p W cs n)
    (hQc : ∀ s1 LA LC LD, Q s1 → Q (cf3 s1 A C D LA LC LD))
    (hBc : ∀ k s1 LA LC LD, Bk k (cf3 s1 A C D LA LC LD) = cf3 (Bk k s1) A C D LA LC LD)
    (hBA : ∀ k s1, (Bk k s1).G A = s1.G A) (hBC : ∀ k s1, (Bk k s1).G C = s1.G C)
    (hBD : ∀ k s1, (Bk k s1).G D = s1.G D)
    (s1 : IState HS) (hQ : Q s1) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ))
    (hx : RecRep r p zs xs) (hl : xs.length = N) (hb : NLogN.KFB.GB W zs) (hd : Disk xs)
    {LX : List Item} (hX0 : X ≠ 0) (hX : (Bk 0 s1).G X = .int (n : ℤ) :: LX) :
    ∃ zs', RecRep r p zs' (NLogN.KFV.iterL F n xs) ∧ NLogN.KFB.GB W zs' ∧ (NLogN.KFV.iterL F n xs).length = N ∧
      Disk (NLogN.KFV.iterL F n xs) ∧
      IRuns I iprog (KFT.rptX X A C D b) (encK (Bk 0 s1) (o0 (gflat zs ++ l)))
        (encK (Bk n s1) (o0 (gflat zs' ++ l)))
        ((∑ k ∈ Finset.range n, (cs k + 64)) + 60 + cRpt n + (dupCost (zsz (n : ℤ)) + 17)) := by
  classical
  have E := iterL_ok H s1 hQ l hx hl hb hd
  -- the representation of iteration `k`
  let zk : ℕ → List GI := fun k =>
    if hk : k ≤ n then Classical.choose (E k hk) else []
  have hzk : ∀ k (hk : k ≤ n), RecRep r p (zk k) (NLogN.KFV.iterL F k xs) ∧ NLogN.KFB.GB W (zk k) ∧
      (NLogN.KFV.iterL F k xs).length = N ∧ Disk (NLogN.KFV.iterL F k xs) := fun k hk => by
    simp only [zk, dif_pos hk]; exact Classical.choose_spec (E k hk)
  have hz0 : zk 0 = zs := RecRep_unique (hzk 0 (by omega)).1 hx
  let T : ℕ → IState HS := fun k => encK (Bk k s1) (o0 (gflat (zk k) ++ l))
  have hTA : ∀ k, (T k).G A = (T 0).G A := fun k => by
    simp [T, o0_ne _ hA0, ints, hBA]
  have hTC : ∀ k, (T k).G C = (T 0).G C := fun k => by
    simp [T, o0_ne _ hC0, ints, hBC]
  have hTD : ∀ k, (T k).G D = (T 0).G D := fun k => by
    simp [T, o0_ne _ hD0, ints, hBD]
  have R := KFM.rptXV_runs (I := I) (iprog := iprog) hXA hAC hAD hCD hAK hCK hCK2 hCY hCB n T
    hTA hTC hTD b cs (fun k hk LA LC LD => by
      obtain ⟨a1, b1, c1, d1⟩ := hzk k (by omega)
      obtain ⟨z2, a2, b2, c2, d2, R2⟩ := H k hk (cf3 s1 A C D LA LC LD) (hQc s1 LA LC LD hQ) (zk k) l _ a1 c1 b1 d1
      have e2 : z2 = zk (k + 1) := RecRep_unique a2 (hzk (k + 1) (by omega)).1
      simp only [T]
      rw [cf3_encK_o0 hA0 hC0 hD0, cf3_encK_o0 hA0 hC0 hD0, ← hBc, ← hBc, ← e2]
      exact R2) LX (by simp [T, o0_ne _ hX0, ints, hX])
  obtain ⟨a1, b1, c1, d1⟩ := hzk n le_rfl
