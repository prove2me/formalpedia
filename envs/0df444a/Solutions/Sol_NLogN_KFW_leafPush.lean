theorem HRef.fok {p p' : RS} {X : ℕ} (h : HRef p p' X) : KFD.fok p = true → KFD.fok p' = true := by
  induction h with
  | refl => exact id
  | seq _ _ ha hb =>
    intro hf; simp only [KFD.fok, Bool.and_eq_true] at hf ⊢; exact ⟨ha hf.1, hb hf.2⟩
  | ite _ _ ha hb =>
    intro hf; simp only [KFD.fok, Bool.and_eq_true] at hf ⊢; exact ⟨ha hf.1, hb hf.2⟩
  | push => intro _; rfl
  | mono _ _ ih => exact ih

theorem fok_uni {σ : Fin HS → Option ℤ} {U O : RS} (hw : NoW σ U) {X : ℕ}
    (hO : HRef O (RS.sub σ U) X) (hf : KFD.fok O = true) : KFD.fok U = true :=
  fok_of_sub σ U hw (hO.fok hf)

theorem encK_upd_bg (s : IState HS) (f : Fin HS → List ℤ) (i : Fin HS) (hi : f i = []) (L : List Item) :
    (encK s f).upd i L = encK (s.upd i L) f := by
  refine IState.ext' (fun j => ?_) rfl rfl
  simp only [IState.upd_G, encK_G, Function.update_apply]
  split_ifs with h
  · subst h; simp [hi]
  · rfl

theorem encK_pushSt (s : IState HS) (f : Fin HS → List ℤ) :
    ∀ l : List (Fin HS × ℤ), (∀ p ∈ l, f p.1 = []) → pushSt (encK s f) l = encK (pushSt s l) f
  | [], _ => rfl
  | (i, v) :: l, h => by
    have hi : f i = [] := h (i, v) List.mem_cons_self
    simp only [pushSt]
    have e : (encK s f).upd i (.int v :: (encK s f).G i) = encK (s.upd i (.int v :: s.G i)) f := by
      rw [encK_upd_bg s f i hi]; simp [hi]
    rw [e]
    exact encK_pushSt _ f l (fun p hp => h p (List.mem_cons_of_mem _ hp))

theorem agree_pushSt {σ : Fin HS → Option ℤ} (t : IState HS) (l : List (Fin HS × ℤ))
    (hnd : (l.map Prod.fst).Nodup) (hσ : ∀ i v, σ i = some v → (i, v) ∈ l) : Agree σ (pushSt t l) := by
  intro i v hv
  have hm := hσ i v hv
  clear hσ
  refine ⟨t.G i, ?_⟩
  rw [pushSt_G]
  have hf : l.filter (fun p => p.1 = i) = [(i, v)] := by
    induction l with
    | nil => simp at hm
    | cons p l ih =>
      obtain ⟨j, u⟩ := p
      simp only [List.map_cons, List.nodup_cons, List.mem_map] at hnd
      rcases List.mem_cons.1 hm with h | h
      · cases h
        rw [List.filter_cons_of_pos (by simp), List.filter_eq_nil_iff.2]
        intro q hq hq'
        exact hnd.1 ⟨q, hq, by simpa using hq'⟩
      · have hj : j ≠ i := fun e => hnd.1 ⟨(i, v), h, by simp [e]⟩
        rw [List.filter_cons_of_neg (by simpa using hj)]
        exact ih hnd.2 h
  rw [hf]; simp [ints]

theorem evalP_fst' (t : IState HS) (l : List (Fin HS × Ex HS)) : (evalP t l).map Prod.fst = l.map Prod.fst := by
  simp [evalP, List.map_map, Function.comp_def]

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

end NLogN.KFW

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFW
open IntMul RS KFD KIL
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution {pl : List (Fin NLogN.HS × NLogN.Ex NLogN.HS)} {U O : NLogN.RS} {σ : Fin NLogN.HS → Option ℤ} {X : ℕ}
    (hσ : NLogN.KFW.SClean σ) (hw : NLogN.KFW.NoW σ U) (hO : NLogN.KFW.HRef O (NLogN.KFW.RS.sub σ U) X) (hfo : NLogN.KFD.fok O = true)
    (s : NLogN.IState NLogN.HS) (f : Fin NLogN.HS → List ℤ) (Bb : ℕ)
    (hpl : NLogN.KIL.PushOK (NLogN.KIL.encK s f) Bb pl) (hv : ∀ q ∈ pl, NLogN.zsz (q.2.eval (NLogN.KIL.encK s f)) ≤ Bb)
    (h0 : (0 : Fin NLogN.HS) ∉ pl.map Prod.fst) (hnd : (pl.map Prod.fst).Nodup)
    (hfe : ∀ q ∈ pl, f q.1 = [])
    (hag : ∀ i v, σ i = some v → (i, v) ∈ NLogN.KIL.evalP (NLogN.KIL.encK s f) pl)
    (ys : List ℤ) {c : ℕ}
    (H : NLogN.KFD.FSp O (NLogN.KIL.encK (NLogN.KIL.pushSt s (NLogN.KIL.evalP (NLogN.KIL.encK s f) pl)) f)
      (NLogN.KIL.encK (NLogN.KIL.pushSt s (NLogN.KIL.evalP (NLogN.KIL.encK s f) pl)) (Function.update f 0 ys)) c) :
    NLogN.IRuns I iprog (NLogN.KFD.withPushI pl (NLogN.KFD.fcode U)) (NLogN.KIL.encK s f) (NLogN.KIL.encK s (Function.update f 0 ys))
      (NLogN.KIL.pushCost Bb pl + 400 * (c + X) + (pl.length * (2 * Bb + 2) + 1)) := by
  set vals := NLogN.KIL.evalP (NLogN.KIL.encK s f) pl with hvals
  have hfst : vals.map Prod.fst = pl.map Prod.fst := NLogN.KFW.evalP_fst' _ _
  have hfe' : ∀ p ∈ vals, f p.1 = [] := by
    intro p hp
    have : p.1 ∈ pl.map Prod.fst := by rw [← hfst]; exact List.mem_map_of_mem hp
    obtain ⟨q, hq, e⟩ := List.mem_map.1 this
    rw [← e]; exact hfe q hq
  have hPS : NLogN.KIL.pushSt (NLogN.KIL.encK s f) vals = NLogN.KIL.encK (NLogN.KIL.pushSt s vals) f := NLogN.KFW.encK_pushSt s f vals hfe'
  have h0' : (0 : Fin NLogN.HS) ∉ vals.map Prod.fst := by rw [hfst]; exact h0
  have hG0 : (NLogN.KIL.pushSt s vals).G 0 = s.G 0 := NLogN.KIL.pushSt_G_of_not_mem s 0 vals h0'
  have hag' : NLogN.KFW.Agree σ (NLogN.KIL.encK (NLogN.KIL.pushSt s vals) f) := by
    rw [← hPS]
    exact NLogN.KFW.agree_pushSt _ vals (by rw [hfst]; exact hnd) hag
  have HU := (NLogN.KFW.FSp.uni hσ hw hO hag' H).irun (I := I) (iprog := iprog) (NLogN.KFW.fok_uni hw hO hfo)
  have eT : NLogN.KIL.encK s (Function.update f 0 ys) = (NLogN.KIL.encK s f).upd 0 (NLogN.ints ys ++ s.G 0) := by
    refine NLogN.IState.ext' (fun j => ?_) rfl rfl
    simp only [NLogN.KIL.encK_G, NLogN.IState.upd_G, Function.update_apply]
    split_ifs with h <;> simp [h]
  rw [eT]
  refine NLogN.KFD.IRuns.withPushI pl (NLogN.KFD.fcode U) (NLogN.KIL.encK s f) Bb hpl hv h0 ys (s.G 0) _ ?_
  rw [← hvals, hPS]
  have eB : NLogN.KIL.encK (NLogN.KIL.pushSt s vals) (Function.update f 0 ys) =
      (NLogN.KIL.encK (NLogN.KIL.pushSt s vals) f).upd 0 (NLogN.ints ys ++ s.G 0) := by
    refine NLogN.IState.ext' (fun j => ?_) rfl rfl
    simp only [NLogN.KIL.encK_G, NLogN.IState.upd_G, Function.update_apply]
    split_ifs with h
    · subst h; rw [hG0]
    · rfl
  rw [← eB]; exact HU
end
