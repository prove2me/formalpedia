set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFUU.R6Crt

open IntMul KIL AModel NLogN.KFUU

/-! ## Shapes and maps -/

/-! ## The selector table -/

theorem Pv_const (Q : ℕ) : ∀ j, Pv (fun _ => Q) j = Q ^ j
  | 0 => by simp [Pv, vol]
  | j + 1 => by rw [Pv_succ, Pv_const Q j, pow_succ]

theorem cFd_sel {Q μ : ℕ} (hQ : 2 ≤ Q) (hμ : μ < Q) (k j : ℕ) :
    cFd (fun _ => Q) μ (Q ^ k) Q j = if j = k then μ else 0 := by
  unfold cFd
  rw [Pv_const]
  rcases lt_trichotomy j k with h | h | h
  · rw [if_neg (by omega), Nat.div_eq_of_lt (Nat.pow_lt_pow_right (by omega) h)]; simp
  · subst h; rw [if_pos rfl, Nat.div_self (by positivity), mul_one, Nat.mod_eq_of_lt hμ]
  · rw [if_neg (by omega), Nat.pow_div h.le (by omega)]
    obtain ⟨e, he⟩ : ∃ e, j - k = e + 1 := ⟨j - k - 1, by omega⟩
    rw [he, pow_succ, ← mul_assoc, Nat.mul_mod_left]

theorem lf_zero : ∀ (cs D : List ℕ), (∀ j (h : j < cs.length), cs[j] = 0) → KIL.lf cs D = 0
  | [], D, _ => by cases D <;> rfl
  | _ :: _, [], _ => rfl
  | a :: l, e :: E, h => by
    simp only [KIL.lf]
    have ha := h 0 (by simp)
    simp only [List.getElem_cons_zero] at ha
    rw [ha, zero_mul, zero_add]
    exact lf_zero l E (fun j hj => by have := h (j + 1) (by simp; omega); simpa using this)

theorem lf_sel (cs D : List ℕ) (k μ : ℕ) (h1 : k < cs.length) (h2 : k < D.length)
    (hc : ∀ j (h : j < cs.length), cs[j] = if j = k then μ else 0) : KIL.lf cs D = μ * D[k] := by
  induction cs generalizing D k with
  | nil => simp at h1
  | cons c cs ih =>
    cases D with
    | nil => simp at h2
    | cons d D =>
      simp only [KIL.lf]
      have e0 := hc 0 (by simp)
      cases k with
      | zero =>
        simp only [List.getElem_cons_zero, if_true] at e0
        rw [e0, lf_zero cs D (fun j hj => by have := hc (j + 1) (by simp; omega); simpa using this)]
        simp
      | succ k =>
        simp only [List.getElem_cons_zero, if_neg (show (0 : ℕ) ≠ k + 1 by omega)] at e0
        rw [e0, zero_mul, zero_add, ih D k (by simp at h1; omega) (by simp at h2; omega)
          (fun j hj => by have := hc (j + 1) (by simp; omega); simpa using this)]
        simp

/-- **The pull map of `rotDU` with equal sizes and `D = Q^k` is the shear `shr`.** -/
theorem rotG_shr {Q μ i k : ℕ} (hQ : 2 ≤ Q) (hμ : μ < Q) (hk : k < i) {b : List ℕ}
    (hb : i < b.length) :
    KFU.rotG i Q (fun a => KIL.lf (csUd (fun _ => Q) μ (Q ^ k) Q i) a % Q) b = shr Q i k μ b := by
  have hl : KIL.lf (csUd (fun _ => Q) μ (Q ^ k) Q i) (b.take i) = μ * b.getD k 0 := by
    rw [lf_sel _ _ k μ (by simp [csUd]; omega) (by simp; omega)]
    · rw [List.getElem_take, List.getD_eq_getElem _ _ (by omega)]
    · intro j hj
      simp only [csUd, List.getElem_map, List.getElem_range]
      exact cFd_sel hQ hμ k j
  unfold KFU.rotG shr
  dsimp only
  rw [hl, List.set_eq_take_append_cons_drop, if_pos hb]

/-! ## Digits -/

theorem getD_shr (Q i k μ : ℕ) (b : List ℕ) (p : ℕ) :
    (shr Q i k μ b).getD p 0 =
      if p = i ∧ i < b.length then (b.getD i 0 + Q - μ * b.getD k 0 % Q) % Q else b.getD p 0 := by
  by_cases hp : p = i ∧ i < b.length
  · obtain ⟨rfl, hi⟩ := hp
    rw [if_pos ⟨rfl, hi⟩]
    simp [shr, List.getD_eq_getElem?_getD, List.getElem?_set, hi]
  · rw [if_neg hp]
    simp only [shr, List.getD_eq_getElem?_getD, List.getElem?_set]
    by_cases h : i = p
    · subst h
      rw [if_pos rfl, if_neg (fun h' => hp ⟨rfl, h'⟩), List.getElem?_eq_none (by omega)]
    · rw [if_neg h]

theorem length_shr (Q i k μ : ℕ) (b : List ℕ) : (shr Q i k μ b).length = b.length := by
  simp [shr]

theorem valid_shr {n Q : ℕ} {T : Shape} (hQ : 1 ≤ Q) {i k μ : ℕ} (hi : i < n) {b : List ℕ}
