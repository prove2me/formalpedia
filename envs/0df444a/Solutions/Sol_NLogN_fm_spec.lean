theorem one_le_zsz {z : ℤ} (h : z ≠ 0) : 1 ≤ zsz z := by
  by_contra h'
  have : zsz z ≤ 0 := by omega
  rw [zsz_le_iff] at this
  simp at this
  exact h this

/-- The cost of the small case. -/
theorem fmBase_cost (N : ℕ) (hN1 : 1 ≤ N) (hl : fmL N < fmThr) :
    1000 * (fmL N + 1) ^ 2 + 1000 * (fmL N + 15) + 25 + (2 * (fmL N + 13) + 2) +
      (smulCost (2 * N + 2) + 20000 * (N + 3)) + 2 ≤ fmPhi N := by
  have hNlt : N < 2 ^ 2048 := by
    have : zsz (N : ℤ) ≤ 2048 := by simp only [fmL, fmThr] at hl; omega
    rw [zsz_le_iff] at this; simpa using this
  have hl1 : 1 ≤ fmL N := NLogN.one_le_zsz (by omega)
  have hlam : 1 ≤ fmLam N := NLogN.one_le_zsz (by
    have : 1 ≤ fmL N ^ 4 := Nat.one_le_pow _ _ hl1
    omega)
  have hlN : fmL N ≤ N := le_trans (zsz_natCast_le_self N) le_rfl
  simp only [fmThr] at hl
  have hPhi : fmA * N ≤ fmPhi N := by
    unfold fmPhi
    calc fmA * N = fmA * N * 1 * 1 := by ring
      _ ≤ fmA * N * fmL N * fmLam N := by gcongr
  refine le_trans ?_ hPhi
  generalize hX : (2 : ℕ) ^ 2048 = X at hNlt
  have hA : fmA = 2 ^ 52 * X := by rw [fmA, ← hX, ← pow_add]
  rw [hA]
  simp only [smulCost]
  have hNN : N * N ≤ X * N := Nat.mul_le_mul_right _ hNlt.le
  have h52 : (2 : ℕ) ^ 52 ≥ 10 ^ 9 := by norm_num
  nlinarith

end NLogN

