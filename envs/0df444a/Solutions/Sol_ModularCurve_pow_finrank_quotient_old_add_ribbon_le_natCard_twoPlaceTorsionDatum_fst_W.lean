theorem first_leg_generic
    (𝒥 : TwoPlaceTorsionDatum p D₁ H₁ D₂ H₂ A₁ A₂) {q' : ℕ} [Fact q'.Prime] (hq' : q'.Prime)
    (hL : 𝒥.fst.LocalLaws q')
    (𝔪 : Ideal HeckeAlg) (hmax : 𝔪.IsMaximal) (hp : (p : HeckeAlg) ∈ 𝔪)
    (hnew : heckeGen ⟨q', hq'⟩ ^ 2 - 1 ∈ 𝔪) (hq'1 : ¬ (p : ℤ) ∣ (q' : ℤ) - 1)
    (hA₁ : A₁.LiesOverPrime q')
    {Yo : Type} [AddCommGroup Yo] [Module HeckeAlg Yo] [Module.Finite ℤ Yo]
    (eY : Yo ≃+ ↥(ribbonKernel D₁))
    (hY : ∀ (ℓ : Nat.Primes) (m : Yo), eY (heckeGen ℓ • m) = heckeKernelMap H₁ ℓ (eY m))
    (dX : ℕ)
    (h69 : ∀ (h : HeckeAlg →+* Module.End ℤ (ribbonComponentGroup D₁)),
      (∀ (ℓ : Nat.Primes) (φ : Module.Dual ℤ ↥(ribbonKernel D₁)),
          h (heckeGen ℓ) (ribbonComponentGroupProj D₁ φ) = ribbonComponentGroupProj D₁ (φ ∘ₗ heckeKernelMap H₁ ℓ)) →
        (letI : Module HeckeAlg (ribbonComponentGroup D₁) := Module.compHom _ h
         Module.finrank (HeckeAlg ⧸ 𝔪) ↥(heckeTorsion (ribbonComponentGroup D₁) 𝔪)) = dX) :
    Nat.card (HeckeAlg ⧸ 𝔪) ^ (dX + Module.finrank (HeckeAlg ⧸ 𝔪) (Yo ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Yo)))) ≤
      Nat.card ↥(𝒥.fst.W 𝔪) := by
  classical
  haveI := hmax
  have hpp : p.Prime := Fact.out

  have hst₁ : StdStable 𝒥.fst.D 𝒥.fst.H := stdStable_of_localLaws 𝒥.fst hL
  let hΨ₁ : HeckeAlg →+* Module.End ℤ (ribbonComponentGroup D₁) := stdHecke hst₁
  have hgen₁ : ∀ (ℓ : Nat.Primes) (φ : Module.Dual ℤ ↥(ribbonKernel D₁)),
      hΨ₁ (heckeGen ℓ) (ribbonComponentGroupProj D₁ φ) = ribbonComponentGroupProj D₁ (φ ∘ₗ heckeKernelMap H₁ ℓ) :=
    fun ℓ φ => stdHecke_heckeGen_proj hst₁ ℓ φ
  letI modΨ₁ : Module HeckeAlg (ribbonComponentGroup D₁) := Module.compHom _ hΨ₁
  have hdX : Module.finrank (HeckeAlg ⧸ 𝔪) ↥(heckeTorsion (ribbonComponentGroup D₁) 𝔪) = dX := h69 hΨ₁ hgen₁

  have hEA : Nat.card ↥𝒥.fst.toric * Nat.card {ψ : ribbonComponentGroup D₁ // ∀ x ∈ 𝔪, hΨ₁ x ψ = 0} =
      Nat.card {t : 𝒥.fst.T // t ∈ 𝒥.fst.invariants ∧ ∀ x ∈ 𝔪, 𝒥.fst.hecke x t ∈ 𝒥.fst.toric} :=
    groth_count 𝒥.fst 𝔪 hp hL.toric_hecke hL.toric_le_invariants hL.sp_eq_zero_iff hL.mem_range_sp_iff hΨ₁
      (hL.sp_hecke_ringHom hΨ₁ hgen₁)

  have eT : {ψ : ribbonComponentGroup D₁ // ∀ x ∈ 𝔪, hΨ₁ x ψ = 0} ≃ ↥(heckeTorsion (ribbonComponentGroup D₁) 𝔪) :=
    Equiv.subtypeEquivRight (fun ψ => (mem_heckeTorsion_iff (ribbonComponentGroup D₁) 𝔪 ψ).symm)

  obtain ⟨φ₁, hφ₁⟩ := ValuationSubring.exists_isFrobeniusAt_of_liesOverPrime hq' A₁ hA₁
  have hinc : ((q' : HeckeAlg) - 1) * heckeGen ⟨q', hq'⟩ ∉ 𝔪 := not_mem_incongruent 𝔪 hpp hp hq' hnew hq'1
  have hφsub : ∀ t : 𝒥.fst.T, t ∈ 𝒥.fst.toric →
      𝒥.fst.gal φ₁ t = 𝒥.fst.hecke ((q' : HeckeAlg) * heckeGen ⟨q', hq'⟩) t :=
    hL.frobenius_toric φ₁ hφ₁
  have hφquot : ∀ t : 𝒥.fst.T, 𝒥.fst.gal φ₁ t - 𝒥.fst.hecke (heckeGen ⟨q', hq'⟩) t ∈ 𝒥.fst.toric :=
    hL.frobenius_quot φ₁ hφ₁
  have hR1 := CerednikDrinfeld.JPrimeTorsionDatum.natCard_toric_inf_W_mul_natCard_smul_mem_toric_le_of_gal_eq_hecke_of_not_mem
    𝒥.fst q' hq' 𝔪 hL.toric_hecke φ₁ hφsub hφquot hinc

  have hK1 := CerednikDrinfeld.JPrimeTorsionDatum.natCard_toric_inf_W_eq_pow_finrank_quotient
    𝒥.fst hL.toric_hecke hL.toricEquiv_hecke 𝔪 hp eY hY

  have ha : 0 < Nat.card ↥𝒥.fst.toric := Nat.card_pos
  have hPI_le : Nat.card {t : 𝒥.fst.T // t ∈ 𝒥.fst.invariants ∧ ∀ x ∈ 𝔪, 𝒥.fst.hecke x t ∈ 𝒥.fst.toric} ≤
      Nat.card {t : 𝒥.fst.T // ∀ x ∈ 𝔪, 𝒥.fst.hecke x t ∈ 𝒥.fst.toric} :=
    Nat.card_le_card_of_injective (fun t => ⟨t.1, t.2.2⟩)
      (fun a b h => Subtype.ext (by have h' := congrArg Subtype.val h; exact h'))
  have key : Nat.card ↥(𝒥.fst.toric ⊓ 𝒥.fst.W 𝔪) * Nat.card {ψ : ribbonComponentGroup D₁ // ∀ x ∈ 𝔪, hΨ₁ x ψ = 0} ≤
      Nat.card ↥(𝒥.fst.W 𝔪) :=
    numeric ha hEA hPI_le hR1

  letI kf : Field (HeckeAlg ⧸ 𝔪) := Ideal.Quotient.field 𝔪
  have hΨne : Nat.card {ψ : ribbonComponentGroup D₁ // ∀ x ∈ 𝔪, hΨ₁ x ψ = 0} ≠ 0 := by
    intro h0
    haveI : Nonempty {t : 𝒥.fst.T // t ∈ 𝒥.fst.invariants ∧ ∀ x ∈ 𝔪, 𝒥.fst.hecke x t ∈ 𝒥.fst.toric} :=
      ⟨⟨0, zero_mem _, fun x _ => by rw [map_zero]; exact zero_mem _⟩⟩
    have hPI : 0 < Nat.card {t : 𝒥.fst.T // t ∈ 𝒥.fst.invariants ∧ ∀ x ∈ 𝔪, 𝒥.fst.hecke x t ∈ 𝒥.fst.toric} :=
      Nat.card_pos
    rw [← hEA, h0, mul_zero] at hPI
    exact lt_irrefl 0 hPI
  haveI : Finite {ψ : ribbonComponentGroup D₁ // ∀ x ∈ 𝔪, hΨ₁ x ψ = 0} := Nat.finite_of_card_ne_zero hΨne
  haveI : Finite ↥(heckeTorsion (ribbonComponentGroup D₁) 𝔪) := Finite.of_equiv _ eT
  have cΨ : Nat.card {ψ : ribbonComponentGroup D₁ // ∀ x ∈ 𝔪, hΨ₁ x ψ = 0} = Nat.card (HeckeAlg ⧸ 𝔪) ^ dX := by
    rw [Nat.card_congr eT, ← hdX]
    exact Module.natCard_eq_pow_finrank
  rw [hK1, cΨ, ← pow_add, add_comm] at key
  exact key

end Leg

