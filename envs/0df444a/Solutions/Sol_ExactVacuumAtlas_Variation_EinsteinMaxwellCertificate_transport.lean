open scoped ContDiff
open Matrix

namespace ExactVacuumAtlas

/-- Lorentzian signature is preserved under congruence by an invertible matrix. -/
theorem isLorentzian_pullback {m : ℕ} {H J K : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ}
    (hJK : J * K = 1) (h : IsLorentzian H) : IsLorentzian (Jᵀ * H * J) := by
  obtain ⟨E, _, hE⟩ := h
  refine isLorentzian_of_frame (K * E) ?_
  have hKJ : ∀ X : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ, Kᵀ * (Jᵀ * X) = X := fun X => by
    rw [← Matrix.mul_assoc, ← Matrix.transpose_mul, hJK, Matrix.transpose_one, Matrix.one_mul]
  have hJK' : ∀ X : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ, J * (K * X) = X := fun X => by
    rw [← Matrix.mul_assoc, hJK, Matrix.one_mul]
  calc (K * E)ᵀ * (Jᵀ * H * J) * (K * E) = Eᵀ * (Kᵀ * (Jᵀ * (H * (J * (K * E))))) := by
        simp only [Matrix.transpose_mul, Matrix.mul_assoc]
    _ = Eᵀ * (H * E) := by rw [hJK', hKJ]
    _ = eta m := by rw [← Matrix.mul_assoc, hE]

