def jS2 : RS := .seq tabP (.seq capP ccP)

def cJS2 (W N Q R lam w m : ℕ) : ℕ :=
  cTabP W Q R lam + (cCapP W N lam (lam * (2 * w + 1)) m + cCcP W N w m)

/-- The table stacks. -/
def tabSt (Q R s t lam α : ℕ) (c : Cs) : Cs :=
  update (update (update (update c SDI (diL Q R s t lam α).reverse) SDD
    (ddL Q R s t lam α).reverse) SGM (gamL Q R s t lam α).reverse) SGI (giL Q R s t lam α).reverse

