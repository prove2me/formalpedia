      · exact ⟨mbd, by decide, by rw [mev]; exact hzs _ hmA⟩) B4
  have B2 := NLogN.KFY.brk_all M [(NLogN.KFY.yB, NLogN.KFY.bitE)] _ u1 0 _ _ B 20 pk1 (by decide)
    (by
