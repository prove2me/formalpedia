-- Source module: Solutions.J6SegILPreJD5
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D5: the inner loops of `serP`

`Rn.czL` (border scan), `Rn.wbL` (band-window count), `Rn.cbL` (band-window push),
`Rn.cnL` (forward-window count), `Rn.fsL` (forward push): each as an `Rn` of a `forL` on
stack `51`, pushing its list (reversed) onto `41`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem frm_trans {A B C : List (Fin HS)} {u w w' : Vr} (h1 : ∀ i ∉ A, w i = u i)
    (h2 : ∀ i ∉ B, w' i = w i) (hA : ∀ i ∈ A, i ∈ C) (hB : ∀ i ∈ B, i ∈ C) :
    ∀ i ∉ C, w' i = u i := fun i hi => by
  rw [h2 i (fun h => hi (hB i h)), h1 i (fun h => hi (hA i h))]

theorem frm_upd {A : List (Fin HS)} {u w : Vr} (h : ∀ i ∉ A, w i = u i) {j : Fin HS} (hj : j ∈ A)
    (a : ℤ) : ∀ i ∉ A, update w j a i = u i := fun i hi => by
  rw [update_of_ne (by rintro rfl; exact hi hj)]; exact h i hi

theorem Fx.frm {Q kk m mw cB : ℕ} {A : List (Fin HS)} {u w : Vr} (h : Fx Q kk m mw cB u)
    (hf : ∀ i ∉ A, w i = u i) (hA : ∀ j ∈ ([9, 10, 11, 12, 21, 28] : List (Fin HS)), j ∉ A) :
    Fx Q kk m mw cB w := h.of (fun j hj => hf j (hA j hj))

theorem StS.upd {m : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ} {c : Cs} (h : StS m L Mf c) {j : Fin HS}
    (hj : j ≠ 14 ∧ j ≠ 30) (l : List ℤ) : StS m L Mf (update c j l) :=
  ⟨by rw [update_of_ne (Ne.symm hj.1)]; exact h.1, by rw [update_of_ne (Ne.symm hj.2)]; exact h.2⟩

theorem cFor_mono {W N N' cb : ℕ} (h : N ≤ N') : cFor W N cb ≤ cFor W N' cb := by
  unfold cFor; have := Nat.mul_le_mul_right (cb + cT (E.add (.r 0) (.k 1)).ex W + 8000 * (W + 3) + 30) h
  omega

theorem cnt_lt_le (p : ℕ → Prop) [DecidablePred p] {r : ℕ} (hp : ∀ q, p q → q < r) :
    ∀ m, ((List.range m).filter (fun q => p q)).length ≤ r
  | 0 => by simp
  | m + 1 => by
    have ih := cnt_lt_le p hp m
    rw [List.range_succ, List.filter_append, List.length_append]
    by_cases h : p m
    · have := hp m h
      have h2 : ((List.range m).filter (fun q => p q)).length ≤ m := by
        have := List.length_filter_le (fun q => decide (p q)) (List.range m); simpa using this
      simp [h]; omega
    · simp [h]; omega

theorem cnt_succ (p : ℕ → Prop) [DecidablePred p] (k : ℕ) :
    (((List.range (k + 1)).filter (fun q => p q)).length : ℤ) =
      (((List.range k).filter (fun q => p q)).length : ℤ) + (if p k then 1 else 0) := by
  rw [List.range_succ, List.filter_append, List.length_append]
  by_cases h : p k <;> simp [h]

theorem cnt_le_self (p : ℕ → Prop) [DecidablePred p] (k : ℕ) :
    ((List.range k).filter (fun q => p q)).length ≤ k := by
  have := List.length_filter_le (fun q => decide (p q)) (List.range k); simpa using this

theorem cwN_le (m mw cB : ℕ) (L : List ℕ) (r : ℕ) : cwN m mw cB L r ≤ r := by
  unfold cwN; split_ifs
  · exact le_rfl
  · exact cnt_lt_le _ (fun q h => h.1) m

section loops2
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ}

/-- **The forward-window count** of row `r`. -/
theorem Rn.cnL {u : Vr} {D : Cs} (hF : Fx Q kk m mw cB u) (hS : StS m L Mf D)
    (hB : BdS W m L Mf) (hLm : L.length = m) (hv : BV W u) {r : ℕ} (h5 : u 5 = r)
    (h4 : u 4 = Lg L r) (h3 : u 3 = 0) (hD51 : D 51 = []) (hmW : m + 1 ≤ 2 ^ W) :
    Rn (PJ.forL 51 28 2 (progL cnI)) u D (fun u' =>
      u' 3 = (((List.range m).filter (fun q => cwC mw L r q)).length : ℤ) ∧
      (∀ i ∉ ([2, 3, 7, 29] : List (Fin HS)), u' i = u i) ∧ BV W u') D
      (cFor W m (costL W (m * m + m) cnI)) := by
  have f28 : u 28 = m := hF.2.2.2.2.2
  set Iv : ℕ → Vr → Prop := fun k w =>
    (∀ i ∉ ([2, 3, 7, 29] : List (Fin HS)), w i = u i) ∧
      w 3 = (((List.range k).filter (fun q => cwC mw L r q)).length : ℤ) with hIv
  have hmlt : m < 2 ^ W := by omega
  have H := Rn.forL (C := 51) (rN := 28) (ix := 2) (b := progL cnI) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (N := m) (W := W) (Iv := Iv)
    (cf := fun _ => D) (cb := costL W (m * m + m) cnI) (fun k => hD51) hmlt
    (fun k hk w ⟨hfw, hw3⟩ hw2 hbw => by
      have hFw : Fx Q kk m mw cB w := hF.frm hfw (by decide)
      have hS' : StS m L Mf (update D 51 [(m : ℤ) - k]) := hS.upd (by decide) _
      have hw5 : w 5 = r := by rw [hfw 5 (by decide), h5]
      have hw4 : w 4 = Lg L r := by rw [hfw 4 (by decide), h4]
      have hcl := cnt_le_self (fun q => cwC mw L r q) k
      have H1 := Rn.cnIs hFw hS' hB hLm hbw hw5 hw2 hk hw4 hw3 (by omega)
      refine H1.mono (fun w' hw' => ?_) le_rfl
      obtain ⟨h3', hf1, hb1⟩ := hw'
      refine ⟨⟨frm_upd (frm_trans (C := [2, 3, 7, 29]) hfw hf1 (by decide) (by decide))
        (by decide) _, ?_⟩, by rw [hf1 2 (by decide), hw2], hb1⟩
      rw [update_of_ne (by decide), h3', cnt_succ]; rfl)
    hv f28 ⟨frm_upd (fun i _ => rfl) (by decide) _, by rw [update_of_ne (by decide), h3]; simp⟩
  exact H.mono (fun u' ⟨⟨hf, h3'⟩, _, hb⟩ => ⟨h3', hf, hb⟩) le_rfl

end loops2

end J6Seg.PJ

