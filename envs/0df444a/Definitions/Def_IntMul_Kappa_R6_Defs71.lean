section
-- Source module: Solutions.J6SegILPreJC13
/-!
# B5 set-up, part 13: polynomially bounded cost expressions

`PB S sz f`: `f a ≤ K (sz a + 1)^e` on `S`. Closed under constants, leaves `≤ sz`, `+ * ^ - /`;
the tactic `pb` decomposes a cost expression (a lambda in `a`) along these rules.
-/

set_option linter.unusedVariables false

namespace J6Seg.PJ

def PB {α : Type*} (S : Set α) (sz : α → ℕ) (f : α → ℕ) : Prop :=
  ∃ K e : ℕ, ∀ a ∈ S, f a ≤ K * (sz a + 1) ^ e

namespace PB
variable {α : Type*} {S : Set α} {sz : α → ℕ}

theorem const (c : ℕ) : PB S sz (fun _ => c) := ⟨c, 0, fun a _ => by simp⟩

theorem var {g : α → ℕ} (h : ∀ a ∈ S, g a ≤ sz a) : PB S sz g :=
  ⟨1, 1, fun a ha => by have := h a ha; simp only [pow_one, one_mul]; omega⟩

theorem lift {Y K e₁ e₂ : ℕ} (hY : 1 ≤ Y) (h : e₁ ≤ e₂) : K * Y ^ e₁ ≤ K * Y ^ e₂ :=
  Nat.mul_le_mul_left _ (Nat.pow_le_pow_right hY h)

theorem add {f g : α → ℕ} (hf : PB S sz f) (hg : PB S sz g) : PB S sz (fun a => f a + g a) := by
  obtain ⟨K₁, e₁, h₁⟩ := hf
  obtain ⟨K₂, e₂, h₂⟩ := hg
  refine ⟨K₁ + K₂, e₁ + e₂, fun a ha => ?_⟩
  have hY : 1 ≤ sz a + 1 := by omega
  have a1 := (h₁ a ha).trans (lift (K := K₁) hY (show e₁ ≤ e₁ + e₂ by omega))
  have a2 := (h₂ a ha).trans (lift (K := K₂) hY (show e₂ ≤ e₁ + e₂ by omega))
  show f a + g a ≤ _
  rw [add_mul]; omega

theorem mul {f g : α → ℕ} (hf : PB S sz f) (hg : PB S sz g) : PB S sz (fun a => f a * g a) := by
  obtain ⟨K₁, e₁, h₁⟩ := hf
  obtain ⟨K₂, e₂, h₂⟩ := hg
  refine ⟨K₁ * K₂, e₁ + e₂, fun a ha => ?_⟩
  calc f a * g a ≤ (K₁ * (sz a + 1) ^ e₁) * (K₂ * (sz a + 1) ^ e₂) := Nat.mul_le_mul (h₁ a ha) (h₂ a ha)
    _ = K₁ * K₂ * (sz a + 1) ^ (e₁ + e₂) := by ring

theorem pow {f : α → ℕ} (hf : PB S sz f) (m : ℕ) : PB S sz (fun a => f a ^ m) := by
  obtain ⟨K, e, h⟩ := hf
  refine ⟨K ^ m, e * m, fun a ha => ?_⟩
  calc f a ^ m ≤ (K * (sz a + 1) ^ e) ^ m := Nat.pow_le_pow_left (h a ha) m
    _ = K ^ m * (sz a + 1) ^ (e * m) := by rw [mul_pow, ← pow_mul]

theorem sub {f g : α → ℕ} (hf : PB S sz f) : PB S sz (fun a => f a - g a) := by
  obtain ⟨K, e, h⟩ := hf
  exact ⟨K, e, fun a ha => (Nat.sub_le _ _).trans (h a ha)⟩

theorem div {f g : α → ℕ} (hf : PB S sz f) : PB S sz (fun a => f a / g a) := by
  obtain ⟨K, e, h⟩ := hf
  exact ⟨K, e, fun a ha => (Nat.div_le_self _ _).trans (h a ha)⟩

theorem mono {f g : α → ℕ} (hf : PB S sz f) (h : ∀ a ∈ S, g a ≤ f a) : PB S sz g := by
  obtain ⟨K, e, h'⟩ := hf
  exact ⟨K, e, fun a ha => (h a ha).trans (h' a ha)⟩

theorem sqrt {f : α → ℕ} (hf : PB S sz f) : PB S sz (fun a => Nat.sqrt (f a)) :=
  hf.mono (fun a _ => Nat.sqrt_le_self _)

end PB

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegPreUB1
/-!
# B5 chunk side, part 14 (memory-light): the non-store costs are polynomial

Replaces `J6SegILPreJC14`. Same definitions and statements:
`restC pl W d NF Q kJ λ B n` (parameter phase, `cPre`, `cMid`, `cA3`, init / fini, distribution,
tear-down) is `≤ K (W + d + NF + Q + kJ + λ + B + n + 1)^e` (`restC_pb`), and
`cECn + 2 ≤ cCS2 + restC`, `cTear + 2 ≤ restC` (`cECn_split`, `cTear_le`).

The proof never unfolds concrete expression sizes: `cT e W`, `cA W l`, `cLoop`, `cRd`,
`costL` get generic `PB` composition lemmas (sizes of fixed expressions are constants).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

def restC (pl : Plan6) (W d NF Q kJ lam B n : ℕ) : ℕ :=
  (21 * 8001 + 1) + cPar pl.kA pl.kC pl.wA pl.wC W d NF Q kJ +
    cCPre pl.pkA pl.pkC pl.bA pl.bC W 0 lam + costL W 0 cMid + costL W 0 cA3 +
    (21 * (2 * (W + 1) + 2) + 1) + cDistAll B n + cTear B n + 4

def sumV {m : ℕ} (v : Fin m → ℕ) : ℕ := ∑ i, v i

namespace UB
variable {α : Type*} {S : Set α} {sz : α → ℕ}

theorem cT_pb (e : Ex HS) {W : α → ℕ} (hW : PB S sz W) : PB S sz (fun a => cT e (W a)) := by
  unfold cT cE; (with_reducible repeat (first | exact PB.const _ | assumption | refine PB.add ?_ ?_ | refine PB.mul ?_ ?_ | refine PB.pow ?_ _ | refine PB.sub ?_ | refine PB.div ?_ | refine PB.sqrt ?_))

theorem cA_pb {W : α → ℕ} (hW : PB S sz W) :
    ∀ l : List (Fin HS × E), PB S sz (fun a => cA (W a) l)
  | [] => by simp only [cA]; exact PB.const _
  | (_, e) :: l => by
    simp only [cA]
    exact PB.add (cT_pb e.ex hW) (cA_pb hW l)

theorem cLoop_pb {W N cb : α → ℕ} (hW : PB S sz W) (hN : PB S sz N) (hc : PB S sz cb) :
    PB S sz (fun a => cLoop (W a) (N a) (cb a)) := by
  unfold cLoop; (with_reducible repeat (first | exact PB.const _ | assumption | refine PB.add ?_ ?_ | refine PB.mul ?_ ?_ | refine PB.pow ?_ _ | refine PB.sub ?_ | refine PB.div ?_ | refine PB.sqrt ?_))

theorem cRd_pb {j B : α → ℕ} (hj : PB S sz j) (hB : PB S sz B) :
    PB S sz (fun a => cRd (j a) (B a)) := by
  unfold cRd; (with_reducible repeat (first | exact PB.const _ | assumption | refine PB.add ?_ ?_ | refine PB.mul ?_ ?_ | refine PB.pow ?_ _ | refine PB.sub ?_ | refine PB.div ?_ | refine PB.sqrt ?_))

theorem cRdK_pb (j : ℕ) {W : α → ℕ} (hW : PB S sz W) : PB S sz (fun a => cRdK j (W a)) := by
  unfold cRdK
  exact PB.add (cT_pb _ hW) (cRd_pb (PB.const _) hW)

/-- No `expNeg` call. -/
def NoEn : Ins → Prop
  | .en .. => False
  | _ => True

theorem lamF_pb {d : α → ℕ} (hd : PB S sz d) : PB S sz (fun a => lamF (d a)) := by
  unfold lamF kF; (with_reducible repeat (first | exact PB.const _ | assumption | refine PB.add ?_ ?_ | refine PB.mul ?_ ?_ | refine PB.pow ?_ _ | refine PB.sub ?_ | refine PB.div ?_ | refine PB.sqrt ?_))

end UB

open UB in
theorem cPar_pb {α : Type*} {S : Set α} {sz : α → ℕ} (kA kC wA wC : ℕ) {W d NF Q kJ : α → ℕ}
    (hW : PB S sz W) (hd : PB S sz d) (hNF : PB S sz NF) (hQ : PB S sz Q) (hk : PB S sz kJ) :
    PB S sz (fun a => cPar kA kC wA wC (W a) (d a) (NF a) (Q a) (kJ a)) := by
  have rd : ∀ j, PB S sz (fun a => cRdK j (W a)) := fun j => cRdK_pb j hW
  have ca : ∀ l, PB S sz (fun a => cA (W a) l) := fun l => cA_pb hW l
  have hl := lamF_pb hd
  unfold cPar cRdBlk cPh2 cPh3 cPh3a cPh3b
  refine PB.add ?_ (PB.add (PB.add ?_ (PB.add ?_ (PB.add ?_ ?_)))
    (PB.add (PB.add ?_ (PB.add ?_ (PB.add ?_ ?_))) (PB.add ?_ (PB.add ?_ ?_))))
  · exact PB.add (rd _) (PB.add (rd _) (PB.add (rd _) (PB.add (rd _) (PB.add (rd _)
      (PB.add (rd _) (rd _))))))
  · exact ca _
  · exact cLoop_pb hW (PB.add hd (PB.const 1)) (ca _)
  · exact ca _
  · exact cLoop_pb hW hl (ca _)
  · exact ca _
  · exact cLoop_pb hW hNF (ca _)
  · exact ca _
  · exact cLoop_pb hW hQ (ca _)
  · exact ca _
  · exact cLoop_pb hW hk (ca _)
  · exact ca _

end J6Seg.PJ

end

