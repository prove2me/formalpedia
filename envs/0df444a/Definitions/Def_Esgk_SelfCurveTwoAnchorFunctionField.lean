-- title:
--   The field generated by distances to two anchors
-- statement:
--   Over a field of characteristic zero, this defines the field generated by $(x+r)^2+y^2$ and $(x-r)^2+y^2$; for $r\ne0$ it contains $x,y^2$, and adjoining $y$ has degree at most two. If $r\ne0$, $x,y$ generate the ambient field and $y$ is not already in the distance-generated field, there is a nonidentity involution fixing $x$ and sending $y$ to $-y$.

-- Extracted dependency interfaces and their necessary proofs.
import Mathlib
import Mathlib.Algebra.CharP.IntermediateField
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
import Mathlib.FieldTheory.Minpoly.Field

