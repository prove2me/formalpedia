      ∃ (C : WeierstrassCurve.VariableChange (LaurentSeries ↥k₀)) (r : (WeierstrassCurve.DrinfeldGlobal.rigidDataPow ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ℓ' M' q hℓ hM 𝒢 𝒯).Raw ↥K),
