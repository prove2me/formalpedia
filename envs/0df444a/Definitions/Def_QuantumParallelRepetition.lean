      Integrable
        (fun s : ℝ =>
          weightedSpectralEntropyJensen weight F M positive hM s -
            weightedSpectralFilterVariance weight F M positive hM s)
        (volume.restrict (Ioi 0)) :=
    hentropy.sub hvariance
