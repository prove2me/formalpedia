-- title:
--   Čech cohomology of a presheaf on $M$ as a colimit over covers
-- statement:
--   For a presheaf $F$ of abelian groups on the open sets of $M$ and an open cover $\mathcal U$, a **Čech $n$-cochain** assigns to each tuple $(i_0,\dots,i_n)$ of members of $\mathcal U$ a section of $F$ on $U_{i_0}\cap\dots\cap U_{i_n}$, and the coboundary is
--   $$(\delta c)(i_0,\dots,i_{n+1})=\sum_{k=0}^{n+1}(-1)^k\,c(i_0,\dots,\widehat{i_k},\dots,i_{n+1})\big|.$$
--
--   **$H^n(M,F)$** is the colimit over covers: the direct sum over all covers of the groups of $n$-cocycles, modulo the subgroup generated by coboundaries and by the differences $z-\rho^*z$ for each refinement map $\rho:\mathcal V\to\mathcal U$. A cocycle $z$ on $\mathcal U$ has a class, `cechClass`.
--
--   The paper computes with such cocycles throughout. For $M$ paracompact and Hausdorff, this colimit is sheaf cohomology.
--
--   **Formalization Note.** Cochains are defined on all tuples, not only ordered or alternating ones, as in Mathlib's `cechComplexFunctor`. Mathlib's `Sheaf.H` has no map from Čech cocycles, so the Dixmier-Douady class could not be written against it.
-- source:
--   Murray, Stevenson, Bundle gerbes: stable isomorphism and local theory, arXiv:math/9908135v1, https://arxiv.org/abs/math/9908135v1, §2, p.3 (the cohomology groups in which d(P) lives)

import Mathlib
import Definitions.Def_BundleGerbeStable_Admissible

open TopologicalSpace DirectSum

namespace BundleGerbeStable

universe u

/-- A presheaf of abelian groups on the open sets of `M`. -/
structure AbPresheaf (M : Type u) [TopologicalSpace M] where
  /-- The group of sections on an open set. -/
  F : Opens M → Type u
  /-- The group structure on sections. -/
  [grp : ∀ U, AddCommGroup (F U)]
  /-- Restriction of sections. -/
  res : ∀ {U V : Opens M}, U ≤ V → F V →+ F U
  res_id : ∀ {U : Opens M} (s : F U), res le_rfl s = s
  res_comp : ∀ {U V W : Opens M} (h₁ : U ≤ V) (h₂ : V ≤ W) (s : F W),
    res h₁ (res h₂ s) = res (h₁.trans h₂) s

attribute [instance] AbPresheaf.grp

variable {M : Type u} [TopologicalSpace M]

/-- The intersection `U_{i₀} ∩ … ∩ U_{iₙ}` of a tuple of members of a set of open sets. -/
def inter {𝒰 : Set (Opens M)} {n : ℕ} (i : Fin n → 𝒰) : Opens M := ⨅ k, (i k).1

theorem inter_le_comp {𝒰 : Set (Opens M)} {n m : ℕ} (i : Fin n → 𝒰) (φ : Fin m → Fin n) :
    inter i ≤ inter (i ∘ φ) :=
  le_iInf fun k ↦ iInf_le (fun l ↦ (i l).1) (φ k)

theorem mem_of_mem_inter {𝒰 : Set (Opens M)} {n : ℕ} {i : Fin n → 𝒰} {x : M} (hx : x ∈ inter i)
    (k : Fin n) : x ∈ (i k).1 :=
  (iInf_le (fun l ↦ (i l).1) k : inter i ≤ (i k).1) hx

/-- Čech `n`-cochains of a cover with coefficients in `F`: a section on `U_{i₀} ∩ … ∩ U_{iₙ}` for each
tuple (all tuples, not only ordered or alternating ones, as in Mathlib's `cechComplexFunctor`). -/
abbrev Cochain (F : AbPresheaf M) (𝒰 : Cover M) (n : ℕ) : Type u :=
  ∀ i : Fin (n + 1) → 𝒰.1, F.F (inter i)

/-- The alternating Čech coboundary `(δ c)(i) = ∑ₖ (-1)ᵏ c(i with its k-th entry removed)|`. -/
def coboundary (F : AbPresheaf M) (𝒰 : Cover M) (n : ℕ) : Cochain F 𝒰 n →+ Cochain F 𝒰 (n + 1) :=
  AddMonoidHom.mk'
    (fun c i ↦ ∑ k : Fin (n + 2),
      ((-1 : ℤ) ^ (k : ℕ)) • F.res (inter_le_comp i k.succAbove) (c (i ∘ k.succAbove)))
    (fun c d ↦ by
      funext i
      simp [Finset.sum_add_distrib, smul_add])

/-- Čech `n`-cocycles. -/
abbrev Cocycle (F : AbPresheaf M) (𝒰 : Cover M) (n : ℕ) : AddSubgroup (Cochain F 𝒰 n) :=
  (coboundary F 𝒰 n).ker

/-- `c` is a Čech coboundary. There are no cochains in degree `-1`, so in degree `0` only `0` is. -/
def IsCoboundary (F : AbPresheaf M) (𝒰 : Cover M) : (n : ℕ) → Cochain F 𝒰 n → Prop
  | 0, c => c = 0
  | n + 1, c => ∃ b : Cochain F 𝒰 n, coboundary F 𝒰 n b = c

/-- Pull-back of a cochain along a refinement map `ρ : 𝒱 → 𝒰`. -/
def refineCochain (F : AbPresheaf M) {𝒰 𝒱 : Cover M} (ρ : 𝒱.1 → 𝒰.1) (hρ : ∀ V, V.1 ≤ (ρ V).1)
    {n : ℕ} (c : Cochain F 𝒰 n) : Cochain F 𝒱 n :=
  fun j ↦ F.res (le_iInf fun k ↦ (iInf_le (fun l ↦ (j l).1) k).trans (hρ (j k))) (c (ρ ∘ j))

open Classical in
/-- The subgroup of the direct sum over all covers of the `n`-cocycles, generated by the coboundaries
and by `of 𝒰 z − of 𝒱 (ρ* z)` for every refinement map `ρ : 𝒱 → 𝒰`. -/
noncomputable def cechRelations (F : AbPresheaf M) (n : ℕ) : AddSubgroup (⨁ 𝒰 : Cover M, Cocycle F 𝒰 n) :=
  AddSubgroup.closure
    ({x | ∃ (𝒰 : Cover M) (z : Cocycle F 𝒰 n), IsCoboundary F 𝒰 n z.1 ∧
        x = DirectSum.of (fun 𝒰 : Cover M ↦ Cocycle F 𝒰 n) 𝒰 z} ∪
     {x | ∃ (𝒰 𝒱 : Cover M) (ρ : 𝒱.1 → 𝒰.1) (hρ : ∀ V, V.1 ≤ (ρ V).1)
        (z : Cocycle F 𝒰 n) (z' : Cocycle F 𝒱 n), z'.1 = refineCochain F ρ hρ z.1 ∧
        x = DirectSum.of (fun 𝒰 : Cover M ↦ Cocycle F 𝒰 n) 𝒰 z -
          DirectSum.of (fun 𝒰 : Cover M ↦ Cocycle F 𝒰 n) 𝒱 z'})

/-- **Čech cohomology** `Hⁿ(M, F)`: the colimit over open covers of the Čech cohomology of the covers
(Murray, Stevenson, *Bundle gerbes: stable isomorphism and local theory*, arXiv:math/9908135v1, §2, p.3,
which computes with Čech cocycles), presented as the direct sum of the cocycle groups modulo
coboundaries and refinement.

**Formalization Note.** Mathlib's `Sheaf.H` has no map from Čech cocycles, so the Dixmier-Douady class
could not be written against it. For paracompact Hausdorff `M` this colimit is sheaf cohomology. -/
abbrev cechH (F : AbPresheaf M) (n : ℕ) : Type u :=
  (⨁ 𝒰 : Cover M, Cocycle F 𝒰 n) ⧸ cechRelations F n

open Classical in
/-- The class in `Hⁿ(M, F)` of a cocycle on a cover. -/
noncomputable def cechClass (F : AbPresheaf M) {𝒰 : Cover M} {n : ℕ} (z : Cocycle F 𝒰 n) : cechH F n :=
  QuotientAddGroup.mk (DirectSum.of (fun 𝒰 : Cover M ↦ Cocycle F 𝒰 n) 𝒰 z)

end BundleGerbeStable


