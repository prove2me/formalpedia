-- title:
--   Integer count and weight data for 65,000-height bins
-- statement:
--   This definition records two integer tables for the 180 height bins beginning at $65000$ with width $1290$. The first table records a proposed positive-ordinate zero multiplicity bound $c_n$ for each bin, constant on each group of twelve. The second records an outward-rounded proposed upper bound $t_n/10^{21}$ on the corresponding contribution from both signs of the ordinate. These are data; their validity and relationship to the zeta zeros are separate theorems.
-- source:
--   Exact rational arithmetic data generated for the Tao five-primes Chebyshev-error reduction.

import Mathlib.Data.Nat.Basic

namespace TaoFivePrimes

/-- Candidate upper bounds on positive-zero multiplicities in each bin. -/
def sineBinCount65k (i : ℕ) : ℕ :=
  ([2313, 2358, 2382, 2425, 2447, 2470, 2492, 2514, 2516, 2539, 2559, 2561, 2581, 2604, 2606] : List ℕ).getD (i / 12) 0

