-- Source module: Solutions.KIL4Env
/-!
# KIL4: pushing computed parameters

* `Ex.congrG`: evaluation, side conditions, bounds and cost of an expression only depend on the
  stacks it reads.
* `pushes l` pushes the values of the expressions of `l` (each reading only stacks not pushed by
  `l`), `pops l` pops; `Sp.pushes`, `Sp.pops`.
* `powE`, `prodE`: products of parameters; `stgPush`: the pushes of the table stages
  (radix, control, suffix volume, radix·suffix volume), `stgPush_sp`: they establish `StgOK`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

/-! ## Pushes and pops -/

def pushes : List (Fin HS × Ex HS) → RS
  | [] => .skip
  | (i, e) :: l => .seq (.push i e) (pushes l)

/-- Pops in reverse order: `popsR [i₁, …, iₙ]` pops `iₙ, …, i₁`. -/
def popsR : List (Fin HS) → RS
  | [] => .skip
  | i :: l => .seq (popsR l) (.pop i)

/-- The state after pushing the values `l` (in order). -/
def pushSt (t : IState HS) : List (Fin HS × ℤ) → IState HS
  | [] => t
  | (i, v) :: l => pushSt (t.upd i (.int v :: t.G i)) l

def pushCost (Bb : ℕ) (l : List (Fin HS × Ex HS)) : ℕ :=
  (l.map fun p => (p.2.size + 1) * 10 ^ 7 * (Bb + 2) ^ 2).sum + 1

/-- A push list: every expression is clean, reads no pushed stack, is defined and bounded. -/
def PushOK (t : IState HS) (Bb : ℕ) (l : List (Fin HS × Ex HS)) : Prop :=
  ∀ p ∈ l, p.1.val < 56 ∧ p.2.Clean ∧ (∀ r ∈ p.2.regs, r ∉ l.map Prod.fst) ∧ p.2.ok t ∧
    p.2.Bnd t Bb

/-! ## Products of positive parameters -/

/-- Positive products of registers and literals. -/
def PosE (s : IState HS) : Ex HS → Prop
  | .reg i => s.IsInt i ∧ 1 ≤ s.top i
  | .lit c => 1 ≤ c
  | .mul a b => PosE s a ∧ PosE s b
  | _ => False

/-- Product of a list of expressions. -/
def prodE : List (Ex HS) → Ex HS
  | [] => .lit 1
  | e :: l => .mul e (prodE l)

/-- `e ^ n` as a product. -/
def powE (e : Ex HS) (n : ℕ) : Ex HS := prodE (List.replicate n e)

/-! ## The table stage pushes -/

/-- Pushes of the stages `l` (radix and control expressions), first stage first. -/
def stgPush : List (Ex HS × Ex HS) → List (Fin HS × Ex HS)
  | [] => []
  | (a, c) :: l => (sSA, a) :: (sSC, c) :: (sSM, prodE (l.map Prod.fst)) ::
      (sSAM, .mul a (prodE (l.map Prod.fst))) :: stgPush l

/-- Suffix volumes. -/
def sufV (suf : List (ℕ × ℕ)) : List (ℕ × ℕ) → List ℤ
  | [] => []
  | _ :: ac => (vol ((ac ++ suf).map Prod.fst) : ℤ) :: sufV suf ac

def sufAV (suf : List (ℕ × ℕ)) : List (ℕ × ℕ) → List ℤ
  | [] => []
  | x :: ac => ((x.1 * vol ((ac ++ suf).map Prod.fst) : ℕ) : ℤ) :: sufAV suf ac

/-- Evaluation of a push list. -/
def evalP (t : IState HS) (l : List (Fin HS × Ex HS)) : List (Fin HS × ℤ) :=
  l.map fun p => (p.1, p.2.eval t)

end NLogN.KIL

end

