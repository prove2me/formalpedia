namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

theorem VbH_mono (c : Cfg) {K t S0 r H E e B E' e' B' : ℕ} (hE : E' ≤ E) (he : e' ≤ e)
    (hB : B' ≤ B) : VbH c K t S0 r H E' e' B' ≤ VbH c K t S0 r H E e B := by
  unfold VbH
  have h1 : (E' + 1) ^ c.p ≤ (E + 1) ^ c.p := Nat.pow_le_pow_left (by omega) _
  have h2 : c.Aw * (E' + 1) ^ c.p ≤ c.Aw * (E + 1) ^ c.p := Nat.mul_le_mul_left _ h1
  have h3 : K * E' ≤ K * E := Nat.mul_le_mul_left _ hE
  have h4 : c.Wr * (B' * 2 ^ t * S0 * r) ≤ c.Wr * (B * 2 ^ t * S0 * r) :=
    Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _
      (Nat.mul_le_mul_right _ hB)))
  omega

/-! ## Side lemmas -/

theorem het_sub {e K t : ℕ} (hK : 1 ≤ K) (het : e - e % K + K ≤ t) (j : ℕ) :
    (e - K * j) - (e - K * j) % K + K ≤ t := by
  have h1 := Nat.mod_add_div (e - K * j) K
  have h2 := Nat.mod_add_div e K
  have h3 : (e - K * j) / K ≤ e / K := Nat.div_le_div_right (Nat.sub_le _ _)
  have h4 := Nat.mul_le_mul_left K h3
  omega

/-- The layout divisibilities at a node and its children (`F = E / m`). -/
theorem dvd_childG {W m E B S0 s G : ℕ} (hW : 1 ≤ W) (hm : 1 ≤ m) (hE : 2 * m ≤ E) (hs : s < m)
    (h : W ^ dep m E * 2 ^ (2 * ((E / m - 1) * G)) ∣ B) (hS : 2 ^ ((E / m - 1) * G) ∣ S0) :
    W ∣ B ∧ 2 ^ (2 * ((E / m - 1) * G)) ∣ B / W ∧
    W ^ dep m (s * (E / m)) * 2 ^ (2 * ((s * (E / m) / m - 1) * G)) ∣ B / W ∧
    2 ^ ((s * (E / m) / m - 1) * G) ∣ S0 := by
  have hd := dep_child hm hE hs
  have hF : s * (E / m) / m ≤ E / m :=
    Nat.div_le_of_le_mul (by
      have := Nat.mul_le_mul_right (E / m) hs.le
      first | exact this | (rw [mul_comm (E / m) m]; exact this))
  have hX : W * (W ^ dep m (s * (E / m)) * 2 ^ (2 * ((E / m - 1) * G))) ∣
      W ^ dep m E * 2 ^ (2 * ((E / m - 1) * G)) := by
    rw [← mul_assoc]
    refine mul_dvd_mul ?_ dvd_rfl
    rw [← pow_succ']; exact pow_dvd_pow W hd
  have hXB := dvd_trans hX h
  refine ⟨dvd_trans (dvd_mul_right W _) hXB, ?_, ?_, ?_⟩
  · exact dvd_trans (dvd_mul_left _ _) (Nat.dvd_div_of_mul_dvd hXB)
  · refine dvd_trans (mul_dvd_mul_left _ ?_) (Nat.dvd_div_of_mul_dvd hXB)
    exact pow_dvd_pow 2 (Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ (Nat.sub_le_sub_right hF 1)))
  · exact dvd_trans (pow_dvd_pow 2 (Nat.mul_le_mul_right _ (Nat.sub_le_sub_right hF 1))) hS

/-- A pushed frame keeps the registers outside its keys. -/
theorem σPush_frV_ne (σ σ' : Fin HS → Option ℤ) (l : List (Fin HS × NE)) {i : Fin HS}
    (hi : i ∉ l.map Prod.fst) : σPush σ' (frV σ l) i = σ' i :=
  σPush_ne _ _ _ (fun p hp e => hi (by rw [← frV_keys σ l, ← e]; exact List.mem_map_of_mem hp))

/-- The widths of the steps of a list. -/
theorem sum_dwStH (c : Cfg) (F : ℕ) : ∀ l : List (HStep (Fin c.Wr) c.m),
    (l.map (dwStH c (fun s => (c.Wr + 4) * c.G (s * F)) F)).sum ≤
      l.length * dwloc c.Wr c.A +
        (2 * c.Wr + 4) * ((l.filterMap HStep.width).map fun s => c.G (s * F)).sum +
        2 * c.Wr * (l.filterMap HStep.width).length
  | [] => by simp
  | a :: l => by
    have ih := sum_dwStH c F l
    rw [List.map_cons, List.sum_cons, List.filterMap_cons, List.length_cons]
    cases h : a.width with
    | none =>
      simp only [dwStH, h, Option.elim]
      rw [add_mul, one_mul]
      omega
    | some s =>
      simp only [dwStH, h, Option.elim, List.map_cons, List.sum_cons, List.length_cons]
      have e1 : (c.Wr + 4) * c.G (s * F) + (c.G (s * F) + 2) * c.Wr =
          (2 * c.Wr + 4) * c.G (s * F) + 2 * c.Wr := by ring
      rw [e1, mul_add (2 * c.Wr + 4), mul_add (2 * c.Wr)]
      have : 0 ≤ dwloc c.Wr c.A := Nat.zero_le _
      have e2 : (l.length + 1) * dwloc c.Wr c.A = l.length * dwloc c.Wr c.A + dwloc c.Wr c.A := by
        ring
      rw [e2]
      omega

/-- **The width recursion of a node.** -/
theorem width_node {c : Cfg} (hc : CfgOK c) {E : ℕ} (hE : 2 * c.m ≤ E) :
    (c.net.map (dwStH c (fun s => (c.Wr + 4) * c.G (s * (E / c.m))) (E / c.m))).sum +
      ((c.Wr + 4) * c.G (E % c.m) + (δv c E + 2) * 2) ≤ (c.Wr + 4) * c.G E := by
  set F := E / c.m with hFd
  have hsd := sum_dwStH c F c.net
  have hws : c.net.filterMap HStep.width = chWs c := rfl
  rw [hws] at hsd
  obtain ⟨X, h1, h2, h3⟩ := Gs_node_split (A := c.Aw) (p := c.p) (chWs c) hc.m1 hc.p1 hc.Aw1 hE hc.mom
  have hδ : cLH c + ((chWs c).map fun s => c.G (s * (E / c.m))).sum + c.G (E % c.m) ≤ c.G E :=
    Gs_node (A := c.Aw) (c := cLH c) (chWs c) hc.m1 hc.p1 hc.Ac hE hc.mom
  have h1' : 2 * ((chWs c).map fun s => c.G (s * (E / c.m))).sum ≤ X := h1
  have h3' : X + E % c.m ≤ c.G E := h3
  clear h1 h3
  have hG : c.G (E % c.m) = E % c.m :=
    Gs_lt (by have := Nat.mod_lt E (show c.m > 0 by have := hc.m1; omega); omega)
  have hAw := hc.Aw
  rw [hG] at hδ ⊢
  unfold δv
  rw [← hFd] at h1' hδ ⊢
  generalize ((chWs c).map fun s => c.G (s * F)).sum = SG at *
  generalize (c.net.map (dwStH c (fun s => (c.Wr + 4) * c.G (s * F)) F)).sum = sd at *
  generalize c.net.length * dwloc c.Wr c.A = L at *
  generalize (chWs c).length = nC at *
  generalize c.G E = GE at *
  generalize E % c.m = R at *
  generalize c.Wr = w at *
  have k1 : (w + 1) * (2 * SG) ≤ (w + 1) * X := Nat.mul_le_mul_left _ h1'
  have k2 : (w + 2) * (X + R) ≤ (w + 2) * GE := Nat.mul_le_mul_left _ h3'
  have a1 : (2 * w + 4) * SG = 2 * (w * SG) + 4 * SG := by ring
  have a2 : (w + 1) * (2 * SG) = 2 * (w * SG) + 2 * SG := by ring
  have a3 : (w + 1) * X = w * X + X := by ring
  have a4 : (w + 2) * (X + R) = w * X + w * R + 2 * X + 2 * R := by ring
  have a5 : (w + 2) * GE = w * GE + 2 * GE := by ring
  have a6 : (w + 4) * R = w * R + 4 * R := by ring
  have a7 : (w + 4) * GE = w * GE + 4 * GE := by ring
  have a8 : 2 * w * nC = 2 * (w * nC) := by ring
  omega

end IntMul.Kappa.R6.IL3H

