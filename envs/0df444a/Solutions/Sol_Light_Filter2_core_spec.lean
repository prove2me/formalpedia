    · -- the test holds: Q · G ≤ h · U, the group fails
      have hc' : Q * Gv t ≤ h * Uv := by
        have : (Q : ℤ) * (Gv t : ℤ) < (h : ℤ) * (Uv : ℤ) + 1 := by
