-- Source module: Solutions.KFMBig1
/-!
# KFM Big1: the setup phase of `bigE`

From the state after the reads (`readSt x y`, KFMK1), `setP` computes all run-time parameters:

1. `startP`: `n` from the ruler `2^n` on `kT1` (`nP`, KFMU5) and `b = lg n` (`lgP`, KFMU4), onto
   `zN`, `zB`;
2. `setupS` (KFMS3/S4): the §9.2 parameters on `zD … zMf`;
3. `parS`, `parQ` (KFMBig0): the registers `rS … rOne`;
4. `oP`: `2^{2n}` on `rO` by two IL shifts by the ruler `2^n`.

* **`setP_runs`**: the run, ending in the base state `baseSt n x y`.
* `regIdx`: the register stacks. **`BaseOK`**: what the later phases read from them. Any state
  that agrees with the base state on `regIdx` satisfies `BaseOK` (**`BaseOK.of_agree`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue RS KFT

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## Step 1 -/

/-! ## Step 4 -/

/-! ## The whole setup -/

/-! ## The base state -/

theorem Hold.of_agree {t u : IState HS} {r : Fin HS} {a : ℤ} (h : Hold u r a) (e : t.G r = u.G r) :
    Hold t r a := by
  obtain ⟨L, hL⟩ := h; exact ⟨L, by rw [e, hL]⟩

theorem BaseOK.of_agree {t u : IState HS} {n : ℕ} (h : BaseOK u n)
    (ha : ∀ r ∈ regIdx, t.G r = u.G r) : BaseOK t n := by
  have e : ∀ r, r ∈ regIdx → ∀ a, Hold u r a → Hold t r a := fun r hr a h' =>
    h'.of_agree (ha r hr)
  obtain ⟨⟨⟨h1, h2, h3, h4⟩, h5, h6, h7, h8, h9⟩, ⟨-, -, -, h10⟩, h11, h12, h13, h14, h15, h16, h17,
    h18, h19, h20, h21, h22, h23⟩ := h
  refine ⟨⟨⟨?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_⟩, ⟨⟨?_, ?_, ?_, ?_⟩, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  all_goals first
    | exact e _ (by decide) _ ‹_›
    | exact e _ (by decide) _ h1 | exact e _ (by decide) _ h2 | exact e _ (by decide) _ h3
    | exact e _ (by decide) _ h4 | exact e _ (by decide) _ h5 | exact e _ (by decide) _ h6
    | exact e _ (by decide) _ h7 | exact e _ (by decide) _ h8 | exact e _ (by decide) _ h9
    | exact e _ (by decide) _ h10

end NLogN.KFM

