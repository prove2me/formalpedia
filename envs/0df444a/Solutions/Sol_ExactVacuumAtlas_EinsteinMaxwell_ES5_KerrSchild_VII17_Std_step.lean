    ((continuous_const.sub (continuous_const.mul continuous_id)).tendsto 0)
  simpa using this.mono_left nhdsWithin_le_nhds

theorem ev_u (h : ℝ) : ∀ᶠ x in 𝓝[>] (0:ℝ), 1 - h * x ≠ 0 :=
  (tendsto_u h).eventually_ne one_ne_zero

