-- title:
--   Proof of Theorem 2: the first k columns of Yₖ and Sₖ are zero
-- statement:
--   Let $Y_0, S_0 \in \mathbb{R}^{n\times p}$ with $Y_0^TS_0$ symmetric positive definite, and let $Y_j, S_j$ be generated by (25)–(26). Then for all $1 \le k \le j \le p$,
--
--   $$
--   Y_j e_k = 0 \qquad\text{and}\qquad S_j e_k = 0 .
--   $$
--
--   The case $j = k$ says that step $k$ annihilates the $k$-th column; the case $j > k$ says that this sparsity propagates to all later steps, so the first $k$ columns of $Y_k$ and $S_k$ vanish. In particular $Y_p = S_p = 0$.
--
--   **Formalization Note** The column index `k : Fin p` is 0-based (the paper's $e_{k+1}$), so the paper's range $1 \le k \le j \le p$ becomes `k < j` and `j ≤ p`.
-- source:
--   Dahl, Andersen, A primal-dual interior-point algorithm for nonsymmetric exponential-cone optimization, Math. Program. 194 (2022), p. 358, §5, proof of Theorem 2 (sparsity observation)

import Mathlib
import Definitions.Def_ExpConeIPM_Secant_Recursion

namespace ExpConeIPM.Secant

open Matrix

/-- Dahl–Andersen, Math. Program. 194 (2022), §5, proof of Theorem 2, p. 358 (sparsity).
If Y₀ᵀS₀ is symmetric positive definite then Y_j e_k = S_j e_k = 0 whenever 1 ≤ k ≤ j ≤ p
(paper's 1-based e_k = `unitVec k` with 0-based `k`, so the condition reads `k < j ≤ p`):
the first k columns of Y_k and S_k are zero. -/
theorem sparsity {n p : ℕ} (Y₀ S₀ : Matrix (Fin n) (Fin p) ℝ) (hPD : (Y₀ᵀ * S₀).PosDef)
    (k : Fin p) (j : ℕ) (hkj : (k : ℕ) < j) (hjp : j ≤ p) :
    Ys Y₀ S₀ j *ᵥ unitVec k = 0 ∧ Ss Y₀ S₀ j *ᵥ unitVec k = 0 := by sorry

end ExpConeIPM.Secant
