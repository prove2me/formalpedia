theorem run_ip_out : ∀ (p : RS) (s : IState HS), (p.run s).ip = s.ip ∧ (p.run s).out = s.out
  | skip, s => ⟨rfl, rfl⟩
  | asg i e, s | push i e, s | pop i, s => by simp [NLogN.RS.run]
  | seq a b, s => by
    simp only [NLogN.RS.run]
