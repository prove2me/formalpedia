section math
variable (s : ℕ) (q : ℕ → Bool)

variable {s q}

theorem fA_succ (m : ℕ) : fA q (m + 1) = fA q m ++ (if q m then [m] else []) := by
  unfold fA; rw [List.range_succ, List.filter_append]; simp [List.filter_cons]

theorem fA_lt {m x : ℕ} (h : x ∈ fA q m) : x < m := by
  unfold fA at h; simp at h; exact h.1

theorem fA_split {m : ℕ} (hm : m ≤ s) : ∃ R, fA q s = fA q m ++ R ∧ ∀ x ∈ R, m ≤ x := by
  induction s, hm using Nat.le_induction with
  | base => exact ⟨[], by simp, by simp⟩
  | succ n hmn ih =>
    obtain ⟨R, hR, hRm⟩ := ih
    refine ⟨R ++ (if q n then [n] else []), by rw [fA_succ, hR, List.append_assoc], ?_⟩
    intro x hx
    rcases List.mem_append.1 hx with h | h
    · exact hRm x h
    · split_ifs at h <;> simp at h; omega

theorem take_cB {u : ℕ} : (fA q s).take (cB s q u) = fA q (min u s) := by
  obtain ⟨R, hR, -⟩ := fA_split (q := q) (min_le_right u s)
  rw [hR, cB, List.take_left]

theorem cB_succ (u : ℕ) :
    cB s q (u + 1) = cB s q u + (if u < s ∧ q u then 1 else 0) := by
  unfold cB
  by_cases hu : u < s
  · rw [min_eq_left (by omega : u + 1 ≤ s), min_eq_left hu.le, fA_succ]
    by_cases hq : q u <;> simp [hq, hu]
  · rw [min_eq_right (by omega : s ≤ u + 1), min_eq_right (by omega : s ≤ u)]
    simp [hu]

theorem mem_fA {u : ℕ} : u ∈ fA q s ↔ u < s ∧ q u := by
  unfold fA; simp

theorem cB_le (u : ℕ) : cB s q u ≤ (fA q s).length := by
  obtain ⟨R, hR, -⟩ := fA_split (q := q) (min_le_right u s)
  rw [cB, hR, List.length_append]; omega

theorem cB_top {u : ℕ} (hc : 0 < cB s q (u + 1)) :
    (fA q s)[cB s q (u + 1) - 1]'(by have := cB_le (s := s) (q := q) (u + 1); omega) ≤ u ∧
    ((fA q s)[cB s q (u + 1) - 1]'(by have := cB_le (s := s) (q := q) (u + 1); omega) = u ↔
      u < s ∧ q u) := by
  have hl := cB_le (s := s) (q := q) (u + 1)
  have hget : (fA q s)[cB s q (u + 1) - 1]'(by omega) =
      (fA q (min (u + 1) s))[cB s q (u + 1) - 1]'(by unfold cB at hc ⊢; omega) := by
    have h2 : ((fA q s).take (cB s q (u + 1)))[cB s q (u + 1) - 1]'(by simp; omega) =
        (fA q s)[cB s q (u + 1) - 1]'(by omega) := List.getElem_take
    rw [← h2]
    exact List.getElem_of_eq take_cB _
  rw [hget]
  have hmem := List.getElem_mem (l := fA q (min (u + 1) s)) (n := cB s q (u + 1) - 1)
    (by unfold cB at hc ⊢; omega)
  have hlt := fA_lt hmem
  refine ⟨by omega, ?_⟩
  by_cases hu : u < s ∧ q u
  · simp only [hu, and_self, iff_true]
    have e : fA q (min (u + 1) s) = fA q u ++ [u] := by
      rw [min_eq_left (by omega), fA_succ, if_pos hu.2]
    have hc' : cB s q (u + 1) - 1 = (fA q u).length := by
      unfold cB; rw [e, List.length_append]; simp
    simp only [e, hc']
    simp
  · simp only [hu, iff_false]
    intro heq
    have e : fA q (min (u + 1) s) = fA q (min u s) := by
      by_cases hs : u < s
      · rw [min_eq_left (by omega), min_eq_left hs.le, fA_succ, if_neg (by tauto)]; simp
      · rw [min_eq_right (by omega), min_eq_right (by omega)]
    have hmem' := List.getElem_mem (l := fA q (min (u + 1) s)) (n := cB s q (u + 1) - 1)
      (by unfold cB at hc ⊢; omega)
    rw [heq] at hmem'
    have : u ∈ fA q (min u s) := e ▸ hmem'
    have := fA_lt this
    omega

theorem idx_cB {u : ℕ} (hu : u < s ∧ q u) : (fA q s).idxOf u = cB s q u := by
  obtain ⟨R, hR, -⟩ := fA_split (q := q) (show u + 1 ≤ s by omega)
  rw [hR, fA_succ, if_pos hu.2, List.append_assoc, List.idxOf_append_of_notMem
    (fun h => by have := fA_lt h; omega)]
  simp [cB, min_eq_left hu.1.le]

theorem fA_len : (fA q s).length ≤ s := by
  unfold fA; exact (List.length_filter_le _ _).trans (by simp)

theorem top_eq {u c : ℕ} (hc : cB s q (u + 1) = c + 1) (h : c < (fA q s).length) :
    (fA q s)[c] ≤ u ∧ ((fA q s)[c] = u ↔ u < s ∧ q u) := by
  have key : ∀ i (hi : i < (fA q s).length), i = cB s q (u + 1) - 1 →
      (fA q s)[i] ≤ u ∧ ((fA q s)[i] = u ↔ u < s ∧ q u) := by
    rintro i hi rfl; exact cB_top (by omega)
  exact key c h (by omega)

end math

