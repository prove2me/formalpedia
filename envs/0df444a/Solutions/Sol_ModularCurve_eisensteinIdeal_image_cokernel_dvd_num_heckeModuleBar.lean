open ModularCurve AlgebraicCurve

private theorem eisensteinNumerator_int_ne_zero (p : ℕ) [Fact p.Prime] :
    (eisensteinNumerator p : ℤ) ≠ 0 := by
  have hp : 2 ≤ p := (Fact.out : p.Prime).two_le
  have h1 : 0 < p - 1 := by omega
  have hg : 0 < Nat.gcd (p - 1) 12 := Nat.gcd_pos_of_pos_left _ h1
  have hle : Nat.gcd (p - 1) 12 ≤ p - 1 := Nat.le_of_dvd h1 (Nat.gcd_dvd_left _ _)
  have h : 0 < eisensteinNumerator p := Nat.div_pos hle hg
  exact_mod_cast h.ne'

private theorem natAbs_div_gcd_eq_eisensteinNumerator (p : ℕ) [Fact p.Prime] :
    ((p : ℤ) - 1).natAbs / ((p : ℤ) - 1).gcd 12 = eisensteinNumerator p := by
  have hp : 1 ≤ p := (Fact.out : p.Prime).one_le
  have e : (p : ℤ) - 1 = ((p - 1 : ℕ) : ℤ) := by omega
  rw [e]
  rfl

theorem solution (p : ℕ)
    [Fact p.Prime] (hcomm : HeckeOperatorsCommuteBar p)
    (hJM : ∀ x : JZero p, heckeOperatorBar p ⟨p, Fact.out⟩ x + frickeInvolutionBar p • x = 0) :
    ∃ t ∈ eisensteinIdeal p, ∃ k : ℤ, k ≠ 0 ∧
      k.natAbs ∣ ((p : ℤ) - 1).natAbs / ((p : ℤ) - 1).gcd 12 ∧
      heckeEvalBar hcomm t = k • (1 : Module.End ℤ (JZero p)) := by
  have _ := hJM
  obtain ⟨i, hi, h⟩ :=
    ModularCurve.exists_mem_eisensteinIdeal_smul_eq_eisensteinNumerator_zsmul p
  refine ⟨i, hi, (eisensteinNumerator p : ℤ), eisensteinNumerator_int_ne_zero p, ?_, ?_⟩
  · rw [natAbs_div_gcd_eq_eisensteinNumerator, Int.natAbs_natCast]
  · ext x
    have hx := h x
    rw [heckeModuleBar_smul_def hcomm i x] at hx
    exact hx

end S_ModularCurve_eisensteinIdeal_image_cokernel_dvd_num_heckeModuleBar
