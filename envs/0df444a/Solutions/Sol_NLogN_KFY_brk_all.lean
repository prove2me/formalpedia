theorem solution (M : NLogN.MulSpec) (l : List (Fin NLogN.HS × NLogN.Ex NLogN.HS)) (P : NLogN.RM) (t : NLogN.IState NLogN.HS) (j : Fin NLogN.HS)
    (Z : List NLogN.Item) (C B K : ℕ) (hl : NLogN.KFY.PushOk l t) (hj : j ∉ l.map Prod.fst)
    (hB : ∀ p ∈ l, p.2.Bnd t B ∧ p.2.size ≤ K ∧ NLogN.zsz (p.2.eval t) ≤ B)
    (hP : P.run ((NLogN.KFY.pushL l).run t) = ((NLogN.KFY.pushL l).run t).upd j Z ∧ P.ok M ((NLogN.KFY.pushL l).run t) ∧
      P.cost M ((NLogN.KFY.pushL l).run t) ≤ C) :
    (NLogN.KFY.brk l P).run t = t.upd j Z ∧ (NLogN.KFY.brk l P).ok M t ∧
      (NLogN.KFY.brk l P).cost M t ≤ NLogN.KFY.brkC l.length K B C := by
  obtain ⟨k1, r1, f1, ip1, out1⟩ := NLogN.KFY.pushL_spec l t hl
  have c1 := NLogN.KFY.pushL_cost l t hl B K (fun p hp => ⟨(hB p hp).1, (hB p hp).2.1⟩)
  set t1 := (NLogN.KFY.pushL l).run t with ht1
  set t2 := t1.upd j Z with ht2
  have hpop : NLogN.KFY.PopOk (l.map Prod.fst) t2 B := by
    refine ⟨hl.nd, fun r hr => ?_⟩
    obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hr
    have hpj : p.1 ≠ j := fun e => hj (e ▸ hr)
    refine ⟨hl.lt p hp, p.2.eval t, t.G p.1, ?_, (hB p hp).2.2⟩
    simp only [ht2, NLogN.IState.upd_G, if_neg hpj]
    exact r1 p hp
  obtain ⟨k3, r3, ip3, out3, c3⟩ := NLogN.KFY.popL_spec _ t2 B hpop
  have e3 : (NLogN.KFY.popL (l.map Prod.fst)).run t2 = t.upd j Z := by
    apply NLogN.IState.ext' _ (by rw [ip3]; simp [ht2, ip1]) (by rw [out3]; simp [ht2, out1])
    intro x
    rw [r3 x]
    by_cases hx : x ∈ l.map Prod.fst
    · rw [if_pos hx]
      obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hx
      have hpj : p.1 ≠ j := fun e => hj (e ▸ hx)
      simp only [ht2, NLogN.IState.upd_G, if_neg hpj, r1 p hp, List.tail_cons]
    · rw [if_neg hx]
      by_cases hxj : x = j
      · subst hxj; simp [ht2]
      · simp only [ht2, NLogN.IState.upd_G, if_neg hxj, f1 x hx]
  have hl1 : (l.map Prod.fst).length = l.length := by simp
  rw [hl1] at c3
  have A1 : (NLogN.RM.rs (NLogN.KFY.pushL l)).run t = t1 ∧ (NLogN.RM.rs (NLogN.KFY.pushL l)).ok M t ∧
      (NLogN.RM.rs (NLogN.KFY.pushL l)).cost M t ≤ l.length * ((K + 1) * 10 ^ 7 * (B + 2) ^ 2) + 1 :=
    ⟨rfl, k1, c1⟩
  have A3 : (NLogN.RM.rs (NLogN.KFY.popL (l.map Prod.fst))).run t2 = t.upd j Z ∧
      (NLogN.RM.rs (NLogN.KFY.popL (l.map Prod.fst))).ok M t2 ∧
      (NLogN.RM.rs (NLogN.KFY.popL (l.map Prod.fst))).cost M t2 ≤ l.length * (2 * B + 2) + 1 := ⟨e3, k3, c3⟩
  have A23 := NLogN.GL.seq_all P _ t1 t2 _ C _ hP A3
  have H := NLogN.GL.seq_all _ _ t _ _ _ _ A1 A23
  refine ⟨H.1, H.2.1, le_trans H.2.2 ?_⟩
