theorem gΦ1 {b c : ℕ} (hb : b < 1771) (hc : c < 38286) : GoodM N (Φ₁ ch.S ch.Si b c) :=
  goodΦ₁ h.gS h.gSi (h.gPc c hc) (h.gPl b hb)

theorem gΦ2 {a c : ℕ} (ha : a < 1771) (hc : c < 38286) : GoodM N (Φ₂ ch.S ch.Si a c) :=
