set_option autoImplicit false
open TreeStack
open scoped BigOperators Classical
variable {α : Type*}
namespace TreeStack
theorem _root_.solution (gain : α → ℤ) :
    ∀ tasks : List α,
      taskGainSum gain tasks = (tasks.map gain).sum
  | [] => by simp [taskGainSum]
  | t :: ts => by
      simp [taskGainSum, solution gain ts]
end TreeStack
