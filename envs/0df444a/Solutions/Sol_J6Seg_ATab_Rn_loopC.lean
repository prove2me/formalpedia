-- Source module: Solutions.J6AILTab2
/-!
# A lines, table set-up, part 2: the input-scaling table loop

The register file during the table loop (`LV`):

    1 = 2p   2 = p/2   3 = s   4 = t   5 = 2^(2p)   6 = β = betaT (2p) α   7 = t³α²
    8 = H    9 = W     11 = t²α²   12 = 2^Q   20 = 2^pk   21 = 2^b   22 = jA   23 = b·2r

(`10` the loop count, `24` the block index, `25` the block offset `A0 = t (j_c - W) - s k_c`,
`26` the loop index, `28`, `29` scratch).

`loopA`: for `i < 2W`: `28 := (t-s)⁺ (A0 + t i)²; 29 := expNeg 2p (t³α²) 28; push 2^Q · 29`,
i.e. it pushes `aTabA … q` (`Rn.loopA`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

/-! ## Arithmetic -/

theorem natSub_cast (t s : ℕ) : ((t - s : ℕ) : ℤ) = if (t : ℤ) - s < 0 then 0 else (t : ℤ) - s := by
  split_ifs with h <;> omega

/-- Two updates of a stack and a counter commute. -/
theorem upd_push {c0 : Cs} {S C : Fin HS} (h : S ≠ C) (A : List ℤ) (x : List ℤ) (y : ℤ) :
    update (update (update c0 S A) C x) S (y :: (update (update c0 S A) C x) S) =
      update (update c0 S (y :: A)) C x := by
  rw [update_of_ne h, update_self]
  funext j; simp only [update_apply]; split_ifs <;> simp_all

/-! ## The body -/

theorem eTS_den {v : Vr} {s t : ℕ} (h3 : v 3 = s) (h4 : v 4 = t) : eTS.den v = ((t - s : ℕ) : ℤ) := by
  simp only [eTS, E.den, h3, h4, natSub_cast]

theorem T3_nm {j : Fin HS} (h : j ∉ ([26, 28, 29] : List (Fin HS))) : j ≠ 26 ∧ j ≠ 28 ∧ j ≠ 29 := by
  simp only [List.mem_cons, List.mem_nil_iff, or_false, not_or] at h; exact h

theorem lb_le {W : ℕ} {e : E} (h : e.lb ≤ 1) : e.lb ≤ 2 ^ W := le_trans h Nat.one_le_two_pow

end J6Seg.ATab

