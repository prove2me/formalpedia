namespace TsengCGD.ErrorBound.L7

/-- R1 (forward): an optimal solution of (42) satisfies the projection variational inequality. -/
theorem epi_vi {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {D : Set (TsengCGD.Global.Vec n)}
    {P : TsengCGD.Global.Vec n → ℝ} {c : ℝ} {x : TsengCGD.Global.Vec n} {ξ : ℝ}
    {d : TsengCGD.Global.Vec n} {δ : ℝ}
    (hD : Convex ℝ D) (hP : ConvexOn ℝ D P) (hs : IsEpiSubSol f D P c x ξ d δ)
    (d' : TsengCGD.Global.Vec n) (δ' : ℝ) (hd' : x + d' ∈ D) (hP' : P (x + d') ≤ ξ + δ') :
    0 ≤ ⟪gradient f x + d, d' - d⟫ + (c + δ) * (δ' - δ) := by
  obtain ⟨hmem, hle, hopt⟩ := hs
  set A := ⟪gradient f x + d, d' - d⟫ + (c + δ) * (δ' - δ) with hA
  set B := ‖d' - d‖ ^ 2 + (δ' - δ) ^ 2 with hB
  have hB0 : 0 ≤ B := by positivity
  have key : ∀ t : ℝ, 0 < t → t ≤ 1 → 0 ≤ t * A + t ^ 2 / 2 * B := by
    intro t ht0 ht1
    have hid : x + (d + t • (d' - d)) = (1 - t) • (x + d) + t • (x + d') := by
      simp only [sub_smul, one_smul, smul_add, smul_sub]; abel
    have hmemt : x + (d + t • (d' - d)) ∈ D := by
      rw [hid]; exact hD hmem hd' (by linarith) ht0.le (by ring)
    have hPt : P (x + (d + t • (d' - d))) ≤ ξ + (δ + t * (δ' - δ)) := by
      have hc := hP.2 hmem hd' (by linarith : (0:ℝ) ≤ 1 - t) ht0.le (by ring)
      rw [hid]; simp only [smul_eq_mul] at hc
      nlinarith [mul_le_mul_of_nonneg_left hle (by linarith : (0:ℝ) ≤ 1 - t),
        mul_le_mul_of_nonneg_left hP' ht0.le]
    have h := hopt (d + t • (d' - d)) (δ + t * (δ' - δ)) hmemt hPt
    unfold epiObj at h
    rw [inner_add_right, inner_smul_right, norm_add_sq_real, inner_smul_right, norm_smul,
      Real.norm_eq_abs, abs_of_pos ht0] at h
    rw [hA, hB, inner_add_left]
    nlinarith
  by_contra hneg
  push_neg at hneg
  set t := min 1 (-A / (B + 1)) with ht
  have hB1 : 0 < B + 1 := by linarith
  have ht0 : 0 < t := lt_min one_pos (div_pos (by linarith) hB1)
  have ht1 : t ≤ 1 := min_le_left _ _
  have ht2 : t ≤ -A / (B + 1) := min_le_right _ _
  have ht3 : t * (B + 1) ≤ -A := by rwa [le_div_iff₀ hB1] at ht2
  have := key t ht0 ht1
  nlinarith [mul_pos ht0 ht0]

end TsengCGD.ErrorBound.L7

namespace TsengCGD.ErrorBound.L7

open Filter Topology

/-- Directional derivative from differentiability. -/
theorem slope_tendsto {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {x : TsengCGD.Global.Vec n}
    (hf : DifferentiableAt ℝ f x) (d : TsengCGD.Global.Vec n) :
    Tendsto (fun α : ℝ => α⁻¹ * (f (x + α • d) - f x)) (𝓝[>] 0) (𝓝 ⟪gradient f x, d⟫) := by
  have h1 : HasDerivAt (fun α : ℝ => x + α • d) d 0 := by
    simpa using ((hasDerivAt_id (0:ℝ)).smul_const d).const_add x
  have h2 : HasDerivAt (fun α : ℝ => f (x + α • d)) (fderiv ℝ f x d) 0 := by
    have hh : HasFDerivAt f (fderiv ℝ f x) (x + (0:ℝ) • d) := by simpa using hf.hasFDerivAt
    exact hh.comp_hasDerivAt (0:ℝ) h1
  have h3 := h2.tendsto_slope_zero_right
  have hg : fderiv ℝ f x d = ⟪gradient f x, d⟫ := by
    simp [gradient, InnerProductSpace.toDual_symm_apply]
  rw [hg] at h3
  simpa [smul_eq_mul] using h3

theorem diffAt_of_standing {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {D : Set (TsengCGD.Global.Vec n)}
    {P : TsengCGD.Global.Vec n → ℝ} {c : ℝ} (hs : TsengCGD.Global.Standing f D P c)
    {x : TsengCGD.Global.Vec n} (hx : x ∈ D) : DifferentiableAt ℝ f x := by
  obtain ⟨U, hU, hDU, hcd⟩ := hs.smooth
  exact (hcd.differentiableOn one_ne_zero).differentiableAt (hU.mem_nhds (hDU hx))

/-- Stationarity is the variational inequality `⟪∇f x, y - x⟫ + c (P y - P x) ≥ 0` on `D`. -/
theorem stat_iff {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {D : Set (TsengCGD.Global.Vec n)}
    {P : TsengCGD.Global.Vec n → ℝ} {c : ℝ} (hs : TsengCGD.Global.Standing f D P c)
    (x : TsengCGD.Global.Vec n) :
    TsengCGD.Global.IsStationary f D P c x ↔
      x ∈ D ∧ ∀ y ∈ D, 0 ≤ ⟪gradient f x, y - x⟫ + c * (P y - P x) := by
  have hc := hs.c_pos
  obtain ⟨_, hDc, hPc, _⟩ := hs.properConvexLsc
  constructor
  · rintro ⟨hx, hst⟩
    refine ⟨hx, fun y hy => ?_⟩
    by_contra hneg
    push_neg at hneg
    set S := ⟪gradient f x, y - x⟫ + c * (P y - P x) with hS
    have hT := slope_tendsto (diffAt_of_standing hs hx) (y - x)
    have hev1 := hst (y - x) (-S / 2) (by linarith)
    have hev2 := (tendsto_order.1 hT).2 (⟪gradient f x, y - x⟫ - S / 4) (by linarith)
    have hev3 : ∀ᶠ α in 𝓝[>] (0:ℝ), α ∈ Set.Ioo (0:ℝ) 1 :=
      Ioo_mem_nhdsGT one_pos
    obtain ⟨α, h1, h2, ⟨hα0, hα1⟩⟩ := (hev1.and (hev2.and hev3)).exists
    have hid : x + α • (y - x) = (1 - α) • x + α • y := by
      simp only [smul_sub, sub_smul, one_smul]; abel
    have hmem : x + α • (y - x) ∈ D := by
      rw [hid]; exact hDc hx hy (by linarith) hα0.le (by ring)
    have hPle : P (x + α • (y - x)) ≤ (1 - α) * P x + α * P y := by
      rw [hid]; exact hPc.2 hx hy (by linarith) hα0.le (by ring)
    have k1 := h1 hmem
    unfold TsengCGD.Global.Fc at k1
    rw [le_div_iff₀ hα0] at k1
    rw [inv_mul_lt_iff₀ hα0] at h2
    nlinarith [mul_le_mul_of_nonneg_left hPle hc.le]
  · rintro ⟨hx, hvi⟩
    refine ⟨hx, fun d ε hε => ?_⟩
    have hT := slope_tendsto (diffAt_of_standing hs hx) d
    have hev2 := (tendsto_order.1 hT).1 (⟪gradient f x, d⟫ - ε) (by linarith)
    filter_upwards [hev2, self_mem_nhdsWithin] with α h2 hα0 hmem
    have hα0' : (0:ℝ) < α := hα0
    have k := hvi _ hmem
    rw [add_sub_cancel_left, inner_smul_right] at k
    rw [lt_inv_mul_iff₀ hα0'] at h2
    unfold TsengCGD.Global.Fc
    rw [le_div_iff₀ hα0']
    nlinarith

end TsengCGD.ErrorBound.L7

namespace TsengCGD.ErrorBound.L7

/-- R1': an optimal solution of (42) at `(x, P x)` is the projection residual in `ℝⁿ × ℝ`. -/
theorem proj_res {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {D : Set (TsengCGD.Global.Vec n)}
    {P : TsengCGD.Global.Vec n → ℝ} {c : ℝ} {x d : TsengCGD.Global.Vec n} {δ : ℝ}
    (hD : Convex ℝ D) (hP : ConvexOn ℝ D P) (hs : IsEpiSubSol f D P c x (P x) d δ)
    (w' : WithLp 2 (TsengCGD.Global.Vec n × ℝ))
    (hw' : (WithLp.ofLp w').1 ∈ D ∧ P (WithLp.ofLp w').1 ≤ (WithLp.ofLp w').2) :
    ⟪WithLp.toLp 2 (x, P x) - WithLp.toLp 2 (gradient f x, c) - WithLp.toLp 2 (x + d, P x + δ),
      w' - WithLp.toLp 2 (x + d, P x + δ)⟫ ≤ 0 := by
  have key := epi_vi hD hP hs ((WithLp.ofLp w').1 - x) ((WithLp.ofLp w').2 - P x)
    (by rw [add_sub_cancel]; exact hw'.1) (by rw [add_sub_cancel]; linarith [hw'.2])
  simp only [WithLp.prod_inner_apply, WithLp.ofLp_sub, Prod.fst_sub,
    Prod.snd_sub] at key ⊢
  have e1 : (WithLp.ofLp w').1 - x - d = (WithLp.ofLp w').1 - (x + d) := by abel
  have e2 : x - gradient f x - (x + d) = -(gradient f x + d) := by abel
  rw [e1] at key
  rw [e2, inner_neg_left]
  simp only [RCLike.inner_apply, conj_trivial] at *
  nlinarith

theorem norm_pair {n : ℕ} (x d : TsengCGD.Global.Vec n) (ξ δ : ℝ) :
    ‖WithLp.toLp 2 (x + d, ξ + δ) - WithLp.toLp 2 (x, ξ)‖ = pairNorm d δ := by
  rw [WithLp.prod_norm_eq_of_L2, pairNorm]
  simp [sq_abs]

/-- R2: a stationary point of the lifted problem lies on the graph of `P` over `statSet`. -/
theorem sol_stat {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {D : Set (TsengCGD.Global.Vec n)}
    {P : TsengCGD.Global.Vec n → ℝ} {c : ℝ} (hs : TsengCGD.Global.Standing f D P c)
    (p : WithLp 2 (TsengCGD.Global.Vec n × ℝ))
    (hp : (WithLp.ofLp p).1 ∈ D ∧ P (WithLp.ofLp p).1 ≤ (WithLp.ofLp p).2)
    (hvi : ∀ w : WithLp 2 (TsengCGD.Global.Vec n × ℝ),
      (WithLp.ofLp w).1 ∈ D ∧ P (WithLp.ofLp w).1 ≤ (WithLp.ofLp w).2 →
        0 ≤ ⟪WithLp.toLp 2 (gradient f (WithLp.ofLp p).1, c), w - p⟫) :
    (WithLp.ofLp p).2 = P (WithLp.ofLp p).1 ∧
      (WithLp.ofLp p).1 ∈ TsengCGD.Linear.statSet f D P c := by
  have hc := hs.c_pos
  have h0 := hvi (WithLp.toLp 2 ((WithLp.ofLp p).1, P (WithLp.ofLp p).1)) (by simpa using hp.1)
  simp only [WithLp.prod_inner_apply, WithLp.ofLp_sub, Prod.fst_sub,
    Prod.snd_sub, sub_self, inner_zero_right, zero_add, RCLike.inner_apply, conj_trivial] at h0
  have heq : (WithLp.ofLp p).2 = P (WithLp.ofLp p).1 := by nlinarith [hp.2]
  refine ⟨heq, (stat_iff hs _).2 ⟨hp.1, fun y hy => ?_⟩⟩
  have h1 := hvi (WithLp.toLp 2 (y, P y)) (by simpa using hy)
  simp only [WithLp.prod_inner_apply, WithLp.ofLp_sub, Prod.fst_sub,
    Prod.snd_sub, RCLike.inner_apply, conj_trivial] at h1
  rw [heq] at h1
  linarith

/-- R4: a stationary point lifts to a stationary point of the lifted problem. -/
theorem stat_sol {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {D : Set (TsengCGD.Global.Vec n)}
    {P : TsengCGD.Global.Vec n → ℝ} {c : ℝ} (hs : TsengCGD.Global.Standing f D P c)
    {x : TsengCGD.Global.Vec n} (hx : x ∈ TsengCGD.Linear.statSet f D P c)
    (w : WithLp 2 (TsengCGD.Global.Vec n × ℝ))
    (hw : (WithLp.ofLp w).1 ∈ D ∧ P (WithLp.ofLp w).1 ≤ (WithLp.ofLp w).2) :
    0 ≤ ⟪WithLp.toLp 2 (gradient f x, c), w - WithLp.toLp 2 (x, P x)⟫ := by
  have hc := hs.c_pos
  obtain ⟨_, hvi⟩ := (stat_iff hs x).1 hx
  have h1 := hvi _ hw.1
  simp only [WithLp.prod_inner_apply, WithLp.ofLp_sub, Prod.fst_sub,
    Prod.snd_sub, RCLike.inner_apply, conj_trivial]
  nlinarith [hw.2]

/-- R3: the first-coordinate projection does not increase distances to the solution sets. -/
theorem infDist_fst {n : ℕ} {S : Set (TsengCGD.Global.Vec n)}
    {T : Set (WithLp 2 (TsengCGD.Global.Vec n × ℝ))} (hT : T.Nonempty)
    (hTS : ∀ p ∈ T, (WithLp.ofLp p).1 ∈ S) (x : TsengCGD.Global.Vec n) (ξ : ℝ) :
    Metric.infDist x S ≤ Metric.infDist (WithLp.toLp 2 (x, ξ)) T := by
  refine (Metric.le_infDist hT).2 fun p hp => ?_
  refine (Metric.infDist_le_dist_of_mem (hTS p hp)).trans ?_
  rw [dist_eq_norm, dist_eq_norm, WithLp.prod_norm_eq_of_L2]
  refine Real.le_sqrt_of_sq_le ?_
  have : (WithLp.toLp 2 (x, ξ) - p).fst = x - (WithLp.ofLp p).1 := by simp
  rw [this]
  nlinarith [sq_nonneg ‖(WithLp.toLp 2 (x, ξ) - p).snd‖]

end TsengCGD.ErrorBound.L7

namespace TsengCGD.ErrorBound.L7

/-- Assembly: an error bound for the lifted problem on `epi P` (field `G`, agreeing with
`(∇f, c)` over `D`) gives the conclusion of Lemma 7 for the level `ζ`. -/
theorem assemble {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {D : Set (TsengCGD.Global.Vec n)}
    {P : TsengCGD.Global.Vec n → ℝ} {c : ℝ} (hs : TsengCGD.Global.Standing f D P c)
    (hX : (TsengCGD.Linear.statSet f D P c).Nonempty)
    (G : WithLp 2 (TsengCGD.Global.Vec n × ℝ) → WithLp 2 (TsengCGD.Global.Vec n × ℝ))
    (hG : ∀ p : WithLp 2 (TsengCGD.Global.Vec n × ℝ), (WithLp.ofLp p).1 ∈ D →
      G p = WithLp.toLp 2 (gradient f (WithLp.ofLp p).1, c))
    (Z : Set (WithLp 2 (TsengCGD.Global.Vec n × ℝ)))
    (hZ : ∀ p, p ∈ Z ↔ (WithLp.ofLp p).1 ∈ D ∧ P (WithLp.ofLp p).1 ≤ (WithLp.ofLp p).2)
    (ζ τ ε : ℝ) (hτ : 0 < τ) (hε : 0 < ε)
    (hEB : ∀ x ∈ D, TsengCGD.Global.Fc f P c x ≤ ζ → ∀ w : WithLp 2 (TsengCGD.Global.Vec n × ℝ),
      (w ∈ Z ∧ ∀ w' ∈ Z, ⟪WithLp.toLp 2 (x, P x) - G (WithLp.toLp 2 (x, P x)) - w, w' - w⟫ ≤ 0) →
      ‖w - WithLp.toLp 2 (x, P x)‖ ≤ ε →
      Metric.infDist (WithLp.toLp 2 (x, P x)) {z | z ∈ Z ∧ ∀ w ∈ Z, 0 ≤ ⟪G z, w - z⟫} ≤
        τ * ‖w - WithLp.toLp 2 (x, P x)‖) :
    ∃ τ' > 0, ∃ ε' > 0, ∀ x ∈ D, TsengCGD.Global.Fc f P c x ≤ ζ →
      ∀ (dt : TsengCGD.Global.Vec n) (δt : ℝ), IsEpiSubSol f D P c x (P x) dt δt →
        pairNorm dt δt ≤ ε' →
        Metric.infDist x (TsengCGD.Linear.statSet f D P c) ≤ τ' * pairNorm dt δt := by
  obtain ⟨_, hDc, hPc, _⟩ := hs.properConvexLsc
  refine ⟨τ, hτ, ε, hε, fun x hx hlev dt δt hsub hsmall => ?_⟩
  have hn := norm_pair x dt (P x) δt
  have hGx : G (WithLp.toLp 2 (x, P x)) = WithLp.toLp 2 (gradient f x, c) := by
    simpa using hG (WithLp.toLp 2 (x, P x)) (by simpa using hx)
  have hproj : WithLp.toLp 2 (x + dt, P x + δt) ∈ Z ∧ ∀ w' ∈ Z,
      ⟪WithLp.toLp 2 (x, P x) - G (WithLp.toLp 2 (x, P x)) - WithLp.toLp 2 (x + dt, P x + δt),
        w' - WithLp.toLp 2 (x + dt, P x + δt)⟫ ≤ 0 := by
    refine ⟨(hZ _).2 (by simpa using ⟨hsub.1, hsub.2.1⟩), fun w' hw' => ?_⟩
    rw [hGx]
    exact proj_res hDc hPc hsub w' ((hZ w').1 hw')
  have hb := hEB x hx hlev _ hproj (by rw [hn]; exact hsmall)
  rw [hn] at hb
  refine le_trans ?_ hb
  have hsolS : ∀ p ∈ {z | z ∈ Z ∧ ∀ w ∈ Z, 0 ≤ ⟪G z, w - z⟫},
      (WithLp.ofLp p).1 ∈ TsengCGD.Linear.statSet f D P c := by
    rintro p ⟨hpZ, hpvi⟩
    have hp := (hZ p).1 hpZ
    refine (sol_stat hs p hp fun w hw => ?_).2
    rw [← hG p hp.1]
    exact hpvi w ((hZ w).2 hw)
  have hne : ({z | z ∈ Z ∧ ∀ w ∈ Z, 0 ≤ ⟪G z, w - z⟫} : Set _).Nonempty := by
    obtain ⟨xb, hxb⟩ := hX
    have hxbD : xb ∈ D := hxb.1
    refine ⟨WithLp.toLp 2 (xb, P xb), (hZ _).2 (by simpa using hxbD), fun w hw => ?_⟩
    have : G (WithLp.toLp 2 (xb, P xb)) = WithLp.toLp 2 (gradient f xb, c) := by
      simpa using hG (WithLp.toLp 2 (xb, P xb)) (by simpa using hxbD)
    rw [this]
    exact stat_sol hs hxb w ((hZ w).1 hw)
  exact infDist_fst hne hsolS x (P x)

end TsengCGD.ErrorBound.L7

namespace TsengCGD.ErrorBound.L7

open Matrix in
/-- C1 gradient: a quadratic `f` has gradient `T x + b` with `T` self-adjoint. -/
theorem grad_quad {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} (hq : IsQuadratic f) :
    ∃ (T : TsengCGD.Global.Vec n →L[ℝ] TsengCGD.Global.Vec n) (b : TsengCGD.Global.Vec n),
      (∀ x y, ⟪T x, y⟫ = ⟪x, T y⟫) ∧ ∀ x, HasGradientAt f (T x + b) x := by
  obtain ⟨A, b, c₀, hA, hf⟩ := hq
  let T : TsengCGD.Global.Vec n →L[ℝ] TsengCGD.Global.Vec n :=
    LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin A)
  have hT : ∀ x, T x = WithLp.toLp 2 (A *ᵥ WithLp.ofLp x) := fun x => rfl
  have hsym : ∀ x y, ⟪T x, y⟫ = ⟪x, T y⟫ := by
    intro x y
    rw [hT, hT, EuclideanSpace.inner_eq_star_dotProduct, EuclideanSpace.inner_eq_star_dotProduct]
    simp only [star_trivial]
    rw [Matrix.dotProduct_mulVec, ← Matrix.vecMul_transpose, hA.eq, dotProduct_comm]
  have hqf : ∀ x, TsengCGD.Global.qf A x = ⟪x, T x⟫ := by
    intro x
    rw [hT, EuclideanSpace.inner_eq_star_dotProduct, TsengCGD.Global.qf]
    simp only [star_trivial, dotProduct_comm]
  refine ⟨T, b, hsym, fun x => ?_⟩
  have hfeq : f = fun y => ((1:ℝ) / 2) • ⟪id y, T y⟫ + ⟪b, y⟫ + c₀ := by
    funext y; rw [hf, hqf, smul_eq_mul, id]; ring
  rw [hfeq, hasGradientAt_iff_hasFDerivAt]
  have h1 := ((hasFDerivAt_id x).inner ℝ T.hasFDerivAt).const_smul ((1:ℝ) / 2)
  have h2 := (h1.add (innerSL ℝ b).hasFDerivAt).add_const c₀
  refine h2.congr_fderiv ?_
  ext h
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.coe_comp', Function.comp_apply,
    fderivInnerCLM_apply, ContinuousLinearMap.prod_apply, id_eq, innerSL_apply_apply,
    InnerProductSpace.toDual_apply_apply, inner_add_left, ContinuousLinearMap.smul_apply, smul_eq_mul]
  simp only [ContinuousLinearMap.coe_id', id_eq]
  rw [← hsym x h, real_inner_comm (T x) h]
  ring

end TsengCGD.ErrorBound.L7

namespace TsengCGD.ErrorBound.L7

/-- `epi P` as a polyhedron in `ℝⁿ × ℝ` (from `IsPolyhedral`). -/
theorem epi_poly {n m : ℕ} {D : Set (TsengCGD.Global.Vec n)} {P : TsengCGD.Global.Vec n → ℝ}
    (a : Fin m → TsengCGD.Global.Vec n) (b e : Fin m → ℝ)
    (h : ∀ (x : TsengCGD.Global.Vec n) (ξ : ℝ), (x ∈ D ∧ P x ≤ ξ) ↔ ∀ i, ⟪a i, x⟫ + b i * ξ ≤ e i)
    (p : WithLp 2 (TsengCGD.Global.Vec n × ℝ)) :
    p ∈ {p : WithLp 2 (TsengCGD.Global.Vec n × ℝ) | ∀ i, ⟪WithLp.toLp 2 (a i, b i), p⟫ ≤ e i} ↔
      (WithLp.ofLp p).1 ∈ D ∧ P (WithLp.ofLp p).1 ≤ (WithLp.ofLp p).2 := by
  rw [h]
  simp only [Set.mem_setOf_eq, WithLp.prod_inner_apply, WithLp.ofLp_toLp, RCLike.inner_apply,
    conj_trivial]
  constructor <;> intro H i <;> have := H i <;> linarith

end TsengCGD.ErrorBound.L7

namespace TsengCGD.ErrorBound.L7

/-- Child 1 statement (inlined form, as it will be posted): the Luo–Tseng local error bound for an
affine variational inequality over a polyhedron. -/
def AviEB : Prop :=
  ∀ (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (m : ℕ) (a : Fin m → E) (b : Fin m → ℝ) (M : E →L[ℝ] E) (q : E),
    {z : E | (∀ i, ⟪a i, z⟫ ≤ b i) ∧ ∀ w : E, (∀ i, ⟪a i, w⟫ ≤ b i) → 0 ≤ ⟪M z + q, w - z⟫}.Nonempty →
    ∃ τ > 0, ∃ ε > 0, ∀ z w : E, (∀ i, ⟪a i, z⟫ ≤ b i) → (∀ i, ⟪a i, w⟫ ≤ b i) →
      (∀ w' : E, (∀ i, ⟪a i, w'⟫ ≤ b i) → ⟪z - (M z + q) - w, w' - w⟫ ≤ 0) → ‖w - z‖ ≤ ε →
        Metric.infDist z
          {z : E | (∀ i, ⟪a i, z⟫ ≤ b i) ∧ ∀ w : E, (∀ i, ⟪a i, w⟫ ≤ b i) → 0 ≤ ⟪M z + q, w - z⟫} ≤
          τ * ‖w - z‖

set_option maxHeartbeats 1000000 in
/-- Case C1 of Lemma 7 from the AVI error bound. -/
theorem case1 {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {D : Set (TsengCGD.Global.Vec n)}
    {P : TsengCGD.Global.Vec n → ℝ} {c : ℝ} (hs : TsengCGD.Global.Standing f D P c)
    (hX : (TsengCGD.Linear.statSet f D P c).Nonempty) (h1 : C1 f D P) (hA : AviEB) (ζ : ℝ) :
    ∃ τ' > 0, ∃ ε' > 0, ∀ x ∈ D, TsengCGD.Global.Fc f P c x ≤ ζ →
      ∀ (dt : TsengCGD.Global.Vec n) (δt : ℝ), IsEpiSubSol f D P c x (P x) dt δt →
        pairNorm dt δt ≤ ε' →
        Metric.infDist x (TsengCGD.Linear.statSet f D P c) ≤ τ' * pairNorm dt δt := by
  obtain ⟨hq, m, a, b, e, hpoly⟩ := h1
  obtain ⟨T, bq, -, hgrad⟩ := grad_quad hq
  obtain ⟨M, hM⟩ : ∃ M : WithLp 2 (TsengCGD.Global.Vec n × ℝ) →L[ℝ] WithLp 2 (TsengCGD.Global.Vec n × ℝ),
      ∀ p, M p = WithLp.toLp 2 (T (WithLp.ofLp p).1, 0) := by
    refine ⟨(WithLp.prodContinuousLinearEquiv 2 ℝ (TsengCGD.Global.Vec n) ℝ).symm.toContinuousLinearMap ∘L
      ((T ∘L ContinuousLinearMap.fst ℝ (TsengCGD.Global.Vec n) ℝ).prod 0) ∘L
        (WithLp.prodContinuousLinearEquiv 2 ℝ (TsengCGD.Global.Vec n) ℝ).toContinuousLinearMap,
      fun p => rfl⟩
  obtain ⟨q, hqdef⟩ : ∃ q : WithLp 2 (TsengCGD.Global.Vec n × ℝ), q = WithLp.toLp 2 (bq, c) := ⟨_, rfl⟩
  have hG : ∀ p : WithLp 2 (TsengCGD.Global.Vec n × ℝ), (WithLp.ofLp p).1 ∈ D →
      (fun p => M p + q) p = WithLp.toLp 2 (gradient f (WithLp.ofLp p).1, c) := by
    intro p _
    simp only [hM, hqdef, ← WithLp.toLp_add, Prod.mk_add_mk, zero_add, (hgrad _).gradient]
  have hZ := epi_poly (D := D) (P := P) a b e hpoly
  have hne : {z : WithLp 2 (TsengCGD.Global.Vec n × ℝ) |
      (∀ i, ⟪WithLp.toLp 2 (a i, b i), z⟫ ≤ e i) ∧ ∀ w : WithLp 2 (TsengCGD.Global.Vec n × ℝ),
        (∀ i, ⟪WithLp.toLp 2 (a i, b i), w⟫ ≤ e i) → 0 ≤ ⟪M z + q, w - z⟫}.Nonempty := by
    obtain ⟨xb, hxb⟩ := hX
    have hxbD : xb ∈ D := hxb.1
    refine ⟨WithLp.toLp 2 (xb, P xb), (hZ _).2 (by simpa using hxbD), fun w hw => ?_⟩
    have h := hG (WithLp.toLp 2 (xb, P xb)) (by simpa using hxbD)
    simp only [WithLp.ofLp_toLp] at h
    rw [h]
    exact stat_sol hs hxb w ((hZ w).1 hw)
  obtain ⟨τ, hτ, ε, hε, hEB⟩ := hA (WithLp 2 (TsengCGD.Global.Vec n × ℝ)) m
    (fun i => WithLp.toLp 2 (a i, b i)) e M q hne
  exact assemble hs ⟨_, hX.some_mem⟩ (fun p => M p + q) hG _ hZ ζ τ ε hτ hε
    (fun x hx _ w hw hwε => hEB _ w ((hZ _).2 (by simpa using hx)) hw.1 hw.2 hwε)

end TsengCGD.ErrorBound.L7

namespace TsengCGD.ErrorBound.L7

theorem aviEB : AviEB := by
  intro E _ _ _ m a b M q hne
  obtain ⟨τ, hτ, ε, hε, h⟩ := L7c_avi E m a b M q hne
  exact ⟨τ, hτ, ε, hε, fun z w hz hw hvi hsm => h z w hz ⟨hw, hvi⟩ hsm⟩

/-- Gradient of the lifted objective `(x, ξ) ↦ f x + c ξ`. -/
theorem grad_lift {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} (c : ℝ)
    (p : WithLp 2 (TsengCGD.Global.Vec n × ℝ)) (hf : DifferentiableAt ℝ f (WithLp.ofLp p).1) :
    gradient (fun p : WithLp 2 (TsengCGD.Global.Vec n × ℝ) =>
      f (WithLp.ofLp p).1 + c * (WithLp.ofLp p).2) p =
      WithLp.toLp 2 (gradient f (WithLp.ofLp p).1, c) := by
  obtain ⟨L, hL⟩ : ∃ L : WithLp 2 (TsengCGD.Global.Vec n × ℝ) →L[ℝ] TsengCGD.Global.Vec n,
      ∀ p, L p = (WithLp.ofLp p).1 :=
    ⟨(ContinuousLinearMap.fst ℝ (TsengCGD.Global.Vec n) ℝ) ∘L
      (WithLp.prodContinuousLinearEquiv 2 ℝ (TsengCGD.Global.Vec n) ℝ).toContinuousLinearMap,
      fun p => rfl⟩
  obtain ⟨S, hS⟩ : ∃ S : WithLp 2 (TsengCGD.Global.Vec n × ℝ) →L[ℝ] ℝ,
      ∀ p, S p = (WithLp.ofLp p).2 :=
    ⟨(ContinuousLinearMap.snd ℝ (TsengCGD.Global.Vec n) ℝ) ∘L
      (WithLp.prodContinuousLinearEquiv 2 ℝ (TsengCGD.Global.Vec n) ℝ).toContinuousLinearMap,
      fun p => rfl⟩
  have hfun : (fun p : WithLp 2 (TsengCGD.Global.Vec n × ℝ) =>
      f (WithLp.ofLp p).1 + c * (WithLp.ofLp p).2) = fun p => f (L p) + c * S p := by
    funext p; rw [hL, hS]
  rw [hfun]
  apply HasGradientAt.gradient
  rw [hasGradientAt_iff_hasFDerivAt]
  have hf' : DifferentiableAt ℝ f (L p) := by rw [hL]; exact hf
  have h1 : HasFDerivAt (fun p => f (L p)) ((fderiv ℝ f (L p)).comp L) p :=
    hf'.hasFDerivAt.comp p L.hasFDerivAt
  have h2 := h1.add (S.hasFDerivAt.const_mul c)
  refine h2.congr_fderiv ?_
  ext v
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.coe_comp', Function.comp_apply,
    ContinuousLinearMap.smul_apply, smul_eq_mul, InnerProductSpace.toDual_apply_apply,
    WithLp.prod_inner_apply, WithLp.ofLp_toLp, hL, hS, RCLike.inner_apply, conj_trivial]
  simp only [gradient, InnerProductSpace.toDual_symm_apply]
  ring

set_option maxHeartbeats 1000000 in
/-- Case C2 of Lemma 7 from the composite error bound. -/
theorem case2 {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {D : Set (TsengCGD.Global.Vec n)}
    {P : TsengCGD.Global.Vec n → ℝ} {c : ℝ} (hs : TsengCGD.Global.Standing f D P c)
    (hX : (TsengCGD.Linear.statSet f D P c).Nonempty) (h2 : C2 f D P) (ζ : ℝ) :
    ∃ τ' > 0, ∃ ε' > 0, ∀ x ∈ D, TsengCGD.Global.Fc f P c x ≤ ζ →
      ∀ (dt : TsengCGD.Global.Vec n) (δt : ℝ), IsEpiSubSol f D P c x (P x) dt δt →
        pairNorm dt δt ≤ ε' →
        Metric.infDist x (TsengCGD.Linear.statSet f D P c) ≤ τ' * pairNorm dt δt := by
  obtain ⟨m, E, q, g, μ, Lg, hμ, hsc, hdg, hlip, hf, k, a, b, e, hpoly⟩ := h2
  obtain ⟨L, hL⟩ : ∃ L : WithLp 2 (TsengCGD.Global.Vec n × ℝ) →L[ℝ] EuclideanSpace ℝ (Fin m),
      ∀ p, L p = E (WithLp.ofLp p).1 :=
    ⟨E ∘L (ContinuousLinearMap.fst ℝ (TsengCGD.Global.Vec n) ℝ) ∘L
      (WithLp.prodContinuousLinearEquiv 2 ℝ (TsengCGD.Global.Vec n) ℝ).toContinuousLinearMap,
      fun p => rfl⟩
  obtain ⟨q', hq'⟩ : ∃ q' : WithLp 2 (TsengCGD.Global.Vec n × ℝ), q' = WithLp.toLp 2 (q, c) :=
    ⟨_, rfl⟩
  have hfun : (fun z : WithLp 2 (TsengCGD.Global.Vec n × ℝ) => g (L z) + ⟪q', z⟫) =
      fun p => f (WithLp.ofLp p).1 + c * (WithLp.ofLp p).2 := by
    funext p
    rw [hL, hq', hf]
    simp only [WithLp.prod_inner_apply, WithLp.ofLp_toLp, RCLike.inner_apply, conj_trivial]
    ring
  have hZ := epi_poly (D := D) (P := P) a b e hpoly
  have hG : ∀ p : WithLp 2 (TsengCGD.Global.Vec n × ℝ), (WithLp.ofLp p).1 ∈ D →
      gradient (fun z => g (L z) + ⟪q', z⟫) p =
        WithLp.toLp 2 (gradient f (WithLp.ofLp p).1, c) := by
    intro p hp
    rw [hfun]
    exact grad_lift c p (diffAt_of_standing hs hp)
  have hne : {z : WithLp 2 (TsengCGD.Global.Vec n × ℝ) |
      (∀ i, ⟪WithLp.toLp 2 (a i, b i), z⟫ ≤ e i) ∧ ∀ w : WithLp 2 (TsengCGD.Global.Vec n × ℝ),
        (∀ i, ⟪WithLp.toLp 2 (a i, b i), w⟫ ≤ e i) →
          0 ≤ ⟪gradient (fun z => g (L z) + ⟪q', z⟫) z, w - z⟫}.Nonempty := by
    obtain ⟨xb, hxb⟩ := hX
    have hxbD : xb ∈ D := hxb.1
    refine ⟨WithLp.toLp 2 (xb, P xb), (hZ _).2 (by simpa using hxbD), fun w hw => ?_⟩
    have h := hG (WithLp.toLp 2 (xb, P xb)) (by simpa using hxbD)
    simp only [WithLp.ofLp_toLp] at h
    rw [h]
    exact stat_sol hs hxb w ((hZ w).1 hw)
  obtain ⟨τ, hτ, ε, hε, hEB⟩ := L7c_comp _ _ k (fun i => WithLp.toLp 2 (a i, b i)) e L q' g μ Lg
    hμ hsc hdg hlip hne ζ
  refine assemble hs ⟨_, hX.some_mem⟩ _ hG _ hZ ζ τ ε hτ hε
    (fun x hx hlev w hw hwε => hEB _ w ((hZ _).2 (by simpa using hx)) ?_ hw hwε)
  have hv := congrFun hfun (WithLp.toLp 2 (x, P x))
  simp only [WithLp.ofLp_toLp] at hv
  rw [hv]
  exact hlev

set_option maxHeartbeats 1000000 in
/-- Case C3 of Lemma 7 from the dual-functional error bound. -/
theorem case3 {n : ℕ} {f : TsengCGD.Global.Vec n → ℝ} {D : Set (TsengCGD.Global.Vec n)}
    {P : TsengCGD.Global.Vec n → ℝ} {c : ℝ} (hs : TsengCGD.Global.Standing f D P c)
    (hX : (TsengCGD.Linear.statSet f D P c).Nonempty) (h3 : C3 f D P) (ζ : ℝ) :
    ∃ τ' > 0, ∃ ε' > 0, ∀ x ∈ D, TsengCGD.Global.Fc f P c x ≤ ζ →
      ∀ (dt : TsengCGD.Global.Vec n) (δt : ℝ), IsEpiSubSol f D P c x (P x) dt δt →
        pairNorm dt δt ≤ ε' →
        Metric.infDist x (TsengCGD.Linear.statSet f D P c) ≤ τ' * pairNorm dt δt := by
  obtain ⟨m, Y, E, q, g, μ, Lg, ⟨r, ay, by', hY⟩, hμ, hsc, hdg, hlip, hgr, k, a, b, e, hpoly⟩ := h3
  obtain ⟨L, hL⟩ : ∃ L : WithLp 2 (TsengCGD.Global.Vec n × ℝ) →L[ℝ] EuclideanSpace ℝ (Fin m),
      ∀ p, L p = E (WithLp.ofLp p).1 :=
    ⟨E ∘L (ContinuousLinearMap.fst ℝ (TsengCGD.Global.Vec n) ℝ) ∘L
      (WithLp.prodContinuousLinearEquiv 2 ℝ (TsengCGD.Global.Vec n) ℝ).toContinuousLinearMap,
      fun p => rfl⟩
  obtain ⟨q', hq'⟩ : ∃ q' : WithLp 2 (TsengCGD.Global.Vec n × ℝ), q' = WithLp.toLp 2 (q, c) :=
    ⟨_, rfl⟩
  obtain ⟨h, hh⟩ : ∃ h : WithLp 2 (TsengCGD.Global.Vec n × ℝ) → ℝ,
      h = fun p => f (WithLp.ofLp p).1 + c * (WithLp.ofLp p).2 := ⟨_, rfl⟩
  have hgr' : ∀ z, IsGreatest {v | ∃ y ∈ LuoTseng.ErrorBound.poly ay by', v = ⟪L z, y⟫ - g y}
      (h z - ⟪q', z⟫) := by
    intro z
    have hval : h z - ⟪q', z⟫ = f (WithLp.ofLp z).1 - ⟪q, (WithLp.ofLp z).1⟫ := by
      rw [hh, hq']
      simp only [WithLp.prod_inner_apply, WithLp.ofLp_toLp, RCLike.inner_apply, conj_trivial]
      ring
    rw [hval, hL]
    have := hgr (WithLp.ofLp z).1
    rw [hY] at this
    exact this
  have hZ := epi_poly (D := D) (P := P) a b e hpoly
  have hG : ∀ p : WithLp 2 (TsengCGD.Global.Vec n × ℝ), (WithLp.ofLp p).1 ∈ D →
      gradient h p = WithLp.toLp 2 (gradient f (WithLp.ofLp p).1, c) := by
    intro p hp
    rw [hh]
    exact grad_lift c p (diffAt_of_standing hs hp)
  have hne : {z : WithLp 2 (TsengCGD.Global.Vec n × ℝ) |
      (∀ i, ⟪WithLp.toLp 2 (a i, b i), z⟫ ≤ e i) ∧ ∀ w : WithLp 2 (TsengCGD.Global.Vec n × ℝ),
        (∀ i, ⟪WithLp.toLp 2 (a i, b i), w⟫ ≤ e i) → 0 ≤ ⟪gradient h z, w - z⟫}.Nonempty := by
    obtain ⟨xb, hxb⟩ := hX
    have hxbD : xb ∈ D := hxb.1
    refine ⟨WithLp.toLp 2 (xb, P xb), (hZ _).2 (by simpa using hxbD), fun w hw => ?_⟩
    have h' := hG (WithLp.toLp 2 (xb, P xb)) (by simpa using hxbD)
    simp only [WithLp.ofLp_toLp] at h'
    rw [h']
    exact stat_sol hs hxb w ((hZ w).1 hw)
  obtain ⟨τ, hτ, ε, hε, hEB⟩ := L7c_dual _ _ k r (fun i => WithLp.toLp 2 (a i, b i)) e ay by'
    L q' g μ Lg h hμ hsc hdg hlip hgr' hne ζ
  refine assemble hs ⟨_, hX.some_mem⟩ _ hG _ hZ ζ τ ε hτ hε
    (fun x hx hlev w hw hwε => hEB _ w ((hZ _).2 (by simpa using hx)) ?_ hw hwε)
  rw [hh]
  simp only [WithLp.ofLp_toLp]
  exact hlev

end TsengCGD.ErrorBound.L7

open TsengCGD.ErrorBound in
theorem solution {n : ℕ} (f : TsengCGD.Global.Vec n → ℝ) (D : Set (TsengCGD.Global.Vec n)) (P : TsengCGD.Global.Vec n → ℝ) (c : ℝ)
    (hs : TsengCGD.Global.Standing f D P c) (hX : (TsengCGD.Linear.statSet f D P c).Nonempty)
    (hC : C1 f D P ∨ C2 f D P ∨ C3 f D P) :
    ∀ ζ : ℝ, ∃ τ' > 0, ∃ ε' > 0, ∀ x ∈ D, TsengCGD.Global.Fc f P c x ≤ ζ →
      ∀ (dt : TsengCGD.Global.Vec n) (δt : ℝ), IsEpiSubSol f D P c x (P x) dt δt → pairNorm dt δt ≤ ε' →
        Metric.infDist x (TsengCGD.Linear.statSet f D P c) ≤ τ' * pairNorm dt δt := by
  intro ζ
  rcases hC with h1 | h2 | h3
  · exact TsengCGD.ErrorBound.L7.case1 hs hX h1 TsengCGD.ErrorBound.L7.aviEB ζ
  · exact TsengCGD.ErrorBound.L7.case2 hs hX h2 ζ
  · exact TsengCGD.ErrorBound.L7.case3 hs hX h3 ζ
