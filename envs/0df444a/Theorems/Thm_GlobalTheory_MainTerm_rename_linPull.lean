theorem GlobalTheory.MainTerm.rename_linPull {C : Type} [Field C] {σ ι τ : Type} [Fintype σ] [Fintype ι] (f : ι → τ)
    (e : ι → σ → C) (F : MvPowerSeries σ C) :
    MvPowerSeries.rename f (linPull e F) = MvPowerSeries.subst (fun x : σ =>
      (∑ c, e c x • MvPowerSeries.X (f c) : MvPowerSeries τ C)) F := by sorry
