    · have hx2 : (gu049.lo : ℝ) < x := by
          have hb : (gu048.top : ℝ) = (gu049.lo : ℝ) := by simp [gu048, gu049]
          linarith
      by_cases h2 : x ≤ (gu049.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu050.lo : ℝ) < x := by
            have hb : (gu049.top : ℝ) = (gu050.lo : ℝ) := by simp [gu049, gu050]
            linarith
