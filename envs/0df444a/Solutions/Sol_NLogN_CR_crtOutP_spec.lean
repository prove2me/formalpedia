      rw [NLogN.CR.invL_length] at hq
      rw [NLogN.CR.invL_idxOf h q hq, hw, ← hS]; exact NLogN.CR.crtKey_lt h.2 q)]
    rw [List.length_map, List.length_range, hIl]
  -- 6. drop the inverse keys
  have r6 := NLogN.CR.dropN_spec 3 NLogN.CR.kC1 (by decide) (by decide) (by decide) (.reg 1)
    (NLogN.RS.clean_of_lt (by decide)) s5 Inv (NLogN.natInts (NLogN.CR.keyL sl) ++ RK)
    (by simp +decide [hs5, hs4, hs3, hs2, hs1, h3, NLogN.ints_reverse])
    (NLogN.IState.isInt_of (L := L1) (a := S) (by simp +decide [hs5, hs4, hs3, hs2, hs1, h1]))
    (by simp +decide [NLogN.Ex.eval, NLogN.IState.top, hs5, hs4, hs3, hs2, hs1, h1, hInvl])
  set s6 := s5.upd 3 (NLogN.natInts (NLogN.CR.keyL sl) ++ RK) with hs6
  -- 7. move the first `M` entries to `kT`
  have r7 := NLogN.mvK_spec (X := 0) (Y := NLogN.CR.kT) (C := NLogN.CR.kC3) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg NLogN.CR.cMR) (NLogN.RS.clean_of_lt (by decide)) s6 (P.take M)
    (NLogN.ints (P.drop M) ++ Rest)
    (by simp +decide only [hs6, hs5, NLogN.IState.upd_G, if_true, if_false]
        rw [← List.append_assoc, ← NLogN.ints_append, List.take_append_drop])
    (NLogN.IState.isInt_of (L := LM) (a := M) (by simp +decide [hs6, hs5, hs4, hs3, hs2, hs1, hm]))
    (by simp +decide [NLogN.Ex.eval, NLogN.IState.top, hs6, hs5, hs4, hs3, hs2, hs1, hm, hPl, hM])
  set s7 := (s6.upd 0 (NLogN.ints (P.drop M) ++ Rest)).upd NLogN.CR.kT ((NLogN.ints (P.take M)).reverse ++ s6.G NLogN.CR.kT)
    with hs7
  -- 8. drop the rest
  have r8 := NLogN.CR.dropN_spec 0 NLogN.CR.kC1 (by decide) (by decide) (by decide) (.add (.reg 1) (.neg (.reg NLogN.CR.cMR)))
    (by decide) s7 (P.drop M) Rest (by simp +decide [hs7])
    ⟨NLogN.IState.isInt_of (L := L1) (a := S) (by simp +decide [hs7, hs6, hs5, hs4, hs3, hs2, hs1, h1]),
      NLogN.IState.isInt_of (L := LM) (a := M) (by simp +decide [hs7, hs6, hs5, hs4, hs3, hs2, hs1, hm])⟩
    (by simp +decide [NLogN.Ex.eval, NLogN.IState.top, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hm, h1, hPl]; omega)
  set s8 := s7.upd 0 Rest with hs8
  -- 9. move the first `M` entries back
  have r9 := NLogN.mvK_spec (X := NLogN.CR.kT) (Y := 0) (C := NLogN.CR.kC3) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg NLogN.CR.cMR) (NLogN.RS.clean_of_lt (by decide)) s8 (P.take M).reverse
    (s.G NLogN.CR.kT) (by simp +decide [hs8, hs7, hs6, hs5, hs4, NLogN.ints_reverse])
    (NLogN.IState.isInt_of (L := LM) (a := M) (by simp +decide [hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hm]))
    (by simp +decide [NLogN.Ex.eval, NLogN.IState.top, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hm, hPl, hM])
  have fin : (s8.upd NLogN.CR.kT (s.G NLogN.CR.kT)).upd 0 ((NLogN.ints (P.take M).reverse).reverse ++ s8.G 0) =
      s.upd 0 (NLogN.ints (crtOut sl M w) ++ Rest) := by
    have e : P.take M = crtOut sl M w := by
      rw [hP, NLogN.CR.crtOut_perm h w (by rw [hw, hS]) M (by rw [hS]; exact hM)]
    rw [NLogN.ints_reverse, List.reverse_reverse, e]
    apply NLogN.IState.ext' _ (by simp [hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1])
      (by simp [hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1])
    intro x
    simp only [hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, NLogN.IState.upd_G]
    rw [show (NLogN.ints Inv.reverse).reverse = NLogN.ints Inv by rw [NLogN.ints_reverse, List.reverse_reverse]]
    clear * - h3
    split_ifs <;> (try subst_vars) <;> simp_all +decide
  rw [← fin]
  exact NLogN.CR.seq_spec r1 (NLogN.CR.seq_spec r2 (NLogN.CR.seq_spec r3 (NLogN.CR.seq_spec r4 (NLogN.CR.seq_spec r5 (NLogN.CR.seq_spec r6
    (NLogN.CR.seq_spec r7 (NLogN.CR.seq_spec r8 r9)))))))
end
