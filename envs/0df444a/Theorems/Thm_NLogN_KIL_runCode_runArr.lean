open NLogN
open NLogN.KIL
open IntMul AModel
variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}

theorem NLogN.KIL.runCode_runArr (scode : Step n Q → IStmt HS Pp) (jOf : Fin n → Fin n → Fin Pp)
    (child : Fin n → Fin n → List ℤ → List ℤ) (t : IState HS) (R : List Item) (Bb cS : ℕ)
    (cC : Fin n → Fin n → ℕ) (steps : List (Step n Q))
    (hS : ∀ i u c, Step.shift i u c ∈ steps → ∀ ys, DOK sh Bb ys →
      IRuns I iprog (scode (.shift i u c)) (t.upd 0 (ints ys ++ R))
        (t.upd 0 (ints ((Step.shift i u c).arr Λ 0 ys) ++ R)) cS)
    (hC : ∀ a b, Step.swap a b ∈ steps → ∀ ys, DOK sh Bb ys →
      IRuns I iprog (iprog (jOf a b)) (t.upd 0 (ints ys ++ R))
        (t.upd 0 (ints (child a b ys) ++ R)) (cC a b) ∧
      child a b ys = (Step.swap a b).arr Λ 0 ys)
    (xs : List ℤ) (hx : DOK sh Bb xs) :
    IRuns I iprog (runCode scode jOf steps) (t.upd 0 (ints xs ++ R))
      (t.upd 0 (ints (AModel.runArr Λ 0 steps xs) ++ R)) (runCostI cS cC steps) := by sorry
