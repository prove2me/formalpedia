-- title:
--   Theorem 9 (convergence) — under the KL property, the proximal alternating sequence either diverges in norm or has finite length and converges to a critical point
-- statement:
--   Let $L(x,y)=f(x)+Q(x,y)+g(y)$ satisfy (H): $f:\mathbb R^n\to\mathbb R\cup\{+\infty\}$ and $g:\mathbb R^m\to\mathbb R\cup\{+\infty\}$ proper lower semicontinuous, $Q$ of class $C^1$ with $\nabla Q$ Lipschitz on bounded sets. Let $(x_k,y_k)$ comply with the proximal alternating scheme (5)–(6), with step sizes satisfying (H1): $\inf L>-\infty$, $L(\cdot,y_0)$ proper, $\lambda_k,\mu_k\in(r_-,r_+)$ with $0<r_-<r_+$. Assume that $L$ has the Kurdyka–Łojasiewicz property at every point of $\operatorname{dom}\partial L$. Then
--   - either $\|(x_k,y_k)\|\to+\infty$,
--   - or the steps are absolutely summable,
--   $$\sum_{k}\big(\|x_{k+1}-x_k\|+\|y_{k+1}-y_k\|\big)<+\infty,$$
--   and $(x_k,y_k)$ converges to a critical point of $L$, i.e. to a point $z^\star$ with $0\in\partial L(z^\star)$.
--
--   This is the main theorem of the paper: for KL functions (for instance semi-algebraic data), every sequence of the alternating proximal scheme that does not escape to infinity has finite length and converges to a critical point.
--
--   **Formalization Note** The paper writes "the Kurdyka–Łojasiewicz property at each point of the domain of $f$"; since the KL property is a property of $L$ at points of $\operatorname{dom}\partial L$ (Definition 7), the hypothesis is formalized as "at every $z$ with $\partial L(z)\ne\emptyset$". The sum on the page starts at $k=1$; summability does not depend on finitely many terms. The space $\mathbb R^n\times\mathbb R^m$ carries the Euclidean product norm.
-- source:
--   Attouch, Bolte, Redont, Soubeyran, Proximal alternating minimization and projection methods for nonconvex problems, Math. Oper. Res. (2010), p. 11, Theorem 9

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_ADMMKL_KLProperty
import Definitions.Def_ProxAltMin_Conv_Setting
open NonconvexSplitting.Shared NonconvexSplitting.ADMMKL
open Filter Topology

namespace ProxAltMin.Conv

/-- Theorem 9 (convergence, p. 11). Assume that `L = f + Q + g` satisfies (H), (H1) and has the
Kurdyka–Łojasiewicz property at every point where its limiting subdifferential is nonempty. Then every
sequence `(xₖ, yₖ)` generated by the proximal alternating scheme (5)–(6) satisfies: either
`‖(xₖ, yₖ)‖ → +∞`, or `∑_k (‖x_{k+1} - xₖ‖ + ‖y_{k+1} - yₖ‖) < +∞` and `(xₖ, yₖ)` converges to a critical
point of `L`. -/
theorem theorem_9 {n m : ℕ} (f : EuclideanSpace ℝ (Fin n) → EReal) (Q : Z n m → ℝ)
    (g : EuclideanSpace ℝ (Fin m) → EReal) (lam mu : ℕ → ℝ) (rm rp : ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y : ℕ → EuclideanSpace ℝ (Fin m))
    (hH : AssumptionH f Q g) (hH1 : AssumptionH1 f Q g lam mu (y 0) rm rp)
    (hKL : ∀ z : Z n m, (LimitingSubdiff (L f Q g) z).Nonempty → HasKLProperty (L f Q g) z)
    (hrun : IsPAMRun f Q g lam mu x y) :
    Tendsto (fun k => ‖pt (x k) (y k)‖) atTop atTop ∨
      (Summable (fun k => ‖x (k + 1) - x k‖ + ‖y (k + 1) - y k‖) ∧
        ∃ zlim : Z n m, (0 : Z n m) ∈ LimitingSubdiff (L f Q g) zlim ∧
          Tendsto (fun k => pt (x k) (y k)) atTop (𝓝 zlim)) := by sorry

end ProxAltMin.Conv
