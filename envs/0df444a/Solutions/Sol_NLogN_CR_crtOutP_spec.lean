    l.Perm (List.range l.length) := by
  have hs : l.Subperm (List.range l.length) :=
    hd.subperm (fun x hx => List.mem_range.2 (hlt x hx))
  exact hs.perm_of_length_le (by simp)

theorem keyL_length (s : List ℕ) : (keyL s).length = s.prod := by simp [keyL]

theorem keyL_perm {s : List ℕ} (h : CrtOK s) : (keyL s).Perm (List.range s.prod) := by
  have := perm_range_of_nodup (keyL_nodup h) (fun x hx => by
    rw [keyL_length]
    simp only [keyL, List.mem_map] at hx
    obtain ⟨k, _, rfl⟩ := hx
    exact crtKey_lt h.2 k)
  rwa [keyL_length] at this

theorem prod_split (s : List ℕ) (i : ℕ) (hi : i < s.length) :
    s.prod = s[i] * ((s.take i).prod * (s.drop (i + 1)).prod) := by
  rw [← List.prod_take_mul_prod_drop s i, List.drop_eq_getElem_cons hi, List.prod_cons]; ring

theorem prod_div_getD (s : List ℕ) (h : ∀ x ∈ s, 0 < x) (i : ℕ) (hi : i < s.length) :
    s.prod / s.getD i 1 = (s.take i).prod * (s.drop (i + 1)).prod := by
  rw [List.getD_eq_getElem _ _ hi, prod_split s i hi]
  exact Nat.mul_div_cancel_left _ (h _ (List.getElem_mem _))

theorem coprime_others {s : List ℕ} (h : CrtOK s) (i : ℕ) (hi : i < s.length) :
    Nat.Coprime ((s.take i).prod * (s.drop (i + 1)).prod) s[i] := by
  have hp := List.pairwise_iff_getElem.1 h.1
  apply Nat.Coprime.mul_left
  · rw [Nat.coprime_list_prod_left_iff]
    intro a ha
    obtain ⟨p, hp', rfl⟩ := List.mem_iff_getElem.1 ha
    simp only [List.length_take] at hp'
    rw [List.getElem_take]
    exact hp p i (by omega) hi (by omega)
  · rw [Nat.coprime_list_prod_left_iff]
    intro a ha
    obtain ⟨p, hp', rfl⟩ := List.mem_iff_getElem.1 ha
    simp only [List.length_drop] at hp'
    rw [List.getElem_drop]
    exact (hp i (i + 1 + p) hi (by omega) (by omega)).symm

theorem dvd_others {s : List ℕ} (h : CrtOK s) (i m : ℕ) (hi : i < s.length) (hm : m < s.length)
    (hne : m ≠ i) : s[i] ∣ (s.take m).prod * (s.drop (m + 1)).prod := by
  have hp := List.pairwise_iff_getElem.1 h.1
  have hcop : Nat.Coprime s[i] s[m] := by
    rcases lt_or_gt_of_ne hne with hlt | hlt
    · exact (hp m i hm hi hlt).symm
    · exact hp i m hi hm hlt
  have hdvd : s[i] ∣ s[m] * ((s.take m).prod * (s.drop (m + 1)).prod) := by
    rw [← prod_split s m hm]; exact List.dvd_prod (List.getElem_mem _)
  exact hcop.dvd_of_dvd_mul_left hdvd

theorem crtCoef_zmod {s : List ℕ} (h : CrtOK s) (i m : ℕ) (hi : i < s.length) (hm : m < s.length) :
    ((crtCoef s m : ℕ) : ZMod s[i]) = if m = i then 1 else 0 := by
  have hpos : 0 < s[i] := h.2 _ (List.getElem_mem _)
  have : NeZero s[i] := ⟨by omega⟩
  unfold crtCoef
  rw [prod_div_getD s h.2 m hm]
  split_ifs with hmi
  · subst hmi
    rw [List.getD_eq_getElem _ _ hm]
    rw [Nat.cast_mul, ZMod.natCast_zmod_val]
    exact ZMod.coe_mul_inv_eq_one _ (coprime_others h m hm)
  · rw [Nat.cast_mul, (ZMod.natCast_eq_zero_iff _ _).2 (dvd_others h i m hi hm hmi), zero_mul]

theorem sum_range_zmod {n : ℕ} (N : ℕ) (f : ℕ → ℕ) :
    (((List.range N).map f).sum : ZMod n) = ∑ m ∈ Finset.range N, (f m : ZMod n) := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [List.range_succ, List.map_append, List.sum_append, Finset.sum_range_succ, Nat.cast_add, ih]
    simp

theorem crtIdx_mod {s : List ℕ} (h : CrtOK s) (j : ℕ → ℕ) (i : ℕ) (hi : i < s.length) :
    crtIdx s j % s[i] = j i % s[i] := by
  have hpos : 0 < s[i] := h.2 _ (List.getElem_mem _)
  have hdvd : s[i] ∣ s.prod := List.dvd_prod (List.getElem_mem _)
  unfold crtIdx
  rw [Nat.mod_mod_of_dvd _ hdvd]
  rw [← ZMod.natCast_eq_natCast_iff']
  rw [sum_range_zmod]
  rw [Finset.sum_eq_single i]
  · push_cast; rw [crtCoef_zmod h i i hi hi, if_pos rfl, mul_one]
  · intro m hm hmi
    push_cast; rw [crtCoef_zmod h i m hi (Finset.mem_range.1 hm), if_neg hmi, mul_zero]
  · intro hn; exact absurd (Finset.mem_range.2 hi) hn

theorem prod_pos' {s : List ℕ} (h : ∀ x ∈ s, 0 < x) : 0 < s.prod := List.prod_pos h

theorem crtIdx_lt {s : List ℕ} (h : ∀ x ∈ s, 0 < x) (j : ℕ → ℕ) : crtIdx s j < s.prod :=
  Nat.mod_lt _ (prod_pos' h)

theorem crtKey_crtIdx {s : List ℕ} (h : CrtOK s) (q : ℕ) (hq : q < s.prod) :
    crtKey s (crtIdx s (unrk s q)) = q := by
  unfold crtKey
  rw [rmPos_congr s _ (unrk s q), rmPos_unrk s q hq]
  intro i hi
  simp only [resJ, List.getD_eq_getElem _ _ hi]
  rw [crtIdx_mod h _ i hi, Nat.mod_eq_of_lt]
  have := unrk_lt s q hq i hi
  rwa [List.getD_eq_getElem _ _ hi] at this

theorem keyL_getElem (s : List ℕ) (k : ℕ) (hk : k < (keyL s).length) : (keyL s)[k] = crtKey s k := by
  simp [keyL]

theorem keyL_idxOf {s : List ℕ} (h : CrtOK s) (q : ℕ) (hq : q < s.prod) :
    (keyL s).idxOf q = crtIdx s (unrk s q) := by
  have hl : crtIdx s (unrk s q) < (keyL s).length := by rw [keyL_length]; exact crtIdx_lt h.2 _
  have e : (keyL s)[crtIdx s (unrk s q)] = q := by rw [keyL_getElem]; exact crtKey_crtIdx h q hq
  conv_lhs => rw [← e]
