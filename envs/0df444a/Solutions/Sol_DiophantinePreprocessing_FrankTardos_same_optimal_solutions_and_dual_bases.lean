/-- A finite closed system of real affine inequalities. -/
def feasibleSet (a : ι → E) (b : ι → ℝ) : Set E :=
  {x | ∀ i, b i ≤ inner ℝ (a i) x}

theorem feasibleSet_closed (a : ι → E) (b : ι → ℝ) :
    IsClosed (feasibleSet a b) := by
  simpa only [feasibleSet, Set.iInter_ofPred] using
    (isClosed_iInter fun i =>
      isClosed_le (continuous_const : Continuous (fun _ : E => b i))
        (continuous_const.inner continuous_id : Continuous (fun x : E => inner ℝ (a i) x)))

theorem feasibleSet_convex (a : ι → E) (b : ι → ℝ) :
    Convex ℝ (feasibleSet a b) := by
  intro x hx y hy s t hs ht hst i
  simp only [inner_add_right, inner_smul_right]
  have h₁ := mul_le_mul_of_nonneg_left (hx i) hs
  have h₂ := mul_le_mul_of_nonneg_left (hy i) ht
  calc
    b i = s * b i + t * b i := by rw [← add_mul, hst, one_mul]
    _ ≤ s * inner ℝ (a i) x + t * inner ℝ (a i) y := add_le_add h₁ h₂

/-- A direction orthogonal to every active constraint is locally feasible in both signs. -/
theorem eventually_feasible_add_smul [Fintype ι] (a : ι → E) (b : ι → ℝ) (x v : E)
    (hx : x ∈ feasibleSet a b)
    (hv : ∀ i, b i = inner ℝ (a i) x → inner ℝ (a i) v = 0) :
    ∀ᶠ t : ℝ in 𝓝 0, x + t • v ∈ feasibleSet a b := by
  apply eventually_all.mpr
  intro i
  by_cases hi : b i = inner ℝ (a i) x
  · exact Eventually.of_forall fun t => by
      simp only [inner_add_right, inner_smul_right, hv i hi, mul_zero, add_zero]
      exact hx i
  · have hstrict : b i < inner ℝ (a i) x := lt_of_le_of_ne (hx i) hi
    have hc : ContinuousAt (fun t : ℝ => inner ℝ (a i) (x + t • v)) 0 := by
      fun_prop
    have he := hc.eventually (Ioi_mem_nhds (by simpa using hstrict))
    exact he.mono fun t ht => le_of_lt ht

/-- At a minimum-norm feasible point, every locally free direction is orthogonal to the point. -/
theorem minimum_norm_inner_eq_zero [Fintype ι] (a : ι → E) (b : ι → ℝ) (x v : E)
    (hx : x ∈ feasibleSet a b)
    (hmin : ∀ y ∈ feasibleSet a b, ‖x‖ ≤ ‖y‖)
    (hv : ∀ i, b i = inner ℝ (a i) x → inner ℝ (a i) v = 0) :
    inner ℝ x v = 0 := by
  let f : ℝ → ℝ := fun t => ‖x‖ ^ 2 + 2 * inner ℝ x v * t + ‖v‖ ^ 2 * t ^ 2
  have hf (t : ℝ) : f t = ‖x + t • v‖ ^ 2 := by
    rw [norm_add_sq_real, inner_smul_right, norm_smul, mul_pow, Real.norm_eq_abs, sq_abs]
    dsimp [f]
    ring
  have hlocal : IsLocalMin f 0 := by
    filter_upwards [eventually_feasible_add_smul a b x v hx hv] with t ht
    rw [hf, hf]
    simpa only [zero_smul, add_zero] using
      (sq_le_sq₀ (norm_nonneg x) (norm_nonneg (x + t • v))).mpr (hmin _ ht)
  have hd : HasDerivAt f (2 * inner ℝ x v) 0 := by
    convert! ((hasDerivAt_const (0 : ℝ) (‖x‖ ^ 2)).add
      ((hasDerivAt_id (0 : ℝ)).const_mul (2 * inner ℝ x v))).add
      (((hasDerivAt_id (0 : ℝ)).pow 2).const_mul (‖v‖ ^ 2)) using 1
    simp
  have hz := hlocal.hasDerivAt_eq_zero hd
  linarith

theorem exists_minimum_norm [CompleteSpace E] (a : ι → E) (b : ι → ℝ)
    (hne : (feasibleSet a b).Nonempty) :
    ∃ x ∈ feasibleSet a b, ∀ y ∈ feasibleSet a b, ‖x‖ ≤ ‖y‖ := by
  obtain ⟨x, hx, hnorm⟩ := exists_norm_eq_iInf_of_complete_convex hne
    (feasibleSet_closed a b).isComplete (feasibleSet_convex a b) (0 : E)
  refine ⟨x, hx, ?_⟩
  intro y hy
  have hle := ciInf_le
    (show BddBelow (Set.range (fun z : feasibleSet a b => ‖(0 : E) - z‖)) from
      ⟨0, by rintro _ ⟨z, rfl⟩; positivity⟩) (⟨y, hy⟩ : feasibleSet a b)
  rw [← hnorm] at hle
  simpa only [zero_sub, norm_neg] using hle

/-- The analytic core of the integer sign-cell certificate: the minimum is generated by its
active normals. The later determinant step can therefore use only independent active rows. -/
theorem minimum_norm_mem_active_span [Fintype ι] [FiniteDimensional ℝ E]
    (a : ι → E) (b : ι → ℝ) (x : E)
    (hx : x ∈ feasibleSet a b)
    (hmin : ∀ y ∈ feasibleSet a b, ‖x‖ ≤ ‖y‖) :
    x ∈ Submodule.span ℝ (a '' {i | b i = inner ℝ (a i) x}) := by
  let S := Submodule.span ℝ (a '' {i | b i = inner ℝ (a i) x})
  have hxorth : x ∈ Sᗮᗮ := by
    apply (Sᗮ.mem_orthogonal' x).mpr
    intro v hv
    apply minimum_norm_inner_eq_zero a b x v hx hmin
    intro i hi
    exact (S.mem_orthogonal v).mp hv (a i)
      (Submodule.subset_span ⟨i, hi, rfl⟩)
  simpa only [Submodule.orthogonal_orthogonal] using hxorth

end ObjectiveCompression
