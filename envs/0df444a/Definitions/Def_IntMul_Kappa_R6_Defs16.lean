line maps: row `d p^δ` (margin `1-ε-poly`). -/
def FineNeed6 (P : Prm) : Prop :=
  ∀ tab : Fin 1 → IStmt HS 1, IL.SwapNeedτ tab P.τ → IL2.RowUCP 576 P.τ tab → FineU6 tab

/-! ## The line maps (segmented inverse, PR #5) -/

/-- The body of `LineNeed6` in one table. -/
def LineBody6 (P : Prm) (tab : Fin 1 → IStmt HS 1) : Prop :=
  ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (eA eB : Fin (7 + E)) (dS : Fin HS) (C₀ : ℝ)
    (A n₁ : ℕ), dS ≠ 0 ∧ 0 ≤ C₀ ∧
  ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
  ∀ [∀ i, NeZero (sD6 src D i)] [∀ i, NeZero (tD6 P n D i)],
  ∃ M : AxisMaps6 (αN6 P n) (sD6 src D) (tD6 P n D),
  ∀ (Isym : List Sym) (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = descLine6 P n src →
    (∀ (zs : List GI) (u : ((i : Fin (D + 1)) → ZMod (sD6 src D i)) → ℂ),
      f 0 = gflat zs ++ l → RepPad (pP6 P n) (sD6 src D) (tD6 P n D) zs u → ‖u‖ ≤ 1 / 2 →
      ∃ (zs' : List GI) (w : ((i : Fin (D + 1)) → ZMod (tD6 P n D i)) → ℂ) (c : ℕ),
        IRuns Isym (IL.kTableP tab ext) (.call eA) (encK s f)
          (encK s (Function.update f 0 (gflat zs' ++ l))) c ∧
        RepFull (pP6 P n) (tD6 P n D) zs' w ∧ GB (pP6 P n + 2) zs' ∧
        ‖w - tensCLM (kerA M.A) u‖ ≤ errW6 P n * hp (pP6 P n) ∧
        (c : ℝ) ≤ C₀ * cU6 P n A) ∧
    (∀ (ys : List GI) (y : ((i : Fin (D + 1)) → ZMod (tD6 P n D i)) → ℂ),
      f 0 = gflat ys ++ l → RepFull (pP6 P n) (tD6 P n D) ys y → ‖y‖ ≤ 1 →
      ∃ (ys' : List GI) (v : ((i : Fin (D + 1)) → ZMod (sD6 src D i)) → ℂ) (c : ℕ),
        IRuns Isym (IL.kTableP tab ext) (.call eB) (encK s f)
          (encK s (Function.update f 0 (gflat ys' ++ l))) c ∧
        RepPad (pP6 P n) (sD6 src D) (tD6 P n D) ys' v ∧ GB (pP6 P n + 2) ys' ∧
        ‖v - tensCLM (kerB M.B) y‖ ≤ errW6 P n * hp (pP6 P n) ∧
        (c : ℝ) ≤ C₀ * cU6 P n A)

/-- **`LineNeed6`: the line maps of the source transform** (steps 3a and 3c of §9.5), on the
arrays exactly as the machine holds them (as the frozen `KFM.LineNeed`): `A` lines take the padded
`s`-box function `u` to the full `t`-box function `≈ (⊗ A_i) u`, `B₀` lines take `y` to the padded
`≈ (⊗ B_i) y`, for per-axis exact maps `M : AxisMaps6` fixed per `n` (and source list) before the
input. Implementation: PR #5's chirped-correlation Gaussian for `S'`/`A`, the segmented inverse
(exact q-LU / Woodbury) for `B₀`, each axis exposed by `FineU6`.

Cost row: `d p^δ` (Gaussian line maps, margin `1-ε-poly`); the statement allows `C₀ · cU6`. -/
def LineNeed6 (P : Prm) : Prop :=
  ∀ tab : Fin 1 → IStmt HS 1, IL.SwapNeedτ tab P.τ → IL2.RowUCP 576 P.τ tab → FineU6 tab →
    LineBody6 P tab

/-! ## Proposition 14 and Proposition 18 -/

/-- The body of `P18IL6` in one table (the frozen `KFM.P18IL` at the round-six parameters). -/
def P18Body6 (P : Prm) (tab : Fin 1 → IStmt HS 1) : Prop :=
  ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (entry : Fin (7 + E)) (dS : Fin HS)
    (C₀ : ℝ) (A n₁ : ℕ), dS ≠ 0 ∧ 0 ≤ C₀ ∧
  ∀ (Isym : List Sym) (n : ℕ), n₁ ≤ n →
  ∀ (ts : List ℕ), ts.length + 1 = dP6 P n → (∀ t ∈ ts, t = rP6 P n ∨ 2 * t = rP6 P n) →
    ts.prod * rP6 P n = TP6 P n →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zf zg : List GI) (l : List ℤ)
    (xf xg : List (Fin (rP6 P n) → ℂ)),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = desc18 (pP6 P n) (ℓP6 P n) (KP6 P n) ts →
    f 0 = gflat zf ++ gflat zg ++ l →
    RecRep (rP6 P n) (pP6 P n) zf xf → RecRep (rP6 P n) (pP6 P n) zg xg →
    xf.length = ts.prod → xg.length = ts.prod →
    GB (pP6 P n + 2) zf → GB (pP6 P n + 2) zg →
    (∀ x ∈ xf, ‖x‖ ≤ 1) → (∀ x ∈ xg, ‖x‖ ≤ 1) →
    ∃ (zh : List GI) (xh : List (Fin (rP6 P n) → ℂ)) (c : ℕ),
      IRuns Isym (IL.kTableP tab ext) (.call entry) (encK s f)
        (encK s (Function.update f 0 (gflat zh ++ l))) c ∧
      RecRep (rP6 P n) (pP6 P n) zh xh ∧ xh.length = ts.prod ∧ GB (pP6 P n + 2) zh ∧
      (∀ j < ts.prod, ∀ k : Fin (rP6 P n),
        ‖xh.getD j 0 k - (mrL (rP6 P n) ts xf xg).getD j 0 k‖ ≤ errW6 P n * hp (pP6 P n)) ∧
      (c : ℝ) ≤ C₀ * cU6 P n A

/-- **`P18IL6`: Proposition 18 in IL at the round-six parameters**, built on the uniform
Prop 14 (`IL3.P14UH' tab Ew P.lamp` with a guard `EwOK6`). Data: two row-major arrays of
`N = ∏ t_i` records of `r` Gaussian coefficients (`RecRep r p`, norm `≤ 1`); result within
`errW6 · 2^{-p}` of `M_r(f, g) = (f ∗ g)/(r N)`; descriptor `desc18 p ℓ K ts`.

Cost rows: the `ℓ` simultaneous butterfly rounds `ℓ d^λ'` (margin `ε(1-λ')`), the prefix moves `d`
(`1-ε`), the packed products `ℓ + log₂ p` (`ε`) and the precision `p^δ`. The statement allows
`C₀ · cU6`. -/
def P18IL6 (P : Prm) : Prop :=
  ∀ (tab : Fin 1 → IStmt HS 1) (Ew : ℕ → ℕ), EwOK6 P Ew → IL3.P14UH' tab Ew P.lamp →
    IL.SwapNeedτ tab P.τ → IL2.RowUCP 576 P.τ tab → FineU6 tab → P18Body6 P tab

end

end IntMul.Kappa.R6

