/-!
# B-line IL, B1 (streaming slab pass) §2: registers, lanes, the unit loops

**Register convention** (fixed stacks, all below `56`, none `0`; the caller's data elsewhere is
preserved, since every scratch stack is restored):

| stack | role |
|---|---|
| `rK1 = 41`, `rK2 = 42` | constants of the item programs (inputs, preserved) |
| `0` | lane 1 input (the stream; the rest `l` below it is kept), and the output |
| `rZ = 53` | lane 2 input (the second array of the zipped output pass) |
| `rT = 50`, `rT2 = 51` | lane temps (scratch) |
| `rC = 45` | the control list `flatC cs` (input, preserved) |
| `rCU = 47`, `rOP = 48`, `rARG = 49`, `rACC = 52` | scratch: used commands, current command, output |
| `rNB = 37`, `rNC = 38`, `rM = 39`, `rTOT = 40` | inputs (one value each, preserved): `pre`, `|cs|`, `m`, the output length |
| `43, 46, 54` | scratch of the item programs (§5) |
| `34, 35, 36` | the `rptX` counters (`lA lC lD`) |

`55` (`ARGM`) is the multiplication argument stack. A *lane layout* `lin inp tmp G` puts the
remaining input units `inp` and the moved units `tmp` on the lane stacks over the managed state
`G`; `LaneOK lin` says it leaves the skeleton registers alone. The unit programs (`rd`, `bk`, `dr`,
`it`) are abstract with their specifications (`RdOK`, `BkOK`, `DrOK`, `ItOK`).

Here: the managed-state op lemmas, `cf3_encK` (the `rptX` counters over a managed state), and the
loops over one slab: `dropL_runs` (drop `m` units), `zeroL_runs` (emit `m` zeros), `copyL_runs`
(move `m` units to the temps while emitting `g a u`), `backL_runs` (move them back).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD rptXU_runs)
open NLogN.KFT (cf3 rptX)

/-! ## Managed-state operations -/

section ops
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem encK_upd' (s : IState HS) (F : Fin HS → List ℤ) (i : Fin HS) (l : List ℤ) :
    (encK s F).upd i (ints l ++ s.G i) = encK s (update F i l) := by
  refine IState.ext' (fun x => ?_) rfl rfl
  by_cases h : x = i
  · subst h; simp
  · simp [h]

theorem constM (s : IState HS) (F : Fin HS → List ℤ) (i : Fin HS) (c : ℤ) :
    IRuns I iprog (.op (.const i c)) (encK s F) (encK s (update F i (c :: F i))) (zsz c + 2) := by
  have h := IRuns.const (I := I) (iprog := iprog) (s := encK s F) i c
  refine h.mono' ?_ le_rfl
  rw [show (Item.int c :: (encK s F).G i) = ints (c :: F i) ++ s.G i by simp [ints], encK_upd']

/-- The `rptX` counters over a managed state with empty counter stacks. -/
theorem cf3_encK (s : IState HS) (F : Fin HS → List ℤ) (hA : F lA = []) (hC : F lC = [])
    (hD : F lD = []) (LA LC LD : List Item) :
    cf3 (encK s F) lA lC lD LA LC LD = encK (cf3 s lA lC lD LA LC LD) F := by
  unfold cf3
  refine IState.ext' (fun x => ?_) rfl rfl
  by_cases e1 : x = lD
  · subst e1; simp [hD]
  · by_cases e2 : x = lC
    · subst e2; simp [hC]
    · by_cases e3 : x = lA
      · subst e3; simp [hA]
      · simp [e1, e2, e3]

end ops

/-! ## Lanes -/

/-! ## The slab loops -/

section loops
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)} {OkU : U → Prop}

theorem lin_skel (hL : LaneOK lin) {j : Fin HS} (hj : j ∈ skel) (inp tmp : List U)
    (G : Fin HS → List ℤ) : lin inp tmp G j = G j := hL.rd j hj inp tmp G

/-- The counter stacks of a lane state. -/
theorem lin_cnt (hL : LaneOK lin) (inp tmp : List U) (G : Fin HS → List ℤ)
    (hA : G lA = []) (hC : G lC = []) (hD : G lD = []) :
    lin inp tmp G lA = [] ∧ lin inp tmp G lC = [] ∧ lin inp tmp G lD = [] := by
  refine ⟨?_, ?_, ?_⟩
  · rw [hL.rd lA (by simp [skel]) inp tmp G, hA]
  · rw [hL.rd lC (by simp [skel]) inp tmp G, hC]
  · rw [hL.rd lD (by simp [skel]) inp tmp G, hD]

/-- A loop over `m` steps on lane states, the counter `X` (a skeleton register). -/
theorem laneLoopX (hL : LaneOK lin) {X : Fin HS} (hX : X ∈ skel) (hXA : X ≠ lA)
    (body : IStmt HS P) (c m : ℕ) (s : IState HS)
    (Ln : ℕ → List U) (Lt : ℕ → List U) (Gk : ℕ → Fin HS → List ℤ)
    (hA : ∀ k, Gk k lA = []) (hC : ∀ k, Gk k lC = []) (hD : ∀ k, Gk k lD = [])
    {LM : List ℤ} (hM : Gk 0 X = (m : ℤ) :: LM)
    (hb : ∀ k < m, ∀ s', IRuns I iprog body (encK s' (lin (Ln k) (Lt k) (Gk k)))
      (encK s' (lin (Ln (k + 1)) (Lt (k + 1)) (Gk (k + 1)))) c) :
    IRuns I iprog (rptX X lA lC lD body) (encK s (lin (Ln 0) (Lt 0) (Gk 0)))
      (encK s (lin (Ln m) (Lt m) (Gk m))) ((m + 1) * (c + 3000)) := by
  have hcnt := fun k => lin_cnt hL (Ln k) (Lt k) (Gk k) (hA k) (hC k) (hD k)
  refine rptXU_runs (I := I) (iprog := iprog) (X := X) hXA m
    (fun k => encK s (lin (Ln k) (Lt k) (Gk k)))
    (fun k => by simp only [encK_G, (hcnt k).1, (hcnt 0).1])
    (fun k => by simp only [encK_G, (hcnt k).2.1, (hcnt 0).2.1])
    (fun k => by simp only [encK_G, (hcnt k).2.2, (hcnt 0).2.2]) body c ?_ (ints LM ++ s.G X) ?_
  · intro k hk LA LC LD
    rw [cf3_encK s _ (hcnt k).1 (hcnt k).2.1 (hcnt k).2.2,
      cf3_encK s _ (hcnt (k + 1)).1 (hcnt (k + 1)).2.1 (hcnt (k + 1)).2.2]
    exact hb k hk _
  · simp only [encK_G, lin_skel hL hX, hM, ints, List.map_cons, List.cons_append]

/-- The `rM` loop. -/
theorem laneLoop (hL : LaneOK lin) (body : IStmt HS P) (c m : ℕ) (s : IState HS)
    (Ln : ℕ → List U) (Lt : ℕ → List U) (Gk : ℕ → Fin HS → List ℤ)
    (hA : ∀ k, Gk k lA = []) (hC : ∀ k, Gk k lC = []) (hD : ∀ k, Gk k lD = [])
    {LM : List ℤ} (hM : Gk 0 rM = (m : ℤ) :: LM)
    (hb : ∀ k < m, ∀ s', IRuns I iprog body (encK s' (lin (Ln k) (Lt k) (Gk k)))
      (encK s' (lin (Ln (k + 1)) (Lt (k + 1)) (Gk (k + 1)))) c) :
    IRuns I iprog (rptX rM lA lC lD body) (encK s (lin (Ln 0) (Lt 0) (Gk 0)))
      (encK s (lin (Ln m) (Lt m) (Gk m))) ((m + 1) * (c + 3000)) :=
  laneLoopX hL (by simp [skel]) (by decide) body c m s Ln Lt Gk hA hC hD hM hb

/-- **Drop `m` units.** -/
theorem dropL_runs (hL : LaneOK lin) {dr : IStmt HS P} {cdr : ℕ}
    (hdr : DrOK (I := I) (iprog := iprog) lin OkU dr cdr) (s : IState HS) (G : Fin HS → List ℤ)
    (hA : G lA = []) (hC : G lC = []) (hD : G lD = []) {m : ℕ} {LM : List ℤ}
    (hM : G rM = (m : ℤ) :: LM) (S inp tmp : List U) (hS : S.length = m) (hok : ∀ u ∈ S, OkU u) :
    IRuns I iprog (rptX rM lA lC lD dr) (encK s (lin (S ++ inp) tmp G)) (encK s (lin inp tmp G))
      ((m + 1) * (cdr + 3000)) := by
  subst hS
  have H := laneLoop (I := I) (iprog := iprog) hL dr cdr S.length s (fun k => S.drop k ++ inp)
    (fun _ => tmp) (fun _ => G) (fun _ => hA) (fun _ => hC) (fun _ => hD) hM ?_
  · simpa using H
  · intro k hk s'
    have e : S.drop k = S[k] :: S.drop (k + 1) := List.drop_eq_getElem_cons (by omega)
    rw [e, List.cons_append]
    exact hdr s' G S[k] (S.drop (k + 1) ++ inp) tmp (hok _ (List.getElem_mem _))

/-- **Emit `m` zeros.** -/
theorem zeroL_runs (hL : LaneOK lin) (s : IState HS) (G : Fin HS → List ℤ)
    (hA : G lA = []) (hC : G lC = []) (hD : G lD = []) {m : ℕ} {LM : List ℤ}
    (hM : G rM = (m : ℤ) :: LM) (inp tmp : List U) :
    IRuns I iprog (rptX rM lA lC lD (.op (.const rACC 0))) (encK s (lin inp tmp G))
      (encK s (lin inp tmp (update G rACC (List.replicate m 0 ++ G rACC))))
      ((m + 1) * (2 + 3000)) := by
  have hACC : rACC ∈ skel := by simp [skel]
  have H := laneLoop (I := I) (iprog := iprog) hL (.op (.const rACC 0)) 2 m s (fun _ => inp)
    (fun _ => tmp) (fun k => update G rACC (List.replicate k 0 ++ G rACC))
    (fun k => (Function.update_of_ne (by decide) _ _).trans hA)
    (fun k => (Function.update_of_ne (by decide) _ _).trans hC)
    (fun k => (Function.update_of_ne (by decide) _ _).trans hD)
    ((Function.update_of_ne (by decide) _ _).trans hM) ?_
  · simpa using H
  · intro k hk s'
    have h := constM (I := I) (iprog := iprog) s' (lin inp tmp (update G rACC
      (List.replicate k 0 ++ G rACC))) rACC 0
    refine h.mono' ?_ (by simp [zsz_zero])
    rw [lin_skel hL hACC, ← hL.up rACC hACC]
    simp [List.replicate_succ]

/-- **Copy `m` units to the temps, emitting `g a u` for each.** -/
theorem copyL_runs (hL : LaneOK lin) {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop}
    {g : ℤ → U → ℤ} {rd it : IStmt HS P}
    {crd cit : ℕ} (hrd : RdOK (I := I) (iprog := iprog) lin OkU rd crd)
    (hit : ItOK (I := I) (iprog := iprog) lin OkU OkA KG g it cit) (s : IState HS)
    (G : Fin HS → List ℤ) (hK : ∀ v, KG (update G rACC v)) (hA : G lA = []) (hC : G lC = []) (hD : G lD = []) {m : ℕ}
    {LM : List ℤ} (hM : G rM = (m : ℤ) :: LM) {a : ℤ} {LR : List ℤ} (hR : G rARG = a :: LR)
    (ha : OkA a) (S inp tmp : List U) (hS : S.length = m) (hok : ∀ u ∈ S, OkU u) :
    IRuns I iprog (rptX rM lA lC lD (.seq rd it)) (encK s (lin (S ++ inp) tmp G))
      (encK s (lin inp (S.reverse ++ tmp) (update G rACC ((S.map (g a)).reverse ++ G rACC))))
      ((m + 1) * (crd + cit + 3000)) := by
  subst hS
  have hACC : rACC ∈ skel := by simp [skel]
  have H := laneLoop (I := I) (iprog := iprog) hL (.seq rd it) (crd + cit) S.length s
    (fun k => S.drop k ++ inp) (fun k => (S.take k).reverse ++ tmp)
    (fun k => update G rACC (((S.take k).map (g a)).reverse ++ G rACC))
    (fun k => (Function.update_of_ne (by decide) _ _).trans hA)
    (fun k => (Function.update_of_ne (by decide) _ _).trans hC)
    (fun k => (Function.update_of_ne (by decide) _ _).trans hD)
    ((Function.update_of_ne (by decide) _ _).trans hM) ?_
  · simpa using H
  · intro k hk s'
    have e : S.drop k = S[k] :: S.drop (k + 1) := List.drop_eq_getElem_cons (by omega)
    have et : S.take (k + 1) = S.take k ++ [S[k]] := List.take_succ_eq_append_getElem (by omega)
    have hu := hok _ (List.getElem_mem (show k < S.length by omega))
    try simp only []
    rw [e, List.cons_append]
    have h1 := hrd s' (update G rACC (((S.take k).map (g a)).reverse ++ G rACC)) S[k]
      (S.drop (k + 1) ++ inp) ((S.take k).reverse ++ tmp) hu
    have h2 := hit s' (update G rACC (((S.take k).map (g a)).reverse ++ G rACC)) S[k]
      (S.drop (k + 1) ++ inp) ((S.take k).reverse ++ tmp) a LR hu ha
      ((Function.update_of_ne (by decide) _ _).trans hR) (hK _)
    refine (h1.seq h2).mono' ?_ le_rfl
    simp only [Function.update_idem, Function.update_self, et, List.map_append, List.reverse_append,
      List.map_cons, List.map_nil, List.reverse_cons, List.reverse_nil, List.nil_append,
      List.append_assoc, List.singleton_append, List.cons_append]

/-- **Move `m` units back from the temps.** -/
theorem backL_runs (hL : LaneOK lin) {bk : IStmt HS P} {cbk : ℕ}
    (hbk : BkOK (I := I) (iprog := iprog) lin OkU bk cbk) (s : IState HS) (G : Fin HS → List ℤ)
    (hA : G lA = []) (hC : G lC = []) (hD : G lD = []) {m : ℕ} {LM : List ℤ}
    (hM : G rM = (m : ℤ) :: LM) (R inp tmp : List U) (hR : R.length = m) (hok : ∀ u ∈ R, OkU u) :
    IRuns I iprog (rptX rM lA lC lD bk) (encK s (lin inp (R ++ tmp) G))
      (encK s (lin (R.reverse ++ inp) tmp G)) ((m + 1) * (cbk + 3000)) := by
  subst hR
  have H := laneLoop (I := I) (iprog := iprog) hL bk cbk R.length s
    (fun k => (R.take k).reverse ++ inp) (fun k => R.drop k ++ tmp) (fun _ => G)
    (fun _ => hA) (fun _ => hC) (fun _ => hD) hM ?_
  · simpa using H
  · intro k hk s'
    have e : R.drop k = R[k] :: R.drop (k + 1) := List.drop_eq_getElem_cons (by omega)
    have et : R.take (k + 1) = R.take k ++ [R[k]] := List.take_succ_eq_append_getElem (by omega)
    have hu := hok _ (List.getElem_mem (show k < R.length by omega))
