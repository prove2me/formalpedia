theorem bf_general_degree_d_proof (e n m a s c : ℕ) (hm : 2 * m = (e + 2) * n)
    (hn : 2 * a ≤ n) (hs : 5 * c * a ≤ (((e + 2) + 3) * c + 1) * s) :
