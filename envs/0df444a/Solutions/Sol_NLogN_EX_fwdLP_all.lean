  have a1 := RS.pushCost_le_lin (.reg i) t B trivial (by simp [Ex.Bnd, IState.top, ti, hxB])
  have a2 : ((RS.push j (.reg i)).run t).top i = x := by
    simp [RS.run, IState.top, IState.upd_G, ti, hij]
  simp only [mvBody, RS.cost]
  rw [a2]
  simp only [Ex.size] at a1
  omega

