theorem SInv_zero : SInv src N 0 :=
  ⟨fun s hs => absurd hs (Nat.not_lt_zero _), fun u _ _ =>
    ⟨src u, ⟨0, rfl, Nat.zero_le _, fun i hi => absurd hi (Nat.not_lt_zero _)⟩, rfl⟩⟩

theorem xT_eq {t : ℕ} (ht : t < N) (H : SInv src N t) :
    ∃ k, src^[k] (src t) = xT src N t ∧ t ≤ xT src N t ∧ (∀ i < k, src^[i] (src t) < t) ∧
      NLogN.KFV.piS src N t (xT src N t) = src t := by
  obtain ⟨z, ⟨k, h1, h2, h3⟩, hz⟩ := H.2 t le_rfl ht
  have hk := FH_bound src hsrc hinj ht le_rfl h3
  have e : xT src N t = z := chF_FH src N (src t) z k h1 h2 h3 hk.le
  rw [e]; exact ⟨k, h1, h2, h3, hz⟩

theorem SInv_succ {t : ℕ} (ht : t < N) (H : SInv src N t) : SInv src N (t + 1) := by
  obtain ⟨k2, a1, a2, a3, a4⟩ := xT_eq hsrc hinj ht H
  set x := xT src N t with hx
  refine ⟨fun s hs => ?_, fun u hu1 hu2 => ?_⟩
  · show NLogN.KFV.piS src N t (NLogN.KFV.swF t x s) = src s
    unfold NLogN.KFV.swF
    by_cases e : s = t
    · subst e; rw [if_pos rfl]; exact a4
    · rw [if_neg e, if_neg (by omega)]; exact H.1 s (by omega)
  · obtain ⟨z, ⟨k1, b1, b2, b3⟩, hz⟩ := H.2 u (by omega) hu2
    have hzx : z ≠ x := by
      intro e; rw [e, a4] at hz
      have := hinj t ht u hu2 hz; omega
    by_cases hzt : z = t
    · -- the wanted chunk of `u` sat at `t` and moved to `x`
      subst hzt
      have hxt : x ≠ z := fun e => hzx e.symm
      refine ⟨x, ⟨k2 + (1 + k1), ?_, by omega, fun i hi => ?_⟩, ?_⟩
      · rw [Function.iterate_add_apply, Function.iterate_add_apply, b1]; simpa using a1
      · by_cases c1 : i < k1
        · exact lt_trans (b3 i c1) (by omega)
        · by_cases c2 : i = k1
          · subst c2; rw [b1]; omega
          · have : i = (i - (1 + k1)) + (1 + k1) := by omega
            rw [this, Function.iterate_add_apply, Function.iterate_add_apply, b1]
            have := a3 (i - (1 + k1)) (by omega)
            simp only [Function.iterate_one]; omega
      · show NLogN.KFV.piS src N z (NLogN.KFV.swF z x x) = src u
        unfold NLogN.KFV.swF; rw [if_neg hxt, if_pos rfl]; exact hz
    · refine ⟨z, ⟨k1, b1, by omega, fun i hi => lt_trans (b3 i hi) (by omega)⟩, ?_⟩
      show NLogN.KFV.piS src N t (NLogN.KFV.swF t x z) = src u
      unfold NLogN.KFV.swF; rw [if_neg hzt, if_neg hzx]; exact hz

theorem SInv_all : ∀ t ≤ N, SInv src N t
  | 0, _ => SInv_zero hsrc hinj
  | t + 1, h => SInv_succ hsrc hinj (by omega) (SInv_all t (by omega))

/-- **After `N` steps every position holds its target.** -/
theorem piS_final {s : ℕ} (hs : s < N) : NLogN.KFV.piS src N N s = src s :=
  (SInv_all hsrc hinj N le_rfl).1 s hs

end SelSort

section Lists

variable (src : ℕ → ℕ) (N : ℕ) (am : List (List ℕ)) (K : ℕ) (Lst : List ℕ)

theorem getD_arr (g : ℕ → List ℕ) (hg : ∀ s < N, (g s).length = K) {b o : ℕ} (hb : b < N)
    (ho : o < K) :
    (Lst ++ ((List.range N).map g).flatten).getD (Lst.length + (b * K + o)) 0 = (g b).getD o 0 := by
  rw [getD_append_eq, if_neg (by omega), Nat.add_sub_cancel_left,
    getD_flatten_uniform 0 _ (fun c hc => by
      simp only [List.mem_map, List.mem_range] at hc
      obtain ⟨s, hs, rfl⟩ := hc; exact hg s hs) b o ho]
  have : ((List.range N).map g).getD b [] = g b := by
    rw [List.getD_eq_getElem _ _ (by simpa using hb)]; simp
  rw [this]

theorem length_arr (g : ℕ → List ℕ) (hg : ∀ s < N, (g s).length = K) :
    (Lst ++ ((List.range N).map g).flatten).length = Lst.length + N * K := by
  rw [List.length_append, length_flatten_uniform _ (fun c hc => by
    simp only [List.mem_map, List.mem_range] at hc
    obtain ⟨s, hs, rfl⟩ := hc; exact hg s hs)]
  simp

variable {src N} (hsrc : ∀ x < N, src x < N)
  (hinj : ∀ x < N, ∀ y < N, src x = src y → x = y)

include hsrc hinj in
theorem piS_lt : ∀ t ≤ N, ∀ s < N, NLogN.KFV.piS src N t s < N
  | 0, _, s, hs => hs
  | t + 1, ht, s, hs => by
    show NLogN.KFV.piS src N t (NLogN.KFV.swF t (xT src N t) s) < N
    apply piS_lt t (by omega)
    have := xT_lt hsrc hinj (t := t) (by omega)
    unfold NLogN.KFV.swF; split_ifs <;> omega

variable {am K Lst} (ham : ∀ c ∈ am, c.length = K) (hamN : am.length = N)
include hsrc hinj ham hamN

theorem blk_len (t : ℕ) (ht : t ≤ N) : ∀ s < N, (am.getD (NLogN.KFV.piS src N t s) []).length = K := by
  intro s hs
  have := piS_lt hsrc hinj t ht s hs
  rw [List.getD_eq_getElem _ _ (by omega)]
  exact ham _ (List.getElem_mem _)

/-- **One step of the chunk sort is one bit-level exchange.** -/
theorem arrC_step {t : ℕ} (ht : t < N) :
    applyN (opT src N K Lst t) (arrC src N am Lst t) = arrC src N am Lst (t + 1) := by
  have hx1 := xT_ge hsrc hinj (src := src) ht
  have hx2 := xT_lt hsrc hinj (src := src) ht
  set x := xT src N t with hxd
  have B0 := blk_len hsrc hinj ham hamN t ht.le
  have B1 := blk_len hsrc hinj ham hamN (t + 1) ht
  have e1 : ∀ s, NLogN.KFV.piS src N (t + 1) s = NLogN.KFV.piS src N t (NLogN.KFV.swF t x s) := fun s => rfl
  unfold opT
  by_cases hxt : x = t
  · rw [if_pos hxt]
    simp only [applyN, List.foldl_nil, arrC]
    congr 3; funext s; rw [e1]; congr 2; unfold NLogN.KFV.swF; split_ifs <;> omega
  rw [if_neg hxt]
  simp only [applyN, List.foldl_cons, List.foldl_nil, LOp.idx]
  unfold arrC
  have hK : 0 < K ∨ K = 0 := by omega
  rcases hK with hK | hK
  swap
  · subst hK
    apply List.ext_getElem (by rw [length_permIdx, length_arr _ _ _ _ B0, length_arr _ _ _ _ B1])
    intro p h1 h2
    rw [getElem_permIdx, ← List.getD_eq_getElem _ 0 h2]
    have hp : p < Lst.length := by
      rw [length_permIdx, length_arr _ _ _ _ B0] at h1; simpa using h1
    unfold bsIdx
    simp only [Nat.mul_zero, Nat.add_zero]
    rw [if_neg (by omega), if_neg (by omega), getD_append_eq, getD_append_eq, if_pos hp, if_pos hp]
  apply List.ext_getElem (by rw [length_permIdx, length_arr _ _ _ _ B0, length_arr _ _ _ _ B1])
  intro p h1 h2
  rw [getElem_permIdx, ← List.getD_eq_getElem _ 0 h2]
  have hlen : p < Lst.length + N * K := by rw [length_permIdx, length_arr _ _ _ _ B0] at h1; exact h1
  by_cases hp : p < Lst.length
  · unfold bsIdx
    rw [if_neg (by omega), if_neg (by omega), getD_append_eq, getD_append_eq, if_pos hp, if_pos hp]
  obtain ⟨b, o, ho, rfl⟩ : ∃ b o, o < K ∧ p = Lst.length + (b * K + o) :=
    ⟨(p - Lst.length) / K, (p - Lst.length) % K, Nat.mod_lt _ hK, by
      have := Nat.div_add_mod' (p - Lst.length) K; omega⟩
  have hb : b < N := by
    by_contra hb
    have : N * K ≤ b * K := Nat.mul_le_mul_right _ (by omega)
    omega
  rw [getD_arr N K Lst _ B1 hb ho]
  have hxt' : t < x := by omega
  by_cases c1 : b = t
  · subst c1
    have e : bsIdx (Lst.length + b * K) (Lst.length + x * K) K (Lst.length + (b * K + o)) =
        Lst.length + (x * K + o) := by unfold bsIdx; rw [if_pos (by omega)]; omega
    rw [e, getD_arr N K Lst _ B0 hx2 ho, e1]
    unfold NLogN.KFV.swF; rw [if_pos rfl]
  by_cases c2 : b = x
  · rw [c2]
    have e : bsIdx (Lst.length + t * K) (Lst.length + x * K) K (Lst.length + (x * K + o)) =
        Lst.length + (t * K + o) := by
      unfold bsIdx
      have : t * K + K ≤ x * K := by
        have := Nat.mul_le_mul_right K (show t + 1 ≤ x by omega); rwa [Nat.succ_mul] at this
      rw [if_neg (by omega), if_pos (by omega)]; omega
    rw [e, getD_arr N K Lst _ B0 ht ho, e1]
    unfold NLogN.KFV.swF; rw [if_neg (by omega), if_pos rfl]
  · have e : bsIdx (Lst.length + t * K) (Lst.length + x * K) K (Lst.length + (b * K + o)) =
        Lst.length + (b * K + o) := by
      unfold bsIdx
      have h3 : ¬ (t * K ≤ b * K + o ∧ b * K + o < t * K + K) := by
        rintro ⟨h4, h5⟩
        rcases Nat.lt_or_gt_of_ne c1 with h6 | h6
        · have := Nat.mul_le_mul_right K (show b + 1 ≤ t by omega); rw [Nat.succ_mul] at this; omega
        · have := Nat.mul_le_mul_right K (show t + 1 ≤ b by omega); rw [Nat.succ_mul] at this; omega
      have h3' : ¬ (x * K ≤ b * K + o ∧ b * K + o < x * K + K) := by
        rintro ⟨h4, h5⟩
        rcases Nat.lt_or_gt_of_ne c2 with h6 | h6
        · have := Nat.mul_le_mul_right K (show b + 1 ≤ x by omega); rw [Nat.succ_mul] at this; omega
        · have := Nat.mul_le_mul_right K (show x + 1 ≤ b by omega); rw [Nat.succ_mul] at this; omega
      rw [if_neg (by omega), if_neg (by omega)]
    rw [e, getD_arr N K Lst _ B0 hb ho, e1]
    unfold NLogN.KFV.swF; rw [if_neg c1, if_neg c2]

theorem applyN_xch_upto : ∀ t ≤ N,
    applyN ((List.range t).flatMap (opT src N K Lst)) (arrC src N am Lst 0) = arrC src N am Lst t
  | 0, _ => by simp [applyN]
  | t + 1, ht => by
    rw [List.range_succ, List.flatMap_append, applyN_append,
      applyN_xch_upto t (by omega)]
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    exact arrC_step hsrc hinj ham hamN (by omega)

/-- **The chunk sort.** -/
theorem applyN_xchOps :
    applyN (xchOps src N K Lst) (Lst ++ am.flatten) =
      Lst ++ ((List.range N).map fun s => am.getD (src s) []).flatten := by
  have e0 : arrC src N am Lst 0 = Lst ++ am.flatten := by
    unfold arrC
    congr 2
    apply List.ext_getElem (by simp [hamN])
    intro k h1 h2
    simp only [List.getElem_map, List.getElem_range, NLogN.KFV.piS, id]
    rw [List.getD_eq_getElem _ _ h2]
  have eN : arrC src N am Lst N = Lst ++ ((List.range N).map fun s => am.getD (src s) []).flatten := by
    unfold arrC
    congr 2
    apply List.map_congr_left
    intro s hs
    rw [piS_final hsrc hinj (List.mem_range.1 hs)]
  rw [← e0, ← eN]
  exact applyN_xch_upto hsrc hinj ham hamN N le_rfl

end Lists

section PaperChunks

variable (D ℓ K : ℕ) (long : Fin D → Bool)

theorem srcT_lt {q t : ℕ} (ht : t < D * q) : NLogN.KFV.srcT D q t < D * q := by
  unfold NLogN.KFV.srcT
  have hD : 0 < D := Nat.pos_of_ne_zero (by rintro rfl; simp at ht)
  have h1 : t / D < q := by rw [Nat.div_lt_iff_lt_mul hD]; rwa [Nat.mul_comm]
  have h2 : t % D + 1 ≤ D := Nat.mod_lt _ hD
  have : (t % D + 1) * q ≤ D * q := Nat.mul_le_mul_right _ h2
  rw [Nat.add_mul] at this; omega

theorem axisMajor_getD (i : Fin D) {j : ℕ} (hj : j < Synth.qq ℓ K) :
    (axisMajor D ℓ K).getD (i * Synth.qq ℓ K + j) [] = Synth.chunk D ℓ K i j := by
  unfold axisMajor
  rw [List.flatMap_def, getD_flatten_uniform [] _ (fun c hc => by
    simp only [List.mem_map, List.mem_finRange, true_and] at hc
    obtain ⟨a, rfl⟩ := hc; simp) i j hj]
  have e1 : ((List.finRange D).map fun i => (List.range (Synth.qq ℓ K)).map (Synth.chunk D ℓ K i)).getD i [] =
      (List.range (Synth.qq ℓ K)).map (Synth.chunk D ℓ K i) := by
    rw [List.getD_eq_getElem _ _ (by simp)]; simp
  rw [e1, List.getD_eq_getElem _ _ (by simpa using hj)]
  simp

theorem chunkMajor_getD [NeZero D] {s : ℕ} (hs : s < D * Synth.qq ℓ K) :
    (chunkMajor D ℓ K).getD s [] =
      Synth.chunk D ℓ K ⟨s % D, Nat.mod_lt _ (Nat.pos_of_ne_zero (NeZero.ne D))⟩ (s / D) := by
  have hD : 0 < D := Nat.pos_of_ne_zero (NeZero.ne D)
  have h1 : s / D < Synth.qq ℓ K := by rw [Nat.div_lt_iff_lt_mul hD]; rwa [Nat.mul_comm]
  unfold chunkMajor
  rw [List.flatMap_def]
  conv_lhs => rw [← Nat.div_add_mod' s D]
  rw [getD_flatten_uniform [] _ (fun c hc => by
    simp only [List.mem_map, List.mem_range] at hc
    obtain ⟨a, -, rfl⟩ := hc; simp) _ _ (Nat.mod_lt _ hD)]
  have e1 : ((List.range (Synth.qq ℓ K)).map fun j => (List.finRange D).map fun i => Synth.chunk D ℓ K i j).getD
      (s / D) [] = (List.finRange D).map fun i => Synth.chunk D ℓ K i (s / D) := by
    rw [List.getD_eq_getElem _ _ (by simpa using h1)]; simp
  rw [e1, List.getD_eq_getElem _ _ (by simp; exact Nat.mod_lt _ hD)]
  simp only [List.getElem_map, List.getElem_finRange]
  rfl

theorem length_chunkMajor : (chunkMajor D ℓ K).length = D * Synth.qq ℓ K := by
  simp [chunkMajor, List.length_flatMap, List.sum_replicate, Nat.mul_comm]

theorem chunkMajor_eq [NeZero D] :
    chunkMajor D ℓ K =
      (List.range (D * Synth.qq ℓ K)).map fun s => (axisMajor D ℓ K).getD (NLogN.KFV.srcT D (Synth.qq ℓ K) s) [] := by
  have hD : 0 < D := Nat.pos_of_ne_zero (NeZero.ne D)
  apply List.ext_getElem (by simp [length_chunkMajor])
  intro s h1 h2
  have hs : s < D * Synth.qq ℓ K := by rwa [length_chunkMajor] at h1
  rw [← List.getD_eq_getElem _ [] h1, chunkMajor_getD D ℓ K hs]
  simp only [List.getElem_map, List.getElem_range, NLogN.KFV.srcT]
  have h3 : s / D < Synth.qq ℓ K := by rw [Nat.div_lt_iff_lt_mul hD]; rwa [Nat.mul_comm]
  rw [axisMajor_getD D ℓ K ⟨s % D, Nat.mod_lt _ hD⟩ h3]

/-- **The schedule reaches Lemma 16's layout.** -/
theorem applyN_layOps [NeZero D] (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    applyN (layOps D ℓ K long) (initL D ℓ long) = tgtL D ℓ K long := by
  unfold layOps
  rw [applyN_append, applyN_moves12 D ℓ K long hK hℓ]
  have e : (List.finRange D).flatMap (restA D ℓ K) = (axisMajor D ℓ K).flatten := by
    unfold axisMajor
    rw [flatten_flatMap']
    apply List.flatMap_congr; intro i _
    exact (flatten_chunks K (restA D ℓ K i) (Synth.qq ℓ K) (Synth.length_restA D ℓ K i)).symm
  rw [e, applyN_xchOps (fun x hx => srcT_lt D hx) (fun x hx y hy h => srcT_inj D hx hy h)
    (fun c hc => by obtain ⟨i, j, hj, rfl⟩ := (mem_axisMajor D ℓ K).1 hc; exact Synth.length_chunk D ℓ K i hj)
    (length_axisMajor D ℓ K), ← chunkMajor_eq]
  rfl

end PaperChunks

end NLogN.KFV

