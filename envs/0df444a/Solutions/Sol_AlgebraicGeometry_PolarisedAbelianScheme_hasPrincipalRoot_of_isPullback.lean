theorem solution
    {g d n : ℕ} {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (u : PolarisedAbelianScheme g d n S) (u' : PolarisedAbelianScheme g d n S')
    (h : PolarisedAbelianScheme.IsPullback φ u u') (hu : PolarisedAbelianScheme.HasPrincipalRoot u) :
    PolarisedAbelianScheme.HasPrincipalRoot u' := by
  classical
  obtain ⟨gA, hg, hmul, -, ⟨epol⟩⟩ := h
  obtain ⟨S₂, _, _, hff, hS₂⟩ := hu
  letI algS' : Algebra S S' := φ.toAlgebra
  haveI := hff

  let L₂ := u.L.baseChange (Spec.map (CommRingCat.ofHom (algebraMap S S₂)))
  have hL₂ : ∀ (T : Scheme.{0}) (t' : T ⟶ Spec (CommRingCat.of S₂))
      (P Q : SchemeHomOver t' (pullback.snd u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₂))))),
      (L₂.mul t' P Q).1 ≫ pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₂))) =
        (u.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap S S₂)))
          ⟨P.1 ≫ pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₂))),
            by rw [Category.assoc, pullback.condition, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₂))),
            by rw [Category.assoc, pullback.condition, ← Category.assoc, Q.2]⟩).1 :=
    fun T t' P Q => pullback.lift_fst _ _ _
  obtain ⟨𝓛₀, a, b, hab, hinv, hker, hloc⟩ := hS₂ L₂ hL₂

  let ι : S₂ →+* S' ⊗[S] S₂ := (Algebra.TensorProduct.includeRight (R := S) (A := S') (B := S₂)).toRingHom
  have hbase : (algebraMap S' (S' ⊗[S] S₂)).comp φ = ι.comp (algebraMap S S₂) := by
    ext s
    change algebraMap S' (S' ⊗[S] S₂) (algebraMap S S' s) =
      Algebra.TensorProduct.includeRight (R := S) (A := S') (B := S₂) (algebraMap S S₂ s)
    rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
  have hbase' : Spec.map (CommRingCat.ofHom ι) ≫ Spec.map (CommRingCat.ofHom (algebraMap S S₂)) =
      Spec.map (CommRingCat.ofHom (algebraMap S' (S' ⊗[S] S₂))) ≫ Spec.map (CommRingCat.ofHom φ) := by
    rw [RTBC.specMap_comp', RTBC.specMap_comp', hbase]
  refine ⟨S' ⊗[S] S₂, inferInstance, inferInstance, inferInstance, ?_⟩
  intro L'' hL''

  let ρ : pullback u'.f (Spec.map (CommRingCat.ofHom (algebraMap S' (S' ⊗[S] S₂)))) ⟶
      pullback u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₂))) :=
    pullback.lift (pullback.fst _ _ ≫ gA) (pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom ι))
      (by rw [Category.assoc, hg.w, ← Category.assoc, pullback.condition, Category.assoc, Category.assoc, hbase'])
  have hρ1 : ρ ≫ pullback.fst _ _ = pullback.fst _ _ ≫ gA := pullback.lift_fst _ _ _
  have hρ2 : ρ ≫ pullback.snd u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₂))) =
      pullback.snd u'.f (Spec.map (CommRingCat.ofHom (algebraMap S' (S' ⊗[S] S₂)))) ≫ Spec.map (CommRingCat.ofHom ι) :=
    pullback.lift_snd _ _ _
  have hP : IsPullback ρ (pullback.snd u'.f (Spec.map (CommRingCat.ofHom (algebraMap S' (S' ⊗[S] S₂)))))
      (pullback.snd u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₂)))) (Spec.map (CommRingCat.ofHom ι)) :=
    RSBCKit.isPullback_of_lift hg _ _ _ hbase'.symm ρ hρ1 hρ2
  have hom : ∀ (T : Scheme.{0}) (t' : T ⟶ Spec (CommRingCat.of (S' ⊗[S] S₂)))
      (P Q : SchemeHomOver t' (pullback.snd u'.f (Spec.map (CommRingCat.ofHom (algebraMap S' (S' ⊗[S] S₂)))))),
      (L''.mul t' P Q).1 ≫ ρ =
        (L₂.mul (t' ≫ Spec.map (CommRingCat.ofHom ι))
          ⟨P.1 ≫ ρ, by rw [Category.assoc, hρ2, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ ρ, by rw [Category.assoc, hρ2, ← Category.assoc, Q.2]⟩).1 := by
    intro T t' P Q
    apply pullback.hom_ext
    · rw [Category.assoc, hρ1, ← Category.assoc, hL'' T t' P Q, hmul, hL₂]
      exact RSBCKit.mul_val_congr u.L (by rw [Category.assoc, Category.assoc, hbase']) _ _ _ _
        (by simp only [Category.assoc, hρ1]) (by simp only [Category.assoc, hρ1])
    · have l : ((L''.mul t' P Q).1 ≫ ρ) ≫ pullback.snd u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₂))) =
          t' ≫ Spec.map (CommRingCat.ofHom ι) := by
        rw [Category.assoc, hρ2, ← Category.assoc, (L''.mul t' P Q).2]
      rw [l, (L₂.mul _ _ _).2]

  refine ⟨(Scheme.Modules.pullback ρ).obj 𝓛₀, a, b, hab, hinv.pullback ρ,
    RSBCKit.kernelTrivial_of_isPullback L₂ L'' (Spec.map (CommRingCat.ofHom ι)) ρ hρ2 hom hP 𝓛₀ hinv hker, ?_⟩
  have H := AlgebraicGeometry.Polarisation.LocIsoOnBase.pullback_of_comp_eq
    (g := pullback.snd u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₂))))
    (pullback.snd u'.f (Spec.map (CommRingCat.ofHom (algebraMap S' (S' ⊗[S] S₂))))) ρ (Spec.map (CommRingCat.ofHom ι)) hρ2 hloc
  have I1 : (Scheme.Modules.pullback ρ).obj
      ((Scheme.Modules.pullback (pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap S S₂))))).obj u.pol) ≅
      (Scheme.Modules.pullback (pullback.fst u'.f (Spec.map (CommRingCat.ofHom (algebraMap S' (S' ⊗[S] S₂)))))).obj u'.pol :=
    (Scheme.Modules.pullbackComp ρ _).app u.pol ≪≫ (Scheme.Modules.pullbackCongr hρ1).app u.pol ≪≫
      ((Scheme.Modules.pullbackComp _ gA).app u.pol).symm ≪≫ (Scheme.Modules.pullback _).mapIso epol
  have hneg := RSBCKit.negMor_comp L₂ L'' (Spec.map (CommRingCat.ofHom ι)) ρ hρ2 hom
  have Ineg : (Scheme.Modules.pullback ρ).obj ((Scheme.Modules.pullback (negMor _ L₂)).obj 𝓛₀) ≅
      (Scheme.Modules.pullback (negMor _ L'')).obj ((Scheme.Modules.pullback ρ).obj 𝓛₀) :=
    (Scheme.Modules.pullbackComp ρ (negMor _ L₂)).app 𝓛₀ ≪≫ (Scheme.Modules.pullbackCongr hneg.symm).app 𝓛₀ ≪≫
      ((Scheme.Modules.pullbackComp (negMor _ L'') ρ).app 𝓛₀).symm
  have I2 : (Scheme.Modules.pullback ρ).obj
      (Scheme.Modules.tpow 𝓛₀ a ⊗ Scheme.Modules.tpow ((Scheme.Modules.pullback (negMor _ L₂)).obj 𝓛₀) b) ≅
      Scheme.Modules.tpow ((Scheme.Modules.pullback ρ).obj 𝓛₀) a ⊗
        Scheme.Modules.tpow ((Scheme.Modules.pullback (negMor _ L'')).obj ((Scheme.Modules.pullback ρ).obj 𝓛₀)) b :=
    Scheme.Modules.pullbackTensorObjIso ρ _ _ ≪≫
      (RTBC.tpowPullbackIso ρ 𝓛₀ a ⊗ᵢ (RTBC.tpowPullbackIso ρ _ b ≪≫ RTBC.tpowCongr Ineg b))
  exact (AlgebraicGeometry.Polarisation.LocIsoOnBase.equivalence _).trans (RSBCKit.locIsoOnBase_of_iso _ I1.symm)
    ((AlgebraicGeometry.Polarisation.LocIsoOnBase.equivalence _).trans H (RSBCKit.locIsoOnBase_of_iso _ I2))

end S_AlgebraicGeometry_PolarisedAbelianScheme_hasPrincipalRoot_of_isPullback
