    · have hGN := hG N
      simp only [NLogN.RS.repSt] at hGN
      simp only [NLogN.RS.run, NLogN.RS.repSt, ← hN]
      rw [hGN]; rfl
    · have hz : zsz (n.eval s - N) = 0 := by rw [hNv, sub_self, zsz_zero]
