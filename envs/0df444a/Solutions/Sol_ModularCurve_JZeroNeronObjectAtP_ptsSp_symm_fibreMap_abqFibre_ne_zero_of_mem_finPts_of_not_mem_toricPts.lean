theorem solution
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (Λ : JZeroNeronObjectAtP.LevelData N₀ p A) (hΛ : Λ.IsJacobian)
    (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ)
    (x : JZero (N₀ * p)) (hxfin : x ∈ O.finPts p)
    (hK0 : degeneracyPushforwardPair N₀ p 0 x = 0) (hK1 : degeneracyPushforwardPair N₀ p 1 x = 0)
    (hxt : x ∉ O.toricPts p)
    (s : SchemeHomOver Λ.σA O.g) (hs : (O.pts x).1 = barPt A ≫ s.1) :
    Λ.ptsSp.symm (fibreMap (O.abqFibre 0) (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s)) ≠ 0 ∨
      Λ.ptsSp.symm (fibreMap (O.abqFibre 1) (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s)) ≠ 0 := by
  by_contra h
  simp only [not_or, not_ne_iff] at h
  have hmem : x ∈ trivLocus O :=
    ⟨((ModularCurve.JZeroNeronObjectAtP.mem_finPts_iff O p x).mp hxfin).1, ⟨s, hs, h.1, h.2⟩, hK0, hK1⟩
  rw [trivLocus_eq_toricPts hΛ O] at hmem
  exact hxt hmem

