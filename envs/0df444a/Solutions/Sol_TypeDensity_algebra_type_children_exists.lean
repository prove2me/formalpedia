theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] (A : Type) [CommRing A] [Algebra O A] (n : ℕ) (B : Fin n → Type)
    [∀ j, CommRing (B j)] [∀ j, Algebra O (B j)] (ψ : A →ₐ[O] ∀ j, B j)
    (hinj : Function.Injective ψ) (ℓ : ℕ)
    (hℓ : Module.length O ((∀ j, B j) ⧸ LinearMap.range ψ.toLinearMap) = ℓ) (σ : TypeDensity.FactorType)
    (hσ : TypeDensity.HasAlgebraType O A σ) :
    ∀ j, ∃ τ : TypeDensity.FactorType, TypeDensity.HasAlgebraType O (B j) τ := by
  have hb := TypeDensity.baseChange_bijective_of_finite_cokernel O A (∀ j, B j) ψ.toLinearMap hinj ℓ hℓ
  have hfun : ∀ x, (Algebra.TensorProduct.map (AlgHom.id (TypeDensity.BaseField O) (TypeDensity.BaseField O)) ψ) x
      = LinearMap.baseChange (TypeDensity.BaseField O) ψ.toLinearMap x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul k a => simp
    | add x y hx hy => rw [map_add, map_add, hx, hy]
  have hΨ : Function.Bijective
      (Algebra.TensorProduct.map (AlgHom.id (TypeDensity.BaseField O) (TypeDensity.BaseField O)) ψ) := by
    have : ⇑(Algebra.TensorProduct.map (AlgHom.id (TypeDensity.BaseField O) (TypeDensity.BaseField O)) ψ)
        = ⇑(LinearMap.baseChange (TypeDensity.BaseField O) ψ.toLinearMap) := funext hfun
    rw [this]; exact hb
  exact TypeDensity.algebra_type_pi_factor O A n B (AlgEquiv.ofBijective _ hΨ) σ hσ
