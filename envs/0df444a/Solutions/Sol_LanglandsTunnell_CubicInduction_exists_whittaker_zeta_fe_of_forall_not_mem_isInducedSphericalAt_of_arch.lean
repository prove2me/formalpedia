variable (K : Type) [Field K] [NumberField K]

private theorem isUnramifiedCharAt_of_mul {μ χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} {𝔓 : HeightOneSpectrum (𝓞 K)}
    (h : IsUnramifiedCharAt (μ * χ) 𝔓) (hχ : IsUnramifiedCharAt χ 𝔓) : IsUnramifiedCharAt μ 𝔓 := by
  intro t ht ht'
  have h1 : TateGlobal.localChar (μ * χ) 𝔓 t = 1 := h t ht ht'
  have h2 : TateGlobal.localChar χ 𝔓 t = 1 := hχ t ht ht'
  have hmul : TateGlobal.localChar (μ * χ) 𝔓 t = TateGlobal.localChar μ 𝔓 t * TateGlobal.localChar χ 𝔓 t := rfl
  rw [hmul, h2, mul_one] at h1
  exact h1

private theorem not_isUnramifiedCharAt_of_inducedCoeff_eq_zero [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (𝔓 : HeightOneSpectrum (𝓞 K)) (h : inducedCoeff K μ 𝔓 = 0) :
    ¬ IsUnramifiedCharAt μ 𝔓 := by
  intro hun
  rw [inducedCoeff, if_pos hun] at h
  exact Units.ne_zero _ h

private theorem forall_not_isUnramifiedCharAt_of_prod_localLFactorAt_eq
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ))
    {n : ℕ} (ν : Fin n → ((v.adicCompletion ℚ)ˣ →* ℂˣ)) (a : Fin n → ℕ)
    (ha : ∀ i, 1 ≤ a i ∧ TateLocal.HasConductorExponentAt ℚ v (ν i) (a i))
    (hL : ∀ s : ℂ, (∏ i, TateLocal.localLFactorAt ℚ v (ν i) s) =
      ((inducedEulerPoly ℚ (inducedCoeff K μ) v).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹) :
    ∀ 𝔓 ∈ primeFibre ℚ K v, ¬ IsUnramifiedCharAt μ 𝔓 := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  set Pμ : ℂ[X] := inducedEulerPoly ℚ (inducedCoeff K μ) v with hPμ

  have h1 : ∀ s : ℂ, Pμ.eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)) = 1 := by
    intro s
    have h := hL s
    rw [prod_localLFactorAt_eq_one v ν a ha s] at h
    exact inv_eq_one.mp h.symm

  have hN1 : 1 < (Ideal.absNorm v.asIdeal : ℝ) := by
    exact_mod_cast NumberField.HeightOneSpectrum.one_lt_absNorm v
  have hN0 : ((Ideal.absNorm v.asIdeal : ℕ) : ℂ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (by have := NumberField.HeightOneSpectrum.one_lt_absNorm v; omega)
  have hlog : Complex.log ((Ideal.absNorm v.asIdeal : ℕ) : ℂ) ≠ 0 := by
    rw [← Complex.natCast_log]
    exact_mod_cast (Real.log_pos hN1).ne'
  have hw : ∀ w : ℂ, w ≠ 0 → Pμ.eval w = 1 := by
    intro w hw
    have h := h1 (-(Complex.log w / Complex.log ((Ideal.absNorm v.asIdeal : ℕ) : ℂ)))
    rwa [neg_neg, Complex.cpow_def_of_ne_zero hN0, mul_div_cancel₀ _ hlog, Complex.exp_log hw] at h

  have hP1 : Pμ = 1 := by
    haveI : Infinite ℂ := Infinite.of_injective ((↑) : ℕ → ℂ) Nat.cast_injective
    refine Polynomial.eq_of_infinite_eval_eq Pμ 1 ?_
    refine (Set.finite_singleton (0 : ℂ)).infinite_compl.mono fun w hw0 => ?_
    have hw0' : w ≠ 0 := fun h => hw0 (Set.mem_singleton_iff.mpr h)
    show Pμ.eval w = (1 : ℂ[X]).eval w
    rw [hw w hw0', eval_one]

  have hfin := FibreDegree.primeFibre_finite K v
  have hprod : (∏ 𝔓 ∈ hfin.toFinset,
      (C 1 - C (inducedCoeff K μ 𝔓) * X ^ (v.asIdeal.inertiaDeg' 𝔓.asIdeal) : ℂ[X])) = 1 := by
    rw [← hP1, hPμ, inducedEulerPoly, finprod_mem_eq_finite_toFinset_prod _ hfin]
    refine Finset.prod_congr rfl fun 𝔓 h𝔓 => ?_
    have hu : 𝔓.under (𝓞 ℚ) = v := hfin.mem_toFinset.mp h𝔓
    rw [inducedFactor, hu]
  have hzero := forall_eq_zero_of_prod_one_sub_C_mul_X_pow_eq_one hfin.toFinset (fun 𝔓 => inducedCoeff K μ 𝔓)
    (fun 𝔓 => v.asIdeal.inertiaDeg' 𝔓.asIdeal)
    (fun 𝔓 h𝔓 => FibreDegree.inertiaDeg_pos_of_mem_primeFibre K v 𝔓 (hfin.mem_toFinset.mp h𝔓)) hprod
  intro 𝔓 h𝔓
  exact not_isUnramifiedCharAt_of_inducedCoeff_eq_zero K μ 𝔓 (hzero 𝔓 (hfin.mem_toFinset.mpr h𝔓))

private theorem inducedEulerPoly_mul_eq_one_of_forall_not_isUnramifiedCharAt
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (μ χN : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ))
    (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, ¬ IsUnramifiedCharAt μ 𝔓)
    (hχ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt χN 𝔓) :
    inducedEulerPoly ℚ (inducedCoeff K (μ * χN)) v = 1 := by
  unfold inducedEulerPoly
  refine finprod_mem_of_eqOn_one fun 𝔓 h𝔓 => ?_
  have hram : ¬ IsUnramifiedCharAt (μ * χN) 𝔓 :=
    fun hun => hμ 𝔓 h𝔓 (isUnramifiedCharAt_of_mul K hun (hχ 𝔓 h𝔓))
  show inducedFactor ℚ (inducedCoeff K (μ * χN)) 𝔓 = 1
  rw [inducedFactor, inducedCoeff, if_neg hram, C_0, zero_mul, sub_zero, C_1]

private theorem inv_eval_inducedEulerPoly_mul_eq_one
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (μ χN : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ))
    (hμ : ∀ 𝔓 ∈ primeFibre ℚ K v, ¬ IsUnramifiedCharAt μ 𝔓)
    (hχ : ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt χN 𝔓) (z : ℂ) :
    ((inducedEulerPoly ℚ (inducedCoeff K (μ * χN)) v).eval z)⁻¹ = 1 := by
  rw [inducedEulerPoly_mul_eq_one_of_forall_not_isUnramifiedCharAt K μ χN v hμ hχ, eval_one, inv_one]

end

