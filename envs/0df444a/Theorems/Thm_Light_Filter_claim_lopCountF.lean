theorem Light.Filter.claim_lopCountF : ∃ (C : ℝ) (T : ℕ → ℕ → ℕ → ℝ), LopSolvedIn lopCountTask T ∧
    ∀ n D w : ℕ, 2 ≤ D → D ^ 1249 ≤ n ^ 71 →
      T n D w ≤ C * ((n : ℝ) ^ 2 * Real.log D ^ 2 / (D : ℝ) ^ (0.0703531 : ℝ)
        + (w : ℝ) * (D : ℝ) ^ (0.4296471 : ℝ) * Real.log D + (n : ℝ) * D + w + 1) := by sorry
