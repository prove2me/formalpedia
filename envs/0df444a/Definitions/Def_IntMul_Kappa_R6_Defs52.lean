-- Source module: Solutions.R6BitNBStmt
/-!
# Round six, bit side: the statement `bitNetR6` (interface)

Accepted restatement (coordinator, 2026-10-19): the round-six bit network as a `QHNet` over
`ZMod 2` with `W = 148225616` roles and `m = 529`, valid runs, admissible Bruhat data and formal
frame correctness at every power of every large prime, and Jain's histogram. Consumed through
`prop11H_formal`.

`bitNetR6_mom` is the moment-dominance variant (all that `prop11H_formal` / `costH_bound` use):
it follows from `bitNetR6` (`bitNetR6_mom_of`).

This file holds the statements only (sorry-free). The pending `bitNetR6` lives in
`R6BitNBStmtX`; `bitNetR6_mom` is proved in `R6BitNBNetE`.
-/

namespace IntMul.Kappa.R6.Bit

/-- **Moment-dominance variant.** -/
def BitNetR6MomStmt : Prop :=
  ∃ (T : ℕ) (C : QHNet (ZMod 2) 148225616 T 529) (q₀ : ℕ), C.RunsOK ∧
    (∀ q, q.Prime → q₀ < q → ∀ f, C.EdgesOK (q ^ f) ∧ C.FormalOK (q ^ f)) ∧
    ∀ τ : ℝ, 0 < τ → τ ≤ 1 → histMoment C.hist 529 τ ≤ histMoment Jain.bitR6 529 τ

end IntMul.Kappa.R6.Bit

end

section
-- Source module: R6Pk.R6BitNBNetE
/-!
# Round six, bit network: the child-width histogram and `BitNetR6MomStmt`

Every edge of the network contributes the moment of its runs: side edges of rank `r` give
`f (2r - 23) + (23 - r) f 1` (`2r > 23`) or `r f 1`, aux edges `f 23 + f 483`, data edges
`f 439 + f 21 + 24 f 1`. The per-rank move counts of the two stage words are the base-`2³²` digits
of the kernel-checked packed counts `CNs1`, `CNs2` (no overflow: `touch1`, `touch2`). The total
moment equals Jain's `bitR6` moment.
-/

set_option linter.unusedSectionVars false
set_option maxRecDepth 10000
set_option linter.constructorNameAsVariable false

namespace IntMul.Kappa.R6.Bit.NB

open Matrix R6Chk R6Chk.Bit R6Chk.Bit.Loc AModel AModelFac

/-! ## Generic list facts -/

/-! ## Edge moments -/

section Mom

variable (τ : ℝ)

noncomputable def fw (w : ℕ) : ℝ := ((w : ℝ) / 529) ^ τ

noncomputable def EM (e : Edge 529) : ℝ := (e.runs.map fun ρ => fw τ ρ.2.2).sum

noncomputable def sideV (r : ℕ) : ℝ :=
  if 23 < 2 * r then fw τ (2 * r - 23) + ((23 - r : ℕ) : ℝ) * fw τ 1 else (r : ℝ) * fw τ 1

noncomputable def auxV : ℝ := fw τ 23 + fw τ 483

noncomputable def dataV : ℝ := fw τ 439 + fw τ 21 + 24 * fw τ 1

end Mom

