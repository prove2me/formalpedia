  let j₀ : Localization.Away ((D : ℕ) : ℤ) →+* O₀ := IsLocalization.Away.lift ((D : ℕ) : ℤ) hNu

  let i : Localization.Away ((D : ℕ) : ℤ) →+* ↥𝔅 := j.comp j₀
  have huniq : ∀ {P : Type} [CommRing P] (f g : Localization.Away ((D : ℕ) : ℤ) →+* P), f = g :=
    fun f g => IsLocalization.ringHom_ext (Submonoid.powers (((D : ℕ) : ℤ))) (RingHom.ext_int _ _)
  have hi : ∀ s : ↥(𝔅.decompositionSubgroup ℚ),
      (MulSemiringAction.toRingHom (↥(𝔅.decompositionSubgroup ℚ)) ↥𝔅 s).comp i = i := fun s => huniq _ _
  have hsbar : w.sbar = Spec.map (CommRingCat.ofHom (𝔅.subtype.comp i)) := by
    obtain ⟨φ, hφ⟩ := Spec.map_surjective w.sbar
    rw [← hφ]
