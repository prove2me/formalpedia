  classical

  obtain ⟨hCONST, hEQfin, hEQfix, hEQlin, hBRdist, hBRanch, hjK, hjC, a₀, ha₀y, e₀, he₀, h, hh, hhunit, hHC⟩ := hW₁

  have hqA : (q : A) ≠ 0 := by
    intro h0
    have : (q : L) = 0 := by
