    (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hqq' : q' ≠ q)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    [DecidableEq (IsLocalRing.ResidueField ↥A)] [CharP (IsLocalRing.ResidueField ↥A) q]
    [Fintype ↥(ssPlaces q (N * q') (IsLocalRing.ResidueField ↥A))]
    (X : SSLevelDatum q (IsLocalRing.ResidueField ↥A) N q')
    (n₁ : Nat.Primes → ℤ) (hcol₁ : ∀ ℓ : Nat.Primes, HeckeRowSums (X.edgeHecke ℓ).transpose (n₁ ℓ)) :
    letI := heckeModuleBar (N * q' * q)
    ∃ ε : ↥(toricMonodromyPart (J := JZero (N * q' * q)) q (A.inertiaSubgroupIn ℚ)) ≃+
        (↥(characterLattice ↥(ssPlaces q (N * q') (IsLocalRing.ResidueField ↥A))) →+
          Additive (IsLocalRing.ResidueField ↥A)ˣ),
      ∀ (ℓ : Nat.Primes)
        (y : ↥(toricMonodromyPart (J := JZero (N * q' * q)) q (A.inertiaSubgroupIn ℚ)))
        (x : ↥(characterLattice ↥(ssPlaces q (N * q') (IsLocalRing.ResidueField ↥A)))),
        ε (heckeGen ℓ • y) x = ε y (heckeCharacterAction (X.edgeHecke ℓ).transpose (hcol₁ ℓ) x) := by
  classical
  have hpL : ¬ q ∣ N * q' := by
    intro h
    rcases (Fact.out : q.Prime).dvd_mul.1 h with h | h
    · exact hqN h
    · exact hqq' ((Nat.prime_dvd_prime_iff_eq Fact.out Fact.out).1 h).symm
  have H := exists_cartierAnchor_toricMonodromyPart_ssHeckeFamilyC q (N * q') (N * q' * q) rfl hpL A hA
      X.frobData X.kronecker (X.legsIntegral (N * q'))
  rcases H with ⟨n, hcol, ε, hε, -⟩
  refine ⟨ε, fun ℓ y x => ?_⟩
  have key : heckeCharacterAction (X.edgeHecke ℓ).transpose (hcol₁ ℓ) x =
      heckeCharacterAction (ssHeckeFamilyC q (IsLocalRing.ResidueField ↥A) (N * q') X.frobData X.kronecker
        (X.legsIntegral (N * q')) ℓ).transpose (hcol ℓ) x := rfl
  rw [key]
  exact hε ℓ y x

