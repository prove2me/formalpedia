  obtain ⟨t, ht, htop⟩ := h
  haveI : FiniteDimensional ↥(⊤ : IntermediateField K F) F :=
    IntermediateField.finiteDimensional_top
  exact ⟨t, ht, IntermediateField.finiteDimensional_of_eq htop.symm⟩

