theorem apply_eq_pow_of_pow_eq_one (σ : Γℚ) (ζ : AlgebraicClosure ℚ) (hζ : ζ ^ p = 1) :
    σ ζ = ζ ^ (PadicInt.toZMod (a p σ)).val := by
