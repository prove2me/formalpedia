def halfNormalizationMultiplier (U : ℝ → ℂ) (s : ℝ) : ℂ :=
  U s * (Real.exp (-s / 2) : ℂ)
def halfNormalizationCLM (U : ℝ → ℂ) : 𝓢(ℝ, ℂ) →L[ℝ] 𝓢(ℝ, ℂ) :=
  (SchwartzMap.smulLeftCLM ℂ (halfNormalizationMultiplier U)).restrictScalars ℝ
end JointLogSeparation
