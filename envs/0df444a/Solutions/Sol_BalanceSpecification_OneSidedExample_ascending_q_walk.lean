namespace BalanceSpecification.OneSidedExample
theorem _root_.solution (n k : ℕ) :
    Walk (.q n) (List.replicate k a) (.q (n + k)) := by
  induction k generalizing n with
  | zero => simpa only [List.replicate_zero, Nat.add_zero] using Walk.nil (.q n)
  | succ k ih =>
    simpa only [List.replicate_succ, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
      Walk.cons (.qa n) (ih (n + 1))
end BalanceSpecification.OneSidedExample
