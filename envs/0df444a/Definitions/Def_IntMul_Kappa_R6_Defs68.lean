-- Source module: Solutions.J6SegILPre13
/-!
# B-line IL, pre-tables (B5), part 13: the block iteration (pure)

`bst e x` is the start of the block after the one at `x` (or `x` itself once `x ≥ e`);
`blFrom_succ`: one more round of fuel appends the block at `bst^[k] st` (if `< e`), and
`bst_iter_eq`: `bst^[k] st = st + Σ lengths`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.PreT

open IntMul IntMul.HvdH

section pure
variable (sN tN lam : ℕ)

/-- The next block start. -/
def bst (e x : ℕ) : ℕ := if x < e then x + 1 + J6Seg.enF sN tN lam x else x

/-- The block appended in round `k`. -/
def bAdd (e st k : ℕ) : List (ℕ × ℕ) :=
  if (bst sN tN lam e)^[k] st < e then
    [((bst sN tN lam e)^[k] st, 1 + J6Seg.enF sN tN lam ((bst sN tN lam e)^[k] st))] else []

/-- The sum of the block lengths. -/
def sumL (l : List (ℕ × ℕ)) : ℕ := (l.map Prod.snd).sum

end pure

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre14
/-!
# B-line IL, pre-tables (B5), part 14: the block loop of a chunk

`blkL K Cs Cb = λ rounds (counter Cb) of: if st < e then blkB K Cs`, with `e = min(s, qλ + λ)`
(`q` on `6`). From `st = qλ` it pushes `dsEnc pk b (descsOf … q)` (reading order) onto `K`,
with the block count on `7` and the entry count `sumN` on `8`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

def qE : Ex HS := .add (.mul (.reg 6) (.reg 24)) (.reg 24)
def eE : Ex HS := .sel (.add (.reg 22) (.neg qE)) (.reg 22) qE
def tE : Ex HS := .add (.reg 1) (.neg eE)

/-- The descriptor function of `descsOf`. -/
def dF (T : Tables) (b : ℕ × ℕ) : ℕ × List ℤ × List ℤ :=
  (b.2, (List.range b.2).map (T.am b.1), (List.range b.2).map (T.ap b.1))

section loop
variable (P R sN tN lam aN : ℕ)

/-- The descriptors after `k` rounds. -/
def preD (e st0 k : ℕ) : List (ℕ × List ℤ × List ℤ) :=
  (J6Seg.blFrom sN tN lam e k st0).map (dF (mkTables P R sN tN aN))

/-- The registers after `k` rounds. -/
def bS (v : Fin HS → ℤ) (e st0 k : ℕ) : Fin HS → ℤ :=
  zr (Function.update (Function.update (Function.update v 1 (((bst sN tN lam e)^[k] st0 : ℕ) : ℤ)) 7
    ((preD P R sN tN lam aN e st0 k).length : ℤ)) 8 (J6Seg.KR.sumN (preD P R sN tN lam aN e st0 k) : ℤ))

end loop

end J6Seg.PreT

end

