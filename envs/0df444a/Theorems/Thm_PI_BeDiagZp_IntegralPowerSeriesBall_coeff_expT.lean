variable {p : ℕ} [Fact p.Prime] {σ : Type*}

theorem PI.BeDiagZp.IntegralPowerSeriesBall.coeff_expT (f : MvPowerSeries σ ℂ_[p]) (N : ℕ) (α : σ →₀ ℕ) :
    coeff α (expT f N) = ∑ n ∈ Finset.range N, coeff α (f ^ n) / (n.factorial : ℂ_[p]) := by sorry
