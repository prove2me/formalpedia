namespace RedKerCore

open Function

theorem dichotomy
    {R : Type*} [Ring R] {W : Type*} [AddCommGroup W] [Module R W]
    (n : ℕ) (hn : n ≠ 0)
    (hcount : Nat.card {I : Submodule R R // I ≠ ⊥ ∧ I ≠ ⊤} = n)
    (hdisj : ∀ I I' : Submodule R R, I ≠ ⊥ → I ≠ ⊤ → I' ≠ ⊥ → I' ≠ ⊤ → I ≠ I' → I ⊓ I' = ⊥)
    (f : R →ₗ[R] W) (hf : LinearMap.ker f ≠ ⊥)
    (K : Fin n → Submodule R R) (hKbot : ∀ i, K i ≠ ⊥) (hKtop : ∀ i, K i ≠ ⊤) (hKinj : Function.Injective K) :
    (∃! i, K i ≤ LinearMap.ker f) ∨ ((∀ i, K i ≤ LinearMap.ker f) ∧ LinearMap.range f = ⊥) := by
  classical
  by_cases htop : LinearMap.ker f = ⊤
  · right
    refine ⟨fun i => htop ▸ le_top, ?_⟩
    rw [LinearMap.range_eq_bot, ← LinearMap.ker_eq_top]
    exact htop
  · left

    haveI : Finite {I : Submodule R R // I ≠ ⊥ ∧ I ≠ ⊤} := Nat.finite_of_card_ne_zero (by rw [hcount]; exact hn)
    let Kx : Fin n → {I : Submodule R R // I ≠ ⊥ ∧ I ≠ ⊤} := fun i => ⟨K i, hKbot i, hKtop i⟩
    have hKx : Function.Injective Kx := fun i j h => hKinj (congrArg Subtype.val h)
    have hsurj : Surjective Kx := by
      have hbij := (Finite.injective_iff_surjective_of_equiv
        ((Finite.equivFin _).trans (finCongr (by rw [hcount])) : {I : Submodule R R // I ≠ ⊥ ∧ I ≠ ⊤} ≃ Fin n).symm).1 hKx
      exact hbij
    obtain ⟨i₀, hi₀⟩ := hsurj ⟨LinearMap.ker f, hf, htop⟩
    have hKi₀ : K i₀ = LinearMap.ker f := congrArg Subtype.val hi₀
    refine ⟨i₀, hKi₀.le, fun j hj => ?_⟩

    by_contra hne
    have hne' : K j ≠ K i₀ := fun h => hne (hKinj h)
    have hmeet := hdisj (K j) (K i₀) (hKbot j) (hKtop j) (hKbot i₀) (hKtop i₀) hne'
    rw [hKi₀, inf_eq_left.2 hj] at hmeet
    exact hKbot j hmeet

end RedKerCore
