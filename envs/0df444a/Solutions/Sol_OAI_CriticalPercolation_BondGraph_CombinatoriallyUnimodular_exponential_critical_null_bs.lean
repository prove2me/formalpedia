    ((G.clusterTail_hasFiniteOpenWitness u s).inter (G.clusterTail_hasFiniteOpenWitness v s)
      (G.clusterTail_isUpperSet u s) (G.clusterTail_isUpperSet v s))
    (G.hitEvent_hasFiniteOpenWitness u {v}) p hp C hC hb

