    rw [IntMul.OpenAI.R129.rP, ← pow_succ]; congr 1; omega
  split_ifs <;> rw [e]; simp

theorem crtOK_n {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : CrtOK (IntMul.OpenAI.R129.dP n) (srcN n) (muN n) := by
  have hdp : dpN n ≤ IntMul.OpenAI.R129.dP n := (IntMul.OpenAI.RP.mcnt_lt (IntMul.OpenAI.Glue.LP n) (IntMul.OpenAI.R129.dP n) (by have := (setup_facts hn).2.1; omega)).le
  obtain ⟨-, hcop, -⟩ := srcS_ok_n hn (dpN n) hdp
  refine ⟨fun j hj => by have := (src_facts hn j hj).2.2.1; omega,
    fun i j hi hj hij => hcop ⟨i, hi⟩ ⟨j, hj⟩ (fun e => hij (by simpa using e)), fun j hj => ?_⟩
  have h2 := (src_facts hn j hj).2.2.1
  have hc := (src_facts hn j hj).2.2.2.2
  obtain ⟨-, hm⟩ := mu_spec (prodN n j) (srcN n j) (by omega) hc
  have e : OpenAI.RCRT.Ppre (srcN n) j = prodN n j := rfl
  have hm' : muN n j * prodN n j % srcN n j = 1 % srcN n j := hm
  rw [e, ← ZMod.natCast_mod, hm', ZMod.natCast_mod]
  simp

