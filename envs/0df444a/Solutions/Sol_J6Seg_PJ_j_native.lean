        (F0 Zn (descAx6 P n src D k)))) (encK s0 (F0 Zn (descAx6 P n src D k))) cD) ∧
      ((cU + 2 : ℕ) : ℝ) ≤ cU6 P n A' / (D + 1) ∧
      ((cD + 2 : ℕ) : ℝ) ≤ cU6 P n A' / (D + 1) := by
  obtain ⟨n₁, hAJ⟩ := axJ_ev P hP
  obtain ⟨n₂, hQk⟩ := qok_of P hP
  obtain ⟨n₃, hTab⟩ := TabBnd.tabB6_all P hP
  obtain ⟨n₄, hAs⟩ := r6_aseq P hP
