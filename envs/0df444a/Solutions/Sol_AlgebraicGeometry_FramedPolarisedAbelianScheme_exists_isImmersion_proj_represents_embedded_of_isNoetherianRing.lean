    (X : FramedPolarisedAbelianScheme g N n R) (X' : FramedPolarisedAbelianScheme g N n R'),
    FramedPolarisedAbelianScheme.IsPullback φ.toRingHom X X' →
    (pt R' X').I = Ideal.map (MvPolynomial.map φ.toRingHom) (pt R X).I

variable {n : ℕ} (F : C.FramedPt n)

noncomputable def framedDatum {R : Type} [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R) :
    {y : (Spec (CommRingCat.of R) ⟶ C.Hilb) ×
        (Fin (2 * g + 1) → (Spec (CommRingCat.of R) ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) B))) //
      ∀ i, y.2 i ≫ ProjSpace.π B N = Spec.map (CommRingCat.ofHom (algebraMap B R))} :=
  ⟨(C.ptH R (F.pt R X), fun j => framedSec (B := B) X j), fun j => framedSec_π (B := B) X j⟩

noncomputable def ptW {R : Type} [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R) :
    {s : Spec (CommRingCat.of R) ⟶ C.W₀ // s ≫ C.πW = Spec.map (CommRingCat.ofHom (algebraMap B R))} :=
  Classical.choose ((C.hW R).2 (C.framedDatum F X))

theorem ptW_prH {R : Type} [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R) :
    (C.ptW F X).1 ≫ C.prH = C.ptH R (F.pt R X) := by
  have h := Classical.choose_spec ((C.hW R).2 (C.framedDatum F X))
  exact congrArg (fun y => y.1.1) h

theorem ptW_prY {R : Type} [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R) (j : Fin (2 * g + 1)) :
    (C.ptW F X).1 ≫ C.prY j = framedSec (B := B) X j := by
  have h := Classical.choose_spec ((C.hW R).2 (C.framedDatum F X))
  exact congrFun (congrArg (fun y => y.1.2) h) j

theorem q_ptW {R : Type} [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R) :
    C.q (C.ptW F X).1 = F.pt R X := by
  rw [q, ptW_prH, Equiv.symm_apply_apply]

theorem ptW_eq_iff {R : Type} [CommRing R] [Algebra B R] (X X' : FramedPolarisedAbelianScheme g N n R) :
    (C.ptW F X).1 = (C.ptW F X').1 ↔ F.pt R X = F.pt R X' ∧ ∀ j, framedSec (B := B) X j = framedSec (B := B) X' j := by
  constructor
  · intro h
    refine ⟨(C.ptH R).injective ?_, fun j => ?_⟩
    · rw [← ptW_prH, ← ptW_prH, h]
    · rw [← ptW_prY, ← ptW_prY, h]
  · rintro ⟨hq, hy⟩
    have : C.ptW F X = C.ptW F X' := (C.hW R).1 (by
      apply Subtype.ext; apply Prod.ext
      · show (C.ptW F X).1 ≫ C.prH = (C.ptW F X').1 ≫ C.prH; rw [ptW_prH, ptW_prH, hq]
      · funext j; show (C.ptW F X).1 ≫ C.prY j = (C.ptW F X').1 ≫ C.prY j; rw [ptW_prY, ptW_prY, hy])
    rw [this]

