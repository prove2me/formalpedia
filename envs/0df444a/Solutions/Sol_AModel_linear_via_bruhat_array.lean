lemma decode_encode {sh : Shape} {a : List ℕ} (h : Valid sh a) : decode sh (encode sh a) = a := by
  induction h with
  | nil => rfl
  | @cons x q as sh hx hr ih =>
    have he := encode_lt hr
    have hV : 0 < vol sh := by omega
    simp only [encode, List.headD_cons, List.tail_cons, decode]
    rw [show x * vol sh + encode sh as = encode sh as + vol sh * x by ring,
      Nat.add_mul_div_left _ _ hV, Nat.div_eq_of_lt he, Nat.add_mul_mod_self_left,
      Nat.mod_eq_of_lt he, ih, zero_add, Nat.mod_eq_of_lt hx]

lemma encode_decode {sh : Shape} {m : ℕ} (h : m < vol sh) : encode sh (decode sh m) = m := by
  induction sh generalizing m with
  | nil => simp at h; subst h; rfl
  | cons q sh ih =>
    simp only [vol_cons] at h
    have hV : 0 < vol sh := Nat.pos_of_ne_zero (by rintro h'; simp [h'] at h)
    have hq : m / vol sh < q := (Nat.div_lt_iff_lt_mul hV).2 h
    simp only [decode, encode, List.headD_cons, List.tail_cons, Nat.mod_eq_of_lt hq,
      ih (Nat.mod_lt m hV)]
    exact Nat.div_add_mod' m (vol sh)

