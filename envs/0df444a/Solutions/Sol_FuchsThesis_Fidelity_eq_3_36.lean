set_option maxHeartbeats 400000
namespace QNextPureBatch.QuantumValueGentle
variable {n : Type} [Fintype n] [DecidableEq n]

lemma sqrt_star (A : Matrix n n ℂ) : (CFC.sqrt A)ᴴ=CFC.sqrt A := by
  change star (CFC.sqrt A)=CFC.sqrt A
  exact (CFC.sqrt_nonneg A).star_eq

lemma hs_unitary (U : unitary (Matrix n n ℂ)) (A : Matrix n n ℂ) :
    schattenNorm 2 ((U : Matrix n n ℂ)*A)=schattenNorm 2 A := by
  have hU : (U : Matrix n n ℂ)ᴴ*(U : Matrix n n ℂ)=1 := Unitary.coe_star_mul_self U
  rw [QNextPureBatch.RecoverySchatten.schatten_two,QNextPureBatch.RecoverySchatten.schatten_two]
  congr 2
  rw [conjTranspose_mul,Matrix.mul_assoc,← Matrix.mul_assoc (U : Matrix n n ℂ)ᴴ (U : Matrix n n ℂ),hU,Matrix.one_mul]

lemma product_bound (X Y : Matrix n n ℂ) :
    traceNorm (X*Y) ≤ schattenNorm 2 X*schattenNorm 2 Y := by
  obtain ⟨U,hU,hu⟩ := (variational (X*Y)).1
  rw [hu]
  have ht : ((X*Y)*U).trace=((U*X)*Y).trace := trace_mul_cycle X Y U
  rw [ht]
  exact (QNextPureBatch.RecoveryTraceBounds.trace_hilbert_schmidt_bound (U*X) Y).trans_eq
    (by rw [hs_unitary ⟨U,hU⟩ X])

lemma hs_adjoint (A : Matrix n n ℂ) : schattenNorm 2 Aᴴ=schattenNorm 2 A := by
  rw [QNextPureBatch.RecoverySchatten.schatten_two,QNextPureBatch.RecoverySchatten.schatten_two,
    conjTranspose_conjTranspose,trace_mul_comm A Aᴴ]

lemma positive_product_trace (A B : Matrix n n ℂ) (hA : A.PosSemidef) (hB : B.PosSemidef) :
    0 ≤ (A*B).trace.re := by
  have hh := (hB.mul_mul_conjTranspose_same (CFC.sqrt A)).trace_nonneg
  rw [sqrt_star,trace_mul_cycle,CFC.sqrt_mul_sqrt_self A hA.nonneg] at hh
  exact (Complex.nonneg_iff.mp hh).1

lemma gentle (ρ L : Matrix n n ℂ) (hρ : IsDensityOperator ρ)
    (hL : L.PosSemidef) (hLI : (1-L).PosSemidef) (ε : ℝ) (hε : 0 ≤ ε)
    (hdet : 1-ε ≤ (L*ρ).trace.re) :
    traceNorm (ρ-CFC.sqrt L*ρ*CFC.sqrt L) ≤ 2*Real.sqrt ε := by
  let S := CFC.sqrt L
  let T := CFC.sqrt ρ
  have hS : Sᴴ=S := sqrt_star L
  have hT : Tᴴ=T := sqrt_star ρ
  have hS2 : S*S=L := CFC.sqrt_mul_sqrt_self L hL.nonneg
  have hT2 : T*T=ρ := CFC.sqrt_mul_sqrt_self ρ hρ.1.nonneg
  have hS0 : 0 ≤ S := CFC.sqrt_nonneg L
  have hS1 : S ≤ 1 := by
    have hh := CFC.sqrt_le_sqrt L 1 (sub_nonneg.mp hLI.nonneg)
    simpa only [CFC.sqrt_one] using hh
  have hc : Commute S (1-S) := (Commute.one_right S).sub_right (Commute.refl S)
  have hSL : (S-L).PosSemidef := by
    have hh := hc.mul_nonneg hS0 (sub_nonneg.mpr hS1)
    rw [Matrix.mul_sub,Matrix.mul_one,hS2] at hh
    exact hh.posSemidef
  let p : ℝ := (S*ρ*S).trace.re
  let s : ℝ := (S*ρ).trace.re
  let d : ℝ := ((1-S)*ρ*(1-S)).trace.re
  have hp : p=(L*ρ).trace.re := by dsimp [p]; rw [trace_mul_cycle,hS2]
  have hp0 : 0 ≤ p := by
    have hh := (hρ.1.mul_mul_conjTranspose_same S).trace_nonneg
    rw [hS] at hh
    exact (Complex.nonneg_iff.mp hh).1
  have hp1 : p ≤ 1 := by
    have hh := positive_product_trace (1-L) ρ hLI hρ.1
    rw [Matrix.sub_mul,Matrix.one_mul,trace_sub,hρ.2,Complex.sub_re,Complex.one_re,← hp] at hh
    linarith
  have hsp : p ≤ s := by
    have hh := positive_product_trace (S-L) ρ hSL hρ.1
    rw [Matrix.sub_mul,trace_sub,Complex.sub_re,← hp] at hh
    exact sub_nonneg.mp hh
  have hd0 : 0 ≤ d := by
    have hh := (hρ.1.mul_mul_conjTranspose_same (1-S)).trace_nonneg
    rw [conjTranspose_sub,conjTranspose_one,hS] at hh
    exact (Complex.nonneg_iff.mp hh).1
  have hd : d=1-2*s+p := by
    have he : (1-S)*ρ*(1-S)=ρ-S*ρ-ρ*S+S*ρ*S := by noncomm_ring
    have hc' : (ρ*S).trace=(S*ρ).trace := trace_mul_comm _ _
    dsimp [d,p,s]
    rw [he,trace_add,trace_sub,trace_sub,hρ.2,hc']
    simp only [Complex.add_re,Complex.sub_re,Complex.one_re]
    ring
  have hdε : d ≤ ε := by rw [← hp] at hdet; linarith
  let X := (1-S)*T
  let Y := T
  let Z := S*T
  have hXX : X*Xᴴ=(1-S)*ρ*(1-S) := by
    dsimp [X]
    rw [conjTranspose_mul,hT,conjTranspose_sub,conjTranspose_one,hS]
    simp only [Matrix.mul_assoc]
    rw [← Matrix.mul_assoc T T,hT2]
  have hZZ : Z*Zᴴ=S*ρ*S := by
    dsimp [Z]
    rw [conjTranspose_mul,hT,hS]
    simp only [Matrix.mul_assoc]
    rw [← Matrix.mul_assoc T T,hT2]
  have hx : schattenNorm 2 X=Real.sqrt d := by
    rw [← hs_adjoint X,QNextPureBatch.RecoverySchatten.schatten_two,conjTranspose_conjTranspose,hXX]
  have hxa : schattenNorm 2 Xᴴ=Real.sqrt d := by rw [hs_adjoint,hx]
  have hy : schattenNorm 2 Y=1 := by
    rw [QNextPureBatch.RecoverySchatten.schatten_two,hT,hT2,hρ.2]
    norm_num
  have hz : schattenNorm 2 Z=Real.sqrt p := by
    rw [← hs_adjoint Z,QNextPureBatch.RecoverySchatten.schatten_two,conjTranspose_conjTranspose,hZZ]
  have hf : ρ-S*ρ*S=X*Y+Z*Xᴴ := by
    calc
      ρ-S*ρ*S=T*T-S*(T*T)*S := by rw [hT2]
      _=X*Y+Z*Xᴴ := by
        dsimp [X,Y,Z]
        rw [conjTranspose_mul,hT,conjTranspose_sub,conjTranspose_one,hS]
        noncomm_ring
  have hb := (triangle (X*Y) (Z*Xᴴ)).trans (add_le_add (product_bound X Y) (product_bound Z Xᴴ))
  rw [hx,hxa,hy,hz,mul_one] at hb
  have hpR : Real.sqrt p ≤ 1 := Real.sqrt_le_one.mpr hp1
  have hmul := mul_le_mul_of_nonneg_right hpR (Real.sqrt_nonneg d)
  have hdR := Real.sqrt_le_sqrt hdε
  change traceNorm (ρ-S*ρ*S) ≤ _
  rw [hf]
  nlinarith

end QNextPureBatch.QuantumValueGentle

end

noncomputable section
open Matrix WildeQIT
open scoped MatrixOrder ComplexOrder ComplexConjugate
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
namespace QNextPureBatch.QuantumNextPure
variable {n : Type} [Fintype n] [DecidableEq n]
lemma projector (ψ : n → ℂ) (hψ : star ψ ⬝ᵥ ψ=1) :
    CFC.sqrt (vecMulVec ψ (star ψ))=vecMulVec ψ (star ψ) ∧
      (vecMulVec ψ (star ψ)).trace=1 := by
  have hp := posSemidef_vecMulVec_self_star ψ
  have h2 : vecMulVec ψ (star ψ)*vecMulVec ψ (star ψ)=vecMulVec ψ (star ψ) := by
    rw [vecMulVec_mul_vecMulVec,hψ,one_smul]
  refine ⟨(CFC.sqrt_eq_iff _ _ hp.nonneg hp.nonneg).mpr h2,?_⟩
  rw [trace_vecMulVec,dotProduct_comm,hψ]

lemma sandwich (ψ0 ψ1 : n → ℂ) :
    vecMulVec ψ1 (star ψ1)*vecMulVec ψ0 (star ψ0)*vecMulVec ψ1 (star ψ1)=
      ((‖star ψ0 ⬝ᵥ ψ1‖^2 : ℝ) : ℂ) • vecMulVec ψ1 (star ψ1) := by
  rw [vecMulVec_mul_vecMulVec,vecMulVec_mul_vecMulVec,smul_dotProduct,smul_eq_mul,vecMulVec_smul]
  congr 1
  rw [star_dotProduct ψ1 ψ0,Complex.star_def,← Complex.normSq_eq_conj_mul_self,
    Complex.normSq_eq_norm_sq]

theorem pure_formula (ψ0 ψ1 : n → ℂ)
    (hψ0 : star ψ0 ⬝ᵥ ψ0=1) (hψ1 : star ψ1 ⬝ᵥ ψ1=1) :
    (CFC.sqrt (CFC.sqrt (vecMulVec ψ1 (star ψ1))*vecMulVec ψ0 (star ψ0)*
      CFC.sqrt (vecMulVec ψ1 (star ψ1)))).trace.re=
        (CFC.sqrt (vecMulVec ψ1 (star ψ1)*vecMulVec ψ0 (star ψ0)*vecMulVec ψ1 (star ψ1))).trace.re ∧
    (CFC.sqrt (vecMulVec ψ1 (star ψ1)*vecMulVec ψ0 (star ψ0)*vecMulVec ψ1 (star ψ1))).trace.re=
      ‖star ψ0 ⬝ᵥ ψ1‖*(CFC.sqrt (vecMulVec ψ1 (star ψ1))).trace.re ∧
    ‖star ψ0 ⬝ᵥ ψ1‖*(CFC.sqrt (vecMulVec ψ1 (star ψ1))).trace.re=‖star ψ0 ⬝ᵥ ψ1‖ := by
  have hP := projector ψ1 hψ1
  let c : ℝ := ‖star ψ0 ⬝ᵥ ψ1‖
  have hc : 0 ≤ c := norm_nonneg _
  have hQ := posSemidef_vecMulVec_self_star ψ1
  have hcC : (0 : ℂ) ≤ (c : ℂ) := by exact_mod_cast hc
  have hCP : ((c : ℂ) • vecMulVec ψ1 (star ψ1)).PosSemidef := hQ.smul hcC
  have hQ2 : vecMulVec ψ1 (star ψ1)*vecMulVec ψ1 (star ψ1)=vecMulVec ψ1 (star ψ1) := by
    rw [vecMulVec_mul_vecMulVec,hψ1,one_smul]
  have hroot : CFC.sqrt (vecMulVec ψ1 (star ψ1)*vecMulVec ψ0 (star ψ0)*vecMulVec ψ1 (star ψ1))=
      (c : ℂ) • vecMulVec ψ1 (star ψ1) := by
    have hpos : (vecMulVec ψ1 (star ψ1)*vecMulVec ψ0 (star ψ0)*vecMulVec ψ1 (star ψ1)).PosSemidef := by
      rw [sandwich]
      exact hQ.smul (by exact_mod_cast sq_nonneg c)
    apply (CFC.sqrt_eq_iff _ _ hpos.nonneg hCP.nonneg).mpr
    rw [smul_mul_smul_comm,hQ2,sandwich,← Complex.ofReal_mul]
    congr 1
    change ((c*c : ℝ) : ℂ)=((c^2 : ℝ) : ℂ)
    rw [pow_two]
  refine ⟨by rw [hP.1],?_,?_⟩
  · rw [hroot,hP.1,trace_smul,hP.2,smul_eq_mul,mul_one,Complex.ofReal_re,Complex.one_re,mul_one]
  · rw [hP.1,hP.2,Complex.one_re,mul_one]
end QNextPureBatch.QuantumNextPure

end

open Matrix WildeQIT
open scoped MatrixOrder ComplexOrder ComplexConjugate

set_option autoImplicit false



/-- Fuchs, *Distinguishability and Accessible Information in Quantum Theory*,
arXiv:quant-ph/9601020v1, eq. (3.36), p.50 (PDF p.59): for pure states `ρ̂₀ = |ψ₀⟩⟨ψ₀|`,
`ρ̂₁ = |ψ₁⟩⟨ψ₁|` the expression of eq. (3.28) reduces, line by line, to
`tr √(|ψ₁⟩⟨ψ₁|ψ₀⟩⟨ψ₀|ψ₁⟩⟨ψ₁|) = |⟨ψ₀|ψ₁⟩| tr √(|ψ₁⟩⟨ψ₁|) = |⟨ψ₀|ψ₁⟩|`.

**Formalization Note.** `F` in (3.36) is the right side of (3.28), not the minimum (3.27). Kets are
vectors `ψ : n → ℂ` with `⟨ψ|ψ⟩ = star ψ ⬝ᵥ ψ = 1`, and `|ψ⟩⟨ψ|` is
`Matrix.vecMulVec ψ (star ψ)`. The first conjunct is the passage from `ρ̂₁^{1/2}` in (3.28) to
`ρ̂₁ = |ψ₁⟩⟨ψ₁|` on the first line of (3.36). Traces are real and `.re` extracts the value. -/
theorem solution {n : Type} [Fintype n] [DecidableEq n] (ψ0 ψ1 : n → ℂ)
    (hψ0 : star ψ0 ⬝ᵥ ψ0 = 1) (hψ1 : star ψ1 ⬝ᵥ ψ1 = 1) :
    (Matrix.trace (CFC.sqrt (CFC.sqrt (vecMulVec ψ1 (star ψ1)) * vecMulVec ψ0 (star ψ0) *
        CFC.sqrt (vecMulVec ψ1 (star ψ1))))).re =
      (Matrix.trace (CFC.sqrt (vecMulVec ψ1 (star ψ1) * vecMulVec ψ0 (star ψ0) *
        vecMulVec ψ1 (star ψ1)))).re ∧
    (Matrix.trace (CFC.sqrt (vecMulVec ψ1 (star ψ1) * vecMulVec ψ0 (star ψ0) *
        vecMulVec ψ1 (star ψ1)))).re =
      ‖star ψ0 ⬝ᵥ ψ1‖ * (Matrix.trace (CFC.sqrt (vecMulVec ψ1 (star ψ1)))).re ∧
    ‖star ψ0 ⬝ᵥ ψ1‖ * (Matrix.trace (CFC.sqrt (vecMulVec ψ1 (star ψ1)))).re =
      ‖star ψ0 ⬝ᵥ ψ1‖ := by
 exact QNextPureBatch.QuantumNextPure.pure_formula ψ0 ψ1 hψ0 hψ1