  have hXs : (encK s f).G X = ints L ++ (ints l ++ s.G X) := by simp [hX, ints_append]
  have H := FSp.mvK' hXY hXC hYC hX5 hY5 hC5 n hnc (encK s f) L _ hXs hno hn w hL
