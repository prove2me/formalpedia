open Real
open ExactVacuumAtlas
open ExactVacuumAtlas.Kerr
theorem solution (M a : ℝ) (x : Pt 4) (hx : x ∈ domBL M a) :
    IsLorentzian (metricMatrix (KerrBL.gKerr M a) x) := by
  have hSpos := domBL_Sig_pos hx
  have hD := domBL_Del hx
  have hs2 := domBL_sin_sq_pos hx
  rcases lt_or_gt_of_ne hD with hneg | hpos
  · -- `Δ < 0`: `∂_r` timelike
    refine isLorentzian_of_diag (frameN a x) _ (frameN_diag M a x hx) ?_ ?_
    · show KerrBL.Sig a (x 1) (cos (x 2)) / KerrBL.Del M a (x 1) < 0
      exact div_neg_of_pos_of_neg hSpos hneg
    · intro i hi
      fin_cases i
      · exact absurd rfl hi
      · show 0 < -(KerrBL.Del M a (x 1) * KerrBL.Sig a (x 1) (cos (x 2)))
        nlinarith
      · exact hSpos
      · show 0 < KerrBL.Sig a (x 1) (cos (x 2)) * sin (x 2) ^ 2
        positivity
  · -- `Δ > 0`: `T₀` timelike
    refine isLorentzian_of_diag (frameP a x) _ (frameP_diag M a x hx) ?_ ?_
    · show -(KerrBL.Del M a (x 1) * KerrBL.Sig a (x 1) (cos (x 2))) < 0
      nlinarith
    · intro i hi
      fin_cases i
      · exact absurd rfl hi
      · show 0 < KerrBL.Sig a (x 1) (cos (x 2)) / KerrBL.Del M a (x 1)
        exact div_pos hSpos hpos
      · exact hSpos
      · show 0 < KerrBL.Sig a (x 1) (cos (x 2)) * sin (x 2) ^ 2
        positivity
