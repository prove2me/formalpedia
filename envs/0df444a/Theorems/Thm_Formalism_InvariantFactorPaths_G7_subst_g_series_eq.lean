theorem Formalism.InvariantFactorPaths.G7.subst_g_series_eq {K τ : Type} [Field K] (p : ℕ) (c c' : K) {a : Fin 2 → MvPowerSeries τ K}
    (hs : MvPowerSeries.HasSubst a) :
    MvPowerSeries.subst a (Gser p c c') = MvPowerSeries.subst a (G1 p c c') +
      MvPowerSeries.C ((p : K)⁻¹) * (MvPowerSeries.C c * (a 0 * a 1 ^ p) -
        MvPowerSeries.C c' * (a 1 * a 0 ^ p)) := by sorry
