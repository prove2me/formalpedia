set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-- The constant of the per-call terms. -/
def Cn : ℕ := 10 ^ 13 * (εSD.size + 10 ^ 4) * (NLogN.KFW.eL.size + 10)

/-- The total cost of the entry procedure. -/
noncomputable def cTot (Kc : ℝ) (K S r H P D k q0 Bp Z Zr Bz w : ℕ) : ℕ :=
