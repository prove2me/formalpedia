theorem solution {g : ℝ → ℝ} {b : ℝ} (hb : 0 < b)
    (hg : ContinuousOn g (Icc (0:ℝ) b)) :
    Tendsto (fun u : ℝ => (∫ t in (0:ℝ)..u, t * g t) / u ^ 2) (𝓝[>] (0:ℝ)) (𝓝 (g 0 / 2)) := by
  have hcont : ContinuousOn (fun t : ℝ => t * (g t - g 0)) (Icc (0:ℝ) b) :=
    continuousOn_id.mul (hg.sub continuousOn_const)
  -- the remainder vanishes like `u²`
  have hzero : Tendsto (fun u : ℝ => (∫ t in (0:ℝ)..u, t * (g t - g 0)) / u ^ 2)
      (𝓝[>] (0:ℝ)) (𝓝 0) := by
    rw [Metric.tendsto_nhdsWithin_nhds]
    intro ε hε
    have hc0 : ContinuousWithinAt g (Icc (0:ℝ) b) 0 := hg 0 ⟨le_rfl, le_of_lt hb⟩
    obtain ⟨δ, hδ0, hδ⟩ := (Metric.continuousWithinAt_iff.mp hc0) (ε / 2) (by linarith)
    refine ⟨min δ b, lt_min hδ0 hb, ?_⟩
    intro u hu huδ
    have hu0 : (0:ℝ) < u := hu
    have huδu : u < min δ b := by
      rw [Real.dist_eq, sub_zero, abs_of_pos hu0] at huδ
      exact huδ
    have hub : u < b := lt_of_lt_of_le huδu (min_le_right _ _)
    have huδ' : u < δ := lt_of_lt_of_le huδu (min_le_left _ _)
    have hsub : Icc (0:ℝ) u ⊆ Icc (0:ℝ) b := Icc_subset_Icc le_rfl (le_of_lt hub)
    have hI1 : IntervalIntegrable (fun t : ℝ => t * (g t - g 0)) volume (0:ℝ) u :=
      (hcont.mono hsub).intervalIntegrable_of_Icc (le_of_lt hu0)
    have hc2 : ContinuousOn (fun t : ℝ => t * (ε / 2)) (Icc (0:ℝ) b) :=
      continuousOn_id.mul continuousOn_const
    have hI2 : IntervalIntegrable (fun t : ℝ => t * (ε / 2)) volume (0:ℝ) u :=
      (hc2.mono hsub).intervalIntegrable_of_Icc (le_of_lt hu0)
    have hpt : ∀ t ∈ Icc (0:ℝ) u, ‖t * (g t - g 0)‖ ≤ t * (ε / 2) := by
      intro t ht
      have ht0 : (0:ℝ) ≤ t := ht.1
      have htb : t ∈ Icc (0:ℝ) b := ⟨ht0, le_trans ht.2 (le_of_lt hub)⟩
      have htdist : dist t 0 < δ := by
        rw [Real.dist_eq, sub_zero, abs_of_nonneg ht0]
        linarith [ht.2]
      have hg' := hδ htb htdist
      rw [Real.dist_eq] at hg'
      have hg'' : |g t - g 0| < ε / 2 := by
        have : g t - g 0 = -(g 0 - g t) := by ring
        rw [this, abs_neg]
        simpa [abs_sub_comm] using hg'
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg ht0]
      exact mul_le_mul_of_nonneg_left (le_of_lt hg'') ht0
    have hmono := intervalIntegral.integral_mono_on (a := (0:ℝ)) (b := u)
      (f := fun t : ℝ => ‖t * (g t - g 0)‖) (g := fun t : ℝ => t * (ε / 2)) (μ := volume)
      (le_of_lt hu0) hI1.norm hI2 hpt
    have habs := abs_integral_le_integral_abs (μ := volume)
      (f := fun t : ℝ => t * (g t - g 0)) (a := (0:ℝ)) (b := u) (le_of_lt hu0)
    have hbound : |∫ t in (0:ℝ)..u, t * (g t - g 0)| ≤ u ^ 2 * (ε / 2) / 2 := by
      refine le_trans habs (le_trans hmono (le_of_eq ?_))
      rw [show (fun t : ℝ => t * (ε / 2)) = fun t : ℝ => (ε / 2) * t from by funext t; ring,
        intervalIntegral.integral_const_mul, integral_id]
      ring
    have hu2 : (0:ℝ) < u ^ 2 := by positivity
    rw [Real.dist_eq, sub_zero, abs_div, abs_of_pos hu2,
      div_lt_iff₀ hu2]
    have hfin : |∫ t in (0:ℝ)..u, t * (g t - g 0)| ≤ u ^ 2 * (ε / 2) / 2 := hbound
    calc |∫ t in (0:ℝ)..u, t * (g t - g 0)| ≤ u ^ 2 * (ε / 2) / 2 := hfin
      _ < ε * u ^ 2 := by nlinarith
  -- the decomposition `∫ t g = g(0) u²/2 + remainder`
  have hdecomp : ∀ᶠ u in 𝓝[>] (0:ℝ),
      (∫ t in (0:ℝ)..u, t * g t) / u ^ 2
        = g 0 / 2 + (∫ t in (0:ℝ)..u, t * (g t - g 0)) / u ^ 2 := by
    filter_upwards [Ioo_mem_nhdsGT hb] with u hu
    have hu0 : (0:ℝ) < u := hu.1
    have hub : u < b := hu.2
    have hsub : Icc (0:ℝ) u ⊆ Icc (0:ℝ) b := Icc_subset_Icc le_rfl (le_of_lt hub)
    have hI1 : IntervalIntegrable (fun t : ℝ => t * (g t - g 0)) volume (0:ℝ) u :=
      (hcont.mono hsub).intervalIntegrable_of_Icc (le_of_lt hu0)
    have hI2 : IntervalIntegrable (fun t : ℝ => t * g 0) volume (0:ℝ) u :=
      ((continuousOn_id.mul continuousOn_const).mono hsub).intervalIntegrable_of_Icc (le_of_lt hu0)
    have hsplit : ∫ t in (0:ℝ)..u, t * g t
        = (∫ t in (0:ℝ)..u, t * (g t - g 0)) + ∫ t in (0:ℝ)..u, t * g 0 := by
      rw [← intervalIntegral.integral_add hI1 hI2]
      exact intervalIntegral.integral_congr (fun t _ => by ring)
    have hconst : ∫ t in (0:ℝ)..u, t * g 0 = g 0 * u ^ 2 / 2 := by
      rw [show (fun t : ℝ => t * g 0) = fun t : ℝ => g 0 * t from by funext t; ring,
        intervalIntegral.integral_const_mul, integral_id]
      ring
    rw [hsplit, hconst]
    have hu2 : u ^ 2 ≠ 0 := by positivity
    field_simp
    ring
  have hlim : Tendsto (fun u : ℝ => g 0 / 2 + (∫ t in (0:ℝ)..u, t * (g t - g 0)) / u ^ 2)
      (𝓝[>] (0:ℝ)) (𝓝 (g 0 / 2)) := by
    simpa using hzero.const_add (g 0 / 2)
  refine hlim.congr' ?_
  filter_upwards [hdecomp] with u hu
  exact hu.symm
