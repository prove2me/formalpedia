open CategoryTheory CategoryTheory.Limits AlgebraicGeometry NeronModelInfra GoodReductionJacobian

universe u

namespace P2mKcSerreAV

variable {K : Type u} [Field K] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of K)}

section Points

variable (L : RelativeGroupLaw K f)

theorem comp_eq_transition {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of K)}
    (x : SchemeHomOver t f) (φ : SchemeHomOver f f) :
    NeronModelInfra.schemeHomOverComp x φ = GoodReductionJacobian.schemeHomOverComp x.1 x.2 φ :=
  rfl

theorem comp_mul {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of K)}
    (x : SchemeHomOver t f) (φ ψ : SchemeHomOver f f) :
    NeronModelInfra.schemeHomOverComp x (L.mul f φ ψ) =
      L.mul t (NeronModelInfra.schemeHomOverComp x φ) (NeronModelInfra.schemeHomOverComp x ψ) := by
  rw [comp_eq_transition, comp_eq_transition, comp_eq_transition]
  exact L.mul_natural f t x.1 x.2 φ ψ

theorem comp_one {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of K)} (x : SchemeHomOver t f) :
    NeronModelInfra.schemeHomOverComp x (L.one f) = L.one t := by
  rw [comp_eq_transition]
  exact L.one_natural f t x.1 x.2

theorem comp_inv {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of K)}
    (x : SchemeHomOver t f) (φ : SchemeHomOver f f) :
    NeronModelInfra.schemeHomOverComp x (L.inv f φ) = L.inv t (NeronModelInfra.schemeHomOverComp x φ) := by
  letI := L.pointGroup t
  have h : L.mul t (NeronModelInfra.schemeHomOverComp x (L.inv f φ)) (NeronModelInfra.schemeHomOverComp x φ) =
      L.one t := by
    rw [← comp_mul, L.inv_mul_cancel, comp_one]
  have h' : (NeronModelInfra.schemeHomOverComp x (L.inv f φ)) * (NeronModelInfra.schemeHomOverComp x φ) = 1 := h
  have := eq_inv_of_mul_eq_one_left h'
  exact this

theorem comp_id {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of K)} (x : SchemeHomOver t f) :
    NeronModelInfra.schemeHomOverComp x (NeronModelInfra.schemeHomOverId f) = x :=
  NeronModelInfra.schemeHomOverComp_id_right x

theorem comp_comp {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of K)} (x : SchemeHomOver t f)
    (φ ψ : SchemeHomOver f f) :
    NeronModelInfra.schemeHomOverComp (NeronModelInfra.schemeHomOverComp x φ) ψ =
      NeronModelInfra.schemeHomOverComp x (NeronModelInfra.schemeHomOverComp φ ψ) :=
  NeronModelInfra.schemeHomOverComp_assoc x φ ψ

theorem comp_npow {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of K)} (x : SchemeHomOver t f)
    (σ : SchemeHomOver f f) (k : ℕ) :
    NeronModelInfra.schemeHomOverComp x (NeronModelInfra.schemeHomOverNpow σ k) =
      (fun y : SchemeHomOver t f => NeronModelInfra.schemeHomOverComp y σ)^[k] x := by
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [NeronModelInfra.schemeHomOverNpow_succ, ← comp_comp, ih, Function.iterate_succ_apply']

theorem nsmul_eq_pow {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (k : ℕ) (x : SchemeHomOver t f) :
    L.nsmul t k x = (letI := L.pointGroup t; x ^ k) := by
  letI := L.pointGroup t
  induction k with
  | zero => rfl
  | succ k ih => rw [L.nsmul_succ, ih, pow_succ]; rfl

theorem comp_one_pt_of_hom {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (σ : SchemeHomOver f f)
    (hσ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
      NeronModelInfra.schemeHomOverComp (L.mul t x y) σ =
        L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ)) :
    NeronModelInfra.schemeHomOverComp (L.one t) σ = L.one t := by
  letI := L.pointGroup t
  have h := hσ t (L.one t) (L.one t)
  rw [L.one_mul] at h

  have h' : NeronModelInfra.schemeHomOverComp (L.one t) σ * NeronModelInfra.schemeHomOverComp (L.one t) σ =
      NeronModelInfra.schemeHomOverComp (L.one t) σ * 1 := by
    rw [_root_.mul_one]; exact h.symm
  exact mul_left_cancel h'

theorem comp_nsmul_of_hom {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (σ : SchemeHomOver f f)
    (hσ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
      NeronModelInfra.schemeHomOverComp (L.mul t x y) σ =
        L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ))
    (k : ℕ) (x : SchemeHomOver t f) :
    NeronModelInfra.schemeHomOverComp (L.nsmul t k x) σ = L.nsmul t k (NeronModelInfra.schemeHomOverComp x σ) := by
  induction k with
  | zero => exact comp_one_pt_of_hom L t σ hσ
  | succ k ih => rw [L.nsmul_succ, L.nsmul_succ, hσ, ih]

theorem comp_hom_pow (hc : L.IsCommutative) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K))
    (γ : SchemeHomOver f f) (k : ℕ) (x : SchemeHomOver t f) :
    NeronModelInfra.schemeHomOverComp x (letI := L.pointCommGroup hc f; γ ^ k) =
      L.nsmul t k (NeronModelInfra.schemeHomOverComp x γ) := by
  letI := L.pointCommGroup hc f
  induction k with
  | zero =>
      rw [pow_zero, L.nsmul_zero]
      exact comp_one L x
  | succ k ih =>
      rw [pow_succ, L.nsmul_succ, ← ih]
      exact comp_mul L x _ _

end Points

theorem exists_prime_pow_dvd_of_three_le (n : ℕ) (hn : 3 ≤ n) :
    ∃ p a : ℕ, p.Prime ∧ 1 ≤ a ∧ (p = 2 → 2 ≤ a) ∧ p ^ a ∣ n := by
  rcases n.eq_two_pow_or_exists_odd_prime_and_dvd with ⟨k, rfl⟩ | ⟨p, hp, hdvd, hodd⟩
  · refine ⟨2, 2, Nat.prime_two, by norm_num, fun _ => le_rfl, ?_⟩
    have hk : 2 ≤ k := by
      by_contra hk
      push Not at hk
      interval_cases k <;> simp at hn
    exact Nat.pow_dvd_pow 2 hk
  · refine ⟨p, 1, hp, le_rfl, fun h2 => ?_, by simpa using hdvd⟩
    subst h2
    exact absurd hodd (by decide)

class IsComm (L : RelativeGroupLaw K f) : Prop where
  out : L.IsCommutative

section Tate

variable (L : RelativeGroupLaw K f) (p : ℕ)

abbrev Pt (f : A ⟶ Spec (CommRingCat.of K)) : Type u := SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f

def TateSeq : Type u :=
  {x : ℕ → Pt f // x 0 = L.one _ ∧ ∀ j, L.nsmul _ p (x (j + 1)) = x j}

variable {L p}

namespace TateSeq

theorem ext {x y : TateSeq L p} (h : ∀ j, x.1 j = y.1 j) : x = y :=
  Subtype.ext (funext h)

def zero : TateSeq L p :=
  ⟨fun _ => L.one _, rfl, fun _ => L.nsmul_unit _ p⟩

variable [IsComm L]

def add (x y : TateSeq L p) : TateSeq L p :=
  ⟨fun j => L.mul _ (x.1 j) (y.1 j), by
    refine ⟨?_, fun j => ?_⟩
    · change L.mul _ (x.1 0) (y.1 0) = _
      rw [x.2.1, y.2.1, L.one_mul]
    · letI := L.pointCommGroup IsComm.out (𝟙 (Spec (CommRingCat.of K)))
      have hx := x.2.2 j
      have hy := y.2.2 j
      rw [nsmul_eq_pow] at hx hy
      change L.nsmul _ p (L.mul _ (x.1 (j + 1)) (y.1 (j + 1))) = _
      rw [nsmul_eq_pow]
      change (x.1 (j + 1) * y.1 (j + 1)) ^ p = x.1 j * y.1 j
      rw [mul_pow]
      exact congrArg₂ (· * ·) hx hy⟩

def neg (x : TateSeq L p) : TateSeq L p :=
  ⟨fun j => L.inv _ (x.1 j), by
    letI := L.pointCommGroup IsComm.out (𝟙 (Spec (CommRingCat.of K)))
    refine ⟨?_, fun j => ?_⟩
    · change L.inv _ (x.1 0) = _
      rw [x.2.1]; exact inv_one
    · have hx := x.2.2 j
      rw [nsmul_eq_pow] at hx
      change L.nsmul _ p (L.inv _ (x.1 (j + 1))) = _
      rw [nsmul_eq_pow]
      change (x.1 (j + 1))⁻¹ ^ p = (x.1 j)⁻¹
      rw [inv_pow]
      exact congrArg _ hx⟩

scoped instance instZero : Zero (TateSeq L p) := ⟨zero⟩
scoped instance instAdd : Add (TateSeq L p) := ⟨add⟩
scoped instance instNeg : Neg (TateSeq L p) := ⟨neg⟩

scoped instance addCommGroup : AddCommGroup (TateSeq L p) where
  add := (· + ·)
  zero := 0
  neg := fun x => -x
  add_assoc x y z := ext fun j => L.mul_assoc _ _ _ _
  zero_add x := ext fun j => L.one_mul _ _
  add_zero x := ext fun j => L.mul_one _ _
  neg_add_cancel x := ext fun j => L.inv_mul_cancel _ _
  add_comm x y := ext fun j => IsComm.out _ _ _
  nsmul := nsmulRec
  nsmul_zero _ := rfl
  nsmul_succ _ _ := rfl
  zsmul := zsmulRec
  zsmul_zero' _ := rfl
  zsmul_succ' _ _ := rfl
  zsmul_neg' _ _ := rfl

theorem add_val (x y : TateSeq L p) (j : ℕ) : (x + y).1 j = L.mul _ (x.1 j) (y.1 j) := rfl

omit [IsComm L] in
theorem zero_val (j : ℕ) : (0 : TateSeq L p).1 j = L.one _ := rfl

theorem neg_val (x : TateSeq L p) (j : ℕ) : (-x).1 j = L.inv _ (x.1 j) := rfl

theorem sub_val (x y : TateSeq L p) (j : ℕ) : (x - y).1 j = L.mul _ (x.1 j) (L.inv _ (y.1 j)) := rfl

theorem nsmul_val (k : ℕ) (x : TateSeq L p) (j : ℕ) : (k • x).1 j = L.nsmul _ k (x.1 j) := by
  induction k with
  | zero => rw [zero_nsmul, L.nsmul_zero]; rfl
  | succ k ih => rw [succ_nsmul, L.nsmul_succ, add_val, ih]

omit [IsComm L] in

theorem torsion (x : TateSeq L p) (j : ℕ) :
    L.nsmul _ (p ^ j) (x.1 j) = L.one _ := by
  letI := L.pointGroup (𝟙 (Spec (CommRingCat.of K)))
  induction j with
  | zero => rw [pow_zero, L.nsmul_one_apply]; exact x.2.1
  | succ j ih =>
      have hx := x.2.2 j
      rw [nsmul_eq_pow] at hx ih ⊢
      change x.1 (j + 1) ^ p ^ (j + 1) = 1
      change x.1 (j + 1) ^ p = x.1 j at hx
      change x.1 j ^ p ^ j = 1 at ih
      rw [pow_succ', pow_mul, hx, ih]

theorem eq_zero_of_smul_eq_zero (x : TateSeq L p) (h : p • x = 0) : x = 0 := by
  refine ext fun j => ?_
  have hj := congrArg (fun z : TateSeq L p => z.1 (j + 1)) h
  rw [nsmul_val, x.2.2 j] at hj
  rw [hj]; rfl

theorem eq_zero_of_forall_exists (x : TateSeq L p) (h : ∀ k : ℕ, ∃ y : TateSeq L p, x = p ^ k • y) :
    x = 0 := by
  refine ext fun j => ?_
  obtain ⟨y, hy⟩ := h j
  rw [hy, nsmul_val, torsion y j]
  rfl

omit [IsComm L] in

def mapHom (σ : SchemeHomOver f f)
    (hσ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
      NeronModelInfra.schemeHomOverComp (L.mul t x y) σ =
        L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ))
    (x : TateSeq L p) : TateSeq L p :=
  ⟨fun j => NeronModelInfra.schemeHomOverComp (x.1 j) σ, by
    refine ⟨?_, fun j => ?_⟩
    · change NeronModelInfra.schemeHomOverComp (x.1 0) σ = _
      rw [x.2.1]; exact comp_one_pt_of_hom L _ σ hσ
    · change L.nsmul _ p (NeronModelInfra.schemeHomOverComp (x.1 (j + 1)) σ) = _
      rw [← comp_nsmul_of_hom L _ σ hσ, x.2.2 j]⟩

omit [IsComm L] in
@[scoped simp] theorem mapHom_val (σ : SchemeHomOver f f)
    (hσ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
      NeronModelInfra.schemeHomOverComp (L.mul t x y) σ =
        L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ))
    (x : TateSeq L p) (j : ℕ) :
    (mapHom σ hσ x).1 j = NeronModelInfra.schemeHomOverComp (x.1 j) σ := rfl

def mapEnd (σ : SchemeHomOver f f)
    (hσ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
      NeronModelInfra.schemeHomOverComp (L.mul t x y) σ =
        L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ)) :
    TateSeq L p →ₗ[ℤ] TateSeq L p :=
  AddMonoidHom.toIntLinearMap
    { toFun := mapHom σ hσ
      map_zero' := ext fun j => by rw [mapHom_val, zero_val]; exact comp_one_pt_of_hom L _ σ hσ
      map_add' := fun x y => ext fun j => by rw [mapHom_val, add_val, add_val, hσ]; rfl }

@[scoped simp] theorem mapEnd_apply (σ : SchemeHomOver f f)
    (hσ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
      NeronModelInfra.schemeHomOverComp (L.mul t x y) σ =
        L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ))
    (x : TateSeq L p) :
    mapEnd σ hσ x = mapHom σ hσ x := rfl

end TateSeq
