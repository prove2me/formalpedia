  have h2 := hC (SchwartzMap.compSubConstCLM ℂ (-a) f - f)
  rw [Seminorm.smul_apply, NNReal.smul_def, smul_eq_mul] at h2
  rw [Seminorm.smul_apply, NNReal.smul_def, smul_eq_mul]
  push_cast
