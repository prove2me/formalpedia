/-- **The native `J` set-up.** -/
theorem eJn_sp_sol_aux (kA kC wA wC : ℕ) {k pre post s t p α d W N B : ℕ} {Zn : Fin HS}
    (hZ : Zn ∉ rg) (hZ5 : Zn.val < 56) (hZT : Zn ≠ sTmp) (hZC : Zn ≠ cRdC)
    (hZv : Zn.val = 49 ∨ Zn.val = 55)
    (oN : Fin 19 → Fin HS) (hinj : Injective oN) (hlt : ∀ i, (oN i).val < 56)
    (hx : ∀ i, oN i ≠ sX ∧ oN i ≠ sLn ∧ oN i ≠ sOut ∧ oN i ≠ sT2 ∧ oN i ≠ cLC) (hZo : ∀ i, oN i ≠ Zn)
    (hW : parBig kA kC wA wC k pre post s t p α d < 2 ^ W)
    (hNW : N < 2 ^ W) (hW4 : 4 ≤ W) (hN5 : 5 ≤ N)
    (hs : 0 < s) (hws : wF d ≤ s) (hQW : segPF p d s ≤ W)
    (hsN : s ≤ N) (hlN : lamP d ≤ N) (hNMN : lamP d * (2 * wF d + 1) ≤ N)
    (hmm : (LJ s t (lamP d) (wF d)).length * (LJ s t (lamP d) (wF d)).length ≤ N)
    (hmc : (LJ s t (lamP d) (wF d)).length * (2 * wF d + 2) ≤ N)
    (bss : s * s ≤ 2 ^ W) (hlw : lamP d + wF d ≤ 2 ^ W)
    (hW8 : 8 * ((LJ s t (lamP d) (wF d)).length + 1) ^ 2 ≤ 2 ^ W)
    (hJB : JB (segPF p d s) (p / 7) W s t α (lamP d) (wF d))
    (hMb : ∀ q ≤ (LJ s t (lamP d) (wF d)).length, ∀ i < (LJ s t (lamP d) (wF d)).length,
      ∀ k < (LJ s t (lamP d) (wF d)).length,
      |Mseq (segPF p d s) (bandS (lamP d + wF d) (s - lamP d - wF d)) (LJ s t (lamP d) (wF d))
        (capI (segPF p d s) (mkTables (segPF p d s) (p / 7) s t α) (mkBlocks s t (lamP d) (wF d)))
        q i k| ≤ 2 ^ W)
    (hbl : (JK.jBody (kA * segPF p d s + kC) (JK.jFs (segPF p d s) (p / 7) s t (lamP d) (wF d) α)
      (JK.jBs (segPF p d s) (p / 7) s t (lamP d) (wF d) α)
      (JK.jCc (segPF p d s) (p / 7) s t (lamP d) (wF d) α (wF d))).length ≤ 2 ^ W)
    (hvB : ∀ a ∈ cVals (wA * segPF p d s + wC) (Nat.clog 2 (LJ s t (lamP d) (wF d)).length) pre 1
      post, zsz a ≤ B)
    (hlB : zsz ((tabsT (fun _ => jTabX (segPF p d s) (p / 7) s t (lamP d) (wF d) α
      (kA * segPF p d s + kC)) 1).length : ℤ) ≤ B)
    (hTB : Bnd B (tabsT (fun _ => jTabX (segPF p d s) (p / 7) s t (lamP d) (wF d) α
      (kA * segPF p d s + kC)) 1))
    (s0 : IState HS) :
    Sp (eJn kA kC wA wC Zn oN) (encK s0 (F0 Zn (dsc k pre post s t p α d)))
      (encK s0 (extend oN (kerRegs (wA * segPF p d s + wC) (wA * segPF p d s + wC)
        (Nat.clog 2 (LJ s t (lamP d) (wF d)).length) pre 1 post
        (tabsT (fun _ => jTabX (segPF p d s) (p / 7) s t (lamP d) (wF d) α
          (kA * segPF p d s + kC)) 1))
        (F0 Zn (dsc k pre post s t p α d))))
      (cEJn kA kC wA wC W N d s p (LJ s t (lamP d) (wF d)).length B
        (tabsT (fun _ => jTabX (segPF p d s) (p / 7) s t (lamP d) (wF d) α
          (kA * segPF p d s + kC)) 1).length) := by
  set G := F0 Zn (dsc k pre post s t p α d) with hG
  have hGe : ∀ j, j ≠ Zn → G j = [] := fun j hj => by rw [hG, F0, update_of_ne hj]
  have e0 : ∀ j : Fin HS, j.val ≠ 49 → j.val ≠ 55 → G j = [] := fun j a b =>
    hGe j (fun e => by subst e; omega)
  have S0 := init_sp s0 G (fun j hj => hGe j (fun h => hZ (h ▸ hj)))
  obtain ⟨v', hv', Hc⟩ := Rn.eJcore (kA := kA) (kC := kC) (wA := wA) (wC := wC) (N := N) hZ hZ5
    hZT hZC (c := G) (by rw [hG, F0, update_self]) hZv hGe hW hNW hW4 hN5 hs hws hQW hsN hlN hNMN
    hmm hmc bss hlw hW8 hJB hMb hbl
  set T := tabsT (fun _ => jTabX (segPF p d s) (p / 7) s t (lamP d) (wF d) α
    (kA * segPF p d s + kC)) 1 with hT
  set vs := cVals (wA * segPF p d s + wC) (Nat.clog 2 (LJ s t (lamP d) (wF d)).length) pre 1 post
  set c1 := update (update (update G sX vs) sOut T) sLn [(T.length : ℤ)] with hc1
  have S1 := Hc s0
  have hrg : ∀ j ∈ rg, c1 j = [] := fun j hj => by
    rw [hc1, update_of_ne (fun h => by subst h; revert hj; decide),
      update_of_ne (fun h => by subst h; revert hj; decide),
      update_of_ne (fun h => by subst h; revert hj; decide)]
    exact hGe j (fun h => hZ (h ▸ hj))
  have S2 := fini_sp s0 c1 hrg v' (W := W + 1) (fun j hj => zsz_le_W1 (hv' j hj))
  have S3 := distAll_sp s0 oN hinj hlt hx c1 vs T (by simp [vs, cVals])
    (by rw [hc1, update_of_ne (by decide), update_of_ne (by decide), update_self])
    (by rw [hc1, update_self]) (by rw [hc1, update_of_ne (by decide), update_self])
    (by rw [hc1, update_of_ne (by decide), update_of_ne (by decide), update_of_ne (by decide)]
        exact e0 _ (by decide) (by decide))
    (fun i => by
      obtain ⟨a1, a2, a3, -, -⟩ := hx i
      rw [hc1, update_of_ne a2, update_of_ne a3, update_of_ne a1]; exact hGe _ (hZo i))
    _ (kerRegs_vals _ _ _ _ _ T) rfl rfl (kerRegs_hi _ _ _ _ _ T) B hvB hlB hTB
  rw [hc1, extend_clean oN hinj _ G vs T _ hx (e0 _ (by decide) (by decide))
    (e0 _ (by decide) (by decide)) (e0 _ (by decide) (by decide))] at S3
  exact (S0.seq (S1.seq (S2.seq S3))).mono le_rfl

