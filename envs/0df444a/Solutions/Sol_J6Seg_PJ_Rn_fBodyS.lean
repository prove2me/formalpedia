set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem rowP_length (Q m mw cB : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ) (r : ℕ) :
    (rowP Q m mw cB L Mf r).length = cwN m mw cB L r + 1 := by
  simp [rowP, fsP]

section bodies
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ}

/-- **One forward row** (`r = m - 1 - r'`). -/
theorem Rn.fBodyS_sol_aux {u : Vr} {D : Cs} (hF : Fx Q kk m mw cB u) (hS : StS m L Mf D)
    (hB : BdS W m L Mf) (hLm : L.length = m) (hv : BV W u) {r' t : ℕ} (h1 : u 1 = r')
    (hr : r' < m) (h23 : u 23 = t) (hD51 : D 51 = []) (hmW : m + 1 ≤ 2 ^ W)
    (ht : t + (rowP Q m mw cB L Mf (m - 1 - r')).length ≤ 2 ^ W) :
    Rn fBody u D (fun u' => u' 23 = ((t + (rowP Q m mw cB L Mf (m - 1 - r')).length : ℕ) : ℤ) ∧
      (∀ i ∉ ([2, 3, 4, 5, 6, 7, 8, 23, 29] : List (Fin HS)), u' i = u i) ∧ BV W u')
      (update D 41 ((rowP Q m mw cB L Mf (m - 1 - r')).reverse ++ D 41)) (cfB W m) := by
  set r := m - 1 - r' with hrr
  have hrm : r < m := by omega
  have hlen := rowP_length Q m mw cB L Mf r
  have H1 := Rn.fHeads (Q := Q) (kk := kk) hF hS hB hLm hv h1 hr
  refine Rn.seq H1 (fun u1 hu1 => ?_)
  obtain ⟨a5, a4, a3, af, ab⟩ := hu1
  have F1 : Fx Q kk m mw cB u1 := hF.frm af (by decide)
  have H2 := Rn.cnL F1 hS hB hLm ab a5 a4 a3 hD51 hmW
  refine Rn.seq H2 (fun u2 hu2 => ?_)
  obtain ⟨b3, bf, bb⟩ := hu2
  set n := ((List.range m).filter (fun q => cwC mw L r q)).length with hn
  have hnm : n ≤ m := cnt_le_self _ m
  have b4 : u2 4 = Lg L r := by rw [bf 4 (by decide), a4]
  have b5 : u2 5 = r := by rw [bf 5 (by decide), a5]
  have F2 : Fx Q kk m mw cB u2 := F1.frm bf (by decide)
  have H3 := Rn.fMids (c := D) (L := L) (Mf := Mf) F2 hB bb b5 b4 b3 (by omega) (by omega)
  refine Rn.seq H3 (fun u3 hu3 => ?_)
  obtain ⟨c3, cf, cb⟩ := hu3
  have hcw : (cond (decide (cB ≤ Lg L r)) r n) = cwN m mw cB L r := by
    unfold cwN; by_cases h : cB ≤ Lg L r <;> simp [h, hn]
  rw [hcw] at c3
  have F3 : Fx Q kk m mw cB u3 := F2.frm cf (by decide)
  have c4 : u3 4 = Lg L r := by rw [cf 4 (by decide), b4]
  have c5 : u3 5 = r := by rw [cf 5 (by decide), b5]
  have H4 := Rn.fsL F3 hS hB hLm cb c5 hrm c4 c3 hD51 hmW
  have hcl : cwN m mw cB L r ≤ m := (cwN_le m mw cB L r).trans hrm.le
  refine Rn.seq (H4.mono (fun x hx => hx) (cFor_mono (cb := costL W (m * m + m) fsI) hcl))
    (fun u4 hu4 => ?_)
  obtain ⟨df, db⟩ := hu4
  set D4 := update D 41 ((fsP Q m mw cB L Mf r).reverse ++ D 41) with hD4
  have d3 : u4 3 = cwN m mw cB L r := by rw [df 3 (by decide), c3]
  have d23 : u4 23 = t := by
    rw [df 23 (by decide), cf 23 (by decide), bf 23 (by decide), af 23 (by decide), h23]
  have H5 := Rn.bTails (c := D4) (m := m) (L := L) (Mf := Mf) hB db d3 d23 (by omega)
  have hst : update D4 41 (((cwN m mw cB L r : ℕ) : ℤ) :: D4 41) =
      update D 41 ((rowP Q m mw cB L Mf r).reverse ++ D 41) := by
    simp only [hD4, update_idem, update_self, rowP, List.reverse_append, List.reverse_cons,
      List.reverse_nil, List.nil_append, List.append_assoc, List.cons_append, List.singleton_append]
  refine (H5.mono (fun u' hu' => ?_) le_rfl).congr hst
  obtain ⟨g23, gf, gb⟩ := hu'
  refine ⟨?_, ?_, gb⟩
  · rw [g23, hlen]; push_cast; ring
  · exact frm_trans (C := [2, 3, 4, 5, 6, 7, 8, 23, 29])
      (frm_trans (C := [2, 3, 4, 5, 6, 7, 8, 23, 29])
        (frm_trans (C := [2, 3, 4, 5, 6, 7, 8, 23, 29])
          (frm_trans (C := [2, 3, 4, 5, 6, 7, 8, 23, 29]) af bf (by decide) (by decide))
          cf (by decide) (by decide)) df (by decide) (by decide)) gf (by decide) (by decide)

end bodies

end J6Seg.PJ

end

theorem solution : type_of% @J6Seg.PJ.Rn.fBodyS_sol_aux := @J6Seg.PJ.Rn.fBodyS_sol_aux
