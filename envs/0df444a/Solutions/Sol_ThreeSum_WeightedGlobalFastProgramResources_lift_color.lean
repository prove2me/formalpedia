set_option autoImplicit false
noncomputable section
open ThreeSum ThreeSum.WeightedGlobalFastProgramResources
open Light LightWeightedGlobalFastProgram LightWeightedGlobalFastProgramProof
set_option maxHeartbeats 3000000
set_option maxRecDepth 24000
namespace ThreeSum.WeightedGlobalFastProgramResources
theorem _root_.solution {lim : Limits} {M b p K κ entry depth T colorMain : ℕ}
    {vals : List ℤ} {μ : ℕ→ℤ} {Post : ℤ→(ℕ→ℤ)→Prop} {color : Program}
    (h : Meets lim color entry depth vals μ T Post) :
    Meets lim (program M b p K κ color colorMain) (50+entry) depth vals μ T Post := by
  have hh := (ReportingHostRelocation.meets h (LightWeightedGlobalGlobalPrelude.program M b p K κ)).append
    (LightColorParameters.program.map (ReportingHostRelocation.relocate (50+color.length))++
      [LightColorScan.body (scanEntry color) (50+color.length) (50+colorMain),
        LightColorScanHost.body (scanEntry color),LightWeightedGlobalFastProgram.body (hostEntry color)])
  simpa only [LightWeightedGlobalFastProgram.program,parameterLibrary,colorsLibrary,
    ReportingHostRelocation.program,List.length_append,List.length_map,
    LightWeightedGlobalGlobalPrelude.program_length,List.append_assoc] using hh
end ThreeSum.WeightedGlobalFastProgramResources
