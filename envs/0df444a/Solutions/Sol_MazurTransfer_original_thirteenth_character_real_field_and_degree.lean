theorem conjugateCharacter_kernel_index : conjugateCharacter.ker.index = 6 := by
  have hk : Nat.card conjugateCharacter.ker = 2 := by
    let a : conjugateCharacter.ker := ⟨1, map_one conjugateCharacter⟩
    let b : conjugateCharacter.ker := ⟨-1, (conjugateCharacter_kernel_iff (-1)).mpr (Or.inr rfl)⟩
    apply Nat.card_eq_two_iff.mpr
    refine ⟨a, b, ?_, ?_⟩
    · intro he
      have hv : (1 : ZMod 13) = -1 := congrArg (fun x : conjugateCharacter.ker => (x.val : ZMod 13)) he
      exact (by decide : (1 : ZMod 13) ≠ -1) hv
    · ext u
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff, Set.mem_univ, iff_true]
      rcases (conjugateCharacter_kernel_iff u.val).mp u.property with h | h
      · left; apply Subtype.ext; apply Units.ext; exact h
      · right; apply Subtype.ext; apply Units.ext; exact h
  have hG : Nat.card (ZMod 13)ˣ = 12 := by rw [Nat.card_eq_fintype_card]; decide
  have h := Subgroup.card_mul_index conjugateCharacter.ker
  rw [hk, hG] at h
  omega

