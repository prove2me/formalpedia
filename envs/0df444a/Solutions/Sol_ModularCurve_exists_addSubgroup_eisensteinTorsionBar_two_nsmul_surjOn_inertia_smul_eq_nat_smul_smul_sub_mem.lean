theorem gal_smul_zero (σ : Gal) : σ • (0 : JZero p) = 0 := smul_zero (A := JZero p) σ

theorem gal_smul_mem (m : ℕ) (σ : Gal) {x : JZero p} (hx : x ∈ eisensteinTorsionBar p q m) :
    σ • x ∈ eisensteinTorsionBar p q m := by
  letI := heckeModuleBar p
  haveI := smulCommClass_JZero_of_heckeOperatorsCommuteBar p (heckeOperatorsCommuteBar p)
  rw [mem_eisensteinTorsionBar_iff] at hx ⊢
  intro t ht
  rw [← smul_comm σ t x, hx t ht, gal_smul_zero]

