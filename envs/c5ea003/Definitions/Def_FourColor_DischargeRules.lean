theorem score_le_of_transfer_cap {n : ℕ} (H : Hypermap n)
    (cap : ∀ y, transferCount H y ≤ 5) (x : Fin n) :
    score H x ≤ 60 - 5 * (H.faceArity x : ℚ) := by
  have bound (y : Fin n) : transfer H (H.edge y) - transfer H y ≤ 5 := by
    have hlo : (0 : ℚ) ≤ transfer H y := by
      exact Nat.cast_nonneg _
    have hhi : transfer H (H.edge y) ≤ (5 : ℚ) := by
      change (transferCount H (H.edge y) : ℚ) ≤ 5
      exact_mod_cast cap (H.edge y)
    linarith
  have hs : (∑ y ∈ H.faceDarts x, (transfer H (H.edge y) - transfer H y)) ≤
      (H.faceArity x : ℚ) * 5 := by
    calc
      _ ≤ ∑ _y ∈ H.faceDarts x, (5 : ℚ) := Finset.sum_le_sum (fun y _ ↦ bound y)
      _ = _ := by simp [Hypermap.faceArity]
  unfold score Hypermap.faceCharge
  linarith

/-- A positive-charge hub has degree at most eleven under the separate transfer cap. -/
theorem positive_score_arity_lt_twelve {n : ℕ} (H : Hypermap n)
    (cap : ∀ y, transferCount H y ≤ 5) (x : Fin n) (positive : 0 < score H x) :
    H.faceArity x < 12 := by
  have h := score_le_of_transfer_cap H cap x
  have hc : (H.faceArity x : ℚ) < 12 := by linarith
  exact_mod_cast hc


