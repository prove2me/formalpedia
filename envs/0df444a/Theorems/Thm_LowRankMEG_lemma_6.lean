-- title:
--   Lemma 6 — decay of $\lambda_{r^*+1}(X_t)$
-- statement:
--   Let $X^*$ be optimal with Assumption 1 for $\delta>0$, $r^*=\operatorname{rank}(X^*)$, and let $\{X_t\}$ be a run of Algorithm 2 with $r^*<r<n$, $\varepsilon_0>0$ and $\varepsilon_t\in(0,1)$ for $t\ge1$. Let $G\ge\sup_{\mathcal S_n}\|\nabla f\|_2$. Then for any $t\ge1$,
--   $$
--   \lambda_{r^*+1}(X_{t+1})\le\max\Bigl\{(1-\varepsilon_t)\lambda_{r^*+1}(X_t)\exp\Bigl(-\eta_t\delta+\eta_t\gamma\sqrt{B(X^*,X_t)}+B(X^*,X_t)\Bigr),\ \frac{\varepsilon_t}{n-r}\Bigr\},
--   $$
--   where $\gamma=\sqrt2\bigl(2\beta+\frac{2\sqrt{2r^*}}{\lambda_{r^*}(X^*)}G\bigr)$. This keeps the extra eigenvalue small along the run when the rank parameter overestimates $r^*$.
--
--   Differences from the source:
--   - generalization: G = sup over 𝒮_n of ‖∇f‖₂ → G any upper bound on it; reason: the page's G is one such bound, and Theorem 5 invokes the lemma with G ≥ sup
--   - encoding: the sequence {X_t} generated by Algorithm 2 → any X : ℕ → Matrix with IsRun, where each step may choose any valid top-r eigenvectors; reason: the page leaves the choice of eigenvectors open at ties, so every choice is covered
--   - encoding: ε_t ∈ [0, 1] in Algorithm 2 → 0 < ε₀ and ε_t ∈ (0, 1) for t ≥ 1; reason: ε_t ∈ {0, 1} can make the next iterate singular and its logarithm undefined; excludes an undefined case only
--   - encoding: the gradient ∇f → a map grad tied to f by HasFDerivAt at symmetric matrices (Setting.hasGrad); reason: Lean needs ∇f as data; same instances
--   - encoding: λ_i with 1-based index → lam X i, with value 0 outside 1 ≤ i ≤ n; reason: every index used is in range under the hypotheses
-- source:
--   Garber & Kaplan, On the Efficient Implementation of the Matrix Exponentiated Gradient Algorithm for Low-Rank Matrix Optimization, arXiv:2012.10469v2, Lemma 6, p.21

import Mathlib
import Definitions.Def_LowRankMEG_Setting
import Definitions.Def_LowRankMEG_IsOptimal
import Definitions.Def_LowRankMEG_StrictComplementarity
import Definitions.Def_LowRankMEG_IsRun
import Definitions.Def_PSDPolyApprox_densityMatrices
import Definitions.Def_LowRankMEG_bregman
import Definitions.Def_LowRankMEG_lam
import Definitions.Def_LowRankMEG_gammaConst
import Definitions.Def_WainwrightHDS_NucNorm_opNorm2

namespace LowRankMEG

/-- **Lemma 6**: for `r > r*` and any `t ≥ 1`,
`λ_{r*+1}(X_{t+1}) ≤ max{(1 − ε_t)λ_{r*+1}(X_t) exp(−η_tδ + η_tγ√B(X*, X_t) + B(X*, X_t)), ε_t/(n − r)}`, Eq. (35).
Garber & Kaplan, *On the Efficient Implementation of the Matrix Exponentiated Gradient Algorithm for
Low-Rank Matrix Optimization*, arXiv:2012.10469v2, Lemma 6, p.21.

**Formalization Note.** `0 < ε₀` and `ε_t ∈ (0, 1)` for `t ≥ 1` keep every `X_t`, `t ≥ 1`, positive definite, so
that `log(X_t)` exists; Algorithm 2's `ε_t ∈ {0, 1}` is undefined there. `G` is any upper bound on `‖∇f‖₂`
over `𝒮_n`. -/
theorem lemma_6 {n : ℕ} {f : Matrix (Fin n) (Fin n) ℝ → ℝ}
    {grad : Matrix (Fin n) (Fin n) ℝ → Matrix (Fin n) (Fin n) ℝ} {β : ℝ}
    (hS : Setting f grad β)
    {Xs : Matrix (Fin n) (Fin n) ℝ} {δ G : ℝ} {r : ℕ} {η ε : ℕ → ℝ} {X : ℕ → Matrix (Fin n) (Fin n) ℝ}
    (hopt : IsOptimal f Xs) (hsc : StrictComplementarity grad Xs δ)
    (hrun : IsRun grad η ε r X) (hrs : Xs.rank < r)
    (hε0 : 0 < ε 0) (hε : ∀ t, 1 ≤ t → ε t ∈ Set.Ioo (0 : ℝ) 1)
    (hG : ∀ W ∈ PSDPolyApprox.densityMatrices n, WainwrightHDS.NucNorm.opNorm2 (grad W) ≤ G)
    (t : ℕ) (ht : 1 ≤ t) :
    lam (X (t + 1)) (Xs.rank + 1) ≤
      max
        ((1 - ε t) * lam (X t) (Xs.rank + 1) *
          Real.exp (-(η t * δ) + η t * gammaConst β G Xs * Real.sqrt (bregman Xs (X t))
            + bregman Xs (X t)))
        (ε t / ((n : ℝ) - r)) := by sorry

end LowRankMEG
