/-- Invertibility is the only matrix assumption needed for exact preservation
of the full uniform public matrix. -/
def leftMatrixEquiv {q d N : ℕ} (Q : Matrix (Fin d) (Fin d) (ZMod q)) (hQ : IsUnit Q.det) :
    Matrix (Fin d) (Fin N) (ZMod q) ≃ Matrix (Fin d) (Fin N) (ZMod q) where
  toFun A := Q*A
  invFun A := Q⁻¹*A
  left_inv A := by
    change Q⁻¹*(Q*A)=A
    rw [← Matrix.mul_assoc,Matrix.nonsing_inv_mul Q hQ,Matrix.one_mul]
  right_inv A := by
    change Q*(Q⁻¹*A)=A
    rw [← Matrix.mul_assoc,Matrix.mul_nonsing_inv Q hQ,Matrix.one_mul]

def affineVectorEquiv {q d : ℕ} (Q : Matrix (Fin d) (Fin d) ℤ) (beta : Fin d → ℤ)
    (hQ : IsUnit (matModq q Q).det) : (Fin d → ZMod q)≃(Fin d → ZMod q) where
  toFun x := evalAffine Q beta x
  invFun x := (matModq q Q)⁻¹.mulVec (x-modq q beta)
  left_inv x := by simp only [evalAffine,add_sub_cancel_right,Matrix.mulVec_mulVec,
    Matrix.nonsing_inv_mul _ hQ,Matrix.one_mulVec]
  right_inv x := by simp only [evalAffine,Matrix.mulVec_mulVec,Matrix.mul_nonsing_inv _ hQ,
    Matrix.one_mulVec,sub_add_cancel]

















