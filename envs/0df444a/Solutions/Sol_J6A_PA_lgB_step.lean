/-!
# B-line IL, `J` pre-table (B5-J), part 2: the toolkit

* `ev`, `Rd`, `okR` by structure (simp lemmas), for registers of `rg` and tops of other stacks;
* `Tame V e` (no `pow2`, literals `≤ V`): `mg V e + 1 ≤ (V + 1)^size` (`mg_tame`), so with
  all read values `≤ 2^W` an expression costs at most `cT e W = cE e ((W+1)·size e)`;
* runs `Rn p v c Q c' C`: from `RF v c` to some `RF v' c'` with `Q v'`, for every base state;
  `Rn.seq`, `Rn.mono`; the steps `Rn.asg`, `Rn.push`, `Rn.pop`, `Rn.rd`, `Rn.mv`; the loop
  `Rn.rep` (register invariant, explicit stacks).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS

/-! ## Values by structure -/

/-! ## Tame expressions -/

/-! ## Runs -/

theorem Rn.congr {p : RS} {v : Vr} {c c' c'' : Cs} {Q : Vr → Prop} {C : ℕ} (h : Rn p v c Q c' C)
    (e : c' = c'') : Rn p v c Q c'' C := e ▸ h

theorem RB_of {W : ℕ} {v : Vr} {c : Cs} {e : Ex HS} (hv : BV W v)
    (ho : ∀ j ∈ e.regs, j ∉ rg → |(c j).headD 0| ≤ 2 ^ W) : RB W v c e := by
  intro j hj
  by_cases h : j ∈ rg
  · simp only [tp, if_pos h]; exact hv j h
  · simp only [tp, if_neg h]; exact ho j hj h

section steps
variable {v : Vr} {c : Cs} {W : ℕ}

/-- Push. -/
theorem Rn.push {i : Fin HS} (hi : i ∉ rg) (hi5 : i.val < 56) {e : Ex HS} (hR : Rd c e)
    (hc : e.Clean) (ho : okR v c e) (ht : Tame (2 ^ W) e) (hb : RB W v c e) :
    Rn (.push i e) v c (· = v) (Function.update c i (ev v c e :: c i)) (cT e W) :=
  ⟨_, rfl, fun s => sU s v c hi hi5 hR hc ho hb (mg_lt ht)⟩

end steps

