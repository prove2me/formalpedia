variable {P K D S ρ : ℕ}

theorem NLogN.KFH.p14Leaf_iruns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    (hρ : ρ < K) (hD : 1 ≤ D) {r p w : ℕ} (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P)
    (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ))
    (hx : RecRep r p zs xs) (hl : xs.length = vol (Butterfly.layerShape P K D S))
    (h0 : f 0 = gflat zs ++ l) (hC : Cl f) (hb : NLogN.KFB.GB w zs)
    (hdisk : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    ∃ zs', RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
        ((Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D))) xs) ∧
      NLogN.KFB.GB (p + 1) zs' ∧
      (∀ j (h : j < (Butterfly.prop14Proc (P := P) (S := S) hρ p ((Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D))) xs).length)
        (h' : j < (Butterfly.layerH P K D S ρ hρ xs).length), ∀ c,
        ‖(Butterfly.prop14Proc (P := P) (S := S) hρ p ((Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D))) xs)[j] c -
          (Butterfly.layerH P K D S ρ hρ xs)[j] c‖ < Real.sqrt 2 * 2⁻¹ ^ p) ∧
      IRuns I iprog (fcode (p14Leaf P K D S ρ r)) (encK s f)
        (encK s (Function.update f 0 (gflat zs' ++ l)))
        (cP14 D (vol (Butterfly.layerShape P K D S) * r)
          (zsz ((12 * (vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ)) w) ∧
      cP14 D (vol (Butterfly.layerShape P K D S) * r)
          (zsz ((12 * (vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ)) w ≤
        1000000 * (D + 1) * (w + 8 * D + 8) * (vol (Butterfly.layerShape P K D S) * r) +
        100000 * (D + 1) * (zsz ((12 * (vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ) + 2) := by sorry
