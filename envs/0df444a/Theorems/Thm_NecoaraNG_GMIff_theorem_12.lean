-- title:
--   Theorem 12, p. 22 — (GM) with α_k = 1/L_f on F_{L_f,κ_f}: ‖x^k − x̄^k‖² ≤ (1/(1 + μ_f))^k ‖x⁰ − x̄⁰‖²
-- statement:
--   Let problem (P), $\min_{x \in X} f(x)$, satisfy the standing assumptions ($X \subseteq \mathbb{R}^n$ closed convex, $f$ convex, differentiable on $X$ with $L_f$-Lipschitz gradient (1), $L_f > 0$, $X^* \ne \emptyset$), and let $f$ belong to the class $\mathcal F_{L_f,\kappa_f}$, i.e. satisfy the quadratic functional growth (22) with constant $\kappa_f > 0$. Let $(x^k)_{k \ge 0}$ be generated by the projected gradient method (GM) with constant step size $\alpha_k = 1/L_f$: $x^0 \in X$ and $x^{k+1} = [x^k - \tfrac{1}{L_f}\nabla f(x^k)]_X$. Then, with $\bar x^k = [x^k]_{X^*}$ and the condition number $\mu_f = \kappa_f / L_f$,
--   $$\|x^k - \bar x^k\|^2 \le \left(\frac{1}{1 + \mu_f}\right)^k \|x^0 - \bar x^0\|^2 \qquad \forall k \ge 0. \tag{51}$$
--
--   The theorem shows that the distance of the projected gradient iterates to the optimal set decays geometrically under quadratic functional growth alone, without strong convexity.
--
--   **Formalization Note** The page says the sequence "converges linearly to some optimal point in $X^*$ with the rate" (51); only the rate (51) is stated here, as only it is proved on the page.
-- source:
--   Necoara, Nesterov & Glineur, Linear convergence of first order methods for non-strongly convex optimization, arXiv:1504.06298v4, p. 22, Theorem 12, (51)

import Mathlib
import Definitions.Def_NecoaraNG_GMIff_Setting

namespace NecoaraNG.GMIff

theorem theorem_12 (n : ℕ) (X : Set (NecoaraNG.Chain.E n)) (hXc : IsClosed X) (hXconv : Convex ℝ X)
    (f : NecoaraNG.Chain.E n → ℝ) (hf : ConvexOn ℝ X f)
    (hdiff : ∀ x ∈ X, DifferentiableAt ℝ f x)
    (Lf : ℝ) (hLf : 0 < Lf)
    (hL : ∀ x ∈ X, ∀ y ∈ X, ‖gradient f x - gradient f y‖ ≤ Lf * ‖x - y‖)
    (xstar : NecoaraNG.Chain.E n) (hxstar : xstar ∈ NecoaraNG.Chain.optSet X f)
    (κ : ℝ) (hκ : 0 < κ) (hF : NecoaraNG.Chain.QuadFunGrowth X f κ)
    (x : ℕ → NecoaraNG.Chain.E n) (hrun : IsGMRun X f (fun _ => 1 / Lf) x) :
    ∀ k : ℕ, ∀ xkbar x0bar, NecoaraNG.Chain.IsNearest (NecoaraNG.Chain.optSet X f) (x k) xkbar →
      NecoaraNG.Chain.IsNearest (NecoaraNG.Chain.optSet X f) (x 0) x0bar →
        ‖x k - xkbar‖ ^ 2 ≤ (1 / (1 + κ / Lf)) ^ k * ‖x 0 - x0bar‖ ^ 2 := by sorry

end NecoaraNG.GMIff
