abbrev Z6 (m : ℕ) : Type := Localization.Away ((6 * m : ℕ) : ℤ)

theorem isUnit_six_mul (m : ℕ) : IsUnit (((6 : ℕ) : Z6 m) * ((m : ℕ) : Z6 m)) := by
  have h := IsLocalization.Away.algebraMap_isUnit (S := Z6 m) ((6 * m : ℕ) : ℤ)
  rw [map_natCast] at h
  exact_mod_cast h

theorem isUnit_m (m : ℕ) : IsUnit ((m : ℕ) : Z6 m) := isUnit_of_mul_isUnit_right (isUnit_six_mul m)
theorem isUnit_six (m : ℕ) : IsUnit ((6 : ℕ) : Z6 m) := isUnit_of_mul_isUnit_left (isUnit_six_mul m)
theorem isUnit_two (m : ℕ) : IsUnit (2 : Z6 m) := by
  have := isUnit_of_dvd_unit (Nat.cast_dvd_cast (show (2 : ℕ) ∣ 6 by norm_num)) (isUnit_six m); exact_mod_cast this
theorem isUnit_three (m : ℕ) : IsUnit (3 : Z6 m) := by
  have := isUnit_of_dvd_unit (Nat.cast_dvd_cast (show (3 : ℕ) ∣ 6 by norm_num)) (isUnit_six m); exact_mod_cast this

noncomputable def toRing (m : ℕ) (𝒪 : Type) [CommRing 𝒪]
    (hm' : IsUnit ((m : ℕ) : 𝒪)) (h2 : IsUnit ((2 : ℕ) : 𝒪)) (h3 : IsUnit ((3 : ℕ) : 𝒪)) : Z6 m →+* 𝒪 :=
  IsLocalization.Away.lift ((6 * m : ℕ) : ℤ) (g := Int.castRingHom 𝒪)
    (by
      have : (Int.castRingHom 𝒪) ((6 * m : ℕ) : ℤ) = ((6 : ℕ) : 𝒪) * ((m : ℕ) : 𝒪) := by
        simp [Int.cast_natCast, Nat.cast_mul]
      rw [this]
      exact (by rw [show (6 : ℕ) = 2 * 3 from rfl, Nat.cast_mul]; exact h2.mul h3 : IsUnit ((6 : ℕ) : 𝒪)).mul hm')

