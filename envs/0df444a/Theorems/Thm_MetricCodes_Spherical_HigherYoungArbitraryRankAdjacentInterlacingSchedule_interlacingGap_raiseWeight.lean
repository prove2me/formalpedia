theorem MetricCodes.Spherical.HigherYoungArbitraryRankAdjacentInterlacingSchedule.interlacingGap_raiseWeight
    {r : ℕ} {low : Fin (r + 2) → ℕ}
    {mu : Fin (r + 1) → ℕ} (hlow : Interlaces low mu)
    (row i : Fin (r + 2)) :
    interlacingGap (raiseWeight low row) mu i =
      interlacingGap low mu i + if i = row then 1 else 0 := by sorry
