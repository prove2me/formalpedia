variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution (A C : AModel.Shape) (Q : ℕ) (cs : List ℕ) (hcs : cs.length = A.length)
    (hcQ : ∀ c ∈ cs, c < Q) (hA : ∀ a ∈ A, 1 ≤ a) (hQ : 1 ≤ Q) (w Bb : ℕ)
    (hVb : NLogN.zsz ((AModel.vol A : ℕ) : ℤ) ≤ Bb) (hQb : NLogN.zsz ((2 * Q : ℕ) : ℤ) ≤ Bb)
    (xs : List ℤ) (hlen : xs.length = AModel.vol (A ++ Q :: C)) (hb : NLogN.Bnd w xs)
    (t : NLogN.IState NLogN.HS) (R : List NLogN.Item) (h0 : t.G 0 = NLogN.ints xs ++ R) :
    NLogN.IRuns I iprog (NLogN.KFU.rotStep Q (AModel.vol A) (AModel.vol C) (A.zip cs)) t
      (t.upd 0 (NLogN.ints (AModel.pull (A ++ Q :: C) (A ++ Q :: C)
        (NLogN.KFU.rotG A.length Q (fun a => NLogN.KIL.lf cs a % Q)) 0 xs) ++ R))
      (NLogN.KFU.cRot (AModel.vol A) Q (AModel.vol C) w Bb A.length) := by
  have hfst : (A.zip cs).map Prod.fst = A := List.map_fst_zip (by omega)
  have hac : ∀ p ∈ A.zip cs, 1 ≤ p.1 ∧ p.2 < Q := fun p hp =>
    ⟨hA _ (List.of_mem_zip hp).1, hcQ _ (List.of_mem_zip hp).2⟩
  have G := NLogN.KIL.genP_spec t Q Bb (A.zip cs) (by omega) hQb hac (by rw [hfst]; exact hVb)
  set as : ℕ → ℕ := fun p => NLogN.KIL.lf cs (AModel.decode A p) % Q
  have htbl : NLogN.KIL.tbl Q (A.zip cs) = (List.range (AModel.vol A)).map fun p => ((as p : ℕ) : ℤ) := by
    rw [NLogN.KIL.tbl_zip A cs (by omega)]
    refine List.map_congr_left fun p _ => ?_
    simp [as]
  rw [htbl, List.length_zip, hcs, min_self, hfst] at G
  obtain ⟨c1, hc1, R1⟩ := NLogN.KIL.Sp.irun (I := I) (iprog := iprog) (p := NLogN.KIL.genP Q (A.zip cs))
    ⟨G.1, G.2.1, G.2.2⟩
  set t1 := t.upd 14 (NLogN.ints ((List.range (AModel.vol A)).map fun p => ((as p : ℕ) : ℤ)) ++ t.G 14)
  have h2 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := t1) 1 (AModel.vol A : ℤ)
  set t2 := t1.upd 1 (.int (AModel.vol A : ℤ) :: t1.G 1)
  have h3 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := t2) 2 (Q : ℤ)
  set t3 := t2.upd 2 (.int (Q : ℤ) :: t2.G 2)
  have h4 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := t3) 4 (AModel.vol C : ℤ)
  set t4 := t3.upd 4 (.int (AModel.vol C : ℤ) :: t3.G 4)
  have h5 := NLogN.KFC.rotF_spec (I := I) (iprog := iprog) t4 xs as (AModel.vol A) Q (AModel.vol C) w R (t.G 1) (t.G 2)
    (t.G 4) (t.G 14) (fun p => (Nat.mod_lt _ (by omega)).le)
    (by rw [hlen, AModel.vol_append, AModel.vol_cons]; ring) hb
    (by simp +decide [t4, t3, t2, t1, h0]) (by simp +decide [t4, t3, t2, t1])
    (by simp +decide [t4, t3, t2, t1]) (by simp +decide [t4, t3, t2, t1])
    (by simp +decide [t4, t3, t2, t1])
  set out := AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (NLogN.KIL.rotAddr Q as) 0 xs
  set t5 := (t4.upd 0 (NLogN.ints out ++ R)).upd 14 (t.G 14)
  have h6 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := t5) (i := 1) (a := (AModel.vol A : ℤ))
    (L := t.G 1) (by simp +decide [t5, t4, t3, t2, t1])
  have h7 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := t5.upd 1 (t.G 1)) (i := 2) (a := (Q : ℤ))
    (L := t.G 2) (by simp +decide [t5, t4, t3, t2, t1])
  have h8 := NLogN.IRuns.drop (I := I) (iprog := iprog) (s := (t5.upd 1 (t.G 1)).upd 2 (t.G 2)) (i := 4)
    (a := (AModel.vol C : ℤ)) (L := t.G 4) (by simp +decide [t5, t4, t3, t2, t1])
  have eo : AModel.pull (A ++ Q :: C) (A ++ Q :: C) (NLogN.KFU.rotG A.length Q (fun a => NLogN.KIL.lf cs a % Q)) 0 xs =
      out := by
    simp only [out]
    rw [← NLogN.KFU.pull_rotG A C Q as 0 xs]
    apply AModel.pull_congr
    intro a ha
    have hl : (a.take A.length).length = A.length := by
      have := ha.length_eq; simp at this ⊢; omega
    have hvA : AModel.Valid A (a.take A.length) := by
      have := ha
      rw [← List.take_append_drop A.length a] at this
      exact ((NLogN.KIL.valid_append_iff hl).1 this).1
    simp only [NLogN.KFU.rotG, as, AModel.decode_encode hvA]
  rw [eo]
  refine ((R1.mono hc1).seq (h2.seq (h3.seq (h4.seq (h5.seq (h6.seq (h7.seq h8))))))).mono' ?_ ?_
  · simp only [t5, t4, t3, t2, t1]
    clear R1 h2 h3 h4 h5 h6 h7 h8 G eo
    apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;>
      split_ifs <;> subst_vars <;> simp_all +decide
  · unfold NLogN.KFU.cRot; omega
