theorem solution
    {g d n : ℕ} (δ : Fin g → ℕ) [∀ i, NeZero (δ i)] (hδd : ∏ i, δ i = d)
    {S : Type} [CommRing S] (hd : IsUnit ((d : ℕ) : S))
    (u : PolarisedAbelianScheme g d n S)
    {K : Type} [Field K] [IsAlgClosed K] (t : Spec (CommRingCat.of K) ⟶ Spec (CommRingCat.of S))

    (L' : RelativeGroupLaw K (pullback.snd u.f t))
    (hL' : ∀ (T : Scheme.{0}) (t' : T ⟶ Spec (CommRingCat.of K)) (P Q : SchemeHomOver t' (pullback.snd u.f t)),
      (L'.mul t' P Q).1 ≫ pullback.fst u.f t =
        (u.L.mul (t' ≫ t)
          ⟨P.1 ≫ pullback.fst u.f t, by rw [Category.assoc, pullback.condition, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ pullback.fst u.f t, by rw [Category.assoc, pullback.condition, ← Category.assoc, Q.2]⟩).1)
    (𝓛₀ : (pullback u.f t).Modules) (a b : ℕ) (hab : 1 ≤ a + b)
    (hm : 0 < g → ((a + b : ℕ) : K) ≠ 0) (h𝓛₀ : Scheme.Modules.IsInvertible 𝓛₀)
    (hker : Polarisation.KernelTrivial (pullback.snd u.f t) L' 𝓛₀)
    (hroot : Polarisation.LocIsoOnBase (pullback.snd u.f t)
      ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol)
      (Scheme.Modules.tpow 𝓛₀ a ⊗ Scheme.Modules.tpow ((Scheme.Modules.pullback (Polarisation.negMor (pullback.snd u.f t) L')).obj 𝓛₀) b))
    (x : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i))) → SchemeHomOver t u.f)
    (hx0 : x 0 = u.L.one t) (hx : ∀ h h' : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i))), x (h + h') = u.L.mul t (x h) (x h'))
    (hxinj : Function.Injective x)
    (hxK : ∀ y : SchemeHomOver t u.f, Polarisation.MemKernel u.f u.L u.pol t y → ∃ h : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i))), y = x h)
    (θ₀ : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i))) → ThetaPt u.f u.L u.pol t) (hθ₀ : ∀ h, (θ₀ h).pt = x h)
    (θ : ThetaPt u.f u.L u.pol t)
    (hcomm : ∀ (h : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i)))) (s : Γ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol, ⊤)),
      θ.act ((θ₀ h).act s) = (θ₀ h).act (θ.act s)) :
    θ.pt = u.L.one t := by
  classical

  have hc' : L'.IsCommutative := g1_isCommutative u t L' hL'
  have hAK := g2_bundle u t
  have hdimK := g3_dim (g := g) u t
  have h𝓛K := g4_isInvertible u t
  obtain ⟨ι⟩ := (AlgebraicGeometry.Polarisation.locIsoOnBase_iff_nonempty_iso_of_field (pullback.snd u.f t) _ _).mp hroot

  obtain ⟨Φ, hΦbij, hΦ1, hΦmul, hΦpt, hΦcomm, hΦsc⟩ :=
    AlgebraicGeometry.Polarisation.ThetaPt.exists_bijective_thetaGroup_antiHom_of_compatible u.f u.L u.pol t L' hc' hL'

  have hθx : ∃ h, θ.pt = x h := by
    have hmemK : Polarisation.MemKernel (pullback.snd u.f t) L' ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol)
        (Spec.map (CommRingCat.ofHom (algebraMap K K)))
        (RelativeGroupLaw.AlgPoints.toPoint (Multiplicative.toAdd (RiemannForm.thetaGroup.pt (pullback.snd u.f t) L' hc' _ (Φ θ)))) :=
      (AlgebraicGeometry.Polarisation.memKernel_iff_nonempty_pullback_translation_iso_of_isAlgClosed K (pullback.snd u.f t) L' hc'
        _ h𝓛K _).mpr (g6_nonempty_iso u t L' hc' _ (Φ θ))
    obtain ⟨h, hh⟩ := hxK _ (((g8_bridge u t L' hL').2 _).mp hmemK)
    exact ⟨h, by rw [← hh]; exact Subtype.ext (hΦpt θ).symm⟩
  obtain ⟨h₀, hh₀⟩ := hθx
  rcases Nat.eq_zero_or_pos g with hg | hg
  ·
    haveI : IsEmpty (Fin g) := by rw [hg]; infer_instance
    rw [hh₀, Subsingleton.elim h₀ 0, hx0]
  have hm' : ((a + b : ℕ) : K) ≠ 0 := hm hg

  have htor : ∀ θ₁ : ThetaPt u.f u.L u.pol t,
      (a + b) • Multiplicative.toAdd (RiemannForm.thetaGroup.pt (pullback.snd u.f t) L' hc' _ (Φ θ₁)) = 0 := by
    intro θ₁
    rw [← g7_nsmul_iff u t L' hc']
    refine (AlgebraicGeometry.Polarisation.memKernel_iff_nsmul_eq_one_of_kernelTrivial_of_iso_tpow_tensor_tpow
      (pullback.snd u.f t) L' hc' hAK 𝓛₀ h𝓛₀ hker a b hab _ ι K (Spec.map (CommRingCat.ofHom (algebraMap K K))) _).mp ?_
    exact (AlgebraicGeometry.Polarisation.memKernel_iff_nonempty_pullback_translation_iso_of_isAlgClosed K (pullback.snd u.f t) L' hc'
      _ h𝓛K _).mpr (g6_nonempty_iso u t L' hc' _ (Φ θ₁))

  obtain ⟨hsc_uniq, hsc_mul, hsc_one, hsc_pt⟩ :=
    AlgebraicGeometry.RiemannForm.thetaGroup.existsUnique_isScalarElt_and_isScalarElt_mul K (pullback.snd u.f t) L' hc' hAK ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol) h𝓛K
  have hone : ∀ h, RiemannForm.thetaGroup.IsScalarElt (pullback.snd u.f t) L' hc' _ ⁅Φ (θ₀ h), Φ θ⁆ 1 := by
    intro h

    have hpt1 : RiemannForm.thetaGroup.pt (pullback.snd u.f t) L' hc' _ ⁅Φ (θ₀ h), Φ θ⁆ = 1 := by
      rw [commutatorElement_def, map_mul, map_mul, map_mul, map_inv, map_inv, mul_inv_cancel_comm, mul_inv_cancel]
    obtain ⟨c, hc, -⟩ := hsc_uniq _ hpt1
    have hc1 : c = 1 := by
      apply g11_faithful u t hd c
      intro s'
      have hX : (θ₀ h).act (θ.act (θ⁻¹.act (((θ₀ h)⁻¹).act s'))) = s' := by
        rw [← ThetaPt.mul_act θ, mul_inv_cancel, ThetaPt.one_act, ← ThetaPt.mul_act, mul_inv_cancel, ThetaPt.one_act]
      have key := hΦcomm (θ₀ h) θ c hc (θ⁻¹.act (((θ₀ h)⁻¹).act s'))
      rw [hcomm, hX] at key
      exact key.symm
