local instance boundaryLoopMetric7 : MetricSpace FiberedUnion := componentUnionMetric elementaryMoves chosenHolonomyUnit

local instance boundaryLoopMetric8 : MetricSpace VertexUnion := vertexUnionMetric elementaryMoves chosenHolonomyUnit

def totalToFiber : VertexUnion ≃ FiberedUnion :=
  Equiv.sigmaAssoc (fun j u => Quotient (discDepth j u))

def totalToFiberCoarsening : OAI.CoarseAssembly.Analytic.CoarseningMorphism (OAI.CoarseAssembly.Rips.coarsening OAI.CoarseAssembly.VertexUnion) (OAI.CoarseAssembly.Rips.coarsening OAI.CoarseAssembly.FiberedUnion) := by
  classical

  exact OAI.CoarseAssembly.Rips.embeddingCoarsening OAI.CoarseAssembly.totalToFiber.toEmbedding (fun x y => ((
    let local_proof (x y : OAI.CoarseAssembly.VertexUnion) : dist (OAI.CoarseAssembly.totalToFiber x) (OAI.CoarseAssembly.totalToFiber y) = dist x y :=
      open OAI OAI.CoarseAssembly in
        open Congruence Rips Analytic in
        rfl
    local_proof) x y).le)

end CoarseAssembly

