theorem mulPre_run (s : IState HS) (a b : ℤ) (L : List Item)
    (hA : s.G ARGM = .int a :: .int b :: L) : mulPre.run s = Q1 s a b L := by
  have h1 := abs_sel a; have h2 := abs_sel b
  simp only [mulPre, RS.seqL, RS.run]
  apply IState.ext' _ (by simp [Q1]) (by simp [Q1])
  intro x
  simp (config := {decide := true}) only [IState.upd_G, Ex.eval, IState.top, sgnE, absE, hA,
    List.tail_cons, List.head?_cons, Option.getD_some, Q1]
  fin_cases x <;> simp (config := {decide := true}) [sg1, h1, h2] <;> first | rfl | skip

theorem blen_Q1 (s : IState HS) (a b : ℤ) (L : List Item) :
    blenRM.run (Q1 s a b L) = Q2 s a b L := by
  simp (config := {decide := true}) [blenRM, RM.run, Q2, IState.top, Q1, IState.upd_G]

theorem mid1_Q2 (s : IState HS) (a b : ℤ) (L : List Item) :
    (RS.seqL [.pop NLogN.Top.BX, .push NLogN.Top.BX (.reg XB)]).run (Q2 s a b L) = Q3 s a b L := by
  simp only [RS.seqL, RS.run]
  apply IState.ext' _ (by simp [Q3, Q2, Q1]) (by simp [Q3, Q2, Q1])
  intro x
  simp (config := {decide := true}) only [IState.upd_G, Ex.eval, IState.top, Q3, Q2, Q1,
    List.tail_cons, List.head?_cons, Option.getD_some]
  fin_cases x <;> simp (config := {decide := true}) <;> first | rfl | skip

theorem blen_Q3 (s : IState HS) (a b : ℤ) (L : List Item) :
    blenRM.run (Q3 s a b L) = Q4 s a b L := by
  simp (config := {decide := true}) [blenRM, RM.run, Q4, Q3, Q2, Q1, IState.top, IState.upd_G]

theorem nOf_facts (a b : ℤ) : zsz a ≤ nOf a b ∧ zsz b ≤ nOf a b := by
  simp only [nOf, zsz_natAbs]; exact ⟨le_max_left _ _, le_max_right _ _⟩

set_option maxHeartbeats 2000000 in
theorem mulPre_cost (s : IState HS) (a b : ℤ) (L : List Item)
    (hA : s.G ARGM = .int a :: .int b :: L) :
    mulPre.cost s ≤ 120000 * (nOf a b + 3) := by
  obtain ⟨ha, hb⟩ := nOf_facts a b
  set N := nOf a b
  have ha' : zsz |a| ≤ N + 1 := by rw [zsz_abs]; omega
  have hb' : zsz |b| ≤ N + 1 := by rw [zsz_abs]; omega
  have h1 := abs_sel a; have h2 := abs_sel b
  simp only [mulPre, RS.seqL, RS.cost_seq']
  refine le_trans (add_le_add (cpushL _ _ _ (N + 1) trivial ?_)
    (add_le_add (cpop _ _ (N + 1) ?_) (add_le_add (cpushL _ _ _ (N + 1) trivial ?_)
    (add_le_add (cpop _ _ (N + 1) ?_) (add_le_add (cpushL _ _ _ (N + 1) (by simp [sgnE, Ex.Lin])
      (sgnE_bnd _ _ _ ?_ (by omega)))
    (add_le_add (cpushL _ _ _ (N + 1) (by simp [sgnE, Ex.Lin]) (sgnE_bnd _ _ _ ?_ (by omega)))
    (add_le_add (casgL _ _ _ (N + 1) (by simp [absE, Ex.Lin]) (absE_bnd _ _ _ ?_) ?_)
    (add_le_add (casgL _ _ _ (N + 1) (by simp [absE, Ex.Lin]) (absE_bnd _ _ _ ?_) ?_)
      (cpushL _ _ _ (N + 1) trivial ?_))))))))) ?_
  all_goals first
    | (simp (config := {decide := true}) only [Ex.size, sgnE, absE]; omega)
    | (simp (config := {decide := true}) only [RS.run, IState.top, IState.upd_G, hA, Ex.eval,
        sgnE, absE, h1, h2, List.head?_cons, Option.getD_some, List.tail_cons, if_true,
        if_false, Ex.Bnd, Int.natCast_natAbs, zsz_abs]; omega)

theorem blen_cost (t : IState HS) (M : MulSpec) : blenRM.cost M t = blenCost (t.top NLogN.Top.BX) := rfl

theorem mid1_cost (s : IState HS) (a b : ℤ) (L : List Item) :
    (RS.seqL [.pop NLogN.Top.BX, .push NLogN.Top.BX (.reg XB)]).cost (Q2 s a b L) ≤ 10000 * (nOf a b + 3) := by
  obtain ⟨ha, hb⟩ := nOf_facts a b
  set N := nOf a b
  simp only [RS.seqL, RS.cost_seq']
  refine le_trans (add_le_add (cpop _ _ (N + 1) ?_) (cpushL _ _ _ (N + 1) trivial ?_)) ?_
  all_goals first
    | (simp only [Ex.size]; omega)
    | (simp (config := {decide := true}) only [RS.run, IState.top, IState.upd_G, Q2, Q1,
        Ex.Bnd, List.head?_cons, Option.getD_some, List.tail_cons, if_true, if_false, zsz_abs];
       omega)

set_option maxHeartbeats 2000000 in
theorem mulMid_cost (s : IState HS) (a b : ℤ) (L : List Item) :
    mulMid.cost (Q4 s a b L) ≤ 60000 * (nOf a b + 3) := by
  obtain ⟨ha, hb⟩ := nOf_facts a b
  set N := nOf a b
  have za : zsz (zsz |a| : ℤ) ≤ N + 1 :=
    (zsz_natCast_le_self _).trans (by rw [zsz_abs]; omega)
  have zb : zsz (zsz |b| : ℤ) ≤ N + 1 :=
    (zsz_natCast_le_self _).trans (by rw [zsz_abs]; omega)
  have hd : zsz ((zsz |b| : ℤ) + -(zsz |a| : ℤ)) ≤ N + 1 := by
    apply (zsz_mono (b := (N : ℤ)) ?_).trans (by have := zsz_natCast_le_self N; omega)
    rw [zsz_abs, zsz_abs]; omega
  simp only [mulMid, RS.seqL, RS.cost_seq']
  refine le_trans (add_le_add (cpop _ _ (N + 1) ?_) (add_le_add (cpushL _ _ _ (N + 1) trivial ?_)
    (add_le_add (cpop _ _ (N + 1) ?_) (add_le_add (cpushL _ _ _ (N + 1)
        (by simp [maxE, Ex.Lin]) (maxE_bnd _ _ _ _ ?_ ?_ ?_))
    (add_le_add (cpop _ _ (N + 1) ?_) (cpop _ _ (N + 1) ?_)))))) ?_
  all_goals first
    | (simp only [Ex.size, maxE]; omega)
    | (simp (config := {decide := true}) only [RS.run, IState.top, IState.upd_G, Q4, Q3, Q2, Q1,
        Ex.Bnd, Ex.eval, maxE, List.head?_cons, Option.getD_some, List.tail_cons, if_true,
        if_false, zsz_abs]; omega)
    | (simp (config := {decide := true}) only [RS.run, IState.top, IState.upd_G, Q4, Q3, Q2, Q1,
        Ex.Bnd, Ex.eval, maxE, List.head?_cons, Option.getD_some, List.tail_cons, if_true,
        if_false]; assumption)

theorem zsz_prod_le (a b : ℤ) : zsz (|a| * |b|) ≤ 2 * nOf a b := by
  obtain ⟨ha, hb⟩ := nOf_facts a b
  have := zsz_mul_le |a| |b|; rw [zsz_abs, zsz_abs] at this; omega

set_option maxHeartbeats 2000000 in
theorem mulPost_cost (s : IState HS) (a b : ℤ) (L : List Item) (N : ℕ) (hN : N = nOf a b) :
    mulPost.cost (NLogN.Top.stB s a b L N) ≤ 200000 * (2 * nOf a b + 3) := by
  have hp := zsz_prod_le a b
  have hNn : zsz (N : ℤ) ≤ 2 * nOf a b + 1 := by
    have := zsz_natCast_le_self N; omega
  have hs : ∀ x : ℤ, zsz (sg1 x) ≤ 2 * nOf a b + 1 := fun x => by
    simp only [sg1]; split_ifs <;> simp [zsz_neg, zsz_one]
  have hr : resE.Bnd ((RS.pop NLogN.Top.XN).run (NLogN.Top.stB s a b L N)) (2 * nOf a b + 1) := by
    simp (config := {decide := true}) only [resE, Ex.Bnd, Ex.eval, RS.run, IState.top,
      IState.upd_G, NLogN.Top.stB, st3, List.head?_cons, Option.getD_some, List.tail_cons, if_true,
      if_false, Int.natCast_natAbs, Nat.cast_mul]
    refine ⟨hs a, ?_⟩
    split_ifs <;> simp only [Ex.Bnd, zsz_neg, hs b, true_and] <;> omega
  simp only [mulPost, RS.seqL, RS.cost_seq']
  refine le_trans (add_le_add (cpop _ _ (2 * nOf a b + 1) ?_)
    (add_le_add (cpushL _ _ _ (2 * nOf a b + 1) (by simp [resE, Ex.Lin]) hr)
    (add_le_add (cpop _ _ (2 * nOf a b + 1) ?_) (add_le_add (cpop _ _ (2 * nOf a b + 1) ?_)
      (cpop _ _ (2 * nOf a b + 1) ?_))))) ?_
  all_goals first
    | (simp only [Ex.size, resE]; omega)
    | (simp (config := {decide := true}) only [RS.run, IState.top, IState.upd_G, NLogN.Top.stB, st3,
        List.head?_cons, Option.getD_some, List.tail_cons, if_true, if_false,
        Int.natCast_natAbs, Nat.cast_mul]; first | omega | exact hs _)

set_option maxHeartbeats 2000000 in
theorem smallRM_cost (M : MulSpec) (s : IState HS) (a b : ℤ) (L : List Item) :
    smallRM.cost M (st3 s a b L (nOf a b)) ≤ smallCost (nOf a b) := by
  obtain ⟨ha, hb⟩ := nOf_facts a b
  have hp := zsz_prod_le a b
  set N := nOf a b
  have k1 := RS.pushCost_le (.mul (.reg XA) (.reg XB)) (st3 s a b L N) (2 * N + 1)
    (by simp (config := {decide := true}) [Ex.Bnd, Ex.eval, IState.top, IState.upd_G, st3,
          zsz_abs]
        refine ⟨by omega, by omega, by omega⟩)
  simp only [smallRM, RM.cost, RS.seqL, RS.cost_seq']
  have k2 := cpop XA ((RS.push XR (.mul (.reg XA) (.reg XB))).run (st3 s a b L N)) N
    (by simp (config := {decide := true}) [RS.run, IState.top, IState.upd_G, st3, zsz_abs]; omega)
  have k3 := cpop XB ((RS.pop XA).run ((RS.push XR (.mul (.reg XA) (.reg XB))).run
    (st3 s a b L N))) N
    (by simp (config := {decide := true}) [RS.run, IState.top, IState.upd_G, st3, zsz_abs]; omega)
  simp only [RS.cost] at k1 k2 k3 ⊢
  simp only [Ex.size] at k1
  simp only [smallCost]
  nlinarith

theorem mulPrefix_cost (M : MulSpec) (s : IState HS) (a b : ℤ) (L : List Item)
    (hA : s.G ARGM = .int a :: .int b :: L) : mulPrefix.cost M s ≤ preCost (nOf a b) := by
  obtain ⟨ha, hb⟩ := nOf_facts a b
  have k1 := mulPre_cost s a b L hA
  have k2 := mid1_cost s a b L
  have k3 := mulMid_cost s a b L
  have b1 := blenCost_le |a| (nOf a b) (by rw [zsz_abs]; exact ha)
  have b2 := blenCost_le |b| (nOf a b) (by rw [zsz_abs]; exact hb)
  simp only [mulPrefix, RM.seqL, RM.cost_seq', RM.cost_rs', RM.run_seq, RM.run_rs]
  rw [mulPre_run s a b L hA, blen_Q1, mid1_Q2, blen_Q3, blen_cost, blen_cost]
  have t1 : (Q1 s a b L).top NLogN.Top.BX = |a| := by
    simp (config := {decide := true}) [Q1, IState.top, IState.upd_G]
  have t3 : (Q3 s a b L).top NLogN.Top.BX = |b| := by
    simp (config := {decide := true}) [Q3, IState.top, IState.upd_G]
  rw [t1, t3]
  simp only [preCost]
  push_cast at *
  nlinarith

set_option maxHeartbeats 2000000 in
theorem ite_overhead (s : IState HS) (a b : ℤ) (L : List Item) (n₀ : ℕ) :
    (Ex.add (.reg NLogN.Top.XN) (.lit (-(n₀ : ℤ)))).cost (st3 s a b L (nOf a b)) +
      (2 * moveCost (zsz ((Ex.add (.reg NLogN.Top.XN) (.lit (-(n₀ : ℤ)))).eval (st3 s a b L (nOf a b))))
        + 19) +
      (2 * zsz ((Ex.add (.reg NLogN.Top.XN) (.lit (-(n₀ : ℤ)))).eval (st3 s a b L (nOf a b))) + 2) + 25 ≤
      20000 * (nOf a b + zsz (n₀ : ℤ) + 3) := by
  set N := nOf a b with hN
  set B := N + zsz (n₀ : ℤ) + 1
  have eN : (st3 s a b L N).G NLogN.Top.XN = .int (N : ℤ) :: s.G XN := by
    simp (config := {decide := true}) [st3, IState.upd_G]
  have hv : (Ex.add (.reg NLogN.Top.XN) (.lit (-(n₀ : ℤ)))).eval (st3 s a b L N) = (N : ℤ) + -(n₀ : ℤ) := by
    simp [Ex.eval, IState.top, eN]
  have z1 : zsz (N : ℤ) ≤ B := by have := zsz_natCast_le_self N; omega
  have z2 : zsz (-(n₀ : ℤ)) ≤ B := by rw [zsz_neg]; omega
  have z3 : zsz ((N : ℤ) + -(n₀ : ℤ)) ≤ B := by
    have := zsz_add_le (N : ℤ) (-(n₀ : ℤ)); rw [zsz_neg] at this
    have := zsz_natCast_le_self N; omega
  have k := RS.pushCost_le_lin (Ex.add (.reg NLogN.Top.XN) (.lit (-(n₀ : ℤ)))) (st3 s a b L N) B
    (by simp [Ex.Lin])
    (by simp only [Ex.Bnd, Ex.eval, IState.top, eN, List.head?_cons, Option.getD_some]
        exact ⟨z1, z2, z3⟩)
  rw [hv] at k ⊢
  simp only [Ex.size] at k
  have : zsz ((N : ℤ) + -(n₀ : ℤ)) ≤ B := z3
  omega

set_option maxHeartbeats 2000000 in
theorem mulRM_cost {st : RM} {n₀ : ℕ} {lin : ℕ → ℕ} {calls : ℕ → List (ℕ × ℕ)}
    (hst : StepOK st n₀ lin calls) (M : MulSpec) (Φ : ℕ → ℕ) (s : IState HS) (a b : ℤ)
    (L : List Item) (hA : s.G ARGM = .int a :: .int b :: L)
    (hM : n₀ ≤ nOf a b → ∀ q ∈ calls (nOf a b), MulBnd M q.2 (Φ q.2)) :
    (mulRM n₀ st).cost M s ≤ topCost n₀ (nOf a b) +
      (if nOf a b < n₀ then smallCost (nOf a b) else
        lin (nOf a b) + ((calls (nOf a b)).map fun q => q.1 * Φ q.2).sum) := by
  have k1 := mulPrefix_cost M s a b L hA
  have k2 := ite_overhead s a b L n₀
  have k3 := mulPost_cost s a b L (nOf a b) rfl
  rw [mulRM, RM.cost_seq', mul_prefix_run s a b L hA, RM.cost_seq', branch_run hst,
    RM.cost_rs']
  have eN : (st3 s a b L (nOf a b)).G NLogN.Top.XN = .int (nOf a b : ℤ) :: s.G XN := by
    simp (config := {decide := true}) [st3, IState.upd_G]
  have hc : (Ex.add (.reg NLogN.Top.XN) (.lit (-(n₀ : ℤ)))).eval (st3 s a b L (nOf a b)) =
      (nOf a b : ℤ) - n₀ := by
    simp [Ex.eval, IState.top, eN]; ring
  simp only [RM.cost]
  rw [hc] at k2 ⊢
  split_ifs with h1 h2 h2
  · have := smallRM_cost M s a b L
    simp only [topCost]; omega
  · omega
  · omega
  · obtain ⟨ha, hb⟩ := natAbs_lt_nOf a b
    have := (hst.okc M Φ (st3 s a b L (nOf a b)) a.natAbs b.natAbs (nOf a b) (s.G XA) (s.G XB)
        (s.G NLogN.Top.XN) (by omega)
        ha hb (by simp (config := {decide := true}) [st3, IState.upd_G])
        (by simp (config := {decide := true}) [st3, IState.upd_G])
        (by simp (config := {decide := true}) [st3, IState.upd_G]) (hM (by omega))).2
    simp only [topCost]; omega

end NLogN.Top

end

