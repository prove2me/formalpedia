variable {R : Type*} [CommRing R] {W T m : ℕ}

/-- **`prop11H_labels` is vacuous**: its hypotheses (at the prime `q = q ^ 1`) contradict its
moment hypothesis. -/
theorem prop11H_labels_vacuous_sol_aux [Nontrivial R] (C : QHNet R W T m) {q : ℕ} (hq : q.Prime)
    (hm : 2 ≤ m) (hruns : C.RunsOK) (hE : ∀ f, C.EdgesOK (q ^ f)) (hlab : ∀ f, C.LabOK (q ^ f))
    (hsc : C.ScalarOK) {τ : ℝ} (hτ0 : 0 < τ) (hτ1 : τ ≤ 1) :
    ¬ histMoment C.hist m τ < W := by
  have h := labels_no_saving C (by omega) hq hruns (by simpa using hE 1) (by simpa using hlab 1)
    hsc hτ0 hτ1
  exact not_lt.2 h

end QHNet

