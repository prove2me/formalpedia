section
open NLogN
open IntMul
variable {S P : ℕ}
variable {I : List Sym} {prog : Fin P → Stmt (S + 4) P}
theorem solution {iprog : Fin P → IStmt S P} (hprog : ∀ j, prog j = compile (iprog j))
    {p : IStmt S P} {s s' : IState S} {c : ℕ} (h : IExec I iprog p s s' c) :
    Runs I prog (compile p) (encI s) (encI s') c ∧
      ∀ i f b, p = .loop i f b →
        Runs I prog (inner i f b) (encF i f s) ((encI s').push (s3 S) 0) (c - 24) ∧ 24 ≤ c := by
  induction h with
  | skip s => exact ⟨Runs.skip _, by intro _ _ _ h; cases h⟩
  | op h => exact ⟨h.runs, by intro _ _ _ h; cases h⟩
  | seq _ _ ih₁ ih₂ => exact ⟨Runs.seq ih₁.1 ih₂.1, by intro _ _ _ h; cases h⟩
  | iteT hf _ ih =>
    refine ⟨?_, by intro _ _ _ h; cases h⟩
    exact (Runs.branchOn (by rw [hf, if_pos rfl]; exact ih.1)).mono (by omega)
  | iteF hf _ ih =>
    refine ⟨?_, by intro _ _ _ h; cases h⟩
    exact (Runs.branchOn (by rw [hf]; exact ih.1)).mono (by omega)
  | call _ ih =>
    refine ⟨?_, by intro _ _ _ h; cases h⟩
    exact Runs.call (by rw [hprog]; exact ih.1)
  | @loopF i f b s hf =>
    have hin : Runs I prog (inner i f b) (encF i f s) ((encI s).push (s3 S) 0) 1 := by
      have := Runs.loopF (I := I) (prog := prog) (p := Stmt.seq (.pop (s3 S))
        (.seq (compile b) (flagOf i f))) (i := s3 S) (f := loopTest) (σ := encF i f s)
        (by rw [encF_top, hf]; rfl)
      have hf' : f (cls (s.G i).head?) = false := hf
      simpa [encF, hf, hf', NLogN.inner] using this
    refine ⟨?_, ?_⟩
    · have := Runs.seq (Runs.flagOf (I := I) (prog := prog) (i := i) (f := f) s)
        (Runs.seq (by simpa [encF, hf] using hin) (Runs.pop (I := I) (prog := prog) _ (s3 S)))
      rw [St.push_pop] at this
      exact this.mono (by omega)
    · intro i' f' b' e; cases e; exact ⟨hin.mono (by omega), by omega⟩
  | @loopT i f b s s₁ s₂ c₁ c₂ hf _ _ ih₁ ih₂ =>
    obtain ⟨ih₂a, ih₂b⟩ := ih₂
    obtain ⟨hin₂, hc₂⟩ := ih₂b i f b rfl
    have hbody : Runs I prog (Stmt.seq (.pop (s3 S)) (.seq (compile b) (flagOf i f)))
        (encF i f s) (encF i f s₁) (1 + (c₁ + 21)) := by
      have h1 := Runs.pop (I := I) (prog := prog) (encF i f s) (s3 S)
      rw [encF, St.push_pop] at h1
      exact Runs.seq h1 (Runs.seq ih₁.1 (Runs.flagOf s₁))
    have hin : Runs I prog (inner i f b) (encF i f s) ((encI s₂).push (s3 S) 0)
        (1 + (c₁ + 21) + (c₂ - 24) + 1) :=
      Runs.loopT' (by rw [encF_top, hf]; rfl) hbody hin₂
    refine ⟨?_, ?_⟩
    · have := Runs.seq (Runs.flagOf (I := I) (prog := prog) (i := i) (f := f) s)
        (Runs.seq hin (Runs.pop (I := I) (prog := prog) _ (s3 S)))
      rw [St.push_pop] at this
      exact this.mono (by omega)
    · intro i' f' b' e; cases e; exact ⟨hin.mono (by omega), by omega⟩
end
