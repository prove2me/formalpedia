variable {K V : Type} [Field K] [AddCommGroup V] [Module K V]
namespace Formalism.CountingSumsFrames
theorem _root_.solution {W : Submodule K V} {ι : Type*} [Fintype ι] (R : ι → Submodule K V) (hWR : W ≤ ⨆ i, R i)
    (π : ι → V →ₗ[K] V) (h2 : ∀ i, ∀ x ∈ R i, π i x = x) (h3 : ∀ i j, j ≠ i → ∀ x ∈ R j, π i x = 0) :
    ∀ x ∈ W, ∑ i, π i x = x := by
  intro x hx
  exact Submodule.iSup_induction R (motive := fun x => ∑ i, π i x = x) (hWR hx)
    (fun j y hy => by
      show ∑ i, π i y = y
      rw [Finset.sum_eq_single j]
      · exact h2 j y hy
      · intro i _ hij
        exact h3 i j (Ne.symm hij) y hy
      · intro hj
        exact absurd (Finset.mem_univ _) hj)
    (by simp)
    (fun y z hy hz => by
      show ∑ i, π i (y + z) = y + z
      simp only [map_add, Finset.sum_add_distrib]
      rw [hy, hz])
end Formalism.CountingSumsFrames
