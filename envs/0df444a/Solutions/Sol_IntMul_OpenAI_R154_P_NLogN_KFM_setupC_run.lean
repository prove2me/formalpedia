    exact_mod_cast this
  have hr2 : 2 ∣ IntMul.OpenAI.R154.rP n := by
    have hℓ1 : 1 ≤ ℓP n := by
      have : (1 : ℝ) ≤ ℓP n := by
        refine le_trans ?_ hl1
        rw [le_div_iff₀ (by positivity)]
        have h5 := b_ge_d5 hn
        have hd' : (1 : ℝ) ≤ IntMul.OpenAI.R154.dP n := by exact_mod_cast hd1
        have : (IntMul.OpenAI.R154.dP n : ℝ) ≤ (IntMul.OpenAI.R154.dP n : ℝ) ^ 5 := le_self_pow₀ hd' (by norm_num)
