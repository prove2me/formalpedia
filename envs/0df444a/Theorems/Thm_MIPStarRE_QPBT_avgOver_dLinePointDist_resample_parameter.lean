/-!
# Diagonal line-point parameter resampling

This module proves that a uniform affine parameter may replace the sampled
point on a diagonal line without changing the joint diagonal line-point law,
including its zero-direction fibers.

## References

The result supports the Schwartz-Zippel step in `lem:qld-xz-lines`,
`references/qpbt-paper/14_analysis_of_the_pauli_basis_test.tex:950-955`, for
the diagonal sampler of
`references/qpbt-paper/08_classical_and_quantum_low_degree_tests.tex:274-287`.
-/



open MIPStarRE.QPBT

open LIDT.MIPStarRE.LDT

theorem MIPStarRE.QPBT.avgOver_dLinePointDist_resample_parameter (L : _root_.MIPStarRE.QPBT.LdParams)
    (value : (_root_.MIPStarRE.QPBT.LineDesc L × (Fin L.m -> _root_.MIPStarRE.QPBT.ScalarQ L)) -> ℝ) :
    _root_.LIDT.MIPStarRE.LDT.avgOver (_root_.MIPStarRE.QPBT.dLinePointDist L) value =
      _root_.LIDT.MIPStarRE.LDT.avgOver (_root_.MIPStarRE.QPBT.dLinePointDist L) (fun sample =>
        _root_.LIDT.MIPStarRE.LDT.avgOver (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.MIPStarRE.QPBT.ScalarQ L)) (fun param =>
          value (sample.1, sample.1.base + param • sample.1.direction))) := by sorry
