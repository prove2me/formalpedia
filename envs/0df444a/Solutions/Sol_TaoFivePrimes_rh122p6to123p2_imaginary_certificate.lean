    nlinarith [mul_nonneg h0 (show 0≤1-s.re by linarith)]⟩⟩
  let y : Set.Icc (0:ℝ) 1 := ⟨(5/3)*(s.im-(613/5)),⟨by linarith,by linarith⟩⟩
