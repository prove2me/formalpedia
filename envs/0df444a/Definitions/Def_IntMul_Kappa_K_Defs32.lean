-- Source module: Solutions.KFWLev2
/-!
# KFW: the levels of the uniform level procedure

**`LvQ … k c`**: on every background holding a level-`k` frame (`LevR`) with the KFN side
conditions (`W^k ∣ B`, the stride-`K` layout below `t`, the size budget `Vb`), the single code
`levC jL rowC` implements `tens Cm` on the `m^k` bits at strides `2^{e - K i} S₀` of
`B 2^t S₀` records, with scale `ES k`, width growth `DWb k` (KFN's bound), on the width window
`[0, H]`, at the constant cost `⌊c · B 2^t S₀ · Yu r Z H⌋`.

* `lvQ_zero`: the leaf; `lvQ_succ`: a node over the children; **`lvQ_all`**: every level, with
  `c = cbW k = Lam · cb … k` (KFN's cost coefficients with `CR' = 18 (Kc (K+2) + 1)`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-- The scale of the cost coefficients. -/
noncomputable def Lam : ℕ := 10 ^ 7 * (12 * mC + 30)

/-- The cost coefficient of level `k`. -/
noncomputable def cbW (Kc : ℝ) (K k : ℕ) : ℝ :=
  (Lam : ℝ) * cb Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0 mC (18 * (Kc * (K + 2) + 1)) τ50 k

/-- **The level claim.** -/
def LvQ {Pp : ℕ} (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp) (jL : Fin Pp) (rowC : IStmt HS Pp)
    (K r Z Zr H k : ℕ) (c : ℝ) : Prop :=
  ∀ (σ : Fin HS → Option ℤ) (t S0 e B : ℕ), LevR σ K t S0 r H k e B → 1 ≤ S0 → 1 ≤ B →
    P8Lift.Wc ^ k ∣ B → K * (mC ^ k - 1) ≤ e → e - e % K + K ≤ t →
    zsz ((16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Z → zsz ((Vb K t S0 r H k B : ℕ) : ℤ) ≤ Zr →
    SImplQ Isym tbl (fun s => Agree σ s) 0 H r (fun i : Fin (mC ^ k) => 2 ^ (e - K * i.val) * S0)
      (B * 2 ^ t * S0) (Butterfly.tens Cm) (levC jL rowC) (ES k) (DWb Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0 k)
      (fun _ => ⌊c * ((B * 2 ^ t * S0 * Yu r Zr H : ℕ) : ℝ)⌋₊)

section Lev

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
variable {jL : Fin Pp} {rowC : IStmt HS Pp} {K r Z Zr H : ℕ}

end Lev

end NLogN.KFW

