import Mathlib
import Definitions.Def_Atlas_Core_Basic
/-! # Vacuum certificate for a coordinate metric on an open domain

`VacuumCertificate g ginv U` packages everything a catalogue row must establish:
open, nonempty domain; symmetric metric; `ginv` a genuine (left, hence two-sided) inverse;
`C^∞` components; Lorentzian signature through an explicit invertible frame; vanishing of all
components of the coordinate Ricci tensor. `g`, `ginv`, `U` are data supplied independently of
any proof, so the certificate is never vacuous by construction.
-/

open Filter Topology
open scoped ContDiff

namespace ExactVacuumAtlas

structure VacuumCertificate {n : ℕ} (g ginv : Metric (n + 1)) (U : Set (Pt (n + 1))) : Prop where
  isOpen : IsOpen U
  nonempty : U.Nonempty
  symm : ∀ x ∈ U, ∀ i j, g i j x = g j i x
  inv : ∀ x ∈ U, metricMatrix ginv x * metricMatrix g x = 1
  smooth : ∀ i j, ContDiffOn ℝ ∞ (g i j) U
  smooth_inv : ∀ i j, ContDiffOn ℝ ∞ (ginv i j) U
  lorentz : ∀ x ∈ U, IsLorentzian (metricMatrix g x)
  ricci_flat : ∀ x ∈ U, ∀ b d, ricciOf g ginv b d x = 0

namespace VacuumCertificate

variable {n : ℕ} {g ginv : Metric (n + 1)} {U : Set (Pt (n + 1))}

end VacuumCertificate

end ExactVacuumAtlas


