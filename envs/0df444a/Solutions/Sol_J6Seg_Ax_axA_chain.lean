section
-- Source module: Solutions.J6SegAxA1
/-!
# `A`-line axis program (`AxisUA6`), part 1: sequential composition of steps

* `PassOK.seq`: two `PassOK` steps in sequence are a `PassOK` step for the composed map;
* `axisBodyA6_of_pass`: if procedure `eX` is a statement that is, for every axis `k ≤ D`, a
  `PassOK` step for `pipeA6 P n src D k` (precondition true on every admissible input), then
  `AxisBodyA6` holds (cost `+ 2` for the call).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

theorem PassOK.seq {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {st₁ st₂ : IStmt HS Pp}
    {dA : Fin HS} {desc : List ℤ} {P₁ P₂ : List GI → Prop} {g₁ g₂ : List GI → List GI}
    {C₁ C₂ : ℝ} (hA0 : dA ≠ 0) (h₁ : PassOK Isym tbl st₁ dA desc P₁ g₁ C₁)
    (h₂ : PassOK Isym tbl st₂ dA desc P₂ g₂ C₂) :
    PassOK Isym tbl (.seq st₁ st₂) dA desc (fun L => P₁ L ∧ P₂ (g₁ L)) (fun L => g₂ (g₁ L))
      (C₁ + C₂) := by
  intro s F L l hF hd h0 ⟨p1, p2⟩
  obtain ⟨c₁, r₁, k₁⟩ := h₁ s F L l hF hd h0 p1
  obtain ⟨c₂, r₂, k₂⟩ := h₂ s (update F 0 (gflat (g₁ L) ++ l)) (g₁ L) l
    (fun j h1 h2 => by rw [update_of_ne h1]; exact hF j h1 h2)
    (by rw [update_of_ne hA0]; exact hd) (by simp) p2
  rw [update_idem] at r₂
  exact ⟨c₁ + c₂, r₁.seq r₂, by push_cast; linarith⟩

end J6Seg.Ax

end

end

section
-- Source module: Solutions.J6SegAxA4
/-!
# `A`-line axis program (`AxisUA6`), part 4: the eight-step chain of `pipeAL`

The `A` per-axis pipeline `J6A.pipeAL p s t α H pre post` (`J6AIL6`) is the composition of
eight one-array steps (`M = t / 16H`, `2^f = 8H`, `N = pre · t · post`):

1. `dupL 32` (the copies),           2. `blkT 2^5 N 1` (fine exposure, forward),
3. `blkT (t·post) 2^5 pre` (back),   4. the gather slab pass (`srcG`),
5. `blkT 2^3 (M·8H·post) pre`,       6. `blkT (8H·post) 2^3 (pre·M)` (`rgp`),
7. the kernel pass `kerPass 2^f post (pre·8M) (gK ∘ (· % 8M))`,
8. the compress slab pass (`srcC`).

**`axA_chain`**: `PassOK` steps for these maps (with their natural preconditions: the length,
`GB w` before the kernel, `GB w'` after it) compose to a `PassOK` step for `pipeAL` with the
precondition `|L| = N ∧ GB w L`.
Also the value-bound helpers `GB_dupL`, `GB_blkTg`, `GB_lineAt`, `GB_of_LRep`, `GB_slabId`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-! ## Value bounds through the list passes -/

theorem GB_dupL {w : ℕ} {L : List GI} (h : GB w L) (K : ℕ) : GB w (J6A.dupL K L) := by
  intro z hz
  unfold J6A.dupL at hz
  obtain ⟨l, hl, hz⟩ := List.mem_flatten.1 hz
  rw [List.eq_of_mem_replicate hl] at hz
  exact h z hz

theorem GB_getD {w : ℕ} {L : List GI} (h : GB w L) (i : ℕ) :
    zsz (L.getD i default).1 ≤ w ∧ zsz (L.getD i default).2 ≤ w := by
  by_cases hi : i < L.length
  · rw [List.getD_eq_getElem _ _ hi]; exact h _ (List.getElem_mem hi)
  · rw [List.getD_eq_default _ _ (by omega)]
    show zsz (0 : ℤ) ≤ w ∧ zsz (0 : ℤ) ≤ w
    simp [zsz_zero]

theorem GB_blkTg {w : ℕ} {L : List GI} (h : GB w L) (m k a : ℕ) : GB w (blkTg m k a L) := by
  intro z hz
  unfold blkTg at hz
  simp only [List.mem_flatMap, List.mem_range] at hz
  obtain ⟨i, -, hz⟩ := hz
  have hs : GB w ((L.drop (i * (m * k))).take (m * k)) :=
    fun z hz => h z (List.mem_of_mem_drop (List.mem_of_mem_take hz))
  simp only [IntMul.HvdH.Ref.transposeL, List.mem_map, List.mem_range] at hz
  obtain ⟨q, -, rfl⟩ := hz
  exact GB_getD hs _

theorem GB_lineAt {w : ℕ} {L : List GI} (h : GB w L) (n post b c : ℕ) :
    GB w (lineAt n post L b c) := by
  intro z hz
  simp only [lineAt, List.mem_map, List.mem_range] at hz
  obtain ⟨k, -, rfl⟩ := hz
  exact GB_getD h _

theorem GB_of_LRep {w pre n post : ℕ} {L : List GI} {φ : ℕ → ℕ → List GI}
    (hL : LRep pre n post L φ) (hφ : ∀ b < pre, ∀ c < post, GB w (φ b c)) : GB w L := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
  have hi' := hi
  rw [hL.1] at hi'
  obtain ⟨b, a, c, hb, ha, hc, he⟩ := idx3 hi'
  have := hL.2.2 b hb a ha c hc
  rw [← he, List.getD_eq_getElem _ _ hi] at this
  have ha' : a < (φ b c).length := by rw [hL.2.1 b hb c hc]; exact ha
  rw [List.getD_eq_getElem _ _ ha'] at this
  simp only [he] at this ⊢
  rw [this]
  exact hφ b hb c hc _ (List.getElem_mem ha')

theorem GB_slabId {w n n' post pre : ℕ} (hnp : 0 < n * post) {src : ℕ → Option ℕ} {L : List GI}
    (hL : L.length = pre * (n * post)) (h : GB w L) :
    GB w (slabPass n n' post src (fun _ z => z) L) := by
  intro z hz
  rcases Slab.mem_slabPass hnp hL hz with he | ⟨l, x, hx, he⟩
  · rw [he]; show zsz (0 : ℤ) ≤ w ∧ zsz (0 : ℤ) ≤ w
    simp [zsz_zero]
  · rw [he]; exact h x hx

/-! ## Weakening a step -/

theorem PassOK.conv {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {st : IStmt HS Pp}
    {dA : Fin HS} {desc : List ℤ} {Pre Pre' : List GI → Prop} {g g' : List GI → List GI}
    {C C' : ℝ} (h : PassOK Isym tbl st dA desc Pre g C)
    (hP : ∀ L, Pre' L → Pre L ∧ g L = g' L) (hC : C ≤ C') :
    PassOK Isym tbl st dA desc Pre' g' C' := fun s F L l h1 h2 h3 h4 => by
  obtain ⟨hp, he⟩ := hP L h4
  obtain ⟨c, r, k⟩ := h s F L l h1 h2 h3 hp
  rw [he] at r
  exact ⟨c, r, k.trans hC⟩

/-! ## The chain -/

/-- **The `A` chain.** -/
theorem axA_chain_sol_aux {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {dA : Fin HS}
    {desc : List ℤ} {st1 st2 st3 st4 st5 st6 st7 st8 : IStmt HS Pp}
    {C1 C2 C3 C4 C5 C6 C7 C8 : ℝ} (hA0 : dA ≠ 0)
    {p s t α H pre post M f w w' : ℕ} {X0 : ℤ}
    (hM : t / (16 * H) = M) (hf : 2 ^ f = 8 * H) (ht0 : 0 < t) (hp : 0 < post)
    (hsG : MonoSrc (32 * t) (8 * (M * (8 * H))) (J6A.srcG s t H (J6A.WA p α H) M (8 * H)))
    (h1 : PassOK Isym tbl st1 dA desc (fun L => L.length = pre * (t * post) ∧ GB w L)
      (J6A.dupL 32) C1)
    (h2 : PassOK Isym tbl st2 dA desc
      (fun L => L.length = 1 * (2 ^ 5 * (pre * (t * post))) ∧ GB w L)
      (blkT (2 ^ 5) (pre * (t * post)) 1) C2)
    (h3 : PassOK Isym tbl st3 dA desc (fun L => L.length = pre * (2 ^ 5 * (t * post)) ∧ GB w L)
      (blkT (t * post) (2 ^ 5) pre) C3)
    (h4 : PassOK Isym tbl st4 dA desc
      (fun L => L.length = pre * (32 * t * post) ∧ ∀ u ∈ gflat L, zsz u ≤ w)
      (slabPass (32 * t) (8 * (M * (8 * H))) post (J6A.srcG s t H (J6A.WA p α H) M (8 * H))
        (fun _ z => z)) C4)
    (h5 : PassOK Isym tbl st5 dA desc
      (fun L => L.length = pre * (2 ^ 3 * (M * (8 * H) * post)) ∧ GB w L)
      (blkT (2 ^ 3) (M * (8 * H) * post) pre) C5)
    (h6 : PassOK Isym tbl st6 dA desc
      (fun L => L.length = pre * M * (2 ^ 3 * (8 * H * post)) ∧ GB w L)
      (blkT (8 * H * post) (2 ^ 3) (pre * M)) C6)
    (h7 : PassOK Isym tbl st7 dA desc
      (fun L => L.length = pre * (M * 8) * (2 ^ f * post) ∧ GB w L ∧
        ∀ b < pre * (M * 8), ∀ c < post,
          (fun x : List GI => x.length = 8 * H ∧ KR.AB X0 x) (lineAt (2 ^ f) post L b c))
      (kerPass (2 ^ f) post (pre * (M * 8))
        (fun b => J6A.gK p s t α H (8 * H) (b % (M * 8)))) C7)
    (h8 : PassOK Isym tbl st8 dA desc
      (fun L => L.length = pre * (M * 8 * (8 * H) * post) ∧ ∀ u ∈ gflat L, zsz u ≤ w')
      (slabPass (M * 8 * (8 * H)) t post (J6A.srcC H (8 * H)) (fun _ z => z)) C8)
    (hAB : ∀ x : List GI, GB w x → KR.AB X0 x)
    (hgl : ∀ q x, x.length = 8 * H → (J6A.gK p s t α H (8 * H) q x).length = 8 * H)
    (hgB : ∀ q < M * 8, ∀ x : List GI, x.length = 8 * H → KR.AB X0 x →
      GB w' (J6A.gK p s t α H (8 * H) q x)) :
    PassOK Isym tbl (axAProg st1 st2 st3 st4 st5 st6 st7 st8) dA desc
      (fun L => L.length = pre * (t * post) ∧ GB w L) (J6A.pipeAL p s t α H pre post)
      (C1 + C2 + C3 + C4 + C5 + C6 + C7 + C8) := by
  have H0 := PassOK.seq hA0 h1 (PassOK.seq hA0 h2 (PassOK.seq hA0 h3 (PassOK.seq hA0 h4
    (PassOK.seq hA0 h5 (PassOK.seq hA0 h6 (PassOK.seq hA0 h7 h8))))))
  refine H0.conv (fun L ⟨hlen, hgb⟩ => ?_) (le_of_eq (by ring))
  have hfp : 0 < 2 ^ f := by positivity
  have hnp : 0 < 32 * t * post := by positivity
  -- the intermediate arrays
  have l1 : (J6A.dupL 32 L).length = 1 * (2 ^ 5 * (pre * (t * post))) := by
    rw [J6A.length_dupL, hlen]; ring
  have g1 := GB_dupL hgb 32
  have l2 : (blkT (2 ^ 5) (pre * (t * post)) 1 (J6A.dupL 32 L)).length =
      pre * (2 ^ 5 * (t * post)) := by
    show (blkTg _ _ _ _).length = _; rw [length_blkTg]; ring
  have g2 : GB w (blkT (2 ^ 5) (pre * (t * post)) 1 (J6A.dupL 32 L)) := GB_blkTg g1 _ _ _
  set L3 := blkT (t * post) (2 ^ 5) pre (blkT (2 ^ 5) (pre * (t * post)) 1 (J6A.dupL 32 L))
    with hL3
  have l3 : L3.length = pre * (32 * t * post) := by
    show (blkTg _ _ _ _).length = _; rw [length_blkTg]; ring
  have g3 : GB w L3 := GB_blkTg g2 _ _ _
  set L4 := slabPass (32 * t) (8 * (M * (8 * H))) post
    (J6A.srcG s t H (J6A.WA p α H) M (8 * H)) (fun _ z => z) L3 with hL4
  have l4 : L4.length = pre * (2 ^ 3 * (M * (8 * H) * post)) := by
    rw [hL4, Slab.length_slabPass hnp hsG _ l3]; ring
  have g4 : GB w L4 := GB_slabId hnp l3 g3
  set L5 := blkT (2 ^ 3) (M * (8 * H) * post) pre L4 with hL5
  have l5 : L5.length = pre * M * (2 ^ 3 * (8 * H * post)) := by
    show (blkTg _ _ _ _).length = _; rw [length_blkTg]; ring
  have g5 : GB w L5 := GB_blkTg g4 _ _ _
  set L6 := blkT (8 * H * post) (2 ^ 3) (pre * M) L5 with hL6
  have l6 : L6.length = pre * (M * 8) * (2 ^ f * post) := by
    show (blkTg _ _ _ _).length = _; rw [length_blkTg, hf]; ring
  have g6 : GB w L6 := GB_blkTg g5 _ _ _
  have r6 : ∀ b < pre * (M * 8), ∀ c < post,
      (fun x : List GI => x.length = 8 * H ∧ KR.AB X0 x) (lineAt (2 ^ f) post L6 b c) :=
    fun b _ c _ => ⟨by simp [lineAt, hf], hAB _ (GB_lineAt g6 _ _ _ _)⟩
  set L7 := kerPass (2 ^ f) post (pre * (M * 8))
    (fun b => J6A.gK p s t α H (8 * H) (b % (M * 8))) L6 with hL7
  have hR7 := LRep_kerPass hfp hp (LRep_lineAt (pre := pre * (M * 8)) l6)
    (fun b => J6A.gK p s t α H (8 * H) (b % (M * 8)))
    (fun b X hX => by rw [hf] at hX ⊢; exact hgl _ X hX)
  have l7 : L7.length = pre * (M * 8 * (8 * H) * post) := by rw [hR7.1, hf]; ring
  have g7 : GB w' L7 := GB_of_LRep hR7 (fun b hb c hc =>
    hgB _ (Nat.mod_lt _ (by
      rcases Nat.eq_zero_or_pos (M * 8) with h | h
      · rw [h, mul_zero] at hb; omega
      · exact h)) _ ((r6 b hb c hc).1) (r6 b hb c hc).2)
  refine ⟨⟨⟨hlen, hgb⟩, ⟨l1, g1⟩, ⟨l2, g2⟩, ⟨l3, bnd_of_GB g3⟩, ⟨l4, g4⟩, ⟨l5, g5⟩,
    ⟨l6, g6, r6⟩, ⟨l7, bnd_of_GB g7⟩⟩, ?_⟩
  -- the map
  show slabPass _ _ _ _ _ L7 = _
  rw [hL7, hL6, hL5, hL4, hL3]
  simp only [J6A.pipeAL, J6A.cpy, J6A.rgp, hM]
  rw [hf]
  rfl

end J6Seg.Ax

end

end

theorem solution : type_of% @J6Seg.Ax.axA_chain_sol_aux := @J6Seg.Ax.axA_chain_sol_aux
