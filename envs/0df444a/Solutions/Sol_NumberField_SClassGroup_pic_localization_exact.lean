import Mathlib

open NumberField IsDedekindDomain

set_option autoImplicit false

namespace Sol_NumberField_SClassGroup_pic_localization_exact

open scoped nonZeroDivisors

variable {R : Type*} [CommRing R] [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K]
  [IsFractionRing R K]

/-- On an invertible submodule the valuation attains a greatest value. -/
theorem exists_isGreatest (v : HeightOneSpectrum R) (I : (Submodule R K)ˣ) :
    ∃ γ : WithZero (Multiplicative ℤ),
      IsGreatest (v.valuation K '' ((I : Submodule R K) : Set K)) γ := by
  classical
  obtain ⟨T, hT⟩ : (I : Submodule R K).FG := Module.Finite.iff_fg.mp inferInstance
  obtain ⟨x₀, hx₀, hmax⟩ := Finset.exists_max_image (insert 0 T) (v.valuation K)
    ⟨0, Finset.mem_insert_self 0 T⟩
  have hTI : ∀ x ∈ T, x ∈ (I : Submodule R K) := fun x hx => hT ▸ Submodule.subset_span hx
  refine ⟨v.valuation K x₀, ⟨x₀, ?_, rfl⟩, ?_⟩
  · rcases Finset.mem_insert.mp hx₀ with h | h
    · rw [h]; exact Submodule.zero_mem _
    · exact hTI x₀ h
  · rintro _ ⟨y, hy, rfl⟩
    have key : ∀ z ∈ Submodule.span R (T : Set K), v.valuation K z ≤ v.valuation K x₀ := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem x hx => exact hmax x (Finset.mem_insert_of_mem hx)
      | zero => exact hmax 0 (Finset.mem_insert_self 0 T)
      | add x y _ _ hx hy => exact Valuation.map_add_le _ hx hy
      | smul r x _ hx =>
        rw [Algebra.smul_def, map_mul]
        exact (mul_le_of_le_one_left' (v.valuation_le_one r)).trans hx
    exact key y (by rw [hT]; exact hy)

/-- The greatest value of the `v`-adic valuation on an invertible submodule. -/
noncomputable def ordAt (v : HeightOneSpectrum R) (I : (Submodule R K)ˣ) :
    WithZero (Multiplicative ℤ) := Classical.choose (exists_isGreatest v I)

theorem ordAt_spec (v : HeightOneSpectrum R) (I : (Submodule R K)ˣ) :
    IsGreatest (v.valuation K '' ((I : Submodule R K) : Set K)) (ordAt v I) :=
  Classical.choose_spec (exists_isGreatest v I)

theorem ordAt_eq (v : HeightOneSpectrum R) (I : (Submodule R K)ˣ)
    {γ : WithZero (Multiplicative ℤ)}
    (h : IsGreatest (v.valuation K '' ((I : Submodule R K) : Set K)) γ) : ordAt v I = γ :=
  (ordAt_spec v I).unique h

theorem le_ordAt (v : HeightOneSpectrum R) (I : (Submodule R K)ˣ) {x : K}
    (hx : x ∈ (I : Submodule R K)) : v.valuation K x ≤ ordAt v I :=
  (ordAt_spec v I).2 ⟨x, hx, rfl⟩

theorem exists_eq_ordAt (v : HeightOneSpectrum R) (I : (Submodule R K)ˣ) :
    ∃ x ∈ (I : Submodule R K), v.valuation K x = ordAt v I :=
  (ordAt_spec v I).1

theorem ordAt_mul (v : HeightOneSpectrum R) (I J : (Submodule R K)ˣ) :
    ordAt v (I * J) = ordAt v I * ordAt v J := by
  apply ordAt_eq
  obtain ⟨x, hx, hxv⟩ := exists_eq_ordAt v I
  obtain ⟨y, hy, hyv⟩ := exists_eq_ordAt v J
  refine ⟨⟨x * y, ?_, by rw [map_mul, hxv, hyv]⟩, ?_⟩
  · rw [Units.val_mul]; exact Submodule.mul_mem_mul hx hy
  · rintro _ ⟨z, hz, rfl⟩
    rw [SetLike.mem_coe, Units.val_mul] at hz
    refine Submodule.mul_induction_on hz (fun m hm n hn => ?_)
      (fun a b ha hb => Valuation.map_add_le _ ha hb)
    rw [map_mul]
    exact mul_le_mul' (le_ordAt v I hm) (le_ordAt v J hn)

theorem ordAt_one (v : HeightOneSpectrum R) : ordAt v (1 : (Submodule R K)ˣ) = 1 := by
  apply ordAt_eq
  refine ⟨⟨1, ?_, map_one _⟩, ?_⟩
  · rw [SetLike.mem_coe, Units.val_one]; exact Submodule.one_le.mp le_rfl
  · rintro _ ⟨z, hz, rfl⟩
    rw [SetLike.mem_coe, Units.val_one] at hz
    obtain ⟨r, rfl⟩ := Submodule.mem_one.mp hz
    exact v.valuation_le_one r

/-- `ordAt` as a monoid homomorphism. -/
noncomputable def ordHom (v : HeightOneSpectrum R) :
    (Submodule R K)ˣ →* WithZero (Multiplicative ℤ) where
  toFun := ordAt v
  map_one' := ordAt_one v
  map_mul' := ordAt_mul v

theorem ordAt_ne_zero (v : HeightOneSpectrum R) (I : (Submodule R K)ˣ) : ordAt v I ≠ 0 := by
  intro h
  have := ordAt_mul v I I⁻¹
  rw [mul_inv_cancel, ordAt_one, h, zero_mul] at this
  exact one_ne_zero this

theorem ordAt_inv (v : HeightOneSpectrum R) (I : (Submodule R K)ˣ) :
    ordAt v I⁻¹ = (ordAt v I)⁻¹ := by
  have := ordAt_mul v I I⁻¹
  rw [mul_inv_cancel, ordAt_one] at this
  exact eq_inv_of_mul_eq_one_right this.symm

/-- The principal invertible submodule generated by a nonzero element. -/
noncomputable abbrev principal (a : Kˣ) : (Submodule R K)ˣ :=
  Units.map (Submodule.spanSingleton R).toMonoidHom a

theorem ordAt_principal (v : HeightOneSpectrum R) (a : Kˣ) :
    ordAt v (principal (R := R) a) = v.valuation K (a : K) := by
  apply ordAt_eq
  refine ⟨⟨a, ?_, rfl⟩, ?_⟩
  · exact Submodule.mem_span_singleton_self _
  · rintro _ ⟨z, hz, rfl⟩
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hz
    rw [Algebra.smul_def, map_mul]
    exact mul_le_of_le_one_left' (v.valuation_le_one r)

/-- Key lemma: the class of an invertible submodule `I` dies in the Picard group of the
`S`-integers iff its orders away from `S` are those of a single field element. -/
theorem mapAlgebra_unitsToPic_eq_one_iff (S : Set (HeightOneSpectrum R)) (I : (Submodule R K)ˣ) :
    CommRing.Pic.mapAlgebra R (S.integer K) (Submodule.unitsToPic R K I) = 1 ↔
      ∃ a : Kˣ, ∀ v : HeightOneSpectrum R, v ∉ S → ordAt v I = v.valuation K (a : K) := by
  let φ : (S.integer K) →ₐ[R] K := (S.integer K).val
  have hφ : Function.Injective φ := Subtype.val_injective
  constructor
  · intro h
    obtain ⟨J, hJ⟩ := (Submodule.mulExact_unitsToPic_mapAlgebra R (S.integer K) _).mp h
    let JK : (Submodule R K)ˣ := Units.map (Submodule.mapHom φ).toMonoidHom J
    have hJK : Submodule.unitsToPic R K JK = Submodule.unitsToPic R K I := by
      rw [← hJ]
      exact CommRing.Pic.mk_eq_mk_iff.mpr
        ⟨(Submodule.equivMapOfInjective φ.toLinearMap hφ J.1).symm⟩
    have hker : I * JK⁻¹ ∈ (Submodule.unitsToPic R K).ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, hJK, mul_inv_cancel]
    rw [Submodule.ker_unitsToPic] at hker
    obtain ⟨a, ha⟩ := hker
    refine ⟨a, fun v hv => ?_⟩
    have hI : I = principal a * JK := by
      change principal a = I * JK⁻¹ at ha
      rw [ha, inv_mul_cancel_right]
    have hle : ∀ L : (Submodule R (S.integer K))ˣ,
        ordAt v (Units.map (Submodule.mapHom φ).toMonoidHom L) ≤ 1 := by
      intro L
      obtain ⟨x, hx, hxv⟩ := exists_eq_ordAt v (Units.map (Submodule.mapHom φ).toMonoidHom L)
      rw [← hxv]
      obtain ⟨y, -, rfl⟩ := hx
      exact y.2 v hv
    have h1 : ordAt v JK = 1 := by
      have hmul := ordAt_mul v JK JK⁻¹
      rw [mul_inv_cancel, ordAt_one] at hmul
      have hinv : JK⁻¹ = Units.map (Submodule.mapHom φ).toMonoidHom J⁻¹ := (map_inv _ _).symm
      refine le_antisymm (hle J) ?_
      calc (1 : WithZero (Multiplicative ℤ)) = ordAt v JK * ordAt v JK⁻¹ := hmul
        _ ≤ ordAt v JK * 1 := mul_le_mul' le_rfl (hinv ▸ hle J⁻¹)
        _ = ordAt v JK := mul_one _
    rw [hI, ordAt_mul, ordAt_principal, h1, mul_one]
  · rintro ⟨a, ha⟩
    set I' : (Submodule R K)ˣ := (principal a)⁻¹ * I with hI'
    have h1 : ∀ v : HeightOneSpectrum R, v ∉ S → ordAt v I' = 1 := by
      intro v hv
      rw [hI', ordAt_mul, ordAt_inv, ordAt_principal, ha v hv]
      exact inv_mul_cancel₀ ((Valuation.ne_zero_iff _).mpr a.ne_zero)
    have h1' : ∀ v : HeightOneSpectrum R, v ∉ S → ordAt v I'⁻¹ = 1 := by
      intro v hv; rw [ordAt_inv, h1 v hv, inv_one]
    have hmem : ∀ L : (Submodule R K)ˣ, (∀ v : HeightOneSpectrum R, v ∉ S → ordAt v L = 1) →
        (L : Submodule R K) ≤ LinearMap.range φ.toLinearMap := by
      intro L hL x hx
      exact ⟨⟨x, fun v hv => (hL v hv) ▸ le_ordAt v L hx⟩, rfl⟩
    let J₁ : Submodule R (S.integer K) := Submodule.comap φ.toLinearMap (I' : Submodule R K)
    let J₂ : Submodule R (S.integer K) :=
      Submodule.comap φ.toLinearMap ((I'⁻¹ : (Submodule R K)ˣ) : Submodule R K)
    have hmap₁ : Submodule.map φ.toLinearMap J₁ = (I' : Submodule R K) := by
      rw [Submodule.map_comap_eq]; exact inf_eq_right.mpr (hmem I' h1)
    have hmap₂ : Submodule.map φ.toLinearMap J₂ = ((I'⁻¹ : (Submodule R K)ˣ) : Submodule R K) := by
      rw [Submodule.map_comap_eq]; exact inf_eq_right.mpr (hmem I'⁻¹ h1')
    have hinj : Function.Injective (Submodule.map φ.toLinearMap) :=
      Submodule.map_injective_of_injective hφ
    have h12 : J₁ * J₂ = 1 := by
      apply hinj
      rw [Submodule.map_mul, hmap₁, hmap₂, Submodule.map_one, ← Units.val_mul, mul_inv_cancel,
        Units.val_one]
    have h21 : J₂ * J₁ = 1 := by rw [mul_comm]; exact h12
    obtain ⟨J, hJ₁⟩ : ∃ J : (Submodule R (S.integer K))ˣ, (J : Submodule R (S.integer K)) = J₁ :=
      ⟨⟨J₁, J₂, h12, h21⟩, rfl⟩
    have hJ : Submodule.unitsToPic R (S.integer K) J = Submodule.unitsToPic R K I := by
      have e1 : Submodule.unitsToPic R (S.integer K) J = Submodule.unitsToPic R K I' := by
        rw [Submodule.unitsToPic_apply, Submodule.unitsToPic_apply]
        exact CommRing.Pic.mk_eq_mk_iff.mpr
          ⟨(LinearEquiv.ofEq _ _ hJ₁).trans
            ((Submodule.equivMapOfInjective φ.toLinearMap hφ J₁).trans (LinearEquiv.ofEq _ _ hmap₁))⟩
      have e2 : Submodule.unitsToPic R K (principal a) = 1 := by
        rw [← MonoidHom.mem_ker, Submodule.ker_unitsToPic]; exact ⟨a, rfl⟩
      rw [e1, hI', map_mul, map_inv, e2, inv_one, one_mul]
    exact (Submodule.mulExact_unitsToPic_mapAlgebra R (S.integer K) _).mpr ⟨J, hJ⟩

/-- Every Picard class of the `S`-integers is the base change of the class of an invertible
submodule over the base ring. -/
theorem exists_mapAlgebra_unitsToPic_eq (S : Set (HeightOneSpectrum R))
    (x : CommRing.Pic (S.integer K)) :
    ∃ I : (Submodule R K)ˣ,
      CommRing.Pic.mapAlgebra R (S.integer K) (Submodule.unitsToPic R K I) = x := by
  classical
  have hx : x ∈ (Submodule.unitsToPic (S.integer K) K).range := by
    rw [Submodule.range_unitsToPic, CommRing.relPic_eq_top]; exact Subgroup.mem_top _
  obtain ⟨J, rfl⟩ := hx
  obtain ⟨T, hT⟩ : (J : Submodule (S.integer K) K).FG := Module.Finite.iff_fg.mp inferInstance
  have hne : Submodule.span R (T : Set K) ≠ ⊥ := by
    intro h
    have hJ : (J : Submodule (S.integer K) K) = ⊥ := by
      rw [← hT, Submodule.span_eq_bot]
      intro t ht
      have : t ∈ Submodule.span R (T : Set K) := Submodule.subset_span ht
      rw [h] at this
      exact (Submodule.mem_bot R).mp this
    have h1 := J.mul_inv
    rw [hJ, Submodule.bot_mul] at h1
    have h2 : (1 : K) ∈ (1 : Submodule (S.integer K) K) := Submodule.one_le.mp le_rfl
    rw [← h1] at h2
    exact one_ne_zero ((Submodule.mem_bot _).mp h2)
  let I₁ : FractionalIdeal R⁰ K :=
    ⟨Submodule.span R (T : Set K), FractionalIdeal.isFractional_of_fg ⟨T, rfl⟩⟩
  have hI₁ : I₁ ≠ 0 := by
    intro h
    apply hne
    have := congrArg (fun L : FractionalIdeal R⁰ K => (L : Submodule R K)) h
    simpa [I₁] using this
  obtain ⟨I, hI⟩ : ∃ I : (Submodule R K)ˣ,
      (I : Submodule R K) = Submodule.span R (T : Set K) :=
    ⟨FractionalIdeal.unitsMulEquivSubmodule (Units.mk0 I₁ hI₁), rfl⟩
  refine ⟨I, ?_⟩
  have hIJ : ∀ y : K, y ∈ (I : Submodule R K) → y ∈ (J : Submodule (S.integer K) K) := by
    intro y hy
    rw [hI] at hy
    refine Submodule.span_induction (p := fun y _ => y ∈ (J : Submodule (S.integer K) K))
      (fun t ht => hT ▸ Submodule.subset_span ht) (Submodule.zero_mem _)
      (fun a b _ _ ha hb => Submodule.add_mem _ ha hb)
      (fun r a _ ha => ?_) hy
    rw [← algebraMap_smul (S.integer K) r a]
    exact Submodule.smul_mem _ _ ha
  let g : ↥(I : Submodule R K) →ₗ[R] ↥(J : Submodule (S.integer K) K) :=
    { toFun := fun y => ⟨y.1, hIJ y.1 y.2⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  let f : TensorProduct R (S.integer K) ↥(I : Submodule R K) →ₗ[S.integer K]
      ↥(J : Submodule (S.integer K) K) := g.liftBaseChange (S.integer K)
  have key : ∀ z ∈ Submodule.span (S.integer K) (T : Set K), ∃ w, ((f w : ↥(J : Submodule (S.integer K) K)) : K) = z := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem t ht =>
      refine ⟨(1 : S.integer K) ⊗ₜ[R] ⟨t, hI ▸ Submodule.subset_span ht⟩, ?_⟩
      rw [LinearMap.liftBaseChange_tmul, one_smul]
      rfl
    | zero => exact ⟨0, by rw [map_zero]; rfl⟩
    | add a b _ _ ha hb =>
      obtain ⟨wa, hwa⟩ := ha
      obtain ⟨wb, hwb⟩ := hb
      exact ⟨wa + wb, by rw [map_add, Submodule.coe_add, hwa, hwb]⟩
    | smul c a _ ha =>
      obtain ⟨wa, hwa⟩ := ha
      exact ⟨c • wa, by rw [map_smul, Submodule.coe_smul, hwa]⟩
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨w, hw⟩ := key y.1 (by rw [hT]; exact y.2)
    exact ⟨w, Subtype.ext hw⟩
  have hbij : Function.Bijective f := Module.Invertible.bijective_of_surjective hf
  rw [CommRing.Pic.mapAlgebra_apply, Submodule.unitsToPic_apply (R := S.integer K)]
  exact CommRing.Pic.mk_eq_mk_iff.mpr
    ⟨(TensorProduct.AlgebraTensorModule.congr (LinearEquiv.refl (S.integer K) (S.integer K))
      (Submodule.unitsToPicEquiv I)).trans (LinearEquiv.ofBijective f hbij)⟩

/-- The invertible submodule of a height-one prime. -/
noncomputable def primeUnit (v : HeightOneSpectrum R) : (Submodule R K)ˣ :=
  FractionalIdeal.unitsMulEquivSubmodule
    (FractionalIdeal.mk0 K ⟨v.asIdeal, mem_nonZeroDivisors_iff_ne_zero.mpr v.ne_bot⟩)

theorem coe_primeUnit (v : HeightOneSpectrum R) :
    ((primeUnit v : (Submodule R K)ˣ) : Submodule R K) =
      IsLocalization.coeSubmodule K v.asIdeal := by
  change (↑(↑(FractionalIdeal.mk0 K (⟨v.asIdeal, mem_nonZeroDivisors_iff_ne_zero.mpr v.ne_bot⟩ :
    (Ideal R)⁰)) : FractionalIdeal R⁰ K) : Submodule R K) = _
  rw [FractionalIdeal.coe_mk0, FractionalIdeal.coe_coeIdeal]

theorem ordAt_primeUnit_self (v : HeightOneSpectrum R) :
    ordAt v (primeUnit (K := K) v) = WithZero.exp (-1 : ℤ) := by
  apply ordAt_eq
  rw [coe_primeUnit]
  constructor
  · obtain ⟨π, hπ⟩ := v.intValuation_exists_uniformizer
    have hmem : π ∈ v.asIdeal := by
      have := (v.intValuation_le_pow_iff_mem π 1).mp (by rw [hπ]; rfl)
      rwa [pow_one] at this
    exact ⟨algebraMap R K π, (IsLocalization.mem_coeSubmodule _ _).mpr ⟨π, hmem, rfl⟩,
      by rw [v.valuation_of_algebraMap, hπ]⟩
  · rintro _ ⟨z, hz, rfl⟩
    obtain ⟨r, hr, rfl⟩ := (IsLocalization.mem_coeSubmodule _ _).mp hz
    rw [v.valuation_of_algebraMap]
    exact (v.intValuation_le_pow_iff_mem r 1).mpr (by rwa [pow_one])

theorem ordAt_primeUnit_of_ne {v w : HeightOneSpectrum R} (h : w ≠ v) :
    ordAt v (primeUnit (K := K) w) = 1 := by
  apply ordAt_eq
  rw [coe_primeUnit]
  constructor
  · have hnle : ¬ w.asIdeal ≤ v.asIdeal := fun hle =>
      h (HeightOneSpectrum.ext (w.isMaximal.eq_of_le v.isPrime.ne_top hle))
    obtain ⟨r, hrw, hrv⟩ := SetLike.not_le_iff_exists.mp hnle
    exact ⟨algebraMap R K r, (IsLocalization.mem_coeSubmodule _ _).mpr ⟨r, hrw, rfl⟩,
      v.valuation_eq_one_iff_notMem.mpr hrv⟩
  · rintro _ ⟨z, hz, rfl⟩
    obtain ⟨r, -, rfl⟩ := (IsLocalization.mem_coeSubmodule _ _).mp hz
    exact v.valuation_le_one r

/-- The Picard class attached to a nonzero ideal by `ClassGroup.equivPic` is the class of the
ideal viewed as an invertible submodule of the fraction field. -/
theorem equivPic_mk0_eq (I : (Ideal R)⁰) (U : (Submodule R K)ˣ)
    (hU : (U : Submodule R K) = IsLocalization.coeSubmodule K (I : Ideal R)) :
    ClassGroup.equivPic R (ClassGroup.mk0 I) = Submodule.unitsToPic R K U := by
  obtain ⟨J, hJ, hPic⟩ : ∃ J : (Submodule R (FractionRing R))ˣ,
      (J : Submodule R (FractionRing R)) =
        IsLocalization.coeSubmodule (FractionRing R) (I : Ideal R) ∧
      ClassGroup.equivPic R (ClassGroup.mk0 I) = Submodule.unitsToPic R (FractionRing R) J := by
    refine ⟨FractionalIdeal.unitsMulEquivSubmodule (FractionalIdeal.mk0 (FractionRing R) I),
      ?_, ?_⟩
    · change (↑(↑(FractionalIdeal.mk0 (FractionRing R) I) :
        FractionalIdeal R⁰ (FractionRing R)) : Submodule R (FractionRing R)) = _
      rw [FractionalIdeal.coe_mk0, FractionalIdeal.coe_coeIdeal]
    · rw [ClassGroup.mk0, MonoidHom.comp_apply, ClassGroup.equivPic_apply,
        ← ClassGroup.Quot_mk_eq_mk]
      rfl
  rw [hPic, Submodule.unitsToPic_apply, Submodule.unitsToPic_apply]
  exact CommRing.Pic.mk_eq_mk_iff.mpr
    ⟨(LinearEquiv.ofEq _ _ hJ).trans
      ((Submodule.equivMapOfInjective (Algebra.linearMap R (FractionRing R))
        (IsFractionRing.injective R (FractionRing R)) (I : Ideal R)).symm.trans
      ((Submodule.equivMapOfInjective (Algebra.linearMap R K)
        (IsFractionRing.injective R K) (I : Ideal R)).trans (LinearEquiv.ofEq _ _ hU.symm)))⟩

theorem equivPic_mk0_prime (v : HeightOneSpectrum R) :
    ClassGroup.equivPic R (ClassGroup.mk0
      ⟨v.asIdeal, mem_nonZeroDivisors_iff_ne_zero.mpr v.ne_bot⟩) =
      Submodule.unitsToPic R K (primeUnit v) :=
  equivPic_mk0_eq _ _ (coe_primeUnit v)

/-- The localization exact sequence for an arbitrary Dedekind domain. -/
theorem main [DecidableEq (HeightOneSpectrum R)] (S T : Finset (HeightOneSpectrum R))
    (h : S ⊆ T) :
    let A := (S : Set (HeightOneSpectrum R)).integer K
    let B := (T : Set (HeightOneSpectrum R)).integer K
    let i : A →+* B := (Subalgebra.inclusion (S := A) (T := B)
      (fun _ hx v hv => hx v (fun hvS => hv (h hvS)))).toRingHom
    let p : CommRing.Pic A →* CommRing.Pic B := CommRing.Pic.mapRingHom i
    let c : (↥(T \ S) → ℤ) → CommRing.Pic A := fun n =>
      CommRing.Pic.mapAlgebra R A (∏ v : ↥(T \ S),
        (ClassGroup.equivPic R (ClassGroup.mk0
          ⟨v.1.asIdeal, mem_nonZeroDivisors_iff_ne_zero.mpr v.1.ne_bot⟩)) ^ n v)
    Function.Surjective p ∧
    (∀ x : CommRing.Pic A, p x = 1 ↔ ∃ n : ↥(T \ S) → ℤ, c n = x) ∧
    (∀ n : ↥(T \ S) → ℤ, c n = 1 ↔
      ∃ u : Kˣ, u ∈ (T : Set (HeightOneSpectrum R)).unit K ∧
        ∀ v : ↥(T \ S), v.1.valuation K (u : K) = WithZero.exp (-(n v))) := by
  intro A B i p c
  let D : (↥(T \ S) → ℤ) → (Submodule R K)ˣ := fun n => ∏ v : ↥(T \ S), primeUnit v.1 ^ n v
  have hc : ∀ n, c n = CommRing.Pic.mapAlgebra R A (Submodule.unitsToPic R K (D n)) := by
    intro n
    have hprodc : (∏ v : ↥(T \ S), (ClassGroup.equivPic R (ClassGroup.mk0
        ⟨v.1.asIdeal, mem_nonZeroDivisors_iff_ne_zero.mpr v.1.ne_bot⟩)) ^ n v) =
        Submodule.unitsToPic R K (D n) := by
      change _ = Submodule.unitsToPic R K (∏ v : ↥(T \ S), primeUnit (K := K) v.1 ^ n v)
      rw [map_prod]
      refine Finset.prod_congr rfl (fun v _ => ?_)
      rw [map_zpow, equivPic_mk0_prime (K := K)]
    exact congrArg (CommRing.Pic.mapAlgebra R A) hprodc
  have hp : ∀ y : CommRing.Pic R,
      p (CommRing.Pic.mapAlgebra R A y) = CommRing.Pic.mapAlgebra R B y := by
    intro y
    change CommRing.Pic.mapRingHom i (CommRing.Pic.mapAlgebra R A y) = _
    rw [← CommRing.Pic.mapRingHom_algebraMap, CommRing.Pic.mapRingHom_mapRingHom]
    exact CommRing.Pic.mapRingHom_algebraMap (R := R) (A := B) ▸ rfl
  have hprod : ∀ (n : ↥(T \ S) → ℤ) (v : HeightOneSpectrum R),
      ordAt v (D n) = ∏ w : ↥(T \ S), ordAt v (primeUnit (K := K) w.1) ^ n w := by
    intro n v
    change ordHom v (∏ w : ↥(T \ S), primeUnit (K := K) w.1 ^ n w) = _
    rw [map_prod]
    refine Finset.prod_congr rfl (fun w _ => ?_)
    rw [map_zpow]
    rfl
  have hD₁ : ∀ (n : ↥(T \ S) → ℤ) (v : HeightOneSpectrum R) (hv : v ∈ T \ S),
      ordAt v (D n) = WithZero.exp (-(n ⟨v, hv⟩)) := by
    intro n v hv
    rw [hprod, Fintype.prod_eq_single ⟨v, hv⟩]
    · rw [ordAt_primeUnit_self, ← WithZero.exp_zsmul, smul_eq_mul, mul_neg, mul_one]
    · intro w hw
      rw [ordAt_primeUnit_of_ne (fun hwv => hw (Subtype.ext hwv)), one_zpow]
  have hD₂ : ∀ (n : ↥(T \ S) → ℤ) (v : HeightOneSpectrum R), v ∉ T \ S →
      ordAt v (D n) = 1 := by
    intro n v hv
    rw [hprod]
    refine Finset.prod_eq_one (fun w _ => ?_)
    rw [ordAt_primeUnit_of_ne (fun hwv => hv (by rw [← hwv]; exact w.2)), one_zpow]
  refine ⟨?_, ?_, ?_⟩
  · intro y
    obtain ⟨I, rfl⟩ := exists_mapAlgebra_unitsToPic_eq (K := K) (T : Set (HeightOneSpectrum R)) y
    exact ⟨CommRing.Pic.mapAlgebra R A (Submodule.unitsToPic R K I), hp _⟩
  · intro x
    constructor
    · intro hx
      obtain ⟨I, rfl⟩ :=
        exists_mapAlgebra_unitsToPic_eq (K := K) (S : Set (HeightOneSpectrum R)) x
      rw [hp] at hx
      obtain ⟨a, ha⟩ :=
        (mapAlgebra_unitsToPic_eq_one_iff (T : Set (HeightOneSpectrum R)) I).mp hx
      have ha0 : ∀ v : HeightOneSpectrum R, v.valuation K (a : K) ≠ 0 :=
        fun v => (Valuation.ne_zero_iff _).mpr a.ne_zero
      let n : ↥(T \ S) → ℤ := fun v =>
        -WithZero.log (ordAt v.1 I * (v.1.valuation K (a : K))⁻¹)
      have hn : ∀ v : ↥(T \ S),
          ordAt v.1 I = v.1.valuation K (a : K) * WithZero.exp (-(n v)) := by
        intro v
        change _ = _ * WithZero.exp (- -WithZero.log (ordAt v.1 I * (v.1.valuation K (a : K))⁻¹))
        rw [neg_neg, WithZero.exp_log (mul_ne_zero (ordAt_ne_zero _ _) (inv_ne_zero (ha0 v.1))),
          mul_comm (ordAt v.1 I), mul_inv_cancel_left₀ (ha0 v.1)]
      refine ⟨n, ?_⟩
      rw [hc]
      have h1 : CommRing.Pic.mapAlgebra R A (Submodule.unitsToPic R K (I * (D n)⁻¹)) = 1 := by
        rw [mapAlgebra_unitsToPic_eq_one_iff]
        refine ⟨a, fun v hv => ?_⟩
        rw [ordAt_mul, ordAt_inv]
        by_cases hvT : v ∈ T
        · have hvD : v ∈ T \ S := Finset.mem_sdiff.mpr ⟨hvT, hv⟩
          rw [hD₁ n v hvD, hn ⟨v, hvD⟩, mul_inv_cancel_right₀ WithZero.exp_ne_zero]
        · rw [hD₂ n v (fun hvD => hvT (Finset.mem_sdiff.mp hvD).1), inv_one, mul_one]
          exact ha v hvT
      rw [map_mul, map_mul, map_inv, map_inv, mul_inv_eq_one] at h1
      exact h1.symm
    · rintro ⟨n, rfl⟩
      rw [hc, hp, mapAlgebra_unitsToPic_eq_one_iff]
      refine ⟨1, fun v hv => ?_⟩
      rw [hD₂ n v (fun hvD => hv (Finset.mem_sdiff.mp hvD).1), Units.val_one, map_one]
  · intro n
    rw [hc, mapAlgebra_unitsToPic_eq_one_iff]
    constructor
    · rintro ⟨a, ha⟩
      refine ⟨a, fun v hv => ?_, fun v => ?_⟩
      · have hvT : v ∉ T := hv
        rw [← ha v (fun hvS => hvT (h hvS)),
          hD₂ n v (fun hvD => hvT (Finset.mem_sdiff.mp hvD).1)]
      · rw [← ha v.1 (Finset.mem_sdiff.mp v.2).2, hD₁ n v.1 v.2]
    · rintro ⟨u, hu, huv⟩
      refine ⟨u, fun v hv => ?_⟩
      by_cases hvT : v ∈ T
      · have hvD : v ∈ T \ S := Finset.mem_sdiff.mpr ⟨hvT, hv⟩
        rw [hD₁ n v hvD, huv ⟨v, hvD⟩]
      · rw [hD₂ n v (fun hvD => hvT (Finset.mem_sdiff.mp hvD).1)]
        exact (hu v hvT).symm

end Sol_NumberField_SClassGroup_pic_localization_exact

theorem solution (F : Type*) [Field F] [NumberField F]
    [DecidableEq (HeightOneSpectrum (𝓞 F))]
    (S T : Finset (HeightOneSpectrum (𝓞 F))) (h : S ⊆ T) :
    let A := (S : Set (HeightOneSpectrum (𝓞 F))).integer F
    let B := (T : Set (HeightOneSpectrum (𝓞 F))).integer F
    let i : A →+* B := (Subalgebra.inclusion (S := A) (T := B)
      (fun _ hx v hv => hx v (fun hvS => hv (h hvS)))).toRingHom
    let p : CommRing.Pic A →* CommRing.Pic B := CommRing.Pic.mapRingHom i
    let c : (↥(T \ S) → ℤ) → CommRing.Pic A := fun n =>
      CommRing.Pic.mapAlgebra (𝓞 F) A (∏ v : ↥(T \ S),
        (ClassGroup.equivPic (𝓞 F) (ClassGroup.mk0
          ⟨v.1.asIdeal, mem_nonZeroDivisors_iff_ne_zero.mpr v.1.ne_bot⟩)) ^ n v)
    Function.Surjective p ∧
    (∀ x : CommRing.Pic A, p x = 1 ↔ ∃ n : ↥(T \ S) → ℤ, c n = x) ∧
    (∀ n : ↥(T \ S) → ℤ, c n = 1 ↔
      ∃ u : Fˣ, u ∈ (T : Set (HeightOneSpectrum (𝓞 F))).unit F ∧
        ∀ v : ↥(T \ S), v.1.valuation F (u : F) = WithZero.exp (-(n v))) :=
  Sol_NumberField_SClassGroup_pic_localization_exact.main (R := 𝓞 F) (K := F) S T h
