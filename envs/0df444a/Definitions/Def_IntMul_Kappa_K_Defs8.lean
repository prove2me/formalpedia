/-- **`X_a`**: every edge increases (the labels of §3.3 and table (6)). -/
theorem chain_X (a : T × T × T) :
    chainOK (fun V U => Up U V) (MinS ind (wX a))
      ((namesOn (wX a) (cxFixNamed ℂ ind)).map (labS ind)) (MoutS ind (wX a)) := by
  rw [namesOn_cxFix, names_X]
  (( (simp only [List.map_append, List.map_cons, List.map_nil, List.reverse_cons, List.reverse_nil,
         List.nil_append, List.cons_append, List.singleton_append, labS, MinS, MoutS, wX, wY, wS, wC,
         time, tri, pj_zero, cj_zero, pj_one, cj_one, pj_two, cj_two, Fin.isValue, Fin.reduceEq,
         if_true, if_false, Fin.val_zero, Fin.val_one, Fin.val_two, Fin.coe_ofNat_eq_mod,
         Nat.reduceMod, Nat.reduceSub, List.append_nil])
     (simp only [Ψ1f, Ψ2f, OfNat.ofNat_ne_zero, one_ne_zero, if_false, if_true, Nat.reduceEqDiff])))
  simp only [chainOK]
  obtain ⟨k1, hk1⟩ := out3 hh (hcard a.1)
  obtain ⟨k2, hk2⟩ := out3 hh (hcard a.2.1)
  obtain ⟨k3, hk3⟩ := out3 hh (hcard a.2.2)
  refine ⟨upW ?_ ?_ (incW_of_eq (srcX (hcard _) (hcard _) (hcard _))),
    upW ?_ ?_ (inc_pi (hcard _) (hcard _) 0 le_rfl le_top (y := ek k1) Submodule.mem_top
      (dot_ek_ek _) (orth_L1 (dot_tt_ek hk1))),
    upRefl ?_, upRefl ?_,
    upW ?_ ?_ (bX01 (hcard _) (hcard _) (hcard _) hk1 hk2),
    upW ?_ ?_ (inc_pi (hcard _) (hcard _) 1 le_rfl le_top (y := ek k2) Submodule.mem_top
      (dot_ek_ek _) (orth_L1 (dot_tt_ek hk2))),
    upRefl ?_, upRefl ?_,
    upW ?_ ?_ (bX12 (hcard _) (hcard _) (hcard _) hk1 hk3),
    upW ?_ ?_ (inc_pi (hcard _) (hcard _) 2 le_rfl le_top (y := ek k3) Submodule.mem_top
      (dot_ek_ek _) (orth_L1 (dot_tt_ek hk3))),
    upRefl ?_, upRefl ?_,
