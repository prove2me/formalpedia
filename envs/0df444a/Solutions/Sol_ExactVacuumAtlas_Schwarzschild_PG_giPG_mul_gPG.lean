open Real
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.PG
set_option maxHeartbeats 4000000
variable (M ε : ℝ)
theorem solution (hM : 0 ≤ M) (hε : ε ^ 2 = 1) {x : Pt 4} (hx : x ∈ domEF) :
    metricMatrix (giPG M ε) x * metricMatrix (gPG M ε) x = 1 := by
  have hr := domEF_r hx
  have hs := domEF_s hx
  have hq := qf_sq hM (domEF_r_pos hx)
  have hε' : ε * ε = 1 := by rw [← sq]; exact hε
  ext i j
  fin_cases i <;> fin_cases j <;>
  · simp only [Matrix.mul_apply, metricMatrix, Matrix.of_apply, Fin.sum_univ_four, gPG, giPG,
      Matrix.one_apply, Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk]
    generalize qf M (x 1) = Q at hq ⊢
    have hM' : M = Q ^ 2 * x 1 / 2 := by field_simp at hq; linarith
    subst hM'
    obtain rfl | rfl := mul_self_eq_one_iff.mp hε' <;>
      first | (simp; done) | (field_simp; done) | (field_simp; ring1) | (simp; field_simp; done) | (simp; field_simp; ring1) | norm_num
