open Finset Real

namespace J6Seg
open J6QLU

section ent
variable (P : ℕ)

lemma fmul_approx {x y : ℤ} {c d ex ey Y C : ℝ} (hx : |(x : ℝ) / 2 ^ P - c| ≤ ex)
    (hy : |(y : ℝ) / 2 ^ P - d| ≤ ey) (hY : |(y : ℝ) / 2 ^ P| ≤ Y) (hC : |c| ≤ C)
    (hex : 0 ≤ ex) (hey : 0 ≤ ey) :
    |(fmul P x y : ℝ) / 2 ^ P - c * d| ≤ 1 / (2 * 2 ^ P) + ex * Y + C * ey := by
  have h := fmul_err P x y
  have e : (fmul P x y : ℝ) / 2 ^ P - c * d =
      ((fmul P x y : ℝ) / 2 ^ P - (x : ℝ) / 2 ^ P * ((y : ℝ) / 2 ^ P)) +
      (((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P) + c * ((y : ℝ) / 2 ^ P - d)) := by ring
  rw [e]
  have h1 : |((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P)| ≤ ex * Y := by
    rw [abs_mul]; exact mul_le_mul hx hY (abs_nonneg _) hex
  have h2 : |c * ((y : ℝ) / 2 ^ P - d)| ≤ C * ey := by
    rw [abs_mul]; exact mul_le_mul hC hy (abs_nonneg _) ((abs_nonneg _).trans hC)
  have h3 := abs_add_le (((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P)) (c * ((y : ℝ) / 2 ^ P - d))
  have h4 := abs_add_le ((fmul P x y : ℝ) / 2 ^ P - (x : ℝ) / 2 ^ P * ((y : ℝ) / 2 ^ P))
    (((x : ℝ) / 2 ^ P - c) * ((y : ℝ) / 2 ^ P) + c * ((y : ℝ) / 2 ^ P - d))
  linarith

variable {P} {α σ b : ℝ}

lemma small_sq {x c : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 0.01) : x * (c + x) ≤ (c + 0.01) * x := by
  nlinarith

lemma abs_mul_le' {x y X Y : ℝ} (hx : |x| ≤ X) (hy : |y| ≤ Y) : |x * y| ≤ X * Y := by
  rw [abs_mul]; exact mul_le_mul hx hy (abs_nonneg _) ((abs_nonneg _).trans hx)

lemma abs_le_of_approx {x : ℤ} {c e B : ℝ} (h : |(x : ℝ) / 2 ^ P - c| ≤ e) (hc : |c| ≤ B) :
    |(x : ℝ) / 2 ^ P| ≤ B + e := by
  have := abs_sub_abs_le_abs_sub ((x : ℝ) / 2 ^ P) c; linarith

/-- `T⁻¹_{uv}` as computed by `TinvI` (direct or persymmetric). -/
theorem TinvI_err {T : Tables} {a n w : ℕ} {E : ℝ} (hα : 2 ≤ α) (hσ : 1 ≤ σ)
    (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2) (hT : BlkTab P α σ b T a n E) (hE : 0 ≤ E)
    (hP : 100 * (((n : ℝ) + 1) * E + 1) ≤ 2 ^ P) {u v : ℕ} (hu : u < n) (hv : v < n) :
    |(TinvI P T w a n u v : ℝ) / 2 ^ P - TinvF α σ b n u v| ≤
      7 * (((n : ℝ) + 1) * E + 1) / 2 ^ P := by
  have hσ0 : 0 < α ^ 2 * σ := by
    have : 0 < α ^ 2 := by nlinarith
    nlinarith
  unfold TinvI
  split_ifs
  · rw [TinvF_persym α σ b hσ0 hu hv]
    exact TinvD_err hα hσ hx hb hT hE hP (by omega) (by omega)
  · exact TinvD_err hα hσ hx hb hT hE hP hu hv

/-- `M⁻¹_{uv} = D_u T⁻¹_{uv} D_v⁻¹` as computed in fixed point. -/
theorem MinvE_err_sol_aux {T : Tables} {a n w : ℕ} {E Dm : ℝ} (hα : 2 ≤ α) (hσ : 1 ≤ σ)
    (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2) (hT : BlkTab P α σ b T a n E) (hE : 0 ≤ E)
    (hDm : ∀ u < n, ddR α σ u ≤ Dm)
    (hP : 100 * (((n : ℝ) + 1) * E + 1) ≤ 2 ^ P) {u v : ℕ} (hu : u < n) (hv : v < n) :
    |(fmul P (fmul P (T.dd u) (T.di v)) (TinvI P T w a n u v) : ℝ) / 2 ^ P -
      MinvF α σ b n u v| ≤ 12 * Dm * (((n : ℝ) + 1) * E + 1) / 2 ^ P := by
  have hS : (0 : ℝ) < 2 ^ P := two_pow_pos' P
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = ((n : ℝ) + 1) * E + 1 := ⟨_, rfl⟩
  have hT1 := TinvI_err (w := w) hα hσ hx hb hT hE hP hu hv
  rw [← hK] at hP hT1 ⊢
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  obtain ⟨e, he⟩ : ∃ e : ℝ, e = 1 / 2 ^ P := ⟨_, rfl⟩
  have he0 : 0 ≤ e := by rw [he]; positivity
  have hKe : 100 * (K * e) ≤ 1 := by
    rw [he, mul_one_div, ← mul_div_assoc, div_le_one hS]; linarith
  have hK1 : 1 ≤ K := by rw [hK]; linarith [mul_nonneg hn0 hE]
  have hE1 : E * e ≤ K * e := mul_le_mul_of_nonneg_right (by rw [hK]; linarith [mul_nonneg hn0 hE]) he0
  have hdiv : ∀ c : ℝ, c / 2 ^ P = c * e := fun c => by rw [he]; ring
  have hhalf : 1 / (2 * (2 : ℝ) ^ P) = e / 2 := by rw [he]; ring
  have hT1' : |(TinvI P T w a n u v : ℝ) / 2 ^ P - TinvF α σ b n u v| ≤ 7 * (K * e) :=
    hT1.trans (le_of_eq (by rw [he]; ring))
  have hDm1 : 1 ≤ Dm := le_trans (one_le_ddR hσ 0) (hDm 0 (by omega))
  have tdi := (ulp_div P (hT.di v hv)).trans (le_of_eq (hdiv E))
  have tdd : |(T.dd u : ℝ) / 2 ^ P - ddR α σ u| ≤ E * Dm * e :=
    (ulp_div P (hT.dd u hu)).trans (by
      rw [hdiv]; exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hDm u hu) hE) he0)
  have hEe0 : 0 ≤ E * e := mul_nonneg hE he0
  have hdi1 : |diR α σ v| ≤ 1 := by rw [abs_of_pos (diR_pos v)]; exact diR_le_one hσ v
  have hddb : |ddR α σ u| ≤ Dm := by rw [abs_of_pos (ddR_pos u)]; exact hDm u hu
  have hmd := fmul_approx P tdd tdi (abs_le_of_approx tdi hdi1) hddb (by positivity) hEe0
  rw [hhalf] at hmd
  have hmd' : |(fmul P (T.dd u) (T.di v) : ℝ) / 2 ^ P - ddR α σ u * diR α σ v| ≤
      3 * Dm * (K * e) := by
    refine hmd.trans ?_
    have : E * e ≤ 0.01 := by linarith
    have h1 : E * Dm * e * (1 + E * e) ≤ Dm * (1.01 * (E * e)) := by
      have q : E * Dm * e * (1 + E * e) = Dm * ((E * e) * (1 + E * e)) := by ring
      rw [q]
      apply mul_le_mul_of_nonneg_left _ (by linarith)
      have := small_sq (c := 1) hEe0 (by linarith); linarith
    have h2 : e ≤ Dm * e := le_mul_of_one_le_left he0 hDm1
    have h3 : Dm * (E * e) ≤ Dm * (K * e) := mul_le_mul_of_nonneg_left hE1 (by linarith)
    have h4 : Dm * e ≤ Dm * (K * e) :=
      mul_le_mul_of_nonneg_left (le_mul_of_one_le_left he0 hK1) (by linarith)
    have q2 : E * Dm * e = Dm * (E * e) := by ring
    linarith
  have hpb : |ddR α σ u * diR α σ v| ≤ Dm := by
    have := abs_mul_le' hddb hdi1; linarith
  have hTb := TinvF_abs hα hσ hx hb n u v
  have h3 := fmul_approx P hmd' hT1' (abs_le_of_approx hT1' hTb) hpb (by positivity) (by positivity)
  rw [hhalf] at h3
  have e3 : ddR α σ u * diR α σ v * TinvF α σ b n u v = MinvF α σ b n u v := by
    simp only [MinvF]; ring
  rw [e3] at h3
  rw [show 12 * Dm * K / 2 ^ P = 12 * Dm * K * e by rw [he]; ring]
  refine h3.trans ?_
  have : 7 * (K * e) ≤ 0.07 := by linarith
  have h5 : 3 * Dm * (K * e) * (1.1 + 7 * (K * e)) ≤ 3.6 * (Dm * (K * e)) := by
    have h0 : 0 ≤ Dm * (K * e) := mul_nonneg (by linarith) (by linarith)
    have := mul_le_mul_of_nonneg_left (show 1.1 + 7 * (K * e) ≤ 1.2 by linarith) h0
    linarith
  have hKe' : e ≤ K * e := le_mul_of_one_le_left he0 hK1
  have h6' : K * e ≤ Dm * (K * e) := le_mul_of_one_le_left (by linarith) hDm1
  have h7 : Dm * (7 * (K * e)) = 7 * (Dm * (K * e)) := by ring
  have h8 : 12 * Dm * K * e = 12 * (Dm * (K * e)) := by ring
  rw [h8]; linarith

end ent

end J6Seg

