open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
open ExactVacuumAtlas.EinsteinMaxwell.NP.NullFrameData
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
theorem solution (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (J B : Fin 4) :
    ∑ K, ∑ L, etaNull K L * weylF g gi E K J L B x = 0 := by
  have step : ∑ K, ∑ L, etaNull K L * weylF g gi E K J L B x
      = ∑ a, ∑ b, ∑ c, ∑ d, (weyl g gi a b c d x : ℂ) * E J b x * E B d x * (gi a c x : ℂ) := by
    simp only [weylF, ccontr4, fvec, Finset.mul_sum]
    have e1 : ∀ K, ∑ L, ∑ a, ∑ b, ∑ c, ∑ d,
        etaNull K L * ((weyl g gi a b c d x : ℂ) * E K a x * E J b x * E L c x * E B d x)
        = ∑ a, ∑ b, ∑ c, ∑ d, ∑ L,
          etaNull K L * ((weyl g gi a b c d x : ℂ) * E K a x * E J b x * E L c x * E B d x) :=
      fun K => sum_swap_in4 _
    rw [Finset.sum_congr rfl fun K _ => e1 K, sum_swap_in4]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ =>
      Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun d _ => ?_
    rw [hN.gi_apply hx a c, Finset.mul_sum]
    refine Finset.sum_congr rfl fun K _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun L _ => by ring
  rw [step, sum4_bdac]
  refine Finset.sum_eq_zero fun b _ => Finset.sum_eq_zero fun d _ => ?_
  have h := weyl_trace hN.metric hx b d
  have hc : ∑ a, ∑ c, ((gi a c x : ℝ) : ℂ) * (weyl g gi a b c d x : ℂ) = 0 := by exact_mod_cast h
  calc ∑ a, ∑ c, (weyl g gi a b c d x : ℂ) * E J b x * E B d x * (gi a c x : ℂ)
      = (∑ a, ∑ c, ((gi a c x : ℝ) : ℂ) * (weyl g gi a b c d x : ℂ)) * (E J b x * E B d x) := by
        simp only [Finset.sum_mul]
        exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun c _ => by ring
    _ = 0 := by rw [hc, zero_mul]
