theorem divmod_aux {q a b : ℕ} (ha : a < b) : (q * b + a) / b = q ∧ (q * b + a) % b = a := by
  have hb : 0 < b := by omega
  constructor
  · rw [Nat.add_comm, Nat.add_mul_div_right _ _ hb, Nat.div_eq_of_lt ha, zero_add]
  · rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt ha]

theorem flatMap_rangeMap {α : Type*} (X B : ℕ) (g : ℕ → ℕ → α) :
    (List.range X).flatMap (fun x => (List.range B).map (g x)) =
      (List.range (X * B)).map (fun t => g (t / B) (t % B)) := by
  rcases Nat.eq_zero_or_pos B with hB | hB
  · subst hB; simp
  apply List.ext_getElem?
  intro t
  rw [KFS.getElem?_flatMap_const _ B (fun x => by simp) hB, List.getElem?_map]
  by_cases ht : t < X * B
  · have h1 : t / B < X := (Nat.div_lt_iff_lt_mul hB).2 ht
    rw [List.getElem?_range h1, List.getElem?_range ht]
    simp [List.getElem?_map, List.getElem?_range (Nat.mod_lt _ hB)]
  · have h1 : ¬ t / B < X := fun h => ht (by
      have := (Nat.div_lt_iff_lt_mul hB).1 h; exact this)
    rw [List.getElem?_eq_none (by simpa using h1), List.getElem?_eq_none (by simpa using ht)]
    rfl

theorem gc_neg (z : GI) (c : ℕ) : gc (-z) c = -gc z c := by
  unfold gc; split_ifs <;> rfl

theorem getD_rangeMap {α : Type*} (n : ℕ) (f : ℕ → α) (d : α) {i : ℕ} (hi : i < n) :
    ((List.range n).map f).getD i d = f i := by
  rw [List.getD_eq_getElem _ _ (by simpa using hi)]; simp

theorem gflat_eq (zs : List GI) :
    gflat zs = (List.range (zs.length * 2)).map (fun t => gc (zs.getD (t / 2) 0) (t % 2)) := by
  apply List.ext_getElem?
  intro t
  rw [KFS.gflat_eq_flatMap, KFS.getElem?_flatMap_const _ 2 (fun _ => rfl) (by norm_num),
    List.getElem?_map]
  by_cases ht : t < zs.length * 2
  · rw [List.getElem?_eq_getElem (show t / 2 < zs.length by omega), List.getElem?_range ht]
    simp only [Option.bind_some, Option.map_some]
    rw [List.getD_eq_getElem _ _ (show t / 2 < zs.length by omega)]
    rcases Nat.mod_two_eq_zero_or_one t with h | h <;> simp [h, gc]
  · rw [List.getElem?_eq_none (show zs.length ≤ t / 2 by omega),
      List.getElem?_eq_none (by simpa using ht)]
    rfl

theorem dblPre_eq (m X : ℕ) (xs : List ℤ) (hxs : xs.length = X * m) :
    dblPre m xs X = (List.range X).flatMap (fun x => (List.range (2 * m)).map
      (fun u => if u < m then xs.getD (x * m + u) 0 else -xs.getD (x * m + (u - m)) 0)) := by
  unfold dblPre
  simp only [List.flatMap]
  congr 1
  apply List.map_congr_left
  intro x hx
  simp only [List.mem_range] at hx
  have hl : m ≤ (xs.drop (x * m)).length := by
    rw [List.length_drop, hxs]
    have : (x + 1) * m ≤ X * m := Nat.mul_le_mul_right _ hx
    rw [Nat.succ_mul] at this; omega
  have htl : ((xs.drop (x * m)).take m).length = m := List.length_take_of_le hl
  apply List.ext_getElem (by rw [List.length_append, negL, List.length_map, htl]; simp; ring)
  intro u h1 h2
  simp only [List.length_map, List.length_range] at h2
  rw [List.getElem_map, List.getElem_range]
  by_cases hu : u < m
  · rw [if_pos hu, List.getElem_append_left (by rw [htl]; exact hu), List.getElem_take,
      List.getElem_drop, List.getD_eq_getElem]
  · rw [if_neg hu, List.getElem_append_right (by rw [htl]; omega)]
    simp only [negL, List.getElem_map, List.getElem_take, List.getElem_drop, htl]
    rw [List.getD_eq_getElem]

