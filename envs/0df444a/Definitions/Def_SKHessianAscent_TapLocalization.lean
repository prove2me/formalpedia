namespace SKHessianAscent

/-!
# TAP free energy, and the processes SL-TAP and PHD-TAP driven by stochastic localization

H. Lee, J. S. Sandhu, J. Shi, *Potential Hessian Ascent IV: Sampling the Sherrington–Kirkpatrick
model at β < 1*:

* Definition 2.1 (p. 4), (2.1): `F_TAP(m, y) = −(β/2)⟨m, Am⟩ − ⟨y, m⟩ − Σ_i h(m_i) −
  ¼ n β² (1 − ‖m‖²/n)²`, `h(x) = −((1+x)/2) log((1+x)/2) − ((1−x)/2) log((1−x)/2)`.
* (TAP), p. 7: `0 = ∇F_TAP(m, y) = −βAm − y + ½ log((1+m)/(1−m)) + β²(1 − ‖m‖²/n) m`, and
  `ŷ(m)` "this value of `y`" (p. 5).
* (SL-TAP), p. 8: `dm^y_t = Q̂(m^y_t)(dy_t − f(m^y_t) dt) = Q̂(m^y_t)((m_t − f(m^y_t)) dt + dB_t)`,
  with `dy_t = m_t dt + dB_t` the stochastic localization (SL).
* (PHD-TAP), p. 7, and the proof of Lemma 3.3 (p. 11): `dm̂_t = Q̂(m̂_t) dB_t`,
  `dŷ_t = f(m̂_t) dt + dB_t`, driven by the same Brownian motion as (SL) ("synchronously coupled").

**Formalization Note.** Display (2.3) of the paper, meant to define `ŷ`, repeats the right-hand
side of (2.1); `yhat` is the solution `y` of the displayed equation (TAP), which is what the text
defines. In (SL), written `y_t = tσ + B_t` (p. 13), the Brownian motion of `dy_t = m_t dt + dB_t` is
the innovation `y_t − ∫₀ᵗ m_s ds`, and the filtration is the completed filtration of `(A, y)`. The
processes are stopped at their first exit from `S_{β,A}(c)`, as in
`Def_SKHessianAscent_Dynamics`; the matrix `A` may depend on the sample point.
-/

noncomputable section

/-- The binary entropy `h(x) = −((1+x)/2) log((1+x)/2) − ((1−x)/2) log((1−x)/2)`. -/
def hEnt (x : ℝ) : ℝ :=
  -((1 + x) / 2) * Real.log ((1 + x) / 2) - ((1 - x) / 2) * Real.log ((1 - x) / 2)

/-- The TAP free energy (2.1). -/
def FTAP {n : ℕ} (β : ℝ) (A : Matrix (Fin n) (Fin n) ℝ) (m y : Fin n → ℝ) : ℝ :=
  -(β / 2) * (∑ i, ∑ j, m i * A i j * m j) - (∑ i, y i * m i) - (∑ i, hEnt (m i))
    - (1 / 4 : ℝ) * n * β ^ 2 * (1 - (∑ i, m i ^ 2) / n) ^ 2

/-- `ŷ(m)`: the solution `y` of the TAP equation `∇_m F_TAP(m, y) = 0`,
`ŷ(m) = −βAm + ½ log((1+m)/(1−m)) + β²(1 − ‖m‖²/n) m`. -/
def yhat {n : ℕ} (β : ℝ) (A : Matrix (Fin n) (Fin n) ℝ) (m : Fin n → ℝ) : Fin n → ℝ :=
  fun i => -(β * (A.mulVec m) i) + (1 / 2 : ℝ) * Real.log ((1 + m i) / (1 - m i))
    + β ^ 2 * (1 - (∑ j, m j ^ 2) / n) * m i

/-- The partition function `Z_{βA,y} = Σ_σ exp((β/2)⟨σ, Aσ⟩ + ⟨y, σ⟩)`. -/
def partFn {n : ℕ} (β : ℝ) (A : Matrix (Fin n) (Fin n) ℝ) (y : Fin n → ℝ) : ℝ :=
  ∑ s : Spin n, Real.exp (β * ham A s + ∑ i, y i * spinValue (s i))

/-- The completed filtration of the disorder and the tilt: generated by `A`, by `y_s`, `s ≤ t`,
and by the subsets of the `P`-null sets. -/
abbrev tiltPast {Ω : Type*} [MeasurableSpace Ω] {n : ℕ} (P : Measure Ω)
    (A : Ω → Fin n → Fin n → ℝ) (y : ℝ≥0 → Ω → Fin n → ℝ) (t : ℝ≥0) : MeasurableSpace Ω :=
  MeasurableSpace.comap A inferInstance ⊔
    (⨆ s : Set.Iic t, MeasurableSpace.comap (y s.val) inferInstance) ⊔
    MeasurableSpace.generateFrom {N' | ∃ N : Set Ω, MeasurableSet N ∧ P N = 0 ∧ N' ⊆ N}

/-- The innovation `B_t = y_t − ∫₀ᵗ m_s ds` of (SL), `dy_t = m_t dt + dB_t`. -/
def innov {Ω : Type*} {n : ℕ} (y mag : ℝ≥0 → Ω → Fin n → ℝ) (t : ℝ≥0) (ω : Ω) : SDEState n :=
  WithLp.toLp 2 fun i => y t ω i - ∫ u in (0 : ℝ)..t, mag u.toNNReal ω i

/-- `M = m^y` is the SL-TAP process of the tilt `y` with magnetization `mag`, stopped at its first
exit from `S_{β,A}(c)`: `dm^y_t = Q̂(m^y_t)((m_t − f(m^y_t)) dt + dB_t)`, `m^y_0 = 0`. -/
def IsSLTAP {Ω : Type*} [MeasurableSpace Ω] {n : ℕ} (P : Measure Ω) (β c : ℝ)
    (A : Ω → Fin n → Fin n → ℝ) (y mag : ℝ≥0 → Ω → Fin n → ℝ)
    (M : ℝ≥0 → Ω → Fin n → ℝ) : Prop :=
  IsItoStopped P (tiltPast P A y) (innov y mag)
    (fun ω => exitTime (safeSet β (Matrix.of (A ω)) c) fun t => M t ω)
    (fun t ω => (Qhat β (Matrix.of (A ω)) (M t ω)).mulVec
      (mag t ω - fDrift β (Matrix.of (A ω)) (M t ω)))
    (fun t ω => Qhat β (Matrix.of (A ω)) (M t ω)) M

/-- `(Mh, Yh) = (m̂, ŷ)` is the PHD-TAP pair driven by the Brownian motion of (SL), stopped at the
first exit `τ` of `m̂` from `S_{β,A}(c)`: `dm̂_t = Q̂(m̂_t) dB_t`, `dŷ_t = f(m̂_t) dt + dB_t`,
`m̂_0 = ŷ_0 = 0`. -/
def IsPHDTAP {Ω : Type*} [MeasurableSpace Ω] {n : ℕ} (P : Measure Ω) (β c : ℝ)
    (A : Ω → Fin n → Fin n → ℝ) (y mag : ℝ≥0 → Ω → Fin n → ℝ)
    (Mh Yh : ℝ≥0 → Ω → Fin n → ℝ) : Prop :=
  IsItoStopped P (tiltPast P A y) (innov y mag)
    (fun ω => exitTime (safeSet β (Matrix.of (A ω)) c) fun t => Mh t ω)
    (fun _ _ => 0) (fun t ω => Qhat β (Matrix.of (A ω)) (Mh t ω)) Mh ∧
  ∀ (t : ℝ≥0) ω i, Yh t ω i =
    (∫ u in (0 : ℝ)..t,
      if (u.toNNReal : ℝ≥0∞) < exitTime (safeSet β (Matrix.of (A ω)) c) (fun s => Mh s ω)
      then fDrift β (Matrix.of (A ω)) (Mh u.toNNReal ω) i else 0) +
    stopAt (fun ω => exitTime (safeSet β (Matrix.of (A ω)) c) fun s => Mh s ω)
      (innov y mag) t ω i

/-- Stochastic localization of `μ_{βA}` for one fixed matrix `A` (p. 13): a sample `σ ∼ μ_{βA}`
and an independent standard Brownian motion `B`, with `y_t = tσ + B_t`. -/
structure SLQuenched {n : ℕ} (β : ℝ) (A : Matrix (Fin n) (Fin n) ℝ) {Ω : Type*}
    [MeasurableSpace Ω] (P : Measure Ω) where
  /-- The sample `σ ∼ μ_{βA}`. -/
  σ : Ω → Spin n
  /-- The driving Brownian motion. -/
  B : ℝ≥0 → Ω → (Fin n → ℝ)
  /-- `P` is a probability measure. -/
  prob : IsProbabilityMeasure P
  /-- `σ` is measurable. -/
  measurable_σ : Measurable σ
  /-- `σ ∼ μ_{βA}`. -/
  law : ∀ s : Spin n, P {ω | σ ω = s} = ENNReal.ofReal (gibbsSK β A s)
  /-- `B` is a standard Brownian motion in `ℝⁿ`. -/
  brownian : IsStdBrownian B P
  /-- `B` is independent of `σ`. -/
  indep : IndepFun σ (fun ω => fun t : ℝ≥0 => B t ω) P

namespace SLQuenched

variable {n : ℕ} {β : ℝ} {A : Matrix (Fin n) (Fin n) ℝ} {Ω : Type*} [MeasurableSpace Ω]
  {P : Measure Ω}

/-- The localization tilt `y_t = tσ + B_t`. -/
def y (Y : SLQuenched β A P) (t : ℝ≥0) (ω : Ω) : Fin n → ℝ :=
  (t : ℝ) • spinVec (Y.σ ω) + Y.B t ω

/-- The magnetization `m_t = ⟨σ⟩_{y_t}`. -/
def mag (Y : SLQuenched β A P) (t : ℝ≥0) (ω : Ω) : Fin n → ℝ :=
  meanVec (tiltSK β A (Y.y t ω))

end SLQuenched

end

end SKHessianAscent


