theorem MIPStarRE.QPBT.DistanceCalculus.point_distance_eq_two_defect_of_projective {α ι : Type*}
    [Fintype α] [DecidableEq α] [Fintype ι] [DecidableEq ι]
    (A B : _root_.LIDT.MIPStarRE.Quantum.Measurement α ι)
    (ψ : EuclideanSpace ℂ ι)
    (hA : _root_.MIPStarRE.QPBT.Measurement.IsProjective A)
    (hB : _root_.MIPStarRE.QPBT.Measurement.IsProjective B) :
    (∑ a : α, ‖_root_.MIPStarRE.QPBT.applyOperatorToState (A.effect a - B.effect a) ψ‖ ^ 2) =
      2 * (∑ a : α, ∑ b : α,
        if a = b then 0 else _root_.MIPStarRE.QPBT.DistanceCalculus.stateQForm ψ (A.effect a * B.effect b)) := by sorry
