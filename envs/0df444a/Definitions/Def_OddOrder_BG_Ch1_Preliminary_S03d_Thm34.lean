      ⟨Nat.card ↥K, by rw [← hcompl.card_mul_card, hpcard, mul_comm]⟩
    have hKdvd : Nat.card ↥K ∣ Nat.card G := ⟨Nat.card ↥R, hcompl.card_mul_card.symm⟩
    have hpF : (p : F) ≠ 0 := by
      obtain ⟨m, hm⟩ := hpdvd; intro h0; apply hchar; rw [hm, Nat.cast_mul, h0, zero_mul]
    have hKcardF : (Nat.card ↥K : F) ≠ 0 := by
      obtain ⟨m, hm⟩ := hKdvd; intro h0; apply hchar; rw [hm, Nat.cast_mul, h0, zero_mul]
