theorem p_ge6 : 384 ≤ Q.p := by have := hQ.hb; rw [Q.p_eq]; omega

theorem body_le6_sol_aux :
    (cBody (BN6 Q) (BN6 Q) (Q.p / 6) (dsG Q.p Q.h (D + 1) (σ6 Q) Q.K).length Q.p Q.h D (σ6 Q)
