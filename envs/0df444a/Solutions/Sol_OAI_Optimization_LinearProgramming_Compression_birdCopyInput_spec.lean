private theorem copy_put_safe {K : Type} {P : K → Prop} (m : Memory K) (d : ℕ) (x : K)
    (hm : ∀ j, P (m.data j)) (hx : P x) : ∀ j, P ((m.putData d x).data j) := by
  intro j
  by_cases h : j = d
  · subst j; simpa using hx
  · simpa [h] using hm j

