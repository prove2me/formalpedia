  have hrow2 : (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * (1 + (IntMul.OpenAI.R129.ℓP n : ℝ) ^ IntMul.OpenAI.R129.τ) ≤ N := by
    rw [hN]; unfold IntMul.OpenAI.R129.Ncost
    have : (0 : ℝ) ≤ (IntMul.OpenAI.R129.dP n : ℝ) * (IntMul.OpenAI.Glue.pP n : ℝ) ^ ((1 : ℝ) / 2 + IntMul.OpenAI.R129.δ) * (IntMul.OpenAI.R129.αP n : ℝ) := by positivity
    linarith
  have hrow3 : (IntMul.OpenAI.R129.dP n : ℝ) * (IntMul.OpenAI.Glue.pP n : ℝ) ^ ((1 : ℝ) / 2 + IntMul.OpenAI.R129.δ) * (IntMul.OpenAI.R129.αP n : ℝ) ≤ N := by
    rw [hN]; unfold IntMul.OpenAI.R129.Ncost
    have : (0 : ℝ) ≤ (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * (1 + (IntMul.OpenAI.R129.ℓP n : ℝ) ^ IntMul.OpenAI.R129.τ) := by positivity
    linarith
  have hrow1 : 1 ≤ N := by
    rw [hN]; unfold IntMul.OpenAI.R129.Ncost
    have : (0 : ℝ) ≤ (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * (1 + (IntMul.OpenAI.R129.ℓP n : ℝ) ^ IntMul.OpenAI.R129.τ) := by positivity
    have : (0 : ℝ) ≤ (IntMul.OpenAI.R129.dP n : ℝ) * (IntMul.OpenAI.Glue.pP n : ℝ) ^ ((1 : ℝ) / 2 + IntMul.OpenAI.R129.δ) * (IntMul.OpenAI.R129.αP n : ℝ) := by positivity
    linarith
  have hG1 : 1 ≤ (Real.log (IntMul.OpenAI.Glue.pP n) + 1) ^ 6 := one_le_pow₀ (by linarith)
  have hV : ((2 ^ IntMul.OpenAI.Glue.LP n : ℕ) : ℝ) ≤ IntMul.OpenAI.Glue.VP n := by
    rw [h.VP_eq]
    have : (0 : ℝ) ≤ ((2 ^ IntMul.OpenAI.Glue.LP n : ℕ) : ℝ) := Nat.cast_nonneg _
    nlinarith
  have hV0 : 0 ≤ IntMul.OpenAI.Glue.VP n := le_trans (Nat.cast_nonneg _) hV
  set G := (Real.log (IntMul.OpenAI.Glue.pP n) + 1) ^ 6 with hG
  unfold IntMul.OpenAI.R129.P.NLogN.KFM.cLineU
  rw [hp6, ← hN, ← hG]
  have hVNG : IntMul.OpenAI.Glue.VP n ≤ IntMul.OpenAI.Glue.VP n * N * G := by
    have : 1 ≤ N * G := by nlinarith
