/-- An approximation within `< 1/2` of an integer rounds to that integer. -/
lemma round_recovers (x : ℝ) (c : ℤ) (h : |x - c| < 1 / 2) : round x = c := by
  rw [round_eq, Int.floor_eq_iff]
  rw [abs_lt] at h
  constructor <;> linarith

