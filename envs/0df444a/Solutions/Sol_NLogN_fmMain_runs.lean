      (carZ M (ncZ (2 ^ k) (pcs M (2 ^ k) (fold N a)) (pcs M (2 ^ k) (fold N b))) 0).2) %
        (2 ^ N + 1) = (a * b) % (2 ^ N + 1) := by
  set A := pcs M (2 ^ k) (fold N a)
  set B := pcs M (2 ^ k) (fold N b)
  set C := carZ M (ncZ (2 ^ k) A B) 0 with hC
  have hsp := carZ_spec M (ncZ (2 ^ k) A B) 0
  rw [← hC, length_ncZ, hKM] at hsp
  rw [hKM]
  apply cast_eq_emod N
  have hz := zev_ncZ N (2 ^ k) M hKM A B (length_pcs _ _ _) (length_pcs _ _ _)
  have hfa : ((fold N a).natAbs) < 2 ^ (2 ^ k * M) := by
    rw [hKM]
    have := fold_bound N a hN ha
    have : ((fold N a).natAbs : ℤ) < ((2 ^ N : ℕ) : ℤ) := by
      rw [Int.natCast_natAbs]; push_cast; exact this
    exact_mod_cast this
  have hfb : ((fold N b).natAbs) < 2 ^ (2 ^ k * M) := by
    rw [hKM]
    have := fold_bound N b hN hb
    have : ((fold N b).natAbs : ℤ) < ((2 ^ N : ℕ) : ℤ) := by
      rw [Int.natCast_natAbs]; push_cast; exact this
    exact_mod_cast this
  rw [pcs_spec M _ _ hfa, pcs_spec M _ _ hfb, cast_fold, cast_fold] at hz
  have h2 := two_pow_eq_neg_one N
  have hc := congrArg (fun z : ℤ => (z : ZMod (2 ^ N + 1))) hsp
  simp only [add_zero] at hc
  push_cast at hc hz ⊢
  rw [h2] at hc ⊢
  linear_combination hz - hc

end NLogN

end

