-- title:
--   Eisenstein congruence modulo n(p) for weight-two cusp forms
-- statement:
--   Let $p$ be a prime. The assertion is that there exist a cusp form $f$ of weight $2$ on $\Gamma_0(p)$ lying in [`CuspForm.qIntegralSet p`](def/CuspForm_IntegralLattice.html#L11), i.e. such that every coefficient [`ModularFormClass.qCoeff f n`](def/FLTPrelim_Modularity.html#L19) — the $n$-th coefficient of the $q$-expansion of $f$ of width $1$ — belongs to the bottom subring of $\mathbb{C}$ (the subring generated by $1$, the image of $\mathbb{Z}$), together with a function $a\colon \mathbb{N}\to\mathbb{Z}$ with the three properties: first, $(a_n : \mathbb{C}) =$ [`ModularFormClass.qCoeff f n`](def/FLTPrelim_Modularity.html#L19) for every $n$, so that $a$ realises the $q$-expansion of $f$ as an integer sequence; second, $a_1$ is coprime, in $\mathbb{Z}$, to the integer $n(p) = (p-1)/\gcd(p-1,12)$ (the value of `eisensteinNumerator p`, computed in $\mathbb{N}$); and third, for every $n \neq 0$,
--   $$n(p) \mid a_n - \sigma'_p(n)\, a_1, \qquad \sigma'_p(n) = \sum_{d \mid n,\ p \nmid d} d,$$
--   where $\sigma'_p(n)$ is `sigmaPrimeTo p n`, the sum of those divisors of $n$ not divisible by $p$. No hypothesis beyond the primality of $p$ is imposed.
--
--   This is Mazur's Eisenstein congruence at prime level: modulo $n(p)$, the Eisenstein series $\sum_{n\ge 1}\sigma'_p(n)q^n$ agrees, up to the unit $a_1$, with the $q$-expansion of an integral weight-two cusp form on $\Gamma_0(p)$. It is used in the computation of the order of the Hecke algebra modulo the Eisenstein ideal, [`ModularCurve.natCard_heckeLatticeAlgebra_quotient_eisensteinIdeal_eq_eisensteinNumerator`](thm.html#ModularCurve.natCard_heckeLatticeAlgebra_quotient_eisensteinIdeal_eq_eisensteinNumerator).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_exists_qIntegral_qCoeff_congr_sigmaPrimeTo_eisensteinNumerator.lean

import Definitions.Def_ModularCurve_EisensteinTwoCoeff
import Definitions.Def_ModularCurve_ModularUnit
import Definitions.Def_CuspForm_IntegralLattice

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open ModularCurve

theorem CuspForm.exists_qIntegral_qCoeff_congr_sigmaPrimeTo_eisensteinNumerator
    (p : ℕ) [Fact p.Prime] :
    ∃ f ∈ CuspForm.qIntegralSet p, ∃ af : ℕ → ℤ,
      (∀ n : ℕ, (af n : ℂ) = ModularFormClass.qCoeff f n) ∧
        IsCoprime (af 1) (eisensteinNumerator p : ℤ) ∧
          ∀ n : ℕ, n ≠ 0 →
            (eisensteinNumerator p : ℤ) ∣ af n - (sigmaPrimeTo p n : ℤ) * af 1 := by sorry
