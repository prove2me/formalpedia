theorem OAI.PiExponent.FormalInterpolation.homogeneous_power_relations {d : Nat} (w : Fin d → ℚ) (D : Nat) (hD : 0 < D) (m : Nat) (p : Fin m → MvPolynomial (Fin d) ℂ) (hp : ∀ j, MvPolynomial.IsWeightedHomogeneous w (p j) (D : ℚ)) (hpow : ∀ i : Fin d, ∃ n : Nat, 0 < n ∧ (MvPolynomial.X i : MvPolynomial (Fin d) ℂ) ^ n ∈ Ideal.span (Set.range p)) : ∀ i : Fin d, ∃ n : Nat, 0 < n ∧ ∃ q : Fin m → MvPolynomial (Fin d) ℂ, (MvPolynomial.X i : MvPolynomial (Fin d) ℂ) ^ n = ∑ j, q j * p j ∧ ∀ j, MvPolynomial.IsWeightedHomogeneous w (q j) ((n : ℚ) * w i - (D : ℚ)) := by sorry
