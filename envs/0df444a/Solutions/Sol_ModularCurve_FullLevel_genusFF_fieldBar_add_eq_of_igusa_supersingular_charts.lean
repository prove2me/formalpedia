theorem sum_inv_placeWidthChar_eq (q : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (κ : Type) [Field κ] [CharP κ q] [IsAlgClosed κ] [DecidableEq κ]
    (W : Finset (Place κ (modularFunctionFieldC κ M'))) (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' κ) :
    ∑ s ∈ W, (1 / (placeWidthChar q M' s : ℚ)) = ((q : ℚ) - 1) * dedekindPsi M' / 12 := by
  have h := ModularCurve.sum_inv_placeWidth_eq_eichlerMass_of_ssPlaces q M' hq hqM' κ W hW
  rw [eichlerMass] at h
  rw [← h]
  refine Finset.sum_congr rfl (fun s _ => ?_)
  rw [placeWidthChar_of_five_le hq, one_div]

