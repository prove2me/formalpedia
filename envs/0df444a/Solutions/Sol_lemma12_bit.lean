variable {R : Type*} [CommRing R] {m W : ℕ}

lemma countP_edgeStepsZ (C : Circuit R m W) {N : ℕ} (hN : 1 < N) {A : IMat m}
    (hA : PiOK C.fac A) : (AModel.edgeSteps C N A).countP Step.isSwap = pivRank C A := by
  have : Fact (1 < N) := ⟨hN⟩
  rw [AModel.edgeSteps, countP_shearSteps, pivRank]
  congr 1
  apply Finset.filter_congr
  intro p _
  rcases hA p.1 p.2 with h | h <;> simp [castM, h]

lemma runCost_edgeStepsZ (C : Circuit R m W) {N : ℕ} (hN : 1 < N) (T : ℝ → ℝ) (v : ℝ)
    {A : IMat m} (hA : PiOK C.fac A) :
    runCost T v (AModel.edgeSteps C N A) = (4 * m + 2 * pivRank C A : ℝ) * v + (pivRank C A : ℝ) * T v := by
  have h1 := countP_edgeStepsZ C hN hA
  have h2 : (AModel.edgeSteps C N A).length = 4 * m + 3 * pivRank C A := by
    rw [← h1, AModel.edgeSteps, countP_shearSteps, length_shearSteps, length_pivots]
  have h3 := countP_not_add (AModel.edgeSteps C N A)
  have h4 : (AModel.edgeSteps C N A).countP (fun s => !s.isSwap) = 4 * m + 2 * pivRank C A := by omega
  rw [runCost_eq, h4, h1]
  push_cast; ring

theorem levelCost_eqZ (C : Circuit R m W) {N : ℕ} (hN : 1 < N)
    (hfr : FramesOK (PiOK C.fac) C.gates C.Min C.Mout) (T : ℝ → ℝ) (V : ℝ) :
    levelCost C N T V = costConst C * V + (rankSum C : ℝ) * T (V / W) := by
  rw [levelCost, netCost_eq,
    frameSum_congr (PiOK C.fac) _
      (fun X => (4 * m + 2 * pivRank C X : ℝ) * (V / W) + (pivRank C X : ℝ) * T (V / W))
      (fun X hX => runCost_edgeStepsZ C hN T (V / W) hX) _ _ _ hfr,
    frameSum_lin, rankSum, frameSum_cast, costConst]
  simp only [subSteps, flipSteps, List.length_map, List.length_finRange]
  ring

end Cost

