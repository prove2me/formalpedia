theorem dupCost_le (L : ℕ) : NLogN.dupCost L ≤ 200 * (L + 1) := by
  unfold NLogN.dupCost NLogN.zipCost NLogN.moveCost; omega

theorem cFsI_le (w f a y : ℤ) {Z : ℕ} (hw : zsz w ≤ Z) (hf : zsz f ≤ Z) (ha : zsz a ≤ Z)
