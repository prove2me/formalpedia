-- title:
--   Deligne–Serre lifting for the full weight-2 Hecke algebra
-- statement:
--   Let $N$ be a nonzero natural number and let $\mathbb T =$ [`CuspForm.heckeAlgebra N 2 ∅`](def/CuspForm_HeckeAlgebra.html#L18) be the $\mathbb Z$-subalgebra of $\operatorname{End}_{\mathbb C} S_2(\Gamma_0(N))$ generated by the operators $\mathrm{heckeTLin}$ attached to primes $\ell \nmid N$ together with the operators $\mathrm{heckeULin}$ attached to primes $q \mid N$ (the excluded set being empty, no generator is omitted). Let $\mathfrak m_1 \subset \mathbb T$ be a maximal ideal. The assertion is that there exist: a cusp form $f \in S_2(\Gamma_0(N))$ whose $q$-expansion coefficients $a_n =$ `qCoeff f n` satisfy the conditions packaged in `IsNormalizedEigenform`, namely $a_1 = 1$, $a_{mn} = a_m a_n$ for coprime $m,n$, $a_{p^{r+2}} = a_p a_{p^{r+1}} - p\,a_{p^r}$ for primes $p \nmid N$ and $a_{p^{r+2}} = a_p a_{p^{r+1}}$ for primes $p \mid N$; a finite field $k$ (in the lowest universe); a subring $\mathcal O \subseteq \mathbb C$ containing $a_\ell$ for every prime $\ell$; and ring homomorphisms $\varphi \colon \mathcal O \to k$ and $\chi \colon \mathbb T \to k$ such that $\mathfrak m_1 = \ker \chi$, such that $\chi(T_\ell) = \varphi(a_\ell)$ for every prime $\ell \nmid N$, and such that $\chi(U_\ell) = \varphi(a_\ell)$ for every prime $\ell \mid N$ (the side conditions $\ell \notin \emptyset$ being vacuous arguments of the generators $T$ and $U$).
--
--   This is the Deligne–Serre lifting lemma in weight $2$ for the full (non-anemic) Hecke algebra: every maximal ideal of $\mathbb T$ is the kernel of the reduction of the eigenvalue system of an honest characteristic-zero normalised eigenform, with finite residue field $k$ produced as part of the conclusion rather than prescribed. It feeds the construction of maximal ideals of the weight-$2$ Hecke algebra with prescribed torsion behaviour on the modular curve, via [`ModularCurve.exists_isMaximal_heckeTorsion_jZero_ne_bot_of_ringHom_heckeAlgebra_two`](thm.html#ModularCurve.exists_isMaximal_heckeTorsion_jZero_ne_bot_of_ringHom_heckeAlgebra_two).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_exists_isNormalizedEigenform_ker_of_isMaximal.lean

import Mathlib
import Definitions.Def_CuspForm_HeckeAlgebra
import Definitions.Def_FLTPrelim_Modularity

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem CuspForm.exists_isNormalizedEigenform_ker_of_isMaximal (N : ℕ) [NeZero N]
    (𝔪₁ : Ideal (CuspForm.heckeAlgebra N 2 ∅)) (h𝔪₁ : 𝔪₁.IsMaximal) :
    ∃ (f : CuspForm (CongruenceSubgroup.Gamma0 N) 2) (_ : f.IsNormalizedEigenform)
      (k : Type) (_ : Field k) (_ : Finite k) (𝒪 : Subring ℂ)
      (h𝒪 : ∀ ℓ : Nat.Primes, ModularFormClass.qCoeff f ℓ ∈ 𝒪) (φ : 𝒪 →+* k)
      (χ : CuspForm.heckeAlgebra N 2 ∅ →+* k),
      𝔪₁ = RingHom.ker χ ∧
      (∀ (ℓ : Nat.Primes) (hℓN : ¬ (ℓ : ℕ) ∣ N) (hℓS : (ℓ : ℕ) ∉ (∅ : Set ℕ)),
        χ (CuspForm.heckeAlgebra.T ℓ.2 hℓN hℓS) = φ ⟨ModularFormClass.qCoeff f ℓ, h𝒪 ℓ⟩) ∧
      (∀ (ℓ : Nat.Primes) (hℓN : (ℓ : ℕ) ∣ N) (hℓS : (ℓ : ℕ) ∉ (∅ : Set ℕ)),
        χ (CuspForm.heckeAlgebra.U ℓ.2 hℓN hℓS) = φ ⟨ModularFormClass.qCoeff f ℓ, h𝒪 ℓ⟩) := by sorry
