        ≤ C * (((V : ℝ) + 1) * ((Bb : ℝ) + 2) ^ 2) := mul_le_mul_of_nonneg_right this hV
      _ = ((Bb : ℝ) + 2) ^ 2 * ((V : ℝ) + 1) * C := by ring
