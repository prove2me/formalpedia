-- title:
--   Finite earlier count-increment atoms are measurable in the full past count history
-- statement:
--   A finite conjunction of count increment events at observation times not later than the clock is measurable in the pullback measurable space generated by the full past count path. No independence assumptions or random auxiliary process are needed.

import Mathlib
open MeasureTheory Set
noncomputable section

theorem AvramDividend.Classical.avram_a06_past_count_atom_history_comap_measurable
    {Ω : Type*} [MeasurableSpace Ω]
    (N : Ω → ℝ → ℕ) (clock : ℝ)
    (n : ℕ) (a b : Fin n → Set.Iic clock)
    (j : Fin n) (v : Fin n → ℕ) :
    MeasurableSet[
      MeasurableSpace.comap
        (fun ω : Ω => fun s : Set.Iic clock => N ω (s : ℝ))
        (inferInstance : MeasurableSpace (Set.Iic clock → ℕ))]
      {ω | ∀ i : Fin n, i < j →
        N ω (b i : ℝ) - N ω (a i : ℝ) = v i} := by sorry
