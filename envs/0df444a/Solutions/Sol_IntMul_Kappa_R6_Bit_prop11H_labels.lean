-- Source module: Solutions.R6BitProp11
/-!
# Round six, bit side: the generalized Proposition 11 (`prop11H`)

For a round-six bit network `C : QHNet R W T m` (general Bruhat frame changes, run children of
arbitrary widths `0 < r < m`, gates, zero temporaries) satisfying `C.OK (q ^ f)` at every field
size `q ^ f`, with child-width histogram `C.hist` of moment `Σ n_w (w/m)^τ < W`:

1. **denotation**: for every width `e` (any `e = m f + r`, leftover digits swapped singly), the
   program `progH C q e` interchanges the two runs of `e` radix-`q` digits of
   `P :: L :: hdShape A B Cs e q` whenever `W ^ depH m e ∣ L`;
2. **cost**: `costH C e V ≤ K V e^τ` for all `e` and `V ≥ 0`.
-/

namespace IntMul.Kappa.R6.Bit

open AModel

variable {R : Type*} [CommRing R] {W T m : ℕ} [NeZero W]

/-- **Generalized Prop. 11 from frame labels.** The hypotheses `C.OK (q ^ f)` replaced by the
checkable conditions of `R6BitLab`: valid runs, admissible Bruhat data and consistent labels
(ending in `swapMat`) at every field size `q ^ f`, and the scalar routing identity. -/
theorem prop11H_labels_sol_aux (C : QHNet R W T m) {q : ℕ} (hq : 1 ≤ q) (hm : 2 ≤ m)
    (hruns : C.RunsOK) (hE : ∀ f, C.EdgesOK (q ^ f)) (hlab : ∀ f, C.LabOK (q ^ f))
    (hsc : C.ScalarOK) {τ : ℝ} (hτ0 : 0 < τ) (hτ1 : τ ≤ 1)
    (hmom : histMoment C.hist m τ < W) :
    (∀ (e P L : ℕ) (A B Cs : Shape) (xs : List R), W ^ depH m e ∣ L →
      xs.length = vol (P :: L :: hdShape A B Cs e q) →
      progH C q e P L A B Cs xs =
        pull (P :: L :: hdShape A B Cs e q) (P :: L :: hdShape A B Cs e q)
          (blockSwap (A.length + 2) (A.length + B.length + e + 2) e) 0 xs) ∧
    ∃ K : ℝ, ∀ (e : ℕ) (V : ℝ), 0 ≤ V → costH C e V ≤ K * V * (e : ℝ) ^ τ :=
  prop11H C hq hm (fun f => have : NeZero (q ^ f) := ⟨by positivity⟩
    ⟨hruns, idealOK_of_labels C (hE f) (hlab f) hsc⟩) hτ0 hτ1 hmom

end IntMul.Kappa.R6.Bit

end

