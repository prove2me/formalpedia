theorem solution (k : Type) [Field k] [Finite k] (s : TypeDensity.State) (hs : s.Valid)
    (Dv : TypeDensity.ExceptionalDivisor k) (d : ℕ) (hd : 0 < d) (hdeg : TypeDensity.exceptionalDegree k Dv = d)
    (hQ : ∀ Q, 0 < Dv Q → TypeDensity.directionDegree k Q ≤ d) (hmult : ∀ Q, Dv Q ≤ d)
    (hcontact : TypeDensity.DivisorContactCondition k s Dv d) :
    ∃ P : TypeDensity.TangentPattern s.degree, P.d.val = d ∧ TypeDensity.Allowed s P ∧ TypeDensity.HasPattern k s Dv P := by
  have hdn : d ≤ s.degree := by
    revert hs hcontact
    cases s with
    | single a c =>
      rintro ⟨ha, -⟩ ⟨h1, -⟩
      change d ≤ a * c
      nlinarith
    | crossing a b c h =>
      rintro ⟨ha, -⟩ ⟨h1, -⟩
      change d ≤ a * c + b * h
      nlinarith
  have hid := TypeDensity.divisor_degree_pattern_weight k s Dv s.degree
      (fun Q hQ' => (hQ Q hQ').trans hdn) (fun Q => (hmult Q).trans hdn)
  have hcb := TypeDensity.card_le_of_weighted_sum_eq _ _ (fun _ ↦ by positivity) _ _ _ hid
  rw [hdeg] at hid hcb
  have hcb' : ∀ ij : Fin s.degree × Fin s.degree, Nat.card {Q : TypeDensity.ClosedDirection k //
      Q ∉ TypeDensity.boundaryDirections k s ∧ TypeDensity.directionDegree k Q = ij.1.val + 1 ∧ Dv Q = ij.2.val + 1}
      ≤ s.degree := fun ij => (hcb ij).trans hdn
  clear hcb
  revert hcontact hid hcb' hdn
  cases s with
  | single a c =>
    intro hcontact hdn hid hcb
    obtain ⟨h1, h2⟩ := hcontact
    refine ⟨⟨⟨d, by omega⟩,
      ⟨Dv (TypeDensity.infinityDirection k), by have := hmult (TypeDensity.infinityDirection k); omega⟩,
      ⟨0, by omega⟩, fun ij => ⟨_, hcb ij |> Nat.lt_succ_of_le⟩⟩, rfl, ?_, ?_⟩
    · refine ⟨hd, ?_, h1, rfl, h2⟩
      simp only [TypeDensity.patternWeight]
      simp only at hid
      omega
    · exact ⟨hdeg, rfl, trivial, fun ij => rfl⟩
  | crossing a b c h =>
    intro hcontact hdn hid hcb
    obtain ⟨h1, h2, h3, h4⟩ := hcontact
    refine ⟨⟨⟨d, by omega⟩,
      ⟨Dv (TypeDensity.infinityDirection k), by have := hmult (TypeDensity.infinityDirection k); omega⟩,
      ⟨Dv (TypeDensity.zeroDirection k), by have := hmult (TypeDensity.zeroDirection k); omega⟩,
      fun ij => ⟨_, hcb ij |> Nat.lt_succ_of_le⟩⟩, rfl, ?_, ?_⟩
    · refine ⟨hd, ?_, h1, h3, h2, h4⟩
      simp only [TypeDensity.patternWeight]
      simp only at hid
      omega
    · exact ⟨hdeg, rfl, rfl, fun ij => rfl⟩
