noncomputable def sigma (z : ℂ) : ℝ := (Real.sqrt (1-(eval rho z).re^2))⁻¹

noncomputable def momentBound (t : Term) (v : ℝ) : ℝ :=
  (t.moments.map (fun e => (e.2:ℝ)*v^e.1)).sum / (2:ℝ)^192

/-- Fourier–Gaussian bound after removing the singular determinant factor. -/
noncomputable def majorant (z : ℂ) : ℝ :=
  (terms.map (fun t => ‖eval t.polynomial z‖ * momentBound t (sigma z))).sum

/-- First-quadrant point with angular parameter $2\arctan(s^2)$. -/
noncomputable def point (r s : ℝ) : ℂ :=
  ⟨r*((1-s^4)/(1+s^4)),r*(2*s^2/(1+s^4))⟩

