variable {W : ℕ} {v : Vr} {c : Cs}

/-- `v d := expNeg a b e`. -/
theorem Rn.enR (hv : BV W v) {d n k j : Fin HS} (hd : d ∈ rg) (hn : n ∈ rg) (hk : k ∈ rg)
    (hj : j ∈ rg) {a b e : ℕ} (vn : v n = a) (vk : v k = b) (vj : v j = e) (ha : a ≤ W + 1)
    (hr : |expNeg a b e| ≤ 2 ^ W) :
    Rn (Ins.en d n k j).p v c (fun v' => v' = update v d (expNeg a b e) ∧ BV W v') c
      (Ins.cEn W) := by
  have h := Rn.ins1 (W := W) (N := 0) (c := c) (Nat.zero_le _) hv (.en d n k j)
    ⟨hd, hn, hk, hj, by rw [vn]; positivity, by rw [vk]; positivity, by rw [vj]; positivity,
      by rw [vn]; simpa using ha, by rw [vn, vk, vj]; simpa using hr⟩
  simp only [Ins.run, Ins.cost, vn, vk, vj, Int.toNat_natCast] at h
  exact h

end calls

/-! ## The push loop -/

/-- **A counted loop pushing `f 0, …, f (N-1)` onto `S`**, changing only the registers of `T`. -/
theorem Rn.pushFor {C rN ix S : Fin HS} (hC : C ∉ rg) (hC5 : C.val < 56) (hrN : rN ∈ rg)
    (hix : ix ∈ rg) (hixN : ix ≠ rN) {b : RS} (hw : C ∉ b.writes) (hSC : S ≠ C) {N W : ℕ}
    (hNW : N < 2 ^ W) {T : List (Fin HS)} (hixT : ix ∈ T) {v0 : Vr} {c0 : Cs}
    (hc0C : c0 C = []) (f : ℕ → ℤ) {cb : ℕ}
    (hb : ∀ k < N, ∀ v, (∀ j, j ∉ T → v j = v0 j) → v ix = (k : ℤ) → BV W v →
      Rn b v (update (update c0 S (PreT.rv f k ++ c0 S)) C [((N : ℤ) - k)])
        (fun v' => (∀ j, j ∉ T → v' j = v0 j) ∧ v' ix = k ∧ BV W v')
        (update (update c0 S (PreT.rv f (k + 1) ++ c0 S)) C [((N : ℤ) - k)]) cb)
    (hv0 : BV W v0) (hvr : v0 rN = N) :
    Rn (forL C rN ix b) v0 c0 (fun v' => (∀ j, j ∉ T → v' j = v0 j) ∧ BV W v')
      (update c0 S (PreT.rv f N ++ c0 S)) (cFor W N cb) := by
  have h := Rn.forL (C := C) (rN := rN) (ix := ix) hC hC5 hrN hix hixN hw (N := N) (W := W)
    (Iv := fun _ v => ∀ j, j ∉ T → v j = v0 j)
    (cf := fun k => update c0 S (PreT.rv f k ++ c0 S))
    (fun k => by rw [update_of_ne (Ne.symm hSC)]; exact hc0C) hNW
    (fun k hk v hI hx hB => (hb k hk v hI hx hB).mono (fun v' ⟨h1, h2, h3⟩ => ⟨fun j hj => by
        rw [update_of_ne (fun e => hj (by rw [e]; exact hixT))]; exact h1 j hj, h2, h3⟩) le_rfl)
    hv0 hvr (fun j hj => by rw [update_of_ne (fun e => hj (by rw [e]; exact hixT))])
  have e0 : update c0 S (PreT.rv f 0 ++ c0 S) = c0 := by
    rw [PreT.rv_zero, List.nil_append, update_eq_self]
  rw [e0] at h
  exact h.mono (fun v' ⟨h1, _, h3⟩ => ⟨h1, h3⟩) le_rfl

end J6Seg.ATab

