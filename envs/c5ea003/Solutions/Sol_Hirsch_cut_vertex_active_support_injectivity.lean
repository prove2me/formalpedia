namespace Hirsch.CutActiveSupport

/-- One positive radius controls any finite list of strict scalar margins. -/
lemma finite_margin {ι : Type*} (S : Finset ι) (a t : ι → ℝ)
    (ha : ∀ i ∈ S, 0 < a i) :
    ∃ e : ℝ, 0 < e ∧ ∀ i ∈ S, e * |t i| < a i := by
  classical
  revert ha
  induction S using Finset.induction_on with
  | empty =>
      intro ha
      exact ⟨1, by norm_num, by simp⟩
  | @insert i S hi ih =>
      intro ha
      obtain ⟨e, he, hS⟩ := ih (fun j hj => ha j (Finset.mem_insert_of_mem hj))
      have hai : 0 < a i := ha i (Finset.mem_insert_self i S)
      have hd : 0 < |t i| + 1 := by positivity
      let f : ℝ := a i / (|t i| + 1)
      have hf : 0 < f := div_pos hai hd
      have hfeq : f * (|t i| + 1) = a i := by
        dsimp [f]
        exact div_mul_cancel₀ _ (ne_of_gt hd)
      refine ⟨min e f, lt_min he hf, ?_⟩
      intro j hj
      rcases Finset.mem_insert.mp hj with hji | hj
      · subst j
        have hb := mul_le_mul_of_nonneg_right (min_le_right e f) (abs_nonneg (t i))
        nlinarith
      · exact lt_of_le_of_lt
          (mul_le_mul_of_nonneg_right (min_le_left e f) (abs_nonneg (t j))) (hS j hj)

/-- Actual extremality forces active cuts to detect every nonzero affine
motion generated by a strictly positive convex support. Inactive cuts retain
strict slack under the finite perturbation; they are not treated as equalities. -/
theorem active_kernel_trivial
    (n m d : ℕ) (P : Set (Fin d → ℝ)) (hP : Convex ℝ P)
    (v : Fin n → Fin d → ℝ) (hv : ∀ i, v i ∈ P)
    (w : Fin n → ℝ) (hw : ∀ i, 0 < w i) (hw1 : ∑ i, w i = 1)
    (C : Fin m → (Fin d → ℝ) →ₗ[ℝ] ℝ) (b : Fin m → ℝ)
    (hx : (∑ i, w i • v i) ∈
      (P ∩ {y | ∀ j, C j y ≤ b j}).extremePoints ℝ)
    (t : Fin n → ℝ) (ht : ∑ i, t i = 0)
    (hzero : ∀ j, C j (∑ i, w i • v i) = b j →
      C j (∑ i, t i • v i) = 0) :
    (∑ i, t i • v i) = 0 := by
  classical
  let x : Fin d → ℝ := ∑ i, w i • v i
  let z : Fin d → ℝ := ∑ i, t i • v i
  have hxC : ∀ j, C j x ≤ b j := hx.1.2
  obtain ⟨e₁, he₁, h₁⟩ := finite_margin Finset.univ w t (fun i _ => hw i)
  let I : Finset (Fin m) := Finset.univ.filter (fun j => C j x ≠ b j)
  have hslack : ∀ j ∈ I, 0 < b j - C j x := by
    intro j hj
    have hn : C j x ≠ b j := (Finset.mem_filter.mp hj).2
    exact sub_pos.mpr (lt_of_le_of_ne (hxC j) hn)
  obtain ⟨e₂, he₂, h₂⟩ := finite_margin I
    (fun j => b j - C j x) (fun j => C j z) hslack
  let e : ℝ := min e₁ e₂
  have he : 0 < e := lt_min he₁ he₂
  have hew : ∀ i, e * |t i| < w i := by
    intro i
    exact lt_of_le_of_lt
      (mul_le_mul_of_nonneg_right (min_le_left e₁ e₂) (abs_nonneg (t i)))
      (h₁ i (Finset.mem_univ i))
  have hweights : ∀ i, 0 < w i + e * t i ∧ 0 < w i - e * t i := by
    intro i
    have hh := hew i
    have hlow := mul_le_mul_of_nonneg_left (neg_abs_le (t i)) he.le
    have hhigh := mul_le_mul_of_nonneg_left (le_abs_self (t i)) he.le
    constructor <;> nlinarith
  have hsum_plus : (∑ i, (w i + e * t i)) = 1 := by
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, hw1, ht]
    ring
  have hsum_minus : (∑ i, (w i - e * t i)) = 1 := by
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum, hw1, ht]
    ring
  have hplus : (∑ i, (w i + e * t i) • v i) = x + e • z := by
    simp only [x, z, add_smul, mul_smul, Finset.sum_add_distrib, Finset.smul_sum]
  have hminus : (∑ i, (w i - e * t i) • v i) = x - e • z := by
    simp only [x, z, sub_smul, mul_smul, Finset.sum_sub_distrib, Finset.smul_sum]
  have hpP : x + e • z ∈ P := by
    rw [← hplus]
    exact hP.sum_mem (fun i _ => (hweights i).1.le) hsum_plus (fun i _ => hv i)
  have hmP : x - e • z ∈ P := by
    rw [← hminus]
    exact hP.sum_mem (fun i _ => (hweights i).2.le) hsum_minus (fun i _ => hv i)
  have hcuts : ∀ j, C j (x + e • z) ≤ b j ∧ C j (x - e • z) ≤ b j := by
    intro j
    by_cases hj : C j x = b j
    · have hz : C j z = 0 := hzero j hj
      simp only [map_add, map_sub, map_smul, hz, smul_zero, add_zero, sub_zero]
      exact ⟨hxC j, hxC j⟩
    · have hjI : j ∈ I := Finset.mem_filter.mpr ⟨Finset.mem_univ j, hj⟩
      have hb : e * |C j z| < b j - C j x := lt_of_le_of_lt
        (mul_le_mul_of_nonneg_right (min_le_right e₁ e₂) (abs_nonneg (C j z)))
        (h₂ j hjI)
      have hlow := mul_le_mul_of_nonneg_left (neg_abs_le (C j z)) he.le
      have hhigh := mul_le_mul_of_nonneg_left (le_abs_self (C j z)) he.le
      simp only [map_add, map_sub, map_smul, smul_eq_mul]
      constructor <;> nlinarith
  have hmid : x ∈ openSegment ℝ (x + e • z) (x - e • z) := by
    refine ⟨(1 / 2 : ℝ), (1 / 2 : ℝ), by norm_num, by norm_num, by norm_num, ?_⟩
    module
  have heq : x + e • z = x :=
    hx.2 ⟨hpP, fun j => (hcuts j).1⟩ ⟨hmP, fun j => (hcuts j).2⟩ hmid
  change z = 0
  funext j
  have hj := congrFun heq j
  change x j + e * z j = x j at hj
  have hprod : e * z j = 0 := by linarith
  exact (mul_eq_zero.mp hprod).resolve_left (ne_of_gt he)

/-- Explicit sum/projection identities; the pinned simplifier does not push
product projections through finite sums automatically. -/
lemma sum_fst {ι E F : Type*} [AddCommMonoid E] [AddCommMonoid F]
    (S : Finset ι) (f : ι → E × F) :
    (∑ i ∈ S, f i).1 = ∑ i ∈ S, (f i).1 := by
  classical
  induction S using Finset.induction_on with
  | empty => rfl
  | @insert i S hi ih =>
      simp only [Finset.sum_insert hi]
      exact congrArg (fun z => (f i).1 + z) ih

lemma sum_snd {ι E F : Type*} [AddCommMonoid E] [AddCommMonoid F]
    (S : Finset ι) (f : ι → E × F) :
    (∑ i ∈ S, f i).2 = ∑ i ∈ S, (f i).2 := by
  classical
  induction S using Finset.induction_on with
  | empty => rfl
  | @insert i S hi ih =>
      simp only [Finset.sum_insert hi]
      exact congrArg (fun z => (f i).2 + z) ih

/-- The active cut images of an affinely independent positive support are
again affinely independent, and hence its cardinality is at most active cuts+1.
Affine independence is expressed by the standard homogenized vectors (1,v). -/
theorem active_image_independent
    (n m d : ℕ) (P : Set (Fin d → ℝ)) (hP : Convex ℝ P)
    (v : Fin n → Fin d → ℝ) (hv : ∀ i, v i ∈ P)
    (w : Fin n → ℝ) (hw : ∀ i, 0 < w i) (hw1 : ∑ i, w i = 1)
    (C : Fin m → (Fin d → ℝ) →ₗ[ℝ] ℝ) (b : Fin m → ℝ)
    (hx : (∑ i, w i • v i) ∈
      (P ∩ {y | ∀ j, C j y ≤ b j}).extremePoints ℝ)
    (hvind : LinearIndependent ℝ (fun i => ((1 : ℝ), v i))) :
    let A := {j : Fin m // C j (∑ i, w i • v i) = b j}
    LinearIndependent ℝ (fun i => ((1 : ℝ), fun j : A => C j.val (v i))) ∧
      n ≤ Nat.card A + 1 := by
  classical
  let A := {j : Fin m // C j (∑ i, w i • v i) = b j}
  let image : Fin n → ℝ × (A → ℝ) := fun i => (1, fun j => C j.val (v i))
  have hind : LinearIndependent ℝ image := by
    apply Fintype.linearIndependent_iff.mpr
    intro t ht
    have hmass : (∑ i, t i) = 0 := by
      have hh := congrArg Prod.fst ht
      simpa [image, sum_fst] using hh
    have hcuts : ∀ j, C j (∑ i, w i • v i) = b j → C j (∑ i, t i • v i) = 0 := by
      intro j hj
      have hh := congrArg (fun p : ℝ × (A → ℝ) => p.2 ⟨j, hj⟩) ht
      simpa [image, sum_snd, Finset.sum_apply, map_sum, map_smul, smul_eq_mul] using hh
    have hz := active_kernel_trivial n m d P hP v hv w hw hw1 C b hx t hmass hcuts
    have haug : (∑ i, t i • ((1 : ℝ), v i)) = 0 := by
      apply Prod.ext
      · simpa [sum_fst] using hmass
      · simpa [sum_snd] using hz
    exact Fintype.linearIndependent_iff.mp hvind t haug
  refine ⟨hind, ?_⟩
  have hcard := hind.fintype_card_le_finrank
  simpa only [Fintype.card_fin, Module.finrank_prod, Module.finrank_self,
    Module.finrank_pi, Nat.card_eq_fintype_card, Nat.add_comm] using hcard

end Hirsch.CutActiveSupport

/-- An extreme point of an actually cut convex set has no nonzero affine
support motion invisible to its active cuts; independent positive supports
remain independent under active cut evaluation, with the sharp count bound. -/
theorem solution
    (n m d : ℕ) (P : Set (Fin d → ℝ)) (hP : Convex ℝ P)
    (v : Fin n → Fin d → ℝ) (hv : ∀ i, v i ∈ P)
    (w : Fin n → ℝ) (hw : ∀ i, 0 < w i) (hw1 : ∑ i, w i = 1)
    (C : Fin m → (Fin d → ℝ) →ₗ[ℝ] ℝ) (b : Fin m → ℝ)
    (hx : (∑ i, w i • v i) ∈
      (P ∩ {y | ∀ j, C j y ≤ b j}).extremePoints ℝ) :
    (∀ t : Fin n → ℝ, (∑ i, t i) = 0 →
      (∀ j, C j (∑ i, w i • v i) = b j → C j (∑ i, t i • v i) = 0) →
      (∑ i, t i • v i) = 0) ∧
    (LinearIndependent ℝ (fun i => ((1 : ℝ), v i)) →
      let A := {j : Fin m // C j (∑ i, w i • v i) = b j}
      LinearIndependent ℝ (fun i => ((1 : ℝ), fun j : A => C j.val (v i))) ∧
        n ≤ Nat.card A + 1) := by
  exact ⟨Hirsch.CutActiveSupport.active_kernel_trivial n m d P hP v hv w hw hw1 C b hx,
    Hirsch.CutActiveSupport.active_image_independent n m d P hP v hv w hw hw1 C b hx⟩

#print axioms Hirsch.CutActiveSupport.finite_margin
#print axioms Hirsch.CutActiveSupport.active_kernel_trivial
#print axioms Hirsch.CutActiveSupport.active_image_independent
#print axioms solution
