section
-- Source module: Solutions.J6SegILPreJK30
/-!
# B5 `J` side, part K30: the numeric side conditions `JB` from the table bounds

With every table entry `≤ X = 2^(Q+R+2)` (`TabB` at `Q + R + 2`, and `expNeg_le` for the
couplings), `JB Q R W s t α λ w` holds as soon as `2^Q + λ(2w+1)·λX⁸ ≤ 2^W` and
`α²(tw + s)² ≤ 2^W` (`JB_of`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL Function Finset

theorem eKz_toNat_le {s t w : ℕ} (hs : 0 < s) (l h : ℤ) (hh : |h| ≤ w) :
    (HvdH.eKz s t l h).toNat ≤ (t * w + s) ^ 2 := by
  have hb := IntMul.HvdH.EPf.bOf_bounds s t hs l
  have hb' : |HvdH.bOf s t l| ≤ s := by rw [abs_le]; constructor <;> omega
  have h1 : HvdH.eKz s t l h ≤ ((t : ℤ) * h + HvdH.bOf s t l) ^ 2 := by
    unfold HvdH.eKz; nlinarith [sq_nonneg (HvdH.bOf s t (l + h))]
  have h2 : |(t : ℤ) * h + HvdH.bOf s t l| ≤ (t : ℤ) * w + s := by
    refine (abs_add_le _ _).trans (add_le_add ?_ hb')
    rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℤ) ≤ t)]
    exact mul_le_mul_of_nonneg_left hh (by positivity)
  have h3 : ((t : ℤ) * h + HvdH.bOf s t l) ^ 2 ≤ ((t : ℤ) * w + s) ^ 2 := by
    rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h2 2
  have h4 : HvdH.eKz s t l h ≤ (((t * w + s) ^ 2 : ℕ) : ℤ) := by push_cast; linarith
  exact (Int.toNat_le_toNat h4).trans (by simp)

theorem jw_abs {w j : ℕ} (hj : j < 2 * w + 1) : |(j : ℤ) - w| ≤ w := by
  rw [abs_le]; constructor <;> omega

section jb
variable {Q R W s t α lam w : ℕ}

/-- **The `J` side conditions from the table bounds.** -/
theorem JB_of_sol_aux (TB : PreT.TabB Q R s t α lam (Q + R + 2)) (hs : 0 < s) (hl : 1 ≤ lam)
    (hws : w ≤ s)
    (hV : (2 : ℤ) ^ Q + ((lam * (2 * w + 1) : ℕ) : ℤ) *
      ((2 : ℤ) ^ (Q + R + 2) * 2 ^ (Q + R + 2) * (2 ^ (Q + R + 2) * 2 ^ (Q + R + 2) *
        ((lam : ℤ) * (2 ^ (Q + R + 2)) ^ 3)) * 2 ^ (Q + R + 2)) ≤ 2 ^ W)
    (hEK : α ^ 2 * (t * w + s) ^ 2 ≤ 2 ^ W) :
    JB Q R W s t α lam w := by
  set X : ℤ := 2 ^ (Q + R + 2) with hX
  set T := mkTables Q R s t α with hT
  set B := mkBlocks s t lam w with hB
  have hX1 : 1 ≤ X := one_le_pow₀ (by norm_num)
  have hX0 : 0 ≤ X := by omega
  have hl1 : (1 : ℤ) ≤ lam := by exact_mod_cast hl
  have hw0 : (0 : ℤ) ≤ w := by positivity
  set Y : ℤ := X * X * (X * X * ((lam : ℤ) * X ^ 3)) * X with hY
  have hY_eq : Y = (lam : ℤ) * X ^ 8 := by rw [hY]; ring
  have hXp : ∀ a b : ℕ, a ≤ b → X ^ a ≤ X ^ b := fun a b h => pow_le_pow_right₀ hX1 h
  have hlX : ∀ k : ℕ, k ≤ 8 → (lam : ℤ) * X ^ k ≤ Y := fun k hk => by
    rw [hY_eq]; exact mul_le_mul_of_nonneg_left (hXp k 8 hk) (by positivity)
  have hQ0 : (0 : ℤ) ≤ 2 ^ Q := by positivity
  have hK1 : (1 : ℤ) ≤ ((lam * (2 * w + 1) : ℕ) : ℤ) := by
    have : 1 ≤ lam * (2 * w + 1) := Nat.one_le_iff_ne_zero.mpr (by positivity)
    exact_mod_cast this
  have hY0 : 0 ≤ Y := by rw [hY_eq]; positivity
  have hYW : Y ≤ 2 ^ W := by nlinarith
  have hXW : X ≤ 2 ^ W := by
    have := hlX 1 (by norm_num)
    have : X ≤ (lam : ℤ) * X ^ 1 := by rw [pow_one]; nlinarith
    linarith
  have hcpl : ∀ i h, |T.cpl i h| ≤ X := fun i h =>
    TabBnd.expNeg_le (P := Q) (R := R) (s := s ^ 2) (by positivity) _
  have TX : TabX T lam X := ⟨TB.ap, TB.am, TB.gam, TB.gi, TB.dd, TB.di, hcpl, hX1⟩
  have hBo := mkBlocks_ok (t := t) (lam := lam) hs w hws
  rw [← hB] at hBo
  have hEKX : ∀ (l : ℤ) (j : ℕ), j < 2 * w + 1 → α ^ 2 * (HvdH.eKz s t l ((j : ℤ) - w)).toNat ≤
      2 ^ W := fun l j hj =>
    (Nat.mul_le_mul_left _ (eKz_toNat_le hs l _ (jw_abs hj))).trans hEK
  refine ⟨⟨fun k hk => (TabBnd.expNeg_le (P := Q) (R := R) hs _).trans hXW,
      fun k hk => (TB.gam k hk).trans hXW⟩,
    fun i hi => (TB.gam i hi.le).trans hXW, fun i hi => (TB.gi i hi).trans hXW,
    fun i hi => (TB.dd i hi).trans hXW, fun i hi => (TB.di i hi).trans hXW, ?_, ?_⟩
  · intro a ha
    have hn : B.len a ≤ lam := mkBlocks_len hl w a
    have hn' : (mkBlocks s t lam w).len a ≤ lam := hn
    have hc := hBo.cover a ha
    have ho : a - B.st a < B.len a := by omega
    refine ⟨fun k hk => (TB.ap _ k (by omega)).trans hXW, fun k hk => (TB.am _ k (by omega)).trans hXW,
      fun k hk => (TabBnd.expNeg_le (P := Q) (R := R) hs _).trans hXW,
      fun k hk => (TabBnd.expNeg_le (P := Q) (R := R) hs _).trans hXW, ?_, ?_, ?_,
      fun u hu j hj => hEKX _ j hj, fun u hu j hj => (hcpl _ _).trans hXW, ?_, ?_⟩
    · intro uu huu K hK
      refine ((tsS_abs TX (hK.trans hn)).trans ?_).trans hYW
      exact hlX 3 (by norm_num)
    · intro uu huu
      refine (tsY_abs TX (lt_of_lt_of_le (tU_lt ho huu) hn) (lt_of_lt_of_le (tV_lt ho huu) hn) hn
        |>.trans ?_).trans hYW
      have := hlX 5 (by norm_num)
      have e : X * X * ((lam : ℤ) * X ^ 3) = (lam : ℤ) * X ^ 5 := by ring
      rw [e]; exact this
    · intro uu huu
      refine (miV_abs TX hn ho huu |>.trans ?_).trans hYW
      have := hlX 7 (by norm_num)
      have e : X * X * (X * X * ((lam : ℤ) * X ^ 3)) = (lam : ℤ) * X ^ 7 := by ring
      rw [e]; exact this
    · intro y hy
      exact (gV_abs TX hn ho hy).trans hYW
    · intro b K hK
      refine (colS_abs TX hn ho hK).trans ?_
      have hK' : ((K : ℕ) : ℤ) ≤ ((lam * (2 * w + 1) : ℕ) : ℤ) := by
        have : K ≤ lam * (2 * w + 1) := hK.trans (Nat.mul_le_mul_right _ hn)
        exact_mod_cast this
      have : (K : ℤ) * Y ≤ ((lam * (2 * w + 1) : ℕ) : ℤ) * Y := mul_le_mul_of_nonneg_right hK' hY0
      linarith
  · intro r hr
    refine ⟨fun j hj => hEKX _ j hj, fun j hj => (hcpl _ _).trans hXW, fun b J hJ => ?_⟩
    refine (ccS_abs TX).trans ?_
    have hJ' : (J : ℤ) ≤ 2 * w + 1 := by exact_mod_cast hJ
    have h1 : (J : ℤ) * X ≤ (2 * w + 1) * X := mul_le_mul_of_nonneg_right hJ' hX0
    have h2 : (2 * (w : ℤ) + 1) * X ≤ ((lam * (2 * w + 1) : ℕ) : ℤ) * Y := by
      push_cast
      have := hlX 1 (by norm_num)
      rw [pow_one] at this
      have hXY : X ≤ Y := le_trans (le_mul_of_one_le_left hX0 hl1) this
      have hw1 : (0 : ℤ) ≤ 2 * w + 1 := by positivity
      have k1 : (2 * (w : ℤ) + 1) * X ≤ (2 * w + 1) * Y := mul_le_mul_of_nonneg_left hXY hw1
      nlinarith [mul_nonneg (mul_nonneg (sub_nonneg.2 hl1) hw1) hY0]
    linarith

end jb

end J6Seg.PJ

end

theorem solution : type_of% @J6Seg.PJ.JB_of_sol_aux := @J6Seg.PJ.JB_of_sol_aux
