section
-- Source module: Solutions.KFZMain
/-!
# KFZ Main: `P18IL → ChirpNeedR`

The chirp procedure `body` (`KFZFull`) is kmain's own procedure `0` in the merged table
`mExt ext₁₈ ∅ ∅ [body]`; the Prop 18 procedure is reached through `gI` (`mTable_g1`,
`IRuns.relabel`). The descriptor stack is `cS = 36` (the chirp descriptor stays there and is
restored by `setupP`).

Per call, `M̃r = mrtCall t F G H` with `F = Q(b̃ θ̃)`, `G = Q(θ̃ Q(ã x))` and `H` the Prop 18 result
at exactly these operands; `rec_out` gives `‖H − mrX F G‖ ≤ ErC hp`.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

/-- The merged extension list: Prop 18, nothing, nothing, the chirp body. -/
def extZ {E18 : ℕ} (ext18 : Fin E18 → IStmt HS (7 + E18)) (entry18 : Fin (7 + E18))
    (d18 : Fin HS) : Fin (E18 + 0 + 0 + 1) → IStmt HS (7 + (E18 + 0 + 0 + 1)) :=
  mExt ext18 (Fin.elim0 : Fin 0 → IStmt HS (7 + 0)) (Fin.elim0 : Fin 0 → IStmt HS (7 + 0))
    (fun _ => body (NLogN.KFM.gI E18 (E18 + 0 + 0 + 1) 0 (by omega) entry18) d18)

end

end NLogN.KFZ

