variable {v : HeightOneSpectrum (𝓞 ℚ)} (W : LocalGL3 v → ℂ)

private def torusValue (m : ℤ) : ℂ :=
  if 0 ≤ m then W (iotaTorusLocal v m.toNat) else 0

private theorem torusValue_of_neg {m : ℤ} (hm : m < 0) : torusValue W m = 0 :=
  if_neg (not_le.mpr hm)

private theorem torusValue_of_nonneg {m : ℤ} (hm : 0 ≤ m) : torusValue W m = W (iotaTorusLocal v m.toNat) :=
  if_pos hm

private theorem torusValue_natCast (n : ℕ) : torusValue W n = W (iotaTorusLocal v n) := by
  rw [torusValue_of_nonneg W (by omega)]
  rfl

private theorem torusValue_zero (hone : ∀ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, W k = 1) : torusValue W 0 = 1 := by
  rw [torusValue_of_nonneg W le_rfl, Int.toNat_zero, iotaTorusLocal_zero]
  exact hone 1 (one_mem _)

variable {W} {ψv : AddChar (v.adicCompletion ℚ) ℂ}

private theorem apply_iotaGL_diagUnitGL2_mul_eq_torusValue (hwhit : IsGL3PsiWhittakerFn ψv W)
    (hinv : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) W)
    (hlevel : ∀ (t : (v.adicCompletion ℚ)ˣ) (m : ℤ), m < 0 →
      Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-m) →
        ∃ y : v.adicCompletion ℚ, Valued.v (((t⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) * y) ≤ 1 ∧
          ψv y ≠ 1)
    {t : (v.adicCompletion ℚ)ˣ} {n : ℤ} (ht : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n))
    {k : LocalGL3 v} (hk : k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    W (iotaGL (diagUnitGL2 t) * k) = torusValue W n := by
  by_cases hn : 0 ≤ n
  · rw [torusValue_of_nonneg W hn]
    have hval : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-(n.toNat : ℤ)) := by
      rw [Int.toNat_of_nonneg hn]
      exact ht
    obtain ⟨k', hk', hk''⟩ := exists_mem_localMaximalCompact3_and_eq_iotaTorusLocal_mul v hval
    rw [hk'', mul_assoc]
    exact hinv _ _ (mul_mem hk' hk)
  · rw [torusValue_of_neg W (not_le.mp hn)]
    obtain ⟨y, hy, hψ⟩ := hlevel t n (not_le.mp hn) ht
    exact apply_iotaGL_diagUnitGL2_mul_eq_zero hwhit hinv t hy hψ hk

private theorem apply_iotaGL_diagUnitGL2_eq_torusValue (hwhit : IsGL3PsiWhittakerFn ψv W)
    (hinv : IsRightInvariant (localMaximalCompact3 (𝓞 ℚ) ℚ v) W)
    (hlevel : ∀ (t : (v.adicCompletion ℚ)ˣ) (m : ℤ), m < 0 →
      Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-m) →
        ∃ y : v.adicCompletion ℚ, Valued.v (((t⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) * y) ≤ 1 ∧
          ψv y ≠ 1)
    {t : (v.adicCompletion ℚ)ˣ} {n : ℤ} (ht : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n)) :
    W (iotaGL (diagUnitGL2 t)) = torusValue W n := by
  rw [← mul_one (iotaGL (diagUnitGL2 t))]
  exact apply_iotaGL_diagUnitGL2_mul_eq_torusValue hwhit hinv hlevel ht (one_mem _)

end
