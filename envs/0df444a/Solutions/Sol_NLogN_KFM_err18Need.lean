  have hA : KFV.procQc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ ((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xf) = (procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ fR).map C.co := by
    rw [KFV.co_procQ C p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long)) (paperSel D ℓ K long hK hℓ) ℓ fR, hfm]
