/-! ## Natural expressions -/

lemma npow_val (x : NE) (v : Fin HS → ℕ) : ∀ k, (npow x k).val v = x.val v ^ k
  | 0 => by simp [npow, NE.val]
  | k + 1 => by simp [npow, NE.val, npow_val x v k, pow_succ]

lemma npow_regs (x : NE) : ∀ k, ∀ r ∈ (npow x k).regs, r ∈ x.regs
  | 0 => by simp [npow, NE.regs]
  | k + 1 => by
    intro r hr
    simp only [npow, NE.regs, List.mem_append] at hr
    rcases hr with h | h
    · exact npow_regs x k r h
    · exact h

lemma npow_OK {x : NE} {v : Fin HS → ℕ} {M : ℕ} (hx : x.OK v M) (h1 : 1 ≤ x.val v) (hM : 1 ≤ M) :
    ∀ k, x.val v ^ k ≤ M → (npow x k).OK v M
  | 0, _ => by simp [npow, NE.OK]; exact hM
  | k + 1, hk => by
    refine ⟨npow_OK hx h1 hM k (le_trans (Nat.pow_le_pow_right h1 (Nat.le_succ k)) hk), hx, ?_⟩
    rw [npow_val, ← pow_succ]; exact hk

/-- A push list of natural expressions: `PushOK` and its values. -/
theorem pushOK_NE {t : IState HS} {v : Fin HS → ℕ} {M Bb : ℕ} (hM : zsz (M : ℤ) ≤ Bb)
    (l : List (Fin HS × NE))
    (h : ∀ p ∈ l, p.1.val < 56 ∧ p.2.RegsLt ∧ (∀ r ∈ p.2.regs, r ∉ l.map Prod.fst) ∧
      NE.Holds t v p.2 ∧ p.2.OK v M) :
    PushOK t Bb (l.map fun p => (p.1, p.2.toEx)) ∧
      evalP t (l.map fun p => (p.1, p.2.toEx)) = l.map fun p => (p.1, ((p.2.val v : ℕ) : ℤ)) := by
  refine ⟨fun p hp => ?_, ?_⟩
  · simp only [List.mem_map] at hp
    obtain ⟨p', hp', rfl⟩ := hp
    obtain ⟨h1, h2, h3, h4, h5⟩ := h p' hp'
    obtain ⟨o, b, -⟩ := NE.good hM p'.2 h4 h5
    refine ⟨h1, NE.clean h2, fun r hr hm => ?_, o, b⟩
    rw [NE.regs_toEx] at hr
    apply h3 r hr
    simpa [List.map_map] using hm
  · simp only [evalP, List.map_map]
    refine List.map_congr_left fun p hp => ?_
    obtain ⟨-, -, -, h4, h5⟩ := h p hp
    simp only [Function.comp_apply, (NE.good hM p.2 h4 h5).2.2]

