      + algebraMap K (RatFunc K) a * v.uniformizer ^ k)⁻¹
      = (∑ t ∈ Finset.range q,
          (-(algebraMap K (RatFunc K) a * v.uniformizer ^ k)) ^ t)
        + (-(algebraMap K (RatFunc K) a * v.uniformizer ^ k)) ^ q
          * ((1 : RatFunc K)
              + algebraMap K (RatFunc K) a * v.uniformizer ^ k)⁻¹ := by
