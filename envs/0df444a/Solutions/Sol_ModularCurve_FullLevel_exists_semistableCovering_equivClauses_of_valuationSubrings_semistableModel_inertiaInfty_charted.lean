  (σ : F ≃ₐ[L] F)

include hint in
private theorem _root_.AlgebraicCurve.ComponentChart.mem_comapRP_integers_iff (f : F) : f ∈ (C.comapRP σ).integers ↔ σ f ∈ R.integers := by
