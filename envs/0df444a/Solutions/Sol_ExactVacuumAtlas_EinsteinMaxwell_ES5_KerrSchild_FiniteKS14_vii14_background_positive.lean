set_option autoImplicit false
variable {I : Set ℝ} {f m N w p a F b A : ℝ → ℝ} {s h ε Q J : ℝ}
theorem solution (hP : PaperData I f m N w p a) (hN : FactorizedN I N s h)
    (hB : PaperBVP I f m N w p a Q J) (hS : FiniteBranch6 I s ε f m a F b A)
    (hJ : J ≠ 0) (hQ : Q ≠ 0) {T : ℝ}
    {gb gbi : Metric 5} {v : Pt 5 → ℝ} {K : Pt 5 → Fin 5 → ℝ}
    (hD : KSData gb gbi v K (esDomain I ∩ {x : Pt 5 | T < x 1}))
    (hrep : ∀ i j, Set.EqOn (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w i j)
      (ksMetric gb v K i j) (esDomain I ∩ {x : Pt 5 | T < x 1}))
    (hne : ∀ x ∈ esDomain I ∩ {x : Pt 5 | T < x 1}, K x ≠ 0)
    (hgeo : ∀ x ∈ esDomain I ∩ {x : Pt 5 | T < x 1}, PregeodesicAt gb gbi K x) :
    BackgroundPositiveOutput I f m N w p a T gb gbi K := by
  have hpt := finite_far_positive_point hP hN hB hS hJ hQ hD hrep hne hgeo
  refine ⟨hpt, fun B => ?_⟩
  obtain ⟨x0, hx0, hB0, hpos0, -⟩ := hpt B
  have hW : IsOpen ((esDomain I ∩ {x : Pt 5 | T < x 1}) ∩ {x : Pt 5 | B < x 1}) :=
    (isOpen_tail hP.isOpen T).inter (isOpen_lt continuous_const (continuous_apply 1))
  have hc := (continuousOn_background_contract hD).mono
    (Set.inter_subset_left : (esDomain I ∩ {x : Pt 5 | T < x 1}) ∩ {x : Pt 5 | B < x 1} ⊆ _)
  exact ⟨_, hc.isOpen_inter_preimage hW isOpen_Ioi, ⟨x0, ⟨hx0, hB0⟩, hpos0⟩,
    Set.inter_subset_left, fun x hx => hx.2⟩
