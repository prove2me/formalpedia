    ell = 625643953 / 3750000000 ∧
    lx = 2661585647 / 7500000000 ∧
    ly = 3587126447 / 7500000000 ∧
    h = 2029900753 / 2500000000 := by
  norm_num [ell, Geometry.ell, lx, ly, h, lxAt, lyAt, hAt, p, b]

