              (.goto (fun _ => 5))))
          (.goto (fun _ => 2)))
    else if phase = (2 : Fin 6) then
      .peek 2 (fun _ symbol => symbol)
        (.branch (fun symbol => symbol.isSome)
          (.pop 2 (fun _ _ => none) (.goto (fun _ => 2)))
