open IntMul IntMul.Kappa IntMul.Kappa.R6 IntMul.Kappa.R6.IL2C
open Finset
variable {K ρ n L : ℕ}

theorem IntMul.Kappa.R6.IL2C.slot_add (hK : 1 ≤ K) (hL : ρ + n * K ≤ L) {y : ℕ} (hy : y < 2 ^ L) (δ : ℕ → ℤ)
    (h : ∀ s < n, 0 ≤ (IntMul.Kappa.R6.IL2C.seg K ρ s y : ℤ) + δ s ∧ (IntMul.Kappa.R6.IL2C.seg K ρ s y : ℤ) + δ s < 2 ^ K) :
    ∃ y' : ℕ, (y' : ℤ) = y + ∑ s ∈ range n, δ s * ((2 : ℤ) ^ ρ * (2 ^ K) ^ s) ∧ y' < 2 ^ L ∧
      y' % 2 ^ ρ = y % 2 ^ ρ ∧ (∀ s < n, (IntMul.Kappa.R6.IL2C.seg K ρ s y' : ℤ) = IntMul.Kappa.R6.IL2C.seg K ρ s y + δ s) ∧
      y' / 2 ^ ρ / (2 ^ K) ^ n = y / 2 ^ ρ / (2 ^ K) ^ n := by sorry
