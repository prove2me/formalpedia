-- title:
--   §2.1, pp. 6–9 — model data μ, σ, π, k, r, I; end filters of I; generator 𝒜 of (2); q of (3); the rate class 𝒰
-- statement:
--   The deterministic data of Kwon's game of variable contributions, for the symmetric game of §2.4. A **model** consists of
--
--   1. a drift $\mu:\mathbb R\to\mathbb R$ and a volatility $\sigma:\mathbb R\to\mathbb R$ of the stock of common good;
--   2. the flow profit $\pi:\mathbb R\to\mathbb R$ of each player and the cost $k$ of one unit of contribution;
--   3. the common discount rate $r$;
--   4. the state interval $I=(a,b)$, $-\infty\le a<b\le\infty$;
--   5. a base point $x_0$ for the scale density (the paper writes $0$).
--
--   The **ends of $I$**: "$x\to a$" is the filter generated by the sets $\{x\in I: x<c\}$, $c\in I$, and "$x\to b$" the filter generated by $\{x\in I: x>c\}$, $c\in I$; both work for finite and infinite ends.
--
--   The **$r$-excessive characteristic operator** (2) and the function $q$ of (3) are
--   $$\mathcal A f(x)=\tfrac12\sigma(x)^2 f''(x)+\mu(x)f'(x)-r f(x),\qquad q(x)=\pi(x)+\mathcal A(kx)=\pi(x)+[\mu(x)-rx]\,k .$$
--
--   The **rate class $\mathcal U$** (p. 13, stationary form) consists of the functions $v$ that are Lipschitz continuous on $I$ and satisfy $|v(x)|\le\delta(1+|x|)$ on $I$ for some constant $\delta$.
--
--   These are the analytic objects in terms of which the single decision maker's value (4), the equilibrium rate (6) and Assumption 3 are stated.
--
--   **Formalization Note.** Derivatives are `deriv`; they are used only at points of the open set $I$ for functions assumed $C^2$ on $I$. The paper's class $\mathcal U$ consists of time-dependent rates on $(0,\infty)\times I$; Theorem 2 applies it to a rate depending on the state only, which is the form defined here.
-- source:
--   Kwon, Game of Variable Contributions to the Common Good under Uncertainty, arXiv:1904.00500v1, pp. 6–9 and 13, §2.1, (2), (3), Assumption 3, class 𝒰

import Mathlib

open Filter Set
open scoped NNReal Topology

namespace VarContrib.RegularMPE

/-- The deterministic data of the variable contribution game (Kwon, §2.1, pp. 6–8), for the
symmetric game of §2.4 (`π_i = π_j = π`, `k_i = k_j = k`):
* `μ` the drift and `σ` the volatility of the stock of common good;
* `π` the flow profit of each player and `k` the cost of one unit of contribution;
* `r` the common discount rate;
* `I` the interval `(a, b)`, `−∞ ≤ a < b ≤ ∞`, in which the stock lives;
* `x₀` the base point of the scale density `exp(∫_{x₀}^x 2μ/σ²)` of Assumption 3(iii)
  (printed `0`; any point of `I`). -/
structure Model where
  /-- the drift `μ(·)` -/
  μ : ℝ → ℝ
  /-- the volatility `σ(·)` -/
  σ : ℝ → ℝ
  /-- the flow profit `π(·)` -/
  π : ℝ → ℝ
  /-- the unit cost `k` of contribution -/
  k : ℝ
  /-- the discount rate `r` -/
  r : ℝ
  /-- the state interval `I = (a, b)` -/
  I : Set ℝ
  /-- the base point of the scale density -/
  x₀ : ℝ

/-- "`x → a`": the filter of points of `I` approaching its lower end `a = inf I` (possibly
`−∞`), generated by the sets `{x ∈ I | x < c}`, `c ∈ I`. -/
def lowerEnd (I : Set ℝ) : Filter ℝ := ⨅ c ∈ I, 𝓟 {x | x ∈ I ∧ x < c}

/-- "`x → b`": the filter of points of `I` approaching its upper end `b = sup I` (possibly
`+∞`), generated by the sets `{x ∈ I | c < x}`, `c ∈ I`. -/
def upperEnd (I : Set ℝ) : Filter ℝ := ⨅ c ∈ I, 𝓟 {x | x ∈ I ∧ c < x}

/-- The `r`-excessive characteristic operator (2):
`𝒜f(x) = ½σ(x)² f″(x) + μ(x) f′(x) − r f(x)`. -/
noncomputable def gen (m : Model) (f : ℝ → ℝ) (x : ℝ) : ℝ :=
  (1 / 2) * m.σ x ^ 2 * deriv (deriv f) x + m.μ x * deriv f x - m.r * f x

/-- The function `q(x) = π(x) + 𝒜(kx) = π(x) + [μ(x) − r x] k` of (3). -/
def q (m : Model) (x : ℝ) : ℝ := m.π x + (m.μ x - m.r * x) * m.k

/-- The stationary control-rate class `𝒰` (p. 13, for rates not depending on time): `v` is
Lipschitz continuous on `I` and has linear growth `|v(x)| ≤ δ(1 + |x|)` on `I`. -/
def InU (m : Model) (v : ℝ → ℝ) : Prop :=
  (∃ L : ℝ≥0, LipschitzOnWith L v m.I) ∧ ∃ δ : ℝ, ∀ x ∈ m.I, |v x| ≤ δ * (1 + |x|)

end VarContrib.RegularMPE


