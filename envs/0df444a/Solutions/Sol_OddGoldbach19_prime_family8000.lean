theorem Qlist_bounds : ∀ p∈Qlist, p≠2 ∧ p≤81817 := by decide +kernel
theorem Qlist_nodup : Qlist.Nodup := by
  have hh : List.IsChain (·<·) Qlist := by decide +kernel
  exact (List.sortedLT_iff_isChain.mpr hh).nodup
def Qs : Finset ℕ :=⟨(Qlist:Multiset ℕ),Multiset.coe_nodup.mpr Qlist_nodup⟩
theorem Qs_prop (p : ℕ) (hp : p∈Qs) : p.Prime ∧ p≠2 ∧ p≤81817 := by
  have h : p∈Qlist := Multiset.mem_coe.mp (Finset.mem_def.mp hp)
  exact ⟨Qlist_prime p h,Qlist_bounds p h⟩
theorem Qs_card : Qs.card=8000 := by decide +kernel
