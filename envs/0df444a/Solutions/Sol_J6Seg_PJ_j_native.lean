theorem jBody_poly {Q R s t lam w α kJ k' G Xb Bc : ℕ} {v : List ℤ}
    (hD : JK.PartD Q k' w G Xb Bc (JK.jFs Q R s t lam w α) (JK.jBs Q R s t lam w α)
      (JK.jCc Q R s t lam w α w) v) :
