      e.hom ≫ c₂ = Mdl.toBase →
      ∃ (V : ValuationSubring ↥K)
        (_ : ∀ a : A, algebraMap A ↥K a ∈ V)
        (_ : ∀ a ∈ IsLocalRing.maximalIdeal A, algebraMap A ↥K a ∈ V.nonunits)
        (_ : ∀ P : Polynomial A, P.map (IsLocalRing.residue A) ≠ 0 →
