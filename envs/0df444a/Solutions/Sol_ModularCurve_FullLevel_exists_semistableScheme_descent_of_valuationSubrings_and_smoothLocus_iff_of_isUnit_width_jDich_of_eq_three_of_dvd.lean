        apply hx
        apply PrimeSpectrum.ext
        show (toBase.base x).asIdeal = maximalIdeal ↥A
        refine ((IsLocalRing.maximalIdeal.isMaximal ↥A).eq_of_le (toBase.base x).isPrime.ne_top ?_).symm
