-- title:
--   Eq. (4.5) — $\langle y^{k-1} - y^\star, \mathcal F(X^k) - \mathcal F(X^\star)\rangle \le -\|X^k - X^\star\|_F^2$
-- statement:
--   Let $\tau>0$, let $f_1,\dots,f_m$ be convex functions on $\mathbb R^{n_1\times n_2}$ with $\mathcal F = (f_1,\dots,f_m)$, let $(X^k, y^k)$ be generated by iteration (3.5) from $y^0 = 0$ with arbitrary step sizes $\delta_k$, and let $(X^\star, y^\star)$ be a primal-dual optimal pair for (3.4). Then for every $k\ge 1$,
--   $$\langle y^{k-1} - y^\star, \mathcal F(X^k) - \mathcal F(X^\star)\rangle \le -\|X^k - X^\star\|_F^2 .$$
--
--   This is the outer inequality of (4.5): the dual error is correlated with the constraint values in a way that forces descent of the dual distance in (4.6).
--
--   **Formalization Note** The paper's step $k$ is the Lean index `k + 1`. The middle term of (4.5), $-\langle Z^k - Z^\star, X^k - X^\star\rangle$, involves the subgradients of (4.4) and is not part of the statement.
-- source:
--   Cai, Candès, Shen, A Singular Value Thresholding Algorithm for Matrix Completion, SIAM J. Optim. 20 (2010), p. 1969, proof of Theorem 4.4, Eq. (4.5)

import Mathlib
import Definitions.Def_CaiCandesShen_GeneralConvex_Problem

namespace CaiCandesShen.GeneralConvex

/-- Eq. (4.5), proof of Theorem 4.4, p. 1969 (outer inequality): along a run of (3.5) and for a
primal-dual optimal pair `(X⋆, y⋆)` of (3.4), for every `k ≥ 1`,
`⟨y^{k−1} - y⋆, 𝓕(X^k) - 𝓕(X⋆)⟩ ≤ -‖X^k - X⋆‖_F²`. Paper index `k` is `k + 1` here. -/
theorem dual_gap_bound {n₁ n₂ m : ℕ} (τ : ℝ) (hτ : 0 < τ)
    (f : Fin m → Mat n₁ n₂ → ℝ) (hconv : ∀ i, ConvexOn ℝ Set.univ (f i))
    (δ : ℕ → ℝ) (X : ℕ → Mat n₁ n₂) (y : ℕ → Fin m → ℝ) (hseq : IsGeneralSVTSeq τ f δ X y)
    (Xs : Mat n₁ n₂) (ys : Fin m → ℝ) (hopt : IsPrimalDualOptimal τ f Xs ys) :
    ∀ k : ℕ, dot (y k - ys) (constraintMap f (X (k + 1)) - constraintMap f Xs) ≤
      -(frobNorm (X (k + 1) - Xs) ^ 2) := by sorry

end CaiCandesShen.GeneralConvex
