variable {C : Type} [Field C] {κ κ' : Type}

theorem GlobalTheory.OddBlock.ExpShift.slice_pderiv (b : κ' →₀ ℕ) (g : MvPowerSeries (κ ⊕ κ') C) (j : κ') :
    slice b (MvPowerSeries.pderiv C (Sum.inr j) g) = ((b j : C) + 1) • slice (b + Finsupp.single j 1) g := by sorry
