theorem exists_fg_tbc
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (hΛ : IsMaximalOrder Λ) [NeZero N] (hm : 3 ≤ m)
    (S₀ : Type) [CommRing S₀] (hN : IsUnit ((N : ℕ) : S₀)) (hm' : IsUnit ((m : ℕ) : S₀)) (hℓ : IsUnit ((ℓ : ℕ) : S₀))
    (v : FakeEllipticCurve.WithFullLevel Λ N m S₀) (Cv : v.1.ExtraLevel ℓ) :
    ∃ (R : Subalgebra ℤ S₀) (_ : R.FG) (vR : FakeEllipticCurve.WithFullLevel Λ N m ↥R) (CvR : vR.1.ExtraLevel ℓ)
      (g : v.1.A ⟶ vR.1.A), TBC R.val.toRingHom vR CvR v Cv g := by
  classical
  let ι' : Type := {R : Subalgebra ℤ S₀ // R.FG}
  letI : Preorder ι' := Subtype.preorder _
  haveI : Nonempty ι' := ⟨⟨⊥, Subalgebra.fg_bot⟩⟩
  haveI : IsDirected ι' (· ≤ ·) := ⟨fun R R' => ⟨⟨R.1 ⊔ R'.1, R.2.sup R'.2⟩, (le_sup_left : R.1 ≤ R.1 ⊔ R'.1), (le_sup_right : R'.1 ≤ R.1 ⊔ R'.1)⟩⟩
  obtain ⟨R, vR, CvR, g, h1, h2, h3⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_isPullbackVia_extraLevel_of_directed_colimit_of_isUnit
      hqq' hB Λ hΛ N m hm ℓ ι' (fun R => ↥R.1) (fun R R' h => (Subalgebra.inclusion h).toRingHom)
      (fun R h => RingHom.ext fun x => rfl) (fun R R' R'' h h' => RingHom.ext fun x => rfl)
      S₀ (fun R => R.1.val.toRingHom) (fun R R' h => RingHom.ext fun x => rfl)
      (fun x => ⟨⟨Algebra.adjoin ℤ (({x} : Finset S₀) : Set S₀), Subalgebra.fg_adjoin_finset _⟩,
        ⟨x, Algebra.subset_adjoin (by simp)⟩, rfl⟩)
      (fun R y z hyz => ⟨R, le_rfl, by rw [Subtype.ext hyz]⟩) hN hm' hℓ v Cv
  exact ⟨R.1, R.2, vR, CvR, g, h1, h2, fun t' P hP => h3 t' P hP⟩

theorem main_at
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (hΛ : IsMaximalOrder Λ) [NeZero N] (hm : 3 ≤ m)
    (ι : Type) [Preorder ι] [Nonempty ι] [IsDirected ι (· ≤ ·)]
    (S : ι → Type) [∀ i, CommRing (S i)]
    (t : ∀ i j, i ≤ j → (S i →+* S j))
    (ht₁ : ∀ i (h : i ≤ i), t i i h = RingHom.id (S i))
    (ht₂ : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k), (t j k hjk).comp (t i j hij) = t i k (hij.trans hjk))
    (L : Type) [CommRing L] (c : ∀ i, S i →+* L)
    (hc : ∀ i j (h : i ≤ j), (c j).comp (t i j h) = c i)
    (hcsurj : ∀ x : L, ∃ (i : ι) (y : S i), c i y = x)
    (hcker : ∀ (i : ι) (y z : S i), c i y = c i z → ∃ (j : ι) (h : i ≤ j), t i j h y = t i j h z)
    (i : ι) (hNi : IsUnit ((N : ℕ) : S i)) (hmi : IsUnit ((m : ℕ) : S i)) (hℓi : IsUnit ((ℓ : ℕ) : S i))
    (v w : FakeEllipticCurve.WithFullLevel Λ N m (S i)) (Cv : v.1.ExtraLevel ℓ) (Cw : w.1.ExtraLevel ℓ)
    (v' w' : FakeEllipticCurve.WithFullLevel Λ N m L) (Cv' : v'.1.ExtraLevel ℓ) (Cw' : w'.1.ExtraLevel ℓ)
    (gv : v'.1.A ⟶ v.1.A) (gw : w'.1.A ⟶ w.1.A)
    (hv : TBC (c i) v Cv v' Cv' gv) (hw : TBC (c i) w Cw w' Cw' gw) (hiso : IsoT v' w' Cv' Cw') :
    ∃ (k : ι) (hik : i ≤ k) (vk wk : FakeEllipticCurve.WithFullLevel Λ N m (S k)) (Cvk : vk.1.ExtraLevel ℓ) (Cwk : wk.1.ExtraLevel ℓ)
      (gvk : vk.1.A ⟶ v.1.A) (gwk : wk.1.A ⟶ w.1.A),
      TBC (t i k hik) v Cv vk Cvk gvk ∧ TBC (t i k hik) w Cw wk Cwk gwk ∧ IsoT vk wk Cvk Cwk := by
  classical

  obtain ⟨Rv, hRvfg, vRv, CvRv, gRv, hvRv⟩ := exists_fg_tbc hqq' hB hΛ hm (S i) hNi hmi hℓi v Cv
  obtain ⟨Rw, hRwfg, wRw, CwRw, gRw, hwRw⟩ := exists_fg_tbc hqq' hB hΛ hm (S i) hNi hmi hℓi w Cw
  set R : Subalgebra ℤ (S i) := Rv ⊔ Rw with hRdef
  have hRfg : R.FG := hRvfg.sup hRwfg
  haveI hFT : Algebra.FiniteType ℤ ↥R := ⟨(Subalgebra.fg_top R).2 hRfg⟩
  haveI hFT' : @Algebra.FiniteType ℤ ↥R _ _ (Ring.toIntAlgebra ↥R) := by
    convert hFT using 1
    all_goals try exact Subsingleton.elim _ _
  haveI : IsNoetherianRing ↥R := Algebra.FiniteType.isNoetherianRing ℤ ↥R
  let inv : ↥Rv →+* ↥R := (Subalgebra.inclusion (le_sup_left : Rv ≤ R)).toRingHom
  let inw : ↥Rw →+* ↥R := (Subalgebra.inclusion (le_sup_right : Rw ≤ R)).toRingHom
  have hinv : R.val.toRingHom.comp inv = Rv.val.toRingHom := RingHom.ext (fun x => rfl)
  have hinw : R.val.toRingHom.comp inw = Rw.val.toRingHom := RingHom.ext (fun x => rfl)
  obtain ⟨vR, CvR, g₁v, hg₁v⟩ := exists_tbci inv vRv CvRv
  obtain ⟨wR, CwR, g₁w, hg₁w⟩ := exists_tbci inw wRw CwRw
  obtain ⟨gRv', hvR⟩ := exists_tbc_cancel inv R.val.toRingHom vRv vR v CvRv CvR Cv g₁v gRv hg₁v.1 (hinv.symm ▸ hvRv)
  obtain ⟨gRw', hwR⟩ := exists_tbc_cancel inw R.val.toRingHom wRw wR w CwRw CwR Cw g₁w gRw hg₁w.1 (hinw.symm ▸ hwRw)

  letI : Algebra ↥R L := ((c i).comp R.val.toRingHom).toAlgebra
  have halg : algebraMap ↥R L = (c i).comp R.val.toRingHom := rfl
  have hv'R : TBC (algebraMap ↥R L) vR CvR v' Cv' (gv ≫ gRv') := halg ▸ tbc_comp _ _ _ _ _ _ _ _ _ _ hvR hv
  have hw'R : TBC (algebraMap ↥R L) wR CwR w' Cw' (gw ≫ gRw') := halg ▸ tbc_comp _ _ _ _ _ _ _ _ _ _ hwR hw
  obtain ⟨T, hTfg, -, hT⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_fg_subalgebra_forall_isoTVia_of_isoTVia_of_isPullbackVia
      hΛ vR wR CvR CwR v' w' Cv' Cw' (gv ≫ gRv') (gw ≫ gRw') hv'R.1 hv'R.2.1 (fun t' P hP => hv'R.2.2 t' P hP)
      hw'R.1 hw'R.2.1 (fun t' P hP => hw'R.2.2 t' P hP) hiso ∅

  have hT'fg : (T.restrictScalars ℤ).FG := by
    have h1 : (⊤ : Subalgebra ℤ ↥R).FG := (Subalgebra.fg_top R).2 hRfg
    have h2 : (⊤ : Subalgebra ↥R ↥T).FG := (Subalgebra.fg_top T).2 hTfg
    have h3 : (⊤ : Subalgebra ℤ ↥T).FG := Algebra.fg_trans' h1 h2
    have h4 : T.restrictScalars ℤ = (⊤ : Subalgebra ℤ ↥T).map (T.val.restrictScalars ℤ) := by
      ext x
      rw [Subalgebra.mem_restrictScalars, Subalgebra.mem_map]
      constructor
      · intro hx; exact ⟨⟨x, hx⟩, Algebra.mem_top, rfl⟩
      · rintro ⟨y, -, rfl⟩; exact y.2
    rw [h4]; exact h3.map _
  obtain ⟨hBr, -⟩ := Subalgebra.exists_ringHom_comp_eq_val_of_fg_of_directedSystem ι S t ht₁ ht₂ L c hc hcsurj hcker
    (T.restrictScalars ℤ) hT'fg
  obtain ⟨j, hij, ψ', hψ'⟩ := hBr i
  let eT : ↥T →+* ↥(T.restrictScalars ℤ) :=
    { toFun := fun x => ⟨x.1, x.2⟩, map_one' := rfl, map_mul' := fun _ _ => rfl, map_zero' := rfl, map_add' := fun _ _ => rfl }
  let ψ : ↥T →+* S j := ψ'.comp eT
  have hψ : (c j).comp ψ = T.val.toRingHom := by
    ext x
    have := congrArg (fun f : ↥(T.restrictScalars ℤ) →+* L => f (eT x)) hψ'
    exact this
  let ρ : ↥R →+* ↥T := algebraMap ↥R ↥T
  have hρ : T.val.toRingHom.comp ρ = (c i).comp R.val.toRingHom := RingHom.ext (fun x => rfl)
  have hagree : (c j).comp (ψ.comp ρ) = (c j).comp ((t i j hij).comp R.val.toRingHom) := by
    rw [← RingHom.comp_assoc, hψ, hρ, ← RingHom.comp_assoc, hc i j hij]
  obtain ⟨k, hjk, hpin⟩ :=
    RingHom.exists_comp_eq_comp_of_finiteType_of_directedSystem ι S t ht₁ ht₂ L c hc hcsurj hcker ↥R j
      (ψ.comp ρ) ((t i j hij).comp R.val.toRingHom) hagree

  set χ : ↥R →+* S k := (t j k hjk).comp (ψ.comp ρ) with hχdef
  have hχ' : χ = (t i k (hij.trans hjk)).comp R.val.toRingHom := by
    rw [hpin, ← RingHom.comp_assoc, ht₂ i j k hij hjk]
  obtain ⟨vk, Cvk, gvk, hvk⟩ := exists_tbci χ vR CvR
  obtain ⟨wk, Cwk, gwk, hwk⟩ := exists_tbci χ wR CwR
  have hisok : IsoT vk wk Cvk Cwk :=
    hT (S k) ((t j k hjk).comp ψ) χ (by rw [hχdef, RingHom.comp_assoc]) vk wk Cvk Cwk gvk gwk
      hvk.1.1 hvk.1.2.1 (fun t' P hP => hvk.1.2.2 t' P hP) hwk.1.1 hwk.1.2.1 (fun t' P hP => hwk.1.2.2 t' P hP)
  obtain ⟨gvk', hvk'⟩ := exists_tbc_cancel R.val.toRingHom (t i k (hij.trans hjk)) vR v vk CvR Cv Cvk gRv' gvk hvR (hχ' ▸ hvk.1)
  obtain ⟨gwk', hwk'⟩ := exists_tbc_cancel R.val.toRingHom (t i k (hij.trans hjk)) wR w wk CwR Cw Cwk gRw' gwk hwR (hχ' ▸ hwk.1)
  exact ⟨k, hij.trans hjk, vk, wk, Cvk, Cwk, gvk', gwk', hvk', hwk', hisok⟩

end IsoTDescent

