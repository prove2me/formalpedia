section

variable {v}

private theorem shellTerm_eq_zero_of_not_mem_range (W : LocalGL3 v → ℂ) (u : ℂˣ) (s : ℂ) (m : ℤ)
    (hm : m ∉ Set.range ((↑) : ℕ → ℤ)) :
    torusValue W m * ((u ^ m : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ m : ℝ)) : ℂ) ^ (s - 1) = 0 := by
  by_cases h : m < 0
  · rw [torusValue_of_neg W h, zero_mul, zero_mul]
  · exact (hm ⟨m.toNat, Int.toNat_of_nonneg (not_lt.mp h)⟩).elim

private theorem tsum_shellTerm_eq_tsum_nat (W : LocalGL3 v → ℂ) (u : ℂˣ) (s : ℂ) :
    ∑' n : ℤ, torusValue W n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1) =
      ∑' n : ℕ, torusValue W n * ((u ^ (n : ℤ) : ℂˣ) : ℂ) *
        (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ (n : ℤ) : ℝ)) : ℂ) ^ (s - 1) :=
  (Nat.cast_injective.tsum_eq
    (Function.support_subset_iff'.mpr (shellTerm_eq_zero_of_not_mem_range W u s))).symm

private theorem ofReal_pow_cpow (r : ℝ) (hr : 0 ≤ r) (n : ℕ) (w : ℂ) :
    ((r ^ n : ℝ) : ℂ) ^ w = (((r : ℝ) : ℂ) ^ w) ^ n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, Complex.ofReal_mul, Complex.mul_cpow_ofReal_nonneg (pow_nonneg hr n) hr, ih, pow_succ]

private def seriesVariable (u : ℂˣ) (s : ℂ) : ℂ :=
  (cNormQ v)⁻¹ * (u : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ : ℝ)) : ℂ) ^ (s - 1)

private theorem seriesVariable_eq (u : ℂˣ) (s : ℂ) : seriesVariable (v := v) u s = (u : ℂ) * cNormQ v ^ (-s) := by
  have hN : ((Ideal.absNorm v.asIdeal : ℕ) : ℂ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Ideal.absNorm_eq_zero_iff.not.mpr v.ne_bot)
  have hs : (-s : ℂ) = -1 + -(s - 1) := by ring
  unfold seriesVariable cNormQ
  rw [Complex.ofReal_inv, Complex.ofReal_natCast,
    Complex.inv_cpow _ _ (by rw [Complex.natCast_arg]; exact Real.pi_ne_zero.symm), ← Complex.cpow_neg, hs,
    Complex.cpow_add _ _ hN, Complex.cpow_neg_one]
  ring

private theorem seriesVariable_eq_absNorm (u : ℂˣ) (s : ℂ) :
    seriesVariable (v := v) u s = (u : ℂ) * (Ideal.absNorm v.asIdeal : ℂ) ^ (-s) :=
  seriesVariable_eq u s

private theorem term_eq_zero_of_not_mem_range (τ : ℤ → ℂ) (hneg : ∀ m : ℤ, m < 0 → τ m = 0) (u : ℂˣ) (s : ℂ)
    (m : ℤ) (hm : m ∉ Set.range ((↑) : ℕ → ℤ)) :
    τ m * ((u ^ m : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ m : ℝ)) : ℂ) ^ (s - 1) = 0 := by
  by_cases h : m < 0
  · rw [hneg m h, zero_mul, zero_mul]
  · exact (hm ⟨m.toNat, Int.toNat_of_nonneg (not_lt.mp h)⟩).elim

private theorem tsum_eq_tsum_nat_of_forall_neg_eq_zero (τ : ℤ → ℂ) (hneg : ∀ m : ℤ, m < 0 → τ m = 0) (u : ℂˣ)
    (s : ℂ) :
    ∑' n : ℤ, τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1) =
      ∑' n : ℕ, τ n * ((u ^ (n : ℤ) : ℂˣ) : ℂ) *
        (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ (n : ℤ) : ℝ)) : ℂ) ^ (s - 1) :=
  (Nat.cast_injective.tsum_eq
    (Function.support_subset_iff'.mpr (term_eq_zero_of_not_mem_range τ hneg u s))).symm

private theorem term_natCast_eq (τ : ℤ → ℂ) (h : ℕ → ℂ) (hτ : ∀ n : ℕ, τ n = (cNormQ v)⁻¹ ^ n * h n) (u : ℂˣ)
    (s : ℂ) (n : ℕ) :
    τ n * ((u ^ (n : ℤ) : ℂˣ) : ℂ) *
        (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ (n : ℤ) : ℝ)) : ℂ) ^ (s - 1) =
      h n * seriesVariable (v := v) u s ^ n := by
  rw [hτ n]
  simp only [zpow_natCast, Units.val_pow_eq_pow_val]
  rw [ofReal_pow_cpow _ (inv_nonneg.mpr (Nat.cast_nonneg _)) n (s - 1)]
  unfold seriesVariable
  ring

private theorem tsum_eq_tsum_nat_mul_seriesVariable_pow (τ : ℤ → ℂ) (hneg : ∀ m : ℤ, m < 0 → τ m = 0) (h : ℕ → ℂ)
    (hτ : ∀ n : ℕ, τ n = (cNormQ v)⁻¹ ^ n * h n) (u : ℂˣ) (s : ℂ) :
    ∑' n : ℤ, τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1) =
      ∑' n : ℕ, h n * seriesVariable (v := v) u s ^ n := by
  rw [tsum_eq_tsum_nat_of_forall_neg_eq_zero τ hneg u s, tsum_congr fun n => term_natCast_eq τ h hτ u s n]

private theorem summable_nat_mul_seriesVariable_pow (τ : ℤ → ℂ) (hneg : ∀ m : ℤ, m < 0 → τ m = 0) (h : ℕ → ℂ)
    (hτ : ∀ n : ℕ, τ n = (cNormQ v)⁻¹ ^ n * h n) (u : ℂˣ) (s : ℂ)
    (hsum : Summable fun n : ℤ =>
      τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1)) :
    Summable fun n : ℕ => h n * seriesVariable (v := v) u s ^ n :=
  ((Nat.cast_injective.summable_iff (term_eq_zero_of_not_mem_range τ hneg u s)).mpr hsum).congr fun n =>
    term_natCast_eq τ h hτ u s n

variable {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

omit [NumberField K] in

private theorem shellTerm_natCast_eq {c : HeightOneSpectrum (𝓞 K) → ℂ} {W : LocalGL3 v → ℂ}
    (hsph : HasSphericalTorusValuesAt c v W) (u : ℂˣ) (s : ℂ) (n : ℕ) :
    torusValue W n * ((u ^ (n : ℤ) : ℂˣ) : ℂ) *
        (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ (n : ℤ) : ℝ)) : ℂ) ^ (s - 1) =
      sphericalTorusValue (inducedE1 ℚ c v) (inducedE2 ℚ c v) (inducedE3 ℚ c v) n *
        seriesVariable (v := v) u s ^ n := by
  rw [torusValue_natCast W n, hsph.1 n]
  simp only [zpow_natCast, Units.val_pow_eq_pow_val]
  rw [ofReal_pow_cpow _ (inv_nonneg.mpr (Nat.cast_nonneg _)) n (s - 1)]
  unfold seriesVariable
  ring

private theorem tsum_shellTerm_eq_inv_eval_inducedEulerPoly (hdeg : Module.finrank ℚ K ≤ 3)
    {c : HeightOneSpectrum (𝓞 K) → ℂ} {W : LocalGL3 v → ℂ} (hsph : HasSphericalTorusValuesAt c v W) (u : ℂˣ) (s : ℂ)
    (hsum : Summable fun n : ℤ =>
      torusValue W n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1)) :
    ∑' n : ℤ, torusValue W n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1) =
      ((inducedEulerPoly ℚ c v).eval (seriesVariable (v := v) u s))⁻¹ := by
  have hnat : Summable fun n : ℕ =>
      sphericalTorusValue (inducedE1 ℚ c v) (inducedE2 ℚ c v) (inducedE3 ℚ c v) n * seriesVariable (v := v) u s ^ n :=
    ((Nat.cast_injective.summable_iff (shellTerm_eq_zero_of_not_mem_range W u s)).mpr hsum).congr fun n =>
      shellTerm_natCast_eq hsph u s n
  rw [tsum_shellTerm_eq_tsum_nat, tsum_congr fun n => shellTerm_natCast_eq hsph u s n]
  exact tsum_mul_pow_eq_inv_eval_inducedEulerPoly hdeg c v (seriesVariable u s) hnat

private theorem tsum_eq_inv_eval_inducedEulerPoly_of_forall_natCast_eq (hdeg : Module.finrank ℚ K ≤ 3)
    {c : HeightOneSpectrum (𝓞 K) → ℂ} (τ : ℤ → ℂ) (hneg : ∀ m : ℤ, m < 0 → τ m = 0)
    (hτ : ∀ n : ℕ, τ n =
      (cNormQ v)⁻¹ ^ n * sphericalTorusValue (inducedE1 ℚ c v) (inducedE2 ℚ c v) (inducedE3 ℚ c v) n)
    (u : ℂˣ) (s : ℂ)
    (hsum : Summable fun n : ℤ =>
      τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1)) :
    ∑' n : ℤ, τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1) =
      ((inducedEulerPoly ℚ c v).eval (seriesVariable (v := v) u s))⁻¹ := by
  rw [tsum_eq_tsum_nat_mul_seriesVariable_pow τ hneg _ hτ u s]
  exact tsum_mul_pow_eq_inv_eval_inducedEulerPoly hdeg c v (seriesVariable u s)
    (summable_nat_mul_seriesVariable_pow τ hneg _ hτ u s hsum)

private theorem localZeta30_one_eq_inv_eval_inducedEulerPoly (hdeg : Module.finrank ℚ K ≤ 3)
    {mT : MeasurableSpace (v.adicCompletion ℚ)ˣ} (μ : Measure (v.adicCompletion ℚ)ˣ)
    (hmeas : ∀ n : ℤ, MeasurableSet (shell v n)) (hμ : ∀ n : ℤ, μ (shell v n) = 1)
    {c : HeightOneSpectrum (𝓞 K) → ℂ} (W : LocalGL3 v → ℂ) (hsph : HasSphericalTorusValuesAt c v W)
    (hW : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) →
      W (iotaGL (diagUnitGL2 t)) = torusValue W n)
    (χv : (v.adicCompletion ℚ)ˣ →* ℂˣ) (u : ℂˣ)
    (hχ : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) → χv t = u ^ n)
    (hmod : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) →
      (TateLocal.modulus (t : v.adicCompletion ℚ) : ℝ) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n)
    (s : ℂ)
    (hint : Integrable (fun a : (v.adicCompletion ℚ)ˣ =>
      W (iotaGL (diagUnitGL2 a) * 1) * ((χv a : ℂˣ) : ℂ) *
        ((TateLocal.modulus (a : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1)) μ) :
    localZeta30 v μ W χv s 1 = ((inducedEulerPoly ℚ c v).eval (seriesVariable (v := v) u s))⁻¹ := by
  have hsum := summable_shellTerm v μ hmeas hμ (fun a => W (iotaGL (diagUnitGL2 a) * 1)) (torusValue W)
    (fun t n ht => by simp only [mul_one]; exact hW t n ht) χv u hχ hmod s hint
  have hnat : Summable fun n : ℕ =>
      sphericalTorusValue (inducedE1 ℚ c v) (inducedE2 ℚ c v) (inducedE3 ℚ c v) n * seriesVariable (v := v) u s ^ n :=
    ((Nat.cast_injective.summable_iff (shellTerm_eq_zero_of_not_mem_range W u s)).mpr hsum).congr fun n =>
      shellTerm_natCast_eq hsph u s n
  rw [localZeta30_one_eq_tsum v μ hmeas hμ W (torusValue W) hW χv u hχ hmod s hint, tsum_shellTerm_eq_tsum_nat,
    tsum_congr fun n => shellTerm_natCast_eq hsph u s n]
  exact tsum_mul_pow_eq_inv_eval_inducedEulerPoly hdeg c v (seriesVariable u s) hnat

end
