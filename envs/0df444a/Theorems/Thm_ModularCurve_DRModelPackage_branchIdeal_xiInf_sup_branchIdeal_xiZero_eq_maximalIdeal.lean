open CategoryTheory CategoryTheory.Limits AlgebraicGeometry ModularCurve ModularCurve.DRModelPackage

theorem ModularCurve.DRModelPackage.branchIdeal_xiInf_sup_branchIdeal_xiZero_eq_maximalIdeal
    (p : ℕ) [Fact p.Prime] (hp : 5 ≤ p) (𝔛 : DRModelPackage p)
    (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (hϖ : IsLocalRing.maximalIdeal O = Ideal.span {((p : ℕ) : O)})
    (κ : Type) [Field κ] [CharP κ p] [IsAlgClosed κ] (toκ : O →+* κ)
    (n : ↥(pullback (𝔛.compInf κ) (𝔛.compZero κ)))
    (hinf : 𝔛.ξinf O κ toκ ⤳ 𝔛.crossingPt O κ toκ n) (hzero : 𝔛.ξzero O κ toκ ⤳ 𝔛.crossingPt O κ toκ n) :
    Scheme.branchIdeal hinf ⊔ Scheme.branchIdeal hzero =
      IsLocalRing.maximalIdeal ((baseChangeO p O).presheaf.stalk (𝔛.crossingPt O κ toκ n)) := by sorry
