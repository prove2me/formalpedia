      by_contra hh
      have h := hn.2 0 (Nat.pos_of_ne_zero hh)
      rw [hx] at h
      simp only [Nat.cast_zero,add_zero,lt_self_iff_false] at h
    subst n
    rw [recordIndexPosition,recordIndexTime_zero]
