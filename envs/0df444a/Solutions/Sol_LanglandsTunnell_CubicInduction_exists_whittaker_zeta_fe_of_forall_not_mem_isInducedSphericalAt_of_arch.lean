open IsDedekindDomain NumberField AutomorphicForm

universe u v

section

variable {F : Type u} [CommRing F] {R : Type v} [CommRing R]

private def leftTranslate (τ : GL (Fin 3) F) : (GL (Fin 3) F → R) →ₗ[R] (GL (Fin 3) F → R) where
  toFun f k := f (τ * k)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

@[scoped simp] private theorem leftTranslate_apply (τ : GL (Fin 3) F) (f : GL (Fin 3) F → R) (k : GL (Fin 3) F) :
    leftTranslate (R := R) τ f k = f (τ * k) := rfl

private theorem leftTranslate_gl3AmbientRightTranslate (τ h : GL (Fin 3) F) (f : GL (Fin 3) F → R) :
    leftTranslate (R := R) τ (gl3AmbientRightTranslate (R := R) h f) =
      gl3AmbientRightTranslate (R := R) h (leftTranslate (R := R) τ f) := by
  funext k
  simp only [leftTranslate_apply, gl3AmbientRightTranslate_apply, mul_assoc]

private def leftTranslateEquiv (τ : GL (Fin 3) F) : (GL (Fin 3) F → R) ≃ₗ[R] (GL (Fin 3) F → R) :=
  { leftTranslate (R := R) τ with
    invFun := leftTranslate (R := R) τ⁻¹
    left_inv := fun f => by
      funext k
      simp only [LinearMap.toFun_eq_coe, leftTranslate_apply, mul_inv_cancel_left]
    right_inv := fun f => by
      funext k
      simp only [LinearMap.toFun_eq_coe, leftTranslate_apply, inv_mul_cancel_left] }

@[scoped simp] private theorem leftTranslateEquiv_apply (τ : GL (Fin 3) F) (f : GL (Fin 3) F → R) :
    leftTranslateEquiv (R := R) τ f = leftTranslate (R := R) τ f := rfl

private theorem map_gl3CyclicSubspace (τ : GL (Fin 3) F) (W : GL (Fin 3) F → R) :
    (gl3CyclicSubspace W).map ((leftTranslateEquiv (R := R) τ : (GL (Fin 3) F → R) ≃ₗ[R] _) :
        (GL (Fin 3) F → R) →ₗ[R] (GL (Fin 3) F → R)) =
      gl3CyclicSubspace (leftTranslate (R := R) τ W) := by
  unfold gl3CyclicSubspace
  rw [Submodule.map_span]
  congr 1
  ext f
  constructor
  · rintro ⟨_, ⟨h, rfl⟩, rfl⟩
    exact ⟨h, (leftTranslate_gl3AmbientRightTranslate τ h W).symm⟩
  · rintro ⟨h, rfl⟩
    exact ⟨_, ⟨h, rfl⟩, leftTranslate_gl3AmbientRightTranslate τ h W⟩

private def cyclicEquiv (τ : GL (Fin 3) F) (W : GL (Fin 3) F → R) :
    gl3CyclicSubspace W ≃ₗ[R] gl3CyclicSubspace (leftTranslate (R := R) τ W) :=
  ((leftTranslateEquiv (R := R) τ).submoduleMap (gl3CyclicSubspace W)).trans
    (LinearEquiv.ofEq _ _ (map_gl3CyclicSubspace τ W))

@[scoped simp] private theorem coe_cyclicEquiv (τ : GL (Fin 3) F) (W : GL (Fin 3) F → R) (f : gl3CyclicSubspace W) :
    ((cyclicEquiv (R := R) τ W f : gl3CyclicSubspace (leftTranslate (R := R) τ W)) :
        GL (Fin 3) F → R) = leftTranslate (R := R) τ f := by
  simp only [cyclicEquiv, LinearEquiv.trans_apply, LinearEquiv.coe_ofEq_apply, LinearEquiv.submoduleMap_apply,
    leftTranslateEquiv_apply]

private theorem cyclicEquiv_gl3CyclicRep (τ : GL (Fin 3) F) (W : GL (Fin 3) F → R) (h : GL (Fin 3) F)
    (f : gl3CyclicSubspace W) :
    cyclicEquiv (R := R) τ W (gl3CyclicRep W h f) =
      gl3CyclicRep (leftTranslate (R := R) τ W) h (cyclicEquiv (R := R) τ W f) := by
  apply Subtype.ext
  rw [coe_cyclicEquiv]
  show leftTranslate (R := R) τ (gl3AmbientRightTranslate (R := R) h f) =
    gl3AmbientRightTranslate (R := R) h (cyclicEquiv (R := R) τ W f : GL (Fin 3) F → R)
  rw [coe_cyclicEquiv, leftTranslate_gl3AmbientRightTranslate]

private def pullbackFunctional (τ : GL (Fin 3) F) (W : GL (Fin 3) F → R)
    (Λ : gl3CyclicSubspace (leftTranslate (R := R) τ W) →ₗ[R] R) : gl3CyclicSubspace W →ₗ[R] R :=
  (Λ.comp (cyclicEquiv (R := R) τ W : gl3CyclicSubspace W →ₗ[R] _)).comp (gl3CyclicRep W τ⁻¹)

private theorem pullbackFunctional_apply (τ : GL (Fin 3) F) (W : GL (Fin 3) F → R)
    (Λ : gl3CyclicSubspace (leftTranslate (R := R) τ W) →ₗ[R] R) (f : gl3CyclicSubspace W) :
    pullbackFunctional τ W Λ f = Λ (cyclicEquiv (R := R) τ W (gl3CyclicRep W τ⁻¹ f)) := rfl

private theorem isGL3WhittakerFunctional_pullbackFunctional (τ : GL (Fin 3) F) (a : Fˣ)
    (hτ : ∀ x y z : F, τ * upperUnipotent3 x y z = upperUnipotent3 (a * x) (a * y) (a * (a * z)) * τ)
    {ψ ψ' : AddChar F R} (hψ' : ∀ s, ψ' s = ψ (a * s)) (W : GL (Fin 3) F → R)
    {Λ : gl3CyclicSubspace (leftTranslate (R := R) τ W) →ₗ[R] R}
    (hΛ : IsGL3WhittakerFunctional (gl3CyclicRep (leftTranslate (R := R) τ W)) ψ' Λ) :
    IsGL3WhittakerFunctional (gl3CyclicRep W) ψ (pullbackFunctional τ W Λ) := by
  intro x y z f

  have hconj : τ⁻¹ * upperUnipotent3 x y z =
      upperUnipotent3 (↑a⁻¹ * x) (↑a⁻¹ * y) (↑a⁻¹ * (↑a⁻¹ * z)) * τ⁻¹ := by
    have h := hτ (↑a⁻¹ * x) (↑a⁻¹ * y) (↑a⁻¹ * (↑a⁻¹ * z))
    simp only [Units.mul_inv_cancel_left] at h
    rw [eq_mul_inv_iff_mul_eq, mul_assoc, ← h, inv_mul_cancel_left]
  have hΛ' := hΛ (↑a⁻¹ * x) (↑a⁻¹ * y) (↑a⁻¹ * (↑a⁻¹ * z))
    (cyclicEquiv (R := R) τ W (gl3CyclicRep W τ⁻¹ f))
  rw [pullbackFunctional_apply, pullbackFunctional_apply, ← Module.End.mul_apply, ← map_mul, hconj, map_mul,
    Module.End.mul_apply, cyclicEquiv_gl3CyclicRep, hΛ', hψ', mul_add, Units.mul_inv_cancel_left,
    Units.mul_inv_cancel_left]

private theorem pullbackFunctional_injective (τ : GL (Fin 3) F) (W : GL (Fin 3) F → R) :
    Function.Injective (pullbackFunctional (R := R) τ W) := by
  intro Λ₁ Λ₂ h
  apply LinearMap.ext
  intro w
  have hw : w = cyclicEquiv (R := R) τ W (gl3CyclicRep W τ⁻¹
      (gl3CyclicRep W τ ((cyclicEquiv (R := R) τ W).symm w))) := by
    rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply,
      LinearEquiv.apply_symm_apply]

  have e := congrArg
    (fun Λ : gl3CyclicSubspace W →ₗ[R] R => Λ (gl3CyclicRep W τ ((cyclicEquiv (R := R) τ W).symm w))) h
  rw [hw]
  exact e

private theorem hasWhittakerMultOne_leftTranslate (τ : GL (Fin 3) F) (a : Fˣ)
    (hτ : ∀ x y z : F, τ * upperUnipotent3 x y z = upperUnipotent3 (a * x) (a * y) (a * (a * z)) * τ)
    {ψ ψ' : AddChar F R} (hψ' : ∀ s, ψ' s = ψ (a * s)) {W : GL (Fin 3) F → R}
    (hW : HasWhittakerMultOne ψ W) : HasWhittakerMultOne ψ' (fun k => W (τ * k)) := by
  unfold HasWhittakerMultOne GL3WhittakerUniquenessStatement at hW ⊢
  let Φ : gl3WhittakerFunctionalSpace (gl3CyclicRep (leftTranslate (R := R) τ W)) ψ' →ₗ[R]
      gl3WhittakerFunctionalSpace (gl3CyclicRep W) ψ :=
    { toFun := fun Λ => ⟨pullbackFunctional τ W Λ.1,
        isGL3WhittakerFunctional_pullbackFunctional τ a hτ hψ' W Λ.2⟩
      map_add' := fun _ _ => Subtype.ext (LinearMap.ext fun _ => rfl)
      map_smul' := fun _ _ => Subtype.ext (LinearMap.ext fun _ => rfl) }
  have hΦ : Function.Injective Φ := fun Λ₁ Λ₂ h =>
    Subtype.ext (pullbackFunctional_injective τ W (congrArg Subtype.val h))
  exact (LinearMap.rank_le_of_injective Φ hΦ).trans hW

end
