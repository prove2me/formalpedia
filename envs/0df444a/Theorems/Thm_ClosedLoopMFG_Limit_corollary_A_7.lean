-- title:
--   Corollary A.7 — a solution of the randomized Fokker–Planck equation is the conditional law of a strong solution
-- statement:
--   Let $B:[0,T]\times\mathbb R^d\times C([0,T];\mathcal P(\mathbb R^d))\to\mathbb R^d$ be a bounded semi-Markov function. Let $(\Omega,\mathcal F,\mathbb F,\mathbb P)$ be a complete filtered probability space carrying an $\mathbb F$-Brownian motion $W$, an $\mathcal F_0$-measurable $\xi$ with law $\lambda$, and a continuous $\mathbb F$-adapted $\mathcal P(\mathbb R^d)$-valued process $\mu$, independent of $(\xi,W)$. Suppose that almost surely, for all $t\in[0,T]$ and $\varphi\in C_c^\infty(\mathbb R^d)$,
--   $$\langle\mu_t,\varphi\rangle=\langle\lambda,\varphi\rangle+\int_0^t\Big\langle\mu_s,\ B(s,\cdot,\mu)\cdot\nabla\varphi+\tfrac12\Delta\varphi\Big\rangle\,ds. \tag{A.9}$$
--   Then there is a continuous process $X$, adapted to the completed filtration generated by $(\xi,W_t,\mu_t)$, with
--   $$dX_t=B(t,X_t,\mu)\,dt+dW_t,\qquad X_0=\xi,$$
--   and $\mathcal L(X_t\mid\mu)=\mathcal L(X_t\mid\mathcal F^\mu_t)=\mu_t$ almost surely for each $t$, where $\mathcal F^\mu_t=\sigma(\mu_s:s\le t)$.
--
--   This is the step that turns the randomized Fokker–Planck equation of Lemma 5.3(a) into the state process of Lemma 5.3(c).
--
--   **Formalization Note** The SDE is stated pathwise, $X_0=\xi$ almost surely. The two conditional-law identities are stated for every Borel set $S\subseteq\mathbb R^d$: $\mu_t(S)=\mathbb E[1_S(X_t)\mid\sigma(\mu)]$ and $\mu_t(S)=\mathbb E[1_S(X_t)\mid\mathcal F^\mu_t]$ almost surely. Boundedness of $B$ is required for $t\in[0,T]$. The paper states Appendix A for a general Polish $E$ and specializes to $E=\mathcal P(\mathbb R^d)$, $\eta=\mu$ in this corollary, which is the form stated here.
-- source:
--   Lacker, On the convergence of closed-loop Nash equilibria to the mean field game limit, arXiv:1808.02745v1, p. 58, Corollary A.7 (with the standing setting of Appendix A, p. 51)

import Mathlib
import Definitions.Def_ClosedLoopMFG_Limit_Model
import Definitions.Def_ClosedLoopMFG_Limit_Equilibrium

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace ClosedLoopMFG.Limit

/-- **Corollary A.7** (p. 58). Let `B` be a bounded semi-Markov drift, `(Ω, 𝓕, 𝔽, P)` a complete
filtered probability space carrying an `𝔽`-Brownian motion `W`, an `𝓕_0`-measurable `ξ ∼ λ`, and a
continuous `𝔽`-adapted flow `μ` independent of `(ξ, W)` that solves the randomized
Fokker–Planck equation (A.9) a.s. Then there is a continuous process `X`, adapted to the completed
filtration generated by `(ξ, W_t, μ_t)`, with `dX_t = B(t, X_t, μ) dt + dW_t`, `X_0 = ξ`, and
`L(X_t | μ) = L(X_t | 𝓕^μ_t) = μ_t` a.s. for each `t`. -/
theorem corollary_A_7 {d : ℕ} {T : ℝ≥0} (hT : 0 < T) (lam : PR d)
    (B : ℝ → E d → Flow d T → E d) (hB : IsSemiMarkov B)
    (hBb : ∃ C : ℝ, ∀ t ∈ Set.Icc (0 : ℝ) T, ∀ x m, ‖B t x m‖ ≤ C)
    {Ω : Type} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (𝓕 : Filtration ℝ≥0 mΩ) (hcompl : IsCompleteFilt 𝓕 P)
    (W : ℝ≥0 → Ω → E d) (hW : IsFBrownian 𝓕 P W)
    (ξ : Ω → E d) (hξ : Measurable[𝓕 0] ξ) (hξlaw : P.map ξ = lam.meas)
    (μ : Ω → Flow d T) (hμ : Measurable μ)
    (hμad : ∀ s : Set.Icc (0 : ℝ) T, Measurable[𝓕 (s : ℝ).toNNReal] (fun ω => μ ω s))
    (hind : IndepFun μ (fun ω => (ξ ω, bmPath W ω)) P)
    (hA9 : ∀ᵐ ω ∂P, ∀ t : Set.Icc (0 : ℝ) T, ∀ φ : E d → ℝ, IsTestFn φ →
      pair (μ ω t) φ = pair lam φ +
        ∫ s in (0 : ℝ)..t, pair (ev (μ ω) s)
          (fun x => inner ℝ (B s x (μ ω)) (gradient φ x) + (1 / 2 : ℝ) * Laplacian.laplacian φ x)) :
    ∃ X : Ω → Path d T, Measurable X ∧
      (∀ s : Set.Icc (0 : ℝ) T, Measurable[genFilt P ξ W μ (s : ℝ).toNNReal] (fun ω => X ω s)) ∧
      (∀ᵐ ω ∂P, ev (X ω) 0 = ξ ω) ∧
      SolvesState P W X μ B ∧
      ∀ (t : Set.Icc (0 : ℝ) T) (S : Set (E d)), MeasurableSet S →
        ((fun ω => ((μ ω t).meas S).toReal) =ᵐ[P]
          P[(S.indicator (fun _ => (1 : ℝ))) ∘ (fun ω => X ω t) |
            MeasurableSpace.comap μ inferInstance]) ∧
        ((fun ω => ((μ ω t).meas S).toReal) =ᵐ[P]
          P[(S.indicator (fun _ => (1 : ℝ))) ∘ (fun ω => X ω t) | Fμ μ t]) := by sorry

end ClosedLoopMFG.Limit
