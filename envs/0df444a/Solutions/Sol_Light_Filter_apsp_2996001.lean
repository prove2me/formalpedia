            Nat.mul_le_mul_left _ (hpP.trans (PmaxOf_le_two_pow hm2))
        _ = _ := by rw [sOf_eq, ← pow_add, ← pow_add]; ring_nf
    calc (sOf n * p) ^ 1249 ≤ (2 ^ (2 * jOf n + bOf n + 3 * ellOf n + 2)) ^ 1249 :=
