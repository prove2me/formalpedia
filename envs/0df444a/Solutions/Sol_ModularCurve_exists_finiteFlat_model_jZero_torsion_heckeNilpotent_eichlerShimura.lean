theorem dvd_conv_pow_sub_pow [IsDomain R] [Module.Finite R H] [Module.Free R H]
    [Coalgebra.IsCocomm R H] (Tc : H →ₐc[R] H) (hT : ESHyp p Tc) (φ : H →ₗ[R] R) :
    (p : WithConv (H →ₗ[R] R)) ∣
      WithConv.toConv (φ ∘ₗ (Tc : H →ₗ[R] H)) ^ p - WithConv.toConv φ ^ (p ^ 2) := by
  refine dvd_of_rho_eq_zero p hker _ ?_
  rw [← rhoHom_apply, map_sub, map_pow, map_pow, rhoHom_apply, rhoHom_apply, rho_comp,
    map_Tb_pow_eq p Tc hT, sub_self]

