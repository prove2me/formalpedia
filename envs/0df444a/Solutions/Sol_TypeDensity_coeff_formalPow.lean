open TypeDensity

theorem solution (c : RatFunc ℚ) (g : TypeDensity.Ser) (hg : PowerSeries.constantCoeff g = 1)
    (n : ℕ) :
    PowerSeries.coeff n (TypeDensity.formalPow c g) = ∑ k ∈ Finset.range (n + 1), ((k.factorial : ℚ)⁻¹) •
      ((∏ j ∈ Finset.range k, (TypeDensity.scalar c - (j : ℚ) • (1 : TypeDensity.Coef))) *
        PowerSeries.coeff n ((g - 1) ^ k)) := by
  set B : TypeDensity.Ser := PowerSeries.mk fun n ↦
    ((n.factorial : ℚ)⁻¹) • ∏ j ∈ Finset.range n, (TypeDensity.scalar c - (j : ℚ) • (1 : TypeDensity.Coef)) with hB
  set y : TypeDensity.Ser := g - 1 with hy_def
  have hy0 : PowerSeries.constantCoeff y = 0 := by simp [y, hg]
  have hy : PowerSeries.HasSubst y := PowerSeries.HasSubst.of_constantCoeff_zero' hy0
  have hODE := TypeDensity.binomial_series_ode c
  rw [← hB] at hODE
  have hEq : B.subst y = TypeDensity.formalPow c g := by
    refine TypeDensity.eq_of_mul_derivative_eq_mul g (PowerSeries.C (TypeDensity.scalar c) * PowerSeries.derivative TypeDensity.Coef g)
      _ _ hg ?_ (TypeDensity.mul_derivative_formalPow c g hg) ?_
    · have hs := congrArg (fun f : TypeDensity.Ser ↦ f.subst y) hODE
      rw [PowerSeries.subst_mul hy, PowerSeries.subst_mul hy, PowerSeries.subst_add hy,
        PowerSeries.subst_X hy] at hs
      have hone : (1 : TypeDensity.Ser).subst y = 1 := by
        simpa using (PowerSeries.subst_C (a := y) (1 : TypeDensity.Coef))
      have hC : (PowerSeries.C (TypeDensity.scalar c)).subst y = PowerSeries.C (TypeDensity.scalar c) :=
        PowerSeries.subst_C _
      rw [hone, hC, show (1 : TypeDensity.Ser) + y = g by simp [y]] at hs
      rw [PowerSeries.derivative_subst hy, show PowerSeries.derivative TypeDensity.Coef y =
        PowerSeries.derivative TypeDensity.Coef g by simp [y], ← mul_assoc, hs]
      ring
    · rw [TypeDensity.constantCoeff_formalPow c g hg, ← PowerSeries.coeff_zero_eq_constantCoeff_apply,
        TypeDensity.coeff_subst_eq_sum 0 B y hy0]
      simp [B]
  rw [← hEq, TypeDensity.coeff_subst_eq_sum n B y hy0]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  simp only [B, PowerSeries.coeff_mk, y]
