local instance : DecidableEq Params := fun a b => match a,b with
  | ⟨u,q,p⟩,⟨u',q',p'⟩ => if h : u=u' ∧ q=q' ∧ p=p' then isTrue (by rcases h with ⟨rfl,rfl,rfl⟩; rfl)
    else isFalse (by intro eq; cases eq; exact h ⟨rfl,rfl,rfl⟩)
private theorem sum11 {α : Type} [AddCommMonoid α] (f : Fin 11 → α) :
    (∑ i, f i) = f 0+(f 1+(f 2+(f 3+(f 4+(f 5+(f 6+(f 7+(f 8+(f 9+(f 10+(0))))))))))) := by
  simp only [Fin.sum_univ_succ,Finset.univ_eq_empty,Finset.sum_empty]
  rfl


private theorem inputAt {b : Bool} {a : Box} (j : ℕ) (i : Fin 11) (x : Box)
    (hb : reflected j i = b) (ha : subB x (point (HeightTwoWitness.shiftsQ i)) = a) :
    shifted j i x = params b a := by simp only [shifted,hb,ha]
private theorem liftV {b : Bool} {a B : Box} (h : thetaV (params b a) = B)
    (j : ℕ) (i : Fin 11) (x : Box) (hb : reflected j i = b)
    (ha : subB x (point (HeightTwoWitness.shiftsQ i)) = a) :
    thetaV (shifted j i x) = B := by rw [inputAt j i x hb ha]; exact h
private theorem liftD {b : Bool} {a B : Box} (h : thetaD b (params b a) = B)
    (j : ℕ) (i : Fin 11) (x : Box) (hb : reflected j i = b)
    (ha : subB x (point (HeightTwoWitness.shiftsQ i)) = a) :
    thetaD (reflected j i) (shifted j i x) = B := by rw [inputAt j i x hb ha,hb]; exact h
private theorem liftT {b : Bool} {a : Box} {y : ℚ} (h : tailU (params b a) = y)
    (j : ℕ) (i : Fin 11) (x : Box) (hb : reflected j i = b)
    (ha : subB x (point (HeightTwoWitness.shiftsQ i)) = a) :
    tailU (shifted j i x) = y := by rw [inputAt j i x hb ha]; exact h
private theorem liftH {b : Bool} {a : Box} (h : 0 < tailDen (params b a))
    (j : ℕ) (i : Fin 11) (x : Box) (hb : reflected j i = b)
    (ha : subB x (point (HeightTwoWitness.shiftsQ i)) = a) :
    0 < tailDen (shifted j i x) := by rw [inputAt j i x hb ha]; exact h

