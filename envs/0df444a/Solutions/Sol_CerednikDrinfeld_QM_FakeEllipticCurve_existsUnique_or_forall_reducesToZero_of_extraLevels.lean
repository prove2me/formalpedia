section LevelPts
variable {k : Type} [Field k] [IsAlgClosed k]

def ptsEquivOfEq {X : Scheme.{0}} {f : X ⟶ Spec (CommRingCat.of k)} {t t' : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of k)}
    (h : t = t') : SchemeHomOver t f ≃ SchemeHomOver t' f where
  toFun P := ⟨P.1, P.2.trans h⟩
  invFun P := ⟨P.1, P.2.trans h.symm⟩
  left_inv P := Subtype.ext rfl
  right_inv P := Subtype.ext rfl

theorem geomPoint_id : geomPoint k (RingHom.id k) = 𝟙 (Spec (CommRingCat.of k)) := by
  show Spec.map (CommRingCat.ofHom (RingHom.id k)) = 𝟙 _
  rw [CommRingCat.ofHom_id]; exact Spec.map_id _

theorem natCard_extraLevelPts (E : FakeEllipticCurve Λ N k) (ℓ : ℕ) (K : E.ExtraLevel ℓ) (hℓ : (ℓ : k) ≠ 0) :
    Nat.card {P : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) E.f // FactorsThrough K.levK P} = ℓ ^ 2 := by
  obtain ⟨e, -⟩ := K.levK_fibre k (RingHom.id k) hℓ
  let e' : {P : SchemeHomOver (geomPoint k (RingHom.id k)) E.f // FactorsThrough K.levK P} ≃
      {P : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) E.f // FactorsThrough K.levK P} :=
    (ptsEquivOfEq geomPoint_id).subtypeEquiv (fun P => Iff.rfl)
  rw [← Nat.card_congr (e.trans e'), Nat.card_prod, Nat.card_zmod, pow_two]

end LevelPts
