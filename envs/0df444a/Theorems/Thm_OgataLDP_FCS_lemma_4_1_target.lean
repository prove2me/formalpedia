-- title:
--   Lemma 4.1 target and equation (23) — condition (14) gives a differentiable pressure
-- statement:
--   Let $\omega$ be a finitely correlated state generated by $(\mathcal B,\mathcal E,\rho)$, and let $\Phi$ be a translation-invariant finite-range interaction. Suppose condition (14) holds: there is $s>0$ such that
--
--   $$s^{-1}\rho(b)\,1\le\widehat{\mathcal E}_1(b)\le s\rho(b)\,1\qquad(b\ge0).$$
--
--   Then a differentiable real function $f$ exists with, for every $\alpha\in\mathbb R$,
--
--   $$f(\alpha)=\lim_{n\to\infty}\frac1n\log\omega_n\!\left(e^{\alpha H_\Phi([1,n])}\right).$$
--
--   This states the limiting-pressure target identified in Lemma 4.1 and established in the proof of Theorem 1.2, equation (23).
--
--   **Formalization Note** Translation invariance identifies the paper's interval $[-n,-1]$ with $[1,n]$. The exponential has strictly positive state expectation for valid finitely correlated data, so the real logarithm is used. The printed reduction in Lemma 4.1 omits a mixture step for non-ergodic states; the present statement retains condition (14).
-- source:
--   Ogata, arXiv:0803.0113v1, pp. 12, 15, Lemma 4.1, equations (13), (14), and (23)

import Mathlib
import Definitions.Def_OgataLDP_FCS_Model

set_option autoImplicit false
noncomputable section
open MeasureTheory Filter Topology NormedSpace
open scoped ComplexOrder MatrixOrder

namespace OgataLDP.FCS

/-- Ogata, arXiv:0803.0113v1, p. 12, the target of Lemma 4.1 under (14),
established in the proof of Theorem 1.2 on p. 15, equation (23). -/
theorem lemma_4_1_target {σ : Type*} [Fintype σ] [DecidableEq σ] [Nonempty σ] {k : ℕ}
    (F : FCSData σ k) (hF : F.IsValid) (Phi : Interaction σ)
    (h14 : ∃ s : ℝ, 0 < s ∧
      ∀ b : Matrix (Fin k) (Fin k) ℂ, b.PosSemidef →
        ((s⁻¹ * F.rhoState b : ℝ) : ℂ) • 1 ≤ F.Ehat1 b ∧
        F.Ehat1 b ≤ ((s * F.rhoState b : ℝ) : ℂ) • 1) :
    ∃ f : ℝ → ℝ, Differentiable ℝ f ∧
      ∀ a : ℝ, Tendsto
        (fun n : ℕ => (n : ℝ)⁻¹ *
          Real.log ((F.localState n (exp ((a : ℂ) • Phi.hamiltonian n))).re))
        atTop (𝓝 (f a)) := by sorry

end OgataLDP.FCS
