-- ===== S4.Def_RP_EtPBC_A_BCMap =====
section

/-!
# S4-EtPBC-A, L1d: the data of the base change map at a geometric point

For `g : P ⟶ S` and a geometric point `s : Spec Ω ⟶ S`: the fibre `fib g s = P ×_S Spec Ω` with
`fibι : fib g s ⟶ P`; the cofiltered category `Nbhd s` of etale neighbourhoods `(V, v)` of `s`
(`s.point.fiber.Elements`); the system `nbhdSys : (V, v) ↦ Λ[g⁻¹ V]`; and the maps
`bcUnit j : Λ_{P_s} ⟶ ι^* Λ[g⁻¹ V]` (the global section of `ι^* Λ[g⁻¹ V]` obtained from the unit of `ι^* ⊣ ι_*`
restricted along the section `nbhdSec j : P_s ⟶ ι⁻¹(g⁻¹ V)` given by `v`). **`bcUnit_comp`**: they are compatible
with the transition maps, as required by the δ-lemma `Delta.injAt_all`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact.PtSec

universe u

section Free

end Free

section OfSec

end OfSec

variable (Λ : Type u) [CommRing Λ] {P S : Scheme.{u}} (g : P ⟶ S) (s : GeomPt S)

section EtPull

end EtPull

theorem nbhdSec_comp {j j' : Nbhd s} (a : j' ⟶ j) :
    nbhdSec g s j' ≫ (etPull (fibι g s)).map ((etPull g).map a.1) = nbhdSec g s j :=
  MorphismProperty.Over.Hom.ext (secL_map g s a)

end RamanujanPetersson.EtPBC

end

end

-- ===== S4.Def_RP_EtPBC_A_CovAsN1 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, AsN1): power series map onto the adic completion

For `a : σ → A` (`σ` finite) and `p = span (range a)`:
* `aeval_monomial_mem_pow`, `aeval_mem_pow_of_coeff`, `mk_aeval_eq`: a polynomial whose coefficients vanish below total
  degree `n` evaluates (at `a`) into `p ^ n`.
* `truncEval a n : MvPowerSeries σ A →+* A ⧸ p ^ n`, `F ↦ mk (aeval a (truncTotal n F))`, `truncEval_compat`.
* **`hatPhi a : MvPowerSeries σ A →+* AdicCompletion p A`**, `evalₐ_hatPhi`, `hatPhi_X`, `hatPhi_C`.
-/

set_option autoImplicit false

open MvPowerSeries

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u v

section HatN1

variable {A : Type u} [CommRing A] {σ : Type v} [Fintype σ] (a : σ → A)

theorem truncEval_apply (n : ℕ) (F : MvPowerSeries σ A) :
    truncEval a n F = Ideal.Quotient.mk _ (MvPolynomial.aeval a (truncTotal n F)) := rfl

theorem truncEval_compat {m n : ℕ} (hle : m ≤ n) :
    (Ideal.Quotient.factorPow (Ideal.span (Set.range a)) hle).comp (truncEval a n) = truncEval a m := by
  refine RingHom.ext fun F => ?_
  rw [RingHom.comp_apply, truncEval_apply, truncEval_apply, Ideal.Quotient.factor_mk]
  exact mk_aeval_eq a _ _ fun x hx => by
    rw [coeff_truncTotal _ hx, coeff_truncTotal _ (lt_of_lt_of_le hx hle)]

/-- The ring map `A⟦X_σ⟧ → Â`, `X i ↦ a i`. -/
def hatPhi : MvPowerSeries σ A →+* AdicCompletion (Ideal.span (Set.range a)) A :=
  AdicCompletion.liftRingHom _ (truncEval a) fun hle => truncEval_compat a hle

end HatN1

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_Inj0a =====
section

/-!
# S4-EtPBC-A, G1a: germs of a pulled-back section control the support

For `f : X ⟶ Y`, a geometric point `s` of `X`, a sheaf `G` on `Y`, `V : Y.Etale`, a fibre point `b` of `s` over
`f⁻¹ V` and `z ∈ G(V)`:
* `cpt f s b : V.left`, the point of `V` under `b`; `cpt_map` (naturality in `V`);
* **`comap_germ_eq_zero`**: if the germ of `η_G(z) ∈ (f^* G)(f⁻¹ V)` at `b` vanishes, so does the germ of `z` at `b`
  for the point `comapPt f s` of `Y` (Mathlib's stalk isomorphism `(f^* G)_s ≅ G_{s ≫ f}`, `comapIso_hom_app`);
* `exists_nbhd_of_comap_germ`: such a germ vanishes on an etale neighbourhood;
* **`cpt_not_mem_supp`**: then `cpt b` is not in the support `supp G z`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite GrothendieckTopology

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtCompact.Cech

universe u

variable {Λ : Type u} [CommRing Λ] {X Y : Scheme.{u}} (f : X ⟶ Y) (s : GeomPt X)

/-- **A vanishing germ at `comapPt f s` keeps `cpt b` out of the support.** -/
theorem cpt_not_mem_supp (G : EtSh Λ Y) {V : Y.Etale} (b : (comapPt f s).fiber.obj V) (z : G.obj.obj (op V))
    (h : ((comapPt f s).toPresheafFiber V b G.obj).hom z = 0) :
    cpt f s (V := V) b ∉ supp G z := by
  obtain ⟨W, g, b', hb, hz⟩ := exists_nbhd_of_comap_germ f s G b z h
  rintro ⟨y, a, ha, hne⟩
  have hv : g.left (cpt f s (V := W) b') = fpt y a := by
    rw [ha, ← cpt_map f s g b']
    exact congrArg (cpt f s (V := V)) hb
  obtain ⟨c, hc, -⟩ := exists_lift_fib g y a _ hv
  apply hne
  rw [← hc]
  have hw := ConcreteCategory.congr_hom ((geomPtAt y).point.toPresheafFiber_w g c G.obj) z
  calc ((geomPtAt y).point.toPresheafFiber V ((geomPtAt y).point.fiber.map g c) G.obj).hom z
      = ((geomPtAt y).point.toPresheafFiber W c G.obj).hom ((G.obj.map g.op).hom z) := hw.symm
    _ = 0 := by rw [hz, map_zero]

end RamanujanPetersson.EtPBC

end

end

-- ===== S4.Def_RP_EtPBC_A_Inj0c =====
section

/-!
# S4-EtPBC-A, G1c: base change is injective on germs in degree `0` (universally closed `g`)

* `fibB j x`: the fibre point `σ_v(x̄)` of `x̄ = geomPtAt x` over `ι⁻¹(g⁻¹ V)`; `cpt_fibB`: its point is `fibToNbhd x`;
* **`fibToNbhd_not_mem_supp`**: if `bc_j α = 0` then no point of `P_s` lands in the support of `sec0 α`;
* `fibCmp`, **`exists_fibToNbhd`**: every point of `g⁻¹ V` over `v` comes from `P_s`;
* **`bcInj_zero`**: for universally closed `g`, `BCInj Λ g s 0 G` for every sheaf `G` (the support of `sec0 α` is closed,
  its image in `V` is closed and misses `v`; shrink `V` to the complement, where every germ vanishes).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtCompact.Cech

universe u

variable (Λ : Type u) [CommRing Λ] {P S : Scheme.{u}} (g : P ⟶ S) (s : GeomPt S)

theorem cpt_fibB (j : Nbhd s) (x : fib g s) :
    cpt (fibι g s) (geomPtAt x) (fibB g s j x) = fibToNbhd g s j x := by
  have h1 : cpt (fibι g s) (geomPtAt x) (fibB g s j x) =
      (secL g s j ≫ pullback.fst (pullback.snd j.1.hom g) (fibι g s)).base ((geomPtAt x).pt default) := rfl
  exact h1.trans ((congrArg (fun φ => φ.base ((geomPtAt x).pt default)) (secL_fst g s j)).trans
    (congrArg (fibToNbhd g s j).base (center_geomPtAt x)))

/-- **Every point of `g⁻¹ V` over `v` comes from the fibre `P_s`.** -/
theorem exists_fibToNbhd (j : Nbhd s) (t : (pullback j.1.hom g : Scheme.{u}))
    (ht : pullback.fst j.1.hom g t = j.2.left (default : Spec (CommRingCat.of s.Ω))) :
    ∃ x : fib g s, fibToNbhd g s j x = t := by
  obtain ⟨p, hp, -⟩ := Scheme.Pullback.exists_preimage_pullback t (default : Spec (CommRingCat.of s.Ω)) ht
  exact ⟨fibCmp g s j p, (congrArg (fun φ => φ.base p) (fibCmp_fibToNbhd g s j)).trans hp⟩

end RamanujanPetersson.EtPBC

end

end

-- ===== S4.Def_RP_EtPBC_A_VPart =====
