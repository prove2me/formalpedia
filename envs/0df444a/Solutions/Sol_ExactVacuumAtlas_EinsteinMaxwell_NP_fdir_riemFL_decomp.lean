      (contDiffOn_const.mul (hr I B))) (contDiffOn_const.mul (hr I A)),
    fdir_sub_of hU hx ((contDiffOn_const.mul (hr J B)).sub (contDiffOn_const.mul (hr J A)))
      (contDiffOn_const.mul (hr I B)),
    fdir_sub_of hU hx (contDiffOn_const.mul (hr J B)) (contDiffOn_const.mul (hr J A)),
    fdir_const_mul, fdir_const_mul, fdir_const_mul, fdir_const_mul]
  ring
