-- title:
--   Stationary Markov controls $\mathfrak U_{\mathsf{sm}}$
-- statement:
--   A stationary Markov control is a Borel measurable map $v:\mathbb R^d\to\mathrm V=\mathcal P(\mathbb U)$; the control process is then $U_t=v(X_t)$. The set of these maps is denoted $\mathfrak U_{\mathsf{sm}}$.
--
--   **Formalization Note** The measurable structure on $\mathcal P(\mathbb U)$ is Mathlib's, generated by the evaluations $\mu\mapsto\mu(A)$. For compact metric $\mathbb U$ this is the Borel $\sigma$-algebra of the weak topology.
-- source:
--   Pradhan & Yüksel, arXiv:2205.05894v2, §2, p.6

import Definitions.Def_EthierKurtz_SDEState

open MeasureTheory ProbabilityTheory Filter EthierKurtz
open scoped ENNReal NNReal Topology BigOperators

namespace DiffCtrlRobust

/-- The set `𝔘sm` of stationary Markov controls: Borel maps `v : ℝ^d → V = P(U)`
(arXiv:2205.05894v2, §2, p.6).

**Formalization Note.** `ProbabilityMeasure U` carries Mathlib's `MeasurableSpace` (the σ-algebra
generated by the evaluations `μ ↦ μ A`), which for a compact metric `U` is the Borel σ-algebra of
the weak topology. -/
abbrev Usm (d : ℕ) (U : Type*) [MeasurableSpace U] : Type _ :=
  {v : SDEState d → ProbabilityMeasure U // Measurable v}

end DiffCtrlRobust


