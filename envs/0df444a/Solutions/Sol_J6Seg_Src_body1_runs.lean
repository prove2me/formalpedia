theorem peel_runs (s : IState HS) (n w : ℕ) (LW L2 LC LD : List Item)
    (hW : s.G cW = .int (n : ℤ) :: LW) (h2 : s.G cR2 = .int 2 :: L2)
    (hC : s.G cCw = marks w ++ LC) (hD : s.G cDw = LD) (hLC : NM LC) (hLD : NM LD) :
    IRuns I iprog peel s
      ((s.upd cW (.int ((n / 2 ^ w : ℕ) : ℤ) :: LW)).upd cO
        (ints ((List.range w).map (bitN n)).reverse ++ s.G cO)) (cPeel w) := by
  let T : ℕ → IState HS := fun k =>
    (s.upd cW (.int ((n / 2 ^ k : ℕ) : ℤ) :: LW)).upd cO
      (ints ((List.range k).map (bitN n)).reverse ++ s.G cO)
  have hu := uloop_runs (I := I) (iprog := iprog) (C := cCw) (D := cDw) (by decide) w T LC LD
    hLC hLD (splitCost 1 + 17) (.op (.split cW cR2 cO)) (by
      intro k hk LC' LD'
      have H := IRuns.split (I := I) (iprog := iprog) (s := cf (T k) cCw cDw LC' LD')
        (i := cW) (j := cR2) (k := cO) (a := ((n / 2 ^ k : ℕ) : ℤ)) (m := 1)
        (Li := LW) (Lj := L2) (by decide) (by decide) (by decide)
        (by simp +decide [T, cf]) (by simp +decide [T, cf, h2])
      refine H.mono' ?_ le_rfl
      rw [sg_nat, sg_nat, Int.natAbs_natCast]
      have e1 : n / 2 ^ k / 2 ^ 1 = n / 2 ^ (k + 1) := by
        rw [Nat.div_div_eq_div_mul, ← pow_add]
      have e2 : ints ((List.range (k + 1)).map (bitN n)).reverse =
