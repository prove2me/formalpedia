  unfold boxIx
  rw [ofFn_split]
  exact digL_append _ ht _ x i.val (by simp)

theorem boxIx_last (t : Fin (d + 1) → ℕ) (x : ℕ) :
    boxIx t x (Fin.last d) = x % t (Fin.last d) := by
  unfold boxIx
  rw [ofFn_split]
  have := digL_append_len (t (Fin.last d)) (List.ofFn fun i : Fin d => t i.castSucc) x
  simpa using this

