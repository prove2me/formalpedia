  have hajj1 : |a j j - 1| ≤ η := by linarith
  have hajj : 1 / 2 ≤ a j j := by have := neg_abs_le (a j j - 1); linarith
  have hajj3 : a j j ≤ 3 / 2 := by have := le_abs_self (a j j - 1); linarith
  have hajjp : 0 < a j j := by linarith
