theorem cDivPc_le {P Q c B Bb : ℕ} (hc20 : c ≤ 20) (hQ : 1 ≤ Q) (hB : 1 ≤ B) :
    cDivPc P Q c B Bb ≤ 10 ^ 7 * (P * (Q * B) + 1) * (Bb + 2) := by
  unfold cDivPc cBlkD cDist cBodyM cSel
  set W := Bb + 2
  have hW : 2 ≤ W := by omega
  have hBb : Bb ≤ W := by omega
  have hQB : Q ≤ Q * B := Nat.le_mul_of_pos_right _ hB
  have h1QB : 1 ≤ Q * B := le_trans hQ hQB
  -- per block
  have hblk : (1 + 1) * 2000 * W + ((1 + 1) * 2000 * W + Q * (c * ((3 + 1) * 2000 * W +
      (2 * Bb + 2) + 25) + ((1 + 1) * 2000 * W + B * (14000 * W) + 32) + (14 + 1) * 2000 * W +
      8000 * W + 30) + 32) + (2 * Bb + 2) + (c * ((1 + 1) * 2000 * W + 32) + 1 +
      c * (Q * B) * (14000 * W)) + ((1 + 1) * 2000 * W + Q * B * (14000 * W) + 32) +
      8000 * W + 30 ≤ 700000 * (Q * B) * W := by
    have a1 : Q * (c * ((3 + 1) * 2000 * W + (2 * Bb + 2) + 25)) ≤ Q * B * (20 * 8100 * W) := by
      calc Q * (c * ((3 + 1) * 2000 * W + (2 * Bb + 2) + 25))
            = Q * c * ((3 + 1) * 2000 * W + (2 * Bb + 2) + 25) := by ring
        _ ≤ Q * B * 20 * (8100 * W) := Nat.mul_le_mul (Nat.mul_le_mul hQB hc20) (by omega)
        _ = _ := by ring
    have a2 : Q * ((1 + 1) * 2000 * W + B * (14000 * W) + 32 + (14 + 1) * 2000 * W + 8000 * W +
        30) ≤ Q * B * (56100 * W) := by
      have : (1 + 1) * 2000 * W + B * (14000 * W) + 32 + (14 + 1) * 2000 * W + 8000 * W + 30 ≤
          B * (56100 * W) := by nlinarith
      calc _ ≤ Q * (B * (56100 * W)) := Nat.mul_le_mul_left _ this
        _ = _ := by ring
    have a3 : c * (Q * B) * (14000 * W) ≤ Q * B * (20 * 14000 * W) := by
      calc c * (Q * B) * (14000 * W) ≤ 20 * (Q * B) * (14000 * W) := by gcongr
        _ = _ := by ring
    have a4 : c * ((1 + 1) * 2000 * W + 32) ≤ Q * B * (20 * 4100 * W) := by
      calc c * ((1 + 1) * 2000 * W + 32) ≤ 20 * (4100 * W) := Nat.mul_le_mul hc20 (by omega)
        _ ≤ Q * B * (20 * 4100 * W) := by nlinarith
    have a5 : Q * B * (14000 * W) = 14000 * (Q * B * W) := by ring
    have a6 : W ≤ Q * B * W := Nat.le_mul_of_pos_left _ h1QB
    have e1 : Q * B * (20 * 8100 * W) = 162000 * (Q * B * W) := by ring
    have e2 : Q * B * (56100 * W) = 56100 * (Q * B * W) := by ring
    have e3 : Q * B * (20 * 14000 * W) = 280000 * (Q * B * W) := by ring
    have e4 : Q * B * (20 * 4100 * W) = 82000 * (Q * B * W) := by ring
    have e5 : 700000 * (Q * B) * W = 700000 * (Q * B * W) := by ring
    have e6 : Q * (c * ((3 + 1) * 2000 * W + (2 * Bb + 2) + 25) + ((1 + 1) * 2000 * W +
        B * (14000 * W) + 32) + (14 + 1) * 2000 * W + 8000 * W + 30) =
        Q * (c * ((3 + 1) * 2000 * W + (2 * Bb + 2) + 25)) + Q * ((1 + 1) * 2000 * W +
        B * (14000 * W) + 32 + (14 + 1) * 2000 * W + 8000 * W + 30) := by ring
    rw [e6]
    omega
  have hP := Nat.mul_le_mul_left P hblk
  have e7 : P * (700000 * (Q * B) * W) = 700000 * (P * (Q * B) * W) := by ring
  have e8 : 10 ^ 7 * (P * (Q * B) + 1) * W = 10 ^ 7 * (P * (Q * B) * W) + 10 ^ 7 * W := by ring
  have e9 : P * (Q * B) * (14000 * W) = 14000 * (P * (Q * B) * W) := by ring
  rw [e8, e9]
  have : P * ((1 + 1) * 2000 * W + ((1 + 1) * 2000 * W + Q * (c * ((3 + 1) * 2000 * W +
      (2 * Bb + 2) + 25) + ((1 + 1) * 2000 * W + B * (14000 * W) + 32) + (14 + 1) * 2000 * W +
      8000 * W + 30) + 32) + (2 * Bb + 2) + (c * ((1 + 1) * 2000 * W + 32) + 1 +
      c * (Q * B) * (14000 * W)) + ((1 + 1) * 2000 * W + Q * B * (14000 * W) + 32) +
      8000 * W + 30) ≤ 700000 * (P * (Q * B) * W) := by rw [← e7]; exact hP
  omega

section ShiftDiv

open AModelL12

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

theorem inv_inv_of_coprime {k : ℕ} (hQk : Nat.Coprime Q k) :
    ((k : ZMod Q)⁻¹)⁻¹ = (k : ZMod Q) := by
  have hu : IsUnit (k : ZMod Q) := (ZMod.isUnit_iff_coprime k Q).2 hQk.symm
  exact ZMod.inv_eq_of_mul_eq_one _ _ _ (ZMod.inv_mul_of_unit _ hu)

theorem mod_eq_val [NeZero Q] (k w : ℕ) : k * w % Q = ((k : ZMod Q) * (w : ZMod Q)).val := by
  rw [← Nat.cast_mul, ZMod.val_natCast]

/-- **`u = k⁻¹`: rotation after the inverse multiplicative permutation.** -/
theorem shiftArr_div_eq [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (k : ℕ) (hQk : Nat.Coprime Q k) (xs : List ℤ) :
    shiftArr Λ i ((k : ZMod Q)⁻¹) c 0 xs =
      shiftArr Λ i 1 c 0 (AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (divAddr Q k) 0 xs) := by
  have hQ : 0 < Q := Nat.pos_of_ne_zero (NeZero.ne Q)
  rw [shiftArr_eq_rot Λ i c hc A C hsh hA, pull_comp _ _ (valid_rotAddr hQ _),
    shiftArr_u_eq Λ i _ c hc A C hsh hA]
  refine pull_congr (fun a ha => ?_) _ _
  rcases ha with _ | ⟨hp, _ | ⟨hy, _ | ⟨hb, h⟩⟩⟩
  cases h
  simp only [Function.comp_apply, rotAddr, divAddr, uAddr, List.getD_cons_zero,
    List.getD_cons_succ]
  rw [mod_eq_val, offs, cast_rot, ZMod.natCast_zmod_val, inv_inv_of_coprime hQk]

theorem div_stage [NeZero Q] (A C : Shape) (hsh : sh = A ++ Q :: C) (k : ℕ) (hk2 : 2 ≤ k)
    (hk20 : k ≤ 20) (hkQ : k < Q) (hQk : Nat.Coprime Q k) (t : IState HS) (xs : List ℤ) (Bb : ℕ)
    (R : List Item) (hlen : xs.length = AModel.vol sh) (hb : Bnd Bb xs) (hB1 : 1 ≤ AModel.vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ AModel.vol A) (hV : zsz ((AModel.vol A * (Q * AModel.vol C) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = ints xs ++ R) :
    Sp (divPc (AModel.vol A) Q k (AModel.vol C)) t
      (t.upd 0 (ints (AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (divAddr Q k) 0 xs) ++ R))
      (10 ^ 7 * (AModel.vol A * (Q * AModel.vol C) + 1) * (Bb + 2)) := by
  set V := AModel.vol A * (Q * AModel.vol C)
  have hle : ∀ m : ℕ, m ≤ V → zsz (m : ℤ) ≤ Bb := fun m hm => le_trans (NLogN.KIL.zsz_nat_le hm) hV
  have zA := hle (AModel.vol A) (Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) (by omega)))
  have zQB := hle (Q * AModel.vol C) (Nat.le_mul_of_pos_left _ hP1)
  have zQ := hle Q (le_trans (Nat.le_mul_of_pos_right _ (by omega)) (Nat.le_mul_of_pos_left _ hP1))
  have zC := hle (AModel.vol C) (le_trans (Nat.le_mul_of_pos_left _ (by omega))
    (Nat.le_mul_of_pos_left _ hP1))
  have hlen3 : xs.length = AModel.vol A * Q * AModel.vol C := by
    rw [hlen, hsh, vol_append, vol_cons]; ring
  exact (divPc_spec t xs (AModel.vol A) Q k (AModel.vol C) Bb R hlen3 hb hk2 hk20 hQk zC
    (le_trans (NLogN.KIL.zsz_nat_le (by omega)) hQ2) zQ zQB zA hV h0).mono (cDivPc_le hk20 hQ1 hB1)

/-- **Lemma 10 shift with coefficient `u = k⁻¹` (`2 ≤ k ≤ 20`, `k` prime to `Q`), IL program.** -/
theorem shiftArrDiv_il_spec [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (k : ℕ) (hk2 : 2 ≤ k) (hk20 : k ≤ 20) (hkQ : k < Q)
    (hQk : Nat.Coprime Q k) (t : IState HS) (xs : List ℤ) (Bb : ℕ) (R : List Item)
    (hlen : xs.length = AModel.vol sh) (hb : Bnd Bb xs) (hB1 : 1 ≤ AModel.vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ AModel.vol A) (hV : zsz ((AModel.vol A * (Q * AModel.vol C) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = ints xs ++ R) :
    Sp (shDiv Q k (AModel.vol A) (AModel.vol C) (A.zip (csOf Λ c A))) t
      (t.upd 0 (ints (shiftArr Λ i ((k : ZMod Q)⁻¹) c 0 xs) ++ R))
      (cShiftU A.length (AModel.vol A * (Q * AModel.vol C)) Bb) := by
  have M := div_stage A C hsh k hk2 hk20 hkQ hQk t xs Bb R hlen hb hB1 hQ1 hP1 hV hQ2 h0
  set mid := AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (divAddr Q k) 0 xs
  have hv : AModel.vol sh = AModel.vol [AModel.vol A, Q, AModel.vol C] := by
    rw [hsh, vol_append, vol_cons]; simp [AModel.vol]
  have S := shiftArr_il_spec Λ i c hc A C hsh hA (t.upd 0 (ints mid ++ R)) mid Bb R
    (by rw [length_pull, hv]) (NLogN.KIL.bnd_pull hb) hB1 hQ1 hP1 hV hQ2 (by simp)
  rw [← shiftArr_div_eq Λ i c hc A C hsh hA k hQk] at S
  have S' : Sp (shP Q (AModel.vol A) (AModel.vol C) (A.zip (csOf Λ c A))) (t.upd 0 (ints mid ++ R)) _ _ :=
    ⟨S.1, S.2.1, S.2.2⟩
  refine ((M.seq S').congr ?_).mono le_rfl
  apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
    (try split_ifs) <;> simp_all

end ShiftDiv

section RunU2

open AModelL12

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}

theorem inv_val_inv [NeZero Q] {u : ZMod Q} (h : u * u⁻¹ = 1) :
    (((u⁻¹).val : ℕ) : ZMod Q)⁻¹ = u := by
  rw [ZMod.natCast_zmod_val]
  exact ZMod.inv_eq_of_mul_eq_one _ _ _ (by rw [mul_comm]; exact h)

theorem shiftU2_runs [NeZero Q] (hpos : ∀ a ∈ sh, 1 ≤ a) (t : IState HS) (R : List Item)
    (Bb : ℕ) (hV : zsz ((AModel.vol sh : ℕ) : ℤ) ≤ Bb) (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb)
    (i : Fin n) (u : ZMod Q) (hu : SmallUnit2 Q u) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (ys : List ℤ) (hy : DOK sh Bb ys) :
    IRuns I iprog (scodeU2 Λ (.shift i u c)) (t.upd 0 (ints ys ++ R))
      (t.upd 0 (ints ((Step.shift i u c).arr Λ 0 ys) ++ R)) (cShiftU sh.length (AModel.vol sh) Bb) := by
  by_cases h1 : u = 1 ∨ u = -1 ∨ (2 ≤ u.val ∧ u.val ≤ 20 ∧ Nat.Coprime Q u.val) ∨
      (2 ≤ (-u).val ∧ (-u).val ≤ 20 ∧ Nat.Coprime Q (-u).val)
  · have := shiftU_runs (I := I) (iprog := iprog) Λ hpos t R Bb hV hQ2 i u h1 c hc ys hy
    have hcode : (scodeU2 Λ (.shift i u c) : IStmt HS Pp) = scodeU Λ (.shift i u c) := by
      simp only [scodeU2, if_pos h1]
    rw [hcode]; exact this
  set k := (Λ.pos i : ℕ)
  have hk : k < sh.length := (Λ.pos i).2
  set A := sh.take k
  set C := sh.drop (k + 1)
  have hsh : sh = A ++ Q :: C := by
    have h1 := Λ.size i
    rw [List.get_eq_getElem] at h1
    conv_lhs => rw [← List.take_append_drop k sh, List.drop_eq_getElem_cons hk]
    rw [h1]
  have hA : (Λ.pos i : ℕ) = A.length := by simp [A, k, List.length_take]
  have hposA : ∀ a ∈ A, 1 ≤ a := fun a ha => hpos a (List.mem_of_mem_take ha)
  have hposC : ∀ a ∈ C, 1 ≤ a := fun a ha => hpos a (List.mem_of_mem_drop ha)
  have hvol : AModel.vol A * (Q * AModel.vol C) = AModel.vol sh := by
    conv_rhs => rw [hsh]
    rw [vol_append, vol_cons]
  have hQ1 : 1 ≤ Q := Nat.one_le_iff_ne_zero.2 (NeZero.ne Q)
  have hlA : A.length ≤ sh.length := by simp [A]
  have hcost : cShiftU A.length (AModel.vol A * (Q * AModel.vol C)) Bb ≤ cShiftU sh.length (AModel.vol sh) Bb := by
    rw [hvol]; simp only [cShiftU, cShift]; gcongr
  by_cases h3 : 2 ≤ (u⁻¹).val ∧ (u⁻¹).val ≤ 20 ∧ Nat.Coprime Q (u⁻¹).val ∧ u * u⁻¹ = 1
  · have H := shiftArrDiv_il_spec Λ i c hc A C hsh hA (u⁻¹).val h3.1 h3.2.1 (ZMod.val_lt _)
      h3.2.2.1 (t.upd 0 (ints ys ++ R)) ys Bb R hy.1 hy.2 (vol_pos_of hposC) hQ1
      (vol_pos_of hposA) (by rw [hvol]; exact hV) hQ2 (by simp)
    rw [IState.upd_upd_same, inv_val_inv h3.2.2.2] at H
    have HR := RS.code_runs (I := I) (iprog := iprog) _ _ H.1
    rw [H.2.1] at HR
    have hcode : (scodeU2 Λ (.shift i u c) : IStmt HS Pp) =
        (shDiv Q (u⁻¹).val (AModel.vol A) (AModel.vol C) (A.zip (csOf Λ c A))).code := by
      simp only [scodeU2, if_neg h1, if_pos h3]; rfl
    rw [hcode]
    exact HR.mono (le_trans H.2.2 hcost)
  have h4 : 2 ≤ ((-u)⁻¹).val ∧ ((-u)⁻¹).val ≤ 20 ∧ Nat.Coprime Q ((-u)⁻¹).val ∧
      -u * (-u)⁻¹ = 1 := by
    rcases hu with h | h | h
    · exact absurd h h1
    · exact absurd h h3
    · exact h
  have H := shiftArrNegDiv_il_spec Λ i c hc A C hsh hA ((-u)⁻¹).val h4.1 h4.2.1 (ZMod.val_lt _)
    h4.2.2.1 (t.upd 0 (ints ys ++ R)) ys Bb R hy.1 hy.2 (vol_pos_of hposC) hQ1 (vol_pos_of hposA)
    (by rw [hvol]; exact hV) hQ2 (by simp)
  rw [IState.upd_upd_same, inv_val_inv h4.2.2.2, neg_neg] at H
  have HR := RS.code_runs (I := I) (iprog := iprog) _ _ H.1
  rw [H.2.1] at HR
  have hcode : (scodeU2 Λ (.shift i u c) : IStmt HS Pp) =
      (shNDiv Q ((-u)⁻¹).val (AModel.vol A) (AModel.vol C) (A.zip (csOf Λ c A))).code := by
    simp only [scodeU2, if_neg h1, if_neg h3]; rfl
  rw [hcode]
  exact HR.mono (le_trans H.2.2 hcost)

/-- **Step runner, coefficients `±1, ±k, ±k⁻¹` (`2 ≤ k ≤ 20`, `k` prime to `Q`).** Every shift
reads only earlier fields; every interchange is a call of a correct child. The compiled code
computes `runArr`, cost `Σ cShiftU + Σ (child + 2) + 1`. -/
theorem runCodeU2_spec [NeZero Q] (jOf : Fin n → Fin n → Fin Pp)
    (child : Fin n → Fin n → List ℤ → List ℤ) (hpos : ∀ a ∈ sh, 1 ≤ a) (t : IState HS)
    (R : List Item) (Bb : ℕ) (hV : zsz ((AModel.vol sh : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (cC : Fin n → Fin n → ℕ) (steps : List (Step n Q))
    (hS : ∀ i u c, Step.shift i u c ∈ steps → SmallUnit2 Q u ∧ ∀ j, i ≤ j → c j = 0)
    (hC : ∀ a b, Step.swap a b ∈ steps → ∀ ys, DOK sh Bb ys →
      IRuns I iprog (iprog (jOf a b)) (t.upd 0 (ints ys ++ R))
        (t.upd 0 (ints (child a b ys) ++ R)) (cC a b) ∧
      child a b ys = (Step.swap a b).arr Λ 0 ys)
    (xs : List ℤ) (hx : DOK sh Bb xs) :
    IRuns I iprog (runCode (scodeU2 Λ) jOf steps) (t.upd 0 (ints xs ++ R))
      (t.upd 0 (ints (AModel.runArr Λ 0 steps xs) ++ R))
      (runCostI (cShiftU sh.length (AModel.vol sh) Bb) cC steps) := by
  refine runCode_runArr Λ (scodeU2 Λ) jOf child t R Bb _ cC steps ?_ hC xs hx
  intro i u c h ys hy
  obtain ⟨hu, hc⟩ := hS i u c h
  exact shiftU2_runs Λ hpos t R Bb hV hQ2 i u hu c hc ys hy

end RunU2

end NLogN.KIL

end

section
-- Source module: Solutions.KIL2Level
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul AModel AModelL12

section Runner

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}

/-- **Step runner for well-formed steps with small unit coefficients.** -/
theorem runCodeWF_spec [NeZero Q] (jOf : Fin n → Fin n → Fin Pp)
    (child : Fin n → Fin n → List ℤ → List ℤ) (hpos : ∀ a ∈ sh, 1 ≤ a) (t : IState HS)
    (R : List Item) (Bb : ℕ) (hV : zsz ((AModel.vol sh : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (cC : Fin n → Fin n → ℕ) (steps : List (Step n Q))
    (hW : ∀ s ∈ steps, s.WF)
    (hU : ∀ i u c, Step.shift i u c ∈ steps → SmallUnit2 Q u)
    (hC : ∀ a b, Step.swap a b ∈ steps → ∀ ys, DOK sh Bb ys →
      IRuns I iprog (iprog (jOf a b)) (t.upd 0 (ints ys ++ R))
        (t.upd 0 (ints (child a b ys) ++ R)) (cC a b) ∧
      child a b ys = (Step.swap a b).arr Λ 0 ys)
    (xs : List ℤ) (hx : DOK sh Bb xs) :
    IRuns I iprog (runCode (scodeU2 Λ) jOf steps) (t.upd 0 (ints xs ++ R))
      (t.upd 0 (ints (AModel.runArr Λ 0 steps xs) ++ R))
      (runCostI (cShiftU sh.length (AModel.vol sh) Bb) cC steps) :=
  runCodeU2_spec Λ jOf child hpos t R Bb hV hQ2 cC steps
    (fun i u c h => ⟨hU i u c h, (hW _ h).2⟩) hC xs hx

/-- Cost of a step list with constant child cost. -/
theorem runCostI_const (cS c0 : ℕ) (steps : List (Step n Q)) :
    runCostI cS (fun _ _ => c0) steps =
      steps.countP (fun s => !s.isSwap) * cS + steps.countP Step.isSwap * (c0 + 2) + 1 := by
  unfold runCostI
  congr 1
  induction steps with
  | nil => simp
  | cons s l ih =>
    rw [List.map_cons, List.sum_cons, ih, List.countP_cons, List.countP_cons]
    cases s <;> simp [stepCost, Step.isSwap] <;> ring

end Runner

