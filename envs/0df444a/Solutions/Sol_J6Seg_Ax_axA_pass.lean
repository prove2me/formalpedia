-- Source module: Solutions.J6SegILSlab7
/-!
# B-line IL, B1 (streaming slab pass) §7: the passes on plain register states

* **`passZ_runs`** (integer lane): from `encK s F` with `F 0 = xs ++ l` and the skeleton inputs
  (`rC` the control list `flatC cs ++ RC`, `rACC` empty, the counts on `rNB rNC rM rTOT`, the
  `rptX` counters empty) the pass leaves `passOut … ++ l` on stack `0`, everything else as it was.
* **`passP_runs`** (pair lane): the same with `F 0 = xs.map fst ++ l`, `F rZ = xs.map snd ++ l₂`;
  stack `rZ` ends as `l₂`.
* `mem_slabPass`, `length_slabPass`: the entries and the length of a slab pass.
* `blockC_le`, `passC_le`: the cost bounds `blockC ≤ 20000 (L+1)(m+1)(cu+Ba+1)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

section runs
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {OkU : ℤ → Prop} {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop} {g : ℤ → ℤ → ℤ}
  {dr rd it bk : IStmt HS P} {cdr crd cit cbk : ℕ}

/-- **The pass on the integer lane.** -/
theorem passZ_runs
    (H : UnitsOK (I := I) (iprog := iprog) linZ OkU OkA KG g dr rd it bk cdr crd cit cbk)
    (s : IState HS) (F : Fin HS → List ℤ) (xs l : List ℤ) (hF0 : F 0 = xs ++ l)
    (hK : ∀ C CU OP ARG ACC, KG (skS (update F 0 l) C CU OP ARG ACC))
    (hA : F lA = []) (hC : F lC = []) (hD : F lD = []) (cs : List (ℤ × ℤ)) (RC : List ℤ)
    (hFC : F rC = flatC cs ++ RC) (hACC : F rACC = [])
    {m : ℕ} {LM : List ℤ} (hM : F rM = (m : ℤ) :: LM) {LN : List ℤ}
    (hN : F rNC = (cs.length : ℤ) :: LN) {Ba : ℕ} (hcs : CmdsOK OkA Ba cs) (n : ℕ)
    (hV : VC n cs 0) (hND : nDrop cs = n) (pre : ℕ) {LB : List ℤ}
    (hB : F rNB = (pre : ℤ) :: LB) (hxs : xs.length = pre * (n * m)) (hok : ∀ u ∈ xs, OkU u)
    {LT : List ℤ} (hT : F rTOT = ((passOut m g cs n pre xs).length : ℤ) :: LT) {Bo : ℕ}
    (hBo : ∀ y ∈ passOut m g cs n pre xs, zsz y ≤ Bo) :
    IRuns I iprog (passP dr rd it bk) (encK s F)
      (encK s (update F 0 (passOut m g cs n pre xs ++ l)))
      (passC pre cs.length m Ba (cdr + crd + cit + cbk) (passOut m g cs n pre xs).length Bo) := by
  set G := update F 0 l with hG
  have hGx : ∀ j : Fin HS, j ≠ 0 → G j = F j := fun j hj => update_of_ne hj _ _
  have h := pass_runs H s G hK (by rw [hGx _ (by decide)]; exact hA)
    (by rw [hGx _ (by decide)]; exact hC) (by rw [hGx _ (by decide)]; exact hD)
    (by rw [hGx _ (by decide)]; exact hM) cs (by rw [hGx _ (by decide)]; exact hN) hcs n hV hND
    pre (by rw [hGx _ (by decide)]; exact hB) xs hxs hok (by rw [hGx _ (by decide)]; exact hT)
    hBo RC (F rCU) (F rOP) (F rARG)
  have e1 : linZ xs [] (skS G (flatC cs ++ RC) (F rCU) (F rOP) (F rARG) []) = F := by
    rw [← hFC, ← hACC]
    funext x; simp only [linZ, skS, hG, update_apply]; split_ifs <;> simp_all +decide
  have e2 : skS (update G 0 (passOut m g cs n pre xs ++ G 0)) (flatC cs ++ RC) (F rCU) (F rOP)
      (F rARG) [] = update F 0 (passOut m g cs n pre xs ++ l) := by
    rw [← hFC, ← hACC]
    funext x; simp only [skS, hG, update_apply]; split_ifs <;> simp_all +decide
  rw [e1, e2] at h
  exact h

end runs

/-! ## Entries and length of a slab pass -/

section mem
variable {α β : Type*} [Inhabited α] [Inhabited β]

theorem mem_slabPass {n n' post pre : ℕ} (hnp : 0 < n * post) {src : ℕ → Option ℕ}
    {h : ℕ → α → β} {L : List α} (hL : L.length = pre * (n * post)) {y : β}
    (hy : y ∈ slabPass n n' post src h L) : y = default ∨ ∃ l, ∃ x ∈ L, y = h l x := by
  unfold slabPass at hy
  rw [(J6Seg.chunk_blocks (n * post) pre hnp L hL).1] at hy
  simp only [List.mem_flatMap, List.mem_map, List.mem_range] at hy
  obtain ⟨B, ⟨i, hi, rfl⟩, l, hl, hyB⟩ := hy
  unfold slabOf at hyB
  cases hs : src l with
  | none => rw [hs] at hyB; left; exact List.eq_of_mem_replicate hyB
  | some k =>
    rw [hs] at hyB
    obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hyB
    right
    exact ⟨l, x, List.mem_of_mem_drop (List.mem_of_mem_take (List.mem_of_mem_drop
      (List.mem_of_mem_take hx))), rfl⟩

theorem length_slabPass {n n' post pre : ℕ} (hnp : 0 < n * post) {src : ℕ → Option ℕ}
    (hs : MonoSrc n n' src) (h : ℕ → α → β) {L : List α} (hL : L.length = pre * (n * post)) :
    (slabPass n n' post src h L).length = pre * (n' * post) := by
  unfold slabPass
  rw [(J6Seg.chunk_blocks (n * post) pre hnp L hL).1, List.flatMap_map]
  have hb : ∀ i ∈ List.range pre, ((List.range n').flatMap fun l =>
      slabOf ((L.drop (i * (n * post))).take (n * post)) post (src l) (h l)).length = n' * post := by
    intro i hi
    rw [List.mem_range] at hi
    have hBl : ((L.drop (i * (n * post))).take (n * post)).length = n * post := by
      simp only [List.length_take, List.length_drop, hL]
      have : (i + 1) * (n * post) ≤ pre * (n * post) := Nat.mul_le_mul_right _ (by omega)
      rw [Nat.add_mul, one_mul] at this
      omega
    rw [List.length_flatMap]
    have : ∀ l ∈ List.range n', (slabOf ((L.drop (i * (n * post))).take (n * post)) post (src l)
        (h l)).length = post := by
      intro l hl
      rw [List.mem_range] at hl
      unfold slabOf
      cases hsl : src l with
      | none => simp
      | some k =>
        have hk := hs.1 l hl k hsl
        have : (k + 1) * post ≤ n * post := Nat.mul_le_mul_right _ hk
        rw [Nat.add_mul, one_mul] at this
        simp only [List.length_map, List.length_take, List.length_drop, hBl]
        omega
    rw [List.map_congr_left this]
    simp [List.sum_replicate]
  rw [List.length_flatMap, List.map_congr_left hb]
  simp [List.sum_replicate]

end mem

