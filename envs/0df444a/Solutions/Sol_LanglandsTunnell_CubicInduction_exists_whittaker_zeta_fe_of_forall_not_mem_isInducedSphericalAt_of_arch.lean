variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem valued_diagonal_entries_le_one {u : (v.adicCompletion ℚ)ˣ}
    (hu : (u : v.adicCompletion ℚ) ∈ v.adicCompletionIntegers ℚ) (i j : Fin 3) :
    Valued.v (Matrix.diagonal ![(u : v.adicCompletion ℚ), 1, 1] i j) ≤ 1 := by
  have hdiag : ∀ k : Fin 3, Valued.v ((![(u : v.adicCompletion ℚ), 1, 1] : Fin 3 → v.adicCompletion ℚ) k) ≤ 1 := by
    intro k
    fin_cases k
    · exact (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp hu
    · simp
    · simp
  rw [Matrix.diagonal_apply]
  split_ifs
  · exact hdiag i
  · rw [map_zero]
    exact zero_le'

private theorem iotaGL_diagUnitGL2_mem_localMaximalCompact3 {u : (v.adicCompletion ℚ)ˣ} (hu : IsIntegralUnit v u) :
    iotaGL (diagUnitGL2 u) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := by
  rw [mem_localMaximalCompact3_iff, iotaGL_diagUnitGL2_inv, coe_iotaGL_diagUnitGL2, coe_iotaGL_diagUnitGL2]
  exact ⟨valued_diagonal_entries_le_one v hu.1, valued_diagonal_entries_le_one v hu.2⟩

end

section

variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem absNorm_asIdeal_eq_natGenerator : Ideal.absNorm v.asIdeal = Rat.HeightOneSpectrum.natGenerator v := by
  rw [RatIdele.asIdeal_eq_span_natGenerator, Ideal.absNorm_span_singleton, Algebra.norm_natCast,
    NumberField.RingOfIntegers.rank]
  simp

private theorem valued_ratPrimeAt : Valued.v (ratPrimeAt v) = WithZero.exp (-1 : ℤ) := by
  unfold ratPrimeAt
  rw [absNorm_asIdeal_eq_natGenerator, ← map_natCast (algebraMap ℚ (v.adicCompletion ℚ)),
    RatIdele.valued_algebraMap_rat, RatIdele.valuation_natGenerator]

private theorem valued_ratPrimeUnit : Valued.v ((ratPrimeUnit v : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) =
    WithZero.exp (-1 : ℤ) :=
  valued_ratPrimeAt v

end

section

variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem exists_isIntegralUnit_and_eq_zpow_mul {π t : (v.adicCompletion ℚ)ˣ}
    (hπ : Valued.v (π : v.adicCompletion ℚ) = WithZero.exp (-1 : ℤ)) {m : ℤ}
    (ht : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-m)) :
    ∃ u : (v.adicCompletion ℚ)ˣ, IsIntegralUnit v u ∧ t = π ^ m * u := by
  refine ⟨π ^ (-m) * t, isIntegralUnit_of_valued_eq_one ?_, ?_⟩
  · rw [Units.val_mul, Units.val_zpow_eq_zpow_val, map_mul, map_zpow₀, hπ, ht, ← WithZero.exp_zsmul,
      ← WithZero.exp_add, ← WithZero.exp_zero]
    congr 1
    simp
  · rw [zpow_neg, mul_inv_cancel_left]

private theorem exists_mem_localMaximalCompact3_and_iotaGL_diagUnitGL2_eq {π t : (v.adicCompletion ℚ)ˣ}
    (hπ : Valued.v (π : v.adicCompletion ℚ) = WithZero.exp (-1 : ℤ)) {m : ℤ}
    (ht : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-m)) :
    ∃ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, iotaGL (diagUnitGL2 t) = iotaGL (diagUnitGL2 (π ^ m)) * k := by
  obtain ⟨u, hu, rfl⟩ := exists_isIntegralUnit_and_eq_zpow_mul v hπ ht
  exact ⟨iotaGL (diagUnitGL2 u), iotaGL_diagUnitGL2_mem_localMaximalCompact3 v hu, iotaGL_diagUnitGL2_mul _ _⟩

private theorem iotaGL_diagUnitGL2_ratPrimeUnit_zpow_natCast (n : ℕ) :
    iotaGL (diagUnitGL2 (ratPrimeUnit v ^ (n : ℤ))) = iotaTorusLocal v n :=
  congrArg (fun x : (v.adicCompletion ℚ)ˣ => iotaGL (diagUnitGL2 x)) (zpow_natCast (ratPrimeUnit v) n)

private theorem exists_mem_localMaximalCompact3_and_eq_iotaTorusLocal_mul {t : (v.adicCompletion ℚ)ˣ}
    {n : ℕ} (ht : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-(n : ℤ))) :
    ∃ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, iotaGL (diagUnitGL2 t) = iotaTorusLocal v n * k := by
  obtain ⟨k, hk, hk'⟩ := exists_mem_localMaximalCompact3_and_iotaGL_diagUnitGL2_eq v (valued_ratPrimeUnit v) ht
  exact ⟨k, hk, by rw [hk', iotaGL_diagUnitGL2_ratPrimeUnit_zpow_natCast]⟩

private theorem apply_iotaGL_diagUnitGL2_eq_apply_iotaTorusLocal {W : LocalGL3 v → ℂ}
    (hW : ∀ x : LocalGL3 v, ∀ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, W (x * k) = W x) {t : (v.adicCompletion ℚ)ˣ}
    {n : ℕ} (ht : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-(n : ℤ))) :
    W (iotaGL (diagUnitGL2 t)) = W (iotaTorusLocal v n) := by
  obtain ⟨k, hk, hk'⟩ := exists_mem_localMaximalCompact3_and_eq_iotaTorusLocal_mul v ht
  rw [hk']
  exact hW _ k hk

end

