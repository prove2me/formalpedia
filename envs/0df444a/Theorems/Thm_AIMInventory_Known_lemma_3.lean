-- url     : https://prove2.me/theorems/097d41b8-0148-4c3a-b18d-55ae8c9b0671
-- title:
--   Lemma 3 — projected stochastic subgradient descent with ϵ_t = γ diam(S)/(B̄√t) has E[(1/T)ΣΦ(w_t)] − Φ(u) ≤ (γ + 1/γ) diam(S) B̄/√T
-- statement:
--   Let $S \subseteq \mathbb R^n$ be compact and convex, and let $\Phi$ be convex on $S$ with a subgradient $g(z)$ at every $z \in S$:
--   $$\Phi(u) \ge \Phi(z) + \langle g(z), u - z\rangle \qquad \text{for all } z,u \in S.$$
--   Fix $\gamma > 0$, $\bar B > 0$, $w_1 \in S$, and random vectors $H_1, H_2, \dots$ on a probability space. Let $w_1, w_2, \dots$ be the projected iterates
--   $$w_{t+1} = P_S(w_t - \epsilon_t H_t), \qquad \epsilon_t = \frac{\gamma\,\operatorname{diam}(S)}{\bar B\sqrt t}.$$
--   Suppose that for every $t \ge 1$, $\|H_t\| \le \bar B$ almost surely and
--   $$E[H_t \mid w_t] = g(w_t) \quad \text{almost surely}.$$
--   Then for every $T \ge 1$ and every $u \in S$,
--   $$E\Big[\frac1T \sum_{t=1}^T \Phi(w_t)\Big] - \Phi(u) \le \Big(\gamma + \frac1\gamma\Big)\frac{\operatorname{diam}(S)\,\bar B}{\sqrt T}.$$
--
--   This is Zinkevich's online gradient bound with stochastic subgradients and the anytime step $\gamma\operatorname{diam}(S)/(\bar B\sqrt t)$. Applied to $\Phi = Q$ on $S = [0,\bar y]$ it bounds the cost of the AIM targets $\hat y_t$, which is the whole perishable case of Theorem 2.
--
--   **Formalization Note** The paper's $H(z)$ is a random vector indexed by $z$ with $E[H(z)\mid z] = g(z)$; here $H_t$ is the direction actually used at step $t$, and the hypothesis conditions it on the σ-algebra generated by the current iterate $w_t$, which is the conditioning the paper's proof uses. The $H_t$ are assumed measurable, so that this σ-algebra is a sub-σ-algebra and the conditional expectation is not a junk value. The conclusion is stated against every comparator $u \in S$; this implies the printed form with $w^* = \arg\min_S \Phi$ whenever the minimum exists, and avoids assuming it does. "$S \in \mathbb R^n$" in the paper is read as $S \subseteq \mathbb R^n$. $\bar B > 0$ is implicit in the step size.
-- source:
--   Huh & Rusmevichientong, A Non-Parametric Asymptotic Analysis of Inventory Planning with Censored Demand, Math. Oper. Res. (2009), author's manuscript, p. 8, Lemma 3 (proof in Appendix A, pp. 16–17)

import Mathlib
import Definitions.Def_AIMInventory_Known_SGD
open MeasureTheory
open scoped RealInnerProductSpace

namespace AIMInventory.Known

/-- Lemma 3, p. 8: projected stochastic subgradient descent on a compact convex `S ⊆ ℝⁿ` with
steps `ϵ_t = γ diam(S)/(B̄√t)` and conditionally unbiased, bounded subgradient estimates has
average expected suboptimality at most `(γ + 1/γ) diam(S) B̄ / √T` against every `u ∈ S`
(in particular against a minimizer `w*`). -/
theorem lemma_3 {n : ℕ} {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (S : Set (EuclideanSpace ℝ (Fin n))) (hS : IsCompact S) (hSconv : Convex ℝ S)
    (Φ : EuclideanSpace ℝ (Fin n) → ℝ) (hΦ : ConvexOn ℝ S Φ)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hg : ∀ z ∈ S, ∀ u ∈ S, Φ z + ⟪g z, u - z⟫ ≤ Φ u)
    (γ Bbar : ℝ) (hγ : 0 < γ) (hBbar : 0 < Bbar)
    (w1 : EuclideanSpace ℝ (Fin n)) (hw1 : w1 ∈ S)
    (H : ℕ → Ω → EuclideanSpace ℝ (Fin n))
    (hHmeas : ∀ t, Measurable (H t))
    (hHbound : ∀ t, 1 ≤ t → ∀ᵐ ω ∂μ, ‖H t ω‖ ≤ Bbar)
    (hHunbiased : ∀ t, 1 ≤ t →
      μ[H t | MeasurableSpace.comap (sgdIterate S γ Bbar w1 H t) inferInstance]
        =ᵐ[μ] fun ω => g (sgdIterate S γ Bbar w1 H t ω))
    (T : ℕ) (hT : 1 ≤ T) (u : EuclideanSpace ℝ (Fin n)) (hu : u ∈ S) :
    (∫ ω, (1 / (T : ℝ)) * ∑ t ∈ Finset.Icc 1 T, Φ (sgdIterate S γ Bbar w1 H t ω) ∂μ) - Φ u
      ≤ (γ + 1 / γ) * (Metric.diam S * Bbar / Real.sqrt T) := by sorry

end AIMInventory.Known
