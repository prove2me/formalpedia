    rw [List.map_map]
    conv_rhs => rw [← List.map_id l]
    exact List.map_congr_left fun u _ => hlift u
  have hcg : ∀ (l : List (Fin (2 ^ ℓ) → ℂ)) k, C.co ((l.map lift).getD k 0) = l.getD k 0 := by
    intro l k
    by_cases hk : k < l.length
    · rw [List.getD_eq_getElem _ _ (by simpa using hk), List.getD_eq_getElem _ _ hk,
        List.getElem_map, hlift]
    · rw [List.getD_eq_default _ _ (by simpa using hk), List.getD_eq_default _ _ (by omega),
        map_zero]
  obtain ⟨fR, hfR⟩ : ∃ l : List R, l = ((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xf).map lift := ⟨_, rfl⟩
  obtain ⟨gR, hgR⟩ : ∃ l : List R, l = ((pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xg).map lift := ⟨_, rfl⟩
  have hfm : fR.map C.co = (pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xf := by rw [hfR, hcm]
  have hgm : gR.map C.co = (pull (binSh (tgtL D ℓ K long).length) (binSh (tgtL D ℓ K long).length) (relabel (initL D ℓ long) (tgtL D ℓ K long)) (0 : Fin (2 ^ ℓ) → ℂ)) xg := by rw [hgR, hcm]
  have hfl : fR.length = vol (binSh (tgtL D ℓ K long).length) := by rw [hfR, List.length_map, length_pull]
  have hgl : gR.length = vol (binSh (tgtL D ℓ K long).length) := by rw [hgR, List.length_map, length_pull]
