section
-- Source module: Solutions.NetProp7Circuit
/-!
# Prop. 7, part 6: the rational interface as a `QCircuit`

Reindex the wires `Wr ind ≃ Fin W` (`W = |Wr ind|`) and the label space
`Fin h × Fin h × Fin h ≃ Fin (h ^ 3)` (`m = h³`) to obtain `bitQC ind : QCircuit (ZMod 2) m W`.
`prop7_interface`: every gate is OK, the scalar circuit routes `w ↦ ρ w`,
`M_sink(ρ w) − M_source(w) = 1`, and the rational rank sum is `W m − N + 2L`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option synthInstance.maxSize 512

namespace NetProp7

open Matrix Finset AModel NetScalar AModelRat AModelFac

variable {h : ℕ}

/-- `Fin h × Fin h × Fin h ≃ Fin (h ^ 3)`. -/
def cubeEquiv (h : ℕ) : Cube h ≃ Fin (h ^ 3) :=
  ((Equiv.refl (Fin h)).prodCongr finProdFinEquiv).trans
    (finProdFinEquiv.trans (finCongr (by ring)))

/-- Reindexing of labels to `QMat (h ^ 3)`. -/
noncomputable def φC (h : ℕ) : Matrix (Cube h) (Cube h) ℚ →+ QMat (h ^ 3) :=
  (Matrix.reindexLinearEquiv ℚ ℚ (cubeEquiv h) (cubeEquiv h)).toLinearMap.toAddMonoidHom

variable {T : Type*} [Fintype T] [DecidableEq T] (ind : T → Finset (Fin h))

/-- The wire equivalence. -/
noncomputable def eW : NetScalar.Wr ind ≃ Fin (Fintype.card (NetScalar.Wr ind)) := Fintype.equivFin _

/-- **The bit network of Prop. 7 as a circuit with rational labels.** -/
noncomputable def bitQC : QCircuit (ZMod 2) (h ^ 3) (Fintype.card (NetScalar.Wr ind)) where
  gates := (gatesL ind).map (trG (NetProp7.eW ind) (φC h))
  Min w := φC h (MinL ind ((NetProp7.eW ind).symm w))
  Mout w := φC h (MoutL ind ((NetProp7.eW ind).symm w))
  ρ w := NetProp7.eW ind (NetScalar.ρ ind ((NetProp7.eW ind).symm w))

variable (hcard : ∀ t, (ind t).card = 3) (hinj : Function.Injective ind)
include hcard hinj

end NetProp7

