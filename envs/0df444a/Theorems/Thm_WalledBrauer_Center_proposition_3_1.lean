-- title:
--   Proposition 3.1 — $p_k(L_1,\dots,L_{r+s})$ acts on $C_{r,s}(\lambda)$ by a content power sum
-- statement:
--   Let $\lambda=(\lambda^L,\lambda^R)\in\Lambda^t_{r,s}$ and $k\ge0$. On the cell module $C_{r,s}(\lambda)$ the central element $p_k(L_1,\dots,L_{r+s})=L_1^k+\dots+L_r^k+(-1)^{k+1}(L_{r+1}^k+\dots+L_{r+s}^k)$ acts by the scalar
--
--   $$
--   \sum_{i=1}^{r-t}\operatorname{cont}(\lambda^L,i)^k+(-1)^{k+1}\sum_{i=1}^{s-t}\bigl(\operatorname{cont}(\lambda^R,i)+\delta\bigr)^k ,
--   $$
--
--   where $\operatorname{cont}(\mu,i)$ is the content of the box with entry $i$ in the row-reading tableau of $\mu$. This computes the central character of every cell module on the generators of the supersymmetric polynomials.
--
--   **Formalization Note** The cell module is the published `CellModule δ λ` (the submodule of $B_{r,s}(\delta)/J_{t+1}$ generated by the class of $X_t\,y_\lambda$, characteristic $0$), and "acts by the scalar" is the identity `jmPowerSum δ k • v = c • v` for every vector `v`. Indices of contents are 0-based (`cont μ i` is $\operatorname{cont}(\mu,i+1)$). The platform's product is the opposite of the paper's; the up–down flip carries the paper's cell module to the published one, and central elements act by the same scalars.
-- source:
--   Jung–Kim, Supersymmetric polynomials and the center of the walled Brauer algebra, arXiv:1508.06469v2, p. 14, Proposition 3.1

import Mathlib
import Definitions.Def_WalledBrauer_Center_Setting

namespace WalledBrauer.Center
open WalledBrauer.Blocks MvPolynomial

theorem proposition_3_1 (r s : ℕ) (δ : ℂ) (x : CellIndex r s) (k : ℕ)
    (v : CellModule δ x) :
    jmPowerSum (r := r) (s := s) δ k • v =
      ((∑ i : Fin (r - x.t), ((cont x.L i.val : ℤ) : ℂ) ^ k) +
        (-1) ^ (k + 1) * ∑ i : Fin (s - x.t), (((cont x.R i.val : ℤ) : ℂ) + δ) ^ k) • v := by sorry
end WalledBrauer.Center
