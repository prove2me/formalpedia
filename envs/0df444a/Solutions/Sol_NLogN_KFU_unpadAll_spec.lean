        10 ^ 4 * (w + 1) * (2 * AModel.vol T + 1) := Nat.mul_le_mul_left _ (by omega)
    unfold NLogN.KFU.cScan at *
    nlinarith

theorem solution (S T : AModel.Shape) (hF : List.Forall₂ (· ≤ ·) S T) (hS : ∀ a ∈ S, 1 ≤ a)
    (w : ℕ) (ys : List ℤ) (hys : ys.length = AModel.vol T) (hb : NLogN.Bnd w ys) (s : NLogN.IState NLogN.HS)
    (R : List NLogN.Item) (h0 : s.G 0 = NLogN.ints ys ++ R) :
    ∀ k ≤ S.length, NLogN.IRuns I iprog (NLogN.KFU.unpadAllC S T k) s
      (s.upd 0 (NLogN.ints (AModelL12.extract (S.take k ++ T.drop k) T 0 ys) ++ R)) (k * NLogN.KFU.cScan (AModel.vol T) w + 1) := by
