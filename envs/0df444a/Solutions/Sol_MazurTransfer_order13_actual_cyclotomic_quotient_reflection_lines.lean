theorem piReflection_mem_character_kernel (r : ReflectionParameter K)
    (a : Additive (Kernel K schemePi)) :
    piKernelReflection K r a ∈ LinearMap.ker (kernelCharacterLinear K schemePi schemePiConjugate a) := by
  change kernelCharacterLinear K schemePi schemePiConjugate a (piKernelReflection K r a) = 0
  apply Additive.toMul.injective
  apply Subtype.ext
  change actualGeometricNineteenPairing K (kernelNineteenAddHom K schemePi a)
    (kernelNineteenAddHom K schemePiConjugate (piKernelReflection K r a)) = 1
  rw [piKernelReflection_embed]
  exact MazurTransfer.order13_actual_pairing_self_reflection K r _

theorem piConjugateReflection_mem_character_kernel (r : ReflectionParameter K)
    (a : Additive (Kernel K schemePiConjugate)) :
    piConjugateKernelReflection K r a ∈ LinearMap.ker
      (kernelCharacterLinear K schemePiConjugate schemePi a) := by
  change kernelCharacterLinear K schemePiConjugate schemePi a (piConjugateKernelReflection K r a) = 0
  apply Additive.toMul.injective
  apply Subtype.ext
  change actualGeometricNineteenPairing K (kernelNineteenAddHom K schemePiConjugate a)
    (kernelNineteenAddHom K schemePi (piConjugateKernelReflection K r a)) = 1
  rw [piConjugateKernelReflection_embed]
