theorem expNegBody_ok (n k j : ℕ) (s : IState HS) (L16 L17 L18 : List Item)
    (h16 : s.G 16 = .int n :: L16) (h17 : s.G 17 = .int k :: L17)
    (h18 : s.G 18 = .int j :: L18) : expNegBody.ok s := by
  have e10 : ((n : ℤ) + n + 10).toNat = 2 * n + 10 := by omega
  simp (config := {decide := true}) only [expNegBody, seqL, run_seq, RS.ok]
  rw [piP_run' _ (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])
    (by simp (config := {decide := true}) [IState.top, Ex.eval, m10E, h16]; positivity)]
  rw [expNegFixP_run' _ (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])
    (by simp (config := {decide := true}) [IState.top, Ex.eval, h16])
    (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])
    (by simp (config := {decide := true}) [IState.top, Ex.eval, m10E, h16]; positivity)
    (by simp (config := {decide := true}) [IState.IsInt, IState.top, h16])]
  simp (config := {decide := true}) [RS.run_push_G, RS.run_pop_G, IState.upd_G, Ex.eval,
    IState.top, IState.IsInt, h16, h17, h18, Ex.ok, Ex.Clean, Ex.regs, zX_all, m10E, xNegE]
  repeat' (first
    | apply piP_ok'
    | apply expNegFixP_ok'
    | apply Ex.ediv_ok
    | apply And.intro)
  all_goals simp (config := {decide := true}) [RS.run_push_G, RS.run_pop_G, IState.upd_G, Ex.eval,
    IState.top, IState.IsInt, h16, h17, h18, Ex.ok, m10E]
  all_goals positivity

theorem expNegP_spec (n k j : ℕ) (s : IState HS) (L16 L17 L18 : List Item)
    (h16 : s.G 16 = .int n :: L16) (h17 : s.G 17 = .int k :: L17)
    (h18 : s.G 18 = .int j :: L18) :
    expNegP.ok s ∧ expNegP.run s = s.upd 19 (.int (expNeg n k j) :: s.G 19) := by
  have hc : (Ex.add (.mul (.reg 17) (.reg 16)) (.neg (.reg 18)) : Ex HS).eval s =
      (k : ℤ) * n - j := by
    simp (config := {decide := true}) [Ex.eval, IState.top, h16, h17, h18]; ring
  by_cases hkj : k * n < j
  · have hlt : (k : ℤ) * n - j < 0 := by
      have : ((k * n : ℕ) : ℤ) < j := by exact_mod_cast hkj
      push_cast at this; linarith
    refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
    · simp (config := {decide := true}) [Ex.Clean, Ex.regs, zX_all]
    · simp (config := {decide := true}) [Ex.ok, IState.IsInt, IState.top, h16, h17, h18]
    · rw [hc, if_pos hlt]; exact ⟨by decide, by simp [Ex.Clean, Ex.regs], trivial⟩
    · simp only [expNegP, RS.run, hc, if_pos hlt, expNeg, if_pos hkj]; rfl
  · have hlt : ¬ ((k : ℤ) * n - j < 0) := by
      have : ¬ (((k * n : ℕ) : ℤ) < j) := by exact_mod_cast hkj
      push_cast at this; linarith
    refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
    · simp (config := {decide := true}) [Ex.Clean, Ex.regs, zX_all]
    · simp (config := {decide := true}) [Ex.ok, IState.IsInt, IState.top, h16, h17, h18]
    · rw [hc, if_neg hlt]; exact expNegBody_ok n k j s L16 L17 L18 h16 h17 h18
    · simp only [expNegP, RS.run, hc, if_neg hlt, expNeg, if_neg hkj]
      exact expNegBody_run n k j s L16 L17 L18 h16 h17 h18

