-- Source module: Solutions.J6AILTab9
/-!
# A lines, table set-up, part 9: the core program (fixed layout)

`coreUp = initP rg; parA; phase; tabLoop; finiP rg`.
**`sp_core`**: from a state with the descriptor on `31` and every other stack empty it leaves
the `kerRegs` values `ρ 0 … ρ 8` as the list `vsA …` on `45`, `[|T|]` on `42` and `T.reverse`
on `43` (`coreOut`), every other stack unchanged — the input of B5's `distAll` after one move.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

/-- The register file of the `A` kernel pass, from the line parameters. -/
def kerV (p s t α pk b pre post : ℕ) : Fin 19 → List ℤ :=
  kerRegs (p + 2) (pk + 1) (Nat.log 2 (sWidth p α) + 3) pre (ncA p t α) post
    (tabsT (aTab6 p s t α pk b) (ncA p t α))

/-- The table of the `A` kernel pass. -/
abbrev tabA (p s t α pk b : ℕ) : List ℤ := tabsT (aTab6 p s t α pk b) (ncA p t α)

/-- The nine scalar values of `kerRegs`. -/
def vsA (w w' f pre nc post : ℕ) : List ℤ :=
  [(w : ℤ), (w' : ℤ), (f : ℤ), ((pre * nc : ℕ) : ℤ), (post : ℤ), (pre : ℤ), (nc : ℤ),
    ((2 * 2 ^ f : ℕ) : ℤ), ((2 * (pre * nc * post * 2 ^ f) : ℕ) : ℤ)]

/-- The stacks after the core program. -/
def coreOut (F : Fin HS → List ℤ) (vs T : List ℤ) : Fin HS → List ℤ :=
  update (update (update F 45 vs) 42 [(T.length : ℤ)]) 43 T.reverse

/-- **The core program.** -/
def coreUp (pkA pkC bA bC : ℕ) : RS :=
  .seq (initP rg) (.seq J6A.PA.parA (.seq (phase pkA pkC bA bC) (.seq tabLoop (finiP rg))))

/-- The cost of the core program. -/
def cCore (W p t α pkA pkC bA bC : ℕ) : ℕ :=
  (21 * 8001 + 1) + (J6A.PA.cParA W p (sWidth p α) + (cPhase W p α pkA pkC bA bC +
    (cFor W (ncA p t α) (cBlock W p α) + (21 * (2 * (W + 1) + 2) + 1))))

end J6Seg.ATab

end

