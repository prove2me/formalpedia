theorem combC_runs (sub : Bool) (s : IState HS) (u v : ℤ) (Δ : ℕ) (L1 L2 LR : List Item)
    (h1 : s.G pP1 = .int u :: L1) (h2 : s.G pP2 = .int v :: L2)
