where
  srcFrom_prefix (src : ℕ → Option ℕ) (n : ℕ) :
      ∀ (a : List ℕ) (b : List ℕ) (cur : ℕ), J6Seg.SrcFrom src n (a ++ b) cur → J6Seg.SrcFrom src n a cur
    | [], _, _, _ => trivial
    | l :: a, b, cur, h => by
      simp only [List.cons_append, J6Seg.SrcFrom] at h ⊢
      cases hs : src l with
      | none => simp only [hs] at h ⊢; exact srcFrom_prefix src n a b cur h
      | some k =>
        simp only [hs] at h ⊢
        exact ⟨h.1, h.2.1, srcFrom_prefix src n a b k h.2.2⟩

