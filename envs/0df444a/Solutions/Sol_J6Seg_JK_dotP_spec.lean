* `MSp.repS`: the counted loop through managed states with an iteration-dependent body cost
  (`∑ k < N, c k`);
* `dotP_spec`: `dotP X` adds `dotF P cs acc` to `SUM`, consumes `|cs|` table entries onto `TT`
  and restores `X`, at cost `(|cs| + 1) · uC`;
* the a-priori bounds of the fixed-point dot products (`fmul_abs_lt`, `dotF_take_abs_le`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

/-! ## Loops with varying bodies -/

/-! ## The dot loop as a whole -/

section dot
variable {P : ℕ} {F : Fin HS → List ℤ} {X : Fin HS} {cs acc R T0 : List ℤ} {S0 : ℤ} {Ls : List ℤ}

theorem bnd_getElem {B : ℕ} {l : List ℤ} (h : Bnd B l) (i : ℕ) (hi : i < l.length) :
    zsz l[i] ≤ B := h _ (List.getElem_mem hi)

theorem dotP_spec_sol_aux {M : MulSpec} {Xb Φm Bx Bc : ℕ} (hMB : MulBnd M Xb Φm) (hX : XOK X)
    (s : IState HS) {lp lp1 Lc : List ℤ} (hPX : F PX = []) (hrP : F rP = 2 ^ P :: lp)
    (hrP1 : F rP1 = 2 ^ (P + 1) :: lp1) (hCD : F CD = []) (hTMP : F TMP = [])
    (hT : F dTJ = cs ++ R) (hTT : F TT = T0) (hXa : F X = acc) (hS : F SUM = S0 :: Ls)
    (hCNT : F CNT = (cs.length : ℤ) :: Lc)
    (hca : cs.length ≤ acc.length) (hcB : Bnd Xb cs) (haB : Bnd Xb acc)
    (hXB : 2 * Xb + 3 ≤ Bx) (hPB : P + 3 ≤ Bx) (hcl : zsz (cs.length : ℤ) ≤ Bc) (hBc : Bc ≤ Bx)
    (hSk : ∀ k ≤ cs.length, zsz (S0 + dotF P (cs.take k) acc) ≤ Bx) :
    MSp M (dotP X) (encK s F)
      (encK s (update (update (update F dTJ R) TT (cs.reverse ++ T0)) SUM
        ((S0 + dotF P cs acc) :: Ls)))
      ((cs.length + 1) * uC Φm Bx Bc) := by
  have hX' := hX
  obtain ⟨hX5, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10⟩ := hX'
  have hs1 := Ne.symm h1; have hs2 := Ne.symm h2; have hs3 := Ne.symm h3; have hs4 := Ne.symm h4
  have hs5 := Ne.symm h5; have hs6 := Ne.symm h6; have hs7 := Ne.symm h7; have hs8 := Ne.symm h8
  have e0 : dSt P F X cs acc R T0 S0 Ls 0 = F := by
    funext j
    simp only [dSt, update_apply]
    by_cases j1 : j = SUM
    · subst j1; simp [hS, dotF_take_zero, dotF_nil]
    by_cases j2 : j = TMP
    · subst j2; simp +decide [hTMP]
    by_cases j3 : j = X
    · subst j3; simp +decide [h3, h4, hXa]
    by_cases j4 : j = TT
    · subst j4; simp +decide [hs2, hTT]
    by_cases j5 : j = dTJ
    · subst j5; simp +decide [hs1, hT]
    simp [j1, j2, j3, j4, j5]
  have hCDk : ∀ k, dSt P F X cs acc R T0 S0 Ls k CD = [] := fun k => by
    simp +decide [dSt, update_apply, hs6, hCD]
  have hCNTk : ∀ k, dSt P F X cs acc R T0 S0 Ls k CNT = (cs.length : ℤ) :: Lc := fun k => by
    simp +decide [dSt, update_apply, hs8, hCNT]
  have hw : CD ∉ (kD X).writes := by
    simp +decide [kD, RM.writes, RS.writes, hs6]
  have hcnt : (Ex.reg (S := HS) CNT).eval (encK s F) = cs.length := by
    simp [Ex.eval, top_encK hCNT]
  have hloop := MSp.repS (M := M) (C := CD) (n := .reg CNT) (b := kD X) (s := s)
    (F := fun k => dSt P F X cs acc R T0 S0 Ls k) (N := cs.length) (B := Bc)
    (c := fun _ => Φm + 10 ^ 5 * (Bx + 2)) (by decide) hCDk hw (RS.clean_of_lt (by decide))
    (by simp only [e0]; exact isInt_encK hCNT) (by simp only [e0, Ex.Bnd, top_encK hCNT]; exact hcl)
    (by simp only [e0]; exact hcnt) (fun k hk => by
      have hcB' := bnd_getElem hcB k hk
      have haB' := bnd_getElem haB k (by omega)
      exact dot_body hMB hX s hPX hrP hrP1 cs.length k hk hca hcB' haB' hXB hPB (hSk k hk.le)
        (hSk (k + 1) hk))
  simp only [e0] at hloop
  -- the accumulator back
  have hTm : dSt P F X cs acc R T0 S0 Ls cs.length TMP = (acc.take cs.length).reverse ++ [] := by
    simp +decide [dSt, update_apply]
  have hmv := Sp.mvK (X := TMP) (Y := X) (C := CM) h3.symm (by decide) h7 (by decide)
    (by omega) (by decide) s (dSt P F X cs acc R T0 S0 Ls cs.length) (.reg CNT)
    (RS.clean_of_lt (by decide)) (isInt_encK (hCNTk _)) _ _ hTm
    (by simp [Ex.eval, top_encK (hCNTk _)]; omega) Bx
    (fun a ha => le_trans (haB a (List.mem_of_mem_take (List.mem_reverse.1 ha))) (by omega))
    trivial (by simp only [Ex.Bnd, top_encK (hCNTk _)]; omega)
  have hall := hloop.seq (MSp.rs (M := M) hmv)
  refine (hall.congr ?_).mono ?_
  · congr 1
    funext j
    simp only [dSt, update_apply]
    by_cases j1 : j = X
    · subst j1; simp +decide [h1, h2, h3, h4, hXa]
    by_cases j2 : j = TMP
    · subst j2; simp +decide [hTMP, hs3]
    by_cases j3 : j = SUM
    · subst j3; simp +decide [List.take_length, hs4]
    by_cases j4 : j = TT
    · subst j4; simp +decide [List.take_length, hs2]
    by_cases j5 : j = dTJ
    · subst j5; simp +decide [hs1]
    simp [j1, j2, j3, j4, j5]
  · simp only [Ex.size, uC, List.length_reverse, List.length_take, sum_const, card_range,
      smul_eq_mul]
    have hc : min cs.length acc.length = cs.length := min_eq_left hca
    rw [hc]
    set c := cs.length
    set Y := (Bc + 2) ^ 2
    have hY : 4 ≤ Y := by
      have : 2 ≤ Bc + 2 := by omega
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ Y := Nat.pow_le_pow_left this 2
    have hcY : c ≤ c * Y := Nat.le_mul_of_pos_right _ (by omega)
    nlinarith

end dot

