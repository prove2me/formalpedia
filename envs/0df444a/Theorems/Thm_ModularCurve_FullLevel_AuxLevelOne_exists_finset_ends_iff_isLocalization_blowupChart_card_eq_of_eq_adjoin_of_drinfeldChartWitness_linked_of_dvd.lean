            {x : ↥K | ∃ i ∈ J, x * ((a : ↥(chartAlgFin A (↥K) j)) : ↥K) = ((i : ↥(chartAlgFin A (↥K) j)) : ↥K)}).restrictScalars A
          ∃ (P : Ideal ↥Ba) (_ : P.IsMaximal),
            (∀ f : ↥K, f ∈ O ↔ ∃ g h : ↥Ba, h ∉ P ∧ f * (h : ↥K) = (g : ↥K)) ∧
            (∀ b : ↥(chartAlgFin A (↥K) j), b ∈ y →
              ∀ hb : ((b : ↥(chartAlgFin A (↥K) j)) : ↥K) ∈ O, ¬ IsUnit (⟨((b : ↥(chartAlgFin A (↥K) j)) : ↥K), hb⟩ : ↥O)) ∧
            ¬ (∀ f : ↥K, f ∈ B → f ∈ O)) ∧
        ends.card = q + 1 ∧
        (∀ γ : SL(2, ℤ), γ ∈ CongruenceSubgroup.Gamma0 M' →
          ∀ τ : ↥K ≃ₐ[L] ↥K, ModularCurve.FullLevel.IsLevelAutAt L q ζ q (q ^ 2 * M') H₁ γ⁻¹ K τ →
            (∀ f : ↥K, f ∈ W ↔ τ f ∈ W) → ∀ O ∈ ends, ∃ O' ∈ ends, ∀ f : ↥K, f ∈ O ↔ τ f ∈ O') ∧
        (∀ O ∈ ends, ∀ O' ∈ ends, ∃ (γ : SL(2, ℤ)) (_ : γ ∈ CongruenceSubgroup.Gamma0 M') (τ : ↥K ≃ₐ[L] ↥K) (_ : ModularCurve.FullLevel.IsLevelAutAt L q ζ q (q ^ 2 * M') H₁ γ⁻¹ K τ),
          (∀ f : ↥K, f ∈ W ↔ τ f ∈ W) ∧ ∀ f : ↥K, f ∈ O ↔ τ f ∈ O') ∧
        (∀ O ∈ ends, ∀ f : ↥K, f ∈ O ↔ τ₀ f ∈ O) ∧
        (∀ O ∈ ends, ∀ O' ∈ ends, O ≠ O' → ∃ (f : ↥K) (hf : f ∈ O) (hf' : f ∈ O'),
          ¬ IsUnit (⟨f, hf⟩ : ↥O) ∧ IsUnit (⟨f, hf'⟩ : ↥O'))) := by sorry
