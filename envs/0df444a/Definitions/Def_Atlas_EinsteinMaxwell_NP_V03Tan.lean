/-! ### Linear structure of compatible real tangents; complex tangents at KN -/

section lin

variable {g : Metric 4} {E : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)} {h₁ h₂ : Metric 4} {f₁ f₂ : TwoForm 4}
  {B₁ B₂ : Fin 4 → Fin 4 → Pt 4 → ℂ}

end lin

/-- **A complex first-order tangent at Kerr–Newman** on an open `U ⊆ domReg`: both real parts are compatible real
tangents (`C^∞` `f`, `B`, antisymmetric `f`, real pattern of `B`, first-order Gram relation; class B). -/
structure KNCTan (M a Q : ℝ) (U : Set (Pt 4)) (τ : CTan) : Prop where
  isOpen : IsOpen U
  sub : U ⊆ domReg M a Q
  re : RealFrameTangent (gKN M a Q) (knE M a Q) U τ.hR τ.fR τ.BR
  im : RealFrameTangent (gKN M a Q) (knE M a Q) U τ.hI τ.fI τ.BI

end ExactVacuumAtlas.EinsteinMaxwell.NP


