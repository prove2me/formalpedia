/-- Cartesian → spherical on the slit domain. -/
noncomputable def fromCart (y : Pt 4) : Pt 4 :=
  ![y 0, rho y, Real.arccos (y 3 / rho y), 2 * Real.arctan (y 2 / (rxy y + y 1))]

