/-- **Lemma 3.3 is false in dimension one** for `r = √d = 1`: no apex angle
`θ ∈ (0, π/2]` and no unit axis `v` give `V(v,θ) ∩ ℤ ⊆ V_r ∩ ℤ`, whatever the
reference cone `V(u, ϑ)`. -/
theorem solution
    (u : EuclideanSpace ℝ (Fin 1)) (ϑ : ℝ)
    (v : EuclideanSpace ℝ (Fin 1)) (hv : ‖v‖ = 1) (θ : ℝ) (hθ : 0 < θ) (hθ' : θ ≤ π / 2) :
    ¬ (QFS.doubleCone v θ ∩ QFS.lattice 1 ⊆ QFS.shrink (QFS.doubleCone u ϑ) 1 ∩ QFS.lattice 1) := by
  intro H
  have h1 : QFS.pt 1 ∈ QFS.doubleCone v θ ∩ QFS.lattice 1 :=
    ⟨QFS.pt_one_mem_doubleCone hv hθ hθ', by simpa using QFS.pt_mem_lattice 1⟩
  obtain ⟨-, hball⟩ := (H h1).1
  have hmem : (0 : EuclideanSpace ℝ (Fin 1)) ∈ closedBall (QFS.pt 1) 1 := by
    rw [Metric.mem_closedBall, dist_zero_left, QFS.norm_pt]
    norm_num
  exact QFS.zero_notMem_doubleCone u ϑ (hball hmem)
