-- title:
--   Language classes, closure dimension and private uniform generation
-- statement:
--   Let $X$ be a countable example space. A language class $C$ is a nonempty family of infinite subsets of $X$, with no restriction on the cardinality of the family. The support $\widehat S$ consists of the distinct entries of a dataset. For a nonempty finite realizable set $T$, its closure is
--
--   $$\langle T\rangle_C=\bigcap_{L\in C,\,T\subseteq L}L.$$
--
--   The closure dimension is the supremum of sizes of nonempty finite realizable sets with finite closure. If none exists, it is $0$ when the intersection of all languages is finite and $-1$ otherwise; unbounded witness sizes give infinity. The intersection formula is extended to all sets for totality, with unrealizable inputs giving $X$; no theorem uses this extension as a realizable closure.
--
--   A uniform generator succeeds almost surely on every input of $n$ distinct points of any $L\in C$, returning an infinite subset of $L\setminus\widehat S$. Private uniform generatability means that there are $n_0\ge1$, mechanisms $A_n$ for every $n\ge n_0$, and nonnegative privacy errors $\delta_n$ with $n\delta_n\to0$, such that $A_n$ is $(1,\delta_n)$-private on all inputs and is a uniform generator. Values below $n_0$ are unused.
--
--   The output measurable space is the product sigma-algebra on subsets of $X$, generated by membership events; this is the reading of the unspecified output sigma-algebra in Definition 3.4.
-- source:
--   Di Wang, Peng Ye, STOC 2027 submission #178 (October 2026), Section 3, Definitions 3.1–3.2, pp. 8–9; private generatability convention, p. 9. https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/178.pdf

import Mathlib
import Definitions.Def_PrivateUniformGen_Characterization_Privacy

open MeasureTheory Filter

namespace PrivateUniformGen.Characterization

/-- Section 3, p. 8: a nonempty family of infinite sets; the family need not be countable. -/
structure LanguageClass (X : Type*) where
  languages : Set (Set X)
  nonempty : languages.Nonempty
  infinite : ∀ L ∈ languages, L.Infinite

/-- Distinct support of an ordered dataset. -/
noncomputable def support {X : Type*} {n : ℕ} (S : Fin n → X) : Finset X :=
  by classical exact Finset.univ.image S

/-- Closure, p. 8. Outside the source domain this is the same intersection formula;
    in particular an unrealizable set has closure univ. -/
def closure {X : Type*} (C : LanguageClass X) (T : Set X) : Set X :=
  ⋂₀ {L ∈ C.languages | T ⊆ L}

/-- Positive finite-closure witnesses, before the exceptional 0 / -1 convention. -/
noncomputable def closureSizeSup {X : Type*} (C : LanguageClass X) : ℕ∞ :=
  ⨆ (T : Finset X) (_ : T.Nonempty)
    (_ : ∃ L ∈ C.languages, (↑T : Set X) ⊆ L)
    (_ : (closure C (↑T)).Finite), (T.card : ℕ∞)

/-- Definition 3.2, p. 8, with its essential value -1 and genuine +infinity. -/
noncomputable def closureDim {X : Type*} (C : LanguageClass X) : WithTop ℤ :=
  by
    classical
    exact if closureSizeSup C = 0 then
      (if (⋂₀ C.languages).Finite then 0 else -1)
    else if closureSizeSup C = ⊤ then ⊤ else ((closureSizeSup C).toNat : ℤ)

/-- Definition 3.1: almost-sure infinite novel output on every distinct realizable input. -/
def IsUniformGenerator {X : Type*} (C : LanguageClass X) {n : ℕ}
    (A : Mechanism X (Set X) n) : Prop :=
  ∀ L ∈ C.languages, ∀ S : Fin n → X, (∀ i, S i ∈ L) → Function.Injective S →
    ∀ᵐ Z ∂(A S : Measure (Set X)), Z.Infinite ∧ Z ⊆ L \ Set.range S

/-- Section 3.2, p. 9: epsilon is exactly 1 and n delta_n tends to zero. -/
def PrivatelyUniformlyGeneratable {X : Type*} (C : LanguageClass X) : Prop :=
  ∃ n₀ : ℕ, 1 ≤ n₀ ∧ ∃ (δ : ℕ → ℝ) (A : ∀ n, Mechanism X (Set X) n),
    Tendsto (fun n : ℕ => (n : ℝ) * δ n) atTop (nhds 0) ∧
    ∀ n, n₀ ≤ n → IsDP (A n) 1 (δ n) ∧ IsUniformGenerator C (A n)

end PrivateUniformGen.Characterization


