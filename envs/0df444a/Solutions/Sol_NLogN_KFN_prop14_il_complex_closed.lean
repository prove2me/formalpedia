      exact Nat.add_le_add_right (Nat.add_le_add (Nat.add_le_add_left this (w + 2 * D)) hWh) 2
    have hX : (NLogN.KFN.Xf r Ψ (w + 2 * D + (k + 1) * M * NLogN.KFN.DWb L P8Lift.sc P8Lift.Wc A k +
