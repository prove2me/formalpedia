p2m_open "Complex Function.Complex ComplexConjugate AutomorphicForm.ComplexIwasawa P2MW.S_AutomorphicForm_bruhatEisenstein_sub_constantTerm_isRapidlyDecreasingOn.M4aP3B.RealIwasawa P2MW.S_AutomorphicForm_bruhatEisenstein_sub_constantTerm_isRapidlyDecreasingOn.M4aP3B.ScalarMajorant"
p2m_open_scoped "Nat Filter.Nat"

variable (g : Matrix (Fin 2) (Fin 2) ℂ)

private def botNormSqC : ℝ := normSq (g 1 0) + normSq (g 1 1)

private theorem botNormSqC_nonneg : 0 ≤ botNormSqC g := add_nonneg (normSq_nonneg _) (normSq_nonneg _)

private theorem botNormSqC_pos (hg : g.det ≠ 0) : 0 < botNormSqC g := by
  rcases (botNormSqC_nonneg g).lt_or_eq with h | h
  · exact h
  · exfalso
    have h' : normSq (g 1 0) + normSq (g 1 1) = 0 := h.symm
    have h0 : g 1 0 = 0 :=
      normSq_eq_zero.mp (le_antisymm (by nlinarith [normSq_nonneg (g 1 1)]) (normSq_nonneg _))
    have h1 : g 1 1 = 0 :=
      normSq_eq_zero.mp (le_antisymm (by nlinarith [normSq_nonneg (g 1 0)]) (normSq_nonneg _))
    exact hg (by rw [Matrix.det_fin_two, h0, h1, mul_zero, mul_zero, sub_zero])

private def lineCentre : ℂ := -(conj (g 1 0) * g 0 0 + conj (g 1 1) * g 0 1) / (botNormSqC g : ℂ)

variable {g}

private theorem radC_sq_eq (hg : g.det ≠ 0) (z : ℂ) :
    radC g z ^ 2 = botNormSqC g * normSq (z - lineCentre g) + normSq g.det / botNormSqC g := by
  have hA := botNormSqC_pos g hg
  have hAne : (botNormSqC g : ℂ) ≠ 0 := by exact_mod_cast hA.ne'
  have hrad : radC g z ^ 2 = normSq (botP g z) + normSq (botQ g z) := by
    rw [radC, Real.sq_sqrt (add_nonneg (normSq_nonneg _) (normSq_nonneg _))]
  have hA_C : (botNormSqC g : ℂ) = conj (g 1 0) * g 1 0 + conj (g 1 1) * g 1 1 := by
    rw [botNormSqC]
    push_cast
    rw [mul_comm (conj (g 1 0)) (g 1 0), mul_comm (conj (g 1 1)) (g 1 1), mul_conj, mul_conj]
  have hz : (botNormSqC g : ℂ) * lineCentre g
      = -(conj (g 1 0) * g 0 0 + conj (g 1 1) * g 0 1) := by
    rw [lineCentre, mul_div_cancel₀ _ hAne]
  have h1 : conj (g 1 0) * botP g z + conj (g 1 1) * botQ g z
      = (botNormSqC g : ℂ) * (z - lineCentre g) := by
    rw [botP, botQ, mul_sub, hz, hA_C]
    ring
  have h2 : g 1 0 * botQ g z - g 1 1 * botP g z = -g.det := by
    rw [botP, botQ, Matrix.det_fin_two]
    ring
  have hL := normSq_conj_mul_add_conj_mul_add_normSq_sub (g 1 0) (g 1 1) (botP g z) (botQ g z)
  rw [h1, h2, normSq_mul, normSq_ofReal, normSq_neg, ← botNormSqC] at hL
  have key : botNormSqC g * (normSq (botP g z) + normSq (botQ g z))
      = botNormSqC g * botNormSqC g * normSq (z - lineCentre g) + normSq g.det := by
    linear_combination -hL
  rw [hrad]
  field_simp [hA.ne']
  linear_combination key

private theorem radC_pos (hg : g.det ≠ 0) (z : ℂ) : 0 < radC g z := by
  have hA := botNormSqC_pos g hg
  have h2 : 0 < radC g z ^ 2 := by
    rw [radC_sq_eq hg z]
    have ha : 0 ≤ botNormSqC g * normSq (z - lineCentre g) := mul_nonneg hA.le (normSq_nonneg _)
    have hb : 0 < normSq g.det / botNormSqC g := div_pos (normSq_pos.mpr hg) hA
    linarith
  have h0 : 0 ≤ radC g z := Real.sqrt_nonneg _
  rcases h0.lt_or_eq with h | h
  · exact h
  · rw [← h] at h2
    simp at h2

variable (g)

private def radFloorC : ℝ :=
  min ((normSq g.det / botNormSqC g) / (1 + 2 * normSq (lineCentre g))) (botNormSqC g / 2)

variable {g}

private theorem radFloorC_pos (hg : g.det ≠ 0) : 0 < radFloorC g := by
  have hA := botNormSqC_pos g hg
  have hd := normSq_pos.mpr hg
  have h1 : 0 < 1 + 2 * normSq (lineCentre g) := by nlinarith [normSq_nonneg (lineCentre g)]
  exact lt_min (div_pos (div_pos hd hA) h1) (by linarith)

private theorem radFloorC_mul_le_radC_sq (hg : g.det ≠ 0) (z : ℂ) :
    radFloorC g * (1 + normSq z) ≤ radC g z ^ 2 := by
  have hA := botNormSqC_pos g hg
  have hD : 0 < normSq g.det / botNormSqC g := div_pos (normSq_pos.mpr hg) hA
  have hf2 : (0 : ℝ) < 1 + 2 * normSq (lineCentre g) := by nlinarith [normSq_nonneg (lineCentre g)]
  have hmin0 : 0 ≤ radFloorC g := (radFloorC_pos hg).le
  have h1 : 1 + normSq z
      ≤ (1 + 2 * normSq (lineCentre g)) + 2 * normSq (z - lineCentre g) := by
    rw [normSq_apply z, normSq_apply (lineCentre g), normSq_apply (z - lineCentre g), sub_re, sub_im]
    nlinarith [sq_nonneg (z.re - 2 * (lineCentre g).re), sq_nonneg (z.im - 2 * (lineCentre g).im)]
  rw [radC_sq_eq hg z]
  calc radFloorC g * (1 + normSq z)
      ≤ radFloorC g * ((1 + 2 * normSq (lineCentre g)) + 2 * normSq (z - lineCentre g)) :=
        mul_le_mul_of_nonneg_left h1 hmin0
    _ = radFloorC g * (1 + 2 * normSq (lineCentre g))
          + radFloorC g * (2 * normSq (z - lineCentre g)) := by ring
    _ ≤ (normSq g.det / botNormSqC g) / (1 + 2 * normSq (lineCentre g))
            * (1 + 2 * normSq (lineCentre g))
          + botNormSqC g / 2 * (2 * normSq (z - lineCentre g)) :=
        add_le_add
          (mul_le_mul_of_nonneg_right (by rw [radFloorC]; exact min_le_left _ _) hf2.le)
          (mul_le_mul_of_nonneg_right (by rw [radFloorC]; exact min_le_right _ _)
            (by nlinarith [normSq_nonneg (z - lineCentre g)]))
    _ = botNormSqC g * normSq (z - lineCentre g) + normSq g.det / botNormSqC g := by
        field_simp [hf2.ne', hA.ne']
        ring

private theorem max_one_norm_sq_le (z : ℂ) : max 1 ‖z‖ ^ 2 ≤ 1 + normSq z := by
  rw [normSq_eq_norm_sq]
  rcases le_total 1 ‖z‖ with h | h
  · rw [max_eq_right h]
    nlinarith [norm_nonneg z]
  · rw [max_eq_left h]
    nlinarith [norm_nonneg z, sq_nonneg ‖z‖]

private theorem sqrt_radFloorC_mul_le_radC (hg : g.det ≠ 0) (z : ℂ) :
    Real.sqrt (radFloorC g) * max 1 ‖z‖ ≤ radC g z := by
  have hc := radFloorC_pos hg
  have h2 : (Real.sqrt (radFloorC g) * max 1 ‖z‖) ^ 2 ≤ radC g z ^ 2 := by
    rw [mul_pow, Real.sq_sqrt hc.le]
    exact (mul_le_mul_of_nonneg_left (max_one_norm_sq_le z) hc.le).trans
      (radFloorC_mul_le_radC_sq hg z)
  have h3 := Real.sqrt_le_sqrt h2
  rwa [Real.sqrt_sq (by positivity), Real.sqrt_sq (radC_pos hg z).le] at h3

private theorem radC_rpow_neg_le (hg : g.det ≠ 0) {β : ℝ} (hβ : 0 ≤ β) (z : ℂ) :
    radC g z ^ (-β) ≤ Real.sqrt (radFloorC g) ^ (-β) * max 1 ‖z‖ ^ (-β) := by
  have hpos : 0 < Real.sqrt (radFloorC g) * max 1 ‖z‖ :=
    mul_pos (Real.sqrt_pos.2 (radFloorC_pos hg)) (lt_max_of_lt_left one_pos)
  rw [← Real.mul_rpow (Real.sqrt_nonneg _) (zero_le_one.trans (le_max_left _ _))]
  exact Real.rpow_le_rpow_of_nonpos hpos (sqrt_radFloorC_mul_le_radC hg z) (neg_nonpos.2 hβ)

variable (g)

private def lineW (z₀ : ℂ) (θ : ℝ) : ℂ := Complex.exp (-(θ * Complex.I)) * (z₀ - lineCentre g)

private def lineDelta (z₀ : ℂ) (θ : ℝ) : ℝ :=
  Real.sqrt ((lineW g z₀ θ).im ^ 2 + normSq g.det / botNormSqC g ^ 2)

private def lineMat (z₀ : ℂ) (θ : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  !![(lineW g z₀ θ).re, lineDelta g z₀ θ; 1, 0]

variable {g}

private theorem lineDelta_pos (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) : 0 < lineDelta g z₀ θ := by
  have hA := botNormSqC_pos g hg
  have h1 : 0 < normSq g.det / botNormSqC g ^ 2 := div_pos (normSq_pos.mpr hg) (by positivity)
  exact Real.sqrt_pos.mpr (by nlinarith [sq_nonneg (lineW g z₀ θ).im])

private theorem det_lineMat (z₀ : ℂ) (θ : ℝ) : (lineMat g z₀ θ).det = -lineDelta g z₀ θ := by
  rw [lineMat, Matrix.det_fin_two_of]
  ring

private theorem det_lineMat_ne_zero (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) : (lineMat g z₀ θ).det ≠ 0 := by
  rw [det_lineMat]
  exact neg_ne_zero.mpr (lineDelta_pos hg z₀ θ).ne'

private theorem botNormSq_lineMat (z₀ : ℂ) (θ : ℝ) : botNormSq (lineMat g z₀ θ) = 1 := by
  rw [botNormSq, lineMat]
  norm_num

private theorem towerRatio_lineMat_le (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) :
    towerRatio (lineMat g z₀ θ) ≤ botNormSqC g / ‖g.det‖ := by
  have hA := botNormSqC_pos g hg
  have hdet : 0 < ‖g.det‖ := norm_pos_iff.mpr hg
  have hδ : ‖g.det‖ / botNormSqC g ≤ lineDelta g z₀ θ := by
    rw [lineDelta]
    have h1 : (‖g.det‖ / botNormSqC g) ^ 2
        ≤ (lineW g z₀ θ).im ^ 2 + normSq g.det / botNormSqC g ^ 2 := by
      rw [div_pow, ← normSq_eq_norm_sq]
      nlinarith [sq_nonneg (lineW g z₀ θ).im]
    calc ‖g.det‖ / botNormSqC g
