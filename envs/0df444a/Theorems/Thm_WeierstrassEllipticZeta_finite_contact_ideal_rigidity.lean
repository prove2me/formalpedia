-- title:
--   Jet vanishing and quotient length determine a contact intersection ideal
-- statement:
--   Let $g_2,g_3\in\mathbb C$, let $A=\mathbb C[t,x_1,x_2,x_3]$, and choose either of the elliptic-extension chart derivations
--
--   $$D_0=\partial_t+x_2\partial_{x_1}+(6x_1^2-g_2/2)\partial_{x_2}-x_1\partial_{x_3},$$
--
--   $$D_1=\partial_t+(-6x_2^2+(g_2/2)x_1^2)\partial_{x_1}+(-1/2-g_2x_1x_2-(3g_3/2)x_1^2)\partial_{x_2}+(-2g_2x_2^2-3g_3x_1x_2)\partial_{x_3}.$$
--
--   Write $D=D_c$. For each $v\in\mathbb C^4$ and $n\in\mathbb N$, let $C(v,n)$ be the chart contact ideal generated by polynomials whose first $n$ $D$-jets vanish at $v$. Assume its exact membership property, for all $v,n,p$:
--
--   $$p\in C(v,n)\quad\Longleftrightarrow\quad D^jp(v)=0\quad(0\le j<n).$$
--
--   Let $V\subseteq\mathbb C^4$ be any finite set. Choose natural numbers $e_v\le n_v$ for each $v\in V$, and a finite family $f_0,\ldots,f_{K-1}\in A$. Put
--
--   $$I=\bigcap_{v\in V}C(v,n_v),\qquad J=I+(f_0,\ldots,f_{K-1}).$$
--
--   Suppose the added equations have the indicated common jets:
--
--   $$D^jf_i(v)=0\qquad(v\in V,\ 0\le i<K,\ 0\le j<e_v).$$
--
--   If $A/J$ is finite-dimensional over $\mathbb C$ and
--
--   $$\dim_{\mathbb C}(A/J)=\sum_{v\in V}e_v,$$
--
--   then the ideal itself is exactly
--
--   $$J=\bigcap_{v\in V}C(v,e_v).$$
--
--   **Formalization Note** The exact contact membership criterion above is an explicit hypothesis. The proof uses the already proved dimension formula for intersections of these contact ideals. The quotient dimension of $J$ and its finite dimensionality are assumptions, as is the vanishing of the added equations; the conclusion is equality of ideals. No time-substitution presentation or injectivity of first coordinates is required. Points in $V$ can share a first coordinate and need not lie on the chart cubic. Empty $V$, $K=0$, zero contact orders and zero or repeated equations are allowed. The zero-order contact ideal and the empty intersection are the whole ring. For positive residual orders, the existing contact-ideal structure theorem identifies the factors as primary ideals supported at their respective points. This local rigidity statement supplies no global degree estimate or algebraic-group compatibility.
-- source:
--   Derived finite-contact rigidity for the commutative-algebra approach associated with Senthil Kumar K (2026), Appendix A, https://doi.org/10.1017/S001309152610145X. Uses the proved elliptic_extension_contact_quotient_dimension. Jet vanishing gives ideal containment; equality of finite quotient dimensions makes the natural quotient map injective, hence gives ideal equality. Not quoted as Theorem A.2. Primary formal references: Ideal.quotientMapₐ, Ideal.Quotient.mkₐ_surjective, LinearMap.injective_iff_surjective_of_finrank_eq_finrank and Ideal.Quotient.eq_zero_iff_mem.

import Definitions.Def_WeierstrassEllipticZeta_ProjectiveContactIdeal
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.RingTheory.Ideal.Quotient.Operations

open WeierstrassEllipticZeta
open scoped Classical

theorem WeierstrassEllipticZeta.finite_contact_ideal_rigidity
    (g₂ g₃ : ℂ) (c : Fin 2)
    (hcontact : ∀ (v : Fin 4 → ℂ) (n : ℕ) (p : MvPolynomial (Fin 4) ℂ),
      p ∈ extensionChartContactIdeal g₂ g₃ c v n ↔
        ∀ k < n, MvPolynomial.eval v ((extensionChartDerivation g₂ g₃ c)^[k] p) = 0)
    (V : Finset (Fin 4 → ℂ)) (n e : V → ℕ) (he : ∀ v : V, e v ≤ n v)
    (K : ℕ) (f : Fin K → MvPolynomial (Fin 4) ℂ)
    (hvan : ∀ (v : V) (i : Fin K) (j : ℕ), j < e v →
      MvPolynomial.eval v.val ((extensionChartDerivation g₂ g₃ c)^[j] (f i)) = 0)
    (hfinite : FiniteDimensional ℂ (MvPolynomial (Fin 4) ℂ ⧸
      ((⨅ v : V, extensionChartContactIdeal g₂ g₃ c v.val (n v)) ⊔ Ideal.span (Set.range f))))
    (hlen : Module.finrank ℂ (MvPolynomial (Fin 4) ℂ ⧸
      ((⨅ v : V, extensionChartContactIdeal g₂ g₃ c v.val (n v)) ⊔ Ideal.span (Set.range f))) =
        ∑ v : V, e v) :
    (⨅ v : V, extensionChartContactIdeal g₂ g₃ c v.val (n v)) ⊔ Ideal.span (Set.range f) =
      ⨅ v : V, extensionChartContactIdeal g₂ g₃ c v.val (e v) := by sorry
