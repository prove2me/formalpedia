-- title:
--   The geometrically uniform ensemble labelled by $G/H$
-- statement:
--   The geometrically uniform ensemble generated by $G$ and $|\psi\rangle$, labelled by cosets: the label $x\in G/H$ carries the pure state $|\psi_x\rangle=U_g|\psi\rangle$, for any representative $g$ of $x$.
--
--   **Formalization Note** The representative is the chosen $x.\mathrm{out}$. The vector does not depend on it, because $U_h\psi=\psi$ for $h\in H$. The uniform prior enters through the definition of $k_{\min}$.
-- source:
--   Zhou, Leditzky, A mixing time method for estimating the sample complexity of quantum state discrimination, arXiv:2609.40182 (held version, sha256 62fb68dd…), §3, p.17

import Mathlib
import Definitions.Def_GaussTesting_Ell2
import Definitions.Def_QSDMixing_GU_MixedState
import Definitions.Def_QSDMixing_GU_stabilizer

set_option autoImplicit false
open GaussTesting (Ell2)

namespace QSDMixing.GU

/-- The geometrically uniform ensemble on cosets: the label `x ∈ G ⧸ H` carries the pure state
`|ψ_x⟩ = U_{g} |ψ⟩` for a representative `g` of `x`, where `H` is the stabilizer of `ψ`.

Zhou, Leditzky, *A mixing time method for estimating the sample complexity of quantum state discrimination*, arXiv:2609.40182 (held version, sha256 62fb68dd…), §3, p.17: "discriminating the states `{|ψ_{gH}⟩}` labeled by `G/H`".

**Formalization Note.** The representative is `x.out`. The vector does not depend on the representative,
because `U_h ψ = ψ` on `H`. The uniform prior is built into `kMin`. -/
noncomputable def cosetEnsemble {G ι : Type} [Group G] (U : G →* unitary (Ell2 ι →L[ℂ] Ell2 ι))
    (ψ : Ell2 ι) (hψ : ‖ψ‖ = 1) : G ⧸ stabilizer U ψ → MixedState ι :=
  fun x => MixedState.pure ((U x.out : Ell2 ι →L[ℂ] Ell2 ι) ψ) (by
    rw [Unitary.norm_map]; exact hψ)

end QSDMixing.GU


