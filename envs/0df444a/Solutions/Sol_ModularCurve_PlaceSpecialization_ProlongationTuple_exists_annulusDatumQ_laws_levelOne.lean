    ProlongationTuple.exists_inertiaFixed_nodeCoordinates_presentation_levelOne_of_orderLawFixed hq5 R hker hR hO W hW' hRL hNV
  haveI := fd
  choose c u hcu using hnode

  let Kf : Place k (modularFunctionFieldC k 1) → IntermediateField ℚ (AlgebraicClosure ℚ) := fun _ => K₀
  let ϖf : ∀ w : Place k (modularFunctionFieldC k 1), ↥(NodeLocalized.coeffSubring A (Kf w)) := fun _ => ((q : ℕ) : ↥(NodeLocalized.coeffSubring A K₀))
