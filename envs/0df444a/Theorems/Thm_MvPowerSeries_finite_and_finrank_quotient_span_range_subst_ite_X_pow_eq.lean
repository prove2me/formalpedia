-- title:
--   Partial q-th power substitution multiplies codimension by q^{d-|T|}
-- statement:
--   Let $k$ be a field, let $d$ be a natural number, let $T$ be a finite subset of $\mathrm{Fin}\,d$, and let $q$ be a natural number with $q>0$. Let $g : \mathrm{Fin}\,d \to k[[X_0,\dots,X_{d-1}]]$ be a family of multivariate formal power series each of whose constant coefficients vanishes. Write $E$ for the substitution sending the variable $X_j$ to $X_j$ when $j \in T$ and to $X_j^{q}$ when $j \notin T$, and let $E(g_i)$ denote the result of applying this substitution to $g_i$. The assertion is twofold. First, the quotient of $k[[X_0,\dots,X_{d-1}]]$ by the ideal generated by the range of $i \mapsto E(g_i)$ is a finite-dimensional $k$-module if and only if the quotient by the ideal generated by the range of $g$ is. Second, the $k$-dimension of the former quotient equals $q^{\,d - |T|}$ times the $k$-dimension of the latter, where $d - |T|$ is truncated subtraction of natural numbers. The dimension identity is stated unconditionally, so in the infinite-dimensional case it records the equality $0 = q^{\,d-|T|}\cdot 0$ under Mathlib's convention that `Module.finrank` vanishes on modules that are not finite of that rank.
--
--   The result expresses that $k[[X_1,\dots,X_d]]$ is free of rank $q^{\,d-|T|}$ over the image of the partial $q$-th power substitution, so that colengths of ideals of finite colength are multiplied by $q^{\,d-|T|}$ under that substitution. It is used in [`MvFormalGroup.Hom.exists_comp_eq_and_comp_eq_X_pow_and_finrank_eq_pow_mul`](thm.html#MvFormalGroup.Hom.exists_comp_eq_and_comp_eq_X_pow_and_finrank_eq_pow_mul) to compute the degree of a homomorphism of multivariate formal groups after factoring out a power of Frobenius.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_MvPowerSeries_finite_and_finrank_quotient_span_range_subst_ite_X_pow_eq.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open MvPowerSeries

universe u

theorem MvPowerSeries.finite_and_finrank_quotient_span_range_subst_ite_X_pow_eq
    {k : Type u} [Field k] {d : ℕ} (T : Finset (Fin d)) (q : ℕ) (hq : 0 < q)
    (g : Fin d → MvPowerSeries (Fin d) k) (hg : ∀ i, (g i).constantCoeff = 0) :
    (Module.Finite k (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range fun i =>
        subst (fun j => if j ∈ T then (X j : MvPowerSeries (Fin d) k) else X j ^ q) (g i))) ↔
      Module.Finite k (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range g))) ∧
    Module.finrank k (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range fun i =>
        subst (fun j => if j ∈ T then (X j : MvPowerSeries (Fin d) k) else X j ^ q) (g i))) =
      q ^ (d - T.card) *
        Module.finrank k (MvPowerSeries (Fin d) k ⧸ Ideal.span (Set.range g)) := by sorry
