open ModularCurve

theorem ModularCurve.exists_isAtkinLehnerAutFull_of_prime_of_not_dvd (N p : ℕ) [NeZero N] [NeZero p]
    (hp : p.Prime) (hpN : ¬ p ∣ N) :
    ∃ σ : modularFunctionFieldFull (N * p) ≃ₐ[ℚ] modularFunctionFieldFull (N * p),
      IsAtkinLehnerAutFull N p σ := by sorry
