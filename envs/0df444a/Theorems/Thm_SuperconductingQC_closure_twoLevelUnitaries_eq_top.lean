-- title:
--   Every unitary is a product of two-level unitaries
-- statement:
--   Let $\iota$ be a finite index set and $U(\mathbb C^\iota)$ the group of unitary $\iota\times\iota$ complex matrices. Then the subgroup generated by the two-level unitaries is the whole group:
--   $$\big\langle\, W\in U(\mathbb C^\iota)\ :\ W \text{ is two-level}\,\big\rangle=U(\mathbb C^\iota).$$
--   Here $W$ is two-level if there are basis indices $a,b$ (possibly equal) such that $W_{xy}=\delta_{xy}$ whenever $x\notin\{a,b\}$ or $y\notin\{a,b\}$.
--
--   This is the first reduction in the standard proof that a gate set is universal: any unitary on $n$ qubits decomposes into unitaries that act nontrivially on only two computational basis states.
-- source:
--   Nielsen & Chuang, Quantum Computation and Quantum Information (2000), §4.5.1 (decomposition of unitaries into two-level unitaries); Barenco et al., Phys. Rev. A 52, 3457 (1995), https://doi.org/10.1103/PhysRevA.52.3457

import Mathlib
import Definitions.Def_SuperconductingQC_Gates

open scoped Matrix Kronecker

namespace SuperconductingQC

theorem closure_twoLevelUnitaries_eq_top (ι : Type*) [Fintype ι] [DecidableEq ι] :
    Subgroup.closure (twoLevelUnitaries ι) = ⊤ := by
  sorry

end SuperconductingQC
