section steps
variable {σ : Fin 19 → Fin HS} {dS dA : Fin HS} (hW : SwOK σ dS dA)
  (s : IState HS) (F : Fin HS → List ℤ) (z ds : List ℤ) (v : Fin 19 → List ℤ) (B : ℕ)
include hW

theorem pushR_sp (i j : Fin 19) (x : ℤ) (l : List ℤ) (hvj : v j = x :: l)
    (hz : zsz x ≤ B) :
    Sp (.push (σ i) (.reg (σ j))) (encK s (SS σ dS F z ds v))
      (encK s (SS σ dS F z ds (update v i (x :: v i)))) (4000 * (B + 2)) := by
  have hj : SS σ dS F z ds v (σ j) = x :: l := by rw [SS_at hW, hvj]
  have S := Sp.push s (SS σ dS F z ds v) (i := σ i) (e := .reg (σ j)) (B := B) (hW.lt i)
    (clean_reg (hW.lt j)) (ok_reg hj) trivial (bnd_reg hj hz)
  rw [eval_reg hj, SS_at hW, SS_v hW] at S
  exact S.mono (by simp [Ex.size])

theorem popR_sp (i : Fin 19) (x : ℤ) (l : List ℤ) (hvi : v i = x :: l) (hz : zsz x ≤ B) :
    Sp (.pop (σ i)) (encK s (SS σ dS F z ds v)) (encK s (SS σ dS F z ds (update v i l)))
      (2 * B + 2) := by
  have S := Sp.pop s (SS σ dS F z ds v) (i := σ i) (a := x) (l := l) (B := B) (hW.lt i)
    (by rw [SS_at hW, hvi]) hz
  rwa [SS_v hW] at S

theorem pushS_sp (i : Fin 19) (x : ℤ) (rest : List ℤ) (hz : zsz x ≤ B) :
    Sp (.push (σ i) (.reg dS)) (encK s (SS σ dS F z (x :: rest) v))
      (encK s (SS σ dS F z (x :: rest) (update v i (x :: v i)))) (4000 * (B + 2)) := by
  have hj : SS σ dS F z (x :: rest) v dS = x :: rest := SS_atS hW ..
  have S := Sp.push s (SS σ dS F z (x :: rest) v) (i := σ i) (e := .reg dS) (B := B) (hW.lt i)
    (clean_reg hW.Slt) (ok_reg hj) trivial (bnd_reg hj hz)
  rw [eval_reg hj, SS_at hW, SS_v hW] at S
  exact S.mono (by simp [Ex.size])

theorem popS_sp (x : ℤ) (rest : List ℤ) (hz : zsz x ≤ B) :
    Sp (.pop dS) (encK s (SS σ dS F z (x :: rest) v)) (encK s (SS σ dS F z rest v))
      (2 * B + 2) := by
  have S := Sp.pop s (SS σ dS F z (x :: rest) v) (i := dS) (a := x) (l := rest) (B := B) hW.Slt
    (SS_atS hW ..) hz
  rwa [SS_ds hW] at S

theorem pushQ_sp (i : Fin 19) (hvi : v i = []) (e : Ex HS) (x : ℤ) (hc : e.Clean)
    (hok : e.ok (encK s (SS σ dS F z ds v))) (hB : e.Bnd (encK s (SS σ dS F z ds v)) B)
    (hx : e.eval (encK s (SS σ dS F z ds v)) = x) :
    Sp (.push (σ i) e) (encK s (SS σ dS F z ds v)) (encK s (SS σ dS F z ds (update v i [x])))
      ((e.size + 1) * 10 ^ 7 * (B + 2) ^ 2) := by
  have S := Sp.pushQ s (SS σ dS F z ds v) (i := σ i) (e := e) (B := B) (hW.lt i) hc hok hB
  rwa [hx, SS_at hW, hvi, SS_v hW] at S

end steps

