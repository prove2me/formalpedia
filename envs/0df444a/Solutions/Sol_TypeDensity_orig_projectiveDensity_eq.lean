private theorem affine_snoc_eq {n : ℕ} (a : Fin n → O) :
    affinePolynomial O (Fin.snoc (α := fun _ => O) a 1) = monicPolynomial O a := by
  simp [affinePolynomial, monicPolynomial, Fin.sum_univ_castSucc, add_comm]

