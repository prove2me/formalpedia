private def entry {r : ℕ} (v : BitVec r) (i : Fin r) : ZMod 2 :=
  if v.getLsbD i.val then 1 else 0

private lemma entry_xor {r : ℕ} (v w : BitVec r) (i : Fin r) :
    entry (v ^^^ w) i = entry v i + entry w i := by
  simp only [entry, BitVec.getLsbD_xor]
  cases v.getLsbD i.val <;> cases w.getLsbD i.val <;> decide

private lemma entry_injective {r : ℕ} : Function.Injective (entry (r := r)) := by
  intro v w h
  apply BitVec.eq_of_getLsbD_eq
  intro k hk
  let i : Fin r := ⟨k,hk⟩
  have hi := congrFun h i
  unfold entry at hi
  cases hv : v.getLsbD i.val <;> cases hw : w.getLsbD i.val <;> simp_all

private lemma pair_injective {r n : ℕ} (C : Fin n → BitVec r)
    (U : ℕ → ℕ × ℕ)
    (h : ∀ i j : Fin n, i < j → U (C i ^^^ C j).toNat = (i.val,j.val)) :
    ∀ {i j k l : Fin n}, i < j → k < l →
      (fun t => entry (C i) t + entry (C j) t) =
      (fun t => entry (C k) t + entry (C l) t) → i = k ∧ j = l := by
  intro i j k l hij hkl he
  have eqv : C i ^^^ C j = C k ^^^ C l := by
    apply entry_injective
    simpa only [funext_iff, entry_xor] using (fun t => congrFun he t)
  have hp : (i.val,j.val) = (k.val,l.val) := by
    rw [← h i j hij, ← h k l hkl, eqv]
  exact ⟨Fin.ext (congrArg Prod.fst hp), Fin.ext (congrArg Prod.snd hp)⟩

private lemma binary_eq_one {x : ZMod 2} (h : x ≠ 0) : x = 1 := by
  have hx : ∀ z : ZMod 2, z = 0 ∨ z = 1 := by decide +kernel
  exact (hx x).resolve_left h

private lemma support_sum {r n : ℕ} (H : Matrix (Fin r) (Fin n) (ZMod 2))
    (v : Fin n → ZMod 2) (hv : H *ᵥ v = 0) :
    ∀ t, ∑ j ∈ (Finset.univ.filter fun j => v j ≠ 0), H t j = 0 := by
  intro t
  have he := congrFun hv t
  change ∑ j, H t j * v j = 0 at he
  calc
    _ = ∑ j, H t j * v j := by
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro j _
      by_cases h : v j = 0
      · simp [h]
      · simp [binary_eq_one h]
    _ = 0 := he

private lemma kernel_even {r n : ℕ} (H : Matrix (Fin r) (Fin n) (ZMod 2))
    (hc : ∀ j, ∑ i, H i j = 1) (v : Fin n → ZMod 2) (hv : H *ᵥ v = 0) :
    (weight v : ZMod 2) = 0 := by
  let s := Finset.univ.filter fun j => v j ≠ 0
  have hs := support_sum H v hv
  change (s.card : ZMod 2) = 0
  calc
    (s.card : ZMod 2) = ∑ j ∈ s, (1 : ZMod 2) := by simp
    _ = ∑ j ∈ s, ∑ i, H i j := by simp_rw [hc]
    _ = ∑ i, ∑ j ∈ s, H i j := Finset.sum_comm
    _ = 0 := by simp [s, hs]

private lemma pair_set_injective {r n : ℕ} (H : Matrix (Fin r) (Fin n) (ZMod 2))
    (hp : ∀ {i j k l}, i < j → k < l →
      (fun t => H t i + H t j) = (fun t => H t k + H t l) → i = k ∧ j = l)
    {i j k l : Fin n} (hij : i ≠ j) (hkl : k ≠ l)
    (he : (fun t => H t i + H t j) = (fun t => H t k + H t l)) :
    ({i,j} : Finset (Fin n)) = {k,l} := by
  rcases lt_or_gt_of_ne hij with hij | hij <;>
    rcases lt_or_gt_of_ne hkl with hkl | hkl
  · obtain ⟨rfl,rfl⟩ := hp hij hkl he; rfl
  · have he' : (fun t => H t i + H t j) = (fun t => H t l + H t k) := by
      simpa only [add_comm] using he
    obtain ⟨rfl,rfl⟩ := hp hij hkl he'; exact Finset.pair_comm _ _
  · have he' : (fun t => H t j + H t i) = (fun t => H t k + H t l) := by
      simpa only [add_comm] using he
    obtain ⟨rfl,rfl⟩ := hp hij hkl he'; exact Finset.pair_comm _ _
  · have he' : (fun t => H t j + H t i) = (fun t => H t l + H t k) := by
      simpa only [add_comm] using he
    obtain ⟨rfl,rfl⟩ := hp hij hkl he'; rfl

private lemma min_six {r n : ℕ} (H : Matrix (Fin r) (Fin n) (ZMod 2))
    (hc : ∀ j, ∑ i, H i j = 1)
    (hi : Function.Injective (fun j => fun t => H t j))
    (hp : ∀ {i j k l}, i < j → k < l →
      (fun t => H t i + H t j) = (fun t => H t k + H t l) → i = k ∧ j = l)
    (v : Fin n → ZMod 2) (hv : H *ᵥ v = 0) (hn : v ≠ 0) : 6 ≤ weight v := by
  have he := (ZMod.natCast_eq_zero_iff (weight v) 2).mp (kernel_even H hc v hv)
  by_contra hlt
  have hlt' : weight v < 6 := by omega
  interval_cases hw : weight v <;> norm_num [hw] at he
  · have hh : Finset.univ.filter (fun j => v j ≠ 0) = ∅ := Finset.card_eq_zero.mp hw
    apply hn
    funext j
    by_contra hj
    have hm : j ∈ Finset.univ.filter (fun j => v j ≠ 0) :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ j,by simpa using hj⟩
    rw [hh] at hm
    exact Finset.notMem_empty j hm
  · let s := Finset.univ.filter fun j => v j ≠ 0
    have hs : s.card = 2 := hw
    obtain ⟨i,j,hij,hs⟩ := Finset.card_eq_two.mp hs
    have hz := support_sum H v hv
    have heq : (fun t => H t i) = (fun t => H t j) := by
      funext t
      have ht := hz t
      change ∑ k ∈ s, H t k = 0 at ht
      rw [hs] at ht
      simp only [Finset.sum_pair hij] at ht
      exact (eq_neg_of_add_eq_zero_left ht).trans (ZMod.neg_eq_self_mod_two _) 
    exact hij (hi heq)
  · let s := Finset.univ.filter fun j => v j ≠ 0
    have hs : s.card = 4 := hw
    obtain ⟨i,si,hi0,his,hic⟩ := Finset.card_eq_succ.mp hs
    obtain ⟨j,sj,hj0,hjs,hjc⟩ := Finset.card_eq_succ.mp hic
    obtain ⟨k,l,hkl,hsl⟩ := Finset.card_eq_two.mp hjc
    have hs' : s = insert i (insert j {k,l}) := by rw [← his,← hjs,hsl]
    have hij : i ≠ j := by intro h; subst j; exact hi0 (by rw [← hjs]; simp)
    have hik : i ≠ k := by intro h; subst k; exact hi0 (by rw [← hjs,hsl]; simp)
    have hil : i ≠ l := by intro h; subst l; exact hi0 (by rw [← hjs,hsl]; simp)
    have hjk : j ≠ k := by intro h; subst k; exact hj0 (by rw [hsl]; simp)
    have hjl : j ≠ l := by intro h; subst l; exact hj0 (by rw [hsl]; simp)
    have hz := support_sum H v hv
    have heq : (fun t => H t i + H t j) = (fun t => H t k + H t l) := by
      funext t
      have ht := hz t
      change ∑ a ∈ s, H t a = 0 at ht
      rw [hs'] at ht
      simp only [Finset.sum_insert, Finset.mem_insert, Finset.mem_singleton,
        hij, hik, hil, hjk, hjl, hkl, or_self, not_false_eq_true, Finset.sum_singleton] at ht
      have ht' : (H t i + H t j) + (H t k + H t l) = 0 := by
        simpa only [add_assoc] using ht
      exact (eq_neg_of_add_eq_zero_left ht').trans (ZMod.neg_eq_self_mod_two _)
    have hp' := pair_set_injective H hp hij hkl heq
    have hmem : i ∈ ({k,l} : Finset (Fin n)) := hp' ▸ (by simp)
    simp [hik,hil] at hmem

