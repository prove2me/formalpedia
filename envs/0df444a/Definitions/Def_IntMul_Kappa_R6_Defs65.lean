-- Source module: Solutions.J6SegILCtl5
/-!
# B-line IL, B1 follow-up: building the control list, §5 the builder

**`ctlB`** = `const bCur 0; rptX bN' entP; finB; lenB; rptX rNC (mv bT rC; mv bT rC);
rptX bN' (mv bSv bX; mv bSv bX)`.

**`ctlB_runs`**: from any managed state `G` with the source table `srcTab src argOf n'` on top of
`bX = 44`, `n'` on `bN' = 20`, `n` on `bN = 21` and empty `rptX` counters, for a monotone source
(`MonoSrc n n' src`), the builder pushes `flatC (ctlOf n n' src argOf)` onto `rC = 45` and
`n + n'` (`= |ctlOf …|`) onto `rNC = 38`; every other stack is restored (the table included).
Cost `≤ (n + n' + 1) (30 cU Z + 20000)` with `Z ≥ 1`, `Z ≥ zsz n, zsz n'`, `Z ≥ zsz (argOf l)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

/-- **The control builder.** -/
def ctlB {P : ℕ} : IStmt HS P :=
  .seq (.op (.const bCur 0)) (.seq (rptX bN' lA lC lD entP) (.seq finB (.seq lenB (.seq
    (rptX rNC lA lC lD (.seq (.op (.mv bT rC)) (.op (.mv bT rC))))
    (rptX bN' lA lC lD (.seq (.op (.mv bSv bX)) (.op (.mv bSv bX))))))))

/-- Its cost bound. -/
def ctlCost (Z n n' : ℕ) : ℕ := (n + n' + 1) * (30 * cU Z + 20000)

end J6Seg.Slab

end

