theorem NLogN.KFL.xorStep_geo {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {K ρ f : ℕ} (hρK : ρ < K) (hf : 1 ≤ f) (g : Geo) (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) {Bb : ℕ} (hB2 : 2 ≤ Bb) (zV : zsz (g.V : ℤ) ≤ Bb) (w : ℕ)
    (t : IState HS) (xs : List ℤ) (R : List Item) (hlen : xs.length = g.V) (hbw : Bnd w xs)
    (h0 : t.G 0 = ints xs ++ R) :
    IRuns I iprog (xorStep (g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) g.Q (ρ + (f - 1) * K)
        (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) (2 ^ (ρ + (f - 1) * K) * g.S1)) t
      (t.upd 0 (ints (rixT g (XLc K ρ f) xs) ++ R))
      (cXor (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) (2 ^ (ρ + (f - 1) * K) * g.S1)
        w Bb) := by sorry
