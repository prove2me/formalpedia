    map_mul, map_pow, map_neg, map_ofNat]

lemma map_q20 : p.q20.map f = (p.map f).q20 := by
  simp only [q20, map_quadU, inv27, inv81, map, map_add, map_sub, map_mul, map_pow, map_neg, map_ofNat]
lemma map_q11 : p.q11.map f = (p.map f).q11 := by
  simp only [q11, map_quadU, inv9, inv27, map, map_add, map_sub, map_mul, map_pow, map_neg, map_ofNat]
lemma map_q02 : p.q02.map f = (p.map f).q02 := by
  simp only [q02, map_quadU, inv9, map, map_add, map_sub, map_mul, map_pow, map_neg, map_ofNat]
lemma map_c30 : p.c30.map f = (p.map f).c30 := by
  simp only [c30, map_quadU, inv243, map, map_mul, map_pow, map_neg, map_ofNat]
lemma map_c21 : p.c21.map f = (p.map f).c21 := by
  simp only [c21, map_quadU, inv27, map, map_mul, map_pow, map_neg, map_ofNat]
lemma map_c12 : p.c12.map f = (p.map f).c12 := by
  simp only [c12, map_quadU, inv9, map, map_mul, map_pow, map_neg, map_ofNat]
lemma map_c03 : p.c03.map f = (p.map f).c03 := by
