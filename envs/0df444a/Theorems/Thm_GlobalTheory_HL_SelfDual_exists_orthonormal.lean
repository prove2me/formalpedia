theorem GlobalTheory.HL.SelfDual.exists_orthonormal [IsNonarchimedeanLocalField F] [CharZero F] (L : LocE F E) {n : ℕ}
    {Hm : Matrix (Fin n) (Fin n) E} (hH : IsHermND L Hm) {Λ : Submodule L.O (Fin n → E)}
    (hΛ : IsSD L Hm Λ) : ∃ b : Fin n → Fin n → E,
      (∀ i j, hf L Hm (b i) (b j) = if i = j then 1 else 0) ∧
      Λ = Submodule.span L.O (Set.range b) := by sorry
