section
-- Source module: Solutions.KFMTabM
/-!
# KFM 9b: fixed-point root tables by FM product recurrences — denotations and error bounds

All values are Gaussian numerators at scale `2^P` (`toC z / 2^P`); products are
`gmulT P z w = Q_P(z · w)` (the per-entry operation of `KFMPw.gmulP`).

* `geoL P c x n = [x, x c, x c², …]` (`n` entries, each step `Q_P(· c)`).
* `chirpL P c h g n`: `g_0 = g`, `g_{j+1} = Q_P(g_j h_j)`, `h_{j+1} = Q_P(h_j c)` (the quadratic
  phase `e^{-πi s j²/t}` with `h_0 ≈ e^{-πi s/t}`, `c ≈ e^{-2πi s/t}`).
* `prodF P n x = Q_P(⋯Q_P(1·x₀)⋯x_{n-1})`; `chirpEnt P s t j` is the `prodF` of the `d` axis
  factors `axTab P (s i) (t i)` at `j i` (`axTab` = `chirpL` from the `twiddle` roots `hRoot`,
  `cRoot`); `twTab P k j n = geoL` from `twiddle P k j` (twist table `≈ e^{2πi j m/k}`).

Error bounds (unit `u = 2^{-P}`):
* **`step_err`**: `‖Q_P(z w) - Z W‖ ≤ ‖z - Z‖ + 2‖w - W‖ + 2u` for `‖Z‖, ‖W‖ ≤ 1`, `‖z - Z‖ ≤ 1`.
* **`geoL_err`**: entry `k` of `geoL` is within `e₀ + k (2 e_c + 2u)` of `X C^k`.
* **`chirpL_err`**: entry `j` is within `4 j² u` of `G H … ` (`e(g₀) = 0`, `e(h₀), e(c) ≤ u`),
  provided `4 n² u ≤ 1`.
* **`chirp_axis_err`**: with `h₀`, `c` within `u` of `e^{-πi s/t}`, `e^{-2πi s/t}`, entry `j` of
  `chirpL` is within `4 t² u` of `gch s t j` (`RC.gch`, the chirp factor of `RC.chirp`).
* **`prodF_err`**: a product of `n` factors within `e` of unit-disc values is within
  `n (2e + 2u)` of the exact product.
* **`axTab_err`** (`≤ 4t²u` vs `RC.gZ s t k`), **`chirpEnt_err`** (`≤ d(8T²+2)u` vs `RC.chirp`),
  **`twTab_err`** (`≤ 4nu`), **`gtr_err`** (final rounding to precision `p`: `+ 2·2^{-p}`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open Complex KFB

noncomputable section

/-! ## The value of a numerator -/

/-- The complex value of a numerator at scale `2^P`. -/
def vP (P : ℕ) (z : GI) : ℂ := NLogN.KFB.toC z / 2 ^ P

/-! ## Geometric tables -/

/-- `[x, x c, x c², …]` with `Q_P` after every product. -/
def geoL (P : ℕ) (c : GI) : GI → ℕ → List GI
  | _, 0 => []
  | x, n + 1 => x :: geoL P c (gmulT P x c) n

theorem length_geoL (P : ℕ) (c : GI) : ∀ (x : GI) (n : ℕ), (geoL P c x n).length = n
  | _, 0 => rfl
  | x, n + 1 => by simp [geoL, length_geoL P c _ n]

/-! ## Quadratic-phase (chirp) tables -/

/-- `g_0 = g`, `g_{j+1} = Q_P(g_j h_j)`, `h_{j+1} = Q_P(h_j c)`. -/
def chirpL (P : ℕ) (c : GI) : GI → GI → ℕ → List GI
  | _, _, 0 => []
  | h, g, n + 1 => g :: chirpL P c (gmulT P h c) (gmulT P g h) n

theorem length_chirpL (P : ℕ) (c : GI) : ∀ (h g : GI) (n : ℕ), (chirpL P c h g n).length = n
  | _, _, 0 => rfl
  | h, g, n + 1 => by simp [chirpL, length_chirpL P c _ _ n]

/-! ## Products of `d` factors -/

/-- The numerator of `1` at scale `2^P`. -/
def oneP (P : ℕ) : GI := (2 ^ P, 0)

/-- `Q_P(⋯Q_P(Q_P(1·x₀)·x₁)⋯ x_{n-1})`. -/
def prodF (P : ℕ) : (n : ℕ) → (Fin n → GI) → GI
  | 0, _ => oneP P
  | n + 1, x => gmulT P (prodF P n (fun i => x i.castSucc)) (x (Fin.last n))

/-! ## Base roots from `twiddle` -/

/-- `h₀ ≈ e^{-πi s/t}`. -/
def hRoot (P s t : ℕ) : GI := IntMul.HvdH.twiddle P (2 * t) (2 * t - s)
/-- `c ≈ e^{-2πi s/t}`. -/
def cRoot (P s t : ℕ) : GI := IntMul.HvdH.twiddle P t (t - s)

/-! ## The per-axis chirp table -/

/-- Axis table `[ĝ_0, …, ĝ_{t-1}]`, `ĝ_j ≈ e^{-πi s j²/t}` (`chirpL` from `1`, `h₀`, `c`). -/
def axTab (P s t : ℕ) : List GI := chirpL P (cRoot P s t) (hRoot P s t) (oneP P) t

theorem length_axTab (P s t : ℕ) : (axTab P s t).length = t := length_chirpL _ _ _ _ _

/-! ## Chirp entries -/

/-- The table value of `RC.chirp s t j`: the `Q_P`-product of the `d` axis-table factors. -/
def chirpEnt {d : ℕ} (P : ℕ) (s t : Fin d → ℕ) (j : (i : Fin d) → ZMod (t i)) : GI :=
  prodF P d (fun i => (axTab P (s i) (t i)).getD (j i).val 0)

/-! ## Twist tables -/

/-- `[1, ω, ω², …, ω^{n-1}]`, `ω ≈ e^{2πi j/k}`. -/
def twTab (P k j n : ℕ) : List GI := geoL P (IntMul.HvdH.twiddle P k j) (oneP P) n

theorem length_twTab (P k j n : ℕ) : (twTab P k j n).length = n := length_geoL _ _ _ _

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMTabP
/-!
# KFM 9c: the per-axis root-table program (`chirpL` recurrence in IL)

The recurrence `g_{k+1} = Q_Δ(g_k h_k)`, `h_{k+1} = Q_Δ(h_k c)` of `KFMTabM.chirpL` is run by
`chirpG pM n`:

* state: `0 = [g.re, g.im] ++ R0`, `pH = [h.re, h.im] ++ RH`, `pK = [c.re, c.im] ++ RK`,
  ruler `2^Δ` on `pR`;
* one iteration `chirpB` copies `g` to the output stack `pV` and replaces `(h, g)` by
  `(Q_Δ(h c), Q_Δ(g h))` with two `entryB` calls (eight `MulOK` products);
* after `n` iterations `pV` holds the entries in reverse order; `revP` moves them in order onto
  `pW`, and the state pairs are dropped.

`chirpG_runs`: `pW = gflat (chirpL Δ c h g n) ++ RW`, everything else restored, at cost
`n (8 φ + 3·10^5 (w + Δ + 1)) + 10^4 (n + 1)(w + 1)` when all states stay within `w` bits.

With `c = oneP Δ` the same program produces the geometric table `geoL` (`geoL_eq_chirpL`).
The state errors (`cst_err`) give the size bound `zsz ≤ Δ + 2` (`zsz_of_near`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFM

open IntMul KFC KFB KFT KIL

/-! ## Stacks -/

abbrev pH : Fin HS := 56
abbrev pK : Fin HS := 57
abbrev pU : Fin HS := 58
abbrev pV : Fin HS := 59

/-! ## Recurrence states -/

/-- One step `(h, g) ↦ (Q_Δ(h c), Q_Δ(g h))`. -/
def cstep (Δ : ℕ) (c : GI) (x : GI × GI) : GI × GI := (gmulT Δ x.1 c, gmulT Δ x.2 x.1)

/-- The state after `k` steps. -/
def cst (Δ : ℕ) (c h g : GI) (k : ℕ) : GI × GI := (cstep Δ c)^[k] (h, g)

/-! ## State errors and sizes -/

/-! ## Pair moves -/

section IL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- Copy the top pair of `X` onto `Y` (through `pU`). -/
def cpyB (X Y : Fin HS) : IStmt HS P :=
  .seq (.op (.mv X pU)) (.seq (.op (.dup X Y)) (.seq (.op (.dup pU Y)) (.op (.mv pU X))))

/-- Move the top pair of `X` onto `Y`, order kept (through `pU`). -/
def mvPB (X Y : Fin HS) : IStmt HS P :=
  .seq (.op (.mv X pU)) (.seq (.op (.mv X Y)) (.op (.mv pU Y)))

def cPair (a b : ℤ) : ℕ := 1000 * (zsz a + zsz b + 2)

/-! ## One iteration -/

/-- Move four items from `pO`: two onto `pH`, two onto `0`. -/
def mv4B : IStmt HS P :=
  .seq (.op (.mv pO pH)) (.seq (.op (.mv pO pH)) (.seq (.op (.mv pO 0)) (.op (.mv pO 0))))

/-- One iteration: output `g`, then `(h, g) ↦ (Q_Δ(h c), Q_Δ(g h))`. -/
def chirpB (pM : Fin P) : IStmt HS P :=
  .seq (cpyB 0 pV) (.seq (cpyB pH pW) (.seq (entryB pM) (.seq (cpyB pK pW) (.seq (mvPB pH 0)
    (.seq (entryB pM) mv4B)))))

def cChirpB (φ w Δ : ℕ) : ℕ := 2 * (4 * φ + 100000 * (w + Δ + 1)) + 10000 * (w + 1)

def GBnd (w : ℕ) (z : GI) : Prop := zsz z.1 ≤ w ∧ zsz z.2 ≤ w

/-! ## The loop, the reversal and the clean-up -/

/-- The output after `k` iterations. -/
def outL (Δ : ℕ) (c h g : GI) (k : ℕ) : List GI := (List.range k).map (fun i => (cst Δ c h g i).2)

/-- Drop the two state pairs and `c`. -/
def drop6B : IStmt HS P :=
  .seq (.op (.drop 0)) (.seq (.op (.drop 0)) (.seq (.op (.drop pH)) (.seq (.op (.drop pH))
    (.seq (.op (.drop pK)) (.op (.drop pK))))))

/-- **The table program**: `n` iterations, reversal onto `pW`, clean-up. -/
def chirpG (pM : Fin P) (n : ℕ) : IStmt HS P :=
  .seq (rpt pA pC pD n (chirpB pM)) (.seq (rpt pA pC pD n (mvPB pV pW)) drop6B)

def cChirpG (n φ w Δ : ℕ) : ℕ := n * (8 * φ + 300000 * (w + Δ + 1)) + 10000 * (n + 1) * (w + 1)

/-! ## Base roots by `twiddleP` -/

/-- Push `n, k, j` on `28, 29, 53`, run `twiddleP`, pop. -/
def twRS (n k j : ℕ) : RS :=
  .seq (.push 28 (.lit n)) (.seq (.push 29 (.lit k)) (.seq (.push 53 (.lit j)) (.seq twiddleP
    (.seq (.pop 53) (.seq (.pop 29) (.pop 28))))))

/-- Run `twRS` as IL code and move the root onto `X` (`re` on top). -/
def twC (n k j : ℕ) (X : Fin HS) : IStmt HS P :=
  .seq (RS.code (twRS n k j)) (.seq (.op (.mv 52 X)) (.op (.mv 51 X)))

def cTw (n k j : ℕ) : ℕ :=
  twiddleCost n (zsz (j : ℤ)) (zsz (k : ℤ)) +
    7 * 10 ^ 7 * (zsz (n : ℤ) + zsz (k : ℤ) + zsz (j : ℤ) + 2) ^ 2 + 220 * (n + 4)

/-! ## Size bounds along the recurrence -/

/-! ## The axis-table and twist-table programs -/

/-- **Axis table** `axTab Δ s t` (`≈ e^{-πi s j²/t}`, `j < t`) onto `pW`. -/
def axG (pM : Fin P) (Δ s t : ℕ) : IStmt HS P :=
  .seq (.op (.const 0 0)) (.seq (.op (.const 0 (2 ^ Δ))) (.seq (twC Δ (2 * t) (2 * t - s) pH)
    (.seq (twC Δ t (t - s) pK) (chirpG pM t))))

def cAx (Δ s t φ : ℕ) : ℕ :=
  cTw Δ (2 * t) (2 * t - s) + cTw Δ t (t - s) + cChirpG t φ (Δ + 2) Δ + (Δ + 6)

/-- **Twist table** `twTab Δ k j n` (`≈ e^{2πi j m/k}`, `m < n`) onto `pW`. -/
def twG (pM : Fin P) (Δ k j n : ℕ) : IStmt HS P :=
  .seq (.op (.const 0 0)) (.seq (.op (.const 0 (2 ^ Δ))) (.seq (twC Δ k j pH)
    (.seq (.op (.const pK 0)) (.seq (.op (.const pK (2 ^ Δ))) (chirpG pM n)))))

def cTwG (Δ k j n φ : ℕ) : ℕ := cTw Δ k j + cChirpG n φ (Δ + 2) Δ + (2 * Δ + 12)

end IL

end NLogN.KFM

end

section
-- Source module: Solutions.KFMTabQ
/-!
# KFM 9d: the `d`-axis chirp array — outer products of the axis tables

`chirpArr Δ d s t` is the row-major array (last axis innermost) of the chirp entries
`chirpEnt Δ s t j`, built by `d` outer products `oprod Δ A B = [Q_Δ(a b) | a ∈ A, b ∈ B]`
starting from `[1]`:

* **`chirpArr_get`**: entry `flatIx j` of `chirpArr` is `chirpEnt Δ s t j` (the `Q_Δ`-product of
  the `d` axis-table factors, `KFMTabM`);
* **`chirpArr_err`**: it is within `d (8T² + 2) 2^{-Δ}` of `RC.chirp s t j`;
* **`chirpArr_near`**: every entry is within that distance of a point of the unit disc, so all
  entries have `Δ + 2`-bit components (`NearU.bnd`).

The IL program is `chirpP` (below), one level `levP` per axis: `axG` (axis table), then for each
entry `a` of the current array a replicate / copy / `gmulP` / move-out round (`obB`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFM

open IntMul KFC KFB KFT KIL

/-! ## Outer products -/

/-- `[Q_Δ(a b) | a ∈ A, b ∈ B]`, `B` innermost. -/
def oprod (Δ : ℕ) (A B : List GI) : List GI := A.flatMap (fun a => B.map (gmulT Δ a))

/-! ## The chirp array -/

/-- The row-major chirp array (last axis innermost). -/
def chirpArr (Δ : ℕ) : (d : ℕ) → (Fin d → ℕ) → (Fin d → ℕ) → List GI
  | 0, _, _ => [oneP Δ]
  | d + 1, s, t => oprod Δ (chirpArr Δ d (fun i => s i.castSucc) (fun i => t i.castSucc))
      (axTab Δ (s (Fin.last d)) (t (Fin.last d)))

/-- The row-major flat index. -/
def flatIx : (d : ℕ) → (t : Fin d → ℕ) → ((i : Fin d) → ZMod (t i)) → ℕ
  | 0, _, _ => 0
  | d + 1, t, j => flatIx d (fun i => t i.castSucc) (fun i => j i.castSucc) * t (Fin.last d) +
      (j (Fin.last d)).val

/-! ## Errors and sizes -/

/-- `z` is within `e` of a point of the unit disc. -/
def NearU (Δ : ℕ) (e : ℝ) (z : GI) : Prop := ∃ Z : ℂ, ‖Z‖ ≤ 1 ∧ ‖vP Δ z - Z‖ ≤ e

/-! ## Generic list loops (counters `pA, pC, pD`) -/

section IL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- Stack `X` is not a counter of the inner `rpt`. -/
abbrev NC (X : Fin HS) : Prop := X ≠ pA ∧ X ≠ pC ∧ X ≠ pD

/-- `dup X Y; mv X Z` per item. -/
def dmB (X Y Z : Fin HS) : IStmt HS P := .seq (.op (.dup X Y)) (.op (.mv X Z))

/-! ## One outer-product round -/

abbrev pQ1 : Fin HS := 40
abbrev pQ2 : Fin HS := 41
abbrev pQ3 : Fin HS := 42

/-- Round for one entry `a` of the array on `pQ1` against the table on `pQ2` (length `b`):
the products `Q_Δ(a b_j)` are pushed (reversed) on `pQ3`. -/
def obB (pM : Fin P) (b : ℕ) : IStmt HS P :=
  .seq (mvPB pQ1 pH) (.seq (rpt pA pC pD b (cpyB pH 0)) (.seq (rpt pA pC pD (2 * b) (.op (.mv pQ2 pU)))
    (.seq (rpt pA pC pD (2 * b) (dmB pU pW pQ2)) (.seq (gmulP pM b)
    (.seq (rpt pA pC pD (2 * b) (.op (.mv 0 pQ3))) (.seq (.op (.drop pH)) (.op (.drop pH))))))))

def cOb (b w Δ φ : ℕ) : ℕ :=
  2000 * (w + 1) + (b * (1000 * (2 * w + 2) + 64) + 60 + cRpt b) +
    2 * ((2 * b) * (110 * (w + 1) + 64) + 60 + cRpt (2 * b)) +
    ((2 * b) * (410 * (w + 1) + 64) + 60 + cRpt (2 * b)) + cGmul b w Δ φ + 4 * (w + 1)

/-! ## The outer-product loop and one level -/

abbrev oA : Fin HS := 37
abbrev oC : Fin HS := 38
abbrev oD : Fin HS := 39

/-- `oprod Δ A B` (reversed) onto `pQ3`, consuming `A` from `pQ1`. -/
def oprodP (pM : Fin P) (n b : ℕ) : IStmt HS P := rpt NLogN.KFM.oA NLogN.KFM.oC NLogN.KFM.oD n (obB pM b)

/-- **One level**: the axis table of `(s, t)`, then `A ↦ oprod Δ A tab` on `pQ1`. -/
def levP (pM : Fin P) (Δ s t n : ℕ) : IStmt HS P :=
  .seq (axG pM Δ s t) (.seq (rpt pA pC pD (2 * t) (.op (.mv pW pU)))
    (.seq (rpt pA pC pD (2 * t) (.op (.mv pU pQ2))) (.seq (oprodP pM n t)
    (.seq (rpt pA pC pD (2 * (n * t)) (.op (.mv pQ3 pQ1)))
      (rpt pA pC pD (2 * t) (.op (.drop pQ2)))))))

def cLev (Δ s t n φ : ℕ) : ℕ :=
  cAx Δ s t φ + 2 * ((2 * t) * (110 * (Δ + 2 + 1) + 64) + 60 + cRpt (2 * t)) +
    (n * (cOb t (Δ + 2) Δ φ + 64) + 60 + cRpt n) +
    ((2 * (n * t)) * (110 * (Δ + 2 + 1) + 64) + 60 + cRpt (2 * (n * t))) +
    ((2 * t) * (2 * (Δ + 2) + 2 + 64) + 60 + cRpt (2 * t))

/-! ## All levels -/

/-- **The chirp-array program**: `chirpArr Δ d s t` onto `pQ1`. -/
def chirpP (pM : Fin P) (Δ : ℕ) : (d : ℕ) → (Fin d → ℕ) → (Fin d → ℕ) → IStmt HS P
  | 0, _, _ => .seq (.op (.const pQ1 0)) (.op (.const pQ1 (2 ^ Δ)))
  | d + 1, s, t => .seq (chirpP pM Δ d (fun i => s i.castSucc) (fun i => t i.castSucc))
      (levP pM Δ (s (Fin.last d)) (t (Fin.last d)) (∏ i : Fin d, t i.castSucc))

def cChirpP (Δ φ : ℕ) : (d : ℕ) → (Fin d → ℕ) → (Fin d → ℕ) → ℕ
  | 0, _, _ => Δ + 6
  | d + 1, s, t => cChirpP Δ φ d (fun i => s i.castSucc) (fun i => t i.castSucc) +
      cLev Δ (s (Fin.last d)) (t (Fin.last d)) (∏ i : Fin d, t i.castSucc) φ

/-! ## Moving the array to `pW`, and cost bounds -/

/-- `chirpArr` onto `pW` (for `gmulP`), `pQ1` restored. -/
def chirpTabP (pM : Fin P) (Δ d : ℕ) (s t : Fin d → ℕ) : IStmt HS P :=
  .seq (chirpP pM Δ d s t) (.seq (rpt pA pC pD (2 * ∏ i, t i) (.op (.mv pQ1 pU)))
    (rpt pA pC pD (2 * ∏ i, t i) (.op (.mv pU pW))))

def cChirpTab (Δ φ d : ℕ) (s t : Fin d → ℕ) : ℕ :=
  cChirpP Δ φ d s t + 2 * ((2 * ∏ i, t i) * (110 * (Δ + 2 + 1) + 64) + 60 + cRpt (2 * ∏ i, t i))

end IL

end NLogN.KFM

end

section
-- Source module: Solutions.KFMU1
/-!
# KFM U1: uniform counted repetition and uniform pointwise passes

`UNIFORM.md`: the count of a repetition is run-time data. `rptX X A C D b` is KFT's `rpt` with the
literal count replaced by a copy (`dup`) of the top of stack `X`.

* **`rptX_runs`**: as `rpt_runs`, from a state whose `X` holds `n`; cost `+ dupCost (zsz n) + 17`.
* **`mvBackU_runs`**, **`gmulPU_runs`**, **`itemPU_runs`**: KFM's `mvBack`/`gmulP`/`itemP` with the
  counts on `nX = 30` (`N`) and `nX2 = 31` (`2N`), and the instances **`shlPU_runs`**,
  **`roundPU_runs`**, **`smulPU_runs`**, **`gmulPU_kTable`**. The bodies (`entryB`, `mvB`, `shlB`,
  `roundB`, `smulB`) are KFM's, unchanged (stacks 43–53, 60–62; leaf procedures).

**Nesting.** Every spec here is frame-preserving: the final state is the initial one with only the
output stacks changed, for arbitrary contents of all other stacks (including the scratch 43–53,
60–62, whose contents are restored). So a pass may run inside a caller that keeps data on those
stacks, e.g. KFV's parameter stacks 50–55. The counters avoid KFV6Loop's stacks 20–23.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFT

open IntMul KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The repetition with its count read from the top of `X`. -/
def rptX (X A C D : Fin HS) (b : IStmt HS Pp) : IStmt HS Pp :=
  .seq (.op (.dup X A)) (.seq (pro A C D) (.seq (uloop C D b) (.seq (epi C D) (.op (.drop A)))))

end NLogN.KFT

namespace NLogN.KFM

open IntMul KFC KFB KFT KIL

/-- Count registers of the uniform passes (KFM range 20–35). -/
abbrev nX : Fin HS := 30
abbrev nX2 : Fin HS := 31

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- Uniform `gmulP`: counts `N` on `nX`, `2N` on `nX2`. -/
def gmulPU (pM : Fin P) : IStmt HS P :=
  .seq (rptX nX pA pC pD (entryB pM)) (rptX nX2 pA pC pD mvB)

/-- Uniform `itemP`: count `N` on `nX`. -/
def itemPU (body : IStmt HS P) : IStmt HS P :=
  .seq (rptX nX pA pC pD body) (rptX nX pA pC pD mvB)

/-- The cost of the counter copies of a uniform pass. -/
def cCnt (N : ℕ) : ℕ := dupCost (zsz (N : ℤ)) + 17

end NLogN.KFM

end


