    · exact Or.inl (Subring.sub_mem _ hjO (hconst a))
    · have h : ĵ⁻¹ ∈ SemistableModel.localRing X φ x := hJx.resolve_left hjO
      have hj0 : ĵ ≠ 0 := by
        intro h0; apply hjO; rw [h0]; exact Subring.zero_mem _
      rcases hloc (c * ĵ⁻¹) (Subring.mul_mem _ (hconst a) h) with ⟨w, hw, hcw⟩ | ⟨w, hw, h1w⟩
      · exfalso
        apply hjO
        have : ĵ = c * w := by
          calc ĵ = ĵ * (c * ĵ⁻¹ * w) := by rw [hcw, mul_one]
            _ = c * w := by rw [show c * ĵ⁻¹ * w = ĵ⁻¹ * (c * w) by ring, ← mul_assoc, mul_inv_cancel₀ hj0, one_mul]
        rw [this]; exact Subring.mul_mem _ (hconst a) hw
      · right
        have hmul : (ĵ - c) * (ĵ⁻¹ * w) = 1 := by
          rw [← h1w, sub_mul, sub_mul, one_mul, ← mul_assoc, mul_inv_cancel₀ hj0, one_mul, mul_assoc]
        rw [inv_eq_of_mul_eq_one_right hmul]
        exact Subring.mul_mem _ h hw

