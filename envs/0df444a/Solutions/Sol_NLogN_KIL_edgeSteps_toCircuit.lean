lemma coprime_den_inv {N : ℕ} {u : ℚ} (hu : u ≠ 0) (hn : Nat.Coprime u.num.natAbs N) :
    Nat.Coprime (u⁻¹).den N := by
  rw [Rat.den_inv_of_ne_zero hu]; exact hn

lemma coprime_den_neg {N : ℕ} {u : ℚ} (h : Nat.Coprime u.den N) : Nat.Coprime (-u).den N := by
  simpa [Rat.neg_den] using h

lemma coprime_den_mul {N : ℕ} {a b : ℚ} (ha : Nat.Coprime a.den N) (hb : Nat.Coprime b.den N) :
    Nat.Coprime (a * b).den N := (goodSub N).mul_mem ha hb

lemma redQ_neg {N : ℕ} {u : ℚ} (h : Nat.Coprime u.den N) : redQ N (-u) = -redQ N u := by
  have e : -u = ((-1 : ℤ) : ℚ) * u := by push_cast; ring
  rw [e, redQ_mul (by simp) h, redQ_intCast]; push_cast; ring

lemma redQ_one (N : ℕ) : redQ N 1 = 1 := by simpa using redQ_intCast N 1

lemma redQ_inv {N : ℕ} {u : ℚ} (hu : u ≠ 0) (hd : Nat.Coprime u.den N)
    (hn : Nat.Coprime u.num.natAbs N) : redQ N u⁻¹ = (redQ N u)⁻¹ := by
  symm
  apply ZMod.inv_eq_of_mul_eq_one
  rw [← redQ_mul hd (coprime_den_inv hu hn), mul_inv_cancel₀ hu, redQ_one]

/-- `fracZ` is the reduction of the rational `p / q`. -/
lemma redQ_eq_fracZ {N : ℕ} {r : ℚ} (h : Nat.Coprime r.den N) : redQ N r = fracZ N r.num r.den := by
  rw [redQ_eq h]; rfl

/-- `fracU` of the absolute numerator, denominator and sign is the reduction. -/
lemma redQ_eq_fracU {N : ℕ} {r : ℚ} (h : Nat.Coprime r.den N) :
    redQ N r = fracU N r.num.natAbs r.den (decide (r.num < 0)) := by
  rw [redQ_eq h]
  unfold redFun fracU
  by_cases hn : r.num < 0
  · rw [decide_eq_true hn, if_pos rfl]
    have e : r.num = -((r.num.natAbs : ℕ) : ℤ) := by omega
    conv_lhs => rw [e]
    rw [Int.cast_neg, Int.cast_natCast]; ring
  · rw [decide_eq_false hn]
    simp only [Bool.false_eq_true, if_false]
    have e : r.num = ((r.num.natAbs : ℕ) : ℤ) := by omega
    conv_lhs => rw [e]
    rw [Int.cast_natCast]; try ring

theorem rsh_eval {N : ℕ} (i : Fin (m + m)) (u : ℚ) (c : Fin (m + m) → ℚ)
    (hu : Nat.Coprime u.den N) (hc : ∀ j, j < i → Nat.Coprime (c j).den N) :
    (rsh i u c).eval N = redSh N i u c := by
  simp only [TSh.eval, redSh, rsh]
  congr 1
  · rw [redQ_eq_fracU hu]
  · funext j
    simp only [TSh.ctrl, dif_pos j.2, Fin.eta]
    split_ifs with hj
    · rw [redQ_eq_fracZ (hc j hj)]
    · rfl

namespace QStep

theorem tpl_eval {N : ℕ} : ∀ s : QStep m, s.Good N → s.tpl.eval N = s.red N
  | .sh i u c, h => rsh_eval i u c h.2.1 h.2.2.2
  | .sw _ _, _ => rfl

theorem red_rev {N : ℕ} : ∀ s : QStep m, s.Good N → (s.rev).red N = (s.red N).rev
  | .sh i u c, ⟨hu, hd, hn, hc⟩ => by
    simp only [NLogN.KIL.QStep.rev, red, redSh, Step.rev]
    rw [redQ_inv hu hd hn]
    congr 1
    funext j
    split_ifs with hj
    · rw [redQ_neg (coprime_den_mul (coprime_den_inv hu hn) (hc j hj)),
        redQ_mul (coprime_den_inv hu hn) (hc j hj), redQ_inv hu hd hn]
    · simp
  | .sw _ _, _ => rfl

theorem good_rev {N : ℕ} : ∀ s : QStep m, s.Good N → (s.rev).Good N
  | .sh i u c, ⟨hu, hd, hn, hc⟩ => by
    refine ⟨inv_ne_zero hu, coprime_den_inv hu hn, ?_, fun j hj =>
      coprime_den_neg (coprime_den_mul (coprime_den_inv hu hn) (hc j hj))⟩
    rw [Rat.num_inv, Int.natAbs_mul, Int.natAbs_sign_of_ne_zero (Rat.num_ne_zero.2 hu)]
    simpa using hd
  | .sw _ _, _ => trivial

end QStep

theorem revQ_red {N : ℕ} (l : List (QStep m)) (h : ∀ s ∈ l, s.Good N) :
    (revQ l).map (QStep.red N) = revSteps (l.map (QStep.red N)) := by
  simp only [revQ, revSteps, List.map_reverse, List.map_map]
  congr 1
  exact List.map_congr_left fun s hs => QStep.red_rev s (h s hs)

theorem revQ_good {N : ℕ} (l : List (QStep m)) (h : ∀ s ∈ l, s.Good N) :
    ∀ s ∈ revQ l, s.Good N := by
  intro s hs
  simp only [revQ, List.mem_reverse, List.mem_map] at hs
  obtain ⟨s', hs', rfl⟩ := hs
  exact QStep.good_rev s' (h s' hs')

theorem hQ_good {N : ℕ} {E : QMat m} (h : FGood N E) : ∀ s ∈ hQ E, s.Good N := by
  intro s hs
  simp only [hQ, List.mem_map, List.mem_reverse, List.mem_finRange, true_and] at hs
  obtain ⟨a, rfl⟩ := hs
  refine ⟨h.2.1 a, h.1 a a, h.2.2 a, fun j _ => ?_⟩
  induction j using Fin.addCases with
  | left b => simpa [hcQ, -Fin.natAdd_eq_addNat] using h.1 a b
  | right b => simp [hcQ, -Fin.natAdd_eq_addNat]

theorem dQ_good {N : ℕ} {E : QMat m} (h : FGood N E) : ∀ s ∈ dQ E, s.Good N := by
  intro s hs
  simp only [dQ, List.mem_map, List.mem_reverse, List.mem_finRange, true_and] at hs
  obtain ⟨a, rfl⟩ := hs
  refine ⟨h.2.1 a, h.1 a a, h.2.2 a, fun j _ => ?_⟩
  induction j using Fin.addCases with
  | left b => simp [dcQ, -Fin.natAdd_eq_addNat]
  | right b => simpa [dcQ, -Fin.natAdd_eq_addNat] using h.1 a b

theorem pivotQ_good {N : ℕ} (i j : Fin m) : ∀ s ∈ pivotQ (m := m) i j, s.Good N := by
  have hc : ∀ l : Fin (m + m), Nat.Coprime ((Pi.single (Fin.castAdd m i) (1 : ℚ) :
      Fin (m + m) → ℚ) l).den N := fun l => by
    by_cases h : l = Fin.castAdd m i
    · subst h; simp
    · simp [Pi.single_apply, h]
  intro s hs
  simp only [pivotQ, List.mem_cons, List.not_mem_nil, or_false] at hs
  rcases hs with rfl | rfl | rfl
  · exact ⟨one_ne_zero, by simp, by simp, fun l _ => hc l⟩
  · trivial
  · exact ⟨by norm_num, by simp, by simp, fun l _ => hc l⟩

theorem addQ_good {N : ℕ} (ps : List (Fin m × Fin m)) : ∀ s ∈ addQ (m := m) ps, s.Good N := by
  intro s hs
  simp only [addQ, List.mem_flatMap] at hs
  obtain ⟨p, -, hs⟩ := hs
  exact pivotQ_good p.1 p.2 s hs

theorem shearQ_good {N : ℕ} {E₁ E₂ : QMat m} (Pi : IMat m) (h₁ : FGood N E₁) (h₂ : FGood N E₂) :
    ∀ s ∈ shearQ E₁ Pi E₂, s.Good N := by
  intro s hs
  simp only [shearQ, List.mem_append] at hs
  rcases hs with (((h | h) | h) | h) | h
  · exact dQ_good h₂ s h
  · exact revQ_good _ (hQ_good h₁) s h
  · exact addQ_good _ s h
  · exact hQ_good h₁ s h
  · exact revQ_good _ (dQ_good h₂) s h

theorem blk_cc {N : ℕ} (P B C D : Matrix (Fin m) (Fin m) (ZMod N)) (i j : Fin m) :
    AModel.blk P B C D (Fin.castAdd m i) (Fin.castAdd m j) = P i j := by
  simp [AModel.blk, -Fin.natAdd_eq_addNat]

theorem blk_cn {N : ℕ} (P B C D : Matrix (Fin m) (Fin m) (ZMod N)) (i j : Fin m) :
    AModel.blk P B C D (Fin.castAdd m i) (Fin.natAdd m j) = B i j := by
  simp [AModel.blk, -Fin.natAdd_eq_addNat]

theorem blk_nc {N : ℕ} (P B C D : Matrix (Fin m) (Fin m) (ZMod N)) (i j : Fin m) :
    AModel.blk P B C D (Fin.natAdd m i) (Fin.castAdd m j) = C i j := by
  simp [AModel.blk, -Fin.natAdd_eq_addNat]

theorem blk_nn {N : ℕ} (P B C D : Matrix (Fin m) (Fin m) (ZMod N)) (i j : Fin m) :
    AModel.blk P B C D (Fin.natAdd m i) (Fin.natAdd m j) = D i j := by
  simp [AModel.blk, -Fin.natAdd_eq_addNat]

theorem hQ_red {N : ℕ} (E : QMat m) :
    (hQ E).map (QStep.red N) = hSteps (E.map (redQ N)) := by
  simp only [hQ, hSteps, hIdx, List.map_map]
  refine List.map_congr_left fun a _ => ?_
  simp only [Function.comp, QStep.red, redSh, shiftStep]
  rw [blk_cc]
  congr 1
  funext j
  induction j using Fin.addCases with
  | left b => simp only [hcQ, Fin.addCases_left, blk_cc, Matrix.map_apply]
  | right b =>
    simp only [hcQ, Fin.addCases_right, blk_cn, Matrix.zero_apply, redQ_zero, ite_self]

theorem dQ_red {N : ℕ} (E : QMat m) :
    (dQ E).map (QStep.red N) = dSteps (E.map (redQ N)) := by
  simp only [dQ, dSteps, dIdx, List.map_map]
  refine List.map_congr_left fun a _ => ?_
  simp only [Function.comp, QStep.red, redSh, shiftStep]
  rw [blk_nn]
  congr 1
  funext j
  induction j using Fin.addCases with
  | left b => simp only [dcQ, Fin.addCases_left, blk_nc, Matrix.zero_apply, redQ_zero, ite_self]
  | right b => simp only [dcQ, Fin.addCases_right, blk_nn, Matrix.map_apply]

theorem pivotQ_red {N : ℕ} (i j : Fin m) :
    (pivotQ i j).map (QStep.red N) = pivotSteps (Q := N) i j := by
  have hsingle : (fun l : Fin (m + m) => if l < Fin.natAdd m j then
      redQ N ((Pi.single (Fin.castAdd m i) (1 : ℚ) : Fin (m + m) → ℚ) l) else 0) =
      Pi.single (Fin.castAdd m i) 1 := by
    funext l
    by_cases h : l = Fin.castAdd m i
    · subst h; rw [if_pos (castAdd_lt_natAdd i j)]; simp [redQ_one]
    · simp [Pi.single_apply, h, redQ_zero]
  simp only [pivotQ, pivotSteps, List.map_cons, List.map_nil, QStep.red, redSh, hsingle, redQ_one]
  congr
  simpa using redQ_intCast N (-1)

theorem pivotsZ_eq {N : ℕ} (hN : 1 < N) {Pi : IMat m} (h01 : ∀ i j, Pi i j = 0 ∨ Pi i j = 1) :
    pivots (castM N Pi) = pivotsZ Pi := by
  have : Fact (1 < N) := ⟨hN⟩
  unfold pivots pivotsZ
  refine List.filter_congr fun p _ => ?_
  rcases h01 p.1 p.2 with h | h <;> simp [castM, h]

theorem shearQ_red {N : ℕ} (hN : 1 < N) {E₁ E₂ : QMat m} {Pi : IMat m} (h₁ : FGood N E₁)
    (h₂ : FGood N E₂) (h01 : ∀ i j, Pi i j = 0 ∨ Pi i j = 1) :
    (shearQ E₁ Pi E₂).map (QStep.red N) =
      shearSteps (E₁.map (redQ N)) (castM N Pi) (E₂.map (redQ N)) := by
  simp only [shearQ, shearSteps, List.map_append, revQ_red _ (hQ_good h₁),
    revQ_red _ (dQ_good h₂), hQ_red, dQ_red, pivotsZ_eq hN h01, addQ, addSteps, List.map_flatMap,
    pivotQ_red]

/-- The reduction mod `N ∣ Q` of the reduction mod `Q`. -/
lemma castHom_redQ {Q N : ℕ} [NeZero Q] (h : N ∣ Q) {r : ℚ} (hr : Nat.Coprime r.den Q) :
    ZMod.castHom h (ZMod N) (redQ Q r) = redQ N r := by
  have hrN : Nat.Coprime r.den N := Nat.Coprime.coprime_dvd_right h hr
  apply cancel_coprime hrN
  rw [redQ_eq hrN, redFun_mul_den hrN, redQ_eq hr]
  have := congrArg (ZMod.castHom h (ZMod N)) (redFun_mul_den hr)
  rw [map_mul] at this
  simpa using this

lemma castM_map_liftZ {Q N : ℕ} [NeZero Q] (h : N ∣ Q) {E : QMat m}
    (hE : ∀ i j, Nat.Coprime (E i j).den Q) :
    castM N (E.map (liftZ Q)) = E.map (redQ N) := by
  rw [castM_liftZ h]
  ext i j
  simp only [Matrix.map_apply]
  exact castHom_redQ h (hE i j)

lemma fgood_of {q b N : ℕ} (hN : N ∣ q ^ b) {E : QMat m}
    (hd : ∀ i j, Nat.Coprime (E i j).den q) (hz : ∀ i, E i i ≠ 0)
    (hn : ∀ i, Nat.Coprime (E i i).num.natAbs q) : FGood N E :=
  ⟨fun i j => Nat.Coprime.coprime_dvd_right hN ((hd i j).pow_right b), hz,
    fun i => Nat.Coprime.coprime_dvd_right hN ((hn i).pow_right b)⟩

