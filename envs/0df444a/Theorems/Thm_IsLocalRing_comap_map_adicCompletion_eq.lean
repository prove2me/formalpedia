-- title:
--   Contraction of an extended ideal along adic completion
-- statement:
--   Let $R$ be a commutative ring that is Noetherian and local, so that it has a unique maximal ideal $\mathfrak m =$ `IsLocalRing.maximalIdeal R`, and let $I$ be an ideal of $R$. Write $\hat R =$ `AdicCompletion (IsLocalRing.maximalIdeal R) R` for the $\mathfrak m$-adic completion of $R$, regarded as an $R$-algebra via the canonical structure map $\iota =$ `algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)`. The assertion is that extending $I$ along $\iota$ and then contracting back gives $I$ again: the preimage under $\iota$ of the ideal $I\hat R$ of $\hat R$ generated by the image $\iota(I)$ equals $I$. Equivalently, $I\hat R \cap R = I$ in the usual shorthand; in particular distinct ideals of a Noetherian local ring have distinct extensions to the completion, and divisibility in $\hat R$ between elements of $R$ implies divisibility in $R$.
--
--   This is the standard consequence of faithful flatness of the completion map $R \to \hat R$ of a Noetherian local ring: extension followed by contraction is the identity on ideals. It is used in the project as a descent device for passing statements about ideals (divisibility, equality of ideals) from the completion of a local ring back to the ring itself, for instance in the analysis of crossing presentations and of orders attached to models of a node.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_IsLocalRing_comap_map_adicCompletion_eq.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem IsLocalRing.comap_map_adicCompletion_eq
    {R : Type*} [CommRing R] [IsNoetherianRing R] [IsLocalRing R] (I : Ideal R) :
    (I.map (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))).comap
      (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) = I := by sorry
