-- title:
--   Random-tree layer of this mission (bridge to the shared Definition 2.5)
-- statement:
--   This module contains no new definition. It makes the shared definition of a **conditionally independent random tree with average offspring numbers bounded by $\Delta$** (Definition 2.5, item `IsingLTL.FreeEntropy.CondIndepTree`, `IsCondIndepTree μ Δ`) and this mission's Ulam–Harris tree layer (`IsingLTL.BeliefProp.UlamHarrisTree`) available together to the theorems of §4 (Lemma 4.3, Theorem 4.2, Corollary 4.5), which import it.
--
--   It records one auxiliary fact, proved: the $\sigma$-algebra $\sigma(\omega(w): |w|<k)$ generated by the offspring coordinates of all words of length $<k$ is contained in the product $\sigma$-algebra on offspring functions $\omega:\mathbb N^{<\mathbb N}\to\mathbb N$.
--
--   **Formalization Note** The class of random trees used by the statements is the shared `IsingLTL.FreeEntropy.IsCondIndepTree`, whose conditioning $\sigma$-algebra is $\sigma(\mathsf T(k))$ (offspring numbers masked to $0$ off the tree); the auxiliary $\sigma$-algebra above is not used by any statement.
-- source:
--   Dembo & Montanari, Ising Models on Locally Tree-Like Graphs, arXiv:0804.4726v3, p. 6, Definition 2.5

import Mathlib
import Definitions.Def_IsingLTL_BeliefProp_UlamHarrisTree
import Definitions.Def_IsingLTL_FreeEntropy_CondIndepTree

namespace IsingLTL.BeliefProp

open MeasureTheory ProbabilityTheory

theorem genSigma_le (k : ℕ) :
    IsingLTL.FreeEntropy.genSigma k ≤ (inferInstance : MeasurableSpace (List ℕ → ℕ)) :=
  Measurable.comap_le (measurable_pi_lambda _ (fun w => measurable_pi_apply w.1))

end IsingLTL.BeliefProp


