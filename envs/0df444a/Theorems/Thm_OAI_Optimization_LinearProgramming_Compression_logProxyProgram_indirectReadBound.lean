theorem logProxyProgram_indirectReadBound [Field K] [IsStrictOrderedRing K] (fuel k : ℕ) (s : State K) (hp : s.pc = 0)
    (hf : s.index 0 = fuel) (hk : s.index 1 = k) {t : State K} {n : ℕ}
    (hr : runExactly logProxyProgram s n = some t) {dst ptr : ℕ}
