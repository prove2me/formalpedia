-- title:
--   Kernel of a surjection onto $\mathbb{Z} \oplus \mathbb{Z}$
-- statement:
--   Let $K$ be a group generated by two of its elements, and let $\varphi$ be a surjective
--   group homomorphism from $K$ onto $\mathbb{Z} \oplus \mathbb{Z}$. Then the kernel of $\varphi$
--   is the commutator subgroup of $K$.
--
--   The two generators are not required to be distinct. Cannon-Floyd-Parry state this inside the
--   proof of Theorem 4.1 as something easy to see; it is recorded separately because it is a fact
--   about abstract groups with no reference to the unit interval.
-- source:
--   Cannon, J. W., Floyd, W. J., Parry, W. R., Introductory notes on Richard Thompson's groups, L'Enseignement Mathematique (2) 42 (1996) 215-256, https://doi.org/10.5169/seals-87877, inside the proof of Theorem 4.1, p. 228

import Mathlib

namespace CannonFloydParry

theorem ker_eq_commutator_of_two_generators_of_surjective {K : Type*} [Group K] (a b : K)
    (hgen : Subgroup.closure {a, b} = ⊤)
    (φ : K →* Multiplicative (ℤ × ℤ)) (hφ : Function.Surjective φ) :
    φ.ker = commutator K := by
  sorry

end CannonFloydParry
