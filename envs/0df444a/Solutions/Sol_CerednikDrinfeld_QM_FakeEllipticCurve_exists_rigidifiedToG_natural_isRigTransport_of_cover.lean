  obtain ⟨ρ₁, hρ₁'⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.Rigidification.exists_isPullbackVia_of_isPullbackVia
    𝒪 π Onr Λ A₀ L₁ L m₁ (φ₁.comp ψ) x₁.1 E₁ k₁ hk₁ x₁.2
