theorem logRangeProgram_scalarBound {mag : ℚ} (hm : 0 < mag) (fuel B : ℕ) (s : State ℚ)
    (hp : s.pc = 0) (ho : s.output = none) (hd : s.data 0 = mag) (hf : s.index 0 = fuel)
