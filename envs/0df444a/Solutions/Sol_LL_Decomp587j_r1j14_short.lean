private lemma buchstabIntegral_r1j14_eq_iterated {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {φ : ℝ} (hφ : 2 ≤ φ) :
    buchstabIntegral ω 1 (fun j => (r1j14_lo j : ℝ)) (fun j => (r1j14_hi j : ℝ)) φ =
      ∫ x0 in Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out), (1 / x0) * F_fn ω (φ - x0) := by
  let e : (Fin 3 → ℝ) ≃ᵐ ℝ × (ℝ × ℝ) :=
    (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).trans
      (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) (MeasurableEquiv.finTwoArrow))
  have hmp : MeasurePreserving e volume volume := by
    have h1 := MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0
    have h2 : MeasurePreserving
        (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) (MeasurableEquiv.finTwoArrow (α := ℝ)))
        (volume.prod volume) (volume.prod (volume.prod volume)) :=
      (MeasurePreserving.id volume).prod (MeasureTheory.volume_preserving_finTwoArrow ℝ)
    exact h2.comp h1
  have hlo0 : (r1j14_lo 0 : ℝ) = (A0_num : ℝ) / D_out := by simp [r1j14_lo, A0_num, D_out]; norm_num
  have hhi0 : (r1j14_hi 0 : ℝ) = (B0_num : ℝ) / D_out := by simp [r1j14_hi, B0_num, D_out]; norm_num
  have hlo1 : (r1j14_lo 1 : ℝ) = (A1_num : ℝ) / D_in := by simp [r1j14_lo, A1_num, D_in]; norm_num
  have hhi1 : (r1j14_hi 1 : ℝ) = (B1_num : ℝ) / D_in := by simp [r1j14_hi, B1_num, D_in]; norm_num
  have hlo2 : (r1j14_lo 2 : ℝ) = (A1_num : ℝ) / D_in := by simp [r1j14_lo, A1_num, D_in]; norm_num
  have hhi2 : (r1j14_hi 2 : ℝ) = (B1_num : ℝ) / D_in := by simp [r1j14_hi, B1_num, D_in]; norm_num
  set Sprod : Set (ℝ × (ℝ × ℝ)) :=
    Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out) ×ˢ
    tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in)
  have he_apply : ∀ x : Fin 3 → ℝ, e x = (x 0, (x 1, x 2)) := by
    intro x; rfl
  have hdom : domain (fun j => (r1j14_lo j : ℝ)) (fun j => (r1j14_hi j : ℝ)) = e ⁻¹' Sprod := by
    ext x
    simp only [domain, Sprod, tri2, mem_ofPred_eq, mem_preimage, mem_prod, mem_Icc, he_apply]
    constructor
    · rintro ⟨hmon, hbox⟩
      have h0 := hbox 0; rw [hlo0, hhi0] at h0
      have h1 := hbox 1; rw [hlo1, hhi1] at h1
      have h2 := hbox 2; rw [hlo2, hhi2] at h2
      exact ⟨h0, h1.1, hmon (by decide : (1 : Fin 3) ≤ 2), h2.2⟩
    · rintro ⟨h0, h1lo, h12, h2hi⟩
      have hgap : (B0_num : ℝ) / D_out ≤ (A1_num : ℝ) / D_in := by
        unfold B0_num D_out A1_num D_in; norm_num
      refine ⟨?_, ?_⟩
      · intro i j hij
        fin_cases i <;> fin_cases j <;> simp at hij ⊢ <;> linarith
      · intro j
        fin_cases j
        · change (r1j14_lo 0 : ℝ) ≤ x 0 ∧ x 0 ≤ (r1j14_hi 0 : ℝ); rw [hlo0, hhi0]; exact h0
        · change (r1j14_lo 1 : ℝ) ≤ x 1 ∧ x 1 ≤ (r1j14_hi 1 : ℝ); rw [hlo1, hhi1]; exact ⟨h1lo, le_trans h12 h2hi⟩
        · change (r1j14_lo 2 : ℝ) ≤ x 2 ∧ x 2 ≤ (r1j14_hi 2 : ℝ); rw [hlo2, hhi2]; exact ⟨le_trans h1lo h12, h2hi⟩
  let g3 : ℝ × (ℝ × ℝ) → ℝ := fun q =>
    ω ((φ - q.1 - q.2.1 - q.2.2) / q.2.1) / (q.1 * q.2.1 * q.2.1 * q.2.2)
  have hfun_eq : (fun x : Fin 3 → ℝ =>
      ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩)) = fun x => g3 (e x) := by
    funext x
    have hidx1 : (⟨1, by omega⟩ : Fin 3) = 1 := rfl
    simp only [g3, he_apply, Fin.sum_univ_three, Fin.prod_univ_three, hidx1]
    congr 1
    · congr 1; ring
    · ring
  unfold buchstabIntegral
  rw [hdom, hfun_eq]
  have hpre := hmp.setIntegral_preimage_emb e.measurableEmbedding g3 Sprod
  rw [hpre]
  have hint_g3 : IntegrableOn g3 Sprod volume := by
    apply ContinuousOn.integrableOn_compact (isCompact_Icc.prod (tri2_compact _ _))
    have hA0 : (0 : ℝ) < (A0_num : ℝ) / D_out := by unfold A0_num D_out; norm_num
