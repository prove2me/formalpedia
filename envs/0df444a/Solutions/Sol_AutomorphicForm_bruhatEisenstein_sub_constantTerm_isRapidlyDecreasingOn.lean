p2m_open "Complex Function.Complex"

private def dPhiMat (t : ℝ) : Matrix (Fin 2) (Fin 2) ℂ :=
  !![Complex.exp (t * Complex.I), 0; 0, Complex.exp (-(t * Complex.I))]

private theorem dPhiMat_zero : dPhiMat 0 = 1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [dPhiMat]

private theorem dPhiMat_add (s t : ℝ) : dPhiMat (s + t) = dPhiMat s * dPhiMat t := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [dPhiMat, Matrix.mul_apply, Fin.sum_univ_two, ← Complex.exp_add] <;>
    ring_nf

private def dPhiGL (t : ℝ) : GL (Fin 2) ℂ :=
  ⟨dPhiMat t, dPhiMat (-t),
    by rw [← dPhiMat_add, add_neg_cancel, dPhiMat_zero],
    by rw [← dPhiMat_add, neg_add_cancel, dPhiMat_zero]⟩

private theorem dPhiGL_coe (t : ℝ) : (dPhiGL t : Matrix (Fin 2) (Fin 2) ℂ) = dPhiMat t := rfl

private theorem dPhiGL_zero : dPhiGL 0 = 1 := Units.ext dPhiMat_zero

private theorem dPhiGL_add (s t : ℝ) : dPhiGL (s + t) = dPhiGL s * dPhiGL t := Units.ext (dPhiMat_add s t)

private theorem dPhiGL_periodic : Function.Periodic dPhiGL (2 * Real.pi) := fun t => by
  refine Units.ext ?_
  show dPhiMat (t + 2 * Real.pi) = dPhiMat t
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [dPhiMat, Complex.ofReal_add, add_mul, Complex.exp_add, Complex.exp_two_pi_mul_I,
      Complex.ofReal_mul, Complex.ofReal_ofNat, Complex.exp_neg, inv_one]

private theorem continuous_dPhiMat : Continuous dPhiMat := by
  refine continuous_matrix fun i j => ?_
  fin_cases i <;> fin_cases j <;> simp [dPhiMat] <;> fun_prop

private def rotGLC (β : ℝ) : GL (Fin 2) ℂ :=
  Units.map (RingHom.mapMatrix (algebraMap ℝ ℂ)).toMonoidHom (RealIwasawa.rotGL β)

private theorem rotGLC_coe (β : ℝ) :
    (rotGLC β : Matrix (Fin 2) (Fin 2) ℂ) = (RealIwasawa.rot β).map (algebraMap ℝ ℂ) := rfl

private theorem rotGLC_zero : rotGLC 0 = 1 := by rw [rotGLC, RealIwasawa.rotGL_zero, map_one]

private theorem rotGLC_add (s t : ℝ) : rotGLC (s + t) = rotGLC s * rotGLC t := by
  rw [rotGLC, RealIwasawa.rotGL_add, map_mul]
  rfl

private theorem rotGLC_periodic : Function.Periodic rotGLC (2 * Real.pi) := fun t => by
  rw [rotGLC, rotGLC, PlaceSplit.rotGL_periodic t]

private theorem rotGLC_inv (β : ℝ) : (rotGLC β)⁻¹ = rotGLC (-β) :=
  (eq_inv_of_mul_eq_one_right (by rw [← rotGLC_add, add_neg_cancel, rotGLC_zero])).symm

private theorem continuous_rotGLC : Continuous rotGLC := by
  rw [Units.continuous_iff]
  refine ⟨?_, ?_⟩
  · exact Continuous.matrix_map RealIwasawa.continuous_rot (continuous_algebraMap ℝ ℂ)
  · have h : ∀ β : ℝ, (((rotGLC β)⁻¹ : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)
        = (RealIwasawa.rot (-β)).map ⇑(algebraMap ℝ ℂ) := fun β => by rw [rotGLC_inv]; rfl
    simp only [h]
    exact Continuous.matrix_map (RealIwasawa.continuous_rot.comp continuous_neg)
      (continuous_algebraMap ℝ ℂ)

private theorem isRowIsometry_dPhiGL (t : ℝ) : IsRowIsometry (dPhiGL t) := by
  constructor
  · rw [dPhiGL_coe, dPhiMat, Matrix.det_fin_two_of]
    rw [← Complex.exp_add, add_neg_cancel, Complex.exp_zero, mul_zero, sub_zero, norm_one]
  · intro x y
    rw [dPhiGL_coe]
    simp only [dPhiMat, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.of_apply, mul_zero, add_zero, zero_add]
    rw [norm_mul, norm_mul, Complex.norm_exp_ofReal_mul_I,
      show -((t : ℂ) * Complex.I) = ((-t : ℝ) : ℂ) * Complex.I by push_cast; ring,
      Complex.norm_exp_ofReal_mul_I, mul_one, mul_one]

private theorem isRowIsometry_rotGLC (β : ℝ) : IsRowIsometry (rotGLC β) := by
  constructor
  · rw [rotGLC_coe, Matrix.det_fin_two]
    simp only [Matrix.map_apply, RealIwasawa.rot, Matrix.cons_val', Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.of_apply]
    rw [← map_mul, ← map_mul, ← map_sub]
    have h : Real.cos β * Real.cos β - -Real.sin β * Real.sin β = 1 := by
      nlinarith [Real.sin_sq_add_cos_sq β]
    rw [h, map_one, norm_one]
  · intro x y
    rw [rotGLC_coe]
    simp only [Matrix.map_apply, RealIwasawa.rot, Matrix.cons_val', Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.of_apply]
    rw [← Complex.normSq_eq_norm_sq, ← Complex.normSq_eq_norm_sq, ← Complex.normSq_eq_norm_sq,
      ← Complex.normSq_eq_norm_sq]
    simp only [Complex.coe_algebraMap, Complex.normSq_apply, Complex.add_re, Complex.add_im,
      Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im]
    linear_combination (x.re ^ 2 + x.im ^ 2 + y.re ^ 2 + y.im ^ 2) * Real.sin_sq_add_cos_sq β

private theorem specialUnitaryGroup_ext_of_row_one {k k' : Matrix (Fin 2) (Fin 2) ℂ}
    (hk : k ∈ Matrix.specialUnitaryGroup (Fin 2) ℂ)
    (hk' : k' ∈ Matrix.specialUnitaryGroup (Fin 2) ℂ)
    (h10 : k 1 0 = k' 1 0) (h11 : k 1 1 = k' 1 1) : k = k' := by
  have key : ∀ m : Matrix (Fin 2) (Fin 2) ℂ, m ∈ Matrix.specialUnitaryGroup (Fin 2) ℂ →
      m 0 0 = starRingEnd ℂ (m 1 1) ∧ m 0 1 = -starRingEnd ℂ (m 1 0) := by
    intro m hm
    obtain ⟨hu, hdet⟩ := Matrix.mem_specialUnitaryGroup_iff.1 hm
    have hmul : m * m.conjTranspose = 1 := Matrix.mem_unitaryGroup_iff.1 hu
    have hdet2 : m 0 0 * m 1 1 - m 0 1 * m 1 0 = 1 := by
      rw [← Matrix.det_fin_two]; exact hdet
    have hr2 : m 0 0 * starRingEnd ℂ (m 1 0) + m 0 1 * starRingEnd ℂ (m 1 1) = 0 := by
      have h := congrFun (congrFun hmul 0) 1
      simpa [Matrix.mul_apply, Matrix.conjTranspose_apply, Fin.sum_univ_two,
        Matrix.one_apply] using h
    have hr4 : m 1 0 * starRingEnd ℂ (m 1 0) + m 1 1 * starRingEnd ℂ (m 1 1) = 1 := by
      have h := congrFun (congrFun hmul 1) 1
      simpa [Matrix.mul_apply, Matrix.conjTranspose_apply, Fin.sum_univ_two,
        Matrix.one_apply] using h
    constructor
    · linear_combination m 1 0 * hr2 - m 0 0 * hr4 + starRingEnd ℂ (m 1 1) * hdet2
    · linear_combination m 1 1 * hr2 - m 0 1 * hr4 - starRingEnd ℂ (m 1 0) * hdet2
  obtain ⟨ha, hb⟩ := key k hk
  obtain ⟨ha', hb'⟩ := key k' hk'
  ext i j
  fin_cases i <;> fin_cases j
  · exact ha.trans ((congrArg (starRingEnd ℂ) h11).trans ha'.symm)
  · exact hb.trans ((congrArg (fun z => -starRingEnd ℂ z) h10).trans hb'.symm)
  · exact h10
  · exact h11

private theorem exists_smooth_circle_lift {x y : ℝ → ℝ} (hx : ContDiff ℝ ∞ x) (hy : ContDiff ℝ ∞ y)
    (hcirc : ∀ t, x t ^ 2 + y t ^ 2 = 1) :
    ∃ ψ : ℝ → ℝ, ContDiff ℝ ∞ ψ ∧ (∀ t, Real.cos (ψ t) = x t) ∧
      (∀ t, Real.sin (ψ t) = y t) ∧
      ∀ t, deriv ψ t = x t * deriv y t - y t * deriv x t := by
  have hxd : ∀ t, HasDerivAt x (deriv x t) t := fun t =>
    (hx.differentiable (by simp) t).hasDerivAt
  have hyd : ∀ t, HasDerivAt y (deriv y t) t := fun t =>
    (hy.differentiable (by simp) t).hasDerivAt
  set g : ℝ → ℝ := fun t => x t * deriv y t - y t * deriv x t with hg_def
  have hg : ContDiff ℝ ∞ g :=
    (hx.mul (contDiff_infty_iff_deriv.1 hy).2).sub (hy.mul (contDiff_infty_iff_deriv.1 hx).2)
  have hortho : ∀ t, x t * deriv x t + y t * deriv y t = 0 := by
    intro t
    have hsq : HasDerivAt (fun t => x t ^ 2 + y t ^ 2)
        (2 * x t * deriv x t + 2 * y t * deriv y t) t := by
      have h1 := ((hxd t).pow 2).add ((hyd t).pow 2)
      have h__ := h1
      try simp [pow_one, mul_comm, mul_assoc, mul_left_comm] at h__
      try simp [pow_one, mul_comm, mul_assoc, mul_left_comm]
      exact h__
    have hconst : (fun t => x t ^ 2 + y t ^ 2) = fun _ => (1 : ℝ) := funext hcirc
    rw [hconst] at hsq
    have h0 := hsq.unique (hasDerivAt_const t 1)
    linarith
  set z₀ : ℂ := ⟨x 0, y 0⟩ with hz₀
  have hz₀norm : ‖z₀‖ = 1 := by
    have : Complex.normSq z₀ = 1 := by
      simp only [Complex.normSq_mk, hz₀]
      have := hcirc 0
      nlinarith
    rw [Complex.norm_def, this, Real.sqrt_one]
  have hz₀ne : z₀ ≠ 0 := by
    intro h
    rw [h, norm_zero] at hz₀norm
    exact zero_ne_one hz₀norm
  set ψ₀ : ℝ := Complex.arg z₀ with hψ₀
  have hcos₀ : Real.cos ψ₀ = x 0 := by
    rw [hψ₀, Complex.cos_arg hz₀ne, hz₀norm, div_one]
  have hsin₀ : Real.sin ψ₀ = y 0 := by
    rw [hψ₀, Complex.sin_arg, hz₀norm, div_one]
  set ψ : ℝ → ℝ := fun t => ψ₀ + ∫ s in (0:ℝ)..t, g s with hψ_def
  have hψd : ∀ t, HasDerivAt ψ (g t) t := by
    intro t
    have h := intervalIntegral.integral_hasDerivAt_right
      (hg.continuous.intervalIntegrable 0 t)
      (hg.continuous.stronglyMeasurableAtFilter _ _)
      hg.continuous.continuousAt
    exact h.const_add ψ₀
  have hψs : ContDiff ℝ ∞ ψ := by
    rw [contDiff_infty_iff_deriv]
    refine ⟨fun t => (hψd t).differentiableAt, ?_⟩
    have : deriv ψ = g := funext fun t => (hψd t).deriv
    rw [this]; exact hg
  set u : ℝ → ℝ := fun t => x t * Real.cos (ψ t) + y t * Real.sin (ψ t) with hu_def
  have hud : ∀ t, HasDerivAt u
      (deriv x t * Real.cos (ψ t) + x t * (-Real.sin (ψ t) * g t)
        + (deriv y t * Real.sin (ψ t) + y t * (Real.cos (ψ t) * g t))) t := by
    intro t
    have hcos : HasDerivAt (fun t => Real.cos (ψ t)) (-Real.sin (ψ t) * g t) t :=
      (Real.hasDerivAt_cos (ψ t)).comp t (hψd t)
    have hsin : HasDerivAt (fun t => Real.sin (ψ t)) (Real.cos (ψ t) * g t) t :=
      (Real.hasDerivAt_sin (ψ t)).comp t (hψd t)
    exact ((hxd t).mul hcos).add ((hyd t).mul hsin)
  have hu0 : ∀ t, deriv u t = 0 := by
    intro t
    rw [(hud t).deriv]
    have h1 := hortho t
    have h2 := hcirc t
    linear_combination (x t * Real.cos (ψ t) + y t * Real.sin (ψ t)) * h1
      - (deriv x t * Real.cos (ψ t) + deriv y t * Real.sin (ψ t)) * h2
  have huconst : ∀ t, u t = 1 := by
    intro t
    have h := is_const_of_deriv_eq_zero (fun s => (hud s).differentiableAt) hu0 t 0
    rw [h]
    show x 0 * Real.cos (ψ 0) + y 0 * Real.sin (ψ 0) = 1
    have hψ0 : ψ 0 = ψ₀ := by
      simp [hψ_def, intervalIntegral.integral_same]
    rw [hψ0, hcos₀, hsin₀]
    have := hcirc 0
    nlinarith
  have hkey : ∀ t, Real.cos (ψ t) = x t ∧ Real.sin (ψ t) = y t := by
    intro t
    have hsum : (x t - Real.cos (ψ t)) ^ 2 + (y t - Real.sin (ψ t)) ^ 2 = 0 := by
      have h1 := hcirc t
      have h2 := huconst t
      have h3 := Real.sin_sq_add_cos_sq (ψ t)
      nlinarith
    have h1 : (x t - Real.cos (ψ t)) ^ 2 = 0 ∧ (y t - Real.sin (ψ t)) ^ 2 = 0 := by
      constructor <;> nlinarith [sq_nonneg (x t - Real.cos (ψ t)),
        sq_nonneg (y t - Real.sin (ψ t))]
    exact ⟨(sub_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 h1.1)).symm,
      (sub_eq_zero.1 (pow_eq_zero_iff two_ne_zero |>.1 h1.2)).symm⟩
  exact ⟨ψ, hψs, fun t => (hkey t).1, fun t => (hkey t).2,
    fun t => by rw [(hψd t).deriv]⟩

