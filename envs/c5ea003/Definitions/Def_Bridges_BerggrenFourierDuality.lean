/-! ## Section 1: Core Definitions -/

/-- A Berggren character is a function `χ : Q → K` that is a simultaneous
eigenvector for the three generator actions: for each generator `g`,
`χ (g q) = eig_g * χ q` for some eigenvalue `eig_g`. This is the correct
finite spectral notion for transition-system observables. -/
structure IsBerggrenCharacter {Q : Type*} {K : Type*} [Mul K]
    (actA actB actC : Q → Q) (chi : Q → K) : Prop where
  /-- Eigenvalue for generator A -/
  eigA : ∃ lA : K, ∀ q : Q, chi (actA q) = lA * chi q
  /-- Eigenvalue for generator B -/
  eigB : ∃ lB : K, ∀ q : Q, chi (actB q) = lB * chi q
  /-- Eigenvalue for generator C -/
  eigC : ∃ lC : K, ∀ q : Q, chi (actC q) = lC * chi q

/-- A family of functions separates points pairwise if for every pair of
distinct elements, some function in the family distinguishes them. -/
def PairwiseSeparatedBy {Q K : Type*}
    (chars : Finset (Q → K)) : Prop :=
  ∀ x y : Q, x ≠ y → ∃ chi ∈ chars, chi x ≠ chi y

