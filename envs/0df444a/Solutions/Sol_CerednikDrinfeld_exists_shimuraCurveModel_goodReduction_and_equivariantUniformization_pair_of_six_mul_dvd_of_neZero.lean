    {T : Type} [AddCommGroup T] {galT : S →* AddAut T}
    {E𝒞 V𝒞 : Type} [Fintype E𝒞] [DecidableEq E𝒞] [Fintype V𝒞] [DecidableEq V𝒞] (𝒞 : DegeneracyData E𝒞 V𝒞)
