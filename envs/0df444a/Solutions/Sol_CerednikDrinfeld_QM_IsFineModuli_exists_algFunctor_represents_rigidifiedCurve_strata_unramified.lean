variable {r N : ℕ} (𝒪 : Type) [CommRing 𝒪] (π : 𝒪) (Onr : Type) [CommRing Onr] [Algebra 𝒪 Onr]
  {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
  (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})) (n : ℕ)
  (C : Type) [CommRing C] [Algebra 𝒪 C] (ψ : Onr →ₐ[𝒪] C)
  {MC : Scheme.{0}} (g : MC ⟶ Spec (CommRingCat.of C)) (X : ℕ → Scheme.{0}) (ξ : ∀ d, X d ⟶ MC)
  (tM : ∀ (T : Type) [CommRing T] [Algebra C T],
    FakeEllipticCurve.WithFullLevel Λ N n T → SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) g)
  (xOf : ∀ (T : Type) [CommRing T] [Algebra C T] [Algebra 𝒪 T] [IsScalarTower 𝒪 C T]
    (ψT : Onr →ₐ[𝒪] T) (_ : ψT = (IsScalarTower.toAlgHom 𝒪 C T).comp ψ)
    (u : FakeEllipticCurve.WithFullLevel Λ N n T) (ρ : FakeEllipticCurve.Rigidification r π A₀ ψT u.1),
    { x : Spec (CommRingCat.of (T ⧸ Ideal.span {algebraMap C T (algebraMap 𝒪 C π)})) ⟶ X ρ.d //
      x ≫ ξ ρ.d = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C T (algebraMap 𝒪 C π)}))) ≫ (tM T u).1 })
  (hmap : RigidifiedPairClass.MapCompat 𝒪 π Onr Λ hΛℤ A₀ n C ψ g X ξ tM xOf)

theorem slot_s2 :
    ∀ (d : ℕ) (T T' : Type) [CommRing T] [Algebra C T] [CommRing T'] [Algebra C T'] (φ : T →ₐ[C] T')
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξ d ≫ g))
      (x' : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T'))) (ξ d ≫ g)),
      x'.1 = Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ x.1 →
        RigidifiedPairClass.pt 𝒪 π Onr Λ hΛℤ A₀ n C ψ g X ξ tM xOf hmap d T' x' =
          (RigidifiedPairClass.PR 𝒪 π Onr Λ hΛℤ A₀ n C ψ g X ξ tM xOf hmap).map φ
            (RigidifiedPairClass.pt 𝒪 π Onr Λ hΛℤ A₀ n C ψ g X ξ tM xOf hmap d T x) := by
  intro d T T' _ _ _ _ φ x x' hx
  show Quot.mk _ _ = Quot.mk _ (RigidifiedPairClass.Pt.map φ _)
  congr 1
  refine RigidifiedPairClass.Pt.ext' _ _ ?_ rfl ?_
  · show x'.1 ≫ ξ d = Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ (x.1 ≫ ξ d)
    rw [hx, Category.assoc]
  · show (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫ x'.1) ≫ eqToHom rfl =
      Spec.map (CommRingCat.ofHom (RigidifiedPairClass.qmap (algebraMap 𝒪 C π) φ)) ≫
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫ x.1)
    rw [eqToHom_refl, Category.comp_id, hx, ← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, RigidifiedPairClass.qmap_comp_mk]

theorem slot_s0
    (gb : ∀ d, X d ⟶ Spec (CommRingCat.of (C ⧸ Ideal.span {algebraMap 𝒪 C π})))
    (hfac : ∀ d, ξ d ≫ g = gb d ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 C π})))) :
    ∀ (d : ℕ) (T : Type) [CommRing T] [Algebra C T]
      (x : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξ d ≫ g)),
      algebraMap C T (algebraMap 𝒪 C π) = 0 := by
  intro d T _ _ x

  have h1 : (x.1 ≫ gb d) ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 C π}))) =
      Spec.map (CommRingCat.ofHom (algebraMap C T)) := by
    rw [Category.assoc, ← hfac]; exact x.2
  set φb := Spec.preimage (x.1 ≫ gb d) with hφb
  have h2 : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 C π})) ≫ φb) =
      Spec.map (CommRingCat.ofHom (algebraMap C T)) := by
    rw [Spec.map_comp, Spec.map_preimage]; exact h1
  have h3 : CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 C π})) ≫ φb = CommRingCat.ofHom (algebraMap C T) :=
    Spec.map_injective h2
  have h4 : φb.hom (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 C π}) (algebraMap 𝒪 C π)) = algebraMap C T (algebraMap 𝒪 C π) := by
    have := congrArg (fun f => (CommRingCat.Hom.hom f) (algebraMap 𝒪 C π)) h3
    simpa using this
  have hz : Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 C π}) (algebraMap 𝒪 C π) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  rw [← h4, hz, map_zero]

end RelRepInd.S0S2Block

