open Classical in
/-- If `1` is an accumulation point of the powers of `x`, arbitrarily large positive powers
lie in any neighbourhood of `1`. -/
lemma large_pow_mem (x : G) (hd : ∀ W ∈ 𝓝 (1 : G), ∃ n : ℤ, x ^ n ∈ W ∧ x ^ n ≠ 1)
    (W : Set G) (hW : W ∈ 𝓝 (1 : G)) (N : ℕ) : ∃ n : ℕ, N < n ∧ x ^ n ∈ W := by
  let S : Finset ℤ := (Finset.Icc (-(N : ℤ)) N).filter (fun k => x ^ k ≠ 1)
  let W' : Set G := W ∩ W⁻¹ ∩ ⋂ k ∈ S, {x ^ k}ᶜ
  have hW' : W' ∈ 𝓝 (1 : G) := by
    refine inter_mem (inter_mem hW (inv_mem_nhds_one G hW)) ?_
    refine (Finset.iInter_mem_sets S).2 fun k hk => ?_
    refine isOpen_compl_singleton.mem_nhds ?_
    have := (Finset.mem_filter.1 hk).2
    simpa [eq_comm] using this
  obtain ⟨n, hn, hn1⟩ := hd W' hW'
  have hbig : N < n.natAbs := by
    by_contra hle
    push Not at hle
    have hk : n ∈ S := Finset.mem_filter.2 ⟨Finset.mem_Icc.2 ⟨by omega, by omega⟩, hn1⟩
    exact (mem_iInter₂.1 hn.2 n hk) rfl
  refine ⟨n.natAbs, hbig, ?_⟩
  rcases Int.natAbs_eq n with h | h
  · have h1 := hn.1.1
    rw [h, zpow_natCast] at h1
    exact h1
  · have h1 := hn.1.2
    rw [h, zpow_neg, zpow_natCast] at h1
    simpa using h1

variable [LocallyCompactSpace G]

/-- **Weil's lemma**: the cyclic subgroup generated by `x` is either relatively compact or
discrete. -/
theorem weil (x : G) :
    IsCompact (closure (Subgroup.zpowers x : Set G)) ∨
      ∃ W ∈ 𝓝 (1 : G), ∀ n : ℤ, x ^ n ∈ W → x ^ n = 1 := by
  by_cases hd : ∃ W ∈ 𝓝 (1 : G), ∀ n : ℤ, x ^ n ∈ W → x ^ n = 1
  · exact Or.inr hd
  left
  push Not at hd
  obtain ⟨K, hKc, hK⟩ := exists_compact_mem_nhds (1 : G)
  set U := interior K with hUdef
  have hUo : IsOpen U := isOpen_interior
  have hU1 : (1 : G) ∈ U := mem_interior_iff_mem_nhds.2 hK
  have hclU : IsCompact (closure U) := hKc.closure_of_subset interior_subset
  -- symmetric `U'` with `U' * U' ⊆ U`
  obtain ⟨U', hU', hU'U⟩ : ∃ U' ∈ 𝓝 (1 : G), ∀ a ∈ U', ∀ b ∈ U', a * b ∈ U := by
    have := exists_nhds_one_split (hUo.mem_nhds hU1)
    exact this
  let U'' := U' ∩ U'⁻¹
  have hU'' : U'' ∈ 𝓝 (1 : G) := inter_mem hU' (inv_mem_nhds_one G hU')
  set Cl := closure (Subgroup.zpowers x : Set G) with hCl
  -- Step A
  have stepA : ∀ c ∈ Cl, ∀ N : ℕ, (∃ n : ℕ, N < n ∧ x ^ (-(n : ℤ)) * c ∈ U) ∧
      (∃ n : ℕ, N < n ∧ x ^ (n : ℤ) * c ∈ U) := by
    intro c hc N
    have hnb : (fun y => y⁻¹ * c) ⁻¹' U'' ∈ 𝓝 c := by
      have hcont : Continuous (fun y : G => y⁻¹ * c) := continuous_inv.mul continuous_const
      exact hcont.continuousAt.preimage_mem_nhds (by simpa using hU'')
    obtain ⟨_, hy, ⟨k, rfl⟩⟩ := mem_closure_iff_nhds.1 hc _ hnb
    simp only [mem_preimage] at hy
    -- `x ^ (-k) * c ∈ U''`
    have hy' : x ^ (-k) * c ∈ U'' := by simpa [zpow_neg] using hy
    obtain ⟨m, hm, hmU⟩ := large_pow_mem x hd U'' hU'' (N + k.natAbs)
    have hmU' : (x ^ (m : ℤ)) ∈ U'' := by simpa using hmU
    have hmU'' : (x ^ (m : ℤ))⁻¹ ∈ U' := hmU'.2
    constructor
    · refine ⟨(k + m).toNat, by omega, ?_⟩
      have e : x ^ (-(((k + m).toNat : ℕ) : ℤ)) * c = (x ^ (m : ℤ))⁻¹ * (x ^ (-k) * c) := by
        rw [Int.toNat_of_nonneg (by omega), ← zpow_neg, ← mul_assoc, ← zpow_add]
        congr 2 <;> ring
      rw [e]
      exact hU'U _ hmU'' _ hy'.1
    · refine ⟨(m - k).toNat, by omega, ?_⟩
      have e : x ^ ((((m - k).toNat : ℕ)) : ℤ) * c = x ^ (m : ℤ) * (x ^ (-k) * c) := by
        rw [Int.toNat_of_nonneg (by omega), ← mul_assoc, ← zpow_add]
        congr 2 <;> ring
      rw [e]
      exact hU'U _ hmU'.1 _ hy'.1
  -- Step B
  have hK0 : IsCompact (closure U ∩ Cl) := hclU.inter_right isClosed_closure
  obtain ⟨t, ht⟩ := hK0.elim_finite_subcover (fun n : ℕ => (fun y => x ^ ((n : ℤ) + 1) * y) ⁻¹' U)
    (fun n => hUo.preimage (continuous_const.mul continuous_id)) (by
      intro u hu
      obtain ⟨n, hn, hnU⟩ := (stepA u hu.2 0).2
      refine mem_iUnion.2 ⟨n - 1, ?_⟩
      simp only [mem_preimage]
      have : ((n - 1 : ℕ) : ℤ) + 1 = n := by omega
      rw [this]
      exact hnU)
  set N := t.sup id + 1 with hN
  have hcov : ∀ u ∈ closure U ∩ Cl, ∃ j : ℕ, 1 ≤ j ∧ j ≤ N ∧ x ^ (j : ℤ) * u ∈ U := by
    intro u hu
    obtain ⟨n, hn, hnU⟩ := mem_iUnion₂.1 (ht hu)
    refine ⟨n + 1, by omega, ?_, by simpa using hnU⟩
    have := Finset.le_sup (f := id) hn
    simp only [id] at this
    omega
  -- Step C
  have stepC : ∀ c ∈ Cl, ∃ m : ℕ, 1 ≤ m ∧ m ≤ N ∧ x ^ (-(m : ℤ)) * c ∈ U := by
    intro c hc
    classical
    have hex : ∃ m : ℕ, 0 < m ∧ x ^ (-(m : ℤ)) * c ∈ U := by
      obtain ⟨n, hn, h⟩ := (stepA c hc 0).1
      exact ⟨n, hn, h⟩
    let m := Nat.find hex
    have hm : 0 < m ∧ x ^ (-(m : ℤ)) * c ∈ U := Nat.find_spec hex
    refine ⟨m, hm.1, ?_, hm.2⟩
    by_contra hmN
    push Not at hmN
    have huCl : x ^ (-(m : ℤ)) * c ∈ Cl := by
      have hsub : (Subgroup.zpowers x).topologicalClosure = _ := rfl
      have hmem : x ^ (-(m : ℤ)) ∈ (Subgroup.zpowers x).topologicalClosure :=
        (Subgroup.zpowers x).le_topologicalClosure (Subgroup.zpow_mem_zpowers x _)
      have hcmem : c ∈ (Subgroup.zpowers x).topologicalClosure := hc
      exact (Subgroup.zpowers x).topologicalClosure.mul_mem hmem hcmem
    obtain ⟨j, hj1, hjN, hjU⟩ := hcov _ ⟨subset_closure hm.2, huCl⟩
    have hlt : m - j < m := by omega
    have hpos : 0 < m - j := by omega
    have := Nat.find_min hex hlt
    apply this
    refine ⟨hpos, ?_⟩
    have e : x ^ (-((m - j : ℕ) : ℤ)) * c = x ^ (j : ℤ) * (x ^ (-(m : ℤ)) * c) := by
      rw [← mul_assoc, ← zpow_add]
      congr 2
      push_cast [Nat.cast_sub (by omega : j ≤ m)]
      try ring
    rw [e]
    exact hjU
  -- Step D
  have hcompact : IsCompact (⋃ m ∈ Finset.Icc 1 N, (fun y => x ^ (-(m : ℤ)) * y) ⁻¹' closure U) := by
    refine (Finset.Icc 1 N).isCompact_biUnion fun m _ => ?_
    have he : (fun y => x ^ (-(m : ℤ)) * y) ⁻¹' closure U = (fun y => x ^ (m : ℤ) * y) '' closure U := by
      ext y
      simp only [mem_preimage, mem_image]
      constructor
      · intro hy
        exact ⟨_, hy, by rw [← mul_assoc, ← zpow_add]; simp⟩
      · rintro ⟨z, hz, rfl⟩
        rw [← mul_assoc, ← zpow_add]
        simpa using hz
    rw [he]
    exact hclU.image (continuous_const.mul continuous_id)
  refine hcompact.of_isClosed_subset isClosed_closure fun c hc => ?_
  obtain ⟨m, hm1, hmN, hmU⟩ := stepC c hc
  exact mem_iUnion₂.2 ⟨m, Finset.mem_Icc.2 ⟨hm1, hmN⟩, subset_closure hmU⟩

end LCA

end Weil_sec

