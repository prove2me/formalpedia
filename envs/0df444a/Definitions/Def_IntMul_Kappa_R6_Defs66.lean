-- Source module: Solutions.J6SegKr7
/-!
# B3 (chunk kernel), part 7: the block loop

`loopB_runs`: the loop `while BC > 0: blkI` runs through the descriptor list `ds` (encoded on the
table stack by `dsEnc`), consuming the blocks of the row and pushing `gflat (chunkB …).reverse`
onto `OUT`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- All stage values of all blocks bounded. -/
def chunkOK (P : ℕ) (A : ℤ) (di gi gam dd : List ℤ) : List (ℕ × List ℤ × List ℤ) → List GI → Prop
  | [], _ => True
  | (n, am, ap) :: ds, z => blkOK P A (2 * n) di gi gam dd am ap (z.take n) ∧
      chunkOK P A di gi gam dd ds (z.drop n)

/-- Cost of the block loop. -/
def cLoop (pk b φD : ℕ) (φT : ℕ → ℕ) (B BH : ℕ) : List (ℕ × List ℤ × List ℤ) → ℕ
  | [] => 30
  | d :: ds => cBlk d.1 pk b φD (φT d.1) B BH + cLoop pk b φD φT B BH ds + 30

end J6Seg.KR

end

