open Classical in
private theorem gammaR_heckeDatum (K : Type) [Field K] [NumberField K] (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (uR : ∀ w : InfinitePlace K, w.IsReal → ℂ) (aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2)
    (uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ) (kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ) :
    (LanglandsTunnell.HeckeTate.heckeDatum K χ uR aR uC kC).gammaR =
      (Finset.univ : Finset {w : InfinitePlace K // w.IsReal}).sum
        fun w => ({uR w.1 w.2 + LanglandsTunnell.signShift (aR w.1 w.2)} : Multiset ℂ) :=
  rfl

open Classical in
private theorem gammaC_heckeDatum (K : Type) [Field K] [NumberField K] (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (uR : ∀ w : InfinitePlace K, w.IsReal → ℂ) (aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2)
    (uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ) (kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ) :
    (LanglandsTunnell.HeckeTate.heckeDatum K χ uR aR uC kC).gammaC =
      (Finset.univ : Finset {w : InfinitePlace K // w.IsComplex}).sum
        fun w => ({uC w.1 w.2 + ((kC w.1 w.2).natAbs : ℂ) / 2} : Multiset ℂ) :=
  rfl

