section PT2
variable {R : Type} [CommRing R] [Algebra B R] (X : FramedPolarisedAbelianScheme g N n R)

theorem specMap_id_eq (R : Type) [CommRing R] :
    Spec.map (CommRingCat.ofHom (RingHom.id R)) = 𝟙 (Spec (CommRingCat.of R)) := by
  rw [CommRingCat.ofHom_id]; exact Spec.map_id _

theorem isPullback_eX_inv :
    IsPullback (C.eX F X).inv X.f (C.f (C.ptW F X).1) (Spec.map (CommRingCat.ofHom (RingHom.id R))) := by
  rw [specMap_id_eq]
  exact IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id, ← eX_f, Iso.inv_hom_id_assoc]⟩

theorem isPullback_eX_hom :
    IsPullback (C.eX F X).hom (C.f (C.ptW F X).1) X.f (Spec.map (CommRingCat.ofHom (RingHom.id R))) := by
  rw [specMap_id_eq]
  exact IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id, eX_f]⟩

theorem h₂_ptW : C.U₂ (C.ptW F X).1 = Set.univ := by
  have key := (GoodReductionJacobian.AbelianSchemePropertyBundle.isOpen_setOf_abelian_geometricFibre_and_preimage_eq_of_isPullback
    (C.f (C.ptW F X).1) (C.hproj_f _) g (C.secOf _ (C.lifts_of_iSup_eq_bot _ (C.h₁_ptW F X) 0))).2 R (RingHom.id R)
    X.A X.f (C.eX F X).inv (C.isPullback_eX_inv F X)
  have huniv : {s : ↥(Spec (CommRingCat.of R)) | ∀ (k : Type) [Field k] [IsAlgClosed k] (x : R →+* k),
      RingHom.ker x = s.asIdeal →
      Smooth (pullback.snd X.f (Spec.map (CommRingCat.ofHom x))) ∧
      IrreducibleSpace ↥(pullback X.f (Spec.map (CommRingCat.ofHom x))) ∧
      topologicalKrullDim ↥(pullback X.f (Spec.map (CommRingCat.ofHom x))) = g ∧
      Nonempty (RelativeGroupLaw k (pullback.snd X.f (Spec.map (CommRingCat.ofHom x))))} = Set.univ :=
    Set.eq_univ_iff_forall.mpr fun t k _ _ x hx =>
      GoodReductionJacobian.AbelianSchemePropertyBundle.smooth_irreducibleSpace_geometricFibre_of_topologicalKrullDim_eq
        X.L X.bundle g X.dim_fibre t k x hx
  rw [huniv, specMap_id_eq] at key
  show {t | _} = Set.univ
  rw [key]
  ext t
  simp

theorem lifts_ptW : ∀ j : Fin (2 * g + 1), ∃ z : Spec (CommRingCat.of R) ⟶ C.Z (C.ptW F X).1, z ≫ C.ι (C.ptW F X).1 = C.ysec (C.ptW F X).1 j :=
  C.lifts_of_iSup_eq_bot _ (C.h₁_ptW F X)

theorem law_ptW {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R))
    (x y : SchemeHomOver t' (C.f (C.ptW F X).1)) :
    ((C.law (C.ptW F X).1 (C.lifts_ptW F X) (C.h₂_ptW F X)).mul t' x y).1 ≫ (C.eX F X).hom =
      (X.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (RingHom.id R)))
        ⟨x.1 ≫ (C.eX F X).hom, by rw [Category.assoc, (C.isPullback_eX_hom F X).w, ← Category.assoc, x.2]⟩
        ⟨y.1 ≫ (C.eX F X).hom, by rw [Category.assoc, (C.isPullback_eX_hom F X).w, ← Category.assoc, y.2]⟩).1 := by
  refine GoodReductionJacobian.RelativeGroupLaw.mul_comp_eq_mul_of_isPullback_of_one_comp_eq (RingHom.id R) (C.eX F X).hom
    (C.isPullback_eX_hom F X) X.L _ (C.bundle (C.ptW F X).1 (C.lifts_ptW F X) (C.h₂_ptW F X)) ?_ t' x y
  rw [(C.law_spec (C.ptW F X).1 (C.lifts_ptW F X) (C.h₂_ptW F X)).1, specMap_id_eq, Category.id_comp]
  show (C.zsec (C.ptW F X).1 (C.lifts_ptW F X) 0).1 ≫ _ = _
  rw [zsec_ptW, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  unfold secX
  rw [dif_pos (Fin.val_zero _)]

theorem h₃_ptW :
    C.I₃ (C.ptW F X).1 (C.lifts_ptW F X) (C.h₂_ptW F X) n = ⊥ := by
  rw [I₃_eq_bot_iff]
  intro i
  apply Subtype.ext
