theorem mul_val_congr {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) {T : Scheme.{0}} {u u' : T ⟶ Spec (CommRingCat.of S)} (h : u = u')
    (P Q : SchemeHomOver u f) (P' Q' : SchemeHomOver u' f) (hP : P.1 = P'.1) (hQ : Q.1 = Q'.1) :
    (L.mul u P Q).1 = (L.mul u' P' Q').1 := by
  subst h
  obtain rfl : P = P' := Subtype.ext hP
  obtain rfl : Q = Q' := Subtype.ext hQ
  rfl

theorem spec_map_comp {S S' S'' : Type} [CommRing S] [CommRing S'] [CommRing S''] (φ : S →+* S')
    (ψ : S' →+* S'') :
    Spec.map (CommRingCat.ofHom (ψ.comp φ)) =
      Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom φ) := by
  rw [CommRingCat.ofHom_comp, Spec.map_comp]

theorem locIsoOnBase_of_iso_left {S' : Type} [CommRing S'] {Y : Scheme.{0}} (g : Y ⟶ Spec (CommRingCat.of S'))
    {M₁ M M' : Y.Modules} (e : M₁ ≅ M) (h : LocIsoOnBase g M M') : LocIsoOnBase g M₁ M' := by
  intro s
  obtain ⟨U, hs, ⟨i⟩⟩ := h s
  exact ⟨U, hs, ⟨(Scheme.Modules.pullback (g ⁻¹ᵁ U).ι).mapIso e ≪≫ i⟩⟩

def toAction {S : Type} [CommRing S] {X : PolarisedAbelianScheme 2 d m S} (s : QMStructure Λ star β X) :
    LatticeAction Λ X.f X.L where
  act := s.act
  act_over := s.act_over
  act_hom := s.act_hom
  act_one := s.act_one
  act_mul := s.act_mul
  act_add := s.act_add

@[scoped simp] theorem toAction_act {S : Type} [CommRing S] {X : PolarisedAbelianScheme 2 d m S}
    (s : QMStructure Λ star β X) : (toAction s).act = s.act := rfl

theorem isGroupPullback_of_clauses {R T : Type} [CommRing R] [CommRing T] (φ : R →+* T)
    {X : PolarisedAbelianScheme 2 d m R} {X' : PolarisedAbelianScheme 2 d m T}
    (gA : X'.A ⟶ X.A) (hg : CategoryTheory.IsPullback gA X'.f X.f (Spec.map (CommRingCat.ofHom φ)))
    (hmul : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of T)) (x y : SchemeHomOver t' X'.f),
      (X'.L.mul t' x y).1 ≫ gA =
        (X.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
          ⟨x.1 ≫ gA, by rw [Category.assoc, hg.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ gA, by rw [Category.assoc, hg.w, ← Category.assoc, y.2]⟩).1) :
    IsGroupPullback φ X.L X'.L gA :=
  ⟨hg, fun t' P Q => hmul t' P Q⟩

def TraceCond {T : Type} [CommRing T] {A' : Scheme.{0}} {f' : A' ⟶ Spec (CommRingCat.of T)}
    (L' : RelativeGroupLaw T f') (i' : LatticeAction Λ f' L') : Prop :=
  ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : T →+* k)
    (V : Type) [AddCommGroup V] [Module k V] [Module.Finite k V] (τ : V → SchemeHomOver (tangentBase k sk) f'),
    Function.Injective τ →
    (∀ P : SchemeHomOver (tangentBase k sk) f', P ∈ Set.range τ ↔ IsTangentVector L' k sk P) →
    (∀ v w : V, τ (v + w) = L'.mul (tangentBase k sk) (τ v) (τ w)) →
    (∀ (c : k) (v : V), (τ (c • v)).1 = tangentScale k c ≫ (τ v).1) →
    ∀ (x : ↥Λ) (Φ : V →ₗ[k] V), (∀ v : V, τ (Φ v) = pushPt (i'.act x) (i'.act_over x) (τ v)) →
    ∀ n : ℤ, (x : ℍ[ℚ, a, b]) + Star.star (x : ℍ[ℚ, a, b]) = ((n : ℚ) : ℍ[ℚ, a, b]) →
      LinearMap.trace k V Φ = (n : k)

def QMConds (star : ↥Λ → ↥Λ) (β : Fin (2 * 2) → ↥Λ) {R T : Type} [CommRing R] [CommRing T] (φ : R →+* T)
    (X : PolarisedAbelianScheme 2 d m R)
    {A' : Scheme.{0}} {f' : A' ⟶ Spec (CommRingCat.of T)} (L' : RelativeGroupLaw T f') (g : A' ⟶ X.A)
    (i' : LatticeAction Λ f' L') : Prop :=
  TraceCond L' i' ∧
  (∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of T))) f',
    ∀ j : Fin (2 * 2), (pushPt (i'.act (β j)) (i'.act_over (β j)) P).1 ≫ g =
      Spec.map (CommRingCat.ofHom φ) ≫ (X.P j).1) ∧
  (∃ polE : A'.Modules, CerednikDrinfeld.QM.IsCanonicalPolData f' L' i'.act i'.act_over star polE ∧
      LocIsoOnBase f' ((Scheme.Modules.pullback g).obj X.pol) (polE ⊗ polE ⊗ polE))

theorem qmConds_toAction {R T : Type} [CommRing R] [CommRing T] (φ : R →+* T)
    {X : PolarisedAbelianScheme 2 d m R} {X' : PolarisedAbelianScheme 2 d m T} (gA : X'.A ⟶ X.A)
    (hP : ∀ i, (X'.P i).1 ≫ gA = Spec.map (CommRingCat.ofHom φ) ≫ (X.P i).1)
    (hpol : Nonempty ((Scheme.Modules.pullback gA).obj X.pol ≅ X'.pol)) (s : QMStructure Λ star β X') :
    QMConds star β φ X X'.L gA (toAction s) := by
  refine ⟨?_, ?_, ?_⟩
  · intro k _ _ sk V _ _ _ τ h1 h2 h3 h4 x Φ h5 n hn
    exact s.act_trace k sk V τ h1 h2 h3 h4 x Φ h5 n hn
  · refine ⟨s.P, fun j => ?_⟩
    have h := congrArg Subtype.val (s.level_match j)
    change (pushPt (s.act (β j)) (s.act_over (β j)) s.P).1 ≫ gA = _
    rw [h, hP j]
  · obtain ⟨polE, hc, hloc⟩ := s.pol_canonical
    exact ⟨polE, hc, locIsoOnBase_of_iso_left X'.f hpol.some hloc⟩

theorem level_of_comp {R T : Type} [CommRing R] [CommRing T] (φ : R →+* T)
    {X : PolarisedAbelianScheme 2 d m R} {X' : PolarisedAbelianScheme 2 d m T} (gA : X'.A ⟶ X.A)
    (hg : CategoryTheory.IsPullback gA X'.f X.f (Spec.map (CommRingCat.ofHom φ)))
    (hP : ∀ i, (X'.P i).1 ≫ gA = Spec.map (CommRingCat.ofHom φ) ≫ (X.P i).1)
    (i' : LatticeAction Λ X'.f X'.L) (P : SchemeHomOver (𝟙 (Spec (CommRingCat.of T))) X'.f)
    (h : ∀ j : Fin (2 * 2), (pushPt (i'.act (β j)) (i'.act_over (β j)) P).1 ≫ gA =
      Spec.map (CommRingCat.ofHom φ) ≫ (X.P j).1)
    (j : Fin (2 * 2)) : pushPt (i'.act (β j)) (i'.act_over (β j)) P = X'.P j :=
  Subtype.ext (hg.hom_ext ((h j).trans (hP j).symm)
    (by rw [(pushPt (i'.act (β j)) (i'.act_over (β j)) P).2, (X'.P j).2]))

def ofAction {T : Type} [CommRing T] {X' : PolarisedAbelianScheme 2 d m T} (i' : LatticeAction Λ X'.f X'.L)
    (htr : TraceCond X'.L i') (P : SchemeHomOver (𝟙 (Spec (CommRingCat.of T))) X'.f)
    (hPl : ∀ j : Fin (2 * 2), pushPt (i'.act (β j)) (i'.act_over (β j)) P = X'.P j)
    (hpol : ∃ polE : X'.A.Modules, CerednikDrinfeld.QM.IsCanonicalPolData X'.f X'.L i'.act i'.act_over star polE ∧
      LocIsoOnBase X'.f X'.pol (polE ⊗ polE ⊗ polE)) :
    QMStructure Λ star β X' where
  act := i'.act
  act_over := i'.act_over
  act_hom := i'.act_hom
  act_one := i'.act_one
  act_mul := i'.act_mul
  act_add := i'.act_add
  act_trace := htr
  P := P
  level_match := hPl
  pol_canonical := hpol

theorem toAction_ofAction {T : Type} [CommRing T] {X' : PolarisedAbelianScheme 2 d m T}
    (i' : LatticeAction Λ X'.f X'.L) (htr : TraceCond X'.L i') (P : SchemeHomOver (𝟙 (Spec (CommRingCat.of T))) X'.f)
    (hPl : ∀ j : Fin (2 * 2), pushPt (i'.act (β j)) (i'.act_over (β j)) P = X'.P j)
    (hpol : ∃ polE : X'.A.Modules, CerednikDrinfeld.QM.IsCanonicalPolData X'.f X'.L i'.act i'.act_over star polE ∧
      LocIsoOnBase X'.f X'.pol (polE ⊗ polE ⊗ polE)) :
    toAction (ofAction (star := star) (β := β) i' htr P hPl hpol) = i' := by
  cases i'
  rfl

end Restrict

section H0

theorem finrank_compHom_eq_of_iso {Y : Scheme.{0}} {M M' : Y.Modules} (e : M ≅ M') (k : Type) [Field k]
    (φk : k →+* Γ(Y, ⊤)) :
    (letI : Module k Γ(M, ⊤) := Module.compHom _ φk; Module.finrank k Γ(M, ⊤)) =
      (letI : Module k Γ(M', ⊤) := Module.compHom _ φk; Module.finrank k Γ(M', ⊤)) := by
  letI : Module k Γ(M, ⊤) := Module.compHom _ φk
  letI : Module k Γ(M', ⊤) := Module.compHom _ φk
  let L : Γ(M, ⊤) ≃ₗ[k] Γ(M', ⊤) :=
    { toFun := fun x => e.hom.app ⊤ x
      invFun := fun y => e.inv.app ⊤ y
      map_add' := fun x y => map_add _ x y
      map_smul' := fun c x => e.hom.app_smul (φk c) x
      left_inv := fun x => by
        change (e.hom.app ⊤ ≫ e.inv.app ⊤) x = x
        rw [← Scheme.Modules.Hom.comp_app, e.hom_inv_id, Scheme.Modules.Hom.id_app]
        rfl
      right_inv := fun y => by
        change (e.inv.app ⊤ ≫ e.hom.app ⊤) y = y
        rw [← Scheme.Modules.Hom.comp_app, e.inv_hom_id, Scheme.Modules.Hom.id_app]
        rfl }
  exact L.finrank_eq

theorem geomFibreH0Finrank_congr {S : Type} [CommRing S] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of S))
    {M M' : A.Modules} (e : M ≅ M') (k : Type) [Field k] (sk : S →+* k) :
    Scheme.Modules.geomFibreH0Finrank f M k sk = Scheme.Modules.geomFibreH0Finrank f M' k sk := by
  unfold Scheme.Modules.geomFibreH0Finrank
  exact finrank_compHom_eq_of_iso ((Scheme.Modules.pullback _).mapIso e) k _

end H0

section Main

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {star : ↥Λ → ↥Λ} {β : Fin (2 * 2) → ↥Λ} {d m : ℕ}

theorem quasiCompact_comp_of_range_subset {E Z B : Scheme.{0}} (ι : Z ⟶ E) [QuasiCompact ι] (πE : E ⟶ B)
    (U : E.Opens) (hU : QuasiCompact (U.ι ≫ πE)) (h : Set.range ι ⊆ (U : Set E)) : QuasiCompact (ι ≫ πE) := by
  have h' : Set.range ι ⊆ Set.range U.ι := by rwa [Scheme.Opens.range_ι]
  have hl : IsOpenImmersion.lift U.ι ι h' ≫ U.ι = ι := IsOpenImmersion.lift_fac _ _ _
  haveI : QuasiCompact (IsOpenImmersion.lift U.ι ι h' ≫ U.ι) := by rw [hl]; infer_instance
  haveI : QuasiCompact (IsOpenImmersion.lift U.ι ι h') := QuasiCompact.of_comp _ U.ι
  haveI := hU
  rw [← hl, Category.assoc]
  infer_instance

theorem quasiCompact_comp_of_range_subset_biUnion {E Z B : Scheme.{0}} (ι : Z ⟶ E) [QuasiCompact ι] (πE : E ⟶ B)
    {I : Type} (S : Set I) (hS : S.Finite) (U : I → E.Opens) (hU : ∀ i ∈ S, QuasiCompact ((U i).ι ≫ πE))
    (h : Set.range ι.base ⊆ ⋃ i ∈ S, (U i : Set E)) : QuasiCompact (ι ≫ πE) := by
  constructor
  intro W hWo hWc
  have hpiece : ∀ i ∈ S, IsCompact ((U i : Set E) ∩ πE.base ⁻¹' W) := by
    intro i hi
    haveI := hU i hi
    have h1 : IsCompact (((U i).ι ≫ πE).base ⁻¹' W) := QuasiCompact.isCompact_preimage W hWo hWc
    have h1' : IsCompact ((U i).ι.base ⁻¹' (πE.base ⁻¹' W)) := h1
    have h2 := h1'.image (U i).ι.base.hom.continuous
    rw [Set.image_preimage_eq_inter_range, Scheme.Opens.range_ι, Set.inter_comm] at h2
    exact h2
  have hcov : (ι ≫ πE).base ⁻¹' W = ⋃ i ∈ S, ι.base ⁻¹' ((U i : Set E) ∩ πE.base ⁻¹' W) := by
    ext z
    constructor
    · intro hz
      have hz' : πE.base (ι.base z) ∈ W := hz
      obtain ⟨i, hi, hzi⟩ := Set.mem_iUnion₂.mp (h ⟨z, rfl⟩)
      exact Set.mem_iUnion₂.mpr ⟨i, hi, hzi, hz'⟩
    · intro hz
      obtain ⟨i, -, -, hz'⟩ := Set.mem_iUnion₂.mp hz
      exact hz'
  rw [hcov]
  exact hS.isCompact_biUnion fun i hi =>
    QuasiCompact.isCompact_preimage _ ((U i).isOpen.inter (hWo.preimage πE.base.hom.continuous)) (hpiece i hi)

theorem main
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (hβ : ∀ x : ↥Λ, ∃! c : Fin (2 * 2) → ℤ, x = ∑ j, c j • β j)
    (hm : 3 ≤ m)
    (R : Type) [CommRing R] (X : PolarisedAbelianScheme 2 d m R)
    (E : Scheme.{0}) (πE : E ⟶ Spec (CommRingCat.of R))
    (cl : ∀ (R' : Type) [CommRing R'] (φ : R →+* R') {A' : Scheme.{0}} {f' : A' ⟶ Spec (CommRingCat.of R')}
        (L' : RelativeGroupLaw R' f') (g : A' ⟶ X.A), IsGroupPullback φ X.L L' g →
        LatticeAction Λ f' L' → SchemeHomOver (Spec.map (CommRingCat.ofHom φ)) πE)
    (hE : RepresentsLatticeActions Λ X.L E πE cl)
    (hEpieces : (∀ e : Fin (2 * 2) → ℕ, ∃ U : E.Opens, IsClosed (U : Set E) ∧ QuasiCompact (U.ι ≫ πE) ∧
        ∀ (R' : Type) [CommRing R'] (φ : R →+* R') {A' : Scheme.{0}} {f' : A' ⟶ Spec (CommRingCat.of R')}
          (L' : RelativeGroupLaw R' f') (g : A' ⟶ X.A) (hg : IsGroupPullback φ X.L L' g) (X' : LatticeAction Λ f' L'),
          (Set.range (cl R' φ L' g hg X').1.base ⊆ (U : Set E) ↔
            ∀ (j : Fin (2 * 2)) (k : Type) [Field k] [IsAlgClosed k] (sk : R' →+* k),
              Scheme.Modules.geomFibreH0Finrank f'
                ((Scheme.Modules.pullback g).obj X.pol ⊗
                  (Scheme.Modules.pullback (X'.act (β j))).obj ((Scheme.Modules.pullback g).obj X.pol)) k sk = e j)))
    (Z : Scheme.{0}) (ι : Z ⟶ E) (hι : IsClosedImmersion ι)
    (hZ : ∀ (R' : Type) [CommRing R'] (φ : R →+* R') {A' : Scheme.{0}} {f' : A' ⟶ Spec (CommRingCat.of R')}
        (L' : RelativeGroupLaw R' f') (g : A' ⟶ X.A) (hg : IsGroupPullback φ X.L L' g) (i' : LatticeAction Λ f' L'),
        ((∃ y : Spec (CommRingCat.of R') ⟶ Z, y ≫ ι = (cl R' φ L' g hg i').1) ↔ QMConds star β φ X L' g i')) :
    QuasiCompact (ι ≫ πE) := by
  classical
  haveI := hι
  obtain ⟨Eb, hEb⟩ := QMStructure.exists_forall_geomFibreH0Finrank_tensor_pullback_act_le
    hqq' hB Λ hΛ μ hμ star hstar β hβ d m hm
  choose U hUc hUqc hU using hEpieces

  let S : Set (Fin (2 * 2) → ℕ) := {e | ∀ j, e j ≤ Eb j}
  have hSfin : S.Finite := by
    have : S ⊆ Set.range (fun v : ∀ j : Fin (2 * 2), Fin (Eb j + 1) => fun j => (v j : ℕ)) := by
      intro e he
      exact ⟨fun j => ⟨e j, Nat.lt_succ_of_le (he j)⟩, rfl⟩
    exact (Set.finite_range _).subset this
  refine quasiCompact_comp_of_range_subset_biUnion ι πE S hSfin U (fun e _ => hUqc e) ?_
  rintro _ ⟨z, rfl⟩

  obtain ⟨r', hr'⟩ := Spec.map_surjective (Z.fromSpecResidueField z ≫ ι ≫ πE)
  let φ : R →+* ↥(Z.residueField z) := r'.hom
  have hφ : Spec.map (CommRingCat.ofHom φ) = Z.fromSpecResidueField z ≫ ι ≫ πE := by rw [← hr']; rfl
  let κ : Type := ↥(Z.residueField z)
  let k0 : Type := AlgebraicClosure κ

  obtain ⟨Xκ, gA, hg, hmul, hP, hpol⟩ := PolarisedAbelianScheme.exists_isPullback φ X
  have hgp : IsGroupPullback φ X.L Xκ.L gA := isGroupPullback_of_clauses φ gA hg hmul
  obtain ⟨i', hi'⟩ := hE.cl_surjective _ φ Xκ.L gA hgp
    ⟨Z.fromSpecResidueField z ≫ ι, by rw [hφ, Category.assoc]⟩
  have hi'1 : (cl _ φ Xκ.L gA hgp i').1 = Z.fromSpecResidueField z ≫ ι := congrArg Subtype.val hi'
  obtain ⟨htr, ⟨P, hPl⟩, ⟨polE, hpolE, hloc⟩⟩ :=
    (hZ _ φ Xκ.L gA hgp i').mp ⟨Z.fromSpecResidueField z, hi'1.symm⟩
  let s : QMStructure Λ star β Xκ := ofAction i' htr P (level_of_comp φ gA hg hP i' P hPl)
    ⟨polE, hpolE, locIsoOnBase_of_iso_left Xκ.f hpol.some.symm hloc⟩

  let Mj : Fin (2 * 2) → Xκ.A.Modules := fun j =>
    (Scheme.Modules.pullback gA).obj X.pol ⊗ (Scheme.Modules.pullback (i'.act (β j))).obj ((Scheme.Modules.pullback gA).obj X.pol)
  have hMjinv : ∀ j, Scheme.Modules.IsInvertible (Mj j) := fun j =>
    (X.pol_isInvertible.pullback gA).tensor_monoidalV2 ((X.pol_isInvertible.pullback gA).pullback _)

  let e : Fin (2 * 2) → ℕ := fun j => Scheme.Modules.geomFibreH0Finrank Xκ.f (Mj j) k0 (algebraMap κ k0)

  have heS : e ∈ S := by
    intro j
    show Scheme.Modules.geomFibreH0Finrank Xκ.f (Mj j) k0 (algebraMap κ k0) ≤ Eb j
    rw [geomFibreH0Finrank_congr Xκ.f
      (tensorIso hpol.some ((Scheme.Modules.pullback (i'.act (β j))).mapIso hpol.some)) k0 (algebraMap κ k0)]
    exact hEb _ Xκ s j k0 (algebraMap κ k0)

  haveI : IsProper Xκ.f := Xκ.bundle.proper
  have hdeg : ∀ (j : Fin (2 * 2)) (k : Type) [Field k] [IsAlgClosed k] (sk : κ →+* k),
      Scheme.Modules.geomFibreH0Finrank Xκ.f (Mj j) k sk = e j := by
    intro j k _ _ sk
    letI : Algebra κ k := sk.toAlgebra
    let ι0 : k0 →+* k := (IsAlgClosed.lift (R := κ) (S := k0) (M := k)).toRingHom
    have hι0 : ι0.comp (algebraMap κ k0) = sk := by
      ext x
      change (IsAlgClosed.lift (R := κ) (S := k0) (M := k)) (algebraMap κ k0 x) = sk x
      rw [AlgHom.commutes]; rfl
    rw [← hι0]
    exact AlgebraicGeometry.Scheme.Modules.geomFibreH0Finrank_comp_eq Xκ.f (Mj j) (hMjinv j) k0 k
      (algebraMap κ k0) ι0

  have hrange := (hU e _ φ Xκ.L gA hgp i').mpr hdeg
  rw [hi'1] at hrange
  refine Set.mem_iUnion₂.mpr ⟨e, heS, hrange ⟨(default : ↥(Spec (Z.residueField z))), ?_⟩⟩
  change (Z.fromSpecResidueField z ≫ ι) default = ι z
  rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]

end Main

