section
-- Source module: Solutions.KFMP18
/-!
# KFM 14: Proposition 18 as an explicit IL hypothesis `P18IL`

`P18IL` is the interface between the assembly (item 14) and Prop 18 in IL (item 13).

* The procedure table is **one fixed table** `kTable ext` (`ext`, `entry` and the descriptor stack
  `dS` are chosen before `n`). The final machine must not depend on `n`, so every `n`-dependent
  quantity (`p, ℓ, K, D`, the axis lengths `t_i`) is run-time data on stack `dS`, not a literal
  in the code.
* Data: two arrays `f, g` of `N = ∏ t_i` records in row-major order over `t_1 × … × t_D`
  (last axis fastest). Each record is `r = 2^ℓ` Gaussian coefficients at scale `2^p` (`RecRep`),
  in the unit disk, width `W = p + 2`. They sit on stack `0` (`f` on top). All other managed
  stacks are empty and the rest of the state (`s`) is arbitrary and preserved.
* Result: one array `h` (`RecRep r p`, width `W`) replacing `f, g` on stack `0`, within
  `2 N (3ℓ + 1) 2^{-p}` of `M_r(f, g) = (f ∗ g)/(r N)` in every coefficient (the bound of
  `GlueProp18.prop18_scaled_full`, with `√2 ≤ 2`, transported to the row-major order).
* Cost `≤ C₀ · N r (W + 1) · Ncost(6 lg n, d, K, ℓ, α) · (log(6 lg n) + 1)^A` for `n ≥ n₁`,
  with `D + 1 = d = dP n`, `ℓ = ℓP n`, `K = KP n`, `p = pP n`, `t_i ∈ {r/2, r}`.
-/

namespace NLogN.KFM

open IntMul KIL KFB KFH IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

/-- The descriptor of a Prop 18 call: `[p, ℓ, K, D, t_1, …, t_D]`. -/
def desc18 (p ℓ K : ℕ) (ts : List ℕ) : List ℤ :=
  (p : ℤ) :: (ℓ : ℤ) :: (K : ℤ) :: (ts.length : ℤ) :: ts.map (fun t => (t : ℤ))

/-- **Proposition 18 in IL** (hypothesis of the assembly; to be proved in item 13). -/
def P18IL : Prop :=
  ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (entry : Fin (7 + E)) (dS : Fin HS)
    (C₀ : ℝ) (A n₁ : ℕ), dS ≠ 0 ∧ 0 ≤ C₀ ∧
  ∀ (Isym : List Sym) (n : ℕ), IntMul.OpenAI.Glue.n0 ≤ n → n₁ ≤ n →
  ∀ (ts : List ℕ), ts.length + 1 = IntMul.OpenAI.Glue.dP n → (∀ t ∈ ts, t = IntMul.OpenAI.Glue.rP n ∨ 2 * t = IntMul.OpenAI.Glue.rP n) →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zf zg : List GI) (l : List ℤ)
    (xf xg : List (Fin (IntMul.OpenAI.Glue.rP n) → ℂ)),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = desc18 (pP n) (ℓP n) (KP n) ts →
    f 0 = gflat zf ++ gflat zg ++ l →
    RecRep (IntMul.OpenAI.Glue.rP n) (pP n) zf xf → RecRep (IntMul.OpenAI.Glue.rP n) (pP n) zg xg →
    xf.length = ts.prod → xg.length = ts.prod →
    NLogN.KFB.GB (pP n + 2) zf → NLogN.KFB.GB (pP n + 2) zg →
    (∀ x ∈ xf, ‖x‖ ≤ 1) → (∀ x ∈ xg, ‖x‖ ≤ 1) →
    ∃ (zh : List GI) (xh : List (Fin (IntMul.OpenAI.Glue.rP n) → ℂ)) (c : ℕ),
      IRuns Isym (kTable ext) (.call entry) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0 (gflat zh ++ l))) c ∧
      RecRep (IntMul.OpenAI.Glue.rP n) (pP n) zh xh ∧ xh.length = ts.prod ∧ NLogN.KFB.GB (pP n + 2) zh ∧
      (∀ j < ts.prod, ∀ k : Fin (IntMul.OpenAI.Glue.rP n),
        ‖xh.getD j 0 k - (mrL (IntMul.OpenAI.Glue.rP n) ts xf xg).getD j 0 k‖ ≤
          2 * ts.prod * (3 * ℓP n + 1) * (2 : ℝ)⁻¹ ^ pP n) ∧
      (c : ℝ) ≤ C₀ * ((ts.prod * IntMul.OpenAI.Glue.rP n * (pP n + 3) : ℕ) : ℝ) *
        Ncost (6 * (lg n : ℝ)) (IntMul.OpenAI.Glue.dP n) (KP n) (ℓP n) (αP n) *
        (Real.log (6 * (lg n : ℝ)) + 1) ^ A

end

