-- url     : https://prove2.me/theorems/c9ea24d4-5f5a-44f7-9a07-0aac9946279b
-- title:
--   The randomized Weighted Majority master WMR and the weak independence condition (Sections 5–6)
-- statement:
--   This file sets up the randomized master algorithm WMR of Littlestone and Warmuth and the probabilistic condition under which its expected number of mistakes is analysed.
--
--   Fix a probability space $(\Omega,\mathcal F,P)$, a pool of $n$ prediction algorithms indexed by $i \in \{1,\dots,n\}$, a number $t$ of trials, and a parameter $\beta$ with $0 \le \beta < 1$. WMR updates in every trial, so every trial is an update-trial. In trial $j$ the following random variables are given:
--
--   1. the predictions $x_i^{(j)}$ of the pool members, with values in $[0,1]$; write $x^{(j)} = (x_1^{(j)},\dots,x_n^{(j)})$;
--   2. the label $\rho^{(j)} \in \{0,1\}$;
--   3. the prediction $\lambda^{(j)} \in \{0,1\}$ of the master WMR.
--
--   All of them are measurable, and each may be random.
--
--   **Weights.** Each pool member starts with a deterministic positive weight $w_i^{(1)} > 0$. In trial $j$ its weight is multiplied by an update factor $F$ that depends on $x_i^{(j)}$ and $\rho^{(j)}$ and satisfies, on every sample path,
--   $$
--   \beta^{|x_i^{(j)}-\rho^{(j)}|} \le F \le 1-(1-\beta)\,|x_i^{(j)}-\rho^{(j)}|, \qquad w_i^{(j+1)} = F\, w_i^{(j)}. \tag{5.1}
--   $$
--   The factor is given by a rule $F_{j,i}(x,r)$, a measurable function of the prediction and the label (it may differ between trials and members). The weights are therefore random variables determined by the predictions and labels. With $s^{(j)} = \sum_{i=1}^n w_i^{(j)}$ we have $s^{(1)} = w_{\mathrm{init}}$ and $s^{(t+1)} = w_{\mathrm{fin}}$, and the weighted average prediction of the pool is
--   $$
--   \gamma^{(j)} = \frac{\sum_{i=1}^n w_i^{(j)} x_i^{(j)}}{s^{(j)}}.
--   $$
--   WMR predicts $1$ with probability $\gamma^{(j)}$. Its number of mistakes is $m = \sum_{j=1}^t |\lambda^{(j)} - \rho^{(j)}|$.
--
--   **Weak independence condition.** Let $\mathcal F_j$ be the $\sigma$-algebra generated by $(x^{(1)},\rho^{(1)}),\dots,(x^{(j)},\rho^{(j)})$, which includes the current predictions and the current label. The condition requires, for $j = 1,\dots,t$,
--   $$
--   \mathbf E\big(\lambda^{(j)} \,\big|\, (x^{(1)},\rho^{(1)}),\dots,(x^{(j)},\rho^{(j)})\big) = \gamma^{(j)} \quad \text{almost surely}.
--   $$
--
--   These objects are shared by the statements of the mission: the identity between the expected number of mistakes and the expected loss of the weighted average, and the expected mistake bound of Theorem 6.1.
--
--   **Formalization Note** Trials are indexed from $0$: `weight … j` is $w^{(j+1)}$, `totalWeight … 0` is $w_{\mathrm{init}}$ and `totalWeight … t` is $w_{\mathrm{fin}}$, and `history x ρ j` is $\mathcal F_{j+1}$. The real power $\beta^{r}$ follows the convention $0^0 = 1$. If $s^{(j)} = 0$, Lean's division gives $\gamma^{(j)} = 0$; this case is excluded by $w_{\mathrm{fin}} > 0$ in the theorems that need it. Measurability of the predictions, labels, master predictions and update rules is the standing convention that makes the expectations meaningful; the paper does not state it.
-- source:
--   Littlestone, Warmuth, The Weighted Majority Algorithm, Inform. and Comput. 108 (1994), pp. 232–233, Section 5 (notation, update step (5.1)); pp. 237–238, Section 6 (Assumptions, Prediction, Update criterion and Update step of WMR; weak independence condition)

import Mathlib

open MeasureTheory

namespace WeightedMajority.Randomized

/-- Weights of WMR along a sample path `ω`, with zero-based update-trials `j = 0, 1, …`.
`w1 i > 0` is the deterministic initial weight of pool member `i` (the paper's `w_i^{(1)}`);
in trial `j` the weight of member `i` is multiplied by the factor `F j i (x j i ω) (ρ j ω)`,
a function of the member's prediction and of the label (the update step (5.1)). -/
noncomputable def weight {Ω : Type*} {n : ℕ} (w1 : Fin n → ℝ)
    (F : ℕ → Fin n → ℝ → ℝ → ℝ) (x : ℕ → Fin n → Ω → ℝ) (ρ : ℕ → Ω → ℝ) :
    ℕ → Fin n → Ω → ℝ
  | 0, i, _ => w1 i
  | j + 1, i, ω => F j i (x j i ω) (ρ j ω) * weight w1 F x ρ j i ω

/-- Total weight `s^{(j+1)}` at the beginning of zero-based trial `j`; `totalWeight … 0` is
`w_init` and `totalWeight … t` is `w_fin`. -/
noncomputable def totalWeight {Ω : Type*} {n : ℕ} (w1 : Fin n → ℝ)
    (F : ℕ → Fin n → ℝ → ℝ → ℝ) (x : ℕ → Fin n → Ω → ℝ) (ρ : ℕ → Ω → ℝ)
    (j : ℕ) (ω : Ω) : ℝ :=
  ∑ i : Fin n, weight w1 F x ρ j i ω

/-- The weighted average prediction `γ` of the pool in zero-based trial `j`, which is the
probability with which WMR predicts `1`. -/
noncomputable def gamma {Ω : Type*} {n : ℕ} (w1 : Fin n → ℝ)
    (F : ℕ → Fin n → ℝ → ℝ → ℝ) (x : ℕ → Fin n → Ω → ℝ) (ρ : ℕ → Ω → ℝ)
    (j : ℕ) (ω : Ω) : ℝ :=
  (∑ i : Fin n, weight w1 F x ρ j i ω * x j i ω) / totalWeight w1 F x ρ j ω

/-- Number of mistakes `m = Σ_{j<t} |λ^{(j)} − ρ^{(j)}|` of WMR over `t` trials. -/
def mistakes {Ω : Type*} (t : ℕ) (lam ρ : ℕ → Ω → ℝ) (ω : Ω) : ℝ :=
  ∑ j ∈ Finset.range t, |lam j ω - ρ j ω|

/-- The σ-algebra generated by `(x^{(1)}, ρ^{(1)}), …, (x^{(j+1)}, ρ^{(j+1)})`: the pool's
prediction vectors and the labels of the zero-based trials `0, …, j`, the current one
included. -/
@[reducible] def history {Ω : Type*} {n : ℕ} (x : ℕ → Fin n → Ω → ℝ) (ρ : ℕ → Ω → ℝ) (j : ℕ) :
    MeasurableSpace Ω :=
  ⨆ (k : ℕ) (_ : k ≤ j),
    MeasurableSpace.comap (fun ω => ((fun i => x k i ω), ρ k ω)) inferInstance

/-- The standing assumptions of WMR on `t` trials (§5–§6): `0 ≤ β < 1`; positive initial
weights; pool predictions in `[0,1]`, binary labels and binary master predictions, all
measurable random variables; measurable update factors satisfying (5.1) in every trial on
every sample path. -/
def IsWMRModel {Ω : Type*} [MeasurableSpace Ω] {n : ℕ} (t : ℕ) (β : ℝ) (w1 : Fin n → ℝ)
    (F : ℕ → Fin n → ℝ → ℝ → ℝ) (x : ℕ → Fin n → Ω → ℝ) (ρ lam : ℕ → Ω → ℝ) : Prop :=
  0 ≤ β ∧ β < 1 ∧
  (∀ i : Fin n, 0 < w1 i) ∧
  (∀ j < t, ∀ i : Fin n, Measurable (Function.uncurry (F j i))) ∧
  (∀ j < t, ∀ i : Fin n, Measurable (x j i)) ∧
  (∀ j < t, ∀ i : Fin n, ∀ ω, 0 ≤ x j i ω ∧ x j i ω ≤ 1) ∧
  (∀ j < t, Measurable (ρ j)) ∧
  (∀ j < t, ∀ ω, ρ j ω = 0 ∨ ρ j ω = 1) ∧
  (∀ j < t, Measurable (lam j)) ∧
  (∀ j < t, ∀ ω, lam j ω = 0 ∨ lam j ω = 1) ∧
  (∀ j < t, ∀ i : Fin n, ∀ ω,
    β ^ |x j i ω - ρ j ω| ≤ F j i (x j i ω) (ρ j ω) ∧
    F j i (x j i ω) (ρ j ω) ≤ 1 - (1 - β) * |x j i ω - ρ j ω|)

/-- The weak independence condition (p. 238):
`E(λ^{(j)} | (x^{(1)}, ρ^{(1)}), …, (x^{(j)}, ρ^{(j)})) = γ^{(j)}` almost surely, for every
trial. -/
def WeakIndependence {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) {n : ℕ} (t : ℕ)
    (w1 : Fin n → ℝ) (F : ℕ → Fin n → ℝ → ℝ → ℝ) (x : ℕ → Fin n → Ω → ℝ)
    (ρ lam : ℕ → Ω → ℝ) : Prop :=
  ∀ j < t, P[lam j | history x ρ j] =ᵐ[P] gamma w1 F x ρ j

end WeightedMajority.Randomized


