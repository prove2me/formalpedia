theorem span_range_mul_mul_eq_top {R : Type} [CommRing R] {ι₁ ι₂ ι₃ : Type}
    (a : ι₁ → R) (b : ι₂ → R) (c : ι₃ → R)
    (ha : Ideal.span (Set.range a) = ⊤) (hb : Ideal.span (Set.range b) = ⊤) (hc : Ideal.span (Set.range c) = ⊤) :
    Ideal.span (Set.range (fun p : ι₁ × ι₂ × ι₃ => a p.1 * b p.2.1 * c p.2.2)) = ⊤ := by
  have h : Ideal.span (Set.range a) * Ideal.span (Set.range b) * Ideal.span (Set.range c) ≤
      Ideal.span (Set.range (fun p : ι₁ × ι₂ × ι₃ => a p.1 * b p.2.1 * c p.2.2)) := by
    rw [Ideal.span_mul_span', Ideal.span_mul_span']
    apply Ideal.span_mono
    rintro _ ⟨_, ⟨_, ⟨i, rfl⟩, _, ⟨j, rfl⟩, rfl⟩, _, ⟨k, rfl⟩, rfl⟩
    exact ⟨(i, j, k), rfl⟩
  rw [ha, hb, hc, Ideal.top_mul, Ideal.top_mul] at h
  exact eq_top_iff.mpr h

theorem span_range_comp_eq_top {R S : Type} [CommRing R] [CommRing S] (f : R →+* S) {ι : Type} (a : ι → R)
    (ha : Ideal.span (Set.range a) = ⊤) : Ideal.span (Set.range (fun i => f (a i))) = ⊤ := by
  have h := congrArg (Ideal.map f) ha
  rw [Ideal.map_span, Ideal.map_top, ← Set.range_comp] at h
  exact h

