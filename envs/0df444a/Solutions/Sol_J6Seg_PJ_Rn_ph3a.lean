-- Source module: Solutions.J6SegILPreJ6
/-!
# B-line IL, `J` pre-table (B5-J), part 6: the four loops of the parameter phase

Each loop runs on the counter stack `48` and changes one or two registers:
`sqL` (`5 := √d`), `lgL` (`24 := 2^⌊log₂ x⌋`), `szL` (`8 := size x`, `11` scratch),
`pwL` (`x := 2^N`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS E Function

theorem nrg48 : cLC ∉ rg := by decide

section loops
variable {W : ℕ} {c : Cs}

theorem upd_upd_eq {vb : Vr} {i : Fin HS} (a b : ℤ) : update (update vb i a) i b = update vb i b :=
  update_idem _ _ _

theorem upd2 {vb : Vr} {i j : Fin HS} (hij : i ≠ j) (x y a b : ℤ) :
    update (update (update (update vb i x) j y) i a) j b = update (update vb i a) j b := by
  funext q; simp only [update_apply]; split_ifs <;> simp_all

/-- `8 := size x` (from `8 = 0`, `11 = x`, `7 = x`); `11` ends at `0`. -/
theorem szL {vb : Vr} {x : ℕ} (hvb : BV W vb) (h8 : vb 8 = 0) (h11 : vb 11 = x) (h7 : vb 7 = x)
    (hx : x + 1 < 2 ^ W) (hc : c cLC = []) :
    Rn (.rep cLC (.reg 7) (PJ.asgs [(8, eSz1), (11, eSz2)])) vb c
      (fun v => v = update (update vb 8 (Nat.size x : ℤ)) 11 0 ∧ BV W v) c
      (cLoop W x (cA W [(8, eSz1), (11, eSz2)])) := by
  have hW : 2 ≤ 2 ^ W := by omega
  have h := Rn.loopA (c := c) (C := cLC) (rN := 7) (l := [(8, eSz1), (11, eSz2)]) nrg48 (by decide)
    (by decide) (by decide) (W := W) (by simp [lbA, eSz1, eSz2, E.lb]; omega) (N := x) (by omega)
    (Iv := fun k v => v = update (update vb 8 ((min k (Nat.size x) : ℕ) : ℤ)) 11
      ((x / 2 ^ k : ℕ) : ℤ))
    (fun k hk v hI hB => by
      subst hI
      obtain ⟨s1, s2⟩ := szS_step x k
      have e1 : eSz1.den (update (update vb 8 ((min k (Nat.size x) : ℕ) : ℤ)) 11
          ((x / 2 ^ k : ℕ) : ℤ)) = ((min (k + 1) (Nat.size x) : ℕ) : ℤ) := by
        rw [← s1]; simp [eSz1, E.den, update_apply]
      have e2 : ∀ a : ℤ, eSz2.den (update (update (update vb 8 ((min k (Nat.size x) : ℕ) : ℤ)) 11
          ((x / 2 ^ k : ℕ) : ℤ)) 8 a) = ((x / 2 ^ (k + 1) : ℕ) : ℤ) := by
        intro a; rw [← s2]; simp [eSz2, E.den, update_apply]
      have hs : Nat.size x ≤ x := by
        rw [Nat.size_le]; exact Nat.lt_two_pow_self
      refine ⟨⟨?_, ?_, trivial⟩, ?_⟩
      · rw [e1, abs_of_nonneg (by positivity)]
        exact_mod_cast (by omega : min (k + 1) (Nat.size x) ≤ 2 ^ W)
      · rw [e1, e2, abs_of_nonneg (by positivity)]
        have : x / 2 ^ (k + 1) ≤ x := Nat.div_le_self _ _
        exact_mod_cast (by omega : x / 2 ^ (k + 1) ≤ 2 ^ W)
      · simp only [runA]; rw [e1, e2, upd2 (by decide)])
    hc (by
      rw [show min 0 (Nat.size x) = 0 by simp, pow_zero, Nat.div_one, Nat.cast_zero, ← h8, ← h11]
      simp) hvb h7
  refine h.mono (fun v ⟨hv, hB⟩ => ⟨?_, hB⟩) le_rfl
  have hs : Nat.size x ≤ x := by rw [Nat.size_le]; exact Nat.lt_two_pow_self
  rw [hv, min_eq_right hs, Nat.div_eq_of_lt Nat.lt_two_pow_self]; rfl

/-- `x := 2^N` (from `x = 1`, `rc = N`). -/
theorem pwL {vb : Vr} {x rc : Fin HS} (hx : x ∈ rg) (hrc : rc ∈ rg) (hxr : x ≠ rc) {N : ℕ}
    (hvb : BV W vb) (h1 : vb x = 1) (hN : vb rc = N) (hNW : 2 ^ N ≤ 2 ^ W) (hNW' : N < 2 ^ W)
    (hW : 2 ≤ 2 ^ W) (hc : c cLC = []) :
    Rn (.rep cLC (.reg rc) (PJ.asgs [(x, ePw x)])) vb c
      (fun v => v = update vb x ((2 ^ N : ℕ) : ℤ) ∧ BV W v) c (cLoop W N (cA W [(x, ePw x)])) := by
  have h := Rn.loopA (c := c) (C := cLC) (rN := rc) (l := [(x, ePw x)]) nrg48 (by decide) hrc
    (by simp [okA, ePw, E.ok, hx]) (W := W) (by simp [lbA, ePw, E.lb]; omega) (N := N) hNW'
    (Iv := fun k v => v = update vb x ((2 ^ k : ℕ) : ℤ))
    (fun k hk v hI hB => by
      subst hI
      have e : (ePw x).den (update vb x ((2 ^ k : ℕ) : ℤ)) = ((2 ^ (k + 1) : ℕ) : ℤ) := by
        simp [ePw, E.den, pow_succ]; ring
      refine ⟨⟨?_, trivial⟩, ?_⟩
      · rw [e, abs_of_nonneg (by positivity)]
        have := Nat.pow_le_pow_right (by norm_num : 0 < 2) (show k + 1 ≤ N by omega)
        exact_mod_cast le_trans this hNW
      · simp only [runA]; rw [e, upd_upd_eq])
    hc (by simp [← h1]) hvb hN
  exact h

end loops

end J6Seg.PJ

end

