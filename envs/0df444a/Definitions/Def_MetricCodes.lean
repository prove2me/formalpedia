    {r n : ℕ} (lam : Fin (r + 1) → ℕ)
    (p : youngMultihomogeneousSubmodule n lam) :
    p ∈ jointHarmonicWeightSubmodule n lam ↔
      (p : PolynomialSpace r n) ∈ traceFreeSubmodule r n := Iff.rfl
instance jointHarmonicWeightSpace_finiteDimensional
