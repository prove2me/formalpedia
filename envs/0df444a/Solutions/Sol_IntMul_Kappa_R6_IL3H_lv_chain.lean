-- Source module: Solutions.R6IL3Node3
/-!
# Round six, item language (I3): level frames of the leftover, the chain and the kernel

* `levRH_push3`, `levRH_push19`: pushes on `vX, vE, vk` (a new level) or on the test register `19`
  keep a level frame;
* `frV_leftFr`, `frOK_leftFr`, **`levRH_left`**: the leftover frame of a node is a level frame on
  `E mod m` bits at `e - K m F`;
* `frV_chainFr`, `frOK_chainFr`, **`levRH_chain`**: the chain frame is a level frame on `E - 1`
  bits at `e - K`;
* `frV_kerFr`, `frOK_kerFr`, **`levR_ker`**: the kernel frame is a frozen level-`0` frame;
* **`tens_split`**: `tens A` on `ι` is the product of `tens A` on two complementary subfamilies;
  `gN1`, `gN2` (node), `gC0`, `gC1` (chain) and their strides.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

section Push

variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

theorem lev3_nodup (c : Cfg) (E' e' : ℕ) : ((lev3 c E' e').map Prod.fst).Nodup := by
  simp only [lev3, List.map_cons, List.map_nil]; decide

theorem lev3_ne (c : Cfg) (E' e' : ℕ) {i : Fin HS} (hi : i ∉ [vX, vE, vk]) :
    σPush σ (lev3 c E' e') i = σ i :=
  σPush_ne _ _ _ (fun p hp hpi => hi (by
    simp only [lev3, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl <;> simp [← hpi]))

/-- **A new level over a level frame.** -/
theorem levRH_push3 (hL : LevRH c σ K t S0 r H E e B) (E' e' : ℕ) :
    LevRH c (σPush σ (lev3 c E' e')) K t S0 r H E' e' B := by
  have ne : ∀ i : Fin HS, i ∉ [vX, vE, vk] → σPush σ (lev3 c E' e') i = σ i :=
    fun i hi => lev3_ne c E' e' hi
  have mem : ∀ i v, (i, v) ∈ lev3 c E' e' → σPush σ (lev3 c E' e') i = some v :=
    fun i v h => σPush_mem _ _ _ _ (lev3_nodup c E' e') h
  refine ⟨fun i hi => ?_, fun i hi => ?_, fun i v hv => ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [ne i (by revert hi; revert i; decide)]; exact hL.off i hi
  · rw [ne i (by revert hi; revert i; decide)]; exact hL.offp i hi
  · rcases σPush_cases _ _ _ _ hv with ⟨p, hp, rfl⟩ | h'
    · simp only [lev3, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl <;> (simp only []; decide)
    · exact hL.lt i v h'
  · rw [ne _ (by decide)]; exact hL.hK
  · rw [ne _ (by decide)]; exact hL.ht
  · rw [ne _ (by decide)]; exact hL.hS
  · rw [ne _ (by decide)]; exact hL.hr
  · rw [ne _ (by decide)]; exact hL.hH
  · exact mem _ _ (by simp [lev3])
  · exact mem _ _ (by simp [lev3])
  · rw [ne _ (by decide)]; exact hL.hB
  · exact mem _ _ (by simp [lev3])

/-- **The test register over a level frame.** -/
theorem levRH_push19 (hL : LevRH c σ K t S0 r H E e B) (v : ℤ) :
    LevRH c (σPush σ [((19 : Fin HS), v)]) K t S0 r H E e B := by
  have ne : ∀ i : Fin HS, i ≠ 19 → σPush σ [((19 : Fin HS), v)] i = σ i := fun i hi =>
    σPush_ne _ _ _ (fun p hp hpi => hi (by simp only [List.mem_singleton] at hp; subst hp; exact hpi.symm))
  refine ⟨fun i hi => ?_, fun i hi => ?_, fun i u hu => ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [ne i (by revert hi; revert i; decide)]; exact hL.off i hi
  · rw [ne i (by revert hi; revert i; decide)]; exact hL.offp i hi
  · rcases σPush_cases _ _ _ _ hu with ⟨p, hp, rfl⟩ | h'
    · simp only [List.mem_singleton] at hp; subst hp; simp only []; decide
    · exact hL.lt i u h'
  · rw [ne _ (by decide)]; exact hL.hK
  · rw [ne _ (by decide)]; exact hL.ht
  · rw [ne _ (by decide)]; exact hL.hS
  · rw [ne _ (by decide)]; exact hL.hr
  · rw [ne _ (by decide)]; exact hL.hH
  · rw [ne _ (by decide)]; exact hL.hk
  · rw [ne _ (by decide)]; exact hL.hE
  · rw [ne _ (by decide)]; exact hL.hB
  · rw [ne _ (by decide)]; exact hL.hX

end Push

/-! ## The leftover frame -/

/-! ## The chain frames -/

section Chain

variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

theorem frV_chainFr (hL : LevRH c σ K t S0 r H E e B) :
    frV σ chainFr = [(vX, ((E - 1 : ℕ) : ℤ)), (vE, ((e - K : ℕ) : ℤ)), (vk, ((E - 1 : ℕ) : ℤ))] := by
  simp only [frV, chainFr, List.map_cons, List.map_nil, NE.val, vOf_eq hL.hk,
    vOf_eq hL.hE, vOf_eq hL.hK]
  congr 3
  split_ifs with h
  · rfl
  · omega

/-- **The chain frame is a level frame** (for `E < 2m`). -/
theorem levRH_chain (hL : LevRH c σ K t S0 r H E e B) (hE : E < 2 * c.m) :
    LevRH c (σPush σ (frV σ chainFr)) K t S0 r H (E - 1) (e - K) B := by
  have h := levRH_push3 hL (E - 1) (e - K)
  have hG : c.G (E - 1) = E - 1 := Gs_lt (by omega)
  rw [frV_chainFr hL]
  unfold lev3 at h
  rw [hG] at h
  exact h

end Chain

