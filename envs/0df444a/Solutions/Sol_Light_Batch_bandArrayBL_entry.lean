  have hN0 : p.N0 ≤ 7 ^ p.L :=
    (Nat.pow_le_pow_right (by omega) (Nat.sub_le _ _)).trans (Nat.pow_le_pow_left (by omega) _)
  have hL : p.L < 7 ^ p.L := Nat.lt_pow_self (by omega)
