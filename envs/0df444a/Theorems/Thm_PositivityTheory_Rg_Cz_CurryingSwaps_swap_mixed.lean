variable {α : Type*} {m k : ℕ}

theorem PositivityTheory.Rg.Cz.CurryingSwaps.swap_mixed (I : Fin m → α) (J : Fin k → α) (i : Fin m) (j : Fin k) :
    Fin.append I J ∘ Equiv.swap (Fin.castAdd k i) (Fin.natAdd m j) =
      Fin.append (Function.update I i (J j)) (Function.update J j (I i)) := by sorry
