namespace NLogN.KFS

open IntMul KIL KFB KFL AModel AModelL12

variable {α β : Type*}

/-- Entry `j` of a uniform-block concatenation. -/
theorem getElem?_flatMap_const (f : α → List β) (B : ℕ) (hf : ∀ x, (f x).length = B) (hB : 0 < B) :
    ∀ (xs : List α) (j : ℕ),
      (xs.flatMap f)[j]? = (xs[j / B]?).bind (fun x => (f x)[j % B]?)
  | [], j => by simp
  | x :: xs, j => by
    rw [List.flatMap_cons]
    by_cases hj : j < B
    · rw [List.getElem?_append_left (by rw [hf]; exact hj), Nat.div_eq_of_lt hj,
        Nat.mod_eq_of_lt hj]
      simp
    · rw [List.getElem?_append_right (by rw [hf]; omega), hf,
        getElem?_flatMap_const f B hf hB xs (j - B)]
      have e1 : j / B = (j - B) / B + 1 := by
        rw [← Nat.sub_add_cancel (show B ≤ j by omega)]
        rw [Nat.add_div_right _ hB]; simp
      have e2 : j % B = (j - B) % B := by
        conv_lhs => rw [← Nat.sub_add_cancel (show B ≤ j by omega)]
        simp
      rw [e1, e2]; simp

theorem length_flatMap_const (f : α → List β) (B : ℕ) (hf : ∀ x, (f x).length = B) (xs : List α) :
    (xs.flatMap f).length = xs.length * B := by
  induction xs with
  | nil => simp
  | cons x xs ih => rw [List.flatMap_cons, List.length_append, ih, hf]; simp; ring

theorem decode_snoc (sh : Shape) (B : ℕ) {j : ℕ} (hj : j < vol sh * B) :
    decode (sh ++ [B]) j = decode sh (j / B) ++ [j % B] := by
  have hB : vol [B] = B := by simp
  rw [decode_append sh [B] (by rw [hB]; exact hj), hB]
  simp [decode]

theorem encode_snoc (sh : Shape) (B : ℕ) {a : List ℕ} (ha : a.length = sh.length) (b : ℕ) :
    encode (sh ++ [B]) (a ++ [b]) = encode sh a * B + b := by
  rw [encode_append_len sh [B] ha]; simp [encode]

end NLogN.KFS

