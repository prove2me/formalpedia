  · subst hR; simp +decide
  by_cases hx : j = kx
  · subst hx; simp +decide
  by_cases ht : j = kt
  · subst ht; simp +decide
  by_cases hu : j = ku
  · subst hu; simp +decide
  by_cases hy : j = ky
