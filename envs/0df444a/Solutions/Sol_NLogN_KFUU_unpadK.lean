theorem length_unpadL {X F F' Y : ℕ} {ys : List α} (hys : X * (F' * Y) ≤ ys.length) (hF : F ≤ F') :
    (unpadL X F F' Y ys).length = X * (F * Y) := by
  unfold unpadL
  rw [length_flatMap_range (L := F * Y) X (fun x hx => by
    simp only [List.length_take, List.length_drop]
    apply min_eq_left
    have : (x + 1) * (F' * Y) ≤ X * (F' * Y) := Nat.mul_le_mul_right _ hx
    have h2 : F * Y ≤ F' * Y := Nat.mul_le_mul_right _ hF
    rw [Nat.succ_mul] at this; omega)]

lemma decode_cons_lt {F : ℕ} {B : Shape} {r : ℕ} (hr : r < F * AModel.vol B) :
    decode (F :: B) r = r / AModel.vol B :: decode B (r % AModel.vol B) := by
  have hY : 0 < AModel.vol B := by
    rcases Nat.eq_zero_or_pos (AModel.vol B) with h | h
    · rw [h, Nat.mul_zero] at hr; omega
    · exact h
