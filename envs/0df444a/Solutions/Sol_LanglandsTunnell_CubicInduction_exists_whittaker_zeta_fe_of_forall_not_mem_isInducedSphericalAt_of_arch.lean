private theorem eq_mul_mul_of_dual_factorisation {ι : Type*} [DecidableEq ι] (S T : Finset ι) (hST : S ⊆ T)
    {Zd Pd PT PA Λd γ cA : ℂ → ℂ} {κb κ ZT A AFd LFd s : ℂ} {L z P : ι → ℂ} {cS cT : ι → ℂ → ℂ}
    (hZd : Zd (1 - s) = κb * (ZT * ∏' v : {v // v ∉ T}, L v))
    (hT : ZT = A * ∏ v ∈ T, z v)
    (hzS : ∀ v ∈ S, z v = L v * cS v s * P v) (hzT : ∀ v ∈ T \ S, z v = L v * cT v s * P v)
    (hA : A = cA s * PA s * AFd) (hΛd : Λd (1 - s) = AFd * LFd) (hκ : 2 * κ = 1)
    (hmul : Multipliable fun v : {v // v ∉ T} => L v) (hLF : ∏' v, L v = LFd)
    (hγ : γ s = (∏ v ∈ S, cS v s) * (∏ v ∈ T \ S, cT v s) * cA s) (hPT : PT s = ∏ v ∈ T, P v)
    (hPd : Pd s = γ s * (PT s * PA s)) :
    Zd (1 - s) = κb * (Pd s * Λd (2 * κ - s)) := by
  have hreg : (∏ v ∈ T, L v) * ∏' v : {v // v ∉ T}, L v = LFd := by
    rw [← hLF]; exact StripAssembly.prod_mul_tprod_subtype_eq_tprod T hmul
  have hL : (∏ v ∈ S, L v) * ∏ v ∈ T \ S, L v = ∏ v ∈ T, L v := by rw [mul_comm, Finset.prod_sdiff hST]
  have hP : (∏ v ∈ S, P v) * ∏ v ∈ T \ S, P v = ∏ v ∈ T, P v := by rw [mul_comm, Finset.prod_sdiff hST]
  have hz : ∏ v ∈ T, z v = ((∏ v ∈ S, L v) * (∏ v ∈ S, cS v s) * ∏ v ∈ S, P v) *
      ((∏ v ∈ T \ S, L v) * (∏ v ∈ T \ S, cT v s) * ∏ v ∈ T \ S, P v) := by
    rw [← Finset.prod_sdiff hST, mul_comm, Finset.prod_congr rfl hzS, Finset.prod_congr rfl hzT]
    simp only [Finset.prod_mul_distrib]
  have h2κ : 2 * κ - s = 1 - s := by rw [hκ]
  rw [h2κ, hPd, hγ, hPT, hΛd, hZd, hT, hA, hz, ← hreg, ← hL, ← hP]
  ring

private theorem exists_forall_norm_apply_one_sub_le_of_forall_integral_eq {X : Type*} [MeasurableSpace X]
    (μ : Measure X) (f : X → ℂ) (m : X → ℝ) (hm : ∀ x, 0 < m x) (Zd : ℂ → ℂ) (σ₀ c : ℝ) (C : ℂ) (hc : σ₀ ≤ c)
    (hZd : ∀ w : ℂ, σ₀ ≤ w.re → Zd w = C * ∫ x, f x * ↑(m x) ^ (w - 1) ∂μ)
    (hint : ∀ σ : ℝ, σ₀ ≤ σ → Integrable (fun x => f x * ↑(m x) ^ ((σ : ℂ) - 1)) μ) :
    ∀ a b : ℝ, b < 1 - c → ∃ C' : ℝ, ∀ s : ℂ, a ≤ s.re → s.re ≤ b → ‖Zd (1 - s)‖ ≤ C' := by
  intro a b hb
  obtain ⟨C₀, hC₀⟩ := StripBound.exists_forall_norm_integral_mul_cpow_le_of_forall (μ := μ) (f := f) hm
    (α := 1 - b) (β := 1 - a) fun σ h₁ _ => hint σ (by linarith)
  refine ⟨‖C‖ * C₀, fun s ha hb' => ?_⟩
  have hre : (1 - s).re = 1 - s.re := by simp
  rw [hZd (1 - s) (by rw [hre]; linarith), norm_mul]
  exact mul_le_mul_of_nonneg_left (hC₀ (1 - s) (by rw [hre]; linarith) (by rw [hre]; linarith)) (norm_nonneg C)

private theorem inducedE_inv_eq_of_forall_ne_zero (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)]
    [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (hdeg : Module.finrank ℚ K = 3)
    (c : HeightOneSpectrum (𝓞 K) → ℂ) (v : HeightOneSpectrum (𝓞 ℚ)) (hfin : (RankinSelberg.primeFibre ℚ K v).Finite)
    (he : ∀ 𝔓 ∈ RankinSelberg.primeFibre ℚ K v, (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hc : ∀ 𝔓 ∈ RankinSelberg.primeFibre ℚ K v, c 𝔓 ≠ 0) :
    RankinSelberg.inducedE1 ℚ (fun 𝔓 => (c 𝔓)⁻¹) v
        = RankinSelberg.inducedE2 ℚ c v / RankinSelberg.inducedE3 ℚ c v ∧
      RankinSelberg.inducedE2 ℚ (fun 𝔓 => (c 𝔓)⁻¹) v
        = RankinSelberg.inducedE1 ℚ c v / RankinSelberg.inducedE3 ℚ c v ∧
      RankinSelberg.inducedE3 ℚ (fun 𝔓 => (c 𝔓)⁻¹) v = (RankinSelberg.inducedE3 ℚ c v)⁻¹ := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›

  set F := hfin.toFinset
  set f : HeightOneSpectrum (𝓞 K) → ℕ := fun 𝔓 => (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal with hf
  have hmemF : ∀ 𝔓, 𝔓 ∈ F ↔ 𝔓 ∈ RankinSelberg.primeFibre ℚ K v := fun 𝔓 => hfin.mem_toFinset
  have hv : ∀ 𝔓 ∈ F, 𝔓.under (𝓞 ℚ) = v := fun 𝔓 h𝔓 =>
    (RankinSelberg.mem_primeFibre ℚ v 𝔓).mp ((hmemF 𝔓).mp h𝔓)

  have hsum : ∑ 𝔓 ∈ F, f 𝔓 = 3 := by
    have h := FibreDegree.sum_toFinset_ramificationIdx_mul_inertiaDeg K v
    rw [hdeg] at h
    rw [← h]
    refine Finset.sum_congr rfl fun 𝔓 h𝔓 => ?_
    have h1 : v.asIdeal.ramificationIdx' 𝔓.asIdeal = 1 := by
      have h2 := he 𝔓 ((hmemF 𝔓).mp h𝔓); rwa [hv 𝔓 h𝔓] at h2
    simp only [hf]
    rw [hv 𝔓 h𝔓, h1, one_mul]

  have hprod : ∏ 𝔓 ∈ F, c 𝔓 ≠ 0 := Finset.prod_ne_zero_iff.mpr fun 𝔓 h𝔓 => hc 𝔓 ((hmemF 𝔓).mp h𝔓)
  have hE₃ : RankinSelberg.inducedE3 ℚ c v = (-1) ^ (F.card + 1) * ∏ 𝔓 ∈ F, c 𝔓 :=
    TwistFibre.inducedE3_eq K hdeg v (fun 𝔓 h𝔓 => by
      have h2 := he 𝔓 h𝔓; rwa [(RankinSelberg.mem_primeFibre ℚ v 𝔓).mp h𝔓] at h2) c

  have heval : ∀ (d : HeightOneSpectrum (𝓞 K) → ℂ) (w : ℂ),
      (RankinSelberg.inducedEulerPoly ℚ d v).eval w = ∏ 𝔓 ∈ F, (1 - d 𝔓 * w ^ f 𝔓) := by
    intro d w
    rw [RankinSelberg.inducedEulerPoly, finprod_mem_eq_finite_toFinset_prod _ hfin, Polynomial.eval_prod]
    refine Finset.prod_congr rfl fun 𝔓 _ => ?_
    simp [RankinSelberg.inducedFactor, hf]

  have hkey : ∀ z : ℂ, z ≠ 0 →
      (RankinSelberg.inducedEulerPoly ℚ (fun 𝔓 => (c 𝔓)⁻¹) v).eval z
        = (-1) ^ F.card * (∏ 𝔓 ∈ F, c 𝔓)⁻¹ * z ^ 3 * (RankinSelberg.inducedEulerPoly ℚ c v).eval z⁻¹ := by
    intro z hz
    have hfac : ∀ 𝔓 ∈ F, (1 - (c 𝔓)⁻¹ * z ^ f 𝔓) = (-(c 𝔓)⁻¹ * z ^ f 𝔓) * (1 - c 𝔓 * z⁻¹ ^ f 𝔓) := by
      intro 𝔓 h𝔓
      have hc0 : c 𝔓 ≠ 0 := hc 𝔓 ((hmemF 𝔓).mp h𝔓)
      rw [inv_pow]
      field_simp [hc0, hz]
      ring
    rw [heval, heval, Finset.prod_congr rfl hfac, Finset.prod_mul_distrib]
    congr 1
    rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hsum, Finset.prod_neg, Finset.prod_inv_distrib]

  have hcubic : AutomorphicForm.gl3LFactorPoly (RankinSelberg.inducedE1 ℚ (fun 𝔓 => (c 𝔓)⁻¹) v)
      (RankinSelberg.inducedE2 ℚ (fun 𝔓 => (c 𝔓)⁻¹) v) (RankinSelberg.inducedE3 ℚ (fun 𝔓 => (c 𝔓)⁻¹) v)
        = AutomorphicForm.gl3LFactorPoly (RankinSelberg.inducedE2 ℚ c v / RankinSelberg.inducedE3 ℚ c v)
            (RankinSelberg.inducedE1 ℚ c v / RankinSelberg.inducedE3 ℚ c v) (RankinSelberg.inducedE3 ℚ c v)⁻¹ := by
    apply Polynomial.eq_of_infinite_eval_eq
    refine Set.Infinite.mono (s := {z : ℂ | z ≠ 0}) (fun z hz => ?_) (Set.finite_singleton (0 : ℂ)).infinite_compl
    have hz : z ≠ 0 := hz
    have h₁ := RankinSelberg.eval_inducedEulerPoly_eq_of_finrank_le_three K hdeg.le (fun 𝔓 => (c 𝔓)⁻¹) v z
    have h₂ := RankinSelberg.eval_inducedEulerPoly_eq_of_finrank_le_three K hdeg.le c v z⁻¹
    have h₃ := hkey z hz
    rw [h₁, h₂] at h₃
    simp only [Set.mem_setOf_eq, AutomorphicForm.gl3LFactorPoly_def, eval_sub, eval_add, eval_one, eval_mul, eval_C,
      eval_pow, eval_X]
    rw [h₃]

    rcases neg_one_pow_eq_or ℂ F.card with hs | hs
    · have hE₃' : RankinSelberg.inducedE3 ℚ c v = -∏ 𝔓 ∈ F, c 𝔓 := by
        rw [hE₃, pow_succ, hs]; ring
      rw [hE₃', hs]; field_simp [hprod, hz]; ring
    · have hE₃' : RankinSelberg.inducedE3 ℚ c v = ∏ 𝔓 ∈ F, c 𝔓 := by
        rw [hE₃, pow_succ, hs]; ring
      rw [hE₃', hs]; field_simp [hprod, hz]; ring
  exact AutomorphicForm.gl3LFactorPoly_inj hcubic

private theorem inducedEulerPoly_eq_comp_of_forall_eq_mul_pow
    (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)]
    [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] {R : Type*} [CommRing R] (c c₂ : HeightOneSpectrum (𝓞 K) → R) (u : R)
    (v : HeightOneSpectrum (𝓞 ℚ)) (hfin : (RankinSelberg.primeFibre ℚ K v).Finite)
    (h : ∀ 𝔓 ∈ RankinSelberg.primeFibre ℚ K v, c₂ 𝔓 = c 𝔓 * u ^ (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal) :
    RankinSelberg.inducedEulerPoly ℚ c₂ v = (RankinSelberg.inducedEulerPoly ℚ c v).comp (C u * X) := by
  rw [RankinSelberg.inducedEulerPoly, RankinSelberg.inducedEulerPoly, finprod_mem_eq_finite_toFinset_prod _ hfin,
    finprod_mem_eq_finite_toFinset_prod _ hfin, Polynomial.prod_comp]
  refine Finset.prod_congr rfl fun 𝔓 h𝔓 => ?_
  rw [RankinSelberg.inducedFactor, RankinSelberg.inducedFactor, h 𝔓 (hfin.mem_toFinset.mp h𝔓), sub_comp, C_comp,
    mul_comp, C_comp, pow_comp, X_comp, mul_pow, ← C_pow, ← mul_assoc, ← C_mul]

private theorem inducedEulerPoly_inv_inducedCoeff_mul_comp_idelicNorm_eq_comp {K : Type} [Field K] [NumberField K]
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ))
    (hfin : (RankinSelberg.primeFibre ℚ K v).Finite)
    (hμ : ∀ 𝔓 ∈ RankinSelberg.primeFibre ℚ K v, TateGlobal.IsUnramifiedCharAt μ 𝔓)
    (he : ∀ 𝔓 ∈ RankinSelberg.primeFibre ℚ K v, (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hχ : TateGlobal.IsUnramifiedCharAt χ v) :
    RankinSelberg.inducedEulerPoly ℚ
        (fun 𝔓 => (inducedCoeff K (μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm) 𝔓)⁻¹) v
      = (RankinSelberg.inducedEulerPoly ℚ (fun 𝔓 => (inducedCoeff K μ 𝔓)⁻¹) v).comp
          (C ((χ (AutomorphicForm.uniformizerIdele ℚ v) : ℂ)⁻¹) * X) := by
  refine inducedEulerPoly_eq_comp_of_forall_eq_mul_pow K _ _ _ v hfin fun 𝔓 h𝔓 => ?_
  have hv : 𝔓.under (𝓞 ℚ) = v := (RankinSelberg.mem_primeFibre ℚ v 𝔓).mp h𝔓
  have h₁ := TwistLegs.inducedCoeff_mul_comp_idelicNorm_of_isUnramifiedCharAt μ χ 𝔓 (hμ 𝔓 h𝔓) (he 𝔓 h𝔓)
    (by rw [hv]; exact hχ)
  show (inducedCoeff K (μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm) 𝔓)⁻¹
      = (inducedCoeff K μ 𝔓)⁻¹ * ((χ (AutomorphicForm.uniformizerIdele ℚ v) : ℂ)⁻¹)
          ^ (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal
  rw [h₁, mul_inv, inv_pow, hv]

private theorem inducedEulerPoly_inv_inducedCoeff_mul_comp_idelicNorm_eq_one {K : Type} [Field K] [NumberField K]
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ))
    (hμ : ∀ 𝔓 ∈ RankinSelberg.primeFibre ℚ K v, TateGlobal.IsUnramifiedCharAt μ 𝔓)
    (he : ∀ 𝔓 ∈ RankinSelberg.primeFibre ℚ K v, (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hcont : Continuous ⇑(TateGlobal.localChar χ v)) (hχ : ¬ TateGlobal.IsUnramifiedCharAt χ v) :
    RankinSelberg.inducedEulerPoly ℚ
        (fun 𝔓 => (inducedCoeff K (μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm) 𝔓)⁻¹) v
      = 1 := by
  rw [RankinSelberg.inducedEulerPoly]
  refine finprod_mem_of_eqOn_one fun 𝔓 h𝔓 => ?_
  have hv : 𝔓.under (𝓞 ℚ) = v := (RankinSelberg.mem_primeFibre ℚ v 𝔓).mp h𝔓
  have h₀ := TwistLegs.inducedCoeff_mul_comp_idelicNorm_of_not_isUnramifiedCharAt μ χ 𝔓 (hμ 𝔓 h𝔓) (he 𝔓 h𝔓)
    (by rw [hv]; exact hcont) (by rw [hv]; exact hχ)
  have h₁ : (inducedCoeff K (μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm) 𝔓)⁻¹ = 0 := by
    rw [h₀, inv_zero]
  show RankinSelberg.inducedFactor ℚ _ 𝔓 = 1
  rw [RankinSelberg.inducedFactor]
  simp only [h₁, map_zero, zero_mul, sub_zero, map_one]

private theorem hasConductorExponentAt_inv (K : Type) [Field K] [NumberField K] (v : HeightOneSpectrum (𝓞 K))
    {χ : (v.adicCompletion K)ˣ →* ℂˣ} {a : ℕ} (h : TateLocal.HasConductorExponentAt K v χ a) :
    TateLocal.HasConductorExponentAt K v χ⁻¹ a := by
  refine ⟨fun u hu => ?_, fun m hm => ?_⟩
  · rw [MonoidHom.inv_apply, h.1 u hu, inv_one]
  · obtain ⟨u, hu, hne⟩ := h.2 m hm
    exact ⟨u, hu, by rwa [MonoidHom.inv_apply, Ne, inv_eq_one]⟩

private theorem inducedEulerPoly_eq_one_of_forall_eq_zero (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)]
    [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] {R : Type*} [CommRing R] (c : HeightOneSpectrum (𝓞 K) → R)
    (v : HeightOneSpectrum (𝓞 ℚ)) (h : ∀ 𝔓 ∈ RankinSelberg.primeFibre ℚ K v, c 𝔓 = 0) :
    RankinSelberg.inducedEulerPoly ℚ c v = 1 := by
  rw [RankinSelberg.inducedEulerPoly]
  refine finprod_mem_of_eqOn_one fun 𝔓 h𝔓 => ?_
  show RankinSelberg.inducedFactor ℚ c 𝔓 = 1
  rw [RankinSelberg.inducedFactor, h 𝔓 h𝔓, map_zero, zero_mul, sub_zero, map_one]

private theorem eval_dual_heckeDatum (K : Type) [Field K] [NumberField K] (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (uR : ∀ w : InfinitePlace K, w.IsReal → ℂ) (aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2)
    (uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ) (kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ)
    (𝔓 : HeightOneSpectrum (𝓞 K)) (z : ℂ) :
    ((HeckeTate.heckeDatum K χ uR aR uC kC).dual 𝔓).eval z = 1 - (inducedCoeff K χ 𝔓)⁻¹ * z := by
  by_cases h : TateGlobal.IsUnramifiedCharAt χ 𝔓 <;> simp [HeckeTate.heckeDatum, inducedCoeff, h]

private theorem inducedCoeff_eq_zero_of_not_isUnramifiedCharAt (K : Type) [Field K] [NumberField K]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (𝔓 : HeightOneSpectrum (𝓞 K)) (h : ¬ TateGlobal.IsUnramifiedCharAt μ 𝔓) :
    inducedCoeff K μ 𝔓 = 0 := by
  rw [inducedCoeff, if_neg h]

private theorem two_mul_ofReal_heckeDatum_center (K : Type) [Field K] [NumberField K] (χ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (uR : ∀ w : InfinitePlace K, w.IsReal → ℂ) (aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2)
    (uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ) (kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ) :
    2 * ((HeckeTate.heckeDatum K χ uR aR uC kC).center : ℂ) = 1 := by
  simp only [HeckeTate.heckeDatum]
  push_cast
  ring

private theorem selfDualHaarAt_real_adicCompletionIntegers_eq_one (K : Type) [Field K] [NumberField K]
    (v : HeightOneSpectrum (𝓞 K)) (h0 : TateLocal.addCharLevel (StandardAddChar.psiLocal K v) = 0) :
    letI := TateLocal.localBorel K v
    (TateLocal.selfDualHaarAt K v).real (v.adicCompletionIntegers K : Set (v.adicCompletion K)) = 1 := by
  have h := TateLocal.selfDualHaarAt_real_integers_mul_real_setOf_valued_le_exp_addCharLevel K v
  have hset :
      {x : v.adicCompletion K | Valued.v x ≤ WithZero.exp (TateLocal.addCharLevel (StandardAddChar.psiLocal K v))}
        = (v.adicCompletionIntegers K : Set (v.adicCompletion K)) := by
    ext x
    rw [h0, WithZero.exp_zero, Set.mem_setOf_eq, SetLike.mem_coe, HeightOneSpectrum.mem_adicCompletionIntegers]
  rw [hset] at h
  have hnn : (0 : ℝ) ≤ (TateLocal.selfDualHaarAt K v).real (v.adicCompletionIntegers K : Set (v.adicCompletion K)) :=
    measureReal_nonneg
  rcases mul_self_eq_one_iff.mp h with h1 | h1
  · exact h1
  · exfalso; linarith

