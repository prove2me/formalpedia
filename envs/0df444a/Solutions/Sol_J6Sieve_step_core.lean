lemma VQ_lower (Q : Finset ℕ) (z : ℕ) (hz : 0 < z) (hQ : ∀ q ∈ Q, z < q) :
    1 - (Q.card : ℝ) / z ≤ ∏ q ∈ Q, (1 - ((q : ℝ))⁻¹) := by
