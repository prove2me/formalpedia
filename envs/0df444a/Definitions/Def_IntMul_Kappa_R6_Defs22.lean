-- Source module: Solutions.R6IL3FHead
/-!
# Round six, item language (I2): the row-addition header for any label dimension `m`

Parametric copy of the `m`-dependent part of `KFX5Head` (the frozen file has the OpenAI label
dimension `mC = 100^3` hard-wired): the register assignment `rowσ m …` of the ten row-addition
parameters `[m^F, K, e, t, S0, B, r, H, i, j]` (`i j : Fin m`), the shape factors `N0R … N3R`,
the admissibility facts `PF m …` (now also `6 ≤ K` and `16 ≤ m ≤ 10^6`; round six has `m = 576`),
and the specifications `x…` of the header expressions (the expressions themselves are the frozen
ones: they read `m^F` from a register, so they do not depend on `m`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL3F

open IntMul.Kappa.R6.IL2 IntMul.Kappa.R6.IL
open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE NLogN.KFB NLogN.KFL NLogN.KFW NLogN.KFH
  NLogN.KFX AModel Butterfly

/-! ## The row-addition parameters for label dimension `m` -/

/-- The row-addition parameters `[m^F, K, e, t, S0, B, r, H, i, j]`. -/
def rowVals (m F K e t S0 B r H : ℕ) (i j : Fin m) : Fin 10 → ℤ :=
  ![((F : ℕ) : ℤ), (K : ℤ), (e : ℤ), (t : ℤ), (S0 : ℤ), (B : ℤ), (r : ℤ), (H : ℤ),
    ((i : ℕ) : ℤ), ((j : ℕ) : ℤ)]

/-- The register assignment of a row addition. -/
def rowσ (m F K e t S0 B r H : ℕ) (i j : Fin m) : Fin HS → Option ℤ := fun x =>
  if h : 36 ≤ x.val ∧ x.val < 46 then
    some (rowVals m F K e t S0 B r H i j ⟨x.val - 36, by omega⟩)
  else none

/-- The bit positions of a node at level `F + 1` (row `a`, bit `c`). -/
def posR (m K e F : ℕ) : Fin m × Fin (F) → ℕ := fun p => e - K * (p.2.val + F * p.1.val)

/-! ## The shape factors -/

/-- `sR` of row `s` at level `F`. -/
abbrev srw (m K e F s : ℕ) : ℕ := KFR.sR K (F) e s

def N0R (m F K e T B i j : ℕ) : ℕ := B * 2 ^ (T - srw m K e F (s0R i j) - F * K)
def N1R (m F K e i j : ℕ) : ℕ := 2 ^ (srw m K e F (s0R i j) - srw m K e F (s1R i j) - F * K)
def N2R (m F K e i j : ℕ) : ℕ := 2 ^ (srw m K e F (s1R i j) - srw m K e F (s2R i j) - F * K)
def N3R (m F K e S0 i j : ℕ) : ℕ := 2 ^ srw m K e F (s2R i j) * S0

/-! ## Specifications of the parameter expressions -/

/-- The admissibility facts of a row-addition parameter set. -/
structure PF (m F K e T S0 B r : ℕ) : Prop where
  k1 : 1 ≤ K
  he : K * ((F * m) - 1) ≤ e
  ht : e - e % K + K ≤ T
  s0 : 1 ≤ S0
  b : 1 ≤ B
  r : 1 ≤ r
  k6 : 6 ≤ K
  m16 : 16 ≤ m
  mle : m ≤ 1000000
  f1 : 1 ≤ F

theorem PF.m1 {m F K e T S0 B r : ℕ} (hp : PF m F K e T S0 B r) : 1 ≤ m := by
  have := hp.m16; omega

end IntMul.Kappa.R6.IL3F

end

