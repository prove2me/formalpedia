theorem solution [IsNoetherianRing (TypeDensity.BlowupChart R t x)]
    [IsNoetherianRing (TypeDensity.BlowupChart R x t)] (D : TypeDensity.TwoChartCurveData R t x beta) (d : ℕ)
    (G : TypeDensity.GluedGenerators R t x beta d)
    (hregF : ∀ j : ℕ, Function.Injective
      (fun c : TypeDensity.BlowupOverlap R t x ⧸ (Ideal.span {TypeDensity.overlapException R t x})^j =>
        Ideal.Quotient.mk ((Ideal.span {TypeDensity.overlapException R t x})^j)
          ((algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) (G.left j)) * c))
    (f : R)
    (hf : ∀ j : ℕ, TypeDensity.surfaceToCechInput R t x j f =
      (TypeDensity.cechInputLattice R t x j).mkQ (TypeDensity.gluedFunctionPair R t x G j))
    (hclosed : (⨅ j : ℕ, (Ideal.span {f} ⊔ (Ideal.span {t,x})^j)) = Ideal.span {f})
    [∀ p : TypeDensity.AllPoints D, IsLocalRing (TypeDensity.localRing D p)]
    [∀ p : TypeDensity.AllPoints D, IsNoetherianRing (TypeDensity.localRing D p)]
    [∀ p : TypeDensity.AllPoints D, IsAdicComplete (IsLocalRing.maximalIdeal (TypeDensity.localRing D p)) (TypeDensity.localRing D p)]
    [∀ p : TypeDensity.AllPoints D, Algebra O (TypeDensity.localRing D p)]
    (E : TypeDensity.CurveOrderLimit R t x beta G ≃ₗ[O] TypeDensity.childOrder D) (σ : R →ₗ[R] TypeDensity.CurveOrderLimit R t x beta G)
    (hσ : ∀ r : R, ∃ p : TypeDensity.curveThreads R t x beta G, σ r = TypeDensity.curveLimitMk R t x beta G p ∧ ∀ j : ℕ,
      p.val j = TypeDensity.surfaceToChartPair R t x r)
    (hE : ∀ (p : TypeDensity.curveThreads R t x beta G) (r : R),
      (∀ j : ℕ, p.val j = TypeDensity.surfaceToChartPair R t x r) → E (TypeDensity.curveLimitMk R t x beta G p) =
      TypeDensity.childOrderMap D r)
    (φ : R →ₗ[O] TypeDensity.childOrder D) (hφ : ∀ r : R, φ r = TypeDensity.childOrderMap D r) :
    RingHom.ker (TypeDensity.childOrderMap D) = Ideal.span {f} ∧
      Module.length O ((TypeDensity.childOrder D) ⧸ LinearMap.range φ) = (TypeDensity.chooseTwo d : ℕ∞) := by
  have key : ∀ r : R, TypeDensity.childOrderMap D r = E (σ r) := fun r ↦ by
    obtain ⟨p, hp1, hp2⟩ := hσ r
    rw [hp1, hE p r hp2]
  have hker := TypeDensity.surface_to_curve_limit_kernel R t x beta d G hreg hregSwap hregF f hf hclosed σ hσ
  refine ⟨Ideal.ext fun r ↦ ?_, ?_⟩
