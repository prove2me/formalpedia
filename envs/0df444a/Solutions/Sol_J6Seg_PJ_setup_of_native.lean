/-!
# Relocating register programs

For a permutation `σ` of the `HS` stacks fixing every stack `≥ 55` (the multiplication argument
`55` and the expression scratch `56..63`), `Ex.ren σ`, `RS.ren σ`, `RM.ren σ` rename every register
`i` to `σ i`.  On the relocated state `IState.rn σ s` (stack `σ i` holds the old stack `i`) the
renamed program computes the relocated result, with the same side conditions and the same cost.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

/-! ## Relocated states -/

variable (σ : Equiv.Perm (Fin HS))

namespace IState

@[simp] theorem rn_G (s : IState HS) (i : Fin HS) : (s.rn σ).G (σ i) = s.G i := by
  simp [rn]

theorem rn_upd (s : IState HS) (i : Fin HS) (L : List Item) :
    (s.upd i L).rn σ = (s.rn σ).upd (σ i) L := by
  refine IState.ext' (fun y => ?_) rfl rfl
  simp only [rn_G', upd_G, Equiv.symm_apply_eq]

@[simp] theorem rn_top (s : IState HS) (i : Fin HS) : (s.rn σ).top (σ i) = s.top i := by
  simp [IState.top]

@[simp] theorem rn_isInt (s : IState HS) (i : Fin HS) : (s.rn σ).IsInt (σ i) ↔ s.IsInt i := by
  simp [IState.IsInt]

@[simp] theorem rn_rn (τ : Equiv.Perm (Fin HS)) (s : IState HS) :
    (s.rn τ).rn σ = s.rn (τ.trans σ) := by
  refine IState.ext' (fun y => ?_) rfl rfl
  simp [rn_G', Equiv.symm_trans_apply]

/-- Every state is a relocated state. -/
theorem rn_rn_inv (t : IState HS) : (t.rn σ⁻¹).rn σ = t := by
  refine IState.ext' (fun y => ?_) rfl rfl
  simp [rn_G', Equiv.Perm.inv_def]

end IState

/-! ## Permutations fixing the reserved stacks -/

variable {σ}

theorem FixHi.ge_iff (hσ : FixHi σ) (m : ℕ) (hm : 55 ≤ m) (i : Fin HS) :
    m ≤ (σ i).val ↔ m ≤ i.val := by
  constructor
  · intro h
    have h1 : σ (σ i) = σ i := hσ _ (by omega)
    have := σ.injective h1
    rw [this] at h; exact h
  · intro h; rw [hσ i (by omega)]; exact h

theorem FixHi.lt_iff (hσ : FixHi σ) (m : ℕ) (hm : 55 ≤ m) (i : Fin HS) :
    (σ i).val < m ↔ i.val < m := by
  have := hσ.ge_iff m hm i; omega

theorem FixHi.lt56 (hσ : FixHi σ) (i : Fin HS) : (σ i).val < 56 ↔ i.val < 56 := hσ.lt_iff 56 (by omega) i

theorem FixHi.mem_zX (hσ : FixHi σ) (i : Fin HS) : σ i ∈ zX.all ↔ i ∈ zX.all := by
  have key : ∀ j : Fin HS, j ∈ zX.all ↔ 56 ≤ j.val := by
    rw [zX_all]; decide
  rw [key, key]; exact hσ.ge_iff 56 (by omega) i

/-! ## Expressions -/

namespace Ex

variable (σ)

@[simp] theorem regs_ren : ∀ e : Ex HS, (e.ren σ).regs = e.regs.map σ
  | reg _ | lit _ => rfl
  | add a b | mul a b | shl a b | quo a b | rem a b | ndiv a b | nmod a b => by
    simp [ren, regs, regs_ren a, regs_ren b]
  | neg a | pow2 a => by simp [ren, regs, regs_ren a]
  | sel c x y => by simp [ren, regs, regs_ren c, regs_ren x, regs_ren y]

@[simp] theorem eval_ren (s : IState HS) : ∀ e : Ex HS, (e.ren σ).eval (s.rn σ) = e.eval s
  | reg _ => by simp [ren, eval]
  | lit _ => rfl
  | add a b | mul a b | shl a b | quo a b | rem a b | ndiv a b | nmod a b => by
    simp [ren, eval, eval_ren s a, eval_ren s b]
  | neg a | pow2 a => by simp [ren, eval, eval_ren s a]
  | sel c x y => by simp [ren, eval, eval_ren s c, eval_ren s x, eval_ren s y]

@[simp] theorem ok_ren (s : IState HS) : ∀ e : Ex HS, (e.ren σ).ok (s.rn σ) ↔ e.ok s
  | reg _ => by simp [ren, ok]
  | lit _ => Iff.rfl
  | add a b | mul a b | shl a b | quo a b | rem a b | ndiv a b | nmod a b => by
    simp [ren, ok, ok_ren s a, ok_ren s b]
  | neg a | pow2 a => by simp [ren, ok, ok_ren s a]
  | sel c x y => by simp [ren, ok, ok_ren s c, ok_ren s x, ok_ren s y]

@[simp] theorem cost_ren (s : IState HS) : ∀ e : Ex HS, (e.ren σ).cost (s.rn σ) = e.cost s
  | reg _ => by simp [ren, cost]
  | lit _ => rfl
  | add a b | mul a b | shl a b | quo a b | rem a b | ndiv a b | nmod a b => by
    simp [ren, cost, cost_ren s a, cost_ren s b]
  | neg a | pow2 a => by simp [ren, cost, cost_ren s a]
  | sel c x y => by simp [ren, cost, cost_ren s c, cost_ren s x, cost_ren s y]

variable {σ}

theorem Clean_ren (hσ : FixHi σ) (e : Ex HS) : (e.ren σ).Clean ↔ e.Clean := by
  simp only [Clean, regs_ren, List.mem_map, forall_exists_index, and_imp,
    forall_apply_eq_imp_iff₂, hσ.mem_zX]

end Ex

/-! ## Register programs -/

namespace RS

variable (σ)

@[simp] theorem writes_ren : ∀ p : RS, (p.ren σ).writes = p.writes.map σ
  | skip => rfl
  | asg _ _ | push _ _ | pop _ => rfl
  | seq a b | ite _ a b => by simp [ren, writes, writes_ren a, writes_ren b]
  | rep i n b => by simp [ren, writes, writes_ren b]

theorem decSt_rn (i : Fin HS) (t : IState HS) : decSt (σ i) (t.rn σ) = (decSt i t).rn σ := by
  simp [decSt, IState.rn_upd]

theorem decE_ren (i : Fin HS) : decE (σ i) = (decE i).ren σ := rfl

theorem asgCost_ren (i : Fin HS) (e : Ex HS) (s : IState HS) :
    asgCost (σ i) (e.ren σ) (s.rn σ) = asgCost i e s := by
  simp [asgCost]

/-- Iterating a map that commutes with relocation. -/
theorem iterate_rn {F F' : IState HS → IState HS} (h : ∀ t, F' (t.rn σ) = (F t).rn σ) (k : ℕ)
    (t : IState HS) : F'^[k] (t.rn σ) = (F^[k] t).rn σ := by
  induction k generalizing t with
  | zero => rfl
  | succ k ih => rw [Function.iterate_succ_apply, Function.iterate_succ_apply, ← ih, h]

@[simp] theorem run_ren : ∀ (p : RS) (s : IState HS), (p.ren σ).run (s.rn σ) = (p.run s).rn σ
  | skip, _ => rfl
  | asg i e, s => by simp [ren, run, IState.rn_upd]
  | push i e, s => by simp [ren, run, IState.rn_upd]
  | pop i, s => by simp [ren, run, IState.rn_upd]
  | seq a b, s => by simp [ren, run, run_ren a, run_ren b]
  | ite c a b, s => by
    simp only [ren, run, Ex.eval_ren]; split_ifs
    · exact run_ren a s
    · exact run_ren b s
  | rep i n b, s => by
    simp only [ren, run, Ex.eval_ren]
    rw [← IState.rn_G σ s i, ← IState.rn_upd,
      iterate_rn σ (F := fun t => decSt i (b.run t)) (fun t => by
        simp only [run_ren b, decSt_rn])]
    simp only [IState.rn_G, IState.rn_upd]

theorem repSt_ren (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (k : ℕ) :
    repSt (σ i) (n.ren σ) (b.ren σ) (s.rn σ) k = (repSt i n b s k).rn σ := by
  simp only [repSt, Ex.eval_ren]
  rw [← IState.rn_G σ s i, ← IState.rn_upd]
  exact iterate_rn σ (fun t => by simp only [run_ren, decSt_rn]) k _

@[simp] theorem cost_ren : ∀ (p : RS) (s : IState HS), (p.ren σ).cost (s.rn σ) = p.cost s
  | skip, _ => rfl
  | asg i e, s => by simp [ren, cost, asgCost_ren]
  | push i e, s => by simp [ren, cost]
  | pop i, s => by simp [ren, cost]
  | seq a b, s => by simp [ren, cost, cost_ren a, cost_ren b]
  | ite c a b, s => by
    simp only [ren, cost, Ex.eval_ren, Ex.cost_ren]; split_ifs
    · rw [cost_ren a s]
    · rw [cost_ren b s]
  | rep i n b, s => by
    simp only [ren, cost, Ex.eval_ren, Ex.cost_ren, repSt_ren, cost_ren b, run_ren, decE_ren,
      asgCost_ren]

variable {σ}

theorem ok_ren (hσ : FixHi σ) : ∀ (p : RS) (s : IState HS), (p.ren σ).ok (s.rn σ) ↔ p.ok s
  | skip, _ => Iff.rfl
  | asg i e, s => by simp [ren, ok, hσ.lt56, Ex.Clean_ren hσ]
  | push i e, s => by simp [ren, ok, hσ.lt56, Ex.Clean_ren hσ]
  | pop i, s => by simp [ren, ok, hσ.lt56]
  | seq a b, s => by simp [ren, ok, ok_ren hσ a, ok_ren hσ b]
  | ite c a b, s => by
    simp only [ren, ok, Ex.eval_ren, Ex.ok_ren, Ex.Clean_ren hσ]; split_ifs
    · rw [ok_ren hσ a s]
    · rw [ok_ren hσ b s]
  | rep i n b, s => by
    simp only [ren, ok, Ex.eval_ren, Ex.ok_ren, Ex.Clean_ren hσ, hσ.lt56, writes_ren,
      List.mem_map, σ.injective.eq_iff, exists_eq_right, repSt_ren, ok_ren hσ b]

end RS

