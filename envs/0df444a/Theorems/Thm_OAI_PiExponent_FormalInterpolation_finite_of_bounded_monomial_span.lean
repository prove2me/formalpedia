-- title:
--   A bounded monomial spanning set gives module finiteness
-- statement:
--   If every monomial lies in the span over the algebra generated by p of monomials with each coordinate exponent bounded by n, then the polynomial ring is a finite module over that algebra.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Real.Basic
import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.finite_of_bounded_monomial_span {d : Nat} (m : Nat) (p : Fin m → MvPolynomial (Fin d) ℂ) (n : Fin d → Nat) (hspan : ∀ e : Fin d →₀ Nat, MvPolynomial.monomial e (1 : ℂ) ∈ Submodule.span (Algebra.adjoin ℂ (Set.range p)) {f : MvPolynomial (Fin d) ℂ | ∃ a : Fin d →₀ Nat, (∀ i, a i < n i) ∧ f = MvPolynomial.monomial a (1 : ℂ)}) : Module.Finite (Algebra.adjoin ℂ (Set.range p)) (MvPolynomial (Fin d) ℂ) := by sorry
