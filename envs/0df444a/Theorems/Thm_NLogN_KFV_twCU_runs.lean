theorem NLogN.KFV.twCU_runs (N r w : ℕ) (hr : 0 < r) (sv : ℕ → ℕ) (hsv : ∀ p, sv p ≤ 2 * r)
    (zs : List GI) (hzs : zs.length = N * r) (hb : NLogN.KFB.GB w zs) (t : IState HS) (R L14 : List Item)
    (h0 : t.G 0 = ints (gflat zs) ++ R)
    (h14 : t.G 14 = ints ((List.range N).map fun p => (sv p : ℤ)) ++ L14)
    {L1 L2 L3 : List Item} (h1 : t.G NLogN.KFUU.qX = .int (N : ℤ) :: L1)
    (h2 : t.G NLogN.KFUU.qB = .int ((2 * r : ℕ) : ℤ) :: L2) (h3 : t.G NLogN.KFUU.qZ = .int ((2 * r : ℕ) : ℤ) :: L3) :
    IRuns I iprog twCU t ((t.upd 0 (ints (gflat (twZ r N sv zs)) ++ R)).upd 14 L14)
      (2000 * cTw N r w) := by sorry
