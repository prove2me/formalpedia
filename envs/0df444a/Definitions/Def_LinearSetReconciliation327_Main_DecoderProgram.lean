section ReadStmt

/-- The test of the read loop: `j < t`.  An `abbrev`, so that `Cond.code.length` really is `1`. -/
abbrev readCond : Cond := Cond.lt r14 r5 r0

/-- The read loop as a statement: while `j < t`, read coordinate `j`. -/
abbrev readLoopStmt : Stmt := Stmt.loop readCond (Stmt.code readBody)

/-- The state at the entry of the loop body: the test has run, so `r14 = 1` and `pc = base + 2`. -/
noncomputable def readBodyIn (base S0 w t : ℕ) (y : Fin (t * w) → ZMod 2) (k : ℕ) : RAMState where
  pc := base + 2
  regs := Function.update (readState base S0 w t y k).regs r14 1
  mem := readMem S0 w y k

end ReadStmt

