-- title:
--   Theorem 3.7, p. 270 — projected gradient descent with η = 1/β on a convex β-smooth f satisfies f(x_t) − f(x*) ≤ (3β‖x₁ − x*‖² + f(x₁) − f(x*))/t
-- statement:
--   Let $\mathcal X\subseteq\mathbb R^n$ be compact and convex, and let $f:\mathbb R^n\to\mathbb R$ be convex on $\mathcal X$ and $\beta$-smooth on $\mathcal X$ (its gradient is $\beta$-Lipschitz on $\mathcal X$), with $\beta>0$. Let $x^*\in\mathcal X$ minimize $f$ over $\mathcal X$. Let $(x_t)_{t\ge1}$ be generated by projected gradient descent with step size $\eta=1/\beta$:
--   $$x_1\in\mathcal X,\qquad x_{t+1}=\Pi_{\mathcal X}\Bigl(x_t-\tfrac1\beta\nabla f(x_t)\Bigr)\quad(t\ge1),$$
--   where $\Pi_{\mathcal X}$ is the Euclidean projection onto $\mathcal X$. Then for every $t\ge1$,
--   $$f(x_t)-f(x^*)\le\frac{3\beta\|x_1-x^*\|^2+f(x_1)-f(x^*)}{t} .$$
--
--   Projected gradient descent thus attains the same $O(\beta\|x_1-x^*\|^2/t)$ rate in the constrained case as gradient descent does without constraints (Theorem 3.3), at the price of a slightly larger constant.
--
--   **Formalization Note** $\beta$-smoothness on $\mathcal X$ is `IsBetaSmoothOn X f g β`: `g x` is the gradient of $f$ at every point of $\mathbb R^n$ and $\|g(x)-g(y)\|\le\beta\|x-y\|$ for $x,y\in\mathcal X$. The run is `IsProjGDRun X g β x`, with the step size fixed to $1/\beta$ and the projection given by the relation `IsMetricProjection`. Compactness and convexity of $\mathcal X$ are the standing assumption of Chapter 3 (p. 262); the existence of a minimizer $x^*$ is the book's standing assumption (p. 242); $\beta>0$ is implicit in the step $1/\beta$; $t\ge1$ because the iterates start at $x_1$.
-- source:
--   Bubeck, arXiv:1405.4980v2, Theorem 3.7, p. 270

import Mathlib
import Definitions.Def_OnlineConvexOpt_FirstOrder_Protocol
import Definitions.Def_ConvexOptAlg_ProjectedGD_Defs

open scoped InnerProductSpace
open OnlineConvexOpt.FirstOrder

namespace ConvexOptAlg.ProjectedGD

/-- Theorem 3.7 (Bubeck, arXiv:1405.4980v2, p. 270): let `X ⊆ ℝⁿ` be compact and convex, `f`
convex and `β`-smooth on `X` with gradient map `g` and `β > 0`, and `x*` a minimizer of `f` on
`X`. Then every run `(x_t)_{t ≥ 1}` of projected gradient descent with `η = 1/β` satisfies,
for every `t ≥ 1`, `f(x_t) − f(x*) ≤ (3β‖x₁ − x*‖² + f(x₁) − f(x*))/t`. -/
theorem theorem_3_7 {n : ℕ} (X : Set (EuclideanSpace ℝ (Fin n)))
    (hXc : IsCompact X) (hXcv : Convex ℝ X)
    (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)) (β : ℝ) (hβ : 0 < β)
    (hf : ConvexOn ℝ X f) (hsmooth : IsBetaSmoothOn X f g β)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hrun : IsProjGDRun X g β x)
    (xstar : EuclideanSpace ℝ (Fin n)) (hxstar : xstar ∈ X) (hmin : ∀ y ∈ X, f xstar ≤ f y)
    (t : ℕ) (ht : 1 ≤ t) :
    f (x t) - f xstar ≤ (3 * β * ‖x 1 - xstar‖ ^ 2 + f (x 1) - f xstar) / t := by sorry

end ConvexOptAlg.ProjectedGD
