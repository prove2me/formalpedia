      E5 ℂ 0 + (PowerSeries.C ζ : ℂ⟦X⟧) ^ (j : ℕ) * E5 ℂ 1 +
        (PowerSeries.C ζ : ℂ⟦X⟧) ^ (2 * (j : ℕ)) * E5 ℂ 2 := by
