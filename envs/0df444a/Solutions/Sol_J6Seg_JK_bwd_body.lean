set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

theorem flatB_drop (k : ℕ) {bs : List (List ℤ × List ℤ × ℤ × ℤ)} {j : ℕ} (h : j < bs.length) :
    flatB k (bs.drop j) = (bs[j].1.length : ℤ) :: (bs[j].1 ++ ((bs[j].2.1.length : ℤ) ::
      (bs[j].2.1 ++ (bs[j].2.2.1 :: ivOf k bs[j].2.2.1 :: bs[j].2.2.2 ::
        flatB k (bs.drop (j + 1)))))) := by
  simp only [flatB]; rw [List.drop_eq_getElem_cons h, List.flatMap_cons]
  simp only [recT, rowT, List.cons_append, List.append_assoc, List.singleton_append]
  try rfl

theorem flatB_take (k : ℕ) {bs : List (List ℤ × List ℤ × ℤ × ℤ)} {j : ℕ} (h : j < bs.length) :
    (flatB k (bs.take (j + 1))).reverse = bs[j].2.2.2 :: ivOf k bs[j].2.2.1 :: bs[j].2.2.1 ::
      (bs[j].2.1.reverse ++ ((bs[j].2.1.length : ℤ) :: (bs[j].1.reverse ++
        ((bs[j].1.length : ℤ) :: (flatB k (bs.take j)).reverse)))) := by
  have e : bs.take (j + 1) = bs.take j ++ [bs[j]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem h]; rfl
  rw [e]
  simp only [flatB, List.flatMap_append, List.flatMap_cons, List.flatMap_nil, List.append_nil,
    List.reverse_append, recT, rowT, List.reverse_cons]
  simp [List.append_assoc]

theorem bwdS_length2 (P : ℕ) (bs : List (List ℤ × List ℤ × ℤ × ℤ)) (bts : List ℤ) {j : ℕ}
    (hb : j ≤ bs.length) (ht : j ≤ bts.length) : (bwdS P bs bts j).2.length ≤ j := by
  induction j with
  | zero => simp [bwdS_zero]
  | succ j ih =>
    rw [bwdS_succ P bs bts (by omega) (by omega)]
    have := ih (by omega) (by omega)
    simp only [stepB]; split_ifs <;> simp <;> omega

theorem XOK_Z : XOK Z := ⟨by decide, by decide, by decide, by decide, by decide, by decide,
  by decide, by decide, by decide, by decide, by decide⟩

theorem XOK_BZ : XOK BZ := ⟨by decide, by decide, by decide, by decide, by decide, by decide,
  by decide, by decide, by decide, by decide, by decide⟩

section bwd
variable (P k : ℕ) (F : Fin HS → List ℤ) (bs : List (List ℤ × List ℤ × ℤ × ℤ)) (bts R T0 : List ℤ)

variable {P k F bs bts R T0}

theorem bnd_mono {B B' : ℕ} {l : List ℤ} (h : Bnd B l) (hB : B ≤ B') : Bnd B' l :=
  fun a ha => le_trans (h a ha) hB

theorem fdiv_zero (P : ℕ) (a : ℤ) : J6Seg.fdiv P a 0 = 0 := by
  simp [J6Seg.fdiv, J6Seg.rq]

set_option maxHeartbeats 1000000 in
theorem bwd_body_sol_aux {M : MulSpec} {Xb Φm Bx Bc : ℕ} (hMB : MulBnd M (k + 2) Φm) (s : IState HS)
    {lp lp1 lk : List ℤ} (hF : BwdF P k F lp lp1 lk) (hD : BwdD P bs bts Xb Bc)
    (hk : 2 * Xb + 2 * P + Bc + 6 ≤ k) (hBx : 2 * k + 8 ≤ Bx) (N j : ℕ) (hj : j < bs.length) :
    MSp M bwdB (encK s (update (bSt P k F bs bts R T0 j) CR [(N : ℤ) - j]))
      (encK s (update (bSt P k F bs bts R T0 (j + 1)) CR [(N : ℤ) - j]))
      ((bs[j].1.length + bs[j].2.1.length + 5) * uC Φm Bx Bc) := by
  obtain ⟨hcnt, hsum, hpx, hcd, htmp, hcr, hnum, hpv, hiv, hfl, hnn, hqq, hdd, hq0, hrp, hrp1,
    hrk⟩ := hF
  have hjt : j < bts.length := by rw [← hD.len]; exact hj
  set cb := bs[j].1 with hcb
  set cz := bs[j].2.1 with hcz
  set pv := bs[j].2.2.1 with hpvd
  set fl := bs[j].2.2.2 with hfld
  set st := bwdS P bs bts j with hst
  set bt := bts[j] with hbt
  have hstl : st.1.length = j := bwdS_length P bs bts hj.le hjt.le
  have hst2 : st.2.length ≤ j := bwdS_length2 P bs bts hj.le hjt.le
  have hcbl : cb.length ≤ j := hD.wb j hj
  have hczl : cz.length ≤ st.2.length := hD.wz j hj
  have hBc : j < 2 ^ Bc := lt_trans hj hD.mB
  have hXk : Xb + 2 ≤ k := by omega
  have hPB : P + 3 ≤ Bx := by omega
  have hcBx : Bc ≤ Bx := by omega
  have zcb : zsz (cb.length : ℤ) ≤ Bc := by apply zsz_le_of_lt; simp; omega
  have zcz : zsz (cz.length : ℤ) ≤ Bc := by apply zsz_le_of_lt; simp; omega
  have hcbB : Bnd Xb cb := hD.bcb j hj
  have hczB : Bnd Xb cz := hD.bcz j hj
  have hpvB : zsz pv ≤ Xb := hD.bpv j hj
  have hst1B : Bnd Xb st.1 := hD.bz j hj.le
  have hst2B : Bnd Xb st.2 := hD.bb j hj.le
  have hfl01 : fl = 0 ∨ fl = 1 := hD.fl01 j hj
  have hbtB : zsz bt ≤ Xb := hD.bbt _ (List.getElem_mem hjt)
  set W := 2 * Xb + P + Bc + 2 with hW
  have eW : 2 ^ (2 * Xb + P + Bc + 2) = 2 ^ W := by rw [hW]
  have hd1 : (dotF P cb st.1).natAbs < 2 ^ W := by
    have := dotF_take_zsz P Xb Bc hcbB hst1B (by omega) cb.length
    rwa [List.take_length] at this
  have hd2 : (dotF P cz st.2).natAbs < 2 ^ W := by
    have := dotF_take_zsz P Xb Bc hczB hst2B (by omega) cz.length
    rwa [List.take_length] at this
  have hWB : 2 ^ (W + 2) ≤ 2 ^ Bx := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hWW : 2 ^ W ≤ 2 ^ (W + 2) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hWk : 2 ^ (W + P + 4) ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) (by omega)
  set G0 := update (bSt P k F bs bts R T0 j) CR [(N : ℤ) - j] with hG0
  have hrest := flatB_drop k hj
  -- the band count
  have g0T : G0 dTJ = (cb.length : ℤ) :: (cb ++ ((cz.length : ℤ) :: (cz ++ (pv :: ivOf k pv ::
      fl :: (flatB k (bs.drop (j + 1)) ++ R))))) := by
    simp +decide [hG0, bSt, update_apply, hrest, hcb, hcz, hpvd, hfld]
  have s1 := rdT_spec (s := s) (X := CNT) (by decide) (by decide) (by decide) g0T
    (B := Bx) (by omega)
  set G1 := update (update (update G0 CNT ((cb.length : ℤ) :: G0 CNT)) TT
    ((cb.length : ℤ) :: G0 TT)) dTJ (cb ++ ((cz.length : ℤ) :: (cz ++ (pv :: ivOf k pv ::
      fl :: (flatB k (bs.drop (j + 1)) ++ R))))) with hG1
  have s2 := Sp.push (s := s) (f := G1) (i := SUM) (e := .lit 0) (B := Bx) (by decide)
    (by intro i hi; simp [Ex.regs] at hi) trivial trivial (by simp [Ex.Bnd, zsz_zero])
  simp only [Ex.eval] at s2
  set G2 := update G1 SUM (0 :: G1 SUM) with hG2
  -- the band dot product
  have hSk1 : ∀ i ≤ cb.length, zsz (0 + dotF P (cb.take i) st.1) ≤ Bx := by
    intro i _
    have := dotF_take_zsz P Xb Bc hcbB hst1B (by omega) i
    rw [zero_add]; exact zsz_le_of_lt (by omega)
  have s3 := dotP_spec (P := P) (F := G2) (X := Z) (cs := cb) (acc := st.1)
    (R := (cz.length : ℤ) :: (cz ++ (pv :: ivOf k pv :: fl :: (flatB k (bs.drop (j + 1)) ++ R))))
    (T0 := G2 TT) (S0 := 0) (Ls := []) (Lc := G0 CNT) (Bc := Bc)
    (hMB.mono le_rfl le_rfl) XOK_Z s (lp := lp) (lp1 := lp1)
    (by simp +decide [hG2, hG1, hG0, bSt, update_apply, hpx])
    (by simp +decide [hG2, hG1, hG0, bSt, update_apply, hrp])
    (by simp +decide [hG2, hG1, hG0, bSt, update_apply, hrp1])
    (by simp +decide [hG2, hG1, hG0, bSt, update_apply, hcd])
    (by simp +decide [hG2, hG1, hG0, bSt, update_apply, htmp])
    (by simp +decide [hG2, hG1]) rfl
    (by simp +decide [hG2, hG1, hG0, bSt, update_apply, hst])
    (by simp +decide [hG2, hG1, hG0, bSt, update_apply, hsum])
    (by simp +decide [hG2, hG1])
    (by omega) (bnd_mono hcbB (by omega)) (bnd_mono hst1B (by omega)) (by omega) hPB
    zcb (by omega) hSk1
  set G3 := update (update (update G2 dTJ ((cz.length : ℤ) :: (cz ++ (pv :: ivOf k pv :: fl ::
    (flatB k (bs.drop (j + 1)) ++ R))))) TT (cb.reverse ++ G2 TT)) SUM
      ((0 + dotF P cb st.1) :: []) with hG3
  have g3C : G3 CNT = [(cb.length : ℤ)] := by
    simp +decide [hG3, hG2, hG1, hG0, bSt, update_apply, hcnt]
  have s4 := Sp.pop (s := s) (f := G3) (i := CNT) (B := Bx) (by decide) g3C (by omega)
  set G4 := update G3 CNT [] with hG4
  have g4T : G4 dTJ = (cz.length : ℤ) :: (cz ++ (pv :: ivOf k pv :: fl ::
      (flatB k (bs.drop (j + 1)) ++ R))) := by simp +decide [hG4, hG3]
  have s5 := rdT_spec (s := s) (X := CNT) (by decide) (by decide) (by decide) g4T
    (B := Bx) (by omega)
  set G5 := update (update (update G4 CNT ((cz.length : ℤ) :: G4 CNT)) TT
    ((cz.length : ℤ) :: G4 TT)) dTJ (cz ++ (pv :: ivOf k pv :: fl ::
      (flatB k (bs.drop (j + 1)) ++ R))) with hG5
  -- the border dot product
  have hSk2 : ∀ i ≤ cz.length, zsz (0 + dotF P cb st.1 + dotF P (cz.take i) st.2) ≤ Bx := by
    intro i _
    have := dotF_take_zsz P Xb Bc hczB hst2B (by omega) i
    have h3 := Int.natAbs_add_le (0 + dotF P cb st.1) (dotF P (cz.take i) st.2)
    rw [zero_add] at h3 ⊢
    have : 2 ^ (W + 2) = 4 * 2 ^ W := by rw [pow_add]; ring
    exact zsz_le_of_lt (by omega)
  have s6 := dotP_spec (P := P) (F := G5) (X := BZ) (cs := cz) (acc := st.2)
    (R := pv :: ivOf k pv :: fl :: (flatB k (bs.drop (j + 1)) ++ R))
    (T0 := G5 TT) (S0 := 0 + dotF P cb st.1) (Ls := []) (Lc := G4 CNT) (Bc := Bc)
    (hMB.mono le_rfl le_rfl) XOK_BZ s (lp := lp) (lp1 := lp1)
    (by simp +decide [hG5, hG4, hG3, hG2, hG1, hG0, bSt, update_apply, hpx])
    (by simp +decide [hG5, hG4, hG3, hG2, hG1, hG0, bSt, update_apply, hrp])
    (by simp +decide [hG5, hG4, hG3, hG2, hG1, hG0, bSt, update_apply, hrp1])
    (by simp +decide [hG5, hG4, hG3, hG2, hG1, hG0, bSt, update_apply, hcd])
    (by simp +decide [hG5, hG4, hG3, hG2, hG1, hG0, bSt, update_apply, htmp])
    (by simp +decide [hG5]) rfl
    (by simp +decide [hG5, hG4, hG3, hG2, hG1, hG0, bSt, update_apply, hst])
    (by simp +decide [hG5, hG4, hG3])
    (by simp +decide [hG5])
    (by omega) (bnd_mono hczB (by omega)) (bnd_mono hst2B (by omega)) (by omega) hPB
    zcz (by omega) hSk2
  set G6 := update (update (update G5 dTJ (pv :: ivOf k pv :: fl ::
    (flatB k (bs.drop (j + 1)) ++ R))) TT (cz.reverse ++ G5 TT)) SUM
      ((0 + dotF P cb st.1 + dotF P cz st.2) :: []) with hG6
  have g6C : G6 CNT = [(cz.length : ℤ)] := by simp +decide [hG6, hG5, hG4]
  have s7 := Sp.pop (s := s) (f := G6) (i := CNT) (B := Bx) (by decide) g6C (by omega)
  set G7 := update G6 CNT [] with hG7
  -- the numerator
  set num := bt - dotF P cb st.1 - dotF P cz st.2 with hnumd
  have hnumB : num.natAbs < 2 ^ (W + 2) := num_natAbs_lt W Xb hbtB (by omega) hd1 hd2
  have g7A : G7 A = bt :: bts.drop (j + 1) := by
    simp +decide [hG7, hG6, hG5, hG4, hG3, hG2, hG1, hG0, bSt, update_apply]
    try exact List.drop_eq_getElem_cons hjt
  have g7S : G7 SUM = [0 + dotF P cb st.1 + dotF P cz st.2] := by simp +decide [hG7, hG6]
  have hS2 : zsz (0 + dotF P cb st.1 + dotF P cz st.2) ≤ Bx := by
    have := hSk2 cz.length le_rfl; rwa [List.take_length] at this
  have ev8 : (Ex.add (.reg A) (.neg (.reg SUM))).eval (encK s G7) = num := by
    simp only [Ex.eval, top_encK g7A, top_encK g7S, hnumd]; ring
  have s8 := Sp.push (s := s) (f := G7) (i := NUM) (e := .add (.reg A) (.neg (.reg SUM)))
    (B := Bx) (by decide) (clean_of_regs (by decide)) ⟨isInt_encK g7A, isInt_encK g7S⟩
    ⟨trivial, trivial⟩ (by
      refine ⟨by simp only [Ex.Bnd, top_encK g7A]; omega, by
        simp only [Ex.Bnd, top_encK g7S]; exact hS2, ?_⟩
      rw [show Ex.eval (encK s G7) (Ex.reg A) + Ex.eval (encK s G7) (Ex.reg SUM).neg = num from ev8]
      exact zsz_le_of_lt (lt_of_lt_of_le hnumB hWB))
  rw [ev8] at s8
  set G8 := update G7 NUM (num :: G7 NUM) with hG8
  have g8S : G8 SUM = [0 + dotF P cb st.1 + dotF P cz st.2] := by simp +decide [hG8, g7S]
  have s9 := Sp.pop (s := s) (f := G8) (i := SUM) (B := Bx) (by decide) g8S hS2
  set G9 := update G8 SUM [] with hG9
  -- the record tail
  have hpv0 : 0 ≤ pv := hD.pv0 j hj
  have hivB : zsz (ivOf k pv) ≤ k + 1 := by
    rcases lt_or_eq_of_le hpv0 with h | h
    · apply zsz_le_of_lt
      have h0 := ivOf_nonneg k h; have h1 := ivOf_le k h
      have hn : (ivOf k pv).natAbs ≤ 2 ^ k := by
        have e := Int.natAbs_of_nonneg h0
        have : ((ivOf k pv).natAbs : ℤ) ≤ ((2 ^ k : ℕ) : ℤ) := by rw [e]; push_cast; exact h1
        exact_mod_cast this
      exact lt_of_le_of_lt hn (Nat.pow_lt_pow_right (by norm_num) (by omega))
    · rw [← h]; simp [ivOf, zsz_zero]
  have hflB : zsz fl ≤ 1 := by
    rcases hfl01 with h | h <;> rw [h]
    · rw [zsz_zero]; omega
    · rw [zsz_one]
  have g9T : G9 dTJ = pv :: ivOf k pv :: fl :: (flatB k (bs.drop (j + 1)) ++ R) := by
    simp +decide [hG9, hG8, hG7, hG6]
  have s10 := rdT_spec (s := s) (X := PV) (by decide) (by decide) (by decide) g9T
    (B := Bx) (by omega)
  set G10 := update (update (update G9 PV (pv :: G9 PV)) TT (pv :: G9 TT)) dTJ
    (ivOf k pv :: fl :: (flatB k (bs.drop (j + 1)) ++ R)) with hG10
  have g10T : G10 dTJ = ivOf k pv :: fl :: (flatB k (bs.drop (j + 1)) ++ R) := by simp [hG10]
  have s11 := rdT_spec (s := s) (X := IV) (by decide) (by decide) (by decide) g10T
    (B := Bx) (by omega)
  set G11 := update (update (update G10 IV (ivOf k pv :: G10 IV)) TT (ivOf k pv :: G10 TT)) dTJ
    (fl :: (flatB k (bs.drop (j + 1)) ++ R)) with hG11
  have g11T : G11 dTJ = fl :: (flatB k (bs.drop (j + 1)) ++ R) := by simp [hG11]
  have s12 := rdT_spec (s := s) (X := FL) (by decide) (by decide) (by decide) g11T
    (B := Bx) (by omega)
  set G12 := update (update (update G11 FL (fl :: G11 FL)) TT (fl :: G11 TT)) dTJ
    (flatB k (bs.drop (j + 1)) ++ R) with hG12
  -- the quotient
  set z := J6Seg.fdiv P num pv with hzd
  have hstep : bwdS P bs bts (j + 1) = (z :: st.1, if fl = 1 then z :: st.2 else st.2) := by
    rw [bwdS_succ P bs bts hj hjt]; rfl
  have hzX : zsz z ≤ Xb := hD.bz (j + 1) hj _ (by rw [hstep]; simp)
  have g12NUM : G12 NUM = [num] := by
    simp +decide [hG12, hG11, hG10, hG9, hG8, hG7, hG6, hG5, hG4, hG3, hG2, hG1, hG0, bSt,
      update_apply, hnum]
  have g12PV : G12 PV = [pv] := by
    simp +decide [hG12, hG11, hG10, hG9, hG8, hG7, hG6, hG5, hG4, hG3, hG2, hG1, hG0, bSt,
      update_apply, hpv]
  have g12IV : G12 IV = [ivOf k pv] := by
    simp +decide [hG12, hG11, hG10, hG9, hG8, hG7, hG6, hG5, hG4, hG3, hG2, hG1, hG0, bSt,
      update_apply, hiv]
  have g12FL : G12 FL = [fl] := by
    simp +decide [hG12, hG11, hG10, hG9, hG8, hG7, hG6, hG5, hG4, hG3, hG2, hG1, hG0, bSt,
      update_apply, hfl]
  have g12 : ∀ i ∈ [rP, rK, NN, QQ, DD, Q0, Z, BZ, A], G12 i = bSt P k F bs bts R T0 j i := by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp +decide [hG12, hG11, hG10, hG9, hG8, hG7, hG6, hG5, hG4, hG3, hG2, hG1, hG0,
        update_apply]
  have b0 : ∀ i ∈ [rP, rK, NN, QQ, DD, Q0], bSt P k F bs bts R T0 j i = F i := by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl | rfl <;> simp +decide [bSt, update_apply]
  have hpvk : pv.natAbs < 2 ^ k := by
    have := zsz_le_iff.1 hpvB
    have : 2 ^ Xb ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  have hnumk : num.natAbs < 2 ^ k := by
    have : 2 ^ (W + 2) ≤ 2 ^ k := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  have hNk : (2 * (num * 2 ^ P) + pv).natAbs < 2 ^ k :=
    lt_of_lt_of_le (N_natAbs_lt W P Xb hnumB hpvB (by omega)) hWk
  have sdiv : MSp M divB (encK s G12) (encK s (update G12 Z (z :: G12 Z)))
      ((Ex.size (.neg (.reg PV)) + 1) * 2000 * (Bx + 2) + 2 * Bx + 30 +
        (2 * Φm + 2 * 10 ^ 5 * (Bx + 2))) := by
    have ec : (Ex.neg (.reg PV)).eval (encK s G12) = -pv := by simp [Ex.eval, top_encK g12PV]
    refine MSp.ite (RS.clean_of_lt (by decide)) (isInt_encK g12PV) trivial
      (by simp only [Ex.Bnd, Ex.eval, top_encK g12PV, zsz_neg]; omega) (fun h => ?_) (fun h => ?_)
    · rw [ec] at h
      exact recip_spec hMB s g12NUM g12PV g12IV
        (by rw [g12 rP (by simp), b0 rP (by simp)]; exact hrp)
        (by rw [g12 rK (by simp), b0 rK (by simp)]; exact hrk)
        (by rw [g12 NN (by simp), b0 NN (by simp)]; exact hnn)
        (by rw [g12 QQ (by simp), b0 QQ (by simp)]; exact hqq)
        (by rw [g12 DD (by simp), b0 DD (by simp)]; exact hdd)
        (by rw [g12 Q0 (by simp), b0 Q0 (by simp)]; exact hq0)
        (by omega) hNk hpvk hnumk (le_trans hzX (by omega)) hBx (by omega)
    · rw [ec] at h
      have h0 : pv = 0 := by omega
      have := Sp.push (s := s) (f := G12) (i := Z) (e := .lit 0) (B := Bx) (by decide)
        (by intro i hi; simp [Ex.regs] at hi) trivial trivial (by simp [Ex.Bnd, zsz_zero])
      refine ((MSp.rs this).congr ?_).mono ?_
      · simp only [Ex.eval, hzd, h0, fdiv_zero]
      · simp only [Ex.size]; omega
  set G13 := update G12 Z (z :: G12 Z) with hG13
  have g13FL : G13 FL = [fl] := by simp +decide [hG13, g12FL]
  have g13Z : G13 Z = z :: G12 Z := by simp [hG13]
  have sfl : MSp M flB (encK s G13)
      (encK s (update G13 BZ (if fl = 1 then z :: G13 BZ else G13 BZ)))
      ((Ex.size (.add (.reg FL) (.lit (-1))) + 1) * 2000 * (Bx + 2) + 2 * Bx + 30 +
        4000 * (Bx + 2)) := by
    have ec : (Ex.add (.reg FL) (.lit (-1))).eval (encK s G13) = fl + -1 := by
      simp [Ex.eval, top_encK g13FL]
    refine MSp.ite (clean_of_regs (by decide)) ⟨isInt_encK g13FL, trivial⟩ ⟨trivial, trivial⟩
      (by
        simp only [Ex.Bnd, Ex.eval, top_encK g13FL]
        refine ⟨by omega, by rw [zsz_neg, zsz_one]; omega, ?_⟩
        rcases hfl01 with h | h <;> rw [h]
        · rw [show (0 : ℤ) + -1 = -1 by norm_num, zsz_neg, zsz_one]; omega
        · rw [show (1 : ℤ) + -1 = 0 by norm_num, zsz_zero]; omega) (fun h => ?_) (fun h => ?_)
    · rw [ec] at h
      have h0 : fl ≠ 1 := by omega
      refine ((MSp.skip (M := M) _).congr ?_).mono (by omega)
      rw [if_neg h0, update_eq_self]
    · rw [ec] at h
      have h1 : fl = 1 := by omega
