    · have hxt : x.testBit (ρ + n * K) = true := by rw [Nat.testBit_eq_decide_div_mod_eq]; simp [hx]
      have e : y ^^^ (x &&& selM K ρ (n + 1)) = y' ^^^ 2 ^ (ρ + n * K) := by
