namespace NetProp7

open Matrix Finset AModel NetScalar AModelRat AModelFac

variable {h : ℕ}

lemma φC_apply (M : Matrix (Cube h) (Cube h) ℚ) :
    φC h M = Matrix.reindex (cubeEquiv h) (cubeEquiv h) M := rfl

lemma rank_φC (M : Matrix (Cube h) (Cube h) ℚ) : (φC h M).rank = M.rank := by
  rw [φC_apply, rank_reindex]

lemma φC_one : φC h 1 = 1 := by
  rw [φC_apply, reindex_apply, submatrix_one_equiv]

variable {T : Type*} [Fintype T] [DecidableEq T] (ind : T → Finset (Fin h))

lemma unit_wr (x : NetScalar.Wr ind) : MoutL ind (NetScalar.ρ ind x) - MinL ind x = 1 := by
  rcases x with a | a | x
  · simp [MoutL, MinL, NetScalar.ρ]
  · simp [MoutL, MinL, NetScalar.ρ]
  · simp [MoutL, MinL, NetScalar.ρ]

/-- The rank sum of `bitQC` (over `ℕ`) equals that of the cube-indexed labelled network. -/
lemma frameSum_bitQC :
    ((frameSum (fun A : QMat (h ^ 3) => A.rank) (bitQC ind).gates (bitQC ind).Min
      (bitQC ind).Mout : ℕ) : ℚ) = frameSum rk (gatesL ind) (MinL ind) (MoutL ind) := by
  rw [frameSum_cast_nat]
  change frameSum (fun A : QMat (h ^ 3) => (A.rank : ℚ)) ((gatesL ind).map (trG (NetProp7.eW ind) (φC h)))
    (fun w => φC h (MinL ind ((NetProp7.eW ind).symm w))) (fun w => φC h (MoutL ind ((NetProp7.eW ind).symm w))) = _
  rw [frameSum_trG]
  simp only [rank_φC]

variable (hcard : ∀ t, (ind t).card = 3) (hinj : Function.Injective ind)
include hcard hinj

/-- **Proposition 7 (rational interface), general `h` and card-3 family.** -/
theorem prop7_interface :
    (∀ g ∈ (bitQC ind).gates, g.OK) ∧
    (∀ (v : Fin (Fintype.card (NetScalar.Wr ind)) → ZMod 2) w,
      scalarRun (bitQC ind).gates v ((bitQC ind).ρ w) = v w) ∧
    (∀ w, (bitQC ind).Mout ((bitQC ind).ρ w) - (bitQC ind).Min w = 1) ∧
    ((frameSum (fun A : QMat (h ^ 3) => A.rank) (bitQC ind).gates (bitQC ind).Min
      (bitQC ind).Mout : ℕ) : ℚ) =
      (Fintype.card (NetScalar.Wr ind) : ℚ) * (h : ℚ) ^ 3 - (Fintype.card T : ℚ) ^ 3 +
        2 * (3 * (Fintype.card T : ℚ) ^ 2 * h * h) := by
  obtain ⟨hok, hroute⟩ := bit_exchange7_net hcard hinj (labG ind)
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro g hg
    obtain ⟨g', hg', rfl⟩ := List.mem_map.1 hg
    exact trG_OK _ _ (hok g' hg')
  · intro v w
    change scalarRun ((gatesL ind).map (trG (NetProp7.eW ind) (φC h))) v (NetProp7.eW ind (NetScalar.ρ ind ((NetProp7.eW ind).symm w)))
      = v w
    rw [scalarRun_trG, Equiv.symm_apply_apply]
    change scalarRun (NetScalar.labelled (labG ind) (named7 ind)) _ _ = _
    rw [hroute, Equiv.apply_symm_apply]
  · intro w
    change φC h (MoutL ind ((NetProp7.eW ind).symm (NetProp7.eW ind (NetScalar.ρ ind ((NetProp7.eW ind).symm w))))) -
      φC h (MinL ind ((NetProp7.eW ind).symm w)) = 1
    rw [Equiv.symm_apply_apply, ← map_sub, unit_wr, φC_one]
  · rw [frameSum_bitQC, frameSum_gatesL_eq ind hcard]

end NetProp7

end

