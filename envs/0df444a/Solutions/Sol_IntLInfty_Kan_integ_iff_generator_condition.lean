theorem extD_zero' (hr : 1 ≤ r) {x : Fin m → ℝ} (hx : x ∈ simplex m) : extD (0 : Ω m) x = 0 := by
  have := extD_smul hr (0 : ℝ) (isCr_zero (r := r) (m := m)) hx
  simpa using this

end Lib

section CE

variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]

theorem one_mem_ceDeg : (1 : CE L) ∈ ceDeg L 0 :=
  Submodule.subset_span ⟨0, Fin.elim0, fun t => Fin.elim0 t, by simp, by simp⟩

theorem gen_mem_ceDeg (i : ℕ) (ξ : Module.Dual ℝ (L i)) : gen L i ξ ∈ ceDeg L (i + 1) :=
  Submodule.subset_span ⟨1, fun _ => i, fun _ => ξ, by simp, by simp⟩

end CE

/-! ### The cone operator (source defs, proof-free; facts from C1). -/

abbrev Alg (m : ℕ) : Type := ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ))

@[reducible] noncomputable def algNAG (m : ℕ) : NormedAddCommGroup (Alg m) :=
  NormedAddCommGroup.induced (Alg m) (Finset (Fin m) → ℝ) (formBasis m).equivFun.toLinearMap
    (formBasis m).equivFun.injective

attribute [local instance] algNAG

@[reducible] noncomputable def algNS (m : ℕ) : NormedSpace ℝ (Alg m) :=
  NormedSpace.induced ℝ (Alg m) (Finset (Fin m) → ℝ) (formBasis m).equivFun.toLinearMap

attribute [local instance] algNS

theorem algFD (m : ℕ) : FiniteDimensional ℝ (Alg m) := Module.Finite.of_basis (formBasis m)

attribute [local instance] algFD

theorem algComplete (m : ℕ) : CompleteSpace (Alg m) := FiniteDimensional.complete ℝ (Alg m)

attribute [local instance] algComplete

section Cont
variable {m r : ℕ}

theorem contDiffOn_of_coeff {ϖ : Ω m} {S : Set (Fin m → ℝ)}
    (h : ∀ I, ContDiffOn ℝ r (coeff ϖ I) S) : ContDiffOn ℝ r ϖ S := by
  have e : ϖ = fun y => (formBasis m).equivFun.symm (fun I => coeff ϖ I y) := by
    funext y
    apply (formBasis m).equivFun.injective
    rw [LinearEquiv.apply_symm_apply]
    funext I
    simp [coeff]
  rw [e]
  exact (LinearMap.toContinuousLinearMap (formBasis m).equivFun.symm.toLinearMap).contDiff.comp_contDiffOn
    (contDiffOn_pi.mpr h)

theorem continuousOn_of_isCr {β : Ω m} (hC : IsCr r β) : ContinuousOn β (simplex m) :=
  (contDiffOn_of_coeff fun I => (hC I).1).continuousOn

end Cont

noncomputable def coneInt {E F : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] (p : ℕ) (f : E → F) (x : E) : F :=
  ∫ t in (0 : ℝ)..1, (t ^ p) • f (t • x)

noncomputable def cL (m : ℕ) : (Fin m → ℝ) →ₗ[ℝ] Alg m →ₗ[ℝ] Alg m :=
  (CliffordAlgebra.contractLeft (Q := (0 : QuadraticForm ℝ (Module.Dual ℝ (Fin m → ℝ))))).comp
    (Module.Dual.eval ℝ (Fin m → ℝ))

noncomputable def cB (m : ℕ) : (Fin m → ℝ) →L[ℝ] Alg m →L[ℝ] Alg m :=
  LinearMap.toContinuousLinearMap
    ((LinearMap.toContinuousLinearMap : (Alg m →ₗ[ℝ] Alg m) ≃ₗ[ℝ] (Alg m →L[ℝ] Alg m)).toLinearMap
      ∘ₗ cL m)

/-- The cone (Poincare homotopy) operator on forms of the simplex. -/
noncomputable def Kop {m : ℕ} (n : ℕ) (β : Ω m) : Ω m := fun y => cB m y (coneInt n β y)

section KopFacts

variable {m r : ℕ}

theorem Kop_hom {n : ℕ} (hr : 1 ≤ r) {β : Ω m} (hC : IsCr r β) (hD : IsDeg (n + 1) β) :
    ∀ x ∈ simplex m, extD (Kop n β) x + Kop (n + 1) (extD β) x = β x :=
  ((IntLInfty.Kan.cone_homotopy_operator r hr (fun _ n β => Kop n β) (fun _ _ _ _ => rfl)).1
    m n β hC hD).2.2

theorem Kop_congr (n : ℕ) {β β' : Ω m} (h : FormEqOn β β') : FormEqOn (Kop n β) (Kop n β') :=
  (IntLInfty.Kan.cone_homotopy_operator 1 le_rfl (fun _ n β => Kop n β)
    (fun _ _ _ _ => rfl)).2.2.1 m n β β' h

theorem Kop_zero (n : ℕ) : Kop n (0 : Ω m) = 0 := by
  funext y
  simp [Kop, coneInt]

theorem isDeg_extD (hr : 1 ≤ r) {n : ℕ} {ϖ : Ω m} (hC : IsCr r ϖ) (hD : IsDeg n ϖ) :
    IsDeg (n + 1) (extD ϖ) :=
  (IntLInfty.Kan.cone_homotopy_operator r hr (fun _ n β => Kop n β)
    (fun _ _ _ _ => rfl)).2.2.2.2.2.2.1 m n ϖ hC hD

theorem isCr_extD (hr : 1 ≤ r) {ϖ : Ω m} (hC : IsCr r ϖ) : IsCr r (extD ϖ) :=
  (IntLInfty.Kan.cone_homotopy_operator r hr (fun _ n β => Kop n β)
    (fun _ _ _ _ => rfl)).2.2.2.2.2.2.2.1 m ϖ hC

end KopFacts

/-! ### Smooth families (source A83Ev, section Fam). -/

section Fam

variable {m r : ℕ} {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem jet_mem (hr : 1 ≤ r) {n : ℕ} {w0 : Ω m} (h : IsDeg n w0 ∧ IsCr r w0) :
    jet r w0 ∈ CrForms r m n := by
  rw [← SetLike.mem_coe, crForms_eq_image hr n]
  exact ⟨_, h, rfl⟩

def SmoothFam (r n : ℕ) (F : E → Ω m) : Prop :=
  ∃ a : E → CrForms r m n, ContDiff ℝ ∞ a ∧
    ∀ z, (IsDeg n (F z) ∧ IsCr r (F z)) ∧ jet r (F z) = a z

theorem smoothFam_zero (hr : 1 ≤ r) (n : ℕ) : SmoothFam (m := m) r n (fun _ : E => 0) :=
  ⟨fun _ => 0, contDiff_const, fun _ => ⟨⟨isDeg_zero, isCr_zero⟩, by rw [jet_zero' hr]; rfl⟩⟩

theorem smoothFam_add (hr : 1 ≤ r) {n : ℕ} {F G : E → Ω m} (hF : SmoothFam r n F)
    (hG : SmoothFam r n G) : SmoothFam r n (fun z => F z + G z) := by
  obtain ⟨a, ha, hFa⟩ := hF
  obtain ⟨b, hb, hGb⟩ := hG
  refine ⟨fun z => a z + b z, ha.add hb, fun z => ⟨⟨isDeg_add (hFa z).1.1 (hGb z).1.1,
    isCr_add hr (hFa z).1.2 (hGb z).1.2⟩, ?_⟩⟩
  rw [jet_add hr (hFa z).1.2 (hGb z).1.2, (hFa z).2, (hGb z).2]
  rfl

theorem smoothFam_smul (hr : 1 ≤ r) {n : ℕ} (c : ℝ) {F : E → Ω m} (hF : SmoothFam r n F) :
    SmoothFam r n (fun z => c • F z) := by
  obtain ⟨a, ha, hFa⟩ := hF
  refine ⟨fun z => c • a z, ha.const_smul c, fun z => ⟨⟨isDeg_smul c (hFa z).1.1,
    isCr_smul hr c (hFa z).1.2⟩, ?_⟩⟩
  rw [jet_smul hr c (hFa z).1.2, (hFa z).2]
  rfl

theorem smoothFam_sum (hr : 1 ≤ r) {n : ℕ} {ι : Type} (s : Finset ι) {F : ι → E → Ω m}
    (hF : ∀ i ∈ s, SmoothFam r n (F i)) : SmoothFam r n (fun z => ∑ i ∈ s, F i z) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using smoothFam_zero (E := E) (m := m) hr n
  | @insert i s hi ih =>
    simp only [Finset.sum_insert hi]
    exact smoothFam_add hr (hF i (Finset.mem_insert_self i s))
      (ih fun j hj => hF j (Finset.mem_insert_of_mem hj))

theorem smoothFam_mul (hr : 1 ≤ r) {p q : ℕ} {F G : E → Ω m} (hF : SmoothFam r p F)
    (hG : SmoothFam r q G) : SmoothFam r (p + q) (fun z => F z * G z) := by
  obtain ⟨a, ha, hFa⟩ := hF
  obtain ⟨b, hb, hGb⟩ := hG
  have h1 := (contDiff_wedge (m := m) hr p q).comp (ha.prodMk hb)
  have hc : ContDiff ℝ ∞ (fun z => wedgeCLM (m := m) hr p q (a z) (b z)) := h1
  refine ⟨fun z => wedgeCLM hr p q (a z) (b z), hc, fun z => ⟨⟨?_, ?_⟩, ?_⟩⟩
  · exact isDeg_mul (hFa z).1.1 (hGb z).1.1
  · exact isCr_mul hr (hFa z).1.2 (hGb z).1.2 (hFa z).1.1
  · exact (wedgeCLM_val hr (hFa z).1 (hGb z).1 (hFa z).2 (hGb z).2).symm

theorem smoothFam_const (hr : 1 ≤ r) {n : ℕ} {w0 : Ω m} (h : IsDeg n w0 ∧ IsCr r w0) :
    SmoothFam r n (fun _ : E => w0) :=
  ⟨fun _ => ⟨jet r w0, jet_mem hr h⟩, contDiff_const, fun _ => ⟨h, rfl⟩⟩

theorem smoothFam_congr {n : ℕ} {F G : E → Ω m} (hF : SmoothFam r n F)
    (h : ∀ z, FormEqOn (G z) (F z)) : SmoothFam r n G := by
  obtain ⟨a, ha, hFa⟩ := hF
  refine ⟨a, ha, fun z => ⟨⟨fun x hx => ?_,
    isCr_of_formEqOn (fun x hx => (h z x hx).symm) (hFa z).1.2⟩,
    (jet_congr (h z)).trans (hFa z).2⟩⟩
  rw [h z x hx]
  exact (hFa z).1.1 x hx

theorem isDeg_algebraMap (c : ℝ) : IsDeg 0 (algebraMap ℝ (Ω m) c) := fun _ _ => by
  have h0 : (⋀[ℝ]^0 (Module.Dual ℝ (Fin m → ℝ))) = 1 := pow_zero _
  rw [h0, Pi.algebraMap_apply]
  exact Submodule.algebraMap_mem c

theorem isCr_algebraMap (c : ℝ) : IsCr r (algebraMap ℝ (Ω m) c) := by
  have h0 : ∀ J, coeff (algebraMap ℝ (Ω m) c) J =
      fun _ => (formBasis m).repr (algebraMap ℝ (ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ))) c) J :=
    fun J => rfl
  have h1 : extD (algebraMap ℝ (Ω m) c) = 0 := by funext x; simp [extD, h0]
  have h2 : ∀ J, coeff (0 : Ω m) J = fun _ => 0 := by intro J; funext x; simp [coeff]
  exact fun I => ⟨by rw [h0]; exact contDiffOn_const, by rw [h1, h2]; exact contDiffOn_const⟩

/-- A finite sum of `C^∞` homogeneous families. -/
def SumFam (r : ℕ) (F : E → Ω m) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι) (deg : ι → ℕ) (G : ι → E → Ω m),
    (∀ i, SmoothFam r (deg i) (G i)) ∧ ∀ z, F z = ∑ i, G i z

theorem sumFam_of_smoothFam {n : ℕ} {F : E → Ω m} (h : SmoothFam r n F) : SumFam r F :=
  ⟨Unit, inferInstance, fun _ => n, fun _ => F, fun _ => h, fun z => by simp⟩

theorem sumFam_add {F G : E → Ω m} (hF : SumFam r F) (hG : SumFam r G) :
    SumFam r (fun z => F z + G z) := by
  obtain ⟨ι, _, d, F', hF', eF⟩ := hF
  obtain ⟨κ, _, d', G', hG', eG⟩ := hG
  refine ⟨ι ⊕ κ, inferInstance, Sum.elim d d', Sum.elim F' G', ?_, fun z => ?_⟩
  · rintro (i | k)
    · exact hF' i
    · exact hG' k
  · show F z + G z = _
    rw [Fintype.sum_sum_type, eF z, eG z]
    rfl

theorem sumFam_mul (hr : 1 ≤ r) {F G : E → Ω m} (hF : SumFam r F) (hG : SumFam r G) :
    SumFam r (fun z => F z * G z) := by
  obtain ⟨ι, _, d, F', hF', eF⟩ := hF
  obtain ⟨κ, _, d', G', hG', eG⟩ := hG
  refine ⟨ι × κ, inferInstance, fun s => d s.1 + d' s.2, fun s z => F' s.1 z * G' s.2 z,
    fun s => smoothFam_mul hr (hF' s.1) (hG' s.2), fun z => ?_⟩
  simp only [eF z, eG z, Fintype.sum_mul_sum, Fintype.sum_prod_type]

theorem graded_extract {ι : Type} [Fintype ι] (d : ι → ℕ) {n : ℕ}
    (y : ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ)))
    (hy : y ∈ ⋀[ℝ]^n (Module.Dual ℝ (Fin m → ℝ)))
    (g : ι → ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ)))
    (hg : ∀ i, g i ∈ ⋀[ℝ]^(d i) (Module.Dual ℝ (Fin m → ℝ))) (hsum : y = ∑ i, g i) :
    y = ∑ i ∈ Finset.univ.filter (fun i => d i = n), g i := by
  classical
  have h1 := congrArg
    (GradedRing.proj (fun k : ℕ => ⋀[ℝ]^k (Module.Dual ℝ (Fin m → ℝ))) n) hsum
  rw [map_sum, GradedRing.proj_apply, DirectSum.decompose_of_mem_same (fun k : ℕ => ⋀[ℝ]^k (Module.Dual ℝ (Fin m → ℝ))) hy] at h1
  rw [h1, Finset.sum_filter]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [GradedRing.proj_apply]
  split_ifs with h
  · exact DirectSum.decompose_of_mem_same (fun k : ℕ => ⋀[ℝ]^k (Module.Dual ℝ (Fin m → ℝ))) (h ▸ hg i)
  · exact DirectSum.decompose_of_mem_ne (fun k : ℕ => ⋀[ℝ]^k (Module.Dual ℝ (Fin m → ℝ))) (hg i) h

theorem smoothFam_of_sumFam (hr : 1 ≤ r) {n : ℕ} {F : E → Ω m} (hF : SumFam r F)
    (hd : ∀ z, IsDeg n (F z)) : SmoothFam r n F := by
  classical
  obtain ⟨ι, _, d, G, hG, eF⟩ := hF
  have hsm : SmoothFam r n (fun z => ∑ i ∈ Finset.univ.filter (fun i => d i = n), G i z) := by
    apply smoothFam_sum hr
    intro i hi
    have hi' : d i = n := (Finset.mem_filter.1 hi).2
    rw [← hi']
    exact hG i
  refine smoothFam_congr hsm fun z x hx => ?_
  show F z x = (∑ i ∈ Finset.univ.filter (fun i => d i = n), G i z) x
  rw [Finset.sum_apply]
  refine graded_extract d (F z x) (hd z x hx) (fun i => G i z x)
    (fun i => ?_) ?_
  · obtain ⟨_, _, hGa⟩ := hG i
    exact (hGa z).1.1 x hx
  · rw [eF z, Finset.sum_apply]

end Fam

section Lift

variable {m r : ℕ} {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E]
variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]

/-- Every element of `A_S` evaluates, through any algebra lift `Φ z` of smooth generator data, to a
finite sum of smooth homogeneous families. -/
theorem sumFam_lift (hr : 1 ≤ r) (S : GenSys L) (f : E → ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m)
    (Φ : E → CE L →ₐ[ℝ] Ω m) (hΦ : ∀ z i (ξ : Module.Dual ℝ (L i)), Φ z (gen L i ξ) = f z i ξ)
    (hgen : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → SmoothFam r (i + 1) (fun z => f z i ξ))
    (x : CE L) (hx : x ∈ genAlg L S) : SumFam r (fun z => Φ z x) := by
  unfold genAlg at hx
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    obtain ⟨i, ξ, hξ, rfl⟩ := Set.mem_iUnion.1 hy
    simp only [hΦ]
    exact sumFam_of_smoothFam (hgen i ξ hξ)
  | algebraMap c =>
    simp only [AlgHom.commutes]
    exact sumFam_of_smoothFam (smoothFam_const hr ⟨isDeg_algebraMap c, isCr_algebraMap c⟩)
  | add x y _ _ hx hy =>
    simp only [map_add]
    exact sumFam_add hx hy
  | mul x y _ _ hx hy =>
    simp only [map_mul]
    exact sumFam_mul hr hx hy

theorem smoothFam_lift (hr : 1 ≤ r) (S : GenSys L) (f : E → ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m)
    (Φ : E → CE L →ₐ[ℝ] Ω m) (hΦ : ∀ z i (ξ : Module.Dual ℝ (L i)), Φ z (gen L i ξ) = f z i ξ)
    (hgen : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → SmoothFam r (i + 1) (fun z => f z i ξ))
    {n : ℕ} (x : CE L) (hx : x ∈ genAlg L S) (hd : ∀ z, IsDeg n (Φ z x)) :
    SmoothFam r n (fun z => Φ z x) :=
  smoothFam_of_sumFam hr (sumFam_lift hr S f Φ hΦ hgen x hx) hd

end Lift

section Coord

variable {m r : ℕ} {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]

theorem contDiff_coord (S : GenSys L) (t : Fin m) (k : Fin (Module.finrank ℝ (S t))) :
    ContDiff ℝ ∞ (fun z : Amb r S m => z t k) := by
  have h := contDiff_id (𝕜 := ℝ) (n := ∞)
    (E := (t : Fin m) → (Fin (Module.finrank ℝ (S t)) → CrForms r m (t + 1)))
  exact contDiff_pi.1 (contDiff_pi.1 h t) k

end Coord

/-! ### Defect bounds (source A83Defect). -/

section Defect

variable {m r : ℕ}

theorem exists_norm_mul_le : ∃ C : ℝ, 0 ≤ C ∧ ∀ a b : Alg m, ‖a * b‖ ≤ C * ‖a‖ * ‖b‖ := by
  let M : Alg m →L[ℝ] Alg m →L[ℝ] Alg m :=
    LinearMap.toContinuousLinearMap
      ((LinearMap.toContinuousLinearMap : (Alg m →ₗ[ℝ] Alg m) ≃ₗ[ℝ] (Alg m →L[ℝ] Alg m)).toLinearMap
        ∘ₗ LinearMap.mul ℝ (Alg m))
  refine ⟨‖M‖, M.opNorm_nonneg, fun a b => ?_⟩
  have h := M.le_opNorm₂ a b
  have e : M a b = a * b := rfl
  rw [e] at h
  exact h

theorem norm_Kop_le (n : ℕ) {β : Ω m} (hβ : ContinuousOn β (simplex m)) {y : Fin m → ℝ}
    (hy : y ∈ simplex m) :
    ‖Kop n β y‖ ≤ ‖cB m‖ * ‖y‖ * ∫ t in (0 : ℝ)..1, ‖β (t • y)‖ := by
  have h1 : ‖Kop n β y‖ ≤ ‖cB m‖ * ‖y‖ * ‖coneInt n β y‖ := (cB m).le_opNorm₂ y _
  have hc : ContinuousOn (fun t : ℝ => β (t • y)) (Set.Icc (0 : ℝ) 1) :=
    hβ.comp (continuous_id.smul continuous_const).continuousOn
      (fun t ht => smul_mem_simplex hy ht)
  have h2 : ‖coneInt n β y‖ ≤ ∫ t in (0 : ℝ)..1, ‖β (t • y)‖ := by
    unfold coneInt
    refine (intervalIntegral.norm_integral_le_integral_norm zero_le_one).trans ?_
    apply intervalIntegral.integral_mono_on zero_le_one
    · apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le zero_le_one]
      exact ((continuous_pow n).continuousOn.smul hc).norm
    · apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le zero_le_one]
      exact hc.norm
    · intro t ht
      rw [norm_smul, norm_pow, Real.norm_of_nonneg ht.1]
      have hp : t ^ n ≤ 1 := pow_le_one₀ ht.1 ht.2
      have h0 : 0 ≤ ‖β (t • y)‖ := norm_nonneg _
      nlinarith
  exact h1.trans (mul_le_mul_of_nonneg_left h2 (mul_nonneg (cB m).opNorm_nonneg (norm_nonneg y)))

variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]

theorem defect_bound (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (Φ : CE L →ₐ[ℝ] Ω m)
    (hdeg : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → IsDeg (i + 1) (Φ (gen L i ξ)))
    (hcr : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → IsCr r (Φ (gen L i ξ)))
    (N : (Fin m → ℝ) → ℝ)
    (hd : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → ∃ C : ℝ, ∀ x ∈ simplex m,
      ‖extD (Φ (gen L i ξ)) x - Φ (δ.δ (gen L i ξ)) x‖ ≤ C * N x)
    (a : CE L) (ha : a ∈ genAlg L S) :
    IsCr r (Φ a) ∧ ∃ C : ℝ, ∀ x ∈ simplex m, ‖extD (Φ a) x - Φ (δ.δ a) x‖ ≤ C * N x := by
  have hspan : a ∈ Submodule.span ℝ (Submonoid.closure
      (⋃ i, (gen L i : Module.Dual ℝ (L i) → CE L) '' (S i : Set (Module.Dual ℝ (L i)))) : Set (CE L)) := by
    rw [← Algebra.adjoin_eq_span]; exact ha
  clear ha
  induction hspan using Submodule.span_induction with
  | mem y hy =>
    have hy' : y ∈ Submonoid.closure
        (⋃ i, (gen L i : Module.Dual ℝ (L i) → CE L) '' (S i : Set (Module.Dual ℝ (L i)))) := hy
    clear hy
    induction hy' using Submonoid.closure_induction_left with
    | one =>
      have hc := isCr_const (m := m) r 1
      refine ⟨by rw [map_one]; exact hc.1, 0, fun x hx => ?_⟩
      have h0 : extD (Φ 1) x = 0 := by rw [map_one]; exact congrFun hc.2 x
      rw [h0, IntLInfty.Kan.generator_lift_dga.2.2.2.2.2.2.2.1 δ, map_zero]
      simp
    | mul_left g hg y _ ih =>
      obtain ⟨i, ξ, hξ, rfl⟩ := Set.mem_iUnion.1 hg
      obtain ⟨Cm, hCm0, hCm⟩ := exists_norm_mul_le (m := m)
      obtain ⟨Cg, hCg⟩ := hd i ξ hξ
      obtain ⟨Cy, hCy⟩ := ih.2
      obtain ⟨My, hMy⟩ := (isCompact_simplex m).exists_bound_of_continuousOn
        (continuousOn_of_isCr ih.1)
      obtain ⟨Mg, hMg⟩ := (isCompact_simplex m).exists_bound_of_continuousOn
        (continuousOn_of_isCr (hcr i ξ hξ))
      refine ⟨by rw [map_mul]; exact isCr_mul hr (hcr i ξ hξ) ih.1 (hdeg i ξ hξ),
        Cm * Cg * My + Cm * Mg * Cy, fun x hx => ?_⟩
      set u := extD (Φ (gen L i ξ)) x - Φ (δ.δ (gen L i ξ)) x with hu
      set v := extD (Φ y) x - Φ (δ.δ y) x with hv
      have e : extD (Φ (gen L i ξ * y)) x - Φ (δ.δ (gen L i ξ * y)) x =
          u * Φ y x + (-1 : ℝ) ^ (i + 1) • (Φ (gen L i ξ) x * v) := by
        rw [hu, hv, map_mul, extD_mul hr (hcr i ξ hξ) ih.1 (hdeg i ξ hξ) hx,
          δ.leibniz (i + 1) _ (gen_mem_ceDeg i ξ) y, map_add, map_smul, map_mul, map_mul]
        simp only [Pi.add_apply, Pi.smul_apply, Pi.mul_apply, sub_mul, mul_sub, smul_sub]
        abel
      rw [e]
      have hsign : ‖((-1 : ℝ) ^ (i + 1))‖ = 1 := by simp
      have hu' : ‖u‖ ≤ Cg * N x := hCg x hx
      have hv' : ‖v‖ ≤ Cy * N x := hCy x hx
      have h1 : ‖u * Φ y x‖ ≤ Cm * (Cg * N x) * My :=
        (hCm _ _).trans (mul_le_mul (mul_le_mul_of_nonneg_left hu' hCm0) (hMy x hx)
          (norm_nonneg _) (mul_nonneg hCm0 ((norm_nonneg _).trans hu')))
      have h2 : ‖Φ (gen L i ξ) x * v‖ ≤ Cm * Mg * (Cy * N x) :=
        (hCm _ _).trans (mul_le_mul (mul_le_mul_of_nonneg_left (hMg x hx) hCm0) hv'
          (norm_nonneg _) (mul_nonneg hCm0 ((norm_nonneg _).trans (hMg x hx))))
      calc ‖u * Φ y x + (-1 : ℝ) ^ (i + 1) • (Φ (gen L i ξ) x * v)‖
          ≤ ‖u * Φ y x‖ + ‖Φ (gen L i ξ) x * v‖ := by
            refine (norm_add_le _ _).trans ?_
            rw [norm_smul, hsign, one_mul]
        _ ≤ Cm * (Cg * N x) * My + Cm * Mg * (Cy * N x) := add_le_add h1 h2
        _ = (Cm * Cg * My + Cm * Mg * Cy) * N x := by ring
  | zero =>
    refine ⟨by rw [map_zero]; exact isCr_zero, 0, fun x hx => ?_⟩
    simp only [map_zero, Pi.zero_apply, extD_zero' hr hx]
    simp
  | add y z _ _ hy hz =>
    obtain ⟨Cy, hCy⟩ := hy.2
    obtain ⟨Cz, hCz⟩ := hz.2
    refine ⟨by rw [map_add]; exact isCr_add hr hy.1 hz.1, Cy + Cz, fun x hx => ?_⟩
    have e : extD (Φ (y + z)) x - Φ (δ.δ (y + z)) x =
        (extD (Φ y) x - Φ (δ.δ y) x) + (extD (Φ z) x - Φ (δ.δ z) x) := by
      rw [map_add, extD_add hr hy.1 hz.1 hx, map_add, map_add]
      simp only [Pi.add_apply]
      abel
    rw [e]
    calc _ ≤ ‖extD (Φ y) x - Φ (δ.δ y) x‖ + ‖extD (Φ z) x - Φ (δ.δ z) x‖ := norm_add_le _ _
      _ ≤ Cy * N x + Cz * N x := add_le_add (hCy x hx) (hCz x hx)
      _ = (Cy + Cz) * N x := by ring
  | smul c y _ hy =>
    obtain ⟨Cy, hCy⟩ := hy.2
    refine ⟨by rw [map_smul]; exact isCr_smul hr c hy.1, |c| * Cy, fun x hx => ?_⟩
    have e : extD (Φ (c • y)) x - Φ (δ.δ (c • y)) x = c • (extD (Φ y) x - Φ (δ.δ y) x) := by
      rw [map_smul, extD_smul hr c hy.1 hx, map_smul, map_smul]
      simp only [Pi.smul_apply, smul_sub]
    rw [e, norm_smul, Real.norm_eq_abs, mul_assoc]
    exact mul_le_mul_of_nonneg_left (hCy x hx) (abs_nonneg c)

theorem defect_vanish (hr : 1 ≤ r) {ι : Type} [Fintype ι] (n : ι → ℕ) (B : ι → Ω m)
    (hC : ∀ j, IsCr r (B j)) (hD : ∀ j, IsDeg (n j + 1) (B j))
    (hK : ∀ j, FormEqOn (Kop (n j) (B j)) 0)
    (hdB : ∀ j, ∃ C : ℝ, ∀ x ∈ simplex m,
      ‖extD (B j) x‖ ≤ C * ‖(fun i => B i x : ι → Alg m)‖) :
    ∀ j, ∀ x ∈ simplex m, B j x = 0 := by
  choose Cj hCj using hdB
  set Bv : (Fin m → ℝ) → (ι → Alg m) := fun x i => B i x with hBv
  have hBc : ContinuousOn Bv (simplex m) :=
    continuousOn_pi.2 fun i => continuousOn_of_isCr (hC i)
  obtain ⟨M, hM⟩ := (isCompact_simplex m).exists_bound_of_continuousOn hBc
  set C := ‖cB m‖ * ∑ j, max (Cj j) 0 with hCdef
  have hC0 : 0 ≤ C := mul_nonneg (cB m).opNorm_nonneg
    (Finset.sum_nonneg fun j _ => le_max_right _ _)
  have hcont : ∀ x ∈ simplex m, ContinuousOn (fun t : ℝ => Bv (t • x)) (Set.Icc (0 : ℝ) 1) :=
    fun x hx => hBc.comp (continuous_id.smul continuous_const).continuousOn
      (fun t ht => smul_mem_simplex hx ht)
  have key : ∀ x ∈ simplex m, ‖Bv x‖ ≤ C * ‖x‖ * ∫ t in (0 : ℝ)..1, ‖Bv (t • x)‖ := by
    intro x hx
    have hI0 : 0 ≤ ∫ t in (0 : ℝ)..1, ‖Bv (t • x)‖ :=
      intervalIntegral.integral_nonneg zero_le_one (fun t _ => norm_nonneg _)
    refine (pi_norm_le_iff_of_nonneg (mul_nonneg (mul_nonneg hC0 (norm_nonneg x)) hI0)).2 fun j => ?_
    have hrep : B j x = Kop (n j + 1) (extD (B j)) x := by
      have h := Kop_hom hr (hC j) (hD j) x hx
      have h0 : extD (Kop (n j) (B j)) x = 0 := by
        rw [extD_congr (hK j) x hx]; exact extD_zero' hr hx
      rw [h0, zero_add] at h
      exact h.symm
    have hdc : ContinuousOn (extD (B j)) (simplex m) :=
      continuousOn_of_isCr (isCr_extD hr (hC j))
    have hK1 := norm_Kop_le (n j + 1) hdc hx
    have hmono : (∫ t in (0 : ℝ)..1, ‖extD (B j) (t • x)‖) ≤
        max (Cj j) 0 * ∫ t in (0 : ℝ)..1, ‖Bv (t • x)‖ := by
      rw [← intervalIntegral.integral_const_mul]
      apply intervalIntegral.integral_mono_on zero_le_one
      · apply ContinuousOn.intervalIntegrable
        rw [Set.uIcc_of_le zero_le_one]
        exact (hdc.comp (continuous_id.smul continuous_const).continuousOn
          (fun t ht => smul_mem_simplex hx ht)).norm
      · apply ContinuousOn.intervalIntegrable
        rw [Set.uIcc_of_le zero_le_one]
        exact continuousOn_const.mul (hcont x hx).norm
      · intro t ht
        exact (hCj j _ (smul_mem_simplex hx ht)).trans
          (mul_le_mul_of_nonneg_right (le_max_left _ _) (norm_nonneg _))
    have hsum : max (Cj j) 0 ≤ ∑ j, max (Cj j) 0 :=
      Finset.single_le_sum (f := fun j => max (Cj j) 0) (fun j _ => le_max_right _ _)
        (Finset.mem_univ j)
    show ‖B j x‖ ≤ _
    rw [hrep]
    calc ‖Kop (n j + 1) (extD (B j)) x‖
        ≤ ‖cB m‖ * ‖x‖ * ∫ t in (0 : ℝ)..1, ‖extD (B j) (t • x)‖ := hK1
      _ ≤ ‖cB m‖ * ‖x‖ * (max (Cj j) 0 * ∫ t in (0 : ℝ)..1, ‖Bv (t • x)‖) :=
          mul_le_mul_of_nonneg_left hmono (mul_nonneg (cB m).opNorm_nonneg (norm_nonneg x))
      _ ≤ ‖cB m‖ * ‖x‖ * ((∑ j, max (Cj j) 0) * ∫ t in (0 : ℝ)..1, ‖Bv (t • x)‖) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hsum hI0) (mul_nonneg (cB m).opNorm_nonneg (norm_nonneg x))
      _ = C * ‖x‖ * ∫ t in (0 : ℝ)..1, ‖Bv (t • x)‖ := by rw [hCdef]; ring
  have hz := IntLInfty.Kan.wedge_continuous_bilinear.2 (fun x hx t ht => smul_mem_simplex hx ht)
    Bv hBc hM hC0 key
  intro j x hx
  exact congrFun (hz x hx) j

theorem extPow_eq_zero_of_lt {V : Type} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
    {p : ℕ} (hp : Module.finrank ℝ V < p) {a : ExteriorAlgebra ℝ V} (ha : a ∈ ⋀[ℝ]^p V) :
    a = 0 := by
  rw [← ExteriorAlgebra.ιMulti_span_fixedDegree] at ha
  induction ha using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨v, rfl⟩ := hy
    apply AlternatingMap.map_linearDependent
    intro hli
    have := hli.fintype_card_le_finrank
    simp at this
    omega
  | zero => rfl
  | add x y _ _ hx hy => rw [hx, hy, add_zero]
  | smul c x _ hx => rw [hx, smul_zero]

end Defect

/-! ### Integrality via the cone operator (source A83IntegK), for arbitrary lift data `f`, `Φ`. -/

section IntegK

variable {m r : ℕ} {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]

theorem alg_eq_zero_of_lt {p : ℕ} (hp : m < p) {a : Alg m}
    (ha : a ∈ ⋀[ℝ]^p (Module.Dual ℝ (Fin m → ℝ))) : a = 0 :=
  extPow_eq_zero_of_lt (by rw [Subspace.dual_finrank_eq, Module.finrank_fin_fun]; exact hp) ha

/-- Pointwise generator-degree data. -/
def GenHom (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) : Prop :=
  ∀ i ξ x, f i ξ x ∈ ⋀[ℝ]^(i + 1) (Module.Dual ℝ (Fin m → ℝ))

theorem lift_mem_deg (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f)
    (Φ : CE L →ₐ[ℝ] Ω m) (hΦ : ∀ i (ξ : Module.Dual ℝ (L i)), Φ (gen L i ξ) = f i ξ) {p : ℕ}
    {a : CE L} (ha : a ∈ ceDeg L p) (x : Fin m → ℝ) :
    Φ a x ∈ ⋀[ℝ]^p (Module.Dual ℝ (Fin m → ℝ)) := by
  induction ha using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨k, d, ξ, hsum, rfl⟩ := hy
    let ψ : CE L →ₐ[ℝ] Alg m :=
      (Pi.evalAlgHom ℝ (fun _ : Fin m → ℝ => Alg m) x).comp Φ
    have e : ∀ c : CE L, Φ c x = ψ c := fun c => rfl
    rw [e, map_list_prod, List.map_ofFn, ← hsum, ← List.sum_ofFn]
    refine SetLike.list_prod_ofFn_mem_graded
      (A := fun i : ℕ => ⋀[ℝ]^i (Module.Dual ℝ (Fin m → ℝ))) (fun t => d t + 1) _ fun t => ?_
    show Φ (gen L (d t) (ξ t)) x ∈ _
    rw [hΦ]
    exact hf _ _ x
  | zero => simp only [map_zero, Pi.zero_apply]; exact Submodule.zero_mem _
  | add a b _ _ ha hb => simp only [map_add, Pi.add_apply]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => simp only [map_smul, Pi.smul_apply]; exact Submodule.smul_mem _ c ha

theorem isCr_sum (hr : 1 ≤ r) {ι : Type} (s : Finset ι) (ϖ : ι → Ω m)
    (h : ∀ k ∈ s, IsCr r (ϖ k)) : IsCr r (∑ k ∈ s, ϖ k) :=
  Finset.sum_induction _ (IsCr r) (fun _ _ ha hb => isCr_add hr ha hb) isCr_zero h

variable [∀ i, FiniteDimensional ℝ (L i)]

/-- The basis-generator defects of the lift `Φ` of `f`. -/
noncomputable def defB (δ : LInfty L) (S : GenSys L) (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m)
    (Φ : CE L →ₐ[ℝ] Ω m) (j : Σ t : Fin m, Fin (Module.finrank ℝ (S t))) : Ω m :=
  extD (f j.1 (genBasis S j.1 j.2 : Module.Dual ℝ (L j.1))) -
    Φ (δ.δ (gen L j.1 (genBasis S j.1 j.2 : Module.Dual ℝ (L j.1))))

theorem gen_defect_bound (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L)
    (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f)
    (Φ : CE L →ₐ[ℝ] Ω m) (hΦ : ∀ i (ξ : Module.Dual ℝ (L i)), Φ (gen L i ξ) = f i ξ)
    (hcr : ∀ i ξ, IsCr r (f i ξ)) (hz : ∀ i, m ≤ i → ∀ ξ, f i ξ = 0)
    (i : ℕ) (ξ : Module.Dual ℝ (L i)) (hξ : ξ ∈ S i) :
    ∃ C : ℝ, ∀ x ∈ simplex m, ‖extD (f i ξ) x - Φ (δ.δ (gen L i ξ)) x‖ ≤
      C * ‖(fun j => defB δ S f Φ j x : (Σ t : Fin m, Fin (Module.finrank ℝ (S t))) → Alg m)‖ := by
  by_cases h : i < m
  · let Q : Module.Dual ℝ (L i) → Prop := fun η => ∃ C : ℝ, ∀ x ∈ simplex m,
      ‖extD (f i η) x - Φ (δ.δ (gen L i η)) x‖ ≤
        C * ‖(fun j => defB δ S f Φ j x : (Σ t : Fin m, Fin (Module.finrank ℝ (S t))) → Alg m)‖
    have hQadd : ∀ a b, Q a → Q b → Q (a + b) := by
      rintro a b ⟨Ca, ha⟩ ⟨Cb, hb⟩
      refine ⟨Ca + Cb, fun x hx => ?_⟩
      have e1 : extD (f i (a + b)) x = extD (f i a) x + extD (f i b) x := by
        rw [map_add]; exact extD_add hr (hcr i a) (hcr i b) hx
      have e2 : Φ (δ.δ (gen L i (a + b))) x =
          Φ (δ.δ (gen L i a)) x + Φ (δ.δ (gen L i b)) x := by
        simp only [map_add, Pi.add_apply]
      rw [e1, e2]
      calc _ = ‖(extD (f i a) x - Φ (δ.δ (gen L i a)) x) +
              (extD (f i b) x - Φ (δ.δ (gen L i b)) x)‖ := by congr 1; abel
        _ ≤ _ := norm_add_le _ _
        _ ≤ _ := add_le_add (ha x hx) (hb x hx)
        _ = _ := by ring
    have hQsmul : ∀ (c : ℝ) a, Q a → Q (c • a) := by
      rintro c a ⟨Ca, ha⟩
      refine ⟨|c| * Ca, fun x hx => ?_⟩
      have e1 : extD (f i (c • a)) x = c • extD (f i a) x := by
        rw [map_smul]; exact extD_smul hr c (hcr i a) hx
      have e2 : Φ (δ.δ (gen L i (c • a))) x = c • Φ (δ.δ (gen L i a)) x := by
        simp only [map_smul, Pi.smul_apply]
      rw [e1, e2, ← smul_sub, norm_smul, Real.norm_eq_abs, mul_assoc]
      exact mul_le_mul_of_nonneg_left (ha x hx) (abs_nonneg c)
    have hQ0 : Q 0 := ⟨0, fun x hx => by
      have e : f i 0 = 0 := map_zero _
      rw [e, extD_zero' hr hx]; simp⟩
    have hQb : ∀ k, Q (genBasis S i k : Module.Dual ℝ (L i)) := fun k => ⟨1, fun x hx => by
      rw [one_mul]
      exact norm_le_pi_norm (fun j => defB δ S f Φ j x :
        (Σ t : Fin m, Fin (Module.finrank ℝ (S t))) → Alg m) ⟨⟨i, h⟩, k⟩⟩
    have hsum : (∑ k, (genBasis S i).repr ⟨ξ, hξ⟩ k • (genBasis S i k : Module.Dual ℝ (L i))) = ξ := by
      have := congrArg Subtype.val ((genBasis S i).sum_repr ⟨ξ, hξ⟩)
      rw [Submodule.coe_sum] at this
      simp only [Submodule.coe_smul] at this
      exact this
    have key : Q (∑ k, (genBasis S i).repr ⟨ξ, hξ⟩ k • (genBasis S i k : Module.Dual ℝ (L i))) :=
      Finset.sum_induction _ Q hQadd hQ0 (fun k _ => hQsmul _ _ (hQb k))
    rw [hsum] at key
    exact key
  · refine ⟨0, fun x hx => ?_⟩
    have e1 : Φ (δ.δ (gen L i ξ)) x = 0 :=
      alg_eq_zero_of_lt (p := i + 1 + 1) (by omega)
        (lift_mem_deg f hf Φ hΦ (δ.deg _ _ (gen_mem_ceDeg i ξ)) x)
    rw [hz i (by omega) ξ, extD_zero' hr hx, e1]; simp

theorem isDGAMap_of_K (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L)
    (hcl : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S)
    (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f)
    (Φ : CE L →ₐ[ℝ] Ω m) (hΦ : ∀ i (ξ : Module.Dual ℝ (L i)), Φ (gen L i ξ) = f i ξ)
    (hcr : ∀ i ξ, IsCr r (f i ξ)) (hz : ∀ i, m ≤ i → ∀ ξ, f i ξ = 0)
    (hK : ∀ j : Σ t : Fin m, Fin (Module.finrank ℝ (S t)),
      FormEqOn (Kop ((j.1 : ℕ) + 1) (defB δ S f Φ j)) 0) :
    IsDGAMap r δ S m (Φ.comp (genAlg L S).val) := by
  have hdeg : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → IsDeg (i + 1) (Φ (gen L i ξ)) :=
    fun i ξ _ x _ => by rw [hΦ]; exact hf i ξ x
  have hcrΦ : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → IsCr r (Φ (gen L i ξ)) :=
    fun i ξ _ => by rw [hΦ]; exact hcr i ξ
  have hgb := fun i ξ hξ => gen_defect_bound hr δ S f hf Φ hΦ hcr hz i ξ hξ
  have hdb := fun a ha => defect_bound hr δ S Φ hdeg hcrΦ
    (fun x => ‖(fun j => defB δ S f Φ j x : (Σ t : Fin m, Fin (Module.finrank ℝ (S t))) → Alg m)‖)
    (fun i ξ hξ => by
      obtain ⟨C, hC⟩ := hgb i ξ hξ
      exact ⟨C, fun x hx => by rw [hΦ]; exact hC x hx⟩) a ha
  have dd0 : ∀ y, δ.δ (δ.δ y) = 0 := fun y => by simpa using LinearMap.congr_fun δ.sq y
  have hvan := defect_vanish hr
    (fun j : (Σ t : Fin m, Fin (Module.finrank ℝ (S t))) => (j.1 : ℕ) + 1) (defB δ S f Φ)
    (fun j => isCr_sub hr (isCr_extD hr (hcr _ _)) (hdb _ (hcl _ _ (genBasis S j.1 j.2).2)).1)
    (fun j => isDeg_sub (isDeg_extD hr (hcr _ _) (fun x _ => hf _ _ x))
      (fun x _ => lift_mem_deg f hf Φ hΦ (δ.deg _ _ (gen_mem_ceDeg _ _)) x))
    hK
    (fun j => by
      obtain ⟨C, hC⟩ := (hdb _ (hcl _ _ (genBasis S j.1 j.2).2)).2
      refine ⟨C, fun x hx => ?_⟩
      have e : extD (defB δ S f Φ j) x =
          -(extD (Φ (δ.δ (gen L j.1 (genBasis S j.1 j.2 : Module.Dual ℝ (L j.1))))) x -
            Φ (δ.δ (δ.δ (gen L j.1 (genBasis S j.1 j.2 : Module.Dual ℝ (L j.1)))))
              x) := by
        simp only [defB]
        rw [extD_sub hr (isCr_extD hr (hcr _ _))
            (hdb _ (hcl _ _ (genBasis S j.1 j.2).2)).1 hx,
          A83.extD_extD hr (hcr _ _) x hx, dd0, map_zero, Pi.zero_apply, sub_zero, zero_sub]
      rw [e, norm_neg]
      exact hC x hx)
  refine IntLInfty.Kan.generator_lift_dga.2.2.1 hr δ S Φ hdeg hcrΦ (fun i ξ hξ x hx => ?_)
  obtain ⟨C, hC⟩ := hgb i ξ hξ
  have hN : ‖(fun j => defB δ S f Φ j x :
      (Σ t : Fin m, Fin (Module.finrank ℝ (S t))) → Alg m)‖ = 0 := by
    rw [norm_eq_zero]; funext j; exact hvan j x hx
  have h1 := hC x hx
  rw [hN, mul_zero] at h1
  rw [hΦ]
  exact sub_eq_zero.mp (norm_le_zero_iff.mp h1)

theorem integ_of_K (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L)
    (hcl : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S) (z : Amb r S m)
    (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f)
    (hcr : ∀ i ξ, IsCr r (f i ξ)) (hz : ∀ i, m ≤ i → ∀ ξ, f i ξ = 0)
    (hjet : ∀ (t : Fin m) (k : Fin (Module.finrank ℝ (S t))),
      jet r (f t (genBasis S t k)) = (z t k : Jet r m × Jet r m))
    (Φ : CE L →ₐ[ℝ] Ω m) (hΦ : ∀ i (ξ : Module.Dual ℝ (L i)), Φ (gen L i ξ) = f i ξ)
    (hK : ∀ j : Σ t : Fin m, Fin (Module.finrank ℝ (S t)),
      FormEqOn (Kop ((j.1 : ℕ) + 1) (defB δ S f Φ j)) 0) :
    z ∈ integ r δ S m :=
  ⟨Φ.comp (genAlg L S).val, isDGAMap_of_K hr δ S hcl f hf Φ hΦ hcr hz hK,
    fun t k => by
      show _ = jet r (Φ (gen L t (genBasis S t k)))
      rw [hΦ]; exact (hjet t k).symm⟩

theorem genVal_eqOn_of_integ (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (z : Amb r S m)
    (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m)
    (hcr : ∀ i ξ, IsCr r (f i ξ)) (hz0 : ∀ i, m ≤ i → ∀ ξ, f i ξ = 0)
    (hjet : ∀ (t : Fin m) (k : Fin (Module.finrank ℝ (S t))),
      jet r (f t (genBasis S t k)) = (z t k : Jet r m × Jet r m))
    (φ : genAlg L S →ₐ[ℝ] Ω m) (hφ : IsDGAMap r δ S m φ)
    (hz : ∀ (t : Fin m) (k : Fin (Module.finrank ℝ (S t))),
      (z t k : Jet r m × Jet r m) =
        jet r (φ ⟨gen L t (genBasis S t k), gen_mem_genAlg S (genBasis S t k).2⟩))
    (i : ℕ) (ξ : Module.Dual ℝ (L i)) (hξ : ξ ∈ S i) :
    FormEqOn (φ ⟨gen L i ξ, gen_mem_genAlg S hξ⟩) (f i ξ) := by
  by_cases h : i < m
  · let R : Module.Dual ℝ (L i) → Prop := fun η => ∃ hη : η ∈ S i,
      FormEqOn (φ ⟨gen L i η, gen_mem_genAlg S hη⟩) (f i η)
    have hRadd : ∀ a b, R a → R b → R (a + b) := by
      rintro a b ⟨ha, hae⟩ ⟨hb, hbe⟩
      refine ⟨(S i).add_mem ha hb, fun x hx => ?_⟩
      have e : (⟨gen L i (a + b), gen_mem_genAlg S ((S i).add_mem ha hb)⟩ : genAlg L S) =
          ⟨gen L i a, gen_mem_genAlg S ha⟩ + ⟨gen L i b, gen_mem_genAlg S hb⟩ :=
        Subtype.ext (map_add (gen L i) a b)
      rw [e, map_add, map_add, Pi.add_apply, Pi.add_apply, hae x hx, hbe x hx]
    have hRsmul : ∀ (c : ℝ) a, R a → R (c • a) := by
      rintro c a ⟨ha, hae⟩
      refine ⟨(S i).smul_mem c ha, fun x hx => ?_⟩
      have e : (⟨gen L i (c • a), gen_mem_genAlg S ((S i).smul_mem c ha)⟩ : genAlg L S) =
          c • (⟨gen L i a, gen_mem_genAlg S ha⟩ : genAlg L S) :=
        Subtype.ext (map_smul (gen L i) c a)
      rw [e, map_smul, map_smul, Pi.smul_apply, Pi.smul_apply, hae x hx]
    have hR0 : R 0 := ⟨(S i).zero_mem, fun x hx => by
      have e : (⟨gen L i 0, gen_mem_genAlg S (S i).zero_mem⟩ : genAlg L S) = 0 :=
        Subtype.ext (map_zero (gen L i))
      rw [e, map_zero, map_zero]⟩
    have hRb : ∀ k, R (genBasis S i k : Module.Dual ℝ (L i)) := fun k =>
      ⟨(genBasis S i k).2, A83.formEqOn_of_jet (hφ.2.1 _) (hcr i _) (by
        have e1 := hjet ⟨i, h⟩ k
        have e2 := hz ⟨i, h⟩ k
        exact e2.symm.trans e1.symm)⟩
    have hsum : (∑ k, (genBasis S i).repr ⟨ξ, hξ⟩ k •
        (genBasis S i k : Module.Dual ℝ (L i))) = ξ := by
      have := congrArg Subtype.val ((genBasis S i).sum_repr ⟨ξ, hξ⟩)
      rw [Submodule.coe_sum] at this
      simp only [Submodule.coe_smul] at this
      exact this
    have key : R (∑ k, (genBasis S i).repr ⟨ξ, hξ⟩ k • (genBasis S i k : Module.Dual ℝ (L i))) :=
      Finset.sum_induction _ R hRadd hR0 (fun k _ => hRsmul _ _ (hRb k))
    rw [hsum] at key
    obtain ⟨_, hk⟩ := key
    exact hk
  · intro x hx
    rw [hz0 i (by omega) ξ, Pi.zero_apply]
    exact alg_eq_zero_of_lt (p := i + 1) (by omega) (hφ.1 i ξ hξ x hx)

theorem K_of_integ (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L)
    (hcl : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S) (z : Amb r S m)
    (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m)
    (hcr : ∀ i ξ, IsCr r (f i ξ)) (hz0 : ∀ i, m ≤ i → ∀ ξ, f i ξ = 0)
    (hjet : ∀ (t : Fin m) (k : Fin (Module.finrank ℝ (S t))),
      jet r (f t (genBasis S t k)) = (z t k : Jet r m × Jet r m))
    (Φ : CE L →ₐ[ℝ] Ω m) (hΦ : ∀ i (ξ : Module.Dual ℝ (L i)), Φ (gen L i ξ) = f i ξ)
    (hzI : z ∈ integ r δ S m) (j : Σ t : Fin m, Fin (Module.finrank ℝ (S t))) :
    FormEqOn (Kop ((j.1 : ℕ) + 1) (defB δ S f Φ j)) 0 := by
  obtain ⟨φ, hφ, hz⟩ := hzI
  have hg := fun i ξ hξ => genVal_eqOn_of_integ hr δ S z f hcr hz0 hjet φ hφ hz i ξ hξ
  have hall : ∀ a (ha : a ∈ Algebra.adjoin ℝ (⋃ i, (gen L i : Module.Dual ℝ (L i) → CE L) ''
      (S i : Set (Module.Dual ℝ (L i))))),
      FormEqOn (φ ⟨a, ha⟩) (Φ a) := by
    intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem y hy =>
      obtain ⟨i, ξ, hξ, rfl⟩ := Set.mem_iUnion.1 hy
      intro x hx
      rw [hΦ]
      exact hg i ξ hξ x hx
    | algebraMap c =>
      intro x hx
      exact congrFun ((φ.commutes c).trans (Φ.commutes c).symm) x
    | add y w hy hw ihy ihw =>
      intro x hx
      change φ (⟨y, hy⟩ + ⟨w, hw⟩) x = Φ (y + w) x
      rw [map_add, map_add, Pi.add_apply, Pi.add_apply, ihy x hx, ihw x hx]
    | mul y w hy hw ihy ihw =>
      intro x hx
      change φ (⟨y, hy⟩ * ⟨w, hw⟩) x = Φ (y * w) x
      rw [map_mul, map_mul, Pi.mul_apply, Pi.mul_apply, ihy x hx, ihw x hx]
  have hB : FormEqOn (defB δ S f Φ j) 0 := fun x hx => by
    have hb := (genBasis S j.1 j.2).2
    have e1 := (extD_congr (hg _ _ hb)) x hx
    have e2 := hφ.2.2 ⟨gen L j.1 (genBasis S j.1 j.2), gen_mem_genAlg S hb⟩
      ⟨δ.δ (gen L j.1 (genBasis S j.1 j.2)), hcl _ _ hb⟩ rfl x hx
    have e3 := hall _ (hcl _ _ hb) x hx
    simp only [defB, Pi.sub_apply, Pi.zero_apply]
    rw [← e1, e2, e3]
    exact sub_self _
  intro x hx
  rw [Kop_congr _ hB x hx, Kop_zero]

theorem integ_iff_K (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L)
    (hcl : ∀ i (ξ : Module.Dual ℝ (L i)), ξ ∈ S i → δ.δ (gen L i ξ) ∈ genAlg L S) (z : Amb r S m)
    (f : ∀ i, Module.Dual ℝ (L i) →ₗ[ℝ] Ω m) (hf : GenHom f)
    (hcr : ∀ i ξ, IsCr r (f i ξ)) (hz0 : ∀ i, m ≤ i → ∀ ξ, f i ξ = 0)
    (hjet : ∀ (t : Fin m) (k : Fin (Module.finrank ℝ (S t))),
      jet r (f t (genBasis S t k)) = (z t k : Jet r m × Jet r m))
    (Φ : CE L →ₐ[ℝ] Ω m) (hΦ : ∀ i (ξ : Module.Dual ℝ (L i)), Φ (gen L i ξ) = f i ξ) :
    z ∈ integ r δ S m ↔ ∀ j : Σ t : Fin m, Fin (Module.finrank ℝ (S t)), ∀ x ∈ simplex m,
      Kop ((j.1 : ℕ) + 1) (extD (f j.1 (genBasis S j.1 j.2)) -
        Φ (δ.δ (gen L j.1 (genBasis S j.1 j.2)))) x = 0 :=
  ⟨fun h j x hx => K_of_integ hr δ S hcl z f hcr hz0 hjet Φ hΦ h j x hx,
    fun h => integ_of_K hr δ S hcl z f hf hcr hz0 hjet Φ hΦ fun j x hx => h j x hx⟩

end IntegK

