open Filter Topology
open scoped ContDiff
open Matrix
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
variable {n : ℕ}
theorem solution {U : Set (Pt 4)} {g gi : Metric 4} {F : TwoForm 4}
    (hcert : EinsteinMaxwellCertificate g gi F U) {ξ : Fin 4 → Pt 4 → ℝ} (hξ : ∀ k, ContDiffOn ℝ ∞ (ξ k) U)
    {x : Pt 4} (hx : x ∈ U) :
    (∀ a b, linEinstein g gi F (lieCov2 ξ g) (lieCov2 ξ F) a b x = 0) ∧
    (∀ b, linMaxwell g gi F (lieCov2 ξ g) (lieCov2 ξ F) b x = 0) ∧
    (∀ a b c, linFaraday (lieCov2 ξ F) a b c x = 0) := by
  have hU := hcert.isOpen
  have hm : MetricData g gi U := ⟨hU, hcert.symm, hcert.inv, hcert.smooth, hcert.smooth_inv⟩
  set W := shiftDom U ξ with hW
  have hWo : IsOpen W := isOpen_shiftDom hU hξ
  -- the family
  have hfam : FamilyData (pullCov ξ g) (pullInv ξ gi) (pullCov ξ F) W :=
    { isOpen := hWo
      smooth := fun i j => contDiffOn_pullCov_joint hU hξ hcert.smooth i j
      smooth_F := fun i j => contDiffOn_pullCov_joint hU hξ hcert.smooth_F i j
      inv := by
        intro p hp
        have hc := coordChange_shift hU hξ p.1
        have hy : p.2 ∈ {y | (p.1, y) ∈ W} := hp
        have hJK := hc.mul_inv p.2 hy
        have hKJ := hc.inv_mul hy
        have hgg := hcert.inv _ hp.2.1
        have e1 : metricMatrix (pullInv ξ gi p.1) p.2 = (shiftJac ξ p.1 p.2)⁻¹ *
            metricMatrix gi (shiftMap ξ p.1 p.2) * ((shiftJac ξ p.1 p.2)⁻¹)ᵀ := by ext; rfl
        have e2 : metricMatrix (pullCov ξ g p.1) p.2 = (shiftJac ξ p.1 p.2)ᵀ *
            metricMatrix g (shiftMap ξ p.1 p.2) * shiftJac ξ p.1 p.2 := by ext; rfl
        have h2 : ((shiftJac ξ p.1 p.2)⁻¹)ᵀ * (shiftJac ξ p.1 p.2)ᵀ = 1 := by
          rw [← Matrix.transpose_mul, hJK, Matrix.transpose_one]
        rw [e1, e2]
        calc (shiftJac ξ p.1 p.2)⁻¹ * metricMatrix gi (shiftMap ξ p.1 p.2) * ((shiftJac ξ p.1 p.2)⁻¹)ᵀ *
              ((shiftJac ξ p.1 p.2)ᵀ * metricMatrix g (shiftMap ξ p.1 p.2) * shiftJac ξ p.1 p.2)
            = (shiftJac ξ p.1 p.2)⁻¹ * metricMatrix gi (shiftMap ξ p.1 p.2) *
                (((shiftJac ξ p.1 p.2)⁻¹)ᵀ * (shiftJac ξ p.1 p.2)ᵀ) *
                metricMatrix g (shiftMap ξ p.1 p.2) * shiftJac ξ p.1 p.2 := by
              simp only [Matrix.mul_assoc]
          _ = (shiftJac ξ p.1 p.2)⁻¹ * (metricMatrix gi (shiftMap ξ p.1 p.2) *
                metricMatrix g (shiftMap ξ p.1 p.2)) * shiftJac ξ p.1 p.2 := by
              rw [h2, Matrix.mul_one]; simp only [Matrix.mul_assoc]
          _ = 1 := by rw [hgg, Matrix.mul_one, hKJ] }
  have ht : IsTangent (pullCov ξ g) (pullCov ξ F) W (lieCov2 ξ g) (lieCov2 ξ F) :=
    { metric := fun y hy i j => hasDerivAt_pullCov hU hcert.smooth ξ hy.1 i j
      field := fun y hy i j => hasDerivAt_pullCov hU hcert.smooth_F ξ hy.1 i j }
  -- every member of the family solves the equations on its slice (covariance)
  have hpb : ∀ p ∈ W, ∀ y ∈ {y | (p.1, y) ∈ W},
      (metricMatrix (pullCov ξ g p.1) y = (shiftJac ξ p.1 y)ᵀ * metricMatrix g (shiftMap ξ p.1 y) * shiftJac ξ p.1 y) ∧
      (metricMatrix (pullInv ξ gi p.1) y = (shiftJac ξ p.1 y)⁻¹ * metricMatrix gi (shiftMap ξ p.1 y) *
        ((shiftJac ξ p.1 y)⁻¹)ᵀ) ∧
      (metricMatrix (pullCov ξ F p.1) y = (shiftJac ξ p.1 y)ᵀ * metricMatrix F (shiftMap ξ p.1 y) * shiftJac ξ p.1 y) :=
    fun _ _ _ _ => ⟨by ext; rfl, by ext; rfl, by ext; rfl⟩
  have hx0 : ((0 : ℝ), x) ∈ W := zero_mem_shiftDom hx
  have hg0 := pullCov_zero ξ g
  have hgi0 := pullInv_zero ξ gi
  have hF0 := pullCov_zero ξ F
  refine ⟨fun a b => ?_, fun b => ?_, fun a b c => ?_⟩
  · have := linEinstein_eq_zero_of_onShell hfam ht (fun p hp i j => by
      have hc := coordChange_shift hU hξ p.1
      have e := congrFun (congrFun (einsteinMaxwell_transform hc hm
        (fun y hy => (hpb p hp y hy).1) (fun y hy => (hpb p hp y hy).2.1) (fun y hy => (hpb p hp y hy).2.2)
        (y := p.2) hp) i) j
      rw [Matrix.of_apply] at e
      rw [e, congr_entry]
      simp [hcert.einstein _ hp.2.1]) hx0 a b
    rwa [hg0, hgi0, hF0] at this
  · have := linMaxwell_eq_zero_of_onShell hfam ht (fun p hp j => by
      have hc := coordChange_shift hU hξ p.1
      rw [maxwellDiv_transform hc hm hcert.smooth_F (fun y hy => (hpb p hp y hy).1)
        (fun y hy => (hpb p hp y hy).2.1) (fun y hy => (hpb p hp y hy).2.2) (y := p.2) hp j]
      simp [hcert.maxwell _ hp.2.1]) hx0 b
    rwa [hg0, hgi0, hF0] at this
  · exact linFaraday_eq_zero_of_onShell hfam ht (fun p hp i j k => by
      have hc := coordChange_shift hU hξ p.1
      rw [faradayCyclic_transform hc hcert.smooth_F hcert.antisymm (fun y hy => (hpb p hp y hy).2.2)
        (y := p.2) hp i j k]
      simp [hcert.closed _ hp.2.1]) hx0 a b c
