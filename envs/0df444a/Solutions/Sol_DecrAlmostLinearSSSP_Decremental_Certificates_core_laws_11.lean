lemma toggle_running_frame (N : ℕ) (p : Program) : NatFrame (toggleCode N p) 650 :=
  ⟨⟨toggle_setup_running_frame,SourceCall.nat_even_frame N p.update p 650
    (by omega) (by decide) (by omega) (by omega)⟩,
    CoreReports.code_nat_frame 650 (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)⟩
lemma toggle_threshold_frame (N : ℕ) (p : Program) : RealFrame (toggleCode N p) 520 :=
  ⟨⟨toggle_setup_threshold_frame,SourceCall.real_even_frame N p.update p 520 (by omega) (by decide)⟩,
    CoreReports.code_real_frame 520⟩
