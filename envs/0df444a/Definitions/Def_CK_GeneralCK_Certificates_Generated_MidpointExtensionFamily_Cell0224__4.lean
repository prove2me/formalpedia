      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(1539/62500:ℝ)^2/24 < 2*(301/1000:ℝ)/(1-(301/1000:ℝ)^2)^2)
