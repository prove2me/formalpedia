theorem U_ge (W : ℕ) : 10 ^ 42 * (W + 40) ^ 2 ≤ U W := by
  unfold U
  exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by omega) (by norm_num))

theorem U_pos (W : ℕ) : 1 ≤ U W := Nat.mul_pos (by norm_num) (pow_pos (by omega) _)

theorem lin_U (W : ℕ) : 10 ^ 9 * (W + 40) ^ 2 ≤ U W :=
  le_trans (Nat.mul_le_mul_right _ (by norm_num)) (U_ge W)

theorem cT_U {e : Ex HS} (hs : e.size ≤ 1000) (W : ℕ) : cT e W ≤ U W := by
  unfold cT PJ.cE
  have h1 : (W + 1) * (2 * e.size) + 2 ≤ 2002 * (W + 40) := by nlinarith
  have h2 := Nat.pow_le_pow_left h1 2
  calc (e.size + 1) * 10 ^ 7 * ((W + 1) * (2 * e.size) + 2) ^ 2
      ≤ 1001 * 10 ^ 7 * (2002 * (W + 40)) ^ 2 :=
        Nat.mul_le_mul (Nat.mul_le_mul_right _ (by omega)) h2
    _ = 1001 * 10 ^ 7 * 4008004 * (W + 40) ^ 2 := by ring
    _ ≤ 10 ^ 42 * (W + 40) ^ 2 := Nat.mul_le_mul_right _ (by norm_num)
    _ ≤ U W := U_ge W

theorem cRep_U {W N cb : ℕ} (hN : N ≤ W) : J6A.PA.cRep W N cb ≤ (W + 1) * (cb + U W) := by
  unfold J6A.PA.cRep
  have d := lin_U W
  have : 2 * 2000 * (W + 2) + 32 ≤ U W := by nlinarith
  have : 8000 * (W + 2) + 30 ≤ U W := by nlinarith
