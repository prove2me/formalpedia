-- Source module: Solutions.J6AIL2
/-!
# A lines, IL side 2: copies and regrouping of line representations

* `dupL K L`: `K` copies of `L` concatenated (what the IL duplication leaves on stack `0`);
* **`LRep_cpy`**: `K = 2^f` copies of a `(pre, n, post)` array, followed by the two fine
  exposures `(1, K, N) → (1, N, K)` and `(pre, n·post, K) → (pre, K, n·post)`, are the
  `(pre, K·n, post)` array whose lines are `K` copies of the old lines;
* **`LRep_rgp`**: a `(pre, K·M·w, post)` array (`K = 2^f` classes of `M` windows of length `w`),
  after the exposures `(pre, K, M·w·post) → (pre, M·w·post, K)` and
  `(pre·M, w·post, K) → (pre·M, K, w·post)`, is the `(pre·(M·K), w, post)` array whose row
  `b·(M K) + j K + r` is window `j` of class `r` of line `b`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open IntMul.HvdH IntMul.HvdH.Ref

namespace J6A

open J6Seg

section lists
variable {α : Type*} [Inhabited α]

theorem length_dupL (K : ℕ) (L : List α) : (dupL K L).length = K * L.length := by
  unfold dupL
  rw [IntMul.HvdH.RefPf.length_flatten_uniform L.length]
  · simp
  · intro row hrow; rw [List.eq_of_mem_replicate hrow]

theorem dupL_getD (K : ℕ) (L : List α) {r a : ℕ} (hr : r < K) (ha : a < L.length) :
    (dupL K L).getD (r * L.length + a) default = L.getD a default := by
  unfold dupL
  rw [IntMul.HvdH.RefPf.flatten_getD_uniform L.length default _
    (fun row hrow => by rw [List.eq_of_mem_replicate hrow]) r (by simp; exact hr) a ha]
  rw [show (List.replicate K L).getD r [] = L by simp [List.getD_eq_getElem?_getD, hr]]

theorem LRep_cpy {K n post pre : ℕ} (hK : 0 < K) (hn : 0 < n) (hp : 0 < post) {L : List α}
    {φ : ℕ → ℕ → List α} (hL : LRep pre n post L φ) :
    LRep pre (K * n) post (cpy K n post pre L) (fun b c => dupL K (φ b c)) := by
  set N := pre * (n * post) with hN
  have hD : (dupL K L).length = K * N := by rw [length_dupL, hL.1]
  have hT1 : (blkTg K N 1 (dupL K L)).length = N * K := by rw [length_blkTg]; ring
  refine ⟨?_, fun b hb c hc => by rw [length_dupL, hL.2.1 b hb c hc], fun b hb a ha c hc => ?_⟩
  · unfold cpy; rw [length_blkTg]; ring
  -- `a = r n + a'`
  obtain ⟨r, a', rfl, ha'⟩ : ∃ r a', a = r * n + a' ∧ a' < n :=
    ⟨a / n, a % n, (Nat.div_add_mod' a n).symm, Nat.mod_lt _ hn⟩
  have hr : r < K := by
    by_contra h; push Not at h
    have : K * n ≤ r * n := Nat.mul_le_mul_right _ h
    omega
  have hap : a' * post + c < n * post := lt_mul_of_split ha' hc
  unfold cpy
  rw [show b * (K * n * post) + (r * n + a') * post + c =
      b * (K * (n * post)) + r * (n * post) + (a' * post + c) by ring,
    blkTg_getD (n * post) K pre _ hb hr hap]
  have hx : b * (n * post) + a' * post + c < N := idx3_lt hb ha' hc
  rw [show b * ((n * post) * K) + (a' * post + c) * K + r =
      0 * (N * K) + (b * (n * post) + a' * post + c) * K + r by ring,
    blkTg_getD K N 1 _ (by omega) hx hr]
  rw [show 0 * (K * N) + r * N + (b * (n * post) + a' * post + c) =
      r * L.length + (b * (n * post) + a' * post + c) by rw [hL.1]; ring,
    dupL_getD K L hr (by rw [hL.1]; exact hx), hL.2.2 b hb a' ha' c hc]
  rw [show r * n + a' = r * (φ b c).length + a' by rw [hL.2.1 b hb c hc],
    dupL_getD K _ hr (by rw [hL.2.1 b hb c hc]; exact ha')]

end lists

end J6A

end

section
-- Source module: Solutions.J6AIL6
/-!
# A lines, IL side 6: the per-axis pipeline at the list level

On a `(pre, t, post)` array the `A` line map of an axis is computed by six list passes, each of
which has an IL counterpart:

1. `cpy 32 t post pre`: the lines `X` become `dupL 32 X` (32 copies);
2. the **gather** slab pass `slabPass (32 t) (8 (M win)) post (srcG …)`: output slab
   `l = (r M + j) win + e` (`r < 8`, `j < M`, `e < win`) is, for `e < 2W`, the input
   `X[(jc_b - W + e) mod s]` of block `b = 8 j + r`, read from copy `4 r + c` (`c ∈ {0,1,2}` handles
   the wrap-around, `posE`), and `0` otherwise; inside a class `r` the windows of the blocks
   `r, r + 8, …` are disjoint and increasing, so the source is monotone;
3. `rgp 8 M win`: the windows become rows; row `b'` holds the window of block `b' % (8M)`;
4. the kernel pass `kerPass win post (pre·8M) (fun b => gK (b % 8M))` (`gK q` the per-block kernel
   `aKerL` with the tables of block `q`);
5. the **compress** slab pass `slabPass (8M win) t post srcC`: output `k` is entry `k % 2H` of
   row `k / 2H`.

**`pipeAL_rep`**: the result represents the lines `(range t).map (chirpC p s t α H U_X)`;
**`pipeAL_eq`**: the pipeline is `axisL t post` of that line map.
**`monoSrc_G`**, **`monoSrc_C`**: the two sources are monotone (the IL slab passes need this).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace J6A

open IntMul.HvdH J6Seg

/-! ## The sources -/

/-! ## Geometry -/

lemma jcB_nonneg (s t H k : ℕ) : 0 ≤ jcB s t H k := by unfold jcB; positivity

lemma jcB_le (s t H k : ℕ) (ht : 0 < t) (hk : kcB H k < t) : jcB s t H k ≤ s := by
  unfold jcB
  have : (2 * s * kcB H k + t) / (2 * t) ≤ s := by
    rw [Nat.div_le_iff_le_mul_add_pred (by omega)]
    have h1 : kcB H k + 1 ≤ t := hk
    have h2 := Nat.mul_le_mul_left (2 * s) h1
    rw [Nat.mul_add, mul_one] at h2
    have h3 : 2 * s * t = 2 * t * s := by ring
    omega
  exact_mod_cast this

/-! ## The gather source is monotone -/

section mono
variable {s t H W M win : ℕ}

lemma kc_lt (hH : 1 ≤ H) (ht : t = M * 8 * (2 * H)) {b : ℕ} (hb : b < 8 * M) :
    kcB H (kkA H b) < t := by
  unfold kcB kkA; rw [Nat.mul_div_cancel _ (by omega)]
  have : (b + 1) * (2 * H) ≤ 8 * M * (2 * H) := Nat.mul_le_mul_right _ hb
  rw [ht]; nlinarith

/-- The value of the gather source (window position `Q'`, offset `e`). -/
lemma srcG_val (hwin : 0 < win) {l : ℕ} (he : l % win < 2 * W) :
    srcG s t H W M win l = some (l / win / M * (4 * t) +
      posE s t (jcB s t H (kkA H (blkW M (l / win))) - W + ((l % win : ℕ) : ℤ))) := by
  unfold srcG; rw [if_pos he]

theorem monoSrc_C (hH : 1 ≤ H) (hbw : 2 * H ≤ win) {nb : ℕ} (ht : t = nb * (2 * H)) :
    MonoSrc (nb * win) t (srcC H win) := by
  refine ⟨fun l hl k hk => ?_, fun l₁ l₂ k₁ k₂ h12 hl₂ hk₁ hk₂ => ?_⟩
  · unfold srcC at hk
    rw [← Option.some.inj hk]
    have hq : l / (2 * H) < nb := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm, ← ht]; exact hl)
    have hr : l % (2 * H) < 2 * H := Nat.mod_lt _ (by omega)
    have : (l / (2 * H) + 1) * win ≤ nb * win := Nat.mul_le_mul_right _ hq
    rw [Nat.succ_mul] at this
    omega
  · unfold srcC at hk₁ hk₂
    rw [← Option.some.inj hk₁, ← Option.some.inj hk₂]
    have hqq : l₁ / (2 * H) ≤ l₂ / (2 * H) := Nat.div_le_div_right h12.le
    have hr1 : l₁ % (2 * H) < 2 * H := Nat.mod_lt _ (by omega)
    rcases Nat.lt_or_ge (l₁ / (2 * H)) (l₂ / (2 * H)) with h | h
    · have : (l₁ / (2 * H) + 1) * win ≤ l₂ / (2 * H) * win := Nat.mul_le_mul_right _ h
      rw [Nat.succ_mul] at this
      omega
    · have hq : l₁ / (2 * H) = l₂ / (2 * H) := le_antisymm hqq h
      have e1 := Nat.div_add_mod l₁ (2 * H)
      have e2 := Nat.div_add_mod l₂ (2 * H)
      rw [hq]
      have : l₁ % (2 * H) ≤ l₂ % (2 * H) := by
        rw [hq] at e1; omega
      omega

end mono

/-! ## The pipeline on representations -/

section rep
variable {β : Type*} [Inhabited β]

lemma joinC_getD (nc lam : ℕ) (ψ : ℕ → List β) (hψ : ∀ q < nc, (ψ q).length = lam)
    {q r : ℕ} (hq : q < nc) (hr : r < lam) :
    (joinC nc ψ).getD (q * lam + r) default = (ψ q).getD r default := by
  have hrows : ∀ row ∈ (List.range nc).map ψ, row.length = lam := by
    intro row hrow
    simp only [List.mem_map, List.mem_range] at hrow
    obtain ⟨q', hq', rfl⟩ := hrow
    exact hψ q' hq'
  unfold joinC
  rw [List.flatMap_def, IntMul.HvdH.RefPf.flatten_getD_uniform lam default _ hrows q
    (by simp; exact hq) r hr]
  rw [List.getD_eq_getElem _ [] (by simp; exact hq), List.getElem_map, List.getElem_range]

end rep

/-- The input entry of the extended index `j` read from three consecutive copies. -/
lemma dupL_posE (s t W : ℕ) (X : List (ℤ × ℤ)) (hX : X.length = t) (hWs : W ≤ s) (hst : s ≤ t)
    (r : ℕ) (hr : r < 8) {j : ℤ} (h0 : -(W : ℤ) ≤ j) (h1 : j < s + W) :
    (dupL 32 X).getD (r * (4 * t) + posE s t j) default =
      X.getD (j % (s : ℤ)).toNat default := by
  unfold posE
  split_ifs with ha hb
  · have e : j % (s : ℤ) = j + s := by
      rw [← Int.add_emod_right]
      exact Int.emod_eq_of_lt (by omega) (by omega)
    rw [e, show r * (4 * t) + ((s : ℤ) + j).toNat = 4 * r * X.length + ((s : ℤ) + j).toNat by
      rw [hX]; ring, dupL_getD 32 X (by omega) (by rw [hX]; omega), add_comm (s : ℤ) j]
  · have e : j % (s : ℤ) = j := Int.emod_eq_of_lt (by omega) hb
    rw [e, show r * (4 * t) + (t + j.toNat) = (4 * r + 1) * X.length + j.toNat by
      rw [hX]; ring, dupL_getD 32 X (by omega) (by rw [hX]; omega)]
  · have e : j % (s : ℤ) = j - s := by
      rw [← Int.sub_emod_right]
      exact Int.emod_eq_of_lt (by omega) (by omega)
    rw [e, show r * (4 * t) + (2 * t + (j - s).toNat) = (4 * r + 2) * X.length + (j - s).toNat by
      rw [hX]; ring, dupL_getD 32 X (by omega) (by rw [hX]; omega)]

lemma slabLine_getD_some {α β : Type*} [Inhabited α] [Inhabited β] {n' : ℕ}
    {src : ℕ → Option ℕ} {h : ℕ → α → β} {x : List α} {l k : ℕ} (hl : l < n')
    (hs : src l = some k) : (slabLine n' src h x).getD l default = h l (x.getD k default) := by
  unfold slabLine
  rw [List.getD_eq_getElem _ _ (by simp; exact hl), List.getElem_map, List.getElem_range, hs]

/-- **The pipeline represents the `A` lines.** -/
theorem pipeAL_rep_sol_aux (p s t α H pre post : ℕ) (hH : 1 ≤ H) {M : ℕ} (hM : 0 < M)
    (ht : t = M * 8 * (2 * H)) (hp : 0 < post) (hWs : WA p α H ≤ s) (hst : s ≤ t)
    (hsep : 2 * WA p α H * t ≤ 16 * H * s) (hWw : 2 * WA p α H ≤ 8 * H)
    {L : List (ℤ × ℤ)} {φ : ℕ → ℕ → List (ℤ × ℤ)} (hL : LRep pre t post L φ) :
    LRep pre t post (pipeAL p s t α H pre post L)
      (fun b c => (List.range t).map (chirpC p s t α H fun j => (φ b c).getD j (0, 0))) := by
  have hMd : t / (16 * H) = M := by
    rw [ht, show M * 8 * (2 * H) = M * (16 * H) by ring, Nat.mul_div_cancel _ (by omega)]
  unfold pipeAL
  rw [hMd]
  set W := WA p α H with hW
  set win := 8 * H with hwin
  have hwin0 : 0 < win := by omega
  have ht0 : 0 < t := by rw [ht]; positivity
  have h1 := LRep_cpy (K := 32) (by norm_num) ht0 hp hL
  have h2 := LRep_slabPass (n := 32 * t) (n' := 8 * (M * win)) (by positivity) hp h1
    (srcG s t H W M win) (fun _ z => z)
    (monoSrc_G hH hM hwin0 ht hWs hst hsep hWw).1
  have h3 := LRep_rgp (K := 8) (M := M) (w := win) (by norm_num) hM hwin0 hp h2
  have hgl : ∀ q (X : List (ℤ × ℤ)), X.length = win → (gK p s t α H win q X).length = win := by
    intro q X hX
    unfold gK
    exact length_aKerL _ _ _ _ _ _ _ X (by omega) (by simp [aTabA]) (by simp [cTabA]) (by omega)
  have h4 := LRep_kerPass hwin0 hp h3 (fun b => gK p s t α H win (b % (M * 8)))
    (fun b X hX => hgl _ X hX)
  have h5 := LRep_join hwin0 h4
  have h6 := LRep_slabPass (n := M * 8 * win) (n' := t) (by positivity) hp h5 (srcC H win)
    (fun _ z => z) (monoSrc_C (nb := M * 8) hH (by omega) ht).1
  refine LRep_congr h6 (fun b hb c hc => ?_)
  refine List.map_congr_left ?_
  intro l hl
  rw [List.mem_range] at hl
  simp only [srcC]
  have h2H : 0 < 2 * H := by omega
  have hq : l / (2 * H) < M * 8 := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm, ← ht]; exact hl)
  have hκ : l % (2 * H) < 2 * H := Nat.mod_lt _ h2H
  set q := l / (2 * H) with hqd
  set κ := l % (2 * H) with hκd
  have hbq : b * (M * 8) + q < pre * (M * 8) := by
    have : (b + 1) * (M * 8) ≤ pre * (M * 8) := Nat.mul_le_mul_right _ hb
    rw [Nat.succ_mul] at this; omega
  have hrow := h3.2.1 _ hbq c hc
  rw [joinC_getD (M * 8) win _ (fun q' hq' => by
      have : b * (M * 8) + q' < pre * (M * 8) := by
        have : (b + 1) * (M * 8) ≤ pre * (M * 8) := Nat.mul_le_mul_right _ hb
        rw [Nat.succ_mul] at this; omega
      exact hgl _ _ (h3.2.1 _ this c hc)) hq (by omega)]
  have em : (b * (M * 8) + q) % (M * 8) = q := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hq]
  have ed : (b * (M * 8) + q) / (M * 8) = b := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by positivity), Nat.div_eq_of_lt hq, zero_add]
  have e8 : (b * (M * 8) + q) % 8 = q % 8 := by
    rw [show b * (M * 8) + q = q + b * M * 8 by ring, Nat.add_mul_mod_self_right]
  simp only [em, ed, e8] at hrow ⊢
  -- the window of block `q`
  set Q' := q % 8 * M + q / 8 with hQ'
  have hq8 : q / 8 < M := Nat.div_lt_of_lt_mul (by rw [Nat.mul_comm]; exact hq)
  have hr8 : q % 8 < 8 := Nat.mod_lt _ (by norm_num)
  have hQM : Q' / M = q % 8 := by
    rw [hQ', Nat.add_comm, Nat.add_mul_div_right _ _ hM, Nat.div_eq_of_lt hq8, zero_add]
  have hQm : Q' % M = q / 8 := by
    rw [hQ', Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hq8]
  have hblk : blkW M Q' = q := by
    unfold blkW; rw [hQM, hQm]; omega
  have hQ8 : Q' < 8 * M := by
    have : q % 8 * M + M ≤ 8 * M := by
      have := Nat.mul_le_mul_right M (show q % 8 + 1 ≤ 8 by omega)
      rw [Nat.succ_mul] at this; exact this
    omega
  set X := φ b c with hX
  have hXl : X.length = t := hL.2.1 b hb c hc
  set U : ℕ → ℤ × ℤ := fun j => X.getD j (0, 0) with hU
  have hjc0 := jcB_nonneg s t H (kkA H q)
  have hjc1 := jcB_le s t H (kkA H q) ht0 (kc_lt hH ht (by omega))
  have hx : ∀ i < 2 * W, ((slabLine (8 * (M * win)) (srcG s t H W M win) (fun _ z => z)
      (dupL 32 X)).drop (Q' * win) |>.take win).getD i (0, 0) =
        U ((jcB s t H (kkA H q) - W + i) % (s : ℤ)).toNat := by
    intro i hi
    have hiw : i < win := by omega
    have hl' : Q' * win + i < 8 * (M * win) := by
      have : (Q' + 1) * win ≤ 8 * M * win := Nat.mul_le_mul_right _ hQ8
      rw [Nat.succ_mul] at this; nlinarith
    have hdiv : (Q' * win + i) / win = Q' := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hwin0, Nat.div_eq_of_lt hiw, zero_add]
    have hmod : (Q' * win + i) % win = i := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hiw]
    have hsrc := srcG_val (s := s) (t := t) (H := H) (M := M) hwin0 (l := Q' * win + i)
      (by rw [hmod]; exact hi)
    rw [hdiv, hmod, hQM, hblk] at hsrc
    show ((slabLine (8 * (M * win)) (srcG s t H W M win) (fun _ z => z)
      (dupL 32 X)).drop (Q' * win) |>.take win).getD i default = _
    rw [getD_drop_take _ _ _ _ hiw, slabLine_getD_some hl' hsrc]
    rw [dupL_posE s t W X hXl hWs hst _ hr8 (by omega) (by omega)]
    rfl
  have hk := aKer_chirp p s t α H q win hH U _ (by rw [hrow]; omega) hx hκ
  show (gK p s t α H win q _).getD κ default = _
  unfold gK
  rw [show (default : ℤ × ℤ) = (0, 0) from rfl, hk, hqd, hκd, show kkA H (l / (2 * H)) =
    l / (2 * H) * (2 * H) from rfl, Nat.div_add_mod' l (2 * H)]

end J6A

