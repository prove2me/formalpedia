def copyWeight (D : ℕ) (i : Fin ((D+1)/2)) : ℚ :=
  1 / ((copyLabel i).factorial * (D-copyLabel i).factorial : ℕ)

def middleRational (D : ℕ) : Matrix (Fin ((D+1)/2)) (Fin ((D+1)/2)) ℚ :=
  Matrix.diagonal (fun i => ((if copyLabel i = 1 then 2 else 0) + (3/10^6 : ℚ)) *
