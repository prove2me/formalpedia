-- title:
--   Proposition 2.2(a) — ⟨R(H), δ_{α,x,y}⟩ is vertex-transitive for every δ_{α,x,y} ∈ I
-- statement:
--   Let $H$ be a finite group and $\Gamma = \mathrm{BiCay}(H,R,L,S)$ a connected bi-Cayley graph. Let $\alpha \in \mathrm{Aut}(H)$ and $x, y \in H$ satisfy
--   $$R^\alpha = x^{-1}Lx,\qquad L^\alpha = y^{-1}Ry,\qquad S^\alpha = y^{-1}S^{-1}x,$$
--   so that $\delta_{\alpha,x,y} \in \mathrm{I}$. Then $\delta_{\alpha,x,y}$ is an automorphism $\delta$ of $\Gamma$, and the subgroup $\langle R(H), \delta\rangle$ of $\mathrm{Aut}(\Gamma)$ acts transitively on the vertex set $H_0 \cup H_1$.
--
--   It is how a single element of $\mathrm{I}$ yields vertex-transitivity of the normaliser of $R(H)$, which interchanges the two orbits $H_0$ and $H_1$ of $R(H)$.
--
--   **Formalization Note** The conclusion supplies an automorphism $\delta$ whose vertex map is $\delta_{\alpha,x,y}$; its existence is also part of Proposition 2.2. $\langle R(H),\delta\rangle$ is the subgroup generated by $\delta$ and all $R(g)$.
-- source:
--   Conder, Zhou, Feng and Zhang, Edge-transitive bi-Cayley graphs, arXiv:1606.04625v1, p. 5, Proposition 2.2(a)

import Mathlib
import Definitions.Def_EdgeTransBiCayley_TwoArc_Setting
open Pointwise

namespace EdgeTransBiCayley.TwoArc

theorem proposition_2_2_a {H : Type*} [Group H] [Fintype H] [DecidableEq H]
    (D : BiCayData H) (hconn : D.graph.Connected)
    (α : MulAut H) (x y : H) (hI : IsI D α x y) :
    ∃ δ : D.graph ≃g D.graph,
      (∀ v, δ v = deltaPerm α x y v) ∧
      IsVertexTransitiveOn D.graph
        (Subgroup.closure (insert δ (Set.range (rightMul D)))) := by sorry

end EdgeTransBiCayley.TwoArc
