@[simp] theorem gramInputMatrix_encoded {K : Type} [Zero K] {r n : ℕ} (D : Matrix (Fin r) (Fin n) K) :
    gramInputMatrix r n (encodedGramInput D) = D := by
  ext i j
  let q := finProdFinEquiv (i,j)
