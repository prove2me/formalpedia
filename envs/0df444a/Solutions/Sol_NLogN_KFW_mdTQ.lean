section Bridge

variable {sh : Shape} {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem StrideSel.fset_eq {Sb : Butterfly.SelBits sh ι} {st : ι → ℕ} (h : StrideSel Sb st)
    {j : ℕ} (hj : j < vol sh) (y : ι → Fin 2) :
