namespace KerrBL

/-- Atom `Sig` = `a**2*c**2 + r**2` -/
noncomputable def Sig (a r c : ℝ) : ℝ := r^(2:ℕ) + a^(2:ℕ)*c^(2:ℕ)

/-- Atom `Del` = `-2*M*r + a**2 + r**2` -/
noncomputable def Del (M a r : ℝ) : ℝ := a^(2:ℕ) + r^(2:ℕ) - 2*M*r

/-- The Kerr metric components g_{ij} at a coordinate point (transcribed from metric.json). -/
noncomputable def gKerr (M a : ℝ) : Fin 4 → Fin 4 → Pt → ℝ
  | 0, 0 => fun x => (-1) + 2*M*(x 1)/Sig a (x 1) (Real.cos (x 2))
  | 0, 3 => fun x => ((-2))*M*a*(x 1)*Real.sin (x 2)^(2:ℕ)/Sig a (x 1) (Real.cos (x 2))
  | 1, 1 => fun x => Sig a (x 1) (Real.cos (x 2))/Del M a (x 1)
  | 2, 2 => fun x => Sig a (x 1) (Real.cos (x 2))
  | 3, 0 => fun x => ((-2))*M*a*(x 1)*Real.sin (x 2)^(2:ℕ)/Sig a (x 1) (Real.cos (x 2))
  | 3, 3 => fun x => Real.sin (x 2)^(2:ℕ)*(a^(2:ℕ) + (x 1)^(2:ℕ) + 2*M*(x 1)*a^(2:ℕ)*Real.sin (x 2)^(2:ℕ)/Sig a (x 1) (Real.cos (x 2)))
  | _, _ => fun _ => 0

/-- Closed-form candidate inverse g^{ij}; certified by `ginv_mul_g`. -/
noncomputable def giKerr (M a : ℝ) : Fin 4 → Fin 4 → Pt → ℝ
  | 0, 0 => fun x => (Del M a (x 1)*a^(2:ℕ)*Real.sin (x 2)^(2:ℕ) - (a^(2:ℕ) + (x 1)^(2:ℕ))^(2:ℕ))/((Sig a (x 1) (Real.cos (x 2))*Del M a (x 1)))
  | 0, 3 => fun x => ((-2))*M*a*(x 1)/((Sig a (x 1) (Real.cos (x 2))*Del M a (x 1)))
  | 1, 1 => fun x => Del M a (x 1)/Sig a (x 1) (Real.cos (x 2))
  | 2, 2 => fun x => 1/Sig a (x 1) (Real.cos (x 2))
  | 3, 0 => fun x => ((-2))*M*a*(x 1)/((Sig a (x 1) (Real.cos (x 2))*Del M a (x 1)))
  | 3, 3 => fun x => (Del M a (x 1) - a^(2:ℕ)*Real.sin (x 2)^(2:ℕ))/((Sig a (x 1) (Real.cos (x 2))*Del M a (x 1)*Real.sin (x 2)^(2:ℕ)))
  | _, _ => fun _ => 0

/-- Regular coordinate domain: every denominator of the metric, its inverse and the
Christoffel symbols is nonzero. -/
def RegKerr (M a : ℝ) (x : Pt) : Prop := Sig a (x 1) (Real.cos (x 2)) ≠ 0 ∧ Del M a (x 1) ≠ 0 ∧ Real.sin (x 2) ≠ 0

