theorem NLogN.Rsp.sapP_okc (M : MulSpec) (mm Φ B : ℕ) (hM : MulBnd M mm Φ) (p s t α : ℕ) (s0 : IState HS)
    (U : List (ℤ × ℤ)) (RU LKs LKa LKN LR LN LNR LNW RW RD : List Item)
    (hs : 0 < s) (ht : 0 < t) (hst : s ≤ t) (hUl : U.length = s)
    (hU : s0.G CU = gints U ++ RU) (hKs : s0.G Ks = .int (s : ℤ) :: LKs)
    (hKa : s0.G Ka = .int (sOff s (HvdH.sWidth p α) : ℤ) :: LKa)
