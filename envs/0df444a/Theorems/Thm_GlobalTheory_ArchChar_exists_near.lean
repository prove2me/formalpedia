variable {ι : Type} [Fintype ι] [DecidableEq ι]

theorem GlobalTheory.ArchChar.exists_near (ψ : (ι → ℂˣ) →* ℂˣ) (hψ : Continuous ψ) (θ : ι → ℂ) (hθ : ∀ i, (θ i).im ≠ 0)
    (T : Set (ι → ℝ)) (C : ℝ) (hT : ∀ y : ι → ℝ, ∃ a ∈ T, ‖a - y‖ ≤ C)
    (hc : ∀ a ∈ T, ψ (shift θ hθ a) = 1) (i : ι) (R : ℝ) :
    ∃ t : ℝ, |t - R| ≤ C ∧ ψ (Pi.mulSingle i (Units.mk0 _ (add_ne (hθ i) t))) = 1 := by sorry
