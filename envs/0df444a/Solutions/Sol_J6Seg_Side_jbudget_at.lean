theorem n_mul : 2 * (axkJ6 P n src k ap + 2) ≤ 64 * ((W2c ap + 10) * pP6 P n) := by
  have h2 := kJ_le ap h
  have hp := h.base.p1
  have : (W2c ap + 10) * pP6 P n = W2c ap * pP6 P n + 10 * pP6 P n := by ring
