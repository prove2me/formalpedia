-- Source module: Solutions.KFUURev8
/-!
# KFUU §2h: the set-up of phase 2 (volume, powers)

* `volU pM pS`: push `vol S` on `rB` (the sizes `S` on `pS`, restored).
* `powL`: push `U^n` on `rM` (`U = 2^u` on `rU2`, `n` on `nR`).
* `rptXU_runs`: `rptX_runs` with a simple cost.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU

open IntMul KIL KFB KFC KFT KFU AModel AModelL12

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## The volume of a size list -/

def volB (pM : Fin P) (pS : Fin HS) : IStmt HS P :=
  .seq (mulC pM NLogN.KFUU.rB pS tq) (.seq (.op (.drop NLogN.KFUU.rB)) (.op (.mv tq NLogN.KFUU.rB)))

def volU (pM : Fin P) (pS : Fin HS) : IStmt HS P :=
  .seq (.op (.const NLogN.KFUU.rB 1)) (.seq (rptX nR NLogN.KFUU.lA lC lD (.seq (volB pM pS) (.op (.mv pS tS))))
    (mvL tS pS))

/-! ## Powers -/

def powL : IStmt HS P := .seq (.op (.const NLogN.KFUU.rM 1)) (rptX nR NLogN.KFUU.lA lC lD (.op (.shl NLogN.KFUU.rM rU2)))

/-! ## The phase-2 loop -/

/-- The state before swap `k`. -/
def p2St (t : IState HS) (R : List Item) (u cz cr : ℕ) (bs : List Bool) (xs0 : List ℤ)
    (LA LM LB : List Item) (k : ℕ) : IState HS :=
  (((t.upd 0 (ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
    (rv bs.length k (lay1 (bgB bs) bs.length 0)) xs0 0) ++ R)).upd rA
    (.int (((2 ^ u) ^ k : ℕ) : ℤ) :: LA)).upd NLogN.KFUU.rM
    (.int (((2 ^ u) ^ (bs.length - 2 * k) : ℕ) : ℤ) :: LM)).upd NLogN.KFUU.rB
    (.int (((2 ^ u) ^ k * (vol (ctB u cz bs) * cr) : ℕ) : ℤ) :: LB)

def p2L (eSw : Fin P) (dS Dsc : Fin HS) : IStmt HS P := rptX NLogN.KFUU.rH NLogN.KFUU.lA lC lD (p2B eSw dS Dsc)

end Gen

end NLogN.KFUU

end

section
-- Source module: Solutions.KFUURot7
/-!
# KFUU §7g: the forward shifts, uniform

`rotsFU`: a register-counted loop (`oD = d` iterations) of `preF; rotCU false; postF`; it runs
KFU's forward shifts of targets `d-1, …, 0` (`rotsFU_runs`: the result is KFU's
`pull … (Gf sF (csF sF μ) d)`).  Registers before: `oI = d`, `oPi = P_d`, `oBv = 2`,
`oSP = [s_{d-1}, …, s_0]`, `oML = [μ_{d-1}, …, μ_0]`; after: `oI = 0`, `oPi = 1`,
`oBv = vol (shR d (sP d sF))`, `oSP`, `oML` consumed.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL KFC KFT AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The loop count `d`. -/
abbrev oD : Fin HS := 21

/-- One forward step. -/
def fwB : IStmt HS Pp := .seq preF.code (.seq (NLogN.KFUU.rotCU false) postF.code)

/-- The forward shifts. -/
def rotsFU : IStmt HS Pp := rptX oD NLogN.KFUU.lA lC lD fwB

/-- The address map after `k` forward steps. -/
def Hf (d : ℕ) (sF : ℕ → ℕ) (cs : ℕ → List ℕ) : ℕ → List ℕ → List ℕ
  | 0 => id
  | k + 1 => Hf d sF cs k ∘ KFU.gRot sF cs (d - 1 - k)

/-- The volume behind the remaining targets after `k` forward steps. -/
def BvF (d : ℕ) (sF : ℕ → ℕ) (k : ℕ) : ℕ := vol (((List.range d).drop (d - k) ++ [d]).map (KFU.sP d sF))

/-- The loop state after `k` forward steps. -/
def fwSt (d : ℕ) (sF μ : ℕ → ℕ) (t : IState HS) (R RSP RML LI LP LB : List Item) (xs : List ℤ)
    (k : ℕ) : IState HS :=
  (((((t.upd 0 (ints (pull (KFU.shR d (KFU.sP d sF)) (KFU.shR d (KFU.sP d sF))
    (Hf d sF (KFU.csF sF μ) k) 0 xs) ++ R)).upd oI (.int (d - k : ℕ) :: LI)).upd oPi
    (.int (Pv sF (d - k)) :: LP)).upd oBv (.int (BvF d sF k) :: LB)).upd oSP
    (ints ((List.range (d - k)).map fun j => (sF j : ℤ)).reverse ++ RSP)).upd oML
    (ints ((List.range (d - k)).map fun j => (μ j : ℤ)).reverse ++ RML)

/-- Per-step cost bound. -/
def cStepU (d PM V w B Bb : ℕ) : ℕ := NLogN.KFUU.cTab d PM B Bb + 68 * kap w * V + 3 * 10 ^ 9 * (B + 2) ^ 2

end NLogN.KFUU

end

