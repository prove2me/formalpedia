namespace K2Hopf

abbrev augIdeal (R : Type) [CommRing R] (A : Type) [CommRing A] [Bialgebra R A] : Ideal A :=
  RingHom.ker (Bialgebra.counitAlgHom R A)

abbrev TangentAtUnit (k : Type) [CommRing k] (B : Type) [CommRing B] [Bialgebra k B] : Type :=
  {D : B →ₐ[k] DualNumber k // ∀ b : B, TrivSqZeroExt.fst (D b) = Bialgebra.counitAlgHom k B b}

