-- title:
--   Exact rational input tables for the released stronger witness
-- statement:
--   Exact integer input tables obtained by rounding and normalizing the released W1.00_2.371339.mat witness on denominator 10^12. Includes all six global distributions and positive product-dual weights, all 270 parent records in source order, boundary complete-word profiles, regional weights and split distributions, and square-child parameters. The six global region proportions are exactly 1/6. Entries are counts, so probabilities are obtained by dividing by the denominator. Term.Valid checks primitive normalization and elementary record consistency only; it does not assert recursive source compatibility, type covers, tensor extraction, or any exponent bound.
-- source:
--   More Asymmetry, arXiv:2404.16349v2; W1.00_2.371339.mat SHA256 783353fda82acb3fb93c247dcad857b2db5f61944f5d0e91ae5f9e5a6c7feec3

import Mathlib.Data.List.Basic
import Mathlib.Data.Nat.Basic
set_option autoImplicit false
set_option maxHeartbeats 4000000
set_option maxRecDepth 10000
namespace MME.MoreAsymmetryExactSeed

/-- Denominator for normalized primitive distributions and child parameters. -/
def denominator : ℕ := 1000000000000

/-- Literal input record. Boundary words are ordered base-three complete words;
children store (zero-based region, square shape, split_0 numerator). For shapes
without a split_0 variable its numerator is zero. Dual lists store
(coarse grade, positive product-weight numerator), with denominator 10^12.
These data make no tensor-realization assertion. -/
structure Term where
  shape : List ℕ
  boundary : List (List ℕ × ℕ)
  region : List ℕ
  splits : List (List ℕ)
  alpha : List (List ℕ)
  children : List (ℕ × List ℕ × ℕ)
  dual : List (List (List (ℕ × ℕ)))
  deriving DecidableEq

/-- Primitive probability vector on the fixed grid. Nonnegativity is by type. -/
def Normalized (v : List ℕ) : Prop := v.sum = denominator
instance (v : List ℕ) : Decidable (Normalized v) := inferInstanceAs (Decidable (v.sum = denominator))

/-- Elementary consistency of each source input record, before construction
of any physical profile or source-cover proof. -/
def Term.Valid (t : Term) : Prop :=
  t.shape.length = 3 ∧ t.shape.sum = 8 ∧
  if t.boundary = [] then
    t.region.length = 6 ∧ Normalized t.region ∧
    t.alpha.length = 6 ∧ (∀ a ∈ t.alpha, a.length = t.splits.length ∧ Normalized a) ∧
    (∀ s ∈ t.splits, s.length = 3 ∧ s.sum = 4) ∧
    (∀ c ∈ t.children, c.1 < 6 ∧ c.2.1.length = 3 ∧ c.2.1.sum = 4 ∧ 2 * c.2.2 ≤ denominator) ∧
    t.dual.length = 6 ∧ (∀ d ∈ t.dual, d.length = 3 ∧ ∀ m ∈ d, ∀ p ∈ m, 0 < p.2)
  else
    Normalized (t.boundary.map Prod.snd) ∧
    (∀ p ∈ t.boundary, p.1.length = 4 ∧ ∀ x ∈ p.1, x ≤ 2) ∧
    t.region = [] ∧ t.splits = [] ∧ t.alpha = [] ∧ t.children = [] ∧ t.dual = []
instance (t : Term) : Decidable t.Valid := by unfold Term.Valid; infer_instance

