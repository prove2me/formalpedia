--         ‖xh.getD j 0 k - (mrL (t (Fin.last D)) (tsOf t) (recL t f) (recL t g)).getD j 0 k‖ ≤ E) :
--       ‖boxOf t xh - mrX t f g‖ ≤ E
--   ```
