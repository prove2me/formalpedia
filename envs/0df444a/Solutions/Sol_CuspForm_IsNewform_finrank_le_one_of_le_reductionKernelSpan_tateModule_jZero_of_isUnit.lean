private theorem seqπ_mem (x : ℕ → J) (hx : ∀ k, x k ∈ lvl J p k) (k : ℕ) :
    seqπ p f hfin x hx k ∈ lvl J p k :=
  SetLike.coe_mem _

private theorem seqπ_congr (x y : ℕ → J) (hx : ∀ k, x k ∈ lvl J p k) (hy : ∀ k, y k ∈ lvl J p k)
    (h : ∀ k, x k = y k) (k : ℕ) : seqπ p f hfin x hx k = seqπ p f hfin y hy k := by
