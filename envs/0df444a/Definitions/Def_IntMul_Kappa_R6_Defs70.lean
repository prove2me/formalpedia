-- Source module: Solutions.R6P18Tab
/-!
# Round six, Proposition 18: the table

`ext6 nU U e su td q : Fin (nU + 3) → IStmt HS (7 + (nU + 3))` extends `IL.kTableP tab` (any
Lemma 12 table `tab` in slot `0`) by

* the `nU` procedures of the uniform Proposition 14 (`IL3.P14UH'`) at `idx6 i = 7 + i`;
* a copy of the frozen Lemma 12 procedure `KFL.l12prog 0` at `eL6 = 7 + nU`;
* the frozen uniform Gaussian swap `KFW.swGU q`, relabelled onto that copy, at `eSw6 = 8 + nU`;
* the body of Proposition 18 at `ent6 = 9 + nU`.

The swap entry is only needed for the correctness proof of the layout programs: at round six
`K = ℓ - 1`, so phase 3 of the layout never calls it (`R6P18Lay`), and its exponent does not
enter the cost. **`swOK6`**: `SwOK` for the swap entry.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV.R6P

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12
open IntMul.Kappa.R6

/-- Positions of the Proposition 14 procedures. -/
def idx6 (nU : ℕ) : Fin nU → Fin (7 + (nU + 3)) := fun i => ⟨i.val + 7, by omega⟩

/-- Position of the copy of the frozen Lemma 12 procedure. -/
def eL6 (nU : ℕ) : Fin (7 + (nU + 3)) := ⟨nU + 7, by omega⟩

/-- The relabelling of the frozen Lemma 12 table. -/
def gL6 (nU : ℕ) : Fin 1 → Fin (7 + (nU + 3)) := fun _ => eL6 nU

/-- Position of the swap. -/
def eSw6 (nU : ℕ) : Fin (7 + (nU + 3)) := ⟨(nU + 1) + 7, by omega⟩

/-- Position of the Proposition 18 body. -/
def ent6 (nU : ℕ) : Fin (7 + (nU + 3)) := ⟨(nU + 2) + 7, by omega⟩

/-- The extension of the table. -/
noncomputable def ext6 (nU : ℕ)
    (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E)) (e : Fin nU)
    (su td : (Pp : ℕ) → IStmt HS Pp) (q : ℕ) : Fin (nU + 3) → IStmt HS (7 + (nU + 3)) :=
  fun k =>
    if h : k.val < nU then U (nU + 3) (idx6 nU) ⟨k.val, h⟩
    else if k.val = nU then (KFL.l12prog 0).ren id (gL6 nU)
    else if k.val = nU + 1 then (KFW.swGU q).ren id (gL6 nU)
    else body18 (su _) (td _) (idx6 nU e) (eSw6 nU) (KFM.pMul (nU + 3))

end NLogN.KFV.R6P

end

