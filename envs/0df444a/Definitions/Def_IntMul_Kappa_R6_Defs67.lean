section
-- Source module: Solutions.J6SegAxis10
/-!
# B-line axis program (`AxisU6`), part 10: stacks, registers, procedure families, B1 contract

* `dAx = 8`: the descriptor stack of the axis program (admissible for the slab passes, the copy
  and swap of S2, distinct from `dT = 49` and `dTJ = 33`);
* `ρK dF`: the kernel-pass registers `10 … 29` with `dF` skipped (`RegOK` for `dT` and `dTJ`);
* `famApp`, `famOwn`: concatenation of procedure families uniform in the table (the second
  argument of `famOwn` sees the whole index map);
* **`SlabNeed6 P`** (B1: the source-table producers and `ctlB`): uniform procedures building and
  clearing the slab register files `slabV1/3/5/7` of axis `k` from the descriptor on `dA`
  (`SetupS`), at cost `Cs · cU6 P n A / (D + 1)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- The descriptor stack of the axis program. -/
abbrev dAx : Fin HS := 8

/-- The kernel-pass registers: `10 … 29`, skipping `dF`. -/
def ρK (dF : Fin HS) (i : Fin 19) : Fin HS :=
  ⟨if 10 + i.val < dF.val then 10 + i.val else 11 + i.val, by
    have : HS = 64 := rfl
    split_ifs <;> omega⟩

/-! ## Procedure families -/

/-- A family of procedures, uniform in the table. -/
abbrev Fam (m : ℕ) : Type := ∀ E : ℕ, (Fin m → Fin (7 + E)) → Fin m → IStmt HS (7 + E)

/-- Concatenation. -/
def famApp {m₁ m₂ : ℕ} (U₁ : Fam m₁) (U₂ : Fam m₂) : Fam (m₁ + m₂) := fun E idx i =>
  if h : i.val < m₁ then U₁ E (fun j => idx (Fin.castAdd m₂ j)) ⟨i.val, h⟩
  else U₂ E (fun j => idx (Fin.natAdd m₁ j)) ⟨i.val - m₁, by omega⟩

/-- A family followed by procedures that may call any member (`V` sees the whole index map). -/
def famOwn {m₁ m₂ : ℕ} (U₁ : Fam m₁)
    (V : ∀ E : ℕ, (Fin (m₁ + m₂) → Fin (7 + E)) → Fin m₂ → IStmt HS (7 + E)) : Fam (m₁ + m₂) :=
  fun E idx i =>
    if h : i.val < m₁ then U₁ E (fun j => idx (Fin.castAdd m₂ j)) ⟨i.val, h⟩
    else V E idx ⟨i.val - m₁, by omega⟩

/-! ## The B1 contract -/

/-- **`SlabNeed6 P` (B1).** For every admissible descriptor stack `dA`, a family of procedures
(uniform in the table) with set-up / tear-down pairs for the four slab passes of axis `k`,
building the slab register files from `descAx6 P n src D k` on `dA`, each at cost
`Cs · cU6 P n A / (D + 1)`. -/
def SlabNeed6 (P : Prm) : Prop :=
  ∀ dA : Fin HS, SlabFree dA → 8 ≤ dA.val → dA.val < 56 →
  ∃ (nS : ℕ) (US : Fam nS) (e1u e1d e3u e3d e5u e5d e7u e7d : Fin nS) (Cs : ℝ) (A n₁ : ℕ),
    0 ≤ Cs ∧
  ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D,
  ∀ (tab : Fin 1 → IStmt HS 1) (E : ℕ) (ext : Fin E → IStmt HS (7 + E))
    (idx : Fin nS → Fin (7 + E)), (∀ i, IL.kTableP tab ext (idx i) = US E idx i) →
    ∀ Isym : List Sym,
      let C := Cs * cU6 P n A / (D + 1)
      SetupS Isym (IL.kTableP tab ext) (.call (idx e1u)) (.call (idx e1d)) ρS dA
        (descAx6 P n src D k) (slabV1 P n src D k) C ∧
      SetupS Isym (IL.kTableP tab ext) (.call (idx e3u)) (.call (idx e3d)) ρS dA
        (descAx6 P n src D k) (slabV3 P n src D k) C ∧
      SetupS Isym (IL.kTableP tab ext) (.call (idx e5u)) (.call (idx e5d)) ρS dA
        (descAx6 P n src D k) (slabV5 P n src D k) C ∧
      SetupS Isym (IL.kTableP tab ext) (.call (idx e7u)) (.call (idx e7d)) ρS dA
        (descAx6 P n src D k) (slabV7 P n src D k) C

end J6Seg.Ax

end

