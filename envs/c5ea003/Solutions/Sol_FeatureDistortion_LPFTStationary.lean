section FeatureDistortionBundleModule3
noncomputable section
open Set
namespace FeatureDistortion

lemma constant_isFineTuningFlow_of_residual_eq_zero {n d k : ℕ}
    (X : Vec d →L[ℝ] Vec n) (Y : Vec n) (v₀ : Vec k) (B₀ : Features d k)
    (h : residual X Y v₀ B₀ = 0) :
    IsFineTuningFlow X Y v₀ B₀
      { head := fun _ ↦ v₀, features := fun _ ↦ B₀ } := by
  refine ⟨rfl, rfl, ?_⟩
  intro t ht
  constructor
  · simpa [headGradient, h] using hasDerivWithinAt_const t (Ici 0) v₀
  · simpa [featureGradient, h] using hasDerivWithinAt_const t (Ici 0) B₀

lemma aligned_constant_isFineTuningFlow {n d k : ℕ} (P : Problem n d k) :
    IsFineTuningFlow P.data (labels P) (alignedHead P) (initialFeatures P)
      { head := fun _ ↦ alignedHead P, features := fun _ ↦ initialFeatures P } := by
  apply constant_isFineTuningFlow_of_residual_eq_zero
  simp [residual, weights_aligned, labels]

/-- Kumar et al., Appendix A.7, PDF pp. 46--47, equations (A.214)--(A.218). -/
theorem LPFTStationary :
  ∀ (n d k : ℕ) (P : Problem n d k), Admissible P →
    ∀ γ : Trajectory d k,
      IsFineTuningFlow P.data (labels P) (alignedHead P) (initialFeatures P) γ →
      ∀ t : ℝ, 0 ≤ t →
        γ.head t = alignedHead P ∧ γ.features t = initialFeatures P := by
  intro n d k P _ γ hγ t ht
  exact fineTuning_unique hγ (aligned_constant_isFineTuningFlow P) ht

end FeatureDistortion
end -- original EOF-open anonymous section
end FeatureDistortionBundleModule3
