-- title:
--   Galois symbols generate $H^n(F,\mathbb{Z}/2)$
-- statement:
--   Let $F$ be a field of characteristic different from $2$, let $F^{\mathrm{sep}}$ be a separable closure and $G_F=\operatorname{Gal}(F^{\mathrm{sep}}/F)$. For $a\in F^\times$ let $\chi_a:G_F\to\mathbb{Z}/2$ be the Kummer character ($\chi_a(\sigma)=0$ iff $\sigma$ fixes a chosen square root of $a$). For $a=(a_1,\dots,a_n)\in(F^\times)^n$, the Galois symbol $\mathrm{gs}(a_1,\dots,a_n)\in H^n(F,\mathbb{Z}/2)$ is the cup product $\chi_{a_1}\cup\cdots\cup\chi_{a_n}$ in continuous Galois cohomology (with $\mathrm{gs}()=1\in H^0$).
--
--   Then the Galois symbols generate the cohomology group: the subgroup of $H^n(F,\mathbb{Z}/2)$ generated by all $\mathrm{gs}(a_1,\dots,a_n)$, $a_i\in F^\times$, is all of $H^n(F,\mathbb{Z}/2)$.
--
--   $$\big\langle\, \mathrm{gs}(a_1,\dots,a_n) : a_1,\dots,a_n\in F^\times \,\big\rangle = H^n(F,\mathbb{Z}/2).$$
--
--   Equivalently, the norm residue homomorphism $K^M_n(F)/2\to H^n(F,\mathbb{Z}/2)$ is surjective; this is the surjectivity half of the Milnor conjecture proved by Voevodsky.
-- source:
--   V. Voevodsky, Motivic cohomology with Z/2-coefficients, Publ. Math. IHES 98 (2003), 59-104, https://doi.org/10.1007/s10240-003-0010-6, Section 7, Corollary 7.5 (the norm residue homomorphisms K^M_n(k)/2 -> H^n_et(k, Z/2) are isomorphisms for char k != 2)

import Mathlib
import Definitions.Def_MilnorConjecture_MilnorK
import Definitions.Def_MilnorConjecture_GaloisSymbol

namespace MilnorConjecture
theorem galoisSymbol_generate (F : Type) [Field F] [NeZero (2 : F)] (n : ℕ) :
    AddSubgroup.closure (Set.range (galoisSymbol (F := F) (n := n))) = ⊤ := by sorry
end MilnorConjecture
