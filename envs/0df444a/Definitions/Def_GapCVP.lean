      (List.pairwise_cons.mp hordered).1 second (by simp)
    have hbackward : Encodable.encode second ≤ Encodable.encode first :=
      (List.pairwise_cons.mp
        (List.pairwise_cons.mp hordered).2).1 first hremaining
