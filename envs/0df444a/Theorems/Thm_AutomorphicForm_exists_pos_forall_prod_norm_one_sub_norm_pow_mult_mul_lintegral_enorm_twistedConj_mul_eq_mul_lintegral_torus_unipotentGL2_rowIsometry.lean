    ∀ (δ : GL (Fin 2) (L ⊗[K] InfiniteAdeleRing K)), (δ : Matrix (Fin 2) (Fin 2) (L ⊗[K] InfiniteAdeleRing K)) = !![(α : (L ⊗[K] InfiniteAdeleRing K)), 0; 0, (β' : (L ⊗[K] InfiniteAdeleRing K))] →
