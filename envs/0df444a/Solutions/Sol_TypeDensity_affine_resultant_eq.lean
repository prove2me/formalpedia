open MeasureTheory Polynomial
variable (O : Type) [CommRing O] [IsDomain O]
omit [IsDomain O]

theorem solution {n : ℕ} (a : Fin (n + 1) → O) :
    resultant (TypeDensity.affinePolynomial O a) (derivative (TypeDensity.affinePolynomial O a)) n (n-1) =
      algebraMap O (TypeDensity.BaseField O)
        (MvPolynomial.eval a (MvPolynomial.map (Int.castRingHom O) (TypeDensity.discAffine n))) := by
  rw [← TypeDensity.specHom_eq, TypeDensity.affinePolynomial_eq_map, derivative_map, resultant_map_map]; rfl
