set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.GalTrE RamanujanPetersson.EtCompact.Cech RamanujanPetersson.EtPBC.GenGeo
  RamanujanPetersson.EtPBC.GenAlg RamanujanPetersson.EtPBC.FreeStk

universe u

section Split

variable (Λ : Type u) [CommRing Λ] {P : Scheme.{u}}

theorem stalk_desc_free {N₁ N₂ N : P.Etale} (i₁ : N₁ ⟶ N) (i₂ : N₂ ⟶ N) (x : P)
    (z : stalk Λ (freeSh Λ N₁ ⊞ freeSh Λ N₂) x) :
    ∃ l₁ l₂, (((geomPtAt x).stalkF Λ).map biprod.fst).hom z = freeLin Λ N₁ x l₁ ∧
      (((geomPtAt x).stalkF Λ).map biprod.snd).hom z = freeLin Λ N₂ x l₂ ∧
      (((geomPtAt x).stalkF Λ).map (biprod.desc (freeMap Λ i₁) (freeMap Λ i₂))).hom z =
        freeLin Λ N x (Finsupp.mapDomain ((geomPtAt x).point.fiber.map i₁) l₁ +
          Finsupp.mapDomain ((geomPtAt x).point.fiber.map i₂) l₂) := by
  obtain ⟨l₁, h₁⟩ := freeLin_surjective (Λ := Λ) N₁ x ((((geomPtAt x).stalkF Λ).map biprod.fst).hom z)
  obtain ⟨l₂, h₂⟩ := freeLin_surjective (Λ := Λ) N₂ x ((((geomPtAt x).stalkF Λ).map biprod.snd).hom z)
  refine ⟨l₁, l₂, h₁.symm, h₂.symm, ?_⟩
  have hz := stalk_biprod_eq x z
  rw [← h₁, ← h₂] at hz
  rw [hz, map_add, stalk_comp_apply, stalk_comp_apply, biprod.inl_desc, biprod.inr_desc, freeLin_natural,
