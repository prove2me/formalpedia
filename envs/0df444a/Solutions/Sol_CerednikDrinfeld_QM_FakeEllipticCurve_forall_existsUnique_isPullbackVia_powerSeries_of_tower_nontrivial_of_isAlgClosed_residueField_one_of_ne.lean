theorem Hmap_apply_eq {B B' : Type} [CommRing B] [CommRing B'] {ψ : O →+* B} {ψ' : O →+* B'} (f : B →+* B')
    (hf : f.comp ψ = ψ') (y : Hobj E₀ B ψ) (ρ' : Adm B' ψ') (σ : Adm B ψ) (e : Adm.comap f hf ρ' = σ)
