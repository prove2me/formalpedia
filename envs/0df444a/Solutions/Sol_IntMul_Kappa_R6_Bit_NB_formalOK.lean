/-! ## Formal correctness -/

theorem ι2x_eq {a s : ℕ} (ha : a < 1771) (hs : s < 1771) :
    ι2 a (wX s) = .inl ⟨3136441 + a * 1771 + s, by omega⟩ := by
  rw [ι2, show wX s = s from rfl]; unfold g2; rw [if_pos hs, gw_lt]

theorem ι2y_eq {a s : ℕ} (ha : a < 1771) (hs : s < 1771) :
    ι2 a (wY s) = .inl ⟨a * 1771 + s, by omega⟩ := by
  rw [ι2, show wY s = 1771 + s from rfl]; unfold g2
  rw [if_neg (by omega), if_pos (by omega), gw_lt (by omega)]; congr 2; omega

theorem ι1s_eq {b q : ℕ} (hb : b < 1771) (hq : q < 40077) :
    ι1 b (wS q) = .inl ⟨6272882 + b * 40077 + q, by omega⟩ := by
  rw [ι1, show wS q = 3542 + q from rfl]; unfold g1
  rw [if_neg (by omega), if_neg (by omega), if_pos (by omega), gw_lt (by omega)]
  apply congrArg Sum.inl; apply Fin.ext; dsimp only; omega

theorem ι2s_eq {a q : ℕ} (ha : a < 1771) (hq : q < 40077) :
    ι2 a (wS q) = .inl ⟨77249249 + a * 40077 + q, by omega⟩ := by
  rw [ι2, show wS q = 3542 + q from rfl]; unfold g2
  rw [if_neg (by omega), if_neg (by omega), if_pos (by omega), gw_lt (by omega)]
  apply congrArg Sum.inl; apply Fin.ext; dsimp only; omega

section Formal

variable {ch : Ch} {N : ℕ} (h : EOK ch N)
include h

theorem fInit_eq : (QHNet.fInit (W := 148225616) (T := 3217907) (R := ZMod 2) (m := 529) N : Wr → FVN N) =
    fun x => lmulF (L0 ch N x) (φ0 ch N x) := by
  funext x
  rcases x with g | t
  · show Finsupp.single (1, g) 1 = lmulF (L0 ch N (.inl g)) (φ0 ch N (.inl g))
    by_cases hg : g.val < 3136441
    · have hφ : φ0 ch N (.inl g) = Finsupp.single (L0 ch N (.inl g), g) 1 := by
        show (if g.val < 3136441 then _ else _) = _; rw [if_pos hg]
      have hL : L0 ch N (.inl g) = lab1 ch N (g.val % 1771) (cND (g.val / 1771 + 1)) := by
        show (if g.val < 3136441 then _ else _) = _; rw [if_pos hg]
      rw [hφ, lmulF_single, hL, lab1, ← redM_mul' (gΦ1 h (by omega) (cND_lt (by omega)))
        (gΦ1 h (by omega) (cND_lt (by omega))), Φ₁_sq h.hS h.hSi (by omega) (cND_lt (by omega)), redM_one']
    · have hφ : φ0 ch N (.inl g) = Finsupp.single (1, g) 1 := by
        show (if g.val < 3136441 then _ else _) = _; rw [if_neg hg]
      have hL : L0 ch N (.inl g) = 1 := by
        show (if g.val < 3136441 then _ else _) = _; rw [if_neg hg]
      rw [hφ, hL, lmulF_one]
  · show (0 : FVN N) = lmulF (L0 ch N (.inr t)) 0
    rw [map_zero]

omit h in
theorem lmulF_swap (w : Fin 148225616) :
    lmulF (swapMat : FMat 529 N) (Finsupp.single (1, w) 1 : FVN N) = Finsupp.single (swapMat, w) 1 := by
  rw [lmulF_single, Matrix.mul_one]

/-- **Formal correctness of the network.** -/
theorem formalOK_sol_aux : (net ch).FormalOK N := by
  intro w
  obtain ⟨l1, l2, l3, l4⟩ := lab_prog h
  obtain ⟨s1, s3, s4⟩ := sc_prog ch (N := N)
  have key := formal_labels N (prog ch) (L0 ch N) (φ0 ch N) l1
  show (prog ch).foldl (fStep N) (QHNet.fInit N) (.inl (ρ w)) = _
  rw [fInit_eq h, key]
  show lmulF ((prog ch).foldl (labStepH N) (L0 ch N) (.inl (ρ w)))
    ((prog ch).foldl scalarStepM (φ0 ch N) (.inl (ρ w))) = _
  obtain ⟨g, hg⟩ := w
  by_cases c1 : g < 3136441
  · obtain ⟨a, s, ha, hs, rfl⟩ : ∃ a s, a < 1771 ∧ s < 1771 ∧ g = a * 1771 + s :=
      ⟨g / 1771, g % 1771, by omega, by omega, by omega⟩
    have eρ : (.inl (ρ ⟨a * 1771 + s, hg⟩) : Wr) = ι2 a (wX s) := by
      rw [ι2x_eq ha hs]; congr 1; apply Fin.ext; show ρn _ = _; unfold ρn; rw [if_pos c1]; dsimp only; omega
    have ew : (.inl ⟨a * 1771 + s, hg⟩ : Wr) = ι2 a (wY s) := by rw [ι2y_eq ha hs]
    rw [eρ, (l2 a ha s hs).2, (s1 a ha s hs).2, ← ew]
    have hφ : φ0 ch N (.inl ⟨a * 1771 + s, hg⟩) =
        Finsupp.single (lab1 ch N s (cND (a + 1)), ⟨a * 1771 + s, hg⟩) 1 := by
      show (if a * 1771 + s < 3136441 then _ else _) = _
      rw [if_pos c1]
      show Finsupp.single ((if a * 1771 + s < 3136441 then _ else _), _) 1 = _
      rw [if_pos c1, show (a * 1771 + s) % 1771 = s by omega, show (a * 1771 + s) / 1771 = a by omega]
    rw [hφ, lmulF_single, lab2, lab1, ← redM_mul' (gΦ2 h ha (cND_lt (by omega))) (gΦ1 h hs (cND_lt (by omega))),
      final_y h.hS h.hSi ha hs, redM_pswQ_one]
  · by_cases c2 : g < 6272882
    · obtain ⟨a, s, ha, hs, e⟩ : ∃ a s, a < 1771 ∧ s < 1771 ∧ g = 3136441 + a * 1771 + s :=
        ⟨(g - 3136441) / 1771, (g - 3136441) % 1771, by omega, by omega, by omega⟩
      subst e
      have eρ : (.inl (ρ ⟨3136441 + a * 1771 + s, hg⟩) : Wr) = ι2 a (wY s) := by
        rw [ι2y_eq ha hs]; congr 1; apply Fin.ext; show ρn _ = _; unfold ρn; rw [if_neg c1, if_pos c2]; dsimp only; omega
      have ew : (.inl ⟨3136441 + a * 1771 + s, hg⟩ : Wr) = ι2 a (wX s) := by rw [ι2x_eq ha hs]
      rw [eρ, (l2 a ha s hs).1, (s1 a ha s hs).1, ← ew]
      have hφ : φ0 ch N (.inl ⟨3136441 + a * 1771 + s, hg⟩) = Finsupp.single (1, ⟨3136441 + a * 1771 + s, hg⟩) 1 := by
        show (if 3136441 + a * 1771 + s < 3136441 then _ else _) = _; rw [if_neg c1]
      rw [hφ, lmulF_swap]
    · have eρ : ρ ⟨g, hg⟩ = ⟨g, hg⟩ := by
        apply Fin.ext; show ρn _ = _; unfold ρn; rw [if_neg c1, if_neg c2]
      rw [eρ]
      have hφ : φ0 ch N (.inl ⟨g, hg⟩) = Finsupp.single (1, ⟨g, hg⟩) 1 := by
        show (if g < 3136441 then _ else _) = _; rw [if_neg c1]
      by_cases c3 : g < 77249249
      · obtain ⟨b, q, hb, hq, e⟩ : ∃ b q, b < 1771 ∧ q < 40077 ∧ g = 6272882 + b * 40077 + q :=
          ⟨(g - 6272882) / 40077, (g - 6272882) % 40077, by omega, by omega, by omega⟩
        subst e
        have ew : (.inl ⟨6272882 + b * 40077 + q, hg⟩ : Wr) = ι1 b (wS q) := by rw [ι1s_eq hb hq]
        rw [ew, l3 b hb q hq, s3 b hb q hq, ← ew, hφ, lmulF_swap]
      · obtain ⟨a, q, ha, hq, e⟩ : ∃ a q, a < 1771 ∧ q < 40077 ∧ g = 77249249 + a * 40077 + q :=
          ⟨(g - 77249249) / 40077, (g - 77249249) % 40077, by omega, by omega, by omega⟩
        subst e
        have ew : (.inl ⟨77249249 + a * 40077 + q, hg⟩ : Wr) = ι2 a (wS q) := by rw [ι2s_eq ha hq]
        rw [ew, l4 a ha q hq, s4 a ha q hq, ← ew, hφ, lmulF_swap]

end Formal

