variable {d : Type*} {E : Type*} [NormedAddCommGroup E]

private def flowDiff (c : d → ℝ) (h : ℝ) (f : UnitAddTorus d → E) : UnitAddTorus d → E := fun x => f (x + dirFlow c h) - f x

private theorem flowDiff_apply (c : d → ℝ) (h : ℝ) (f : UnitAddTorus d → E) (x : UnitAddTorus d) :
    flowDiff c h f x = f (x + dirFlow c h) - f x := rfl

private theorem continuous_flowDiff (c : d → ℝ) (h : ℝ) {f : UnitAddTorus d → E} (hf : Continuous f) : Continuous (flowDiff c h f) :=
  (hf.comp (continuous_id.add continuous_const)).sub hf

private theorem flowDiff_flow (c : d → ℝ) (h : ℝ) (f : UnitAddTorus d → E) (x : UnitAddTorus d) :
    (fun t : ℝ => flowDiff c h f (x + dirFlow c t)) = fdiff h (fun t : ℝ => f (x + dirFlow c t)) := by
  funext t
  rw [flowDiff_apply, fdiff_apply, map_add, add_assoc]

private theorem iterate_flowDiff_flow (c : d → ℝ) (h : ℝ) (k : ℕ) :
    ∀ (f : UnitAddTorus d → E) (x : UnitAddTorus d),
      (fun t : ℝ => ((flowDiff c h)^[k] f) (x + dirFlow c t)) = (fdiff (E := E) h)^[k] (fun t : ℝ => f (x + dirFlow c t)) := by
  induction k with
  | zero => intro f x; rfl
  | succ k ih =>
    intro f x
    rw [Function.iterate_succ_apply, Function.iterate_succ_apply, ih (flowDiff c h f) x, flowDiff_flow]

private theorem iterate_flowDiff_apply (c : d → ℝ) (h : ℝ) (k : ℕ) (f : UnitAddTorus d → E) (x : UnitAddTorus d) :
    ((flowDiff c h)^[k] f) x = ((fdiff (E := E) h)^[k] (fun t : ℝ => f (x + dirFlow c t))) 0 := by
  have e := congrFun (iterate_flowDiff_flow c h k f x) 0
  rwa [map_zero, add_zero] at e

omit [NormedAddCommGroup E] in

private theorem flow_add (c : d → ℝ) (f : UnitAddTorus d → E) (x : UnitAddTorus d) (s : ℝ) :
    (fun t : ℝ => f (x + dirFlow c s + dirFlow c t)) = fun t : ℝ => (fun u : ℝ => f (x + dirFlow c u)) (t + s) := by
  funext t
  simp only [map_add, add_assoc, add_comm (dirFlow c s)]

variable [NormedSpace ℂ E]

private theorem iteratedDeriv_flow_eq (c : d → ℝ) (f : UnitAddTorus d → E) (x : UnitAddTorus d) (n : ℕ) (s : ℝ) :
    iteratedDeriv n (fun t : ℝ => f (x + dirFlow c t)) s = iteratedDeriv n (fun t : ℝ => f (x + dirFlow c s + dirFlow c t)) 0 := by
  rw [flow_add, iteratedDeriv_comp_add_const n (fun u : ℝ => f (x + dirFlow c u)) s]
  simp only [zero_add]

private theorem norm_iterate_flowDiff_le (c : d → ℝ) {f : UnitAddTorus d → E} (k : ℕ)
    (hs : ∀ x, ContDiff ℝ ∞ (fun t : ℝ => f (x + dirFlow c t)))
    {M : ℝ} (hM : ∀ x, ‖iteratedDeriv k (fun t : ℝ => f (x + dirFlow c t)) 0‖ ≤ M) {h : ℝ} (hh : 0 ≤ h) (x : UnitAddTorus d) :
    ‖((flowDiff c h)^[k] f) x‖ ≤ M * h ^ k := by
  rw [iterate_flowDiff_apply]
  refine norm_iterate_fdiff_le k (hs x) (fun s => ?_) hh 0
  rw [iteratedDeriv_flow_eq]
  exact hM _

variable [Fintype d]

private theorem mFourierCoeff_sub {f g : UnitAddTorus d → E} (hf : Continuous f) (hg : Continuous g) (n : d → ℤ) :
    mFourierCoeff (f - g) n = mFourierCoeff f n - mFourierCoeff g n := by
  simp only [mFourierCoeff_eq_integral_torusMeasure, Pi.sub_apply, smul_sub]
  have hi : ∀ {u : UnitAddTorus d → E}, Continuous u → Integrable (fun t => mFourier (-n) t • u t) (torusMeasure d) := by
    intro u hu
    obtain ⟨C, hC⟩ := (isCompact_univ (X := UnitAddTorus d)).exists_bound_of_continuousOn hu.continuousOn
    exact Integrable.of_bound ((mFourier (-n)).continuous.smul hu).aestronglyMeasurable C
      (Filter.Eventually.of_forall fun x => (norm_mFourier_smul_le (-n) x _).trans (hC _ (Set.mem_univ _)))
  exact integral_sub (hi hf) (hi hg)

private theorem mFourierCoeff_flowDiff (c : d → ℝ) (h : ℝ) {f : UnitAddTorus d → E} (hf : Continuous f) (n : d → ℤ) :
    mFourierCoeff (flowDiff c h f) n = (mFourier n (dirFlow c h) - 1) • mFourierCoeff f n := by
  show mFourierCoeff ((fun x => f (x + dirFlow c h)) - f) n = _
  rw [mFourierCoeff_sub (f := fun x => f (x + dirFlow c h)) (g := f) (hf.comp (continuous_id.add continuous_const)) hf,
    mFourierCoeff_comp_add_right, sub_smul, one_smul]

private theorem mFourierCoeff_iterate_flowDiff (c : d → ℝ) (h : ℝ) (n : d → ℤ) (k : ℕ) :
    ∀ {f : UnitAddTorus d → E} (_ : Continuous f),
      mFourierCoeff ((flowDiff c h)^[k] f) n = (mFourier n (dirFlow c h) - 1) ^ k • mFourierCoeff f n := by
  induction k with
  | zero => intro f _; simp only [Function.iterate_zero, id_eq, pow_zero, one_smul]
  | succ k ih =>
    intro f hf
    rw [Function.iterate_succ_apply, ih (continuous_flowDiff c h hf), mFourierCoeff_flowDiff c h hf n, smul_smul, ← pow_succ]

private theorem tendsto_norm_mFourier_dirFlow_sub_one_div (n : d → ℤ) (c : d → ℝ) :
    Tendsto (fun h : ℝ => ‖mFourier n (dirFlow c h) - 1‖ / h) (𝓝[>] 0) (𝓝 (2 * π * |dirFreq n c|)) := by
  have hD := hasDerivAt_mFourier_dirFlow n c 0
  rw [hasDerivAt_iff_tendsto_slope_zero] at hD
  simp only [zero_add, map_zero, mFourier_apply_zero, mul_one] at hD
  have hN := (hD.norm).mono_left (nhdsWithin_mono (0 : ℝ) (fun x (hx : x ∈ Set.Ioi (0 : ℝ)) => ne_of_gt hx))
  have hlim : ‖(2 * π * I * dirFreq n c : ℂ)‖ = 2 * π * |dirFreq n c| := by
    rw [show (2 * π * I * dirFreq n c : ℂ) = ((2 * π * dirFreq n c : ℝ) : ℂ) * I by push_cast; ring, norm_mul, Complex.norm_I,
      mul_one, Complex.norm_real, Real.norm_eq_abs, abs_mul, abs_mul, abs_of_pos Real.pi_pos, abs_two]
  rw [hlim] at hN
  refine hN.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with h (hh : 0 < h)
  rw [norm_smul, norm_inv, Real.norm_of_nonneg hh.le, div_eq_inv_mul]

private theorem pow_mul_norm_mFourierCoeff_le_of_contDiff_flow (c : d → ℝ) {f : UnitAddTorus d → E} (hf : Continuous f) (k : ℕ)
    (hs : ∀ x, ContDiff ℝ ∞ (fun t : ℝ => f (x + dirFlow c t)))
    {M : ℝ} (hM : ∀ x, ‖iteratedDeriv k (fun t : ℝ => f (x + dirFlow c t)) 0‖ ≤ M) (n : d → ℤ) :
    (2 * π * |dirFreq n c|) ^ k * ‖mFourierCoeff f n‖ ≤ M := by

  have hq : ∀ h : ℝ, 0 < h → (‖mFourier n (dirFlow c h) - 1‖ / h) ^ k * ‖mFourierCoeff f n‖ ≤ M := by
    intro h hh
    have h1 := norm_mFourierCoeff_le (fun x => norm_iterate_flowDiff_le c k hs hM hh.le x) n
    rw [mFourierCoeff_iterate_flowDiff c h n k hf, norm_smul, norm_pow] at h1
    rw [div_pow, div_mul_eq_mul_div, div_le_iff₀ (pow_pos hh k)]
    exact h1
  have hT := ((tendsto_norm_mFourier_dirFlow_sub_one_div n c).pow k).mul_const ‖mFourierCoeff f n‖
  exact le_of_tendsto hT (by filter_upwards [self_mem_nhdsWithin] with h hh using hq h hh)

end Flow
