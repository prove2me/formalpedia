-- Source module: Solutions.J6PipeGBA1
/-!
# `PipeGBA6`, part 1: one chirp row keeps `GB (p + 2)`

**`chirpC_gb`**: if every input entry has parts of bit size `≤ p + 2` (so `‖U_i‖ ≤ 4√2 · 2^p`),
every output entry of `chirpC p s t α H` has parts of bit size `≤ p + 2`:
`‖out‖ ≤ 2^p ‖S'(U/2^p)‖ + E ≤ 0.55 · 5.66 · 2^p + 10 < 2^{p+2}` (`chirpA_err8` with `ex = 3`,
`Sexact_norm`, the window error `E ≤ 8 · 1 + 2` as in `chirpC_fp`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open Complex

namespace J6A

open IntMul.HvdH IntMul.HvdH.SPf
open NLogN (zsz)

/-- A part of bit size `≤ m` has modulus `≤ 2^m`. -/
theorem abs_le_of_zsz {x : ℤ} {m : ℕ} (h : zsz x ≤ m) : |(x : ℝ)| ≤ 2 ^ m := by
  have h1 := NLogN.natAbs_lt_zsz x
  have h2 : x.natAbs < 2 ^ m := lt_of_lt_of_le h1 (Nat.pow_le_pow_right (by norm_num) h)
  have h3 : ((x.natAbs : ℕ) : ℝ) ≤ ((2 ^ m : ℕ) : ℝ) := by exact_mod_cast h2.le
  rw [Nat.cast_natAbs, Int.cast_abs] at h3
  push_cast at h3
  exact h3

set_option maxHeartbeats 1000000 in
/-- **One chirp row keeps `GB (p + 2)`.** -/
theorem chirpC_gb_sol_aux (p s t α H : ℕ) [NeZero s] [NeZero t] (hst : s ≤ t) (hα : 2 ≤ α)
    (hαp : α ^ 2 ≤ p) (hH : 1 ≤ H) (hH2 : H ≤ 2 * sWidth p α) (hθ : 300 * (t - s) ≤ s)
    (hp : 24 ≤ p) (hWp : 12 * (H + sWidth p α + 3) ≤ 2 ^ (p / 2))
    (U : ℕ → ℤ × ℤ) (hU : ∀ i, zsz (U i).1 ≤ p + 2 ∧ zsz (U i).2 ≤ p + 2) (k : ℕ) :
    zsz (chirpC p s t α H U k).1 ≤ p + 2 ∧ zsz (chirpC p s t α H U k).2 ≤ p + 2 := by
  have hs : 0 < s := Nat.pos_of_ne_zero (NeZero.ne s)
  set W := H + sWidth p α + 3 with hWdef
  set R : ℝ := 2 ^ p with hR
  have hR0 : (0 : ℝ) < R := by positivity
  have hR24 : (2 : ℝ) ^ 24 ≤ R := pow_le_pow_right₀ (by norm_num) hp
  have hσ := chirp_sigma p s t α H hs hst hα (by omega) hH2 hθ
  -- the inputs: `‖U_i‖² ≤ 32 R²`
  have hsq : ∀ i, ‖toC (U i)‖ ^ 2 ≤ 32 * R ^ 2 := by
    intro i
    obtain ⟨h1, h2⟩ := hU i
    have a1 := abs_le_of_zsz h1
    have a2 := abs_le_of_zsz h2
    have e : (2 : ℝ) ^ (p + 2) = 4 * R := by rw [hR, pow_add]; norm_num; ring
    rw [e] at a1 a2
    have b1 : ((U i).1 : ℝ) ^ 2 ≤ (4 * R) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) a1 2
    have b2 : ((U i).2 : ℝ) ^ 2 ≤ (4 * R) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) a2 2
    have en : ‖toC (U i)‖ ^ 2 = ((U i).1 : ℝ) ^ 2 + ((U i).2 : ℝ) ^ 2 := by
      rw [Complex.sq_norm]
      unfold toC
      have : ((U i).1 : ℂ) + ((U i).2 : ℂ) * I = (((U i).1 : ℝ) : ℂ) + (((U i).2 : ℝ) : ℂ) * I := by
        push_cast; rfl
      rw [this, Complex.normSq_add_mul_I]
    rw [en]; nlinarith
  have hnU : ∀ i, ‖toC (U i)‖ ≤ 5.66 * R := by
    intro i
    have := hsq i
    by_contra hc; push Not at hc
    have h0 : 0 ≤ 5.66 * R := by positivity
    nlinarith
  have hnU8 : ∀ i, ‖toC (U i)‖ ≤ 2 ^ p * 2 ^ 3 := by
    intro i; have := hnU i; rw [← hR]; norm_num; linarith
  -- the error
  have herr := chirpA_err8 (2 * p) (p / 2) W s t α H p 3 k (by omega) hs hst hα hαp hH le_rfl
    (by omega) (by omega) hσ U hnU8
  have hE : 2 * (W : ℝ) * (6 * 2 ^ (2 * (2 * p)) * (2 ^ p * 2 ^ 3) / 2 ^ (3 * (2 * p) - p / 2)) +
      2 ≤ 10 := by
    have e : (2 : ℝ) ^ (2 * (2 * p)) * 2 ^ p = 2 ^ (3 * (2 * p) - p / 2) / 2 ^ (p - p / 2) := by
      rw [eq_div_iff (by positivity), ← pow_add, ← pow_add]
      congr 1; omega
    have hW' : 12 * (W : ℝ) ≤ 2 ^ (p - p / 2) := by
      have h1 : (2 : ℝ) ^ (p / 2) ≤ 2 ^ (p - p / 2) := pow_le_pow_right₀ (by norm_num) (by omega)
      have h2 : ((12 * W : ℕ) : ℝ) ≤ ((2 ^ (p / 2) : ℕ) : ℝ) := by exact_mod_cast hWp
      push_cast at h2; linarith
    have hpos : (0 : ℝ) < 2 ^ (3 * (2 * p) - p / 2) := by positivity
    have hpos2 : (0 : ℝ) < 2 ^ (p - p / 2) := by positivity
    have e2 : (6 : ℝ) * 2 ^ (2 * (2 * p)) * (2 ^ p * 2 ^ 3) / 2 ^ (3 * (2 * p) - p / 2) =
        48 / 2 ^ (p - p / 2) := by
      rw [show (6 : ℝ) * 2 ^ (2 * (2 * p)) * (2 ^ p * 2 ^ 3) =
        48 * (2 ^ (2 * (2 * p)) * 2 ^ p) by ring, e]
      field_simp
    rw [e2]
    have : 2 * (W : ℝ) * (48 / 2 ^ (p - p / 2)) ≤ 8 := by
      rw [show 2 * (W : ℝ) * (48 / 2 ^ (p - p / 2)) = 8 * (12 * W / 2 ^ (p - p / 2)) by ring]
      have : 12 * (W : ℝ) / 2 ^ (p - p / 2) ≤ 1 := by rw [div_le_one hpos2]; exact hW'
      linarith
    linarith
  -- the exact part
  have hS : ‖Sexact s t α (fun i => toC (U i) / 2 ^ p) k‖ ≤ 0.55 * 5.66 := by
    refine Sexact_norm s t α hα _ 5.66 (by norm_num) (fun j => ?_) k
    rw [norm_div, norm_pow, Complex.norm_ofNat, div_le_iff₀ (by positivity)]
    have := hnU j; rw [hR] at this; linarith
  have hout : ‖toC (chirpA (2 * p) (p / 2) W s t α H U k)‖ ≤ 3.12 * R + 10 := by
    have h1 : ‖(2 : ℂ) ^ p * Sexact s t α (fun i => toC (U i) / 2 ^ p) k‖ ≤ R * (0.55 * 5.66) := by
      rw [norm_mul, norm_pow, Complex.norm_ofNat]
      exact mul_le_mul_of_nonneg_left hS hR0.le
    calc ‖toC (chirpA (2 * p) (p / 2) W s t α H U k)‖
        ≤ ‖toC (chirpA (2 * p) (p / 2) W s t α H U k) -
            2 ^ p * Sexact s t α (fun i => toC (U i) / 2 ^ p) k‖ +
          ‖(2 : ℂ) ^ p * Sexact s t α (fun i => toC (U i) / 2 ^ p) k‖ := norm_le_norm_sub_add _ _
      _ ≤ 10 + R * (0.55 * 5.66) := add_le_add (herr.trans hE) h1
      _ ≤ 3.12 * R + 10 := by nlinarith
  have hlt : 3.12 * R + 10 < 4 * R := by nlinarith
  -- the parts
  show zsz (chirpA (2 * p) (p / 2) W s t α H U k).1 ≤ p + 2 ∧
    zsz (chirpA (2 * p) (p / 2) W s t α H U k).2 ≤ p + 2
  set z := chirpA (2 * p) (p / 2) W s t α H U k with hz
  have hre : |(z.1 : ℝ)| ≤ ‖toC z‖ := by
    have e : (toC z).re = (z.1 : ℝ) := by unfold toC; simp
    rw [← e]; exact Complex.abs_re_le_norm _
  have him : |(z.2 : ℝ)| ≤ ‖toC z‖ := by
    have e : (toC z).im = (z.2 : ℝ) := by unfold toC; simp
    rw [← e]; exact Complex.abs_im_le_norm _
  have hpart : ∀ x : ℤ, |(x : ℝ)| < 4 * R → zsz x ≤ p + 2 := by
    intro x hx
    apply NLogN.zsz_le_of_lt
    have e : (4 : ℝ) * R = ((2 ^ (p + 2) : ℕ) : ℝ) := by rw [hR]; push_cast; rw [pow_add]; ring
    rw [e, ← Int.cast_abs, ← Nat.cast_natAbs] at hx
    exact_mod_cast hx
  exact ⟨hpart _ (by linarith), hpart _ (by linarith)⟩

end J6A

end

