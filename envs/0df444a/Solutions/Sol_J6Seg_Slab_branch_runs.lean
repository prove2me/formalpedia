section
-- Source module: Solutions.J6SegILSlab3
/-!
# B-line IL, B1 (streaming slab pass) §3: one command, the command loop, one block

The skeleton contents are kept in the form `skS G C CU OP ARG ACC` (control `rC`, used
commands `rCU`, current op `rOP`, current argument `rARG`, output `rACC`, over `G`).

* `cmdP`: pop `(op, arg)` from `rC` to `rOP`, `rARG`; branch on the sign of `op`:
  drop a slab (`op < 0`), emit `m` zeros (`op = 0`), emit the slab mapped by `g arg`, reading
  the units to the temps and moving them back (`op > 0`); push `op`, `arg` to `rCU`.
  **`cmd_runs`**.
* `cmdLoop`: `rptX rNC cmdP` — the whole command list; **`cmdLoop_runs`**: the output is
  `runC m g cs inp` (reversed onto `rACC`), the input loses `nDrop cs` slabs.
* `restLoop`: `rptX rNC (mv rCU rC; mv rCU rC)` restores the control list.
  **`restLoop_runs`**.
* `blockP = cmdLoop; restLoop`: **`block_runs`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD rptXU_runs)
open NLogN.KFT (cf3 rptX)

/-! ## The skeleton contents -/

section sk
variable (G : Fin HS → List ℤ) (C CU OP ARG ACC : List ℤ)

theorem skS_upd_ACC (v : List ℤ) :
    update (skS G C CU OP ARG ACC) rACC v = skS G C CU OP ARG v := by
  funext x; simp only [skS, update_apply]; split_ifs <;> simp_all (config := { decide := true })

end sk

/-! ## Lane-state operations -/

section lane
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
  {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)}

theorem clL (hL : LaneOK lin) (s : IState HS) (G : Fin HS → List ℤ) (inp tmp : List U)
    {i : Fin HS} (hi : i ∈ skel) {a : ℤ} {l : List ℤ} (hGi : G i = a :: l) :
    (encK s (lin inp tmp G)).cl i = cls (some (.int a)) := by
  simp [IState.cl, hL.rd i hi, hGi, ints]

end lane

/-! ## One command -/

section cmd
variable {U : Type*} {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem skel_mem_OP : rOP ∈ skel := by decide

variable {lin : List U → List U → (Fin HS → List ℤ) → (Fin HS → List ℤ)} {OkU : U → Prop}
  {OkA : ℤ → Prop} {KG : (Fin HS → List ℤ) → Prop} {g : ℤ → U → ℤ} {dr rd it bk : IStmt HS P}
  {cdr crd cit cbk : ℕ}

/-- The branch of one command, on the state after the two pops. -/
theorem branch_runs_sol_aux (H : UnitsOK (I := I) (iprog := iprog) lin OkU OkA KG g dr rd it bk cdr crd cit cbk)
    (s : IState HS) (G : Fin HS → List ℤ) (hK : ∀ C CU OP ARG ACC, KG (skS G C CU OP ARG ACC)) (hA : G lA = []) (hC : G lC = []) (hD : G lD = [])
    {m : ℕ} {LM : List ℤ} (hM : G rM = (m : ℤ) :: LM) (op a : ℤ) (C CU OP ARG ACC : List ℤ)
    (inp tmp : List U) (hlen : op ≠ 0 → m ≤ inp.length) (hok : ∀ u ∈ inp, OkU u)
    (ha : 0 < op → OkA a) :
    IRuns I iprog
      (.ite rOP (fun c => c == .neg) (rptX rM lA lC lD dr)
        (.ite rOP (fun c => c == .zero) (rptX rM lA lC lD (.op (.const rACC 0))) (emitP rd it bk)))
      (encK s (lin inp tmp (skS G C CU (op :: OP) (a :: ARG) ACC)))
      (encK s (lin (if op < 0 then inp.drop m else inp) tmp
        (skS G C CU (op :: OP) (a :: ARG) ((runC m g [(op, a)] inp).reverse ++ ACC))))
      (50 + (m + 1) * (cdr + crd + cit + cbk + 12002)) := by
  have hL := H.hL
  have hcl := clL hL s (skS G C CU (op :: OP) (a :: ARG) ACC) inp tmp
    skel_mem_OP (skS_OP _ _ _ _ _ _)
  have hokS : ∀ u ∈ inp.take m, OkU u := fun u hu => hok u (List.mem_of_mem_take hu)
  by_cases hneg : op < 0
  · have hlm : (inp.take m).length = m := by
      rw [List.length_take]; have := hlen (by omega); omega
    have h := dropL_runs (I := I) (iprog := iprog) (m := m) (LM := LM) hL H.hdr s
      (skS G C CU (op :: OP) (a :: ARG) ACC) (by simp [hA]) (by simp [hC]) (by simp [hD])
      (by simp [hM]) (inp.take m) (inp.drop m) tmp hlm hokS
    rw [List.take_append_drop] at h
    refine (IRuns.iteT (by rw [hcl]; simp [cls, hneg, hneg.ne]) h).mono' ?_ ?_
    · simp [hneg, runC]
    · have : (m + 1) * (cdr + 3000) ≤ (m + 1) * (cdr + crd + cit + cbk + 12002) :=
        Nat.mul_le_mul_left _ (by omega)
      omega
  · by_cases hz : op = 0
    · subst hz
      have h := zeroL_runs (I := I) (iprog := iprog) (m := m) (LM := LM) hL s
        (skS G C CU (0 :: OP) (a :: ARG) ACC) (by simp [hA]) (by simp [hC]) (by simp [hD])
        (by simp [hM]) inp tmp
      rw [skS_upd_ACC, skS_ACC] at h
      refine (IRuns.iteF (by rw [hcl]; simp [cls]) (IRuns.iteT (by rw [hcl]; simp [cls]) h)).mono'
        ?_ ?_
      · simp [runC]
      · have : (m + 1) * (2 + 3000) ≤ (m + 1) * (cdr + crd + cit + cbk + 12002) :=
          Nat.mul_le_mul_left _ (by omega)
        omega
    · have hpos : 0 < op := by omega
      have hlm : (inp.take m).length = m := by
        rw [List.length_take]; have := hlen hz; omega
      have h1 := copyL_runs (I := I) (iprog := iprog) (m := m) (LM := LM) hL H.hrd H.hit s
        (skS G C CU (op :: OP) (a :: ARG) ACC) (fun v => by rw [skS_upd_ACC]; exact hK _ _ _ _ _)
        (by simp [hA]) (by simp [hC]) (by simp [hD]) (by simp [hM]) (skS_ARG _ _ _ _ _ _) (ha hpos) (inp.take m) (inp.drop m) tmp hlm hokS
      rw [List.take_append_drop, skS_upd_ACC, skS_ACC] at h1
      have h2 := backL_runs (I := I) (iprog := iprog) (m := m) (LM := LM) hL H.hbk s
        (skS G C CU (op :: OP) (a :: ARG) (((inp.take m).map (g a)).reverse ++ ACC))
        (by simp [hA]) (by simp [hC]) (by simp [hD]) (by simp [hM]) (inp.take m).reverse
        (inp.drop m) tmp (by simp [hlm]) (fun u hu => hokS u (List.mem_reverse.1 hu))
      rw [List.reverse_reverse, List.take_append_drop] at h2
      refine (IRuns.iteF (by rw [hcl]; simp [cls, hneg, hz])
        (IRuns.iteF (by rw [hcl]; simp [cls, hneg, hz]) (h1.seq h2))).mono' ?_ ?_
      · simp [runC, hneg, hz]
      · have : (m + 1) * (crd + cit + 3000) + (m + 1) * (cbk + 3000) ≤
            (m + 1) * (cdr + crd + cit + cbk + 12002) := by
          rw [← Nat.mul_add]; exact Nat.mul_le_mul_left _ (by omega)
        linarith

end cmd

