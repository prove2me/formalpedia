namespace Matrix

open Equiv Equiv.Perm Finset Fintype

variable {m n : Type*} [Fintype m] [DecidableEq m] [Fintype n] [DecidableEq n]
variable {R : Type*} [CommSemiring R]

/-- Involution on `(Unit ⊕ m) ⊕ (Unit ⊕ n)` swapping the two root elements `inl (inl ())` and
`inr (inl ())`. -/
def swapRootEquiv (m n : Type*) :
    ((Unit ⊕ m) ⊕ (Unit ⊕ n)) ≃ ((Unit ⊕ m) ⊕ (Unit ⊕ n)) where
  toFun
    | .inl (.inl u) => .inr (.inl u)
    | .inl (.inr i) => .inl (.inr i)
    | .inr (.inl u) => .inl (.inl u)
    | .inr (.inr j) => .inr (.inr j)
  invFun
    | .inl (.inl u) => .inr (.inl u)
    | .inl (.inr i) => .inl (.inr i)
    | .inr (.inl u) => .inl (.inl u)
    | .inr (.inr j) => .inr (.inr j)
  left_inv x := by rcases x with (⟨⟨⟩⟩ | i) | (⟨⟨⟩⟩ | j) <;> rfl
  right_inv x := by rcases x with (⟨⟨⟩⟩ | i) | (⟨⟨⟩⟩ | j) <;> rfl

/-- Rooted permanent multiplication block matrix on `Unit ⊕ (m ⊕ (Unit ⊕ n))`. -/
def rootedMul (M₁ : Matrix (Unit ⊕ m) (Unit ⊕ m) R) (M₂ : Matrix (Unit ⊕ n) (Unit ⊕ n) R) :
    Matrix (Unit ⊕ (m ⊕ (Unit ⊕ n))) (Unit ⊕ (m ⊕ (Unit ⊕ n))) R :=
  (fromBlocks M₁ 0 (fromBlocks (1 : Matrix Unit Unit R) 0 0 0) M₂).submatrix
    (Equiv.sumAssoc Unit m (Unit ⊕ n)).symm
    ((Equiv.sumAssoc Unit m (Unit ⊕ n)).symm.trans (swapRootEquiv m n))

/-- The permanent of `rootedMul M₁ M₂` is the product of the permanents of `M₁` and `M₂`. -/
theorem permanent_rootedMul (M₁ : Matrix (Unit ⊕ m) (Unit ⊕ m) R)
    (M₂ : Matrix (Unit ⊕ n) (Unit ⊕ n) R) :
    (rootedMul M₁ M₂).permanent = M₁.permanent * M₂.permanent := by
  rw [rootedMul, permanent_submatrix_equiv_equiv, permanent_fromBlocks_zero₁₂]

/-- If the internal blocks of `M₁` and `M₂` have permanent `1`, then so does the internal block of
`rootedMul M₁ M₂`. -/
theorem permanent_toBlocks₂₂_rootedMul (M₁ : Matrix (Unit ⊕ m) (Unit ⊕ m) R)
    (M₂ : Matrix (Unit ⊕ n) (Unit ⊕ n) R)
    (h₁ : M₁.toBlocks₂₂.permanent = 1) (h₂ : M₂.toBlocks₂₂.permanent = 1) :
    (rootedMul M₁ M₂).toBlocks₂₂.permanent = 1 := by
  have hblk : (rootedMul M₁ M₂).toBlocks₂₂ =
      fromBlocks M₁.toBlocks₂₂ (of fun i => Sum.elim (M₁.toBlocks₂₁ i) 0) 0
        (fromBlocks (1 : Matrix Unit Unit R) M₂.toBlocks₁₂ 0 M₂.toBlocks₂₂) := by
    ext (i₁ | (⟨⟩ | i₂)) (j₁ | (⟨⟩ | j₂)) <;> rfl
  rw [hblk, permanent_fromBlocks_zero₂₁, permanent_fromBlocks_zero₂₁, permanent_one,
    h₁, h₂, mul_one, mul_one]

/-- Rooted permanent addition block matrix on `Unit ⊕ (m ⊕ (Unit ⊕ n))`. -/
def rootedAdd (M₁ : Matrix (Unit ⊕ m) (Unit ⊕ m) R) (M₂ : Matrix (Unit ⊕ n) (Unit ⊕ n) R) :
    Matrix (Unit ⊕ (m ⊕ (Unit ⊕ n))) (Unit ⊕ (m ⊕ (Unit ⊕ n))) R :=
  (fromBlocks
    M₁
    (fromBlocks M₂.toBlocks₁₁ M₂.toBlocks₁₂ 0 0)
    (fromBlocks (1 : Matrix Unit Unit R) 0 0 0)
    (fromBlocks (1 : Matrix Unit Unit R) 0 M₂.toBlocks₂₁ M₂.toBlocks₂₂)).submatrix
    (Equiv.sumAssoc Unit m (Unit ⊕ n)).symm
    (Equiv.sumAssoc Unit m (Unit ⊕ n)).symm

/-- If the internal blocks of `M₁` and `M₂` have permanent `1`, then so does the internal block of
`rootedAdd M₁ M₂`. -/
theorem permanent_toBlocks₂₂_rootedAdd (M₁ : Matrix (Unit ⊕ m) (Unit ⊕ m) R)
    (M₂ : Matrix (Unit ⊕ n) (Unit ⊕ n) R)
    (h₁ : M₁.toBlocks₂₂.permanent = 1) (h₂ : M₂.toBlocks₂₂.permanent = 1) :
    (rootedAdd M₁ M₂).toBlocks₂₂.permanent = 1 := by
  have hblk : (rootedAdd M₁ M₂).toBlocks₂₂ =
      fromBlocks M₁.toBlocks₂₂ 0 0
        (fromBlocks (1 : Matrix Unit Unit R) 0 M₂.toBlocks₂₁ M₂.toBlocks₂₂) := by
    ext (i₁ | (⟨⟩ | i₂)) (j₁ | (⟨⟩ | j₂)) <;> rfl
  rw [hblk, permanent_fromBlocks_zero, permanent_fromBlocks_zero₁₂, permanent_one,
    h₁, h₂, mul_one, mul_one]

/-- If the internal blocks of `M₁` and `M₂` have permanent `1`, then the permanent of
`rootedAdd M₁ M₂` is the sum of the permanents of `M₁` and `M₂`. -/
theorem permanent_rootedAdd (M₁ : Matrix (Unit ⊕ m) (Unit ⊕ m) R)
    (M₂ : Matrix (Unit ⊕ n) (Unit ⊕ n) R)
    (h₁ : M₁.toBlocks₂₂.permanent = 1) (h₂ : M₂.toBlocks₂₂.permanent = 1) :
    (rootedAdd M₁ M₂).permanent = M₁.permanent + M₂.permanent := by
  rw [rootedAdd, permanent_submatrix_equiv]
  let B₁ : Matrix ((Unit ⊕ m) ⊕ (Unit ⊕ n)) ((Unit ⊕ m) ⊕ (Unit ⊕ n)) R :=
    fromBlocks M₁ (fromBlocks M₂.toBlocks₁₁ M₂.toBlocks₁₂ 0 0) 0
      (fromBlocks (1 : Matrix Unit Unit R) 0 M₂.toBlocks₂₁ M₂.toBlocks₂₂)
  let B₂ : Matrix ((Unit ⊕ m) ⊕ (Unit ⊕ n)) ((Unit ⊕ m) ⊕ (Unit ⊕ n)) R :=
    fromBlocks M₁ (fromBlocks M₂.toBlocks₁₁ M₂.toBlocks₁₂ 0 0)
      (fromBlocks (1 : Matrix Unit Unit R) 0 0 0)
      (fromBlocks (0 : Matrix Unit Unit R) 0 M₂.toBlocks₂₁ M₂.toBlocks₂₂)
  rw [permanent_add_of_row_eq _ B₁ B₂ (Sum.inr (Sum.inl ()))
    (fun j => by rcases j with (⟨⟨⟩⟩ | j₁) | (⟨⟨⟩⟩ | j₂) <;> simp [B₁, B₂])
    (fun i hi j => by
      rcases i with (⟨⟨⟩⟩ | i₁) | (⟨⟨⟩⟩ | i₂)
      · rcases j with (⟨⟨⟩⟩ | j₁) | (⟨⟨⟩⟩ | j₂) <;> rfl
      · rcases j with (⟨⟨⟩⟩ | j₁) | (⟨⟨⟩⟩ | j₂) <;> rfl
      · exact (hi rfl).elim
      · rcases j with (⟨⟨⟩⟩ | j₁) | (⟨⟨⟩⟩ | j₂) <;> rfl)
    (fun i hi j => by
      rcases i with (⟨⟨⟩⟩ | i₁) | (⟨⟨⟩⟩ | i₂)
      · rcases j with (⟨⟨⟩⟩ | j₁) | (⟨⟨⟩⟩ | j₂) <;> rfl
      · rcases j with (⟨⟨⟩⟩ | j₁) | (⟨⟨⟩⟩ | j₂) <;> rfl
      · exact (hi rfl).elim
      · rcases j with (⟨⟨⟩⟩ | j₁) | (⟨⟨⟩⟩ | j₂) <;> rfl)]
  have hB₁ : B₁.permanent = M₁.permanent := by
    rw [permanent_fromBlocks_zero₂₁, permanent_fromBlocks_zero₁₂, permanent_one, h₂, mul_one,
      mul_one]
  have hB₂_swap : B₂.submatrix (swapRootEquiv m n) (Equiv.refl _) =
      fromBlocks (fromBlocks (1 : Matrix Unit Unit R) 0 M₁.toBlocks₂₁ M₁.toBlocks₂₂) 0
        (fromBlocks M₁.toBlocks₁₁ M₁.toBlocks₁₂ 0 0) M₂ := by
    ext ((⟨⟨⟩⟩ | i₁) | (⟨⟨⟩⟩ | i₂)) ((⟨⟨⟩⟩ | j₁) | (⟨⟨⟩⟩ | j₂)) <;> rfl
  have hB₂ : B₂.permanent = M₂.permanent := by
    rw [← permanent_submatrix_equiv_equiv (swapRootEquiv m n) (Equiv.refl _), hB₂_swap,
      permanent_fromBlocks_zero₁₂, permanent_fromBlocks_zero₁₂, permanent_one, h₁, mul_one,
      one_mul]
  rw [hB₁, hB₂]

end Matrix

namespace PermanentFoundation

open MvPolynomial Finset ResultantVNP

universe u

variable {n m : ℕ} {σ : Type}

namespace IsSubstMatrix

theorem rootedMul {α β : Type*}
    {M₁ : Matrix (Unit ⊕ α) (Unit ⊕ α) (MvPolynomial σ ℂ)}
    {M₂ : Matrix (Unit ⊕ β) (Unit ⊕ β) (MvPolynomial σ ℂ)}
    (h₁ : IsSubstMatrix M₁) (h₂ : IsSubstMatrix M₂) :
    IsSubstMatrix (Matrix.rootedMul M₁ M₂) :=
  (h₁.fromBlocks .zero (IsSubstMatrix.one.fromBlocks .zero .zero .zero) h₂).submatrix _ _

theorem rootedAdd {α β : Type*}
    {M₁ : Matrix (Unit ⊕ α) (Unit ⊕ α) (MvPolynomial σ ℂ)}
    {M₂ : Matrix (Unit ⊕ β) (Unit ⊕ β) (MvPolynomial σ ℂ)}
    (h₁ : IsSubstMatrix M₁) (h₂ : IsSubstMatrix M₂) :
    IsSubstMatrix (Matrix.rootedAdd M₁ M₂) :=
  (h₁.fromBlocks (h₂.toBlocks₁₁.fromBlocks h₂.toBlocks₁₂ .zero .zero)
    (IsSubstMatrix.one.fromBlocks .zero .zero .zero)
    (IsSubstMatrix.one.fromBlocks .zero h₂.toBlocks₂₁ h₂.toBlocks₂₂)).submatrix _ _

end IsSubstMatrix

/-- A polynomial `P` has a *rooted permanent representation* of internal dimension `m` if it is
the permanent of a `(1 + m) × (1 + m)` specialization matrix `M` on `Unit ⊕ Fin m` whose internal
block `M.toBlocks₂₂` has permanent `1`. -/
def IsRootedPermProjection (m : ℕ) (P : MvPolynomial σ ℂ) : Prop :=
  ∃ M : Matrix (Unit ⊕ Fin m) (Unit ⊕ Fin m) (MvPolynomial σ ℂ),
    IsSubstMatrix M ∧ M.toBlocks₂₂.permanent = 1 ∧ M.permanent = P

namespace IsRootedPermProjection

/-- A rooted permanent representation of internal dimension `m` gives a projection of the
`(m + 1) × (m + 1)` generic permanent. -/
theorem to_isProjection_permanent {m : ℕ} {P : MvPolynomial σ ℂ}
    (h : IsRootedPermProjection m P) :
    IsProjection P (genericMatrix (m + 1)).permanent := by
  obtain ⟨M, hM, -, rfl⟩ := h
  have e : Fin (m + 1) ≃ Unit ⊕ Fin m :=
    (finCongr (Nat.add_comm m 1)).trans
      (finSumFinEquiv.symm.trans (Equiv.sumCongr finOneEquiv (Equiv.refl _)))
  exact hM.isProjection_permanent e

/-- Every single-entry substitution `P` (a variable or constant) has a rooted permanent
representation of internal dimension `0`. -/
theorem of_isSubstEntry {P : MvPolynomial σ ℂ} (hP : IsSubstEntry P) :
    IsRootedPermProjection 0 P := by
  refine ⟨Matrix.fromBlocks (Matrix.of fun _ _ => P) 0 0 0,
    IsSubstMatrix.fromBlocks (fun _ _ => hP) .zero .zero .zero,
    Matrix.permanent_isEmpty, ?_⟩
  rw [Matrix.permanent_fromBlocks_zero, Matrix.permanent_unique, Matrix.permanent_isEmpty, mul_one]
  rfl

/-- Every constant `C c` has a rooted permanent representation of internal dimension `0`. -/
theorem C (c : ℂ) : IsRootedPermProjection 0 (MvPolynomial.C c : MvPolynomial σ ℂ) :=
  .of_isSubstEntry (.C c)

/-- Every variable `X i` has a rooted permanent representation of internal dimension `0`. -/
theorem X (i : σ) : IsRootedPermProjection 0 (MvPolynomial.X i : MvPolynomial σ ℂ) :=
  .of_isSubstEntry (.X i)

/-- Equivalence `Fin (m₁ + 1 + m₂) ≃ Fin m₁ ⊕ (Unit ⊕ Fin m₂)` used to flatten internal blocks of
rooted permanent representations. -/
def innerEquiv (m₁ m₂ : ℕ) : Fin (m₁ + 1 + m₂) ≃ Fin m₁ ⊕ (Unit ⊕ Fin m₂) :=
  (finCongr (Nat.add_assoc m₁ 1 m₂)).trans
    (finSumFinEquiv.symm.trans
      (Equiv.sumCongr (Equiv.refl _)
        (finSumFinEquiv.symm.trans (Equiv.sumCongr finOneEquiv (Equiv.refl _)))))

/-- Equivalence `Unit ⊕ Fin (m₁ + 1 + m₂) ≃ Unit ⊕ (Fin m₁ ⊕ (Unit ⊕ Fin m₂))`. -/
def outerEquiv (m₁ m₂ : ℕ) :
    Unit ⊕ Fin (m₁ + 1 + m₂) ≃ Unit ⊕ (Fin m₁ ⊕ (Unit ⊕ Fin m₂)) :=
  Equiv.sumCongr (Equiv.refl Unit) (innerEquiv m₁ m₂)

/-- **Additive closure of rooted permanent representations**: if `P` and `Q` have rooted permanent
representations of internal dimensions `m₁` and `m₂`, then `P + Q` has one of internal dimension
`m₁ + 1 + m₂`. -/
theorem add {m₁ m₂ : ℕ} {P Q : MvPolynomial σ ℂ}
    (hP : IsRootedPermProjection m₁ P) (hQ : IsRootedPermProjection m₂ Q) :
    IsRootedPermProjection (m₁ + 1 + m₂) (P + Q) := by
  obtain ⟨M₁, hM₁, hU₁, rfl⟩ := hP
  obtain ⟨M₂, hM₂, hU₂, rfl⟩ := hQ
  refine ⟨(Matrix.rootedAdd M₁ M₂).submatrix (outerEquiv m₁ m₂) (outerEquiv m₁ m₂),
    (hM₁.rootedAdd hM₂).submatrix _ _, ?_, ?_⟩
  · have hblk : ((Matrix.rootedAdd M₁ M₂).submatrix
        (outerEquiv m₁ m₂) (outerEquiv m₁ m₂)).toBlocks₂₂ =
        (Matrix.rootedAdd M₁ M₂).toBlocks₂₂.submatrix (innerEquiv m₁ m₂) (innerEquiv m₁ m₂) := rfl
    rw [hblk, Matrix.permanent_submatrix_equiv, Matrix.permanent_toBlocks₂₂_rootedAdd M₁ M₂ hU₁ hU₂]
  · rw [Matrix.permanent_submatrix_equiv, Matrix.permanent_rootedAdd M₁ M₂ hU₁ hU₂]

/-- **Multiplicative closure of rooted permanent representations**: if `P` and `Q` have rooted
permanent representations of internal dimensions `m₁` and `m₂`, then `P * Q` has one of internal
dimension `m₁ + 1 + m₂`. -/
theorem mul {m₁ m₂ : ℕ} {P Q : MvPolynomial σ ℂ}
    (hP : IsRootedPermProjection m₁ P) (hQ : IsRootedPermProjection m₂ Q) :
    IsRootedPermProjection (m₁ + 1 + m₂) (P * Q) := by
  obtain ⟨M₁, hM₁, hU₁, rfl⟩ := hP
  obtain ⟨M₂, hM₂, hU₂, rfl⟩ := hQ
  refine ⟨(Matrix.rootedMul M₁ M₂).submatrix (outerEquiv m₁ m₂) (outerEquiv m₁ m₂),
    (hM₁.rootedMul hM₂).submatrix _ _, ?_, ?_⟩
  · have hblk : ((Matrix.rootedMul M₁ M₂).submatrix
        (outerEquiv m₁ m₂) (outerEquiv m₁ m₂)).toBlocks₂₂ =
        (Matrix.rootedMul M₁ M₂).toBlocks₂₂.submatrix (innerEquiv m₁ m₂) (innerEquiv m₁ m₂) := rfl
    rw [hblk, Matrix.permanent_submatrix_equiv, Matrix.permanent_toBlocks₂₂_rootedMul M₁ M₂ hU₁ hU₂]
  · rw [Matrix.permanent_submatrix_equiv, Matrix.permanent_rootedMul M₁ M₂]

end IsRootedPermProjection


theorem Formula.rooted (F : Formula σ) : IsRootedPermProjection F.size F.value := by
  induction F with
  | var i => exact .X i
  | const c => exact .C c
  | add p q hp hq => exact hp.add hq
  | mul p q hp hq => exact hp.mul hq

/-- Every formula is a projection of a permanent with one more row than its gate count. -/
theorem Formula.isProjection_permanent (F : Formula σ) :
    ResultantVNP.IsProjection F.value (genericMatrix (F.size+1)).permanent :=
  F.rooted.to_isProjection_permanent

end PermanentFoundation


-- From Solutions.CircuitFormulaUnfold

namespace CircuitFormulaUnfold

open ResultantVNP PermanentFoundation MvPolynomial

variable {σ : Type}

/-- Rebuild one circuit node as a formula, duplicating previously constructed
    subformulas whenever a gate reuses an input. -/
noncomputable def nodeFormula (vals : List (Formula σ)) : Node σ → Formula σ
  | .var x => .var x
  | .const a => .const a
  | .add i j => .add (vals.getD i (.const 0)) (vals.getD j (.const 0))
  | .mul i j => .mul (vals.getD i (.const 0)) (vals.getD j (.const 0))

noncomputable def formulaValues (C : Circuit σ) : List (Formula σ) :=
  C.nodes.foldl (fun vals nd => vals ++ [nodeFormula vals nd]) []

noncomputable def circuitFormula (C : Circuit σ) : Formula σ :=
  (formulaValues C).getLastD (.const 0)

theorem nodeFormula_value (vals : List (Formula σ)) (nd : Node σ) :
    (nodeFormula vals nd).value = nd.eval (vals.map Formula.value) := by
  have hg (i : ℕ) : (vals.map Formula.value).getD i 0 =
      (vals.getD i (.const 0)).value := by
    simpa [Formula.value] using
      (List.getD_map (l := vals) (d := (Formula.const 0)) (n := i) Formula.value)
  cases nd with
  | var x => rfl
  | const a => rfl
  | add i j => simp only [nodeFormula, Node.eval, Formula.value, hg]
  | mul i j => simp only [nodeFormula, Node.eval, Formula.value, hg]

theorem formula_fold_value (nodes : List (Node σ)) (vals : List (Formula σ)) :
    (nodes.foldl (fun fs nd => fs ++ [nodeFormula fs nd]) vals).map Formula.value =
      nodes.foldl (fun ps nd => ps ++ [nd.eval ps]) (vals.map Formula.value) := by
  induction nodes generalizing vals with
  | nil => rfl
  | cons nd rest ih =>
    simp only [List.foldl_cons]
    rw [ih]
    simp only [List.map_append, List.map_cons, List.map_nil, nodeFormula_value]

theorem formulaValues_value (C : Circuit σ) :
    (formulaValues C).map Formula.value = C.values := by
  simpa [formulaValues, Circuit.values] using formula_fold_value C.nodes []

private theorem getD_formula_bound (vals : List (Formula σ)) (B : ℕ) (hB : 1 ≤ B)
    (hvals : ∀ F ∈ vals, F.size + 1 ≤ B) (i : ℕ) :
    (vals.getD i (.const 0)).size + 1 ≤ B := by
  by_cases hi : i < vals.length
  · rw [List.getD_eq_getElem _ _ hi]
    exact hvals _ (List.getElem_mem hi)
  · rw [List.getD_eq_default _ _ (by omega)]
    simpa [Formula.size] using hB

/-- Each unfolded node grows by at most a factor of two per arithmetic gate;
    leaves do not contribute to the exponent. -/
theorem formula_fold_size_bound (nodes : List (Node σ)) (vals : List (Formula σ))
    (B : ℕ) (hB : 1 ≤ B) (hvals : ∀ F ∈ vals, F.size + 1 ≤ B) :
    ∀ F ∈ nodes.foldl (fun fs nd => fs ++ [nodeFormula fs nd]) vals,
      F.size + 1 ≤ B * 2 ^ nodes.countP Node.isGate := by
  induction nodes generalizing vals B with
  | nil => simpa using hvals
  | cons nd rest ih =>
    let D := B * (if nd.isGate then 2 else 1)
    have hD : 1 ≤ D := by cases nd <;> simp [D, Node.isGate] <;> omega
    have hstep : ∀ F ∈ vals ++ [nodeFormula vals nd], F.size + 1 ≤ D := by
      intro F hF
      simp only [List.mem_append, List.mem_singleton] at hF
      rcases hF with hF | rfl
      · have hf := hvals F hF
        cases nd <;> simp [D, Node.isGate] <;> omega
      · cases nd with
        | var x => simp [D, Node.isGate, nodeFormula, Formula.size]; omega
        | const c => simp [D, Node.isGate, nodeFormula, Formula.size]; omega
        | add i j =>
          have hi := getD_formula_bound vals B hB hvals i
          have hj := getD_formula_bound vals B hB hvals j
          simp only [D, Node.isGate, Bool.true_eq, if_true, nodeFormula, Formula.size]
          omega
        | mul i j =>
          have hi := getD_formula_bound vals B hB hvals i
          have hj := getD_formula_bound vals B hB hvals j
          simp only [D, Node.isGate, Bool.true_eq, if_true, nodeFormula, Formula.size]
          omega
    have hout := ih (vals ++ [nodeFormula vals nd]) D hD hstep
    intro F hF
    have hh := hout F hF
    cases nd <;> simpa [D, Node.isGate, List.countP_cons, pow_succ, mul_assoc, mul_comm,
      mul_left_comm] using hh

/-- Unfolding a circuit preserves its value. This does not claim polynomial
    formula size; shared subcircuits can be duplicated many times. -/
theorem circuitFormula_value (C : Circuit σ) : (circuitFormula C).value = C.value := by
  unfold circuitFormula Circuit.value
  have hh := List.getLastD_map (f := Formula.value) (l := formulaValues C) (a := Formula.const 0)
  simp only [Formula.value, map_zero, formulaValues_value] at hh
  exact hh.symm

/-- Naive circuit unfolding is bounded exponentially in the actual gate
    count, independently of how many unused leaves the circuit contains. -/
theorem circuitFormula_size_bound (C : Circuit σ) :
    (circuitFormula C).size + 1 ≤ 2 ^ C.size := by
  have hh := formula_fold_size_bound C.nodes [] 1 (by omega) (by simp)
  have hvals : ∀ F ∈ formulaValues C, F.size + 1 ≤ 2 ^ C.size := by
    simpa [formulaValues, Circuit.size] using hh
  cases hv : formulaValues C with
  | nil =>
    simp [circuitFormula, hv, Formula.size, Nat.one_le_pow]
  | cons F rest =>
    apply hvals
    rw [hv]
    simpa only [circuitFormula, hv, List.getLastD_cons] using
      (List.getLastD_mem_cons (l := rest) (a := F))


end CircuitFormulaUnfold

-- From Solutions.CircuitParseTrees

namespace CircuitParseTrees

open MvPolynomial ResultantVNP PermanentFoundation CircuitFormulaUnfold

variable {σ : Type}

/-- A parse tree has only product gates; additive choices are made before the
    tree is produced. -/
def ProductTree : Formula σ → Prop
  | .var _ | .const _ => True
  | .add _ _ => False
  | .mul p q => ProductTree p ∧ ProductTree q

/-- Enumerate parse trees with multiplicity: addition chooses one branch,
    while multiplication pairs one tree from each input. -/
def parseTrees : Formula σ → List (Formula σ)
  | .var x => [.var x]
  | .const a => [.const a]
  | .add p q => parseTrees p ++ parseTrees q
  | .mul p q => (parseTrees p).flatMap fun a => (parseTrees q).map fun b => .mul a b

/-- Formal degree counts each leaf as one, takes the maximum at sums and
    adds degrees at products. It is syntactic and can exceed actual degree. -/
def formalDegree : Formula σ → ℕ
  | .var _ | .const _ => 1
  | .add p q => max (formalDegree p) (formalDegree q)
  | .mul p q => formalDegree p + formalDegree q

theorem productTree_size (T : Formula σ) (h : ProductTree T) :
    T.size + 1 = formalDegree T := by
  induction T with
  | var x => rfl
  | const a => rfl
  | add p q hp hq => exact h.elim
  | mul p q hp hq =>
    simp only [ProductTree] at h
    simp only [Formula.size, formalDegree]
    have h1 := hp h.1
    have h2 := hq h.2
    omega

/-- Every parse tree has formal degree at most that of its source. -/
theorem parseTrees_formalDegree_le (F T : Formula σ) (h : T ∈ parseTrees F) :
    formalDegree T ≤ formalDegree F := by
  induction F generalizing T with
  | var x =>
    simp only [parseTrees, List.mem_singleton] at h
    subst T; rfl
  | const a =>
    simp only [parseTrees, List.mem_singleton] at h
    subst T; rfl
  | add p q hp hq =>
    simp only [parseTrees, List.mem_append] at h
    rcases h with h | h
    · exact (hp T h).trans (le_max_left _ _)
    · exact (hq T h).trans (le_max_right _ _)
  | mul p q hp hq =>
    simp only [parseTrees, List.mem_flatMap, List.mem_map] at h
    obtain ⟨a,ha,b,hb,rfl⟩ := h
    simp only [formalDegree]
    exact Nat.add_le_add (hp a ha) (hq b hb)

theorem parseTrees_product (F T : Formula σ) (h : T ∈ parseTrees F) : ProductTree T := by
  induction F generalizing T with
  | var x =>
    simp only [parseTrees, List.mem_singleton] at h
    subst T
    trivial
  | const a =>
    simp only [parseTrees, List.mem_singleton] at h
    subst T
    trivial
  | add p q hp hq =>
    simp only [parseTrees, List.mem_append] at h
    rcases h with h | h
    · exact hp T h
    · exact hq T h
  | mul p q hp hq =>
    simp only [parseTrees, List.mem_flatMap, List.mem_map] at h
    obtain ⟨a,ha,b,hb,rfl⟩ := h
    exact ⟨hp a ha,hq b hb⟩

/-- Syntactically bounded degree bounds the size of each product parse tree. -/
theorem parseTrees_size_le_formalDegree (F T : Formula σ) (h : T ∈ parseTrees F) :
    T.size + 1 ≤ formalDegree F := by
  rw [productTree_size T (parseTrees_product F T h)]
  exact parseTrees_formalDegree_le F T h

private theorem sum_pairwise_products (as bs : List (MvPolynomial σ ℂ)) :
    ((as.flatMap fun a => bs.map fun b => a * b)).sum = as.sum * bs.sum := by
  induction as with
  | nil => simp
  | cons a as ih =>
    simp only [List.flatMap_cons, List.sum_append, List.sum_cons]
    rw [show (List.map (fun b => a * b) bs).sum = a * bs.sum by
      simpa using List.sum_map_mul_left bs id a]
    rw [ih, add_mul]

/-- A formula equals the sum of the products computed by its parse trees;
    repeated parse trees remain repeated summands. -/
theorem parseTrees_sum (F : Formula σ) :
    ((parseTrees F).map Formula.value).sum = F.value := by
  induction F with
  | var x => simp [parseTrees, Formula.value]
  | const a => simp [parseTrees, Formula.value]
  | add p q hp hq => simp [parseTrees, Formula.value, hp, hq]
  | mul p q hp hq =>
    have he : ((parseTrees (.mul p q)).map Formula.value) =
        ((parseTrees p).map Formula.value).flatMap
          (fun a => ((parseTrees q).map Formula.value).map (fun b => a * b)) := by
      simp [parseTrees, Formula.value, List.map_flatMap, List.flatMap_map, List.map_map, Function.comp_def]
    rw [he, sum_pairwise_products, hp, hq]
    rfl

/-- Every circuit is the sum of its unfolded parse trees. This identity alone
    carries no polynomial bound on the number or encoding size of the trees. -/
theorem circuit_parseTrees_sum (C : Circuit σ) :
    ((parseTrees (circuitFormula C)).map Formula.value).sum = C.value := by
  rw [parseTrees_sum, circuitFormula_value]

/-- Repeated squaring used to expose the gap between formal and actual degree. -/
def squaringFormula : ℕ → Formula Unit
  | 0 => .var ()
  | n + 1 => .mul (squaringFormula n) (squaringFormula n)

theorem squaringFormula_formalDegree (n : ℕ) : formalDegree (squaringFormula n) = 2 ^ n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [squaringFormula, formalDegree, ih, pow_succ]; omega

/-- Cancellation can leave a constant output while the input expression has
    exponentially large formal degree, so actual degree alone is not a
    valid parse-tree size bound without a normalization step. -/
theorem cancellation_formalDegree_gap (n : ℕ) :
    ∃ F : Formula Unit, F.value = 1 ∧ 2 ^ n ≤ formalDegree F := by
  let P := squaringFormula n
  let F : Formula Unit := .add (.add P (.mul (.const (-1)) P)) (.const 1)
  refine ⟨F,?_,?_⟩
  · simp only [F, Formula.value, map_neg, map_one]
    ring
  · change 2 ^ n ≤ max (max (formalDegree P) (1 + formalDegree P)) 1
    rw [show formalDegree P = 2 ^ n from squaringFormula_formalDegree n]
    omega


end CircuitParseTrees

-- From Solutions.CircuitNormalizedFormula

namespace CircuitNormalizedFormula

open MvPolynomial PermanentFoundation CircuitPositiveComponents CircuitDegreeTruncation CircuitParseTrees
  CircuitFormulaUnfold ResultantVNP

variable {σ : Type}

/-- Build a sum of a finite indexed family of formulas. -/
def formulaSum : ℕ → (ℕ → Formula σ) → Formula σ
  | 0, _ => .const 0
  | n + 1, f => .add (formulaSum n f) (f n)

theorem formulaSum_value (n : ℕ) (f : ℕ → Formula σ) :
    (formulaSum n f).value = ∑ i ∈ Finset.range n, (f i).value := by
  induction n with
  | zero => simp [formulaSum, Formula.value]
  | succ n ih => simp [formulaSum, Formula.value, ih, Finset.sum_range_succ]

/-- A syntactic formula for the homogeneous component. Constant components
    are replaced by single constants, and positive product components are
    expanded using strictly positive interior degrees. -/
noncomputable def componentFormula : Formula σ → ℕ → Formula σ
  | F, 0 => .const (coeff 0 F.value)
  | .var x, k + 1 => if k = 0 then .var x else .const 0
  | .const _, _ + 1 => .const 0
  | .add p q, k + 1 => .add (componentFormula p (k + 1)) (componentFormula q (k + 1))
  | .mul p q, k + 1 =>
      .add (.add (.mul (.const (coeff 0 p.value)) (componentFormula q (k + 1)))
        (formulaSum k fun i => .mul (componentFormula p (i + 1)) (componentFormula q (k - i))))
        (.mul (componentFormula p (k + 1)) (.const (coeff 0 q.value)))

theorem componentFormula_value (F : Formula σ) (k : ℕ) :
    (componentFormula F k).value = homogeneousComponent k F.value := by
  classical
  induction F generalizing k with
  | var x =>
    cases k with
    | zero => simp [componentFormula, Formula.value]
    | succ k =>
      simp only [componentFormula, homogeneousComponent_variable, Formula.value]
      split <;> rename_i h <;> simp_all [Formula.value]
  | const a =>
    cases k with
    | zero => simp [componentFormula, Formula.value]
    | succ k => simp [componentFormula, Formula.value, homogeneousComponent_constant]
  | add p q hp hq =>
    cases k with
    | zero => simp [componentFormula, Formula.value]
    | succ k => simp [componentFormula, Formula.value, hp, hq, homogeneousComponent_add]
  | mul p q hp hq =>
    cases k with
    | zero => simp [componentFormula, Formula.value]
    | succ k =>
      simp only [componentFormula, Formula.value, formulaSum_value, hp, hq]
      exact (positive_component_mul k p.value q.value).symm

/-- Depth, unlike formula size, is preserved when shared circuit gates are
    unfolded; it is at most linear in the number of circuit nodes. -/
def formulaDepth : Formula σ → ℕ
  | .var _ | .const _ => 1
  | .add p q | .mul p q => max (formulaDepth p) (formulaDepth q) + 1

theorem formulaSum_depth (n B : ℕ) (f : ℕ → Formula σ) (hB : 1 ≤ B)
    (h : ∀ i < n, formulaDepth (f i) ≤ B) :
    formulaDepth (formulaSum n f) ≤ B + n := by
  induction n with
  | zero => simpa [formulaSum, formulaDepth] using hB
  | succ n ih =>
    simp only [formulaSum, formulaDepth]
    have hn := ih (fun i hi => h i (by omega))
    have hn' := h n (by omega)
    omega

/-- Along any branch, homogenization increases depth by at most a factor
    linear in the target degree. -/
theorem componentFormula_depth (F : Formula σ) (k : ℕ) :
    formulaDepth (componentFormula F k) ≤ formulaDepth F * (k + 3) + 1 := by
  classical
  induction F generalizing k with
  | var x =>
    cases k with
    | zero => simp [componentFormula, formulaDepth]
    | succ k =>
      simp only [componentFormula, formulaDepth]
      split <;> simp [formulaDepth]
  | const a => cases k <;> simp [componentFormula, formulaDepth]
  | add p q hp hq =>
    cases k with
    | zero => simp [componentFormula, formulaDepth]
    | succ k =>
      simp only [componentFormula, formulaDepth]
      have h₁ := hp (k + 1)
      have h₂ := hq (k + 1)
      have hd₁ := le_max_left (formulaDepth p) (formulaDepth q)
      have hd₂ := le_max_right (formulaDepth p) (formulaDepth q)
      have hm : max (formulaDepth (componentFormula p (k + 1)))
          (formulaDepth (componentFormula q (k + 1))) ≤
          max (formulaDepth p) (formulaDepth q) * (k + 4) + 1 := by
        apply max_le <;> nlinarith
      nlinarith
  | mul p q hp hq =>
    cases k with
    | zero => simp [componentFormula, formulaDepth]
    | succ k =>
      simp only [componentFormula, formulaDepth]
      let D := max (formulaDepth p) (formulaDepth q)
      have hd₁ : formulaDepth p ≤ D := le_max_left _ _
      have hd₂ : formulaDepth q ≤ D := le_max_right _ _
      have h₁ := hp (k + 1)
      have h₂ := hq (k + 1)
      have hsum : formulaDepth (formulaSum k fun i =>
          Formula.mul (componentFormula p (i + 1)) (componentFormula q (k - i))) ≤
          D * (k + 4) + 2 + k := by
        apply formulaSum_depth _ _ _ (by omega)
        intro i hi
        simp only [formulaDepth]
        have h₃ := hp (i + 1)
        have h₄ := hq (k - i)
        have hsub : k - i ≤ k := Nat.sub_le _ _
        have hm : max (formulaDepth (componentFormula p (i + 1)))
            (formulaDepth (componentFormula q (k - i))) ≤ D * (k + 4) + 1 := by
          apply max_le <;> nlinarith
        omega
      have hl : max 1 (formulaDepth (componentFormula q (k + 1))) ≤ D * (k + 4) + 1 := by
        apply max_le <;> nlinarith
      have hr : max (formulaDepth (componentFormula p (k + 1))) 1 ≤ D * (k + 4) + 1 := by
        apply max_le <;> nlinarith
      have hm : max (max 1 (formulaDepth (componentFormula q (k + 1))) + 1) 
          (formulaDepth (formulaSum k fun i =>
            Formula.mul (componentFormula p (i + 1)) (componentFormula q (k - i)))) ≤
          D * (k + 4) + k + 2 := by omega
      have hm' : max (max (max 1 (formulaDepth (componentFormula q (k + 1))) + 1)
          (formulaDepth (formulaSum k fun i =>
            Formula.mul (componentFormula p (i + 1)) (componentFormula q (k - i)))) + 1)
          (max (formulaDepth (componentFormula p (k + 1))) 1 + 1) ≤
          D * (k + 4) + k + 3 := by omega
      change _ ≤ (D + 1) * (k + 1 + 3) + 1
      nlinarith

theorem formulaSum_formalDegree (n B : ℕ) (f : ℕ → Formula σ) (hB : 1 ≤ B)
    (h : ∀ i < n, formalDegree (f i) ≤ B) :
    formalDegree (formulaSum n f) ≤ B := by
  induction n with
  | zero => simpa [formulaSum, formalDegree] using hB
  | succ n ih =>
    simp only [formulaSum, formalDegree, max_le_iff]
    exact ⟨ih (fun i hi => h i (by omega)), h n (by omega)⟩

/-- Normalization bounds the size of each product parse tree by a polynomial
    in the formula depth and the selected homogeneous degree. -/
theorem componentFormula_formalDegree (F : Formula σ) (k : ℕ) :
    formalDegree (componentFormula F k) ≤ formulaDepth F * k + 1 := by
  classical
  induction F generalizing k with
  | var x =>
    cases k with
    | zero => simp [componentFormula, formalDegree, formulaDepth]
    | succ k =>
      simp only [componentFormula, formulaDepth]
      split <;> simp [formalDegree]
  | const a =>
    cases k <;> simp [componentFormula, formalDegree, formulaDepth]
  | add p q hp hq =>
    cases k with
    | zero => simp [componentFormula, formalDegree, formulaDepth]
    | succ k =>
      simp only [componentFormula, formalDegree, formulaDepth, max_le_iff]
      constructor
      · have h := hp (k + 1)
        have hm := le_max_left (formulaDepth p) (formulaDepth q)
        nlinarith
      · have h := hq (k + 1)
        have hm := le_max_right (formulaDepth p) (formulaDepth q)
        nlinarith
  | mul p q hp hq =>
    cases k with
    | zero => simp [componentFormula, formalDegree, formulaDepth]
    | succ k =>
      simp only [componentFormula, formalDegree, formulaDepth, max_le_iff]
      have hd₁ := le_max_left (formulaDepth p) (formulaDepth q)
      have hd₂ := le_max_right (formulaDepth p) (formulaDepth q)
      have hb : 1 ≤ (max (formulaDepth p) (formulaDepth q) + 1) * (k + 1) + 1 := by omega
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · have h := hq (k + 1)
        nlinarith
      · apply formulaSum_formalDegree _ _ _ hb
        intro i hi
        simp only [formalDegree]
        have hi' := Finset.mem_range.mp (show i ∈ Finset.range k from Finset.mem_range.mpr hi)
        have h₁ := hp (i + 1)
        have h₂ := hq (k - i)
        have he : (i + 1) + (k - i) = k + 1 := by omega
        nlinarith
      · have h := hp (k + 1)
        nlinarith

private theorem getD_depth_bound (vals : List (Formula σ)) (B : ℕ) (hB : 1 ≤ B)
    (hvals : ∀ F ∈ vals, formulaDepth F ≤ B) (i : ℕ) :
    formulaDepth (vals.getD i (.const 0)) ≤ B := by
  by_cases hi : i < vals.length
  · rw [List.getD_eq_getElem _ _ hi]
    exact hvals _ (List.getElem_mem hi)
  · rw [List.getD_eq_default _ _ (by omega)]
    simpa [formulaDepth] using hB

/-- Unfolding increases depth at most once per arithmetic gate, even if the
    circuit has arbitrarily many input nodes. -/
theorem formula_fold_depth_bound (nodes : List (Node σ)) (vals : List (Formula σ))
    (B : ℕ) (hB : 1 ≤ B) (hvals : ∀ F ∈ vals, formulaDepth F ≤ B) :
    ∀ F ∈ nodes.foldl (fun fs nd => fs ++ [nodeFormula fs nd]) vals,
      formulaDepth F ≤ B + nodes.countP Node.isGate := by
  induction nodes generalizing vals B with
  | nil => simpa using hvals
  | cons nd rest ih =>
    let D := B + (if nd.isGate then 1 else 0)
    have hD : 1 ≤ D := by cases nd <;> simp [D, Node.isGate] <;> omega
    have hstep : ∀ F ∈ vals ++ [nodeFormula vals nd], formulaDepth F ≤ D := by
      intro F hF
      simp only [List.mem_append, List.mem_singleton] at hF
      rcases hF with hF | rfl
      · have hf := hvals F hF
        cases nd <;> simp [D, Node.isGate] <;> omega
      · cases nd with
        | var x => simp [D, Node.isGate, nodeFormula, formulaDepth]; omega
        | const c => simp [D, Node.isGate, nodeFormula, formulaDepth]; omega
        | add i j =>
          have hi := getD_depth_bound vals B hB hvals i
          have hj := getD_depth_bound vals B hB hvals j
          simp only [D, Node.isGate, if_true, nodeFormula, formulaDepth]
          omega
        | mul i j =>
          have hi := getD_depth_bound vals B hB hvals i
          have hj := getD_depth_bound vals B hB hvals j
          simp only [D, Node.isGate, if_true, nodeFormula, formulaDepth]
          omega
    have hout := ih (vals ++ [nodeFormula vals nd]) D hD hstep
    intro F hF
    have hh := hout F hF
    cases nd <;> simpa [D, Node.isGate, List.countP_cons, Nat.add_assoc,
      Nat.add_comm, Nat.add_left_comm] using hh

theorem circuitFormula_depth_bound (C : Circuit σ) :
    formulaDepth (circuitFormula C) ≤ C.size + 1 := by
  have hh := formula_fold_depth_bound C.nodes [] 1 (by omega) (by simp)
  have hvals : ∀ F ∈ formulaValues C, formulaDepth F ≤ C.size + 1 := by
    simpa [formulaValues, Circuit.size, Nat.add_comm] using hh
  cases hv : formulaValues C with
  | nil => simp [circuitFormula, hv, formulaDepth]
  | cons F rest =>
    apply hvals
    rw [hv]
    simpa only [circuitFormula, hv, List.getLastD_cons] using
      (List.getLastD_mem_cons (l := rest) (a := F))

/-- The degree-k component is a sum of product parse trees, each with at most
    `(gate count + 1) * k` multiplication nodes. Multiplicities are retained. -/
theorem circuit_component_parseTrees (C : Circuit σ) (k : ℕ) :
    let F := componentFormula (circuitFormula C) k
    ((parseTrees F).map Formula.value).sum = homogeneousComponent k C.value ∧
    ∀ T ∈ parseTrees F, T.size ≤ (C.size + 1) * k := by
  dsimp only
  constructor
  · rw [parseTrees_sum, componentFormula_value, circuitFormula_value]
  · intro T hT
    have ht := parseTrees_size_le_formalDegree _ T hT
    have hn := componentFormula_formalDegree (circuitFormula C) k
    have hd := circuitFormula_depth_bound C
    nlinarith

/-- Sum the normalized homogeneous components through a chosen degree. -/
noncomputable def boundedCircuitFormula (C : Circuit σ) (d : ℕ) : Formula σ :=
  formulaSum (d + 1) fun k => componentFormula (circuitFormula C) k

/-- Every path through the normalized formula is polynomially bounded in
    the circuit's gate count and the degree cutoff. -/
theorem boundedCircuitFormula_depth (C : Circuit σ) (d : ℕ) :
    formulaDepth (boundedCircuitFormula C d) ≤ (C.size + 1) * (d + 3) + d + 2 := by
  unfold boundedCircuitFormula
  have h := formulaSum_depth (d + 1) ((C.size + 1) * (d + 3) + 1)
    (fun k => componentFormula (circuitFormula C) k) (by omega) (by
      intro k hk
      have hn := componentFormula_depth (circuitFormula C) k
      have hd := circuitFormula_depth_bound C
      nlinarith)
  omega

/-- A circuit whose output has actual degree at most `d` equals a sum of
    product trees of size at most `(gate count + 1) * d`. The full list can
    still be exponentially long and is not itself a VNP witness. -/
theorem bounded_circuit_parseTrees [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d) :
    ((parseTrees (boundedCircuitFormula C d)).map Formula.value).sum = C.value ∧
    ∀ T ∈ parseTrees (boundedCircuitFormula C d), T.size ≤ (C.size + 1) * d := by
  constructor
  · rw [parseTrees_sum]
    simp only [boundedCircuitFormula, formulaSum_value, componentFormula_value, circuitFormula_value]
    exact truncate_eq_self d C.value hdegree
  · intro T hT
    have ht := parseTrees_size_le_formalDegree _ T hT
    have hf : formalDegree (boundedCircuitFormula C d) ≤ (C.size + 1) * d + 1 := by
      unfold boundedCircuitFormula
      apply formulaSum_formalDegree _ _ _ (by omega)
      intro k hk
      have hn := componentFormula_formalDegree (circuitFormula C) k
      have hd := circuitFormula_depth_bound C
      nlinarith
    omega


end CircuitNormalizedFormula

-- From Solutions.NormalizedAddresses

/-! A defunctionalized description of the normalized formula. Each address
    exposes one node and at most two child addresses without expanding the
    whole formula. The `Formula` parameters here still have to be replaced
    by indices in a compact source circuit. -/

namespace NormalizedAddresses

open PermanentFoundation CircuitNormalizedFormula MvPolynomial

variable {σ : Type}

inductive Address (σ : Type) where
  | root (F : Formula σ) (n : ℕ)
  | component (F : Formula σ) (k : ℕ)
  | inner (p q : Formula σ) (k : ℕ)
  | leftProduct (p q : Formula σ) (k : ℕ)
  | rightProduct (p q : Formula σ) (k : ℕ)
  | convolution (p q : Formula σ) (k n : ℕ)
  | convolutionTerm (p q : Formula σ) (k i : ℕ)
  | constantPart (F : Formula σ)

noncomputable def expand : Address σ → Formula σ
  | .root F n => formulaSum n (fun k => componentFormula F k)
  | .component F k => componentFormula F k
  | .inner p q k => .add (.mul (.const (coeff 0 p.value)) (componentFormula q (k+1)))
      (formulaSum k fun i => .mul (componentFormula p (i+1)) (componentFormula q (k-i)))
  | .leftProduct p q k => .mul (.const (coeff 0 p.value)) (componentFormula q (k+1))
  | .rightProduct p q k => .mul (componentFormula p (k+1)) (.const (coeff 0 q.value))
  | .convolution p q k n =>
      formulaSum n fun i => .mul (componentFormula p (i+1)) (componentFormula q (k-i))
  | .convolutionTerm p q k i => .mul (componentFormula p (i+1)) (componentFormula q (k-i))
  | .constantPart F => .const (coeff 0 F.value)

inductive View (σ : Type) where
  | var (x : σ)
  | const (a : ℂ)
  | add (p q : Address σ)
  | mul (p q : Address σ)

/-- Reveal just the outermost constructor of a normalized formula. -/
noncomputable def view : Address σ → View σ
  | .root _ 0 => .const 0
  | .root F (n+1) => .add (.root F n) (.component F n)
  | .component F 0 => .const (coeff 0 F.value)
  | .component (.var x) (k+1) => if k = 0 then .var x else .const 0
  | .component (.const _) (_+1) => .const 0
  | .component (.add p q) (k+1) => .add (.component p (k+1)) (.component q (k+1))
  | .component (.mul p q) (k+1) => .add (.inner p q k) (.rightProduct p q k)
  | .inner p q k => .add (.leftProduct p q k) (.convolution p q k k)
  | .leftProduct p q k => .mul (.constantPart p) (.component q (k+1))
  | .rightProduct p q k => .mul (.component p (k+1)) (.constantPart q)
  | .convolution _ _ _ 0 => .const 0
  | .convolution p q k (n+1) => .add (.convolution p q k n) (.convolutionTerm p q k n)
  | .convolutionTerm p q k i => .mul (.component p (i+1)) (.component q (k-i))
  | .constantPart F => .const (coeff 0 F.value)

noncomputable def View.formula : View σ → Formula σ
  | .var x => .var x
  | .const a => .const a
  | .add p q => .add (expand p) (expand q)
  | .mul p q => .mul (expand p) (expand q)

/-- Address expansion is exactly compatible with its one-step view. -/
theorem view_correct (a : Address σ) : (view a).formula = expand a := by
  cases a with
  | root F n => cases n <;> rfl
  | component F k =>
    cases k with
    | zero => cases F <;> rfl
    | succ k =>
      cases F with
      | var x => by_cases h : k = 0 <;> simp [view, View.formula, expand, componentFormula, h]
      | const a => rfl
      | add p q => rfl
      | mul p q => rfl
  | inner p q k => rfl
  | leftProduct p q k => rfl
  | rightProduct p q k => rfl
  | convolution p q k n => cases n <;> rfl
  | convolutionTerm p q k i => rfl
  | constantPart F => rfl

theorem root_is_boundedCircuit (C : ResultantVNP.Circuit σ) (d : ℕ) :
    expand (.root (CircuitFormulaUnfold.circuitFormula C) (d+1)) = boundedCircuitFormula C d := rfl


end NormalizedAddresses

-- From Solutions.CircuitValueRecurrence

namespace CircuitValueRecurrence

open ResultantVNP MvPolynomial

variable {σ : Type}

noncomputable def run (nodes : List (Node σ)) (values : List (MvPolynomial σ ℂ)) :=
  nodes.foldl (fun vs nd => vs ++ [nd.eval vs]) values

theorem run_length (nodes : List (Node σ)) (values : List (MvPolynomial σ ℂ)) :
    (run nodes values).length = values.length + nodes.length := by
  induction nodes generalizing values with
  | nil => simp [run]
  | cons nd rest ih =>
    change (run rest (values ++ [nd.eval values])).length = _
    simp [ih, Nat.add_assoc, Nat.add_comm]

theorem run_extends (nodes : List (Node σ)) (values : List (MvPolynomial σ ℂ)) :
    ∃ tail, run nodes values = values ++ tail := by
  induction nodes generalizing values with
  | nil => exact ⟨[], by simp [run]⟩
  | cons nd rest ih =>
    obtain ⟨tail,htail⟩ := ih (values ++ [nd.eval values])
    refine ⟨[nd.eval values] ++ tail, ?_⟩
    change run rest (values ++ [nd.eval values]) = _
    rw [htail, List.append_assoc]

/-- Every computed node is evaluated on exactly the preceding values. -/
theorem run_get_step (nodes : List (Node σ)) (values : List (MvPolynomial σ ℂ))
    (i : ℕ) (hi : i < nodes.length) :
    (run nodes values).getD (values.length + i) 0 =
      (nodes[i]'hi).eval ((run nodes values).take (values.length + i)) := by
  induction nodes generalizing values i with
  | nil => simp at hi
  | cons nd rest ih =>
    cases i with
    | zero =>
      change (run rest (values ++ [nd.eval values])).getD (values.length + 0) 0 =
        nd.eval ((run rest (values ++ [nd.eval values])).take (values.length + 0))
      obtain ⟨tail,htail⟩ := run_extends rest (values ++ [nd.eval values])
      rw [htail]
      simp only [Nat.add_zero, List.append_assoc]
      rw [List.getD_append_right values ([nd.eval values] ++ tail) 0 values.length (le_refl _)]
      rw [List.take_append_of_le_length (l₁ := values) (l₂ := [nd.eval values] ++ tail) (le_refl _)]
      simp
    | succ i =>
      have hi' : i < rest.length := by simpa using hi
      have h := ih (values ++ [nd.eval values]) i hi'
      simpa [run, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using h

theorem values_length (C : Circuit σ) : C.values.length = C.nodes.length := by
  simpa [Circuit.values, run] using run_length C.nodes []

theorem values_step (C : Circuit σ) (i : ℕ) (hi : i < C.nodes.length) :
    C.values.getD i 0 = (C.nodes[i]'hi).eval (C.values.take i) := by
  simpa [Circuit.values, run] using run_get_step C.nodes [] i hi

theorem getD_take_of_lt {α : Type} (values : List α) (d : α) (i j : ℕ)
    (hji : j < i) (hjv : j < values.length) :
    (values.take i).getD j d = values.getD j d := by
  have ht : j < (values.take i).length := by simp only [List.length_take]; omega
  rw [List.getD_eq_getElem _ _ ht, List.getD_eq_getElem _ _ hjv]
  exact List.getElem_take

/-- The full value list may be used to evaluate a node: well-formedness
    guarantees that the node only refers to the earlier part. -/
theorem values_step_full (C : Circuit σ) (i : ℕ) (hi : i < C.nodes.length) :
    C.values.getD i 0 = (C.nodes[i]'hi).eval C.values := by
  rw [values_step C i hi]
  have hwell := C.wf i hi
  cases h : C.nodes[i] with
  | var x => rfl
  | const a => rfl
  | add j k =>
    simp only [h, Node.ReadsBelow] at hwell
    simp only [Node.eval]
    rw [getD_take_of_lt _ _ _ j hwell.1 (by rw [values_length]; omega),
      getD_take_of_lt _ _ _ k hwell.2 (by rw [values_length]; omega)]
  | mul j k =>
    simp only [h, Node.ReadsBelow] at hwell
    simp only [Node.eval]
    rw [getD_take_of_lt _ _ _ j hwell.1 (by rw [values_length]; omega),
      getD_take_of_lt _ _ _ k hwell.2 (by rw [values_length]; omega)]


end CircuitValueRecurrence

-- From Solutions.CircuitFormulaRecurrence

namespace CircuitFormulaRecurrence

open ResultantVNP PermanentFoundation CircuitFormulaUnfold CircuitValueRecurrence

variable {σ : Type}

noncomputable def run (nodes : List (Node σ)) (values : List (Formula σ)) :=
  nodes.foldl (fun vs nd => vs ++ [nodeFormula vs nd]) values

theorem run_length (nodes : List (Node σ)) (values : List (Formula σ)) :
    (run nodes values).length = values.length + nodes.length := by
  induction nodes generalizing values with
  | nil => simp [run]
  | cons nd rest ih =>
    change (run rest (values ++ [nodeFormula values nd])).length = _
    simp [ih, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]

theorem run_extends (nodes : List (Node σ)) (values : List (Formula σ)) :
    ∃ tail, run nodes values = values ++ tail := by
  induction nodes generalizing values with
  | nil => exact ⟨[], by simp [run]⟩
  | cons nd rest ih =>
    obtain ⟨tail,htail⟩ := ih (values ++ [nodeFormula values nd])
    refine ⟨[nodeFormula values nd] ++ tail, ?_⟩
    change run rest (values ++ [nodeFormula values nd]) = _
    rw [htail, List.append_assoc]

theorem run_get_step (nodes : List (Node σ)) (values : List (Formula σ))
    (i : ℕ) (hi : i < nodes.length) :
    (run nodes values).getD (values.length + i) (.const 0) =
      nodeFormula ((run nodes values).take (values.length + i)) (nodes[i]'hi) := by
  induction nodes generalizing values i with
  | nil => simp at hi
  | cons nd rest ih =>
    cases i with
    | zero =>
      change (run rest (values ++ [nodeFormula values nd])).getD (values.length + 0) (.const 0) =
        nodeFormula ((run rest (values ++ [nodeFormula values nd])).take (values.length + 0)) nd
      obtain ⟨tail,htail⟩ := run_extends rest (values ++ [nodeFormula values nd])
      rw [htail]
      simp only [Nat.add_zero, List.append_assoc]
      rw [List.getD_append_right values ([nodeFormula values nd] ++ tail) (.const 0)
        values.length (le_refl _)]
      rw [List.take_append_of_le_length (l₁ := values)
        (l₂ := [nodeFormula values nd] ++ tail) (le_refl _)]
      simp
    | succ i =>
      have hi' : i < rest.length := by simpa using hi
      have h := ih (values ++ [nodeFormula values nd]) i hi'
      simpa [run, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using h

theorem formulaValues_length (C : Circuit σ) : (formulaValues C).length = C.nodes.length := by
  simpa [formulaValues, run] using run_length C.nodes []

theorem formulaValues_step_full (C : Circuit σ) (i : ℕ) (hi : i < C.nodes.length) :
    (formulaValues C).getD i (.const 0) = nodeFormula (formulaValues C) (C.nodes[i]'hi) := by
  have hs : (formulaValues C).getD i (.const 0) =
      nodeFormula ((formulaValues C).take i) (C.nodes[i]'hi) := by
    simpa [formulaValues, run] using run_get_step C.nodes [] i hi
  rw [hs]
  have hwell := C.wf i hi
  cases h : C.nodes[i] with
  | var x => rfl
  | const a => rfl
  | add j k =>
    simp only [h, Node.ReadsBelow] at hwell
    simp only [nodeFormula]
    rw [getD_take_of_lt _ _ _ j hwell.1 (by rw [formulaValues_length]; omega),
      getD_take_of_lt _ _ _ k hwell.2 (by rw [formulaValues_length]; omega)]
  | mul j k =>
    simp only [h, Node.ReadsBelow] at hwell
    simp only [nodeFormula]
    rw [getD_take_of_lt _ _ _ j hwell.1 (by rw [formulaValues_length]; omega),
      getD_take_of_lt _ _ _ k hwell.2 (by rw [formulaValues_length]; omega)]


end CircuitFormulaRecurrence

-- From Solutions.CircuitReferenceBound

/-! Input leaves are free in the mission's circuit-size convention. The
positions that matter can be bounded by the number of gate references,
regardless of how many unreferenced nodes the circuit contains. -/

namespace CircuitReferenceBound

open ResultantVNP

variable {σ : Type}

def nodeReferences : Node σ → List ℕ
  | .add i j | .mul i j => [i,j]
  | .var _ | .const _ => []

def allReferences (nodes : List (Node σ)) : List ℕ := nodes.flatMap nodeReferences

theorem allReferences_length (nodes : List (Node σ)) :
    (allReferences nodes).length = 2 * nodes.countP Node.isGate := by
  induction nodes with
  | nil => rfl
  | cons nd rest ih =>
    rw [List.countP_cons]
    change (nodeReferences nd ++ allReferences rest).length =
      2 * (rest.countP Node.isGate + if nd.isGate then 1 else 0)
    rw [List.length_append, ih]
    cases nd <;> simp [nodeReferences, Node.isGate] <;> omega

/-- Distinct positions read by gates, together with the output position. -/
def relevantPositions (C : Circuit σ) : Finset ℕ :=
  insert (C.nodes.length - 1) (allReferences C.nodes).toFinset

theorem relevantPositions_card (C : Circuit σ) :
    (relevantPositions C).card ≤ 2 * C.size + 1 := by
  unfold relevantPositions
  calc
    (insert (C.nodes.length - 1) (allReferences C.nodes).toFinset).card ≤
        (allReferences C.nodes).toFinset.card + 1 := Finset.card_insert_le _ _
    _ ≤ (allReferences C.nodes).length + 1 := by
      have h := List.toFinset_card_le (allReferences C.nodes)
      omega
    _ = 2 * C.size + 1 := by rw [allReferences_length]; rfl

theorem gate_inputs_relevant (C : Circuit σ) (nd : Node σ) (i : ℕ)
    (hnd : nd ∈ C.nodes) (hi : i ∈ nodeReferences nd) : i ∈ relevantPositions C := by
  simp only [relevantPositions, Finset.mem_insert, List.mem_toFinset]
  exact Or.inr (List.mem_flatMap.mpr ⟨nd,hnd,hi⟩)

theorem reference_lt_length (C : Circuit σ) (nd : Node σ) (i : ℕ)
    (hnd : nd ∈ C.nodes) (hi : i ∈ nodeReferences nd) : i < C.nodes.length := by
  obtain ⟨k,hk,rfl⟩ := List.getElem_of_mem hnd
  have hw := C.wf k hk
  cases h : C.nodes[k] with
  | var x => simp [h,nodeReferences] at hi
  | const a => simp [h,nodeReferences] at hi
  | add x y =>
    simp [h, nodeReferences] at hi
    simp only [h, Node.ReadsBelow] at hw
    rcases hi with rfl | rfl <;> omega
  | mul x y =>
    simp [h, nodeReferences] at hi
    simp only [h, Node.ReadsBelow] at hw
    rcases hi with rfl | rfl <;> omega

theorem relevantPositions_lt_length (C : Circuit σ) (i : ℕ)
    (hi : i ∈ relevantPositions C) : i < C.nodes.length := by
  simp only [relevantPositions, Finset.mem_insert, List.mem_toFinset] at hi
  rcases hi with hi | hi
  · subst i
    have hlen : 0 < C.nodes.length := List.length_pos_iff.mpr C.nonempty
    omega
  · obtain ⟨nd,hnd,href⟩ := List.mem_flatMap.mp hi
    exact reference_lt_length C nd i hnd href

/-- The rank of a relevant position in increasing original circuit order. -/
def relevantRank (C : Circuit σ) (i : ℕ) (hi : i ∈ relevantPositions C) :
    Fin (relevantPositions C).card :=
  ((relevantPositions C).orderIsoOfFin rfl).symm ⟨i,hi⟩

/-- Recover the original position from its compact rank. -/
def relevantAt (C : Circuit σ) (i : Fin (relevantPositions C).card) : ℕ :=
  ((relevantPositions C).orderIsoOfFin rfl i).val

theorem relevantAt_mem (C : Circuit σ) (i : Fin (relevantPositions C).card) :
    relevantAt C i ∈ relevantPositions C :=
  ((relevantPositions C).orderIsoOfFin rfl i).property

theorem relevantAt_rank (C : Circuit σ) (i : ℕ) (hi : i ∈ relevantPositions C) :
    relevantAt C (relevantRank C i hi) = i := by
  simp [relevantAt, relevantRank]

theorem relevantRank_at (C : Circuit σ) (i : Fin (relevantPositions C).card) :
    relevantRank C (relevantAt C i) (relevantAt_mem C i) = i := by
  change ((relevantPositions C).orderIsoOfFin rfl).symm
    (((relevantPositions C).orderIsoOfFin rfl) i) = i
  exact ((relevantPositions C).orderIsoOfFin rfl).symm_apply_apply i

/-- Compact renumbering preserves the original topological order. -/
theorem relevantRank_lt (C : Circuit σ) (i j : ℕ)
    (hi : i ∈ relevantPositions C) (hj : j ∈ relevantPositions C) (hij : i < j) :
    relevantRank C i hi < relevantRank C j hj := by
  exact ((relevantPositions C).orderIsoOfFin rfl).symm.strictMono hij

/-- A gate at a relevant position reads only earlier relevant positions, so
    its references remain well formed after compact renumbering. -/
theorem compact_gate_inputs (C : Circuit σ) (k : Fin (relevantPositions C).card)
    (i : ℕ) (hi : i ∈ nodeReferences
      (C.nodes[(relevantAt C k)]'(relevantPositions_lt_length C _ (relevantAt_mem C k)))) :
    ∃ hmem : i ∈ relevantPositions C, relevantRank C i hmem < k := by
  let pos := relevantAt C k
  have hpos : pos < C.nodes.length := relevantPositions_lt_length C _ (relevantAt_mem C k)
  change i ∈ nodeReferences (C.nodes[pos]'hpos) at hi
  have hmem : i ∈ relevantPositions C :=
    gate_inputs_relevant C (C.nodes[pos]'hpos) i (List.getElem_mem hpos) hi
  refine ⟨hmem, ?_⟩
  have hw := C.wf pos hpos
  have hlt : i < pos := by
    cases h : C.nodes[pos] with
    | var x => simp [h,nodeReferences] at hi
    | const a => simp [h,nodeReferences] at hi
    | add x y =>
      simp [h,nodeReferences] at hi
      simp only [h,Node.ReadsBelow] at hw
      rcases hi with rfl | rfl <;> omega
    | mul x y =>
      simp [h,nodeReferences] at hi
      simp only [h,Node.ReadsBelow] at hw
      rcases hi with rfl | rfl <;> omega
  have h := relevantRank_lt C i pos hmem (relevantAt_mem C k) hlt
  simpa [pos, relevantRank_at] using h

/-- Encode an original position by its rank. The fallback is never used for
    an actual gate input. -/
def compactIndex (C : Circuit σ) (i : ℕ) : ℕ :=
  if hi : i ∈ relevantPositions C then (relevantRank C i hi).val else 0

def compactNode (C : Circuit σ) (k : Fin (relevantPositions C).card) : Node σ :=
  match C.nodes[(relevantAt C k)]'(relevantPositions_lt_length C _ (relevantAt_mem C k)) with
  | .var x => .var x
  | .const a => .const a
  | .add i j => .add (compactIndex C i) (compactIndex C j)
  | .mul i j => .mul (compactIndex C i) (compactIndex C j)

theorem compactIndex_lt (C : Circuit σ) (k : Fin (relevantPositions C).card) (i : ℕ)
    (hi : i ∈ nodeReferences
      (C.nodes[(relevantAt C k)]'(relevantPositions_lt_length C _ (relevantAt_mem C k)))) :
    compactIndex C i < k.val := by
  obtain ⟨hmem,hlt⟩ := compact_gate_inputs C k i hi
  simpa [compactIndex, hmem] using hlt

/-- Compact the circuit's relevant positions in their original order. -/
def compactCircuit (C : Circuit σ) : Circuit σ where
  nodes := List.ofFn (compactNode C)
  nonempty := by
    have hp : 0 < (relevantPositions C).card := by
      apply Finset.card_pos.mpr
      exact ⟨C.nodes.length - 1, by simp [relevantPositions]⟩
    intro he
    have hlen := congrArg List.length he
    simp only [List.length_ofFn, List.length_nil] at hlen
    omega
  wf := by
    intro i hi
    simp only [List.length_ofFn] at hi
    rw [List.getElem_ofFn]
    let k : Fin (relevantPositions C).card := ⟨i,hi⟩
    change (compactNode C k).ReadsBelow i
    unfold compactNode
    have hpos : relevantAt C k < C.nodes.length :=
      relevantPositions_lt_length C _ (relevantAt_mem C k)
    cases h : C.nodes[relevantAt C k]'hpos with
    | var x => trivial
    | const a => trivial
    | add x y =>
      simp only [Node.ReadsBelow]
      constructor
      · apply compactIndex_lt C k x
        simp [h,nodeReferences]
      · apply compactIndex_lt C k y
        simp [h,nodeReferences]
    | mul x y =>
      simp only [Node.ReadsBelow]
      constructor
      · apply compactIndex_lt C k x
        simp [h,nodeReferences]
      · apply compactIndex_lt C k y
        simp [h,nodeReferences]

theorem compactCircuit_node_bound (C : Circuit σ) :
    (compactCircuit C).nodes.length ≤ 2 * C.size + 1 := by
  simpa [compactCircuit] using relevantPositions_card C

theorem compactCircuit_size_bound (C : Circuit σ) :
    (compactCircuit C).size ≤ 2 * C.size + 1 := by
  exact List.countP_le_length.trans (compactCircuit_node_bound C)


end CircuitReferenceBound

-- From Solutions.IndexedNormalizedAddresses

/-! Normalized formula addresses whose source references are natural-number
    indices in the original circuit. Arbitrary complex coefficients are
    represented by source indices and looked up only in the arithmetic
    payload, not stored as Boolean machine-state data. -/

namespace IndexedNormalizedAddresses

open ResultantVNP PermanentFoundation CircuitFormulaUnfold CircuitFormulaRecurrence
  NormalizedAddresses MvPolynomial

variable {σ : Type}

inductive Tag where
  | root (i n : ℕ)
  | component (i k : ℕ)
  | inner (i j k : ℕ)
  | leftProduct (i j k : ℕ)
  | rightProduct (i j k : ℕ)
  | convolution (i j k n : ℕ)
  | convolutionTerm (i j k n : ℕ)
  | constantPart (i : ℕ)

noncomputable def sourceFormula (C : Circuit σ) (i : ℕ) : Formula σ :=
  (formulaValues C).getD i (.const 0)

noncomputable def sourceNode (C : Circuit σ) (i : ℕ) : Node σ :=
  C.nodes.getD i (.const 0)

theorem sourceFormula_node (C : Circuit σ) (i : ℕ) :
    sourceFormula C i = nodeFormula (formulaValues C) (sourceNode C i) := by
  by_cases hi : i < C.nodes.length
  · rw [sourceNode, List.getD_eq_getElem _ _ hi]
    exact formulaValues_step_full C i hi
  · have hn : C.nodes.length ≤ i := by omega
    have hf : (formulaValues C).length ≤ i := by rw [formulaValues_length]; omega
    rw [sourceFormula, List.getD_eq_default _ _ hf,
      sourceNode, List.getD_eq_default _ _ hn]
    rfl

noncomputable def interpret (C : Circuit σ) : Tag → Address σ
  | .root i n => .root (sourceFormula C i) n
  | .component i k => .component (sourceFormula C i) k
  | .inner i j k => .inner (sourceFormula C i) (sourceFormula C j) k
  | .leftProduct i j k => .leftProduct (sourceFormula C i) (sourceFormula C j) k
  | .rightProduct i j k => .rightProduct (sourceFormula C i) (sourceFormula C j) k
  | .convolution i j k n => .convolution (sourceFormula C i) (sourceFormula C j) k n
  | .convolutionTerm i j k n => .convolutionTerm (sourceFormula C i) (sourceFormula C j) k n
  | .constantPart i => .constantPart (sourceFormula C i)

inductive View where
  | zero
  | variable (i : ℕ)
  | constantPart (i : ℕ)
  | add (p q : Tag)
  | mul (p q : Tag)

/-- A view contains only indices, counters, and fixed tags. -/
noncomputable def view (C : Circuit σ) : Tag → View
  | .root _ 0 => .zero
  | .root i (n+1) => .add (.root i n) (.component i n)
  | .component i 0 => .constantPart i
  | .component i (k+1) =>
    match sourceNode C i with
    | .var _ => if k = 0 then .variable i else .zero
    | .const _ => .zero
    | .add j l => .add (.component j (k+1)) (.component l (k+1))
    | .mul j l => .add (.inner j l k) (.rightProduct j l k)
  | .inner i j k => .add (.leftProduct i j k) (.convolution i j k k)
  | .leftProduct i j k => .mul (.constantPart i) (.component j (k+1))
  | .rightProduct i j k => .mul (.component i (k+1)) (.constantPart j)
  | .convolution _ _ _ 0 => .zero
  | .convolution i j k (n+1) => .add (.convolution i j k n) (.convolutionTerm i j k n)
  | .convolutionTerm i j k n => .mul (.component i (n+1)) (.component j (k-n))
  | .constantPart i => .constantPart i

noncomputable def variableFormula (C : Circuit σ) (i : ℕ) : Formula σ :=
  match sourceNode C i with
  | .var x => .var x
  | _ => .const 0

noncomputable def View.formula (C : Circuit σ) : View → Formula σ
  | .zero => .const 0
  | .variable i => variableFormula C i
  | .constantPart i => .const (coeff 0 (sourceFormula C i).value)
  | .add p q => .add (expand (interpret C p)) (expand (interpret C q))
  | .mul p q => .mul (expand (interpret C p)) (expand (interpret C q))

/-- Looking up a tagged node agrees with expanding the symbolic address. -/
theorem view_correct (C : Circuit σ) (a : Tag) :
    (view C a).formula C = expand (interpret C a) := by
  cases a with
  | root i n => cases n <;> rfl
  | component i k =>
    cases k with
    | zero =>
      simp only [view, View.formula, interpret, NormalizedAddresses.expand]
      cases h : sourceFormula C i <;> rfl
    | succ k =>
      change (view C (.component i (k+1))).formula C =
        CircuitNormalizedFormula.componentFormula (sourceFormula C i) (k+1)
      have hs := sourceFormula_node C i
      cases h : sourceNode C i with
      | var x =>
        simp only [h, nodeFormula] at hs
        rw [hs]
        by_cases hk : k = 0 <;>
          simp [view, h, hk, View.formula, variableFormula,
            CircuitNormalizedFormula.componentFormula]
      | const c =>
        simp only [h, nodeFormula] at hs
        rw [hs]
        simp [view, h, View.formula, CircuitNormalizedFormula.componentFormula]
      | add j l =>
        simp only [h, nodeFormula] at hs
        rw [hs]
        simp [view, h, View.formula, interpret, NormalizedAddresses.expand, CircuitNormalizedFormula.componentFormula,
          sourceFormula]
      | mul j l =>
        simp only [h, nodeFormula] at hs
        rw [hs]
        simp [view, h, View.formula, interpret, NormalizedAddresses.expand, CircuitNormalizedFormula.componentFormula,
          sourceFormula]
  | inner i j k => rfl
  | leftProduct i j k => rfl
  | rightProduct i j k => rfl
  | convolution i j k n => cases n <;> rfl
  | convolutionTerm i j k n => rfl
  | constantPart i => rfl

/-- Interpret an indexed view as a symbolic address view. -/
noncomputable def liftView (C : Circuit σ) : View → NormalizedAddresses.View σ
  | .zero => .const 0
  | .variable i =>
    match sourceNode C i with
    | .var x => .var x
    | _ => .const 0
  | .constantPart i => .const (coeff 0 (sourceFormula C i).value)
  | .add p q => .add (interpret C p) (interpret C q)
  | .mul p q => .mul (interpret C p) (interpret C q)

theorem view_refines (C : Circuit σ) (a : Tag) :
    NormalizedAddresses.view (interpret C a) = liftView C (view C a) := by
  cases a with
  | root i n => cases n <;> rfl
  | component i k =>
    cases k with
    | zero =>
      change NormalizedAddresses.view (.component (sourceFormula C i) 0) = _
      cases h : sourceFormula C i <;> simp [NormalizedAddresses.view,view,liftView,h]
    | succ k =>
      change NormalizedAddresses.view (.component (sourceFormula C i) (k+1)) = _
      have hs := sourceFormula_node C i
      cases h : sourceNode C i with
      | var x =>
        simp only [h,nodeFormula] at hs
        rw [hs]
        by_cases hk : k = 0 <;> simp [NormalizedAddresses.view, view, h, hk, liftView]
      | const c =>
        simp only [h,nodeFormula] at hs
        rw [hs]
        simp [NormalizedAddresses.view,view,h,liftView]
      | add j l =>
        simp only [h,nodeFormula] at hs
        rw [hs]
        simp [NormalizedAddresses.view,view,h,liftView,interpret,sourceFormula]
      | mul j l =>
        simp only [h,nodeFormula] at hs
        rw [hs]
        simp [NormalizedAddresses.view,view,h,liftView,interpret,sourceFormula]
  | inner i j k => rfl
  | leftProduct i j k => rfl
  | rightProduct i j k => rfl
  | convolution i j k n => cases n <;> rfl
  | convolutionTerm i j k n => rfl
  | constantPart i => rfl

/-- An address is bounded by the number of source nodes and the degree
    cutoff. Convolution counters also record their valid loop range. -/
def Tag.bounded (m D : ℕ) : Tag → Prop
  | .root i n => i < m ∧ n ≤ D
  | .component i k => i < m ∧ k ≤ D
  | .inner i j k | .leftProduct i j k | .rightProduct i j k =>
      i < m ∧ j < m ∧ k + 1 ≤ D
  | .convolution i j k n => i < m ∧ j < m ∧ k + 1 ≤ D ∧ n ≤ k
  | .convolutionTerm i j k n => i < m ∧ j < m ∧ k + 1 ≤ D ∧ n < k
  | .constantPart i => i < m

def View.bounded (m D : ℕ) : View → Prop
  | .zero => True
  | .variable i | .constantPart i => i < m
  | .add p q | .mul p q => p.bounded m D ∧ q.bounded m D

theorem sourceNode_refs_lt (C : Circuit σ) (i j : ℕ) (hi : i < C.nodes.length)
    (hj : j ∈ CircuitReferenceBound.nodeReferences (sourceNode C i)) : j < C.nodes.length := by
  rw [sourceNode, List.getD_eq_getElem _ _ hi] at hj
  exact CircuitReferenceBound.reference_lt_length C C.nodes[i] j (List.getElem_mem hi) hj

/-- A one-node expansion preserves compact index and degree bounds. -/
theorem view_bounded (C : Circuit σ) (D : ℕ) (a : Tag)
    (ha : a.bounded C.nodes.length D) : (view C a).bounded C.nodes.length D := by
  cases a with
  | root i n =>
    cases n <;> simp_all [Tag.bounded,view,View.bounded] <;> omega
  | component i k =>
    cases k with
    | zero => simpa [Tag.bounded,view,View.bounded] using ha.1
    | succ k =>
      have hi : i < C.nodes.length := ha.1
      cases hn : sourceNode C i with
      | var x =>
        by_cases hk : k = 0 <;> simp [view,hn,hk,View.bounded,hi]
      | const c => simp [view,hn,View.bounded]
      | add j l =>
        have hj := sourceNode_refs_lt C i j hi (by simp [hn,CircuitReferenceBound.nodeReferences])
        have hl := sourceNode_refs_lt C i l hi (by simp [hn,CircuitReferenceBound.nodeReferences])
        simp only [view,hn,View.bounded,Tag.bounded]
        exact ⟨⟨hj,ha.2⟩,⟨hl,ha.2⟩⟩
      | mul j l =>
        have hj := sourceNode_refs_lt C i j hi (by simp [hn,CircuitReferenceBound.nodeReferences])
        have hl := sourceNode_refs_lt C i l hi (by simp [hn,CircuitReferenceBound.nodeReferences])
        simp only [view,hn,View.bounded,Tag.bounded]
        exact ⟨⟨hj,hl,ha.2⟩,⟨hj,hl,ha.2⟩⟩
  | inner i j k =>
    simp only [Tag.bounded] at ha
    simp only [view,View.bounded,Tag.bounded]
    omega
  | leftProduct i j k =>
    simp only [Tag.bounded] at ha
    simp only [view,View.bounded,Tag.bounded]
    omega
  | rightProduct i j k =>
    simp only [Tag.bounded] at ha
    simp only [view,View.bounded,Tag.bounded]
    omega
  | convolution i j k n =>
    cases n with
    | zero => trivial
    | succ n =>
      simp only [Tag.bounded] at ha
      simp only [view,View.bounded,Tag.bounded]
      omega
  | convolutionTerm i j k n =>
    simp only [Tag.bounded] at ha
    simp only [view,View.bounded,Tag.bounded]
    omega
  | constantPart i => exact ha

/-- A tag has a fixed constructor number, two source-index fields and two
    degree-counter fields; unused fields are set to zero. -/
def Tag.fields : Tag → ℕ × ℕ × ℕ × ℕ × ℕ
  | .root i n => (0,i,0,n,0)
  | .component i k => (1,i,0,k,0)
  | .inner i j k => (2,i,j,k,0)
  | .leftProduct i j k => (3,i,j,k,0)
  | .rightProduct i j k => (4,i,j,k,0)
  | .convolution i j k n => (5,i,j,k,n)
  | .convolutionTerm i j k n => (6,i,j,k,n)
  | .constantPart i => (7,i,0,0,0)

theorem Tag.fields_injective : Function.Injective Tag.fields := by
  intro a b h
  cases a <;> cases b <;> simp_all [Tag.fields]

theorem Tag.fields_bounded (m D : ℕ) (a : Tag) (ha : a.bounded m D) :
    a.fields.1 < 8 ∧ a.fields.2.1 < m+1 ∧ a.fields.2.2.1 < m+1 ∧
      a.fields.2.2.2.1 < D+1 ∧ a.fields.2.2.2.2 < D+1 := by
  cases a <;> simp only [Tag.fields,Tag.bounded] at * <;> omega

/-- Bounded tags embed into a fixed product of finite alphabets. A one-hot
    representation therefore uses linearly many bits in these bounds. -/
def boundedTagEncoding (m D : ℕ) :
    {a : Tag // a.bounded m D} ↪ Fin 8 × Fin (m+1) × Fin (m+1) × Fin (D+1) × Fin (D+1) where
  toFun a :=
    let h := Tag.fields_bounded m D a.val a.property
    (⟨a.val.fields.1,h.1⟩, ⟨a.val.fields.2.1,h.2.1⟩,
      ⟨a.val.fields.2.2.1,h.2.2.1⟩, ⟨a.val.fields.2.2.2.1,h.2.2.2.1⟩,
      ⟨a.val.fields.2.2.2.2,h.2.2.2.2⟩)
  inj' := by
    intro a b h
    apply Subtype.ext
    apply Tag.fields_injective
    have h' := congrArg (fun x : Fin 8 × Fin (m+1) × Fin (m+1) × Fin (D+1) × Fin (D+1) =>
      (x.1.val,x.2.1.val,x.2.2.1.val,x.2.2.2.1.val,x.2.2.2.2.val)) h
    simpa using h'

def oneHot {n : ℕ} (i : Fin n) : Fin n → Bool := fun j => decide (i = j)

theorem oneHot_injective (n : ℕ) : Function.Injective (@oneHot n) := by
  intro i j h
  have he := congrFun h i
  simp [oneHot] at he
  exact he.symm

theorem append_injective {m n : ℕ} {a b : Fin m → Bool} {c d : Fin n → Bool}
    (h : Fin.append a c = Fin.append b d) : a = b ∧ c = d := by
  have he : (a,c) = (b,d) := (Fin.appendEquiv (α := Bool) m n).injective h
  exact ⟨congrArg Prod.fst he,congrArg Prod.snd he⟩

def tagWordLength (m D : ℕ) : ℕ := 8 + ((m+1) + ((m+1) + ((D+1) + (D+1))))

/-- A concrete one-hot Boolean encoding of a bounded tag. -/
def tagWord (m D : ℕ) (a : {a : Tag // a.bounded m D}) : Fin (tagWordLength m D) → Bool :=
  let p := boundedTagEncoding m D a
  Fin.append (oneHot p.1)
    (Fin.append (oneHot p.2.1)
      (Fin.append (oneHot p.2.2.1)
        (Fin.append (oneHot p.2.2.2.1) (oneHot p.2.2.2.2))))

theorem tagWord_injective (m D : ℕ) : Function.Injective (tagWord m D) := by
  intro a b h
  apply (boundedTagEncoding m D).injective
  dsimp only [tagWord] at h
  obtain ⟨h₁,h⟩ := append_injective h
  obtain ⟨h₂,h⟩ := append_injective h
  obtain ⟨h₃,h⟩ := append_injective h
  obtain ⟨h₄,h₅⟩ := append_injective h
  have e₁ := oneHot_injective 8 h₁
  have e₂ := oneHot_injective (m+1) h₂
  have e₃ := oneHot_injective (m+1) h₃
  have e₄ := oneHot_injective (D+1) h₄
  have e₅ := oneHot_injective (D+1) h₅
  exact Prod.ext e₁ (Prod.ext e₂ (Prod.ext e₃ (Prod.ext e₄ e₅)))

noncomputable instance boundedTagFintype (m D : ℕ) : Fintype {a : Tag // a.bounded m D} :=
  Fintype.ofInjective (boundedTagEncoding m D) (boundedTagEncoding m D).injective

/-- There are polynomially many possible bounded stack tags, so a local
    lookup table can enumerate tags without enumerating entire machine states. -/
theorem boundedTag_card (m D : ℕ) :
    Fintype.card {a : Tag // a.bounded m D} ≤ 8 * (m+1)^2 * (D+1)^2 := by
  have h := Fintype.card_le_of_injective (boundedTagEncoding m D) (boundedTagEncoding m D).injective
  simp only [Fintype.card_prod,Fintype.card_fin] at h
  nlinarith


end IndexedNormalizedAddresses

-- From Solutions.CircuitParseTraces

/-! Parse trees discard addition nodes. These traces count all the source
nodes visited while choosing a parse tree, including addition choices. -/

namespace CircuitParseTraces

open PermanentFoundation CircuitParseTrees CircuitNormalizedFormula ResultantVNP MvPolynomial

variable {σ : Type}

/-- Parse tree with the number of nodes in its complete derivation. Equal
trees arising from different addition choices remain separate list entries. -/
def parseTraces : Formula σ → List (Formula σ × ℕ)
  | .var x => [(.var x, 1)]
  | .const a => [(.const a, 1)]
  | .add p q => (parseTraces p ++ parseTraces q).map fun t => (t.1, t.2 + 1)
  | .mul p q => (parseTraces p).flatMap fun a => (parseTraces q).map fun b =>
      (.mul a.1 b.1, a.2 + b.2 + 1)

theorem parseTraces_trees (F : Formula σ) : (parseTraces F).map Prod.fst = parseTrees F := by
  induction F with
  | var x => rfl
  | const a => rfl
  | add p q hp hq =>
    simpa [parseTraces, parseTrees, List.map_map, Function.comp_def] using congrArg₂ List.append hp hq
  | mul p q hp hq =>
    simp only [parseTraces, parseTrees, List.map_flatMap, List.map_map, Function.comp_def]
    rw [← hp, ← hq]
    simp [List.flatMap_map, List.map_map, Function.comp_def]

theorem formalDegree_pos (F : Formula σ) : 0 < formalDegree F := by
  induction F with
  | var x => simp [formalDegree]
  | const a => simp [formalDegree]
  | add p q hp hq => simp only [formalDegree]; omega
  | mul p q hp hq => simp only [formalDegree]; omega

/-- The complete derivation has at most twice the product-tree leaf bound
    times the formula depth. This controls runs of addition choices as well
    as multiplication branches. -/
theorem parseTraces_cost (F : Formula σ) (T : Formula σ) (c : ℕ)
    (h : (T, c) ∈ parseTraces F) :
    c ≤ 2 * formalDegree F * formulaDepth F := by
  induction F generalizing T c with
  | var x => simp [parseTraces] at h; obtain ⟨rfl,rfl⟩ := h; simp [formalDegree, formulaDepth]
  | const a => simp [parseTraces] at h; obtain ⟨rfl,rfl⟩ := h; simp [formalDegree, formulaDepth]
  | add p q hp hq =>
    simp only [parseTraces, List.mem_map, List.mem_append] at h
    obtain ⟨⟨U, u⟩, hu, he⟩ := h
    simp only [Prod.mk.injEq] at he
    obtain ⟨rfl,rfl⟩ := he
    simp only [formalDegree, formulaDepth]
    rcases hu with hu | hu
    · have ih := hp U u hu
      have hd := le_max_left (formulaDepth p) (formulaDepth q)
      have he := le_max_left (formalDegree p) (formalDegree q)
      have hn := formalDegree_pos p
      nlinarith
    · have ih := hq U u hu
      have hd := le_max_right (formulaDepth p) (formulaDepth q)
      have he := le_max_right (formalDegree p) (formalDegree q)
      have hn := formalDegree_pos q
      nlinarith
  | mul p q hp hq =>
    simp only [parseTraces, List.mem_flatMap, List.mem_map] at h
    obtain ⟨⟨P,a⟩, ha, ⟨Q,b⟩, hb, he⟩ := h
    simp only [Prod.mk.injEq] at he
    obtain ⟨rfl,rfl⟩ := he
    simp only [formalDegree, formulaDepth]
    have hp' := hp P a ha
    have hq' := hq Q b hb
    have hd₁ := le_max_left (formulaDepth p) (formulaDepth q)
    have hd₂ := le_max_right (formulaDepth p) (formulaDepth q)
    have hn := formalDegree_pos p
    nlinarith

/-- For a bounded-degree circuit, the full derivations (including all addition
    choices) have a polynomial node bound. The trace list can be exponentially
    long; this theorem does not assert that its entries have a compact encoding. -/
theorem bounded_circuit_parseTraces [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d) :
    let F := boundedCircuitFormula C d
    ((parseTraces F).map (fun t => t.1.value)).sum = C.value ∧
    ∀ T c, (T,c) ∈ parseTraces F →
      c ≤ 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2) := by
  dsimp only
  constructor
  · have ht := (bounded_circuit_parseTrees C d hdegree).1
    rw [← parseTraces_trees] at ht
    simpa [List.map_map, Function.comp_def] using ht
  · intro T c hT
    have hcost := parseTraces_cost _ T c hT
    have hformal : formalDegree (boundedCircuitFormula C d) ≤ (C.size + 1) * d + 1 := by
      unfold boundedCircuitFormula
      apply formulaSum_formalDegree _ _ _ (by omega)
      intro k hk
      have hn := componentFormula_formalDegree (CircuitFormulaUnfold.circuitFormula C) k
      have hd := circuitFormula_depth_bound C
      nlinarith
    have hdepth := boundedCircuitFormula_depth C d
    have hmul := Nat.mul_le_mul hformal hdepth
    nlinarith


end CircuitParseTraces

-- From Solutions.CircuitParseCodes

namespace CircuitParseCodes

open PermanentFoundation CircuitParseTrees

variable {σ : Type}

/-- A bit chooses a branch at an addition. At a product, the codes of both
    operands are concatenated in traversal order. -/
def parseCodes : Formula σ → List (Formula σ × List Bool)
  | .var x => [(.var x, [])]
  | .const a => [(.const a, [])]
  | .add p q =>
      (parseCodes p).map (fun t => (t.1, false :: t.2)) ++
      (parseCodes q).map (fun t => (t.1, true :: t.2))
  | .mul p q => (parseCodes p).flatMap fun a => (parseCodes q).map fun b =>
      (.mul a.1 b.1, a.2 ++ b.2)

/-- The decoder leaves its unused suffix untouched. -/
def decode : Formula σ → List Bool → Option (Formula σ × List Bool)
  | .var x, bits => some (.var x, bits)
  | .const a, bits => some (.const a, bits)
  | .add _ _, [] => none
  | .add p q, bit :: bits => if bit then decode q bits else decode p bits
  | .mul p q, bits => do
      let (a, rest) ← decode p bits
      let (b, rest') ← decode q rest
      some (.mul a b, rest')

theorem parseCodes_trees (F : Formula σ) : (parseCodes F).map Prod.fst = parseTrees F := by
  induction F with
  | var x => rfl
  | const a => rfl
  | add p q hp hq =>
    simpa [parseCodes, parseTrees, List.map_map, Function.comp_def] using congrArg₂ List.append hp hq
  | mul p q hp hq =>
    simp only [parseCodes, parseTrees, List.map_flatMap, List.map_map, Function.comp_def]
    rw [← hp, ← hq]
    simp [List.flatMap_map, List.map_map, Function.comp_def]

/-- A generated code decodes correctly regardless of what follows it. -/
theorem decode_code_append (F : Formula σ) (T : Formula σ) (bits suffix : List Bool)
    (h : (T, bits) ∈ parseCodes F) : decode F (bits ++ suffix) = some (T, suffix) := by
  induction F generalizing T bits suffix with
  | var x =>
    simp only [parseCodes, List.mem_singleton, Prod.mk.injEq] at h
    obtain ⟨rfl,rfl⟩ := h
    rfl
  | const a =>
    simp only [parseCodes, List.mem_singleton, Prod.mk.injEq] at h
    obtain ⟨rfl,rfl⟩ := h
    rfl
  | add p q hp hq =>
    simp only [parseCodes, List.mem_append, List.mem_map] at h
    rcases h with h | h
    · obtain ⟨⟨U,b⟩, hu, he⟩ := h
      simp only [Prod.mk.injEq] at he
      obtain ⟨rfl,rfl⟩ := he
      simpa [decode] using hp U b suffix hu
    · obtain ⟨⟨U,b⟩, hu, he⟩ := h
      simp only [Prod.mk.injEq] at he
      obtain ⟨rfl,rfl⟩ := he
      simpa [decode] using hq U b suffix hu
  | mul p q hp hq =>
    simp only [parseCodes, List.mem_flatMap, List.mem_map] at h
    obtain ⟨⟨P,a⟩, ha, ⟨Q,b⟩, hb, he⟩ := h
    simp only [Prod.mk.injEq] at he
    obtain ⟨rfl,rfl⟩ := he
    simp only [List.append_assoc]
    simp [decode, hp P a (b ++ suffix) ha, hq Q b suffix hb]

/-- Every successful decoding comes from a generated code, followed by the
    returned unconsumed suffix. -/
theorem decode_complete (F : Formula σ) (bits : List Bool) (T : Formula σ) (suffix : List Bool)
    (h : decode F bits = some (T,suffix)) :
    ∃ code, (T,code) ∈ parseCodes F ∧ bits = code ++ suffix := by
  induction F generalizing bits T suffix with
  | var x =>
    simp only [decode, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl,rfl⟩ := h
    exact ⟨[], by simp [parseCodes], rfl⟩
  | const a =>
    simp only [decode, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl,rfl⟩ := h
    exact ⟨[], by simp [parseCodes], rfl⟩
  | add p q hp hq =>
    cases bits with
    | nil => simp [decode] at h
    | cons b bits =>
      cases b with
      | false =>
        simp only [decode, Bool.false_eq_true, ↓reduceIte] at h
        obtain ⟨code,hcode,rfl⟩ := hp bits T suffix h
        refine ⟨false :: code, ?_, rfl⟩
        simp only [parseCodes, List.mem_append, List.mem_map]
        exact Or.inl ⟨(T,code),hcode,rfl⟩
      | true =>
        simp only [decode, ↓reduceIte] at h
        obtain ⟨code,hcode,rfl⟩ := hq bits T suffix h
        refine ⟨true :: code, ?_, rfl⟩
        simp only [parseCodes, List.mem_append, List.mem_map]
        exact Or.inr ⟨(T,code),hcode,rfl⟩
  | mul p q hp hq =>
    cases ha : decode p bits with
    | none => simp [decode,ha] at h
    | some pair =>
      rcases pair with ⟨P,rest⟩
      cases hb : decode q rest with
      | none => simp [decode,ha,hb] at h
      | some pair =>
        rcases pair with ⟨Q,rest'⟩
        simp only [decode,ha,hb,bind, Option.bind, Option.some.injEq, Prod.mk.injEq] at h
        obtain ⟨rfl,rfl⟩ := h
        obtain ⟨a,ha',hbits⟩ := hp bits P rest ha
        obtain ⟨b,hb',hrest⟩ := hq rest Q rest' hb
        refine ⟨a ++ b, ?_, ?_⟩
        · simp only [parseCodes, List.mem_flatMap, List.mem_map]
          exact ⟨(P,a),ha',(Q,b),hb',rfl⟩
        · rw [hbits,hrest,List.append_assoc]

/-- Every code has a corresponding full derivation trace, whose node count
    bounds the number of bits used by the code. -/
theorem parseCodes_trace (F : Formula σ) (T : Formula σ) (bits : List Bool)
    (h : (T,bits) ∈ parseCodes F) :
    ∃ c, (T,c) ∈ CircuitParseTraces.parseTraces F ∧ bits.length ≤ c := by
  induction F generalizing T bits with
  | var x =>
    simp only [parseCodes, List.mem_singleton, Prod.mk.injEq] at h
    obtain ⟨rfl,rfl⟩ := h
    exact ⟨1, by simp [CircuitParseTraces.parseTraces], by simp⟩
  | const a =>
    simp only [parseCodes, List.mem_singleton, Prod.mk.injEq] at h
    obtain ⟨rfl,rfl⟩ := h
    exact ⟨1, by simp [CircuitParseTraces.parseTraces], by simp⟩
  | add p q hp hq =>
    simp only [parseCodes, List.mem_append, List.mem_map] at h
    rcases h with h | h
    · obtain ⟨⟨U,b⟩, hu, he⟩ := h
      simp only [Prod.mk.injEq] at he
      obtain ⟨rfl,rfl⟩ := he
      obtain ⟨c,hc,hb⟩ := hp U b hu
      refine ⟨c + 1, ?_, by simp; omega⟩
      simp only [CircuitParseTraces.parseTraces, List.mem_map, List.mem_append]
      exact ⟨(U,c), Or.inl hc, rfl⟩
    · obtain ⟨⟨U,b⟩, hu, he⟩ := h
      simp only [Prod.mk.injEq] at he
      obtain ⟨rfl,rfl⟩ := he
      obtain ⟨c,hc,hb⟩ := hq U b hu
      refine ⟨c + 1, ?_, by simp; omega⟩
      simp only [CircuitParseTraces.parseTraces, List.mem_map, List.mem_append]
      exact ⟨(U,c), Or.inr hc, rfl⟩
  | mul p q hp hq =>
    simp only [parseCodes, List.mem_flatMap, List.mem_map] at h
    obtain ⟨⟨P,a⟩, ha, ⟨Q,b⟩, hb, he⟩ := h
    simp only [Prod.mk.injEq] at he
    obtain ⟨rfl,rfl⟩ := he
    obtain ⟨c,hc,hca⟩ := hp P a ha
    obtain ⟨d,hd,hdb⟩ := hq Q b hb
    refine ⟨c + d + 1, ?_, by simp; omega⟩
    simp only [CircuitParseTraces.parseTraces, List.mem_flatMap, List.mem_map]
    exact ⟨(P,c), hc, (Q,d), hd, rfl⟩

/-- The generated codes are prefix-free, and a code determines its tree. -/
theorem code_prefix_free (F : Formula σ) (T U : Formula σ) (a b suffix : List Bool)
    (hT : (T,a) ∈ parseCodes F) (hU : (U,b) ∈ parseCodes F)
    (he : a ++ suffix = b) : suffix = [] ∧ T = U := by
  have h₁ := decode_code_append F T a suffix hT
  have h₂ := decode_code_append F U b [] hU
  rw [he] at h₁
  simp only [List.append_nil] at h₂
  rw [h₂] at h₁
  have hh : T = U ∧ suffix = [] := by
    simpa only [Option.some.injEq, Prod.mk.injEq] using h₁.symm
  exact ⟨hh.2, hh.1⟩

/-- Combining two valid codes is injective: the decoder for the first
    operand identifies exactly where the second code begins. -/
theorem product_code_injective (p : Formula σ)
    (a a' b b' : Formula σ × List Bool)
    (ha : a ∈ parseCodes p) (ha' : a' ∈ parseCodes p)
    (he : (Formula.mul a.1 b.1, a.2 ++ b.2) =
      (Formula.mul a'.1 b'.1, a'.2 ++ b'.2)) :
    a = a' ∧ b = b' := by
  rcases a with ⟨A, x⟩
  rcases a' with ⟨A', x'⟩
  rcases b with ⟨B, y⟩
  rcases b' with ⟨B', y'⟩
  simp only [Prod.mk.injEq, Formula.mul.injEq] at he
  obtain ⟨⟨hA,hB⟩,hab⟩ := he
  have h₁ := decode_code_append p A x y ha
  have h₂ := decode_code_append p A' x' y' ha'
  rw [hab, h₂] at h₁
  have hy : y' = y := by
    have hh : (A',y') = (A,y) := Option.some.inj h₁
    exact congrArg Prod.snd hh
  subst y'
  have hx : x = x' := List.append_cancel_right hab
  subst x'
  subst A'
  subst B'
  exact ⟨rfl,rfl⟩

/-- Distinct parse derivations have distinct coded entries, even if they
    compute the same product tree. -/
theorem parseCodes_nodup (F : Formula σ) : (parseCodes F).Nodup := by
  classical
  induction F with
  | var x => simp [parseCodes]
  | const a => simp [parseCodes]
  | add p q hp hq =>
    simp only [parseCodes]
    apply List.Nodup.append
    · apply hp.map
      intro ⟨A,x⟩ ⟨B,y⟩ h
      simp only [Prod.mk.injEq, List.cons.injEq] at h
      obtain ⟨rfl,_,rfl⟩ := h
      rfl
    · apply hq.map
      intro ⟨A,x⟩ ⟨B,y⟩ h
      simp only [Prod.mk.injEq, List.cons.injEq] at h
      obtain ⟨rfl,_,rfl⟩ := h
      rfl
    · apply List.disjoint_left.mpr
      intro z hz hz'
      simp only [List.mem_map] at hz hz'
      obtain ⟨⟨A,x⟩,_,rfl⟩ := hz
      obtain ⟨⟨B,y⟩,_,he⟩ := hz'
      simp at he
  | mul p q hp hq =>
    have he : parseCodes (.mul p q) =
        ((parseCodes p).product (parseCodes q)).map
          (fun ab => (Formula.mul ab.1.1 ab.2.1, ab.1.2 ++ ab.2.2)) := by
      simp [parseCodes, List.product, List.map_flatMap, List.map_map, Function.comp_def]
    rw [he]
    apply (hp.product hq).map_on
    intro ⟨a,b⟩ ha ⟨a',b'⟩ ha' he
    simp only [List.mem_product] at ha ha'
    obtain ⟨rfl,rfl⟩ := product_code_injective p a a' b b' ha.1 ha'.1 he
    rfl

/-- Each tree of a bounded-degree circuit has a choice code of polynomial
    length. The decoding formula still needs an efficient circuit encoding. -/
theorem bounded_circuit_code_length [DecidableEq σ] (C : ResultantVNP.Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d) (T : Formula σ) (bits : List Bool)
    (h : (T,bits) ∈ parseCodes (CircuitNormalizedFormula.boundedCircuitFormula C d)) :
    bits.length ≤ 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2) := by
  obtain ⟨c,hc,hbits⟩ := parseCodes_trace _ T bits h
  have hbound := (CircuitParseTraces.bounded_circuit_parseTraces C d hdegree).2 T c hc
  omega


end CircuitParseCodes

-- From Solutions.ParseDecoderMachine

/-! A small-step version of the parse decoder. The pending stack is an
abstract formula stack; encoding stack entries by compact circuit addresses
and bounding the running time remain separate obligations. -/

namespace ParseDecoderMachine

open PermanentFoundation CircuitParseCodes MvPolynomial

variable {σ : Type}

noncomputable def decodeStack : List (Formula σ) → List Bool →
    Option (MvPolynomial σ ℂ × List Bool)
  | [], bits => some (1,bits)
  | F :: rest, bits => do
      let (T,bits') ← decode F bits
      let (p,bits'') ← decodeStack rest bits'
      some (T.value * p,bits'')

structure State (σ : Type) where
  pending : List (Formula σ)
  bits : List Bool
  product : MvPolynomial σ ℂ

/-- One step expands a product, makes one addition choice, or consumes a
    leaf. Failure means a choice was requested after the input ended. -/
noncomputable def step (s : State σ) : Option (State σ) :=
  match s.pending with
  | [] => some s
  | .var x :: rest => some ⟨rest,s.bits,s.product * X x⟩
  | .const a :: rest => some ⟨rest,s.bits,s.product * C a⟩
  | .add p q :: rest =>
      match s.bits with
      | [] => none
      | b :: bits => some ⟨(if b then q else p) :: rest,bits,s.product⟩
  | .mul p q :: rest => some ⟨p :: q :: rest,s.bits,s.product⟩

noncomputable def semantics (s : State σ) : Option (MvPolynomial σ ℂ × List Bool) := do
  let (p,bits) ← decodeStack s.pending s.bits
  some (s.product * p,bits)

/-- Each machine step preserves the semantic decoding result, including
    the unconsumed suffix. -/
theorem semantics_step (s : State σ) :
    (step s).bind semantics = semantics s := by
  rcases s with ⟨pending,bits,product⟩
  cases pending with
  | nil => rfl
  | cons F rest =>
    cases F with
    | var x =>
      simp only [step, semantics, decodeStack, decode, Option.bind_some]
      cases h : decodeStack rest bits with
      | none => simp [h]
      | some pair => rcases pair with ⟨p,b⟩; simp [h, Formula.value, mul_assoc]
    | const a =>
      simp only [step, semantics, decodeStack, decode, Option.bind_some]
      cases h : decodeStack rest bits with
      | none => simp [h]
      | some pair => rcases pair with ⟨p,b⟩; simp [h, Formula.value, mul_assoc]
    | add p q =>
      cases bits with
      | nil => rfl
      | cons b bits => cases b <;> rfl
    | mul p q =>
      simp only [step, semantics, decodeStack, decode, Option.bind_some]
      cases h₁ : decode p bits with
      | none => rfl
      | some pair =>
        rcases pair with ⟨P,bits₁⟩
        cases h₂ : decode q bits₁ with
        | none => simp [h₂]
        | some pair =>
          rcases pair with ⟨Q,bits₂⟩
          cases h₃ : decodeStack rest bits₂ with
          | none => simp [h₂,h₃]
          | some pair =>
            rcases pair with ⟨v,bits₃⟩
            simp [h₂,h₃, Formula.value, mul_assoc]

/-- Initialize the machine on a single formula. -/
noncomputable def initial (F : Formula σ) (bits : List Bool) : State σ := ⟨[F],bits,1⟩

theorem semantics_initial (F : Formula σ) (bits : List Bool) :
    semantics (initial F bits) = (decode F bits).map (fun p => (p.1.value,p.2)) := by
  cases h : decode F bits with
  | none => simp [semantics, initial, decodeStack, h]
  | some p => rcases p with ⟨T,rest⟩; simp [semantics, initial, decodeStack, h]

noncomputable def run : ℕ → Option (State σ) → Option (State σ)
  | 0, s => s
  | n + 1, s => run n (s.bind step)

/-- Any finite number of steps preserves the initial semantic result. -/
theorem run_semantics (n : ℕ) (s : Option (State σ)) :
    (run n s).bind semantics = s.bind semantics := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    rw [run, ih]
    cases s with
    | none => rfl
    | some s => simpa using semantics_step s

theorem semantics_done (s : State σ) (h : s.pending = []) :
    semantics s = some (s.product,s.bits) := by
  simp [semantics, decodeStack, h]

/-- Whenever the small-step machine has consumed its stack, its accumulated
    product and remaining suffix agree with the recursive parse decoder. -/
theorem run_done_correct (F : Formula σ) (bits : List Bool) (n : ℕ) (s : State σ)
    (hrun : run n (some (initial F bits)) = some s) (hdone : s.pending = []) :
    (decode F bits).map (fun p => (p.1.value,p.2)) = some (s.product,s.bits) := by
  have h := run_semantics n (some (initial F bits))
  rw [hrun] at h
  simpa [semantics_initial, semantics_done s hdone] using h.symm

/-- Number of syntax-tree nodes in the pending formulas. This gives a
    termination measure, but can be exponential in a shared circuit's size. -/
def pendingWeight (pending : List (Formula σ)) : ℕ :=
  (pending.map (fun F => 2 * F.size + 1)).sum

theorem step_weight_decreases (s t : State σ) (hne : s.pending ≠ [])
    (hstep : step s = some t) : pendingWeight t.pending < pendingWeight s.pending := by
  rcases s with ⟨pending,bits,product⟩
  cases pending with
  | nil => contradiction
  | cons F rest =>
    cases F with
    | var x =>
      simp only [step, Option.some.injEq] at hstep
      subst t
      simp [pendingWeight, Formula.size]
    | const a =>
      simp only [step, Option.some.injEq] at hstep
      subst t
      simp [pendingWeight, Formula.size]
    | add p q =>
      cases bits with
      | nil => simp [step] at hstep
      | cons b bits =>
        cases b <;> simp only [step, Bool.false_eq_true, ↓reduceIte, Option.some.injEq] at hstep <;>
          subst t <;> simp only [pendingWeight, List.map_cons, List.sum_cons, Formula.size] <;> omega
    | mul p q =>
      simp only [step, Option.some.injEq] at hstep
      subst t
      simp only [pendingWeight, List.map_cons, List.sum_cons, Formula.size]
      omega

theorem run_none (n : ℕ) : run n (none : Option (State σ)) = none := by
  induction n with
  | zero => rfl
  | succ n ih => simpa [run] using ih

theorem run_done (n : ℕ) (s : State σ) (h : s.pending = []) :
    run n (some s) = some s := by
  induction n with
  | zero => rfl
  | succ n ih => simpa [run,step,h] using ih

/-- The machine either fails on incomplete input or reaches an empty stack
    within the syntax-tree node count. -/
theorem run_terminates (n : ℕ) (s : State σ) (hbound : pendingWeight s.pending ≤ n) :
    run n (some s) = none ∨ ∃ t, run n (some s) = some t ∧ t.pending = [] := by
  induction n generalizing s with
  | zero =>
    right
    refine ⟨s,rfl,?_⟩
    cases hp : s.pending with
    | nil => rfl
    | cons F rest => simp [hp,pendingWeight] at hbound
  | succ n ih =>
    by_cases hdone : s.pending = []
    · right; exact ⟨s,run_done _ s hdone,hdone⟩
    · cases hs : step s with
      | none => left; simp [run,hs,run_none]
      | some t =>
        have hdec := step_weight_decreases s t hdone hs
        have ht : pendingWeight t.pending ≤ n := by omega
        have hh := ih t ht
        simpa [run,hs] using hh


end ParseDecoderMachine

-- From Solutions.ParseDecoderRuntime

namespace ParseDecoderRuntime

open PermanentFoundation CircuitParseTrees CircuitParseTraces CircuitParseCodes ParseDecoderMachine
  CircuitNormalizedFormula ResultantVNP MvPolynomial

variable {σ : Type}

/-- A parse derivation records its product tree, its choice bits, and the
    number of small-step decoder transitions. -/
inductive Derivation : Formula σ → Formula σ → List Bool → ℕ → Prop
  | var (x : σ) : Derivation (.var x) (.var x) [] 1
  | const (a : ℂ) : Derivation (.const a) (.const a) [] 1
  | addLeft {p q T bits c} : Derivation p T bits c →
      Derivation (.add p q) T (false :: bits) (c + 1)
  | addRight {p q T bits c} : Derivation q T bits c →
      Derivation (.add p q) T (true :: bits) (c + 1)
  | mul {p q P Q a b c d} : Derivation p P a c → Derivation q Q b d →
      Derivation (.mul p q) (.mul P Q) (a ++ b) (c + d + 1)

theorem derivation_trace {F T : Formula σ} {bits : List Bool} {c : ℕ}
    (h : Derivation F T bits c) : (T,c) ∈ parseTraces F := by
  induction h with
  | var x => simp [parseTraces]
  | const a => simp [parseTraces]
  | addLeft h ih => simp only [parseTraces, List.mem_map, List.mem_append]; exact ⟨_,Or.inl ih,rfl⟩
  | addRight h ih => simp only [parseTraces, List.mem_map, List.mem_append]; exact ⟨_,Or.inr ih,rfl⟩
  | mul hp hq ihp ihq =>
    simp only [parseTraces, List.mem_flatMap, List.mem_map]
    exact ⟨_,ihp,_,ihq,rfl⟩

theorem code_derivation (F T : Formula σ) (bits : List Bool)
    (h : (T,bits) ∈ parseCodes F) : ∃ c, Derivation F T bits c := by
  induction F generalizing T bits with
  | var x =>
    simp only [parseCodes, List.mem_singleton, Prod.mk.injEq] at h
    obtain ⟨rfl,rfl⟩ := h
    exact ⟨1,Derivation.var x⟩
  | const a =>
    simp only [parseCodes, List.mem_singleton, Prod.mk.injEq] at h
    obtain ⟨rfl,rfl⟩ := h
    exact ⟨1,Derivation.const a⟩
  | add p q hp hq =>
    simp only [parseCodes, List.mem_append, List.mem_map] at h
    rcases h with h | h
    · obtain ⟨⟨U,b⟩,hu,he⟩ := h
      simp only [Prod.mk.injEq] at he
      obtain ⟨rfl,rfl⟩ := he
      obtain ⟨c,hc⟩ := hp U b hu
      exact ⟨c+1,Derivation.addLeft hc⟩
    · obtain ⟨⟨U,b⟩,hu,he⟩ := h
      simp only [Prod.mk.injEq] at he
      obtain ⟨rfl,rfl⟩ := he
      obtain ⟨c,hc⟩ := hq U b hu
      exact ⟨c+1,Derivation.addRight hc⟩
  | mul p q hp hq =>
    simp only [parseCodes, List.mem_flatMap, List.mem_map] at h
    obtain ⟨⟨P,a⟩,ha,⟨Q,b⟩,hb,he⟩ := h
    simp only [Prod.mk.injEq] at he
    obtain ⟨rfl,rfl⟩ := he
    obtain ⟨c,hc⟩ := hp P a ha
    obtain ⟨d,hd⟩ := hq Q b hb
    exact ⟨c+d+1,Derivation.mul hc hd⟩

theorem run_add (m n : ℕ) (s : Option (State σ)) :
    run (m+n) s = run n (run m s) := by
  induction m generalizing s with
  | zero => simp [run]
  | succ m ih =>
    simp only [Nat.succ_add, run]
    exact ih (s.bind step)

/-- Following a valid derivation takes exactly its recorded number of steps,
    preserves the remaining stack and input, and multiplies the product tree. -/
theorem derivation_run {F T : Formula σ} {bits : List Bool} {c : ℕ}
    (h : Derivation F T bits c) (rest : List (Formula σ)) (suffix : List Bool)
    (acc : MvPolynomial σ ℂ) :
    run c (some ⟨F :: rest, bits ++ suffix, acc⟩) =
      some ⟨rest,suffix,acc * T.value⟩ := by
  induction h generalizing rest suffix acc with
  | var x => simp [run, step, Formula.value]
  | const a => simp [run, step, Formula.value]
  | addLeft h ih => simpa [run, step] using ih rest suffix acc
  | addRight h ih => simpa [run, step] using ih rest suffix acc
  | @mul p q P Q a b c d hp hq ihp ihq =>
    rw [show c + d + 1 = (c+d) + 1 by omega]
    simp only [run, step, Option.bind_some, List.append_assoc]
    rw [run_add]
    rw [ihp (q :: rest) (b ++ suffix) acc]
    rw [ihq rest suffix (acc * P.value)]
    simp [Formula.value, mul_assoc]

/-- Valid codes for bounded-degree circuits drive the abstract decoder to
    completion within the previously established polynomial trace bound. -/
theorem boundedCircuit_code_runs [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d) (T : Formula σ) (bits suffix : List Bool)
    (h : (T,bits) ∈ parseCodes (boundedCircuitFormula C d)) :
    ∃ c, c ≤ 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2) ∧
      run c (some (initial (boundedCircuitFormula C d) (bits ++ suffix))) =
        some ⟨[],suffix,T.value⟩ := by
  obtain ⟨c,hc⟩ := code_derivation _ T bits h
  refine ⟨c,?_,?_⟩
  · exact (bounded_circuit_parseTraces C d hdegree).2 T c (derivation_trace hc)
  · simpa [initial] using derivation_run hc [] suffix 1


end ParseDecoderRuntime

-- From Solutions.ParseCodeCompleteness

/-! The parse-code language is complete: with enough input bits, decoding
    always finds a code prefix. This makes fixed-length invalid witnesses
    rejectable by checking their leftover padding. -/

namespace ParseCodeCompleteness

open PermanentFoundation CircuitParseCodes ParseDecoderRuntime ParseDecoderMachine
  CircuitNormalizedFormula ResultantVNP MvPolynomial

variable {σ : Type}

def maxChoices : Formula σ → ℕ
  | .var _ | .const _ => 0
  | .add p q => max (maxChoices p) (maxChoices q) + 1
  | .mul p q => maxChoices p + maxChoices q

theorem code_length_le (F T : Formula σ) (bits : List Bool)
    (h : (T,bits) ∈ parseCodes F) : bits.length ≤ maxChoices F := by
  induction F generalizing T bits with
  | var x => simp [parseCodes] at h; obtain ⟨rfl,rfl⟩ := h; simp [maxChoices]
  | const a => simp [parseCodes] at h; obtain ⟨rfl,rfl⟩ := h; simp [maxChoices]
  | add p q hp hq =>
    simp only [parseCodes, List.mem_append, List.mem_map] at h
    rcases h with h | h
    · obtain ⟨⟨U,b⟩,hu,he⟩ := h
      simp only [Prod.mk.injEq] at he
      obtain ⟨rfl,rfl⟩ := he
      have hh := hp U b hu
      simp only [List.length_cons, maxChoices]
      have hm := le_max_left (maxChoices p) (maxChoices q)
      omega
    · obtain ⟨⟨U,b⟩,hu,he⟩ := h
      simp only [Prod.mk.injEq] at he
      obtain ⟨rfl,rfl⟩ := he
      have hh := hq U b hu
      simp only [List.length_cons, maxChoices]
      have hm := le_max_right (maxChoices p) (maxChoices q)
      omega
  | mul p q hp hq =>
    simp only [parseCodes, List.mem_flatMap, List.mem_map] at h
    obtain ⟨⟨P,a⟩,ha,⟨Q,b⟩,hb,he⟩ := h
    simp only [Prod.mk.injEq] at he
    obtain ⟨rfl,rfl⟩ := he
    have hp' := hp P a ha
    have hq' := hq Q b hb
    simp only [List.length_append, maxChoices]
    omega

/-- The upper bound is attained; this is essential for obtaining a
    polynomial bound from the size bound on individual parse derivations. -/
theorem maxChoices_attained (F : Formula σ) :
    ∃ T bits, (T,bits) ∈ parseCodes F ∧ bits.length = maxChoices F := by
  induction F with
  | var x => exact ⟨.var x,[],by simp [parseCodes],rfl⟩
  | const a => exact ⟨.const a,[],by simp [parseCodes],rfl⟩
  | add p q hp hq =>
    obtain ⟨P,a,ha,hpa⟩ := hp
    obtain ⟨Q,b,hb,hqb⟩ := hq
    by_cases h : maxChoices p ≥ maxChoices q
    · refine ⟨P,false :: a,?_,?_⟩
      · simp only [parseCodes, List.mem_append, List.mem_map]
        exact Or.inl ⟨(P,a),ha,rfl⟩
      · simp [maxChoices, hpa, max_eq_left h]
    · refine ⟨Q,true :: b,?_,?_⟩
      · simp only [parseCodes, List.mem_append, List.mem_map]
        exact Or.inr ⟨(Q,b),hb,rfl⟩
      · simp [maxChoices, hqb, max_eq_right (by omega : maxChoices p ≤ maxChoices q)]
  | mul p q hp hq =>
    obtain ⟨P,a,ha,hpa⟩ := hp
    obtain ⟨Q,b,hb,hqb⟩ := hq
    refine ⟨.mul P Q,a++b,?_,?_⟩
    · simp only [parseCodes, List.mem_flatMap, List.mem_map]
      exact ⟨(P,a),ha,(Q,b),hb,rfl⟩
    · simp [maxChoices,hpa,hqb]

/-- Enough input bits always allow the recursive decoder to finish. -/
theorem decode_succeeds (F : Formula σ) (bits : List Bool)
    (hbits : maxChoices F ≤ bits.length) : ∃ T rest, decode F bits = some (T,rest) := by
  induction F generalizing bits with
  | var x => exact ⟨.var x,bits,rfl⟩
  | const a => exact ⟨.const a,bits,rfl⟩
  | add p q hp hq =>
    cases bits with
    | nil => simp [maxChoices] at hbits
    | cons b bits =>
      cases b with
      | false =>
        have hb : maxChoices p ≤ bits.length := by
          simp only [maxChoices, List.length_cons] at hbits
          have hm := le_max_left (maxChoices p) (maxChoices q)
          omega
        obtain ⟨T,rest,he⟩ := hp bits hb
        exact ⟨T,rest,by simpa [decode] using he⟩
      | true =>
        have hb : maxChoices q ≤ bits.length := by
          simp only [maxChoices, List.length_cons] at hbits
          have hm := le_max_right (maxChoices p) (maxChoices q)
          omega
        obtain ⟨T,rest,he⟩ := hq bits hb
        exact ⟨T,rest,by simpa [decode] using he⟩
  | mul p q hp hq =>
    have hleft : maxChoices p ≤ bits.length := by simp only [maxChoices] at hbits; omega
    obtain ⟨P,rest,hpdecode⟩ := hp bits hleft
    obtain ⟨code,hcode,hbits'⟩ := decode_complete p bits P rest hpdecode
    have hc := code_length_le p P code hcode
    have hright : maxChoices q ≤ rest.length := by
      have hlen := congrArg List.length hbits'
      simp only [List.length_append, maxChoices] at *
      omega
    obtain ⟨Q,suffix,hqdecode⟩ := hq rest hright
    exact ⟨.mul P Q,suffix,by simp [decode,hpdecode,hqdecode]⟩

theorem boundedCircuit_maxChoices [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d) :
    maxChoices (boundedCircuitFormula C d) ≤
      2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2) := by
  obtain ⟨T,bits,hbits,hlen⟩ := maxChoices_attained (boundedCircuitFormula C d)
  rw [← hlen]
  exact bounded_circuit_code_length C d hdegree T bits hbits

/-- Every fixed-length witness, including one whose leftover padding will be
    rejected, causes the abstract decoder to halt within the polynomial bound. -/
theorem boundedCircuit_all_bits_run [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d) (bits : List Bool)
    (hlen : bits.length =
      2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)) :
    ∃ T suffix,
      decode (boundedCircuitFormula C d) bits = some (T,suffix) ∧
      run (2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2))
        (some (initial (boundedCircuitFormula C d) bits)) = some ⟨[],suffix,T.value⟩ := by
  let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
  have hb : maxChoices (boundedCircuitFormula C d) ≤ bits.length := by
    rw [hlen]
    exact boundedCircuit_maxChoices C d hdegree
  obtain ⟨T,suffix,hdecode⟩ := decode_succeeds (boundedCircuitFormula C d) bits hb
  obtain ⟨code,hcode,hbits⟩ := decode_complete (boundedCircuitFormula C d) bits T suffix hdecode
  obtain ⟨c,hc,hrun⟩ := boundedCircuit_code_runs C d hdegree T code suffix hcode
  refine ⟨T,suffix,hdecode,?_⟩
  change run N (some (initial (boundedCircuitFormula C d) bits)) = some ⟨[],suffix,T.value⟩
  rw [hbits]
  have heq : N = c + (N - c) := by dsimp [N] at *; omega
  rw [heq,run_add,hrun,run_done]
  rfl

/-- Appending extra bits does not change the parsed tree. The same
    polynomial step bound applies, and the extra bits remain in the suffix. -/
theorem boundedCircuit_extension_run [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d) (bits extra : List Bool)
    (hlen : bits.length =
      2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)) :
    ∃ T suffix,
      decode (boundedCircuitFormula C d) bits = some (T,suffix) ∧
      run (2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2))
        (some (initial (boundedCircuitFormula C d) (bits ++ extra))) = some ⟨[],suffix ++ extra,T.value⟩ := by
  let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
  obtain ⟨T,suffix,hdecode,_⟩ := boundedCircuit_all_bits_run C d hdegree bits hlen
  obtain ⟨code,hcode,hbits⟩ := decode_complete (boundedCircuitFormula C d) bits T suffix hdecode
  obtain ⟨c,hc,hrun⟩ := boundedCircuit_code_runs C d hdegree T code (suffix ++ extra) hcode
  refine ⟨T,suffix,hdecode,?_⟩
  change run N (some (initial (boundedCircuitFormula C d) (bits ++ extra))) = _
  rw [hbits,List.append_assoc]
  have heq : N = c + (N-c) := by dsimp [N] at *; omega
  rw [heq,run_add,hrun,run_done]
  rfl


end ParseCodeCompleteness

-- From Solutions.CircuitFixedCodes

namespace CircuitFixedCodes

open PermanentFoundation CircuitParseTrees CircuitParseCodes MvPolynomial

variable {σ : Type}

def padCode (n : ℕ) (bits : List Bool) : List Bool :=
  bits ++ List.replicate (n - bits.length) false

theorem padCode_length (n : ℕ) (bits : List Bool) (h : bits.length ≤ n) :
    (padCode n bits).length = n := by
  simp [padCode, h]

def padFunction (n : ℕ) (bits : List Bool) : Fin n → Bool :=
  fun i => (padCode n bits).getD i.val false

theorem ofFn_padFunction (n : ℕ) (bits : List Bool) (h : bits.length ≤ n) :
    List.ofFn (padFunction n bits) = padCode n bits := by
  apply List.ext_getElem
  · simp [padCode_length n bits h]
  · intro i hi₁ hi₂
    simp only [List.getElem_ofFn, padFunction]
    exact List.getD_eq_getElem _ _ hi₂

/-- Decode and retain a tree only when the unused padding consists of zeros. -/
noncomputable def decodedWeight (F : Formula σ) (n : ℕ) (z : Fin n → Bool) : MvPolynomial σ ℂ :=
  match decode F (List.ofFn z) with
  | none => 0
  | some (T,rest) => if rest = List.replicate rest.length false then T.value else 0

theorem decodedWeight_pad (F : Formula σ) (n : ℕ) (T : Formula σ) (bits : List Bool)
    (h : (T,bits) ∈ parseCodes F) (hn : bits.length ≤ n) :
    decodedWeight F n (padFunction n bits) = T.value := by
  rw [decodedWeight, ofFn_padFunction n bits hn]
  simp only [padCode, decode_code_append F T bits _ h, List.length_replicate, if_true]

/-- A nonzero decoded contribution has a unique generated code followed by
    the prescribed zero padding. -/
theorem decodedWeight_nonzero (F : Formula σ) (n : ℕ) (z : Fin n → Bool)
    (h : decodedWeight F n z ≠ 0) :
    ∃ T bits, (T,bits) ∈ parseCodes F ∧ bits.length ≤ n ∧ padFunction n bits = z := by
  classical
  cases he : decode F (List.ofFn z) with
  | none => simp [decodedWeight, he] at h
  | some pair =>
    rcases pair with ⟨T,rest⟩
    by_cases hz : rest = List.replicate rest.length false
    · obtain ⟨bits,hbits,hlist⟩ := decode_complete F (List.ofFn z) T rest he
      have hlen : bits.length + rest.length = n := by
        have hh := congrArg List.length hlist
        simpa using hh.symm
      have hn : bits.length ≤ n := by omega
      refine ⟨T,bits,hbits,hn,?_⟩
      apply List.ofFn_injective
      rw [ofFn_padFunction n bits hn]
      rw [hlist]
      unfold padCode
      have heq : n - bits.length = rest.length := by omega
      rw [heq, ← hz]
    · simp [decodedWeight, he, hz] at h

/-- Zero padding is injective on valid parse codes. -/
theorem padFunction_inj (F : Formula σ) (n : ℕ) (T U : Formula σ) (a b : List Bool)
    (hT : (T,a) ∈ parseCodes F) (hU : (U,b) ∈ parseCodes F)
    (ha : a.length ≤ n) (hb : b.length ≤ n)
    (he : padFunction n a = padFunction n b) : (T,a) = (U,b) := by
  have he' := congrArg List.ofFn he
  rw [ofFn_padFunction n a ha, ofFn_padFunction n b hb] at he'
  have hd₁ := decode_code_append F T a (List.replicate (n - a.length) false) hT
  have hd₂ := decode_code_append F U b (List.replicate (n - b.length) false) hU
  change decode F (padCode n a) = _ at hd₁
  change decode F (padCode n b) = _ at hd₂
  rw [he', hd₂] at hd₁
  have hp : (U,List.replicate (n - b.length) false) =
      (T,List.replicate (n - a.length) false) := Option.some.inj hd₁
  have hT' : U = T := congrArg Prod.fst hp
  have hr := congrArg Prod.snd hp
  dsimp only at hr
  have hab : a = b := by
    unfold padCode at he'
    rw [← hr] at he'
    exact List.append_cancel_right he'
  subst U
  subst b
  rfl

/-- The formula value is exactly a fixed-length Boolean sum of the semantic
    decoder weights. This identity alone does not bound the formula size of
    the decoder. -/
theorem decodedWeight_sum (F : Formula σ) (n : ℕ)
    (hbound : ∀ T bits, (T,bits) ∈ parseCodes F → bits.length ≤ n) :
    (∑ z : Fin n → Bool, decodedWeight F n z) = F.value := by
  classical
  let S := (parseCodes F).toFinset
  let g : Formula σ × List Bool → (Fin n → Bool) := fun x => padFunction n x.2
  let P := S.image g
  have hi : Set.InjOn g S := by
    intro ⟨T,a⟩ ha ⟨U,b⟩ hb he
    have ha' : (T,a) ∈ parseCodes F := List.mem_toFinset.mp ha
    have hb' : (U,b) ∈ parseCodes F := List.mem_toFinset.mp hb
    exact padFunction_inj F n T U a b ha' hb' (hbound T a ha') (hbound U b hb') he
  have hzero : ∀ z ∈ (Finset.univ : Finset (Fin n → Bool)), z ∉ P → decodedWeight F n z = 0 := by
    intro z _ hz
    by_contra hn
    obtain ⟨T,bits,hbits,_,he⟩ := decodedWeight_nonzero F n z hn
    apply hz
    exact Finset.mem_image.mpr ⟨(T,bits), List.mem_toFinset.mpr hbits, he⟩
  have hsum : ∑ x ∈ S, x.1.value = F.value := by
    rw [List.sum_toFinset (fun x : Formula σ × List Bool => x.1.value) (parseCodes_nodup F)]
    have ht := parseTrees_sum F
    rw [← parseCodes_trees F] at ht
    simpa [List.map_map, Function.comp_def] using ht
  calc
    (∑ z : Fin n → Bool, decodedWeight F n z) = ∑ z ∈ P, decodedWeight F n z :=
      (Finset.sum_subset (Finset.subset_univ P) hzero).symm
    _ = ∑ x ∈ S, decodedWeight F n (g x) := Finset.sum_image hi
    _ = ∑ x ∈ S, x.1.value := by
      apply Finset.sum_congr rfl
      intro ⟨T,bits⟩ hx
      have hh : (T,bits) ∈ parseCodes F := List.mem_toFinset.mp hx
      exact decodedWeight_pad F n T bits hh (hbound T bits hh)
    _ = F.value := hsum

/-- Every bounded-degree circuit has a polynomial-length Boolean summation
    index whose semantic decoder sums to the circuit output. This is not yet
    a VP-to-formula-witness construction: the decoder is a Lean function and
    has not been compiled to a polynomial-size arithmetic formula. -/
theorem boundedCircuit_decodedWeight_sum [DecidableEq σ] (C : ResultantVNP.Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d) :
    let n := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
    (∑ z : Fin n → Bool,
      decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula C d) n z) = C.value := by
  dsimp only
  rw [decodedWeight_sum]
  · have h := (CircuitNormalizedFormula.bounded_circuit_parseTrees C d hdegree).1
    rw [parseTrees_sum] at h
    exact h
  · intro T bits h
    exact bounded_circuit_code_length C d hdegree T bits h


end CircuitFixedCodes

-- From Solutions.ParseFactorMachine

/-! A decoder that records leaf factors instead of storing a potentially
    enormous polynomial. This is the representation needed for a finite
    Boolean transcript and a separate arithmetic product payload. -/

namespace ParseFactorMachine

open PermanentFoundation ParseDecoderMachine CircuitParseCodes MvPolynomial

variable {σ : Type}

structure State (σ : Type) where
  pending : List (Formula σ)
  bits : List Bool
  factors : List (Formula σ)

noncomputable def step (s : State σ) : Option (State σ) :=
  match s.pending with
  | [] => some s
  | .var x :: rest => some ⟨rest,s.bits,.var x :: s.factors⟩
  | .const a :: rest => some ⟨rest,s.bits,.const a :: s.factors⟩
  | .add p q :: rest =>
      match s.bits with
      | [] => none
      | b :: bits => some ⟨(if b then q else p) :: rest,bits,s.factors⟩
  | .mul p q :: rest => some ⟨p :: q :: rest,s.bits,s.factors⟩

noncomputable def forget (s : State σ) : ParseDecoderMachine.State σ :=
  ⟨s.pending,s.bits,(s.factors.map Formula.value).prod⟩

/-- Recording a leaf and multiplying its value are equivalent operations. -/
theorem forget_step (s : State σ) :
    (step s).map forget = ParseDecoderMachine.step (forget s) := by
  rcases s with ⟨pending,bits,factors⟩
  cases pending with
  | nil => rfl
  | cons F rest =>
    cases F with
    | var x => simp [step, forget, ParseDecoderMachine.step, Formula.value, mul_comm]
    | const a => simp [step, forget, ParseDecoderMachine.step, Formula.value, mul_comm]
    | add p q => cases bits with
      | nil => rfl
      | cons b bits => cases b <;> rfl
    | mul p q => rfl

noncomputable def run : ℕ → Option (State σ) → Option (State σ)
  | 0, s => s
  | n + 1, s => run n (s.bind step)

theorem run_forget (n : ℕ) (s : Option (State σ)) :
    (run n s).map forget = ParseDecoderMachine.run n (s.map forget) := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    rw [run,ih,ParseDecoderMachine.run]
    cases s with
    | none => rfl
    | some s => simpa using congrArg (ParseDecoderMachine.run n) (forget_step s)

def leaf : Formula σ → Prop
  | .var _ | .const _ => True
  | .add _ _ | .mul _ _ => False

theorem step_leaves (s t : State σ) (hs : ∀ F ∈ s.factors, leaf F)
    (hstep : step s = some t) : ∀ F ∈ t.factors, leaf F := by
  rcases s with ⟨pending,bits,factors⟩
  cases pending with
  | nil => simp only [step, Option.some.injEq] at hstep; subst t; exact hs
  | cons F rest =>
    cases F with
    | var x =>
      simp only [step, Option.some.injEq] at hstep; subst t
      intro G hG; simp only [List.mem_cons] at hG
      rcases hG with rfl | hG
      · trivial
      · exact hs G hG
    | const a =>
      simp only [step, Option.some.injEq] at hstep; subst t
      intro G hG; simp only [List.mem_cons] at hG
      rcases hG with rfl | hG
      · trivial
      · exact hs G hG
    | add p q =>
      cases bits with
      | nil => simp [step] at hstep
      | cons b bits => cases b <;> simp only [step, Bool.false_eq_true, ↓reduceIte,
          Option.some.injEq] at hstep <;> subst t <;> exact hs
    | mul p q => simp only [step, Option.some.injEq] at hstep; subst t; exact hs

/-- A single decoder step adds at most one factor and one stack entry. -/
theorem step_length_bounds (s t : State σ) (hstep : step s = some t) :
    t.factors.length ≤ s.factors.length + 1 ∧ t.pending.length ≤ s.pending.length + 1 := by
  rcases s with ⟨pending,bits,factors⟩
  cases pending with
  | nil => simp only [step, Option.some.injEq] at hstep; subst t; simp
  | cons F rest =>
    cases F with
    | var x => simp only [step, Option.some.injEq] at hstep; subst t; simp; omega
    | const a => simp only [step, Option.some.injEq] at hstep; subst t; simp; omega
    | add p q =>
      cases bits with
      | nil => simp [step] at hstep
      | cons b bits => cases b <;> simp only [step, Bool.false_eq_true, ↓reduceIte,
          Option.some.injEq] at hstep <;> subst t <;> simp
    | mul p q => simp only [step, Option.some.injEq] at hstep; subst t; simp

theorem run_none (n : ℕ) : run n (none : Option (State σ)) = none := by
  induction n with
  | zero => rfl
  | succ n ih => simpa [run] using ih

theorem run_invariants (n : ℕ) (s t : State σ) (hrun : run n (some s) = some t)
    (hleaves : ∀ F ∈ s.factors, leaf F) :
    t.factors.length ≤ s.factors.length + n ∧
    t.pending.length ≤ s.pending.length + n ∧
    ∀ F ∈ t.factors, leaf F := by
  induction n generalizing s with
  | zero =>
    simp only [run, Option.some.injEq] at hrun
    subst t
    exact ⟨by omega,by omega,hleaves⟩
  | succ n ih =>
    cases hs : step s with
    | none =>
      simp only [run,Option.bind_some,hs,run_none] at hrun
      contradiction
    | some u =>
      have hu := step_length_bounds s u hs
      have hleaves' := step_leaves s u hleaves hs
      have hh : run n (some u) = some t := by simpa [run,hs] using hrun
      obtain ⟨hf,hp,hl⟩ := ih u hh hleaves'
      exact ⟨by omega,by omega,hl⟩

def initial (F : Formula σ) (bits : List Bool) : State σ := ⟨[F],bits,[]⟩

/-- A fixed-length decoder input yields a list of at most `N` leaves, whose
    product is the decoded product tree. The formulas in the pending stack
    are still abstract objects; encoding their addresses remains necessary. -/
theorem boundedCircuit_factors [DecidableEq σ] (C : ResultantVNP.Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d) (bits : List Bool)
    (hlen : bits.length =
      2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)) :
    let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
    ∃ T suffix s,
      decode (CircuitNormalizedFormula.boundedCircuitFormula C d) bits = some (T,suffix) ∧
      run N (some (initial (CircuitNormalizedFormula.boundedCircuitFormula C d) bits)) = some s ∧
      s.pending = [] ∧ s.bits = suffix ∧ (s.factors.map Formula.value).prod = T.value ∧
      s.factors.length ≤ N ∧ ∀ F ∈ s.factors, leaf F := by
  dsimp only
  let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
  obtain ⟨T,suffix,hdecode,hrun⟩ := ParseCodeCompleteness.boundedCircuit_all_bits_run C d hdegree bits hlen
  let s₀ := initial (CircuitNormalizedFormula.boundedCircuitFormula C d) bits
  have hsim := run_forget N (some s₀)
  have hinit : forget s₀ = ParseDecoderMachine.initial (CircuitNormalizedFormula.boundedCircuitFormula C d) bits := by
    simp [s₀, initial, forget, ParseDecoderMachine.initial]
  rw [show (some s₀).map forget = some (ParseDecoderMachine.initial
      (CircuitNormalizedFormula.boundedCircuitFormula C d) bits) by simp [hinit], hrun] at hsim
  cases hr : run N (some s₀) with
  | none => simp [hr] at hsim
  | some s =>
    have hf : forget s = ⟨[],suffix,T.value⟩ := by simpa [hr] using hsim
    have hpending : s.pending = [] := congrArg ParseDecoderMachine.State.pending hf
    have hbits : s.bits = suffix := congrArg ParseDecoderMachine.State.bits hf
    have hprod : (s.factors.map Formula.value).prod = T.value :=
      congrArg ParseDecoderMachine.State.product hf
    have hinv := run_invariants N s₀ s hr (by simp [s₀,initial])
    refine ⟨T,suffix,s,hdecode,rfl,hpending,hbits,hprod,?_,hinv.2.2⟩
    simpa [s₀,initial] using hinv.1

theorem boundedCircuit_factors_extension [DecidableEq σ] (C : ResultantVNP.Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d) (bits extra : List Bool)
    (hlen : bits.length =
      2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)) :
    let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
    ∃ T suffix s,
      decode (CircuitNormalizedFormula.boundedCircuitFormula C d) bits = some (T,suffix) ∧
      run N (some (initial (CircuitNormalizedFormula.boundedCircuitFormula C d) (bits ++ extra))) = some s ∧
      s.pending = [] ∧ s.bits = suffix ++ extra ∧ (s.factors.map Formula.value).prod = T.value ∧
      s.factors.length ≤ N := by
  dsimp only
  let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
  obtain ⟨T,suffix,hdecode,hrun⟩ :=
    ParseCodeCompleteness.boundedCircuit_extension_run C d hdegree bits extra hlen
  let s₀ := initial (CircuitNormalizedFormula.boundedCircuitFormula C d) (bits ++ extra)
  have hsim := run_forget N (some s₀)
  have hinit : forget s₀ = ParseDecoderMachine.initial
      (CircuitNormalizedFormula.boundedCircuitFormula C d) (bits ++ extra) := by
    simp [s₀,initial,forget,ParseDecoderMachine.initial]
  rw [show (some s₀).map forget = some (ParseDecoderMachine.initial
      (CircuitNormalizedFormula.boundedCircuitFormula C d) (bits ++ extra)) by simp [hinit], hrun] at hsim
  cases hr : run N (some s₀) with
  | none => simp [hr] at hsim
  | some s =>
    have hf : forget s = ⟨[],suffix ++ extra,T.value⟩ := by simpa [hr] using hsim
    have hpending : s.pending = [] := congrArg ParseDecoderMachine.State.pending hf
    have hbits : s.bits = suffix ++ extra := congrArg ParseDecoderMachine.State.bits hf
    have hprod : (s.factors.map Formula.value).prod = T.value := congrArg ParseDecoderMachine.State.product hf
    have hinv := run_invariants N s₀ s hr (by simp [s₀,initial])
    refine ⟨T,suffix,s,hdecode,rfl,hpending,hbits,hprod,?_⟩
    simpa [s₀,initial] using hinv.1

/-- The semantic decoder weight is exactly the product of recorded leaves
    when the leftover bits are zero, and zero otherwise. -/
theorem boundedCircuit_factor_weight [DecidableEq σ] (C : ResultantVNP.Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d)
    (z : Fin (2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)) → Bool) :
    let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
    ∃ s, run N (some (initial (CircuitNormalizedFormula.boundedCircuitFormula C d) (List.ofFn z))) = some s ∧
      s.pending = [] ∧ s.factors.length ≤ N ∧ (∀ F ∈ s.factors, leaf F) ∧
      CircuitFixedCodes.decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula C d) N z =
        if s.bits = List.replicate s.bits.length false then (s.factors.map Formula.value).prod else 0 := by
  dsimp only
  have hlen : (List.ofFn z).length =
      2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2) := by
    exact List.length_ofFn
  obtain ⟨T,suffix,s,hdecode,hr,hpending,hbits,hprod,hsize,hleaves⟩ :=
    boundedCircuit_factors C d hdegree (List.ofFn z) hlen
  refine ⟨s,hr,hpending,hsize,hleaves,?_⟩
  simp only [CircuitFixedCodes.decodedWeight, hdecode]
  rw [hbits,hprod]


end ParseFactorMachine

-- From Solutions.AddressFactorMachine

/-! The decoder stack consists of normalized-address tags. The source-formula
    parameters of each tag still need to be encoded as circuit node indices. -/

namespace AddressFactorMachine

open PermanentFoundation NormalizedAddresses

variable {σ : Type}

structure State (σ : Type) where
  pending : List (Address σ)
  bits : List Bool
  factors : List (Formula σ)

noncomputable def step (s : State σ) : Option (State σ) :=
  match s.pending with
  | [] => some s
  | a :: rest =>
    match view a with
    | .var x => some ⟨rest,s.bits,.var x :: s.factors⟩
    | .const c => some ⟨rest,s.bits,.const c :: s.factors⟩
    | .add p q =>
      match s.bits with
      | [] => none
      | b :: bits => some ⟨(if b then q else p) :: rest,bits,s.factors⟩
    | .mul p q => some ⟨p :: q :: rest,s.bits,s.factors⟩

noncomputable def forget (s : State σ) : ParseFactorMachine.State σ :=
  ⟨s.pending.map expand,s.bits,s.factors⟩

theorem forget_step (s : State σ) :
    (step s).map forget = ParseFactorMachine.step (forget s) := by
  rcases s with ⟨pending,bits,factors⟩
  cases pending with
  | nil => rfl
  | cons a rest =>
    have h := view_correct a
    cases hv : view a with
    | var x =>
      simp only [hv, View.formula] at h
      simp [step,forget,ParseFactorMachine.step,hv,← h]
    | const c =>
      simp only [hv, View.formula] at h
      simp [step,forget,ParseFactorMachine.step,hv,← h]
    | add p q =>
      simp only [hv, View.formula] at h
      cases bits with
      | nil => simp [step,forget,ParseFactorMachine.step,hv,← h]
      | cons b bits => cases b <;> simp [step,forget,ParseFactorMachine.step,hv,← h]
    | mul p q =>
      simp only [hv, View.formula] at h
      simp [step,forget,ParseFactorMachine.step,hv,← h]

noncomputable def run : ℕ → Option (State σ) → Option (State σ)
  | 0, s => s
  | n + 1, s => run n (s.bind step)

theorem run_forget (n : ℕ) (s : Option (State σ)) :
    (run n s).map forget = ParseFactorMachine.run n (s.map forget) := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    rw [run,ih,ParseFactorMachine.run]
    cases s with
    | none => rfl
    | some s => simpa using congrArg (ParseFactorMachine.run n) (forget_step s)

noncomputable def initial (C : ResultantVNP.Circuit σ) (d : ℕ) (bits : List Bool) : State σ :=
  ⟨[.root (CircuitFormulaUnfold.circuitFormula C) (d+1)],bits,[]⟩

theorem initial_forget (C : ResultantVNP.Circuit σ) (d : ℕ) (bits : List Bool) :
    forget (initial C d bits) =
      ParseFactorMachine.initial (CircuitNormalizedFormula.boundedCircuitFormula C d) bits := by
  simp [initial,forget,ParseFactorMachine.initial,root_is_boundedCircuit]

/-- For every fixed-length input, the address machine halts in polynomially
    many abstract steps and its recorded factor product gives the decoder
    weight after the padding check. -/
theorem boundedCircuit_address_run [DecidableEq σ] (C : ResultantVNP.Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d)
    (z : Fin (2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)) → Bool) :
    let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
    ∃ s, run N (some (initial C d (List.ofFn z))) = some s ∧
      s.pending = [] ∧ s.factors.length ≤ N ∧ (∀ F ∈ s.factors, ParseFactorMachine.leaf F) ∧
      CircuitFixedCodes.decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula C d) N z =
        if s.bits = List.replicate s.bits.length false then (s.factors.map Formula.value).prod else 0 := by
  dsimp only
  let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
  obtain ⟨t,ht,hpend,hsize,hleaves,hweight⟩ := ParseFactorMachine.boundedCircuit_factor_weight C d hdegree z
  have hsim := run_forget N (some (initial C d (List.ofFn z)))
  rw [show (some (initial C d (List.ofFn z))).map forget =
      some (ParseFactorMachine.initial (CircuitNormalizedFormula.boundedCircuitFormula C d) (List.ofFn z)) by
        change some (forget (initial C d (List.ofFn z))) = _
        rw [initial_forget], ht] at hsim
  cases hr : run N (some (initial C d (List.ofFn z))) with
  | none =>
    simp only [hr, Option.map_none] at hsim
    cases hsim
  | some s =>
    have he : forget s = t := by simpa only [hr, Option.map_some, Option.some.injEq] using hsim
    subst t
    have hp : s.pending = [] := by
      have hmap : s.pending.map expand = [] := hpend
      cases heq : s.pending with
      | nil => rfl
      | cons a rest => simp [heq] at hmap
    exact ⟨s,rfl,hp,hsize,hleaves,hweight⟩


end AddressFactorMachine

-- From Solutions.IndexedFactorMachine

/-! All stack and factor entries are symbolic indices and natural-number
    counters. Complex coefficient values are only looked up when interpreting
    factors as the final arithmetic payload. -/

namespace IndexedFactorMachine

open ResultantVNP PermanentFoundation NormalizedAddresses IndexedNormalizedAddresses MvPolynomial

variable {σ : Type}

inductive Leaf where
  | zero
  | variable (i : ℕ)
  | constantPart (i : ℕ)

structure State where
  pending : List Tag
  bits : List Bool
  factors : List Leaf

def Leaf.bounded (m : ℕ) : Leaf → Prop
  | .zero => True
  | .variable i | .constantPart i => i < m

def Leaf.fields : Leaf → ℕ × ℕ
  | .zero => (0,0)
  | .variable i => (1,i)
  | .constantPart i => (2,i)

theorem Leaf.fields_injective : Function.Injective Leaf.fields := by
  intro a b h
  cases a <;> cases b <;> simp_all [Leaf.fields]

def boundedLeafEncoding (m : ℕ) : {x : Leaf // x.bounded m} ↪ Fin 3 × Fin (m+1) where
  toFun x := by
    have h : x.val.fields.1 < 3 ∧ x.val.fields.2 < m+1 := by
      have hb := x.property
      cases hx : x.val with
      | zero => simp [hx,Leaf.fields]
      | «variable» i => simp only [hx,Leaf.bounded] at hb; simp [hx,Leaf.fields]; omega
      | constantPart i => simp only [hx,Leaf.bounded] at hb; simp [hx,Leaf.fields]; omega
    exact (⟨x.val.fields.1,h.1⟩,⟨x.val.fields.2,h.2⟩)
  inj' := by
    intro a b h
    apply Subtype.ext
    apply Leaf.fields_injective
    have h' := congrArg (fun x : Fin 3 × Fin (m+1) => (x.1.val,x.2.val)) h
    simpa using h'

def leafWord (m : ℕ) (x : {x : Leaf // x.bounded m}) : Fin (3 + (m+1)) → Bool :=
  let p := boundedLeafEncoding m x
  Fin.append (oneHot p.1) (oneHot p.2)

theorem leafWord_injective (m : ℕ) : Function.Injective (leafWord m) := by
  intro a b h
  apply (boundedLeafEncoding m).injective
  dsimp only [leafWord] at h
  obtain ⟨h₁,h₂⟩ := append_injective h
  exact Prod.ext (oneHot_injective 3 h₁) (oneHot_injective (m+1) h₂)

def State.bounded (m D : ℕ) (s : State) : Prop :=
  (∀ a ∈ s.pending, a.bounded m D) ∧ ∀ x ∈ s.factors, x.bounded m

noncomputable def leafFormula (C : Circuit σ) : Leaf → Formula σ
  | .zero => .const 0
  | .variable i => variableFormula C i
  | .constantPart i => .const (coeff 0 (sourceFormula C i).value)

noncomputable def step (C : Circuit σ) (s : State) : Option State :=
  match s.pending with
  | [] => some s
  | a :: rest =>
    match IndexedNormalizedAddresses.view C a with
    | .zero => some ⟨rest,s.bits,.zero :: s.factors⟩
    | .variable i => some ⟨rest,s.bits,.variable i :: s.factors⟩
    | .constantPart i => some ⟨rest,s.bits,.constantPart i :: s.factors⟩
    | .add p q =>
      match s.bits with
      | [] => none
      | b :: bits => some ⟨(if b then q else p) :: rest,bits,s.factors⟩
    | .mul p q => some ⟨p :: q :: rest,s.bits,s.factors⟩

noncomputable def forget (C : Circuit σ) (s : State) : AddressFactorMachine.State σ :=
  ⟨s.pending.map (interpret C),s.bits,s.factors.map (leafFormula C)⟩

/-- A symbolic machine step simulates the address machine exactly. -/
theorem forget_step (C : Circuit σ) (s : State) :
    (step C s).map (forget C) = AddressFactorMachine.step (forget C s) := by
  rcases s with ⟨pending,bits,factors⟩
  cases pending with
  | nil => rfl
  | cons a rest =>
    have h := view_refines C a
    cases hv : IndexedNormalizedAddresses.view C a with
    | zero =>
      simp only [hv,liftView] at h
      simp [step,forget,AddressFactorMachine.step,hv,h,leafFormula]
    | «variable» i =>
      simp only [hv,liftView] at h
      cases hn : sourceNode C i <;>
        simp [step,forget,AddressFactorMachine.step,hv,h,hn,leafFormula,variableFormula] at *
    | constantPart i =>
      simp only [hv,liftView] at h
      simp [step,forget,AddressFactorMachine.step,hv,h,leafFormula]
    | add p q =>
      simp only [hv,liftView] at h
      cases bits with
      | nil => simp [step,forget,AddressFactorMachine.step,hv,h]
      | cons b bits => cases b <;> simp [step,forget,AddressFactorMachine.step,hv,h]
    | mul p q =>
      simp only [hv,liftView] at h
      simp [step,forget,AddressFactorMachine.step,hv,h]

noncomputable def run (C : Circuit σ) : ℕ → Option State → Option State
  | 0, s => s
  | n + 1, s => run C n (s.bind (step C))

theorem run_forget (C : Circuit σ) (n : ℕ) (s : Option State) :
    (run C n s).map (forget C) = AddressFactorMachine.run n (s.map (forget C)) := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    rw [run,ih,AddressFactorMachine.run]
    cases s with
    | none => rfl
    | some s => simpa using congrArg (AddressFactorMachine.run n) (forget_step C s)

/-- Each machine step preserves the node-index and degree-counter bounds. -/
theorem step_bounded (C : Circuit σ) (D : ℕ) (s t : State)
    (hs : s.bounded C.nodes.length D) (he : step C s = some t) :
    t.bounded C.nodes.length D := by
  rcases s with ⟨pending,bits,factors⟩
  cases pending with
  | nil => simp only [step,Option.some.injEq] at he; subst t; exact hs
  | cons a rest =>
    have ha : a.bounded C.nodes.length D := hs.1 a (by simp)
    have hrest : ∀ b ∈ rest, b.bounded C.nodes.length D := by
      intro b hb; exact hs.1 b (by simp [hb])
    have hv := view_bounded C D a ha
    cases hview : IndexedNormalizedAddresses.view C a with
    | zero =>
      simp only [step,hview,Option.some.injEq] at he; subst t
      refine ⟨hrest,?_⟩
      intro x hx
      simp only [List.mem_cons] at hx
      rcases hx with rfl | hx
      · trivial
      · exact hs.2 x hx
    | «variable» i =>
      simp only [hview,View.bounded] at hv
      simp only [step,hview,Option.some.injEq] at he; subst t
      refine ⟨hrest,?_⟩
      intro x hx
      simp only [List.mem_cons] at hx
      rcases hx with rfl | hx
      · exact hv
      · exact hs.2 x hx
    | constantPart i =>
      simp only [hview,View.bounded] at hv
      simp only [step,hview,Option.some.injEq] at he; subst t
      refine ⟨hrest,?_⟩
      intro x hx
      simp only [List.mem_cons] at hx
      rcases hx with rfl | hx
      · exact hv
      · exact hs.2 x hx
    | add p q =>
      simp only [hview,View.bounded] at hv
      cases bits with
      | nil => simp [step,hview] at he
      | cons b bits =>
        cases b <;> simp only [step,hview,Bool.false_eq_true,↓reduceIte,Option.some.injEq] at he <;>
          subst t <;> constructor <;> simp_all [State.bounded]
    | mul p q =>
      simp only [hview,View.bounded] at hv
      simp only [step,hview,Option.some.injEq] at he; subst t
      constructor <;> simp_all [State.bounded]

theorem step_lengths (C : Circuit σ) (s t : State) (he : step C s = some t) :
    t.pending.length ≤ s.pending.length + 1 ∧
    t.factors.length ≤ s.factors.length + 1 ∧ t.bits.length ≤ s.bits.length := by
  rcases s with ⟨pending,bits,factors⟩
  cases pending with
  | nil => simp only [step,Option.some.injEq] at he; subst t; simp
  | cons a rest =>
    cases hv : IndexedNormalizedAddresses.view C a with
    | zero => simp only [step,hv,Option.some.injEq] at he; subst t; simp; omega
    | «variable» i => simp only [step,hv,Option.some.injEq] at he; subst t; simp; omega
    | constantPart i => simp only [step,hv,Option.some.injEq] at he; subst t; simp; omega
    | add p q =>
      cases bits with
      | nil => simp [step,hv] at he
      | cons b bits =>
        cases b <;> simp only [step,hv,Bool.false_eq_true,↓reduceIte,Option.some.injEq] at he <;>
          subst t <;> simp
    | mul p q => simp only [step,hv,Option.some.injEq] at he; subst t; simp

/-- At most one input bit is consumed by a step. -/
theorem step_input_lower (C : Circuit σ) (s t : State) (he : step C s = some t) :
    s.bits.length ≤ t.bits.length + 1 := by
  rcases s with ⟨pending,bits,factors⟩
  cases pending with
  | nil => simp only [step,Option.some.injEq] at he; subst t; simp
  | cons a rest =>
    cases hv : IndexedNormalizedAddresses.view C a with
    | zero => simp only [step,hv,Option.some.injEq] at he; subst t; simp
    | «variable» i => simp only [step,hv,Option.some.injEq] at he; subst t; simp
    | constantPart i => simp only [step,hv,Option.some.injEq] at he; subst t; simp
    | add p q =>
      cases bits with
      | nil => simp [step,hv] at he
      | cons b bits =>
        cases b <;> simp only [step,hv,Bool.false_eq_true,↓reduceIte,Option.some.injEq] at he <;>
          subst t <;> simp
    | mul p q => simp only [step,hv,Option.some.injEq] at he; subst t; simp

theorem run_lengths (C : Circuit σ) (n : ℕ) (s t : State)
    (he : run C n (some s) = some t) :
    t.pending.length ≤ s.pending.length + n ∧
    t.factors.length ≤ s.factors.length + n ∧ t.bits.length ≤ s.bits.length := by
  induction n generalizing s with
  | zero => simp only [run,Option.some.injEq] at he; subst t; simp
  | succ n ih =>
    cases hstep : step C s with
    | none =>
      have hnone : ∀ n, run C n none = none := by
        intro n; induction n with
        | zero => rfl
        | succ n ih => simpa [run] using ih
      simp only [run,Option.bind_some,hstep,hnone] at he
      contradiction
    | some u =>
      have hstep' := step_lengths C s u hstep
      have hu : run C n (some u) = some t := by simpa [run,hstep] using he
      have hh := ih u hu
      omega

theorem run_input_lower (C : Circuit σ) (n : ℕ) (s t : State)
    (he : run C n (some s) = some t) : s.bits.length ≤ t.bits.length + n := by
  induction n generalizing s with
  | zero => simp only [run,Option.some.injEq] at he; subst t; simp
  | succ n ih =>
    cases hstep : step C s with
    | none =>
      have hnone : ∀ n, run C n none = none := by
        intro n; induction n with
        | zero => rfl
        | succ n ih => simpa [run] using ih
      simp only [run,Option.bind_some,hstep,hnone] at he
      contradiction
    | some u =>
      have hstep' := step_input_lower C s u hstep
      have hu : run C n (some u) = some t := by simpa [run,hstep] using he
      have hh := ih u hu
      omega

theorem run_bounded (C : Circuit σ) (D n : ℕ) (s t : State)
    (hs : s.bounded C.nodes.length D) (he : run C n (some s) = some t) :
    t.bounded C.nodes.length D := by
  induction n generalizing s with
  | zero => simp only [run,Option.some.injEq] at he; subst t; exact hs
  | succ n ih =>
    cases hstep : step C s with
    | none =>
      have hnone : ∀ n, run C n none = none := by
        intro n; induction n with
        | zero => rfl
        | succ n ih => simpa [run] using ih
      simp only [run,Option.bind_some,hstep,hnone] at he
      contradiction
    | some u =>
      apply ih u (step_bounded C D s u hs hstep)
      simpa [run,hstep] using he

private theorem getD_last {α : Type} (l : List α) (d : α) :
    l.getD (l.length - 1) d = l.getLastD d := by
  simp only [List.getD_eq_getElem?_getD, List.getLastD_eq_getLast?,
    List.getLast?_eq_getElem?]

theorem sourceFormula_output (C : Circuit σ) :
    sourceFormula C (C.nodes.length - 1) = CircuitFormulaUnfold.circuitFormula C := by
  unfold sourceFormula CircuitFormulaUnfold.circuitFormula
  rw [← CircuitFormulaRecurrence.formulaValues_length C, getD_last]

def initial (C : Circuit σ) (d : ℕ) (bits : List Bool) : State :=
  ⟨[.root (C.nodes.length - 1) (d+1)],bits,[]⟩

theorem initial_forget (C : Circuit σ) (d : ℕ) (bits : List Bool) :
    forget C (initial C d bits) = AddressFactorMachine.initial C d bits := by
  simp [initial,forget,interpret,sourceFormula_output,AddressFactorMachine.initial]

theorem initial_bounded (C : Circuit σ) (d : ℕ) (bits : List Bool) :
    (initial C d bits).bounded C.nodes.length (d+1) := by
  have h : 0 < C.nodes.length := List.length_pos_iff.mpr C.nonempty
  simp [initial,State.bounded,Tag.bounded]
  omega

/-- The index-and-counter machine halts for every fixed-length input and
    records symbolic leaves whose interpreted product is the decoder weight.
    Polynomial bit-width and a local Boolean circuit for `step` remain to be
    established. -/
theorem boundedCircuit_indexed_run [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d)
    (z : Fin (2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)) → Bool) :
    let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
    ∃ s, run C N (some (initial C d (List.ofFn z))) = some s ∧
      s.pending = [] ∧ s.factors.length ≤ N ∧
      CircuitFixedCodes.decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula C d) N z =
        if s.bits = List.replicate s.bits.length false then
          (s.factors.map (fun l => (leafFormula C l).value)).prod else 0 := by
  dsimp only
  let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
  obtain ⟨t,ht,hpend,hsize,_,hweight⟩ := AddressFactorMachine.boundedCircuit_address_run C d hdegree z
  have hsim := run_forget C N (some (initial C d (List.ofFn z)))
  rw [show (some (initial C d (List.ofFn z))).map (forget C) =
      some (AddressFactorMachine.initial C d (List.ofFn z)) by
        change some (forget C (initial C d (List.ofFn z))) = _
        rw [initial_forget], ht] at hsim
  cases hr : run C N (some (initial C d (List.ofFn z))) with
  | none =>
    simp only [hr,Option.map_none] at hsim
    cases hsim
  | some s =>
    have he : forget C s = t := by simpa only [hr,Option.map_some,Option.some.injEq] using hsim
    subst t
    have hp : s.pending = [] := by
      have hmap : s.pending.map (interpret C) = [] := hpend
      cases heq : s.pending with
      | nil => rfl
      | cons a rest => simp [heq] at hmap
    refine ⟨s,rfl,hp,?_,?_⟩
    · simpa [forget] using hsize
    · simpa [forget,List.map_map,Function.comp_def] using hweight

/-- The finished indexed run uses only source-node indices and degree
    counters in the ranges needed for a finite encoding. -/
theorem boundedCircuit_indexed_run_bounded [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d)
    (z : Fin (2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)) → Bool) :
    let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
    ∃ s, run C N (some (initial C d (List.ofFn z))) = some s ∧
      s.bounded C.nodes.length (d+1) ∧ s.pending = [] ∧ s.factors.length ≤ N ∧
      CircuitFixedCodes.decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula C d) N z =
        if s.bits = List.replicate s.bits.length false then
          (s.factors.map (fun l => (leafFormula C l).value)).prod else 0 := by
  dsimp only
  obtain ⟨s,hr,hpending,hsize,hweight⟩ := boundedCircuit_indexed_run C d hdegree z
  exact ⟨s,hr,run_bounded C (d+1) _ _ s (initial_bounded C d (List.ofFn z)) hr,
    hpending,hsize,hweight⟩


end IndexedFactorMachine

-- From Solutions.IndexedPlan

/-! One decoder step splits into a bounded control plan and simple list
    shifts. This isolates the part that depends on the top tag. -/

namespace IndexedPlan

open ResultantVNP IndexedNormalizedAddresses IndexedFactorMachine

variable {σ : Type}

structure Plan where
  push : List Tag
  consume : Bool
  factor : Option Leaf

noncomputable def plan (C : Circuit σ) (a : Tag) (bit : Bool) : Plan :=
  match IndexedNormalizedAddresses.view C a with
  | .zero => ⟨[],false,some .zero⟩
  | .variable i => ⟨[],false,some (.variable i)⟩
  | .constantPart i => ⟨[],false,some (.constantPart i)⟩
  | .add p q => ⟨[if bit then q else p],true,none⟩
  | .mul p q => ⟨[p,q],false,none⟩

def Plan.bounded (m D : ℕ) (p : Plan) : Prop :=
  p.push.length ≤ 2 ∧ (∀ a ∈ p.push, a.bounded m D) ∧
    ∀ l ∈ p.factor.toList, l.bounded m

theorem plan_bounded (C : Circuit σ) (D : ℕ) (a : Tag)
    (ha : a.bounded C.nodes.length D) (bit : Bool) :
    (plan C a bit).bounded C.nodes.length D := by
  have hv := view_bounded C D a ha
  cases hview : IndexedNormalizedAddresses.view C a with
  | zero => simp [plan,hview,Plan.bounded,Leaf.bounded]
  | «variable» i => simpa [plan,hview,Plan.bounded,Leaf.bounded,View.bounded] using hv
  | constantPart i => simpa [plan,hview,Plan.bounded,Leaf.bounded,View.bounded] using hv
  | add p q =>
    simp only [hview,View.bounded] at hv
    cases bit <;> simp [plan,hview,Plan.bounded,hv.1,hv.2]
  | mul p q =>
    simp only [hview,View.bounded] at hv
    simp [plan,hview,Plan.bounded,hv.1,hv.2]

/-- Given a nonempty input stream, the plan specifies exactly the same
    update as the indexed decoder step. -/
theorem step_as_plan (C : Circuit σ) (a : Tag) (rest : List Tag) (bit : Bool)
    (bits : List Bool) (factors : List Leaf) :
    step C ⟨a :: rest,bit :: bits,factors⟩ =
      some ⟨(plan C a bit).push ++ rest,
        if (plan C a bit).consume then bits else bit :: bits,
        (plan C a bit).factor.toList ++ factors⟩ := by
  cases hview : IndexedNormalizedAddresses.view C a <;> cases bit <;>
    simp [step,plan,hview]

def execute (p : Plan) (rest : List Tag) (bits : List Bool) (factors : List Leaf) : Option State :=
  if p.consume then
    match bits with
    | [] => none
    | _ :: tail => some ⟨p.push ++ rest,tail,p.factor.toList ++ factors⟩
  else some ⟨p.push ++ rest,bits,p.factor.toList ++ factors⟩

/-- The plan also specifies failure when an addition requests a missing bit. -/
theorem step_as_plan_general (C : Circuit σ) (a : Tag) (rest : List Tag)
    (bits : List Bool) (factors : List Leaf) :
    step C ⟨a :: rest,bits,factors⟩ = execute (plan C a (bits.headD false)) rest bits factors := by
  cases bits with
  | nil => cases hv : IndexedNormalizedAddresses.view C a <;> simp [step,plan,execute,hv]
  | cons bit bits =>
    rw [step_as_plan]
    cases h : (plan C a bit).consume <;> simp [execute,h]


end IndexedPlan

