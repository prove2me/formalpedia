/-- The sum of a gate row, list form. -/
theorem gate_sum (g : NGate (Fin W) (ZMod 2) M) (w : Fin W) (Z : ℕ → List (ZMod 2))
    (i : ℕ) :
    ((((List.finRange W).filter (fun w' => w' ∈ g.2.1 ∧ g.1 w w' = 1)).map Fin.val).map
      fun n => (Z n).getD i 0).sum =
      ∑ w' ∈ g.2.1, g.1 w w' • (Z w').getD i 0 := by
  rw [List.map_map]
  rw [← List.sum_toFinset _ ((List.nodup_finRange W).filter _)]
  have e : ((List.finRange W).filter (fun w' => w' ∈ g.2.1 ∧ g.1 w w' = 1)).toFinset =
      g.2.1.filter (fun w' => g.1 w w' = 1) := by
    ext x; simp
  rw [e, Finset.sum_filter]
  refine Finset.sum_congr rfl fun w' _ => ?_
  have : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by decide
  rcases this (g.1 w w') with h | h <;> simp [h]

/-- **One gate.** -/
theorem gateC_runs (Φ : M → List (ZMod 2) → List (ZMod 2)) (Pr : M → Prop)
    (hΦl : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → (Φ X ys).length = v)
    (hE : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → ∀ (t : IState HS) (R : List Item),
      IRuns I iprog (E X) (t.upd 0 (ints (enc2 ys) ++ R)) (t.upd 0 (ints (enc2 (Φ X ys)) ++ R))
        (cE X))
    (s : IState HS) (rest : List ℤ) {Bb : ℕ} (hB : TabB W v Bb)
    (lab : Fin W → M) (Y : Fin W → Fin v → ZMod 2) (g : NGate (Fin W) (ZMod 2) M)
    (hPr : ∀ w ∈ g.2.1, Pr (g.2.2 - lab w))
    (f : Fin HS → List ℤ) (hf : f 0 = tabR 0 W (tabOf Y) ++ rest) (hf21 : f 21 = []) :
    IRuns I iprog (gateC E v lab g) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 0
        (tabR 0 W (tabOf (physStepF (funΦ v Φ) (lab, Y) g).2) ++ rest)))
      (((touchL g.2.1).map fun (w : Fin W) => cE (g.2.2 - lab w) + 2 * cOp (W * v) Bb).sum + 1 +
        cRebuild W (W * v) Bb) := by
  set S := g.2.1
  -- the streams after the frame changes
  set Z : ℕ → List (ZMod 2) := fun n => if h : n < W then
    (if (⟨n, h⟩ : Fin W) ∈ S then Φ (g.2.2 - lab ⟨n, h⟩) (List.ofFn (Y ⟨n, h⟩))
      else List.ofFn (Y ⟨n, h⟩)) else [] with hZ
  have h1 := frames_runs (I := I) (iprog := iprog) s rest hB
    (fun w => E (g.2.2 - lab w)) (fun w => cE (g.2.2 - lab w))
    (fun w => enc2 (Φ (g.2.2 - lab w) (List.ofFn (Y w)))) (touchL S) (tabOf Y) f (touchL_nodup S)
    (uni_tabOf Y)
    (fun w hw => ⟨by rw [length_enc2, hΦl _ (hPr w (mem_touchL.1 hw)) _ (by simp)],
      NLogN.KIL.bits_enc2 _⟩)
    (fun w hw t R => by
      have := hE _ (hPr w (mem_touchL.1 hw)) (List.ofFn (Y w)) (by simp) t R
      simpa [tabOf, liftF] using this) hf
  have eZ : (fun n => if h : n < W then (if (⟨n, h⟩ : Fin W) ∈ touchL S then
      enc2 (Φ (g.2.2 - lab ⟨n, h⟩) (List.ofFn (Y ⟨n, h⟩))) else tabOf Y n) else tabOf Y n) =
      fun n => enc2 (Z n) := by
    funext n
    by_cases hn : n < W
    · simp only [dif_pos hn, mem_touchL, hZ, tabOf, liftF]
      split_ifs <;> rfl
    · simp [hn, hZ, tabOf, liftF, enc2]
  rw [eZ] at h1
  have hUZ : Uni W v fun n => enc2 (Z n) := by
    intro n hn
    refine ⟨?_, NLogN.KIL.bits_enc2 _⟩
    simp only [hZ, dif_pos hn, length_enc2]
    split_ifs with hS
    · exact hΦl _ (hPr _ hS) _ (by simp)
    · simp
  have h2 := rebuildC_sp hUZ s (Function.update f 0 (tabR 0 W (fun n => enc2 (Z n)) ++ rest)) rest
    (by simp) (by simp [hf21]) hB (srcOK g)
  have H := h1.seq h2.toIRuns
  refine H.mono' ?_ le_rfl
  rw [Function.update_idem]
  congr 3
  apply tabR_congr
  intro n _ hn
  simp only [Nat.zero_add] at hn
  rw [sumS_enc2]
  simp only [tabOf, liftF, dif_pos hn]
  congr 1
  -- the summed stream
  have hZl : ∀ n', n' < W → (Z n').length = v := fun n' hn' => by
    have := (hUZ n' hn').1; simpa using this
  have hsrc := (srcOK g n hn).1
  apply List.ext_getElem
  · rw [length_sumZ Z _ _ (fun w hw => by rw [List.length_replicate]; exact hZl w (hsrc w hw))]
    simp
  intro i h1 h2
  have hi : i < v := by simpa using h2
  rw [← List.getD_eq_getElem _ (0 : ZMod 2) h1,
    getD_sumZ Z i _ _ (fun w hw => by rw [List.length_replicate]; exact hZl w (hsrc w hw))
      (by simpa using hi)]
  simp only [List.getElem_ofFn, physStepF]
  rw [List.getD_eq_getElem _ _ (by simpa using hi), List.getElem_replicate, zero_add]
  by_cases hS : (⟨n, hn⟩ : Fin W) ∈ S
  · have hS' : (⟨n, hn⟩ : Fin W) ∈ g.2.1 := hS
    simp only [srcT, dif_pos hn, if_pos hS']
    rw [gate_sum g ⟨n, hn⟩ Z i, Finset.sum_apply]
    refine Finset.sum_congr rfl fun w' hw' => ?_
    have hw'' : w' ∈ S := hw'
    simp only [Pi.smul_apply, hZ, dif_pos w'.2, Fin.eta, if_pos hw'', funΦ]
  · have hS' : (⟨n, hn⟩ : Fin W) ∉ g.2.1 := hS
    simp only [srcT, dif_pos hn, if_neg hS', List.map_cons, List.map_nil, List.sum_cons,
      List.sum_nil, add_zero]
    simp only [hZ, dif_pos hn, if_neg hS]
    rw [List.getD_eq_getElem _ _ (by simpa using hi), List.getElem_ofFn]

omit [AddGroup M] in
theorem netRunF_cons {R : Type*} [CommRing R] (Φ : M → (Fin v → R) → (Fin v → R)) [AddGroup M]
    (g : NGate (Fin W) R M) (gs : List (NGate (Fin W) R M)) (lab Mout : Fin W → M)
    (Y : Fin W → Fin v → R) :
    netRunF Φ (g :: gs) lab Mout Y = netRunF Φ gs (labStep lab g) Mout (physStepF Φ (lab, Y) g).2 :=
  rfl

/-- **The network on one stack.** -/
theorem netC_runs (Φ : M → List (ZMod 2) → List (ZMod 2)) (Pr : M → Prop)
    (hΦl : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → (Φ X ys).length = v)
    (hE : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → ∀ (t : IState HS) (R : List Item),
      IRuns I iprog (E X) (t.upd 0 (ints (enc2 ys) ++ R)) (t.upd 0 (ints (enc2 (Φ X ys)) ++ R))
        (cE X))
    (s : IState HS) (rest : List ℤ) {Bb : ℕ} (hB : TabB W v Bb) (Mout : Fin W → M) :
    ∀ (gates : List (NGate (Fin W) (ZMod 2) M)) (lab : Fin W → M) (Y : Fin W → Fin v → ZMod 2)
      (f : Fin HS → List ℤ), FramesOK Pr gates lab Mout →
      f 0 = tabR 0 W (tabOf Y) ++ rest → f 21 = [] →
      IRuns I iprog (netC E v Mout lab gates) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0
          (tabR 0 W (tabOf (netRunF (funΦ v Φ) gates lab Mout Y)) ++ rest)))
        (netCI cE (W * v) Bb Mout lab gates)
  | [], lab, Y, f, hF, hf, _ => by
    have h1 := frames_runs (I := I) (iprog := iprog) s rest hB
      (fun w => E (Mout w - lab w)) (fun w => cE (Mout w - lab w))
      (fun w => enc2 (Φ (Mout w - lab w) (List.ofFn (Y w)))) (List.finRange W) (tabOf Y) f
      (List.nodup_finRange W) (uni_tabOf Y)
      (fun w _ => ⟨by rw [length_enc2, hΦl _ (hF w) _ (by simp)], NLogN.KIL.bits_enc2 _⟩)
      (fun w _ t R => by
        have := hE _ (hF w) (List.ofFn (Y w)) (by simp) t R
        simpa [tabOf, liftF] using this) hf
    refine h1.mono' ?_ le_rfl
    congr 3
    apply tabR_congr
    intro n _ hn
    simp only [Nat.zero_add] at hn
    simp only [dif_pos hn, List.mem_finRange, if_true, tabOf, liftF, netRunF, List.foldl_nil]
    rw [ofFn_funΦ _ _ _ (hΦl _ (hF _) _ (by simp))]
  | g :: gs, lab, Y, f, hF, hf, hf21 => by
    have h1 := gateC_runs (E := E) (cE := cE) (I := I) (iprog := iprog) Φ Pr hΦl hE s rest hB lab Y
      g hF.1 f hf hf21
    have h2 := netC_runs Φ Pr hΦl hE s rest hB Mout gs (labStep lab g)
      (physStepF (funΦ v Φ) (lab, Y) g).2
      (Function.update f 0 (tabR 0 W (tabOf (physStepF (funΦ v Φ) (lab, Y) g).2) ++ rest)) hF.2
      (by simp) (by simp [hf21])
    have H := h1.seq h2
    refine H.mono' ?_ le_rfl
    rw [Function.update_idem, netRunF_cons]

/-- The network cost as a frame sum. -/
theorem netCI_eq (V Bb : ℕ) (Mout : Fin W → M) :
    ∀ (gates : List (NGate (Fin W) (ZMod 2) M)) (lab : Fin W → M),
      netCI cE V Bb Mout lab gates =
        frameSum (fun X => cE X + 2 * cOp V Bb) gates lab Mout +
          gates.length * (cRebuild W V Bb + 1) + 1
  | [], lab => by simp [netCI, frameSum, sum_finRange, Finset.sum_add_distrib]
  | g :: gs, lab => by
    simp only [netCI, frameSum, netCI_eq V Bb Mout gs, sum_touchL, List.length_cons]
    ring

end Net

