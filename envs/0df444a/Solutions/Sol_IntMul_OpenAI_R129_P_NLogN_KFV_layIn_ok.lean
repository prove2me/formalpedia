    applyN (genOps (NLogN.KFV.pre2 D ℓ K long u).length 0 (xs2 D ℓ K u)) (NLogN.KFV.pre2 D ℓ K long u ++ arr2 D ℓ K u) =
      NLogN.KFV.pre2 D ℓ K long (u + 1) ++ arr2 D ℓ K (u + 1) := by
  have H := applyN_gen (xs2 D ℓ K u) (NLogN.KFV.pre2 D ℓ K long u) [] []
  simp only [List.length_nil, List.nil_append, List.append_nil] at H
  have e1 : (xs2 D ℓ K u).flatMap trip = arr2 D ℓ K u := by
    unfold xs2 arr2; rw [List.flatMap_map]
    apply List.flatMap_congr; intro i _
    rw [loS_succ D ℓ K hu i]; simp [trip]
  rw [e1] at H
