    have h1 := NLogN.KFM.pow_mono_A hA (le_max_left (NLogN.KFM.exDg a) (NLogN.KFM.exDg b))
    have h2 := NLogN.KFM.pow_mono_A hA (le_max_right (NLogN.KFM.exDg a) (NLogN.KFM.exDg b))
    have hA' : (2 : ℤ) ≤ A := by exact_mod_cast hA
    have hp : (0 : ℤ) ≤ (A : ℤ) ^ max (NLogN.KFM.exDg a) (NLogN.KFM.exDg b) := by positivity
    simp only [NLogN.KFM.exDg, NLogN.Ex.eval, pow_succ]
    calc |a.eval s + b.eval s| ≤ |a.eval s| + |b.eval s| := abs_add_le _ _
      _ ≤ _ := by nlinarith
  | .neg a, h => by simpa [NLogN.KFM.exDg, NLogN.Ex.eval, abs_neg] using exSm_abs_aux A s hA a h
  | .mul a b, h => by
    simp only [NLogN.KFM.exDg, NLogN.Ex.eval, pow_add, abs_mul]
    exact mul_le_mul (exSm_abs_aux A s hA a h.1) (exSm_abs_aux A s hA b h.2) (abs_nonneg _)
      (by positivity)
  | .ndiv a b, h => by
    simp only [NLogN.KFM.exDg, NLogN.Ex.eval]
    calc |a.eval s / b.eval s| ≤ |a.eval s| := Int.abs_ediv_le_abs _ _
      _ ≤ _ := le_trans (exSm_abs_aux A s hA a h.1) (NLogN.KFM.pow_mono_A hA (le_max_left _ _))
  | .nmod a b, h => by
