/-- The compact least nonzero coordinate is the one used by the published formula. -/
theorem lowDegreePivot_eq_linePivotIndex {K : Type} [Field K] [DecidableEq K]
    {m : ℕ} (v : Fin m → K) (hv : v ≠ 0) :
    _root_.MIPStarRE.QPBT.Palomar.lowDegreePivot v hv = _root_.MIPStarRE.QPBT.linePivotIndex v hv := by
  have hpivot_ne : v (_root_.MIPStarRE.QPBT.Palomar.lowDegreePivot v hv) ≠ 0 := by
    unfold _root_.MIPStarRE.QPBT.Palomar.lowDegreePivot
    change v ((Finset.univ.filter fun j : Fin m => v j ≠ 0).min' _) ≠ 0
    exact (Finset.mem_filter.mp (Finset.min'_mem
      (Finset.univ.filter fun j : Fin m => v j ≠ 0) _)).2
  have hpivot_le (i : Fin m) (hi : v i ≠ 0) : _root_.MIPStarRE.QPBT.Palomar.lowDegreePivot v hv ≤ i := by
    unfold _root_.MIPStarRE.QPBT.Palomar.lowDegreePivot
    change (Finset.univ.filter fun j : Fin m => v j ≠ 0).min' _ ≤ i
    exact Finset.min'_le _ i (by simp [hi])
  apply le_antisymm
  · exact hpivot_le _ (_root_.MIPStarRE.QPBT.linePivotIndex_ne_zero v hv)
  · apply le_of_not_gt
    intro hlt
    exact hpivot_ne (_root_.MIPStarRE.QPBT.linePivotIndex_zero_before v hv _ hlt)

/-- The compact elementary representative is exactly the canonical representative. -/
theorem lowDegreeLineRep_eq_lineRepMap {K : Type} [Field K] [DecidableEq K]
    {m : ℕ} (u v : Fin m → K) :
    _root_.MIPStarRE.QPBT.Palomar.lowDegreeLineRep u v = _root_.MIPStarRE.QPBT.lineRepMap v u := by
  rw [_root_.MIPStarRE.QPBT.lineRepMap_apply_eq_explicitLineRep]
  simp only [_root_.MIPStarRE.QPBT.Palomar.lowDegreeLineRep, _root_.MIPStarRE.QPBT.explicitLineRep]
  split_ifs with hv
  · rfl
  · rw [_root_.MIPStarRE.QPBT.Palomar.lowDegreePivot_eq_linePivotIndex v hv]

/-- The compact point map agrees with the original point map. -/
theorem lowDegreeMap_point_equiv (P : _root_.MIPStarRE.QPBT.LdParams)
    (z : _root_.MIPStarRE.QPBT.Palomar.LowDegreeSpace (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams P) (_root_.MIPStarRE.QPBT.ScalarQ P)) :
    _root_.MIPStarRE.QPBT.Palomar.lowDegreeSpaceEquiv P
        (_root_.MIPStarRE.QPBT.Palomar.lowDegreeMap (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams P)
          (_root_.MIPStarRE.QPBT.binaryRepresentation P.model)
          .point z) =
      _root_.MIPStarRE.QPBT.ldPointCL P (_root_.MIPStarRE.QPBT.Palomar.lowDegreeSpaceEquiv P z) := by
  rfl

/-- The compact axis-line map agrees with the original axis-line map. -/
theorem lowDegreeMap_aline_equiv (P : _root_.MIPStarRE.QPBT.LdParams)
    (z : _root_.MIPStarRE.QPBT.Palomar.LowDegreeSpace (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams P) (_root_.MIPStarRE.QPBT.ScalarQ P)) :
    _root_.MIPStarRE.QPBT.Palomar.lowDegreeSpaceEquiv P
        (_root_.MIPStarRE.QPBT.Palomar.lowDegreeMap (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams P)
          (_root_.MIPStarRE.QPBT.binaryRepresentation P.model)
          .aline z) =
      _root_.MIPStarRE.QPBT.ldALineCL P (_root_.MIPStarRE.QPBT.Palomar.lowDegreeSpaceEquiv P z) := by
  funext i
  rcases i with (j | u) | j
  · change _root_.MIPStarRE.QPBT.Palomar.lowDegreeLineRep z.1.1
        (Pi.single (_root_.MIPStarRE.QPBT.chiIndex P z.1.2) 1) j =
      _root_.MIPStarRE.QPBT.lineRepMap
        (_root_.MIPStarRE.QPBT.coordinateDirection (_root_.MIPStarRE.QPBT.chiIndex P z.1.2))
        z.1.1 j
    rw [_root_.MIPStarRE.QPBT.Palomar.lowDegreeLineRep_eq_lineRepMap]
    rfl
  · cases u
    rfl
  · rfl

/-- The compact diagonal-line map agrees with the original diagonal-line map. -/
theorem lowDegreeMap_dline_equiv (P : _root_.MIPStarRE.QPBT.LdParams)
    (z : _root_.MIPStarRE.QPBT.Palomar.LowDegreeSpace (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams P) (_root_.MIPStarRE.QPBT.ScalarQ P)) :
    _root_.MIPStarRE.QPBT.Palomar.lowDegreeSpaceEquiv P
        (_root_.MIPStarRE.QPBT.Palomar.lowDegreeMap (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams P)
          (_root_.MIPStarRE.QPBT.binaryRepresentation P.model)
          .dline z) =
      _root_.MIPStarRE.QPBT.ldDLineCL P (_root_.MIPStarRE.QPBT.Palomar.lowDegreeSpaceEquiv P z) := by
  funext i
  rcases i with (j | u) | j
  · change _root_.MIPStarRE.QPBT.Palomar.lowDegreeLineRep z.1.1
        (_root_.MIPStarRE.QPBT.prefixProjection
          (_root_.MIPStarRE.QPBT.chiIndex P z.1.2) z.2) j =
      _root_.MIPStarRE.QPBT.lineRepMap
        (_root_.MIPStarRE.QPBT.prefixProjection
          (_root_.MIPStarRE.QPBT.chiIndex P z.1.2) z.2) z.1.1 j
    rw [_root_.MIPStarRE.QPBT.Palomar.lowDegreeLineRep_eq_lineRepMap]
  · cases u
    rfl
  · rfl

/-- All three compact question maps commute with the coordinate equivalence. -/
theorem lowDegreeMap_equiv (P : _root_.MIPStarRE.QPBT.LdParams)
    (t : _root_.MIPStarRE.QPBT.Palomar.LowDegreeType)
    (z : _root_.MIPStarRE.QPBT.Palomar.LowDegreeSpace (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams P) (_root_.MIPStarRE.QPBT.ScalarQ P)) :
    _root_.MIPStarRE.QPBT.Palomar.lowDegreeSpaceEquiv P
        (_root_.MIPStarRE.QPBT.Palomar.lowDegreeMap (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams P)
          (_root_.MIPStarRE.QPBT.binaryRepresentation P.model) t z) =
      _root_.MIPStarRE.QPBT.ldCL P (_root_.MIPStarRE.QPBT.Palomar.lowDegreeTypeEquiv t) (_root_.MIPStarRE.QPBT.Palomar.lowDegreeSpaceEquiv P z) := by
  cases t with
  | point => exact _root_.MIPStarRE.QPBT.Palomar.lowDegreeMap_point_equiv P z
  | aline => exact _root_.MIPStarRE.QPBT.Palomar.lowDegreeMap_aline_equiv P z
  | dline => exact _root_.MIPStarRE.QPBT.Palomar.lowDegreeMap_dline_equiv P z



