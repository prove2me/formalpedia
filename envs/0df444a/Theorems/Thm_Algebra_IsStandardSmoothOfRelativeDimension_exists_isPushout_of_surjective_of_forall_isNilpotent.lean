-- title:
--   Lifting standard smooth algebras along a surjection with nil kernel
-- statement:
--   Fix $n \in \mathbb{N}$ and commutative rings $R$, $R_0$ in a single universe, with $R_0$ an $R$-algebra. Assume the structure map $R \to R_0$ is surjective and that every element of its kernel is nilpotent. Let $A_0$ be a commutative ring carrying an $R_0$-algebra structure and an $R$-algebra structure compatible with it (a scalar tower $R \to R_0 \to A_0$), and assume $A_0$ is standard smooth of relative dimension $n$ over $R_0$ in Mathlib's sense, i.e. it admits a submersive presentation over $R_0$ of relative dimension $n$. Then there exist a commutative ring $A$ in the same universe, an $R$-algebra structure on $A$, an $A$-algebra structure on $A_0$ making $R \to A \to A_0$ a scalar tower, such that: $A$ is standard smooth of relative dimension $n$ over $R$; the structure map $A \to A_0$ is surjective; its kernel is exactly the ideal of $A$ generated by the image of $\ker(R \to R_0)$, that is $\mathrm{Ident}$-free, $\ker(A \to A_0) = (\ker(R \to R_0))A$; and the square $R \to R_0$, $A \to A_0$ is a pushout, `Algebra.IsPushout R R₀ A A₀`, so that the canonical map $R_0 \otimes_R A \to A_0$ is an isomorphism.
--
--   This is the affine, standard smooth form of the infinitesimal lifting of smooth algebras along a surjection with nilpotent kernel: every standard smooth $R_0$-algebra of relative dimension $n$ is the base change of one over $R$. It is used to prove the corresponding statement for smooth morphisms of schemes, where each point of the source has an affine open neighbourhood admitting such a smooth lift with the resulting square a pullback.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_Algebra_IsStandardSmoothOfRelativeDimension_exists_isPushout_of_surjective_of_forall_isNilpotent.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

theorem Algebra.IsStandardSmoothOfRelativeDimension.exists_isPushout_of_surjective_of_forall_isNilpotent
    (n : ℕ) {R R₀ : Type u} [CommRing R] [CommRing R₀] [Algebra R R₀]
    (hf : Function.Surjective (algebraMap R R₀))
    (hnil : ∀ x ∈ RingHom.ker (algebraMap R R₀), IsNilpotent x)
    (A₀ : Type u) [CommRing A₀] [Algebra R₀ A₀] [Algebra R A₀] [IsScalarTower R R₀ A₀]
    [Algebra.IsStandardSmoothOfRelativeDimension n R₀ A₀] :
    ∃ (A : Type u) (_ : CommRing A) (_ : Algebra R A) (_ : Algebra A A₀) (_ : IsScalarTower R A A₀),
      Algebra.IsStandardSmoothOfRelativeDimension n R A ∧
      Function.Surjective (algebraMap A A₀) ∧
      RingHom.ker (algebraMap A A₀) = Ideal.map (algebraMap R A) (RingHom.ker (algebraMap R R₀)) ∧
      Algebra.IsPushout R R₀ A A₀ := by sorry
