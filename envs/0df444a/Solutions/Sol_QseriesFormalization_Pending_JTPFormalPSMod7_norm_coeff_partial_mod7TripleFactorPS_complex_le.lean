  | succ N ih =>
      intro k
      rw [Finset.prod_range_succ]
      calc
        ‖((∏ n ∈ Finset.range N, mod7TripleFactorPS a b ℂ n) *
            mod7TripleFactorPS a b ℂ N).coeff k‖
            ≤ 8 * (8 : ℝ) ^ N :=
          norm_coeff_mul_mod7TripleFactorPS_complex_le a b
            (∏ n ∈ Finset.range N, mod7TripleFactorPS a b ℂ n)
            ((8 : ℝ) ^ N) (by positivity) (fun j => ih j) k N
        _ = (8 : ℝ) ^ (N + 1) := by
          rw [pow_succ]
          ring
