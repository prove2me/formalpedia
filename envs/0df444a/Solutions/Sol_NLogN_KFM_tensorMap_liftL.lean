open IntMul.OpenAI.RT IntMul.HvdH
variable {d : ℕ}
theorem solution {a b : Fin d → ℕ} [∀ i, NeZero (a i)] [∀ i, NeZero (b i)]
    (L : (i : Fin d) → (ZMod (a i) → ℂ) →L[ℂ] (ZMod (b i) → ℂ))
    (x : (Fin d → ℕ) → ℂ) (j : Fin d → ℕ) :
    IntMul.HvdH.tensorMap (fun i => NLogN.KFM.liftL (L i)) x j =
      IntMul.OpenAI.RT.tens (NLogN.KFM.kerL L) (fun k => x (fun i => (k i).val)) (fun i => ((j i : ℕ) : ZMod (b i))) := by
  set K : Fin d → ℕ → ℕ → ℂ := fun i m n => L i (Pi.single (n : ZMod (a i)) 1) (m : ZMod (b i))
  have h := NLogN.KFM.sliceComp_sum a K (fun i => NLogN.KFM.liftL (L i)) (fun i x m => NLogN.KFM.liftL_sum (L i) x m)
    (List.finRange d) (List.nodup_finRange d) x j
  unfold IntMul.HvdH.tensorMap
  rw [h]
  have hb : NLogN.KFM.boxF a (List.finRange d) j = Fintype.piFinset fun i => range (a i) := by
    simp [NLogN.KFM.boxF]
  rw [hb, List.toFinset_finRange]
  unfold IntMul.OpenAI.RT.tens
  symm
  refine Finset.sum_nbij' (fun k i => (k i).val) (fun m i => (m i : ZMod (a i))) ?_ ?_ ?_ ?_ ?_
  · intro k _; simp [Fintype.mem_piFinset, ZMod.val_lt]
  · intro m _; simp
  · intro k _; funext i; simp
  · intro m hm
    simp only [Fintype.mem_piFinset, mem_range] at hm
    funext i; simp [ZMod.val_cast_of_lt (hm i)]
  · intro k _
    simp only [NLogN.KFM.kerL, K, ZMod.natCast_zmod_val]
end
