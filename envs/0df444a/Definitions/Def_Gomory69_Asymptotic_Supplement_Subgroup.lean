-- title:
--   The subgroup generated after deleting a coordinate
-- statement:
--   Let $G$ be an Abelian group, $N\subset G$ a finite coordinate set and $h\in N$. Define
--   $$K_{N-h}=\langle N\setminus\{h\}\rangle.$$
--   This is the additive subgroup generated by the remaining coordinates. The least positive coset index is specified by existence and minimality in Theorem 9, rather than assigned a default value when the coset does not exist.
--
--   This subgroup expresses exactly when a coordinate can vanish on a group solution.
-- source:
--   Gomory, Some polyhedra related to combinatorial problems, Linear Algebra Appl. 2 (1969), DOI 10.1016/0024-3795(69)90017-2, pp. 471–472, THEOREM 9

import Mathlib

namespace Gomory69.Asymptotic.Supplement

/-- The subgroup generated by all coordinates other than `h` (p. 471). -/
def deletedSubgroup {G : Type*} [AddCommGroup G] [DecidableEq G]
    (N : Finset G) (h : N) : AddSubgroup G :=
  AddSubgroup.closure (↑(N.erase (h : G)) : Set G)

end Gomory69.Asymptotic.Supplement


