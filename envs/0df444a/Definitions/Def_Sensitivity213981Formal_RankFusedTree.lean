def Tree.fusedCheck (mask : Array Bool) (q : ℕ) (pre : ℕ → PreparedValues)
    (values : CostValues) (bound : ℕ) (t : Tree) : Bool :=
  if blocked mask t.mask then true else
    match t with
    | .leaf _ key code => fusedCodePreparedCheck q (pre key) values bound code
    | .branch _ _ left right => left.fusedCheck mask q pre values bound &&
        right.fusedCheck mask q pre values bound







end ThreeBoundRankAnnotated


