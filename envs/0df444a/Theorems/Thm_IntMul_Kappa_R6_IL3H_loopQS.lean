theorem IntMul.Kappa.R6.IL3H.loopQS {sz : ℕ} {j : Fin Pp} {cond : NE} {step : List (Fin HS × NE)} {cont : IStmt HS Pp}
    (hj : tbl j = testC 16 cond (withPushI (fr step) (.call j)) cont)
    (Inv : ℕ → (Fin HS → Option ℤ) → Prop) {Mb Bz : ℕ} (hMb : zsz (Mb : ℤ) ≤ Bz)
    (hcR : cond.RegsLt) (hcS : cond.size ≤ sz) (hsN : NoRdN [] step) (hs0 : ∀ x ∈ step, x.1 ≠ 0)
    {f g : Fin HS → List ℤ} (hf : Clean0 f) (hg : Clean0 g) {cc : ℕ}
    (hbase : ∀ σ, Inv 0 σ → σ 0 = none ∧ NatR σ cond ∧ cond.OK (vOf σ) Mb ∧
      cond.val (vOf σ) ≠ 0 ∧
      RunQ Isym tbl (σPush σ [((16 : Fin HS), ((cond.val (vOf σ) : ℕ) : ℤ))]) cont f g cc)
    (hstep : ∀ n σ, Inv (n + 1) σ → σ 0 = none ∧ NatR σ cond ∧ cond.OK (vOf σ) Mb ∧
      cond.val (vOf σ) = 0 ∧ FrOK (σPush σ [((16 : Fin HS), ((0 : ℕ) : ℤ))]) Mb 12 step ∧
      Inv n (σPush (σPush σ [((16 : Fin HS), ((0 : ℕ) : ℤ))])
        (frV (σPush σ [((16 : Fin HS), ((0 : ℕ) : ℤ))]) step))) :
    ∀ n σ, Inv n σ → RunQ Isym tbl σ (.call j) f g (cc + (n + 1) * cLoopS sz step.length Bz) := by sorry
