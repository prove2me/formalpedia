variable {n r : ℕ} (ε : Fin n → Bool)

theorem PI.ScMuExists.UnitaryGroupMassFormula.piW_apply (e f : Fin r → Fin n → ℂ) (z x : Fin n → ℂ) :
    piW ε e f z x = x - ∑ a, hJ ε (f a) x • e a - ∑ a, hJ ε (e a) x • f a -
      ((hJ ε z z)⁻¹ * hJ ε z x) • z := by sorry
