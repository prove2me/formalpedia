      = ∑ᶠ 𝔓 ∈ primeFibre ℚ K v, (v.asIdeal.inertiaDeg' 𝔓.asIdeal : ℤ) * pinnedExp K μ 𝔓) :
    ∏ i, stdRootNumberAt ℚ v (ν i * localChar χ v)
      = ∏ᶠ 𝔓 ∈ primeFibre ℚ K v,
