    (w : D ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) :
    ∃ N : ℕ, N ≠ 0 ∧ (N : ℚ) • w ∈ Submodule.finiteAdeleBox Λ := by sorry
