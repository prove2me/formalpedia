import Definitions.Def_ModularCurve_IgusaScheme
import Definitions.Def_GaloisRep_Flat
import Mathlib.RingTheory.FiniteType

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open AlgebraicGeometry ModularCurve ModularCurve.IgusaScheme

theorem ModularCurve.IgusaScheme.finiteType_chartAlgFin_and_chartAlgInf
    (N : ℕ) [NeZero N] (ℓ : ℕ) [Fact ℓ.Prime] :
    Algebra.FiniteType ↥(GaloisRep.ratLocalizedAt ℓ) ↥(chartAlgFin N ℓ) ∧
      Algebra.FiniteType ↥(GaloisRep.ratLocalizedAt ℓ) ↥(chartAlgInf N ℓ) := by sorry
