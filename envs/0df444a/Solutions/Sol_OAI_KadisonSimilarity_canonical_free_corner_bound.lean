/-! Passing to the algebra normally generated by two free factors gives
the intrinsic reduced-product generation hypothesis. Only ordinary L²
density of the generating algebra is used; no word decomposition or
operator estimate is assumed here. -/

noncomputable section
namespace KadisonSimilarity
open TracialCornerGeometry

variable {P H : Type*} [CStarAlgebra P]
  [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

theorem factorAlgebra_map_subtype (A D L : StarSubalgebra ℂ P)
    [IsClosed (L : Set P)]
    (hA : A ≤ L) (hD : D ≤ L) :
    (factorAlgebra (A.comap L.subtype) (D.comap L.subtype)).map L.subtype =
      factorAlgebra A D := by
  have himage (B : StarSubalgebra ℂ P) (hB : B ≤ L) :
      L.subtype '' (B.comap L.subtype : Set L) = (B : Set P) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩; exact hy
    · intro hx; exact ⟨⟨x, hB hx⟩, hx, rfl⟩
  simp only [factorAlgebra, StarAlgHom.map_adjoin, Set.image_union,
    himage A hA, himage D hD]

end KadisonSimilarity

end

end OAI
end

