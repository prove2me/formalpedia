section LocallyConvexResults

variable {E : Type*} [UniformSpace E] [AddCommGroup E] [Module ℝ E]
    [hgroup : IsUniformAddGroup E] [hsmul : ContinuousSMul ℝ E]
    [hlc : LocallyConvexSpace ℝ E] [hhaus : T2Space E]

include hgroup hsmul hlc hhaus

/-- Theorem, arXiv:1004.3792v1, PDF p.3, including the final decreasing
sequence assertion. The two equivalences encode (i) iff (ii) iff (iii).
All envelopes in this theorem are closed convex envelopes. In (iii) every
term has a finite real lower bound, and positive infinite costs and limits
are allowed. The separate limit is not the first sequence term. -/
theorem monotoneContinuityCharacterization (A : Set E)
    (hA : GeneralBarycenterSpace A) (hc : Convex ℝ A) :
    (MuCompact A ↔
      ∀ (f : ℕ → E → ℝ) (fLimit : E → ℝ),
        (∀ n, BoundedContinuousOn A (f n)) → BoundedContinuousOn A fLimit →
        (∀ x ∈ A, Monotone (fun n => f n x)) →
        (∀ x ∈ A, Tendsto (fun n => f n x) atTop (𝓝 (fLimit x))) →
        ∀ x ∈ A, Tendsto
          (fun n => closedConvexHullFunction A (fun y => (f n y : EReal)) x)
          atTop (𝓝 (closedConvexHullFunction A (fun y => (fLimit y : EReal)) x))) ∧
    (MuCompact A ↔
      ∀ (f : ℕ → E → EReal) (fLimit : E → EReal),
        (∀ n, LowerSemicontinuous (fun x : A => f n x)) →
        (∀ n, ∃ c : ℝ, ∀ x ∈ A, (c : EReal) ≤ f n x) →
        (∀ x ∈ A, Monotone (fun n => f n x)) →
        (∀ x ∈ A, Tendsto (fun n => f n x) atTop (𝓝 (fLimit x))) →
        ∀ x ∈ A, Tendsto (fun n => closedConvexHullFunction A (f n) x)
          atTop (𝓝 (closedConvexHullFunction A fLimit x))) ∧
    (MuCompact A →
      ∀ (f : ℕ → E → ℝ) (fLimit : E → ℝ),
        (∀ n, LowerSemicontinuous (fun x : A => f n x)) →
        (∀ n, ∃ M : ℝ, ∀ x ∈ A, |f n x| ≤ M) →
        LowerSemicontinuous (fun x : A => fLimit x) →
        (∃ M : ℝ, ∀ x ∈ A, |fLimit x| ≤ M) →
        (∀ x ∈ A, Antitone (fun n => f n x)) →
        (∀ x ∈ A, Tendsto (fun n => f n x) atTop (𝓝 (fLimit x))) →
        ∀ x ∈ A, Tendsto
          (fun n => closedConvexHullFunction A (fun y => (f n y : EReal)) x)
          atTop (𝓝 (closedConvexHullFunction A (fun y => (fLimit y : EReal)) x))) := by sorry

end LocallyConvexResults

end QAlgorithms.Papers.Independent.Support50.P33

