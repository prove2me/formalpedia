-- Source module: Solutions.J6SegTab
/-!
# Segmented inverse (S2): construction of the constant tables

`mkTables P R s t α` (computable) fills the tables of `J6SegAlg` with
* `di u = expNeg P s (α²(t-s)u²)` (`≈ 2^P e^{-πα²θu²}`),
* `dd u = expPos (P+R) s (α²(t-s)u²) R` (`≈ 2^P e^{πα²θu²}`, needs `e^{πα²θu²} ≤ 2^R`),
* `gam`: `(q;q)_u` by the recurrence `Γ_{u+1} = Γ_u (1 - q^{u+1})` (`q^k` by `expNeg`),
* `gi u = 2^P / Γ_u` (`fdiv`), `ap/am c h = (-1)^h e^{-πα²(σ ± 2β_c)h} / Γ_h`,
* `cpl i h = expNeg P s² (α² K_{i,h})` (the entries of `E`, as in `Eapprox`).

`mkTables_ok`: `TabOK` with `E = 3λ + 3` and `Dm = D_{λ-1}`, for blocks of length `≤ λ`, as soon as
`200 (3λ+1) ≤ 2^P` and `D_{λ-1} ≤ 2^R`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section tab
variable {P R s t α : ℕ}

lemma sigma_ge (hs : 0 < s) (hst : s ≤ t) : 1 ≤ (t : ℝ) / s := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  rw [le_div_iff₀ hsR, one_mul]; exact_mod_cast hst

/-- The `a^±` entries: a product of an exponential (one ulp) and `Γ⁻¹`. -/
lemma apm_err_sol_aux (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hP : 1 ≤ P) {h : ℕ}
    (hh : 200 * (3 * (h : ℝ) + 1) ≤ 2 ^ P) {X : ℤ} {ex : ℝ} (hX : |(X : ℝ) - 2 ^ P * ex| ≤ 1)
    (he0 : 0 ≤ ex) (he1 : ex ≤ 1) :
    |((-1) ^ h * fmul P X (giI P s t α h) : ℤ) - 2 ^ P * ((-1) ^ h * (ex *
      giR (α : ℝ) ((t : ℝ) / s) h))| ≤ 3 * h + 3 := by
  have hσ := sigma_ge hs hst
  have hα' : (2 : ℝ) ≤ α := by exact_mod_cast hα
  have hS := two_pow_pos' P
  have hh0 : (0 : ℝ) ≤ h := Nat.cast_nonneg h
  have hG := giI_err (P := P) hs hst hα hP (u := h) (by linarith)
  have hgR1 := giR_le hα' hσ h
  have hgR0 := one_le_giR hα' hσ h
  set G := (giI P s t α h : ℝ)
  set gR := giR (α : ℝ) ((t : ℝ) / s) h
  have hGS : |G / 2 ^ P| ≤ 1.02 := by
    rw [abs_le] at hG ⊢
    have h1 : (3 * (h : ℝ) + 1) / 2 ^ P ≤ (0.005 : ℝ) := by rw [div_le_iff₀ hS]; linarith
    constructor
    · rw [le_div_iff₀ hS]; nlinarith
    · rw [div_le_iff₀ hS]; nlinarith
  have hr := fmul_err P X (giI P s t α h)
  have hr' : |(fmul P X (giI P s t α h) : ℝ) - X * G / 2 ^ P| ≤ 1 / 2 := by
    have e : (fmul P X (giI P s t α h) : ℝ) - X * G / 2 ^ P =
        ((fmul P X (giI P s t α h) : ℝ) / 2 ^ P - (X : ℝ) / 2 ^ P * (G / 2 ^ P)) * 2 ^ P := by
      field_simp
    rw [e, abs_mul, abs_of_pos hS]
    have := mul_le_mul_of_nonneg_right hr hS.le
    refine this.trans (le_of_eq ?_); field_simp
  have e : (X : ℝ) * G / 2 ^ P - 2 ^ P * (ex * gR) =
      ((X : ℝ) - 2 ^ P * ex) * (G / 2 ^ P) + ex * (G - 2 ^ P * gR) := by field_simp; ring
  have h1 : |((X : ℝ) - 2 ^ P * ex) * (G / 2 ^ P)| ≤ 1.02 := by
    rw [abs_mul]; exact (mul_le_mul hX hGS (abs_nonneg _) zero_le_one).trans (by norm_num)
  have h2 : |ex * (G - 2 ^ P * gR)| ≤ 3 * h + 1 := by
    rw [abs_mul, abs_of_nonneg he0]
    exact (mul_le_mul he1 hG (abs_nonneg _) zero_le_one).trans (by simp)
  have hsum := abs_add_le (((X : ℝ) - 2 ^ P * ex) * (G / 2 ^ P)) (ex * (G - 2 ^ P * gR))
  rw [← e] at hsum
  have htot : |(fmul P X (giI P s t α h) : ℝ) - 2 ^ P * (ex * gR)| ≤ 3 * h + 3 := by
    have := abs_sub_le (fmul P X (giI P s t α h) : ℝ) ((X : ℝ) * G / 2 ^ P) (2 ^ P * (ex * gR))
    linarith
  push_cast
  have e3 : ((-1 : ℝ) ^ h * (fmul P X (giI P s t α h) : ℝ)) - 2 ^ P * ((-1) ^ h * (ex * gR)) =
      (-1) ^ h * ((fmul P X (giI P s t α h) : ℝ) - 2 ^ P * (ex * gR)) := by ring
  rw [e3, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul]
  exact htot

