-- title:
--   Theorem 5.1 (linear convergence), p. 19 — under VP-EB, NAPP-AL has finite length, converges to a stationary point, Λ^k converges Q-linearly and w^k R-linearly
-- statement:
--   **Theorem 5.1 (linear convergence).** Let Assumptions 1 and 2 hold, let $\delta_k$ be set by rule (8), and let $w^k=(u^k,v^k,p^k)$ be generated by NAPP-AL. Let $\bar w$ be an accumulation point of $\{w^k\}$ with $\mathcal L_\gamma(\bar w)=\Lambda^*$, where $\Lambda^*=\lim_k\Lambda^k$ is the limit of the potential (18), and assume the value proximity error bound VP-EB holds at $\bar w$ with constants $\eta>0$, $\nu>0$, $\kappa_1>0$. Then:
--   1. there is $k_0$ with $\|w^k-\bar w\|<\eta$ and $\mathcal L_\gamma(w^k)<\Lambda^*+\nu$ for all $k\ge k_0$;
--   2. $\sum_{k=0}^\infty\|w^k-w^{k+1}\|<+\infty$ (finite length);
--   3. $w^k\to\bar w$ and $\bar w$ is a stationary point of (P);
--   4. there are $\alpha\in(0,1)$ and $k_0$ with $\Lambda^{k+1}-\Lambda^*\le\alpha(\Lambda^k-\Lambda^*)$ for all $k\ge k_0$ (Q-linear convergence of $\Lambda^k$);
--   5. the iterates converge R-linearly: there are $C\ge0$ and $\rho\in(0,1)$ with
--   $$\|w^k-\bar w\|\le C\rho^k\qquad\text{for all }k.$$
--
--   The theorem shows that a local error bound relating the gap $\mathcal L_\gamma(w^{k+1})-\Lambda^*$ to the squared step turns the sublinear guarantees of the method into linear ones. Section 6 of the paper gives two sufficient conditions for VP-EB: the Kurdyka–Łojasiewicz property with exponent $1/2$ and metric subregularity of $\partial\mathcal L_\gamma$.
--
--   **Formalization Note.** "$\mathcal L_\gamma(\bar w)=\Lambda^*$" is the hypothesis $\Lambda^k\to\mathcal L_\gamma(\bar w)$ (Theorem 4.1 would supply it, but the page states it). The constants $\kappa_1,\eta,\nu$ are given. The two $k_0$ of parts 1 and 4 are separate existentials. The page states the R-linear bound for $k\ge k_0$; stating it for all $k$ is equivalent (enlarge $C$ over finitely many terms). All norms of triples are Euclidean. The page's proof calls $\Lambda^k$ "strictly decreasing", which the sufficient-decrease lemma does not give; no hypothesis is added for it.
-- source:
--   Zhu, Zhao, Zhang, A First-Order Primal-Dual Method for Nonconvex Constrained Optimization Based on the Augmented Lagrangian, arXiv:2007.12219v1, p. 19, Theorem 5.1 (all parts and the closing 'Moreover' sentence); proof pp. 19–22

import Mathlib
import Definitions.Def_NAPPAL_KL_Setting

namespace NAPPAL.Linear


theorem theorem_5_1 {n d m : ℕ} (P : NAPPAL.KL.Problem n d m) (LG LH L0 : ℝ) (LOmj : Fin m → ℝ) (LK : ℝ)
    (K : NAPPAL.KL.E n → ℝ) (β γ σ : ℝ) (δ ε : ℕ → ℝ) (u : ℕ → NAPPAL.KL.E n) (v : ℕ → NAPPAL.KL.E d) (p : ℕ → NAPPAL.KL.E m)
    (hrun : NAPPAL.KL.RunHyp P LG LH L0 LOmj LK K β γ σ δ ε u v p)
    (wbar : NAPPAL.KL.W n d m) (hcl : MapClusterPt wbar Filter.atTop (NAPPAL.KL.wseq u v p))
    (hΛ : Filter.Tendsto (NAPPAL.KL.Lam P LG LH L0 γ u v p) Filter.atTop (nhds (NAPPAL.KL.augLag P γ wbar)))
    (κ1 η ν : ℝ) (hvp : NAPPAL.KL.VPEB P γ (NAPPAL.KL.wseq u v p) wbar κ1 η ν) :
    (∃ k0 : ℕ, ∀ k ≥ k0,
        NAPPAL.KL.wdist (NAPPAL.KL.wseq u v p k) wbar < η ∧ NAPPAL.KL.augLag P γ (NAPPAL.KL.wseq u v p k) < NAPPAL.KL.augLag P γ wbar + ν) ∧
    Summable (fun k => NAPPAL.KL.wdist (NAPPAL.KL.wseq u v p k) (NAPPAL.KL.wseq u v p (k + 1))) ∧
    (Filter.Tendsto (NAPPAL.KL.wseq u v p) Filter.atTop (nhds wbar) ∧ NAPPAL.KL.IsStationary P γ wbar) ∧
    (∃ α : ℝ, 0 < α ∧ α < 1 ∧ ∃ k0 : ℕ, ∀ k ≥ k0,
        NAPPAL.KL.Lam P LG LH L0 γ u v p (k + 1) - NAPPAL.KL.augLag P γ wbar ≤
          α * (NAPPAL.KL.Lam P LG LH L0 γ u v p k - NAPPAL.KL.augLag P γ wbar)) ∧
    (∃ C ρ : ℝ, 0 ≤ C ∧ 0 < ρ ∧ ρ < 1 ∧ ∀ k : ℕ, NAPPAL.KL.wdist (NAPPAL.KL.wseq u v p k) wbar ≤ C * ρ ^ k) := by sorry

end NAPPAL.Linear
