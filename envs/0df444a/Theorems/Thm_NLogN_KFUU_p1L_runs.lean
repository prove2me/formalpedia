theorem NLogN.KFUU.p1L_runs {pM : Fin P} (hM : MulOK I iprog pM NLogN.KFUU.MS) {pS : Fin HS} (hpS : LS pS)
    (u cz : ℕ) (bs : List Bool) (hcz : 1 ≤ cz) (w : ℕ) (xs0 : List ℤ) (hx : Bnd w xs0) (Z : ℕ)
    (hVZ : zsz ((vol (shP u bs) * cz : ℕ) : ℤ) ≤ Z) (hZ2 : 2 ≤ Z) (t : IState HS) (R : List Item)
    (h0 : t.G 0 = ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
      (lay1 (bgB bs) bs.length bs.length) xs0 0) ++ R)
    {RV RB RtS RS LZ LU LN : List Item}
    (hV : t.G pV = ints (sufV (shP u bs).reverse 1) ++ RV)
    (htS : t.G tS = ints (NLogN.KFUU.zl (shP u bs).reverse) ++ RtS) (hpS0 : t.G pS = RS)
    (hB : t.G NLogN.KFUU.qB = .int 1 :: RB)
    (hZ : t.G NLogN.KFUU.qZ = .int (cz : ℤ) :: LZ) (hU : t.G rU2 = .int ((2 ^ u : ℕ) : ℤ) :: LU)
    (hN : t.G nR = .int (bs.length : ℤ) :: LN) :
    IRuns I iprog (p1L pM pS) t
      ((((t.upd 0 (ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
        (lay1 (bgB bs) bs.length 0) xs0 0) ++ R)).upd pV RV).upd NLogN.KFUU.qB
        (.int (vol (shP u bs) : ℤ) :: RB)).upd tS RtS |>.upd pS (ints (NLogN.KFUU.zl (shP u bs)) ++ RS))
      ((bs.length + 1) * (KFU.cMv (vol (shP u bs) * cz) w + 40 * cU Z + 76 * Z + 3000)) := by sorry
