    (hg : g ≫ pullback.fst _ _ =
      Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := ↥S) (B := k))) ≫ ι)
    (𝔐 : Ideal (↥S ⊗[A] k)) [h𝔐 : 𝔐.IsMaximal] :
    ∃ u v : Localization.AtPrime 𝔐,
      u * v = 0 ∧ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔐) = Ideal.span {u, v} := by
  classical

