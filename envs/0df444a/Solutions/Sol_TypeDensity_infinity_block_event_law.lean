theorem solution (hroot : TypeDensity.RootCellLaw) (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [IsAdicComplete (IsLocalRing.maximalIdeal O) O]
    [Finite (IsLocalRing.ResidueField O)] [TopologicalSpace O] [IsTopologicalRing O]
    [CompactSpace O] [T2Space O] [SecondCountableTopology O] [MeasurableSpace O] [BorelSpace O]
    (htop : IsAdic (IsLocalRing.maximalIdeal O)) (r : ℕ) (hr : 0 < r) (σ : TypeDensity.FactorType) :
    MeasurableSet (TypeDensity.reducedFormCell O r (0 : Fin (r+1))
      (Pi.single (0 : Fin (r+1)) (1 : IsLocalRing.ResidueField O)) ∩ TypeDensity.infinityBlockEvent O r σ) ∧
      TypeDensity.cellMeasure O r (TypeDensity.reducedFormCell O r (0 : Fin (r+1))
      (Pi.single (0 : Fin (r+1)) (1 : IsLocalRing.ResidueField O))) (TypeDensity.infinityBlockEvent O r σ) =
      TypeDensity.densityValue (TypeDensity.lawCoeff (TypeDensity.lawDescend 1 (TypeDensity.stateLaw (TypeDensity.State.single 1 r))) σ)
      (Nat.card (IsLocalRing.ResidueField O)) := by
  set Z := TypeDensity.reducedFormCell O r (0 : Fin (r+1)) (Pi.single (0 : Fin (r+1))
      (1 : IsLocalRing.ResidueField O)) with hZdef
  set CX := TypeDensity.residueCell O r (Polynomial.X ^ r) with hCXdef
  set R : (Fin r → O) → (Fin r → O) := fun b => b ∘ Fin.rev with hRdef
  have hR : Measurable R := measurable_pi_iff.mpr fun j => measurable_pi_apply _
  have hZ : MeasurableSet Z :=
    (TypeDensity.normalized_form_cell_cylinder_mass O htop r 0 _ (Pi.single_eq_same _ _)).2.2.2.1
  obtain ⟨-, hbij, -, hmp⟩ := TypeDensity.form_cell_monic_identification O htop r
  have hRR : ∀ b, R (R b) = b := fun b => by
    funext j; simp [hRdef]
  have hCX : CX = R ⁻¹' Z := by
    ext b; constructor
    · intro hb
      obtain ⟨z, hz, rfl⟩ := hbij.surjOn hb
      change R (R z) ∈ Z
      rw [hRR]; exact hz
    · intro hb
      have : R (R b) ∈ CX := hbij.mapsTo hb
      rwa [hRR] at this
  have hCXm : MeasurableSet CX := hCX ▸ hR hZ
  obtain ⟨hT, hlaw⟩ := TypeDensity.irreducible_cell_type_event hroot O htop Polynomial.X Polynomial.monic_X
    Polynomial.irreducible_X r hr r (by rw [Polynomial.natDegree_X, one_mul]) σ
  rw [Polynomial.natDegree_X] at hlaw
  obtain ⟨hHm0, hH0⟩ := TypeDensity.coordinate_hyperplane_null O htop r ⟨0, hr⟩
  set H : Set (Fin r → O) := {b' | b' ⟨0, hr⟩ ≠ 0} with hHdef
  have hHm : MeasurableSet H := hHm0.compl
  set A := CX ∩ TypeDensity.typeEvent O r σ ∩ H with hAdef
  have hA : MeasurableSet A := hT.inter hHm
  have hkey : TypeDensity.infinityBlockEvent O r σ ∩ Z = R ⁻¹' A ∩ Z := by
    rw [TypeDensity.infinityBlockEvent_eq_preimage O r hr σ]
    ext b
    simp only [Set.mem_inter_iff, Set.mem_preimage, hAdef]
    constructor
    · rintro ⟨⟨h1, h2⟩, hb⟩; exact ⟨⟨⟨hbij.mapsTo hb, h2⟩, h1⟩, hb⟩
    · rintro ⟨⟨⟨-, h2⟩, h1⟩, hb⟩; exact ⟨⟨h1, h2⟩, hb⟩
  refine ⟨?_, ?_⟩
  · rw [Set.inter_comm, hkey]; exact (hR hA).inter hZ
  rw [← TypeDensity.cellMeasure_cell_inter hZ, Set.inter_comm Z, hkey, Set.inter_comm _ Z,
    TypeDensity.cellMeasure_cell_inter hZ,
    hmp.measure_preimage hA.nullMeasurableSet, ← hlaw]
  have hnull : TypeDensity.cellMeasure O r CX {b : Fin r → O | b ⟨0, hr⟩ = 0} = 0 := by
    have : (TypeDensity.coefficientMeasure O r).restrict CX {b : Fin r → O | b ⟨0, hr⟩ = 0} = 0 :=
      le_antisymm ((Measure.restrict_le_self _).trans hH0.le) (zero_le)
