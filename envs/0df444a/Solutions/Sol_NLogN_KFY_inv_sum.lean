  have h1t : (1 : ℤ) % (t : ℤ) = 1 := Int.emod_eq_of_lt (by norm_num) (by omega)
  have key : ∀ y : ℕ, y ∈ Finset.Icc 1 t → (((y : ℤ) * s) % t = 1 ↔ y = v.val) := by
    intro y hy
    rw [Finset.mem_Icc] at hy
    have e1 : ((y : ℤ) * s) % t = 1 ↔ (((y * s : ℕ) : ℤ) : ZMod t) = ((1 : ℤ) : ZMod t) := by
      rw [ZMod.intCast_eq_intCast_iff', h1t]; push_cast; rfl
    rw [e1]
    have e2 : (((y * s : ℕ) : ℤ) : ZMod t) = ((1 : ℤ) : ZMod t) ↔ (y : ZMod t) = v := by
      push_cast
      constructor
      · intro h
        calc (y : ZMod t) = y * (s * v) := by rw [hsv, mul_one]
          _ = (y * s) * v := by ring
          _ = v := by rw [h, one_mul]
      · intro h; rw [h, mul_comm]; exact hsv
    rw [e2]
    constructor
    · intro h
      have h2 := congrArg ZMod.val h
