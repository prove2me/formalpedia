    (Nat.clog_le_iff_le_pow (by norm_num)).1 (by omega)
  omega

theorem parE_le (K N nb : ℕ) (hN : 1 ≤ N) (hnb : N < 2 ^ nb) : parEx K N ≤ nb + 2 := by
  unfold parEx
  rw [Nat.clog_le_iff_le_pow (by norm_num), pow_add]
  have := par_L_le K N hN
  omega

theorem par_e_pos (K N : ℕ) (hK : 1 ≤ K) (hN : 1 ≤ N) : 1 ≤ (mkParams K N).e := by
  rw [par_e]
  exact (Nat.le_div_iff_mul_le (by omega)).2 (by have := parE_ge K N hN; omega)

