-- title:
--   Strong mean field equilibria (Definition 2.3) and strong relaxed mean field equilibria (Definition 3.5)
-- statement:
--   This file defines the single-player SDE solutions and the strong (relaxed) mean field equilibria.
--
--   1. **Solution of a Markovian SDE.** For a bounded measurable drift $B$, a *solution* of
--   $$dX_t=B(t,X_t)\,dt+dW_t,\qquad X_0\sim\lambda$$
--   is a filtered probability space $(\Omega,\mathcal F,\mathbb F,\mathbb P)$ carrying an $\mathbb F$-Brownian motion $W$ and a continuous $\mathbb F$-adapted process $X$ with the following properties:
--      - $\mathbb P\circ X_0^{-1}=\lambda$;
--      - $X_0$ is independent of $W$;
--      - almost surely, $X_t=X_0+\int_0^tB(s,X_s)\,ds+W_t$ for all $t\in[0,T]$.
--
--      This is the meaning the paper gives to "$X$ is the unique solution" (p. 7).
--   2. **Strong solution on a given space.** Given $\xi$ and $W$ on a fixed space, a *strong solution* of $dY_t=B(t,Y_t)dt+dW_t$, $Y_0=\xi$, is a continuous process with these properties:
--      - it is adapted to the completed filtration generated by $(\xi,W_s)_{s\le t}$;
--      - $Y_0=\xi$ almost surely;
--      - almost surely, $Y_t=\xi+\int_0^tB(s,Y_s)\,ds+W_t$ for all $t$.
--   3. **Strong MFE (Definition 2.3).** A flow $m\in C([0,T];\mathcal P(\mathbb R^d))$ is a *strong MFE* if there is a Borel $\alpha^*:[0,T]\times\mathbb R^d\to A$ such that the solution $X^*$ of
--   $$dX^*_t=b\big(t,X^*_t,m_t,\alpha^*(t,X^*_t)\big)dt+dW_t,\qquad X^*_0\sim\lambda,$$
--   satisfies two conditions:
--      - (1) consistency: $m_t=\mathcal L(X^*_t)$ for all $t\in[0,T]$;
--      - (2) optimality: for every Borel $\alpha:[0,T]\times\mathbb R^d\to A$,
--   $$\mathbb E\Big[\int_0^Tf\big(t,X^*_t,m_t,\alpha^*(t,X^*_t)\big)dt+g(X^*_T,m_T)\Big]\ \ge\ \mathbb E\Big[\int_0^Tf\big(t,X_t,m_t,\alpha(t,X_t)\big)dt+g(X_T,m_T)\Big],$$
--        where $X$ solves $dX_t=b(t,X_t,m_t,\alpha(t,X_t))dt+dW_t$, $X_0\sim\lambda$.
--   4. **Strong RMFE (Definition 3.5).** A *strong relaxed MFE* is the same notion with a measurable $\Lambda^*:[0,T]\times\mathbb R^d\to\mathcal P(A)$, relaxed drift $\int_Ab(t,x,m_t,a)\Lambda^*(t,x)(da)$, relaxed running reward, and measurable $\mathcal P(A)$-valued alternatives $\Lambda$.
--
--   The strong MFE is the classical mean field equilibrium. The mission's goal says that each strong MFE is the limit of Markovian approximate Nash equilibria of the $n$-player games.
--
--   **Formalization Note** The paper's "the unique solution" is unique in law (Veretennikov, Krylov–Röckner, p. 6), so conditions (1) and (2) are required for every solution, and the equilibrium SDE is additionally required to have a solution, so that the definition cannot hold vacuously. Condition (1) is printed "$m_t=\mathcal L(X_t)$"; it refers to the equilibrium state $X^*$, and is stated so. The alternatives in (2) also have solutions (same results), so quantifying over their solutions is exactly the paper's condition. "Measurable" maps $[0,T]\times\mathbb R^d\to A$ are Borel maps defined at all real times with values in $A$ on $[0,T]$; $\mathcal P(A)$ carries its Borel $\sigma$-field. The completed filtration of a strong solution adds all subsets of $\mathbb P$-null sets, and the solution is in addition required to be measurable for the ambient $\sigma$-field.
-- source:
--   Lacker, On the convergence of closed-loop Nash equilibria to the mean field game limit, arXiv:1808.02745v1, p. 7 (Section 2.2, Definition 2.3), pp. 16–17 (Definition 3.5), p. 12 (Theorem 2.14, strong solution)

import Mathlib
import Definitions.Def_ClosedLoopMFG_Converse_Model

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace ClosedLoopMFG.Converse

/-- A solution of the single-player Markovian SDE `dX_t = B(t, X_t) dt + dW_t`, `X_0 ∼ λ`, in
the sense of p. 7: a filtered probability space carrying an `𝔽`-Brownian motion `W` and a
continuous `𝔽`-adapted `X` with `P ∘ X_0⁻¹ = λ`, `X_0` independent of `W`, and almost surely
`X_t = X_0 + ∫_0^t B(s, X_s) ds + W_t` for all `t ∈ [0, T]`. -/
structure MSol (d : ℕ) (T : ℝ≥0) (lam : PR d) (B : ℝ → ClosedLoopMFG.Limit.E d → ClosedLoopMFG.Limit.E d) where
  Ω : Type
  [mΩ : MeasurableSpace Ω]
  P : Measure Ω
  [isProb : IsProbabilityMeasure P]
  𝓕 : Filtration ℝ≥0 mΩ
  W : ℝ≥0 → Ω → ClosedLoopMFG.Limit.E d
  hW : IsFBrownian 𝓕 P W
  X : Ω → ClosedLoopMFG.Limit.Path d T
  measX : Measurable X
  adaptedX : ∀ s : Set.Icc (0 : ℝ) T, Measurable[𝓕 (s : ℝ).toNNReal] (fun ω => X ω s)
  law0 : P.map (fun ω => ev (X ω) 0) = lam.meas
  indep0 : IndepFun (fun ω => ev (X ω) 0) (fun ω t => W t ω) P
  eqn : ∀ᵐ ω ∂P, ∀ t : Set.Icc (0 : ℝ) T,
    X ω t = ev (X ω) 0 + (∫ s in (0 : ℝ)..t, B s (ev (X ω) s)) + W (t : ℝ).toNNReal ω

attribute [instance] MSol.mΩ MSol.isProb

/-- `Y` is a strong solution of `dY_t = B(t, Y_t) dt + dW_t`, `Y_0 = ξ`, on a given space:
`Y` is a continuous process adapted to the `P`-completed filtration generated by
`(ξ, W_s)_{s ≤ t}`, `Y_0 = ξ` almost surely, and almost surely
`Y_t = ξ + ∫_0^t B(s, Y_s) ds + W_t` for all `t ∈ [0, T]`. -/
def IsStrongSol {Ω : Type} [MeasurableSpace Ω] {d : ℕ} {T : ℝ≥0} (P : Measure Ω)
    (ξ : Ω → ClosedLoopMFG.Limit.E d) (W : ℝ≥0 → Ω → ClosedLoopMFG.Limit.E d) (B : ℝ → ClosedLoopMFG.Limit.E d → ClosedLoopMFG.Limit.E d) (Y : Ω → ClosedLoopMFG.Limit.Path d T) : Prop :=
  Measurable Y ∧
  (∀ s : Set.Icc (0 : ℝ) T, Measurable[genFilt0 P ξ W (s : ℝ).toNNReal] (fun ω => Y ω s)) ∧
  (∀ᵐ ω ∂P, ev (Y ω) 0 = ξ ω) ∧
  ∀ᵐ ω ∂P, ∀ t : Set.Icc (0 : ℝ) T,
    Y ω t = ξ ω + (∫ s in (0 : ℝ)..t, B s (ev (Y ω) s)) + W (t : ℝ).toNNReal ω

/-- The expected reward `E[∫_0^T F(t, X_t) dt + G(X_T)]` on a solution `S`. -/
noncomputable def MSol.reward {d : ℕ} {T : ℝ≥0} {lam : PR d} {B : ℝ → ClosedLoopMFG.Limit.E d → ClosedLoopMFG.Limit.E d}
    (S : MSol d T lam B) (F : ℝ → ClosedLoopMFG.Limit.E d → ℝ) (G : ClosedLoopMFG.Limit.E d → ℝ) : ℝ :=
  ∫ ω, ((∫ t in (0 : ℝ)..T, F t (ev (S.X ω) t)) + G (ev (S.X ω) T)) ∂S.P

/-- A Markovian feedback of the mean field game: a Borel map `α : [0, T] × ℝ^d → A`
(extended to all real times; only `[0, T]` matters). -/
def IsMarkovFeedback {d : ℕ} (T : ℝ≥0) {EA : Type} [MeasurableSpace EA] (A : Set EA)
    (α : ℝ → ClosedLoopMFG.Limit.E d → EA) : Prop :=
  Measurable (Function.uncurry α) ∧ ∀ t ∈ Set.Icc 0 (T : ℝ), ∀ x, α t x ∈ A

/-- A relaxed Markovian feedback: a measurable map `Λ : [0, T] × ℝ^d → P(A)`. -/
def IsRelaxedFeedback {d : ℕ} {EA : Type} [TopologicalSpace EA] [MeasurableSpace EA]
    [BorelSpace EA] {A : Set EA} (Λ : ℝ → ClosedLoopMFG.Limit.E d → PA A) : Prop :=
  Measurable (Function.uncurry Λ)

/-- The drift `b(t, x, m_t, α(t, x))` of the representative player facing the flow `m`. -/
noncomputable def mfDrift {d : ℕ} {T : ℝ≥0} {EA : Type} (b : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ClosedLoopMFG.Limit.E d)
    (m : Flow d T) (α : ℝ → ClosedLoopMFG.Limit.E d → EA) : ℝ → ClosedLoopMFG.Limit.E d → ClosedLoopMFG.Limit.E d :=
  fun t x => b t x (ev m t) (α t x)

/-- The running reward `f(t, x, m_t, α(t, x))`. -/
noncomputable def mfRun {d : ℕ} {T : ℝ≥0} {EA : Type} (f : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ℝ)
    (m : Flow d T) (α : ℝ → ClosedLoopMFG.Limit.E d → EA) : ℝ → ClosedLoopMFG.Limit.E d → ℝ :=
  fun t x => f t x (ev m t) (α t x)

/-- The relaxed drift `∫_A b(t, x, m_t, a) Λ(t, x)(da)`. -/
noncomputable def mfDriftR {d : ℕ} {T : ℝ≥0} {EA : Type} [TopologicalSpace EA]
    [MeasurableSpace EA] {A : Set EA} (b : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ClosedLoopMFG.Limit.E d) (m : Flow d T)
    (Λ : ℝ → ClosedLoopMFG.Limit.E d → PA A) : ℝ → ClosedLoopMFG.Limit.E d → ClosedLoopMFG.Limit.E d :=
  fun t x => ∫ a, b t x (ev m t) (a : EA) ∂(Λ t x).meas

/-- The relaxed running reward `∫_A f(t, x, m_t, a) Λ(t, x)(da)`. -/
noncomputable def mfRunR {d : ℕ} {T : ℝ≥0} {EA : Type} [TopologicalSpace EA]
    [MeasurableSpace EA] {A : Set EA} (f : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ℝ) (m : Flow d T)
    (Λ : ℝ → ClosedLoopMFG.Limit.E d → PA A) : ℝ → ClosedLoopMFG.Limit.E d → ℝ :=
  fun t x => ∫ a, f t x (ev m t) (a : EA) ∂(Λ t x).meas

/-- The terminal reward `g(x, m_T)`. -/
noncomputable def mfTerm {d : ℕ} {T : ℝ≥0} (g : ClosedLoopMFG.Limit.E d → PR d → ℝ) (m : Flow d T) : ClosedLoopMFG.Limit.E d → ℝ :=
  fun x => g x (ev m T)

/-- `m` is a strong MFE with optimal feedback `α*` (Definition 2.3, p. 7): `α*` is a Borel
`A`-valued feedback, the SDE `dX*_t = b(t, X*_t, m_t, α*(t, X*_t)) dt + dW_t`, `X*_0 ∼ λ`, has a
solution, and for every solution `X*`: (1) `m_t = L(X*_t)` for all `t ∈ [0, T]`; (2) for every
Borel `A`-valued `α` and every solution `X` of the SDE driven by `α`,
`E[∫_0^T f(t, X*_t, m_t, α*(t, X*_t)) dt + g(X*_T, m_T)] ≥ E[∫_0^T f(t, X_t, m_t, α(t, X_t)) dt + g(X_T, m_T)]`. -/
def IsStrongMFEWith {d : ℕ} (T : ℝ≥0) {EA : Type} [MeasurableSpace EA] (A : Set EA)
    (lam : PR d) (b : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ClosedLoopMFG.Limit.E d) (f : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ℝ)
    (g : ClosedLoopMFG.Limit.E d → PR d → ℝ) (m : Flow d T) (αs : ℝ → ClosedLoopMFG.Limit.E d → EA) : Prop :=
  IsMarkovFeedback T A αs ∧
  Nonempty (MSol d T lam (mfDrift b m αs)) ∧
  (∀ (S : MSol d T lam (mfDrift b m αs)) (t : Set.Icc (0 : ℝ) T),
      S.P.map (fun ω => S.X ω t) = (m t).meas) ∧
  ∀ α : ℝ → ClosedLoopMFG.Limit.E d → EA, IsMarkovFeedback T A α →
    ∀ (S : MSol d T lam (mfDrift b m αs)) (S' : MSol d T lam (mfDrift b m α)),
      S'.reward (mfRun f m α) (mfTerm g m) ≤ S.reward (mfRun f m αs) (mfTerm g m)

/-- `m ∈ C([0, T]; P(ℝ^d))` is a strong mean field equilibrium (Definition 2.3, p. 7). -/
def IsStrongMFE {d : ℕ} (T : ℝ≥0) {EA : Type} [MeasurableSpace EA] (A : Set EA)
    (lam : PR d) (b : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ClosedLoopMFG.Limit.E d) (f : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ℝ)
    (g : ClosedLoopMFG.Limit.E d → PR d → ℝ) (m : Flow d T) : Prop :=
  ∃ αs : ℝ → ClosedLoopMFG.Limit.E d → EA, IsStrongMFEWith T A lam b f g m αs

/-- `(m, Λ*)` is a strong relaxed MFE (Definition 3.5, pp. 16–17): as `IsStrongMFEWith`, with
the measurable `P(A)`-valued feedback `Λ*`, relaxed drift and running reward, and relaxed
alternatives `Λ`. -/
def IsStrongRMFEWith {d : ℕ} (T : ℝ≥0) {EA : Type} [TopologicalSpace EA] [MeasurableSpace EA]
    [BorelSpace EA] (A : Set EA) (lam : PR d) (b : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ClosedLoopMFG.Limit.E d)
    (f : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ℝ) (g : ClosedLoopMFG.Limit.E d → PR d → ℝ) (m : Flow d T)
    (Λs : ℝ → ClosedLoopMFG.Limit.E d → PA A) : Prop :=
  IsRelaxedFeedback Λs ∧
  Nonempty (MSol d T lam (mfDriftR b m Λs)) ∧
  (∀ (S : MSol d T lam (mfDriftR b m Λs)) (t : Set.Icc (0 : ℝ) T),
      S.P.map (fun ω => S.X ω t) = (m t).meas) ∧
  ∀ Λ : ℝ → ClosedLoopMFG.Limit.E d → PA A, IsRelaxedFeedback Λ →
    ∀ (S : MSol d T lam (mfDriftR b m Λs)) (S' : MSol d T lam (mfDriftR b m Λ)),
      S'.reward (mfRunR f m Λ) (mfTerm g m) ≤ S.reward (mfRunR f m Λs) (mfTerm g m)

/-- `m ∈ C([0, T]; P(ℝ^d))` is a strong relaxed mean field equilibrium (Definition 3.5). -/
def IsStrongRMFE {d : ℕ} (T : ℝ≥0) {EA : Type} [TopologicalSpace EA] [MeasurableSpace EA]
    [BorelSpace EA] (A : Set EA) (lam : PR d) (b : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ClosedLoopMFG.Limit.E d)
    (f : ℝ → ClosedLoopMFG.Limit.E d → PR d → EA → ℝ) (g : ClosedLoopMFG.Limit.E d → PR d → ℝ) (m : Flow d T) : Prop :=
  ∃ Λs : ℝ → ClosedLoopMFG.Limit.E d → PA A, IsStrongRMFEWith T A lam b f g m Λs

end ClosedLoopMFG.Converse


