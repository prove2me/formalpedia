section
-- Source module: ThreeSumApsp.Pruned.RegimeTestP
/-!
# The test D^91 ≤ N^5

regimeTestP(N, D) returns 1 if `D^91 ≤ N^5` and 0 if not, and changes no cell.  It computes
`X = N^5` by three multiplications and then compares `D^91` with `X` as `regimePow` of Section 2
compares `D^18` with `N`: by at most 91 multiplications, none of which exceeds `X D` (but for the
first product, which is `D`), stopping as soon as a power of `D` exceeds `X`.
-/

@[expose] public section

namespace Light.Sec4

open ThreeSumApsp

variable {lim : Limits} {P : Program} {d : ℕ}

/-! ## The text -/

/-- One round of the comparison of `D^91` with `X` (local 0; `D` is local 1, the power local 7,
its exponent local 8, the flag local 9). -/
def regimePow91Round : Stmt :=
  .ite (Light.v 0 <' Light.v 7 *' Light.v 1)
    (.set 9 (k 0) ;; .set 8 (k 91))
    (.set 7 (Light.v 7 *' Light.v 1) ;; .set 8 (Light.v 8 +' k 1))

/-- The test `D^91 ≤ X`: the flag (local 9) ends as 1 if it holds and as 0 if not. -/
def regimePow91 : Stmt :=
  .set 7 (k 1) ;;
  .set 8 (k 0) ;;
  .set 9 (k 1) ;;
  .while (Light.v 8 <' k 91) regimePow91Round

/-- regimeTestP(N, D): `X := N^5`, then the test `D^91 ≤ X`. -/
def regimeTestPBody : Stmt :=
  .set 2 (Light.v 0 *' Light.v 0) ;;
  .set 2 (Light.v 2 *' Light.v 2) ;;
  .set 0 (Light.v 2 *' Light.v 0) ;;
  regimePow91 ;;
  .set 0 (Light.v 9)

/-! ## The comparison -/

/-- The states of the loop: as `Sec2.PowInv`, with 91 in place of 18. -/
def PowInv91 (X D : ℕ) (loc μ : ℕ → ℤ) (σ : State) : Prop :=
  σ.mem = μ ∧ (∀ x < 7, σ.loc x = loc x) ∧
    ((∃ j : ℕ, j ≤ 91 ∧ σ.loc 8 = j ∧ σ.loc 9 = 1 ∧ σ.loc 7 = ((D ^ j : ℕ) : ℤ) ∧
        (j = 0 ∨ D ^ j ≤ X)) ∨
      (σ.loc 8 = 91 ∧ σ.loc 9 = 0 ∧ X < D ^ 91))

/-! ## The test -/

end Light.Sec4
end
end

section
-- Source module: ThreeSumApsp.Pruned.AllInstancesP
/-!
# The pruned thin product on all instances

allInstancesP(N, D, w, U, x, y, wi, wj, out, fr) tests whether `D^91 ≤ N^5`, calls the offline
routine offline32 of the programs with rational parameters at `ratParamsP` (`c = 22`,
`θ = 29/250`) if so, and the brute force if not.  The program is `programP`: `program31P ratParamsP`
followed by allInstancesP (number 74) and regimeTestP (number 75).

* It solves the task `thinTask` on all instances (`allInstancesP_solves`), with a polynomial need
  (`allInstancesNeedP_poly`).  In the regime the hypotheses of Theorem 30 hold from the threshold
  on (`regimeP`), so that `below` bounds `10^L` by `(N + 1)^5` and the need covers what offline32
  asks of the limits (`lim31_of_needP`).
* In the regime its time is `O(w D^{0.44274} (log D + 1) + N² (log D + 1)²/D^{0.07618})`
  (`allInstancesTimeP_le`), by the pruned accounting (`exists_tOffline32_le_p`).
* `claim_thinProductP`: the thin product in this time for programs of the light language.
-/

@[expose] public section

namespace Light.Sec4

open ThreeSumApsp ThreeSumApsp.Spec

/-! ## The program -/

/-- The numbers of the two new procedures. -/
abbrev Proc.allInstancesP : ℕ := 74
@[inherit_doc Proc.allInstancesP] abbrev Proc.regimeTestP : ℕ := 75

/-- allInstancesP(N, D, w, U, x, y, wi, wj, out, fr). Local 10 is the result of the test. -/
def allInstancesPBody : Stmt :=
  .call Proc.regimeTestP [Light.v 0, Light.v 1] 10 ;;
  .ite (k 0 <' Light.v 10)
    (.call Proc.offline32 [Light.v 0, Light.v 1, Light.v 2, Light.v 3, Light.v 4, Light.v 5, Light.v 6, Light.v 7, Light.v 8, Light.v 9] 0)
    (.call Sec2.pThinBrute [Light.v 0, Light.v 1, Light.v 2, Light.v 3, Light.v 4, Light.v 5, Light.v 6, Light.v 7, Light.v 8, Light.v 9] 0)

/-- The program: the programs with rational parameters at `ratParamsP`, then allInstancesP and
regimeTestP. -/
noncomputable def programP : Program := program31P ratParamsP ++ [allInstancesPBody, regimeTestPBody]

/-! ## Time and need -/

/-- The time of allInstancesP, for the parameters N, D, w, U. -/
noncomputable def allInstancesTimeP (c : ℕ) : List ℕ → ℕ
  | [N, D, w, _] =>
    2000 + (if D ^ 91 ≤ N ^ 5 then tOffline32P c ratParamsP N D w else 40 * ((w + 1) * (D + 1)))
  | _ => 0

/-- The word part of the need. -/
noncomputable def wordNeedP (N D U : ℕ) : ℕ :=
  1000 + 400 * D + N * D + D * (U * U) + ((N + 1) ^ 5) ^ 3 * (U * U) + 7 * ((N + 1) ^ 5 * U)
    + 10 * (N + 1) ^ 5 + N ^ 5 * D + N ^ 5 + ratParamsP.m₀

/-- What allInstancesP needs, for the parameters N, D, w, U. -/
noncomputable def allInstancesNeedP : List ℕ → Need
  | [N, D, _, U] => ⟨wordNeedP N D U, 4 + N + 8 * (N * D) + 222 * ((N + 1) ^ 5) ^ 4, 88 * D + 12⟩
  | _ => ⟨0, 0, 0⟩

