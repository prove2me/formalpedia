set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! # The constant-fiber spatial isometry

This is the actual map from the base Roe module to the fibered Roe module.
On singleton boundary fibers it is exactly the coordinate inclusion.
-/

noncomputable section

namespace CoarseAssembly

variable {I : Type*} (Q : I → Type*) [∀ i, Fintype (Q i)] [∀ i, Nonempty (Q i)]
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

def fiberProjection : lp (fun _ : Sigma Q => H) 2 →L[ℂ] lp (fun _ : Sigma Q => H) 2 :=
  (fiberEmbedding Q).toContinuousLinearMap.comp (fiberEmbedding Q).toContinuousLinearMap.adjoint

end CoarseAssembly

end

end OAI
end

section
-- module Solutions.Q229_CA.CoarseAssembly_FiberDegree
attribute [-instance] _root_.OAI.CoarseAssembly.discGraphMetric
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! # A uniform degree bound for the finite fibered graphs

A neighbor is encoded by its base vertex, one integral left move, and nine
binary digits. The digits distinguish children in a successive congruence
fiber; at equal or smaller depth the reduced equation already determines
the target. The resulting bound is independent of the disc radius.
-/

noncomputable section

namespace CoarseAssembly

open Congruence

theorem neighborMove_spec {S : Finset ArithmeticGroup} {t : ℤ_[2]ˣ} {j : ℕ}
    (x : FiberVertex j) (y : {y // (fiberedGraph S t j).Adj x y}) :
    neighborMove x y ∈ symmetricMoves S ∧
    (x.1 = y.val.1 ∨ (discGraph j).Adj x.1 y.val.1 ∧ neighborMove x y = 1) ∧
    ∀ l (hx : l ≤ discDepth j x.1) (hy : l ≤ discDepth j y.val.1),
      fiberCoordinate y.val hy = reduce l (neighborMove x y) * fiberCoordinate x hx *
        holonomy t l ^ fiberCharge x y.val := y.property.2.choose_spec

def neighborCode {S : Finset ArithmeticGroup} {t : ℤ_[2]ˣ} {j : ℕ}
    (x : FiberVertex j) (y : {y // (fiberedGraph S t j).Adj x y}) :
    {v // v ∈ baseNeighbors x.1} × {s // s ∈ symmetricMoves S} × FiberBits := by
  refine ⟨⟨y.val.1, ?_⟩, ⟨neighborMove x y, (neighborMove_spec x y).1⟩,
    fiberBits _ y.val.2⟩
  apply (mem_baseNeighbors _ _).mpr
  exact ((neighborMove_spec x y).2.1).elim (fun h => Or.inl h.symm) (fun h => Or.inr h.1)

end CoarseAssembly

end

end OAI
end

section
-- module Solutions.Q229_CA.CoarseAssembly_TransferLift
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! # The controlled lift and its exact compression

The lift is constructed as a bounded block matrix. Its scalar coefficient
condition proves local compactness, while preservation of constant-fiber
vectors proves the compression identity. These are explicit construction
conditions, not published hypotheses for the main result.
-/

noncomputable section

namespace CoarseAssembly

open DiscreteRoe

variable {I : Type*} {Q : I → Type*} {H : Type*}
variable [DecidableEq I] [∀ i, DecidableEq (Q i)]
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

variable (rows cols : I → Finset I) (hdual : ∀ i j, j ∈ rows i ↔ i ∈ cols j)
variable (B : ∀ i j, lp (fun _ : Q j => H) 2 →L[ℂ] lp (fun _ : Q i => H) 2)
variable (N : ℕ) (C : ℝ) (hC : 0 ≤ C)
variable (hr : ∀ i, (rows i).card ≤ N) (hc : ∀ i, (cols i).card ≤ N)
variable (hB : ∀ i j, j ∈ rows i → ‖B i j‖ ≤ C)

local notation "Aₗ" => spatialBlocks rows cols hdual B N C hC hr hc hB

section Metric

variable [PseudoMetricSpace I] [PseudoMetricSpace (Sigma Q)]

theorem spatialBlocks_generator (T : Operator I H) (hT : Generator T)
    (s : ℝ) (hs : 0 ≤ s)
    (hprop : ∀ i j, j ∈ rows i → ∀ q r, s < dist (⟨i, q⟩ : Sigma Q) ⟨j, r⟩ →
      fiberBlockEntry (B i j) q r = 0)
    (hscalar : ∀ i j, j ∈ rows i → ∀ q r, ∃ c : ℂ,
      fiberBlockEntry (B i j) q r = c • entry T i j) : Generator Aₗ := by
  refine ⟨⟨s, hs, ?_⟩, ?_, ?_⟩
  · intro x y hxy
    rcases x with ⟨i, q⟩
    rcases y with ⟨j, r⟩
    rw [spatialBlocks_entry]
    split_ifs with hij
    · exact hprop i j hij q r hxy
    · rfl
  · intro x y
    rcases x with ⟨i, q⟩
    rcases y with ⟨j, r⟩
    rw [spatialBlocks_entry]
    split_ifs with hij
    · obtain ⟨c, hcoeff⟩ := hscalar i j hij q r
      rw [hcoeff]
      exact (hT.2.1 i j).smul c
    · exact isCompactOperator_zero
  · intro x y
    rcases x with ⟨i, q⟩
    rcases y with ⟨j, r⟩
    rw [entry_star, spatialBlocks_entry]
    split_ifs with hji
    · obtain ⟨c, hcoeff⟩ := hscalar j i hji r q
      rw [hcoeff, star_smul]
      have hcompact := hT.2.2 i j
      rw [entry_star] at hcompact
      exact hcompact.smul (star c)
    · rw [star_zero]
      exact isCompactOperator_zero

end Metric

section Constants

variable [∀ i, Fintype (Q i)] [∀ i, Nonempty (Q i)]

omit [∀ i, DecidableEq (Q i)] [CompleteSpace H] in
theorem spatialBlocks_intertwines (T : Operator I H)
    (houtside : ∀ i j, j ∉ rows i → entry T i j = 0)
    (hconstant : ∀ i j, j ∈ rows i → ∀ h : H,
      B i j (fiberConstant (Q j) h) = fiberConstant (Q i) (entry T i j h)) :
    (Aₗ).comp (fiberEmbedding Q).toContinuousLinearMap =
      (fiberEmbedding Q).toContinuousLinearMap.comp T := by
  apply ContinuousLinearMap.ext
  intro x
  apply lp.ext
  funext y
  rcases y with ⟨i, q⟩
  change Aₗ (fiberEmbedding Q x) ⟨i, q⟩ = fiberEmbedding Q (T x) ⟨i, q⟩
  rw [spatialBlocks_apply]
  have heq : (∑ j ∈ rows i, B i j (rowVector (fiberEmbedding Q x) j)) =
      fiberConstant (Q i) (∑ j ∈ rows i, entry T i j (x j)) := by
    calc
      _ = ∑ j ∈ rows i, fiberConstant (Q i) (entry T i j (x j)) := by
        apply Finset.sum_congr rfl
        intro j hj
        exact hconstant i j hj (x j)
      _ = _ := (map_sum (fiberConstantIsometry (Q i)).toLinearMap _ _).symm
  rw [heq, ← finite_row_apply T i (rows i) (houtside i) x]
  rfl

omit [∀ i, DecidableEq (Q i)] in
theorem spatialBlocks_compression (T : Operator I H)
    (houtside : ∀ i j, j ∉ rows i → entry T i j = 0)
    (hconstant : ∀ i j, j ∈ rows i → ∀ h : H,
      B i j (fiberConstant (Q j) h) = fiberConstant (Q i) (entry T i j h)) :
    fiberProjection Q * Aₗ * fiberProjection Q = operatorConjugation (fiberEmbedding Q) T := by
  have heq := spatialBlocks_intertwines rows cols hdual B N C hC hr hc hB T houtside hconstant
  apply ContinuousLinearMap.ext
  intro x
  have hx := DFunLike.congr_fun heq ((fiberEmbedding Q).toContinuousLinearMap.adjoint x)
  change Aₗ (fiberEmbedding Q ((fiberEmbedding Q).toContinuousLinearMap.adjoint x)) =
    fiberEmbedding Q (T ((fiberEmbedding Q).toContinuousLinearMap.adjoint x)) at hx
  change fiberEmbedding Q ((fiberEmbedding Q).toContinuousLinearMap.adjoint
      (Aₗ (fiberEmbedding Q ((fiberEmbedding Q).toContinuousLinearMap.adjoint x)))) = _
  rw [hx, adjoint_apply_isometry]
  rfl

end Constants

end CoarseAssembly

end

end OAI
end

section
-- module Solutions.Q229_CA.CoarseAssembly_LoopCircle
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! # Parametrizing a closed path by the circle

The interval endpoints are identified using Mathlib's quotient-circle
construction. The resulting continuous map agrees with the path on the
entire closed interval, including its identified endpoint.
-/

noncomputable section

namespace CoarseAssembly

open unitInterval

variable {Y : Type*} [TopologicalSpace Y] {y : Y}

theorem loopCircle_apply_lt (γ : Path y y) (t : unitInterval) (ht : (t : ℝ) < 1) :
    loopCircle γ (t : ℝ) = γ t := by
  change AddCircle.liftIco 1 0 γ.extend (t : ℝ) = γ t
  rw [AddCircle.liftIco_zero_coe_apply ⟨t.2.1, ht⟩, Path.extend_apply]

theorem loopCircle_apply (γ : Path y y) (t : unitInterval) :
    loopCircle γ (t : ℝ) = γ t := by
  rcases lt_or_eq_of_le t.2.2 with ht | ht
  · exact loopCircle_apply_lt γ t ht
  · have ht' : t = 1 := Subtype.ext ht
    subst t
    change loopCircle γ ((1 : ℝ) : WindingCircle) = γ 1
    rw [AddCircle.coe_period]
    have hzero := loopCircle_apply_lt γ 0 (by norm_num)
    simpa using hzero

end CoarseAssembly

end

end OAI
end

