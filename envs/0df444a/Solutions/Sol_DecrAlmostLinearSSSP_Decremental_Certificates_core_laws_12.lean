section s394
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreQuality
open Structured
lemma eval_code (N : ℕ) (i : Input) (hm : 2 ≤ i.size) (s : Data) (h : InputCapture.Captured i s) :
    ∃ t cost, Eval (code N) s cost t ∧ InputCapture.Captured i t ∧
      t.realReg 442 = computableCutQuality N (2*i.size) ∧
      cost ≤ 80000*(N+1)*i.size+3 ∧ t.realMem = s.realMem ∧ t.natMem = s.natMem := by
  have hprep : Eval (.seq (nadd 600 64 56) (nadd 64 64 64)) s 2 (prepared s) :=
    Eval.seq (eval_nadd s 600 64 56) (eval_nadd (saved s) 64 64 64)
  have hsize : (prepared s).natReg 64 = 2*i.size := by simp [prepared,saved,h.size,h.zeroN,two_mul]
  have hunit : (prepared s).natReg 26 = 1 := by simp [prepared,saved,h.unit]
  obtain ⟨u,cost,he,hK,hcost,hreal,hnat⟩ := CutQualityNative.code_eval_linear N (2*i.size) (by omega) (prepared s) hsize hunit
  have hu600 : u.natReg 600 = i.size := by
    rw [he.nat_frame (CutQualityNative.code_nat_frame N 600 (by omega))]
    simp [prepared,saved,h.size,h.zeroN]
  have hu56 : u.natReg 56 = 0 := by
    rw [he.nat_frame (CutQualityNative.code_nat_frame N 56 (by omega))]
    simp [prepared,saved,h.zeroN]
  have hrest := eval_nadd u 64 600 56
  have heval : Eval (code N) s (1+(1+(cost+1))) (restored u) :=
    Eval.seq (eval_nadd s 600 64 56) (Eval.seq (eval_nadd (saved s) 64 64 64) (Eval.seq he hrest))
  have hnframe : ∀ j, j ≤ 74 → (restored u).natReg j = s.natReg j := by
    intro j hj
    by_cases hj64 : j = 64
    · subst j
      simp [restored,hu600,hu56,h.size]
    · change Function.update u.natReg 64 (u.natReg 600+u.natReg 56) j = _
      rw [Function.update_of_ne hj64,he.nat_frame (CutQualityNative.code_nat_frame N j (by omega))]
      simp [prepared,saved,hj64,show j ≠ 600 by omega]
  have hrframe : ∀ j, j ≤ 64 → (restored u).realReg j = s.realReg j := by
    intro j hj
    exact he.real_frame (CutQualityNative.code_real_frame N j (by omega))
  refine ⟨restored u,1+(1+(cost+1)),heval,h.frame hnframe hrframe,hK,?_,hreal,hnat⟩
  nlinarith only [hcost]
end DecrAlmostLinearSSSP.Decremental.CoreQuality
