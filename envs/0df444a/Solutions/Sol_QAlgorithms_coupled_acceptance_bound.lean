variable {ι κ W : Type*} [Fintype ι] [Fintype κ] [Fintype W]
  [DecidableEq ι] [DecidableEq κ] [DecidableEq W]

lemma act_sub_eq {Z : Type*} [Fintype Z] (M : Matrix Z Z ℂ)
    (ψ φ : EuclideanSpace ℂ Z) : act M (ψ - φ) = act M ψ - act M φ := by
  ext z
  simp [act, Matrix.mulVec_sub]

/-- The usual telescoping bound, with all local errors evaluated in the reference run. -/
theorem finalState_dist_le {q : ℕ} (A : QueryAlg ι κ W q)
    (O P : Matrix (ι × κ) (ι × κ) ℂ)
    (hO : O ∈ Matrix.unitaryGroup (ι × κ) ℂ) :
    ‖A.finalState O - A.finalState P‖ ≤
      ∑ j : Fin q,
        ‖act (Matrix.kronecker O (1 : Matrix W W ℂ)) (A.stateAt P j.castSucc) -
          act (Matrix.kronecker P (1 : Matrix W W ℂ)) (A.stateAt P j.castSucc)‖ := by
  let err (j : Fin q) : ℝ :=
    ‖act (Matrix.kronecker O (1 : Matrix W W ℂ)) (A.stateAt P j.castSucc) -
      act (Matrix.kronecker P (1 : Matrix W W ℂ)) (A.stateAt P j.castSucc)‖
  let e (k : ℕ) : ℝ := if hk : k < q then err ⟨k, hk⟩ else 0
  have hstep (i : Fin q) :
      ‖A.stateAt O i.succ - A.stateAt P i.succ‖ ≤
        ‖A.stateAt O i.castSucc - A.stateAt P i.castSucc‖ + e i.val := by
    change ‖act (A.U i.succ : Matrix _ _ ℂ)
        (act (Matrix.kronecker O (1 : Matrix W W ℂ)) (A.stateAt O i.castSucc)) -
      act (A.U i.succ : Matrix _ _ ℂ)
        (act (Matrix.kronecker P (1 : Matrix W W ℂ)) (A.stateAt P i.castSucc))‖ ≤ _
    rw [← act_sub_eq, act_norm_of_mem_unitaryGroup (A.U i.succ).property]
    calc
      _ ≤ ‖act (Matrix.kronecker O (1 : Matrix W W ℂ)) (A.stateAt O i.castSucc) -
          act (Matrix.kronecker O (1 : Matrix W W ℂ)) (A.stateAt P i.castSucc)‖ +
        ‖act (Matrix.kronecker O (1 : Matrix W W ℂ)) (A.stateAt P i.castSucc) -
          act (Matrix.kronecker P (1 : Matrix W W ℂ)) (A.stateAt P i.castSucc)‖ :=
        norm_sub_le_norm_sub_add_norm_sub _ _ _
      _ = _ := by
        rw [← act_sub_eq, act_norm_of_mem_unitaryGroup (kronecker_one_unitary hO)]
        simp only [e, dif_pos i.isLt, Fin.eta, err]
  have h (i : Fin (q + 1)) :
      ‖A.stateAt O i - A.stateAt P i‖ ≤ ∑ k ∈ Finset.range i.val, e k := by
    induction i using Fin.induction with
    | zero => simp [QueryAlg.stateAt]
    | succ i ih =>
      simp only [Fin.val_succ, Finset.sum_range_succ]
      have hs := hstep i
      simp only [Fin.val_castSucc] at ih
      linarith
  have hf := h (Fin.last q)
  simpa only [QueryAlg.finalState, Fin.val_last, ← Fin.sum_univ_eq_sum_range,
    e, dif_pos (Fin.isLt _), Fin.eta, err] using hf

/-- Squared hybrid bound for any pair of matrix oracles, with the first unitary. -/
theorem finalState_sq_dist_le_of_unitary {q : ℕ} (A : QueryAlg ι κ W q)
    (O P : Matrix (ι × κ) (ι × κ) ℂ)
    (hO : O ∈ Matrix.unitaryGroup (ι × κ) ℂ) :
    ‖A.finalState O - A.finalState P‖ ^ 2 ≤ (q : ℝ) *
      ∑ j : Fin q,
        ‖act (Matrix.kronecker O (1 : Matrix W W ℂ)) (A.stateAt P j.castSucc) -
          act (Matrix.kronecker P (1 : Matrix W W ℂ)) (A.stateAt P j.castSucc)‖ ^ 2 := by
  let e (j : Fin q) :=
    ‖act (Matrix.kronecker O (1 : Matrix W W ℂ)) (A.stateAt P j.castSucc) -
      act (Matrix.kronecker P (1 : Matrix W W ℂ)) (A.stateAt P j.castSucc)‖
  have he : ∀ j, 0 ≤ e j := fun j => norm_nonneg _
  calc
    _ ≤ (∑ j, e j) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) (Finset.sum_nonneg fun j _ => he j)).2
        (finalState_dist_le A O P hO)
    _ ≤ _ := by
      simpa [e] using Finset.sum_mul_sq_le_sq_mul_sq Finset.univ
        (fun _ : Fin q => (1 : ℝ)) e

/-- Deterministic hybrid bound for standard additive query oracles. -/
theorem finalState_sq_dist_le [AddCommGroup κ] {q : ℕ}
    (A : QueryAlg ι κ W q) (f g : ι → κ) :
    ‖A.finalState (xorOracle f) - A.finalState (xorOracle g)‖ ^ 2 ≤ (q : ℝ) *
      ∑ j : Fin q,
        ‖act (Matrix.kronecker (xorOracle f) (1 : Matrix W W ℂ))
            (A.stateAt (xorOracle g) j.castSucc) -
          act (Matrix.kronecker (xorOracle g) (1 : Matrix W W ℂ))
            (A.stateAt (xorOracle g) j.castSucc)‖ ^ 2 := by
  apply finalState_sq_dist_le_of_unitary
  -- The bare oracle is the permutation matrix of addition in its answer register.
  rw [Matrix.mem_unitaryGroup_iff]
  have hstar : star (xorOracle f) = xorOracle (-f) := by
    ext ⟨i, y⟩ ⟨j, z⟩
    simp only [Matrix.star_apply, xorOracle, Matrix.of_apply, Pi.neg_apply]
    by_cases hij : i = j
    · subst j
      have heq : (z = y + f i) ↔ (y = z + -f i) := by
        constructor <;> intro heq <;> subst_vars <;> simp
      simp [heq]
    · simp [hij, Ne.symm hij]
  rw [hstar]
  exact xorOracle_mul_neg f

