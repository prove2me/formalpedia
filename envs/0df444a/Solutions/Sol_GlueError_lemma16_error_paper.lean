namespace Synth

open Finset Butterfly

variable {R : Type*} [CommRing R] [Algebra ℂ R]

lemma fapp_eq {r : ℕ} (f : Fin r → ℂ) {i j : Fin r} (h : (i : ℕ) = j) : f i = f j := by
  rw [Fin.ext h]

lemma norm_cyc {r : ℕ} (v : Fin r → ℂ) : ‖cyc v‖ = ‖v‖ := by
  apply le_antisymm
  · refine pi_norm_le_iff_of_nonneg (norm_nonneg _) |>.2 fun j => ?_
    unfold cyc; split_ifs
    · rw [norm_neg]; exact norm_le_pi_norm v _
    · exact norm_le_pi_norm v _
  · refine pi_norm_le_iff_of_nonneg (norm_nonneg _) |>.2 fun k => ?_
    by_cases hk : (k : ℕ) + 1 < r
    · have : v k = cyc v ⟨k + 1, hk⟩ := by simp [cyc]
      rw [this]; exact norm_le_pi_norm (cyc v) _
    · have hr : 0 < r := by have := k.isLt; omega
      have : v k = - cyc v ⟨0, hr⟩ := by
        simp only [cyc, dif_pos, neg_neg]; exact fapp_eq _ (by simp; omega)
      rw [this, norm_neg]; exact norm_le_pi_norm (cyc v) _

variable {y : Rˣ} {r : ℕ} (C : CoeffModel y r)

lemma norm_co_y_mul (z : R) : ‖C.co ((y : R) * z)‖ = ‖C.co z‖ := by rw [C.co_y, norm_cyc]

lemma norm_co_yp (e : ℤ) (z : R) : ‖C.co (yp y e * z)‖ = ‖C.co z‖ := by
  induction e using Int.induction_on with
  | zero => simp
  | succ n ih =>
    rw [show yp y ((n : ℤ) + 1) * z = (y : R) * (yp y n * z) by
      rw [yp_add, show yp y 1 = (y : R) by simp [yp]]; ring, norm_co_y_mul, ih]
  | pred n ih =>
    have key := yp_add y 1 (-(n : ℤ) - 1)
    rw [show (1 : ℤ) + (-(n : ℤ) - 1) = -(n : ℤ) by ring, show yp y 1 = (y : R) by simp [yp]] at key
    rw [← ih, key, mul_assoc, norm_co_y_mul]

/-- **Monomial split and merge.** For `s ≤ r`, `(y^s z)_j = z_{j-s}` if `s ≤ j`, and
`-z_{j+r-s}` otherwise. -/
theorem co_pow_mul (z : R) : ∀ s, s ≤ r → ∀ j : Fin r,
    C.co ((y : R) ^ s * z) j =
      if h : s ≤ (j : ℕ) then C.co z ⟨j - s, by omega⟩
      else - C.co z ⟨j + r - s, by have := j.isLt; omega⟩
  | 0, _, j => by simp
  | s + 1, hs, j => by
    rw [pow_succ', mul_assoc, C.co_y]
    unfold cyc
    by_cases hj : (j : ℕ) = 0
    · rw [dif_pos hj, co_pow_mul z s (by omega)]
      have hj' : ¬ (s + 1 ≤ (j : ℕ)) := by omega
      rw [dif_neg hj']
      by_cases hs' : s ≤ r - 1
      · rw [dif_pos hs']; exact congrArg Neg.neg (fapp_eq _ (by simp; omega))
      · have : s = r := by omega
        subst this; omega
    · rw [dif_neg hj, co_pow_mul z s (by omega)]
      simp only
      by_cases h1 : s ≤ (j : ℕ) - 1
      · rw [dif_pos h1, dif_pos (by omega)]; exact fapp_eq _ (by simp; omega)
      · rw [dif_neg h1, dif_neg (by omega)]; exact congrArg Neg.neg (fapp_eq _ (by simp; omega))

lemma co_pow (k : ℕ) (hk : k < r) : C.co ((y : R) ^ k) = Pi.single (⟨k, hk⟩ : Fin r) 1 := by
  have := co_pow_mul C 1 k hk.le
  rw [mul_one] at this
  funext j; rw [this, C.co_one]
  by_cases hkj : k ≤ (j : ℕ)
  · rw [dif_pos hkj]
    by_cases hj : (j : ℕ) = k
    · have : j = ⟨k, hk⟩ := Fin.ext hj
      subst this; simp
    · rw [Pi.single_apply, Pi.single_apply, if_neg (fun h => by simp [Fin.ext_iff] at h; omega),
        if_neg (fun h => hj (by rw [h]))]
  · rw [dif_neg hkj, Pi.single_apply, Pi.single_apply, if_neg (fun h => by
      simp [Fin.ext_iff] at h; have := j.isLt; omega), if_neg (fun h => hkj (by simp [h]))]
    simp

variable {D : ℕ}

lemma co_QpR (p : ℕ) (z : R) : C.co (QpR C p z) = fun j => Qp p (C.co z j) := by
  unfold QpR
  rw [map_sum]
  simp_rw [map_smul, co_pow C _ (Fin.isLt _)]
  funext j
  simp [Finset.sum_apply, Pi.single_apply]

/-- (26), first half: `‖Q_p z - z‖ < √2 · 2^{-p}`. -/
theorem norm_co_QpR_sub_lt (p : ℕ) (z : R) :
    ‖C.co (QpR C p z - z)‖ < Real.sqrt 2 * 2⁻¹ ^ p := by
  rw [map_sub, co_QpR]
  have hr : 0 < r := C.pos
  rw [pi_norm_lt_iff (by positivity)]
  intro j; exact norm_Qp_sub_lt p _

/-- (26), second half: `‖Q_p z‖ ≤ ‖z‖`. -/
theorem norm_co_QpR_le (p : ℕ) (z : R) : ‖C.co (QpR C p z)‖ ≤ ‖C.co z‖ := by
  rw [co_QpR]
  exact pi_norm_le_iff_of_nonneg (norm_nonneg _) |>.2 fun j =>
    (norm_Qp_le p _).trans (norm_le_pi_norm _ _)

end Synth

end

