open ModularCurve

theorem ModularCurve.coe_mem_modularLocalized_or_coe_inv_mem_modularLocalized_mul_of_not_dvd
    {q : ℕ} [Fact q.Prime] {A : ValuationSubring (AlgebraicClosure ℚ)} {N : ℕ} [NeZero N] (hqN : ¬ q ∣ N)
    {k : Type*} [Field k] [CharP k q] (red : A →+* k) :
    ∀ g : ↥(modularFunctionFieldBar (N * q)),
      (g : LaurentSeries (AlgebraicClosure ℚ)) ∈ CharPReduction.modularLocalized (N * q) A.toSubring red ∨
        ((g⁻¹ : ↥(modularFunctionFieldBar (N * q))) : LaurentSeries (AlgebraicClosure ℚ))
          ∈ CharPReduction.modularLocalized (N * q) A.toSubring red := by sorry
