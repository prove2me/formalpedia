set_option linter.unusedSectionVars false

namespace NLogN.KFM

open IntMul KFN KFR AModel

/-! ## `(log D)²` against a small power of `D` -/

/-! ## The row constant -/

/-! ## The width term -/

/-! ## The closed bound -/

/-- `Ew(D)`: the width growth `w' − w` inside `Xf` in `prop14Ph_kTable`. -/
noncomputable def EwB (A D : ℕ) : ℕ :=
  2 * D + (Nat.log (100 ^ 3) D + 1) * 100 ^ 3 * (4 * (Nat.log (100 ^ 3) D + 1) ^ 2 *
      NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc A ^ (Nat.log (100 ^ 3) D + 2)) +
