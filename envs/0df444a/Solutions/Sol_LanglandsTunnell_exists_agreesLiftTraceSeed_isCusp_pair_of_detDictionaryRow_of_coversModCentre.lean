  rcases K48_det_cases M ((_root_.LanglandsTunnell.Lift48.mem_closure_iff_mem_K48 M).1 hM) with h | h <;> rw [h] <;> decide

private theorem conj_iotaZsqrtdNegTwo (z : ℤ√(-2)) :
    starRingEnd ℂ (AutomorphicForm.iotaZsqrtdNegTwo z) = AutomorphicForm.iotaZsqrtdNegTwo (star z) := by
  rw [AutomorphicForm.iotaZsqrtdNegTwo_apply, AutomorphicForm.iotaZsqrtdNegTwo_apply, Zsqrtd.re_star,
    Zsqrtd.im_star, map_add, map_mul, map_mul, Complex.conj_I, Complex.conj_ofReal]
