/-- All the hypotheses `envP_spec` needs besides the machine state. -/
structure ExArgs (M : MulSpec) (q : Params) (kb Φf Φm m mm Φ Bacc Qa Bq Bx CS CB Q Bs mu : ℕ)
    (BS BB : ℕ → ℕ) (u v : List ℤ) : Prop where
  hMB : MulBnd M (q.fn + 1) Φf
  hP : 1 ≤ q.P
  hK : q.K ≤ q.fn
  hlo : q.logOuter ≤ q.fn
  hkb : q.logOuter ≤ kb
  hMm : MulBnd M m Φm
  hcfg : EX.FwdCfgX M q kb mm Φ Bacc Qa Bq Bx CS CB m Q BS BB
  hn : EnvN q kb Bs
  hul : u.length = q.S
  hvl : v.length = q.S
  hub : ∀ x ∈ u, zsz x ≤ mu
  hvb : ∀ x ∈ v, zsz x ≤ mu
  hmu : mu + (q.p - q.b) + 1 ≤ Q
  inU : EX.FwdInX q (FWW.FwPre q) BS BB m Q (GL.exU q u)
  inV : EX.FwdInX q (FWW.FwPre q) BS BB m Q (GL.exU q v)
  inW : EX.FwdInX q (FWW.FwPre q) BS BB m Q (GL.exW q u v)
  hS2 : zsz ((q.S : ℤ) ^ 2) ≤ m
  hBQ : 2 * m + GL.exC q + q.p + 6 ≤ Q
  hSQ : zsz ((2 * q.S : ℕ) : ℤ) ≤ Q

def envCost (q : Params) (kb Bs CS CB Bx Q Φf Φm : ℕ) : ℕ :=
  EX.pwt (envL q.K) * 10 ^ 7 * (Bs + 2) ^ 2 + 1 +
    (exCost q kb CS CB Bx Q Φf Φm + ((envV q kb).length * (2 * Bs + 2) + 1))

def innerCost (q : Params) (kb Bs CS CB Bx Q Φf Φm B : ℕ) : ℕ :=
  (q.p + 1) * 30 * 10 ^ 7 * (B + 2) ^ 2 + ((q.K + 1) * 10 ^ 10 * (B + 2) ^ 2 +
    (envCost q kb Bs CS CB Bx Q Φf Φm + (((Ex.lit (S := HS) ((8 * (q.K - 1) : ℕ) : ℤ)).size + 1) * 2000 * (B + 2) +
      (8 * (q.K - 1)) * (8000 * (B + 2) + 2 * B + 40) + 32 + (2 * B + 2))))

/-! ## `midCore` -/

def midCost (q : Params) (kb Bs CS CB Bx Q Φf Φm B : ℕ) : ℕ :=
  (2 * B + 2) + ((1 + 1) * 2000 * (B + 2) + q.K * (6000 * (B + 2) + 8000 * (B + 2) + 30) + 32 +
    (innerCost q kb Bs CS CB Bx Q Φf Φm B + ((1 + 1) * 2000 * (B + 2) +
      q.K * (8000 * (B + 2) + 2 * B + 40) + 32 + 4000 * (B + 2))))

/-! ## `midP` -/

def tmpV (q : Params) : List (Fin HS × ℤ) :=
  [(43, (q.p : ℤ)), (45, (q.S : ℤ)), (46, (q.logT : ℤ)), (47, ((2 ^ q.e : ℕ) : ℤ)),
    (48, ((2 ^ (q.e - 1) : ℕ) : ℤ)), (49, ((q.K - q.dh : ℕ) : ℤ)), (50, (EX.TT q : ℤ)),
    (51, (q.logOuter : ℤ)), (54, (q.fn : ℤ))]

def midPCost (q : Params) (kb Bs CS CB Bx Q Φf Φm B : ℕ) : ℕ :=
  EX.pwt tmpL * 10 ^ 7 * (B + 2) ^ 2 + 1 +
    (midCost q kb Bs CS CB Bx Q Φf Φm B + ((tmpV q).length * (2 * B + 2) + 1))

