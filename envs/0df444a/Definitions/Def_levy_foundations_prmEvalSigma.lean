-- title:
--   Sigma-algebra generated by Poisson evaluations inside a region
-- statement:
--   Define the least measurable structure on the sample space making the finite-intensity Poisson counts of all measurable subsets of R measurable.
-- source:
--   Inspired by Shmuel Link, LeanLevy (MIT), commit 7e73fd9b23ad52956ec2756a815889a783131ce4. Independently formulated Prove2Me draft; remote elaboration and proof pending. PoissonFiltration.lean lines 69–74.

import Mathlib.MeasureTheory.PiSystem
import Definitions.Def_levy_foundations_prmEvalIndex
import Definitions.Def_levy_foundations_poissonRandomMeasure

open MeasureTheory
namespace LevyFoundations
noncomputable def prmEvalSigma {Ω E : Type*}
    [MeasurableSpace Ω] [MeasurableSpace E]
    (K : ℕ → Ω → ℕ) (X : ℕ → ℕ → Ω → E)
    (m : Measure E) (R : Set E) : MeasurableSpace Ω :=
  ⨆ B : prmEvalIndex m R,
    MeasurableSpace.comap
      (fun ω => poissonRandomMeasure K X ω B.1) inferInstance
end LevyFoundations


