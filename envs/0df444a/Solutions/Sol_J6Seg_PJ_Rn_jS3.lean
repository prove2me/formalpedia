set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem cnt_gt_le (p : ℕ → Prop) [DecidablePred p] {r : ℕ} (hp : ∀ q, p q → r < q) :
    ∀ m, ((List.range m).filter (fun q => p q)).length ≤ m - 1 - r
  | 0 => by simp
  | m + 1 => by
    have ih := cnt_gt_le p hp m
    rw [List.range_succ, List.filter_append, List.length_append]
    by_cases h : p m
    · have := hp m h; simp [h]; omega
    · simp [h]; omega

theorem cnt_lt_le (p : ℕ → Prop) [DecidablePred p] {r : ℕ} (hp : ∀ q, p q → q < r) :
    ∀ m, ((List.range m).filter (fun q => p q)).length ≤ r
  | 0 => by simp
  | m + 1 => by
    have ih := cnt_lt_le p hp m
    rw [List.range_succ, List.filter_append, List.length_append]
    by_cases h : p m
    · have := hp m h
      have h2 : ((List.range m).filter (fun q => p q)).length ≤ m := by
        have := List.length_filter_le (fun q => decide (p q)) (List.range m); simpa using this
      simp [h]; omega
    · simp [h]; omega

theorem wbN_le (m mw : ℕ) (L : List ℕ) (r : ℕ) : wbN m mw L r ≤ m - 1 - r :=
  cnt_gt_le _ (fun q h => h.1) m

theorem cwN_le (m mw cB : ℕ) (L : List ℕ) (r : ℕ) : cwN m mw cB L r ≤ r := by
  unfold cwN; split_ifs
  · exact le_rfl
  · exact cnt_lt_le _ (fun q h => h.1) m

end J6Seg.PJ

