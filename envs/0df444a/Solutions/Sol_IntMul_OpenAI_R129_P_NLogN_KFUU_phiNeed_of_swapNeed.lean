theorem swap_part (K : ℝ) (hK : 0 ≤ K) (w h d V' VT : ℕ) (Phi : ℝ) (A B : ℕ) (hV' : V' ≤ VT)
    (hKle : ((d : ℝ) + 1) * ((w : ℝ) + 1) * ((VT : ℝ) + 1) * (h : ℝ) ^ IntMul.OpenAI.R129.P.NLogN.KFS.τS ≤ Phi)
