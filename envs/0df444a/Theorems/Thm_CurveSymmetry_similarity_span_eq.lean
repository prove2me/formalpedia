theorem CurveSymmetry.similarity_span_eq {P Q : BPoly} (hP : Irreducible P) (hQ : Irreducible Q)
    (hPinf : (realLocus P).Infinite) (hQinf : (realLocus Q).Infinite) {a b : ℂ} (ha : a ≠ 0)
    (h : (fun z : ℂ => a * z + b) '' realLocus Q = realLocus P) :
    Ideal.span {P} =
      (Ideal.span {Q}).map ((simPullEquiv a b ha).symm : BPoly →+* BPoly) := by sorry
