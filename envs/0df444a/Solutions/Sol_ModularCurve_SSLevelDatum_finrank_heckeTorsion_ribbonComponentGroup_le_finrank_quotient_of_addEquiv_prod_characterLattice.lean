theorem jointDelta_intertwine_of_mul_eq {TE : Matrix E E ℤ} {TV : Matrix V V ℤ} (i : Fin 2)
    (h : degeneracyMatrix (![D.a, D.b] i) * TE = TV * degeneracyMatrix (![D.a, D.b] i)) (x : E → ℤ) :
    jointDelta D i (TE.mulVecLin x) = TV.mulVecLin (jointDelta D i x) := by
