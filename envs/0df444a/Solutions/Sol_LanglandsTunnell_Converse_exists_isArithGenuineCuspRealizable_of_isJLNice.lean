    (harch : ∀ g₀ : AdelicGL2 (𝓞 K) K, ∃ σ : ℝ, 0 ≤ σ ∧ ∀ M : ℕ, ∃ V ∈ 𝓝 g₀, ∃ A : ℝ, ∀ g ∈ V, ∀ α : Kˣ,
      ‖archW' archR archC dR dC (globalPoints (𝓞 K) K (diagOne α) * g)‖
