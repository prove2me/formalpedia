/-!
# Coefficient bounds for same-line rejection

The exact axis-axis and diagonal-diagonal rejection identities are bounded by
evaluating the corresponding coefficient measurements at an independent
uniform affine parameter. The losses are the direct univariate collision terms
`d / q` and `md / q`.

## References

- `references/qpbt-paper/14_analysis_of_the_pauli_basis_test.tex:1020-1034`
- `references/qpbt-paper/14_analysis_of_the_pauli_basis_test.tex:1279-1288`
- `references/qpbt-paper/14_analysis_of_the_pauli_basis_test.tex:1595-1603`
- Blueprint `lem:qld-4-7`.
- Issue Dengnifer/MIPStarRE-QPBT-bak#328.
-/

@[expose] public section

open scoped BigOperators

namespace MIPStarRE.QPBT

open LIDT.MIPStarRE.LDT hiding Measurement
open LIDT.MIPStarRE.Quantum

noncomputable section

namespace ExtendedLineGame

variable {P : _root_.MIPStarRE.QPBT.AdmissibleParams} {epsilon deltaQ deltaL : Real}
variable {setting : _root_.MIPStarRE.QPBT.ProjectiveSetting P epsilon}
variable {points : _root_.MIPStarRE.QPBT.CombinedPointsWitness setting deltaQ}

/-- The consistency defect of the axis coefficient measurements after
evaluation at an independent uniform affine parameter. -/
def axisParameterEvaluatedCoefficientDefect
    (lines : _root_.MIPStarRE.QPBT.ExtendedLinesWitness setting points deltaL) : Real :=
  _root_.MIPStarRE.QPBT.consistencyDefect
    (_root_.MIPStarRE.QPBT.Distribution.prod ((_root_.MIPStarRE.QPBT.directALinePointDist P.extendedDirectLd).map Prod.fst)
      (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.MIPStarRE.QPBT.DirectScalarQ P.extendedDirectLd)))
    (fun sample value => _root_.MIPStarRE.QPBT.heteroKron
      (((((lines.Qline .alice sample.1).postprocess (_root_.MIPStarRE.QPBT.ExtendedLineGame.axisRead P)).postprocess
        (fun coefficients => _root_.MIPStarRE.QPBT.evalCoefficient coefficients sample.2)).effect value)) 1)
    (fun sample value => _root_.MIPStarRE.QPBT.heteroKron 1
      (((((lines.Qline .bob sample.1).postprocess (_root_.MIPStarRE.QPBT.ExtendedLineGame.axisRead P)).postprocess
        (fun coefficients => _root_.MIPStarRE.QPBT.evalCoefficient coefficients sample.2)).effect value)))
    (_root_.MIPStarRE.QPBT.ExtendedLineGame.pairState setting)

/-- The consistency defect of the diagonal coefficient measurements after
evaluation at an independent uniform affine parameter. -/
def diagonalParameterEvaluatedCoefficientDefect
    (lines : _root_.MIPStarRE.QPBT.ExtendedLinesWitness setting points deltaL) : Real :=
  _root_.MIPStarRE.QPBT.consistencyDefect
    (_root_.MIPStarRE.QPBT.Distribution.prod ((_root_.MIPStarRE.QPBT.directDLinePointDist P.extendedDirectLd).map Prod.fst)
      (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.MIPStarRE.QPBT.DirectScalarQ P.extendedDirectLd)))
    (fun sample value => _root_.MIPStarRE.QPBT.heteroKron
      (((((lines.Qline .alice sample.1).postprocess (_root_.MIPStarRE.QPBT.ExtendedLineGame.diagonalRead P)).postprocess
        (fun coefficients => _root_.MIPStarRE.QPBT.evalCoefficient coefficients sample.2)).effect value)) 1)
    (fun sample value => _root_.MIPStarRE.QPBT.heteroKron 1
      (((((lines.Qline .bob sample.1).postprocess (_root_.MIPStarRE.QPBT.ExtendedLineGame.diagonalRead P)).postprocess
        (fun coefficients => _root_.MIPStarRE.QPBT.evalCoefficient coefficients sample.2)).effect value)))
    (_root_.MIPStarRE.QPBT.ExtendedLineGame.pairState setting)









end ExtendedLineGame

end

end MIPStarRE.QPBT


