-- Source module: Solutions.KIL4Pass
/-!
# KIL4: multiplication of the target field by `c` or `c⁻¹` with run-time modulus

KIL3's `divPg P Q c B` / `mulPg P Q c B` (the `c` gather / scatter passes) have `P, Q, B`, the
pass counts `cntG Q c j · B` and the class of every residue (`sig Q c v`, which depends on
`Q mod c`) compiled in.  The uniform versions `divPgU c` / `mulPgU c` (code depending only on the
fixed factor `c`):

* read `Q, P, B, P·(Q·B), Q·B` from the parameter stacks `22, 24, 25, 26, 27`;
* compute `r = Q mod c` and branch on it (`sel`, `c` branches, one per residue class: the class
  function `sig r c` is compiled per branch);
* compute the count of every pass at run time, `cntG Q c j = (Q / c)·A_j + B_j` with constants
  `A_j, B_j` of the branch (`cntG_eq`), pushed on stack `29` around the pass.

Every pass is the KIL3 pass with its literals replaced by register reads (`RSim`), so its
specification is transferred by `Sp.sim`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

/-! ## Generic helpers -/

/-- A push of any expression on a general state. -/
theorem Sp.pushE (t : IState HS) {i : Fin HS} {e : Ex HS} {B : ℕ} (hi : i.val < 56)
    (hc : e.Clean) (hok : e.ok t) (hB : e.Bnd t B) :
    Sp (.push i e) t (t.upd i (.int (e.eval t) :: t.G i)) ((e.size + 1) * 10 ^ 7 * (B + 2) ^ 2) :=
  ⟨⟨hi, hc, hok⟩, rfl, pushCost_le_r6c e t B hB⟩

theorem RSim.sel {π : PMap} (r : Fin HS) {br br' : ℕ → RS} (h : ∀ v, RSim π (br v) (br' v)) :
    ∀ k m, RSim π (NLogN.KIL.sel r br k m) (NLogN.KIL.sel r br' k m)
  | _, 0 => .skip
  | k, 1 => h k
  | k, m + 2 => .ite (ESim.refl π _) (h k) (RSim.sel r h (k + 1) (m + 1))

