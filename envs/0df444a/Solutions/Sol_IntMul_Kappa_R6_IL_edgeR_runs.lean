section
-- Source module: Solutions.KIL5Tpl
/-!
# KIL5: the edge steps of the rational circuits are template-denoted

`TStep m` is a step template: a shift template (`TSh`) or a field transposition.  The rational
circuit `QCircuit.toCircuit Q` (`AModelRat`) takes as Lemma 10 data of a frame change `X` the
integer lifts mod `Q` of the rational Bruhat factors `ratFacQ A` of `A = D⁻¹ • X`
(`facD Q D`).  Reduced mod `N ∣ Q`, these lifts are the reductions `redQ N` of the fixed
rationals, so every step of `edgeSteps` is the evaluation at `N` of a template whose unit is
`±|num|/den` and whose controls are `num/den` of fixed rationals.

* `rsh i u c`: the shift template of the rational step `(i, u, c)`; `rsh_eval`.
* `QStep`: rational steps; `QStep.red N` reduces mod `N`; `QStep.tpl` is the template;
  `tpl_eval` (`(s.tpl).eval N = s.red N`).
* `shearQ E₁ Π E₂`: the rational `shearSteps`; `shearQ_red` (reduction commutes).
* `edgeTplQ C X`: the template list of a frame change; **`edgeSteps_toCircuit`**:
  `edgeSteps (C.toCircuit Q) N X = (edgeTplQ C X).map (TStep.eval N)` for every `N ∣ Q = q ^ b`
  with `1 < N`, whenever the prime `q` is good for `A` (`GoodAtQ`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open AModel AModelL12 AModelFac AModelRat

variable {m : ℕ}

/-! ## Step templates -/

/-! ## Reduction facts -/

/-- `fracZ` is the reduction of the rational `p / q`. -/
lemma redQ_eq_fracZ {N : ℕ} {r : ℚ} (h : Nat.Coprime r.den N) : redQ N r = fracZ N r.num r.den := by
  rw [redQ_eq h]; rfl

/-- `fracU` of the absolute numerator, denominator and sign is the reduction. -/
lemma redQ_eq_fracU {N : ℕ} {r : ℚ} (h : Nat.Coprime r.den N) :
    redQ N r = fracU N r.num.natAbs r.den (decide (r.num < 0)) := by
  rw [redQ_eq h]
  unfold redFun fracU
  by_cases hn : r.num < 0
  · rw [decide_eq_true hn, if_pos rfl]
    have e : r.num = -((r.num.natAbs : ℕ) : ℤ) := by omega
    conv_lhs => rw [e]
    rw [Int.cast_neg, Int.cast_natCast]; ring
  · rw [decide_eq_false hn]
    simp only [Bool.false_eq_true, if_false]
    have e : r.num = ((r.num.natAbs : ℕ) : ℤ) := by omega
    conv_lhs => rw [e]
    rw [Int.cast_natCast]; try ring

/-! ## Rational shift templates -/

theorem rsh_eval {N : ℕ} (i : Fin (m + m)) (u : ℚ) (c : Fin (m + m) → ℚ)
    (hu : Nat.Coprime u.den N) (hc : ∀ j, j < i → Nat.Coprime (c j).den N) :
    (rsh i u c).eval N = redSh N i u c := by
  simp only [TSh.eval, redSh, rsh]
  congr 1
  · rw [redQ_eq_fracU hu]
  · funext j
    simp only [TSh.ctrl, dif_pos j.2, Fin.eta]
    split_ifs with hj
    · rw [redQ_eq_fracZ (hc j hj)]
    · rfl

/-! ## Rational steps -/

namespace QStep

end QStep

