  have hgA : ∀ n : ℤ, ∃ a : ↥(A.comap (algebraMap ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (AlgebraicClosure ℚ))), algebraMap ↥(A.comap (algebraMap ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (AlgebraicClosure ℚ))) ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) a = algebraMap ℚ ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (g.coeff n) := by
