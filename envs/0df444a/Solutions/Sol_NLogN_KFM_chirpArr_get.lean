    (NLogN.KFM.chirpArr Δ d s t)[NLogN.KFM.flatIx d t j]? = some (NLogN.KFM.chirpEnt Δ s t j) 
  | 0, s, t, _, j => by simp [NLogN.KFM.chirpArr, NLogN.KFM.flatIx, NLogN.KFM.chirpEnt, NLogN.KFM.prodF]
  | d + 1, s, t, _, j => by
