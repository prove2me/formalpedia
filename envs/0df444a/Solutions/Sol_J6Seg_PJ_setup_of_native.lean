section
-- Source module: Solutions.J6SegILPreJC7
/-!
# B5 set-up, part 7: relocation permutations

`exists_perm`: two injective families `a, b : Fin m → Fin HS` of stacks `< 56`, with `a k = 55` iff
`b k = 55`, are matched by a permutation fixing every stack `≥ 55`. `encK_rn`, `Sp.ren`: the
relocated form of a managed state and of a register-program specification.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

/-! ## Relocated managed states -/

theorem encK_rn (σ : Equiv.Perm (Fin HS)) (s : IState HS) (G : Fin HS → List ℤ) :
    (encK s G).rn σ = encK (s.rn σ) (G ∘ σ.symm) := by
  refine IState.ext' (fun y => ?_) rfl rfl
  simp [IState.rn_G']

theorem Sp.ren {σ : Equiv.Perm (Fin HS)} (hσ : FixHi σ) {p : RS} {s t : IState HS} {c : ℕ}
    (h : Sp p s t c) : Sp (p.ren σ) (s.rn σ) (t.rn σ) c := by
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨(RS.ok_ren hσ p s).mpr h1, ?_, ?_⟩
  · rw [RS.run_ren, h2]
  · rw [RS.cost_ren]; exact h3

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJC9
/-!
# B5 set-up, part 9: from a native set-up pair to `SetupBody6`

A native pair `pU, pD` working on the descriptor on `Zn` and the output stacks `oN`
(`pU : F0 ↦ extend oN V F0`, `pD` back), relocated by a permutation `σ` (`σ Zn = dA`,
`σ ∘ oN = ρ`, fixing `≥ 55`), gives `SetupBody6 … ρ dA desc V C` (`setup_of_native`).
`nativeLayout`: such `σ` exists, with `Zn ∈ {49, 55}` and `oN i ∈ {i + 1, 55}`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

theorem setup_of_native_sol_aux {Pp : ℕ} (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp) (eUp eDn : Fin Pp)
    (ρ : Fin 19 → Fin HS) (dA : Fin HS) (desc : List ℤ) (V : Fin 19 → List ℤ) (C : ℝ)
    (σ : Equiv.Perm (Fin HS)) (hσ : FixHi σ) (Zn : Fin HS) (oN : Fin 19 → Fin HS)
    (hinj : Injective oN) (hZ : σ Zn = dA) (hO : ∀ i, σ (oN i) = ρ i)
    (pU pD : RS) (hU : tbl eUp = (pU.ren σ).code) (hD : tbl eDn = (pD.ren σ).code) (cU cD : ℕ)
    (SU : ∀ s0, Sp pU (encK s0 (F0 Zn desc)) (encK s0 (extend oN V (F0 Zn desc))) cU)
    (SD : ∀ s0, Sp pD (encK s0 (extend oN V (F0 Zn desc))) (encK s0 (F0 Zn desc)) cD)
    (hCU : ((cU + 2 : ℕ) : ℝ) ≤ C) (hCD : ((cD + 2 : ℕ) : ℝ) ≤ C) :
    SetupBody6 Isym tbl eUp eDn ρ dA desc V C := by
  intro s F hF hFρ hFd
  have hρinj : ∀ i j, ρ i = ρ j → i = j := fun i j h => by
    rw [← hO, ← hO] at h; exact hinj (σ.injective h)
  have eF : F = F0 Zn desc ∘ σ.symm := by
    funext j
    simp only [comp, F0]
    by_cases hj : j = dA
    · rw [hj, show σ.symm dA = Zn by rw [← hZ, Equiv.symm_apply_apply], update_self, hFd]
    · have hj' : σ.symm j ≠ Zn := fun h => hj (by rw [← hZ, ← h, Equiv.apply_symm_apply])
      rw [update_of_ne hj']
      by_cases hr : ∃ i, ρ i = j
      · obtain ⟨i, rfl⟩ := hr; exact hFρ i
      · exact hF j hj (fun i h => hr ⟨i, h⟩)
  have eE : extend ρ V F = extend oN V (F0 Zn desc) ∘ σ.symm := by
    funext j
    simp only [comp]
    by_cases hr : ∃ i, ρ i = j
    · obtain ⟨i, rfl⟩ := hr
      have hρ' : Injective ρ := fun i j h => hρinj i j h
      rw [hρ'.extend_apply, ← hO, Equiv.symm_apply_apply, hinj.extend_apply]
    · have hn : ¬ ∃ i, oN i = σ.symm j := by
        rintro ⟨i, hi⟩; exact hr ⟨i, by rw [← hO, hi, Equiv.apply_symm_apply]⟩
      rw [extend_apply' _ _ _ hr, extend_apply' _ _ _ hn, eF]; rfl
  set s0 := s.rn σ⁻¹
  have es : s0.rn σ = s := IState.rn_rn_inv σ s
  have k1 : encK s F = (encK s0 (F0 Zn desc)).rn σ := by
    rw [encK_rn, es, eF]
  have k2 : encK s (extend ρ V F) = (encK s0 (extend oN V (F0 Zn desc))).rn σ := by
    rw [encK_rn, es, eE]
  refine ⟨?_, ?_⟩
  · obtain ⟨c, hc, hr⟩ := Sp.irun (I := Isym) (iprog := tbl) (Sp.ren hσ (SU s0))
    refine ⟨c + 2, ?_, le_trans (by exact_mod_cast (by omega : c + 2 ≤ cU + 2)) hCU⟩
    rw [k1, k2]
    exact IRuns.call (by rw [hU]; exact hr)
  · obtain ⟨c, hc, hr⟩ := Sp.irun (I := Isym) (iprog := tbl) (Sp.ren hσ (SD s0))
    refine ⟨c + 2, ?_, le_trans (by exact_mod_cast (by omega : c + 2 ≤ cD + 2)) hCD⟩
    rw [k1, k2]
    exact IRuns.call (by rw [hD]; exact hr)

/-! ## The native layout -/

end J6Seg.PJ

end

theorem solution : type_of% @J6Seg.PJ.setup_of_native_sol_aux := @J6Seg.PJ.setup_of_native_sol_aux
