      simp [Nat.add_mul]
    _ ≤ (2 ^ degree) * (2 ^ degree) :=
      Nat.mul_le_mul_right (2 ^ degree)
        (Nat.succ_le_of_lt first.isLt)
    _ = (2 ^ degree) ^ 2 := by
      rw [pow_two]
theorem factor400BinaryProperFactorPairRank_div
    {degree : ℕ}
