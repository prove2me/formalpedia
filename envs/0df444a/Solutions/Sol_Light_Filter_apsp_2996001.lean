/-- `cap ≥ 1`. -/
theorem one_le_oCap {n p : ℕ} (hn : 1 ≤ n) (hp : 1 ≤ p) : 1 ≤ oCap n p := by
  rw [oCap, Nat.ceilDiv_eq_add_pred_div, Nat.le_div_iff_mul_le (by omega)]
