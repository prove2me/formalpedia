-- title:
--   The weight lattice $X_{r,s}$, the embedding (23), $\rho(\delta)$ and the dot action of $W=\Sigma_{r+s}$ (pp. 30–31)
-- statement:
--   Fix $r,s\in\mathbb N$ and $\delta\in\mathbb Z$. The **weight lattice** is
--   $$
--   X=X_{r,s}=\bigoplus_{i=-r}^{-1}\mathbb Z\epsilon_i\ \oplus\ \bigoplus_{i=1}^{s}\mathbb Z\epsilon_i ,
--   $$
--   whose elements are written $(\lambda_{-r},\dots,\lambda_{-1};\lambda_1,\dots,\lambda_s)$. The group $W$ generated by the reflections $s_\beta$, $\beta=\pm(\epsilon_i-\epsilon_j)$, is $\Sigma_{r+s}$, acting by permuting the $r+s$ coordinates. Put
--   $$
--   \rho=\rho(\delta)=(r,r-1,\dots,1;\ \delta,\delta-1,\dots,\delta-s+1),
--   $$
--   and let $W$ act by the **dot action** $w.\lambda=w(\lambda+\rho)-\rho$. A bipartition $(\lambda^L,\lambda^R)$ with at most $r$ and $s$ rows is sent to the dominant weight
--   $$
--   (\bar\lambda^L;\lambda^R)=(-\lambda^L_r,\dots,-\lambda^L_1;\ \lambda^R_1,\dots,\lambda^R_s)\qquad(23).
--   $$
--   So coordinate $-i$ is $-\lambda^L_i$ and coordinate $j$ is $\lambda^R_j$.
--
--   Section 8 shows that, in this geometry, $\delta$-balance of bipartitions is exactly membership in one orbit of the dot action.
--
--   **Formalization Note** $X$ is `Fin r ⊕ Fin s → ℤ`. `Sum.inl i` is the paper's coordinate $-(i+1)$ and `Sum.inr j` is coordinate $j+1$. So the weight is $-\lambda^L_{i+1}$ at `Sum.inl i` and $\lambda^R_{j+1}$ at `Sum.inr j` (row lengths `rowLen`, 0-based), and $\rho$ is $i+1$ at `Sum.inl i` and $\delta-j$ at `Sum.inr j`. $w\in$ `Equiv.Perm (Fin r ⊕ Fin s)` acts by $(wv)(x)=v(w^{-1}x)$. The reflection $s_{\epsilon_i-\epsilon_j}$ is the transposition of coordinates $i$ and $j$; the formula on p. 31 has a misprint, discussed in the moderation notes. A diagram with more than $r$ (resp. $s$) rows would be truncated by the embedding, so every statement about weights assumes the row bounds.
-- source:
--   Cox, De Visscher, Doty & Martin, On the blocks of the walled Brauer algebra, arXiv:0709.0851v1, pp. 30–31, Section 8 (X, W, ρ, dot action, (23))

import Mathlib

namespace WalledBrauer.Blocks

/-- The weight lattice `X = X_{r,s} = ⊕_{i=-r}^{-1} ℤ ε_i ⊕ ⊕_{i=1}^{s} ℤ ε_i` (p. 30). The
coordinate `Sum.inl i` (`i : Fin r`) is the paper's coordinate `-(i+1)`, and `Sum.inr j`
(`j : Fin s`) is the paper's coordinate `j + 1`. -/
abbrev WeightLattice (r s : ℕ) := Fin r ⊕ Fin s → ℤ

/-- The embedding (23) (p. 31) of a bipartition `(λL, λR)` (with at most `r` and `s` rows):
`(λ̄L; λR) = (-λL_r, …, -λL_1; λR_1, …, λR_s)`, i.e. the paper's coordinate `-i` is `-λL_i` and
coordinate `j` is `λR_j` (row lengths; Mathlib's rows are 0-based). -/
def weight (r s : ℕ) (lamL lamR : YoungDiagram) : WeightLattice r s :=
  Sum.elim (fun i => -((lamL.rowLen i.val : ℕ) : ℤ)) (fun j => ((lamR.rowLen j.val : ℕ) : ℤ))

/-- `ρ = ρ(δ) = (r, r-1, …, 1; δ, δ-1, …, δ-s+1)` (p. 31): the paper's `ρ_{-i} = i` and
`ρ_j = δ - j + 1`. -/
def rho (r s : ℕ) (δ : ℤ) : WeightLattice r s :=
  Sum.elim (fun i => (i.val : ℤ) + 1) (fun j => δ - j.val)

/-- The dot action `w.λ = w(λ + ρ) - ρ` (p. 31) of `W = Σ_{r+s}`, the group generated by the
reflections `s_β`, `β = ±(ε_i - ε_j)`, each of which exchanges two coordinates. `W` acts on `X`
by permuting coordinates: `(w v)(x) = v(w⁻¹ x)`. -/
def dotAct (r s : ℕ) (δ : ℤ) (w : Equiv.Perm (Fin r ⊕ Fin s)) (v : WeightLattice r s) :
    WeightLattice r s :=
  fun x => (v + rho r s δ) (w.symm x) - rho r s δ x

end WalledBrauer.Blocks


