variable {W : Type*}








/-! ### The 3-vertex path: a fully classified example -/




/-- The endpoint swap is an automorphism of the path. -/
lemma swap02_mem_autGroup_P3 : Equiv.swap (0 : Fin 3) 2 ∈ autGroup P3 := by
  decide

/-- The automorphism group of the 3-path consists of exactly the identity and the
endpoint swap. -/
theorem autGroup_P3_eq (σ : Equiv.Perm (Fin 3)) :
    σ ∈ autGroup P3 ↔ (σ = 1 ∨ σ = Equiv.swap 0 2) := by
  constructor
  · revert σ; decide
  · rintro (rfl | rfl)
    · exact one_mem _
    · exact swap02_mem_autGroup_P3






open ExternalInterpretationGraphs in
theorem solution{V' : Type*} (I : Fin 3 → V') :
    Recoverable (autGroup P3) I ↔ I 0 = I 2 := by
  rw [recoverable_iff_orbitConstant]
  constructor
  · intro h
    refine h ⟨⟨Equiv.swap 0 2, swap02_mem_autGroup_P3⟩, ?_⟩
    show Equiv.swap (0 : Fin 3) 2 0 = 2
    simp
  · rintro h x y ⟨g, rfl⟩
    rcases (autGroup_P3_eq (g : Equiv.Perm (Fin 3))).mp g.2 with hg | hg
    · have : (g : Equiv.Perm (Fin 3)) x = x := by rw [hg]; rfl
      show I x = I ((g : Equiv.Perm (Fin 3)) x)
      rw [this]
    · have hx : (g : Equiv.Perm (Fin 3)) x = Equiv.swap (0 : Fin 3) 2 x := by rw [hg]
      show I x = I ((g : Equiv.Perm (Fin 3)) x)
      rw [hx]
      fin_cases x
      · show I 0 = I (Equiv.swap (0 : Fin 3) 2 0)
        rw [Equiv.swap_apply_left]; exact h
      · show I 1 = I (Equiv.swap (0 : Fin 3) 2 1)
        rw [Equiv.swap_apply_of_ne_of_ne (by decide) (by decide)]
      · show I 2 = I (Equiv.swap (0 : Fin 3) 2 2)
        rw [Equiv.swap_apply_right]; exact h.symm
