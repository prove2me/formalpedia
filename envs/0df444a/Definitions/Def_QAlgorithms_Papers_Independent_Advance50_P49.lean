-- title:
--   Definitions for Rotationally-Invariant Circuits: Universality with the exchange interaction and two ancilla qubits
-- statement:
--   The objects the formalized statements of *Rotationally-Invariant Circuits: Universality with the exchange interaction and two ancilla qubits* (arXiv:2202.01963) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `Spin`
--   - `spin`: PDF p.8, A1–A2: the physical spin indexed in decreasing order.
--   - `spinMultiplicity`: PDF p.8, A9; zero outside the allowed spectrum. The argument d is twice the spin.
--   - `RotationInvariant`: PDF p.1: invariance under every one-qubit unitary, equivalently SU(2).
--   - `SymUnitary`: PDF p.1: a rotationally invariant physical unitary.
--   - `onWire`: PDF p.1: a one-qubit operator on a named physical wire.
--   - `heisenbergExchange`: PDF pp.1–2, B2: R_ab=(X_a X_b+Y_a Y_b+Z_a Z_b)/2. Uses require a≠b.
--   - `angular`: PDF p.8: physical Cartesian angular momentum.
--   - `casimir`: PDF p.8: the actual squared total angular momentum.
--   - `spinProjector`: PDF pp.2,8: the spectral projector of J², constructed by Lagrange interpolation. Distinct legal spins have distinct j(j+1); no projector family is assumed as input.
--   - `highest`: PDF p.8, A3: the physical highest-weight slice of sector j, one copy of its multiplicity space.
--   - `blockDet`: PDF p.17: determinant of the multiplicity block y_j, computed on the highest-weight slice and extended by identity on its orthogonal complement. Not the full-sector determinant.
--   - `sectorDet`: PDF p.24, G3: determinant on the full physical sector H_j.
--   - `localSum`: PDF p.22: finite sums of terms supported on at most k wires.
--   - `localGroup`: PDF p.1: exact finite composition of k-local invariant gates.
--   - `localLie`: PDF p.16, C3: the real Lie algebra generated by local invariant skew-Hermitians.
--   - `specialLie`: PDF p.18, C16: sector-traceless part of the local Lie algebra.
--   - `Special`: PDF p.17: special means determinant one on every multiplicity block.
--   - `evolve`: PDF pp.1–2: exp(-itH), with real control time.
--   - `ChainNeighbors`: PDF p.31: nearest-neighbor edges. The definition safely covers 0 and 1 wires.
--   - `exchangeGenerators`: PDF p.31, I1/I5: exchange generators, with optional identity generator.
--   - `exchangeLie`: PDF p.31: the real exchange-generated Lie algebra; scalar=true adjoins iI.
--   - `exchangeGroup`: PDF p.31: finite exchange circuits, with optional arbitrary global phases.
--   - `wirePermutation`: PDF p.9, A11: physical qubit permutation.
--   - `wireSwap`: PDF p.31, I3: the actual transposition of wires.
--   - `monomial`: PDF p.10, B1: ordered product of disjoint exchanges for an injective l-tuple.
--   - `central`: PDF p.10, B1 and Remark 1: all ordered injective tuples, divided by (l/2)!. For even l>n the tuple type is empty, giving zero; l=0 gives I. Odd indices are unused.
--   - `standardQ`: PDF p.11, B18: Q_l=R_12 R_34 ... R_(l-1),l, zero outside l≤n.
--   - `centralEigenvalue`: PDF p.10, B4: the actual central eigenvalue, calculated from physical sector traces.
--   - `eigenInt`: PDF pp.11,24: integer phase weight. The integrality theorem identifies this floor with the physical eigenvalue, rather than assuming integer eigenvalues as input.
--   - `centralSpace`: PDF p.17, Proposition 1: the proposed real central span.
--   - `dualCentral`: PDF p.25, G9: the dual central operator. Statements only divide at physical indices.
--   - `energyCoeff`: PDF pp.3,22: coefficients in the central expansion.
--   - `sectorMeanEnergy`: PDF p.22, E1: average energy on the physical spin sector.
--   - `registerTensor`: PDF p.25: regroup the first n and last m physical wires.
--   - `registerSplit`: PDF p.10, B7: the same physical operator in product-register coordinates.
--   - `tensorState`: PDF pp.31–36: tensor vectors in the fixed physical wire ordering.
--   - `sectorAngle`: PDF p.24, G3: sector determinant angle, in the quotient modulo 2π.
--   - `phaseMap`: PDF p.25: integer linear map on the physical sector-phase torus.
--   - `bodyPhase`: PDF p.24, G5 and Remark 2: l-body phase, extended by zero beyond the physical range.
--   - `chargeOperator`: PDF p.24, G2: the general integer-weight observable and phase.
--   - `chargePhase`: PDF p.24, G2: an integer-weighted sum of full-sector determinant angles.
--   - `SchrodingerPropagator`: PDF p.24, G1: the entrywise integral form of the Schrödinger propagator. Every entry of H and -iHU is integrable on [0,T]. The integral equation gives an absolutely continuous unitary path from I, including piecewise continuous controls. In finite dimension this is equivalent to the matrix-valued integral equation.
--   - `finitePhaseGroup`: PDF p.26, G17, corrected to include every physical even index: fixed generators and their integer powers. Integer powers include inverses, so closure is the group.
--   - `centralPhaseFactor`: PDF p.26, G18: the phase factor with the source's principal representatives.
--   - `sectorPhases`: PDF p.18, C17: independent scalar phases on physical spin sectors.
--   - `oddPauliSpace`: PDF p.23, F1: the complex span of phase-free odd-weight Pauli strings.
--   - `reverseTime`: PDF p.23, F4: conjugation by spin-half time reversal (Y tensor ... tensor Y) K. The omitted scalar i^n cancels under conjugation.
--   - `multiSwap`: PDF p.29, H1: the swap of the odd and even r-qubit registers.
--   - `swapSum`: PDF pp.29–30, H5, with the necessary empty product B_0=I.
--   - `permutationSumCoefficient`: PDF p.30, H9/H11: only l≤m is evaluated; negative factorials never occur.
--   - `triplet`: PDF pp.4,31: the ancillary triplet projector, on two physical qubits.
--   - `twoQubitSinglet`: PDF pp.11,31: the frozen normalized singlet, relabelled from a pair of Fin 2 indices to the fixed two-wire Bool register. The p.4 typo is corrected by p.31.
--   - `liftQ`: PDF p.32, I8: prescribed monomial lift. The sum is over even s=4,...,l.
--   - `averageData`: PDF p.32, I13: permutation averaging over data wires only.
--   - `liftCentral`: PDF p.32, I17: the prescribed, rather than existential, central lift.
--   - `liftHamiltonian`: PDF p.33, I21: prescribed Hamiltonian including removal of its scalar trace.
--   - `comm`: PDF p.34, I32: ordinary matrix commutator.
--   - `commutatorTemplate`: PDF pp.34–35, I33/I36: four nested-commutator terms with their first arguments supplied separately, allowing the source's recursive substitution.
--   - `templateSeeds`: PDF p.34, I32: the four initial exchanges used by the template.
--   - `templateComplements`: PDF p.34, I35: complementary disjoint exchanges for the four first brackets. Each complement avoids all three wires in the first bracket.
--   - `ExchangeExpr`: PDF p.35: finite real Lie syntax in exchange generators; evaluation is skew-Hermitian.
--   - `ExchangeExpr.eval`: PDF p.35: evaluate the actual finite expression, not an unconstrained cost or label.
--   - `monomialHamiltonian`: PDF p.33, I25: no arbitrary scalar term is included.
--   - `extendTuple`: PDF pp.33–35: extend a partial injection to a permutation, independently of reachability. For nonextendible input use identity; on a finite injective tuple an extension exists.
--   - `liftTuple`: PDF pp.33–35: prescribed lift of every tuple by permutation of the explicit Q lift.
--   - `liftMonomialHamiltonian`: PDF p.35: linear extension of the prescribed lifts, with no scalar loss.
--   - `assistedLieSet`: PDF p.36: matrices whose tensor-identity lift lies in the (n+1)-qubit local Lie algebra.
--   - `OneAncillaReachable`: PDF p.36: targets admitting fixed pure ancillary input and output in V_k.
--   - `ValidBody`: Physical even body indices; PDF p.10, including l=0.
--   - `assistedLie`: PDF p.36: the real vector space underlying the assisted tangent algebra.
-- source:
--   Rotationally-Invariant Circuits: Universality with the exchange interaction and two ancilla qubits, arXiv:2202.01963v1, https://arxiv.org/abs/2202.01963v1

import Mathlib
import Definitions.Def_QAlgorithms_Defs_Gates
import Definitions.Def_QAlgorithms_Defs_Information
import Definitions.Def_QAlgorithms_Defs_Stabilizer
import Definitions.Def_QAlgorithms_Defs_Measurement
import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P21
import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P69
import Definitions.Def_QAlgorithms_Papers_Independent_Frontier18_P14
import Definitions.Def_QAlgorithms_Defs_LocalHamiltonian

/-!
Statements from Marvian, Liu and Hulse, arXiv:2202.01963v1.
All page references are PDF pages. New physical objects are local to this paper.
Wires are zero based. A spin is indexed by r=0,...,floor(n/2), with j=n/2-r.
Products of matrices use ordered lists, including the empty product I.
Compilation and independent moderation are pending the next pipeline stages.
-/

noncomputable section

namespace QAlgorithms.Papers.Independent.Advance50.P49

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius
open MeasureTheory

attribute [local instance 100] LieRing.ofAssociativeRing

-- Specialize the frozen generic aliases without declaring new aliases.
local notation "Op" => (fun n : ℕ => QAlgorithms.Papers.Independent.Information100.P21.Op (Qubits n))

local notation "Vec" => (fun n : ℕ => QAlgorithms.Papers.Independent.Information100.P21.Vec (Qubits n))

-- The frozen support predicate takes the support before the operator.
local notation "WireSupported" => QAlgorithms.Papers.Independent.Information100.P69.Supported

abbrev Spin (n : ℕ) := Fin (n / 2 + 1)

/-- PDF p.8, A1–A2: the physical spin indexed in decreasing order. -/
def spin (n : ℕ) (r : Spin n) : ℝ := (n : ℝ) / 2 - r.val

/-- PDF p.8, A9; zero outside the allowed spectrum. The argument d is twice the spin. -/
def spinMultiplicity (n d : ℕ) : ℕ :=
  if d ≤ n ∧ (n - d) % 2 = 0 then
    Nat.choose n ((n - d) / 2) * (d + 1) / ((n + d) / 2 + 1)
  else 0

/-- PDF p.1: invariance under every one-qubit unitary, equivalently SU(2). -/
def RotationInvariant {n : ℕ} (A : Op n) : Prop :=
  ∀ U : Matrix Bool Bool ℂ, U ∈ Matrix.unitaryGroup Bool ℂ →
    A * QAlgorithms.Papers.Independent.Information100.P69.matrixPower U n = QAlgorithms.Papers.Independent.Information100.P69.matrixPower U n * A

/-- PDF p.1: a rotationally invariant physical unitary. -/
def SymUnitary {n : ℕ} (U : Op n) : Prop :=
  U ∈ Matrix.unitaryGroup (Qubits n) ℂ ∧ RotationInvariant U

/-- PDF p.1: a one-qubit operator on a named physical wire. -/
def onWire {n : ℕ} (q : Fin n) (A : Matrix Bool Bool ℂ) : Op n :=
  fun x y => A (x q) (y q) * ∏ r ∈ Finset.univ.erase q, if x r = y r then 1 else 0

/-- PDF pp.1–2, B2: R_ab=(X_a X_b+Y_a Y_b+Z_a Z_b)/2. Uses require a≠b. -/
def heisenbergExchange {n : ℕ} (a b : Fin n) : Op n :=
  (1 / 2 : ℂ) • (onWire a pauliX * onWire b pauliX +
    onWire a pauliY * onWire b pauliY + onWire a pauliZ * onWire b pauliZ)

/-- PDF p.8: physical Cartesian angular momentum. -/
def angular (n : ℕ) (A : Matrix Bool Bool ℂ) : Op n :=
  (1 / 2 : ℂ) • ∑ q : Fin n, onWire q A

/-- PDF p.8: the actual squared total angular momentum. -/
def casimir (n : ℕ) : Op n :=
  angular n pauliX ^ 2 + angular n pauliY ^ 2 + angular n pauliZ ^ 2

/-- PDF pp.2,8: the spectral projector of J², constructed by Lagrange interpolation.
Distinct legal spins have distinct j(j+1); no projector family is assumed as input. -/
def spinProjector (n : ℕ) (j : Spin n) : Op n :=
  ((List.ofFn fun r : Spin n => r).filter (fun r => r ≠ j)).map
    (fun r => ((spin n j * (spin n j + 1) - spin n r * (spin n r + 1) : ℝ)⁻¹ : ℂ) •
      (casimir n - (spin n r * (spin n r + 1) : ℂ) • (1 : Op n))) |>.prod

/-- PDF p.8, A3: the physical highest-weight slice of sector j, one copy of its multiplicity space. -/
def highest (n : ℕ) (j : Spin n) : Op n :=
  spinProjector n j * Matrix.diagonal (fun x : Qubits n =>
    if (Finset.univ.filter fun q : Fin n => x q = true).card = j.val then 1 else 0)

/-- PDF p.17: determinant of the multiplicity block y_j, computed on the highest-weight
slice and extended by identity on its orthogonal complement. Not the full-sector determinant. -/
def blockDet {n : ℕ} (U : Op n) (j : Spin n) : ℂ :=
  Matrix.det (U * highest n j + (1 - highest n j))

/-- PDF p.24, G3: determinant on the full physical sector H_j. -/
def sectorDet {n : ℕ} (U : Op n) (j : Spin n) : ℂ :=
  Matrix.det (U * spinProjector n j + (1 - spinProjector n j))

/-- PDF p.22: finite sums of terms supported on at most k wires. -/
def localSum (n k : ℕ) : Submodule ℂ (Op n) :=
  Submodule.span ℂ {A | ∃ s : Finset (Fin n), s.card ≤ k ∧ WireSupported s A}

/-- PDF p.1: exact finite composition of k-local invariant gates. -/
def localGroup (n k : ℕ) : Submonoid (Op n) :=
  Submonoid.closure {U | SymUnitary U ∧
    ∃ s : Finset (Fin n), s.card ≤ k ∧ WireSupported s U}

/-- PDF p.16, C3: the real Lie algebra generated by local invariant skew-Hermitians. -/
def localLie (n k : ℕ) : LieSubalgebra ℝ (Op n) :=
  LieSubalgebra.lieSpan ℝ (Op n) {A | A + Aᴴ = 0 ∧ RotationInvariant A ∧
    ∃ s : Finset (Fin n), s.card ≤ k ∧ WireSupported s A}

/-- PDF p.18, C16: sector-traceless part of the local Lie algebra. -/
def specialLie (n k : ℕ) : Submodule ℝ (Op n) :=
  Submodule.span ℝ {A | A ∈ localLie n k ∧ ∀ j : Spin n, Matrix.trace (A * spinProjector n j) = 0}

/-- PDF p.17: special means determinant one on every multiplicity block. -/
def Special {n : ℕ} (U : Op n) : Prop :=
  SymUnitary U ∧ ∀ j : Spin n, blockDet U j = 1

/-- PDF pp.1–2: exp(-itH), with real control time. -/
def evolve {n : ℕ} (H : Op n) (t : ℝ) : Op n :=
  NormedSpace.exp ((-Complex.I * (t : ℂ)) • H)

/-- PDF p.31: nearest-neighbor edges. The definition safely covers 0 and 1 wires. -/
def ChainNeighbors {n : ℕ} (a b : Fin n) : Prop := a.val + 1 = b.val

/-- PDF p.31, I1/I5: exchange generators, with optional identity generator. -/
def exchangeGenerators (n : ℕ) (chain scalar : Bool) : Set (Op n) :=
  {A | (scalar = true ∧ A = Complex.I • (1 : Op n)) ∨
    ∃ a b : Fin n, a ≠ b ∧ (chain = true → ChainNeighbors a b) ∧ A = Complex.I • heisenbergExchange a b}

/-- PDF p.31: the real exchange-generated Lie algebra; scalar=true adjoins iI. -/
def exchangeLie (n : ℕ) (chain : Bool := false) (scalar : Bool := false) : LieSubalgebra ℝ (Op n) :=
  LieSubalgebra.lieSpan ℝ (Op n) (exchangeGenerators n chain scalar)

/-- PDF p.31: finite exchange circuits, with optional arbitrary global phases. -/
def exchangeGroup (n : ℕ) (chain : Bool := false) (scalar : Bool := false) : Submonoid (Op n) :=
  Submonoid.closure {U | (scalar = true ∧ ∃ t : ℝ, U = Complex.exp (Complex.I * t) • (1 : Op n)) ∨
    ∃ a b : Fin n, a ≠ b ∧ (chain = true → ChainNeighbors a b) ∧ ∃ t : ℝ, U = evolve (heisenbergExchange a b) t}

/-- PDF p.9, A11: physical qubit permutation. -/
def wirePermutation {n : ℕ} (p : Equiv.Perm (Fin n)) : Op n :=
  fun x y => if x = fun q => y (p.symm q) then 1 else 0

/-- PDF p.31, I3: the actual transposition of wires. -/
def wireSwap {n : ℕ} (a b : Fin n) : Op n := wirePermutation (Equiv.swap a b)

/-- PDF p.10, B1: ordered product of disjoint exchanges for an injective l-tuple. -/
def monomial {n l : ℕ} (i : Fin l ↪ Fin n) : Op n :=
  (List.ofFn fun r : Fin (l / 2) =>
    heisenbergExchange (i ⟨2 * r.val, by omega⟩) (i ⟨2 * r.val + 1, by omega⟩)).prod

/-- PDF p.10, B1 and Remark 1: all ordered injective tuples, divided by (l/2)!.
For even l>n the tuple type is empty, giving zero; l=0 gives I. Odd indices are unused. -/
def central (n l : ℕ) : Op n :=
  if Even l then ((Nat.factorial (l / 2) : ℂ)⁻¹) • ∑ i : Fin l ↪ Fin n, monomial i else 0

/-- PDF p.11, B18: Q_l=R_12 R_34 ... R_(l-1),l, zero outside l≤n. -/
def standardQ (n l : ℕ) : Op n :=
  if h : l ≤ n then monomial ⟨fun q => ⟨q.val, lt_of_lt_of_le q.isLt h⟩,
    by
      intro a b hab
      have hval : a.val = b.val := congrArg (fun z : Fin n => z.val) hab
      exact Fin.ext hval⟩ else 0

/-- PDF p.10, B4: the actual central eigenvalue, calculated from physical sector traces. -/
def centralEigenvalue (n l : ℕ) (j : Spin n) : ℝ :=
  (Matrix.trace (central n l * spinProjector n j) / Matrix.trace (spinProjector n j)).re

/-- PDF pp.11,24: integer phase weight. The integrality theorem identifies this floor
with the physical eigenvalue, rather than assuming integer eigenvalues as input. -/
def eigenInt (n l : ℕ) (j : Spin n) : ℤ := Int.floor (centralEigenvalue n l j)

/-- PDF p.17, Proposition 1: the proposed real central span. -/
def centralSpace (n k : ℕ) : Submodule ℝ (Op n) :=
  Submodule.span ℝ {A | ∃ r : Fin (k / 2 + 1), A = Complex.I • central n (2 * r.val)}

/-- PDF p.25, G9: the dual central operator. Statements only divide at physical indices. -/
def dualCentral (n l : ℕ) : Op n :=
  (Matrix.trace (central n l ^ 2))⁻¹ • central n l

/-- PDF pp.3,22: coefficients in the central expansion. -/
def energyCoeff {n : ℕ} (H : Op n) (l : ℕ) : ℝ :=
  (Matrix.trace (H * central n l) / Matrix.trace (central n l ^ 2)).re

/-- PDF p.22, E1: average energy on the physical spin sector. -/
def sectorMeanEnergy {n : ℕ} (H : Op n) (j : Spin n) : ℝ :=
  (Matrix.trace (H * spinProjector n j) / Matrix.trace (spinProjector n j)).re

/-- PDF p.25: regroup the first n and last m physical wires. -/
def registerTensor {n m : ℕ} (A : Op n) (B : Op m) : Op (n + m) :=
  fun x y => let e := (Fin.appendEquiv (α := Bool) n m).symm
    A (e x).1 (e y).1 * B (e x).2 (e y).2

/-- PDF p.10, B7: the same physical operator in product-register coordinates. -/
def registerSplit {n m : ℕ} (A : Op (n + m)) :
    Matrix (Qubits n × Qubits m) (Qubits n × Qubits m) ℂ :=
  fun x y => A (Fin.appendEquiv n m x) (Fin.appendEquiv n m y)

/-- PDF pp.31–36: tensor vectors in the fixed physical wire ordering. -/
def tensorState {n m : ℕ} (v : Vec n) (w : Vec m) : Vec (n + m) :=
  WithLp.toLp 2 (fun x => let e := (Fin.appendEquiv (α := Bool) n m).symm
    v (e x).1 * w (e x).2)

/-- PDF p.24, G3: sector determinant angle, in the quotient modulo 2π. -/
def sectorAngle {n : ℕ} (U : Op n) (j : Spin n) : Real.Angle :=
  (Complex.arg (sectorDet U j) : ℝ)

/-- PDF p.25: integer linear map on the physical sector-phase torus. -/
def phaseMap (n : ℕ) (theta : Spin n → Real.Angle) : Spin n → Real.Angle :=
  fun r => ∑ j : Spin n, eigenInt n (2 * r.val) j • theta j

/-- PDF p.24, G5 and Remark 2: l-body phase, extended by zero beyond the physical range. -/
def bodyPhase {n : ℕ} (U : Op n) (l : ℕ) : Real.Angle :=
  if Even l ∧ l ≤ 2 * (n / 2) then ∑ j : Spin n, eigenInt n l j • sectorAngle U j else 0

/-- PDF p.24, G2: the general integer-weight observable and phase. -/
def chargeOperator (n : ℕ) (c : Spin n → ℤ) : Op n :=
  ∑ j : Spin n, (c j : ℂ) • spinProjector n j

/-- PDF p.24, G2: an integer-weighted sum of full-sector determinant angles. -/
def chargePhase {n : ℕ} (U : Op n) (c : Spin n → ℤ) : Real.Angle :=
  ∑ j : Spin n, c j • sectorAngle U j

/-- PDF p.24, G1: the entrywise integral form of the Schrödinger propagator.
Every entry of H and -iHU is integrable on [0,T]. The integral equation gives an
absolutely continuous unitary path from I, including piecewise continuous controls.
In finite dimension this is equivalent to the matrix-valued integral equation. -/
def SchrodingerPropagator {n : ℕ} (H U : ℝ → Op n) (T : ℝ) : Prop :=
  0 ≤ T ∧
  (∀ x y : Qubits n, IntegrableOn (fun t => H t x y) (Set.Icc 0 T)) ∧
  (∀ x y : Qubits n,
    IntegrableOn (fun t => ((-Complex.I) • (H t * U t)) x y) (Set.Icc 0 T)) ∧
  (∀ t ∈ Set.Icc 0 T, (H t).IsHermitian ∧ RotationInvariant (H t) ∧ SymUnitary (U t)) ∧
  ∀ t ∈ Set.Icc 0 T, ∀ x y : Qubits n,
    U t x y = (1 : Op n) x y +
      ∫ s in (0 : ℝ)..t, ((-Complex.I) • (H s * U s)) x y

/-- PDF p.26, G17, corrected to include every physical even index: fixed generators
and their integer powers. Integer powers include inverses, so closure is the group. -/
def finitePhaseGroup (n : ℕ) : Submonoid (Op n) :=
  Submonoid.closure {U |
    (∃ (r : Spin n) (z : ℤ), U = NormedSpace.exp
      ((Complex.I * (2 * Real.pi : ℝ) * (z : ℂ)) • dualCentral n (2 * r.val))) ∨
    (∃ (j : Spin n) (z : ℤ), U = NormedSpace.exp
      ((Complex.I * (2 * Real.pi : ℝ) * (z : ℂ) / Matrix.trace (spinProjector n j)) • spinProjector n j))}

/-- PDF p.26, G18: the phase factor with the source's principal representatives. -/
def centralPhaseFactor {n : ℕ} (U : Op n) : Op n :=
  (List.ofFn fun r : Spin n => NormedSpace.exp
    ((Complex.I * ((bodyPhase U (2 * r.val)).toReal : ℂ)) • dualCentral n (2 * r.val))).prod

/-- PDF p.18, C17: independent scalar phases on physical spin sectors. -/
def sectorPhases (n : ℕ) (theta : Spin n → ℝ) : Op n :=
  ∑ j : Spin n, Complex.exp (Complex.I * theta j) • spinProjector n j

/-- PDF p.23, F1: the complex span of phase-free odd-weight Pauli strings. -/
def oddPauliSpace (n : ℕ) : Submodule ℂ (Op n) :=
  Submodule.span ℂ {A | ∃ P : Stabilizer.PauliString n, P.phase = 0 ∧
    Odd ((Finset.univ.filter fun q : Fin n => P.ops q ≠ Stabilizer.Pauli.I).card) ∧
    A = P.toMatrix}

/-- PDF p.23, F4: conjugation by spin-half time reversal (Y tensor ... tensor Y) K.
The omitted scalar i^n cancels under conjugation. -/
def reverseTime {n : ℕ} (A : Op n) : Op n :=
  QAlgorithms.Papers.Independent.Information100.P69.matrixPower pauliY n * (A.map conj : Op n) * (QAlgorithms.Papers.Independent.Information100.P69.matrixPower pauliY n)ᴴ

/-- PDF p.29, H1: the swap of the odd and even r-qubit registers. -/
def multiSwap (r : ℕ) : Op (2 * r) :=
  (List.ofFn fun q : Fin r => wireSwap
    (⟨2 * q.val, by omega⟩ : Fin (2 * r)) ⟨2 * q.val + 1, by omega⟩).prod

/-- PDF pp.29–30, H5, with the necessary empty product B_0=I. -/
def swapSum (n m : ℕ) : Op n :=
  if Even m then (Nat.factorial (m / 2) : ℂ)⁻¹ •
    ∑ i : Fin m ↪ Fin n, (List.ofFn fun q : Fin (m / 2) =>
      wireSwap (i ⟨2 * q.val, by omega⟩) (i ⟨2 * q.val + 1, by omega⟩)).prod else 0

/-- PDF p.30, H9/H11: only l≤m is evaluated; negative factorials never occur. -/
def permutationSumCoefficient (n m l : ℕ) : ℝ :=
  (2 : ℝ) ^ ((l : ℤ) / 2 - (m : ℤ) / 2) * (Nat.factorial (n-l) : ℝ) /
    ((Nat.factorial (n-m) : ℝ) * (Nat.factorial ((m-l)/2) : ℝ))

/-- PDF pp.4,31: the ancillary triplet projector, on two physical qubits. -/
def triplet : Op 2 := (1 / 2 : ℂ) • (heisenbergExchange (0 : Fin 2) 1 + (3 / 2 : ℂ) • (1 : Op 2))

/-- PDF pp.11,31: the frozen normalized singlet, relabelled from a pair of
Fin 2 indices to the fixed two-wire Bool register. The p.4 typo is corrected by p.31. -/
def twoQubitSinglet : Vec 2 :=
  WithLp.toLp 2 (fun x : Qubits 2 =>
    QAlgorithms.Papers.Independent.Frontier18.P14.singlet
      ((if x 0 then 1 else 0), (if x 1 then 1 else 0)))

/-- PDF p.32, I8: prescribed monomial lift. The sum is over even s=4,...,l. -/
def liftQ (n l : ℕ) : Op (n + 2) :=
  ((2 : ℂ) ^ (l/2))⁻¹ • ((2 : ℂ) • registerTensor (standardQ n 2) (1 : Op 2) +
    ∑ r ∈ (Finset.range (l/2+1)).filter (fun r => 2 ≤ r),
      (2 : ℂ) ^ r • (registerTensor (standardQ n (2*r)) (1 : Op 2) -
        registerTensor (standardQ n (2*r-2)) (heisenbergExchange (0 : Fin 2) 1)))

/-- PDF p.32, I13: permutation averaging over data wires only. -/
def averageData {n : ℕ} (A : Op (n + 2)) : Op (n + 2) :=
  (Nat.factorial n : ℂ)⁻¹ • ∑ p : Equiv.Perm (Fin n),
    registerTensor (wirePermutation p) (1 : Op 2) * A * (registerTensor (wirePermutation p) (1 : Op 2))ᴴ

/-- PDF p.32, I17: the prescribed, rather than existential, central lift. -/
def liftCentral (n l : ℕ) : Op (n + 2) :=
  ((Nat.factorial n : ℂ) /
    ((Nat.factorial (n-l) : ℂ) * (Nat.factorial (l/2) : ℂ))) • averageData (liftQ n l)

/-- PDF p.33, I21: prescribed Hamiltonian including removal of its scalar trace. -/
def liftHamiltonian {n : ℕ} (H : Op n) : Op (n + 2) :=
  registerTensor (H - (Matrix.trace H / (2 : ℂ)^n) • (1 : Op n)) (1 : Op 2) +
    ∑ r : Fin (n/2),
      (energyCoeff H (2*(r.val+1)) : ℂ) •
      (liftCentral n (2*(r.val+1)) - registerTensor (central n (2*(r.val+1))) (1 : Op 2))

/-- PDF p.34, I32: ordinary matrix commutator. -/
def comm {n : ℕ} (A B : Op n) : Op n := A * B - B * A

/-- PDF pp.34–35, I33/I36: four nested-commutator terms with their first
arguments supplied separately, allowing the source's recursive substitution. -/
def commutatorTemplate {n : ℕ} (w : Fin 6 ↪ Fin n) (F : Fin 4 → Op n) : Op n :=
  let R := fun a b : Fin 6 => heisenbergExchange (w a) (w b);
  -comm (comm (comm (comm (F 0) (R 1 2)) (R 2 3)) (R 3 4)) (R 4 0) -
    comm (comm (comm (comm (F 1) (R 2 3)) (R 3 4)) (R 4 5)) (R 5 1) -
    comm (comm (F 2) (R 1 2)) (R 1 3) + comm (comm (F 3) (R 3 4)) (R 3 5)

/-- PDF p.34, I32: the four initial exchanges used by the template. -/
def templateSeeds {n : ℕ} (w : Fin 6 ↪ Fin n) : Fin 4 → Op n :=
  ![heisenbergExchange (w 0) (w 1), heisenbergExchange (w 1) (w 2),
    heisenbergExchange (w 0) (w 2), heisenbergExchange (w 2) (w 4)]

/-- PDF p.34, I35: complementary disjoint exchanges for the four first brackets.
Each complement avoids all three wires in the first bracket. -/
def templateComplements {n : ℕ} (w : Fin 6 ↪ Fin n) : Fin 4 → Op n :=
  ![heisenbergExchange (w 3) (w 4), heisenbergExchange (w 0) (w 4),
    heisenbergExchange (w 3) (w 4), heisenbergExchange (w 0) (w 1)]

/-- PDF p.35: finite real Lie syntax in exchange generators; evaluation is skew-Hermitian. -/
inductive ExchangeExpr (n : ℕ) where
  | zero
  | generator (a b : Fin n) (distinct : a ≠ b)
  | add (a b : ExchangeExpr n)
  | scale (r : ℝ) (a : ExchangeExpr n)
  | bracket (a b : ExchangeExpr n)

/-- PDF p.35: evaluate the actual finite expression, not an unconstrained cost or label. -/
def ExchangeExpr.eval {n : ℕ} : ExchangeExpr n → Op n
  | .zero => 0
  | .generator a b _ => Complex.I • heisenbergExchange a b
  | .add a b => a.eval + b.eval
  | .scale r a => r • a.eval
  | .bracket a b => comm a.eval b.eval

/-- PDF p.33, I25: no arbitrary scalar term is included. -/
def monomialHamiltonian (n : ℕ)
    (h : (l : ℕ) → (Fin l ↪ Fin n) → ℝ) : Op n :=
  ∑ r : Fin (n/2), ∑ i : Fin (2*(r.val+1)) ↪ Fin n,
    (h (2*(r.val+1)) i : ℂ) • monomial i

/-- PDF pp.33–35: extend a partial injection to a permutation, independently of reachability.
For nonextendible input use identity; on a finite injective tuple an extension exists. -/
def extendTuple {n l : ℕ} (i : Fin l ↪ Fin n) : Equiv.Perm (Fin n) :=
  if h : ∃ p : Equiv.Perm (Fin n),
      ∀ q : Fin l, ∀ hq : q.val < n, p ⟨q.val,hq⟩ = i q then h.choose else Equiv.refl _

/-- PDF pp.33–35: prescribed lift of every tuple by permutation of the explicit Q lift. -/
def liftTuple {n l : ℕ} (i : Fin l ↪ Fin n) : Op (n+2) :=
  registerTensor (wirePermutation (extendTuple i)) (1 : Op 2) * liftQ n l *
    (registerTensor (wirePermutation (extendTuple i)) (1 : Op 2))ᴴ

/-- PDF p.35: linear extension of the prescribed lifts, with no scalar loss. -/
def liftMonomialHamiltonian (n : ℕ)
    (h : (l : ℕ) → (Fin l ↪ Fin n) → ℝ) : Op (n+2) :=
  ∑ r : Fin (n/2), ∑ i : Fin (2*(r.val+1)) ↪ Fin n,
    (h (2*(r.val+1)) i : ℂ) • liftTuple i

/-- PDF p.36: matrices whose tensor-identity lift lies in the (n+1)-qubit local Lie algebra. -/
def assistedLieSet (n k : ℕ) : Set (Op n) :=
  {A | registerTensor A (1 : Op 1) ∈ localLie (n+1) k}

/-- PDF p.36: targets admitting fixed pure ancillary input and output in V_k. -/
def OneAncillaReachable {n : ℕ} (k : ℕ) (V : Op n) : Prop :=
  ∃ (W : Op (n+1)) (eta etaOut : Vec 1), W ∈ localGroup (n+1) k ∧
    IsState eta ∧ IsState etaOut ∧
    ∀ psi : Vec n, IsState psi →
      act W (tensorState psi eta) = tensorState (act V psi) etaOut

example : spinMultiplicity 0 0 = 1 := by norm_num [spinMultiplicity]

example (n : ℕ) (r : Spin n) : spin n r = (n : ℝ)/2-r.val := by rfl

example (U : Matrix Bool Bool ℂ) (x y : Qubits 0) : QAlgorithms.Papers.Independent.Information100.P69.matrixPower U 0 x y = 1 := by
  simp [QAlgorithms.Papers.Independent.Information100.P69.matrixPower]

example (n k : ℕ) : (1 : Op n) ∈ localGroup n k := (localGroup n k).one_mem

example (n : ℕ) : phaseMap n (fun _ => 0) = 0 := by
  funext r
  simp [phaseMap]

example (n : ℕ) : ExchangeExpr.eval (ExchangeExpr.zero : ExchangeExpr n) = 0 := by rfl

example : WireSupported ∅ (1 : Op 0) := by
  refine ⟨1, ?_⟩
  intro x y
  have hxy : x = y := Subsingleton.elim _ _
  subst y
  simp

/-- Physical even body indices; PDF p.10, including l=0. -/
def ValidBody (n l : ℕ) : Prop := Even l ∧ l ≤ 2 * (n / 2)

/-- PDF p.36: the real vector space underlying the assisted tangent algebra. -/
def assistedLie (n k : ℕ) : Submodule ℝ (Op n) :=
  Submodule.span ℝ (assistedLieSet n k)

/-- The singlet adapter preserves the |01> coefficient of the frozen vector. -/
example : twoQubitSinglet (![false, true] : Qubits 2) =
    QAlgorithms.Papers.Independent.Frontier18.P14.singlet (0, 1) := by rfl

/-- PDF p.8: the single spin-zero and spin-one multiplicities on two qubits. -/
example : spinMultiplicity 2 0 = 1 ∧ spinMultiplicity 2 2 = 1 := by
  norm_num [spinMultiplicity]

/-- PDF p.30, H9 at n=m=2: B_2=C_0+C_2, fixing the tuple normalization. -/
example : permutationSumCoefficient 2 2 0 = 1 ∧ permutationSumCoefficient 2 2 2 = 1 := by
  norm_num [permutationSumCoefficient]

/-- PDF p.34: the zero exchange expression has zero bracket with any operator. -/
example (n : ℕ) (A : Op n) : comm A (0 : Op n) = 0 := by
  simp [comm]

end QAlgorithms.Papers.Independent.Advance50.P49

