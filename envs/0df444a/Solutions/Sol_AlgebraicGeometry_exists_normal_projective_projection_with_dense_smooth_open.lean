attribute [local instance] MvPolynomial.gradedAlgebra

namespace PhilipponAlterationProjection

/-- A normal projective curve-projection model with a dense affine smooth open in its source. -/
theorem exists_normal_projective_projection_with_dense_smooth_open
    (K : Type u) [Field K] [PerfectField K] {X : Scheme.{u}} [IsIntegral X]
    (π : X ⟶ Spec (.of K)) [IsProper π] (n : ℕ)
    (i : X ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K))
    [IsClosedImmersion i] (hi : i ≫ ProjSpace.π K n = π)
    (hnormalX : ∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x))
    (hdim : 1 < topologicalKrullDim X) :
    ∃ (r : ℕ) (G : Scheme.{u}) (p : G ⟶ X)
      (q : G ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) K)),
      0 < r ∧ IsIntegral G ∧ (∀ g : G, IsIntegrallyClosed (G.presheaf.stalk g)) ∧
      topologicalKrullDim G = topologicalKrullDim X ∧
      topologicalKrullDim X = ((r + 1 : ℕ) : WithBot ℕ∞) ∧
      IsProper p ∧ Surjective p ∧ IsProper q ∧ Surjective q ∧
      p ≫ π = q ≫ ProjSpace.π K r ∧
      (∃ W : G.Opens, IsAffineOpen W ∧ Nonempty W ∧ Dense (W : Set G) ∧
        Smooth (W.ι ≫ q) ∧ (∀ w : W, IsIso (p.stalkMap w.val))) ∧
      ∃ (d : ℕ)
        (k : G ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)),
        IsClosedImmersion k ∧ k ≫ ProjSpace.π K d = p ≫ π := by
  classical
  letI : Algebra K X.functionField := functionFieldAlgebra π
  obtain ⟨S, hb, hf, hsep, x, T, j, hT, hj, hTpos, hXdim, hrel, htrdeg,
    U, hU, hUdense, hne, a, ha, f, hfeq, hdom, hover,
    G, p, q, t, e, hG, hnormalG, hGdim, hp, hsurj, hq, hqsurj, ht, htdom, hpstalk,
    he, hebase, htp, htq, hbase, d, k, hk, hkbase⟩ :=
    AlgebraicGeometry.exists_normal_projective_curve_projection_model K π n i hi hnormalX hdim
  letI := hne
  letI := hG
  letI := ht
  letI := he
  obtain ⟨W, hW, hWne, hWdense, hWsm⟩ :=
    exists_dense_affine_smooth_open_of_parameter_chart K π U hU S T x hb hT hsep j hj a ha f hfeq
  letI : IsAffine (W : Scheme) := hW
  letI := hWne
  letI := hWsm
  let c : (W : Scheme) ⟶ G := W.ι ≫ t
  let V : G.Opens := c.opensRange
  have hV : IsAffineOpen V := IsAffine.of_isIso c.isoOpensRange.inv
  have hVne : Nonempty V :=
    ⟨⟨c (Classical.choice hWne), ⟨Classical.choice hWne, rfl⟩⟩⟩
  have hVdense : Dense (V : Set G) :=
    V.isOpen.dense ⟨(Classical.choice hVne).val, (Classical.choice hVne).property⟩
  have hcomp : c ≫ q =
      (W.ι ≫ f ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.rename (R := K) j).toRingHom)) ≫ e := by
    dsimp only [c]
    rw [Category.assoc, htq]
    simp only [Category.assoc]
    rfl
  haveI : Smooth (c ≫ q) := by rw [hcomp]; infer_instance
  have hsm : Smooth (V.ι ≫ q) := by
    have h : Smooth (c.isoOpensRange.inv ≫ (c ≫ q)) := inferInstance
    rwa [← Category.assoc, Scheme.Hom.isoOpensRange_inv_comp] at h
  have hstalk : ∀ v : V, IsIso (p.stalkMap v.val) := by
    intro v
    obtain ⟨w, hw⟩ := v.property
    rw [← hw]
    change IsIso (p.stalkMap (t w.val))
    exact hpstalk w.val
  exact ⟨Fintype.card T, G, p, q, hTpos, hG, hnormalG, hGdim, hXdim,
    hp, hsurj, hq, hqsurj, hbase, ⟨V, hV, hVne, hVdense, hsm, hstalk⟩,
    d, k, hk, hkbase⟩

end PhilipponAlterationProjection


theorem solution
    (K : Type u) [Field K] [PerfectField K] {X : Scheme.{u}} [IsIntegral X]
    (π : X ⟶ Spec (.of K)) [IsProper π] (n : ℕ)
    (i : X ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K))
    [IsClosedImmersion i] (hi : i ≫ ProjSpace.π K n = π)
    (hnormalX : ∀ x : X, IsIntegrallyClosed (X.presheaf.stalk x))
    (hdim : 1 < topologicalKrullDim X) :
    ∃ (r : ℕ) (G : Scheme.{u}) (p : G ⟶ X)
      (q : G ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (r + 1)) K)),
      0 < r ∧ IsIntegral G ∧ (∀ g : G, IsIntegrallyClosed (G.presheaf.stalk g)) ∧
      topologicalKrullDim G = topologicalKrullDim X ∧
      topologicalKrullDim X = ((r + 1 : ℕ) : WithBot ℕ∞) ∧
      IsProper p ∧ Surjective p ∧ IsProper q ∧ Surjective q ∧
      p ≫ π = q ≫ ProjSpace.π K r ∧
      (∃ W : G.Opens, IsAffineOpen W ∧ Nonempty W ∧ Dense (W : Set G) ∧
        Smooth (W.ι ≫ q) ∧ (∀ w : W, IsIso (p.stalkMap w.val))) ∧
      ∃ (d : ℕ)
        (k : G ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) K)),
        IsClosedImmersion k ∧ k ≫ ProjSpace.π K d = p ≫ π := by
  exact PhilipponAlterationProjection.exists_normal_projective_projection_with_dense_smooth_open K π n i hi hnormalX hdim
