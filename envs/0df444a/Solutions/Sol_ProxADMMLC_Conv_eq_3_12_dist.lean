theorem deriv_nonneg_of_min {F : ℝ → ℝ} {D t0 : ℝ} (ht0 : 0 < t0) (hF : HasDerivAt F D 0)
    (hmin : ∀ t ∈ Set.Icc (0:ℝ) t0, F 0 ≤ F t) : 0 ≤ D := by
  have h1 : IsLocalMinOn F (Set.Icc 0 t0) 0 := IsMinOn.localize (isMinOn_iff.mpr hmin)
  have hy : t0 ∈ posTangentConeAt (Set.Icc (0:ℝ) t0) 0 := by
    apply mem_posTangentConeAt_of_segment_subset
    rw [zero_add, segment_eq_Icc ht0.le]
  have h2 := h1.hasFDerivWithinAt_nonneg hF.hasFDerivAt.hasFDerivWithinAt hy
  have h3 : 0 ≤ t0 * D := h2
  by_contra h
  push Not at h
  linarith [mul_neg_of_pos_of_neg ht0 h]

/-- Conic Carathéodory: a nonnegative combination can be rewritten with a linearly
independent support. -/
theorem conic_cara {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι]
    [DecidableEq ι] (v : ι → V) : ∀ (k : ℕ) (lam : ι → ℝ),
    (Finset.univ.filter (fun i => lam i ≠ 0)).card ≤ k → (∀ i, 0 ≤ lam i) →
    ∃ μ : ι → ℝ, (∀ i, 0 ≤ μ i) ∧ ∑ i, μ i • v i = ∑ i, lam i • v i ∧
      LinearIndepOn ℝ v (↑(Finset.univ.filter (fun i => μ i ≠ 0)) : Set ι) := by
  intro k
  induction k with
  | zero =>
    intro lam hk hlam
    refine ⟨lam, hlam, rfl, ?_⟩
    have : Finset.univ.filter (fun i => lam i ≠ 0) = ∅ := Finset.card_eq_zero.mp (by omega)
    rw [this, Finset.coe_empty]
    exact linearIndepOn_empty ℝ v
  | succ k ih =>
    intro lam hk hlam
    set s := Finset.univ.filter (fun i => lam i ≠ 0) with hs
    by_cases hli : LinearIndepOn ℝ v (↑s : Set ι)
    · exact ⟨lam, hlam, rfl, hli⟩
    obtain ⟨g, hg0, j0, hj0s, hj0⟩ := not_linearIndepOn_finset_iff.mp hli
    -- a dependence supported on `s` with a positive entry
    obtain ⟨c, hcsum, hcsupp, j1, hj1⟩ : ∃ c : ι → ℝ, ∑ i, c i • v i = 0 ∧
        (∀ i, lam i = 0 → c i = 0) ∧ ∃ j, 0 < c j := by
      let c0 : ι → ℝ := fun i => if lam i ≠ 0 then g i else 0
      have hc0 : ∑ i, c0 i • v i = 0 := by
        rw [← hg0, hs, Finset.sum_filter]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [c0]
        split_ifs <;> simp
      have hc0s : ∀ i, lam i = 0 → c0 i = 0 := fun i hi => by simp [c0, hi]
      have hj0' : c0 j0 ≠ 0 := by
        have : lam j0 ≠ 0 := (Finset.mem_filter.mp hj0s).2
        simp [c0, this, hj0]
      rcases lt_or_gt_of_ne hj0' with hneg | hpos
      · refine ⟨fun i => - c0 i, ?_, fun i hi => by simp [hc0s i hi], j0, by linarith⟩
        simp only [neg_smul, Finset.sum_neg_distrib, hc0, neg_zero]
      · exact ⟨c0, hc0, hc0s, j0, hpos⟩
    set S := Finset.univ.filter (fun i => 0 < c i) with hS
    have hSne : S.Nonempty := ⟨j1, by simp [S, hj1]⟩
    obtain ⟨j, hjS, hjmin⟩ := S.exists_min_image (fun i => lam i / c i) hSne
    have hcj : 0 < c j := (Finset.mem_filter.mp hjS).2
    set τ := lam j / c j with hτ
    have hτ0 : 0 ≤ τ := div_nonneg (hlam j) hcj.le
    set lam' : ι → ℝ := fun i => lam i - τ * c i with hlam'def
    have hlam' : ∀ i, 0 ≤ lam' i := by
      intro i
      simp only [lam']
      rcases le_or_gt (c i) 0 with hci | hci
      · nlinarith [hlam i]
      · have h1 : τ ≤ lam i / c i := hjmin i (by simp [S, hci])
        have h2 : τ * c i ≤ lam i := by
          have := mul_le_mul_of_nonneg_right h1 hci.le
          rwa [div_mul_cancel₀ _ hci.ne'] at this
        linarith
    have hsum : ∑ i, lam' i • v i = ∑ i, lam i • v i := by
      simp only [lam', sub_smul, Finset.sum_sub_distrib, mul_smul, ← Finset.smul_sum, hcsum,
        smul_zero, sub_zero]
    have hcard : (Finset.univ.filter (fun i => lam' i ≠ 0)).card ≤ k := by
      have hsub : Finset.univ.filter (fun i => lam' i ≠ 0) ⊆ s.erase j := by
        intro i hi
        have hi' : lam' i ≠ 0 := (Finset.mem_filter.mp hi).2
        refine Finset.mem_erase.mpr ⟨?_, ?_⟩
        · rintro rfl
          apply hi'
          simp only [lam', τ]
          field_simp
          ring
        · refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, fun h0 => hi' ?_⟩
          simp [lam', h0, hcsupp i h0]
      have hjs : j ∈ s := by
        refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, fun h0 => ?_⟩
        have := hcsupp j h0
        linarith
      have := Finset.card_le_card hsub
      rw [Finset.card_erase_of_mem hjs] at this
      omega
    obtain ⟨μ, h1, h2, h3⟩ := ih lam' hcard hlam'
    exact ⟨μ, h1, h2.trans hsum, h3⟩

/-- The cone generated by a finite family. -/
def gcone {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι] (v : ι → V) :
    Set V :=
  {x | ∃ lam : ι → ℝ, (∀ i, 0 ≤ lam i) ∧ x = ∑ i, lam i • v i}

theorem gcone_closed {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    [FiniteDimensional ℝ V] {ι : Type*} [Fintype ι] [DecidableEq ι] (v : ι → V) :
    IsClosed (gcone v) := by
  classical
  -- the piece over a linearly independent support
  let P : Finset ι → Set V := fun t =>
    (Fintype.linearCombination ℝ (fun i : t => v i)) '' {μ | ∀ i, 0 ≤ μ i}
  have hP : ∀ t : Finset ι, LinearIndepOn ℝ v (↑t : Set ι) → IsClosed (P t) := by
    intro t ht
    have hker : LinearMap.ker (Fintype.linearCombination ℝ (fun i : t => v i)) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro g hg
      rw [Fintype.linearCombination_apply] at hg
      exact funext (Fintype.linearIndependent_iff.mp ht g hg)
    have hemb := LinearMap.isClosedEmbedding_of_injective hker
    apply hemb.isClosedMap
    have : {μ : t → ℝ | ∀ i, 0 ≤ μ i} = ⋂ i, {μ : t → ℝ | 0 ≤ μ i} := by ext; simp
    rw [this]
    exact isClosed_iInter (fun i => isClosed_le continuous_const (continuous_apply i))
  have heq : gcone v = ⋃ t ∈ (Finset.univ.filter (fun t : Finset ι =>
      LinearIndepOn ℝ v (↑t : Set ι))), P t := by
    ext x
    simp only [Set.mem_iUnion, Finset.mem_filter, Finset.mem_univ, true_and, exists_prop]
    constructor
    · rintro ⟨lam, hlam, rfl⟩
      obtain ⟨μ, hμ, hμsum, hli⟩ := conic_cara v _ lam le_rfl hlam
      refine ⟨_, hli, fun i => μ i, fun i => hμ i, ?_⟩
      rw [Fintype.linearCombination_apply, ← hμsum]
      refine (Finset.sum_coe_sort _ (fun i => μ i • v i)).trans ?_
      refine Finset.sum_filter_of_ne (fun i _ hne => ?_)
      intro h0
      exact hne (by rw [h0, zero_smul])
    · rintro ⟨t, -, μ, hμ, rfl⟩
      refine ⟨fun i => if h : i ∈ t then μ ⟨i, h⟩ else 0, fun i => ?_, ?_⟩
      · by_cases h : i ∈ t
        · simp only [h, dite_true]
          exact hμ _
        · simp [h]
      · rw [Fintype.linearCombination_apply]
        rw [← Finset.sum_subset (Finset.subset_univ t) (fun i _ hi => by simp [hi])]
        rw [← Finset.sum_coe_sort t]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp
  rw [heq]
  exact isClosed_biUnion_finset (fun t ht => hP t (Finset.mem_filter.mp ht).2)

/-- Farkas' lemma for a finite family in `ℝⁿ`. -/
theorem farkas {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι] (v : ι → E n) (g : E n) :
    (∃ lam : ι → ℝ, (∀ i, 0 ≤ lam i) ∧ g = ∑ i, lam i • v i) ∨
    ∃ d : E n, (∀ i, 0 ≤ inner ℝ (v i) d) ∧ inner ℝ g d < 0 := by
  by_cases hg : g ∈ gcone v
  · exact Or.inl hg
  right
  have hconv : Convex ℝ (gcone v) := by
    rintro x ⟨lx, hlx, rfl⟩ y ⟨ly, hly, rfl⟩ a b ha hb _
    refine ⟨fun i => a * lx i + b * ly i, fun i => by
      have := hlx i; have := hly i; positivity, ?_⟩
    simp only [Finset.smul_sum, smul_smul, ← Finset.sum_add_distrib, add_smul]
  obtain ⟨f, w, hfw, hwg⟩ := geometric_hahn_banach_closed_point hconv (gcone_closed v) hg
  have h0 : (0 : E n) ∈ gcone v := ⟨fun _ => 0, fun _ => le_rfl, by simp⟩
  have hw : 0 < w := by simpa using hfw 0 h0
  have hfv : ∀ i, f (v i) ≤ 0 := by
    intro i
    by_contra h
    push Not at h
    have hmem : (w / f (v i)) • v i ∈ gcone v := by
      refine ⟨fun j => if j = i then w / f (v i) else 0, fun j => ?_, ?_⟩
      · dsimp only
        split_ifs
        · positivity
        · exact le_rfl
      · simp
    have := hfw _ hmem
    rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ h.ne'] at this
    exact lt_irrefl _ this
  refine ⟨(InnerProductSpace.toDual ℝ (E n)).symm (-f), fun i => ?_, ?_⟩
  · rw [real_inner_comm, InnerProductSpace.toDual_symm_apply]
    simpa using hfv i
  · rw [real_inner_comm, InnerProductSpace.toDual_symm_apply]
    simp only [neg_apply]
    linarith

theorem vec_eq_sum {n : ℕ} (x : E n) : x = ∑ i, x i • EuclideanSpace.single i (1:ℝ) := by
  conv_lhs => rw [← (EuclideanSpace.basisFun (Fin n) ℝ).sum_repr x]
  simp [EuclideanSpace.basisFun_apply]

theorem hd_line {n : ℕ} (x d : E n) : HasDerivAt (fun t : ℝ => x + t • d) d 0 := by
  simpa using ((hasDerivAt_id (0:ℝ)).smul_const d).const_add x

theorem hd_f {n : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) (x d : E n) :
    HasDerivAt (fun t : ℝ => f (x + t • d)) (inner ℝ (gradient f x) d) 0 := by
  have h0 : HasFDerivAt f (InnerProductSpace.toDual ℝ (E n) (gradient f x))
      ((fun t : ℝ => x + t • d) 0) := by
    simp only [zero_smul, add_zero]
    exact (hdiff x).hasGradientAt.hasFDerivAt
  exact h0.comp_hasDerivAt (0:ℝ) (hd_line x d)

theorem hd_norm {n : ℕ} (x d z : E n) :
    HasDerivAt (fun t : ℝ => ‖x + t • d - z‖ ^ 2) (2 * inner ℝ (x - z) d) 0 := by
  have := ((hd_line x d).sub_const z).norm_sq
  simpa using this

theorem hd_A {n m : ℕ} (A : E n →L[ℝ] E m) (b : E m) (x d : E n) :
    HasDerivAt (fun t : ℝ => A (x + t • d) - b) (A d) 0 := by
  have := (A.hasFDerivAt.comp_hasDerivAt (0:ℝ) (hd_line x d)).sub_const b
  exact this

theorem hd_K {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) (A : E n →L[ℝ] E m)
    (b : E m) (Γ p : ℝ) (x d z : E n) (y : E m) :
    HasDerivAt (fun t : ℝ => K f A b Γ p (x + t • d) z y)
      (inner ℝ (gradient f x) d + inner ℝ y (A d) + Γ * inner ℝ (A x - b) (A d)
        + p * inner ℝ (x - z) d) 0 := by
  have h1 := hd_f hdiff x d
  have h2 : HasDerivAt (fun t : ℝ => inner ℝ y (A (x + t • d) - b)) (inner ℝ y (A d)) 0 := by
    have := (innerSL ℝ y).hasFDerivAt.comp_hasDerivAt (0:ℝ) (hd_A A b x d)
    exact this
  have h3 := (hd_A A b x d).norm_sq
  have h4 := hd_norm x d z
  have := ((h1.add h2).add (h3.const_mul (Γ / 2))).add (h4.const_mul (p / 2))
  unfold K
  convert this using 1
  all_goals first
    | rfl
    | (simp only [zero_smul, add_zero]; ring)

theorem coord_ev {a l r d : ℝ} (hl : l ≤ a) (hr : a ≤ r)
    (hdl : a = l → 0 ≤ d) (hdr : a = r → d ≤ 0) :
    ∀ᶠ t in nhdsWithin (0:ℝ) (Set.Ioi 0), l ≤ a + t * d ∧ a + t * d ≤ r := by
  have hc : Continuous (fun t : ℝ => a + t * d) := by fun_prop
  have ht := hc.tendsto 0
  rw [zero_mul, add_zero] at ht
  have hpos : ∀ᶠ t in nhdsWithin (0:ℝ) (Set.Ioi 0), 0 < t := self_mem_nhdsWithin
  refine Filter.Eventually.and ?_ ?_
  · rcases hl.lt_or_eq with h | h
    · exact ((ht.eventually (lt_mem_nhds h)).filter_mono nhdsWithin_le_nhds).mono
        (fun t ht => ht.le)
    · have hd := hdl h.symm
      exact hpos.mono (fun t htp => by rw [← h]; linarith [mul_nonneg htp.le hd])
  · rcases hr.lt_or_eq with h | h
    · exact ((ht.eventually (gt_mem_nhds h)).filter_mono nhdsWithin_le_nhds).mono
        (fun t ht => ht.le)
    · have hd := hdr h
      exact hpos.mono (fun t htp => by rw [h]; linarith [mul_nonpos_of_nonneg_of_nonpos htp.le hd])

theorem ystar_nonempty {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m)
    (ℓ u : Fin n → ℝ) (hdiff : Differentiable ℝ f) (p : ℝ)
    (xst : E n → E n) (hxst : IsXStarSel f A b ℓ u p xst) (z : E n) :
    (Ystar f A ℓ u p xst z).Nonempty := by
  classical
  obtain ⟨⟨hxbox, hxA⟩, hxmin⟩ := hxst z
  set x := xst z with hx
  set G : E n := gradient f x + p • (x - z) with hG
  let v1 : Fin m → E n := fun j => (ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1)
  let v2 : Fin m → E n := fun j => -(ContinuousLinearMap.adjoint A) (EuclideanSpace.single j 1)
  let v3 : Fin n → E n := fun i => if x i = ℓ i then EuclideanSpace.single i 1 else 0
  let v4 : Fin n → E n := fun i => if x i = u i then -EuclideanSpace.single i 1 else 0
  let v := Sum.elim (Sum.elim v1 v2) (Sum.elim v3 v4)
  rcases farkas v G with ⟨lam, hlam, hGsum⟩ | ⟨d, hd, hGd⟩
  · let c : Fin n → ℝ := fun i => if x i = ℓ i then lam (Sum.inr (Sum.inl i)) else 0
    let c' : Fin n → ℝ := fun i => if x i = u i then lam (Sum.inr (Sum.inr i)) else 0
    let S : E n := ∑ j, (lam (Sum.inl (Sum.inl j)) - lam (Sum.inl (Sum.inr j))) • v1 j
    have hS : (ContinuousLinearMap.adjoint A) (∑ j, (lam (Sum.inl (Sum.inr j))
        - lam (Sum.inl (Sum.inl j))) • EuclideanSpace.single j (1:ℝ)) = -S := by
      rw [map_sum, ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_smul]
      simp only [v1]
      module
    have hkey : G = S + WithLp.toLp 2 c - WithLp.toLp 2 c' := by
      rw [hGsum, Fintype.sum_sum_type, Fintype.sum_sum_type, Fintype.sum_sum_type]
      simp only [v, Sum.elim_inl, Sum.elim_inr]
      rw [vec_eq_sum (WithLp.toLp 2 c), vec_eq_sum (WithLp.toLp 2 c')]
      have e12 : ∑ j, lam (Sum.inl (Sum.inl j)) • v1 j + ∑ j, lam (Sum.inl (Sum.inr j)) • v2 j
          = S := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        simp only [v2, v1]
        module
      have e3 : ∑ i, lam (Sum.inr (Sum.inl i)) • v3 i
          = ∑ i, (WithLp.toLp 2 c : E n) i • EuclideanSpace.single i (1:ℝ) := by
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [v3, c, PiLp.toLp_apply]
        split_ifs <;> simp
      have e4 : ∑ i, lam (Sum.inr (Sum.inr i)) • v4 i
          = -∑ i, (WithLp.toLp 2 c' : E n) i • EuclideanSpace.single i (1:ℝ) := by
        rw [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [v4, c', PiLp.toLp_apply]
        split_ifs <;> simp
      rw [e12, e3, e4]
      abel
    refine ⟨∑ j, (lam (Sum.inl (Sum.inr j)) - lam (Sum.inl (Sum.inl j))) •
      EuclideanSpace.single j (1:ℝ), WithLp.toLp 2 c, WithLp.toLp 2 c', ?_, ?_, ?_, ?_⟩
    · rw [← hG, hS, hkey]
      abel
    · intro i
      simp only [c, c']
      constructor
      · split_ifs
        · exact hlam _
        · exact le_rfl
      · split_ifs
        · exact hlam _
        · exact le_rfl
    · intro i
      simp only [c]
      split_ifs with h
      · rw [← hx, h]; ring
      · ring
    · intro i
      simp only [c']
      split_ifs with h
      · rw [← hx, h]; ring
      · ring
  · exfalso
    have hAd : A d = 0 := by
      ext j
      have h1 := hd (Sum.inl (Sum.inl j))
      have h2 := hd (Sum.inl (Sum.inr j))
      simp only [v, v1, v2, Sum.elim_inl, Sum.elim_inr, inner_neg_left,
        ContinuousLinearMap.adjoint_inner_left, EuclideanSpace.inner_single_left, map_one,
        one_mul] at h1 h2
      simp only [PiLp.zero_apply]
      linarith
    have hdl : ∀ i, x i = ℓ i → 0 ≤ d i := by
      intro i hi
      have h := hd (Sum.inr (Sum.inl i))
      simpa [v, v3, hi, EuclideanSpace.inner_single_left] using h
    have hdu : ∀ i, x i = u i → d i ≤ 0 := by
      intro i hi
      have h := hd (Sum.inr (Sum.inr i))
      simpa [v, v4, hi, EuclideanSpace.inner_single_left] using h
    have hev : ∀ᶠ t in nhdsWithin (0:ℝ) (Set.Ioi 0),
        0 < t ∧ ∀ i, ℓ i ≤ x i + t * d i ∧ x i + t * d i ≤ u i :=
      (show ∀ᶠ t in nhdsWithin (0:ℝ) (Set.Ioi 0), 0 < t from self_mem_nhdsWithin).and
        (Filter.eventually_all.mpr
        (fun i => coord_ev (hxbox i).1 (hxbox i).2 (hdl i) (hdu i)))
    obtain ⟨t0, ht0, ht0box⟩ := hev.exists
    have hfeas : ∀ t ∈ Set.Icc (0:ℝ) t0, x + t • d ∈ feas A b ℓ u := by
      rintro t ⟨ht1, ht2⟩
      refine ⟨fun i => ?_, ?_⟩
      · simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
        obtain ⟨h1, h2⟩ := ht0box i
        have h3 := hxbox i
        rcases le_or_gt 0 (d i) with hdi | hdi
        · have : t * d i ≤ t0 * d i := mul_le_mul_of_nonneg_right ht2 hdi
          have h4 := mul_nonneg ht1 hdi
          constructor <;> linarith [h3.1, h3.2]
        · have : t0 * d i ≤ t * d i := mul_le_mul_of_nonpos_right ht2 hdi.le
          have h4 := mul_nonpos_of_nonneg_of_nonpos ht1 hdi.le
          constructor <;> linarith [h3.1, h3.2]
      · show A (x + t • d) = b
        rw [map_add, map_smul, hAd, smul_zero, add_zero]
        exact hxA
    have hmin : ∀ t ∈ Set.Icc (0:ℝ) t0,
        (fun t : ℝ => f (x + t • d) + p / 2 * ‖x + t • d - z‖ ^ 2) 0 ≤
        (fun t : ℝ => f (x + t • d) + p / 2 * ‖x + t • d - z‖ ^ 2) t := by
      intro t ht
      simp only [zero_smul, add_zero]
      exact hxmin _ (hfeas t ht)
    have hder := (hd_f hdiff x d).add ((hd_norm x d z).const_mul (p / 2))
    have h0 := deriv_nonneg_of_min ht0 hder hmin
    have hGd' : inner ℝ G d = inner ℝ (gradient f x) d + p / 2 * (2 * inner ℝ (x - z) d) := by
      rw [hG, inner_add_left, real_inner_smul_left]
      ring
    linarith

theorem box_seg {n : ℕ} {ℓ u : Fin n → ℝ} {x x' : E n} (hx : x ∈ box ℓ u)
    (hx' : x' ∈ box ℓ u) {t : ℝ} (ht : t ∈ Set.Icc (0:ℝ) 1) : x + t • (x' - x) ∈ box ℓ u := by
  intro i
  simp only [PiLp.add_apply, PiLp.smul_apply, PiLp.sub_apply, smul_eq_mul]
  obtain ⟨h1, h2⟩ := hx i
  obtain ⟨h3, h4⟩ := hx' i
  obtain ⟨ht0, ht1⟩ := ht
  have a1 := mul_nonneg (sub_nonneg.mpr ht1) (sub_nonneg.mpr h1)
  have a2 := mul_nonneg ht0 (sub_nonneg.mpr h3)
  have a3 := mul_nonneg (sub_nonneg.mpr ht1) (sub_nonneg.mpr h2)
  have a4 := mul_nonneg ht0 (sub_nonneg.mpr h4)
  constructor <;> nlinarith

theorem vi_xs {n m : ℕ} {f : E n → ℝ} (hdiff : Differentiable ℝ f) {A : E n →L[ℝ] E m}
    {b : E m} {ℓ u : Fin n → ℝ} {Γ p : ℝ} {xs : E m → E n → E n}
    (hxs : IsXSel f A b ℓ u Γ p xs) (y : E m) (z x' : E n) (hx' : x' ∈ box ℓ u) :
    0 ≤ inner ℝ (gradient f (xs y z)) (x' - xs y z) + inner ℝ y (A (x' - xs y z))
      + Γ * inner ℝ (A (xs y z) - b) (A (x' - xs y z))
      + p * inner ℝ (xs y z - z) (x' - xs y z) := by
  obtain ⟨hbox, hmin⟩ := hxs y z
  refine deriv_nonneg_of_min one_pos (hd_K hdiff A b Γ p (xs y z) (x' - xs y z) z y) ?_
  intro t ht
  simp only [zero_smul, add_zero]
  exact hmin _ (box_seg hbox hx' ht)

end E312Aux

open ProxADMMLC.Conv in
theorem solution {n m : ℕ} (f : E n → ℝ) (A : E n →L[ℝ] E m) (b : E m) (ℓ u : Fin n → ℝ)
    (hℓu : ∀ i, ℓ i < u i) (L : ℝ) (hf : Assump22c f ℓ u L) (γ : ℝ)
    (hγ : MonoConst f ℓ u γ) (Γ p : ℝ) (hΓ : 0 < Γ) (hp : 0 < p) (hpγ : -γ < p)
    (xs : E m → E n → E n) (hxs : IsXSel f A b ℓ u Γ p xs)
    (xst : E n → E n) (hxst : IsXStarSel f A b ℓ u p xst) :
    ∀ z ∈ box ℓ u, ∀ y : E m,
      (p + γ) * ‖xs y z - xst z‖ ≤ ‖A‖ * Metric.infDist y (Ystar f A ℓ u p xst z) := by
  intro z _ y
  have hbound : ∀ w ∈ Ystar f A ℓ u p xst z,
      (p + γ) * ‖xs y z - xst z‖ ≤ ‖A‖ * dist y w := by
    rintro w ⟨μ, ν, heq, hnn, hcμ, hcν⟩
    obtain ⟨⟨hxbox, hxA⟩, -⟩ := hxst z
    obtain ⟨hxhbox, -⟩ := hxs y z
    have hvi := E312Aux.vi_xs hf.1 hxs y z (xst z) hxbox
    set xh := xs y z with hxh
    set xt := xst z with hxt
    set e := xh - xt with he
    have hvi2 : 0 ≤ inner ℝ (gradient f xt) e + p * inner ℝ (xt - z) e + inner ℝ w (A e) := by
      have h1 : gradient f xt + p • (xt - z) + (ContinuousLinearMap.adjoint A) w = μ - ν := by
        rw [← sub_eq_zero, ← heq]
        abel
      have h2 : 0 ≤ inner ℝ (μ - ν) e := by
        rw [PiLp.inner_apply]
        apply Finset.sum_nonneg
        intro i _
        simp only [he, PiLp.sub_apply, RCLike.inner_apply, conj_trivial]
        have hb := hxhbox i
        have k1 := mul_nonneg (hnn i).1 (sub_nonneg.mpr hb.1)
        have k2 := mul_nonneg (hnn i).2 (sub_nonneg.mpr hb.2)
        have k3 := hcμ i
        have k4 := hcν i
        nlinarith
      have h3 : inner ℝ (gradient f xt + p • (xt - z) + (ContinuousLinearMap.adjoint A) w) e
          = inner ℝ (gradient f xt) e + p * inner ℝ (xt - z) e + inner ℝ w (A e) := by
        rw [inner_add_left, inner_add_left, real_inner_smul_left,
          ContinuousLinearMap.adjoint_inner_left]
      rw [h1] at h3
      linarith
    have hmono := hγ xh hxhbox xt hxbox
    have hneg : xt - xh = -e := by rw [he, neg_sub]
    have hAe : A xh - b = A e := by rw [he, map_sub, hxA]
    have hz : xh - z = (xt - z) + e := by rw [he]; abel
    rw [hneg, hAe, hz, map_neg, inner_neg_right, inner_neg_right, inner_neg_right,
      inner_neg_right, inner_add_left] at hvi
    rw [inner_sub_left, ← he] at hmono
    have hsq1 : inner ℝ (A e) (A e) = ‖A e‖ ^ 2 := real_inner_self_eq_norm_sq _
    have hsq2 : inner ℝ e e = ‖e‖ ^ 2 := real_inner_self_eq_norm_sq _
    have hcs : -(inner ℝ (y - w) (A e)) ≤ ‖y - w‖ * ‖A e‖ := by
      have := abs_real_inner_le_norm (y - w) (A e)
      have := neg_abs_le (inner ℝ (y - w) (A e))
      linarith
    have hyw : inner ℝ (y - w) (A e) = inner ℝ y (A e) - inner ℝ w (A e) := inner_sub_left _ _ _
    have hop : ‖A e‖ ≤ ‖A‖ * ‖e‖ := A.le_opNorm e
    have hAe2 : 0 ≤ ‖A e‖ ^ 2 := sq_nonneg _
    have hfin : (p + γ) * ‖e‖ ^ 2 ≤ ‖y - w‖ * (‖A‖ * ‖e‖) := by
      have := mul_le_mul_of_nonneg_left hop (norm_nonneg (y - w))
      nlinarith
    rw [dist_eq_norm]
    rcases (norm_nonneg e).eq_or_lt with h0 | hpos
    · rw [← h0, mul_zero]
      exact mul_nonneg (norm_nonneg _) (norm_nonneg _)
    · refine le_of_mul_le_mul_right ?_ hpos
      linear_combination hfin
  have hne := E312Aux.ystar_nonempty f A b ℓ u hf.1 p xst hxst z
  rcases (norm_nonneg A).eq_or_lt with hA0 | hApos
  · obtain ⟨w, hw⟩ := hne
    have := hbound w hw
    rw [← hA0, zero_mul] at this ⊢
    exact this
  · have hle : (p + γ) * ‖xs y z - xst z‖ / ‖A‖ ≤ Metric.infDist y (Ystar f A ℓ u p xst z) := by
      refine (Metric.le_infDist hne).mpr (fun w hw => ?_)
      rw [div_le_iff₀ hApos]
      linarith [hbound w hw]
    calc (p + γ) * ‖xs y z - xst z‖ = ‖A‖ * ((p + γ) * ‖xs y z - xst z‖ / ‖A‖) := by
          field_simp
      _ ≤ ‖A‖ * Metric.infDist y (Ystar f A ℓ u p xst z) :=
          mul_le_mul_of_nonneg_left hle hApos.le
