-- Source module: Solutions.KFMChain
/-!
# KFM: the error chain per call

Every procedure of the assembly is specified per call (`LineNeed`, `ChirpNeedR`): its output is
some list within the error bound, possibly depending on the machine state. So the chain is
assembled from the bounds at the actual call points:

* **`source_call`**: one source transform `U = 2^γ ṽ` from the computed `A`-lines output `w`,
  chirp output `c = C̃(w)` (any `M̃r` with the Prop 18 bound) and `B₀`-lines output `ṽ`:
  `‖U − R F_s u‖ ≤ 2^γ (εA + (Er + 22) + εB) hp` (`R F_s = 2^γ B₀ Q F_t A`, Lemma 20).
* **`final_call3`**: with three such values `U ≈ RF u`, `V ≈ RF v`, `Z ≈ RF(conj Q_p(UV))`,
  `‖2^{2b+4} S (S · conj Z_j) − (ū ∗ v̄)_j‖ < 1/2` for every `j` (`pipeline_err3` +
  `final_exact`).
-/

namespace NLogN.KFM

open Complex IntMul.OpenAI.RT IntMul.OpenAI.RC NLogN.KFZ

noncomputable section

variable {D : ℕ}

/-- **The final bound**, from three per-call source transforms. -/
theorem final_call3_sol_aux (p b : ℕ) (s t : Fin (D + 1) → ℕ) [∀ i, NeZero (s i)]
    (hcop : ∀ i, Nat.Coprime (s i) (t i)) (Es : ℝ)
    (hEs : Es * hp p ≤ 1 / 100)
    (hB2 : 2 * (2 : ℝ) ^ (2 * b + 4) * (∏ i, (s i : ℝ)) ^ 2 * (3 * Es + 2) * hp p < 1)
    {ubar vbar : ((i : Fin (D + 1)) → ZMod (s i)) → ℂ}
    (hu1 : ‖(fun k => (2 : ℂ)⁻¹ ^ (b + 2) * ubar k)‖ ≤ 1 / 4)
    (hv1 : ‖(fun k => (2 : ℂ)⁻¹ ^ (b + 2) * vbar k)‖ ≤ 1 / 4)
    {U V Z : ((i : Fin (D + 1)) → ZMod (s i)) → ℂ}
    (hU : ‖U - Rperm s t (dftM s (fun k => (2 : ℂ)⁻¹ ^ (b + 2) * ubar k))‖ ≤ Es * hp p)
    (hV : ‖V - Rperm s t (dftM s (fun k => (2 : ℂ)⁻¹ ^ (b + 2) * vbar k))‖ ≤ Es * hp p)
    (hZ : ‖Z - Rperm s t (dftM s (cnj (QA p (U * V))))‖ ≤ Es * hp p) :
    Grid p (QA p (U * V)) ∧ ‖QA p (U * V)‖ ≤ 1 / 2 ∧
    ∀ j, ‖(2 : ℂ) ^ (2 * b + 4) * ((∏ i, (s i : ℝ) : ℝ) : ℂ) *
      (((∏ i, (s i : ℝ) : ℝ) : ℂ) * cnj Z j) - cconv s ubar vbar j‖ < 1 / 2 := by
  have h0 := hp_pos p
  obtain ⟨g1, n1, e3⟩ := pipeline_err3 p (linC_RF s t) Es hEs hu1 hv1 hU hV hZ
  refine ⟨g1, n1, fun j => ?_⟩
  set S : ℝ := ∏ i, (s i : ℝ)
  have hS0 : 0 ≤ S := by positivity
  have hc := final_exact s t hcop b ubar vbar j
  have hSc : ((S : ℝ) : ℂ) = ∏ i, (s i : ℂ) := by simp [S]
  rw [hSc, ← hc]
  set G := cnj (Rperm s t (dftM s (cnj (Rperm s t (dftM s (fun k => (2 : ℂ)⁻¹ ^ (b + 2) * ubar k)) *
    Rperm s t (dftM s (fun k => (2 : ℂ)⁻¹ ^ (b + 2) * vbar k))))))
  have e1 : (2 : ℂ) ^ (2 * b + 4) * (∏ i, (s i : ℂ)) * ((∏ i, (s i : ℂ)) * cnj Z j) -
      (2 : ℂ) ^ (2 * b + 4) * (∏ i, (s i : ℂ)) * ((∏ i, (s i : ℂ)) * G j) =
      ((2 : ℂ) ^ (2 * b + 4) * ((S : ℝ) : ℂ) * ((S : ℝ) : ℂ)) * (cnj Z - G) j := by
    rw [hSc]; simp only [Pi.sub_apply]; ring
  rw [e1, norm_mul]
  have n2 : ‖(2 : ℂ) ^ (2 * b + 4) * ((S : ℝ) : ℂ) * ((S : ℝ) : ℂ)‖ =
      (2 : ℝ) ^ (2 * b + 4) * S ^ 2 := by
    rw [norm_mul, norm_mul, norm_pow, Complex.norm_ofNat, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hS0]; ring
  rw [n2]
  have hj := (norm_le_pi_norm (cnj Z - G) j).trans e3
  have hpos : 0 ≤ (2 : ℝ) ^ (2 * b + 4) * S ^ 2 := by positivity
  calc (2 : ℝ) ^ (2 * b + 4) * S ^ 2 * ‖(cnj Z - G) j‖
      ≤ (2 : ℝ) ^ (2 * b + 4) * S ^ 2 * ((3 * Es + 2) * hp p) :=
        mul_le_mul_of_nonneg_left hj hpos
    _ = (2 * (2 : ℝ) ^ (2 * b + 4) * S ^ 2 * (3 * Es + 2) * hp p) / 2 := by ring
    _ < 1 / 2 := by linarith

end

end NLogN.KFM

end

