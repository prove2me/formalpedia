  have stop (t : Memory ℚ) (ht : I keys.length t) : (Cond.addrLT 16 17).test t=false ∧ ∀ a,P (t.data a) := by
    exact ⟨by simp [Cond.test,ht.counter,(ht.keep 17 (by simp [ScanKeep])).trans h17],ht.safe⟩
