  set 𝔭₀ : Ideal P₀.B₀ := RingHom.ker ι.toRingHom with h𝔭₀
  set S : Subalgebra A P₀.B₀ := Algebra.adjoin A ({P₀.j₀} : Set P₀.B₀) with hSdef
