-- url     : https://prove2.me/theorems/9240a554-d735-4588-98bc-8cd4139891ec
-- title:
--   §4 — entropy in bits given a σ-algebra, the information CDF $f_X$, $df_X$ and total variation
-- statement:
--   Let $(\Omega,\mathcal F,P)$ be a probability space, $X$ a finite-valued random variable and $\mathcal G\subseteq\mathcal F$ a sub-σ-algebra. With $\eta(x)=-x\log x$ and $\eta(0)=0$, the **Shannon entropy** in bits and the **conditional entropy** in bits are
--
--   $$H(X)=\frac1{\log2}\sum_b\eta\bigl(P(X=b)\bigr),\qquad H(X\mid\mathcal G)=\frac1{\log2}\,\mathbb E\Bigl[\sum_b\eta\bigl(P(X=b\mid\mathcal G)\bigr)\Bigr],$$
--
--   where $P(X=b\mid\mathcal G)$ is the conditional expectation of the indicator of $\{X=b\}$. The **mutual information** is $I(X;\mathcal G)=H(X)-H(X\mid\mathcal G)$.
--
--   Given sources $Z_1,\dots,Z_k$ in the fixed order of $K$, let $Z_{[j]}$ be the σ-algebra generated by the first $j$ of them, the trivial one for $j=0$. The **information CDF** of $X$ is
--
--   $$f_X(j)=I(X;Z_{[j]}),$$
--
--   and its increments are $df_X(\{j\})=f_X(j)-f_X(j-1)$. The **total variation norm** of a signed measure $\mu$ on a finite set $K$ is
--
--   $$\|\mu\|_{TV}=\frac12\sum_{j\in K}\bigl|\mu(\{j\})\bigr|.$$
--
--   An **unbiased sign** is a random variable with values in $\{+1,-1\}$ and $P(X=1)=\tfrac12$.
--
--   These objects turn each player's output into a distribution on the sources, which the paper's proof compares across edges.
--
--   **Formalization Note** Conditional probabilities are Mathlib conditional expectations, so no standard Borel assumption is made on the sources. The sums over values are `finsum`s: a value outside the range of $X$ contributes exactly $0$, so the sum is finite when the range of $X$ is finite, which every statement of the mission assumes or implies (`finsum` would return $0$ for infinite support). The integrand of $H(X\mid\mathcal G)$ is bounded, because conditional probabilities lie in $[0,1]$ almost surely. Measures on $K$ are real vectors. Index $j$ of `Fin k` holds $f_X(j+1)-f_X(j)$, which is the source's $df_X(\{j+1\})$.
-- source:
--   Peretz and Kraizberg, Entropy Bounds for Local Coordination and Graph Amenability, STOC 2027 submission #272, §4, pp. 10–11 (entropy in bits, mutual information, f_X, df_X, total variation norm; unbiased signs as in Lemma 4.1).

import Mathlib
import Definitions.Def_EntropyLocalCoord_Leader_Model

open MeasureTheory ProbabilityTheory

namespace EntropyLocalCoord.Leader

variable {Ω β : Type*}

/-- The conditional probability `P(X = b | m)`, as the conditional expectation of the indicator
of `{X = b}` given the sub-σ-algebra `m`. -/
noncomputable def condProb (m : MeasurableSpace Ω) {mΩ : MeasurableSpace Ω} (P : Measure Ω)
    (X : Ω → β) (b : β) : Ω → ℝ :=
  P[(X ⁻¹' {b}).indicator (fun _ => (1 : ℝ)) | m]

/-- The Shannon entropy `H(X)` in bits of a finite-valued `X`. Values outside the range of `X`
contribute `0`, so for finite-valued `X` the `finsum` is a finite sum; every statement of this
mission that uses it assumes that the range of `X` is finite. -/
noncomputable def entropy {mΩ : MeasurableSpace Ω} (P : Measure Ω) (X : Ω → β) : ℝ :=
  (∑ᶠ b, Real.negMulLog (P.real (X ⁻¹' {b}))) / Real.log 2

/-- The conditional Shannon entropy `H(X | m)` in bits of a finite-valued `X` given an arbitrary
sub-σ-algebra `m`: the expected entropy of the conditional law of `X`. -/
noncomputable def condEntropy (m : MeasurableSpace Ω) {mΩ : MeasurableSpace Ω} (P : Measure Ω)
    (X : Ω → β) : ℝ :=
  (∫ ω, ∑ᶠ b, Real.negMulLog (condProb m P X b ω) ∂P) / Real.log 2

/-- The mutual information `I(X; m) = H(X) - H(X | m)` between `X` and the information `m`. -/
noncomputable def mutualInfo (m : MeasurableSpace Ω) {mΩ : MeasurableSpace Ω} (P : Measure Ω)
    (X : Ω → β) : ℝ :=
  entropy P X - condEntropy m P X

/-- The σ-algebra of `Z_[j]`, generated by the first `j` sources of `Fin k` in its order. -/
abbrev prefixSigma {k : ℕ} {α : Fin k → Type*} [∀ l, MeasurableSpace (α l)]
    (Z : ∀ l, Ω → α l) (j : ℕ) : MeasurableSpace Ω :=
  sourceSigma Z (Finset.univ.filter (fun l => (l : ℕ) < j))

/-- The information CDF `f_X(j) = I(X; Z_[j])` (§4, p. 10). -/
noncomputable def infoCDF {mΩ : MeasurableSpace Ω} {k : ℕ} {α : Fin k → Type*}
    [∀ l, MeasurableSpace (α l)] (P : Measure Ω) (Z : ∀ l, Ω → α l) (X : Ω → β) (j : ℕ) : ℝ :=
  mutualInfo (prefixSigma Z j) P X

/-- The information increments `df_X`. The source's `df_X({j}) = f_X(j) - f_X(j - 1)`, for
`j ∈ {1, …, k}`, is the entry at index `j - 1` of `Fin k`. -/
noncomputable def infoMeasure {mΩ : MeasurableSpace Ω} {k : ℕ} {α : Fin k → Type*}
    [∀ l, MeasurableSpace (α l)] (P : Measure Ω) (Z : ∀ l, Ω → α l) (X : Ω → β) (j : Fin k) : ℝ :=
  infoCDF P Z X ((j : ℕ) + 1) - infoCDF P Z X (j : ℕ)

/-- The total variation norm `‖μ‖_TV = ½ ∑_j |μ({j})|` of a signed measure on a finite set
(§4, p. 11). -/
noncomputable def tvNorm {K : Type*} [Fintype K] (μ : K → ℝ) : ℝ :=
  (1 / 2) * ∑ j, |μ j|

/-- An unbiased sign: values in `{+1, -1}` and `P(X = 1) = ½`. -/
def IsUnbiasedSign {mΩ : MeasurableSpace Ω} (P : Measure Ω) (X : Ω → ℝ) : Prop :=
  (∀ ω, X ω = 1 ∨ X ω = -1) ∧ P.real {ω | X ω = 1} = 1 / 2

end EntropyLocalCoord.Leader


