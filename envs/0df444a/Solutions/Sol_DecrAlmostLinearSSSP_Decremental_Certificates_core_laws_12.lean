lemma register_even (N : ℕ) : evenRegisters (registerCode N) = true := by rfl
lemma register_eval (b : Core) (N : ℕ) (p : Program) :
    ∃ cost t, Eval (registerCode N) (data (initialMachine p b.input)) cost t ∧
      cost ≤ 80000*(N+1)*b.input.size+4*⌈32*logarithm2 (b.input.size+1)/b.input.accuracy⌉₊+86 ∧
      InputCapture.Captured b.input t ∧ CoreParameters.Values b (computableCutQuality N (2*b.input.size)) t ∧
      CoreControl.Layout b (b.input.n+3*b.input.k+2) t ∧ t.natReg 546 = 0 ∧ t.natReg 550 = 0 ∧
      t.natReg 650 = 1 ∧ t.realReg 520 = -1/(4*computableCutQuality N (2*b.input.size)) ∧
      t.natMem = (initialMachine p b.input).natMem ∧ t.realMem = (initialMachine p b.input).realMem ∧
      (∀ j, t.natReg (shadowReg j) = 0 ∧ t.realReg (shadowReg j) = 0) := by
  let s := data (initialMachine p b.input)
  let u := InputCapture.result s
  have hu := InputCapture.eval_code s
  have hc : InputCapture.Captured b.input u := InputCapture.captures_initial p b.input
  have hm : 2 ≤ b.input.size := b.two.trans b.valid.1
  obtain ⟨v,cv,hv,hvc,hvK,hcv,hvr,hvn⟩ := CoreQuality.eval_code N b.input hm u hc
  obtain ⟨w,cw,hw,hwc,hwp,hcw,hwr,hwn⟩ := CoreParameters.eval_code b _ v hvc hvK
  let t := CoreControl.result w
  have ht := CoreControl.eval_code w
  have htvals := CoreControl.values b _ (b.input.n+3*b.input.k+2) w hwc hwc.base hwp
  have he : Eval (registerCode N) s (19+(cv+(cw+19))) t := Eval.seq hu (Eval.seq hv (Eval.seq hw ht))
  have hum := hu.no_memory InputCapture.no_memory
  have htm := ht.no_memory CoreControl.no_memory
  refine ⟨19+(cv+(cw+19)),t,he,by omega,CoreControl.captured b w hwc,
    CoreControl.parameters b _ w hwp,htvals.1,htvals.2.1,htvals.2.2.1,htvals.2.2.2.1,htvals.2.2.2.2,
    htm.2.trans (hwn.trans (hvn.trans hum.2)),htm.1.trans (hwr.trans (hvr.trans hum.1)),?_⟩
  intro j
  have hodd : shadowReg j%2 = 1 := by simp [shadowReg]
  have hf := evenRegisters_frames _ (register_even N) (shadowReg j) hodd
  rw [he.nat_frame hf.1,he.real_frame hf.2]
  have hbig : 9 ≤ shadowReg j := by dsimp [shadowReg];omega
  simp [s,data,initialMachine,show shadowReg j ≠ 0 by omega,show shadowReg j ≠ 1 by omega,
    show shadowReg j ≠ 2 by omega,show shadowReg j ≠ 3 by omega,show shadowReg j ≠ 4 by omega]
