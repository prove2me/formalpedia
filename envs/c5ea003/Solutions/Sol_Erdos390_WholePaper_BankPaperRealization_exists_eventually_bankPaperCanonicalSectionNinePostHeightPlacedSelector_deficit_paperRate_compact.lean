    exact_mod_cast (show 0 < B by omega)
  have hcoord : fourFiveRealLogCoordinate y x <
      fourFiveRealLogCoordinate y (B : Real) := by
    linarith [hx.2, huB]
  exact ⟨hx.1,
    (lt_of_fourFiveRealLogCoordinate_lt
      (y := y) (x := x) (b := (B : Real))
      hy hxpos hBpos hcoord).le⟩

