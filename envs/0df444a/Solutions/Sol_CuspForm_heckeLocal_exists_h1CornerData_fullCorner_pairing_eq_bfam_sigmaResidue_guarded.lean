    CohCarrier.corner_le_map_iDegL_one_parabolicHoms_of_parabolic_of_diamond_sub_one_mem (N * r) H₀ h₁₀ hu₀ Sp i hpar hneb
  have hdia : ∀ (σ : ↥(CongruenceSubgroup.Gamma0 (N * r))) (v : H1 (N * r) H₀ 𝒪),
