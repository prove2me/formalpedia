    groupedMass (exactPrefixNextCode default marker)
        (reweightedSeedPrefixJoint
          seedLaw G n S D projection) =
      groupedMass
        (fun point : K × ExactOutcome X Y A B n =>
          exactPrefixNextCode default marker
