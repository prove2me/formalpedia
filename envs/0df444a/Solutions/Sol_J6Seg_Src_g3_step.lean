theorem abs_nat_le {n A : ℕ} (h : n ≤ 2 ^ A) : |(n : ℤ)| ≤ 2 ^ A := by
  rw [abs_of_nonneg (by positivity)]; exact_mod_cast h

theorem lin_cost_le {σ : IState HS} {e : Ex HS} {A D : ℕ} (hl : e.Lin) (hR : RB σ A e)
    (hA : 2 ≤ A) (hp : PreT.Poly e = true) (hd : J6Seg.PreT.dg e ≤ D) :
    e.cost σ ≤ e.size * uC A D := by
  have h := Ex.cost_le_lin σ (A * D + 1) e hl (bnd_P hR hA hp hd)
  have h2 := uC_ge A D
  generalize uC A D = u at h2 ⊢
  generalize A * D = x at h h2
  rw [mul_assoc] at h
  exact h.trans (Nat.mul_le_mul_left _ (by linarith))

