variable (p : ℕ) [Fact p.Prime] (L : Type) [Field L] [CharZero L] [IsCyclotomicExtension {p} ℚ L]
  (ζ : L) (hζ : IsPrimitiveRoot ζ p) [Algebra L (AlgebraicClosure ℚ)]

