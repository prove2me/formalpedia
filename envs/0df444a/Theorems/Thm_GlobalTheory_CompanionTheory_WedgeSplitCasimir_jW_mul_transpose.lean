theorem GlobalTheory.CompanionTheory.WedgeSplitCasimir.jW_mul_transpose (n m : ℕ) (J J' : Sub n m) (s s' : Fin n) :
    (jW n m * (jW n m)ᵀ) (J, s) (J', s') =
      if s ∉ J.1 ∧ s' ∉ J'.1 ∧ insert s J.1 = insert s' J'.1 then
        (-1) ^ (J.1.filter fun a => a < s).card * (-1) ^ (J'.1.filter fun a => a < s').card else 0 := by sorry
