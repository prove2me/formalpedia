open QFS

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

@[simp] lemma QFS.coneGap_zero (v : E) (ϑ : ℝ) : coneGap v ϑ (0 : E) = 0 := by sorry
