theorem ModularCurve.IsFrickeAutFull.eq_frickeInvolutionFull {N : ℕ} [NeZero N] {σ : modularFunctionFieldFull N ≃ₐ[ℚ] modularFunctionFieldFull N} (hσ : IsFrickeAutFull N σ) : σ = frickeInvolutionFull N := by sorry
