  pr : ∃ L, st.G bPR = .int (2 ^ p) :: L
  ks : ∃ L, st.G bKs = .int (s : ℤ) :: L
  ka : ∃ L, st.G bKa = .int (sOff s (HvdH.eWidth p α) : ℤ) :: L
  kn : ∃ L, st.G bKN = .int ((s + (2 * HvdH.eWidth p α + 1) : ℕ) : ℤ) :: L
  br : ∃ L, st.G bR = .int (2 ^ p) :: L
  bn : ∃ L, st.G NLogN.AX.bN = .int (s : ℤ) :: L
