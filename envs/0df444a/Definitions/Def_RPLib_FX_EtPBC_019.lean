-- ===== S4.Def_RP_EtPBC_A_O2Sh2 =====
section

/-!
# S4-EtPBC-A, O2 M6 (O2Sh2): `Λ[W] ≅ π_* Λ_W` for a separated etale `π = W.hom` of constant degree

* `dg W`: the diagonal of `W ×_P W` (clopen: `isClopen_dg`); `dsec Λ W`: its indicator section of `Λ_W`;
* `shapφ Λ W : Λ[W] ⟶ π_* Λ_W` is the map given by `dsec` (`shapφ_taut`);
* `cval_S`: values of `Σ_a l_a · τ_a^* dsec` along a sheet;
* **`isIso_shapφ`**, **`shapIso`**: `shapφ` is an isomorphism (stalkwise: `stalk_inj`, `stalk_surj`).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.EtShap

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact.Cech
  RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.GenAlg RamanujanPetersson.EtPBC.FreeStk
  RamanujanPetersson.EtPBC.EtMV RamanujanPetersson.EtPBC.EtTr

universe u

variable {P : Scheme.{u}}

section Dg

end Dg

section Iso

variable (Λ : Type u) [CommRing Λ] (W : P.Etale) [IsSeparated W.hom]

/-- The map `Λ[W] ⟶ π_* Λ_W` given by the diagonal section. -/
def shapφ : freeSh Λ W ⟶ (push W.hom Λ).obj (unitSh Λ W.left) :=
  (freeEquiv Λ W ((push W.hom Λ).obj (unitSh Λ W.left))).symm (dsec Λ W)

theorem shapφ_taut : ((shapφ Λ W).hom.app (op W)).hom (taut Λ W) = dsec Λ W := by
  have h := freeEquiv_comp Λ W (𝟙 (freeSh Λ W)) (shapφ Λ W)
  rw [Category.id_comp] at h
  exact h.symm.trans (AddEquiv.apply_symm_apply _ _)

theorem stalk_shapφ (x : P) (a : (geomPtAt x).point.fiber.obj W) :
    (((geomPtAt x).stalkF Λ).map (shapφ Λ W)).hom (germ (freeSh Λ W) x a (taut Λ W)) =
      germ ((push W.hom Λ).obj (unitSh Λ W.left)) x a (dsec Λ W) :=
  (germ_natural (shapφ Λ W) x a (taut Λ W)).trans
    (congrArg (germ ((push W.hom Λ).obj (unitSh Λ W.left)) x a) (shapφ_taut Λ W))

theorem stalk_shapφ_freeLin (x : P) [Fintype ((geomPtAt x).point.fiber.obj W)]
    (l : (geomPtAt x).point.fiber.obj W →₀ Λ) :
    (((geomPtAt x).stalkF Λ).map (shapφ Λ W)).hom (freeLin Λ W x l) =
      ∑ a, l a • germ ((push W.hom Λ).obj (unitSh Λ W.left)) x a (dsec Λ W) := by
  rw [freeLin, Finsupp.linearCombination_apply,
    Finsupp.sum_fintype l (fun i a => a • germ (freeSh Λ W) x i (taut Λ W)) (fun _ => zero_smul _ _), map_sum]
  refine Finset.sum_congr rfl fun a _ => ?_
  exact (map_smul _ _ _).trans (congrArg (l a • ·) (stalk_shapφ Λ W x a))

end Iso

end RamanujanPetersson.EtPBC.EtShap

end

