        ((MetricCodes.johnsonSigma n w p q + 1) ^ 2 -
          MetricCodes.johnsonJ n j ^ 2)) := by
  have hjw : j < w :=
    lt_of_lt_of_le hlast (by
      unfold MetricCodes.johnsonLastDegree
      exact min_le_left _ _)
