open IntMul NLogN NLogN.KIL RS Function

theorem natZ' {x B : ℕ} (h : x < 2 ^ B) : zsz (x : ℤ) ≤ B :=
  zsz_of_le (M := x) (by simp) h

theorem len_le_flatMap {α : Type*} {l : List α} {g : α → List ℤ} {x : α} (hx : x ∈ l) :
    (g x).length ≤ (l.flatMap g).length := by
  induction l with
  | nil => simp at hx
  | cons a l ih =>
    simp only [List.flatMap_cons, List.length_append]
    rcases List.mem_cons.1 hx with rfl | h
    · omega
    · have := ih h; omega

theorem tabsT_one (T : List ℤ) : tabsT (fun _ => T) 1 = (T.length : ℤ) :: T := by
  simp [tabsT, segT]

theorem zsz_pow2 {k B : ℕ} (h : k + 1 ≤ B) : zsz ((2 : ℤ) ^ k) ≤ B := by
  have := natZ' (x := 2 ^ k) (B := B)
    ((Nat.pow_lt_pow_right (by norm_num) (by omega : k < k + 1)).trans_le
      (Nat.pow_le_pow_right (by norm_num) h))
  simpa using this

theorem flatB_length_k (k k' : ℕ) (bs : List (List ℤ × List ℤ × ℤ × ℤ)) :
    (JK.flatB k bs).length = (JK.flatB k' bs).length := by
  induction bs with
  | nil => rfl
  | cons b bs ih =>
    simp only [JK.flatB, List.flatMap_cons, List.length_append] at ih ⊢
    rw [ih]; simp [JK.recT]

theorem jBody_length_k (k k' : ℕ) (fs : List (List ℤ)) (bs : List (List ℤ × List ℤ × ℤ × ℤ))
    (cc : List (List ℤ)) : (JK.jBody k fs bs cc).length = (JK.jBody k' fs bs cc).length := by
  simp only [JK.jBody, List.length_append, flatB_length_k k k']

theorem jTab_bnd_sol_aux {P k' K G Xb Bc B kJ : ℕ} {fs : List (List ℤ)}
    {bs : List (List ℤ × List ℤ × ℤ × ℤ)} {cc : List (List ℤ)} {v : List ℤ}
    (hD : JK.PartD P k' K G Xb Bc fs bs cc v) (hXb : Xb ≤ B) (hBc : Bc + 4 ≤ B)
    (hk : kJ + 1 ≤ B) (hP : P + 2 ≤ B) :
    Bnd B (tabsT (fun _ => JK.jTab P kJ K G fs bs cc) 1) := by
  have hcnt := hD.cnts
  rw [jBody_length_k k' kJ] at hcnt
  set bl := (JK.jBody kJ fs bs cc).length with hbl
  have hBc2 : 2 ^ Bc * 16 = 2 ^ (Bc + 4) := by rw [pow_add]; norm_num
  have hBB : 2 ^ (Bc + 4) ≤ 2 ^ B := Nat.pow_le_pow_right (by norm_num) hBc
  have hsm : ∀ x : ℕ, x < 2 ^ Bc + 8 → zsz (x : ℤ) ≤ B := fun x hx => natZ' (by
    have : 1 ≤ 2 ^ Bc := Nat.one_le_two_pow
    omega)
  have hlen : ∀ (l : List ℤ), l.length ≤ bl → zsz (l.length : ℤ) ≤ B := fun l hl =>
    hsm _ (by omega)
  have hBnd : ∀ l : List ℤ, Bnd Xb l → Bnd B l := fun l h a ha => (h a ha).trans hXb
  rw [tabsT_one]
  intro a ha
  simp only [List.mem_cons] at ha
  rcases ha with rfl | ha
  · simp only [JK.jTab, JK.jHdr, List.length_append, List.length_cons, List.length_nil]
    push_cast
    exact_mod_cast hsm _ (by rw [← hbl]; omega)
  simp only [JK.jTab, JK.jHdr, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with (rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) | ha
  · exact zsz_pow2 (by omega)
  · exact zsz_pow2 (by omega)
  · exact zsz_pow2 hk
  · exact hsm _ (by have := hD.mG; omega)
  · exact hsm _ (by omega)
  · exact hsm _ (by omega)
  · refine hsm _ ?_
    have : JK.nBd bs ≤ bs.length := List.length_filter_le _ _
    have := hD.lb; have := hD.mG; omega
  · exact hsm _ (by rw [← hbl]; omega)
  -- the body
  have hbody : ∀ l : List ℤ, ∀ x ∈ l, l.length ≤ bl → Bnd Xb l → zsz x ≤ B := fun l x hx hl hb =>
    (hb x hx).trans hXb
  unfold JK.jBody at ha
  simp only [List.mem_append] at ha
  have e1 : (JK.flatT fs).length ≤ bl := by
    rw [hbl]; simp only [JK.jBody, List.length_append]; omega
  have e2 : (JK.flatB kJ bs).length ≤ bl := by
    rw [hbl]; simp only [JK.jBody, List.length_append]; omega
  have e3 : (JK.flatT cc).length ≤ bl := by
    rw [hbl]; simp only [JK.jBody, List.length_append]; omega
  rcases ha with ha | ha | ha
  · obtain ⟨x, hx, hax⟩ := List.mem_flatMap.1 ha
    obtain ⟨r, hr, rfl⟩ := List.mem_iff_getElem.1 hx
    simp only [JK.rowT, List.mem_cons] at hax
    rcases hax with rfl | hax
    · exact hsm _ (by have := hD.wf r hr; have := hD.mG; omega)
    · exact (hD.bf r hr a hax).trans hXb
  · obtain ⟨rc, hrc, hax⟩ := List.mem_flatMap.1 ha
    obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.1 hrc
    have hw := hD.bwd
    have hrl := len_le_flatMap (g := JK.recT kJ) hrc
    simp only [JK.recT, JK.rowT, List.length_append, List.length_cons, List.length_nil] at hrl
    simp only [JK.recT, JK.rowT, List.mem_append, List.mem_cons, List.not_mem_nil,
      or_false] at hax
    rcases hax with (rfl | hax) | (rfl | hax) | rfl | rfl | rfl
    · exact hsm _ (by have := hw.wb j hj; have := hD.lb; have := hD.mG; omega)
    · exact (hw.bcb j hj a hax).trans hXb
    · exact hsm _ (by unfold JK.flatB at e2; omega)
    · exact (hw.bcz j hj a hax).trans hXb
    · exact (hw.bpv j hj).trans hXb
    · have h0 := hw.pv0 j hj
      unfold JK.ivOf
      refine zsz_of_le (M := 2 ^ kJ) ?_ ?_
      · rcases eq_or_lt_of_le h0 with h | h
        · rw [← h]; simp
        · have hp : (0 : ℤ) < 2 * bs[j].2.2.1 := by omega
          rw [abs_of_nonneg (Int.ediv_nonneg (by positivity) hp.le)]
          push_cast
          exact Int.ediv_le_self _ (by positivity)
      · exact (Nat.pow_lt_pow_right (by norm_num) (by omega : kJ < kJ + 1)).trans_le
          (Nat.pow_le_pow_right (by norm_num) hk)
    · rcases hw.fl01 j hj with h | h <;> rw [h]
      · exact hsm 0 (by omega)
      · exact hsm 1 (by omega)
  · obtain ⟨x, hx, hax⟩ := List.mem_flatMap.1 ha
    obtain ⟨r, hr, rfl⟩ := List.mem_iff_getElem.1 hx
    simp only [JK.rowT, List.mem_cons] at hax
    rcases hax with rfl | hax
    · exact hsm _ (by have := hD.wc r hr; have := hD.mG; omega)
    · exact (hD.bc r hr a hax).trans hXb

end J6Seg.PJ

