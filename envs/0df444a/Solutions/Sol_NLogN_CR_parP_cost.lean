theorem recsF_zero (sl : List ℕ) (K : ℕ) : recsF sl K 0 = [] := rfl

theorem recsF_succ (sl : List ℕ) (K k : ℕ) (hk : k < K) :
    recsF sl K (k + 1) = recI sl 0 (K - k - 1) ++ recsF sl K k := by
  unfold recsF
  rw [List.range_succ_eq_map, List.map_cons, List.flatten_cons, List.map_map]
  have e1 : K - (k + 1) + 0 = K - k - 1 := by omega
  have e2 : ((fun j => recI sl 0 (K - (k + 1) + j)) ∘ Nat.succ) = fun j => recI sl 0 (K - k + j) := by
    funext j; simp only [Function.comp]; congr 1; omega
  rw [e1, e2]

theorem Wk_succ (sl : List ℕ) (K k : ℕ) (hk : k < K) (hl : sl.length = K) :
    Wk sl K (k + 1) = sl.getD (K - k - 1) 1 * Wk sl K k := by
  unfold Wk
  have e : K - (k + 1) = K - k - 1 := by omega
  have e2 : K - k - 1 + 1 = K - k := by omega
  rw [e, List.drop_eq_getElem_cons (by omega), List.prod_cons, List.getD_eq_getElem _ _ (by omega), e2]

theorem recI_eq (sl : List ℕ) (K k : ℕ) (hk : k < K) :
    recI sl 0 (K - k - 1) = [0, (sl.getD (K - k - 1) 1 : ℤ), (Wk sl K k : ℤ),
      ((sl.getD (K - k - 1) 1 * Wk sl K k : ℕ) : ℤ)] := by
  have : K - k - 1 + 1 = K - k := by omega
  simp [recI, wgt, Wk, this]

