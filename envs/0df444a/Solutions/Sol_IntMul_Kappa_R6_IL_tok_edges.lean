-- Source module: Solutions.KIL6Tok
/-!
# KIL6: the template side conditions for large primes

* `tok_edgeTpl`: the `TOK` side conditions of the templates `edgeTplQ Qc X` hold at every modulus
  `q ^ e` (`e ≥ 1`) for every prime `q` beyond a constant of the frame matrix, once `Bb` holds
  `tokBnd A · (q^e + 1)²` (this is the open `tok_edgeTplQ` of KIL5_WIP, in a slightly different
  form: the constant is explicit).
* `framesOK_toCircuit`: a property of the rational frame changes transfers to the integer frame
  changes of every `Qc.toCircuit Q`.
* `subBnd_of`: `SubBnd N Bb` from `zsz (8 (N+1)²) ≤ Bb`.
* `SWn_toCircuit_eq`: the number of child calls per level of the uniform Prop. 11 code is the
  rank sum of the rational circuit.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12 AModelFac AModelRat Finset

variable {m : ℕ}

/-! ## TOK -/

theorem tok_of_good {q e Bb : ℕ} (hq : q.Prime) (he : 1 ≤ e) :
    ∀ (s : QStep m), s.Good (q ^ e) → qsB s < q →
      zsz ((qsB s * (q ^ e + 1) ^ 2 : ℕ) : ℤ) ≤ Bb → ∀ T, s.tpl = TStep.sh T → TOK T (q ^ e) Bb
  | .sw _ _, _, _, _, T, h => by simp [QStep.tpl] at h
  | .sh i u c, ⟨hu, hd, hn, hc⟩, hlt, hBb, T, h => by
    simp only [QStep.tpl, TStep.sh.injEq] at h
    subst h
    have hqe : q ≤ q ^ e := by
      calc q = q ^ 1 := (pow_one q).symm
        _ ≤ q ^ e := Nat.pow_le_pow_right hq.pos he
    have hnum : u.num.natAbs ≤ qsB (QStep.sh i u c) := by simp only [qsB]; omega
    have hden : u.den ≤ qsB (QStep.sh i u c) := by simp only [qsB]; omega
    refine ⟨?_, ?_, Rat.den_pos u, ?_, hn.symm, hd.symm, ?_⟩
    · exact Int.natAbs_pos.2 (Rat.num_ne_zero.2 hu)
    · simp only [rsh]; omega
    · simp only [rsh]; omega
    · intro j hj
      have hj' : j < m + m := lt_of_lt_of_le hj (by simp only [rsh]; exact (i.2).le)
      simp only [rsh, dif_pos hj']
      refine ⟨Rat.den_pos _, (hc ⟨j, hj'⟩ (by simp only [rsh] at hj; exact hj)).symm, ?_⟩
      refine le_trans (zsz_mono ?_) hBb
      have h1 : 2 * ((c ⟨j, hj'⟩).num.natAbs + 1) * ((c ⟨j, hj'⟩).den + 1) ≤ qsB (QStep.sh i u c) := by
        simp only [qsB]
        have := Finset.single_le_sum (f := fun j : Fin (m + m) =>
          2 * ((c j).num.natAbs + 1) * ((c j).den + 1)) (fun _ _ => Nat.zero_le _)
          (Finset.mem_univ ⟨j, hj'⟩)
        omega
      simp only [Int.natAbs_natCast, ctrlBnd]
      calc 2 * ((c ⟨j, hj'⟩).num.natAbs + 1) * ((c ⟨j, hj'⟩).den + 1) * (q ^ e + 1) ^ 2
          ≤ qsB (QStep.sh i u c) * (q ^ e + 1) ^ 2 := Nat.mul_le_mul_right _ h1

