theorem pushSz_chL_le {m a b : ℕ} (ha : a < m + m) (hb : b < m + m) :
    pushSz (NLogN.KIL.chL m a b) ≤ chS m := by
  unfold chS
  refine le_trans ?_ (List.single_le_sum (fun _ _ => Nat.zero_le _) _
    (List.mem_map.2 ⟨a, List.mem_range.2 ha, rfl⟩))
  exact List.single_le_sum (fun _ _ => Nat.zero_le _) _
    (List.mem_map.2 ⟨b, List.mem_range.2 hb, rfl⟩)

theorem cSwC_le {m a b : ℕ} (ha : a < m + m) (hb : b < m + m) (Bb c0 : ℕ) :
    cSwC m a b Bb c0 ≤ c0 + Kd m * (Bb + 2) ^ 2 := by
  unfold cSwC Kd
  rw [pushCost_eq]
  have h1 := Nat.mul_le_mul_right ((Bb + 2) ^ 2) (Nat.mul_le_mul_right (10 ^ 7) (pushSz_chL_le ha hb))
  have h2 : Bb + 2 ≤ (Bb + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
  have e : 10 ^ 7 * (chS m + 1) * (Bb + 2) ^ 2 = chS m * 10 ^ 7 * (Bb + 2) ^ 2 +
      10 ^ 7 * (Bb + 2) ^ 2 := by ring
  rw [e]
  omega

