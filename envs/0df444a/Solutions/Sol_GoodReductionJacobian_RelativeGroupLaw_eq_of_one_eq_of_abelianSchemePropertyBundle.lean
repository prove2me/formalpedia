open CategoryTheory CategoryTheory.Limits AlgebraicGeometry GoodReductionJacobian
open NeronModelInfra (SchemeHomOver)

universe u

theorem solution
    {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    (hA : AbelianSchemePropertyBundle R f) (L L' : RelativeGroupLaw R f)
    (h : L.one (𝟙 (Spec (CommRingCat.of R))) = L'.one (𝟙 (Spec (CommRingCat.of R)))) : L = L' := by

  have hφ : NeronModelInfra.schemeHomOverComp (L.one (𝟙 (Spec (CommRingCat.of R))))
      (NeronModelInfra.schemeHomOverId f) = L'.one (𝟙 (Spec (CommRingCat.of R))) := by
    rw [NeronModelInfra.schemeHomOverComp_id_right, h]

  have hm : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (x y : SchemeHomOver t f),
      L.mul t x y = L'.mul t x y := by
    intro T t x y
    have hxy := AbelianSchemePropertyBundle.schemeHomOverComp_mul_eq_mul_of_schemeHomOverComp_one_eq_one
      hA hA L L' (NeronModelInfra.schemeHomOverId f) hφ t x y
    rw [NeronModelInfra.schemeHomOverComp_id_right, NeronModelInfra.schemeHomOverComp_id_right,
      NeronModelInfra.schemeHomOverComp_id_right] at hxy
    exact hxy
  have ho : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)), L.one t = L'.one t := by
    intro T t
    rw [← L.one_natural (𝟙 _) t t (Category.comp_id t), ← L'.one_natural (𝟙 _) t t (Category.comp_id t), h]
  have hi : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (x : SchemeHomOver t f),
      L.inv t x = L'.inv t x := by
    intro T t x
    letI := L'.pointGroup t
    apply eq_inv_of_mul_eq_one_left
    show L'.mul t (L.inv t x) x = L'.one t
    rw [← hm, ← ho, L.inv_mul_cancel]

  obtain ⟨mul, one, inv, h1, h2, h3, h4, h5⟩ := L
  obtain ⟨mul', one', inv', h1', h2', h3', h4', h5'⟩ := L'
  have em : @mul = @mul' := by
    funext T t x y
    exact hm t x y
  have eo : @one = @one' := by
    funext T t
    exact ho t
  have ei : @inv = @inv' := by
    funext T t x
    exact hi t x
  subst em eo ei
  rfl

end S_GoodReductionJacobian_RelativeGroupLaw_eq_of_one_eq_of_abelianSchemePropertyBundle
