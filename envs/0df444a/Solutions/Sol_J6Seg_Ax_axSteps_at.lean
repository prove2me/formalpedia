theorem axG_ge (P : Prm) (n : ℕ) (src : ℕ → ℕ) (k : ℕ) :
    (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length ≤ axG6 P n src k :=
  Nat.le_pow_clog (by norm_num) _

theorem axG_pos (P : Prm) (n : ℕ) (src : ℕ → ℕ) (k : ℕ) : 0 < axG6 P n src k := by
  unfold axG6 Gj6; positivity

theorem jker_len (G0 : ℕ) (X : List GI) (hX : X.length = axG6 P n src k) :
    (liftG (jKer (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
      (axw6 P n) (axα6 P n) (axw6 P n) (axG6 P n src k)) X).length = axG6 P n src k :=
  length_liftG _ _ (fun y _ => length_jKer (axG_ge P n src k) y) X hX

