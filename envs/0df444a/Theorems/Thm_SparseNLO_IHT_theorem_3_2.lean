-- title:
--   Theorem 3.2 — for f_LI(x) = ‖Ax − b‖² with A s-regular, the IHT method with stepsize 1/L, L > L(f), converges to an L-stationary point
-- statement:
--   Let $0<s<n$, let $A\in\mathbb R^{m\times n}$ be $s$-regular (every $s$ of its columns are linearly independent), let $b\in\mathbb R^m$, and let $f=f_{LI}$,
--   $$f_{LI}(x)=\|Ax-b\|^2 .$$
--   Let $L(f)$ be a Lipschitz constant of $\nabla f_{LI}$ and let $L>L(f)$. Let $(x^k)_{k\ge0}$ be any sequence generated by the IHT method with stepsize $1/L$:
--   $$x^0\in C_s,\qquad x^{k+1}\in P_{C_s}\Big(x^k-\tfrac1L\nabla f_{LI}(x^k)\Big)\quad(k=0,1,2,\dots).$$
--   Then the whole sequence converges to an $L$-stationary point: there is $x^*$ with $x^*\in C_s$, $x^*\in P_{C_s}\big(x^*-\tfrac1L\nabla f_{LI}(x^*)\big)$, and
--   $$\lim_{k\to\infty}x^k=x^* .$$
--
--   For sparse least squares this upgrades the subsequential guarantee of Theorem 3.1 to convergence of the iterates, with a fixed stepsize tied to the Lipschitz constant instead of the normalization $\|A\|_2<1$ of earlier work.
--
--   **Formalization Note** The paper's $L(f)=2\lambda_{\max}(A^TA)$ is the smallest Lipschitz constant of $\nabla f_{LI}$; the theorem is stated for any constant `Lf : ℝ≥0` with `LipschitzWith Lf (gradient (fLI A b))` and `Lf < L`, which is equivalent to $L>2\lambda_{\max}(A^TA)$. Assumption 1 holds automatically because $f_{LI}\ge0$ and is not stated. Convergence is `Tendsto x atTop (𝓝 xstar)`.
-- source:
--   Beck, Eldar, Sparsity Constrained Nonlinear Optimization: Optimality Conditions and Algorithms, SIAM J. Optim. (2013), doi:10.1137/120869778 (source: arXiv:1203.4580v1), p. 16, Theorem 3.2 (proof §4.1.2, pp. 28–29)

import Mathlib
import Definitions.Def_SparseNLO_IHT_Setting

open Filter Topology

namespace SparseNLO.IHT

/-- Theorem 3.2 (p. 16). Let `f = f_LI`, `f_LI(x) = ‖Ax − b‖²`, with `A` `s`-regular. Then the
sequence generated by the IHT method with stepsize `1/L`, where `L > L(f)`, converges to an
`L`-stationary point. Here `L(f)` is any Lipschitz constant `Lf` of `∇f_LI` (the paper's
`L(f) = 2λ_max(AᵀA)` is the smallest one). -/
theorem theorem_3_2 {m n s : ℕ} (hs : 0 < s) (hsn : s < n)
    (A : Matrix (Fin m) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin m)) (hA : IsSRegular s A)
    (Lf : NNReal) (hLip : LipschitzWith Lf (gradient (fLI A b))) (L : ℝ) (hL : (Lf : ℝ) < L)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hx : IsIHTRun (fLI A b) s L x) :
    ∃ xstar : EuclideanSpace ℝ (Fin n),
      IsLStationary (fLI A b) s L xstar ∧ Tendsto x atTop (𝓝 xstar) := by sorry

end SparseNLO.IHT
