  have h2 := hFM s1 a b (s.G ARG) LP LN LF ⟨ha.1, by omega⟩ ⟨hb.1, by omega⟩ (by simp [s1])
    (by simp +decide [s1, hP]) (by simp +decide [s1, hN]) (by simp +decide [s1, hF])
  set p := (a * b) % (2 ^ n + 1) with hp
  have hp0 : 0 ≤ p := Int.emod_nonneg _ (by positivity)
  have hp1 : p < 2 ^ n + 1 := Int.emod_lt_of_pos _ (by positivity)
  have hzp : zsz p ≤ n + 1 := zsz_le_of_abs (by rw [abs_lt, pow_succ]; constructor <;> linarith)
  have h3g : ∀ s' : IState NS, s'.G ARG = .int p :: s.G ARG → s'.G CC = .int c :: LC →
      IRuns I iprog (.seq (.op (.mv ARG P1)) (decC CC)) s'
        (((s'.upd ARG (s.G ARG)).upd P1 (.int p :: s'.G P1)).upd CC (.int (c + -1) :: LC))
        (1000 * (n + 3)) := by
    intro s' hA' hC'
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, decC, hA', hC', zsz_neg_one]
    refine ⟨by clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := moveIntCost_le (zsz p)
    have := addIntCost_mono (show zsz c + 1 ≤ n + 1 by omega)
    have := addIntCost_le (n + 1)
    omega
  have h3 := h3g (s1.upd ARG (.int p :: s.G ARG)) (by simp) (by simp +decide [s1, hC])
  have hall := IRuns.seq h1 (IRuns.seq h2 h3)
  refine (IRuns.seq_assoc hall).mono' ?_ ?_
  · simp only [hs1]
    have : (s.G P1) = s.G P1 := rfl
    clear * -
    apply IState.ext'
    · intro x; fin_cases x <;> simp +decide [IState.upd_G] <;> rfl
    · simp
    · simp
  · omega

end NLogN

end

section
open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (pF : Fin P) (n C : ℕ) (hFM : FMSpec pF iprog I n C) (s : IState NS)
    (A B : List ℤ) (RV RX LL LP LN LF : List Item) (hl : A.length = B.length)
    (hzK : zsz (A.length : ℤ) ≤ n) (hA : Canon (2 ^ n + 1) A) (hB : Canon (2 ^ n + 1) B)
    (hV : s.G V = ints A ++ RV) (hX : s.G DX = ints B ++ RX) (hL : s.G DL = .int A.length :: LL)
    (hP : s.G PRM = .int n :: LP) (hN : s.G RN = .int (2 ^ n) :: LN)
    (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog (fmPw pF) s
      (((s.upd V RV).upd DX RX).upd P1 ((ints (pmulZ (2 ^ n + 1) A B)).reverse ++ s.G P1))
      (A.length * (C + 2000 * (n + 3) + 30) + 1000 * (n + 3)) := by
  set F : ℤ := 2 ^ n + 1 with hFdef
  set L0 := A.zip B with hL0
  have hm1 : L0.map Prod.fst = A := by simp [L0, List.map_fst_zip, hl]
  have hm2 : L0.map Prod.snd = B := by simp [L0, List.map_snd_zip, hl]
  have hl0 : L0.length = A.length := by simp [L0, hl]
  set s1 := s.upd CC (.int (A.length : ℤ) :: s.G CC) with hs1
  have h1 : IRuns I iprog (.op (.dup DL CC)) s s1 (300 * (n + 1)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hL]
    refine ⟨by rw [hs1], ?_⟩
    have := dupCost_le (zsz (A.length : ℤ)); omega
  let St : List (ℤ × ℤ) → List (ℤ × ℤ) → IState NS := fun D R =>
    (((s1.upd V (ints (R.map Prod.fst) ++ RV)).upd DX (ints (R.map Prod.snd) ++ RX)).upd P1
      ((ints (pmulZ F (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G P1)).upd CC
        (.int (R.length : ℤ) :: s.G CC)
  have h0 : St [] L0 = s1 := by
    apply IState.ext' <;> intros <;> simp [St, s1, hm1, hm2, hV, hX, hl0, pmulZ] <;>
      split_ifs <;> simp_all
  have h2 := IRuns.loopList (I := I) (iprog := iprog) (i := CC) (f := fun c => c != .zero)
    (p := pwStep pF) L0 St (C + 2000 * (n + 3))
    (by intro D x R _; simp +decide [St]; omega)
    (by simp +decide [St])
    (by
      intro D x R hD
      have hmem : x ∈ L0 := by rw [← hD]; simp
      have hx1 : x.1 ∈ A := by rw [← hm1]; exact List.mem_map_of_mem hmem
      have hx2 : x.2 ∈ B := by rw [← hm2]; exact List.mem_map_of_mem hmem
      have hlD : D.length + 1 + R.length = A.length := by
        rw [← hl0, ← hD]; simp; omega
      have hc : zsz ((R.length + 1 : ℕ) : ℤ) ≤ n := le_trans (zsz_natCast_le (by omega)) hzK
      have hst := pwStep_runs (I := I) (iprog := iprog) pF n C hFM (St D (x :: R)) x.1 x.2
        ((R.length + 1 : ℕ) : ℤ) (ints (R.map Prod.fst) ++ RV) (ints (R.map Prod.snd) ++ RX)
        (s.G CC) LP LN LF (hA _ hx1) (hB _ hx2) hc (by simp +decide [St])
        (by simp +decide [St]) (by simp +decide [St]) (by simp +decide [St, s1, hP])
        (by simp +decide [St, s1, hN]) (by simp +decide [St, s1, hF, hFdef])
      refine hst.mono' ?_ le_rfl
      have e4 := pmulZ_snoc F (D.map Prod.fst) (D.map Prod.snd) x.1 x.2 (by simp)
      simp only [St, List.map_append, List.map_cons, List.map_nil, e4, List.length_cons]
      apply IState.ext' <;> intros <;> simp [ints_append] <;> split_ifs <;> simp_all)
  have hk : St L0 [] = (((s1.upd V RV).upd DX RX).upd P1
      ((ints (pmulZ F A B)).reverse ++ s.G P1)).upd CC (.int 0 :: s.G CC) := by
    simp [St, hm1, hm2]
  rw [h0, hk, hl0] at h2
  have h3 : IRuns I iprog (.op (.drop CC)) ((((s1.upd V RV).upd DX RX).upd P1
      ((ints (pmulZ F A B)).reverse ++ s.G P1)).upd CC (.int 0 :: s.G CC))
      (((s.upd V RV).upd DX RX).upd P1 ((ints (pmulZ F A B)).reverse ++ s.G P1)) 2 := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, zsz_zero]
    rw [hs1]; clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
  exact (IRuns.seq h1 (IRuns.seq h2 h3)).mono (by omega)
end
