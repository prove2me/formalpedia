-- Source module: Solutions.SynthLayoutPaper
set_option linter.unusedSectionVars false

namespace Synth

open AModel AModelL12

variable (D ℓ K : ℕ) (long : Fin D → Bool)

lemma length_lstL_le : (lstL D ℓ K long).length ≤ D * (bb ℓ K + 1) := by
  unfold lstL
  simp only [List.length_append, List.length_map, List.length_flatMap, List.length_finRange]
  have h1 : ((List.finRange D).filter fun i => long i).length ≤ D := by
    have := List.length_filter_le (fun i => long i) (List.finRange D); simpa using this
  have h2 : ((List.range (bb ℓ K)).reverse.map fun _ => D).sum = bb ℓ K * D := by
    simp [List.sum_replicate]
  rw [show (List.map (fun a => D) (List.range (bb ℓ K)).reverse) =
    ((List.range (bb ℓ K)).reverse.map fun _ => D) from rfl, h2]
  nlinarith

lemma length_chunk (i : Fin D) {j : ℕ} (hj : j < qq ℓ K) : (chunk D ℓ K i j).length = K := by
  unfold chunk
  rw [List.length_take, List.length_drop, length_restA]
  have : j * K + K ≤ qq ℓ K * K := by nlinarith
  omega

lemma length_axisMajor : (axisMajor D ℓ K).length = D * qq ℓ K := by
  simp [axisMajor, List.length_flatMap, List.sum_replicate]

lemma length_initL (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    (initL D ℓ long).length = (lstL D ℓ K long).length + D * qq ℓ K * K := by
  have h1 := (List.filter_append_perm (fun x => decide (x ∈ lstL D ℓ K long)) (initL D ℓ long)).length_eq
  have h2 : ((initL D ℓ long).filter fun x => decide (x ∈ lstL D ℓ K long)).length =
      (lstL D ℓ K long).length := by
    apply List.Perm.length_eq
    rw [List.perm_ext_iff_of_nodup ((initL_nodup D ℓ long).filter _) (lstL_nodup D ℓ K long)]
    intro x; simp only [List.mem_filter, decide_eq_true_eq]
    exact ⟨fun h => h.2, fun h => ⟨lstL_sub_initL D ℓ K long hℓ x h, h⟩⟩
  have h3 := initL_filter D ℓ K long hK hℓ
  rw [List.length_append, h2] at h1
  rw [← h1]
  have : ((initL D ℓ long).filter fun x => !decide (x ∈ lstL D ℓ K long)) =
      (initL D ℓ long).filter (· ∉ lstL D ℓ K long) := by
    apply List.filter_congr; intro x _; simp
  rw [this, h3, length_flatten_uniform (K := K) _ (fun c hc => by
    obtain ⟨i, j, hj, rfl⟩ := (mem_axisMajor D ℓ K).1 hc; exact length_chunk D ℓ K i hj),
    length_axisMajor]

end Synth

end

section
set_option linter.unusedSectionVars false
open Synth
open AModel AModelL12
variable (D ℓ K : ℕ) (long : Fin D → Bool)
theorem solution (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    ∃ ops : List Synth.LOp,
      (ops.filter Synth.LOp.isMv).length = (Synth.lstL D ℓ K long).length ∧
      (Synth.lstL D ℓ K long).length ≤ D * (Synth.bb ℓ K + 1) ∧
      (ops.filter fun o => !o.isMv).length ≤ D * Synth.qq ℓ K - 1 ∧
      (∀ o ∈ ops, o.WF (Synth.initL D ℓ long).length) ∧
      Synth.applyN ops (Synth.initL D ℓ long) = Synth.tgtL D ℓ K long ∧
      ∀ {α : Type} (d : α) (xs : List α), xs.length = 2 ^ (Synth.initL D ℓ long).length →
        Synth.runArr (Synth.initL D ℓ long).length d ops xs =
          AModel.pull (Synth.binSh (Synth.initL D ℓ long).length) (Synth.binSh (Synth.initL D ℓ long).length)
            (Synth.relabel (Synth.initL D ℓ long) (Synth.tgtL D ℓ K long)) d xs := by
  set n := (Synth.initL D ℓ long).length with hn
  obtain ⟨ops1, hl1, hmv1, hwf1, happ1⟩ := Synth.prefix_moves n (Synth.lstL D ℓ K long) [] (Synth.initL D ℓ long)
    (Synth.initL_nodup D ℓ long) (Synth.lstL_nodup D ℓ K long) (Synth.lstL_sub_initL D ℓ K long hℓ) rfl
  simp only [List.nil_append] at happ1
  rw [Synth.initL_filter D ℓ K long hK hℓ] at happ1
  obtain ⟨ops2, hl2, hx2, hwf2, happ2⟩ := Synth.chunk_sort n K (Synth.axisMajor D ℓ K) (Synth.chunkMajor D ℓ K)
    (Synth.lstL D ℓ K long) (Synth.axisMajor_nodup D ℓ K hK) (Synth.chunk_perm D ℓ K hK)
    (fun c hc => by obtain ⟨i, j, hj, rfl⟩ := (Synth.mem_axisMajor D ℓ K).1 hc; exact Synth.length_chunk D ℓ K i hj)
    (by rw [Synth.length_axisMajor, hn, Synth.length_initL D ℓ K long hK hℓ])
  have happ : Synth.applyN (ops1 ++ ops2) (Synth.initL D ℓ long) = Synth.tgtL D ℓ K long := by
    unfold Synth.applyN at happ1 happ2 ⊢
    rw [List.foldl_append, happ1, happ2]; rfl
  have hwf : ∀ o ∈ ops1 ++ ops2, o.WF n := by
    intro o ho; rcases List.mem_append.1 ho with h | h
    · exact hwf1 o h
    · exact hwf2 o h
  refine ⟨ops1 ++ ops2, ?_, Synth.length_lstL_le D ℓ K long, ?_, hwf, happ, ?_⟩
  · rw [List.filter_append, List.filter_eq_self.2 hmv1,
      List.filter_eq_nil_iff.2 (fun o ho => by simp [hx2 o ho])]
    simp [hl1]
  · rw [List.filter_append, List.filter_eq_nil_iff.2 (fun o ho => by simp [hmv1 o ho]),
      List.filter_eq_self.2 (fun o ho => by simp [hx2 o ho])]
    simp only [List.nil_append]
    rw [Synth.length_axisMajor] at hl2; exact hl2
  · intro α d xs hxs
    rw [Synth.runArr_eq_pull_init n d (Synth.initL_nodup D ℓ long) rfl _ hwf hxs, happ]
end
