variable {R : Type u} [CommRing R] {V : Scheme.{u}} (π : V ⟶ Spec (.of R))

section Transport

theorem cechFinrank_eq_of_cechEquiv {W W' : Scheme.{u}} {ρ : W ⟶ Spec (.of R)} {ρ' : W' ⟶ Spec (.of R)}
    {F : OModulePresheaf ρ} {G : OModulePresheaf ρ'} {K : W.OrderedAffineCover} {K' : W'.OrderedAffineCover}
    (h0 : Nonempty (F.H0 K ≃ₗ[R] G.H0 K')) (hS : ∀ i : ℕ, Nonempty (F.HSucc K i ≃ₗ[R] G.HSucc K' i)) (i : ℕ) :
    F.cechFinrank K i = G.cechFinrank K' i := by
  cases i with
  | zero => obtain ⟨e⟩ := h0; exact e.finrank_eq
  | succ j => obtain ⟨e⟩ := hS j; exact e.finrank_eq

theorem eulerChar_eq_of_forall_cechFinrank_eq [Nontrivial R] {W W' : Scheme.{u}} {ρ : W ⟶ Spec (.of R)}
    {ρ' : W' ⟶ Spec (.of R)}
    (F : OModulePresheaf ρ) (G : OModulePresheaf ρ') (K : W.OrderedAffineCover) (K' : W'.OrderedAffineCover)
    (h : ∀ i : ℕ, F.cechFinrank K i = G.cechFinrank K' i) : F.eulerChar K = G.eulerChar K' := by
  obtain ⟨-, -, -, hF⟩ := subsingleton_HSucc_and_eulerChar_eq_sum_range_of_card_le F K
  obtain ⟨-, -, -, hG⟩ := subsingleton_HSucc_and_eulerChar_eq_sum_range_of_card_le G K'
  obtain ⟨-, hF⟩ := hF inferInstance
  obtain ⟨-, hG⟩ := hG inferInstance
  rw [hF (max (Fintype.card K.ι) (Fintype.card K'.ι)) (le_max_left _ _),
    hG (max (Fintype.card K.ι) (Fintype.card K'.ι)) (le_max_right _ _)]
  exact Finset.sum_congr rfl fun i _ => by rw [h i]

variable {π} [IsSeparated π] (K : V.OrderedAffineCover) {F G : OModulePresheaf π}

theorem eulerChar_eq_of_bijective (φ : AffHom F G) (hφ : ∀ U : V.affineOpens, Function.Bijective (φ.app U)) :
    F.eulerChar K = G.eulerChar K := by
  obtain ⟨h0, hS⟩ := AffHom.nonempty_H0_equiv_and_HSucc_equiv_of_bijective φ hφ K
  rw [eulerChar_def, eulerChar_def]
  exact Finset.sum_congr rfl fun i _ => by rw [cechFinrank_eq_of_cechEquiv h0 hS i]

theorem cechFinite_of_bijective (φ : AffHom F G) (hφ : ∀ U : V.affineOpens, Function.Bijective (φ.app U))
    (hG : G.CechFinite K) : F.CechFinite K := by
  obtain ⟨⟨e0⟩, hS⟩ := AffHom.nonempty_H0_equiv_and_HSucc_equiv_of_bijective φ hφ K
  refine ⟨?_, fun i => ?_⟩
  · haveI := hG.1; exact Module.Finite.equiv e0.symm
  · haveI := hG.2 i; obtain ⟨e⟩ := hS i; exact Module.Finite.equiv e.symm

end Transport

