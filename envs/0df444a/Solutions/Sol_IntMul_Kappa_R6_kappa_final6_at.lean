-- Source module: NLogN.IComp
/-!
# Control flow of the item language and the compiler correctness theorem
-/

namespace NLogN

open IntMul

variable {S P : ℕ}

/-! ## Compilation -/

variable {I : List Sym} {prog : Fin P → Stmt (S + 4) P}

end NLogN

namespace NLogN

open IntMul

variable {S P : ℕ}

theorem encI_init : encI (⟨fun _ => [], 0, []⟩ : IState S) = St.init (S + 4) := by
  rw [St.ext_iff']; refine ⟨fun x => ?_, rfl, rfl⟩
  simp [encI, St.init]

/-- Item-language programs against the platform's notion of multiplication. -/
theorem multipliesAt_of_iexec (iprog : Fin P → IStmt S P) (hP : 0 < P) (n : ℕ) (T : ℝ)
    (h : ∀ x y : List Bool, x.length = n → y.length = n → ∃ s' c,
      IExec (inputCodes x y) iprog (iprog ⟨0, hP⟩) ⟨fun _ => [], 0, []⟩ s' c ∧
        s'.out = bin (2 * n) (val x * val y) ∧ (2 * c + 1 : ℝ) ≤ T) :
    MultipliesAt (machineOf (fun j => compile (iprog j)) hP) n T := by
  apply multipliesAt_of_exec
  intro x y hx hy
  obtain ⟨s', c, hex, hout, hT⟩ := h x y hx hy
  obtain ⟨c', hc', hE⟩ := (compile_correct (prog := fun j => compile (iprog j)) (fun _ => rfl)
    hex).1
  rw [encI_init] at hE
  refine ⟨encI s', c', hE, hout, le_trans ?_ hT⟩
  have : (c' : ℝ) ≤ c := by exact_mod_cast hc'
  linarith

end NLogN

