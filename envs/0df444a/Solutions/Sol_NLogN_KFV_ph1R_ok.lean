    (EV.lit (c := 2) (zsz_le_B (by omega) (by omega))).cast (by norm_num)
  have vFl0 := vDv.nmod v2 (by norm_num)
    (zsz_nat_le (by have := Nat.mod_lt (mk / 2 ^ k) (show 0 < 2 by norm_num); omega))
  have hbit : mk / 2 ^ k % 2 = fbk D long k := by rw [hmk, mkOf_bit, fbk_eq]
  exact vFl0.cast (by rw [hbit])

set_option maxHeartbeats 4000000 in
/-- **The backward loop body of phase 1.** -/
theorem body1R_ok {L : LP} {mk p W B : ℕ} (hLn : L.n = nLong D long + D * (ℓ - 1))
    (hmk : mk = mkOf (flOf D long)) (hℓ : 2 ≤ ℓ) (hB : L.n + ℓ + 5 ≤ B) :
    LoopBody (r := 2 ^ ℓ) I iprog body1R (fun s => LRg s L mk W ∧ L.ℓ = ℓ)
      (fun j s => encK s (F1 D long (D - j)))
      (fun j => runArrR L.n 0 [op1 D ℓ long (D - 1 - j)]) (2 ^ L.n) p W
      (cBody1R D ℓ long L.n W B) D := by
  intro j hj s ⟨hQ, hLl⟩ zs l xs hx hl hgb hd
  have e1 : D - j = (D - 1 - j) + 1 := by omega
  have e2 : D - (j + 1) = D - 1 - j := by omega
  beta_reduce
  rw [e1, e2]
  set k := D - 1 - j with hk_
  have hk : k < D := by omega
  set n := L.n with hn
  set c := rkS D long k with hc
  set fb := fbk D long k with hfb
  set δ := fb * (k * (ℓ - 1)) with hδ
  have hD1 : 1 ≤ D := Nat.one_le_iff_ne_zero.2 (NeZero.ne D)
  have hfb1 : fb ≤ 1 := fbk_le D long k
  have hck : c ≤ k := rkS_le_k D long k
  have hcl : c + fb ≤ nLong D long := by
    rw [hc, hfb, ← rkS_succ, ← rkS_D]; exact rkS_mono D long (by omega)
  have hkl : (k + 1) * (ℓ - 1) ≤ D * (ℓ - 1) := Nat.mul_le_mul_right _ (by omega)
  have hl1 : 1 ≤ D * (ℓ - 1) := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
  have hδle : δ ≤ k * (ℓ - 1) := by
    rw [hδ]; rcases Nat.le_one_iff_eq_zero_or_eq_one.1 hfb1 with h | h <;> rw [h] <;> simp
  have hcδ : c + δ + 1 ≤ n := by
    rcases Nat.le_one_iff_eq_zero_or_eq_one.1 hfb1 with h | h
    · have : δ = 0 := by rw [hδ, h, zero_mul]
      omega
    · have : δ = k * (ℓ - 1) := by rw [hδ, h, one_mul]
      nlinarith
  set e := n - 1 - c - δ with he
  have hne : c + 1 + δ + e = n := by omega
  have hDn : D ≤ n := by
    have := Nat.mul_le_mul_left D (show 1 ≤ ℓ - 1 by omega); omega
  set v := gflat zs ++ l with hv
  rw [F1_G]
  have zB : ∀ x : ℕ, x ≤ B → zsz (x : ℤ) ≤ B := fun x hx => zsz_nat_le hx
  -- step 1: `gI ← gI - 1`
  set f0 := Function.update (F1 D long (k + 1)) 0 v with hf0
  have vI0 : EV (encK s f0) B (.reg NLogN.KFV.gI) (((k + 1 : ℕ) : ℤ)) :=
    EV.reg (L := s.G NLogN.KFV.gI) (by simp +decide [hf0, F1, Function.update_apply, ints]) (zB _ (by omega))
  have wI := (vI0.add (EV.lit (c := -1) (zsz_le_B (by omega) (by omega)))
    (zsz_le_B (by omega) (by omega))).cast (v' := ((k : ℕ) : ℤ)) (by push_cast; ring)
  have S1 := Sp.asgQ s f0 (i := NLogN.KFV.gI) (e := .add (.reg NLogN.KFV.gI) (.lit (-1))) (a := ((k + 1 : ℕ) : ℤ))
    (l := []) (B := B) (by decide) (by simp +decide [hf0, F1, Function.update_apply])
    (zB _ (by omega)) (by intro r hr; simp [Ex.regs] at hr; subst hr; decide) wI.1 wI.2.2
  rw [wI.2.1] at S1
  set f1 := Function.update f0 NLogN.KFV.gI [((k : ℕ) : ℤ)] with hf1
  -- step 2: `gRk ← gRk - flag`
  have vFl1 : EV (encK s f1) B eFl (fb : ℤ) :=
    ev_fl D long hQ.m (by simp +decide [hf1, hf0, F1, Function.update_apply])
      (by simp [hf1]) hmk hk (by omega)
  have hck1 : rkS D long (k + 1) = c + fb := by rw [rkS_succ]
  have vR1 : EV (encK s f1) B (.reg gRk) (((rkS D long (k + 1) : ℕ)) : ℤ) :=
    EV.reg (L := s.G gRk) (by simp +decide [hf1, hf0, F1, Function.update_apply, ints])
      (zB _ (by omega))
  have wR := (vR1.add vFl1.neg (zsz_le_B (by omega) (by omega))).cast
    (v' := ((c : ℕ) : ℤ)) (by rw [hck1]; push_cast; ring)
  have S2 := Sp.asgQ s f1 (i := gRk) (e := .add (.reg gRk) (.neg eFl))
    (a := ((rkS D long (k + 1) : ℕ) : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [hf1, hf0, F1, Function.update_apply])
    (zB _ (by omega))
    (by intro r hr; simp [eFl, Ex.regs] at hr; rcases hr with rfl | rfl | rfl <;> decide)
    wR.1 wR.2.2
  rw [wR.2.1] at S2
  have eF : Function.update f1 gRk [((c : ℕ) : ℤ)] = Function.update (F1 D long k) 0 v := by
    funext r
    simp only [hf1, hf0, F1, Function.update_apply]
    split_ifs <;> simp_all +decide
  rw [eF] at S2
  have R1 := FSp.irun (I := I) (iprog := iprog) (p := dn1) (by simp [dn1, fok])
    (FSp.of_norep (by simp [dn1, norep]) (S1.seq S2))
  -- the move
  set F := F1 D long k with hF
  set st := encK s (Function.update F 0 v) with hst
  have hFr : ∀ r : Fin HS, r ≠ 0 → r ≠ NLogN.KFV.gI → r ≠ gRk → Function.update F 0 v r = [] := by
    intro r h0 h1 h2; simp +decide [hF, F1, Function.update_apply, h0, h1, h2]
  have vN : EV st B (.reg gNn) (n : ℤ) := rt_ev hQ.n (hFr _ (by decide) (by decide) (by decide))
    (zB _ (by omega))
  have vL : EV st B (.reg gLl) (ℓ : ℤ) := by
    have := hQ.l; rw [hLl] at this
    exact rt_ev this (hFr _ (by decide) (by decide) (by decide)) (zB _ (by omega))
  have vI : EV st B (.reg NLogN.KFV.gI) ((k : ℕ) : ℤ) :=
    EV.reg (L := s.G NLogN.KFV.gI) (by simp +decide [hst, hF, F1, Function.update_apply, ints]) (zB _ (by omega))
  have vR : EV st B (.reg gRk) ((c : ℕ) : ℤ) :=
    EV.reg (L := s.G gRk) (by simp +decide [hst, hF, F1, Function.update_apply, ints]; try exact hc.symm)
      (zB _ (by omega))
  have vFl : EV st B eFl (fb : ℤ) :=
    ev_fl D long hQ.m (hFr _ (by decide) (by decide) (by decide))
      (by simp +decide [hF, F1, Function.update_apply]) hmk hk (by omega)
  have vL1 := (vL.add (EV.lit (c := -1) (zsz_le_B (by omega) (by omega)))
    (zsz_le_B (by omega) (by omega))).cast (v' := ((ℓ - 1 : ℕ) : ℤ)) (by omega)
  have hkl' : k * (ℓ - 1) ≤ n := by nlinarith
  have vIL := (vI.mul vL1 (by rw [← Nat.cast_mul]; exact zB _ (by omega))).cast
    (v' := ((k * (ℓ - 1) : ℕ) : ℤ)) (by push_cast; ring)
  have vF : EV st B eF1 ((δ : ℕ) : ℤ) := (vFl.mul vIL (by rw [← Nat.cast_mul]; exact zB _ (by
    rw [← hδ]; omega))).cast (by rw [hδ]; push_cast; ring)
  have vA : EV st B eA1 ((c : ℕ) : ℤ) := vR
  have vC : EV st B (eCm eA1 eF1) ((e : ℤ) + (ℓ : ℤ) + 1) := by
    have h1 := vN.add vA.neg (zsz_le_B (by omega) (by omega))
    have h2 := vF.neg.add vL (zsz_le_B (by omega) (by omega))
    exact (h1.add h2 (zsz_le_B (by omega) (by omega))).cast (by omega)
  have hzs : zs.length = 2 ^ (c + 1 + δ + e) * 2 ^ ℓ := by rw [hx.1, hl, hne]
  have R2 := mvF_run (I := I) (iprog := iprog) (encK s F) zs l (c := c) (δ := δ) (e := e) (ℓ := ℓ)
    (W := W) (B := B) hzs hgb
    (mvSafe_of eA1 (by simp [eA1, Ex.regs])) (mvSafe_of eF1 (by simp [eF1, eFl, Ex.regs]))
    (mvSafe_of (eCm eA1 eF1) (by
      simp only [eCm, eA1, eF1, eFl, Ex.regs]; intro r hr; simp at hr ⊢; tauto))
    (by rw [F1_G]; exact vA) (by rw [F1_G]; exact vF) (by rw [F1_G]; exact vC)
    (by omega) (by omega) (by omega)
  rw [hne] at R2
  rw [F1_G, F1_G] at R2
  set zM := zMv n (2 ^ ℓ) (KFU.mvIdx c 1 δ) zs with hzM
  set v' := gflat zM ++ l with hv'
  -- records
  have hxs : xs.length = vol (binSh n) := by rw [hl]; simp [binSh, vol_replicate]
  have hbl : (binSh n).length = n := by simp [binSh]
  have hval := valid_mvIdx (c := c) (δ := 1) (g := δ) (n := n) (by omega)
  have hrr := recRep_pull hx (binSh n) hxs hval
  rw [hbl] at hrr
  have hT : runArrR n 0 [op1 D ℓ long k] xs = pull (binSh n) (binSh n)
      (permIdx (KFU.mvIdx c 1 δ)) 0 xs := by
    rw [runArrR_cons, runArrR_nil]
    simp only [op1]
    rw [mv_idx]
  beta_reduce
  refine ⟨zM, ?_, gb_pull hgb _ _ _, ?_, ?_, ?_⟩
  · rw [hT]; exact hrr
  · rw [hT]; simp [binSh, vol_replicate]
  · rw [hT]; exact disk_pull hd _ _ _
  · have R := R1.seq R2
    rw [← F1_G D long s k v'] at R
    refine R.mono' rfl ?_
    have hE : e + ℓ + 1 = n - (c + δ) + ℓ := by omega
    unfold cBody1R
    rw [← hk_, ← hc, ← hfb, ← hδ, ← hE]
    all_goals omega

end Paper

end NLogN.KFV

end

section
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFV
open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)
set_option maxHeartbeats 2000000
theorem solution {L : NLogN.KFV.LP} {mk p W B : ℕ} (hLn : L.n = NLogN.KFV.nLong D long + D * (ℓ - 1)) (hLD : L.D = D)
    (hLnl : L.nL = NLogN.KFV.nLong D long) (hmk : mk = NLogN.KFV.mkOf (NLogN.KFV.flOf D long)) (hℓ : 2 ≤ ℓ)
    (hB : L.n + ℓ + 5 ≤ B) :
    NLogN.KFV.LayerU (r := 2 ^ ℓ) I iprog (fun s => NLogN.KFV.LRg s L mk W ∧ L.ℓ = ℓ) NLogN.KFV.ph1R
      (NLogN.KFV.runArrR L.n 0 (NLogN.KFV.ops1 D ℓ long)) (2 ^ L.n) p W (NLogN.KFV.cPh1R D ℓ long L.n W B) := by
  intro s hQ zs l xs hx hl hb hd
  set v := NLogN.KFB.gflat zs ++ l
  have hD1 : 1 ≤ D := Nat.one_le_iff_ne_zero.2 (NeZero.ne D)
  have hDB : D ≤ B := by
    have := Nat.mul_le_mul_left D (show 1 ≤ ℓ - 1 by omega); rw [hLn] at hB; omega
  have hNB : NLogN.KFV.nLong D long ≤ B := by rw [hLn] at hB; omega
  have z0 : NLogN.zsz (0 : ℤ) ≤ B := by simp [NLogN.zsz_zero]
  have hFr : ∀ r : Fin NLogN.HS, r ≠ 0 → NLogN.KFV.o0 v r = [] := fun r h => NLogN.KFV.o0_ne v h
  have vD : NLogN.KFV.EV (NLogN.KIL.encK s (NLogN.KFV.o0 v)) B (.reg NLogN.KFV.gD) ((D : ℕ) : ℤ) := by
    have := hQ.1.d; rw [hLD] at this; exact NLogN.KFV.rt_ev this (hFr _ (by decide)) (NLogN.KFV.zsz_nat_le hDB)
  have vNL : NLogN.KFV.EV (NLogN.KIL.encK s (Function.update (NLogN.KFV.o0 v) NLogN.KFV.gI [((D : ℕ) : ℤ)])) B (.reg NLogN.KFV.gNL)
      ((NLogN.KFV.nLong D long : ℕ) : ℤ) := by
    have := hQ.1.nl; rw [hLnl] at this
    exact NLogN.KFV.rt_ev this (by simp +decide [Function.update_apply, NLogN.KFV.o0]) (NLogN.KFV.zsz_nat_le hNB)
  -- the pushes
  have P1 := NLogN.KFV.pushV (i := NLogN.KFV.gI) s (NLogN.KFV.o0 v) (by decide)
    (by intro r hr; simp [NLogN.Ex.regs] at hr; subst hr; decide) vD (NLogN.KFV.o0_ne _ (by decide))
  have P2 := NLogN.KFV.pushV (i := NLogN.KFV.gRk) s (Function.update (NLogN.KFV.o0 v) NLogN.KFV.gI [((D : ℕ) : ℤ)]) (by decide)
    (by intro r hr; simp [NLogN.Ex.regs] at hr; subst hr; decide) vNL
    (by simp +decide [Function.update_apply, NLogN.KFV.o0])
  have e0 : Function.update (Function.update (NLogN.KFV.o0 v) NLogN.KFV.gI [((D : ℕ) : ℤ)]) NLogN.KFV.gRk
      [((NLogN.KFV.nLong D long : ℕ) : ℤ)] = Function.update (NLogN.KFV.F1 D long (D - 0)) 0 v := by
    funext j; simp only [NLogN.KFV.F1, NLogN.KFV.o0, Function.update_apply, Nat.sub_zero, NLogN.KFV.rkS_D]
    split_ifs <;> simp_all +decide
  rw [e0] at P2
  have R1 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog)
    (p := .seq (.push NLogN.KFV.gI (.reg NLogN.KFV.gD)) (.push NLogN.KFV.gRk (.reg NLogN.KFV.gNL)))
    (by simp [NLogN.KFD.fok]) (NLogN.KFD.FSp.of_norep (by simp [NLogN.KFD.norep]) (P1.seq P2))
  -- the loop
  obtain ⟨LX, hX⟩ := hQ.1.d
  obtain ⟨zs', a1, a2, a3, a4, R2⟩ := NLogN.KFV.rptX_layers (I := I) (iprog := iprog) (X := NLogN.KFV.gD) (A := NLogN.KFV.fA)
    (C := NLogN.KFV.fC) (D := NLogN.KFV.fD) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (NLogN.KFV.body1R_ok D ℓ long (I := I) (iprog := iprog) (p := p) hLn hmk hℓ hB)
    (fun S LA LC LD hQ => ⟨hQ.1.of_cf3 LA LC LD, hQ.2⟩)
    (fun k S LA LC LD => (NLogN.KFV.encK_cf3 S _ (by simp +decide [NLogN.KFV.F1, Function.update_apply])
      (by simp +decide [NLogN.KFV.F1, Function.update_apply]) (by simp +decide [NLogN.KFV.F1, Function.update_apply])
      LA LC LD).symm)
    (fun k S => by simp +decide [NLogN.KFV.F1, Function.update_apply, NLogN.ints])
    (fun k S => by simp +decide [NLogN.KFV.F1, Function.update_apply, NLogN.ints])
    (fun k S => by simp +decide [NLogN.KFV.F1, Function.update_apply, NLogN.ints])
    s hQ zs l xs hx hl hb hd (LX := LX) (by decide)
    (by rw [hLD] at hX; simp +decide [NLogN.KFV.F1, Function.update_apply, NLogN.ints, hX])
  have eI : NLogN.KFV.iterL (fun j => NLogN.KFV.runArrR L.n 0 [NLogN.KFV.op1 D ℓ long (D - 1 - j)]) D xs =
      NLogN.KFV.runArrR L.n 0 (NLogN.KFV.ops1 D ℓ long) xs := by
    rw [NLogN.KFV.ops1_flat, NLogN.KFV.runArrR_flatMap_range]
  rw [eI] at a1 a3 a4
  -- the pops
  beta_reduce at R2
  rw [Nat.sub_self, NLogN.KFV.F1_G, NLogN.KFV.F1_G] at R2
  set v' := NLogN.KFB.gflat zs' ++ l
  have Q1 := NLogN.KIL.Sp.pop (s := s) (f := Function.update (NLogN.KFV.F1 D long 0) 0 v') (i := NLogN.KFV.gRk)
    (a := ((NLogN.KFV.rkS D long 0 : ℕ) : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [NLogN.KFV.F1, Function.update_apply]) (NLogN.KFV.zsz_nat_le (by simp [NLogN.KFV.rkS]))
  have Q2 := NLogN.KIL.Sp.pop (s := s) (f := Function.update (Function.update (NLogN.KFV.F1 D long 0) 0 v') NLogN.KFV.gRk [])
    (i := NLogN.KFV.gI) (a := ((0 : ℕ) : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [NLogN.KFV.F1, Function.update_apply]) (NLogN.KFV.zsz_nat_le (by omega))
  have e1 : Function.update (Function.update (Function.update (NLogN.KFV.F1 D long 0) 0 v') NLogN.KFV.gRk []) NLogN.KFV.gI [] =
      NLogN.KFV.o0 v' := by
    funext j; simp only [NLogN.KFV.F1, NLogN.KFV.o0, Function.update_apply]
    split_ifs <;> simp_all +decide
  rw [e1] at Q2
  have R3 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (p := .seq (.pop NLogN.KFV.gRk) (.pop NLogN.KFV.gI))
    (by simp [NLogN.KFD.fok]) (NLogN.KFD.FSp.of_norep (by simp [NLogN.KFD.norep]) (Q1.seq Q2))
  refine ⟨zs', a1, a2, a3, a4, (R1.seq (R2.seq R3)).mono' rfl ?_⟩
  unfold NLogN.KFV.cPh1R
  simp only [NLogN.Ex.size]
  omega
end
