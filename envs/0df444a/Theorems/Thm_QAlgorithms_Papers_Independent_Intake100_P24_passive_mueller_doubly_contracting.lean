-- title:
--   Standalone passive Stokes propagation is doubly contracting
-- statement:
--   Let $\Omega$ be a Hermitian $2\times2$ frequency matrix, $G\ge0$ an absorption matrix, and $\mu$ a finite positive measure on unitary $2\times2$ matrices. For $t\ge0$, let $\Phi_t=\exp(t\mathcal L)$ be the map generated by the literal Stokes equation (46),
--
--   $$\mathcal L(X)=-i[\Omega,X]-\{G,X\}+\int(UXU^\dagger-X)\,d\mu(U).$$
--
--   Then $\Phi_t$ is completely positive and
--
--   $$\Phi_t(I)\le I,\qquad\Phi_t^*(I)\le I.$$
--
--   For every finite Kraus representation $\Phi_t(X)=\sum_a K_aXK_a^\dagger$, its trace-bilinear dual is $\Phi_t^*(M)=\sum_aK_a^\dagger M K_a$, and these two inequalities are equivalent to $\sum_aK_aK_a^\dagger\le I$ and $\sum_aK_a^\dagger K_a\le I$. This describes passive Stokes propagation without requiring trace preservation or joint Jones compatibility.
-- source:
--   Quantum features of macroscopic fields. Entropy and dynamics, arXiv:1904.06170v1, PDF p. 8, §VI.B, (50)–(52): passive Mueller maps

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P24

noncomputable section

open scoped Matrix ComplexConjugate ENNReal ComplexOrder Matrix.Norms.L2Operator

open MeasureTheory

open QAlgorithms.Papers.Independent.Dependency50.P49 (traceDual)

open QAlgorithms.Papers.Independent.Information100.P30 (IsPositiveMap)

namespace QAlgorithms.Papers.Independent.Intake100.P24

local instance : MeasurableSpace PolarizationMatrix := borel PolarizationMatrix

local instance : BorelSpace PolarizationMatrix := ⟨rfl⟩

/-- arXiv:1904.06170v1 PDF pp.8–9, (46),(50)–(52): the constructed
standalone Stokes propagator is completely positive and doubly contracting.
For every finite Kraus representation, its trace dual is (51), and (50) is
equivalent to (52). No assertion about joint Jones compatibility is made. -/
theorem passive_mueller_doubly_contracting
    (omega gamma : PolarizationMatrix) (homega : omega.IsHermitian)
    (hgamma : gamma.PosSemidef) (mu : Measure PolarizationMatrix) [IsFiniteMeasure mu]
    (hunit : ∀ᵐ U ∂mu, IsScatteringUnitary U) (t : ℝ) (ht : 0 ≤ t) :
    let Phi := muellerPropagation omega gamma mu t
    IsDoublyContracting Phi ∧
      ∀ (m : ℕ) (K : Fin m → PolarizationMatrix),
        (∀ X, Phi X = ∑ a, K a * X * (K a)ᴴ) →
        (∀ M, traceDual Phi M = ∑ a, (K a)ᴴ * M * K a) ∧
        (IsDoublyContracting Phi ↔
          (1 - ∑ a, K a * (K a)ᴴ).PosSemidef ∧
          (1 - ∑ a, (K a)ᴴ * K a).PosSemidef) := by sorry

end QAlgorithms.Papers.Independent.Intake100.P24

end
