theorem solution (O : Type) [CommRing O] [IsLocalRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)]
    (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ) :
    TypeDensity.frobeniusIter O Φ Φ.natDegree = AlgHom.id O (AdjoinRoot Φ) ∧
      Function.Bijective (TypeDensity.unramifiedFrobenius O Φ) := by
  -- roots are preserved by algebra maps
  have hroot : ∀ f : AdjoinRoot Φ →ₐ[O] AdjoinRoot Φ,
      (Φ.map (AdjoinRoot.of Φ)).IsRoot (f (AdjoinRoot.root Φ)) := by
    intro f
    have h0 : Polynomial.aeval (AdjoinRoot.root Φ) Φ = 0 := AdjoinRoot.aeval_eq Φ ▸ by simp
    rw [Polynomial.IsRoot, Polynomial.eval_map, ← AdjoinRoot.algebraMap_eq,
      ← Polynomial.aeval_def, Polynomial.aeval_algHom_apply, h0, map_zero]
  have hid : TypeDensity.frobeniusIter O Φ Φ.natDegree = AlgHom.id O (AdjoinRoot Φ) := by
    apply AdjoinRoot.algHom_ext
    obtain ⟨hF, hFin, hcard⟩ := TypeDensity.residue_extension_field O Φ hΦ
    let _ := hF.toField
    let _ := Fintype.ofFinite (TypeDensity.residueExtension O Φ)
    have hc : Fintype.card (TypeDensity.residueExtension O Φ) = TypeDensity.residueCard O ^ Φ.natDegree := by
      rw [← Nat.card_eq_fintype_card, hcard]
    have h2 := (TypeDensity.frobenius_residue_action O Φ hΦ).2 Φ.natDegree (AdjoinRoot.root Φ)
    rw [← hc, FiniteField.pow_card] at h2
    exact TypeDensity.root_unique_of_congruent O Φ hΦ _ _ (hroot _) (hroot (AlgHom.id O _))
      (Ideal.Quotient.eq.mp h2)
  refine ⟨hid, ?_⟩
  have hcomm : ∀ i, TypeDensity.frobeniusIter O Φ (i+1) =
      (TypeDensity.frobeniusIter O Φ i).comp (TypeDensity.unramifiedFrobenius O Φ) := by
    intro i
    induction i with
    | zero => rfl
    | succ n ih =>
      change (TypeDensity.unramifiedFrobenius O Φ).comp (TypeDensity.frobeniusIter O Φ (n+1)) = _
      conv_lhs => rw [ih]
      rw [← AlgHom.comp_assoc]; rfl
  obtain ⟨d, hd⟩ : ∃ d, Φ.natDegree = d + 1 :=
    ⟨Φ.natDegree - 1, by have := TypeDensity.natDegree_pos_of_isUnramifiedLift hΦ; omega⟩
  rw [Function.bijective_iff_has_inverse]
  refine ⟨TypeDensity.frobeniusIter O Φ d, fun x => ?_, fun x => ?_⟩
  · have := congrArg (fun f : AdjoinRoot Φ →ₐ[O] AdjoinRoot Φ => f x) hid
    simp only [hd, hcomm] at this
    exact this
  · have := congrArg (fun f : AdjoinRoot Φ →ₐ[O] AdjoinRoot Φ => f x) hid
    simp only [hd] at this
    exact this
