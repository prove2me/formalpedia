        (∑ z : X, (a z).adjoint ((lp.single (E := fun _ : X => E) 2 y h) z)) =
            (a y).adjoint ((lp.single (E := fun _ : X => E) 2 y h) y) := by
          apply Finset.sum_eq_single
          · intro z _ hzy
            rw [lp.single_apply_ne (E := fun _ : X => E) 2 y h hzy, map_zero]
          · intro hy
            exact (hy (Finset.mem_univ y)).elim
        _ = (a y).adjoint h := congrArg (a y).adjoint (lp.single_apply_self (E := fun _ : X => E) 2 y h)
    have entryConjApply (T : E →L[ℂ] E) (x y : X) (h : E) :
        entry (partitionConjugate a T) x y h = a x (T ((a y).adjoint h)) := by
      have hy : (partitionMap a).adjoint (lp.single 2 y h) = (a y).adjoint h := partAdjSingle y h
      have hx : (partitionMap a (T ((a y).adjoint h))) x = a x (T ((a y).adjoint h)) :=
        DFunLike.congr_fun (coordP x) (T ((a y).adjoint h))
      change (partitionMap a (T ((partitionMap a).adjoint (lp.single 2 y h)))) x = _
      exact (congrArg (fun v : E => (partitionMap a (T v)) x) hy).trans hx
    have hSp : PropagationLE (radius + radius) S := by
      intro x y hxy
      let L : Operator X E := partitionConjugate a K
      let Q : Operator X E := partitionConjugate a 1
      have hne : x ≠ y := by
        intro h
        subst y
        exact (not_lt_of_ge (add_nonneg hradius hradius)) (by simpa only [dist_self] using hxy)
      apply ContinuousLinearMap.ext
      intro h
      have hLv : L (lp.single 2 y h) x = 0 := by
        change entry (partitionConjugate a K) x y h = 0
        rw [entryConjApply, ha y, KApply]
        simp only [map_sum]
        apply Finset.sum_eq_zero
        intro z _
        rw [ha z]
        by_cases hxz : radius < dist x z
        · exact DFunLike.congr_fun (hsupport x z hxz) (F ((a z) ((a y) h)))
        · have hzy : radius < dist z y := by
            by_contra hz
            exact (not_le_of_gt hxy) ((dist_triangle x z y).trans
              (add_le_add (le_of_not_gt hxz) (le_of_not_gt hz)))
          have hzyv : a z (a y h) = 0 := DFunLike.congr_fun (hsupport z y hzy) h
          simp only [hzyv, map_zero]
      have hQv : Q (lp.single 2 y h) x = 0 := by
        change entry (partitionConjugate a 1) x y h = 0
        rw [entryConjApply, ha y, one_apply_eq_self]
        exact DFunLike.congr_fun (hsupport x y ((le_add_of_nonneg_right hradius).trans_lt hxy)) h
      have h1v : (lp.single (E := fun _ : X => E) 2 y h) x = 0 :=
        lp.single_apply_ne (E := fun _ : X => E) 2 y h hne
      change (lp.single (E := fun _ : X => E) 2 y h) x +
        (partitionMap a ((K - 1) ((partitionMap a).adjoint (lp.single 2 y h)))) x = 0
      rw [sub_apply, one_apply_eq_self, map_sub]
      change (lp.single (E := fun _ : X => E) 2 y h) x +
        (L (lp.single 2 y h) x - Q (lp.single 2 y h) x) = 0
      rw [h1v, hLv, hQv, sub_self, add_zero]
    have hAp : PropagationLE (radius + radius) A := by
      intro x y hxy
      have hne : x ≠ y := by
        intro h
        subst y
        exact (not_lt_of_ge (add_nonneg hradius hradius)) (by simpa only [dist_self] using hxy)
      apply ContinuousLinearMap.ext
      intro h
      have hU : U.toContinuousLinearMap.adjoint (lp.single 2 y h) =
          lp.single 2 y (W.toContinuousLinearMap.adjoint h) := by
        apply ext_inner_left ℂ
        intro v
        calc
          inner ℂ v (U.toContinuousLinearMap.adjoint (lp.single 2 y h)) =
              inner ℂ (U.toContinuousLinearMap v) (lp.single 2 y h) :=
            ContinuousLinearMap.adjoint_inner_right _ _ _
          _ = inner ℂ (W (v y)) h := lp.inner_single_right (𝕜 := ℂ)
            (G := fun _ : X => H) y h (U.toContinuousLinearMap v)
          _ = inner ℂ (v y) (W.toContinuousLinearMap.adjoint h) :=
            (ContinuousLinearMap.adjoint_inner_right W.toContinuousLinearMap (v y) h).symm
          _ = inner ℂ v (lp.single 2 y (W.toContinuousLinearMap.adjoint h)) :=
            (lp.inner_single_right (𝕜 := ℂ) (G := fun _ : X => E) y
              (W.toContinuousLinearMap.adjoint h) v).symm
      have hSv : S (lp.single 2 y (W.toContinuousLinearMap.adjoint h)) x = 0 :=
        DFunLike.congr_fun (hSp x y hxy) (W.toContinuousLinearMap.adjoint h)
      have hs : (lp.single (E := fun _ : X => E) 2 y (W.toContinuousLinearMap.adjoint h)) x = 0 :=
        lp.single_apply_ne (E := fun _ : X => E) 2 y (W.toContinuousLinearMap.adjoint h) hne
      have ht : (lp.single (E := fun _ : X => H) 2 y h) x = 0 :=
        lp.single_apply_ne (E := fun _ : X => H) 2 y h hne
      change ((lp.single (E := fun _ : X => H) 2 y h) +
        U.toContinuousLinearMap ((S - 1) (U.toContinuousLinearMap.adjoint (lp.single 2 y h)))) x = 0
      rw [hU]
      change (lp.single (E := fun _ : X => H) 2 y h) x +
        W (S (lp.single 2 y (W.toContinuousLinearMap.adjoint h)) x -
          (lp.single (E := fun _ : X => E) 2 y (W.toContinuousLinearMap.adjoint h)) x) = 0
      rw [ht, hSv, hs, sub_self, map_zero, add_zero]
    have hKc := hcompact KApply
    have first := extensionProperties P K hKs hKc
    have second := extensionProperties U S first.2.1 first.2.2
    have hSn : ‖S‖ ≤ ‖F‖ + 2 := first.1.trans (add_le_add hKn le_rfl)
    have hAn : ‖A‖ ≤ ‖F‖ + 4 := calc
      ‖A‖ ≤ ‖S‖ + 2 := second.1
      _ ≤ (‖F‖ + 2) + 2 := add_le_add hSn le_rfl
      _ = ‖F‖ + 4 := by ring
    exact ⟨hAn, second.2.1, hAp, second.2.2⟩
  let Good (i : ℕ) (Z : Operator (V i) (lp (fun _ : ℕ => ℂ) 2)) : Prop :=
    ‖Z‖ ≤ ‖(c i).operator‖ + 4 ∧ IsSelfAdjoint Z ∧ PropagationLE (r + r) Z ∧
    IsCompactOperator (Z * Z - (1 : Operator (V i) (lp (fun _ : ℕ => ℂ) 2)))
  have properties (i : ℕ) : let T := ampleRipsOperator r (c i) (hπ i); Good i T := by
    intro T
    let cycle := c i
    let a : V i → cycle.space →L[ℂ] cycle.space := representedSqrt r cycle
    let F : cycle.space →L[ℂ] cycle.space := cycle.operator
    let W : cycle.space →ₗᵢ[ℂ] lp (fun _ : ℕ => ℂ) 2 := ampleIsometry cycle.space
    have hFi : IsSelfAdjoint F := hF i
    have hπi : cycle.representation 1 = 1 := hπ i
    have hsqrt (x : V i) : IsSelfAdjoint (sqrtCoordinate r x) := by
      ext p
      simp [sqrtCoordinate]
    have hsum : ∑ x : V i, sqrtCoordinate r x * sqrtCoordinate r x = 1 := by
      ext p
      change (ContinuousMap.evalAlgHom ℂ ℂ p) (∑ x : V i, sqrtCoordinate r x * sqrtCoordinate r x) = 1
      rw [map_sum]
      simp only [map_mul]
      change (∑ x : V i, (Real.sqrt (p.weight x) : ℂ) * (Real.sqrt (p.weight x) : ℂ)) = 1
      simp only [← Complex.ofReal_mul, Real.mul_self_sqrt (p.nonneg _)]
      have htotal : ∑ x : V i, p.weight x = 1 := by
        rw [← p.total]
        exact (p.weight.sum_fintype (fun _ t => t) (by simp)).symm
      rw [← Complex.ofReal_sum, htotal, Complex.ofReal_one]
    have hadj (x : V i) : (a x).adjoint = a x := by
      change (cycle.representation (sqrtCoordinate r x)).adjoint = cycle.representation (sqrtCoordinate r x)
      exact ((hsqrt x).map cycle.representation).star_eq
    have hrep : ∑ x : V i, a x * a x = 1 := by
      change (∑ x : V i, cycle.representation (sqrtCoordinate r x) *
        cycle.representation (sqrtCoordinate r x)) = 1
      simp only [← map_mul, ← map_sum, hsum, hπi]
    have hpart : ∑ x : V i, (a x).adjoint.comp (a x) = 1 := by
      change (∑ x : V i, (a x).adjoint * a x) = 1
      simpa only [hadj] using hrep
    have support (x y : V i) (hxy : r < dist x y) : a x * a y = 0 := by
      have hz : sqrtCoordinate r x * sqrtCoordinate r y = 0 := by
        ext p
        have hp : p.weight x = 0 ∨ p.weight y = 0 := by
          by_contra h
          push Not at h
          exact (not_le_of_gt hxy) (p.diameter x (Finsupp.mem_support_iff.mpr h.1)
            y (Finsupp.mem_support_iff.mpr h.2))
        rcases hp with hx | hy
        · simp [sqrtCoordinate, hx]
        · simp [sqrtCoordinate, hy]
      change cycle.representation (sqrtCoordinate r x) * cycle.representation (sqrtCoordinate r y) = 0
      exact (map_mul cycle.representation _ _).symm.trans
        ((congrArg cycle.representation hz).trans (map_zero cycle.representation))
    have hcompact (KApply : ∀ v : cycle.space, partitionCompression a F v =
        ∑ x : V i, (a x).adjoint (F ((a x) v))) :
        IsCompactOperator (partitionCompression a F * partitionCompression a F -
          (1 : cycle.space →L[ℂ] cycle.space)) := by
      let K := partitionCompression a F
      let G := localizedOperator cycle (sqrtCoordinate r)
      have hKloc : K = G := by
        apply ContinuousLinearMap.ext
        intro v
        change partitionCompression a F v = G v
        rw [KApply]
        change (∑ x : V i, (a x).adjoint (F ((a x) v))) =
          (∑ x : V i, cycle.representation (sqrtCoordinate r x) * F * cycle.representation (sqrtCoordinate r x)) v
        simp only [sum_apply, hadj]
        apply Finset.sum_congr rfl
        intro x _
        rfl
      let d := localizedCycle cycle (sqrtCoordinate r) hFi hsqrt hrep
      have hd := d.square_compact 1
      change IsCompactOperator (((F + (G - F)) * (F + (G - F)) - (1 : cycle.space →L[ℂ] cycle.space)) *
        cycle.representation 1) at hd
      have hsumFG : F + (G - F) = G := by abel
      have hGc : IsCompactOperator (G * G - (1 : cycle.space →L[ℂ] cycle.space)) := by
        simpa only [hsumFG, hπi, mul_one] using hd
      exact (congrArg (fun Q : cycle.space →L[ℂ] cycle.space => Q * Q - 1) hKloc).symm ▸ hGc
    let K := partitionCompression a F
    let P := partitionIsometry a hpart
    let S := isometricExtension P K
    let U := coefficientIsometry (X := V i) W
    let A := isometricExtension U S
    have facts := spatialProperties W a hpart F hFi r hr hadj support hcompact
    have result : Good i A := facts
    have hAeq : A = T := rfl
    rw [← hAeq]
    exact result
  exact separatedFamilyBoundary o (fun i => ampleRipsOperator r (c i) (hπ i))
    (C + 4) (add_nonneg hC (by norm_num))
    (fun i => (properties i).1.trans (add_le_add (hnorm i) le_rfl))
    (r + r) (add_nonneg hr hr) (fun i => (properties i).2.2.1)
    (fun i => (properties i).2.1) (fun i => (properties i).2.2.2)

end CoarseAssembly.Rips

end
