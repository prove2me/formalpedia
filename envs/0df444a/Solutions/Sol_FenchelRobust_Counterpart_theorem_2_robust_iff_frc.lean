/-- The cone generated by the first projection of `P`, as a submodule. -/
def coneSub {V : Type*} [AddCommGroup V] [Module ℝ V] (P : Set (V × ℝ)) (hP : Convex ℝ P)
    (hne : ∃ s, ((0 : V), s) ∈ P)
    (hri : ∀ p ∈ P, ∃ ε > (0 : ℝ), ∃ s, (-ε • p.1, s) ∈ P) : Submodule ℝ V where
  carrier := {b | ∃ r > (0 : ℝ), ∃ t, (r • b, t) ∈ P}
  zero_mem' := by
    obtain ⟨s, hs⟩ := hne
    exact ⟨1, one_pos, s, by simpa using hs⟩
  add_mem' := by
    rintro x y ⟨r, hr, t, ht⟩ ⟨s, hs, t', ht'⟩
    refine ⟨r * s / (r + s), by positivity, (s * t + r * t') / (r + s), ?_⟩
    have h := hP ht ht' (a := s / (r + s)) (b := r / (r + s)) (by positivity) (by positivity)
      (by rw [← add_div, div_eq_one_iff_eq (by positivity)]; ring)
    have e : ((r * s / (r + s)) • (x + y), (s * t + r * t') / (r + s))
        = (s / (r + s)) • (r • x, t) + (r / (r + s)) • (s • y, t') := by
      rw [Prod.smul_mk, Prod.smul_mk, Prod.mk_add_mk, smul_add, smul_smul, smul_smul,
        smul_eq_mul, smul_eq_mul]
      congr 1
      · congr 2 <;> field_simp
      · field_simp
    rw [e]; exact h
  smul_mem' := by
    rintro c b ⟨r, hr, t, ht⟩
    rcases lt_trichotomy c 0 with hc | rfl | hc
    · obtain ⟨ε, hε, s, hs⟩ := hri _ ht
      have hc' : 0 < -c := neg_pos.mpr hc
      refine ⟨ε * r / (-c), by positivity, s, ?_⟩
      have e : (ε * r / (-c)) • (c • b) = -ε • (r • b, t).1 := by
        simp only [smul_smul]
        congr 1
        have hc0 : c ≠ 0 := hc.ne
        field_simp
      rw [e]; exact hs
    · obtain ⟨s, hs⟩ := hne
      exact ⟨1, one_pos, s, by simpa using hs⟩
    · refine ⟨r / c, by positivity, t, ?_⟩
      rw [smul_smul, div_mul_cancel₀ _ hc.ne']; exact ht

/-- The set of slopes defining the sublinear functional. -/
def slopes {V : Type*} [AddCommGroup V] [Module ℝ V] (P : Set (V × ℝ)) (b : V) : Set ℝ :=
  {α | ∃ r > (0 : ℝ), ∃ t, (r • b, t) ∈ P ∧ α = -t / r}

theorem slopes_bdd {V : Type*} [AddCommGroup V] [Module ℝ V] (P : Set (V × ℝ))
    (hP : Convex ℝ P) (h0 : ∀ t, ((0 : V), t) ∈ P → t ≤ 0)
    (hri : ∀ p ∈ P, ∃ ε > (0 : ℝ), ∃ s, (-ε • p.1, s) ∈ P) (b : V)
    (hb : ∃ r > (0 : ℝ), ∃ t, (r • b, t) ∈ P) : BddBelow (slopes P b) := by
  obtain ⟨r0, hr0, t0, ht0⟩ := hb
  obtain ⟨ε, hε, s0, hs0⟩ := hri _ ht0
  set e := ε * r0 with he
  have hepos : 0 < e := by positivity
  refine ⟨s0 / e, ?_⟩
  rintro α ⟨r, hr, t, ht, rfl⟩
  have h := hP ht hs0 (a := e / (r + e)) (b := r / (r + e)) (by positivity) (by positivity)
    (by rw [← add_div, div_eq_one_iff_eq (by positivity)]; ring)
  have e1 : (e / (r + e)) • (r • b, t) + (r / (r + e)) • (-ε • (r0 • b, t0).1, s0)
      = ((0 : V), (e * t + r * s0) / (r + e)) := by
    rw [Prod.smul_mk, Prod.smul_mk, Prod.mk_add_mk]
    simp only [smul_smul, ← add_smul, smul_eq_mul]
    congr 1
    · have : e / (r + e) * r + r / (r + e) * (-ε * r0) = 0 := by
        rw [he]; field_simp; ring
      rw [this, zero_smul]
    · field_simp
  rw [e1] at h
  have h2 := h0 _ h
  have h3 : e * t + r * s0 ≤ 0 := by
    have : 0 < r + e := by positivity
    have := (div_nonpos_iff.mp h2)
    rcases this with ⟨_, h4⟩ | ⟨h4, _⟩
    · linarith
    · exact h4
  rw [div_le_div_iff₀ hepos hr]
  nlinarith

theorem exists_linear_majorant {V : Type*} [AddCommGroup V] [Module ℝ V] (P : Set (V × ℝ))
    (hP : Convex ℝ P) (h0 : ∀ t, ((0 : V), t) ∈ P → t ≤ 0) (hne : ∃ s, ((0 : V), s) ∈ P)
    (hri : ∀ p ∈ P, ∃ ε > (0 : ℝ), ∃ s, (-ε • p.1, s) ∈ P) :
    ∃ G : V →ₗ[ℝ] ℝ, ∀ p ∈ P, p.2 ≤ G p.1 := by
  set K := coneSub P hP hne hri with hK
  let N : K → ℝ := fun b => sInf (slopes P (b : V))
  have hSne : ∀ b : K, (slopes P (b : V)).Nonempty := by
    rintro ⟨b, r, hr, t, ht⟩
    exact ⟨-t / r, r, hr, t, ht, rfl⟩
  have hSbdd : ∀ b : K, BddBelow (slopes P (b : V)) := fun b =>
    slopes_bdd P hP h0 hri b b.2
  have hom : ∀ c : ℝ, 0 < c → ∀ x : K, N (c • x) = c * N x := by
    intro c hc x
    have hset : slopes P ((c • x : K) : V) = c • slopes P (x : V) := by
      ext α
      rw [Set.mem_smul_set]
      constructor
      · rintro ⟨r, hr, t, ht, rfl⟩
        refine ⟨-t / (r * c), ⟨r * c, by positivity, t, ?_, rfl⟩, ?_⟩
        · rw [← smul_smul]; simpa using ht
        · rw [smul_eq_mul]; field_simp
      · rintro ⟨β, ⟨r, hr, t, ht, rfl⟩, rfl⟩
        refine ⟨r / c, by positivity, t, ?_, ?_⟩
        · rw [Submodule.coe_smul, smul_smul, div_mul_cancel₀ _ hc.ne']; exact ht
        · rw [smul_eq_mul]; field_simp
    show sInf (slopes P ((c • x : K) : V)) = c * sInf (slopes P (x : V))
    rw [hset, Real.sInf_smul_of_nonneg hc.le, smul_eq_mul]
  have hadd : ∀ x y : K, N (x + y) ≤ N x + N y := by
    intro x y
    have key : ∀ α ∈ slopes P (x : V), ∀ β ∈ slopes P (y : V), N (x + y) ≤ α + β := by
      rintro α ⟨r, hr, t, ht, rfl⟩ β ⟨s, hs, t', ht', rfl⟩
      apply csInf_le (hSbdd _)
      refine ⟨r * s / (r + s), by positivity, (s * t + r * t') / (r + s), ?_, ?_⟩
      · have h := hP ht ht' (a := s / (r + s)) (b := r / (r + s)) (by positivity)
          (by positivity) (by rw [← add_div, div_eq_one_iff_eq (by positivity)]; ring)
        have e : ((r * s / (r + s)) • ((x + y : K) : V), (s * t + r * t') / (r + s))
            = (s / (r + s)) • (r • (x : V), t) + (r / (r + s)) • (s • (y : V), t') := by
          rw [Submodule.coe_add, Prod.smul_mk, Prod.smul_mk, Prod.mk_add_mk, smul_add, smul_smul,
            smul_smul, smul_eq_mul, smul_eq_mul]
          congr 1
          · congr 2 <;> field_simp
          · field_simp
        rw [e]; exact h
      · field_simp
        ring
    have k1 : ∀ β ∈ slopes P (y : V), N (x + y) - β ≤ N x := by
      intro β hβ
      exact le_csInf (hSne x) fun α hα => by linarith [key α hα β hβ]
    have k2 : N (x + y) - N x ≤ N y :=
      le_csInf (hSne y) fun β hβ => by linarith [k1 β hβ]
    linarith
  have hf : ∀ z : (⊥ : Submodule ℝ K), (0 : (⊥ : Submodule ℝ K) →ₗ[ℝ] ℝ) z ≤ N z := by
    rintro ⟨z, hz⟩
    rw [Submodule.mem_bot] at hz
    subst hz
    simp only [LinearMap.zero_apply]
    show 0 ≤ sInf (slopes P (((0 : K)) : V))
    apply le_csInf (hSne 0)
    rintro α ⟨r, hr, t, ht, rfl⟩
    have : t ≤ 0 := h0 t (by simpa using ht)
    have : 0 ≤ -t := by linarith
    positivity
  obtain ⟨g, -, hg⟩ := exists_extension_of_le_sublinear
    (⟨⊥, 0⟩ : K →ₗ.[ℝ] ℝ) N hom hadd hf
  obtain ⟨G, hG⟩ := LinearMap.exists_extend (-g)
  refine ⟨G, fun p hp => ?_⟩
  have hpK : p.1 ∈ K := ⟨1, one_pos, p.2, by simpa using hp⟩
  have h1 : N ⟨p.1, hpK⟩ ≤ -p.2 :=
    csInf_le (hSbdd _) ⟨1, one_pos, p.2, by simpa using hp, by simp⟩
  have h2 := hg ⟨p.1, hpK⟩
  have h3 : G p.1 = -g ⟨p.1, hpK⟩ := by
    have := congrArg (fun F => F ⟨p.1, hpK⟩) hG
    simpa using this
  linarith

theorem ri_line {m : ℕ} {S : Set (Fin m → ℝ)} {a0 a : Fin m → ℝ}
    (h : a0 ∈ intrinsicInterior ℝ S) (ha : a ∈ S) :
    ∀ᶠ δ in nhds (0 : ℝ), AffineMap.lineMap a0 a (-δ) ∈ S := by
  obtain ⟨y, hy, rfl⟩ := mem_intrinsicInterior.mp h
  have hmem : ∀ δ : ℝ, AffineMap.lineMap (y : Fin m → ℝ) a (-δ) ∈ affineSpan ℝ S := fun δ =>
    AffineMap.lineMap_mem _ y.2 (subset_affineSpan ℝ S ha)
  let F : ℝ → affineSpan ℝ S := fun δ => ⟨_, hmem δ⟩
  have hF : Continuous F := by
    apply Continuous.subtype_mk
    simp only [AffineMap.lineMap_apply_module]
    fun_prop
  have hF0 : F 0 = y := Subtype.ext (by simp [F])
  have hpre : F ⁻¹' interior ((↑) ⁻¹' S : Set (affineSpan ℝ S)) ∈ nhds (0 : ℝ) := by
    apply hF.continuousAt.preimage_mem_nhds
    rw [hF0]; exact isOpen_interior.mem_nhds hy
  filter_upwards [hpre] with δ hδ
  exact (interior_subset hδ : F δ ∈ ((↑) ⁻¹' S : Set (affineSpan ℝ S)))

theorem dot_rep {m : ℕ} (G : (Fin m → ℝ) →ₗ[ℝ] ℝ) :
    ∃ v : Fin m → ℝ, ∀ b, G b = b ⬝ᵥ v := by
  refine ⟨fun i => G (fun j => if i = j then 1 else 0), fun b => ?_⟩
  rw [LinearMap.pi_apply_eq_sum_univ G b]
  simp [dotProduct, smul_eq_mul]

