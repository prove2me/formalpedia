-- title:
--   Lemma 9, p. 15 — last arrow x̌ → q: ‖q‖^{λ,K}_F ≤ (1 + (√n/λ)√(L(1+η)/(μ̄η) + (μ̂/μ̄)β))‖x̌‖^{λ,K}_F + 2√n‖x̄(0) − x*‖_F
-- statement:
--   Let Assumptions 1, 4 and 5 hold, let $x^*$ minimize $f=\frac1n\sum_if_i$, and let $(\mathbf x(k),\mathbf y(k))$ be generated by DIGing (Algorithm 1) with step size $\alpha>0$. Let $\beta>0$, $\eta>0$ and $\lambda$ satisfy
--   $$\sqrt{1-\frac{\alpha\bar\mu\beta}{\beta+1}}\le\lambda<1,\qquad\alpha\le\frac1{(1+\eta)\bar L}.$$
--   Then with $\mathbf q(k)=\mathbf x(k)-\mathbf 1(x^*)^\top$, $\check{\mathbf x}(k)=\mathbf x(k)-\mathbf 1\bar x(k)^\top$ and $\bar x(0)$ the average of the initial rows, for every $K=0,1,\dots$
--   $$\|\mathbf q\|_F^{\lambda,K}\le\Big(1+\frac{\sqrt n}{\lambda}\sqrt{\frac{L(1+\eta)}{\bar\mu\eta}+\frac{\hat\mu}{\bar\mu}\beta}\Big)\|\check{\mathbf x}\|_F^{\lambda,K}+2\sqrt n\,\|\bar x(0)-x^*\|.$$
--
--   This closes the cycle of arrows $\mathbf q\to\mathbf z\to\check{\mathbf y}\to\check{\mathbf x}\to\mathbf q$: because $\mathbf y(0)=\nabla\mathbf f(\mathbf x(0))$, the average $\bar x(k)$ follows an inexact gradient method, and Lemma 8 turns consensus of the iterates into convergence to the optimum.
--
--   **Formalization Note.** The initialization $\mathbf y(0)=\nabla\mathbf f(\mathbf x(0))$ is part of the DIGing run and is essential. $\lambda>0$ is not assumed: for $p\ge1$ it follows from the hypotheses (since $\mu_i\le L_i$), and for $p=0$ every norm vanishes.
-- source:
--   Nedić, Olshevsky & Shi, arXiv:1607.03218v3, Lemma 9, display (33), p. 15

import Mathlib
import Definitions.Def_DIGing_Undir_Common
import Definitions.Def_DIGing_Undir_Setting

namespace DIGing.Undir

theorem lemma_9 {n p : ℕ} (f : Fin n → EuclideanSpace ℝ (Fin p) → ℝ) (Lc mu : Fin n → ℝ)
    (h4 : Assumption4 f Lc) (h5 : Assumption5 f mu)
    (xstar : EuclideanSpace ℝ (Fin p)) (hopt : ∀ z, objective f xstar ≤ objective f z)
    (E : ℕ → SimpleGraph (Fin n)) (W : ℕ → Matrix (Fin n) (Fin n) ℝ) (B : ℕ)
    (h1 : Assumption1 E W B)
    (α : ℝ) (hα : 0 < α) (x y : ℕ → Stack n p) (hrun : IsDIGingRun f W α x y)
    (β η lam : ℝ) (hβ : 0 < β) (hη : 0 < η)
    (hlam : Real.sqrt (1 - α * mubar mu * β / (β + 1)) ≤ lam) (hlam1 : lam < 1)
    (hαL : α ≤ 1 / ((1 + η) * Lbar Lc)) :
    ∀ K : ℕ, ergK lam K (fun k => frob (x k - ones xstar)) ≤
      (1 + Real.sqrt n / lam *
          Real.sqrt (Lmax Lc * (1 + η) / (mubar mu * η) + muhat mu / mubar mu * β)) *
        ergK lam K (fun k => frob (cons (x k))) +
      2 * Real.sqrt n * ‖avg (x 0) - xstar‖ := by sorry

end DIGing.Undir
