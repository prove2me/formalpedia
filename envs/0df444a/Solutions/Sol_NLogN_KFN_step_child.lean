theorem roleOpF_blockOp (st : Fin m × κ → ℕ) (n : ℕ) (A : Fin W → Butterfly.Op (Fin m × κ))
    (X : Fin W → List M) (w : Fin W) :
    roleOpF st n (blockOp A) X w = selOpF st n (A w) (X w) := by
  simp only [roleOpF, selOpF]
  refine List.map_congr_left fun j _ => ?_
  rw [Fintype.sum_prod_type, Finset.sum_eq_single w]
  · simp [blockOp]
  · intro v _ hv
    refine Finset.sum_eq_zero fun y _ => ?_
    simp [blockOp, Ne.symm hv]
  · simp

theorem roleOpF_wireOp (st : Fin m × κ → ℕ) (n : ℕ) (w : Fin W) (A : Butterfly.Op (Fin m × κ))
    {X : Fin W → List M} (hX : ∀ w, (X w).length = n) :
    roleOpF st n (wireOp w A) X = Function.update X w (selOpF st n A (X w)) := by
  funext v
  rw [wireOp, roleOpF_blockOp]
  by_cases hv : v = w
  · subst hv; simp
  · rw [if_neg hv, Function.update_of_ne hv, selOpF_one (hX v)]

/-- A child call acts on one role with the strides of its slot. -/
theorem roleOpF_childR (st : Fin m × κ → ℕ) (n : ℕ) (w : Fin W) (h : Fin m) (T : Butterfly.Op κ)
    {X : Fin W → List M} (hX : ∀ w, (X w).length = n) :
    roleOpF st n (RStep.childR w h T) X =
      Function.update X w (selOpF (fun c => st (h, c)) n T (X w)) := by
  rw [childR_eq, roleOpF_wireOp _ _ _ _ hX, slotOp_eq_subOp,
    selOpF_subOp (fun a b e => (Prod.mk.inj e).2)]
  rfl

theorem roleOpF_child (st : Fin m × κ → ℕ) (n : ℕ) (w : Fin W) (h : Fin m) (fwd : Bool)
    {X : Fin W → List M} (hX : ∀ w, (X w).length = n) :
    roleOpF st n ((RStep.child w h fwd : RStep (Fin W) m).den (Butterfly.tens Cm : Butterfly.Op κ)) X =
      Function.update X w (selOpF (fun c => st (h, c)) n
        (if fwd then Butterfly.tens Cm else Butterfly.tens Cinv : Butterfly.Op κ) (X w)) := by
  cases fwd
  · rw [den_child_false, ← childR_eq, roleOpF_childR _ _ _ _ _ hX]; rfl
  · rw [den_child_true, ← childR_eq, roleOpF_childR _ _ _ _ _ hX]; rfl

