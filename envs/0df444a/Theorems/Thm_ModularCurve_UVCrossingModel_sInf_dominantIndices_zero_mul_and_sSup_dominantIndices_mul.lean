-- title:
--   Additivity of extremal dominant indices at the annulus ends
-- statement:
--   Let $W$ be a commutative domain which is a discrete valuation ring, complete for the adic topology of its maximal ideal, let $\varpi \in W$ be irreducible, and let $e \ge 1$ be a natural number; write $R = \mathrm{UVCrossingModel}\ W\ (\varpi^e)$ for the quotient of the two-variable power series ring $W[[X_0,X_1]]$ by the ideal generated by $X_0X_1 - \varpi^e$, and $v =$ `IsDiscreteValuationRing.addVal W` for the additive valuation of $W$ with values in $\mathbb{N}\cup\{\infty\}$. Let $x, y \in R$ be nonzero, and let $ab = (a,b)$, $ab' = (a',b')$, $ab'' = (a'',b'')$ be pairs of one-variable power series over $W$ whose second components have vanishing constant coefficient and which represent $x$, $y$ and $xy$ respectively, in the sense that the class of $\mathrm{inU}\,a + \mathrm{inV}\,b$ in $R$ is $x$ (and likewise for $y$ and for $xy$), where $\mathrm{inU}\,a = \sum_i a_i X_0^i$ and $\mathrm{inV}\,b = \sum_j b_j X_1^j$. For a pair $ab$ and parameters $E, t$, the set $\mathrm{dominantIndices}\ v\ E\ t\ ab \subseteq \mathbb{Z}$ consists of those $n$ for which the term order $v(\mathrm{nfCoeff}\ ab\ n) + \mathrm{annulusWeight}\ E\ t\ (\mathrm{nfExponent}\ n)$ equals $\mathrm{repGaussOrder}\ v\ E\ t\ (\mathrm{inU}\,a + \mathrm{inV}\,b)$, the infimum over all multi-indices $d$ of $v(\text{coefficient of } d) + \mathrm{annulusWeight}\ E\ t\ d$. The conclusion is the conjunction of two identities in $\mathbb{Z}$: the infimum of $\mathrm{dominantIndices}\ v\ e\ 0\ ab''$ is the sum of the infima of $\mathrm{dominantIndices}\ v\ e\ 0\ ab$ and $\mathrm{dominantIndices}\ v\ e\ 0\ ab'$, and the supremum of $\mathrm{dominantIndices}\ v\ e\ e\ ab''$ is the sum of the suprema of $\mathrm{dominantIndices}\ v\ e\ e\ ab$ and $\mathrm{dominantIndices}\ v\ e\ e\ ab'$.
--
--   This is the additivity, under multiplication in the crossing model $W[[U,V]]/(UV-\varpi^e)$, of the two end slopes of the Gauss polygon: the least dominant index at the end $t = 0$ of the annulus (the branch $V = 0$) and the greatest dominant index at the other end $t = e$ (the branch $U = 0$). It is used to compute the order of residues along the two branches in the node annulus formalism, and in the slope-drop identities for prolongation tuples at specialised places.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_UVCrossingModel_sInf_dominantIndices_zero_mul_and_sSup_dominantIndices_mul.lean

import Mathlib
import Definitions.Def_ModularCurve_UVCrossingModel
import Definitions.Def_ModularCurve_UVCrossingGaussOrder
import Definitions.Def_ModularCurve_UVCrossingDominantIndices

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open ModularCurve ModularCurve.UVCrossingModel IsLocalRing

theorem ModularCurve.UVCrossingModel.sInf_dominantIndices_zero_mul_and_sSup_dominantIndices_mul
    {W : Type u} [CommRing W] [IsDomain W] [IsDiscreteValuationRing W] [IsAdicComplete (maximalIdeal W) W]
    (ϖ : W) (hϖ : Irreducible ϖ) (e : ℕ) (he : 1 ≤ e)
    (x : UVCrossingModel W (ϖ ^ e)) (hx : x ≠ 0)
    (ab : PowerSeries W × PowerSeries W) (hb : PowerSeries.constantCoeff ab.2 = 0)
    (habx : mk (ϖ ^ e) (inU ab.1 + inV ab.2) = x)
    (y : UVCrossingModel W (ϖ ^ e)) (hy : y ≠ 0)
    (ab' : PowerSeries W × PowerSeries W) (hb' : PowerSeries.constantCoeff ab'.2 = 0)
    (haby : mk (ϖ ^ e) (inU ab'.1 + inV ab'.2) = y)
    (ab'' : PowerSeries W × PowerSeries W) (hb'' : PowerSeries.constantCoeff ab''.2 = 0)
    (habxy : mk (ϖ ^ e) (inU ab''.1 + inV ab''.2) = x * y) :
    sInf (dominantIndices (IsDiscreteValuationRing.addVal W) e 0 ab'') =
        sInf (dominantIndices (IsDiscreteValuationRing.addVal W) e 0 ab) +
          sInf (dominantIndices (IsDiscreteValuationRing.addVal W) e 0 ab') ∧
      sSup (dominantIndices (IsDiscreteValuationRing.addVal W) e e ab'') =
        sSup (dominantIndices (IsDiscreteValuationRing.addVal W) e e ab) +
          sSup (dominantIndices (IsDiscreteValuationRing.addVal W) e e ab') := by sorry
