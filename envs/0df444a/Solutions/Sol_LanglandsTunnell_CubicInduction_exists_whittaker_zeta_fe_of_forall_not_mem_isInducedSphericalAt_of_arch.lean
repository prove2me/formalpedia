private def shellTerm (N : ℕ) (τ : ℤ → ℂ) (u : ℂˣ) (s : ℂ) (m : ℤ) : ℂ :=
  τ m * ((u ^ m : ℂˣ) : ℂ) * (((((N : ℕ) : ℝ)⁻¹ ^ m : ℝ)) : ℂ) ^ (s - 1)

private def shellVar (N : ℕ) (u : ℂˣ) (s : ℂ) : ℂ :=
  (u : ℂ) * ((((N : ℕ) : ℝ)⁻¹ : ℝ) : ℂ) ^ (s - 1)

private theorem shellTerm_of_neg (N : ℕ) {τ : ℤ → ℂ} (hτ0 : ∀ m : ℤ, m < 0 → τ m = 0) (u : ℂˣ) (s : ℂ) {m : ℤ}
    (hm : m < 0) : shellTerm N τ u s m = 0 := by
  simp [shellTerm, hτ0 m hm]

private theorem shellTerm_zero (N : ℕ) {τ : ℤ → ℂ} (hτ1 : τ 0 = 1) (u : ℂˣ) (s : ℂ) : shellTerm N τ u s 0 = 1 := by
  simp [shellTerm, hτ1]

private theorem shellTerm_natCast (N : ℕ) (τ : ℤ → ℂ) (u : ℂˣ) (s : ℂ) (n : ℕ) :
    shellTerm N τ u s n = τ n * shellVar N u s ^ n := by
  have hr : (0 : ℝ) ≤ ((N : ℕ) : ℝ)⁻¹ := inv_nonneg.mpr (Nat.cast_nonneg N)
  have hcpow : ((((((N : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1))
      = (((((N : ℕ) : ℝ)⁻¹ : ℝ) : ℂ) ^ (s - 1)) ^ n := by
    rw [← Real.rpow_natCast, ← Complex.cpow_mul_ofReal_nonneg hr, Complex.ofReal_natCast,
      Complex.cpow_nat_mul]
  simp only [shellTerm, zpow_natCast, Units.val_pow_eq_pow_val]
  rw [hcpow, shellVar, mul_pow, mul_assoc]

private theorem hasSum_int_of_hasSum_nat_real {f : ℤ → ℝ} (hf : ∀ m : ℤ, m < 0 → f m = 0) {L : ℝ}
    (h : HasSum (fun n : ℕ => f n) L) : HasSum f L := by
  refine (Function.Injective.hasSum_iff Nat.cast_injective ?_).mp h
  intro m hm
  refine hf m (lt_of_not_ge fun h0 => hm ?_)
  exact ⟨m.toNat, Int.toNat_of_nonneg h0⟩

private def radius (N : ℕ) (A : ℝ) (u : ℂˣ) (s : ℂ) : ℝ := ‖shellVar N u s‖ * A

private theorem radius_nonneg (N : ℕ) {A : ℝ} (hA0 : 0 ≤ A) (u : ℂˣ) (s : ℂ) : 0 ≤ radius N A u s :=
  mul_nonneg (norm_nonneg _) hA0

private theorem radius_le (N : ℕ) (hN : 2 ≤ N) {A : ℝ} (hA0 : 0 ≤ A) (u : ℂˣ) {κ τ₀ : ℝ}
    (hA : A ≤ 2 * (N : ℝ) ^ κ) (hu : ‖(u : ℂ)‖ ≤ (N : ℝ) ^ τ₀) (s : ℂ) (hs : κ + τ₀ + 4 ≤ s.re) :
    radius N A u s ≤ 2 * (N : ℝ) ^ (-(3 : ℝ)) := by
  have hNpos : (0 : ℝ) < N := by exact_mod_cast (show 0 < N by omega)
  have hN1 : (1 : ℝ) ≤ N := by exact_mod_cast (show 1 ≤ N by omega)
  have hZ : ‖((((N : ℕ) : ℝ)⁻¹ : ℝ) : ℂ) ^ (s - 1)‖ = (N : ℝ) ^ (1 - s.re) := by
    rw [Complex.norm_cpow_eq_rpow_re_of_pos (inv_pos.mpr hNpos), Complex.sub_re, Complex.one_re,
      Real.inv_rpow hNpos.le, ← Real.rpow_neg hNpos.le, neg_sub]
  have hY : ‖shellVar N u s‖ ≤ (N : ℝ) ^ (τ₀ + (1 - s.re)) := by
    rw [shellVar, norm_mul, hZ, Real.rpow_add hNpos]
    gcongr
  calc radius N A u s ≤ (N : ℝ) ^ (τ₀ + (1 - s.re)) * (2 * (N : ℝ) ^ κ) :=
        mul_le_mul hY hA hA0 (Real.rpow_nonneg hNpos.le _)
    _ = 2 * (N : ℝ) ^ (τ₀ + (1 - s.re) + κ) := by simp only [Real.rpow_add hNpos]; ring
    _ ≤ 2 * (N : ℝ) ^ (-(3 : ℝ)) :=
        mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hN1 (by linarith)) (by norm_num)

private theorem two_rpow_le (N : ℕ) (hN : 2 ≤ N) : 2 * (N : ℝ) ^ (-(3 : ℝ)) ≤ 1 / 4 := by
  have hN2 : (2 : ℝ) ≤ N := by exact_mod_cast hN
  rw [Real.rpow_neg (by positivity), Real.rpow_ofNat]
  have h8 : (8 : ℝ) ≤ (N : ℝ) ^ 3 := by
    calc (8 : ℝ) = 2 ^ 3 := by norm_num
      _ ≤ (N : ℝ) ^ 3 := by gcongr
  have hpos : (0 : ℝ) < (N : ℝ) ^ 3 := by positivity
  rw [← div_eq_mul_inv, div_le_iff₀ hpos]
  linarith

private theorem norm_shellTerm_natCast_le (N : ℕ) {τ : ℤ → ℂ} {A : ℝ} (hτ : ∀ n : ℕ, ‖τ n‖ ≤ A ^ n) (u : ℂˣ)
    (s : ℂ) (n : ℕ) : ‖shellTerm N τ u s n‖ ≤ radius N A u s ^ n := by
  rw [shellTerm_natCast, radius, norm_mul, norm_pow, mul_pow, mul_comm]
  gcongr
  exact hτ n

private theorem norm_shellTerm_neg_eq_zero (N : ℕ) {τ : ℤ → ℂ} (hτ0 : ∀ m : ℤ, m < 0 → τ m = 0) (u : ℂˣ)
    (s : ℂ) : ∀ m : ℤ, m < 0 → ‖shellTerm N τ u s m‖ = 0 := fun _ hm => by
  rw [shellTerm_of_neg N hτ0 u s hm, norm_zero]

private theorem summable_norm_shellTerm_and_tsum_le (N : ℕ) (hN : 2 ≤ N) {τ : ℤ → ℂ}
    (hτ0 : ∀ m : ℤ, m < 0 → τ m = 0) {A : ℝ} (hA0 : 0 ≤ A) (hτ : ∀ n : ℕ, ‖τ n‖ ≤ A ^ n) (u : ℂˣ) {κ τ₀ : ℝ}
    (hA : A ≤ 2 * (N : ℝ) ^ κ) (hu : ‖(u : ℂ)‖ ≤ (N : ℝ) ^ τ₀) (s : ℂ) (hs : κ + τ₀ + 4 ≤ s.re) :
    (Summable fun m : ℤ => ‖shellTerm N τ u s m‖) ∧
      ∑' m : ℤ, ‖shellTerm N τ u s m‖ ≤ 1 + 4 * (N : ℝ) ^ (-(3 : ℝ)) := by
  have hx0 := radius_nonneg N hA0 u s
  have hx2 := radius_le N hN hA0 u hA hu s hs
  have hx4 : radius N A u s ≤ 1 / 4 := hx2.trans (two_rpow_le N hN)
  have hx1 : radius N A u s < 1 := by linarith
  have hgeom : Summable fun n : ℕ => radius N A u s ^ n := summable_geometric_of_lt_one hx0 hx1
  have hle := norm_shellTerm_natCast_le N hτ u s
  have hnat : Summable fun n : ℕ => ‖shellTerm N τ u s n‖ :=
    hgeom.of_nonneg_of_le (fun _ => norm_nonneg _) hle
  have hint := hasSum_int_of_hasSum_nat_real (norm_shellTerm_neg_eq_zero N hτ0 u s) hnat.hasSum
  refine ⟨hint.summable, ?_⟩
  rw [hint.tsum_eq]
  calc ∑' n : ℕ, ‖shellTerm N τ u s n‖ ≤ ∑' n : ℕ, radius N A u s ^ n := hnat.tsum_le_tsum hle hgeom
    _ = (1 - radius N A u s)⁻¹ := tsum_geometric_of_lt_one hx0 hx1
    _ ≤ 1 + 2 * radius N A u s := by
        rw [inv_le_iff_one_le_mul₀ (by linarith)]
        nlinarith
    _ ≤ 1 + 4 * (N : ℝ) ^ (-(3 : ℝ)) := by linarith

end

