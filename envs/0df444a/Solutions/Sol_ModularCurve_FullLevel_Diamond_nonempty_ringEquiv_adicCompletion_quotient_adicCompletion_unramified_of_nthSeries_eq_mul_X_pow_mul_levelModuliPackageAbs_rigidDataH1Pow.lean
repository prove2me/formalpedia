theorem CompBC.minimalPrime_le_pow_of_isDomain_adicCompletion
    (S : Type*) [CommRing S] [IsNoetherianRing S]
    (𝔮 : Ideal S) (h𝔮 : 𝔮 ∈ minimalPrimes S) (x : Ideal S) [x.IsMaximal] (hle : 𝔮 ≤ x)
    (hdom : IsDomain (AdicCompletion x S)) (n : ℕ) : 𝔮 ≤ x ^ n := by
  classical
  haveI := hdom
  have hkerP : ∀ a : S, algebraMap S (AdicCompletion x S) a = 0 ↔ ∀ n : ℕ, a ∈ x ^ n := by
    intro a
    rw [AdicCompletion.ext_iff]
    refine forall_congr' (fun n => ?_)
    rw [show algebraMap S (AdicCompletion x S) a = AdicCompletion.of x S a from rfl, AdicCompletion.of_apply,
      AdicCompletion.val_zero, Pi.zero_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, Ideal.smul_eq_mul,
      Ideal.mul_top]
  have hPle : ∀ a : S, (∀ n : ℕ, a ∈ x ^ n) → a ∈ 𝔮 := by
    intro a ha
    haveI : IsNoetherianRing (Localization.AtPrime x) := IsLocalization.isNoetherianRing x.primeCompl _ inferInstance
    have hloc : algebraMap S (Localization.AtPrime x) a = 0 := by
      have hmem : algebraMap S (Localization.AtPrime x) a ∈ ⨅ n : ℕ, (IsLocalRing.maximalIdeal (Localization.AtPrime x)) ^ n • (⊤ : Submodule (Localization.AtPrime x) (Localization.AtPrime x)) := by
        rw [Submodule.mem_iInf]; intro n
        rw [Ideal.smul_eq_mul, Ideal.mul_top]
        have : Ideal.map (algebraMap S (Localization.AtPrime x)) (x ^ n) ≤ (IsLocalRing.maximalIdeal (Localization.AtPrime x)) ^ n := by
          rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal]
        exact this (Ideal.mem_map_of_mem _ (ha n))
      have hK := Ideal.iInf_pow_smul_eq_bot_of_le_jacobson (M := Localization.AtPrime x) (IsLocalRing.maximalIdeal (Localization.AtPrime x))
        (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top])
      rw [hK] at hmem
      exact hmem
    obtain ⟨⟨s, hs⟩, hsa⟩ := (IsLocalization.map_eq_zero_iff x.primeCompl (Localization.AtPrime x) a).mp hloc
    have : s * a ∈ 𝔮 := by rw [hsa]; exact zero_mem _
    exact ((h𝔮.1.1).mem_or_mem this).resolve_left (fun h => hs (hle h))
  have hPprime : (RingHom.ker (algebraMap S (AdicCompletion x S))).IsPrime := RingHom.ker_isPrime _
  have hPle' : RingHom.ker (algebraMap S (AdicCompletion x S)) ≤ 𝔮 := fun a ha => hPle a ((hkerP a).mp ha)
  have heq : RingHom.ker (algebraMap S (AdicCompletion x S)) = 𝔮 := le_antisymm hPle' (h𝔮.2 ⟨hPprime, bot_le⟩ hPle')
  intro a ha
  exact (hkerP a).mp (by rw [← RingHom.mem_ker, heq]; exact ha) n

theorem CompBC.minimalPrime_le_of_isDomain_adicCompletion
    (S : Type*) [CommRing S] [IsNoetherianRing S]
    (𝔮 : Ideal S) (h𝔮 : 𝔮 ∈ minimalPrimes S) (x : Ideal S) [x.IsMaximal] (hle : 𝔮 ≤ x)
    (hdom : IsDomain (AdicCompletion x S)) (Q : Ideal S) [Q.IsPrime] (hQ : Q ≤ x) : 𝔮 ≤ Q := by
  classical
  intro a ha
  have hall : ∀ n : ℕ, a ∈ x ^ n := fun n => CompBC.minimalPrime_le_pow_of_isDomain_adicCompletion S 𝔮 h𝔮 x hle hdom n ha
  haveI : IsNoetherianRing (Localization.AtPrime x) := IsLocalization.isNoetherianRing x.primeCompl _ inferInstance
  have hloc : algebraMap S (Localization.AtPrime x) a = 0 := by
    have hmem : algebraMap S (Localization.AtPrime x) a ∈ ⨅ n : ℕ, (IsLocalRing.maximalIdeal (Localization.AtPrime x)) ^ n • (⊤ : Submodule (Localization.AtPrime x) (Localization.AtPrime x)) := by
      rw [Submodule.mem_iInf]; intro n
      rw [Ideal.smul_eq_mul, Ideal.mul_top]
      have : Ideal.map (algebraMap S (Localization.AtPrime x)) (x ^ n) ≤ (IsLocalRing.maximalIdeal (Localization.AtPrime x)) ^ n := by
        rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal]
      exact this (Ideal.mem_map_of_mem _ (hall n))
    have hK := Ideal.iInf_pow_smul_eq_bot_of_le_jacobson (M := Localization.AtPrime x) (IsLocalRing.maximalIdeal (Localization.AtPrime x))
      (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top])
    rw [hK] at hmem
    exact hmem
  obtain ⟨⟨s, hs⟩, hsa⟩ := (IsLocalization.map_eq_zero_iff x.primeCompl (Localization.AtPrime x) a).mp hloc
  have : s * a ∈ Q := by rw [hsa]; exact zero_mem _
  exact ((inferInstance : Q.IsPrime).mem_or_mem this).resolve_left (fun h => hs (hQ h))

theorem CompBC.exists_adicCompletion_ringEquiv_map_of_surjective_of_isDomain
    (B : Type) [CommRing B] [IsNoetherianRing B] (T : Type) [CommRing T] (θ : B →+* T) (hθ : Function.Surjective θ)
    (𝔪 : Ideal B) [𝔪.IsMaximal] (hdom : IsDomain (AdicCompletion 𝔪 B))
    (Q : Ideal B) (hQ : Q ∈ minimalPrimes B) (hQle : Q ≤ 𝔪) (hker : RingHom.ker θ ≤ Q) :
    (𝔪.map θ).IsMaximal ∧
    ∃ e : AdicCompletion 𝔪 B ≃+* AdicCompletion (𝔪.map θ) T,
      ∀ b : B, e (algebraMap B (AdicCompletion 𝔪 B) b) = algebraMap T (AdicCompletion (𝔪.map θ) T) (θ b) := by
  classical
  have hcomap : Ideal.comap θ (Ideal.map θ 𝔪) = 𝔪 := by
    rw [Ideal.comap_map_of_surjective _ hθ, ← RingHom.ker_eq_comap_bot, sup_eq_left.mpr (hker.trans hQle)]
  have hmax : (𝔪.map θ).IsMaximal := by
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective θ hθ (inferInstance : 𝔪.IsMaximal) with h | h
    · exfalso
      have : 𝔪 = ⊤ := by rw [← hcomap, h, Ideal.comap_top]
      exact (inferInstance : 𝔪.IsMaximal).ne_top this
    · exact h
  refine ⟨hmax, ?_⟩
  have hkerpow : ∀ n : ℕ, RingHom.ker θ ≤ (Ideal.comap θ (Ideal.map θ 𝔪)) ^ n := by
    intro n; rw [hcomap]
    exact hker.trans (CompBC.minimalPrime_le_pow_of_isDomain_adicCompletion B Q hQ 𝔪 hQle hdom n)
  obtain ⟨e, he⟩ := RingHom.exists_adicCompletion_ringEquiv_of_surjective_of_ker_le_comap_pow θ hθ (𝔪.map θ) hkerpow
  have key : ∀ (I : Ideal B), I = 𝔪 →
      (∃ e : AdicCompletion I B ≃+* AdicCompletion (𝔪.map θ) T,
        ∀ b : B, e (algebraMap B (AdicCompletion I B) b) = algebraMap T (AdicCompletion (𝔪.map θ) T) (θ b)) →
      ∃ e : AdicCompletion 𝔪 B ≃+* AdicCompletion (𝔪.map θ) T,
        ∀ b : B, e (algebraMap B (AdicCompletion 𝔪 B) b) = algebraMap T (AdicCompletion (𝔪.map θ) T) (θ b) := by
    rintro I rfl h; exact h
  exact key _ hcomap ⟨e, he⟩

