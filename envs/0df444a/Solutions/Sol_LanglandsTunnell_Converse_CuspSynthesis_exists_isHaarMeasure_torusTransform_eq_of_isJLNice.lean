    (hη1 : ∀ (v : ↥S) (t : (v.1.adicCompletion K)ˣ), ‖((localChar η v.1 t : ℂˣ) : ℂ)‖ ≤ 1) {s : ℂ} (hs : 0 < s.re) :
    Summable fun n : ↥S → ℤ => ‖c (R.rep n) * sWeight K S η (R.rep n) (s + 1 / 2)‖ := by
  have hC0 : 0 ≤ C := (norm_nonneg _).trans (hC 1)
