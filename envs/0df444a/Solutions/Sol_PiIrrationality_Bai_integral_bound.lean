/-- `|25 - t²|²` in the real coordinates `t = u + v i`. -/
def xx (u v : ℝ) : ℝ := (25 - u ^ 2 + v ^ 2) ^ 2 + 4 * u ^ 2 * v ^ 2

/-- `|t⁴ + 6t² + 25|²`. -/
def QQ (u v : ℝ) : ℝ :=
  (u ^ 4 - 6 * u ^ 2 * v ^ 2 + v ^ 4 + 6 * (u ^ 2 - v ^ 2) + 25) ^ 2 +
    (4 * u * v * (u ^ 2 - v ^ 2) + 12 * u * v) ^ 2

/-- `|t|⁴ |t⁴+6t²+25|⁴`. -/
def NN (u v : ℝ) : ℝ := (u ^ 2 + v ^ 2) ^ 2 * QQ u v ^ 2

lemma normSq_25 (t : ℂ) : Complex.normSq (25 - t ^ 2) = xx t.re t.im := by
  simp only [Complex.normSq_apply, xx, pow_two, Complex.sub_re, Complex.sub_im, Complex.mul_re,
    Complex.mul_im]
  norm_num
  ring

lemma normSq_Q (t : ℂ) : Complex.normSq (t ^ 4 + 6 * t ^ 2 + 25) = QQ t.re t.im := by
  simp only [Complex.normSq_apply, QQ, pow_succ, pow_zero, one_mul, Complex.add_re, Complex.add_im,
    Complex.mul_re, Complex.mul_im]
  norm_num
  ring

lemma xx_neg (u v : ℝ) : xx u (-v) = xx u v := by unfold xx; ring
lemma NN_neg (u v : ℝ) : NN u (-v) = NN u v := by unfold NN QQ; ring

lemma key_bound (k : ℕ) (hk : 1 ≤ k) (ρ1 x0 : ℝ) (hρ : 0 < ρ1) (hx0 : 0 < x0) (t : ℂ)
    (hx : 0 < xx t.re t.im)
    (hcert : (k : ℝ) * x0 * NN t.re t.im ≤
      ρ1 * xx t.re t.im ^ 3 * (((k : ℝ) + 1) * x0 - xx t.re t.im)) :
    ‖t ^ (2 * k) * (t ^ 4 + 6 * t ^ 2 + 25) ^ (2 * k) / (25 - t ^ 2) ^ (3 * k - 1)‖ ^ 2 ≤
      ρ1 ^ k * x0 := by
  set x := xx t.re t.im with hxdef
  set N := NN t.re t.im with hNdef
  have hkpos : (0 : ℝ) < k := by exact_mod_cast hk
  have hN0 : 0 ≤ N := by
    rw [hNdef]; unfold NN QQ; positivity
  have hnorm : ‖t ^ (2 * k) * (t ^ 4 + 6 * t ^ 2 + 25) ^ (2 * k) / (25 - t ^ 2) ^ (3 * k - 1)‖ ^ 2
      = N ^ k / x ^ (3 * k - 1) := by
    rw [norm_div, norm_mul, norm_pow, norm_pow, norm_pow, div_pow, mul_pow]
    rw [← pow_mul, ← pow_mul, ← pow_mul, show ‖t‖ ^ (2 * k * 2) = (‖t‖ ^ 2) ^ (2 * k) by
      rw [← pow_mul]; ring_nf, show ‖t ^ 4 + 6 * t ^ 2 + 25‖ ^ (2 * k * 2)
        = (‖t ^ 4 + 6 * t ^ 2 + 25‖ ^ 2) ^ (2 * k) by rw [← pow_mul]; ring_nf,
      show ‖25 - t ^ 2‖ ^ ((3 * k - 1) * 2) = (‖25 - t ^ 2‖ ^ 2) ^ (3 * k - 1) by
        rw [← pow_mul]; ring_nf]
    rw [Complex.sq_norm, Complex.sq_norm, Complex.sq_norm, normSq_25, normSq_Q, hNdef, NN,
      Complex.normSq_apply]
    rw [mul_pow, ← pow_mul, ← pow_mul, ← hxdef]
    ring
  rw [hnorm]
  -- the tangent trick
  have hx3 : 0 < x ^ 3 := pow_pos hx 3
  have hρx : 0 < ρ1 * x ^ 3 := mul_pos hρ hx3
  set y : ℝ := (x0 - x) / (k * x0) with hy
  have h1 : N ≤ ρ1 * x ^ 3 * (1 + y) := by
    have : ρ1 * x ^ 3 * (1 + y) = ρ1 * x ^ 3 * (((k : ℝ) + 1) * x0 - x) / (k * x0) := by
      rw [hy]; field_simp; ring
    rw [this, le_div_iff₀ (by positivity)]
    linarith
  have h1y : 0 ≤ 1 + y := by
    by_contra hneg
    push Not at hneg
    have : ρ1 * x ^ 3 * (1 + y) < 0 := mul_neg_of_pos_of_neg hρx hneg
    linarith
  have h2 : N ^ k ≤ (ρ1 * x ^ 3 * (1 + y)) ^ k := pow_le_pow_left₀ hN0 h1 k
  have h3 : (1 + y) ^ k ≤ Real.exp (k * y) := by
    calc (1 + y) ^ k ≤ (Real.exp y) ^ k := by
          apply pow_le_pow_left₀ h1y
          linarith [Real.add_one_le_exp y]
      _ = Real.exp (k * y) := by rw [← Real.exp_nat_mul]
  have hky : (k : ℝ) * y = (x0 - x) / x0 := by rw [hy]; field_simp
  rw [hky] at h3
  have hxpos : (0 : ℝ) < x ^ (3 * k - 1) := pow_pos hx _
  have h3k : x ^ (3 * k) = x ^ (3 * k - 1) * x := by
    rw [← pow_succ]; congr 1; omega
  rw [div_le_iff₀ hxpos]
  calc N ^ k ≤ (ρ1 * x ^ 3 * (1 + y)) ^ k := h2
    _ = ρ1 ^ k * x ^ (3 * k) * (1 + y) ^ k := by
        rw [mul_pow, mul_pow, ← pow_mul]
    _ ≤ ρ1 ^ k * x ^ (3 * k) * Real.exp ((x0 - x) / x0) := by
        exact mul_le_mul_of_nonneg_left h3 (by positivity)
    _ = ρ1 ^ k * (x * Real.exp ((x0 - x) / x0)) * x ^ (3 * k - 1) := by rw [h3k]; ring
    _ ≤ ρ1 ^ k * x0 * x ^ (3 * k - 1) := by
        have hxe : x * Real.exp ((x0 - x) / x0) ≤ x0 := by
          have e1 : x / x0 ≤ Real.exp (x / x0 - 1) := by
            linarith [Real.add_one_le_exp (x / x0 - 1)]
          have e2 : Real.exp (x / x0 - 1) * Real.exp ((x0 - x) / x0) = 1 := by
            rw [← Real.exp_add]; rw [show x / x0 - 1 + (x0 - x) / x0 = 0 by field_simp; ring]
            simp
          have e3 : (x / x0) * Real.exp ((x0 - x) / x0) ≤ 1 := by
            calc (x / x0) * Real.exp ((x0 - x) / x0) ≤ Real.exp (x / x0 - 1) * Real.exp ((x0 - x) / x0) :=
                  mul_le_mul_of_nonneg_right e1 (Real.exp_pos _).le
              _ = 1 := e2
          have : x * Real.exp ((x0 - x) / x0) = x0 * ((x / x0) * Real.exp ((x0 - x) / x0)) := by
            field_simp
          rw [this]
          nlinarith
        have : 0 ≤ ρ1 ^ k * x ^ (3 * k - 1) := by positivity
        nlinarith


