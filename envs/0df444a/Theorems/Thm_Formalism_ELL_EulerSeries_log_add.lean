variable {K : Type*} [NormedField K] [CharZero K] {σ : Type} [DecidableEq σ]

theorem Formalism.ELL.EulerSeries.log_add {f g : MvPowerSeries σ K} (hf : MvPowerSeries.constantCoeff f = 0)
    (hg : MvPowerSeries.constantCoeff g = 0) :
    logOnePlus f + logOnePlus g = logOnePlus (f + g + f * g) := by sorry
