-- title:
--   Filtered lifting gives integrality of polynomial variables
-- statement:
--   From positive weights, a positive cutoff, the inclusive weighted support bound, and module finiteness over the algebra generated by the degree-D components, prove that each polynomial variable is integral over the algebra generated by the original polynomials. After clearing weight denominators, use the weighted-degree filtration: the degree-D components are initial forms of the generators, and their finite algebra controls the associated graded polynomial ring. Lift finite generation through the filtration, then infer integrality. The d = 0 case is vacuous.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.filtered_adjoin_finite_integral_variables
    {d : Nat} (w : Fin d → Rat) (hw : ∀ i, 0 < (w i : Real))
    (D : Nat) (hD : 0 < D)
    (m : Nat) (g : Fin m → MvPolynomial (Fin d) Complex)
    (hbound : ∀ j, ∀ a ∈ (g j).support,
      ∑ k, (w k : Real) * (a k : Real) ≤ (D : Real))
    (hfinite : Module.Finite
      (Algebra.adjoin Complex
        (Set.range (fun j =>
          MvPolynomial.weightedHomogeneousComponent
            (fun k : Fin d => (w k : ℚ)) (D : ℚ) (g j))))
      (MvPolynomial (Fin d) Complex)) :
    ∀ i : Fin d, IsIntegral (Algebra.adjoin Complex (Set.range g))
      (MvPolynomial.X (R := Complex) i) := by sorry
