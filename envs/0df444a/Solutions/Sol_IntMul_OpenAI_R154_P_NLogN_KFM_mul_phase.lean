theorem ell_ge {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.R154.dP n = D + 1) : 2 ≤ ell (IntMul.OpenAI.Glue.LP n) (D + 1) := by
