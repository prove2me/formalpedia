      · exact history
  calc
    _ = jointConditional
          (groupedMass
            (fun point : ExactJointOutcome X Y A B D =>
              ((point.1,
                (point.2.1 point.1.coordinate.val,
                  exactHistoryCode D point)),
                point.2.2.1 point.1.coordinate.val))
            (exactPostselectedJointLaw G n S D))
