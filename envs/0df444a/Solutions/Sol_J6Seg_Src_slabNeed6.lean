namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab (passP drP rdP itO bkP)

/-- **The regime of every axis.** -/
theorem axReg_of (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D, AxReg P n src D k := by
  obtain ⟨n₁, h⟩ := r6_axis_nat P hP
  obtain ⟨n₃, hme⟩ := r6_maps_eq P hP
  refine ⟨max n₁ n₃, fun n hn src hsrc D hD k hk => ?_⟩
  have hn1 : n₁ ≤ n := by omega
  have hn3 : n₃ ≤ n := by omega
  have hax : ∀ i : Fin (D + 1), 0 < sD6 src D i ∧ sD6 src D i < tD6 P n D i := by
    intro i
    have hi : i.val < dP6 P n := by have := i.isLt; omega
    obtain ⟨hs0, hst, -⟩ := h n hn1 src hsrc i.val hi
    exact ⟨hs0, hst⟩
  haveI : ∀ i, NeZero (sD6 src D i) := fun i => ⟨(hax i).1.ne'⟩
  haveI : ∀ i, NeZero (tD6 P n D i) := fun i => ⟨by have := hax i; omega⟩
  obtain ⟨-, hdv⟩ := hme n hn3 src hsrc D hD
  obtain ⟨hdvd, -⟩ := hdv ⟨k, by omega⟩
  obtain ⟨-, hst⟩ := hax ⟨k, by omega⟩
  have hl : 1 ≤ axl6 P n := Nat.one_le_two_pow
  have ht : 0 < axt6 P n k := tF6_pos P n k
  have hdvd' : axl6 P n ∣ axt6 P n k := hdvd
  refine ⟨hl, Nat.div_pos (Nat.le_of_dvd ht hdvd') hl, le_of_lt hst,
    Nat.div_mul_cancel hdvd', ?_⟩
  unfold axpost6 postT
  apply List.prod_pos
  intro a ha
  obtain ⟨i, rfl⟩ := List.mem_ofFn.1 (List.mem_of_mem_drop ha)
  exact tF6_pos P n i

end J6Seg.Ax

end

