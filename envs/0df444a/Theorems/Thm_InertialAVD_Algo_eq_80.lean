-- name    : InertialAVD.Algo.eq_80
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T21:10:20.784069+00:00
-- url     : https://prove2.me/theorems/b8478843-dfee-4ffd-b5e0-f990750b1cb3
-- title:
--   (80) — $h_{k+1}-h_k-\gamma_k(h_k-h_{k-1})\le s\|g_k\|\|x_{k+1}-x^*\|+2\gamma_k\|x_k-x_{k-1}\|^2$
-- statement:
--   Let $\mathcal H$ be a real Hilbert space, let $\Phi:\mathcal H\to\mathbb R\cup\{+\infty\}$ be proper, lower semicontinuous and convex, and let $\Psi:\mathcal H\to\mathbb R$ be convex and continuously differentiable with $L$-Lipschitz continuous gradient; write $\Theta=\Phi+\Psi$. Let $s>0$ with $sL<1$, let $(g_k)_{k\ge 0}$ be a sequence of perturbations in $\mathcal H$, and let $(x_k)_{k\ge0},(y_k)_{k\ge0}$ be generated by the perturbed inertial forward-backward algorithm (55):
--
--   $$y_k = x_k + \frac{k-1}{k+\alpha-1}(x_k-x_{k-1})\ (k\ge 1),\qquad x_{k+1}=\operatorname{prox}_{s\Phi}\big(y_k-s(\nabla\Psi(y_k)-g_k)\big)\ (k\ge 0),$$
--
--   with $y_0\in\mathcal H$ arbitrary.
--
--   Assume $\alpha\ge3$ and let $x^*$ be a minimizer of $\Theta$. Write $h_k=\frac12\|x_k-x^*\|^2$ and $\gamma_k=\frac{k-1}{k+\alpha-1}$. Then for every $k\ge1$,
--
--   $$h_{k+1}-h_k-\gamma_k\,(h_k-h_{k-1})\le s\,\|g_k\|\,\|x_{k+1}-x^*\|+2\gamma_k\,\|x_k-x_{k-1}\|^2 .$$
--
--   This is the discrete analogue of the second-order differential inequality for $\frac12\|x(t)-x^*\|^2$; together with Lemma A.5 it shows that $\lim_k\|x_k-x^*\|$ exists, which is hypothesis (i) of Opial's lemma.
--
--   **Formalization Note.** $\Phi$ is `EReal`-valued with `IsProperClosedConvex`; $\operatorname{prox}_{s\Phi}$ is a map $P$ with `IsProx s Φ P`; $\Theta$ is the published `NesterovFB.Rates.theta Φ Ψ` (whose argument names are swapped relative to this paper: its first argument is the nonsmooth part). $L$ is a nonnegative real and "$0<s<1/L$" is written $0<s$, $sL<1$, so $L=0$ is allowed. The run is `IsPerturbedRun`. The page derives (80) inside the proof of Theorem 5.3 ($\alpha>3$); the derivation uses only $\alpha\ge3$ (so $0\le\gamma_k<1$), $sL<1$ and the co-coercivity of $\nabla\Psi$, and the statement assumes $\alpha\ge3$. It holds for $k\ge1$, where $h_{k-1}$ is defined.
-- source:
--   Attouch, Chbani, Peypouquet, Redont, Fast convergence of inertial dynamics and algorithms with asymptotic vanishing damping, Optimization Online preprint 5179 (Oct. 2015), p. 23, (80)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm
import Definitions.Def_InertialAVD_Algo_PerturbedRun

open Filter Topology NesterovFB.Rates

namespace InertialAVD.Algo

/-- (80), p. 23: with `h_k = ½‖x_k − x*‖²` and `γ_k = (k−1)/(k+α−1)`, for every `k ≥ 1`,
`h_{k+1} − h_k − γ_k(h_k − h_{k−1}) ≤ s‖g_k‖‖x_{k+1} − x*‖ + 2γ_k‖x_k − x_{k−1}‖²`. -/
theorem eq_80 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Φ : H → EReal) (Ψ : H → ℝ) (L : NNReal) (s α : ℝ) (P : H → H) (g : ℕ → H) (x y : ℕ → H)
    (hΦ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Φ)
    (hΨc : ConvexOn ℝ Set.univ Ψ) (hΨd : ContDiff ℝ 1 Ψ)
    (hL : LipschitzWith L (gradient Ψ))
    (hs : 0 < s) (hsL : s * (L : ℝ) < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Φ P)
    (hrun : IsPerturbedRun Ψ P α s g x y)
    (hα : 3 ≤ α)
    (xstar : H) (hxstar : ∀ v : H, theta Φ Ψ xstar ≤ theta Φ Ψ v) :
    ∀ k : ℕ, 1 ≤ k →
      (1 / 2 * ‖x (k + 1) - xstar‖ ^ 2 - 1 / 2 * ‖x k - xstar‖ ^ 2)
          - ((k : ℝ) - 1) / ((k : ℝ) + α - 1)
            * (1 / 2 * ‖x k - xstar‖ ^ 2 - 1 / 2 * ‖x (k - 1) - xstar‖ ^ 2)
        ≤ s * ‖g k‖ * ‖x (k + 1) - xstar‖
          + 2 * (((k : ℝ) - 1) / ((k : ℝ) + α - 1)) * ‖x k - x (k - 1)‖ ^ 2 := by sorry

end InertialAVD.Algo
