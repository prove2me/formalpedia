/-!
# Isotropic Schwarzschild (spherical form): vacuum certificates by transport (ATLAS-II)

* `cert_out (hM : 0 ≤ M)`: certificate on the outer branch `ρ > M/2`, transported from the first-release
  standard-chart certificate `Std.cert M` restricted to `r > 2M` along `relation_out`;
* `cert_in (hM : 0 < M)`: the inner branch `0 < ρ < M/2`, transported along `relation_in`;
* `cert_pos (hM : 0 < M)`: the full domain `ρ > 0`, `ρ ≠ M/2` (union of the two open branches);
* `cert_zero`: `M = 0` is Minkowski in spherical coordinates (`A = B = 1`), via `Minkowski.certSph.congr`;
* `cert (hM : 0 ≤ M)`: all of the above in one statement.

Nothing is claimed at `ρ = M/2` (for `M > 0` this is where `A = 0` and the chart degenerates; for `M = 0` it is the excluded origin `ρ = 0`) or for `M < 0`.
-/

open Real
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild

namespace ExactVacuumAtlas.Schwarzschild.Iso

variable (M : ℝ)

/-- The first-release standard-chart certificate restricted to `r > 2M`. -/
theorem std_cert_ext (hM : 0 ≤ M) : VacuumCertificate (gStd M) (giStd M) (domStdExt M) :=
  (Std.cert M).mono (domStdExt_subset_domStd M hM) (isOpen_domStdExt M) (domStdExt_nonempty M hM)

theorem jacIso_mul_inv_out (hM : 0 ≤ M) {x : Pt 4} (hx : x ∈ domIsoOut M) :
    jacIso M x * jacIsoInv M x = 1 :=
  jacIso_mul_inv M (ne_of_gt hx.2.1) (ne_of_gt hx.1) (fun h => by have := hx.2.1; linarith)

theorem jacIso_mul_inv_in (hM : 0 < M) {x : Pt 4} (hx : x ∈ domIsoIn M) :
    jacIso M x * jacIsoInv M x = 1 :=
  jacIso_mul_inv M (ne_of_gt hx.1) (ne_of_lt hx.2.1) (fun h => by have := hx.1; linarith)

/-- **Outer branch** `ρ > M/2`, every `M ≥ 0`. -/
theorem cert_out (hM : 0 ≤ M) : VacuumCertificate (gIso M) (giIso M) (domIsoOut M) :=
  VacuumCertificate.transport_of_relation (std_cert_ext M hM) (relation_out M hM)
    (isOpen_domIsoOut M) (domIsoOut_nonempty M hM) (fun _ hx => jacIso_mul_inv_out M hM hx)
    (fun _ hx => giIso_mul_gIso M hM (domIsoOut_subset M hM hx))

/-- **Inner branch** `0 < ρ < M/2`, every `M > 0`. -/
theorem cert_in (hM : 0 < M) : VacuumCertificate (gIso M) (giIso M) (domIsoIn M) :=
  VacuumCertificate.transport_of_relation (std_cert_ext M hM.le) (relation_in M hM)
    (isOpen_domIsoIn M) (domIsoIn_nonempty M hM) (fun _ hx => jacIso_mul_inv_in M hM hx)
    (fun _ hx => giIso_mul_gIso M hM.le (domIsoIn_subset M hx))

/-- **Full isotropic domain** `ρ > 0`, `ρ ≠ M/2`, every `M > 0`. -/
theorem cert_pos (hM : 0 < M) : VacuumCertificate (gIso M) (giIso M) (domIso M) := by
  rw [domIso_eq_union M hM]
  exact (cert_out M hM.le).union (cert_in M hM)

theorem gIso_zero_eqOn (i j : Fin 4) : Set.EqOn (Minkowski.gSph i j) (gIso 0 i j) Minkowski.domSph := by
  intro x _
  fin_cases i <;> fin_cases j <;> simp [gIso, Minkowski.gSph, Af, Bf]

theorem giIso_zero_eqOn (i j : Fin 4) :
    Set.EqOn (Minkowski.giSph i j) (giIso 0 i j) Minkowski.domSph := by
  intro x _
  fin_cases i <;> fin_cases j <;> simp [giIso, Minkowski.giSph, Af, Bf]

/-- **`M = 0`**: the isotropic data is Minkowski spherical data on `domEF`. -/
theorem cert_zero : VacuumCertificate (gIso 0) (giIso 0) (domIso 0) := by
  rw [domIso_zero]
  exact Minkowski.certSph.congr gIso_zero_eqOn giIso_zero_eqOn

end ExactVacuumAtlas.Schwarzschild.Iso

