-- Source module: Solutions.J6AIL13
/-!
# A lines, IL side 13: the fine-descriptor set-ups

For a fine descriptor `descFine w f a y` with `w = p + 2`, `f` a literal and `a`, `y` expressions in
the registers of `parAX X`:

* `fsR X ea ey fl Q`: enter the register file, `parAX X`, push `w, f, a, y` on four temporaries
  `Q 0 … Q 3` (outside `rg`, away from `dF`), leave the register file;
* `fsUp`: then copy `y, a, f, w` onto `dF` and drop the temporaries; `fsDn`: drop four from `dF`.

**`fsUp_runs`** / **`fsDn_runs`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6A.FS

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function J6A.PA IntMul.Kappa.R6

theorem Q_val (dF : Fin HS) (i : Fin 4) : (Q dF i).val = qb dF + i.val := rfl

theorem Q_facts (dF : Fin HS) (i : Fin 4) :
    Q dF i ∉ rg ∧ (Q dF i).val < 56 ∧ Q dF i ≠ dF ∧ (Q dF i).val ≠ 0 ∧ (Q dF i).val ≠ 53 ∧
    (Q dF i).val ≠ 30 ∧ (Q dF i).val ≠ 31 ∧ Q dF i ≠ sTmp ∧ Q dF i ≠ cRdC ∧ Q dF i ≠ cL := by
  have hi := i.isLt
  have hv := Q_val dF i
  have nrg : ∀ j : Fin HS, (16 ≤ j.val ∧ j.val ≤ 19) ∨ (32 ≤ j.val ∧ j.val ≤ 35) → j ∉ rg := by
    intro j hj hm
    have : ∀ j ∈ rg, ¬ ((16 ≤ j.val ∧ j.val ≤ 19) ∨ (32 ≤ j.val ∧ j.val ≤ 35)) := by decide
    exact this j hm hj
  have vne : ∀ (j : Fin HS) (n : ℕ), j.val = n → (qb dF + i.val ≠ n) → Q dF i ≠ j :=
    fun j n hj hn e => hn (by rw [← hv, e, hj])
  have e15 : (sTmp : Fin HS).val = 15 := rfl
  have e47 : (cRdC : Fin HS).val = 47 := rfl
  have e13 : (cL : Fin HS).val = 13 := rfl
  rcases qb_cases dF with h | h
  · refine ⟨nrg _ (Or.inr (by omega)), by omega, vne dF dF.val rfl (by omega), by omega,
      by omega, by omega, by omega, vne _ 15 e15 (by omega), vne _ 47 e47 (by omega),
      vne _ 13 e13 (by omega)⟩
  · refine ⟨nrg _ (Or.inl (by omega)), by omega, vne dF dF.val rfl (by omega), by omega,
      by omega, by omega, by omega, vne _ 15 e15 (by omega), vne _ 47 e47 (by omega),
      vne _ 13 e13 (by omega)⟩

section runs
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- **The fine set-up.** -/
theorem fsUp_runs {X dF : Fin HS} (hXr : X ∉ rg) (hX5 : X.val < 56) (hXT : X ≠ sTmp)
    (hXC : X ≠ cRdC) (hXQ : ∀ i, Q dF i ≠ X)
    {ea ey : Ex HS} (hea : J6A.PA.OnRg ea) (hey : J6A.PA.OnRg ey) (hpa : Plain ea = true)
    (hpy : Plain ey = true) {fl : ℕ}
    (s : IState HS) (F : Fin HS → List ℤ) (hrg : ∀ j ∈ rg, F j = []) (h13 : F cL = [])
    (hQ : ∀ i, F (Q dF i) = []) (hdF : F dF = [])
    {k pre post sr t p α d W : ℕ} (hc : F X = dL k pre post sr t p α d)
    (hL : ∀ x ∈ dL k pre post sr t p α d, |x| < 2 ^ W)
    (hp : 1 ≤ p) (hα : 1 ≤ α) (hmW : sWidth p α + 4 ≤ W) (hfl : fl ≤ 2 ^ W)
    (hta : Tame (2 ^ W) ea) (hty : Tame (2 ^ W) ey) {a y : ℕ}
    (hA : ∀ v c, PV pre post sr t p α W v → ev v c ea = a)
    (hY : ∀ v c, PV pre post sr t p α W v → ev v c ey = y) :
    IRuns I iprog (fsUp X ea ey fl dF) (encK s F)
      (encK s (update F dF (descFine (p + 2) fl a y)))
      (cFsR W p (sWidth p α) ea ey fl + cFsI ((p + 2 : ℕ) : ℤ) fl a y) := by
  have h1 := J6Seg.KR.Sp.ir (I := I) (iprog := iprog)
    (fsR_sp hXr hX5 hXT hXC hXQ hea hey hpa hpy s F hrg h13 hQ hc hL hp hα hmW hfl hta hty hA hY)
  have h2 := fsI_runs (I := I) (iprog := iprog) s F dF hQ ((p + 2 : ℕ) : ℤ) fl a y
  rw [hdF] at h2
  exact h1.seq h2

/-- **The fine tear-down.** -/
theorem fsDn_runs (s : IState HS) (K : Fin HS → List ℤ) (dF : Fin HS) (w f a y : ℕ)
    (R : List ℤ) (hK : K dF = descFine w f a y ++ R) :
    IRuns I iprog (fsDn dF) (encK s K) (encK s (update K dF R)) (cFsD w f a y) := by
  simp only [descFine, List.cons_append, List.nil_append] at hK
  have d1 := J6Seg.IRuns.dropK (I := I) (iprog := iprog) s hK
  have d2 := J6Seg.IRuns.dropK (I := I) (iprog := iprog) s
    (G := update K dF ((f : ℤ) :: (a : ℤ) :: (y : ℤ) :: R)) (by rw [update_self])
  simp only [update_idem] at d2
  have d3 := J6Seg.IRuns.dropK (I := I) (iprog := iprog) s
    (G := update K dF ((a : ℤ) :: (y : ℤ) :: R)) (by rw [update_self])
  simp only [update_idem] at d3
  have d4 := J6Seg.IRuns.dropK (I := I) (iprog := iprog) s
    (G := update K dF ((y : ℤ) :: R)) (by rw [update_self])
  simp only [update_idem] at d4
  exact (d1.seq (d2.seq (d3.seq d4))).mono (by unfold cFsD; omega)

end runs

end J6A.FS

end

section
-- Source module: Solutions.J6AIL17
/-!
# A lines, IL side 17: polynomial bounds of the leaf costs

With `U = W + 2` (the register width) every leaf cost of `AStepNeed6` is bounded by a polynomial:

* the copy step: `cDupP W n Bb ≤ 10^8 (n + 1) (Bb + 2) + 10^15 U²` (`cDupP_le`);
* the fine set-ups: `≤ 10^16 (p + m + 1) U²` (`cFsR_le`, `cFsI_le`, `cFsD_le`);
* the slab set-ups and tear-downs: `≤ 10^18 (t + p + m + 1) U⁸` (`cG1_le`, `cC1_le`, `ctlPhC_le`,
  `cTail_le`, `cDn_le`), for `n, n' ≤ 32 t`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 10000

namespace J6A.BD

open IntMul NLogN NLogN.KIL Function RS J6Seg.PJ J6A.PA

theorem cT_le {e : Ex HS} (h : e.size ≤ 60) (W : ℕ) : J6Seg.PJ.cT e W ≤ 10 ^ 13 * (W + 2) ^ 2 := by
  unfold J6Seg.PJ.cT J6Seg.PJ.cE
  have h1 : (W + 1) * (2 * e.size) + 2 ≤ 122 * (W + 2) := by nlinarith
  have h2 : ((W + 1) * (2 * e.size) + 2 + 2) ^ 2 ≤ (123 * (W + 2)) ^ 2 :=
    Nat.pow_le_pow_left (by omega) 2
  calc (e.size + 1) * 10 ^ 7 * ((W + 1) * (2 * e.size) + 2) ^ 2
      ≤ 61 * 10 ^ 7 * ((W + 1) * (2 * e.size) + 2 + 2) ^ 2 := by
        apply Nat.mul_le_mul (Nat.mul_le_mul_right _ (by omega))
        exact Nat.pow_le_pow_left (by omega) 2
    _ ≤ 61 * 10 ^ 7 * (123 * (W + 2)) ^ 2 := Nat.mul_le_mul_left _ h2
    _ ≤ 10 ^ 13 * (W + 2) ^ 2 := by ring_nf; omega

theorem cT_le' (e : Ex HS) (h : e.size ≤ 60 := by simp [Ex.size]) (W : ℕ) :
    J6Seg.PJ.cT e W ≤ 10 ^ 13 * (W + 2) ^ 2 := cT_le h W

theorem cRd_le {j : ℕ} (hj : j ≤ 8) (W : ℕ) : cRd j W ≤ 10 ^ 9 * (W + 2) ^ 2 := by
  unfold cRd
  have h1 : j * (14000 * (W + 2)) ≤ 8 * (14000 * (W + 2)) := Nat.mul_le_mul_right _ hj
  have h2 : (W + 3) ^ 2 ≤ (2 * (W + 2)) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have h3 : (W + 2) ≤ (W + 2) ^ 2 := by nlinarith
  nlinarith

theorem cRdK_le {j : ℕ} (hj : j ≤ 8) (W : ℕ) : cRdK j W ≤ 2 * 10 ^ 13 * (W + 2) ^ 2 := by
  unfold cRdK
  have := cT_le' (.lit (j : ℤ) : Ex HS) (by simp [Ex.size]) W
  have := cRd_le hj W
  nlinarith

theorem cRep_le (W N cb K : ℕ) (hcb : cb ≤ K * (W + 2) ^ 2) :
    cRep W N cb ≤ (N + 1) * ((K + 10 ^ 4) * (W + 2) ^ 2) := by
  unfold cRep
  have h3 : (W + 2) ≤ (W + 2) ^ 2 := by nlinarith
  have h4 : 1 ≤ (W + 2) ^ 2 := by nlinarith
  have : N * (cb + 8000 * (W + 2) + 30) ≤ N * ((K + 10 ^ 4) * (W + 2) ^ 2) :=
    Nat.mul_le_mul_left _ (by nlinarith)
  nlinarith

theorem cSq_le (W : ℕ) : cSq W ≤ 2 * 10 ^ 13 * (W + 2) ^ 2 := by
  unfold cSq
  have := cT_le' (Ex.add (.reg 20) (.lit 1) : Ex HS) (by simp [Ex.size]) W
  have := cT_le' (Ex.add (.reg 21) (.sel (.add (.reg 5) (.neg (.mul (.reg 20) (.reg 20)))) (.lit 0)
    (.lit 1)) : Ex HS) (by simp [Ex.size]) W
  omega

theorem cLg_le (W : ℕ) : cLg W ≤ 3 * 10 ^ 13 * (W + 2) ^ 2 := by
  unfold cLg
  have := cT_le' (Ex.add (.reg 20) (.reg 20) : Ex HS) (by simp [Ex.size]) W
  have := cT_le' (Ex.sel (.add (.reg 7) (.neg (.reg 20))) (.reg 8) (.reg 20) : Ex HS)
    (by simp [Ex.size]) W
  have := cT_le' (Ex.add (.reg 22) (.sel (.add (.reg 7) (.neg (.reg 20))) (.lit 0) (.lit 1)) : Ex HS)
    (by simp [Ex.size]) W
  omega

theorem cParA_le (W p m : ℕ) : cParA W p m ≤ 10 ^ 15 * (p + m + 1) * (W + 2) ^ 2 := by
  unfold cParA
  have a1 := cRdK_le (j := 6) (by norm_num) W
  have a2 := cT_le' (Ex.lit 0 : Ex HS) (by simp [Ex.size]) W
  have a3 := cRep_le W p (cSq W) _ (cSq_le W)
  have a4 := cT_le' J6A.PA.mE (by simp [J6A.PA.mE, Ex.size]) W
  have a5 := cT_le' (Ex.lit 1 : Ex HS) (by simp [Ex.size]) W
  have a6 := cRep_le W m (cLg W) _ (cLg_le W)
  have a7 := cT_le' (Ex.add (.add (.reg 8) (.reg 7)) (.lit 3) : Ex HS) (by simp [Ex.size]) W
  have a8 := cT_le' (Ex.mul (.lit 8) (.reg 8) : Ex HS) (by simp [Ex.size]) W
  have a9 := cT_le' (Ex.add (.reg 22) (.lit 3) : Ex HS) (by simp [Ex.size]) W
  have a10 := cT_le' (Ex.ndiv (.reg 4) (.mul (.lit 16) (.reg 8)) : Ex HS) (by simp [Ex.size]) W
  have h4 : 1 ≤ (W + 2) ^ 2 := Nat.one_le_pow _ _ (by omega)
  set U := (W + 2) ^ 2
  have e3 : (p + 1) * ((2 * 10 ^ 13 + 10 ^ 4) * U) ≤ 10 ^ 14 * (p + 1) * U := by
    have : (2 * 10 ^ 13 + 10 ^ 4) * U ≤ 10 ^ 14 * U := Nat.mul_le_mul_right _ (by norm_num)
    nlinarith
  have e6 : (m + 1) * ((3 * 10 ^ 13 + 10 ^ 4) * U) ≤ 10 ^ 14 * (m + 1) * U := by
    have : (3 * 10 ^ 13 + 10 ^ 4) * U ≤ 10 ^ 14 * U := Nat.mul_le_mul_right _ (by norm_num)
    nlinarith
  nlinarith

end J6A.BD

end

