theorem Subalgebra.inv_mem_of_isUnit' {R F : Type*} [CommRing R] [Field F] [Algebra R F]
    (O : Subalgebra R F) (x : F) (hx : x ∈ O) (hu : IsUnit (⟨x, hx⟩ : ↥O)) : x⁻¹ ∈ O := by
  obtain ⟨u, hu⟩ := hu
  have hx0 : x ≠ 0 := by
    intro h0
    apply u.ne_zero
    rw [hu]; exact Subtype.ext h0
  have h1 : ((u⁻¹ : (↥O)ˣ) : ↥O) * ⟨x, hx⟩ = 1 := by rw [← hu, Units.inv_mul]
  have h2 : (((u⁻¹ : (↥O)ˣ) : ↥O) : F) * x = 1 := by
    have := congrArg (fun z : ↥O => (z : F)) h1
    simpa using this
  have h3 : (((u⁻¹ : (↥O)ˣ) : ↥O) : F) = x⁻¹ := by
    rw [← mul_inv_cancel_right₀ hx0 (((u⁻¹ : (↥O)ˣ) : ↥O) : F), h2, one_mul]
  rw [← h3]; exact Subtype.mem _

end NodeSkelG

