  have hfinal : EvalsToInTime (TM2.step (_root_.Integration9_9.TM2StockThread.program machine ein eout))
      (_root_.Integration9_9.TM2StockThread.phaseCfg machine .parse (_root_.Integration9_9.TM2StockThread.nativeInput machine []) (OAI.MetricKMedian.Binary.quote word++context) [] [])
      (some (_root_.Integration9_9.TM2StockThread.terminalCfg machine (_root_.Integration9_9.TM2StockThread.nativeOutput machine []) [] []
        (OAI.MetricKMedian.Binary.quote (letters.map eout)++context)))
