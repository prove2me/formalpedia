variable {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
  (L : RelativeGroupLaw R f) (n : ℕ)

private abbrev _root_.L1Asm22.KerOps.ι : L.schemeKer n ⟶ A := pullback.fst (L.schemeNsmul n) (L.one (𝟙 (Spec (CommRingCat.of R)))).1

p2m_export "L1Asm22.KerOps" "ι"
theorem ι_comp_f : ι L n ≫ f = L.schemeKerStr n := by
  have h := pullback.condition (f := L.schemeNsmul n) (g := (L.one (𝟙 (Spec (CommRingCat.of R)))).1)
  calc ι L n ≫ f = ι L n ≫ L.schemeNsmul n ≫ f := by rw [L.schemeNsmul_over]
    _ = (L.schemeKerStr n ≫ (L.one (𝟙 _)).1) ≫ f := by rw [← Category.assoc, h]
    _ = L.schemeKerStr n := by rw [Category.assoc, (L.one (𝟙 _)).2, Category.comp_id]

def toPt {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (x : T ⟶ L.schemeKer n)
    (hx : x ≫ L.schemeKerStr n = t) : SchemeHomOver t f :=
  ⟨x ≫ ι L n, by rw [Category.assoc, ι_comp_f, hx]⟩

@[scoped simp] theorem toPt_coe {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (x : T ⟶ L.schemeKer n)
    (hx : x ≫ L.schemeKerStr n = t) : (toPt L n x hx).1 = x ≫ ι L n := rfl

theorem one_coe {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    (L.one t).1 = t ≫ (L.one (𝟙 (Spec (CommRingCat.of R)))).1 := by
  have := L.one_natural (𝟙 _) t t (Category.comp_id t)
  rw [← this]; rfl

theorem nsmul_toPt {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (x : T ⟶ L.schemeKer n)
    (hx : x ≫ L.schemeKerStr n = t) : L.nsmul t n (toPt L n x hx) = L.one t := by
  apply Subtype.ext
  rw [RelativeGroupLaw.coe_nsmul_eq_comp_schemeNsmul, toPt_coe, Category.assoc, pullback.condition,
    ← Category.assoc, hx]
  exact (one_coe L t).symm

private def _root_.L1Asm22.KerOps.lift {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f)
    (hP : L.nsmul t n P = L.one t) : T ⟶ L.schemeKer n :=
  pullback.lift P.1 t (by
    rw [← RelativeGroupLaw.coe_nsmul_eq_comp_schemeNsmul, hP, one_coe])

p2m_export "L1Asm22.KerOps" "lift"
@[scoped simp] theorem lift_ι {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f)
    (hP : L.nsmul t n P = L.one t) : lift L n P hP ≫ ι L n = P.1 := pullback.lift_fst _ _ _

@[scoped simp] theorem lift_str {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f)
    (hP : L.nsmul t n P = L.one t) : lift L n P hP ≫ L.schemeKerStr n = t := pullback.lift_snd _ _ _

private theorem _root_.L1Asm22.KerOps.hom_ext {T : Scheme.{u}} (x y : T ⟶ L.schemeKer n) (h1 : x ≫ ι L n = y ≫ ι L n)
    (h2 : x ≫ L.schemeKerStr n = y ≫ L.schemeKerStr n) : x = y :=
  pullback.hom_ext h1 h2

p2m_export "L1Asm22.KerOps" "hom_ext"

theorem nsmul_mul (hc : L.IsCommutative) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R))
    (k : ℕ) (P Q : SchemeHomOver t f) :
    L.nsmul t k (L.mul t P Q) = L.mul t (L.nsmul t k P) (L.nsmul t k Q) := by
  induction k with
  | zero => simp [RelativeGroupLaw.nsmul_zero, L.one_mul]
  | succ k ih =>
      rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, ih]
      set a := L.nsmul t k P
      set b := L.nsmul t k Q
      calc L.mul t (L.mul t a b) (L.mul t P Q)
          = L.mul t a (L.mul t b (L.mul t P Q)) := L.mul_assoc t a b _
        _ = L.mul t a (L.mul t (L.mul t b P) Q) := by rw [L.mul_assoc t b P Q]
        _ = L.mul t a (L.mul t (L.mul t P b) Q) := by rw [hc.mul_comm t b P]
        _ = L.mul t a (L.mul t P (L.mul t b Q)) := by rw [L.mul_assoc t P b Q]
        _ = L.mul t (L.mul t a P) (L.mul t b Q) := (L.mul_assoc t a P _).symm

theorem inv_eq_of_mul_eq_one {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f)
    (h : L.mul t P Q = L.one t) : L.inv t P = Q := by
  calc L.inv t P = L.mul t (L.inv t P) (L.one t) := (L.mul_one t _).symm
    _ = L.mul t (L.inv t P) (L.mul t P Q) := by rw [h]
    _ = Q := by rw [← L.mul_assoc, L.inv_mul_cancel, L.one_mul]

theorem mul_inv_cancel {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P : SchemeHomOver t f) :
    L.mul t P (L.inv t P) = L.one t := by
  have h1 : L.inv t (L.inv t P) = P := inv_eq_of_mul_eq_one L t _ _ (L.inv_mul_cancel t P)
  have h2 := L.inv_mul_cancel t (L.inv t P)
  rwa [h1] at h2

theorem inv_mul (hc : L.IsCommutative) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f) :
    L.inv t (L.mul t P Q) = L.mul t (L.inv t P) (L.inv t Q) := by
  apply inv_eq_of_mul_eq_one
  calc L.mul t (L.mul t P Q) (L.mul t (L.inv t P) (L.inv t Q))
      = L.mul t (L.mul t Q P) (L.mul t (L.inv t P) (L.inv t Q)) := by rw [hc.mul_comm t P Q]
    _ = L.mul t Q (L.mul t P (L.mul t (L.inv t P) (L.inv t Q))) := L.mul_assoc t Q P _
    _ = L.mul t Q (L.mul t (L.mul t P (L.inv t P)) (L.inv t Q)) := by rw [L.mul_assoc t P (L.inv t P)]
    _ = L.mul t Q (L.inv t Q) := by rw [mul_inv_cancel, L.one_mul]
    _ = L.one t := mul_inv_cancel L t Q

theorem inv_one {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) : L.inv t (L.one t) = L.one t :=
  inv_eq_of_mul_eq_one L t _ _ (L.one_mul t _)

theorem nsmul_inv (hc : L.IsCommutative) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R))
    (k : ℕ) (P : SchemeHomOver t f) :
    L.nsmul t k (L.inv t P) = L.inv t (L.nsmul t k P) := by
  induction k with
  | zero => simp [RelativeGroupLaw.nsmul_zero, inv_one]
  | succ k ih => rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, ih, ← inv_mul L hc]

def mulK (hc : L.IsCommutative) : pullback (L.schemeKerStr n) (L.schemeKerStr n) ⟶ L.schemeKer n :=
  lift L n
    (L.mul (pullback.fst _ _ ≫ L.schemeKerStr n)
      (toPt L n (pullback.fst _ _) rfl) (toPt L n (pullback.snd _ _) pullback.condition.symm))
    (by rw [nsmul_mul L hc, nsmul_toPt, nsmul_toPt, L.one_mul])

theorem mulK_ι (hc : L.IsCommutative) :
    mulK L n hc ≫ ι L n =
      (L.mul (pullback.fst (L.schemeKerStr n) (L.schemeKerStr n) ≫ L.schemeKerStr n)
        (toPt L n (pullback.fst _ _) rfl) (toPt L n (pullback.snd _ _) pullback.condition.symm)).1 :=
  lift_ι _ _ _ _

theorem mulK_str (hc : L.IsCommutative) :
