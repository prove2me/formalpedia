private theorem toConv_id_pow_fib_eq_one (n : ℕ)
    (hH : WithConv.toConv (LinearMap.id : H →ₗ[Zq p] H) ^ n = 1) :
    WithConv.toConv (LinearMap.id : Fib p H →ₗ[ZMod p] Fib p H) ^ n = 1 := by

  have hB : WithConv.toConv (BialgHom.id (Zq p) H) ^ n = 1 := by
