lemma encode_cons_decode {F : ℕ} {B : Shape} {c r : ℕ} (hr : r < AModel.vol B) :
    encode (F :: B) (c :: decode B r) = c * AModel.vol B + r := by
  simp only [encode, List.headD_cons, List.tail_cons, encode_decode hr]

/-- **The one-field extraction is `unpadL`.** -/
theorem extract_eq_unpadL (A B : Shape) {F F' : ℕ} (hF : F ≤ F') (d : α) {ys : List α}
    (hys : ys.length = AModel.vol (A ++ F' :: B)) :
    AModelL12.extract (A ++ F :: B) (A ++ F' :: B) d ys = unpadL (AModel.vol A) F F' (AModel.vol B) ys := by
  have hys' : AModel.vol A * (F' * AModel.vol B) ≤ ys.length := by rw [hys]; simp [vol_append]
  apply List.ext_getElem (by rw [length_extract, length_unpadL hys' hF]; simp [vol_append])
  intro i h1 h2
  have hi : i < AModel.vol A * (F * AModel.vol B) := by simpa [vol_append] using h1
  have hL : 0 < F * AModel.vol B := by
    rcases Nat.eq_zero_or_pos (F * AModel.vol B) with h | h
    · rw [h, Nat.mul_zero] at hi; omega
    · exact h
  have hY : 0 < AModel.vol B := Nat.pos_of_mul_pos_left hL
  have hx : i / (F * AModel.vol B) < AModel.vol A := (Nat.div_lt_iff_lt_mul hL).2 hi
  have hr : i % (F * AModel.vol B) < F * AModel.vol B := Nat.mod_lt _ hL
  have hrY : i % (F * AModel.vol B) / AModel.vol B < F' :=
    lt_of_lt_of_le ((Nat.div_lt_iff_lt_mul hY).2 hr) hF
  have e := getElem_flatMap_range (L := F * AModel.vol B)
    (f := fun x => (ys.drop (x * (F' * AModel.vol B))).take (F * AModel.vol B)) (AModel.vol A) (fun x hx => by
      simp only [List.length_take, List.length_drop]
      apply min_eq_left
      have : (x + 1) * (F' * AModel.vol B) ≤ AModel.vol A * (F' * AModel.vol B) := Nat.mul_le_mul_right _ hx
      have h2 : F * AModel.vol B ≤ F' * AModel.vol B := Nat.mul_le_mul_right _ hF
      rw [Nat.succ_mul] at this; omega) i hi
  refine Eq.trans ?_ e.symm
  simp only [List.getElem_take, List.getElem_drop]
  simp only [AModelL12.extract]
  rw [getElem_pull]
  have hdec : decode (A ++ F :: B) i =
      decode A (i / (F * AModel.vol B)) ++ (i % (F * AModel.vol B) / AModel.vol B :: decode B (i % (F * AModel.vol B) % AModel.vol B)) := by
    rw [decode_append A (F :: B) (by simpa using hi), vol_cons, decode_cons_lt hr]
  rw [hdec, id, encode_append_len A (F' :: B) (AModel.length_decode _ _), encode_decode hx,
    encode_cons_decode (Nat.mod_lt _ hY), vol_cons, Nat.div_add_mod', List.getD_eq_getElem]

