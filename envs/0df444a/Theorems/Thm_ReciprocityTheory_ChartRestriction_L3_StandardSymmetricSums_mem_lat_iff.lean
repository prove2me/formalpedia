theorem ReciprocityTheory.ChartRestriction.L3.StandardSymmetricSums.mem_lat_iff {n : ℕ} {e : Fin n → V} (x : V) :
    x ∈ Submodule.span (𝓞 K) (Set.range e) ↔
      ∃ c : Fin n → 𝓞 K, ∑ i, algebraMap (𝓞 K) K (c i) • e i = x := by sorry
