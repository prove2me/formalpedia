-- title:
--   Proposition 3.3 — Gaussian regression: the conditional law of a Gaussian vector given a full-row-rank linear image
-- statement:
--   Let $Z\sim N(m,\Sigma)$ in $\mathbb R^d$ with $\Sigma\succ0$, and let $T:\mathbb R^d\to\mathbb R^k$ be a linear map of full row rank. Then:
--   1. the conditional law of $Z$ given $TZ=b$ is
--   $$Z\mid\{TZ=b\}\sim N\big(m+\Sigma T^\top(T\Sigma T^\top)^{-1}(b-Tm),\ \Sigma-\Sigma T^\top(T\Sigma T^\top)^{-1}T\Sigma\big);$$
--   2. the regression residual $Z-\mathbb E[Z\mid TZ]$ is Gaussian and independent of $TZ$;
--   3. when $\Sigma=\sigma^2I_d$, with $z_b$ the point of the affine subspace $\{z:Tz=b\}$ closest to $m$, $\mathrm{Law}(Z\mid TZ=b)=\mathrm{Law}(z_b+\sigma P_{\ker T}G)$, $G\sim N(0,I_d)$, where $P_{\ker T}$ is the orthogonal projection onto $\ker T$.
--
--   These formulas describe the law of the data matrix conditioned on the linear history of ITERATED-LP.
--
--   Differences from the source:
--
--   - encoding: Z | {TZ = b} ∼ N(m_b, Σ_c) (a conditional law given a continuous variable) → every Markov kernel κ with κ(b) = multivariateGaussian(m_b, Σ_c) for all b is a version: Law(TZ, Z) = Law(TZ) ⊗ₘ κ; reason: conditional laws given continuous variables are defined up to versions; this states that the Gaussian family is one
--   - encoding: Z ∼ N(m, Σ) in ℝ^d; T linear of full row rank → a measurable Z on an arbitrary probability space with Law(Z) = multivariateGaussian m Σ on EuclideanSpace ℝ (Fin d); T a k × d matrix of rank k acting by toEuclideanLin; reason: same objects
--   - encoding: E[Z | TZ]; 'Gaussian and independent of TZ' → Mathlib's condExp of Z w.r.t. the σ-algebra generated by TZ; IsGaussian of the residual's law and IndepFun of residual and TZ; reason: independence and law do not depend on the a.e. version of the conditional expectation
--   - encoding: Σ = σ²I_d; z_b the closest point of {Tz = b} to m; P_ker T → σ > 0 with Σ = σ² • 1; any function zb with T zb(b) = b and ‖zb(b) − m‖ ≤ ‖z − m‖ on {Tz = b} (the closest point is unique); the starProjection onto ker T; reason: Σ ≻ 0 forces σ ≠ 0, and σ and −σ give the same law by symmetry of G
-- source:
--   Zhang, Li, State Evolution and Universality of Iterated Linear Programs for the Binary Perceptron, arXiv:2611.04294v1, p. 14, Proposition 3.3

import Mathlib

open MeasureTheory ProbabilityTheory Matrix

namespace IteratedLP.Gaussian

/-- Proposition 3.3 (Gaussian regression, p. 14). Let `Z ∼ N(m, Σ)` in `ℝ^d` with `Σ ≻ 0`, and
let `T : ℝ^d → ℝ^k` be linear of full row rank. Then
1. `Z | {TZ = b} ∼ N(m + ΣT⊤(TΣT⊤)⁻¹(b - Tm), Σ - ΣT⊤(TΣT⊤)⁻¹TΣ)`: every kernel `κ` with these
   Gaussian laws is a version of the conditional law, i.e. `Law(TZ, Z) = Law(TZ) ⊗ κ`;
2. the regression residual `Z - E[Z | TZ]` is Gaussian and independent of `TZ`;
3. when `Σ = σ² I_d` (`σ > 0`) and `z_b` is the point of `{z : Tz = b}` closest to `m`,
   `Law(Z | TZ = b) = Law(z_b + σ P_{ker T} G)` with `G ∼ N(0, I_d)`: every kernel with these
   laws is a version of the conditional law. -/
theorem proposition_3_3 (d k : ℕ) (m : EuclideanSpace ℝ (Fin d))
    (Sig : Matrix (Fin d) (Fin d) ℝ) (hSig : Sig.PosDef)
    (T : Matrix (Fin k) (Fin d) ℝ) (hT : T.rank = k)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (Z : Ω → EuclideanSpace ℝ (Fin d)) (hZ : Measurable Z)
    (hlaw : P.map Z = multivariateGaussian m Sig) :
    (∀ κ : ProbabilityTheory.Kernel (EuclideanSpace ℝ (Fin k)) (EuclideanSpace ℝ (Fin d)),
      (∀ b, κ b = multivariateGaussian
        (m + toEuclideanLin (Sig * Tᵀ * (T * Sig * Tᵀ)⁻¹) (b - toEuclideanLin T m))
        (Sig - Sig * Tᵀ * (T * Sig * Tᵀ)⁻¹ * T * Sig)) →
      P.map (fun ω => (toEuclideanLin T (Z ω), Z ω)) =
        (P.map (fun ω => toEuclideanLin T (Z ω))) ⊗ₘ κ) ∧
    (IsGaussian (P.map (fun ω => Z ω -
        (P[Z | MeasurableSpace.comap (fun ω => toEuclideanLin T (Z ω)) inferInstance]) ω)) ∧
      IndepFun (fun ω => Z ω -
        (P[Z | MeasurableSpace.comap (fun ω => toEuclideanLin T (Z ω)) inferInstance]) ω)
        (fun ω => toEuclideanLin T (Z ω)) P) ∧
    (∀ σ : ℝ, 0 < σ → Sig = σ ^ 2 • (1 : Matrix (Fin d) (Fin d) ℝ) →
      ∀ zb : EuclideanSpace ℝ (Fin k) → EuclideanSpace ℝ (Fin d),
        (∀ b, toEuclideanLin T (zb b) = b ∧
          ∀ z, toEuclideanLin T z = b → ‖zb b - m‖ ≤ ‖z - m‖) →
      ∀ κ : ProbabilityTheory.Kernel (EuclideanSpace ℝ (Fin k)) (EuclideanSpace ℝ (Fin d)),
        (∀ b, κ b = (stdGaussian (EuclideanSpace ℝ (Fin d))).map
          (fun g => zb b + σ • (LinearMap.ker (toEuclideanLin T)).starProjection g)) →
        P.map (fun ω => (toEuclideanLin T (Z ω), Z ω)) =
          (P.map (fun ω => toEuclideanLin T (Z ω))) ⊗ₘ κ) := by sorry

end IteratedLP.Gaussian
