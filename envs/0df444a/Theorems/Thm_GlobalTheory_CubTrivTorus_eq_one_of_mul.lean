theorem GlobalTheory.CubTrivTorus.eq_one_of_mul {Y : Over S} [GrpObj Y] [ConnectedSpace Y.left] (ρ : Γ((splitTorus S X ⊗ Y).left, ⊤)ˣ)
    (hρ : ∀ (Z : Over S) (t t' : Z ⟶ splitTorus S X) (y : Z ⟶ Y) (z : Z.left),
      gm (lift (t * t') y).left z ⊤ ρ = gm (lift t y).left z ⊤ ρ * gm (lift t' y).left z ⊤ ρ)
    (h₁ : ∀ (Z : Over S) (t : Z ⟶ splitTorus S X) (z : Z.left), gm (lift t (1 : Z ⟶ Y)).left z ⊤ ρ = 1)
    (Z : Over S) (t : Z ⟶ splitTorus S X) (y : Z ⟶ Y) (z : Z.left) : gm (lift t y).left z ⊤ ρ = 1 := by sorry
