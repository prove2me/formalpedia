section
-- Source module: Solutions.J6SegBand
/-!
# Segmented inverse (S2): sparse (banded + border) elimination

`geSolveS P S L A b` is the elimination of `geSolve` restricted to a pattern `S`: the Schur
update of `(i, k)` is performed only when `S i j ∧ S j k`, the right-hand side update only when
`S i j`, and the back substitution sums only over `S j k`.

`geSolveS_eq`: if `A` vanishes off `S` on `L × L`, `S` is closed under elimination in the order of
`L` (`PatOK`: `S i j → S j k → S i k` for `i, k` after the pivot `j`), and the hypotheses of
`geSolve_resid` hold (row deviation `η`, `η + |L|²/2^P ≤ 1/2`, so every pivot is positive), then
`geSolveS = geSolve`. Hence the error theorems of `geSolve` hold verbatim for the sparse version.

`bandS m c a b`: `|a - b| ≤ m` or `a ≥ c` or `b ≥ c` (band plus a border at the end, the
cyclic block-tridiagonal shape); `PatOK` holds for it along any increasing list (`bandS_patOK`).
-/

open Finset

namespace J6Seg

section band
variable (P : ℕ)

lemma rq_zero {d : ℤ} (hd : 0 < d) : rq 0 d = 0 := by
  unfold rq; simp only [mul_zero, zero_add]
  exact Int.ediv_eq_zero_of_lt hd.le (by omega)

lemma fmul_zero_left (y : ℤ) : fmul P 0 y = 0 := by
  unfold fmul rs; rw [zero_mul]; exact rq_zero (by positivity)

theorem bandS_patOK (m c : ℕ) : ∀ L : List ℕ, L.Pairwise (· < ·) → PatOK (bandS m c) L := by
  intro L
  induction L with
  | nil => intro _; trivial
  | cons j L ih =>
    intro hL
    rw [List.pairwise_cons] at hL
    refine ⟨fun i hi k hk h1 h2 => ?_, ih hL.2⟩
    have hi' := hL.1 i hi
    have hk' := hL.1 k hk
    unfold bandS at h1 h2 ⊢
    omega

end band

end J6Seg

end

section
-- Source module: Solutions.J6SegSparse
/-!
# Segmented inverse (S2): the sparse algorithm

`segInvS P lam T B U` is `segInv` with the capacitance solved by `geSolveS` on the pattern
`bandS (λ + w) (s - λ - w)`: a band of half-width `λ + w` (blocks of length `≤ λ`, coupling width
`w`) plus the border of positions `≥ s - λ - w` (the cyclic wrap). Per row of the capacitance
at most `2(λ+w)+1` band entries plus the border are touched.

* `capI_band`: the capacitance vanishes off the pattern;
* `segInvS_eq`: under the hypotheses of `segInv_err`, `segInvS = segInv`;
* `segInvFullS_err`: the fully instantiated sparse algorithm satisfies the bound of
  `segInvFull_err`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section sp
variable {P s t α lam : ℕ} {B : Blocks} {T : Tables}

lemma Jlist_pairwise (B : Blocks) : (Jlist B).Pairwise (· < ·) :=
  (List.pairwise_lt_range).filter _

/-- The capacitance vanishes off the band-plus-border pattern. -/
theorem capI_band (hB : BlocksOK s t B) (hs : 0 < s) (hlam : ∀ i < s, B.len i ≤ lam)
    {a b : ℕ} (ha : a < s) (hnb : ¬ bandS (lam + B.w) (B.s - lam - B.w) a b) :
    capI P T B a b = 0 := by
  have hbs := hB.hs
  have hw := hB.hw
  obtain ⟨c1, c2, c3⟩ := hB.cover a ha
  have hla := hlam a ha
  unfold bandS at hnb
  rw [hbs] at hnb
  unfold capI
  have hab : a ≠ b := by intro h; subst h; exact hnb (Or.inl ⟨by omega, by omega⟩)
  rw [if_neg hab, zero_add]
  refine sum_eq_zero fun i hi => sum_eq_zero fun h hh => ?_
  rw [mem_Ico] at hi
  obtain ⟨hw1, hw2, _, _⟩ := mem_Hset hh
  rw [if_neg]
  intro hcol
  unfold col at hcol
  rw [hbs] at hcol
  have hcase := emod_cases hs (a := (i : ℤ) + h) (by omega) (by omega)
  have hjv : (((((i : ℤ) + h) % s).toNat : ℕ) : ℤ) = ((i : ℤ) + h) % s :=
    Int.toNat_of_nonneg (Int.emod_nonneg _ (by exact_mod_cast hs.ne'))
  rw [hcol] at hjv
  omega

end sp

end J6Seg

