theorem IntMul.Kappa.R6.sp_cnt (s : IState HS) (f : Fin HS → List ℤ) (C rd R : Fin HS) (tst : Ex HS)
    (Pr : ℕ → Prop) [DecidablePred Pr] (N Bb : ℕ) (lR : List ℤ)
    (hC5 : C.val < 56) (hd5 : rd.val < 56) (hR5 : R.val < 56) (hCd : C ≠ rd) (hRd : R ≠ rd)
    (hRC : R ≠ C) (hfC : f C = []) (hfR : f R = (N : ℤ) :: lR) (hz : zsz ((N + 1 : ℕ) : ℤ) ≤ Bb)
    (htc : tst.Clean)
    (htst : ∀ x, 1 ≤ x → x ≤ N → ∀ acc : ℤ, 0 ≤ acc → acc ≤ N →
      tst.ok (encK s (update (update f rd (acc :: f rd)) C [(x : ℤ)])) ∧
      (tst.eval (encK s (update (update f rd (acc :: f rd)) C [(x : ℤ)])) < 0 ↔ Pr x) ∧
      tst.Bnd (encK s (update (update f rd (acc :: f rd)) C [(x : ℤ)])) Bb) :
    Sp (IntMul.Kappa.R6.cntR C rd R tst) (encK s f)
      (encK s (update f rd ((∑ x ∈ Icc 1 N, if Pr x then (1 : ℤ) else 0) :: f rd)))
      ((N * (tst.size + 7) + 3) * kU Bb) := by sorry
