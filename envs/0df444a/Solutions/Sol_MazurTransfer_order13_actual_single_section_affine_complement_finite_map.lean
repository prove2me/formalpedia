noncomputable section
universe u
namespace MazurTransfer.Order13SingleSectionFiniteAlgebra
open Polynomial
open MazurTorsion.XOneThirteenAffineCurve
open Order13SingleSectionFiniteMapIdentities
variable (R : Type u) [CommRing R]

def infinityPatchElement : candidateAlgebra R :=
  pElement R * (pElement R + parameterElement R)

theorem ordinary_two_generator_unit_ideal (h2 : IsUnit (2 : R)) :
    Ideal.span ({t R,p R + 2} : Set (CoordinateRing R)) = ⊤ := by
  let I : Ideal (CoordinateRing R) := Ideal.span {t R,p R + 2}
  have ht : t R ∈ I := Ideal.subset_span (by simp)
  have hk : p R + 2 ∈ I := Ideal.subset_span (by simp)
  have h2mem : (2 : CoordinateRing R) ∈ I := by
    have hm := I.sub_mem hk (I.mul_mem_left (xCoordinate R) ht)
    have heq : p R + 2 - xCoordinate R * t R = 2 := by dsimp [p]; ring
    rwa [heq] at hm
  exact I.eq_top_of_isUnit_mem h2mem (by simpa only [_root_.map_ofNat] using h2.map (algebraMap R (CoordinateRing R)))

theorem ordinary_two_principal_open_cover (h2 : IsUnit (2 : R)) :
    PrimeSpectrum.basicOpen (t R) ⊔ PrimeSpectrum.basicOpen (p R + 2) = ⊤ := by
  have h := PrimeSpectrum.iSup_basicOpen_eq_top_iff'.mpr (ordinary_two_generator_unit_ideal R h2)
  simpa only [iSup_insert,iSup_singleton] using h

theorem candidate_three_generator_unit_ideal (h2 : IsUnit (2 : R)) :
    Ideal.span ({parameterElement R,pElement R + 2,infinityPatchElement R} :
      Set (candidateAlgebra R)) = ⊤ := by
  let I : Ideal (candidateAlgebra R) :=
    Ideal.span {parameterElement R,pElement R + 2,infinityPatchElement R}
  have ht : parameterElement R ∈ I := Ideal.subset_span (by simp)
  have hk : pElement R + 2 ∈ I := Ideal.subset_span (by simp)
  have hr : infinityPatchElement R ∈ I := Ideal.subset_span (by simp)
  have h4 : (4 : candidateAlgebra R) ∈ I := by
    have hm := I.sub_mem (I.sub_mem hr (I.mul_mem_right (pElement R - 2) hk))
      (I.mul_mem_right (pElement R) ht)
    have heq : infinityPatchElement R - (pElement R + 2) * (pElement R - 2) -
        parameterElement R * pElement R = 4 := by dsimp [infinityPatchElement]; ring
    rwa [heq] at hm
  exact I.eq_top_of_isUnit_mem h4 (by
    have h := (h2.map (algebraMap R (candidateAlgebra R))).pow 2
    simpa only [_root_.map_ofNat,show (2 : candidateAlgebra R) ^ 2 = 4 by ring] using h)

theorem candidate_three_principal_open_cover (h2 : IsUnit (2 : R)) :
    PrimeSpectrum.basicOpen (parameterElement R) ⊔
      (PrimeSpectrum.basicOpen (pElement R + 2) ⊔
        PrimeSpectrum.basicOpen (infinityPatchElement R)) = ⊤ := by
  have h := PrimeSpectrum.iSup_basicOpen_eq_top_iff'.mpr (candidate_three_generator_unit_ideal R h2)
  simpa only [iSup_insert,iSup_singleton] using h

end MazurTransfer.Order13SingleSectionFiniteAlgebra
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.ordinary_two_principal_open_cover
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.candidate_three_principal_open_cover

end
