section SCAFFOLDBundleModule16
/-!
Stored noiseless control estimates for SCAFFOLD Appendix E.1, PDF pp. 27-28,
Lemma 13, derived using the corrected stored-gradient interpretation of (24).
Gradient growth is the proved equation (9), Appendix B.1, PDF p. 14.
-/

noncomputable section
open MeasureTheory
open scoped BigOperators
namespace SCAFFOLD

theorem Convexity.zero {d N : ℕ} {P : Problem d N} {μ : ℝ}
    (h : Convexity P μ) : Convexity P 0 := by
  refine ⟨le_rfl, fun i x y ↦ ?_⟩
  have hs := h.2 i x y
  have hn := mul_nonneg (div_nonneg h.1 (by norm_num : (0 : ℝ) ≤ 2))
    (sq_nonneg ‖y - x‖)
  simpa only [zero_div, zero_mul, add_zero] using (by linarith :
    P.f i x + inner ℝ (gradient (P.f i) x) (y - x) ≤ P.f i y)

theorem gradient_average_error_bound {d N K : ℕ} (P : Problem d N) (hK : 0 < K)
    (i : Fin N) (xstar x : Space d) (y : Fin K → Space d) :
    ‖(K : ℝ)⁻¹ • ∑ k, gradient (P.f i) (y k) - gradient (P.f i) xstar‖ ^ 2 ≤
      2 * P.β ^ 2 * ((K : ℝ)⁻¹ * ∑ k, ‖y k - x‖ ^ 2) +
        2 * ‖gradient (P.f i) x - gradient (P.f i) xstar‖ ^ 2 := by
  have hK0 : (K : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hK
  rw [← average_sub_const hK]
  apply (norm_average_sq_le hK _).trans
  have hpoint (k : Fin K) :
      ‖gradient (P.f i) (y k) - gradient (P.f i) xstar‖ ^ 2 ≤
        2 * P.β ^ 2 * ‖y k - x‖ ^ 2 +
          2 * ‖gradient (P.f i) x - gradient (P.f i) xstar‖ ^ 2 := by
    let a := gradient (P.f i) (y k) - gradient (P.f i) x
    let b := gradient (P.f i) x - gradient (P.f i) xstar
    have hs := pow_le_pow_left₀ (norm_nonneg _) (P.smooth i (y k) x) 2
    have ht : ‖a + b‖ ^ 2 ≤ 2 * ‖a‖ ^ 2 + 2 * ‖b‖ ^ 2 := by
      nlinarith [norm_add_sq_real a b, norm_sub_sq_real a b, sq_nonneg ‖a - b‖]
    dsimp [a, b] at ht
    rw [sub_add_sub_cancel] at ht
    nlinarith
  have hs := mul_le_mul_of_nonneg_left
    (Finset.sum_le_sum (s := Finset.univ) (fun k _ ↦ hpoint k))
    (inv_nonneg.mpr (Nat.cast_nonneg K : (0 : ℝ) ≤ K))
  convert hs using 1
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const,
    Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  field_simp

theorem fresh_control_energy_pointwise {d N K : ℕ} (P : Problem d N) (hK : 0 < K)
    {μ : ℝ} (hc : Convexity P μ) {xstar : Space d} (hx : IsMinimizer P xstar)
    (x : Space d) (y : Fin N → Fin K → Space d) :
    (N : ℝ)⁻¹ * ∑ i,
      ‖(K : ℝ)⁻¹ • ∑ k, gradient (P.f i) (y i k) - gradient (P.f i) xstar‖ ^ 2 ≤
      4 * P.β * (objective P.f x - objective P.f xstar) +
        2 * P.β ^ 2 * ((N : ℝ)⁻¹ * (K : ℝ)⁻¹ * ∑ i, ∑ k, ‖y i k - x‖ ^ 2) := by
  have hgrowth := SCAFFOLD.GradientGrowth d N P xstar hc.zero hx x
  have hs := mul_le_mul_of_nonneg_left (Finset.sum_le_sum (s := Finset.univ)
    (fun i _ ↦ gradient_average_error_bound P hK i xstar x (y i)))
    (inv_nonneg.mpr (Nat.cast_nonneg N : (0 : ℝ) ≤ N))
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum] at hs
  nlinarith

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

theorem Run.controlEnergy_step (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (xstar : Space d) :
    controlEnergy A xstar (r + 1) =
      (1 - (S : ℝ) / N) * controlEnergy A xstar r +
        ((S : ℝ) / N) * ((N : ℝ)⁻¹ * ∑ i,
          ∫ ω, ‖averageSignal A r i ω - gradient (P.f i) xstar‖ ^ 2 ∂ν) := by
  have hi (i : Fin N) :
      (∫ ω, ‖storedSignal A (r + 1) i ω - gradient (P.f i) xstar‖ ^ 2 ∂ν) =
        ((S : ℝ) / N) * (∫ ω,
          ‖averageSignal A r i ω - gradient (P.f i) xstar‖ ^ 2 ∂ν) +
        (1 - (S : ℝ) / N) * (∫ ω,
          ‖storedSignal A r i ω - gradient (P.f i) xstar‖ ^ 2 ∂ν) := by
    have heq : (fun ω ↦ ‖storedSignal A (r + 1) i ω -
        gradient (P.f i) xstar‖ ^ 2) = fun ω ↦ if i ∈ A.sample r ω then
        ‖averageSignal A r i ω - gradient (P.f i) xstar‖ ^ 2 else
        ‖storedSignal A r i ω - gradient (P.f i) xstar‖ ^ 2 := by
      funext ω
      dsimp [storedSignal]
      split <;> rfl
    rw [heq]
    apply A.refresh_integral hr i
    · exact ((A.averageSignal_memLp hr i).sub (memLp_const _)).norm.integrable_sq
    · exact ((A.storedSignal_memLp hr.le i).sub (memLp_const _)).norm.integrable_sq
    · exact ((continuous_norm.pow 2).comp_stronglyMeasurable
        ((A.averageSignal_adapted hr i).sub stronglyMeasurable_const)).aestronglyMeasurable
    · exact ((continuous_norm.pow 2).comp_stronglyMeasurable
        (((A.storedSignal_adapted hr.le i).mono
        (A.history.mono (Nat.le_add_right (roundTime K r) K))).sub
        stronglyMeasurable_const)).aestronglyMeasurable
  simp only [controlEnergy, hi, Finset.sum_add_distrib, ← Finset.mul_sum]
  ring

theorem Run.fresh_control_energy_bound (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) {μ : ℝ} (hc : Convexity P μ)
    {xstar : Space d} (hx : IsMinimizer P xstar) :
    (N : ℝ)⁻¹ * ∑ i, (∫ ω,
      ‖averageSignal A r i ω - gradient (P.f i) xstar‖ ^ 2 ∂ν) ≤
      4 * P.β * expectedGap A xstar r + 2 * P.β ^ 2 * driftEnergy A r := by
  have ha (i : Fin N) : Integrable (fun ω ↦
      ‖averageSignal A r i ω - gradient (P.f i) xstar‖ ^ 2) ν :=
    ((A.averageSignal_memLp hr i).sub (memLp_const _)).norm.integrable_sq
  have hd (i : Fin N) (k : Fin K) : Integrable (fun ω ↦
      ‖A.y r k i ω - A.x r ω‖ ^ 2) ν :=
    ((A.y_memLp r hr k k.isLt.le i).sub (A.x_memLp r hr.le)).norm.integrable_sq
  have hpoint (ω : Ω) :
      (N : ℝ)⁻¹ * ∑ i, ‖averageSignal A r i ω - gradient (P.f i) xstar‖ ^ 2 ≤
        4 * P.β * (objective P.f (A.x r ω) - objective P.f xstar) +
          2 * P.β ^ 2 * ((N : ℝ)⁻¹ * (K : ℝ)⁻¹ *
            ∑ i, ∑ k : Fin K, ‖A.y r k i ω - A.x r ω‖ ^ 2) := by
    have hf := fresh_control_energy_pointwise P A.steps_pos hc hx (A.x r ω)
      (fun i k ↦ A.y r k i ω)
    have heq (i : Fin N) : averageSignal A r i ω =
        (K : ℝ)⁻¹ • ∑ k : Fin K, gradient (P.f i) (A.y r k i ω) := by
      dsimp [averageSignal, clientGradient]
      rw [Fin.sum_univ_eq_sum_range (fun k ↦ gradient (P.f i) (A.y r k i ω))]
    simpa only [heq] using hf
  have hi := integral_mono
    ((integrable_finsetSum Finset.univ (fun i _ ↦ ha i)).const_mul (N : ℝ)⁻¹)
    (((A.gap_integrable xstar hr.le).const_mul (4 * P.β)).add
      (((integrable_finsetSum Finset.univ (fun i _ ↦
        integrable_finsetSum Finset.univ (fun k _ ↦ hd i k))).const_mul
        ((N : ℝ)⁻¹ * (K : ℝ)⁻¹)).const_mul (2 * P.β ^ 2))) hpoint
  rw [integral_const_mul,
    integral_finsetSum Finset.univ (fun i _ ↦ ha i)] at hi
  simp only [Pi.add_apply] at hi
  rw [integral_add ((A.gap_integrable xstar hr.le).const_mul (4 * P.β))
    (((integrable_finsetSum Finset.univ (fun i _ ↦
      integrable_finsetSum Finset.univ (fun k _ ↦ hd i k))).const_mul
      ((N : ℝ)⁻¹ * (K : ℝ)⁻¹)).const_mul (2 * P.β ^ 2))] at hi
  simp only [integral_const_mul, integral_finsetSum Finset.univ (fun i _ ↦
    integrable_finsetSum Finset.univ (fun k _ ↦ hd i k)),
    integral_finsetSum Finset.univ (fun k _ ↦ hd _ k)] at hi
  simpa only [expectedGap, driftEnergy, mul_inv_rev, mul_comm] using hi

theorem Run.controlEnergy_recurrence (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) {μ : ℝ} (hc : Convexity P μ)
    {xstar : Space d} (hx : IsMinimizer P xstar) :
    controlEnergy A xstar (r + 1) ≤
      (1 - (S : ℝ) / N) * controlEnergy A xstar r +
        ((S : ℝ) / N) * (4 * P.β * expectedGap A xstar r +
          2 * P.β ^ 2 * driftEnergy A r) := by
  rw [A.controlEnergy_step hr xstar]
  exact add_le_add_right (mul_le_mul_of_nonneg_left
    (A.fresh_control_energy_bound hr hc hx)
    (div_nonneg (Nat.cast_nonneg S) (Nat.cast_nonneg N))) _

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule16
