theorem rootB_run (m : ℕ) (rv rd : Fin HS) (h : RootRegs rv rd) (s : IState HS) (v : ℕ) (LV La : List Item)
    (hV : s.G rv = .int (v : ℤ) :: LV) (k : ℕ) (hk : k < v) (c : ℤ) :
    (rootB m rv rd).ok (lpSt s NLogN.KFM.sI rd La v k c) ∧
      (rootB m rv rd).run (lpSt s NLogN.KFM.sI rd La v k c) =
        (lpSt s NLogN.KFM.sI rd La v k c).upd rd (.int (c + rootInd m v (v - k)) :: La) := by
  obtain ⟨hv56, hd56, -, vI, vY, vJ, dI, dY, dJ, vd⟩ := h
  set u := lpSt s NLogN.KFM.sI rd La v k c with hu
  have uI : u.G NLogN.KFM.sI = .int ((v : ℤ) - k) :: s.G sI := lpSt_G_i _ _ _ _ _ _ _ (Ne.symm dI)
  have uD : u.G rd = .int c :: La := lpSt_G_a _ _ _ _ _ _ _
  have uV : u.G rv = .int (v : ℤ) :: LV := by rw [hu, lpSt_G_ne _ _ _ _ _ _ _ _ vI vd, hV]
  have uY : u.G sY = s.G sY := lpSt_G_ne _ _ _ _ _ _ _ _ (by decide) (Ne.symm dY)
  have ex : ((v : ℤ) - k) = ((v - k : ℕ) : ℤ) := by push_cast [hk.le]; ring
  -- push
  set u1 := u.upd sY (.int ((v - k : ℕ) : ℤ) :: s.G sY) with hu1
  have r1 : (RS.push sY (.reg NLogN.KFM.sI)).run u = u1 := by
    simp only [RS.run, Ex.eval, IState.top_eq uI, uY, ex, hu1]
  have k1 : (RS.push sY (.reg NLogN.KFM.sI)).ok u :=
    ⟨by decide, by intro j hj; simp [Ex.regs] at hj; subst hj; decide, IState.isInt_of uI⟩
  -- inner loop
  have u1Y : u1.G sY = .int ((v - k : ℕ) : ℤ) :: s.G sY := by simp [hu1]
  have u1V : u1.G rv = .int (v : ℤ) :: LV := by simp [hu1, IState.upd_G, vY, uV]
  obtain ⟨k2, r2⟩ := satLoop_run rv hv56 vJ vY u1 v (v - k) (s.G sY) LV u1Y u1V (by omega) m
  set y := min (((v - k : ℕ) : ℤ) ^ (2 ^ m)) ((v : ℤ) + 1) with hy
  set u2 := u1.upd sY (.int y :: s.G sY) with hu2
  have u2D : u2.G rd = .int c :: La := by simp [hu2, hu1, IState.upd_G, dY, uD]
  have u2V : u2.G rv = .int (v : ℤ) :: LV := by simp [hu2, hu1, IState.upd_G, vY, uV]
  have u2Y : u2.G sY = .int y :: s.G sY := by simp [hu2]
  -- the count update
  set e : Ex HS := .add (.reg rd) (.sel (.add (.reg rv) (.neg (.reg sY))) (.lit 0) (.lit 1)) with he
  have r3 : (RS.asg rd e).run u2 = u2.upd rd (.int (c + rootInd m v (v - k)) :: La) := by
    simp only [RS.run, he, Ex.eval, IState.top_eq u2D, IState.top_eq u2V, IState.top_eq u2Y, u2D,
      List.tail_cons]
    rw [hy, rootInd_eq]
  have k3 : (RS.asg rd e).ok u2 := by
    refine ⟨hd56, ?_, ?_, IState.isInt_of u2D⟩
    · intro j hj
      simp only [he, Ex.regs, List.mem_append, List.mem_singleton, List.not_mem_nil, List.nil_append,
        List.append_nil, or_false] at hj
      simp only [zX_all, List.mem_cons, List.not_mem_nil, or_false]
