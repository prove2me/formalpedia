  have hqx' := Ne.symm hqx
  have htop : ∀ X p, (readCfg (q := q) (x := x) Q σ 1 X p).top q ≠ some hlt := by
    intro X p; simp [readCfg, hlt]
  have htops : ∀ s X p, (readCfg (q := q) (x := x) Q σ s X p).tops [q, x] = [some s, X.head?] := by
    intro s X p; simp [St.tops, readCfg, St.top_set, hqx']
  intro W
  induction W with
  | nil =>
    intro t X p ht _ _ hstop
    refine Reaches.step' (σ₁ := readCfg (q := q) (x := x) Q σ 1 (stop :: t :: X) (p + 1))
      (htop _ _) ?_ ?_
    · rw [mstep, htops]
      simp only [readδ, List.head?_cons, Option.some.injEq, ht, if_false,
        show (1 : Sym) ≠ 0 by decide]
      simp only [List.getD_eq_getElem?_getD, List.length_nil, add_zero] at hstop
      simp [runOps, Op.run, readCfg, St.inRd_eq, St.push_set_ne, hqx, hqx', hstop]
    · refine Reaches.step' (htop _ _) ?_ (Reaches.refl _)
      rw [mstep, htops]
      simp only [readδ, List.head?_cons, if_true, show (1 : Sym) ≠ 0 by decide, if_false]
      simp [runOps, Op.run, readCfg, St.pop_set_ne, hqx, hqx']
  | cons w W ih =>
    intro t X p ht hW hk hstop
    have hw : w ≠ stop := fun h => hW (h ▸ List.mem_cons_self ..)
    refine Reaches.step' (σ₁ := readCfg (q := q) (x := x) Q σ 1 (w :: t :: X) (p + 1))
      (htop _ _) ?_ ?_
    · rw [mstep, htops]
      simp only [readδ, List.head?_cons, Option.some.injEq, ht, if_false,
        show (1 : Sym) ≠ 0 by decide]
      have := hk 0 (by simp)
      simp only [add_zero, List.getElem_cons_zero, List.getD_eq_getElem?_getD] at this
      simp [runOps, Op.run, readCfg, St.inRd_eq, St.push_set_ne, hqx, hqx', this]
