variable (B D A H W : ℝ → ℝ)
theorem solution {R : Set ℝ} (hB : ContDiffOn ℝ ∞ B R) (hD : ContDiffOn ℝ ∞ D R)
    (hA : ContDiffOn ℝ ∞ A R) (hH : ContDiffOn ℝ ∞ H R) (hW : ContDiffOn ℝ ∞ W R)
    (hB0 : ∀ r ∈ R, B r ≠ 0) (hD0 : ∀ r ∈ R, D r ≠ 0) (hA0 : ∀ r ∈ R, A r ≠ 0)
    (hH0 : ∀ r ∈ R, H r ≠ 0) (i j : Fin 5) :
    ContDiffOn ℝ ∞ (esInverse B D A H W i j) (esDomain R) := by
  have b := cd_radial hB; have d := cd_radial hD; have a := cd_radial hA
  have h := cd_radial hH; have w := cd_radial hW; have u := cd_u R; have v := cd_v R
  have nB : ∀ x ∈ esDomain R, B (x 1) ≠ 0 := fun x hx => hB0 _ hx.1
  have nD : ∀ x ∈ esDomain R, D (x 1) ≠ 0 := fun x hx => hD0 _ hx.1
  have nA : ∀ x ∈ esDomain R, A (x 1) ≠ 0 := fun x hx => hA0 _ hx.1
  have nH : ∀ x ∈ esDomain R, H (x 1) ≠ 0 := fun x hx => hH0 _ hx.1
  have nAu : ∀ x ∈ esDomain R, A (x 1) * x 2 ≠ 0 := fun x hx =>
    mul_ne_zero (nA x hx) hx.2.1.ne'
  have nAv : ∀ x ∈ esDomain R, A (x 1) * (1 - x 2) ≠ 0 := fun x hx =>
    mul_ne_zero (nA x hx) (by linarith [hx.2.2])
  have base : ContDiffOn ℝ ∞ (fun x : Pt 5 => -W (x 1) ^ 2 / B (x 1) + 1 / H (x 1)) (esDomain R) :=
    ((w.pow 2).neg.div b nB).add (contDiffOn_const.div h nH)
  fin_cases i <;> fin_cases j
  all_goals first
    | exact contDiffOn_const
    | exact contDiffOn_const.div b nB
    | exact w.neg.div b nB
    | exact contDiffOn_const.div d nD
    | exact ((contDiffOn_const.mul u).mul v).div a nA
    | exact base.add (v.div (a.mul u) nAu)
    | exact base.sub (contDiffOn_const.div a nA)
    | exact base.add (u.div (a.mul v) nAv)
