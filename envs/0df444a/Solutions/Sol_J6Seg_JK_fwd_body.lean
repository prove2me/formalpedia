      (encK s (update (fSt P F fs v R T0 (r + 1)) CR [(N : ℤ) - r]))
      ((fs[r].length + 2) * uC Φm Bx Bc) := by
  obtain ⟨hcnt, hsum, hpx, hcd, htmp, hcr, hrp, hrp1⟩ := hF
  have hrv : r < v.length := by omega
  set cs := fs[r] with hcs
  set G0 := update (fSt P F fs v R T0 r) CR [(N : ℤ) - r] with hG0
  have hcl : cs.length ≤ r := hwf r hr
  have hzc : zsz (cs.length : ℤ) ≤ Bc := by
    apply zsz_le_of_lt; simp; omega
  have hzcx : zsz (cs.length : ℤ) ≤ Bx := by omega
  have g0T : G0 dTJ = (cs.length : ℤ) :: (cs ++ flatT (fs.drop (r + 1)) ++ R) := by
    simp +decide [hG0, fSt, update_apply, flatT_drop hr, hcs]
  -- the count
  have s1 := Sp.push (s := s) (f := G0) (i := CNT) (e := .reg dTJ) (B := Bx) (by decide)
