theorem solution (M a Q : ℝ) {x : Pt 4} (hx : x ∈ domReg M a Q) :
    IsLorentzian (metricMatrix (gKN M a Q) x) := by
  have hS := domReg_S hx; have hD := domReg_D hx; have hs := domReg_s hx
  have hSpos : 0 < (x 1 ^ 2 + a ^ 2 * cos (x 2) ^ 2) := lt_of_le_of_ne (by positivity) (Ne.symm hS)
  have hs2 : 0 < sin (x 2) ^ 2 := by positivity
  rcases lt_or_gt_of_ne hD with hneg | hpos
  · -- `Δ < 0`: `∂_r` timelike
    have hDi : Di M a Q (x 1) < 0 := by
      unfold Di; first | exact inv_lt_zero.mpr hneg | exact inv_neg''.mpr hneg
    refine isLorentzian_of_diag (Kerr.frameN a x) _ (frameN_diag M a Q hx) ?_ ?_
    · show (x 1 ^ 2 + a ^ 2 * cos (x 2) ^ 2) * Di M a Q (x 1) < 0
      exact mul_neg_of_pos_of_neg hSpos hDi
    · intro i hi
      fin_cases i
