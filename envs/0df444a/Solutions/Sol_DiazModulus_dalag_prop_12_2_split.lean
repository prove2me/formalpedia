import Mathlib
import Definitions.Def_DiazModulus

open Complex ComplexConjugate

/-! # DALAG Prop. 12.2, splitting off a transcendental direction

Extend `{1}` to a `k`-basis `b` of `k·1 + F` inside `{1} ∪ F`, and let `T = b ∖ {1}`. Then `T ⊆ F` is `k`-free
and `1` is not in its span, so by (ii), applied to every finite subset of `T` listed as `x₁, …, xₙ`, the
family `T` is algebraically independent over `k`. If `T` is empty, then `F ⊆ k·1`, and `F ≠ 0` gives
`1 ∈ F`: take `x = 1` and `F₁ = 0`. Otherwise pick `x ∈ T` and put `F₁ = F ∩ span(b ∖ {x})`. Then `x ∈ F`,
`x ≠ 0` and `x ∉ F₁`, so `F₁ < F`. Every `f ∈ F` is `c·x + z` with `c ∈ k` and `z ∈ span(b ∖ {x})`; since
`z = f − c·x ∈ F`, also `z ∈ F₁`. Finally `x` is transcendental over the `k`-algebra generated by `T ∖ {x}`,
because `T` is algebraically independent; that algebra contains `1` and `T ∖ {x}`, hence `span(b ∖ {x}) ⊇ F₁`,
so `x` is transcendental over `k(F₁)`. -/

open DiazModulus in
theorem solution {k K : Type*} [Field k] [Field K] [Algebra k K] (E : Submodule k K)
    (hii : ∀ (n : ℕ) (x : Fin n → K), (∀ i, x i ∈ E) →
      LinearIndependent k (Fin.cons (1 : K) x : Fin (n + 1) → K) → AlgebraicIndependent k x)
    (F : Submodule k K) [FiniteDimensional k ↥F] (hFE : F ≤ E) (hF : F ≠ ⊥) :
    ∃ (x : K) (F₁ : Submodule k K), x ∈ F ∧ x ≠ 0 ∧ F₁ < F ∧
      (∀ f ∈ F, ∃ c : k, f - x * algebraMap k K c ∈ F₁) ∧
      (F₁ = ⊥ ∨ Transcendental (IntermediateField.adjoin k (F₁ : Set K)) x) := by
  classical
  obtain ⟨b, hbt, h1b, htb, hbli⟩ := exists_linearIndepOn_id_extension (K := k)
    (s := ({1} : Set K)) (t := insert (1 : K) (F : Set K)) (by simp) (by simp)
  have h1b' : (1 : K) ∈ b := h1b rfl
  set T : Set K := b \ {1} with hT
  have hTF : T ⊆ F := fun z hz => (hbt hz.1).resolve_left hz.2
  have hbeq : b = insert 1 T := by simp [hT, Set.insert_eq_of_mem h1b']
  have h1T : (1 : K) ∉ Submodule.span k T := by
    have := hbli
    rw [hbeq, linearIndepOn_insert (by simp [hT])] at this
    simpa using this.2
  -- T is algebraically independent: (ii) on each finite subset
  have hTalg : AlgebraicIndependent k ((↑) : T → K) := by
    refine algebraicIndependent_of_finite T fun t htT htfin => ?_
    have : Finite t := htfin.to_subtype
    let eqv := Finite.equivFin t
    let y : Fin (Nat.card t) → K := fun i => (eqv.symm i : K)
    have hry : Set.range y = t := by
      ext z; constructor
      · rintro ⟨i, rfl⟩; exact (eqv.symm i).2
      · intro hz; exact ⟨eqv ⟨z, hz⟩, by simp only [y, Equiv.symm_apply_apply]⟩
    have hyli : LinearIndependent k y :=
      LinearIndependent.comp (ι' := Fin (Nat.card t)) ((hbli.mono Set.sdiff_subset).mono htT) eqv.symm
        eqv.symm.injective
    have h1y : (1 : K) ∉ Submodule.span k (Set.range y) := fun h =>
      h1T (Submodule.span_mono (by rw [hry]; exact htT) h)
    have hy := hii _ y (fun i => hFE (hTF (htT (hry ▸ Set.mem_range_self i))))
      (linearIndependent_finCons.2 ⟨hyli, h1y⟩)
    convert hy.comp eqv eqv.injective using 1
    funext z; simp only [y, Function.comp_apply, Equiv.symm_apply_apply]
  by_cases hTe : T = ∅
  · -- F ⊆ k·1: x := 1, F₁ := ⊥ (the printed case n = 1)
    have hFsub : ∀ f ∈ F, ∃ c : k, f = algebraMap k K c := by
      intro f hf
      have : f ∈ Submodule.span k b := htb (Set.mem_insert_of_mem _ hf)
      rw [hbeq, hTe, show (insert (1 : K) (∅ : Set K)) = {1} from by simp] at this
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 this
      exact ⟨c, by rw [Algebra.smul_def, mul_one]⟩
    obtain ⟨f₀, hf₀, hf₀0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hF
    obtain ⟨c₀, rfl⟩ := hFsub f₀ hf₀
    have hc₀ : c₀ ≠ 0 := by rintro rfl; simp at hf₀0
    have h1F : (1 : K) ∈ F := by
      have := F.smul_mem c₀⁻¹ hf₀
      rwa [Algebra.smul_def, ← map_mul, inv_mul_cancel₀ hc₀, map_one] at this
    refine ⟨1, ⊥, h1F, one_ne_zero, bot_lt_iff_ne_bot.2 hF, fun f hf => ?_, Or.inl rfl⟩
    obtain ⟨c, rfl⟩ := hFsub f hf
    exact ⟨c, by simp⟩
  obtain ⟨x, hxT⟩ := Set.nonempty_iff_ne_empty.2 hTe
  have hxF : x ∈ F := hTF hxT
  have hbx : b = insert x (b \ {x}) := by rw [Set.insert_sdiff_singleton, Set.insert_eq_of_mem hxT.1]
  have hxnot : x ∉ Submodule.span k (b \ {x}) := by
    have := hbli
    rw [hbx, linearIndepOn_insert (by simp)] at this
    simpa using this.2
  refine ⟨x, F ⊓ Submodule.span k (b \ {x}), hxF, fun h => hxnot (h ▸ Submodule.zero_mem _),
    SetLike.lt_iff_le_and_exists.2 ⟨inf_le_left, x, hxF, fun h => hxnot (Submodule.mem_inf.1 h).2⟩,
    fun f hf => ?_, Or.inr ?_⟩
  · have : f ∈ Submodule.span k (insert x (b \ {x})) := hbx ▸ htb (Set.mem_insert_of_mem _ hf)
    obtain ⟨c, z, hz, rfl⟩ := Submodule.mem_span_insert.1 this
    refine ⟨c, ?_⟩
    have e : c • x + z - x * algebraMap k K c = z := by rw [Algebra.smul_def]; ring
    rw [e]
    refine Submodule.mem_inf.2 ⟨?_, hz⟩
    have := F.sub_mem hf (F.smul_mem c hxF)
    rwa [add_sub_cancel_left] at this
  · -- x is transcendental over k(T ∖ {x}) ⊇ k(F₁)
    have htr := hTalg.transcendental_adjoin (s := {t : T | t ≠ ⟨x, hxT⟩}) (i := ⟨x, hxT⟩) (by simp)
    rw [IntermediateField.transcendental_adjoin_iff]
    refine Transcendental.of_tower_top_of_subalgebra_le ?_ htr
    rw [Algebra.adjoin_le_iff]
    intro z hz
    have hspan : Submodule.span k (b \ {x}) ≤
        Subalgebra.toSubmodule (Algebra.adjoin k (((↑) : T → K) '' {t : T | t ≠ ⟨x, hxT⟩})) := by
      rw [Submodule.span_le]
      intro w hw
      by_cases hw1 : w = 1
      · rw [hw1]; exact Subalgebra.one_mem _
      · refine Algebra.subset_adjoin ⟨⟨w, hw.1, hw1⟩, fun h => hw.2 ?_, rfl⟩
        exact congrArg Subtype.val h
    exact hspan (Submodule.mem_inf.1 hz).2
