variable {E V : Type} [Fintype E] [Fintype V] [DecidableEq V] {r : ℕ} [Fact r.Prime]
  {D : DegeneracyData E V} (H : HeckeData D)
  {A : ValuationSubring (AlgebraicClosure ℚ)} {hA : A.LiesOverPrime r}
  {T : Type} [AddCommGroup T]
  {galT : ↥(A.decompositionSubgroup ℚ) →* AddAut T}
  {actZ : ↥(A.decompositionSubgroup ℚ) →* (↥(ribbonKernel D) ≃ₗ[ℤ] ↥(ribbonKernel D))}
  (𝒰 : EquivariantUniformization r D A hA T ↥(A.decompositionSubgroup ℚ) (MonoidHom.id _) actZ galT)
  {J : Type} [AddCommGroup J] (ιT : J →+ T)
  (hecke : HeckeAlg →+* Module.End ℤ J)
  (gal : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) →* AddAut J)

