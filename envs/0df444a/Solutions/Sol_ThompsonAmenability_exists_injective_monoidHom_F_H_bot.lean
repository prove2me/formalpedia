namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

variable {A : Subring ℝ}

/-- real entries -/
noncomputable abbrev ent (g : Matrix.SpecialLinearGroup (Fin 2) A) (i j : Fin 2) : ℝ :=
  ((g i j : A) : ℝ)

lemma slToGL_apply (g : Matrix.SpecialLinearGroup (Fin 2) A) (i j : Fin 2) :
    (slToGL A g : GL (Fin 2) ℝ) i j = ent g i j := by
  simp [slToGL]

lemma det_ent (g : Matrix.SpecialLinearGroup (Fin 2) A) :
    ent g 0 0 * ent g 1 1 - ent g 0 1 * ent g 1 0 = 1 := by
  have h := g.2
  rw [Matrix.det_fin_two] at h
  have := congrArg (fun x : A => (x : ℝ)) h
  simpa using this

lemma mob_coe (g : Matrix.SpecialLinearGroup (Fin 2) A) (t : ℝ) :
    mob g (t : OnePoint ℝ) = if ent g 1 0 * t + ent g 1 1 = 0 then ∞ else
      (((ent g 0 0 * t + ent g 0 1) / (ent g 1 0 * t + ent g 1 1) : ℝ) : OnePoint ℝ) := by
  unfold mob
  rw [OnePoint.smul_some_eq_ite]
  simp only [slToGL_apply]

lemma mob_infty (g : Matrix.SpecialLinearGroup (Fin 2) A) :
    mob g ∞ = if ent g 1 0 = 0 then ∞ else ((ent g 0 0 / ent g 1 0 : ℝ) : OnePoint ℝ) := by
  unfold mob
  rw [OnePoint.smul_infty_eq_ite]
  simp only [slToGL_apply]

lemma mob_mul (g h : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob (g * h) x = mob g (mob h x) := by
  unfold mob
  rw [map_mul, mul_smul]

lemma mob_one (x : OnePoint ℝ) : mob (1 : Matrix.SpecialLinearGroup (Fin 2) A) x = x := by
  unfold mob
  rw [map_one, one_smul]

lemma mob_inv_mob (g : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob g⁻¹ (mob g x) = x := by
  rw [← mob_mul, inv_mul_cancel, mob_one]

lemma mob_mob_inv (g : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob g (mob g⁻¹ x) = x := by
  rw [← mob_mul, mul_inv_cancel, mob_one]

lemma tendsto_coe_cobounded :
    Tendsto (fun x : ℝ => (x : OnePoint ℝ)) (Bornology.cobounded ℝ) (𝓝 ∞) := by
  rw [Metric.cobounded_eq_cocompact, ← coclosedCompact_eq_cocompact]
  exact tendsto_coe_infty

lemma tendsto_affine_cobounded {c : ℝ} (hc : c ≠ 0) (d : ℝ) :
    Tendsto (fun x : ℝ => c * x + d) (Bornology.cobounded ℝ) (Bornology.cobounded ℝ) := by
  rw [← tendsto_norm_atTop_iff_cobounded]
  have h1 := tendsto_norm_cobounded_atTop (E := ℝ)
  have h2 : Tendsto (fun x : ℝ => |c| * ‖x‖ - |d|) (Bornology.cobounded ℝ) atTop := by
    apply tendsto_atTop_add_const_right
    exact h1.const_mul_atTop (abs_pos.2 hc)
  refine tendsto_atTop_mono (fun x => ?_) h2
  simp only [Real.norm_eq_abs]
  have := abs_sub_abs_le_abs_sub (c * x) (-d)
  rw [abs_mul, abs_neg, sub_neg_eq_add] at this
  linarith

lemma frac_eq (g : Matrix.SpecialLinearGroup (Fin 2) A) {x : ℝ} (hc : ent g 1 0 ≠ 0)
    (hx : ent g 1 0 * x + ent g 1 1 ≠ 0) :
    (ent g 0 0 * x + ent g 0 1) / (ent g 1 0 * x + ent g 1 1) =
      ent g 0 0 / ent g 1 0 - (ent g 1 0 * (ent g 1 0 * x + ent g 1 1))⁻¹ := by
  have := det_ent g
  rw [eq_sub_iff_add_eq, div_eq_mul_inv, mul_inv, ← add_mul, ← div_eq_mul_inv]
  rw [div_eq_div_iff hx hc, add_mul, inv_mul_cancel₀ hc]
  linear_combination (-1 : ℝ) * this

lemma continuous_mob (g : Matrix.SpecialLinearGroup (Fin 2) A) : Continuous (mob g) := by
  have hdet := det_ent g
  rw [OnePoint.continuous_iff]
  constructor
  · rw [coclosedCompact_eq_cocompact, ← Metric.cobounded_eq_cocompact]
    by_cases hc : ent g 1 0 = 0
    · have hd : ent g 1 1 ≠ 0 := by
        intro h; rw [h, hc] at hdet; simp at hdet
      rw [mob_infty, if_pos hc]
      have : (fun x : ℝ => mob g (x : OnePoint ℝ)) =
          fun x : ℝ => (((ent g 0 0 / ent g 1 1) * x + ent g 0 1 / ent g 1 1 : ℝ) : OnePoint ℝ) := by
        funext x
        rw [mob_coe, if_neg (by rw [hc]; simpa using hd)]
        congr 1
        rw [hc, zero_mul, zero_add]; field_simp
      rw [this]
      have ha : ent g 0 0 ≠ 0 := by
        intro h; rw [h, hc] at hdet; simp at hdet
      exact tendsto_coe_cobounded.comp (tendsto_affine_cobounded (div_ne_zero ha hd) _)
    · rw [mob_infty, if_neg hc]
      have hev : ∀ᶠ x : ℝ in Bornology.cobounded ℝ, ent g 1 0 * x + ent g 1 1 ≠ 0 := by
        have := (tendsto_affine_cobounded hc (ent g 1 1)).eventually
          (Bornology.eventually_ne_cobounded (0 : ℝ))
        exact this
      have hlim : Tendsto (fun x : ℝ => ((ent g 0 0 / ent g 1 0 -
          (ent g 1 0 * (ent g 1 0 * x + ent g 1 1))⁻¹ : ℝ) : OnePoint ℝ))
          (Bornology.cobounded ℝ) (𝓝 ((ent g 0 0 / ent g 1 0 : ℝ) : OnePoint ℝ)) := by
        apply (continuous_coe.tendsto _).comp
        have h3 : Tendsto (fun x : ℝ => ent g 1 0 * (ent g 1 0 * x + ent g 1 1))
            (Bornology.cobounded ℝ) (Bornology.cobounded ℝ) := by
          have := tendsto_affine_cobounded (mul_ne_zero hc hc) (ent g 1 0 * ent g 1 1)
          refine this.congr (fun x => ?_)
          ring
        have h4 := (tendsto_inv₀_cobounded.comp h3)
        have := (tendsto_const_nhds (x := ent g 0 0 / ent g 1 0)).sub h4
        simpa using this
      refine hlim.congr' ?_
      filter_upwards [hev] with x hx
      rw [mob_coe, if_neg hx, frac_eq g hc hx]
  · rw [continuous_iff_continuousAt]
    intro t
    by_cases ht : ent g 1 0 * t + ent g 1 1 = 0
    · have hc : ent g 1 0 ≠ 0 := by
        intro h; rw [h, zero_mul, zero_add] at ht; rw [ht, h] at hdet; simp at hdet
      show Tendsto (fun x : ℝ => mob g (x : OnePoint ℝ)) (𝓝 t) (𝓝 (mob g (t : OnePoint ℝ)))
      rw [mob_coe, if_pos ht, ← nhdsNE_sup_pure t, tendsto_sup]
      constructor
      · have h3 : Tendsto (fun x : ℝ => ent g 1 0 * (ent g 1 0 * x + ent g 1 1))
            (𝓝[≠] t) (𝓝[≠] 0) := by
          apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
          · have : Tendsto (fun x : ℝ => ent g 1 0 * (ent g 1 0 * x + ent g 1 1)) (𝓝 t)
                (𝓝 (ent g 1 0 * (ent g 1 0 * t + ent g 1 1))) :=
              ((continuous_const.mul ((continuous_const.mul continuous_id).add
                continuous_const)).tendsto t)
            rw [ht, mul_zero] at this
            exact tendsto_nhdsWithin_of_tendsto_nhds this
          · filter_upwards [self_mem_nhdsWithin] with x hx
            simp only [mem_compl_iff, mem_singleton_iff] at hx ⊢
            intro h0
            rcases mul_eq_zero.1 h0 with h | h
            · exact hc h
            · apply hx
              have : ent g 1 0 * (x - t) = 0 := by linarith
              rcases mul_eq_zero.1 this with h' | h'
              · exact absurd h' hc
              · linarith
        have h4 := tendsto_inv₀_nhdsNE_zero.comp h3
        have h5 := (tendsto_const_add_cobounded (ent g 0 0 / ent g 1 0)).comp
          ((tendsto_neg_cobounded).comp h4)
        refine (tendsto_coe_cobounded.comp h5).congr' ?_
        filter_upwards [self_mem_nhdsWithin] with x hx
        simp only [mem_compl_iff, mem_singleton_iff] at hx
        have hx' : ent g 1 0 * x + ent g 1 1 ≠ 0 := by
          intro h0; apply hx
          have : ent g 1 0 * (x - t) = 0 := by linarith
          rcases mul_eq_zero.1 this with h' | h'
          · exact absurd h' hc
          · linarith
        simp only [Function.comp_apply]
        rw [mob_coe, if_neg hx', frac_eq g hc hx', sub_eq_add_neg]
      · rw [tendsto_pure_left]
        intro s hs
        rw [mob_coe, if_pos ht]
        exact mem_of_mem_nhds hs
    · have hev : ∀ᶠ x : ℝ in 𝓝 t, ent g 1 0 * x + ent g 1 1 ≠ 0 :=
        ((continuous_const.mul continuous_id).add continuous_const).continuousAt.eventually_ne ht
      have hcont : ContinuousAt (fun x : ℝ => (((ent g 0 0 * x + ent g 0 1) /
          (ent g 1 0 * x + ent g 1 1) : ℝ) : OnePoint ℝ)) t := by
        apply continuous_coe.continuousAt.comp
        exact (((continuous_const.mul continuous_id).add continuous_const).continuousAt).div
          (((continuous_const.mul continuous_id).add continuous_const).continuousAt) ht
      refine hcont.congr (Filter.EventuallyEq.symm ?_)
      filter_upwards [hev] with x hx
      rw [mob_coe, if_neg hx]

/-- The Möbius action as a homeomorphism. -/
noncomputable def mobH (g : Matrix.SpecialLinearGroup (Fin 2) A) : OnePoint ℝ ≃ₜ OnePoint ℝ where
  toFun := mob g
  invFun := mob g⁻¹
  left_inv := mob_inv_mob g
  right_inv := mob_mob_inv g
  continuous_toFun := continuous_mob g
  continuous_invFun := continuous_mob g⁻¹

@[simp] lemma mobH_apply (g : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mobH g x = mob g x := rfl

end Monod.Dev.Dyn
end

section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

variable {A : Subring ℝ}

/-! ### Identity theorem for Möbius maps -/

/-! ### One-sided filters -/

/-- the right-hand filter at a point of `P¹` (for `∞`, approach from `-∞`) -/
def RF (x : OnePoint ℝ) : Filter (OnePoint ℝ) :=
  x.elim (map (fun y : ℝ => (y : OnePoint ℝ)) atBot) (fun t => map (fun y : ℝ => (y : OnePoint ℝ)) (𝓝[>] t))

/-- the left-hand filter at a point of `P¹` (for `∞`, approach from `+∞`) -/
def LF (x : OnePoint ℝ) : Filter (OnePoint ℝ) :=
  x.elim (map (fun y : ℝ => (y : OnePoint ℝ)) atTop) (fun t => map (fun y : ℝ => (y : OnePoint ℝ)) (𝓝[<] t))

lemma RF_infty : RF ∞ = map (fun y : ℝ => (y : OnePoint ℝ)) atBot := rfl
lemma RF_coe (t : ℝ) : RF t = map (fun y : ℝ => (y : OnePoint ℝ)) (𝓝[>] t) := rfl
lemma LF_infty : LF ∞ = map (fun y : ℝ => (y : OnePoint ℝ)) atTop := rfl
lemma LF_coe (t : ℝ) : LF t = map (fun y : ℝ => (y : OnePoint ℝ)) (𝓝[<] t) := rfl

instance RF_neBot (x : OnePoint ℝ) : NeBot (RF x) := by
  cases x with
  | infty => rw [RF_infty]; infer_instance
  | coe t => rw [RF_coe]; infer_instance

instance LF_neBot (x : OnePoint ℝ) : NeBot (LF x) := by
  cases x with
  | infty => rw [LF_infty]; infer_instance
  | coe t => rw [LF_coe]; infer_instance

/-! ### Germ property, generically in a filter family -/

section generic

variable {F : OnePoint ℝ → Filter (OnePoint ℝ)} (hle : ∀ x, F x ≤ 𝓝 x) [hne : ∀ x, NeBot (F x)]
  (htend : ∀ (g : Matrix.SpecialLinearGroup (Fin 2) A) x, Tendsto (mob g) (F x) (F (mob g x)))

end generic

/-! ### Constructing elements of `G A` -/

/-- Gluing a Möbius map on `s` with the identity off `s`. -/
theorem glue {q : Matrix.SpecialLinearGroup (Fin 2) A} {s : Set (OnePoint ℝ)}
    (B : Finset (OnePoint ℝ)) (hBP : (B : Set (OnePoint ℝ)) ⊆ P A)
    (hfr : frontier s ⊆ B) (hfix : ∀ b ∈ B, mob q b = b) (hinv : ∀ x, mob q x ∈ s ↔ x ∈ s) :
    ∃ f ∈ G A, (∀ x ∈ s, f x = mob q x) ∧ (∀ x ∉ s, f x = x) := by
  classical
  have hinv' : ∀ x, mob q⁻¹ x ∈ s ↔ x ∈ s := fun x => by
    rw [← hinv (mob q⁻¹ x), mob_mob_inv]
  let F : OnePoint ℝ ≃ₜ OnePoint ℝ :=
    { toFun := s.piecewise (mob q) id
      invFun := s.piecewise (mob q⁻¹) id
      left_inv := fun x => by
        by_cases hx : x ∈ s
        · rw [Set.piecewise_eq_of_mem _ _ _ hx, Set.piecewise_eq_of_mem _ _ _ ((hinv x).2 hx),
            mob_inv_mob]
        · rw [Set.piecewise_eq_of_notMem _ _ _ hx, id, Set.piecewise_eq_of_notMem _ _ _ hx, id]
      right_inv := fun x => by
        by_cases hx : x ∈ s
        · rw [Set.piecewise_eq_of_mem _ _ _ hx, Set.piecewise_eq_of_mem _ _ _ ((hinv' x).2 hx),
            mob_mob_inv]
        · rw [Set.piecewise_eq_of_notMem _ _ _ hx, id, Set.piecewise_eq_of_notMem _ _ _ hx, id]
      continuous_toFun := (continuous_mob q).piecewise
        (fun a ha => by rw [hfix a (hfr ha)]; rfl) continuous_id
      continuous_invFun := (continuous_mob q⁻¹).piecewise
        (fun a ha => by
          show mob q⁻¹ a = a
          conv_lhs => rw [← hfix a (hfr ha)]
          exact mob_inv_mob q a) continuous_id }
  have hF1 : ∀ x ∈ s, F x = mob q x := fun x hx => Set.piecewise_eq_of_mem _ _ _ hx
  have hF2 : ∀ x ∉ s, F x = x := fun x hx => Set.piecewise_eq_of_notMem _ _ _ hx
  refine ⟨F, Monod.Dev.GMono.mem_G_of_isPiecewiseProj ⟨B, hBP, fun x hx => ?_⟩, hF1, hF2⟩
  have hxf : x ∉ frontier s := fun h => hx (hfr h)
  by_cases hxs : x ∈ closure s
  · have hint : x ∈ interior s := by
      by_contra h; exact hxf ⟨hxs, h⟩
    exact ⟨q, Filter.mem_of_superset (isOpen_interior.mem_nhds hint)
      (fun y hy => hF1 y (interior_subset hy))⟩
  · have : (closure s)ᶜ ∈ 𝓝 x := isClosed_closure.isOpen_compl.mem_nhds hxs
    exact ⟨1, Filter.mem_of_superset this (fun y hy => by
      show F y = mob 1 y
      rw [hF2 y (fun h => hy (subset_closure h)), mob_one])⟩

end Monod.Dev.Dyn
end

section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

variable {A : Subring ℝ}

/-- the fixed-point quadratic of `g` -/
noncomputable def Qf (g : Matrix.SpecialLinearGroup (Fin 2) A) (t : ℝ) : ℝ :=
  ent g 1 0 * t ^ 2 + (ent g 1 1 - ent g 0 0) * t - ent g 0 1

lemma trace_ent (g : Matrix.SpecialLinearGroup (Fin 2) A) :
    ((Matrix.trace (g : Matrix (Fin 2) (Fin 2) A) : A) : ℝ) = ent g 0 0 + ent g 1 1 := by
  rw [Matrix.trace_fin_two]; push_cast; rfl

lemma Qf_mob (g : Matrix.SpecialLinearGroup (Fin 2) A) {t : ℝ}
    (ht : ent g 1 0 * t + ent g 1 1 ≠ 0) :
    Qf g ((ent g 0 0 * t + ent g 0 1) / (ent g 1 0 * t + ent g 1 1)) =
      Qf g t / (ent g 1 0 * t + ent g 1 1) ^ 2 := by
  have hdet := det_ent g
  unfold Qf
  rw [eq_div_iff (pow_ne_zero 2 ht)]
  field_simp
  linear_combination (ent g 1 0 * t ^ 2 + (ent g 1 1 - ent g 0 0) * t - ent g 0 1) * hdet

lemma Qf_pole (g : Matrix.SpecialLinearGroup (Fin 2) A) (hc : ent g 1 0 ≠ 0) {t : ℝ}
    (ht : ent g 1 0 * t + ent g 1 1 = 0) : Qf g t = 1 / ent g 1 0 := by
  have hdet := det_ent g
  have htt : t = -ent g 1 1 / ent g 1 0 := by field_simp; linarith
  unfold Qf
  rw [htt]
  field_simp
  linear_combination hdet

lemma Qf_inf (g : Matrix.SpecialLinearGroup (Fin 2) A) (hc : ent g 1 0 ≠ 0) :
    Qf g (ent g 0 0 / ent g 1 0) = 1 / ent g 1 0 := by
  have hdet := det_ent g
  unfold Qf
  field_simp
  linear_combination hdet

lemma mob_eq_self_of_Qf (g : Matrix.SpecialLinearGroup (Fin 2) A) (hc : ent g 1 0 ≠ 0) {t : ℝ}
    (hQ : Qf g t = 0) : mob g (t : OnePoint ℝ) = t := by
  have ht : ent g 1 0 * t + ent g 1 1 ≠ 0 := by
    intro h; rw [Qf_pole g hc h] at hQ; simp [hc] at hQ
  rw [mob_coe, if_neg ht, coe_eq_coe, div_eq_iff ht]
  unfold Qf at hQ
  linear_combination (-1 : ℝ) * hQ

section hyp

variable (g : Matrix.SpecialLinearGroup (Fin 2) A) (hyp : IsHyperbolic g) (hc : 0 < ent g 1 0)

lemma disc_pos (hyp : IsHyperbolic g) : 0 < (ent g 0 0 + ent g 1 1) ^ 2 - 4 := by
  unfold IsHyperbolic at hyp
  rw [trace_ent] at hyp
  have : (2:ℝ) ^ 2 < (ent g 0 0 + ent g 1 1) ^ 2 := by
    rw [← sq_abs (ent g 0 0 + ent g 1 1)]
    exact pow_lt_pow_left₀ hyp (by norm_num) (by norm_num)
  linarith

/-- the smaller fixed point -/
noncomputable def xi1 : ℝ :=
  ((ent g 0 0 - ent g 1 1) - Real.sqrt ((ent g 0 0 + ent g 1 1) ^ 2 - 4)) / (2 * ent g 1 0)

/-- the larger fixed point -/
noncomputable def xi2 : ℝ :=
  ((ent g 0 0 - ent g 1 1) + Real.sqrt ((ent g 0 0 + ent g 1 1) ^ 2 - 4)) / (2 * ent g 1 0)

include hyp hc in
lemma xi1_lt_xi2 : xi1 g < xi2 g := by
  unfold xi1 xi2
  have := Real.sqrt_pos.2 (disc_pos g hyp)
  apply div_lt_div_of_pos_right _ (by linarith)
  linarith

include hyp in
lemma Qf_eq (hc : ent g 1 0 ≠ 0) (t : ℝ) : Qf g t = ent g 1 0 * (t - xi1 g) * (t - xi2 g) := by
  have hdet := det_ent g
  have hs := Real.sq_sqrt (le_of_lt (disc_pos g hyp))
  unfold Qf xi1 xi2
  field_simp
  linear_combination hs + 4 * hdet

include hyp hc in
lemma Qf_neg_iff (t : ℝ) : Qf g t < 0 ↔ t ∈ Ioo (xi1 g) (xi2 g) := by
  rw [Qf_eq g hyp hc.ne', mem_Ioo, mul_assoc, mul_neg_iff]
  have h12 := xi1_lt_xi2 g hyp hc
  constructor
  · rintro (⟨-, h⟩ | ⟨h, -⟩)
    · rcases mul_neg_iff.1 h with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · constructor <;> linarith
      · constructor <;> linarith
    · linarith
  · rintro ⟨h1, h2⟩
    left
    exact ⟨hc, mul_neg_of_pos_of_neg (by linarith) (by linarith)⟩

include hyp hc in
lemma Qf_xi1 : Qf g (xi1 g) = 0 := by rw [Qf_eq g hyp hc.ne']; ring

include hyp hc in
lemma Qf_xi2 : Qf g (xi2 g) = 0 := by rw [Qf_eq g hyp hc.ne']; ring

include hyp hc in
lemma xi_mem_P : ((xi1 g : ℝ) : OnePoint ℝ) ∈ P A ∧ ((xi2 g : ℝ) : OnePoint ℝ) ∈ P A :=
  ⟨⟨g, hyp, mob_eq_self_of_Qf g hc.ne' (Qf_xi1 g hyp hc)⟩,
    ⟨g, hyp, mob_eq_self_of_Qf g hc.ne' (Qf_xi2 g hyp hc)⟩⟩

lemma mem_image_coe_iff {S : Set ℝ} (t : ℝ) :
    ((t : OnePoint ℝ) ∈ (fun y : ℝ => (y : OnePoint ℝ)) '' S) ↔ t ∈ S :=
  coe_injective.mem_set_image

lemma infty_notMem_image {S : Set ℝ} : (∞ : OnePoint ℝ) ∉ (fun y : ℝ => (y : OnePoint ℝ)) '' S :=
  infty_notMem_image_coe

/-- sign of `Qf` is `g`-invariant, in the form needed for gluing -/
lemma Qf_sign_invariant (hc : 0 < ent g 1 0) (Pr : ℝ → Prop) (hP : ∀ r s : ℝ, 0 < s → (Pr (r / s) ↔ Pr r))
    (hPc : ¬ Pr (1 / ent g 1 0)) (x : OnePoint ℝ) :
    (mob g x ∈ (fun y : ℝ => (y : OnePoint ℝ)) '' {t | Pr (Qf g t)} ↔
      x ∈ (fun y : ℝ => (y : OnePoint ℝ)) '' {t | Pr (Qf g t)}) := by
  cases x with
  | infty =>
    rw [mob_infty, if_neg hc.ne', mem_image_coe_iff]
    simp only [mem_setOf_eq, Qf_inf g hc.ne', hPc, false_iff]
    exact infty_notMem_image
  | coe t =>
    rw [mem_image_coe_iff, mob_coe]
    split_ifs with ht
    · simp only [mem_setOf_eq, Qf_pole g hc.ne' ht, hPc, iff_false]
      exact infty_notMem_image
    · rw [mem_image_coe_iff]
      simp only [mem_setOf_eq]
      rw [Qf_mob g ht]
      exact hP _ _ (by positivity)

include hyp hc in
/-- glue `g` on the open interval between its fixed points, identity elsewhere -/
theorem glue_in : ∃ f ∈ G A, (∀ t : ℝ, Qf g t < 0 → f t = mob g t) ∧
    (∀ t : ℝ, 0 ≤ Qf g t → f t = t) ∧ f ∞ = ∞ := by
  classical
  set s := (fun y : ℝ => (y : OnePoint ℝ)) '' {t | Qf g t < 0} with hs
  have hsI : s = (fun y : ℝ => (y : OnePoint ℝ)) '' Ioo (xi1 g) (xi2 g) := by
    rw [hs]; congr 1; ext t; exact Qf_neg_iff g hyp hc t
  have hfr : frontier s ⊆ (({(xi1 g : OnePoint ℝ), (xi2 g : OnePoint ℝ)} : Finset (OnePoint ℝ)) :
      Set (OnePoint ℝ)) := by
    intro x hx
    rw [frontier, hsI] at hx
    have hopen : IsOpen ((fun y : ℝ => (y : OnePoint ℝ)) '' Ioo (xi1 g) (xi2 g)) :=
      isOpen_image_coe.2 isOpen_Ioo
    have hclosed : IsClosed ((fun y : ℝ => (y : OnePoint ℝ)) '' Icc (xi1 g) (xi2 g)) :=
      (isCompact_Icc.image continuous_coe).isClosed
    rw [hopen.interior_eq] at hx
    have h1 := closure_minimal (image_mono Ioo_subset_Icc_self) hclosed hx.1
    obtain ⟨t, ht, rfl⟩ := h1
    have h2 : t ∉ Ioo (xi1 g) (xi2 g) := fun h => hx.2 ⟨t, h, rfl⟩
    simp only [Finset.coe_insert, Finset.coe_singleton, mem_insert_iff, mem_singleton_iff,
      coe_eq_coe]
    rw [mem_Icc] at ht; rw [mem_Ioo] at h2
    by_contra hn; push_neg at hn
    exact h2 ⟨lt_of_le_of_ne ht.1 (Ne.symm hn.1), lt_of_le_of_ne ht.2 hn.2⟩
  have hBP : ((({(xi1 g : OnePoint ℝ), (xi2 g : OnePoint ℝ)} : Finset (OnePoint ℝ))) :
      Set (OnePoint ℝ)) ⊆ P A := by
    intro x hx
    simp only [Finset.coe_insert, Finset.coe_singleton, mem_insert_iff, mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact (xi_mem_P g hyp hc).1
    · exact (xi_mem_P g hyp hc).2
  have hfix : ∀ b ∈ ({(xi1 g : OnePoint ℝ), (xi2 g : OnePoint ℝ)} : Finset (OnePoint ℝ)),
      mob g b = b := by
    intro b hb
    simp only [Finset.mem_insert, Finset.mem_singleton] at hb
    rcases hb with rfl | rfl
    · exact mob_eq_self_of_Qf g hc.ne' (Qf_xi1 g hyp hc)
    · exact mob_eq_self_of_Qf g hc.ne' (Qf_xi2 g hyp hc)
  have hP : ∀ r s : ℝ, 0 < s → (r / s < 0 ↔ r < 0) := fun r s hs =>
    ⟨fun h => by
      by_contra h'
      have := div_nonneg (not_lt.1 h') hs.le
      linarith,
     fun h => div_neg_of_neg_of_pos h hs⟩
  have hinv : ∀ x, mob g x ∈ s ↔ x ∈ s := Qf_sign_invariant g hc (fun r => r < 0) hP
    (not_lt.2 (by positivity))
  obtain ⟨f, hfG, hf1, hf2⟩ := glue _ hBP hfr hfix hinv
  refine ⟨f, hfG, fun t ht => hf1 _ ⟨t, ht, rfl⟩, fun t ht => hf2 _ ?_, hf2 _ infty_notMem_image⟩
  rw [mem_image_coe_iff]; simp only [mem_setOf_eq, not_lt]; exact ht

end hyp

end Monod.Dev.Dyn
end

section
/-!
# Real Möbius maps from `SL(2, ℤ)`, and maps that are locally Möbius off finitely many rationals
-/

namespace Monod.Dev.Thur

open OnePoint Filter Topology Set

abbrev SL2Z := Matrix.SpecialLinearGroup (Fin 2) ℤ

/-- `SL(2, ℤ) → SL(2, ⊥)`, with `⊥` the subring `ℤ` of `ℝ`. -/
noncomputable def ι : SL2Z →* Matrix.SpecialLinearGroup (Fin 2) (⊥ : Subring ℝ) :=
  Matrix.SpecialLinearGroup.map (Int.castRingHom _)

/-- Numerator, denominator and value of the real Möbius map of `M`. -/
def nR (M : SL2Z) (x : ℝ) : ℝ := (M.1 0 0 : ℝ) * x + M.1 0 1
def dR (M : SL2Z) (x : ℝ) : ℝ := (M.1 1 0 : ℝ) * x + M.1 1 1
noncomputable def mR (M : SL2Z) (x : ℝ) : ℝ := nR M x / dR M x

lemma detZ (M : SL2Z) : M.1 0 0 * M.1 1 1 - M.1 0 1 * M.1 1 0 = 1 := by
  have := M.2; rwa [Matrix.det_fin_two] at this

lemma detR (M : SL2Z) : (M.1 0 0 : ℝ) * M.1 1 1 - (M.1 0 1 : ℝ) * M.1 1 0 = 1 := by
  exact_mod_cast detZ M

lemma mul_entry (M N : SL2Z) (i j : Fin 2) :
    (M * N).1 i j = M.1 i 0 * N.1 0 j + M.1 i 1 * N.1 1 j := by
  simp [Matrix.mul_apply, Fin.sum_univ_two]

lemma nR_mul (M N : SL2Z) (x : ℝ) :
    nR (M * N) x = (M.1 0 0 : ℝ) * nR N x + M.1 0 1 * dR N x := by
  simp only [nR, dR, mul_entry]; push_cast; ring

lemma dR_mul (M N : SL2Z) (x : ℝ) :
    dR (M * N) x = (M.1 1 0 : ℝ) * nR N x + M.1 1 1 * dR N x := by
  simp only [nR, dR, mul_entry]; push_cast; ring

lemma dR_mul' (M N : SL2Z) {x : ℝ} (h : dR N x ≠ 0) :
    dR (M * N) x = dR M (mR N x) * dR N x := by
  rw [dR_mul, mR]
  simp only [dR] at h ⊢
  field_simp

lemma mR_mul (M N : SL2Z) {x : ℝ} (h : dR N x ≠ 0) : mR (M * N) x = mR M (mR N x) := by
  rw [mR, nR_mul, dR_mul]
  show _ = nR M (nR N x / dR N x) / dR M (nR N x / dR N x)
  generalize nR N x = n
  generalize dR N x = d at h ⊢
  simp only [nR, dR]
  have e1 : (M.1 0 0 : ℝ) * (n / d) + M.1 0 1 = ((M.1 0 0 : ℝ) * n + M.1 0 1 * d) / d := by
    field_simp
  have e2 : (M.1 1 0 : ℝ) * (n / d) + M.1 1 1 = ((M.1 1 0 : ℝ) * n + M.1 1 1 * d) / d := by
    field_simp
  rw [e1, e2, div_div_div_cancel_right₀ h]

lemma continuous_dR (M : SL2Z) : Continuous (dR M) := by
  unfold dR; fun_prop

lemma eventually_dR_ne (M : SL2Z) {x : ℝ} (h : dR M x ≠ 0) : ∀ᶠ y in 𝓝 x, dR M y ≠ 0 :=
  (continuous_dR M).continuousAt.eventually_ne h

/-- The value at a rational point of `mR M` is rational only at rational points. -/
lemma rat_of_mR (M : SL2Z) {x : ℝ} (hx : dR M x ≠ 0) {q : ℚ} (hq : mR M x = q) :
    ∃ q' : ℚ, x = q' := by
  have hdet := detR M
  have e : (M.1 0 0 : ℝ) * x + M.1 0 1 = q * ((M.1 1 0 : ℝ) * x + M.1 1 1) := by
    have := hq
    rw [mR, div_eq_iff hx] at this
    simpa only [nR, dR] using this
  have hne : (M.1 0 0 : ℝ) - q * M.1 1 0 ≠ 0 := by
    intro h0
    have : ((M.1 0 0 : ℝ) - q * M.1 1 0) * ((M.1 1 0 : ℝ) * x + M.1 1 1) = 1 := by
      linear_combination hdet + (M.1 1 0 : ℝ) * e
    rw [h0, zero_mul] at this; exact zero_ne_one this
  refine ⟨((q * M.1 1 1 - M.1 0 1) / (M.1 0 0 - q * M.1 1 0) : ℚ), ?_⟩
  push_cast
  field_simp
  linear_combination e

/-! ### Two Möbius maps agreeing near a point -/

/-- `N = ± M`. -/
def PM (M N : SL2Z) : Prop := ∃ s : ℤ, (s = 1 ∨ s = -1) ∧ ∀ i j, N.1 i j = s * M.1 i j

lemma PM.symm {M N : SL2Z} (h : PM M N) : PM N M := by
  obtain ⟨s, hs, h⟩ := h
  refine ⟨s, hs, fun i j => ?_⟩
  rw [h]; rcases hs with rfl | rfl <;> ring

/-! ### Locally Möbius maps -/

/-- `f` is **locally Möbius** on `U` off finitely many rationals: near every other point of `U`
it agrees with the Möbius map of an element of `SL(2, ℤ)` that is finite there. -/
def LM (U : Set ℝ) (f : ℝ → ℝ) : Prop :=
  ∃ R : Set ℝ, R.Finite ∧ (∀ r ∈ R, ∃ q : ℚ, r = q) ∧
    ∀ x ∈ U, x ∉ R → ∃ M : SL2Z, dR M x ≠ 0 ∧ ∀ᶠ y in 𝓝 x, f y = mR M y

lemma LM.mono {U V : Set ℝ} {f : ℝ → ℝ} (h : LM V f) (hUV : U ⊆ V) : LM U f := by
  obtain ⟨R, h1, h2, h3⟩ := h
  exact ⟨R, h1, h2, fun x hx => h3 x (hUV hx)⟩

lemma LM.congr {U : Set ℝ} {f g : ℝ → ℝ} (hU : IsOpen U) (h : LM U f) (he : EqOn f g U) :
    LM U g := by
  obtain ⟨R, h1, h2, h3⟩ := h
  refine ⟨R, h1, h2, fun x hx hxR => ?_⟩
  obtain ⟨M, hM, hev⟩ := h3 x hx hxR
  refine ⟨M, hM, ?_⟩
  filter_upwards [hev, hU.mem_nhds hx] with y hy hyU
  rw [← he hyU, hy]

lemma LM.comp {U V : Set ℝ} {f g : ℝ → ℝ} (hU : IsOpen U) (hf : LM U f) (hg : LM V g)
    (hc : ContinuousOn f U) (hmaps : MapsTo f U V) (hinj : InjOn f U) : LM U (g ∘ f) := by
  obtain ⟨Rf, hRf, hRfq, hf⟩ := hf
  obtain ⟨Rg, hRg, hRgq, hg⟩ := hg
  refine ⟨Rf ∪ (U ∩ f ⁻¹' Rg), hRf.union ?_, ?_, ?_⟩
  · refine Set.Finite.of_finite_image (hRg.subset ?_) (hinj.mono inter_subset_left)
    rintro _ ⟨y, hy, rfl⟩; exact hy.2
  · rintro r (hr | ⟨hrU, hrg⟩)
    · exact hRfq r hr
    · by_cases hr' : r ∈ Rf
      · exact hRfq r hr'
      · obtain ⟨M, hM, hev⟩ := hf r hrU hr'
        obtain ⟨q, hq⟩ := hRgq _ hrg
        exact rat_of_mR M hM (hev.self_of_nhds ▸ hq)
  · intro x hx hxR
    simp only [mem_union, mem_inter_iff, mem_preimage, not_or, not_and] at hxR
    obtain ⟨M, hM, hev⟩ := hf x hx hxR.1
    obtain ⟨N, hN, hevg⟩ := hg (f x) (hmaps hx) (hxR.2 hx)
    have hfx : f x = mR M x := hev.self_of_nhds
    have hcont : ContinuousAt f x := hc.continuousAt (hU.mem_nhds hx)
    have hevg' : ∀ᶠ y in 𝓝 x, g (f y) = mR N (f y) := hcont.eventually hevg
    refine ⟨N * M, ?_, ?_⟩
    · rw [dR_mul' N M hM, ← hfx]; exact mul_ne_zero hN hM
    · filter_upwards [hev, hevg', eventually_dR_ne M hM] with y h1 h2 h3
      rw [Function.comp_apply, h2, h1, mR_mul N M h3]

/-! ### The identity theorem on a preconnected open set -/

end Monod.Dev.Thur
end

section
/-!
# Thompson's group `F` embeds in `H(ℤ)`

Two elements of `H(ℤ) = Monod.H ⊥`:

* `a`: the Möbius map of `g = [[-2, 3], [1, -2]]` (`x ↦ (2x - 3)/(2 - x)`, fixed points `±√3`)
  on `(-√3, √3)`, the identity elsewhere; it pushes points of `(-√3, √3)` to the left;
* `c`: the Möbius map of `h = [[3, 2], [1, 1]]` (`x ↦ (3x + 2)/(x + 1)`, fixed points `1 ± √3`)
  on `(1 - √3, 1 + √3)`, the identity elsewhere; it pushes points to the right.

Both are bumps with breakpoints the fixed points of a hyperbolic element of `SL(2, ℤ)`
(`Monod.Dev.Dyn.glue_in`). Put `b = c⁻¹ a⁻¹ c a`. Then `a b⁻¹ = c⁻¹ a c` fixes `[0, ∞]`
pointwise, while `a⁻¹ b a` and `a⁻² b a²` fix `(-∞, 0]` pointwise, so both relators of
`F₁ = ⟨A, B : [AB⁻¹, A⁻¹BA], [AB⁻¹, A⁻²BA²]⟩` hold for `A ↦ a`, `B ↦ b`; and `a b ≠ b a`
(evaluate at `0`). Since every proper quotient of `F` is abelian, the induced map
`F ≅ F₁ → H(ℤ)` is injective.

The facts used about `a` and `c` are only the real inequalities
`a (-∞, 0] ⊆ (-∞, -3/2]`, `a = id` on `[2, ∞)`, `c = id` on `(-∞, -3/2]`,
`c [0, ∞) ⊆ [2, ∞)`, `c 0 = 2 ≠ 0`, and `a ∞ = c ∞ = ∞`.
-/

namespace ThompsonAmenability.Dev.Stankov

open OnePoint Monod Monod.Dev.Dyn

/-- Homeomorphisms of the projective line. -/
abbrev Homeo := OnePoint ℝ ≃ₜ OnePoint ℝ

lemma infty_or_coe (z : OnePoint ℝ) : z = ∞ ∨ ∃ y : ℝ, z = y := by
  induction z using OnePoint.rec with
  | infty => exact Or.inl rfl
  | coe y => exact Or.inr ⟨y, rfl⟩

lemma symm_eq_of_eq {f : Homeo} {z : OnePoint ℝ} (h : f z = z) : f.symm z = z := by
  rw [f.symm_apply_eq]; exact h.symm

/-! ### Disjoint supports commute -/

/-- Two homeomorphisms of `P¹` fixing `∞`, the first fixing `[0, ∞)` pointwise and the second
fixing `(-∞, 0]` pointwise, commute. -/
lemma commute_of_fix {f g : Homeo} (hf : ∀ y : ℝ, 0 ≤ y → f y = y) (hfi : f ∞ = ∞)
    (hg : ∀ y : ℝ, y ≤ 0 → g y = y) (hgi : g ∞ = ∞) : f * g = g * f := by
  ext z
  simp only [Homeomorph.mul_apply]
  rcases infty_or_coe z with rfl | ⟨y, rfl⟩
  · rw [hgi, hfi, hgi]
  · rcases le_or_gt 0 y with hy | hy
    · rw [hf y hy]
      rcases infty_or_coe (g y) with h | ⟨y', h⟩
      · exact absurd (g.injective (h.trans hgi.symm)) (coe_ne_infty y)
      · rw [h]
        rcases le_or_gt 0 y' with hy' | hy'
        · exact hf y' hy'
        · have h2 := coe_injective (g.injective ((hg y' hy'.le).trans h.symm))
          linarith
    · rw [hg y hy.le]
      rcases infty_or_coe (f y) with h | ⟨y', h⟩
      · exact absurd (f.injective (h.trans hfi.symm)) (coe_ne_infty y)
      · rw [h]
        rcases le_or_gt y' 0 with hy' | hy'
        · exact (hg y' hy').symm
        · have h2 := coe_injective (f.injective ((hf y' hy'.le).trans h.symm))
          linarith

/-! ### The relations, from the dynamics of `a` and `c` -/

/-- The relations of `F₁` and non-commutation for `a` and `b = c⁻¹ a⁻¹ c a`, from the dynamics
of `a` and `c` alone. -/
theorem relations {a c : Homeo} {η q : ℝ} (hη : η ≤ 0)
    (ha1 : ∀ y : ℝ, y ≤ 0 → ∃ w : ℝ, w ≤ η ∧ a y = w) (ha2 : ∀ y : ℝ, q ≤ y → a y = y)
    (hai : a ∞ = ∞)
    (hc1 : ∀ y : ℝ, y ≤ η → c y = y) (hc2 : ∀ y : ℝ, 0 ≤ y → ∃ w : ℝ, q ≤ w ∧ c y = w)
    (hci : c ∞ = ∞) (hc0 : c ((0 : ℝ) : OnePoint ℝ) ≠ ((0 : ℝ) : OnePoint ℝ))
    (b : Homeo) (hb : b = c⁻¹ * a⁻¹ * c * a) :
    (a * b⁻¹) * (a⁻¹ * b * a) = (a⁻¹ * b * a) * (a * b⁻¹) ∧
    (a * b⁻¹) * (a⁻¹ ^ 2 * b * a ^ 2) = (a⁻¹ ^ 2 * b * a ^ 2) * (a * b⁻¹) ∧
    a * b ≠ b * a := by
  have hbη : ∀ w : ℝ, w ≤ η → b w = w := by
    intro w hw
    obtain ⟨w', hw', haw⟩ := ha1 w (hw.trans hη)
    rw [hb]
    simp only [Homeomorph.mul_apply, Homeomorph.inv_apply]
    rw [haw, hc1 w' hw', ← haw, a.symm_apply_apply, symm_eq_of_eq (hc1 w hw)]
  have hbi : b ∞ = ∞ := by
    rw [hb]
    simp only [Homeomorph.mul_apply, Homeomorph.inv_apply]
    rw [hai, hci, symm_eq_of_eq hai, symm_eq_of_eq hci]
  have hd : a * b⁻¹ = c⁻¹ * a * c := by rw [hb]; group
  have he2 : a⁻¹ ^ 2 * b * a ^ 2 = a⁻¹ * (a⁻¹ * b * a) * a := by simp only [pow_two, mul_assoc]
  have hdfix : ∀ y : ℝ, 0 ≤ y → (c⁻¹ * a * c) y = y := by
    intro y hy
    obtain ⟨w, hw, hcw⟩ := hc2 y hy
    simp only [Homeomorph.mul_apply, Homeomorph.inv_apply]
    rw [hcw, ha2 w hw, ← hcw, c.symm_apply_apply]
  have hdi : (c⁻¹ * a * c) ∞ = ∞ := by
    simp only [Homeomorph.mul_apply, Homeomorph.inv_apply]
    rw [hci, hai, symm_eq_of_eq hci]
  have he1fix : ∀ y : ℝ, y ≤ 0 → (a⁻¹ * b * a) y = y := by
    intro y hy
    obtain ⟨w, hw, haw⟩ := ha1 y hy
    simp only [Homeomorph.mul_apply, Homeomorph.inv_apply]
    rw [haw, hbη w hw, ← haw, a.symm_apply_apply]
  have he1i : (a⁻¹ * b * a) ∞ = ∞ := by
    simp only [Homeomorph.mul_apply, Homeomorph.inv_apply]
    rw [hai, hbi, symm_eq_of_eq hai]
  have he2fix : ∀ y : ℝ, y ≤ 0 → (a⁻¹ * (a⁻¹ * b * a) * a) y = y := by
    intro y hy
    obtain ⟨w, hw, haw⟩ := ha1 y hy
    rw [Homeomorph.mul_apply, Homeomorph.mul_apply, haw, he1fix w (hw.trans hη), ← haw,
      Homeomorph.inv_apply, a.symm_apply_apply]
  have he2i : (a⁻¹ * (a⁻¹ * b * a) * a) ∞ = ∞ := by
    rw [Homeomorph.mul_apply, Homeomorph.mul_apply, hai, he1i, Homeomorph.inv_apply,
      symm_eq_of_eq hai]
  refine ⟨?_, ?_, ?_⟩
  · rw [hd]; exact commute_of_fix hdfix hdi he1fix he1i
  · rw [hd, he2]; exact commute_of_fix hdfix hdi he2fix he2i
  · intro hab
    have h0 := DFunLike.congr_fun hab ((0 : ℝ) : OnePoint ℝ)
    simp only [Homeomorph.mul_apply] at h0
    obtain ⟨w, hw, haw⟩ := ha1 0 le_rfl
    have hb0 : b ((0 : ℝ) : OnePoint ℝ) = c.symm ((0 : ℝ) : OnePoint ℝ) := by
      rw [hb]
      simp only [Homeomorph.mul_apply, Homeomorph.inv_apply]
      rw [haw, hc1 w hw, ← haw, a.symm_apply_apply]
    rw [hb0, haw, hbη w hw, ← haw] at h0
    have h1 := a.injective h0
    apply hc0
    have h2 := c.apply_symm_apply ((0 : ℝ) : OnePoint ℝ)
    rwa [h1] at h2

/-! ### The two bumps -/

/-- `[[-2, 3], [1, -2]]`: `x ↦ (2x - 3)/(2 - x)`, fixed points `±√3`. -/
def gZ : Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  ⟨!![-2, 3; 1, -2], by rw [Matrix.det_fin_two_of]; norm_num⟩

/-- `[[3, 2], [1, 1]]`: `x ↦ (3x + 2)/(x + 1)`, fixed points `1 ± √3`. -/
def hZ : Matrix.SpecialLinearGroup (Fin 2) ℤ :=
  ⟨!![3, 2; 1, 1], by rw [Matrix.det_fin_two_of]; norm_num⟩

lemma ent_ι (M : Matrix.SpecialLinearGroup (Fin 2) ℤ) (i j : Fin 2) :
    ent (Monod.Dev.Thur.ι M) i j = (M i j : ℝ) := by
  simp [ent, Monod.Dev.Thur.ι]

/-- The bump `a ∈ H(ℤ)`. -/
theorem exists_a : ∃ a ∈ H ⊥,
    (∀ y : ℝ, y ≤ 0 → ∃ w : ℝ, w ≤ -3/2 ∧ a y = w) ∧ (∀ y : ℝ, 2 ≤ y → a y = y) ∧ a ∞ = ∞ := by
  set g := Monod.Dev.Thur.ι gZ with hg
  have e00 : ent g 0 0 = -2 := by rw [hg, ent_ι]; simp [gZ]
  have e01 : ent g 0 1 = 3 := by rw [hg, ent_ι]; simp [gZ]
  have e10 : ent g 1 0 = 1 := by rw [hg, ent_ι]; simp [gZ]
  have e11 : ent g 1 1 = -2 := by rw [hg, ent_ι]; simp [gZ]
  have hyp : IsHyperbolic g := by
    unfold IsHyperbolic; rw [trace_ent, e00, e11]; norm_num
  have hc : 0 < ent g 1 0 := by rw [e10]; norm_num
  obtain ⟨f, hfG, hf1, hf2, hfi⟩ := glue_in g hyp hc
  have hQ : ∀ t : ℝ, Qf g t = t ^ 2 - 3 := by
    intro t; simp only [Qf, e00, e01, e10, e11]; ring
  refine ⟨f, Subgroup.mem_inf.2 ⟨hfG, hfi⟩, ?_, ?_, hfi⟩
  · intro y hy
    by_cases hq : y ^ 2 - 3 < 0
    · have hden : ent g 1 0 * y + ent g 1 1 ≠ 0 := by rw [e10, e11]; linarith
      rw [hf1 y (by rw [hQ]; exact hq), mob_coe, if_neg hden]
      refine ⟨_, ?_, rfl⟩
      rw [e00, e01, e10, e11, div_le_iff_of_neg (by linarith)]
      nlinarith
    · replace hq := not_lt.1 hq
      exact ⟨y, by nlinarith, hf2 y (by rw [hQ]; exact hq)⟩
  · intro y hy
    exact hf2 y (by rw [hQ]; nlinarith)

/-- The bump `c ∈ H(ℤ)`. -/
theorem exists_c : ∃ c ∈ H ⊥,
    (∀ y : ℝ, y ≤ -3/2 → c y = y) ∧ (∀ y : ℝ, 0 ≤ y → ∃ w : ℝ, 2 ≤ w ∧ c y = w) ∧
      c ∞ = ∞ ∧ c ((0 : ℝ) : OnePoint ℝ) ≠ ((0 : ℝ) : OnePoint ℝ) := by
  set g := Monod.Dev.Thur.ι hZ with hg
  have e00 : ent g 0 0 = 3 := by rw [hg, ent_ι]; simp [hZ]
  have e01 : ent g 0 1 = 2 := by rw [hg, ent_ι]; simp [hZ]
  have e10 : ent g 1 0 = 1 := by rw [hg, ent_ι]; simp [hZ]
  have e11 : ent g 1 1 = 1 := by rw [hg, ent_ι]; simp [hZ]
  have hyp : IsHyperbolic g := by
    unfold IsHyperbolic; rw [trace_ent, e00, e11]; norm_num
  have hc : 0 < ent g 1 0 := by rw [e10]; norm_num
  obtain ⟨f, hfG, hf1, hf2, hfi⟩ := glue_in g hyp hc
  have hQ : ∀ t : ℝ, Qf g t = t ^ 2 - 2 * t - 2 := by
    intro t; simp only [Qf, e00, e01, e10, e11]; ring
  have hpos : ∀ y : ℝ, 0 ≤ y → y ^ 2 - 2 * y - 2 < 0 → ∃ w : ℝ, 2 ≤ w ∧ f y = w := by
    intro y hy hq
    have hden : ent g 1 0 * y + ent g 1 1 ≠ 0 := by rw [e10, e11]; linarith
    rw [hf1 y (by rw [hQ]; exact hq), mob_coe, if_neg hden]
    refine ⟨_, ?_, rfl⟩
    rw [e00, e01, e10, e11, le_div_iff₀ (by linarith)]
    linarith
  refine ⟨f, Subgroup.mem_inf.2 ⟨hfG, hfi⟩, ?_, ?_, hfi, ?_⟩
  · intro y hy
    exact hf2 y (by rw [hQ]; nlinarith)
  · intro y hy
    by_cases hq : y ^ 2 - 2 * y - 2 < 0
    · exact hpos y hy hq
    · replace hq := not_lt.1 hq
      exact ⟨y, by nlinarith, hf2 y (by rw [hQ]; exact hq)⟩
  · obtain ⟨w, hw, hfw⟩ := hpos 0 le_rfl (by norm_num)
    rw [hfw]
    intro h
    have := coe_injective h
    linarith

/-! ### The pair `a, b` in `H(ℤ)` -/

/-- Two non-commuting elements of `H(ℤ)` satisfying the two relations of `F₁`. -/
theorem exists_pair : ∃ a b : H ⊥,
    (a * b⁻¹) * (a⁻¹ * b * a) = (a⁻¹ * b * a) * (a * b⁻¹) ∧
    (a * b⁻¹) * (a⁻¹ ^ 2 * b * a ^ 2) = (a⁻¹ ^ 2 * b * a ^ 2) * (a * b⁻¹) ∧
    a * b ≠ b * a := by
  obtain ⟨a, ha, ha1, ha2, hai⟩ := exists_a
  obtain ⟨c, hc, hc1, hc2, hci, hc0⟩ := exists_c
  obtain ⟨h1, h2, h3⟩ := relations (by norm_num) ha1 ha2 hai hc1 hc2 hci hc0 _ rfl
  set A : H ⊥ := ⟨a, ha⟩
  set C : H ⊥ := ⟨c, hc⟩
  refine ⟨A, C⁻¹ * A⁻¹ * C * A, ?_, ?_, ?_⟩
  · apply Subtype.ext
    simpa only [Subgroup.coe_mul, Subgroup.coe_inv] using h1
  · apply Subtype.ext
    simpa only [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_pow] using h2
  · intro h
    apply h3
    simpa only [Subgroup.coe_mul, Subgroup.coe_inv] using congrArg Subtype.val h

/-! ### The embedding -/

open CannonFloydParry in
/-- The images of the formal symbols. -/
def gens {G : Type*} (a b : G) : FormalAB → G
  | FormalAB.A => a
  | FormalAB.B => b

open CannonFloydParry in
lemma lift_relsF1 {G : Type*} [Group G] (a b : G)
    (h1 : (a * b⁻¹) * (a⁻¹ * b * a) = (a⁻¹ * b * a) * (a * b⁻¹))
    (h2 : (a * b⁻¹) * (a⁻¹ ^ 2 * b * a ^ 2) = (a⁻¹ ^ 2 * b * a ^ 2) * (a * b⁻¹)) :
    ∀ r ∈ relsF1, FreeGroup.lift (gens a b) r = 1 := by
  intro r hr
  simp only [relsF1, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · simp only [map_mul, map_inv, FreeGroup.lift_apply_of, gens]
    rw [h1]; group
  · simp only [map_mul, map_inv, map_pow, FreeGroup.lift_apply_of, gens]
    rw [h2]; group

open CannonFloydParry in
/-- Stankov: given `F ≅ F₁` and that every proper quotient of `F` is abelian, `F` embeds in
`H(ℤ)`. -/
theorem exists_injective_of (e : F1 ≃* F)
    (hq : ∀ (N : Subgroup F) [N.Normal], N ≠ ⊥ → ∀ x y : F ⧸ N, x * y = y * x) :
    ∃ φ : F →* H ⊥, Function.Injective φ := by
  obtain ⟨a, b, h1, h2, h3⟩ := exists_pair
  let ψ : F1 →* H ⊥ := PresentedGroup.toGroup (lift_relsF1 a b h1 h2)
  refine ⟨ψ.comp e.symm.toMonoidHom, ?_⟩
  set φ := ψ.comp e.symm.toMonoidHom with hφ
  have hA : φ (e (PresentedGroup.of FormalAB.A)) = a := by
    rw [hφ, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.symm_apply_apply]
    exact PresentedGroup.toGroup.of (lift_relsF1 a b h1 h2)
  have hB : φ (e (PresentedGroup.of FormalAB.B)) = b := by
    rw [hφ, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.symm_apply_apply]
    exact PresentedGroup.toGroup.of (lift_relsF1 a b h1 h2)
  rw [← MonoidHom.ker_eq_bot_iff]
  by_contra hK
  have hc := hq φ.ker hK (e (PresentedGroup.of FormalAB.A) : F ⧸ φ.ker)
    (e (PresentedGroup.of FormalAB.B) : F ⧸ φ.ker)
  have := congrArg (QuotientGroup.kerLift φ) hc
  rw [map_mul, map_mul, QuotientGroup.kerLift_mk, QuotientGroup.kerLift_mk, hA, hB] at this
  exact h3 this

end ThompsonAmenability.Dev.Stankov
end

open ThompsonAmenability in
theorem solution :
    ∃ φ : CannonFloydParry.F →* Monod.H ⊥, Function.Injective φ := by
  obtain ⟨e, -, -⟩ := CannonFloydParry.exists_mulEquiv_F1_F
  exact Dev.Stankov.exists_injective_of e
    (fun N _ hN x y => CannonFloydParry.mul_comm_quotient_of_ne_bot N hN x y)

