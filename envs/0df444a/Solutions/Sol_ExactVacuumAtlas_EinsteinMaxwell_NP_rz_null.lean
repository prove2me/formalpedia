theorem slice_of_joint {Φ : ℝ → Pt 4 → ℂ} {W : Set (ℝ × Pt 4)}
    (hΦ : ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => Φ p.1 p.2) W) (ε : ℝ) :
    ContDiffOn ℝ ∞ (Φ ε) {y | (ε, y) ∈ W} :=
  hΦ.comp (contDiff_const.prodMk contDiff_id).contDiffOn fun _ hy => hy

theorem slice_of_jointR {Φ : ℝ → Pt 4 → ℝ} {W : Set (ℝ × Pt 4)}
    (hΦ : ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => Φ p.1 p.2) W) (ε : ℝ) :
    ContDiffOn ℝ ∞ (Φ ε) {y | (ε, y) ∈ W} :=
  hΦ.comp (contDiff_const.prodMk contDiff_id).contDiffOn fun _ hy => hy

variable (hN : NullFrameData g0 gi0 E0 Θ0 U) (ht : RealFrameTangent g0 E0 U h f B)
include hN ht

theorem contDiffOn_rzE_joint (A μ : Fin 4) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzE E0 B p.1 A μ p.2) (rzW U E0 B) := by
  have hs : ∀ {φ : Pt 4 → ℂ}, ContDiffOn ℝ ∞ φ U → ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => φ p.2) (rzW U E0 B) :=
    fun hφ => hφ.comp contDiff_snd.contDiffOn fun p hp => hp.1
  have hfst : ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => ((p.1 : ℝ) : ℂ)) (rzW U E0 B) :=
    (Complex.ofRealCLM.contDiff.comp contDiff_fst).contDiffOn
  exact (hs (hN.smooth_E A μ)).add (hfst.mul (hs (ht.smooth_B A μ)))

theorem contDiffOn_rzTh_joint (C μ : Fin 4) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzTh U E0 Θ0 B p.1 C μ p.2) (rzW U E0 B) := by
  have hinv := contDiffOn_invC_of (A := fun p : ℝ × Pt 4 => frMat (rzE E0 B p.1) p.2) (s := rzW U E0 B)
    (fun ν A => by simpa only [frMat, Matrix.of_apply] using contDiffOn_rzE_joint hN ht A ν)
    (fun p hp => hp.2) C μ
  exact hinv.congr fun p hp => rzTh_eq_inv hp.1 C μ

theorem rzE_swap {ε : ℝ} {y : Pt 4} (hy : y ∈ U) (hR0 : RealPattern E0 U) (A μ : Fin 4) :
    rzE E0 B ε (swap23 A) μ y = conj (rzE E0 B ε A μ y) := by
  simp only [rzE, hR0 y hy, ht.real_B y hy, map_add, map_mul, Complex.conj_ofReal]

theorem rzTh_swap {p : ℝ × Pt 4} (hp : p ∈ rzW U E0 B) (hR0 : RealPattern E0 U) (C μ : Fin 4) :
    rzTh U E0 Θ0 B p.1 (swap23 C) μ p.2 = conj (rzTh U E0 Θ0 B p.1 C μ p.2) := by
  rw [rzTh_eq_inv hp.1, rzTh_eq_inv hp.1]
  exact inv_swap_conj (fun ν A => rzE_swap hN ht hp.1 hR0 A ν) hp.2 C μ

theorem rzGc_real {p : ℝ × Pt 4} (hp : p ∈ rzW U E0 B) (hR0 : RealPattern E0 U) (μ ν : Fin 4) :
    ((rzGc U E0 Θ0 B p.1 μ ν p.2).re : ℂ) = rzGc U E0 Θ0 B p.1 μ ν p.2 := by
  apply Complex.conj_eq_iff_re.mp
  simp only [rzGc, map_sum, map_mul, conj_etaNull, ← rzTh_swap hN ht hp hR0]
  rw [← Equiv.sum_comp swap23Perm]
  refine Finset.sum_congr rfl fun C _ => ?_
  rw [← Equiv.sum_comp swap23Perm]
  refine Finset.sum_congr rfl fun D _ => ?_
  simp only [swap23Perm_apply, swap23_swap23, etaNull_swap]

theorem cmat_rzG {p : ℝ × Pt 4} (hp : p ∈ rzW U E0 B) (hR0 : RealPattern E0 U) :
    cmat (rzG U g0 E0 Θ0 B p.1) p.2
      = ((frMat (rzE E0 B p.1) p.2)⁻¹)ᵀ * etaNull * (frMat (rzE E0 B p.1) p.2)⁻¹ := by
  ext μ ν
  simp only [cmat, metricMatrix, Matrix.map_apply, Matrix.of_apply, rzG, hp.1, if_true]
  rw [rzGc_real hN ht hp hR0, rzGc_eq, coMat_rzTh hp.1]

theorem contDiffOn_rzG_joint (μ ν : Fin 4) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzG U g0 E0 Θ0 B p.1 μ ν p.2) (rzW U E0 B) := by
  have hc : ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzGc U E0 Θ0 B p.1 μ ν p.2) (rzW U E0 B) := by
    simp only [rzGc]
    exact ContDiffOn.sum fun C _ => ContDiffOn.sum fun D _ =>
      ((contDiffOn_rzTh_joint hN ht C μ).mul contDiffOn_const).mul (contDiffOn_rzTh_joint hN ht D ν)
  exact (Complex.reCLM.contDiff.comp_contDiffOn hc).congr fun p hp => by
    simp [rzG, hp.1]

theorem contDiffOn_rzGI_joint (μ ν : Fin 4) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzGI U gi0 E0 B p.1 μ ν p.2) (rzW U E0 B) := by
  have hc : ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => rzGIc E0 B p.1 μ ν p.2) (rzW U E0 B) := by
    simp only [rzGIc]
    exact ContDiffOn.sum fun C _ => ContDiffOn.sum fun D _ =>
      ((contDiffOn_rzE_joint hN ht C μ).mul contDiffOn_const).mul (contDiffOn_rzE_joint hN ht D ν)
  exact (Complex.reCLM.contDiff.comp_contDiffOn hc).congr fun p hp => by
    simp [rzGI, hp.1]

theorem rz_gram {p : ℝ × Pt 4} (hp : p ∈ rzW U E0 B) (hR0 : RealPattern E0 U) :
    gramM (rzG U g0 E0 Θ0 B p.1) (rzE E0 B p.1) p.2 = etaNull := by
  have hT : (frMat (rzE E0 B p.1) p.2)⁻¹ * frMat (rzE E0 B p.1) p.2 = 1 :=
    Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hp.2)
  rw [gramM, cmat_rzG hN ht hp hR0]
  set T := frMat (rzE E0 B p.1) p.2
  calc Tᵀ * (T⁻¹ᵀ * etaNull * T⁻¹) * T = (T⁻¹ * T)ᵀ * etaNull * (T⁻¹ * T) := by
        simp only [Matrix.transpose_mul, Matrix.mul_assoc]
    _ = etaNull := by rw [hT]; simp

