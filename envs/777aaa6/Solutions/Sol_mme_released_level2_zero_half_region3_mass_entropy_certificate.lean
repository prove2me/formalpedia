theorem massEntropy_smul {W : Type*} [Fintype W] (a : ℝ) (p : W → ℝ) (hp : ∑ w, p w = 1) :
    MME.RegionRate.massEntropy (fun w => a * p w) = a * MME.RegionRate.entropy p := by
  unfold MME.RegionRate.massEntropy MME.RegionRate.entropy
  simp only [Real.negMulLog_mul, Finset.sum_add_distrib, ← Finset.sum_mul, ← Finset.mul_sum, hp,
    Real.negMulLog_one]
  ring

theorem log5_lower (L : ℚ) (h : let q : ℚ := 5
    let k : ℤ := -2
    let n := 14
    let t := ((2 : ℚ) ^ k * q - 1) / ((2 : ℚ) ^ k * q + 1)
    let twoCenter := 2 * ∑ i ∈ Finset.range n, (1 / 3 : ℚ) ^ (2 * i + 1) / (2 * i + 1)
    let twoError := 2 * ((1 / 3 : ℚ) ^ (2 * n + 1) / (1 - (1 / 3 : ℚ) ^ 2))
    let center := (2 * ∑ i ∈ Finset.range n, t ^ (2 * i + 1) / (2 * i + 1)) -
      (k : ℚ) * twoCenter
    let error := 2 * (|t| ^ (2 * n + 1) / (1 - t ^ 2)) + |(k : ℚ)| * twoError
    L ≤ center - error ∧ center + error ≤ 2) : (L : ℝ) ≤ Real.log 5 := by
  have := (mme_rational_log_series_certificate 5 (by norm_num) (-2) 14 L 2 h.1 h.2).1
  simpa using this

