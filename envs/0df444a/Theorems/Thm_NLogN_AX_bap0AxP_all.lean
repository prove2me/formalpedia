theorem NLogN.AX.bap0AxP_all (M : MulSpec) (p s t α m kb Bi Bo mm Φ Bacc Q Bq : ℕ) (rest : List ℕ)
    (hM : MulBnd M mm Φ) (H : BapHyp p s t α kb Bi Bo mm Bacc Q) (HT : TabHypB p s t α Bq)
    (hα : 1 ≤ α) (HQ : AxQ t s m kb Bi Bo Q) (hmr : m = rest.prod)
    (st : IState HS) (L : List (ℤ × ℤ)) (Rest : List Item) (hR : BapRegs p s t α m kb st)
    (hD : st.G NLogN.GL.gD = gints L ++ Rest) (hL : L.length = t * m) (hLB : NLogN.GL.GB Bi L) :
    bap0AxP.run st = st.upd NLogN.GL.gD (gints (tensorGo [(s, b0L p s t α)] (t :: rest) L) ++ Rest) ∧
      bap0AxP.ok M st ∧ bap0AxP.cost M st ≤ bap0AxCost p s t α m kb Bi mm Φ Bacc Q Bq ∧
      (tensorGo [(s, b0L p s t α)] (t :: rest) L).length = m * s ∧
      NLogN.GL.GB Bo (tensorGo [(s, b0L p s t α)] (t :: rest) L) := by sorry
