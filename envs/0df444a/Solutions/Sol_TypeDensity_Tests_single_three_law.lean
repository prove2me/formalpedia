    rw [TypeDensity.Tests.returnWeight_eval, show TypeDensity.tri 3 = 6 from rfl, inv_eq_iff_eq_inv, inv_div]; field_simp
  rw [TypeDensity.Tests.stateLaw_single 1 3 ⟨one_pos, by norm_num⟩ (by norm_num), TypeDensity.Tests.coeff_scale, TypeDensity.Tests.coeff_exitLaw,
    TypeDensity.Tests.sum_allowed_single_one_three, hR]
  simp only [TypeDensity.Tests.children_single_one_three, TypeDensity.Tests.coeff_m3Inert, TypeDensity.Tests.coeff_m3Quadratic, TypeDensity.Tests.coeff_m3Split,
    TypeDensity.Tests.coeff_m3Tangent q hq]
  rw [TypeDensity.Tests.coeff_childProd_perm (TypeDensity.Tests.children_single_perm _ (l := [(1, .crossing 1 1 1 2)]) (by decide)),
    TypeDensity.Tests.coeff_childProd_perm (TypeDensity.Tests.children_single_perm _ (l := [(1, .crossing 1 1 2 1)]) (by decide)),
    TypeDensity.Tests.coeff_childProd_perm
