set_option autoImplicit false
open Sendov
namespace Sendov
theorem _root_.solution (r s : List (List ℤ)) : l1row (radd r s) ≤ l1row r + l1row s := by
  induction r generalizing s with
  | nil => simp [radd]
  | cons p r ih =>
    cases s with
    | nil => simp [radd]
    | cons q s =>
      have h1 := ih s
      have h2 := l1_padd p q
      simp only [radd, l1row_cons]
      omega
end Sendov
