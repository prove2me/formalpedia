/-- Variation functions of jointly smooth families are `C^∞` on the slice. -/
theorem contDiffOn_var_of {W : Set (ℝ × Pt 4)} (hW : IsOpen W) {Φ : ℝ → Pt 4 → ℂ} {V : Pt 4 → ℂ}
    (hΦ : ContDiffOn ℝ ∞ (fun p : ℝ × Pt 4 => Φ p.1 p.2) W)
    (hd : ∀ y, ((0 : ℝ), y) ∈ W → HasDerivAt (fun ε => Φ ε y) (V y) 0) :
    ContDiffOn ℝ ∞ V {y | ((0 : ℝ), y) ∈ W} :=
  (contDiffOn_deriv_slice hW hΦ 0).congr fun y hy => (hd y hy).deriv.symm

namespace NPFamily

variable {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ} {W : Set (ℝ × Pt 4)}
  {h : Metric 4} {f : TwoForm 4} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}

variable (hF : NPFamily g gi F E Θ W) (ht : NPTangent g F E W h f B)
include hF ht

theorem smooth_weylFVar (I J A K : Fin 4) :
    ContDiffOn ℝ ∞ (weylFVar (g 0) (gi 0) h (E 0) B I J A K) {y | ((0 : ℝ), y) ∈ W} :=
  contDiffOn_var_of hF.isOpen (Φ := fun ε y => weylF (g ε) (gi ε) (E ε) I J A K y) (hF.j_weylF I J A K)
    fun _ hy => hasDerivAt_weylF hF ht hy I J A K

theorem smooth_ricFVar (A K : Fin 4) :
    ContDiffOn ℝ ∞ (ricFVar (g 0) (gi 0) h (E 0) B A K) {y | ((0 : ℝ), y) ∈ W} :=
  contDiffOn_var_of hF.isOpen (Φ := fun ε y => ricF (g ε) (gi ε) (E ε) A K y) (hF.j_ricF A K)
    fun _ hy => hasDerivAt_ricF hF ht hy A K

end NPFamily

section knsmooth

variable {M a Q : ℝ} {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ}
