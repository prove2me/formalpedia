      (1-((z+1)*(Real.log (4*z)^2/(2*TaoFivePrimes.twinPrimeConstant))/(16*z^2))) ≤
      ∑ n ∈ Finset.Icc 1 ⌊z⌋₊, ReciprocalBatch.weight n/(1+(n:ℝ)/z) := by
  apply PrimePairSieve.reciprocal_interval_certificate_with_constant (131/100) 48016 50000 (30517/2500) z
    (by norm_num) PrimePairSieve.twin_prime_constant_lower_131 (by norm_num) hl hu log_50000 (by norm_num)
  have hi : endpointSum 48016 buckets = 5757867765 := by decide +kernel
  have hb := PrimePairSieve.reciprocal_mass_endpoint_sound 100000000 48016
    (by norm_num) (by norm_num) buckets positive separated masses_valid
  rw [hi] at hb
  have hr : ((30517/2500):ℝ)^2/(2*(131/100))/(1-((48016+1)/(16*48016^2))*((30517/2500)^2/(2*(131/100)))) ≤ (5757867765:ℝ)/100000000 := by norm_num
  simpa [ReciprocalBatch.weight] using hr.trans hb

end MassWindow20000_50000

theorem solution : ∀ z : ℝ, 20000 ≤ z → z ≤ 50000 →
      (Real.log (4 * z)) ^ 2 / (2 * TaoFivePrimes.twinPrimeConstant) /
          (1 - ((z + 1) * ((Real.log (4 * z)) ^ 2 /
            (2 * TaoFivePrimes.twinPrimeConstant)) / (16 * z ^ 2)))
        ≤ ∑ q ∈ Finset.Icc 1 ⌊z⌋₊,
          (if Squarefree q then
            ∏ p ∈ q.primeFactors, if p = 2 then (1 : ℝ) else 2 / ((p : ℝ) - 2)
