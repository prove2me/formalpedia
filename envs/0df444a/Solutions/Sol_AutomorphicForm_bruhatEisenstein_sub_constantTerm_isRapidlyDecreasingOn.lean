variable (F : Type) [Field F]

private def borelOf (p : Fˣ × Fˣ × F) : GL (Fin 2) F :=
  Matrix.GeneralLinearGroup.mkOfDetNeZero !![(p.1 : F), (p.1 : F) * p.2.2; 0, (p.2.1 : F)]
    (by
      rw [Matrix.det_fin_two_of]
      simp [p.1.ne_zero, p.2.1.ne_zero])

@[scoped simp] private theorem borelOf_val (p : Fˣ × Fˣ × F) :
    (borelOf F p : Matrix (Fin 2) (Fin 2) F) = !![(p.1 : F), (p.1 : F) * p.2.2; 0, (p.2.1 : F)] :=
  rfl

private theorem borelOf_mem (p : Fˣ × Fˣ × F) : borelOf F p ∈ borelSubgroup F := by
  rw [mem_borelSubgroup_iff, borelOf_val]
  rfl

private theorem diag_ne_zero_of_mem {γ : GL (Fin 2) F} (hγ : γ ∈ borelSubgroup F) :
    (γ : Matrix (Fin 2) (Fin 2) F) 0 0 ≠ 0 ∧ (γ : Matrix (Fin 2) (Fin 2) F) 1 1 ≠ 0 := by
  have hdet : (γ : Matrix (Fin 2) (Fin 2) F).det ≠ 0 := by
    rw [← Matrix.GeneralLinearGroup.val_det_apply]
    exact (Matrix.GeneralLinearGroup.det γ).ne_zero
  rw [Matrix.det_fin_two, (mem_borelSubgroup_iff F γ).1 hγ, mul_zero, sub_zero] at hdet
  exact ⟨left_ne_zero_of_mul hdet, right_ne_zero_of_mul hdet⟩

private def coordsOf (γ : borelSubgroup F) : Fˣ × Fˣ × F :=
  (Units.mk0 _ (diag_ne_zero_of_mem F γ.2).1, Units.mk0 _ (diag_ne_zero_of_mem F γ.2).2,
    ((γ : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) 0 1 / ((γ : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) 0 0)

private def borelEquiv : (Fˣ × Fˣ × F) ≃ borelSubgroup F where
  toFun p := ⟨borelOf F p, borelOf_mem F p⟩
  invFun := coordsOf F
  left_inv p := by
    obtain ⟨a, d, ξ⟩ := p
    simp only [coordsOf, borelOf_val, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one]
    refine Prod.ext (Units.ext rfl) (Prod.ext (Units.ext rfl) ?_)
    show (a : F) * ξ / a = ξ
    field_simp
  right_inv γ := by
    obtain ⟨γ, hγ⟩ := γ
    have h00 := (diag_ne_zero_of_mem F hγ).1
    apply Subtype.ext
    apply Units.ext
    show (borelOf F (coordsOf F ⟨γ, hγ⟩) : Matrix (Fin 2) (Fin 2) F) = γ
    rw [borelOf_val]
    ext i j
    fin_cases i <;> fin_cases j
    · rfl
    · show (γ : Matrix (Fin 2) (Fin 2) F) 0 0 * ((γ : Matrix (Fin 2) (Fin 2) F) 0 1 / (γ : Matrix (Fin 2) (Fin 2) F) 0 0)
        = (γ : Matrix (Fin 2) (Fin 2) F) 0 1
      field_simp
    · exact ((mem_borelSubgroup_iff F γ).1 hγ).symm
    · rfl

@[scoped simp] private theorem borelEquiv_apply (p : Fˣ × Fˣ × F) : (borelEquiv F p : GL (Fin 2) F) = borelOf F p := rfl

