set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open NLogN.KIL
open IntMul AModel AModelL12
variable {sh : Shape} {m Q : ℕ} (Λ : Layout sh (m + m) Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}
theorem solution {Rg : Type*} [CommRing Rg] {W : ℕ} (C : AModel.Circuit Rg m W) (X : AModel.IMat m)
    [NeZero Q] (hQ : 1 < Q) (hX : AModel.FacAt Q C.fac X)
    (jOf : Fin (m + m) → Fin (m + m) → Fin Pp)
    (child : Fin (m + m) → Fin (m + m) → List ℤ → List ℤ) (hpos : ∀ a ∈ sh, 1 ≤ a)
    (t : NLogN.IState NLogN.HS) (R : List NLogN.Item) (Bb : ℕ) (hV : NLogN.zsz ((AModel.vol sh : ℕ) : ℤ) ≤ Bb)
    (hQ2 : NLogN.zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (c0 : ℕ)
    (hU : ∀ i u c, AModel.Step.shift i u c ∈ AModel.edgeSteps C Q X → NLogN.KIL.SmallUnit2 Q u)
    (hC : ∀ a b, AModel.Step.swap a b ∈ AModel.edgeSteps C Q X → ∀ ys, NLogN.KIL.DOK sh Bb ys →
      NLogN.IRuns I iprog (iprog (jOf a b)) (t.upd 0 (NLogN.ints ys ++ R))
        (t.upd 0 (NLogN.ints (child a b ys) ++ R)) c0 ∧
      child a b ys = (AModel.Step.swap a b).arr Λ 0 ys)
    (xs : List ℤ) (hx : NLogN.KIL.DOK sh Bb xs) :
    NLogN.IRuns I iprog (NLogN.KIL.runCode (NLogN.KIL.scodeU2 Λ) jOf (AModel.edgeSteps C Q X)) (t.upd 0 (NLogN.ints xs ++ R))
      (t.upd 0 (NLogN.ints (AModel.runArr Λ 0 (AModel.edgeSteps C Q X) xs) ++ R))
      ((4 * m + 2 * AModel.pivRank C X) * NLogN.KIL.cShiftU sh.length (AModel.vol sh) Bb + AModel.pivRank C X * (c0 + 2) + 1) := by
  have hW : ∀ s ∈ AModel.edgeSteps C Q X, s.WF :=
    AModel.shearSteps_WF (fun i => by simpa [AModel.castM] using hX.2.2.1 i)
      (fun i => by simpa [AModel.castM] using hX.2.2.2.1 i)
  have H := NLogN.KIL.runCodeWF_spec (I := I) (iprog := iprog) Λ jOf child hpos t R Bb hV hQ2 (fun _ _ => c0) (AModel.edgeSteps C Q X) hW hU
    hC xs hx
  have h1 := AModel.countP_edgeSteps C hQ hX
  have h2 := AModel.length_edgeSteps C hQ hX
  have h3 := AModel.countP_not_add (AModel.edgeSteps C Q X)
  have h4 : (AModel.edgeSteps C Q X).countP (fun s => !s.isSwap) = 4 * m + 2 * AModel.pivRank C X := by omega
  rwa [NLogN.KIL.runCostI_const, h4, h1] at H
end
