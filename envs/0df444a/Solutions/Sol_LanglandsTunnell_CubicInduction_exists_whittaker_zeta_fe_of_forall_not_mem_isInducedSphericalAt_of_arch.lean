private theorem shell_eq
    (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
    (hdeg : Module.finrank ℚ K = 3)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (S : Finset (HeightOneSpectrum (𝓞 ℚ)))
    (hS : ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∈ S ↔ IsBadPlace K μ v)
    (Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (T : Finset (HeightOneSpectrum (𝓞 ℚ)))
    (hχT : ∀ w ∉ T, NumberField.TateGlobal.IsUnramifiedCharAt χ w)
    (χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (hχTdef : χT = μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm)
    (hvS : ∀ v, v ∉ T → v ∉ S)
    (hsphW : ∀ v, v ∉ T →
          HasSphericalTorusValuesAt (inducedCoeff K μ) v (Wloc v))
    (hτ0 : ∀ v, v ∉ T → ∀ m : ℤ, m < 0 →
          LanglandsTunnell.CubicInduction.TorusFactorisation.torusValue (Wloc v) m = 0)
    (hτ : ∀ v, v ∉ T → ∀ n : ℕ, ‖LanglandsTunnell.CubicInduction.TorusFactorisation.torusValue (Wloc v) n‖ ≤
          (2 * ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ (4 : ℝ)) ^ n)
    (hχ1 : ∀ v, v ∉ T →
          ‖((χ (AutomorphicForm.uniformizerIdele ℚ v) : ℂˣ) : ℂ)‖ ≤ ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ (0 : ℝ)) :
    ∀ s : ℂ, (8 : ℝ) ≤ s.re → ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∉ T →
          ∑' m : ℤ, LanglandsTunnell.CubicInduction.TorusFactorisation.torusValue (Wloc v) m *
                ((χ (AutomorphicForm.uniformizerIdele ℚ v) ^ m : ℂˣ) : ℂ) *
              (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ m : ℝ)) : ℂ) ^ (s - 1) =
            ((inducedEulerPoly ℚ (inducedCoeff K χT) v).eval ((Ideal.absNorm v.asIdeal : ℂ) ^ (-s)))⁻¹ := by
  intro s hs v hv
  have hsumv := LanglandsTunnell.CubicInduction.EulerProduct30.summable_shellSum_of_not_mem T χ
    (fun v => LanglandsTunnell.CubicInduction.TorusFactorisation.torusValue (Wloc v)) (κ := 4) (τ₀ := 0)
