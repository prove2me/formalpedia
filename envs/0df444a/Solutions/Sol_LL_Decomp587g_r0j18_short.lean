        omega
      rw [bR_eq]; have : 2 * ((B_num : ℝ) / D_den) = ((2 * B_num : ℕ) : ℝ) / D_den := by push_cast; ring
      rw [this]; exact div_le_div_of_nonneg_right (by exact_mod_cast hi1) (le_of_lt hD)
