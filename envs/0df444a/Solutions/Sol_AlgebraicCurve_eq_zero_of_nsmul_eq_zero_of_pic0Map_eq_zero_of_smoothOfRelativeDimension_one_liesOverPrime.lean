        apply Subtype.ext
        show Finsupp.single (𝔐.pointEquivPlace a) 1 - Finsupp.single (𝔐.pointEquivPlace b) 1 = (Da : Divisor (AlgebraicClosure ℚ) F) - (Db : Divisor (AlgebraicClosure ℚ) F)
        rw [hDa, hDb]; abel
