theorem moduleFlat_of_faithfullyFlat (A : Type u₁) (B : Type u₂) (C : Type u₃)
    [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C]
    [Module.FaithfullyFlat B C] [Module.Flat A C] : Module.Flat A B := by
  rw [Module.Flat.iff_lTensor_preserves_injective_linearMap]
  intro N N' _ _ _ _ f hf

  let eN := AlgebraTensorModule.cancelBaseChange (R := A) (A := B) (B := C) (M := C) (N := N)
  let eN' := AlgebraTensorModule.cancelBaseChange (R := A) (A := B) (B := C) (M := C) (N := N')
  have hcomm : ∀ x, eN' (((f.baseChange B).lTensor C) x) = (f.lTensor C) (eN x) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul c y =>
      induction y using TensorProduct.induction_on with
      | zero => simp
      | tmul b n =>
        simp [eN, eN', AlgebraTensorModule.cancelBaseChange_tmul, LinearMap.baseChange_tmul,
          LinearMap.lTensor_tmul]
      | add y₁ y₂ h₁ h₂ => simp only [TensorProduct.tmul_add, map_add, h₁, h₂]
    | add x₁ x₂ h₁ h₂ => simp only [map_add, h₁, h₂]
  have key : Function.Injective ((f.baseChange B).lTensor C) := by
    intro x₁ x₂ h
    have h' := congrArg eN' h
    rw [hcomm, hcomm] at h'
    exact eN.injective (Module.Flat.lTensor_preserves_injective_linearMap (M := C) f hf h')
  have h2 : Function.Injective (f.baseChange B) :=
    (Module.FaithfullyFlat.lTensor_injective_iff_injective B C (f.baseChange B)).mp key
  intro x₁ x₂ h
  apply h2
  have hfun : (f.baseChange B : B ⊗[A] N → B ⊗[A] N') = f.lTensor B := LinearMap.baseChange_eq_ltensor (f := f)
  rw [hfun]
  exact h

theorem ringHom_flat_of_comp {A B C : Type*} [CommRing A] [CommRing B] [CommRing C] [IsLocalRing B] [IsLocalRing C]
    (a : A →+* B) (b : B →+* C) (hb : b.Flat) (hbloc : IsLocalHom b) (hba : (b.comp a).Flat) : a.Flat := by
  algebraize [a, b, b.comp a]
  haveI : Module.FaithfullyFlat B C :=
    @Module.FaithfullyFlat.of_flat_of_isLocalHom B C _ _ _ _ _ inferInstance hbloc
  exact moduleFlat_of_faithfullyFlat A B C

end Descent

section Stalk

universe u

theorem flat_stalkMap_of_flat_pullback {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z) [Flat g]
    [Flat (pullback.snd f g)] (x : X) (hx : f x ∈ Set.range g) : (f.stalkMap x).hom.Flat := by
  obtain ⟨y, hy⟩ := hx
  obtain ⟨w, hwx, hwy⟩ := Scheme.Pullback.exists_preimage_pullback x y hy.symm
  subst hwx
  have hc : Flat (pullback.fst f g ≫ f) := by
    rw [pullback.condition]
    infer_instance
  have h1 : ((pullback.fst f g ≫ f).stalkMap w).hom.Flat := Flat.stalkMap _ w
  rw [Scheme.Hom.stalkMap_comp] at h1
  have h2 : ((pullback.fst f g).stalkMap w).hom.Flat := Flat.stalkMap _ w
  exact ringHom_flat_of_comp _ _ h2 ((pullback.fst f g).toLRSHom.prop w) h1

end Stalk

abbrev Zaway (N m : ℕ) : Type := Localization.Away ((6 * N * m : ℕ) : ℤ)

theorem natCast_NM (N m : ℕ) :
    algebraMap ℤ (Zaway N m) ((6 * N * m : ℕ) : ℤ) = ((6 : ℕ) : Zaway N m) * ((N : ℕ) : Zaway N m) * ((m : ℕ) : Zaway N m) := by
  rw [map_natCast]
  exact_mod_cast rfl

theorem isUnit_natCast_6NM (N m : ℕ) :
    IsUnit (((6 : ℕ) : Zaway N m) * ((N : ℕ) : Zaway N m) * ((m : ℕ) : Zaway N m)) := by
  rw [← natCast_NM]
  exact IsLocalization.Away.algebraMap_isUnit (S := Zaway N m) ((6 * N * m : ℕ) : ℤ)

theorem isUnit_natCast_NM (N m : ℕ) : IsUnit (((N : ℕ) : Zaway N m) * ((m : ℕ) : Zaway N m)) := by
  obtain ⟨h6N, hm⟩ := IsUnit.mul_iff.mp (isUnit_natCast_6NM N m)
  exact (IsUnit.mul_iff.mp h6N).2.mul hm

theorem isUnit_natCast_N (N m : ℕ) : IsUnit ((N : ℕ) : Zaway N m) :=
  isUnit_of_mul_isUnit_left (isUnit_natCast_NM N m)

theorem isUnit_natCast_m (N m : ℕ) : IsUnit ((m : ℕ) : Zaway N m) :=
  isUnit_of_mul_isUnit_right (isUnit_natCast_NM N m)

theorem isUnit_natCast_six (N m : ℕ) : IsUnit ((6 : ℕ) : Zaway N m) :=
  (IsUnit.mul_iff.mp (IsUnit.mul_iff.mp (isUnit_natCast_6NM N m)).1).1

theorem isUnit_natCast_two (N m : ℕ) : IsUnit ((2 : ℕ) : Zaway N m) :=
  isUnit_of_dvd_unit (Nat.cast_dvd_cast (show (2 : ℕ) ∣ 6 by norm_num)) (isUnit_natCast_six N m)

theorem isUnit_natCast_three (N m : ℕ) : IsUnit ((3 : ℕ) : Zaway N m) :=
  isUnit_of_dvd_unit (Nat.cast_dvd_cast (show (3 : ℕ) ∣ 6 by norm_num)) (isUnit_natCast_six N m)

theorem ne_zero_NM (N m : ℕ) [NeZero N] (hm : 3 ≤ m) : ((6 * N * m : ℕ) : ℤ) ≠ 0 := by
  have hN : N ≠ 0 := NeZero.ne N
  have hm0 : m ≠ 0 := by omega
  exact_mod_cast Nat.mul_ne_zero (Nat.mul_ne_zero (by norm_num) hN) hm0

theorem algebraMap_int_injective (N m : ℕ) [NeZero N] (hm : 3 ≤ m) :
    Function.Injective (algebraMap ℤ (Zaway N m)) :=
  IsLocalization.injective (Zaway N m) (powers_le_nonZeroDivisors_of_noZeroDivisors (ne_zero_NM N m hm))

theorem isDomain_Zaway (N m : ℕ) [NeZero N] (hm : 3 ≤ m) : IsDomain (Zaway N m) :=
  IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors (ne_zero_NM N m hm))

theorem isDedekindDomain_Zaway (N m : ℕ) [NeZero N] (hm : 3 ≤ m) : IsDedekindDomain (Zaway N m) := by
  haveI : IsDomain (Zaway N m) := isDomain_Zaway N m hm
  exact IsLocalization.isDedekindDomain ℤ (powers_le_nonZeroDivisors_of_noZeroDivisors (ne_zero_NM N m hm)) (Zaway N m)

theorem charZero_Zaway (N m : ℕ) [NeZero N] (hm : 3 ≤ m) : CharZero (Zaway N m) :=
  charZero_of_injective_algebraMap (algebraMap_int_injective N m hm)

noncomputable def toRing (N m : ℕ) (𝒪 : Type) [CommRing 𝒪]
    (hN : IsUnit ((N : ℕ) : 𝒪)) (hm' : IsUnit ((m : ℕ) : 𝒪)) (h2 : IsUnit ((2 : ℕ) : 𝒪))
    (h3 : IsUnit ((3 : ℕ) : 𝒪)) : Zaway N m →+* 𝒪 :=
  IsLocalization.Away.lift ((6 * N * m : ℕ) : ℤ) (g := Int.castRingHom 𝒪)
    (by
      have : (Int.castRingHom 𝒪) ((6 * N * m : ℕ) : ℤ) = ((6 : ℕ) : 𝒪) * ((N : ℕ) : 𝒪) * ((m : ℕ) : 𝒪) := by
        simp [Int.cast_natCast, Nat.cast_mul]
      rw [this]
      exact ((by rw [show (6 : ℕ) = 2 * 3 from rfl, Nat.cast_mul]; exact h2.mul h3 : IsUnit ((6 : ℕ) : 𝒪)).mul hN).mul hm')

theorem toRing_algebraMap (N m : ℕ) (𝒪 : Type) [CommRing 𝒪]
    (hN : IsUnit ((N : ℕ) : 𝒪)) (hm' : IsUnit ((m : ℕ) : 𝒪)) (h2 : IsUnit ((2 : ℕ) : 𝒪))
    (h3 : IsUnit ((3 : ℕ) : 𝒪)) (z : ℤ) :
    toRing N m 𝒪 hN hm' h2 h3 (algebraMap ℤ (Zaway N m) z) = (z : 𝒪) := by
  simp [toRing]

theorem toRing_injective (N m : ℕ) [NeZero N] (hm : 3 ≤ m) (𝒪 : Type) [CommRing 𝒪] [CharZero 𝒪]
    (hN : IsUnit ((N : ℕ) : 𝒪)) (hm' : IsUnit ((m : ℕ) : 𝒪)) (h2 : IsUnit ((2 : ℕ) : 𝒪))
    (h3 : IsUnit ((3 : ℕ) : 𝒪)) : Function.Injective (toRing N m 𝒪 hN hm' h2 h3) := by
  rw [IsLocalization.injective_iff_map_algebraMap_eq (Submonoid.powers ((6 * N * m : ℕ) : ℤ))]
  intro x y
  rw [toRing_algebraMap, toRing_algebraMap]
  constructor
  · intro h
    rw [algebraMap_int_injective N m hm h]
  · intro h
    rw [Int.cast_injective h]

theorem ringHom_flat_of_injective {R T : Type*} [CommRing R] [IsDedekindDomain R] [CommRing T] [IsDomain T]
    (β : R →+* T) (hβ : Function.Injective β) : β.Flat := by
  algebraize [β]
  haveI : Module.IsTorsionFree R T := Module.isTorsionFree_iff_algebraMap_injective.mpr hβ
  show Module.Flat R T
  infer_instance

theorem ideal_eq_of_natPrime_mem (N m : ℕ) {r : ℕ} (hr : r.Prime)
    (P P' : Ideal (Zaway N m)) [P.IsPrime] [P'.IsPrime]
    (h : ((r : ℕ) : Zaway N m) ∈ P) (h' : ((r : ℕ) : Zaway N m) ∈ P') : P = P' := by
  have key : ∀ (Q : Ideal (Zaway N m)) [Q.IsPrime], ((r : ℕ) : Zaway N m) ∈ Q → Q.under ℤ = Ideal.span {(r : ℤ)} := by
    intro Q _ hQ
    have hmax : (Ideal.span {(r : ℤ)}).IsMaximal :=
      PrincipalIdealRing.isMaximal_of_irreducible (Nat.prime_iff_prime_int.mp hr).irreducible
    refine (hmax.eq_of_le (Ideal.IsPrime.ne_top inferInstance) ?_).symm
    rw [Ideal.span_singleton_le_iff_mem, Ideal.under_def, Ideal.mem_comap, map_natCast]
    exact hQ
  rw [← IsLocalization.map_under (Submonoid.powers ((6 * N * m : ℕ) : ℤ)) (Zaway N m) P,
    ← IsLocalization.map_under (Submonoid.powers ((6 * N * m : ℕ) : ℤ)) (Zaway N m) P', key P h, key P' h']

theorem isUnit_natCast_padicInt {r : ℕ} [Fact r.Prime] {n : ℕ} (h : ¬ r ∣ n) : IsUnit ((n : ℕ) : ℤ_[r]) := by
  rw [PadicInt.isUnit_iff]
  refine le_antisymm (PadicInt.norm_le_one _) ?_
  have hlt : ¬ ‖((n : ℤ) : ℤ_[r])‖ < 1 := by
    rw [PadicInt.norm_int_lt_one_iff_dvd]
    exact_mod_cast h
  rw [Int.cast_natCast] at hlt
  exact not_lt.mp hlt

theorem isIndefiniteRamifiedExactlyAt_symm {a b : ℚ} {q q' : ℕ} (h : IsIndefiniteRamifiedExactlyAt a b q q') :
    IsIndefiniteRamifiedExactlyAt a b q' q := by
  unfold QuaternionAlgebra.IsIndefiniteRamifiedExactlyAt at h ⊢
  exact ⟨h.1, fun v => (h.2 v).trans or_comm⟩

