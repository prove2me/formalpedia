/-- `2^(Q+1)`, `kJ`, `2^kJ`, `wd`. -/
theorem Rn.ph3b_sol_aux {kA kC wA wC Q W : ℕ} {c : Cs} (hcL : c cLC = []) {vb : Vr} (hb : BV W vb)
    (h9 : vb 9 = ((2 ^ Q : ℕ) : ℤ)) (h20 : vb 20 = Q)
    (bkJ : 2 ^ (kA * Q + kC + 1) < 2 ^ W) (bQ : 2 ^ (Q + 2) < 2 ^ W) (bwd : wA * Q + wC < 2 ^ W)
    (bkJ' : kA * Q + kC < 2 ^ W) (b1500 : 1500 + 8 < 2 ^ W) (bwA : wA ≤ 2 ^ W)
    (bwC : wC ≤ 2 ^ W) (bkA : kA ≤ 2 ^ W) (bkC : kC ≤ 2 ^ W) :
    Rn (ph3b kA kC wA wC) vb c (fun v =>
      v 7 = ((wA * Q + wC : ℕ) : ℤ) ∧ v 10 = ((2 ^ (Q + 1) : ℕ) : ℤ) ∧
      v 11 = ((kA * Q + kC : ℕ) : ℤ) ∧ v 12 = ((2 ^ (kA * Q + kC) : ℕ) : ℤ) ∧
      (∀ j : Fin HS, j ≠ 7 → j ≠ 10 → j ≠ 11 → j ≠ 12 → v j = vb j) ∧
      BV W v) c (cPh3b kA kC wA wC W (kA * Q + kC)) := by
  have hp1 : 2 ^ (Q + 1) ≤ 2 ^ (Q + 2) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hk1 : 2 ^ (kA * Q + kC) ≤ 2 ^ (kA * Q + kC + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hpos : (0 : ℤ) ≤ 2 ^ W := by positivity
  have hW1 : 1 ≤ 2 ^ W := Nat.one_le_two_pow
  have e2 : (2 : ℤ) * ((2 ^ Q : ℕ) : ℤ) = ((2 ^ (Q + 1) : ℕ) : ℤ) := by push_cast; ring
  have okA5 : okA (pA5 kA kC) = true := by simp [okA, pA5, E.ok, rg]
  have okA6 : okA (pA6 wA wC) = true := by simp [okA, pA6, E.ok, rg]
  refine Rn.seq (Rn.asgs (pA5 kA kC) okA5 (by simp [pA5, lbA, E.lb]; omega) hb (by
    simp only [pA5, BndA, E.den]
    refine ⟨?_, ?_, by simp; exact_mod_cast hW1, trivial⟩
    · rw [h9, e2, abs_of_nonneg (by positivity)]; exact_mod_cast (by omega)
    · simp only [update_apply]; simp [h20]
      rw [abs_of_nonneg (by positivity)]; exact_mod_cast (by omega))) (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
  have a10 : runA (pA5 kA kC) vb 10 = ((2 ^ (Q + 1) : ℕ) : ℤ) := by
    simp only [pA5, runA, E.den]; rw [h9, e2]; simp [update_apply]
  have a11 : runA (pA5 kA kC) vb 11 = ((kA * Q + kC : ℕ) : ℤ) := by
    simp only [pA5, runA, E.den]; simp [update_apply, h20]
  have a12 : runA (pA5 kA kC) vb 12 = 1 := by simp [pA5, runA, update_apply, E.den]
  have a20 : runA (pA5 kA kC) vb 20 = Q := by simp [pA5, runA, update_apply, E.den, h20]
  have aF : ∀ j : Fin HS, j ≠ 10 → j ≠ 11 → j ≠ 12 → runA (pA5 kA kC) vb j = vb j := by
    intro j b10 b11 b12; simp [pA5, runA, update_apply, b10, b11, b12]
  refine Rn.seq (pwL (x := 12) (rc := 11) (N := kA * Q + kC) (by decide) (by decide)
    (by decide) b1 a12 a11 (by omega) (by omega) (by omega) hcL) (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
  refine (Rn.asgs (pA6 wA wC) okA6 (by simp [pA6, lbA, E.lb]; omega) b1 (by
    simp only [pA6, BndA, E.den]
    refine ⟨?_, trivial⟩
    simp only [update_apply]; simp [a20]
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast (by omega))).mono
    (fun v1 ⟨e1, b1⟩ => ?_) le_rfl
  subst e1
  refine ⟨?_, ?_, ?_, ?_, ?_, b1⟩
  · simp only [pA6, runA, E.den]; simp [update_apply, a20]
  · simp [pA6, runA, update_apply, a10]
  · simp [pA6, runA, update_apply, a11]
  · simp [pA6, runA, update_apply]
  · intro j b7 b10 b11 b12
    simp [pA6, runA, update_apply, b7, b12, aF j b10 b11 b12]

end J6Seg.PJ

