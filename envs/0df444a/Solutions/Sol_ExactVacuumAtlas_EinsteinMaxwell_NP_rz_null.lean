variable {U : Set (Pt 4)} {g0 gi0 : Metric 4} {F0 f : TwoForm 4} {E0 Θ0 B : Fin 4 → Fin 4 → Pt 4 → ℂ}
  {h : Metric 4}
variable (hN : NullFrameData g0 gi0 E0 Θ0 U) (ht : RealFrameTangent g0 E0 U h f B)
include hN ht
theorem solution (hR0 : RealPattern E0 U) (ε : ℝ) :
    NullFrameData (rzG U g0 E0 Θ0 B ε) (rzGI U gi0 E0 B ε) (rzE E0 B ε) (rzTh U E0 Θ0 B ε)
      {y | (ε, y) ∈ rzW U E0 B} where
  metric :=
    { isOpen := isOpen_slice (isOpen_rzW hN ht) ε
      symm := fun y hy i j => by simp only [rzG, hy.1, if_true, rzGc_symm y i j]
      inv := fun y hy => rz_inv hN ht (p := (ε, y)) hy hR0
      smooth := fun i j => slice_of_jointR (Φ := fun ε y => rzG U g0 E0 Θ0 B ε i j y)
        (contDiffOn_rzG_joint hN ht i j) ε
      smooth_inv := fun i j => slice_of_jointR (Φ := fun ε y => rzGI U gi0 E0 B ε i j y)
        (contDiffOn_rzGI_joint hN ht i j) ε }
  smooth_E := fun A μ => slice_of_joint (Φ := fun ε y => rzE E0 B ε A μ y) (contDiffOn_rzE_joint hN ht A μ) ε
  smooth_Θ := fun A μ => slice_of_joint (Φ := fun ε y => rzTh U E0 Θ0 B ε A μ y)
    (contDiffOn_rzTh_joint hN ht A μ) ε
  dual := fun y hy => by
    rw [coMat_rzTh hy.1]
    exact Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hy.2)
  gram := fun y hy => rz_gram hN ht (p := (ε, y)) hy hR0
