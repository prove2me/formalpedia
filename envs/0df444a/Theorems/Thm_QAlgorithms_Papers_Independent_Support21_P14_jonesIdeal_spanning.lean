-- title:
--   Jones ideal spanning by the preceding generator image
-- statement:
--   Let $r\ge1$, and let $S$ be a commutative unital ground ring with units $\rho,q,\delta_0,u_1,\ldots,u_r$, parameters $\delta_a\in S$ for $a\ge0$, and
--   $$\rho^{-1}-\rho=(q^{-1}-q)(\delta_0-1).$$
--   Write $W_n=W_{n,S,r}(u_1,\ldots,u_r)$ for the cyclotomic BMW algebra of Definitions 2.1 and 2.8, with affine generator $y_1$ and tangle generators $e_i$.
--
--   For $n\ge1$, let $I_{n+1}$ be the two-sided ideal in $W_{n+1}$ generated by $e_n$, and let $\iota_n(W_n)$ denote the canonical image of the preceding generator algebra. Then
--   $$I_{n+1}=\operatorname{span}_S\{a e_n b:a,b\in\iota_n(W_n)\}.$$
--   The right side permits finite sums of such products. This is the Jones ideal spanning assertion, before injectivity of the canonical tower homomorphism is known.
-- source:
--   Cyclotomic Birman--Wenzl--Murakami algebras, II: Admissibility Relations and Freeness, arXiv:math/0612065v5, PDF p. 32, Lemma 4.1: Jones ideal spanning

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P14

noncomputable section

open scoped BigOperators Classical

namespace QAlgorithms.Papers.Independent.Support21.P14

/-- Lemma 4.1, PDF pp.32--33. Canonical lower-level generator image is
used before injectivity of the tower map has been established. -/
theorem jonesIdeal_spanning {S : Type*} [CommRing S] {r : ℕ}
    (P : GroundParameters S r) (n : ℕ) (hn : 1 ≤ n) :
    jonesIdeal P (n+1) = Submodule.span S
      {z : BMW P (n+1) | ∃ a ∈ bmwLevelImage P (n+1) n,
        ∃ b ∈ bmwLevelImage P (n+1) n, z = a * bmwE P (n+1) (n-1) * b} := by sorry

end QAlgorithms.Papers.Independent.Support21.P14

end
