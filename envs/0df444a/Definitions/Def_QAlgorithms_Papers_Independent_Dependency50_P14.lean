-- title:
--   Definitions for Lie-Semigroup Structures for Reachability and Control of Open Quantum Systems
-- statement:
--   The objects the formalized statements of *Lie-Semigroup Structures for Reachability and Control of Open Quantum Systems* (arXiv:0811.3906) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `Super`: PDF p.7: finite-dimensional complexified superoperators.
--   - `InvertibleSuper`: PDF p.7: the invertible group; singular boundary channels are excluded.
--   - `groupExp`: PDF pp.3,7: exponential into InvertibleSuper with its actual exponential value.
--   - `invertibleChannels`: PDF p.7: invertible CPTP maps, using the accepted CP predicate.
--   - `channelComponent`: PDF p.7: identity component relative to invertible channels.
--   - `tangent`: PDF p.2: one-sided smooth-curve tangent cone. This is not defined by exponentials. Smoothness and the derivative are over ℝ, including the one-sided derivative at zero.
--   - `IsClosedCone`: PDF p.2: closed convex cone, with zero and nonnegative real multiples.
--   - `edge`: PDF pp.2–3: edge w ∩ (−w).
--   - `IsLieWedge`: PDF pp.2–3: Lie wedges are invariant under exponential conjugation by their edge.
--   - `generatedExponentials`: PDF p.3: monoid generated by exponentials, before closure.
--   - `IsLieSubsemigroup`: PDF p.3: closed unital multiplicative semigroup generated, up to relative closure, by exponentials of its independently defined curve tangent cone.
--   - `IsGlobalLieWedge`: PDF p.3: a Lie wedge with an actual realizing Lie subsemigroup.
--   - `markovSemigroup`: PDF p.8, Eq.(17): relative closure of the entire generated monoid.
--   - `left`: PDF pp.6–7: continuous left multiplication.
--   - `right`: PDF pp.6–7: continuous right multiplication.
--   - `hamiltonianGenerator`: PDF p.7, Eq.(14): forward Hamiltonian generator −i[H,·].
--   - `relaxationGenerator`: PDF p.7, Eq.(13): Γ is minus the sum of the imported forward single-jump `dissipator` actions. This adapter adds finite summation and continuous linearity; it preserves arbitrary complex jumps and the source's positive-Γ sign.
--   - `gklsGenerators`: PDF p.7, Eq.(14): actual forward GKLS generators −L.
--   - `IsGeneratorTrajectory`: PDF pp.5–8: piecewise-continuous finite-time evolution from I. Generators have continuous extensions on each closed segment; the ODE holds inside segments, allowing switching jumps. The empty partition represents time zero.
--   - `timeDependentMarkovian`: PDF p.8: ordinary time-dependent Markovian endpoints, before closure.
--   - `IsDivisible`: PDF p.4: every element has roots of every positive integer order.
--   - `IsExponential`: PDF p.3: exponential subsets contain the entire corresponding short arc.
--   - `HasLocalBasis`: PDF pp.3–4: an entire relative identity-neighborhood basis.
--   - `IsLocallyDivisible`: PDF p.4: local divisibility means a basis of divisible subsets.
--   - `IsLocallyExponential`: PDF p.3: local exponentiality means a basis of exponential subsets.
--   - `bchTerm`: PDF p.2: logarithm-series terms for the local BCH product log(exp A exp B).
--   - `IsLieSemialgebra`: PDF p.2, Eq.(2): local BCH compatibility. The norm domain and summability are explicit, so divergent default-valued tsums never decide membership.
--   - `UnitalControl`: PDF pp.10–11: unital data, with u ranging over all ℝ^m. The Hamiltonians are Hermitian traceless, implementing iH ∈ su(N), not the printed H ∈ su(N).
--   - `controlGenerator`: PDF pp.6,10, Eqs.(8),(19): the forward generator −L_u.
--   - `controlSemigroup`: PDF p.7, Eq.(12): exact finite products of constant-control segments.
--   - `adjointSU`: PDF pp.10–12: special-unitary adjoint action. The full unital complexified map is determined by its restriction to her_0(N).
--   - `adjointLieAlgebra`: PDF pp.10–12: ad_su(N), extended by zero on scalar matrices.
--   - `IsPositiveHomogeneous`: PDF pp.10–12: a real endomorphism of her_0(N), complexified and extended by zero on I, with genuine Hilbert–Schmidt self-adjointness and nonnegative quadratic form.
--   - `coneSemigroup`: PDF p.11: exp(−c) Ad_SU(N), as an actual subset of InvertibleSuper.
--   - `coneWedge`: PDF p.11: the sum (−c) + ad_su(N); directness is also asserted below.
-- source:
--   Lie-Semigroup Structures for Reachability and Control of Open Quantum Systems, arXiv:0811.3906v4, https://arxiv.org/abs/0811.3906v4

import Mathlib
import Definitions.Def_QAlgorithms_Defs_MatrixMapPositivity
import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P59

/-!
Statements from arXiv:0811.3906v4. Closures are relative to invertible
superoperators. Complex-linear extensions encode the real maps on Hermitian
matrices, as in the source's complexification on PDF p.7.
-/

noncomputable section

open scoped Matrix ComplexConjugate ComplexOrder Matrix.Norms.L2Operator Topology

namespace QAlgorithms.Papers.Independent.Dependency50.P14

-- Reuse the pinned matrix space and single-jump action; do not redeclare them.
open QAlgorithms.Papers.Independent.Information100.P59 (Operator dissipator)

/-- PDF p.7: finite-dimensional complexified superoperators. -/
abbrev Super (N : ℕ) := Operator N →L[ℂ] Operator N

/-- PDF p.7: the invertible group; singular boundary channels are excluded. -/
abbrev InvertibleSuper (N : ℕ) := (Super N)ˣ

/-- PDF pp.3,7: exponential into InvertibleSuper with its actual exponential value. -/
def groupExp {N : ℕ} (A : Super N) : InvertibleSuper N :=
  (NormedSpace.isUnit_exp_of_mem_ball (𝕂 := ℂ) (x := A)
    ((NormedSpace.expSeries_radius_eq_top ℂ (Super N)).symm ▸ edist_lt_top _ _)).unit

/-- PDF p.7: invertible CPTP maps, using the accepted CP predicate. -/
def invertibleChannels (N : ℕ) : Set (InvertibleSuper N) :=
  {g | QAlgorithms.Entanglement.IsCompletelyPositive
      ((g : Super N).toLinearMap) ∧
    ∀ X : Operator N, ((g : Super N) X).trace = X.trace}

/-- PDF p.7: identity component relative to invertible channels. -/
def channelComponent (N : ℕ) : Set (InvertibleSuper N) :=
  connectedComponentIn (invertibleChannels N) 1

/-- PDF p.2: one-sided smooth-curve tangent cone. This is not defined by exponentials.
Smoothness and the derivative are over ℝ, including the one-sided derivative at zero. -/
def tangent {N : ℕ} (S : Set (InvertibleSuper N)) : Set (Super N) :=
  {A | ∃ curve : ℝ → Super N,
    curve 0 = 1 ∧ ContDiffOn ℝ ⊤ curve (Set.Ici 0) ∧
    (∀ t : ℝ, 0 ≤ t → ∃ g ∈ S, curve t = (g : Super N)) ∧
    HasDerivWithinAt curve A (Set.Ici 0) 0}

/-- PDF p.2: closed convex cone, with zero and nonnegative real multiples. -/
def IsClosedCone {N : ℕ} (w : Set (Super N)) : Prop :=
  IsClosed w ∧ Convex ℝ w ∧ (0 : Super N) ∈ w ∧
    (∀ A ∈ w, ∀ t : ℝ, 0 ≤ t → t • A ∈ w) ∧
    (∀ A ∈ w, ∀ B ∈ w, A + B ∈ w)

/-- PDF pp.2–3: edge w ∩ (−w). -/
def edge {N : ℕ} (w : Set (Super N)) : Set (Super N) :=
  {A | A ∈ w ∧ -A ∈ w}

/-- PDF pp.2–3: Lie wedges are invariant under exponential conjugation by their edge. -/
def IsLieWedge {N : ℕ} (w : Set (Super N)) : Prop :=
  IsClosedCone w ∧ ∀ H ∈ edge w,
    (fun A => NormedSpace.exp H * A * NormedSpace.exp (-H)) '' w = w

/-- PDF p.3: monoid generated by exponentials, before closure. -/
def generatedExponentials {N : ℕ} (w : Set (Super N)) : Set (InvertibleSuper N) :=
  (Submonoid.closure (groupExp '' w) : Set (InvertibleSuper N))

/-- PDF p.3: closed unital multiplicative semigroup generated, up to relative closure,
by exponentials of its independently defined curve tangent cone. -/
def IsLieSubsemigroup {N : ℕ} (S : Set (InvertibleSuper N)) : Prop :=
  IsClosed S ∧ (1 : InvertibleSuper N) ∈ S ∧
    (∀ g ∈ S, ∀ h ∈ S, g * h ∈ S) ∧
    S = closure (generatedExponentials (tangent S))

/-- PDF p.3: a Lie wedge with an actual realizing Lie subsemigroup. -/
def IsGlobalLieWedge {N : ℕ} (w : Set (Super N)) : Prop :=
  IsLieWedge w ∧ ∃ S : Set (InvertibleSuper N), IsLieSubsemigroup S ∧ tangent S = w

/-- PDF p.8, Eq.(17): relative closure of the entire generated monoid. -/
def markovSemigroup (N : ℕ) : Set (InvertibleSuper N) :=
  closure (generatedExponentials (tangent (channelComponent N)))

/-- PDF pp.6–7: continuous left multiplication. -/
def left {N : ℕ} (H : Operator N) : Super N :=
  ContinuousLinearMap.mul ℂ (Operator N) H

/-- PDF pp.6–7: continuous right multiplication. -/
def right {N : ℕ} (H : Operator N) : Super N :=
  (ContinuousLinearMap.mul ℂ (Operator N)).flip H

/-- PDF p.7, Eq.(14): forward Hamiltonian generator −i[H,·]. -/
def hamiltonianGenerator {N : ℕ} (H : Operator N) : Super N :=
  (-Complex.I) • (left H - right H)

/-- PDF p.7, Eq.(13): Γ is minus the sum of the imported forward single-jump
`dissipator` actions. This adapter adds finite summation and continuous linearity;
it preserves arbitrary complex jumps and the source's positive-Γ sign. -/
def relaxationGenerator {N r : ℕ} (V : Fin r → Operator N) : Super N :=
  -(∑ j, LinearMap.toContinuousLinearMap
    ({ toFun := dissipator (V j)
       map_add' X Y := by
         simp only [dissipator, Matrix.mul_add, Matrix.add_mul, smul_add]
         abel
       map_smul' a X := by
         simp [dissipator, smul_sub, smul_add, smul_smul, mul_comm]
     } : Operator N →ₗ[ℂ] Operator N))

/-- Sanity: the continuous adapter has exactly the negative summed imported action. -/
example {N r : ℕ} (V : Fin r → Operator N) (X : Operator N) :
    relaxationGenerator V X = -∑ j, dissipator (V j) X := by
  simp [relaxationGenerator]

/-- PDF p.7, Eq.(14): actual forward GKLS generators −L. -/
def gklsGenerators (N : ℕ) : Set (Super N) :=
  {A | ∃ (H : Operator N) (r : ℕ) (V : Fin r → Operator N),
    H.IsHermitian ∧ A = hamiltonianGenerator H - relaxationGenerator V}

/-- PDF pp.5–8: piecewise-continuous finite-time evolution from I.
Generators have continuous extensions on each closed segment; the ODE holds inside
segments, allowing switching jumps. The empty partition represents time zero. -/
def IsGeneratorTrajectory {N : ℕ} (W : Set (Super N)) (T : ℝ)
    (X : ℝ → Super N) : Prop :=
  0 ≤ T ∧ X 0 = 1 ∧ ContinuousOn X (Set.Icc 0 T) ∧
    (∀ t ∈ Set.Icc (0 : ℝ) T, IsUnit (X t)) ∧
    ∃ (r : ℕ) (times : Fin (r + 1) → ℝ) (B : Fin r → ℝ → Super N),
      times 0 = 0 ∧ times (Fin.last r) = T ∧ StrictMono times ∧
      ∀ j : Fin r,
        ContinuousOn (B j) (Set.Icc (times j.castSucc) (times j.succ)) ∧
        (∀ t ∈ Set.Icc (times j.castSucc) (times j.succ), B j t ∈ W) ∧
        ∀ t ∈ Set.Ioo (times j.castSucc) (times j.succ),
          HasDerivAt X (B j t * X t) t

/-- PDF p.8: ordinary time-dependent Markovian endpoints, before closure. -/
def timeDependentMarkovian (N : ℕ) : Set (InvertibleSuper N) :=
  {g | g ∈ invertibleChannels N ∧ ∃ (T : ℝ) (X : ℝ → Super N),
    IsGeneratorTrajectory (gklsGenerators N) T X ∧ X T = (g : Super N)}

/-- PDF p.4: every element has roots of every positive integer order. -/
def IsDivisible {N : ℕ} (D : Set (InvertibleSuper N)) : Prop :=
  ∀ g ∈ D, ∀ r : ℕ, 0 < r → ∃ h ∈ D, h ^ r = g

/-- PDF p.3: exponential subsets contain the entire corresponding short arc. -/
def IsExponential {N : ℕ} (D : Set (InvertibleSuper N)) : Prop :=
  ∀ g ∈ D, ∃ A : Super N, groupExp A = g ∧
    ∀ t ∈ Set.Icc (0 : ℝ) 1, groupExp (t • A) ∈ D

/-- PDF pp.3–4: an entire relative identity-neighborhood basis. -/
def HasLocalBasis {N : ℕ} (S : Set (InvertibleSuper N)) (P : Set (InvertibleSuper N) → Prop) : Prop :=
  ∀ V : Set (InvertibleSuper N), IsOpen V → (1 : InvertibleSuper N) ∈ V →
    ∃ D : Set (InvertibleSuper N), D ⊆ S ∩ V ∧ P D ∧
      ∃ O : Set (InvertibleSuper N), IsOpen O ∧ (1 : InvertibleSuper N) ∈ O ∧ S ∩ O ⊆ D

/-- PDF p.4: local divisibility means a basis of divisible subsets. -/
def IsLocallyDivisible {N : ℕ} (S : Set (InvertibleSuper N)) : Prop :=
  HasLocalBasis S IsDivisible

/-- PDF p.3: local exponentiality means a basis of exponential subsets. -/
def IsLocallyExponential {N : ℕ} (S : Set (InvertibleSuper N)) : Prop :=
  HasLocalBasis S IsExponential

/-- PDF p.2: logarithm-series terms for the local BCH product log(exp A exp B). -/
def bchTerm {N : ℕ} (A B : Super N) (n : ℕ) : Super N :=
  (((-1 : ℂ) ^ n) / (n + 1 : ℂ)) •
    (NormedSpace.exp A * NormedSpace.exp B - 1) ^ (n + 1)

/-- PDF p.2, Eq.(2): local BCH compatibility. The norm domain and summability
are explicit, so divergent default-valued tsums never decide membership. -/
def IsLieSemialgebra {N : ℕ} (w : Set (Super N)) : Prop :=
  IsClosedCone w ∧ ∃ radius : ℝ, 0 < radius ∧
    ∀ A ∈ w, ∀ B ∈ w, ‖A‖ < radius → ‖B‖ < radius →
      ‖NormedSpace.exp A * NormedSpace.exp B - 1‖ < 1 ∧
      Summable (bchTerm A B) ∧ (∑' n : ℕ, bchTerm A B n) ∈ w

/-- PDF pp.10–11: unital data, with u ranging over all ℝ^m. The Hamiltonians are
Hermitian traceless, implementing iH ∈ su(N), not the printed H ∈ su(N). -/
structure UnitalControl (N m : ℕ) where
  drift : Operator N
  control : Fin m → Operator N
  drift_hermitian : drift.IsHermitian
  drift_traceless : drift.trace = 0
  control_hermitian : ∀ j, (control j).IsHermitian
  control_traceless : ∀ j, (control j).trace = 0
  jumpCount : ℕ
  jumps : Fin jumpCount → Operator N
  unital : relaxationGenerator jumps 1 = 0

/-- PDF pp.6,10, Eqs.(8),(19): the forward generator −L_u. -/
def controlGenerator {N m : ℕ} (D : UnitalControl N m) (u : Fin m → ℝ) : Super N :=
  hamiltonianGenerator (D.drift + ∑ j, (u j : ℂ) • D.control j) -
    relaxationGenerator D.jumps

/-- PDF p.7, Eq.(12): exact finite products of constant-control segments. -/
def controlSemigroup {N m : ℕ} (D : UnitalControl N m) : Set (InvertibleSuper N) :=
  (Submonoid.closure {g | ∃ (t : ℝ) (u : Fin m → ℝ),
    0 ≤ t ∧ g = groupExp (t • controlGenerator D u)} : Set (InvertibleSuper N))

/-- PDF pp.10–12: special-unitary adjoint action. The full unital complexified map
is determined by its restriction to her_0(N). -/
def adjointSU (N : ℕ) : Set (InvertibleSuper N) :=
  {g | ∃ U : Operator N, Uᴴ * U = 1 ∧ U * Uᴴ = 1 ∧ U.det = 1 ∧
    ∀ X : Operator N, (g : Super N) X = U * X * Uᴴ}

/-- PDF pp.10–12: ad_su(N), extended by zero on scalar matrices. -/
def adjointLieAlgebra (N : ℕ) : Set (Super N) :=
  {A | ∃ H : Operator N, H.IsHermitian ∧ H.trace = 0 ∧
    A = hamiltonianGenerator H}

/-- PDF pp.10–12: a real endomorphism of her_0(N), complexified and extended by
zero on I, with genuine Hilbert–Schmidt self-adjointness and nonnegative quadratic form. -/
def IsPositiveHomogeneous {N : ℕ} (A : Super N) : Prop :=
  A 1 = 0 ∧ (∀ X : Operator N, (A X).trace = 0) ∧
    (∀ X : Operator N, X.IsHermitian → (A X).IsHermitian) ∧
    (∀ X Y : Operator N, X.IsHermitian → X.trace = 0 →
      Y.IsHermitian → Y.trace = 0 → (X * A Y).trace.re = (A X * Y).trace.re) ∧
    (∀ X : Operator N, X.IsHermitian → X.trace = 0 → 0 ≤ (X * A X).trace.re)

/-- PDF p.11: exp(−c) Ad_SU(N), as an actual subset of InvertibleSuper. -/
def coneSemigroup {N : ℕ} (c : Set (Super N)) : Set (InvertibleSuper N) :=
  {g | ∃ C ∈ c, ∃ k ∈ adjointSU N, g = groupExp (-C) * k}

/-- PDF p.11: the sum (−c) + ad_su(N); directness is also asserted below. -/
def coneWedge {N : ℕ} (c : Set (Super N)) : Set (Super N) :=
  {A | ∃ C ∈ c, ∃ K ∈ adjointLieAlgebra N, A = -C + K}

/-! Sanity examples pin local definitions without proving source results. -/

example {N : ℕ} : groupExp (0 : Super N) = 1 := by
  apply Units.ext
  simp [groupExp, IsUnit.unit_spec, NormedSpace.exp_zero]

example {N : ℕ} (w : Set (Super N)) : (1 : InvertibleSuper N) ∈ generatedExponentials w :=
  (Submonoid.closure (groupExp '' w)).one_mem

example {N : ℕ} : hamiltonianGenerator (0 : Operator N) = 0 := by
  simp [hamiltonianGenerator, left, right]

example {N : ℕ} (V : Fin 0 → Operator N) : relaxationGenerator V = 0 := by
  simp [relaxationGenerator]

example {N : ℕ} (w : Set (Super N)) (A : Super N) :
    A ∈ edge w ↔ A ∈ w ∧ -A ∈ w := Iff.rfl

example {N : ℕ} : (1 : InvertibleSuper N) ∈ invertibleChannels N := by
  constructor
  · intro r X hX
    change X.PosSemidef
    exact hX
  · intro X
    rfl

/-- Time-zero sanity check: no control segments and the identity endpoint. -/
example {N : ℕ} :
    IsGeneratorTrajectory (Set.univ : Set (Super N)) 0 (fun _ => 1) := by
  refine ⟨le_rfl, rfl, continuous_const.continuousOn, ?_,
    0, (fun _ => 0), (fun j => Fin.elim0 j), rfl, rfl, ?_, ?_⟩
  · intro t ht
    exact isUnit_one
  · intro a b hab
    have heq : a = b := (Fin.eq_zero a).trans (Fin.eq_zero b).symm
    subst b
    exact (lt_irrefl _ hab).elim
  · intro j
    exact Fin.elim0 j

end QAlgorithms.Papers.Independent.Dependency50.P14


