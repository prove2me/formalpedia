-- title:
--   The space $\mathcal W_\kappa(\Omega)=\mathcal W\times\Lambda_\kappa$ of coloured graphons with the cut-norm $\times$ weak-* topology
-- statement:
--   Fix a probability space $(\Omega,\mathcal F,\mu)$ and $\kappa\ge1$. Let $\mathcal W$ be the set of graphons on $\Omega$ and $\Lambda_\kappa$ the set of $\kappa$-colourings $\Psi:\Omega\to\Delta_\kappa$, regarded as a subset of $(L^\infty(\Omega,\mu))^\kappa$. The space of $\kappa$-coloured graphons on $\Omega$ is
--   $$
--   \mathcal W_\kappa(\Omega)=\mathcal W\times\Lambda_\kappa ,
--   $$
--   with the product topology, where $\mathcal W$ carries the topology of the cut norm $\|W_1-W_2\|_\square$ and $\Lambda_\kappa$ the weak-* topology, generated by the maps $\Psi\mapsto\int_\Omega\psi_\ell\,g\,d\mu$ for $\ell\in[\kappa]$ and $g\in L^1(\Omega,\mu)$.
--
--   This is the topology in which Theorem 2.20 asserts that the map from coloured graphons to coloured graph limits is continuous, and a quotient map when $\Omega=[0,1]$.
--
--   **Formalization Note** `KGraphon μ κ` is a structure holding a graphon `W` and a colouring `Ψ` with their defining properties. The cut-norm topology is generated by the balls $\{q:\|W_q-W_p\|_\square<r\}$ (the base `cutNorm`), which form a basis of the pseudometric topology; the weak-* topology is the coarsest one making $q\mapsto\int\psi_{q,\ell}\,g\,d\mu$ continuous for every integrable $g$; the product topology is the infimum of the two. Points are functions rather than a.e.-classes; both topologies see only a.e.-classes, so no continuity or quotient statement changes.
-- source:
--   Janson, Lo, McDiarmid, Skeja, Skerman, Graphon Colourings and Limits of Graph Partitions, arXiv:2610.38599 (held version, sha256 3d198813a65d248922299a3380e10f238dbc5dcd3be060f7810b462bd5d3d10f), §2.4, p.12

import Mathlib
import Definitions.Def_GraphonCheeger_cutDist
import Definitions.Def_GraphonCheeger_Supplement_homDens

open MeasureTheory

set_option warn.classDefReducibility false

namespace GraphonCheeger.Supplement

/-!
# The space `W_κ(Ω) = W × Λ_κ` of coloured graphons on a fixed probability space, with the
product of the cut-norm and the weak-* topologies

Janson, Lo, McDiarmid, Skeja, Skerman, *Graphon Colourings and Limits of Graph Partitions*,
arXiv:2610.38599 (held version, sha256 3d198813…), §2.4, p.12.

**Formalization Note.**
* `KGraphon μ κ` is the set of pairs `(W, Ψ)` of a graphon (base `IsGraphon`) and a
  `κ`-colouring (`IsKColouring`) on `(Ω, µ)`, as a structure so that it carries only the topology
  below.
* The cut-norm topology on graphons is the topology of the pseudometric
  `(W₁, W₂) ↦ ‖W₁ − W₂‖_□` (base `cutNorm`, (A.3)), written as the topology generated by its open
  balls (which form a basis of the pseudometric topology).
* The weak-* topology on `Λ_κ ⊂ (L^∞(Ω, µ))^κ` is the coarsest topology making every map
  `Ψ ↦ ∫ ψ_ℓ g dµ` continuous, for `ℓ ∈ [κ]` and integrable `g` (`g ∈ L¹(Ω, µ)`), as on p.12.
* The product topology on `W × Λ_κ` is the infimum of the two topologies pulled back along the
  projections. Points are functions, not a.e.-classes; both topologies only see a.e.-classes, so
  this changes no continuity or quotient statement.
-/

universe u

/-- A `κ`-coloured graphon `(W, Ψ)` on the probability space `(Ω, µ)`: an element of
`W_κ(Ω) = W × Λ_κ` (§2.4, p.12). -/
structure KGraphon {Ω : Type u} [MeasurableSpace Ω] (μ : Measure Ω) (κ : ℕ) where
  /-- The graphon `W`. -/
  W : Ω → Ω → ℝ
  /-- The colouring `Ψ = (ψ_ℓ)_ℓ`. -/
  Ψ : Ω → Fin κ → ℝ
  isGraphon : IsGraphon W
  isColouring : IsKColouring Ψ

variable {Ω : Type u} [MeasurableSpace Ω]

/-- The cut-norm topology on the graphon component (§2.4 with (A.3)): generated by the balls
`{q : ‖W_q − W_p‖_□ < r}`, `r > 0`. -/
def cutNormTop (μ : Measure Ω) (κ : ℕ) : TopologicalSpace (KGraphon μ κ) :=
  TopologicalSpace.generateFrom {U | ∃ (p : KGraphon μ κ) (r : ℝ), 0 < r ∧
    U = {q | cutNorm μ (fun x y => q.W x y - p.W x y) < r}}

/-- The weak-* topology on the colouring component (§2.4, p.12): the coarsest topology making
`(W, Ψ) ↦ ∫ ψ_ℓ g dµ` continuous for every `ℓ ∈ [κ]` and every integrable `g`. -/
noncomputable def weakStarTop (μ : Measure Ω) (κ : ℕ) : TopologicalSpace (KGraphon μ κ) :=
  ⨅ (ℓ : Fin κ) (g : {g : Ω → ℝ // Integrable g μ}),
    TopologicalSpace.induced (fun q : KGraphon μ κ => ∫ x, q.Ψ x ℓ * g.1 x ∂μ) inferInstance

/-- The topology of `W_κ(Ω) = W × Λ_κ` (§2.4, p.12): the product of the cut-norm topology and
the weak-* topology. -/
noncomputable instance instTopologicalSpaceKGraphon (μ : Measure Ω) (κ : ℕ) :
    TopologicalSpace (KGraphon μ κ) :=
  cutNormTop μ κ ⊓ weakStarTop μ κ

end GraphonCheeger.Supplement


