    B (d + 1) r (by omega : 0 < B) hr
    ((d : ℤ) - jExp 0 (B : ℤ) (r : ℤ)) hlow
  rw [hcorr]
  by_cases heq : jExp 0 (B : ℤ) (r : ℤ) = (d : ℤ)
  · simp [heq]
  · have htne : (d : ℤ) - jExp 0 (B : ℤ) (r : ℤ) ≠ 0 := by omega
