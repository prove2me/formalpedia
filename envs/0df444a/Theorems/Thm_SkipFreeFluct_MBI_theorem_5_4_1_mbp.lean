-- title:
--   Theorem 5.4(1), MBP case, p. 15 — $G(x,y)=\frac1y\big(s_0^xW(y-1)-W(y-x-1)\big)$
-- statement:
--   Let $(X,\mathbb P)$ be a Markov branching process (MBP), i.e. an MBI with parameters $(\alpha,\mu,p,\beta,\nu,q)$ and $\beta=q=0$, on $E=\{0,1,2,\dots\}$ with Q-matrix (5.1). Let $s_0$ be the smallest positive root of the branching mechanism $\psi$, let $W$ be the sequence of Lemma 5.1, extended by $W(z)=0$ for $z\le-1$, and let $G$ be the resolvent of $X$. Then for every $x\ge0$ and $y\ge1$, $G(x,y)<\infty$ and
--   $$G(x,y)=\frac1y\Big(s_0^x\,W(y-1)-W(y-x-1)\Big).$$
--
--   This is the MBP half of Theorem 5.4(1). In an MBP the state $0$ is absorbing (so not all states are transient), but the resolvent is still finite at every $y\ge1$ and has this closed form.
--
--   **Formalization Note** The MBI is the chain generated by `mbiQ P` on `Set.Ici (0 : ℤ)`; the resolvent is the $[0,\infty]$-valued `resolvent`, whose finiteness is asserted before converting to a real number; MBP means `IsMBP P`, i.e. $\beta=q=0$; $W(y-1)$ uses the natural-number sequence `W P` (here $y\ge1$), and $W(y-x-1)$ uses `Wz P` on $\mathbb Z$.
-- source:
--   Loeffen, Patie, Wang, Fluctuation Theory of Continuous-Time, Skip-Free Downward Markov Chains with Applications to Branching Processes with Immigration, arXiv:2208.14425v1, pp. 15–16, Theorem 5.4(1), second display (MBP case)

import Mathlib
import Definitions.Def_SkipFreeFluct_MBI_Chain
import Definitions.Def_SkipFreeFluct_MBI_Model
open scoped ENNReal Topology
open Filter MeasureTheory

namespace SkipFreeFluct.MBI

theorem theorem_5_4_1_mbp (P : MBIParams) (hP : P.Valid) :
    IsMBP P → ∀ x y : ℕ, 1 ≤ y →
      resolvent (Set.Ici 0) (mbiQ P) x y ≠ ⊤ ∧
      (resolvent (Set.Ici 0) (mbiQ P) x y).toReal =
        1 / y * (s0 P ^ x * W P (y - 1) - Wz P ((y : ℤ) - x - 1)) := by sorry

end SkipFreeFluct.MBI
