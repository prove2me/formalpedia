lemma root_le_iff (N m x : ℕ) (hm : 1 ≤ m) :
    (x : ℝ) ≤ (N : ℝ) ^ ((1 : ℝ) / m) ↔ x ^ m ≤ N := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  rw [one_div, Real.le_rpow_inv_iff_of_pos (Nat.cast_nonneg _) (Nat.cast_nonneg _) hm',
    Real.rpow_natCast]
  exact_mod_cast Iff.rfl

theorem floor_root_spec (N m : ℕ) (hm : 1 ≤ m) :
    ⌊(N : ℝ) ^ ((1 : ℝ) / m)⌋₊ ^ m ≤ N ∧ N < (⌊(N : ℝ) ^ ((1 : ℝ) / m)⌋₊ + 1) ^ m := by
  set x := ⌊(N : ℝ) ^ ((1 : ℝ) / m)⌋₊
  refine ⟨(root_le_iff N m x hm).1 (Nat.floor_le (by positivity)), ?_⟩
  by_contra h
  push Not at h
  have h3 := (root_le_iff N m (x + 1) hm).2 h
  have h4 := Nat.lt_floor_add_one ((N : ℝ) ^ ((1 : ℝ) / m))
  push_cast at h3
  linarith

