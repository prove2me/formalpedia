theorem solution (M : MulSpec) (N e W : ℕ) (s : IState HS) (Z : List (ℤ × ℤ)) (RK LN LR : List Item)
    (hZl : Z.length = N * 2 ^ e) (hK : s.G KO = gints Z ++ RK) (hN : s.G NN = .int (N : ℤ) :: LN)
    (hR : s.G KR = .int ((2 ^ e : ℕ) : ℤ) :: LR)
    (hZW : ∀ p ∈ Z, zsz p.1 ≤ W ∧ zsz p.2 ≤ W) (hNW : zsz ((N * 2 ^ e : ℕ) : ℤ) ≤ W)
    (hNW1 : zsz (N : ℤ) ≤ W) (heW : e + 1 ≤ W) :
    Spec M mvPairs s ((s.upd KO RK).upd OUT (gints Z.reverse ++ s.G OUT))
      (8000 * (W + 2) + N * 2 ^ e * (40000 * (W + 2)) + 32) := by
  have e1 := NLogN.IState.top_eq hN
  have e2 := NLogN.IState.top_eq hR
  have cv : NLogN.FW.cntE.eval s = ((N * 2 ^ e : ℕ) : ℤ) := by simp [NLogN.FW.cntE, NLogN.Ex.eval, e1, e2]
  have H := NLogN.FW.rep_spec (M := M) (i := NLogN.FW.C0) (n := NLogN.FW.cntE) (b := NLogN.FW.mpBody) (s := s) (NLogN.FW.mpSt Z s RK) (N * 2 ^ e)
    cv (by simp (config := {decide := true}) [NLogN.FW.mpBody, NLogN.RM.seqL, NLogN.RM.writes, NLogN.RS.writes])
    (by simp only [NLogN.FW.mpSt, List.drop_zero, List.take_zero, List.reverse_nil, NLogN.gints_nil,
      List.nil_append]; rw [← hK]; simp)
    (fun k => by simp (config := {decide := true}) [NLogN.FW.mpSt, NLogN.IState.upd_G]) (by decide)
    (by intro i hi; simp [NLogN.FW.cntE, NLogN.Ex.regs] at hi
        rcases hi with rfl | rfl <;> simp (config := {decide := true}) [NLogN.zX_all])
    ⟨⟨LN, by rw [hN, e1]⟩, ⟨LR, by rw [hR, e2]⟩, e, by simp [NLogN.Ex.eval, e2]⟩ ⟨trivial, trivial⟩ W
    ⟨by simp only [NLogN.Ex.Bnd, e1]; exact hNW1,
      (by simp only [NLogN.Ex.Bnd, e2]; push_cast; exact (NLogN.FW.zsz_two_pow e).trans heW), by
      simp only [NLogN.Ex.eval, e1, e2]; rw [show (N : ℤ) * ((2 ^ e : ℕ) : ℤ) = ((N * 2 ^ e : ℕ) : ℤ) by
        push_cast; ring]; exact hNW⟩
    (30000 * (W + 2)) ?_
  · have e3 : NLogN.FW.mpSt Z s RK (N * 2 ^ e) = (s.upd NLogN.KO RK).upd NLogN.FW.OUT (NLogN.gints Z.reverse ++ s.G NLogN.FW.OUT) := by
      simp only [NLogN.FW.mpSt, List.drop_eq_nil_of_le (show Z.length ≤ N * 2 ^ e by omega),
        List.take_of_length_le (show Z.length ≤ N * 2 ^ e by omega), NLogN.gints_nil, List.nil_append]
    rw [e3] at H
    refine H.mono ?_
    have := Nat.mul_le_mul_left (N * 2 ^ e)
      (show 30000 * (W + 2) + 8000 * (W + 2) + 30 ≤ 40000 * (W + 2) by omega)
    simp only [NLogN.FW.cntE, NLogN.Ex.size]; omega
  intro k hk
  have hk' : k < Z.length := by omega
  obtain ⟨w1, w2⟩ := hZW _ (List.getElem_mem hk')
  set t := NLogN.withCtr NLogN.FW.C0 s (N * 2 ^ e) k (NLogN.FW.mpSt Z s RK k) with ht
  have tK : t.G NLogN.KO = .int Z[k].1 :: .int Z[k].2 :: (NLogN.gints (Z.drop (k + 1)) ++ RK) := by
    simp (config := {decide := true}) only [ht, NLogN.withCtr, NLogN.FW.mpSt, NLogN.IState.upd_G, if_true, if_false]
    rw [List.drop_eq_getElem_cons hk']; rfl
