  obtain ⟨j, hj⟩ := Sp.exists_eq _ hmax
  have hji : j = i := by
    by_contra hne
    exact e_notMem_nIdeal Sp i χ (hj ▸ Sp.mem_of_ne (fun h => hne h.symm))
  rw [← hj, hji]

