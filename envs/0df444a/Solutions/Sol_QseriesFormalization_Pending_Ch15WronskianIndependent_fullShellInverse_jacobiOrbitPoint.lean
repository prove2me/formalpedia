theorem oddAbsIndex_of_pos_odd (n : ℕ) :
    oddAbsIndex (2 * (n : ℤ) + 1) = n := by
  unfold oddAbsIndex
  have hnat : (2 * (n : ℤ) + 1).natAbs = 2 * n + 1 := by
    have hnatInt : (((2 * (n : ℤ) + 1).natAbs : ℕ) : ℤ) =
        2 * (n : ℤ) + 1 := by
      exact Int.natAbs_of_nonneg (by omega)
    omega
  rw [hnat]
  omega

theorem oddAbsIndex_of_neg_odd (n : ℕ) :
