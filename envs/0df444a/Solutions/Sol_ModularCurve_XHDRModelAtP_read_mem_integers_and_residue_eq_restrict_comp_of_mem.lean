  have key := ModularCurve.XHDRModelAtP.readA_mem_integers_and_residue_eq_restrict_comp_of_mem p M H hpM hpM2 hHp hj 𝔛 A hA ρ hρ θ Psp Rpd hwgen (bcOA ⁻¹ᵁ V) hgenV ((bcOA.app V).hom g)
