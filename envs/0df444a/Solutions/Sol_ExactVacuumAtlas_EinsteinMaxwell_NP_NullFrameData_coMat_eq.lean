open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
open ExactVacuumAtlas.EinsteinMaxwell.NP.NullFrameData
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
theorem solution (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) :
    coMat Θ x = etaNull * (frMat E x)ᵀ * cmat g x := by
  have hL : (etaNull * (frMat E x)ᵀ * cmat g x) * frMat E x = 1 := by
    have := hN.gram x hx
    unfold gramM at this
    rw [Matrix.mul_assoc, Matrix.mul_assoc, ← Matrix.mul_assoc (frMat E x)ᵀ, this, etaNull_mul_self]
  have hR : frMat E x * (etaNull * (frMat E x)ᵀ * cmat g x) = 1 := mul_eq_one_comm.mp hL
  calc coMat Θ x = coMat Θ x * (frMat E x * (etaNull * (frMat E x)ᵀ * cmat g x)) := by rw [hR, Matrix.mul_one]
    _ = etaNull * (frMat E x)ᵀ * cmat g x := by rw [← Matrix.mul_assoc, hN.dual x hx, Matrix.one_mul]
