theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (m : ℕ) (hm : 3 ≤ m) (ℓ : ℕ)
    (ι : Type) [Preorder ι] [Nonempty ι] [IsDirected ι (· ≤ ·)]
    (S : ι → Type) [∀ i, CommRing (S i)]
    (t : ∀ i j, i ≤ j → (S i →+* S j))
    (ht₁ : ∀ i (h : i ≤ i), t i i h = RingHom.id (S i))
    (ht₂ : ∀ i j k (hij : i ≤ j) (hjk : j ≤ k), (t j k hjk).comp (t i j hij) = t i k (hij.trans hjk))
    (L : Type) [CommRing L] (c : ∀ i, S i →+* L)
    (hc : ∀ i j (h : i ≤ j), (c j).comp (t i j h) = c i)
    (hcsurj : ∀ x : L, ∃ (i : ι) (y : S i), c i y = x)
    (hcker : ∀ (i : ι) (y z : S i), c i y = c i z → ∃ (j : ι) (h : i ≤ j), t i j h y = t i j h z)
    (hNL : IsUnit ((N : ℕ) : L)) (hmL : IsUnit ((m : ℕ) : L)) (hℓL : IsUnit ((ℓ : ℕ) : L)) :
    (∀ (i : ι) (v w : FakeEllipticCurve.WithFullLevel Λ N m (S i)) (Cv : v.1.ExtraLevel ℓ) (Cw : w.1.ExtraLevel ℓ)
        (v' w' : FakeEllipticCurve.WithFullLevel Λ N m L) (Cv' : v'.1.ExtraLevel ℓ) (Cw' : w'.1.ExtraLevel ℓ)
        (gv : v'.1.A ⟶ v.1.A) (gw : w'.1.A ⟶ w.1.A),
        FakeEllipticCurve.IsPullbackVia (c i) v.1 v'.1 gv →
        (v'.2.P).1 ≫ gv = Spec.map (CommRingCat.ofHom (c i)) ≫ (v.2.P).1 →
        (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of L)) (P : SchemeHomOver t' v'.1.f),
          FactorsThrough Cv'.levK P → ∃ P₀ : T ⟶ Cv.K, P₀ ≫ Cv.levK = P.1 ≫ gv) →
        FakeEllipticCurve.IsPullbackVia (c i) w.1 w'.1 gw →
        (w'.2.P).1 ≫ gw = Spec.map (CommRingCat.ofHom (c i)) ≫ (w.2.P).1 →
        (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of L)) (P : SchemeHomOver t' w'.1.f),
          FactorsThrough Cw'.levK P → ∃ P₀ : T ⟶ Cw.K, P₀ ≫ Cw.levK = P.1 ≫ gw) →
        (∃ (e : v'.1.A ≅ w'.1.A) (he : e.hom ≫ w'.1.f = v'.1.f), FakeEllipticCurve.WithFullLevel.IsoTVia v' w' Cv' Cw' e he) →
        ∃ (j : ι) (h : i ≤ j) (vj wj : FakeEllipticCurve.WithFullLevel Λ N m (S j))
          (Cvj : vj.1.ExtraLevel ℓ) (Cwj : wj.1.ExtraLevel ℓ) (gvj : vj.1.A ⟶ v.1.A) (gwj : wj.1.A ⟶ w.1.A),
          FakeEllipticCurve.IsPullbackVia (t i j h) v.1 vj.1 gvj ∧
          (vj.2.P).1 ≫ gvj = Spec.map (CommRingCat.ofHom (t i j h)) ≫ (v.2.P).1 ∧
          (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (S j))) (P : SchemeHomOver t' vj.1.f),
            FactorsThrough Cvj.levK P → ∃ P₀ : T ⟶ Cv.K, P₀ ≫ Cv.levK = P.1 ≫ gvj) ∧
          FakeEllipticCurve.IsPullbackVia (t i j h) w.1 wj.1 gwj ∧
          (wj.2.P).1 ≫ gwj = Spec.map (CommRingCat.ofHom (t i j h)) ≫ (w.2.P).1 ∧
          (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (S j))) (P : SchemeHomOver t' wj.1.f),
            FactorsThrough Cwj.levK P → ∃ P₀ : T ⟶ Cw.K, P₀ ≫ Cw.levK = P.1 ≫ gwj) ∧
          ∃ (e : vj.1.A ≅ wj.1.A) (he : e.hom ≫ wj.1.f = vj.1.f), FakeEllipticCurve.WithFullLevel.IsoTVia vj wj Cvj Cwj e he) := by
  classical
  intro i v w Cv Cw v' w' Cv' Cw' gv gw hgv hgvP hgvC hgw hgwP hgwC hiso
  have hv : TBC (c i) v Cv v' Cv' gv := ⟨hgv, hgvP, fun t' P hP => hgvC t' P hP⟩
  have hw : TBC (c i) w Cw w' Cw' gw := ⟨hgw, hgwP, fun t' P hP => hgwC t' P hP⟩

  have hunit : ∀ n : ℕ, IsUnit ((n : ℕ) : L) → ∃ i : ι, IsUnit ((n : ℕ) : S i) := by
    intro n hn
    obtain ⟨y, hy⟩ := hn.exists_right_inv
    obtain ⟨i, yi, rfl⟩ := hcsurj y
    have h1 : c i ((n : S i) * yi) = c i 1 := by rw [map_mul, map_natCast, map_one, hy]
    obtain ⟨j, hij, hj⟩ := hcker i _ _ h1
    rw [map_mul, map_natCast, map_one] at hj
    exact ⟨j, isUnit_iff_exists_inv.mpr ⟨_, hj⟩⟩
  have hunit_mono : ∀ (n : ℕ) (i j : ι) (h : i ≤ j), IsUnit ((n : ℕ) : S i) → IsUnit ((n : ℕ) : S j) := by
    intro n i j h hn; have := hn.map (t i j h); rwa [map_natCast] at this
  obtain ⟨iN, hiN⟩ := hunit N hNL
  obtain ⟨im, him⟩ := hunit m hmL
  obtain ⟨iℓ, hiℓ⟩ := hunit ℓ hℓL
  obtain ⟨i₁, hi1, hN1⟩ := directed_of (· ≤ ·) i iN
  obtain ⟨i₂, h12, hm2⟩ := directed_of (· ≤ ·) i₁ im
  obtain ⟨j₀, h20, hℓ0⟩ := directed_of (· ≤ ·) i₂ iℓ
  have hij₀ : i ≤ j₀ := hi1.trans (h12.trans h20)
  have hN₀ : IsUnit ((N : ℕ) : S j₀) := hunit_mono N iN j₀ (hN1.trans (h12.trans h20)) hiN
  have hm₀ : IsUnit ((m : ℕ) : S j₀) := hunit_mono m im j₀ (hm2.trans h20) him
  have hℓ₀ : IsUnit ((ℓ : ℕ) : S j₀) := hunit_mono ℓ iℓ j₀ hℓ0 hiℓ

  obtain ⟨v₀, Cv₀, g₀v, hv₀⟩ := exists_tbci (t i j₀ hij₀) v Cv
  obtain ⟨w₀, Cw₀, g₀w, hw₀⟩ := exists_tbci (t i j₀ hij₀) w Cw
  obtain ⟨gv', hv'₀⟩ := exists_tbc_cancel (t i j₀ hij₀) (c j₀) v v₀ v' Cv Cv₀ Cv' g₀v gv hv₀.1 ((hc i j₀ hij₀).symm ▸ hv)
  obtain ⟨gw', hw'₀⟩ := exists_tbc_cancel (t i j₀ hij₀) (c j₀) w w₀ w' Cw Cw₀ Cw' g₀w gw hw₀.1 ((hc i j₀ hij₀).symm ▸ hw)
  obtain ⟨k, hj₀k, vk, wk, Cvk, Cwk, gvk, gwk, hvk, hwk, hisok⟩ :=
    main_at hqq' hB hΛ hm ι S t ht₁ ht₂ L c hc hcsurj hcker j₀ hN₀ hm₀ hℓ₀ v₀ w₀ Cv₀ Cw₀ v' w' Cv' Cw' gv' gw' hv'₀ hw'₀ hiso
  have hvk' : TBC (t i k (hij₀.trans hj₀k)) v Cv vk Cvk (gvk ≫ g₀v) :=
    (ht₂ i j₀ k hij₀ hj₀k) ▸ tbc_comp _ _ _ _ _ _ _ _ _ _ hv₀.1 hvk
  have hwk' : TBC (t i k (hij₀.trans hj₀k)) w Cw wk Cwk (gwk ≫ g₀w) :=
    (ht₂ i j₀ k hij₀ hj₀k) ▸ tbc_comp _ _ _ _ _ _ _ _ _ _ hw₀.1 hwk
  exact ⟨k, hij₀.trans hj₀k, vk, wk, Cvk, Cwk, gvk ≫ g₀v, gwk ≫ g₀w, hvk'.1, hvk'.2.1, (fun t' P hP => hvk'.2.2 t' P hP),
    hwk'.1, hwk'.2.1, (fun t' P hP => hwk'.2.2 t' P hP), hisok⟩

