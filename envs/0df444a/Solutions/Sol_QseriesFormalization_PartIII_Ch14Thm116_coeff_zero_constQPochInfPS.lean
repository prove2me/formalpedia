  have hprod := (hasProd_constQFactorPS c).tendsto_prod_nat
  have hcoeff :
      Tendsto
        (fun N : ℕ => (∏ n ∈ Finset.range N, constQFactorPS c n).coeff 0)
        atTop (𝓝 ((constQPochInfPS c).coeff 0)) :=
