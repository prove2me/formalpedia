variable {A B : Type*} [CommRing A] [CommRing B]

private theorem commute_of_coe_eq_diagonal {n : Type*} [Fintype n] [DecidableEq n] {g h : GL n A} {d e : n → A}
    (hg : (g : Matrix n n A) = Matrix.diagonal d) (hh : (h : Matrix n n A) = Matrix.diagonal e) :
    Commute g h := by
  show g * h = h * g
  refine Units.ext ?_
  rw [Units.val_mul, Units.val_mul, hg, hh, Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]
  exact congrArg Matrix.diagonal (funext fun i => mul_comm (d i) (e i))

private theorem coe_map_eq_diagonal (f : A →+* B) {n : Type*} [Fintype n] [DecidableEq n] {g : GL n A} {d : n → A}
    (hg : (g : Matrix n n A) = Matrix.diagonal d) :
    ((Matrix.GeneralLinearGroup.map f g : GL n B) : Matrix n n B) = Matrix.diagonal (f ∘ d) := by
  ext i j
  rw [Matrix.GeneralLinearGroup.map_apply, hg]
  by_cases hij : i = j
  · subst hij
    simp
  · simp [Matrix.diagonal_apply_ne _ hij]

private theorem map_mul_upperUnipotent3 (f : ℚ →+* B) {a : ℚ} (t : GL (Fin 3) ℚ)
    (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1]) (x y z : B) :
    Matrix.GeneralLinearGroup.map f t * upperUnipotent3 x y z =
      upperUnipotent3 (f a * x) (f a * y) (f a * (f a * z)) * Matrix.GeneralLinearGroup.map f t := by
  have h00 : (t : Matrix (Fin 3) (Fin 3) ℚ) 0 0 = a ^ 2 := by simp [ht]
  have h11 : (t : Matrix (Fin 3) (Fin 3) ℚ) 1 1 = a := by simp [ht]
  have h22 : (t : Matrix (Fin 3) (Fin 3) ℚ) 2 2 = 1 := by simp [ht]
  have h01 : (t : Matrix (Fin 3) (Fin 3) ℚ) 0 1 = 0 := by simp [ht]
  have h02 : (t : Matrix (Fin 3) (Fin 3) ℚ) 0 2 = 0 := by simp [ht]
  have h10 : (t : Matrix (Fin 3) (Fin 3) ℚ) 1 0 = 0 := by simp [ht]
  have h12 : (t : Matrix (Fin 3) (Fin 3) ℚ) 1 2 = 0 := by simp [ht]
  have h20 : (t : Matrix (Fin 3) (Fin 3) ℚ) 2 0 = 0 := by simp [ht]
  have h21 : (t : Matrix (Fin 3) (Fin 3) ℚ) 2 1 = 0 := by simp [ht]
  refine Units.ext ?_
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [upperUnipotent3_coe, Matrix.mul_apply, Fin.sum_univ_three, h00, h11, h22, h01, h02, h10, h12, h20, h21]
  all_goals ring

private theorem coe_inv_of_coe_eq_diagonal {a : ℚ} (ha : a ≠ 0) (t : GL (Fin 3) ℚ)
    (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1]) :
    ((t⁻¹ : GL (Fin 3) ℚ) : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![(a ^ 2)⁻¹, a⁻¹, 1] := by
  rw [Matrix.coe_units_inv, ht]
  refine Matrix.inv_eq_right_inv ?_
  rw [Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
  refine congrArg Matrix.diagonal (funext fun i => ?_)
  fin_cases i <;> simp [ha]

end
