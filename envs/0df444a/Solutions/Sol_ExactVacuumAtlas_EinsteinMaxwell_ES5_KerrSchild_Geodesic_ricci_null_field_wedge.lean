theorem sum_pd_liftRU_gen (K : Fin 5 → ℝ) (F : ℝ → ℝ → ℝ) (x : Pt 5) :
    ∑ j, K j * pd j (liftRU F) x =
      K 1 * deriv (fun s => F s (x 2)) (x 1) + K 2 * deriv (fun s => F (x 1) s) (x 2) := by
  simp only [Fin.sum_univ_five, pd_liftRU_zero, pd_liftRU_three, pd_liftRU_four, pd_liftRU_one,
