theorem conic_cara {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι]
    [DecidableEq ι] (v : ι → V) : ∀ (k : ℕ) (lam : ι → ℝ),
    (Finset.univ.filter (fun i => lam i ≠ 0)).card ≤ k → (∀ i, 0 ≤ lam i) →
    ∃ μ : ι → ℝ, (∀ i, 0 ≤ μ i) ∧ ∑ i, μ i • v i = ∑ i, lam i • v i ∧
      LinearIndepOn ℝ v (↑(Finset.univ.filter (fun i => μ i ≠ 0)) : Set ι) := by
  intro k
  induction k with
  | zero =>
    intro lam hk hlam
    refine ⟨lam, hlam, rfl, ?_⟩
    have : Finset.univ.filter (fun i => lam i ≠ 0) = ∅ := Finset.card_eq_zero.mp (by omega)
    rw [this, Finset.coe_empty]
    exact linearIndepOn_empty ℝ v
  | succ k ih =>
    intro lam hk hlam
    set s := Finset.univ.filter (fun i => lam i ≠ 0) with hs
    by_cases hli : LinearIndepOn ℝ v (↑s : Set ι)
    · exact ⟨lam, hlam, rfl, hli⟩
    obtain ⟨g, hg0, j0, hj0s, hj0⟩ := not_linearIndepOn_finset_iff.mp hli
    -- a dependence supported on `s` with a positive entry
    obtain ⟨c, hcsum, hcsupp, j1, hj1⟩ : ∃ c : ι → ℝ, ∑ i, c i • v i = 0 ∧
        (∀ i, lam i = 0 → c i = 0) ∧ ∃ j, 0 < c j := by
      let c0 : ι → ℝ := fun i => if lam i ≠ 0 then g i else 0
      have hc0 : ∑ i, c0 i • v i = 0 := by
        rw [← hg0, hs, Finset.sum_filter]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp only [c0]
        split_ifs <;> simp
      have hc0s : ∀ i, lam i = 0 → c0 i = 0 := fun i hi => by simp [c0, hi]
      have hj0' : c0 j0 ≠ 0 := by
        have : lam j0 ≠ 0 := (Finset.mem_filter.mp hj0s).2
        simp [c0, this, hj0]
      rcases lt_or_gt_of_ne hj0' with hneg | hpos
      · refine ⟨fun i => - c0 i, ?_, fun i hi => by simp [hc0s i hi], j0, by linarith⟩
        simp only [neg_smul, Finset.sum_neg_distrib, hc0, neg_zero]
      · exact ⟨c0, hc0, hc0s, j0, hpos⟩
    set S := Finset.univ.filter (fun i => 0 < c i) with hS
    have hSne : S.Nonempty := ⟨j1, by simp [S, hj1]⟩
    obtain ⟨j, hjS, hjmin⟩ := S.exists_min_image (fun i => lam i / c i) hSne
    have hcj : 0 < c j := (Finset.mem_filter.mp hjS).2
    set τ := lam j / c j with hτ
    have hτ0 : 0 ≤ τ := div_nonneg (hlam j) hcj.le
    set lam' : ι → ℝ := fun i => lam i - τ * c i with hlam'def
    have hlam' : ∀ i, 0 ≤ lam' i := by
      intro i
      simp only [lam']
      rcases le_or_gt (c i) 0 with hci | hci
      · nlinarith [hlam i]
      · have h1 : τ ≤ lam i / c i := hjmin i (by simp [S, hci])
        have h2 : τ * c i ≤ lam i := by
          have := mul_le_mul_of_nonneg_right h1 hci.le
          rwa [div_mul_cancel₀ _ hci.ne'] at this
        linarith
    have hsum : ∑ i, lam' i • v i = ∑ i, lam i • v i := by
      simp only [lam', sub_smul, Finset.sum_sub_distrib, mul_smul, ← Finset.smul_sum, hcsum,
        smul_zero, sub_zero]
    have hcard : (Finset.univ.filter (fun i => lam' i ≠ 0)).card ≤ k := by
      have hsub : Finset.univ.filter (fun i => lam' i ≠ 0) ⊆ s.erase j := by
        intro i hi
        have hi' : lam' i ≠ 0 := (Finset.mem_filter.mp hi).2
        refine Finset.mem_erase.mpr ⟨?_, ?_⟩
        · rintro rfl
          apply hi'
          simp only [lam', τ]
          field_simp
          ring
        · refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, fun h0 => hi' ?_⟩
          simp [lam', h0, hcsupp i h0]
      have hjs : j ∈ s := by
        refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, fun h0 => ?_⟩
        have := hcsupp j h0
        linarith
      have := Finset.card_le_card hsub
      rw [Finset.card_erase_of_mem hjs] at this
      omega
    obtain ⟨μ, h1, h2, h3⟩ := ih lam' hcard hlam'
    exact ⟨μ, h1, h2.trans hsum, h3⟩

/-- The cone generated by a finite family. -/
def gcone {V : Type*} [AddCommGroup V] [Module ℝ V] {ι : Type*} [Fintype ι] (v : ι → V) :
    Set V :=
  {x | ∃ lam : ι → ℝ, (∀ i, 0 ≤ lam i) ∧ x = ∑ i, lam i • v i}

theorem gcone_closed {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    [FiniteDimensional ℝ V] {ι : Type*} [Fintype ι] [DecidableEq ι] (v : ι → V) :
    IsClosed (gcone v) := by
  classical
  -- the piece over a linearly independent support
  let P : Finset ι → Set V := fun t =>
    (Fintype.linearCombination ℝ (fun i : t => v i)) '' {μ | ∀ i, 0 ≤ μ i}
  have hP : ∀ t : Finset ι, LinearIndepOn ℝ v (↑t : Set ι) → IsClosed (P t) := by
    intro t ht
    have hker : LinearMap.ker (Fintype.linearCombination ℝ (fun i : t => v i)) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro g hg
      rw [Fintype.linearCombination_apply] at hg
      exact funext (Fintype.linearIndependent_iff.mp ht g hg)
    have hemb := LinearMap.isClosedEmbedding_of_injective hker
    apply hemb.isClosedMap
    have : {μ : t → ℝ | ∀ i, 0 ≤ μ i} = ⋂ i, {μ : t → ℝ | 0 ≤ μ i} := by ext; simp
    rw [this]
    exact isClosed_iInter (fun i => isClosed_le continuous_const (continuous_apply i))
  have heq : gcone v = ⋃ t ∈ (Finset.univ.filter (fun t : Finset ι =>
      LinearIndepOn ℝ v (↑t : Set ι))), P t := by
    ext x
    simp only [Set.mem_iUnion, Finset.mem_filter, Finset.mem_univ, true_and, exists_prop]
    constructor
    · rintro ⟨lam, hlam, rfl⟩
      obtain ⟨μ, hμ, hμsum, hli⟩ := conic_cara v _ lam le_rfl hlam
      refine ⟨_, hli, fun i => μ i, fun i => hμ i, ?_⟩
      rw [Fintype.linearCombination_apply, ← hμsum]
      refine (Finset.sum_coe_sort _ (fun i => μ i • v i)).trans ?_
      refine Finset.sum_filter_of_ne (fun i _ hne => ?_)
      intro h0
      exact hne (by rw [h0, zero_smul])
    · rintro ⟨t, -, μ, hμ, rfl⟩
      refine ⟨fun i => if h : i ∈ t then μ ⟨i, h⟩ else 0, fun i => ?_, ?_⟩
      · by_cases h : i ∈ t
        · simp only [h, dite_true]
          exact hμ _
        · simp [h]
      · rw [Fintype.linearCombination_apply]
        rw [← Finset.sum_subset (Finset.subset_univ t) (fun i _ hi => by simp [hi])]
        rw [← Finset.sum_coe_sort t]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        simp
  rw [heq]
  exact isClosed_biUnion_finset (fun t ht => hP t (Finset.mem_filter.mp ht).2)


/-- Farkas' lemma for a finite family in a finite-dimensional real inner product space. -/
theorem farkas {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (v : ι → V) (g : V) :
    (∃ lam : ι → ℝ, (∀ i, 0 ≤ lam i) ∧ g = ∑ i, lam i • v i) ∨
    ∃ d : V, (∀ i, 0 ≤ inner ℝ (v i) d) ∧ inner ℝ g d < 0 := by
  by_cases hg : g ∈ gcone v
  · exact Or.inl hg
  right
  have hconv : Convex ℝ (gcone v) := by
    rintro x ⟨lx, hlx, rfl⟩ y ⟨ly, hly, rfl⟩ a b ha hb _
    refine ⟨fun i => a * lx i + b * ly i, fun i => by
      have := hlx i; have := hly i; positivity, ?_⟩
    simp only [Finset.smul_sum, smul_smul, ← Finset.sum_add_distrib, add_smul]
  obtain ⟨f, w, hfw, hwg⟩ := geometric_hahn_banach_closed_point hconv (gcone_closed v) hg
  have h0 : (0 : V) ∈ gcone v := ⟨fun _ => 0, fun _ => le_rfl, by simp⟩
  have hw : 0 < w := by simpa using hfw 0 h0
  have hfv : ∀ i, f (v i) ≤ 0 := by
    intro i
    by_contra h
    push Not at h
    have hmem : (w / f (v i)) • v i ∈ gcone v := by
      refine ⟨fun j => if j = i then w / f (v i) else 0, fun j => ?_, ?_⟩
      · dsimp only
        split_ifs
        · positivity
        · exact le_rfl
      · simp
    have := hfw _ hmem
    rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ h.ne'] at this
    exact lt_irrefl _ this
  refine ⟨(InnerProductSpace.toDual ℝ V).symm (-f), fun i => ?_, ?_⟩
  · rw [real_inner_comm, InnerProductSpace.toDual_symm_apply]
    simpa using hfv i
  · rw [real_inner_comm, InnerProductSpace.toDual_symm_apply]
    simp only [neg_apply]
    linarith

/-- KKT for a point satisfying the variational inequality of a polyhedron: `g` lies in the cone of
the active normals. -/
theorem kkt {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (A : ι → V) (c : ι → ℝ) (x₀ g : V)
    (hx₀ : ∀ i, ⟪A i, x₀⟫ ≤ c i)
    (hvi : ∀ y, (∀ i, ⟪A i, y⟫ ≤ c i) → ⟪g, y - x₀⟫ ≤ 0) :
    ∃ lam : ι → ℝ, (∀ i, 0 ≤ lam i) ∧ (∀ i, ⟪A i, x₀⟫ < c i → lam i = 0) ∧
      g = ∑ i, lam i • A i := by
  classical
  let v : ι → V := fun i => if ⟪A i, x₀⟫ < c i then 0 else A i
  rcases farkas v g with ⟨lam, hlam, hg⟩ | ⟨d, hd, hgd⟩
  · refine ⟨fun i => if ⟪A i, x₀⟫ < c i then 0 else lam i, fun i => ?_, fun i hi => by simp [hi], ?_⟩
    · dsimp only; split_ifs
      · exact le_rfl
      · exact hlam i
    · rw [hg]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      simp only [v]; split_ifs <;> simp
  · exfalso
    have hev : ∀ᶠ t in nhds (0:ℝ), ∀ i, ⟪A i, x₀⟫ < c i → ⟪A i, x₀ - t • d⟫ < c i := by
      refine Filter.eventually_all.2 (fun i => ?_)
      by_cases hi : ⟪A i, x₀⟫ < c i
      · have hcont : Continuous (fun t : ℝ => ⟪A i, x₀ - t • d⟫) := by fun_prop
        have : ∀ᶠ t in nhds (0:ℝ), ⟪A i, x₀ - t • d⟫ < c i :=
          hcont.continuousAt.eventually_lt continuousAt_const (by simpa using hi)
        exact this.mono (fun t ht _ => ht)
      · exact Filter.Eventually.of_forall (fun t h => absurd h hi)
    obtain ⟨t, ht, htpos⟩ :=
      ((hev.filter_mono nhdsWithin_le_nhds).and (self_mem_nhdsWithin (s := Set.Ioi (0:ℝ)))).exists
    have hy : ∀ i, ⟪A i, x₀ - t • d⟫ ≤ c i := by
      intro i
      by_cases hi : ⟪A i, x₀⟫ < c i
      · exact (ht i hi).le
      · have hvi' : v i = A i := by simp [v, hi]
        have := hd i
        rw [hvi'] at this
        rw [inner_sub_right, inner_smul_right]
        have := hx₀ i
        nlinarith [htpos]
    have := hvi _ hy
    rw [show x₀ - t • d - x₀ = -(t • d) by abel, inner_neg_right, inner_smul_right] at this
    nlinarith [htpos]

/-- Uniform bound on the coefficients of a linearly independent combination. -/
theorem lin_indep_bound {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    [FiniteDimensional ℝ V] {ι : Type*} [Fintype ι] [DecidableEq ι] (A : ι → V) :
    ∃ C > 0, ∀ μ : ι → ℝ,
      LinearIndepOn ℝ A (↑(Finset.univ.filter (fun i => μ i ≠ 0)) : Set ι) →
      ∀ i, |μ i| ≤ C * ‖∑ j, μ j • A j‖ := by
  have hK : ∀ t : Finset ι, ∃ K : ℝ, 0 ≤ K ∧ (LinearIndepOn ℝ A (↑t : Set ι) →
      ∀ μ : ι → ℝ, (∀ i, i ∉ t → μ i = 0) → ∀ i, |μ i| ≤ K * ‖∑ j, μ j • A j‖) := by
    intro t
    by_cases ht : LinearIndepOn ℝ A (↑t : Set ι)
    · let f : (t → ℝ) →ₗ[ℝ] V := Fintype.linearCombination ℝ (fun i : t => A i)
      have hinj : Function.Injective f := by
        rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
        intro g hg
        rw [Fintype.linearCombination_apply] at hg
        exact funext (Fintype.linearIndependent_iff.mp ht g hg)
      let e := (LinearEquiv.ofInjective f hinj).toContinuousLinearEquiv
      refine ⟨‖(e.symm : LinearMap.range f →L[ℝ] (t → ℝ))‖, ContinuousLinearMap.opNorm_nonneg _,
        fun _ μ hμ i => ?_⟩
      by_cases hi : i ∈ t
      · let μ' : t → ℝ := fun j => μ j
        have hf : f μ' = ∑ j, μ j • A j := by
          simp only [f, Fintype.linearCombination_apply, μ']
          rw [Finset.sum_coe_sort t (fun j => μ j • A j)]
          exact Finset.sum_subset (Finset.subset_univ t) (fun j _ hj => by simp [hμ j hj])
        have h1 : |μ i| ≤ ‖μ'‖ := by
          have := norm_le_pi_norm μ' ⟨i, hi⟩
          simpa [μ', Real.norm_eq_abs] using this
        have h2 : ‖μ'‖ ≤ ‖(e.symm : LinearMap.range f →L[ℝ] (t → ℝ))‖ * ‖e μ'‖ := by
          have := (e.symm : LinearMap.range f →L[ℝ] (t → ℝ)).le_opNorm (e μ')
          simpa using this
        have h3 : ‖e μ'‖ = ‖f μ'‖ := rfl
        rw [h3, hf] at h2
        exact h1.trans h2
      · rw [hμ i hi, abs_zero]
        exact mul_nonneg (ContinuousLinearMap.opNorm_nonneg _) (norm_nonneg _)
    · exact ⟨0, le_rfl, fun h => absurd h ht⟩
  choose K hK0 hK using hK
  have hS : 0 ≤ ∑ t, K t := Finset.sum_nonneg (fun t _ => hK0 t)
  refine ⟨1 + ∑ t, K t, by linarith, fun μ hli i => ?_⟩
  have hb := hK _ hli μ (fun j hj => by simpa using hj) i
  have hle : K (Finset.univ.filter (fun i => μ i ≠ 0)) ≤ 1 + ∑ t, K t := by
    have := Finset.single_le_sum (fun t _ => hK0 t)
      (Finset.mem_univ (Finset.univ.filter (fun i => μ i ≠ 0)))
    linarith
  exact hb.trans (mul_le_mul_of_nonneg_right hle (norm_nonneg _))

/-- Hoffman's error bound for `{y | ∀ i, ⟪A i, y⟫ ≤ c i}`, with a constant independent of `c`. -/
theorem hoffman {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (A : ι → V) :
    ∃ κ > 0, ∀ (c : ι → ℝ) (x : V), {y : V | ∀ i, ⟪A i, y⟫ ≤ c i}.Nonempty →
      Metric.infDist x {y : V | ∀ i, ⟪A i, y⟫ ≤ c i} ≤ κ * ∑ i, max 0 (⟪A i, x⟫ - c i) := by
  classical
  obtain ⟨C, hC, hCb⟩ := lin_indep_bound A
  refine ⟨C, hC, fun c x hne => ?_⟩
  have hPc : IsClosed {y : V | ∀ i, ⟪A i, y⟫ ≤ c i} := by
    have : {y : V | ∀ i, ⟪A i, y⟫ ≤ c i} = ⋂ i, {y : V | ⟪A i, y⟫ ≤ c i} := by ext; simp
    rw [this]
    exact isClosed_iInter (fun i => isClosed_le (by fun_prop) continuous_const)
  have hPconv : Convex ℝ {y : V | ∀ i, ⟪A i, y⟫ ≤ c i} := by
    intro y hy z hz s t hs ht hst i
    rw [inner_add_right, inner_smul_right, inner_smul_right]
    have h1 := mul_le_mul_of_nonneg_left (hy i) hs
    have h2 := mul_le_mul_of_nonneg_left (hz i) ht
    have h3 : s * c i + t * c i = c i := by rw [← add_mul, hst, one_mul]
    linarith
  obtain ⟨x₀, hx₀, heq⟩ := exists_norm_eq_iInf_of_complete_convex hne hPc.isComplete hPconv x
  have hvi := (norm_eq_iInf_iff_real_inner_le_zero hPconv hx₀).1 heq
  obtain ⟨lam, hlam0, hlamI, hg⟩ := kkt A c x₀ (x - x₀) hx₀ hvi
  let v : ι → V := fun i => if ⟪A i, x₀⟫ < c i then 0 else A i
  have hsumv : ∑ i, lam i • v i = x - x₀ := by
    rw [hg]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    by_cases hi : ⟪A i, x₀⟫ < c i
    · simp [v, hi, hlamI i hi]
    · simp [v, hi]
  obtain ⟨μ, hμ0, hμsum, hμli⟩ := conic_cara v _ lam le_rfl hlam0
  have hact : ∀ i, μ i ≠ 0 → v i = A i ∧ ⟪A i, x₀⟫ = c i := by
    intro i hi
    have hne0 : v i ≠ 0 := hμli.ne_zero (by simpa using hi)
    by_cases h : ⟪A i, x₀⟫ < c i
    · exact absurd (by simp [v, h]) hne0
    · exact ⟨by simp [v, h], le_antisymm (hx₀ i) (not_lt.1 h)⟩
  have hsumA : ∑ i, μ i • A i = x - x₀ := by
    rw [← hsumv, ← hμsum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    by_cases hi : μ i = 0
    · simp [hi]
    · rw [(hact i hi).1]
  have hliA : LinearIndepOn ℝ A (↑(Finset.univ.filter (fun i => μ i ≠ 0)) : Set ι) :=
    hμli.congr (fun i hi => (hact i (by simpa using hi)).1)
  have hb : ∀ i, |μ i| ≤ C * ‖x - x₀‖ := by
    intro i
    have := hCb μ hliA i
    rwa [hsumA] at this
  have hsq : ‖x - x₀‖ ^ 2 ≤ C * ‖x - x₀‖ * ∑ i, max 0 (⟪A i, x⟫ - c i) := by
    rw [← real_inner_self_eq_norm_sq]
    nth_rewrite 1 [← hsumA]
    rw [sum_inner, Finset.mul_sum]
    refine Finset.sum_le_sum (fun i _ => ?_)
    rw [real_inner_smul_left]
    by_cases hi : μ i = 0
    · rw [hi, zero_mul]
      exact mul_nonneg (mul_nonneg hC.le (norm_nonneg _)) (le_max_left _ _)
    · have h1 : ⟪A i, x - x₀⟫ = ⟪A i, x⟫ - c i := by rw [inner_sub_right, (hact i hi).2]
      have hm : ⟪A i, x⟫ - c i ≤ max 0 (⟪A i, x⟫ - c i) := le_max_right _ _
      have hμ' : μ i ≤ C * ‖x - x₀‖ := (le_abs_self _).trans (hb i)
      rw [h1]
      calc μ i * (⟪A i, x⟫ - c i) ≤ μ i * max 0 (⟪A i, x⟫ - c i) :=
            mul_le_mul_of_nonneg_left hm (hμ0 i)
        _ ≤ C * ‖x - x₀‖ * max 0 (⟪A i, x⟫ - c i) :=
            mul_le_mul_of_nonneg_right hμ' (le_max_left _ _)
  have hdist : Metric.infDist x {y : V | ∀ i, ⟪A i, y⟫ ≤ c i} ≤ ‖x - x₀‖ := by
    rw [← dist_eq_norm]
    exact Metric.infDist_le_dist_of_mem hx₀
  have hS : 0 ≤ ∑ i, max 0 (⟪A i, x⟫ - c i) := Finset.sum_nonneg (fun i _ => le_max_left _ _)
  rcases eq_or_lt_of_le (norm_nonneg (x - x₀)) with h0 | hpos
  · rw [← h0] at hdist
    exact hdist.trans (mul_nonneg hC.le hS)
  · have h2 : ‖x - x₀‖ * ‖x - x₀‖ ≤ ‖x - x₀‖ * (C * ∑ i, max 0 (⟪A i, x⟫ - c i)) := by
      rw [← pow_two]
      linarith [hsq]
    exact hdist.trans (le_of_mul_le_mul_left h2 hpos)

/-- Infeasibility certificate (Farkas alternative) for `{y | ∀ i, ⟪A i, y⟫ ≤ c i}`. -/
theorem infeas {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (A : ι → V) (c : ι → ℝ)
    (h : ¬ {y : V | ∀ i, ⟪A i, y⟫ ≤ c i}.Nonempty) :
    ∃ y : ι → ℝ, (∀ i, 0 ≤ y i) ∧ ∑ i, y i • A i = 0 ∧ ∑ i, y i * c i < 0 := by
  rcases farkas (fun i => (WithLp.toLp 2 (-A i, c i) : WithLp 2 (V × ℝ)))
      (WithLp.toLp 2 ((0 : V), (-1 : ℝ))) with ⟨y, hy0, hy⟩ | ⟨d, hd, hgd⟩
  · have h1 := congrArg (fun p : WithLp 2 (V × ℝ) => (WithLp.ofLp p).1) hy
    have h2 := congrArg (fun p : WithLp 2 (V × ℝ) => (WithLp.ofLp p).2) hy
    simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Prod.fst_sum, Prod.snd_sum, Prod.smul_fst,
      Prod.smul_snd, WithLp.ofLp_toLp, smul_neg, Finset.sum_neg_distrib, smul_eq_mul] at h1 h2
    refine ⟨y, hy0, ?_, by linarith⟩
    rw [← neg_eq_zero, ← h1]
  · exfalso
    obtain ⟨d1, t⟩ := WithLp.ofLp d
    have hd' : ∀ i, 0 ≤ -⟪A i, (WithLp.ofLp d).1⟫ + c i * (WithLp.ofLp d).2 := by
      intro i
      have := hd i
      simp only [WithLp.prod_inner_apply, WithLp.ofLp_toLp, inner_neg_left, RCLike.inner_apply,
        conj_trivial] at this
      linarith
    have ht : 0 < (WithLp.ofLp d).2 := by
      simp only [WithLp.prod_inner_apply, WithLp.ofLp_toLp, inner_zero_left, RCLike.inner_apply,
        conj_trivial] at hgd
      linarith
    refine h ⟨((WithLp.ofLp d).2)⁻¹ • (WithLp.ofLp d).1, fun i => ?_⟩
    rw [inner_smul_right]
    have := hd' i
    rw [inv_mul_le_iff₀ ht]
    linarith

end AviAux

namespace LuoTseng.ErrorBound


variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The polyhedron `{z | ∀ i, ⟪a i, z⟫ ≤ b i}`. -/
def poly {m : ℕ} (a : Fin m → E) (b : Fin m → ℝ) : Set E := {z | ∀ i, ⟪a i, z⟫ ≤ b i}

/-- Stationary points of `min h` over `Z` for the gradient field `G`. -/
def solSet (Z : Set E) (G : E → E) : Set E := {z | z ∈ Z ∧ ∀ w ∈ Z, 0 ≤ ⟪G z, w - z⟫}

/-- `w` is the projection of `z - G z` onto `Z`. -/
def IsProjRes (Z : Set E) (G : E → E) (z w : E) : Prop :=
  w ∈ Z ∧ ∀ w' ∈ Z, ⟪z - G z - w, w' - w⟫ ≤ 0

end LuoTseng.ErrorBound

namespace CompAux

theorem ca_line_deriv {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E] {F : E → ℝ} {G : E → E} (hF : ∀ x, HasGradientAt F (G x) x)
    (x w : E) (t : ℝ) :
    HasDerivAt (fun s : ℝ => F (x + s • w)) ⟪G (x + t • w), w⟫ t := by
  have hl : HasDerivAt (fun s : ℝ => x + s • w) w t := by
    simpa using ((hasDerivAt_id t).smul_const w).const_add x
  have h1 := (hasGradientAt_iff_hasFDerivAt.mp (hF (x + t • w))).comp_hasDerivAt t hl
  rw [InnerProductSpace.toDual_apply_apply] at h1
  exact h1

theorem ca_convex_fo {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E] {F : E → ℝ} {G : E → E} (hF : ∀ x, HasGradientAt F (G x) x)
    (hc : ConvexOn ℝ Set.univ F) (x y : E) : F x + ⟪G x, y - x⟫ ≤ F y := by
  set w := y - x
  have hφ : ConvexOn ℝ Set.univ (fun t : ℝ => F (x + t • w)) := by
    have := hc.comp_affineMap (AffineMap.lineMap x y)
    simp only [Set.preimage_univ] at this
    have e : (fun t : ℝ => F (x + t • w)) = F ∘ AffineMap.lineMap x y := by
      funext t
      simp [AffineMap.lineMap_apply, w, add_comm]
    rw [e]; exact this
  have h := hφ.le_slope_of_hasDerivAt (Set.mem_univ 0) (Set.mem_univ 1) zero_lt_one
    (by simpa using ca_line_deriv hF x w 0)
  rw [slope_def_field] at h
  simp only [zero_smul, add_zero, one_smul, sub_zero, div_one] at h
  have hw : x + w = y := by simp [w]
  rw [hw] at h
  linarith

/-- strong convexity lower bound -/
theorem ca_lower_sc {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [CompleteSpace E] {F : E → ℝ} {G : E → E} {μ : ℝ} (hF : ∀ x, HasGradientAt F (G x) x)
    (hsc : StrongConvexOn Set.univ μ F) (x y : E) :
    F x + ⟪G x, y - x⟫ + μ / 2 * ‖y - x‖ ^ 2 ≤ F y := by
  have hc := strongConvexOn_iff_convex.1 hsc
  have hgr : ∀ z, HasGradientAt (fun x => F x - μ / (2:ℝ) * ‖x‖ ^ 2) (G z - μ • z) z := by
    intro z
    have h1 := hasGradientAt_iff_hasFDerivAt.mp (hF z)
    have h2 : HasFDerivAt (fun x : E => ‖x‖ ^ 2) (2 • (innerSL ℝ z)) z := hasStrictFDerivAt_norm_sq z |>.hasFDerivAt
    rw [hasGradientAt_iff_hasFDerivAt]
    refine (h1.sub (h2.const_mul (μ / 2))).congr_fderiv ?_
    ext v
    simp
    ring
  have h := ca_convex_fo hgr hc x y
  have hid : ‖y‖ ^ 2 = ‖x‖ ^ 2 + 2 * ⟪x, y - x⟫ + ‖y - x‖ ^ 2 := by
    have := norm_add_sq_real x (y - x)
    rw [add_sub_cancel] at this
    exact this
  simp only [inner_sub_left, real_inner_smul_left] at h
  have h3 : μ / 2 * ‖y‖ ^ 2 = μ / 2 * ‖x‖ ^ 2 + μ * ⟪x, y - x⟫ + μ / 2 * ‖y - x‖ ^ 2 := by
    rw [hid]; ring
  linarith


def sgn (s : Bool) : ℝ := if s then 1 else -1

theorem sgn_le {x B : ℝ} (s : Bool) (h : |x| ≤ B) : sgn s * x ≤ B := by
  have h' := abs_le.1 h
  cases s <;> simp [sgn] <;> linarith [h'.1, h'.2]

/-- Rows describing `{y ∈ Z | L y = t, ⟪q, y⟫ = s0}`. -/
noncomputable def cA {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] [NormedAddCommGroup F] [InnerProductSpace ℝ F]
    [FiniteDimensional ℝ F] {m : ℕ} (a : Fin m → E) (L : E →L[ℝ] F) (q : E) :
    Fin m ⊕ (Fin (Module.finrank ℝ F) × Bool) ⊕ Bool → E
  | .inl i => a i
  | .inr (.inl (j, s)) => sgn s • ContinuousLinearMap.adjoint L (stdOrthonormalBasis ℝ F j)
  | .inr (.inr s) => sgn s • q

noncomputable def cC {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]
    [FiniteDimensional ℝ F] {m : ℕ} (b : Fin m → ℝ) (t : F) (s0 : ℝ) :
    Fin m ⊕ (Fin (Module.finrank ℝ F) × Bool) ⊕ Bool → ℝ
  | .inl i => b i
  | .inr (.inl (j, s)) => sgn s * ⟪stdOrthonormalBasis ℝ F j, t⟫
  | .inr (.inr s) => sgn s * s0

theorem polyAff {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] [NormedAddCommGroup F] [InnerProductSpace ℝ F]
    [FiniteDimensional ℝ F] {m : ℕ} (a : Fin m → E) (b : Fin m → ℝ) (L : E →L[ℝ] F) (q : E)
    (t : F) (s0 : ℝ) :
    ∃ C > 0, ∀ w : E, (∀ i, ⟪a i, w⟫ ≤ b i) →
      {y : E | (∀ i, ⟪a i, y⟫ ≤ b i) ∧ L y = t ∧ ⟪q, y⟫ = s0}.Nonempty →
      Metric.infDist w {y : E | (∀ i, ⟪a i, y⟫ ≤ b i) ∧ L y = t ∧ ⟪q, y⟫ = s0} ≤
        C * (‖L w - t‖ + |⟪q, w⟫ - s0|) := by
  classical
  have hrowL : ∀ j s (y : E), ⟪cA a L q (.inr (.inl (j, s))), y⟫ =
      sgn s * ⟪stdOrthonormalBasis ℝ F j, L y⟫ := by
    intro j s y
    simp only [cA, real_inner_smul_left, ContinuousLinearMap.adjoint_inner_left]
  have hrowq : ∀ s (y : E), ⟪cA a L q (.inr (.inr s)), y⟫ = sgn s * ⟪q, y⟫ := by
    intro s y
    simp only [cA, real_inner_smul_left]
  have hset : {y : E | ∀ k, ⟪cA a L q k, y⟫ ≤ cC b t s0 k} =
      {y : E | (∀ i, ⟪a i, y⟫ ≤ b i) ∧ L y = t ∧ ⟪q, y⟫ = s0} := by
    ext y
    simp only [Set.mem_setOf_eq]
    constructor
    · intro hy
      refine ⟨fun i => hy (.inl i), ?_, ?_⟩
      · refine InnerProductSpace.ext_inner_left_basis (stdOrthonormalBasis ℝ F).toBasis
          fun j => ?_
        have hT := hy (.inr (.inl (j, true)))
        have hF := hy (.inr (.inl (j, false)))
        rw [hrowL] at hT hF
        simp only [cC, sgn, if_true, one_mul, Bool.false_eq_true, if_false, neg_mul,
          neg_le_neg_iff] at hT hF
        simp only [OrthonormalBasis.coe_toBasis]
        linarith
      · have hT := hy (.inr (.inr true))
        have hF := hy (.inr (.inr false))
        rw [hrowq] at hT hF
        simp only [cC, sgn, if_true, one_mul, Bool.false_eq_true, if_false, neg_mul,
          neg_le_neg_iff] at hT hF
        linarith
    · rintro ⟨h1, h2, h3⟩ (i | ⟨j, s⟩ | s)
      · exact h1 i
      · rw [hrowL, h2]; exact le_refl _
      · rw [hrowq, h3]; exact le_refl _
  obtain ⟨κ, hκ, hH⟩ := AviAux.hoffman (cA a L q)
  set N : ℝ := (Fintype.card (Fin m ⊕ (Fin (Module.finrank ℝ F) × Bool) ⊕ Bool) : ℝ)
  refine ⟨κ * (N + 1), by positivity, fun w hw hne => ?_⟩
  rw [← hset] at hne ⊢
  refine (hH (cC b t s0) w hne).trans ?_
  rw [mul_assoc]
  refine mul_le_mul_of_nonneg_left ?_ hκ.le
  have hD : 0 ≤ ‖L w - t‖ + |⟪q, w⟫ - s0| := by positivity
  have hterm : ∀ k, max 0 (⟪cA a L q k, w⟫ - cC b t s0 k) ≤ ‖L w - t‖ + |⟪q, w⟫ - s0| := by
    rintro (i | ⟨j, s⟩ | s)
    · refine max_le hD ?_
      have := hw i
      simp only [cA, cC]
      linarith
    · refine max_le hD ?_
      rw [hrowL]
      simp only [cC]
      have h1 : sgn s * ⟪stdOrthonormalBasis ℝ F j, L w⟫ - sgn s * ⟪stdOrthonormalBasis ℝ F j, t⟫
          = sgn s * ⟪stdOrthonormalBasis ℝ F j, L w - t⟫ := by rw [inner_sub_right]; ring
      rw [h1]
      refine sgn_le s ?_
      have h2 := abs_real_inner_le_norm (stdOrthonormalBasis ℝ F j) (L w - t)
      rw [(stdOrthonormalBasis ℝ F).orthonormal.1 j, one_mul] at h2
      linarith [abs_nonneg (⟪q, w⟫ - s0)]
    · refine max_le hD ?_
      rw [hrowq]
      simp only [cC]
      have h1 : sgn s * ⟪q, w⟫ - sgn s * s0 = sgn s * (⟪q, w⟫ - s0) := by ring
      rw [h1]
      refine sgn_le s ?_
      linarith [norm_nonneg (L w - t)]
  calc ∑ k, max 0 (⟪cA a L q k, w⟫ - cC b t s0 k)
      ≤ ∑ _k : Fin m ⊕ (Fin (Module.finrank ℝ F) × Bool) ⊕ Bool,
          (‖L w - t‖ + |⟪q, w⟫ - s0|) := Finset.sum_le_sum fun k _ => hterm k
    _ = N * (‖L w - t‖ + |⟪q, w⟫ - s0|) := by
        rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    _ ≤ (N + 1) * (‖L w - t‖ + |⟪q, w⟫ - s0|) := by nlinarith

theorem inf_lim {A B ρ δ : ℝ} (hρ : 0 ≤ ρ)
    (h : ∀ η > 0, ∃ d : ℝ, d < δ + η ∧ A ≤ B + ρ * d) : A ≤ B + ρ * δ := by
  refine le_of_forall_pos_le_add fun e he => ?_
  have hη : 0 < e / (ρ + 1) := div_pos he (by linarith)
  obtain ⟨d, hd, hA⟩ := h _ hη
  have h1 : ρ * d ≤ ρ * (δ + e / (ρ + 1)) := mul_le_mul_of_nonneg_left hd.le hρ
  have h2 : ρ * (e / (ρ + 1)) ≤ e := by
    rw [mul_div_assoc', div_le_iff₀ (by linarith)]; nlinarith
  rw [mul_add] at h1
  linarith

end CompAux

namespace AviAux

theorem infDist_fst' {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] {S : Set E} {T : Set (WithLp 2 (E × F))}
    (hT : T.Nonempty) (hTS : ∀ p ∈ T, (WithLp.ofLp p).1 ∈ S) (x : E) (μ : F) :
    Metric.infDist x S ≤ Metric.infDist (WithLp.toLp 2 (x, μ)) T := by
  refine (Metric.le_infDist hT).2 fun p hp => ?_
  refine (Metric.infDist_le_dist_of_mem (hTS p hp)).trans ?_
  rw [dist_eq_norm, dist_eq_norm, WithLp.prod_norm_eq_of_L2]
  refine Real.le_sqrt_of_sq_le ?_
  have : (WithLp.toLp 2 (x, μ) - p).fst = x - (WithLp.ofLp p).1 := by simp
  rw [this]
  nlinarith [sq_nonneg ‖(WithLp.toLp 2 (x, μ) - p).snd‖]

theorem perI {V W : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    [NormedAddCommGroup W] {ι : Type*} [Fintype ι] [DecidableEq ι] (A : ι → V) (c : W → ι → ℝ)
    (hc : ∀ v k, c v k - c 0 k ≤ ‖v‖) :
    ∃ κ > 0, ∃ ε > 0, ∀ (v : W) (p : V), ‖v‖ < ε → (∀ k, ⟪A k, p⟫ ≤ c v k) →
      {y : V | ∀ k, ⟪A k, y⟫ ≤ c 0 k}.Nonempty ∧
      Metric.infDist p {y : V | ∀ k, ⟪A k, y⟫ ≤ c 0 k} ≤ κ * (Fintype.card ι * ‖v‖) := by
  obtain ⟨κ, hκ, hH⟩ := hoffman A
  refine ⟨κ, hκ, ?_⟩
  by_cases hne : {y : V | ∀ k, ⟪A k, y⟫ ≤ c 0 k}.Nonempty
  · refine ⟨1, one_pos, fun v p _ hp => ⟨hne, (hH (c 0) p hne).trans ?_⟩⟩
    refine mul_le_mul_of_nonneg_left ?_ hκ.le
    calc ∑ k, max 0 (⟪A k, p⟫ - c 0 k) ≤ ∑ _k : ι, ‖v‖ :=
          Finset.sum_le_sum fun k _ => max_le (norm_nonneg _) (by linarith [hp k, hc v k])
      _ = Fintype.card ι * ‖v‖ := by simp
  · obtain ⟨y, hy0, hyA, hyc⟩ := infeas A (c 0) hne
    have hs : 0 ≤ ∑ k, y k := Finset.sum_nonneg fun k _ => hy0 k
    have ht : 0 < -∑ k, y k * c 0 k := by linarith
    refine ⟨(-∑ k, y k * c 0 k) / (∑ k, y k + 1), div_pos ht (by linarith),
      fun v p hv hp => ?_⟩
    exfalso
    have h0 : ∑ k, y k * ⟪A k, p⟫ = 0 := by
      have : ⟪∑ k, y k • A k, p⟫ = ∑ k, y k * ⟪A k, p⟫ := by
        simp [sum_inner, real_inner_smul_left]
      rw [← this, hyA, inner_zero_left]
    have h1 : ∑ k, y k * ⟪A k, p⟫ ≤ ∑ k, y k * (c 0 k + ‖v‖) :=
      Finset.sum_le_sum fun k _ =>
        mul_le_mul_of_nonneg_left (by linarith [hp k, hc v k]) (hy0 k)
    have h2 : ∑ k, y k * (c 0 k + ‖v‖) = ∑ k, y k * c 0 k + (∑ k, y k) * ‖v‖ := by
      simp only [mul_add, Finset.sum_add_distrib, Finset.sum_mul]
    have h3 : (∑ k, y k) * ‖v‖ ≤ (∑ k, y k) * ((-∑ k, y k * c 0 k) / (∑ k, y k + 1)) :=
      mul_le_mul_of_nonneg_left hv.le hs
    have h4 : (∑ k, y k) * ((-∑ k, y k * c 0 k) / (∑ k, y k + 1)) < -∑ k, y k * c 0 k := by
      rw [mul_div_assoc', div_lt_iff₀ (by linarith)]; nlinarith
    linarith

/-- Row index: rows of `Z`, reversed active rows, `μ ≥ 0`, `μ ≤ 0` off the active set,
and the two inequalities per basis vector encoding `M u + Σ μ i • a i = v - q`. -/
abbrev Rix (m d : ℕ) := Fin m ⊕ Fin m ⊕ Fin m ⊕ Fin m ⊕ (Fin d × Bool)

def sgn (s : Bool) : ℝ := if s then 1 else -1

noncomputable def rowA {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {m : ℕ} (a : Fin m → E) (M : E →L[ℝ] E) (I : Finset (Fin m)) :
    Rix m (Module.finrank ℝ E) → WithLp 2 (E × EuclideanSpace ℝ (Fin m))
  | .inl i => WithLp.toLp 2 (a i, 0)
  | .inr (.inl i) => if i ∈ I then WithLp.toLp 2 (-a i, 0) else 0
  | .inr (.inr (.inl i)) => WithLp.toLp 2 (0, -EuclideanSpace.single i 1)
  | .inr (.inr (.inr (.inl i))) =>
      if i ∈ I then 0 else WithLp.toLp 2 (0, EuclideanSpace.single i 1)
  | .inr (.inr (.inr (.inr (j, s)))) => sgn s • WithLp.toLp 2
      (ContinuousLinearMap.adjoint M (stdOrthonormalBasis ℝ E j),
        WithLp.toLp 2 (fun i => ⟪a i, stdOrthonormalBasis ℝ E j⟫))

noncomputable def rowc {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {m : ℕ} (b : Fin m → ℝ) (q : E) (I : Finset (Fin m)) (v : E) :
    Rix m (Module.finrank ℝ E) → ℝ
  | .inl i => b i
  | .inr (.inl i) => if i ∈ I then -b i else 0
  | .inr (.inr (.inl _)) => 0
  | .inr (.inr (.inr (.inl _))) => 0
  | .inr (.inr (.inr (.inr (j, s)))) => sgn s * ⟪stdOrthonormalBasis ℝ E j, v - q⟫

theorem rowc_diff {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {m : ℕ} (b : Fin m → ℝ) (q : E) (I : Finset (Fin m)) :
    ∀ (v : E) k, rowc b q I v k - rowc b q I 0 k ≤ ‖v‖ := by
  rintro v (i | i | i | i | ⟨j, s⟩)
  · simp [rowc]
  · simp [rowc]
  · simp [rowc]
  · simp [rowc]
  · show sgn s * ⟪stdOrthonormalBasis ℝ E j, v - q⟫ - sgn s * ⟪stdOrthonormalBasis ℝ E j, 0 - q⟫ ≤ ‖v‖
    have h1 : sgn s * ⟪stdOrthonormalBasis ℝ E j, v - q⟫ -
        sgn s * ⟪stdOrthonormalBasis ℝ E j, 0 - q⟫ = sgn s * ⟪stdOrthonormalBasis ℝ E j, v⟫ := by
      rw [inner_sub_right, inner_sub_right, inner_zero_right]; ring
    have h2 := abs_real_inner_le_norm (stdOrthonormalBasis ℝ E j) v
    rw [(stdOrthonormalBasis ℝ E).orthonormal.1 j, one_mul] at h2
    have h3 := abs_le.1 h2
    rw [h1]
    cases s <;> simp [sgn] <;> linarith [h3.1, h3.2]

theorem row_eq {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {m : ℕ} (a : Fin m → E) (M : E →L[ℝ] E) (I : Finset (Fin m))
    (j : Fin (Module.finrank ℝ E)) (s : Bool) (u : E) (μ : EuclideanSpace ℝ (Fin m)) :
    ⟪rowA a M I (.inr (.inr (.inr (.inr (j, s))))), WithLp.toLp 2 (u, μ)⟫ =
      sgn s * ⟪stdOrthonormalBasis ℝ E j, M u + ∑ i, μ i • a i⟫ := by
  show ⟪sgn s • WithLp.toLp 2 (ContinuousLinearMap.adjoint M (stdOrthonormalBasis ℝ E j),
      (WithLp.toLp 2 (fun i => ⟪a i, stdOrthonormalBasis ℝ E j⟫) : EuclideanSpace ℝ (Fin m))),
      WithLp.toLp 2 (u, μ)⟫ = _
  rw [real_inner_smul_left, WithLp.prod_inner_apply]
  simp only [WithLp.ofLp_toLp, ContinuousLinearMap.adjoint_inner_left, inner_add_right, inner_sum,
    real_inner_smul_right, PiLp.inner_apply, PiLp.toLp_apply]
  congr 2
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [RCLike.inner_apply, conj_trivial, real_inner_comm]

theorem row_sol {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {m : ℕ} (a : Fin m → E) (b : Fin m → ℝ) (M : E →L[ℝ] E) (q : E)
    (I : Finset (Fin m)) (u : E) (μ : EuclideanSpace ℝ (Fin m))
    (hp : ∀ k, ⟪rowA a M I k, WithLp.toLp 2 (u, μ)⟫ ≤ rowc b q I 0 k) :
    (∀ i, ⟪a i, u⟫ ≤ b i) ∧ ∀ w, (∀ i, ⟪a i, w⟫ ≤ b i) → 0 ≤ ⟪M u + q, w - u⟫ := by
  have h1 : ∀ i, ⟪a i, u⟫ ≤ b i := fun i => by
    simpa [rowA, rowc, WithLp.prod_inner_apply] using hp (.inl i)
  have h2 : ∀ i ∈ I, b i ≤ ⟪a i, u⟫ := fun i hi => by
    have := hp (.inr (.inl i))
    simp [rowA, rowc, hi, WithLp.prod_inner_apply] at this
    linarith
  have h3 : ∀ i, 0 ≤ μ i := fun i => by
    have := hp (.inr (.inr (.inl i)))
    simp [rowA, rowc, WithLp.prod_inner_apply, EuclideanSpace.inner_single_left] at this
    linarith
  have h4 : ∀ i ∉ I, μ i ≤ 0 := fun i hi => by
    have := hp (.inr (.inr (.inr (.inl i))))
    simpa [rowA, rowc, hi, WithLp.prod_inner_apply, EuclideanSpace.inner_single_left] using this
  have h5 : ∀ j, ⟪(stdOrthonormalBasis ℝ E).toBasis j, M u + ∑ i, μ i • a i⟫ =
      ⟪(stdOrthonormalBasis ℝ E).toBasis j, -q⟫ := by
    intro j
    have hT := hp (.inr (.inr (.inr (.inr (j, true)))))
    have hF := hp (.inr (.inr (.inr (.inr (j, false)))))
    rw [row_eq] at hT hF
    simp only [rowc, sgn, OrthonormalBasis.coe_toBasis] at hT hF ⊢
    simp only [if_true, one_mul, Bool.false_eq_true, if_false, neg_mul, neg_le_neg_iff,
      zero_sub] at hT hF
    linarith
  have h6 : M u + ∑ i, μ i • a i = -q :=
    InnerProductSpace.ext_inner_left_basis (stdOrthonormalBasis ℝ E).toBasis h5
  have h7 : M u + q = -∑ i, μ i • a i := by
    rw [← sub_eq_zero]
    calc M u + q - -∑ i, μ i • a i = M u + ∑ i, μ i • a i - -q := by abel
      _ = 0 := sub_eq_zero.2 h6
  refine ⟨h1, fun w hw => ?_⟩
  rw [h7, inner_neg_left, sum_inner, ← Finset.sum_neg_distrib]
  refine Finset.sum_nonneg fun i _ => ?_
  rw [real_inner_smul_left, inner_sub_right]
  by_cases hi : i ∈ I
  · have := h2 i hi
    have := hw i
    have := h3 i
    nlinarith
  · have : μ i = 0 := le_antisymm (h4 i hi) (h3 i)
    simp [this]

theorem row_kkt {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {m : ℕ} (a : Fin m → E) (b : Fin m → ℝ) (M : E →L[ℝ] E) (q : E)
    (I : Finset (Fin m)) (z w : E) (hI : ∀ i, i ∈ I ↔ ⟪a i, w⟫ = b i)
    (hw : ∀ i, ⟪a i, w⟫ ≤ b i)
    (hvi : ∀ w' : E, (∀ i, ⟪a i, w'⟫ ≤ b i) → ⟪z - (M z + q) - w, w' - w⟫ ≤ 0) :
    ∃ μ : EuclideanSpace ℝ (Fin m), ∀ k, ⟪rowA a M I k, WithLp.toLp 2 (w, μ)⟫ ≤
        rowc b q I (M (w - z) - (w - z)) k := by
  classical
  obtain ⟨lam, hl0, hlI, hg⟩ := kkt a b w (z - (M z + q) - w) hw hvi
  refine ⟨WithLp.toLp 2 lam, ?_⟩
  rintro (i | i | i | i | ⟨j, s⟩)
  · simpa [rowA, rowc, WithLp.prod_inner_apply] using hw i
  · by_cases hi : i ∈ I
    · simp [rowA, rowc, hi, WithLp.prod_inner_apply, (hI i).1 hi]
    · simp [rowA, rowc, hi]
  · simp [rowA, rowc, WithLp.prod_inner_apply, EuclideanSpace.inner_single_left, hl0 i]
  · by_cases hi : i ∈ I
    · simp [rowA, rowc, hi]
    · have hne : ⟪a i, w⟫ ≠ b i := fun h => hi ((hI i).2 h)
      have : lam i = 0 := hlI i (lt_of_le_of_ne (hw i) hne)
      simp [rowA, rowc, hi, WithLp.prod_inner_apply, EuclideanSpace.inner_single_left, this]
  · rw [row_eq]
    have : M w + ∑ i, (WithLp.toLp 2 lam : EuclideanSpace ℝ (Fin m)) i • a i =
        M (w - z) - (w - z) - q := by
      have hs : ∑ i, (WithLp.toLp 2 lam : EuclideanSpace ℝ (Fin m)) i • a i =
          ∑ i, lam i • a i := rfl
      rw [hs, ← hg, map_sub]
      abel
    rw [this]
    simp [rowc]

end AviAux

namespace DualAux

theorem infDist_fst' {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] {S : Set E} {T : Set (WithLp 2 (E × F))}
    (hT : T.Nonempty) (hTS : ∀ p ∈ T, (WithLp.ofLp p).1 ∈ S) (x : E) (μ : F) :
    Metric.infDist x S ≤ Metric.infDist (WithLp.toLp 2 (x, μ)) T := by
  refine (Metric.le_infDist hT).2 fun p hp => ?_
  refine (Metric.infDist_le_dist_of_mem (hTS p hp)).trans ?_
  rw [dist_eq_norm, dist_eq_norm, WithLp.prod_norm_eq_of_L2]
  refine Real.le_sqrt_of_sq_le ?_
  have : (WithLp.toLp 2 (x, μ) - p).fst = x - (WithLp.ofLp p).1 := by simp
  rw [this]
  nlinarith [sq_nonneg ‖(WithLp.toLp 2 (x, μ) - p).snd‖]

/-- quadratic growth at a maximizer of `⟪t, ·⟫ - g` over a polyhedron (g strongly convex) -/
theorem qgrowth {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] {r : ℕ}
    {ay : Fin r → F} {by' : Fin r → ℝ} {g : F → ℝ} {μ : ℝ}
    (hsc : StrongConvexOn Set.univ μ g) (t y : F) (hy : ∀ i, ⟪ay i, y⟫ ≤ by' i)
    (hmax : ∀ y', (∀ i, ⟪ay i, y'⟫ ≤ by' i) → ⟪t, y'⟫ - g y' ≤ ⟪t, y⟫ - g y)
    (y' : F) (hy' : ∀ i, ⟪ay i, y'⟫ ≤ by' i) :
    ⟪t, y'⟫ - g y' + μ / 4 * ‖y' - y‖ ^ 2 ≤ ⟪t, y⟫ - g y := by
  have hm : ∀ i, ⟪ay i, (1 / 2 : ℝ) • y + (1 / 2 : ℝ) • y'⟫ ≤ by' i := by
    intro i
    rw [inner_add_right, real_inner_smul_right, real_inner_smul_right]
    linarith [hy i, hy' i]
  have h1 := hmax _ hm
  have h2 := hsc.2 (Set.mem_univ y) (Set.mem_univ y') (by norm_num : (0 : ℝ) ≤ 1 / 2)
    (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num)
  simp only [smul_eq_mul] at h2
  rw [inner_add_right, real_inner_smul_right, real_inner_smul_right] at h1
  rw [norm_sub_rev] at h2
  nlinarith

theorem cocoerc {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] {r : ℕ}
    {ay : Fin r → F} {by' : Fin r → ℝ} {g : F → ℝ} {μ : ℝ}
    (hsc : StrongConvexOn Set.univ μ g) (t t' y y' : F) (hy : ∀ i, ⟪ay i, y⟫ ≤ by' i)
    (hy' : ∀ i, ⟪ay i, y'⟫ ≤ by' i)
    (hmax : ∀ y'', (∀ i, ⟪ay i, y''⟫ ≤ by' i) → ⟪t, y''⟫ - g y'' ≤ ⟪t, y⟫ - g y)
    (hmax' : ∀ y'', (∀ i, ⟪ay i, y''⟫ ≤ by' i) → ⟪t', y''⟫ - g y'' ≤ ⟪t', y'⟫ - g y') :
    μ / 2 * ‖y - y'‖ ^ 2 ≤ ⟪t - t', y - y'⟫ := by
  have e1 := qgrowth hsc t y hy hmax y' hy'
  have e2 := qgrowth hsc t' y' hy' hmax' y hy
  rw [norm_sub_rev] at e1
  simp only [inner_sub_left, inner_sub_right]
  linarith

theorem vi_of_max {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    {r : ℕ} {ay : Fin r → F} {by' : Fin r → ℝ} {g : F → ℝ} {μ : ℝ} {Lg : NNReal} (hμ : 0 < μ)
    (hsc : StrongConvexOn Set.univ μ g) (hdiff : Differentiable ℝ g)
    (hlip : LipschitzWith Lg (gradient g)) (t y : F) (hy : ∀ i, ⟪ay i, y⟫ ≤ by' i)
    (hmax : ∀ y', (∀ i, ⟪ay i, y'⟫ ≤ by' i) → ⟪t, y'⟫ - g y' ≤ ⟪t, y⟫ - g y)
    (y'' : F) (hy'' : ∀ i, ⟪ay i, y''⟫ ≤ by' i) :
    ⟪t - gradient g y, y'' - y⟫ ≤ 0 := by
  have hgg : ∀ x, HasGradientAt g (gradient g x) x := fun x => (hdiff x).hasGradientAt
  have hcvx : ConvexOn ℝ Set.univ g := (hsc.strictConvexOn hμ).convexOn
  set d := y'' - y with hd
  have step : ∀ s : ℝ, 0 < s → s ≤ 1 → ⟪t - gradient g y, d⟫ ≤ Lg * s * ‖d‖ ^ 2 := by
    intro s hs0 hs1
    have hys : ∀ i, ⟪ay i, y + s • d⟫ ≤ by' i := by
      intro i
      rw [inner_add_right, real_inner_smul_right, hd, inner_sub_right]
      have := hy i; have := hy'' i
      nlinarith
    have m1 := hmax _ hys
    have fo := CompAux.ca_convex_fo hgg hcvx (y + s • d) y
    have e : y - (y + s • d) = -(s • d) := by abel
    rw [e, inner_neg_right, real_inner_smul_right] at fo
    have l1 : ‖gradient g (y + s • d) - gradient g y‖ ≤ Lg * ‖(y + s • d) - y‖ :=
      hlip.norm_sub_le _ _
    rw [add_sub_cancel_left, norm_smul, Real.norm_eq_abs, abs_of_pos hs0] at l1
    have l2 := real_inner_le_norm (gradient g (y + s • d) - gradient g y) d
    have l3 : ‖gradient g (y + s • d) - gradient g y‖ * ‖d‖ ≤ Lg * (s * ‖d‖) * ‖d‖ :=
      mul_le_mul_of_nonneg_right l1 (norm_nonneg _)
    rw [inner_sub_left] at l2
    rw [inner_add_right, real_inner_smul_right] at m1
    rw [inner_sub_left]
    have key : s * (⟪t, d⟫ - ⟪gradient g y, d⟫) ≤ s * (Lg * s * ‖d‖ ^ 2) := by nlinarith
    exact le_of_mul_le_mul_left key hs0
  by_contra hcon
  push_neg at hcon
  set v := ⟪t - gradient g y, d⟫
  set K := (Lg : ℝ) * ‖d‖ ^ 2 + 1 with hK
  have hK0 : 0 < K := by positivity
  set s := min 1 (v / (2 * K)) with hs
  have hs0 : 0 < s := lt_min one_pos (by positivity)
  have hs1 : s ≤ 1 := min_le_left _ _
  have hs2 : s ≤ v / (2 * K) := min_le_right _ _
  have h1 := step s hs0 hs1
  have h2 : (Lg : ℝ) * s * ‖d‖ ^ 2 ≤ K * s := by
    have : 0 ≤ (Lg : ℝ) * ‖d‖ ^ 2 := by positivity
    nlinarith
  have h3 : K * s ≤ v / 2 := by
    have := mul_le_mul_of_nonneg_left hs2 hK0.le
    rw [show K * (v / (2 * K)) = v / 2 by field_simp] at this
    exact this
  linarith

theorem max_of_kkt {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    {r : ℕ} {ay : Fin r → F} {by' : Fin r → ℝ} {g : F → ℝ}
    (hgg : ∀ x, HasGradientAt g (gradient g x) x) (hcvx : ConvexOn ℝ Set.univ g)
    (t y : F) (lam : Fin r → ℝ) (hl0 : ∀ i, 0 ≤ lam i)
    (hcomp : ∀ i, lam i * (by' i - ⟪ay i, y⟫) = 0)
    (heq : t - gradient g y = ∑ i, lam i • ay i) (y' : F) (hy' : ∀ i, ⟪ay i, y'⟫ ≤ by' i) :
    ⟪t, y'⟫ - g y' ≤ ⟪t, y⟫ - g y := by
  have fo := CompAux.ca_convex_fo hgg hcvx y y'
  have hs : ⟪t - gradient g y, y' - y⟫ ≤ 0 := by
    rw [heq, sum_inner]
    refine Finset.sum_nonpos fun i _ => ?_
    rw [real_inner_smul_left, inner_sub_right]
    have := hcomp i; have := hy' i; have := hl0 i
    nlinarith
  rw [inner_sub_left, inner_sub_right, inner_sub_right] at hs
  rw [inner_sub_right] at fo
  linarith

theorem danskin {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]
    (L : E →L[ℝ] F) (q : E) (h : E → ℝ) (g : F → ℝ) (yf : E → F) (C : ℝ) (hC : 0 ≤ C)
    (hval : ∀ z, h z - ⟪q, z⟫ = ⟪L z, yf z⟫ - g (yf z))
    (hmax : ∀ z z', ⟪L z, yf z'⟫ - g (yf z') ≤ h z - ⟪q, z⟫)
    (hlip : ∀ z z', ‖yf z' - yf z‖ ≤ C * ‖L z' - L z‖) (z : E) :
    HasGradientAt h (ContinuousLinearMap.adjoint L (yf z) + q) z := by
  rw [hasGradientAt_iff_hasFDerivAt, hasFDerivAt_iff_isLittleO_nhds_zero]
  have hR : ∀ d : E, |h (z + d) - h z -
      (InnerProductSpace.toDual ℝ E (ContinuousLinearMap.adjoint L (yf z) + q)) d| ≤
        (C * ‖L‖ ^ 2) * ‖d‖ ^ 2 := by
    intro d
    rw [InnerProductSpace.toDual_apply_apply, inner_add_left,
      ContinuousLinearMap.adjoint_inner_left]
    have e1 := hmax (z + d) z
    have e2 := hmax z (z + d)
    have v1 := hval z
    have v2 := hval (z + d)
    have hl := hlip z (z + d)
    have hLd : L (z + d) - L z = L d := by rw [map_add]; abel
    rw [hLd] at hl
    rw [map_add, inner_add_left, inner_add_right] at e1 v2
    have c1 := real_inner_le_norm (L d) (yf (z + d) - yf z)
    rw [inner_sub_right] at c1
    have c2 : ‖L d‖ * ‖yf (z + d) - yf z‖ ≤ ‖L d‖ * (C * ‖L d‖) :=
      mul_le_mul_of_nonneg_left hl (norm_nonneg _)
    have c3 : ‖L d‖ ≤ ‖L‖ * ‖d‖ := L.le_opNorm d
    have c4 : ‖L d‖ ^ 2 ≤ (‖L‖ * ‖d‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) c3 2
    have c5 : C * ‖L d‖ ^ 2 ≤ C * (‖L‖ * ‖d‖) ^ 2 := mul_le_mul_of_nonneg_left c4 hC
    have hcomm : ⟪yf z, L d⟫ = ⟪L d, yf z⟫ := real_inner_comm _ _
    rw [hcomm, abs_le]
    constructor <;> nlinarith [c1, c2, c5]
  have hO : (fun d : E => h (z + d) - h z -
      (InnerProductSpace.toDual ℝ E (ContinuousLinearMap.adjoint L (yf z) + q)) d) =O[nhds 0]
        (fun d : E => ‖d‖ ^ 2) :=
    Asymptotics.IsBigO.of_bound (C * ‖L‖ ^ 2) (Filter.Eventually.of_forall fun d => by
      rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (by positivity : (0 : ℝ) ≤ ‖d‖ ^ 2)]
      exact hR d)
  exact hO.trans_isLittleO (Asymptotics.isLittleO_norm_pow_id (by norm_num))

def dsgn (s : Bool) : ℝ := if s then 1 else -1

theorem dsgn_le {x B : ℝ} (s : Bool) (h : |x| ≤ B) : dsgn s * x ≤ B := by
  have h' := abs_le.1 h
  cases s <;> simp [dsgn] <;> linarith [h'.1, h'.2]

abbrev DRix (m r d : ℕ) := Fin m ⊕ Unit ⊕ Fin r ⊕ Unit ⊕ (Fin d × Bool)

noncomputable def drowA {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    {m r : ℕ} (a : Fin m → E) (ay : Fin r → F) (L : E →L[ℝ] F) (G : E) (sl : Fin r → ℝ) :
    DRix m r (Module.finrank ℝ F) → WithLp 2 (E × EuclideanSpace ℝ (Fin r))
  | .inl i => WithLp.toLp 2 (a i, 0)
  | .inr (.inl _) => WithLp.toLp 2 (G, 0)
  | .inr (.inr (.inl i)) => WithLp.toLp 2 (0, -EuclideanSpace.single i 1)
  | .inr (.inr (.inr (.inl _))) => WithLp.toLp 2 (0, WithLp.toLp 2 sl)
  | .inr (.inr (.inr (.inr (j, s)))) => dsgn s • WithLp.toLp 2
      (ContinuousLinearMap.adjoint (-L) (stdOrthonormalBasis ℝ F j),
        WithLp.toLp 2 (fun i => ⟪ay i, stdOrthonormalBasis ℝ F j⟫))

noncomputable def drowc {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]
    [FiniteDimensional ℝ F] {m r : ℕ} (b : Fin m → ℝ) (s0 : ℝ) (cc : F) :
    DRix m r (Module.finrank ℝ F) → ℝ
  | .inl i => b i
  | .inr (.inl _) => s0
  | .inr (.inr (.inl _)) => 0
  | .inr (.inr (.inr (.inl _))) => 0
  | .inr (.inr (.inr (.inr (j, s)))) => dsgn s * ⟪stdOrthonormalBasis ℝ F j, cc⟫

theorem drow_eq {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    {m r : ℕ} (a : Fin m → E) (ay : Fin r → F) (L : E →L[ℝ] F) (G : E) (sl : Fin r → ℝ)
    (j : Fin (Module.finrank ℝ F)) (s : Bool) (u : E) (μ : EuclideanSpace ℝ (Fin r)) :
    ⟪drowA a ay L G sl (.inr (.inr (.inr (.inr (j, s))))), WithLp.toLp 2 (u, μ)⟫ =
      dsgn s * ⟪stdOrthonormalBasis ℝ F j, (-L) u + ∑ i, μ i • ay i⟫ := by
  show ⟪dsgn s • WithLp.toLp 2 (ContinuousLinearMap.adjoint (-L) (stdOrthonormalBasis ℝ F j),
      (WithLp.toLp 2 (fun i => ⟪ay i, stdOrthonormalBasis ℝ F j⟫) : EuclideanSpace ℝ (Fin r))),
      WithLp.toLp 2 (u, μ)⟫ = _
  rw [real_inner_smul_left, WithLp.prod_inner_apply]
  simp only [WithLp.ofLp_toLp, ContinuousLinearMap.adjoint_inner_left, inner_add_right, inner_sum,
    real_inner_smul_right, PiLp.inner_apply, PiLp.toLp_apply]
  congr 2
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [RCLike.inner_apply, conj_trivial, real_inner_comm]

theorem drow_compl {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
    {m r : ℕ} (a : Fin m → E) (ay : Fin r → F) (L : E →L[ℝ] F) (G : E) (sl : Fin r → ℝ)
    (u : E) (μ : EuclideanSpace ℝ (Fin r)) :
    ⟪drowA a ay L G sl (.inr (.inr (.inr (.inl ())))), WithLp.toLp 2 (u, μ)⟫ =
      ∑ i, sl i * μ i := by
  show ⟪(WithLp.toLp 2 ((0 : E), (WithLp.toLp 2 sl : EuclideanSpace ℝ (Fin r))) :
      WithLp 2 (E × EuclideanSpace ℝ (Fin r))), WithLp.toLp 2 (u, μ)⟫ = _
  rw [WithLp.prod_inner_apply]
  simp only [WithLp.ofLp_toLp, inner_zero_left, zero_add, PiLp.inner_apply, PiLp.toLp_apply]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [RCLike.inner_apply, conj_trivial, mul_comm]

end DualAux

open LuoTseng.ErrorBound in
theorem L7c_avi : ∀ (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E]
    (m : ℕ) (a : Fin m → E) (b : Fin m → ℝ) (M : E →L[ℝ] E) (q : E),
    (solSet (poly a b) (fun z => M z + q)).Nonempty →
    ∃ τ > 0, ∃ ε > 0, ∀ z w : E, z ∈ poly a b → IsProjRes (poly a b) (fun z => M z + q) z w →
      ‖w - z‖ ≤ ε →
        Metric.infDist z (solSet (poly a b) (fun z => M z + q)) ≤ τ * ‖w - z‖ := by
  intro E _ _ _ m a b M q _
  classical
  have hI := fun I : Finset (Fin m) =>
    AviAux.perI (AviAux.rowA a M I) (AviAux.rowc b q I) (AviAux.rowc_diff b q I)
  choose κ hκ ε hε hb using hI
  have hN : (0 : ℝ) ≤ Fintype.card (AviAux.Rix m (Module.finrank ℝ E)) := Nat.cast_nonneg _
  set N : ℝ := (Fintype.card (AviAux.Rix m (Module.finrank ℝ E)) : ℝ) with hNdef
  set K := ∑ I, κ I with hKdef
  have hK : 0 ≤ K := Finset.sum_nonneg fun I _ => (hκ I).le
  set ε0 := Finset.univ.inf' Finset.univ_nonempty ε with hε0def
  have hε0 : 0 < ε0 := (Finset.lt_inf'_iff _).2 fun I _ => hε I
  refine ⟨1 + K * N * (‖M‖ + 1), by positivity, ε0 / (‖M‖ + 2), by positivity,
    fun z w _ hproj hr => ?_⟩
  obtain ⟨hw, hvi⟩ := hproj
  set I := Finset.univ.filter fun i => ⟪a i, w⟫ = b i with hIdef
  obtain ⟨μ, hμ⟩ := AviAux.row_kkt a b M q I z w (fun i => by simp [I]) hw
    (fun w' hw' => hvi w' hw')
  set v := M (w - z) - (w - z) with hvdef
  have hv : ‖v‖ ≤ (‖M‖ + 1) * ‖w - z‖ := by
    calc ‖v‖ ≤ ‖M (w - z)‖ + ‖w - z‖ := norm_sub_le _ _
      _ ≤ ‖M‖ * ‖w - z‖ + ‖w - z‖ := by gcongr; exact M.le_opNorm _
      _ = _ := by ring
  have hvε : ‖v‖ < ε I := by
    have h1 : ε0 ≤ ε I := Finset.inf'_le _ (Finset.mem_univ I)
    have h2 : (‖M‖ + 1) * (ε0 / (‖M‖ + 2)) < ε0 := by
      rw [mul_div_assoc', div_lt_iff₀ (by positivity)]; nlinarith [norm_nonneg M]
    calc ‖v‖ ≤ (‖M‖ + 1) * ‖w - z‖ := hv
      _ ≤ (‖M‖ + 1) * (ε0 / (‖M‖ + 2)) := by gcongr
      _ < ε0 := h2
      _ ≤ ε I := h1
  obtain ⟨hne, hdist⟩ := hb I v _ hvε hμ
  have hfst := AviAux.infDist_fst' (S := solSet (poly a b) (fun z => M z + q)) hne
    (fun p hp => by
      obtain ⟨⟨u, μ'⟩⟩ := p
      exact AviAux.row_sol a b M q I u μ' hp) w μ
  have hκK : κ I ≤ K := Finset.single_le_sum (fun J _ => (hκ J).le) (Finset.mem_univ I)
  have hwz := norm_nonneg (w - z)
  calc Metric.infDist z (solSet (poly a b) (fun z => M z + q))
      ≤ Metric.infDist w (solSet (poly a b) (fun z => M z + q)) + dist z w :=
        Metric.infDist_le_infDist_add_dist
    _ ≤ κ I * (N * ‖v‖) + ‖w - z‖ := by
        rw [dist_comm, dist_eq_norm]; linarith [hfst.trans hdist]
    _ ≤ K * (N * ((‖M‖ + 1) * ‖w - z‖)) + ‖w - z‖ := by
        gcongr
    _ = (1 + K * N * (‖M‖ + 1)) * ‖w - z‖ := by ring


