theorem solution (j : ℝ) {R : ℝ} (hR : 3 < R) :
    D3zf j R = deriv (zA j) R * (P R * deriv (b1f j) R) + zA j R * D1f j R := by
  have htot : HasDerivAt (fun s : ℝ => zA j s * (P s * deriv (b1f j) s))
      (deriv (zA j) R * (P R * deriv (b1f j) R)
        + zA j R * deriv (fun s => P s * deriv (b1f j) s) R) R :=
    (diffAt_zA_Ioi j hR).hasDerivAt.mul
      ((diffAt_m0_three hR).mul (diffAt_deriv_b1f j hR)).hasDerivAt
  have hstep1 : (fun s : ℝ => m0 3 1 s * (zA j s * deriv (b1f j) s))
      =ᶠ[𝓝 R] fun s => zA j s * (P s * deriv (b1f j) s) := by
    filter_upwards with s
    unfold m0 P
    ring
  rw [show D3zf j R
      = deriv (fun s : ℝ => m0 3 1 s * (zA j s * deriv (b1f j) s)) R from rfl]
  rw [hstep1.deriv_eq, htot.deriv]
  rfl
