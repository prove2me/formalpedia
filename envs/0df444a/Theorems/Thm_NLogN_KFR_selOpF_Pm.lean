theorem NLogN.KFR.selOpF_Pm {m r : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ] (st : Fin m × κ → ℕ) (n : ℕ)
    (i j : Fin m) (xs : List (Fin r → ℂ)) :
    selOpF st n (Pm i j : Butterfly.Op (Fin m × κ)) xs =
      (List.range n).map fun q => xs.getD (fset st q (rowAddr i j (fbit st q))) 0 := by sorry
