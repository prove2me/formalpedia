theorem psiInvPt_psiPt (x : SchemeHomOver (genPt p) O.g) :
    psiInvPt p M H hpM hj 𝔛 A hA Λ O hD Λ' O' hD' (psiPt p M H hpM hj 𝔛 A hA Λ O hD Λ' O' hD' x) = x := by
