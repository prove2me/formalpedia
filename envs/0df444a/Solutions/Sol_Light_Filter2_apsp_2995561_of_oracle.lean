  have h2 : (needo [x.n, x.U, Light.Filter2.sOf x.n, p]).cells ≤ Light.Filter2.supC needo x.n x.U :=
    Finset.le_sup (f := fun p => (needo [x.n, x.U, Light.Filter2.sOf x.n, p]).cells) hmem
  have h3 : (needo [x.n, x.U, Light.Filter2.sOf x.n, p]).depth ≤ Light.Filter2.supD needo x.n x.U :=
    Finset.le_sup (f := fun p => (needo [x.n, x.U, Light.Filter2.sOf x.n, p]).depth) hmem
  exact ⟨le_trans (by push_cast; omega) hw, by omega, hs, by omega⟩

theorem filter_solves {P : Program} {po : ℕ} {To : List ℕ → ℕ} {needo : List ℕ → Light.Need}
    (hsol : SolvesN Light.Filter2.oracleTask P po To needo) :
    Solves aeTask (P ++ Light.Filter2.hostProcs P.length po) (P.length + 18) (Light.Filter2.filterTime To) (Light.Filter2.filterNeed needo) := by
  refine ⟨_, by rw [List.getElem?_append_right (by omega), Nat.add_sub_cancel_left]; rfl,
    fun R lim d x μ fr hpre hok => ?_⟩
  have E := env_of_ok (needo := needo) hpre hok
  have g := fun i (hi : i < 19) => get_host (P := P) (R := R) (po := po) hi
  rw [List.append_assoc]
  have HPa : Light.Filter2.ParamProcs (P ++ (Light.Filter2.hostProcs P.length po ++ R)) (P.length + 11) (P.length + 12)
      (P.length + 13) (P.length + 14) := by
    refine ⟨?_, ?_, ?_, ?_⟩ <;> rw [← List.append_assoc]
    · exact (g 11 (by omega)).trans rfl
    · exact (g 12 (by omega)).trans rfl
    · exact (g 13 (by omega)).trans rfl
    · exact (g 14 (by omega)).trans rfl
  have gg : ∀ i (hi : i < 19), (P ++ (Light.Filter2.hostProcs P.length po ++ R))[P.length + i]? =
      (Light.Filter2.hostProcs P.length po)[i]? := fun i hi => by rw [← List.append_assoc]; exact g i hi
  have HT : Light.Filter2.TopProcs (P ++ (Light.Filter2.hostProcs P.length po ++ R)) (P.length + 15) (P.length + 16)
      (P.length + 17) := ⟨gg 15 (by omega), gg 16 (by omega), gg 17 (by omega)⟩
  have HP : Light.Filter2.RoundProcs (P ++ (Light.Filter2.hostProcs P.length po ++ R)) po P.length (P.length + 5)
      (P.length + 4) (P.length + 1) (P.length + 2) (P.length + 3) :=
    ⟨gg 5 (by omega), ⟨(gg 0 (by omega)).trans rfl, gg 1 (by omega), gg 2 (by omega),
      gg 3 (by omega)⟩, gg 4 (by omega)⟩
  have HF : Light.Filter2.FinalProcs (P ++ (Light.Filter2.hostProcs P.length po ++ R)) (P.length + 9) (P.length + 8)
      (P.length + 7) := ⟨gg 9 (by omega), gg 8 (by omega), gg 7 (by omega)⟩
  exact top_spec hsol HPa HT (gg 10 (by omega)) (gg 6 (by omega)) HP HF E

theorem two_pow_kOf_le (n : ℕ) : 2 ^ Light.Filter2.kOf n ≤ 2 * n + 1 := by
  unfold Light.Filter2.kOf
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp
  · have h1 : 1 ≤ Nat.size n := Nat.size_pos.2 hn
    have h2 : 2 ^ (Nat.size n - 1) ≤ n := Nat.lt_size.1 (by omega)
    have : 2 ^ Nat.size n = 2 * 2 ^ (Nat.size n - 1) := by
      rw [← pow_succ']; congr 1; omega
    omega

theorem exp_Pmax_le (n : ℕ) : (Light.Filter2.ellOf n + 1) * Light.Filter2.rOf n ≤ 11 * Light.Filter2.kOf n + 8 := by
  have hq : Nat.sqrt (Light.Filter2.kOf n) * Nat.sqrt (Light.Filter2.kOf n) ≤ Light.Filter2.kOf n := Nat.sqrt_le _
  have hqk : Nat.sqrt (Light.Filter2.kOf n) ≤ Light.Filter2.kOf n := Nat.sqrt_le_self _
  have hl : Light.Filter2.ellOf n = Nat.sqrt (Light.Filter2.kOf n) + 1 := rfl
  have hl1 := ellOf_pos n
  have hsl : Nat.sqrt (Light.Filter2.ellOf n) ≤ Light.Filter2.ellOf n := Nat.sqrt_le_self _
  have hb : Light.Filter2.bOf n ≤ 4 * Light.Filter2.kOf n + 2 := by
    unfold Light.Filter2.bOf
    calc Light.Filter2.ellOf n * (Nat.sqrt (Light.Filter2.ellOf n) + 1) ≤ Light.Filter2.ellOf n * (Light.Filter2.ellOf n + 1) :=
          Nat.mul_le_mul_left _ (by omega)
      _ ≤ 4 * Light.Filter2.kOf n + 2 := by rw [hl]; nlinarith
  have he : 336175 * Light.Filter2.kOf n / 10 ^ 7 ≤ Light.Filter2.kOf n := by
    rw [Nat.div_le_iff_le_mul_add_pred (by norm_num)]; omega
  have hcK : Light.Filter2.cKOf n ≤ Light.Filter2.kOf n + 1 := by
    unfold Light.Filter2.cKOf Light.Filter2.sOf
    exact Nat.size_le.2 (Nat.pow_lt_pow_right (by norm_num) (by omega))
  have hr : (Light.Filter2.ellOf n + 1) * Light.Filter2.rOf n ≤ 2 * (Light.Filter2.cKOf n + Light.Filter2.bOf n) + Light.Filter2.ellOf n + 1 := by
    unfold Light.Filter2.rOf
    have h1 : Light.Filter2.ellOf n * ((Light.Filter2.cKOf n + Light.Filter2.bOf n) / Light.Filter2.ellOf n) ≤ Light.Filter2.cKOf n + Light.Filter2.bOf n :=
      Nat.mul_div_le _ _
    have h3 : (Light.Filter2.cKOf n + Light.Filter2.bOf n) / Light.Filter2.ellOf n ≤ Light.Filter2.ellOf n * ((Light.Filter2.cKOf n + Light.Filter2.bOf n) / Light.Filter2.ellOf n) :=
      Nat.le_mul_of_pos_left _ hl1
    generalize (Light.Filter2.cKOf n + Light.Filter2.bOf n) / Light.Filter2.ellOf n = q at *
    calc (Light.Filter2.ellOf n + 1) * (q + 1) =
          Light.Filter2.ellOf n * q + q + Light.Filter2.ellOf n + 1 := by ring
      _ ≤ _ := by omega
  omega

/-- **The largest modulus is polynomial in `n`**: `Pmax ≤ 2^8 (2n + 1)^11`. -/
theorem Pmax_le (n : ℕ) : Light.Filter2.PmaxOf n ≤ 2 ^ 8 * (2 * n + 1) ^ 11 := by
  unfold Light.Filter2.PmaxOf Light.Filter2.RR
  calc (2 * 2 ^ Light.Filter2.ellOf n) ^ Light.Filter2.rOf n = 2 ^ ((Light.Filter2.ellOf n + 1) * Light.Filter2.rOf n) := by rw [← pow_succ', ← pow_mul]
    _ ≤ 2 ^ (11 * Light.Filter2.kOf n + 8) := Nat.pow_le_pow_right (by norm_num) (exp_Pmax_le n)
    _ = 2 ^ 8 * (2 ^ Light.Filter2.kOf n) ^ 11 := by ring
    _ ≤ 2 ^ 8 * (2 * n + 1) ^ 11 := by gcongr; exact two_pow_kOf_le n

theorem RR_le_Pmax (n : ℕ) : Light.Filter2.RR n ≤ Light.Filter2.PmaxOf n := by
  unfold Light.Filter2.PmaxOf
  have h1 : 1 ≤ Light.Filter2.rOf n := Nat.le_add_left 1 _
  calc Light.Filter2.RR n ≤ 2 * Light.Filter2.RR n := by omega
    _ = (2 * Light.Filter2.RR n) ^ 1 := (pow_one _).symm
    _ ≤ (2 * Light.Filter2.RR n) ^ Light.Filter2.rOf n := Nat.pow_le_pow_right (by have := RR_two_le n; omega) h1

theorem sOf_le_succ (n : ℕ) : Light.Filter2.sOf n ≤ 2 * n + 1 := by
  unfold Light.Filter2.sOf
  have he : 336175 * Light.Filter2.kOf n / 10 ^ 7 ≤ Light.Filter2.kOf n := by
    rw [Nat.div_le_iff_le_mul_add_pred (by norm_num)]; omega
  exact (Nat.pow_le_pow_right (by norm_num) he).trans (two_pow_kOf_le n)

theorem polyBound_le_oBound {s0 k0 n U p : ℕ} (hp : p ≤ Light.Filter2.PmaxOf n) :
    polyBound s0 k0 [n, U, Light.Filter2.sOf n, p] ≤ Light.Filter2.oBound s0 k0 n U := by
  unfold polyBound Light.Filter2.oBound
  simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil]
  have h1 := sOf_le_succ n
  have h2 := hp.trans (Pmax_le n)
  refine Nat.mul_le_mul_left _ (Nat.pow_le_pow_left ?_ k0)
  exact Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _
    (Nat.mul_le_mul (by omega) (Nat.mul_le_mul_right 1 (by omega))))

theorem aTOP0_le (n : ℕ) : Light.Filter2.aTOP n 0 + 2 * Light.Filter2.RR n ≤ 12 * ((Light.Filter2.PmaxOf n + 1) * (n + 1) ^ 3) := by
  have hm := mOf_le n
  have hR := RR_le_Pmax n
  have h3 : (n + 1) ^ 3 = (n + 1) * (n + 1) * (n + 1) := by ring
  have hX1 : 1 ≤ (n + 1) ^ 3 := Nat.one_le_pow _ _ (by omega)
  have hnn : n * n ≤ (n + 1) ^ 3 :=
    calc n * n ≤ (n + 1) * (n + 1) := Nat.mul_le_mul (by omega) (by omega)
      _ ≤ (n + 1) * (n + 1) * (n + 1) := Nat.le_mul_of_pos_right _ (by omega)
      _ = (n + 1) ^ 3 := by ring
  have hmn : Light.Filter2.mOf n * (n * n) ≤ (n + 1) ^ 3 :=
    calc Light.Filter2.mOf n * (n * n) ≤ n * (n * n) := Nat.mul_le_mul_right _ hm
      _ = n ^ 3 := by ring
      _ ≤ (n + 1) ^ 3 := Nat.pow_le_pow_left (by omega) 3
  have hRX : Light.Filter2.RR n ≤ (Light.Filter2.PmaxOf n + 1) * (n + 1) ^ 3 := by
    calc Light.Filter2.RR n ≤ (Light.Filter2.PmaxOf n + 1) * 1 := by omega
      _ ≤ _ := Nat.mul_le_mul_left _ hX1
  have hRN : Light.Filter2.RR n * (n * n) ≤ (Light.Filter2.PmaxOf n + 1) * (n + 1) ^ 3 :=
    Nat.mul_le_mul (by omega) hnn
  have hX : (n + 1) ^ 3 ≤ (Light.Filter2.PmaxOf n + 1) * (n + 1) ^ 3 := Nat.le_mul_of_pos_left _ (by omega)
  have e : 2 * Light.Filter2.RR n * (n * n) = 2 * (Light.Filter2.RR n * (n * n)) := by ring
  unfold Light.Filter2.aTOP Light.Filter2.aGT Light.Filter2.aCNT Light.Filter2.aUA Light.Filter2.aDONE Light.Filter2.aACT Light.Filter2.LL
  omega

