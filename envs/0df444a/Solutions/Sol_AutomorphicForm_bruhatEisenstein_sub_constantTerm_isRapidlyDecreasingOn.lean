private theorem expansion (kv : Fin n → K) (hb : ∀ i, b i = tv K φ (kv i)) (θ : ℝ) (x : G) :
    φ (x * ρ θ) = ∑ i, coef K φ ρ hρK b i θ * φ (x * (kv i : G)) := by
