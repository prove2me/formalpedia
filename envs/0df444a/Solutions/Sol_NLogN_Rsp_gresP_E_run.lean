theorem sOff_idx (s m c i : ℕ) (hs : 0 < s) :
    (((c : ℤ) - (m : ℤ) + (i : ℤ)) % (s : ℤ)).toNat = (sOff s m + c + i) % s := by
  have hdv : (sOff s m + m) % s = 0 := by
    unfold sOff
    rw [Nat.mod_add_mod, ← Nat.add_mod_mod, Nat.sub_add_cancel (Nat.mod_lt _ hs).le, Nat.mod_self]
  have e : ((sOff s m + c + i : ℕ) : ℤ) % (s : ℤ) = ((c : ℤ) - (m : ℤ) + (i : ℤ)) % (s : ℤ) := by
    rw [Int.emod_eq_emod_iff_emod_sub_eq_zero]
    have : ((sOff s m + c + i : ℕ) : ℤ) - ((c : ℤ) - (m : ℤ) + (i : ℤ)) = ((sOff s m + m : ℕ) : ℤ) := by
      push_cast; ring
    rw [this, ← Int.natCast_mod, hdv]; rfl
  rw [← e, ← Int.natCast_mod, Int.toNat_natCast]

theorem cycL_getD (u : List ℤ) (a N j : ℕ) (hj : j < N) :
    (cycL u a N).getD j 0 = u.getD ((a + j) % u.length) 0 := by
  simp [cycL, List.getD_eq_getElem?_getD, hj]

end NLogN.Rsp

