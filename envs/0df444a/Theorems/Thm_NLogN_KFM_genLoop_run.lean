theorem NLogN.KFM.genLoop_run (i a : Fin HS) (n : Ex HS) (body : RS) (s : IState HS) (N : ℕ)
    (G : ℕ → ℤ → ℤ) (a0 : ℤ) (La : List Item) (hia : i ≠ a) (hi56 : i.val < 56)
    (hn : n.Clean) (hnok : n.ok s) (hN : n.eval s = N) (hw : i ∉ body.writes)
    (ha : s.G a = .int a0 :: La)
    (hb : ∀ k < N, body.ok (lpSt s i a La N k (accSeq G a0 k)) ∧
      body.run (lpSt s i a La N k (accSeq G a0 k)) =
        (lpSt s i a La N k (accSeq G a0 k)).upd a (.int (G k (accSeq G a0 k)) :: La)) :
    (rep i n body).ok s ∧ (rep i n body).run s = s.upd a (.int (accSeq G a0 N) :: La) := by sorry
