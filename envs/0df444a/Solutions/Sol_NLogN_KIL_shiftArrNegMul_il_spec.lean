      ((D.getD k 0 : ℕ) : ZMod Q) = ∑ j, if (Λ.pos j : ℕ) = k then c j * ((D.getD k 0 : ℕ) : ZMod Q)
        else 0 := by
    intro k hk
    rw [Finset.mem_range] at hk
    simp only [csOf, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hk,
      Option.map_some, Option.getD_some, ZMod.natCast_val, ZMod.cast_id', id, cfOf,
      Finset.sum_mul, ite_mul, zero_mul]
  rw [Finset.sum_congr rfl e, Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Finset.sum_ite_eq]
  split_ifs with h
  · rfl
  · rw [Finset.mem_range] at h
    rw [List.getD_eq_default _ _ (by omega)]; simp

theorem tbl_eq_offs [NeZero Q] (c : Fin n → ZMod Q) (A : Shape) :
    NLogN.KIL.tbl Q (A.zip (csOf Λ c A)) = (List.range (AModel.vol A)).map fun p => (offs Λ c A p : ℤ) := by
  rw [tbl_zip A _ (length_csOf Λ c A).symm]
  refine List.map_congr_left fun p _ => ?_
  rw [offs, ← lf_csOf Λ c A _ (length_decode A p), ZMod.val_natCast]
  push_cast; rfl

theorem csOf_lt [NeZero Q] (c : Fin n → ZMod Q) (A : Shape) :
    ∀ p ∈ A.zip (csOf Λ c A), p.2 < Q := by
  intro p hp
  have := List.of_mem_zip hp
  simp only [csOf, List.mem_map] at this
  obtain ⟨k, -, hk⟩ := this.2
  rw [← hk]; exact ZMod.val_lt _

