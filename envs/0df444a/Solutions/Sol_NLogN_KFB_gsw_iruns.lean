  generalize k / 2 ^ P % 2 = d3 at *
  generalize k / 2 ^ Q % 2 = d1 at *
  rw [eQ] at pPQ ⊢
  generalize 2 ^ (Q - P - 1) = B at *
  generalize 2 ^ P = a at *
  subst hd
  interval_cases d1 <;> interval_cases d3 <;> (try split_ifs) <;> ring_nf at pPQ ⊢ <;> (first | omega | contradiction)

