set_option autoImplicit false
set_option maxRecDepth 10000
open scoped ENNReal NNReal
namespace DecrAlmostLinearSSSP.Decremental.Native
open Structured
lemma globalFrame_reportDecode : GlobalFrame ReportDecode.code := by
  constructor
  · intro k hk
    simp only [globalNat,List.mem_cons,List.not_mem_nil,or_false] at hk
    rcases hk with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl
    all_goals apply ReportDecode.nat_frame <;> norm_num <;> try omega
    all_goals decide
  · intro k hk
    simp only [globalReal,List.mem_cons,List.not_mem_nil,or_false] at hk
    rcases hk with rfl|rfl
    all_goals apply ReportDecode.real_frame <;> norm_num <;> try omega
    all_goals decide
lemma decodedReportEvent_eval (i : Input) (hi : i.Valid) (p : Program) (B reserve N : ℕ) (hB : i.n ≤ B)
    (a : AdapterState i) (xs : List (Fin i.n)) (s : Data) (h : AdapterMemory i B reserve N a xs s)
    (hg : Globals i B (scaleLayout B i.n (scaleCount i) reserve N).utility s)
    (hp : ∀ z, PointerValid i a.maxima z (a.pointer z))
    (j : Fin (scaleCount i)) (v : Fin i.n) (g : Machine)
    (hsource : SourceMemory.Image B j.val s g.natMem g.realMem)
    (hnormal : ∀ z : Fin i.n, g.natMem z.val ≤ 1 ∧ (g.natMem z.val = 0 → 0 ≤ g.realMem z.val))
    (haddress : s.natReg 198 = bankAddress B j.val v.val) (hF : s.natReg 112 = bankFactor j.val)
    (hc : s.natReg 108 = cacheAt (pointerLayout B i.n (scaleCount i) reserve N).cache i.n j.val)
    (hd : s.realReg 70 = delta i j.val)
    (hptrbase : s.natReg 96 = (pointerLayout B i.n (scaleCount i) reserve N).pointer)
    (hflagbase : s.natReg 98 = (pointerLayout B i.n (scaleCount i) reserve N).flags) :
    ∃ cost t ys, Eval decodedReportEvent s cost t ∧
      cost ≤ (dispatchCharge ScaledCeiling.ceilingProgram.code+3)*(16*utilityDepth i.size+32)+
        13*((adapterWrite i a j v (stored g v.val)).pointer v-a.pointer v)+55 ∧
      AdapterMemory i B reserve N (adapterWrite i a j v (stored g v.val)) ys t ∧
      ys = (if v ∈ xs then xs else xs++[v]) ∧
      (∀ address, address ≠ cacheAt (pointerLayout B i.n (scaleCount i) reserve N).cache i.n j.val+2*v.val →
        ¬PointerArrayCell (pointerLayout B i.n (scaleCount i) reserve N) i.n address →
        (∀ r, address ≠ (scaleLayout B i.n (scaleCount i) reserve N).utility+2*r+1) →
        t.natMem address = s.natMem address ∧ t.realMem address = s.realMem address) := by
  have hvupper : (v.val : ℝ) ≤ (2 : ℝ)^utilityDepth i.size := by
    simpa only [report_real_index] using (public_report_decoding_bound i hi B j.val v.val v.isLt).2
  obtain ⟨cd,u,hu,huv,hcd,huframe⟩ := ReportDecode.eval_code s B j.val v.val (utilityDepth i.size)
    hg.base hF haddress hg.zeroN hg.zeroR hg.unit hvupper
  have humem : AdapterMemory i B reserve N a xs u := h.utility_frame hB
    (by intro address ha;apply huframe;rw [hg.utilityBase];intro r;omega)
    (hu.nat_frame (ReportDecode.nat_frame 182 (by omega) (by decide) (by omega) (by omega)))
    (hu.nat_frame (ReportDecode.nat_frame 180 (by omega) (by decide) (by omega) (by omega)))
  have hug := hg.transfer hu globalFrame_reportDecode
  obtain ⟨tail,htail⟩ := Layout.utility_even_offset B i.n (scaleCount i) reserve (2*N+8) (Layout.record_stride_even N)
  have husource : SourceMemory.Image B j.val u g.natMem g.realMem := by
    apply hsource.frame
    intro z
    exact huframe _ (by rw [hg.utilityBase,htail];exact ScaledCeiling.guest_bank_outside_utility_tail B j.val tail z)
  have hun (k : ℕ) (hk : 10 ≤ k) (hev : Even k) (h94 : k ≠ 94) (h58 : k ≠ 58) : u.natReg k = s.natReg k :=
    hu.nat_frame (ReportDecode.nat_frame k hk hev h94 h58)
  have huF := (hun 112 (by omega) (by decide) (by omega) (by omega)).trans hF
  have huC := (hun 108 (by omega) (by decide) (by omega) (by omega)).trans hc
  have huA := (hun 198 (by omega) (by decide) (by omega) (by omega)).trans haddress
  have hu96 := (hun 96 (by omega) (by decide) (by omega) (by omega)).trans hptrbase
  have hu98 := (hun 98 (by omega) (by decide) (by omega) (by omega)).trans hflagbase
  have huD := (hu.real_frame (ReportDecode.real_frame 70 (by omega) (by decide) (by omega) (by omega) (by omega) (by omega))).trans hd
  obtain ⟨ce,t,ys,he,hce,htmem,hys,htframe⟩ := reportEvent_eval i hi p B reserve N _ hB a xs u humem hug hp j v g
    husource hnormal huv huA huF huC huD hu96 hu98
  refine ⟨cd+ce,t,ys,Eval.seq hu he,by omega,htmem,hys,?_⟩
  intro address hcache hprivate hutil
  have hevent := htframe address hcache hprivate
  have hdecode := huframe address (by rwa [hg.utilityBase])
  exact ⟨hevent.1.trans hdecode.1,hevent.2.trans hdecode.2⟩
end DecrAlmostLinearSSSP.Decremental.Native
