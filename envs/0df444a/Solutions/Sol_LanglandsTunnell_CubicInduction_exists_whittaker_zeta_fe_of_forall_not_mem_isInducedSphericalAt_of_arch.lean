variable {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

private theorem tsum_mul_pow_eq_inv_eval_inducedEulerPoly (hdeg : Module.finrank ℚ K ≤ 3)
    (c : HeightOneSpectrum (𝓞 K) → ℂ) (p : HeightOneSpectrum (𝓞 ℚ)) (Y : ℂ)
    (hs : Summable fun n : ℕ =>
      sphericalTorusValue (inducedE1 ℚ c p) (inducedE2 ℚ c p) (inducedE3 ℚ c p) n * Y ^ n) :
    ∑' n : ℕ, sphericalTorusValue (inducedE1 ℚ c p) (inducedE2 ℚ c p) (inducedE3 ℚ c p) n * Y ^ n =
      ((inducedEulerPoly ℚ c p).eval Y)⁻¹ := by
  rw [eval_inducedEulerPoly_eq_of_finrank_le_three K hdeg c p Y]
  exact tsum_mul_pow_eq_inv_cubic _ _ _ Y hs

private theorem eval_inducedEulerPoly_ne_zero (hdeg : Module.finrank ℚ K ≤ 3)
    (c : HeightOneSpectrum (𝓞 K) → ℂ) (p : HeightOneSpectrum (𝓞 ℚ)) (Y : ℂ)
    (hs : Summable fun n : ℕ =>
      sphericalTorusValue (inducedE1 ℚ c p) (inducedE2 ℚ c p) (inducedE3 ℚ c p) n * Y ^ n) :
    (inducedEulerPoly ℚ c p).eval Y ≠ 0 := by
  rw [eval_inducedEulerPoly_eq_of_finrank_le_three K hdeg c p Y]
  exact cubic_ne_zero _ _ _ Y hs

private theorem hasSum_mul_pow_inv_eval_inducedEulerPoly (hdeg : Module.finrank ℚ K ≤ 3)
    (c : HeightOneSpectrum (𝓞 K) → ℂ) (p : HeightOneSpectrum (𝓞 ℚ)) (Y : ℂ)
    (hs : Summable fun n : ℕ =>
      sphericalTorusValue (inducedE1 ℚ c p) (inducedE2 ℚ c p) (inducedE3 ℚ c p) n * Y ^ n) :
    HasSum (fun n : ℕ => sphericalTorusValue (inducedE1 ℚ c p) (inducedE2 ℚ c p) (inducedE3 ℚ c p) n * Y ^ n)
      ((inducedEulerPoly ℚ c p).eval Y)⁻¹ :=
  tsum_mul_pow_eq_inv_eval_inducedEulerPoly hdeg c p Y hs ▸ hs.hasSum

