/-- Two monic polynomials of the same degree `n` agree in all coefficients of degree `≥ n`. -/
private theorem coeff_eq_of_monic_of_le {R : Type} [CommRing R] {n : ℕ} {P Q : Polynomial R}
    (hP : P.Monic) (hQ : Q.Monic) (hPn : P.natDegree = n) (hQn : Q.natDegree = n)
    {j : ℕ} (hj : n ≤ j) : P.coeff j = Q.coeff j := by
  rcases hj.eq_or_lt with rfl | hlt
  · have h1 := hP.coeff_natDegree
    have h2 := hQ.coeff_natDegree
    rw [hPn] at h1; rw [hQn] at h2; rw [h1, h2]
  · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega),
      Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]

end TypeDensity

open TypeDensity
open scoped ENNReal

theorem solution (O : Type) [CommRing O] [IsLocalRing O] (n : ℕ)
    (G : Polynomial (IsLocalRing.ResidueField O)) :
    (∀ a ∈ TypeDensity.residueCell O n G, TypeDensity.residueCell O n G =
        {b | ∀ i, b i - a i ∈ IsLocalRing.maximalIdeal O}) ∧
      (G.Monic → G.natDegree = n → (TypeDensity.residueCell O n G).Nonempty) ∧
      ((TypeDensity.residueCell O n G).Nonempty → G.Monic ∧ G.natDegree = n) := by
  refine ⟨?_, ?_, ?_⟩
  · intro a ha
    ext b
    have hcong := (TypeDensity.polynomial_congruence_and_product O (IsLocalRing.maximalIdeal O)).1
      (TypeDensity.monicPolyO b) (TypeDensity.monicPolyO a)
    obtain ⟨hma, hna, hca, -⟩ := TypeDensity.monic_poly_reconstruct O n a
    obtain ⟨hmb, hnb, hcb, -⟩ := TypeDensity.monic_poly_reconstruct O n b
    simp only [TypeDensity.residueCell, Set.mem_ofPred_eq] at ha ⊢
    rw [← ha]
    change _ ↔ _ at hcong
    refine hcong.trans ⟨fun h i => ?_, fun h j => ?_⟩
    · have := h i; rwa [hca, hcb] at this
    · by_cases hj : j < n
      · have := h ⟨j, hj⟩; rw [← hca ⟨j, hj⟩, ← hcb ⟨j, hj⟩] at this; exact this
      · rw [TypeDensity.coeff_eq_of_monic_of_le hmb hma hnb hna (by omega), sub_self]
        exact Ideal.zero_mem _
  · intro hG hGn
    choose a ha using fun i : Fin n => IsLocalRing.residue_surjective (G.coeff i)
    refine ⟨a, ?_⟩
    obtain ⟨hma, hna, hca, -⟩ := TypeDensity.monic_poly_reconstruct O n a
    change (TypeDensity.monicPolyO a).map (IsLocalRing.residue O) = G
    ext j
    by_cases hj : j < n
    · rw [Polynomial.coeff_map]
      have := hca ⟨j, hj⟩
      simp only at this
      rw [this, ha]
    · exact TypeDensity.coeff_eq_of_monic_of_le (hma.map _) hG ((hma.natDegree_map _).trans hna) hGn
        (by omega)
  · rintro ⟨a, ha⟩
    obtain ⟨hma, hna, -, -⟩ := TypeDensity.monic_poly_reconstruct O n a
    simp only [TypeDensity.residueCell, Set.mem_ofPred_eq] at ha
    subst ha
    exact ⟨hma.map _, (hma.natDegree_map _).trans hna⟩
