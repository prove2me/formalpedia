/-! ### Metric compatibility -/

section compat

variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}

theorem pdMC_transpose (i : Fin n) (A : Pt n → Matrix (Fin n) (Fin n) ℂ) (y : Pt n) :
    pdMC i (fun z => (A z)ᵀ) y = (pdMC i A y)ᵀ := by
  ext a b; rfl

theorem SmoothOnC.transpose' {A : Pt n → Matrix (Fin n) (Fin n) ℂ} (hA : SmoothOnC A U) :
    SmoothOnC (fun y => (A y)ᵀ) U :=
  fun a b => by simpa only [Matrix.transpose_apply] using hA b a

/-- Matrix form of `∂_μ g_{ab} = Γ_{a,μb} + Γ_{b,μa}`: `∂_μ g = Γ_μᵀ g + g Γ_μ`. -/
theorem pdM_metricMatrix (hm : MetricData g gi U) {y : Pt n} (hy : y ∈ U) (μ : Fin n) :
    pdM μ (metricMatrix g) y = (connMat (christoffel g gi) μ y)ᵀ * metricMatrix g y
      + metricMatrix g y * connMat (christoffel g gi) μ y := by
  ext a b
  simp only [pdM_apply, metricMatrix, Matrix.of_apply, Matrix.add_apply, Matrix.mul_apply, Matrix.transpose_apply,
    connMat_apply]
  have h1 : ∑ c, g a c y * christoffel g gi c μ b y = chr1 g a μ b y := sum_g_christoffel hm hy a μ b
  have h2 : ∑ c, christoffel g gi c μ a y * g c b y = chr1 g b μ a y := by
    rw [← sum_g_christoffel hm hy b μ a]
    exact Finset.sum_congr rfl fun c _ => by rw [hm.symm y hy c b]; ring
  rw [h1, h2, add_comm]
  exact pd_g_eq_chr1 hm hy a μ b

theorem pdMC_frMat (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (μ : Fin n) :
    pdMC μ (frMat E) x = frMat E x * omegaC g gi E Θ μ x - GamC g gi μ x * frMat E x := by
  unfold omegaC
  rw [← Matrix.mul_assoc, hF.compl hx, Matrix.one_mul]
  abel

theorem map_ofReal_compat (P G : Matrix (Fin n) (Fin n) ℝ) :
    (Pᵀ * G + G * P).map (fun t : ℝ => (t : ℂ))
      = (P.map (fun t : ℝ => (t : ℂ)))ᵀ * G.map (fun t : ℝ => (t : ℂ))
        + G.map (fun t : ℝ => (t : ℂ)) * P.map (fun t : ℝ => (t : ℂ)) := by
  ext a b
  simp only [Matrix.map_apply, Matrix.add_apply, Matrix.mul_apply, Matrix.transpose_apply]
  push_cast
  ring

end compat

