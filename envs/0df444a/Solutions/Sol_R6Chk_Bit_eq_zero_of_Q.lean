theorem vM_bit {p : ℕ} : ∀ {L : List (ℕ × ℕ × ℕ)}, (vM L).testBit p = true ↔ ∃ e ∈ L, (cm e).testBit p = true
  | [] => by simp [vM]
  | e :: L => by
    rw [vM, Nat.testBit_lor, Bool.or_eq_true, vM_bit]
    simp

theorem F_cm (e : ℕ × ℕ × ℕ) : F (cm e) = F e.1 ∪ F e.2.1 := by
  ext p; simp [F, cm]

theorem F_bit {c : ℕ} (hc : c < 23) : F (2 ^ c) = {⟨c, hc⟩} := by
  ext p; simp only [F, Finset.mem_filter, Finset.mem_univ, true_and, Nat.testBit_two_pow,
    decide_eq_true_eq, Finset.mem_singleton]
  exact ⟨fun h => Fin.ext h.symm, fun h => by rw [h]⟩

theorem F_and (a b : ℕ) : F (a &&& b) = F a ∩ F b := by
  ext p; simp [F, Nat.testBit_and]

theorem F_zero : F 0 = ∅ := by ext p; simp [F]

theorem disj_F {a b : ℕ} (h : a &&& b = 0) : Disjoint (F a) (F b) := by
  rw [Finset.disjoint_iff_inter_eq_empty, ← F_and, h, F_zero]

/-- **On `Wp`, the coordinates in `Q` determine the vector.** -/
theorem eq_zero_of_Q_sol_aux {c Q : ℕ} (hc : c < 23) {L : List (ℕ × ℕ × ℕ)} (hcf : ∀ e ∈ L, CompFacts c Q e)
    {x : Fin 23 → ℚ} (hx : x ∈ Wp c L) (hQ : ∀ p ∈ F Q, x p = 0) : x = 0 := by
  obtain ⟨hx1, hx2, hx3⟩ := hx
  have hV : ∀ p : Fin 23, (vM L).testBit p = true → x p = 0 := by
    intro p hp
    by_cases hpQ : p ∈ F Q
    · exact hQ p hpQ
    obtain ⟨e, he, hpe⟩ := vM_bit.1 hp
    have cf := hcf e he
    by_cases hy : e.2.1 = 0
    · have : p ∈ F (cm e) := mem_F.2 hpe
      rw [F_cm, hy, F_zero, Finset.union_empty] at this
      exact absurd (cf.nb hy this) hpQ
    · obtain ⟨x0, hx0, hq⟩ := cf.bp hy
      have hp0 := hq p (mem_F.2 hpe) hpQ
      subst hp0
      have hXY := disj_F cf.XY
      have hYz : sumOn e.2.1 x = 0 := by
        apply Finset.sum_eq_zero
        intro q hqY
        by_cases hqQ : q ∈ F Q
        · exact hQ q hqQ
        · have := hq q (by rw [F_cm]; exact Finset.mem_union_right _ hqY) hqQ
          subst this
          exact absurd hqY (Finset.disjoint_left.1 hXY hx0)
      have hXs : sumOn e.1 x = x p := by
        rw [sumOn, ← Finset.add_sum_erase _ _ hx0]
        rw [Finset.sum_eq_zero, add_zero]
        intro q hq'
        rw [Finset.mem_erase] at hq'
        by_cases hqQ : q ∈ F Q
        · exact hQ q hqQ
        · exact absurd (hq q (by rw [F_cm]; exact Finset.mem_union_left _ hq'.2) hqQ) hq'.1
      rw [← hXs, hx2 e he hy, hYz]
  have hc0 : x ⟨c, hc⟩ = 0 := by
    have : sumOn (vM L) x = 0 := Finset.sum_eq_zero fun p hp => hV p (mem_F.1 hp)
    rw [this, sumOn, F_bit hc, Finset.sum_singleton] at hx3
    linarith
  funext p
  by_cases hp : (vM L).testBit p = true
  · exact hV p hp
  · by_cases hpc : (p : ℕ) = c
    · rw [show p = ⟨c, hc⟩ from Fin.ext hpc]; exact hc0
    · exact hx1 p (by simpa using hp) hpc

