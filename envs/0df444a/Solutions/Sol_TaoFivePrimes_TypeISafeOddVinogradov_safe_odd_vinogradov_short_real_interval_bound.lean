      have heqR : (n : ℝ) = (n0 : ℝ) + 2 * (j : ℝ) := by
        exact_mod_cast heq.symm
      linarith
    have hjq : j < q := by exact_mod_cast (by linarith : (j : ℝ) < q)
    exact Finset.mem_image.mpr ⟨j, Finset.mem_range.mpr hjq, heq⟩
  have hpad : (∑ n ∈ pad, f n) =
      ∑ j ∈ Finset.range q, f (n0 + 2 * j) := by
