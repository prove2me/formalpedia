theorem cornulier_normalizedMarkedAction_false
    (G : CountableDiscreteGroup.{u})
    (H K₁ K₂ : Subgroup G) (S : Finset G)
    (hSgen : Subgroup.closure (S : Set G) = ⊤)
    (hSroot : ∀ g ∈ S, g ∈ K₁ ∨ g ∈ K₂)
    (hgen : K₁ ⊔ K₂ = ⊤)
    (hH₁ : H ≤ Subgroup.normalizer (K₁ : Set G))
    (hH₂ : H ≤ Subgroup.normalizer (K₂ : Set G))
    (hreal : ∀ φ : G →* Multiplicative ℝ,
