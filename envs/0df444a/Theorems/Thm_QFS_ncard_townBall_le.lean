lemma QFS.ncard_townBall_le (h ℓ : ℝ) (z : EuclideanSpace ℝ (Fin d)) (R : ℝ) :
    (townBall h ℓ z R).ncard ≤ (2 * ⌈R⌉₊ + 1) ^ d := by sorry
