  have hT : 1 ≤ TT' N := by unfold TT'; exact Nat.one_le_iff_ne_zero.2 (by positivity)
  split_ifs with h
  · have : topCost n₀ N + smallCost N + 2 ≤ smallS n₀ :=
      Finset.single_le_sum (f := fun N => topCost n₀ N + smallCost N + 2)
        (fun _ _ => Nat.zero_le _) (Finset.mem_range.2 h)
    have : smallS n₀ ≤ C * TT' N := by
      calc smallS n₀ ≤ C := by omega
        _ ≤ C * TT' N := Nat.le_mul_of_pos_right _ hT
    omega
  · have e : ((calls N).map fun q => q.1 * (C * TT' q.2)).sum =
        C * ((calls N).map fun q => q.1 * TT' q.2).sum := by
      rw [← List.sum_map_mul_left]; congr 1; apply List.map_congr_left; intro q _; ring
    rw [e]
    have l := hL N (by omega)
    have r := hR N (by omega)
    set S := ((calls N).map fun q => q.1 * TT' q.2).sum
    set T := TT' N
    have hC : K * D ≤ C := by omega
    -- D * (K T + C S) ≤ D * C * T
    have key : D * (K * T + C * S) ≤ D * (C * T) := by
      have h1 : D * (C * S) + C * T ≤ D * (C * T) := by nlinarith
      have h2 : D * (K * T) ≤ C * T := by nlinarith
      nlinarith
    have : K * T + C * S ≤ C * T := Nat.le_of_mul_le_mul_left key (by omega)
