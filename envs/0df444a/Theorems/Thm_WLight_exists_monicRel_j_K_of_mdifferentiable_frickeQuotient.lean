-- title:
--   Holomorphic Fricke fractions are integral over K[j]
-- statement:
--   Fix $N$ with $N \neq 0$, and an assignment $L$ of period pairs to points of the upper half-plane with $(L\tau).\omega_1 = \tau$ and $(L\tau).\omega_2 = 1$. Let $W$ be a family of functions indexed by $v \in (\mathbb{Z}/N)^2$ pinned by $W_v(\tau) = (2\pi i)^{-2}\,\wp_{L\tau}\big((v_0\tau + v_1)/N\big)$, where $v_0, v_1$ are the canonical integer representatives, let $\mathrm{fricke}$ be pinned by $\mathrm{fricke}_v(\tau) = -\big(E_4(\tau)E_6(\tau)/\Delta(\tau)\big)/2592 \cdot W_v(\tau)$, and let $jf$ be pinned by $jf(\tau) = E_4(\tau)^3/\Delta(\tau)$. Let $K \subseteq \mathbb{C}$ be the intermediate field of $\mathbb{C}/\mathbb{Q}$ generated by $e^{2\pi i/N}$. Let $G : \mathbb{H} \to \mathbb{C}$ be holomorphic, and let $P_0, Q_0$ be polynomials over $K$ in variables indexed by $\mathrm{Option}\,\{v \in (\mathbb{Z}/N)^2 : v \neq 0\}$; write $\tilde P_0, \tilde Q_0 : \mathbb{H} \to \mathbb{C}$ for their evaluations after pushing the coefficients into $\mathbb{C}$, sending the distinguished variable to $jf$ and the variable $v$ to $\mathrm{fricke}_v$. Assume $\tilde Q_0 \neq 0$ in the algebra of functions $\mathbb{H} \to \mathbb{C}$ and $G \cdot \tilde Q_0 = \tilde P_0$. Then there exist $d \in \mathbb{N}$ and polynomials $p_i \in \mathbb{C}[X]$ for $i < d$, all of whose coefficients lie in $K$, such that $G(\tau)^d + \sum_{i<d} p_i(jf(\tau))\,G(\tau)^i = 0$ for every $\tau \in \mathbb{H}$.
--
--   This is the arithmetic refinement, from $\mathbb{C}$-coefficients to coefficients in $\mathbb{Q}(\zeta_N)$, of the statement that a holomorphic fraction of polynomial expressions in $j$ and the Fricke functions of level $N$ is integral over $K[j]$; it rests on the modularity and $q$-expansion properties of the Fricke functions together with the descent of linear independence from $K$ to $\mathbb{C}$ for functions with $q$-expansion coefficients in $K$. It is used in the construction of $\mathbb{Q}(\zeta_N)$-rational structures on spaces of modular and cusp forms of level $N$, in particular for rationality of $q$-expansion coefficients of $\Gamma_1(N)$-forms.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_WLight_exists_monicRel_j_K_of_mdifferentiable_frickeQuotient.lean

import Mathlib.Analysis.SpecialFunctions.Elliptic.Weierstrass
import Mathlib.NumberTheory.ModularForms.EisensteinSeries.Basic
import Mathlib.NumberTheory.ModularForms.Discriminant
import Mathlib.FieldTheory.IntermediateField.Basic
import Mathlib.Geometry.Manifold.Notation

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
open Complex Real UpperHalfPlane
open scoped Manifold MatrixGroups ModularForm

theorem WLight.exists_monicRel_j_K_of_mdifferentiable_frickeQuotient
    (N : ℕ) [NeZero N]
    (L : ℍ → PeriodPair) (hL : ∀ τ : ℍ, (L τ).ω₁ = (τ : ℂ) ∧ (L τ).ω₂ = 1)
    (W : (Fin 2 → ZMod N) → ℍ → ℂ)
    (hW : ∀ (v : Fin 2 → ZMod N) (τ : ℍ), W v τ = ((2 * (Real.pi : ℂ) * Complex.I) ^ 2)⁻¹ *
      PeriodPair.weierstrassP (L τ) ((((v 0).val : ℂ) * (τ : ℂ) + ((v 1).val : ℂ)) / (N : ℂ)))
    (fricke : (Fin 2 → ZMod N) → ℍ → ℂ)
    (hfricke : ∀ (v : Fin 2 → ZMod N) (τ : ℍ), fricke v τ =
      -(ModularForm.E₄ τ * ModularForm.E₆ τ / ModularForm.discriminant τ) / 2592 * W v τ)
    (jf : ℍ → ℂ)
    (hjf : ∀ τ : ℍ, jf τ = ModularForm.E₄ τ ^ 3 / ModularForm.discriminant τ)
    (K : IntermediateField ℚ ℂ)
    (hK : K = IntermediateField.adjoin ℚ
      {Complex.exp (2 * (Real.pi : ℂ) * Complex.I / (N : ℂ))})
    (G : ℍ → ℂ) (hG : MDifferentiable 𝓘(ℂ) 𝓘(ℂ) G)
    (P₀ Q₀ : MvPolynomial (Option {v : Fin 2 → ZMod N // v ≠ 0}) ↥K)
    (hQ0 : MvPolynomial.aeval (fun o : Option {v : Fin 2 → ZMod N // v ≠ 0} =>
      o.elim jf fun v => fricke v.1) (Q₀.map (algebraMap ↥K ℂ)) ≠ 0)
    (hGQ : G * MvPolynomial.aeval (fun o : Option {v : Fin 2 → ZMod N // v ≠ 0} =>
        o.elim jf fun v => fricke v.1) (Q₀.map (algebraMap ↥K ℂ)) =
      MvPolynomial.aeval (fun o : Option {v : Fin 2 → ZMod N // v ≠ 0} =>
        o.elim jf fun v => fricke v.1) (P₀.map (algebraMap ↥K ℂ))) :
    ∃ (d : ℕ) (p : Fin d → Polynomial ℂ), (∀ (i : Fin d) (n : ℕ), (p i).coeff n ∈ K) ∧
      ∀ τ : ℍ, G τ ^ d + ∑ i : Fin d, (p i).eval (jf τ) * G τ ^ (i : ℕ) = 0 := by sorry
