  · simp (config := {decide := true}) [fsub, IStmt.run, IOp.run, hX, hF, hw, h1, h2, h3,
      Ne.symm h1, Ne.symm h2, Ne.symm h3, zsz_neg]
    first | exact ⟨by (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), by (simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)⟩ | (simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega) | (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
  · simp (config := {decide := true}) [fsub, IStmt.run, IOp.run, hX, hF, hw, h1, h2, h3,
      Ne.symm h1, Ne.symm h2, Ne.symm h3, zsz_neg]
    first | exact ⟨by (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), by (simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)⟩ | (simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega) | (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)

theorem fredA_runs {X : Fin NS} (h1 : X ≠ RN) (h2 : X ≠ T1) (h3 : X ≠ T2) (s : IState NS)
    (z : ℤ) (n : ℕ) (L LN : List Item) (hX : s.G X = .int z :: L)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hz : z.natAbs < 2 ^ (2 * n + 1)) :
    IRuns I iprog (fredA X) s (s.upd X (.int (fredW n z) :: L)) (2000 * (n + 2)) := by
  apply IRuns.of_runsTo 0
  have hp : 0 < 2 ^ n := by positivity
  have e4 : zsz (sg (sg z (z.natAbs / 2 ^ n)) ((sg z (z.natAbs / 2 ^ n)).natAbs / 2 ^ n)) ≤ 1 := by
    apply zsz_le_of_lt; rw [natAbs_sg, natAbs_sg, Nat.div_div_eq_div_mul, ← pow_add,
      Nat.div_lt_iff_lt_mul (by positivity), ← pow_add]
    calc z.natAbs < 2 ^ (2 * n + 1) := hz
      _ = 2 ^ (1 + (n + n)) := by ring_nf
  have e1 : zsz (sg z (z.natAbs % 2 ^ n)) ≤ n :=
    zsz_le_of_lt (sg_lt_pow _ (Nat.mod_lt _ hp))
  have e2 : zsz (sg (sg z (z.natAbs / 2 ^ n)) ((sg z (z.natAbs / 2 ^ n)).natAbs % 2 ^ n)) ≤ n :=
    zsz_le_of_lt (sg_lt_pow _ (Nat.mod_lt _ hp))
  have e3 := zsz_add_le (sg z (z.natAbs % 2 ^ n))
    (-sg (sg z (z.natAbs / 2 ^ n)) ((sg z (z.natAbs / 2 ^ n)).natAbs % 2 ^ n))
  rw [zsz_neg] at e3
  have e3' : zsz (sg z (z.natAbs % 2 ^ n) +
      -sg (sg z (z.natAbs / 2 ^ n)) ((sg z (z.natAbs / 2 ^ n)).natAbs % 2 ^ n)) ≤ n + 1 :=
    le_trans e3 (Nat.add_le_add_right (max_le e1 e2) 1)
  simp +decide [fredA, IStmt.run, IOp.run, hX, hN, h1, h2, h3, Ne.symm h1, Ne.symm h2,
    Ne.symm h3, zsz_neg]
  refine ⟨by unfold fredW; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
  (simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)

theorem zsz_le_of_abs {z : ℤ} {m : ℕ} (h : |z| < 2 ^ m) : zsz z ≤ m := by
  apply zsz_le_of_lt
  have : ((z.natAbs : ℕ) : ℤ) < ((2 ^ m : ℕ) : ℤ) := by push_cast; exact h
  exact_mod_cast this

end NLogN

end

section
open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution {X : Fin NS} (h1 : X ≠ RN) (h2 : X ≠ RF) (h3 : X ≠ T1) (h4 : X ≠ T2)
    (s : IState NS) (z : ℤ) (n : ℕ) (L LN LF : List Item) (hX : s.G X = .int z :: L)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF)
    (hz : z.natAbs < 2 ^ (2 * n + 1)) :
    IRuns I iprog (fred X) s (s.upd X (.int (z % (2 ^ n + 1)) :: L)) (20000 * (n + 3)) := by
  set F : ℤ := 2 ^ n + 1 with hFdef
  set w0 := fredW n z
  have hw0 : |w0| < 2 ^ (n + 1) := by
    have := fredW_bound n z hz
    have : ((w0.natAbs : ℕ) : ℤ) < ((2 ^ (n + 1) : ℕ) : ℤ) := by exact_mod_cast this
    push_cast at this; exact this
  have hp : (2 : ℤ) ^ (n + 2) = 4 * 2 ^ n := by ring
  have hp1 : (2 : ℤ) ^ (n + 1) = 2 * 2 ^ n := by ring
  have hpos : (0 : ℤ) < 2 ^ n := by positivity
  have hFm : zsz F ≤ n + 2 := zsz_le_of_abs (by rw [hp, abs_of_pos (by omega)]; omega)
  have hA := fredA_runs (I := I) (iprog := iprog) h1 h3 h4
    s z n L LN hX hN hz
  set w1 := if w0 < 0 then F + w0 else w0
  set w2 := if w1 < 0 then F + w1 else w1
  set w3 := if ¬ (w2 + -F < 0) then w2 + -F else w2
  have b0 : zsz w0 ≤ n + 2 := zsz_le_of_abs (by rw [abs_lt] at hw0 ⊢; omega)
  have b1 : zsz w1 ≤ n + 2 := zsz_le_of_abs (by rw [abs_lt] at hw0 ⊢; simp only [w1]; split_ifs <;> omega)
  have b2 : zsz w2 ≤ n + 2 := zsz_le_of_abs (by
    rw [abs_lt] at hw0 ⊢; simp only [w2, w1]; split_ifs <;> omega)
  have b3 : zsz w3 ≤ n + 2 := zsz_le_of_abs (by
    rw [abs_lt] at hw0 ⊢; simp only [w3, w2, w1]; split_ifs <;> omega)
  have hB := fadd_runs (I := I) (iprog := iprog) h2 h3 (s.upd X (.int w0 :: L)) w0 F (n + 2) L LF
    (by simp) (by simp [Ne.symm h2, hF]) b0 hFm
  have hC := fadd_runs (I := I) (iprog := iprog) h2 h3 (s.upd X (.int w1 :: L)) w1 F (n + 2) L LF
    (by simp) (by simp [Ne.symm h2, hF]) b1 hFm
  have hD := fsub_runs (I := I) (iprog := iprog) h2 h3 h4 (s.upd X (.int w2 :: L)) w2 F (n + 2) L LF
    (by simp) (by simp [Ne.symm h2, hF]) b2 hFm
  have hE := fsub_runs (I := I) (iprog := iprog) h2 h3 h4 (s.upd X (.int w3 :: L)) w3 F (n + 2) L LF
    (by simp) (by simp [Ne.symm h2, hF]) b3 hFm
  simp only [IState.upd_upd_same] at hB hC hD hE
  refine (IRuns.seq hA (IRuns.seq hB (IRuns.seq hC (IRuns.seq hD hE)))).mono' ?_ (by omega)
  congr 3
  have := fnorm_eq F w0 (by omega) (by rw [abs_lt] at hw0; omega) (by rw [abs_lt] at hw0; omega)
  have e : (if ¬w3 + -F < 0 then w3 + -F else w3) = fnorm F w0 := rfl
  rw [e, this]
  exact fredW_cong n z
end
