/-! ### The Maxwell combination (geometric source of `res1d`) -/

theorem fdir_sub_two_mul (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) {a b c : Pt 4 → ℂ}
    (ha : ContDiffOn ℝ ∞ a U) (hb : ContDiffOn ℝ ∞ b U) (hc : ContDiffOn ℝ ∞ c U) (D : Fin 4) :
    fdir E D (fun z => a z - 2 * b z * c z) x = fdir E D a x - 2 * (fdir E D b x * c x + b x * fdir E D c x) := by
  have hU := hN.isOpen
  have e : (fun z => a z - 2 * b z * c z) = fun z => a z - 2 * (b z * c z) := funext fun z => by ring
  have hbc : ContDiffOn ℝ ∞ (fun z => 2 * (b z * c z)) U := contDiffOn_const.mul (hb.mul hc)
  rw [e, fdir_sub_of hU hx ha hbc, fdir_const_mul, fdir_mul_of hU hx hb hc]

end ExactVacuumAtlas.EinsteinMaxwell.NP
