  have hpure := TypeDensity.base_ideal_pure O Φ hΦ.1 hδ L
  have hA := TypeDensity.monic_poly_reconstruct O _ a
  have hA' := TypeDensity.monic_poly_reconstruct O _ a'
  -- coefficientwise congruence of the lifted polynomials
