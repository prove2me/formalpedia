set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.Structured
lemma evenDestination_frames (ins : Instruction) (he : evenDestination ins = true) (k : ℕ) (hk : k%2 = 1) :
    ¬ writesNat ins k ∧ ¬ writesReal ins k := by
  constructor <;> intro hw
  all_goals cases ins <;> simp [evenDestination,writesNat,writesReal] at he hw
  all_goals omega
lemma evenRegisters_frames (cmd : Cmd) (he : evenRegisters cmd = true) (k : ℕ) (hk : k%2 = 1) :
    NatFrame cmd k ∧ RealFrame cmd k := by
  induction cmd with
  | skip => exact ⟨trivial,trivial⟩
  | atom a => exact evenDestination_frames a.instruction he k hk
  | seq a b iha ihb =>
    have hh : evenRegisters a = true ∧ evenRegisters b = true := by simpa only [evenRegisters,Bool.and_eq_true] using he
    exact ⟨⟨(iha hh.1).1,(ihb hh.2).1⟩,⟨(iha hh.1).2,(ihb hh.2).2⟩⟩
  | branch test a b iha ihb =>
    have hh : evenRegisters a = true ∧ evenRegisters b = true := by simpa only [evenRegisters,Bool.and_eq_true] using he
    exact ⟨⟨(iha hh.1).1,(ihb hh.2).1⟩,⟨(iha hh.1).2,(ihb hh.2).2⟩⟩
  | loop test a ih => exact ih he
end DecrAlmostLinearSSSP.Decremental.Structured
end s252
