open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
variable {σ : Fin 4 → Fin 4}
theorem solution (hN : NullFrameData g gi E Θ U) (hσ : ∀ A, σ (σ A) = A)
    (hη : ∀ A B, etaNull (σ A) (σ B) = etaNull A B) :
    NullFrameData g gi (NP.relabel σ E) (NP.relabel σ Θ) U where
  metric := hN.metric
  smooth_E := fun A μ => hN.smooth_E (σ A) μ
  smooth_Θ := fun A μ => hN.smooth_Θ (σ A) μ
  dual := fun x hx => by
    ext C B
    have h := hN.dual_apply hx (σ C) (σ B)
    simp only [Matrix.mul_apply, coMat, frMat, NP.relabel, Matrix.of_apply, Matrix.one_apply] at h ⊢
    rw [h]
    by_cases hCB : C = B
    · simp [hCB]
    · have : σ C ≠ σ B := fun e => hCB (by rw [← hσ C, e, hσ B])
      simp [hCB, this]
  gram := fun x hx => by
    ext A B
    rw [gramM_apply]
    exact (hN.gram_apply hx (σ A) (σ B)).trans (hη A B)
