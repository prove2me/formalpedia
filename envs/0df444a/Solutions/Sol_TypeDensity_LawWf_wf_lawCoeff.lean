/-- A sum of well-formed expressions is well formed. -/
private theorem Expr.wf_sum {xs : List Expr} (h : ∀ z ∈ xs, z.wf) : (Expr.sum xs).wf := by
  induction xs with
  | nil => simp [Expr.sum, Expr.wf]
  | cons a t ih =>
    simp only [List.mem_cons, forall_eq_or_imp] at h
    exact ⟨h.1, ih h.2⟩

