-- title:
--   Crossing model base change along a finite free coefficient extension
-- statement:
--   Let $W$ and $W'$ be commutative rings in a fixed universe, with $W'$ a $W$-algebra that is module-finite and free as a $W$-module, and let $a \in W$. Write $\mathrm{UVCrossingModel}\,W\,a$ for the quotient of the two-variable power series ring $\mathrm{MvPowerSeries}\,(\mathrm{Fin}\ 2)\,W$ by the ideal generated by $X_0X_1 - C(a)$, with `mk` the quotient ring homomorphism, $U$ and $V$ the classes of $X_0$ and $X_1$, and $\mathrm{const}(w)$ the class of the constant series $C(w)$. The assertion is that there exists a $W$-algebra isomorphism $e$ from $(\mathrm{UVCrossingModel}\,W\,a) \otimes_W W'$ onto $\mathrm{UVCrossingModel}\,W'\,(\mathrm{algebraMap}\ a)$ such that: for every power series $f$ over $W$ and every $w' \in W'$, $e$ sends $\mathrm{mk}\,a\,f \otimes_W w'$ to $\mathrm{const}(w')$ times the class of the coefficientwise image $\mathrm{MvPowerSeries.map}\,(\mathrm{algebraMap}\ W\ W')\,f$; $e(U \otimes 1) = U$; $e(V \otimes 1) = V$; and $e(\mathrm{const}(w) \otimes 1) = \mathrm{const}(\mathrm{algebraMap}\ w)$ for all $w \in W$, where the targets are taken in the crossing model over $W'$ with parameter $\mathrm{algebraMap}\ a$.
--
--   This records that the local model $W[[U,V]]/(UV-a)$ of a crossing (a node with parameter $a$) is compatible with base change of the coefficient ring along a module-finite free extension, the first displayed clause expressing $W'$-semilinearity of the comparison map in the given tensor order. It is used in the identification of completed local rings of modular curves at crossing points, both in the étale local-ring case and in the passage to extensions that are Galois with cyclic group and unramified at the relevant place.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_UVCrossingModel_exists_algEquiv_tensorProduct_map_of_finite_of_free.lean

import Mathlib
import Definitions.Def_ModularCurve_UVCrossingModel

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open scoped TensorProduct

theorem ModularCurve.UVCrossingModel.exists_algEquiv_tensorProduct_map_of_finite_of_free
    (W W' : Type u) [CommRing W] [CommRing W'] [Algebra W W'] [Module.Finite W W'] [Module.Free W W']
    (a : W) :
    ∃ e : ModularCurve.UVCrossingModel W a ⊗[W] W' ≃ₐ[W]
        ModularCurve.UVCrossingModel W' (algebraMap W W' a),
      (∀ (f : MvPowerSeries (Fin 2) W) (w' : W'),
        e (ModularCurve.UVCrossingModel.mk a f ⊗ₜ[W] w') =
          ModularCurve.UVCrossingModel.const (algebraMap W W' a) w' *
            ModularCurve.UVCrossingModel.mk (algebraMap W W' a) (MvPowerSeries.map (algebraMap W W') f)) ∧
      e (ModularCurve.UVCrossingModel.U a ⊗ₜ[W] 1) = ModularCurve.UVCrossingModel.U (algebraMap W W' a) ∧
      e (ModularCurve.UVCrossingModel.V a ⊗ₜ[W] 1) = ModularCurve.UVCrossingModel.V (algebraMap W W' a) ∧
      ∀ w : W, e (ModularCurve.UVCrossingModel.const a w ⊗ₜ[W] 1) =
        ModularCurve.UVCrossingModel.const (algebraMap W W' a) (algebraMap W W' w) := by sorry
