theorem cost_pack {r K e Cs S X p t b : ℕ} (hK : r ≤ K * (S + 1) ^ e) (hS : S + 1 ≤ Cs * X)
    (hX : X = p ^ 7 * t ^ 2) (hb : 1 ≤ b) (ht : 1 ≤ t) :
    r ≤ K * Cs ^ e * b ^ (7 * e) * t ^ (7 * e) * p ^ (7 * e) := by
