section LocallyConvexResults

variable {E : Type*} [UniformSpace E] [AddCommGroup E] [Module ℝ E]
    [hgroup : IsUniformAddGroup E] [hsmul : ContinuousSMul ℝ E]
    [hlc : LocallyConvexSpace ℝ E] [hhaus : T2Space E]

include hgroup hsmul hlc hhaus

/-- Unnumbered consequence after Lemma 2, arXiv:1004.3792v1, PDF p.5.
The finite exceptional subset of M, as well as the compact witness, may
vary with epsilon and delta; both precede the universal measure binder. -/
theorem tightnessNeighborhoodFiniteExceptions (A : Set E)
    (hA : GeneralBarycenterSpace A) (hc : Convex ℝ A)
    (d : MetricSpace A) (hd : d.toUniformSpace = (inferInstance : UniformSpace A))
    (M : Set (ProbabilityMeasure A)) :
    IsTightMeasureSet ((fun mu : ProbabilityMeasure A => (mu : Measure A)) '' M) ↔
      ∀ epsilon : ℝ, 0 < epsilon → ∀ delta : ℝ, 0 < delta →
        ∃ K : Set A, IsCompact K ∧
          ∃ F : Set (ProbabilityMeasure A), F ⊆ M ∧ F.Finite ∧
            ∀ mu ∈ M \ F, ENNReal.ofReal (1 - epsilon) ≤
              (mu : Measure A) (letI : MetricSpace A := d; Metric.cthickening delta K) := by sorry

end LocallyConvexResults

end QAlgorithms.Papers.Independent.Support50.P33

end
