section
-- Source module: Solutions.KFZPass
/-!
# KFZ Pass: list moves, conjugate copies and record replication (uniform counts)

All counts are run-time data (`rptX`, the count copied from a register). Every spec is
frame-preserving: only the named stacks change.

* **`mvX_runs`**: move `L` from `X` to `Y` (reversed); **`mv2_runs`**: move through `pU`
  (order kept); **`dropX_runs`**: drop `L`.
* **`cnjCp_runs`**: push the conjugate of the Gaussian list on `H` onto `W` (order kept), `H`
  unchanged; counts `2N` on `nX2`, `N` on `nX`.
* **`replP_runs`**: push `N` copies of the Gaussian list on `H` onto `W`; counts `N` on `rN`,
  `2|τ|` on `rN2`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace NLogN.KFZ

open IntMul KIL KFB KFC KFT NLogN.KFM

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## Moves -/

theorem mvX_runs (X Y CN : Fin HS) (hXY : X ≠ Y) (hX : NC X) (hY : NC Y) (hCN : CN ≠ pA)
    (L : List ℤ) (B : ℕ) (hB : ∀ x ∈ L, zsz x ≤ B) (s : IState HS) (RX LC : List Item)
    (h0 : s.G X = ints L ++ RX) (hC : s.G CN = .int (L.length : ℤ) :: LC) :
    IRuns I iprog (mvX X Y CN) s ((s.upd X RX).upd Y (ints L.reverse ++ s.G Y))
      (cMvX L.length B) :=
  (rptX_of_rpt hCN hC (NLogN.KFM.mvN_runs X Y hXY hX hY L B hB s RX h0)).mono (by unfold cMvX cCnt; omega)

theorem mv2_runs (X Y CN : Fin HS) (hXY : X ≠ Y) (hXU : X ≠ pU) (hYU : Y ≠ pU) (hX : NC X)
    (hY : NC Y) (hCN : CN ≠ pA) (hCX : CN ≠ X) (hCU : CN ≠ pU)
    (L : List ℤ) (B : ℕ) (hB : ∀ x ∈ L, zsz x ≤ B) (s : IState HS) (RX LC : List Item)
    (h0 : s.G X = ints L ++ RX) (hC : s.G CN = .int (L.length : ℤ) :: LC) :
    IRuns I iprog (mv2 X Y CN) s ((s.upd X RX).upd Y (ints L ++ s.G Y))
      (2 * cMvX L.length B) := by
  have h1 := mvX_runs (I := I) (iprog := iprog) X pU CN hXU hX (by decide) hCN L B hB s RX LC h0 hC
  set s1 := (s.upd X RX).upd pU (ints L.reverse ++ s.G pU) with hs1
  have hB' : ∀ x ∈ L.reverse, zsz x ≤ B := fun x hx => hB x (List.mem_reverse.1 hx)
  have h2 := mvX_runs (I := I) (iprog := iprog) pU Y CN (Ne.symm hYU) (by decide) hY hCN
    L.reverse B hB' s1 (s.G pU) LC (by simp [hs1]) (by simp [hs1, hCX, hCU, hC])
  rw [List.reverse_reverse, List.length_reverse] at h2
  refine (h1.seq h2).mono' ?_ (by omega)
  have hYX : Y ≠ X := Ne.symm hXY
  simp only [hs1]
  ((apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out, cf] <;> split_ifs <;> simp_all +decide))

/-! ## Conjugate copy -/

/-! ## Record replication -/

end NLogN.KFZ

