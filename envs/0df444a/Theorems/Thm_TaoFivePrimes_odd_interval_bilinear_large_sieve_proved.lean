theorem odd_interval_bilinear_large_sieve_proved
    (alpha delta M n0 n1 m0 m1 : ℝ)
    (I J : Finset ℕ) (A B : ℕ → ℂ)
    (hdelta : 0 < delta) (hM : 1 ≤ M)
    (hIodd : ∀ n ∈ I, n.Coprime 2)
    (hJodd : ∀ m ∈ J, m.Coprime 2)
    (hIrange : ∀ n ∈ I, n0 ≤ (n : ℝ) ∧ (n : ℝ) ≤ n1)
    (hJrange : ∀ m ∈ J, m0 ≤ (m : ℝ) ∧ (m : ℝ) ≤ m1)
    (hIlength : 2 ≤ n1 - n0) (hJlength : 2 ≤ m1 - m0)
    (hspacing : ∀ j : ℕ, 1 ≤ j → (j : ℝ) ≤ M →
      delta ≤ ‖(((4 * (j : ℝ) * alpha : ℝ)) : AddCircle (1 : ℝ))‖) :
    ‖∑ p ∈ J.product I,
        A p.2 * B p.1 * expCircle (alpha * (p.2 * p.1))‖ ≤
      Real.sqrt ((n1 - n0) / 2 + 1 / delta) *
        Real.sqrt ((m1 - m0) / (2 * M) + 1) *
          Real.sqrt (∑ n ∈ I, ‖A n‖ ^ 2) *
            Real.sqrt (∑ m ∈ J, ‖B m‖ ^ 2) := by sorry
end TaoFivePrimes
