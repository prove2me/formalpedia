open NLogN
open NLogN.KFM
open IntMul RS
theorem solution (m : ℕ) (rv rd : Fin NLogN.HS) (h : NLogN.KFM.RootRegs rv rd) (s : NLogN.IState NLogN.HS) (v : ℕ) (LV : List NLogN.Item)
    (hV : s.G rv = .int (v : ℤ) :: LV) :
    (NLogN.KFM.rootP m rv rd).ok s ∧ (NLogN.KFM.rootP m rv rd).run s =
      s.upd rd (.int (Nat.findGreatest (fun x => x ^ (2 ^ m) ≤ v) v : ℤ) :: s.G rd) := by
  have hR := h
  obtain ⟨hv56, hd56, -, vI, vY, vJ, dI, dY, dJ, vd⟩ := h
  set s1 := s.upd rd (.int 0 :: s.G rd) with hs1
  have r1 : (NLogN.RS.push rd (.lit 0)).run s = s1 := by simp [NLogN.RS.run, NLogN.Ex.eval, hs1]
  have k1 : (NLogN.RS.push rd (.lit 0)).ok s := ⟨hd56, by intro j hj; simp [NLogN.Ex.regs] at hj, trivial⟩
  have s1V : s1.G rv = .int (v : ℤ) :: LV := by simp [hs1, NLogN.IState.upd_G, vd, hV]
  have H := NLogN.KFM.genLoop_run NLogN.KFM.sI rd (.reg rv) (NLogN.KFM.rootB m rv rd) s1 v (NLogN.KFM.sumG (NLogN.KFM.rootInd m v) v) 0 (s.G rd)
    (Ne.symm dI) (by decide)
    (by intro j hj; simp [NLogN.Ex.regs] at hj; subst hj
        simp only [NLogN.zX_all, List.mem_cons, List.not_mem_nil, or_false]
        intro hh; rcases hh with hh | hh | hh | hh | hh | hh | hh | hh <;>
          (rw [hh] at hv56; exact absurd hv56 (by decide)))
    (NLogN.IState.isInt_of s1V) (by simp [NLogN.Ex.eval, NLogN.IState.top_eq s1V])
    (by simp (config := {decide := true}) [NLogN.KFM.rootB, NLogN.RS.writes, Ne.symm dI]) (by simp [hs1])
    (fun k hk => NLogN.KFM.rootB_run m rv rd hR s1 v LV (s.G rd) s1V k hk _)
  rw [NLogN.KFM.accSeq_sum, zero_add] at H
  have hcnt := NLogN.KFM.count_eq_findGreatest (fun x => x ^ (2 ^ m) ≤ v) v (fun x y hx hxy hy =>
    le_trans (Nat.pow_le_pow_left hxy _) hy)
  simp only [NLogN.KFM.rootInd] at H
  rw [hcnt] at H
  refine ⟨⟨k1, by rw [r1]; exact H.1⟩, ?_⟩
  simp only [NLogN.KFM.rootP, NLogN.RS.run_seq]
  rw [r1, H.2, hs1, NLogN.IState.upd_upd_same]
end
