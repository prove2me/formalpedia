    (hR : s0.G BR = .int (2 ^ (2 * p)) :: LR) (hN : s0.G BN = .int t :: LN)
    (hNR : s0.G BNR = .int ((2 * HvdH.sWidth p α + 1 : ℕ) : ℤ) :: LNR)
    (hNW : s0.G BNW = .int ((t * (2 * HvdH.sWidth p α + 1) : ℕ) : ℤ) :: LNW)
    (hW : s0.G NLogN.Rsp.BW = ints (sTab p s t α).flatten ++ RW)
    (hD : s0.G BD = ints ((sDel s t).map (Nat.cast : ℕ → ℤ)) ++ RD)
    (hu : ∀ z ∈ U, zsz z.1 ≤ mm ∧ zsz z.2 ≤ mm)
    (hWB : ∀ W ∈ sTab p s t α, ∀ y ∈ W, zsz y ≤ mm)
    (hAcc : (2 * HvdH.sWidth p α + 2) * 2 ^ (2 * mm) ≤ 2 ^ B) (hmB : 2 * mm ≤ B)
