  have hIcc : (Finset.Icc 1 d).card = d := by rw [Nat.card_Icc]; omega
  have hinj : Set.InjOn (fun k : ℕ => (k • Q).coordsOrZero) (Finset.Icc 1 d) := by
    rw [← Finset.card_image_iff]; exact hcard.trans hIcc.symm
