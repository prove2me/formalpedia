theorem LX.CenteredLift.raised_source_lift {p : State n} {c : Fin n} {e : Fin n → ℤ} (a : Fin n)
    (hd : IsLift p (c : ℤ) (raiseAt e a)) :
    IsLift p ((c : ℤ)+1) (fun i => e i+1) := by sorry
