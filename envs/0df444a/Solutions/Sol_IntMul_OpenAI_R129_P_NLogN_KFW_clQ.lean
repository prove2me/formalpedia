theorem fok_padPre (L0 Q : ℕ) : NLogN.KFD.fok (NLogN.KFN.padPre L0 Q) = true := by
  simp only [NLogN.KFN.padPre, NLogN.KFD.fok, fok_mvK_eq, zeroK, Bool.and_true, Bool.true_and]
  simp +decide [touch, NLogN.KFD.scr, Ex.regs]

theorem fok_padPost (L0 Q : ℕ) : NLogN.KFD.fok (padPost L0 Q) = true := by
  simp only [padPost, NLogN.KFD.fok, fok_mvK_eq, NLogN.KIL.dropK, Bool.and_true, Bool.true_and]
  simp +decide [touch, NLogN.KFD.scr, Ex.regs]

theorem mv_fsp {X Y : Fin HS} (hXY : X ≠ Y) (hX : X.val < 56) (hY : Y.val < 56)
    (hXc : X ≠ NLogN.KFB.c1) (hYc : Y ≠ NLogN.KFB.c1) (s : IState HS)
    (f : Fin HS → List ℤ) (L l : List ℤ) (hf : f X = L ++ l) (w : ℕ) (hL : Bnd w L) :
    FSp (NLogN.mvK X Y NLogN.KFB.c1 (.lit (L.length : ℤ))) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update (Function.update f X l) Y (L.reverse ++ f Y))) (NLogN.KFN.cMv L.length w) := by
  have H := FSp.mvK (X := X) (Y := Y) (C := NLogN.KFB.c1) hXY hXc hYc hX hY (by decide) s f
    (.lit (L.length : ℤ)) (clean_lit _) trivial L l hf rfl w hL
  refine H.mono (le_of_eq ?_)
  unfold NLogN.KFN.cMv
  simp [Ex.cost]

theorem gflat_zeros (k : ℕ) : gflat (List.replicate k ((0, 0) : GI)) = List.replicate (2 * k) 0 := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [List.replicate_succ, gflat_cons, ih, show 2 * (k + 1) = 2 * k + 1 + 1 by ring,
      List.replicate_succ, List.replicate_succ]

