      rw [map_mul, RingHom.comp_apply, map_natCast, Ideal.Quotient.eq_zero_iff_mem.mpr hpI, zero_mul]).comp
    (Int.quotientSpanNatEquivZMod p).symm.toRingHom

abbrev algebraQuot : Algebra (ZMod p) (A ⧸ I) := (zmodToQuot p A I hpI).toAlgebra

