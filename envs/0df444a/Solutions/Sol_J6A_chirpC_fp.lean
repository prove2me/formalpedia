/-- **The configured chirp map is an `FPApprox` of every fitted line map.** -/
theorem chirpC_fp_sol_aux (p s t α H : ℕ) [NeZero s] [NeZero t] (hst : s ≤ t) (hα : 2 ≤ α)
    (hαp : α ^ 2 ≤ p) (hH : 1 ≤ H) (hH2 : H ≤ 2 * sWidth p α) (hθ : 300 * (t - s) ≤ s)
    (hp : 3 ≤ p) (hWp : 12 * (H + sWidth p α + 3) ≤ 2 ^ (p / 2))
    (L : (ZMod s → ℂ) →L[ℂ] (ZMod t → ℂ))
    (hL : ∀ U, InDisc p U → ∀ k : ZMod t,
      ‖gC (Sapprox p s t α U k.val) - 2 ^ p * L (fun j => gC (U j.val) / 2 ^ p) k‖
        ≤ 6 * sWidth p α + 4) :
    FPApprox p (chirpC p s t α H) (NLogN.KFM.liftL L) (12 * sWidth p α + 11) := by
  have hs : 0 < s := Nat.pos_of_ne_zero (NeZero.ne s)
  set W := H + sWidth p α + 3 with hWdef
  have hσ := chirp_sigma p s t α H hs hst hα hp hH2 hθ
  -- the window error is `≤ 3`
  have hE : 2 * (W : ℝ) * (6 * 2 ^ (2 * (2 * p)) * 2 ^ p / 2 ^ (3 * (2 * p) - p / 2)) + 2 ≤ 3 := by
    have e : (2 : ℝ) ^ (2 * (2 * p)) * 2 ^ p = 2 ^ (3 * (2 * p) - p / 2) / 2 ^ (p - p / 2) := by
      rw [eq_div_iff (by positivity), ← pow_add, ← pow_add]
      congr 1; omega
    have hW' : 12 * (W : ℝ) ≤ 2 ^ (p - p / 2) := by
      have h1 : (2 : ℝ) ^ (p / 2) ≤ 2 ^ (p - p / 2) := pow_le_pow_right₀ (by norm_num) (by omega)
      have h2 : ((12 * W : ℕ) : ℝ) ≤ ((2 ^ (p / 2) : ℕ) : ℝ) := by exact_mod_cast hWp
      push_cast at h2; linarith
    have hpos : (0 : ℝ) < 2 ^ (3 * (2 * p) - p / 2) := by positivity
    have hpos2 : (0 : ℝ) < 2 ^ (p - p / 2) := by positivity
    rw [mul_assoc 6, e]
    have hs6 : (6 : ℝ) * (2 ^ (3 * (2 * p) - p / 2) / 2 ^ (p - p / 2)) / 2 ^ (3 * (2 * p) - p / 2)
        = 6 / 2 ^ (p - p / 2) := by
      field_simp
    rw [hs6]
    have : 2 * (W : ℝ) * (6 / 2 ^ (p - p / 2)) ≤ 1 := by
      rw [show 2 * (W : ℝ) * (6 / 2 ^ (p - p / 2)) = 12 * W / 2 ^ (p - p / 2) by ring,
        div_le_one hpos2]
      exact hW'
    linarith
  have hp7 : (0.55 : ℝ) * 2 ^ p + 3 ≤ 2 ^ p := by
    have : (2 : ℝ) ^ 3 ≤ 2 ^ p := pow_le_pow_right₀ (by norm_num) hp
    norm_num at this; linarith
  have := fp_of_sexact p s t α hα hαp (chirpC p s t α H) 3
    (fun U hU k => (chirpA_err (2 * p) (p / 2) W s t α H p k hs hst hα hαp hH le_rfl
      (by omega) (by omega) hσ U hU).trans hE) L hL hp7
  convert this using 1
  ring

end J6A

