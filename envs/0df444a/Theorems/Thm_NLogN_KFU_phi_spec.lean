theorem NLogN.KFU.phi_spec {q' : ℕ} {K : ℝ} (hK : SwOK q' K) (hK0 : 0 ≤ K) (w h d : ℕ) (hh : 1 ≤ h)
    (bL : ℕ → Bool) (sF μ : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (hst : ∀ j < d, sF j ≤ 2 ^ h)
    (Bb : ℕ) (hBb : zsz ((2 * vol (shR d (sP d sF)) : ℕ) : ℤ) ≤ Bb)
    (I : List Sym) (xs : List ℤ) (hlen : xs.length = vol (shK d (sP d sF))) (hb : Bnd w xs)
    (t : IState HS) (R : List Item) (h0 : t.G 0 = ints xs ++ R) :
    ∃ c : ℕ, IRuns I KFL.l12prog (phiC q' w h d bL sF μ) t
      (t.upd 0 (ints (PhiD h d bL sF μ xs) ++ R)) c ∧
      (c : ℝ) ≤ cPhi d w (vol (shR d (NLogN.KFU.tP d h bL))) (vol (shR d (sP d sF)))
        (vol ((List.range (d - 1)).map sF)) Bb K h := by sorry
