theorem domU5_r {x : Pt 5} (hx : x ∈ domU5) : x 1 ≠ 0 := hx.1.ne'

theorem domU5_u {x : Pt 5} (hx : x ∈ domU5) : x 2 ≠ 0 := hx.2.1.ne'
theorem domU5_1mu_pos {x : Pt 5} (hx : x ∈ domU5) : 0 < 1 - x 2 := by linarith [hx.2.2]
theorem domU5_1mu {x : Pt 5} (hx : x ∈ domU5) : 1 - x 2 ≠ 0 := (domU5_1mu_pos hx).ne'

theorem isOpen_domU5 : IsOpen domU5 :=
  (isOpen_lt continuous_const (continuous_apply 1)).inter
  ((isOpen_lt continuous_const (continuous_apply 2)).inter
   (isOpen_lt (continuous_apply 2) continuous_const))

theorem domU5_nonempty : domU5.Nonempty :=
  ⟨fun i => if i.val = 1 then 1 else if i.val = 2 then 1/2 else 0, by
    refine ⟨by norm_num, by norm_num, by norm_num⟩⟩

theorem gEF5_symm (mu beta : ℝ) (x : Pt 5) (i j : Fin 5) :
    gEF5 mu beta i j x = gEF5 mu beta j i x := by
  fin_cases i <;> fin_cases j <;> simp [gEF5]

/-! ## Smoothness -/

private theorem cd_proj1 : ContDiffOn ℝ ∞ (fun x : Pt 5 => x 1) domU5 :=
  contDiffOn_pi.mp contDiffOn_id 1

private theorem cd_proj2 : ContDiffOn ℝ ∞ (fun x : Pt 5 => x 2) domU5 :=
  contDiffOn_pi.mp contDiffOn_id 2

private theorem cd_div_rk (c : ℝ) (k : ℕ) :
    ContDiffOn ℝ ∞ (fun x : Pt 5 => c / x 1 ^ k) domU5 :=
  contDiffOn_const.div (cd_proj1.pow k)
    (fun x hx => pow_ne_zero k (domU5_r hx))

private theorem cd_g00 (mu beta : ℝ) :
    ContDiffOn ℝ ∞ (fun x : Pt 5 => -(1 - mu / x 1 ^ 2 + beta / x 1 ^ 4)) domU5 :=
  ((contDiffOn_const.sub (cd_div_rk mu 2)).add (cd_div_rk beta 4)).neg

private theorem cd_g22 :
    ContDiffOn ℝ ∞ (fun x : Pt 5 => x 1 ^ 2 / (4 * x 2 * (1 - x 2))) domU5 :=
  ContDiffOn.div ((cd_proj1).pow 2)
    (ContDiffOn.mul (ContDiffOn.mul contDiffOn_const (cd_proj2))
      (contDiffOn_const.sub (cd_proj2)))
    (fun x hx => mul_ne_zero (mul_ne_zero (by norm_num) (domU5_u hx)) (domU5_1mu hx))

private theorem cd_g33 :
    ContDiffOn ℝ ∞ (fun x : Pt 5 => x 1 ^ 2 * x 2) domU5 :=
  ((cd_proj1).pow 2).mul (cd_proj2)

private theorem cd_g44 :
    ContDiffOn ℝ ∞ (fun x : Pt 5 => x 1 ^ 2 * (1 - x 2)) domU5 :=
  ((cd_proj1).pow 2).mul (contDiffOn_const.sub (cd_proj2))

private theorem cd_gi11 (mu beta : ℝ) :
    ContDiffOn ℝ ∞ (fun x : Pt 5 => 1 - mu / x 1 ^ 2 + beta / x 1 ^ 4) domU5 :=
  (contDiffOn_const.sub (cd_div_rk mu 2)).add (cd_div_rk beta 4)

private theorem cd_gi22 :
    ContDiffOn ℝ ∞ (fun x : Pt 5 => 4 * x 2 * (1 - x 2) / x 1 ^ 2) domU5 :=
  ContDiffOn.div
    (ContDiffOn.mul (ContDiffOn.mul contDiffOn_const (cd_proj2))
      (contDiffOn_const.sub (cd_proj2)))
    ((cd_proj1).pow 2)
    (fun x hx => pow_ne_zero 2 (domU5_r hx))

private theorem cd_gi33 :
    ContDiffOn ℝ ∞ (fun x : Pt 5 => 1 / (x 1 ^ 2 * x 2)) domU5 :=
  ContDiffOn.div contDiffOn_const
    (((cd_proj1).pow 2).mul (cd_proj2))
    (fun x hx => mul_ne_zero (pow_ne_zero 2 (domU5_r hx)) (domU5_u hx))

private theorem cd_gi44 :
    ContDiffOn ℝ ∞ (fun x : Pt 5 => 1 / (x 1 ^ 2 * (1 - x 2))) domU5 :=
  ContDiffOn.div contDiffOn_const
    (((cd_proj1).pow 2).mul (contDiffOn_const.sub (cd_proj2)))
    (fun x hx => mul_ne_zero (pow_ne_zero 2 (domU5_r hx)) (domU5_1mu hx))

theorem smooth_gEF5 (mu beta : ℝ) (i j : Fin 5) :
    ContDiffOn ℝ ∞ (gEF5 mu beta i j) domU5 := by
  fin_cases i <;> fin_cases j <;> simp only [gEF5] <;>
    first | exact contDiffOn_const | exact cd_g00 mu beta
          | exact cd_g22 | exact cd_g33 | exact cd_g44

theorem smooth_giEF5 (mu beta : ℝ) (i j : Fin 5) :
    ContDiffOn ℝ ∞ (giEF5 mu beta i j) domU5 := by
  fin_cases i <;> fin_cases j <;> simp only [giEF5] <;>
    first | exact contDiffOn_const | exact cd_gi11 mu beta
          | exact cd_gi22 | exact cd_gi33 | exact cd_gi44

end ExactVacuumAtlas.EinsteinMaxwell.EF5
