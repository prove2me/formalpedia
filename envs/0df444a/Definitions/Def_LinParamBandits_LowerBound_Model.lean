-- title:
--   Sec. 1.1 and Sec. 2 — linear bandit on the unit sphere, Gaussian prior N(0, I_r/r), regret, Bayes risk, Ẑ_T = E[Z | H_T]
-- statement:
--   This file fixes the model of Section 2 of Rusmevichientong and Tsitsiklis, *Linearly Parameterized Bandits*.
--
--   **Arms and rewards.** Let $r \ge 2$. The set of arms is the unit sphere $\mathcal U_r = \{u \in \mathbb R^r : \|u\| = 1\}$, with the Euclidean norm. An unknown parameter $Z \in \mathbb R^r$ is drawn from the prior $N(0, I_r/r)$, i.e. $Z$ has the law of $Y/\sqrt r$ where $Y$ is a standard normal vector in $\mathbb R^r$. Playing arm $u$ in period $t$ yields the reward
--   $$X_t = u'Z + \eta_t,$$
--   where $\eta_1, \eta_2, \dots$ are independent standard normal random variables, independent of $Z$.
--
--   **Policies and histories.** A history of $t$ periods is the list $H_t = (U_1, X_1, \dots, U_t, X_t)$ of arms played and rewards observed. A policy $\psi = (\psi_1, \psi_2, \dots)$ consists of measurable maps $\psi_{t+1} : H_t \mapsto U_{t+1} \in \mathcal U_r$; for a fixed parameter value $z$ and a fixed noise sequence the whole trajectory is then determined recursively.
--
--   **Regret and risk.** Since $\max_{v \in \mathcal U_r} v'z = \|z\|$ on the unit sphere, the $T$-period regret given $Z = z$ and the $T$-period Bayes risk are
--   $$\mathrm{Regret}(z, T, \psi) = \sum_{t=1}^T \mathbb E\big[\|z\| - U_t'z \,\big|\, Z = z\big], \qquad \mathrm{Risk}(T, \psi) = \mathbb E\big[\mathrm{Regret}(Z, T, \psi)\big].$$
--
--   **Estimator.** $\mathcal H_T$ denotes the $\sigma$-algebra generated by the history $H_T$ under the joint law of $(Z, \eta)$, and $\widehat Z_T = \mathbb E[Z \mid H_T]$ is the least mean squares estimator of $Z$.
--
--   These objects are shared by every statement of the mission: the risk decomposition, the estimation-error bound, the tail bound for $\|Z\|$, the directional risk bound and Theorem 2.1.
--
--   **Formalization Note** $\mathbb R^r$ is `EuclideanSpace ℝ (Fin r)`, so $\|\cdot\|$ is Euclidean and `inner` is $u'z$. Periods are indexed from $0$ in Lean: `arm ψ z η t` is the paper's $U_{t+1}$. The paper has one noise $W^u_t$ for every arm $u$ and period $t$, all independent standard normal (Theorem 2.1); since only $W^{U_t}_t$ is observed and $U_t$ depends on the past only, the history has the same law as with a single i.i.d. sequence $\eta_t$, which is what is modelled. "Given $Z = z$" is literal: the noise is integrated with the parameter fixed to $z$. Regret and risk are lower Lebesgue integrals of the nonnegative gaps (values in $[0, \infty]$), so no junk value of a Bochner integral can make a lower bound easier. Measurability of each $\psi_t$ is implicit in the paper and is a field of the policy. $\widehat Z_T$ is Mathlib's conditional expectation; it is defined up to almost-sure equality.
-- source:
--   Rusmevichientong, Tsitsiklis, Linearly Parameterized Bandits, arXiv:0812.3465v2, Sec. 1.1, pp. 3–4 (model, eq. (1), Regret, Risk); Theorem 2.1, p. 8 (unit sphere, N(0,1) noise, prior N(0, I_r/r)); Sec. 2, p. 9 (H_t, Ẑ_t, max = ‖z‖); App. A.1, p. 27 (Z ~ Y/√r)

import Mathlib

namespace LinParamBandits.LowerBound

open MeasureTheory ProbabilityTheory

/-- The parameter and arm space `ℝ^r`, with the Euclidean norm and the inner product `u′z`
(Rusmevichientong, Tsitsiklis, *Linearly Parameterized Bandits*, arXiv:0812.3465v2, Sec. 1.1, p. 3). -/
abbrev Vec (r : ℕ) : Type := EuclideanSpace ℝ (Fin r)

/-- A history of `t` periods: the pairs `(U_s, X_s)`, `s = 1, …, t`, of arm played and reward
observed (p. 3, `H_t`). Entry `s : Fin t` is period `s + 1`. -/
abbrev History (r t : ℕ) : Type := Fin t → Vec r × ℝ

/-- A policy on the unit sphere `𝒰_r = {u ∈ ℝ^r : ‖u‖ = 1}` (p. 3 and Sec. 2, p. 9): for every
`t`, a map `ψ_{t+1} : H_t → 𝒰_r` choosing the arm of period `t + 1` from the history of the first
`t` periods. Policies are deterministic, as on p. 3; each map is measurable, which the paper's
expectations use implicitly. -/
structure SpherePolicy (r : ℕ) where
  /-- `act t h` is the arm chosen in period `t + 1` after the history `h` of `t` periods. -/
  act : (t : ℕ) → History r t → Vec r
  /-- Each selection rule is measurable. -/
  measurable_act : ∀ t, Measurable (act t)
  /-- Every arm lies on the unit sphere. -/
  norm_act : ∀ t h, ‖act t h‖ = 1

variable {r : ℕ}

/-- The history of the first `t` periods when the parameter is `z` and the noise sequence is
`η`: in period `s + 1` the policy plays `U_{s+1} = ψ.act s (history of s periods)` and observes
`X_{s+1} = U_{s+1}′ z + η s` (eq. (1), p. 3). -/
noncomputable def hist (ψ : SpherePolicy r) (z : Vec r) (η : ℕ → ℝ) : (t : ℕ) → History r t
  | 0 => Fin.elim0
  | t + 1 =>
      Fin.snoc (α := fun _ => Vec r × ℝ) (hist ψ z η t)
        (ψ.act t (hist ψ z η t), inner ℝ (ψ.act t (hist ψ z η t)) z + η t)

/-- The arm `U_{t+1}` played in period `t + 1` (0-based index `t`). -/
noncomputable def arm (ψ : SpherePolicy r) (z : Vec r) (η : ℕ → ℝ) (t : ℕ) : Vec r :=
  ψ.act t (hist ψ z η t)

/-- The prior of Theorem 2.1 (p. 8): the multivariate normal law `N(0, I_r / r)` on `ℝ^r`,
written as the law of `Y / √r` with `Y` standard normal on `ℝ^r` (App. A.1, p. 27). -/
noncomputable def prior (r : ℕ) : Measure (Vec r) :=
  (stdGaussian (Vec r)).map (fun y => (Real.sqrt r)⁻¹ • y)

/-- The noise law of Theorem 2.1: an i.i.d. sequence `η_1, η_2, …` of standard normal random
variables, `η t` being the noise observed in period `t + 1`. -/
noncomputable def noise : Measure (ℕ → ℝ) :=
  Measure.infinitePi (fun _ : ℕ => gaussianReal 0 1)

/-- The sample space: the parameter `Z` and the noise sequence. -/
abbrev Ω (r : ℕ) : Type := Vec r × (ℕ → ℝ)

/-- The joint law of `(Z, η)`: `Z ~ N(0, I_r/r)` independent of the noise (p. 3). -/
noncomputable def P (r : ℕ) : Measure (Ω r) :=
  (prior r).prod noise

/-- The `T`-period regret given `Z = z` (p. 3): on the unit sphere `max_{v ∈ 𝒰_r} v′z = ‖z‖`
(p. 9), so the regret is `∑_{t=1}^T E[‖z‖ − U_t′z]`, the expectation being over the noise with the
parameter fixed to `z`. Each gap is nonnegative, so it is integrated as a nonnegative quantity. -/
noncomputable def regret (ψ : SpherePolicy r) (z : Vec r) (T : ℕ) : ENNReal :=
  ∫⁻ η, ENNReal.ofReal (∑ t ∈ Finset.range T, (‖z‖ - inner ℝ (arm ψ z η t) z)) ∂noise

/-- The `T`-period Bayes risk (p. 4): `Risk(T, ψ) = E[Regret(Z, T, ψ)]`, `Z` drawn from the prior. -/
noncomputable def risk (ψ : SpherePolicy r) (T : ℕ) : ENNReal :=
  ∫⁻ z, regret ψ z T ∂(prior r)

/-- The σ-algebra generated by the history `H_T` on the sample space. -/
noncomputable def histSigma (ψ : SpherePolicy r) (T : ℕ) : MeasurableSpace (Ω r) :=
  MeasurableSpace.comap (fun ω : Ω r => hist ψ ω.1 ω.2 T) inferInstance

/-- The least mean squares estimator `Ẑ_T = E[Z | H_T]` (Sec. 2, p. 9). -/
noncomputable def zhat (ψ : SpherePolicy r) (T : ℕ) : Ω r → Vec r :=
  (P r)[fun ω : Ω r => ω.1 | histSigma ψ T]

end LinParamBandits.LowerBound


