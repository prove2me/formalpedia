/-- Kernel form of a factorization `L₁ = c • B ∘ L₂ ∘ A` with kernel operators `L₁, L₂`. -/
lemma kernel_identity' {a b : ℕ} [NeZero a] [NeZero b] (c : ℂ)
    (A : (ZMod a → ℂ) →L[ℂ] (ZMod b → ℂ)) (B : (ZMod b → ℂ) →L[ℂ] (ZMod a → ℂ))
    (f₁ : ZMod a → ZMod a → ℂ) (f₂ : ZMod b → ZMod b → ℂ)
    (h : ∀ u, (fun k => ∑ j, f₁ k j * u j) = c • B (fun m => ∑ l, f₂ m l * A u l))
    (k j : ZMod a) :
    f₁ k j = c * ∑ m, B (Pi.single m 1) k * ∑ l, f₂ m l * A (Pi.single j 1) l := by
  have h1 := congrFun (h (Pi.single j 1)) k
  have hL : ∑ j', f₁ k j' * (Pi.single j (1 : ℂ) : ZMod a → ℂ) j' = f₁ k j := by
    simp [Pi.single_apply]
  rw [hL] at h1
  rw [h1, Pi.smul_apply, smul_eq_mul, clm_kernel B]

