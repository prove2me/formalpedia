-- Source module: Solutions.R6MQ
/-!
# Round-six machine: the run-time parameters of one size

`Q6` bundles the parameter record `P`, the input size `n` and the source list `src` (chosen by
the setup). All parameters of the machine are functions of `Q : Q6` (`Q.b = b'`, `Q.p = 6b'`,
`Q.L`, `Q.d`, `Q.ℓ`, `Q.h = ℓ − 1`, `Q.α`, `Q.K`, `Q.r`, the boxes `Q.sB D`, `Q.tB D`, `S`, `M`,
the error allowance `Q.er = errW6` and the source-transform error `Q.Es`).

`QOk Q` collects the numerical facts the assembly uses (proved for large `n` in `R6MFacts`).

* `prod_tB`, `tB_last`, `tBox_eq6`, `crtOK6`: the boxes.
* `regIdx6`, `BaseOK6.of_agree`, `BaseOK6.upd`: the register file is kept by writes elsewhere.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFM IntMul.OpenAI.RT AModel

noncomputable section

namespace Q6

variable (Q : Q6)

theorem ℓ_eq : Q.ℓ = OpenAI.RP.ell Q.L Q.d := rfl

end Q6

namespace QOk

variable {Q : Q6} (hQ : QOk Q)
include hQ

theorem ell_pos : 1 ≤ OpenAI.RP.ell Q.L Q.d := by have := hQ.hℓ2; rw [← Q.ℓ_eq]; omega

/-- The axis lengths are `2^{axExp}`. -/
theorem tF_eq (j : ℕ) (hj : j < Q.d) :
    tF6 Q.P Q.n j = 2 ^ OpenAI.RP.axExp Q.L Q.d ⟨j, hj⟩ := by
  have hl := hQ.ell_pos
  unfold tF6 OpenAI.RP.axExp bL6
  have e1 : hN6 Q.P Q.n = OpenAI.RP.ell Q.L Q.d - 1 := rfl
  have e2 : dpN6 Q.P Q.n = OpenAI.RP.mcnt Q.L Q.d := rfl
  rw [e1, e2]
  simp only [decide_eq_true_eq]
  by_cases h : OpenAI.RP.mcnt Q.L Q.d ≤ j
  · rw [if_pos h, if_neg (by omega), ← pow_succ]; congr 1; omega
  · rw [if_neg h, if_pos (by omega)]

theorem tB_eq {D : ℕ} (hD : Q.d = D + 1) (i : Fin (D + 1)) :
    Q.tB D i = 2 ^ OpenAI.RP.axExp Q.L Q.d ⟨i.val, by omega⟩ :=
  hQ.tF_eq i.val (by omega)

theorem tB_pos {D : ℕ} (hD : Q.d = D + 1) (i : Fin (D + 1)) : 0 < Q.tB D i := by
  rw [hQ.tB_eq hD]; positivity

theorem sB_odd {D : ℕ} (hD : Q.d = D + 1) (i : Fin (D + 1)) : Odd (Q.sB D i) :=
  have hD' : dP6 Q.P Q.n = D + 1 := hD
  hQ.src.odd i.val (by omega)

theorem sB_pos {D : ℕ} (hD : Q.d = D + 1) (i : Fin (D + 1)) : 0 < Q.sB D i :=
  (hQ.sB_odd hD i).pos

theorem src_pos (j : ℕ) (hj : j < Q.d) : 1 ≤ Q.src j := (hQ.src.odd j hj).pos

theorem crtOK6 : KFU.CrtOK Q.d Q.src Q.mu := by
  refine ⟨fun j hj => hQ.src_pos j hj, fun i j hi hj hij => hQ.src.cop i j hi hj hij,
    fun j hj => ?_⟩
  have h2 := hQ.src_pos j hj
  have hc : Nat.Coprime (∏ i ∈ Finset.range j, Q.src i) (Q.src j) := by
    refine Nat.Coprime.prod_left fun i hi => ?_
    have hj' : j < dP6 Q.P Q.n := hj
    exact hQ.src.cop i j (by have := Finset.mem_range.1 hi; omega) hj
      (by have := Finset.mem_range.1 hi; omega)
  obtain ⟨-, hm⟩ := mu_spec (∏ i ∈ Finset.range j, Q.src i) (Q.src j) h2 hc
  have e : OpenAI.RCRT.Ppre Q.src j = ∏ i ∈ Finset.range j, Q.src i := rfl
  rw [e, ← ZMod.natCast_mod, show Q.mu j = muInv (∏ i ∈ Finset.range j, Q.src i) (Q.src j) from rfl,
    hm, ZMod.natCast_mod, Nat.cast_one]

end QOk

/-! ## The register file -/

end

end IntMul.Kappa.R6

end

