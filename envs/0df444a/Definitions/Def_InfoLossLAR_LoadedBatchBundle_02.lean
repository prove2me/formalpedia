  let input := (_root_.Integration9_9.CoordinateMachine.publicTask word).2
  _root_.Integration9_9.LARCoinMachine.powerWithSlots ((_root_.Integration9_9.LARPlatformEncoding.readParameters input.2.1).2.1,_root_.Integration9_9.CoordinateMachine.jointSlots input.2.2)
