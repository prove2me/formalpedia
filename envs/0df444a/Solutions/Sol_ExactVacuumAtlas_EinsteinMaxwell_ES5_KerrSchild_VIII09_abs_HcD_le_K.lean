theorem solution {x : ℝ} (hx : x ∈ KG) : |HcD x| ≤ 9 / 8 := by
  have hxU : x ∈ UG := KG_subset_UG hx
  have hint : IntervalIntegrable (fun t : ℝ => t * (1 - t * x)⁻¹ ^ 2) volume 0 1 := by
