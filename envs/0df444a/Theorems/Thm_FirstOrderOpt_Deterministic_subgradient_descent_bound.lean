-- title:
--   Theorem 3.1 — subgradient descent function-value bound
-- statement:
--   Assume $f$ is $M$-Lipschitz on $X$: $|f(x)-f(y)| \le M\|x-y\|_2$ for all $x,y\in X$
--   (Assumption (3.1.5)). Let $(x_t)_{t\ge1}$ be generated by the projected-subgradient update
--   (3.1.3).
--
--   **Theorem 3.1.** For every $x \in X$ and $1 \le s \le k$,
--   $$\sum_{t=s}^{k} \gamma_t\big[f(x_t)-f(x)\big] \le \tfrac12\Big(\|x-x_s\|_2^2 + M^2
--   \sum_{t=s}^{k}\gamma_t^2\Big).$$
--
--   This is the workhorse convergence bound of the whole chapter: choosing $x=x^*$ and dividing
--   by $\sum_t\gamma_t$ immediately yields a rate on the averaged iterate's function-value gap
--   (Corollary 3.1), and its proof pattern (telescoping `Lemma 3.1` against $M$-Lipschitzness) is
--   reused verbatim, with the Euclidean norm replaced by a Bregman divergence, for the mirror
--   descent bound (`mirror_descent_bound`, Theorem 3.5) below.
--
--   **Formalization Note.** The generation rule (3.1.3) is stated the same way as in
--   `subgradient_iterate_three_point`: $x_{t+1}$ pointwise-minimizes $u \mapsto \gamma_t\langle
--   g(x_t),u\rangle + \tfrac12\|u-x_t\|_2^2$ over $X$. $g(x_t)$ being a genuine subgradient of
--   $f$ at $x_t$ is stated as its own hypothesis (the subgradient inequality $f(x_t)+\langle
--   g(x_t), y-x_t\rangle \le f(y)$ for all $y\in X$), since the proof's use of convexity of $f$
--   needs it even though the *generation rule* (3.1.4) alone would make sense for an arbitrary
--   vector in place of a true subgradient.
-- source:
--   Lan, First-order and Stochastic Optimization Methods for Machine Learning, Springer 2020, p. 54, Theorem 3.1

import Mathlib

namespace FirstOrderOpt.Deterministic

open scoped RealInnerProductSpace

/-- Theorem 3.1 (subgradient descent function-value bound). `f` is `M`-Lipschitz on `X`
(Assumption (3.1.5)); `x t` is generated by the projected-subgradient update (3.1.3), with `g t`
a subgradient of `f` at `x t`. Then for every `x' ∈ X` and `s ≤ k`,
`Σ_{t=s}^{k} γt[f(x t) - f x'] ≤ (1/2)(‖x' - x s‖² + M² Σ_{t=s}^{k} γt²)`. -/
theorem subgradient_descent_bound {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (X : Set E) (f : E → ℝ) (M : ℝ) (hM : 0 < M)
    (hLip : ∀ x ∈ X, ∀ y ∈ X, |f x - f y| ≤ M * ‖x - y‖)
    (x g : ℕ → E) (γ : ℕ → ℝ)
    (hx : ∀ t, x t ∈ X) (hγ : ∀ t, 0 < γ t)
    (hsub : ∀ t, ∀ y ∈ X, f (x t) + ⟪g t, y - x t⟫ ≤ f y)
    (hmin : ∀ t, ∀ y ∈ X, γ t * ⟪g t, x (t + 1)⟫ + (1 / 2) * ‖x (t + 1) - x t‖ ^ 2 ≤
      γ t * ⟪g t, y⟫ + (1 / 2) * ‖y - x t‖ ^ 2)
    (s k : ℕ) (hsk : s ≤ k) :
    ∀ x' ∈ X, ∑ t ∈ Finset.Icc s k, γ t * (f (x t) - f x') ≤
      (1 / 2) * (‖x' - x s‖ ^ 2 + M ^ 2 * ∑ t ∈ Finset.Icc s k, (γ t) ^ 2) := by sorry

end FirstOrderOpt.Deterministic
