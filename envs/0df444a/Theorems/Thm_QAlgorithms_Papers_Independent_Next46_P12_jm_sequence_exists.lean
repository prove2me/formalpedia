-- title:
--   Proposition 3.2: existence of JM-sequences
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. Suppose $k$ is infinite. One can choose $z_n\in A_n$ simultaneously, with $z_0=0$ and $k[z_n]=Z(A_n)$ for every $n\ge1$, such that
--
--   $$J_n=z_n-z_{n-1}\quad(n\ge1)$$
--
--   is a JM sequence: $J_n\in X_n$, its partial sum through $n$ belongs to $Z(A_n)$, and $k[J_1,\ldots,J_n]=X_n$ for every $n$. Differences use the specified inclusions.
--
--   This gives the source construction of a JM sequence throughout an infinite tower.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 11, Proposition 3.2: existence of JM-sequences

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Proposition 3.2, source PDF p. 11. Center generators are chosen simultaneously
with z_0=0; their differences after inclusion give the constructed JM sequence. -/
theorem jm_sequence_exists [Infinite k] (D : Tower k AA) :
    ∃ z : (n : ℕ) → AA n, z 0 = 0 ∧
      (∀ n, GeneratesCenter (k := k) (z (n + 1))) ∧
      IsJMSequence D (fun n => z (n + 1) - D.inc n (n + 1) (by omega) (z n)) := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
