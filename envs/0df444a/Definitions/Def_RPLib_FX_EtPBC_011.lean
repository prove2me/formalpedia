-- ===== S4.Def_RP_EtPBC_A_CovAR =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-1b): uniform relations of `p` on the base charts (Artin-Rees)

For `α : Fin g → R` and `ιB : R → B`:
* **`RelV p α ιB n`**: vectors `w` with entries in `p^n B` and `∑ αᵢ wᵢ = 0`; `muB`, `mem_smul_top_pi`, `mem_relV_iff`;
* **`relV_transport`**: a chart-0 relation is `t₀^f` times a chart-1 relation on the overlap `N`;
* **`relV_uniform`** (Artin-Rees, `B₀` noetherian): one bound `F` such that for every `n` the relations `RelV n` are
  `p^(n-n')`-combinations of finitely many relations in `RelV n'` (`n' ≤ n`) whose transition exponents are `≤ F`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section RelV

variable {R : Type u} [CommRing R] (p : Ideal R) {g : ℕ} (α : Fin g → R)

variable {B₀ B₁ N : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] (φ₀ : B₀ →+* N) (φ₁ : B₁ →+* N)
  (t₀ : B₀) (t₁ : B₁) (ιB₀ : R →+* B₀) (ιB₁ : R →+* B₁)

/-- **A chart-0 relation is `t₀^f` times a chart-1 relation** on the overlap. -/
theorem relV_transport (hφ₁ : IsAwayMap φ₁ t₁) (hu₁ : IsUnit (φ₁ t₁)) (hts : φ₀ t₀ * φ₁ t₁ = 1)
    (hιB : φ₀.comp ιB₀ = φ₁.comp ιB₁) (n : ℕ) (w : Fin g → B₀) (hw : w ∈ RelV p α ιB₀ n) :
    ∃ (f : ℕ) (w₁ : Fin g → B₁), w₁ ∈ RelV p α ιB₁ n ∧ ∀ i, φ₀ (w i) = φ₀ t₀ ^ f * φ₁ (w₁ i) := by
  letI := φ₁.toAlgebra
  haveI : IsLocalization.Away t₁ N := isLocalization_of_isAwayMap φ₁ t₁ hφ₁ hu₁
  have hloc : ∀ i, ∃ (k : ℕ) (b : B₁), b ∈ (p ^ n).map ιB₁ ∧ φ₁ t₁ ^ k * φ₀ (w i) = φ₁ b := by
    intro i
    have hi : φ₀ (w i) ∈ ((p ^ n).map ιB₁).map (algebraMap B₁ N) := by
      rw [Ideal.map_map]
      change φ₀ (w i) ∈ (p ^ n).map (φ₁.comp ιB₁)
      rw [← hιB, ← Ideal.map_map]
      exact Ideal.mem_map_of_mem _ (hw.1 i)
    obtain ⟨⟨⟨b, hb⟩, ⟨_, k, rfl⟩⟩, hx⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers t₁) N).1 hi
    refine ⟨k, b, hb, ?_⟩
    have hx' : φ₀ (w i) * φ₁ (t₁ ^ k) = φ₁ b := hx
    rw [map_pow, mul_comm] at hx'
    exact hx'
  choose k b hb hkb using hloc
  obtain ⟨K, hK⟩ : ∃ K, K = ∑ i, k i := ⟨_, rfl⟩
  have hkK : ∀ i, k i ≤ K := fun i => hK ▸ Finset.single_le_sum (fun j _ => Nat.zero_le (k j)) (Finset.mem_univ i)
  obtain ⟨b', hb'd⟩ : ∃ b' : Fin g → B₁, ∀ i, b' i = t₁ ^ (K - k i) * b i := ⟨_, fun i => rfl⟩
  have hb' : ∀ i, φ₁ t₁ ^ K * φ₀ (w i) = φ₁ (b' i) := by
    intro i
    rw [hb'd, map_mul, map_pow, ← hkb i, ← mul_assoc, ← pow_add, Nat.sub_add_cancel (hkK i)]
  have h0 : φ₁ (∑ i, ιB₁ (α i) * b' i) = 0 := by
    rw [map_sum]
    have e : ∀ i, φ₁ (ιB₁ (α i) * b' i) = φ₁ t₁ ^ K * φ₀ (ιB₀ (α i) * w i) := by
      intro i
      have hα' := RingHom.congr_fun hιB (α i)
      simp only [RingHom.comp_apply] at hα'
      rw [map_mul, map_mul, ← hb' i, ← hα']
      ring
    simp only [e]
    rw [← Finset.mul_sum, ← map_sum, hw.2, map_zero, mul_zero]
  obtain ⟨k', hk'⟩ := hφ₁.2 _ h0
  refine ⟨k' + K, fun i => t₁ ^ k' * b' i, ⟨fun i => ?_, ?_⟩, fun i => ?_⟩
  · show t₁ ^ k' * b' i ∈ _
    rw [hb'd]
    exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (hb i))
  · rw [Finset.mul_sum] at hk'
    exact (Finset.sum_congr rfl fun i _ => by ring).trans hk'
  · show φ₀ (w i) = φ₀ t₀ ^ (k' + K) * φ₁ (t₁ ^ k' * b' i)
    rw [map_mul, map_pow, ← hb' i]
    have hp : (φ₀ t₀ * φ₁ t₁) ^ (k' + K) = 1 := by rw [hts, one_pow]
    linear_combination (-φ₀ (w i)) * hp

end RelV

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovL3 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A1c): the tower of nilpotent lifts of a two-chart etale cover

* **`TwoCov φb₀ φb₁ τ₀ τ₁`**: a two-chart finite etale cover (bundled rings, `RingHom.Etale`/`Finite` properties);
  **`TwoCovHom π₀ π₁ π C' C`**: a transition `C' → C` over reductions `πᵢ`, `π` (surjective, kernels, squares);
* **`exists_lift`**: `lift_step` in this language;
* levels `B ⧸ J^(k+1)`: `down` (square-zero kernel), `qmap` (with `isAwayMap_qmap`, `isUnit_qmap`, `qmap_down`);
* **`tower`**, **`towerHom`**: the lifts of a level-0 cover to all levels `k`, with transitions.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Cov

end Cov

section Hom

variable {B₀ B₁ N b₀ b₁ n : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] [CommRing b₀] [CommRing b₁]
  [CommRing n] {φ₀ : B₀ →+* N} {φ₁ : B₁ →+* N} {t₀ : B₀} {t₁ : B₁} {φb₀ : b₀ →+* n} {φb₁ : b₁ →+* n} {τ₀ : b₀}
  {τ₁ : b₁}

/-- **A transition** `C' → C` of two-chart covers over the reductions `πᵢ`, `π`. -/
structure TwoCovHom (π₀ : B₀ →+* b₀) (π₁ : B₁ →+* b₁) (π : N →+* n) (C' : TwoCov φ₀ φ₁ t₀ t₁)
    (C : TwoCov φb₀ φb₁ τ₀ τ₁) where
  ρ₀ : C'.E₀ →+* C.E₀
  ρ₁ : C'.E₁ →+* C.E₁
  ρ : C'.E →+* C.E
  s₀ : Function.Surjective ρ₀
  s₁ : Function.Surjective ρ₁
  s : Function.Surjective ρ
  k₀ : RingHom.ker ρ₀ = (RingHom.ker π₀).map C'.a₀
  k₁ : RingHom.ker ρ₁ = (RingHom.ker π₁).map C'.a₁
  k : RingHom.ker ρ = (RingHom.ker ρ₀).map C'.ψ₀
  c₀ : ρ₀.comp C'.a₀ = C.a₀.comp π₀
  c₁ : ρ₁.comp C'.a₁ = C.a₁.comp π₁
  c : ρ.comp C'.a = C.a.comp π
  d₀ : ρ.comp C'.ψ₀ = C.ψ₀.comp ρ₀
  d₁ : ρ.comp C'.ψ₁ = C.ψ₁.comp ρ₁

end Hom

section Lift

end Lift

section Lvl

variable {B : Type u} [CommRing B] (J : Ideal B)

variable {N : Type u} [CommRing N] (φ : B →+* N) (JN : Ideal N)

/-- **Localizations pass to the levels.** -/
theorem isAwayMap_qmap (h : J.map φ = JN) (t : B) (hφ : IsAwayMap φ t) (hu : IsUnit (φ t)) (k : ℕ) :
    IsAwayMap (qmap J φ JN h k) (Ideal.Quotient.mk _ t) := by
  letI := φ.toAlgebra
  haveI : IsLocalization.Away t N := isLocalization_of_isAwayMap φ t hφ hu
  constructor
  · intro y
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨m, a, ha⟩ := hφ.1 y
    refine ⟨m, Ideal.Quotient.mk _ a, ?_⟩
    rw [Ideal.quotientMap_mk, Ideal.quotientMap_mk, ← map_pow, ← map_mul, ha]
  · intro a ha
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [Ideal.quotientMap_mk, Ideal.Quotient.eq_zero_iff_mem, ← h, ← Ideal.map_pow] at ha
    obtain ⟨⟨⟨i, hi⟩, ⟨_, m, rfl⟩⟩, hx⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers t) N).1 ha
    have h0 : φ (a * t ^ m - i) = 0 := by
      rw [map_sub, map_mul]
      exact sub_eq_zero.2 hx
    obtain ⟨r, hr⟩ := hφ.2 _ h0
    refine ⟨r + m, ?_⟩
    rw [← map_pow, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    have e : t ^ (r + m) * a = t ^ r * i := by
      rw [pow_add]
      linear_combination hr
    rw [e]
    exact Ideal.mul_mem_left _ _ hi

end Lvl

section Tower

end Tower

end RamanujanPetersson.EtPBC.Cov

end

