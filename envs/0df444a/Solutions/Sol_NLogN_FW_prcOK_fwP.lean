theorem dit_runs_ren (hf : Function.Injective f) (pT : Fin P)
    (hP : iprog' pT = (ditBody pT).ren f id) (n : ℕ) (hn : 1 ≤ n) :
    ∀ j (t : IState S') (B : List ℤ) (R LL LE LN LF : List Item) (E : ℕ),
      B.length = 2 ^ j → (j = 0 ∨ 2 ^ j * E = 2 * n) → Canon (2 ^ n + 1) B →
      t.G (f DX) = ints B ++ R → t.G (f DL) = .int (2 ^ j) :: LL →
      t.G (f NLogN.DE) = .int (2 ^ E) :: LE →
      t.G (f RN) = .int (2 ^ n) :: LN → t.G (f RF) = .int (2 ^ n + 1) :: LF →
