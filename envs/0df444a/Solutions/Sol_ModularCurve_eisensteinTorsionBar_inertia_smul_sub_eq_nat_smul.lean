open ModularCurve

namespace P2MW5A
open ModularCurve MazurAdmissible

variable (p : ℕ) [Fact p.Prime]

scoped instance neZero_of_fact_prime_w5 : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩

theorem galois_smul_hecke_smul (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (t : HeckeAlg) (x : JZero p) :
    (letI := heckeModuleBar p; σ • (t • x) = t • (σ • x)) := by
  letI := heckeModuleBar p
  induction t using MvPolynomial.induction_on generalizing x with
  | C a =>
    rw [heckeModuleBar_C_smul, heckeModuleBar_C_smul]
    exact map_zsmul (DistribSMul.toAddMonoidHom (JZero p) σ) a x
  | add f g hf hg => rw [add_smul, add_smul, smul_add, hf, hg]
  | mul_X f ℓ hf =>
    rw [mul_smul, mul_smul, hf]
    congr 1
    exact (heckeGen_smul_galois_smul p σ ℓ x).symm

theorem smul_mem_eisensteinTorsionBar (q m : ℕ) (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    {x : JZero p} (hx : x ∈ eisensteinTorsionBar p q m) : σ • x ∈ eisensteinTorsionBar p q m := by
  letI := heckeModuleBar p
  change σ • x ∈ Submodule.torsionBySet HeckeAlg (JZero p) _
  rw [Submodule.mem_torsionBySet_iff]
  rintro ⟨a, ha⟩
  have hax : a • x = 0 := (Submodule.mem_torsionBySet_iff _ _).mp hx ⟨a, ha⟩
  show a • σ • x = 0
  rw [← galois_smul_hecke_smul, hax]
  exact map_zero (DistribSMul.toAddMonoidHom (JZero p) σ)

theorem eisensteinTorsionBar_le_torsionBy (q m : ℕ) {x : JZero p} (hx : x ∈ eisensteinTorsionBar p q m) :
    x ∈ Submodule.torsionBy ℤ (JZero p) ((q : ℤ) ^ m) := by
  letI := heckeModuleBar p
  have hq : ((q : HeckeAlg) ^ m) ∈ (↑((eisensteinMaximalIdeal p q) ^ m) : Set HeckeAlg) :=
    Ideal.pow_mem_pow (natCast_mem_eisensteinMaximalIdeal p q) m
  have h0 : ((q : HeckeAlg) ^ m) • x = 0 := (Submodule.mem_torsionBySet_iff _ _).mp hx ⟨_, hq⟩
  have h1 : ((q : HeckeAlg) ^ m) • x = ((q : ℤ) ^ m) • x := by
    rw [show ((q : HeckeAlg) ^ m) = MvPolynomial.C ((q : ℤ) ^ m) by simp, heckeModuleBar_C_smul]
  rw [Submodule.mem_torsionBy_iff, ← h1, h0]

