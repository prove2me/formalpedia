-- title:
--   Proposition 4.2 — inverse and polynomial square root
-- statement:
--   Let $B$ be a finite-dimensional complex algebra, $x_0\in B$, and $p\in\mathbb C[X]$. Assume $p(a)\ne0$ for each eigenvalue $a$ of left multiplication by $x_0$ on the regular $B$-module. Then
--   $$p(x_0)\text{ is invertible in }B,\qquad \exists z\in\mathbb C[x_0]:z^2=p(x_0).$$
--
--   The result supplies the inverse and square-root operations used in the idempotent truncation. **Formalization Note** In finite dimension, ordinary and generalized eigenvalues have the same underlying set. The square root is required to lie in the algebra generated by $x_0$, as in the proof on p. 9.
-- source:
--   Sartori and Stroppel, Walled Brauer algebras as idempotent truncations of level 2 cyclotomic quotients, arXiv:1411.2771v2, pp. 8–9, Proposition 4.2

import Mathlib
import Definitions.Def_WalledBrauer_LevelTwo_Setting

namespace WalledBrauer.LevelTwo

/-- Proposition 4.2, p. 8. An eigenvalue of left multiplication on the regular
module is equivalently a generalized eigenvalue in finite dimension. -/
theorem proposition_4_2 {B : Type*} [Ring B] [Algebra ℂ B]
    [FiniteDimensional ℂ B] (p : Polynomial ℂ) (x₀ : B)
    (h : ∀ a : ℂ, (∃ v : B, v ≠ 0 ∧ x₀ * v = a • v) → p.eval a ≠ 0) :
    (∃ z : B,
      z * p.eval₂ (algebraMap ℂ B) x₀ = 1 ∧
      p.eval₂ (algebraMap ℂ B) x₀ * z = 1) ∧
    (∃ z : B, z ∈ Algebra.adjoin ℂ {x₀} ∧
      z * z = p.eval₂ (algebraMap ℂ B) x₀) := by sorry

end WalledBrauer.LevelTwo
