theorem solution {n : ℕ} {A : CoVec n} {F : TwoForm n} {U : Set (Pt n)}
    (hU : IsOpen U) (hA : ∀ i, ContDiffOn ℝ ∞ (A i) U) (hF : ∀ i j, Set.EqOn (F i j) (extD A i j) U)
    {x : Pt n} (hx : x ∈ U) (a b c : Fin n) : faradayCyclic F a b c x = 0 := by
