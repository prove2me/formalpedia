      Λ.toAddSubgroup.relIndex J'.toAddSubgroup = N ^ 2 ∧ (∀ x ∈ Λ, x ∈ R ↔ ∀ y ∈ J', y * x ∈ J'))
    (L M : Submodule ℤ (Fin 2 → ℂ)) (hLM : L ≤ M)
    (hMstab : ∀ x ∈ Λ, ∀ v ∈ M, ((ι x).map (algebraMap ℝ ℂ)).mulVec v ∈ M)
    (hMN : ∀ v ∈ M, (N : ℤ) • v ∈ L) (hidx : L.toAddSubgroup.relIndex M.toAddSubgroup = N ^ 2)
    (τ : UpperHalfPlane) (c : ℂ) (hc : c ≠ 0) (hL : c • L = qmPeriodLattice ι Λ τ)
    (hlevM : ∀ (lam : ℍ[ℚ, a, b]), lam ∈ Λ → ∀ r ∈ R,
      ((N : ℂ)⁻¹) • qmPeriodMap ι τ lam ∈ c • M → ((N : ℂ)⁻¹) • qmPeriodMap ι τ (lam * r) ∈ c • M) :
    c • M = qmPeriodLattice ι J' τ := by

  have h1 : qmPeriodLattice ι Λ τ ≤ c • M := by rw [← hL]; exact Submodule.map_mono hLM
  have h2 : ∀ v ∈ c • M, ((N : ℤ) • v) ∈ qmPeriodLattice ι Λ τ := by
    intro v hv
    obtain ⟨u, hu, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hv
    rw [← hL, smul_comm]
    exact Submodule.smul_mem_pointwise_smul _ _ _ (hMN u hu)
  have h3 : ∀ x ∈ Λ, ∀ v ∈ c • M, ((ι x).map (algebraMap ℝ ℂ)).mulVec v ∈ c • M := by
    intro x hx v hv
    obtain ⟨u, hu, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hv
    rw [Matrix.mulVec_smul]
    exact Submodule.smul_mem_pointwise_smul _ _ _ (hMstab x hx u hu)
  have h4 : (qmPeriodLattice ι Λ τ).toAddSubgroup.relIndex (c • M).toAddSubgroup = N ^ 2 := by
    rw [← hL, Submodule.pointwise_smul_toAddSubgroup, Submodule.pointwise_smul_toAddSubgroup,
      AddSubgroup.pointwise_smul_def, AddSubgroup.pointwise_smul_def,
      AddSubgroup.relIndex_map_map_of_injective _ _ (smul_right_injective (Fin 2 → ℂ) hc)]
    exact hidx
  obtain ⟨J'', hJ'', hM⟩ :=
    (QuaternionAlgebra.IsEichlerOrder.forall_mem_imp_mem_iff_exists_levelModule_qmPeriodLattice_eq
      hqN hq'N hqq' hB Λ hΛ hN R hR hRΛ ι hι τ (c • M) h1 h2 h3 h4).1 hlevM
  rw [hM, QuaternionAlgebra.IsEichlerOrder.levelModule_unique hqN hq'N hqq' hB Λ hΛ hN R hR hRΛ ι hι J' J'' hJ' hJ'']

end LocalH0.LL

