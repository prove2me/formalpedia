theorem solution {Rh Ri : ℝ} (hRi : 0 ≤ Ri) (hlt : Ri < Rh) {h : ℝ → ℝ} {C Rs : ℝ}
    (hC : 0 ≤ C) (hRs : Rh < Rs) (hb : ∀ R ≥ Rs, |h R| ≤ C / R ∧ |deriv h R| ≤ C / R ^ 2) :
    Tendsto (energy Rh Ri h) atTop (𝓝 0) := by
