  refine s4.mono (fun v' e' => ?_) le_rfl
  subst e'
  refine ⟨fun j hj => ?_, ?_, hB3⟩
  · obtain ⟨a1, a2, a3⟩ := T3_nm hj
    rw [update_of_ne a3, update_of_ne a3, update_of_ne a2, hI j hj]
