variable {k : Type} [CommRing k] {σ τ : Type}

theorem ReciprocityTheory.ChartRestriction.G.TB.LogPf.pderiv_aeval [Fintype σ] (a : σ → MvPowerSeries τ k) (p : MvPolynomial σ k) (t : τ) :
    pderiv k t (MvPolynomial.aeval a p) =
      ∑ s, MvPolynomial.aeval a (MvPolynomial.pderiv s p) * pderiv k t (a s) := by sorry
