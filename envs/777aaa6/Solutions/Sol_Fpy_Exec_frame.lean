set_option autoImplicit true
open Fpy
variable {L : Signature}
variable (Φ : Program L)
namespace Fpy
namespace Exec
theorem _root_.solution : ∀ {σ : Store} {C : Val} {s : Stmt L} {o : Outcome} {σ' : Store},
    Exec Φ σ C s o → o = .normal σ' → ∀ x ∉ s.assigned, σ' x = σ x
  | _, _, _, _, _, .assign _, h, _, hx => by
    cases h
    exact Function.update_of_ne (List.ne_of_not_mem_cons hx) _ _
  | _, _, _, _, _, .skip, h, _, _ | _, _, _, _, _, .assert _, h, _, _
  | _, _, _, _, _, .whileFalse _, h, _, _ => by cases h; rfl
  | _, _, _, _, _, .ret _, h, _, _ | _, _, _, _, _, .seqRet _, h, _, _ => by cases h
  | _, _, _, _, _, .seqNormal h₁ h₂, h, x, hx =>
    (solution h₂ h x fun hm => hx (List.mem_append_right _ hm)).trans
      (solution h₁ rfl x fun hm => hx (List.mem_append_left _ hm))
  | _, _, _, _, _, .iteTrue _ h₁, h, x, hx =>
    solution h₁ h x fun hm => hx (List.mem_append_left _ hm)
  | _, _, _, _, _, .iteFalse _ h₂, h, x, hx =>
    solution h₂ h x fun hm => hx (List.mem_append_right _ hm)
  | _, _, _, _, _, .whileTrue _ hs, h, x, hx =>
    solution hs h x fun hm => hx (by simpa [Stmt.assigned] using hm)
  | _, _, _, _, _, .withCtx _ _ hs, h, x, hx => solution hs h x hx
termination_by structural _ _ _ _ _ h => h
end Exec
end Fpy
