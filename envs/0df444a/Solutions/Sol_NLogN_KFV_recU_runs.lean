section Sims

variable {c KG : ℤ} {b r : ℕ} {BJ D2 : ℤ}

theorem πr_c : πr c KG b r BJ D2 kc = some c := by simp +decide [πR, pmOf]
theorem πr_r : πr c KG b r BJ D2 kr = some (r : ℤ) := by simp +decide [πR, pmOf]

theorem isim_ilv : ISim I iprog (πr c KG b r BJ D2) (fcode (ilvP r)) (fcode ilvU) :=
  ISim.fcodeG (.rep _ (.lit (LitOK.reg (πR_low _ _ _ _ _ _) πr_r)) (GSim.refl _ _))

theorem isim_unz (X SA SB C : Fin HS) :
    ISim I iprog (πr c KG b r BJ D2) (fcode (unzP X SA SB C c r)) (fcode (unzU X SA SB C)) :=
  ISim.fcodeG (gsim_unz (πR_low _ _ _ _ _ _) πr_c πr_r X SA SB C)

end Sims

theorem PZ.upd {c r KG B BJ D2 : ℤ} {g : Fin HS → List ℤ} (h : PZ (πR c r KG B BJ D2) g)
    {j : Fin HS} {L : List ℤ} (hj : j.val < 50) : PZ (πR c r KG B BJ D2) (Function.update g j L) := by
  intro i v hv
  have := πR_some hv
  rw [Function.update_of_ne (by rintro rfl; omega)]
  exact h i v hv

theorem NW_fcodeL {c r KG B BJ D2 : ℤ} {p : RS} (h : lowW p = true) :
    NW (πR c r KG B BJ D2) (fcode p : IStmt HS Pp) :=
  NW_fcodeR fun j hj => by unfold lowW at h; rw [List.all_eq_true] at h; simpa using h j hj

end NLogN.KFV

end

section
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.KFV
open IntMul KIL KFD KFT KFB KFC RS
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
open Synth
set_option maxHeartbeats 8000000
theorem solution {M : NLogN.MulSpec} {pM : Fin Pp} (hM : NLogN.MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {b r p ρ φ : ℕ} (hΦ : ∀ x y : ℤ, NLogN.zsz x ≤ b * r + 2 → NLogN.zsz y ≤ b * r + 2 → M.Φ x y ≤ φ)
    (hb : 1 ≤ b) (hr : 1 ≤ r) (hbig : 2 * r * 2 ^ (2 * p) < 2 ^ (b - 1))
    (s : NLogN.IState NLogN.HS) (f : Fin NLogN.HS → List ℤ) (zx zy : List NLogN.KFB.GI) (lx ly : List ℤ)
    (hX : f NLogN.KFV.vX = NLogN.KFB.gflat zx ++ lx) (hY : f NLogN.KFV.vY = NLogN.KFB.gflat zy ++ ly) (hlx : zx.length = r)
    (hly : zy.length = r)
    (hzx : ∀ z ∈ zx, |z.1| ≤ 2 ^ p ∧ |z.2| ≤ 2 ^ p) (hzy : ∀ z ∈ zy, |z.1| ≤ 2 ^ p ∧ |z.2| ≤ 2 ^ p)
    (hT : NLogN.KFV.Tmp f)
    (hP : NLogN.KIL.PV (NLogN.KFV.πr (2 ^ p) (NLogN.KFV.kG b r (2 ^ p)) b r ((2 ^ b) ^ (2 * r)) (2 ^ (p + ρ))) s)
    (hF : NLogN.KFV.PZ (NLogN.KFV.πr (2 ^ p) (NLogN.KFV.kG b r (2 ^ p)) b r ((2 ^ b) ^ (2 * r)) (2 ^ (p + ρ))) f) :
    NLogN.IRuns I iprog (NLogN.KFV.recU pM) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update (Function.update (Function.update f NLogN.KFV.vX lx) NLogN.KFV.vY ly) NLogN.KFV.vO
        ((NLogN.KFB.gflat (NLogN.KFV.kmul r p ρ zx zy)).reverse ++ f NLogN.KFV.vO)))
      (2000 * NLogN.KFV.cRec r p b (p + ρ) φ) := by
  set c : ℤ := 2 ^ p with hc
  set KG := NLogN.KFV.kG b r c with hKG
  set Bb := NLogN.zsz ((2 * r : ℕ) : ℤ) with hBb
  set H : ℤ := 2 ^ (b - 1) with hHdef
  have hBH : (2 : ℤ) ^ b = 2 * H := NLogN.KFV.two_pow_pred hb
  have hbigZ : (2 : ℤ) * r * 2 ^ (2 * p) < H := by rw [hHdef]; exact_mod_cast hbig
  have hrZ : (1 : ℤ) ≤ r := by exact_mod_cast hr
  have hcp : (0 : ℤ) < c := by positivity
  have hcH : c ≤ H := by
    have h1 : c ≤ 2 ^ (2 * p) := pow_le_pow_right₀ (by norm_num) (by omega)
    nlinarith [pow_pos (two_pos : (0 : ℤ) < 2) (2 * p)]
  have hc2 : c * c = 2 ^ (2 * p) := by rw [hc, ← pow_add]; ring_nf
  -- widths
  have zw : ∀ x : ℤ, |x| ≤ 2 * c → NLogN.zsz x ≤ p + 2 := fun x hx =>
    NLogN.zsz_le_of_abs (by
      have : (2 : ℤ) * c < 2 ^ (p + 2) := by rw [hc, pow_add]; nlinarith [pow_pos (two_pos : (0 : ℤ) < 2) p]
      linarith)
  have hzc : NLogN.zsz c ≤ p + 2 := zw c (by rw [abs_of_pos hcp]; linarith)
  have hwx : ∀ z ∈ zx, NLogN.zsz z.1 ≤ p + 2 ∧ NLogN.zsz z.2 ≤ p + 2 ∧ NLogN.zsz (z.1 + c) ≤ p + 2 ∧
      NLogN.zsz (z.2 + c) ≤ p + 2 := by
    intro z hz
    obtain ⟨h1, h2⟩ := hzx z hz
    refine ⟨zw _ (by linarith), zw _ (by linarith), zw _ ?_, zw _ ?_⟩ <;>
      (rw [abs_le] at h1 h2 ⊢; constructor <;> linarith)
  have hwy : ∀ z ∈ zy, NLogN.zsz z.1 ≤ p + 2 ∧ NLogN.zsz z.2 ≤ p + 2 ∧ NLogN.zsz (z.1 + c) ≤ p + 2 ∧
      NLogN.zsz (z.2 + c) ≤ p + 2 := by
    intro z hz
    obtain ⟨h1, h2⟩ := hzy z hz
    refine ⟨zw _ (by linarith), zw _ (by linarith), zw _ ?_, zw _ ?_⟩ <;>
      (rw [abs_le] at h1 h2 ⊢; constructor <;> linarith)
  have hrBb : NLogN.zsz (r : ℤ) ≤ Bb := NLogN.zsz_natCast_le' (by omega)
  -- unzip both records
  have u1 := NLogN.KFV.unzP_fsp (X := NLogN.KFV.vX) (SA := NLogN.KFV.vA) (SB := NLogN.KFV.vB) (C := NLogN.KFV.vL) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s f zx lx c
    (p + 2) Bb hX hT.l hwx hzc (by rw [hlx]; exact hrBb)
  rw [hlx, hT.a, hT.b, List.append_nil, List.append_nil] at u1
  set zA := zx.map (NLogN.KFV.offG c) with hzA
  set zB := zx.map (fun z => NLogN.KFV.offG c z.swap) with hzB
  set zC := zy.map (NLogN.KFV.offG c) with hzC
  set zE := zy.map (fun z => NLogN.KFV.offG c z.swap) with hzE
  set f1 := Function.update (Function.update (Function.update f NLogN.KFV.vX lx) NLogN.KFV.vA (NLogN.KFB.gflat zA).reverse) NLogN.KFV.vB
    (NLogN.KFB.gflat zB).reverse with hf1
  have u2 := NLogN.KFV.unzP_fsp (X := NLogN.KFV.vY) (SA := NLogN.KFV.vC) (SB := NLogN.KFV.vE) (C := NLogN.KFV.vL) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s f1 zy ly c
    (p + 2) Bb (by simp +decide [hf1, hY]) (by simp +decide [hf1, hT.l]) hwy hzc (by rw [hly]; exact hrBb)
  rw [hly, show f1 NLogN.KFV.vC = [] by simp +decide [hf1, hT.c], show f1 NLogN.KFV.vE = [] by simp +decide [hf1, hT.e],
    List.append_nil, List.append_nil] at u2
  set f2 := Function.update (Function.update (Function.update f1 NLogN.KFV.vY ly) NLogN.KFV.vC (NLogN.KFB.gflat zC).reverse) NLogN.KFV.vE
    (NLogN.KFB.gflat zE).reverse with hf2
  -- packing
  have hBr : ∀ x : ℤ, |x| < 2 * (2 ^ b) ^ r → NLogN.zsz x ≤ b * r + 2 := fun x hx =>
    NLogN.zsz_le_of_abs (by
      have : (2 : ℤ) * (2 ^ b) ^ r < 2 ^ (b * r + 2) := by
        rw [← pow_mul, pow_add]; nlinarith [pow_pos (two_pos : (0 : ℤ) < 2) (b * r)]
      linarith)
  have hBrn : NLogN.zsz ((2 * r : ℕ) : ℤ) ≤ b * r + 2 := by
    apply NLogN.zsz_le_of_abs
    have h1 : r < 2 ^ r := Nat.lt_two_pow_self
    have h2 : (2 : ℕ) ^ (r + 1) ≤ 2 ^ (b * r + 2) := Nat.pow_le_pow_right (by norm_num) (by nlinarith)
    have h3 : 2 * r < 2 ^ (b * r + 2) := by rw [pow_succ] at h2; omega
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast h3
  have hKGb : |KG| < (2 ^ b) ^ r := NLogN.KFV.abs_pack_lt hb (a := fun _ => c) (fun h _ => by
    rw [abs_of_pos hcp]; exact hcH)
  have hBpos : (0 : ℤ) < (2 ^ b) ^ r := by positivity
  have hAb : ∀ (zs : List NLogN.KFB.GI) (g : NLogN.KFB.GI → ℤ), (∀ z ∈ zs, |g z| ≤ c) → g 0 = 0 →
      |∑ h ∈ Finset.range r, g (zs.getD h 0) * (2 ^ b : ℤ) ^ h| < (2 ^ b) ^ r := by
    intro zs g hg h0
    refine NLogN.KFV.abs_pack_lt hb (a := fun h => g (zs.getD h 0)) (fun h _ => ?_)
    exact le_trans (NLogN.KFV.getD_mem_bnd (P := fun z => |g z| ≤ c) hg (by simp [h0]; positivity) h) hcH
  set VA := ∑ h ∈ Finset.range r, NLogN.KFV.reF zx h * (2 ^ b : ℤ) ^ h with hVA
  set VB := ∑ h ∈ Finset.range r, NLogN.KFV.imF zx h * (2 ^ b : ℤ) ^ h with hVB
  set VC := ∑ h ∈ Finset.range r, NLogN.KFV.reF zy h * (2 ^ b : ℤ) ^ h with hVC
  set VE := ∑ h ∈ Finset.range r, NLogN.KFV.imF zy h * (2 ^ b : ℤ) ^ h with hVE
  have bVA : |VA| < (2 ^ b) ^ r := hAb zx (fun z => z.1) (fun z hz => (hzx z hz).1) rfl
  have bVB : |VB| < (2 ^ b) ^ r := hAb zx (fun z => z.2) (fun z hz => (hzx z hz).2) rfl
  have bVC : |VC| < (2 ^ b) ^ r := hAb zy (fun z => z.1) (fun z hz => (hzy z hz).1) rfl
  have bVE : |VE| < (2 ^ b) ^ r := hAb zy (fun z => z.2) (fun z hz => (hzy z hz).2) rfl
  have packStep : ∀ (S P : Fin NLogN.HS), S ≠ 0 → S ≠ NLogN.KFV.vL → P ≠ 0 → P ≠ S → S.val < 56 → P.val < 56 →
      NLogN.KFD.fok (NLogN.mvK S 0 NLogN.KFV.vL (.lit ((2 * r : ℕ) : ℤ))) = true →
      ∀ (zs0 : List NLogN.KFB.GI) (V : ℤ) (ff : Fin NLogN.HS → List ℤ), zs0.length = r →
      ff S = (NLogN.KFB.gflat zs0).reverse → ff NLogN.KFV.vL = [] → (∀ z ∈ zs0, 0 ≤ z.1) → NLogN.KFB.GB (p + 2) zs0 →
      (NLogN.KFT.carOut b zs0 : ℤ) - KG = V → |V| < (2 ^ b) ^ r →
      NLogN.IRuns I iprog (NLogN.KFV.packI S P b r KG) (NLogN.KIL.encK s ff)
        (NLogN.KIL.encK s (Function.update (Function.update ff S []) P (V :: ff P)))
        (NLogN.KFV.cPack r (p + 2) b (b * r + 2)) := by
    intro S P h1 h2 h3 h4 h5 h6 hfk zs0 V ff hl hS hL hre hw hV hVb
    have hco : (NLogN.KFT.carOut b zs0 : ℤ) = V + KG := by rw [← hV]; ring
    have := NLogN.KFV.packI_runs (I := I) (iprog := iprog) h1 h2 h3 h4 h5 h6 hb KG s ff zs0 [] hl (by rw [hS, List.append_nil]) hL hre hw
      (hBr _ (by rw [hco]; have := abs_add_le V KG; linarith))
      (hBr _ (by linarith))
      (hBr _ (by rw [hV]; linarith)) hBrn hfk
    rw [hV] at this
    exact this
  have reA : ∀ z ∈ zA, 0 ≤ z.1 := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    have := abs_le.1 (hzx w hw).1; simp only [NLogN.KFV.offG]; linarith
  have reB : ∀ z ∈ zB, 0 ≤ z.1 := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    have := abs_le.1 (hzx w hw).2; simp only [NLogN.KFV.offG, Prod.fst_swap]; linarith
  have reC : ∀ z ∈ zC, 0 ≤ z.1 := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    have := abs_le.1 (hzy w hw).1; simp only [NLogN.KFV.offG]; linarith
  have reE : ∀ z ∈ zE, 0 ≤ z.1 := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    have := abs_le.1 (hzy w hw).2; simp only [NLogN.KFV.offG, Prod.fst_swap]; linarith
  have gA : NLogN.KFB.GB (p + 2) zA := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    exact ⟨(hwx w hw).2.2.1, by simp [NLogN.KFV.offG, NLogN.zsz_zero]⟩
  have gB : NLogN.KFB.GB (p + 2) zB := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    exact ⟨(hwx w hw).2.2.2, by simp [NLogN.KFV.offG, NLogN.zsz_zero]⟩
  have gC : NLogN.KFB.GB (p + 2) zC := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    exact ⟨(hwy w hw).2.2.1, by simp [NLogN.KFV.offG, NLogN.zsz_zero]⟩
  have gE : NLogN.KFB.GB (p + 2) zE := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    exact ⟨(hwy w hw).2.2.2, by simp [NLogN.KFV.offG, NLogN.zsz_zero]⟩
  have vA' : (NLogN.KFT.carOut b zA : ℤ) - KG = VA := by
    have := NLogN.KFV.carOut_offG b c zx (fun z hz => by have := abs_le.1 (hzx z hz).1; linarith)
    rw [hlx] at this; exact this
  have vB' : (NLogN.KFT.carOut b zB : ℤ) - KG = VB := by
    have := NLogN.KFV.carOut_offG_swap b c zx (fun z hz => by have := abs_le.1 (hzx z hz).2; linarith)
    rw [hlx] at this; exact this
  have vC' : (NLogN.KFT.carOut b zC : ℤ) - KG = VC := by
    have := NLogN.KFV.carOut_offG b c zy (fun z hz => by have := abs_le.1 (hzy z hz).1; linarith)
    rw [hly] at this; exact this
  have vE' : (NLogN.KFT.carOut b zE : ℤ) - KG = VE := by
    have := NLogN.KFV.carOut_offG_swap b c zy (fun z hz => by have := abs_le.1 (hzy z hz).2; linarith)
    rw [hly] at this; exact this
  have k1 := packStep NLogN.KFV.vA NLogN.KFV.vPA (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by rw [NLogN.KFD.fok_mvK_eq]; decide) zA VA f2 (by simp +decide [hzA, hlx]) (by simp +decide [hf2, hf1]) (by simp +decide [hf2, hf1, hT.l]) reA gA vA' bVA
  rw [show f2 NLogN.KFV.vPA = [] by simp +decide [hf2, hf1, hT.pa]] at k1
  set f3 := Function.update (Function.update f2 NLogN.KFV.vA []) NLogN.KFV.vPA [VA] with hf3
  have k2 := packStep NLogN.KFV.vB NLogN.KFV.vPB (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by rw [NLogN.KFD.fok_mvK_eq]; decide) zB VB f3 (by simp +decide [hzB, hlx]) (by simp +decide [hf3, hf2, hf1]) (by simp +decide [hf3, hf2, hf1, hT.l]) reB gB
    vB' bVB
  rw [show f3 NLogN.KFV.vPB = [] by simp +decide [hf3, hf2, hf1, hT.pb]] at k2
  set f4 := Function.update (Function.update f3 NLogN.KFV.vB []) NLogN.KFV.vPB [VB] with hf4
  have k3 := packStep NLogN.KFV.vC NLogN.KFV.vPC (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by rw [NLogN.KFD.fok_mvK_eq]; decide) zC VC f4 (by simp +decide [hzC, hly]) (by simp +decide [hf4, hf3, hf2]) (by simp +decide [hf4, hf3, hf2, hf1, hT.l]) reC
    gC vC' bVC
  rw [show f4 NLogN.KFV.vPC = [] by simp +decide [hf4, hf3, hf2, hf1, hT.pc]] at k3
  set f5 := Function.update (Function.update f4 NLogN.KFV.vC []) NLogN.KFV.vPC [VC] with hf5
  have k4 := packStep NLogN.KFV.vE NLogN.KFV.vPE (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by rw [NLogN.KFD.fok_mvK_eq]; decide) zE VE f5 (by simp +decide [hzE, hly]) (by simp +decide [hf5, hf4, hf3, hf2]) (by simp +decide [hf5, hf4, hf3, hf2, hf1, hT.l])
    reE gE vE' bVE
  rw [show f5 NLogN.KFV.vPE = [] by simp +decide [hf5, hf4, hf3, hf2, hf1, hT.pe]] at k4
  set f6 := Function.update (Function.update f5 NLogN.KFV.vE []) NLogN.KFV.vPE [VE] with hf6
  -- products
  have zV : ∀ V : ℤ, |V| < (2 ^ b) ^ r → NLogN.zsz V ≤ b * r + 2 := fun V hV => hBr V (by linarith)
  have cm : ∀ x y : ℤ, |x| < (2 ^ b) ^ r → |y| < (2 ^ b) ^ r → NLogN.KFM.cMulC M x y ≤ φ + 1000 * (b * r + 3) :=
    fun x y hx hy => (NLogN.KFM.cMulC_le hΦ (zV x hx) (zV y hy)).trans (by omega)
  have q1 := NLogN.KFV.mulE hM NLogN.KFV.vM1 NLogN.KFV.vPA NLogN.KFV.vPC (by decide) (by decide) (by decide) s f6 VA VC [] []
    (by simp +decide [hf6, hf5, hf4, hf3]) (by simp +decide [hf6, hf5]) (hdom _ _)
  rw [show f6 NLogN.KFV.vM1 = [] by simp +decide [hf6, hf5, hf4, hf3, hf2, hf1, hT.m1]] at q1
  set f7 := Function.update f6 NLogN.KFV.vM1 [VC * VA] with hf7
  have q2 := NLogN.KFV.mulE hM NLogN.KFV.vM2 NLogN.KFV.vPB NLogN.KFV.vPE (by decide) (by decide) (by decide) s f7 VB VE [] []
    (by simp +decide [hf7, hf6, hf5, hf4]) (by simp +decide [hf7, hf6]) (hdom _ _)
  rw [show f7 NLogN.KFV.vM2 = [] by simp +decide [hf7, hf6, hf5, hf4, hf3, hf2, hf1, hT.m2]] at q2
  set f8 := Function.update f7 NLogN.KFV.vM2 [VE * VB] with hf8
  have q3 := NLogN.KFV.mulE hM NLogN.KFV.vM3 NLogN.KFV.vPA NLogN.KFV.vPE (by decide) (by decide) (by decide) s f8 VA VE [] []
    (by simp +decide [hf8, hf7, hf6, hf5, hf4, hf3]) (by simp +decide [hf8, hf7, hf6]) (hdom _ _)
  rw [show f8 NLogN.KFV.vM3 = [] by simp +decide [hf8, hf7, hf6, hf5, hf4, hf3, hf2, hf1, hT.m3]] at q3
  set f9 := Function.update f8 NLogN.KFV.vM3 [VE * VA] with hf9
  have q4 := NLogN.KFV.mulE hM NLogN.KFV.vM4 NLogN.KFV.vPB NLogN.KFV.vPC (by decide) (by decide) (by decide) s f9 VB VC [] []
    (by simp +decide [hf9, hf8, hf7, hf6, hf5, hf4]) (by simp +decide [hf9, hf8, hf7, hf6, hf5]) (hdom _ _)
  rw [show f9 NLogN.KFV.vM4 = [] by simp +decide [hf9, hf8, hf7, hf6, hf5, hf4, hf3, hf2, hf1, hT.m4]] at q4
  set f10 := Function.update f9 NLogN.KFV.vM4 [VC * VB] with hf10
  -- the numerators
  have hB2r : ∀ x : ℤ, |x| < 2 * (2 ^ b) ^ (2 * r) → NLogN.zsz x ≤ b * (2 * r) + 2 := fun x hx =>
    NLogN.zsz_le_of_abs (by
      have : (2 : ℤ) * (2 ^ b) ^ (2 * r) < 2 ^ (b * (2 * r) + 2) := by
        rw [← pow_mul, pow_add]; nlinarith [pow_pos (two_pos : (0 : ℤ) < 2) (b * (2 * r))]
      linarith)
  have hsq : (2 ^ b : ℤ) ^ (2 * r) = (2 ^ b) ^ r * (2 ^ b) ^ r := by rw [two_mul, pow_add]
  have bprod : ∀ x y : ℤ, |x| < (2 ^ b) ^ r → |y| < (2 ^ b) ^ r → |x * y| < (2 ^ b) ^ (2 * r) := by
    intro x y hx hy
