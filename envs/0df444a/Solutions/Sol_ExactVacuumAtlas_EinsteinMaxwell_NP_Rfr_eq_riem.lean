  exact cpdC_congr_of_eqOn hU hy (fun z hz => by rw [h hz]) i

/-- **Derivative of an inverse.** If `K·J = 1` on `U` and `J y · K y = 1`, then `∂ᵢK = −K·(∂ᵢJ)·K` at `y`. -/
theorem pdMC_inv {J K : Pt n → Matrix (Fin n) (Fin n) ℂ} (hJ : SmoothOnC J U) (hK : SmoothOnC K U)
    (hKJ : ∀ z ∈ U, K z * J z = 1) (hJK : J y * K y = 1) :
    pdMC i K y = -(K y * pdMC i J y * K y) := by
  have h0 : pdMC i (fun z => K z * J z) y = 0 := by
    rw [pdMC_congr_of_eqOn hU hy i (B := fun _ => (1 : Matrix (Fin n) (Fin n) ℂ)) fun z hz => hKJ z hz]
    ext a b
    simp only [pdMC_apply, Matrix.zero_apply]
    exact cpdC_const _ i y
  rw [pdMC_mul hU hy i hK hJ] at h0
  calc pdMC i K y = pdMC i K y * (J y * K y) := by rw [hJK, mul_one]
    _ = (pdMC i K y * J y) * K y := by rw [mul_assoc]
    _ = (-(K y * pdMC i J y)) * K y := by rw [eq_neg_of_add_eq_zero_left h0]
    _ = -(K y * pdMC i J y * K y) := by rw [neg_mul]

/-- **Symmetry of mixed matrix partials.** -/
theorem pdMC_pdMC_symm (hA : SmoothOnC A U) (c d : Fin n) :
    pdMC c (fun z => pdMC d A z) y = pdMC d (fun z => pdMC c A z) y := by
  ext a b
  simp only [pdMC_apply]
  exact cpdC_cpdC_symm hU (hA a b) hy c d

end mrules

end ExactVacuumAtlas.EinsteinMaxwell.NP
end R05Seg4

