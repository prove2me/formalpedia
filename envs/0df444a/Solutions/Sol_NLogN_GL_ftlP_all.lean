theorem cnt2_facts' (r : Fin HS) (hr : r.val < 56) (t : IState HS) (N : ℕ) (L : List Item)
    (Q : ℕ) (h : t.G r = .int N :: L) (hQ : zsz ((2 * N : ℕ) : ℤ) ≤ Q) :
    (cnt2 r).eval t = ((2 * N : ℕ) : ℤ) ∧ (cnt2 r).Clean ∧ (cnt2 r).ok t ∧
      (cnt2 r).Bnd t Q ∧ (Ex.reg r).eval t = N ∧ (Ex.reg r).Clean ∧ (Ex.reg r).ok t ∧
      (Ex.reg r).Bnd t Q := by
  have hN : zsz (N : ℤ) ≤ Q := le_trans (zsz_mono (by simp; omega)) hQ
  have cl := RS.clean_of_lt hr
  refine ⟨?_, ?_, ?_, ?_, ?_, cl, ?_, ?_⟩
  · simp [cnt2, Ex.eval, IState.top, h]; ring
  · intro x hx; simp only [cnt2, Ex.regs, List.mem_append] at hx
    rcases hx with hx | hx <;> exact cl x hx
  · exact ⟨IState.isInt_of h, IState.isInt_of h⟩
  · refine ⟨show zsz (t.top r) ≤ Q by simpa [IState.top, h] using hN,
      show zsz (t.top r) ≤ Q by simpa [IState.top, h] using hN, ?_⟩
    simp only [Ex.eval, IState.top, h]
    have : (N : ℤ) + N = ((2 * N : ℕ) : ℤ) := by push_cast; ring
    rw [this]; exact hQ
  · simp [Ex.eval, IState.top, h]
  · exact IState.isInt_of h
  · show zsz (t.top r) ≤ Q; simpa [IState.top, h] using hN

end NLogN.GL

