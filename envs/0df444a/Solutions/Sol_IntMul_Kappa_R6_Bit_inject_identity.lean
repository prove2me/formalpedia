theorem h50i_coeff {h : ℕ} {S T : Finset (Fin h)} (hS : S.card = 3) (hT : T.card = 3) :
    ((S ∩ T).card + if (S ∩ T).card = 1 then 1 else 0) % 2 = if S = T then 1 else 0 := by
  have hle : (S ∩ T).card ≤ 3 := hS ▸ Finset.card_le_card Finset.inter_subset_left
  by_cases hST : S = T
  · subst hST; simp [hS]
  · have h3 : (S ∩ T).card ≠ 3 := by
      intro h
      apply hST
      have e1 : S ∩ T = S := Finset.eq_of_subset_of_card_le Finset.inter_subset_left (by omega)
      have e2 : S ∩ T = T := Finset.eq_of_subset_of_card_le Finset.inter_subset_right (by omega)
      rw [← e1, e2]
    rw [if_neg hST]
    interval_cases h : (S ∩ T).card <;> simp_all

theorem h50i_nsmul_mod {M : Type*} [AddCommGroup M] (h2 : ∀ z : M, z + z = 0) (n : ℕ) (z : M) :
    n • z = (n % 2) • z := by
  conv_lhs => rw [← Nat.mod_add_div n 2]
  rw [add_smul, mul_comm, mul_smul, two_smul, h2, smul_zero, add_zero]

theorem h50i_swap {h : ℕ} {M : Type*} [AddCommGroup M] (trips : Finset (Finset (Fin h)))
    (T : Finset (Fin h)) (P : Fin h → Finset (Fin h) → Prop) [∀ c S, Decidable (P c S)]
    (x : Finset (Fin h) → M) :
    (∑ c ∈ T, ∑ S ∈ trips.filter (fun S => P c S), x S) =
      ∑ S ∈ trips, (T.filter (fun c => P c S)).card • x S := by
  simp_rw [Finset.sum_filter]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun S _ => ?_
  rw [Finset.card_eq_sum_ones, Finset.sum_smul, Finset.sum_filter]
  refine Finset.sum_congr rfl fun c _ => ?_
  split_ifs <;> simp

theorem solution (h2 : ∀ z : M, z + z = 0) (trips : Finset (Finset (Fin h)))
    (htr : ∀ S ∈ trips, S.card = 3) {T : Finset (Fin h)} (hT : T ∈ trips) (x : Finset (Fin h) → M) :
    (∑ c ∈ T, ∑ S ∈ trips.filter (fun S => c ∈ S), x S) +
      (∑ c ∈ T, ∑ S ∈ trips.filter (fun S => c ∈ S ∧ ∀ t ∈ T, t ≠ c → t ∉ S), x S) = x T := by
  rw [h50i_swap trips T (fun c S => c ∈ S), h50i_swap trips T (fun c S => c ∈ S ∧ ∀ t ∈ T, t ≠ c → t ∉ S),
    ← Finset.sum_add_distrib]
  have key : ∀ S ∈ trips, (T.filter (fun c => c ∈ S)).card • x S +
      (T.filter (fun c => c ∈ S ∧ ∀ t ∈ T, t ≠ c → t ∉ S)).card • x S =
      (if S = T then x S else 0) := by
    intro S hS
    have e1 : T.filter (fun c => c ∈ S) = S ∩ T := by
      ext a; simp [and_comm]
    have e2 : (T.filter (fun c => c ∈ S ∧ ∀ t ∈ T, t ≠ c → t ∉ S)).card =
        if (S ∩ T).card = 1 then 1 else 0 := by
      split_ifs with h1
      · obtain ⟨a, ha⟩ := Finset.card_eq_one.mp h1
        rw [Finset.card_eq_one]
        refine ⟨a, ?_⟩
        ext b
        have hb : ∀ y, y ∈ S ∧ y ∈ T ↔ y = a := by
          intro y; rw [← Finset.mem_inter, ha, Finset.mem_singleton]
        simp only [Finset.mem_filter, Finset.mem_singleton]
        constructor
        · rintro ⟨hbT, hbS, _⟩; exact (hb b).mp ⟨hbS, hbT⟩
        · rintro rfl
          refine ⟨((hb b).mpr rfl).2, ((hb b).mpr rfl).1, ?_⟩
          intro t ht htb htS
          exact htb ((hb t).mp ⟨htS, ht⟩)
      · rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
        rintro c hcT ⟨hcS, hall⟩
        apply h1
        rw [Finset.card_eq_one]
        refine ⟨c, ?_⟩
        ext t
        simp only [Finset.mem_inter, Finset.mem_singleton]
        constructor
        · rintro ⟨htS, htT⟩
          by_contra hne
          exact hall t htT hne htS
        · rintro rfl; exact ⟨hcS, hcT⟩
    rw [← add_smul, e1, e2, h50i_nsmul_mod h2, h50i_coeff (htr S hS) (htr T hT)]
    split_ifs <;> simp
  rw [Finset.sum_congr rfl key, Finset.sum_ite_eq' trips T x, if_pos hT]

