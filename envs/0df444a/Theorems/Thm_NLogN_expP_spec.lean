theorem NLogN.expP_spec (n : ℕ) (x y : ℤ) (s : IState HS) (L5 L6 L7 : List Item)
    (h5 : s.G 5 = .int n :: L5) (h6 : s.G 6 = .int x :: L6) (h7 : s.G 7 = .int y :: L7) :
    expP.ok s ∧ expP.run s = (s.upd 8 (.int (expBits n x y).1 :: s.G 8)).upd 9
      (.int (expBits n x y).2 :: s.G 9) := by sorry
