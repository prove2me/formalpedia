    Nonempty ((Scheme.Modules.pullback (pullbackSymmetry f f).hom).obj 𝓟 ≅ 𝓟) := by
  classical
  let s0 := sliceAt f (RelativeGroupLaw.AlgPoints.toPoint (0 : L.AlgPoints hc k))
  let S := Scheme.Modules.pullback s0
  let σ := (pullbackSymmetry f f).hom
  let Sσ := Scheme.Modules.pullback σ
  let nℓ := pullback.lift (pullback.fst f f) (pullback.snd f f ≫ L.schemeNsmul ℓ)
    (by rw [Category.assoc, RelativeGroupLaw.schemeNsmul_over]; exact pullback.condition)
  have hσσ : σ ≫ σ = 𝟙 _ := by
    apply pullback.hom_ext
    · rw [Category.assoc, pullbackSymmetry_hom_comp_fst, pullbackSymmetry_hom_comp_snd, Category.id_comp]
    · rw [Category.assoc, pullbackSymmetry_hom_comp_snd, pullbackSymmetry_hom_comp_fst, Category.id_comp]
