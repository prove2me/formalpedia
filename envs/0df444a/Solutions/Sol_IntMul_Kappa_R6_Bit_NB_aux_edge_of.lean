-- Source module: Solutions.R6BitNBPiv
/-!
# Round six, bit network: pivots from ranks, and edges from pivots

* `rk q X Y`: rank of the rows `< X`, columns `≥ Y` of `q`; `IsPiv q i j`: the
  inclusion–exclusion of `rk` at `(i, j)` is one.
* `isPiv_iff`: for a Bruhat factorization `E₁ P E₂`, `IsPiv` is exactly `P i j = 1`.
* `edge_of_pivs`: for an idempotent `q` over `ℚ` and runs whose positions are pivots of `q`, there
  is an edge (lower triangular `E₁, E₂`, nonzero diagonals) with runs `rs ++ rs'`, `rs'` singletons,
  `|rs| + |rs'| = rank q`, and frame `E₁ σ E₂ = pswQ q` (the partial swap of `q`).
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset

section Piv

variable {K : Type*} [Field K] {n a b : ℕ}

lemma rk_congr (q : Matrix (Fin a) (Fin b) K) {X X' Y Y' : ℕ}
    (hX : ∀ r : Fin a, r.val < X ↔ r.val < X') (hY : ∀ c : Fin b, Y ≤ c.val ↔ Y' ≤ c.val) :
    rk q X Y = rk q X' Y' := by
  unfold rk
  apply RunsLib.RunsAux.rank_submatrix_range
  · ext r; simp [hX]
  · ext c; simp [hY]

lemma not_isPiv_of_le_row (q : Matrix (Fin a) (Fin b) K) {i : ℕ} (hi : a ≤ i) (j : ℕ) :
    ¬ IsPiv q i j := by
  unfold IsPiv
  have h1 : ∀ Y, rk q (i + 1) Y = rk q i Y := fun Y =>
    rk_congr q (fun r => by have := r.isLt; omega) (fun _ => Iff.rfl)
  rw [h1, h1]; omega

lemma rk_zero_of_le_col (q : Matrix (Fin a) (Fin b) K) (X : ℕ) {Y : ℕ} (hY : b ≤ Y) :
    rk q X Y = 0 := by
  unfold rk
  apply Nat.eq_zero_of_le_zero
  refine (Matrix.rank_le_card_width _).trans ?_
  rw [Nat.le_zero, Fintype.card_eq_zero_iff]
  exact ⟨fun c => by have := c.1.isLt; have := c.2; omega⟩

lemma not_isPiv_of_le_col (q : Matrix (Fin a) (Fin b) K) (i : ℕ) {j : ℕ} (hj : b ≤ j) :
    ¬ IsPiv q i j := by
  unfold IsPiv
  rw [rk_zero_of_le_col q _ hj, rk_zero_of_le_col q _ hj, rk_zero_of_le_col q _ (by omega),
    rk_zero_of_le_col q _ (by omega)]
  omega

lemma isPiv_lt {q : Matrix (Fin a) (Fin b) K} {i j : ℕ} (h : IsPiv q i j) : i < a ∧ j < b := by
  by_contra hc
  rcases not_and_or.1 hc with h' | h'
  · exact not_isPiv_of_le_row q (by omega) j h
  · exact not_isPiv_of_le_col q i (by omega) h

open RunsLib.PPUniqAux in
/-- For a Bruhat factorization, the pivots are the ones of `P`. -/
lemma isPiv_iff [DecidableEq K] (E₁ P E₂ : Matrix (Fin n) (Fin n) K)
    (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hd₁ : ∀ i, E₁ i i ≠ 0)
    (hE₂ : ∀ i j, i < j → E₂ i j = 0) (hd₂ : ∀ i, E₂ i i ≠ 0)
    (h01 : ∀ i j, P i j = 0 ∨ P i j = 1)
    (hrow : ∀ i j j', P i j = 1 → P i j' = 1 → j = j')
    (hcol : ∀ i i' j, P i j = 1 → P i' j = 1 → i = i') (i j : Fin n) :
    IsPiv (E₁ * P * E₂) i.val j.val ↔ P i j = 1 := by
  have h := fun X Y => RunsLib.RunsAux.bruhat_rank_nat E₁ P E₂ hE₁ hd₁ hE₂ hd₂ h01 hrow hcol X Y
  unfold IsPiv rk
  rw [h, h, h, h]
  have e1 := cnt_succ_row P i.val j.val
  have e3 := row_succ_col P i.val j.val
  have e5 := cnt_succ_row P i.val (j.val + 1)
  have hs := single_cnt P i j
  unfold cnt at e1 e5
  split_ifs at hs with hP
  · simp only [hP, iff_true]; omega
  · simp only [hP, iff_false]; omega

end Piv

