-- title:
--   High-body phase vanishing with a finite correction
-- statement:
--   Let 2≤k≤n and let V be a U(1)-invariant n-qubit unitary. Put D_l=C_l/[2^n binom(n,l)] and let G_0 be the fixed group generated by exp(2πiD_l), 0≤l≤n. If Φ_l(V)=0 for every k<l≤n, then
--
--   $$V=V_0W,\qquad V_0\in G_0,\quad W\in V_k.$$
--
--   The finite correction is part of this sufficiency statement.
-- source:
--   Restrictions on realizable unitary operations imposed by symmetry and locality, arXiv:2003.05524v3, PDF p. 33, D.2: vanishing high-body phases suffice up to a fixed finite group

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P14

noncomputable section

namespace QAlgorithms.Papers.Independent.Extend50.P14

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius

open MeasureTheory

-- Exact accepted aliases and physical operators, without local redeclarations.

open QAlgorithms.Papers.Independent.Information100.P60 (Mat)

open QAlgorithms.Papers.Independent.Advance50.P49 (onWire multiSwap)

attribute [local instance 100] LieRing.ofAssociativeRing

/-- PDF p.33: the finite correction cannot be omitted from the converse. -/
theorem phase_locality_converse (n k : ℕ) (hk : 2 ≤ k) (hkn : k ≤ n)
    (V : QMat n) (hV : U1Unitary V)
    (hPhase : ∀ l : ℕ, k < l → l ≤ n → u1BodyPhase V l = 0) :
    ∃ V0 W : QMat n, V0 ∈ u1FinitePhaseGroup n ∧ W ∈ u1Group n k ∧ V = V0 * W := by sorry

end QAlgorithms.Papers.Independent.Extend50.P14

end
