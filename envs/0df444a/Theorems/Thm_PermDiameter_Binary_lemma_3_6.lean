-- title:
--   Lemma 3.6 — fillers and bridges generate $G_2=G_1\wr C_r$
-- statement:
--   Work in Step 2 of the reduction (any admissible data). The set of fillers and bridges generates the wreath product:
--   $$\langle\Sigma_2\rangle=\langle\Gamma\cup\Gamma_\diamond\rangle=G_2=G_1\wr C_r .$$
--   So the output of Step 2 is a generating set of the whole wreath product, which Lemma 3.10 lifts to $G_3$.
--
--   **Formalization Note.** $G_2$ is the set of $(f,t)$ in `Wreath (Perm Ω₁) (C_r)` with all values in $G_1$; the statement equates it with the subgroup generated by $\Sigma_2$.
--
--   Differences from the source:
--   - generalization: the data fixed in §3 → every admissible choice of these data (LengthGapData, WreathData); reason: the paper's choices are admissible, so the statement specializes to the paper's
--   - encoding: stabilizer positions s_k of an enumeration of Ω₁ → positions s(ω) indexed by the points; reason: the same set S
--   - encoding: permutations compose left to right → Mathlib's Equiv.Perm, formulas kept as printed; reason: only the group operations are used
-- source:
--   Lohrey, Thumm, Word Length and Diameter in Permutation Groups, arXiv:2609.26307 (PDF sha256 cd20cd77…28d9), p. 17, Lemma 3.6

import Mathlib
import Definitions.Def_PermDiameter_Binary_WordLength
import Definitions.Def_PermDiameter_Binary_Wreath
import Definitions.Def_PermDiameter_Binary_Parameters
import Definitions.Def_PermDiameter_Binary_LengthGap
import Definitions.Def_PermDiameter_Binary_WreathConstruction

open Equiv

namespace PermDiameter.Binary

/-- **Lemma 3.6.** The set `Σ₂ = Γ ∪ Γ⋄` generates the group `G₂ = G₁ ≀ C_r`. -/
theorem lemma_3_6 {d0 : ℕ} {Sig0 : Finset (Perm (Fin d0))} {g0 : Perm (Fin d0)} {k0 : ℕ}
    (D : LengthGapData Sig0 g0 k0) (W : WreathData D) :
    (Subgroup.closure W.Sig2 : Set (Wreath (Perm (Omega1 d0 D.dc)) (Pos W.r))) = W.G2 := by sorry

end PermDiameter.Binary
