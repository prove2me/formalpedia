-- title:
--   Six properties of the constructed extension space
-- statement:
--   Let $G$ be a Hausdorff locally compact second-countable topological group and let $A$ be a Hausdorff locally compact second-countable abelian topological group with a continuous action of $G$ by automorphisms, written $g\cdot a$. Let $F:G\times G\to A$ be a Borel measurable two-cocycle, with pointwise identity
--   $$
--   F(g,h)+F(gh,k)=g\cdot F(h,k)+F(g,hk),\qquad F(1,g)=F(g,1)=0.
--   $$
--   Assume that $F$ is continuous on $U_F\times U_F$, where $U_F$ is an open identity neighborhood. Let $E=A\times_F G$, with multiplication $(a,g)(b,h)=(a+g\cdot b+F(g,h),gh)$ and inverse $(a,g)^{-1}=(-g^{-1}\cdot(a+F(g,g^{-1})),g^{-1})$. Equip $E$ with the topology generated by left translates of the rectangles $U_A\times U_G$, where $U_A,U_G$ are open identity neighborhoods and $F$ is continuous on $U_G\times U_G$. Write $e=(0,1)$ and $\pi(a,g)=g$.
--
--   Let $\iota(a)=(a,1)$. The following all hold.
--
--   1. The maps $\iota$ and $\pi$ are continuous, and $\pi$ is open.
--   2. On an open identity neighborhood $U\subseteq G$, $\pi$ admits a continuous section.
--   3. The map $\iota$ is a homeomorphism onto its image, and its image is closed.
--   4. The space $E$ is locally compact, second-countable and Hausdorff.
--   5. The Borel sigma algebra is generated by the translated rectangles and, under the coordinate bijection $E\to A\times G$, equals the product Borel sigma algebra.
--   6. Multiplication, inversion and every inner conjugation are Borel measurable.
--
--   In particular, writing $\mathcal B$ for the rectangular identity neighborhood base,
--   $$
--   \operatorname{Borel}(E)=\sigma\{xB:x\in E,\ B\in\mathcal B\}=\operatorname{Borel}(A)\otimes\operatorname{Borel}(G).
--   $$
--   These properties supply the topological and measurable substrate before Theorem 6 is established.
-- source:
--   On Cohomology theory for topological groups, arXiv:1009.4519v1, PDF p. 13, Proposition 4: six properties of the constructed extension space

import Definitions.Def_QAlgorithms_Papers_Independent_Intakethird100_P08

namespace QAlgorithms.Papers.Independent.Intakethird100.P08

open Set MeasureTheory

open scoped BigOperators Topology CompactlySupported

section ConstructedExtension

variable {G A : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [T2Space G] [LocallyCompactSpace G] [SecondCountableTopology G]
  [MeasurableSpace G] [BorelSpace G]
  [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
  [T2Space A] [LocallyCompactSpace A] [SecondCountableTopology A]
  [MeasurableSpace A] [BorelSpace A]

/-- Proposition 4(i)--(vi), PDF pp. 13--14, retaining all six clauses.
The inverse used here corrects the printed p. 14 error documented at twistedInv.
Product measure structure means equality of sigma algebras, not Haar measures. -/
theorem proposition4 (D : LocalCocycle G A) :
    Continuous (kernelInclusion D) ∧ Continuous (quotientProjection D) ∧
    IsOpenMap (quotientProjection D) ∧
    (∃ U : Set G, IsOpen U ∧ 1 ∈ U ∧
      ∃ sigma : U → ExtensionPoint D,
        Continuous sigma ∧ ∀ u, quotientProjection D (sigma u) = u.val) ∧
    Topology.IsClosedEmbedding (kernelInclusion D) ∧
    LocallyCompactSpace (ExtensionPoint D) ∧
    SecondCountableTopology (ExtensionPoint D) ∧ T2Space (ExtensionPoint D) ∧
    (borel (ExtensionPoint D) = MeasurableSpace.generateFrom (translatedRectangles D)) ∧
    (MeasurableSpace.comap (extensionCoordinates D)
      (inferInstance : MeasurableSpace (A × G)) = borel (ExtensionPoint D)) ∧
    Measurable (fun p : ExtensionPoint D × ExtensionPoint D => actionTwistedMul D p.1 p.2) ∧
    Measurable (twistedInv D) ∧
    (∀ x : ExtensionPoint D, Measurable (innerConjugation D x)) := by sorry

end ConstructedExtension

end QAlgorithms.Papers.Independent.Intakethird100.P08
