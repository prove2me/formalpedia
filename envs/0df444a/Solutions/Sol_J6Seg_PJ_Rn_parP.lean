  refine Rn.seq (Rn.rdK' hZ hZ5 hZT hZC (by decide) (by decide) hcZ (j := 4) (by simp [dsc]) b1 hL
    (by omega) (by simp [update_apply, rIx, hz])) (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
  refine Rn.seq (Rn.rdK' hZ hZ5 hZT hZC (by decide) (by decide) hcZ (j := 6) (by simp [dsc]) b1 hL
    (by omega) (by simp [update_apply, rIx, hz])) (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
  refine Rn.seq (Rn.rdK' hZ hZ5 hZT hZC (by decide) (by decide) hcZ (j := 5) (by simp [dsc]) b1 hL
    (by omega) (by simp [update_apply, rIx, hz])) (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
