  simp only [one_mul]

theorem pow8192 (e : ℕ) : 8192 ^ e = 2 ^ (13 * e) := by
  rw [pow_mul]; norm_num

theorem and_digit (a b e : ℕ) :
    (a &&& b) / 8192 ^ e % 8192 = (a / 8192 ^ e % 8192) &&& (b / 8192 ^ e % 8192) := by
  rw [pow8192, show (8192 : ℕ) = 2 ^ 13 by norm_num]
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_and, Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow]
  cases decide (i < 13) <;> simp

theorem digit_of_clean (M e : ℕ) (hM : M &&& COMB = M) (he : e < 6806) :
    M / 8192 ^ e % 8192 = if M.testBit (13 * e) = true then 1 else 0 := by
