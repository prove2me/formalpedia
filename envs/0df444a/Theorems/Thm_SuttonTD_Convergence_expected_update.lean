-- title:
--   (6) and the mean recursion $\bar w_{n+1}=\bar w_n+\alpha XD(h+QX^\top\bar w_n-X^\top\bar w_n)$
-- statement:
--   Let $C$ be an absorbing Markov chain, $\mu$ a start distribution, $\nu_j$ ($j\in T$) outcome laws with finite means $\bar z_j=\int z\,d\nu_j(z)$, and let $e_0,e_1,\dots$ be an i.i.d. stream of sequences generated by them. Let $w_n$ be the weight vector of linear TD(0) with step size $\alpha$ after $n$ sequences, starting from $w_0$, and $\bar w_n=E\{w_n\}$. Let $X$ be the matrix with columns $x_i$ ($i\in N$), $D=\operatorname{diag}(d)$ with $d_i$ the expected number of visits to $i$ in one sequence, and $[h]_i=\sum_{j\in T}p_{ij}\bar z_j$. Then every $w_n$ is integrable and
--
--   $$\bar w_{n+1}=\bar w_n+\alpha\,X D\bigl(h+QX^\top\bar w_n-X^\top\bar w_n\bigr).$$
--
--   This is the expected form of the update (6), and reduces the convergence question to a linear iteration.
--
--   **Formalization Note** Expectations are componentwise Bochner integrals and integrability is part of the conclusion. $X^\top w$ is the vector $(x_i^\top w)_{i\in N}$.
-- source:
--   Sutton (1988), Machine Learning 3:9–44, §4.1, (6) and the following displays, pp. 25–26 (PDF pp. 17–18)

import Definitions.Def_SuttonTD_Convergence_ExpectedVisits
import Definitions.Def_SuttonTD_Convergence_EpisodeStream
import Definitions.Def_SuttonTD_Convergence_LinearTD0
open MeasureTheory Matrix

namespace SuttonTD.Convergence

/-- **The mean recursion of linear TD(0)** ((6) and the display that follows it; Sutton 1988,
§4.1, pp. 25–26, PDF pp. 17–18). Let the sequences be experienced i.i.d. as in
`IsEpisodeStream`, let `w_n` be the TD(0) weight vector after `n` sequences, and let
`w̄_n = E{w_n}` (componentwise). Then every component of every `w_n` is integrable and
`w̄_{n+1} = w̄_n + α X D (h + Q Xᵀ w̄_n − Xᵀ w̄_n)`,
where `X` is the matrix with columns `x_i` (`i ∈ N`), `D = diag(d)` with `d_i` the expected number
of visits to `i` in one sequence, `[h]_i = ∑_{j∈T} p_ij z̄_j` and `z̄_j = ∫ z dν_j(z)`.

Formalization Note: `X : Matrix (Fin K) N ℝ` has entries `X k i = x_i(k)`, so `Xᵀ w` is the vector
`(x_iᵀ w)_{i ∈ N}`. No restriction on `α` is needed for this identity. Expectations are Bochner
integrals; integrability is part of the conclusion. -/
theorem expected_update {N T : Type*} [Fintype N] [DecidableEq N] [Fintype T]
    (C : AbsorbingChain N T) (μ : N → ℝ) (hμ0 : ∀ i, 0 ≤ μ i) (hμ1 : ∑ i, μ i = 1)
    (ν : T → Measure ℝ) [∀ j, IsProbabilityMeasure (ν j)] (hν : ∀ j, Integrable id (ν j))
    {K : ℕ} (x : N → Fin K → ℝ) (α : ℝ) (w₀ : Fin K → ℝ)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (e : ℕ → Ω → Episode N T) (he : IsEpisodeStream C μ ν P e) (n : ℕ) :
    let X : Matrix (Fin K) N ℝ := Matrix.of fun k i => x i k
    let d : N → ℝ := C.expectedVisits μ
    let wbar : ℕ → Fin K → ℝ := fun m k => ∫ ω, tdWeights x α w₀ e m ω k ∂P
    (∀ k, Integrable (fun ω => tdWeights x α w₀ e n ω k) P) ∧
      wbar (n + 1) = wbar n + α • ((X * diagonal d) *ᵥ
        (C.h (fun j => ∫ z, z ∂ν j) + C.Q *ᵥ (Xᵀ *ᵥ wbar n) - Xᵀ *ᵥ wbar n)) := by sorry

end SuttonTD.Convergence
