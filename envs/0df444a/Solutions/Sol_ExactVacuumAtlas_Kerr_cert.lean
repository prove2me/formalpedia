/-!
# Kerr, Boyer–Lindquist coordinates: domain facts

Coordinates `(t, r, θ, φ) = (x 0, x 1, x 2, x 3)`; `Σ = r² + a² cos²θ`, `Δ = r² − 2Mr + a²`
(`KerrBL.Sig`, `KerrBL.Del`). The regular domain is `Σ ≠ 0`, `Δ ≠ 0`, `sin θ ≠ 0`, for every real
`M` and `a`. It contains both signs of `Δ`, negative `r` and the set `g_tt ≥ 0`; the only exclusions
are `Δ = 0` and `sin θ = 0` (where the chart matrix is singular) and `Σ = 0` (for `M ≠ 0` the ring
singularity, a genuine curvature singularity; here only a point set where the data are undefined).
No causal or global statement is made about any of these loci.
-/

open Real

namespace ExactVacuumAtlas.Kerr

theorem reg_of_mem {M a : ℝ} {x : Pt 4} (hx : x ∈ domBL M a) : KerrBL.RegKerr M a x := hx

theorem domBL_Sig {M a : ℝ} {x : Pt 4} (hx : x ∈ domBL M a) :
    KerrBL.Sig a (x 1) (cos (x 2)) ≠ 0 := hx.1

theorem domBL_Del {M a : ℝ} {x : Pt 4} (hx : x ∈ domBL M a) : KerrBL.Del M a (x 1) ≠ 0 := hx.2.1

theorem domBL_sin {M a : ℝ} {x : Pt 4} (hx : x ∈ domBL M a) : sin (x 2) ≠ 0 := hx.2.2

theorem continuous_Sig (a : ℝ) : Continuous fun x : Pt 4 => KerrBL.Sig a (x 1) (cos (x 2)) := by
  unfold KerrBL.Sig; fun_prop

theorem continuous_Del (M a : ℝ) : Continuous fun x : Pt 4 => KerrBL.Del M a (x 1) := by
  unfold KerrBL.Del; fun_prop

theorem isOpen_domBL (M a : ℝ) : IsOpen (domBL M a) := by
  have h1 : IsOpen {x : Pt 4 | KerrBL.Sig a (x 1) (cos (x 2)) ≠ 0} :=
    isOpen_ne_fun (continuous_Sig a) continuous_const
  have h2 : IsOpen {x : Pt 4 | KerrBL.Del M a (x 1) ≠ 0} :=
    isOpen_ne_fun (continuous_Del M a) continuous_const
  have h3 : IsOpen {x : Pt 4 | sin (x 2) ≠ 0} :=
    isOpen_ne_fun (Real.continuous_sin.comp (continuous_apply 2)) continuous_const
  exact h1.inter (h2.inter h3)

/-- On the equator `Σ = ρ²` and `sin θ = 1`, so `eqPt ρ ∈ domBL` iff `ρ ≠ 0` and `Δ(ρ) ≠ 0`. -/
theorem eqPt_mem_domBL {M a ρ : ℝ} (hρ : ρ ≠ 0) (hD : KerrBL.Del M a ρ ≠ 0) :
    eqPt ρ ∈ domBL M a := by
  refine ⟨?_, ?_, ?_⟩
  · show KerrBL.Sig a ρ (cos (π / 2)) ≠ 0
    simp [KerrBL.Sig, hρ]
  · exact hD
  · show sin (π / 2) ≠ 0
    simp

/-- Far-field point: `r = |2M| + 1` has `Δ > 0` for every `M`, `a`. -/
theorem far_mem_domBL (M a : ℝ) : eqPt (|2 * M| + 1) ∈ domBL M a ∧
    0 < KerrBL.Del M a (|2 * M| + 1) := by
  have hD : 0 < KerrBL.Del M a (|2 * M| + 1) := by
    unfold KerrBL.Del
    have h2 : 2 * M ≤ |2 * M| := le_abs_self _
    have h3 : 0 ≤ |2 * M| := abs_nonneg _
    nlinarith [sq_nonneg a]
  exact ⟨eqPt_mem_domBL (by positivity) hD.ne', hD⟩

theorem domBL_nonempty (M a : ℝ) : (domBL M a).Nonempty := ⟨_, (far_mem_domBL M a).1⟩

end ExactVacuumAtlas.Kerr

