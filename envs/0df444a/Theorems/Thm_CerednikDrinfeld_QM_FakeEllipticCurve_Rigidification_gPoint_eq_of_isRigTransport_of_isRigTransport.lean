        ModuliPackage.GPoint 𝒪 M B) =
      ⟨frobTwist Onr Fr (-(j' : ℤ)) ψ, hBr, η B ((frobTwist Onr Fr (-(j' : ℤ)) ψ : Onr →ₐ[𝒪] B) : Onr →+* B) hBr t'⟩ := by sorry
