-- title:
--   Proposition 3.3
-- statement:
--   The dimension-free PSD cone in degree one has only the ray generated by $[1]$. In degree two,
--   $$I_2^{\rm psd}=\operatorname{cone}\{[2],[1^2]-[2]\},$$
--   and these are exactly its two extremal rays. The characterization includes exhaustiveness.
--
--   For a partition $\lambda$, the symbol $[\lambda]$ denotes a formal basis element evaluated as $\prod_j\operatorname{Tr}(X^{\lambda_j})$. Distinct formal coefficients are not identified by any fixed-dimensional trace identity.
-- source:
--   Optimal entanglement criteria from trace invariants, arXiv:2609.29471v1, PDF p. 13, Proposition 3.3

import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P19

noncomputable section

open scoped BigOperators ENNReal Matrix ComplexConjugate ComplexOrder

open Filter MeasureTheory

namespace QAlgorithms.Papers.Independent.Information100.P19

/-- Proposition 3.3; arXiv:2609.29471v1, PDF pp.13. -/
theorem psd_small_degrees  :
    psdCone 1 = ray b1 ∧ extremeRays (psdCone 1) = {ray b1} ∧
    psdCone 2 = finiteCone ({b2,b11-b2} : Set (Coeff 2)) ∧
    extremeRays (psdCone 2) = {ray b2, ray (b11-b2)} := by sorry

end QAlgorithms.Papers.Independent.Information100.P19

end
