variable (p : ℕ) [Fact p.Prime] {N r : ℕ} [NeZero r] (LL : Letters N) (j : ℕ)

theorem Formalism.InvariantFactorPaths.L4.dpow_mul_of_zero (c : Fin r) (x g : MvPolynomial (Fin N × Fin r) ℚ_[p])
    (hx : glAct p LL j 0 c x = 0) (k : ℕ) :
    dpow p LL j c k (x * g) = x * dpow p LL j c k g := by sorry
