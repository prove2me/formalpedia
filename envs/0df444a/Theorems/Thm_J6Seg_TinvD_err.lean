theorem J6Seg.TinvD_err {T : Tables} {a n : ℕ} {E : ℝ} (hα : 2 ≤ α) (hσ : 1 ≤ σ)
    (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2) (hT : BlkTab P α σ b T a n E) (hE : 0 ≤ E)
    (hP : 100 * (((n : ℝ) + 1) * E + 1) ≤ 2 ^ P) {u v : ℕ} (hu : u < n) (hv : v < n) :
