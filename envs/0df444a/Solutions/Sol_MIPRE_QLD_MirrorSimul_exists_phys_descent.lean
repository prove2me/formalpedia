theorem bornProb_kronecker_mulVec_conj_right (U : Matrix R H ℂ) {W : Matrix S K ℂ}
    (hW : Wᴴ * W = 1) (ψ : H × K → ℂ) (Y : Matrix R R ℂ) (B : Matrix K K ℂ) :
