theorem parameter_pow_bits (j : ℕ) : ratBits ((2:ℚ)^j) ≤ 3+4*j := by
  have cast : ((2 ^ j : ℕ) : ℚ) = (2 : ℚ) ^ j := Nat.cast_pow 2 j
