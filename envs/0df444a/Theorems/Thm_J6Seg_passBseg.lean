import Definitions.Def_IntMul_Kappa_R6_Defs61

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000

open J6Seg
open Complex
open IntMul IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf NLogN.KFM NLogN.KFY IntMul.OpenAI.RT
open NLogN.KFB (GI gflat)
variable {d : ℕ} (p R lam w α : ℕ) (Pf : ℕ → ℕ) (s t : Fin d → ℕ) [∀ i, NeZero (s i)]
  [∀ i, NeZero (t i)]

theorem J6Seg.passBseg (hp18 : 18 ≤ (2 : ℝ) ^ p) (hst : ∀ i, s i ≤ t i) (ys : List GI)
    (y : ((i : Fin d) → ZMod (t i)) → ℂ) (hrep : RepFull p t ys y) (hy : ‖y‖ ≤ 1)
    (Bm : (i : Fin d) → (ZMod (t i) → ℂ) →L[ℂ] (ZMod (s i) → ℂ))
    (hBn : ∀ i, ‖Bm i‖ ≤ 1 / 2)
    (hErr : ∀ i (W : ℕ → ℤ × ℤ), (∀ k, ‖IntMul.HvdH.P47.toC (W k)‖ ≤ 2 ^ p) →
      ∀ l : ZMod (s i), ‖IntMul.HvdH.P47.toC (B0seg p (Pf (s i)) R lam w (s i) (t i) α W l.val) -
        2 ^ p * Bm i (fun k => IntMul.HvdH.P47.toC (W k.val) / 2 ^ p) l‖ ≤ 9)
    (hZ : ∀ i, B0seg p (Pf (s i)) R lam w (s i) (t i) α (fun _ => (0, 0)) = fun _ => (0, 0)) :
    RepPad p s t (tensorGo (mapsBs p R lam w α Pf s t) (List.ofFn t) ys)
        (vOf p s t (tensorGo (mapsBs p R lam w α Pf s t) (List.ofFn t) ys)) ∧
      DiscL p (tensorGo (mapsBs p R lam w α Pf s t) (List.ofFn t) ys) ∧
      ‖vOf p s t (tensorGo (mapsBs p R lam w α Pf s t) (List.ofFn t) ys) - tensCLM (kerB Bm) y‖ ≤
        (9 * d) * hp p := by sorry
