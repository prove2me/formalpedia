theorem solution (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) :
    fdir E 0 (omL g gi E Θ 0 1 2) x - fdir E 1 (omL g gi E Θ 0 0 2) x
      = (npTau g gi E Θ x + npPiB g gi E Θ x) * npRho g gi E Θ x
        + (npTauB g gi E Θ x + npPi g gi E Θ x) * npSigma g gi E Θ x
        + (npEps g gi E Θ x - npEpsB g gi E Θ x) * npTau g gi E Θ x
        - (3 * npGamma g gi E Θ x + npGammaB g gi E Θ x) * npKappa g gi E Θ x
        + psi1 g gi E x + ricF g gi E 0 2 x / 2 := by
  have hw := hN.weylF_eq hx 0 2 0 1
  have h := riemFL_formula hN hx 0 2 0 1
  rw [psi1_eq, ← hN.weylF_pair hx 0 1 0 2, hw, ← ricF_symm hN hx 0 2]
  obtain ⟨e00, e01, e02, e03, e10, e11, e12, e13, e20, e21, e22, e23, e30, e31, e32, e33⟩ := eta_vals
  simp only [e00, e01, e20, e21, zero_mul, mul_zero, sub_zero, zero_sub, add_zero, zero_add, neg_mul, one_mul,
    neg_neg, zero_div]
  rw [h]
  simp only [Fin.sum_univ_four, cfr_eq_cL', hN.cL_eq_omL hx]
