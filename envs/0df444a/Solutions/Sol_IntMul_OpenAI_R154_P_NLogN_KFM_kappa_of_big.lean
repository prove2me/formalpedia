-- Source module: Solutions.KFMK1
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open _root_.IntMul

theorem IRuns.lift {P : ℕ} {I : List Sym} {F : Fin P → IStmt HS P} {km : IStmt HS (P + 1)}
    {j : Fin P} {s s' : IState HS} {c : ℕ} (h : IRuns I F (.call j) s s' c) :
    IRuns I (topTable F km) (.call j.succ) s s' c :=
  IRuns.relabel (iprog := F) (iprog' := topTable F km) (g := Fin.succ) (fun j => rfl) h

theorem readP_runs {P : ℕ} {F : Fin P → IStmt HS P} (x y : List Bool) :
    IRuns (inputCodes x y) F readP ⟨fun _ => [], 0, []⟩ (readSt x y)
      (readRCost x.length + readRCost y.length) := by
  set I := inputCodes x y with hI
  set s0 : IState HS := ⟨fun _ => [], 0, []⟩ with hs0
  have r1 := IRuns.op (I := I) (iprog := F) (IOp.Step.read (s := s0) (i := ARGM) (j := kT1)
    (stop := codeSep) x (by decide) (by decide) (by decide)
    (by intro k hk; simp [hI, inputCodes, hs0, List.getD_eq_getElem?_getD, List.getElem?_append_left,
      hk])
    (by simp [hI, inputCodes, hs0, List.getD_eq_getElem?_getD]))
  set s1 : IState HS := { (s0.upd ARGM (.int (IntMul.val x : ℤ) :: s0.G ARGM)).upd kT1
      (.int (2 ^ x.length) :: (s0.upd ARGM (.int (IntMul.val x : ℤ) :: s0.G ARGM)).G kT1) with
        ip := s0.ip + x.length + 1 } with hs1
  have hip : s1.ip = x.length + 1 := by rw [hs1]; simp [hs0]
  have r2 := IRuns.op (I := I) (iprog := F) (IOp.Step.read (s := s1) (i := ARGM) (j := kT2)
    (stop := codeEnd) y (by decide) (by decide) (by decide)
    (by
      intro k hk
      rw [hI, inputCodes, hip, List.getD_eq_getElem?_getD,
        List.getElem?_append_right (by simp; omega)]
      simp [show x.length + 1 + k - x.length = k + 1 by omega, hk])
    (by
      rw [hI, inputCodes, hip, List.getD_eq_getElem?_getD,
        List.getElem?_append_right (by simp; omega)]
      simp [show x.length + 1 + y.length - x.length = y.length + 1 by omega]))
  refine (IRuns.seq r1 r2).mono' ?_ le_rfl
  refine IState.ext' (fun j => ?_) ?_ rfl
  · simp only [readSt, hs1, hs0, IState.upd_G]
    by_cases h1 : j = ARGM
    · subst h1; simp +decide
    by_cases h2 : j = kT1
    · subst h2; simp +decide
    by_cases h3 : j = kT2
    · subst h3; simp +decide
    · simp +decide [h1, h2, h3]
  · simp [readSt, hs1, hs0]; ring

/-- The test leaves `2^n − 2^{N₁}` on `kTS`. -/
theorem testP_runs {P : ℕ} {I : List Sym} {F : Fin P → IStmt HS P} (x y : List Bool) (N₁ : ℕ) :
    IRuns I F (testP N₁) (readSt x y)
      ((readSt x y).upd kTS [.int (-(2 ^ N₁) + 2 ^ x.length)])
      (300 * (x.length + 2) + (N₁ + 3) + 400 * (x.length + N₁ + 3)) := by
  set s := readSt x y with hs
  have hT1 : s.G kT1 = .int (2 ^ x.length) :: [] := by simp +decide [hs, readSt]
  have r1 := IRuns.dup (I := I) (iprog := F) (i := kT1) (j := kTS) (by decide) hT1
  set s1 := s.upd kTS (.int (2 ^ x.length) :: s.G kTS) with hs1
  have r2 := IRuns.const (I := I) (iprog := F) (s := s1) kTT (-(2 ^ N₁))
  set s2 := s1.upd kTT (.int (-(2 ^ N₁)) :: s1.G kTT) with hs2
  have r3 := IRuns.add (I := I) (iprog := F) (s := s2) (i := kTT) (j := kTS) (k := kTS)
    (a := -(2 ^ N₁)) (b := 2 ^ x.length) (Li := s.G kTT) (Lj := s.G kTS) (by decide)
    (by simp +decide [hs2, hs1]) (by simp +decide [hs2, hs1])
  refine (IRuns.seq r1 (IRuns.seq r2 r3)).mono' ?_ ?_
  · refine IState.ext' (fun j => ?_) rfl rfl
    have e1 : s.G kTT = [] := by simp +decide [hs, readSt]
    have e2 : s.G kTS = [] := by simp +decide [hs, readSt]
    by_cases h1 : j = kTS
    · subst h1; simp +decide [hs2, hs1, e2]
    by_cases h2 : j = kTT
    · subst h2; simp +decide [hs2, hs1, e1]
    · simp +decide [hs2, hs1, h1, h2]
  · have d1 := dupCost_le (zsz ((2 : ℤ) ^ x.length))
    have z1 : zsz ((2 : ℤ) ^ x.length) = x.length + 1 := NLogN.zsz_two_pow x.length
    have z2 : zsz (-((2 : ℤ) ^ N₁)) = N₁ + 1 := by rw [zsz_neg]; exact NLogN.zsz_two_pow N₁
    have a1 := addIntCost_le (zsz (-((2 : ℤ) ^ N₁)) + zsz ((2 : ℤ) ^ x.length))
    simp only [z1, z2] at d1 a1 ⊢
    omega

theorem readSt_kTS (x y : List Bool) : (readSt x y).G kTS = [] := by simp +decide [readSt]

/-- `drop kTS` returns to the state after the reads. -/
theorem dropT_runs {P : ℕ} {I : List Sym} {F : Fin P → IStmt HS P} (x y : List Bool) (d : ℤ) :
    IRuns I F (.op (.drop kTS)) ((readSt x y).upd kTS [.int d]) (readSt x y) (2 * zsz d + 2) := by
  refine (IRuns.drop (I := I) (iprog := F) (L := []) (by simp)).mono' ?_ le_rfl
  rw [IState.upd_upd_same, ← readSt_kTS x y, IState.upd_self]

theorem zszN_le {a b : ℕ} (h : a ≤ b) : zsz (a : ℤ) ≤ zsz (b : ℤ) := zsz_mono (by simpa using h)

theorem zsz_lt_pow {a k : ℕ} (h : a < 2 ^ k) : zsz (a : ℤ) ≤ k + 1 := by
  calc zsz (a : ℤ) ≤ zsz ((2 : ℤ) ^ k) := zsz_mono (by
        rw [Int.natAbs_natCast, Int.natAbs_pow]; simp; omega)
    _ = k + 1 := NLogN.zsz_two_pow k

theorem mulB_mono {a b : ℕ} (h : a ≤ b) : mulB a ≤ mulB b := by
  unfold mulB
  have h1 : zsz ((a + 1 : ℕ) : ℤ) ≤ zsz ((b + 1 : ℕ) : ℤ) := zszN_le (by omega)
  have h2 : zsz (((zsz ((a + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) ≤
      zsz (((zsz ((b + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) :=
    zszN_le (Nat.pow_le_pow_left (by omega) 4)
  gcongr

theorem smallP_runs {P : ℕ} {I : List Sym} {F : Fin P → IStmt HS P} {pM : Fin P}
    (hM : MulOK I F pM ⟨fun a b => mulCostH (zsz a + zsz b), fun _ _ => True⟩)
    (x y : List Bool) (hxy : x.length = y.length) :
    ∃ s', IRuns I F (smallP pM) (readSt x y) s' (smallCost x.length) ∧
      s'.out = bin (2 * x.length) (IntMul.val x * IntMul.val y) := by
  set s := readSt x y with hs
  have hA : s.G ARGM = .int (IntMul.val y : ℤ) :: .int (IntMul.val x : ℤ) :: [] := by simp [hs, readSt]
  have r1 := hM s (IntMul.val y) (IntMul.val x) [] trivial hA
  set s1 := s.upd ARGM [.int ((IntMul.val y : ℤ) * (IntMul.val x : ℤ))] with hs1
  have hT1 : s1.G kT1 = .int (2 ^ x.length) :: [] := by simp +decide [hs1, hs, readSt]
  have hT2 : s1.G kT2 = .int (2 ^ x.length) :: [] := by simp +decide [hs1, hs, readSt, hxy]
  have r2 := IRuns.shl (I := I) (iprog := F) (i := kT1) (j := kT2) (m := x.length) (by decide) hT1 hT2
  set s2 := s1.upd kT1 [.int (2 ^ x.length * 2 ^ x.length)] with hs2
  have hvx := val_lt x
  have hvy := val_lt y
  rw [← hxy] at hvy
  have hab : IntMul.val x * IntMul.val y < 2 ^ (2 * x.length) := by
    rw [two_mul, pow_add]; exact Nat.mul_lt_mul'' hvx hvy
  have r3 := IRuns.op (I := I) (iprog := F) (IOp.Step.write (s := s2) (i := ARGM) (j := kT1)
    (n := IntMul.val x * IntMul.val y) (m := 2 * x.length) (Li := []) (Lj := []) (by decide) hab
    (by simp +decide [hs2, hs1]; ring)
    (by simp [hs2]; ring))
  refine ⟨_, (IRuns.seq r1 (IRuns.seq r2 r3)).mono ?_, ?_⟩
  · have hz : zsz (IntMul.val y : ℤ) + zsz (IntMul.val x : ℤ) ≤ 2 * x.length + 2 := by
      have := NLogN.KFM.zsz_lt_pow hvx; have := NLogN.KFM.zsz_lt_pow hvy; omega
    have h1 : mulCostH (zsz (IntMul.val y : ℤ) + zsz (IntMul.val x : ℤ)) ≤ mulB (2 * x.length + 2) :=
      le_trans (mulCostH_le _) (mulB_mono hz)
    have h2 : (⟨fun a b => mulCostH (zsz a + zsz b), fun _ _ => True⟩ : MulSpec).Φ (IntMul.val y : ℤ)
        (IntMul.val x : ℤ) = mulCostH (zsz (IntMul.val y : ℤ) + zsz (IntMul.val x : ℤ)) := rfl
    unfold smallCost
    omega
  · simp [hs2, hs1, hs, readSt]

/-- **The small branch from the empty state.** -/
theorem kmain_small {P : ℕ} {F : Fin P → IStmt HS P} {pM bigE : Fin P} (N₁ : ℕ)
    (x y : List Bool) (hxy : x.length = y.length) (hn : x.length < N₁)
    (hM : MulOK (inputCodes x y) F pM ⟨fun a b => mulCostH (zsz a + zsz b), fun _ _ => True⟩) :
    ∃ s' c, IRuns (inputCodes x y) (topTable F (kmain pM bigE N₁)) (kmain pM bigE N₁)
      ⟨fun _ => [], 0, []⟩ s' c ∧ s'.out = bin (2 * x.length) (IntMul.val x * IntMul.val y) ∧
        c ≤ topOvh x.length N₁ + smallCost x.length := by
  set I := inputCodes x y
  set T := topTable F (kmain pM bigE N₁)
  obtain ⟨s', hs, hout⟩ := smallP_runs (I := I) (F := F) hM x y hxy
  have hs' : IRuns I T (smallP pM.succ) (readSt x y) s' (smallCost x.length) := by
    have := IRuns.relabel (iprog := F) (iprog' := T) (g := Fin.succ) (fun j => rfl) hs
    exact this
  have r1 := readP_runs (F := T) x y
  have r2 := testP_runs (I := I) (F := T) x y N₁
  set d : ℤ := -(2 ^ N₁) + 2 ^ x.length
  have hlt : (2 : ℤ) ^ x.length < 2 ^ N₁ := pow_lt_pow_right₀ (by norm_num) hn
  have hneg : isNeg (((readSt x y).upd kTS [.int d]).cl kTS) = true := by
    have hd : d < 0 := by simp only [d]; omega
    rw [cl_int _ kTS d [] (by simp)]
    simp [isNeg, hd, show d ≠ 0 by omega]
  have r3 := IRuns.iteT (q := (.seq (.op (.drop kTS)) (.call bigE.succ))) hneg
    ((dropT_runs (I := I) (F := T) x y d).seq hs')
  refine ⟨s', _, r1.seq (r2.seq r3), hout, ?_⟩
  have hzd : zsz d ≤ N₁ + 1 := by
    calc zsz d ≤ zsz ((2 : ℤ) ^ N₁) := zsz_mono (by
          have : (0 : ℤ) ≤ 2 ^ x.length := by positivity
          simp only [d]; omega)
      _ = N₁ + 1 := NLogN.zsz_two_pow _
  unfold topOvh
  rw [show y.length = x.length from hxy.symm]
  omega

/-- **The large branch from the empty state.** -/
theorem kmain_big {P : ℕ} {F : Fin P → IStmt HS P} {pM bigE : Fin P} (N₁ : ℕ) (Tb : ℕ → ℕ)
    (hB : BigSpec F bigE N₁ Tb) (x y : List Bool) (hxy : x.length = y.length)
    (hn : N₁ ≤ x.length) :
    ∃ s' c, IRuns (inputCodes x y) (topTable F (kmain pM bigE N₁)) (kmain pM bigE N₁)
      ⟨fun _ => [], 0, []⟩ s' c ∧ s'.out = bin (2 * x.length) (IntMul.val x * IntMul.val y) ∧
        c ≤ Tb x.length + topOvh x.length N₁ := by
  set I := inputCodes x y
  set T := topTable F (kmain pM bigE N₁)
  obtain ⟨s', cb, hs, hout, hcb⟩ := hB x y hxy hn
  have hs' : IRuns I T (.call bigE.succ) (readSt x y) s' cb := IRuns.lift hs
  have r1 := readP_runs (F := T) x y
  have r2 := testP_runs (I := I) (F := T) x y N₁
  set d : ℤ := -(2 ^ N₁) + 2 ^ x.length with hd
  have hd0 : 0 ≤ d := by
    have : (2 : ℤ) ^ N₁ ≤ 2 ^ x.length := pow_le_pow_right₀ (by norm_num) hn
    omega
  have hpos : isNeg (((readSt x y).upd kTS [.int d]).cl kTS) = false := by
    rw [cl_int _ kTS d [] (by simp)]
    split_ifs <;> simp [isNeg] <;> omega
  have r3 := IRuns.iteF (p := (.seq (.op (.drop kTS)) (smallP pM.succ))) hpos
    ((dropT_runs (I := I) (F := T) x y d).seq hs')
  refine ⟨s', _, r1.seq (r2.seq r3), hout, ?_⟩
  have hzd : zsz d ≤ x.length + 1 := by
    have : d ≤ 2 ^ x.length := by
      have : (0 : ℤ) ≤ 2 ^ N₁ := by positivity
      omega
    calc zsz d ≤ zsz ((2 : ℤ) ^ x.length) := zsz_mono (by
        have : (0 : ℤ) ≤ 2 ^ x.length := by positivity
        omega)
      _ = x.length + 1 := NLogN.zsz_two_pow _
  unfold topOvh
  rw [show y.length = x.length from hxy.symm]
  omega

