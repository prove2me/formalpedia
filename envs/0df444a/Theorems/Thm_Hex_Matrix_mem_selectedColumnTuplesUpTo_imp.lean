theorem mem_selectedColumnTuplesUpTo_imp {m : Nat} :
    ∀ (n bound : Nat) (v : Vector (Fin m) n),
      v ∈ selectedColumnTuplesUpTo m n bound →
        IsStrictlyIncreasingColumnTuple v ∧
          ∀ i : Fin n, v[i].val < bound := by sorry
