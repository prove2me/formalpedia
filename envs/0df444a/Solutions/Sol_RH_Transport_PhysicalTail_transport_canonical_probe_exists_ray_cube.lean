variable {ι : Type*} [Fintype ι]

lemma transport_central_source_crude_scale {Z a e : ℝ} (hZ : 1≤ Z) (ha : 0≤ a) (he : 0≤ e) :
    (Z^TunedCandidate.lx)^(1/2-(17/50:ℝ))*Z^(2+(17/50:ℝ)-1)*
