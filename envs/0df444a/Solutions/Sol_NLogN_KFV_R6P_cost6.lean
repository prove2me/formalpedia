-- Source module: Solutions.KFV61Cost
/-!
# KFV §61: the asymptotic cost of a Proposition 18 call (`Cost18`)

**`cost18_of : Par18Need → Log18Need → Cost18`** (with `A' = 1`). Every piece of `total18` is
bounded by `k · V · Ncost · (log p + 1)` with `V = 2^{n'} 2^ℓ (p+3)`:
setup `≤ 6 Cs V`; layout `≤ 2 Ckc V (dK + p K^{τ-1})`; forward / opposite
`≤ (3·10^12 + 2 + C₀) V Ncost`; shuttles / scaling `≤ 2·10^6 V`; Kronecker
`≤ 10^15 V + 48000 cF c V (ℓ + log₂ p + 1)(log p + 1)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12 GlueLayout GlueP14 GlueError
open IntMul.OpenAI.Glue IntMul.OpenAI.RCost

/-- The setup cost. -/
theorem cSet18_le (Cs p ℓ K : ℕ) (ts : List ℕ) {B X : ℕ}
    (h1 : ts.length + ℓ + K + zsz (p : ℤ) ≤ B) (hS : 10 ^ 12 * (B + 2) ^ 3 ≤ 2 ^ ℓ)
    (hX : 2 ^ ℓ ≤ X) (hBW : B + 2 ≤ 6 * (p + 3)) :
    cSet18 Cs p ℓ K ts ≤ 6 * Cs * (X * (p + 3)) := by
  unfold cSet18
  have e1 : (ts.length + ℓ + K + zsz (p : ℤ) + 2) ^ 4 ≤ (B + 2) ^ 4 :=
    Nat.pow_le_pow_left (by omega) 4
  have e2 : (B + 2) ^ 4 = (B + 2) * (B + 2) ^ 3 := by ring
  have e3 : (B + 2) * (B + 2) ^ 3 ≤ (6 * (p + 3)) * X :=
    Nat.mul_le_mul hBW (by omega)
  have e4 : (ts.length + ℓ + K + zsz (p : ℤ) + 2) ^ 4 ≤ 6 * (X * (p + 3)) := by
    have : (6 * (p + 3)) * X = 6 * (X * (p + 3)) := by ring
    omega
  calc Cs * (ts.length + ℓ + K + zsz (p : ℤ) + 2) ^ 4 ≤ Cs * (6 * (X * (p + 3))) :=
        Nat.mul_le_mul_left _ e4
    _ = 6 * Cs * (X * (p + 3)) := by ring

/-- The shuttle / scaling cost. -/
theorem shut_le {c B X p ℓ : ℕ} (hc : c ≤ 10 ^ 5 * (B + 2) * (2 * X + 1) + 10 ^ 9 * (B + 2) ^ 2)
    (hS : 10 ^ 12 * (B + 2) ^ 3 ≤ 2 ^ ℓ) (hX : 2 ^ ℓ ≤ X) (hBW : B + 2 ≤ 6 * (p + 3)) :
    c ≤ 2 * 10 ^ 6 * (X * (p + 3)) := by
  have hX1 : 1 ≤ X := le_trans Nat.one_le_two_pow hX
  have e1 : (B + 2) * (2 * X + 1) ≤ (6 * (p + 3)) * (3 * X) := Nat.mul_le_mul hBW (by omega)
  have e2 : (B + 2) ^ 2 ≤ (B + 2) ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have e3 : X ≤ X * (p + 3) := Nat.le_mul_of_pos_right _ (by omega)
  nlinarith

/-- The Kronecker stage, with `φ` left symbolic. -/
theorem kron_le {p ℓ n' BK : ℕ} (φ : ℕ) (hp7 : 2 * p + 7 < 2 ^ ℓ) (hℓp : ℓ ≤ p) (hn'p : n' ≤ p)
    (hn'lo : 2 * ℓ ≤ n' + 2) (hBK : BK = 2 * (kb p ℓ * 2 ^ ℓ) + p + n' + ℓ + 8) :
    cKronS p ℓ n' BK φ ≤ 10 ^ 15 * (2 ^ n' * 2 ^ ℓ * (p + 3)) + 8000 * 2 ^ n' * φ := by
  have h := cKronS_le p ℓ n' BK φ
  have hrr : 2 ^ ℓ * 2 ^ ℓ ≤ 4 * 2 ^ n' := by
    have e1 : 2 ^ ℓ * 2 ^ ℓ = 2 ^ (2 * ℓ) := by rw [← pow_add]; ring_nf
    have e2 : 2 ^ (2 * ℓ) ≤ 2 ^ (n' + 2) := pow2_mono hn'lo
    have e3 : 2 ^ (n' + 2) = 4 * 2 ^ n' := by rw [pow_add]; ring
    omega
  set r := 2 ^ ℓ with hr
  set N := 2 ^ n' with hN
  have hr1 : 1 ≤ r := Nat.one_le_two_pow
  have hkb : kb p ℓ = 2 * p + ℓ + 3 := rfl
  have hB2 : BK + 2 ≤ 9 * (p + 3) * r := by
    rw [hBK, hkb]
    have a1 : ℓ * r ≤ p * r := Nat.mul_le_mul_right _ hℓp
    have a2 : 3 * p + 21 ≤ (3 * p + 21) * r := Nat.le_mul_of_pos_right _ hr1
    nlinarith
  have hsq : (BK + 2) ^ 2 ≤ 324 * (N * r * (p + 3)) := by
    have e1 : (BK + 2) ^ 2 ≤ (9 * (p + 3) * r) * (9 * (p + 3) * r) := by
      rw [pow_two]; exact Nat.mul_le_mul hB2 hB2
    have e2 : (p + 3) * r ≤ r * r := Nat.mul_le_mul_right _ (by omega)
    have e3 : (9 * (p + 3) * r) * (9 * (p + 3) * r) = 81 * ((p + 3) * r) * ((p + 3) * r) := by ring
    have e4 : 81 * ((p + 3) * r) * ((p + 3) * r) ≤ 81 * ((p + 3) * r) * (4 * N) :=
      Nat.mul_le_mul_left _ (le_trans e2 hrr)
    have e5 : 81 * ((p + 3) * r) * (4 * N) = 324 * (N * r * (p + 3)) := by ring
    omega
  have hpl : (p + ℓ + 3) * (N * r) ≤ 2 * (N * r * (p + 3)) := by nlinarith
  nlinarith

theorem dpush_le {B ℓ X : ℕ} (hℓ : ℓ ≤ B + 2) (hS : 10 ^ 12 * (B + 2) ^ 3 ≤ 2 ^ ℓ)
    (hX : 2 ^ ℓ ≤ X) : ℓ * (cDPush B + 9 * (2 * B + 2)) ≤ X := by
  have e1 : cDPush B + 9 * (2 * B + 2) ≤ 6 * 10 ^ 9 * (B + 2) ^ 2 := by unfold cDPush; nlinarith
  have e2 : ℓ * (cDPush B + 9 * (2 * B + 2)) ≤ (B + 2) * (6 * 10 ^ 9 * (B + 2) ^ 2) :=
    Nat.mul_le_mul hℓ e1
  have e3 : (B + 2) * (6 * 10 ^ 9 * (B + 2) ^ 2) = 6 * 10 ^ 9 * (B + 2) ^ 3 := by ring
  have e4 : 6 * 10 ^ 9 * (B + 2) ^ 3 ≤ 10 ^ 12 * (B + 2) ^ 3 :=
    Nat.mul_le_mul_right _ (by norm_num)
  omega

end NLogN.KFV

