private theorem globalPoints_weyl_mul_diagOne (y : (AdeleRing (𝓞 K) K)ˣ) :
    globalPoints (𝓞 K) K (CuspSynthesis.weylGL2 K) * diagOne y
      = centralScalar (𝓞 K) K y * (diagOne y⁻¹ * globalPoints (𝓞 K) K (CuspSynthesis.weylGL2 K)) := by
  refine Units.ext (Matrix.ext fun i j => ?_)
