-- title:
--   The singular-control MFG with geometric dynamics and common noise of §5.1
-- statement:
--   Let $W,B$ be independent $\mathbb F$-Brownian motions on a complete filtered probability space, $b\in\mathbb R$, $\sigma,\sigma^o\ge0$, $x_0$ square integrable and $\mathcal F_0$-measurable, $\mathbb F^o$ the filtration generated by $\sigma^oB$, $\pi=dt+\delta_T$, and $f,g,c$ satisfying Assumption 5.1 with $p=2$ and Assumption 5.3 ($f(t,\cdot,\mu)$, $g(\cdot,\mu)$ strictly convex for a.e. $t$).
--
--   1. $V^\uparrow$: adapted càdlàg nondecreasing nonnegative square-integrable $\xi$ with $E\int_0^T\xi_t^2\,d\pi(t)<\infty$ (5.1).
--   2. The state is $X^\xi_t=\mathcal E_t\big[x_0+\int_{[0,t]}\mathcal E_s^{-1}\,d\xi_s\big]$, $\mathcal E_t=\exp\big[(b-\tfrac{\sigma^2+(\sigma^o)^2}2)t+\sigma W_t+\sigma^oB_t\big]$ (5.4), the solution of (5.2).
--   3. For a $\mathcal P(\mathbb R)$-valued $\mathbb F^o$-progressive $\mu$, $J(\xi,\mu)=E\big[\int_0^Tf(t,X^\xi_t,\mu_t)dt+g(X^\xi_T,\mu_T)+\int_{[0,T]}c_t\,d\xi_t\big]$; $\xi$ is optimal if it minimizes $J(\cdot,\mu)$ over $V^\uparrow$.
--   4. $\mu$ is an **equilibrium** (Definition 5.2) if some $\xi$ is optimal for $\mu$ and $\mu_t=P[X^\xi_t\in\cdot\mid\mathcal F^o_T]$ a.s. for every $t$.
--   5. With $S_t=\operatorname{ess\,sup}_\mu E[|X^\mu_t|^2\mid\mathcal F^o_T]$, $\mu^{Min}_t((-\infty,x])=\frac{S_t}{(x\wedge0)^2}\wedge1$ and $\mu^{Max}_t((-\infty,x])=\big(1-\frac{S_t}{(x\vee0)^2}\big)\vee0$ (convention $x/0=\infty$), (5.13)–(5.14); $L$ is the set of such $\mu$ with $\mu^{Min}_t\le_{st}\mu_t\le_{st}\mu^{Max}_t$ a.s. for $\pi$-a.e. $t$, ordered by (5.9); $R(\mu)_t=P[X^\mu_t\in\cdot\mid\mathcal F^o_T]$.
--
--   **Formalization Note** The explicit form (5.4) defines the state. The essential supremum is characterized by its two defining properties, and $L$ is built from any such $S$. Conditional laws hold for each Borel set a.s.; elements of $L$ are processes, $R(\mu)$ and the solution set are closed under $\le_L$-equivalence.
-- source:
--   Dianetti, Ferrari, Fischer, Nendel, A Unifying Framework for Submodular Mean Field Games, arXiv:2201.07850v1, §5.1, pp.16–19 ((5.1)–(5.4), Definition 5.2, Assumption 5.3, (5.9), (5.13)–(5.15))

import Mathlib
import Definitions.Def_SubmodMFG_Supplement_SubProb
import Definitions.Def_SubmodMFG_Supplement_Processes
import Definitions.Def_SubmodMFG_Supplement_SingularCommon

open MeasureTheory ProbabilityTheory

set_option warn.classDefReducibility false

namespace SubmodMFG.Supplement

/-- **Data of the singular-control MFG with geometric dynamics and common noise of §5.1.**
Dianetti, Ferrari, Fischer, Nendel, *A Unifying Framework for Submodular Mean Field Games*,
arXiv:2201.07850v1, §5.1.1, p.16: "Let W and B be two independent Brownian motions on a complete
filtered probability space (Ω, 𝓕, 𝔽, P)", `b ∈ ℝ`, `σ, σ° ≥ 0`, a square-integrable
`𝓕₀`-measurable `x₀`, the horizon `T` and the costs `f, g, c` of §5. Hypotheses: `Standing`. -/
structure GBMModel (Ω : Type*) [MeasurableSpace Ω] where
  P : Measure Ω
  F : Filtration ℝ ‹MeasurableSpace Ω›
  W : ℝ → Ω → ℝ
  B : ℝ → Ω → ℝ
  T : ℝ
  b : ℝ
  σ : ℝ
  σo : ℝ
  x₀ : Ω → ℝ
  f : ℝ → ℝ → SubProb → ℝ
  g : ℝ → SubProb → ℝ
  c : ℝ → ℝ

namespace GBMModel

variable {Ω : Type*} [MeasurableSpace Ω] (D : GBMModel Ω)

/-- `π = dt + δ_T` on `[0, T]` ((5.1), p.16). -/
noncomputable def π : Measure ℝ := volume.restrict (Set.Icc 0 D.T) + Measure.dirac D.T

/-- **Standing assumptions of §5.1** (pp.15–16): a probability measure on a complete filtered
space (`𝓕₀` contains the `P`-null sets), `T > 0`, `W`, `B` independent `𝔽`-Brownian motions on
`[0, T]`, `σ, σ° ≥ 0`, `x₀` square integrable and `𝓕₀`-measurable, Assumption 5.1 with `p = 2`,
and Assumption 5.3 (p.16): "For dt-a.a. t ∈ [0, T], the functions f(t, ·, µ) and g(·, µ) are
strictly convex." -/
structure Standing : Prop where
  prob : IsProbabilityMeasure D.P
  complete : ∀ A : Set Ω, D.P A = 0 → MeasurableSet[D.F 0] A
  T_pos : 0 < D.T
  W_bm : IsFBMOn D.P D.F D.T D.W
  B_bm : IsFBMOn D.P D.F D.T D.B
  indep : IndepFun (fun ω (t : Set.Icc (0 : ℝ) D.T) => D.W t ω)
    (fun ω (t : Set.Icc (0 : ℝ) D.T) => D.B t ω) D.P
  σ_nonneg : 0 ≤ D.σ
  σo_nonneg : 0 ≤ D.σo
  x₀_meas : Measurable[D.F 0] D.x₀
  x₀_sq : ∫⁻ ω, ENNReal.ofReal (D.x₀ ω ^ 2) ∂D.P < ⊤
  a51 : Assumption51 D.T 2 D.f D.g D.c
  a53 : ∀ᵐ t ∂(volume.restrict (Set.Icc (0 : ℝ) D.T)), ∀ μ : SubProb, IsProb μ →
    StrictConvexOn ℝ Set.univ (fun x => D.f t x μ) ∧ StrictConvexOn ℝ Set.univ (fun x => D.g x μ)

/-- `𝔽°`: the filtration generated by `σ°B` (p.16), `𝓕°_t = σ(σ°B_r : 0 ≤ r ≤ t ∧ T)`. -/
def Fo (t : ℝ) : MeasurableSpace Ω :=
  ⨆ r ∈ Set.Icc (0 : ℝ) (min t D.T), MeasurableSpace.comap (fun ω => D.σo * D.B r ω) inferInstance

/-- **Admissible monotone controls `V↑`** (p.16): "all 𝔽-adapted càdlàg, nondecreasing,
square-integrable, and nonnegative processes ξ such that (5.1) E[∫_0^T ξ_t² dπ(t)] < ∞". -/
def Admissible (ξ : ℝ → Ω → ℝ) : Prop :=
  (∀ t ∈ Set.Icc (0 : ℝ) D.T, Measurable[D.F t] (ξ t)) ∧
  (∀ ω, ∀ t ∈ Set.Icc (0 : ℝ) D.T, ContinuousWithinAt (fun s => ξ s ω) (Set.Icc t D.T) t) ∧
  (∀ ω, ∀ t ∈ Set.Ioc (0 : ℝ) D.T,
    ∃ l : ℝ, Filter.Tendsto (fun s => ξ s ω) (nhdsWithin t (Set.Iio t)) (nhds l)) ∧
  (∀ ω, MonotoneOn (fun t => ξ t ω) (Set.Icc 0 D.T)) ∧
  (∀ ω, ∀ t ∈ Set.Icc (0 : ℝ) D.T, 0 ≤ ξ t ω) ∧
  (∀ t ∈ Set.Icc (0 : ℝ) D.T, ∫⁻ ω, ENNReal.ofReal (ξ t ω ^ 2) ∂D.P < ⊤) ∧
  ∫⁻ ω, ∫⁻ t, ENNReal.ofReal (ξ t ω ^ 2) ∂D.π ∂D.P < ⊤

/-- `𝓔_t = exp[(b − (σ² + (σ°)²)/2)t + σW_t + σ°B_t]` (5.4), p.17. -/
noncomputable def Ecal (t : ℝ) (ω : Ω) : ℝ :=
  Real.exp ((D.b - (D.σ ^ 2 + D.σo ^ 2) / 2) * t + D.σ * D.W t ω + D.σo * D.B t ω)

/-- **The controlled state `X^ξ`**, the strong solution of (5.2) `dX^ξ_t = X^ξ_t(b dt + σdW_t +
σ°dB_t) + dξ_t`, `X^ξ_{0−} = x₀`, written by its explicit form (5.4), p.17:
`X^ξ_t = 𝓔_t[x₀ + ∫_{[0,t]} 𝓔_s⁻¹ dξ_s]`.

**Formalization Note.** The paper states (5.4) as the P-a.s. form of the solution of (5.2); the
explicit version is taken as the definition (no stochastic integral is needed). The
Lebesgue–Stieltjes integral includes the jump `ξ_0` at `0`. -/
noncomputable def Xξ (ξ : ℝ → Ω → ℝ) (t : ℝ) (ω : Ω) : ℝ :=
  D.Ecal t ω * (D.x₀ ω +
    ∫ s in Set.Icc 0 t, (D.Ecal s ω)⁻¹ ∂(stieltjesMeasure (pathExt D.T (fun r => ξ r ω))))

/-- `P(ℝ)`-valued `𝔽°`-progressively measurable processes `µ` (p.16). -/
def IsFlow (μ : ℝ → Ω → SubProb) : Prop :=
  (∀ t ∈ Set.Icc (0 : ℝ) D.T, ∀ ω, IsProb (μ t ω)) ∧ ProgMeasOn D.Fo D.T μ

/-- **The cost functional** (p.16): `J(ξ, µ) = E[∫_0^T f(t, X^ξ_t, µ_t)dt + g(X^ξ_T, µ_T) +
∫_{[0,T]} c_t dξ_t]`, in `[−∞, ∞]` (`erealExpect`). -/
noncomputable def J (ξ : ℝ → Ω → ℝ) (μ : ℝ → Ω → SubProb) : EReal :=
  erealExpect D.P (fun ω => (∫ t in (0 : ℝ)..D.T, D.f t (D.Xξ ξ t ω) (μ t ω)) +
    D.g (D.Xξ ξ D.T ω) (μ D.T ω) +
    ∫ t in Set.Icc 0 D.T, D.c t ∂(stieltjesMeasure (pathExt D.T (fun s => ξ s ω))))

/-- **Optimal control** (p.16): `ξ ∈ V↑` with `J(ξ, µ) ≤ J(ξ', µ)` for each admissible `ξ'`
(`(X^µ, ξ^µ) = (X^ξ, ξ)` is then an optimal pair). -/
def IsOptimal (ξ : ℝ → Ω → ℝ) (μ : ℝ → Ω → SubProb) : Prop :=
  D.Admissible ξ ∧ ∀ ξ', D.Admissible ξ' → D.J ξ μ ≤ D.J ξ' μ

/-- `m_t = P[X^ξ_t ∈ · | 𝓕°_T]` P-a.s., for every `t ∈ [0, T]` (each Borel set outside a null
set; `m_t(ω)` is then a regular version of the conditional law). -/
def IsCondLaw (ξ : ℝ → Ω → ℝ) (m : ℝ → Ω → SubProb) : Prop :=
  ∀ t ∈ Set.Icc (0 : ℝ) D.T, ∀ A : Set ℝ, MeasurableSet A →
    (fun ω => ((m t ω).1 A).toReal) =ᵐ[D.P]
      D.P[{ω | D.Xξ ξ t ω ∈ A}.indicator (fun _ => (1 : ℝ)) | D.Fo D.T]

/-- **MFG equilibrium, Definition 5.2** (p.16): "A P(ℝ)-valued 𝔽°-progressively measurable
process µ is an equilibrium of the MFG with singular controls and common noise if (1) there
exists an optimal pair (X^µ, ξ^µ) for µ, (2) µ_t = P[X^µ_t ∈ · | 𝓕°_T] P-a.s., for any
t ∈ [0, T]." -/
def IsEquilibrium (μ : ℝ → Ω → SubProb) : Prop :=
  D.IsFlow μ ∧ ∃ ξ, D.IsOptimal ξ μ ∧ D.IsCondLaw ξ μ

/-- **The essential supremum in (5.13)–(5.14)**, p.18: `S_t = ess sup_µ E[|X^µ_t|² | 𝓕°_T]`
over all flows `µ` (with `X^µ` the optimal state), characterized as the `𝓕°_T`-measurable random
variable that dominates every `E[|X^µ_t|² | 𝓕°_T]` a.s. and is a.s. below every other such
dominating random variable. -/
def IsEssSupMoment (S : ℝ → Ω → ℝ) : Prop :=
  ∀ t ∈ Set.Icc (0 : ℝ) D.T, Measurable[D.Fo D.T] (S t) ∧
    (∀ μ ξ, D.IsFlow μ → D.IsOptimal ξ μ →
      D.P[fun ω => D.Xξ ξ t ω ^ 2 | D.Fo D.T] ≤ᵐ[D.P] S t) ∧
    (∀ S' : Ω → ℝ, Measurable[D.Fo D.T] S' →
      (∀ μ ξ, D.IsFlow μ → D.IsOptimal ξ μ → D.P[fun ω => D.Xξ ξ t ω ^ 2 | D.Fo D.T] ≤ᵐ[D.P] S') →
      S t ≤ᵐ[D.P] S')

/-- The distribution functions of `µ^Min_t` and `µ^Max_t` ((5.14), (5.13), p.18) given
`S = S_t(ω)`: `µ^Min((−∞, x]) = S/(x ∧ 0)² ∧ 1` and `µ^Max((−∞, x]) = (1 − S/(x ∨ 0)²) ∨ 0`, with
the convention `x/0 = ∞`. -/
noncomputable def cdfMin (S x : ℝ) : ℝ := if x < 0 then min 1 (S / x ^ 2) else 1

/-- See `cdfMin`. -/
noncomputable def cdfMax (S x : ℝ) : ℝ := if 0 < x then max 0 (1 - S / x ^ 2) else 0

/-- **The lattice `L`** (p.19): "the set L of all P(ℝ)-valued, 𝔽°-progressively measurable
processes µ with µ^Min_t ≤ µ_t ≤ µ^Max_t P-a.s., for π-a.a. t ∈ [0, T]", for the essential
supremum `S`. `µ^Min_t ≤st µ_t ≤st µ^Max_t` is written with distribution functions:
`F_{µ^Max_t} ≤ F_{µ_t} ≤ F_{µ^Min_t}`. -/
def Lset (S : ℝ → Ω → ℝ) : Set (ℝ → Ω → SubProb) :=
  {μ | D.IsFlow μ ∧ ∀ᵐ t ∂D.π, ∀ᵐ ω ∂D.P, ∀ x : ℝ,
    ((μ t ω).1 (Set.Iic x)).toReal ≤ cdfMin (S t ω) x ∧
    cdfMax (S t ω) x ≤ ((μ t ω).1 (Set.Iic x)).toReal}

/-- `L` as an ordered type with the order (5.9), p.18: "µ ≤_L µ̄ if and only if µ_t ≤ µ̄_t,
P-a.s., for π-a.a. t ∈ [0, T]" (the printed "ν_t" is `µ̄_t`). -/
def FlowL (S : ℝ → Ω → ℝ) : Type _ := {μ : ℝ → Ω → SubProb // μ ∈ D.Lset S}

instance (S : ℝ → Ω → ℝ) : Preorder (D.FlowL S) where
  le μ ν := ∀ᵐ t ∂D.π, ∀ᵐ ω ∂D.P, μ.1 t ω ≤ ν.1 t ω
  le_refl μ := Filter.Eventually.of_forall fun t => Filter.Eventually.of_forall fun ω => le_refl _
  le_trans μ ν ρ h₁ h₂ := by
    filter_upwards [h₁, h₂] with t h h'
    filter_upwards [h, h'] with ω a b using a.trans b

/-- **The best reply `R(µ)_t := P[X^µ_t ∈ · | 𝓕°_T]`** (p.19), as the set of elements of `L`
equivalent (for `≤_L`) to a version of the conditional laws of the optimal state for `µ`. -/
def R (S : ℝ → Ω → ℝ) (μ : D.FlowL S) : Set (D.FlowL S) :=
  {m | ∃ m' : D.FlowL S, m' ≤ m ∧ m ≤ m' ∧ ∃ ξ, D.IsOptimal ξ μ.1 ∧ D.IsCondLaw ξ m'.1}

/-- **The solutions of the MFG** (Theorem 5.4, p.19): the elements of `L` equivalent to an
equilibrium of Definition 5.2 (each lies in `L` by (5.15)). -/
def equilibria (S : ℝ → Ω → ℝ) : Set (D.FlowL S) :=
  {m | ∃ m' : D.FlowL S, m' ≤ m ∧ m ≤ m' ∧ D.IsEquilibrium m'.1}

end GBMModel

end SubmodMFG.Supplement


