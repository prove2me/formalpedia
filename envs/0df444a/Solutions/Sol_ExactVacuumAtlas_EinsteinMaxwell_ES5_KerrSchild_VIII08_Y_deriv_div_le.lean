open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04
theorem solution {R : ℝ} (hR : 3 < R) : deriv Y R / Y R ≤ 3 / R := by
  have hPpos : 0 < P R := P_pos hR
  have haY := aY_ge_third hR
  have hbound : ∀ t ∈ Icc (3:ℝ) R, Vfun t * Y t ≤ 2 * aY R := by
    intro t ht
    have htpos : (0:ℝ) < t := by linarith [ht.1]
    have h1 : Y t ≤ t * aY R := Y_le_mul_aY hR ht
    have h2 : Vfun t ≤ 2 / t := Vfun_le_two_div ht.1
    have hV0 : 0 ≤ Vfun t := le_of_lt (Vfun_pos (by linarith [ht.1]))
    have hY0 : 0 ≤ Y t := le_of_lt (Y_pos ht.1)
    have haYR : 0 ≤ aY R := by linarith [haY]
    rw [le_div_iff₀ htpos] at h2
    have step1 : Vfun t * Y t ≤ Vfun t * (t * aY R) := mul_le_mul_of_nonneg_left h1 hV0
    have step2 : Vfun t * (t * aY R) = (Vfun t * t) * aY R := by ring
    have step3 : (Vfun t * t) * aY R ≤ 2 * aY R := mul_le_mul_of_nonneg_right h2 haYR
    linarith [step1, step2, step3]
  have hInt1 : IntervalIntegrable (fun t => Vfun t * Y t) volume (3:ℝ) R := by
    refine ContinuousOn.intervalIntegrable_of_Icc (le_of_lt hR) ?_
    exact (continuousOn_Vfun.mul Y_continuousOn).mono (fun x hx => hx.1)
  have hInt2 : IntervalIntegrable (fun _ : ℝ => 2 * aY R) volume (3:ℝ) R :=
    intervalIntegrable_const
  have hmono := intervalIntegral.integral_mono_on (le_of_lt hR) hInt1 hInt2 hbound
  have hconst : ∫ _t in (3:ℝ)..R, 2 * aY R = (R - 3) * (2 * aY R) := by
    rw [intervalIntegral.integral_const]
    simp
  rw [hconst] at hmono
  rw [← P_mul_deriv_Y hR] at hmono
  have hYd : deriv Y R ≤ 2 * aY R * (R - 3) / P R := by
    rw [le_div_iff₀ hPpos]
    nlinarith [hmono]
  have hPeq : 2 * aY R * (R - 3) / P R = 2 * Y R / (R - 1) := by
    unfold P N0 aY
    have hR0 : R ≠ 0 := by linarith
    have hR1 : R - 1 ≠ 0 := by linarith
    have hR3 : R - 3 ≠ 0 := by linarith
    field_simp
  rw [hPeq] at hYd
  have hYpos : 0 < Y R := Y_pos (le_of_lt hR)
  rw [div_le_div_iff₀ hYpos (by linarith : (0:ℝ) < R)]
  have hstep : 2 * Y R / (R - 1) ≤ 3 * Y R / R := by
    rw [div_le_div_iff₀ (by linarith : (0:ℝ) < R - 1) (by linarith : (0:ℝ) < R)]
    nlinarith [hYpos, hR]
  have hle : deriv Y R ≤ 3 * Y R / R := le_trans hYd hstep
  calc deriv Y R * R ≤ (3 * Y R / R) * R :=
        mul_le_mul_of_nonneg_right hle (by linarith)
    _ = 3 * Y R := by field_simp
