    (zh : List GI) (c : ℕ)
    (hcall : IRuns I iprog (.call j)
      (NLogN.KIL.encK (bgS s G d18 l) (NLogN.KFZ.fC d18 (gflat ZF ++ gflat ZG ++ [])
