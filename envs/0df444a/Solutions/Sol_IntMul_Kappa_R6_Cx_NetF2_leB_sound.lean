/-! ## Vectors -/

lemma ev_dot (n : ℕ) (v : V24) : ev n ⬝ᵥ v = if h : n < 24 then v ⟨n, h⟩ else 0 := by
  simp only [dotProduct, ev, ite_mul, one_mul, zero_mul]
  split_ifs with h
  · rw [Finset.sum_eq_single ⟨n, h⟩]
    · simp
    · intro b _ hb; rw [if_neg]; intro e; exact hb (Fin.ext e)
    · simp
  · exact Finset.sum_eq_zero fun i _ => by rw [if_neg]; intro e; exact h (e ▸ i.isLt)

lemma dot_ev (v : V24) (n : ℕ) : v ⬝ᵥ ev n = if h : n < 24 then v ⟨n, h⟩ else 0 := by
  rw [dotProduct_comm, ev_dot]

lemma bitv_apply (w : ℕ) (i : Fin 24) : bitv w i = if w.testBit i then 1 else 0 := rfl

/-! ## Subspaces -/

lemma ev_mem_coordSp {X : ℕ} (i : Fin 24) (h : X.testBit i = true) : ev i ∈ coordSp X :=
  Submodule.subset_span (Finset.mem_coe.2 (Finset.mem_image.2 ⟨i, by simp [h], rfl⟩))

lemma gP_mem_pspSp {a b C : ℕ} (c : Fin 24) (h : C.testBit c = true) :
    ev a + ev b + ev c ∈ pspSp a b C :=
  Submodule.subset_span (Finset.mem_coe.2 (Finset.mem_image.2 ⟨c, by simp [h], rfl⟩))

lemma coordSp_full : coordSp 16777215 = ⊤ := by
  rw [eq_top_iff]
  intro v _
  have hv : v = ∑ i : Fin 24, v i • ev i := by
    funext j
    rw [Finset.sum_apply, Finset.sum_eq_single j]
    · simp [ev]
    · intro b _ hb; simp [ev, Fin.val_inj, Ne.symm hb]
    · simp
  rw [hv]
  refine Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (ev_mem_coordSp i ?_)
  have h : (16777215 : ℕ) = 2 ^ 24 - 1 := rfl
  rw [h, Nat.testBit_two_pow_sub_one]; simp [i.isLt]

/-! ## Codes and the Boolean checker -/

lemma FULL_eq : FULL = 2 ^ 24 - 1 := rfl

lemma testBit_FULL {i : ℕ} (hi : i < 24) : FULL.testBit i = true := by
  rw [FULL_eq, Nat.testBit_two_pow_sub_one]; simp [hi]

/-! ## Soundness -/

lemma testBit_lt_of_and_zero {w X : ℕ} (h : w &&& (FULL ^^^ X) = 0) {i : ℕ} (hi : i < 24)
    (hw : w.testBit i = true) : X.testBit i = true := by
  have := congrArg (fun n => n.testBit i) h
  simp only [Nat.testBit_and, Nat.testBit_xor, testBit_FULL hi, Nat.zero_testBit, hw] at this
  cases hX : X.testBit i <;> simp_all

lemma not_both_of_and_zero {w X : ℕ} (h : w &&& X = 0) (i : ℕ) (hw : w.testBit i = true) :
    X.testBit i = false := by
  have := congrArg (fun n => n.testBit i) h
  simp only [Nat.testBit_and, Nat.zero_testBit, hw, Bool.true_and] at this
  exact this

lemma mem_perpSp {t : ℕ} {v : V24} : v ∈ perpSp t ↔ bitv t ⬝ᵥ v = 0 := by
  rw [perpSp, mem_orth_one]
  constructor
  · intro h; exact h _ (Submodule.mem_span_singleton_self _)
  · intro h x hx
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.1 hx
    rw [smul_dotProduct, h, smul_zero]

lemma dot_gen_apply (a b : ℕ) (c : Fin 24) (ha : a < 24) (hb : b < 24) (v : V24) :
    (ev a + ev b + ev c) ⬝ᵥ v = v ⟨a, ha⟩ + v ⟨b, hb⟩ + v c := by
  simp only [add_dotProduct, ev_dot, dif_pos ha, dif_pos hb, dif_pos c.isLt]

lemma pspOK_of_okC {a b C : ℕ} (hok : okC (.psp a b C) = true) : PspOK a b C := by
  simp only [okC, Bool.and_eq_true, Nat.blt_eq, Bool.not_eq_true'] at hok
  obtain ⟨⟨⟨⟨ha, hb⟩, hab⟩, hCa⟩, hCb⟩ := hok
  exact ⟨ha, hb, Nat.ne_of_beq_eq_false (by simpa using hab), hCa, hCb⟩

lemma bit_of_and_zero_or {x Y : ℕ} (h : x &&& (FULL ^^^ Y) = 0) {i : ℕ} (hi : i < 24)
    (hx : x.testBit i = true) : Y.testBit i = true := testBit_lt_of_and_zero h hi hx

theorem leB_sound_sol_aux : ∀ (U V : Code), okC U = true → okC V = true → leB U V = true → dec U ≤ dec V
  | .coord X, .coord Y, _, _, h => by
    simp only [leB, Nat.beq_eq] at h
    rw [dec, dec, coordSp, Submodule.span_le]
    intro z hz
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hz)
    exact ev_mem_coordSp i (bit_of_and_zero_or h i.isLt (by simpa using hi))
  | .coord X, .psp _ _ _, _, _, h => by
    simp only [leB, Nat.beq_eq] at h
    rw [dec, coordSp, Submodule.span_le]
    intro z hz
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hz)
    have hXi : X.testBit i = true := by simpa using hi
    have := not_both_of_and_zero h i hXi
    rw [testBit_FULL i.isLt] at this
    exact absurd this (by simp)
  | .coord X, .perp t, _, _, h => by
    simp only [leB, Nat.beq_eq] at h
    rw [dec, dec, coordSp, Submodule.span_le]
    intro z hz
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hz)
    have hXi : X.testBit i = true := by simpa using hi
    have := not_both_of_and_zero h i hXi
    rw [SetLike.mem_coe, mem_perpSp, dot_ev, dif_pos i.isLt, bitv_apply]
    simp [this]
  | .coord _, .ext _, _, _, h => by simp [leB] at h
  | .psp a b C, .coord Y, hU, _, h => by
    obtain ⟨ha, hb, -, -, -⟩ := pspOK_of_okC hU
    simp only [leB, Nat.beq_eq] at h
    rw [dec, dec, pspSp, Submodule.span_le]
    intro z hz
    obtain ⟨c, hc, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hz)
    have hCc : C.testBit c = true := by simpa using hc
    have hYa : Y.testBit a = true := bit_of_and_zero_or h ha (by simp [Nat.testBit_two_pow])
    have hYb : Y.testBit b = true := bit_of_and_zero_or h hb (by simp [Nat.testBit_two_pow])
    have hYc : Y.testBit c = true := bit_of_and_zero_or h c.isLt (by simp [hCc])
    exact Submodule.add_mem _ (Submodule.add_mem _ (ev_mem_coordSp ⟨a, ha⟩ hYa)
      (ev_mem_coordSp ⟨b, hb⟩ hYb)) (ev_mem_coordSp c hYc)
  | .psp a b C, .psp a' b' C', hU, hV, h => by
    have hp := pspOK_of_okC hU
    simp only [leB, Bool.or_eq_true, Bool.and_eq_true, Nat.beq_eq] at h
    rw [dec, pspSp, Submodule.span_le]
    intro z hz
    obtain ⟨c, hc, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hz)
    have hCc : C.testBit c = true := by simpa using hc
    rcases h with ⟨⟨rfl, rfl⟩, hCC⟩ | ⟨h1, hm⟩
    · exact gP_mem_pspSp c (bit_of_and_zero_or hCC c.isLt hCc)
    · rw [line_gen hp h1 c hCc]
      exact memB_sound _ hV _ hm
  | .psp a b C, .perp t, hU, _, h => by
    obtain ⟨ha, hb, -, -, -⟩ := pspOK_of_okC hU
    rw [dec, pspSp, Submodule.span_le]
    intro z hz
    obtain ⟨c, hc, rfl⟩ := Finset.mem_image.1 (Finset.mem_coe.1 hz)
    have hCc : C.testBit c = true := by simpa using hc
    rw [SetLike.mem_coe, dec, mem_perpSp, dotProduct_comm, dot_gen_apply a b c ha hb, bitv_apply,
      bitv_apply, bitv_apply]
    simp only [leB] at h
    cases hta : t.testBit a <;> cases htb : t.testBit b <;> rw [hta, htb] at h <;>
      simp only [Bool.xor_true, Bool.xor_false, Bool.not_true, Bool.not_false, cond_true,
        cond_false, Nat.beq_eq] at h
    · have := not_both_of_and_zero h c hCc
      simp [this]
    · have := testBit_lt_of_and_zero h c.isLt hCc
      simp [this]; decide
    · have := testBit_lt_of_and_zero h c.isLt hCc
      simp [this]; decide
    · have := not_both_of_and_zero h c hCc
      simp [this]; decide
  | .psp _ _ _, .ext _, _, _, h => by simp [leB] at h
  | .perp t, .coord Y, _, _, h => by
    simp only [leB, Nat.beq_eq] at h
    subst h
    rw [dec, dec, show FULL = 16777215 from rfl, coordSp_full]; exact le_top
  | .perp _, .psp _ _ _, _, _, h => by simp [leB] at h
  | .perp _, .perp _, _, _, h => by simp [leB] at h
  | .perp _, .ext _, _, _, h => by simp [leB] at h
  | .ext _, _, h, _, _ => by simp [okC] at h

end IntMul.Kappa.R6.Cx.NetF2

