section Presentations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Remark 3.22, PDF p. 16: orbit, evaluation, domain and dual-cone descriptions. -/
theorem centralFunctional_coadjoint_semibounded (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) (hf : FaithfulAction P)
    (f : (LieAlgebra.center ℝ G) →ₗ[ℝ] ℝ) :
    (∀ l : P.L, (extendedFunctional P f).comp (innerWord [(l : G)]).toLinearMap = extendedFunctional P f) ∧
    coadjointOrbit (extendedFunctional P f) =
      {H | ∃ v : P.V, H = (extendedFunctional P f).comp (innerWord [(v : G)]).toLinearMap} ∧
    (∀ x : G, (fun H : G →ₗ[ℝ] ℝ => H x) '' coadjointOrbit (extendedFunctional P f) =
      (extendedFunctional P f) '' Set.range (centralHamiltonian P x)) ∧
    coadjointBoundedDomain (extendedFunctional P f) =
      {x | BoundedBelowOn (extendedFunctional P f) (centralHull P x)} ∧
    (∀ x : G, vPart P x = 0 → (x ∈ coadjointBoundedDomain (extendedFunctional P f) ↔
      ∀ c ∈ centralQuadraticCone P x, 0 ≤ extendedFunctional P f c)) := by sorry

end Presentations

end

