-- title:
--   Eq. (35) — a subgradient of $L_\beta$ bounded by $C\|x^{t+1}-x^t\|$
-- statement:
--   Let $h:\mathbb R^n\to\mathbb R$ be twice continuously differentiable with bounded Hessian, $P:\mathbb R^m\to(-\infty,+\infty]$ proper and closed, $\mathcal M:\mathbb R^n\to\mathbb R^m$ linear and $\beta>0$, with augmented Lagrangian $L_\beta(x,y,z)=h(x)+P(y)-\langle z,\mathcal Mx-y\rangle+\frac\beta2\|\mathcal Mx-y\|^2$. Suppose Assumption 1 holds with $\mathcal T_1=0$ (hence $\phi=0$), with witnesses $\sigma,\mathcal Q_1,\mathcal Q_2,\delta,\mathcal Q_3,\gamma$, and let $(x^t,y^t,z^t)_{t\ge0}$ be generated by the ADMM
--   $$
--   y^{t+1}\in\operatorname*{Arg\,min}_y L_\beta(x^t,y,z^t),\qquad x^{t+1}\in\operatorname*{Arg\,min}_x L_\beta(x,y^{t+1},z^t),\qquad z^{t+1}=z^t-\beta(\mathcal Mx^{t+1}-y^{t+1}).
--   $$
--
--   Then there is a constant $C>0$ such that for every $t\ge1$ there is $w\in\partial L_\beta(x^{t+1},y^{t+1},z^{t+1})$, the limiting subdifferential of $L_\beta$ as a function of $(x,y,z)$, with
--   $$
--   \|w\|\le C\,\|x^{t+1}-x^t\| .
--   $$
--   In particular $\operatorname{dist}(0,\partial L_\beta(x^{t+1},y^{t+1},z^{t+1}))\le C\|x^{t+1}-x^t\|$, which is (35).
--
--   This is the "relative error" half of the KL argument: small primal steps force nearly stationary points of $L_\beta$.
--
--   **Formalization Note** The ADMM is the relation `IsProxADMMSeq` with $\phi = 0$ (the Bregman term vanishes); Assumption 1 is instantiated with $\phi = 0$ and $\mathcal T_1 = 0$, and $\mathcal T_2$ is left as a parameter (Assumption 1 forces $0 \preceq \mathcal T_2 \preceq \mathcal T_1 = 0$). Values of $L_\beta$ and $P$ live in `EReal`; iterates are indexed from $0$, and $y^0$ is not constrained. The existential form (an explicit subgradient) implies the distance form. The range $t\ge1$ is where the paper's (14) applies; the paper leaves it implicit.
-- source:
--   Li & Pong, Global Convergence of Splitting Methods for Nonconvex Composite Optimization, arXiv:1407.0753v6, p. 14, Eq. (35)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_Assumption1
import Definitions.Def_NonconvexSplitting_Shared_IsProxADMMSeq
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_ADMMKL_AugLagProd
open NonconvexSplitting.Shared

open Filter Topology
open scoped InnerProductSpace

namespace NonconvexSplitting.ADMMKL

/-- Eq. (35) of Li–Pong (p. 14): along the ADMM (proximal ADMM with `φ = 0`) under Assumption 1
with `T₁ = 0`, the limiting subdifferential of `L_β` (on the triple space) at the new iterate
contains a vector of norm at most `C ‖x^{t+1} - x^t‖`, for a constant `C > 0` and all `t ≥ 1`. -/
theorem eq35_subgradient_bound {n m : ℕ} (h : EuclideanSpace ℝ (Fin n) → ℝ) (P : EuclideanSpace ℝ (Fin m) → EReal)
    (M : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m)) (β : ℝ)
    (hstd : StandingAssumptions h P (fun _ => 0) β)
    (σ δ γ : ℝ) (Q1 Q2 T2 Q3 : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (hA : Assumption1 h (fun _ => 0) M β σ Q1 Q2 0 T2 δ Q3 γ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y z : ℕ → EuclideanSpace ℝ (Fin m))
    (hseq : IsProxADMMSeq h P (fun _ => 0) M β x y z) :
    ∃ C : ℝ, 0 < C ∧ ∀ t : ℕ, 1 ≤ t →
      ∃ w ∈ LimitingSubdiff (augLagX h P M β) (pack (x (t + 1)) (y (t + 1)) (z (t + 1))),
        ‖w‖ ≤ C * ‖x (t + 1) - x t‖ := by sorry

end NonconvexSplitting.ADMMKL
