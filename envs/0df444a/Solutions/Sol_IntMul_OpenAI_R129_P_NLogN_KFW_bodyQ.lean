theorem runQ_push (pl : List (Fin HS × Ex HS)) (vl : List (Fin HS × ℤ)) (cp Bb : ℕ)
    (hP : PushSeq σ pl vl cp) (hf : ∀ j, (σ j).isSome → f j = [])
    (hfp : ∀ p ∈ vl, f p.1 = [] ∧ g p.1 = []) (hBb : ∀ p ∈ vl, zsz p.2 ≤ Bb)
