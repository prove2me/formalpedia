    rw [hcp τ hτ, hb]
  have hq1 : a τ ^ (q + 1) = 1 := by
    rw [pow_succ', ← (hconj τ hτ).1, hab]

  rcases c with _ | k
  · have h1 : μ₁ u ^ 1 = 1 := by rw [pow_one, (hc u hu).1]
    have ha1 : a τ ^ 1 = 1 :=
      H1Glue.units_pow_eq_one_of_map_eq j j₂ hinj₂ _ (a τ) (a' τ) ha (hC1' P hP τ hτ) 1 ((hiff 1).mpr h1)
    rw [pow_one] at ha1
