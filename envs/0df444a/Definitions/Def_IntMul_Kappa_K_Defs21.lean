-- Source module: Solutions.KFLMain
/-!
# KFL §18: Lemma 13 in IL

`lem13_il` (the corrected statement of `KFH_WIP.lem13_iruns`, see `KFL_WIP`): integers → bits
(`toBitsI`), the slot canonicalisation by at most two Lemma-12 swaps (`swSeq (preL px py)`), the
packed lines (`linesI`), the guard-set correction (`corrI`), the last selected bit (`xorStep`),
the inverse swaps and bits → integers (`fromBitsI`).  The composite is `permRecs (rowAddAddr …)`
(`bits_permRecs`, `pipeline_rixT`, `Fpp_conj`); the cost is of the form (19) with
`τ = 1 - 2^{-50}`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD KFB KFH AModel Butterfly

/-! ## Sequences of slot swaps -/

def swCode (q u : ℕ) (g : Geo) : Fin 3 → IStmt HS 1
  | 0 => swI q g.N0 g.N1 (vol [g.N2, g.Q, g.N3, g.B]) u
  | 1 => swI q (vol [g.N0, g.Q, g.N1]) g.N2 (vol [g.N3, g.B]) u
  | 2 => swI q g.N0 (vol [g.N1, g.Q, g.N2]) (vol [g.N3, g.B]) u

def swSeq (q u : ℕ) (g : Geo) : List (Fin 3) → IStmt HS 1
  | [] => .skip
  | i :: l => .seq (swCode q u g i) (swSeq q u g l)

/-- The swap property delivered by `swI_geo` for one prime `q`. -/
def SwOK (q : ℕ) (Ksw : ℝ) : Prop :=
  ∀ (i : Fin 3) (g : Geo), g.Pos → ∀ u : ℕ, 1 ≤ u → g.Q = 2 ^ u →
    ∀ (I : List Sym) (t : IState HS) (zs : List ℤ) (R : List Item),
    Bits zs → t.G 0 = ints zs ++ R → zs.length = g.V →
    ∃ c : ℕ, IRuns I l12prog (swCode q u g i) t (t.upd 0 (ints (rixT g (swT i) zs) ++ R)) c ∧
      (c : ℝ) ≤ Ksw * ((g.V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)

/-! ## Cost bounds of the rotations -/

/-! ## The program -/

/-- The last-bit step on the geometry. -/
def xorG (K ρ f : ℕ) (g : Geo) : IStmt HS 1 :=
  xorStep (g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) g.Q (ρ + (f - 1) * K)
    (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) (2 ^ (ρ + (f - 1) * K) * g.S1)

/-- Lines, correction, last bit: the canonical row addition `RAc` on the bit array. -/
def coreB (q K ρ f : ℕ) (g : Geo) : IStmt HS 1 :=
  .seq (linesI q K ρ f g lines) (.seq (corrI K ρ f g) (xorG K ρ f g))

/-- **The code of Lemma 13** (for the prime `q` of Lemma 12). -/
def l13code (q N0 N1 N2 N3 K f ρ R w : ℕ) (px py : Fin 3) : IStmt HS 1 :=
  .seq (toBitsI (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w)
    (.seq (swSeq q (f * K) (geoB N0 N1 N2 N3 (f * K) R w) (preL px py))
    (.seq (coreB q K ρ f (geoB N0 N1 N2 N3 (f * K) R w))
    (.seq (swSeq q (f * K) (geoB N0 N1 N2 N3 (f * K) R w) (preL px py).reverse)
      (fromBitsI (2 * (vol (rect N0 N1 N2 N3 (f * K)) * R)) w))))

/-- The lines property delivered by `linesI_spec` for one prime `q`. -/
def LinesOK (q : ℕ) (Ks : ℝ) : Prop :=
  ∀ (K ρ f : ℕ), 1 ≤ K → ρ < K → 1 ≤ f →
    ∀ (g : Geo), g.Pos → g.Q = 2 ^ (f * K) →
    ∀ (Bb : ℕ), 2 ≤ Bb → 4 * 2 ^ (f * K) < 2 ^ Bb → zsz (g.V : ℤ) ≤ Bb →
    ∀ (ls : List Line), (∀ l ∈ ls, LineOK l) →
    ∀ (I : List Sym) (t : IState HS) (zs : List ℤ) (R : List Item),
    Bits zs → t.G 0 = ints zs ++ R → zs.length = g.V →
    ∃ c : ℕ, IRuns I l12prog (linesI q K ρ f g ls) t
        (t.upd 0 (ints (rixT g (fun c => ls.foldr (fun l c => lineP K ρ f l c) c) zs) ++ R)) c ∧
      (c : ℝ) ≤ 1 + ls.length * (2 * Ks * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)
        + cRotG K f g Bb)

/-- The correction property delivered by `corrI_spec`. -/
def CorrOK (Kc : ℝ) : Prop :=
  ∀ (K ρ f : ℕ), 6 ≤ K → ρ < K → 1 ≤ f →
    ∀ (g : Geo), g.Pos → g.Q = 2 ^ (f * K) →
    ∀ (I : List Sym) (iprog : Fin 1 → IStmt HS 1) (t : IState HS) (zs : List ℤ) (R : List Item),
    Bits zs → t.G 0 = ints zs ++ R → zs.length = g.V →
    ∃ c : ℕ, IRuns I iprog (corrI K ρ f g) t
        (t.upd 0 (ints (rixT g (corrc K ρ f) zs) ++ R)) c ∧
      (c : ℝ) ≤ Kc * (((g.V / g.B : ℕ) : ℝ) * ((zsz (g.V : ℤ) : ℝ) + 1) ^ 3 + (g.V : ℝ) +
        min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * ((g.V / g.B : ℕ) : ℝ) *
          ((zsz (g.V : ℤ) : ℝ) + 1) * ((g.B : ℝ) + (zsz (g.V : ℤ) : ℝ) + 1))

/-- The cost bound of the core. -/
noncomputable def coreCost (Ks Kcr : ℝ) (K ρ f : ℕ) (g : Geo) : ℝ :=
  (1 + 8 * (2 * Ks * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)
        + cRotG K f g (zsz (g.V : ℤ) + 3))) +
    Kcr * (((g.V / g.B : ℕ) : ℝ) * ((zsz (g.V : ℤ) : ℝ) + 1) ^ 3 + (g.V : ℝ) +
      min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * ((g.V / g.B : ℕ) : ℝ) *
        ((zsz (g.V : ℤ) : ℝ) + 1) * ((g.B : ℝ) + (zsz (g.V : ℤ) : ℝ) + 1)) +
    cXor (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) (2 ^ (ρ + (f - 1) * K) * g.S1)
      1 (zsz (g.V : ℤ) + 3)

/-! ## Lemma 13: denotation and the cost pieces -/

/-! ## The cost in the form (19) -/

