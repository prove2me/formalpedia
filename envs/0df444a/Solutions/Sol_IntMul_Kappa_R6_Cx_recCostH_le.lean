namespace Prop8IfaceH

variable {W T m : ℕ} {h : List (ℕ × ℕ)}

/-- `∑_{children} g(|S|) = ∑_w n_w g(w)`. -/
theorem sum_widths (J : Prop8IfaceH W T m h) {M : Type*} [AddCommMonoid M] (g : ℕ → M) :
    (J.widths.map g).sum = (h.map fun p => p.2 • g p.1).sum := by
  rw [← histMS_sum_map, ← J.hist]
  simp [widths]

