open scoped Classical

theorem delete_vertex_ccc_fun_match :
    ∀ (SC : SpernerCube) {n1 : ℕ} {hn1 : n1 + 1 = SC.n} (J : Fin (SC.n + 1) → SC.G),
  simplex SC SC.n J →
    ∀ (j1 j2 : Fin (SC.n + 1)),
      Eq (α := Fin (n1 + 1) → Fin (SC.n + 1)) (ccc_fun SC (delete_vertex SC (hn1 := hn1) j1 J))
          (insert_index SC (hn1 := hn1) j2) →
        (j1 = 0 → j2 = Fin.last SC.n) ∧ (j1 ≠ 0 → j1 = j2)
:= by sorry
