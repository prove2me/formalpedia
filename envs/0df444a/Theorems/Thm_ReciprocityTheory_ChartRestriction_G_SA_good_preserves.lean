theorem ReciprocityTheory.ChartRestriction.G.SA.good_preserves {p : Matrix ι ι K} (hp : p ∈ Good σ J e f) (x y : ι → K) :
    hf σ J (p *ᵥ x) (p *ᵥ y) = hf σ J x y := by sorry
