    (cost := IntMul.OpenAI.R129.P.NLogN.KFW.cLowPart Kc K S r H P D k q0 Bp Z Zr Bz)
    (by
      have hC2 : NLogN.KFW.CoreR (NLogN.KFW.σPush σ [(16, ((NLogN.KFW.clCond.val (NLogN.KFW.vOf σ) : ℕ) : ℤ))]) K S r H P D ρ k q0 Bp :=
        hC.push _ (fun p hp => by simp only [List.mem_singleton] at hp; subst hp; (try dsimp only); decide)
      by_cases hlt : q0 < D
      · have hv : NLogN.KFW.clCond.val (NLogN.KFW.vOf σ) = 0 := by
          simp only [NLogN.KFW.clCond, NLogN.KIL.NE.val, NLogN.KFW.vOf_eq hC.hq, NLogN.KFW.vOf_eq hC.hD]; rw [if_pos hlt]
        rw [if_pos hv]
        exact IntMul.OpenAI.R129.P.NLogN.KFW.lowPartQ jW jL rowC hW hL LV (pre hlt) hP hr hC2
      · have hv : NLogN.KFW.clCond.val (NLogN.KFW.vOf σ) = 1 := by
          simp only [NLogN.KFW.clCond, NLogN.KIL.NE.val, NLogN.KFW.vOf_eq hC.hq, NLogN.KFW.vOf_eq hC.hD]; rw [if_neg hlt]
        rw [if_neg (by omega)]
        have hDq : D - q0 = 0 := by omega
        rw [hDq, NLogN.KFW.lowF_zero, NLogN.KFW.lowF_zero]
        refine (NLogN.KFW.sImplQ_skip _ ?_).mono (fun w _ _ => ?_)
        · rw [← Butterfly.tensF_one]; congr 1; funext x; rw [if_neg (by have := x.isLt; omega)]
        · unfold IntMul.OpenAI.R129.P.NLogN.KFW.cLowPart NLogN.KFW.cFrame; omega)
  have C := TF.comp hsl LT
  have hTT : (Butterfly.tensF fun x : Fin D => if q0 ≤ x.val then Butterfly.Cm else 1) *
      (Butterfly.tensF fun x : Fin D => if 0 ≤ x.val ∧ x.val < q0 then Butterfly.Cm else 1) = Butterfly.tens Cm := by
    rw [← Butterfly.tensF_mul]; unfold Butterfly.tens; congr 1; funext x
    by_cases h : q0 ≤ x.val
    · rw [if_pos h, if_neg (by omega), mul_one]
    · rw [if_neg h, if_pos ⟨Nat.zero_le _, by omega⟩, one_mul]
  refine ((C.congrT hTT).congrC rfl).mono (fun w _ _ => ?_)
  simp only [IntMul.OpenAI.R129.P.NLogN.KFW.cCL, List.length_singleton]
  omega
