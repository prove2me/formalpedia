import Mathlib.Data.Nat.Basic

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-!
# R8 opp-bank Loc slot tables (jfstack_23, `R = 27794`)

Packed with the same `packL` (65536-bit limbs, LSB first) as R6 BitNB GenData.
Fields: `TPTS` 5-bit @ `3T+k`; `INJ`/`RETS`/`RETN`/`SRC` 16-bit.
Source: Jain `certificates/round7/jfstack_23.json.gz` via `jfdata.load(23)`.
-/

namespace IntMul.Kappa.R8.Bit.Oppbank.LocSlots

def packL (l : List Nat) : Nat := l.foldr (fun p acc => Nat.lor p (Nat.shiftLeft acc 65536)) 0

