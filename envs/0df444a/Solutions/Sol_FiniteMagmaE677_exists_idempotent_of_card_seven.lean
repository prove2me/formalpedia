/-- Every element of `Fin 7` is a numeral; the value `4` is the last case. -/
theorem cv4 (w : Fin 7) : w = 0 ∨ w = 1 ∨ w = 2 ∨ w = 3 ∨ w = 5 ∨ w = 6 ∨ w = 4 := by
