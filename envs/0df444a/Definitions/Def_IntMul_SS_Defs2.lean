-- Source module: NLogNP.SSBase
/-!
# Schönhage–Strassen in the item language: stack layout and Fermat-ring arithmetic

The program uses `NS` item stacks with fixed roles, so that stack (in)equalities are decided by
`simp`.  The current ring `ℤ/(2^n+1)` is given by the ruler `2^n` on top of `RN` and the modulus
`2^n+1` on top of `RF`.
-/

namespace NLogN

open IntMul

abbrev NS : ℕ := 32

abbrev ARG : Fin NS := 0
abbrev PRM : Fin NS := 1
abbrev RN : Fin NS := 2
abbrev RF : Fin NS := 3
abbrev T1 : Fin NS := 4
abbrev T2 : Fin NS := 5
abbrev T3 : Fin NS := 6
abbrev T4 : Fin NS := 7

/-- `o` evaluates to the state `t` with cost at most `c`. -/
def runsTo {S : ℕ} (o : Option (IState S × ℕ)) (t : IState S) (c : ℕ) : Prop :=
  match o with
  | some r => r.1 = t ∧ r.2 ≤ c
  | none => False

@[simp] theorem cls_none' : cls none = .none := rfl
@[simp] theorem cls_mark' : cls (some .mark) = .mark := rfl

@[simp] theorem IState.cl_def {S : ℕ} (s : IState S) (i : Fin S) : s.cl i = cls (s.G i).head? := rfl

/-! ## Fermat reduction -/

variable {P : ℕ}

/-- Reduce the integer on top of `X` modulo `2^n+1` (needs `|z| < 2^(2n+1)`). -/
def fredA (X : Fin NS) : IStmt NS P :=
  .seq (.op (.split X RN T1)) (.seq (.op (.split X RN T2)) (.seq (.op (.neg T2))
    (.seq (.op (.add T1 T2 T1)) (.op (.add T1 X X)))))

def fadd (X : Fin NS) : IStmt NS P :=
  .ite X (fun c => c == .neg) (.seq (.op (.dup RF T1)) (.op (.add T1 X X))) .skip

def fsub (X : Fin NS) : IStmt NS P :=
  .seq (.op (.dup RF T1)) (.seq (.op (.neg T1)) (.seq (.op (.dup X T2)) (.seq (.op (.add T2 T1 T1))
    (.ite T1 (fun c => c != .neg) (.seq (.op (.drop X)) (.op (.mv T1 X))) (.op (.drop T1))))))

def fred (X : Fin NS) : IStmt NS P :=
  .seq (fredA X) (.seq (fadd X) (.seq (fadd X) (.seq (fsub X) (fsub X))))

/-- The value computed by `fredA`. -/
def fredW (n : ℕ) (z : ℤ) : ℤ :=
  let q := sg z (z.natAbs / 2 ^ n)
  sg z (z.natAbs % 2 ^ n) + -sg q (q.natAbs % 2 ^ n) + sg q (q.natAbs / 2 ^ n)

/-- The final value after the four normalization steps. -/
def fnorm (F w : ℤ) : ℤ :=
  let w1 := if w < 0 then F + w else w
  let w2 := if w1 < 0 then F + w1 else w1
  let w3 := if ¬ (w2 + -F < 0) then w2 + -F else w2
  if ¬ (w3 + -F < 0) then w3 + -F else w3

end NLogN

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

end NLogN

end

