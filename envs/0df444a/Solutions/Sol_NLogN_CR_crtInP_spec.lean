open IntMul IntMul.HvdH IntMul.HvdH.Ref

theorem rmPos_congr : ∀ (s : List ℕ) (j j' : ℕ → ℕ), (∀ i < s.length, j i = j' i) →
    rmPos s j = rmPos s j'
  | [], _, _, _ => rfl
  | n :: ns, j, j', h => by
    simp only [rmPos]
    rw [h 0 (by simp), rmPos_congr ns _ _ (fun i hi => h (i + 1) (by simp; omega))]

theorem rmPos_lt : ∀ (s : List ℕ) (j : ℕ → ℕ), (∀ i < s.length, j i < s.getD i 1) →
    rmPos s j < s.prod
  | [], _, _ => by simp [rmPos]
  | n :: ns, j, h => by
    simp only [rmPos, List.prod_cons]
    have h0 : j 0 < n := by simpa using h 0 (by simp)
    have h1 := rmPos_lt ns (fun i => j (i + 1)) (fun i hi => by simpa using h (i + 1) (by simp; omega))
    have : (j 0 + 1) * ns.prod ≤ n * ns.prod := Nat.mul_le_mul_right _ h0
    nlinarith

theorem rmPos_unrk : ∀ (s : List ℕ) (q : ℕ), q < s.prod → rmPos s (unrk s q) = q
  | [], q, h => by simp at h; simp [rmPos]; omega
  | n :: ns, q, h => by
    simp only [rmPos, unrk, if_pos rfl]
    have hp : 0 < ns.prod := by
      rcases Nat.eq_zero_or_pos ns.prod with h0 | h0
      · simp [List.prod_cons, h0] at h
      · exact h0
    have e := rmPos_unrk ns (q % ns.prod) (Nat.mod_lt _ hp)
    have e2 : rmPos ns (fun i => if i + 1 = 0 then q / ns.prod else unrk ns (q % ns.prod) (i + 1 - 1))
        = rmPos ns (unrk ns (q % ns.prod)) := rmPos_congr _ _ _ (fun i _ => by simp)
    rw [e2, e]
    exact Nat.div_add_mod' q ns.prod

theorem unrk_lt : ∀ (s : List ℕ) (q : ℕ), q < s.prod → ∀ i < s.length, unrk s q i < s.getD i 1
  | [], _, _, i, hi => by simp at hi
  | n :: ns, q, h, i, hi => by
    have hp : 0 < ns.prod := by
      rcases Nat.eq_zero_or_pos ns.prod with h0 | h0
      · simp [List.prod_cons, h0] at h
      · exact h0
    rcases i with _ | i
    · simp only [unrk, List.getD_cons_zero, if_true]
      rw [Nat.div_lt_iff_lt_mul hp]; simpa [List.prod_cons] using h
    · simp only [unrk, List.getD_cons_succ, Nat.add_sub_cancel]
      simp only [Nat.add_eq_zero_iff, one_ne_zero, and_false, if_false]
      exact unrk_lt ns _ (Nat.mod_lt _ hp) i (by simpa using hi)

theorem map_range_mul {α : Type*} (n P : ℕ) (g : ℕ → α) :
    (List.range (n * P)).map g = (List.range n).flatMap (fun i => (List.range P).map (fun q => g (i * P + q))) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Nat.succ_mul, List.range_add, List.map_append, ih, List.range_succ, List.flatMap_append]
    simp [List.map_map, Function.comp_def]

/-- `listOf` as a map over row-major positions. -/
theorem listOf_eq : ∀ {α : Type*} (s : List ℕ) (f : (ℕ → ℕ) → α),
    listOf s f = (List.range s.prod).map (fun q => f (unrk s q))
  | _, [], f => by
    simp only [listOf, boxIdxs, List.prod_nil, List.range_one, List.map_cons, List.map_nil]
    congr 2
  | _, n :: ns, f => by
    have hb : listOf (n :: ns) f = (List.range n).flatMap
        (fun i => listOf ns (fun g => f (fun k => if k = 0 then i else g (k - 1)))) := by
      simp only [listOf, boxIdxs, List.map_flatMap, List.map_map]
      congr 1; funext i; congr 1; funext l
      simp only [Function.comp_apply]
      congr 1; funext k
      rcases k with _ | k <;> simp
    rw [hb, List.prod_cons, map_range_mul]
    congr 1; funext i
    rw [listOf_eq ns]
    rcases Nat.eq_zero_or_pos ns.prod with h0 | h0
    · simp only [h0, List.range_zero, List.map_nil]
    apply List.map_congr_left
    intro q hq
    rw [List.mem_range] at hq
    congr 1; funext k
    simp only [unrk]
    have e1 : (i * ns.prod + q) / ns.prod = i := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ h0, Nat.div_eq_of_lt hq, zero_add]
    have e2 : (i * ns.prod + q) % ns.prod = q := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hq]
    rcases k with _ | k
    · simp [e1]
    · simp [e2]

theorem rmPos_inj : ∀ (s : List ℕ) (j j' : ℕ → ℕ), (∀ x ∈ s, 0 < x) →
    (∀ i < s.length, j i < s.getD i 1) → (∀ i < s.length, j' i < s.getD i 1) →
    rmPos s j = rmPos s j' → ∀ i < s.length, j i = j' i
  | [], _, _, _, _, _, _, i, hi => by simp at hi
  | n :: ns, j, j', hpos, hj, hj', he, i, hi => by
    simp only [rmPos] at he
    have hp : 0 < ns.prod := List.prod_pos (fun x hx => hpos x (by simp [hx]))
    have b1 := rmPos_lt ns (fun i => j (i + 1)) (fun i hi => by simpa using hj (i + 1) (by simp; omega))
    have b2 := rmPos_lt ns (fun i => j' (i + 1)) (fun i hi => by simpa using hj' (i + 1) (by simp; omega))
    have d1 : (j 0 * ns.prod + rmPos ns (fun i => j (i + 1))) / ns.prod = j 0 := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hp, Nat.div_eq_of_lt b1, zero_add]
    have d2 : (j' 0 * ns.prod + rmPos ns (fun i => j' (i + 1))) / ns.prod = j' 0 := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hp, Nat.div_eq_of_lt b2, zero_add]
    have m1 : (j 0 * ns.prod + rmPos ns (fun i => j (i + 1))) % ns.prod = rmPos ns (fun i => j (i + 1)) := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt b1]
    have m2 : (j' 0 * ns.prod + rmPos ns (fun i => j' (i + 1))) % ns.prod = rmPos ns (fun i => j' (i + 1)) := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt b2]
    rcases i with _ | i
    · rw [← d1, ← d2, he]
    · have := rmPos_inj ns (fun i => j (i + 1)) (fun i => j' (i + 1))
        (fun x hx => hpos x (by simp [hx]))
        (fun i hi => by simpa using hj (i + 1) (by simp; omega))
        (fun i hi => by simpa using hj' (i + 1) (by simp; omega))
        (by rw [← m1, ← m2, he]) i (by simpa using hi)
      exact this

theorem getD_pos {s : List ℕ} (h : ∀ x ∈ s, 0 < x) (i : ℕ) : 0 < s.getD i 1 := by
  rcases lt_or_ge i s.length with hi | hi
  · rw [List.getD_eq_getElem _ _ hi]; exact h _ (List.getElem_mem _)
  · rw [List.getD_eq_default _ _ hi]; omega

theorem resJ_lt {s : List ℕ} (h : ∀ x ∈ s, 0 < x) (k i : ℕ) : resJ s k i < s.getD i 1 :=
  Nat.mod_lt _ (getD_pos h i)

theorem crtKey_lt {s : List ℕ} (h : ∀ x ∈ s, 0 < x) (k : ℕ) : crtKey s k < s.prod :=
  rmPos_lt s _ (fun i _ => resJ_lt h k i)

theorem crtKey_inj {s : List ℕ} (h : CrtOK s) {k k' : ℕ} (hk : k < s.prod) (hk' : k' < s.prod)
    (he : crtKey s k = crtKey s k') : k = k' := by
  have hr := rmPos_inj s _ _ h.2 (fun i _ => resJ_lt h.2 k i) (fun i _ => resJ_lt h.2 k' i) he
  have hm : k ≡ k' [MOD s.prod] := by
    rw [Nat.modEq_list_prod_iff h.1]
    intro i
    have := hr i i.2
    simp only [resJ, List.getD_eq_getElem _ _ i.2] at this
    exact this
  rw [Nat.ModEq, Nat.mod_eq_of_lt hk, Nat.mod_eq_of_lt hk'] at hm
  exact hm

theorem keyL_nodup {s : List ℕ} (h : CrtOK s) : (keyL s).Nodup := by
  refine List.Nodup.map_on ?_ List.nodup_range
  intro x hx y hy hxy
  exact crtKey_inj h (List.mem_range.1 hx) (List.mem_range.1 hy) hxy

theorem perm_range_of_nodup {l : List ℕ} (hd : l.Nodup) (hlt : ∀ x ∈ l, x < l.length) :
    l.Perm (List.range l.length) := by
  have hs : l.Subperm (List.range l.length) :=
    hd.subperm (fun x hx => List.mem_range.2 (hlt x hx))
  exact hs.perm_of_length_le (by simp)

theorem keyL_length (s : List ℕ) : (keyL s).length = s.prod := by simp [keyL]

theorem keyL_perm {s : List ℕ} (h : CrtOK s) : (keyL s).Perm (List.range s.prod) := by
  have := perm_range_of_nodup (keyL_nodup h) (fun x hx => by
    rw [keyL_length]
    simp only [keyL, List.mem_map] at hx
    obtain ⟨k, _, rfl⟩ := hx
    exact crtKey_lt h.2 k)
  rwa [keyL_length] at this

theorem prod_split (s : List ℕ) (i : ℕ) (hi : i < s.length) :
    s.prod = s[i] * ((s.take i).prod * (s.drop (i + 1)).prod) := by
  rw [← List.prod_take_mul_prod_drop s i, List.drop_eq_getElem_cons hi, List.prod_cons]; ring

theorem prod_div_getD (s : List ℕ) (h : ∀ x ∈ s, 0 < x) (i : ℕ) (hi : i < s.length) :
    s.prod / s.getD i 1 = (s.take i).prod * (s.drop (i + 1)).prod := by
  rw [List.getD_eq_getElem _ _ hi, prod_split s i hi]
  exact Nat.mul_div_cancel_left _ (h _ (List.getElem_mem _))

theorem coprime_others {s : List ℕ} (h : CrtOK s) (i : ℕ) (hi : i < s.length) :
    Nat.Coprime ((s.take i).prod * (s.drop (i + 1)).prod) s[i] := by
  have hp := List.pairwise_iff_getElem.1 h.1
  apply Nat.Coprime.mul_left
  · rw [Nat.coprime_list_prod_left_iff]
    intro a ha
    obtain ⟨p, hp', rfl⟩ := List.mem_iff_getElem.1 ha
    simp only [List.length_take] at hp'
    rw [List.getElem_take]
    exact hp p i (by omega) hi (by omega)
  · rw [Nat.coprime_list_prod_left_iff]
    intro a ha
    obtain ⟨p, hp', rfl⟩ := List.mem_iff_getElem.1 ha
    simp only [List.length_drop] at hp'
    rw [List.getElem_drop]
    exact (hp i (i + 1 + p) hi (by omega) (by omega)).symm

theorem dvd_others {s : List ℕ} (h : CrtOK s) (i m : ℕ) (hi : i < s.length) (hm : m < s.length)
    (hne : m ≠ i) : s[i] ∣ (s.take m).prod * (s.drop (m + 1)).prod := by
  have hp := List.pairwise_iff_getElem.1 h.1
  have hcop : Nat.Coprime s[i] s[m] := by
    rcases lt_or_gt_of_ne hne with hlt | hlt
    · exact (hp m i hm hi hlt).symm
    · exact hp i m hi hm hlt
  have hdvd : s[i] ∣ s[m] * ((s.take m).prod * (s.drop (m + 1)).prod) := by
    rw [← prod_split s m hm]; exact List.dvd_prod (List.getElem_mem _)
  exact hcop.dvd_of_dvd_mul_left hdvd

theorem crtCoef_zmod {s : List ℕ} (h : CrtOK s) (i m : ℕ) (hi : i < s.length) (hm : m < s.length) :
    ((crtCoef s m : ℕ) : ZMod s[i]) = if m = i then 1 else 0 := by
  have hpos : 0 < s[i] := h.2 _ (List.getElem_mem _)
  have : NeZero s[i] := ⟨by omega⟩
  unfold crtCoef
  rw [prod_div_getD s h.2 m hm]
  split_ifs with hmi
  · subst hmi
    rw [List.getD_eq_getElem _ _ hm]
    rw [Nat.cast_mul, ZMod.natCast_zmod_val]
    exact ZMod.coe_mul_inv_eq_one _ (coprime_others h m hm)
  · rw [Nat.cast_mul, (ZMod.natCast_eq_zero_iff _ _).2 (dvd_others h i m hi hm hmi), zero_mul]

theorem sum_range_zmod {n : ℕ} (N : ℕ) (f : ℕ → ℕ) :
    (((List.range N).map f).sum : ZMod n) = ∑ m ∈ Finset.range N, (f m : ZMod n) := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [List.range_succ, List.map_append, List.sum_append, Finset.sum_range_succ, Nat.cast_add, ih]
    simp

theorem crtIdx_mod {s : List ℕ} (h : CrtOK s) (j : ℕ → ℕ) (i : ℕ) (hi : i < s.length) :
    crtIdx s j % s[i] = j i % s[i] := by
  have hpos : 0 < s[i] := h.2 _ (List.getElem_mem _)
  have hdvd : s[i] ∣ s.prod := List.dvd_prod (List.getElem_mem _)
  unfold crtIdx
  rw [Nat.mod_mod_of_dvd _ hdvd]
  rw [← ZMod.natCast_eq_natCast_iff']
  rw [sum_range_zmod]
  rw [Finset.sum_eq_single i]
  · push_cast; rw [crtCoef_zmod h i i hi hi, if_pos rfl, mul_one]
  · intro m hm hmi
    push_cast; rw [crtCoef_zmod h i m hi (Finset.mem_range.1 hm), if_neg hmi, mul_zero]
  · intro hn; exact absurd (Finset.mem_range.2 hi) hn

theorem prod_pos' {s : List ℕ} (h : ∀ x ∈ s, 0 < x) : 0 < s.prod := List.prod_pos h

theorem crtIdx_lt {s : List ℕ} (h : ∀ x ∈ s, 0 < x) (j : ℕ → ℕ) : crtIdx s j < s.prod :=
  Nat.mod_lt _ (prod_pos' h)

theorem crtKey_crtIdx {s : List ℕ} (h : CrtOK s) (q : ℕ) (hq : q < s.prod) :
    crtKey s (crtIdx s (unrk s q)) = q := by
  unfold crtKey
  rw [rmPos_congr s _ (unrk s q), rmPos_unrk s q hq]
  intro i hi
  simp only [resJ, List.getD_eq_getElem _ _ hi]
  rw [crtIdx_mod h _ i hi, Nat.mod_eq_of_lt]
  have := unrk_lt s q hq i hi
  rwa [List.getD_eq_getElem _ _ hi] at this

theorem keyL_getElem (s : List ℕ) (k : ℕ) (hk : k < (keyL s).length) : (keyL s)[k] = crtKey s k := by
  simp [keyL]

theorem keyL_idxOf {s : List ℕ} (h : CrtOK s) (q : ℕ) (hq : q < s.prod) :
    (keyL s).idxOf q = crtIdx s (unrk s q) := by
  have hl : crtIdx s (unrk s q) < (keyL s).length := by rw [keyL_length]; exact crtIdx_lt h.2 _
  have e : (keyL s)[crtIdx s (unrk s q)] = q := by rw [keyL_getElem]; exact crtKey_crtIdx h q hq
  conv_lhs => rw [← e]
  exact List.Nodup.idxOf_getElem (keyL_nodup h) _ hl

theorem flatten_map_single {α β : Type*} (l : List α) (g : α → β) :
    (l.map fun q => [g q]).flatten = l.map g := by
  induction l with
  | nil => rfl
  | cons a l ih => simp [ih]

theorem permL_single (Kl : List ℕ) (D : List ℤ) (hK : ∀ q < Kl.length, Kl.idxOf q < D.length) :
    (permL Kl (D.map fun x => [x])).flatten = (List.range Kl.length).map (fun q => D.getD (Kl.idxOf q) 0) := by
  unfold permL
  have e : (List.range Kl.length).map (fun q => (D.map fun x => [x]).getD (Kl.idxOf q) []) =
      (List.range Kl.length).map (fun q => [D.getD (Kl.idxOf q) 0]) := by
    apply List.map_congr_left
    intro q hq
    have := hK q (List.mem_range.1 hq)
    rw [List.getD_eq_getElem _ _ (by simpa using this), List.getD_eq_getElem _ _ this]
    simp
  rw [e, flatten_map_single]

theorem padL_length (c : List ℤ) (n : ℕ) (h : c.length ≤ n) : (padL c n).length = n := by
  simp [padL]; omega

theorem padL_getD (c : List ℤ) (n k : ℕ) : (padL c n).getD k 0 = c.getD k 0 := by
  unfold padL
  rcases lt_or_ge k c.length with hk | hk
  · rw [List.getD_append _ _ _ _ hk]
  · rw [List.getD_append_right _ _ _ _ hk, List.getD_eq_default _ _ hk]
    rcases lt_or_ge (k - c.length) (n - c.length) with h2 | h2
    · rw [List.getD_eq_getElem _ _ (by simpa using h2)]; simp
    · rw [List.getD_eq_default _ _ (by simpa using h2)]

/-- **`crtIn` is the permutation of the padded digits by `keyL`.** -/
theorem crtIn_perm {s : List ℕ} (h : CrtOK s) (c : List ℤ) (hc : c.length ≤ s.prod) :
    (permL (keyL s) ((padL c s.prod).map fun x => [x])).flatten = crtIn s c := by
  rw [permL_single, keyL_length, crtIn, listOf_eq]
  · apply List.map_congr_left
    intro q hq
    rw [keyL_idxOf h q (List.mem_range.1 hq), ← padL_getD c s.prod]
  · intro q hq
    rw [keyL_length] at hq
    rw [keyL_idxOf h q hq, padL_length c _ hc]
    exact crtIdx_lt h.2 _

end NLogN.CR

end

