theorem solution (m : TypeDensity.ConcreteMember) (c : m.toMeasured.cellIndex) :
    MeasurableSet (m.toMeasured.cell c) := by
  have hcov := m.atlas.cover
  have hsub : m.toMeasured.cell c ⊆ ⋃ i, Set.range (TypeDensity.coordinateIdeal (O := m.O) (R := m.R) m.S.pi
      (m.atlas.chart i).f (m.atlas.chart i).b) := by
    intro J hJ
    obtain ⟨i, hi⟩ := Set.mem_iUnion.1 (hcov.subset hJ.1)
    exact Set.mem_iUnion.2 ⟨i, (Set.ext_iff.1 (TypeDensity.concrete_member_charts m i).2.1 J).2 hi⟩
  rw [← Set.inter_eq_left.2 hsub, Set.inter_iUnion]
  refine MeasurableSet.iUnion fun i => ?_
  have hirr : Irreducible m.S.pi := m.toMeasured.S.pi_irreducible
  obtain ⟨reps, hreps⟩ := TypeDensity.coordinate_coset_representatives_exist m.O m.S.pi hirr m.s.degree
      (m.toMeasured.cellDegree c)
  have hmax : Ideal.span {m.S.pi} = maximalIdeal m.O := (hirr.maximalIdeal_eq).symm
  have hb := TypeDensity.finite_coordinate_borel_cylinders m.O (maximalIdeal m.O) m.htop m.s.degree
  have hcoset : ∀ z₀ : Fin m.s.degree → m.O, MeasurableSet (TypeDensity.coordinateCoset m.S.pi
      (m.toMeasured.cellDegree c) z₀) := by
    intro z₀
    have h2 : @MeasurableSet _ (TypeDensity.adicCylinderSpace (maximalIdeal m.O) (Fin m.s.degree → m.O))
        (TypeDensity.coordinateCoset m.S.pi (m.toMeasured.cellDegree c) z₀) := by
      rw [← hmax]
      exact MeasurableSpace.measurableSet_generateFrom (Or.inr ⟨_, z₀, rfl⟩)
    rw [← hb] at h2
    exact h2
  have hf : Ideal.span {(m.atlas.chart i).f} ∈ TypeDensity.surfaceStateSet m.O m.R m.S m.s :=
    hcov.symm.subset (Set.mem_iUnion.2 ⟨i, ⟨_, rfl⟩, by rw [Ideal.map_span]; simp⟩)
  exact TypeDensity.fixed_tangent_cell_chart_measurable m.O m.R m.S m.s m.s.degree (m.atlas.chart i).b
    (m.atlas.chart i).f hf (TypeDensity.concrete_member_charts m i).1 (m.atlas.chart i).isDivisionChart _
    (m.toMeasured.cellDegree c) le_rfl _ reps hreps hcoset
