    rw [hc, hz.2, hb, hp.2, hm1.2]
    have h1 := hcc.2
    have h3 := hbc.2
    simp only [NLogN.Ex.size, List.length_drop, NLogN.Rsp.cycL_length, List.length_reverse, hol] at hzc hpc hm1c hm2c
    unfold NLogN.Rsp.resCost
    have : u.length + NR - NR = u.length := by omega
    rw [this] at hpc
    omega
  · rw [NLogN.Rsp.resL, hWs]; exact houtB
end
