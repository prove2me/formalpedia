theorem PositivityTheory.PfBern.Frob.avg_lift (b0 : SB H) (hb0 : ∫ y, (b0 : H → ℂ) y ∂μH = 1) (f : SB X) :
    avg hp σ hpc μH (pullHomeo (triv hp σ hpc).symm (tens f b0)) = f := by sorry
