theorem _root_.solution {s : Set X} {t : TileSet ps ιₜ}
    (h : t.FiniteIntersectionsOn s) : t.FiniteDistinctIntersectionsOn s := by
  intro x hx
  convert Set.Finite.image t (h x hx) using 1
  ext pt
  simp only [Set.mem_ofPred_eq, Set.mem_image, TileSet.mem_def]
  refine ⟨fun ⟨⟨i, hi⟩, hx⟩ ↦ ?_, fun ⟨i, ⟨hx, hi⟩⟩ ↦ ?_⟩
  · subst hi
    exact ⟨i, hx, rfl⟩
  · subst hi
    exact ⟨⟨i, rfl⟩, hx⟩
end FiniteIntersectionsOn
