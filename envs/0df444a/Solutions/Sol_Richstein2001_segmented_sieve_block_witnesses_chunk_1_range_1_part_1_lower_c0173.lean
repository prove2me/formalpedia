    Nat.beq (Nat.add (Nat.mul R (Nat.div (Nat.sub q 1) R)) 1) q &&
    Nat.beq (Nat.mul (prodP ps) (Nat.div (Nat.div (Nat.sub q 1) R) (prodP ps))) (Nat.div (Nat.sub q 1) R) &&
    Nat.blt q (Nat.mul (Nat.add (Nat.div (Nat.sub q 1) R) 1) (Nat.add (Nat.div (Nat.sub q 1) R) 1)) &&
    fOK (Nat.div (Nat.div (Nat.sub q 1) R) (prodP ps)) && ps.all (fun pr => fOK pr.1) &&
    Nat.beq (pw6 q (pw3 q a R) (Nat.div (Nat.sub q 1) R)) 1 &&
    zOK q (pw3 q a R) (Nat.div (Nat.sub q 1) R) (Nat.div (Nat.div (Nat.sub q 1) R) (prodP ps)) &&
    ps.all (fun pr => zOK q (pw3 q a R) (Nat.div (Nat.sub q 1) R) pr.1)

