    simp only [if_neg x45, if_neg x3, if_neg x41, if_neg x40, if_neg x0, ht2, ht1, IState.upd_G,
      run_push_G]
    rw [tG x x43, NLogN.pSt_G_other _ _ _ _ _ _ _ _ x0 x3 x40 x41 x45,
      NLogN.pSt_G_other _ _ _ _ _ _ _ _ x0 x3 x40 x41 x45]

theorem pflat_length (d : ℕ) (Kl : List ℕ) (D : List (List ℤ)) (hDw : ∀ r ∈ D, r.length = d) :
    ∀ p, p ≤ D.length → (pflat Kl D p).length = p * (d + 1)
  | 0, _ => by simp [pflat]
  | p + 1, h => by
    rw [pflat_succ, List.length_append, pflat_length d Kl D hDw p (by omega)]
    simp only [pRec, List.length_cons, List.getD_eq_getElem _ _ (by omega : p < D.length),
      hDw _ (List.getElem_mem _)]
    ring

theorem p_states (d n : ℕ) (Kl : List ℕ) (D : List (List ℤ)) (Rest RK : List Item) (s : IState HS)
    (hKl : Kl.length = n) (hD : D.length = n) (hDw : ∀ r ∈ D, r.length = d)
    (L1 : List Item) (h1 : s.G 1 = .int n :: L1) :
    RepStates 43 (.reg 1) (pBody d) (NLogN.pSt s Kl D Rest RK d 0) (NLogN.pSt s Kl D Rest RK d) where
  nonneg := by
    have g : (NLogN.pSt s Kl D Rest RK d 0).G 1 = .int n :: L1 := by
      rw [NLogN.pSt_G_other s Kl D Rest RK d 0 1 (by decide) (by decide) (by decide) (by decide)
        (by decide), h1]
    simp [Ex.eval, IState.top_eq g]
  hw := by simp (config := {decide := true}) [pBody, mvK, RS.writes]
  h0 := rfl
  hG := fun j => by
    rw [NLogN.pSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide),
      NLogN.pSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)]
  step := by
    intro p hp
    have g : (NLogN.pSt s Kl D Rest RK d 0).G 1 = .int n :: L1 := by
      rw [NLogN.pSt_G_other s Kl D Rest RK d 0 1 (by decide) (by decide) (by decide) (by decide)
        (by decide), h1]
    have e : (Ex.reg (S := HS) 1).eval (NLogN.pSt s Kl D Rest RK d 0) = n := by
      simp [Ex.eval, IState.top_eq g]
    rw [e, Int.toNat_natCast] at hp ⊢
    exact (p_step d n Kl D Rest RK s hKl hD hDw _ _ p hp).2

theorem pAttachP_spec (d n : ℕ) (Kl : List ℕ) (D : List (List ℤ)) (Rest RK : List Item)
    (s : IState HS) (hKl : Kl.length = n) (hD : D.length = n) (hDw : ∀ r ∈ D, r.length = d)
    (L1 : List Item) (h0 : s.G 0 = ints D.flatten ++ Rest) (h1 : s.G 1 = .int n :: L1)
    (h3 : s.G 3 = natInts Kl ++ RK) :
    (pAttachP d).ok s ∧ (pAttachP d).run s = s.upd 0 (ints (pflat Kl D n) ++ Rest) := by
  have H := p_states d n Kl D Rest RK s hKl hD hDw L1 h1
  have g1 : (NLogN.pSt s Kl D Rest RK d 0).G 1 = .int n :: L1 := by
    rw [NLogN.pSt_G_other s Kl D Rest RK d 0 1 (by decide) (by decide) (by decide) (by decide)
      (by decide), h1]
  have e1 : (Ex.reg (S := HS) 1).eval (NLogN.pSt s Kl D Rest RK d 0) = n := by
    simp [Ex.eval, IState.top_eq g1]
  have hz : (push 45 (.lit 0)).run s = NLogN.pSt s Kl D Rest RK d 0 := by
    apply IState.ext' _ (by simp [NLogN.pSt]) (by simp [NLogN.pSt])
    intro x
    simp only [NLogN.pSt, IState.upd_G, run_push_G, Ex.eval]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [h0]
    by_cases x3 : x = 3
    · subst x3; simp (config := {decide := true}) [h3]
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true}) [pflat]
    by_cases x41 : x = 41
    · subst x41; simp (config := {decide := true}) [natInts]
    split_ifs <;> simp_all
  have hloop : (pLoop d).run (NLogN.pSt s Kl D Rest RK d 0) = NLogN.pSt s Kl D Rest RK d n := by
    rw [pLoop, H.run, e1, Int.toNat_natCast]
  set t := NLogN.pSt s Kl D Rest RK d n with ht
  have hpl := pflat_length d Kl D hDw n (by omega)
  have t40 : t.G 40 = ints (pflat Kl D n).reverse ++ s.G 40 := by simp [ht, NLogN.pSt, ints_reverse]
  have t45 : t.G 45 = .int (((pflat Kl D n).reverse.length : ℕ) : ℤ) :: s.G 45 := by
    simp [ht, NLogN.pSt, hpl]
  have m1 := mvK_spec (X := 40) (Y := 0) (C := 51) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg 45) (clean_of_lt (by decide)) t _ (s.G 40) t40
    (IState.isInt_of t45) (by simp [Ex.eval, IState.top_eq t45])
  set t2 := (t.upd 40 (s.G 40)).upd 0 ((ints (pflat Kl D n).reverse).reverse ++ t.G 0) with ht2
  have u41 : t2.G 41 = ints (List.map (Nat.cast : ℕ → ℤ) Kl).reverse ++ s.G 41 := by
    simp only [ht2, IState.upd_G]
    simp (config := {decide := true}) [ht, NLogN.pSt, ← hKl, natInts, ints_reverse]
  have u1 : t2.G 1 = .int n :: L1 := by
    simp only [ht2, IState.upd_G]
    simp (config := {decide := true}) [ht, NLogN.pSt_G_other s Kl D Rest RK d n 1 (by decide)
      (by decide) (by decide) (by decide) (by decide), h1]
  have m2 := mvK_spec (X := 41) (Y := 3) (C := 51) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg 1) (clean_of_lt (by decide)) t2 _ (s.G 41) u41
    (IState.isInt_of u1) (by simp [Ex.eval, IState.top_eq u1, hKl])
  set t3 := (t2.upd 41 (s.G 41)).upd 3 ((ints (List.map (Nat.cast : ℕ → ℤ) Kl).reverse).reverse ++
    t2.G 3) with ht3
  have u45 : t3.G 45 = .int ((n * (d + 1) : ℕ) : ℤ) :: s.G 45 := by
    simp only [ht3, ht2, IState.upd_G]
    simp (config := {decide := true}) [ht, NLogN.pSt]
  refine ⟨⟨⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial⟩, ?_⟩, ?_⟩
  · rw [hz]
    refine ⟨H.ok (by decide) (clean_of_lt (by decide)) (IState.isInt_of g1) ?_, ?_⟩
    · intro p hp
      rw [e1, Int.toNat_natCast] at hp ⊢
      exact (p_step d n Kl D Rest RK s hKl hD hDw _ _ p hp).1
    · rw [hloop]
      refine ⟨m1.1, ?_⟩
      rw [m1.2]
      refine ⟨m2.1, ?_⟩
      rw [m2.2]
      exact ⟨by decide, IState.isInt_of u45⟩
  · simp only [pAttachP, run_seq]
    rw [hz, hloop, m1.2, m2.2]
    apply IState.ext' _ (by simp [ht3, ht2, ht, NLogN.pSt]) (by simp [ht3, ht2, ht, NLogN.pSt])
    intro x
    simp only [run_pop_G, IState.upd_G]
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [u45]
    simp only [if_neg x45]
    by_cases x3 : x = 3
    · subst x3
      simp (config := {decide := true}) [ht3, ht2, ht, NLogN.pSt, ← hKl, natInts, ints_reverse, h3]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [ht3, ht2, ht, NLogN.pSt, ← hD, ints_reverse]
    simp only [if_neg x3, if_neg x0, ht3, ht2, IState.upd_G]
    by_cases x41 : x = 41
    · subst x41; simp
    by_cases x40 : x = 40
    · subst x40; simp
    simp only [if_neg x41, if_neg x40]
    rw [ht, NLogN.pSt_G_other _ _ _ _ _ _ _ _ x0 x3 x40 x41 x45]

theorem perm_sorted (n kb : ℕ) (Kl : List ℕ) (D : List (List ℤ)) (hKl : Kl.length = n)
    (hK : Kl.Perm (List.range n)) (hN : n ≤ 2 ^ kb) :
    radixSort kb ((List.range n).map (pRec Kl D)) =
      (List.range n).map fun (q : ℕ) => (q : ℤ) :: D.getD (Kl.idxOf q) [] := by
  have hnd : Kl.Nodup := hK.nodup_iff.2 List.nodup_range
  have hmem : ∀ q, q ∈ Kl ↔ q < n := fun q => by rw [hK.mem_iff, List.mem_range]
  exact radixSort_keys kb n (fun p => Kl.getD p 0) (fun q => Kl.idxOf q) (fun p => D.getD p [])
    hN
    (fun p hp => by
      rw [List.getD_eq_getElem _ _ (by omega)]; exact (hmem _).1 (List.getElem_mem _))
    (fun q hq => by rw [← hKl]; exact List.idxOf_lt_length_iff.2 ((hmem q).2 hq))
    (fun q hq => by
      have h := List.idxOf_lt_length_iff.2 ((hmem q).2 hq)
      rw [List.getD_eq_getElem _ _ h, List.getElem_idxOf h])
    (fun p hp => by
      rw [List.getD_eq_getElem _ _ (by omega), List.Nodup.idxOf_getElem hnd])

end NLogN

end

section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS
theorem solution (d n kb : ℕ) (Kl : List ℕ) (D : List (List ℤ)) (Rest RK : List NLogN.Item)
    (s : NLogN.IState NLogN.HS) (hKl : Kl.length = n) (hK : Kl.Perm (List.range n)) (hD : D.length = n)
    (hDw : ∀ r ∈ D, r.length = d) (hN : n ≤ 2 ^ kb) (L1 L2 : List NLogN.Item)
    (h0 : s.G 0 = NLogN.ints D.flatten ++ Rest) (h1 : s.G 1 = .int n :: L1)
    (h2 : s.G 2 = .int kb :: L2) (h3 : s.G 3 = NLogN.natInts Kl ++ RK) :
    (NLogN.permP d).ok s ∧ (NLogN.permP d).run s = s.upd 0 (NLogN.ints (NLogN.permL Kl D).flatten ++ Rest) := by
  have hA := NLogN.pAttachP_spec d n Kl D Rest RK s hKl hD hDw L1 h0 h1 h3
  set s1 := s.upd 0 (NLogN.ints (NLogN.pflat Kl D n) ++ Rest) with hs1
  set K := (List.range n).map (NLogN.pRec Kl D) with hK'
  have hKw : ∀ r ∈ K, r.length = d + 1 := by
    intro r hr; simp only [hK', List.mem_map, List.mem_range] at hr
    obtain ⟨p, hp, rfl⟩ := hr
    simp only [NLogN.pRec, List.length_cons, List.getD_eq_getElem _ _ (by omega : p < D.length),
      hDw _ (List.getElem_mem _)]
  have hKl' : K.length = n := by simp [hK']
  have s10 : s1.G 0 = NLogN.ints K.flatten ++ Rest := by simp [hs1, hK', NLogN.pflat]
  have s11 : s1.G 1 = .int K.length :: L1 := by
    simp only [hs1, NLogN.IState.upd_G]; simp (config := {decide := true}) [hKl', h1]
  have s12 : s1.G 2 = .int kb :: L2 := by
    simp only [hs1, NLogN.IState.upd_G]; simp (config := {decide := true}) [h2]
  have hS := NLogN.sortP_spec (d + 1) kb s1 K Rest hKw (by omega) L1 L2 s10 s11 s12
  set S := NLogN.radixSort kb K with hSdef
  have hSe : S = (List.range n).map fun (q : ℕ) => (q : ℤ) :: D.getD (Kl.idxOf q) [] :=
    NLogN.perm_sorted n kb Kl D hKl hK hN
  have hSw : ∀ r ∈ S, r.length = d + 1 := fun r hr => hKw r ((NLogN.radixSort_perm kb K).subset hr)
  have hSl : S.length = n := by rw [(NLogN.radixSort_perm kb K).length_eq, hKl']
  set s2 := (NLogN.RS.push 45 (.lit 0)).run ((NLogN.RS.push 54 (.reg 1)).run (s1.upd 0 (NLogN.ints S.flatten ++ Rest)))
    with hs2
  have s254 : s2.G 54 = .int S.length :: s.G 54 := by
    simp only [hs2, NLogN.RS.run_push_G, NLogN.IState.upd_G]
    simp (config := {decide := true}) [hSl, NLogN.Ex.eval, NLogN.IState.top_eq s11, hKl', hs1]
    rw [NLogN.IState.top_eq (L := L1) (a := n)]; simp (config := {decide := true}) [h1]
  have s20 : s2.G 0 = NLogN.ints S.flatten ++ Rest := by
    simp only [hs2, NLogN.RS.run_push_G, NLogN.IState.upd_G]; simp (config := {decide := true})
  have s245 : s2.G 45 = .int 0 :: s.G 45 := by
    simp only [hs2, NLogN.RS.run_push_G, NLogN.IState.upd_G]; simp (config := {decide := true}) [NLogN.Ex.eval, hs1]
  have hP := NLogN.stripP_spec d S Rest s2 hSw (s.G 54) s254 s20 (NLogN.IState.isInt_of s245)
  set s3 := (s2.upd 0 (NLogN.ints (S.map List.tail).flatten ++ Rest)).upd 45
        (.int ((S.length * d : ℕ) : ℤ) :: (s2.G 45).tail) with hs3
  have s345 : s3.G 45 = .int ((S.length * d : ℕ) : ℤ) :: s.G 45 := by
    simp only [hs3, NLogN.IState.upd_G]; simp (config := {decide := true}) [s245]
  have s354 : ((NLogN.RS.pop 45).run s3).G 54 = .int S.length :: s.G 54 := by
    simp only [NLogN.RS.run_pop_G, hs3, NLogN.IState.upd_G]; simp (config := {decide := true}) [s254]
  have s354' : s3.G 54 = .int S.length :: s.G 54 := by
    simp only [hs3, NLogN.IState.upd_G]; simp (config := {decide := true}) [s254]
  have hT : S.map List.tail = NLogN.permL Kl D := by
    rw [hSe, NLogN.permL, List.map_map, hKl]; rfl
  refine ⟨⟨hA.1, ?_⟩, ?_⟩
  · rw [hA.2]
    refine ⟨hS.1, ?_⟩
    rw [hS.2]
    have g1 : (s1.upd 0 (NLogN.ints S.flatten ++ Rest)).G 1 = .int K.length :: L1 := by
      simp only [NLogN.IState.upd_G]; simp (config := {decide := true}) [s11]
    refine ⟨⟨by decide, NLogN.RS.clean_of_lt (by decide), NLogN.IState.isInt_of g1⟩, ⟨by decide, by intro i hi; simp [NLogN.Ex.regs] at hi,
      trivial⟩, ?_⟩
    rw [← hs2]
    refine ⟨hP.1, ?_⟩
    rw [hP.2]
    exact ⟨⟨by decide, NLogN.IState.isInt_of s345⟩, by decide, NLogN.IState.isInt_of s354⟩
  · simp only [NLogN.permP, NLogN.RS.run_seq]
    rw [hA.2, hS.2, ← hs2, hP.2]
    apply NLogN.IState.ext' _ (by simp [hs3, hs2, hs1]) (by simp [hs3, hs2, hs1])
    intro x
    simp only [NLogN.RS.run_pop_G, NLogN.IState.upd_G]
    by_cases x54 : x = 54
    · subst x54; simp (config := {decide := true}) [s354']
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [s345]
    simp only [if_neg x54, if_neg x45]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [hs3, hT]
    simp [hs3, hs2, hs1, x0, x45, x54]
end
