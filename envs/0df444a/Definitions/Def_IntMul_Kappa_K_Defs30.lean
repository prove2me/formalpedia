section
-- Source module: Solutions.KFV49Core
/-!
# KFV §52: the core of the Proposition 18 program (two arrays)

On a base `encK s fB` (registers in `fB`, `sT` free), with the data `zf` over `zg` on stack `0`:

`core = F ; shR 0 sT ; F ; shR sT 0 ; kronS ; O ; scaleS`

runs the forward layer program `F` on `f` (the top array), parks it on `sT`, runs `F` on `g`,
brings `f` back on top, multiplies pointwise (`kronS`), runs the opposite layer program `O` and
scales by `2^n`. **`core_runs`**: the result stores `(O (zipWith ppq (F xf) (F xg))).map (2^n • ·)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KIL KFD KFT KFB KFC KFH RS

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The core of the Proposition 18 program. -/
def core18 (cF cO : IStmt HS Pp) (pM : Fin Pp) : IStmt HS Pp :=
  .seq cF (.seq (fcode (shR 0 NLogN.KFV.sT)) (.seq cF (.seq (fcode (shR NLogN.KFV.sT 0)) (.seq (kronS pM)
    (.seq cO scaleS)))))

end NLogN.KFV

end

section
-- Source module: Solutions.KFV33LayLoop2
/-!
# KFV §36: phase 2 of the layout (the low bits) as a fixed IL loop

Iteration `k < b D` (`u = k / D`, `i = k mod D`) moves the bit at
`nL + k + i (qK + b - 1 - u) + qK` to `nL + k` (`mvB`). The count `b D` is pushed on `gT`, the
iteration index is `gI`. **`ph2_ok`**: the loop computes `runArr n 0 (ops2 …)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## The code -/

def eA2 : Ex HS := .add (.reg gNL) (.reg NLogN.KFV.gI)

def eU2 : Ex HS := .ndiv (.reg NLogN.KFV.gI) (.reg NLogN.KFV.gD)

def eQK : Ex HS := .mul (.reg gQq) (.reg gKk)

def eF2 : Ex HS :=
  .add (.mul (.nmod (.reg NLogN.KFV.gI) (.reg NLogN.KFV.gD)) (.add eQK (.add (.reg gBb) (.add (.lit (-1)) (.neg eU2)))))
    eQK

def stepI : RS := .asg NLogN.KFV.gI (.add (.reg NLogN.KFV.gI) (.lit 1))

def body2 : IStmt HS Pp := .seq (mvB eA2 eF2 (eCm eA2 eF2)) (fcode stepI)

def ph2 : IStmt HS Pp :=
  .seq (fcode (.seq (.push NLogN.KFV.gT (.mul (.reg gBb) (.reg NLogN.KFV.gD))) (.push NLogN.KFV.gI (.lit 0))))
    (.seq (KFT.rptX NLogN.KFV.gT fA NLogN.KFV.fC fD body2) (fcode (.seq (.pop NLogN.KFV.gI) (.pop NLogN.KFV.gT))))

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

/-- The loop frame of phase 2. -/
def F2 (N k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (fun _ => []) NLogN.KFV.gT [(N : ℤ)]) NLogN.KFV.gI [(k : ℤ)]

def op2 (k : ℕ) : LOp := LOp.mv (nLong D long + k) (nLong D long + k + dl2 D ℓ K k)

noncomputable def cBody2 (n W B : ℕ) (k : ℕ) : ℕ :=
  cMvB eA2 eF2 (eCm eA2 eF2) (nLong D long + k) (dl2 D ℓ K k)
    (n - (nLong D long + k + dl2 D ℓ K k) + ℓ) W B +
    (((Ex.reg NLogN.KFV.gI).add (Ex.lit 1)).size + 1) * 10 ^ 7 * (B + 2) ^ 2

/-- Cost of phase 2. -/
noncomputable def cPh2 (n W B : ℕ) : ℕ :=
  (4 * 10 ^ 7 * (B + 2) ^ 2 + 2 * 10 ^ 7 * (B + 2) ^ 2) +
    ((∑ k ∈ Finset.range (bb ℓ K * D), (cBody2 D ℓ K long n W B k + 64)) + 60 + cRpt (bb ℓ K * D) +
      (dupCost (zsz ((bb ℓ K * D : ℕ) : ℤ)) + 17)) + 2 * (2 * B + 2)

end Paper

end NLogN.KFV

end

section
-- Source module: Solutions.KFV30LayX
/-!
# KFV §33: the chunk exchange as fixed IL code

* `SwOK I iprog eSw dW Kc`: the uniform Lemma 12 entry (`KFM.SwapNeed` in a given table).
* `pushL i es`, `popN i m`: push a list of expressions onto `i` / pop `m` entries.
* `xchC eSw dW eE eK eM eI eW`: push the descriptor
  `descSw W K 1 3 [2^i, 2^K, 2^m, 2^K, 2^E]`, call the entry, pop it.
  **`xchC_run`**: the exchange `xch i j K` (`m = j - i - K`, `E = n - j - K + ℓ`) on the stored
  records.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The uniform Lemma 12 entry `eSw` (descriptor on `dW`). -/
def SwOK (I : List Sym) (iprog : Fin Pp → IStmt HS Pp) (eSw : Fin Pp) (dW : Fin HS) (Kc : ℝ) :
    Prop :=
  ∀ (u w : ℕ) (sh : Shape) (p q : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) →
    p < q → q < sh.length → sh.getD p 0 = 2 ^ u → sh.getD q 0 = 2 ^ u →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dW → f j = []) →
    f dW = KFM.descSw w u p q sh →
    f 0 = gflat zs ++ l → zs.length = vol sh → NLogN.KFB.GB w zs →
    ∃ c : ℕ, IRuns I iprog (.call eSw) (encK s f)
        (encK s (Function.update f 0 (gflat (pull sh sh (swapPos p q) 0 zs) ++ l))) c ∧
      (c : ℝ) ≤ Kc * (((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ KFS.τS +
        (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ))

/-! ## Pushing and popping lists -/

def pushL (i : Fin HS) : List (Ex HS) → RS
  | [] => .skip
  | e :: es => .seq (.push i e) (pushL i es)

def popN (i : Fin HS) : ℕ → RS
  | 0 => .skip
  | m + 1 => .seq (.pop i) (popN i m)

/-- Cost of a list of pushes. -/
def cPushL (B : ℕ) (es : List (Ex HS)) : ℕ := (es.map fun e => (e.size + 1) * 10 ^ 7 * (B + 2) ^ 2).sum + 1

/-! ## The exchange -/

/-- The descriptor pushes (`2^E` first, `W` last on top). -/
def xchEs (eE eK eM eI eW : Ex HS) : List (Ex HS) :=
  [.pow2 eE, .pow2 eK, .pow2 eM, .pow2 eK, .pow2 eI, .lit 5, .lit 3, .lit 1, eK, eW]

/-- **The chunk exchange.** -/
def xchC (eSw : Fin Pp) (dW : Fin HS) (eE eK eM eI eW : Ex HS) : IStmt HS Pp :=
  .seq (fcode (NLogN.KFV.pushL dW (xchEs eE eK eM eI eW))) (.seq (.call eSw) (fcode (popN dW 10)))

/-- The 5-field shape of the exchange. -/
def sh5 (i K m E : ℕ) : Shape := [2 ^ i, 2 ^ K, 2 ^ m, 2 ^ K, 2 ^ E]

/-- Cost of an exchange. -/
noncomputable def cXch (Kc : ℝ) (eE eK eM eI eW : Ex HS) (n ℓ K W B : ℕ) : ℕ :=
  cPushL B (xchEs eE eK eM eI eW) +
    ⌈Kc * (((W : ℝ) + 1) * ((2 ^ (n + ℓ) : ℕ) + 1) * (K : ℝ) ^ KFS.τS +
      (((5 + 1) * (Nat.size (2 ^ (n + ℓ)) + W + K + 1) ^ 2 : ℕ) : ℝ))⌉₊ + (10 * (2 * B + 2) + 1)

/-- Expressions not reading `dW`. -/
def DSafe (dW : Fin HS) (e : Ex HS) : Prop := e.Clean ∧ ∀ r ∈ e.regs, r ≠ dW

end NLogN.KFV

end

section
-- Source module: Solutions.KFV34LayLoop3
/-!
# KFV §37: phase 3 of the layout (the chunk exchanges) as a fixed IL loop

Iteration `t < N = D q`: the chase `x ← src t; N times (x ← src x while x < t)` runs in the
register `gV` (an `RS` counter loop on `gT2`), then, unless `x = t`, the chunks `t` and `x`
(after the prefix `Lst`) are exchanged by the Lemma 12 entry (`xchC`).
**`ph3_ok`**: the loop computes `runArr n 0 (ops3 …)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Selections -/

/-! ## The code -/

/-- `src y = (y mod D) q + y / D`. -/
def srcE (y : Ex HS) : Ex HS := .add (.mul (.nmod y (.reg NLogN.KFV.gD)) (.reg gQq)) (.ndiv y (.reg NLogN.KFV.gD))

/-- One chase step. -/
def chStep : RS := .asg NLogN.KFV.gV (.sel (.add (.reg NLogN.KFV.gV) (.neg (.reg NLogN.KFV.gI))) (NLogN.KFV.srcE (.reg NLogN.KFV.gV)) (.reg NLogN.KFV.gV))

/-- The chase. -/
def chase : RS := .seq (.push NLogN.KFV.gV (NLogN.KFV.srcE (.reg NLogN.KFV.gI))) (.rep gT2 (.reg NLogN.KFV.gT) chStep)

/-- `x - t - 1`. -/
def eCnd : Ex HS := .add (.add (.reg NLogN.KFV.gV) (.neg (.reg NLogN.KFV.gI))) (.lit (-1))

/-- `i = |Lst| + t K`. -/
def eI3 : Ex HS := .add (.reg gLst) (.mul (.reg NLogN.KFV.gI) (.reg gKk))

/-- `j - i - K = (x - t - 1) K`. -/
def eM3 : Ex HS := .mul eCnd (.reg gKk)

/-- `n - j - K + ℓ`, `j = |Lst| + x K`. -/
def eE3 : Ex HS :=
  .add (.add (.reg gNn) (.neg (.add (.reg gLst) (.mul (.add (.reg NLogN.KFV.gV) (.lit 1)) (.reg gKk)))))
    (.reg gLl)

def post3 : RS := .seq (.pop NLogN.KFV.gV) stepI

def body3 (eSw : Fin Pp) (dW : Fin HS) : IStmt HS Pp :=
  .seq (fcode chase)
    (.seq (iteI eCnd .skip (xchC eSw dW eE3 (.reg gKk) eM3 eI3 (.reg gWw))) (fcode post3))

def ph3 (eSw : Fin Pp) (dW : Fin HS) : IStmt HS Pp :=
  .seq (fcode (.seq (.push NLogN.KFV.gT (.mul (.reg NLogN.KFV.gD) (.reg gQq))) (.push NLogN.KFV.gI (.lit 0))))
    (.seq (KFT.rptX NLogN.KFV.gT fA NLogN.KFV.fC fD (body3 eSw dW)) (fcode (.seq (.pop NLogN.KFV.gI) (.pop NLogN.KFV.gT))))

/-! ## The chase -/

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

/-- The source of a chunk position. -/
abbrev srcP : ℕ → ℕ := srcT D (qq ℓ K)

/-- The chase value after `j` steps. -/
def xC (t j : ℕ) : ℕ := chF (NLogN.KFV.srcP D ℓ K) t j (NLogN.KFV.srcP D ℓ K t)

/-- The cost of one chase step. -/
def cStep (B : ℕ) : ℕ :=
  (((Ex.sel (.add (.reg NLogN.KFV.gV) (.neg (.reg NLogN.KFV.gI))) (NLogN.KFV.srcE (.reg NLogN.KFV.gV)) (.reg NLogN.KFV.gV)) : Ex HS).size + 1) *
    10 ^ 7 * (B + 2) ^ 2

/-- The cost of the chase. -/
def cChase (N B : ℕ) : ℕ :=
  ((NLogN.KFV.srcE (.reg NLogN.KFV.gI)).size + 1) * 10 ^ 7 * (B + 2) ^ 2 +
    (((Ex.reg NLogN.KFV.gT : Ex HS).size + 1) * 2000 * (B + 2) + N * (cStep B + 8000 * (B + 2) + 30) + 32)

/-- The exchanges of step `t`. -/
def opX (t : ℕ) : List LOp := opT (NLogN.KFV.srcP D ℓ K) (D * qq ℓ K) K (lstL D ℓ K long) t

/-- Cost of one phase-3 step. -/
noncomputable def cBody3 (Kc : ℝ) (n W B t : ℕ) : ℕ :=
  100 * cChase (D * qq ℓ K) B + cIteB eCnd.size B +
    (if xT (NLogN.KFV.srcP D ℓ K) (D * qq ℓ K) t = t then 1 else
      cXch Kc eE3 (.reg gKk) eM3 eI3 (.reg gWw) n ℓ K W B) +
    ((2 * B + 2) + (((Ex.reg NLogN.KFV.gI).add (Ex.lit 1)).size + 1) * 10 ^ 7 * (B + 2) ^ 2)

/-- The registers phase 3 reads. -/
def r3 : List (Fin HS) := [NLogN.KFV.gV, NLogN.KFV.gI, gLst, gKk, gNn, gLl, gWw]

/-- Cost of phase 3. -/
noncomputable def cPh3 (Kc : ℝ) (n W B : ℕ) : ℕ :=
  (4 * 10 ^ 7 * (B + 2) ^ 2 + 2 * 10 ^ 7 * (B + 2) ^ 2) +
    ((∑ t ∈ Finset.range (D * qq ℓ K), (cBody3 D ℓ K Kc n W B t + 64)) + 60 + cRpt (D * qq ℓ K) +
      (dupCost (zsz ((D * qq ℓ K : ℕ) : ℤ)) + 17)) + 2 * (2 * B + 2)

end Paper

end NLogN.KFV

end

section
-- Source module: Solutions.KFV35LayIn
/-!
# KFV §38: the layout-in program (three phases) as one `LayerU`

`layIn = ph1 ; ph2 ; ph3`. The three primitive lists are well formed (`ops1_wf`, `ops2_wf`,
`ops3_wf`), so the composed run is the `pull` by `relabel initL tgtL` (`runArr_eq_pull_init`,
`applyN_lay3`). **`layIn_ok`**.
