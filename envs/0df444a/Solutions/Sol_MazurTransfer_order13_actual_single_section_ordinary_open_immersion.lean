def inversionElement : candidateAlgebra R := pElement R + 2
abbrev adjustedLocalization := Localization.Away (inversionElement R)
abbrev ordinaryAdjustedLocalization := Localization.Away (p R + 2)

theorem inversionElement_coe : (inversionElement R : CoordinateRing R) = p R + 2 := rfl

theorem inclusion_inversion : inclusion R (inversionElement R) = p R + 2 := rfl

def adjustedLocalizedInclusion : adjustedLocalization R →ₐ[R] ordinaryAdjustedLocalization R := by
  letI : IsLocalization.Away (inclusion R (inversionElement R))
