-- Source module: Solutions.R6CxNetLoc
/-!
# Local chunk programs with code labels, generated and checked in the kernel

A `Spec` is a chunk to be performed at label code `V` on the listed wires (each wire not yet at
`V` is moved there) with elementary gates `(dst, src, k)` (`z_dst += (k/2) z_src`).
`progRun` generates the chunk list (moves computed from a `BT` code state); `progChk` checks it
with a Boolean move checker `mvOK` and accumulates the packed width histogram.

`prog_valid`: if the check passes and the move checker is sound for a labelling `lab` and an
injective wire map `ι`, the mapped chunk program (`mapProg`) is `ProgValid` for every global
labelling corresponding to the initial state, and the final global labelling corresponds to the
final state (other roles untouched).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx.NetLoc

open NetBT NetComplexP8

/-! ## Semantics of `mvRun` -/

lemma mvRun_wf (V : ℕ) : ∀ (ws : List ℕ) (t : BT), t.wf 8 = true → (mvRun V ws t).2.wf 8 = true
  | [], _, h => h
  | w :: ws, t, h => by
    simp only [mvRun]
    cases Nat.beq (gget t w) V
    · exact mvRun_wf V ws _ (wf_gset t h w V)
    · exact mvRun_wf V ws t h

/-! ## Mapping to global chunks -/

variable {R : Type} [DecidableEq R]

variable {nl : ℕ} {ι : ℕ → R} {labV : ℕ → Lab 576} {lab : ℕ → ℕ → Lab 576}
  {mvOK : ℕ → ℕ → ℕ → Bool} {wd : ℕ → ℕ → ℕ → ℕ}

theorem mv_valid (F : Frame nl ι labV lab mvOK) (V : ℕ) (hV : V < SM) (hV3 : V % 4 ≠ 3) :
    ∀ (ws : List ℕ) (t : BT) (g : R → Lab 576), t.wf 8 = true → (∀ w ∈ ws, w < nl) →
      ((mvRun V ws t).1.all (fun p => mvOK p.1 p.2 V) = true) → Corr nl ι lab t g →
      MvValid (labV V) ((mvRun V ws t).1.map (fun p => (ι p.1, lab p.1 p.2))) g ∧
      Corr nl ι lab (mvRun V ws t).2 (mvLab (labV V) ((mvRun V ws t).1.map (fun p => (ι p.1, lab p.1 p.2))) g) ∧
      ∀ r, (∀ w < nl, ι w ≠ r) →
        mvLab (labV V) ((mvRun V ws t).1.map (fun p => (ι p.1, lab p.1 p.2))) g r = g r
  | [], t, g, _, _, _, hC => ⟨trivial, hC, fun _ _ => rfl⟩
  | w :: ws, t, g, hw, hws, hok, hC => by
    have hw0 : w < nl := hws w List.mem_cons_self
    have hws' : ∀ w ∈ ws, w < nl := fun w' h => hws w' (List.mem_cons_of_mem _ h)
    simp only [mvRun] at hok ⊢
    cases hc : Nat.beq (gget t w) V
    · simp only [hc, cond_false, List.all_cons, Bool.and_eq_true, List.map_cons] at hok ⊢
      set g1 := Function.update g (ι w) (labV V)
      have hC1 : Corr nl ι lab (gset t w V) g1 := by
        intro w' hw'
        rw [gget_gset t hw (lt_of_lt_of_le hw0 F.cap) (lt_of_lt_of_le hw' F.cap) hV]
        by_cases h : w = w'
        · subst h; simp only [g1, Function.update_self, if_true]; exact (F.labV_eq w V hV3).symm
        · rw [if_neg h]
          simp only [g1]
          rw [Function.update_of_ne (fun e => h (F.inj w hw0 w' hw' e.symm))]
          exact hC w' hw'
      obtain ⟨h1, h2, h3⟩ := mv_valid F V hV hV3 ws _ g1 (wf_gset t hw w V) hws' hok.2 hC1
      refine ⟨⟨hC w hw0, F.sound w _ V hw0 hV3 hok.1, h1⟩, h2, fun r hr => ?_⟩
      show mvLab _ _ g1 r = g r
      rw [h3 r hr]
      exact Function.update_of_ne (Ne.symm (hr w hw0)) _ _
    · simp only [cond_true]
      exact mv_valid F V hV hV3 ws t g hw hws' (by simpa [hc] using hok) hC

/-- **Validity of a generated chunk program.** -/
theorem prog_valid (F : Frame nl ι labV lab mvOK) (wd : ℕ → ℕ → ℕ → ℕ) :
    ∀ (ss : List Spec) (t : BT) (g : R → Lab 576), t.wf 8 = true →
      (progChk nl mvOK wd ss t).1 = true → Corr nl ι lab t g →
      ProgValid (mapProg ι labV lab (progRun ss t).1) g ∧
      Corr nl ι lab (progRun ss t).2 (progLab (mapProg ι labV lab (progRun ss t).1) g) ∧
      ∀ r, (∀ w < nl, ι w ≠ r) → progLab (mapProg ι labV lab (progRun ss t).1) g r = g r
  | [], t, g, _, _, hC => ⟨trivial, hC, fun _ _ => rfl⟩
  | s :: ss, t, g, hw, hok, hC => by
    simp only [progChk, Bool.and_eq_true] at hok
    obtain ⟨hc, hrest⟩ := hok
    simp only [chunkOK, Bool.and_eq_true, Nat.blt_eq, List.all_eq_true, Bool.not_eq_true',
      Nat.beq_eq] at hc
    obtain ⟨⟨⟨⟨hV, hV3⟩, hws⟩, hmv⟩, hops⟩ := hc
    have hV3' : s.V % 4 ≠ 3 := fun e => by simp [e] at hV3
    have hmv' : (mvRun s.V s.ws t).1.all (fun p => mvOK p.1 p.2 s.V) = true := by
      rw [List.all_eq_true]; exact hmv
    obtain ⟨h1, h2, h3⟩ := mv_valid F s.V hV hV3' s.ws t g hw (fun w h => hws w h) hmv' hC
    have hw1 := mvRun_wf s.V s.ws t hw
    obtain ⟨k1, k2, k3⟩ := prog_valid F wd ss _ _ hw1 hrest h2
    simp only [progRun, mapProg, List.map_cons, ProgValid, progLab] at k1 k2 k3 ⊢
    refine ⟨⟨⟨h1, fun o ho => ?_⟩, k1⟩, k2, fun r hr => (k3 r hr).trans (h3 r hr)⟩
    obtain ⟨o', ho', rfl⟩ := List.mem_map.1 ho
    obtain ⟨⟨⟨hd, hs⟩, hgd⟩, hgs⟩ := hops o' ho'
    exact ⟨(h2 _ hd).trans (by rw [hgd, F.labV_eq _ _ hV3']; rfl),
      (h2 _ hs).trans (by rw [hgs, F.labV_eq _ _ hV3']; rfl)⟩

/-! ## Widths -/

lemma mvRun_ws (V : ℕ) : ∀ (ws : List ℕ) (t : BT), ∀ p ∈ (mvRun V ws t).1, p.1 ∈ ws
  | [], _, p, hp => by simp [mvRun] at hp
  | w :: ws, t, p, hp => by
    simp only [mvRun] at hp
    cases hc : Nat.beq (gget t w) V <;> rw [hc] at hp <;> simp only [cond_true, cond_false] at hp
    · rcases List.mem_cons.1 hp with rfl | hp
      · exact List.mem_cons_self
      · exact List.mem_cons_of_mem _ (mvRun_ws V ws _ p hp)
    · exact List.mem_cons_of_mem _ (mvRun_ws V ws _ p hp)

/-- **Widths of a checked program**: the nonzero move widths. -/
theorem prog_widths_eq (W : WidthOK nl labV lab mvOK wd) :
    ∀ (ss : List Spec) (t : BT), (progChk nl mvOK wd ss t).1 = true →
      progWidths (mapProg ι labV lab (progRun ss t).1) =
        (progMvW wd (progRun ss t).1).filter (fun x => x != 0)
  | [], _, _ => rfl
  | s :: ss, t, hok => by
    simp only [progChk, Bool.and_eq_true] at hok
    obtain ⟨hc, hrest⟩ := hok
    simp only [chunkOK, Bool.and_eq_true, Nat.blt_eq, List.all_eq_true, Bool.not_eq_true',
      Nat.beq_eq] at hc
    obtain ⟨⟨⟨⟨hV, hV3⟩, hws⟩, hmv⟩, -⟩ := hc
    have hV3' : s.V % 4 ≠ 3 := fun e => by simp [e] at hV3
    have ih := prog_widths_eq W ss _ hrest
    simp only [progRun, mapProg, progWidths, progMvW, List.map_cons, List.flatMap_cons,
      List.filter_append] at ih ⊢
    refine congrArg₂ (· ++ ·) ?_ ih
    simp only [mapChunk, mvWidths, List.flatMap_map]
    have key : ∀ (l : List (ℕ × ℕ)), (∀ p ∈ l, p.1 < nl ∧ mvOK p.1 p.2 s.V = true) →
        (l.flatMap fun p => if Fd (labV s.V) (lab p.1 p.2) = 0 then [] else [Fd (labV s.V) (lab p.1 p.2)]) =
          (l.map fun p => wd p.1 p.2 s.V).filter (fun x => x != 0) := by
      intro l hl
      induction l with
      | nil => rfl
      | cons p l ihl =>
        rw [List.flatMap_cons, List.map_cons, List.filter_cons,
          W p.1 p.2 s.V (hl p List.mem_cons_self).1 hV3' (hl p List.mem_cons_self).2,
          ihl (fun q hq => hl q (List.mem_cons_of_mem _ hq))]
        by_cases h0 : wd p.1 p.2 s.V = 0 <;> simp [h0]
    exact key _ fun p hp => ⟨hws _ (mvRun_ws _ _ _ p hp), hmv p hp⟩

lemma hsum_eq (wd : ℕ → ℕ → ℕ → ℕ) (V : ℕ) :
    ∀ l : List (ℕ × ℕ), hsum wd V l = ((l.map fun p => wd p.1 p.2 V).map (HB ^ ·)).sum
  | [] => rfl
  | p :: l => by rw [hsum, hsum_eq wd V l]; simp

theorem progChk_hist (nl : ℕ) (mvOK : ℕ → ℕ → ℕ → Bool) (wd : ℕ → ℕ → ℕ → ℕ) :
    ∀ (ss : List Spec) (t : BT),
      (progChk nl mvOK wd ss t).2.1 = ((progMvW wd (progRun ss t).1).map (HB ^ ·)).sum ∧
      (progChk nl mvOK wd ss t).2.2.1 = (progMvW wd (progRun ss t).1).length
  | [], _ => ⟨rfl, rfl⟩
  | s :: ss, t => by
    obtain ⟨h1, h2⟩ := progChk_hist nl mvOK wd ss (mvRun s.V s.ws t).2
    simp only [progChk, progRun]
    have e : progMvW wd (⟨s.V, (mvRun s.V s.ws t).1, s.ops⟩ :: (progRun ss (mvRun s.V s.ws t).2).1) =
        ((mvRun s.V s.ws t).1.map fun p => wd p.1 p.2 s.V) ++
          progMvW wd (progRun ss (mvRun s.V s.ws t).2).1 := by simp [progMvW]
    rw [e, List.map_append, List.sum_append, List.length_append, List.length_map, ← h1, ← h2,
      hsum_eq]
    exact ⟨rfl, rfl⟩

/-! ## Packed histograms -/

/-- Digits in base `B` are unique. -/
theorem digits_unique {B : ℕ} (hB : 0 < B) :
    ∀ (N : ℕ) (f g : ℕ → ℕ), (∀ k < N, f k < B) → (∀ k < N, g k < B) →
      ∑ k ∈ Finset.range N, f k * B ^ k = ∑ k ∈ Finset.range N, g k * B ^ k → ∀ k < N, f k = g k
  | 0, _, _, _, _, _, k, hk => absurd hk (Nat.not_lt_zero _)
  | N + 1, f, g, hf, hg, h, k, hk => by
    rw [Finset.sum_range_succ', Finset.sum_range_succ'] at h
    simp only [pow_zero, mul_one, pow_succ] at h
    have e : ∀ (u : ℕ → ℕ), ∑ i ∈ Finset.range N, u (i + 1) * (B ^ i * B) =
        B * ∑ i ∈ Finset.range N, u (i + 1) * B ^ i := by
      intro u; rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun i _ => by ring
    rw [e f, e g] at h
    have h0 : f 0 = g 0 := by
      have := congrArg (· % B) h
      simp only [Nat.add_mod, Nat.mul_mod_right, zero_add, Nat.mod_mod] at this
      rwa [Nat.mod_eq_of_lt (hf 0 (by omega)), Nat.mod_eq_of_lt (hg 0 (by omega))] at this
    rcases k with _ | k
    · exact h0
    · rw [h0] at h
      have h' := Nat.eq_of_mul_eq_mul_left hB (Nat.add_right_cancel h)
      exact digits_unique hB N (fun i => f (i + 1)) (fun i => g (i + 1))
        (fun i hi => hf _ (by omega)) (fun i hi => hg _ (by omega)) h' k (by omega)

lemma sum_pow_count (B N : ℕ) : ∀ L : List ℕ, (∀ x ∈ L, x < N) →
    (L.map (B ^ ·)).sum = ∑ k ∈ Finset.range N, L.count k * B ^ k
  | [], _ => by simp
  | x :: L, h => by
    rw [List.map_cons, List.sum_cons, sum_pow_count B N L (fun y hy => h y (List.mem_cons_of_mem _ hy))]
    have hx : x < N := h x List.mem_cons_self
    simp only [List.count_cons, add_mul, Finset.sum_add_distrib]
    rw [add_comm]
    congr 1
    rw [Finset.sum_eq_single x]
    · simp
    · intro b _ hb; simp [Ne.symm hb, beq_iff_eq]
    · intro hx'; exact absurd (Finset.mem_range.2 hx) hx'

lemma packH_eq (N : ℕ) : ∀ H : List (ℕ × ℕ), (∀ p ∈ H, p.1 < N) →
    packH H = ∑ k ∈ Finset.range N, cntH H k * HB ^ k
  | [], _ => by simp [packH, cntH]
  | p :: H, h => by
    have ih := packH_eq N H (fun q hq => h q (List.mem_cons_of_mem _ hq))
    simp only [packH, cntH, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih]
    simp only [add_mul, Finset.sum_add_distrib]
    congr 1
    rw [Finset.sum_eq_single p.1]
    · simp
    · intro b _ hb; simp [Ne.symm hb]
    · intro hx; exact absurd (Finset.mem_range.2 (h p List.mem_cons_self)) hx

lemma cntH_le (H : List (ℕ × ℕ)) (k : ℕ) : cntH H k ≤ (H.map Prod.snd).sum := by
  induction H with
  | nil => simp [cntH]
  | cons p H ih =>
    simp only [cntH, List.map_cons, List.sum_cons] at ih ⊢
    split_ifs <;> omega

lemma count_histMS (H : List (ℕ × ℕ)) (k : ℕ) : (histMS H).count k = cntH H k := by
  induction H with
  | nil => simp [cntH]
  | cons p H ih =>
    rw [histMS_cons, Multiset.count_add, ih, Multiset.count_replicate]
    simp only [cntH, List.map_cons, List.sum_cons]

/-- **From a packed histogram to the multiset.** -/
theorem multiset_of_pack (N : ℕ) (L : List ℕ) (H : List (ℕ × ℕ)) (hL : ∀ x ∈ L, x < N)
    (hH : ∀ p ∈ H, p.1 < N) (hlen : L.length < HB) (hsum : (H.map Prod.snd).sum < HB)
    (hpack : (L.map (HB ^ ·)).sum = packH H) : (L : Multiset ℕ) = histMS H := by
  rw [sum_pow_count HB N L hL, packH_eq N H hH] at hpack
  have hd := digits_unique (by norm_num [HB]) N _ _
    (fun k _ => lt_of_le_of_lt (List.count_le_length) hlen)
    (fun k _ => lt_of_le_of_lt (cntH_le H k) hsum) hpack
  ext k
  rw [Multiset.coe_count, count_histMS]
  by_cases hk : k < N
  · exact hd k hk
  · have h1 : L.count k = 0 := List.count_eq_zero.2 fun hm => hk (hL k hm)
    have h2 : cntH H k = 0 := by
      unfold cntH
      apply List.sum_eq_zero
      intro x hx
      obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hx
      rw [if_neg]; intro e; exact hk (e ▸ hH p hp)
    rw [h1, h2]

/-! ## Kernel-efficient check (tail recursive, forced accumulators) -/

end IntMul.Kappa.R6.Cx.NetLoc

end

section
-- Source module: Solutions.R6CxNetF2
/-!
# Labels of the `h = 24` local program: codes over `𝔽₂^24` and a sound Boolean edge checker

A label code (`Code`) is one of

* `coord X`: `span {e_p : p ∈ X}`;
* `psp a b C`: `span {e_a + e_b + e_c : c ∈ C}` (a "pair span"; a line `⟨t⟩` is `psp p q {r}`);
* `perp t`: `⟨t⟩^⊥` (a triple `t`);
* `ext k`: boundary labels of stage two (decoded elsewhere).

Vectors are 24-bit naturals (`bitv`). `edgeB new old = true` implies
`NetComplexP8.EdgeOK (dec new) (dec old)` (`edgeB_sound`), with `finrank (dec c) = dimC c`
(`finrank_dec`). All functions are kernel-friendly (straight-line bit operations, SWAR popcount).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx.NetF2

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8

/-! ## Popcount -/

lemma pcRec_eq (k n : ℕ) : pcRec k n = cntK k n := by
  induction k with
  | zero => simp [pcRec, cntK]
  | succ k ih => rw [pcRec, ih, cntK, cntK, Fin.sum_univ_castSucc]; simp

theorem allLT_spec (f : ℕ → Bool) : ∀ n, allLT f n = true → ∀ x < n, f x = true := by
  intro n
  induction n with
  | zero => intro _ x hx; omega
  | succ n ih =>
    intro h x hx
    simp only [allLT, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.1 hx with hx | rfl
    · exact ih h.2 x hx
    · exact h.1

theorem swar12_eq : ∀ x < 4096, swar12 x = pcRec 12 x := fun x hx =>
  Nat.eq_of_beq_eq_true (allLT_spec _ _ swar12_chk x hx)

lemma m4095 : (4095 : ℕ) = 2 ^ 12 - 1 := rfl

lemma cntK_split (n : ℕ) : cntK 24 n = cntK 12 (n &&& 4095) + cntK 12 ((n >>> 12) &&& 4095) := by
  rw [cntK, show (24 : ℕ) = 12 + 12 from rfl, Fin.sum_univ_add, cntK, cntK]
  congr 1
  · refine Finset.sum_congr rfl fun i _ => ?_
    rw [m4095, Nat.testBit_and, Nat.testBit_two_pow_sub_one]
    simp [i.isLt]
  · refine Finset.sum_congr rfl fun i _ => ?_
    rw [m4095, Nat.testBit_and, Nat.testBit_two_pow_sub_one, Nat.testBit_shiftRight]
    simp [i.isLt, Nat.add_comm]

theorem pc24_eq (n : ℕ) : pc24 n = cntK 24 n := by
  have h1 : n &&& 4095 < 4096 := Nat.lt_succ_of_le Nat.and_le_right
  have h2 : (n >>> 12) &&& 4095 < 4096 := Nat.lt_succ_of_le Nat.and_le_right
  rw [pc24, swar12_eq _ h1, swar12_eq _ h2, pcRec_eq, pcRec_eq, cntK_split]

/-! ## Vectors -/

lemma cast_cntK (k n : ℕ) :
    ((cntK k n : ℕ) : ZMod 2) = ∑ i : Fin k, if n.testBit i then (1 : ZMod 2) else 0 := by
  rw [cntK]; push_cast; refine Finset.sum_congr rfl fun i _ => ?_; split_ifs <;> simp

theorem dot_bitv (a b : ℕ) : bitv a ⬝ᵥ bitv b = ((cntK 24 (a &&& b) : ℕ) : ZMod 2) := by
  rw [cast_cntK]
  simp only [dotProduct, bitv, Nat.testBit_and]
  refine Finset.sum_congr rfl fun i _ => ?_
  cases a.testBit i <;> cases b.testBit i <;> simp

lemma ev_dot (n : ℕ) (v : V24) : ev n ⬝ᵥ v = if h : n < 24 then v ⟨n, h⟩ else 0 := by
  simp only [dotProduct, ev, ite_mul, one_mul, zero_mul]
  split_ifs with h
  · rw [Finset.sum_eq_single ⟨n, h⟩]
    · simp
    · intro b _ hb; rw [if_neg]; intro e; exact hb (Fin.ext e)
    · simp
  · exact Finset.sum_eq_zero fun i _ => by rw [if_neg]; intro e; exact h (e ▸ i.isLt)

lemma dot_ev (v : V24) (n : ℕ) : v ⬝ᵥ ev n = if h : n < 24 then v ⟨n, h⟩ else 0 := by
  rw [dotProduct_comm, ev_dot]

lemma ev_ev (a b : ℕ) : ev a ⬝ᵥ ev b = if a = b ∧ a < 24 then 1 else 0 := by
  rw [ev_dot]
  split_ifs with h1 h2 h2
  · simp [ev, h2.1]
  · simp only [ev]; rw [if_neg]; intro e; exact h2 ⟨e, h1⟩
  · exact absurd h2.2 h1
  · rfl

lemma bitv_apply (w : ℕ) (i : Fin 24) : bitv w i = if w.testBit i then 1 else 0 := rfl

lemma ev_apply (n : ℕ) (i : Fin 24) : ev n i = if (i : ℕ) = n then 1 else 0 := rfl

lemma bitv_dot_self (w : ℕ) : bitv w ⬝ᵥ bitv w = ((cntK 24 w : ℕ) : ZMod 2) := by
  rw [dot_bitv, Nat.and_self]

/-! ## Subspaces -/

lemma ev_mem_coordSp {X : ℕ} (i : Fin 24) (h : X.testBit i = true) : ev i ∈ coordSp X :=
  Submodule.subset_span (Finset.mem_coe.2 (Finset.mem_image.2 ⟨i, by simp [h], rfl⟩))

lemma ev_fin_injective : Function.Injective fun i : Fin 24 => ev i := by
  intro i j h
  have := congrFun h i
  simp only [ev, if_true] at this
  by_contra hij
  rw [if_neg (fun e => hij (Fin.ext e))] at this
  exact one_ne_zero this

lemma ON_gC (X : ℕ) : Orthonormal2 (gC X) := by
  constructor
  · intro b hb
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 hb
    rw [ev_ev, if_pos ⟨rfl, i.isLt⟩]
  · intro b hb c hc hbc
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.1 hb
    obtain ⟨j, -, rfl⟩ := Finset.mem_image.1 hc
    rw [ev_ev, if_neg]
    rintro ⟨e, -⟩
    exact hbc (by rw [Fin.ext e])

lemma card_filter_testBit (X : ℕ) :
    (univ.filter fun i : Fin 24 => X.testBit i).card = cntK 24 X := by
  rw [Finset.card_filter]; rfl

theorem finrank_coordSp (X : ℕ) : finrank (ZMod 2) (coordSp X) = cntK 24 X := by
  rw [coordSp, finrank_ON (ON_gC X), gC, Finset.card_image_of_injective _ ev_fin_injective,
    card_filter_testBit]

lemma ne_of_testBit {C : ℕ} {a : ℕ} {c : Fin 24} (hc : C.testBit c = true) (ha : C.testBit a = false) :
    (c : ℕ) ≠ a := by
  rintro e; rw [e] at hc; rw [hc] at ha; exact Bool.noConfusion ha

lemma gP_dot {a b C : ℕ} (hp : PspOK a b C) {c d : Fin 24} (hc : C.testBit c = true)
    (hd : C.testBit d = true) :
    (ev a + ev b + ev c) ⬝ᵥ (ev a + ev b + ev d) = if c = d then 1 else 0 := by
  obtain ⟨ha, hb, hab, hCa, hCb⟩ := hp
  have hca := ne_of_testBit hc hCa
  have hcb := ne_of_testBit hc hCb
  have hda := ne_of_testBit hd hCa
  have hdb := ne_of_testBit hd hCb
  simp only [add_dotProduct, dotProduct_add, ev_ev]
  have hab' : b ≠ a := Ne.symm hab
  by_cases hcd : c = d
  · subst hcd
    simp [ha, hb, hab, hab', hca, hcb, Ne.symm hca, Ne.symm hcb]
    decide
  · have hcd' : (c : ℕ) ≠ d := fun e => hcd (Fin.ext e)
    simp [ha, hb, hab, hab', hca, hcb, hda, hdb, Ne.symm hca, Ne.symm hcb, Ne.symm hda,
      Ne.symm hdb, hcd, hcd']
    decide

lemma gP_injective {a b C : ℕ} (hp : PspOK a b C) :
    Set.InjOn (fun c : Fin 24 => ev a + ev b + ev c) ↑(univ.filter fun c : Fin 24 => C.testBit c) := by
  intro c hc d hd h
  have hc' : C.testBit c = true := by simpa using hc
  have := congrFun h c
  simp only [Pi.add_apply, ev_apply, if_true] at this
  have hca := ne_of_testBit hc' hp.2.2.2.1
  have hcb := ne_of_testBit hc' hp.2.2.2.2
  rw [if_neg hca, if_neg hcb] at this
  by_contra hcd
  rw [if_neg (fun e => hcd (Fin.ext e))] at this
  simp at this

lemma ON_gP {a b C : ℕ} (hp : PspOK a b C) : Orthonormal2 (gP a b C) := by
  constructor
  · intro g hg
    obtain ⟨c, hc, rfl⟩ := Finset.mem_image.1 hg
    have hc' : C.testBit c = true := by simpa using hc
    rw [gP_dot hp hc' hc', if_pos rfl]
  · intro g hg g' hg' hne
    obtain ⟨c, hc, rfl⟩ := Finset.mem_image.1 hg
    obtain ⟨d, hd, rfl⟩ := Finset.mem_image.1 hg'
    have hc' : C.testBit c = true := by simpa using hc
    have hd' : C.testBit d = true := by simpa using hd
    rw [gP_dot hp hc' hd', if_neg]
    rintro rfl; exact hne rfl

theorem finrank_pspSp {a b C : ℕ} (hp : PspOK a b C) : finrank (ZMod 2) (pspSp a b C) = cntK 24 C := by
  rw [pspSp, finrank_ON (ON_gP hp), gP, Finset.card_image_of_injOn (gP_injective hp),
    card_filter_testBit]

lemma cast_odd {n : ℕ} (h : n % 2 = 1) : ((n : ℕ) : ZMod 2) = 1 := by
  rw [← ZMod.natCast_mod, h]; rfl

lemma bitv_ne_zero {t : ℕ} (ht : cntK 24 t % 2 = 1) : bitv t ≠ 0 := by
  intro h
  have := bitv_dot_self t
  rw [h, zero_dotProduct, cast_odd ht] at this
  exact zero_ne_one this

lemma line_nondeg {t : ℕ} (ht : cntK 24 t % 2 = 1) :
    NondegOn (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) (ZMod 2 ∙ bitv t) := by
  apply nondegOn_span_singleton
  rw [bf_one, bitv_dot_self, cast_odd ht]; exact one_ne_zero

theorem finrank_perpSp {t : ℕ} (ht : cntK 24 t % 2 = 1) : finrank (ZMod 2) (perpSp t) = 23 := by
  have hc := isCompl_orth one_isSymm (line_nondeg ht)
  have := Submodule.finrank_add_eq_of_isCompl hc
  rw [finrank_span_singleton (bitv_ne_zero ht), Module.finrank_fin_fun] at this
  rw [perpSp]
  exact Nat.add_left_cancel (this.trans (rfl : (24 : ℕ) = 1 + 23))

theorem nondeg_perpSp {t : ℕ} (ht : cntK 24 t % 2 = 1) :
    NondegOn (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) (perpSp t) :=
  nondeg_orth one_isSymm (line_nondeg ht) (by rw [det_one]; exact one_ne_zero)

lemma coordSp_full : coordSp 16777215 = ⊤ := by
  rw [eq_top_iff]
  intro v _
  have hv : v = ∑ i : Fin 24, v i • ev i := by
    funext j
    rw [Finset.sum_apply, Finset.sum_eq_single j]
    · simp [ev]
    · intro b _ hb; simp [ev, Fin.val_inj, Ne.symm hb]
    · simp
  rw [hv]
  refine Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (ev_mem_coordSp i ?_)
  have h : (16777215 : ℕ) = 2 ^ 24 - 1 := rfl
  rw [h, Nat.testBit_two_pow_sub_one]; simp [i.isLt]

/-! ## Codes and the Boolean checker -/

/-! ## Soundness -/

lemma pspOK_of_okC {a b C : ℕ} (hok : okC (.psp a b C) = true) : PspOK a b C := by
  simp only [okC, Bool.and_eq_true, Nat.blt_eq, Bool.not_eq_true'] at hok
  obtain ⟨⟨⟨⟨ha, hb⟩, hab⟩, hCa⟩, hCb⟩ := hok
  exact ⟨ha, hb, Nat.ne_of_beq_eq_false (by simpa using hab), hCa, hCb⟩

theorem nondeg_dec : ∀ (c : Code), okC c = true → NondegOn (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) (dec c)
  | .coord X, _ => HasON.nondegOn ⟨gC X, ON_gC X, rfl⟩
  | .psp a b C, h => HasON.nondegOn ⟨gP a b C, ON_gP (pspOK_of_okC h), rfl⟩
  | .perp t, h => by
    simp only [okC, Nat.beq_eq] at h
    exact nondeg_perpSp (by rw [← pc24_eq, h])
  | .ext _, h => by simp [okC] at h

theorem finrank_dec : ∀ (c : Code), okC c = true → finrank (ZMod 2) (dec c) = dimC c
  | .coord X, _ => by rw [dec, finrank_coordSp, dimC, pc24_eq]
  | .psp a b C, h => by rw [dec, finrank_pspSp (pspOK_of_okC h), dimC, pc24_eq]
  | .perp t, h => by
    simp only [okC, Nat.beq_eq] at h
    rw [dec, finrank_perpSp (by rw [← pc24_eq, h]), dimC]
  | .ext _, h => by simp [okC] at h

theorem witOK_sound {U V : Code} (hU : okC U = true) (hV : okC V = true) {w : ℕ}
    (h : witOK U V w = true) :
    bitv w ∈ dec V ∧ bitv w ⬝ᵥ bitv w = 1 ∧ NetComplexP8.Orth (dec U) (bitv w) := by
  simp only [witOK, Bool.and_eq_true, Nat.beq_eq] at h
  obtain ⟨⟨hm, hp⟩, ho⟩ := h
  refine ⟨memB_sound V hV w hm, ?_, orthB_sound U hU w ho⟩
  rw [bitv_dot_self, cast_odd (by rw [← pc24_eq]; exact hp)]

theorem up_of_check {U V : Code} (hU : okC U = true) (hV : okC V = true) (hle : leB U V = true)
    (hw : witOK U V (cand U V) = true) : Up (dec U) (dec V) := by
  obtain ⟨h1, h2, h3⟩ := witOK_sound hU hV hw
  exact ⟨nondeg_dec U hU, nondeg_dec V hV, leB_sound U V hU hV hle, Or.inr ⟨_, h1, h2, h3⟩⟩

/-- **Soundness of the edge checker.** -/
theorem edgeB_sound {V U : Code} (h : edgeB V U = true) : EdgeOK (dec V) (dec U) := by
  simp only [edgeB, Bool.and_eq_true, Bool.or_eq_true] at h
  obtain ⟨⟨hV, hU⟩, h | h⟩ := h
  · exact Or.inl (up_of_check hU hV h.1 h.2)
  · exact Or.inr (up_of_check hV hU h.1 h.2)

theorem okC_of_edgeB_left {V U : Code} (h : edgeB V U = true) : okC V = true := by
  simp only [edgeB, Bool.and_eq_true] at h; exact h.1.1

theorem okC_of_edgeB_right {V U : Code} (h : edgeB V U = true) : okC U = true := by
  simp only [edgeB, Bool.and_eq_true] at h; exact h.1.2

end IntMul.Kappa.R6.Cx.NetF2

