-- Source module: Solutions.KFWC4
/-!
# KFW C-layer 4: uniform truncation and uniform padding

* `truncU xD xN`: `KFH.truncP` with the divisor `2^Δ` read from `xD` and the item count from
  `xN`; **`runQ_truncU`**: on records at scale `p + Δ` it gives `Q_p` at scale `p` (a fixed run).
* `padPreU xL xQ`, `padPostU xL xQ`: `KFN.padPre/padPost` with the lengths read from registers;
  **`sImplQ_padU`**: a uniform program on `np ≥ n` records implements the same operator on `n`
  records, padded (as `KFN.sImpl_pad`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

theorem sub_mvK' {σ : Fin HS → Option ℤ} {X Y C : Fin HS} (hX : σ X = none) (hY : σ Y = none)
    (n : Ex HS) : RS.sub σ (NLogN.mvK X Y C n) = NLogN.mvK X Y C (Ex.sub σ n) := by
  simp [NLogN.mvK, RS.sub, Ex.sub, hX]

/-! ## Truncation -/

/-! ## Padding -/

theorem sub_padPreU {σ : Fin HS → Option ℤ} (hoff : OffG σ) {xL xQ : Fin HS} {L0 Q : ℕ}
    (hL : σ xL = some (L0 : ℤ)) (hQ : σ xQ = some (Q : ℤ)) :
    RS.sub σ (padPreU xL xQ) = padPre L0 Q := by
  have h0 : σ 0 = none := hoff 0 (by decide)
  have hqP : σ qP = none := hoff qP (by decide)
  simp only [padPreU, padPre, zeroK, RS.sub, sub_mvK' h0 hqP, sub_mvK' hqP h0, Ex.sub, hL, hQ]

theorem sub_padPostU {σ : Fin HS → Option ℤ} (hoff : OffG σ) {xL xQ : Fin HS} {L0 Q : ℕ}
    (hL : σ xL = some (L0 : ℤ)) (hQ : σ xQ = some (Q : ℤ)) :
    RS.sub σ (padPostU xL xQ) = padPost L0 Q := by
  have h0 : σ 0 = none := hoff 0 (by decide)
  have hqP : σ qP = none := hoff qP (by decide)
  simp only [padPostU, padPost, dropK, RS.sub, sub_mvK' h0 hqP, sub_mvK' hqP h0, Ex.sub, hL, hQ]

theorem noW_padPreU {σ : Fin HS → Option ℤ} (hoff : OffG σ) (xL xQ : Fin HS) :
    NoW σ (padPreU xL xQ) := by
  intro i hi
  apply hoff
  revert i
  simp only [padPreU, NLogN.mvK, RS.writes, List.forall_mem_append, List.forall_mem_cons,
    List.append_nil, List.cons_append, List.nil_append]
  and_intros <;> first | decide | (intro x hx; simp at hx)

theorem noW_padPostU {σ : Fin HS → Option ℤ} (hoff : OffG σ) (xL xQ : Fin HS) :
    NoW σ (padPostU xL xQ) := by
  intro i hi
  apply hoff
  revert i
  simp only [padPostU, NLogN.mvK, RS.writes, List.forall_mem_append, List.forall_mem_cons,
    List.append_nil, List.cons_append, List.nil_append]
  and_intros <;> first | decide | (intro x hx; simp at hx)

section Pad

variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- **Uniform padding.** -/
theorem sImplQ_padU_sol_aux {ι : Type*} [Fintype ι] [DecidableEq ι] {lo hi r : ℕ} {st : ι → ℕ} {n np : ℕ}
    (hs : SLaws st n) (hnp : n ≤ np) {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ}
    {σ : Fin HS → Option ℤ} (hlt : ∀ i v, σ i = some v → i.val < 56) (hoff : OffG σ)
    {xL xQ : Fin HS} (hL : σ xL = some ((2 * (n * r) : ℕ) : ℤ))
    (hQ : σ xQ = some ((2 * ((np - n) * r) : ℕ) : ℤ))
    {U : IStmt HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
    (h : SImplQ Isym iprog (fun s => Agree σ s) lo hi r st np T U e dw cost) (Z : ℕ)
    (hZ : zsz ((2 * ((np - n) * r) : ℕ) : ℤ) ≤ Z) :
    SImplQ Isym iprog (fun s => Agree σ s) lo hi r st n T (padCU xL xQ U) e dw
      (fun w => 400 * (cPadC (2 * (n * r)) (2 * ((np - n) * r)) Z w dw cost + 0) + cost w) := by
  intro s f zs l xs F w hσs hC h0 hx hl hb hlo hhi
  have h0σ : σ 0 = none := hoff 0 (by decide)
  have hsc := sclean_of_lt hlt
  have hzl : zs.length = n * r := by rw [hx.1, hl]
  have hL0 : (gflat zs).length = 2 * (n * r) := by rw [length_gflat, hzl]
  set Q := 2 * ((np - n) * r) with hQdef
  set zpad := zs ++ List.replicate ((np - n) * r) ((0, 0) : GI) with hzpad
  have hC' := hC.clN
  have hfqP : f qP = [] := hC'.cl.p
  have hq0 : (0 : Fin HS) ≠ qP := by decide
  have hfc1 : f c1 = [] := hC'.t.c1
  -- 1. park
  have m1 := mv_fsp (X := 0) (Y := qP) (by decide) (by decide) (by decide) (by decide) (by decide)
    s f (gflat zs) l (by rw [h0]) w hb.bnd
  rw [hL0] at m1
  set f1 := Function.update (Function.update f 0 l) qP ((gflat zs).reverse ++ f qP)
  -- 2. zeros
  have m2 := FSp.zeroK (Y := 0) (C := c1) (by decide) (by decide) (by decide) s f1 Q
    (by simp only [f1]; rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide)]
        exact hfc1) Z hZ
  set f2 := Function.update f1 0 (List.replicate Q 0 ++ f1 0)
  -- 3. unpark
  have m3 := mv_fsp (X := qP) (Y := 0) (by decide) (by decide) (by decide) (by decide) (by decide)
    s f2 (gflat zs).reverse [] (by
      simp only [f2, f1]
      rw [Function.update_of_ne hq0.symm, Function.update_self, hfqP, List.append_nil])
      w (bnd_reverse hb.bnd)
  rw [List.length_reverse, hL0, List.reverse_reverse] at m3
  have e3 : Function.update (Function.update f2 qP []) 0 (gflat zs ++ f2 0) =
      Function.update f 0 (gflat zpad ++ l) := by
    funext j
    simp only [f2, f1, Function.update_apply]
    by_cases hj0 : j = 0
    · subst hj0
      simp [hzpad, gflat_append, gflat_zeros, hQdef, hq0]
    · by_cases hjq : j = qP
      · subst hjq; simp [hfqP, hq0.symm]
      · simp [hj0, hjq]
  rw [e3] at m3
  -- 4. the program on the padded stream
  obtain ⟨zs', r1, b1, f4⟩ := h s (Function.update f 0 (gflat zpad ++ l)) zpad l
    (xs ++ List.replicate (np - n) 0) F w hσs (hC.upd0 _) (by simp) (recRep_pad hx (np - n))
    (by simp [hl]; omega) (GB_append.2 ⟨hb, GB_zeros _ _⟩) hlo hhi
  rw [Function.update_idem] at f4
  have hz' : zs'.length = np * r := by
    rw [r1.1, length_selOpF]
  set g4 := Function.update f 0 (gflat zs' ++ l)
  have hsplit : gflat zs' = gflat (zs'.take (n * r)) ++ gflat (zs'.drop (n * r)) := by
    rw [← gflat_append, List.take_append_drop]
  have hLt : (gflat (zs'.take (n * r))).length = 2 * (n * r) := by
    rw [length_gflat, List.length_take, hz', Nat.min_eq_left (Nat.mul_le_mul_right _ hnp)]
  have hLd : (gflat (zs'.drop (n * r))).length = Q := by
    rw [length_gflat, List.length_drop, hz', hQdef, Nat.sub_mul]
  -- 5. park the kept part
  have m5 := mv_fsp (X := 0) (Y := qP) (by decide) (by decide) (by decide) (by decide) (by decide)
    s g4 (gflat (zs'.take (n * r))) (gflat (zs'.drop (n * r)) ++ l)
    (by simp only [g4, Function.update_self, hsplit, List.append_assoc]) (w + dw)
    (KFN.GB_take b1 _).bnd
  rw [hLt] at m5
  set g5 := Function.update (Function.update g4 0 (gflat (zs'.drop (n * r)) ++ l)) qP
    ((gflat (zs'.take (n * r))).reverse ++ g4 qP)
  -- 6. drop the padding
  have m6 := FSp.dropK (X := 0) (C := c1) (by decide) (by decide) (by decide) s g5
    (gflat (zs'.drop (n * r))) l (by
      simp only [g5]
      rw [Function.update_of_ne hq0, Function.update_self]) (by
      simp only [g5, g4]
      rw [Function.update_of_ne (by decide), Function.update_of_ne (by decide),
        Function.update_of_ne (by decide)]
      exact hfc1) (w + dw) Z (KFN.GB_drop b1 _).bnd (by rw [hLd]; exact hZ)
  rw [hLd] at m6
  set g6 := Function.update g5 0 l
  -- 7. unpark
  have m7 := mv_fsp (X := qP) (Y := 0) (by decide) (by decide) (by decide) (by decide) (by decide)
    s g6 (gflat (zs'.take (n * r))).reverse [] (by
      simp only [g6, g5, g4]
      rw [Function.update_of_ne hq0.symm, Function.update_self, Function.update_of_ne hq0.symm,
        hfqP, List.append_nil]) (w + dw)
    (bnd_reverse (KFN.GB_take b1 _).bnd)
  rw [List.length_reverse, hLt, List.reverse_reverse] at m7
  have e7 : Function.update (Function.update g6 qP []) 0 (gflat (zs'.take (n * r)) ++ g6 0) =
      Function.update f 0 (gflat (zs'.take (n * r)) ++ l) := by
    funext j
    simp only [g6, g5, g4, Function.update_apply]
    by_cases hj0 : j = 0
    · subst hj0; simp [hq0]
    · by_cases hjq : j = qP
      · subst hjq; simp [hfqP, hq0.symm]
      · simp [hj0, hjq]
  rw [e7] at m7
  refine ⟨zs'.take (n * r), ?_, KFN.GB_take b1 _, ?_⟩
  · have := recRep_take' r1 (n := n) (by rw [length_selOpF]; exact hnp)
    rwa [selOpF_pad hs hnp T hl] at this
  · have P1 : FSp (padPre (2 * (n * r)) Q) _ _ _ := m1.seq (m2.seq m3)
    have P2 : FSp (padPost (2 * (n * r)) Q) _ _ _ := m5.seq (m6.seq m7)
    have hO1 : HRef (padPre (2 * (n * r)) Q) (RS.sub σ (padPreU xL xQ)) 0 := by
      rw [sub_padPreU hoff hL hQ]; exact HRef.refl _
    have hO2 : HRef (padPost (2 * (n * r)) Q) (RS.sub σ (padPostU xL xQ)) 0 := by
      rw [sub_padPostU hoff hL hQ]; exact HRef.refl _
    have ag1 : Agree σ (encK s f) := agree_clean0 h0σ hσs hC
    have ag2 : Agree σ (encK s g4) := agree_clean0 h0σ hσs (hC.upd0 _)
    have U1 := (FSp.uni hsc (noW_padPreU hoff xL xQ) hO1 ag1 P1).irun (I := Isym) (iprog := iprog)
      (fok_uni (noW_padPreU hoff xL xQ) hO1 (fok_padPre _ _))
    have U2 := (FSp.uni hsc (noW_padPostU hoff xL xQ) hO2 ag2 P2).irun (I := Isym) (iprog := iprog)
      (fok_uni (noW_padPostU hoff xL xQ) hO2 (fok_padPost _ _))
    have H := U1.seq (f4.seq U2)
    refine H.mono ?_
    unfold cPadC
    nlinarith

end Pad

end NLogN.KFW

end

theorem solution.{u_1} : type_of% @NLogN.KFW.sImplQ_padU_sol_aux.{u_1} := @NLogN.KFW.sImplQ_padU_sol_aux.{u_1}
