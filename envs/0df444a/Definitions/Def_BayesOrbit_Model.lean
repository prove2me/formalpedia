-- title:
--   Signalling structures, Bayes operators, the generated group, orbits and genericity
-- statement:
--   This module fixes the model of the paper. Let $K$ be a finite set of states and $M$ a finite set of signals, and write $\Delta(K)$ for the simplex of probability vectors on $K$, with the subspace topology of $\mathbb R^K$.
--
--   1. A **signalling structure** is a $|K|\times|M|$ real matrix $r=(r_k[m])$ whose rows $r_k$ are probability distributions on $M$, each with full support: $r_k[m]>0$ for all $k,m$ and $\sum_m r_k[m]=1$ for all $k$. The entry $r_k[m]$ is the probability of signal $m$ in state $k$.
--   2. The **Bayes operator** of a signal $m$ sends a prior $p\in\Delta(K)$ to the posterior
--   $$
--   \varphi_m(p)[k]=\frac{r_k[m]\,p[k]}{\sum_{j\in K}r_j[m]\,p[j]}.
--   $$
--   The denominator is positive because $r>0$. The operator is a bijection of $\Delta(K)$ with inverse $p\mapsto\bigl(r_k[m]^{-1}p[k]/\sum_j r_j[m]^{-1}p[j]\bigr)_k$.
--   3. The **group** $G$ is the subgroup of the bijections of $\Delta(K)$ generated by the $\varphi_m$, and the **orbit** of $p$ is $G(p)=\{g(p): g\in G\}$.
--   4. The structure is **generic** if the numbers $\ln r_k[m]$, $k\in K$, $m\in M$, are algebraically independent over $\mathbb Q$.
--   5. The **interior** $\Delta^0(K)$ of the simplex is the set of $p$ with $p[k]>0$ for all $k$.
--   6. For a word $w=((m_1,s_1),\dots,(m_L,s_L))$ with signs $s_l=\pm1$, the module defines the composition $\varphi_{m_L}^{s_L}\circ\dots\circ\varphi_{m_1}^{s_1}$ and the exponent $u_m=\#\{l: m_l=m,\ s_l=1\}-\#\{l: m_l=m,\ s_l=-1\}$.
--
--   These are the objects of every statement of the mission that concerns the group action.
--
--   **Formalization Note** The simplex is `stdSimplex ℝ K` as a subtype. Positivity and the rows being in $\Delta(M)$ are fields of the structure, so no logarithm or division is on a non-positive number. The inverse is carried by the permutation. $G$ is `Subgroup.closure` of the range of the operators: it is not defined as the set of normalized products, whose equality with $G$ is Lemma 3.1. The interior is coordinate-wise positivity, not the topological interior in $\mathbb R^K$, which is empty.
-- source:
--   Hellman–Levy, Dense Orbits of the Bayesian Updating Group Action, accepted manuscript (Enlighten 227272), §2.2, eqs. (2.1)–(2.2), p.4; §2.3, p.5; Remark 2.1, p.5; Definition 2.2, p.5; §2.1.1 (orbit), p.3; Lemma 3.1 (word and exponents), p.7

import Mathlib

open scoped BigOperators

namespace BayesOrbit

variable {K M : Type*} [Fintype K] [Fintype M]

/-- The weighted total `∑ j, a j * p j` of a positive weight against a point of the simplex is
positive. Support lemma for `reweight`. -/
lemma weighted_total_pos (a : K → ℝ) (ha : ∀ k, 0 < a k) (p : stdSimplex ℝ K) :
    0 < ∑ j, a j * (p : K → ℝ) j := by
  have hp0 : ∀ j, 0 ≤ (p : K → ℝ) j := p.2.1
  have hp1 : ∑ j, (p : K → ℝ) j = 1 := p.2.2
  obtain ⟨j, -, hj⟩ : ∃ j ∈ (Finset.univ : Finset K), (p : K → ℝ) j ≠ 0 := by
    by_contra h
    push Not at h
    rw [Finset.sum_eq_zero h] at hp1
    exact zero_ne_one hp1
  exact Finset.sum_pos' (fun i _ => mul_nonneg (ha i).le (hp0 i))
    ⟨j, Finset.mem_univ j, mul_pos (ha j) (lt_of_le_of_ne (hp0 j) (Ne.symm hj))⟩

/-- Reweighting a point of the simplex by a positive weight and renormalizing:
`p ↦ (a k * p k / ∑ j, a j * p j)_k`. Both the Bayes operator and its inverse have this form. -/
noncomputable def reweight (a : K → ℝ) (ha : ∀ k, 0 < a k) (p : stdSimplex ℝ K) :
    stdSimplex ℝ K :=
  ⟨fun k => a k * (p : K → ℝ) k / ∑ j, a j * (p : K → ℝ) j,
    fun k => div_nonneg (mul_nonneg (ha k).le (p.2.1 k)) (weighted_total_pos a ha p).le, by
      rw [← Finset.sum_div]
      exact div_self (weighted_total_pos a ha p).ne'⟩

/-- Reweighting by `a` and then by `a⁻¹` (in either order) returns the point. -/
lemma reweight_inv_reweight (a b : K → ℝ) (ha : ∀ k, 0 < a k) (hb : ∀ k, 0 < b k)
    (hab : ∀ k, b k * a k = 1) (p : stdSimplex ℝ K) :
    reweight b hb (reweight a ha p) = p := by
  apply Subtype.ext
  funext k
  have hD := (weighted_total_pos a ha p).ne'
  have hp1 : ∑ j, (p : K → ℝ) j = 1 := p.2.2
  have hsum : ∑ j, b j * (a j * (p : K → ℝ) j / ∑ i, a i * (p : K → ℝ) i)
      = 1 / ∑ i, a i * (p : K → ℝ) i := by
    calc ∑ j, b j * (a j * (p : K → ℝ) j / ∑ i, a i * (p : K → ℝ) i)
        = ∑ j, (p : K → ℝ) j / ∑ i, a i * (p : K → ℝ) i := by
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [← mul_div_assoc, ← mul_assoc, hab, one_mul]
      _ = 1 / ∑ i, a i * (p : K → ℝ) i := by rw [← Finset.sum_div, hp1]
  change b k * (a k * (p : K → ℝ) k / ∑ i, a i * (p : K → ℝ) i) /
      (∑ j, b j * (a j * (p : K → ℝ) j / ∑ i, a i * (p : K → ℝ) i)) = (p : K → ℝ) k
  rw [hsum, ← mul_div_assoc, ← mul_assoc, hab, one_mul]
  field_simp

/-- A **signalling structure** (Hellman–Levy, Dense Orbits of the Bayesian Updating Group Action,
accepted manuscript (Enlighten 227272), §2.2, p.4 (PDF 5)): a `|K| × |M|` real matrix `r` whose
rows `r k` are probability distributions on the signal set `M`, each with full support.

**Formalization Note.** Rows in `Δ(M)` and positivity are bundled in the structure, so `r k m` is
the probability of signal `m` in state `k`, and every division and logarithm below is on a positive
number. Lemma 3.8 is about an arbitrary positive matrix and does not use this structure. The
paper's "at least two signals" is not a field: genericity implies it for non-empty `K`. -/
structure SignallingStructure (K M : Type*) [Fintype K] [Fintype M] where
  /-- `r k m` is the probability of signal `m` conditional on state `k`. -/
  r : K → M → ℝ
  /-- Each row is in `Δ(M)`. -/
  row_mem : ∀ k, r k ∈ stdSimplex ℝ M
  /-- Each row has full support. -/
  pos : ∀ k m, 0 < r k m

namespace SignallingStructure

variable (S : SignallingStructure K M)

/-- The **Bayes operator** `φ_m` of (2.1)–(2.2), Enlighten 227272, p.4 (PDF 5), as a permutation
of the simplex: `φ_m(p)[k] = r_k[m] * p[k] / ∑ j, r_j[m] * p[j]`.

**Formalization Note.** The proof of Lemma 3.1 (p.8, PDF 9) observes that `φ_m` is invertible. The
permutation carries the explicit inverse
`p ↦ (r_k[m]⁻¹ * p[k] / ∑ j, r_j[m]⁻¹ * p[j])_k`, and `Δ(K)` is `stdSimplex ℝ K` as a subtype,
with the subspace topology. -/
noncomputable def bayes (m : M) : Equiv.Perm (stdSimplex ℝ K) where
  toFun := reweight (fun k => S.r k m) (fun k => S.pos k m)
  invFun := reweight (fun k => (S.r k m)⁻¹) (fun k => inv_pos.mpr (S.pos k m))
  left_inv := reweight_inv_reweight _ _ _ _ (fun k => inv_mul_cancel₀ (S.pos k m).ne')
  right_inv := reweight_inv_reweight _ _ _ _ (fun k => mul_inv_cancel₀ (S.pos k m).ne')

/-- The group `G` generated by `φ_1, …, φ_M` under composition, Enlighten 227272, §2.3, p.5
(PDF 6).

**Formalization Note.** `G` is the subgroup generated by the range of `bayes` inside
`Equiv.Perm (stdSimplex ℝ K)`, not the set of normalized products with exponents in `ℤ^M`; that
those coincide is the content of Lemma 3.1. -/
noncomputable def group : Subgroup (Equiv.Perm (stdSimplex ℝ K)) :=
  Subgroup.closure (Set.range S.bayes)

/-- The orbit `G(p) = {g(p) | g ∈ G}` (Enlighten 227272, §2.1.1, p.3 (PDF 4)) of a point of the
simplex under the group generated by the Bayes operators. -/
def orbit (p : stdSimplex ℝ K) : Set (stdSimplex ℝ K) :=
  {q | ∃ g ∈ S.group, g p = q}

/-- A **generic** signalling structure, Definition 2.2 of Enlighten 227272, p.5 (PDF 6): the
numbers `ln(r_k[m])`, `k ∈ K`, `m ∈ M`, are algebraically independent over `ℚ` (§2.4).

**Formalization Note.** The positivity `r_k[m] > 0` of Definition 2.2 is a field of
`SignallingStructure`. The family is indexed by `K × M`. -/
def IsGeneric : Prop :=
  AlgebraicIndependent ℚ (fun x : K × M => Real.log (S.r x.1 x.2))

/-- The composition `φ_{m_L}^{s_L} ∘ ⋯ ∘ φ_{m_1}^{s_1}` of a word, as in Lemma 3.1 of
Enlighten 227272, p.7 (PDF 8).

**Formalization Note.** The word is the list `[(m_1, s_1), …, (m_L, s_L)]`, with signs in `ℤˣ`
(that is, `±1`), and `(m_1, s_1)` is applied first. Multiplication in `Equiv.Perm` is composition,
so the list is reversed before it is multiplied. -/
noncomputable def wordPerm (w : List (M × ℤˣ)) : Equiv.Perm (stdSimplex ℝ K) :=
  (w.reverse.map fun x => S.bayes x.1 ^ (x.2 : ℤ)).prod

end SignallingStructure

/-- The exponent `u_m = #{l | m_l = m, s_l = 1} - #{l | m_l = m, s_l = -1}` of a word, Lemma 3.1 of
Enlighten 227272, p.7 (PDF 8). -/
def wordExponent [DecidableEq M] (w : List (M × ℤˣ)) (m : M) : ℤ :=
  (w.countP fun x => x.1 = m ∧ x.2 = 1 : ℕ) - (w.countP fun x => x.1 = m ∧ x.2 = -1 : ℕ)

/-- The interior `Δ⁰(K)` of the simplex, Remark 2.1 of Enlighten 227272, p.5 (PDF 6), with
`K' = K`: every coordinate is positive.

**Formalization Note.** This is the relative interior. The topological interior of the simplex in
`ℝ^K` is empty, and it is not what the paper means. -/
def IsInterior (p : stdSimplex ℝ K) : Prop :=
  ∀ k, 0 < (p : K → ℝ) k

end BayesOrbit


