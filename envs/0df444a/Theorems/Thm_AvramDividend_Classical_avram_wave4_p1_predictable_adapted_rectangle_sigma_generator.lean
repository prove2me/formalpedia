-- title:
--   Predictable sigma-algebra is generated by adapted past rectangles
-- statement:
--   For any linearly ordered time index with least element and arbitrary filtration on the original probability space, prove that the predictable sigma-algebra on time×history is exactly generated by events {0}×A (A observable at time 0) and (s,∞)×A (A observable at time s). Both directions are established from the pinned Mathlib predictable generator interface and adapted rectangle measurability. This structural theorem is the set-level starting point for proving finite adapted predictable-step L2 density; no stochastic compensation conclusion is postulated.
-- source:
--   Pinned Mathlib Probability.Process.Predictable: measurableSpace_le_predictable_of_measurableSet, measurableSet_predictable_singleton_bot_prod, measurableSet_predictable_Ioi_prod; pinned MeasurableSpace.generateFrom_le.

import Mathlib

open MeasureTheory Set
open scoped ENNReal NNReal

theorem AvramDividend.Classical.avram_wave4_p1_predictable_adapted_rectangle_sigma_generator
    {Ω ι : Type*} [mΩ : MeasurableSpace Ω]
    [LinearOrder ι] [OrderBot ι]
    (𝓕 : Filtration ι mΩ) :
    let G : Set (Set (ι × Ω)) :=
      {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
                S = ({⊥} ×ˢ A)) ∨
           (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
                S = (Set.Ioi i ×ˢ A))}
    𝓕.predictable = MeasurableSpace.generateFrom G := by sorry
