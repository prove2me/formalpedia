open scoped ENNReal NNReal
namespace DecrAlmostLinearSSSP.Decremental
lemma coreDistance_capped_bound (b : Core) (active : Finset (Fin b.input.k))
    (p : Fin b.input.n → ℝ) (hs : p b.input.source = 0) (B : ℝ) (hB : 0 ≤ B) (t : Fin b.input.n)
    (hcap : cappedDistance b.input.graph Finset.univ (coreLength b active p) B b.input.source t < B) :
    coreDistance b active t ≤ ENNReal.ofReal (p t +
      cappedDistance b.input.graph Finset.univ (coreLength b active p) B b.input.source t) := by
  obtain ⟨es, he, hcost⟩ := cappedDistance_lt_walk b.input.graph Finset.univ (coreLength b active p)
    (fun e => (coreLength_pos b active p e).le) B hB b.input.source t hcap
  simpa only [hcost] using coreDistance_ell_walk b active p hs t es he
end DecrAlmostLinearSSSP.Decremental
end s172
section s173
set_option autoImplicit false
open scoped ENNReal NNReal
namespace DecrAlmostLinearSSSP.Decremental
lemma core_Q_pos (b : Core) : 0 < Q b := by
  have hh := core_Q_ge b
  have hn : (2 : ℝ) ≤ b.input.n := by exact_mod_cast b.two
  linarith
lemma core_H_pos (b : Core) : 0 < H b := by
  have hn : (2 : ℝ) ≤ b.input.n := by exact_mod_cast b.two
  have hw : (1 : ℝ) ≤ b.input.W := by exact_mod_cast b.valid.2.2.1
  dsimp [H]
  positivity
lemma core_walk_cost_active (b : Core) (active : Finset (Fin b.input.k))
    (es : List (Fin b.input.k)) (ha : ∀ e ∈ es, e ∈ active) :
    (es.map (fun e => cost b active (.inl e))).sum =
      (es.map (fun e => (b.input.weight e : ℝ))).sum / Q b := by
  induction es with
  | nil => simp
  | cons e es ih =>
    have he := ha e List.mem_cons_self
    have hh := ih (fun f hf => ha f (List.mem_cons_of_mem e hf))
    simp only [List.map_cons,List.sum_cons,hh]
    simp only [cost,if_pos he,add_div]
lemma Walk.edges_active {n k : ℕ} {g : Digraph n k} {active : Finset (Fin k)}
    {u v : Fin n} {es : List (Fin k)} (h : Walk g active u v es) :
    ∀ e ∈ es, e ∈ active := by
  induction h with
  | nil => simp
  | cons e he h ih =>
    intro f hf
    rcases List.mem_cons.mp hf with rfl | hf
    · exact he
    · exact ih f hf
lemma Walk.restrict_active {n k : ℕ} {g : Digraph n k} {active all : Finset (Fin k)}
    {u v : Fin n} {es : List (Fin k)} (h : Walk g all u v es)
    (ha : ∀ e ∈ es, e ∈ active) : Walk g active u v es := by
  induction h with
  | nil v => exact .nil v
  | cons e he h ih =>
    exact .cons (u := g.tail e) e (ha e List.mem_cons_self)
      (ih (fun f hf => ha f (List.mem_cons_of_mem e hf)))
lemma core_deleted_edge_cost (b : Core) (active : Finset (Fin b.input.k))
    (es : List (Fin b.input.k)) (e : Fin b.input.k) (he : e ∈ es) (ha : e ∉ active) :
    H b / Q b ≤ (es.map (fun f => cost b active (.inl f))).sum := by
  have hh : cost b active (.inl e) ≤ (es.map (fun f => cost b active (.inl f))).sum := by
    apply List.single_le_sum
    · intro x hx
      obtain ⟨f,_,rfl⟩ := List.mem_map.mp hx
      exact (core_cost_bounds b active f).1
    · exact List.mem_map.mpr ⟨e,he,rfl⟩
  simpa only [cost,if_neg ha] using hh
lemma coreDistance_min (b : Core) (active : Finset (Fin b.input.k)) (v : Fin b.input.n) :
    ∃ es, Walk b.input.graph Finset.univ b.input.source v es ∧
      coreDistance b active v = ENNReal.ofReal ((es.map (fun e => cost b active (.inl e))).sum) := by
  obtain ⟨es,hw,_,hd⟩ := distance_min_weight b.input.graph Finset.univ
    (fun e => cost b active (.inl e)) (fun e => (core_cost_bounds b active e).1)
    b.input.source v (b.initially_reachable v)
  exact ⟨es,hw,hd⟩
lemma coreDistance_unreachable (b : Core) (active : Finset (Fin b.input.k))
    (v : Fin b.input.n) (hr : ¬ Reachable b.input.graph active b.input.source v) :
    ENNReal.ofReal (H b / Q b) ≤ coreDistance b active v := by
  classical
  obtain ⟨es,hw,hd⟩ := coreDistance_min b active v
  have he : ∃ e ∈ es, e ∉ active := by
    by_contra hh
    push Not at hh
    exact hr ⟨es,hw.restrict_active hh⟩
  obtain ⟨e,he,ha⟩ := he
  rw [hd]
  exact ENNReal.ofReal_le_ofReal (core_deleted_edge_cost b active es e he ha)
lemma coreDistance_reachable (b : Core) (active : Finset (Fin b.input.k))
    (v : Fin b.input.n) (hr : Reachable b.input.graph active b.input.source v) :
    ∃ d : ℝ, 0 ≤ d ∧ d ≤ (b.input.n : ℝ)*b.input.W ∧
      distance b.input.graph active (fun e => (b.input.weight e : ℝ≥0∞)) b.input.source v = ENNReal.ofReal d ∧
      coreDistance b active v = ENNReal.ofReal (d / Q b) := by
  classical
  obtain ⟨es,hw,hlen,hdist⟩ := distance_min_weight b.input.graph active
    (fun e => (b.input.weight e : ℝ)) (fun e => Nat.cast_nonneg _) b.input.source v hr
  let d : ℝ := (es.map (fun e => (b.input.weight e : ℝ))).sum
  have hd : 0 ≤ d := List.sum_nonneg (by
    intro x hx; obtain ⟨e,_,rfl⟩ := List.mem_map.mp hx; exact Nat.cast_nonneg _)
  have hdhi : d ≤ (b.input.n : ℝ)*b.input.W := by
    have hh := list_real_weight_upper b.input.weight b.input.W
      (fun e => (b.valid.2.2.2.2.2 e).2) es
    have hl : (es.length : ℝ) ≤ b.input.n := by exact_mod_cast hlen.le
    exact hh.trans (mul_le_mul_of_nonneg_right hl (Nat.cast_nonneg _))
  have hdinput : distance b.input.graph active (fun e => (b.input.weight e : ℝ≥0∞))
      b.input.source v = ENNReal.ofReal d := by
    simpa only [ENNReal.ofReal_natCast] using hdist
  have hqupper : coreDistance b active v ≤ ENNReal.ofReal (d / Q b) := by
    have hh := distance_le_walk (hw.restrict_active (fun _ _ => Finset.mem_univ _))
      (fun e => ENNReal.ofReal (cost b active (.inl e)))
    rw [list_sum_ofReal _ (fun e => (core_cost_bounds b active e).1),
      core_walk_cost_active b active es hw.edges_active] at hh
    exact hh
  obtain ⟨fs,hfs,hcore⟩ := coreDistance_min b active v
  let c : ℝ := (fs.map (fun e => cost b active (.inl e))).sum
  have hc : c ≤ d / Q b := by
    rw [hcore] at hqupper
    exact (ENNReal.ofReal_le_ofReal_iff (div_nonneg hd (core_Q_pos b).le)).mp hqupper
  have hdH : d < H b := by
    have hp := core_H_pos b
    dsimp [H] at hp ⊢
    nlinarith only [hdhi,hp]
  have hcH : c < H b / Q b := hc.trans_lt ((div_lt_div_iff_of_pos_right (core_Q_pos b)).mpr hdH)
  have hactive : ∀ e ∈ fs, e ∈ active := by
    intro e he
    by_contra ha
    exact (not_le_of_gt hcH) (core_deleted_edge_cost b active fs e he ha)
  have hclow : d / Q b ≤ c := by
    have hh := distance_le_walk (hfs.restrict_active hactive)
      (fun e => (b.input.weight e : ℝ≥0∞))
    rw [hdinput,nat_weight_list_real] at hh
    have hreal : d ≤ (fs.map (fun e => (b.input.weight e : ℝ))).sum :=
      (ENNReal.ofReal_le_ofReal_iff (List.sum_nonneg (by
        intro x hx; obtain ⟨e,_,rfl⟩ := List.mem_map.mp hx; exact Nat.cast_nonneg _))).mp hh
    have heq : c = (fs.map (fun e => (b.input.weight e : ℝ))).sum / Q b :=
      core_walk_cost_active b active fs hactive
    rw [heq]
    exact div_le_div_of_nonneg_right hreal (core_Q_pos b).le
  have heq : c = d / Q b := le_antisymm hc hclow
  exact ⟨d,hd,hdhi,hdinput,by simpa only [← heq] using hcore⟩
end DecrAlmostLinearSSSP.Decremental
end s173
section s174
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental
lemma readout_error_arithmetic {eps p z r : ℝ} (heps : 0 < eps) (heps1 : eps ≤ 1)
    (hp : 0 ≤ p) (hpz : p ≤ z) (hzp : z ≤ (1+eps/4)*p)
    (hrlo : (1-eps/8)*p ≤ r) (hrhi : r ≤ (1+eps/8)*p) :
    0 ≤ r ∧ z ≤ (1+eps/2)*r ∧ (1+eps/2)*r ≤ (1+eps)*z ∧
      (7/10 : ℝ)*z ≤ r ∧ r ≤ (9/8 : ℝ)*z := by
  have hcoeflo : 1+eps/4 ≤ (1+eps/2)*(1-eps/8) := by
    nlinarith [mul_nonneg heps.le (show 0 ≤ 2-eps by linarith)]
  have hcoefhi : (1+eps/2)*(1+eps/8) ≤ 1+eps := by
    nlinarith [mul_nonneg heps.le (show 0 ≤ 6-eps by linarith)]
  have hrpos : 0 ≤ r := (mul_nonneg (by linarith : 0 ≤ 1-eps/8) hp).trans hrlo
  refine ⟨hrpos,?_,?_,?_,?_⟩
  · calc
      z ≤ (1+eps/4)*p := hzp
      _ ≤ ((1+eps/2)*(1-eps/8))*p := mul_le_mul_of_nonneg_right hcoeflo hp
      _ = (1+eps/2)*((1-eps/8)*p) := by ring
      _ ≤ (1+eps/2)*r := mul_le_mul_of_nonneg_left hrlo (by linarith)
  · calc
      (1+eps/2)*r ≤ (1+eps/2)*((1+eps/8)*p) := mul_le_mul_of_nonneg_left hrhi (by linarith)
      _ = ((1+eps/2)*(1+eps/8))*p := by ring
      _ ≤ (1+eps)*p := mul_le_mul_of_nonneg_right hcoefhi hp
      _ ≤ (1+eps)*z := mul_le_mul_of_nonneg_left hpz (by linarith)
  · have hepsp := mul_le_mul_of_nonneg_right heps1 hp
    nlinarith only [hrlo,hzp,hepsp]
  · have hepsp := mul_le_mul_of_nonneg_right heps1 hp
    nlinarith only [hrhi,hpz,hepsp]
end DecrAlmostLinearSSSP.Decremental
end s174
