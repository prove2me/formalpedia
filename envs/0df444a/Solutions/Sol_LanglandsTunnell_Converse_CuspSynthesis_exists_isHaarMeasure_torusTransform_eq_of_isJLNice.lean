  have h : ∀ n : ↥S → ℤ, d.ad (R.rep n) * d.epsChar g₀ * ((d034 S).toReal : ℂ) *
      ∫ z in d020 S, d043 archR archC dR dC (fun v => localChar ω v * (epsS v)⁻¹) dF (R.rep n)
