theorem solution (hK : 0 < K) (hℓ : 2 ≤ ℓ) (hq1 : 1 ≤ Synth.qq ℓ K) {e14 eSw : Fin Pp} {Kc : ℝ}
    (HSw : IntMul.OpenAI.R129.P.NLogN.KFV.SwOK I iprog eSw NLogN.KFV.dW18 Kc) (hKc : 0 ≤ Kc) {p W Z B cCh U : ℕ}
    (HC : NLogN.KFV.ChunkU D ℓ K long I iprog e14 hK (by omega) p W Z cCh) (hW : p + 1 ≤ W)
    (hB : (NLogN.KFV.pLP D ℓ K long).n + ℓ + 5 ≤ B) (hNB : D * Synth.qq ℓ K + D + 1 ≤ B) (hWB : W ≤ B)
    (hbL : NLogN.KFV.bL D ℓ K long ≤ B) (hU : NLogN.KFV.TwB D ℓ K long U) :
    NLogN.KFV.LayerU (r := 2 ^ ℓ) I iprog (NLogN.KFV.Ctx18 D ℓ K long p W Z) (NLogN.KFV.fwd18 e14 eSw)
      (NLogN.KFV.procQc p (GlueLayout.paperLayout D ℓ K long hK (by omega)) ℓ (Synth.partAxes (Synth.al D ℓ long))
          (GlueLayout.paperSel D ℓ K long hK (by omega)) ℓ ∘
        AModel.pull (Synth.binSh (NLogN.KFV.pLP D ℓ K long).n) (Synth.binSh (NLogN.KFV.pLP D ℓ K long).n)
          (Synth.relabel (Synth.initL D ℓ long) (Synth.tgtL D ℓ K long)) 0)
      (2 ^ (NLogN.KFV.pLP D ℓ K long).n) p W
      (IntMul.OpenAI.R129.P.NLogN.KFV.cLayIn D ℓ K long Kc (NLogN.KFV.pLP D ℓ K long).n W B + NLogN.KFV.cFwd D ℓ K long W B cCh U) := by
  have h1 := (IntMul.OpenAI.R129.P.NLogN.KFV.layIn_ok D ℓ K long (p := p) HSw (by decide) (by decide) hKc (by decide) hK hℓ hq1
    rfl hB hNB hWB).ctx (Ctx' := NLogN.KFV.Ctx18 D ℓ K long p W Z) (fun s h => h.1)
  have h2 := (NLogN.KFV.fwdC_ok D ℓ K long hK (by omega) HC hW hbL hU (by omega)).ctx
    (Ctx' := NLogN.KFV.Ctx18 D ℓ K long p W Z) (fun s h => h.2)
  exact h1.comp h2
