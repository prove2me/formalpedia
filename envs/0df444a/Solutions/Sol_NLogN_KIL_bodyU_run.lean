    (hpos : ∀ a ∈ P :: L :: hdShape A B Cs m N, 1 ≤ a) (Bb : ℕ) (R : List Item)
    (hV : zsz ((vol (P :: L :: hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * N : ℕ) : ℤ) ≤ Bb)
    {LN LQ LX LB LC : List Item} (t : IState HS) (hNQ : t.G sNQ = .int (-(N : ℤ)) :: LN)
    (hQQ : t.G sQQ = .int (N : ℤ) :: LQ)
    (hX : t.G rX = .int ((vol (P :: L :: A) : ℕ) : ℤ) :: LX)
    (hB : t.G rVB = .int ((vol B : ℕ) : ℤ) :: LB)
    (hC : t.G rVC = .int ((vol Cs : ℕ) : ℤ) :: LC) :
    ∀ (Ts : List (TSh m)) (xs : List ℤ), (∀ T ∈ Ts, TOK T N Bb) →
      xs.length = vol (P :: L :: hdShape A B Cs m N) → Bnd Bb xs → t.G 0 = ints xs ++ R →
      Sp (stepsU m rX Ts) t
        (t.upd 0 (ints (AModel.runArr ((hdLayout A B Cs m N).cons2 P L) 0 (Ts.map (·.eval N)) xs) ++ R))
        (cStepsU rX (vol (P :: L :: hdShape A B Cs m N)) Bb Ts)
  | [], xs, _, _, _, h0 => by
    have : t.upd 0 (ints xs ++ R) = t := by rw [← h0, IState.upd_self]
    simp only [List.map_nil, AModel.runArr, List.foldl_nil, this]
    exact (Sp.skip t).mono (by simp [cStepsU])
  | T :: Ts, xs, hT, hlen, hb, h0 => by
    have h0n : (0 : Fin HS) ≠ sNQ ∧ (0 : Fin HS) ≠ sQQ ∧ (0 : Fin HS) ≠ rVB ∧
