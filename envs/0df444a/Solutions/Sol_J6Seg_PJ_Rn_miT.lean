/-!
# B5 `J` side, part K1: the capacitance row, data part

For a row `a` of the capacitance matrix (block start `c = B.st a`, length `n = B.len a`):

* `tsT c u v k` — the `TsumI` summand; `miV a u = MinvI a (c + u)` as nested `fmul`s of table
  entries and the `tsT` sum (`miV_eq`);
* the expressions of the inner loop (`r1 = c`, `r2 = n`, `r3 = u`, `r4 = k`, `r7 = a`,
  `r26 = w`, `r24 = λ`): `tUE`, `tVE` (`tU`, `tV`), the reversed-list read indices `ixAE`, `ixGE`,
  the accumulation `tmE`; their values.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function Finset

section math
variable (P : ℕ) (T : Tables) (B : Blocks)

theorem miV_eq (a u : ℕ) : miV P T B a u =
    fmul P (fmul P (T.dd (a - B.st a)) (T.di u))
      (fmul P (fmul P (T.gi (tU B.w (B.len a) (a - B.st a) u))
        (T.gi (tV B.w (B.len a) (a - B.st a) u)))
        (fmul P (∑ k ∈ range (B.len a), tsT P T (B.st a) (tU B.w (B.len a) (a - B.st a) u)
          (tV B.w (B.len a) (a - B.st a) u) k) 1)) := by
  unfold miV MinvI
  rw [TinvI_eq, TsumI_range, Nat.add_sub_cancel_left]
  simp only [fmul, mul_one, tsT]

end math

namespace E

end E

open E

section vals
variable {v : Vr} {c n a u w : ℕ}

theorem den_mxE (x y : E) : (mxE x y).den v = max (x.den v) (y.den v) := by
  simp only [mxE, E.den]; split_ifs <;> omega

theorem den_uaE (h1 : v 1 = c) (h7 : v 7 = a) (hca : c ≤ a) : uaE.den v = ((a - c : ℕ) : ℤ) := by
  simp only [uaE, E.den, h1, h7]; push_cast [hca]; ring

theorem den_tUE (h1 : v 1 = c) (h2 : v 2 = n) (h3 : v 3 = u) (h7 : v 7 = a) (h26 : v 26 = w)
    (hca : c ≤ a) (hu : u < n) : tUE.den v = (tU w n (a - c) u : ℤ) := by
  have e := den_uaE h1 h7 hca
  simp only [tUE, kcE, E.den, den_mxE, e, h2, h3, h26, tU]
  split_ifs <;> omega

theorem den_tVE (h1 : v 1 = c) (h2 : v 2 = n) (h3 : v 3 = u) (h7 : v 7 = a) (h26 : v 26 = w)
    (hca : c ≤ a) (hua : a - c < n) : tVE.den v = (tV w n (a - c) u : ℤ) := by
  have e := den_uaE h1 h7 hca
  simp only [tVE, kcE, E.den, den_mxE, e, h2, h3, h26, tV]
  split_ifs <;> omega

theorem tU_lt {w n ua u : ℕ} (hua : ua < n) (hu : u < n) : tU w n ua u < n := by
  unfold tU; split_ifs <;> omega

theorem tV_lt {w n ua u : ℕ} (hua : ua < n) (hu : u < n) : tV w n ua u < n := by
  unfold tV; split_ifs <;> omega

theorem den_ixGE {x : E} {lam j : ℕ} (h24 : v 24 = lam) (hx : x.den v = j) (hj : j < lam) :
    (ixGE x).den v = ((lam - 1 - j : ℕ) : ℤ) := by
  simp only [ixGE, E.den, h24, hx]
