theorem solution (k : Type) [Field k] (f : LaurentPolynomial k) :
    IsUnit f ↔ ∃ c : k, c ≠ 0 ∧ ∃ m : ℤ, f = LaurentPolynomial.C c * LaurentPolynomial.T m := by
