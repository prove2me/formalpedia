-- title:
--   Fact 2, p. 3 — Θ(x_k) − Θ(x*) ≤ (α−1)E(1)/(2s(k+α−2)²) and ‖z_k − x*‖² ≤ E(1)/(α−1)
-- statement:
--   Under the standing assumptions of §1 ($\Psi$ proper, lower semicontinuous and convex with values in $\mathbb R\cup\{+\infty\}$; $\Phi$ real, convex, continuously differentiable with $L$-Lipschitz gradient; $\Theta=\Psi+\Phi$; $0<s<1/L$; $\alpha\ge3$; $(x_k)$ generated by algorithm (2)), let $x^*$ minimize $\Theta$, let $z_k$ be as in (6) and $\mathcal E(k)$ the energy (5). Then for every $k\ge1$,
--   $$\Theta(x_k)-\Theta(x^*)\le\frac{(\alpha-1)\,\mathcal E(1)}{2s(k+\alpha-2)^2}\qquad\text{and}\qquad\|z_k-x^*\|^2\le\frac{\mathcal E(1)}{\alpha-1}.$$
--
--   This is the classical $O(k^{-2})$ rate for the function values of the accelerated forward-backward method, together with the boundedness of $(z_k)$.
--
--   **Formalization Note.** The paper states this for $k\ge0$ with $\mathcal E(0)$, which would require an iterate $x_{-1}$. Here the run starts at $k=1$ with $x_0,x_1$ arbitrary, and the statement is for $k\ge1$ with $\mathcal E(1)$; this is exactly what the page's argument ($\mathcal E(k)\le\mathcal E(1)$ by Fact 1) gives. Both sides are extended reals; if $\mathcal E(1)=+\infty$ the bounds hold trivially.
-- source:
--   Attouch and Peypouquet, The Rate of Convergence of Nesterov's Accelerated Forward-Backward Method is Actually Faster than 1/k^2, arXiv:1510.08740v4, p. 3, Fact 2 (stated with E(1), k >= 1, instead of the page's E(0), k >= 0)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm

open Filter Topology InnerProductSpace

namespace NesterovFB.Rates

theorem fact_2 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : NNReal) (s α : ℝ) (P : H → H) (x : ℕ → H)
    (hΨ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * L < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Ψ P)
    (hrun : IsAccelFBRun Φ P α s x)
    (hα : 3 ≤ α)
    (xstar : H) (hxstar : ∀ y, theta Ψ Φ xstar ≤ theta Ψ Φ y) :
    ∀ k : ℕ, 1 ≤ k →
      theta Ψ Φ (x k) - theta Ψ Φ xstar
          ≤ (((α - 1) / (2 * s * ((k : ℝ) + α - 2) ^ 2) : ℝ) : EReal) * energy Ψ Φ α s x xstar 1 ∧
        ((‖zSeq α x k - xstar‖ ^ 2 : ℝ) : EReal) ≤ ((1 / (α - 1) : ℝ) : EReal) * energy Ψ Φ α s x xstar 1 := by sorry

end NesterovFB.Rates
