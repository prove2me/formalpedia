      (RD LP LA LE LD LZ LL LW L55 : List NLogN.Item),
      u.G 0 = NLogN.ints (NLogN.KFB.gflat Xs) ++ R0 → u.G NLogN.KFY.dS = .int (NLogN.KFM.srcN n k : ℤ) :: RD →
      u.G NLogN.KFY.yP = .int (IntMul.OpenAI.Glue.pP n : ℤ) :: LP → u.G NLogN.KFY.yA = .int (IntMul.OpenAI.Glue.αP n : ℤ) :: LA →
      u.G NLogN.KFM.zEl = .int (IntMul.OpenAI.Glue.ℓP n : ℤ) :: LE → u.G NLogN.KFM.zD = .int (IntMul.OpenAI.Glue.dP n : ℤ) :: LD →
      u.G NLogN.KFM.zDp = .int (NLogN.KFM.dpN n : ℤ) :: LZ → u.G NLogN.KFY.yL = .int (IntMul.OpenAI.Glue.LP n : ℤ) :: LL →
      u.G NLogN.KFY.yW = .int (w : ℤ) :: LW → u.G NLogN.KFY.cX = .int ((IntMul.OpenAI.Glue.dP n : ℤ) - k) :: L55 → P Xs →
      ax.run u = ((u.upd NLogN.KFY.yS (.int (NLogN.KFM.srcN n k : ℤ) :: u.G NLogN.KFY.yS)).upd NLogN.KFY.dS RD).upd 0
          (NLogN.ints (NLogN.KFB.gflat (NLogN.KFY.stepL ((List.ofFn (NLogN.KFM.tB n)).rotate k) (fs k) Xs)) ++ R0) ∧
        ax.ok M u ∧ ax.cost M u ≤ C)
    (A B : ℕ) (hEnv : NLogN.KFM.CostEnv A B) (hpA : IntMul.OpenAI.Glue.pP n ≤ A) (hαA : IntMul.OpenAI.Glue.αP n ≤ A)
    (hlA : IntMul.OpenAI.Glue.ℓP n ≤ A) (hdlA : IntMul.OpenAI.Glue.dP n * IntMul.OpenAI.Glue.ℓP n ≤ A) (hwA : w ≤ A) (hLA : IntMul.OpenAI.Glue.LP n ≤ A)
    (hsrc : ∀ x ∈ NLogN.KFY.srcsN n, NLogN.zsz x ≤ B) :
    (NLogN.KFY.passP wP ax).run s = s.upd 0 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFY.iterL (List.ofFn (NLogN.KFM.tB n)) fs (IntMul.OpenAI.Glue.dP n) zs))
        ++ R0) ∧
      (NLogN.KFY.passP wP ax).ok M s ∧ (NLogN.KFY.passP wP ax).cost M s ≤ NLogN.KFY.passC (IntMul.OpenAI.Glue.dP n) B Cw C := by
  set p := IntMul.OpenAI.Glue.pP n with hpd
  set α := IntMul.OpenAI.Glue.αP n with hαd
  set d := IntMul.OpenAI.Glue.dP n with hdd
  set d' := NLogN.KFM.dpN n with hd'd
  set ℓ := IntMul.OpenAI.Glue.ℓP n with hℓd
  set L := IntMul.OpenAI.Glue.LP n with hLd
  set srcs := NLogN.KFY.srcsN n with hsrcs
  have hl2 := NLogN.KFY.ell_ge2 hn
  have hdp := (NLogN.KFY.dpN_lt hn).le
  have hdl := NLogN.KFY.dl_sub hn
  have hh1 : ℓ - 1 + 1 = ℓ := by omega
  have hdA : d ≤ A := le_trans (Nat.le_mul_of_pos_right d (by omega)) hdlA
  have hzs : ∀ x : ℕ, x ≤ A → NLogN.zsz (x : ℤ) ≤ B := fun x hx => hEnv.zsz_nat hx
  -- prologue
  have a1 := NLogN.KFY.proP_all s p α (ℓ - 1) d d' srcs R hdp (by rw [hD]; rfl) A B
    ⟨hpA, hαA, by omega, by rw [hh1]; exact hdlA⟩ (hzs A le_rfl)
  set t1 := NLogN.KFY.proSt s p α (ℓ - 1) d d' srcs R with ht1
  have t1P : t1.G NLogN.KFY.yP = .int (p : ℤ) :: s.G yP := by simp +decide [ht1, NLogN.KFY.proSt]
  have t1A : t1.G NLogN.KFY.yA = .int (α : ℤ) :: s.G yA := by simp +decide [ht1, NLogN.KFY.proSt]
  have a2 := hwP t1 _ _ t1P t1A
  set u0 := t1.upd NLogN.KFY.yW (.int (w : ℤ) :: t1.G NLogN.KFY.yW) with hu0
  -- the registers at u0
  have u0P : u0.G NLogN.KFY.yP = .int (p : ℤ) :: s.G yP := by simp +decide [hu0, ht1, NLogN.KFY.proSt]
  have u0A : u0.G NLogN.KFY.yA = .int (α : ℤ) :: s.G yA := by simp +decide [hu0, ht1, NLogN.KFY.proSt]
  have u0E : u0.G NLogN.KFM.zEl = .int (ℓ : ℤ) :: s.G KFM.zEl := by
    simp +decide [hu0, ht1, NLogN.KFY.proSt, hh1]
  have u0E' : u0.G NLogN.KFM.zEl = .int ((ℓ - 1 + 1 : ℕ) : ℤ) :: s.G KFM.zEl := by
    rw [u0E, hh1]
  have u0D : u0.G NLogN.KFM.zD = .int (d : ℤ) :: s.G KFM.zD := by simp +decide [hu0, ht1, NLogN.KFY.proSt]
  have u0Z : u0.G NLogN.KFM.zDp = .int (d' : ℤ) :: s.G KFM.zDp := by simp +decide [hu0, ht1, NLogN.KFY.proSt]
  have u0L : u0.G NLogN.KFY.yL = .int (L : ℤ) :: s.G yL := by
    simp +decide [hu0, ht1, NLogN.KFY.proSt, hh1]; rw [hdl]
  have u0W : u0.G NLogN.KFY.yW = .int (w : ℤ) :: s.G yW := by simp +decide [hu0, ht1, NLogN.KFY.proSt]
  have u00 : u0.G 0 = NLogN.ints (NLogN.KFB.gflat zs) ++ R0 := by simp +decide [hu0, ht1, NLogN.KFY.proSt, h0]
  have u0S : u0.G NLogN.KFY.dS = NLogN.ints srcs ++ R := by simp +decide [hu0, ht1, NLogN.KFY.proSt]
  have u0Y : u0.G NLogN.KFY.yS = s.G yS := by simp +decide [hu0, ht1, NLogN.KFY.proSt]
  have u0o : ∀ j, j ∉ NLogN.KFY.regsP → j ≠ 0 → j ≠ NLogN.KFY.dS → u0.G j = s.G j := by
    intro j hj h1 h2
    have e1 : j ≠ yP := fun e => hj (by subst e; decide)
    have e2 : j ≠ yA := fun e => hj (by subst e; decide)
    have e3 : j ≠ KFM.zEl := fun e => hj (by subst e; decide)
    have e4 : j ≠ KFM.zD := fun e => hj (by subst e; decide)
    have e5 : j ≠ KFM.zDp := fun e => hj (by subst e; decide)
    have e6 : j ≠ yL := fun e => hj (by subst e; decide)
    have e7 : j ≠ yW := fun e => hj (by subst e; decide)
    simp +decide [hu0, ht1, NLogN.KFY.proSt, e1, e2, e3, e4, e5, e6, e7, h2]
  -- the loop
  have hsl : srcs.length = d := NLogN.KFY.srcsN_length n
  have hLoop := NLogN.KFY.loop_all M ax hw u0 d (List.ofFn (NLogN.KFM.tB n)) fs srcs hsl zs R0 R (s.G NLogN.KFM.zD) u00 u0S
    u0D P hP0 hPstep C (by
      intro k hk u Xs RD L55 g h0' hD' h55 hPX
      have gP : u.G NLogN.KFY.yP = .int (p : ℤ) :: s.G yP := by
        rw [g _ (by decide) (by decide) (by decide) (by decide)]; exact u0P
      have gA : u.G NLogN.KFY.yA = .int (α : ℤ) :: s.G yA := by
        rw [g _ (by decide) (by decide) (by decide) (by decide)]; exact u0A
      have gE : u.G NLogN.KFM.zEl = .int (ℓ : ℤ) :: s.G KFM.zEl := by
        rw [g _ (by decide) (by decide) (by decide) (by decide)]; exact u0E
      have gD : u.G NLogN.KFM.zD = .int (d : ℤ) :: s.G KFM.zD := by
        rw [g _ (by decide) (by decide) (by decide) (by decide)]; exact u0D
      have gZ : u.G NLogN.KFM.zDp = .int (d' : ℤ) :: s.G KFM.zDp := by
        rw [g _ (by decide) (by decide) (by decide) (by decide)]; exact u0Z
      have gL : u.G NLogN.KFY.yL = .int (L : ℤ) :: s.G yL := by
        rw [g _ (by decide) (by decide) (by decide) (by decide)]; exact u0L
      have gW : u.G NLogN.KFY.yW = .int (w : ℤ) :: s.G yW := by
        rw [g _ (by decide) (by decide) (by decide) (by decide)]; exact u0W
      rw [hsrcs, NLogN.KFY.srcsN_getD n k hk] at hD' ⊢
      exact Hstep k hk u Xs RD _ _ _ _ _ _ _ L55 h0' hD' gP gA gE gD gZ gL gW h55 hPX)
    B (hzs d hdA)
  set v := NLogN.KFY.loopSt u0 srcs R R0 (List.ofFn (NLogN.KFM.tB n)) fs zs d with hv
  -- epilogue
  have vo : ∀ j, j ≠ 0 → j ≠ NLogN.KFY.dS → j ≠ NLogN.KFY.yS → v.G j = u0.G j := fun j h1 h2 h3 => by
    simp +decide [hv, NLogN.KFY.loopSt, h1, h2, h3]
  have vS : v.G NLogN.KFY.yS = NLogN.ints srcs.reverse ++ s.G yS := by
    simp +decide [hv, NLogN.KFY.loopSt, u0Y]; rw [List.take_of_length_le (by omega)]
  have vD : v.G NLogN.KFY.dS = R := by
    simp +decide [hv, NLogN.KFY.loopSt]; rw [List.drop_of_length_le (by omega)]; simp +decide [NLogN.ints]
  have a4 := NLogN.KFY.epiP_all v p α (ℓ - 1) d d' w L srcs R (s.G NLogN.KFY.yS) hsl vS vD _ _ _ _ _ _ _
    (by rw [vo _ (by decide) (by decide) (by decide)]; exact u0P)
    (by rw [vo _ (by decide) (by decide) (by decide)]; exact u0A)
    (by rw [vo _ (by decide) (by decide) (by decide)]; exact u0E')
    (by rw [vo _ (by decide) (by decide) (by decide)]; exact u0D)
    (by rw [vo _ (by decide) (by decide) (by decide)]; exact u0Z)
    (by rw [vo _ (by decide) (by decide) (by decide)]; exact u0L)
    (by rw [vo _ (by decide) (by decide) (by decide)]; exact u0W)
    A B hEnv ⟨hpA, hαA, by omega, hdA, by omega, hLA, hwA⟩ hsrc
  have hfin : NLogN.KFY.epiSt v (s.G NLogN.KFY.yS) (NLogN.KFY.descL p α (ℓ - 1) d d' srcs) R =
      s.upd 0 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFY.iterL (List.ofFn (NLogN.KFM.tB n)) fs d zs)) ++ R0) := by
    apply NLogN.IState.ext' _ (by simp +decide [NLogN.KFY.epiSt, hv, NLogN.KFY.loopSt, hu0, ht1, NLogN.KFY.proSt])
      (by simp +decide [NLogN.KFY.epiSt, hv, NLogN.KFY.loopSt, hu0, ht1, NLogN.KFY.proSt])
    intro j
    simp only [NLogN.KFY.epiSt]
    by_cases hj : j ∈ NLogN.KFY.regsP
    · rw [if_pos hj]
      have j0 : j ≠ 0 := by intro e; subst e; revert hj; decide
      have jD : j ≠ dS := by intro e; subst e; revert hj; decide
      have jS : j ≠ yS := by intro e; subst e; revert hj; decide
      rw [vo j j0 jD jS]
      simp only [NLogN.KFY.regsP, List.mem_cons, List.not_mem_nil, or_false] at hj
      rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · rw [u0W]; simp +decide
      · rw [u0L]; simp +decide
      · rw [u0Z]; simp +decide
      · rw [u0D]; simp +decide
      · rw [u0E]; simp +decide
      · rw [u0A]; simp +decide
      · rw [u0P]; simp +decide
    · rw [if_neg hj]
      by_cases jS : j = NLogN.KFY.yS
      · subst jS; simp +decide
      rw [if_neg jS]
      by_cases jD : j = NLogN.KFY.dS
      · subst jD; simp +decide [hD, hsrcs]
      rw [if_neg jD]
      by_cases j0 : j = 0
      · subst j0; simp +decide [hv, NLogN.KFY.loopSt]
      rw [vo j j0 jD jS, u0o j hj j0 jD]
      simp +decide [j0]
  rw [hfin] at a4
  have A1 : (NLogN.RM.rs (.seq NLogN.KFY.proP wP)).run s = u0 ∧ (NLogN.RM.rs (.seq NLogN.KFY.proP wP)).ok M s ∧
      (NLogN.RM.rs (.seq NLogN.KFY.proP wP)).cost M s ≤ NLogN.KFY.proC d B + Cw := NLogN.KFY.rs_all M _ _ _ _ (a1.seq a2)
  have A3 := NLogN.KFY.rs_all M _ _ _ _ a4
  have A23 := NLogN.GL.seq_all _ _ u0 v _ _ _ hLoop A3
  have H := NLogN.GL.seq_all _ _ s u0 _ _ _ A1 A23
  exact ⟨H.1, H.2.1, le_trans H.2.2 (le_of_eq (by first | rfl | (unfold passC; simp only [hdd]) | (unfold passC; subst hdd; rfl)))⟩
end
