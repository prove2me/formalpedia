positive-side `EqOn` derivative transport, independent of the regularity order). -/
theorem residuals_of_finite6 (hP : PaperData I f m N w p a) (hN : FactorizedN I N s h)
    (hB : PaperBVP I f m N w p a Q J) (hS : FiniteBranch6 I s ε f m a F b A) :
    (∀ x ∈ Set.Ioo 0 ε, realPM h Q J F b A x = 0) ∧
    (∀ x ∈ Set.Ioo 0 ε, realPA h Q J F b A x = 0) ∧
    (∀ x ∈ Set.Ioo 0 ε, realPC h Q J F b A x = 0) := by
  have hbr := vii04_compactified_bridge_Ioo hP hN hB hS.eps_pos hS.chart_tail
  refine ⟨fun x hx => ?_, fun x hx => ?_, fun x hx => ?_⟩
  · rw [realPM_congr isOpen_Ioo hS.matchF hS.matchb hS.matchA hx]; exact (hbr x hx).2.1
  · rw [realPA_congr isOpen_Ioo hS.matchF hS.matchb hS.matchA hx]; exact (hbr x hx).2.2.1
  · rw [realPC_congr isOpen_Ioo hS.matchF hS.matchb hS.matchA hx]; exact (hbr x hx).2.2.2.1

/-- The actual `realGamma` of the finite extension is `(1 - h x)² G(s + 1/x)` on `(0, ε)`. -/
theorem realGamma_of_finite6 (hP : PaperData I f m N w p a) (hN : FactorizedN I N s h)
    (hB : PaperBVP I f m N w p a Q J) (hS : FiniteBranch6 I s ε f m a F b A) {x : ℝ}
    (hx : x ∈ Set.Ioo 0 ε) :
    realGamma h Q J F b A x = (1 - h * x) ^ 2 * Gfun p a (s + x⁻¹) := by
  have hbr := vii04_compactified_bridge_Ioo hP hN hB hS.eps_pos hS.chart_tail
  rw [realGamma_congr isOpen_Ioo hS.matchF hS.matchb hS.matchA hx, (hbr x hx).2.2.2.2]

/-- **VII13 root 4.** Physical BVP and finite branch ⇒ actual residuals and complete jet output. -/
theorem vii13_radial_recursion (hP : PaperData I f m N w p a) (hN : FactorizedN I N s h)
    (hB : PaperBVP I f m N w p a Q J) (hS : FiniteBranch6 I s ε f m a F b A) :
    RadialFiniteJetOutput ε h Q J F b A := by
  obtain ⟨hPM, hPA, hPC⟩ := residuals_of_finite6 hP hN hB hS
  exact ⟨hPM, hPA, hPC,
    vii13_compact_recursion hS.eps_pos hS.cF hS.cb hS.cA hS.F0 hS.b0 hS.A0 hPM hPA hPC⟩

/-- **VII13 root 5.** Root 4's inputs plus the **extra** actual `G = 0` on the chart tail ⇒
actual compact `Γ = 0` on `(0, ε)` and the complete compact finite obstruction. -/
theorem vii13_radial_obstruction (hP : PaperData I f m N w p a) (hN : FactorizedN I N s h)
    (hB : PaperBVP I f m N w p a Q J) (hS : FiniteBranch6 I s ε f m a F b A)
    (hG : ∀ R ∈ Set.Ioi (s + ε⁻¹), Gfun p a R = 0) :
    RadialFiniteObstructionOutput ε h Q J F b A := by
  obtain ⟨hPM, hPA, hPC⟩ := residuals_of_finite6 hP hN hB hS
  have hΓ : ∀ x ∈ Set.Ioo 0 ε, realGamma h Q J F b A x = 0 := fun x hx => by
    rw [realGamma_of_finite6 hP hN hB hS hx, hG _ (FiniteBranch6.tail_mem hS hx), mul_zero]
  exact ⟨vii13_radial_recursion hP hN hB hS, hΓ,
    vii13_compact_obstruction hS.eps_pos hS.cF hS.cb hS.cA hS.F0 hS.b0 hS.A0 hPM hPA hPC hΓ⟩

end RadialSide

