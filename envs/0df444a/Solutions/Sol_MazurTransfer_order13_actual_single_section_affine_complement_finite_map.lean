theorem recoveredReciprocalPatch_tau (h2 : IsUnit (2 : R)) :
    recoveredReciprocalPatch R h2 (Order13SingleSectionReciprocalPatch.tau R) = infinityParameter R := by
  rw [Order13SingleSectionReciprocalPatch.tau_eq_z_mul_mu,map_mul,
    recoveredReciprocalPatch_z,recoveredReciprocalPatch_mu]
  dsimp [infinityRecoveredZ]
  linear_combination (infinityParameter R) * infinityP_mul_inverse R

theorem infinity_p_squared : infinityP R ^ 2 = infinityParameter R * infinityQ R - 2 * infinityP R := by
  have h : pElement R ^ 2 = parameterElement R * qElement R - 2 * pElement R := by
    apply Subtype.val_injective
    change p R ^ 2 = (parameterElement R : MazurTorsion.XOneThirteenAffineCurve.CoordinateRing R) * q R - 2 * p R
    rw [parameterElement_coe];exact p_squared R
  simpa only [map_pow,map_sub,map_mul,_root_.map_ofNat,infinityParameter,infinityP,infinityQ]
    using congrArg (algebraMap (candidateAlgebra R) (infinityLocalization R)) h

theorem infinity_twice_p_mul_q :
    2 * infinityP R * infinityQ R = infinityParameter R ^ 3 -
      2 * infinityParameter R ^ 2 - 2 * infinityParameter R * infinityQ R := by
  have h : 2 * pElement R * qElement R = parameterElement R ^ 3 -
      2 * parameterElement R ^ 2 - 2 * parameterElement R * qElement R := by
    apply Subtype.val_injective
    change 2 * p R * q R = (parameterElement R : MazurTorsion.XOneThirteenAffineCurve.CoordinateRing R) ^ 3 -
      2 * (parameterElement R : MazurTorsion.XOneThirteenAffineCurve.CoordinateRing R) ^ 2 -
      2 * (parameterElement R : MazurTorsion.XOneThirteenAffineCurve.CoordinateRing R) * q R
    rw [parameterElement_coe];exact twice_p_mul_q R
  simpa only [map_pow,map_sub,map_mul,_root_.map_ofNat,infinityParameter,infinityP,infinityQ]
    using congrArg (algebraMap (candidateAlgebra R) (infinityLocalization R)) h

theorem infinityQ_mul_second_denominator :
    infinityQ R * (infinityRecoveredD R + 2 * infinityRecoveredZ R ^ 3) =
      2 * infinityRecoveredZ R ^ 2 * (1 + infinityRecoveredZ R) * infinityP R := by
  have hq : 2 * infinityQ R * (infinityP R + infinityParameter R) =
      infinityParameter R ^ 2 * (infinityParameter R - 2) := by
    linear_combination infinity_twice_p_mul_q R
  have htq : infinityParameter R * infinityQ R = infinityP R * (infinityP R + 2) := by
    linear_combination -(infinity_p_squared R)
  dsimp [infinityRecoveredD,infinityRecoveredZ]
  calc
    _ = 2 * (2 * infinityQ R * (infinityP R + infinityParameter R)) * infinityPInverse R ^ 2 +
      2 * infinityParameter R ^ 2 * infinityPInverse R ^ 2 *
        (infinityParameter R * infinityQ R * infinityPInverse R) := by
      linear_combination -(4 * infinityQ R * infinityPInverse R) * infinityP_mul_inverse R
    _ = 2 * (infinityParameter R ^ 2 * (infinityParameter R - 2)) * infinityPInverse R ^ 2 +
      2 * infinityParameter R ^ 2 * infinityPInverse R ^ 2 *
        (infinityP R * (infinityP R + 2) * infinityPInverse R) := by rw [hq,htq]
    _ = _ := by
      linear_combination
        (2 * infinityParameter R ^ 2 * infinityPInverse R ^ 2 * (infinityP R + 2) -
          2 * infinityParameter R ^ 3 * infinityPInverse R ^ 2) * infinityP_mul_inverse R

theorem reciprocal_nu_mul_DPrime :
    Order13SingleSectionReciprocalPatch.nu R * Order13SingleSectionReciprocalPatch.DPrime R =
      2 * Order13SingleSectionReciprocalPatch.z R ^ 2 *
        (1 + Order13SingleSectionReciprocalPatch.z R) * Order13SingleSectionReciprocalPatch.mu R := by
  dsimp [Order13SingleSectionReciprocalPatch.nu,Order13SingleSectionReciprocalPatch.mu]
  linear_combination
    (8 * Order13SingleSectionReciprocalPatch.z R ^ 2 * (1 + Order13SingleSectionReciprocalPatch.z R) ^ 2 *
      Order13SingleSectionReciprocalPatch.dInverse R) *
        Order13SingleSectionReciprocalPatch.DPrime_mul_dPrimeInverse R

theorem recoveredReciprocalPatch_nu (h2 : IsUnit (2 : R)) :
    recoveredReciprocalPatch R h2 (Order13SingleSectionReciprocalPatch.nu R) = infinityQ R := by
  have hu : IsUnit (recoveredReciprocalPatch R h2 (Order13SingleSectionReciprocalPatch.DPrime R)) :=
    (Order13SingleSectionReciprocalPatch.DPrime_isUnit R).map (recoveredReciprocalPatch R h2)
  apply hu.mul_left_inj.mp
  have h := congrArg (recoveredReciprocalPatch R h2) (reciprocal_nu_mul_DPrime R)
  simp only [map_mul,map_add,map_pow,map_one,_root_.map_ofNat,
    recoveredReciprocalPatch_z,recoveredReciprocalPatch_mu] at h
