-- title:
--   Actual populations, printed intensity laws and lower-orthant order
-- statement:
--   Active-label populations range over unbounded natural counts. The printed ordinary and virtual generators use the decomposition birth rates and the exact greedy or all-compatible passive-depletion rates, with death disabled at zero and a conservative diagonal. Their laws are generated by pure jump execution starting empty. Actual policy populations are also defined directly from the chronological matching execution: they are kept separate because the unsaturated labeling formula need not have the printed birth intensity. Lower-orthant order is the source’s coordinatewise CDF comparison. Boundary coordinates encode the image of the B.6 map. Published birth–death balance vocabulary defines the virtual stationary equations without asserting convergence. The missing off-diagonal restriction in the virtual diagonal sum on PDF 48 is read as the conservative convention used for the ordinary and coordinate generators (I4).
-- source:
--   Aouad and Sarıtaç (2022), Dynamic Stochastic Matching Under Limited Time, https://doi.org/10.1287/opre.2022.2293, held published-basis manuscript, B.4 and B.6, printed 46–48, 50–51 / PDF 47–49, 51–52

import Definitions.Def_DynStochMatching_Reward_Compatibility
import Definitions.Def_DynStochMatching_Reward_PureJump
import Definitions.Def_QueueingFundamentals_BirthDeath_Balance

open MeasureTheory Filter
open scoped Classical ENNReal

namespace DynStochMatching.Reward

abbrev LabelIndex (n : ℕ) := Fin n × Fin n
abbrev CountState (n : ℕ) := LabelIndex n → ℕ

noncomputable def liveLabels {n : ℕ} (x : Flow n) : Finset (LabelIndex n) :=
  Finset.univ.filter (fun a => a.2.val < (support x a.1).length)

noncomputable def increase {n : ℕ} (s : CountState n) (a : LabelIndex n) : CountState n :=
  Function.update s a (s a + 1)
noncomputable def decrease {n : ℕ} (s : CountState n) (a : LabelIndex n) : CountState n :=
  Function.update s a (s a - 1)

noncomputable def greedyLabel {n : ℕ} (D : Instance n) (x : Flow n)
    (s : CountState n) (j : Fin n) : Option (LabelIndex n) :=
  (((List.finRange n).flatMap (fun i => (List.finRange n).map (fun l => (i, l)))).filter
    (fun a => a ∈ liveLabels x ∧ 0 < s a ∧ j ∈ compatibility x a.1 a.2.val)).mergeSort
      (fun a b => if D.reward a.1 j = D.reward b.1 j then
        if a.1 = b.1 then a.2.val ≤ b.2.val else a.1.val < b.1.val
      else D.reward a.1 j > D.reward b.1 j) |>.head?

noncomputable def birthRate {n : ℕ} (D : Instance n) (x : Flow n)
    (a : LabelIndex n) : ℝ :=
  if a ∈ liveLabels x then decomposition D x a.1 a.2.val else 0

noncomputable def deathRate {n : ℕ} (D : Instance n) (x : Flow n)
    (virtual : Bool) (s : CountState n) (a : LabelIndex n) : ℝ :=
  if a ∈ liveLabels x ∧ 0 < s a then
    (s a : ℝ) * finiteDeathRate (D.lifetime a.1) +
      ∑ j, if (if virtual then j ∈ compatibility x a.1 a.2.val
        else greedyLabel D x s j = some a) then passiveRate x j else 0
  else 0

/-- The printed intensity matrices (28)-(31), with zero-coordinate deaths excluded. -/
noncomputable def countJumpSystem {n : ℕ} (D : Instance n) (x : Flow n)
    (virtual : Bool) : JumpSystem (CountState n) (Fintype.card (Bool × LabelIndex n)) where
  initial := fun _ => 0
  rate s k := let (birth, a) := (Fintype.equivFin (Bool × LabelIndex n)).symm k
              if birth then birthRate D x a else deathRate D x virtual s a
  next s k := let (birth, a) := (Fintype.equivFin (Bool × LabelIndex n)).symm k
              if birth then increase s a else decrease s a

/-- Matrix entries, including a conservative diagonal. -/
noncomputable def countGenerator {n : ℕ} (D : Instance n) (x : Flow n)
    (virtual : Bool) (s z : CountState n) : ℝ :=
  if z = s then -(∑ a, (birthRate D x a + deathRate D x virtual s a))
  else ∑ a, ((if z = increase s a then birthRate D x a else 0) +
    (if 0 < s a ∧ z = decrease s a then deathRate D x virtual s a else 0))

noncomputable def countProcess {n : ℕ} (D : Instance n) (x : Flow n)
    (virtual : Bool) (t : ℝ) (ω : RandomSeeds) : CountState n :=
  jumpAt (countJumpSystem D x virtual) ω t

/-- Actual right-limit active populations from the chronological matching execution.
This remains separate from the printed intensity law when its normalization identity fails. -/
noncomputable def executionCounts {n : ℕ} (D : Instance n) (x : Flow n)
    (t : ℝ) (ω : RandomSeeds) : CountState n :=
  fun a => ∑' k : ℕ,
    if arrivalType D.toMarkedPoissonData ω k = some a.1 ∧
      agentLabel D x ω k = .active a.2.val ∧
      arrivalTime D.toMarkedPoissonData ω k ≤ t ∧ t < departureTime D ω k ∧
      unmatchedAt (compatibilityPolicy D x) ω k t then 1 else 0

/-- The source uses lower-orthant probabilities, rather than the usual upper-set order. -/
noncomputable def lowerOrthantOrder {n : ℕ} (X Y : RandomSeeds → CountState n) : Prop :=
  ∀ s, seedLaw {ω | X ω ≤ s} ≥ seedLaw {ω | Y ω ≤ s}

noncomputable def emptyProbability {n : ℕ} (D : Instance n) (x : Flow n)
    (I : Finset (LabelIndex n)) (t : ℝ) : ℝ :=
  (seedLaw {ω | ∑ a ∈ I, countProcess D x true t ω a = 0}).toReal

/-- Image of the boundary map φ in B.6, represented without a choice of inverse. -/
noncomputable def boundaryCoordinates {n : ℕ} (D : Instance n) (x : Flow n)
    (y : CountState n) (A : Set (CountState n)) : Set (LabelIndex n) :=
  {a | 0 < y a ∧ decrease y a ∉ A ∧ 0 < countGenerator D x false y (decrease y a)}

noncomputable def virtualBalance {n : ℕ} (D : Instance n) (x : Flow n)
    (a : LabelIndex n) (p : ℕ → ℝ) : Prop :=
  QueueingFundamentals.BirthDeath.IsSteadyState (fun _ => birthRate D x a)
    (fun k => (k : ℝ) * finiteDeathRate (D.lifetime a.1) +
      ∑ j ∈ compatibility x a.1 a.2.val, passiveRate x j) p

end DynStochMatching.Reward


