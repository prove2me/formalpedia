section ArchProfileBounds

open Matrix

namespace ArchIwasawa

section Generic

variable {A : Type*} [CommRing A]

private theorem t0175 (t x : A) (M : Matrix (Fin 2) (Fin 2) A) :
    !![t, 0; 0, 1] * (!![1, x; 0, 1] * M) = !![1, t * x; 0, 1] * (!![t, 0; 0, 1] * M) := by
  rw [← Matrix.mul_assoc, ← Matrix.mul_assoc]
  congr 1
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

private theorem t0176 (t r : A) (M : Matrix (Fin 2) (Fin 2) A) :
    !![t, 0; 0, 1] * (r • M) = r • (!![t, 0; 0, 1] * M) :=
  Matrix.mul_smul _ _ _

private theorem t0177 (t y : A) (k : Matrix (Fin 2) (Fin 2) A) :
    !![t, 0; 0, 1] * (!![y, 0; 0, 1] * k) = !![t * y, 0; 0, 1] * k := by
  rw [← Matrix.mul_assoc]
  congr 1
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

private theorem t0178 (t x r y : A) (k : Matrix (Fin 2) (Fin 2) A) :
    !![t, 0; 0, 1] * (!![1, x; 0, 1] * (r • (!![y, 0; 0, 1] * k)))
      = !![1, t * x; 0, 1] * (r • (!![t * y, 0; 0, 1] * k)) := by
  rw [t0175, t0176, t0177]

end Generic
