section gen
variable {d : ℕ} (p : ℕ) (s t : Fin d → ℕ) [∀ i, NeZero (s i)] [∀ i, NeZero (t i)]

theorem tensorGo_mapsGen (Aa : ℕ → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ)) (hst : ∀ i, s i ≤ t i)
    (hloc : ∀ i : Fin d, ∀ U U' : ℕ → ℤ × ℤ, (∀ j < s i, U j = U' j) → Aa i U = Aa i U')
    (zs : List GI) (hz : zs.length = (List.ofFn t).prod) :
    tensorGo (mapsGen t Aa) (List.ofFn t) zs = listOf (List.ofFn t) fun j =>
      tensorMapZ (fun i : Fin d => Aa i) (gIn (List.ofFn t) zs) fun i => j i := by
  have hpos : ∀ i < d, 0 < (List.ofFn t).getD i 1 := fun i hi => by
    rw [ofFn_getD t ⟨i, hi⟩]; exact Nat.pos_of_ne_zero (NeZero.ne _)
  have h := tensorGo_eq d (List.ofFn t) (List.ofFn t) (by simp) (by simp) hpos Aa
    (fun i hi U U' h => hloc ⟨i, hi⟩ U U' (fun j hj => h j (by
        rw [ofFn_getD t ⟨i, hi⟩]; exact lt_of_lt_of_le hj (hst _))))
    (gIn (List.ofFn t) zs)
  rw [listOf_gIn (List.ofFn t) (by simp) zs hz] at h
  exact h

/-- **The generic `A` pass.** -/
theorem passGen_sol_aux (Aa : ℕ → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ)) (hst : ∀ i, s i ≤ t i)
    (hloc : ∀ i : Fin d, ∀ U U' : ℕ → ℤ × ℤ, (∀ j < s i, U j = U' j) → Aa i U = Aa i U')
    (L : (i : Fin d) → (ZMod (s i) → ℂ) →L[ℂ] (ZMod (t i) → ℂ)) (hLn : ∀ i, ‖L i‖ ≤ 1)
    (ε : ℝ) (hε : 0 ≤ ε) (hA : ∀ i : Fin d, FPApprox p (Aa i) (liftL (L i)) ε)
    (zs : List GI) (u : ((i : Fin d) → ZMod (s i)) → ℂ)
    (hrep : RepPad p s t zs u) (hu : ‖u‖ ≤ 1 / 2) :
    RepFull p t (tensorGo (mapsGen t Aa) (List.ofFn t) zs)
        (wOf p t (tensorGo (mapsGen t Aa) (List.ofFn t) zs)) ∧
      DiscL p (tensorGo (mapsGen t Aa) (List.ofFn t) zs) ∧
      ‖wOf p t (tensorGo (mapsGen t Aa) (List.ofFn t) zs) - tensCLM (kerA L) u‖ ≤
        d * ε * hp p := by
  rw [tensorGo_mapsGen s t Aa hst hloc zs hrep.1]
  set U := gIn (d := d) (List.ofFn t) zs with hU
  set Ab := fun i : Fin d => Aa i with hAb
  set LL := listOf (List.ofFn t) fun j => tensorMapZ Ab U fun i => j i with hLL
  have hUd : InDisc p U := fun j => repPad_disc p s t hrep (by linarith) _
  obtain ⟨h1, h2⟩ := tensor_fp p Ab L (fun _ => ε) hA (fun i => supLip_liftL (L i) (hLn i)) U hUd
  have hp0 : (0 : ℝ) < 2 ^ p := by positivity
  have hu' : (fun k : (i : Fin d) → ZMod (s i) => gC (U fun i => (k i).val) / 2 ^ p) = u := by
    funext k
    obtain ⟨hx, hdig⟩ := box_pt t (fun i => (k i).val) (fun i =>
      lt_of_lt_of_le (ZMod.val_lt _) (hst i))
    have hin : ∀ i, boxIx t (rmPos (List.ofFn t) (extF fun i => (k i).val)) i < s i := by
      intro i
      simp only [boxIx, hdig, extF, dif_pos i.2]
      exact ZMod.val_lt _
    simp only [hU, gIn]
    rw [(hrep.2 _ hx).1 hin]
    have : (fun i => (((boxIx t (rmPos (List.ofFn t) (extF fun i => (k i).val)) i : ℕ) :
        ZMod (s i)))) = k := by
      funext i; simp only [boxIx, hdig, extF, dif_pos i.2]; simp
    rw [this]; field_simp
  have hLl : LL.length = (List.ofFn t).prod := length_listOf _ _
  refine ⟨⟨hLl, fun x hx => ?_⟩, ?_, ?_⟩
  · simp only [wOf]
    have hv : ∀ i : Fin d, ((boxIx t x i : ℕ) : ZMod (t i)).val = digL (List.ofFn t) x i := by
      intro i
      have := digL_lt (List.ofFn t) (ofFn_pos t) x i (by simp)
      simp only [List.getElem_ofFn] at this
      exact val_cast_lt this
    simp only [hv]
    rw [extF_digL, rmPos_digL _ x hx]
    field_simp
  · intro z hz
    simp only [hLL, listOf, List.mem_map] at hz
    obtain ⟨l, -, rfl⟩ := hz
    exact h1 _
  · refine (pi_norm_le_iff_of_nonneg (by unfold hp; positivity)).2 fun pt => ?_
    obtain ⟨hx, hdig⟩ := box_pt t (fun i => (pt i).val) (fun i => ZMod.val_lt _)
    have hval : wOf p t LL pt = gC (tensorMapZ Ab U fun i => (pt i).val) / 2 ^ p := by
      simp only [wOf]
      rw [getD_listOf' _ _ _ hx, hdig]
      simp [extF]
    rw [Pi.sub_apply, hval, tensCLM_apply, kerA_eq_kerL]
    have e2 := h2 (fun i => (pt i).val)
    rw [hu'] at e2
    simp only [ZMod.natCast_zmod_val] at e2
    have : gC (tensorMapZ Ab U fun i => (pt i).val) / 2 ^ p - tens (kerL L) u pt =
        (gC (tensorMapZ Ab U fun i => (pt i).val) - 2 ^ p * tens (kerL L) u pt) / 2 ^ p := by
      field_simp
    rw [this, norm_div, norm_pow, RCLike.norm_ofNat, div_le_iff₀ hp0]
    refine e2.trans (le_of_eq ?_)
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, hp]
    rw [mul_assoc, ← mul_pow, inv_mul_cancel₀ (by norm_num : (2 : ℝ) ≠ 0), one_pow, mul_one]

end gen

end J6A

end

theorem solution : type_of% @J6A.passGen_sol_aux := @J6A.passGen_sol_aux
