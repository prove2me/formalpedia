/- BEGIN Definitions.SCAFFOLD.ServerNoise -/
section SCAFFOLDBundleModule18
/-!
Server oracle-noise estimate for Karimireddy et al., SCAFFOLD,
arXiv:1910.06378v4, Section 5, PDF p. 5, Theorem III; Appendix E,
PDF pp. 26-27, Lemma 12, and PDF pp. 31-32, Lemma 16.
Fresh noise and retained control errors are treated separately. The cross term
cancels after conditioning on the completed virtual paths and averaging the
finite uniform sampling law; stored errors need not be independent.
-/

noncomputable section
open MeasureTheory
open scoped BigOperators InnerProductSpace
namespace SCAFFOLD

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

def meanStoredError (A : Run P ν S K T ηl ηg init) (r : ℕ) (ω : Ω) : Space d :=
  (N : ℝ)⁻¹ • ∑ i, storedError A r i ω

def fixedFreshNoise (A : Run P ν S K T ηl ηg init) (r : ℕ)
    (B : Finset (Fin N)) (ω : Ω) : Space d :=
  (S : ℝ)⁻¹ • ∑ i ∈ B, averageNoise A r i ω

def fixedStoredNoise (A : Run P ν S K T ηl ηg init) (r : ℕ)
    (B : Finset (Fin N)) (ω : Ω) : Space d :=
  meanStoredError A r ω - (S : ℝ)⁻¹ • ∑ i ∈ B, storedError A r i ω

def sampledFreshNoise (A : Run P ν S K T ηl ηg init) (r : ℕ) (ω : Ω) : Space d :=
  fixedFreshNoise A r (A.sample r ω) ω

def centeredStoredNoise (A : Run P ν S K T ηl ηg init) (r : ℕ) (ω : Ω) : Space d :=
  fixedStoredNoise A r (A.sample r ω) ω

def serverNoise (A : Run P ν S K T ηl ηg init) (r : ℕ) (ω : Ω) : Space d :=
  sampledFreshNoise A r ω + centeredStoredNoise A r ω

theorem Run.meanStoredError_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) : MemLp (meanStoredError A r) 2 ν :=
  (memLp_finsetSum Finset.univ (fun i _ ↦ A.storedError_memLp hr i)).const_smul (N : ℝ)⁻¹

theorem Run.meanStoredError_adapted (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) : StronglyMeasurable[A.history (roundTime K r)] (meanStoredError A r) :=
  (Finset.stronglyMeasurable_fun_sum Finset.univ
    (fun i _ ↦ A.storedError_adapted hr i)).const_smul (N : ℝ)⁻¹

theorem Run.fixedFreshNoise_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (B : Finset (Fin N)) : MemLp (fixedFreshNoise A r B) 2 ν :=
  (memLp_finsetSum B (fun i _ ↦ A.averageNoise_memLp hr i)).const_smul (S : ℝ)⁻¹

theorem Run.fixedStoredNoise_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) (B : Finset (Fin N)) : MemLp (fixedStoredNoise A r B) 2 ν :=
  (A.meanStoredError_memLp hr).sub
    ((memLp_finsetSum B (fun i _ ↦ A.storedError_memLp hr i)).const_smul (S : ℝ)⁻¹)

theorem Run.fixedFreshNoise_adapted (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) (B : Finset (Fin N)) :
    AEStronglyMeasurable[A.history (roundTime K r + K)] (fixedFreshNoise A r B) ν :=
  (aestronglyMeasurable_subalgebra_sum (A.averageNoise_adapted hr) B).const_smul (S : ℝ)⁻¹

theorem Run.fixedStoredNoise_adapted (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r ≤ T) (B : Finset (Fin N)) :
    StronglyMeasurable[A.history (roundTime K r)] (fixedStoredNoise A r B) :=
  (A.meanStoredError_adapted hr).sub
    ((Finset.stronglyMeasurable_fun_sum B
      (fun i _ ↦ A.storedError_adapted hr i)).const_smul (S : ℝ)⁻¹)

theorem Run.sampledFreshNoise_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) : MemLp (sampledFreshNoise A r) 2 ν :=
  A.sample_function_memLp hr _ (A.fixedFreshNoise_memLp hr)

theorem Run.centeredStoredNoise_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) : MemLp (centeredStoredNoise A r) 2 ν :=
  A.sample_function_memLp hr _ (A.fixedStoredNoise_memLp hr.le)

theorem Run.serverNoise_memLp (A : Run P ν S K T ηl ηg init) {r : ℕ}
    (hr : r < T) : MemLp (serverNoise A r) 2 ν :=
  (A.sampledFreshNoise_memLp hr).add (A.centeredStoredNoise_memLp hr)

theorem Run.sample_function_integral (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (F : Finset (Fin N) → Ω → ℝ)
    (hF : ∀ B, Integrable (F B) ν)
    (hm : ∀ B, AEStronglyMeasurable[A.history (roundTime K r + K)] (F B) ν) :
    (∫ ω, F (A.sample r ω) ω ∂ν) =
      uniformSubsetAverage N S (fun B ↦ ∫ ω, F B ω ∂ν) := by
  calc
    _ = ∫ ω, ν[(fun ω ↦ F (A.sample r ω) ω) |
        A.history (roundTime K r + K)] ω ∂ν := (integral_condExp (A.history.le _)).symm
    _ = ∫ ω, uniformSubsetAverage N S (fun B ↦ F B ω) ∂ν :=
      integral_congr_ae (A.sample_function_condExp hr F hF hm)
    _ = _ := by
      simp only [uniformSubsetAverage, smul_eq_mul]
      rw [integral_const_mul, integral_finsetSum _ (fun B _ ↦ hF B)]

omit [StandardBorelSpace Ω] [IsProbabilityMeasure ν] in
theorem integral_norm_sum_sq_of_cross_zero (v : Fin N → Ω → Space d)
    (hv : ∀ i, MemLp (v i) 2 ν)
    (hc : ∀ i j, i ≠ j → ∫ ω, inner ℝ (v i ω) (v j ω) ∂ν = 0)
    (B : Finset (Fin N)) :
    (∫ ω, ‖∑ i ∈ B, v i ω‖ ^ 2 ∂ν) = ∑ i ∈ B, ∫ ω, ‖v i ω‖ ^ 2 ∂ν := by
  have hI (i j : Fin N) : Integrable (fun ω ↦ inner ℝ (v i ω) (v j ω)) ν :=
    FedAvg.inner_integrable_of_memLp (hv i) (hv j)
  have hex (ω : Ω) : ‖∑ i ∈ B, v i ω‖ ^ 2 =
      ∑ i ∈ B, ∑ j ∈ B, inner ℝ (v i ω) (v j ω) := by
    rw [← real_inner_self_eq_norm_sq]
    simp only [sum_inner, inner_sum]
    exact Finset.sum_comm
  simp_rw [hex]
  rw [integral_finsetSum _ (fun i _ ↦ integrable_finsetSum B (fun j _ ↦ hI i j))]
  apply Finset.sum_congr rfl
  intro i hi
  rw [integral_finsetSum _ (fun j _ ↦ hI i j)]
  rw [Finset.sum_eq_single i (fun j _ hji ↦ hc i j hji.symm) (fun hn ↦ (hn hi).elim)]
  simp only [real_inner_self_eq_norm_sq]

theorem Run.fixedFreshNoise_second_moment (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (B : Finset (Fin N)) :
    (∫ ω, ‖fixedFreshNoise A r B ω‖ ^ 2 ∂ν) =
      (S : ℝ)⁻¹ ^ 2 * ∑ i ∈ B, ∫ ω, ‖averageNoise A r i ω‖ ^ 2 ∂ν := by
  simp only [fixedFreshNoise, norm_smul, mul_pow, Real.norm_eq_abs, sq_abs]
  rw [integral_const_mul, integral_norm_sum_sq_of_cross_zero
    (averageNoise A r) (A.averageNoise_memLp hr)
    (fun _ _ hij ↦ A.averageNoise_inner_integral_zero hr hij) B]

theorem Run.sampledFreshNoise_second_moment (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    (∫ ω, ‖sampledFreshNoise A r ω‖ ^ 2 ∂ν) =
      (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ i, ∫ ω, ‖averageNoise A r i ω‖ ^ 2 ∂ν) := by
  have h := A.sample_function_integral hr (fun B ω ↦ ‖fixedFreshNoise A r B ω‖ ^ 2)
    (fun B ↦ (A.fixedFreshNoise_memLp hr B).norm.integrable_sq)
    (fun B ↦ ((continuous_norm : Continuous (fun x : Space d ↦ ‖x‖)).pow 2).comp_aestronglyMeasurable
      (A.fixedFreshNoise_adapted hr B))
  change (∫ ω, ‖sampledFreshNoise A r ω‖ ^ 2 ∂ν) = _ at h
  rw [h]
  simp_rw [A.fixedFreshNoise_second_moment hr]
  change uniformSubsetAverage N S (fun B ↦ ((S : ℝ)⁻¹ ^ 2) •
    ∑ i ∈ B, ∫ ω, ‖averageNoise A r i ω‖ ^ 2 ∂ν) = _
  rw [uniformSubsetAverage_smul,
    uniformSubsetAverage_sum P.clients_pos A.sample_pos A.sample_le]
  simp only [smul_eq_mul]
  have hS : (S : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.sample_pos
  field_simp

theorem Run.sampledFreshNoise_second_moment_le (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    ∫ ω, ‖sampledFreshNoise A r ω‖ ^ 2 ∂ν ≤ P.σ ^ 2 / ((K : ℝ) * S) := by
  rw [A.sampledFreshNoise_second_moment hr]
  calc
    _ ≤ (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ _i : Fin N, P.σ ^ 2 / K) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left
        (Finset.sum_le_sum (fun i _ ↦ A.averageNoise_second_moment_le hr i))
        (inv_nonneg.mpr (Nat.cast_nonneg _))) (inv_nonneg.mpr (Nat.cast_nonneg _))
    _ = _ := by
      have hN : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt P.clients_pos
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      field_simp

theorem Run.centeredStoredNoise_second_moment_le (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    ∫ ω, ‖centeredStoredNoise A r ω‖ ^ 2 ∂ν ≤ P.σ ^ 2 / ((K : ℝ) * S) := by
  have hm (i : Fin N) : AEStronglyMeasurable[A.history (roundTime K r + K)]
      (storedError A r i) ν :=
    ((A.storedError_adapted hr.le i).mono
      (A.history.mono (Nat.le_add_right _ _))).aestronglyMeasurable
  have h := A.sample_mean_variance_integral_le hr (storedError A r)
    (A.storedError_memLp hr.le) hm
  have h' : (∫ ω, ‖centeredStoredNoise A r ω‖ ^ 2 ∂ν) ≤
      (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ i, ∫ ω, ‖storedError A r i ω‖ ^ 2 ∂ν) := by
    simpa only [centeredStoredNoise, fixedStoredNoise, meanStoredError, norm_sub_rev] using h
  apply h'.trans
  calc
    _ ≤ (S : ℝ)⁻¹ * ((N : ℝ)⁻¹ * ∑ _i : Fin N, P.σ ^ 2 / K) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left
        (Finset.sum_le_sum (fun i _ ↦ A.storedError_second_moment_le hr.le i))
        (inv_nonneg.mpr (Nat.cast_nonneg _))) (inv_nonneg.mpr (Nat.cast_nonneg _))
    _ = _ := by
      have hN : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt P.clients_pos
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      field_simp

theorem Run.fixedFreshNoise_roundStart_zero (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (B : Finset (Fin N)) :
    ν[fixedFreshNoise A r B | A.history (roundTime K r)] =ᵐ[ν] 0 := by
  have hs := condExp_finsetSum (s := B)
    (fun i _ ↦ (A.averageNoise_memLp hr i).integrable (by norm_num))
    (A.history (roundTime K r))
  simp only [Finset.sum_fn] at hs
  have hm := condExp_smul (μ := ν) ((S : ℝ)⁻¹)
    (fun ω ↦ ∑ i ∈ B, averageNoise A r i ω) (A.history (roundTime K r))
  filter_upwards [hs, hm, Filter.eventually_all.mpr (A.averageNoise_roundStart_zero hr)]
    with ω hs hm hz
  change ν[fixedFreshNoise A r B | A.history (roundTime K r)] ω = 0
  change ν[fixedFreshNoise A r B | A.history (roundTime K r)] ω =
    (S : ℝ)⁻¹ • ν[fun ω ↦ ∑ i ∈ B, averageNoise A r i ω |
      A.history (roundTime K r)] ω at hm
  simp only [Pi.zero_apply] at hz
  rw [hm, hs]
  simp only [hz, Finset.sum_const_zero, smul_zero]

theorem Run.fixedNoise_cross_integral_zero (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (B : Finset (Fin N)) :
    ∫ ω, inner ℝ (fixedFreshNoise A r B ω) (fixedStoredNoise A r B ω) ∂ν = 0 := by
  have hc := FedAvg.condExp_inner_zero (A.fixedStoredNoise_memLp hr.le B)
    (A.fixedFreshNoise_memLp hr B) (A.fixedStoredNoise_adapted hr.le B).aestronglyMeasurable
    (A.fixedFreshNoise_roundStart_zero hr B)
  have hi := integral_congr_ae hc
  rw [integral_condExp (A.history.le _)] at hi
  simpa only [real_inner_comm, Pi.zero_apply, integral_zero] using hi

theorem Run.serverNoise_cross_integral_zero (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    ∫ ω, inner ℝ (sampledFreshNoise A r ω) (centeredStoredNoise A r ω) ∂ν = 0 := by
  have h := A.sample_function_integral hr
    (fun B ω ↦ inner ℝ (fixedFreshNoise A r B ω) (fixedStoredNoise A r B ω))
    (fun B ↦ FedAvg.inner_integrable_of_memLp
      (A.fixedFreshNoise_memLp hr B) (A.fixedStoredNoise_memLp hr.le B))
    (fun B ↦ (A.fixedFreshNoise_adapted hr B).inner
      (((A.fixedStoredNoise_adapted hr.le B).mono
        (A.history.mono (Nat.le_add_right _ _))).aestronglyMeasurable))
  change (∫ ω, inner ℝ (sampledFreshNoise A r ω) (centeredStoredNoise A r ω) ∂ν) = _ at h
  rw [h]
  simp only [A.fixedNoise_cross_integral_zero hr, uniformSubsetAverage,
    Finset.sum_const_zero, smul_zero]

theorem Run.serverNoise_second_moment (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    (∫ ω, ‖serverNoise A r ω‖ ^ 2 ∂ν) =
      (∫ ω, ‖sampledFreshNoise A r ω‖ ^ 2 ∂ν) +
      (∫ ω, ‖centeredStoredNoise A r ω‖ ^ 2 ∂ν) := by
  have hn := (A.sampledFreshNoise_memLp hr).norm.integrable_sq
  have he := (A.centeredStoredNoise_memLp hr).norm.integrable_sq
  have hi := FedAvg.inner_integrable_of_memLp
    (A.sampledFreshNoise_memLp hr) (A.centeredStoredNoise_memLp hr)
  have hni : Integrable (fun ω ↦ ‖sampledFreshNoise A r ω‖ ^ 2 +
      2 * inner ℝ (sampledFreshNoise A r ω) (centeredStoredNoise A r ω)) ν :=
    hn.add (hi.const_mul 2)
  simp only [serverNoise, norm_add_sq_real]
  rw [integral_add hni he, integral_add hn (hi.const_mul 2),
    integral_const_mul, A.serverNoise_cross_integral_zero hr, mul_zero, add_zero]

theorem Run.serverNoise_second_moment_le (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    ∫ ω, ‖serverNoise A r ω‖ ^ 2 ∂ν ≤ 2 * P.σ ^ 2 / ((K : ℝ) * S) := by
  rw [A.serverNoise_second_moment hr]
  have hn := A.sampledFreshNoise_second_moment_le hr
  have he := A.centeredStoredNoise_second_moment_le hr
  calc
    _ ≤ P.σ ^ 2 / ((K : ℝ) * S) + P.σ ^ 2 / ((K : ℝ) * S) := add_le_add hn he
    _ = _ := by ring

theorem Run.sampledFreshNoise_roundStart_zero (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    ν[sampledFreshNoise A r | A.history (roundTime K r)] =ᵐ[ν] 0 := by
  let m : Ω → Space d := fun ω ↦ (N : ℝ)⁻¹ • ∑ i, averageNoise A r i ω
  have hsum := condExp_finsetSum (s := Finset.univ)
    (fun i _ ↦ (A.averageNoise_memLp hr i).integrable (by norm_num))
    (A.history (roundTime K r))
  simp only [Finset.sum_fn] at hsum
  have hscale := condExp_smul (μ := ν) ((N : ℝ)⁻¹)
    (fun ω ↦ ∑ i, averageNoise A r i ω) (A.history (roundTime K r))
  have hzero : ν[m | A.history (roundTime K r)] =ᵐ[ν] 0 := by
    filter_upwards [hsum, hscale,
      Filter.eventually_all.mpr (A.averageNoise_roundStart_zero hr)] with ω hs hm hz
    change ν[m | A.history (roundTime K r)] ω = 0
    change ν[m | A.history (roundTime K r)] ω =
      (N : ℝ)⁻¹ • ν[fun ω ↦ ∑ i, averageNoise A r i ω | A.history (roundTime K r)] ω at hm
    simp only [Pi.zero_apply] at hz
    rw [hm, hs]
    simp only [hz, Finset.sum_const_zero, smul_zero]
  have hmean := A.sample_mean_condExp hr (averageNoise A r)
    (fun i ↦ (A.averageNoise_memLp hr i).integrable (by norm_num)) (A.averageNoise_adapted hr)
  change ν[sampledFreshNoise A r | A.history (roundTime K r + K)] =ᵐ[ν] m at hmean
  have ht := condExp_condExp_of_le (μ := ν) (f := sampledFreshNoise A r)
    (A.history.mono (Nat.le_add_right _ _)) (A.history.le (roundTime K r + K))
  exact ht.symm.trans ((condExp_congr_ae hmean).trans hzero)

theorem Run.centeredStoredNoise_completed_zero (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) :
    ν[centeredStoredNoise A r | A.history (roundTime K r + K)] =ᵐ[ν] 0 := by
  have hm (i : Fin N) : AEStronglyMeasurable[A.history (roundTime K r + K)]
      (storedError A r i) ν :=
    ((A.storedError_adapted hr.le i).mono
      (A.history.mono (Nat.le_add_right _ _))).aestronglyMeasurable
  have hs := A.sample_mean_condExp hr (storedError A r)
    (fun i ↦ (A.storedError_memLp hr.le i).integrable (by norm_num)) hm
  have hself := condExp_of_stronglyMeasurable (A.history.le _)
    ((A.meanStoredError_adapted hr.le).mono (A.history.mono (Nat.le_add_right _ K)))
    ((A.meanStoredError_memLp hr.le).integrable (by norm_num))
  have hsub := condExp_sub ((A.meanStoredError_memLp hr.le).integrable (by norm_num))
    ((A.sample_mean_memLp hr (storedError A r) (A.storedError_memLp hr.le)).integrable
      (by norm_num)) (A.history (roundTime K r + K))
  filter_upwards [hs, hsub] with ω hs hsub
  change ν[centeredStoredNoise A r | A.history (roundTime K r + K)] ω = 0
  change ν[centeredStoredNoise A r | A.history (roundTime K r + K)] ω =
    ν[meanStoredError A r | A.history (roundTime K r + K)] ω - _ at hsub
  rw [hsub, hself, hs]
  exact sub_self _

theorem Run.serverNoise_roundStart_zero (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) : ν[serverNoise A r | A.history (roundTime K r)] =ᵐ[ν] 0 := by
  have he := condExp_zero_of_le (A.history.mono (Nat.le_add_right _ _)) (A.history.le _)
    (A.centeredStoredNoise_completed_zero hr)
  have hsum := condExp_add ((A.sampledFreshNoise_memLp hr).integrable (by norm_num))
    ((A.centeredStoredNoise_memLp hr).integrable (by norm_num)) (A.history (roundTime K r))
  filter_upwards [hsum, he, A.sampledFreshNoise_roundStart_zero hr] with ω hs he hn
  change ν[serverNoise A r | A.history (roundTime K r)] ω = 0
  change ν[serverNoise A r | A.history (roundTime K r)] ω =
    ν[sampledFreshNoise A r | A.history (roundTime K r)] ω +
    ν[centeredStoredNoise A r | A.history (roundTime K r)] ω at hs
  rw [hs, he, hn]
  exact zero_add _

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule18
