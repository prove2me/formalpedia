/-!
# Standard Schwarzschild → Painlevé–Gullstrand, **restricted to `domStd M`** (composition)

Obtained by transport, not by a new computation: the first-release relation standard → EF
(`toEF M ε`, on `domStd M = {r > 0, r ≠ 2M, 0 < θ < π}`) composed with the Atlas II relation
EF → PG (`pgFromEF M ε`, restricted from `domEF` to `domStd M`) through `CoordRelation.comp`.

**Restriction notice.** Because it passes through the standard chart, this composite relation is
only stated on `domStd M`, which excludes `r = 2M`. The PG ↔ EF relation itself
(`PG.relation_toEF`, `PG.relation_fromEF`) holds on all of `domEF` and is the one to use across
`r = 2M`. The composite map is `(t, r, θ, φ) ↦ (t + ε(r + 2M log(r − 2M)) − ε H_M(r), r, θ, φ)`.
-/

open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild

namespace ExactVacuumAtlas.Schwarzschild.PG

variable (M ε : ℝ)

/-- First-release standard → EF relation for a general sign `ε` with `ε² = 1`
(`Release01.R1_standard_ingoingEF` / `R2_standard_outgoingEF` are its two instances). -/
theorem relation_std_toEF (hε : ε ^ 2 = 1) :
    CoordRelation (gStd M) (gEF M ε) (domStd M) (domStd M) (toEF M ε) (fromEF M ε)
      (EFRelation.jac M ε) where
  left_inv x _ := EFRelation.fromEF_toEF M ε x
  right_inv y _ := EFRelation.toEF_fromEF M ε y
  bijOn := EFRelation.bijOn_toEF M ε
  smooth := EFRelation.contDiffOn_toEF M ε
  smooth_inv := EFRelation.contDiffOn_fromEF M ε
  jacobian _ hx k i := EFRelation.hasDerivAt_pd_toEF M ε hx k i
  pullback _ hx := EFRelation.pullback M ε hε hx

theorem pgFromEF_mem_domStd {y : Pt 4} (hy : y ∈ domStd M) : pgFromEF M ε y ∈ domStd M := by
  simpa [domStd] using hy

theorem pgToEF_mem_domStd {x : Pt 4} (hx : x ∈ domStd M) : pgToEF M ε x ∈ domStd M := by
  simpa [domStd] using hx

/-- EF → PG restricted to the standard overlap `domStd M` (a sub-relation of `relation_fromEF`). -/
theorem relation_fromEF_std (hM : 0 ≤ M) (hε : ε ^ 2 = 1) :
    CoordRelation (gEF M ε) (gPG M ε) (domStd M) (domStd M) (pgFromEF M ε) (pgToEF M ε)
      (jacInv M ε) :=
  (relation_fromEF M ε hM hε).restrict (domStd_subset_domEF M) (domStd_subset_domEF M)
    (fun _ hy => pgFromEF_mem_domStd M ε hy) (fun _ hx => pgToEF_mem_domStd M ε hx)

end ExactVacuumAtlas.Schwarzschild.PG

