-- Source module: Solutions.J6AIL4b
/-!
# A lines, IL side 4b: the `A` kernel v2 (small header, Kronecker constants in the kernel)

The v1 header `aHdr` carried `kG b (2n) 2^pk` and `(2^b)^(4n)` (`n = w2 + bk`), about `4 b n` bits
each. The v2 header **`aHdr2`** carries `j = clog₂ (2n)` and `b · 2n` in those two slots instead
(every entry is then `O(Q + pk + b)` bits), and **`aKprog2`** computes the two constants per row
with S2's `kgRS` (doubling `j` times, then `pow2`), saving `j, b·2n` on `aS1 = 35`, `aS2 = 36`
and restoring them before the header goes back to the table:

`tkL aRegs; kSave; kgRS; (v1 body); kRest; rtLR aRegs`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR.AK

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

abbrev aS1 : Fin HS := 35
abbrev aS2 : Fin HS := 36

/-- `j = clog₂ (2 (w2 + bk))`. -/
def jA (w2 bk : ℕ) : ℕ := Nat.clog 2 (2 * (w2 + bk))

/-- **The v2 header**: as `aHdr`, with `j` and `b · 2n` in the `kK`, `kJ` slots. -/
def aHdr2 (w2 bk win Q pk b : ℕ) : List ℤ :=
  [((w2 + bk + w2 : ℕ) : ℤ), (w2 : ℤ), ((2 * (win - w2) : ℕ) : ℤ), ((2 * bk : ℕ) : ℤ),
   ((2 * w2 : ℕ) : ℤ), (bk : ℤ), ((2 * (win - bk) : ℕ) : ℤ), ((w2 + bk : ℕ) : ℤ),
   ((2 * (w2 + bk) : ℕ) : ℤ), 2 ^ Q, 2 ^ (Q + 1), 2 ^ pk, ((2 * (w2 + bk) : ℕ) : ℤ),
   ((jA w2 bk : ℕ) : ℤ), 2 ^ b, ((b * (2 * (w2 + bk)) : ℕ) : ℤ), 1]

/-- **The v2 kernel table.** -/
def aKTab2 (w2 bk win Q pk b : ℕ) (aTab rTab cTab : List ℤ) : List ℤ :=
  aHdr2 w2 bk win Q pk b ++ (aTab ++ (rTab ++ cTab))

/-- Save `j`, `b · 2n`. -/
def kSave : RS := .seq (.push aS1 (.reg kK)) (.push aS2 (.reg kJ))

/-- Put `j`, `b · 2n` back in place of the constants. -/
def kRest : RS :=
  .seq (.pop kK) (.seq (.pop kJ) (.seq (.push kK (.reg aS1)) (.seq (.push kJ (.reg aS2))
    (.seq (.pop aS1) (.pop aS2)))))

/-- **The `A` kernel v2.** -/
def aKprog2 (pM : Fin Pp) : IStmt HS Pp :=
  .seq (tkL aRegs).code <|
  .seq kSave.code <|
  .seq kgRS.code <|
  .seq (dgI pM 0 dT TU W1 CN CC R1) <|
  .seq (dropR 0 CC R2).code <|
  .seq (zeroR W1 CC R3).code <|
  .seq (NLogN.mvK dT DU CC (.reg R1)).code <|
  .seq (tsI pM W1 W2) <|
  .seq (dropR W2 CC R4).code <|
  .seq (dgI pM W2 dT TU OUT CN CC R5) <|
  .seq (zeroR 0 CC R6).code <|
  .seq (mvP OUT 0 TP CC R5).code <|
  .seq (NLogN.mvK DU dT CC (.reg R7)).code <|
  .seq kRest.code
  (rtLR aRegs).code

/-- The per-row bound of the two constants. -/
def BkA (w2 bk b : ℕ) : ℕ := BkN b (w2 + bk)

/-- **Cost of the `A` kernel v2.** -/
def cAK2 (w2 bk win pk b φ1 φ2 B BH : ℕ) : ℕ :=
  cAK w2 bk win pk b φ1 φ2 B BH + 2 * (4000 * (BH + 2)) +
    cKG (jA w2 bk) (b * (2 * (w2 + bk))) (BkA w2 bk b) +
    (2 * (2 * BkA w2 bk b + 2) + 2 * (4000 * (BH + 2)) + 2 * (2 * BH + 2))

/-- The registers after reading the v2 header. -/
def aG2s (w2 bk win Q pk b : ℕ) : Fin HS → List ℤ :=
  pushAll (fun _ => []) aRegs (aHdr2 w2 bk win Q pk b)

/-- The registers during the body: the v1 registers plus the two saved values. -/
def aGx (w2 bk win Q pk b : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (aG w2 bk win Q pk b) aS1 [((jA w2 bk : ℕ) : ℤ)]) aS2
    [((b * (2 * (w2 + bk)) : ℕ) : ℤ)]

end J6Seg.KR.AK

end

