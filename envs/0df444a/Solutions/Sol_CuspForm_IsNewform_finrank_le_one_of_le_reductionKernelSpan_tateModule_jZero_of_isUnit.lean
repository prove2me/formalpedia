section FitT

variable {M : ℕ} [NeZero M] (lam : ℕ) [Fact lam.Prime]

private def fT : JZero M →ₗ[ℤ] JZero M :=
  (DistribSMul.toAddMonoidHom (JZero M) (heckeGen ⟨lam, Fact.out⟩)).toIntLinearMap

private theorem fT_apply (P : JZero M) : fT (M := M) lam P = heckeGen ⟨lam, Fact.out⟩ • P := rfl

private theorem fT_eq_heckeOperatorBar (P : JZero M) :
    fT (M := M) lam P = heckeOperatorBar M ⟨lam, Fact.out⟩ P := by
  rw [fT_apply]
  exact heckeModuleBar_heckeGen_smul (heckeOperatorsCommuteBar M) ⟨lam, Fact.out⟩ P

private theorem fT_eq : fT (M := M) lam = heckeOperatorBar M ⟨lam, Fact.out⟩ :=
  LinearMap.ext (fT_eq_heckeOperatorBar lam)

private theorem fT_pow_apply (m : ℕ) (P : JZero M) :
    (fT (M := M) lam ^ m) P = (heckeOperatorBar M ⟨lam, Fact.out⟩ ^ m) P := by
  rw [fT_eq]

private theorem finite_lvl (k : ℕ) : Finite (OrdConnFit.lvl (JZero M) lam k) := by
  have hpos : 0 < lam ^ k := pow_pos (Fact.out : lam.Prime).pos k
  haveI : Finite (AlgebraicCurve.Pic0.torsion (AlgebraicClosure ℚ) (modularFunctionFieldBar M) (lam ^ k)) :=
    (show JZeroTorsionFinite M (lam ^ k) from jZeroTorsionFinite M (lam ^ k) hpos)
  refine Finite.of_injective (fun x : OrdConnFit.lvl (JZero M) lam k =>
    (⟨x.1, ?_⟩ : AlgebraicCurve.Pic0.torsion (AlgebraicClosure ℚ) (modularFunctionFieldBar M) (lam ^ k))) ?_
  · rw [AlgebraicCurve.Pic0.mem_torsion, Nat.cast_pow]
    exact x.2
  · intro x y h
    exact Subtype.ext (congrArg Subtype.val h)

private theorem finite_lamTorsion : Set.Finite {v : JZero M | lam • v = 0} := by
  haveI : Finite (AlgebraicCurve.Pic0.torsion (AlgebraicClosure ℚ) (modularFunctionFieldBar M) lam) :=
    (show JZeroTorsionFinite M lam from jZeroTorsionFinite M lam (Fact.out : lam.Prime).pos)
  have hfin : (AlgebraicCurve.Pic0.torsion (AlgebraicClosure ℚ) (modularFunctionFieldBar M) lam :
      Set (JZero M)).Finite := Set.toFinite _
  refine hfin.subset ?_
  intro v hv
  simp only [Set.mem_setOf_eq, SetLike.mem_coe, AlgebraicCurve.Pic0.mem_torsion, natCast_zsmul] at hv ⊢
  exact hv

private scoped instance (priority := high) instAddCommMonoidT : AddCommMonoid (ModularCurve.TateModule lam (JZero M)) :=
  (ModularCurve.TateModule lam (JZero M)).addCommMonoid

private scoped instance (priority := high) instAddCommGroupT : AddCommGroup (ModularCurve.TateModule lam (JZero M)) :=
