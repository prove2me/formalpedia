               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => rintro ⟨loc₃, μ₃⟩ ⟨tmp, hloc₃, hOT, hk₃⟩))
  simp only at hloc₃ hOT hk₃
  subst hloc₃
  refine Ends.pieceLast (oLoop_ends R hpre hok tmp 0 0 0 (BTabs.of_OTabs hOT)
    (fun b hb => (hk₃ b hb).trans (hk₁ b hb))) (fun σ' h => h) ?_
  (first
   | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil,
           List.sum_cons, List.sum_nil, ])
       (first
