    hT hThi hu hP hα
  rw [fullSquarefreePrimeSupport_unit] at hb
  convert hb using 1
  all_goals try with_reducible_and_instances rfl
  congr 1
  funext t
  congr 1
  apply Finset.sum_congr rfl
  intro a _
  apply Finset.sum_congr rfl
  intro p hp
  rw [fullPrimeCoefficient_unit hp]

