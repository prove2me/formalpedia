    · have hx2 : (gu120.lo : ℝ) < x := by
          have hb : (gu119.top : ℝ) = (gu120.lo : ℝ) := by simp [gu119, gu120]
          linarith
      by_cases h2 : x ≤ (gu120.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu121.lo : ℝ) < x := by
            have hb : (gu120.top : ℝ) = (gu121.lo : ℝ) := by simp [gu120, gu121]
            linarith
