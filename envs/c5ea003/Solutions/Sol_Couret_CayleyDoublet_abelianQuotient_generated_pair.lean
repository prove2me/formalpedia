variable {G : Type*} [AddCommGroup G]

/-- Generation by a,d,h descends to generation by a,d modulo the subgroup
generated by h. Neither finiteness nor torsion is needed. -/
theorem p2m_local_abelianQuotient_generated_pair (a d h : G)
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤) :
    AddSubgroup.closure
      ({(a : G ⧸ AddSubgroup.zmultiples h),
        (d : G ⧸ AddSubgroup.zmultiples h)} : Set (G ⧸ AddSubgroup.zmultiples h)) = ⊤ := by
  let H := AddSubgroup.zmultiples h
  let q := QuotientAddGroup.mk' H
  have hh : (h : G ⧸ H) = 0 :=
    (QuotientAddGroup.eq_zero_iff h).mpr (AddSubgroup.mem_zmultiples h)
  have hm := congrArg (fun K : AddSubgroup G => K.map q) hgen
  change (AddSubgroup.closure ({a, d, h} : Set G)).map q =
    (⊤ : AddSubgroup G).map q at hm
  rw [AddMonoidHom.map_closure,
    AddSubgroup.map_top_of_surjective q (QuotientAddGroup.mk'_surjective H)] at hm
  simp only [Set.image_insert_eq, Set.image_singleton] at hm
  change AddSubgroup.closure ({(a : G ⧸ H), (d : G ⧸ H), (h : G ⧸ H)} :
    Set (G ⧸ H)) = ⊤ at hm
  rw [hh] at hm
  have hs : ({(a : G ⧸ H), (d : G ⧸ H), 0} : Set (G ⧸ H)) =
      insert 0 {(a : G ⧸ H), (d : G ⧸ H)} := by
    ext x
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    tauto
  rw [hs, AddSubgroup.closure_insert_zero] at hm
  exact hm


end Couret.CayleyDoublet

