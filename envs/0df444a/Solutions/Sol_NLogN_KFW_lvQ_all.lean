theorem layerShape_drop (P K D S i : ℕ) (hi : i < D) :
    (Butterfly.layerShape P K D S).drop (i + 2) = List.replicate (D - (i + 1)) (2 ^ K) ++ [S] := by
  simp only [Butterfly.layerShape, List.cons_append, List.drop_succ_cons]
