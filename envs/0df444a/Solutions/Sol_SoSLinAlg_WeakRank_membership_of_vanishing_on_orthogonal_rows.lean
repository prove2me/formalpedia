open SoSLinAlg.WeakRank SoSLinAlg.WeakRank.Dev.Leaf
variable {σ : Type*}
/-! ### Lifting -/
/-- The monomial ideal of the generators indexed by a finset. -/
def MI {ι : Type*} (μ : ι → σ →₀ ℕ) (T : Finset ι) : Ideal (MvPolynomial σ ℝ) :=
  Ideal.span ((fun l => monomial (μ l) (1 : ℝ)) '' (T : Set ι))

lemma MI_eq {ι : Type*} (μ : ι → σ →₀ ℕ) (T : Finset ι) :
    MI μ T = monIdeal (fun l : T => μ l) := by
  rw [MI, monIdeal, Set.image_eq_range]; rfl

lemma MI_mono {ι : Type*} [DecidableEq ι] (μ : ι → σ →₀ ℕ) (T : Finset ι) (N : ι) :
    MI μ T ≤ MI μ (insert N T) :=
  Ideal.span_mono (Set.image_mono (by simp))

lemma mon_mem_MI {ι : Type*} [DecidableEq ι] (μ : ι → σ →₀ ℕ) (T : Finset ι) (N : ι) :
    monomial (μ N) (1 : ℝ) ∈ MI μ (insert N T) :=
  Ideal.subset_span ⟨N, by simp, rfl⟩

lemma topTerm_degLE {w : σ → ℕ} {f : MvPolynomial σ ℝ} {μ : σ →₀ ℕ} (hf : TopTerm w f μ) :
    DegLE w (Finsupp.weight w μ) f := by
  classical
  intro s hs
  by_cases h : s = μ
  · rw [h]
  have : s ∈ (f - monomial μ 1).support := by
    rw [mem_support_iff, coeff_sub, coeff_monomial, if_neg (fun e => h e.symm), sub_zero]
    exact mem_support_iff.1 hs
  exact (hf s this).le

lemma topTerm_comp {w : σ → ℕ} {f : MvPolynomial σ ℝ} {μ : σ →₀ ℕ} (hf : TopTerm w f μ) :
    weightedHomogeneousComponent w (Finsupp.weight w μ) f = monomial μ 1 := by
  have : f = monomial μ 1 + (f - monomial μ 1) := by ring
  rw [this, map_add, weightedHomogeneousComponent_eq_self
      (isWeightedHomogeneous_monomial _ _ _ rfl),
    weightedHomogeneousComponent_eq_zero' _ _ (fun s hs => (hf s (by simpa using hs)).ne),
    add_zero]

/-- `comp_d (q * f) = comp_{d - wt μ} q * monomial μ 1` for `f` with top term `μ`. -/
lemma comp_mul_top {w : σ → ℕ} {f q : MvPolynomial σ ℝ} {μ : σ →₀ ℕ} (hf : TopTerm w f μ)
    {e d : ℕ} (hq : DegLE w e q) (hed : e + Finsupp.weight w μ = d) :
    weightedHomogeneousComponent w d (q * f) =
      weightedHomogeneousComponent w e q * monomial μ 1 := by
  have := comp_mul w hq (topTerm_degLE hf)
  rwa [hed, topTerm_comp hf] at this

end SoSLinAlg.WeakRank.Dev.Leaf.PartA
end
end

