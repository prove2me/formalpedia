variable (p : ℕ) [Fact p.Prime] (M : Type) [AddCommGroup M]

theorem tateModule_eq_zero_of_pow_smul_eq_zero (k : ℕ) (x : TateModule p M)
    (hx : ((p : ℤ_[p]) ^ k) • x = 0) : x = 0 := by
  refine Subtype.ext (funext fun n => ?_)
  have h := congrArg (fun y : TateModule p M => (y : ℕ → M) (n + k)) hx
  try simp only at h
  rw [show ((p : ℤ_[p]) ^ k) = ((p ^ k : ℕ) : ℤ_[p]) by push_cast; rfl, TateModule.natCast_padicInt_smul_apply,
    TateModule.compat_pow] at h
  rw [h]
  rfl

scoped instance isTorsionFree : Module.IsTorsionFree ℤ_[p] (TateModule p M) := by
  refine ⟨fun a ha => ?_⟩
  intro x y hxy
  have ha0 : a ≠ 0 := ha.ne_zero
  have h0 : a • (x - y) = 0 := by rw [smul_sub]; exact sub_eq_zero.mpr hxy
  have h1 : ((p : ℤ_[p]) ^ a.valuation) • (x - y) = 0 := by
    have hu : IsUnit ((PadicInt.unitCoeff ha0 : ℤ_[p]ˣ) : ℤ_[p]) := Units.isUnit _
    rw [PadicInt.unitCoeff_spec ha0, mul_smul] at h0
    exact hu.smul_left_cancel.mp (h0.trans (smul_zero _).symm)
  exact sub_eq_zero.mp (tateModule_eq_zero_of_pow_smul_eq_zero p M _ _ h1)

