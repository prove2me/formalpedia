import Mathlib

/-!
# A finitely additive extension of an s-finite measure to all subsets

Every s-finite measure agrees, on its null-measurable sets, with some finitely additive
`ν : Set X → ℝ≥0∞` defined on every subset. For each finite list `L` of sets a measurable
partition follows the atoms of `L` (splitting along measurable hulls); `ν s` is the ultrafilter
limit, along "eventually `s ∈ L`", of the measure of the union of the parts whose atom lies in
`s`. Once `s ∈ L` that union is exactly additive, and it has measure `μ s` when `s` is
null-measurable.
-/

namespace FinitelyAdditive.Lib

open MeasureTheory Filter Topology Set
open scoped ENNReal

section Extension

variable {X : Type*} [MeasurableSpace X] (μ : Measure X)

open Classical

/-- The membership pattern of `y` in the sets of the list `L`. -/
noncomputable def leb_tau (L : List (Set X)) (y : X) : List Bool :=
  L.map (fun a => decide (y ∈ a))

/-- The atom of the finite Boolean algebra generated by `L` with pattern `σ`. -/
def leb_atom (L : List (Set X)) (σ : List Bool) : Set X := {y | leb_tau L y = σ}

/-- A measurable "shadow" pattern: refining the partition one set at a time, a point lies in
the `true` half iff it lies in the measurable hull of (current atom ∩ new set). -/
noncomputable def leb_sig : List (Set X) → X → List Bool
  | [], _ => []
  | a :: L, x => decide (x ∈ toMeasurable μ (leb_atom L (leb_sig L x) ∩ a)) :: leb_sig L x

omit [MeasurableSpace X] in
theorem leb_atom_cons (a : Set X) (L : List (Set X)) (b : Bool) (σ : List Bool) :
    leb_atom (a :: L) (b :: σ) = {y | decide (y ∈ a) = b} ∩ leb_atom L σ := by
  classical
  ext y; simp [leb_atom, leb_tau]

omit [MeasurableSpace X] in
theorem leb_decides {L : List (Set X)} {s : Set X} (hs : s ∈ L) {σ : List Bool} {y z : X}
    (hy : y ∈ leb_atom L σ) (hz : z ∈ leb_atom L σ) : (y ∈ s ↔ z ∈ s) := by
  classical
  have h : leb_tau L y = leb_tau L z := hy.trans hz.symm
  unfold leb_tau at h
  have := (List.map_inj_left.1 h) s hs
  simpa using this

theorem leb_fiber_cons (a : Set X) (L : List (Set X)) (b : Bool) (σ : List Bool) :
    {x | leb_sig μ (a :: L) x = b :: σ} =
      {x | leb_sig μ L x = σ} ∩ {x | decide (x ∈ toMeasurable μ (leb_atom L σ ∩ a)) = b} := by
  ext x
  simp only [leb_sig, mem_ofPred_eq, List.cons.injEq, mem_inter_iff]
  constructor
  · rintro ⟨h1, h2⟩; subst h2; exact ⟨rfl, h1⟩
  · rintro ⟨h1, h2⟩; subst h1; exact ⟨h2, rfl⟩

theorem leb_measurableSet_fiber (L : List (Set X)) (σ : List Bool) :
    MeasurableSet {x | leb_sig μ L x = σ} := by
  induction L generalizing σ with
  | nil =>
    by_cases h : ([] : List Bool) = σ
    · simp [leb_sig, h]
    · simp [leb_sig, h]
  | cons a L ih =>
    cases σ with
    | nil => simp [leb_sig]
    | cons b σ =>
      rw [leb_fiber_cons]
      refine (ih σ).inter ?_
      cases b
      · have : {x | decide (x ∈ toMeasurable μ (leb_atom L σ ∩ a)) = false}
            = (toMeasurable μ (leb_atom L σ ∩ a))ᶜ := by ext; simp
        rw [this]; exact (measurableSet_toMeasurable _ _).compl
      · have : {x | decide (x ∈ toMeasurable μ (leb_atom L σ ∩ a)) = true}
            = toMeasurable μ (leb_atom L σ ∩ a) := by ext; simp
        rw [this]; exact measurableSet_toMeasurable _ _

theorem leb_measurableSet_setOf (L : List (Set X)) (P : List Bool → Prop) :
    MeasurableSet {x | P (leb_sig μ L x)} := by
  have : {x | P (leb_sig μ L x)} = ⋃ σ ∈ {σ | P σ}, {x | leb_sig μ L x = σ} := by
    ext x; simp
  rw [this]
  exact MeasurableSet.biUnion (Set.to_countable _) (fun σ _ => leb_measurableSet_fiber μ L σ)

theorem leb_inv [SFinite μ] (L : List (Set X)) (σ : List Bool) :
    μ ({x | leb_sig μ L x = σ} \ toMeasurable μ (leb_atom L σ)) = 0 := by
  induction L generalizing σ with
  | nil =>
    have hsub : {x | leb_sig μ ([] : List (Set X)) x = σ} ⊆ toMeasurable μ (leb_atom [] σ) := by
      intro x hx
      apply subset_toMeasurable
      simpa [leb_atom, leb_tau, leb_sig] using hx
    rw [Set.sdiff_eq_empty.2 hsub, measure_empty]
  | cons a L ih =>
    cases σ with
    | nil => simp [leb_sig]
    | cons b σ =>
      rw [leb_fiber_cons, leb_atom_cons]
      set A := leb_atom L σ
      cases b
      · set H1 := toMeasurable μ (A ∩ a)
        set H2 := toMeasurable μ ({y | decide (y ∈ a) = false} ∩ A)
        have hsub : ({x | leb_sig μ L x = σ} ∩ {x | decide (x ∈ H1) = false}) \ H2 ⊆
            ({x | leb_sig μ L x = σ} \ toMeasurable μ A) ∪ (toMeasurable μ A ∩ (H1 ∪ H2)ᶜ) := by
          rintro x ⟨⟨hx1, hx2⟩, hx3⟩
          by_cases hA : x ∈ toMeasurable μ A
          · right
            refine ⟨hA, ?_⟩
            simp only [mem_ofPred_eq, decide_eq_false_iff_not] at hx2
            simp [hx2, hx3]
          · left; exact ⟨hx1, hA⟩
        refine measure_mono_null hsub (measure_union_null (ih σ) ?_)
        rw [Measure.measure_toMeasurable_inter_of_sFinite
          ((measurableSet_toMeasurable _ _).union (measurableSet_toMeasurable _ _)).compl]
        have : A ∩ (H1 ∪ H2)ᶜ = ∅ := by
          refine Set.eq_empty_iff_forall_notMem.2 ?_
          rintro y ⟨hy, hn⟩
          apply hn
          by_cases hya : y ∈ a
          · exact Or.inl (subset_toMeasurable μ (A ∩ a) ⟨hy, hya⟩)
          · exact Or.inr (subset_toMeasurable μ _ ⟨by simpa using hya, hy⟩)
        rw [this, measure_empty]
      · have hsub : ({x | leb_sig μ L x = σ} ∩
            {x | decide (x ∈ toMeasurable μ (A ∩ a)) = true}) \
            toMeasurable μ ({y | decide (y ∈ a) = true} ∩ A) = ∅ := by
          have : {y | decide (y ∈ a) = true} ∩ A = A ∩ a := by
            ext y; simp [and_comm]
          rw [this]
          ext x; simp
        rw [hsub, measure_empty]

/-- Points whose measurable pattern is not inside the hull of their atom. -/
noncomputable def leb_bad (L : List (Set X)) : Set X :=
  ⋃ σ : List Bool, {x | leb_sig μ L x = σ} \ toMeasurable μ (leb_atom L σ)

theorem leb_bad_null [SFinite μ] (L : List (Set X)) : μ (leb_bad μ L) = 0 :=
  measure_iUnion_null fun σ => leb_inv μ L σ

theorem leb_mem_hull_or_bad (L : List (Set X)) (x : X) :
    x ∈ toMeasurable μ (leb_atom L (leb_sig μ L x)) ∨ x ∈ leb_bad μ L := by
  by_cases h : x ∈ toMeasurable μ (leb_atom L (leb_sig μ L x))
  · exact Or.inl h
  · right; exact mem_iUnion.2 ⟨leb_sig μ L x, rfl, h⟩

theorem leb_hull_null [SFinite μ] {A M : Set X} (hM : NullMeasurableSet M μ)
    (h : A ∩ M = ∅) : μ (toMeasurable μ A ∩ M) = 0 := by
  obtain ⟨T, hTM, hT, hTae⟩ := hM.exists_measurable_subset_ae_eq
  have h1 : μ (toMeasurable μ A ∩ T) = 0 := by
    rw [Measure.measure_toMeasurable_inter_of_sFinite hT]
    have : A ∩ T = ∅ := Set.eq_empty_of_subset_empty (h ▸ inter_subset_inter_right _ hTM)
    rw [this, measure_empty]
  have h2 : μ (M \ T) = 0 := (ae_eq_set.1 hTae).2
  refine measure_mono_null ?_ (measure_union_null h1 h2)
  rintro x ⟨hx1, hx2⟩
  by_cases hxT : x ∈ T
  · exact Or.inl ⟨hx1, hxT⟩
  · exact Or.inr ⟨hx2, hxT⟩

/-- The measurable set standing for `s` at stage `L`. -/
def leb_G (L : List (Set X)) (s : Set X) : Set X :=
  {x | (leb_atom L (leb_sig μ L x)).Nonempty ∧ leb_atom L (leb_sig μ L x) ⊆ s}

theorem leb_G_empty (L : List (Set X)) : leb_G μ L ∅ = ∅ := by
  ext x
  simp only [leb_G, mem_ofPred_eq, subset_empty_iff, mem_empty_iff_false, iff_false, not_and]
  intro h h'; exact h.ne_empty h'

theorem leb_G_union {L : List (Set X)} {s t : Set X} (hs : s ∈ L) (hst : Disjoint s t) :
    μ (leb_G μ L (s ∪ t)) = μ (leb_G μ L s) + μ (leb_G μ L t) := by
  have heq : leb_G μ L (s ∪ t) = leb_G μ L s ∪ leb_G μ L t := by
    ext x
    simp only [leb_G, mem_ofPred_eq, mem_union]
    constructor
    · rintro ⟨⟨y, hy⟩, hsub⟩
      by_cases hys : y ∈ s
      · left
        exact ⟨⟨y, hy⟩, fun z hz => (leb_decides hs hy hz).1 hys⟩
      · right
        refine ⟨⟨y, hy⟩, fun z hz => ?_⟩
        have hzs : z ∉ s := fun hzs => hys ((leb_decides hs hy hz).2 hzs)
        exact (hsub hz).resolve_left hzs
    · rintro (⟨hne, hsub⟩ | ⟨hne, hsub⟩)
      · exact ⟨hne, hsub.trans subset_union_left⟩
      · exact ⟨hne, hsub.trans subset_union_right⟩
  have hdisj : Disjoint (leb_G μ L s) (leb_G μ L t) := by
    rw [Set.disjoint_left]
    rintro x ⟨⟨y, hy⟩, hs'⟩ ⟨_, ht'⟩
    exact Set.disjoint_left.1 hst (hs' hy) (ht' hy)
  rw [heq, measure_union hdisj (leb_measurableSet_setOf μ L (fun σ => (leb_atom L σ).Nonempty ∧ leb_atom L σ ⊆ t))]

theorem leb_G_eq [SFinite μ] {L : List (Set X)} {s : Set X} (hs : NullMeasurableSet s μ)
    (hL : s ∈ L) : μ (leb_G μ L s) = μ s := by
  refine measure_congr (ae_eq_set.2 ⟨?_, ?_⟩)
  · have hnull : μ (leb_bad μ L ∪ ⋃ (σ : List Bool) (_ : leb_atom L σ ∩ sᶜ = ∅),
        toMeasurable μ (leb_atom L σ) ∩ sᶜ) = 0 :=
      measure_union_null (leb_bad_null μ L)
        (measure_iUnion_null fun σ => measure_iUnion_null fun h => leb_hull_null μ hs.compl h)
    refine measure_mono_null ?_ hnull
    rintro x ⟨⟨_, hsub⟩, hxs⟩
    rcases leb_mem_hull_or_bad μ L x with h | h
    · right
      refine mem_iUnion₂.2 ⟨leb_sig μ L x, ?_, h, hxs⟩
      ext y; simp only [mem_inter_iff, mem_compl_iff, mem_empty_iff_false, iff_false, not_and,
        not_not]
      exact fun hy => hsub hy
    · exact Or.inl h
  · have hnull : μ (leb_bad μ L ∪ ⋃ (σ : List Bool) (_ : leb_atom L σ ∩ s = ∅),
        toMeasurable μ (leb_atom L σ) ∩ s) = 0 :=
      measure_union_null (leb_bad_null μ L)
        (measure_iUnion_null fun σ => measure_iUnion_null fun h => leb_hull_null μ hs h)
    refine measure_mono_null ?_ hnull
    rintro x ⟨hxs, hxG⟩
    rcases leb_mem_hull_or_bad μ L x with h | h
    · right
      refine mem_iUnion₂.2 ⟨leb_sig μ L x, ?_, h, hxs⟩
      by_contra hne
      obtain ⟨w, hw, hws⟩ := Set.nonempty_iff_ne_empty.2 hne
      exact hxG ⟨⟨w, hw⟩, fun z hz => (leb_decides hL hw hz).1 hws⟩
    · exact Or.inl h

/-- The filter "eventually the list contains any given set". -/
noncomputable def leb_filter (X : Type*) : Filter (List (Set X)) :=
  Filter.map Finset.toList atTop

instance leb_filter_neBot : (leb_filter X).NeBot := by
  unfold leb_filter; infer_instance

omit [MeasurableSpace X] in
theorem leb_eventually_mem (s : Set X) : ∀ᶠ L in leb_filter X, s ∈ L := by
  unfold leb_filter
  rw [eventually_map]
  exact (eventually_ge_atTop {s}).mono fun F hF =>
    Finset.mem_toList.2 (hF (Finset.mem_singleton_self s))

/-- The extension: an ultrafilter limit of `μ (leb_G L s)`. -/
noncomputable def leb_nu (s : Set X) : ℝ≥0∞ :=
  limUnder ((Ultrafilter.of (leb_filter X) : Ultrafilter _) : Filter (List (Set X)))
    (fun L => μ (leb_G μ L s))

theorem leb_tendsto (s : Set X) :
    Tendsto (fun L => μ (leb_G μ L s))
      ((Ultrafilter.of (leb_filter X) : Ultrafilter _) : Filter (List (Set X)))
      (𝓝 (leb_nu μ s)) := by
  obtain ⟨a, -, ha⟩ := isCompact_univ.ultrafilter_le_nhds
    ((Ultrafilter.of (leb_filter X)).map (fun L => μ (leb_G μ L s)))
    (le_principal_iff.2 univ_mem)
  exact tendsto_nhds_limUnder ⟨a, ha⟩

omit [MeasurableSpace X] in
theorem leb_ev (s : Set X) :
    ∀ᶠ L in ((Ultrafilter.of (leb_filter X) : Ultrafilter _) : Filter (List (Set X))), s ∈ L :=
  Ultrafilter.of_le _ (leb_eventually_mem s)

/-- The recalled Carathéodory-type fact: an s-finite measure extends to a finitely additive
measure on all subsets. -/
theorem exists_extension_of_sFinite' [SFinite μ] :
    ∃ ν : Set X → ℝ≥0∞, ν ∅ = 0 ∧ (∀ s t : Set X, Disjoint s t → ν (s ∪ t) = ν s + ν t) ∧
      ∀ s : Set X, NullMeasurableSet s μ → ν s = μ s := by
  refine ⟨leb_nu μ, ?_, ?_, ?_⟩
  · refine tendsto_nhds_unique (leb_tendsto μ ∅) ?_
    simp only [leb_G_empty, measure_empty]
    exact tendsto_const_nhds
  · intro s t hst
    refine tendsto_nhds_unique (leb_tendsto μ (s ∪ t)) ?_
    refine ((leb_tendsto μ s).add (leb_tendsto μ t)).congr' ?_
    filter_upwards [leb_ev s] with L hL
    exact (leb_G_union μ hL hst).symm
  · intro s hs
    refine tendsto_nhds_unique (leb_tendsto μ s) ?_
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [leb_ev s] with L hL
    exact (leb_G_eq μ hs hL).symm

end Extension

end FinitelyAdditive.Lib

open MeasureTheory
open scoped ENNReal

theorem solution {X : Type*} [MeasurableSpace X] (μ : Measure X) [SFinite μ] :
    ∃ ν : Set X → ℝ≥0∞, ν ∅ = 0 ∧ (∀ s t : Set X, Disjoint s t → ν (s ∪ t) = ν s + ν t) ∧
      ∀ s : Set X, NullMeasurableSet s μ → ν s = μ s :=
  FinitelyAdditive.Lib.exists_extension_of_sFinite' μ
