/-- The permutations underlying adjacent half-twists generate the symmetric group. -/
private theorem surj_perm_gen (n : ℕ) :
    Subgroup.closure (Set.range (fun i : Fin (n - 1) =>
      Equiv.swap (strandIdx i) (strandIdxSucc i))) = (⊤ : Subgroup (Equiv.Perm (Fin n))) := by
  rcases n with _ | m
  · rw [Subgroup.eq_top_iff']
    intro x
    have hx : x = 1 := Subsingleton.elim _ _
    rw [hx]
    exact one_mem _
  · rw [Subgroup.eq_top_iff']
    intro x
    have h1 := Equiv.Perm.mclosure_swap_castSucc_succ m
    have hx : x ∈ Submonoid.closure
        (Set.range fun i : Fin m => Equiv.swap i.castSucc i.succ) := by
      rw [h1]; trivial
    have hsub : Submonoid.closure (Set.range fun i : Fin m => Equiv.swap i.castSucc i.succ)
        ≤ (Subgroup.closure (Set.range (fun i : Fin (m + 1 - 1) =>
            Equiv.swap (strandIdx i) (strandIdxSucc i)))).toSubmonoid := by
      refine Submonoid.closure_le.mpr ?_
      rintro y ⟨i, rfl⟩
      refine Subgroup.subset_closure ⟨i, ?_⟩
      have e1 : strandIdx (n := m + 1) i = i.castSucc := by apply Fin.ext; simp [strandIdx]
      have e2 : strandIdxSucc (n := m + 1) i = i.succ := by apply Fin.ext; simp [strandIdxSucc]
      simp only [e1, e2]
    exact hsub hx

theorem _root_.solution (n : ℕ)
    (f : ArtinBraidGroup n →* GeomBraidGroup n)
    (hf : ∀ i : Fin (n - 1), f (sigma i) = halfTwistBraid n i) :
    Function.Surjective f := by
  obtain ⟨nu, hnu, hker⟩ := TarchaBraids.exists_perm_hom_halfTwist n
  -- the subgroup generated by the half-twists
  have hHtop : Subgroup.closure (Set.range (fun i : Fin (n - 1) => halfTwistBraid n i)) =
      (⊤ : Subgroup (GeomBraidGroup n)) := by
    rw [Subgroup.eq_top_iff']
    intro x
    have himg : nu '' (Set.range (fun i : Fin (n - 1) => halfTwistBraid n i))
        = Set.range (fun i : Fin (n - 1) => Equiv.swap (strandIdx i) (strandIdxSucc i)) := by
      ext y
      constructor
      · rintro ⟨z, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, (hnu i).symm⟩
      · rintro ⟨i, rfl⟩
        exact ⟨halfTwistBraid n i, ⟨i, rfl⟩, hnu i⟩
    have hmapH : Subgroup.map nu
        (Subgroup.closure (Set.range (fun i : Fin (n - 1) => halfTwistBraid n i))) = ⊤ := by
      rw [MonoidHom.map_closure, himg]
      exact surj_perm_gen n
    have hxmem : nu x ∈ Subgroup.map nu
        (Subgroup.closure (Set.range (fun i : Fin (n - 1) => halfTwistBraid n i))) := by
      rw [hmapH]; trivial
    obtain ⟨h, hhH, hhx⟩ := hxmem
    have hker' : x * h⁻¹ ∈ nu.ker := by
      simp only [MonoidHom.mem_ker, map_mul, map_inv, hhx, mul_inv_cancel]
    rw [hker] at hker'
    have hmem := TarchaBraids.pureBraid_le_halfTwist_closure n hker'
    have hxeq : x = (x * h⁻¹) * h := by group
    rw [hxeq]
    exact mul_mem hmem hhH
  -- the range of `f` is exactly that subgroup
  have hsig : Set.range (fun i : Fin (n - 1) => sigma i) =
      Set.range (PresentedGroup.of (rels := braidRels n)) := rfl
  have himg2 : Set.range (fun i : Fin (n - 1) => halfTwistBraid n i) =
      f '' (Set.range (fun i : Fin (n - 1) => sigma i)) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨sigma i, ⟨i, rfl⟩, hf i⟩
    · rintro ⟨z, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, (hf i).symm⟩
  have hrange : f.range = (⊤ : Subgroup (GeomBraidGroup n)) := by
    calc f.range
        = Subgroup.map f (⊤ : Subgroup (ArtinBraidGroup n)) := by
          rw [MonoidHom.range_eq_map]
      _ = Subgroup.map f
            (Subgroup.closure (Set.range (fun i : Fin (n - 1) => sigma i))) :=
          congrArg (Subgroup.map f)
            ((congrArg Subgroup.closure hsig).trans
              (PresentedGroup.closure_range_of (braidRels n))).symm
      _ = Subgroup.closure (f '' (Set.range (fun i : Fin (n - 1) => sigma i))) :=
          MonoidHom.map_closure _ _
      _ = Subgroup.closure (Set.range (fun i : Fin (n - 1) => halfTwistBraid n i)) :=
          congrArg Subgroup.closure himg2.symm
      _ = ⊤ := hHtop
  exact MonoidHom.range_eq_top.mp hrange

