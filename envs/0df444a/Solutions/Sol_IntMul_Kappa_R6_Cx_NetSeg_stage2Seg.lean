lemma gops_eq (g : Gate) : gops g = (gq g).map (fun o => (aw o.1, aw o.2, (2 : ℤ))) := by
  obtain ⟨c, ins, outs⟩ := g
  unfold gops gq
  rw [List.map_append, List.map_map]
  congr 1
  rcases ins with _ | ⟨p, _ | ⟨i, _ | ⟨j, l⟩⟩⟩ <;> rfl

end

end IntMul.Kappa.R6.Cx.NetMask

