theorem solution (T : Butterfly.Op κ) (σ : Equiv.Perm (Fin W)) {r n : ℕ} (hr : 0 < r)
    (st : Fin m × κ → ℕ) (Z : ℕ) (hZ : NLogN.zsz ((2 * (W * (n * r)) : ℕ) : ℤ) ≤ Z) :
    NLogN.KFN.RImpl r n st ((P8Lift.RStep.perm σ : P8Lift.RStep (Fin W) m).den T) (NLogN.KFG.swapsP (n * r) (NLogN.KFG.permSw σ)) 0 0
      (fun w => W * NLogN.KFG.cAtom w 0 (n * r) W Z + 1) := by
  intro s f zs l X F w hC h0 hx hX hb
  have E0 := NLogN.KFN.enc_of_rec hr hX hx
  obtain ⟨E1, B1, H1⟩ := NLogN.KFG.perm_fsp σ s l w Z hZ (fun _ => F) f zs (NLogN.KFN.yR r X) E0 h0 hC.p hb
  refine ⟨_, ?_, by simpa using B1, H1⟩
  rw [add_zero]
  refine NLogN.KFN.rec_of_enc hr (fun v => NLogN.KFN.length_roleOpF _ _ _ _ _) E1 (fun v j hj c => ?_)
  rw [NLogN.KFN.roleOpF_perm _ _ _ _ hX]
  have hp : NLogN.KFG.pf σ⁻¹ v.val = (σ⁻¹ v).val := by simp [NLogN.KFG.pf, v.isLt]
  simp only [hp]
  rw [NLogN.KFN.yR_val hr X (σ⁻¹ v) j c]
