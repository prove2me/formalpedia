  have g : ∀ j : Fin HS, j ≠ 41 → j ≠ 39 → w2.G j = w.G j := by
    intro j h1 h2; simp [hw2, hw1, IState.upd_G, h1, h2]
  obtain ⟨RS0, hS0⟩ := hxs
  obtain ⟨RC, hC⟩ := hch
  have S3 := envP_spec M q hA.hMB hA.hP hA.hK hA.hlo hA.hkb hA.hMm hA.hcfg Bs w2 hr2 hA.hn u v R RV mu
    (by rw [g 0 (by decide) (by decide)]; exact hu) (by rw [g 30 (by decide) (by decide)]; exact hv)
    hA.hul hA.hvl ⟨w1.G dO, by simp [hw2, hD]⟩ ⟨RS0, by rw [g 1 (by decide) (by decide)]; exact hS0⟩
    ⟨RC, by rw [g 28 (by decide) (by decide)]; exact hC⟩ hA.hub hA.hvb hA.hmu hA.inU hA.inV hA.inW
    hA.hS2 hA.hBQ hA.hSQ
  set w3 := (w2.upd 30 RV).upd 0 (ints (exactConvL q u v) ++ R) with hw3
  have h39 : w3.G 39 = ints D ++ w1.G 39 := by simp [hw3, hw2]
  have hDB : Bnd B D := fun x hx => (desc_bnd q x hx).trans (by omega)
  have S4 := spec_drop M 39 19 (.lit ((8 * (q.K - 1) : ℕ) : ℤ)) w3 D (w1.G 39) (by decide) (by decide)
    (by decide) (by simp [Ex.Clean, Ex.regs]) h39 trivial (by simp only [Ex.eval]; rw [hD, desc_len]) B trivial
    (by simp only [Ex.Bnd]; exact zle (by omega)) hDB
  have h41 : (w3.upd 39 (w1.G 39)).G 41 = .int (cs : ℕ) :: w.G 41 := by
    simp (config := {decide := true}) [hw3, hw2, hw1, dO]
  have hcsB : zsz ((cs : ℕ) : ℤ) ≤ B := zle (lt_of_le_of_lt (CR.ceilSqrt_le_self q.p) (by nlinarith))
  have S5 := FW.spec_pop M 41 (w3.upd 39 (w1.G 39)) _ _ (by decide) h41 B hcsB
  have := S1.seq (S2.seq (S3.seq (S4.seq S5)))
  refine (this.congr ?_).mono (le_of_eq ?_)
  · apply IState.ext' _ (by simp [hw3, hw2, hw1]) (by simp [hw3, hw2, hw1])
    intro j
    simp only [IState.upd_G, hw3, hw2, hw1]
    split_ifs <;> simp_all
  · rw [hD, desc_len]; simp only [innerCost, envCost]

set_option maxHeartbeats 4000000 in
theorem midCore_spec (M : MulSpec) {kb Φf Φm m mm Φ Bacc Qa Bq Bx CS CB Q Bs mu : ℕ} {BS BB : ℕ → ℕ}
    (q : Params) (u v : List ℤ)
    (hA : ExArgs M q kb Φf Φm m mm Φ Bacc Qa Bq Bx CS CB Q Bs mu BS BB u v) (w : IState HS)
    (R1 R41 : List Item) (h1 : w.G 1 = .int (q.S : ℤ) :: R1)
    (h41 : w.G 41 = ints (EX.sl q).reverse ++ R41)
    (hr : EnvRegs q kb (w.upd 41 (.int (ceilSqrt q.p : ℕ) :: R41)))
    (R RV : List Item) (hu : w.G 0 = ints u ++ R) (hv : w.G 30 = ints v ++ RV)
    (hch : ∃ RC, w.G 28 = gints (chirpL q) ++ RC)
    (he : 2 ≤ q.e) (hdh : q.dh < q.K) (B : ℕ)
    (hB : 2 * q.fn + q.logOuter + q.e + 2 * q.K + 4 ≤ B) (hpB : q.p * q.p + q.p + 2 < 2 ^ B)
    (hKB : 8 * q.K < 2 ^ B) (hSB : zsz (q.S : ℤ) ≤ B) (hslB : Bnd B (EX.sl q)) :
    Spec M (midCore q.K) w (((w.upd 30 RV).upd 0 (ints (exactConvL q u v) ++ R)).upd 41 R41)
      (midCost q kb Bs CS CB Bx Q Φf Φm B) := by
  have hsl : (EX.sl q).length = q.K := by simp [EX.sl, hA.hcfg.hsl]
  have S1 := FW.spec_pop M 1 w _ _ (by decide) h1 B hSB
  set w1 := w.upd 1 R1 with hw1
  have h41' : w1.G 41 = ints (EX.sl q).reverse ++ R41 := by simp [hw1, h41]
  have hne : (Ex.lit (S := HS) (q.K : ℤ)).eval w1 = (EX.sl q).reverse.length := by
    simp [Ex.eval, hsl]
  have S2 : Spec M (.rs (mvList 41 1 19 (.lit (q.K : ℤ)))) w1
      ((w1.upd 41 R41).upd 1 (ints (EX.sl q).reverse.reverse ++ w1.G 1)) _ :=
    spec_rs (mvList_ok 41 1 19 _ w1 _ R41 (by decide) (by decide) (by decide) h41' hne (by decide)
      (by decide) (by decide) (by simp [Ex.Clean, Ex.regs]) trivial)
      (mvList_run 41 1 19 _ w1 _ R41 (by decide) (by decide) (by decide) h41' hne)
      (mvList_cost 41 1 19 _ w1 _ R41 (by decide) (by decide) (by decide) h41' hne B trivial
        (by simp only [Ex.Bnd]; exact zle (by omega)) (fun x hx => hslB x (List.mem_reverse.1 hx)))
  rw [List.reverse_reverse] at S2
  set w2 := (w1.upd 41 R41).upd 1 (ints (EX.sl q) ++ w1.G 1) with hw2
  have e2 : w2.upd 41 (.int (ceilSqrt q.p : ℕ) :: w2.G 41) =
      (w.upd 41 (.int (ceilSqrt q.p : ℕ) :: R41)).upd 1 (ints (EX.sl q) ++ R1) := by
    apply IState.ext' _ (by simp [hw2, hw1]) (by simp [hw2, hw1])
    intro j; simp only [IState.upd_G, hw2, hw1]; split_ifs <;> simp_all
  have hr2 : EnvRegs q kb (w2.upd 41 (.int (ceilSqrt q.p : ℕ) :: w2.G 41)) := by
    rw [e2]; exact hr.upd 1 (by decide) _
  obtain ⟨RC, hC⟩ := hch
  have S3 := innerP_spec M q u v hA w2 hr2 R RV (by simp [hw2, hw1, hu]) (by simp [hw2, hw1, hv])
    ⟨w1.G 1, by simp [hw2]⟩ ⟨RC, by simp [hw2, hw1, hC]⟩ he hdh B hB hpB hKB
  set w3 := (w2.upd 30 RV).upd 0 (ints (exactConvL q u v) ++ R) with hw3
  have h31 : w3.G 1 = ints (EX.sl q) ++ R1 := by simp [hw3, hw2, hw1]
  have S4 := spec_drop M 1 19 (.lit (q.K : ℤ)) w3 (EX.sl q) R1 (by decide) (by decide) (by decide)
    (by simp [Ex.Clean, Ex.regs]) h31 trivial (by simp [Ex.eval, hsl]) B trivial
    (by simp only [Ex.Bnd]; exact zle (by omega)) hslB
  obtain ⟨L45, h45⟩ := hr.r45
  have h45' : (w3.upd 1 R1).G 45 = .int (q.S : ℤ) :: L45 := by
    rw [IState.upd_G, if_neg (by decide)] at h45
    simp [hw3, hw2, hw1, h45]
  have S5 := FW.spec_push_reg M 1 45 (w3.upd 1 R1) _ _ (by decide) (by decide) h45' B hSB
  have := S1.seq (S2.seq (S3.seq (S4.seq S5)))
  refine (this.congr ?_).mono (le_of_eq ?_)
  · apply IState.ext' _ (by simp [hw3, hw2, hw1]) (by simp [hw3, hw2, hw1])
    intro j
    simp only [IState.upd_G, hw3, hw2, hw1]
    split_ifs <;> simp_all
  · simp only [midCost, Ex.size, hsl, List.length_reverse]

theorem regOK {w : IState HS} {j : Fin HS} {a : ℤ} {L : List Item} (h : w.G j = .int a :: L)
    (hj : j.val < 56) {B : ℕ} (hb : zsz a ≤ B) :
    (Ex.reg j).Clean ∧ (Ex.reg j).ok w ∧ (Ex.reg j).Bnd w B ∧ (Ex.reg j).eval w = a :=
  ⟨FW.clean_reg hj, CR.isInt_of' h, by simp only [Ex.Bnd, CR.top_of h]; exact hb,
    by simp only [Ex.eval, CR.top_of h]⟩

end NLogN.ST

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unreachableTactic false
set_option linter.unusedTactic false
open NLogN
open NLogN.ST
open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref
open NLogN.FW (Spec Desc descs enc8)
set_option maxHeartbeats 8000000
theorem solution (M : NLogN.MulSpec) {kb Φf Φm m mm Φ Bacc Qa Bq Bx CS CB Q Bs mu : ℕ} {BS BB : ℕ → ℕ}
    (q : Params) (u v : List ℤ)
    (hA : NLogN.ST.ExArgs M q kb Φf Φm m mm Φ Bacc Qa Bq Bx CS CB Q Bs mu BS BB u v) (t : NLogN.IState NLogN.HS)
    (R1 R41 L17 L37 L5 L6 L7 L9 L39 L26 : List NLogN.Item) (h1 : t.G 1 = .int (q.S : ℤ) :: R1)
    (h17 : t.G 17 = .int (q.p : ℤ) :: L17) (h37 : t.G 37 = .int (q.logT : ℤ) :: L37)
    (h5 : t.G 5 = .int ((2 ^ q.e : ℕ) : ℤ) :: L5) (h6 : t.G 6 = .int ((2 ^ (q.e - 1) : ℕ) : ℤ) :: L6)
    (h7 : t.G 7 = .int ((q.K - q.dh : ℕ) : ℤ) :: L7) (h9 : t.G 9 = .int (NLogN.EX.TT q : ℤ) :: L9)
    (h39 : t.G 39 = .int (q.logOuter : ℤ) :: L39) (h26 : t.G 26 = .int (q.fn : ℤ) :: L26)
    (h31 : ∃ L, t.G 31 = .int ((2 ^ q.b : ℕ) : ℤ) :: L) (h42 : ∃ L, t.G 42 = .int (q.α : ℤ) :: L)
    (h2 : ∃ L, t.G 2 = .int (kb : ℤ) :: L) (h44 : ∃ L, t.G 44 = .int (q.P : ℤ) :: L)
    (h41 : t.G 41 = NLogN.ints (NLogN.EX.sl q).reverse ++ R41)
    (R RV : List NLogN.Item) (hu : t.G 0 = NLogN.ints u ++ R) (hv : t.G 30 = NLogN.ints v ++ RV)
    (hch : ∃ RC, t.G 28 = NLogN.gints (chirpL q) ++ RC)
    (he : 2 ≤ q.e) (hdh : q.dh < q.K) (B : ℕ)
    (hB : 2 * q.fn + q.logOuter + q.e + 2 * q.K + 4 ≤ B) (hpB : q.p * q.p + q.p + 2 < 2 ^ B)
    (hKB : 8 * q.K < 2 ^ B) (hSB : NLogN.zsz (q.S : ℤ) ≤ B) (hslB : NLogN.Bnd B (NLogN.EX.sl q))
    (hTB : NLogN.EX.TT q < 2 ^ B) (hlTB : q.logT + 1 ≤ B) :
    NLogN.FW.Spec M (NLogN.ST.midP q.K) t (((t.upd 30 RV).upd 0 (NLogN.ints (exactConvL q u v) ++ R)).upd 41 R41)
      (NLogN.ST.midPCost q kb Bs CS CB Bx Q Φf Φm B) := by
  have b43 : NLogN.zsz (q.p : ℤ) ≤ B := NLogN.ST.zle (by nlinarith)
  have b46 : NLogN.zsz (q.logT : ℤ) ≤ B := NLogN.ST.zle' hlTB
  have b47 : NLogN.zsz (((2 ^ q.e : ℕ) : ℤ)) ≤ B := NLogN.ST.zsz_pow_nat _ _ (by omega)
  have b48 : NLogN.zsz (((2 ^ (q.e - 1) : ℕ) : ℤ)) ≤ B := NLogN.ST.zsz_pow_nat _ _ (by omega)
  have b49 : NLogN.zsz (((q.K - q.dh : ℕ) : ℤ)) ≤ B := NLogN.ST.zle' (by omega)
  have b50 : NLogN.zsz ((NLogN.EX.TT q : ℕ) : ℤ) ≤ B := NLogN.ST.zle hTB
  have b51 : NLogN.zsz (q.logOuter : ℤ) ≤ B := NLogN.ST.zle' (by omega)
  have b54 : NLogN.zsz (q.fn : ℤ) ≤ B := NLogN.ST.zle' (by omega)
  have o17 := NLogN.ST.regOK h17 (by decide) b43
  have o1 := NLogN.ST.regOK h1 (by decide) hSB
  have o37 := NLogN.ST.regOK h37 (by decide) b46
  have o5 := NLogN.ST.regOK h5 (by decide) b47
  have o6 := NLogN.ST.regOK h6 (by decide) b48
  have o7 := NLogN.ST.regOK h7 (by decide) b49
  have o9 := NLogN.ST.regOK h9 (by decide) b50
  have o39 := NLogN.ST.regOK h39 (by decide) b51
  have o26 := NLogN.ST.regOK h26 (by decide) b54
  have hx : ∀ x ∈ NLogN.ST.tmpL, x.1.val < 56 ∧ x.2.Clean ∧ x.2.ok t ∧ x.2.Bnd t B := by
    intro x hx
    simp only [NLogN.ST.tmpL, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨by decide, o17.1, o17.2.1, o17.2.2.1⟩
    · exact ⟨by decide, o1.1, o1.2.1, o1.2.2.1⟩
    · exact ⟨by decide, o37.1, o37.2.1, o37.2.2.1⟩
    · exact ⟨by decide, o5.1, o5.2.1, o5.2.2.1⟩
    · exact ⟨by decide, o6.1, o6.2.1, o6.2.2.1⟩
    · exact ⟨by decide, o7.1, o7.2.1, o7.2.2.1⟩
    · exact ⟨by decide, o9.1, o9.2.1, o9.2.2.1⟩
    · exact ⟨by decide, o39.1, o39.2.1, o39.2.2.1⟩
    · exact ⟨by decide, o26.1, o26.2.1, o26.2.2.1⟩
  have hf : List.Forall₂ (fun x y => x.2.eval t = y.2) NLogN.ST.tmpL (NLogN.ST.tmpV q) := by
    simp only [NLogN.ST.tmpL, NLogN.ST.tmpV, List.forall₂_cons, List.Forall₂.nil, and_true]
    exact ⟨o17.2.2.2, o1.2.2.2, o37.2.2.2, o5.2.2.2, o6.2.2.2, o7.2.2.2, o9.2.2.2, o39.2.2.2, o26.2.2.2⟩
  have hm : NLogN.ST.tmpL.map Prod.fst = (NLogN.ST.tmpV q).map Prod.fst := rfl
  have hP : NLogN.EX.PushOK B t NLogN.ST.tmpL (NLogN.ST.tmpV q) := NLogN.EX.pushOK_of B t NLogN.ST.tmpL [] (NLogN.ST.tmpV q) hm (by
    intro x hx i hi
    simp only [NLogN.ST.tmpL, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    (simp only [NLogN.Ex.regs, List.mem_singleton] at hi; subst hi; decide)) hx hf
  have hrb := NLogN.ST.forall2_bnd t B _ _ hf hx hm
  have hnd : ((NLogN.ST.tmpV q).map Prod.fst).Nodup := by simp only [NLogN.ST.tmpV, List.map]; decide
  have gm : ∀ r v, (r, v) ∈ NLogN.ST.tmpV q → (NLogN.EX.pushV t (NLogN.ST.tmpV q)).G r = .int v :: t.G r :=
    fun r v h => NLogN.EX.pushV_G_mem t (NLogN.ST.tmpV q) hnd r v h
  have gn : ∀ r, r ∉ (NLogN.ST.tmpV q).map Prod.fst → (NLogN.EX.pushV t (NLogN.ST.tmpV q)).G r = t.G r :=
    fun r h => NLogN.EX.pushV_G_not t r (NLogN.ST.tmpV q) h
  set w := NLogN.EX.pushV t (NLogN.ST.tmpV q) with hw
  have g41 : w.G 41 = NLogN.ints (NLogN.EX.sl q).reverse ++ R41 := by
    rw [gn 41 (by simp (config := {decide := true}) [NLogN.ST.tmpV])]; exact h41
  have hr : NLogN.ST.EnvRegs q kb (w.upd 41 (.int (ceilSqrt q.p : ℕ) :: R41)) := by
    have a : ∀ r, r ≠ 41 → (w.upd 41 (.int (ceilSqrt q.p : ℕ) :: R41)).G r = w.G r := by
      intro r hr; simp [NLogN.IState.upd_G, hr]
    obtain ⟨_, h31⟩ := h31
    obtain ⟨_, h42⟩ := h42
    obtain ⟨_, h2⟩ := h2
    obtain ⟨_, h44⟩ := h44
    exact ⟨⟨_, by rw [a _ (by decide)]; exact gm _ _ (by simp [NLogN.ST.tmpV])⟩, ⟨_, by rw [a _ (by decide)]; exact gm _ _ (by simp [NLogN.ST.tmpV])⟩, ⟨_, by rw [a _ (by decide), gn _ (by simp (config := {decide := true}) [NLogN.ST.tmpV])]; assumption⟩, ⟨_, by rw [a _ (by decide)]; exact gm _ _ (by simp [NLogN.ST.tmpV])⟩, ⟨_, by rw [a _ (by decide), gn _ (by simp (config := {decide := true}) [NLogN.ST.tmpV])]; assumption⟩, ⟨_, by rw [a _ (by decide)]; exact gm _ _ (by simp [NLogN.ST.tmpV])⟩, ⟨R41, by simp⟩, ⟨_, by rw [a _ (by decide), gn _ (by simp (config := {decide := true}) [NLogN.ST.tmpV])]; assumption⟩,
      ⟨_, by rw [a _ (by decide)]; exact gm _ _ (by simp [NLogN.ST.tmpV])⟩, ⟨_, by rw [a _ (by decide)]; exact gm _ _ (by simp [NLogN.ST.tmpV])⟩, ⟨_, by rw [a _ (by decide)]; exact gm _ _ (by simp [NLogN.ST.tmpV])⟩, ⟨_, by rw [a _ (by decide), gn _ (by simp (config := {decide := true}) [NLogN.ST.tmpV])]; assumption⟩, ⟨_, by rw [a _ (by decide)]; exact gm _ _ (by simp [NLogN.ST.tmpV])⟩, ⟨_, by rw [a _ (by decide)]; exact gm _ _ (by simp [NLogN.ST.tmpV])⟩⟩
  have S := NLogN.ST.midCore_spec M q u v hA w R1 R41 (by rw [gn 1 (by simp (config := {decide := true}) [NLogN.ST.tmpV])]; exact h1)
    g41 hr R RV (by rw [gn 0 (by simp (config := {decide := true}) [NLogN.ST.tmpV])]; exact hu)
    (by rw [gn 30 (by simp (config := {decide := true}) [NLogN.ST.tmpV])]; exact hv)
    (by rw [gn 28 (by simp (config := {decide := true}) [NLogN.ST.tmpV])]; exact hch) he hdh B hB hpB hKB hSB hslB
  have hF : ((w.upd 30 RV).upd 0 (NLogN.ints (exactConvL q u v) ++ R)).upd 41 R41 =
      NLogN.EX.pushV (((t.upd 30 RV).upd 0 (NLogN.ints (exactConvL q u v) ++ R)).upd 41 R41) (NLogN.ST.tmpV q) := by
    rw [hw, NLogN.ST.pushV_upd _ _ (NLogN.ST.tmpV q) t (by simp (config := {decide := true}) [NLogN.ST.tmpV]),
      NLogN.ST.pushV_upd _ _ (NLogN.ST.tmpV q) _ (by simp (config := {decide := true}) [NLogN.ST.tmpV]),
      NLogN.ST.pushV_upd _ _ (NLogN.ST.tmpV q) _ (by simp (config := {decide := true}) [NLogN.ST.tmpV])]
  exact NLogN.ST.bracket M NLogN.ST.tmpL (NLogN.ST.tmpV q) t B hP hrb (NLogN.ST.midCore q.K)
    (fun s => ((s.upd 30 RV).upd 0 (NLogN.ints (exactConvL q u v) ++ R)).upd 41 R41) hF _ S
