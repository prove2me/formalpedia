namespace Lattice

theorem graph_short_witness {p Q : ℕ} (hQ : 0 < Q) (u : Fin p → ℝ) :
    let α := 1 / (Q : ℝ) ^ (p + 1)
    ∃ (q : ℕ) (z : Fin p → ℤ), 0 < q ∧ q ≤ Q ^ p ∧ graphVector α u q z ≠ 0 ∧
      ‖graphVector α u q z‖ ≤ Real.sqrt (p + 1) / Q := by sorry
