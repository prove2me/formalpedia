  constructor
  · unfold tgtL
    rw [getD_append_eq, if_neg (by omega), show (lstL D ℓ K long).length + (e / K * D + i) * K +
      e % K - (lstL D ℓ K long).length = (e / K * D + i) * K + e % K by omega]
    have hcm : ∀ c ∈ chunkMajor D ℓ K, c.length = K := fun c hc => by
      obtain ⟨i, j, hj, rfl⟩ := (mem_chunkMajor D ℓ K).1 hc; exact Synth.length_chunk D ℓ K i hj
    rw [getD_flatten_uniform 0 _ hcm _ _ hm]
    have hcol : chunkMajor D ℓ K = ((List.range (Synth.qq ℓ K)).map fun j =>
        (List.finRange D).map fun i => Synth.chunk D ℓ K i j).flatten := by
      unfold chunkMajor; rw [List.flatMap_def]
    rw [hcol, getD_flatten_uniform [] _ (fun c hc => by
      simp only [List.mem_map, List.mem_range] at hc
      obtain ⟨j, -, rfl⟩ := hc; simp) _ _ i.isLt]
    rw [getD_map_range _ hj, getD_map_finRange]
    unfold Synth.chunk
    rw [getD_take_eq _ _ _ hm, getD_drop_eq,
      List.getD_eq_getElem _ _ (by rw [Synth.length_restA]; have := Nat.div_add_mod e K; nlinarith)]
    unfold restA
    rw [List.getElem_map, List.getElem_reverse, List.getElem_range]
    simp only [List.length_range]
    congr 1
    have := Nat.div_add_mod' e K
    have he' : e = Synth.qq ℓ K * K - 1 - (h - bb ℓ K) := rfl
    clear_value e
    generalize e / K * K = P2 at *
    generalize Synth.qq ℓ K * K = QK at *
    omega
  · have h1 := Nat.div_add_mod' e K
    have he' : e = Synth.qq ℓ K * K - 1 - (h - bb ℓ K) := rfl
    clear_value e
    have key : h - bb ℓ K = (Synth.qq ℓ K - 1 - e / K) * K + (K - 1 - e % K) := by
      have hq : (Synth.qq ℓ K - 1 - e / K) * K + e / K * K + K = Synth.qq ℓ K * K := by
        have : Synth.qq ℓ K - 1 - e / K + e / K + 1 = Synth.qq ℓ K := by omega
        calc (Synth.qq ℓ K - 1 - e / K) * K + e / K * K + K =
            (Synth.qq ℓ K - 1 - e / K + e / K + 1) * K := by ring
          _ = Synth.qq ℓ K * K := by rw [this]
      generalize (Synth.qq ℓ K - 1 - e / K) * K = P1 at *
      generalize e / K * K = P2 at *
      generalize Synth.qq ℓ K * K = QK at *
      omega
    rw [key, show (Synth.qq ℓ K - 1 - e / K) * K + (K - 1 - e % K) =
      (K - 1 - e % K) + (Synth.qq ℓ K - 1 - e / K) * K by ring, Nat.add_mul_mod_self_right,
      Nat.mod_eq_of_lt (show K - 1 - e % K < K by omega)]

end Synth

end

