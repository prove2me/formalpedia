          refine ⟨?_, ?_, hQ⟩ <;> simp
    obtain ⟨mc, alg, fin, free, hrank, hcard, hpi, -, -, hs, ⟨pc, c1, c2, c3, c4, -, hmeas⟩,
      Eq, h1, h2, h3⟩ := t_chart_point_child_member m.O m.htop m.pi m.hpi m.u m.a m.b m.ha
