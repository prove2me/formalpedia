theorem mvPush_sp (S : IState HS) (v : List ℤ) {eA eF eC : Ex HS} {a b c B : ℕ}
    (sA : MvSafe eA) (sF : MvSafe eF) (sC : MvSafe eC)
    (hA : EV (encK S (o0 v)) B eA a) (hF : EV (encK S (o0 v)) B eF b)
