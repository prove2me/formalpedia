  · change largestPrimeFactor 1 ≤ remainderPrime (fordRemainder x H n) (L x H)
    rw [fordRemainder_prime (Finset.mem_Icc.mpr ⟨hL,le_rfl⟩)]
    simpa [largestPrimeFactor] using (fordPrime_prime hindex).one_lt.le
