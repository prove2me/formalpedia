section WordBridges

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsComplex)

private theorem kCW_eq_word (x : AdelicGL2 (𝓞 F) F) {z : ℂ} {α β γ δ ε : ℝ}
    (h : kC (gOfC hw x) z
      = dPhiMat α * ((rotGLC β : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ) * dPhiMat γ
          * ((rotGLC δ : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ) * dPhiMat ε) :
    kCW hw x z = dPhiW hw α * rhoCW hw β * dPhiW hw γ * rhoCW hw δ * dPhiW hw ε := by
  have hGL : kCGL (gOfC_det_ne_zero hw x) z = dPhiGL α * rotGLC β * dPhiGL γ * rotGLC δ * dPhiGL ε := by
    apply Units.ext
    simp only [Units.val_mul, coe_kCGL, dPhiGL_coe]
    exact h
  simp only [kCW, dPhiW, rhoCW, hGL, map_mul]

private theorem kCW_eq_word_mul_rhoCW (x : AdelicGL2 (𝓞 F) F) {z : ℂ} {α β γ δ ε : ℝ}
    (h : kC (gOfC hw x) z * ((rotGLC (Real.pi / 2) : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)
      = dPhiMat α * ((rotGLC β : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ) * dPhiMat γ
          * ((rotGLC δ : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ) * dPhiMat ε) :
    kCW hw x z
      = dPhiW hw α * rhoCW hw β * dPhiW hw γ * rhoCW hw δ * dPhiW hw ε * rhoCW hw (-(Real.pi / 2)) := by
  have hGL : kCGL (gOfC_det_ne_zero hw x) z * rotGLC (Real.pi / 2)
      = dPhiGL α * rotGLC β * dPhiGL γ * rotGLC δ * dPhiGL ε := by
    apply Units.ext
    simp only [Units.val_mul, coe_kCGL, dPhiGL_coe]
    exact h
  have hk : kCGL (gOfC_det_ne_zero hw x) z
      = dPhiGL α * rotGLC β * dPhiGL γ * rotGLC δ * dPhiGL ε * rotGLC (-(Real.pi / 2)) := by
    rw [← hGL, ← rotGLC_inv, mul_inv_cancel_right]
  simp only [kCW, dPhiW, rhoCW, hk, map_mul]

end WordBridges
