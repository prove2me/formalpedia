theorem fastHighSlope_secant {i : Bounds} {x y : ℝ} (hlo : lamQ ≤ i.lo) (hhi : i.hi ≤ 1)
    (hx : i.Holds x) (hy : i.Holds y) : Secants totalScore x y (fastHighSlope i) :=
  endpointSlope_secant quickRow quickRow_spec hlo hhi hx hy

end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperMiddle
open PaperBox
noncomputable section

theorem fast_route (k l : Knot) (ho : k.position < l.position) (hm : (k,l)∈adjacentCells) (T : Cover 3)
    (ok : T.verify (fastRectTest PaperCurve.fastHighSlope k l) ![⟨qRank k,qRank l⟩,⟨0,min (qRank l) PaperCurve.lamQ⟩,
      ⟨max (qRank k) PaperCurve.lamQ,1⟩]=true) : CellCovered k l :=
  cell_of_fast_tree k l (div_lt_div_of_pos_right (by exact_mod_cast ho) (by norm_num))
    hm T PaperCurve.fastHighSlope_secant ok

end
end StableVotingDistortion.PaperMiddle
end

open StableVotingDistortion StableVotingDistortion.PaperMiddle StableVotingDistortion.PaperCurve StableVotingDistortion.PaperBox Set
theorem solution {k l : PaperMiddle.Knot} (ho : k.position < l.position) (hm : (k,l) ∈ adjacentCells)
    (ok : RectWitness k l (qRank k) (qRank l) 0 (min (qRank l) PaperCurve.lamQ)
      (max (qRank k) PaperCurve.lamQ) 1) : CellCovered k l := by
  exact let ⟨t,ht⟩ := ok; PaperMiddle.fast_route k l ho hm t ht
