theorem solution
    {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv) (pc : ℕ)
    (e : ℕ → F) (m : ℕ → ℕ) (hAt : At P pc (Stmt.compile rootSearchProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι) (ht : 1 ≤ t)
    (hEnd : decoderAllocEnd t < 2 ^ E.W) (hN : N < 2 ^ w) (hReady : KeyReady b E t N e m) :
    Sem P E pc (pc + 4047) (boundaryState pc m)
      (fun k z => k ≤ rootPhaseBudget t w ∧ ∃ m', z = boundaryState (pc + 4047) m' ∧
        CandidateReady b ι t N e m' ∧ MemoryFrame
          (rootSearchWritable (decoderRowBase t 0) (decoderRowBase t 6) (decoderRowBase t 1) (decoderRowBase t 7)
            (decoderRowBase t 4) (decoderCapacity t) (decoderQueue0 t) (decoderQueue1 t) (decoderOutputBase t) t) m m') := by
  have hg := decoderGeometry_spec E t hEnd
  have hmin := padeSolve_minimal e t ht
  obtain ⟨src, h75, hlo, hword, hstored, hdisj⟩ := hReady.sigma
  have hRoot := rootSearchProcedure_spec b ι t N P E pc (decoderRowBase t 0) (decoderRowBase t 6)
    (decoderRowBase t 1) (decoderRowBase t 7) (decoderRowBase t 4) (decoderRowBase t 5) (decoderCapacity t)
    (decoderLength t) (decoderQueue0 t) (decoderQueue1 t) (decoderOutputBase t) src (padeSolve e t).curC m hAt
    hw hW hdet ht rfl rfl (decoderRows_root t) (decoderRows_root_words E t (le_of_lt hEnd)) hg.firstLow hg.secondLow hg.outputLow
    hg.firstWord hg.secondWord hg.outputWord (decoderQueue0_root_separated t) (decoderQueue1_root_separated t)
    (Or.inl hg.queues) (Or.inl hg.firstOutput) (Or.inl hg.secondOutput) (by have hh := hg.metadata; omega)
    (lt_of_lt_of_le hN (Nat.pow_le_pow_right (by norm_num) (by omega : w ≤ E.W)))
    hlo hword hdisj hmin.1.1 hmin.1.2.1 hReady.root hstored h75 hReady.firstQueue hReady.fixedQ1 hReady.output
  refine Sem.mono hRoot ?_
  intro k z hQ
  obtain ⟨hk, m2, hz2, h100, h101, h85, hout, hlen, hf⟩ := hQ
  have hm (slot : ℕ) (hs : slot < 128) (hb : ¬ rootBasisMeta slot) (he : ¬ rootEmissionMeta slot) :=
    rootSearch_preserved_meta hf slot hs hb he
  have hCandidate : CandidateReady b ι t N e m2 := by
    refine ⟨hReady.saved.of_frame hf (rootSearch_saved_readonly t), hout, ?_, ?_, ?_, h85, ?_, h100, h101⟩
    · exact (hm 79 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])
        (by norm_num [rootEmissionMeta])).trans hReady.savedBase
    · exact (hm 77 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])
        (by norm_num [rootEmissionMeta])).trans hReady.root.dimension
    · exact (hm 80 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])
        (by norm_num [rootEmissionMeta])).trans hReady.tValue
    · exact (hm 86 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])
        (by norm_num [rootEmissionMeta])).trans hReady.verification
  exact ⟨hk, m2, hz2, hCandidate, hf⟩
