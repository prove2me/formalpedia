  calc ∑ i ∈ range (m + 1), dgt b M x i * dgt b M y (m - i)
      ≤ ∑ i ∈ range (m + 1), 2 ^ b * 2 ^ b :=
        sum_le_sum fun i _ => Nat.mul_le_mul (dgt_lt b M x i).le (dgt_lt b M y _).le
    _ = (m + 1) * (2 ^ b * 2 ^ b) := by simp

theorem zsz_cN {n : ℕ} (x y m : ℕ) (hm : m < sCmp n) :
    zsz (cN (dgt (bP n) (NLogN.KFM.mN n) x) (dgt (bP n) (NLogN.KFM.mN n) y) m : ℤ) ≤ pP n + 2 := by
  have h1 := cN_le (bP n) (NLogN.KFM.mN n) x y m
  have h2 := sCmp_lt n
  apply KFL.zsz_le_of_abs
  rw [abs_of_nonneg (by positivity)]
  have : cN (dgt (bP n) (NLogN.KFM.mN n) x) (dgt (bP n) (NLogN.KFM.mN n) y) m < 2 ^ (pP n + 2) := by
    calc cN (dgt (bP n) (NLogN.KFM.mN n) x) (dgt (bP n) (NLogN.KFM.mN n) y) m
        ≤ (m + 1) * (2 ^ bP n * 2 ^ bP n) := h1
      _ ≤ 2 ^ bP n * (2 ^ bP n * 2 ^ bP n) := Nat.mul_le_mul_right _ (by omega)
      _ = 2 ^ (3 * bP n) := by ring
      _ < 2 ^ (pP n + 2) := Nat.pow_lt_pow_right (by norm_num) (by unfold pP; omega)
  exact_mod_cast this

theorem dgt_zero (b M x i : ℕ) (hi : M ≤ i) : dgt b M x i = 0 := by
  unfold dgt; rw [if_neg (by omega)]

variable {E : ℕ} {ix : Ix (7 + E)} {Isym : List Sym} {extM : Fin E → IStmt HS (7 + E)} {n D : ℕ}
  [instS : ∀ i, NeZero (sBD n D i)] [instT : ∀ i, NeZero (tBD n D i)]

theorem BigCtx.prodNe (C : BigCtx ix Isym extM n D) : NeZero (∏ i, sBD n D i) :=
  ⟨Finset.prod_ne_zero_iff.2 fun i _ => (instS i).out⟩

theorem BigCtx.prodNe' (C : BigCtx ix Isym extM n D) : NeZero (∏ i, sBox (D + 1) (srcN n) i) :=
  C.prodNe

/-- **The convolution of the digits.** -/
theorem cconv_ubar (C : BigCtx ix Isym extM n D) (x y m : ℕ) (hm : m < sCmp n) :
    haveI := C.prodNe
    cconv (sBD n D) (ubar C x) (ubar C y)
      (NLogN.KFM.eB (srcN n) (muN n) C.H (m : ZMod (∏ i, sBox (D + 1) (srcN n) i))) =
      (cN (dgt (bP n) (NLogN.KFM.mN n) x) (dgt (bP n) (NLogN.KFM.mN n) y) m : ℂ) := by
  haveI := C.prodNe
  have hMP : 2 * NLogN.KFM.mN n ≤ ∏ i, sBD n D i := C.hMS
  have hm' : m < ∏ i, sBD n D i := by rw [← C.hS]; exact hm
  exact cconv_digits (sBD n D) (sBox_cop (srcN n) (muN n) C.H) (fun i => muN n i)
    (sBox_mu (srcN n) (muN n) C.H) (dgt (bP n) (NLogN.KFM.mN n) x) (dgt (bP n) (NLogN.KFM.mN n) y) (NLogN.KFM.mN n)
    (fun i hi => dgt_zero _ _ _ _ hi) (fun j hj => dgt_zero _ _ _ _ hj) hMP hm'

/-- **The rounded value at one point.** -/
theorem pt_val (C : BigCtx ix Isym extM n D) (x y : ℕ) (zsZ : List GI)
    (Z : ((i : Fin (D + 1)) → ZMod (sBD n D i)) → ℂ)
    (hZ : RepPad (pP n) (sBD n D) (tBD n D) zsZ Z) (hcl : Close C x y Z)
    (k : (i : Fin (D + 1)) → ZMod (sBD n D i)) :
    rndV (pP n) (bP n) (sCmp n) (zsZ.getD (encode (List.ofFn (tBD n D)) (kL k)) 0).1 =
        cN (dgt (bP n) (NLogN.KFM.mN n) x) (dgt (bP n) (NLogN.KFM.mN n) y) ((NLogN.KFM.eB (srcN n) (muN n) C.H).symm k).val ∧
      rndV (pP n) (bP n) (sCmp n) (-(zsZ.getD (encode (List.ofFn (tBD n D)) (kL k)) 0).2) = 0 := by
  haveI := C.prodNe
  haveI := C.prodNe'
  have hb := (setup_facts C.hn).1
  set z := zsZ.getD (encode (List.ofFn (tBD n D)) (kL k)) 0 with hz
  set m := ((NLogN.KFM.eB (srcN n) (muN n) C.H).symm k).val with hm
  have hmS : m < sCmp n := by rw [C.hS]; exact ZMod.val_lt _
  have hk : NLogN.KFM.eB (srcN n) (muN n) C.H (m : ZMod (∏ i, sBox (D + 1) (srcN n) i)) = k := by
    rw [hm, ZMod.natCast_zmod_val]; exact (NLogN.KFM.eB (srcN n) (muN n) C.H).apply_symm_apply k
  have hc : cconv (sBD n D) (ubar C x) (ubar C y) k =
      (cN (dgt (bP n) (NLogN.KFM.mN n) x) (dgt (bP n) (NLogN.KFM.mN n) y) m : ℂ) := by
    have := cconv_ubar C x y m hmS
    rw [hk] at this
    exact this
  have h1 := hcl k
  have eS : (((∏ i, (sBD n D i : ℝ)) : ℝ) : ℂ) = ((sCmp n : ℕ) : ℂ) := by
    rw [C.hS]; push_cast; rfl
  have eZ : cnj Z k = starRingEnd ℂ (toC z / 2 ^ pP n) := by
    rw [RepPad.eq C.hst hZ]; rfl
  rw [eS, eZ, hc] at h1
  exact round_pt (pP n) (bP n) (sCmp n) (by unfold pP; omega) z _ h1

theorem zsWf_getD {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (zsZ : List GI) (x : ℕ) :
    (zsWf n zsZ).getD x 0 = (rndV (pP n) (bP n) (sCmp n) (zsZ.getD x 0).1,
      rndV (pP n) (bP n) (sCmp n) (-(zsZ.getD x 0).2)) := by
  have hb := (setup_facts hn).1
  have hp : 1 ≤ pP n := by unfold pP; omega
  have g0 : (fun z : GI => (rndV (pP n) (bP n) (sCmp n) z.1, rndV (pP n) (bP n) (sCmp n) z.2)) 0 =
      0 := by
    simp only [Prod.fst_zero, Prod.snd_zero, gR_zero _ _ _ hp]; rfl
  rw [zsWf, NLogN.KFM.getD_map0 _ g0, NLogN.KFM.getD_map0 NLogN.KFM.gconj rfl]
  rfl

/-- **All rounded numerators are small.** -/
theorem zsW_GB (C : BigCtx ix Isym extM n D) (x y : ℕ) (zsZ : List GI)
    (Z : ((i : Fin (D + 1)) → ZMod (sBD n D i)) → ℂ)
    (hZ : RepPad (pP n) (sBD n D) (tBD n D) zsZ Z) (hcl : Close C x y Z) :
    NLogN.KFB.GB (pP n + 2) (zsWf n zsZ) := by
  have hb := (setup_facts C.hn).1
  have hp : 1 ≤ pP n := by unfold pP; omega
  intro w hw
  obtain ⟨xi, hxi, rfl⟩ := List.getElem_of_mem hw
  have hlen : (zsWf n zsZ).length = zsZ.length := by simp [zsWf]
  have hxi' : xi < zsZ.length := hlen ▸ hxi
  have hx' : xi < (List.ofFn (tBD n D)).prod := hZ.1 ▸ hxi'
  rw [← List.getD_eq_getElem _ 0 hxi, zsWf_getD C.hn]
  by_cases hs : ∀ i, boxIx (tBD n D) xi i < sBD n D i
  · set k : (i : Fin (D + 1)) → ZMod (sBD n D i) :=
      fun i => ((boxIx (tBD n D) xi i : ℕ) : ZMod (sBD n D i)) with hk
    have he : encode (List.ofFn (tBD n D)) (kL k) = xi := by
      rw [hk, kL_cast _ hs, encode_boxIx _ hx']
    obtain ⟨v1, v2⟩ := pt_val C x y zsZ Z hZ hcl k
    rw [he] at v1 v2
    rw [v1, v2]
    haveI := C.prodNe
    haveI := C.prodNe'
    have hmS : ((NLogN.KFM.eB (srcN n) (muN n) C.H).symm k).val < sCmp n := by
      rw [C.hS]; exact ZMod.val_lt _
    exact ⟨zsz_cN x y _ hmS, by rw [zsz_zero]; omega⟩
  · have e := (hZ.2 xi hx').2 hs
    rw [e]
    simp only [Prod.fst_zero, Prod.snd_zero, neg_zero, gR_zero _ _ _ hp, zsz_zero]
    omega

theorem carOut_xy (b M S x y : ℕ) (cs : List GI) (hl : cs.length = S) (h2 : 2 * M ≤ S)
    (hx : x < 2 ^ (b * M)) (hy : y < 2 ^ (b * M))
    (hcs : ∀ m < S, cs.getD m 0 = (((cN (dgt b M x) (dgt b M y) m : ℕ) : ℤ), (0 : ℤ))) :
    carOut b cs = x * y := by
  rw [carOut_eq_sum, hl]
  have e : ∀ h ∈ range S, (reN cs).getD h 0 * (2 ^ b) ^ h =
      cN (dgt b M x) (dgt b M y) h * (2 ^ b) ^ h := by
    intro h hh
    have hh' := mem_range.1 hh
    have : (reN cs).getD h 0 = (cs.getD h 0).1.toNat := by
      unfold reN
      rw [List.getD_eq_getElem _ _ (by simp; omega), List.getD_eq_getElem _ _ (by omega),
        List.getElem_map]
    rw [this, hcs h hh']
    simp
  rw [sum_congr rfl e, sum_cN _ _ M S (2 ^ b) (fun i hi => dgt_zero _ _ _ _ hi)
    (fun j hj => dgt_zero _ _ _ _ hj) h2]
  have e2 : ∀ z, ∑ i ∈ range M, dgt b M z i * (2 ^ b) ^ i =
      ∑ i ∈ range M, dgt b M z i * 2 ^ (b * i) :=
    fun z => sum_congr rfl fun i _ => by rw [← pow_mul]
  rw [e2, e2, sum_dgt b M x hx, sum_dgt b M y hy]

end

end NLogN.KFM

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFM
open Finset AModel AModelL12 IntMul KIL KFB KFT KFU RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost
variable {E : ℕ} {ix : Ix (7 + E)} {Isym : List Sym} {extM : Fin E → IStmt HS (7 + E)} {n D : ℕ}
  [instS : ∀ i, NeZero (sBD n D i)] [instT : ∀ i, NeZero (tBD n D i)]
set_option maxHeartbeats 8000000
theorem solution (C : NLogN.KFM.BigCtx ix Isym extM n D) (t : NLogN.IState NLogN.HS) (hR : NLogN.KFM.BaseOK t n) (x y : ℕ)
    (hx : x < 2 ^ n) (hy : y < 2 ^ n) (zsZ : List NLogN.KFB.GI)
    (Z : ((i : Fin (D + 1)) → ZMod (NLogN.KFM.sBD n D i)) → ℂ)
    (h0 : t.G 0 = NLogN.ints (NLogN.KFB.gflat zsZ)) (hZ : NLogN.KFM.RepPad (IntMul.OpenAI.Glue.pP n) (NLogN.KFM.sBD n D) (NLogN.KFM.tBD n D) zsZ Z)
    (hg : NLogN.KFB.GB (NLogN.KFM.wU n D) zsZ) (hcl : NLogN.KFM.Close C x y Z) (hout : t.out = []) :
    ∃ s' c, NLogN.IRuns Isym (NLogN.KFM.kTable extM) (NLogN.KFM.finP ix) t s' c ∧ s'.out = IntMul.bin (2 * n) (x * y) ∧
      (c : ℝ) ≤ NLogN.KFM.kFin C := by
  have hn := C.hn
  have hD := C.hD
  have hb := (NLogN.KFM.setup_facts hn).1
  -- the rounding passes
  have hl := NLogN.KFM.len_T hn hD hZ.1
  have r1 := NLogN.KFM.finA_runs (I := Isym) extM hn t hR zsZ hl h0 hg
  change NLogN.IRuns _ _ _ t (t.upd 0 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFM.zsWf n zsZ)))) _ at r1
  have hWg := NLogN.KFM.zsW_GB C x y zsZ Z hZ hcl
  set W := NLogN.KFM.zsWf n zsZ with hW
  set t1 := t.upd 0 (NLogN.ints (NLogN.KFB.gflat W)) with ht1
  have hR1 : NLogN.KFM.BaseOK t1 n := hR.upd 0 (by decide) _
  -- `Φ⁻¹`
  have hWl : W.length = (List.ofFn (NLogN.KFM.tBD n D)).prod := by simp [hW, NLogN.KFM.zsWf, hZ.1]
  have eT : ∏ i : Fin (D + 1), NLogN.KFU.tP (D + 1) (IntMul.OpenAI.Glue.ℓP n - 1) (NLogN.KFM.bLn n) i = ∏ i, NLogN.KFM.tBD n D i :=
    Finset.prod_congr rfl fun i _ => congrFun (NLogN.KFM.tBox_eq hn hD) i
  have hlen : (NLogN.KFB.gflat W).length = AModel.vol (NLogN.KFU.shR (IntMul.OpenAI.Glue.dP n) (NLogN.KFU.tP (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.ℓP n - 1) (NLogN.KFM.bLn n))) := by
    rw [NLogN.KFB.length_gflat, hWl, NLogN.KFM.vol_shR, NLogN.KFM.tP_last, hD,
      ← Fin.prod_univ_eq_prod_range (fun j => NLogN.KFU.tP (D + 1) (IntMul.OpenAI.Glue.ℓP n - 1) (NLogN.KFM.bLn n) j) (D + 1), eT,
      List.prod_ofFn]
    ring
  obtain ⟨c2, r2, hc2⟩ := (NLogN.KFM.phi_phase C.hp₁ hn C.hdΦ C.hΦ C.BΦ C.hBΦ t1 hR1 (NLogN.KFB.gflat W) []
    (by simp [t1]) (NLogN.KFL.zsz_gflat hWg)).2 hlen
  rw [ht1, NLogN.IState.upd_upd_same, List.append_nil] at r2
  set Y := NLogN.KFU.PhiInvD (IntMul.OpenAI.Glue.ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (NLogN.KFM.bLn n) (NLogN.KFM.srcN n) (NLogN.KFM.muN n) (NLogN.KFB.gflat W) with hY
  have hYl : Y.length = 2 * NLogN.KFM.sCmp n := by
    rw [hY, NLogN.KFM.length_PhiInvD, NLogN.KFM.vol_shK, C.hS, hD, ← Fin.prod_univ_eq_prod_range]; rfl
  obtain ⟨cs, hcs⟩ := NLogN.KFM.exists_gflat Y (by rw [hYl]; exact even_two_mul _)
  have hcsl : cs.length = NLogN.KFM.sCmp n := by
    have := congrArg List.length hcs; rw [NLogN.KFB.length_gflat, hYl] at this; omega
  -- the values
  have hval : ∀ m < NLogN.KFM.sCmp n, cs.getD m 0 =
      (((NLogN.KFM.cN (NLogN.KFM.dgt (IntMul.OpenAI.Glue.bP n) (NLogN.KFM.mN n) x) (NLogN.KFM.dgt (IntMul.OpenAI.Glue.bP n) (NLogN.KFM.mN n) y) m : ℕ) : ℤ), (0 : ℤ)) := by
    intro m hm
    haveI := NLogN.KFM.sBox_ne (NLogN.KFM.srcN n) (NLogN.KFM.muN n) C.H
    haveI := C.prodNe
    haveI := C.prodNe'
    have hmS : m < ∏ i, NLogN.KFM.sBD n D i := by rw [← C.hS]; exact hm
    have hmP : m < IntMul.OpenAI.RCRT.Ppre (NLogN.KFM.srcN n) (D + 1) := by rw [← NLogN.KFU.Ppre_eq_prod]; exact hmS
    have hY' : Y = NLogN.KFU.PhiInvD (IntMul.OpenAI.Glue.ℓP n - 1) (D + 1) (NLogN.KFM.bLn n) (NLogN.KFM.srcN n) (NLogN.KFM.muN n) (NLogN.KFB.gflat W) := by rw [hY, hD]
    have a0 := NLogN.KFM.phiInvD_read (IntMul.OpenAI.Glue.ℓP n - 1) (NLogN.KFM.bLn n) (NLogN.KFM.srcN n) (NLogN.KFM.muN n) C.H (NLogN.KFM.hsw_of hn hD C.hst) W
      (c := 0) hmP (by norm_num)
    have a1 := NLogN.KFM.phiInvD_read (IntMul.OpenAI.Glue.ℓP n - 1) (NLogN.KFM.bLn n) (NLogN.KFM.srcN n) (NLogN.KFM.muN n) C.H (NLogN.KFM.hsw_of hn hD C.hst) W
      (c := 1) hmP (by norm_num)
    simp only [if_pos rfl, if_neg one_ne_zero, add_zero] at a0 a1
    rw [NLogN.KFM.tBox_eq hn hD, hW, NLogN.KFM.zsWf_getD hn] at a0 a1
    set k : (i : Fin (D + 1)) → ZMod (NLogN.KFM.sBD n D i) :=
      NLogN.KFM.eB (NLogN.KFM.srcN n) (NLogN.KFM.muN n) C.H (m : ZMod (∏ i, NLogN.KFM.sBox (D + 1) (NLogN.KFM.srcN n) i)) with hk
    obtain ⟨v1, v2⟩ := NLogN.KFM.pt_val C x y zsZ Z hZ hcl k
    have hsym : ((NLogN.KFM.eB (NLogN.KFM.srcN n) (NLogN.KFM.muN n) C.H).symm k).val = m := by
      rw [hk, AddEquiv.symm_apply_apply]; exact ZMod.val_cast_of_lt hmS
    rw [NLogN.KFM.getD_of_gflat hcs, hY']
    refine Prod.ext ?_ ?_
    · exact a0.trans (v1.trans (by rw [hsym]))
    · exact a1.trans v2
  have hmem : ∀ z ∈ cs, ∃ m < NLogN.KFM.sCmp n,
      z = (((NLogN.KFM.cN (NLogN.KFM.dgt (IntMul.OpenAI.Glue.bP n) (NLogN.KFM.mN n) x) (NLogN.KFM.dgt (IntMul.OpenAI.Glue.bP n) (NLogN.KFM.mN n) y) m : ℕ) : ℤ), (0 : ℤ)) := by
    intro z hz
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
    refine ⟨i, hcsl ▸ hi, ?_⟩
    rw [← List.getD_eq_getElem _ 0 hi, hval i (hcsl ▸ hi)]
  have hre : ∀ z ∈ cs, 0 ≤ z.1 := fun z hz => by
    obtain ⟨m, -, rfl⟩ := hmem z hz; simp
  have hBc : NLogN.KFB.GB (IntMul.OpenAI.Glue.pP n + 2) cs := fun z hz => by
    obtain ⟨m, hm, rfl⟩ := hmem z hz
    exact ⟨NLogN.KFM.zsz_cN x y m hm, by simp [NLogN.zsz_zero]⟩
  -- carries
  set t2 := t.upd 0 (NLogN.ints Y) with ht2
  have hR2 : NLogN.KFM.BaseOK t2 n := hR.upd 0 (by decide) _
  have hxy : NLogN.KFT.carOut (IntMul.OpenAI.Glue.bP n) cs = x * y :=
    NLogN.KFM.carOut_xy (IntMul.OpenAI.Glue.bP n) (NLogN.KFM.mN n) (NLogN.KFM.sCmp n) x y cs hcsl (by have := C.hMS; rw [C.hS]; exact this)
      (lt_of_lt_of_le hx (Nat.pow_le_pow_right (by norm_num) (NLogN.KFM.le_bM hn)))
      (lt_of_lt_of_le hy (Nat.pow_le_pow_right (by norm_num) (NLogN.KFM.le_bM hn))) hval
  have r3 : NLogN.IRuns Isym (NLogN.KFM.kTable extM) NLogN.KFM.carW t2 (t2.upd 0 [.int ((x * y : ℕ) : ℤ)])
      (NLogN.KFM.cCarU (IntMul.OpenAI.Glue.bP n) (IntMul.OpenAI.Glue.pP n + 2) cs.length + NLogN.KFM.cW (NLogN.KFM.sCmp n : ℤ) + NLogN.KFM.cW (2 ^ IntMul.OpenAI.Glue.bP n)) := by
    refine NLogN.KFM.withD_runs (by decide) (by decide) hR2.hB2 ?_
    refine NLogN.KFM.withD_runs (by decide) (by decide) (hR2.hS.upd NLogN.KFM.uB2 (by decide) _) ?_
    rw [← hxy]
    refine NLogN.KFM.carIU_spec (IntMul.OpenAI.Glue.bP n) (IntMul.OpenAI.Glue.pP n + 2) (by omega) cs hre hBc _ [] (t2.G NLogN.KFM.uB2) (t2.G NLogN.KFM.uM) ?_ ?_ ?_
    · simp +decide [NLogN.IState.upd_G, t2, hcs]
    · simp +decide [NLogN.IState.upd_G]
    · simp +decide [NLogN.IState.upd_G, hcsl]
  -- write
  obtain ⟨LW, hLW⟩ := hR2.hO
  have hv : x * y < 2 ^ (2 * n) := by
    rw [two_mul, pow_add]; exact Nat.mul_lt_mul'' hx hy
  have r4 := NLogN.KFT.writeI_spec (I := Isym) (iprog := NLogN.KFM.kTable extM) (A := 0) (W := NLogN.KFM.rO) (by decide)
    (t2.upd 0 [.int ((x * y : ℕ) : ℤ)]) (x * y) (2 * n) hv [] LW (by simp)
    (by simp +decide [NLogN.IState.upd_G, hLW])
  refine ⟨_, _, r1.seq (r2.seq (r3.seq r4)), ?_, ?_⟩
  · simp [t2, hout]
  · rw [hcsl]
    unfold NLogN.KFM.kFin
    push_cast
    linarith
end
