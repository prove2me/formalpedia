    simp only [s3, NLogN.KFC.cf, T', s] at *
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · have hz : NLogN.zsz ((n : ℤ)) ≤ NLogN.zsz ((n : ℤ)) := le_rfl
    unfold NLogN.KFT.cRpt; omega
end
