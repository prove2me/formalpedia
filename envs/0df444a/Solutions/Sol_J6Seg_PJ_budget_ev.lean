-- Source module: Solutions.J6SegILPreJC12
/-!
# B5 set-up, part 12: a polynomial per-axis budget

`budget_ev K e`: eventually `K · b^e · t^e · p^e ≤ cU6 P n A' / (D + 1)` on every axis
(`t^{e+1} ≤ 2^e T` once `d ≥ e + 1`, and `(K b^{e+1} p^e)^{e+1} 2^{e²} ≤ T`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.PJ

open IntMul NLogN IntMul.Kappa.R6 J6Seg

theorem root_le {a c e : ℕ} (h : a ^ (e + 1) ≤ c ^ (e + 1)) : a ≤ c :=
  (Nat.pow_le_pow_iff_left (by omega)).mp h

/-- **A polynomial per-axis budget.** -/
theorem budget_ev_sol_aux (P : Prm) (hP : P.Ok) (K e : ℕ) :
    ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ k ≤ D, ∀ A' : ℕ,
      ((K * bP6 n ^ e * tF6 P n k ^ e * pP6 P n ^ e : ℕ) : ℝ) ≤ cU6 P n A' / (D + 1) := by
  obtain ⟨n₂, hQ⟩ := qok_of P hP
  obtain ⟨n₃, hd3⟩ := eventually_d_ge P hP (e + 1)
  set C0 := K ^ (e + 1) * 6 ^ (e * (e + 1)) * 2 ^ (e * e) with hC0
  set N := (e + 1) * (e + 1) + (1 + P.x) * (e * (e + 1) + 1) with hN
  obtain ⟨B₀, hB⟩ := poly_le_two_pow_half (N + 1)
  obtain ⟨n₄, hb4⟩ := eventually_b_ge (max B₀ (max C0 2))
  refine ⟨max (max n₂ n₃) (max n₄ 2), fun n hn src hs D hD k hk A' => ?_⟩
  have hn2 : n₂ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn
  have hn3 : n₃ ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn
  have hn4 : n₄ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
  have hn5 : 2 ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hn
  have hq := hQ n hn2 src hs
  have hd : e + 1 ≤ dP6 P n := hd3 n hn3
  have hbB := hb4 n hn4
  set b := bP6 n with hbdef
  set b' := b'P6 P n with hb'def
  set p := pP6 P n with hpdef
  set d := dP6 P n with hddef
  set t := tF6 P n k with htdef
  set T := TP6 P n with hTdef
  set L := LP6 P n with hLdef
  set ℓ := ℓP6 P n with hℓdef
  have hb2 : 2 ≤ b := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hbB
  have hbC : C0 ≤ b := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hbB
  have hbB0 : B₀ ≤ b := le_trans (le_max_left _ _) hbB
  have hpe : p = 6 * b' := rfl
  have hb'e : b' = b ^ (1 + P.x) := rfl
  have hb'1 : 1 ≤ b' := b'P6_pos P n
  have hp1 : 1 ≤ p := by omega
  -- `t^{e+1} ≤ 2^e T`
  have hℓ2 : 2 ≤ ℓ := hq.hℓ2
  have htl : t ≤ 2 ^ ℓ := by
    have e' : ℓ = hN6 P n + 1 := by simp only [hℓdef, hN6]; omega
    simp only [htdef, tF6]; rw [e', pow_succ]; split_ifs <;> omega
  have hdl : d * ℓ ≤ L + d - 1 := by
    have := Nat.div_mul_le_self (L + d - 1) d
    simp only [hℓdef, ℓP6]; rw [mul_comm]; exact this
  have hel : (e + 1) * ℓ ≤ L + e := by
    have h1 : (e + 1) * (ℓ - 1) ≤ d * (ℓ - 1) := Nat.mul_le_mul_right _ hd
    have h2 : d * (ℓ - 1) = d * ℓ - d := by rw [Nat.mul_sub_one]
    have h3 : (e + 1) * (ℓ - 1) = (e + 1) * ℓ - (e + 1) := by rw [Nat.mul_sub_one]
    have h4 : e + 1 ≤ (e + 1) * ℓ := Nat.le_mul_of_pos_right _ (by omega)
    have h5 : d ≤ d * ℓ := Nat.le_mul_of_pos_right _ (by omega)
    omega
  have hte : t ^ (e + 1) ≤ 2 ^ e * T := by
    calc t ^ (e + 1) ≤ (2 ^ ℓ) ^ (e + 1) := Nat.pow_le_pow_left htl _
      _ = 2 ^ ((e + 1) * ℓ) := by rw [← pow_mul, mul_comm]
      _ ≤ 2 ^ (L + e) := Nat.pow_le_pow_right (by norm_num) hel
      _ = 2 ^ e * T := by rw [hTdef, TP6, pow_add]; ring
  -- `X^{e+1} 2^{e²} ≤ T`
  set X := K * b ^ (e + 1) * p ^ e with hX
  have hn4' : 4 * n ≤ T * b' := by
    have := Nat.find_spec (LP6_exists P n)
    simp only [hTdef, TP6, LP6]; exact this
  have hbn : 2 ^ (b + 1) < 4 * n := by
    have := two_pow_b_lt hn5
    have e2 : 2 ^ (b + 1) = 4 * 2 ^ (b - 1) := by
      rw [show b + 1 = (b - 1) + 2 by omega, pow_add]; ring
    have h' : 2 ^ (b - 1) < n := this
    rw [e2]; omega
  have hXe : X ^ (e + 1) * 2 ^ (e * e) * b' = C0 * b ^ N := by
    rw [hX, hC0, hN, hpe, hb'e]
    ring
  have hpoly : C0 * b ^ N ≤ 2 ^ (b + 1) := by
    have h1 := hB b hbB0
    have h2 : C0 * b ^ N ≤ b * b ^ N := Nat.mul_le_mul_right _ hbC
    have h3 : b * b ^ N = b ^ (N + 1) := by ring
    have h4 : 2 ^ (b / 2) ≤ 2 ^ (b + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  have hXT : X ^ (e + 1) * 2 ^ (e * e) ≤ T := by
    have : X ^ (e + 1) * 2 ^ (e * e) * b' ≤ T * b' := by rw [hXe]; omega
    exact Nat.le_of_mul_le_mul_right this (by omega)
  have hXtT : X * t ^ e ≤ T := by
    apply root_le (e := e)
    calc (X * t ^ e) ^ (e + 1) = X ^ (e + 1) * (t ^ (e + 1)) ^ e := by
          rw [mul_pow, ← pow_mul, ← pow_mul, mul_comm e (e + 1)]
      _ ≤ X ^ (e + 1) * (2 ^ e * T) ^ e := Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hte _)
      _ = (X ^ (e + 1) * 2 ^ (e * e)) * T ^ e := by rw [mul_pow, ← pow_mul]; ring
      _ ≤ T * T ^ e := Nat.mul_le_mul_right _ hXT
      _ = T ^ (e + 1) := by ring
  have hcore : K * b ^ e * t ^ e * p ^ e * d ≤ T * p := by
    have hdb : d ≤ b := d_le_b P hP n
    calc K * b ^ e * t ^ e * p ^ e * d ≤ K * b ^ e * t ^ e * p ^ e * b := Nat.mul_le_mul_left _ hdb
      _ = X * t ^ e := by rw [hX]; ring
      _ ≤ T := hXtT
      _ ≤ T * p := Nat.le_mul_of_pos_right _ (by omega)
  -- to ℝ
  have hdR : ((D : ℝ) + 1) = (d : ℝ) := by exact_mod_cast hD.symm
  have hd0 : (0 : ℝ) < d := by exact_mod_cast (show 0 < d by omega)
  have hU : (T : ℝ) * p ≤ cU6 P n A' := by
    unfold cU6 VP6
    have h2 := Ncost6_ge_one P hP n
    have h3 : (1 : ℝ) ≤ (Real.log (IntMul.lg n) + 1) ^ A' := one_le_pow₀ (lgn_ge n)
    calc (T : ℝ) * p = (TP6 P n : ℝ) * (pP6 P n : ℝ) * 1 * 1 := by ring
      _ ≤ (TP6 P n : ℝ) * (pP6 P n : ℝ) * Ncost6 P n * (Real.log (IntMul.lg n) + 1) ^ A' := by
        gcongr
  rw [hdR, le_div_iff₀ hd0]
  push_cast
  have : ((K * b ^ e * t ^ e * p ^ e * d : ℕ) : ℝ) ≤ ((T * p : ℕ) : ℝ) := by exact_mod_cast hcore
  push_cast at this
  linarith

end J6Seg.PJ
end

end

