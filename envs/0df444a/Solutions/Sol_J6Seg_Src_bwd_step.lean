-- Source module: Solutions.J6SegILSrc2
/-!
# B-line IL, source-table producers, part 2: the block structure, recursively

For the streaming computation of `mkBlocks s t λ w` and `LJ = Jlist (mkBlocks …)`:

* `rrZ s t x = (2 t x + s) / (2 s)`; `stepOK_iff`: `stepOK l ↔ rrZ (l+1) = rrZ l + 1` (`s > 0`);
  `cut_iff`: for `j ≥ 1`, `cutP j ↔ j % λ = 0 ∨ rrZ j ≠ rrZ (j-1) + 1`.
* `stF_zero`, `stF_succ` (the forward recursion), `stF_eq_iff` (`stF j = j ↔ cutP j`).
* `eB j = stF j + len j` (the end of the block of `j`): `eB_last` (`= s` at `s - 1`),
  `eB_step` (`eB j = if cutP (j+1) then j+1 else eB (j+1)`), the backward recursion.
* `nearB_eq`: `nearB (mkBlocks …) j ↔ j < stF j + w ∨ eB j < j + w + 1`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.Src

open J6Seg

variable {s t lam : ℕ}

theorem stF_succ (j : ℕ) :
    stF s t lam (j + 1) = if cutP s t lam (j + 1) then j + 1 else stF s t lam j := by
  unfold stF; rw [Nat.findGreatest_succ]

theorem stF_eq_iff (j : ℕ) : stF s t lam j = j ↔ cutP s t lam j := by
  constructor
  · intro h; have := stF_cut (s := s) (t := t) (lam := lam) j; rwa [h] at this
  · intro h; unfold stF; exact Nat.findGreatest_eq h

theorem no_cut {i j : ℕ} (h1 : stF s t lam i < j) (h2 : j ≤ i) : ¬ cutP s t lam j :=
  Nat.findGreatest_is_greatest h1 h2

theorem enF_eq {c k : ℕ} (hk : cutP s t lam (c + 1 + k) ∨ s ≤ c + 1 + k)
    (hmin : ∀ k' < k, ¬ cutP s t lam (c + 1 + k') ∧ c + 1 + k' < s) : enF s t lam c = k := by
  unfold enF
  rw [Nat.find_eq_iff]
  refine ⟨hk, fun n hn => ?_⟩
  have := hmin n hn
  push Not
  exact ⟨this.1, this.2⟩

theorem eB_step {j : ℕ} (hj : j + 1 < s) :
    eB s t lam j = if cutP s t lam (j + 1) then j + 1 else eB s t lam (j + 1) := by
  split_ifs with h
  · unfold eB
    have hc := stF_le (s := s) (t := t) (lam := lam) j
    rw [enF_eq (k := j - stF s t lam j) (Or.inl (by rwa [show stF s t lam j + 1 +
      (j - stF s t lam j) = j + 1 by omega])) (fun k' hk' => ⟨no_cut (i := j) (by omega)
      (by omega), by omega⟩)]
    omega
  · unfold eB; rw [stF_succ, if_neg h]

theorem eB_le {j : ℕ} (hj : j < s) : eB s t lam j ≤ s := by
  unfold eB
  have := en_le_s (s := s) (t := t) (lam := lam) (show stF s t lam j < s from
    lt_of_le_of_lt (stF_le j) hj)
  omega

theorem lt_eB (hs : 0 < s) {j : ℕ} (hj : j < s) : j < eB s t lam j := by
  have h2 := en_ge (s := s) (t := t) (lam := lam) (stF_le j) hj (fun m h1 h2 => no_cut h1 h2)
  unfold eB; omega

theorem nearB_eq (w j : ℕ) :
    nearB (mkBlocks s t lam w) j = decide (j < stF s t lam j + w ∨ eB s t lam j < j + w + 1) := by
  unfold nearB mkBlocks eB
  simp only

end J6Seg.Src

