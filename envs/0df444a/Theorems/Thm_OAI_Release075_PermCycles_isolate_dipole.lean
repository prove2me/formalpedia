-- title:
--   Isolating a cancelling dipole by two re-pairings
-- statement:
--   For permutations $r,f$ of a finite set $A$, let $\mathrm{cyc}$ count cycles (fixed points included) and $\mathrm{comp}(r,f)$ count the classes of the equivalence relation generated by both. The pair is a planar map if
--   $$
--   \mathrm{cyc}(r)+\mathrm{cyc}(f)+\mathrm{cyc}(rf)=|A|+2\,\mathrm{comp}(r,f),
--   $$
--   i.e. equality holds in the Euler bound. Let $r$ be a fixed-point-free involution and $(r,f)$ planar with a colouring constant along $rf$. Let $e$ embed the six dipole darts so that $f$ acts on them as $(0\,1\,2)(3\,4\,5)$, $r(e_0)=e_3$, and the colours satisfy $c(e_1)\ne c(e_0)$, $c(e_2)\ne c(e_1)$, $c(e_1)=c(e_4)$. Then
--   $$
--   r'=\mathrm{rePair}\bigl(\mathrm{rePair}(r,e_1,e_5),\ e_2,\ e_4\bigr)
--   $$
--   is a fixed-point-free involution with $(r',f)$ planar and colours still constant along $r'f$. On the six darts it acts as $(0\,3)(1\,5)(2\,4)$, and its components refine those of $(r,f)$.
--
--   Arbitrary reconnections of the outside partners are allowed, and face orbits away from the dipole, including the exterior, are unchanged.
-- source:
--   https://github.com/openai/math/blob/1581d4cbdd69a0faf34b2089614fe2a814316a6a/lean/OAI/GroupTheory/Hyperbolic/RePairing.lean#L184-L277

import Mathlib
import Definitions.Def_TorsionFreeHyperbolic
import Definitions.Def_OAI_GroupTheory_Hyperbolic_MatrixRank
import Definitions.Def_OAI_GroupTheory_Hyperbolic_Incidence
import Definitions.Def_OAI_GroupTheory_Hyperbolic_Presentation
import Definitions.Def_OAI_GroupTheory_Hyperbolic_WordPaths
import Definitions.Def_OAI_GroupTheory_Hyperbolic_PermutationCycles
import Definitions.Def_OAI_GroupTheory_Hyperbolic_Planarity
import Definitions.Def_OAI_GroupTheory_Hyperbolic_RePairing

open OAI OAI.Release075 OAI.Release075.PermCycles
open Equiv
attribute [local instance] Classical.propDecidable Classical.decEq
variable {A : Type*} [Fintype A]

theorem OAI.Release075.PermCycles.isolate_dipole {C : Type*} (r f : Perm A)
    (hi : Function.Involutive r) (hn : ∀ z, r z ≠ z)
    (color : A → C) (hc : ∀ z, color ((r*f) z) = color z)
    (e : Fin 6 ↪ A) (hf : ∀ j, f (e j) = e (dipoleFace j))
    (he : r (e 0) = e 3)
    (h10 : color (e 1) ≠ color (e 0)) (h21 : color (e 2) ≠ color (e 1))
    (h14 : color (e 1) = color (e 4)) (hp : PlanarMap r f) :
    ∃ r' : Perm A, Function.Involutive r' ∧ (∀ z, r' z ≠ z) ∧
      PlanarMap r' f ∧ (∀ z, color ((r'*f) z) = color z) ∧
      (∀ j, r' (e j) = e (dipoleReverse j)) ∧
      r' = rePair (rePair r (e 1) (e 5)) (e 2) (e 4) ∧
      components r' f ≤ components r f := by sorry
