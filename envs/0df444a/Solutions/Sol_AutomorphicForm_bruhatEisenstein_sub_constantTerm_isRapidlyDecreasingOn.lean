section RebaseC

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsComplex)

private theorem lineFamily_add {E : ℝ → ℝ → AdeleRing (𝓞 F) F}
    (hEw : ∀ θ t : ℝ, (E θ t).1 w
      = (ringEquivComplexOfIsComplex hw).symm ((t : ℂ) * Complex.exp (θ * Complex.I)))
    (hEv : ∀ (θ t : ℝ) (v : InfinitePlace F), v ≠ w → (E θ t).1 v = 0)
    (hE2 : ∀ θ t : ℝ, (E θ t).2 = 0) (θ s t : ℝ) :
    E θ (s + t) = E θ s + E θ t := by
  refine Prod.ext (funext fun v => ?_) ?_
  · rcases eq_or_ne v w with rfl | hvw
    · show (E θ (s + t)).1 v = (E θ s).1 v + (E θ t).1 v
      rw [hEw θ (s + t), hEw θ s, hEw θ t, ← map_add]
      congr 1
      push_cast
      ring
    · show (E θ (s + t)).1 v = (E θ s).1 v + (E θ t).1 v
      rw [hEv θ (s + t) v hvw, hEv θ s v hvw, hEv θ t v hvw, add_zero]
  · show (E θ (s + t)).2 = (E θ s).2 + (E θ t).2
    rw [hE2 θ (s + t), hE2 θ s, hE2 θ t, add_zero]

private theorem iteratedDeriv_slice_rebase {φ : AdelicGL2 (𝓞 F) F → ℂ}
    {E : ℝ → ℝ → AdeleRing (𝓞 F) F}
    (hEw : ∀ θ t : ℝ, (E θ t).1 w
      = (ringEquivComplexOfIsComplex hw).symm ((t : ℂ) * Complex.exp (θ * Complex.I)))
    (hEv : ∀ (θ t : ℝ) (v : InfinitePlace F), v ≠ w → (E θ t).1 v = 0)
    (hE2 : ∀ θ t : ℝ, (E θ t).2 = 0)
    (x : AdelicGL2 (𝓞 F) F) (a : AdeleRing (𝓞 F) F) (θ : ℝ) (n : ℕ) (t₀ : ℝ) :
    iteratedDeriv n
        (fun t => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E θ t) * x)) t₀
      = iteratedDeriv n
          (fun h => φ (adelicWeyl (𝓞 F) F * unipotentGL2 ((a + E θ t₀) + E θ h) * x)) 0 := by
  have hfun : (fun h => φ (adelicWeyl (𝓞 F) F * unipotentGL2 ((a + E θ t₀) + E θ h) * x))
      = fun h => (fun t => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E θ t) * x)) (t₀ + h) := by
    funext h
    show φ (adelicWeyl (𝓞 F) F * unipotentGL2 ((a + E θ t₀) + E θ h) * x)
      = φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E θ (t₀ + h)) * x)
    rw [lineFamily_add hw hEw hEv hE2 θ t₀ h, ← add_assoc]
  calc iteratedDeriv n (fun t => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E θ t) * x)) t₀
      = iteratedDeriv n (fun t => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E θ t) * x))
          (t₀ + 0) := by rw [add_zero]
    _ = iteratedDeriv n (fun h =>
          (fun t => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E θ t) * x)) (t₀ + h)) 0 :=
        (congrFun (iteratedDeriv_comp_const_add n _ t₀) 0).symm
    _ = iteratedDeriv n
          (fun h => φ (adelicWeyl (𝓞 F) F * unipotentGL2 ((a + E θ t₀) + E θ h) * x)) 0 := by
        rw [hfun]

end RebaseC
