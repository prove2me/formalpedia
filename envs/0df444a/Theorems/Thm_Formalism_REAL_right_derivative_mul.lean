variable {n : ℕ} {ε : Fin n → Bool}

theorem Formalism.REAL.right_derivative_mul {f h : Matrix (Fin n) (Fin n) ℂ → ℂ} {g X : Matrix (Fin n) (Fin n) ℂ}
    (hf : SmoothOnG ε f) (hh : SmoothOnG ε h) (hX : inG ε X) (hg : inUJ ε g) :
    Rd X (fun x => f x * h x) g = Rd X f g * h g + f g * Rd X h g := by sorry
