  have hgξ : g.base ξ' = (ModularCurve.TwoChart.ιFin A (↥K) j).base y := by
    rw [hy]
    show (e₁.inv ≫ e₁.hom ≫ i₁.1 ≫ pullback.fst (ModularCurve.TwoChart.modelTo A (↥K) j) (specMap A k)).base ξ = _
