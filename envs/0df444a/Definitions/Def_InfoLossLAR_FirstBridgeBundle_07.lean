    ⟨h6.toEvalsTo,hbound⟩
  change Nonempty (EvalsToInTime (TM2.step (_root_.Integration9_9.TM2StockThread.program machine ein eout))
    (initList (_root_.Integration9_9.TM2StockThread.threadedMachine machine ein eout) (OAI.MetricKMedian.Binary.quote word++context))
