section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open NLogN.KIL
open IntMul RS AModel
open AModelL12
variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)
theorem solution [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : AModel.Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (k : ℕ) (hk2 : 2 ≤ k) (hk20 : k ≤ 20) (hkQ : k < Q)
    (hQk : Nat.Coprime Q k) (t : NLogN.IState NLogN.HS) (xs : List ℤ) (Bb : ℕ) (R : List NLogN.Item)
    (hlen : xs.length = AModel.vol sh) (hb : NLogN.Bnd Bb xs) (hB1 : 1 ≤ AModel.vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ AModel.vol A) (hV : NLogN.zsz ((AModel.vol A * (Q * AModel.vol C) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : NLogN.zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = NLogN.ints xs ++ R) :
    NLogN.KIL.Sp (NLogN.KIL.shNMul Q k (AModel.vol A) (AModel.vol C) (A.zip (NLogN.KIL.csOf Λ c A))) t
      (t.upd 0 (NLogN.ints (AModel.shiftArr Λ i (-(k : ZMod Q)) c 0 xs) ++ R))
      (NLogN.KIL.cShiftU A.length (AModel.vol A * (Q * AModel.vol C)) Bb) := by
  have M := NLogN.KIL.mul_stage A C hsh k hk2 hk20 hkQ hQk t xs Bb R hlen hb hB1 hQ1 hP1 hV hQ2 h0
  set mid := AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (NLogN.KIL.mulAddr Q k) 0 xs
  have hv : AModel.vol sh = AModel.vol [AModel.vol A, Q, AModel.vol C] := by
    rw [hsh, AModel.vol_append, AModel.vol_cons]; simp [AModel.vol]
  have S := NLogN.KIL.shiftArrNeg_il_spec Λ i c hc A C hsh hA (t.upd 0 (NLogN.ints mid ++ R)) mid Bb R
    (by rw [AModel.length_pull, hv]) (NLogN.KIL.bnd_pull hb) hB1 hQ1 hP1 hV hQ2 (by simp)
  rw [← NLogN.KIL.shiftArr_negmul_eq Λ i c hc A C hsh hA k (by omega) hQk] at S
  have S' : NLogN.KIL.Sp (NLogN.KIL.shN Q (AModel.vol A) (AModel.vol C) (A.zip (NLogN.KIL.csOf Λ c A))) (t.upd 0 (NLogN.ints mid ++ R)) _ _ :=
    ⟨S.1, S.2.1, S.2.2⟩
  refine ((M.seq S').congr ?_).mono le_rfl
  apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;>
    (try split_ifs) <;> simp_all
end
