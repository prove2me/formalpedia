def varFreqBox (j : Fin 31) : RI := (RI.point (frequencyDistance j)).divNat 18
lemma varFreqBox_mem (j : Fin 31) : (varFreqBox j).Mem |frequency j| := by
  have hx := RI.mem_divNat (RI.mem_point (frequencyDistance j)) (by norm_num : 0<(18:ℕ))
