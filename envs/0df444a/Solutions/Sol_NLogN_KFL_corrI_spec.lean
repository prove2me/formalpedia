/-- **The correction**: `flR recs M ↦ flR (recs ∘ corrR) M`. -/
theorem corrRS_fsp {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {g : Geo} (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) (recs : ℕ → List ℤ) (hlen : ∀ m, (recs m).length = g.B)
    (hbits : ∀ m, Bnd 1 (recs m)) (s : IState HS) :
    FSp (corrRS K ρ f g (zsz (g.V : ℤ))) (encK s (Function.update (fun _ => []) 0 (flR recs g.recG.V)))
      (encK s (Function.update (fun _ => []) 0 (flR (fun d => recs (corrR K ρ f g d)) g.recG.V)))
      (cCorr K f g (zsz (g.V : ℤ)) (nMv (keyR K ρ f g) g.recG.V) (zsz (g.V : ℤ) + 3)) := by
  set κ := keyR K ρ f g
  set γ := corrR K ρ f g
  set M := g.recG.V
  set A := zsz (g.V : ℤ)
  set Bb := zsz (g.V : ℤ) + 3
  have hV : g.V < 2 ^ A := by
    have := natAbs_lt_zsz (g.V : ℤ); simpa using this
  have hbig : 4 * g.V < 2 ^ Bb := by
    have : 2 ^ Bb = 8 * 2 ^ A := by simp only [Bb, A]; rw [pow_add]; ring
    omega
  have hB2 : 2 ≤ Bb := by omega
  have hb4 : ((4 * g.V : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hbig
  have hW : ∀ n : ℕ, n ≤ 4 * g.V → zsz (n : ℤ) ≤ Bb := fun n hn => zsz_of_le hb4 (by
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast hn)
  have hMV : M ≤ g.V := recG_V_le g hg
  have hBV : g.B ≤ g.V := by
    have := hg.v; rw [Geo.V_rec g] at this ⊢
    exact Nat.le_mul_of_pos_left _ (Nat.pos_of_mul_pos_right this)
  have hMB : M * g.B = g.V := (Geo.V_rec g).symm
  have hVp := hg.v
  have hγκ : ∀ m, γ (κ m) = m := corrR_keyR hg hQe
  have hκγ : ∀ m, κ (γ m) = m := keyR_corrR hg hQe
  have hκ : ∀ m < M, κ m < M := fun m hm => keyR_lt hg hQe hm
  have hγ : ∀ m < M, γ m < M := fun m hm => corrR_lt hg hQe hm
  have hAW : A ≤ 4 * g.V := by
    have := zsz_le_of_lt (z := (g.V : ℤ)) (m := g.V) (by simpa using Nat.lt_two_pow_self)
    omega
  set Gn : Fin HS → List ℤ := fun _ => []
  -- pushes
  have S1 := Sp.push s (Function.update Gn 0 (flR recs M)) (i := NLogN.KFL.rm) (e := .lit 0) (B := Bb)
    (by decide) (clean_lit _) trivial trivial (by rw [Ex.Bnd, zsz_zero]; omega)
  simp only [Ex.eval] at S1
  have S2 := Sp.push s (Function.update (Function.update Gn 0 (flR recs M)) NLogN.KFL.rm
      ((0 : ℤ) :: Function.update Gn 0 (flR recs M) NLogN.KFL.rm)) (i := rNB) (e := .lit 0) (B := Bb)
    (by decide) (clean_lit _) trivial trivial (by rw [Ex.Bnd, zsz_zero]; omega)
  simp only [Ex.eval] at S2
  have e2 : Function.update (Function.update (Function.update Gn 0 (flR recs M)) NLogN.KFL.rm
      ((0 : ℤ) :: Function.update Gn 0 (flR recs M) NLogN.KFL.rm)) rNB ((0 : ℤ) :: Function.update
      (Function.update Gn 0 (flR recs M)) NLogN.KFL.rm ((0 : ℤ) :: Function.update Gn 0 (flR recs M) NLogN.KFL.rm) rNB) =
      NLogN.KFL.P1 κ recs M Gn 0 := by
    funext r
    simp only [NLogN.KFL.P1, Gn]
    by_cases a1 : r = rNB
    · subst a1; simp +decide [nMv]
    by_cases a2 : r = NLogN.KFL.rm
    · subst a2; simp +decide
    by_cases a3 : r = 0
    · subst a3; simp +decide [restR_zero]
    simp [Function.update_apply, a1, a2, a3, stkF, stkK, flL]
  rw [e2] at S2
  -- pass 1
  have SP1 := p1_fsp hK hρK hf hg hQe hB2 hbig recs hlen hbits s Gn rfl rfl
  have g3 : NLogN.KFL.P1 κ recs M Gn M NLogN.KFL.rm = (M : ℤ) :: [] := by simp +decide [NLogN.KFL.P1, Function.update_apply, Gn]
  have S3 := Sp.pop s (NLogN.KFL.P1 κ recs M Gn M) (B := Bb) (by decide) g3 (hW _ (by omega))
  set G3 := Function.update (NLogN.KFL.P1 κ recs M Gn M) NLogN.KFL.rm []
