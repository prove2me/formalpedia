-- title:
--   The push-up-then-push-down (PUPD) pricing algorithm: scalars t^s_j and price iterates p^s (Algorithm 1)
-- statement:
--   The **push-up-then-push-down (PUPD) algorithm** generates price vectors $\mathbf p^0,\mathbf p^1,\dots$ for the $d$-level nested logit model.
--
--   1. Step 0: $\mathbf p^0=\mathbf 0$.
--   2. Step 1: given $\mathbf p^s$, compute scalars $t^s_j$ at the nonleaf nodes top-down: $t^s_{\mathrm{root}}=R_{\mathrm{root}}(\mathbf p^s)$ and, writing $R^s_j=R_j(\mathbf p^s)$, for every other nonleaf node
--   $$
--   t^s_j=\max\big\{t^s_{\mathrm{Parent}(j)},\ \eta_jt^s_{\mathrm{Parent}(j)}+(1-\eta_j)R^s_j\big\}.
--   $$
--   3. Step 2: for each product $l$,
--   $$
--   p^{s+1}_l=\frac1{\beta_l}+t^s_{\mathrm{Parent}(l)} .
--   $$
--
--   Here $R_j$ is the expected revenue at node $j$. The scalars $t^s$ differ from the scalars $u_j(\mathbf p^s)$ of the stationarity condition by the maximum; this is what distinguishes PUPD from the plain fixed-point iteration $p^{s+1}_l=1/\beta_l+u_{\mathrm{Parent}(l)}(\mathbf p^s)$.
--
--   **Formalization Note** `pushDownScalar P q j` is $t_j$ computed at an arbitrary price vector $q$, so $t^s_j$ is `pushDownScalar P (pupd P s) j`; `pupd P s` is $\mathbf p^s$, starting from the zero vector.
-- source:
--   Li, Rusmevichientong, Topaloglu, The d-Level Nested Logit Model: Assortment and Price Optimization Problems, Oper. Res. 63(2), 2015, p. 336, §7.2, Algorithm 1

import Mathlib
import Definitions.Def_DLevelNestedLogit_Pricing_Revenue

namespace DLevelNestedLogit.Pricing

variable {n d : ℕ} {T : DLevelTree n d}

/-- The scalars `t_j` of Step 1 of Algorithm 1 (PUPD, p. 336) for the current price vector
`q`, computed top-down: `t_root = R_root(q)` and, for every other nonleaf node,
`t_j = max{t_{Parent(j)}, η_j t_{Parent(j)} + (1 − η_j) R_j(q)}`. -/
noncomputable def pushDownScalar (P : Params T) (q : Fin n → ℝ) (j : T.Inner) : ℝ :=
  if h : j = T.root then expectedRevenue P q
  else max (pushDownScalar P q (T.parent (Sum.inr j)))
    (P.η j * pushDownScalar P q (T.parent (Sum.inr j)) + (1 - P.η j) * revenue P q (Sum.inr j))
termination_by T.level j
decreasing_by all_goals (have := T.level_parent j h; omega)

/-- The price vectors `p^s` generated by the push-up-then-push-down algorithm (Algorithm 1,
p. 336): `p^0 = 0` (Step 0) and `p^{s+1}_l = 1/β_l + t^s_{Parent(l)}` (Step 2), where `t^s` are
the scalars of Step 1 computed at `p^s`. -/
noncomputable def pupd (P : Params T) : ℕ → Fin n → ℝ
  | 0 => 0
  | s + 1 => fun l => 1 / P.β l + pushDownScalar P (pupd P s) (T.parentOf l)

end DLevelNestedLogit.Pricing


