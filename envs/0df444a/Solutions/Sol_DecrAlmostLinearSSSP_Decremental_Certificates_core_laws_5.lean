lemma eval_code (s : Data) : Eval code s 19 (result s) := eval_sequence_atoms atoms s
lemma values (b : Core) (K : ℝ) (B : ℕ) (s : Data) (hc : InputCapture.Captured b.input s)
    (hB : s.natReg 74 = B) (hp : CoreParameters.Values b K s) :
    Layout b B (result s) ∧ (result s).natReg 546 = 0 ∧ (result s).natReg 550 = 0 ∧
      (result s).natReg 650 = 1 ∧ (result s).realReg 520 = -1/(4*K) := by
  constructor
  · constructor
    all_goals simp only [result,atoms,List.foldl_cons,List.foldl_nil]
    all_goals simp (disch := decide) [Atom.nat_read,primitiveNatRead]
    all_goals simp only [hc.unit,hc.edges,hc.vertices,hB,hp.edgeCount,CoreMemory.gradientBase,CoreMemory.sourceRecord]
    all_goals omega
  · simp only [result,atoms,List.foldl_cons,List.foldl_nil]
    simp (disch := decide) [Atom.real_read,Atom.nat_read,primitiveRealRead,primitiveNatRead,hp.quality]
lemma nat_frame (k : ℕ) (hk : k < 106 ∨ 112 < k) (h50 : k ≠ 50)
    (hbulk : k < 542 ∨ 650 < k) : NatFrame code k := by
  simp [code,atoms,Structured.sequence,NatFrame,writesNat]
  omega
lemma real_frame (k : ℕ) (h520 : k ≠ 520) (h656 : k ≠ 656) (h658 : k ≠ 658) : RealFrame code k := by
  simp [code,atoms,Structured.sequence,RealFrame,writesReal,Ne.symm h520,Ne.symm h656,Ne.symm h658]
