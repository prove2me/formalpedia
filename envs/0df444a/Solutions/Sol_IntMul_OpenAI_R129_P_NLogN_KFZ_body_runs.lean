    (hr : 2 ^ (h + 1) = IntMul.OpenAI.R129.rP n) (hK : K = KP n) (hl : h + 1 = ℓP n) (hb : p / 6 = bP n)
    (hp : p = pP n) (Bd : ℕ) (hBd : ∀ x ∈ desc18 (pP n) (ℓP n) (KP n) (tsN n), zsz x ≤ Bd)
    (w : ℕ) (N : ℕ) (xs bL aL tL iL zh : List GI) (l : List ℤ)
    (hxs : xs.length = N) (hbL : bL.length = N) (haL : aL.length = N) (htL : tL.length = N)
    (hiL : iL.length = N) (hzh : zh.length = N)
    (gx : NLogN.KFB.GB w xs) (gb : NLogN.KFB.GB w bL) (ga : NLogN.KFB.GB w aL) (gt : NLogN.KFB.GB w tL) (gi : NLogN.KFB.GB w iL) (gh : NLogN.KFB.GB w zh)
    (gU : NLogN.KFB.GB w (List.zipWith (gmulT p) xs aL))
    (gG : NLogN.KFB.GB w (List.zipWith (gmulT p) (List.zipWith (gmulT p) xs aL) tL))
    (gF : NLogN.KFB.GB w (List.zipWith (gmulT p) bL tL))
    (gV : NLogN.KFB.GB w (List.zipWith (gmulT p) zh iL))
    (F : Fin HS → List ℤ) (hR : Regs F p h d σ K) (LR LX LX2 L1 L2 : List ℤ)
    (h0 : F 0 = gflat xs ++ l) (hqB : F NLogN.KFZ.qB = gflat bL) (hqA : F qA = gflat aL)
    (hqT : F qT = gflat tL) (hqI : F qI = gflat iL)
    (hpR : F NLogN.KFM.pR = (2 ^ p : ℤ) :: LR) (hnX : F nX = (N : ℤ) :: LX)
    (hnX2 : F nX2 = ((2 * N : ℕ) : ℤ) :: LX2) (hN1 : F KFM.rN = 1 :: L1)
    (hN2 : F rN2 = ((2 * N : ℕ) : ℤ) :: L2) (hX : F (X18 d18) = []) (c18 : ℕ)
    (hcall : IRuns I (kTable ext) (.call j)
      (NLogN.KIL.encK (bgS s (preM F (List.zipWith (gmulT p) bL tL)
          (List.zipWith (gmulT p) (List.zipWith (gmulT p) xs aL) tL) l) d18 l)
        (NLogN.KFZ.fC d18 (gflat (List.zipWith (gmulT p) bL tL) ++
          gflat (List.zipWith (gmulT p) (List.zipWith (gmulT p) xs aL) tL) ++ [])
          (desc18 (pP n) (ℓP n) (KP n) (tsN n))))
      (NLogN.KIL.encK (bgS s (preM F (List.zipWith (gmulT p) bL tL)
          (List.zipWith (gmulT p) (List.zipWith (gmulT p) xs aL) tL) l) d18 l)
        (Function.update (NLogN.KFZ.fC d18 (gflat (List.zipWith (gmulT p) bL tL) ++
          gflat (List.zipWith (gmulT p) (List.zipWith (gmulT p) xs aL) tL) ++ [])
          (desc18 (pP n) (ℓP n) (KP n) (tsN n))) 0 (gflat zh ++ []))) c18) :
    IRuns I (kTable ext) (NLogN.KFZ.PP j d18) (NLogN.KIL.encK s F)
      (NLogN.KIL.encK s (Function.update (Function.update (Function.update (Function.update
        (Function.update F 0 (gflat (List.zipWith (gmulT p)
          (List.zipWith (gmulT p) zh iL) aL) ++ l)) NLogN.KFZ.qB []) qA []) qT []) qI []))
      (cCmul w p N + (cCmul w p N + (cRepl 1 (2 * N) w + (cCmul w p N +
        ((c18 + cM B Bd (bP n) (desc18 (pP n) (ℓP n) (KP n) (tsN n)).length) +
        (cCmul w p N + (cCmul w p N + 4 * cMvX (2 * N) w))))))) := by
  set U := List.zipWith (gmulT p) xs aL with hU
  set G := List.zipWith (gmulT p) U tL with hG
  set Fl := List.zipWith (gmulT p) bL tL with hFl
  set V := List.zipWith (gmulT p) zh iL with hV
  set ys := List.zipWith (gmulT p) V aL with hys
  have lU : U.length = N := by rw [hU, List.length_zipWith, hxs, haL, min_self]
  have lG : G.length = N := by rw [hG, List.length_zipWith, lU, htL, min_self]
  have lF : Fl.length = N := by rw [hFl, List.length_zipWith, hbL, htL, min_self]
  have lV : V.length = N := by rw [hV, List.length_zipWith, hzh, hiL, min_self]
  have hN : ((N : ℕ) : ℤ) = (N : ℤ) := rfl
  -- 1. U = Q(x ã)
  have k1 := Cmul_runs ext (I := I) s qA (by decide) (by decide) (by decide)
    ⟨by decide, by decide, by decide⟩ (by decide) (by decide) w p xs aL (by rw [haL, hxs]) gx ga F
    l [] LR LX LX2 L1 L2 h0 (by rw [hqA, List.append_nil]) hpR (by rw [hnX, hxs])
    (by rw [hnX2, hxs]) hN1 (by rw [hN2, hxs])
  rw [hxs, ← hU] at k1
  set F1 := Function.update F 0 (gflat U ++ l) with hF1
  have u1 : ∀ i, i ≠ 0 → F1 i = F i := fun i hi => Function.update_of_ne hi _ _
  -- 2. G = Q(U θ̃)
  have k2 := Cmul_runs ext (I := I) s qT (by decide) (by decide) (by decide)
    ⟨by decide, by decide, by decide⟩ (by decide) (by decide) w p U tL (by rw [htL, lU]) gU gt F1
    l [] LR LX LX2 L1 L2 (by rw [hF1, Function.update_self])
    (by rw [u1 _ (by decide), hqT, List.append_nil]) (by rw [u1 _ (by decide), hpR])
    (by rw [u1 _ (by decide), hnX, lU]) (by rw [u1 _ (by decide), hnX2, lU])
    (by rw [u1 _ (by decide), hN1]) (by rw [u1 _ (by decide), hN2, lU])
  rw [lU, ← hG, hF1, Function.update_idem] at k2
  set F2 := Function.update F 0 (gflat G ++ l) with hF2
  have u2 : ∀ i, i ≠ 0 → F2 i = F i := fun i hi => Function.update_of_ne hi _ _
  -- 3. copy b̃ onto stack 0
  have k3 := replW (I := I) (iprog := kTable ext) NLogN.KFZ.qB 0 (by decide) (by decide) (by decide)
    (by decide) (by decide) ⟨by decide, by decide, by decide⟩ ⟨by decide, by decide, by decide⟩
    (by decide) (by decide) (by decide) bL w gb 1 s F2 [] L1 L2
    (by rw [u2 _ (by decide), hqB, List.append_nil]) (by rw [u2 _ (by decide), hN1]; rfl)
    (by rw [u2 _ (by decide), hN2, hbL])
  rw [List.replicate_one, List.flatten_singleton, hbL, hF2, Function.update_idem,
    Function.update_self, ← List.append_assoc] at k3
  set F3 := Function.update F 0 (gflat bL ++ gflat G ++ l) with hF3
  have u3 : ∀ i, i ≠ 0 → F3 i = F i := fun i hi => Function.update_of_ne hi _ _
  -- 4. F = Q(b̃ θ̃)
  have k4 := Cmul_runs ext (I := I) s qT (by decide) (by decide) (by decide)
    ⟨by decide, by decide, by decide⟩ (by decide) (by decide) w p bL tL (by rw [htL, hbL]) gb gt F3
    (gflat G ++ l) [] LR LX LX2 L1 L2 (by rw [hF3, Function.update_self, List.append_assoc])
    (by rw [u3 _ (by decide), hqT, List.append_nil]) (by rw [u3 _ (by decide), hpR])
    (by rw [u3 _ (by decide), hnX, hbL]) (by rw [u3 _ (by decide), hnX2, hbL])
    (by rw [u3 _ (by decide), hN1]) (by rw [u3 _ (by decide), hN2, hbL])
  rw [hbL, ← hFl, hF3, Function.update_idem, ← List.append_assoc] at k4
  -- 5. the Prop 18 call
  have hRM : Regs (preM F Fl G l) p h d σ K := hR.upd 0 (by decide) _
  have k5 := M_runs (I := I) (iprog := kTable ext) j d18 hd0 hn hB hd hdp hr hK hl hb hp Bd hBd s
    (preM F Fl G l) hRM Fl G l (by rw [preM, Function.update_self])
    (by rw [preM, Function.update_of_ne (by
      rcases X18_mem d18 with e | e <;> rw [e] <;> decide), hX]) zh c18 hcall
  rw [preM, Function.update_idem] at k5
  set F5 := Function.update F 0 (gflat zh ++ l) with hF5
  have u5 : ∀ i, i ≠ 0 → F5 i = F i := fun i hi => Function.update_of_ne hi _ _
  -- 6. V = Q(H θ̃⁻)
  have k6 := Cmul_runs ext (I := I) s qI (by decide) (by decide) (by decide)
    ⟨by decide, by decide, by decide⟩ (by decide) (by decide) w p zh iL (by rw [hiL, hzh]) gh gi F5
    l [] LR LX LX2 L1 L2 (by rw [hF5, Function.update_self])
    (by rw [u5 _ (by decide), hqI, List.append_nil]) (by rw [u5 _ (by decide), hpR])
    (by rw [u5 _ (by decide), hnX, hzh]) (by rw [u5 _ (by decide), hnX2, hzh])
    (by rw [u5 _ (by decide), hN1]) (by rw [u5 _ (by decide), hN2, hzh])
  rw [hzh, ← hV, hF5, Function.update_idem] at k6
  set F6 := Function.update F 0 (gflat V ++ l) with hF6
  have u6 : ∀ i, i ≠ 0 → F6 i = F i := fun i hi => Function.update_of_ne hi _ _
  -- 7. y = Q(V ã)
  have k7 := Cmul_runs ext (I := I) s qA (by decide) (by decide) (by decide)
    ⟨by decide, by decide, by decide⟩ (by decide) (by decide) w p V aL (by rw [haL, lV]) gV ga F6
    l [] LR LX LX2 L1 L2 (by rw [hF6, Function.update_self])
    (by rw [u6 _ (by decide), hqA, List.append_nil]) (by rw [u6 _ (by decide), hpR])
    (by rw [u6 _ (by decide), hnX, lV]) (by rw [u6 _ (by decide), hnX2, lV])
    (by rw [u6 _ (by decide), hN1]) (by rw [u6 _ (by decide), hN2, lV])
  rw [lV, ← hys, hF6, Function.update_idem] at k7
  set F7 := Function.update F 0 (gflat ys ++ l) with hF7
  have u7 : ∀ i, i ≠ 0 → F7 i = F i := fun i hi => Function.update_of_ne hi _ _
  -- 8. drop the tables
  have k8 := drop4_runs ext (I := I) s (n := N) w bL aL tL iL hbL haL htL hiL gb ga gt gi F7 LX2
    (by rw [u7 _ (by decide), hnX2]) (by rw [u7 _ (by decide), hqB])
    (by rw [u7 _ (by decide), hqA]) (by rw [u7 _ (by decide), hqT]) (by rw [u7 _ (by decide), hqI])
  exact k1.seq (k2.seq (k3.seq (k4.seq (k5.seq (k6.seq (k7.seq k8))))))

