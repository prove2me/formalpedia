variable {K : Type} [Field K] [NumberField K]

private theorem t0534 (w : InfinitePlace K) (z₁ z₂ : (AdeleRing (𝓞 K) K)ˣ) :
    d006 w (z₁ * z₂) = d006 w z₁ * d006 w z₂ := Units.ext rfl

private theorem t0535 {M : Type} [CommMonoid M] (f : (AdeleRing (𝓞 K) K)ˣ →* M)
    (z : (AdeleRing (𝓞 K) K)ˣ) :
    f (NumberField.Idele.partAt K ∅ z) = ∏ w : InfinitePlace K, f (archUnitHom w (d006 w z)) := by
  let P : (AdeleRing (𝓞 K) K)ˣ → Prop := fun z =>
    f (NumberField.Idele.partAt K ∅ z) = ∏ w : InfinitePlace K, f (archUnitHom w (d006 w z))
  refine t0057 ∅ P ?_ ?_ ?_ ?_ z
  · intro z₁ z₂ h₁ h₂
    show f (NumberField.Idele.partAt K ∅ (z₁ * z₂)) = _
    rw [map_mul (NumberField.Idele.partAt K ∅), map_mul f, h₁, h₂]
    simp only [t0534, map_mul, Finset.prod_mul_distrib]
  · intro w t
    show f (NumberField.Idele.partAt K ∅ (archUnitHom w t)) = _
    have hne : ∀ w' : InfinitePlace K, w' ≠ w → d006 w' (archUnitHom w t) = 1 := fun w' hw' =>
      Units.ext (by rw [t0053, t0082, Pi.mulSingle_eq_of_ne hw', Units.val_one])
    have hw : d006 w (archUnitHom w t) = t :=
      Units.ext (by rw [t0053, t0082, Pi.mulSingle_eq_same])
    rw [t0379 (S := ∅), Fintype.prod_eq_single w (fun w' hw' => by rw [hne w' hw', map_one, map_one]),
      hw]
  · intro v t
    show f (NumberField.Idele.partAt K ∅ (d004 v t)) = _
    rw [t0384 (S := ∅) (Finset.notMem_empty v), map_one]
    symm
    refine Finset.prod_eq_one fun w _ => ?_
    rw [show d006 w (d004 v t) = 1 from Units.ext (t0033 v t w), map_one, map_one]
  · intro u hu
    show f (NumberField.Idele.partAt K ∅ u) = _
    rw [t0383 (S := ∅) hu.arch (fun v hv => absurd hv (Finset.notMem_empty v)),
      map_one]
    symm
    refine Finset.prod_eq_one fun w _ => ?_
    rw [show d006 w u = 1 from Units.ext (hu.arch w), map_one, map_one]

private theorem t0536 (b : (AdeleRing (𝓞 K) K)ˣ) :
    ((NumberField.Idele.partAt K ∅ b : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 = 1 := by
  refine IsDedekindDomain.FiniteAdeleRing.ext K fun v => ?_
  rw [NumberField.Idele.partAt_snd_of_not_mem K ∅ b (Finset.notMem_empty v)]
  rfl

private theorem t0537 (η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (b : (AdeleRing (𝓞 K) K)ˣ) :
