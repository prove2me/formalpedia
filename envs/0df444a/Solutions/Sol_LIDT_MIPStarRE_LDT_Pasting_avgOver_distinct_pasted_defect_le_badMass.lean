@[expose] public section

open LIDT.MIPStarRE.LDT.Pasting

open MIPStarRE.LDT
open MIPStarRE.LDT.ExpansionHypercubeGraph
open MIPStarRE.LDT.CommutativityPoints
open scoped BigOperators MatrixOrder _root_.Matrix ComplexOrder

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem solution
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters) [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (strategy : _root_.LIDT.MIPStarRE.LDT.SymStrat params.next ι)
    (family : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily params ι)
    {k : ℕ} (u : _root_.LIDT.MIPStarRE.LDT.Point params) :
    _root_.LIDT.MIPStarRE.LDT.avgOver (_root_.LIDT.MIPStarRE.LDT.Pasting.distinctTupleDistribution params k) (fun xs =>
      _root_.LIDT.MIPStarRE.LDT.qBipartiteConsDefect strategy.state
        (_root_.LIDT.MIPStarRE.LDT.Pasting.hRestrictionToVerticalLine params (_root_.LIDT.MIPStarRE.LDT.Pasting.pastedInterpolationFamily params family k xs) u)
        (_root_.LIDT.MIPStarRE.LDT.Pasting.verticalLineMeasurementFamily params strategy u))
      ≤ _root_.LIDT.MIPStarRE.LDT.avgOver (_root_.LIDT.MIPStarRE.LDT.Pasting.distinctTupleDistribution params k) (fun xs =>
          _root_.LIDT.MIPStarRE.LDT.Pasting.hBConsistencyBadMass params strategy family u xs) := by
  classical
  let support : Finset (_root_.LIDT.MIPStarRE.LDT.PointTuple params k) :=
    _root_.LIDT.MIPStarRE.LDT.Pasting.distinctTupleSupport params k
  have hsupport : (_root_.LIDT.MIPStarRE.LDT.Pasting.distinctTupleDistribution params k).support = support := by
    simp [support]
  have hweight :
      ∀ xs, (_root_.LIDT.MIPStarRE.LDT.Pasting.distinctTupleDistribution params k).weight xs =
        if xs ∈ support then 1 / (support.card : _root_.LIDT.MIPStarRE.LDT.Error) else 0 := by
    intro xs
    simp [_root_.LIDT.MIPStarRE.LDT.Pasting.distinctTupleDistribution_weight, support]
  unfold _root_.LIDT.MIPStarRE.LDT.avgOver
  rw [hsupport]
  simp_rw [hweight]
  refine Finset.sum_le_sum ?_
  intro xs hxs
  have hinj : Function.Injective xs := by
    simpa [support] using hxs
  simp only [hxs, one_div, ite_true]
  exact mul_le_mul_of_nonneg_left
    (_root_.LIDT.MIPStarRE.LDT.Pasting.pastedInterpolation_verticalLine_defect_le_badMass params strategy family u xs hinj)
    (by positivity)
