private theorem _root_.AlgebraicCurve.RegularProlongation.isDiscCoord_semiSmul (hA : ∀ x : L, SemilinearAut.baseAut g x ∈ A ↔ x ∈ A)
    (hres : ∀ a : A, IsLocalRing.residue A ⟨SemilinearAut.baseAut g a, (hA a).mpr a.2⟩ = IsLocalRing.residue A a)
    {Q : Place (ResidueField A) Fbar} {D : Set (Place L F)} {z : F}
    (h : R.IsDiscCoord Q D z) :
    R.IsDiscCoord (R.semiResAut g hg hA hres • Q) (SemilinearAut.semiSmulDisc g D) (g • z) := by
  obtain ⟨hD, hz, hord, hbij, het, hup⟩ := h
  have hA' : ∀ x : L, (SemilinearAut.baseAut g).symm x ∈ A ↔ x ∈ A := fun x => by
    rw [← hA ((SemilinearAut.baseAut g).symm x), RingEquiv.apply_symm_apply]
  refine ⟨?_, (hg z).mpr hz, ?_, ?_, ?_, ?_⟩
  · intro P hP
    obtain ⟨hr, hm, hv⟩ := hD _ hP
    have hr' : P.IsRational := by
      have := (SemilinearAut.PlaceTransport.isRational_smul_iff g (g⁻¹ • P)).mpr hr
      rwa [smul_inv_smul] at this
    refine ⟨hr', ?_, ?_⟩
    · have := (SemilinearAut.PlaceTransport.mem_smul_iff' g (g⁻¹ • P) z).mpr hm
      rwa [smul_inv_smul] at this
    · have e := SemilinearAut.PlaceTransport.evalAt_smul g (g⁻¹ • P) hr z
      rw [smul_inv_smul] at e
      rw [e]
      exact SemilinearAut.valuation_map_lt_one A _ hA hv
  · rw [← hord, ← Place.ord_smul (R.semiResAut g hg hA hres) Q (R.residue ⟨z, hz⟩), semiResAut_residue]
  · intro c hc
    have hc' : A.valuation ((SemilinearAut.baseAut g).symm c) < 1 :=
      SemilinearAut.valuation_map_lt_one A _ hA' hc
    obtain ⟨P, ⟨hP, hPc⟩, huniq⟩ := hbij _ hc'
    refine ⟨g • P, ⟨(SemilinearAut.smul_mem_semiSmulDisc_iff g D P).mpr hP, ?_⟩, ?_⟩
    · rw [SemilinearAut.PlaceTransport.evalAt_smul g P (hD P hP).1, hPc, RingEquiv.apply_symm_apply]
    · rintro P' ⟨hP', hP'c⟩
      have hr := (hD _ hP').1
      have hval : (g⁻¹ • P').evalAt z = (SemilinearAut.baseAut g).symm c := by
        have e := SemilinearAut.PlaceTransport.evalAt_smul g (g⁻¹ • P') hr z
        rw [smul_inv_smul, hP'c] at e
        rw [e, RingEquiv.symm_apply_apply]
      have := huniq (g⁻¹ • P') ⟨hP', hval⟩
      rw [← this, smul_inv_smul]
  · intro P hP
    have hr := (hD _ hP).1
    have e := het _ hP
    have ev := SemilinearAut.PlaceTransport.evalAt_smul g (g⁻¹ • P) hr z
    rw [smul_inv_smul] at ev
    rw [← SemilinearAut.ord_smul g (g⁻¹ • P), smul_inv_smul, smul_sub, SemilinearAut.smul_algebraMap, ← ev] at e
    exact e
  · intro f hf hf0
    have hf' : ∀ P ∈ D, P.ord (g⁻¹ • f) = 0 := by
      intro P hP
      rw [← SemilinearAut.PlaceTransport.ord_smul' g P f]
      exact hf0 _ ((SemilinearAut.smul_mem_semiSmulDisc_iff g D P).mpr hP)
    obtain ⟨c, hc0, hc⟩ := hup (g⁻¹ • f) (by simpa using hf) hf'
    refine ⟨SemilinearAut.baseAut g c, by simpa using hc0, fun P hP => ?_⟩
    have hr := (hD _ hP).1
    have ev := SemilinearAut.PlaceTransport.evalAt_smul g (g⁻¹ • P) hr (g⁻¹ • f)
    rw [smul_inv_smul, smul_inv_smul] at ev
    rw [ev]
    exact SemilinearAut.valuation_map_eq_of_eq A _ hA (hc _ hP)

