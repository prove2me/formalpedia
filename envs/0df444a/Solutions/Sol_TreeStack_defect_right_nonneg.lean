theorem _root_.solution
    {a b δu δv : ℤ}
    (hδu : 0 ≤ δu) (hδv : 0 ≤ δv)
    (ha : a = F (-δu - b))
    (hb : b = F (-δv - a))
    (hb0 : 0 ≤ b) :
    a = -2 * (b + δu) - 3 ∧
      (δv = 2 * δu ∨
        (0 < b ∧ δv = 2 * δu + 3)) := by
  simpa using
    (defect_left_nonneg
      (a := b) (b := a) (δu := δv) (δv := δu)
      hδv hδu hb ha hb0)
end TreeStack
