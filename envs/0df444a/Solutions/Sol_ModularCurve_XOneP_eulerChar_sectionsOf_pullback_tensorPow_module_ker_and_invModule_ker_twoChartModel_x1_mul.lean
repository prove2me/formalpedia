theorem eulerChar_pullback_tensorPow_of_iso_foldr_module
    {k : Type u} [Field k] {C Z : Scheme.{u}} (c : C ⟶ Spec (CommRingCat.of k)) [IsProper c] [SmoothOfRelativeDimension 1 c]
    (𝒱 : C.TwoAffineOpenCover) (g : C ⟶ Z) {n : ℕ} (zp : Fin n → (Spec (CommRingCat.of k) ⟶ C)) (hz : ∀ i, zp i ≫ c = 𝟙 _)
    (Q : Z.Modules) (d : ℕ)
    (hQ : Nonempty ((Scheme.Modules.pullback (pullback.fst c (𝟙 _) ≫ g)).obj Q ≅
      (List.finRange n).foldr (fun i M => (RelEffCartierDiv.ofPoint c (zp i) (hz i)).I.module ⊗ M) (𝟙_ (pullback c (𝟙 (Spec (CommRingCat.of k)))).Modules))) :
    (Module.finrank k (𝒱.sectionsOf c ((Scheme.Modules.pullback g).obj (Q.tensorPow d))).H0 : ℤ) -
        Module.finrank k (𝒱.sectionsOf c ((Scheme.Modules.pullback g).obj (Q.tensorPow d))).H1 =
      (Module.finrank k (𝒱.sectionsOf c (SheafOfModules.unit C.ringCatSheaf : C.Modules)).H0 : ℤ) -
        Module.finrank k (𝒱.sectionsOf c (SheafOfModules.unit C.ringCatSheaf : C.Modules)).H1 - d * n := by
