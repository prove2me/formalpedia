    (ThreeSumApsp.Spec.starFirst e l).getD i 0
      = if l.getD i 0 = 9 ∧ (l.take i).count 9 < e then 10 else l.getD i 0 := by
  fun_induction ThreeSumApsp.Spec.starFirst e l generalizing i <;> cases i <;> simp_all

