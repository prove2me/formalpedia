        have k2 := key σ hσ (e.symm fun _ => u)
        simp only [LinearEquiv.apply_symm_apply] at k2
        exact congrFun k2 ⟨0, hn⟩
      have hM1 : (ρ σ).map ι = 1 := by
        apply Matrix.toLin'.injective
        refine LinearMap.ext fun u => ?_
        rw [Matrix.toLin'_apply, Matrix.toLin'_apply, Matrix.one_mulVec, hmul u]
      apply Matrix.map_injective ι.injective
      show (ρ σ).map ι = (1 : Matrix (Fin 2) (Fin 2) F).map ι
      rw [hM1, Matrix.map_one ι (map_zero ι) (map_one ι)]
    exact CerednikDrinfeld.TwoPlaceTorsionDatum.W_le_invariants_of_goodReductionOutside_of_span_eq_top hp2 𝒥
      h𝒥.goodReduction 𝔪 hp F ι ρ hatt hspan hfin hunr

