set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NC

def tors (A : Type*) [AddCommGroup A] (N : ℕ) : AddSubgroup A where
  carrier := {x | ((N : ℕ) : ℤ) • x = 0}
  zero_mem' := smul_zero _
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    rw [smul_add, ha, hb, add_zero]
  neg_mem' := by
    intro a ha
    simp only [Set.mem_setOf_eq] at ha ⊢
    rw [smul_neg, ha, neg_zero]

theorem mem_tors {A : Type*} [AddCommGroup A] {N : ℕ} {x : A} : x ∈ tors A N ↔ ((N : ℕ) : ℤ) • x = 0 :=
  Iff.rfl

theorem finite_of_natCard_eq_mul {α : Type*} {a b : ℕ} (h : Nat.card α = a * b) (ha : a ≠ 0) (hb : b ≠ 0) :
    Finite α :=
  Nat.finite_of_card_ne_zero (by rw [h]; exact mul_ne_zero ha hb)

theorem finite_and_natCard_tors_le_of_hom {A B : Type*} [AddCommGroup A] [AddCommGroup B] (f : A →+ B) (N : ℕ)
    [Finite (tors (↥f.ker) N)] [Finite (tors B N)] :
    Finite (tors A N) ∧ Nat.card (tors A N) ≤ Nat.card (tors (↥f.ker) N) * Nat.card (tors B N) := by

  let f' : tors A N →+ tors B N :=
    (f.comp (tors A N).subtype).codRestrict (tors B N) (by
      rintro ⟨a, ha⟩
      show ((N : ℕ) : ℤ) • f a = 0
      rw [← map_zsmul, mem_tors.mp ha, map_zero])
  have hf' : ∀ x : tors A N, ((f' x : tors B N) : B) = f (x : A) := fun x => rfl

  have hker : ∀ x : f'.ker, f ((x : tors A N) : A) = 0 := by
    intro x
    rw [← hf', (AddMonoidHom.mem_ker).mp x.2]
    rfl
  let ι : f'.ker → tors (↥f.ker) N := fun x =>
    ⟨⟨((x : tors A N) : A), (AddMonoidHom.mem_ker).mpr (hker x)⟩, Subtype.ext (mem_tors.mp (x : tors A N).2)⟩
  have hι : Function.Injective ι := by
    intro x y h
    have : ((x : tors A N) : A) = ((y : tors A N) : A) := congrArg (fun z : tors (↥f.ker) N => ((z : ↥f.ker) : A)) h
    exact Subtype.ext (Subtype.ext this)
  haveI hfk : Finite f'.ker := Finite.of_injective ι hι
  have h1 : Nat.card f'.ker ≤ Nat.card (tors (↥f.ker) N) := Nat.card_le_card_of_injective ι hι

  haveI hfq : Finite (tors A N ⧸ f'.ker) := Finite.of_equiv _ (QuotientAddGroup.quotientKerEquivRange f').toEquiv.symm
  have h2 : Nat.card (tors A N ⧸ f'.ker) ≤ Nat.card (tors B N) := by
    rw [Nat.card_congr (QuotientAddGroup.quotientKerEquivRange f').toEquiv]
    exact Nat.card_le_card_of_injective _ Subtype.coe_injective
  have hcard := (f'.ker).card_eq_card_quotient_mul_card_addSubgroup
  refine ⟨finite_of_natCard_eq_mul hcard Nat.card_pos.ne' Nat.card_pos.ne', ?_⟩
  rw [hcard, mul_comm]
  exact Nat.mul_le_mul h1 h2

def torsPiEquiv {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] (N : ℕ) :
    tors (∀ i, A i) N ≃ ∀ i, tors (A i) N where
  toFun x := fun i => ⟨(x : ∀ i, A i) i, by
    have := congrFun (mem_tors.mp x.2) i
    rwa [Pi.smul_apply] at this⟩
  invFun y := ⟨fun i => (y i : A i), by
    show ((N : ℕ) : ℤ) • (fun i => (y i : A i)) = 0
    funext i
    rw [Pi.smul_apply, Pi.zero_apply]
    exact mem_tors.mp (y i).2⟩
  left_inv x := rfl
  right_inv y := rfl

theorem natCard_tors_pi {ι : Type*} [Fintype ι] (A : ι → Type*) [∀ i, AddCommGroup (A i)] (N : ℕ) :
    Nat.card (tors (∀ i, A i) N) = ∏ i, Nat.card (tors (A i) N) := by
  rw [Nat.card_congr (torsPiEquiv A N), Nat.card_pi]

def mtors (A : Type*) [CommGroup A] (N : ℕ) : Subgroup A where
  carrier := {x | x ^ N = 1}
  one_mem' := one_pow _
  mul_mem' := by
    intro a b ha hb
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    rw [mul_pow, ha, hb, one_mul]
  inv_mem' := by
    intro a ha
    simp only [Set.mem_setOf_eq] at ha ⊢
    rw [inv_pow, ha, inv_one]

theorem mem_mtors {A : Type*} [CommGroup A] {N : ℕ} {x : A} : x ∈ mtors A N ↔ x ^ N = 1 := Iff.rfl

theorem natCard_mtors_eq_mul_of_divisible {A : Type*} [CommGroup A] (B : Subgroup A) (N : ℕ)
    (hdiv : ∀ b ∈ B, ∃ b' ∈ B, b' ^ N = b) :
    Nat.card (mtors A N) = Nat.card (mtors (A ⧸ B) N) * Nat.card (mtors (↥B) N) := by
  let π' : mtors A N →* mtors (A ⧸ B) N :=
    ((QuotientGroup.mk' B).comp (mtors A N).subtype).codRestrict (mtors (A ⧸ B) N) (by
      rintro ⟨a, ha⟩
      show (QuotientGroup.mk' B a) ^ N = 1
      rw [← map_pow, mem_mtors.mp ha, map_one])
  have hπ' : ∀ x : mtors A N, ((π' x : mtors (A ⧸ B) N) : A ⧸ B) = QuotientGroup.mk' B (x : A) := fun x => rfl

  have hsurj : Function.Surjective π' := by
    rintro ⟨q, hq⟩
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective B q
    have haN : a ^ N ∈ B := by
      have h1 : QuotientGroup.mk' B (a ^ N) = 1 := by rw [map_pow]; exact hq
      rwa [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h1
    obtain ⟨b', hb'B, hb'⟩ := hdiv _ haN
    refine ⟨⟨a * b'⁻¹, ?_⟩, ?_⟩
    · show (a * b'⁻¹) ^ N = 1
      rw [mul_pow, inv_pow, hb', mul_inv_cancel]
    · apply Subtype.ext
      rw [hπ']
      show QuotientGroup.mk' B (a * b'⁻¹) = QuotientGroup.mk' B a
      have hb1 : QuotientGroup.mk' B b' = 1 := by
        rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]; exact hb'B
      rw [map_mul, map_inv, hb1, inv_one, mul_one]

  let κ : π'.ker ≃ mtors (↥B) N :=
    { toFun := fun x => ⟨⟨((x : mtors A N) : A), by
          have hx : π' x = 1 := (MonoidHom.mem_ker).mp x.2
          have : QuotientGroup.mk' B ((x : mtors A N) : A) = 1 := by rw [← hπ', hx]; rfl
          rwa [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at this⟩,
        Subtype.ext (mem_mtors.mp (x : mtors A N).2)⟩
      invFun := fun y => ⟨⟨((y : ↥B) : A), by
          have := congrArg (fun z : ↥B => (z : A)) (mem_mtors.mp y.2)
          first | simpa using this | (have h_1 := this; simp at h_1; exact h_1) | (have h_1 := this; simp at h_1 ⊢; exact h_1) | exact (this)⟩,
        by
          rw [MonoidHom.mem_ker]
          apply Subtype.ext
          simp only [hπ', QuotientGroup.mk'_apply, OneMemClass.coe_one, QuotientGroup.eq_one_iff]
          exact (y : ↥B).2⟩
      left_inv := fun x => rfl
      right_inv := fun y => rfl }
  rw [(π'.ker).card_eq_card_quotient_mul_card_subgroup,
    Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective π' hsurj).toEquiv, Nat.card_congr κ]

def mtorsPiEquiv {ι : Type*} (A : Type*) [CommGroup A] (N : ℕ) :
    mtors (ι → A) N ≃ (ι → mtors A N) where
  toFun x := fun i => ⟨(x : ι → A) i, by
    have := congrFun (mem_mtors.mp x.2) i
    rwa [Pi.pow_apply] at this⟩
  invFun y := ⟨fun i => (y i : A), by
    show (fun i => (y i : A)) ^ N = 1
    funext i
    rw [Pi.pow_apply, Pi.one_apply]
    exact mem_mtors.mp (y i).2⟩
  left_inv x := rfl
  right_inv y := rfl

theorem natCard_mtors_pi {ι : Type*} [Fintype ι] (A : Type*) [CommGroup A] (N : ℕ) :
    Nat.card (mtors (ι → A) N) = Nat.card (mtors A N) ^ Fintype.card ι := by
  rw [Nat.card_congr (mtorsPiEquiv (ι := ι) A N), Nat.card_pi, Finset.prod_const, Finset.card_univ]

section Torus

variable (K : Type*) [Field K] [IsAlgClosed K]

theorem natCard_mtors_units (N : ℕ) (hN : 0 < N) (hNK : (N : K) ≠ 0) : Nat.card (mtors Kˣ N) = N := by
  haveI : NeZero (N : K) := ⟨hNK⟩
  haveI : NeZero N := ⟨hN.ne'⟩
  have h : mtors Kˣ N = rootsOfUnity N K := by
    ext x
    rw [mem_mtors, mem_rootsOfUnity]
  rw [h]
  exact HasEnoughRootsOfUnity.natCard_rootsOfUnity K N

variable {n m : ℕ} (src tgt : Fin m → Fin n)

def cobd : (Fin n → Kˣ) →* (Fin m → Kˣ) where
  toFun c := fun e => c (src e) * (c (tgt e))⁻¹
  map_one' := by funext e; simp
  map_mul' c c' := by funext e; simp only [Pi.mul_apply]; rw [mul_inv, mul_mul_mul_comm]

theorem cobd_apply (c : Fin n → Kˣ) (e : Fin m) : cobd K src tgt c e = c (src e) * (c (tgt e))⁻¹ := rfl

theorem cobd_eq_one_iff (c : Fin n → Kˣ) : cobd K src tgt c = 1 ↔ ∀ e, c (src e) = c (tgt e) := by
  constructor
  · intro h e
    have := congrFun h e
    rw [cobd_apply, Pi.one_apply, mul_inv_eq_one] at this
    exact this
  · intro h
    funext e
    rw [cobd_apply, Pi.one_apply, h e, mul_inv_cancel]

theorem cobd_range_divisible (N : ℕ) (hN : 0 < N) :
    ∀ b ∈ (cobd K src tgt).range, ∃ b' ∈ (cobd K src tgt).range, b' ^ N = b := by
  rintro b ⟨c, rfl⟩
  have hroot : ∀ i, ∃ z : Kˣ, z ^ N = c i := by
    intro i
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((c i : Kˣ) : K) hN
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow hN.ne'] at hz
      exact (c i).ne_zero hz.symm
    refine ⟨Units.mk0 z hz0, Units.ext ?_⟩
    rw [Units.val_pow_eq_pow_val, Units.val_mk0, hz]
  choose c' hc' using hroot
  refine ⟨cobd K src tgt c', ⟨c', rfl⟩, ?_⟩
  rw [← map_pow]
  congr 1
  funext i
  rw [Pi.pow_apply, hc' i]

def edgeConstEquiv (X : Type*) :
    {b : Fin n → X // ∀ e, b (src e) = b (tgt e)} ≃
      (Quot (fun i j : Fin n => ∃ e : Fin m, src e = i ∧ tgt e = j) → X) where
  toFun b := Quot.lift (b : Fin n → X) (by rintro i j ⟨e, rfl, rfl⟩; exact b.2 e)
  invFun f := ⟨fun i => f (Quot.mk _ i), fun e => congrArg f (Quot.sound ⟨e, rfl, rfl⟩)⟩
  left_inv b := by rfl
  right_inv f := by funext q; induction q using Quot.ind; rfl

theorem finite_and_natCard_mtors_quotient_cobd_mul_pow_le (N : ℕ) (hN : 0 < N) (hNK : (N : K) ≠ 0) :
    Finite (mtors ((Fin m → Kˣ) ⧸ (cobd K src tgt).range) N) ∧
      Nat.card (mtors ((Fin m → Kˣ) ⧸ (cobd K src tgt).range) N) * N ^ n ≤
        N ^ m * N ^ Nat.card (Quot (fun i j : Fin n => ∃ e : Fin m, src e = i ∧ tgt e = j)) := by
  classical
  set δ := cobd K src tgt with hδ
  have hμ : Nat.card (mtors Kˣ N) = N := natCard_mtors_units K N hN hNK
  haveI hμfin : Finite (mtors Kˣ N) := Nat.finite_of_card_ne_zero (by rw [hμ]; exact hN.ne')
  have hAm : Nat.card (mtors (Fin m → Kˣ) N) = N ^ m := by rw [natCard_mtors_pi, hμ, Fintype.card_fin]
  have hAn : Nat.card (mtors (Fin n → Kˣ) N) = N ^ n := by rw [natCard_mtors_pi, hμ, Fintype.card_fin]
  haveI hAmfin : Finite (mtors (Fin m → Kˣ) N) := Nat.finite_of_card_ne_zero (by rw [hAm]; exact pow_ne_zero _ hN.ne')
  haveI hAnfin : Finite (mtors (Fin n → Kˣ) N) := Nat.finite_of_card_ne_zero (by rw [hAn]; exact pow_ne_zero _ hN.ne')

  have hex := natCard_mtors_eq_mul_of_divisible δ.range N (cobd_range_divisible K src tgt N hN)
  rw [hAm] at hex

  have hHpos : Nat.card (mtors ((Fin m → Kˣ) ⧸ δ.range) N) ≠ 0 := fun h0 => by
    rw [h0, zero_mul] at hex; exact pow_ne_zero _ hN.ne' hex
  have hRpos : Nat.card (mtors (↥δ.range) N) ≠ 0 := fun h0 => by
    rw [h0, mul_zero] at hex; exact pow_ne_zero _ hN.ne' hex
  haveI hRfin : Finite (mtors (↥δ.range) N) := Nat.finite_of_card_ne_zero hRpos
  refine ⟨Nat.finite_of_card_ne_zero hHpos, ?_⟩

  let δ' : mtors (Fin n → Kˣ) N →* mtors (↥δ.range) N :=
    ((δ.rangeRestrict).comp (mtors (Fin n → Kˣ) N).subtype).codRestrict (mtors (↥δ.range) N) (by
      rintro ⟨c, hc⟩
      apply Subtype.ext
      show ((δ c) ^ N : Fin m → Kˣ) = 1
      rw [← map_pow, mem_mtors.mp hc, map_one])
  have hδ' : ∀ x : mtors (Fin n → Kˣ) N, (((δ' x : mtors (↥δ.range) N) : ↥δ.range) : Fin m → Kˣ) = δ (x : Fin n → Kˣ) :=
    fun x => rfl

  have hkerEquiv : δ'.ker ≃ (Quot (fun i j : Fin n => ∃ e : Fin m, src e = i ∧ tgt e = j) → mtors Kˣ N) := by
    refine (?_ : δ'.ker ≃ {b : Fin n → mtors Kˣ N // ∀ e, b (src e) = b (tgt e)}).trans
      (edgeConstEquiv src tgt (mtors Kˣ N))
    exact
      { toFun := fun x => ⟨fun i => ⟨((x : mtors (Fin n → Kˣ) N) : Fin n → Kˣ) i, by
            have := congrFun (mem_mtors.mp (x : mtors (Fin n → Kˣ) N).2) i
            rwa [Pi.pow_apply] at this⟩, by
            intro e
            apply Subtype.ext
            have hx : δ' x = 1 := (MonoidHom.mem_ker).mp x.2
            have h1 : δ ((x : mtors (Fin n → Kˣ) N) : Fin n → Kˣ) = 1 := by
              rw [← hδ', hx]; rfl
            exact (cobd_eq_one_iff K src tgt _).mp h1 e⟩
        invFun := fun b => ⟨⟨fun i => ((b.1 i : mtors Kˣ N) : Kˣ), by
            show (fun i => ((b.1 i : mtors Kˣ N) : Kˣ)) ^ N = 1
            funext i
            rw [Pi.pow_apply, Pi.one_apply]
            exact mem_mtors.mp (b.1 i).2⟩, by
            rw [MonoidHom.mem_ker]
            apply Subtype.ext; apply Subtype.ext
            rw [hδ']
            show δ (fun i => ((b.1 i : mtors Kˣ N) : Kˣ)) = 1
            exact (cobd_eq_one_iff K src tgt _).mpr (fun e => congrArg (fun z : mtors Kˣ N => (z : Kˣ)) (b.2 e))⟩
        left_inv := fun x => rfl
        right_inv := fun b => rfl }
  have hker : Nat.card δ'.ker = N ^ Nat.card (Quot (fun i j : Fin n => ∃ e : Fin m, src e = i ∧ tgt e = j)) := by
    rw [Nat.card_congr hkerEquiv, Nat.card_fun, hμ]

  have hiso : N ^ n = Nat.card δ'.range * Nat.card δ'.ker := by
    rw [← hAn, (δ'.ker).card_eq_card_quotient_mul_card_subgroup,
      Nat.card_congr (QuotientGroup.quotientKerEquivRange δ').toEquiv]
  have hrange : Nat.card δ'.range ≤ Nat.card (mtors (↥δ.range) N) :=
    Nat.card_le_card_of_injective _ Subtype.coe_injective

  calc Nat.card (mtors ((Fin m → Kˣ) ⧸ δ.range) N) * N ^ n
      = Nat.card (mtors ((Fin m → Kˣ) ⧸ δ.range) N) * Nat.card δ'.range *
          N ^ Nat.card (Quot (fun i j : Fin n => ∃ e : Fin m, src e = i ∧ tgt e = j)) := by
        rw [hiso, hker, mul_assoc]
    _ ≤ Nat.card (mtors ((Fin m → Kˣ) ⧸ δ.range) N) * Nat.card (mtors (↥δ.range) N) *
          N ^ Nat.card (Quot (fun i j : Fin n => ∃ e : Fin m, src e = i ∧ tgt e = j)) :=
        Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hrange)
    _ = N ^ m * N ^ Nat.card (Quot (fun i j : Fin n => ∃ e : Fin m, src e = i ∧ tgt e = j)) := by
        rw [← hex]

end Torus

end NC

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open AlgebraicCurve

namespace NC

theorem natCard_tors_pic0 (K F : Type*) [Field K] [Field F] [Algebra K F] [IsAlgClosed K]
    [IsCurveOver K F] [Algebra.EssFiniteType K F]
    (hκ : ∀ p : ℕ, p.Prime → CharP K p → ∀ a : K, ∃ n : ℕ, 0 < n ∧ a ^ (p ^ n) = a)
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : (ℓ : K) ≠ 0) (k : ℕ) :
    Nat.card (tors (Pic0 K F) (ℓ ^ k)) = ℓ ^ (2 * genusFF K F * k) := by
  have h : tors (Pic0 K F) (ℓ ^ k) = Pic0.torsion K F (ℓ ^ k) := by
    ext x
    rw [mem_tors, Pic0.mem_torsion]
  rw [h]
  obtain ⟨p, hp⟩ := CharP.exists K
  rcases CharP.char_is_prime_or_zero K p with hprime | h0
  · haveI : Fact p.Prime := ⟨hprime⟩
    exact AlgebraicCurve.Pic0.natCard_torsion_pow_eq_pow_two_mul_genusFF_mul_of_forall_pow_eq_self K F p
      (hκ p hprime hp) ℓ hℓ k
  · subst h0
    haveI : CharZero K := CharP.charP_to_charZero K
    exact AlgebraicCurve.Pic0.natCard_torsion_pow_eq_pow_two_mul_genusFF_mul_of_charZero K F ℓ k

section Values

variable {K : Type*} [Field K] [IsAlgClosed K] {F : Type*} [Field F] [Algebra K F] [IsCurveOver K F]

theorem algebraMap_residueField_surjective (v : Place K F) : Function.Surjective (algebraMap K v.ResidueField) := by
  haveI : Module.Finite K v.ResidueField := IsCurveOver.finiteResidue v
  haveI : Algebra.IsIntegral K v.ResidueField := Algebra.IsIntegral.of_finite K v.ResidueField
  exact (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := v.ResidueField)).2

theorem exists_hasValue_ne_zero (v : Place K F) {g : F} (hg : g ≠ 0) (h : v.ord g = 0) :
    ∃ a : K, a ≠ 0 ∧ v.HasValue g a := by
  obtain ⟨hm, hu⟩ := v.exists_isUnit_of_ord_eq_zero hg h
  obtain ⟨a, ha, hne⟩ := v.exists_hasValue_of_surjective (algebraMap_residueField_surjective v) hm
  exact ⟨a, hne hu, ha⟩

open Classical in

noncomputable def valU (v : Place K F) (g : F) : Kˣ :=
  if h : g ≠ 0 ∧ v.ord g = 0 then Units.mk0 (exists_hasValue_ne_zero v h.1 h.2).choose
    (exists_hasValue_ne_zero v h.1 h.2).choose_spec.1 else 1

theorem hasValue_valU (v : Place K F) {g : F} (hg : g ≠ 0) (h : v.ord g = 0) : v.HasValue g (valU v g : K) := by
  classical
  rw [valU, dif_pos ⟨hg, h⟩, Units.val_mk0]
  exact (exists_hasValue_ne_zero v hg h).choose_spec.2

theorem valU_eq_of_hasValue (v : Place K F) {g : F} (hg : g ≠ 0) (h : v.ord g = 0) {a : Kˣ}
    (ha : v.HasValue g (a : K)) : valU v g = a :=
  Units.ext ((hasValue_valU v hg h).unique ha)

theorem valU_mul (v : Place K F) {g g' : F} (hg : g ≠ 0) (hg' : g' ≠ 0) (h : v.ord g = 0) (h' : v.ord g' = 0) :
    valU v (g * g') = valU v g * valU v g' := by
  apply valU_eq_of_hasValue v (mul_ne_zero hg hg') (by rw [v.ord_mul hg hg', h, h', add_zero])
  rw [Units.val_mul]
  exact (hasValue_valU v hg h).mul (hasValue_valU v hg' h')

theorem valU_algebraMap_mul (v : Place K F) {g : F} (hg : g ≠ 0) (h : v.ord g = 0) (c : Kˣ) :
    valU v (algebraMap K F (c : K) * g) = c * valU v g := by
  have hc0 : algebraMap K F (c : K) ≠ 0 := (map_ne_zero _).mpr c.ne_zero
  have hcord : v.ord (algebraMap K F (c : K)) = 0 := (v.hasValue_algebraMap (c : K)).ord_eq_zero c.ne_zero
  rw [valU_mul v hc0 hg hcord h, valU_eq_of_hasValue v hc0 hcord (v.hasValue_algebraMap (c : K))]

theorem valU_pow (v : Place K F) {g : F} (hg : g ≠ 0) (h : v.ord g = 0) (N : ℕ) :
    valU v (g ^ N) = valU v g ^ N := by
  induction N with
  | zero => rw [pow_zero, pow_zero]; exact valU_eq_of_hasValue v one_ne_zero (by simp) (by simpa using v.hasValue_one)
  | succ N ih =>
    rw [pow_succ, pow_succ, valU_mul v (pow_ne_zero N hg) hg (by rw [← zpow_natCast, v.ord_zpow, h, mul_zero]) h, ih]

theorem exists_eq_algebraMap_mul_of_forall_ord_eq [Algebra.EssFiniteType K F] {g g' : F} (hg : g ≠ 0) (hg' : g' ≠ 0)
    (h : ∀ v : Place K F, v.ord g = v.ord g') : ∃ c : Kˣ, g' = algebraMap K F (c : K) * g := by
  obtain ⟨j, hj, hfd, -⟩ := AlgebraicCurve.IsCurveOver.exists_separating_transcendental (K := K) (F := F)
  haveI := hfd
  have hq : ∀ v : Place K F, v.ord (g' * g⁻¹) = 0 := fun v => by
    rw [v.ord_mul hg' (inv_ne_zero hg), v.ord_inv, h v, add_neg_cancel]
  obtain ⟨c, hc⟩ := AlgebraicCurve.Place.mem_range_algebraMap_of_forall_ord_eq_zero_of_isAlgClosed j hj hq
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [map_zero] at hc
    exact mul_ne_zero hg' (inv_ne_zero hg) hc.symm
  refine ⟨Units.mk0 c hc0, ?_⟩
  rw [Units.val_mk0, hc, inv_mul_cancel_right₀ hg]

end Values

end NC

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open AlgebraicCurve

namespace NC

section Nodal

variable {K : Type*} [Field K] [IsAlgClosed K] {n m : ℕ} {Fbar : Fin n → Type*} [∀ i, Field (Fbar i)]
  [∀ i, Algebra K (Fbar i)] [∀ i, IsCurveOver K (Fbar i)] [∀ i, Algebra.EssFiniteType K (Fbar i)]
  (src tgt : Fin m → Fin n) (xs : ∀ e, Place K (Fbar (src e))) (xt : ∀ e, Place K (Fbar (tgt e)))

def Pres (E : NodalData K Fbar) (g : ∀ i, Fbar i) : Prop :=
  (∀ i, g i ≠ 0) ∧ ∀ i (v : Place K (Fbar i)), E i v = v.ord (g i)

noncomputable def ratio (g : ∀ i, Fbar i) : Fin m → Kˣ :=
  fun e => valU (xs e) (g (src e)) * (valU (xt e) (g (tgt e)))⁻¹

variable {src tgt xs xt}

theorem Pres.mul {E E' : NodalData K Fbar} {g g' : ∀ i, Fbar i} (h : Pres E g) (h' : Pres E' g') :
    Pres (E + E') (g * g') :=
  ⟨fun i => mul_ne_zero (h.1 i) (h'.1 i), fun i v => by
    rw [Pi.add_apply, Finsupp.add_apply, h.2 i v, h'.2 i v, Pi.mul_apply, v.ord_mul (h.1 i) (h'.1 i)]⟩

theorem Pres.inv {E : NodalData K Fbar} {g : ∀ i, Fbar i} (h : Pres E g) : Pres (-E) (g⁻¹) :=
  ⟨fun i => inv_ne_zero (h.1 i), fun i v => by rw [Pi.neg_apply, Finsupp.neg_apply, h.2 i v, Pi.inv_apply, v.ord_inv]⟩

theorem Pres.zsmul {E : NodalData K Fbar} {g : ∀ i, Fbar i} (h : Pres E g) (N : ℕ) :
    Pres (((N : ℕ) : ℤ) • E) (g ^ N) :=
  ⟨fun i => pow_ne_zero N (h.1 i), fun i v => by
    rw [Pi.smul_apply, Finsupp.smul_apply, h.2 i v, Pi.pow_apply, smul_eq_mul, ← zpow_natCast, v.ord_zpow]⟩

theorem Pres.ord_src {E : NodalData K Fbar} {g : ∀ i, Fbar i} (h : Pres E g)
    (hE : E ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt) (e : Fin m) :
    (xs e).ord (g (src e)) = 0 := by
  rw [← h.2]; exact ((NodalData.mem_admissible src tgt xs xt).mp hE).2 e |>.1

theorem Pres.ord_tgt {E : NodalData K Fbar} {g : ∀ i, Fbar i} (h : Pres E g)
    (hE : E ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt) (e : Fin m) :
    (xt e).ord (g (tgt e)) = 0 := by
  rw [← h.2]; exact ((NodalData.mem_admissible src tgt xs xt).mp hE).2 e |>.2

theorem ratio_mul {E E' : NodalData K Fbar} {g g' : ∀ i, Fbar i} (h : Pres E g) (h' : Pres E' g')
    (hE : E ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt)
    (hE' : E' ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt) :
    ratio src tgt xs xt (g * g') = ratio src tgt xs xt g * ratio src tgt xs xt g' := by
  funext e
  simp only [ratio, Pi.mul_apply]
  rw [valU_mul (xs e) (h.1 _) (h'.1 _) (h.ord_src hE e) (h'.ord_src hE' e),
    valU_mul (xt e) (h.1 _) (h'.1 _) (h.ord_tgt hE e) (h'.ord_tgt hE' e), mul_inv, mul_mul_mul_comm]

theorem ratio_pow {E : NodalData K Fbar} {g : ∀ i, Fbar i} (h : Pres E g)
    (hE : E ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt) (N : ℕ) :
    ratio src tgt xs xt (g ^ N) = ratio src tgt xs xt g ^ N := by
  funext e
  simp only [ratio, Pi.pow_apply]
  rw [valU_pow (xs e) (h.1 _) (h.ord_src hE e), valU_pow (xt e) (h.1 _) (h.ord_tgt hE e), mul_pow, inv_pow]

theorem ratio_eq_mul_cobd_of_pres {E : NodalData K Fbar} {g g' : ∀ i, Fbar i} (h : Pres E g) (h' : Pres E g')
    (hE : E ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt) :
    ∃ κ : Fin n → Kˣ, ratio src tgt xs xt g' = ratio src tgt xs xt g * cobd K src tgt κ := by
  have hκ : ∀ i, ∃ c : Kˣ, g' i = algebraMap K (Fbar i) (c : K) * g i := fun i =>
    exists_eq_algebraMap_mul_of_forall_ord_eq (h.1 i) (h'.1 i) (fun v => by rw [← h.2 i v, h'.2 i v])
  choose κ hκ using hκ
  refine ⟨κ, funext fun e => ?_⟩
  simp only [ratio, Pi.mul_apply, cobd_apply]
  rw [hκ (src e), hκ (tgt e), valU_algebraMap_mul (xs e) (h.1 _) (h.ord_src hE e),
    valU_algebraMap_mul (xt e) (h.1 _) (h.ord_tgt hE e), mul_inv, mul_mul_mul_comm]
  exact mul_comm _ _

theorem exists_pres_ratio_eq_one {E : NodalData K Fbar}
    (hNP : NodalData.IsNodalPrincipal (K := K) (Fbar := Fbar) src tgt xs xt E) :
    ∃ g : ∀ i, Fbar i, Pres E g ∧ ratio src tgt xs xt g = 1 := by
  obtain ⟨g, a, hg, hE, hv⟩ := hNP
  refine ⟨g, ⟨hg, hE⟩, funext fun e => ?_⟩
  simp only [ratio, Pi.one_apply]
  rw [valU_eq_of_hasValue (xs e) (hg _) ((hv e).1.ord_eq_zero (a e).ne_zero) (hv e).1,
    valU_eq_of_hasValue (xt e) (hg _) ((hv e).2.ord_eq_zero (a e).ne_zero) (hv e).2, mul_inv_cancel]

theorem isNodalPrincipal_of_ratio_mem_range {E : NodalData K Fbar} {g : ∀ i, Fbar i} (h : Pres E g)
    (hE : E ∈ NodalData.admissible (K := K) (Fbar := Fbar) src tgt xs xt)
    (hr : ratio src tgt xs xt g ∈ (cobd K src tgt).range) :
    NodalData.IsNodalPrincipal (K := K) (Fbar := Fbar) src tgt xs xt E := by
  obtain ⟨κ, hκ⟩ := hr

  let g' : ∀ i, Fbar i := fun i => algebraMap K (Fbar i) ((κ i)⁻¹ : Kˣ) * g i
  have hc0 : ∀ i, algebraMap K (Fbar i) (((κ i)⁻¹ : Kˣ) : K) ≠ 0 := fun i => (map_ne_zero _).mpr ((κ i)⁻¹).ne_zero
  have hg' : Pres E g' := ⟨fun i => mul_ne_zero (hc0 i) (h.1 i), fun i v => by
    show E i v = v.ord (algebraMap K (Fbar i) (((κ i)⁻¹ : Kˣ) : K) * g i)
    rw [v.ord_mul (hc0 i) (h.1 i), ((v.hasValue_algebraMap _).ord_eq_zero ((κ i)⁻¹).ne_zero), zero_add, h.2 i v]⟩
  have hval : ∀ e, valU (xs e) (g' (src e)) = valU (xt e) (g' (tgt e)) := by
    intro e
    show valU (xs e) (algebraMap K (Fbar (src e)) (((κ (src e))⁻¹ : Kˣ) : K) * g (src e)) =
      valU (xt e) (algebraMap K (Fbar (tgt e)) (((κ (tgt e))⁻¹ : Kˣ) : K) * g (tgt e))
    rw [valU_algebraMap_mul (xs e) (h.1 _) (h.ord_src hE e), valU_algebraMap_mul (xt e) (h.1 _) (h.ord_tgt hE e)]
    have := congrFun hκ e
    simp only [ratio, cobd_apply] at this

    calc (κ (src e))⁻¹ * valU (xs e) (g (src e))
        = (κ (src e))⁻¹ * (valU (xs e) (g (src e)) * (valU (xt e) (g (tgt e)))⁻¹ * valU (xt e) (g (tgt e))) := by
          rw [inv_mul_cancel_right]
      _ = (κ (src e))⁻¹ * (κ (src e) * (κ (tgt e))⁻¹ * valU (xt e) (g (tgt e))) := by rw [this]
      _ = (κ (tgt e))⁻¹ * valU (xt e) (g (tgt e)) := by
          rw [← mul_assoc, ← mul_assoc, inv_mul_cancel, one_mul]
  refine ⟨g', fun e => valU (xs e) (g' (src e)), hg'.1, hg'.2, fun e => ⟨?_, ?_⟩⟩
  · exact hasValue_valU (xs e) (hg'.1 _) (hg'.ord_src hE e)
  · show (xt e).HasValue (g' (tgt e)) (valU (xs e) (g' (src e)) : K)
    rw [hval e]; exact hasValue_valU (xt e) (hg'.1 _) (hg'.ord_tgt hE e)

end Nodal

end NC

