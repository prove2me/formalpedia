lemma cavityOrientationSign_gram {N : ℕ} (hN : 0 < N) (U : Orthogonal N) :
    (cavityOrientationSign hN U).transpose * cavityOrientationSign hN U = 1 := by
  simpa only [cavityOrientationSign, Matrix.diagonal_transpose] using
