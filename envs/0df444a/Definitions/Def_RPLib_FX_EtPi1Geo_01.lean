/-!
# S4-EtPi1, O8 (part 2): functoriality of `π₁`

`A → A'`, `K → K'` compatible, `ι : K̄ →ₐ[K] K̄'`.

* `jι : K_U(A) →ₐ[K] K_U(A')` (`map_mem_maxUnram`);
* `pi1Fun ι : π₁(A') →* π₁(A)`, `σ ↦ σ|_{K_U(A)}` (restriction to the normal subextension `jι(K_U(A))`),
  characterized by `jι (pi1Fun ι σ y) = σ (jι y)` (`pi1Fun_apply`, `pi1Fun_eq_iff`);
* `pi1Fun_continuous`; `pi1Fun_mem_pi1geo` (geometric to geometric); `pi1Fun_isFrobLift` (Frobenius lifts to
  Frobenius lifts); `pi1Fun_comp` (composition along `A → A' → A''`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson
namespace EtPi1

open GalCover CurveCoh

noncomputable section

section FunB

variable {A K A' K' : Type} [CommRing A] [Field K] [Algebra A K]
  [CommRing A'] [Field K'] [Algebra A' K'] [Algebra K K'] [Algebra A A'] [Algebra A K']
  [IsScalarTower A K K'] [IsScalarTower A A' K']
  (ι : AlgebraicClosure K →ₐ[K] AlgebraicClosure K')

/-- `ι` restricted to `K_U(A) → K_U(A')`. -/
def jι : maxUnram A K →ₐ[K] maxUnram A' K' where
  toFun y := ⟨ι y, map_mem_maxUnram ι y.2⟩
  map_one' := Subtype.ext (map_one ι)
  map_mul' x y := Subtype.ext (map_mul ι (x : AlgebraicClosure K) y)
  map_zero' := Subtype.ext (map_zero ι)
  map_add' x y := Subtype.ext (map_add ι (x : AlgebraicClosure K) y)
  commutes' c := Subtype.ext (ι.commutes c)

theorem jι_coe (y : maxUnram A K) : ((jι (A' := A') ι y : maxUnram A' K') : AlgebraicClosure K') = ι y := rfl

theorem jι_injective : Function.Injective (jι (A := A) (A' := A') ι) := fun _ _ h =>
  Subtype.ext (RingHom.injective (ι : AlgebraicClosure K →+* AlgebraicClosure K') (congrArg Subtype.val h))

/-- **Functoriality of `π₁`**: `π₁(A') → π₁(A)`. -/
def pi1Fun : Pi1 A' K' →* Pi1 A K :=
  letI : Algebra (maxUnram A K) (maxUnram A' K') := (jι ι).toRingHom.toAlgebra
  haveI : IsScalarTower K (maxUnram A K) (maxUnram A' K') := IsScalarTower.of_algHom (jι ι)
  (AlgEquiv.restrictNormalHom (maxUnram A K)).comp
    (MonoidHom.mk' (fun σ : Pi1 A' K' => σ.restrictScalars K) (fun _ _ => AlgEquiv.ext fun _ => rfl))

theorem pi1Fun_apply (σ : Pi1 A' K') (y : maxUnram A K) : jι ι (pi1Fun ι σ y) = σ (jι ι y) := by
  letI : Algebra (maxUnram A K) (maxUnram A' K') := (jι ι).toRingHom.toAlgebra
  haveI : IsScalarTower K (maxUnram A K) (maxUnram A' K') := IsScalarTower.of_algHom (jι ι)
  exact AlgEquiv.restrictNormal_commutes (σ.restrictScalars K) (maxUnram A K) y

theorem pi1Fun_apply' (σ : Pi1 A' K') (y : maxUnram A K) :
    ι ((pi1Fun ι σ y : maxUnram A K) : AlgebraicClosure K) =
      ((σ (jι ι y) : maxUnram A' K') : AlgebraicClosure K') :=
  congrArg Subtype.val (pi1Fun_apply ι σ y)

theorem pi1Fun_eq_iff (σ : Pi1 A' K') (τ : Pi1 A K) :
    pi1Fun ι σ = τ ↔ ∀ y, jι ι (τ y) = σ (jι ι y) := by
  constructor
  · rintro rfl y
    exact pi1Fun_apply ι σ y
  · intro h
    exact AlgEquiv.ext fun y => jι_injective ι ((pi1Fun_apply ι σ y).trans (h y).symm)

theorem pi1Fun_continuous : Continuous (pi1Fun (A := A) (A' := A') ι) := by
  refine continuous_of_continuousAt_one (pi1Fun ι) ?_
  intro s hs
  rw [map_one] at hs
  rw [Filter.mem_map]
  obtain ⟨F, hF, hFs⟩ := (krullTopology_mem_nhds_one_iff K (maxUnram A K) s).1 hs
  have := hF
  let b := Module.finBasis K F
  let W : Set (Pi1 A' K') := ⋂ i, (fixElt A' K' (jι ι (b i : maxUnram A K)) : Set (Pi1 A' K'))
  have hW : IsOpen W := isOpen_iInter_of_finite fun i => fixElt_isOpen A' K' _
  have h1 : (1 : Pi1 A' K') ∈ W := Set.mem_iInter.2 fun i => (fixElt A' K' _).one_mem
  refine Filter.mem_of_superset (hW.mem_nhds h1) ?_
  intro σ hσ
  have hσ' : ∀ i, pi1Fun ι σ (b i : maxUnram A K) = (b i : maxUnram A K) := by
    intro i
    have h : σ (jι ι (b i : maxUnram A K)) = jι ι (b i : maxUnram A K) := Set.mem_iInter.1 hσ i
    exact jι_injective ι ((pi1Fun_apply ι σ _).trans h)
  apply hFs
  rw [SetLike.mem_coe, IntermediateField.mem_fixingSubgroup_iff]
  intro x hx
  have hlin : (pi1Fun ι σ).toLinearMap ∘ₗ F.val.toLinearMap = F.val.toLinearMap :=
    b.ext fun i => hσ' i
  exact LinearMap.congr_fun hlin ⟨x, hx⟩

/-- Geometric elements map to geometric elements. -/
theorem pi1Fun_mem_pi1geo {q : ℕ} {σ : Pi1 A' K'} (hσ : σ ∈ pi1geo A' K' q) : pi1Fun ι σ ∈ pi1geo A K q := by
  refine (mem_pi1geo A K q _).2 fun x hx => jι_injective (A' := A') ι ?_
  rw [pi1Fun_apply]
  exact (mem_pi1geo A' K' q σ).1 hσ _ (hx.map (jι ι))

/-- Frobenius lifts map to Frobenius lifts. -/
theorem pi1Fun_isFrobLift {q : ℕ} {σ : Pi1 A' K'} (hσ : IsFrobLift A' K' q σ) : IsFrobLift A K q (pi1Fun ι σ) := by
  intro x hx
  apply jι_injective (A' := A') ι
  rw [pi1Fun_apply, hσ _ (hx.map (jι ι)), map_pow]

end FunB

section Comp

variable {A K A' K' A'' K'' : Type} [CommRing A] [Field K] [Algebra A K]
  [CommRing A'] [Field K'] [Algebra A' K'] [Algebra K K'] [Algebra A A'] [Algebra A K']
  [IsScalarTower A K K'] [IsScalarTower A A' K']
  [CommRing A''] [Field K''] [Algebra A'' K''] [Algebra K' K''] [Algebra A' A''] [Algebra A' K'']
  [IsScalarTower A' K' K''] [IsScalarTower A' A'' K'']
  [Algebra K K''] [Algebra A A''] [Algebra A K''] [IsScalarTower A K K''] [IsScalarTower A A'' K'']
  [IsScalarTower K K' K'']
  (ι : AlgebraicClosure K →ₐ[K] AlgebraicClosure K') (ι' : AlgebraicClosure K' →ₐ[K'] AlgebraicClosure K'')

/-- **Composition**: `π₁(A'') → π₁(A') → π₁(A)` is the map of the composite embedding. -/
theorem pi1Fun_comp (σ : Pi1 A'' K'') :
    pi1Fun (A := A) (A' := A'') ((ι'.restrictScalars K).comp ι) σ = pi1Fun (A' := A') ι (pi1Fun ι' σ) := by
  symm
  rw [pi1Fun_eq_iff]
  intro y
  apply jι_injective (A := A') (A' := A'') ι'
  have h1 : ∀ z : maxUnram A K, jι (A := A') (A' := A'') ι' (jι (A' := A') ι z) =
      jι (A := A) (A' := A'') ((ι'.restrictScalars K).comp ι) z := fun z => Subtype.ext rfl
  rw [h1, pi1Fun_apply ((ι'.restrictScalars K).comp ι) σ y, ← h1, pi1Fun_apply ι' σ (jι ι y)]

end Comp

end

end EtPi1
