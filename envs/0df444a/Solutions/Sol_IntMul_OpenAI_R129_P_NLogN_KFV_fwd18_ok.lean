  refine IState.ext' (fun j => ?_) rfl rfl
  simp only [cf3, IState.upd_G, encK_G]
  by_cases h1 : j = D
  · subst h1; simp [o0_ne v hD, ints]
  by_cases h2 : j = C
  · subst h2; simp [h1, o0_ne v hC, ints]
  by_cases h3 : j = A
  · subst h3; simp [h1, h2, o0_ne v hA, ints]
  · simp [h1, h2, h3]

