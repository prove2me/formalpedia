/-- The exact logistic map at the chaotic parameter `r = 4`. -/
def logistic (z : ℝ) : ℝ := 4 * z * (1 - z)

/-- Coefficient list of the logistic map, as evaluated by Horner. -/
def logisticCoeffs : List ℝ := [0, 4, -4]








