-- title:
--   The M2VPI programs $(P_u)$, $(D_u)$, $(F_u)$ and their parametric LP
-- statement:
--   For a node $u$, the polyhedron $D$ consists of nonnegative generalized flows with one unit leaving $u$ and zero net flow at every other node. The fractional program $(F_u)$ minimizes $c^\top x/(1-\sum_{e\in\delta^-(u)}\gamma_ex_e)$ over $D$ with positive denominator. Its parametric function minimizes $c^\top x-\delta(1-\sum\gamma_ex_e)$.
--
--   The interface defines primal and dual feasibility and optimality, the extended-real values, and the unit flow carried by a path.
--
--   **Formalization Note** The printed display writes $\delta^+(u),\delta^-(u)$ in the definition of $\nabla x_v$; Lean uses the outgoing and incoming arcs of $v$, as required by the surrounding LP and proof.
-- source:
--   Dadush, Koh, Natura, Végh, arXiv:2004.08634v4, programs (P_u), (D_u), (F_u), and the parametric LP, pp.11–13

import Mathlib
import Definitions.Def_AccelNewtonDinkelbach_Supplement_M2VPI

namespace AccelNewtonDinkelbach.Supplement

open scoped BigOperators

set_option autoImplicit false

noncomputable section

namespace M2VPI

variable {n m : ℕ} (M : M2VPI n m)
local instance (p : Prop) : Decidable p := Classical.propDecidable p

def outgoingMass (A : Fin m → Prop) (x : Fin m → ℝ) (v : Fin n) : ℝ :=
  ∑ e, if A e ∧ M.tail e = v then x e else 0

def incomingGainMass (A : Fin m → Prop) (x : Fin m → ℝ) (v : Fin n) : ℝ :=
  ∑ e, if A e ∧ M.head e = v then M.gain e * x e else 0

/-- The corrected net flow at node `v`: the paper's display has `u` where `v` is required. -/
def netFlow (A : Fin m → Prop) (x : Fin m → ℝ) (v : Fin n) : ℝ :=
  outgoingMass M A x v - incomingGainMass M A x v

/-- The polyhedron `D` in `(F_u)`. -/
def InD (A : Fin m → Prop) (u : Fin n) (x : Fin m → ℝ) : Prop :=
  (∀ e, 0 ≤ x e) ∧ outgoingMass M A x u = 1 ∧ ∀ v, v ≠ u → netFlow M A x v = 0

def denominator (A : Fin m → Prop) (u : Fin n) (x : Fin m → ℝ) : ℝ :=
  1 - incomingGainMass M A x u

def flowCost (A : Fin m → Prop) (x : Fin m → ℝ) : ℝ :=
  ∑ e, if A e then M.cost e * x e else 0

def FuFeasible (A : Fin m → Prop) (u : Fin n) (x : Fin m → ℝ) : Prop :=
  InD M A u x ∧ 0 < denominator M A u x

noncomputable def fuValue (A : Fin m → Prop) (u : Fin n) : EReal :=
  sInf {z : EReal | ∃ x, FuFeasible M A u x ∧
    z = ((flowCost M A x / denominator M A u x : ℝ) : EReal)}

/-- The parametric primal value for `(F_u)`. -/
noncomputable def paramF (A : Fin m → Prop) (u : Fin n) (δ : ℝ) : EReal :=
  sInf {z : EReal | ∃ x, InD M A u x ∧
    z = ((flowCost M A x - δ * denominator M A u x : ℝ) : EReal)}

def DualFeasible (A : Fin m → Prop) (u : Fin n) (δ : ℝ) (y : Fin n → ℝ) : Prop :=
  ∀ e, A e →
    if M.head e = u then y (M.tail e) - M.gain e * δ ≤ M.cost e
    else y (M.tail e) - M.gain e * y (M.head e) ≤ M.cost e

def DualOptimal (A : Fin m → Prop) (u : Fin n) (δ : ℝ) (y : Fin n → ℝ) : Prop :=
  DualFeasible M A u δ y ∧ paramF M A u δ = (((y u - δ : ℝ)) : EReal)

def PrimalOptimal (A : Fin m → Prop) (u : Fin n) (δ : ℝ) (x : Fin m → ℝ) : Prop :=
  InD M A u x ∧ paramF M A u δ = ((flowCost M A x - δ * denominator M A u x : ℝ) : EReal)

/-- The arc flow generated by sending one unit into a directed path. -/
def pathUnitFlow : List (Fin m) → Fin m → ℝ
  | [], _ => 0
  | a :: es, e => (if a = e then 1 else 0) + M.gain a * pathUnitFlow es e

end M2VPI

end

end AccelNewtonDinkelbach.Supplement


