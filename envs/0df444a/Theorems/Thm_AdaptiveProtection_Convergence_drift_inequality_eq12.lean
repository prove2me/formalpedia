-- title:
--   Proof of Theorem 1, p. 766, (12) — E(Z_{n+1}|F_n) ≤ Z_n − 2γ_nT_nh_{i+1}(θ^n_{i+1}, θ*_i, …, θ*_1) + Cγ_n² + C Σ_j γ_n|θ^n_j − θ*_j|
-- statement:
--   Assume fares $f_1 > \cdots > f_{k+1} > 0$, independent nonnegative class demands, assumptions A1 (bounded support) and A3 (Lipschitz partial-sum distributions), step sizes $\gamma_n = A/(n+B)$ with $A > 0$, $B \ge 0$, and let $\theta^n$ follow the recursion (4) from an arbitrary $\theta^1$. Fix $\theta^*$ and $i$ with $1 \le i$, $i + 1 \le k$. Put $T_n = \theta^n_{i+1} - \theta^*_{i+1}$ and $Z_n = |T_n|^2$, and let $F_n$ be the σ-field generated by the demands of the first $n - 1$ flights. Then there is a constant $C$ such that, for all $n \ge 1$, almost surely
--   $$E(Z_{n+1} \mid F_n) \le Z_n - 2\gamma_n T_n h_{i+1}(\theta^n_{i+1}, \theta^*_i, \dots, \theta^*_1) + C\gamma_n^2 + C\sum_{j=1}^{i} \gamma_n |\theta^n_j - \theta^*_j|. \tag{12}$$
--
--   This almost-supermartingale inequality is the input to the Robbins–Siegmund lemma (Lemma 2) for class $i + 1$ and, after A2 is applied, to the rate recursion of Lemma 4.
--
--   **Formalization Note** Lean's index $m$ is the paper's $n = m + 1$: $Z$ is built from `iterate … m` (the paper's $\theta^{m+1}$), the conditioning σ-field is `pastField m` (generated by `ω 0, …, ω (m−1)`, the paper's $F_{m+1}$), and the step size is `stepSize A B (m + 1)`. $h_{i+1}(\theta^n_{i+1}, \theta^*_i, \dots, \theta^*_1)$ is `meanAdj` at the vector equal to $\theta^*$ in coordinates $1, \dots, i$ and to $\theta^n$ elsewhere. $Z$ is bounded (Lemma 3), so the conditional expectation is the genuine one.
-- source:
--   van Ryzin & McGill, Management Science 46(6), 2000, p. 766, proof of Theorem 1, display (12) (left column)

import Mathlib
import Definitions.Def_NestedSeatAlloc_ProbCond_Model
import Definitions.Def_AdaptiveProtection_Convergence_Setting

open MeasureTheory Filter Topology

namespace AdaptiveProtection.Convergence

/-- Inequality (12) in the proof of Theorem 1 (p. 766), for class `i + 1`. With Lean's index
`m` (the paper's `n = m + 1`): `Z_m = (θ^{m+1}_{i+1} − θ*_{i+1})^2`, conditioned on
`pastField m` (the paper's `F_{m+1}`, the demands of the first `m` flights), and the step size
`γ (m + 1)`. -/
theorem drift_inequality_eq12
    (k : ℕ) (f : ℕ → ℝ) (hf : ∀ i, 1 ≤ i → i ≤ k → f (i + 1) < f i) (hfpos : 0 < f (k + 1))
    (ν : ℕ → Measure ℝ) [∀ i, IsProbabilityMeasure (ν i)]
    (hnonneg : ∀ i, 1 ≤ i → i ≤ k + 1 → ∀ᵐ t ∂(ν i), 0 ≤ t)
    (A B : ℝ) (hA : 0 < A) (hB : 0 ≤ B)
    (θ₁ θstar : ℕ → ℝ)
    (hA1 : ∃ Cb : ℝ, ∀ i, 1 ≤ i → i ≤ k + 1 → ∀ᵐ t ∂(ν i), t < Cb)
    (hA3 : ∃ L : ℝ, ∀ i, 1 ≤ i → i ≤ k → ∀ x y : ℝ,
      |(flightLaw ν).real {z | partialSum z i < x} - (flightLaw ν).real {z | partialSum z i < y}|
        ≤ L * |x - y|)
    (i : ℕ) (hi : 1 ≤ i) (hik : i + 1 ≤ k) :
    ∃ C : ℝ, ∀ m : ℕ,
      (pathLaw ν)[fun ω => (iterate f k (stepSize A B) θ₁ ω (m + 1) (i + 1) - θstar (i + 1)) ^ 2
          | pastField m]
        ≤ᵐ[pathLaw ν] fun ω =>
          (iterate f k (stepSize A B) θ₁ ω m (i + 1) - θstar (i + 1)) ^ 2
          - 2 * stepSize A B (m + 1) * (iterate f k (stepSize A B) θ₁ ω m (i + 1) - θstar (i + 1))
              * meanAdj f ν
                  (fun j => if j ≤ i then θstar j else iterate f k (stepSize A B) θ₁ ω m j) (i + 1)
          + C * stepSize A B (m + 1) ^ 2
          + C * ∑ j ∈ Finset.Icc 1 i,
              stepSize A B (m + 1) * |iterate f k (stepSize A B) θ₁ ω m j - θstar j| := by sorry

end AdaptiveProtection.Convergence
