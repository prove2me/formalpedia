open QFS

variable {d : ℕ}

/-- **Lemma 3.2** in `ℝ≥0∞`, which is where the integrand lives. -/
theorem solution {V W : Set (EuclideanSpace ℝ (Fin d))}
    {x y s t : EuclideanSpace ℝ (Fin d)} (hs : s ∈ QFS.cube 1 x) (ht : t ∈ QFS.cube 1 y) :
    QFS.indE (QFS.shift (QFS.shrink V (Real.sqrt d)) x) y + QFS.indE (QFS.shift (QFS.shrink W (Real.sqrt d)) y) x
      ≤ QFS.indE (QFS.shift (QFS.shrink V (Real.sqrt d / 2)) x) t
        + QFS.indE (QFS.shift (QFS.shrink W (Real.sqrt d / 2)) y) s := by
  refine add_le_add (QFS.indE_le_indE (fun hy => ?_)) (QFS.indE_le_indE (fun hx => ?_))
  · exact QFS.cube_subset_of_mem_shift_shrink hy ht
  · exact QFS.cube_subset_of_mem_shift_shrink hx hs
