-- title:
--   Intrinsic local translation and differential ideals
-- statement:
--   Normalized projective charts, genuine rational regular coefficients, local ideal membership, actual iterated derivatives, and the resulting translated differential ideals. Local coefficients retain ideal multiplicity information. Equality with polynomial-operator ideals after component retention remains a separate theorem.
--
--   Compiled, admission-free definition bundle. Theorems asserting its substantive properties remain open targets in the full-paper goal.
-- source:
--   Philippon 1986, §§2–5; 1987 corrections/addenda. https://numdam.org/articles/10.24033/bsmf.2060/

import Definitions.Def_PhilipponMultiplicity_Analytic

set_option autoImplicit false
open scoped BigOperators Topology
noncomputable section

namespace PhilipponMultiplicity

universe u
variable {K : Type u} [NontriviallyNormedField K]

abbrev CoordinateChart (G : EmbeddedGroupProduct K) :=
  ∀ i : G.FactorIndex, Fin ((G.factor i).ambientDimension + 1)

def chartDomain (G : EmbeddedGroupProduct K) (b : CoordinateChart G) : Set G.Point :=
  {x | ∀ i, (G.embedding x i).rep (b i) ≠ 0}

def chartValue (G : EmbeddedGroupProduct K) (b : CoordinateChart G)
    (P : G.CoordinateRing) (x : G.Point) : K :=
  MvPolynomial.eval
    (fun v : G.ambient.Variable =>
      (G.embedding x v.1).rep v.2 / (G.embedding x v.1).rep (b v.1)) P

/-- A degree-zero rational function on the product of projective spaces,
represented by a ratio of actual homogeneous polynomials of equal multidegree. -/
structure RationalCoefficient (G : EmbeddedGroupProduct K) where
  numerator : G.CoordinateRing
  denominator : G.CoordinateRing
  degree : G.FactorIndex → ℕ
  numerator_homogeneous : G.ambient.IsHomogeneous numerator degree
  denominator_homogeneous : G.ambient.IsHomogeneous denominator degree

def RationalCoefficient.value {G : EmbeddedGroupProduct K}
    (r : RationalCoefficient G) (x : G.Point) : K :=
  G.ambient.eval r.numerator (G.embedding x) /
    G.ambient.eval r.denominator (G.embedding x)

structure LocalSection (G : EmbeddedGroupProduct K) where
  domain : Set G.Point
  value : G.Point → K

/-- Local membership in the ideal sheaf generated by the specified sections.
Coefficients must be regular rational functions on a genuine Zariski
neighborhood, not arbitrary pointwise functions. -/
def LocallyGenerated (G : EmbeddedGroupProduct K) (S : Set (LocalSection G))
    (Q : G.CoordinateRing) : Prop :=
  ∀ x : G.Point,
    ∃ b : CoordinateChart G, ∃ U : Set G.Point,
      @IsOpen _ G.zariskiTopology U ∧ x ∈ U ∧ U ⊆ chartDomain G b ∧
      ∃ n : ℕ, ∃ f : Fin n → S, ∃ r : Fin n → RationalCoefficient G,
        (∀ i : Fin n, ∀ y ∈ U,
          y ∈ (f i).val.domain ∧ G.ambient.eval (r i).denominator (G.embedding y) ≠ 0) ∧
        (∀ y ∈ U, chartValue G b Q y = ∑ i, (r i).value y * (f i).val.value y)

def locallyGeneratedIdeal (G : EmbeddedGroupProduct K) (S : Set (LocalSection G)) :
    Ideal G.CoordinateRing :=
  Ideal.span {Q | (∃ D, G.ambient.IsHomogeneous Q D) ∧ LocallyGenerated G S Q}

structure JetIndex (d T : ℕ) where
  order : ℕ
  order_le : order ≤ T
  directions : Fin order → Fin d

def normalizedPullback {G : EmbeddedGroupProduct K} (A : AnalyticSubgroup G)
    (g : G.Point) (b : CoordinateChart G) (P : G.CoordinateRing)
    (x : G.Point) (z : A.ParameterSpace) : K :=
  MvPolynomial.eval
    (fun v : G.ambient.Variable =>
      A.lift (g + x) z v / A.lift (g + x) z ⟨v.1, b v.1⟩) P

def normalizedJet {G : EmbeddedGroupProduct K} (A : AnalyticSubgroup G)
    (g : G.Point) (b : CoordinateChart G) (P : G.CoordinateRing)
    {T : ℕ} (j : JetIndex A.parameterDimension T) (x : G.Point) : K :=
  iteratedFDeriv K j.order (normalizedPullback A g b P x) 0
    (fun i => Pi.single (j.directions i) 1)

/-- Intrinsic local generators of the translated differential ideal. -/
def differentialSections {G : EmbeddedGroupProduct K} (A : AnalyticSubgroup G)
    (g : G.Point) (T : ℕ) (I : Ideal G.CoordinateRing) : Set (LocalSection G) :=
  {f | ∃ P ∈ I, (∃ D, G.ambient.IsHomogeneous P D) ∧
    ∃ b : CoordinateChart G, ∃ j : JetIndex A.parameterDimension T,
      f = ⟨{x | g + x ∈ chartDomain G b}, normalizedJet A g b P j⟩}

/-- The homogeneous ideal of the local differential ideal sheaf on G.
Its comparison with the polynomial representatives and component retention
in source Definition 4.2 is a required foundational bridge. -/
def differentialIdeal {G : EmbeddedGroupProduct K} (A : AnalyticSubgroup G)
    (g : G.Point) (T : ℕ) (I : Ideal G.CoordinateRing) : Ideal G.CoordinateRing :=
  locallyGeneratedIdeal G (differentialSections A g T I)

def translationSections (G : EmbeddedGroupProduct K) (g : G.Point)
    (I : Ideal G.CoordinateRing) : Set (LocalSection G) :=
  {f | ∃ P ∈ I, (∃ D, G.ambient.IsHomogeneous P D) ∧
    ∃ b : CoordinateChart G,
      f = ⟨{x | g + x ∈ chartDomain G b}, fun x => chartValue G b P (g + x)⟩}

def translatedIdeal (G : EmbeddedGroupProduct K) (g : G.Point)
    (I : Ideal G.CoordinateRing) : Ideal G.CoordinateRing :=
  locallyGeneratedIdeal G (translationSections G g I)

end PhilipponMultiplicity


