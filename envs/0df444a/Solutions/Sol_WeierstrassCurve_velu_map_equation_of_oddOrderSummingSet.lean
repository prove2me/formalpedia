  ·
    rw [(placeOfEquation hrs).evalAt_sub hv (mul_mem (hF _) (hF _)) (mul_mem (hF _) (hF _)),
      (placeOfEquation hrs).evalAt_mul hv (hF _) (hF _),
      (placeOfEquation hrs).evalAt_mul hv (hF _) (hF _),
      Place.evalAt_algebraMap, Place.evalAt_algebraMap, Place.evalAt_algebraMap,
