/-! ### Part 4c: 1D Convolution Identity for 2 ≤ φ ≤ 2.32 -/

private lemma inner_x3_eq_g_real {t x2 : ℝ} (hxb : bR ≤ x2) (hxc : x2 ≤ cR) :
    ∫ x3 in x2..cR, (if x3 ≤ t - 2 * x2 then 1 / (x2 * x3 * (t - x2 - x3)) else 0) = g_real t x2 := by
  have hb_pos : (0 : ℝ) < bR := by unfold bR; norm_num
  have h2p : 0 < x2 := lt_of_lt_of_le hb_pos hxb
  by_cases h3 : t ≤ 3 * x2
  · have hg0 : g_real t x2 = 0 := by unfold g_real; rw [if_pos h3]
    rw [hg0, intervalIntegral.integral_of_le hxc]
    refine (setIntegral_congr_ae measurableSet_Ioc ?_).trans (by simp : ∫ _ in Ioc x2 cR, (0 : ℝ) = 0)
    filter_upwards with x3 hx3
    have hnot : ¬ (x3 ≤ t - 2 * x2) := by linarith [hx3.1]
    exact if_neg hnot
  · push Not at h3
    let U : ℝ := min cR (t - 2 * x2)
    have hx2U : x2 ≤ U := le_min hxc (by linarith)
    have hUc : U ≤ cR := min_le_left _ _
    have hUt : U ≤ t - 2 * x2 := min_le_right _ _
    have htx2 : 0 < t - x2 := by linarith
    have hcont : ContinuousOn (fun x3 : ℝ => 1 / (x2 * x3 * (t - x2 - x3))) (Icc x2 U) := by
      refine continuousOn_const.div ((continuousOn_const.mul continuousOn_id).mul
        (continuousOn_const.sub continuousOn_id)) ?_
      intro x3 hx3
      have h3p : 0 < x3 := lt_of_lt_of_le h2p hx3.1
      have hdiff : 0 < t - x2 - x3 := by linarith [hx3.2]
      exact ne_of_gt (mul_pos (mul_pos h2p h3p) hdiff)
    have hsplit : ∫ x3 in x2..cR, (if x3 ≤ t - 2 * x2 then 1 / (x2 * x3 * (t - x2 - x3)) else 0) =
        ∫ x3 in x2..U, 1 / (x2 * x3 * (t - x2 - x3)) := by
      have h1 : IntervalIntegrable (fun x3 => if x3 ≤ t - 2 * x2 then 1 / (x2 * x3 * (t - x2 - x3)) else 0) volume x2 U :=
        (hcont.intervalIntegrable_of_Icc hx2U).congr (fun x3 hx3 => by
          rw [uIoc_of_le hx2U] at hx3; exact (if_pos (le_trans hx3.2 hUt)).symm)
      have h2 : IntervalIntegrable (fun x3 => if x3 ≤ t - 2 * x2 then 1 / (x2 * x3 * (t - x2 - x3)) else 0) volume U cR := by
        refine (intervalIntegrable_const (c := (0 : ℝ))).congr_ae ?_
        rw [Filter.EventuallyEq, ae_restrict_iff' measurableSet_uIoc, uIoc_of_le hUc]
        filter_upwards with x3 hx3
        have : ¬ (x3 ≤ t - 2 * x2) := by
          have : U = t - 2 * x2 := by
            rcases eq_or_lt_of_le hUc with heq | hlt
            · exfalso; linarith [hx3.1, hx3.2]
            · exact min_eq_right (by
                by_contra hcon; push Not at hcon
                have : U = cR := min_eq_left (le_of_lt hcon)
                linarith)
          linarith [hx3.1]
        exact (if_neg this).symm
      rw [← intervalIntegral.integral_add_adjacent_intervals h1 h2]
      have hz2 : ∫ x3 in U..cR, (if x3 ≤ t - 2 * x2 then 1 / (x2 * x3 * (t - x2 - x3)) else 0) = 0 := by
        rw [intervalIntegral.integral_of_le hUc]
        refine (setIntegral_congr_ae measurableSet_Ioc ?_).trans (by simp : ∫ _ in Ioc U cR, (0 : ℝ) = 0)
        filter_upwards with x3 hx3
        have : ¬ (x3 ≤ t - 2 * x2) := by
          have hlt : U < cR := lt_of_lt_of_le hx3.1 hx3.2
          have : U = t - 2 * x2 := min_eq_right (by
            by_contra hcon; push Not at hcon
            have : U = cR := min_eq_left (le_of_lt hcon); linarith)
          linarith [hx3.1]
        exact if_neg this
      have hl : ∫ x3 in x2..U, (if x3 ≤ t - 2 * x2 then 1 / (x2 * x3 * (t - x2 - x3)) else 0) =
          ∫ x3 in x2..U, 1 / (x2 * x3 * (t - x2 - x3)) :=
        intervalIntegral.integral_congr (fun x3 hx3 => by
          rw [uIcc_of_le hx2U] at hx3; exact if_pos (le_trans hx3.2 hUt))
      rw [hl, hz2, add_zero]
    rw [hsplit]
    have hF : ∀ y ∈ uIcc x2 U, HasDerivAt
        (fun x3 => (Real.log x3 - Real.log (t - x2 - x3)) / (x2 * (t - x2)))
        (1 / (x2 * y * (t - x2 - y))) y := by
      intro y hy
      rw [uIcc_of_le hx2U] at hy
      have hyp : 0 < y := lt_of_lt_of_le h2p hy.1
      have hdiff : 0 < t - x2 - y := by linarith [hy.2]
      have hd1 : HasDerivAt Real.log (1 / y) y :=
        (Real.hasDerivAt_log (ne_of_gt hyp)) ▸d (by ring)
      have hd2 : HasDerivAt (fun x3 => Real.log (t - x2 - x3)) (-1 / (t - x2 - y)) y := by
        have hlin : HasDerivAt (fun x3 => t - x2 - x3) (-1) y :=
          ((hasDerivAt_const y (t - x2)).fun_sub (hasDerivAt_id' y)) ▸d (by ring)
        exact (hlin.log (ne_of_gt hdiff)) ▸d (by ring)
      exact ((hd1.fun_sub hd2).div_const (x2 * (t - x2))) ▸d (by
        field_simp [ne_of_gt h2p, ne_of_gt hyp, ne_of_gt htx2, ne_of_gt hdiff]; ring)
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hF (hcont.intervalIntegrable_of_Icc hx2U)]
    unfold g_real
    rw [if_neg (not_le.mpr h3)]
    dsimp only
    have hUp : 0 < U := lt_of_lt_of_le h2p hx2U
    have hdU : 0 < t - x2 - U := by linarith
    have hdx2 : 0 < t - x2 - x2 := by linarith
    have h1 : Real.log (U / x2) = Real.log U - Real.log x2 := Real.log_div (ne_of_gt hUp) (ne_of_gt h2p)
    have h2 : Real.log ((t - 2 * x2) / (t - x2 - U)) = Real.log (t - 2 * x2) - Real.log (t - x2 - U) :=
      Real.log_div (by linarith) (ne_of_gt hdU)
    have hsub : t - x2 - x2 = t - 2 * x2 := by ring
    rw [h1, h2, hsub]
    ring

private lemma inner_x0_eq_W_real {s : ℝ} (hs1 : 2 * aR < s) (hs2 : s < 2 * bR) :
    ∫ x0 in (max aR (s - bR))..(s / 2), (1 / (x0 * (s - x0)) : ℝ) = W_real s := by
  have ha_pos : (0 : ℝ) < aR := by unfold aR; norm_num
  have hb_pos : (0 : ℝ) < bR := by unfold bR; norm_num
  have hsp : 0 < s := by linarith
  let m : ℝ := max aR (s - bR)
  have hm_pos : 0 < m := lt_of_lt_of_le ha_pos (le_max_left _ _)
  have hm_le : m ≤ s / 2 := max_le (by linarith) (by linarith)
  have hsm_pos : 0 < s - m := by linarith
  have hcont : ContinuousOn (fun x0 : ℝ => 1 / (x0 * (s - x0))) (Icc m (s / 2)) := by
    refine continuousOn_const.div (continuousOn_id.mul (continuousOn_const.sub continuousOn_id)) ?_
    intro x0 hx0
    exact ne_of_gt (mul_pos (lt_of_lt_of_le hm_pos hx0.1) (by linarith [hx0.2]))
  have hF : ∀ y ∈ uIcc m (s / 2), HasDerivAt
      (fun x0 => (Real.log x0 - Real.log (s - x0)) / s) (1 / (y * (s - y))) y := by
    intro y hy
    rw [uIcc_of_le hm_le] at hy
    have hyp : 0 < y := lt_of_lt_of_le hm_pos hy.1
    have hsy : 0 < s - y := by linarith [hy.2]
    have hd1 : HasDerivAt Real.log (1 / y) y := (Real.hasDerivAt_log (ne_of_gt hyp)) ▸d (by ring)
    have hd2 : HasDerivAt (fun x0 => Real.log (s - x0)) (-1 / (s - y)) y := by
      have hlin : HasDerivAt (fun x0 => s - x0) (-1) y :=
        ((hasDerivAt_const y s).fun_sub (hasDerivAt_id' y)) ▸d (by ring)
      exact (hlin.log (ne_of_gt hsy)) ▸d (by ring)
    exact ((hd1.fun_sub hd2).div_const s) ▸d (by
      field_simp [ne_of_gt hsp, ne_of_gt hyp, ne_of_gt hsy]; ring)
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hF (hcont.intervalIntegrable_of_Icc hm_le)]
  have hmid : s - s / 2 = s / 2 := by ring
  rw [hmid, sub_self, zero_div, zero_sub]
  have hlog : Real.log ((s - m) / m) = Real.log (s - m) - Real.log m :=
    Real.log_div (ne_of_gt hsm_pos) (ne_of_gt hm_pos)
  have heq_m : -((Real.log m - Real.log (s - m)) / s) = Real.log ((s - m) / m) / s := by
    rw [hlog]; ring
  rw [heq_m]
  by_cases hsab : s ≤ aR + bR
  · rw [W_real_eq_left (le_of_lt hs1) hsab]
    have hm_eq : m = aR := max_eq_left (by linarith)
    rw [hm_eq]
  · push Not at hsab
    rw [W_real_eq_right (le_of_lt hsab) (le_of_lt hs2)]
    have hm_eq : m = s - bR := max_eq_right (by linarith)
    rw [hm_eq]
    have : s - (s - bR) = bR := by ring
    rw [this]

private lemma buchstabIntegral_eq_conv {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {φ : ℝ} (_hφ : 2 ≤ φ) (hφhi : φ ≤ (232 / 100 : ℝ)) :
    buchstabIntegral ω 2 (fun j => (r0j18_lo j : ℝ)) (fun j => (r0j18_hi j : ℝ)) φ =
      ∫ s in (2 * aR)..(2 * bR), W_real s * H_real (φ - s) := by
  have hab : aR ≤ bR := by unfold aR bR; norm_num
  have hbc : bR ≤ cR := by unfold bR cR; norm_num
  have ha_pos : (0 : ℝ) < aR := by unfold aR; norm_num
  have hb_pos : (0 : ℝ) < bR := by unfold bR; norm_num
  rw [buchstabIntegral_eq_iterated hω hz φ]
  have hstep1 :
      (∫ x0 in aR..bR, ∫ x1 in x0..bR, ∫ x2 in bR..cR, ∫ x3 in x2..cR,
        ω ((φ - x0 - x1 - x2 - x3) / x2) / (x0 * x1 * x2 * x2 * x3)) =
      ∫ x0 in aR..bR, ∫ x1 in x0..bR, (1 / (x0 * x1)) * H_real (φ - x0 - x1) := by
    apply intervalIntegral.integral_congr; intro x0 hx0; rw [uIcc_of_le hab] at hx0; dsimp only
    apply intervalIntegral.integral_congr; intro x1 hx1; rw [uIcc_of_le hx0.2] at hx1; dsimp only
    unfold H_real
    rw [← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr; intro x2 hx2; rw [uIcc_of_le hbc] at hx2; dsimp only
    rw [← inner_x3_eq_g_real hx2.1 hx2.2, ← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr; intro x3 hx3; rw [uIcc_of_le hx2.2] at hx3; dsimp only
    have h0p : 0 < x0 := lt_of_lt_of_le ha_pos hx0.1
    have h1p : 0 < x1 := lt_of_lt_of_le ha_pos (le_trans hx0.1 hx1.1)
    have h2p : 0 < x2 := lt_of_lt_of_le hb_pos hx2.1
    have h3p : 0 < x3 := lt_of_lt_of_le h2p hx3.1
    have hu_lt2 : (φ - x0 - x1 - x2 - x3) / x2 ≤ 2 := by
      rw [div_le_iff₀ h2p]
      have hnum : (232 / 100 : ℝ) ≤ 2 * aR + 4 * bR := by unfold aR bR; norm_num
      linarith [hx0.1, hx1.1, hx2.1, hx3.1]
    by_cases hu1 : x3 ≤ (φ - x0 - x1) - 2 * x2
    · rw [if_pos hu1]
      have hge1 : 1 ≤ (φ - x0 - x1 - x2 - x3) / x2 := by
        rw [one_le_div h2p]; linarith
      rw [hω.2.1 _ hge1 hu_lt2]
      have hnum_pos : 0 < φ - x0 - x1 - x2 - x3 := by linarith
      field_simp [ne_of_gt h0p, ne_of_gt h1p, ne_of_gt h2p, ne_of_gt h3p, ne_of_gt hnum_pos]
    · rw [if_neg hu1, mul_zero]
      have hlt1 : (φ - x0 - x1 - x2 - x3) / x2 < 1 := by
        rw [div_lt_one h2p]; linarith
      rw [hz _ hlt1, zero_div]
  rw [hstep1]
  have hstep2 :
      (∫ x0 in aR..bR, ∫ x1 in x0..bR, (1 / (x0 * x1)) * H_real (φ - x0 - x1)) =
      ∫ x0 in aR..bR, ∫ s in (2 * aR)..(2 * bR),
        (if 2 * x0 ≤ s ∧ s ≤ x0 + bR then (1 / (x0 * (s - x0))) * H_real (φ - s) else 0) := by
    apply intervalIntegral.integral_congr; intro x0 hx0; rw [uIcc_of_le hab] at hx0; dsimp only
    have h0p : 0 < x0 := lt_of_lt_of_le ha_pos hx0.1
    have hshift :
        (∫ x1 in x0..bR, (1 / (x0 * x1)) * H_real (φ - x0 - x1)) =
        ∫ s in (2 * x0)..(x0 + bR), (1 / (x0 * (s - x0))) * H_real (φ - s) := by
      have hc := intervalIntegral.integral_comp_sub_right
        (fun y => (1 / (x0 * y)) * H_real (φ - x0 - y)) x0 (a := 2 * x0) (b := x0 + bR)
      have ha1 : 2 * x0 - x0 = x0 := by ring
      have hb1 : x0 + bR - x0 = bR := by ring
      rw [ha1, hb1] at hc
      rw [← hc]
      apply intervalIntegral.integral_congr; intro s _; dsimp only
      have hsub : φ - x0 - (s - x0) = φ - s := by ring
      rw [hsub]
    rw [hshift]
    symm
    apply intervalIntegral_ite_Icc (by linarith [hx0.1]) (by linarith [hx0.2]) (by linarith [hx0.2])
    have hcont_s : ContinuousOn (fun s => (1 / (x0 * (s - x0))) * H_real (φ - s)) (Icc (2 * x0) (x0 + bR)) := by
      refine (continuousOn_const.div (continuousOn_const.mul (continuousOn_id.sub continuousOn_const))
        (fun s hs => ne_of_gt (mul_pos h0p (show 0 < s - x0 by linarith [hs.1])))).mul ?_
      exact (H_real_continuous.comp (continuous_const.sub continuous_id)).continuousOn
    exact hcont_s.intervalIntegrable_of_Icc (by linarith [hx0.2])
  rw [hstep2]
  let K : ℝ × ℝ → ℝ := fun p =>
    if 2 * p.1 ≤ p.2 ∧ p.2 ≤ p.1 + bR then (1 / (p.1 * (p.2 - p.1))) * H_real (φ - p.2) else 0
  have hK_int : IntegrableOn K (Icc aR bR ×ˢ Icc (2 * aR) (2 * bR)) volume := by
    have hS_meas : MeasurableSet {p : ℝ × ℝ | 2 * p.1 ≤ p.2 ∧ p.2 ≤ p.1 + bR} :=
      (isClosed_le (continuous_const.mul continuous_fst) continuous_snd).measurableSet.inter
        (isClosed_le continuous_snd (continuous_fst.add continuous_const)).measurableSet
    have hm : Measurable K := by
      refine Measurable.ite hS_meas ?_ measurable_const
      exact (measurable_const.div (measurable_fst.mul (measurable_snd.sub measurable_fst))).mul
        (H_real_continuous.measurable.comp (measurable_const.sub measurable_snd))
    obtain ⟨M, hM⟩ := (isCompact_Icc (a := 2 * aR) (b := 2 * bR)).exists_bound_of_continuousOn
      (H_real_continuous.comp (continuous_const.sub continuous_id)).continuousOn
    have hfin : volume (Icc aR bR ×ˢ Icc (2 * aR) (2 * bR)) ≠ ⊤ :=
      (isCompact_Icc.prod isCompact_Icc).measure_lt_top.ne
    refine Integrable.mono' (integrableOn_const (C := (1 / (aR * aR)) * max M 0) (hs := hfin))
      hm.aestronglyMeasurable ?_
    filter_upwards [ae_restrict_mem (measurableSet_Icc.prod measurableSet_Icc)] with p hp
    simp only [K]
    split_ifs with hmem
    · have h0p : 0 < p.1 := lt_of_lt_of_le ha_pos hp.1.1
      have hdiff : aR ≤ p.2 - p.1 := by linarith [hp.1.1, hmem.1]
      have hH_le : ‖H_real (φ - p.2)‖ ≤ max M 0 := le_trans (hM p.2 hp.2) (le_max_left _ _)
      have h1_nn : 0 ≤ 1 / (p.1 * (p.2 - p.1)) := div_nonneg zero_le_one (mul_nonneg (le_of_lt h0p) (by linarith))
      rw [norm_mul, Real.norm_of_nonneg h1_nn]
      exact mul_le_mul (div_le_div_of_nonneg_left zero_le_one (mul_pos ha_pos ha_pos)
        (mul_le_mul hp.1.1 hdiff (le_of_lt ha_pos) (le_of_lt h0p))) hH_le (norm_nonneg _) (by positivity)
    · rw [norm_zero]; positivity
  have hswap :
      (∫ x0 in aR..bR, ∫ s in (2 * aR)..(2 * bR), K (x0, s)) =
      ∫ s in (2 * aR)..(2 * bR), ∫ x0 in aR..bR, K (x0, s) := by
    have h1 : (∫ x0 in aR..bR, ∫ s in (2 * aR)..(2 * bR), K (x0, s)) =
        ∫ x0 in Icc aR bR, ∫ s in Icc (2 * aR) (2 * bR), K (x0, s) := by
      rw [intervalIntegral.integral_of_le hab, ← MeasureTheory.integral_Icc_eq_integral_Ioc]
      refine setIntegral_congr_fun measurableSet_Icc (fun x0 _ => ?_)
      rw [intervalIntegral.integral_of_le (by linarith), ← MeasureTheory.integral_Icc_eq_integral_Ioc]
    have h2 : (∫ s in (2 * aR)..(2 * bR), ∫ x0 in aR..bR, K (x0, s)) =
        ∫ s in Icc (2 * aR) (2 * bR), ∫ x0 in Icc aR bR, K (x0, s) := by
      rw [intervalIntegral.integral_of_le (by linarith), ← MeasureTheory.integral_Icc_eq_integral_Ioc]
      refine setIntegral_congr_fun measurableSet_Icc (fun s _ => ?_)
      rw [intervalIntegral.integral_of_le hab, ← MeasureTheory.integral_Icc_eq_integral_Ioc]
    rw [h1, h2]
    rw [IntegrableOn, Measure.volume_eq_prod, ← Measure.prod_restrict] at hK_int
    exact MeasureTheory.integral_integral_swap hK_int
  rw [show (∫ x0 in aR..bR, ∫ s in (2 * aR)..(2 * bR),
      (if 2 * x0 ≤ s ∧ s ≤ x0 + bR then (1 / (x0 * (s - x0))) * H_real (φ - s) else 0)) =
      ∫ x0 in aR..bR, ∫ s in (2 * aR)..(2 * bR), K (x0, s) from rfl, hswap]
  rw [intervalIntegral.integral_of_le (by linarith : 2 * aR ≤ 2 * bR),
      intervalIntegral.integral_of_le (by linarith : 2 * aR ≤ 2 * bR)]
  refine setIntegral_congr_ae measurableSet_Ioc ?_
  filter_upwards [ae_ne_const (2 * bR)] with s hne hs
  have hs1 : 2 * aR < s := hs.1
  have hs2 : s < 2 * bR := lt_of_le_of_ne hs.2 hne
  have hm_ge : aR ≤ max aR (s - bR) := le_max_left _ _
  have hm_le : max aR (s - bR) ≤ s / 2 := max_le (by linarith) (by linarith)
  have hs2_le : s / 2 ≤ bR := by linarith
  have hcond_eq : ∀ x0 ∈ uIcc aR bR,
      K (x0, s) = if max aR (s - bR) ≤ x0 ∧ x0 ≤ s / 2 then (1 / (x0 * (s - x0))) * H_real (φ - s) else 0 := by
    intro x0 hx0
    rw [uIcc_of_le hab] at hx0
    simp only [K]
    have hiff : (2 * x0 ≤ s ∧ s ≤ x0 + bR) ↔ (max aR (s - bR) ≤ x0 ∧ x0 ≤ s / 2) := by
      constructor
      · rintro ⟨h1, h2⟩; exact ⟨max_le hx0.1 (by linarith), by linarith⟩
      · rintro ⟨h1, h2⟩; exact ⟨by linarith, by linarith [le_max_right aR (s - bR)]⟩
    simp only [hiff]
  rw [intervalIntegral.integral_congr hcond_eq]
  have hcont_x0 : ContinuousOn (fun x0 => (1 / (x0 * (s - x0))) * H_real (φ - s)) (Icc (max aR (s - bR)) (s / 2)) := by
    refine (continuousOn_const.div (continuousOn_id.mul (continuousOn_const.sub continuousOn_id)) ?_).mul
      continuousOn_const
    intro x0 hx0
    have h0p : 0 < x0 := lt_of_lt_of_le ha_pos (le_trans hm_ge hx0.1)
    have hdiff : 0 < s - x0 := by linarith [hx0.2]
    exact ne_of_gt (mul_pos h0p hdiff)
  rw [intervalIntegral_ite_Icc hm_ge hm_le hs2_le (hcont_x0.intervalIntegrable_of_Icc hm_le)]
  rw [intervalIntegral.integral_mul_const, inner_x0_eq_W_real hs1 hs2]

/-! ### Part 5: Soundness of the Integer Certificate Checker -/

private lemma ceilDiv_sound {a b : ℕ} (hb : 0 < b) :
    (a : ℝ) / (b : ℝ) ≤ (ceilDiv a b : ℝ) := by
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  rw [div_le_iff₀ hbr]
  have h1 : b * ((a + b - 1) / b) + (a + b - 1) % b = a + b - 1 := Nat.div_add_mod (a + b - 1) b
  have h2 : (a + b - 1) % b < b := Nat.mod_lt (a + b - 1) hb
  have h3 : a ≤ ((a + b - 1) / b) * b := by
    have : b * ((a + b - 1) / b) = ((a + b - 1) / b) * b := Nat.mul_comm _ _
    omega
  unfold ceilDiv
  exact_mod_cast h3

private lemma log1pNat_sound {p q : ℕ} (hq : 0 < q) :
    Real.log (1 + (p : ℝ) / (q : ℝ)) ≤ (log1pNat p q : ℝ) / S_sc := by
  unfold log1pNat
  by_cases hp : p = 0
  · subst hp; simp
  · have hbeq : (p == 0) = false := beq_false_of_ne hp
    rw [hbeq]
    have hqr : (0 : ℝ) < q := by exact_mod_cast hq
    have hS : (0 : ℝ) < S_sc := by unfold S_sc; norm_num
    have hy : 0 ≤ (p : ℝ) / q := div_nonneg (Nat.cast_nonneg _) (le_of_lt hqr)
    have hlog := log_one_add_le_rat hy
    have hrat : (p : ℝ) / q * (6 + (p : ℝ) / q) / (6 + 4 * ((p : ℝ) / q)) =
        ((S_sc * p * (6 * q + p) : ℕ) : ℝ) / ((q * (6 * q + 4 * p) : ℕ) : ℝ) / S_sc := by
      push_cast
      have hden : (6 * (q : ℝ) + 4 * p) ≠ 0 := by linarith [Nat.cast_nonneg (α := ℝ) p]
      have hden2 : 6 + 4 * ((p : ℝ) / q) ≠ 0 := by linarith
      field_simp [ne_of_gt hqr, ne_of_gt hS, hden, hden2]
    rw [hrat] at hlog
    have hq_pos : 0 < q * (6 * q + 4 * p) := Nat.mul_pos hq (by omega)
    exact le_trans hlog (div_le_div_of_nonneg_right (ceilDiv_sound hq_pos) (le_of_lt hS))

private lemma WNat_sound (s_n : ℕ) :
    W_real ((s_n : ℝ) / D_den) ≤ (WNat s_n : ℝ) / S_sc := by
  have hD : (0 : ℝ) < D_den := by unfold D_den; norm_num
  have hS : (0 : ℝ) < S_sc := by unfold S_sc; norm_num
  have hA_pos : 0 < A_num := by unfold A_num; omega
  have hA : (0 : ℝ) < A_num := by exact_mod_cast hA_pos
  unfold W_real WNat
  rw [aR_eq, bR_eq]
  by_cases h1 : s_n ≤ A_num + B_num
  · have h1r : (s_n : ℝ) / D_den ≤ (A_num : ℝ) / D_den + (B_num : ℝ) / D_den := by
      rw [← add_div]; exact div_le_div_of_nonneg_right (by exact_mod_cast h1) (le_of_lt hD)
    rw [if_pos h1, if_pos h1r]
    by_cases h2 : s_n ≤ 2 * A_num
    · have h2r : (s_n : ℝ) / D_den ≤ 2 * ((A_num : ℝ) / D_den) := by
        have : 2 * ((A_num : ℝ) / D_den) = ((2 * A_num : ℕ) : ℝ) / D_den := by push_cast; ring
        rw [this]; exact div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hD)
      rw [if_pos h2, if_pos h2r]; simp
    · push Not at h2
      have h2r : ¬ ((s_n : ℝ) / D_den ≤ 2 * ((A_num : ℝ) / D_den)) := by
        push Not
        have : 2 * ((A_num : ℝ) / D_den) = ((2 * A_num : ℕ) : ℝ) / D_den := by push_cast; ring
        rw [this]; exact div_lt_div_of_pos_right (by exact_mod_cast h2) hD
      rw [if_neg (not_le.mpr h2), if_neg h2r]
      dsimp only
      set p := s_n - 2 * A_num
      have hp_eq : (p : ℝ) = (s_n : ℝ) - 2 * A_num := by
        rw [Nat.cast_sub (le_of_lt h2)]; push_cast; rfl
      have harg : ((s_n : ℝ) / D_den - (A_num : ℝ) / D_den) / ((A_num : ℝ) / D_den) =
          1 + (p : ℝ) / A_num := by
        rw [hp_eq]; field_simp [ne_of_gt hD, ne_of_gt hA]; ring
      rw [harg]
      have hsn_pos : 0 < s_n := by omega
      have hsr : (0 : ℝ) < s_n := by exact_mod_cast hsn_pos
      have hp_nn : 0 ≤ (p : ℝ) / A_num := div_nonneg (Nat.cast_nonneg _) (le_of_lt hA)
      have hlog := log_one_add_le_rat hp_nn
      have hdiv := div_le_div_of_nonneg_right hlog (le_of_lt (div_pos hsr hD))
      have halg : (p : ℝ) / A_num * (6 + (p : ℝ) / A_num) / (6 + 4 * ((p : ℝ) / A_num)) / ((s_n : ℝ) / D_den) =
          ((S_sc * D_den * p * (6 * A_num + p) : ℕ) : ℝ) / ((s_n * A_num * (6 * A_num + 4 * p) : ℕ) : ℝ) / S_sc := by
        push_cast
        have hd1 : 6 * (A_num : ℝ) + 4 * p ≠ 0 := by linarith [Nat.cast_nonneg (α := ℝ) p]
        have hd2 : 6 + 4 * ((p : ℝ) / A_num) ≠ 0 := by linarith
        field_simp [ne_of_gt hD, ne_of_gt hS, ne_of_gt hA, ne_of_gt hsr, hd1, hd2]
      rw [halg] at hdiv
      have hden_pos : 0 < s_n * A_num * (6 * A_num + 4 * p) :=
        Nat.mul_pos (Nat.mul_pos hsn_pos hA_pos) (by omega)
      exact le_trans hdiv (div_le_div_of_nonneg_right (ceilDiv_sound hden_pos) (le_of_lt hS))
  · push Not at h1
    have h1r : ¬ ((s_n : ℝ) / D_den ≤ (A_num : ℝ) / D_den + (B_num : ℝ) / D_den) := by
      push Not; rw [← add_div]; exact div_lt_div_of_pos_right (by exact_mod_cast h1) hD
    rw [if_neg (not_le.mpr h1), if_neg h1r]
    by_cases h2 : 2 * B_num ≤ s_n
    · have h2r : 2 * ((B_num : ℝ) / D_den) ≤ (s_n : ℝ) / D_den := by
        have : 2 * ((B_num : ℝ) / D_den) = ((2 * B_num : ℕ) : ℝ) / D_den := by push_cast; ring
        rw [this]; exact div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hD)
      rw [if_pos h2, if_pos h2r]; simp
    · push Not at h2
      have h2r : ¬ (2 * ((B_num : ℝ) / D_den) ≤ (s_n : ℝ) / D_den) := by
        push Not
        have : 2 * ((B_num : ℝ) / D_den) = ((2 * B_num : ℕ) : ℝ) / D_den := by push_cast; ring
        rw [this]; exact div_lt_div_of_pos_right (by exact_mod_cast h2) hD
      rw [if_neg (not_le.mpr h2), if_neg h2r]
      dsimp only
      set p := 2 * B_num - s_n
      set q := s_n - B_num
      have hq_pos : 0 < q := by omega
      have hqr : (0 : ℝ) < q := by exact_mod_cast hq_pos
      have hsn_pos : 0 < s_n := by omega
      have hsr : (0 : ℝ) < s_n := by exact_mod_cast hsn_pos
      have hp_eq : (p : ℝ) = 2 * B_num - s_n := by
        rw [Nat.cast_sub (le_of_lt h2)]; push_cast; rfl
      have hq_eq : (q : ℝ) = s_n - B_num := by
        rw [Nat.cast_sub (by omega)]
      have harg : (B_num : ℝ) / D_den / ((s_n : ℝ) / D_den - (B_num : ℝ) / D_den) =
          1 + (p : ℝ) / q := by
        have hsb : (s_n : ℝ) / D_den - (B_num : ℝ) / D_den = (q : ℝ) / D_den := by
          rw [hq_eq]; ring
        rw [hsb, hp_eq, hq_eq]
        have hqne : (s_n : ℝ) - B_num ≠ 0 := by linarith
        field_simp [ne_of_gt hD, hqne]; ring
      rw [harg]
      have hpq_nn : 0 ≤ (p : ℝ) / q := div_nonneg (Nat.cast_nonneg _) (le_of_lt hqr)
      have hlog := log_one_add_le_rat hpq_nn
      have hdiv := div_le_div_of_nonneg_right hlog (le_of_lt (div_pos hsr hD))
      have halg : (p : ℝ) / q * (6 + (p : ℝ) / q) / (6 + 4 * ((p : ℝ) / q)) / ((s_n : ℝ) / D_den) =
          ((S_sc * D_den * p * (6 * q + p) : ℕ) : ℝ) / ((s_n * q * (6 * q + 4 * p) : ℕ) : ℝ) / S_sc := by
        push_cast
        have hd1 : 6 * (q : ℝ) + 4 * p ≠ 0 := by linarith [Nat.cast_nonneg (α := ℝ) p]
        have hd2 : 6 + 4 * ((p : ℝ) / q) ≠ 0 := by linarith
        field_simp [ne_of_gt hD, ne_of_gt hS, ne_of_gt hqr, ne_of_gt hsr, hd1, hd2]
      rw [halg] at hdiv
      have hden_pos : 0 < s_n * q * (6 * q + 4 * p) :=
        Nat.mul_pos (Nat.mul_pos hsn_pos hq_pos) (by omega)
      exact le_trans hdiv (div_le_div_of_nonneg_right (ceilDiv_sound hden_pos) (le_of_lt hS))

private lemma gNat_sound {t_n x_n : ℕ} (hx1 : B_num ≤ x_n) (hx2 : x_n ≤ C_num) :
    g_real ((t_n : ℝ) / D_den) ((x_n : ℝ) / D_den) ≤ (gNat t_n x_n : ℝ) / S_sc := by
  have hD : (0 : ℝ) < D_den := by unfold D_den; norm_num
  have hS : (0 : ℝ) < S_sc := by unfold S_sc; norm_num
  have hx_pos : 0 < x_n := by unfold B_num at hx1; omega
  have hxr : (0 : ℝ) < x_n := by exact_mod_cast hx_pos
  unfold g_real gNat
  rw [cR_eq]
  by_cases h3 : t_n ≤ 3 * x_n
  · have h3r : (t_n : ℝ) / D_den ≤ 3 * ((x_n : ℝ) / D_den) := by
      have : 3 * ((x_n : ℝ) / D_den) = ((3 * x_n : ℕ) : ℝ) / D_den := by push_cast; ring
      rw [this]; exact div_le_div_of_nonneg_right (by exact_mod_cast h3) (le_of_lt hD)
    rw [if_pos h3, if_pos h3r]; simp
  · push Not at h3
    have h3r : ¬ ((t_n : ℝ) / D_den ≤ 3 * ((x_n : ℝ) / D_den)) := by
      push Not
      have : 3 * ((x_n : ℝ) / D_den) = ((3 * x_n : ℕ) : ℝ) / D_den := by push_cast; ring
      rw [this]; exact div_lt_div_of_pos_right (by exact_mod_cast h3) hD
    rw [if_neg (not_le.mpr h3), if_neg h3r]
    dsimp only
    set R_n := t_n - x_n
    set U_n := min C_num (R_n - x_n)
    have hR_eq : (R_n : ℝ) = (t_n : ℝ) - x_n := Nat.cast_sub (by omega)
    have hU_eq : min ((C_num : ℝ) / D_den) ((t_n : ℝ) / D_den - 2 * ((x_n : ℝ) / D_den)) = (U_n : ℝ) / D_den := by
      have hRx : (t_n : ℝ) / D_den - 2 * ((x_n : ℝ) / D_den) = ((R_n - x_n : ℕ) : ℝ) / D_den := by
        rw [Nat.cast_sub (by omega), hR_eq]; ring
      rw [hRx]
      have hmin_r : (U_n : ℝ) / D_den = min ((C_num : ℝ) / D_den) (((R_n - x_n : ℕ) : ℝ) / D_den) := by
        simp only [U_n, Nat.cast_min, min_div_div_right (le_of_lt hD)]
      exact hmin_r.symm
    rw [hU_eq]
    by_cases hUx : U_n ≤ x_n
    · rw [if_pos hUx]
      have hU_ge : x_n ≤ U_n := le_min hx2 (by omega)
      have hU_eq_x : U_n = x_n := le_antisymm hUx hU_ge
      rw [hU_eq_x, div_self (ne_of_gt (div_pos hxr hD)), Real.log_one, zero_add]
      have hsub : (t_n : ℝ) / D_den - (x_n : ℝ) / D_den - (x_n : ℝ) / D_den =
          (t_n : ℝ) / D_den - 2 * ((x_n : ℝ) / D_den) := by ring
      rw [hsub]
      have ht2x_pos : 0 < (t_n : ℝ) / D_den - 2 * ((x_n : ℝ) / D_den) := by
        have : (3 * x_n : ℝ) < t_n := by exact_mod_cast h3
        have hrew : 2 * ((x_n : ℝ) / D_den) = (2 * x_n : ℝ) / D_den := by ring
        rw [sub_pos, hrew, div_lt_div_iff_of_pos_right hD]; linarith
      rw [div_self (ne_of_gt ht2x_pos), Real.log_one, zero_div]; simp
    · push Not at hUx
      rw [if_neg (not_le.mpr hUx)]
      set p := U_n - x_n
      have hRU_pos : 0 < R_n - U_n := by
        have : U_n ≤ R_n - x_n := min_le_right _ _
        omega
      have hR_pos : 0 < R_n := by omega
      have hp_eq : (p : ℝ) = (U_n : ℝ) - x_n := Nat.cast_sub (le_of_lt hUx)
      have hRU_eq : ((R_n - U_n : ℕ) : ℝ) = (R_n : ℝ) - U_n := Nat.cast_sub (by omega)
      have hl1_arg : (U_n : ℝ) / D_den / ((x_n : ℝ) / D_den) = 1 + (p : ℝ) / x_n := by
        rw [hp_eq]; field_simp [ne_of_gt hD, ne_of_gt hxr]; ring
      have hl2_arg : ((t_n : ℝ) / D_den - 2 * ((x_n : ℝ) / D_den)) /
          ((t_n : ℝ) / D_den - (x_n : ℝ) / D_den - (U_n : ℝ) / D_den) = 1 + (p : ℝ) / ((R_n - U_n : ℕ) : ℝ) := by
        have hRU_r : (0 : ℝ) < (R_n - U_n : ℕ) := by exact_mod_cast hRU_pos
        rw [hRU_eq] at hRU_r ⊢
        rw [hR_eq] at hRU_r ⊢
        rw [hp_eq]
        have hden : (t_n : ℝ) / D_den - (x_n : ℝ) / D_den - (U_n : ℝ) / D_den = ((t_n : ℝ) - x_n - U_n) / D_den := by ring
        rw [hden]
        have hne : (t_n : ℝ) - x_n - U_n ≠ 0 := ne_of_gt hRU_r
        field_simp [ne_of_gt hD, hne]; ring
      rw [hl1_arg, hl2_arg]
      have hl1 := log1pNat_sound (p := p) hx_pos
      have hl2 := log1pNat_sound (p := p) hRU_pos
      have hRr : (0 : ℝ) < R_n := by exact_mod_cast hR_pos
      have hden_eq : (x_n : ℝ) / D_den * ((t_n : ℝ) / D_den - (x_n : ℝ) / D_den) =
          ((x_n * R_n : ℕ) : ℝ) / (D2 : ℝ) := by
        unfold D2; push_cast; rw [hR_eq]; ring
      rw [hden_eq]
      have hD2 : (0 : ℝ) < D2 := by unfold D2 D_den; norm_num
      have hsum_le : Real.log (1 + (p : ℝ) / x_n) + Real.log (1 + (p : ℝ) / ((R_n - U_n : ℕ) : ℝ)) ≤
          ((log1pNat p x_n + log1pNat p (R_n - U_n) : ℕ) : ℝ) / S_sc := by
        push_cast; rw [add_div]; linarith
      have hstep := div_le_div_of_nonneg_right hsum_le (div_nonneg (Nat.cast_nonneg (x_n * R_n)) (le_of_lt hD2))
      have hrew : ((log1pNat p x_n + log1pNat p (R_n - U_n) : ℕ) : ℝ) / S_sc /
          (((x_n * R_n : ℕ) : ℝ) / (D2 : ℝ)) =
          ((D2 * (log1pNat p x_n + log1pNat p (R_n - U_n)) : ℕ) : ℝ) / ((x_n * R_n : ℕ) : ℝ) / S_sc := by
        push_cast; field_simp [ne_of_gt hS, ne_of_gt hD2, ne_of_gt hxr, ne_of_gt hRr]
      rw [hrew] at hstep
      exact le_trans hstep (div_le_div_of_nonneg_right (ceilDiv_sound (Nat.mul_pos hx_pos hR_pos)) (le_of_lt hS))

private lemma gmNat_sound {t_lo t_hi x_n : ℕ} (hx1 : B_num ≤ x_n) (hx2 : x_n ≤ C_num) :
    gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) ((x_n : ℝ) / D_den) ≤ (gmNat t_lo t_hi x_n : ℝ) / S_sc := by
  have hD : (0 : ℝ) < D_den := by unfold D_den; norm_num
  unfold gm_real gmNat
  rw [cR_eq]
  dsimp only
  have htp : 2 * ((x_n : ℝ) / D_den) + (C_num : ℝ) / D_den = ((2 * x_n + C_num : ℕ) : ℝ) / D_den := by
    push_cast; ring
  rw [htp]
  by_cases h1 : t_hi ≤ 2 * x_n + C_num
  · have h1r : (t_hi : ℝ) / D_den ≤ ((2 * x_n + C_num : ℕ) : ℝ) / D_den :=
      div_le_div_of_nonneg_right (by exact_mod_cast h1) (le_of_lt hD)
    rw [if_pos h1, if_pos h1r]; exact gNat_sound hx1 hx2
  · have h1r : ¬ ((t_hi : ℝ) / D_den ≤ ((2 * x_n + C_num : ℕ) : ℝ) / D_den) := by
      push Not; exact div_lt_div_of_pos_right (by exact_mod_cast (not_le.mp h1)) hD
    rw [if_neg h1, if_neg h1r]
    by_cases h2 : 2 * x_n + C_num ≤ t_lo
    · have h2r : ((2 * x_n + C_num : ℕ) : ℝ) / D_den ≤ (t_lo : ℝ) / D_den :=
        div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hD)
      rw [if_pos h2, if_pos h2r]; exact gNat_sound hx1 hx2
    · have h2r : ¬ (((2 * x_n + C_num : ℕ) : ℝ) / D_den ≤ (t_lo : ℝ) / D_den) := by
        push Not; exact div_lt_div_of_pos_right (by exact_mod_cast (not_le.mp h2)) hD
      rw [if_neg h2, if_neg h2r]; exact gNat_sound hx1 hx2

private lemma gm_real_continuousOn {t_lo t_hi : ℝ} (hlo : t_lo ≤ t_hi) :
    ContinuousOn (fun x => gm_real t_lo t_hi x) (Icc bR cR) := by
  have heq : ∀ x ∈ Icc bR cR, gm_real t_lo t_hi x = g_real (max t_lo (min t_hi (2 * x + cR))) x := by
    intro x _
    unfold gm_real; dsimp only
    split_ifs with h1 h2
    · rw [min_eq_left h1, max_eq_right hlo]
    · push Not at h1
      rw [min_eq_right (le_of_lt h1), max_eq_left h2]
    · push Not at h1 h2
      rw [min_eq_right (le_of_lt h1), max_eq_right (le_of_lt h2)]
  refine ContinuousOn.congr ?_ heq
  have hclamp : Continuous (fun x : ℝ => max t_lo (min t_hi (2 * x + cR))) :=
    continuous_const.max (continuous_const.min ((continuous_const.mul continuous_id).add continuous_const))
  exact g_real_continuousOn.comp (hclamp.continuousOn.prodMk continuousOn_id) (fun x hx => ⟨trivial, hx⟩)

private lemma trapK_le_real {t_lo t_hi K xl xr : ℕ}
    (hbl : B_num ≤ xl) (hlr : xl ≤ xr) (hrc : xr ≤ C_num)
    (hint : ∫ x in ((xl : ℝ) / D_den)..((xr : ℝ) / D_den),
        gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x ≤
      ((gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) ((xl : ℝ) / D_den) +
        gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) ((xr : ℝ) / D_den)) / 2) *
        ((xr : ℝ) / D_den - (xl : ℝ) / D_den) +
      ((K : ℝ) / 12) * ((xr : ℝ) / D_den - (xl : ℝ) / D_den) ^ 3) :
    ∫ x in ((xl : ℝ) / D_den)..((xr : ℝ) / D_den),
      gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x ≤ (trapK t_lo t_hi K xl xr : ℝ) / S_sc := by
  have hD : (0 : ℝ) < D_den := by unfold D_den; norm_num
  have hS : (0 : ℝ) < S_sc := by unfold S_sc; norm_num
  unfold trapK
  by_cases hle : xr ≤ xl
  · have heq : xl = xr := le_antisymm hlr hle
    subst heq; simp
  · push Not at hle
    rw [if_neg (not_le.mpr hle)]
    dsimp only
    set dx := xr - xl
    have hdx_eq : (dx : ℝ) = (xr : ℝ) - xl := Nat.cast_sub hlr
    have hdiff : (xr : ℝ) / D_den - (xl : ℝ) / D_den = (dx : ℝ) / D_den := by rw [hdx_eq]; ring
    have hgl := gmNat_sound (t_lo := t_lo) (t_hi := t_hi) hbl (le_trans hlr hrc)
    have hgr := gmNat_sound (t_lo := t_lo) (t_hi := t_hi) (le_trans hbl hlr) hrc
    have htrap_step :
        ((gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) ((xl : ℝ) / D_den) +
          gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) ((xr : ℝ) / D_den)) / 2) *
          ((xr : ℝ) / D_den - (xl : ℝ) / D_den) ≤
        (ceilDiv ((gmNat t_lo t_hi xl + gmNat t_lo t_hi xr) * dx) TwoD : ℝ) / S_sc := by
      rw [hdiff]
      have h1 : ((gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) ((xl : ℝ) / D_den) +
          gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) ((xr : ℝ) / D_den)) / 2) * ((dx : ℝ) / D_den) ≤
          (((gmNat t_lo t_hi xl : ℝ) / S_sc + (gmNat t_lo t_hi xr : ℝ) / S_sc) / 2) * ((dx : ℝ) / D_den) :=
        mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right (add_le_add hgl hgr) (by norm_num))
          (div_nonneg (Nat.cast_nonneg _) (le_of_lt hD))
      have h2 : (((gmNat t_lo t_hi xl : ℝ) / S_sc + (gmNat t_lo t_hi xr : ℝ) / S_sc) / 2) * ((dx : ℝ) / D_den) =
          (((gmNat t_lo t_hi xl + gmNat t_lo t_hi xr) * dx : ℕ) : ℝ) / (TwoD : ℝ) / S_sc := by
        unfold TwoD; push_cast; field_simp [ne_of_gt hD, ne_of_gt hS]
      rw [h2] at h1
      have h2D_pos : 0 < TwoD := by unfold TwoD D_den; omega
      exact le_trans h1 (div_le_div_of_nonneg_right (ceilDiv_sound h2D_pos) (le_of_lt hS))
    have herr_step :
        ((K : ℝ) / 12) * ((xr : ℝ) / D_den - (xl : ℝ) / D_den) ^ 3 ≤
        ((if K == 0 then 0 else ceilDiv (S_sc * K * dx * dx * dx) TwelveD3 : ℕ) : ℝ) / S_sc := by
      by_cases hK0 : K = 0
      · subst hK0; simp
      · have hbeq : (K == 0) = false := beq_false_of_ne hK0
        simp only [hbeq, Bool.false_eq_true, ↓reduceIte]
        rw [hdiff]
        have hTwelve_eq : (TwelveD3 : ℝ) = 12 * (D_den : ℝ) * D_den * D_den := by
          simp only [TwelveD3, Nat.cast_mul, Nat.cast_ofNat]
        have hrew : ((K : ℝ) / 12) * ((dx : ℝ) / D_den) ^ 3 =
            ((S_sc * K * dx * dx * dx : ℕ) : ℝ) / (TwelveD3 : ℝ) / S_sc := by
          rw [hTwelve_eq]; push_cast; field_simp [ne_of_gt hD, ne_of_gt hS]
        rw [hrew]
        have hD_pos_n : 0 < D_den := by unfold D_den; omega
        have h12_pos : 0 < TwelveD3 := by
          rw [show TwelveD3 = 12 * D_den * D_den * D_den from rfl]
          exact Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (by omega) hD_pos_n) hD_pos_n) hD_pos_n
        exact div_le_div_of_nonneg_right (ceilDiv_sound h12_pos) (le_of_lt hS)
    rw [Nat.cast_add, add_div]
    linarith

private lemma evalInterval_sound {t_lo t_hi xa xb xc xl xr : ℕ}
    (hbl : B_num ≤ xl) (hlr : xl ≤ xr) (hrc : xr ≤ C_num)
    (htlo : C_num < t_lo) (htlh : t_lo ≤ t_hi)
    (hxa : 2 * xa = t_lo - C_num) (hxb : 2 * xb = t_hi - C_num) (hxc : 3 * xc = t_hi) :
    ∫ x in ((xl : ℝ) / D_den)..((xr : ℝ) / D_den),
      gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x ≤
      (evalInterval t_lo t_hi xa xb xc xl xr : ℝ) / S_sc := by
  have hD : (0 : ℝ) < D_den := by unfold D_den; norm_num
  have hS : (0 : ℝ) < S_sc := by unfold S_sc; norm_num
  have htlh_r : (t_lo : ℝ) / D_den ≤ (t_hi : ℝ) / D_den :=
    div_le_div_of_nonneg_right (by exact_mod_cast htlh) (le_of_lt hD)
  have hgm_cont : ContinuousOn (fun x => gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x) (Icc bR cR) :=
    gm_real_continuousOn htlh_r
  have hgm_int : ∀ u v : ℕ, B_num ≤ u → u ≤ v → v ≤ C_num →
      IntervalIntegrable (fun x => gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x) volume
        ((u : ℝ) / D_den) ((v : ℝ) / D_den) := by
    intro u v hu huv hv
    have hu_r : bR ≤ (u : ℝ) / D_den := by rw [bR_eq]; exact div_le_div_of_nonneg_right (by exact_mod_cast hu) (le_of_lt hD)
    have hv_r : (v : ℝ) / D_den ≤ cR := by rw [cR_eq]; exact div_le_div_of_nonneg_right (by exact_mod_cast hv) (le_of_lt hD)
    have huv_r : (u : ℝ) / D_den ≤ (v : ℝ) / D_den := div_le_div_of_nonneg_right (by exact_mod_cast huv) (le_of_lt hD)
    exact (hgm_cont.mono (Icc_subset_Icc hu_r hv_r)).intervalIntegrable_of_Icc huv_r
  let p1 := min xr (max xl xa)
  let p2 := min xr (max xl xb)
  let p3 := min xr (max xl xc)
  have hxab : xa ≤ xb := by omega
  have hp1_ge : xl ≤ p1 := le_min hlr (le_max_left _ _)
  have hp12 : p1 ≤ p2 := min_le_min_left xr (max_le_max_left xl hxab)
  have hp23 : p2 ≤ p3 := by
    by_cases h3c : t_hi ≤ 3 * C_num
    · have hxbc : xb ≤ xc := by omega
      exact min_le_min_left xr (max_le_max_left xl hxbc)
    · have hxc_gt : C_num < xc := by omega
      have hxb_gt : C_num < xb := by omega
      have hp2_eq : p2 = xr := min_eq_left (le_trans hrc (le_trans (le_of_lt hxb_gt) (le_max_right _ _)))
      have hp3_eq : p3 = xr := min_eq_left (le_trans hrc (le_trans (le_of_lt hxc_gt) (le_max_right _ _)))
      omega
  have hp3_le : p3 ≤ xr := min_le_left _ _
  have hsplit1 :
      ∫ x in ((xl : ℝ) / D_den)..((xr : ℝ) / D_den), gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x =
      (∫ x in ((xl : ℝ) / D_den)..((p1 : ℝ) / D_den), gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x) +
      (∫ x in ((p1 : ℝ) / D_den)..((p2 : ℝ) / D_den), gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x) +
      (∫ x in ((p2 : ℝ) / D_den)..((p3 : ℝ) / D_den), gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x) +
      (∫ x in ((p3 : ℝ) / D_den)..((xr : ℝ) / D_den), gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x) := by
    have i1 := hgm_int xl p1 hbl hp1_ge (by omega)
    have i2 := hgm_int p1 p2 (by omega) hp12 (by omega)
    have i3 := hgm_int p2 p3 (by omega) hp23 (by omega)
    have i4 := hgm_int p3 xr (by omega) hp3_le hrc
    have i12 := i1.trans i2
    have i123 := i12.trans i3
    rw [← intervalIntegral.integral_add_adjacent_intervals i123 i4,
        ← intervalIntegral.integral_add_adjacent_intervals i12 i3,
        ← intervalIntegral.integral_add_adjacent_intervals i1 i2]
  have hR1 : ∫ x in ((xl : ℝ) / D_den)..((p1 : ℝ) / D_den),
      gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x ≤
      (trapK t_lo t_hi 55 xl (min xr xa) : ℝ) / S_sc := by
    by_cases hlt : xl < p1
    · set xr1 := min xr xa
      have hp1_eq : p1 = xr1 := by omega
      rw [hp1_eq]
      have hlr1 : xl ≤ xr1 := by omega
      have hrc1 : xr1 ≤ C_num := le_trans (min_le_left _ _) hrc
      have hxa1 : xr1 ≤ xa := min_le_right _ _
      have h2x_le : 2 * ((xr1 : ℝ) / D_den) + cR ≤ (t_lo : ℝ) / D_den := by
        rw [cR_eq]
        have : 2 * xr1 + C_num ≤ t_lo := by omega
        have hcast : 2 * ((xr1 : ℝ) / D_den) + (C_num : ℝ) / D_den =
            ((2 * xr1 + C_num : ℕ) : ℝ) / D_den := by push_cast; ring
        rw [hcast]; exact div_le_div_of_nonneg_right (by exact_mod_cast this) (le_of_lt hD)
      have heq_gm : ∀ x ∈ Icc ((xl : ℝ) / D_den) ((xr1 : ℝ) / D_den),
          gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x = g_real ((t_lo : ℝ) / D_den) x := by
        intro x hx
        unfold gm_real; dsimp only
        have h2x : 2 * x + cR ≤ (t_lo : ℝ) / D_den := by linarith [hx.2]
        by_cases hhi : (t_hi : ℝ) / D_den ≤ 2 * x + cR
        · rw [if_pos hhi]; have : (t_hi : ℝ) / D_den = (t_lo : ℝ) / D_den := by linarith
          rw [this]
        · rw [if_neg hhi, if_pos h2x]
      apply trapK_le_real hbl hlr1 hrc1
      have hlr1_r : (xl : ℝ) / D_den ≤ (xr1 : ℝ) / D_den :=
        div_le_div_of_nonneg_right (by exact_mod_cast hlr1) (le_of_lt hD)
      have hint1 : ∫ x in ((xl : ℝ) / D_den)..((xr1 : ℝ) / D_den), gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x =
          ∫ x in ((xl : ℝ) / D_den)..((xr1 : ℝ) / D_den), g_real ((t_lo : ℝ) / D_den) x :=
        intervalIntegral.integral_congr (fun x hx => by rw [uIcc_of_le hlr1_r] at hx; exact heq_gm x hx)
      rw [hint1, heq_gm _ (left_mem_Icc.mpr hlr1_r), heq_gm _ (right_mem_Icc.mpr hlr1_r)]
      simpa using g1_integral_le_trap
        (by rw [bR_eq]; exact div_le_div_of_nonneg_right (by exact_mod_cast hbl) (le_of_lt hD))
        hlr1_r
        (by rw [cR_eq]; exact div_le_div_of_nonneg_right (by exact_mod_cast hrc1) (le_of_lt hD))
        h2x_le
    · have heq : p1 = xl := by omega
      rw [heq, intervalIntegral.integral_same]
      exact div_nonneg (Nat.cast_nonneg _) (le_of_lt hS)
  have hR2 : ∫ x in ((p1 : ℝ) / D_den)..((p2 : ℝ) / D_den),
      gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x ≤
      (trapK t_lo t_hi 0 (max xl xa) (min xr xb) : ℝ) / S_sc := by
    by_cases hlt : p1 < p2
    · set xl2 := max xl xa
      set xr2 := min xr xb
      have hp1_eq : p1 = xl2 := by omega
      have hp2_eq : p2 = xr2 := by omega
      rw [hp1_eq, hp2_eq]
      have hbl2 : B_num ≤ xl2 := le_trans hbl (le_max_left _ _)
      have hlr2 : xl2 ≤ xr2 := by omega
      have hrc2 : xr2 ≤ C_num := le_trans (min_le_left _ _) hrc
      have heq_gm : ∀ x ∈ Icc ((xl2 : ℝ) / D_den) ((xr2 : ℝ) / D_den),
          gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x = g_real (2 * x + cR) x := by
        intro x hx
        unfold gm_real; dsimp only
        have hlo_le : (t_lo : ℝ) / D_den ≤ 2 * x + cR := by
          rw [cR_eq]
          have h1 : xa ≤ xl2 := le_max_right _ _
          have h2 : t_lo ≤ 2 * xl2 + C_num := by omega
          have h3 : (t_lo : ℝ) / D_den ≤ 2 * ((xl2 : ℝ) / D_den) + (C_num : ℝ) / D_den := by
            have hc : 2 * ((xl2 : ℝ) / D_den) + (C_num : ℝ) / D_den =
                ((2 * xl2 + C_num : ℕ) : ℝ) / D_den := by push_cast; ring
            rw [hc]; exact div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hD)
          linarith [hx.1]
        have hhi_ge : 2 * x + cR ≤ (t_hi : ℝ) / D_den := by
          rw [cR_eq]
          have h1 : xr2 ≤ xb := min_le_right _ _
          have h2 : 2 * xr2 + C_num ≤ t_hi := by omega
          have h3 : 2 * ((xr2 : ℝ) / D_den) + (C_num : ℝ) / D_den ≤ (t_hi : ℝ) / D_den := by
            have hc : 2 * ((xr2 : ℝ) / D_den) + (C_num : ℝ) / D_den =
                ((2 * xr2 + C_num : ℕ) : ℝ) / D_den := by push_cast; ring
            rw [hc]; exact div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hD)
          linarith [hx.2]
        split_ifs with h1 h2
        · have : (t_hi : ℝ) / D_den = 2 * x + cR := by linarith
          rw [this]
        · have : (t_lo : ℝ) / D_den = 2 * x + cR := by linarith
          rw [this]
        · rfl
      apply trapK_le_real hbl2 hlr2 hrc2
      have hlr2_r : (xl2 : ℝ) / D_den ≤ (xr2 : ℝ) / D_den :=
        div_le_div_of_nonneg_right (by exact_mod_cast hlr2) (le_of_lt hD)
      have hint2 : ∫ x in ((xl2 : ℝ) / D_den)..((xr2 : ℝ) / D_den), gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x =
          ∫ x in ((xl2 : ℝ) / D_den)..((xr2 : ℝ) / D_den), g_real (2 * x + cR) x :=
        intervalIntegral.integral_congr (fun x hx => by rw [uIcc_of_le hlr2_r] at hx; exact heq_gm x hx)
      rw [hint2, heq_gm _ (left_mem_Icc.mpr hlr2_r), heq_gm _ (right_mem_Icc.mpr hlr2_r)]
      have hg := gpeak_integral_le_trap
        (by rw [bR_eq]; exact div_le_div_of_nonneg_right (by exact_mod_cast hbl2) (le_of_lt hD))
        hlr2_r
        (by rw [cR_eq]; exact div_le_div_of_nonneg_right (by exact_mod_cast hrc2) (le_of_lt hD))
      simpa using hg
    · have heq : p2 = p1 := by omega
      rw [heq, intervalIntegral.integral_same]
      exact div_nonneg (Nat.cast_nonneg _) (le_of_lt hS)
  have hR3 : ∫ x in ((p2 : ℝ) / D_den)..((p3 : ℝ) / D_den),
      gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x ≤
      (trapK t_lo t_hi 110 (max xl xb) (min xr xc) : ℝ) / S_sc := by
    by_cases hlt : p2 < p3
    · set xl3 := max xl xb
      set xr3 := min xr xc
      have hp2_eq : p2 = xl3 := by omega
      have hp3_eq : p3 = xr3 := by omega
      rw [hp2_eq, hp3_eq]
      have hbl3 : B_num ≤ xl3 := le_trans hbl (le_max_left _ _)
      have hlr3 : xl3 ≤ xr3 := by omega
      have hrc3 : xr3 ≤ C_num := le_trans (min_le_left _ _) hrc
      have ht1 : 3 * ((xr3 : ℝ) / D_den) ≤ (t_hi : ℝ) / D_den := by
        have h1 : 3 * xr3 ≤ t_hi := by
          have : xr3 ≤ xc := min_le_right _ _
          omega
        have hc : 3 * ((xr3 : ℝ) / D_den) = ((3 * xr3 : ℕ) : ℝ) / D_den := by push_cast; ring
        rw [hc]; exact div_le_div_of_nonneg_right (by exact_mod_cast h1) (le_of_lt hD)
      have ht2 : (t_hi : ℝ) / D_den ≤ 2 * ((xl3 : ℝ) / D_den) + cR := by
        rw [cR_eq]
        have h1 : t_hi ≤ 2 * xl3 + C_num := by
          have : xb ≤ xl3 := le_max_right _ _
          omega
        have hc : 2 * ((xl3 : ℝ) / D_den) + (C_num : ℝ) / D_den =
            ((2 * xl3 + C_num : ℕ) : ℝ) / D_den := by push_cast; ring
        rw [hc]; exact div_le_div_of_nonneg_right (by exact_mod_cast h1) (le_of_lt hD)
      have heq_gm : ∀ x ∈ Icc ((xl3 : ℝ) / D_den) ((xr3 : ℝ) / D_den),
          gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x = g_real ((t_hi : ℝ) / D_den) x := by
        intro x hx
        unfold gm_real; dsimp only
        rw [if_pos (by linarith [hx.1])]
      apply trapK_le_real hbl3 hlr3 hrc3
      have hlr3_r : (xl3 : ℝ) / D_den ≤ (xr3 : ℝ) / D_den :=
        div_le_div_of_nonneg_right (by exact_mod_cast hlr3) (le_of_lt hD)
      have hint3 : ∫ x in ((xl3 : ℝ) / D_den)..((xr3 : ℝ) / D_den), gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x =
          ∫ x in ((xl3 : ℝ) / D_den)..((xr3 : ℝ) / D_den), g_real ((t_hi : ℝ) / D_den) x :=
        intervalIntegral.integral_congr (fun x hx => by rw [uIcc_of_le hlr3_r] at hx; exact heq_gm x hx)
      rw [hint3, heq_gm _ (left_mem_Icc.mpr hlr3_r), heq_gm _ (right_mem_Icc.mpr hlr3_r)]
      simpa using g2_integral_le_trap
        (by rw [bR_eq]; exact div_le_div_of_nonneg_right (by exact_mod_cast hbl3) (le_of_lt hD))
        hlr3_r
        (by rw [cR_eq]; exact div_le_div_of_nonneg_right (by exact_mod_cast hrc3) (le_of_lt hD))
        ht1 ht2
    · have heq : p3 = p2 := by omega
      rw [heq, intervalIntegral.integral_same]
      exact div_nonneg (Nat.cast_nonneg _) (le_of_lt hS)
  have hR4 : ∫ x in ((p3 : ℝ) / D_den)..((xr : ℝ) / D_den),
      gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x = 0 := by
    by_cases hlt : p3 < xr
    · have hp3_ge : xc ≤ p3 := by omega
      have hp3_le_r : (p3 : ℝ) / D_den ≤ (xr : ℝ) / D_den :=
        div_le_div_of_nonneg_right (by exact_mod_cast hp3_le) (le_of_lt hD)
      have hz : ∀ x ∈ uIcc ((p3 : ℝ) / D_den) ((xr : ℝ) / D_den),
          gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x = 0 := by
        intro x hx
        rw [uIcc_of_le hp3_le_r] at hx
        have h3x : (t_hi : ℝ) / D_den ≤ 3 * x := by
          have h1 : t_hi ≤ 3 * p3 := by omega
          have h2 : (t_hi : ℝ) / D_den ≤ 3 * ((p3 : ℝ) / D_den) := by
            have hc : 3 * ((p3 : ℝ) / D_den) = ((3 * p3 : ℕ) : ℝ) / D_den := by push_cast; ring
            rw [hc]; exact div_le_div_of_nonneg_right (by exact_mod_cast h1) (le_of_lt hD)
          linarith [hx.1]
        have hxc_r : x ≤ cR := by
          rw [cR_eq]
          exact le_trans hx.2 (div_le_div_of_nonneg_right (by exact_mod_cast hrc) (le_of_lt hD))
        unfold gm_real; dsimp only
        rw [if_pos (by linarith)]
        unfold g_real; rw [if_pos h3x]
      rw [intervalIntegral.integral_congr hz, intervalIntegral.integral_zero]
    · have heq : p3 = xr := by omega
      rw [heq, intervalIntegral.integral_same]
  unfold evalInterval
  rw [hsplit1, hR4, add_zero, Nat.cast_add, Nat.cast_add, add_div, add_div]
  linarith

private lemma sumUpTo_eq_finset_sum (n : ℕ) (f : ℕ → ℕ) :
    (sumUpTo n f : ℝ) = ∑ i ∈ Finset.range n, (f i : ℝ) := by
  induction n with
  | zero => simp [sumUpTo]
  | succ n ih => simp only [sumUpTo, Finset.sum_range_succ, Nat.cast_add, ih]

private lemma HBoxNat_sound {t_lo t_hi M2 : ℕ}
    (_hM2 : 0 < M2) (hdivM2 : M2 ∣ (C_num - B_num))
    (htlo : C_num < t_lo) (htlh : t_lo ≤ t_hi)
    (hd6lo : 6 ∣ t_lo) (hd6hi : 6 ∣ t_hi)
    {t : ℝ} (ht1 : (t_lo : ℝ) / D_den ≤ t) (ht2 : t ≤ (t_hi : ℝ) / D_den) :
    H_real t ≤ (HBoxNat t_lo t_hi M2 : ℝ) / S_sc := by
  have hD : (0 : ℝ) < D_den := by unfold D_den; norm_num
  have hbc : bR ≤ cR := by unfold bR cR; norm_num
  have htlh_r : (t_lo : ℝ) / D_den ≤ (t_hi : ℝ) / D_den :=
    div_le_div_of_nonneg_right (by exact_mod_cast htlh) (le_of_lt hD)
  have hg_cont : ContinuousOn (fun x => g_real t x) (Icc bR cR) :=
    g_real_continuousOn.comp (continuousOn_const.prodMk continuousOn_id) (fun x hx => ⟨trivial, hx⟩)
  have hgm_cont : ContinuousOn (fun x => gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x) (Icc bR cR) :=
    gm_real_continuousOn htlh_r
  have hH_le : H_real t ≤ ∫ x in bR..cR, gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x := by
    unfold H_real
    exact intervalIntegral.integral_mono_on hbc
      (hg_cont.intervalIntegrable_of_Icc hbc) (hgm_cont.intervalIntegrable_of_Icc hbc)
      (fun x hx => g_real_le_gm_real hx.1 hx.2 ht1 ht2)
  refine le_trans hH_le ?_
  set hx := (C_num - B_num) / M2
  have hM2x : M2 * hx = C_num - B_num := Nat.mul_div_cancel' hdivM2
  have hBC : B_num ≤ C_num := by unfold B_num C_num; omega
  have hsplit : ∫ x in bR..cR, gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x =
      ∑ m ∈ Finset.range M2,
        ∫ x in (((B_num + m * hx : ℕ) : ℝ) / D_den)..(((B_num + (m + 1) * hx : ℕ) : ℝ) / D_den),
          gm_real ((t_lo : ℝ) / D_den) ((t_hi : ℝ) / D_den) x := by
    have h0 : ((B_num + 0 * hx : ℕ) : ℝ) / D_den = bR := by rw [bR_eq]; simp
    have hM : ((B_num + M2 * hx : ℕ) : ℝ) / D_den = cR := by
      rw [cR_eq]; congr 1; exact_mod_cast (by omega : B_num + M2 * hx = C_num)
    rw [← h0, ← hM]
    symm
    apply intervalIntegral.sum_integral_adjacent_intervals
    intro m hm
    have hm1 : B_num + (m + 1) * hx ≤ C_num := by
      have : (m + 1) * hx ≤ M2 * hx := Nat.mul_le_mul_right hx hm
      omega
    have hlo_r : bR ≤ ((B_num + m * hx : ℕ) : ℝ) / D_den := by
      rw [bR_eq]; exact div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hD)
    have hhi_r : ((B_num + (m + 1) * hx : ℕ) : ℝ) / D_den ≤ cR := by
      rw [cR_eq]; exact div_le_div_of_nonneg_right (by exact_mod_cast hm1) (le_of_lt hD)
    have hle_r : ((B_num + m * hx : ℕ) : ℝ) / D_den ≤ ((B_num + (m + 1) * hx : ℕ) : ℝ) / D_den :=
      div_le_div_of_nonneg_right (by exact_mod_cast (by nlinarith : B_num + m * hx ≤ B_num + (m + 1) * hx)) (le_of_lt hD)
    exact (hgm_cont.mono (Icc_subset_Icc hlo_r hhi_r)).intervalIntegrable_of_Icc hle_r
  rw [hsplit]
  unfold HBoxNat
  rw [if_pos htlo, if_pos (lt_of_lt_of_le htlo htlh)]
  dsimp only
  rw [sumUpTo_eq_finset_sum, Finset.sum_div]
  have hd2C : 2 ∣ C_num := by unfold C_num; decide
  have hxa : 2 * ((t_lo - C_num) / 2) = t_lo - C_num := by omega
  have hxb : 2 * ((t_hi - C_num) / 2) = t_hi - C_num := by omega
  have hxc : 3 * (t_hi / 3) = t_hi := by omega
  apply Finset.sum_le_sum
  intro m hm
  rw [Finset.mem_range] at hm
  have hm_eq : B_num + (m + 1) * hx = B_num + m * hx + hx := by ring
  rw [hm_eq]
  have hm1 : B_num + m * hx + hx ≤ C_num := by
    have : (m + 1) * hx ≤ M2 * hx := Nat.mul_le_mul_right hx hm
    omega
  exact evalInterval_sound (Nat.le_add_right _ _) (Nat.le_add_right _ _) hm1 htlo htlh hxa hxb hxc

/-! ### List Checker Soundness Lemmas -/

private lemma checkWGo_spec {hs half k i : ℕ} {W : List ℕ}
    (h : checkWGo hs half k i W = true) :
    W.length = k ∧
    ∀ r < k,
      let sl := 2 * A_num + (i + r) * hs
      let sr := sl + hs
      (if i + r < half then ceilDiv (WNat (sl + hs / 2) * hs) D_den
       else ceilDiv ((WNat sl + WNat sr) * hs) TwoD) ≤ W.getD r 0 := by
  induction k generalizing i W with
  | zero =>
    cases W with
    | nil => exact ⟨rfl, fun r hr => by omega⟩
    | cons _ _ => simp [checkWGo] at h
  | succ k ih =>
    cases W with
    | nil => simp [checkWGo] at h
    | cons w rest =>
      simp only [checkWGo, Bool.and_eq_true, decide_eq_true_eq] at h
      obtain ⟨hlen, hspec⟩ := ih h.2
      refine ⟨by simp [hlen], fun r hr => ?_⟩
      cases r with
      | zero => simpa using h.1
      | succ r' =>
        have hstep := hspec r' (by omega)
        have hadd : i + 1 + r' = i + (r' + 1) := by omega
        simpa [hadd] using hstep

private lemma checkHGo_spec {phi0 hs M2 mult n : ℕ} {Hrev : List ℕ}
    (h : checkHGo phi0 hs M2 mult n Hrev = true) :
    Hrev.length = n ∧
    ∀ j < n,
      let t_lo := phi0 + j * hs - 2 * B_num
      let t_hi := t_lo + (mult + 1) * hs
      HBoxNat t_lo t_hi M2 ≤ Hrev.getD (n - 1 - j) 0 := by
  induction n generalizing Hrev with
  | zero =>
    cases Hrev with
    | nil => exact ⟨rfl, fun j hj => by omega⟩
    | cons _ _ => simp [checkHGo] at h
  | succ n ih =>
    cases Hrev with
    | nil => simp [checkHGo] at h
    | cons h0 rest =>
      simp only [checkHGo, Bool.and_eq_true, decide_eq_true_eq] at h
      obtain ⟨hlen, hspec⟩ := ih h.2
      refine ⟨by simp [hlen], fun j hj => ?_⟩
      by_cases hjeq : j = n
      · rw [hjeq]
        have hidx : n + 1 - 1 - n = 0 := by omega
        simpa [hidx] using h.1
      · have hjlt : j < n := by omega
        have hidx : n + 1 - 1 - j = (n - 1 - j) + 1 := by omega
        rw [hidx]
        simpa only [List.getD_cons_succ] using hspec j hjlt

private lemma dotList_acc (xs ys : List ℕ) (acc : ℕ) :
    dotList xs ys acc = acc + dotList xs ys 0 := by
  induction xs generalizing ys acc with
  | nil => simp [dotList]
  | cons x xs ih =>
    cases ys with
    | nil => simp [dotList]
    | cons y ys =>
      simp only [dotList]
      rw [ih ys (acc + x * y), ih ys (0 + x * y)]
      omega

private lemma dotList_eq_sum_getD (xs ys : List ℕ) (hle : xs.length ≤ ys.length) :
    dotList xs ys 0 = ∑ i ∈ Finset.range xs.length, xs.getD i 0 * ys.getD i 0 := by
  induction xs generalizing ys with
  | nil => simp [dotList]
  | cons x xs ih =>
    cases ys with
    | nil => simp at hle
    | cons y ys =>
      simp only [dotList, List.length_cons, Finset.sum_range_succ']
      rw [dotList_acc, ih ys (by simp at hle; omega)]
      simp only [List.getD_cons_zero, List.getD_cons_succ]
      omega

private lemma checkSlices_spec {k mult : ℕ} {W Hrev : List ℕ}
    (h : checkSlices k mult W Hrev = true) :
    ∀ d < k, dotList W (Hrev.drop (d * mult)) 0 ≤ TARGET_S2 := by
  induction k generalizing Hrev with
  | zero => intro d hd; omega
  | succ k ih =>
    simp only [checkSlices, Bool.and_eq_true, decide_eq_true_eq] at h
    intro d hd
    cases d with
    | zero => simpa using h.1
    | succ d' =>
      have hstep := ih h.2 d' (by omega)
      rw [List.drop_drop] at hstep
      have heq : mult + d' * mult = (d' + 1) * mult := by ring
      rwa [heq] at hstep

private lemma W_integral_subinterval_le {Ns i : ℕ}
    (_hNs : 0 < Ns) (h2Ns : 2 ∣ Ns) (hdivNs : Ns ∣ (2 * B_num - 2 * A_num))
    (h2hs : 2 ∣ ((2 * B_num - 2 * A_num) / Ns)) (hi : i < Ns) :
    let hs := (2 * B_num - 2 * A_num) / Ns
    let sl := 2 * A_num + i * hs
    let sr := sl + hs
    let w_req := if i < Ns / 2 then ceilDiv (WNat (sl + hs / 2) * hs) D_den
                 else ceilDiv ((WNat sl + WNat sr) * hs) TwoD
    ∫ s in ((sl : ℝ) / D_den)..((sr : ℝ) / D_den), W_real s ≤ (w_req : ℝ) / S_sc := by
  have hD : (0 : ℝ) < D_den := by unfold D_den; norm_num
  have hS : (0 : ℝ) < S_sc := by unfold S_sc; norm_num
  dsimp only
  set hs := (2 * B_num - 2 * A_num) / Ns
  have hNhs : Ns * hs = 2 * B_num - 2 * A_num := Nat.mul_div_cancel' hdivNs
  have hAB : A_num < B_num := by unfold A_num B_num; omega
  have hhalf_eq : (Ns / 2) * hs = B_num - A_num := by
    have h2 : 2 * (Ns / 2) = Ns := Nat.mul_div_cancel' h2Ns
    have hmul2 : 2 * ((Ns / 2) * hs) = Ns * hs := by rw [← Nat.mul_assoc, h2]
    omega
  set sl := 2 * A_num + i * hs
  set sr := sl + hs
  have hdiff : (sr : ℝ) / D_den - (sl : ℝ) / D_den = (hs : ℝ) / D_den := by
    simp only [sr, sl]; push_cast; ring
  split_ifs with hlt
  · have hsr_le : sr ≤ A_num + B_num := by
      have : (i + 1) * hs ≤ (Ns / 2) * hs := Nat.mul_le_mul_right hs hlt
      have : sr = 2 * A_num + (i + 1) * hs := by simp only [sr, sl]; ring
      omega
    have hmid_eq : ((sl : ℝ) / D_den + (sr : ℝ) / D_den) / 2 = ((sl + hs / 2 : ℕ) : ℝ) / D_den := by
      have h2 : 2 * (hs / 2) = hs := Nat.mul_div_cancel' h2hs
      have h2r : 2 * ((hs / 2 : ℕ) : ℝ) = hs := by exact_mod_cast h2
      simp only [sr]; push_cast; field_simp [ne_of_gt hD]; linarith
    have h1 := W_real_integral_le_midpoint (sl := (sl : ℝ) / D_den) (sr := (sr : ℝ) / D_den)
      (by rw [aR_eq]; have : 2 * ((A_num : ℝ) / D_den) = ((2 * A_num : ℕ) : ℝ) / D_den := by push_cast; ring
          rw [this]; exact div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hD))
      (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right sl hs) (le_of_lt hD))
      (by rw [aR_eq, bR_eq, ← add_div]; exact div_le_div_of_nonneg_right (by exact_mod_cast hsr_le) (le_of_lt hD))
    rw [hmid_eq, hdiff] at h1
    have h2 : W_real (((sl + hs / 2 : ℕ) : ℝ) / D_den) * ((hs : ℝ) / D_den) ≤
        ((WNat (sl + hs / 2) : ℝ) / S_sc) * ((hs : ℝ) / D_den) :=
      mul_le_mul_of_nonneg_right (WNat_sound (sl + hs / 2)) (div_nonneg (Nat.cast_nonneg _) (le_of_lt hD))
    have h3 : ((WNat (sl + hs / 2) : ℝ) / S_sc) * ((hs : ℝ) / D_den) =
        ((WNat (sl + hs / 2) * hs : ℕ) : ℝ) / (D_den : ℝ) / S_sc := by
      push_cast; field_simp [ne_of_gt hD, ne_of_gt hS]
    rw [h3] at h2
    exact le_trans h1 (le_trans h2 (div_le_div_of_nonneg_right (ceilDiv_sound (by unfold D_den; omega)) (le_of_lt hS)))
  · push Not at hlt
    have hsl_ge : A_num + B_num ≤ sl := by
      have : (Ns / 2) * hs ≤ i * hs := Nat.mul_le_mul_right hs hlt
      omega
    have hsr_le : sr ≤ 2 * B_num := by
      have : (i + 1) * hs ≤ Ns * hs := Nat.mul_le_mul_right hs hi
      have : sr = 2 * A_num + (i + 1) * hs := by simp only [sr, sl]; ring
      omega
    have h1 := W_real_integral_le_trapezoid (sl := (sl : ℝ) / D_den) (sr := (sr : ℝ) / D_den)
      (by rw [aR_eq, bR_eq, ← add_div]; exact div_le_div_of_nonneg_right (by exact_mod_cast hsl_ge) (le_of_lt hD))
      (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right sl hs) (le_of_lt hD))
      (by rw [bR_eq]; have : 2 * ((B_num : ℝ) / D_den) = ((2 * B_num : ℕ) : ℝ) / D_den := by push_cast; ring
          rw [this]; exact div_le_div_of_nonneg_right (by exact_mod_cast hsr_le) (le_of_lt hD))
    rw [hdiff] at h1
    have h2 : ((W_real ((sl : ℝ) / D_den) + W_real ((sr : ℝ) / D_den)) / 2) * ((hs : ℝ) / D_den) ≤
        (((WNat sl : ℝ) / S_sc + (WNat sr : ℝ) / S_sc) / 2) * ((hs : ℝ) / D_den) :=
      mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right (add_le_add (WNat_sound sl) (WNat_sound sr)) (by norm_num))
        (div_nonneg (Nat.cast_nonneg _) (le_of_lt hD))
    have h3 : (((WNat sl : ℝ) / S_sc + (WNat sr : ℝ) / S_sc) / 2) * ((hs : ℝ) / D_den) =
        (((WNat sl + WNat sr) * hs : ℕ) : ℝ) / (TwoD : ℝ) / S_sc := by
      unfold TwoD; push_cast; field_simp [ne_of_gt hD, ne_of_gt hS]
    rw [h3] at h2
    exact le_trans h1 (le_trans h2 (div_le_div_of_nonneg_right (ceilDiv_sound (by unfold TwoD D_den; omega)) (le_of_lt hS)))

private lemma band_sound {phi0 nSlices Ns M2 mult : ℕ} {W_cert H_cert : List ℕ}
    (hNs : 0 < Ns) (h2Ns : 2 ∣ Ns) (hdivNs : Ns ∣ (2 * B_num - 2 * A_num))
    (hM2 : 0 < M2) (hdivM2 : M2 ∣ (C_num - B_num))
    (hnSlices : 0 < nSlices) (hmult : 0 < mult)
    (hphi0_ge : 2 * B_num + C_num < phi0)
    (hd6phi0 : 6 ∣ phi0) (hd6hs : 6 ∣ ((2 * B_num - 2 * A_num) / Ns))
    (hW : checkW Ns W_cert = true)
    (hH : checkH phi0 Ns M2 mult nSlices H_cert = true)
    (hS : checkSlices nSlices mult W_cert H_cert = true)
    {φ : ℝ}
    (hφ_lo : (phi0 : ℝ) / D_den ≤ φ)
    (hφ_hi : φ ≤ ((phi0 + nSlices * mult * ((2 * B_num - 2 * A_num) / Ns) : ℕ) : ℝ) / D_den) :
    ∫ s in (2 * aR)..(2 * bR), W_real s * H_real (φ - s) ≤ ((155569 / 1000000000) : ℝ) := by
  have hD : (0 : ℝ) < D_den := by unfold D_den; norm_num
  have hS_pos : (0 : ℝ) < S_sc := by unfold S_sc; norm_num
  set hs := (2 * B_num - 2 * A_num) / Ns
  have hNhs : Ns * hs = 2 * B_num - 2 * A_num := Nat.mul_div_cancel' hdivNs
  have hAB : A_num < B_num := by unfold A_num B_num; omega
  have hhs_pos : 0 < hs := by
    by_contra h0
    have hhs0 : hs = 0 := Nat.eq_zero_of_not_pos h0
    have hzero : 2 * B_num - 2 * A_num = 0 := by
      have : Ns * hs = 0 := by rw [hhs0, Nat.mul_zero]
      omega
    omega
  have h2hs : 2 ∣ hs := dvd_trans (by decide : 2 ∣ 6) hd6hs
  set step := mult * hs
  have hstep_pos : 0 < step := Nat.mul_pos hmult hhs_pos
  have hstep_r : (0 : ℝ) < step := by exact_mod_cast hstep_pos
  have hp_exists : ∃ p < nSlices,
      ((phi0 + p * step : ℕ) : ℝ) / D_den ≤ φ ∧
      φ ≤ ((phi0 + (p + 1) * step : ℕ) : ℝ) / D_den := by
    by_cases htop : φ = ((phi0 + nSlices * step : ℕ) : ℝ) / D_den
    · refine ⟨nSlices - 1, by omega, ?_, ?_⟩
      · rw [htop]; apply div_le_div_of_nonneg_right _ (le_of_lt hD)
        exact_mod_cast (by have : (nSlices - 1) * step ≤ nSlices * step := Nat.mul_le_mul_right step (by omega); omega : phi0 + (nSlices - 1) * step ≤ phi0 + nSlices * step)
