open Real
open scoped ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.RN
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
open ExactVacuumAtlas.Variation.RN
theorem solution (M Q : ℝ) :
    IsTangent (fun ε => gRN M (Q ^ 2 + ε)) (fun _ => faradayRN Q) domJ tanB 0 where
  metric y hy i j := by
    have h1 : HasDerivAt (fun ε : ℝ => Q ^ 2 + ε) 1 0 := (hasDerivAt_id (0 : ℝ)).const_add _
    have h00 : HasDerivAt (fun ε : ℝ => -(1 - 2 * M / y 1 + (Q ^ 2 + ε) / y 1 ^ 2)) (-1 / y 1 ^ 2) 0 := by
      refine ((hasDerivAt_const (0 : ℝ) (1 - 2 * M / y 1)).add (h1.div_const (y 1 ^ 2))).neg.congr_deriv ?_
      ring
    fin_cases i <;> fin_cases j
    all_goals first
      | exact h00
      | exact hasDerivAt_const (0 : ℝ) _
  field _ _ i j := hasDerivAt_const (0 : ℝ) (faradayRN Q i j _)
