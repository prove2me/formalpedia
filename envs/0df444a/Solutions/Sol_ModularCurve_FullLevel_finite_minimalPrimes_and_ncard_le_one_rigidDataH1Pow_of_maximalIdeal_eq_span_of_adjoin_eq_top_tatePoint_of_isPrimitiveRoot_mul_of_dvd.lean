theorem exists_algEquiv_adjoinRoot_cyclotomic
    (A₀ A : Type) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀] [CommRing A] [IsDomain A] [Algebra A₀ A]
    [NoZeroSMulDivisors A₀ A]
    (q : ℕ) [Fact q.Prime] (ζ : A) (hζ : IsPrimitiveRoot ζ q)
    (hirr : Irreducible (Polynomial.cyclotomic q (FractionRing A₀)))
    (hadj : Algebra.adjoin A₀ ({ζ} : Set A) = ⊤) :
    ∃ e : AdjoinRoot (Polynomial.cyclotomic q A₀) ≃ₐ[A₀] A, e (AdjoinRoot.root _) = ζ := by
  classical
  haveI : NeZero q := ⟨(Fact.out : q.Prime).ne_zero⟩

  have hint : IsIntegral A₀ ζ := ⟨X ^ q - 1, monic_X_pow_sub_C 1 (NeZero.ne q), by
    simp [eval₂_sub, eval₂_X_pow, hζ.pow_eq_one]⟩

  let K := FractionRing A₀
  let L := FractionRing A
  letI : Algebra K L := FractionRing.liftAlgebra A₀ L
  haveI : IsScalarTower A₀ K L := FractionRing.isScalarTower_liftAlgebra A₀ L
  have hζL : IsPrimitiveRoot (algebraMap A L ζ) q := hζ.map_of_injective (IsFractionRing.injective A L)
  haveI : NeZero ((q : ℕ) : L) := hζL.neZero'
  haveI : NeZero ((q : ℕ) : K) := by
    refine ⟨fun h => (NeZero.ne ((q : ℕ) : L)) ?_⟩
    rw [← map_natCast (algebraMap K L), h, map_zero]
  have hmin : minpoly A₀ ζ = cyclotomic q A₀ := by
    apply Polynomial.map_injective (algebraMap A₀ K) (IsFractionRing.injective A₀ K)
    rw [← minpoly.isIntegrallyClosed_eq_field_fractions K L hint, map_cyclotomic,
      hζL.minpoly_eq_cyclotomic_of_irreducible hirr]

  rw [← hmin]
  refine ⟨(minpoly.equivAdjoin hint).trans ((Subalgebra.equivOfEq _ _ hadj).trans Subalgebra.topEquiv), ?_⟩
  rw [AlgEquiv.trans_apply, AlgEquiv.trans_apply]
  change ((minpoly.equivAdjoin hint (AdjoinRoot.root (minpoly A₀ ζ)) : ↥(Algebra.adjoin A₀ ({ζ} : Set A))) : A) = ζ
  rw [minpoly.coe_equivAdjoin]
  exact AdjoinRoot.Minpoly.coe_toAdjoin_mk_X

theorem exists_algEquiv_adjoinRoot_map_tensorProduct
    (R₀ R A' : Type) [CommRing R₀] [CommRing R] [CommRing A'] [Algebra R₀ R] [Algebra R₀ A']
    (f : Polynomial R₀) (hf : f.Monic) (e : AdjoinRoot f ≃ₐ[R₀] A') :
    ∃ e' : AdjoinRoot (f.map (algebraMap R₀ R)) ≃ₐ[R] TensorProduct R₀ R A',
      e' (AdjoinRoot.root _) = (1 : R) ⊗ₜ[R₀] e (AdjoinRoot.root f) := by
  classical

  have hy0 : aeval (e (AdjoinRoot.root f)) f = 0 := by
    rw [aeval_algEquiv, AlgHom.comp_apply, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self, map_zero]
  have hy : aeval ((1 : R) ⊗ₜ[R₀] e (AdjoinRoot.root f)) (f.map (algebraMap R₀ R)) = 0 := by
    have : ((1 : R) ⊗ₜ[R₀] e (AdjoinRoot.root f)) =
        (Algebra.TensorProduct.includeRight : A' →ₐ[R₀] R ⊗[R₀] A') (e (AdjoinRoot.root f)) := rfl
    rw [aeval_map_algebraMap, this, aeval_algHom_apply, hy0, map_zero]
  have hyφ : eval₂ (↑(Algebra.ofId R (R ⊗[R₀] A'))) ((1 : R) ⊗ₜ[R₀] e (AdjoinRoot.root f)) (f.map (algebraMap R₀ R)) = 0 := by
    rw [Algebra.toRingHom_ofId, ← aeval_def]; exact hy
  let φ : AdjoinRoot (f.map (algebraMap R₀ R)) →ₐ[R] R ⊗[R₀] A' :=
    AdjoinRoot.liftAlgHom _ (Algebra.ofId R _) ((1 : R) ⊗ₜ[R₀] e (AdjoinRoot.root f)) hyφ
  have hφroot : φ (AdjoinRoot.root _) = (1 : R) ⊗ₜ[R₀] e (AdjoinRoot.root f) := AdjoinRoot.liftAlgHom_root _ _ _ _

  have hx : eval₂ (↑(Algebra.ofId R₀ (AdjoinRoot (f.map (algebraMap R₀ R))))) (AdjoinRoot.root (f.map (algebraMap R₀ R))) f = 0 := by
    rw [Algebra.toRingHom_ofId, ← aeval_def, ← aeval_map_algebraMap R, AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
  let g₀ : AdjoinRoot f →ₐ[R₀] AdjoinRoot (f.map (algebraMap R₀ R)) := AdjoinRoot.liftAlgHom f (Algebra.ofId R₀ _) _ hx
  have hg₀root : g₀ (AdjoinRoot.root f) = AdjoinRoot.root _ := AdjoinRoot.liftAlgHom_root _ _ _ _
  let g : A' →ₐ[R₀] AdjoinRoot (f.map (algebraMap R₀ R)) := g₀.comp (e.symm : A' →ₐ[R₀] AdjoinRoot f)
  let ψ : R ⊗[R₀] A' →ₐ[R] AdjoinRoot (f.map (algebraMap R₀ R)) :=
    Algebra.TensorProduct.lift (Algebra.ofId R _) g (fun _ _ => Commute.all _ _)
  have hψ : ∀ (a : R) (b : A'), ψ (a ⊗ₜ[R₀] b) = algebraMap R _ a * g b := fun a b =>
    Algebra.TensorProduct.lift_tmul _ _ _ a b
  have hψφ : ψ.comp φ = AlgHom.id R _ := by
    apply AdjoinRoot.algHom_ext
    rw [AlgHom.comp_apply, hφroot, hψ, map_one, one_mul, AlgHom.id_apply]
    show g₀ (e.symm (e (AdjoinRoot.root f))) = _
    rw [e.symm_apply_apply, hg₀root]
  have hφψ : φ.comp ψ = AlgHom.id R _ := by
    apply Algebra.TensorProduct.ext'
    intro a b
    obtain ⟨x, rfl⟩ := e.surjective b
    rw [AlgHom.comp_apply, AlgHom.id_apply, hψ, map_mul, AlgHom.commutes, Algebra.TensorProduct.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply]

    have key : (φ.restrictScalars R₀).comp g₀ = Algebra.TensorProduct.includeRight.comp (e : AdjoinRoot f →ₐ[R₀] A') := by
      apply AdjoinRoot.algHom_ext
      rw [AlgHom.comp_apply, hg₀root, AlgHom.restrictScalars_apply, hφroot]
      rfl
    have key' : φ (g (e x)) = (1 : R) ⊗ₜ[R₀] e x := by
      have := congrArg (fun h : AdjoinRoot f →ₐ[R₀] R ⊗[R₀] A' => h x) key
      simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply] at this
      show φ (g₀ (e.symm (e x))) = _
      rw [e.symm_apply_apply, this]
      rfl
    rw [key', Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  refine ⟨AlgEquiv.ofAlgHom φ ψ hφψ hψφ, ?_⟩
  show φ (AdjoinRoot.root _) = _
  exact hφroot

theorem finite_iff_and_ncard_minimalPrimes_eq_of_ringEquiv
    (S S' : Type) [CommRing S] [CommRing S'] (e : S ≃+* S') :
    ((minimalPrimes S).Finite ↔ (minimalPrimes S').Finite) ∧ (minimalPrimes S).ncard = (minimalPrimes S').ncard := by
  classical
  have hmm' : ∀ I : Ideal S, Ideal.map (e.symm : S' →+* S) (Ideal.map (e : S →+* S') I) = I := fun I =>
    Ideal.map_of_equiv e
  have hm'm : ∀ J : Ideal S', Ideal.map (e : S →+* S') (Ideal.map (e.symm : S' →+* S) J) = J := fun J => by
    simpa using Ideal.map_of_equiv (I := J) e.symm
  have hmono : ∀ I J : Ideal S, Ideal.map (e : S →+* S') I ≤ Ideal.map (e : S →+* S') J ↔ I ≤ J := fun I J =>
    ⟨fun h => by
      have h' := Ideal.map_mono (f := (e.symm : S' →+* S)) h
      rwa [hmm', hmm'] at h', fun h => Ideal.map_mono h⟩
  have hmono' : ∀ I J : Ideal S', Ideal.map (e.symm : S' →+* S) I ≤ Ideal.map (e.symm : S' →+* S) J ↔ I ≤ J := fun I J =>
    ⟨fun h => by
      have h' := Ideal.map_mono (f := (e : S →+* S')) h
      rwa [hm'm, hm'm] at h', fun h => Ideal.map_mono h⟩
  have hprime : ∀ I : Ideal S, (Ideal.map (e : S →+* S') I).IsPrime ↔ I.IsPrime := fun I =>
    ⟨fun h => by rw [← hmm' I]; exact Ideal.map_isPrime_of_equiv e.symm, fun h => Ideal.map_isPrime_of_equiv e⟩
  have himage : Ideal.map (e : S →+* S') '' minimalPrimes S = minimalPrimes S' := by
    ext J
    rw [minimalPrimes_eq_minimals, minimalPrimes_eq_minimals]
    constructor
    · rintro ⟨I, hI, rfl⟩
      refine ⟨(hprime I).mpr hI.1, fun J' hJ' hle => ?_⟩
      have h1 : Ideal.map (e.symm : S' →+* S) J' ≤ I := by
        have := (hmono' _ _).mpr hle; rwa [hmm'] at this
      have h2 : (Ideal.map (e.symm : S' →+* S) J').IsPrime := Ideal.map_isPrime_of_equiv e.symm
      have h3 := hI.2 h2 h1
      have := (hmono _ _).mpr h3; rwa [hm'm] at this
    · intro hJ
      refine ⟨Ideal.map (e.symm : S' →+* S) J, ⟨?_, fun I hI hle => ?_⟩, hm'm J⟩
      · have := (hprime (Ideal.map (e.symm : S' →+* S) J)); rw [hm'm] at this; exact this.mp hJ.1
      · have h1 : Ideal.map (e : S →+* S') I ≤ J := by
          have := (hmono _ _).mpr hle; rwa [hm'm] at this
        have h3 := hJ.2 ((hprime I).mpr hI) h1
        have := (hmono' _ _).mpr h3; rwa [hmm'] at this
  have hinj : Set.InjOn (Ideal.map (e : S →+* S')) (minimalPrimes S) := fun I _ J _ h => by
    rw [← hmm' I, ← hmm' J]; exact congrArg _ h
  refine ⟨?_, ?_⟩
  · rw [← himage]; exact ⟨fun h => h.image _, fun h => Set.Finite.of_finite_image h hinj⟩
  · rw [← himage, hinj.ncard_image]

end CountUnr

