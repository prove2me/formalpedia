theorem len_phi : (descPhiN n).length ≤ 3 * IntMul.OpenAI.R129.dP n + 3 := by
  simp [descPhiN, descPhi, bitsZ]; omega

theorem len_line : (descLineN n).length ≤ 2 * IntMul.OpenAI.R129.dP n + 4 := by
  simp [descLineN, descLine, bitsZ]; omega

theorem len_chirp : (descChirpN n).length ≤ 2 * IntMul.OpenAI.R129.dP n + 5 := by
  have := len_line hn; simp [descChirpN]; omega

/-- The descriptor part of a call. -/
theorem descPart_le {l : List ℤ} (hl : l.length ≤ 3 * IntMul.OpenAI.R129.dP n + 5)
    (h : ∀ x ∈ l, 0 ≤ x ∧ x ≤ 2 ^ bP n) :
    3 * l.length * KFM.cMv (dzB l) ≤ 10 ^ 4 * (bP n + 1) ^ 2 := by
  have hz := dzB_le_of hn h
  have hdb := (setup_facts hn).2.2.1
  have hb := (setup_facts hn).1
  have : KFM.cMv (dzB l) ≤ 100 * (bP n + 2) := by
    unfold KFM.cMv; simp only [moveCost]; omega
  have h2 : l.length ≤ 3 * bP n + 5 := by omega
  calc 3 * l.length * KFM.cMv (dzB l) ≤ 3 * (3 * bP n + 5) * (100 * (bP n + 2)) :=
        Nat.mul_le_mul (Nat.mul_le_mul_left _ h2) this
    _ ≤ 10 ^ 4 * (bP n + 1) ^ 2 := by nlinarith

end Desc

theorem d_ge16 {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : 16 ≤ IntMul.OpenAI.R129.dP n := by
  obtain ⟨-, hdc, -, hd1, -⟩ := params_ok hn
  have hc0 : (0 : ℝ) < c := by unfold IntMul.OpenAI.R129.c; norm_num
  have hd0 : (0 : ℝ) ≤ IntMul.OpenAI.R129.dP n := by positivity
  have e : ((IntMul.OpenAI.R129.dP n : ℝ) ^ IntMul.OpenAI.R129.c) ^ IntMul.OpenAI.R129.c⁻¹ = IntMul.OpenAI.R129.dP n := Real.rpow_rpow_inv hd0 hc0.ne'
  have h1 : (2 : ℝ) ^ IntMul.OpenAI.R129.c⁻¹ ≤ ((IntMul.OpenAI.R129.dP n : ℝ) ^ IntMul.OpenAI.R129.c) ^ IntMul.OpenAI.R129.c⁻¹ :=
    Real.rpow_le_rpow (by norm_num) hdc (by positivity)
  rw [e] at h1
  have h2 : (2 : ℝ) ^ (4 : ℝ) ≤ (2 : ℝ) ^ IntMul.OpenAI.R129.c⁻¹ :=
    Real.rpow_le_rpow_of_exponent_le (by norm_num) (by unfold IntMul.OpenAI.R129.c; norm_num)
  have : (16 : ℝ) ≤ IntMul.OpenAI.R129.dP n := by
    have e2 : (2 : ℝ) ^ (4 : ℝ) = 16 := by norm_num
    linarith
  exact_mod_cast this

theorem ell_le {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : IntMul.OpenAI.R129.dP n * ℓP n ≤ 2 * bP n := by
  obtain ⟨-, -, -, hd1, -, -, -, -, -, -, -, hℓ, -⟩ := params_ok hn
  have hd : (0 : ℝ) < IntMul.OpenAI.R129.dP n := by have : (1 : ℝ) ≤ IntMul.OpenAI.R129.dP n := by exact_mod_cast hd1
                                                    linarith
  have h2 : (ℓP n : ℝ) * (3 * IntMul.OpenAI.R129.dP n) ≤ pP n := (le_div_iff₀ (by positivity)).1 hℓ
  have : ((3 * (IntMul.OpenAI.R129.dP n * ℓP n) : ℕ) : ℝ) ≤ ((6 * bP n : ℕ) : ℝ) := by
    push_cast; unfold pP at h2; push_cast at h2; linarith
  have := (Nat.cast_le (α := ℝ)).1 this
  omega

theorem r_le_T {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : (bP n + 1) ^ 3 * IntMul.OpenAI.R129.rP n ≤ IntMul.OpenAI.Glue.TP n := by
  have h16 := d_ge16 hn
  have hℓ := ell_le hn
  obtain ⟨hb, -⟩ := setup_facts hn
  obtain ⟨-, -, -, hbL⟩ := L_facts hn
  have h8 : 8 * ℓP n ≤ bP n := by nlinarith
