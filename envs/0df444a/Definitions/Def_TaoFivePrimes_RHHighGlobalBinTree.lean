import Mathlib
set_option autoImplicit false
namespace RHHighGlobalBinTree
inductive Tree where
  | leaf : List Nat→Tree
  | node : Nat→Tree→Tree→Tree
noncomputable def flatten : Tree→List Nat
  | .leaf xs => xs
  | .node _ l r => flatten l++flatten r
noncomputable def size : Tree→Nat
  | .leaf xs => xs.length
  | .node _ l r => size l+size r
noncomputable def valid : Tree→Bool
  | .leaf _ => true
  | .node n l r => decide (n=size l) && valid l && valid r
noncomputable def get (d : Nat) : Tree→Nat→Nat
  | .leaf xs,j => (xs[j]?).getD d
  | .node n l r,j => if j<n then get d l j else get d r (j-n)
lemma length_flatten (t : Tree) : (flatten t).length=size t := by
  induction t with
  | leaf xs => rfl
  | node n l r hl hr => simp only [flatten,List.length_append,size,hl,hr]
lemma get_sound (d : Nat) (t : Tree) (h : valid t=true) (j : Nat) :
    get d t j=((flatten t)[j]?).getD d := by
  induction t generalizing j with
  | leaf xs => rfl
  | node n l r hl hr =>
    simp only [valid,Bool.and_eq_true,decide_eq_true_eq] at h
    rcases h with ⟨⟨hn,hvl⟩,hvr⟩
    simp only [get,flatten]
    split_ifs with hj
    · rw [hl hvl,List.getElem?_append_left (by rw [length_flatten];omega)]
    · rw [hr hvr,List.getElem?_append_right (by rw [length_flatten];omega)]
      simp only [length_flatten,←hn]
