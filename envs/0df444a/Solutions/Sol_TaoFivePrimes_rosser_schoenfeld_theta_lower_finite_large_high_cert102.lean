theorem walk_sound (C N Cb j bb lo Y : ℕ) (hY : (C : ℝ) / 2 ^ 40 ≤ Real.log Y) (hY0 : 0 < Y) :
    ∀ (l : List (ℕ × ℕ)) (m c e : ℕ), walk C N Cb j bb lo m c e l = true →
