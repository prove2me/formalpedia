/-- Local version of `A83IFT.isSplitSubmanifold_of_preimage`: the level-set description only
needs to hold on an open neighbourhood of each point. -/
theorem isSplitSubmanifold_of_local_preimage (M : Set E)
    (h : ∀ x ∈ M, ∃ (Ψ : E → E) (_ : ContDiff ℝ ∞ Ψ) (F : Submodule ℝ E) (_ : F.ClosedComplemented)
      (V : Set E) (_ : IsOpen V) (_ : x ∈ V) (_ : ∀ z ∈ V, z ∈ M ↔ Ψ z ∈ F)
      (e : E ≃L[ℝ] E), HasFDerivAt Ψ (e : E →L[ℝ] E) x) :
    IsSplitSubmanifold M := by
  intro x hx
  obtain ⟨Ψ, hΨ, F, hF, V, hV, hxV, hM, e, he⟩ := h x hx
  have hn : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hdiff : Differentiable ℝ Ψ := hΨ.differentiable (by simp)
  set U : Set E := (fderiv ℝ Ψ) ⁻¹' Set.range ((↑) : (E ≃L[ℝ] E) → E →L[ℝ] E) ∩ V with hUdef
  have hU : IsOpen U :=
    (ContinuousLinearEquiv.isOpen.preimage (hΨ.continuous_fderiv (by simp))).inter hV
  have hxU : x ∈ U := ⟨⟨e, he.fderiv.symm⟩, hxV⟩
  let φ0 := (hΨ.contDiffAt (x := x)).toOpenPartialHomeomorph Ψ he hn
  let φ := φ0.restrOpen U hU
  have hφ : ∀ z, φ z = Ψ z := fun z => rfl
  have hsrc : φ.source = φ0.source ∩ U := φ0.restrOpen_source U hU
  refine ⟨F, hF, φ, ?_, ?_, ?_, ?_⟩
  · rw [hsrc]
    exact ⟨(hΨ.contDiffAt (x := x)).mem_toOpenPartialHomeomorph_source he hn, hxU⟩
  · exact (show ContDiffOn ℝ ∞ Ψ φ.source from hΨ.contDiffOn)
  · intro y hy
    have hs : φ.symm y ∈ φ.source := φ.map_target hy
    rw [hsrc] at hs
    obtain ⟨e', he'⟩ := hs.2.1
    have hfd : HasFDerivAt φ (e' : E →L[ℝ] E) (φ.symm y) := by
      have := (hdiff (φ.symm y)).hasFDerivAt
      rw [← he'] at this
      exact this
    exact (φ.contDiffAt_symm hy hfd (hΨ.contDiffAt)).contDiffWithinAt
  · ext w
    constructor
    · rintro ⟨z, ⟨hzM, hzs⟩, rfl⟩
      have hzV : z ∈ V := by
        have h' := hzs
        rw [hsrc] at h'
        exact h'.2.2
      exact ⟨(hM z hzV).1 hzM, φ.map_source hzs⟩
    · rintro ⟨hwF, hwt⟩
      have hs : φ.symm w ∈ φ.source := φ.map_target hwt
      have hsV : φ.symm w ∈ V := by
        have h' := hs
        rw [hsrc] at h'
        exact h'.2.2
      refine ⟨φ.symm w, ⟨(hM _ hsV).2 ?_, hs⟩, φ.right_inv hwt⟩
      rw [← hφ, φ.right_inv hwt]
      exact hwF

/-- The derivative of a `C^1` idempotent map at a fixed point is idempotent. -/
theorem fderiv_idem (R : E → E) (hR : ContDiff ℝ ∞ R) (hRR : ∀ x, R (R x) = R x) {x : E}
    (hx : R x = x) (v : E) : fderiv ℝ R x (fderiv ℝ R x v) = fderiv ℝ R x v := by
  have hd : Differentiable ℝ R := hR.differentiable (by simp)
  have h1 : HasFDerivAt (R ∘ R) ((fderiv ℝ R (R x)).comp (fderiv ℝ R x)) x :=
    (hd (R x)).hasFDerivAt.comp x (hd x).hasFDerivAt
  have h2 : R ∘ R = R := funext hRR
  rw [h2, hx] at h1
  have h3 := h1.unique (hd x).hasFDerivAt
  exact congrArg (fun T : E →L[ℝ] E => T v) h3

/-- Fixed points of a `C^∞` retraction form a split submanifold. -/
theorem isSplitSubmanifold_fix (R : E → E) (hR : ContDiff ℝ ∞ R) (hRR : ∀ x, R (R x) = R x) :
    IsSplitSubmanifold {x | R x = x} := by
  refine isSplitSubmanifold_of_local_preimage _ fun x0 hx0 => ?_
  have hx0' : R x0 = x0 := hx0
  set P : E →L[ℝ] E := fderiv ℝ R x0 with hPdef
  have hP : ∀ v, P (P v) = P v := fderiv_idem R hR hRR hx0'
  have hQP : ∀ v, (ContinuousLinearMap.id ℝ E - P) (P v) = 0 := fun v => by
    rw [ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply, hP, sub_self]
  have hQQ : ∀ v, (ContinuousLinearMap.id ℝ E - P) ((ContinuousLinearMap.id ℝ E - P) v) =
      (ContinuousLinearMap.id ℝ E - P) v := fun v => by
    simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply, map_sub, hP, sub_self,
      sub_zero]
  have hd : Differentiable ℝ R := hR.differentiable (by simp)
  have hs : HasStrictFDerivAt R P x0 := hR.contDiffAt.hasStrictFDerivAt (by simp)
  have hev : ∀ᶠ p in 𝓝 (x0, x0), ‖R p.1 - R p.2 - P (p.1 - p.2)‖ ≤ (1 / 2 : ℝ) * ‖p.1 - p.2‖ :=
    hs.isLittleO.def (by norm_num)
  have htend : Tendsto (fun y => (y, R y)) (𝓝 x0) (𝓝 (x0, x0)) := by
    have := (continuous_id.prodMk hR.continuous).tendsto x0
    simp only [id_eq] at this
    rwa [hx0'] at this
  obtain ⟨V, hVsub, hVo, hxV⟩ := mem_nhds_iff.1 (htend.eventually hev)
  refine ⟨fun y => P (R y) + (ContinuousLinearMap.id ℝ E - P) (y - R y), ?_,
    LinearMap.ker ((ContinuousLinearMap.id ℝ E - P : E →L[ℝ] E) : E →ₗ[ℝ] E),
    A83Graph.closedComplemented_fix P hP, V, hVo, hxV, ?_, ContinuousLinearEquiv.refl ℝ E, ?_⟩
  · exact (P.contDiff.comp hR).add ((ContinuousLinearMap.id ℝ E - P).contDiff.comp
      (contDiff_id.sub hR))
  · intro z hzV
    simp only [Set.mem_setOf_eq, LinearMap.mem_ker, ContinuousLinearMap.coe_coe]
    rw [map_add, hQP, zero_add, hQQ]
    constructor
    · intro h
      rw [h, sub_self, map_zero]
    · intro h
      rw [ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply] at h
      have hu : P (z - R z) = z - R z := (sub_eq_zero.1 h).symm
      have hb : ‖R z - R (R z) - P (z - R z)‖ ≤ (1 / 2 : ℝ) * ‖z - R z‖ := hVsub hzV
      rw [hRR, sub_self, zero_sub, norm_neg, hu] at hb
      have h0 : ‖z - R z‖ = 0 := by linarith [norm_nonneg (z - R z)]
      exact (sub_eq_zero.1 (norm_eq_zero.1 h0)).symm
  · have h1 : HasFDerivAt (fun y => P (R y)) (P.comp P) x0 :=
      P.hasFDerivAt.comp x0 (hd x0).hasFDerivAt
    have h2 : HasFDerivAt (fun y => (ContinuousLinearMap.id ℝ E - P) (y - R y))
        ((ContinuousLinearMap.id ℝ E - P).comp (ContinuousLinearMap.id ℝ E - P)) x0 :=
      (ContinuousLinearMap.id ℝ E - P).hasFDerivAt.comp x0 ((hasFDerivAt_id x0).sub (hd x0).hasFDerivAt)
    have h3 := h1.add h2
    have e : ((ContinuousLinearEquiv.refl ℝ E : E ≃L[ℝ] E) : E →L[ℝ] E) =
        P.comp P + (ContinuousLinearMap.id ℝ E - P).comp (ContinuousLinearMap.id ℝ E - P) := by
      ext v
      show v = P (P v) + (ContinuousLinearMap.id ℝ E - P) ((ContinuousLinearMap.id ℝ E - P) v)
      rw [hQQ, hP, ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply]
      abel
    rw [e]
    exact h3

end IntLInfty.Kan.A83Fix

/-! R29 (RelHorn route, part 2): local versions. A set is a split submanifold iff it is locally
a `C^∞` retract (only the two directions needed below). -/
namespace IntLInfty.Kan.A83Fix

open IntLInfty.Kan Filter Topology
open scoped ContDiff

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- `isSplitSubmanifold_of_local_preimage` with `Ψ` only smooth on the open set `V`. -/
theorem isSplitSubmanifold_of_local_preimage' (M : Set E)
    (h : ∀ x ∈ M, ∃ (V : Set E) (_ : IsOpen V) (_ : x ∈ V) (Ψ : E → E) (_ : ContDiffOn ℝ ∞ Ψ V)
      (F : Submodule ℝ E) (_ : F.ClosedComplemented) (_ : ∀ z ∈ V, z ∈ M ↔ Ψ z ∈ F)
      (e : E ≃L[ℝ] E), HasFDerivAt Ψ (e : E →L[ℝ] E) x) :
    IsSplitSubmanifold M := by
  intro x hx
  obtain ⟨V, hV, hxV, Ψ, hΨ, F, hF, hM, e, he⟩ := h x hx
  have hn : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hΨx : ContDiffAt ℝ ∞ Ψ x := hΨ.contDiffAt (hV.mem_nhds hxV)
  have hcf : ContinuousOn (fderiv ℝ Ψ) V := hΨ.continuousOn_fderiv_of_isOpen hV (by simp)
  set U : Set E := V ∩ (fderiv ℝ Ψ) ⁻¹' Set.range ((↑) : (E ≃L[ℝ] E) → E →L[ℝ] E) with hUdef
  have hU : IsOpen U := hcf.isOpen_inter_preimage hV ContinuousLinearEquiv.isOpen
  have hxU : x ∈ U := ⟨hxV, ⟨e, he.fderiv.symm⟩⟩
  let φ0 := hΨx.toOpenPartialHomeomorph Ψ he hn
  let φ := φ0.restrOpen U hU
  have hφ : ∀ z, φ z = Ψ z := fun z => rfl
  have hsrc : φ.source = φ0.source ∩ U := φ0.restrOpen_source U hU
  have hsV : φ.source ⊆ V := fun z hz => by
    rw [hsrc] at hz
    exact hz.2.1
  refine ⟨F, hF, φ, ?_, ?_, ?_, ?_⟩
  · rw [hsrc]
    exact ⟨hΨx.mem_toOpenPartialHomeomorph_source he hn, hxU⟩
  · exact (show ContDiffOn ℝ ∞ Ψ φ.source from hΨ.mono hsV)
  · intro y hy
    have hs : φ.symm y ∈ φ.source := φ.map_target hy
    have hs' := hs
    rw [hsrc] at hs'
    obtain ⟨e', he'⟩ := hs'.2.2
    have hΨy : ContDiffAt ℝ ∞ Ψ (φ.symm y) := hΨ.contDiffAt (hV.mem_nhds hs'.2.1)
    have hfd : HasFDerivAt φ (e' : E →L[ℝ] E) (φ.symm y) := by
      have := (hΨy.differentiableAt (by simp)).hasFDerivAt
      rw [← he'] at this
      exact this
    exact (φ.contDiffAt_symm hy hfd hΨy).contDiffWithinAt
  · ext w
    constructor
    · rintro ⟨z, ⟨hzM, hzs⟩, rfl⟩
      exact ⟨(hM z (hsV hzs)).1 hzM, φ.map_source hzs⟩
    · rintro ⟨hwF, hwt⟩
      have hs : φ.symm w ∈ φ.source := φ.map_target hwt
      refine ⟨φ.symm w, ⟨(hM _ (hsV hs)).2 ?_, hs⟩, φ.right_inv hwt⟩
      rw [← hφ, φ.right_inv hwt]
      exact hwF

/-- A set which is, near each of its points, the image of a `C^∞` local retraction is a split
submanifold. -/
theorem isSplitSubmanifold_of_local_retract (M : Set E)
    (h : ∀ x ∈ M, ∃ (V : Set E) (_ : IsOpen V) (_ : x ∈ V) (R : E → E) (_ : ContDiffOn ℝ ∞ R V),
      (∀ z ∈ V, R z ∈ M) ∧ (∀ z ∈ V, z ∈ M → R z = z)) :
    IsSplitSubmanifold M := by
  refine isSplitSubmanifold_of_local_preimage' _ fun x0 hx0 => ?_
  obtain ⟨V, hV, hx0V, R, hR, hRM, hRid⟩ := h x0 hx0
  have hx0' : R x0 = x0 := hRid x0 hx0V hx0
  have hRc : ContinuousOn R V := hR.continuousOn
  have hRx : ContDiffAt ℝ ∞ R x0 := hR.contDiffAt (hV.mem_nhds hx0V)
  have hdx : DifferentiableAt ℝ R x0 := hRx.differentiableAt (by simp)
  set W : Set E := V ∩ R ⁻¹' V with hWdef
  have hW : IsOpen W := hRc.isOpen_inter_preimage hV hV
  have hx0W : x0 ∈ W := ⟨hx0V, by simp only [Set.mem_preimage, hx0']; exact hx0V⟩
  have hRR : ∀ z ∈ W, R (R z) = R z := fun z hz => hRid (R z) hz.2 (hRM z hz.1)
  set P : E →L[ℝ] E := fderiv ℝ R x0 with hPdef
  have hP : ∀ v, P (P v) = P v := by
    have hdRx : HasFDerivAt R P (R x0) := by
      rw [hx0']
      exact hdx.hasFDerivAt
    have h1 : HasFDerivAt (R ∘ R) (P.comp P) x0 := hdRx.comp x0 hdx.hasFDerivAt
    have hev : R =ᶠ[𝓝 x0] R ∘ R :=
      Filter.eventually_of_mem (hW.mem_nhds hx0W) fun z hz => (hRR z hz).symm
    have h2 : HasFDerivAt R (P.comp P) x0 := h1.congr_of_eventuallyEq hev
    have h3 := h2.unique hdx.hasFDerivAt
    exact fun v => congrArg (fun T : E →L[ℝ] E => T v) h3
  have hQP : ∀ v, (ContinuousLinearMap.id ℝ E - P) (P v) = 0 := fun v => by
    rw [ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply, hP, sub_self]
  have hQQ : ∀ v, (ContinuousLinearMap.id ℝ E - P) ((ContinuousLinearMap.id ℝ E - P) v) =
      (ContinuousLinearMap.id ℝ E - P) v := fun v => by
    simp only [ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply, map_sub, hP, sub_self,
      sub_zero]
  have hs : HasStrictFDerivAt R P x0 := hRx.hasStrictFDerivAt (by simp)
  have hev : ∀ᶠ p in 𝓝 (x0, x0), ‖R p.1 - R p.2 - P (p.1 - p.2)‖ ≤ (1 / 2 : ℝ) * ‖p.1 - p.2‖ :=
    hs.isLittleO.def (by norm_num)
  have htend : Tendsto (fun y => (y, R y)) (𝓝 x0) (𝓝 (x0, x0)) := by
    have := (continuousAt_id.prodMk hdx.continuousAt).tendsto
    simp only [id_eq] at this
    rwa [hx0'] at this
  obtain ⟨V', hV'sub, hV'o, hxV'⟩ := mem_nhds_iff.1
    ((htend.eventually hev).and (hW.mem_nhds hx0W))
  have hV'W : ∀ z ∈ V', z ∈ W := fun z hz => (hV'sub hz).2
  refine ⟨V', hV'o, hxV', fun y => P (R y) + (ContinuousLinearMap.id ℝ E - P) (y - R y), ?_,
    LinearMap.ker ((ContinuousLinearMap.id ℝ E - P : E →L[ℝ] E) : E →ₗ[ℝ] E),
    A83Graph.closedComplemented_fix P hP, ?_, ContinuousLinearEquiv.refl ℝ E, ?_⟩
  · exact ((P.contDiff.comp_contDiffOn hR).add ((ContinuousLinearMap.id ℝ E - P).contDiff.comp_contDiffOn
      (contDiffOn_id.sub hR))).mono fun z hz => (hV'W z hz).1
  · intro z hzV
    have hzW := hV'W z hzV
    simp only [LinearMap.mem_ker, ContinuousLinearMap.coe_coe]
    rw [map_add, hQP, zero_add, hQQ]
    constructor
    · intro hzM
      rw [hRid z hzW.1 hzM, sub_self, map_zero]
    · intro h
      rw [ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply] at h
      have hu : P (z - R z) = z - R z := (sub_eq_zero.1 h).symm
      have hb : ‖R z - R (R z) - P (z - R z)‖ ≤ (1 / 2 : ℝ) * ‖z - R z‖ := (hV'sub hzV).1
      rw [hRR z hzW, sub_self, zero_sub, norm_neg, hu] at hb
      have h0 : ‖z - R z‖ = 0 := by linarith [norm_nonneg (z - R z)]
      have hzR : z = R z := sub_eq_zero.1 (norm_eq_zero.1 h0)
      rw [hzR]
      exact hRM z hzW.1
  · have h1 : HasFDerivAt (fun y => P (R y)) (P.comp P) x0 :=
      P.hasFDerivAt.comp x0 hdx.hasFDerivAt
    have h2 : HasFDerivAt (fun y => (ContinuousLinearMap.id ℝ E - P) (y - R y))
        ((ContinuousLinearMap.id ℝ E - P).comp (ContinuousLinearMap.id ℝ E - P)) x0 :=
      (ContinuousLinearMap.id ℝ E - P).hasFDerivAt.comp x0 ((hasFDerivAt_id x0).sub hdx.hasFDerivAt)
    have h3 := h1.add h2
    have e : ((ContinuousLinearEquiv.refl ℝ E : E ≃L[ℝ] E) : E →L[ℝ] E) =
        P.comp P + (ContinuousLinearMap.id ℝ E - P).comp (ContinuousLinearMap.id ℝ E - P) := by
      ext v
      show v = P (P v) + (ContinuousLinearMap.id ℝ E - P) ((ContinuousLinearMap.id ℝ E - P) v)
      rw [hQQ, hP, ContinuousLinearMap.sub_apply, ContinuousLinearMap.id_apply]
      abel
    rw [e]
    exact h3

/-- Conversely, a split submanifold is locally a `C^∞` retract (chart, projection, chart⁻¹). -/
theorem local_retract_of_split {M : Set E} (hM : IsSplitSubmanifold M) (x : E) (hx : x ∈ M) :
    ∃ (V : Set E) (_ : IsOpen V) (_ : x ∈ V) (R : E → E) (_ : ContDiffOn ℝ ∞ R V),
      (∀ z ∈ V, R z ∈ M) ∧ (∀ z ∈ V, z ∈ M → R z = z) := by
  obtain ⟨F, ⟨π, hπ⟩, φ, hxs, hφ, hφs, himg⟩ := hM x hx
  set π' : E →L[ℝ] E := F.subtypeL.comp π with hπ'
  have hπF : ∀ y ∈ F, π' y = y := fun y hy => by
    show ((π y : F) : E) = y
    rw [show y = ((⟨y, hy⟩ : F) : E) from rfl, hπ]
  have hπmem : ∀ y, π' y ∈ F := fun y => (π y).2
  have hmemF : ∀ z ∈ M, z ∈ φ.source → φ z ∈ F := fun z hz hzs => by
    have : φ z ∈ φ '' (M ∩ φ.source) := ⟨z, ⟨hz, hzs⟩, rfl⟩
    rw [himg] at this
    exact this.1
  set V : Set E := φ.source ∩ φ ⁻¹' (π' ⁻¹' φ.target) with hVdef
  have hV : IsOpen V :=
    φ.continuousOn.isOpen_inter_preimage φ.open_source (φ.open_target.preimage π'.continuous)
  have hxV : x ∈ V := ⟨hxs, by
    show π' (φ x) ∈ φ.target
    rw [hπF _ (hmemF x hx hxs)]
    exact φ.map_source hxs⟩
  refine ⟨V, hV, hxV, fun z => φ.symm (π' (φ z)), ?_, fun z hz => ?_, fun z hz hzM => ?_⟩
  · exact hφs.comp ((π'.contDiff.comp_contDiffOn hφ).mono fun z hz => hz.1) fun z hz => hz.2
  · have h1 : π' (φ z) ∈ φ '' (M ∩ φ.source) := by
      rw [himg]
      exact ⟨hπmem _, hz.2⟩
    obtain ⟨w, ⟨hwM, hws⟩, hw⟩ := h1
    show φ.symm (π' (φ z)) ∈ M
    rw [← hw, φ.left_inv hws]
    exact hwM
  · show φ.symm (π' (φ z)) = z
    rw [hπF _ (hmemF z hzM hz.1), φ.left_inv hz.1]

end IntLInfty.Kan.A83Fix

/-! R29 (RelHorn route, part 3): the target of a smooth map with global smooth fillers out of a
split submanifold is a split submanifold. Instance: `RelHorn` = target of `kanMap`. -/
namespace IntLInfty.Kan.A83Fix

open IntLInfty.Kan Filter Topology
open scoped ContDiff

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
  {G : Type} [NormedAddCommGroup G] [NormedSpace ℝ G] [CompleteSpace G]

theorem isSplitSubmanifold_of_filler (κ : E → G) (hκ : ContDiff ℝ ∞ κ) (M : Set E) (N : Set G)
    (hM : IsSplitSubmanifold M) (hmaps : Set.MapsTo κ M N) (hne : M.Nonempty)
    (σ : E → G → E) (hσ : ∀ x ∈ M, ContDiff ℝ ∞ (σ x))
    (hσM : ∀ x ∈ M, ∀ y ∈ N, σ x y ∈ M ∧ κ (σ x y) = y) :
    IsSplitSubmanifold N := by
  refine isSplitSubmanifold_of_local_retract N fun y0 hy0 => ?_
  obtain ⟨x1, hx1⟩ := hne
  set x0 := σ x1 y0 with hx0def
  have hx0M : x0 ∈ M := (hσM x1 hx1 y0 hy0).1
  have hκx0 : κ x0 = y0 := (hσM x1 hx1 y0 hy0).2
  obtain ⟨V, hV, hx0V, Rm, hRm, hRmM, hRmid⟩ := local_retract_of_split hM x0 hx0M
  refine ⟨σ x1 ⁻¹' V, hV.preimage (hσ x1 hx1).continuous, hx0V, fun y => κ (Rm (σ x1 y)), ?_,
    fun y hy => hmaps (hRmM _ hy), fun y hy hyN => ?_⟩
  · exact hκ.comp_contDiffOn (hRm.comp (hσ x1 hx1).contDiffOn fun y hy => hy)
  · show κ (Rm (σ x1 y)) = y
    rw [hRmid _ hy (hσM x1 hx1 y hyN).1, (hσM x1 hx1 y hyN).2]

end IntLInfty.Kan.A83Fix

/-! R29: assembly of `IsKanFibration` from global smooth fillers of `kanMap` (RelHorn split via
`A83Fix.isSplitSubmanifold_of_filler`, surjective submersion via `A83Graph.isSurjSubmersionOn_of_filler`). -/
namespace IntLInfty.Kan.A83Kan

open IntLInfty.Kan
open scoped ContDiff

variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]

theorem isKanFibration_of_filler {r : ℕ} (δ : LInfty L) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i)
    (hS : ∀ m, IsSplitSubmanifold (integ r δ S m)) (hS' : ∀ m, IsSplitSubmanifold (integ r δ S' m))
    (hκ : ∀ m (j : Fin (m + 2)), ContDiff ℝ ∞ (kanMap (r := r) h m j))
    (hmaps : ∀ m (j : Fin (m + 2)),
      Set.MapsTo (kanMap h m j) (integ r δ S (m + 1)) (RelHorn r δ h m j))
    (hne : ∀ m, (integ r δ S (m + 1)).Nonempty)
    (σ : ∀ m (j : Fin (m + 2)), Amb r S (m + 1) →
      (({i : Fin (m + 2) // i ≠ j} → Amb r S m) × Amb r S' (m + 1)) → Amb r S (m + 1))
    (hσ : ∀ m j x, ContDiff ℝ ∞ (σ m j x))
    (hσM : ∀ m j, ∀ x ∈ integ r δ S (m + 1), ∀ y ∈ RelHorn r δ h m j,
      σ m j x y ∈ integ r δ S (m + 1) ∧ kanMap h m j (σ m j x y) = y)
    (hσx : ∀ m j, ∀ x ∈ integ r δ S (m + 1), σ m j x (kanMap h m j x) = x) :
    IsKanFibration r δ S S' := by
  refine ⟨h, hS, hS', fun m j => ?_⟩
  haveI := A83H.amb_complete (r := r) (m := m) S
  haveI := A83H.amb_complete (r := r) (m := m + 1) S
  haveI := A83H.amb_complete (r := r) (m := m + 1) S'
  exact ⟨A83Fix.isSplitSubmanifold_of_filler (kanMap h m j) (hκ m j) _ _ (hS (m + 1)) (hmaps m j)
      (hne m) (σ m j) (fun x _ => hσ m j x) (hσM m j),
    A83Graph.isSurjSubmersionOn_of_filler (kanMap h m j) _ _ (hmaps m j) (fun _ => hne m) (σ m j)
      (hσ m j) (hσM m j) (hσx m j)⟩

end IntLInfty.Kan.A83Kan

/-! R30: inputs (1)-(3) of `A83Kan.isKanFibration_of_filler`: `kanMap` is a continuous linear map
(hence `C^∞`), it maps `∫_S` into `RelHorn`, and `0 ∈ ∫_S` (augmentation `CE L → ℝ`). -/
namespace IntLInfty.Kan.A83KM

open IntLInfty.Kan IntLInfty.Kan.A83
open scoped ContDiff

variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]

/-- `dᵢ` on the ambient space as a continuous linear map. -/
noncomputable def faceAmbCLM {r : ℕ} (hr : 1 ≤ r) (S : GenSys L) (m : ℕ) (i : Fin (m + 2)) :
    Amb r S (m + 1) →L[ℝ] Amb r S m where
  toFun := faceAmb r S m i
  map_add' z w := funext fun t => funext fun k =>
    map_add (faceLin hr ((t : ℕ) + 1) i) (z t.castSucc k) (w t.castSucc k)
  map_smul' c z := funext fun t => funext fun k =>
    map_smul (faceLin hr ((t : ℕ) + 1) i) c (z t.castSucc k)
  cont := continuous_pi fun t => continuous_pi fun k =>
    (faceLin_continuous hr ((t : ℕ) + 1) i).comp
      ((continuous_apply k).comp (continuous_apply (Fin.castSucc t)))

/-- `res` as a continuous linear map. -/
noncomputable def resCLM {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (r m : ℕ) :
    Amb r S m →L[ℝ] Amb r S' m where
  toFun := res h
  map_add' z w := funext fun t => funext fun k => by
    show ∑ l, _ • (z + w) t l = (∑ l, _ • z t l) + ∑ l, _ • w t l
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun l _ => smul_add _ _ _
  map_smul' c z := funext fun t => funext fun k => by
    show ∑ l, _ • (c • z) t l = c • ∑ l, _ • z t l
    rw [Finset.smul_sum]
    exact Finset.sum_congr rfl fun l _ => smul_comm (_ : ℝ) c (z t l)
  cont := continuous_pi fun t => continuous_pi fun k =>
    continuous_finset_sum _ fun l _ =>
      (continuous_const_smul ((genBasis S t).repr (Submodule.inclusion (h t) (genBasis S' t k)) l)).comp
        ((continuous_apply l).comp (continuous_apply t))

/-- (1) `kanMap` is `C^∞`. -/
theorem kanMap_contDiff {r : ℕ} (hr : 1 ≤ r) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (m : ℕ)
    (j : Fin (m + 2)) : ContDiff ℝ ∞ (kanMap (r := r) h m j) := by
  unfold kanMap
  refine ContDiff.prodMk (contDiff_pi.2 fun i => ?_) ?_
  · exact (faceAmbCLM hr S m i.1).contDiff
  · exact (resCLM h r (m + 1)).contDiff

theorem faceAmb_res {r : ℕ} (hr : 1 ≤ r) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (m : ℕ)
    (i : Fin (m + 2)) (z : Amb r S (m + 1)) :
    faceAmb r S' m i (res h z) = res h (faceAmb r S m i z) := by
  funext t k
  show faceLin hr ((t : ℕ) + 1) i (∑ l, _ • z t.castSucc l) =
    ∑ l, _ • faceLin hr ((t : ℕ) + 1) i (z t.castSucc l)
  rw [map_sum]
  exact Finset.sum_congr rfl fun l _ => map_smul _ _ _

theorem hornCompat_faceAmb {r : ℕ} (hr : 1 ≤ r) (S : GenSys L) (m : ℕ) (j : Fin (m + 2))
    (z : Amb r S (m + 1)) :
    HornCompat (fun q => faceAmb r S q) m j (fun i => faceAmb r S m i.1 z) := by
  cases m with
  | zero => trivial
  | succ q =>
    intro a b hab ha hb
    funext t k
    exact faceCr_faceCr hr hab (z (Fin.castSucc (Fin.castSucc t)) k)

/-- The face pull-back as an algebra map. -/
noncomputable def pullAlg (m : ℕ) (i : Fin (m + 2)) : Ω (m + 1) →ₐ[ℝ] Ω m where
  toFun := pull m i
  map_one' := funext fun _ => map_one (ExteriorAlgebra.map (cofaceLin m i).dualMap)
  map_mul' a b := funext fun x =>
    map_mul (ExteriorAlgebra.map (cofaceLin m i).dualMap) (a (coface m i x)) (b (coface m i x))
  map_zero' := funext fun _ => map_zero (ExteriorAlgebra.map (cofaceLin m i).dualMap)
  map_add' a b := funext fun x =>
    map_add (ExteriorAlgebra.map (cofaceLin m i).dualMap) (a (coface m i x)) (b (coface m i x))
  commutes' c := funext fun _ => (ExteriorAlgebra.map (cofaceLin m i).dualMap).commutes c

theorem faceAmb_mem_integ {r : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (m : ℕ)
    (i : Fin (m + 2)) {z : Amb r S (m + 1)} (hz : z ∈ integ r δ S (m + 1)) :
    faceAmb r S m i z ∈ integ r δ S m := by
  obtain ⟨φ, ⟨hdeg, hcr, hd⟩, hzφ⟩ := hz
  refine ⟨(pullAlg m i).comp φ, ⟨fun t ξ hξ => pull_isDeg i (hdeg t ξ hξ),
    fun a => pull_isCr hr i (hcr a), fun a b hab x hx => ?_⟩, fun t k => ?_⟩
  · show extD (pull m i (φ a)) x = pull m i (φ b) x
    rw [extD_pull hr i (fun I => (hcr a I).1) hx]
    show ExteriorAlgebra.map _ (extD (φ a) (coface m i x)) =
      ExteriorAlgebra.map _ (φ b (coface m i x))
    rw [hd a b hab _ (coface_mem i hx)]
  · exact faceCr_val hr i _ (hdeg _ _ (genBasis S t.castSucc k).2) (hcr _) (hzφ t.castSucc k).symm

theorem genAlg_mono {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) : genAlg L S' ≤ genAlg L S :=
  Algebra.adjoin_mono (Set.iUnion_mono fun i => Set.image_mono (h i))

noncomputable def jetLin {r m : ℕ} (hr : 1 ≤ r) {S : GenSys L} (φ : genAlg L S →ₐ[ℝ] Ω m)
    (hcr : ∀ a, IsCr r (φ a)) : genAlg L S →ₗ[ℝ] Jet r m × Jet r m where
  toFun a := jet r (φ a)
  map_add' a b := by rw [map_add]; exact jet_add hr (hcr a) (hcr b)
  map_smul' c a := by rw [map_smul]; exact jet_smul hr c (hcr a)

theorem jetLin_apply {r m : ℕ} (hr : 1 ≤ r) {S : GenSys L} (φ : genAlg L S →ₐ[ℝ] Ω m)
    (hcr : ∀ a, IsCr r (φ a)) (a : genAlg L S) : jetLin hr φ hcr a = jet r (φ a) := rfl

theorem gen_expand {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (t : ℕ)
    (k : Fin (Module.finrank ℝ (S' t))) :
    (⟨gen L t (genBasis S' t k), gen_mem_genAlg S (h t (genBasis S' t k).2)⟩ : genAlg L S) =
      ∑ l, (genBasis S t).repr (Submodule.inclusion (h t) (genBasis S' t k)) l •
        (⟨gen L t (genBasis S t l), gen_mem_genAlg S (genBasis S t l).2⟩ : genAlg L S) := by
  have e1 : ((genBasis S' t k : S' t) : Module.Dual ℝ (L t)) =
      ∑ l, (genBasis S t).repr (Submodule.inclusion (h t) (genBasis S' t k)) l •
        ((genBasis S t l : S t) : Module.Dual ℝ (L t)) := by
    have := congrArg (fun v : S t => (v : Module.Dual ℝ (L t)))
      ((genBasis S t).sum_repr (Submodule.inclusion (h t) (genBasis S' t k)))
    simp only [Submodule.coe_sum, Submodule.coe_smul] at this
    exact this.symm
  apply Subtype.ext
  rw [AddSubmonoidClass.coe_finset_sum]
  simp only [SetLike.val_smul]
  rw [e1, map_sum]
  simp only [map_smul]

theorem res_coe {r m : ℕ} {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (z : Amb r S m) (t : Fin m)
    (k : Fin (Module.finrank ℝ (S' t))) :
    (res h z t k : Jet r m × Jet r m) =
      ∑ l, (genBasis S t).repr (Submodule.inclusion (h t) (genBasis S' t k)) l •
        (z t l : Jet r m × Jet r m) := by
  show ((∑ l, _ • z t l : CrForms r m (t + 1)) : Jet r m × Jet r m) = _
  rw [Submodule.coe_sum]
  simp only [Submodule.coe_smul]

theorem isDGAMap_restrict {r m : ℕ} (δ : LInfty L) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i)
    {φ : genAlg L S →ₐ[ℝ] Ω m} (hφ : IsDGAMap r δ S m φ) :
    IsDGAMap r δ S' m (φ.comp (Subalgebra.inclusion (genAlg_mono h))) := by
  obtain ⟨hdeg, hcr, hd⟩ := hφ
  refine ⟨fun t ξ hξ => ?_, fun a => ?_, fun a b hab x hx => ?_⟩
  · rw [AlgHom.comp_apply, Subalgebra.inclusion_mk]
    exact hdeg t ξ (h t hξ)
  · rw [AlgHom.comp_apply]
    exact hcr _
  · rw [AlgHom.comp_apply, AlgHom.comp_apply]
    refine hd _ _ ?_ x hx
    rw [Subalgebra.coe_inclusion, Subalgebra.coe_inclusion]
    exact hab

set_option maxHeartbeats 4000000 in
theorem res_mem_integ {r : ℕ} (hr : 1 ≤ r) (δ : LInfty L) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i)
    (m : ℕ) {z : Amb r S m} (hz : z ∈ integ r δ S m) : res h z ∈ integ r δ S' m := by
  obtain ⟨φ, hφ, hzφ⟩ := hz
  have hcr := hφ.2.1
  refine ⟨φ.comp (Subalgebra.inclusion (genAlg_mono h)), isDGAMap_restrict δ h hφ, fun t k => ?_⟩
  rw [res_coe h z t k]
  rw [AlgHom.comp_apply, Subalgebra.inclusion_mk]
  rw [← jetLin_apply hr φ hcr, gen_expand h t k, map_sum]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [map_smul, jetLin_apply, ← hzφ t l]

/-- (2) `kanMap` maps `∫_S` into `RelHorn`. -/
theorem kanMap_mapsTo {r : ℕ} (hr : 1 ≤ r) (δ : LInfty L) {S S' : GenSys L}
    (h : ∀ i, S' i ≤ S i) (m : ℕ) (j : Fin (m + 2)) :
    Set.MapsTo (kanMap h m j) (integ r δ S (m + 1)) (RelHorn r δ h m j) := fun z hz =>
  ⟨fun i => faceAmb_mem_integ hr δ S m i.1 hz, res_mem_integ hr δ h (m + 1) hz,
    hornCompat_faceAmb hr S m j z, fun i => faceAmb_res hr h m i.1 z⟩

/-! (3) the augmentation and `0 ∈ ∫_S`. -/

theorem jet_zero'' {r m : ℕ} (hr : 1 ≤ r) : jet r (0 : Ω m) = 0 := by
  have := jet_smul hr (0 : ℝ) (isCr_zero (r := r) (m := m))
  simpa using this

noncomputable def augE : CE L →ₐ[ℝ] ℝ :=
  Algebra.TensorProduct.productMap ExteriorAlgebra.algebraMapInv SymmetricAlgebra.algebraMapInv

theorem augE_gen (i : ℕ) (ξ : Module.Dual ℝ (L i)) : augE (gen L i ξ) = 0 := by
  unfold gen
  split_ifs with hi
  · simp [augE, Algebra.TensorProduct.productMap_left_apply, ExteriorAlgebra.algebraMapInv]
  · simp [augE, Algebra.TensorProduct.productMap_right_apply, SymmetricAlgebra.algebraMapInv_ι]

theorem gen_mem_ceDeg (i : ℕ) (ξ : Module.Dual ℝ (L i)) : gen L i ξ ∈ ceDeg L (i + 1) :=
  Submodule.subset_span ⟨1, fun _ => i, fun _ => ξ, by simp, by simp⟩

theorem one_mem_ceDeg : (1 : CE L) ∈ ceDeg L 0 :=
  Submodule.subset_span ⟨0, fun t => t.elim0, fun t => t.elim0, by simp, by simp⟩

theorem augE_ceDeg {n : ℕ} (hn : 1 ≤ n) {x : CE L} (hx : x ∈ ceDeg L n) : augE x = 0 := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨k, d, ξ, hs, rfl⟩ := hx
    rw [map_list_prod, List.map_ofFn]
    cases k with
    | zero => simp at hs; omega
    | succ k => rw [List.prod_ofFn, Fin.prod_univ_succ]; simp [Function.comp_def, augE_gen]
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | smul c x _ hx => rw [map_smul, hx, smul_zero]

theorem augE_delta (δ : LInfty L) (S : GenSys L) {a : CE L} (ha : a ∈ genAlg L S) :
    augE (δ.δ a) = 0 := by
  have ha' : a ∈ Subalgebra.toSubmodule (genAlg L S) := ha
  rw [genAlg, Algebra.adjoin_eq_span] at ha'
  clear ha
  induction ha' using Submodule.span_induction with
  | mem x hx =>
    have hx' : x ∈ Submonoid.closure
        (⋃ i, (gen L i : Module.Dual ℝ (L i) → CE L) '' (S i : Set (Module.Dual ℝ (L i)))) := hx
    induction hx' using Submonoid.closure_induction_left with
    | one => exact augE_ceDeg (by norm_num) (δ.deg 0 1 one_mem_ceDeg)
    | mul_left g hg y hy ih =>
      obtain ⟨i, hi⟩ := Set.mem_iUnion.1 hg
      obtain ⟨ξ, -, rfl⟩ := hi
      rw [δ.leibniz (i + 1) _ (gen_mem_ceDeg i ξ)]
      simp [augE_gen, augE_ceDeg (by omega : 1 ≤ i + 1 + 1) (δ.deg _ _ (gen_mem_ceDeg i ξ))]
  | zero => simp
  | add x y _ _ hx hy => simp only [map_add, hx, hy, add_zero]
  | smul c x _ hx => simp only [map_smul, hx, smul_zero]

theorem coeff_const {m : ℕ} (c : ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ)))
    (I : Finset (Fin m)) : coeff (fun _ => c : Ω m) I = fun _ => (formBasis m).repr c I := rfl

theorem extD_const {m : ℕ} (c : ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ))) :
    extD (fun _ => c : Ω m) = fun _ => 0 := by
  funext x
  simp only [extD, coeff_const, fderivWithin_const, fderivWithin_const_apply, ContinuousLinearMap.zero_apply, zero_smul,
    Finset.sum_const_zero, mul_zero]

theorem isCr_const {r m : ℕ} (c : ExteriorAlgebra ℝ (Module.Dual ℝ (Fin m → ℝ))) :
    IsCr r (fun _ => c : Ω m) := fun I =>
  ⟨by rw [coeff_const]; exact contDiffOn_const,
    by rw [extD_const, coeff_const]; exact contDiffOn_const⟩

noncomputable def phi0 (S : GenSys L) (m : ℕ) : genAlg L S →ₐ[ℝ] Ω m :=
  (Algebra.ofId ℝ (Ω m)).comp (augE.comp (genAlg L S).val)

theorem phi0_apply (S : GenSys L) (m : ℕ) (a : genAlg L S) :
    phi0 S m a = (fun _ => algebraMap ℝ _ (augE (a : CE L)) : Ω m) := rfl

theorem zero_mem_integ {r : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (m : ℕ) :
    (0 : Amb r S m) ∈ integ r δ S m := by
  have hg : ∀ i (ξ : Module.Dual ℝ (L i)) (hξ : gen L i ξ ∈ genAlg L S),
      phi0 S m ⟨gen L i ξ, hξ⟩ = 0 := by
    intro i ξ hξ
    rw [phi0_apply]
    funext x
    simp [augE_gen]
  refine ⟨phi0 S m, ⟨fun i ξ hξ => ?_, fun a => ?_, fun a b hab x hx => ?_⟩, fun t k => ?_⟩
  · rw [hg]; exact isDeg_zero
  · rw [phi0_apply]; exact isCr_const _
  · rw [phi0_apply, phi0_apply, extD_const, ← hab, augE_delta δ S a.2]
    simp
  · rw [hg]
    exact (jet_zero'' hr).symm

theorem integ_nonempty {r : ℕ} (hr : 1 ≤ r) (δ : LInfty L) (S : GenSys L) (m : ℕ) :
    (integ r δ S m).Nonempty :=
  ⟨0, zero_mem_integ hr δ S m⟩

end IntLInfty.Kan.A83KM

/-! R30: `isKanFibration_of_filler` with inputs (1)-(3) discharged: only the fillers remain. -/
namespace IntLInfty.Kan.A83Kan

open IntLInfty.Kan
open scoped ContDiff

variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]

theorem isKanFibration_of_filler' {r : ℕ} (hr : 1 ≤ r) (δ : LInfty L) {S S' : GenSys L}
    (h : ∀ i, S' i ≤ S i)
    (hS : ∀ m, IsSplitSubmanifold (integ r δ S m)) (hS' : ∀ m, IsSplitSubmanifold (integ r δ S' m))
    (σ : ∀ m (j : Fin (m + 2)), Amb r S (m + 1) →
      (({i : Fin (m + 2) // i ≠ j} → Amb r S m) × Amb r S' (m + 1)) → Amb r S (m + 1))
    (hσ : ∀ m j x, ContDiff ℝ ∞ (σ m j x))
    (hσM : ∀ m j, ∀ x ∈ integ r δ S (m + 1), ∀ y ∈ RelHorn r δ h m j,
      σ m j x y ∈ integ r δ S (m + 1) ∧ kanMap h m j (σ m j x y) = y)
    (hσx : ∀ m j, ∀ x ∈ integ r δ S (m + 1), σ m j x (kanMap h m j x) = x) :
    IsKanFibration r δ S S' :=
  isKanFibration_of_filler δ h hS hS' (fun m j => A83KM.kanMap_contDiff hr h m j)
    (fun m j => A83KM.kanMap_mapsTo hr δ h m j) (fun m => A83KM.integ_nonempty hr δ S (m + 1))
    σ hσ hσM hσx

end IntLInfty.Kan.A83Kan

namespace IntLInfty.Kan.A83Comp

open IntLInfty.Kan IntLInfty.Kan.A83
open scoped ContDiff

variable {L : ℕ → Type} [∀ i, AddCommGroup (L i)] [∀ i, Module ℝ (L i)]
  [∀ i, FiniteDimensional ℝ (L i)]


/-- Filler data for `∫_S → ∫_{S'}` at level `m`, horn `j` (the inputs of `isKanFibration_of_filler'`). -/
def FillerAt (r : ℕ) (δ : LInfty L) {S S' : GenSys L} (h : ∀ i, S' i ≤ S i) (m : ℕ)
    (j : Fin (m + 2))
    (σ : Amb r S (m + 1) → (({i : Fin (m + 2) // i ≠ j} → Amb r S m) × Amb r S' (m + 1)) →
      Amb r S (m + 1)) : Prop :=
  (∀ x, ContDiff ℝ ∞ (σ x)) ∧
  (∀ x ∈ integ r δ S (m + 1), ∀ y ∈ RelHorn r δ h m j,
      σ x y ∈ integ r δ S (m + 1) ∧ kanMap h m j (σ x y) = y) ∧
  (∀ x ∈ integ r δ S (m + 1), σ x (kanMap h m j x) = x)

theorem isKanFibration_of_fillerAt {r : ℕ} (hr : 1 ≤ r) (δ : LInfty L) {S S' : GenSys L}
    (h : ∀ i, S' i ≤ S i)
    (hS : ∀ m, IsSplitSubmanifold (integ r δ S m)) (hS' : ∀ m, IsSplitSubmanifold (integ r δ S' m))
    (hF : ∀ m (j : Fin (m + 2)), ∃ σ, FillerAt r δ h m j σ) : IsKanFibration r δ S S' := by
  choose σ hσ using hF
  exact A83Kan.isKanFibration_of_filler' hr δ h hS hS' σ (fun m j => (hσ m j).1)
    (fun m j => (hσ m j).2.1) (fun m j => (hσ m j).2.2)


end IntLInfty.Kan.A83Comp

open scoped ContDiff

open IntLInfty.Kan in
theorem solution (r : ℕ) (hr : 1 ≤ r) (L : ℕ → Type) [∀ i, AddCommGroup (L i)]
    [∀ i, Module ℝ (L i)] [∀ i, FiniteDimensional ℝ (L i)] (δ : LInfty L) (S S' : GenSys L)
    (h : ∀ i, S' i ≤ S i)
    (hS : ∀ m, IsSplitSubmanifold (integ r δ S m)) (hS' : ∀ m, IsSplitSubmanifold (integ r δ S' m))
    (hF : ∀ (m : ℕ) (j : Fin (m + 2)),
      ∃ σ : Amb r S (m + 1) → (({i : Fin (m + 2) // i ≠ j} → Amb r S m) × Amb r S' (m + 1)) →
          Amb r S (m + 1),
        (∀ x, ContDiff ℝ ∞ (σ x)) ∧
        (∀ x ∈ integ r δ S (m + 1), ∀ y ∈ RelHorn r δ h m j,
            σ x y ∈ integ r δ S (m + 1) ∧ kanMap h m j (σ x y) = y) ∧
        (∀ x ∈ integ r δ S (m + 1), σ x (kanMap h m j x) = x)) :
    IsKanFibration r δ S S'  :=
  A83Comp.isKanFibration_of_fillerAt hr δ h hS hS' hF
