theorem MIPStarRE.QPBT.WinImplications.avgOver_mix {X : Type*} [Finite X] [DecidableEq X]
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
    (μ ν : _root_.LIDT.MIPStarRE.LDT.Distribution X) (f : X → ℝ) :
    _root_.LIDT.MIPStarRE.LDT.avgOver (_root_.MIPStarRE.QPBT.Distribution.mix t ht0 ht1 μ ν) f =
      t * _root_.LIDT.MIPStarRE.LDT.avgOver μ f + (1 - t) * _root_.LIDT.MIPStarRE.LDT.avgOver ν f := by sorry
