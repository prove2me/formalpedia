theorem sig_lt (hc : 0 < c) (v : ℕ) : sig Q c v < c := by
  have : NeZero c := ⟨by omega⟩
  exact ZMod.val_lt _

theorem sig_spec (hc : 0 < c) (hQ : Nat.Coprime Q c) (z : ℕ) :
    (sig Q c (z % c) * Q + z) % c = 0 := by
  have : NeZero c := ⟨by omega⟩
  have hu : IsUnit (Q : ZMod c) := (ZMod.isUnit_iff_coprime Q c).2 hQ
  rw [← Nat.dvd_iff_mod_eq_zero, ← ZMod.natCast_eq_zero_iff]
  push_cast
  rw [sig, ZMod.natCast_val, ZMod.cast_id', id, ZMod.natCast_mod, mul_assoc,
    ZMod.inv_mul_of_unit _ hu]
  ring

theorem sig_unique (hc : 0 < c) (hQ : Nat.Coprime Q c) {j z : ℕ} (hj : j < c)
    (h : (j * Q + z) % c = 0) : j = sig Q c (z % c) := by
  have : NeZero c := ⟨by omega⟩
  have hu : IsUnit (Q : ZMod c) := (ZMod.isUnit_iff_coprime Q c).2 hQ
  have h1 := sig_spec hc hQ z
  rw [← Nat.dvd_iff_mod_eq_zero, ← ZMod.natCast_eq_zero_iff] at h h1
  push_cast at h h1
  have e : (j : ZMod c) * Q = (sig Q c (z % c) : ZMod c) * Q := by
    rw [eq_neg_of_add_eq_zero_left h, eq_neg_of_add_eq_zero_left h1]
  have e2 : (j : ZMod c) = (sig Q c (z % c) : ZMod c) := by
    have := congrArg (· * (Q : ZMod c)⁻¹) e
    simp only [mul_assoc, ZMod.mul_inv_of_unit _ hu, mul_one] at this
    exact this
  have := congrArg ZMod.val e2
  rwa [ZMod.val_cast_of_lt hj, ZMod.val_cast_of_lt (sig_lt hc _)] at this

theorem yOf_lt (hc : 0 < c) (z : ℕ) (hz : z < Q) : NLogN.KIL.yOf Q c z < Q := by
  unfold NLogN.KIL.yOf
  have := sig_lt hc (z % c) (Q := Q)
  rw [Nat.div_lt_iff_lt_mul hc]
  have : sig Q c (z % c) * Q ≤ (c - 1) * Q := Nat.mul_le_mul_right _ (by omega)
  have e : (c - 1) * Q + Q = c * Q := by
    rw [← Nat.succ_mul, Nat.succ_eq_add_one, Nat.sub_add_cancel hc]
  nlinarith

theorem mul_yOf (hc : 0 < c) (hQc : Nat.Coprime Q c) (z : ℕ) :
    c * NLogN.KIL.yOf Q c z = sig Q c (z % c) * Q + z := by
  unfold NLogN.KIL.yOf
  exact Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero (sig_spec hc hQc z))

/-- `yOf` is multiplication by `c⁻¹` modulo `Q`. -/
theorem yOf_eq [NeZero Q] (hc : 0 < c) (hQc : Nat.Coprime Q c) (z : ℕ) (hz : z < Q) :
    NLogN.KIL.yOf Q c z = (((c : ZMod Q))⁻¹ * (z : ZMod Q)).val := by
  have hu : IsUnit (c : ZMod Q) := (ZMod.isUnit_iff_coprime c Q).2 hQc.symm
  have e : (c : ZMod Q) * (NLogN.KIL.yOf Q c z : ZMod Q) = (z : ZMod Q) := by
    rw [← Nat.cast_mul, mul_yOf hc hQc]; push_cast; simp
  have e2 : (NLogN.KIL.yOf Q c z : ZMod Q) = ((c : ZMod Q))⁻¹ * (z : ZMod Q) := by
    rw [← e, ← mul_assoc, ZMod.inv_mul_of_unit _ hu, one_mul]
  rw [← e2, ZMod.val_cast_of_lt (yOf_lt hc z hz)]

