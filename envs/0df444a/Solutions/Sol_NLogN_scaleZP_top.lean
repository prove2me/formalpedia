        by simp (config := {decide := true}) [scBE, Ex.Clean, Ex.regs, zX_all, Ex.ok,
          IState.IsInt, IState.top, NLogN.scSt, IState.upd_G, RS.run_push_G, h11, h14],
        hok, ⟨by decide, by simp (config := {decide := true}) [tdivE, Ex.fdiv, Ex.Clean, Ex.regs,
