theorem OAI.CanonicalQuadraticSieve.norm_double_sum_real_factor {n p : Type*} [Fintype n] [Fintype p]
    (u : n → p → ℂ) (z : ℂ) (c : ℝ) (hc : 0 ≤ c) :
    ‖∑ j, ∑ k, u j k * ((c : ℂ) * z)‖ = c * ‖∑ j, ∑ k, u j k * z‖ := by sorry
