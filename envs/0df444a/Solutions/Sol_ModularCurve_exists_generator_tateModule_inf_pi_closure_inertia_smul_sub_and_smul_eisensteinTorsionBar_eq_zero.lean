theorem dense (m : ℕ) {α : Module.End ℤ_[2] (_root_.TateModule 2 (JZero p))}
    (hα : α ∈ Algebra.adjoin ℤ_[2] (Set.range fun t : HeckeAlg => tateHeckeRep 2 (JZero p) t)) :
    ∃ t : HeckeAlg, ∃ γ ∈ Algebra.adjoin ℤ_[2] (Set.range fun t : HeckeAlg => tateHeckeRep 2 (JZero p) t),
      α = tateHeckeRep 2 (JZero p) t + ((2 : ℕ) : ℤ_[2]) ^ m • γ := by
  have hρ : ∀ t : HeckeAlg, tateHeckeRep 2 (JZero p) t ∈
      Algebra.adjoin ℤ_[2] (Set.range fun t : HeckeAlg => tateHeckeRep 2 (JZero p) t) :=
    fun t => Algebra.subset_adjoin ⟨t, rfl⟩
  induction hα using Algebra.adjoin_induction with
  | mem x hx =>
      obtain ⟨t, rfl⟩ := hx
      exact ⟨t, 0, Subalgebra.zero_mem _, by rw [smul_zero, add_zero]⟩
  | algebraMap r =>
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (PadicInt.appr_spec m r)
      refine ⟨(r.appr m : HeckeAlg), algebraMap ℤ_[2] _ c, Subalgebra.algebraMap_mem _ c, ?_⟩
      have hr : r = ((r.appr m : ℕ) : ℤ_[2]) + ((2 : ℕ) : ℤ_[2]) ^ m * c := by
        rw [mul_comm, hc, add_sub_cancel]
      have hr' := congrArg (algebraMap ℤ_[2] (Module.End ℤ_[2] (_root_.TateModule 2 (JZero p)))) hr
      rw [hr', map_add, map_mul, algebraMap_natCast_eq, Algebra.smul_def]
  | add x y _ _ hx hy =>
      obtain ⟨t₁, γ₁, hγ₁, rfl⟩ := hx
      obtain ⟨t₂, γ₂, hγ₂, rfl⟩ := hy
      refine ⟨t₁ + t₂, γ₁ + γ₂, Subalgebra.add_mem _ hγ₁ hγ₂, ?_⟩
      rw [map_add, smul_add]
      abel
  | mul x y _ _ hx hy =>
      obtain ⟨t₁, γ₁, hγ₁, rfl⟩ := hx
      obtain ⟨t₂, γ₂, hγ₂, rfl⟩ := hy
      refine ⟨t₁ * t₂, γ₁ * tateHeckeRep 2 (JZero p) t₂ + (tateHeckeRep 2 (JZero p) t₁ * γ₂ +
          ((2 : ℕ) : ℤ_[2]) ^ m • (γ₁ * γ₂)), ?_, ?_⟩
      · exact Subalgebra.add_mem _ (Subalgebra.mul_mem _ hγ₁ (hρ t₂))
          (Subalgebra.add_mem _ (Subalgebra.mul_mem _ (hρ t₁) hγ₂)
            (Subalgebra.smul_mem _ (Subalgebra.mul_mem _ hγ₁ hγ₂) _))
      · simp only [mul_add, add_mul, map_mul, smul_add, smul_mul_assoc, mul_smul_comm, smul_smul]
        abel

