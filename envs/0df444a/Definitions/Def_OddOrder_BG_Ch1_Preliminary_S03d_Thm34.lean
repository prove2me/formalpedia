      -- `C_W̄(R̄) = 0`: a fixed `v` is `R`-fixed in `V`, hence `0` by `C_V(R) = 0`.
      have hCVQ : ∀ v : ↥W.toSubmodule, (∀ rQ : ↥(R.map (QuotientGroup.mk' N)),
