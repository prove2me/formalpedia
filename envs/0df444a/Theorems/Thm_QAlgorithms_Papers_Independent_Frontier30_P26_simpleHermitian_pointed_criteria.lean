variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Proposition 3.8, PDF pp. 9–10. Scope correction: the final identity assumes the equivalent
pointedness conditions, as the source proof does; its unqualified printed form is false. -/
theorem simpleHermitian_pointed_criteria [LieAlgebra.IsSimple ℝ G]
    (hh : Hermitian (G := G)) (W : Set G) (hm : MaximalPointedInvariantCone W)
    (xs xn : G) (hj : JordanPair xs xn) :
    (Pointed (orbitCone (xs + xn)) ↔ Pointed (orbitCone xs) ∧ Pointed (orbitCone xn) ∧
      (xs ≠ 0 → xn ∈ orbitCone xs)) ∧
    (Pointed (orbitCone (xs + xn)) ↔ xs + xn ∈ W ∪ (Neg.neg '' W)) ∧
    (Pointed (orbitCone (xs + xn)) ↔ Pointed (orbitHull (xs + xn))) ∧
    (Pointed (orbitCone (xs + xn)) → xs ≠ 0 → orbitCone (xs + xn) = orbitCone xs) := by sorry

end LieGeometry

end

end QAlgorithms.Papers.Independent.Frontier30.P26
