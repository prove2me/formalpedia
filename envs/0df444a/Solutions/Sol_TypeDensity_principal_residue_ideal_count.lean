theorem solution (k : Type) [Field k] [Finite k] (a b N : ℕ) (ha : 0 < a)
    (P : TypeDensity.TwoSeries k → Prop) (Q : TypeDensity.SpecialFiber k a b → Prop)
    (hQ : ∀ F, Q (Ideal.Quotient.mk _ F) ↔ P F) (hunit : ∀ U F, IsUnit U → P F → P (U * F))
    (hlen : ∀ F, P F → Module.length (TypeDensity.TwoSeries k)
      (TypeDensity.TwoSeries k ⧸ (TypeDensity.monomialIdeal k a b ⊔ Ideal.span {F})) = N)
    (hcard : ∀ F, P F →
      Nat.card (TypeDensity.TwoSeries k ⧸ (TypeDensity.monomialIdeal k a b ⊔ Ideal.span {F})) = Nat.card k ^ N)
    (A B : Finset (TypeDensity.truncIndex a b (N + 1))) (hAB : Disjoint A B) (hB : B.Nonempty)
    (hcrit : ∀ F, P F ↔ (∀ s ∈ A, TypeDensity.truncCoeffs k a b (N + 1) F s = 0) ∧
      ∀ s ∈ B, TypeDensity.truncCoeffs k a b (N + 1) F s ≠ 0) :
    Nat.card {I : Ideal (TypeDensity.SpecialFiber k a b) // ∃ f, I = Ideal.span {f} ∧ Q f} *
        ((Nat.card k - 1) * Nat.card k ^ (A.card + B.card - 1)) =
      (Nat.card k - 1) ^ B.card * Nat.card k ^ N := by
  -- Work in the finite local truncation `R' = k⟦T, X⟧ ⧸ truncIdeal k a b (N + 1)`: count the
  -- generators `G` by coefficients, the fibres of `x ↦ (x)` by units, and transport to `Q`.
  have : Fintype k := Fintype.ofFinite k
  have hL0 : 0 < N + 1 := N.succ_pos
  let J := TypeDensity.truncIdeal k a b (N + 1)
  let R' := TypeDensity.TwoSeries k ⧸ J
  let mk' : TypeDensity.TwoSeries k →+* R' := Ideal.Quotient.mk J
  have hmk' : Function.Surjective mk' := Ideal.Quotient.mk_surjective
  have : Nontrivial R' := Ideal.Quotient.nontrivial_iff.mpr (TypeDensity.truncIdeal_ne_top k a b _ ha hL0)
  have : IsLocalRing R' := .of_surjective' mk' hmk'
  let ev := TypeDensity.truncEval k a b (N + 1)
  have hev : ∀ F, ev (mk' F) = TypeDensity.truncCoeffs k a b (N + 1) F := TypeDensity.truncEval_mk k a b (N + 1)
  let eqv : R' ≃ (TypeDensity.truncIndex a b (N + 1) → k) := ev.toEquiv
  have : Fintype R' := .ofEquiv _ eqv.symm
  have hmonJ : TypeDensity.monomialIdeal k a b ≤ J := le_sup_left
  have hkill : ∀ F, P F → J ≤ TypeDensity.monomialIdeal k a b ⊔ Ideal.span {F} := fun F hF ↦
    TypeDensity.truncIdeal_le_of_length k a b N F (hlen F hF)
  have hcardq : ∀ F, P F → Nat.card (R' ⧸ Ideal.span {mk' F}) = Nat.card k ^ N := by
    intro F hF
    have e := DoubleQuot.quotQuotEquivQuotSup J (Ideal.span {F})
    rw [Ideal.map_span, Set.image_singleton, le_antisymm (sup_le (hkill F hF) le_sup_right)
      (sup_le_sup_right hmonJ _)] at e
    rw [Nat.card_congr e.toEquiv, hcard F hF]
  -- the generators, the units and the fibres of `x ↦ (x)`
  let G : Set R' := {x | (∀ s ∈ A, ev x s = 0) ∧ ∀ s ∈ B, ev x s ≠ 0}
  have hPG : ∀ F, mk' F ∈ G ↔ P F := fun F => by rw [hcrit]; simp only [G, Set.mem_ofPred_eq, hev]
  have hcardG : Nat.card G =
      (Nat.card k - 1) ^ B.card * Nat.card k ^ (Fintype.card (TypeDensity.truncIndex a b (N + 1)) -
        A.card - B.card) := by
    rw [Nat.card_eq_fintype_card (α := k), ← TypeDensity.coordinate_constraint_count k _ A B hAB]
    exact Nat.card_congr (eqv.subtypeEquiv fun _ => Iff.rfl)
  have hne0 : ∀ x ∈ G, x ≠ 0 := by
    rintro x ⟨-, h⟩ rfl
    obtain ⟨s, hs⟩ := hB
    exact h s hs (by rw [← map_zero mk', hev, map_zero]; rfl)
  have hfib : ∀ x ∈ G,
      Nat.card {g : R' // Ideal.span {g} = Ideal.span {x}} * Nat.card k ^ N = Nat.card R'ˣ := by
    intro x hx
    obtain ⟨F, rfl⟩ := hmk' x
    rw [← hcardq F ((hPG F).1 hx), ← TypeDensity.card_mul_eq_zero_eq_card_quotient]
    exact TypeDensity.principal_generator_orbit_count R' _ (hne0 _ hx)
  have hclos : ∀ x ∈ G, ∀ y : R', Ideal.span {y} = Ideal.span {x} → y ∈ G := by
    intro x hx y hy
    obtain ⟨F, rfl⟩ := hmk' x
    obtain ⟨r, hru, hr⟩ := TypeDensity.exists_isUnit_mul_eq_of_span_eq (hne0 _ hx) hy
    obtain ⟨Gr, rfl⟩ := hmk' r
    have hGu : IsUnit Gr := MvPowerSeries.isUnit_iff_constantCoeff.mpr
      (isUnit_iff_ne_zero.mpr ((TypeDensity.isUnit_mk_truncIdeal_iff k a b _ ha hL0 Gr).mp hru))
    rw [← hr, ← map_mul, hPG]
    exact hunit _ _ hGu ((hPG F).1 hx)
  have hU := TypeDensity.card_units_truncQuotient k a b (N + 1) ha hL0
  -- counting the principal ideals of `R'` generated in `G`
  have hGP := TypeDensity.card_mul_eq_card_principal_mul G _ _ hfib hclos
  -- residue ideals correspond to principal ideals of `R'` generated in `G`
  let ψ := Ideal.Quotient.factor hmonJ
  have hmapI : ∀ F, Ideal.map ψ (Ideal.span {Ideal.Quotient.mk (TypeDensity.monomialIdeal k a b) F}) =
      Ideal.span {mk' F} := fun F => by
    rw [Ideal.map_span, Set.image_singleton, Ideal.Quotient.factor_mk]
  let Φ : {I : Ideal (TypeDensity.SpecialFiber k a b) // ∃ f, I = Ideal.span {f} ∧ Q f} →
      {I : Ideal R' // ∃ x ∈ G, I = Ideal.span {x}} :=
    fun I => ⟨Ideal.map ψ I.1, by
      obtain ⟨_, f, rfl, hf⟩ := I
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective f
      exact ⟨mk' F, (hPG F).2 ((hQ F).1 hf), hmapI F⟩⟩
  have hΦ : Function.Bijective Φ := by
    refine ⟨?_, ?_⟩
    · rintro ⟨_, f₁, rfl, hf₁⟩ ⟨_, f₂, rfl, hf₂⟩ h
      obtain ⟨F₁, rfl⟩ := Ideal.Quotient.mk_surjective f₁
      obtain ⟨F₂, rfl⟩ := Ideal.Quotient.mk_surjective f₂
      have h' := congrArg Subtype.val h
      simp only [Φ, hmapI] at h'
      apply Subtype.ext
      change Ideal.span {_} = Ideal.span {_}
      rw [← TypeDensity.comap_factor_span_singleton hmonJ (hkill F₁ ((hQ F₁).1 hf₁)),
        ← TypeDensity.comap_factor_span_singleton hmonJ (hkill F₂ ((hQ F₂).1 hf₂))]
      exact congrArg _ h'
    · rintro ⟨_, x, hx, rfl⟩
      obtain ⟨F, rfl⟩ := hmk' x
      exact ⟨⟨_, _, rfl, (hQ F).2 ((hPG F).1 hx)⟩, Subtype.ext (hmapI F)⟩
  rw [Nat.card_congr (Equiv.ofBijective Φ hΦ)]
  rw [hcardG, hU] at hGP
  have hℓ : A.card + B.card ≤ Fintype.card (TypeDensity.truncIndex a b (N + 1)) :=
    Finset.card_union_of_disjoint hAB ▸ Finset.card_le_univ _
  have hB1 := hB.card_pos
  set m := Fintype.card (TypeDensity.truncIndex a b (N + 1)) - A.card - B.card
  have hpos : 0 < Nat.card k ^ m := pow_pos Nat.card_pos _
  refine Nat.eq_of_mul_eq_mul_left hpos ?_
  rw [show Fintype.card (TypeDensity.truncIndex a b (N + 1)) - 1 = m + (A.card + B.card - 1) by omega,
    pow_add] at hGP
  linarith
