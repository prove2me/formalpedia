theorem maximalIdeal_eq_span_of_ringEquiv {R S : Type*} [CommRing R] [IsLocalRing R] [CommRing S] [IsLocalRing S]
    (e : R ≃+* S) (ϖ : R) (h : maximalIdeal R = Ideal.span {ϖ}) : maximalIdeal S = Ideal.span {e ϖ} := by
  apply le_antisymm
  · intro x hx
    have hx' : e.symm x ∈ maximalIdeal R := by
      rw [mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro hu; apply hx
      have := hu.map e
      simpa using this
    rw [h, Ideal.mem_span_singleton'] at hx'
    obtain ⟨r, hr⟩ := hx'
    refine Ideal.mem_span_singleton'.mpr ⟨e r, ?_⟩
    rw [← map_mul, hr, RingEquiv.apply_symm_apply]
  · rw [Ideal.span_singleton_le_iff_mem, mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hϖ : ϖ ∈ maximalIdeal R := by rw [h]; exact Ideal.subset_span rfl
    apply (mem_maximalIdeal _).mp hϖ
    have := hu.map e.symm
    simpa using this

theorem isDiscreteValuationRing_of_ringEquiv {R S : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [IsLocalRing S] (e : R ≃+* S) : IsDiscreteValuationRing S := by
  haveI : IsPrincipalIdealRing S := IsPrincipalIdealRing.of_surjective e.toRingHom e.surjective
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hmax := maximalIdeal_eq_span_of_ringEquiv e ϖ ((IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ)
  refine IsDiscreteValuationRing.mk ?_
  rw [hmax, Ne, Ideal.span_singleton_eq_bot]
  intro h0
  exact hϖ.ne_zero (by simpa using congrArg e.symm h0)

theorem henselianLocalRing_of_ringEquiv {R S : Type*} [CommRing R] [HenselianLocalRing R] [CommRing S] [IsLocalRing S]
    (e : R ≃+* S) : HenselianLocalRing S where
  is_henselian := by
    intro f hf a₀ ha₀ hder
    have nonunit_symm : ∀ x : S, x ∈ maximalIdeal S → e.symm x ∈ maximalIdeal R := fun x hx => by
      rw [mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro hu; apply hx; simpa using hu.map e
    have hf' : (f.map e.symm.toRingHom).Monic := hf.map _
    have h1 : Polynomial.eval (e.symm a₀) (f.map e.symm.toRingHom) ∈ maximalIdeal R := by
      rw [Polynomial.eval_map, show e.symm a₀ = e.symm.toRingHom a₀ from rfl, Polynomial.eval₂_at_apply]
      exact nonunit_symm _ ha₀
    have h2 : IsUnit (Polynomial.eval (e.symm a₀) (Polynomial.derivative (f.map e.symm.toRingHom))) := by
      rw [Polynomial.derivative_map, Polynomial.eval_map, show e.symm a₀ = e.symm.toRingHom a₀ from rfl,
        Polynomial.eval₂_at_apply]
      exact hder.map e.symm.toRingHom
    obtain ⟨a, ha, hclose⟩ := HenselianLocalRing.is_henselian _ hf' _ h1 h2
    refine ⟨e a, ?_, ?_⟩
    · have := ha.map (f := e.toRingHom)
      rwa [Polynomial.map_map, show e.toRingHom.comp e.symm.toRingHom = RingHom.id S from by ext x; simp,
        Polynomial.map_id] at this
    · have : e a - a₀ = e (a - e.symm a₀) := by simp
      rw [this, mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      apply (mem_maximalIdeal _).mp hclose
      simpa using hu.map e.symm

theorem exists_isPrimitiveRoot_of_isUnit {A : Type*} [CommRing A] [IsDomain A] [HenselianLocalRing A]
    [IsAlgClosed (ResidueField A)] (n : ℕ) (hn : 2 ≤ n) (hnu : IsUnit (n : A)) :
    ∃ ξ : A, IsPrimitiveRoot ξ n := by
  classical

  haveI : NeZero ((n : ℕ) : ResidueField A) := ⟨by
    intro h0
    have : IsUnit (IsLocalRing.residue A (n : A)) := hnu.map _
    rw [map_natCast, h0] at this
    exact not_isUnit_zero this⟩
  obtain ⟨ζbar, hζbar⟩ := HasEnoughRootsOfUnity.prim (M := ResidueField A) (n := n)
  obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective ζbar

  set f : Polynomial A := Polynomial.X ^ n - 1 with hf
  have hmonic : f.Monic := Polynomial.monic_X_pow_sub_C 1 (by omega)
  have heval : Polynomial.eval a₀ f ∈ maximalIdeal A := by
    rw [← IsLocalRing.residue_eq_zero_iff, hf, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_one, map_sub, map_pow, map_one, ha₀, hζbar.pow_eq_one, sub_self]
  have ha₀u : IsUnit a₀ :=
    (IsLocalRing.residue_ne_zero_iff_isUnit a₀).mp (by rw [ha₀]; exact hζbar.ne_zero (by omega))
  have hder : IsUnit (Polynomial.eval a₀ (Polynomial.derivative f)) := by
    rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_one, sub_zero,
      Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
    exact hnu.mul (ha₀u.pow _)
  obtain ⟨ξ, hξroot, hξa₀⟩ := HenselianLocalRing.is_henselian f hmonic a₀ heval hder
  refine ⟨ξ, ?_⟩
  have hξn : ξ ^ n = 1 := by
    have := hξroot; rw [Polynomial.IsRoot, hf, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_one] at this
    exact sub_eq_zero.mp this
  have hres : IsLocalRing.residue A ξ = ζbar := by
    rw [← ha₀, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]; exact hξa₀

  rw [IsPrimitiveRoot.iff_def]
  refine ⟨hξn, fun l hl => ?_⟩
  have : ζbar ^ l = 1 := by rw [← hres, ← map_pow, hl, map_one]
  exact hζbar.dvd_of_pow_eq_one l this

