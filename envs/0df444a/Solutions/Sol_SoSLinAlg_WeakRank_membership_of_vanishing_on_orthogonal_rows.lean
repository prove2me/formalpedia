variable {σ : Type*}
theorem homog_decomp {ι : Type*} [Fintype ι] (w : σ → ℕ) (μ : ι → σ →₀ ℕ) {d : ℕ}
    {g : MvPolynomial σ ℝ} (hg : g ∈ monIdeal μ) (hh : IsWeightedHomogeneous w g d) :
    ∃ c : ι → MvPolynomial σ ℝ, g = ∑ l, c l * monomial (μ l) 1 ∧
      ∀ l, IsWeightedHomogeneous w (c l) (d - Finsupp.weight w (μ l)) ∧
        (c l ≠ 0 → Finsupp.weight w (μ l) ≤ d) := by
  classical
  have hcov : ∀ s ∈ g.support, ∃ l, μ l ≤ s := by
    rw [monIdeal_eq, mem_ideal_span_monomial_image] at hg
    intro s hs
    obtain ⟨_, ⟨l, rfl⟩, hl⟩ := hg s hs
    exact ⟨l, hl⟩
  choose L hL using hcov
  have key : ∀ (l : ι) (s : {x // x ∈ g.support}), L s.1 s.2 = l →
      Finsupp.weight w (s.1 - μ l) + Finsupp.weight w (μ l) = d := by
    intro l s hs
    rw [← map_add, tsub_add_cancel_of_le (hs ▸ hL s.1 s.2)]
    exact hh (mem_support_iff.1 s.2)
  refine ⟨fun l => ∑ s ∈ g.support.attach with L s.1 s.2 = l,
    monomial (s.1 - μ l) (coeff s.1 g), ?_, ?_⟩
  · calc g = ∑ s ∈ g.support.attach, monomial s.1 (coeff s.1 g) := by
          rw [Finset.sum_attach g.support (fun s => monomial s (coeff s g))]
          exact (support_sum_monomial_coeff g).symm
      _ = ∑ l, ∑ s ∈ g.support.attach with L s.1 s.2 = l, monomial s.1 (coeff s.1 g) :=
          (Finset.sum_fiberwise _ _ _).symm
      _ = _ := by
        apply Finset.sum_congr rfl
        intro l _
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro s hs
        rw [Finset.mem_filter] at hs
        rw [monomial_mul, mul_one, tsub_add_cancel_of_le (hs.2 ▸ hL s.1 s.2)]
  · intro l
    constructor
    · apply IsWeightedHomogeneous.sum
      intro s hs
      rw [Finset.mem_filter] at hs
      apply isWeightedHomogeneous_monomial
      have := key l s hs.2
      omega
    · intro hne
      by_contra hlt
      apply hne
      apply Finset.sum_eq_zero
      intro s hs
      rw [Finset.mem_filter] at hs
      have := key l s hs.2
      omega

end SoSLinAlg.WeakRank.Dev.Leaf.PartA
