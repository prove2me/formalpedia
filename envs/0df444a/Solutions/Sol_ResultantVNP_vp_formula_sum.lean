namespace PermanentSelectorSubstitution
open MvPolynomial ResultantVNP PermanentFoundation PermanentGadgetMatrix PermanentGadgetReindex PermanentOccurrence

variable {σ : Type} [DecidableEq σ] {n : ℕ}

/-- Transfer a gadget witness to a standard `Fin m` index while preserving
    its permanent and all occurrence counts. -/
theorem finite_reindex_witness {α : Type} [Fintype α] [DecidableEq α] {m : ℕ}
    (e : Fin m ≃ α) (G : Matrix α α (MvPolynomial σ ℂ))
    (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) (v : σ)
    (hG : IsSubstMatrix G) (he : occurrences G v = ∅)
    (hb : ∀ w,(occurrences G w).card ≤ (occurrences M w).card) :
    ∃ N : Matrix (Fin m) (Fin m) (MvPolynomial σ ℂ),
      IsSubstMatrix N ∧ N.permanent = G.permanent ∧ occurrences N v = ∅ ∧
        ∀ w,(occurrences N w).card ≤ (occurrences M w).card := by
  refine ⟨G.submatrix e e,hG.submatrix e e,Matrix.permanent_submatrix_equiv e G,?_,?_⟩
  · apply Finset.card_eq_zero.mp
    rw [equiv_occurrences_card G e v,he]
    rfl
  · intro w
    rw [equiv_occurrences_card G e w]
    exact hb w

/-- Substitute one variable by a field constant and leave all others fixed. -/
noncomputable def substitute (v : σ) (z : ℂ) : MvPolynomial σ ℂ →ₐ[ℂ] MvPolynomial σ ℂ :=
  aeval (fun x => if x = v then C z else X x)

@[simp] theorem substitute_C (v : σ) (z c : ℂ) : substitute v z (C c) = C c := by
  simp [substitute]

@[simp] theorem substitute_X (v x : σ) (z : ℂ) :
    substitute v z (X x) = if x = v then C z else X x := by
  simp [substitute]

theorem substitute_entry_ne {p : MvPolynomial σ ℂ} (hp : IsSubstEntry p)
    (v : σ) (z : ℂ) (hne : p ≠ X v) : substitute v z p = p := by
  obtain ⟨s,rfl⟩ := hp
  cases s with
  | inl x =>
    have hx : x ≠ v := by intro h; subst x; exact hne rfl
    simp [hx]
  | inr c => simp

theorem substitute_matrix (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (i j k l : Fin n) (z : ℂ)
    (hfirst : M i j = X v) (hsecond : M k l = X v)
    (hcover : ∀ r c, M r c = X v → (r = i ∧ c = j) ∨ (r = k ∧ c = l)) :
    M.map (substitute v z) = setTwo M i j k l (C z) := by
  apply Matrix.ext
  intro r c
  by_cases h : (r = i ∧ c = j) ∨ (r = k ∧ c = l)
  · rcases h with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩ <;> simp [setTwo,hfirst,hsecond]
  · have hn : M r c ≠ X v := fun hv => h (hcover r c hv)
    simp only [Matrix.map_apply,setTwo,Matrix.of_apply,if_neg h]
    exact substitute_entry_ne (hM r c) v z hn

/-- The gadget represents the sum over the two Boolean values of a selector. -/
theorem selector_sum_isProjection (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (i j k l : Fin n)
    (hik : i ≠ k) (hjl : j ≠ l)
    (hfirst : M i j = X v) (hsecond : M k l = X v)
    (hcover : ∀ r c, M r c = X v → (r = i ∧ c = j) ∨ (r = k ∧ c = l)) :
    IsProjection (substitute v 0 M.permanent + substitute v 1 M.permanent)
      (genericMatrix (3+n)).permanent := by
  have h0 := substitute_matrix M hM v i j k l 0 hfirst hsecond hcover
  have h1 := substitute_matrix M hM v i j k l 1 hfirst hsecond hcover
  have hp := boolean_sum_arbitrary_positions M hM i j k l hik hjl
  rw [AlgHom.map_permanent,h0,AlgHom.map_permanent,h1]
  simpa only [map_zero,map_one] using hp

/-- Explicit one-occurrence gadget: replace the occurrence by one half and
    add a one-by-one block of weight two. -/
noncomputable def oneOccurrenceGadget
    (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) (i j : Fin n) :
    Matrix (Fin 1 ⊕ Fin n) (Fin 1 ⊕ Fin n) (MvPolynomial σ ℂ) :=
  Matrix.fromBlocks (Matrix.of fun _ _ => 2) 0 0
    (M.updateRow i (Function.update (M i) j (C (1/2 : ℂ))))

theorem oneOccurrenceGadget_entries (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (i j : Fin n) : IsSubstMatrix (oneOccurrenceGadget M i j) := by
  apply IsSubstMatrix.fromBlocks
  · intro _ _
    simpa only [Matrix.of_apply,map_ofNat] using (IsSubstEntry.C (σ := σ) 2)
  · exact IsSubstMatrix.zero
  · exact IsSubstMatrix.zero
  · exact hM.updateEntry i j (1/2)

theorem oneOccurrenceGadget_sum (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (i j : Fin n)
    (hentry : M i j = X v) (hcover : ∀ r c, M r c = X v → r = i ∧ c = j) :
    (oneOccurrenceGadget M i j).permanent =
      substitute v 0 M.permanent + substitute v 1 M.permanent := by
  have hc : ∀ r c, M r c = X v → (r = i ∧ c = j) ∨ (r = i ∧ c = j) :=
    fun r c h => Or.inl (hcover r c h)
  have h0 := substitute_matrix M hM v i j i j 0 hentry hentry hc
  have h1 := substitute_matrix M hM v i j i j 1 hentry hentry hc
  have hz : setTwo M i j i j (0 : MvPolynomial σ ℂ) =
      M.updateRow i (Function.update (M i) j 0) := by
    apply Matrix.ext
    intro r c
    by_cases hr : r = i <;> by_cases hc : c = j <;> simp [setTwo,Matrix.updateRow,Function.update,hr,hc]
  have ho : setTwo M i j i j (1 : MvPolynomial σ ℂ) =
      M.updateRow i (Function.update (M i) j 1) := by
    apply Matrix.ext
    intro r c
    by_cases hr : r = i <;> by_cases hc : c = j <;> simp [setTwo,Matrix.updateRow,Function.update,hr,hc]
  let half : MvPolynomial σ ℂ := C (1/2 : ℂ)
  have hh : 2*half = 1 := by
    simpa only [half,map_mul,map_ofNat,map_one] using
      congrArg (C : ℂ → MvPolynomial σ ℂ) (by norm_num : (2 : ℂ)*(1/2) = 1)
  rw [AlgHom.map_permanent,h0,AlgHom.map_permanent,h1]
  simp only [map_zero,map_one,hz,ho]
  rw [Matrix.permanent_updateRow_update_zero_add_one M i j half hh]
  rw [oneOccurrenceGadget,Matrix.permanent_fromBlocks_zero,Matrix.permanent_unique]
  simp [half]

theorem oneOccurrenceGadget_occurrences (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (i j : Fin n) (w : σ) :
    occurrences (oneOccurrenceGadget M i j) w ⊆
      (occurrences M w).image (fun ij => (Sum.inr ij.1,Sum.inr ij.2)) := by
  intro ⟨r,c⟩ h
  have hv : oneOccurrenceGadget M i j r c = X w := (Finset.mem_filter.mp h).2
  cases r with
  | inl r =>
    cases c with
    | inl c =>
      have hh : (C (2:ℂ) : MvPolynomial σ ℂ) = X w := by
        simpa only [map_ofNat] using (show (2 : MvPolynomial σ ℂ) = X w by simpa [oneOccurrenceGadget] using hv)
      exact (constant_ne_variable 2 w hh).elim
    | inr c =>
      have hh : (0 : MvPolynomial σ ℂ) = X w := by simpa [oneOccurrenceGadget] using hv
      exact (X_ne_zero w hh.symm).elim
  | inr r =>
    cases c with
    | inl c =>
      have hh : (0 : MvPolynomial σ ℂ) = X w := by simpa [oneOccurrenceGadget] using hv
      exact (X_ne_zero w hh.symm).elim
    | inr c =>
      change (M.updateRow i (Function.update (M i) j (C (1/2 : ℂ)))) r c = X w at hv
      by_cases hr : r = i
      · subst r
        by_cases hc : c = j
        · subst c
          simp only [Matrix.updateRow_self,Function.update_self] at hv
          exact (constant_ne_variable (1/2) w hv).elim
        · simp only [Matrix.updateRow_self,Function.update_of_ne hc] at hv
          exact Finset.mem_image.mpr ⟨(i,c),by simp [occurrences,hv],rfl⟩
      · simp only [Matrix.updateRow_ne hr] at hv
        exact Finset.mem_image.mpr ⟨(r,c),by simp [occurrences,hv],rfl⟩

theorem oneOccurrenceGadget_card_le (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (i j : Fin n) (w : σ) :
    (occurrences (oneOccurrenceGadget M i j) w).card ≤ (occurrences M w).card :=
  (Finset.card_le_card (oneOccurrenceGadget_occurrences M i j w)).trans Finset.card_image_le

theorem oneOccurrenceGadget_eliminates (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (v : σ) (i j : Fin n) (hcover : ∀ r c, M r c = X v → r = i ∧ c = j) :
    occurrences (oneOccurrenceGadget M i j) v = ∅ := by
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro ⟨r,c⟩ h
  have hv := (Finset.mem_filter.mp h).2
  obtain ⟨⟨r',c'⟩,hmem,heq⟩ := Finset.mem_image.mp (oneOccurrenceGadget_occurrences M i j v h)
  have hm : M r' c' = X v := (Finset.mem_filter.mp hmem).2
  obtain ⟨rfl,rfl⟩ := hcover r' c' hm
  cases heq
  have hh : (C (1/2 : ℂ) : MvPolynomial σ ℂ) = X v := by
    simpa [oneOccurrenceGadget] using hv
  exact constant_ne_variable (1/2) v hh

theorem oneOccurrenceGadget_with_invariant (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (i j : Fin n)
    (hentry : M i j = X v) (hcover : ∀ r c, M r c = X v → r = i ∧ c = j) :
    IsSubstMatrix (oneOccurrenceGadget M i j) ∧
    (oneOccurrenceGadget M i j).permanent = substitute v 0 M.permanent + substitute v 1 M.permanent ∧
    occurrences (oneOccurrenceGadget M i j) v = ∅ ∧
    ∀ w, (occurrences (oneOccurrenceGadget M i j) w).card ≤ (occurrences M w).card :=
  ⟨oneOccurrenceGadget_entries M hM i j,oneOccurrenceGadget_sum M hM v i j hentry hcover,
    oneOccurrenceGadget_eliminates M v i j hcover,oneOccurrenceGadget_card_le M i j⟩

/-- When the selector does not occur, a scalar block supplies the factor two. -/
noncomputable def absentOccurrenceGadget (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) :
    Matrix (Fin 1 ⊕ Fin n) (Fin 1 ⊕ Fin n) (MvPolynomial σ ℂ) :=
  Matrix.fromBlocks (Matrix.of fun _ _ => 2) 0 0 M

theorem absentOccurrenceGadget_entries (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) : IsSubstMatrix (absentOccurrenceGadget M) := by
  apply IsSubstMatrix.fromBlocks
  · intro _ _
    simpa only [Matrix.of_apply,map_ofNat] using (IsSubstEntry.C (σ := σ) 2)
  · exact IsSubstMatrix.zero
  · exact IsSubstMatrix.zero
  · exact hM

theorem absentOccurrenceGadget_sum (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (habs : ∀ i j, M i j ≠ X v) :
    (absentOccurrenceGadget M).permanent =
      substitute v 0 M.permanent + substitute v 1 M.permanent := by
  have hmap (z : ℂ) : M.map (substitute v z) = M := by
    apply Matrix.ext
    intro i j
    exact substitute_entry_ne (hM i j) v z (habs i j)
  rw [AlgHom.map_permanent,hmap 0,AlgHom.map_permanent,hmap 1]
  rw [absentOccurrenceGadget,Matrix.permanent_fromBlocks_zero,Matrix.permanent_unique]
  simp [two_mul]

theorem absentOccurrenceGadget_occurrences (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (w : σ) : occurrences (absentOccurrenceGadget M) w ⊆
      (occurrences M w).image (fun ij => (Sum.inr ij.1,Sum.inr ij.2)) := by
  intro ⟨r,c⟩ h
  have hv : absentOccurrenceGadget M r c = X w := (Finset.mem_filter.mp h).2
  cases r with
  | inl r =>
    cases c with
    | inl c =>
      have hh : (C (2:ℂ) : MvPolynomial σ ℂ) = X w := by
        simpa only [map_ofNat] using (show (2 : MvPolynomial σ ℂ) = X w by simpa [absentOccurrenceGadget] using hv)
      exact (constant_ne_variable 2 w hh).elim
    | inr c =>
      have hh : (0 : MvPolynomial σ ℂ) = X w := by simpa [absentOccurrenceGadget] using hv
      exact (X_ne_zero w hh.symm).elim
  | inr r =>
    cases c with
    | inl c =>
      have hh : (0 : MvPolynomial σ ℂ) = X w := by simpa [absentOccurrenceGadget] using hv
      exact (X_ne_zero w hh.symm).elim
    | inr c =>
      change M r c = X w at hv
      exact Finset.mem_image.mpr ⟨(r,c),by simp [occurrences,hv],rfl⟩

theorem absentOccurrenceGadget_with_invariant (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (habs : ∀ i j, M i j ≠ X v) :
    IsSubstMatrix (absentOccurrenceGadget M) ∧
    (absentOccurrenceGadget M).permanent = substitute v 0 M.permanent + substitute v 1 M.permanent ∧
    occurrences (absentOccurrenceGadget M) v = ∅ ∧
    ∀ w, (occurrences (absentOccurrenceGadget M) w).card ≤ (occurrences M w).card := by
  refine ⟨absentOccurrenceGadget_entries M hM,absentOccurrenceGadget_sum M hM v habs,?_,?_⟩
  · apply Finset.eq_empty_iff_forall_notMem.mpr
    intro ij hij
    obtain ⟨⟨r,c⟩,hm,_⟩ := Finset.mem_image.mp (absentOccurrenceGadget_occurrences M v hij)
    exact habs r c (Finset.mem_filter.mp hm).2
  · intro w
    exact (Finset.card_le_card (absentOccurrenceGadget_occurrences M w)).trans Finset.card_image_le

/-- Replacing two matrix entries by constants cannot introduce variable occurrences. -/
theorem setTwo_constant_occurrences (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (i j k l : Fin n) (z : ℂ) (w : σ) :
    occurrences (setTwo M i j k l (C z)) w ⊆ occurrences M w := by
  intro ⟨r,c⟩ h
  have hv := (Finset.mem_filter.mp h).2
  change (if (r = i ∧ c = j) ∨ (r = k ∧ c = l) then C z else M r c) = X w at hv
  split_ifs at hv
  · exact (constant_ne_variable z w hv).elim
  · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,hv⟩

theorem setTwo_constant_eliminates (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (i j k l : Fin n) (z : ℂ) (v : σ)
    (hcover : ∀ r c, M r c = X v → (r = i ∧ c = j) ∨ (r = k ∧ c = l)) :
    occurrences (setTwo M i j k l (C z)) v = ∅ := by
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro ⟨r,c⟩ h
  have hv := (Finset.mem_filter.mp h).2
  have hm : M r c = X v := (Finset.mem_filter.mp (setTwo_constant_occurrences M i j k l z v h)).2
  have hc := hcover r c hm
  change (if (r = i ∧ c = j) ∨ (r = k ∧ c = l) then C z else M r c) = X v at hv
  rw [if_pos hc] at hv
  exact constant_ne_variable z v hv

noncomputable def sameRowGadget (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (i j k : Fin n) := absentOccurrenceGadget (setTwo M i j i k (C (1/2 : ℂ)))

theorem sameRowGadget_with_invariant (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (i j k : Fin n)
    (hfirst : M i j = X v) (hsecond : M i k = X v)
    (hcover : ∀ r c, M r c = X v → (r = i ∧ c = j) ∨ (r = i ∧ c = k)) :
    IsSubstMatrix (sameRowGadget M i j k) ∧
    (sameRowGadget M i j k).permanent = substitute v 0 M.permanent + substitute v 1 M.permanent ∧
    occurrences (sameRowGadget M i j k) v = ∅ ∧
    ∀ w, (occurrences (sameRowGadget M i j k) w).card ≤ (occurrences M w).card := by
  let H := setTwo M i j i k (C (1/2 : ℂ))
  have hH : IsSubstMatrix H := by
    intro r c
    change IsSubstEntry (if (r = i ∧ c = j) ∨ (r = i ∧ c = k) then C (1/2 : ℂ) else M r c)
    split_ifs <;> first | exact IsSubstEntry.C _ | exact hM r c
  have hupdate (z : ℂ) : setTwo M i j i k (C z) =
      M.updateRow i (Function.update (Function.update (M i) j (C z)) k (C z)) := by
    apply Matrix.ext
    intro r c
    by_cases hr : r = i <;> by_cases hj : c = j <;> by_cases hk : c = k <;>
      simp [setTwo,Matrix.updateRow,Function.update,hr,hj,hk]
  have h0 := substitute_matrix M hM v i j i k 0 hfirst hsecond hcover
  have h1 := substitute_matrix M hM v i j i k 1 hfirst hsecond hcover
  have hhalf : 2*(C (1/2 : ℂ) : MvPolynomial σ ℂ) = 1 := by
    simpa only [map_mul,map_ofNat,map_one] using
      congrArg (C : ℂ → MvPolynomial σ ℂ) (by norm_num : (2 : ℂ)*(1/2)=1)
  refine ⟨absentOccurrenceGadget_entries H hH,?_,?_,?_⟩
  · rw [AlgHom.map_permanent,h0,AlgHom.map_permanent,h1,hupdate 0,hupdate 1]
    simp only [map_zero,map_one]
    rw [Matrix.permanent_updateRow_two_boolean M i j k _ hhalf]
    change (absentOccurrenceGadget H).permanent = _
    rw [absentOccurrenceGadget,Matrix.permanent_fromBlocks_zero,Matrix.permanent_unique]
    simp only [Matrix.of_apply]
    congr 1
    exact congrArg Matrix.permanent (hupdate (1/2))
  · apply Finset.eq_empty_iff_forall_notMem.mpr
    intro ij hij
    obtain ⟨q,hq,_⟩ := Finset.mem_image.mp (absentOccurrenceGadget_occurrences H v hij)
    have hz := setTwo_constant_eliminates M i j i k (1/2) v hcover
    change occurrences H v = ∅ at hz
    rw [hz] at hq
    exact Finset.notMem_empty _ hq
  · intro w
    calc
      (occurrences (sameRowGadget M i j k) w).card ≤ (occurrences H w).card :=
        (Finset.card_le_card (absentOccurrenceGadget_occurrences H w)).trans Finset.card_image_le
      _ ≤ (occurrences M w).card := Finset.card_le_card (setTwo_constant_occurrences M i j i k (1/2) w)

/-- The shared-column case follows from the shared-row gadget by transposition. -/
theorem sameColumnGadget_with_invariant (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (i j k : Fin n)
    (hfirst : M j i = X v) (hsecond : M k i = X v)
    (hcover : ∀ r c, M r c = X v → (r = j ∧ c = i) ∨ (r = k ∧ c = i)) :
    IsSubstMatrix (sameRowGadget M.transpose i j k) ∧
    (sameRowGadget M.transpose i j k).permanent = substitute v 0 M.permanent + substitute v 1 M.permanent ∧
    occurrences (sameRowGadget M.transpose i j k) v = ∅ ∧
    ∀ w, (occurrences (sameRowGadget M.transpose i j k) w).card ≤ (occurrences M w).card := by
  have ht : IsSubstMatrix M.transpose := fun r c => hM c r
  have hc : ∀ r c, M.transpose r c = X v → (r = i ∧ c = j) ∨ (r = i ∧ c = k) := by
    intro r c h
    rcases hcover c r h with ⟨h1,h2⟩ | ⟨h1,h2⟩
    · exact Or.inl ⟨h2,h1⟩
    · exact Or.inr ⟨h2,h1⟩
  obtain ⟨he,hs,hv,ho⟩ := sameRowGadget_with_invariant M.transpose ht v i j k hfirst hsecond hc
  refine ⟨he,?_,hv,?_⟩
  · simpa only [Matrix.permanent_transpose] using hs
  · intro w
    exact (ho w).trans_eq (transpose_occurrences_card M w)

/-- Standardize an explicit sum-indexed gadget to `Fin (d+n)`. -/
theorem standardize_gadget {d : ℕ} (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (v : σ) (G : Matrix (Fin d ⊕ Fin n) (Fin d ⊕ Fin n) (MvPolynomial σ ℂ))
    (hd : d ≤ 3) (hG : IsSubstMatrix G)
    (hs : G.permanent = substitute v 0 M.permanent + substitute v 1 M.permanent)
    (he : occurrences G v = ∅)
    (hb : ∀ w,(occurrences G w).card ≤ (occurrences M w).card) :
    ∃ m ≤ n+3, ∃ N : Matrix (Fin m) (Fin m) (MvPolynomial σ ℂ),
      IsSubstMatrix N ∧ N.permanent = substitute v 0 M.permanent + substitute v 1 M.permanent ∧
      occurrences N v = ∅ ∧ ∀ w,(occurrences N w).card ≤ (occurrences M w).card := by
  obtain ⟨N,hN,hp,hn,hb'⟩ := finite_reindex_witness finSumFinEquiv.symm G M v hG he hb
  exact ⟨d+n,by omega,N,hN,hp.trans hs,hn,hb'⟩

/-- The explicit gadget simultaneously computes the Boolean sum, eliminates
    the selected variable, and preserves the occurrence bounds of all others. -/
theorem selector_sum_with_occurrence_invariant
    (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (i j k l : Fin n)
    (hik : i ≠ k) (hjl : j ≠ l)
    (hfirst : M i j = X v) (hsecond : M k l = X v)
    (hcover : ∀ r c, M r c = X v → (r = i ∧ c = j) ∨ (r = k ∧ c = l)) :
    ∃ e : Equiv.Perm (Fin n),
      let G := gadget (M.submatrix id e) i k
      IsSubstMatrix G ∧
      G.permanent = substitute v 0 M.permanent + substitute v 1 M.permanent ∧
      occurrences G v = ∅ ∧
      ∀ w, (occurrences G w).card ≤ (occurrences M w).card := by
  obtain ⟨e,hei,hek⟩ := exists_two_point_permutation i k j l hik hjl
  refine ⟨e,gadget_entries (hM.submatrix id e) i k,?_,?_,?_⟩
  · rw [gadget_boolean_sum _ i k hik,
      reindex_cleared M i j k l e hei hek,reindex_restored M i j k l hik e hei hek]
    have hperm (N : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) :
        (N.submatrix id e).permanent = N.permanent :=
      Matrix.permanent_submatrix_equiv_equiv (Equiv.refl _) e N
    simp only [hperm,AlgHom.map_permanent,substitute_matrix M hM v i j k l 0 hfirst hsecond hcover,
      substitute_matrix M hM v i j k l 1 hfirst hsecond hcover,map_zero,map_one]
  · apply gadget_eliminates
    intro r c hv
    have hc := hcover r (e c) hv
    rcases hc with ⟨hr,hc⟩ | ⟨hr,hc⟩
    · exact Or.inl ⟨hr,e.injective (hc.trans hei.symm)⟩
    · exact Or.inr ⟨hr,e.injective (hc.trans hek.symm)⟩
  · intro w
    exact reindexed_gadget_occurrences_card_le M e i k w

/-- Eliminate a selector with zero, one, or two explicitly specified occurrences. -/
theorem eliminate_two_covered (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (i j k l : Fin n)
    (hfirst : M i j = X v) (hsecond : M k l = X v)
    (hcover : ∀ r c, M r c = X v → (r = i ∧ c = j) ∨ (r = k ∧ c = l)) :
    ∃ m ≤ n+3, ∃ N : Matrix (Fin m) (Fin m) (MvPolynomial σ ℂ),
      IsSubstMatrix N ∧ N.permanent = substitute v 0 M.permanent + substitute v 1 M.permanent ∧
      occurrences N v = ∅ ∧ ∀ w,(occurrences N w).card ≤ (occurrences M w).card := by
  by_cases hr : i = k
  · subst k
    obtain ⟨he,hs,hv,ho⟩ := sameRowGadget_with_invariant M hM v i j l hfirst hsecond hcover
    exact standardize_gadget M v _ (by decide) he hs hv ho
  · by_cases hc : j = l
    · subst l
      obtain ⟨he,hs,hv,ho⟩ := sameColumnGadget_with_invariant M hM v j i k hfirst hsecond hcover
      exact standardize_gadget M v _ (by decide) he hs hv ho
    · obtain ⟨e,he,hs,hv,ho⟩ :=
        selector_sum_with_occurrence_invariant M hM v i j k l hr hc hfirst hsecond hcover
      exact standardize_gadget M v _ (by decide) he hs hv ho

/-- Eliminate any selector occurring at most twice, adding at most three
    dimensions and preserving all other occurrence bounds. -/
theorem eliminate_at_most_two (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (v : σ) (hcard : (occurrences M v).card ≤ 2) :
    ∃ m ≤ n+3, ∃ N : Matrix (Fin m) (Fin m) (MvPolynomial σ ℂ),
      IsSubstMatrix N ∧ N.permanent = substitute v 0 M.permanent + substitute v 1 M.permanent ∧
      occurrences N v = ∅ ∧ ∀ w,(occurrences N w).card ≤ (occurrences M w).card := by
  by_cases hz : (occurrences M v).card = 0
  · have hempty := Finset.card_eq_zero.mp hz
    have habs : ∀ i j, M i j ≠ X v := by
      intro i j h
      have hm : (i,j) ∈ occurrences M v := Finset.mem_filter.mpr ⟨Finset.mem_univ _,h⟩
      rw [hempty] at hm
      exact Finset.notMem_empty _ hm
    obtain ⟨he,hs,hv,ho⟩ := absentOccurrenceGadget_with_invariant M hM v habs
    exact standardize_gadget M v _ (by decide) he hs hv ho
  · by_cases ho : (occurrences M v).card = 1
    · obtain ⟨⟨i,j⟩,hset⟩ := Finset.card_eq_one.mp ho
      have hentry : M i j = X v := by
        have hm : (i,j) ∈ occurrences M v := by rw [hset]; simp
        exact (Finset.mem_filter.mp hm).2
      have hcover : ∀ r c, M r c = X v → r = i ∧ c = j := by
        intro r c h
        have hm : (r,c) ∈ occurrences M v := Finset.mem_filter.mpr ⟨Finset.mem_univ _,h⟩
        rw [hset] at hm
        exact Prod.mk.inj (Finset.mem_singleton.mp hm)
      obtain ⟨he,hs,hv,hbound⟩ := oneOccurrenceGadget_with_invariant M hM v i j hentry hcover
      exact standardize_gadget M v _ (by decide) he hs hv hbound
    · have ht : (occurrences M v).card = 2 := by omega
      obtain ⟨⟨i,j⟩,⟨k,l⟩,hne,hset⟩ := Finset.card_eq_two.mp ht
      have hfirst : M i j = X v := by
        have hm : (i,j) ∈ occurrences M v := by rw [hset]; simp
        exact (Finset.mem_filter.mp hm).2
      have hsecond : M k l = X v := by
        have hm : (k,l) ∈ occurrences M v := by rw [hset]; simp
        exact (Finset.mem_filter.mp hm).2
      have hcover : ∀ r c, M r c = X v → (r = i ∧ c = j) ∨ (r = k ∧ c = l) := by
        intro r c h
        have hm : (r,c) ∈ occurrences M v := Finset.mem_filter.mpr ⟨Finset.mem_univ _,h⟩
        rw [hset] at hm
        rcases Finset.mem_insert.mp hm with he | he
        · exact Or.inl (Prod.mk.inj he)
        · exact Or.inr (Prod.mk.inj (Finset.mem_singleton.mp he))
      exact eliminate_two_covered M hM v i j k l hfirst hsecond hcover


end PermanentSelectorSubstitution


-- From Solutions.PermanentSelectorIteration

namespace PermanentSelectorIteration
open MvPolynomial ResultantVNP PermanentFoundation PermanentOccurrence PermanentSelectorSubstitution

variable {σ : Type} [DecidableEq σ]

/-- Successively sum a polynomial over the Boolean values of the listed variables. -/
noncomputable def booleanSum : List σ → MvPolynomial σ ℂ → MvPolynomial σ ℂ
  | [], p => p
  | v :: vs, p => booleanSum vs (substitute v 0 p + substitute v 1 p)

@[simp] theorem booleanSum_add (vs : List σ) (p q : MvPolynomial σ ℂ) :
    booleanSum vs (p+q) = booleanSum vs p + booleanSum vs q := by
  induction vs generalizing p q with
  | nil => rfl
  | cons v vs ih =>
    simp only [booleanSum,map_add]
    rw [show substitute v 0 p + substitute v 0 q + (substitute v 1 p + substitute v 1 q) =
      (substitute v 0 p + substitute v 1 p) + (substitute v 0 q + substitute v 1 q) by ac_rfl]
    exact ih _ _

@[simp] theorem booleanSum_zero (vs : List σ) : booleanSum vs 0 = 0 := by
  induction vs with
  | nil => rfl
  | cons v vs ih => simp [booleanSum,ih]

theorem booleanSum_append (us vs : List σ) (p : MvPolynomial σ ℂ) :
    booleanSum (us ++ vs) p = booleanSum vs (booleanSum us p) := by
  induction us generalizing p with
  | nil => rfl
  | cons u us ih => simpa only [List.cons_append,booleanSum] using ih _

/-- Substituting distinct variables commutes. -/
theorem substitute_commute (u v : σ) (huv : u ≠ v) (a b : ℂ)
    (p : MvPolynomial σ ℂ) :
    substitute u a (substitute v b p) = substitute v b (substitute u a p) := by
  have he : (substitute u a).comp (substitute v b) =
      (substitute v b).comp (substitute u a) := by
    apply MvPolynomial.algHom_ext
    intro x
    by_cases hu : x = u <;> by_cases hv : x = v <;>
      simp [AlgHom.comp_apply,substitute_X,substitute_C,hu,hv,huv,Ne.symm huv] at *
  exact DFunLike.congr_fun he p

/-- A substitution commutes with summation over other variables. -/
theorem substitute_booleanSum (u : σ) (a : ℂ) (vs : List σ) (hu : u ∉ vs)
    (p : MvPolynomial σ ℂ) :
    substitute u a (booleanSum vs p) = booleanSum vs (substitute u a p) := by
  induction vs generalizing p with
  | nil => rfl
  | cons v vs ih =>
    have huv : u ≠ v := by simp only [List.mem_cons,not_or] at hu; exact hu.1
    have hut : u ∉ vs := by simp only [List.mem_cons,not_or] at hu; exact hu.2
    simp only [booleanSum]
    rw [ih hut, map_add, substitute_commute u v huv a 0,substitute_commute u v huv a 1]

/-- With distinct variables, the first Boolean sum can be taken last. -/
theorem booleanSum_cons_outer (v : σ) (vs : List σ) (hv : v ∉ vs)
    (p : MvPolynomial σ ℂ) :
    booleanSum (v :: vs) p =
      substitute v 0 (booleanSum vs p) + substitute v 1 (booleanSum vs p) := by
  simp only [booleanSum,booleanSum_add,substitute_booleanSum v 0 vs hv,
    substitute_booleanSum v 1 vs hv]

/-- Boolean summation is independent of the order of the selectors. -/
theorem booleanSum_perm {us vs : List σ} (h : us.Perm vs) (p : MvPolynomial σ ℂ) :
    booleanSum us p = booleanSum vs p := by
  induction h generalizing p with
  | nil => rfl
  | cons v h ih =>
    simp only [booleanSum]
    exact ih _
  | swap u v vs =>
    by_cases huv : u = v
    · subst v; rfl
    · simp only [booleanSum,map_add]
      rw [substitute_commute u v huv 0 0,substitute_commute u v huv 1 0,
        substitute_commute u v huv 0 1,substitute_commute u v huv 1 1]
      apply congrArg (booleanSum vs)
      ac_rfl
  | trans h1 h2 ih1 ih2 => exact (ih1 p).trans (ih2 p)

/-- Evaluate a list of selector assignments in the same order as `booleanSum`. -/
noncomputable def assignmentValue : (vs : List σ) → (Fin vs.length → Bool) →
    MvPolynomial σ ℂ → MvPolynomial σ ℂ
  | [], _, p => p
  | v :: vs, bits, p =>
      assignmentValue vs (fun i => bits i.succ) (substitute v (if bits 0 then 1 else 0) p)

/-- The sequential assignment as an algebra homomorphism. -/
noncomputable def assignmentHom : (vs : List σ) → (Fin vs.length → Bool) →
    (MvPolynomial σ ℂ →ₐ[ℂ] MvPolynomial σ ℂ)
  | [], _ => AlgHom.id ℂ (MvPolynomial σ ℂ)
  | v :: vs, bits => (assignmentHom vs (fun i => bits i.succ)).comp
      (substitute v (if bits 0 then 1 else 0))

theorem assignmentHom_apply (vs : List σ) (bits : Fin vs.length → Bool)
    (p : MvPolynomial σ ℂ) : assignmentHom vs bits p = assignmentValue vs bits p := by
  induction vs generalizing p with
  | nil => rfl
  | cons v vs ih => exact ih _ _

/-- Every sequential assignment is one simultaneous `aeval` substitution. -/
theorem assignmentValue_eq_aeval (vs : List σ) (bits : Fin vs.length → Bool)
    (p : MvPolynomial σ ℂ) :
    assignmentValue vs bits p = aeval (fun x => assignmentValue vs bits (X x)) p := by
  have he : assignmentHom vs bits = aeval (fun x => assignmentValue vs bits (X x)) := by
    apply MvPolynomial.algHom_ext
    intro x
    simp only [aeval_X,assignmentHom_apply]
  simpa only [assignmentHom_apply] using DFunLike.congr_fun he p

@[simp] theorem assignmentValue_C (vs : List σ) (bits : Fin vs.length → Bool) (c : ℂ) :
    assignmentValue vs bits (C c) = C c := by
  induction vs with
  | nil => rfl
  | cons v vs ih =>
    simp only [assignmentValue, substitute_C]
    exact ih _

theorem assignmentValue_X_not_mem (vs : List σ) (bits : Fin vs.length → Bool)
    (x : σ) (hx : x ∉ vs) : assignmentValue vs bits (X x) = X x := by
  induction vs with
  | nil => rfl
  | cons v vs ih =>
    simp only [List.mem_cons, not_or] at hx
    simp only [assignmentValue, substitute_X, if_neg hx.1]
    exact ih _ hx.2

theorem assignmentValue_X_get (vs : List σ) (bits : Fin vs.length → Bool)
    (h : vs.Nodup) (i : Fin vs.length) :
    assignmentValue vs bits (X (vs.get i)) = C (if bits i then 1 else 0) := by
  induction vs with
  | nil => exact Fin.elim0 i
  | cons v vs ih =>
    have hn := List.nodup_cons.mp h
    refine Fin.cases ?_ (fun j => ?_) i
    · change assignmentValue vs (fun k => bits k.succ)
          (substitute v (if bits 0 then 1 else 0) (X v)) = _
      rw [substitute_X]
      simp only [if_true]
      exact assignmentValue_C _ _ _
    · have hv : vs.get j ≠ v := by
        intro he
        apply hn.1
        rw [← he]
        exact List.get_mem vs j
      change assignmentValue vs (fun k => bits k.succ)
          (substitute v (if bits 0 then 1 else 0) (X (vs.get j))) = _
      simpa only [substitute_X, if_neg hv] using ih (fun k => bits k.succ) hn.2 j

/-- Simultaneous substitution maps every listed variable to its assigned bit
    and leaves every other variable unchanged. -/
noncomputable def simultaneousAssignment (vs : List σ) (bits : Fin vs.length → Bool)
    (x : σ) : MvPolynomial σ ℂ :=
  if hx : x ∈ vs then C (if bits ⟨vs.idxOf x, List.idxOf_lt_length_of_mem hx⟩ then 1 else 0)
  else X x

theorem assignmentValue_eq_simultaneous (vs : List σ) (bits : Fin vs.length → Bool)
    (h : vs.Nodup) (p : MvPolynomial σ ℂ) :
    assignmentValue vs bits p = aeval (simultaneousAssignment vs bits) p := by
  rw [assignmentValue_eq_aeval]
  have heq : (fun x => assignmentValue vs bits (X x)) = simultaneousAssignment vs bits := by
    funext x
    by_cases hx : x ∈ vs
    · simp only [simultaneousAssignment, dif_pos hx]
      have he := assignmentValue_X_get vs bits h ⟨vs.idxOf x, List.idxOf_lt_length_of_mem hx⟩
      simpa only [List.idxOf_get] using he
    · simp only [simultaneousAssignment, dif_neg hx]
      exact assignmentValue_X_not_mem vs bits x hx
  rw [heq]

/-- The iterated operation equals the sum over all Boolean assignments. -/
theorem booleanSum_eq_assignment_sum (vs : List σ) (p : MvPolynomial σ ℂ) :
    booleanSum vs p = ∑ bits : Fin vs.length → Bool, assignmentValue vs bits p := by
  induction vs generalizing p with
  | nil => simp [booleanSum,assignmentValue]
  | cons v vs ih =>
    change booleanSum vs (substitute v 0 p + substitute v 1 p) = _
    rw [booleanSum_add,ih,ih]
    have he := (Fin.consEquiv (fun _ : Fin (vs.length+1) => Bool)).sum_comp
      (fun bits => assignmentValue (v :: vs) bits p)
    refine (show _ = ∑ pair : Bool × (Fin vs.length → Bool),
      assignmentValue (v :: vs) ((Fin.consEquiv (fun _ : Fin (vs.length+1) => Bool)) pair) p from ?_).trans he
    simp only [Fintype.sum_prod_type]
    simp [assignmentValue,Fin.cons_zero,Fin.cons_succ,Fintype.sum_bool,add_comm]

/-- Boolean summation agrees with the usual sum of simultaneous evaluations. -/
theorem booleanSum_eq_simultaneous_sum (vs : List σ) (h : vs.Nodup)
    (p : MvPolynomial σ ℂ) :
    booleanSum vs p = ∑ bits : Fin vs.length → Bool,
      aeval (simultaneousAssignment vs bits) p := by
  rw [booleanSum_eq_assignment_sum]
  apply Finset.sum_congr rfl
  intro bits _
  exact assignmentValue_eq_simultaneous vs bits h p

/-- A sequence of selectors with at most two occurrences each can be eliminated
    with at most three new matrix dimensions per selector. -/
theorem eliminate_list (vs : List σ) {n : ℕ}
    (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) (hM : IsSubstMatrix M)
    (hocc : ∀ v ∈ vs, (occurrences M v).card ≤ 2) :
    ∃ m ≤ n + 3*vs.length, ∃ N : Matrix (Fin m) (Fin m) (MvPolynomial σ ℂ),
      IsSubstMatrix N ∧ N.permanent = booleanSum vs M.permanent ∧
      (∀ v ∈ vs, occurrences N v = ∅) ∧
      ∀ w,(occurrences N w).card ≤ (occurrences M w).card := by
  induction vs generalizing n with
  | nil =>
    refine ⟨n,by simp,M,hM,rfl,?_,fun _ => le_rfl⟩
    simp
  | cons v vs ih =>
    have hv : (occurrences M v).card ≤ 2 := hocc v (by simp)
    obtain ⟨m,hm,N,hN,hval,hfree,hbound⟩ := eliminate_at_most_two M hM v hv
    have htail : ∀ w ∈ vs, (occurrences N w).card ≤ 2 := by
      intro w hw
      exact (hbound w).trans (hocc w (by simp [hw]))
    obtain ⟨k,hk,P,hP,hPval,hPfree,hPbound⟩ := ih N hN htail
    refine ⟨k,?_,P,hP,?_,?_,?_⟩
    · simp only [List.length_cons]
      omega
    · simpa only [booleanSum,← hval] using hPval
    · intro w hw
      simp only [List.mem_cons] at hw
      rcases hw with rfl | hw
      · apply Finset.card_eq_zero.mp
        have hh := hPbound w
        rw [hfree] at hh
        simpa using hh
      · exact hPfree w hw
    · intro w
      exact (hPbound w).trans (hbound w)

/-- The iterated Boolean sum is a projection of a permanent whose dimension
    grows linearly in the number of eliminated selectors. -/
theorem booleanSum_isProjection (vs : List σ) {n : ℕ}
    (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) (hM : IsSubstMatrix M)
    (hocc : ∀ v ∈ vs, (occurrences M v).card ≤ 2) :
    ∃ m ≤ n + 3*vs.length,
      IsProjection (booleanSum vs M.permanent) (genericMatrix m).permanent := by
  obtain ⟨m,hm,N,hN,hval,_,_⟩ := eliminate_list vs M hM hocc
  refine ⟨m,hm,?_⟩
  rw [← hval]
  exact hN.isProjection_permanent (Equiv.refl _)

/-- Summing a permanent over all simultaneous Boolean assignments preserves
    permanent projections when each selector appears in at most two entries. -/
theorem simultaneous_sum_isProjection (vs : List σ) (h : vs.Nodup) {n : ℕ}
    (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) (hM : IsSubstMatrix M)
    (hocc : ∀ v ∈ vs, (occurrences M v).card ≤ 2) :
    ∃ m ≤ n + 3*vs.length,
      IsProjection (∑ bits : Fin vs.length → Bool,
        aeval (simultaneousAssignment vs bits) M.permanent) (genericMatrix m).permanent := by
  rw [← booleanSum_eq_simultaneous_sum vs h M.permanent]
  exact booleanSum_isProjection vs M hM hocc

end PermanentSelectorIteration


-- From Solutions.PermanentEqualityCombine

namespace PermanentEqualityCombine

open MvPolynomial PermanentFoundation PermanentOccurrence PermanentSelectorIteration

variable {σ : Type} [DecidableEq σ]

/-- Equality polynomial for the variables in a list. -/
noncomputable def equalityPolynomial (vs : List σ) : MvPolynomial σ ℂ :=
  (∏ i : Fin vs.length, X (vs.get i)) + ∏ i : Fin vs.length, (1 - X (vs.get i))

theorem assignment_equalityPolynomial (vs : List σ) (h : vs.Nodup)
    (bits : Fin vs.length → Bool) :
    assignmentValue vs bits (equalityPolynomial vs) =
      (PermanentEqualitySelector.weight bits : MvPolynomial σ ℂ) := by
  have hx : ∀ i : Fin vs.length, assignmentHom vs bits (X (vs.get i)) =
      (if bits i then 1 else 0) := by
    intro i
    rw [assignmentHom_apply, assignmentValue_X_get vs bits h i]
    cases hb : bits i <;> simp [hb]
  rw [← assignmentHom_apply]
  simp only [equalityPolynomial, PermanentEqualitySelector.weight, map_add, map_prod, map_sub, map_one, hx]
  congr 1
  apply Finset.prod_congr rfl
  intro i _
  cases hb : bits i <;> simp [hb]

/-- The equality polynomial filters the Boolean sum down to the two constant
    assignments, even when the list is empty. -/
theorem booleanSum_equality (vs : List σ) (h : vs.Nodup) (p : MvPolynomial σ ℂ) :
    booleanSum vs (p * equalityPolynomial vs) =
      assignmentValue vs PermanentEqualitySelector.allTrue p +
      assignmentValue vs PermanentEqualitySelector.allFalse p := by
  rw [booleanSum_eq_assignment_sum]
  have he : ∀ bits : Fin vs.length → Bool,
      assignmentValue vs bits (p * equalityPolynomial vs) =
        PermanentEqualitySelector.weight bits * assignmentValue vs bits p := by
    intro bits
    rw [← assignmentHom_apply, map_mul, assignmentHom_apply, assignmentHom_apply,
      assignment_equalityPolynomial vs h bits, mul_comm]
  simp_rw [he]
  exact PermanentEqualitySelector.sum_weight (fun bits => assignmentValue vs bits p)

theorem equalityPolynomial_ofFn {m : ℕ} (v : Fin m → σ) :
    equalityPolynomial (List.ofFn v) =
      (∏ i, X (v i)) + ∏ i, (1 - X (v i)) := by
  unfold equalityPolynomial
  congr 1 <;>
    apply Fintype.prod_equiv (finCongr (List.length_ofFn (f := v))) <;>
    intro i <;> simp <;> congr 1 <;> apply Fin.ext <;> rfl

/-- A uniform assignment sets exactly the listed variables to the same bit. -/
theorem uniform_assignment_X (vs : List σ) (h : vs.Nodup) (b : Bool) (x : σ) :
    assignmentValue vs (fun _ => b) (X x) =
      if x ∈ vs then C (if b then 1 else 0) else X x := by
  by_cases hx : x ∈ vs
  · simp only [hx, if_true]
    have he := assignmentValue_X_get vs (fun _ => b) h
      ⟨vs.idxOf x, List.idxOf_lt_length_of_mem hx⟩
    simpa only [List.idxOf_get] using he
  · simp only [hx, if_false]
    exact assignmentValue_X_not_mem vs (fun _ => b) x hx

/-- Renaming split variables back to one variable commutes with their uniform
    Boolean evaluation, provided exactly those variables are merged. -/
theorem collapse_uniform_assignment {τ : Type} [DecidableEq τ]
    (vs : List σ) (h : vs.Nodup) (c : σ → τ) (u : τ)
    (hc : ∀ x, c x = u ↔ x ∈ vs) (b : Bool) (p : MvPolynomial σ ℂ) :
    aeval (fun x => (X (c x) : MvPolynomial τ ℂ))
        (assignmentValue vs (fun _ => b) p) =
      PermanentSelectorSubstitution.substitute u (if b then 1 else 0)
        (aeval (fun x => (X (c x) : MvPolynomial τ ℂ)) p) := by
  let ρ : MvPolynomial σ ℂ →ₐ[ℂ] MvPolynomial τ ℂ := aeval (fun x => X (c x))
  have he : ρ.comp (assignmentHom vs (fun _ => b)) =
      (PermanentSelectorSubstitution.substitute u (if b then 1 else 0)).comp ρ := by
    apply MvPolynomial.algHom_ext
    intro x
    simp only [AlgHom.comp_apply, assignmentHom_apply, uniform_assignment_X vs h b x,
      ρ, aeval_X, PermanentSelectorSubstitution.substitute_X]
    by_cases hx : x ∈ vs
    · have hu : c x = u := (hc x).2 hx
      simp [hx,hu]
    · have hu : c x ≠ u := fun he => hx ((hc x).1 he)
      simp [hx,hu]
  simpa only [AlgHom.comp_apply, assignmentHom_apply, ρ] using DFunLike.congr_fun he p

/-- After split variables are renamed back, equality filtering performs the
    original Boolean sum over the shared variable. -/
theorem collapse_booleanSum_equality {τ : Type} [DecidableEq τ]
    (vs : List σ) (h : vs.Nodup) (c : σ → τ) (u : τ)
    (hc : ∀ x, c x = u ↔ x ∈ vs) (p : MvPolynomial σ ℂ) :
    aeval (fun x => (X (c x) : MvPolynomial τ ℂ))
        (booleanSum vs (p * equalityPolynomial vs)) =
      PermanentSelectorSubstitution.substitute u 1
        (aeval (fun x => (X (c x) : MvPolynomial τ ℂ)) p) +
      PermanentSelectorSubstitution.substitute u 0
        (aeval (fun x => (X (c x) : MvPolynomial τ ℂ)) p) := by
  rw [booleanSum_equality vs h p, map_add]
  rw [show PermanentEqualitySelector.allTrue = (fun _ : Fin vs.length => true) from rfl,
      show PermanentEqualitySelector.allFalse = (fun _ : Fin vs.length => false) from rfl]
  simpa using congrArg₂ (· + ·)
    (collapse_uniform_assignment vs h c u hc true p)
    (collapse_uniform_assignment vs h c u hc false p)

/-- Occurrences in a block diagonal matrix are precisely the occurrences in
    its two diagonal blocks, embedded into the larger matrix. -/
theorem block_occurrences {α β : Type} [Fintype α] [Fintype β]
    [DecidableEq α] [DecidableEq β]
    (A : Matrix α α (MvPolynomial σ ℂ)) (B : Matrix β β (MvPolynomial σ ℂ)) (v : σ) :
    occurrences (Matrix.fromBlocks A 0 0 B) v =
      (occurrences A v).image (fun p => (Sum.inl p.1, Sum.inl p.2)) ∪
      (occurrences B v).image (fun p => (Sum.inr p.1, Sum.inr p.2)) := by
  classical
  ext ⟨r,c⟩
  simp only [occurrences, Finset.mem_filter, Finset.mem_univ, true_and]
  cases r <;> cases c <;>
    simp [Matrix.fromBlocks, Ne.symm (MvPolynomial.X_ne_zero v)]

/-- Joining two permanent gadgets adds their variable occurrence counts. -/
theorem block_occurrences_card {α β : Type} [Fintype α] [Fintype β]
    [DecidableEq α] [DecidableEq β]
    (A : Matrix α α (MvPolynomial σ ℂ)) (B : Matrix β β (MvPolynomial σ ℂ)) (v : σ) :
    (occurrences (Matrix.fromBlocks A 0 0 B) v).card =
      (occurrences A v).card + (occurrences B v).card := by
  classical
  rw [block_occurrences, Finset.card_union_of_disjoint]
  · rw [Finset.card_image_iff.mpr, Finset.card_image_iff.mpr]
    · intro x _ y _ he; cases x; cases y; simp_all
    · intro x _ y _ he; cases x; cases y; simp_all
  · apply Finset.disjoint_left.mpr
    intro p hp hq
    obtain ⟨⟨a,b⟩,_,rfl⟩ := Finset.mem_image.mp hp
    obtain ⟨⟨c,d⟩,_,he⟩ := Finset.mem_image.mp hq
    cases he

/-- Multiply a read-once selector matrix by the equality gadget and eliminate
    all selector variables, with a linear bound on the resulting dimension. -/
theorem eliminate_with_equality {n m : ℕ} (A : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hA : IsSubstMatrix A) (v : Fin m → σ) (hv : Function.Injective v)
    (hocc : ∀ i, (occurrences A (v i)).card ≤ 1) :
    ∃ k ≤ n + (2 * m + 1) + 3 * m,
      ∃ N : Matrix (Fin k) (Fin k) (MvPolynomial σ ℂ), IsSubstMatrix N ∧
      N.permanent = PermanentSelectorIteration.booleanSum (List.ofFn v)
        (A.permanent * ((∏ i, X (v i)) + ∏ i, (1 - X (v i)))) ∧
      (∀ i, occurrences N (v i) = ∅) ∧
      (∀ w, (∀ i, v i ≠ w) → (occurrences N w).card ≤ (occurrences A w).card) := by
  obtain ⟨q,hq,B,hB,hBval,hBocc,hBfree⟩ := PermanentEqualityMatrix.equality_matrix_witness m v hv
  let e : Fin (n + q) ≃ Fin n ⊕ Fin q := finSumFinEquiv.symm
  let G := (Matrix.fromBlocks A 0 0 B).submatrix e e
  have hG : IsSubstMatrix G := (hA.fromBlocks .zero .zero hB).submatrix e e
  have hGval : G.permanent = A.permanent * ((∏ i, X (v i)) + ∏ i, (1 - X (v i))) := by
    change ((Matrix.fromBlocks A 0 0 B).submatrix e e).permanent = _
    rw [Matrix.permanent_submatrix_equiv, Matrix.permanent_fromBlocks_zero, hBval]
  have hGocc : ∀ w ∈ List.ofFn v, (occurrences G w).card ≤ 2 := by
    intro w hw
    obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hw
    change (occurrences ((Matrix.fromBlocks A 0 0 B).submatrix e e) (v i)).card ≤ 2
    rw [equiv_occurrences_card, block_occurrences_card]
    have ha := hocc i
    have hb := hBocc i
    omega
  obtain ⟨k,hk,N,hN,hval,hfree,hbound⟩ :=
    PermanentSelectorIteration.eliminate_list (List.ofFn v) G hG hGocc
  refine ⟨k, ?_, N, hN, ?_, ?_, ?_⟩
  · simp only [List.length_ofFn] at hk
    omega
  · simpa only [hGval] using hval
  · intro i
    exact hfree (v i) (List.mem_ofFn.mpr ⟨i,rfl⟩)
  · intro w hw
    have hg : (occurrences G w).card = (occurrences A w).card := by
      change (occurrences ((Matrix.fromBlocks A 0 0 B).submatrix e e) w).card = _
      rw [equiv_occurrences_card, block_occurrences_card, hBfree w hw]
      simp
    exact (hbound w).trans_eq hg

/-- The sum of the two uniform substitutions in a read-once permanent is
    itself a polynomial-size permanent projection. -/
theorem uniform_substitutions_isProjection {n m : ℕ}
    (A : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) (hA : IsSubstMatrix A)
    (v : Fin m → σ) (hv : Function.Injective v)
    (hocc : ∀ i, (occurrences A (v i)).card ≤ 1) :
    ∃ k ≤ n + (2 * m + 1) + 3 * m,
      ResultantVNP.IsProjection
        (assignmentValue (List.ofFn v) PermanentEqualitySelector.allTrue A.permanent +
         assignmentValue (List.ofFn v) PermanentEqualitySelector.allFalse A.permanent)
        (genericMatrix k).permanent := by
  obtain ⟨k,hk,N,hN,hval,_,_⟩ := eliminate_with_equality A hA v hv hocc
  have he : booleanSum (List.ofFn v)
      (A.permanent * ((∏ i, X (v i)) + ∏ i, (1 - X (v i)))) =
      assignmentValue (List.ofFn v) PermanentEqualitySelector.allTrue A.permanent +
      assignmentValue (List.ofFn v) PermanentEqualitySelector.allFalse A.permanent := by
    rw [← equalityPolynomial_ofFn v]
    exact booleanSum_equality (List.ofFn v) (List.nodup_ofFn.mpr hv) A.permanent
  refine ⟨k,hk,?_⟩
  rw [← he, ← hval]
  exact hN.isProjection_permanent (Equiv.refl _)

/-- A Boolean sum over one variable is a small permanent projection when its
    occurrences have first been split into distinct read-once variables. -/
theorem split_then_sum_isProjection {τ : Type} [DecidableEq τ] {n m : ℕ}
    (A : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) (hA : IsSubstMatrix A)
    (v : Fin m → σ) (hv : Function.Injective v)
    (hocc : ∀ i, (occurrences A (v i)).card ≤ 1)
    (c : σ → τ) (u : τ) (hc : ∀ x, c x = u ↔ x ∈ List.ofFn v) :
    ∃ k ≤ n + (2 * m + 1) + 3 * m,
      ResultantVNP.IsProjection
        (PermanentSelectorSubstitution.substitute u 1
            (aeval (fun x => (X (c x) : MvPolynomial τ ℂ)) A.permanent) +
         PermanentSelectorSubstitution.substitute u 0
            (aeval (fun x => (X (c x) : MvPolynomial τ ℂ)) A.permanent))
        (genericMatrix k).permanent := by
  obtain ⟨k,hk,N,hN,hval,_,_⟩ := eliminate_with_equality A hA v hv hocc
  let ρ : MvPolynomial σ ℂ →ₐ[ℂ] MvPolynomial τ ℂ := aeval (fun x => X (c x))
  have hmapped : IsSubstMatrix (N.map ρ) := by
    intro i j
    obtain ⟨s,hs⟩ := hN i j
    cases s with
    | inl x =>
      have he : N i j = X x := hs.symm
      change IsSubstEntry (ρ (N i j))
      rw [he]
      simpa [ρ] using (IsSubstEntry.X (c x))
    | inr a =>
      have he : N i j = C a := hs.symm
      change IsSubstEntry (ρ (N i j))
      rw [he]
      simpa [ρ] using (IsSubstEntry.C a)
  have he : ρ N.permanent =
      PermanentSelectorSubstitution.substitute u 1 (ρ A.permanent) +
      PermanentSelectorSubstitution.substitute u 0 (ρ A.permanent) := by
    rw [hval, ← equalityPolynomial_ofFn v]
    exact collapse_booleanSum_equality (List.ofFn v) (List.nodup_ofFn.mpr hv) c u hc A.permanent
  refine ⟨k,hk,?_⟩
  change ResultantVNP.IsProjection
    (PermanentSelectorSubstitution.substitute u 1 (ρ A.permanent) +
      PermanentSelectorSubstitution.substitute u 0 (ρ A.permanent)) _
  rw [← he, AlgHom.map_permanent]
  exact hmapped.isProjection_permanent (Equiv.refl _)


end PermanentEqualityCombine

-- From Solutions.PermanentSplitVariables

namespace PermanentSplitVariables

open MvPolynomial PermanentFoundation PermanentOccurrence

variable {σ : Type} [DecidableEq σ] {n : ℕ}

/-- Positions in a substitution matrix whose entries are variables. -/
def VariablePosition (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) :=
  {p : Fin n × Fin n // ∃ x, M p.1 p.2 = X x}

noncomputable instance (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) :
    DecidableEq (VariablePosition M) := Classical.decEq _

noncomputable instance (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) :
    Fintype (VariablePosition M) := by
  classical
  unfold VariablePosition
  infer_instance

/-- The original variable appearing at a variable position. -/
noncomputable def originalVariable (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (p : VariablePosition M) : σ := Classical.choose p.property

theorem originalVariable_spec (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (p : VariablePosition M) : M p.1.1 p.1.2 = X (originalVariable M p) :=
  Classical.choose_spec p.property

theorem exists_constant (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (i j : Fin n) (h : ¬ ∃ x, M i j = X x) :
    ∃ c : ℂ, M i j = C c := by
  obtain ⟨s,hs⟩ := hM i j
  cases s with
  | inl x => exact (h ⟨x,hs.symm⟩).elim
  | inr c => exact ⟨c,hs.symm⟩

/-- Replace each variable occurrence by a different variable indexed by its
    matrix position, while leaving constants unchanged. -/
noncomputable def splitMatrix (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) : Matrix (Fin n) (Fin n) (MvPolynomial (VariablePosition M) ℂ) := by
  classical
  exact Matrix.of fun i j =>
    if h : ∃ x, M i j = X x then X ⟨(i,j),h⟩
    else C (Classical.choose (exists_constant M hM i j h))

theorem splitMatrix_isSubstMatrix (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) : IsSubstMatrix (splitMatrix M hM) := by
  classical
  intro i j
  simp only [splitMatrix, Matrix.of_apply]
  split_ifs
  · exact IsSubstEntry.X _
  · exact IsSubstEntry.C _

/-- Merging the fresh variables back into their original labels restores each
    entry of the original matrix. -/
theorem splitMatrix_merge_entry (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (i j : Fin n) :
    aeval (fun p => (X (originalVariable M p) : MvPolynomial σ ℂ))
      (splitMatrix M hM i j) = M i j := by
  classical
  simp only [splitMatrix, Matrix.of_apply]
  split_ifs with h
  · change (aeval (fun p : VariablePosition M => (X (originalVariable M p) : MvPolynomial σ ℂ)))
        (X (⟨(i,j),h⟩ : VariablePosition M)) = M i j
    exact (aeval_X (fun p : VariablePosition M => (X (originalVariable M p) : MvPolynomial σ ℂ))
      ⟨(i,j),h⟩).trans (originalVariable_spec M ⟨(i,j),h⟩).symm
  · rw [aeval_C]
    exact (Classical.choose_spec (exists_constant M hM i j h)).symm

theorem splitMatrix_merge_permanent (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) :
    aeval (fun p => (X (originalVariable M p) : MvPolynomial σ ℂ))
      (splitMatrix M hM).permanent = M.permanent := by
  rw [AlgHom.map_permanent]
  apply congrArg Matrix.permanent
  apply Matrix.ext
  intro i j
  exact splitMatrix_merge_entry M hM i j

/-- A fresh variable can appear only at the position from which it was made. -/
theorem splitMatrix_entry_position (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (p : VariablePosition M) (i j : Fin n)
    (h : splitMatrix M hM i j = X p) : (i,j) = p.val := by
  classical
  simp only [splitMatrix, Matrix.of_apply] at h
  split_ifs at h with hv
  · have he := MvPolynomial.X_injective h
    exact congrArg Subtype.val he
  · exact (constant_ne_variable _ p h).elim

theorem splitMatrix_occurrences_le_one (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hM : IsSubstMatrix M) (p : VariablePosition M) :
    (occurrences (splitMatrix M hM) p).card ≤ 1 := by
  classical
  apply Finset.card_le_one.mpr
  intro a ha b hb
  have ha' := splitMatrix_entry_position M hM p a.1 a.2 (Finset.mem_filter.mp ha).2
  have hb' := splitMatrix_entry_position M hM p b.1 b.2 (Finset.mem_filter.mp hb).2
  exact ha'.trans hb'.symm

/-- The Boolean sum over any one variable of an arbitrary substitution
    matrix is a permanent projection with a quadratic dimension bound. -/
theorem arbitrary_variable_sum_isProjection
    (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) (hM : IsSubstMatrix M) (u : σ) :
    ∃ k ≤ n + (2 * (n * n) + 1) + 3 * (n * n),
      ResultantVNP.IsProjection
        (PermanentSelectorSubstitution.substitute u 1 M.permanent +
         PermanentSelectorSubstitution.substitute u 0 M.permanent)
        (genericMatrix k).permanent := by
  classical
  let S := {p : VariablePosition M // originalVariable M p = u}
  letI : Fintype S := by dsimp [S]; infer_instance
  let e : Fin (Fintype.card S) ≃ S := (Fintype.equivFin S).symm
  let v : Fin (Fintype.card S) → VariablePosition M := fun i => (e i).val
  have hv : Function.Injective v := by
    intro i j he
    apply e.injective
    exact Subtype.ext he
  have hc : ∀ p : VariablePosition M, originalVariable M p = u ↔ p ∈ List.ofFn v := by
    intro p
    simp only [List.mem_ofFn]
    constructor
    · intro hp
      refine ⟨e.symm ⟨p,hp⟩, ?_⟩
      simp [v]
    · rintro ⟨i,hi⟩
      rw [← hi]
      exact (e i).property
  have hcard : Fintype.card S ≤ n * n := by
    have hi : Function.Injective (fun p : S => p.val.val) := by
      intro a b h
      apply Subtype.ext
      apply Subtype.ext
      exact h
    have hh := Fintype.card_le_of_injective (fun p : S => p.val.val) hi
    simpa using hh
  obtain ⟨k,hk,hproj⟩ := PermanentEqualityCombine.split_then_sum_isProjection
    (splitMatrix M hM) (splitMatrix_isSubstMatrix M hM) v hv
    (fun i => splitMatrix_occurrences_le_one M hM (v i)) (originalVariable M) u hc
  rw [splitMatrix_merge_permanent M hM] at hproj
  refine ⟨k, ?_, hproj⟩
  omega


end PermanentSplitVariables

-- From Solutions.PermanentGroupElimination

namespace PermanentGroupElimination

open MvPolynomial PermanentFoundation PermanentOccurrence PermanentSelectorIteration
open PermanentEqualityCombine

variable {σ : Type} [DecidableEq σ]

/-- Evaluate all variables in one group at zero and at one, then add. -/
noncomputable def groupSum (vs : List σ) (p : MvPolynomial σ ℂ) : MvPolynomial σ ℂ :=
  assignmentValue vs PermanentEqualitySelector.allTrue p +
    assignmentValue vs PermanentEqualitySelector.allFalse p

/-- Perform the shared Boolean sums of all groups. -/
noncomputable def groupSums : List (List σ) → MvPolynomial σ ℂ → MvPolynomial σ ℂ
  | [], p => p
  | vs :: rest, p => groupSums rest (groupSum vs p)

def groupCost : List (List σ) → ℕ
  | [] => 0
  | vs :: rest => (2 * vs.length + 1) + 3 * vs.length + groupCost rest

theorem groupCost_eq (groups : List (List σ)) :
    groupCost groups = 5 * groups.flatten.length + groups.length := by
  induction groups with
  | nil => rfl
  | cons g rest ih => simp only [groupCost, List.flatten_cons, List.length_append,
      List.length_cons, ih]; omega

/-- The finite list of fresh variables that map to one original variable. -/
noncomputable def fibreList {α τ : Type} [Fintype α] [DecidableEq τ]
    (c : α → τ) (u : τ) : List α := by
  classical
  exact (Finset.univ.filter (fun x => c x = u)).toList

theorem mem_fibreList {α τ : Type} [Fintype α] [DecidableEq τ]
    (c : α → τ) (u : τ) (x : α) : x ∈ fibreList c u ↔ c x = u := by
  classical
  simp [fibreList]

theorem fibreList_nodup {α τ : Type} [Fintype α] [DecidableEq τ]
    (c : α → τ) (u : τ) : (fibreList c u).Nodup := by
  classical
  exact Finset.nodup_toList _

/-- Distinct original variables have disjoint lists of fresh copies. -/
theorem fibreLists_flatten_nodup {α τ : Type} [Fintype α] [DecidableEq τ]
    (c : α → τ) (us : List τ) (hu : us.Nodup) :
    (us.map (fibreList c)).flatten.Nodup := by
  classical
  induction us with
  | nil => simp
  | cons u rest ih =>
    obtain ⟨hu,hrest⟩ := List.nodup_cons.mp hu
    simp only [List.map_cons, List.flatten_cons]
    apply List.nodup_append'.mpr
    refine ⟨fibreList_nodup c u, ih hrest, ?_⟩
    apply List.disjoint_left.mpr
    intro x hx hxrest
    have hx' := (mem_fibreList c u x).mp hx
    obtain ⟨l,hl,hxl⟩ := List.mem_flatten.mp hxrest
    obtain ⟨w,hw,rfl⟩ := List.mem_map.mp hl
    have hxw := (mem_fibreList c w x).mp hxl
    have : u = w := hx'.symm.trans hxw
    exact hu (this ▸ hw)

/-- The total cost of the fibre groups is linear in the number of fresh
    variables plus the number of original variables being summed. -/
theorem fibreGroups_cost_le {α τ : Type} [Fintype α] [DecidableEq τ]
    (c : α → τ) (us : List τ) (hu : us.Nodup) :
    groupCost (us.map (fibreList c)) ≤ 5 * Fintype.card α + us.length := by
  classical
  have hn := fibreLists_flatten_nodup c us hu
  have hc : (us.map (fibreList c)).flatten.length ≤ Fintype.card α := by
    calc
      _ = (us.map (fibreList c)).flatten.toFinset.card := (List.toFinset_card_of_nodup hn).symm
      _ ≤ Fintype.card α := Finset.card_le_univ _
  rw [groupCost_eq, List.length_map]
  omega

/-- Eliminate one read-once group while preserving all other occurrence bounds. -/
theorem eliminate_group {n : ℕ} (A : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hA : IsSubstMatrix A) (vs : List σ) (hv : vs.Nodup)
    (hocc : ∀ w ∈ vs, (occurrences A w).card ≤ 1) :
    ∃ k ≤ n + (2 * vs.length + 1) + 3 * vs.length,
      ∃ N : Matrix (Fin k) (Fin k) (MvPolynomial σ ℂ), IsSubstMatrix N ∧
      N.permanent = groupSum vs A.permanent ∧
      (∀ w, w ∉ vs → (occurrences N w).card ≤ (occurrences A w).card) := by
  obtain ⟨k,hk,N,hN,hval,_,hbound⟩ :=
    eliminate_with_equality A hA vs.get hv.injective_get (fun i => hocc _ (List.get_mem vs i))
  have hlist : List.ofFn vs.get = vs := by simp
  have hp : N.permanent = groupSum vs A.permanent := by
    rw [← equalityPolynomial_ofFn vs.get, hlist, booleanSum_equality vs hv] at hval
    exact hval
  refine ⟨k,hk,N,hN,hp,?_⟩
  intro w hw
  apply hbound w
  intro i he
  exact hw (he ▸ List.get_mem vs i)

/-- Disjoint read-once groups can all be eliminated with additive size cost. -/
theorem eliminate_groups (groups : List (List σ)) (hgroups : groups.flatten.Nodup)
    {n : ℕ} (A : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ))
    (hA : IsSubstMatrix A) (hocc : ∀ w ∈ groups.flatten, (occurrences A w).card ≤ 1) :
    ∃ k ≤ n + groupCost groups,
      ∃ N : Matrix (Fin k) (Fin k) (MvPolynomial σ ℂ),
        IsSubstMatrix N ∧ N.permanent = groupSums groups A.permanent := by
  induction groups generalizing n with
  | nil => exact ⟨n, by simp [groupCost], A, hA, rfl⟩
  | cons vs rest ih =>
    have hn : (vs ++ rest.flatten).Nodup := by simpa using hgroups
    obtain ⟨hvs,hrest,hdis⟩ := List.nodup_append'.mp hn
    have hfirst : ∀ w ∈ vs, (occurrences A w).card ≤ 1 := by
      intro w hw
      exact hocc w (by simp [hw])
    obtain ⟨k,hk,N,hN,hval,hbound⟩ := eliminate_group A hA vs hvs hfirst
    have htail : ∀ w ∈ rest.flatten, (occurrences N w).card ≤ 1 := by
      intro w hw
      have hnot : w ∉ vs := fun hin => List.disjoint_left.mp hdis hin hw
      exact (hbound w hnot).trans (hocc w (by simp [hw]))
    obtain ⟨q,hq,P,hP,hPval⟩ := ih hrest N hN htail
    refine ⟨q, ?_, P, hP, ?_⟩
    · simp only [groupCost] at *
      omega
    · simpa only [groupSums, ← hval] using hPval

/-- Merging a group after its shared sum is the same as summing the merged
    variable in the original polynomial. -/
theorem collapse_groupSum {τ : Type} [DecidableEq τ] (vs : List σ) (h : vs.Nodup)
    (c : σ → τ) (u : τ) (hc : ∀ x, c x = u ↔ x ∈ vs) (p : MvPolynomial σ ℂ) :
    aeval (fun x => (X (c x) : MvPolynomial τ ℂ)) (groupSum vs p) =
      PermanentSelectorSubstitution.substitute u 0
        (aeval (fun x => (X (c x) : MvPolynomial τ ℂ)) p) +
      PermanentSelectorSubstitution.substitute u 1
        (aeval (fun x => (X (c x) : MvPolynomial τ ℂ)) p) := by
  unfold groupSum
  rw [map_add]
  rw [show PermanentEqualitySelector.allTrue = (fun _ : Fin vs.length => true) from rfl,
      show PermanentEqualitySelector.allFalse = (fun _ : Fin vs.length => false) from rfl]
  have ht := collapse_uniform_assignment vs h c u hc true p
  have hf := collapse_uniform_assignment vs h c u hc false p
  simp only [Bool.false_eq_true, if_true, if_false] at ht hf
  rw [ht,hf,add_comm]

/-- Shared sums over fibres of a renaming become ordinary Boolean sums over
    their respective original variables. -/
theorem collapse_groupSums {τ : Type} [DecidableEq τ]
    (groups : List (τ × List σ)) (c : σ → τ)
    (hnodup : ∀ g ∈ groups, g.2.Nodup)
    (hfibre : ∀ g ∈ groups, ∀ x, c x = g.1 ↔ x ∈ g.2)
    (p : MvPolynomial σ ℂ) :
    aeval (fun x => (X (c x) : MvPolynomial τ ℂ))
      (groupSums (groups.map Prod.snd) p) =
    booleanSum (groups.map Prod.fst)
      (aeval (fun x => (X (c x) : MvPolynomial τ ℂ)) p) := by
  induction groups generalizing p with
  | nil => rfl
  | cons g rest ih =>
    have hn : ∀ z ∈ rest, z.2.Nodup := by
      intro z hz; exact hnodup z (by simp [hz])
    have hf : ∀ z ∈ rest, ∀ x, c x = z.1 ↔ x ∈ z.2 := by
      intro z hz; exact hfibre z (by simp [hz])
    simp only [List.map_cons, groupSums, booleanSum]
    rw [ih hn hf, collapse_groupSum g.2 (hnodup g (by simp)) c g.1
      (hfibre g (by simp)) p]

/-- Any collection of distinct Boolean sums of a permanent is a permanent
    projection, with a dimension quadratic in the input matrix size and linear
    in the number of summed variables. -/
theorem arbitrary_booleanSums_isProjection {n : ℕ}
    (M : Matrix (Fin n) (Fin n) (MvPolynomial σ ℂ)) (hM : IsSubstMatrix M)
    (us : List σ) (hu : us.Nodup) :
    ∃ k ≤ n + 5 * (n * n) + us.length,
      ResultantVNP.IsProjection (booleanSum us M.permanent) (genericMatrix k).permanent := by
  classical
  let α := PermanentSplitVariables.VariablePosition M
  let c : α → σ := PermanentSplitVariables.originalVariable M
  let A := PermanentSplitVariables.splitMatrix M hM
  let groups := us.map (fibreList c)
  have hgroups : groups.flatten.Nodup := fibreLists_flatten_nodup c us hu
  have hA : IsSubstMatrix A := PermanentSplitVariables.splitMatrix_isSubstMatrix M hM
  have hocc : ∀ w ∈ groups.flatten, (occurrences A w).card ≤ 1 := by
    intro w _
    exact PermanentSplitVariables.splitMatrix_occurrences_le_one M hM w
  obtain ⟨k,hk,N,hN,hval⟩ := eliminate_groups groups hgroups A hA hocc
  have hcard : Fintype.card α ≤ n * n := by
    have hi : Function.Injective (fun p : α => p.val) := Subtype.val_injective
    have hc := Fintype.card_le_of_injective (fun p : α => p.val) hi
    simpa using hc
  have hcost : groupCost groups ≤ 5 * (n * n) + us.length := by
    have hc := fibreGroups_cost_le c us hu
    change groupCost (us.map (fibreList c)) ≤ _
    omega
  let ρ : MvPolynomial α ℂ →ₐ[ℂ] MvPolynomial σ ℂ := aeval (fun x => X (c x))
  have hmapped : IsSubstMatrix (N.map ρ) := by
    intro i j
    obtain ⟨s,hs⟩ := hN i j
    cases s with
    | inl x =>
      have he : N i j = X x := hs.symm
      change IsSubstEntry (ρ (N i j))
      rw [he]
      simpa [ρ] using (IsSubstEntry.X (c x))
    | inr a =>
      have he : N i j = C a := hs.symm
      change IsSubstEntry (ρ (N i j))
      rw [he]
      simpa [ρ] using (IsSubstEntry.C a)
  have hcollapse : ρ (groupSums groups A.permanent) = booleanSum us M.permanent := by
    let pairs := us.map (fun u => (u, fibreList c u))
    have hn : ∀ g ∈ pairs, g.2.Nodup := by
      intro g hg
      obtain ⟨u,_,rfl⟩ := List.mem_map.mp hg
      exact fibreList_nodup c u
    have hf : ∀ g ∈ pairs, ∀ x, c x = g.1 ↔ x ∈ g.2 := by
      intro g hg x
      obtain ⟨u,_,rfl⟩ := List.mem_map.mp hg
      exact (mem_fibreList c u x).symm
    have hc := collapse_groupSums pairs c hn hf A.permanent
    have hmerge : (aeval (fun x : α => (X (c x) : MvPolynomial σ ℂ))) A.permanent = M.permanent :=
      PermanentSplitVariables.splitMatrix_merge_permanent M hM
    simp only [pairs, List.map_map, Function.comp_def, List.map_id'] at hc
    rw [hmerge] at hc
    simpa only [groups, ρ] using hc
  have he : ρ N.permanent = booleanSum us M.permanent := by rw [hval, hcollapse]
  refine ⟨k, ?_, ?_⟩
  · omega
  · rw [← he, AlgHom.map_permanent]
    exact hmapped.isProjection_permanent (Equiv.refl _)


end PermanentGroupElimination

-- From Solutions.PermanentFormulaBooleanSum

namespace PermanentFormulaBooleanSum

open MvPolynomial PermanentFoundation PermanentSelectorIteration PermanentGroupElimination

variable {σ τ : Type} [DecidableEq σ]

/-- A polynomial-size Boolean sum of a formula is a polynomial-size
    projection of a permanent. -/
theorem formula_booleanSum_isProjection (F : Formula σ) (vs : List σ) (hvs : vs.Nodup) :
    ∃ k ≤ (F.size + 1) + 5 * ((F.size + 1) * (F.size + 1)) + vs.length,
      ResultantVNP.IsProjection (booleanSum vs F.value) (genericMatrix k).permanent := by
  obtain ⟨M,hM,hval⟩ := isProjection_permanent_iff_exists_substMatrix.mp F.isProjection_permanent
  obtain ⟨k,hk,hproj⟩ := arbitrary_booleanSums_isProjection M hM vs hvs
  refine ⟨k,hk,?_⟩
  simpa only [hval] using hproj

/-- Renaming variables and specializing them to constants preserves the
    existence of a permanent projection, without increasing the dimension. -/
theorem projection_after_substitution {p : MvPolynomial σ ℂ} {k : ℕ}
    (ρ : σ → τ ⊕ ℂ) (hp : ResultantVNP.IsProjection p (genericMatrix k).permanent) :
    ResultantVNP.IsProjection (projection ρ p) (genericMatrix k).permanent := by
  obtain ⟨M,hM,hval⟩ := isProjection_permanent_iff_exists_substMatrix.mp hp
  have hmap : IsSubstMatrix (M.map (projection ρ)) := by
    intro i j
    obtain ⟨s,hs⟩ := hM i j
    cases s with
    | inl x =>
      have he : M i j = X x := hs.symm
      change IsSubstEntry (projection ρ (M i j))
      rw [he]
      cases hv : ρ x with
      | inl y => simpa [projection,hv] using (IsSubstEntry.X y)
      | inr c => simpa [projection,hv] using (IsSubstEntry.C c)
    | inr c =>
      have he : M i j = C c := hs.symm
      change IsSubstEntry (projection ρ (M i j))
      rw [he]
      simpa [projection] using (IsSubstEntry.C c)
  rw [← hval, AlgHom.map_permanent]
  exact hmap.isProjection_permanent (Equiv.refl _)

/-- Boolean summation followed by a projection is the sum of the corresponding
    simultaneous evaluations in the projected polynomial ring. -/
theorem project_booleanSum_eq_evaluations (p : MvPolynomial σ ℂ)
    (vs : List σ) (hvs : vs.Nodup) (ρ : σ → τ ⊕ ℂ) :
    projection ρ (booleanSum vs p) =
      ∑ bits : Fin vs.length → Bool,
        aeval (fun x => projection ρ (simultaneousAssignment vs bits x)) p := by
  rw [booleanSum_eq_simultaneous_sum vs hvs, map_sum]
  apply Finset.sum_congr rfl
  intro bits _
  exact MvPolynomial.comp_aeval_apply (f := simultaneousAssignment vs bits) (projection ρ) p

/-- On an original variable, a projected simultaneous assignment gives the
    assigned constant for a selector, and the projected entry otherwise. -/
theorem project_simultaneousAssignment (vs : List σ) (bits : Fin vs.length → Bool)
    (ρ : σ → τ ⊕ ℂ) (x : σ) :
    projection ρ (simultaneousAssignment vs bits x) =
      if hx : x ∈ vs then
        C (if bits ⟨vs.idxOf x, List.idxOf_lt_length_of_mem hx⟩ then 1 else 0)
      else Sum.elim X C (ρ x) := by
  classical
  by_cases hx : x ∈ vs
  · simp [simultaneousAssignment,projection,hx]
  · simp [simultaneousAssignment,projection,hx]

/-- The Boolean encoding agrees with the `Fin 2` constants used in VNP. -/
theorem finTwoEquiv_constant (z : Fin 2) :
    (if finTwoEquiv z then (1 : ℂ) else 0) = (z.val : ℂ) := by
  fin_cases z <;> norm_num [finTwoEquiv]

/-- Express the projected Boolean sum using the exact `Fin 2` assignment
    convention in the VNP definition. -/
theorem project_booleanSum_eq_finTwo (p : MvPolynomial σ ℂ)
    (vs : List σ) (hvs : vs.Nodup) (ρ : σ → τ ⊕ ℂ) :
    projection ρ (booleanSum vs p) =
      ∑ y : Fin vs.length → Fin 2,
        aeval (fun x => if hx : x ∈ vs then
          C (((y ⟨vs.idxOf x, List.idxOf_lt_length_of_mem hx⟩).val : ℂ))
          else Sum.elim X C (ρ x)) p := by
  classical
  rw [project_booleanSum_eq_evaluations p vs hvs ρ]
  let e : (Fin vs.length → Fin 2) ≃ (Fin vs.length → Bool) :=
    Equiv.piCongrRight (fun _ => finTwoEquiv)
  symm
  apply Fintype.sum_equiv e
  intro y
  have he : (fun x => if hx : x ∈ vs then
        C (((y ⟨vs.idxOf x, List.idxOf_lt_length_of_mem hx⟩).val : ℂ))
        else Sum.elim X C (ρ x)) =
      (fun x => projection ρ (simultaneousAssignment vs (e y) x)) := by
    funext x
    rw [project_simultaneousAssignment]
    by_cases hx : x ∈ vs
    · simp only [hx, dif_pos]
      congr 1
      exact (finTwoEquiv_constant _).symm
    · simp [hx]
  rw [he]

theorem formula_booleanSum_after_substitution (F : Formula σ) (vs : List σ) (hvs : vs.Nodup)
    (ρ : σ → τ ⊕ ℂ) :
    ∃ k ≤ (F.size + 1) + 5 * ((F.size + 1) * (F.size + 1)) + vs.length,
      ResultantVNP.IsProjection (projection ρ (booleanSum vs F.value)) (genericMatrix k).permanent := by
  obtain ⟨k,hk,hp⟩ := formula_booleanSum_isProjection F vs hvs
  exact ⟨k,hk,projection_after_substitution ρ hp⟩

private def PB (f : ℕ → ℕ) : Prop := ∃ a b : ℕ, ∀ n, f n ≤ a * (n+1)^b

private theorem pb_of_poly {f : ℕ → ℕ} (h : ResultantVNP.PolyBounded f) : PB f := by
  obtain ⟨c,hc⟩ := h
  refine ⟨2*c,c,fun n => (hc n).trans ?_⟩
  have hp : n^c ≤ (n+1)^c := Nat.pow_le_pow_left (by omega) c
  have hp1 : 1 ≤ (n+1)^c := Nat.one_le_pow c (n+1) (by omega)
  nlinarith

private theorem poly_of_pb {f : ℕ → ℕ} (h : PB f) : ResultantVNP.PolyBounded f := by
  obtain ⟨a,b,h⟩ := h
  let c := a * 2^b+b
  refine ⟨c,fun n => ?_⟩
  by_cases hn : n = 0
  · subst n
    have hh := h 0
    simp only [zero_add, one_pow, mul_one] at hh
    have hp : 1 ≤ 2^b := Nat.one_le_pow b 2 (by omega)
    have ha := Nat.mul_le_mul_left a hp
    simp only [mul_one] at ha
    dsimp [c]
    omega
  · have hn1 : 1 ≤ n := by omega
    have hp : (n+1)^b ≤ (2*n)^b := Nat.pow_le_pow_left (by omega) b
    rw [mul_pow] at hp
    have hbc : b ≤ c := by dsimp [c]; omega
    have hp' : n^b ≤ n^c := Nat.pow_le_pow_right hn1 hbc
    have ha : a*2^b ≤ c := by dsimp [c]; omega
    calc
      f n ≤ a*(n+1)^b := h n
      _ ≤ a*(2^b*n^b) := Nat.mul_le_mul_left a hp
      _ = (a*2^b)*n^b := by ring
      _ ≤ c*n^c := Nat.mul_le_mul ha hp'
      _ ≤ c*n^c+c := by omega

private theorem pb_const (c : ℕ) : PB (fun _ => c) := ⟨c,0,by simp⟩

private theorem pb_add {f g : ℕ → ℕ} (hf : PB f) (hg : PB g) :
    PB (fun n => f n + g n) := by
  obtain ⟨a,b,hf⟩ := hf
  obtain ⟨c,d,hg⟩ := hg
  refine ⟨a+c,b+d,fun n => ?_⟩
  have hb : (n+1)^b ≤ (n+1)^(b+d) := Nat.pow_le_pow_right (by omega) (by omega)
  have hd : (n+1)^d ≤ (n+1)^(b+d) := Nat.pow_le_pow_right (by omega) (by omega)
  calc
    f n + g n ≤ a*(n+1)^b + c*(n+1)^d := Nat.add_le_add (hf n) (hg n)
    _ ≤ a*(n+1)^(b+d) + c*(n+1)^(b+d) :=
      Nat.add_le_add (Nat.mul_le_mul_left a hb) (Nat.mul_le_mul_left c hd)
    _ = (a+c)*(n+1)^(b+d) := by ring

private theorem pb_mul {f g : ℕ → ℕ} (hf : PB f) (hg : PB g) :
    PB (fun n => f n * g n) := by
  obtain ⟨a,b,hf⟩ := hf
  obtain ⟨c,d,hg⟩ := hg
  refine ⟨a*c,b+d,fun n => ?_⟩
  calc
    f n*g n ≤ (a*(n+1)^b)*(c*(n+1)^d) := Nat.mul_le_mul (hf n) (hg n)
    _ = (a*c)*(n+1)^(b+d) := by rw [pow_add]; ring

theorem polyBounded_add {f g : ℕ → ℕ} (hf : ResultantVNP.PolyBounded f)
    (hg : ResultantVNP.PolyBounded g) : ResultantVNP.PolyBounded (fun n => f n + g n) :=
  poly_of_pb (pb_add (pb_of_poly hf) (pb_of_poly hg))

theorem polyBounded_const (c : ℕ) : ResultantVNP.PolyBounded (fun _ => c) :=
  poly_of_pb (pb_const c)

theorem polyBounded_mul {f g : ℕ → ℕ} (hf : ResultantVNP.PolyBounded f)
    (hg : ResultantVNP.PolyBounded g) : ResultantVNP.PolyBounded (fun n => f n * g n) :=
  poly_of_pb (pb_mul (pb_of_poly hf) (pb_of_poly hg))

theorem polyBounded_pow {f : ℕ → ℕ} (hf : ResultantVNP.PolyBounded f) (k : ℕ) :
    ResultantVNP.PolyBounded (fun n => f n ^ k) := by
  induction k with
  | zero => simpa using polyBounded_const 1
  | succ k ih => simpa only [pow_succ] using polyBounded_mul ih hf

theorem polyBounded_mono {f g : ℕ → ℕ} (hg : ResultantVNP.PolyBounded g)
    (h : ∀ n, f n ≤ g n) : ResultantVNP.PolyBounded f := by
  obtain ⟨c,hc⟩ := hg
  exact ⟨c,fun n => (h n).trans (hc n)⟩

/-- The permanent dimension bound is polynomial whenever the formula sizes
    and numbers of selectors are polynomially bounded. -/
theorem formula_dimension_polyBounded (s q : ℕ → ℕ)
    (hs : ResultantVNP.PolyBounded s) (hq : ResultantVNP.PolyBounded q) :
    ResultantVNP.PolyBounded (fun n => (s n + 1) + 5 * ((s n + 1) * (s n + 1)) + q n) := by
  have hb : PB (fun n => s n + 1) := pb_add (pb_of_poly hs) (pb_const 1)
  exact poly_of_pb (pb_add (pb_add hb (pb_mul (pb_const 5) (pb_mul hb hb))) (pb_of_poly hq))

/-- A family represented by polynomially bounded formula Boolean sums has
    a polynomially bounded family of permanent projections. -/
theorem formula_family_projection (f : ResultantVNP.PolyFamily) (d : ℕ → ℕ)
    (F : ∀ n, Formula (Fin (d n))) (vs : ∀ n, List (Fin (d n)))
    (ρ : ∀ n, Fin (d n) → Fin (f.nvars n) ⊕ ℂ)
    (hvs : ∀ n, (vs n).Nodup)
    (hf : ∀ n, f.p n = projection (ρ n) (booleanSum (vs n) (F n).value))
    (hbound : ResultantVNP.PolyBounded (fun n =>
      ((F n).size + 1) + 5 * (((F n).size + 1) * ((F n).size + 1)) + (vs n).length)) :
    ∃ t : ℕ → ℕ, ResultantVNP.PolyBounded t ∧ ∀ n,
      1 ≤ t n ∧ ResultantVNP.IsProjection (f.p n) (genericMatrix (t n)).permanent := by
  let B : ℕ → ℕ := fun n => ((F n).size + 1) +
    5 * (((F n).size + 1) * ((F n).size + 1)) + (vs n).length
  let t : ℕ → ℕ := fun n => max 1 (B n)
  have ht : ResultantVNP.PolyBounded t := by
    obtain ⟨c,hc⟩ := hbound
    by_cases hc0 : c = 0
    · subst c
      refine ⟨1, ?_⟩
      intro n
      have hn : B n = 0 := by have := hc n; simp only [zero_mul, add_zero] at this; omega
      simp [t,hn]
    · refine ⟨c, ?_⟩
      intro n
      apply max_le
      · have : 1 ≤ c := by omega
        omega
      · exact hc n
  refine ⟨t,ht,?_⟩
  intro n
  obtain ⟨k,hk,hp⟩ := formula_booleanSum_after_substitution (F n) (vs n) (hvs n) (ρ n)
  refine ⟨le_max_left _ _,?_⟩
  rw [hf n]
  exact isProjection_permanent_mono (hk.trans (le_max_right _ _)) hp

theorem formula_family_projection_of_bounds (f : ResultantVNP.PolyFamily) (d : ℕ → ℕ)
    (F : ∀ n, Formula (Fin (d n))) (vs : ∀ n, List (Fin (d n)))
    (ρ : ∀ n, Fin (d n) → Fin (f.nvars n) ⊕ ℂ)
    (hvs : ∀ n, (vs n).Nodup)
    (hf : ∀ n, f.p n = projection (ρ n) (booleanSum (vs n) (F n).value))
    (hs : ResultantVNP.PolyBounded (fun n => (F n).size))
    (hq : ResultantVNP.PolyBounded (fun n => (vs n).length)) :
    ∃ t : ℕ → ℕ, ResultantVNP.PolyBounded t ∧ ∀ n,
      1 ≤ t n ∧ ResultantVNP.IsProjection (f.p n) (genericMatrix (t n)).permanent :=
  formula_family_projection f d F vs ρ hvs hf
    (formula_dimension_polyBounded _ _ hs hq)


end PermanentFormulaBooleanSum

-- From Solutions.VNPAssignmentBridge

namespace VNPAssignmentBridge

open MvPolynomial PermanentFoundation PermanentSelectorIteration PermanentFormulaBooleanSum

/-- The VNP witness variables occupy the final `q` positions. -/
def witnessVariables (a q : ℕ) : List (Fin (a + q)) :=
  List.ofFn (Fin.natAdd a : Fin q → Fin (a + q))

/-- Retain the first `a` variables and project the witness variables to zero.
    The latter values are irrelevant after Boolean summation. -/
def outputProjection (a q : ℕ) : Fin (a + q) → Fin a ⊕ ℂ :=
  Fin.append (fun i => Sum.inl i) (fun _ => Sum.inr 0)

theorem witnessVariables_nodup (a q : ℕ) : (witnessVariables a q).Nodup := by
  apply List.nodup_ofFn.mpr
  intro i j h
  apply Fin.ext
  have he := congrArg Fin.val h
  simp only [Fin.val_natAdd] at he
  omega

theorem witnessVariables_length (a q : ℕ) : (witnessVariables a q).length = q := by
  simp [witnessVariables]

theorem output_not_witness (a q : ℕ) (i : Fin a) :
    Fin.castAdd q i ∉ witnessVariables a q := by
  simp only [witnessVariables, List.mem_ofFn, not_exists]
  intro j he
  have he' := congrArg Fin.val he
  simp only [Fin.val_natAdd, Fin.val_castAdd] at he'
  have hi := i.isLt
  omega

theorem witness_mem (a q : ℕ) (j : Fin q) :
    Fin.natAdd a j ∈ witnessVariables a q := by
  exact List.mem_ofFn.mpr ⟨j,rfl⟩

/-- A canonical reindexing between the mission's witness coordinates and
    the positions in the selector list. -/
def selectorIndexEquiv (a q : ℕ) : Fin q ≃ Fin (witnessVariables a q).length :=
  (finCongr (witnessVariables_length a q)).symm

theorem witness_get (a q : ℕ) (j : Fin q) :
    (witnessVariables a q).get (selectorIndexEquiv a q j) = Fin.natAdd a j := by
  apply Fin.ext
  simp [witnessVariables, selectorIndexEquiv]
  rfl

def witnessAssignmentEquiv (a q : ℕ) :
    (Fin q → Fin 2) ≃ (Fin (witnessVariables a q).length → Bool) :=
  Equiv.arrowCongr (selectorIndexEquiv a q) finTwoEquiv

theorem witnessAssignmentEquiv_apply (a q : ℕ) (y : Fin q → Fin 2) (j : Fin q) :
    witnessAssignmentEquiv a q y (selectorIndexEquiv a q j) = finTwoEquiv (y j) := by
  simp [witnessAssignmentEquiv, Equiv.arrowCongr_apply]

/-- At each original variable position, evaluation leaves that variable in place. -/
theorem projected_assignment_output (a q : ℕ) (y : Fin q → Fin 2) (i : Fin a) :
    projection (outputProjection a q)
      (assignmentValue (witnessVariables a q) (witnessAssignmentEquiv a q y) (X (Fin.castAdd q i))) = X i := by
  rw [assignmentValue_X_not_mem _ _ _ (output_not_witness a q i)]
  simp [projection, outputProjection]

/-- At a witness position, evaluation gives the precise `Fin 2` constant. -/
theorem projected_assignment_witness (a q : ℕ) (y : Fin q → Fin 2) (j : Fin q) :
    projection (outputProjection a q)
      (assignmentValue (witnessVariables a q) (witnessAssignmentEquiv a q y) (X (Fin.natAdd a j))) =
        C (((y j).val : ℂ)) := by
  have hh := assignmentValue_X_get (witnessVariables a q) (witnessAssignmentEquiv a q y)
    (witnessVariables_nodup a q) (selectorIndexEquiv a q j)
  rw [witness_get, witnessAssignmentEquiv_apply, finTwoEquiv_constant] at hh
  rw [hh]
  simp [projection]

/-- The projected assignment agrees with the VNP definition on an entire
    polynomial, not just on its variable generators. -/
theorem projected_assignment_eq_vnp (a q : ℕ) (y : Fin q → Fin 2)
    (p : MvPolynomial (Fin (a + q)) ℂ) :
    projection (outputProjection a q)
      (assignmentValue (witnessVariables a q) (witnessAssignmentEquiv a q y) p) =
    aeval (Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
      (fun j : Fin q => C (((y j).val : ℂ)))) p := by
  rw [assignmentValue_eq_aeval, MvPolynomial.comp_aeval_apply]
  have he : (fun x => projection (outputProjection a q)
      (assignmentValue (witnessVariables a q) (witnessAssignmentEquiv a q y) (X x))) =
      Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
        (fun j : Fin q => C (((y j).val : ℂ))) := by
    funext x
    refine Fin.addCases (fun i => ?_) (fun j => ?_) x
    · simpa only [Fin.append_left] using projected_assignment_output a q y i
    · simpa only [Fin.append_right] using projected_assignment_witness a q y j
  rw [he]

/-- The exact `Fin.append` / `Fin 2` Boolean sum used by VNP is the
    projected iterated Boolean sum used by the permanent construction. -/
theorem projected_booleanSum_eq_vnp (a q : ℕ) (p : MvPolynomial (Fin (a + q)) ℂ) :
    projection (outputProjection a q) (booleanSum (witnessVariables a q) p) =
      ∑ y : Fin q → Fin 2,
        aeval (Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
          (fun j : Fin q => C (((y j).val : ℂ)))) p := by
  rw [booleanSum_eq_assignment_sum, map_sum]
  symm
  apply Fintype.sum_equiv (witnessAssignmentEquiv a q)
  intro y
  exact (projected_assignment_eq_vnp a q y p).symm

/-- The mission's Boolean sum of a formula is a permanent projection, with
    the input variables and witness variables in the exact VNP positions. -/
theorem vnp_formula_sum_isProjection (a q : ℕ) (F : Formula (Fin (a + q))) :
    ∃ k ≤ (F.size + 1) + 5 * ((F.size + 1) * (F.size + 1)) + q,
      ResultantVNP.IsProjection
        (∑ y : Fin q → Fin 2,
          aeval (Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
            (fun j : Fin q => C (((y j).val : ℂ)))) F.value)
        (genericMatrix k).permanent := by
  obtain ⟨k,hk,hproj⟩ := formula_booleanSum_after_substitution F (witnessVariables a q)
    (witnessVariables_nodup a q) (outputProjection a q)
  rw [projected_booleanSum_eq_vnp] at hproj
  exact ⟨k, by simpa only [witnessVariables_length] using hk, hproj⟩

/-- A VNP-style family whose witness is computed by polynomial-size formulas
    has polynomial-size permanent projections in the exact mission convention. -/
theorem vnp_formula_family_isProjection (f : ResultantVNP.PolyFamily) (q : ℕ → ℕ)
    (F : ∀ n, Formula (Fin (f.nvars n + q n)))
    (hq : ResultantVNP.PolyBounded q)
    (hs : ResultantVNP.PolyBounded (fun n => (F n).size))
    (hf : ∀ n, f.p n = ∑ y : Fin (q n) → Fin 2,
      aeval (Fin.append (fun i : Fin (f.nvars n) => (X i : MvPolynomial (Fin (f.nvars n)) ℂ))
        (fun j : Fin (q n) => C (((y j).val : ℂ)))) (F n).value) :
    ∃ t : ℕ → ℕ, ResultantVNP.PolyBounded t ∧ ∀ n,
      1 ≤ t n ∧ ResultantVNP.IsProjection (f.p n) (genericMatrix (t n)).permanent := by
  apply formula_family_projection_of_bounds f (fun n => f.nvars n + q n) F
    (fun n => witnessVariables (f.nvars n) (q n))
    (fun n => outputProjection (f.nvars n) (q n))
    (fun n => witnessVariables_nodup (f.nvars n) (q n))
  · intro n
    rw [projected_booleanSum_eq_vnp]
    exact hf n
  · exact hs
  · simpa only [witnessVariables_length] using hq


end VNPAssignmentBridge

-- From Solutions.VNPNestedBooleanSum

namespace VNPNestedBooleanSum

open MvPolynomial PermanentFoundation

/-- Rename variables of a formula without changing its gate count. -/
def renameFormula {α β : Type} (f : α → β) : Formula α → Formula β
  | .var x => .var (f x)
  | .const a => .const a
  | .add p q => .add (renameFormula f p) (renameFormula f q)
  | .mul p q => .mul (renameFormula f p) (renameFormula f q)

theorem renameFormula_size {α β : Type} (f : α → β) (F : Formula α) :
    (renameFormula f F).size = F.size := by
  induction F <;> simp [renameFormula, Formula.size, *]

theorem renameFormula_value {α β : Type} (f : α → β) (F : Formula α) :
    (renameFormula f F).value = MvPolynomial.rename f F.value := by
  induction F <;> simp [renameFormula, Formula.value, *]

/-- Successive witness evaluations are the single evaluation obtained by
    concatenating their Boolean assignments. -/
theorem witnessEval_comp (a q r : ℕ) (y : Fin q → Fin 2) (z : Fin r → Fin 2)
    (p : MvPolynomial (Fin ((a + q) + r)) ℂ) :
    witnessEval a q y (witnessEval (a + q) r z p) =
      aeval (fun v : Fin ((a + q) + r) =>
        Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
          (fun j : Fin (q + r) => C ((((Fin.append y z) j).val : ℂ)))
          (Fin.cast (Nat.add_assoc a q r) v)) p := by
  unfold witnessEval
  rw [MvPolynomial.comp_aeval_apply]
  have he : (fun v : Fin ((a + q) + r) =>
      (aeval (Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
        (fun j : Fin q => C (((y j).val : ℂ)))))
        (Fin.append (fun i : Fin (a + q) => (X i : MvPolynomial (Fin (a + q)) ℂ))
          (fun j : Fin r => C (((z j).val : ℂ))) v)) =
      (fun v => Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
        (fun j : Fin (q + r) => C ((((Fin.append y z) j).val : ℂ)))
        (Fin.cast (Nat.add_assoc a q r) v)) := by
    have hconst : Fin.append (fun j : Fin q => (C (((y j).val : ℂ)) : MvPolynomial (Fin a) ℂ))
        (fun j : Fin r => C (((z j).val : ℂ))) =
        (fun j : Fin (q + r) => C ((((Fin.append y z) j).val : ℂ))) := by
      funext j
      refine Fin.addCases (fun i => ?_) (fun i => ?_) j <;> simp
    rw [← hconst]
    change _ = (Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
      (Fin.append (fun j : Fin q => C (((y j).val : ℂ)))
        (fun j : Fin r => C (((z j).val : ℂ)))) ∘ Fin.cast (Nat.add_assoc a q r))
    rw [← Fin.append_assoc]
    funext v
    refine Fin.addCases (fun i => ?_) (fun j => ?_) v
    · simp
    · simp
  rw [he]

/-- Two successive `Fin 2` sums combine into one sum over the concatenated
    witness vector. -/
theorem nested_witness_sums (a q r : ℕ) (p : MvPolynomial (Fin ((a + q) + r)) ℂ) :
    (∑ y : Fin q → Fin 2, witnessEval a q y
      (∑ z : Fin r → Fin 2, witnessEval (a + q) r z p)) =
    ∑ w : Fin (q + r) → Fin 2,
      aeval (fun v : Fin ((a + q) + r) =>
        Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
          (fun j : Fin (q + r) => C (((w j).val : ℂ)))
          (Fin.cast (Nat.add_assoc a q r) v)) p := by
  classical
  simp only [map_sum]
  simp_rw [witnessEval_comp]
  calc
    _ = ∑ yz : (Fin q → Fin 2) × (Fin r → Fin 2),
        aeval (fun v : Fin ((a + q) + r) =>
          Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
            (fun j : Fin (q + r) => C ((((Fin.append yz.1 yz.2) j).val : ℂ)))
            (Fin.cast (Nat.add_assoc a q r) v)) p := by
              rw [Fintype.sum_prod_type]
    _ = _ := by
      simpa only [Fin.appendEquiv_apply] using
        (Fin.appendEquiv (α := Fin 2) q r).sum_comp
          (fun w : Fin (q + r) → Fin 2 =>
            aeval (fun v : Fin ((a + q) + r) =>
              Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
                (fun j : Fin (q + r) => C (((w j).val : ℂ)))
                (Fin.cast (Nat.add_assoc a q r) v)) p)

/-- A nested witness sum of a formula is a permanent projection with one
    polynomial-size bound depending on both witness lengths. -/
theorem nested_formula_sum_isProjection (a q r : ℕ) (F : Formula (Fin ((a + q) + r))) :
    ∃ k ≤ (F.size + 1) + 5 * ((F.size + 1) * (F.size + 1)) + (q + r),
      ResultantVNP.IsProjection
        (∑ y : Fin q → Fin 2, witnessEval a q y
          (∑ z : Fin r → Fin 2, witnessEval (a + q) r z F.value))
        (genericMatrix k).permanent := by
  let G := renameFormula (Fin.cast (Nat.add_assoc a q r)) F
  obtain ⟨k,hk,hproj⟩ := VNPAssignmentBridge.vnp_formula_sum_isProjection a (q+r) G
  refine ⟨k, ?_, ?_⟩
  · simpa only [G, renameFormula_size] using hk
  · rw [nested_witness_sums]
    simpa only [G, renameFormula_value, MvPolynomial.aeval_rename, Function.comp_def] using hproj

/-- A polynomial-size formula Boolean sum for a VP witness combines with the
    outer VNP Boolean sum and yields polynomial-size permanent projections. -/
theorem nested_formula_family_isProjection (f : ResultantVNP.PolyFamily) (q r : ℕ → ℕ)
    (F : ∀ n, Formula (Fin ((f.nvars n + q n) + r n)))
    (hq : ResultantVNP.PolyBounded q) (hr : ResultantVNP.PolyBounded r)
    (hs : ResultantVNP.PolyBounded (fun n => (F n).size))
    (hf : ∀ n, f.p n = ∑ y : Fin (q n) → Fin 2, witnessEval (f.nvars n) (q n) y
      (∑ z : Fin (r n) → Fin 2, witnessEval (f.nvars n + q n) (r n) z (F n).value)) :
    ∃ t : ℕ → ℕ, ResultantVNP.PolyBounded t ∧ ∀ n,
      1 ≤ t n ∧ ResultantVNP.IsProjection (f.p n) (genericMatrix (t n)).permanent := by
  let G : ∀ n, Formula (Fin (f.nvars n + (q n + r n))) :=
    fun n => renameFormula (Fin.cast (Nat.add_assoc (f.nvars n) (q n) (r n))) (F n)
  apply VNPAssignmentBridge.vnp_formula_family_isProjection f (fun n => q n + r n) G
    (PermanentFormulaBooleanSum.polyBounded_add hq hr)
  · simpa only [G, renameFormula_size] using hs
  · intro n
    rw [hf n, nested_witness_sums]
    simp only [G, renameFormula_value, MvPolynomial.aeval_rename, Function.comp_def]

/-- Renaming the retained variables commutes with evaluation of a trailing
    Boolean witness block, including the dependent index casts. -/
theorem witnessEval_cast (a b r : ℕ) (h : a = b) (z : Fin r → Fin 2)
    (p : MvPolynomial (Fin (a + r)) ℂ) :
    rename (Fin.cast h) (witnessEval a r z p) =
      witnessEval b r z (rename (Fin.cast (congrArg (fun t => t + r) h)) p) := by
  subst b
  simp [witnessEval]

/-- This isolates the only remaining complexity-theoretic bridge: once every
    VP family has a polynomial formula-sum representation, the mission's
    exact permanent hardness statement follows. -/
theorem permanent_hard_of_vp_formulaSums (hrep : VPFormulaSumProperty) :
    ResultantVNP.IsVNPHardPProj (fun n => (genericMatrix n).permanent) 1 := by
  intro f hf
  obtain ⟨g,hg,q,hq,houter⟩ := hf
  obtain ⟨r,hr,F,hs,hinner⟩ := hrep g hg
  choose hcast hsum using houter
  let H : ∀ n, Formula (Fin ((f.nvars n + q n) + r n)) :=
    fun n => renameFormula (Fin.cast (congrArg (fun t => t + r n) (hcast n))) (F n)
  have hHsize : ResultantVNP.PolyBounded (fun n => (H n).size) := by
    simpa only [H,renameFormula_size] using hs
  have hnest : ∀ n, f.p n = ∑ y : Fin (q n) → Fin 2, witnessEval (f.nvars n) (q n) y
      (∑ z : Fin (r n) → Fin 2, witnessEval (f.nvars n + q n) (r n) z (H n).value) := by
    intro n
    rw [hsum n]
    apply Finset.sum_congr rfl
    intro y _
    change aeval ((Fin.append (fun i : Fin (f.nvars n) => (X i : MvPolynomial (Fin (f.nvars n)) ℂ))
      (fun j : Fin (q n) => C (((y j).val : ℂ)))) ∘ Fin.cast (hcast n)) (g.p n) = _
    rw [← MvPolynomial.aeval_rename]
    change witnessEval (f.nvars n) (q n) y
      (rename (Fin.cast (hcast n)) (g.p n)) = _
    rw [hinner n, map_sum]
    apply congrArg (witnessEval (f.nvars n) (q n) y)
    apply Finset.sum_congr rfl
    intro z _
    rw [witnessEval_cast]
    simp only [H, renameFormula_value]
  exact nested_formula_family_isProjection f q r H hq hr hHsize hnest

/-- The conditional conclusion has the exact target type from Prove2Me. -/
theorem permanent_target_of_vp_formulaSums (hrep : VPFormulaSumProperty) :
    ResultantVNP.IsVNPHardPProj
      (fun n => (Matrix.of fun i j : Fin n =>
        (MvPolynomial.X (i,j) : MvPolynomial (Fin n × Fin n) ℂ)).permanent) 1 := by
  simpa only [genericMatrix] using permanent_hard_of_vp_formulaSums hrep



end VNPNestedBooleanSum

-- From Solutions.BooleanVerifierFormula

/-! Small Boolean formulas can be used as zero-one filters inside an
arithmetic formula, evaluated on Boolean witness assignments. -/

namespace BooleanVerifierFormula

open PermanentFoundation MvPolynomial

inductive BoolFormula (σ : Type) where
  | bit (x : σ)
  | lit (b : Bool)
  | not (p : BoolFormula σ)
  | and (p q : BoolFormula σ)
  | or (p q : BoolFormula σ)

def BoolFormula.nodes {σ : Type} : BoolFormula σ → ℕ
  | .bit _ | .lit _ => 1
  | .not p => p.nodes + 1
  | .and p q | .or p q => p.nodes + q.nodes + 1

def BoolFormula.test {σ : Type} (v : σ → Bool) : BoolFormula σ → Bool
  | .bit x => v x
  | .lit b => b
  | .not p => !(p.test v)
  | .and p q => p.test v && q.test v
  | .or p q => p.test v || q.test v

def BoolFormula.rename {σ τ : Type} (f : σ → τ) : BoolFormula σ → BoolFormula τ
  | .bit x => .bit (f x)
  | .lit b => .lit b
  | .not p => .not (p.rename f)
  | .and p q => .and (p.rename f) (q.rename f)
  | .or p q => .or (p.rename f) (q.rename f)

theorem rename_nodes {σ τ : Type} (f : σ → τ) (p : BoolFormula σ) :
    (p.rename f).nodes = p.nodes := by
  induction p <;> simp [BoolFormula.rename,BoolFormula.nodes, *]

theorem rename_test {σ τ : Type} (f : σ → τ) (p : BoolFormula σ) (v : τ → Bool) :
    (p.rename f).test v = p.test (v ∘ f) := by
  induction p <;> simp [BoolFormula.rename,BoolFormula.test,Function.comp_def, *]

def bitValue (b : Bool) : ℂ := if b then 1 else 0

/-- A conjunction of local checks, with no sharing assumptions. -/
def conjunction {σ : Type} : List (BoolFormula σ) → BoolFormula σ
  | [] => .lit true
  | p :: ps => .and p (conjunction ps)

theorem conjunction_nodes {σ : Type} (ps : List (BoolFormula σ)) :
    (conjunction ps).nodes = (ps.map BoolFormula.nodes).sum + ps.length + 1 := by
  induction ps with
  | nil => simp [conjunction, BoolFormula.nodes]
  | cons p ps ih => simp only [conjunction, BoolFormula.nodes, ih, List.map_cons,
      List.sum_cons, List.length_cons]; omega

theorem conjunction_test {σ : Type} (ps : List (BoolFormula σ)) (v : σ → Bool) :
    (conjunction ps).test v = ps.all (fun p => p.test v) := by
  induction ps with
  | nil => rfl
  | cons p ps ih => simp [conjunction, BoolFormula.test, ih]

/-- Translate Boolean operations to polynomials valid on zero-one inputs. -/
def BoolFormula.arith {σ : Type} : BoolFormula σ → Formula σ
  | .bit x => .var x
  | .lit b => .const (bitValue b)
  | .not p => .add (.const 1) (.mul (.const (-1)) p.arith)
  | .and p q => .mul p.arith q.arith
  | .or p q => .add (.const 1) (.mul (.const (-1))
      (.mul (.add (.const 1) (.mul (.const (-1)) p.arith))
        (.add (.const 1) (.mul (.const (-1)) q.arith))))

theorem arith_size {σ : Type} (p : BoolFormula σ) :
    p.arith.size ≤ 7 * p.nodes := by
  induction p with
  | bit x => simp [BoolFormula.arith, Formula.size, BoolFormula.nodes]
  | lit b => simp [BoolFormula.arith, Formula.size, BoolFormula.nodes]
  | not p ih => simp only [BoolFormula.arith, Formula.size, BoolFormula.nodes]; omega
  | and p q hp hq => simp only [BoolFormula.arith, Formula.size, BoolFormula.nodes]; omega
  | or p q hp hq =>
    simp only [BoolFormula.arith, Formula.size, BoolFormula.nodes]
    omega

theorem arith_eval {σ : Type} [DecidableEq σ] (p : BoolFormula σ) (v : σ → Bool) :
    eval (fun x => bitValue (v x)) p.arith.value = bitValue (p.test v) := by
  induction p with
  | bit x => simp [BoolFormula.arith, Formula.value, BoolFormula.test]
  | lit b => simp [BoolFormula.arith, Formula.value, BoolFormula.test]
  | not p ih =>
    simp only [BoolFormula.arith, Formula.value, eval_add, eval_mul, eval_C, BoolFormula.test, ih]
    cases p.test v <;> simp [bitValue]
  | and p q hp hq =>
    simp only [BoolFormula.arith, Formula.value, eval_mul, BoolFormula.test, hp, hq]
    cases p.test v <;> cases q.test v <;> simp [bitValue]
  | or p q hp hq =>
    simp only [BoolFormula.arith, Formula.value, eval_add, eval_mul, eval_C, BoolFormula.test, hp, hq]
    cases p.test v <;> cases q.test v <;> simp [bitValue]

/-- Read a `Fin 2` witness bit as a Boolean. -/
def witnessBool (b : Fin 2) : Bool := b.val == 1

theorem witnessBool_value (b : Fin 2) : bitValue (witnessBool b) = (b.val : ℂ) := by
  fin_cases b <;> norm_num [bitValue, witnessBool]

/-- The Boolean verifier, renamed to the witness part of the paper's
    input/witness layout. -/
def witnessFormula (a q : ℕ) (p : BoolFormula (Fin q)) : Formula (Fin (a + q)) :=
  VNPNestedBooleanSum.renameFormula (Fin.natAdd a) p.arith

theorem witnessFormula_size (a q : ℕ) (p : BoolFormula (Fin q)) :
    (witnessFormula a q p).size ≤ 7 * p.nodes := by
  simpa [witnessFormula, VNPNestedBooleanSum.renameFormula_size] using arith_size p

theorem witnessFormula_eval (a q : ℕ) (p : BoolFormula (Fin q)) (z : Fin q → Fin 2) :
    VNPNestedBooleanSum.witnessEval a q z (witnessFormula a q p).value =
      C (bitValue (p.test (fun i => witnessBool (z i)))) := by
  induction p with
  | bit x =>
    simp [witnessFormula, BoolFormula.arith, VNPNestedBooleanSum.renameFormula,
      Formula.value, VNPNestedBooleanSum.witnessEval, BoolFormula.test, Fin.append_right,
      witnessBool_value]
  | lit b =>
    simp [witnessFormula, BoolFormula.arith, VNPNestedBooleanSum.renameFormula,
      Formula.value, VNPNestedBooleanSum.witnessEval, BoolFormula.test]
  | not p ih =>
    simp only [witnessFormula, BoolFormula.arith, VNPNestedBooleanSum.renameFormula,
      Formula.value, map_add, map_mul, map_neg, map_one, BoolFormula.test] at *
    rw [ih]
    cases p.test (fun i => witnessBool (z i)) <;> simp [bitValue]
  | and p q hp hq =>
    simp only [witnessFormula, BoolFormula.arith, VNPNestedBooleanSum.renameFormula,
      Formula.value, map_mul, BoolFormula.test] at *
    rw [hp,hq]
    cases p.test (fun i => witnessBool (z i)) <;>
      cases q.test (fun i => witnessBool (z i)) <;> simp [bitValue]
  | or p q hp hq =>
    simp only [witnessFormula, BoolFormula.arith, VNPNestedBooleanSum.renameFormula,
      Formula.value, map_add, map_mul, map_neg, map_one, BoolFormula.test] at *
    rw [hp,hq]
    cases p.test (fun i => witnessBool (z i)) <;>
      cases q.test (fun i => witnessBool (z i)) <;> simp [bitValue]

/-- A verifier can gate an arbitrary arithmetic payload: invalid witnesses
    contribute zero, valid witnesses contribute the payload unchanged. -/
theorem witness_filter (a q : ℕ) (p : BoolFormula (Fin q))
    (payload : Formula (Fin (a + q))) (z : Fin q → Fin 2) :
    VNPNestedBooleanSum.witnessEval a q z
        (Formula.mul (witnessFormula a q p) payload).value =
      if p.test (fun i => witnessBool (z i)) then
        VNPNestedBooleanSum.witnessEval a q z payload.value else 0 := by
  simp only [Formula.value, map_mul, witnessFormula_eval]
  cases p.test (fun i => witnessBool (z i)) <;> simp [bitValue]

theorem witness_filter_size (a q : ℕ) (p : BoolFormula (Fin q))
    (payload : Formula (Fin (a + q))) :
    (Formula.mul (witnessFormula a q p) payload).size ≤ 7 * p.nodes + payload.size + 1 := by
  simp only [Formula.size]
  have h := witnessFormula_size a q p
  omega

/-- A one-hot witness selects among possible arithmetic labels. This also
    gives a well-defined sum when the selector is not one-hot; a Boolean
    verifier can exclude that case. -/
def selectPayload (a q : ℕ) : List (Fin q × Formula (Fin (a + q))) → Formula (Fin (a + q))
  | [] => .const 0
  | (i,F) :: rest => .add (.mul (.var (Fin.natAdd a i)) F) (selectPayload a q rest)

theorem selectPayload_size (a q : ℕ) (choices : List (Fin q × Formula (Fin (a + q)))) :
    (selectPayload a q choices).size = (choices.map (fun x => x.2.size)).sum + 2 * choices.length := by
  induction choices with
  | nil => rfl
  | cons choice rest ih =>
    rcases choice with ⟨i,F⟩
    simp only [selectPayload, Formula.size, ih, List.map_cons, List.sum_cons, List.length_cons]
    omega

theorem selectPayload_eval (a q : ℕ) (choices : List (Fin q × Formula (Fin (a + q))))
    (z : Fin q → Fin 2) :
    VNPNestedBooleanSum.witnessEval a q z (selectPayload a q choices).value =
      (choices.map (fun x => if witnessBool (z x.1) then
        VNPNestedBooleanSum.witnessEval a q z x.2.value else 0)).sum := by
  induction choices with
  | nil => simp [selectPayload, Formula.value]
  | cons choice rest ih =>
    rcases choice with ⟨i,F⟩
    simp only [selectPayload, Formula.value, map_add, map_mul, ih, List.map_cons, List.sum_cons]
    have hv : VNPNestedBooleanSum.witnessEval a q z (X (Fin.natAdd a i)) =
        C (bitValue (witnessBool (z i))) := by
      simpa [witnessFormula, BoolFormula.arith, VNPNestedBooleanSum.renameFormula, Formula.value,
        BoolFormula.test] using witnessFormula_eval a q (.bit i) z
    rw [hv]
    cases witnessBool (z i) <;> simp [bitValue]

/-- Multiply a fixed list of selector-controlled payloads. A designated
    selector for the constant `1` can represent an unused factor slot. -/
def productPayload (a q : ℕ) :
    List (List (Fin q × Formula (Fin (a + q)))) → Formula (Fin (a + q))
  | [] => .const 1
  | choices :: rest => .mul (selectPayload a q choices) (productPayload a q rest)

theorem productPayload_size (a q : ℕ) (slots : List (List (Fin q × Formula (Fin (a + q))))) :
    (productPayload a q slots).size =
      (slots.map (fun choices => (choices.map (fun x => x.2.size)).sum + 2 * choices.length)).sum +
        slots.length := by
  induction slots with
  | nil => rfl
  | cons choices rest ih =>
    simp only [productPayload,Formula.size,selectPayload_size,ih,List.map_cons,List.sum_cons,
      List.length_cons]
    omega

theorem productPayload_eval (a q : ℕ) (slots : List (List (Fin q × Formula (Fin (a + q)))))
    (z : Fin q → Fin 2) :
    VNPNestedBooleanSum.witnessEval a q z (productPayload a q slots).value =
      (slots.map (fun choices => (choices.map (fun x => if witnessBool (z x.1) then
        VNPNestedBooleanSum.witnessEval a q z x.2.value else 0)).sum)).prod := by
  induction slots with
  | nil => simp [productPayload,Formula.value]
  | cons choices rest ih =>
    simp only [productPayload,Formula.value,map_mul,selectPayload_eval,ih,List.map_cons,List.prod_cons]

private theorem list_sum_unique {α β : Type} [AddCommMonoid β] (xs : List α) (f : α → β)
    (hn : xs.Nodup) (x : α) (hx : x ∈ xs) (hz : ∀ y ∈ xs, y ≠ x → f y = 0) :
    (xs.map f).sum = f x := by
  classical
  rw [← List.sum_toFinset f hn]
  apply Finset.sum_eq_single x
  · intro y hy hne
    exact hz y (List.mem_toFinset.mp hy) hne
  · intro hnot
    exact (hnot (List.mem_toFinset.mpr hx)).elim

/-- A selector list with exactly one active entry evaluates to that entry's
    payload. Distinct entries remain distinguishable even if their payload
    formulas happen to compute the same polynomial. -/
theorem selectPayload_oneHot (a q : ℕ) (choices : List (Fin q × Formula (Fin (a + q))))
    (hn : choices.Nodup) (i : Fin q) (F : Formula (Fin (a + q))) (z : Fin q → Fin 2)
    (hmem : (i,F) ∈ choices) (hon : witnessBool (z i) = true)
    (hoff : ∀ x ∈ choices, x ≠ (i,F) → witnessBool (z x.1) = false) :
    VNPNestedBooleanSum.witnessEval a q z (selectPayload a q choices).value =
      VNPNestedBooleanSum.witnessEval a q z F.value := by
  rw [selectPayload_eval]
  have h := list_sum_unique choices
    (fun x => if witnessBool (z x.1) then VNPNestedBooleanSum.witnessEval a q z x.2.value else 0)
    hn (i,F) hmem (by
      intro x hx hne
      rw [hoff x hx hne]
      rfl)
  simpa [hon] using h

/-- Placing an input-only formula before the witness coordinates preserves
    its value under every witness assignment. -/
theorem witnessEval_inputFormula (a q : ℕ) (F : Formula (Fin a)) (z : Fin q → Fin 2) :
    VNPNestedBooleanSum.witnessEval a q z
      (VNPNestedBooleanSum.renameFormula (Fin.castAdd q) F).value = F.value := by
  rw [VNPNestedBooleanSum.renameFormula_value]
  unfold VNPNestedBooleanSum.witnessEval
  rw [MvPolynomial.aeval_rename]
  have he : (Fin.append (fun i : Fin a => (X i : MvPolynomial (Fin a) ℂ))
      (fun j : Fin q => C (((z j).val : ℂ))) ∘ Fin.castAdd q) = X := by
    funext i
    simp [Function.comp_def, Fin.append_left]
  rw [he, MvPolynomial.aeval_X_left]
  rfl

end BooleanVerifierFormula

-- From Solutions.CertificateConstraints

/-! A local transition or consistency check can be specified by a finite
table of acceptable Boolean patterns. This file compiles such tables into
arithmetic filters with explicit size bounds. -/

namespace CertificateConstraints

open BooleanVerifierFormula PermanentFoundation

variable {σ : Type}

def literal (x : σ) (b : Bool) : BoolFormula σ :=
  if b then .bit x else .not (.bit x)

theorem literal_test (x : σ) (b : Bool) (v : σ → Bool) :
    (literal x b).test v = (v x == b) := by
  cases b <;> cases h : v x <;> simp [literal, BoolFormula.test, h]

theorem literal_nodes (x : σ) (b : Bool) : (literal x b).nodes ≤ 2 := by
  cases b <;> simp [literal, BoolFormula.nodes]

/-- Match a finite list of named bits against required values. -/
def matchPattern : List (σ × Bool) → BoolFormula σ
  | [] => .lit true
  | (x,b) :: rest => .and (literal x b) (matchPattern rest)

theorem matchPattern_test (p : List (σ × Bool)) (v : σ → Bool) :
    (matchPattern p).test v = p.all (fun x => v x.1 == x.2) := by
  induction p with
  | nil => rfl
  | cons x xs ih =>
    rcases x with ⟨i,b⟩
    simp [matchPattern, BoolFormula.test, literal_test, ih]

theorem matchPattern_nodes (p : List (σ × Bool)) :
    (matchPattern p).nodes ≤ 3 * p.length + 1 := by
  induction p with
  | nil => simp [matchPattern, BoolFormula.nodes]
  | cons x xs ih =>
    rcases x with ⟨i,b⟩
    simp only [matchPattern, BoolFormula.nodes, List.length_cons]
    have h := literal_nodes i b
    omega

/-- Accept if at least one row of a finite local transition table matches. -/
def matchesTable : List (List (σ × Bool)) → BoolFormula σ
  | [] => .lit false
  | p :: ps => .or (matchPattern p) (matchesTable ps)

theorem matchesTable_test (ps : List (List (σ × Bool))) (v : σ → Bool) :
    (matchesTable ps).test v = ps.any (fun p => p.all (fun x => v x.1 == x.2)) := by
  induction ps with
  | nil => rfl
  | cons p ps ih => simp [matchesTable, BoolFormula.test, matchPattern_test, ih]

theorem matchesTable_nodes (ps : List (List (σ × Bool))) :
    (matchesTable ps).nodes ≤ 3 * (ps.map List.length).sum + 2 * ps.length + 1 := by
  induction ps with
  | nil => simp [matchesTable, BoolFormula.nodes]
  | cons p ps ih =>
    simp only [matchesTable, BoolFormula.nodes, List.map_cons, List.sum_cons, List.length_cons]
    have h := matchPattern_nodes p
    omega

/-- All local constraints must pass. The table rows need not be disjoint. -/
def checkTables : List (List (List (σ × Bool))) → BoolFormula σ
  | [] => .lit true
  | ps :: rest => .and (matchesTable ps) (checkTables rest)

def tableBits (ps : List (List (σ × Bool))) : ℕ := (ps.map List.length).sum

theorem checkTables_test (ts : List (List (List (σ × Bool)))) (v : σ → Bool) :
    (checkTables ts).test v =
      ts.all (fun ps => ps.any (fun p => p.all (fun x => v x.1 == x.2))) := by
  induction ts with
  | nil => rfl
  | cons ps rest ih => simp [checkTables, BoolFormula.test, matchesTable_test, ih]

theorem checkTables_nodes (ts : List (List (List (σ × Bool)))) :
    (checkTables ts).nodes ≤
      3 * (ts.map tableBits).sum + 2 * (ts.map List.length).sum + 2 * ts.length + 1 := by
  induction ts with
  | nil => simp [checkTables, BoolFormula.nodes]
  | cons ps rest ih =>
    simp only [checkTables, BoolFormula.nodes, List.map_cons, List.sum_cons, List.length_cons]
    have h := matchesTable_nodes ps
    dsimp [tableBits] at *
    omega

/-- Constant-size local tables for a deterministic Boolean circuit. -/
def copyTable (x z : σ) : List (List (σ × Bool)) :=
  [[(x,false),(z,false)], [(x,true),(z,true)]]

def notTable (x z : σ) : List (List (σ × Bool)) :=
  [[(x,false),(z,true)], [(x,true),(z,false)]]

def andTable (x y z : σ) : List (List (σ × Bool)) :=
  [[(x,false),(y,false),(z,false)], [(x,false),(y,true),(z,false)],
   [(x,true),(y,false),(z,false)], [(x,true),(y,true),(z,true)]]

theorem copyTable_correct (x z : σ) (v : σ → Bool) :
    (matchesTable (copyTable x z)).test v = (v z == v x) := by
  rw [matchesTable_test]
  cases hx : v x <;> cases hz : v z <;> simp [copyTable, hx, hz]

theorem notTable_correct (x z : σ) (v : σ → Bool) :
    (matchesTable (notTable x z)).test v = (v z == !(v x)) := by
  rw [matchesTable_test]
  cases hx : v x <;> cases hz : v z <;> simp [notTable, hx, hz]

theorem andTable_correct (x y z : σ) (v : σ → Bool) :
    (matchesTable (andTable x y z)).test v = (v z == (v x && v y)) := by
  rw [matchesTable_test]
  cases hx : v x <;> cases hy : v y <;> cases hz : v z <;> simp [andTable, hx, hy, hz]

theorem gateTable_bounds (x y z : σ) :
    (matchesTable (copyTable x z)).nodes ≤ 17 ∧
    (matchesTable (notTable x z)).nodes ≤ 17 ∧
    (matchesTable (andTable x y z)).nodes ≤ 45 := by
  have h₁ := matchesTable_nodes (copyTable x z)
  have h₂ := matchesTable_nodes (notTable x z)
  have h₃ := matchesTable_nodes (andTable x y z)
  simp [copyTable, notTable, andTable] at h₁ h₂ h₃
  simp only [copyTable, notTable, andTable]
  omega

/-- The arithmetic filter has size linear in the table description and
    contributes exactly one or zero on witness assignments. -/
theorem table_filter_size (a q : ℕ) (ps : List (List (Fin q × Bool))) :
    (witnessFormula a q (matchesTable ps)).size ≤
      7 * (3 * (ps.map List.length).sum + 2 * ps.length + 1) := by
  have h := witnessFormula_size a q (matchesTable ps)
  have h' := matchesTable_nodes ps
  omega

theorem table_filter_eval (a q : ℕ) (ps : List (List (Fin q × Bool))) (z : Fin q → Fin 2) :
    VNPNestedBooleanSum.witnessEval a q z (witnessFormula a q (matchesTable ps)).value =
      MvPolynomial.C (bitValue (ps.any (fun p =>
        p.all (fun x => witnessBool (z x.1) == x.2)))) := by
  rw [witnessFormula_eval, matchesTable_test]

theorem tables_filter_eval (a q : ℕ) (ts : List (List (List (Fin q × Bool))))
    (payload : Formula (Fin (a + q))) (z : Fin q → Fin 2) :
    VNPNestedBooleanSum.witnessEval a q z
        (Formula.mul (witnessFormula a q (checkTables ts)) payload).value =
      if ts.all (fun ps => ps.any (fun p => p.all (fun x => witnessBool (z x.1) == x.2))) then
        VNPNestedBooleanSum.witnessEval a q z payload.value else 0 := by
  rw [witness_filter, checkTables_test]

theorem tables_filter_size (a q : ℕ) (ts : List (List (List (Fin q × Bool))))
    (payload : Formula (Fin (a + q))) :
    (Formula.mul (witnessFormula a q (checkTables ts)) payload).size ≤
      7 * (3 * (ts.map tableBits).sum + 2 * (ts.map List.length).sum + 2 * ts.length + 1) +
        payload.size + 1 := by
  have h := witness_filter_size a q (checkTables ts) payload
  have ht := checkTables_nodes ts
  omega


end CertificateConstraints

-- From Solutions.FiniteLookupFormula

/-! Compile a finite lookup function into a Boolean pattern-table formula.
    This is useful for bounded tag fields, whose set is polynomially sized;
    it must not be applied to the exponentially larger set of whole states. -/

namespace FiniteLookupFormula

open BooleanVerifierFormula CertificateConstraints

variable {A σ : Type} [Fintype A]

def pattern (w : ℕ) (inputs : Fin w → σ) (bits : Fin w → Bool) : List (σ × Bool) :=
  List.ofFn fun i => (inputs i,bits i)

noncomputable def table (w : ℕ) (inputs : Fin w → σ) (enc : A → Fin w → Bool)
    (f : A → Bool) : List (List (σ × Bool)) :=
  (Finset.univ.toList.filter f).map fun x => pattern w inputs (enc x)

theorem pattern_matches (w : ℕ) (inputs : Fin w → σ) (bits : Fin w → Bool) (v : σ → Bool) :
    ((pattern w inputs bits).all (fun x => v x.1 == x.2) = true) ↔
      ∀ i, v (inputs i) = bits i := by
  simp [pattern,List.all_eq_true,List.mem_ofFn]

theorem table_matches (w : ℕ) (inputs : Fin w → σ) (enc : A → Fin w → Bool)
    (f : A → Bool) (v : σ → Bool) :
    (matchesTable (table w inputs enc f)).test v = true ↔
      ∃ x : A, f x = true ∧ ∀ i, v (inputs i) = enc x i := by
  classical
  rw [matchesTable_test,List.any_eq_true]
  simp only [table,List.mem_map,List.mem_filter,Finset.mem_toList,Finset.mem_univ,true_and,
    pattern_matches,exists_exists_and_eq_and]

/-- On an encoded tag, the table returns exactly the requested Boolean
    lookup value, assuming the tag encoding is injective. -/
theorem table_on_code (w : ℕ) (inputs : Fin w → σ) (enc : A → Fin w → Bool)
    (henc : Function.Injective enc) (f : A → Bool) (v : σ → Bool) (x : A)
    (hv : ∀ i, v (inputs i) = enc x i) :
    (matchesTable (table w inputs enc f)).test v = f x := by
  cases hx : f x with
  | false =>
    have hn : (matchesTable (table w inputs enc f)).test v ≠ true := by
      intro hh
      obtain ⟨y,hy,he⟩ := (table_matches w inputs enc f v).mp hh
      have hxy : enc y = enc x := by funext i; rw [← he i, hv i]
      have : y = x := henc hxy
      subst y
      simp [hx] at hy
    cases ht : (matchesTable (table w inputs enc f)).test v <;> simp_all
  | true =>
    apply (table_matches w inputs enc f v).mpr
    exact ⟨x,hx,hv⟩

theorem table_length (w : ℕ) (inputs : Fin w → σ) (enc : A → Fin w → Bool) (f : A → Bool) :
    (table w inputs enc f).length ≤ Fintype.card A := by
  classical
  simp only [table,List.length_map]
  simpa only [Finset.length_toList,Finset.card_univ] using
    (List.length_filter_le f (Finset.univ : Finset A).toList)

theorem table_row_lengths (w : ℕ) (inputs : Fin w → σ) (enc : A → Fin w → Bool) (f : A → Bool) :
    ((table w inputs enc f).map List.length).sum = (table w inputs enc f).length * w := by
  classical
  simp only [table,List.length_map,List.map_map,Function.comp_def,pattern,List.length_ofFn]
  induction (Finset.univ.toList.filter f) with
  | nil => simp
  | cons x xs ih => simp [ih,Nat.add_mul,Nat.add_comm]

theorem lookup_nodes (w : ℕ) (inputs : Fin w → σ) (enc : A → Fin w → Bool) (f : A → Bool) :
    (matchesTable (table w inputs enc f)).nodes ≤ 3 * (Fintype.card A * w) + 2 * Fintype.card A + 1 := by
  have h := matchesTable_nodes (table w inputs enc f)
  rw [table_row_lengths] at h
  have hn := table_length w inputs enc f
  nlinarith


end FiniteLookupFormula

-- From Solutions.IndexedTagLookup

/-! Any Boolean control bit depending on one bounded tag has a polynomial
    size formula. This does not enumerate full machine states. -/

namespace IndexedTagLookup

open BooleanVerifierFormula CertificateConstraints FiniteLookupFormula IndexedNormalizedAddresses

variable {σ : Type}

noncomputable def tagLookup (m D : ℕ) (inputs : Fin (tagWordLength m D) → σ)
    (f : {a : Tag // a.bounded m D} → Bool) : BoolFormula σ :=
  matchesTable (table (tagWordLength m D) inputs (tagWord m D) f)

theorem tagLookup_correct (m D : ℕ) (inputs : Fin (tagWordLength m D) → σ)
    (f : {a : Tag // a.bounded m D} → Bool) (v : σ → Bool)
    (a : {a : Tag // a.bounded m D}) (h : ∀ i, v (inputs i) = tagWord m D a i) :
    (tagLookup m D inputs f).test v = f a :=
  table_on_code _ inputs (tagWord m D) (tagWord_injective m D) f v a h

theorem tagLookup_nodes (m D : ℕ) (inputs : Fin (tagWordLength m D) → σ)
    (f : {a : Tag // a.bounded m D} → Bool) :
    (tagLookup m D inputs f).nodes ≤
      3 * ((8 * (m+1)^2 * (D+1)^2) * tagWordLength m D) +
        2 * (8 * (m+1)^2 * (D+1)^2) + 1 := by
  have h := lookup_nodes (tagWordLength m D) inputs (tagWord m D) f
  have hc := boundedTag_card m D
  exact h.trans (by nlinarith)


end IndexedTagLookup

-- From Solutions.IndexedTagControl

/-! Compile all output bits of a function of a single bounded tag. The full
    parser transition additionally needs stack shifts, input-bit handling,
    and factor-list updates. -/

namespace IndexedTagControl

open IndexedNormalizedAddresses IndexedTagLookup BooleanVerifierFormula

variable {σ : Type}

def bitEq (p q : BoolFormula σ) : BoolFormula σ :=
  .or (.and p q) (.and (.not p) (.not q))

theorem bitEq_test (p q : BoolFormula σ) (v : σ → Bool) :
    (bitEq p q).test v = (p.test v == q.test v) := by
  cases hp : p.test v <;> cases hq : q.test v <;> simp [bitEq,BoolFormula.test,hp,hq]

theorem bitEq_nodes (p q : BoolFormula σ) : (bitEq p q).nodes = 2*p.nodes + 2*q.nodes + 5 := by
  simp only [bitEq,BoolFormula.nodes]
  omega

noncomputable def checks (m D r : ℕ) (input : Fin (tagWordLength m D) → σ)
    (output : Fin r → σ) (f : {a : Tag // a.bounded m D} → Fin r → Bool) :
    List (BoolFormula σ) :=
  List.ofFn fun j => bitEq (.bit (output j)) (tagLookup m D input (fun a => f a j))

noncomputable def checker (m D r : ℕ) (input : Fin (tagWordLength m D) → σ)
    (output : Fin r → σ) (f : {a : Tag // a.bounded m D} → Fin r → Bool) : BoolFormula σ :=
  conjunction (checks m D r input output f)

/-- On a valid encoded tag, the checker accepts exactly its requested
    output bit-vector. -/
theorem checker_correct (m D r : ℕ) (input : Fin (tagWordLength m D) → σ)
    (output : Fin r → σ) (f : {a : Tag // a.bounded m D} → Fin r → Bool)
    (v : σ → Bool) (a : {a : Tag // a.bounded m D})
    (hin : ∀ i, v (input i) = tagWord m D a i) :
    (checker m D r input output f).test v = true ↔ ∀ j, v (output j) = f a j := by
  rw [checker,conjunction_test,List.all_eq_true]
  constructor
  · intro h j
    have hh := h _ (show bitEq (.bit (output j)) (tagLookup m D input (fun a => f a j)) ∈
        checks m D r input output f by exact List.mem_ofFn.mpr ⟨j,rfl⟩)
    rw [bitEq_test,tagLookup_correct m D input (fun a => f a j) v a hin] at hh
    simpa [BoolFormula.test] using hh
  · intro h x hx
    obtain ⟨j,rfl⟩ := List.mem_ofFn.mp hx
    rw [bitEq_test,tagLookup_correct m D input (fun a => f a j) v a hin]
    simp [BoolFormula.test,h j]

def tagLookupBound (m D : ℕ) : ℕ :=
  3 * ((8 * (m+1)^2 * (D+1)^2) * tagWordLength m D) +
    2 * (8 * (m+1)^2 * (D+1)^2) + 1

/-- The entire tag-to-vector checker is polynomial in the tag bounds and
    linear in the number of output bits. -/
theorem checker_nodes (m D r : ℕ) (input : Fin (tagWordLength m D) → σ)
    (output : Fin r → σ) (f : {a : Tag // a.bounded m D} → Fin r → Bool) :
    (checker m D r input output f).nodes ≤ r * (2 * tagLookupBound m D + 8) + 1 := by
  rw [checker,conjunction_nodes]
  have hsum : ((checks m D r input output f).map BoolFormula.nodes).sum ≤
      (checks m D r input output f).length * (2 * tagLookupBound m D + 7) := by
    have hh := List.sum_le_sum (l := checks m D r input output f)
      (f := BoolFormula.nodes) (g := fun _ => 2 * tagLookupBound m D + 7) (by
        intro p hp
        obtain ⟨j,rfl⟩ := List.mem_ofFn.mp hp
        have h := tagLookup_nodes m D input (fun a => f a j)
        rw [bitEq_nodes]
        simp only [BoolFormula.nodes]
        dsimp [tagLookupBound]
        omega)
    simpa using hh
  simp only [checks,List.length_ofFn] at hsum ⊢
  nlinarith

/-- A single input bit chooses which tag-dependent output vector to check. -/
noncomputable def branchChecker (m D r : ℕ) (input : Fin (tagWordLength m D) → σ)
    (branch : σ) (output : Fin r → σ)
    (f : {a : Tag // a.bounded m D} → Bool → Fin r → Bool) : BoolFormula σ :=
  .or (.and (.not (.bit branch)) (checker m D r input output (fun a => f a false)))
      (.and (.bit branch) (checker m D r input output (fun a => f a true)))

theorem branchChecker_correct (m D r : ℕ) (input : Fin (tagWordLength m D) → σ)
    (branch : σ) (output : Fin r → σ)
    (f : {a : Tag // a.bounded m D} → Bool → Fin r → Bool)
    (v : σ → Bool) (a : {a : Tag // a.bounded m D})
    (hin : ∀ i, v (input i) = tagWord m D a i) :
    (branchChecker m D r input branch output f).test v = true ↔
      ∀ j, v (output j) = f a (v branch) j := by
  cases hb : v branch with
  | false =>
    simpa [branchChecker,BoolFormula.test,hb] using
      (checker_correct m D r input output (fun a => f a false) v a hin)
  | true =>
    simpa [branchChecker,BoolFormula.test,hb] using
      (checker_correct m D r input output (fun a => f a true) v a hin)

theorem branchChecker_nodes (m D r : ℕ) (input : Fin (tagWordLength m D) → σ)
    (branch : σ) (output : Fin r → σ)
    (f : {a : Tag // a.bounded m D} → Bool → Fin r → Bool) :
    (branchChecker m D r input branch output f).nodes ≤ 2 * r * (2 * tagLookupBound m D + 8) + 8 := by
  have h₀ := checker_nodes m D r input output (fun a => f a false)
  have h₁ := checker_nodes m D r input output (fun a => f a true)
  simp only [branchChecker,BoolFormula.nodes]
  nlinarith


end IndexedTagControl

-- From Solutions.BoundedListEncoding

/-! Encode a bounded list of finitely encoded objects as a fixed-width bit
    vector. Every slot has a presence bit, so trailing padding is unambiguous. -/

namespace BoundedListEncoding

variable {α : Type}

def liftList {p : α → Prop} (l : List α) (h : ∀ x ∈ l, p x) : List {x // p x} :=
  l.attach.map (fun x => ⟨x.val,h x.val x.property⟩)

theorem liftList_values {p : α → Prop} (l : List α) (h : ∀ x ∈ l, p x) :
    (liftList l h).map Subtype.val = l := by
  simp [liftList, List.map_map]

theorem liftList_length {p : α → Prop} (l : List α) (h : ∀ x ∈ l, p x) :
    (liftList l h).length = l.length := by simp [liftList]

/-- Extend an encoding from a bounded subtype to all raw entries. Invalid
    entries get an arbitrary all-zero code and are excluded by the invariant. -/
noncomputable def extendCode {p : α → Prop} (w : ℕ) (enc : {x // p x} → Fin w → Bool)
    (x : α) : Fin w → Bool := by
  classical
  exact if hx : p x then enc ⟨x,hx⟩ else fun _ => false

theorem liftList_map_encode {p : α → Prop} (w : ℕ) (enc : {x // p x} → Fin w → Bool)
    (l : List α) (h : ∀ x ∈ l, p x) :
    (liftList l h).map enc = l.map (extendCode w enc) := by
  classical
  unfold liftList
  rw [List.map_map]
  conv_rhs => rw [← List.attach_map_val (f := extendCode w enc)]
  apply List.map_congr_left
  intro x hx
  simp [Function.comp_def,extendCode,h x.val x.property]

def optionWord {w : ℕ} (x : Option (Fin w → Bool)) : Fin (w + 1) → Bool :=
  Fin.cons x.isSome (x.getD (fun _ => false))

theorem optionWord_injective (w : ℕ) : Function.Injective (@optionWord w) := by
  intro x y h
  cases x with
  | none =>
    cases y with
    | none => rfl
    | some b => have hh := congrFun h 0; simp [optionWord] at hh
  | some a =>
    cases y with
    | none => have hh := congrFun h 0; simp [optionWord] at hh
    | some b =>
      congr 1
      funext i
      have hh := congrFun h i.succ
      simpa [optionWord] using hh

/-- The `i`-th slot stores either the encoding of the `i`-th list entry or
    an explicit empty marker. -/
def listSlots (N w : ℕ) (enc : α → Fin w → Bool) (l : List α) :
    Fin N → Fin (w + 1) → Bool :=
  fun i => optionWord (l[i.val]?.map enc)

/-- Slot access with a natural index; out-of-range slots are empty. -/
def slotAt (w : ℕ) (enc : α → Fin w → Bool) (l : List α) (i : ℕ) : Fin (w+1) → Bool :=
  optionWord (l[i]?.map enc)

/-- The bounded-subtype slot encoding agrees with the raw slot encoding on
    lists whose entries satisfy the bound. -/
theorem slotAt_liftList {p : α → Prop} (w : ℕ) (enc : {x // p x} → Fin w → Bool)
    (l : List α) (h : ∀ x ∈ l, p x) (i : ℕ) :
    slotAt w enc (liftList l h) i = slotAt w (extendCode w enc) l i := by
  unfold slotAt
  congr 1
  have he := congrArg (fun xs => xs[i]?) (liftList_map_encode w enc l h)
  simpa only [List.getElem?_map] using he

theorem slotAt_cons_zero (w : ℕ) (enc : α → Fin w → Bool) (x : α) (xs : List α) :
    slotAt w enc (x :: xs) 0 = optionWord (some (enc x)) := by
  simp [slotAt]

theorem slotAt_cons_succ (w : ℕ) (enc : α → Fin w → Bool) (x : α) (xs : List α) (i : ℕ) :
    slotAt w enc (x :: xs) (i+1) = slotAt w enc xs i := by
  simp [slotAt]

/-- The first bit of a slot is its presence flag. -/
theorem slotAt_presence (w : ℕ) (enc : α → Fin w → Bool) (l : List α) (i : ℕ) :
    slotAt w enc l i 0 = decide (i < l.length) := by
  by_cases hi : i < l.length
  · simp [slotAt,optionWord,List.getElem?_eq_getElem hi,hi]
  · have h : l.length ≤ i := by omega
    simp [slotAt,optionWord,List.getElem?_eq_none h,hi]

theorem slotAt_absent (w : ℕ) (enc : α → Fin w → Bool) (l : List α) (i : ℕ)
    (h : l.length ≤ i) : slotAt w enc l i = fun _ => false := by
  funext j
  refine Fin.cases ?_ (fun j => ?_) j
  · simp [slotAt,optionWord,List.getElem?_eq_none h]
  · simp [slotAt,optionWord,List.getElem?_eq_none h]

/-- A concatenated list can be read locally from the left list or from the
    appropriately shifted right list. -/
theorem slotAt_append (w : ℕ) (enc : α → Fin w → Bool) (xs ys : List α) (i : ℕ) :
    slotAt w enc (xs ++ ys) i =
      if i < xs.length then slotAt w enc xs i else slotAt w enc ys (i - xs.length) := by
  by_cases hi : i < xs.length
  · simp [slotAt,hi,List.getElem?_append_left hi]
  · have hh : xs.length ≤ i := by omega
    simp [slotAt,hi,List.getElem?_append_right hh]

/-- After popping one old stack entry and prepending a short plan, every
    output slot is either a plan slot or a shifted old-stack slot. -/
theorem slotAt_stack_update (w : ℕ) (enc : α → Fin w → Bool)
    (top : α) (rest push : List α) (i : ℕ) :
    slotAt w enc (push ++ rest) i =
      if i < push.length then slotAt w enc push i
      else slotAt w enc (top :: rest) (i - push.length + 1) := by
  rw [slotAt_append]
  by_cases h : i < push.length <;> simp [h,slotAt_cons_succ]

/-- Expanded three-way version of a pop followed by zero, one, or two
    pushes. The right-hand side uses only fixed offsets and two control bits. -/
theorem slotAt_stack_threeWay (w : ℕ) (enc : α → Fin w → Bool)
    (top : α) (rest push : List α) (i : ℕ) (hpush : push.length ≤ 2) :
    slotAt w enc (push ++ rest) i =
      if push.length > 0 then
        if push.length = 2 then
          (if i = 0 then slotAt w enc push 0 else
            if i = 1 then slotAt w enc push 1 else slotAt w enc (top :: rest) (i-1))
        else (if i = 0 then slotAt w enc push 0 else slotAt w enc (top :: rest) i)
      else slotAt w enc (top :: rest) (i+1) := by
  rw [slotAt_stack_update w enc top rest push i]
  by_cases h0 : push.length = 0
  · simp [h0]
  · by_cases h2 : push.length = 2
    · by_cases hi0 : i = 0
      · simp [h2,hi0]
      · by_cases hi1 : i = 1
        · simp [h2,hi0,hi1]
        · have hi : 2 ≤ i := by omega
          have he : i - 2 + 1 = i - 1 := by omega
          simp [h2,hi0,hi1,show ¬ i < 2 by omega,he]
    · have h1 : push.length = 1 := by omega
      by_cases hi0 : i = 0
      · simp [h1,hi0]
      · have hi : 1 ≤ i := by omega
        have he : i - 1 + 1 = i := by omega
        simp [h1,hi0,show ¬ i < 1 by omega,he]

/-- Prepending an optional entry is a two-way slot update. -/
theorem slotAt_optional_update (w : ℕ) (enc : α → Fin w → Bool)
    (x : Option α) (rest : List α) (i : ℕ) :
    slotAt w enc (x.toList ++ rest) i =
      if x.isSome then
        (if i = 0 then slotAt w enc x.toList 0 else slotAt w enc rest (i-1))
      else slotAt w enc rest i := by
  cases x with
  | none => simp
  | some x =>
    cases i with
    | zero => simp [slotAt,optionWord]
    | succ i => simp [slotAt_cons_succ]

theorem option_map_injective {β : Type} (f : α → β) (hf : Function.Injective f) :
    Function.Injective (Option.map f) := by
  intro x y h
  cases x with
  | none => cases y <;> simp_all
  | some a =>
    cases y with
    | none => simp at h
    | some b => simp only [Option.map_some,Option.some.injEq] at h; simp [hf h]

theorem listSlots_injective (N w : ℕ) (enc : α → Fin w → Bool) (henc : Function.Injective enc)
    (l₁ l₂ : List α) (h₁ : l₁.length ≤ N) (h₂ : l₂.length ≤ N)
    (h : listSlots N w enc l₁ = listSlots N w enc l₂) : l₁ = l₂ := by
  apply List.ext_getElem?
  intro i
  by_cases hi : i < N
  · have hh := congrFun h ⟨i,hi⟩
    have ho := optionWord_injective w hh
    exact option_map_injective enc henc ho
  · have h₁' : l₁.length ≤ i := by omega
    have h₂' : l₂.length ≤ i := by omega
    rw [List.getElem?_eq_none h₁',List.getElem?_eq_none h₂']

/-- Flatten the slot table into one vector of `N * (w+1)` bits. -/
def listWord (N w : ℕ) (enc : α → Fin w → Bool) (l : List α) :
    Fin (N * (w + 1)) → Bool :=
  fun i => listSlots N w enc l (finProdFinEquiv.symm i).1 (finProdFinEquiv.symm i).2

theorem listWord_at (N w : ℕ) (enc : α → Fin w → Bool) (l : List α)
    (i : Fin N) (j : Fin (w+1)) :
    listWord N w enc l (finProdFinEquiv (i,j)) = slotAt w enc l i.val j := by
  simp [listWord,listSlots,slotAt]

theorem listWord_injective (N w : ℕ) (enc : α → Fin w → Bool) (henc : Function.Injective enc)
    (l₁ l₂ : List α) (h₁ : l₁.length ≤ N) (h₂ : l₂.length ≤ N)
    (h : listWord N w enc l₁ = listWord N w enc l₂) : l₁ = l₂ := by
  apply listSlots_injective N w enc henc l₁ l₂ h₁ h₂
  funext i j
  have hh := congrFun h (finProdFinEquiv (i,j))
  simpa [listWord] using hh


end BoundedListEncoding

-- From Solutions.IndexedStateEncoding

/-! Fixed-width, injective Boolean encoding for all indexed decoder states
    within given stack, factor, and remaining-input bounds. -/

namespace IndexedStateEncoding

open IndexedFactorMachine IndexedNormalizedAddresses BoundedListEncoding

def admissible (m D N : ℕ) (s : State) : Prop :=
  s.bounded m D ∧ s.pending.length ≤ N+1 ∧ s.factors.length ≤ N ∧ s.bits.length ≤ N

def bitWord (b : Bool) : Fin 1 → Bool := fun _ => b

theorem bitWord_injective : Function.Injective bitWord := by
  intro a b h
  exact congrFun h 0

def stackItems (m D N : ℕ) (s : {s : State // admissible m D N s}) :
    List {a : Tag // a.bounded m D} :=
  liftList s.val.pending s.property.1.1

def factorItems (m D N : ℕ) (s : {s : State // admissible m D N s}) :
    List {a : Leaf // a.bounded m} :=
  liftList s.val.factors s.property.1.2

def stateWidth (m D N : ℕ) : ℕ :=
  (N+1) * (tagWordLength m D + 1) +
    (N * ((3 + (m+1)) + 1) + N * (1+1))

/-- The state uses fixed numbers of slots with explicit presence bits. -/
def stateWord (m D N : ℕ) (s : {s : State // admissible m D N s}) :
    Fin (stateWidth m D N) → Bool :=
  Fin.append (listWord (N+1) (tagWordLength m D) (tagWord m D) (stackItems m D N s))
    (Fin.append (listWord N (3 + (m+1)) (leafWord m) (factorItems m D N s))
      (listWord N 1 bitWord s.val.bits))

def stackCoord (m D N : ℕ) (i : Fin (N+1)) (j : Fin (tagWordLength m D + 1)) :
    Fin (stateWidth m D N) :=
  Fin.castAdd (N * ((3+(m+1))+1) + N*(1+1)) (finProdFinEquiv (i,j))

def factorCoord (m D N : ℕ) (i : Fin N) (j : Fin ((3+(m+1))+1)) :
    Fin (stateWidth m D N) :=
  Fin.natAdd ((N+1)*(tagWordLength m D+1))
    (Fin.castAdd (N*(1+1)) (finProdFinEquiv (i,j)))

def inputCoord (m D N : ℕ) (i : Fin N) (j : Fin (1+1)) : Fin (stateWidth m D N) :=
  Fin.natAdd ((N+1)*(tagWordLength m D+1))
    (Fin.natAdd (N*((3+(m+1))+1)) (finProdFinEquiv (i,j)))

/-- The stack segment of the fixed-width state word is exactly its raw
    padded slot encoding. -/
theorem stateWord_stackSlot (m D N : ℕ) (s : {s : State // admissible m D N s})
    (i : Fin (N+1)) (j : Fin (tagWordLength m D+1)) :
    stateWord m D N s (stackCoord m D N i j) =
      slotAt (tagWordLength m D) (extendCode _ (tagWord m D)) s.val.pending i.val j := by
  simp only [stateWord,stackCoord,Fin.append_left,listWord_at,stackItems]
  rw [slotAt_liftList]

theorem stateWord_factorSlot (m D N : ℕ) (s : {s : State // admissible m D N s})
    (i : Fin N) (j : Fin ((3+(m+1))+1)) :
    stateWord m D N s (factorCoord m D N i j) =
      slotAt (3+(m+1)) (extendCode _ (leafWord m)) s.val.factors i.val j := by
  simp only [stateWord,factorCoord,Fin.append_right,Fin.append_left,listWord_at,factorItems]
  rw [slotAt_liftList]

theorem stateWord_inputSlot (m D N : ℕ) (s : {s : State // admissible m D N s})
    (i : Fin N) (j : Fin (1+1)) :
    stateWord m D N s (inputCoord m D N i j) = slotAt 1 bitWord s.val.bits i.val j := by
  simp only [stateWord,inputCoord,Fin.append_right,listWord_at,listSlots,slotAt]

/-- Reading beyond a fixed segment returns the all-zero empty slot. -/
def stackRead (m D N : ℕ) (word : Fin (stateWidth m D N) → Bool)
    (i : ℕ) (j : Fin (tagWordLength m D+1)) : Bool :=
  if hi : i < N+1 then word (stackCoord m D N ⟨i,hi⟩ j) else false

def factorRead (m D N : ℕ) (word : Fin (stateWidth m D N) → Bool)
    (i : ℕ) (j : Fin ((3+(m+1))+1)) : Bool :=
  if hi : i < N then word (factorCoord m D N ⟨i,hi⟩ j) else false

def inputRead (m D N : ℕ) (word : Fin (stateWidth m D N) → Bool)
    (i : ℕ) (j : Fin (1+1)) : Bool :=
  if hi : i < N then word (inputCoord m D N ⟨i,hi⟩ j) else false

theorem stackRead_stateWord (m D N : ℕ) (s : {s : State // admissible m D N s})
    (i : ℕ) (j : Fin (tagWordLength m D+1)) :
    stackRead m D N (stateWord m D N s) i j =
      slotAt (tagWordLength m D) (extendCode _ (tagWord m D)) s.val.pending i j := by
  by_cases hi : i < N+1
  · simpa [stackRead,hi] using stateWord_stackSlot m D N s ⟨i,hi⟩ j
  · have hlen : s.val.pending.length ≤ i := by have h := s.property.2.1; omega
    simp [stackRead,hi,slotAt_absent _ _ _ _ hlen]

theorem factorRead_stateWord (m D N : ℕ) (s : {s : State // admissible m D N s})
    (i : ℕ) (j : Fin ((3+(m+1))+1)) :
    factorRead m D N (stateWord m D N s) i j =
      slotAt (3+(m+1)) (extendCode _ (leafWord m)) s.val.factors i j := by
  by_cases hi : i < N
  · simpa [factorRead,hi] using stateWord_factorSlot m D N s ⟨i,hi⟩ j
  · have hlen : s.val.factors.length ≤ i := by have h := s.property.2.2.1; omega
    simp [factorRead,hi,slotAt_absent _ _ _ _ hlen]

theorem inputRead_stateWord (m D N : ℕ) (s : {s : State // admissible m D N s})
    (i : ℕ) (j : Fin (1+1)) :
    inputRead m D N (stateWord m D N s) i j = slotAt 1 bitWord s.val.bits i j := by
  by_cases hi : i < N
  · simpa [inputRead,hi] using stateWord_inputSlot m D N s ⟨i,hi⟩ j
  · have hlen : s.val.bits.length ≤ i := by have h := s.property.2.2.2; omega
    simp [inputRead,hi,slotAt_absent _ _ _ _ hlen]

/-- The data bits of the first present stack slot are exactly the tag code. -/
theorem stateWord_topTag (m D N : ℕ) (s : {s : State // admissible m D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest)
    (ha : a.bounded m D) (j : Fin (tagWordLength m D)) :
    stateWord m D N s (stackCoord m D N 0 j.succ) = tagWord m D ⟨a,ha⟩ j := by
  rw [stateWord_stackSlot]
  simp [hp,slotAt,optionWord,extendCode,ha]

/-- The data bit of the first present input slot is the next input bit. -/
theorem stateWord_inputHead (m D N : ℕ) (s : {s : State // admissible m D N s})
    (hN : 0 < N) (b : Bool) (rest : List Bool) (hb : s.val.bits = b :: rest) :
    stateWord m D N s (inputCoord m D N ⟨0,hN⟩ 1) = b := by
  rw [stateWord_inputSlot]
  simp [hb,slotAt,optionWord,bitWord]

theorem stateWord_topPresent (m D N : ℕ) (s : {s : State // admissible m D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest) :
    stateWord m D N s (stackCoord m D N 0 0) = true := by
  rw [stateWord_stackSlot,slotAt_presence]
  simp [hp]

theorem stateWord_topAbsent (m D N : ℕ) (s : {s : State // admissible m D N s})
    (hp : s.val.pending = []) : stateWord m D N s (stackCoord m D N 0 0) = false := by
  rw [stateWord_stackSlot,slotAt_presence]
  simp [hp]

/-- Equality of all encoded stack bits implies equality of the actual stack,
    independently of the factor and input portions of the state. -/
theorem stackSlots_injective (m D N : ℕ) (s t : {s : State // admissible m D N s})
    (h : ∀ i : Fin (N+1), ∀ j : Fin (tagWordLength m D+1),
      stateWord m D N s (stackCoord m D N i j) = stateWord m D N t (stackCoord m D N i j)) :
    s.val.pending = t.val.pending := by
  have hw : listWord (N+1) (tagWordLength m D) (tagWord m D) (stackItems m D N s) =
      listWord (N+1) (tagWordLength m D) (tagWord m D) (stackItems m D N t) := by
    funext u
    have hh := h (finProdFinEquiv.symm u).1 (finProdFinEquiv.symm u).2
    simpa only [stateWord,stackCoord,Fin.append_left,Prod.eta,Equiv.apply_symm_apply] using hh
  have hl := listWord_injective (N+1) (tagWordLength m D) (tagWord m D) (tagWord_injective m D)
    (stackItems m D N s) (stackItems m D N t)
    (by simpa [stackItems,liftList_length] using s.property.2.1)
    (by simpa [stackItems,liftList_length] using t.property.2.1) hw
  have hv := congrArg (List.map Subtype.val) hl
  change (liftList s.val.pending s.property.1.1).map Subtype.val =
    (liftList t.val.pending t.property.1.1).map Subtype.val at hv
  rw [liftList_values,liftList_values] at hv
  exact hv

theorem factorSlots_injective (m D N : ℕ) (s t : {s : State // admissible m D N s})
    (h : ∀ i : Fin N, ∀ j : Fin ((3+(m+1))+1),
      stateWord m D N s (factorCoord m D N i j) = stateWord m D N t (factorCoord m D N i j)) :
    s.val.factors = t.val.factors := by
  have hw : listWord N (3+(m+1)) (leafWord m) (factorItems m D N s) =
      listWord N (3+(m+1)) (leafWord m) (factorItems m D N t) := by
    funext u
    have hh := h (finProdFinEquiv.symm u).1 (finProdFinEquiv.symm u).2
    simpa only [stateWord,factorCoord,Fin.append_left,Fin.append_right,Prod.eta,Equiv.apply_symm_apply] using hh
  have hl := listWord_injective N (3+(m+1)) (leafWord m) (leafWord_injective m)
    (factorItems m D N s) (factorItems m D N t)
    (by simpa [factorItems,liftList_length] using s.property.2.2.1)
    (by simpa [factorItems,liftList_length] using t.property.2.2.1) hw
  have hv := congrArg (List.map Subtype.val) hl
  change (liftList s.val.factors s.property.1.2).map Subtype.val =
    (liftList t.val.factors t.property.1.2).map Subtype.val at hv
  rw [liftList_values,liftList_values] at hv
  exact hv

theorem inputSlots_injective (m D N : ℕ) (s t : {s : State // admissible m D N s})
    (h : ∀ i : Fin N, ∀ j : Fin (1+1),
      stateWord m D N s (inputCoord m D N i j) = stateWord m D N t (inputCoord m D N i j)) :
    s.val.bits = t.val.bits := by
  have hw : listWord N 1 bitWord s.val.bits = listWord N 1 bitWord t.val.bits := by
    funext u
    have hh := h (finProdFinEquiv.symm u).1 (finProdFinEquiv.symm u).2
    simpa only [stateWord,inputCoord,Fin.append_right,Prod.eta,Equiv.apply_symm_apply] using hh
  exact listWord_injective N 1 bitWord bitWord_injective s.val.bits t.val.bits
    s.property.2.2.2 t.property.2.2.2 hw

/-- The three slot segments cover every bit of a state word, including for
    arbitrary bit vectors that do not encode a valid state. -/
theorem stateBits_ext (m D N : ℕ) (u v : Fin (stateWidth m D N) → Bool)
    (hs : ∀ i : Fin (N+1), ∀ j : Fin (tagWordLength m D+1),
      u (stackCoord m D N i j) = v (stackCoord m D N i j))
    (hf : ∀ i : Fin N, ∀ j : Fin ((3+(m+1))+1),
      u (factorCoord m D N i j) = v (factorCoord m D N i j))
    (hb : ∀ i : Fin N, ∀ j : Fin (1+1),
      u (inputCoord m D N i j) = v (inputCoord m D N i j)) : u = v := by
  funext x
  refine Fin.addCases (fun a => ?_) (fun b => ?_) x
  · have hh := hs (finProdFinEquiv.symm a).1 (finProdFinEquiv.symm a).2
    simpa only [stackCoord,Prod.eta,Equiv.apply_symm_apply] using hh
  · refine Fin.addCases (fun a => ?_) (fun c => ?_) b
    · have hh := hf (finProdFinEquiv.symm a).1 (finProdFinEquiv.symm a).2
      simpa only [factorCoord,Prod.eta,Equiv.apply_symm_apply] using hh
    · have hh := hb (finProdFinEquiv.symm c).1 (finProdFinEquiv.symm c).2
      simpa only [inputCoord,Prod.eta,Equiv.apply_symm_apply] using hh

theorem stateWord_injective (m D N : ℕ) : Function.Injective (stateWord m D N) := by
  intro a b h
  apply Subtype.ext
  dsimp only [stateWord] at h
  obtain ⟨hs,h⟩ := append_injective h
  obtain ⟨hf,hb⟩ := append_injective h
  have hs' := listWord_injective (N+1) (tagWordLength m D) (tagWord m D) (tagWord_injective m D)
    (stackItems m D N a) (stackItems m D N b)
    (by simpa [stackItems,liftList_length] using a.property.2.1)
    (by simpa [stackItems,liftList_length] using b.property.2.1) hs
  have hf' := listWord_injective N (3+(m+1)) (leafWord m) (leafWord_injective m)
    (factorItems m D N a) (factorItems m D N b)
    (by simpa [factorItems,liftList_length] using a.property.2.2.1)
    (by simpa [factorItems,liftList_length] using b.property.2.2.1) hf
  have hb' := listWord_injective N 1 bitWord bitWord_injective a.val.bits b.val.bits
    a.property.2.2.2 b.property.2.2.2 hb
  have hs'' : a.val.pending = b.val.pending := by
    have hh := congrArg (List.map Subtype.val) hs'
    change (liftList a.val.pending a.property.1.1).map Subtype.val =
      (liftList b.val.pending b.property.1.1).map Subtype.val at hh
    rw [liftList_values,liftList_values] at hh
    exact hh
  have hf'' : a.val.factors = b.val.factors := by
    have hh := congrArg (List.map Subtype.val) hf'
    change (liftList a.val.factors a.property.1.2).map Subtype.val =
      (liftList b.val.factors b.property.1.2).map Subtype.val at hh
    rw [liftList_values,liftList_values] at hh
    exact hh
  cases ha : a.val with
  | mk ap ab af =>
    cases hc : b.val with
    | mk bp bb bf =>
      simp only [ha,hc] at hs'' hb' hf'' ⊢
      subst bp; subst bb; subst bf; rfl

/-- Every state encountered within `N` transitions from the initial state
    has a code of the indicated polynomial width. -/
theorem reached_admissible {σ : Type} (C : ResultantVNP.Circuit σ) (d N n : ℕ)
    (bits : List Bool) (hbits : bits.length ≤ N) (hn : n ≤ N) (s : State)
    (hrun : run C n (some (initial C d bits)) = some s) :
    admissible C.nodes.length (d+1) N s := by
  have hbounded := run_bounded C (d+1) n _ s (initial_bounded C d bits) hrun
  have hlens := run_lengths C n (initial C d bits) s hrun
  have hp : s.pending.length ≤ n+1 := by simpa [initial,Nat.add_comm] using hlens.1
  have hf : s.factors.length ≤ n := by simpa [initial] using hlens.2.1
  exact ⟨hbounded,by omega,by omega,le_trans hlens.2.2 hbits⟩

theorem stateWidth_bound (m D N : ℕ) : stateWidth m D N ≤ 4 * (N+1) * (m+D+5) := by
  simp only [stateWidth,tagWordLength]
  nlinarith

def transcriptWidth (m D N : ℕ) : ℕ := (N+1) * stateWidth m D N

theorem transcriptWidth_bound (m D N : ℕ) :
    transcriptWidth m D N ≤ 4 * (N+1)^2 * (m+D+5) := by
  have h := Nat.mul_le_mul_left (N+1) (stateWidth_bound m D N)
  dsimp [transcriptWidth]
  nlinarith

theorem run_none {σ : Type} (C : ResultantVNP.Circuit σ) (n : ℕ) : run C n none = none := by
  induction n with
  | zero => rfl
  | succ n ih => simpa [run] using ih

theorem run_add {σ : Type} (C : ResultantVNP.Circuit σ) (m n : ℕ) (s : Option State) :
    run C (m+n) s = run C n (run C m s) := by
  induction m generalizing s with
  | zero => simp [run]
  | succ m ih =>
    simp only [Nat.succ_add,run]
    exact ih (s.bind (step C))

/-- If a deterministic run finishes after `N` steps, each earlier state
    exists and has the bounded fixed-width encoding above. -/
theorem completed_run_prefix {σ : Type} (C : ResultantVNP.Circuit σ) (d N n : ℕ)
    (bits : List Bool) (hbits : bits.length ≤ N) (hn : n ≤ N)
    (sfinal : State) (hfinal : run C N (some (initial C d bits)) = some sfinal) :
    ∃ s, run C n (some (initial C d bits)) = some s ∧
      admissible C.nodes.length (d+1) N s := by
  have heq : N = n + (N-n) := by omega
  rw [heq,run_add] at hfinal
  cases hrun : run C n (some (initial C d bits)) with
  | none =>
    rw [hrun,run_none] at hfinal
    cases hfinal
  | some s =>
    exact ⟨s,rfl,reached_admissible C d N n bits hbits hn s hrun⟩


end IndexedStateEncoding

-- From Solutions.IndexedPlanControl

/-! Compile the actual tag-dependent part of a decoder step into a
    polynomial-size Boolean checker. Full stack and stream shifts remain. -/

namespace IndexedPlanControl

open ResultantVNP IndexedNormalizedAddresses IndexedFactorMachine IndexedPlan
  IndexedTagControl IndexedStateEncoding BoundedListEncoding BooleanVerifierFormula

variable {σ τ : Type}

def planWidth (m D : ℕ) : ℕ := 2 * (tagWordLength m D + 1) + (1 * ((3 + (m+1)) + 1) + 1)

def planTags (m D : ℕ) (p : {p : Plan // p.bounded m D}) : List {a : Tag // a.bounded m D} :=
  liftList p.val.push p.property.2.1

def planFactors (m D : ℕ) (p : {p : Plan // p.bounded m D}) : List {a : Leaf // a.bounded m} :=
  liftList p.val.factor.toList p.property.2.2

def planWord (m D : ℕ) (p : {p : Plan // p.bounded m D}) : Fin (planWidth m D) → Bool :=
  Fin.append (listWord 2 (tagWordLength m D) (tagWord m D) (planTags m D p))
    (Fin.append (listWord 1 (3+(m+1)) (leafWord m) (planFactors m D p)) (bitWord p.val.consume))

def pushCoord (m D : ℕ) (i : Fin 2) (j : Fin (tagWordLength m D+1)) : Fin (planWidth m D) :=
  Fin.castAdd (1*((3+(m+1))+1)+1) (finProdFinEquiv (i,j))

def factorCoord (m D : ℕ) (j : Fin ((3+(m+1))+1)) : Fin (planWidth m D) :=
  Fin.natAdd (2*(tagWordLength m D+1))
    (Fin.castAdd 1 (finProdFinEquiv ((0 : Fin 1),j)))

def consumeCoord (m D : ℕ) : Fin (planWidth m D) :=
  Fin.natAdd (2*(tagWordLength m D+1)) (Fin.natAdd (1*((3+(m+1))+1)) (0 : Fin 1))

theorem planWord_pushSlot (m D : ℕ) (p : {p : Plan // p.bounded m D})
    (i : Fin 2) (j : Fin (tagWordLength m D+1)) :
    planWord m D p (pushCoord m D i j) =
      slotAt (tagWordLength m D) (extendCode _ (tagWord m D)) p.val.push i.val j := by
  simp only [planWord,pushCoord,Fin.append_left,listWord_at,planTags]
  rw [slotAt_liftList]

theorem planWord_factorSlot (m D : ℕ) (p : {p : Plan // p.bounded m D})
    (j : Fin ((3+(m+1))+1)) :
    planWord m D p (factorCoord m D j) =
      slotAt (3+(m+1)) (extendCode _ (leafWord m)) p.val.factor.toList 0 j := by
  simp only [planWord,factorCoord,Fin.append_right,Fin.append_left,listWord_at,planFactors]
  rw [slotAt_liftList]
  rfl

theorem planWord_consume (m D : ℕ) (p : {p : Plan // p.bounded m D}) :
    planWord m D p (consumeCoord m D) = p.val.consume := by
  simp [planWord,consumeCoord,Fin.append_right,bitWord]

/-- The first two push-slot presence bits are precisely the two controls
    used by the three-way stack update. -/
theorem planWord_pushControls (m D : ℕ) (p : {p : Plan // p.bounded m D}) :
    planWord m D p (pushCoord m D 0 0) = decide (p.val.push.length > 0) ∧
    planWord m D p (pushCoord m D 1 0) = decide (p.val.push.length = 2) := by
  rw [planWord_pushSlot,planWord_pushSlot,slotAt_presence,slotAt_presence]
  have h := p.property.1
  constructor
  · rfl
  · by_cases h2 : p.val.push.length = 2
    · simp [h2]
    · have h1 : ¬ 1 < p.val.push.length := by omega
      simp [h2,h1]

theorem planWord_factorControl (m D : ℕ) (p : {p : Plan // p.bounded m D}) :
    planWord m D p (factorCoord m D 0) = p.val.factor.isSome := by
  rw [planWord_factorSlot,slotAt_presence]
  cases p.val.factor <;> simp

theorem planWord_injective (m D : ℕ) : Function.Injective (planWord m D) := by
  intro a b h
  apply Subtype.ext
  dsimp only [planWord] at h
  obtain ⟨hp,h⟩ := append_injective h
  obtain ⟨hf,hb⟩ := append_injective h
  have hp' := listWord_injective 2 (tagWordLength m D) (tagWord m D) (tagWord_injective m D)
    (planTags m D a) (planTags m D b)
    (by simpa [planTags,liftList_length] using a.property.1)
    (by simpa [planTags,liftList_length] using b.property.1) hp
  have hf' := listWord_injective 1 (3+(m+1)) (leafWord m) (leafWord_injective m)
    (planFactors m D a) (planFactors m D b)
    (by simp [planFactors,liftList_length])
    (by simp [planFactors,liftList_length]) hf
  have hb' := bitWord_injective hb
  have hp'' : a.val.push = b.val.push := by
    have hh := congrArg (List.map Subtype.val) hp'
    change (liftList a.val.push a.property.2.1).map Subtype.val =
      (liftList b.val.push b.property.2.1).map Subtype.val at hh
    rw [liftList_values,liftList_values] at hh
    exact hh
  have hf'' : a.val.factor = b.val.factor := by
    have hh := congrArg (List.map Subtype.val) hf'
    change (liftList a.val.factor.toList a.property.2.2).map Subtype.val =
      (liftList b.val.factor.toList b.property.2.2).map Subtype.val at hh
    rw [liftList_values,liftList_values] at hh
    cases ha : a.val.factor <;> cases hb : b.val.factor <;> simp_all
  cases ha : a.val with
  | mk ap ab af =>
    cases hc : b.val with
    | mk bp bb bf =>
      simp only [ha,hc] at hp'' hb' hf'' ⊢
      subst bp; subst bb; subst bf; rfl

noncomputable def boundedPlan {σ : Type} (C : Circuit σ) (D : ℕ)
    (a : {a : Tag // a.bounded C.nodes.length D}) (bit : Bool) :
    {p : Plan // p.bounded C.nodes.length D} :=
  ⟨plan C a.val bit,plan_bounded C D a.val a.property bit⟩

noncomputable def planChecker (C : Circuit σ) (D : ℕ)
    (input : Fin (tagWordLength C.nodes.length D) → τ) (branch : τ)
    (output : Fin (planWidth C.nodes.length D) → τ) : BoolFormula τ :=
  branchChecker C.nodes.length D (planWidth C.nodes.length D) input branch output
    (fun a bit => planWord C.nodes.length D (boundedPlan C D a bit))

theorem planChecker_correct (C : Circuit σ) (D : ℕ)
    (input : Fin (tagWordLength C.nodes.length D) → τ) (branch : τ)
    (output : Fin (planWidth C.nodes.length D) → τ) (v : τ → Bool)
    (a : {a : Tag // a.bounded C.nodes.length D})
    (hin : ∀ i, v (input i) = tagWord C.nodes.length D a i) :
    (planChecker C D input branch output).test v = true ↔
      ∀ j, v (output j) = planWord C.nodes.length D (boundedPlan C D a (v branch)) j :=
  branchChecker_correct _ _ _ input branch output _ v a hin

theorem planChecker_nodes (C : Circuit σ) (D : ℕ)
    (input : Fin (tagWordLength C.nodes.length D) → τ) (branch : τ)
    (output : Fin (planWidth C.nodes.length D) → τ) :
    (planChecker C D input branch output).nodes ≤
      2 * planWidth C.nodes.length D * (2 * tagLookupBound C.nodes.length D + 8) + 8 :=
  branchChecker_nodes _ _ _ input branch output _


end IndexedPlanControl

-- From Solutions.WiredPlanControl

/-! Wire the tag and input-bit control checker to the actual fixed-width
    encoded decoder state and a proposed encoded plan. -/

namespace WiredPlanControl

open ResultantVNP IndexedNormalizedAddresses IndexedFactorMachine IndexedPlan
  IndexedStateEncoding IndexedPlanControl BooleanVerifierFormula

variable {σ : Type}

noncomputable def checker (C : Circuit σ) (D N : ℕ) (hN : 0 < N) :
    BoolFormula (Fin (stateWidth C.nodes.length D N + planWidth C.nodes.length D)) :=
  planChecker C D
    (fun i => Fin.castAdd (planWidth C.nodes.length D) (stackCoord C.nodes.length D N 0 i.succ))
    (Fin.castAdd (planWidth C.nodes.length D) (inputCoord C.nodes.length D N ⟨0,hN⟩ 1))
    (fun j => Fin.natAdd (stateWidth C.nodes.length D N) j)

/-- For a present stack top and input bit, the wired checker accepts exactly
    the decoder's real control plan. -/
theorem checker_iff (C : Circuit σ) (D N : ℕ) (hN : 0 < N)
    (s : {s : State // admissible C.nodes.length D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest)
    (ha : a.bounded C.nodes.length D) (b : Bool) (bits : List Bool) (hb : s.val.bits = b :: bits)
    (p : {p : Plan // p.bounded C.nodes.length D}) :
    (checker C D N hN).test (Fin.append (stateWord _ _ _ s) (planWord _ _ p)) = true ↔
      p.val = plan C a b := by
  let input := fun i : Fin (tagWordLength C.nodes.length D) =>
    Fin.castAdd (planWidth C.nodes.length D) (stackCoord C.nodes.length D N 0 i.succ)
  let branch := Fin.castAdd (planWidth C.nodes.length D) (inputCoord C.nodes.length D N ⟨0,hN⟩ 1)
  let output := fun j : Fin (planWidth C.nodes.length D) => Fin.natAdd (stateWidth C.nodes.length D N) j
  let v := Fin.append (stateWord C.nodes.length D N s) (planWord C.nodes.length D p)
  have hin : ∀ i, v (input i) = tagWord C.nodes.length D ⟨a,ha⟩ i := by
    intro i
    change Fin.append (stateWord _ _ _ s) (planWord _ _ p)
      (Fin.castAdd _ (stackCoord _ _ _ 0 i.succ)) = _
    rw [Fin.append_left]
    exact stateWord_topTag _ _ _ s a rest hp ha i
  have hbranch : v branch = b := by
    change Fin.append (stateWord _ _ _ s) (planWord _ _ p)
      (Fin.castAdd _ (inputCoord _ _ _ ⟨0,hN⟩ 1)) = b
    rw [Fin.append_left]
    exact stateWord_inputHead _ _ _ s hN b bits hb
  change (planChecker C D input branch output).test v = true ↔ _
  rw [planChecker_correct C D input branch output v ⟨a,ha⟩ hin]
  simp only [hbranch]
  have hout : ∀ j, v (output j) = planWord C.nodes.length D p j := by
    intro j
    exact Fin.append_right _ _ j
  simp only [hout]
  constructor
  · intro h
    have he : planWord C.nodes.length D p =
        planWord C.nodes.length D (boundedPlan C D ⟨a,ha⟩ b) := funext h
    exact congrArg Subtype.val ((planWord_injective _ _) he)
  · intro h
    have he : p = boundedPlan C D ⟨a,ha⟩ b := Subtype.ext h
    intro j
    rw [he]

theorem checker_nodes (C : Circuit σ) (D N : ℕ) (hN : 0 < N) :
    (checker C D N hN).nodes ≤
      2 * planWidth C.nodes.length D * (2 * IndexedTagControl.tagLookupBound C.nodes.length D + 8) + 8 := by
  exact planChecker_nodes C D _ _ _


end WiredPlanControl

-- From Solutions.IndexedSlotUpdate

/-! Pointwise slot equations for one indexed decoder transition. These are
    the semantic specifications for the bit-vector copy and shift checks. -/

namespace IndexedSlotUpdate

open ResultantVNP IndexedNormalizedAddresses IndexedFactorMachine IndexedPlan BoundedListEncoding

variable {σ : Type}

theorem step_stack_slot (C : Circuit σ) (a : Tag) (rest : List Tag) (bit : Bool)
    (bits : List Bool) (factors : List Leaf) (t : State)
    (h : step C ⟨a :: rest,bit :: bits,factors⟩ = some t)
    (w : ℕ) (enc : Tag → Fin w → Bool) (i : ℕ) :
    slotAt w enc t.pending i =
      if i < (plan C a bit).push.length then slotAt w enc (plan C a bit).push i
      else slotAt w enc (a :: rest) (i - (plan C a bit).push.length + 1) := by
  have hs := step_as_plan C a rest bit bits factors
  rw [h] at hs
  have ht := Option.some.inj hs
  have hp : t.pending = (plan C a bit).push ++ rest := congrArg State.pending ht
  rw [hp,slotAt_stack_update]

theorem step_factor_slot (C : Circuit σ) (a : Tag) (rest : List Tag) (bit : Bool)
    (bits : List Bool) (factors : List Leaf) (t : State)
    (h : step C ⟨a :: rest,bit :: bits,factors⟩ = some t)
    (w : ℕ) (enc : Leaf → Fin w → Bool) (i : ℕ) :
    slotAt w enc t.factors i =
      if i < (plan C a bit).factor.toList.length then slotAt w enc (plan C a bit).factor.toList i
      else slotAt w enc factors (i - (plan C a bit).factor.toList.length) := by
  have hs := step_as_plan C a rest bit bits factors
  rw [h] at hs
  have ht := Option.some.inj hs
  have hp : t.factors = (plan C a bit).factor.toList ++ factors := congrArg State.factors ht
  rw [hp,slotAt_append]

theorem step_input_slot (C : Circuit σ) (a : Tag) (rest : List Tag) (bit : Bool)
    (bits : List Bool) (factors : List Leaf) (t : State)
    (h : step C ⟨a :: rest,bit :: bits,factors⟩ = some t)
    (w : ℕ) (enc : Bool → Fin w → Bool) (i : ℕ) :
    slotAt w enc t.bits i =
      if (plan C a bit).consume then slotAt w enc (bit :: bits) (i+1)
      else slotAt w enc (bit :: bits) i := by
  have hs := step_as_plan C a rest bit bits factors
  rw [h] at hs
  have ht := Option.some.inj hs
  have hp : t.bits = if (plan C a bit).consume then bits else bit :: bits := congrArg State.bits ht
  rw [hp]
  cases hc : (plan C a bit).consume <;> simp [hc,slotAt_cons_succ]

/-- Stack slots of a bounded decoder step have exactly the three-way
    conditional form implemented by the vector multiplexer. -/
theorem step_stack_threeWay (C : Circuit σ) (D : ℕ) (a : Tag)
    (ha : a.bounded C.nodes.length D) (rest : List Tag) (bit : Bool)
    (bits : List Bool) (factors : List Leaf) (t : State)
    (h : step C ⟨a :: rest,bit :: bits,factors⟩ = some t)
    (w : ℕ) (enc : Tag → Fin w → Bool) (i : ℕ) :
    slotAt w enc t.pending i =
      if (plan C a bit).push.length > 0 then
        if (plan C a bit).push.length = 2 then
          (if i = 0 then slotAt w enc (plan C a bit).push 0 else
            if i = 1 then slotAt w enc (plan C a bit).push 1 else
              slotAt w enc (a :: rest) (i-1))
        else (if i = 0 then slotAt w enc (plan C a bit).push 0 else slotAt w enc (a :: rest) i)
      else slotAt w enc (a :: rest) (i+1) := by
  have hs := step_as_plan C a rest bit bits factors
  rw [h] at hs
  have hp : t.pending = (plan C a bit).push ++ rest := congrArg State.pending (Option.some.inj hs)
  rw [hp]
  exact slotAt_stack_threeWay w enc a rest (plan C a bit).push i (plan_bounded C D a ha bit).1

/-- A factor-list update is a two-way conditional shift. -/
theorem step_factor_twoWay (C : Circuit σ) (a : Tag) (rest : List Tag) (bit : Bool)
    (bits : List Bool) (factors : List Leaf) (t : State)
    (h : step C ⟨a :: rest,bit :: bits,factors⟩ = some t)
    (w : ℕ) (enc : Leaf → Fin w → Bool) (i : ℕ) :
    slotAt w enc t.factors i =
      if (plan C a bit).factor.isSome then
        (if i = 0 then slotAt w enc (plan C a bit).factor.toList 0 else slotAt w enc factors (i-1))
      else slotAt w enc factors i := by
  have hs := step_as_plan C a rest bit bits factors
  rw [h] at hs
  have hp : t.factors = (plan C a bit).factor.toList ++ factors := congrArg State.factors (Option.some.inj hs)
  rw [hp]
  exact slotAt_optional_update w enc (plan C a bit).factor factors i


end IndexedSlotUpdate

-- From Solutions.BooleanVectorControl

/-! Polynomial-size bit-vector multiplexers for the copying and shifting
    parts of an encoded decoder transition. -/

namespace BooleanVectorControl

open BooleanVerifierFormula IndexedTagControl

variable {σ : Type}

def mux (c x y : BoolFormula σ) : BoolFormula σ :=
  .or (.and c x) (.and (.not c) y)

theorem mux_test (c x y : BoolFormula σ) (v : σ → Bool) :
    (mux c x y).test v = if c.test v then x.test v else y.test v := by
  cases hc : c.test v <;> cases hx : x.test v <;> cases hy : y.test v <;>
    simp [mux,BoolFormula.test,hc,hx,hy]

theorem mux_nodes (c x y : BoolFormula σ) :
    (mux c x y).nodes = 2*c.nodes + x.nodes + y.nodes + 4 := by
  simp only [mux,BoolFormula.nodes]
  omega

noncomputable def muxChecks (n : ℕ) (control : σ) (output yes no : Fin n → σ) :
    List (BoolFormula σ) :=
  List.ofFn fun i => bitEq (.bit (output i)) (mux (.bit control) (.bit (yes i)) (.bit (no i)))

noncomputable def muxChecker (n : ℕ) (control : σ) (output yes no : Fin n → σ) : BoolFormula σ :=
  conjunction (muxChecks n control output yes no)

/-- The checker asserts that the output vector is the selected input vector. -/
theorem muxChecker_correct (n : ℕ) (control : σ) (output yes no : Fin n → σ) (v : σ → Bool) :
    (muxChecker n control output yes no).test v = true ↔
      ∀ i, v (output i) = if v control then v (yes i) else v (no i) := by
  rw [muxChecker,conjunction_test,List.all_eq_true]
  constructor
  · intro h i
    have hh := h _ (show bitEq (.bit (output i)) (mux (.bit control) (.bit (yes i)) (.bit (no i))) ∈
      muxChecks n control output yes no by exact List.mem_ofFn.mpr ⟨i,rfl⟩)
    rw [bitEq_test,mux_test] at hh
    cases hc : v control <;> simp_all [BoolFormula.test]
  · intro h p hp
    obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hp
    rw [bitEq_test,mux_test]
    cases hc : v control <;> simp_all [BoolFormula.test]

/-- Checking a vector copy or shift controlled by one bit is linear in its
    length. -/
theorem muxChecker_nodes (n : ℕ) (control : σ) (output yes no : Fin n → σ) :
    (muxChecker n control output yes no).nodes ≤ 24*n + 1 := by
  rw [muxChecker,conjunction_nodes]
  have hsum : ((muxChecks n control output yes no).map BoolFormula.nodes).sum ≤
      (muxChecks n control output yes no).length * 23 := by
    have hh := List.sum_le_sum (l := muxChecks n control output yes no)
      (f := BoolFormula.nodes) (g := fun _ => 23) (by
        intro p hp
        obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hp
        simp [bitEq_nodes,mux_nodes,BoolFormula.nodes])
    simpa using hh
  simp only [muxChecks,List.length_ofFn] at hsum ⊢
  omega

/-- Two controlled vector multiplexers implement the three possible stack
    updates: pop only, replace the top, or push two entries. The intermediate
    vector is explicit transcript data and is uniquely determined. -/
noncomputable def threeWayChecker (n : ℕ) (first second : σ)
    (output middle two one zero : Fin n → σ) : BoolFormula σ :=
  .and (muxChecker n second middle two one) (muxChecker n first output middle zero)

theorem threeWayChecker_correct (n : ℕ) (first second : σ)
    (output middle two one zero : Fin n → σ) (v : σ → Bool) :
    (threeWayChecker n first second output middle two one zero).test v = true ↔
      (∀ i, v (middle i) = if v second then v (two i) else v (one i)) ∧
      (∀ i, v (output i) = if v first then v (middle i) else v (zero i)) := by
  simp only [threeWayChecker,BoolFormula.test,Bool.and_eq_true,muxChecker_correct]

theorem threeWayChecker_nodes (n : ℕ) (first second : σ)
    (output middle two one zero : Fin n → σ) :
    (threeWayChecker n first second output middle two one zero).nodes ≤ 48*n + 3 := by
  have h₁ := muxChecker_nodes n second middle two one
  have h₂ := muxChecker_nodes n first output middle zero
  simp only [threeWayChecker,BoolFormula.nodes]
  omega

def equalChecks (n : ℕ) (x y : Fin n → σ) : List (BoolFormula σ) :=
  List.ofFn fun i => bitEq (.bit (x i)) (.bit (y i))

def equalChecker (n : ℕ) (x y : Fin n → σ) : BoolFormula σ := conjunction (equalChecks n x y)

theorem equalChecker_correct (n : ℕ) (x y : Fin n → σ) (v : σ → Bool) :
    (equalChecker n x y).test v = true ↔ ∀ i, v (x i) = v (y i) := by
  rw [equalChecker,conjunction_test,List.all_eq_true]
  constructor
  · intro h i
    have hh := h _ (show bitEq (.bit (x i)) (.bit (y i)) ∈ equalChecks n x y by
      exact List.mem_ofFn.mpr ⟨i,rfl⟩)
    rw [bitEq_test] at hh
    simpa [BoolFormula.test] using hh
  · intro h p hp
    obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hp
    rw [bitEq_test]
    simp [BoolFormula.test,h i]

theorem equalChecker_nodes (n : ℕ) (x y : Fin n → σ) :
    (equalChecker n x y).nodes ≤ 10*n + 1 := by
  rw [equalChecker,conjunction_nodes]
  have hsum : ((equalChecks n x y).map BoolFormula.nodes).sum ≤ (equalChecks n x y).length * 9 := by
    have h := List.sum_le_sum (l := equalChecks n x y) (f := BoolFormula.nodes) (g := fun _ => 9) (by
      intro p hp
      obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hp
      simp [bitEq_nodes,BoolFormula.nodes])
    simpa using h
  simp only [equalChecks,List.length_ofFn] at hsum ⊢
  omega

def constantChecks (n : ℕ) (x : Fin n → σ) (target : Fin n → Bool) : List (BoolFormula σ) :=
  List.ofFn fun i => bitEq (.bit (x i)) (.lit (target i))

def constantChecker (n : ℕ) (x : Fin n → σ) (target : Fin n → Bool) : BoolFormula σ :=
  conjunction (constantChecks n x target)

theorem constantChecker_correct (n : ℕ) (x : Fin n → σ) (target : Fin n → Bool) (v : σ → Bool) :
    (constantChecker n x target).test v = true ↔ ∀ i, v (x i) = target i := by
  rw [constantChecker,conjunction_test,List.all_eq_true]
  constructor
  · intro h i
    have hh := h _ (show bitEq (.bit (x i)) (.lit (target i)) ∈ constantChecks n x target by
      exact List.mem_ofFn.mpr ⟨i,rfl⟩)
    rw [bitEq_test] at hh
    simpa [BoolFormula.test] using hh
  · intro h p hp
    obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hp
    rw [bitEq_test]
    simp [BoolFormula.test,h i]

theorem constantChecker_nodes (n : ℕ) (x : Fin n → σ) (target : Fin n → Bool) :
    (constantChecker n x target).nodes ≤ 10*n + 1 := by
  rw [constantChecker,conjunction_nodes]
  have hsum : ((constantChecks n x target).map BoolFormula.nodes).sum ≤ (constantChecks n x target).length * 9 := by
    have h := List.sum_le_sum (l := constantChecks n x target) (f := BoolFormula.nodes) (g := fun _ => 9) (by
      intro p hp
      obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hp
      simp [bitEq_nodes,BoolFormula.nodes])
    simpa using h
  simp only [constantChecks,List.length_ofFn] at hsum ⊢
  omega


end BooleanVectorControl

-- From Solutions.WiredStackControl

/-! Bit-level stack transition checker, wired to encoded old and new states
    and the bounded action plan. -/

namespace WiredStackControl

open ResultantVNP IndexedNormalizedAddresses IndexedFactorMachine IndexedPlan IndexedStateEncoding
  IndexedPlanControl IndexedSlotUpdate BooleanVerifierFormula IndexedTagControl BooleanVectorControl
  BoundedListEncoding

variable {σ : Type}

def totalWidth (m D N : ℕ) : ℕ := stateWidth m D N + (stateWidth m D N + planWidth m D)

def oldVar (m D N : ℕ) (i : Fin (stateWidth m D N)) : Fin (totalWidth m D N) :=
  Fin.castAdd (stateWidth m D N + planWidth m D) i

def nextVar (m D N : ℕ) (i : Fin (stateWidth m D N)) : Fin (totalWidth m D N) :=
  Fin.natAdd (stateWidth m D N) (Fin.castAdd (planWidth m D) i)

def planVar (m D N : ℕ) (i : Fin (planWidth m D)) : Fin (totalWidth m D N) :=
  Fin.natAdd (stateWidth m D N) (Fin.natAdd (stateWidth m D N) i)

def assignment (m D N : ℕ) (s t : {s : State // admissible m D N s})
    (p : {p : Plan // p.bounded m D}) : Fin (totalWidth m D N) → Bool :=
  Fin.append (stateWord m D N s) (Fin.append (stateWord m D N t) (planWord m D p))

def rawAssignment (m D N : ℕ) (old next : Fin (stateWidth m D N) → Bool)
    (plan : Fin (planWidth m D) → Bool) : Fin (totalWidth m D N) → Bool :=
  Fin.append old (Fin.append next plan)

theorem rawAssignment_old (m D N : ℕ) (old next : Fin (stateWidth m D N) → Bool)
    (plan : Fin (planWidth m D) → Bool) (i : Fin (stateWidth m D N)) :
    rawAssignment m D N old next plan (oldVar m D N i) = old i := by
  simp [rawAssignment,oldVar,Fin.append_left]

theorem rawAssignment_next (m D N : ℕ) (old next : Fin (stateWidth m D N) → Bool)
    (plan : Fin (planWidth m D) → Bool) (i : Fin (stateWidth m D N)) :
    rawAssignment m D N old next plan (nextVar m D N i) = next i := by
  simp [rawAssignment,nextVar,Fin.append_right,Fin.append_left]

theorem rawAssignment_plan (m D N : ℕ) (old next : Fin (stateWidth m D N) → Bool)
    (plan : Fin (planWidth m D) → Bool) (i : Fin (planWidth m D)) :
    rawAssignment m D N old next plan (planVar m D N i) = plan i := by
  simp [rawAssignment,planVar,Fin.append_right]

theorem assignment_old (m D N : ℕ) (s t : {s : State // admissible m D N s})
    (p : {p : Plan // p.bounded m D}) (i : Fin (stateWidth m D N)) :
    assignment m D N s t p (oldVar m D N i) = stateWord m D N s i := by
  simp [assignment,oldVar,Fin.append_left]

theorem assignment_next (m D N : ℕ) (s t : {s : State // admissible m D N s})
    (p : {p : Plan // p.bounded m D}) (i : Fin (stateWidth m D N)) :
    assignment m D N s t p (nextVar m D N i) = stateWord m D N t i := by
  simp [assignment,nextVar,Fin.append_right,Fin.append_left]

theorem assignment_plan (m D N : ℕ) (s t : {s : State // admissible m D N s})
    (p : {p : Plan // p.bounded m D}) (i : Fin (planWidth m D)) :
    assignment m D N s t p (planVar m D N i) = planWord m D p i := by
  simp [assignment,planVar,Fin.append_right]

def oldStack (m D N : ℕ) (i : ℕ) (j : Fin (tagWordLength m D+1)) : BoolFormula (Fin (totalWidth m D N)) :=
  if hi : i < N+1 then .bit (oldVar m D N (stackCoord m D N ⟨i,hi⟩ j)) else .lit false

theorem oldStack_test (m D N : ℕ) (s t : {s : State // admissible m D N s})
    (p : {p : Plan // p.bounded m D}) (i : ℕ) (j : Fin (tagWordLength m D+1)) :
    (oldStack m D N i j).test (assignment m D N s t p) =
      stackRead m D N (stateWord m D N s) i j := by
  by_cases hi : i < N+1 <;> simp [oldStack,stackRead,hi,BoolFormula.test,assignment_old]

theorem oldStack_test_raw (m D N : ℕ) (old next : Fin (stateWidth m D N) → Bool)
    (plan : Fin (planWidth m D) → Bool) (i : ℕ) (j : Fin (tagWordLength m D+1)) :
    (oldStack m D N i j).test (rawAssignment m D N old next plan) = stackRead m D N old i j := by
  by_cases hi : i < N+1 <;> simp [oldStack,stackRead,hi,BoolFormula.test,rawAssignment_old]

theorem oldStack_nodes (m D N : ℕ) (i : ℕ) (j : Fin (tagWordLength m D+1)) :
    (oldStack m D N i j).nodes = 1 := by
  by_cases h : i < N+1 <;> simp [oldStack,h,BoolFormula.nodes]

/-- The expected next-stack bit, expressed using the two push-presence
    controls and fixed offset copies from the old stack and plan. -/
def expected (m D N : ℕ) (i : Fin (N+1)) (j : Fin (tagWordLength m D+1)) :
    BoolFormula (Fin (totalWidth m D N)) :=
  let p₀ := BoolFormula.bit (planVar m D N (pushCoord m D 0 0))
  let p₁ := BoolFormula.bit (planVar m D N (pushCoord m D 1 0))
  let first := BoolFormula.bit (planVar m D N (pushCoord m D 0 j))
  let second := BoolFormula.bit (planVar m D N (pushCoord m D 1 j))
  let one := if i.val = 0 then first else oldStack m D N i.val j
  let two := if i.val = 0 then first else if i.val = 1 then second else oldStack m D N (i.val-1) j
  mux p₀ (mux p₁ two one) (oldStack m D N (i.val+1) j)

theorem expected_nodes (m D N : ℕ) (i : Fin (N+1)) (j : Fin (tagWordLength m D+1)) :
    (expected m D N i j).nodes = 15 := by
  by_cases h0 : i.val = 0 <;> by_cases h1 : i.val = 1 <;>
    simp [expected,h0,h1,mux_nodes,BoolFormula.nodes,oldStack_nodes]

def checks (m D N : ℕ) : List (BoolFormula (Fin (totalWidth m D N))) :=
  List.ofFn fun u : Fin ((N+1)*(tagWordLength m D+1)) =>
    let ij := finProdFinEquiv.symm u
    bitEq (.bit (nextVar m D N (stackCoord m D N ij.1 ij.2))) (expected m D N ij.1 ij.2)

def checker (m D N : ℕ) : BoolFormula (Fin (totalWidth m D N)) := conjunction (checks m D N)

/-- For a real machine step, the locally wired expected bit equals the
    corresponding bit of the encoded next stack. -/
theorem expected_step {σ : Type} (C : Circuit σ) (D N : ℕ)
    (s t : {s : State // admissible C.nodes.length D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest)
    (ha : a.bounded C.nodes.length D) (b : Bool) (bits : List Bool) (hb : s.val.bits = b :: bits)
    (hstep : step C s.val = some t.val)
    (i : Fin (N+1)) (j : Fin (tagWordLength C.nodes.length D+1)) :
    let p := boundedPlan C D ⟨a,ha⟩ b
    (expected C.nodes.length D N i j).test (assignment C.nodes.length D N s t p) =
      stateWord C.nodes.length D N t (stackCoord C.nodes.length D N i j) := by
  dsimp only
  let m := C.nodes.length
  let p := boundedPlan C D ⟨a,ha⟩ b
  change (expected m D N i j).test (assignment m D N s t p) =
    stateWord m D N t (stackCoord m D N i j)
  have hs : step C ⟨a :: rest,b :: bits,s.val.factors⟩ = some t.val := by
    have hstate : s.val = ⟨a :: rest,b :: bits,s.val.factors⟩ := by
      cases hs : s.val with
      | mk pending bs fs => simp_all
    rw [← hstate]
    exact hstep
  have hstack := step_stack_threeWay C D a ha rest b bits s.val.factors t.val hs
    (tagWordLength m D) (extendCode _ (tagWord m D)) i.val
  have hbit := congrFun hstack j
  rw [← stateWord_stackSlot m D N t i j] at hbit
  simp only [ite_apply] at hbit
  have hcontrols := planWord_pushControls m D p
  have h0 := hcontrols.1
  have h1 := hcontrols.2
  have hp0 := planWord_pushSlot m D p (0 : Fin 2) j
  have hp1 := planWord_pushSlot m D p (1 : Fin 2) j
  by_cases hi0 : i.val = 0 <;> by_cases hi1 : i.val = 1 <;>
    simp only [expected,mux_test,hi0,hi1,if_true,if_false,BoolFormula.test,assignment_plan,
      oldStack_test,h0,h1,hp0,hp1,stackRead_stateWord] <;>
    simpa [p,boundedPlan,hp,hi0,hi1,BoolFormula.test,assignment_plan,oldStack_test,
      stackRead_stateWord,planWord_pushSlot] using hbit.symm

theorem checker_iff (m D N : ℕ) (v : Fin (totalWidth m D N) → Bool) :
    (checker m D N).test v = true ↔ ∀ i : Fin (N+1), ∀ j : Fin (tagWordLength m D+1),
      v (nextVar m D N (stackCoord m D N i j)) = (expected m D N i j).test v := by
  rw [checker,conjunction_test,List.all_eq_true]
  constructor
  · intro h i j
    have hh := h _ (show bitEq (.bit (nextVar m D N (stackCoord m D N i j)))
        (expected m D N i j) ∈ checks m D N by
      apply List.mem_ofFn.mpr
      refine ⟨finProdFinEquiv (i,j),?_⟩
      simp [checks])
    rw [bitEq_test] at hh
    simpa [BoolFormula.test] using hh
  · intro h x hx
    obtain ⟨u,rfl⟩ := List.mem_ofFn.mp hx
    rw [bitEq_test]
    simpa [BoolFormula.test] using h (finProdFinEquiv.symm u).1 (finProdFinEquiv.symm u).2

/-- Every genuine decoder step satisfies the wired stack-transition checker. -/
theorem checker_accepts_step {σ : Type} (C : Circuit σ) (D N : ℕ)
    (s t : {s : State // admissible C.nodes.length D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest)
    (ha : a.bounded C.nodes.length D) (b : Bool) (bits : List Bool) (hb : s.val.bits = b :: bits)
    (hstep : step C s.val = some t.val) :
    let p := boundedPlan C D ⟨a,ha⟩ b
    (checker C.nodes.length D N).test (assignment C.nodes.length D N s t p) = true := by
  dsimp only
  apply (checker_iff _ _ _ _).mpr
  intro i j
  rw [assignment_next]
  exact (expected_step C D N s t a rest hp ha b bits hb hstep i j).symm

/-- The expected stack bit reads only the old state and the plan, never the
    proposed next state. -/
theorem expected_next_irrelevant (m D N : ℕ)
    (s t u : {s : State // admissible m D N s}) (p : {p : Plan // p.bounded m D})
    (i : Fin (N+1)) (j : Fin (tagWordLength m D+1)) :
    (expected m D N i j).test (assignment m D N s t p) =
      (expected m D N i j).test (assignment m D N s u p) := by
  by_cases h0 : i.val = 0 <;> by_cases h1 : i.val = 1 <;>
    simp [expected,h0,h1,mux_test,BoolFormula.test,assignment_plan,oldStack_test]

theorem expected_raw_next_irrelevant (m D N : ℕ)
    (old next₁ next₂ : Fin (stateWidth m D N) → Bool) (plan : Fin (planWidth m D) → Bool)
    (i : Fin (N+1)) (j : Fin (tagWordLength m D+1)) :
    (expected m D N i j).test (rawAssignment m D N old next₁ plan) =
      (expected m D N i j).test (rawAssignment m D N old next₂ plan) := by
  by_cases h0 : i.val = 0 <;> by_cases h1 : i.val = 1 <;>
    simp [expected,h0,h1,mux_test,BoolFormula.test,oldStack_test_raw,rawAssignment_plan]

/-- If the checker accepts a proposed next state under the actual plan, its
    stack equals the true next stack. -/
theorem checker_forces_stack {σ : Type} (C : Circuit σ) (D N : ℕ)
    (s t u : {s : State // admissible C.nodes.length D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest)
    (ha : a.bounded C.nodes.length D) (b : Bool) (bits : List Bool) (hb : s.val.bits = b :: bits)
    (hstep : step C s.val = some t.val)
    (hcheck : (checker C.nodes.length D N).test
      (assignment C.nodes.length D N s u (boundedPlan C D ⟨a,ha⟩ b)) = true) :
    u.val.pending = t.val.pending := by
  have hall := (checker_iff _ _ _ _).mp hcheck
  apply stackSlots_injective
  intro i j
  have hh := hall i j
  rw [assignment_next,expected_next_irrelevant _ _ _ s u t,expected_step C D N s t a rest hp ha b bits hb hstep] at hh
  exact hh

theorem checker_nodes (m D N : ℕ) :
    (checker m D N).nodes ≤ 38 * ((N+1)*(tagWordLength m D+1)) + 1 := by
  rw [checker,conjunction_nodes]
  have hsum : ((checks m D N).map BoolFormula.nodes).sum ≤ (checks m D N).length * 37 := by
    have h := List.sum_le_sum (l := checks m D N) (f := BoolFormula.nodes) (g := fun _ => 37) (by
      intro p hp
      obtain ⟨u,rfl⟩ := List.mem_ofFn.mp hp
      simp only [bitEq_nodes,BoolFormula.nodes,expected_nodes]
      omega)
    simpa using h
  simp only [checks,List.length_ofFn] at hsum ⊢
  omega


end WiredStackControl

