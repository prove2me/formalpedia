-- title:
--   The family $\mathcal Q$: normalized instances with a maximal chain, the shared-participant order, degrees and $J$
-- statement:
--   A member of the family $\mathcal Q$ on $n$ men and $n$ women is a normalized instance with a chosen maximal chain $\mu_0,\dots,\mu_R$. Its rotations are the $R$ steps of the chain. A person participates in a rotation if their partner changes at that step. The **shared-participant order** is defined by $\rho_i\preceq\rho_j$ if $i=j$ or there are indices $i=i_0<i_1<\dots<i_t=j$ such that $\rho_{i_{\ell-1}}$ and $\rho_{i_\ell}$ contain a common man for all $\ell$.
--
--   Each woman is labelled by the man matched to her in $\mu_0$. The **degree** of a person is the number of rotations containing them, the **rank** of an occurrence is the position of the rotation on that person's chain, and $d^m_v,d^w_v$ are the degrees of the man and woman with label $v$. For a rotation $\rho$, $\downarrow\rho$ and $\uparrow\rho$ are $\rho$ with its predecessors and with its successors. $J(P)$ is the number of downsets of the order induced on $P$.
--
--   The module also defines the matching reached by applying the rotations of a downset, and the relation between a member and a smaller member realizing a retained set $P$ on the same people.
--
--   **Formalization Note** The paper describes $\mathcal Q$ as a family of posets "each with its specified rotations and a chosen maximal chain". The potential reads degrees, which a bare poset does not determine, so a member is this data. Comparisons through women are not added to the order: it is generated by men only. Degrees and participation are stated on actual people, since a woman's label is defined anew in a smaller member.
-- source:
--   Ghorbani, Mnich, A 2.81^n upper bound on the number of stable matchings, arXiv:2611.06494 (held PDF sha256 9445f6a8…), §3, pp.10, 12–13; §4.1, p.13

import Mathlib
import Definitions.Def_StableCount_Rotation

namespace StableCount

open StableMatching

variable {n : ℕ}

/-- The two sexes (arXiv:2611.06494, held PDF sha256 9445f6a8…, §4.2, p.14: the index `s ∈ {m, w}`). -/
inductive Sex
  | man
  | woman
  deriving DecidableEq

/-- A member of the family `𝒬`: a normalized instance with a chosen maximal chain
`µ₀ = µ_M < ⋯ < µ_R = µ_W` (arXiv:2611.06494, held PDF sha256 9445f6a8…, §3, p.12; §4.1, p.13).

**Formalization Note** The paper describes `𝒬` as a family of posets "each with its specified
rotations and a chosen maximal chain". The potential `F_h` reads degrees, which a bare poset does
not determine, so the member is this data. A rotation of a member is a chain step `i : Fin R`, going
from `μ i.castSucc` to `μ i.succ`; Proposition 2.3 (i) makes rotations and steps one-to-one. -/
structure Member (n : ℕ) where
  I : Instance n
  R : ℕ
  μ : Fin (R + 1) → Matching n
  normalized : IsNormalized I
  chain : IsMaximalChain I μ

namespace Member

variable (Q : Member n)

/-- Person `p` of sex `s` participates in rotation `i`: their partner changes at that step
(arXiv:2611.06494, held PDF sha256 9445f6a8…, §3, p.10). -/
def moves : Sex → Fin Q.R → Fin n → Prop
  | .man, i, p => Q.μ i.castSucc p ≠ Q.μ i.succ p
  | .woman, i, p => (Q.μ i.castSucc).symm p ≠ (Q.μ i.succ).symm p

instance (s : Sex) (i : Fin Q.R) (p : Fin n) : Decidable (Q.moves s i p) := by
  cases s <;> unfold moves <;> infer_instance

/-- The person of sex `s` with label `v`: man `v`, or the woman `µ₀(v)`, who is labelled by her
partner in the initial matching of the chain (arXiv:2611.06494, held PDF sha256 9445f6a8…, §3, p.12;
§4.2, p.14). -/
def person : Sex → Fin n → Fin n
  | .man, v => v
  | .woman, v => Q.μ 0 v

/-- The rotations containing person `p`, listed by elimination along the chain: the person's rotation
chain (arXiv:2611.06494, held PDF sha256 9445f6a8…, §3, p.10, p.12). -/
def chainOf (s : Sex) (p : Fin n) : Finset (Fin Q.R) :=
  Finset.univ.filter fun i => Q.moves s i p

/-- The degree of person `p`: the number of rotations containing them (arXiv:2611.06494, held PDF
sha256 9445f6a8…, §3, p.12). -/
def deg (s : Sex) (p : Fin n) : ℕ := (Q.chainOf s p).card

/-- The number of rotations of `P` containing person `p`: their retained occurrences
(arXiv:2611.06494, held PDF sha256 9445f6a8…, Lemma 3.7, p.12). -/
def degOn (P : Finset (Fin Q.R)) (s : Sex) (p : Fin n) : ℕ := (P ∩ Q.chainOf s p).card

/-- `dˢ_v`, the degree of the person of sex `s` with label `v` (arXiv:2611.06494, held PDF sha256
9445f6a8…, §1.2, p.5; §4.2, p.14). -/
def dL (s : Sex) (v : Fin n) : ℕ := Q.deg s (Q.person s v)

/-- The rank of the occurrence `(p, i)`: the position of `i` on `p`'s rotation chain, starting from
`1` (arXiv:2611.06494, held PDF sha256 9445f6a8…, §3, p.12–13). -/
def rank (s : Sex) (p : Fin n) (i : Fin Q.R) : ℕ :=
  ((Q.chainOf s p).filter fun j => j ≤ i).card

/-- Rotations `i` and `j` contain a common man (arXiv:2611.06494, held PDF sha256 9445f6a8…, §3,
p.10). -/
def sharesMan (i j : Fin Q.R) : Prop := ∃ v, Q.moves .man i v ∧ Q.moves .man j v

/-- The shared-participant order `⪯`: `i ⪯ j` if `i = j` or there are indices `i = i₀ < i₁ < ⋯ < i_t
= j` such that consecutive rotations contain a common man (arXiv:2611.06494, held PDF sha256
9445f6a8…, §3, p.10). Women's comparisons are not added: the order is generated by men only. -/
def le (i j : Fin Q.R) : Prop :=
  Relation.ReflTransGen (fun a b => a < b ∧ Q.sharesMan a b) i j

open Classical in
/-- `↓ρ`: `ρ` and all rotations smaller than it (arXiv:2611.06494, held PDF sha256 9445f6a8…, §3,
p.10). -/
noncomputable def down (i : Fin Q.R) : Finset (Fin Q.R) := Finset.univ.filter fun j => Q.le j i

open Classical in
/-- `↑ρ`: `ρ` and all rotations larger than it (arXiv:2611.06494, held PDF sha256 9445f6a8…, §3,
p.10). -/
noncomputable def up (i : Fin Q.R) : Finset (Fin Q.R) := Finset.univ.filter fun j => Q.le i j

/-- `D ⊆ P` is a downset of the order `Q.le` induced on `P` (arXiv:2611.06494, held PDF sha256
9445f6a8…, §1.2, p.4; §3, p.10: "we retain the same comparisons between the remaining elements"). -/
def IsDownsetIn (P D : Finset (Fin Q.R)) : Prop :=
  D ⊆ P ∧ ∀ a ∈ D, ∀ b ∈ P, Q.le b a → b ∈ D

/-- `U` is an upset of `Q`: `ρ ∈ U` and `ρ ⪯ τ` imply `τ ∈ U` (arXiv:2611.06494, held PDF sha256
9445f6a8…, §3, p.10). -/
def IsUpset (U : Finset (Fin Q.R)) : Prop := ∀ a ∈ U, ∀ b, Q.le a b → b ∈ U

open Classical in
/-- `J(P)`: the number of downsets of the order induced on `P` (arXiv:2611.06494, held PDF sha256
9445f6a8…, §1.2, p.4). The empty set and `P` itself are counted, so `J(∅) = 1`. -/
noncomputable def Jon (P : Finset (Fin Q.R)) : ℕ :=
  (P.powerset.filter fun D => Q.IsDownsetIn P D).card

/-- `J(Q)`: the number of downsets of the rotation poset of `Q` (arXiv:2611.06494, held PDF sha256
9445f6a8…, §1.2, p.4). -/
noncomputable def J : ℕ := Q.Jon Finset.univ

/-- The permutation of the men made by rotation `i`: `µ_{i+1}(v) = µ_i(c v)` (arXiv:2611.06494, held
PDF sha256 9445f6a8…, §3, p.12). -/
def stepPerm (i : Fin Q.R) : Equiv.Perm (Fin n) := (Q.μ i.succ).trans (Q.μ i.castSucc).symm

/-- The matching reached by applying the rotations of `D`, in increasing order, to `µ₀`
(arXiv:2611.06494, held PDF sha256 9445f6a8…, Lemma 3.3, p.11; Lemma 3.6, p.12).

**Formalization Note** Applying a rotation means performing its exchange on the current partners. By
Lemma 3.3 a downset gives the same matching along any linear extension. -/
def matchingOf (D : Finset (Fin Q.R)) : Matching n :=
  (D.sort (· ≤ ·)).foldl (fun ν i => (Q.stepPerm i).trans ν) (Q.μ 0)

/-- `Q'` is a rotation poset of the retained set `P`, on the same people: an isomorphism from the
order induced on `P` onto the order of `Q'` under which each person's participation is unchanged, so
each person's rotation chain consists of their retained rotations (arXiv:2611.06494, held PDF sha256
9445f6a8…, Lemma 3.6, p.12).

**Formalization Note** The clause is on actual people, not on labels: a woman's label is defined anew
in the smaller member (p.14). A person's rotations are pairwise comparable, so the isomorphism
preserves each person's chain order, and ranks follow. -/
def IsRestriction (P : Finset (Fin Q.R)) (Q' : Member n) (e : {i // i ∈ P} ≃ Fin Q'.R) : Prop :=
  (∀ i j : {i // i ∈ P}, Q.le i j ↔ Q'.le (e i) (e j)) ∧
    ∀ (s : Sex) (p : Fin n) (i : {i // i ∈ P}), Q'.moves s (e i) p ↔ Q.moves s i p

end Member

end StableCount


