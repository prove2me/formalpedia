variable (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

private theorem exists_cubicInductionForm_of_dilation
    (ψ ψ₀ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ) (hψ₀ : IsGlobalAddChar ℚ ψ₀) (a : ℚ) (ha : a ≠ 0)
    (hψ : ∀ x, ψ x = ψ₀ (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * x))
    (hlev₀ : ∀ v : HeightOneSpectrum (𝓞 ℚ), LanglandsTunnell.TateLocal.addCharLevel (psiLoc ψ₀ v) = 0)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (hlev : ∀ v : HeightOneSpectrum (𝓞 ℚ), ¬ IsBadPlace K μ v →
      LanglandsTunnell.TateLocal.addCharLevel (psiLoc ψ v) = 0)
    (D : Set (AdelicGL2 (𝓞 ℚ) ℚ)) (U : Ideal (𝓞 ℚ) → Subgroup (AdelicGL2 (𝓞 ℚ) ℚ))
    (gen : HeightOneSpectrum (𝓞 ℚ) → AdelicGL2 (𝓞 ℚ) ℚ)
    (F₀ : CubicInductionForm K (productionPinsOf ℚ D U gen (AdelicBox.adelicBox ℚ)) ψ₀ μ)
    (h₀ : (F₀.form ≠ 0 ∧ ∀ v, ¬ IsRamifiedIn K v →
        LanglandsTunnell.TateLocal.addCharLevel (psiLoc ψ₀ v) = 0 →
          F₀.whittakerLoc v 1 = 1 ∧ HasSphericalTorusValuesAt (inducedCoeff K μ) v (F₀.whittakerLoc v)) ∧
      Continuous F₀.form ∧ Continuous F₀.whittaker ∧ Continuous F₀.dualWhittaker ∧
      IsGaugeMajorised3 ℚ F₀.whittaker ∧ IsGaugeMajorised3 ℚ F₀.dualWhittaker) :
    ∃ F : CubicInductionForm K (productionPinsOf ℚ D U gen (AdelicBox.adelicBox ℚ)) ψ μ,
      (F.form ≠ 0 ∧ ∀ v, ¬ IsRamifiedIn K v →
        LanglandsTunnell.TateLocal.addCharLevel (psiLoc ψ v) = 0 →
          F.whittakerLoc v 1 = 1 ∧ HasSphericalTorusValuesAt (inducedCoeff K μ) v (F.whittakerLoc v)) ∧
      Continuous F.form ∧ Continuous F.whittaker ∧ Continuous F.dualWhittaker ∧
      IsGaugeMajorised3 ℚ F.whittaker ∧ IsGaugeMajorised3 ℚ F.dualWhittaker := by
  obtain ⟨⟨hne, hnorm⟩, hcf, hcw, hcd, hgw, hgd⟩ := h₀

  have hpi : IsPrincipalInvariantAddChar ℚ ψ₀ := hψ₀.principalInvariant
  have hpi' : IsPrincipalInvariantAddChar ℚ ψ₀⁻¹ := isPrincipalInvariantAddChar_inv hpi
  have hψinv : ∀ x, ψ⁻¹ x = ψ₀⁻¹ (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * x) := inv_apply_of_forall_apply_eq hψ
  have hunit : ∀ v, LanglandsTunnell.TateLocal.addCharLevel (psiLoc ψ v) = 0 →
      Valued.v (algebraMap ℚ (v.adicCompletion ℚ) a) = 1 := fun v hv =>
    valued_algebraMap_eq_one_of_addCharLevel_eq_zero hψ₀ ha hψ v (hlev₀ v) hv
  have ha' : ∀ v : HeightOneSpectrum (𝓞 ℚ), algebraMap ℚ (v.adicCompletion ℚ) a ≠ 0 := fun v =>
    (map_ne_zero _).2 ha

  have ha2 : a ^ 2 ≠ 0 := pow_ne_zero 2 ha
  obtain ⟨d, hd⟩ : ∃ d : GL (Fin 2) ℚ, (d : Matrix (Fin 2) (Fin 2) ℚ) = Matrix.diagonal ![a ^ 2, a] :=
    ⟨Matrix.GeneralLinearGroup.mkOfDetNeZero (Matrix.diagonal ![a ^ 2, a])
      (by simp [Matrix.det_diagonal, Fin.prod_univ_two, ha]), rfl⟩
  have hdN : d ∈ unipotentNormalizer ℚ := mem_normalizer_of_coe_eq_diagonal ha2 ha d hd
  obtain ⟨t, ht, htd⟩ : ∃ t : GL (Fin 3) ℚ,
      (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1] ∧ t = iotaGL d :=
    ⟨iotaGL d, coe_iotaGL_of_coe_eq_diagonal ℚ d hd, rfl⟩
  obtain ⟨T, hT⟩ : ∃ T : AdelicGL 3 (𝓞 ℚ) ℚ, T = globalPointsGL 3 (𝓞 ℚ) ℚ t := ⟨_, rfl⟩
  have hTι : T = iota (𝓞 ℚ) ℚ (globalPoints (𝓞 ℚ) ℚ d) := by
    rw [hT, htd]
    exact globalPointsGL_iotaGL (𝓞 ℚ) ℚ d

  have hTv : ∀ v : HeightOneSpectrum (𝓞 ℚ),
      componentAt3 (𝓞 ℚ) ℚ v T = Matrix.GeneralLinearGroup.map (algebraMap ℚ (v.adicCompletion ℚ)) t := fun v => by
    rw [hT]
    exact componentAt3_globalPointsGL v t
  have hTw : ∀ w : InfinitePlace ℚ,
      archPlaceComponent3 ℚ w T = Matrix.GeneralLinearGroup.map (algebraMap ℚ w.Completion) t := fun w => by
    rw [hT]
    exact archPlaceComponent3_globalPointsGL w t
  have hTvd : ∀ v : HeightOneSpectrum (𝓞 ℚ),
      ((componentAt3 (𝓞 ℚ) ℚ v T : LocalGL3 v) : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) =
        Matrix.diagonal (algebraMap ℚ (v.adicCompletion ℚ) ∘ ![a ^ 2, a, 1]) := fun v => by
    rw [hTv]
    exact coe_map_eq_diagonal _ ht

  have hTn : ∀ x y z : AdeleRing (𝓞 ℚ) ℚ, T * upperUnipotent3 x y z =
      upperUnipotent3 (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * x) (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * y)
        (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * z)) * T := fun x y z => by
    rw [hT]
    exact map_mul_upperUnipotent3 _ t ht x y z
