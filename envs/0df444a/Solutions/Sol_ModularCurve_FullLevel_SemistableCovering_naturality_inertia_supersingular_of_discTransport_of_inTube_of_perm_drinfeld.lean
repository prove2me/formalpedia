theorem inv_hres (hA : ∀ x : L, SemilinearAut.baseAut g x ∈ A ↔ x ∈ A)
    (hres : ∀ a : A, IsLocalRing.residue A ⟨SemilinearAut.baseAut g a, (hA a).mpr a.2⟩ = IsLocalRing.residue A a) :
    ∀ a : A, IsLocalRing.residue A ⟨SemilinearAut.baseAut g⁻¹ a, (inv_hA g hA a).mpr a.2⟩ = IsLocalRing.residue A a := by
  intro a
  have key := hres ⟨SemilinearAut.baseAut g⁻¹ a, (inv_hA g hA a).mpr a.2⟩
  rw [← key]
  congr 1
  apply Subtype.ext
  show SemilinearAut.baseAut g (SemilinearAut.baseAut g⁻¹ a) = (a : L)
