-- title:
--   Corollary 10: determinant-one charge blocks
-- statement:
--   Let n≥1 and let W be an invariant n-qubit unitary. If the restriction W_m to every full physical Hamming-weight sector satisfies det(W_m)=1, then
--
--   $$W\in G_2.$$
--
--   Here G_2 is generated by finite exchange and single-site Z evolutions. The condition includes both one-dimensional end sectors, rather than just the total determinant.
-- source:
--   Restrictions on realizable unitary operations imposed by symmetry and locality, arXiv:2003.05524v3, PDF p. 24, Corollary 10: determinant-one blocks need only XX+YY and Z

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P14

noncomputable section

namespace QAlgorithms.Papers.Independent.Extend50.P14

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius

open MeasureTheory

-- Exact accepted aliases and physical operators, without local redeclarations.

open QAlgorithms.Papers.Independent.Information100.P60 (Mat)

open QAlgorithms.Papers.Independent.Advance50.P49 (onWire multiSwap)

attribute [local instance 100] LieRing.ofAssociativeRing

/-- PDF p.24, Corollary 10: determinant one in every physical block,
including both one-dimensional end sectors. -/
theorem determinant_one_generation (n : ℕ) (hn : 1 ≤ n) (W : QMat n)
    (hW : U1Unitary W) (hDet : ∀ m : Fin (n+1), chargeSectorDet W m = 1) :
    W ∈ xyZGroup n := by sorry

end QAlgorithms.Papers.Independent.Extend50.P14

end
