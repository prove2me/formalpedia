set_option autoImplicit true
@[expose] public section
public section
variable {X : Type*} [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
  [VectorLattice X]
open VectorSublattice
variable (Y : VectorSublattice X)

theorem VectorSublattice.generated_submodule_eq_infClosure_supClosure (M : Submodule ℝ X) :
    (generated (M : Set X) : Set X) = infClosure (supClosure (M : Set X)) := by sorry
