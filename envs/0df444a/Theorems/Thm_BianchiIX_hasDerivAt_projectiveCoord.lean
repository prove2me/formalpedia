open BianchiIX
noncomputable section

theorem BianchiIX.hasDerivAt_projectiveCoord
    {p z : ℝ → ℝ} {p' z' t : ℝ}
    (hp : HasDerivAt p p' t) (hz : HasDerivAt z z' t) (hA : 1 + p t ≠ 0) :
    HasDerivAt (fun x => projectiveCoord (p x) (z x))
      (Real.sqrt 3 * (z' * (1 + p t) - z t * p') / (1 + p t) ^ 2) t := by sorry
