-- title:
--   Principal\'s payoff $\sum_i(p_i(t)t_i-q_i(t)c_i)$
-- statement:
--   Inspecting agent $i$ costs the principal $c_i>0$. In scenario $t\in\mathcal T$ the mechanism $(p,q)$ earns the principal the **payoff**
--
--   $$
--   \sum_{i\in\mathcal I}\bigl(p_i(t)\,t_i-q_i(t)\,c_i\bigr),
--   $$
--
--   the expected value generated by the winner minus the expected inspection cost. It is the integrand of the objective of (MDP).
-- source:
--   Bayrak, Koçyiğit, Kuhn, Pınar, Distributionally Robust Optimal Allocation with Costly Verification, arXiv:2211.15122v3, §2, p.7, objective of (MDP)

import Mathlib

namespace DRAllocCV

/-- The **principal's payoff** of the mechanism `(p, q)` in scenario `t`
(Bayrak, Koçyiğit, Kuhn, Pınar, *Distributionally Robust Optimal Allocation with Costly Verification*, arXiv:2211.15122v3, §2, p.7, objective of (MDP)):
`∑_{i ∈ ℐ} (pᵢ(t) tᵢ − qᵢ(t) cᵢ)`, where `cᵢ > 0` is the cost of inspecting agent `i`. -/
def payoff {ι : Type*} [Fintype ι] (c : ι → ℝ) (p q : ι → (ι → ℝ) → ℝ) (t : ι → ℝ) : ℝ :=
  ∑ i, (p i t * t i - q i t * c i)

end DRAllocCV


