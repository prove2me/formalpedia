section Pointwise
variable {h Q J x : ℝ} {F b A : ℝ → ℝ}

theorem contDiffAt_deriv_succ' {g : ℝ → ℝ} {k : ℕ} (h : ContDiffAt ℝ ((k + 1 : ℕ)) g x) :
    ContDiffAt ℝ k (deriv g) x := by
  obtain ⟨U, hU, hGU⟩ := h.contDiffOn le_rfl (by simp)
  obtain ⟨V, hVU, hVo, hV0⟩ := mem_nhds_iff.1 hU
  have := (hGU.mono hVU).deriv_of_isOpen hVo (m := k) (by push_cast; exact le_rfl)
  exact this.contDiffAt (hVo.mem_nhds hV0)

theorem hd1' {g : ℝ → ℝ} (hc : ContDiffAt ℝ ∞ g x) : HasDerivAt g (deriv g x) x :=
  (hc.differentiableAt (by simp)).hasDerivAt
theorem hd2' {g : ℝ → ℝ} (hc : ContDiffAt ℝ ∞ g x) :
    HasDerivAt (deriv g) (deriv (deriv g) x) x := by
  have h2 : ContDiffAt ℝ ((1 + 1 : ℕ)) g x := hc.of_le (WithTop.coe_le_coe.mpr le_top)
  exact ((contDiffAt_deriv_succ' h2).differentiableAt (by simp)).hasDerivAt

/-- 3B, actual `Z′`. -/
theorem zf_deriv (hx : x ≠ 0) (hF : F x ≠ 0) (hb : b x ≠ 0) (hu : 1 - h * x ≠ 0)
    (cF : ContDiffAt ℝ ∞ F x) (hPF : realPF h Q J F b A x = 0) (hPC : realPC h Q J F b A x = 0) :
    deriv (Zf h F) x = zrhsE h Q J x (F x) (b x) (Vf A x) (Wf b A x) := by
  have hu' : HasDerivAt (fun y => 1 - h * y) (-(h * 1)) x :=
    ((hasDerivAt_id' x).const_mul h).const_sub 1
  have hN : HasDerivAt (fun y => (1 - h * y) * deriv F y)
      (-(h * 1) * deriv F x + (1 - h * x) * deriv (deriv F) x) x := hu'.mul (hd2' cF)
  have hD : HasDerivAt (Zf h F)
      (((-(h * 1) * deriv F x + (1 - h * x) * deriv (deriv F) x) * F x
        - (1 - h * x) * deriv F x * deriv F x) / F x ^ 2) x := hN.div (hd1' cF) hF
  have key := zprime_id x h Q J (F x) (deriv F x) (deriv (deriv F) x) (b x) (deriv b x)
    (deriv (deriv b) x) (A x) (deriv A x) (deriv (deriv A) x) hx hF hb hu hPF hPC
  rw [hD.deriv]; unfold Vf Wf; rw [← key]; ring

/-- 3B, `F′ = F Z / u`. -/
theorem f_deriv (hF : F x ≠ 0) (hu : 1 - h * x ≠ 0) : deriv F x = F x * Zf h F x / (1 - h * x) := by
  unfold Zf; field_simp

end Pointwise

/-- Composite extension: a function of `x` and eight extended state germs that is `Cᵏ` at `0` whenever
the inputs are, with the given values. Unused slots are padded with constants. -/
theorem ExtV.comp8 {k : ℕ} {g₁ g₂ g₃ g₄ g₅ g₆ g₇ g₈ : ℝ → ℝ} {L₁ L₂ L₃ L₄ L₅ L₆ L₇ L₈ : ℝ}
    (Φ : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ)
    (h₁ : ExtV k g₁ L₁) (h₂ : ExtV k g₂ L₂) (h₃ : ExtV k g₃ L₃) (h₄ : ExtV k g₄ L₄)
    (h₅ : ExtV k g₅ L₅) (h₆ : ExtV k g₆ L₆) (h₇ : ExtV k g₇ L₇) (h₈ : ExtV k g₈ L₈)
    (hΦ : ∀ G₁ G₂ G₃ G₄ G₅ G₆ G₇ G₈ : ℝ → ℝ, ContDiffAt ℝ k G₁ 0 → ContDiffAt ℝ k G₂ 0 →
      ContDiffAt ℝ k G₃ 0 → ContDiffAt ℝ k G₄ 0 → ContDiffAt ℝ k G₅ 0 → ContDiffAt ℝ k G₆ 0 →
      ContDiffAt ℝ k G₇ 0 → ContDiffAt ℝ k G₈ 0 → G₁ 0 = L₁ → G₂ 0 = L₂ → G₃ 0 = L₃ →
      G₄ 0 = L₄ → G₅ 0 = L₅ → G₆ 0 = L₆ → G₇ 0 = L₇ → G₈ 0 = L₈ →
      ContDiffAt ℝ k (fun x => Φ x (G₁ x) (G₂ x) (G₃ x) (G₄ x) (G₅ x) (G₆ x) (G₇ x) (G₈ x)) 0) :
    ExtV k (fun x => Φ x (g₁ x) (g₂ x) (g₃ x) (g₄ x) (g₅ x) (g₆ x) (g₇ x) (g₈ x))
      (Φ 0 L₁ L₂ L₃ L₄ L₅ L₆ L₇ L₈) := by
  obtain ⟨G₁, c₁, e₁, v₁⟩ := h₁; obtain ⟨G₂, c₂, e₂, v₂⟩ := h₂; obtain ⟨G₃, c₃, e₃, v₃⟩ := h₃
  obtain ⟨G₄, c₄, e₄, v₄⟩ := h₄; obtain ⟨G₅, c₅, e₅, v₅⟩ := h₅; obtain ⟨G₆, c₆, e₆, v₆⟩ := h₆
  obtain ⟨G₇, c₇, e₇, v₇⟩ := h₇; obtain ⟨G₈, c₈, e₈, v₈⟩ := h₈
  refine ⟨_, hΦ G₁ G₂ G₃ G₄ G₅ G₆ G₇ G₈ c₁ c₂ c₃ c₄ c₅ c₆ c₇ c₈ v₁ v₂ v₃ v₄ v₅ v₆ v₇ v₈, ?_, ?_⟩
  · filter_upwards [e₁, e₂, e₃, e₄, e₅, e₆, e₇, e₈] with x a₁ a₂ a₃ a₄ a₅ a₆ a₇ a₈
    simp only [a₁, a₂, a₃, a₄, a₅, a₆, a₇, a₈]
  · simp only [v₁, v₂, v₃, v₄, v₅, v₆, v₇, v₈]

theorem PS.pow {g : ℝ → ℝ} (hg : PS g) (n : ℕ) : PS (fun x => g x ^ n) :=
  hg.mono fun _ h => h.pow n

theorem extV_deriv {k : ℕ} {g : ℝ → ℝ} {L L' : ℝ} (hg : PS g) (h : ExtV (k + 1) g L)
