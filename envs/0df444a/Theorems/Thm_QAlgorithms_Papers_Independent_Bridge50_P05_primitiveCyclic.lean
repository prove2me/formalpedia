attribute [local instance] Classical.propDecidable Classical.decEq

variable {d : ℕ} [NeZero d]

/-- Section 2, PDF p.7: cyclic degeneracy, primitive-generator order, and the
prime-dimension specialization with the necessary nonzero-generator guard. -/
theorem primitiveCyclic {d : ℕ} [NeZero d] (z : WeylLabel d) :
    Degenerate (AddSubgroup.zmultiples z : Set (WeylLabel d)) ∧
    (Nat.gcd (Nat.gcd z.1.val z.2.val) d = 1 →
      (AddSubgroup.zmultiples z : Set (WeylLabel d)).ncard = d) ∧
    (Nat.Prime d → z ≠ 0 → (AddSubgroup.zmultiples z : Set (WeylLabel d)).ncard = d) := by sorry

end QAlgorithms.Papers.Independent.Bridge50.P05

end
