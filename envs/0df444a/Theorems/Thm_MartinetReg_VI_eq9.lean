-- title:
--   §2.3, (9) — lim inf (Tx, x − xⁿ) ≥ 0 for every x ∈ C
-- statement:
--   Let $H$ be a real Hilbert space, $C\subseteq H$ convex, closed and bounded, $T:H\to H'$ monotone and hemicontinuous on $C$, and let $(x^n)$ be a sequence generated by the regularization algorithm (2) from $x^0\in C$. Then for every $y\in C$
--   $$
--   \liminf_{n\to\infty}\,(Ty,\, y-x^{n})\ge 0 .
--   $$
--
--   Here $T$ is evaluated at the fixed point $y$, so $n\mapsto (Ty, y-x^n)$ is a weakly continuous affine function of $x^n$; together with Minty's characterization (5) this yields Théorème 1.
--
--   **Formalization Note.** The lim inf is stated in $\varepsilon$-form: for every $\varepsilon>0$, eventually $(Ty, y-x^{n})\ge-\varepsilon$ (no `Filter.liminf`). The paper names the arbitrary point of $C$ by $x$; Lean names it $y$ and the sequence $x$.
-- source:
--   Martinet, Régularisation d'inéquations variationnelles par approximations successives, R.I.R.O. 4(R-3) (1970), p. 156, §2.3, proof of Lemme 2, (9)

import Mathlib
import Definitions.Def_MartinetReg_VI_Setting

namespace MartinetReg.VI

open Filter Topology

/-- §2.3, (9), p. 156: `lim inf_{n→∞} (Ty, y − xⁿ) ≥ 0` for every `y ∈ C`,
stated in ε-form. -/
theorem eq9 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : H → StrongDual ℝ H) (C : Set H) (hS : Standing T C)
    (x : ℕ → H) (hx : IsRegSeq T C x) :
    ∀ y ∈ C, ∀ ε : ℝ, 0 < ε → ∀ᶠ n in atTop, -ε ≤ T y (y - x n) := by sorry

end MartinetReg.VI
