    (∑ n ∈ Finset.range 40, (c n:ℂ)*((y:ℂ)-Complex.I*x)^n)-
      (realValue x y:ℂ)=Complex.I*((x*CertifiedLocalPolynomial.bivariatePowerValue 9 18 a
        (4*x^2) ((2)*(y-(19/10)))):ℂ) := by
  norm_num [c,TaoFivePrimes_RH119RoundedCoefficients12,Finset.sum_range_succ,
    CertifiedLocalPolynomial.bivariatePowerValue,
    a,entry,powerMatrix,Fin.sum_univ_succ,realValue]
