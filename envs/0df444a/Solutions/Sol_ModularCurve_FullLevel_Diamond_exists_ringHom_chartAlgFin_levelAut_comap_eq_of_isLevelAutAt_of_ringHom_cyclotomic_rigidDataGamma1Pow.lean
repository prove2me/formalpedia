    (hjK : (coeffEmb ↥k₀ jq) ∈ K)
    (hjC : (⟨_, hjK⟩ : ↥K) ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j)

    (L₁ : Type) [Field L₁] [CharZero L₁] [IsCyclotomicExtension {q * ℓg} ℚ L₁]
