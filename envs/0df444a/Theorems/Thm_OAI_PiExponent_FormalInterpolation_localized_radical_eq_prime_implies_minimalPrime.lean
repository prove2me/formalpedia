-- title:
--   Localized radical equality implies minimality over the generated ideal
-- statement:
--   Equality of the localized radical and localized prime implies that P is minimal over the ideal generated by g. This removes the localization-to-minimality step from the parent; localization prime correspondence gives an independent proof route.

import Definitions.Def_OAI_PiExponent_LogarithmicNormalBases
import Mathlib.RingTheory.Ideal.Height

open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.localized_radical_eq_prime_implies_minimalPrime
    {m n : Nat}
    (g : Fin n → MvPolynomial (Fin (m + 1)) Complex)
    (P : Ideal (MvPolynomial (Fin (m + 1)) Complex)) [P.IsPrime]
    (hrad : Ideal.radical
      ((Ideal.span (Set.range g)).map
        (algebraMap (MvPolynomial (Fin (m + 1)) Complex)
          (Localization.AtPrime P))) =
      P.map (algebraMap (MvPolynomial (Fin (m + 1)) Complex)
        (Localization.AtPrime P))) :
    (Ideal.span (Set.range g)).IsMinimalPrime P := by sorry
