    dsimp [padeWritable]
    omega
  have hdisj := (decoderQueue0_pade_separated t).gcd_output_disjoint (decoderRow_low t 8) (by have h := decoderCapacity_pos t; omega) ht hrange
  have hReady : KeyReady b E t N e m2 := by
