  have hgf : ρ'.1.comp (f.comp ((x σ).bar n hn)) = D.ρn n := by
    rw [← RingHom.comp_assoc]; exact Gpt.rho_comp_bar D (x σ) σ n hn
  refine (Defm.bc_congr hbar (Gpt.rho_comp_bar D _ ρ' n hn') hgf (D.T n)).trans ?_
