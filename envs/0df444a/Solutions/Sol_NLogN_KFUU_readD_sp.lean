theorem bnd_μZ (μ : ℕ → ℕ) (d B : ℕ) (hB : ∀ j < d, zsz ((μ j : ℕ) : ℤ) ≤ B) : Bnd B (μZ μ d) := by
  intro x hx; simp only [μZ, List.mem_map, List.mem_range] at hx
  obtain ⟨j, hj, rfl⟩ := hx; exact hB j hj

theorem bnd_bitsZ (d : ℕ) (bL : ℕ → Bool) {B : ℕ} (hB : 1 ≤ B) : Bnd B (KFM.bitsZ d bL) := by
  intro x hx; simp only [KFM.bitsZ, List.mem_map, List.mem_range] at hx
  obtain ⟨j, hj, rfl⟩ := hx
  split_ifs
  · rw [zsz_one]; exact hB
  · rw [zsz_zero]; omega

end NLogN.KFUU

