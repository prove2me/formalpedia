open Complex Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.Res IntMul.HvdH.P47

/-- **Lemma 19 with the segmented `B̃₀` at the fitted parameters.** -/
theorem lemma19_seg_fit (p d s t α lam : ℕ) [NeZero s] [NeZero t] (hst : s < t)
    (hcop : Nat.Coprime s t) (hα : 2 ≤ α) (hαp : α ^ 2 ≤ p) (hx3 : 3 * s ≤ α ^ 2 * (t - s))
    (hd : 2 ≤ d) (h6d : 6 * d ^ 2 ≤ s) (h48 : 48 ≤ α ^ 2) (hpα : p < 48 * d * (α + 1) ^ 2)
    (hθ : 3 * d ^ 2 * (t - s) ≤ s) (h48d : 48 * d * α ^ 2 ≤ p) (hp : 100 ≤ p)
    (hl1 : 1 ≤ lam) (hlF : lam ≤ lamF d) :
    ∃ (A : (ZMod s → ℂ) →L[ℂ] (ZMod t → ℂ)) (B₀ : (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ)),
      ‖A‖ ≤ 1 ∧ ‖B₀‖ ≤ 1 / 2 ∧
      (∀ u, IntMul.OpenAI.RH.permS s t ((s : ℂ)⁻¹ • ZMod.dft u) =
        (2 : ℂ) ^ (2 * α ^ 2) • B₀ (IntMul.OpenAI.RH.permT s t ((t : ℂ)⁻¹ • ZMod.dft (A u)))) ∧
      (∀ U : ℕ → ℤ × ℤ, (∀ i, ‖toC (U i)‖ ≤ 2 ^ p) → ∀ k : ZMod t,
        ‖toC (Sapprox p s t α U k.val) - 2 ^ p * A (fun j => toC (U j.val) / 2 ^ p) k‖
          ≤ 6 * sWidth p α + 4) ∧
      (∀ W : ℕ → ℤ × ℤ, (∀ i, ‖toC (W i)‖ ≤ 2 ^ p) → ∀ l : ZMod s,
        ‖toC (B0seg p (segPF p d s) (p / 7) lam (wF d) s t α W l.val) -
          2 ^ p * B₀ (fun k => toC (W k.val) / 2 ^ p) l‖ ≤ 9) ∧
      B0seg p (segPF p d s) (p / 7) lam (wF d) s t α (fun _ => (0, 0)) = fun _ => (0, 0) := by
  have hs : 0 < s := Nat.pos_of_ne_zero (NeZero.ne s)
  obtain ⟨hk1, hk2⟩ := kF_sq d (by omega)
  have hws : wF d ≤ s := by
    unfold wF
    have : kF d ≤ d + 1 := by nlinarith
    nlinarith
  have hDle := fit_ddle p d s t α lam hst hcop hα hαp hx3 hd h6d h48 hpα hθ h48d hp hl1 hlF
  obtain ⟨hP, hE, hE3⟩ := fit_PE p d s t α lam hst hcop hα hαp hx3 hd h6d h48 hpα hθ h48d hp hl1 hlF hDle
  obtain ⟨A, B₀, hA, hB, hid, hS, hBa⟩ := lemma19_seg p (segPF p d s) (p / 7) lam (wF d) s t α
    hst hcop hα hαp hx3 hl1 hws hDle (by unfold segPF; omega) hP hE
  have hZ := B0seg_zero p (segPF p d s) (p / 7) lam (wF d) s t α hs hst hα hx3 hl1 hws hDle hP
  exact ⟨A, B₀, hA, hB, hid, hS, fun W hW l => (hBa W hW l).trans (by linarith), hZ⟩

end J6Seg

end

