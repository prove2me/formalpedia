section mem
variable {α β : Type*} [Inhabited α] [Inhabited β]

theorem mem_slabPass {n n' post pre : ℕ} (hnp : 0 < n * post) {src : ℕ → Option ℕ}
    {h : ℕ → α → β} {L : List α} (hL : L.length = pre * (n * post)) {y : β}
    (hy : y ∈ slabPass n n' post src h L) : y = default ∨ ∃ l, ∃ x ∈ L, y = h l x := by
  unfold slabPass at hy
  rw [(J6Seg.chunk_blocks (n * post) pre hnp L hL).1] at hy
  simp only [List.mem_flatMap, List.mem_map, List.mem_range] at hy
  obtain ⟨B, ⟨i, hi, rfl⟩, l, hl, hyB⟩ := hy
  unfold slabOf at hyB
  cases hs : src l with
  | none => rw [hs] at hyB; left; exact List.eq_of_mem_replicate hyB
  | some k =>
    rw [hs] at hyB
    obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hyB
    right
    exact ⟨l, x, List.mem_of_mem_drop (List.mem_of_mem_take (List.mem_of_mem_drop
      (List.mem_of_mem_take hx))), rfl⟩

theorem length_slabPass {n n' post pre : ℕ} (hnp : 0 < n * post) {src : ℕ → Option ℕ}
    (hs : MonoSrc n n' src) (h : ℕ → α → β) {L : List α} (hL : L.length = pre * (n * post)) :
    (slabPass n n' post src h L).length = pre * (n' * post) := by
  unfold slabPass
  rw [(J6Seg.chunk_blocks (n * post) pre hnp L hL).1, List.flatMap_map]
  have hb : ∀ i ∈ List.range pre, ((List.range n').flatMap fun l =>
      slabOf ((L.drop (i * (n * post))).take (n * post)) post (src l) (h l)).length = n' * post := by
    intro i hi
    rw [List.mem_range] at hi
    have hBl : ((L.drop (i * (n * post))).take (n * post)).length = n * post := by
      simp only [List.length_take, List.length_drop, hL]
      have : (i + 1) * (n * post) ≤ pre * (n * post) := Nat.mul_le_mul_right _ (by omega)
      rw [Nat.add_mul, one_mul] at this
      omega
    rw [List.length_flatMap]
    have : ∀ l ∈ List.range n', (slabOf ((L.drop (i * (n * post))).take (n * post)) post (src l)
        (h l)).length = post := by
      intro l hl
      rw [List.mem_range] at hl
      unfold slabOf
      cases hsl : src l with
      | none => simp
      | some k =>
        have hk := hs.1 l hl k hsl
        have : (k + 1) * post ≤ n * post := Nat.mul_le_mul_right _ hk
        rw [Nat.add_mul, one_mul] at this
        simp only [List.length_map, List.length_take, List.length_drop, hBl]
        omega
    rw [List.map_congr_left this]
    simp [List.sum_replicate]
  rw [List.length_flatMap, List.map_congr_left hb]
  simp [List.sum_replicate]

end mem

