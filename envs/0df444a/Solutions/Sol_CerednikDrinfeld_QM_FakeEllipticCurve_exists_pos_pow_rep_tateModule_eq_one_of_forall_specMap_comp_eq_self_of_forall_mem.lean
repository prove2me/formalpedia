def push (P : SchemeHomOver t' f') : SchemeHomOver t f :=
  ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2, ht]⟩

@[scoped simp] theorem push_coe (P : SchemeHomOver t' f') : (push φ g hg t' t ht P).1 = P.1 ≫ g := rfl

