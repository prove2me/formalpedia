section OrthogonalDefinitions

/-- Concrete REAL indefinite orthogonal matrix algebra, Definition 2.35 and pp. 26–28.
The signature has p positive and q negative diagonal entries. -/
abbrev OrthogonalReal (p q : ℕ) := LieAlgebra.Orthogonal.so' (Fin p) (Fin q) ℝ

/-- The spin factor R x R^n, Example 2.35, pp. 15–16. -/
abbrev SpinSpace (n : ℕ) := ℝ × (Fin n → ℝ)

/-- The actual spin-factor Jordan product, Example 2.35, p. 15. -/
def spinProduct {n : ℕ} (x y : SpinSpace n) : SpinSpace n :=
  (x.1 * y.1 + ∑ i, x.2 i * y.2 i, fun i => x.1 * y.2 i + y.1 * x.2 i)

/-- Jordan-algebra isomorphism, with the induced product on the specified subalgebra.
The image of the product must exist IN S and map to the explicit spin product. -/
def SpinIsomorphic {V : Type*} [AddCommGroup V] [Module ℝ V]
    (J : EuclideanJordan V) (S : Submodule ℝ V) (n : ℕ) : Prop :=
  ∃ f : S ≃ₗ[ℝ] SpinSpace n, ∀ x y : S, ∃ z : S,
    (z : V) = J.product (x : V) (y : V) ∧ f z = spinProduct (f x) (f y)

/-- The chosen h, KKT product, and -tau fixed spin factor in Remark 3.21, p. 28. -/
def SpinRealization {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]
    (tau theta : G ≃ₗ⁅ℝ⁆ G) (n : ℕ) : Prop :=
  ∃ h : G, h ≠ 0 ∧ tau h = h ∧ theta h = -h ∧ ThreeGrading h ∧
    ∃ J : EuclideanJordan (adSpace h 1), KKTModel theta h 1 J ∧
      ∃ a : JordanAuto J, (∀ v : adSpace h 1, (a.linear v : G) = -tau (v : G)) ∧
        SpinIsomorphic J (jordanFixed J a) n

/-- Real-coordinate scalar multiplication on the actual complexification, Section 2.1, p. 4. -/
def complexScalePair {G : Type*} [AddCommGroup G] [Module ℝ G]
    (z : ℂ) (x : G × G) : G × G :=
  (z.re • x.1 - z.im • x.2, z.im • x.1 + z.re • x.2)

/-- Conjugation relative to the real form, pp. 4–5. -/
def complexConjugatePair {G : Type*} [AddCommGroup G] (x : G × G) : G × G := (x.1, -x.2)

/-- Scalar-extended bracket, pp. 4–5. -/
def complexBracketPair {G : Type*} [LieRing G] (x y : G × G) : G × G :=
  (⁅x.1, y.1⁆ - ⁅x.2, y.2⁆, ⁅x.1, y.2⁆ + ⁅x.2, y.1⁆)

/-- The complex-linear extension of a real restriction a:t -> C, Section 2.1, p. 4. -/
def extendRoot {T : Type*} [AddCommGroup T] [Module ℝ T]
    (a : T →ₗ[ℝ] ℂ) (x : T × T) : ℂ := a x.1 + Complex.I * a x.2

example {n : ℕ} (x : SpinSpace n) : spinProduct (1, 0) x = x := by
  ext i <;> simp [spinProduct]

example {G : Type*} [AddCommGroup G] (x : G × G) :
    complexConjugatePair (complexConjugatePair x) = x := by simp [complexConjugatePair]

example {G : Type*} [AddCommGroup G] [Module ℝ G] (x : G × G) :
    complexScalePair Complex.I x = (-x.2, x.1) := by simp [complexScalePair]

example {G : Type*} [LieRing G] [LieAlgebra ℝ G] (u v : G) :
    complexScalePair Complex.I (complexBracketPair (u, v) (complexConjugatePair (u, v))) =
      ((2 : ℝ) • ⁅u, v⁆, (0 : G)) := by
  simp [complexScalePair, complexBracketPair, complexConjugatePair, lie_skew, two_smul]

end OrthogonalDefinitions

