-- url     : https://prove2.me/theorems/6235c484-50c0-41dd-8cec-5523ac43e5ad
-- title:
--   (4.2)–(4.6), pp. 2724–2725 — the N-player game: empirical measures, particle system, strategies ᾱ^{N,i}, states and costs
-- statement:
--   This module sets up the $N$-player stochastic differential game of §4 of Carmona and Delarue.
--
--   On a probability space $(\Omega,\mathbb P)$ let $(W^i)_{i\ge1}$ be $m$-dimensional Brownian motions and, for $N\ge1$, let $(\mathcal F^N_t)$ be the filtration generated by $(W^1,\dots,W^N)$, augmented by the $\mathbb P$-null sets. Fix a flow $\mu = (\mu_t)$ of probability measures on $\mathbb R^d$ and a function $u : [0,T]\times\mathbb R^d\to\mathbb R^d$.
--
--   1. **Empirical measure.** $\frac1N\sum_{j=1}^N\delta_{x_j}$ for $x_1,\dots,x_N\in\mathbb R^d$.
--   2. **Particle system (4.2).** $(X^1,\dots,X^N)$ with
--   $$dX^i_t = b\big(t,X^i_t,\bar\mu^N_t,\hat\alpha(t,X^i_t,\mu_t,u(t,X^i_t))\big)dt + \sigma\,dW^i_t,\qquad X^i_0 = x_0,\qquad \bar\mu^N_t = \frac1N\sum_{j=1}^N\delta_{X^j_t}.$$
--   3. **Strategies (4.3).** $\bar\alpha^{N,i}_t = \hat\alpha(t,X^i_t,\mu_t,u(t,X^i_t))$.
--   4. **States (4.5)** under a strategy profile $(\beta^1,\dots,\beta^N)$:
--   $$dU^i_t = b(t,U^i_t,\bar\nu^N_t,\beta^i_t)\,dt + \sigma\,dW^i_t,\qquad U^i_0 = x_0,\qquad \bar\nu^N_t = \frac1N\sum_{j=1}^N\delta_{U^j_t}.$$
--   5. **Cost (4.6)** to player $i$:
--   $$\bar J^{N,i}(\beta^1,\dots,\beta^N) = \mathbb E\Big[g(U^i_T,\bar\nu^N_T) + \int_0^T f(t,U^i_t,\bar\nu^N_t,\beta^i_t)\,dt\Big].$$
--   6. **Decoupled system** (p. 2725): $d\bar X^i_t = b\big(t,\bar X^i_t,\mu_t,\hat\alpha(t,\bar X^i_t,\mu_t,u(t,\bar X^i_t))\big)dt + \sigma\,dW^i_t$, $\bar X^i_0 = x_0$.
--   7. $\mathbb E\int_0^T|\beta_t|^2dt$ for a process $\beta$.
--
--   These objects state the approximate Nash property of the strategies $\bar\alpha^{N,i}$ (Theorem 4.2) and the propagation-of-chaos estimates of its proof.
--
--   **Formalization Note** Players are indexed by `Fin N`, i.e. $0,\dots,N-1$, and player $i$ is driven by the $i$-th Brownian motion of the sequence. The empirical measure of $N = 0$ points is the zero measure; every statement using it assumes $N\ge1$. Each SDE is an Itô process in Peng's sense (`Peng1990.SMP.SolvesSDE`) for $(\mathcal F^N_t)$, the coupling entering through the empirical measure, with almost surely continuous paths on $[0,T]$. The filtration is built directly (natural filtration of $(W^1,\dots,W^N)$ joined with the null sets) because the published augmented filtration takes a Brownian-motion proof for a single process. $\mathbb E\int_0^T|\beta_t|^2dt$ is a lower Lebesgue integral in $[0,\infty]$; costs are real expectations.
-- source:
--   Carmona and Delarue, Probabilistic analysis of mean-field games, SIAM J. Control Optim. 51 (2013), pp. 2724–2725, (4.2)–(4.6) and the decoupled system on p. 2725

import Mathlib
import Definitions.Def_ProbMFG_Nash_MFGSolution

open MeasureTheory
open scoped NNReal ENNReal

namespace ProbMFG.Nash

variable {d m k : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- The empirical measure `(1/N) Σⱼ δ_{x_j}` of `N` points of `ℝ^d` (a probability measure when
`N ≥ 1`; the zero measure when `N = 0`). -/
noncomputable def empirical {N : ℕ} (x : Fin N → EuclideanSpace ℝ (Fin d)) :
    Measure (EuclideanSpace ℝ (Fin d)) :=
  (N : ℝ≥0∞)⁻¹ • ∑ j, Measure.dirac (x j)

/-- The filtration generated by the Brownian motions `(W¹, …, W^N)` (the first `N` of the sequence
`Ws`, players `0, …, N − 1`), with the `P`-null sets adjoined:
`𝓕_t = σ{W^i_s : s ≤ t, i < N} ∨ σ{P-null sets}`. -/
noncomputable def playerFiltration (P : Measure Ω) {Ws : ℕ → ℝ≥0 → Ω → Fin m → ℝ}
    (hWs : ∀ i, Peng1990.SMP.IsStdBrownian P (Ws i)) (N : ℕ) : Filtration ℝ≥0 mΩ where
  seq t :=
    Filtration.natural (fun s ω (i : Fin N) => Ws i s ω)
        (fun s => (measurable_pi_lambda (fun ω (i : Fin N) => Ws i s ω)
          fun i => (hWs i).meas s).stronglyMeasurable) t ⊔
      ReflectedBSDE.Existence.nullSigma P
  mono' _ _ hst := sup_le_sup_right (Filtration.mono _ hst) _
  le' t := sup_le (Filtration.le _ t) (MeasurableSpace.generateFrom_le fun _ hN => hN.1)

/-- (4.3): the strategy `ᾱ^{N,i}_t = α̂(t, X^i_t, μ_t, u(t, X^i_t))` of player `i`, computed from the
states `Xs`, the flow `μ` and the FBSDE value function `u`. -/
noncomputable def alphaBar (M : Model d m k) (μ : ℝ≥0 → Measure (EuclideanSpace ℝ (Fin d)))
    (u : ℝ≥0 → EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d)) {N : ℕ}
    (Xs : Fin N → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d)) :
    Fin N → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin k) :=
  fun i t ω => M.alphaHat t (Xs i t ω) (μ t) (u t (Xs i t ω))

/-- (4.2): `(X¹, …, X^N)` solves the particle system
`dX^i_t = b(t, X^i_t, μ̄^N_t, α̂(t, X^i_t, μ_t, u(t, X^i_t))) dt + σ dW^i_t`, `X^i_0 = x₀`,
`μ̄^N_t = (1/N) Σⱼ δ_{X^j_t}`, each equation driven by its own `W^i`, as Itô processes for the
filtration of `(W¹, …, W^N)` with almost surely continuous paths on `[0, T]`. -/
def IsParticleSystem (M : Model d m k) (P : Measure Ω) {Ws : ℕ → ℝ≥0 → Ω → Fin m → ℝ}
    (hWs : ∀ i, Peng1990.SMP.IsStdBrownian P (Ws i))
    (μ : ℝ≥0 → Measure (EuclideanSpace ℝ (Fin d)))
    (u : ℝ≥0 → EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d)) (N : ℕ)
    (Xs : Fin N → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d)) : Prop :=
  ∀ i : Fin N, Peng1990.SMP.SolvesSDE (playerFiltration P hWs N) P M.T (Ws i) M.x₀.ofLp
    (fun s ω x => (M.b s (WithLp.toLp 2 x) (empirical (fun j => Xs j s ω))
      (M.alphaHat s (WithLp.toLp 2 x) (μ s) (u s (WithLp.toLp 2 x)))).ofLp)
    (sigmaCols M) (fun t ω => (Xs i t ω).ofLp) ∧
  ∀ᵐ ω ∂P, ContinuousOn (fun t => Xs i t ω) (Set.Iic M.T)

/-- (4.5): `(U¹, …, U^N)` are the private states of the players under the strategy profile
`(β¹, …, β^N)`: `dU^i_t = b(t, U^i_t, ν̄^N_t, β^i_t) dt + σ dW^i_t`, `U^i_0 = x₀`,
`ν̄^N_t = (1/N) Σⱼ δ_{U^j_t}`, as Itô processes for the filtration of `(W¹, …, W^N)` with almost
surely continuous paths on `[0, T]`. -/
def IsGameState (M : Model d m k) (P : Measure Ω) {Ws : ℕ → ℝ≥0 → Ω → Fin m → ℝ}
    (hWs : ∀ i, Peng1990.SMP.IsStdBrownian P (Ws i)) (N : ℕ)
    (β : Fin N → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin k))
    (Us : Fin N → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d)) : Prop :=
  ∀ i : Fin N, Peng1990.SMP.SolvesSDE (playerFiltration P hWs N) P M.T (Ws i) M.x₀.ofLp
    (fun s ω x => (M.b s (WithLp.toLp 2 x) (empirical (fun j => Us j s ω)) (β i s ω)).ofLp)
    (sigmaCols M) (fun t ω => (Us i t ω).ofLp) ∧
  ∀ᵐ ω ∂P, ContinuousOn (fun t => Us i t ω) (Set.Iic M.T)

/-- (4.6): the cost to player `i`,
`J̄^{N,i}(β¹, …, β^N) = 𝔼[g(U^i_T, ν̄^N_T) + ∫₀ᵀ f(t, U^i_t, ν̄^N_t, β^i_t) dt]`, along the states `Us`. -/
noncomputable def costN (M : Model d m k) (P : Measure Ω) {N : ℕ}
    (Us : Fin N → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d))
    (β : Fin N → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin k)) (i : Fin N) : ℝ :=
  ∫ ω, (M.g (Us i M.T ω) (empirical (fun j => Us j M.T ω)) +
    ∫ s in Set.Icc (0 : ℝ) M.T,
      M.f s.toNNReal (Us i s.toNNReal ω) (empirical (fun j => Us j s.toNNReal ω))
        (β i s.toNNReal ω)) ∂P

/-- The decoupled system (p. 2725): `dX̄^i_t = b(t, X̄^i_t, μ_t, α̂(t, X̄^i_t, μ_t, u(t, X̄^i_t))) dt + σ dW^i_t`,
`X̄^i_0 = x₀`, driven by the same `W^i` as (4.2), with the frozen flow `μ` in place of the empirical
measure; almost surely continuous paths on `[0, T]`. -/
def IsDecoupled (M : Model d m k) (P : Measure Ω) {Ws : ℕ → ℝ≥0 → Ω → Fin m → ℝ}
    (hWs : ∀ i, Peng1990.SMP.IsStdBrownian P (Ws i))
    (μ : ℝ≥0 → Measure (EuclideanSpace ℝ (Fin d)))
    (u : ℝ≥0 → EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d)) (N : ℕ)
    (Xbar : Fin N → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d)) : Prop :=
  ∀ i : Fin N, Peng1990.SMP.SolvesSDE (playerFiltration P hWs N) P M.T (Ws i) M.x₀.ofLp
    (fun s _ x => (M.b s (WithLp.toLp 2 x) (μ s)
      (M.alphaHat s (WithLp.toLp 2 x) (μ s) (u s (WithLp.toLp 2 x)))).ofLp)
    (sigmaCols M) (fun t ω => (Xbar i t ω).ofLp) ∧
  ∀ᵐ ω ∂P, ContinuousOn (fun t => Xbar i t ω) (Set.Iic M.T)

/-- `𝔼∫₀ᵀ |β_t|² dt`, in `[0, ∞]`. -/
noncomputable def sqInt (P : Measure Ω) (T : ℝ≥0) {k : ℕ}
    (β : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin k)) : ℝ≥0∞ :=
  ∫⁻ ω, ∫⁻ s in Set.Icc (0 : ℝ) T, ‖β s.toNNReal ω‖ₑ ^ 2 ∂volume ∂P

end ProbMFG.Nash


