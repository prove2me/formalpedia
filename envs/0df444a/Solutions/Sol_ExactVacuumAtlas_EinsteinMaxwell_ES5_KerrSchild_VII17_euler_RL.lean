open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII17
open Filter Set Topology
open scoped ContDiff
theorem euler_RL : ∀ (k n : ℕ) {M φ : ℝ → ℝ}, PS M →
    (∀ᶠ x in 𝓝[>] (0:ℝ), x * deriv M x + ((n : ℝ) + 1) * M x = φ x) →
    Tendsto (fun x => x * M x) (𝓝[>] (0:ℝ)) (𝓝 0) → RL k φ → RL k M
  | 0, _, _, _, hM, hode, hxM, ⟨_, hL⟩ => ⟨_, euler_lim hM hode hxM hL⟩
  | k + 1, n, M, φ, hM, hode, hxM, hφ => by
    obtain ⟨⟨L, hL⟩, hk⟩ := RL_succ.1 hφ
    have hlim := euler_lim hM hode hxM hL
    refine RL_succ.2 ⟨⟨_, hlim⟩, ?_⟩
    have hM' := hM.der
    have hode' : ∀ᶠ x in 𝓝[>] (0:ℝ),
        x * deriv (deriv M) x + (((n + 1 : ℕ) : ℝ) + 1) * deriv M x = deriv φ x := by
      filter_upwards [deriv_congr hode, hM, hM'] with x hx hcM hcM'
      rw [← hx]
      have d1 : DifferentiableAt ℝ M x := hcM.differentiableAt (by simp)
      have d2 : DifferentiableAt ℝ (deriv M) x := hcM'.differentiableAt (by simp)
      have hD : HasDerivAt (fun y => y * deriv M y + ((n : ℝ) + 1) * M y)
          (1 * deriv M x + x * deriv (deriv M) x + ((n : ℝ) + 1) * deriv M x) x :=
        ((hasDerivAt_id' x).mul d2.hasDerivAt).add (d1.hasDerivAt.const_mul _)
      rw [hD.deriv]; push_cast; ring
    have hxM' : Tendsto (fun x => x * deriv M x) (𝓝[>] (0:ℝ)) (𝓝 0) := by
      have h2 := hL.sub (hlim.const_mul ((n : ℝ) + 1))
      have h0 : L - ((n : ℝ) + 1) * (L / ((n : ℝ) + 1)) = 0 := by field_simp; ring
      rw [h0] at h2
      refine h2.congr' ?_
      filter_upwards [hode] with x hx
      rw [← hx]; ring
    exact euler_RL k (n + 1) hM' hode' hxM' hk

theorem solution : ∀ (k n : ℕ) {M φ : ℝ → ℝ}, PS M →
    (∀ᶠ x in 𝓝[>] (0:ℝ), x * deriv M x + ((n : ℝ) + 1) * M x = φ x) →
    Tendsto (fun x => x * M x) (𝓝[>] (0:ℝ)) (𝓝 0) → RL k φ → RL k M :=
  @euler_RL
