-- Source module: NLogN.HNumCall
/-!
# Tools for composing numeric register programs

* general integer division `Ex.ediv`, remainder `Ex.emod`, and `Ex.max0` (`toNat`),
* "top-based" wrappers of `piP`, `log2P`, `expP` usable as conditional `simp` lemmas,
* crude size bounds on `piBits`, `log2Bits`, `expBits`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS IntMul.HvdH

namespace Ex

@[simp] theorem ediv_eval (s : IState HS) (a b : Ex HS) :
    (ediv a b).eval s = a.eval s / b.eval s := by
  rcases lt_trichotomy (b.eval s) 0 with h | h | h
  · have h1 : ¬ (-b.eval s < 0) := by omega
    simp only [ediv, eval, h1, h, if_false, if_true]
    rw [fdiv_eval s a _ (by simp only [eval]; linarith)]
    simp only [eval, Int.ediv_neg, neg_neg]
  · simp [ediv, eval, h]
  · have h1 : -b.eval s < 0 := by omega
    simp only [ediv, eval, h1, if_true]
    exact fdiv_eval s a b h

@[simp] theorem emod_eval (s : IState HS) (a b : Ex HS) :
    (emod a b).eval s = a.eval s % b.eval s := by
  simp only [emod, eval, ediv_eval]
  rw [Int.emod_def]; ring

theorem ediv_ok {s : IState HS} {a b : Ex HS} (ha : a.ok s) (hb : b.ok s) : (ediv a b).ok s := by
  rcases lt_trichotomy (b.eval s) 0 with h | h | h
  · have h1 : ¬ (-b.eval s < 0) := by omega
    simp only [ediv, ok, eval, h1, h, if_false, if_true]
    exact ⟨hb, hb, fdiv_ok s a _ ha hb (by simp only [eval]; linarith)⟩
  · simp [ediv, ok, eval, h, hb]
  · have h1 : -b.eval s < 0 := by omega
    simp only [ediv, ok, eval, h1, if_true]
    exact ⟨hb, fdiv_ok s a b ha hb h⟩

end Ex

