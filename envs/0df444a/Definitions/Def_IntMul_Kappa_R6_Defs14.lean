-- Source module: Solutions.R6CrtLoop
/-!
# CRT reversal §4: one rotation set and one composite swap in IL

* `rotIt sig`: one digit-selector rotation (`rotDU`) and the register advance
  `P_t ← P_t·Q`, `vol C ← vol C / Q`, `D ← D/Q` (`sig`) or `D·Q`, `t ← t+1`.
* `lsU sig neg`: the rotation set `L(±σ)` / `L(±1)`: push `Q`, `μ = Q-1` (`neg`) or `1`, and the
  start values from the global registers, run `m = ⌊n/2⌋` iterations (`rptX` on `rH`), pop.
  **`lsU_runs`**: the data `xs` (shape `SH n Q T`) becomes `pull … (lsetK Q n m sig μ m) xs`.
* `swpU`: the composite Lemma 12 swap of the blocks `x`, `y` (`swS` with `u' = u·m`,
  `2^{u'} = Q^m`). **`swpU_runs`**: the data becomes `pull … (bsw n m) xs`.

Global registers (set by the prologue of `p2E`): `gQm = Q^m`, `gP = Q^{n-m}`,
`gB = Q^{m-1} · vol T`, `gD = Q^{m-1}`, `gI = n - m`, `gUm = u·m`, `gMd = Q^{n-2m}`; `rH = m`,
`rB = vol T / 2`, `oSP` holds `n` copies of `Q`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU.R6Crt

open IntMul KIL KFB KFC KFT KFU AModel AModelL12 NLogN.KFUU

abbrev gQm : Fin HS := 30
abbrev gP : Fin HS := 31
abbrev gB : Fin HS := 33
abbrev gD : Fin HS := 12
abbrev gI : Fin HS := 11
abbrev gUm : Fin HS := 9
abbrev gMd : Fin HS := 32

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## Values -/

/-- The control divisor after `k` iterations. -/
def Dk (sig : Bool) (Q m k : ℕ) : ℕ := if sig then Q ^ (m - 1) / Q ^ k else Q ^ k

/-! ## One iteration -/

/-- The `D` update. -/
def dStep (sig : Bool) : IStmt HS P := if sig then divE oDc rU2 tq else .op (.shl oDc rU2)

/-- One iteration of a rotation set. -/
def rotIt (sig : Bool) : IStmt HS P :=
  .seq rotDU (.seq (.op (.shl oPi rU2)) (.seq (divE oBv rU2 tq)
    (.seq (dStep sig) (.seq (.op (.const tq 1)) (.op (.add oI tq oI))))))

/-- The loop state after `k` iterations (over the base state `t`). -/
def lsSt (Q n m : ℕ) (T : Shape) (sig : Bool) (μ : ℕ) (t : IState HS) (R LP LB LD LI : List Item)
    (xs : List ℤ) (k : ℕ) : IState HS :=
  ((((t.upd 0 (ints (pull (SH n Q T) (SH n Q T) (lsetK Q n m sig μ k) 0 xs) ++ R)).upd
    oPi (.int ((Q ^ (n - m + k) : ℕ) : ℤ) :: LP)).upd
    oBv (.int ((Q ^ (m - 1) * vol T / Q ^ k : ℕ) : ℤ) :: LB)).upd
    oDc (.int ((Dk sig Q m k : ℕ) : ℤ) :: LD)).upd
    oI (.int ((n - m + k : ℕ) : ℤ) :: LI)

/-- The cost of one iteration. -/
def cIt (n V Q w Z : ℕ) : ℕ := cTab n (V / Q) Z (Z + 1) + 68 * kap w * V + 8 * Z + 8 + 5 * cU Z

end Gen

end NLogN.KFUU.R6Crt

end

section
-- Source module: Solutions.R6CrtSet
/-!
# CRT reversal §5: one rotation set (`lsU`) and one composite swap (`swpU`) in IL

* `lsU sig neg`: push `Q`, `μ = Q-1` (`neg`) or `1`, and the start values from the global
  registers; run `m` iterations of `rotIt sig` (`rptX` on `rH`); pop.
  **`lsU_runs`**: the data `xs` (shape `SH n Q T`) becomes `pull … (lsetK Q n m sig μ m) xs`.
* `swpU`: the composite Lemma 12 swap of the first and the last `m` digits (`swS` with
  `u' = u·m`, `2^{u'} = Q^m`). **`swpU_runs`**: the data becomes `pull … (bsw n m) xs`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU.R6Crt

open IntMul KIL KFB KFC KFT KFU AModel AModelL12 NLogN.KFUU

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {τ : ℝ}

/-- `μ`. -/
def muV (Q : ℕ) (neg : Bool) : ℕ := if neg then Q - 1 else 1

def muSt (neg : Bool) : IStmt HS P :=
  if neg then .seq (.op (.dup rU2 oMu)) (.seq (.op (.const tq (-1))) (.op (.add oMu tq oMu)))
  else .op (.const oMu 1)

def dcSt (sig : Bool) : IStmt HS P := if sig then .op (.dup gD oDc) else .op (.const oDc 1)

/-- One rotation set. -/
def lsU (sig neg : Bool) : IStmt HS P :=
  .seq (.op (.dup rU2 oQ)) (.seq (muSt neg) (.seq (.op (.dup gP oPi)) (.seq (.op (.dup gB oBv))
  (.seq (dcSt sig) (.seq (.op (.dup gI oI)) (.seq (rptX rH lA lC lD (rotIt sig))
  (.seq (.op (.drop oI)) (.seq (.op (.drop oDc)) (.seq (.op (.drop oBv)) (.seq (.op (.drop oPi))
  (.seq (.op (.drop oMu)) (.op (.drop oQ)))))))))))))

/-- The cost of one rotation set. -/
def cLs (n V Q w Z m : ℕ) : ℕ := (m + 1) * (cIt n V Q w Z + 3000) + 20 * cU Z

/-! ## The composite swap -/

def swpU (eSw : Fin P) (dS Dsc : Fin HS) : IStmt HS P :=
  .seq (.op (.dup gUm rU)) (.seq (.op (.const rA 1)) (.seq (.op (.dup gQm rU2))
  (.seq (.op (.dup gMd rM)) (.seq (swS eSw dS Dsc) (.seq (.op (.drop rU)) (.seq (.op (.drop rA))
  (.seq (.op (.drop rU2)) (.op (.drop rM)))))))))

end Gen

end NLogN.KFUU.R6Crt

end

