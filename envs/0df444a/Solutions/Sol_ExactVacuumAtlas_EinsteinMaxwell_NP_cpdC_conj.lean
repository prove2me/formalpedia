open Real Complex
open scoped ComplexConjugate Matrix ContDiff
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del gKN giKN faradayKN domReg)
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin
theorem solution {n : ℕ} (i : Fin n) (f : Pt n → ℂ) (x : Pt n) :
    cpdC i (fun y => conj (f y)) x = conj (cpdC i f x) := by
  unfold cpdC
  by_cases hd : DifferentiableAt ℝ (fun u : ℝ => f (Function.update x i u)) (x i)
  · have h := (conjCLE.hasFDerivAt.comp_hasDerivAt (x i) hd.hasDerivAt)
    exact h.deriv
  · rw [deriv_zero_of_not_differentiableAt hd, map_zero]
    refine deriv_zero_of_not_differentiableAt fun hc => hd ?_
    have := (conjCLE.differentiableAt).comp (x i) hc
    simpa [Function.comp_def] using this
