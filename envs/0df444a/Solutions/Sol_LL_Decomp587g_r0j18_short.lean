private lemma r0j18_main_bound {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {φ : ℝ} (hφ : 2 ≤ φ) (hφhi : φ ≤ (232 / 100 : ℝ)) :
    buchstabIntegral ω 2 (fun j => (r0j18_lo j : ℝ)) (fun j => (r0j18_hi j : ℝ)) φ ≤
      ((155569 / 1000000000) : ℝ) := by
  rw [buchstabIntegral_eq_conv hω hz hφ hφhi]
  have hD : (0 : ℝ) < D_den := by unfold D_den; norm_num
  have hphi_b1 : (phi_b1 : ℝ) / D_den = 2 := by unfold phi_b1 D_den; norm_num
  have hphi_b2 : phi_b1 + 10 * 4 * ((2 * B_num - 2 * A_num) / 64) = phi_b2 := by decide +kernel
  have hphi_b3 : phi_b2 + 10 * 2 * ((2 * B_num - 2 * A_num) / 128) = phi_b3 := by decide +kernel
  have hphi_b4 : phi_b3 + 16 * 1 * ((2 * B_num - 2 * A_num) / 256) = phi_b4 := by decide +kernel
  have hphi_b5 : phi_b4 + 74 * 1 * ((2 * B_num - 2 * A_num) / 768) = phi_b5 := by decide +kernel
  have hphi_b6 : phi_b5 + 20 * 1 * ((2 * B_num - 2 * A_num) / 256) = phi_b6 := by decide +kernel
  have hphi_b7 : phi_b6 + 9 * 2 * ((2 * B_num - 2 * A_num) / 128) = phi_b7 := by decide +kernel
  have hphi_end : phi_b7 + 11 * 8 * ((2 * B_num - 2 * A_num) / 64) = phi_end := by decide +kernel
  by_cases h1 : φ ≤ (phi_b2 : ℝ) / D_den
  · exact band_sound (by omega) (by decide) (by decide +kernel) (by omega) (by decide +kernel)
      (by omega) (by omega) (by decide +kernel) (by decide +kernel) (by decide +kernel)
      W_cert_64_ok H_cert_1_ok slices_1_ok (by linarith) (by rw [hphi_b2]; exact h1)
  · by_cases h2 : φ ≤ (phi_b3 : ℝ) / D_den
    · exact band_sound (by omega) (by decide) (by decide +kernel) (by omega) (by decide +kernel)
        (by omega) (by omega) (by decide +kernel) (by decide +kernel) (by decide +kernel)
        W_cert_128_ok H_cert_2_ok slices_2_ok (le_of_not_ge h1) (by rw [hphi_b3]; exact h2)
    · by_cases h3 : φ ≤ (phi_b4 : ℝ) / D_den
      · exact band_sound (by omega) (by decide) (by decide +kernel) (by omega) (by decide +kernel)
          (by omega) (by omega) (by decide +kernel) (by decide +kernel) (by decide +kernel)
          W_cert_256_ok H_cert_3_ok slices_3_ok (le_of_not_ge h2) (by rw [hphi_b4]; exact h3)
      · by_cases h4 : φ ≤ (phi_b5 : ℝ) / D_den
        · exact band_sound (by omega) (by decide) (by decide +kernel) (by omega) (by decide +kernel)
            (by omega) (by omega) (by decide +kernel) (by decide +kernel) (by decide +kernel)
            W_cert_768_ok H_cert_4_ok slices_4_ok (le_of_not_ge h3) (by rw [hphi_b5]; exact h4)
        · by_cases h5 : φ ≤ (phi_b6 : ℝ) / D_den
          · exact band_sound (by omega) (by decide) (by decide +kernel) (by omega) (by decide +kernel)
              (by omega) (by omega) (by decide +kernel) (by decide +kernel) (by decide +kernel)
              W_cert_256_ok H_cert_5_ok slices_5_ok (le_of_not_ge h4) (by rw [hphi_b6]; exact h5)
          · by_cases h6 : φ ≤ (phi_b7 : ℝ) / D_den
            · exact band_sound (by omega) (by decide) (by decide +kernel) (by omega) (by decide +kernel)
                (by omega) (by omega) (by decide +kernel) (by decide +kernel) (by decide +kernel)
                W_cert_128_ok H_cert_6_ok slices_6_ok (le_of_not_ge h5) (by rw [hphi_b7]; exact h6)
            · have h7 : φ ≤ (phi_end : ℝ) / D_den := by
                have hge : (232 : ℝ) * D_den ≤ 100 * phi_end := by exact_mod_cast phi_end_ge
                have hle_r : (232 / 100 : ℝ) ≤ (phi_end : ℝ) / D_den := by
                  rw [div_le_div_iff₀ (by norm_num) hD]; linarith
                linarith
              exact band_sound (by omega) (by decide) (by decide +kernel) (by omega) (by decide +kernel)
                (by omega) (by omega) (by decide +kernel) (by decide +kernel) (by decide +kernel)
                W_cert_64_ok H_cert_7_ok slices_7_ok (le_of_not_ge h6) (by rw [hphi_end]; exact h7)

lemma r0j18_short_proved {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {φ : ℝ} (hφ : 2 ≤ φ) (hφtop : φ ≤ (7 / 2 : ℝ)) :
    buchstabIntegral ω 2 (fun j => (r0j18_lo j : ℝ)) (fun j => (r0j18_hi j : ℝ)) φ ≤
      ((155569 / 1000000000) : ℝ) := by
  by_cases hsplit : φ ≤ (232 / 100 : ℝ)
  · exact r0j18_main_bound hω hz hφ hsplit
  · exact r0j18_tail_bound hω hz (le_of_not_ge hsplit) hφtop

end

