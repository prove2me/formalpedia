theorem MetricCodes.Spherical.HigherHarmonicYoung.AllRankGTTransverseWrongBranchCompression.canonicalFullBranchFibre_adjoint_comp_of_ne
    {r n : ℕ} (lam : Fin (r + 1) → ℕ)
    (hn : 2 * r + 5 ≤ n + 1)
    (branch selected : FullBranchWeight lam)
    (hne : branch ≠ selected) :
    (canonicalFullBranchFibre lam hn branch).toLinearMap.adjoint.comp
      (canonicalFullBranchFibre lam hn selected).toLinearMap = 0 := by sorry
