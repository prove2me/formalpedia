-- title:
--   The ambiguity set $\mathcal B_{\tau,G}$ of variation in bidding (corrected: unconstrained bids $\ge L$, independent of who is constrained), p. 20
-- statement:
--   This file builds the ambiguity set $\mathcal B_{\tau,G}$ of §6.2 ("variation in bidding"), in the corrected form used throughout this mission.
--
--   Fix $n$ bidders, a probability $\tau$, a threshold $L$ and a distribution $G$ of bids. A joint law $B$ of the $n-1$ opponent bids belongs to $\mathcal B_{\tau,G}$ if it is the law of the vector $(b_j)_{j=1}^{n-1}$ given by
--   $$
--   b_j = \begin{cases} Y_j & \text{if } c_j = 1 \text{ (opponent } j \text{ is constrained)},\\ Z_j & \text{if } c_j = 0, \end{cases}
--   $$
--   where $c_1,\dots,c_{n-1}$ are i.i.d. Bernoulli($\tau$), $Y_1,\dots,Y_{n-1}$ are i.i.d. with law $G$, the vector $Z = (Z_j)$ of **unconstrained** bids has an arbitrary joint law $H$ with $H([L,\infty)^{n-1}) = 1$, and $c$, $Y$, $Z$ are independent. Every such $H$ is admissible: the unconstrained bids may be independent, perfectly correlated, or anything in between.
--
--   The file also defines the uniform distribution $G$ on $[L, v_1]$, the salient choice of Proposition 4, and the member of $\mathcal B_{\tau,G}$ in which all unconstrained opponents bid one common value $x$ ($H$ the point mass at $(x,\dots,x)$), which is the shape of the worst cases in Lemma 1.
--
--   **Correction.** The printed definition on p. 20 lets the law $H_i$ of the unconstrained bids depend on the pattern $i$ of who is constrained, and lets it live on all of $\mathbb R^{n-1-|i|}$. Under that set the paper's Lemma 1 and Propositions 3–4 fail for $n \ge 3$ (for example, $n = 3$, $\tau = 0.3$, $L = 0$, $v_1 = 1$, $b_1 = 0.7$ has maximal loss at least $0.330$ against the paper's $0.2416$). Two things change here. $Z$ is drawn independently of the constraint pattern, as in the paper's informal description ("bids of the unconstrained bidders are arbitrary"). And the unconstrained bids are at least $L$, as in "we eliminate all bids below L" (p. 20). For $n = 2$ the corrected set coincides with the printed one restricted to bids $\ge L$.
--
--   **Formalization Note.** Each opponent's pair $(c_j, Y_j)$ is drawn from the product of the Bernoulli law on `Bool` (`true` = constrained, weight $\tau$) and $G$; the $n-1$ pairs are independent (`Measure.pi`), and the pair vector is independent of $Z \sim H$ (`Measure.prod`). The bid vector is the pushforward (`Measure.map`) under the measurable map $((c,Y),Z) \mapsto b$. The uniform $G$ is Lebesgue measure conditioned on $[L, v_1]$. Membership requires $n\ge2$, $L\ge0$, $0\le\tau\le1$, probability $G$, and $G((\mathord{-}\infty,L))=0$; the theorems instantiate $G$ uniform.
-- source:
--   Kasberger & Schlag, Robust Bidding in First-Price Auctions, SSRN 3044438 (version of 3 Sep 2022), p. 20, §6.2 (definition of B_{τ,G}, corrected), and p. 23 (G uniform, Proposition 4)

import Mathlib

open MeasureTheory

namespace RobustFPA.VarBid

/-- Bernoulli(`τ`) law on `Bool`: `true` ("constrained") with probability `τ`. -/
noncomputable def bern (τ : ℝ) : Measure Bool :=
  Real.toNNReal τ • Measure.dirac true + Real.toNNReal (1 - τ) • Measure.dirac false

/-- The uniform distribution `G` on `[L, v]` (Proposition 4, p. 23). -/
noncomputable def uniformG (L v : ℝ) : Measure ℝ :=
  ProbabilityTheory.cond volume (Set.Icc L v)

instance (L v : ℝ) : IsFiniteMeasure (uniformG L v) := by
  unfold uniformG; infer_instance

/-- Law of the constrained part for `m` opponents: independently for each opponent `j`, a coin
`c_j ~ Bernoulli(τ)` (constrained or not) and an independent draw `Y_j ~ G`. -/
noncomputable def constrainedLaw (m : ℕ) (τ : ℝ) (G : Measure ℝ) [IsFiniteMeasure G] :
    Measure (Fin m → Bool × ℝ) :=
  Measure.pi (fun _ => (bern τ).prod G)

/-- The realised bid vector: opponent `j` bids `Y_j` if constrained (`c_j = true`) and `Z_j`
otherwise. -/
def mixBids {m : ℕ} (cy : Fin m → Bool × ℝ) (z : Fin m → ℝ) : Fin m → ℝ :=
  fun j => if (cy j).1 then (cy j).2 else z j

/-- The bid distribution generated by the unconstrained-bid law `H`: the law of
`mixBids (c, Y) Z` where `(c, Y) ~ constrainedLaw` and `Z ~ H` are independent. -/
noncomputable def envOf (n : ℕ) (τ : ℝ) (G : Measure ℝ) [IsFiniteMeasure G]
    (H : Measure (Fin (n - 1) → ℝ)) : Measure (Fin (n - 1) → ℝ) :=
  Measure.map (fun p : (Fin (n - 1) → Bool × ℝ) × (Fin (n - 1) → ℝ) => mixBids p.1 p.2)
    ((constrainedLaw (n - 1) τ G).prod H)

/-- The (corrected) ambiguity set `B_{τ,G}` of §6.2 (p. 20) for `n` bidders, i.e. `n - 1`
opponents. There are at least two bidders and the threshold is non-negative. The coin parameter
is a probability, `G` is a bid distribution supported on
`[L, ∞)`, and every `envOf n τ G H` has `H` a probability measure on `ℝ^{n-1}` concentrated on
`[L, ∞)^{n-1}`. The unconstrained bids `Z ~ H` are independent of who is constrained. -/
def varBidSet (n : ℕ) (τ L : ℝ) (G : Measure ℝ) [IsFiniteMeasure G] :
    Set (Measure (Fin (n - 1) → ℝ)) :=
  {B | 2 ≤ n ∧ 0 ≤ L ∧ 0 ≤ τ ∧ τ ≤ 1 ∧ IsProbabilityMeasure G ∧ G (Set.Iio L) = 0 ∧
    ∃ H : Measure (Fin (n - 1) → ℝ), IsProbabilityMeasure H ∧
    H {z | ∀ j, L ≤ z j} = 1 ∧ B = envOf n τ G H}

/-- The member of `B_{τ,G}` in which every unconstrained opponent bids the common value `x`. -/
noncomputable def commonBidEnv (n : ℕ) (τ : ℝ) (G : Measure ℝ) [IsFiniteMeasure G] (x : ℝ) :
    Measure (Fin (n - 1) → ℝ) :=
  envOf n τ G (Measure.dirac (fun _ => x))

end RobustFPA.VarBid


