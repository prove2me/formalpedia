variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Lemma 3.8, PDF p. 21. Spectral containment, semisimplicity, and nonzero extremes. -/
theorem lemma_3_8 (hg : HermitianSimple (G := G)) (h : G)
    (hs : (LieAlgebra.ad ℝ G h).IsSemisimple)
    (hsp : complexSpectrum (LieAlgebra.ad ℝ G h) ⊆ fiveSpectrum)
    (hn : adSpace h (-1) ≠ ⊥ ∧ adSpace h 1 ≠ ⊥) :
    HermitianSimple (G := tubeAlgebra h) ∧ RestrictedTubeType (G := tubeAlgebra h) ∧
      DirectThree (tubeAlgebra h).toSubmodule (adSpace h (-1))
        (bracketSpan (adSpace h (-1)) (adSpace h 1)) (adSpace h 1) := by sorry

end LieStatements

end

