  have hdetES : LinearMap.det (ρES.ρ τ)
      = ((algebraMap O' ↥(integralClosure O' ↥L')).comp φ) (e ℓ₀) * (q : ↥(integralClosure O' ↥L')) :=
    GaloisRepAdic.det_eq_mul_of_isFrobeniusAt_of_det_frobenius_eq_mul_of_not_dvd_conductor
      lam hp'' M₀ q hq hqM₀ hqlam ε hqε S' R toC htoC
      ((algebraMap O' ↥(integralClosure O' ↥L')).comp φ) e he' ρES
