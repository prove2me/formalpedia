/-- E3 core: the real `pcE` (incl. its J-term) as an exact quadratic in `q = x b₁/b`, with the
remainder written as `x · rhoX` in slope form. -/
theorem e3_core (hx : x ≠ 0) (hF : F ≠ 0) (hb : b ≠ 0) (hu : 1 - h * x ≠ 0) :
    (1 - h * x) * (x * b₁ / b) ^ 2 + (2 - (1 - h * x) * (x * F₁ / F)) * (x * b₁ / b)
      + x * ((1 - h * x) * x * (F₁ / F) ^ 2 - F₁ / F
             + ((b - 1) / x * (b + 1) - (F - 1) / x) / b ^ 2 + h * (b ^ 2 + F) / b ^ 2
             + 4 * b * x ^ 2 * A₁ ^ 2 - 4 * F * x ^ 2 * (A / x) ^ 2 / b
             - 4 * Q ^ 2 * F * x / (1 - h * x)
             - 4 * F * b * x ^ 2 * (J + 2 * Q * A) ^ 2 / (1 - h * x) ^ 2)
    = pcE x (1 - h * x) h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂ / (F ^ 2 * b ^ 2 * (1 - h * x) ^ 2) := by
  unfold pcE; field_simp; ring

