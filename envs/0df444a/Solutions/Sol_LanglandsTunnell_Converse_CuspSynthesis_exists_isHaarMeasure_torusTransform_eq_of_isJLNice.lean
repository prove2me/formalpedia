open NumberField NumberField.InfinitePlace NumberField.InfinitePlace.Completion MeasureTheory
open scoped WithZero Classical

variable {K : Type} [Field K] [NumberField K]

attribute [local instance] NumberField.Idele.ideleBorel NumberField.Idele.borelSpace_ideleBorel

private theorem t0573 :
    Continuous fun a : (AdeleRing (𝓞 K) K)ˣ =>
      InfiniteAdeleRing.ringEquiv_mixedSpace K ((a : AdeleRing (𝓞 K) K)).1 := by
  have h₁ : Continuous fun a : (AdeleRing (𝓞 K) K)ˣ => ((a : AdeleRing (𝓞 K) K)).1 :=
    continuous_fst.comp Units.continuous_val
  have h₂ : Continuous (InfiniteAdeleRing.ringEquiv_mixedSpace K) := by
    show Continuous fun x : InfiniteAdeleRing K =>
      ((fun v : {w : InfinitePlace K // w.IsReal} => extensionEmbeddingOfIsReal v.2 (x v.1)),
        (fun v : {w : InfinitePlace K // w.IsComplex} => extensionEmbedding v.1 (x v.1)))
    refine Continuous.prodMk (continuous_pi fun v => ?_) (continuous_pi fun v => ?_)
    · have hv : Continuous fun x : InfiniteAdeleRing K => x v.1 := continuous_apply v.1
      exact (isometry_extensionEmbeddingOfIsReal v.2).continuous.comp hv
    · have hv : Continuous fun x : InfiniteAdeleRing K => x v.1 := continuous_apply v.1
      exact (isometry_extensionEmbedding v.1).continuous.comp hv
  exact h₂.comp h₁

private noncomputable def d052 (F : {w : InfinitePlace K // w.IsReal} → ℝ → ℂ)
    (F' : {w : InfinitePlace K // w.IsComplex} → ℂ → ℂ) (z : mixedEmbedding.mixedSpace K) : ℂ :=
  (∏ v, F v (z.1 v)) * ∏ v, F' v (z.2 v)

private theorem t0574 :
    ∀ᵐ z ∂(volume : Measure (mixedEmbedding.mixedSpace K)),
      (ENNReal.ofReal ((∏ w, |z.1 w|) * ∏ w, ‖z.2 w‖ ^ 2))⁻¹ < ⊤ := by
  have hre : ∀ v : {w : InfinitePlace K // w.IsReal},
      ∀ᵐ z ∂(volume : Measure (mixedEmbedding.mixedSpace K)), z.1 v ≠ 0 := by
    intro v
    rw [ae_iff]
    have hset : {z : mixedEmbedding.mixedSpace K | ¬ z.1 v ≠ 0} =
        {x : {w : InfinitePlace K // w.IsReal} → ℝ | x v = 0} ×ˢ Set.univ := by
      ext z
      simp
    rw [hset, Measure.volume_eq_prod, Measure.prod_prod, volume_pi, Measure.pi_hyperplane, zero_mul]
  have hco : ∀ v : {w : InfinitePlace K // w.IsComplex},
      ∀ᵐ z ∂(volume : Measure (mixedEmbedding.mixedSpace K)), z.2 v ≠ 0 := by
    intro v
    rw [ae_iff]
    have hset : {z : mixedEmbedding.mixedSpace K | ¬ z.2 v ≠ 0} =
        Set.univ ×ˢ {y : {w : InfinitePlace K // w.IsComplex} → ℂ | y v = 0} := by
      ext z
      simp
    rw [hset, Measure.volume_eq_prod, Measure.prod_prod]
    simp only [volume_pi]
    rw [Measure.pi_hyperplane, mul_zero]
  have hall : ∀ᵐ z ∂(volume : Measure (mixedEmbedding.mixedSpace K)),
      (∀ v : {w : InfinitePlace K // w.IsReal}, z.1 v ≠ 0) ∧
        ∀ v : {w : InfinitePlace K // w.IsComplex}, z.2 v ≠ 0 :=
    (ae_all_iff.2 hre).and (ae_all_iff.2 hco)
  filter_upwards [hall] with z hz
  rw [ENNReal.inv_lt_top, ENNReal.ofReal_pos]
  exact mul_pos (Finset.prod_pos fun v _ => abs_pos.2 (hz.1 v))
    (Finset.prod_pos fun v _ => pow_pos (norm_pos_iff.2 (hz.2 v)) 2)

private theorem measurable_density :
    Measurable fun z : mixedEmbedding.mixedSpace K =>
      (ENNReal.ofReal ((∏ w, |z.1 w|) * ∏ w, ‖z.2 w‖ ^ 2))⁻¹ := by
  have hc : Continuous fun z : mixedEmbedding.mixedSpace K => (∏ w, |z.1 w|) * ∏ w, ‖z.2 w‖ ^ 2 :=
    (continuous_finsetProd _ fun w _ => ((continuous_apply w).comp continuous_fst).abs).mul
      (continuous_finsetProd _ fun w _ => ((continuous_apply w).comp continuous_snd).norm.pow 2)
  exact (ENNReal.measurable_ofReal.comp hc.measurable).inv

variable (K) in

private noncomputable def d053 : ENNReal :=
  Classical.choose (NumberField.Idele.exists_map_ringEquiv_mixedSpace_sPartMeasure_empty_eq_smul_withDensity K)

variable (K) in

private theorem t0575 :
    d053 K ≠ 0 ∧ d053 K ≠ ⊤ ∧
      Measure.map
          (fun a : (AdeleRing (𝓞 K) K)ˣ =>
            InfiniteAdeleRing.ringEquiv_mixedSpace K ((a : AdeleRing (𝓞 K) K)).1)
          (NumberField.Idele.sPartMeasure K ∅) =
        d053 K • (volume : Measure (mixedEmbedding.mixedSpace K)).withDensity
          (fun z => (ENNReal.ofReal ((∏ w, |z.1 w|) * ∏ w, ‖z.2 w‖ ^ 2))⁻¹) :=
  Classical.choose_spec (NumberField.Idele.exists_map_ringEquiv_mixedSpace_sPartMeasure_empty_eq_smul_withDensity K)

private theorem t0576 (F : {w : InfinitePlace K // w.IsReal} → ℝ → ℂ)
    (F' : {w : InfinitePlace K // w.IsComplex} → ℂ → ℂ)
    (hG : AEStronglyMeasurable (d052 F F') (volume : Measure (mixedEmbedding.mixedSpace K))) :
    ∫ a, d052 F F' (InfiniteAdeleRing.ringEquiv_mixedSpace K ((a : AdeleRing (𝓞 K) K)).1)
        ∂(NumberField.Idele.sPartMeasure K ∅) =
      (d053 K).toReal *
        ((∏ v : {w : InfinitePlace K // w.IsReal}, ∫ y : ℝ, F v y * ((|y| : ℝ) : ℂ)⁻¹) *
          ∏ v : {w : InfinitePlace K // w.IsComplex}, ∫ z : ℂ, F' v z * ((‖z‖ ^ 2 : ℝ) : ℂ)⁻¹) := by
  obtain ⟨-, -, hmap⟩ := t0575 K
  have hφ : AEMeasurable
      (fun a : (AdeleRing (𝓞 K) K)ˣ => InfiniteAdeleRing.ringEquiv_mixedSpace K ((a : AdeleRing (𝓞 K) K)).1)
      (NumberField.Idele.sPartMeasure K ∅) :=
    t0573.measurable.aemeasurable
  have hG' : AEStronglyMeasurable (d052 F F')
      (Measure.map
        (fun a : (AdeleRing (𝓞 K) K)ˣ => InfiniteAdeleRing.ringEquiv_mixedSpace K ((a : AdeleRing (𝓞 K) K)).1)
        (NumberField.Idele.sPartMeasure K ∅)) := by
    rw [hmap]
    exact hG.mono_ac ((withDensity_absolutelyContinuous _ _).smul_left _)

  have hpt : ∀ z : mixedEmbedding.mixedSpace K,
