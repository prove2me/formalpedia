    rw [ModularCurve.rationalGaloisRep_apply, hrep]; rfl
  have h2 : (c : E) • (1 : Module.End E (E ⊗[ℚ_[ℓ]] ModularCurve.RationalTateModule ℓ J))
      = (Module.End.baseChangeHom ℚ_[ℓ] E (ModularCurve.RationalTateModule ℓ J))
