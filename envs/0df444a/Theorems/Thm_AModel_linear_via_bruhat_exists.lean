variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)
variable {E : Matrix (Fin n) (Fin n) (ZMod Q)}
variable [NeZero Q]

theorem AModel.linear_via_bruhat_exists {E₁ E₂ : Matrix (Fin n) (Fin n) (ZMod Q)}
    (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hE₂ : ∀ i j, i < j → E₂ i j = 0)
    (σ : Equiv.Perm (Fin n)) :
    ∃ ts : List (Fin n × Fin n), ts.length ≤ n ∧
      ∀ a, Valid sh a →
        amap Λ (E₁ * σ.permMatrix (ZMod Q) * E₂) a = run Λ (bruhatSteps E₁ ts E₂) a := by sorry
