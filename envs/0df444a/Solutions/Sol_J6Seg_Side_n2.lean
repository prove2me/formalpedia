-- Source module: Solutions.J6SegSideCost4
/-!
# Side costs 4: the eight side costs of one axis, as natural-number polynomials

With `W = 3 wA + wC` (so `wd ≤ W p`), `T = TP6`, `p = pP6`, `β = log₂ lg n`, on an axis with
`AxNum`:
* `n1`: chunk fine exposure `≤ 7 (W+9)² · T p (β+1)`;
* `n2`: `d ·` (`J` fine exposure) `≤ 101 (W+12)² · T p (d + ℓ)`;
* `n3`–`n5`: the selection and the two identity slab passes `≤ 10^10 (W+1) · T p`;
* `n6`: the output slab pass `≤ 10^11 (W+11) · T p + 10^7 · T · fmB(2Z)`, `Z = wd + 2p + 8`;
* `n7`, `n8`: the copy and the swap `≤ 10^9 (W+5)² · T p`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

section ax
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : AxNum P n src D k)
include h

theorem wd_le : axwd6 P n src k ap ≤ Wc ap * pP6 P n := by
  have h1 : ap.pl.wA * axQ6 P n src k ≤ ap.pl.wA * (3 * pP6 P n) := Nat.mul_le_mul_left _ h.Qp
  have h2 : ap.pl.wC ≤ ap.pl.wC * pP6 P n := Nat.le_mul_of_pos_right _ h.p1
  show ap.pl.wA * axQ6 P n src k + ap.pl.wC ≤ (3 * ap.pl.wA + ap.pl.wC) * pP6 P n
  nlinarith

theorem p2 : 2 ≤ pP6 P n := by
  have h2 : 2 * TP6 P n < 2 ^ pP6 P n := Nat.size_le.1 h.sizeT
  have hT := h.p1.trans h.pT
  by_contra hc
  have : 2 ^ pP6 P n ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) (by omega)
  have e : (2 : ℕ) ^ 1 = 2 := by norm_num
  omega

theorem n2_sol_aux :
    dP6 P n * ((axwd6 P n src k ap + 1) *
        (axpre6 P n D k * 1 * 2 ^ axfJ6 P n src k * axpost6 P n D k + 1) * (axfJ6 P n src k + 1) +
      (Nat.size (axpre6 P n D k * 1 * 2 ^ axfJ6 P n src k * axpost6 P n D k) +
        axwd6 P n src k ap + axfJ6 P n src k + 4) ^ 2) ≤
      101 * (Wc ap + 12) ^ 2 * (TP6 P n * pP6 P n * (dP6 P n + ℓP6 P n)) := by
  have hw := wd_le ap h
  have hVJ : dP6 P n * (axpre6 P n D k * 1 * 2 ^ axfJ6 P n src k * axpost6 P n D k) ≤
      99 * TP6 P n := by
    rw [← h.GJ, mul_one]; exact h.VJ
  have hd1 := h.d1
  have hV : axpre6 P n D k * 1 * 2 ^ axfJ6 P n src k * axpost6 P n D k ≤ 99 * TP6 P n :=
    le_trans (Nat.le_mul_of_pos_left _ hd1) hVJ
  have hsz : Nat.size (axpre6 P n D k * 1 * 2 ^ axfJ6 P n src k * axpost6 P n D k) ≤
      pP6 P n + 7 := by
    rw [Nat.size_le]
    have h2 : 2 * TP6 P n < 2 ^ pP6 P n := Nat.size_le.1 h.sizeT
    rw [pow_add]; omega
  have hf := h.fJ
  have hℓ := h.ℓp
  have hpT := h.pT
  have hp1 := h.p1
  have hdT := h.dT
  have hp2 := p2 h
  generalize axpre6 P n D k * 1 * 2 ^ axfJ6 P n src k * axpost6 P n D k = V at *
  generalize axwd6 P n src k ap = wd at *
  generalize axfJ6 P n src k = f at *
  generalize ℓP6 P n = ℓ at *
  generalize dP6 P n = d at *
  generalize TP6 P n = T at *
  generalize pP6 P n = p at *
  generalize Wc ap = W at *
  have eW1 : (W + 1) * p = W * p + p := by ring
  have eW12 : (W + 12) * p = W * p + 12 * p := by ring
  have a1 : d * ((wd + 1) * (V + 1) * (f + 1)) ≤ ((W + 1) * p) * (100 * T) * (ℓ + d) := by
    have : d * (V + 1) ≤ 100 * T := by
      calc d * (V + 1) = d * V + d := by ring
        _ ≤ 99 * T + T := Nat.add_le_add hVJ hdT
        _ = 100 * T := by ring
    calc d * ((wd + 1) * (V + 1) * (f + 1)) = (wd + 1) * (d * (V + 1)) * (f + 1) := by ring
      _ ≤ ((W + 1) * p) * (100 * T) * (ℓ + d) :=
          Nat.mul_le_mul (Nat.mul_le_mul (by rw [eW1]; omega) this) (by omega)
  have a2 : (Nat.size V + wd + f + 4) ^ 2 ≤ ((W + 12) * p) ^ 2 :=
    Nat.pow_le_pow_left (by rw [eW12]; omega) 2
  have a3 : d * ((W + 12) * p) ^ 2 ≤ (W + 12) ^ 2 * (T * p * (d + ℓ)) := by
    have : d * (p * p) ≤ T * p * (d + ℓ) := by
      calc d * (p * p) ≤ d * (T * p) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hpT)
        _ = T * p * d := by ring
        _ ≤ T * p * (d + ℓ) := Nat.mul_le_mul_left _ (by omega)
    calc d * ((W + 12) * p) ^ 2 = (W + 12) ^ 2 * (d * (p * p)) := by ring
      _ ≤ _ := Nat.mul_le_mul_left _ this
  have a4 : ((W + 1) * p) * (100 * T) * (ℓ + d) ≤ 100 * (W + 12) ^ 2 * (T * p * (d + ℓ)) := by
    have : W + 1 ≤ (W + 12) ^ 2 := le_trans (by omega) (Nat.le_self_pow (by norm_num) _)
    calc ((W + 1) * p) * (100 * T) * (ℓ + d) = 100 * (W + 1) * (T * p * (d + ℓ)) := by ring
      _ ≤ _ := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ this)
  have a5 : d * (Nat.size V + wd + f + 4) ^ 2 ≤ d * ((W + 12) * p) ^ 2 := Nat.mul_le_mul_left _ a2
  calc _ = d * ((wd + 1) * (V + 1) * (f + 1)) + d * (Nat.size V + wd + f + 4) ^ 2 := Nat.mul_add _ _ _
    _ ≤ ((W + 1) * p) * (100 * T) * (ℓ + d) + d * ((W + 12) * p) ^ 2 := Nat.add_le_add a1 a5
    _ ≤ 100 * (W + 12) ^ 2 * (T * p * (d + ℓ)) + (W + 12) ^ 2 * (T * p * (d + ℓ)) :=
        Nat.add_le_add a4 a3
    _ = _ := by ring

end ax

end J6Seg.Side
end

