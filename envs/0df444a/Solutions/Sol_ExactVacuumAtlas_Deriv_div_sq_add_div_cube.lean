open Real
open ExactVacuumAtlas
open ExactVacuumAtlas.Deriv
theorem solution (K L r : ℝ) (hr : r ≠ 0) :
    HasDerivAt (fun u => K / u ^ 2 + L / u ^ 3) (-2 * K / r ^ 3 - 3 * L / r ^ 4) r := by
  have h3 : HasDerivAt (fun u => L / u ^ 3) (-3 * L / r ^ 4) r := by
    refine ((hasDerivAt_const r L).fun_div ((hasDerivAt_id' r).fun_pow 3)
      (pow_ne_zero 3 hr)).congr_deriv ?_
    push_cast
    field_simp
    ring
  exact ((div_sq K r hr).fun_add h3).congr_deriv (by ring)
