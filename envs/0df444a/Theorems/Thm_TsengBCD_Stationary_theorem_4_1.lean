-- title:
--   Theorem 4.1, pp. 480–481 — on a compact level set where f is continuous, essentially cyclic BCD is defined and bounded; (a)–(c) on its cluster points
-- statement:
--   Let $f:\mathbb R^{n_1+\cdots+n_N}\to\mathbb R\cup\{\infty\}$ never take the value $-\infty$ and let $x^0\in\operatorname{dom}f$. Assume that the level set
--   $$X^0=\{x: f(x)\le f(x^0)\}$$
--   is compact and that $f$ is continuous on $X^0$. Then the sequence $\{x^r\}_{r=0,1,\dots}$ generated by the BCD method is defined (for every choice of blocks, the minimizations (2) can be carried out), and every such sequence generated with the essentially cyclic rule is bounded. Moreover:
--   1. (a) If $f(x_1,\dots,x_N)$ is pseudoconvex in $(x_k,x_i)$ for every $i,k\in\{1,\dots,N\}$ and $f$ is regular at every $x\in X^0$, then every cluster point of $\{x^r\}$ (essentially cyclic rule) is a stationary point of $f$.
--   2. (b) If $f(x_1,\dots,x_N)$ is pseudoconvex in $(x_k,x_i)$ for every $i,k\in\{1,\dots,N-1\}$, $f$ is regular at every $x\in X^0$, and the cyclic rule is used, then every cluster point of $\{x^r\}_{r\equiv(N-1)\bmod N}$ is a stationary point of $f$.
--   3. (c) If $f(x_1,\dots,x_N)$ has at most one minimum in $x_k$ for $k=2,\dots,N-1$ and the cyclic rule is used, then every cluster point $z$ of $\{x^r\}_{r\equiv(N-1)\bmod N}$ is a coordinatewise minimum point of $f$; if in addition $f$ is regular at $z$, then $z$ is a stationary point of $f$.
--
--   Here $r\equiv(N-1)\bmod N$ means $r=N-1,2N-1,3N-1,\dots$. Theorem 4.1 unifies and extends results of Auslender for the convex nondifferentiable case and of Grippo–Sciandrone, Luenberger and Zadeh for the differentiable case.
--
--   **Formalization Note.** "Defined" is formalized as: for every index sequence a BCD run from $x^0$ exists (stronger than for essentially cyclic sequences only). "$f$ is continuous on $X^0$" is formalized as continuity of $f$, as a map into $\mathbb R\cup\{\infty\}$, at every point of $X^0$; under the weaker reading (continuity of the restriction $f|_{X^0}$) the printed statement is false, by an explicit two-block counterexample given in the mission description. Blocks are 0-based: paper block $k$ is Lean index $k-1$, $\{1,\dots,N-1\}$ is $\{k: k<N-1\}$, $\{2,\dots,N-1\}$ is $\{k: 1\le k<N-1\}$. `s r` is the block chosen at iteration $r+1$; the cyclic rule is `s r = r mod N`; the subsequence $r\equiv(N-1)\bmod N$ is $m\mapsto x^{Nm+(N-1)}$. Pseudoconvexity in $(x_k,x_i)$ and "at most one minimum in $x_k$" are read blockwise, as defined in the definitions item.
-- source:
--   Tseng, Convergence of a block coordinate descent method for nondifferentiable minimization, J. Optim. Theory Appl. 109 (2001), pp. 480–481, Theorem 4.1

import Mathlib
import Definitions.Def_TsengBCD_Stationary_Setting

namespace TsengBCD.Stationary

open Filter Topology

theorem theorem_4_1 {N : ℕ} [NeZero N] {n : Fin N → ℕ} (f : X n → EReal)
    (hbot : ∀ x, f x ≠ ⊥) (x0 : X n) (hx0 : f x0 ≠ ⊤) (hcpt : IsCompact (levelSet f x0))
    (hcont : ∀ y ∈ levelSet f x0, ContinuousAt f y) :
    -- defined: for every index sequence a BCD run from x⁰ exists
    (∀ s : ℕ → Fin N, ∃ x : ℕ → X n, x 0 = x0 ∧ IsBCDRun f s x) ∧
    -- bounded
    (∀ (s : ℕ → Fin N) (x : ℕ → X n), IsEssCyclic s → x 0 = x0 → IsBCDRun f s x →
      Bornology.IsBounded (Set.range x)) ∧
    -- (a)
    ((∀ i k : Fin N, PseudoconvexIn f {k, i}) → (∀ y ∈ levelSet f x0, IsRegularAt f y) →
      ∀ (s : ℕ → Fin N) (x : ℕ → X n), IsEssCyclic s → x 0 = x0 → IsBCDRun f s x →
        ∀ z, MapClusterPt z atTop x → IsStationary f z) ∧
    -- (b)
    ((∀ i k : Fin N, i.val < N - 1 → k.val < N - 1 → PseudoconvexIn f {k, i}) →
      (∀ y ∈ levelSet f x0, IsRegularAt f y) →
      ∀ (s : ℕ → Fin N) (x : ℕ → X n), IsCyclic s → x 0 = x0 → IsBCDRun f s x →
        ∀ z, MapClusterPt z atTop (fun m : ℕ => x (N * m + (N - 1))) → IsStationary f z) ∧
    -- (c)
    ((∀ k : Fin N, 1 ≤ k.val → k.val < N - 1 → AtMostOneMinIn f k) →
      ∀ (s : ℕ → Fin N) (x : ℕ → X n), IsCyclic s → x 0 = x0 → IsBCDRun f s x →
        ∀ z, MapClusterPt z atTop (fun m : ℕ => x (N * m + (N - 1))) →
          IsCoordMin f z ∧ (IsRegularAt f z → IsStationary f z)) := by sorry

end TsengBCD.Stationary
