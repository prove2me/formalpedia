-- Source module: Solutions.J6SegILSlab4
/-!
# B-line IL, B1 (streaming slab pass) §4: the whole pass (generic lanes)

`passP = rptX rNB blockP; rptX rTOT (mv rACC 0)`: the blocks, then the output (collected
reversed on `rACC`) is moved onto stack `0`. **`pass_runs`**: from the lane state with the input
`xs` (`pre` blocks of `n` slabs of `m` units) the output `passOut … ++ G 0` lands on stack `0`; all
skeleton registers are restored (`rACC` empty again). **`passOut_eq`**: for the control list
`ctlOf n n' src argOf` of a monotone source, `passOut` is `slabPass` (block form).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD)
open NLogN.KFT (cf3 rptX)

theorem skS_upd_other (G : Fin HS → List ℤ) (C CU OP ARG ACC : List ℤ) {j : Fin HS}
    (h1 : j ≠ rC) (h2 : j ≠ rCU) (h3 : j ≠ rOP) (h4 : j ≠ rARG) (h5 : j ≠ rACC) (w : List ℤ) :
    update (skS G C CU OP ARG ACC) j w = skS (update G j w) C CU OP ARG ACC := by
  funext x; simp only [skS, update_apply]; split_ifs <;> simp_all

