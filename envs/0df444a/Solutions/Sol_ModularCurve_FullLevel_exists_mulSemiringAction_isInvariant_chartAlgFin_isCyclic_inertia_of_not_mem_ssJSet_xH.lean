theorem Gamma_le_GammaH (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) :
    Gamma M ≤ CohCarrier.GammaH M H := by
  intro A hA
  rw [CohCarrier.mem_GammaH_iff]
  have hA' := Gamma_mem.mp hA
  have h0 : A ∈ Gamma0 M := by rw [Gamma0_mem]; exact hA'.2.2.1
  refine ⟨h0, ?_⟩
  have : CohCarrier.gamma0Units M ⟨A, h0⟩ = 1 := by
    ext
    rw [CohCarrier.val_gamma0Units]
    show ((A 1 1 : ℤ) : ZMod M) = ((1 : (ZMod M)ˣ) : ZMod M)
    rw [hA'.2.2.2, Units.val_one]
  rw [this]
  exact one_mem H

theorem GammaH_finiteIndex (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) :
    (CohCarrier.GammaH M H).FiniteIndex :=
  Subgroup.finiteIndex_of_le (Gamma_le_GammaH M H)

theorem mem_nonunits_comap_iff {K₁ K₂ : Type*} [Field K₁] [Field K₂] (W : ValuationSubring K₂) (f : K₁ →+* K₂) (x : K₁) :
    x ∈ (W.comap f).nonunits ↔ f x ∈ W.nonunits := by
  rw [ValuationSubring.mem_nonunits_iff_or, ValuationSubring.mem_nonunits_iff_or, ValuationSubring.mem_comap,
    map_inv₀, map_eq_zero]

theorem isUnit_natCast_of_dvd_sub_one {A : Type*} [CommRing A] [IsLocalRing A] (q e : ℕ) (hq : 1 ≤ q)
    (hAq : (q : A) ∈ IsLocalRing.maximalIdeal A) (he : e ∣ q - 1) : IsUnit ((e : ℕ) : A) := by
  obtain ⟨k, hk⟩ := he
  have h1 : IsUnit ((q : A) - 1) := by
    have := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits (q : A) ((IsLocalRing.mem_maximalIdeal _).mp hAq)
    rw [← IsUnit.neg_iff, neg_sub] at this
    exact this
  have h2 : ((e : ℕ) : A) * (k : A) = (q : A) - 1 := by
    rw [← Nat.cast_mul, ← hk, Nat.cast_sub hq, Nat.cast_one]
  exact isUnit_of_mul_isUnit_left (h2 ▸ h1)

