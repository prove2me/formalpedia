-- title:
--   Proposition 2.4 (All-Hermitian degrees one, two, and three)
-- statement:
--   In the formal partition coefficient spaces, without imposing any fixed-dimensional identities,
--   $$I_1^{\rm all}=I_3^{\rm all}=\{0\},\qquad I_2^{\rm all}=\operatorname{cone}\{[2],[1^2]\}.$$
--   The last cone has exactly the two rays generated by $[2]$ and $[1^2]$. This is an exhaustive dimension-free classification.
--
--   For a partition $\lambda$, the symbol $[\lambda]$ denotes a formal basis element evaluated as $\prod_j\operatorname{Tr}(X^{\lambda_j})$. Distinct formal coefficients are not identified by any fixed-dimensional trace identity.
-- source:
--   Optimal entanglement criteria from trace invariants, arXiv:2609.29471v1, PDF p. 10, Proposition 2.4 (All-Hermitian degrees one, two, and three)

import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P19

noncomputable section

open scoped BigOperators ENNReal Matrix ComplexConjugate ComplexOrder

open Filter MeasureTheory

namespace QAlgorithms.Papers.Independent.Information100.P19

/-- Proposition 2.4 (All-Hermitian degrees one, two, and three); arXiv:2609.29471v1, PDF pp.10. -/
theorem hermitian_small_degrees  :
    allCone 1 = {0} ∧ allCone 3 = {0} ∧
    allCone 2 = finiteCone ({b2,b11} : Set (Coeff 2)) ∧
    extremeRays (allCone 2) = {ray b2, ray b11} := by sorry

end QAlgorithms.Papers.Independent.Information100.P19

end
