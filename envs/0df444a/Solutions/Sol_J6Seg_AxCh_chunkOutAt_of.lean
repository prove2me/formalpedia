set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

/-! ## The chunk on pairs, per-block records -/

section chunk
variable (P : ℕ) (di gi gam dd : List ℤ)

theorem liftG_chunkL2 :
    ∀ (ds : List (ℕ × List ℤ × List ℤ)) (z : List (ℤ × ℤ)),
      (∀ d ∈ ds, d.1 ≤ di.length ∧ d.1 ≤ gi.length ∧ d.1 ≤ gam.length ∧ d.1 ≤ dd.length ∧
        d.1 ≤ d.2.1.length ∧ d.1 ≤ d.2.2.length) →
      liftG (chunkL P di gi gam dd ds) z = chunkG2 P di gi gam dd ds z
  | [], z, _ => by
    unfold liftG chunkL chunkG2 chunkB sumN
    simp only [List.drop_zero, List.nil_append]
    induction z with
    | nil => rfl
    | cons w z ih => simp only [List.map_cons, List.zip_cons_cons]; rw [ih]
  | (n, am, ap) :: ds, z, hds => by
    have hn := hds (n, am, ap) (List.mem_cons_self ..)
    obtain ⟨h1, h2, h3, h4, h5, h6⟩ := hn
    simp only at h1 h2 h3 h4 h5 h6
    have e : chunkL P di gi gam dd ((n, am, ap) :: ds) =
        fun y => blkL P di gi gam dd am ap (y.take n) ++ chunkL P di gi gam dd ds (y.drop n) := rfl
    have hzn : (z.take n).length ≤ n := by simp
    rw [e, liftG_append _ _ (lp_blkL P _ _ _ _ _ _),
      liftG_blkL P (r := 2 * n) (z.take n) (by omega) (by omega) (by omega) (by omega) (by omega)
        (by omega) (by omega),
      liftG_chunkL2 ds (z.drop n) (fun d hd => hds d (List.mem_cons_of_mem _ hd))]
    simp only [chunkG2, chunkB, sumN, List.append_assoc, List.drop_drop]
    try rw [Nat.add_comm n (sumN ds)]

end chunk

/-! ## Growth of the stage values -/

lemma Xs_nonneg {K X : ℤ} (hK : 0 ≤ K) (hX : 0 ≤ X) : ∀ i, 0 ≤ Xs K X i
  | 0 => hX
  | i + 1 => by have := Xs_nonneg hK hX i; simp only [Xs]; positivity

end J6Seg.KR

