/-- **Lemma 3.2** in the paper's exact form, with lattice points and `1`-favoured
indices. -/
theorem solution {Γ : QFS.Configuration (EuclideanSpace ℝ (Fin d))} {θ : ℝ}
    (F : QFS.RefFamily Γ θ) {x y v w s t : EuclideanSpace ℝ (Fin d)}
    (_hx : x ∈ QFS.lattice d) (_hy : y ∈ QFS.lattice d)
    (_hv : QFS.IsFavoured F 1 x v) (_hw : QFS.IsFavoured F 1 y w)
    (hs : s ∈ QFS.cubeCone Γ (F.cone v) 1 x) (ht : t ∈ QFS.cubeCone Γ (F.cone w) 1 y) :
    QFS.ind (QFS.shift (QFS.shrink (F.cone v) (Real.sqrt d / 2)) x) t
        + QFS.ind (QFS.shift (QFS.shrink (F.cone w) (Real.sqrt d / 2)) y) s
      ≥ QFS.ind (QFS.shift (QFS.shrink (F.cone v) (Real.sqrt d)) x) y
        + QFS.ind (QFS.shift (QFS.shrink (F.cone w) (Real.sqrt d)) y) x :=
  QFS.lemma_min_dist hs.1 ht.1
