theorem solution (s : NLogN.IState NLogN.HS) (F : Fin NLogN.HS → List ℤ) (v : Fin NLogN.HS → ℕ) {M B : ℕ}
    (hM : NLogN.zsz (M : ℤ) ≤ B) (hv : ∀ i ∈ NLogN.KIL.regD, v i ≤ M) (x b z t : NLogN.KIL.NE)
    (hx : NLogN.KIL.PadE F v M x) (hb : NLogN.KIL.PadE F v M b) (hz : NLogN.KIL.PadE F v M z) (ht : NLogN.KIL.PadE F v M t)
    {X Fa Fb Y : ℕ} (vx : x.val v = X) (vb : b.val v = Fa * Y) (vz : z.val v = (Fb - Fa) * Y)
    (vt : t.val v = X * (Fa * Y)) (hF : Fa ≤ Fb) (hF1 : 1 ≤ Fb) (hY : 1 ≤ Y)
    (hVM : X * (Fb * Y) ≤ M)
    (ys : List ℤ) (h0 : F 0 = ys) (h15 : F 15 = []) (h20 : F 20 = []) (h21 : F 21 = [])
    (hys : ys.length = X * (Fb * Y)) (hbd : NLogN.Bnd B ys) :
    NLogN.KIL.Sp (NLogN.KIL.unpadS x b z t) (NLogN.KIL.encK s (NLogN.KIL.regState F v NLogN.KIL.regD))
      (NLogN.KIL.encK s (NLogN.KIL.regState (Function.update F 0 (NLogN.KIL.unpadL X Fa Fb Y ys)) (NLogN.KIL.padV v X (Fa * Y)
        ((Fb - Fa) * Y) (X * (Fa * Y))) NLogN.KIL.regD))
      ((x.size + b.size + z.size + t.size + 5) * 10 ^ 7 * (B + 2) ^ 2 + NLogN.KIL.cPad (X * (Fb * Y)) B) := by
  have S1 := NLogN.KIL.Sp.asgs s F NLogN.KIL.regD hM (NLogN.KIL.padAsg x b z t) v (NLogN.KIL.okA_padAsg x b z t v hv hx hb hz ht)
  rw [NLogN.KIL.evalA_padAsg x b z t v hx hb hz ht, vx, vb, vz, vt, NLogN.KIL.szA_padAsg] at S1
  set v' := NLogN.KIL.padV v X (Fa * Y) ((Fb - Fa) * Y) (X * (Fa * Y)) with hv'
  have S2 := NLogN.KIL.unpadP_sp s (NLogN.KIL.regState F v' NLogN.KIL.regD) (X := X) (F := Fa) (F' := Fb) (Y := Y) ys [] hF hF1
    hY hys B hbd (le_trans (NLogN.KIL.zsz_nat_le hVM) hM)
    (by rw [NLogN.KIL.regState_nmem (by decide), h0, List.append_nil])
    (by rw [NLogN.KIL.regState_nmem (by decide), h15]) (by rw [NLogN.KIL.regState_nmem (by decide), h20])
    (by rw [NLogN.KIL.regState_nmem (by decide), h21])
    (L1 := NLogN.ints (F NLogN.KIL.pX) ++ s.G NLogN.KIL.pX) (L2 := NLogN.ints (F NLogN.KIL.pB) ++ s.G NLogN.KIL.pB) (L3 := NLogN.ints (F NLogN.KIL.pZ) ++ s.G NLogN.KIL.pZ)
    (L4 := NLogN.ints (F NLogN.KIL.pT) ++ s.G NLogN.KIL.pT)
    (NLogN.KIL.encK_G_cons s (NLogN.KIL.regState_mem (by decide)))
    (NLogN.KIL.encK_G_cons s (NLogN.KIL.regState_mem (by decide)))
    (NLogN.KIL.encK_G_cons s (NLogN.KIL.regState_mem (by decide)))
    (NLogN.KIL.encK_G_cons s (NLogN.KIL.regState_mem (by decide)))
  rw [List.append_nil, NLogN.KIL.regState_upd_nmem _ _ (by decide)] at S2
  exact S1.seq S2
end
