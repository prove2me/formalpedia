-- title:
--   Admissible triples, formal expressions $\mathcal F$ over $P_{x,y,z}$, leg renumbering, and the shorthands $\langle 1\rangle$, $\langle r\rangle$, $\langle n_1,n_2,n_3\rangle$ (Definitions 5.1–5.2)
-- statement:
--   A triple $(x,y,z)$ of real numbers $x,y,z\ge 1$ is **admissible** if
--   $$x+y+z = 2\max(x,y,z)+1,$$
--   that is, its largest entry is the sum of the other two minus $1$ (Definition 5.1). For an admissible triple of positive integers, $P_{x,y,z}$ is a generator symbol; it stands for a tensor with leg dimensions $(x,y,z)$ (a permuted polynomial multiplication tensor), but only these leg dimensions matter here.
--
--   The set $\mathcal F$ of **formal expressions** (Definition 5.2) is generated by the symbols $P_{x,y,z}$, for all admissible triples of positive integers, under the binary operations $\oplus$ (direct sum), $\otimes$ (tensor product) and $\oplus_1,\oplus_2,\oplus_3$ (partial direct sums), where $S\oplus_i T$ is allowed only if the $i$-th legs of $S$ and $T$ have the same dimension. The **leg dimensions** of an expression are those of the tensor it represents: $P_{x,y,z}$ has $(x,y,z)$; $\oplus$ adds them leg by leg; $\otimes$ multiplies them; $S\oplus_i T$ keeps the common $i$-th dimension and adds the other two. Expressions are formal: distinct expressions are never identified, even when they represent the same tensor.
--
--   **Renumbering the legs** by a permutation $\pi$ of $\{1,2,3\}$ moves leg $s$ to leg $\pi(s)$: every $P_{d_1,d_2,d_3}$ becomes the generator whose $\pi(s)$-th index is $d_s$, every $\oplus_i$ becomes $\oplus_{\pi(i)}$, and $\oplus,\otimes$ are unchanged.
--
--   Shorthands: $\langle 1\rangle := P_{1,1,1}$; for a positive integer $r$, $\langle r\rangle$ is the direct sum of $r$ copies of $\langle 1\rangle$; and $\langle n_1,n_2,n_3\rangle := P_{n_1,1,n_1}\otimes P_{n_2,n_2,1}\otimes P_{1,n_3,n_3}$.
--
--   An expression $E$ is a **bracketing of the sum** $T_1\ \mathrm{op}\ \cdots\ \mathrm{op}\ T_m$ of a nonempty list (for $\mathrm{op}=\oplus$ or $\oplus_i$) if it is obtained by combining the $T_i$, in this order, with $\mathrm{op}$ in some bracketing.
--
--   **Formalization Note.** `FExpr` is the inductive type with constructors `P x y z` ($x,y,z\in\mathbb N$), `dsum` ($\oplus$), `tens` ($\otimes$) and `psum i` ($\oplus_{i+1}$; legs are `Fin 3`, so the paper's legs $1,2,3$ are `0,1,2`). `FExpr.dims` gives the leg dimensions and `FExpr.WF E` says $E\in\mathcal F$ (all generators admissible, all partial sums with matching shared legs). `FExpr.perm π` is the leg renumbering. `unitOne` is $\langle1\rangle$, `unitR r` is $\langle r\rangle$ bracketed to the left (`unitCopies (r-1)`, used only for $r\ge1$), `mm n₁ n₂ n₃` is $\langle n_1,n_2,n_3\rangle$ bracketed as $(P_{n_1,1,n_1}\otimes P_{n_2,n_2,1})\otimes P_{1,n_3,n_3}$. `IsSumTree op E L` says $E$ is a bracketing of the `op`-sum of the list `L` in order.
-- source:
--   Amanov, van den Berg, Zuiddam, Multiplying matrices via polynomials: operational asymptotic spectrum barrier, STOC 2027 submission (manuscript sha256 38bd5183…), p. 35, Definition 5.1; p. 36, Definition 5.2; p. 12 (§2.1) and p. 36 (leg renumbering)

import Mathlib

set_option autoImplicit false

/-!
# Formal expressions over admissible triples (Definitions 5.1–5.2)

Amanov, van den Berg, Zuiddam, *Multiplying matrices via polynomials: operational asymptotic
spectrum barrier*, STOC 2027 submission, p. 35 (Definition 5.1), p. 36 (Definition 5.2), and the
leg-renumbering convention of p. 12 (§2.1) and p. 36 (Definition 5.3).

Conventions.
* Legs are indexed by `Fin 3`: the paper's legs 1, 2, 3 are `0`, `1`, `2`. So the paper's `⊕₁`
  is `psum 0`, `⊕₂` is `psum 1`, `⊕₃` is `psum 2`.
* `P x y z` is the generator symbol `P_{x,y,z}`; it is well formed only for an admissible triple of
  positive integers. Only its leg dimensions `(x, y, z)` enter the statements.
* `dims E s` is the dimension of leg `s` of the tensor that `E` represents: `P_{x,y,z}` has
  `(x, y, z)`, `⊕` adds, `⊗` multiplies, and `S ⊕ᵢ T` keeps the shared `i`-th leg and adds the
  other two.
* `WF E` says that `E` lies in the set `F` of Definition 5.2: every generator is admissible and
  every `S ⊕ᵢ T` has equal `i`-th legs.
* Expressions are formal: distinct expressions are never identified.
-/

namespace MatMulPolyBarrier.Operational

/-- Definition 5.1 (p. 35): a triple of real numbers `x, y, z ≥ 1` is admissible if
`x + y + z = 2 max(x, y, z) + 1`. -/
def IsAdmissible (x y z : ℝ) : Prop :=
  1 ≤ x ∧ 1 ≤ y ∧ 1 ≤ z ∧ x + y + z = 2 * max (max x y) z + 1

/-- Formal expressions (Definition 5.2(i), p. 36): generated by the symbols `P_{x,y,z}` under
`⊕` (`dsum`), `⊗` (`tens`) and the partial direct sums `⊕ᵢ` (`psum i`, legs `i : Fin 3`). -/
inductive FExpr : Type
  | P : ℕ → ℕ → ℕ → FExpr
  | dsum : FExpr → FExpr → FExpr
  | tens : FExpr → FExpr → FExpr
  | psum : Fin 3 → FExpr → FExpr → FExpr

namespace FExpr

/-- Leg dimensions of the tensor an expression represents (p. 36, §2.1): `P_{x,y,z}` has legs
`(x, y, z)`; direct sum adds, tensor product multiplies; `S ⊕ᵢ T` shares leg `i` and adds the
other two legs. -/
def dims : FExpr → Fin 3 → ℕ
  | P x y z => ![x, y, z]
  | dsum S T => fun s => dims S s + dims T s
  | tens S T => fun s => dims S s * dims T s
  | psum i S T => fun s => if s = i then dims S s else dims S s + dims T s

/-- `E ∈ F` (Definition 5.2(i)): every generator `P_{x,y,z}` has an admissible triple of positive
integers, and `S ⊕ᵢ T` occurs only when the `i`-th legs of `S` and `T` have the same dimension. -/
def WF : FExpr → Prop
  | P x y z => IsAdmissible (x : ℝ) (y : ℝ) (z : ℝ)
  | dsum S T => WF S ∧ WF T
  | tens S T => WF S ∧ WF T
  | psum i S T => WF S ∧ WF T ∧ dims S i = dims T i

/-- Renumbering the legs by `π ∈ S₃` (pp. 12, 36): the `s`-th leg becomes the `π(s)`-th leg, so
the indices of every `P` are permuted (`P_{d₁,d₂,d₃}` becomes the generator whose `π(s)`-th index
is `d_s`) and every `⊕ᵢ` becomes `⊕_{π(i)}`; `⊕` and `⊗` are unchanged. -/
def perm (π : Equiv.Perm (Fin 3)) : FExpr → FExpr
  | P x y z =>
      let d : Fin 3 → ℕ := ![x, y, z]
      P (d (π.symm 0)) (d (π.symm 1)) (d (π.symm 2))
  | dsum S T => dsum (perm π S) (perm π T)
  | tens S T => tens (perm π S) (perm π T)
  | psum i S T => psum (π i) (perm π S) (perm π T)

/-- `E` is a bracketing of the iterated sum `L₁ op L₂ op ⋯ op L_m` of the nonempty list `L`, with
the summands in the order of `L` (any bracketing). Used with `op = dsum` for
`T₁ ⊕ ⋯ ⊕ T_m` and with `op = psum i` for `T₁ ⊕ᵢ ⋯ ⊕ᵢ T_m`. -/
inductive IsSumTree (op : FExpr → FExpr → FExpr) : FExpr → List FExpr → Prop
  | leaf (T : FExpr) : IsSumTree op T [T]
  | node {E₁ E₂ : FExpr} {L₁ L₂ : List FExpr} :
      IsSumTree op E₁ L₁ → IsSumTree op E₂ L₂ → IsSumTree op (op E₁ E₂) (L₁ ++ L₂)

end FExpr

open FExpr

/-- `⟨1⟩ := P_{1,1,1}` (Definition 5.2(ii)). -/
def unitOne : FExpr := P 1 1 1

/-- `unitCopies n` is the direct sum of `n + 1` copies of `⟨1⟩`, bracketed to the left:
`((⟨1⟩ ⊕ ⟨1⟩) ⊕ ⋯) ⊕ ⟨1⟩`. -/
def unitCopies : ℕ → FExpr
  | 0 => unitOne
  | n + 1 => dsum (unitCopies n) unitOne

/-- `⟨r⟩` for a positive integer `r` (Definition 5.2(iii)): the direct sum of `r` copies of
`⟨1⟩` (left bracketing). Only used for `r ≥ 1`. -/
def unitR (r : ℕ) : FExpr := unitCopies (r - 1)

/-- `⟨n₁, n₂, n₃⟩ := P_{n₁,1,n₁} ⊗ P_{n₂,n₂,1} ⊗ P_{1,n₃,n₃}` (Definition 5.2(iv)), bracketed to
the left. -/
def mm (n₁ n₂ n₃ : ℕ) : FExpr := tens (tens (P n₁ 1 n₁) (P n₂ n₂ 1)) (P 1 n₃ n₃)

end MatMulPolyBarrier.Operational


