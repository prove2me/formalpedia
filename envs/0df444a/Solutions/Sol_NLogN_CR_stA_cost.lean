theorem par_b (K N : ℕ) : (mkParams K N).b = Nat.size N := rfl
theorem par_L (K N : ℕ) : (mkParams K N).L = (N + Nat.size N - 1) / Nat.size N := rfl
theorem par_e (K N : ℕ) : (mkParams K N).e = (parEx K N + K - 1) / K := rfl
theorem par_dh (K N : ℕ) : (mkParams K N).dh = K * (mkParams K N).e - parEx K N := rfl

theorem par_b_pos (K N : ℕ) (hN : 1 ≤ N) : 1 ≤ (mkParams K N).b := by
  rw [par_b]; exact Nat.size_pos.2 (by omega)

theorem par_L_pos (K N : ℕ) (hN : 1 ≤ N) : 1 ≤ (mkParams K N).L := by
  have hb := par_b_pos K N hN
  rw [par_L]; rw [par_b] at hb
  exact (Nat.le_div_iff_mul_le (by omega)).2 (by omega)

theorem par_L_le (K N : ℕ) (hN : 1 ≤ N) : (mkParams K N).L ≤ N := by
  have hb := par_b_pos K N hN
  rw [par_L]; rw [par_b] at hb
  refine (Nat.div_le_iff_le_mul_add_pred (by omega)).2 ?_
  have : N ≤ Nat.size N * N := Nat.le_mul_of_pos_left N (by omega)
  omega

theorem parE_ge (K N : ℕ) (hN : 1 ≤ N) : 2 ≤ parEx K N := by
  have hL := par_L_pos K N hN
  unfold parEx
  by_contra h
  push_neg at h
