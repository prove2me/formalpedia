theorem heckeDivisorAction_transpose_eq_mulVec {ι : Type*} [Fintype ι] (B : Matrix ι ι ℤ) (D : ι → ℤ) :
    heckeDivisorAction B.transpose D = B.mulVec D := by
  funext j
  simp [heckeDivisorAction_apply, Matrix.mulVec, dotProduct, Matrix.transpose_apply]

theorem heckeCharacterAction_transpose_coe {ι : Type*} [Fintype ι] (B : Matrix ι ι ℤ) {n : ℤ}
    (h : HeckeRowSums B.transpose n) (D : characterLattice ι) :
    (heckeCharacterAction B.transpose h D : ι → ℤ) = B.mulVec (D : ι → ℤ) := by
  rw [heckeCharacterAction_coe, heckeDivisorAction_transpose_eq_mulVec]

noncomputable def pushChar {E V : Type*} [Fintype E] [Fintype V] [DecidableEq V] (f : E → V) :
    characterLattice E →ₗ[ℤ] characterLattice V :=
  ((CerednikDrinfeld.pushforward f).comp (characterLattice E).subtype).codRestrict (characterLattice V)
    (fun x => by
      show degreeOn V (CerednikDrinfeld.pushforward f (x : E → ℤ)) = 0
      rw [CerednikDrinfeld.degreeOn_pushforward]
      exact x.2)

@[scoped simp] theorem pushChar_coe {E V : Type*} [Fintype E] [Fintype V] [DecidableEq V] (f : E → V)
    (x : characterLattice E) :
    (pushChar f x : V → ℤ) = (CerednikDrinfeld.degeneracyMatrix f).mulVec (x : E → ℤ) := rfl

theorem five_le_of_dvd_sub_one {p q : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hq : q.Prime)
    (hq1 : (p : ℤ) ∣ (q : ℤ) - 1) : 5 ≤ q := by
  have hp3 : 3 ≤ p := by have := hp.two_le; omega
  have hq2 : 2 ≤ q := hq.two_le
  have hdvd : p ∣ q - 1 := by
    rw [show (q : ℤ) - 1 = ((q - 1 : ℕ) : ℤ) by omega] at hq1
    exact Int.natCast_dvd_natCast.mp hq1
  have hle : p ≤ q - 1 := Nat.le_of_dvd (by omega) hdvd
  have hq4 : q ≠ 4 := by
    rintro rfl
    exact absurd hq (by norm_num)
  omega

theorem heckeKernelMap_coe {E V : Type*} [Fintype E] [Fintype V] [DecidableEq V]
    {D : CerednikDrinfeld.DegeneracyData E V} (H : CerednikDrinfeld.HeckeData D) (ℓ : Nat.Primes)
    (x : ↥(CerednikDrinfeld.ribbonKernel D)) :
    (CerednikDrinfeld.heckeKernelMap H ℓ x : E → ℤ) = (H.T ℓ).mulVec (x : E → ℤ) := rfl

theorem presentation {E V : Type} [Fintype E] [Fintype V] [DecidableEq E] [DecidableEq V]
    (D : CerednikDrinfeld.DegeneracyData E V)
    (T₁ : Nat.Primes → Matrix E E ℤ) (T₂ : Nat.Primes → Matrix V V ℤ) (s : Nat.Primes)
    (n₁ : Nat.Primes → ℤ) (hcol₁ : ∀ ℓ : Nat.Primes, HeckeRowSums (T₁ ℓ).transpose (n₁ ℓ))
    (hia : ∀ ℓ : Nat.Primes, (ℓ : ℕ) ≠ s →
      CerednikDrinfeld.degeneracyMatrix D.a * T₁ ℓ = T₂ ℓ * CerednikDrinfeld.degeneracyMatrix D.a)
    (hib : ∀ ℓ : Nat.Primes, (ℓ : ℕ) ≠ s →
      CerednikDrinfeld.degeneracyMatrix D.b * T₁ ℓ = T₂ ℓ * CerednikDrinfeld.degeneracyMatrix D.b)
    (hUa : ∀ y : E → ℤ,
      (CerednikDrinfeld.degeneracyMatrix D.a).mulVec ((T₁ s).mulVec y) =
        (T₂ s).mulVec ((CerednikDrinfeld.degeneracyMatrix D.a).mulVec y) -
          (CerednikDrinfeld.degeneracyMatrix D.b).mulVec y)
    (hUb : ∀ y : E → ℤ,
      (CerednikDrinfeld.degeneracyMatrix D.b).mulVec ((T₁ s).mulVec y) =
        ((s : ℕ) : ℤ) • (CerednikDrinfeld.degeneracyMatrix D.a).mulVec y)
    (hsurj : ∀ x y : V → ℤ, x ∈ characterLattice V → y ∈ characterLattice V →
      ∃ w : E → ℤ, w ∈ characterLattice E ∧
        (CerednikDrinfeld.degeneracyMatrix D.a).mulVec w = x ∧ (CerednikDrinfeld.degeneracyMatrix D.b).mulVec w = y)
    (Yo : Type) [AddCommGroup Yo] [Module HeckeAlg Yo]
    (eY : Yo ≃+ ↥(CerednikDrinfeld.ribbonKernel D))
    (hY : ∀ (ℓ : Nat.Primes) (m : Yo),
      ((eY (heckeGen ℓ • m) : ↥(CerednikDrinfeld.ribbonKernel D)) : E → ℤ) =
        (T₁ ℓ).mulVec ((eY m : ↥(CerednikDrinfeld.ribbonKernel D)) : E → ℤ))
    (Xo : Type) [AddCommGroup Xo] [Module HeckeAlg Xo]
    (eX : Xo ≃+ (↥(characterLattice V) × ↥(characterLattice V)))
    (hT : ∀ ℓ : Nat.Primes, (ℓ : ℕ) ≠ s → ∀ x : Xo,
        ((eX (heckeGen ℓ • x)).1 : V → ℤ) = (T₂ ℓ).mulVec ((eX x).1 : V → ℤ) ∧
        ((eX (heckeGen ℓ • x)).2 : V → ℤ) = (T₂ ℓ).mulVec ((eX x).2 : V → ℤ))
    (hU : ∀ x : Xo,
        ((eX (heckeGen s • x)).1 : V → ℤ) = (T₂ s).mulVec ((eX x).1 : V → ℤ) - ((eX x).2 : V → ℤ) ∧
        ((eX (heckeGen s • x)).2 : V → ℤ) = ((s : ℕ) : ℤ) • ((eX x).1 : V → ℤ)) :
    ∃ (φ : Yo →+ ↥(characterLattice E)) (πL : ↥(characterLattice E) →+ Xo),
      (∀ (ℓ : Nat.Primes) (z : Yo), φ (heckeGen ℓ • z) = heckeCharacterAction (T₁ ℓ).transpose (hcol₁ ℓ) (φ z)) ∧
      Function.Surjective πL ∧
      (∀ (ℓ : Nat.Primes) (x : ↥(characterLattice E)),
        πL (heckeCharacterAction (T₁ ℓ).transpose (hcol₁ ℓ) x) = heckeGen ℓ • πL x) ∧
      (∀ x : ↥(characterLattice E), πL x = 0 → x ∈ AddMonoidHom.range φ) := by

  let φ : Yo →+ ↥(characterLattice E) :=
    (Submodule.inclusion (CerednikDrinfeld.ribbonKernel_le_characterLattice D)).toAddMonoidHom.comp
      eY.toAddMonoidHom
  have hφ_coe : ∀ z : Yo, (φ z : E → ℤ) = ((eY z : ↥(CerednikDrinfeld.ribbonKernel D)) : E → ℤ) :=
    fun z => rfl

  let πL : ↥(characterLattice E) →+ Xo :=
    eX.symm.toAddMonoidHom.comp ((pushChar D.a).prod (pushChar D.b)).toAddMonoidHom
  have hπL1 : ∀ x : ↥(characterLattice E),
      ((eX (πL x)).1 : V → ℤ) = (CerednikDrinfeld.degeneracyMatrix D.a).mulVec (x : E → ℤ) := by
    intro x
    show ((eX (eX.symm ((pushChar D.a).prod (pushChar D.b) x))).1 : V → ℤ) = _
    rw [AddEquiv.apply_symm_apply]
    rfl
  have hπL2 : ∀ x : ↥(characterLattice E),
      ((eX (πL x)).2 : V → ℤ) = (CerednikDrinfeld.degeneracyMatrix D.b).mulVec (x : E → ℤ) := by
    intro x
    show ((eX (eX.symm ((pushChar D.a).prod (pushChar D.b) x))).2 : V → ℤ) = _
    rw [AddEquiv.apply_symm_apply]
    rfl
  refine ⟨φ, πL, ?_, ?_, ?_, ?_⟩
  ·
    intro ℓ z
    apply Subtype.ext
    rw [heckeCharacterAction_transpose_coe, hφ_coe, hφ_coe, hY ℓ z]
  ·
    intro t
    obtain ⟨w, hw, hwa, hwb⟩ := hsurj ((eX t).1 : V → ℤ) ((eX t).2 : V → ℤ) (eX t).1.2 (eX t).2.2
    refine ⟨⟨w, hw⟩, eX.injective (Prod.ext (Subtype.ext ?_) (Subtype.ext ?_))⟩
    · rw [hπL1]; exact hwa
    · rw [hπL2]; exact hwb
  ·
    intro ℓ x
    apply eX.injective
    by_cases hℓ : (ℓ : ℕ) = s
    ·
      have hℓs : ℓ = s := Subtype.ext hℓ
      subst hℓs
      obtain ⟨h1, h2⟩ := hU (πL x)
      refine Prod.ext (Subtype.ext ?_) (Subtype.ext ?_)
      · rw [hπL1, heckeCharacterAction_transpose_coe, h1, hπL1, hπL2]
        exact hUa _
      · rw [hπL2, heckeCharacterAction_transpose_coe, h2, hπL1]
        exact hUb _
    ·
      obtain ⟨h1, h2⟩ := hT ℓ hℓ (πL x)
      refine Prod.ext (Subtype.ext ?_) (Subtype.ext ?_)
      · rw [hπL1, heckeCharacterAction_transpose_coe, h1, hπL1, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
          hia ℓ hℓ]
      · rw [hπL2, heckeCharacterAction_transpose_coe, h2, hπL2, Matrix.mulVec_mulVec, Matrix.mulVec_mulVec,
          hib ℓ hℓ]
  ·
    intro x hx
    have hxa : (CerednikDrinfeld.degeneracyMatrix D.a).mulVec (x : E → ℤ) = 0 := by
      rw [← hπL1, hx, map_zero]; rfl
    have hxb : (CerednikDrinfeld.degeneracyMatrix D.b).mulVec (x : E → ℤ) = 0 := by
      rw [← hπL2, hx, map_zero]; rfl
    have hmem : (x : E → ℤ) ∈ CerednikDrinfeld.ribbonKernel D := by
      rw [CerednikDrinfeld.mem_ribbonKernel]
      intro i
      fin_cases i
      · exact hxa
      · exact hxb
    refine ⟨eY.symm ⟨_, hmem⟩, Subtype.ext ?_⟩
    rw [hφ_coe, AddEquiv.apply_symm_apply]

end P2mRT7S1
