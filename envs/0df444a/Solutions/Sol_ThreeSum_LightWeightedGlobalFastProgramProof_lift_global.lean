set_option autoImplicit false
noncomputable section
open ThreeSum ThreeSum.LightWeightedGlobalFastProgramProof
open Light LightWeightedGlobalFastProgram LightWeightedGlobalGlobalPrelude
set_option maxHeartbeats 8000000
set_option maxRecDepth 24000
namespace ThreeSum.LightWeightedGlobalFastProgramProof
theorem _root_.solution {lim : Limits} {M b p K κ entry depth T : ℕ}
    {vals : List ℤ} {μ : ℕ→ℤ} {Post : ℤ→(ℕ→ℤ)→Prop}
    (color : Program) (colorMain : ℕ)
    (h : Meets lim (LightWeightedGlobalGlobalPrelude.program M b p K κ) entry depth vals μ T Post) :
    Meets lim (program M b p K κ color colorMain) entry depth vals μ T Post := by
  have hh := h.append (color.map (ReportingHostRelocation.relocate 50)++
    LightColorParameters.program.map (ReportingHostRelocation.relocate (50+color.length))++
    [LightColorScan.body (scanEntry color) (50+color.length) (50+colorMain),
      LightColorScanHost.body (scanEntry color),LightWeightedGlobalFastProgram.body (hostEntry color)])
  simpa only [LightWeightedGlobalFastProgram.program,parameterLibrary,colorsLibrary,ReportingHostRelocation.program,
    LightWeightedGlobalGlobalPrelude.program_length,colorsLibrary_length,List.length_append,List.length_map,List.append_assoc] using hh
end ThreeSum.LightWeightedGlobalFastProgramProof
