-- title:
--   QFT on more than three wires has no exact Clifford/T circuit
-- statement:
--   Let $n>3$ be a natural number and let $F_{2^n}$ be the normalized Fourier matrix with entries $2^{-n/2}e^{2\pi i jk/2^n}$, indexed by the standard binary computational basis. For the Clifford/T library generated by $H,P,T,\mathrm{CNOT}$,
--
--   $$
--   \nexists c\text{ on exactly }n\text{ wires}:\ M(c)=F_{2^n}.
--   $$
--
--   No extra wires, measurements, or postselection are allowed. This necessary ring-membership obstruction does not assume Conjecture 1.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 3, §2 unnumbered: QFT on more than three qubits requires approximation

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Section 2, PDF p.3: the normalized QFT on n>3 wires has no exact same-wire
Clifford/T implementation. Only the necessary ring inclusion is used. -/
theorem qft_obstruction (n : ℕ) (hn : 3 < n) :
    ¬ ∃ c : QAlgorithms.Circuit cliffordTLibrary n,
      c.unitary = QAlgorithms.qftQubits n := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
