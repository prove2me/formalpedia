section
-- Source module: ThreeSumApsp.Filter.OracleScatter
@[expose] public section

namespace Light.Filter

variable {lim : Limits} {P : Program} {d : ℕ}

/-- The place of a query pair is below `n²`. -/
theorem oAddr_lt {n : ℕ} {WI WJ : List ℕ} {w i : ℕ} (hI : WI.length = w) (hJ : WJ.length = w)
    (ltI : ∀ x ∈ WI, x < n) (ltJ : ∀ x ∈ WJ, x < n) (hi : i < w) : oAddr n WI WJ i < n * n := by
  have ha : WI.getD i 0 < n := by
    rw [List.getD_eq_getElem _ _ (by omega)]
    exact ltI _ (List.getElem_mem _)
  have hb : WJ.getD i 0 < n := by
    rw [List.getD_eq_getElem _ _ (by omega)]
    exact ltJ _ (List.getElem_mem _)
  exact Nat.mul_add_lt_mul ha hb

/-- **oScatter** writes the answers to the places of their query pairs, and changes no other
cell. -/
theorem oScatter_spec {μ : ℕ → ℤ} {out qi qj w base n : ℕ} {WI WJ : List ℕ} {A : List ℤ}
    {f : ℕ → ℤ} (pre : ScatterPre lim μ out qi qj w base n WI WJ A f) :
    Ends lim P d oScatterBody ⟨Light.frame [out, qi, qj, w, base, n], μ⟩ (tOScatter w) fun σ' =>
      ScatterInv μ base n WI WJ f w σ'.mem := by
  ((obtain ⟨⟩ := id pre))
  have hwv : (w : ℤ) ≤ lim.word := by
    have : ((w : ℕ) : ℤ) ≤ (lim.space : ℕ) := by exact_mod_cast (by omega : w ≤ lim.space)
    omega
  unfold oScatterBody tOScatter
  refine Ends.forFrame (ScatterInv μ base n WI WJ f) w ⟨fun i hi => absurd hi (Nat.not_lt_zero _),
    fun _ _ => rfl⟩ ?round (fun μ' h => h) ?bound hwv (by (first
                                                           | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil,
                                                                   List.sum_cons, List.sum_nil, ])
                                                               (first
                                                                 | omega
                                                                 | ((ring_nf); (omega))))
                                                           | omega
                                                           |
                                                             (simp [] <;>
                                                                 first
                                                                 | omega
                                                                 | ((ring_nf); (omega)))))
  case bound =>
    intro j μ' hj _
    simp only [Expr.Gives]
    exact ⟨trivial, by simp⟩
  case round =>
    intro j μ' hj ⟨hdone, hrest⟩
    have haddr := oAddr_lt pre.lenI pre.lenJ pre.ltI pre.ltJ hj
    -- the three cells that are read have not been written
    have hnot : ∀ a, (a < base ∨ base + n * n ≤ a) → μ' a = μ a := by
      intro a ha
      refine hrest a fun i hi he => ?_
      have := oAddr_lt pre.lenI pre.lenJ pre.ltI pre.ltJ (show i < w by omega)
      omega
    have hrI : μ' (qi + j) = (WI.getD j 0 : ℤ) := by
      rw [hnot _ (by omega), pre.segI j (by simp; omega),
        List.getD_eq_getElem _ _ (show j < WI.length by omega), List.getElem_map]
    have hrJ : μ' (qj + j) = (WJ.getD j 0 : ℤ) := by
      rw [hnot _ (by omega), pre.segJ j (by simp; omega),
        List.getD_eq_getElem _ _ (show j < WJ.length by omega), List.getElem_map]
    have hrA : μ' (out + j) = f (oAddr n WI WJ j) := by
      rw [hnot _ (by omega), pre.segA j (by omega), ← pre.val j hj,
        List.getD_eq_getElem _ _ (show j < A.length by omega)]
    have hval : ((WI.getD j 0 : ℕ) : ℤ) * (n : ℤ) + (WJ.getD j 0 : ℕ) = (oAddr n WI WJ j : ℕ) := by
      simp [oAddr]
