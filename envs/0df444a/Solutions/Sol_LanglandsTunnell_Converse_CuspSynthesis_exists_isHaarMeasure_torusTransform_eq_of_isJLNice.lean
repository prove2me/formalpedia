private theorem t0029 (w : InfinitePlace K) : (0 : InfiniteAdeleRing K) w = 0 := rfl

private theorem val_ext {x y : 𝔸ˣ} (harch : ∀ w : InfinitePlace K, (x : 𝔸).1 w = (y : 𝔸).1 w)
