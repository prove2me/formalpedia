/-!
# §8.2 Lemma 20: tensor interface, padded box, linewise implementation

* `lemma20_tensor`: tensoring the one-dimensional identities (33) gives (35),
  `R F_s = 2^γ B₀ Q F_t A` with `γ = 2dα²`, `R = ⊗ P_{s_i}`, `Q = ⊗ P_{t_i}`, `‖A‖, ‖B₀‖ ≤ 1`.
* `axisOp` / `tensOpI`: the padded box keeps its full shape; applying the padded line kernels of
  the axes one at a time (in any order) equals the tensor kernel (`axis_fold_eq_tensOp`), and
  with zero padding outside `∏ [0, s_i)` this is exactly the tensor map `A`
  (`tensOp_pad_eq_tens`).
* `approx_iterate`: `d` contraction stages with errors `< E` each give error `< d E`.
* cost bookkeeping: `∑_i (T/t_i)·(t_i X) = d T X`, line count `∑ T/t_i ≤ 2dT/r`.
-/

open Finset Complex

namespace IntMul.OpenAI.RT

variable {d : ℕ}

/-! ### Kernel tensor (copied from the base thread's `Thm41.lean`, renamed) -/

noncomputable def tens {s t : Fin d → ℕ} [∀ i, NeZero (s i)]
    (M : (i : Fin d) → ZMod (t i) → ZMod (s i) → ℂ) (u : ((i : Fin d) → ZMod (s i)) → ℂ) : ((i : Fin d) → ZMod (t i)) → ℂ :=
  fun k => ∑ j, (∏ i, M i (k i) (j i)) * u j

lemma tens_add {s t : Fin d → ℕ} [∀ i, NeZero (s i)]
    (M : (i : Fin d) → ZMod (t i) → ZMod (s i) → ℂ) (u v : ((i : Fin d) → ZMod (s i)) → ℂ) :
    IntMul.OpenAI.RT.tens M (u + v) = IntMul.OpenAI.RT.tens M u + IntMul.OpenAI.RT.tens M v := by
  ext k; simp only [IntMul.OpenAI.RT.tens, Pi.add_apply, mul_add, Finset.sum_add_distrib]

lemma tens_smul' {s t : Fin d → ℕ} [∀ i, NeZero (s i)] (c : ℂ)
    (M : (i : Fin d) → ZMod (t i) → ZMod (s i) → ℂ) (u : ((i : Fin d) → ZMod (s i)) → ℂ) :
    IntMul.OpenAI.RT.tens M (c • u) = c • IntMul.OpenAI.RT.tens M u := by
  ext k; simp only [IntMul.OpenAI.RT.tens, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_); ring

noncomputable def tensCLM {s t : Fin d → ℕ} [∀ i, NeZero (s i)] [∀ i, NeZero (t i)]
    (M : (i : Fin d) → ZMod (t i) → ZMod (s i) → ℂ) :
    (((i : Fin d) → ZMod (s i)) → ℂ) →L[ℂ] (((i : Fin d) → ZMod (t i)) → ℂ) :=
  LinearMap.toContinuousLinearMap ⟨⟨IntMul.OpenAI.RT.tens M, tens_add M⟩, fun c u => tens_smul' c M u⟩

@[simp] lemma tensCLM_apply {s t : Fin d → ℕ} [∀ i, NeZero (s i)] [∀ i, NeZero (t i)]
    (M : (i : Fin d) → ZMod (t i) → ZMod (s i) → ℂ) (u) : tensCLM M u = IntMul.OpenAI.RT.tens M u := rfl

/-! ### Multidimensional transforms and the retained permutations -/

/-- Normalized multidimensional transform `F_s` (negative sign). -/
noncomputable def dftM (s : Fin d → ℕ) [∀ i, NeZero (s i)] (u : ((i : Fin d) → ZMod (s i)) → ℂ) :
    ((i : Fin d) → ZMod (s i)) → ℂ :=
  fun k => (∏ i, (s i : ℂ))⁻¹ * ∑ j, (∏ i, (ZMod.stdAddChar (-(j i * k i)) : ℂ)) * u j

/-- `R = ⊗ P_{s_i}`: `(R w)_k = w_{(t_i k_i)_i}`. -/
def Rperm (s t : Fin d → ℕ) (w : ((i : Fin d) → ZMod (s i)) → ℂ) :
    ((i : Fin d) → ZMod (s i)) → ℂ :=
  fun k => w (fun i => (t i : ZMod (s i)) * k i)

