namespace GlueLayout

open Finset Butterfly AModel Synth

/-! ## 0. Bit arithmetic -/

lemma getBit_div (m t v : ℕ) : getBit t (v / 2 ^ m) = getBit (m + t) v := by
  ext; simp only [getBit]; rw [Nat.div_div_eq_div_mul, ← pow_add]

lemma getBit_setBit_ne {h k : ℕ} (hne : k ≠ h) (v : ℕ) (b : Fin 2) :
    getBit k (setBit h v b) = getBit k v := by
  rcases Nat.lt_or_gt_of_ne hne with hk | hk
  · rw [← getBit_mod_of_lt hk, setBit_mod, getBit_mod_of_lt hk]
  · exact getBit_setBit_of_lt hk v b

/-- Numbers below `2^K` are determined by their bits. -/
lemma eq_of_getBit {K x x' : ℕ} (hx : x < 2 ^ K) (hx' : x' < 2 ^ K)
    (h : ∀ t < K, getBit t x = getBit t x') : x = x' := by
  rw [← Nat.mod_eq_of_lt hx, ← Nat.mod_eq_of_lt hx', ← sum_bits_eq_mod, ← sum_bits_eq_mod]
  exact sum_congr rfl (fun t ht => by rw [h t (mem_range.1 ht)])

/-- A digit of `decode`. -/
lemma getD_decode : ∀ (sh : Shape) (j k : ℕ) (hk : k < sh.length),
    (decode sh j).getD k 0 = j / vol (sh.drop (k + 1)) % sh[k]
  | [], _, _, hk => by simp at hk
  | q :: sh, j, 0, _ => by simp [decode]
  | q :: sh, j, k + 1, hk => by
    have hk' : k < sh.length := by simp at hk; omega
    show (decode sh (j % vol sh)).getD k 0 = j / vol (sh.drop (k + 1)) % sh[k]
    rw [getD_decode sh _ k hk']
    have hsplit : vol sh = vol (sh.take (k + 1)) * vol (sh.drop (k + 1)) := by
      rw [← vol_append, List.take_append_drop]
    have hdvd : sh[k] ∣ vol (sh.take (k + 1)) := by
      rw [List.take_add_one, List.getElem?_eq_getElem hk', Option.toList_some, vol_append]
      simp [vol]
    rw [hsplit, Nat.mod_mul_left_div_self]
    exact Nat.mod_mod_of_dvd _ hdvd

lemma vol_binSh (n : ℕ) : vol (binSh n) = 2 ^ n := by simp [vol, binSh, List.prod_replicate]

/-- Digits of a binary address are the bits of its index. -/
lemma getD_decode_binSh {n j k : ℕ} (hk : k < n) :
    (decode (binSh n) j).getD k 0 = (getBit (n - 1 - k) j : ℕ) := by
  rw [getD_decode _ _ _ (by simpa [binSh] using hk)]
  have : (binSh n).drop (k + 1) = binSh (n - 1 - k) := by
    simp only [binSh, List.drop_replicate]; congr 1; omega
  rw [this, vol_binSh]
  simp [binSh, getBit]

lemma getD_binSh_encode {n : ℕ} {v : List ℕ} (hv : Valid (binSh n) v) {k : ℕ} (hk : k < n) :
    v.getD k 0 = (getBit (n - 1 - k) (encode (binSh n) v) : ℕ) := by
  rw [← getD_decode_binSh hk, decode_encode hv]

/-! ## 1. Selected bits given by positions; transport -/

variable {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma PosData.val_of_not (P : PosData n ι) (v : List ℕ) (y : ι → Fin 2) {k : ℕ}
    (hk : ∀ i, P.pos i ≠ k) : P.val v y k = v.getD k 0 := by
  have : P.inv k = none := by
    rcases h : P.inv k with _ | i
    · rfl
    · exact absurd ((P.inv_iff k i).1 h) (hk i)
  simp [PosData.val, this]

lemma posSel_bits (P : PosData n ι) {v : List ℕ} (hv : Valid (binSh n) v) (i : ι) :
    ((posSel P).bits v i : ℕ) = v.getD (P.pos i) 0 := by
  show v.getD (P.pos i) 0 % 2 = _
  exact Nat.mod_eq_of_lt (valid_getD_lt_two hv _)

/-- **Transport of selected-bit operators** along an address map that preserves the linear
index. -/
theorem selOp_transport {sh sh' : Shape} {ι ι' : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype ι'] [DecidableEq ι'] (Sb : SelBits sh ι) (Sb' : SelBits sh' ι') (e : ι ≃ ι')
    (φ : List ℕ → List ℕ) (hvol : vol sh' = vol sh)
    (hval : ∀ a, Valid sh a → Valid sh' (φ a))
    (henc : ∀ a, Valid sh a → encode sh' (φ a) = encode sh a)
    (hbits : ∀ a, Valid sh a → ∀ i, Sb'.bits (φ a) (e i) = Sb.bits a i)
    (hset : ∀ a, Valid sh a → ∀ y : ι → Fin 2, Sb'.set (φ a) (y ∘ e.symm) = φ (Sb.set a y))
    (A : M2) {M : Type*} [AddCommMonoid M] [Module ℂ M] (xs : List M) :
    selOp Sb (tens A) xs = selOp Sb' (tens A) xs := by
  apply List.ext_getElem (by simp [hvol])
  intro j h1 h2
  simp only [length_selOp] at h1
  have ha := valid_decode h1
  set a := decode sh j with hadef
  have hdec : decode sh' j = φ a := by
    have : j = encode sh' (φ a) := by rw [henc a ha, hadef, encode_decode h1]
    rw [this, decode_encode (hval a ha)]
  rw [getElem_selOp, getElem_selOp, hdec]
  symm
  refine Fintype.sum_equiv (e.arrowCongr (Equiv.refl (Fin 2))).symm _ _ (fun y' => ?_)
  set y := (e.arrowCongr (Equiv.refl (Fin 2))).symm y' with hy
  have hy' : y' = y ∘ e.symm := by
    funext i'; simp [hy, Equiv.arrowCongr]
  rw [hy']
  congr 1
  · simp only [tens, tensF]
    rw [← Fintype.prod_equiv e (fun i => A (Sb.bits a i) (y i))]
    · intro i; simp [hbits a ha i]
  · rw [hset a ha y, henc _ (Sb.valid_set a y ha)]

/-! ## 2. Slot arrangements are coordinate layouts -/

/-! ## 3. Chunk positions are Proposition 14's `layerSel` -/

section Chunk

variable {A K D B ρ : ℕ}

lemma prod_rep (m K B : ℕ) : (List.replicate m (2 ^ K) ++ [2 ^ B]).prod = 2 ^ (m * K + B) := by
  rw [List.prod_append, List.prod_replicate, List.prod_singleton, ← pow_mul, ← pow_add, mul_comm K m]

lemma vol_layer (A K D B : ℕ) : vol (layerShape (2 ^ A) K D (2 ^ B)) = 2 ^ (A + D * K + B) := by
  simp only [layerShape, List.cons_append, vol_cons, vol_append]
  simp only [vol, List.prod_replicate, List.prod_cons, List.prod_nil, mul_one]
  rw [← pow_mul, ← pow_add, ← pow_add]; ring_nf

lemma layer_head (N : ℕ) :
    (decode (layerShape (2 ^ A) K D (2 ^ B)) N).headD 0 = N / 2 ^ (D * K + B) % 2 ^ A := by
  simp only [layerShape, List.cons_append, decode, List.headD_cons]
  rw [show vol (List.replicate D (2 ^ K) ++ [2 ^ B]) = 2 ^ (D * K + B) from prod_rep D K B]

lemma layer_chunk (N : ℕ) (i : Fin D) :
    (decode (layerShape (2 ^ A) K D (2 ^ B)) N).getD (i + 1) 0 =
      N / 2 ^ ((D - 1 - i) * K + B) % 2 ^ K := by
  have hi := i.isLt
  rw [getD_decode _ _ _ (by simp [layerShape])]
  have hdrop : (layerShape (2 ^ A) K D (2 ^ B)).drop ((i : ℕ) + 1 + 1) =
      List.replicate (D - 1 - i) (2 ^ K) ++ [2 ^ B] := by
    simp only [layerShape, List.cons_append, List.drop_succ_cons]
    rw [List.drop_append_of_le_length (by simp), List.drop_replicate]
    congr 2; omega
  have hget : (layerShape (2 ^ A) K D (2 ^ B))[(i : ℕ) + 1]'(by simp [layerShape]) =
      2 ^ K := by
    simp only [layerShape, List.cons_append, List.getElem_cons_succ]
    rw [List.getElem_append_left (by simp), List.getElem_replicate]
  rw [hget, hdrop]
  congr 2
  exact prod_rep _ K B

lemma layer_last (N : ℕ) :
    (decode (layerShape (2 ^ A) K D (2 ^ B)) N).getD (D + 1) 0 = N % 2 ^ B := by
  rw [getD_decode _ _ _ (by simp [layerShape])]
  have hdrop : (layerShape (2 ^ A) K D (2 ^ B)).drop (D + 1 + 1) = [] := by
    simp [layerShape]
  have hget : (layerShape (2 ^ A) K D (2 ^ B))[D + 1]'(by simp [layerShape]) = 2 ^ B := by
    simp only [layerShape, List.cons_append, List.getElem_cons_succ]
    rw [List.getElem_append_right (by simp)]; simp
  rw [hget, hdrop]; simp [vol]

lemma getBit_chunk {t K : ℕ} (ht : t < K) (m N : ℕ) :
    getBit t (N / 2 ^ m % 2 ^ K) = getBit (m + t) N := by
  rw [getBit_mod_of_lt ht, getBit_div]

lemma bit_of_encode {n : ℕ} {v : List ℕ} (hv : Valid (binSh n) v) {u : ℕ} (hu : u < n) :
    (getBit u (encode (binSh n) v) : ℕ) = v.getD (n - 1 - u) 0 := by
  rw [getD_binSh_encode hv (by omega)]; congr 2; omega

lemma chunk_arith {D K i : ℕ} (hi : i < D) : (D - 1 - i) * K + i * K + K = D * K := by
  rw [← add_mul, ← Nat.succ_mul]; congr 1; omega

lemma div_mod_unique {K j i r1 r2 : ℕ} (h1 : r1 < K) (h2 : r2 < K)
    (he : j * K + r1 = i * K + r2) : j = i ∧ r1 = r2 := by
  have hK : 0 < K := by omega
  have e1 : (j * K + r1) / K = j := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hK, Nat.div_eq_of_lt h1, zero_add]
  have e2 : (i * K + r2) / K = i := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hK, Nat.div_eq_of_lt h2, zero_add]
  have hji : j = i := by rw [← e1, ← e2, he]
  subst hji
  exact ⟨rfl, by omega⟩

/-- **Chunk bridge.** On a binary address of length `n = A + DK + B`, selected bits at the
positions `A + iK + (K-1-ρ)` (bit `ρ` of the `i`-th `K`-bit chunk after a prefix of `A` bits)
act exactly as `layerSel (2^A) K D (2^B) ρ` of §5 for every tensor kernel. -/
theorem chunk_bridge_sol_aux (hρ : ρ < K) {n : ℕ} (hn : n = A + D * K + B) {ι : Type*} [Fintype ι]
    [DecidableEq ι] (P : PosData n ι) (e : ι ≃ Fin D)
    (hpos : ∀ i : Fin D, P.pos (e.symm i) = A + i * K + (K - 1 - ρ)) (M : M2)
    {X : Type*} [AddCommMonoid X] [Module ℂ X] (xs : List X) :
    selOp (posSel P) (tens M) xs = selOp (layerSel (2 ^ A) K D (2 ^ B) ρ hρ) (tens M) xs := by
  have hposi : ∀ i : ι, P.pos i = A + (e i) * K + (K - 1 - ρ) := fun i => by
    rw [← hpos (e i), Equiv.symm_apply_apply]
  have hposne : ∀ (i : ι) (k : ℕ), (k < A ∨ A + D * K ≤ k) → P.pos i ≠ k := by
    intro i k hk hik
    have := hposi i
    have hi := (e i).isLt
    have := chunk_arith (K := K) hi
    rcases hk with hk | hk <;> omega
  -- positions inside the chunks
  have hposchunk : ∀ (i : ι) (j : Fin D) (t : ℕ), t < K → t ≠ ρ →
      P.pos i ≠ A + j * K + (K - 1 - t) := by
    intro i j t ht htρ hij
    rw [hposi i] at hij
    have := div_mod_unique (K := K) (j := (e i : ℕ)) (i := j) (r1 := K - 1 - ρ) (r2 := K - 1 - t)
      (by omega) (by omega) (by omega)
    omega
  refine selOp_transport (posSel P) (layerSel (2 ^ A) K D (2 ^ B) ρ hρ) e
    (fun a => decode (layerShape (2 ^ A) K D (2 ^ B)) (encode (binSh n) a))
    (by rw [vol_layer, vol_binSh, hn]) ?_ ?_ ?_ ?_ M xs
  · intro a ha
    apply valid_decode
    rw [vol_layer, ← hn]; have := encode_lt ha; rwa [vol_binSh] at this
  · intro a ha
    apply encode_decode
    rw [vol_layer, ← hn]; have := encode_lt ha; rwa [vol_binSh] at this
  · intro a ha i
    apply Fin.ext
    rw [posSel_bits P ha]
    show (getBit ρ ((decode (layerShape (2 ^ A) K D (2 ^ B)) (encode (binSh n) a)).getD
      ((e i : ℕ) + 1) 0) : ℕ) = _
    rw [layer_chunk, getBit_chunk hρ, bit_of_encode ha (by
      have := chunk_arith (K := K) (e i).isLt; omega), hposi i]
    have := chunk_arith (K := K) (e i).isLt
    congr 1; omega
  · intro a ha y
    have hl := (valid_binSh_iff.1 ha).1
    have ha' := (posSel P).valid_set a y ha
    set N := encode (binSh n) a with hN
    set N' := encode (binSh n) ((posSel P).set a y) with hN'
    have hNlt : N' < vol (layerShape (2 ^ A) K D (2 ^ B)) := by
      rw [vol_layer, ← hn]; have := encode_lt ha'; rwa [vol_binSh] at this
    have hlen : (decode (layerShape (2 ^ A) K D (2 ^ B)) N').length = D + 2 := by
      rw [(valid_decode hNlt).length_eq]; simp [layerShape]
    -- bits of `N'`
    have hbitN' : ∀ u < n, (getBit u N' : ℕ) = P.val a y (n - 1 - u) := by
      intro u hu
      rw [hN', bit_of_encode ha' hu]
      exact P.getD_setL a y (by rw [hl]; omega)
    have hbitN : ∀ u < n, (getBit u N : ℕ) = a.getD (n - 1 - u) 0 := fun u hu => by
      rw [hN, bit_of_encode ha hu]
    have h1 : N / 2 ^ (D * K + B) % 2 ^ A = N' / 2 ^ (D * K + B) % 2 ^ A := by
      apply eq_of_getBit (K := A) (Nat.mod_lt _ (by positivity)) (Nat.mod_lt _ (by positivity))
      intro t ht
      apply Fin.ext
      rw [getBit_chunk ht, getBit_chunk ht, hbitN _ (by omega), hbitN' _ (by omega),
        P.val_of_not a y (fun i => hposne i _ (Or.inl (by omega)))]
    have h3 : N % 2 ^ B = N' % 2 ^ B := by
      apply eq_of_getBit (K := B) (Nat.mod_lt _ (by positivity)) (Nat.mod_lt _ (by positivity))
      intro t ht
      apply Fin.ext
      rw [getBit_mod_of_lt ht, getBit_mod_of_lt ht, hbitN _ (by omega), hbitN' _ (by omega),
        P.val_of_not a y (fun i => hposne i _ (Or.inr (by omega)))]
    have h2 : ∀ i : Fin D, setBit ρ (N / 2 ^ ((D - 1 - i) * K + B) % 2 ^ K) (y (e.symm i)) =
        N' / 2 ^ ((D - 1 - i) * K + B) % 2 ^ K := by
      intro i
      have hi := chunk_arith (K := K) i.isLt
      apply eq_of_getBit (K := K) (setBit_lt hρ (Nat.mod_lt _ (by positivity)) _)
        (Nat.mod_lt _ (by positivity))
      intro t ht
      apply Fin.ext
      rw [getBit_chunk ht (N := N'), hbitN' _ (by omega)]
      by_cases htρ : t = ρ
      · subst htρ
        rw [getBit_setBit]
        have : n - 1 - ((D - 1 - i) * K + B + t) = P.pos (e.symm i) := by rw [hpos]; omega
        rw [this, P.val_pos]
      · rw [getBit_setBit_ne htρ, getBit_chunk ht, hbitN _ (by omega)]
        rw [P.val_of_not a y]
        intro i' hi'
        apply hposchunk i' i t ht htρ
        rw [hi']; omega
    rw [eq_mkAddr D hlen]
    show layerSet D ρ (decode (layerShape (2 ^ A) K D (2 ^ B)) N) (y ∘ e.symm) = _
    simp only [layerSet, layer_head, layer_chunk, layer_last, Function.comp]
    rw [h1, h3]
    congr 1
    funext i
    exact h2 i

end Chunk

