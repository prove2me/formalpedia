open NLogN
open NLogN.KFB
open IntMul RS AModel KIL KFD Complex
theorem solution {A X Y : ℕ} (zs : List NLogN.KFB.GI) (hl : zs.length = A * X * Y) :
    NLogN.KFB.gflat (NLogN.KFB.mvL X Y zs) = AModel.pull [A, Y, X, 2] [A, X, Y, 2] NLogN.KIL.gS 0 (NLogN.KFB.gflat zs) := by
  apply List.ext_getElem (by simp [AModel.vol, hl]; ring)
  intro J h1 h2
  have h1' : J < 2 * zs.length := by simpa using h1
  rw [← List.getD_eq_getElem _ 0 h1, ← List.getD_eq_getElem _ 0 h2, NLogN.KFB.getD_gflat]
  have hJ : J = 2 * (J / 2) + J % 2 := by omega
  conv_rhs => rw [hJ]
  rw [NLogN.KFB.pull_g4 _ _ _ (by rw [← hl]; omega) (Nat.mod_lt _ (by norm_num)), NLogN.KFB.getD_gflat,
    NLogN.KFB.getD_mvL _ _ _ _ (by omega)]
  have e1 : (2 * NLogN.KFB.g4 X Y (J / 2) + J % 2) / 2 = NLogN.KFB.g4 X Y (J / 2) := by omega
  have e2 : (2 * NLogN.KFB.g4 X Y (J / 2) + J % 2) % 2 = J % 2 := by omega
  rw [e1, e2]
end
