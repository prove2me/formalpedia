    hK t1 t2 t3 t4 t5 t6 t7 t8 (le_trans (NLogN.KIL.zsz_nat_le (by omega)) hB) (fun _ => ((c % 4 : ℕ) : ℤ))
    (fun x q _ _ _ _ => ⟨trivial, rfl, hc⟩)
  refine ⟨o, ?_, b⟩
  rw [εLit, ev, aEof_equiv K e N hK φ hN]
  split_ifs <;> simp

end NLogN.KFW

