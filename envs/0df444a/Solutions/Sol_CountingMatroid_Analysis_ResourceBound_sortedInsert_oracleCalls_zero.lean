@[simp] theorem one_apply_of_ne {o o' : κ} (h : o' ≠ o) : one o o' = 0 := by
  simp [one, h]



@[simp] theorem many_apply_of_ne {o o' : κ} (n : ℕ) (h : o' ≠ o) : many o n o' = 0 := by
  simp [many, h]















