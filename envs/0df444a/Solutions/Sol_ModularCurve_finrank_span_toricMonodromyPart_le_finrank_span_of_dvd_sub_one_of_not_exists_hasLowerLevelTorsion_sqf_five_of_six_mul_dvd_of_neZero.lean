          ∀ v : Fin 2 → F, v ≠ 0 →
            ∃ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, ∀ c : F, (ρ σ).mulVec v ≠ c • v)
    [DecidableEq (IsLocalRing.ResidueField ↥A₂)] [CharP (IsLocalRing.ResidueField ↥A₂) q]
    [Fintype ↥(ssPlaces q (N * q') (IsLocalRing.ResidueField ↥A₂))]
    [Fintype ↥(ssPlaces q N (IsLocalRing.ResidueField ↥A₂))]
    [DecidableEq ↥(ssPlaces q (N * q') (IsLocalRing.ResidueField ↥A₂))]
    [DecidableEq ↥(ssPlaces q N (IsLocalRing.ResidueField ↥A₂))]
    (X₂ : SSLevelDatum q (IsLocalRing.ResidueField ↥A₂) N q') (hX₂ : X₂.HeckeLaws)
    [DecidableEq (IsLocalRing.ResidueField ↥A₁)] [CharP (IsLocalRing.ResidueField ↥A₁) q']
    [Fintype ↥(ssPlaces q' (N * q) (IsLocalRing.ResidueField ↥A₁))]
    [Fintype ↥(ssPlaces q' N (IsLocalRing.ResidueField ↥A₁))]
    [DecidableEq ↥(ssPlaces q' (N * q) (IsLocalRing.ResidueField ↥A₁))]
    [DecidableEq ↥(ssPlaces q' N (IsLocalRing.ResidueField ↥A₁))]
    (X₁ : SSLevelDatum q' (IsLocalRing.ResidueField ↥A₁) N q) (hX₁ : X₁.HeckeLaws)
    (𝒥 : CerednikDrinfeld.TwoPlaceTorsionDatum p X₂.degeneracyData X₂.heckeData X₁.degeneracyData X₁.heckeData A₁ A₂)
    (h𝒥 : 𝒥.Laws (D * p) q' q) :
    (𝒥.snd.W 𝔪 ≤ 𝒥.snd.invariants ∨
      (letI := heckeModuleBar (N * q' * q); Subsingleton ↥(heckeTorsion (JZero (N * q' * q)) 𝔪))) := by
  letI := heckeModuleBar (N * q' * q)
  haveI : 𝔪.IsMaximal := hmax
  obtain ⟨F, _, _, ι, n, ρ, e, hgal, ⟨S, hS1, hS2⟩, hodd, hfin, hirr⟩ := hblr
  rcases Nat.eq_zero_or_pos n with hn | hn
  ·
    subst hn
    exact Or.inr e.toEquiv.subsingleton
  · left

    have h2k : (2 : HeckeAlg ⧸ 𝔪) ≠ 0 := by
      intro h
      have h2m : (2 : HeckeAlg) ∈ 𝔪 := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_ofNat]; exact h
      obtain ⟨m, hm⟩ := (Fact.out : p.Prime).odd_of_ne_two hp2
      have hsub : (p : HeckeAlg) - 2 * (m : HeckeAlg) ∈ 𝔪 := 𝔪.sub_mem hp (𝔪.mul_mem_right _ h2m)
      have hone : (p : HeckeAlg) - 2 * (m : HeckeAlg) = 1 := by rw [hm]; push_cast; ring
      rw [hone] at hsub
      exact hmax.ne_top ((Ideal.eq_top_iff_one _).mpr hsub)
    have h2F : (2 : F) ≠ 0 := by
      intro h
      apply h2k
      have := congrArg ι h
      rwa [map_ofNat, map_zero] at this

    letI : Field (HeckeAlg ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    have hspan := Matrix.span_range_map_eq_top_of_exists_odd_of_forall_exists_mulVec_ne_smul h2F ρ hodd hirr
      (k := HeckeAlg ⧸ 𝔪) ι

    have hatt : ∃ S : Finset ℕ, (∀ (ℓ : ℕ), ℓ.Prime → ℓ ∉ S → ¬ ℓ ∣ D * p) ∧
        ∀ (ℓ : ℕ) (hℓ : ℓ.Prime), ℓ ∉ S → ∀ (A : ValuationSubring (AlgebraicClosure ℚ)),
          A.LiesOverPrime ℓ → ∀ (σ : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)), A.IsFrobeniusAt σ ℓ →
            Ideal.Quotient.mk 𝔪 (heckeGen ⟨ℓ, hℓ⟩) = ((ρ σ).map ι).trace ∧
              Ideal.Quotient.mk 𝔪 ((ℓ : HeckeAlg)) = ((ρ σ).map ι).det :=
      ⟨S, hS1, hS2⟩

    have key : ∀ (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ), σ ∈ A₂.inertiaSubgroupIn ℚ →
        ∀ w : ↥(heckeTorsion (JZero (N * q' * q)) 𝔪), (fun i => ((ρ σ).map ι).mulVec (e w i)) = e w := by
      intro σ hσ w
      have h1 := hgal σ w
      have h2 := hunrJ σ hσ (w : JZero (N * q' * q)) w.2
      have h3 : e.symm (fun i => ((ρ σ).map ι).mulVec (e w i)) = w := Subtype.ext (h1.symm.trans h2)
      simpa using congrArg e h3
    have hunr : ∀ σ ∈ A₂.inertiaSubgroupIn ℚ, ρ σ = 1 := by
      intro σ hσ
      have hmul : ∀ u : Fin 2 → HeckeAlg ⧸ 𝔪, ((ρ σ).map ι).mulVec u = u := by
