include hk hkN hkNι in
theorem locOne_transfer (U : Set ↥(L₁.schemeKer n)) :
    (Spec.map (CommRingCat.ofHom ψ)).base ⁻¹' locOne L₁ n U = locOne L₂ n (kN.base ⁻¹' U) := by
  ext t
  show (Spec.map (CommRingCat.ofHom ψ) ≫ KerOps.oneK L₁ n).base t ∈ U ↔ (KerOps.oneK L₂ n ≫ kN).base t ∈ U
  rw [Transfer.kN_oneK ψ L₁ L₂ kA hkA hk n kN hkN hkNι]

include hk hkN hkNι in
theorem locInv_transfer (U : Set ↥(L₁.schemeKer n)) :
    (Spec.map (CommRingCat.ofHom ψ)).base ⁻¹' locInv L₁ hc₁ n U = locInv L₂ hc₂ n (kN.base ⁻¹' U) := by
  simp only [locInv, Set.preimage_compl, Transfer.preimage_image_eq hkN]
  congr 2
  ext x
  simp only [Set.mem_preimage, Set.mem_diff]
  show _ ↔ (kN.base x ∈ U ∧ ¬ (KerOps.invK L₂ n hc₂ ≫ kN).base x ∈ U)
  rw [← Transfer.kN_invK ψ L₁ L₂ kA hkA hk n kN hkN hkNι hc₁ hc₂]
  rfl

include hk hkN hkNι in
theorem locMul_transfer (U : Set ↥(L₁.schemeKer n)) :
    (Spec.map (CommRingCat.ofHom ψ)).base ⁻¹' locMul L₁ hc₁ n U = locMul L₂ hc₂ n (kN.base ⁻¹' U) := by
  simp only [locMul, Set.preimage_compl,
    Transfer.preimage_image_eq (Transfer.pair_isPullback ψ L₁ L₂ n kN hkN)]
  congr 2
  ext y
  simp only [Set.mem_preimage, Set.mem_diff, Set.mem_inter_iff]
  show _ ↔ ((pullback.fst _ _ ≫ kN).base y ∈ U ∧ (pullback.snd _ _ ≫ kN).base y ∈ U) ∧
    ¬ (KerOps.mulK L₂ n hc₂ ≫ kN).base y ∈ U
  rw [← Transfer.kN_mulK ψ L₁ L₂ kA hkA hk n kN hkN hkNι hc₁ hc₂, ← Transfer.pair_fst ψ L₁ L₂ n kN hkN,
    ← Transfer.pair_snd ψ L₁ L₂ n kN hkN]
  rfl

