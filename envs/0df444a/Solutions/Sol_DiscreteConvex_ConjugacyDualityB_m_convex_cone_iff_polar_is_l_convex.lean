variable {V : Type*} [Fintype V] [DecidableEq V]

/-- Net inflow of a flow `l` on arcs `i → j`: `∑ l (i,j) (e_j - e_i)`. -/
def flow (l : V → V → ℝ) : V → ℝ := fun w => ∑ i, l i w - ∑ j, l w j

/-- The cone generated by `e_j - e_i` for `R i j`. -/
def K (R : V → V → Prop) : Set (V → ℝ) :=
  {x | ∃ l : V → V → ℝ, (∀ i j, 0 ≤ l i j) ∧ (∀ i j, ¬ R i j → l i j = 0) ∧ x = flow l}

/-- `{p | p j ≤ p i for R i j}`. -/
def P (R : V → V → Prop) : Set (V → ℝ) := {p | ∀ i j, R i j → p j ≤ p i}

def polar (S : Set (V → ℝ)) : Set (V → ℝ) := {y | ∀ x ∈ S, ∑ v, y v * x v ≤ 0}

def IntPts : Set (V → ℝ) := {x | ∀ v, ∃ k : ℤ, x v = k}

lemma ip_flow (p : V → ℝ) (l : V → V → ℝ) :
    ∑ v, p v * flow l v = ∑ i, ∑ j, l i j * (p j - p i) := by
  simp only [flow, mul_sub, Finset.mul_sum, Finset.sum_sub_distrib]
  rw [Finset.sum_comm (f := fun v i => p v * l i v)]
  congr 1 <;> apply Finset.sum_congr rfl <;> intro i _ <;> apply Finset.sum_congr rfl <;>
    intro j _ <;> ring

lemma K_sub_polarP (R : V → V → Prop) : K R ⊆ polar (P R) := by
  rintro x ⟨l, hl0, hlR, rfl⟩ p hp
  rw [show ∑ v, flow l v * p v = ∑ v, p v * flow l v from
    Finset.sum_congr rfl (fun _ _ => mul_comm _ _), ip_flow]
  apply Finset.sum_nonpos; intro i _; apply Finset.sum_nonpos; intro j _
  by_cases h : R i j
  · exact mul_nonpos_of_nonneg_of_nonpos (hl0 i j) (by linarith [hp i j h])
  · simp [hlR i j h]

lemma single_mem_K (R : V → V → Prop) {i j : V} (h : R i j) :
    flow (fun a b => if a = i ∧ b = j then (1:ℝ) else 0) ∈ K R := by
  refine ⟨_, ?_, ?_, rfl⟩
  · intro a b; split_ifs <;> norm_num
  · intro a b hab; rw [if_neg]; rintro ⟨rfl, rfl⟩; exact hab h

lemma ip_single (p : V → ℝ) (i j : V) :
    ∑ v, p v * flow (fun a b => if a = i ∧ b = j then (1:ℝ) else 0) v = p j - p i := by
  rw [ip_flow]
  rw [Finset.sum_eq_single i]
  · rw [Finset.sum_eq_single j]
    · simp
    · intro b _ hb; simp [hb]
    · simp
  · intro a _ ha; apply Finset.sum_eq_zero; intro b _; simp [ha]
  · simp

lemma polarK_eq (R : V → V → Prop) : polar (K R) = P R := by
  ext p; constructor
  · intro hp i j h
    have := hp _ (single_mem_K R h)
    rw [ip_single] at this; linarith
  · intro hp x hx
    have := K_sub_polarP R hx p hp
    calc ∑ v, p v * x v = ∑ v, x v * p v := by
          apply Finset.sum_congr rfl; intro v _; ring
      _ ≤ 0 := this

lemma polarP_sub_K (R : V → V → Prop) [DecidableRel R] : polar (P R) ⊆ K R := by
  intro b hb
  let A : Matrix V (V × V) ℝ := fun w a =>
    if R a.1 a.2 then ((if w = a.2 then 1 else 0) - (if w = a.1 then 1 else 0)) else 0
  have key := (DiscreteConvex.IntegralConvexityB.theorem_3_9_farkas_lemma A b).2 ?_
  · obtain ⟨x, hx0, hx⟩ := key
    refine ⟨fun i j => if R i j then x (i, j) else 0, ?_, ?_, ?_⟩
    · intro i j; dsimp only; split_ifs
      · exact hx0 _
      · exact le_refl _
    · intro i j h; simp [h]
    · funext w
      rw [← congrFun hx w]
      simp only [Matrix.mulVec, dotProduct, A, flow, Fintype.sum_prod_type]
      rw [show (∑ i, ∑ j, (if R i j then (if w = j then (1:ℝ) else 0) - (if w = i then 1 else 0)
            else 0) * x (i, j)) = ∑ i, ∑ j, ((if w = j then (if R i j then x (i, j) else 0) else 0)
            - (if w = i then (if R i j then x (i, j) else 0) else 0)) from by
          apply Finset.sum_congr rfl; intro i _; apply Finset.sum_congr rfl; intro j _
          split_ifs <;> simp_all]
      simp only [Finset.sum_sub_distrib, Finset.sum_ite_eq, Finset.mem_univ,
        if_true]
      congr 1
      rw [Finset.sum_eq_single w]
      · simp
      · intro i _ hi; apply Finset.sum_eq_zero; intro j _; rw [if_neg (Ne.symm hi)]
      · simp
  · intro y hy
    have hp : (fun v => - y v) ∈ P R := by
      intro i j hij
      have h1 := hy (i, j)
      simp only [Matrix.vecMul, dotProduct, A, hij, if_true] at h1
      simp only [mul_sub, mul_ite, mul_one, mul_zero, Finset.sum_sub_distrib,
        Finset.sum_ite_eq', Finset.mem_univ, if_true] at h1
      linarith
    have h2 := hb _ hp
    simp only [dotProduct]
    have : ∑ v, b v * -y v = - ∑ v, y v * b v := by
      rw [← Finset.sum_neg_distrib]; apply Finset.sum_congr rfl; intro v _; ring
    linarith

