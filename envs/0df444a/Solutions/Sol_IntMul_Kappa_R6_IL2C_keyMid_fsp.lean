section KS

variable (G0 : Fin HS → List ℤ) (nv R x t u y : ℤ)

theorem KS_ne {j : Fin HS} (h1 : j ≠ pN) (h2 : j ≠ pR) (h3 : j ≠ kx) (h4 : j ≠ kt) (h5 : j ≠ ku)
    (h6 : j ≠ ky) : KS G0 nv R x t u y j = G0 j := by
  simp only [KS]; rw [upd_ne h6, upd_ne h5, upd_ne h4, upd_ne h3, upd_ne h2, upd_ne h1]

theorem KS_kx : KS G0 nv R x t u y kx = x :: G0 kx := by
  simp only [KS]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
    Function.update_self]
theorem KS_kt : KS G0 nv R x t u y kt = t :: G0 kt := by
  simp only [KS]; rw [upd_ne (by decide), upd_ne (by decide), Function.update_self]
theorem KS_ku : KS G0 nv R x t u y ku = u :: G0 ku := by
  simp only [KS]; rw [upd_ne (by decide), Function.update_self]
theorem KS_ky : KS G0 nv R x t u y ky = y :: G0 ky := by
  simp only [KS]; rw [Function.update_self]
theorem KS_pN : KS G0 nv R x t u y pN = nv :: G0 pN := by
  simp only [KS]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
    upd_ne (by decide), upd_ne (by decide), Function.update_self]
theorem KS_pR : KS G0 nv R x t u y pR = R :: G0 pR := by
  simp only [KS]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
    upd_ne (by decide), Function.update_self]

theorem KS_updt (t' : ℤ) : Function.update (KS G0 nv R x t u y) kt (t' :: G0 kt) =
    KS G0 nv R x t' u y := by
  funext j; simp only [KS, Function.update_apply]
  by_cases h : j = kt
  · subst h; simp +decide
  · simp [h]
theorem KS_updu (u' : ℤ) : Function.update (KS G0 nv R x t u y) ku (u' :: G0 ku) =
    KS G0 nv R x t u' y := by
  funext j; simp only [KS, Function.update_apply]
  by_cases h : j = ku
  · subst h; simp +decide
  · simp [h]
theorem KS_updy (y' : ℤ) : Function.update (KS G0 nv R x t u y) ky (y' :: G0 ky) =
    KS G0 nv R x t u y' := by
  funext j; simp only [KS, Function.update_apply]
  by_cases h : j = ky
  · subst h; simp +decide
  · simp [h]

end KS

