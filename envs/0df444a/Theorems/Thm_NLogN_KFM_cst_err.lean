theorem NLogN.KFM.cst_err (Δ : ℕ) (c h g : GI) (C H G : ℂ) (hC : ‖C‖ ≤ 1) (hH : ‖H‖ ≤ 1)
    (hG : ‖G‖ ≤ 1) (hc : ‖vP Δ c - C‖ ≤ (2 : ℝ)⁻¹ ^ Δ) (hh : ‖vP Δ h - H‖ ≤ (2 : ℝ)⁻¹ ^ Δ)
    (hg : ‖vP Δ g - G‖ ≤ 0) :
    ∀ k : ℕ, (4 * (k : ℝ) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 →
      ‖vP Δ (cst Δ c h g k).1 - H * C ^ k‖ ≤ (4 * k + 1) * (2 : ℝ)⁻¹ ^ Δ ∧
      ‖vP Δ (cst Δ c h g k).2 - G * H ^ k * C ^ (k * (k - 1) / 2)‖ ≤ 4 * (k : ℝ) ^ 2 * (2 : ℝ)⁻¹ ^ Δ := by sorry
