-- title:
--   Brownian motion X, its natural σ-fields 𝓑(t), stopping times of X, and X*(b) = sup_{t≥0} |X(b ∧ t)|
-- statement:
--   Let $(\Omega,\mathcal A,P)$ be a probability space.
--
--   1. A real process $X=\{X(t),\ 0\le t<\infty\}$ is a **one-dimensional Brownian motion** if its finite-dimensional distributions are those of Brownian motion (independent increments, $X(t)$ normally distributed with $EX(t)=0$ and $EX^2(t)=t$), each $X(t)$ is a random variable, and every sample function $t\mapsto X(t,\omega)$ is continuous.
--   2. $\mathcal B(t)$ is the $\sigma$-field generated by $\{X(s),\ 0\le s\le t\}$.
--   3. A **stopping time of $X$** is a function $\tau:\Omega\to[0,\infty]$ such that
--   $$\{\tau<t\}\in\mathcal B(t),\qquad t>0 .$$
--   4. For $0\le b\le\infty$,
--   $$X^*(b)=\sup_{t\ge0}|X(b\wedge t)|\in[0,\infty].$$
--
--   For a stopping time $\tau$, $X^*(\tau)$ denotes $\omega\mapsto X^*(\tau(\omega))(\omega)$, the maximal function of Brownian motion stopped at $\tau$; on $\{\tau=\infty\}$ it is $\sup_{t\ge0}|X(t)|$. These are the objects of §6 of the paper, the continuous-time model case for the martingale inequalities of the rest of the paper.
--
--   **Formalization Note** Brownian motion is Mathlib's `IsBrownianReal` (Brownian finite-dimensional laws and almost surely continuous paths), strengthened by the paper's "continuous sample functions" for every $\omega$ and by measurability of each $X(t)$; the latter makes $\mathcal B(t)$ a sub-$\sigma$-field of $\mathcal A$. $X(0)=0$ holds almost surely (from $EX^2(0)=0$). The stopping time is exactly the paper's: the strict event $\{\tau<t\}$ and the raw natural filtration $\mathcal B(t)$ (an optional time in modern terms), not Mathlib's `IsStoppingTime`, which uses $\{\tau\le t\}$ and would be a stronger hypothesis. Time is $\mathbb R_{\ge0}$ and $\tau$ is valued in $[0,\infty]$; since $b\wedge t$ is finite for finite $t$, $X(b\wedge t)$ is always defined.
-- source:
--   Burkholder, Distribution Function Inequalities for Martingales, Ann. Probability 1 (1973), §6, p. 25

import Mathlib
import Definitions.Def_BurkholderDFI_SquareFnLp_Martingale

namespace BurkholderDFI.Brownian

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- §6, p. 25: one-dimensional Brownian motion with continuous sample functions. Mathlib's
`IsBrownianReal` (Brownian finite-dimensional laws, a.s. continuous paths) plus the paper's
"continuous sample functions" for every `ω` and measurability of each `X(t)`. -/
def IsBM (X : ℝ≥0 → Ω → ℝ) (P : Measure Ω) : Prop :=
  IsBrownianReal X P ∧ (∀ t, Measurable (X t)) ∧ ∀ ω, Continuous (fun t => X t ω)

/-- §6, p. 25: `𝓑(t)`, the σ-field generated by `{X(s), 0 ≤ s ≤ t}`. -/
def natField (X : ℝ≥0 → Ω → ℝ) (t : ℝ≥0) : MeasurableSpace Ω :=
  ⨆ (s : ℝ≥0) (_ : s ≤ t), MeasurableSpace.comap (X s) inferInstance

/-- §6, p. 25: a stopping time of `X`: `τ : Ω → [0, ∞]` with `{τ < t} ∈ 𝓑(t)` for `t > 0`. -/
def IsStoppingTimeOf (X : ℝ≥0 → Ω → ℝ) (τ : Ω → ℝ≥0∞) : Prop :=
  ∀ t : ℝ≥0, 0 < t → MeasurableSet[natField X t] {ω | τ ω < t}

/-- §6, p. 25: `X*(b) = sup_{t ≥ 0} |X(b ∧ t)|` for `0 ≤ b ≤ ∞`, valued in `[0, ∞]`. -/
noncomputable def maxStopped (X : ℝ≥0 → Ω → ℝ) (b : ℝ≥0∞) (ω : Ω) : ℝ≥0∞ :=
  ⨆ t : ℝ≥0, ENNReal.ofReal |X (min b (t : ℝ≥0∞)).toNNReal ω|

end BurkholderDFI.Brownian


