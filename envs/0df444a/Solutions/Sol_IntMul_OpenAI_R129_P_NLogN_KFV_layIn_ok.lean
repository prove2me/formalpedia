    have ho := hops o (by simp)
    simp only [runArr, applyN, List.foldl_cons]
    rw [pull_comp _ _ (fun y hy => valid_binSh_permIdx (fun k hk => o.inv_lt ho hk) hy)]
    rw [pull_congr (g' := Synth.relabel init (permIdx o.idx arr)) (fun y hy => by
