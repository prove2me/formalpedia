theorem GlobalTheory.DRFil.spans_iff (ρ : Representation LL G V) : Spans PD ρ ↔
    ∀ y, y ∈ Submodule.span LL {z | ∃ (b : F), ∃ d ∈ DdR PD ρ, z = mulR Qp F LL V b d} := by sorry
