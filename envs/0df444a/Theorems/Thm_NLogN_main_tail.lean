import Definitions.Def_IntMul_SS_Defs2

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000

open NLogN
open IntMul
set_option maxHeartbeats 2000000

theorem NLogN.main_tail {I : List Sym} (n : ℕ) (s : IState NS) (a b : ℕ) (ha : a < 2 ^ n)
    (hb : b < 2 ^ n) (LP LN LF : List Item) (hA : s.G ARG = [.int (b : ℤ), .int (a : ℤ)])
    (hT1 : s.G T1 = [.int (2 ^ n)]) (hT2 : s.G T2 = [.int (2 ^ n)])
    (hP : s.G PRM = .int (mainN0 n) :: LP) (hN : s.G RN = .int (2 ^ mainN0 n) :: LN)
    (hF : s.G RF = .int (2 ^ mainN0 n + 1) :: LF) :
    ∃ t, IRuns I ssProg (.seq (.call 1) (.seq (.op (.shl T1 T2)) (.op (.write ARG T1)))) s t
      (fmPhi (mainN0 n) + shlCost n + outRCost (2 * n)) ∧ t.out = s.out ++ bin (2 * n) (a * b) := by sorry
