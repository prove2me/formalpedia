theorem MIPRE.OracleSampler.core_runs_within (n : ℕ) {B k : ℕ} (hS : S.TimeBoundAt n B k) (d : Data) :
    ∃ r t, t ≤ coreCost (Data.cons (encode S.prog) (.cons (encode n) d)).size B k (d.size + 1) ∧
      core.Runs (.cons (encode S.prog) (.cons (encode n) d)) r t := by sorry
