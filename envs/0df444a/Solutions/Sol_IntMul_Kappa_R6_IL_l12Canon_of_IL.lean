/-! ## 3. Fine Lemma 12 from the item-language Prop. 11 -/

section Fine

variable {W T m : ℕ} [NeZero W]

/-- **`L12Canon` from the item-language Prop. 11** (the canonical item size
`Bb = zsz (T₁ (q² V + 1)²) + 1` and the overhead absorbed by `KFB.overhead_le`). -/
theorem l12Canon_of_IL_sol_aux (C : Bit.QHNet (ZMod 2) W T m) (hm : 2 ≤ m) (hruns : C.RunsOK) {τ : ℝ}
    (hτ0 : 0 < τ) (hτ1 : τ ≤ 1) (hmom : histMoment C.hist m τ < W)
    {cW : ℕ} (hcW : ∀ k, Bit.depH m (m ^ k) ≤ cW * k) {q : ℕ} (hq : q.Prime)
    (hOK : ∀ f, C.OK (q ^ f)) {tab : Fin 1 → IStmt HS 1} {T₀ c₁ : ℕ} {K₁ K₂ : ℝ}
    (hK₁ : 0 ≤ K₁) (hK₂ : 0 ≤ K₂) (hIL : ILProp11 tab C q T₀ c₁ K₁ K₂) :
    L12Canon tab (l12F q m (W ^ cW)) τ := by
  obtain ⟨K, hK, HK⟩ := l12R_fine C hm hruns hτ0 hτ1 hmom hcW hq hOK hK₁ hK₂ hIL
  set T₁ := 8 + m + W ^ cW + 4 * T₀
  set A := zsz ((T₁ * (q ^ 2 + 1) ^ 2 : ℕ) : ℤ) + 1
  obtain ⟨D, hD0, hD⟩ := KFB.overhead_le (c₁ + 1) A
  refine ⟨K * (1 + D), mul_nonneg hK (by linarith), fun u Pre G Suf hu hPre hG hS I s F xs LP LG LS LU FP FG
    FS FU F0 F8 F9 F10 F11 F15 F20 F21 F23 F24 hxs => ?_⟩
  set V := vol (binShape Pre G Suf (2 ^ u)) with hVdef
  have hV1 : 1 ≤ V := le_trans Nat.one_le_two_pow (KFE.two_pow_le_vol Pre G Suf hPre hG hS)
  set Bb := zsz ((T₁ * (q ^ 2 * V + 1) ^ 2 : ℕ) : ℤ) + 1
  obtain ⟨c, Hc, hc⟩ := HK u Pre G Suf Bb hu hPre hG hS (Nat.le_succ _) (by omega) I s F xs
    LP LG LS LU FP FG FS FU F0 F8 F9 F10 F11 F15 F20 F21 F23 F24 hxs
  refine ⟨c, Hc, le_trans hc ?_⟩
  have hu1 := KFE.succ_le_zsz_vol (u := u) Pre G Suf hPre hG hS
  have hBb : Bb ≤ A + 2 * zsz (V : ℤ) := by
    have := KFB.zsz_canon_le T₁ q V hV1
    omega
  have hov := hD u V Bb hV1 hu1 hBb
  have huτ : (1 : ℝ) ≤ (u : ℝ) ^ τ := Real.one_le_rpow (by exact_mod_cast hu) hτ0.le
  have hV0 : (0 : ℝ) ≤ V := Nat.cast_nonneg _
  have h1 : D * V ≤ D * (((V : ℝ) + 1) * (u : ℝ) ^ τ) := by
    apply mul_le_mul_of_nonneg_left _ hD0
    exact le_trans (by linarith) (le_mul_of_one_le_right (by linarith) huτ)
  calc K * (((V : ℝ) + 1) * (u : ℝ) ^ τ + ((u : ℝ) + 1) ^ (c₁ + 1) * ((Bb : ℝ) + 2) ^ 2)
      ≤ K * (((V : ℝ) + 1) * (u : ℝ) ^ τ + D * (((V : ℝ) + 1) * (u : ℝ) ^ τ)) := by
        apply mul_le_mul_of_nonneg_left _ hK; linarith
    _ = K * (1 + D) * ((V : ℝ) + 1) * (u : ℝ) ^ τ := by ring

