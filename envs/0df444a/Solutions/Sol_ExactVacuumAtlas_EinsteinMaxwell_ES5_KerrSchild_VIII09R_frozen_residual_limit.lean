      have h3 : ContinuousAt (fun ε : ℝ => ε ^ 2 * (MA5z j R + ε ^ 2 * MA7z j R)) 0 :=
        (continuousAt_id.pow 2).mul h2
      exact continuousAt_const.add h3
    have h0 : (𝓝[≠] (0:ℝ)) ≤ 𝓝 (0:ℝ) := nhdsWithin_le_nhds
    have := hcont.tendsto.mono_left h0
    simpa using this
  rw [MA3z_eq j hR] at hpoly
  refine hpoly.congr' ?_
  have hbridge : (fun ε : ℝ => -(P R * (q3j j (1 / R) / R ^ 3))
        + ε ^ 2 * (MA5z j R + ε ^ 2 * MA7z j R))
      =ᶠ[𝓝[≠] (0:ℝ)]
      (fun ε : ℝ => MA3z j R + ε ^ 2 * (MA5z j R + ε ^ 2 * MA7z j R)) := by
    filter_upwards with ε
    rw [MA3z_eq j hR]
  exact hbridge.trans (frozen_div_cube j hR).symm
