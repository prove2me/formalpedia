/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D6: one backward record, one forward row

`Rn.bBodyS`: `bBody` at row `r` pushes `(recP r).reverse` onto `41`, adds `flg r` to `22` and
`(recP r).length` to `23`; `Rn.fBodyS`: `fBody` at `r' ` pushes `(rowP (m - 1 - r')).reverse` and adds
its length to `23`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem czP_length_le (m mw cB : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ) (r : ℕ) :
    (czP m mw cB L Mf r).length ≤ m := by
  unfold czP; exact (List.length_filterMap_le _ _).trans (by simp)

theorem recP_length (kk m mw cB : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ) (r : ℕ) :
    (recP kk m mw cB L Mf r).length = (czP m mw cB L Mf r).length + wbN m mw L r + 5 := by
  simp [recP, cbP]; omega

theorem rowP_length (Q m mw cB : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ) (r : ℕ) :
    (rowP Q m mw cB L Mf r).length = cwN m mw cB L r + 1 := by
  simp [rowP, fsP]

end J6Seg.PJ

