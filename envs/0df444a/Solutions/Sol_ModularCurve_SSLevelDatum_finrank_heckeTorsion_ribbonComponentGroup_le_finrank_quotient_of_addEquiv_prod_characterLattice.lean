  · subst h'; rw [tXadj, tXadj, if_pos rfl, if_neg h]; exact (Q.compSadj_diag_comm ℓ x).symm
  · rw [tXadj, tXadj, if_neg h, if_neg h']
    apply Prod.ext
    · exact Q.tVadj_comm ℓ ℓ' x.1
    · exact Q.tVadj_comm ℓ ℓ' x.2

