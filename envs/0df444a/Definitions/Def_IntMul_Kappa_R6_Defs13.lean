-- Source module: Solutions.R6ILSwap
/-!
# Round six, item language: the swap interfaces generic in the bit network (item I1)

The frozen 2^-182 machine has the OpenAI Lemma 12 table `KFL.l12prog` hard-wired in slot `0` of
`KFM.kTable`, and its interfaces carry the exponent `τS = 1 - 2^-50`. Here everything is
parametric in the Lemma 12 table `tab : Fin 1 → IStmt HS 1` (built from **any** round-six bit
network `C : QHNet (ZMod 2) W T m`) and in the exponent `τ`.

* `kTableP tab ext`: `KFM.kTable` with `tab` in slot `0` (slots `1 … 6` the FM multiplier, then
  `ext`), with the relabelling lemmas `kTableP_l12`, `kTableP_mul`, `kTableP_wrap`, `kTableP_ext`
  and `kTableP_mulOK`.
* **`L12Canon tab l12 τ`**: fine Lemma 12 with the canonical item size, the exact conclusion of
  `KFB.lemma12_fine_canon` with `τS → τ`, for the code `l12` run under the table `tab`: the two
  `[2^u]` fields of any bit array `binShape Pre G Suf (2^u)` are interchanged at cost
  `≤ K (V + 1) u^τ`, parameters read from the registers `kP, kG, kS, aU`.
* **`SwapNeedτ tab τ`**: `KFM.SwapNeed` with `kTable → kTableP tab`, `τS → τ`.
* `NetIL C`: the hypotheses on a round-six bit network used by the item-language interchange.

The theorems are in `R6ILSwapU` (`L12Canon → SwapNeedτ`), `R6IL12` (`ILProp11 → L12Canon`) and
`R6ILMain` (**`swapNeedτ_of_net`**).
-/

set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFM AModel AModelL12

noncomputable section

/-! ## The merged table with a parametric Lemma 12 slot -/

section Table

variable {E : ℕ}

/-- `KFM.kTable` with the Lemma 12 table `tab` in slot `0`. -/
noncomputable def kTableP (tab : Fin 1 → IStmt HS 1) (ext : Fin E → IStmt HS (7 + E)) :
    Fin (7 + E) → IStmt HS (7 + E) :=
  fun i =>
    if h0 : i.val = 0 then (tab 0).ren id (gL E)
    else if h1 : i.val = 1 then mulWrap (gM E)
    else if h7 : i.val < 7 then (mulProg ⟨i.val - 2, by omega⟩).ren ssE (gM E)
    else ext ⟨i.val - 7, by omega⟩

end Table

/-! ## Fine Lemma 12 with the canonical item size -/

/-- **Fine Lemma 12, canonical form** (`KFB.lemma12_fine_canon` with `τS → τ`, for any table
`tab` and code `l12`). The parameters `vol Pre, vol G, vol Suf, u` are on the registers
`kP, kG, kS, aU`; the bit array `enc2 xs` of shape `binShape Pre G Suf (2^u)` is stack `0`; the
scratch stacks `8 … 11, 15, 20, 21, 23, 24` are empty. -/
def L12Canon (tab : Fin 1 → IStmt HS 1) (l12 : IStmt HS 1) (τ : ℝ) : Prop :=
  ∃ K : ℝ, 0 ≤ K ∧
    ∀ (u : ℕ) (Pre G Suf : Shape), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      ∀ (I : List Sym) (s : IState HS) (F : Fin HS → List ℤ) (xs : List (ZMod 2))
        (LP LG LS LU : List ℤ),
      F KIL.kP = (vol Pre : ℤ) :: LP → F KIL.kG = (vol G : ℤ) :: LG →
      F KIL.kS = (vol Suf : ℤ) :: LS → F KIL.aU = (u : ℤ) :: LU → F 0 = enc2 xs →
      F 8 = [] → F 9 = [] → F 10 = [] → F 11 = [] → F 15 = [] → F 20 = [] → F 21 = [] →
      F 23 = [] → F 24 = [] →
      xs.length = vol (binShape Pre G Suf (2 ^ u)) →
      ∃ c : ℕ, IRuns I tab l12 (encK s F)
        (encK s (Function.update F 0 (enc2 (pull (binShape Pre G Suf (2 ^ u))
          (binShape Pre G Suf (2 ^ u)) (swapPos Pre.length (Pre.length + 1 + G.length)) 0 xs))))
        c ∧
        (c : ℝ) ≤ K * ((vol (binShape Pre G Suf (2 ^ u)) : ℝ) + 1) * (u : ℝ) ^ τ

/-! ## Uniform axis swaps on Gaussian arrays -/

/-- **`SwapNeed` with a parametric Lemma 12 slot and exponent** (`KFM.SwapNeed` with
`kTable → kTableP tab`, `τS → τ`). -/
def SwapNeedτ (tab : Fin 1 → IStmt HS 1) (τ : ℝ) : Prop :=
  ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (entry : Fin (7 + E)) (dS : Fin HS) (K : ℝ),
    dS ≠ 0 ∧ 0 ≤ K ∧
  ∀ (Isym : List Sym) (u w : ℕ) (sh : Shape) (p q : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) →
    p < q → q < sh.length → sh.getD p 0 = 2 ^ u → sh.getD q 0 = 2 ^ u →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = descSw w u p q sh →
    f 0 = gflat zs ++ l → zs.length = vol sh → GB w zs →
    ∃ c : ℕ, IRuns Isym (kTableP tab ext) (.call entry) (encK s f)
        (encK s (Function.update f 0 (gflat (pull sh sh (swapPos p q) 0 zs) ++ l))) c ∧
      (c : ℝ) ≤ K * (((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ τ +
        (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ))

/-! ## The round-six statements -/

/-- The hypotheses on a round-six bit network used by the item-language interchange (those of
`prop11H_formal`, as supplied by `Bit.BitNetR6MomStmt`): `2 ≤ m`, valid runs, admissible Bruhat
data and formal frame correctness at every power of every large prime. -/
structure NetIL {W T m : ℕ} (C : Bit.QHNet (ZMod 2) W T m) : Prop where
  m2 : 2 ≤ m
  runs : C.RunsOK
  ok : ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∀ f, C.EdgesOK (q ^ f) ∧ C.FormalOK (q ^ f)

end

end IntMul.Kappa.R6.IL

end

