    refine ⟨P × P, inferInstance, jg2_module g hg, sw5_finite_prod _, AddEquiv.refl _, ?_, ?_⟩
    · intro ℓ hℓ x
      have h1 := jg2_heckeGen_smul g hg ℓ x
      rw [hgne ℓ hℓ, LinearMap.prodMap_apply] at h1
      refine ⟨?_, ?_⟩
      · exact (congrArg (fun z : P × P => ((z.1 : P) : ↥(ssPlaces c M K) → ℤ)) h1).trans (hTcoe ℓ x.1)
      · exact (congrArg (fun z : P × P => ((z.2 : P) : ↥(ssPlaces c M K) → ℤ)) h1).trans (hTcoe ℓ x.2)
    · intro x
      have h1 := jg2_heckeGen_smul g hg ⟨s, hs⟩ x
      rw [hgs, hC] at h1
      refine ⟨?_, ?_⟩
      · refine (congrArg (fun z : P × P => ((z.1 : P) : ↥(ssPlaces c M K) → ℤ)) h1).trans ?_
        show (((T ⟨s, hs⟩ x.1 - x.2 : P)) : ↥(ssPlaces c M K) → ℤ) = _
        rw [Submodule.coe_sub, hTcoe]
        rfl
      · refine (congrArg (fun z : P × P => ((z.2 : P) : ↥(ssPlaces c M K) → ℤ)) h1).trans ?_
        show ((((((s : ℕ) : ℤ) • x.1 : P))) : ↥(ssPlaces c M K) → ℤ) = _
        rw [Submodule.coe_smul]
        rfl

private theorem sw5_exists_heckeCarriers_of_le
    (M s q' : ℕ) [NeZero M] [NeZero s] [Fact q'.Prime] (hs : s.Prime) [Fact s.Prime]
    (hq5 : 5 ≤ q') (hsq' : s ≠ q') (hq'M : ¬ q' ∣ M) (hsM : ¬ s ∣ M)
    (A : ValuationSubring (AlgebraicClosure ℚ))
    [DecidableEq (IsLocalRing.ResidueField ↥A)] [CharP (IsLocalRing.ResidueField ↥A) q']
    [Fintype ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A))] [Fintype ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A))] [DecidableEq ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A))] [DecidableEq ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A))]
    (X : SSLevelDatum q' (IsLocalRing.ResidueField ↥A) M s) (hlaws : X.HeckeLaws) :
    (∃ (Yo : Type) (_ : AddCommGroup Yo) (_ : Module HeckeAlg Yo) (_ : Module.Finite ℤ Yo)
        (eY : Yo ≃+ ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData)),
        ∀ (ℓ : Nat.Primes) (m : Yo),
          eY (heckeGen ℓ • m) = CerednikDrinfeld.heckeKernelMap X.heckeData ℓ (eY m)) ∧
    (∃ (Xo : Type) (_ : AddCommGroup Xo) (_ : Module HeckeAlg Xo) (_ : Module.Finite ℤ Xo)
        (eX : Xo ≃+ (↥(characterLattice ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A))) × ↥(characterLattice ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A))))),
        (∀ ℓ : Nat.Primes, (ℓ : ℕ) ≠ s → ∀ x : Xo,
          ((eX (heckeGen ℓ • x)).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) = (X.vertexHecke ℓ).mulVec ((eX x).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) ∧
          ((eX (heckeGen ℓ • x)).2 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) = (X.vertexHecke ℓ).mulVec ((eX x).2 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ)) ∧
        (∀ x : Xo,
          ((eX (heckeGen ⟨s, hs⟩ • x)).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) =
              (X.vertexHecke ⟨s, hs⟩).mulVec ((eX x).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) - ((eX x).2 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) ∧
          ((eX (heckeGen ⟨s, hs⟩ • x)).2 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ) = ((s : ℕ) : ℤ) • ((eX x).1 : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) → ℤ))) := by
  have hI := ModularCurve.SSLevelDatum.exists_heckeRowSums_and_adjointPair_laws M s q' hs hq5 hsq' hq'M hsM A X
  rcases hI with ⟨n1, h1, nV, hcolV, hrest⟩
  clear hrest h1 n1
  exact sw5_exists_heckeCarriers hs X hlaws nV hcolV

end SWA3

