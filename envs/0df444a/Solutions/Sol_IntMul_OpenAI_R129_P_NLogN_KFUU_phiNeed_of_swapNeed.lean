  unfold cSwV
  have e1 : ((d : ℝ) + 1) * ((w + 1) * ((↑(V' * 1) : ℝ) + 1) * (h : ℝ) ^ IntMul.OpenAI.R129.P.NLogN.KFS.τS) ≤
