-- title:
--   Erdős 287 continuous finite proof through the shared-square endpoint
-- statement:
--   Let $1<n_1<\cdots<n_k$ be integers whose reciprocals sum to one. Some consecutive gap has size at least three whenever the largest denominator is at most the exact shared-square endpoint given in Lean, approximately $1.83073882\times10^{970}$. The interval begins at zero.
-- source:
--   Erdős Problem 287. Continuous assembly of Proved finite intervals.

import Mathlib

theorem Erdos287.max_gap_three_through_shared_square_anchor (k : ℕ) (hk : 2 ≤ k) (f : ℕ → ℕ)
    (hf1 : ∀ i, i < k → 1 < f i)
    (hmono : ∀ i j, i < j → j < k → f i < f j)
    (hsum : ∑ i ∈ Finset.range k, (1 : ℚ) / f i = 1)
    (hbound : f (k - 1) ≤ ) :
    ∃ i, i + 1 < k ∧ 3 ≤ f (i + 1) - f i := by sorry
