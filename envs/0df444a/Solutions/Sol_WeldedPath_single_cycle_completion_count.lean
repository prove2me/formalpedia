theorem reachable_transfer {V : Type*} {H K : SimpleGraph V}
    (h : ∀ a b, H.Adj a b → K.Reachable a b) {a b : V}
    (hab : H.Reachable a b) : K.Reachable a b := by
  obtain ⟨p⟩ := hab
  induction p with
  | nil => exact SimpleGraph.Reachable.rfl
  | cons hadj p ih => exact (h _ _ hadj).trans ih

theorem fromRel_reachable {V : Type*} {R : V → V → Prop} {a b : V}
    (h : R a b) : (SimpleGraph.fromRel R).Reachable a b := by
  by_cases hab : a = b
  · subst b
    exact SimpleGraph.Reachable.rfl
  · exact (show (SimpleGraph.fromRel R).Adj a b from ⟨hab, Or.inl h⟩).reachable

def sourceSwap {n : ℕ} {G : WeldedInstance n} (π : Equiv.Perm G.edges)
    (e f : G.edges) : Equiv.Perm G.edges := (Equiv.swap e f).trans π

theorem sourceSwap_apply_left {n : ℕ} {G : WeldedInstance n} (π : Equiv.Perm G.edges)
    (e f : G.edges) : sourceSwap π e f e = π f := by simp [sourceSwap]

theorem sourceSwap_apply_right {n : ℕ} {G : WeldedInstance n} (π : Equiv.Perm G.edges)
    (e f : G.edges) : sourceSwap π e f f = π e := by simp [sourceSwap]

theorem sourceSwap_apply_other {n : ℕ} {G : WeldedInstance n} (π : Equiv.Perm G.edges)
    {e f d : G.edges} (hde : d ≠ e) (hdf : d ≠ f) : sourceSwap π e f d = π d := by
  simp [sourceSwap, Equiv.swap_apply_of_ne_of_ne hde hdf]

theorem sourceSwap_involutive {n : ℕ} {G : WeldedInstance n} (π : Equiv.Perm G.edges)
    (e f : G.edges) : sourceSwap (sourceSwap π e f) e f = π := by
  ext d
  simp [sourceSwap]

theorem sourceSwap_isEdgePerm {n l : ℕ} {G : WeldedInstance n}
    {π : Equiv.Perm G.edges} (hπ : G.IsEdgePerm l π) (e f : G.edges)
    (hclass : G.bEdge l e.1 = G.bEdge l f.1) (hnone : G.bEdge l e.1 ≠ none) :
    G.IsEdgePerm l (sourceSwap π e f) := by
  intro d
  by_cases hde : d = e
  · subst d
    rw [sourceSwap_apply_left]
    exact ⟨(hπ f).1.trans hclass.symm, fun h => (hnone h).elim⟩
  · by_cases hdf : d = f
    · subst d
      rw [sourceSwap_apply_right]
      exact ⟨(hπ e).1.trans hclass, fun h => (hnone (hclass.trans h)).elim⟩
    · rw [sourceSwap_apply_other π hde hdf]
      exact hπ d

theorem sourceSwap_agrees {n : ℕ} {G : WeldedInstance n} (π : Equiv.Perm G.edges)
    (D : Finset G.edges) {e f : G.edges} (he : e ∉ D) (hf : f ∉ D) :
    ∀ d ∈ D, sourceSwap π e f d = π d := by
  intro d hd
  exact sourceSwap_apply_other π (fun h => he (h ▸ hd)) (fun h => hf (h ▸ hd))

def fixedGraph {n : ℕ} (G : WeldedInstance n) (π : Equiv.Perm G.edges)
    (e f : G.edges) : SimpleGraph ℕ :=
  SimpleGraph.fromRel fun a b => ∃ d : G.edges,
    d ≠ e ∧ d ≠ f ∧ d.1 ∈ G.weldEdges ∧ a = d.1.tail ∧ b = (π d).1.head n

theorem fixedGraph_le {n : ℕ} (G : WeldedInstance n) (π : Equiv.Perm G.edges)
    (e f : G.edges) : fixedGraph G π e f ≤ G.permWeldGraph π := by
  intro a b hab
  rcases hab with ⟨hne, h | h⟩
  · obtain ⟨d, _, _, hd, ha, hb⟩ := h
    exact ⟨hne, Or.inl ⟨d, hd, ha, hb⟩⟩
  · obtain ⟨d, _, _, hd, ha, hb⟩ := h
    exact ⟨hne, Or.inr ⟨d, hd, ha, hb⟩⟩

theorem fixedGraph_sourceSwap {n : ℕ} (G : WeldedInstance n) (π : Equiv.Perm G.edges)
    (e f : G.edges) : fixedGraph G (sourceSwap π e f) e f = fixedGraph G π e f := by
  unfold fixedGraph
  congr 1
  funext a b
  apply propext
  constructor
  · rintro ⟨d, hde, hdf, hd, ha, hb⟩
    exact ⟨d, hde, hdf, hd, ha, by simpa only [sourceSwap_apply_other π hde hdf] using hb⟩
  · rintro ⟨d, hde, hdf, hd, ha, hb⟩
    exact ⟨d, hde, hdf, hd, ha, by simpa only [sourceSwap_apply_other π hde hdf] using hb⟩

theorem perm_edge_reachable {n : ℕ} (G : WeldedInstance n) (π : Equiv.Perm G.edges)
    {e : G.edges} (he : e.1 ∈ G.weldEdges) :
    (G.permWeldGraph π).Reachable e.1.tail ((π e).1.head n) := by
  exact fromRel_reachable (R := fun a b => ∃ d : G.edges,
    d.1 ∈ G.weldEdges ∧ a = d.1.tail ∧ b = (π d).1.head n) ⟨e, he, rfl, rfl⟩

theorem singleCycle_sourceSwap {n : ℕ} (G : WeldedInstance n)
    (π : Equiv.Perm G.edges) (e f : G.edges)
    (he : e.1 ∈ G.weldEdges) (hf : f.1 ∈ G.weldEdges)
    (hpath : (fixedGraph G π e f).Reachable ((π e).1.head n) ((π f).1.head n))
    (hcycle : G.SingleCycle π) : G.SingleCycle (sourceSwap π e f) := by
  have hsub : fixedGraph G π e f ≤ G.permWeldGraph (sourceSwap π e f) := by
    rw [← fixedGraph_sourceSwap G π e f]
    exact fixedGraph_le G _ e f
  have hpath' := SimpleGraph.Reachable.mono hsub hpath
  have hdir (d : G.edges) (hd : d.1 ∈ G.weldEdges) :
      (G.permWeldGraph (sourceSwap π e f)).Reachable d.1.tail ((π d).1.head n) := by
    by_cases hde : d = e
    · subst d
      have hnew := perm_edge_reachable G (sourceSwap π e f) he
      rw [sourceSwap_apply_left] at hnew
      exact hnew.trans hpath'.symm
    · by_cases hdf : d = f
      · subst d
        have hnew := perm_edge_reachable G (sourceSwap π e f) hf
        rw [sourceSwap_apply_right] at hnew
        exact hnew.trans hpath'
      · have hnew := perm_edge_reachable G (sourceSwap π e f) hd
        simpa only [sourceSwap_apply_other π hde hdf] using hnew
  have hsim : ∀ a b, (G.permWeldGraph π).Adj a b →
      (G.permWeldGraph (sourceSwap π e f)).Reachable a b := by
    intro a b hab
    rcases hab with ⟨_, h | h⟩
    · obtain ⟨d, hd, rfl, rfl⟩ := h
      exact hdir d hd
    · obtain ⟨d, hd, rfl, rfl⟩ := h
      exact (hdir d hd).symm
  intro a b ha hb
  exact reachable_transfer hsim (hcycle a b ha hb)

theorem singleCycle_sourceSwap_iff {n : ℕ} (G : WeldedInstance n)
    (π : Equiv.Perm G.edges) (e f : G.edges)
    (he : e.1 ∈ G.weldEdges) (hf : f.1 ∈ G.weldEdges)
    (hpath : (fixedGraph G π e f).Reachable ((π e).1.head n) ((π f).1.head n)) :
    G.SingleCycle (sourceSwap π e f) ↔ G.SingleCycle π := by
  refine ⟨?_, singleCycle_sourceSwap G π e f he hf hpath⟩
  intro hcycle
  have hp : (fixedGraph G (sourceSwap π e f) e f).Reachable
      ((sourceSwap π e f e).1.head n) ((sourceSwap π e f f).1.head n) := by
    simpa only [fixedGraph_sourceSwap, sourceSwap_apply_left, sourceSwap_apply_right]
      using hpath.symm
  simpa only [sourceSwap_involutive] using
    singleCycle_sourceSwap G (sourceSwap π e f) e f he hf hp hcycle

