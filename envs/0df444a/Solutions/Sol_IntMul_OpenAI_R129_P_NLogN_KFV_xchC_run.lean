  | [], L, _ => by
    simp only [List.map_nil, NLogN.KFV.pushL, List.reverse_nil, List.nil_append, cPushL, List.sum_nil]
    exact ⟨trivial, rfl, by simp [RS.cost]⟩
  | p :: ps, L, h => by
    obtain ⟨hE, hc, hr⟩ := h p (by simp)
    have hE' : EV (encK S (Function.update f i L)) B p.1 p.2 :=
      hE.encK fun r hr' => by simp [Function.update_apply, hr r hr']
    have P1 := Sp.pushQ S (Function.update f i L) (i := i) hi hc hE'.1 hE'.2.2
    rw [hE'.2.1, Function.update_self, Function.update_idem] at P1
    have P2 := pushL_sp S f hi ps (p.2 :: L) (fun q hq => h q (by simp [hq]))
    have := P1.seq P2
    simp only [List.map_cons, NLogN.KFV.pushL, List.reverse_cons, List.append_assoc, List.singleton_append]
    refine this.mono ?_
    simp only [cPushL, List.map_cons, List.sum_cons]
    omega

theorem popN_sp (S : IState HS) (f : Fin HS → List ℤ) {i : Fin HS} (hi : i.val < 56) {B : ℕ} :
    ∀ (vs L : List ℤ), (∀ v ∈ vs, zsz v ≤ B) →
      KIL.Sp (popN i vs.length) (encK S (Function.update f i (vs ++ L)))
        (encK S (Function.update f i L)) (vs.length * (2 * B + 2) + 1)
  | [], L, _ => ⟨trivial, rfl, by simp [popN, RS.cost]⟩
  | v :: vs, L, h => by
    have P1 := Sp.pop (s := S) (f := Function.update f i (v :: vs ++ L)) (i := i) (a := v)
      (l := vs ++ L) (B := B) hi (by simp) (h v (by simp))
    rw [Function.update_idem] at P1
    have P2 := popN_sp S f hi vs L (fun w hw => h w (by simp [hw]))
    refine (P1.seq P2).mono ?_
    simp only [List.length_cons]; ring_nf; omega

theorem upd_o0_nil (v : List ℤ) {j : Fin HS} (hj : j ≠ 0) : Function.update (o0 v) j [] = o0 v := by
  funext x; by_cases h : x = j
  · subst h; simp [o0_ne v hj]
  · simp [Function.update_apply, h]

theorem vol_sh5 (i K m E : ℕ) : vol (sh5 i K m E) = 2 ^ (i + K + m + K + E) := by
  simp [sh5, vol, pow_add]; ring

end NLogN.KFV

end

