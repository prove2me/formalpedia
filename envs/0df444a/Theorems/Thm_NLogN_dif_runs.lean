open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem NLogN.dif_runs (pD : Fin P) (hP : iprog pD = difBody pD) (n : ℕ) (hn : 1 ≤ n) :
    ∀ j (s : IState NS) (A : List ℤ) (R LL LE LN LF : List Item) (E : ℕ),
      A.length = 2 ^ j → (j = 0 ∨ 2 ^ j * E = 2 * n) → Canon (2 ^ n + 1) A →
      s.G DX = ints A ++ R → s.G DL = .int (2 ^ j) :: LL → s.G NLogN.DE = .int (2 ^ E) :: LE →
      s.G RN = .int (2 ^ n) :: LN → s.G RF = .int (2 ^ n + 1) :: LF →
      IRuns I iprog (.call pD) s (s.upd DX (ints (difZ (2 ^ n + 1) E j A) ++ R)) (difCost n j) := by sorry
