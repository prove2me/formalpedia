/-- Every compact Pauli question map is the registered map in product coordinates. -/
theorem pauliMap_equiv (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (t : _root_.MIPStarRE.QPBT.Palomar.PauliType)
    (z : _root_.MIPStarRE.QPBT.Palomar.PauliSpace (_root_.MIPStarRE.QPBT.Palomar.PauliParams.ofAdmissibleParams P) (_root_.MIPStarRE.QPBT.PauliScalar P)) :
    _root_.MIPStarRE.QPBT.Palomar.pauliSpaceEquiv P
        (_root_.MIPStarRE.QPBT.Palomar.pauliMap (_root_.MIPStarRE.QPBT.Palomar.PauliParams.ofAdmissibleParams P)
          (_root_.MIPStarRE.QPBT.binaryRepresentation P.model) t z) =
      _root_.MIPStarRE.QPBT.pauliCL P (_root_.MIPStarRE.QPBT.Palomar.pauliTypeEquiv t) (_root_.MIPStarRE.QPBT.Palomar.pauliSpaceEquiv P z) := by
  cases t with
  | point W =>
      simpa [_root_.MIPStarRE.QPBT.Palomar.pauliMap, _root_.MIPStarRE.QPBT.pauliCL, _root_.MIPStarRE.QPBT.Palomar.pauliTypeEquiv,
        _root_.MIPStarRE.QPBT.Palomar.lowDegreeTypeEquiv, _root_.MIPStarRE.QPBT.ldCL] using
        _root_.MIPStarRE.QPBT.Palomar.pauliEmbeddedLowDegreeMap_equiv P W .point z
  | aline W =>
      simpa [_root_.MIPStarRE.QPBT.Palomar.pauliMap, _root_.MIPStarRE.QPBT.pauliCL, _root_.MIPStarRE.QPBT.Palomar.pauliTypeEquiv,
        _root_.MIPStarRE.QPBT.Palomar.lowDegreeTypeEquiv, _root_.MIPStarRE.QPBT.ldCL] using
        _root_.MIPStarRE.QPBT.Palomar.pauliEmbeddedLowDegreeMap_equiv P W .aline z
  | dline W =>
      simpa [_root_.MIPStarRE.QPBT.Palomar.pauliMap, _root_.MIPStarRE.QPBT.pauliCL, _root_.MIPStarRE.QPBT.Palomar.pauliTypeEquiv,
        _root_.MIPStarRE.QPBT.Palomar.lowDegreeTypeEquiv, _root_.MIPStarRE.QPBT.ldCL] using
        _root_.MIPStarRE.QPBT.Palomar.pauliEmbeddedLowDegreeMap_equiv P W .dline z
  | pauli W =>
      funext i
      rcases i with ((((i | i) | u) | i) | u) | u <;> rfl
  | pairW W | pair | constraint _ | _ =>
      exact _root_.MIPStarRE.QPBT.Palomar.pauliSharedProjection_equiv P z

/-- The compact question PMF is exactly the registered question distribution. -/
theorem pauliQuestionPMF_map (P : _root_.MIPStarRE.QPBT.AdmissibleParams) :
    (_root_.MIPStarRE.QPBT.Palomar.pauliQuestionPMF (_root_.MIPStarRE.QPBT.Palomar.PauliParams.ofAdmissibleParams P)
        (_root_.MIPStarRE.QPBT.binaryRepresentation P.model)).map (_root_.MIPStarRE.QPBT.Palomar.pauliQuestionPairEquiv P) =
      (_root_.MIPStarRE.QPBT.pauliBasisTest P).μ.toPMF
        (_root_.MIPStarRE.QPBT.pauliBasisTest P).μ_prob := by
  classical
  letI : Nonempty _root_.MIPStarRE.QPBT.PauliEdge := _root_.MIPStarRE.QPBT.pauliEdge_nonempty
  let compactMap := fun s : _root_.MIPStarRE.QPBT.Palomar.PauliEdge ×
      _root_.MIPStarRE.QPBT.Palomar.PauliSpace (_root_.MIPStarRE.QPBT.Palomar.PauliParams.ofAdmissibleParams P) (_root_.MIPStarRE.QPBT.PauliScalar P) =>
    ((s.1.1.1, _root_.MIPStarRE.QPBT.Palomar.pauliMap (_root_.MIPStarRE.QPBT.Palomar.PauliParams.ofAdmissibleParams P)
        (_root_.MIPStarRE.QPBT.binaryRepresentation P.model) s.1.1.1 s.2),
      (s.1.1.2, _root_.MIPStarRE.QPBT.Palomar.pauliMap (_root_.MIPStarRE.QPBT.Palomar.PauliParams.ofAdmissibleParams P)
        (_root_.MIPStarRE.QPBT.binaryRepresentation P.model) s.1.1.2 s.2))
  let originalMap := fun s :
      _root_.MIPStarRE.QPBT.PauliEdge × _root_.MIPStarRE.QPBT.PauliSpace P =>
    ((s.1.1.1, _root_.MIPStarRE.QPBT.pauliCL P s.1.1.1 s.2),
      (s.1.1.2, _root_.MIPStarRE.QPBT.pauliCL P s.1.1.2 s.2))
  have hcomm : _root_.MIPStarRE.QPBT.Palomar.pauliQuestionPairEquiv P ∘ compactMap =
      originalMap ∘ _root_.MIPStarRE.QPBT.Palomar.pauliSourceEquiv P := by
    funext s
    apply Prod.ext
    · apply Prod.ext
      · rfl
      · exact _root_.MIPStarRE.QPBT.Palomar.pauliMap_equiv P s.1.1.1 s.2
    · apply Prod.ext
      · rfl
      · exact _root_.MIPStarRE.QPBT.Palomar.pauliMap_equiv P s.1.1.2 s.2
  rw [show _root_.MIPStarRE.QPBT.Palomar.pauliQuestionPMF (_root_.MIPStarRE.QPBT.Palomar.PauliParams.ofAdmissibleParams P)
      (_root_.MIPStarRE.QPBT.binaryRepresentation P.model) =
        (PMF.uniformOfFintype _).map compactMap by rfl]
  rw [PMF.map_comp, hcomm, ← PMF.map_comp]
  rw [_root_.LIDT.PMF.uniformOfFintype_map_equiv (_root_.MIPStarRE.QPBT.Palomar.pauliSourceEquiv P)]
  have hmap :=
    (_root_.LIDT.MIPStarRE.LDT.Distribution.toPMF_map
      (_root_.LIDT.MIPStarRE.LDT.uniformDistribution
        (_root_.MIPStarRE.QPBT.PauliEdge × _root_.MIPStarRE.QPBT.PauliSpace P))
      (_root_.LIDT.MIPStarRE.LDT.uniformDistribution_isProbability
        (_root_.MIPStarRE.QPBT.PauliEdge × _root_.MIPStarRE.QPBT.PauliSpace P)) originalMap).symm
  rw [_root_.LIDT.MIPStarRE.LDT.uniformDistribution_toPMF] at hmap
  simpa only [_root_.MIPStarRE.QPBT.pauliBasisTest,
    _root_.MIPStarRE.QPBT.pauliQuestionDistribution] using hmap

