attribute [local instance] torusBorel borelSpace_torusBorel t0140 t0147

private theorem t0509 (v : HeightOneSpectrum (𝓞 K)) (u : (v.adicCompletion K)ˣ) :
    unitAt v (d004 v u) = u :=
  Units.ext (t0034 v u)

private theorem t0510 (v : HeightOneSpectrum (𝓞 K)) (u : (v.adicCompletion K)ˣ)
    {w : HeightOneSpectrum (𝓞 K)} (hw : w ≠ v) : unitAt w (d004 v u) = 1 :=
  Units.ext (t0035 v u hw)

private theorem t0511 (S : Finset (HeightOneSpectrum (𝓞 K))) (v : HeightOneSpectrum (𝓞 K))
    {u : (v.adicCompletion K)ˣ} (hu : Valued.v (u : v.adicCompletion K) = 1) : d004 v u ∈ unitIdelesAt S := by
  rw [t0137]
  intro w
  by_cases hw : w.1 = v
  · subst hw
    rw [t0509]
    exact hu
  · rw [t0510 v u hw, Units.val_one, map_one]

private theorem t0512 (v : HeightOneSpectrum (𝓞 K)) {u : (v.adicCompletion K)ˣ}
    (hu : Valued.v (u : v.adicCompletion K) = 1) : d004 v u ∈ normOneIdeles K := by
  rw [mem_normOneIdeles_iff, t0261, hu, WithZero.log_one, zpow_zero]

private theorem t0513 {z : (AdeleRing (𝓞 K) K)ˣ} (hz : z ∈ normOneIdeles K) :
    d021 z = z := by
  rw [d021, (mem_normOneIdeles_iff z).1 hz, Real.log_one, neg_zero, t0116, mul_one]

private theorem t0514 {z : (AdeleRing (𝓞 K) K)ˣ} (hz : z ∈ normOneIdeles K) :
    ((d038 S z : ↥(torusClass (K := K) S)) : NormOneQuot (K := K)) = QuotientGroup.mk ⟨z, hz⟩ := by
  rw [t0335, t0277]
  congr 1
  exact Subtype.ext (t0513 hz)

private theorem t0515 (v : HeightOneSpectrum (𝓞 K))
    (u : (v.adicCompletion K)ˣ) (g : AdelicGL2 (𝓞 K) K) (i j : Fin 2) :
    componentMatrix v (diagOne (d004 v u) * g) i j =
      ![(u : v.adicCompletion K), 1] i * componentMatrix v g i j := by
  rw [t0103, t0509]

private theorem t0516 (v : HeightOneSpectrum (𝓞 K))
    (u : (v.adicCompletion K)ˣ) {w : HeightOneSpectrum (𝓞 K)} (hw : w ≠ v) (g : AdelicGL2 (𝓞 K) K) (i j : Fin 2) :
    componentMatrix w (diagOne (d004 v u) * g) i j = componentMatrix w g i j := by
  rw [t0103, t0510 v u hw, Units.val_one]
  fin_cases i <;> simp

private theorem t0517 (v : HeightOneSpectrum (𝓞 K)) {u : (v.adicCompletion K)ˣ}
    (hu : Valued.v (u : v.adicCompletion K) = 1) (w : HeightOneSpectrum (𝓞 K)) (m : ℕ) (g : AdelicGL2 (𝓞 K) K) :
    MemZK0At w m (diagOne (d004 v u) * g) ↔ MemZK0At w m g := by
  by_cases hw : w = v
  · subst hw
    simp only [MemZK0At, t0515, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons, one_mul, map_mul, hu]
  · simp only [MemZK0At, t0516 v u hw]

private theorem t0518 (d : JLData K S epsS ω) {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ S)
    {u : (v.adicCompletion K)ˣ} (hu : Valued.v (u : v.adicCompletion K) = 1) (g : AdelicGL2 (𝓞 K) K) :
    d.epsChar (diagOne (d004 v u) * g) = ((epsS v u : ℂˣ) : ℂ) * d.epsChar g := by
  have hfac : ∀ w : ↥S,
      TateLocal.charExt (localChar ω w.1) (componentMatrix w.1 (diagOne (d004 v u) * g) 1 1) *
          TateLocal.charExt (epsS w.1) (componentMatrix w.1 (diagOne (d004 v u) * g) 0 0 /
            componentMatrix w.1 (diagOne (d004 v u) * g) 1 1) =
        (if w = ⟨v, hv⟩ then ((epsS v u : ℂˣ) : ℂ) else 1) *
          (TateLocal.charExt (localChar ω w.1) (componentMatrix w.1 g 1 1) *
            TateLocal.charExt (epsS w.1) (componentMatrix w.1 g 0 0 / componentMatrix w.1 g 1 1)) := by
    intro w
    by_cases hw : w = ⟨v, hv⟩
    · subst hw
      simp only [t0515, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.head_cons, one_mul, if_true, mul_div_assoc, t0083]
      ring
    · have hw' : w.1 ≠ v := fun h => hw (Subtype.ext h)
      simp only [t0516 v u hw', if_neg hw, one_mul]
  have hiff : (∀ w : ↥S, MemZK0At w.1 (d.m w) (diagOne (d004 v u) * g)) ↔ ∀ w : ↥S, MemZK0At w.1 (d.m w) g :=
    forall_congr' fun w => t0517 v hu w.1 (d.m w) g
  unfold JLData.epsChar
  simp only [hiff]
  split_ifs with h
  · rw [Finset.prod_congr rfl (fun w _ => hfac w), Finset.prod_mul_distrib, Finset.prod_ite_eq']
    simp only [Finset.mem_univ, if_true]
  · rw [mul_zero]

private theorem t0519 (v : HeightOneSpectrum (𝓞 K)) (h : GL (Fin 2) (v.adicCompletion K))
    (z g : AdelicGL2 (𝓞 K) K) :
    ∃ h' : GL (Fin 2) (v.adicCompletion K), z * (placeEmbed K v h * g) = z * g * placeEmbed K v h' := by
  refine ⟨compAt v ((z * g)⁻¹ * (z * (placeEmbed K v h * g))), ?_⟩
  have key : (z * g)⁻¹ * (z * (placeEmbed K v h * g)) =
      placeEmbed K v (compAt v ((z * g)⁻¹ * (z * (placeEmbed K v h * g)))) := by
    refine t0018 ?_ fun w => ?_
    · rw [t0019, map_mul, map_inv, map_mul, map_mul, map_mul, t0019, one_mul, mul_inv_rev,
        mul_assoc, inv_mul_cancel_left, inv_mul_cancel]
    · by_cases hw : w = v
      · subst hw
        rw [t0003]
      · rw [t0004 hw, map_mul, map_inv, map_mul, map_mul, map_mul, t0004 hw,
          one_mul, mul_inv_rev, mul_assoc, inv_mul_cancel_left, inv_mul_cancel]
  rw [← key, mul_inv_cancel_left]

private theorem t0520 (dF : FinWhittakerDatum K S Pi) {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ S)
    (h : GL (Fin 2) (v.adicCompletion K)) (z g : AdelicGL2 (𝓞 K) K) :
    dF.Wf (z * (placeEmbed K v h * g)) = dF.Wf (z * g) := by
  obtain ⟨h', hh'⟩ := t0519 v h z g
  rw [hh', dF.blind_at v hv]

private theorem t0521 (v : HeightOneSpectrum (𝓞 K)) (h : GL (Fin 2) (v.adicCompletion K))
    (z g : AdelicGL2 (𝓞 K) K) :
    archW' archR archC dR dC (z * (placeEmbed K v h * g)) = archW' archR archC dR dC (z * g) :=
  t0125 archR archC dR dC
    (fun w hw => by
      rw [t0142, t0142]
      simp only [map_mul, t0019, one_mul])
    (fun w hw => by
      rw [t0143, t0143]
      simp only [map_mul, t0019, one_mul])

private theorem t0522 (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ S) {u : (v.adicCompletion K)ˣ}
    (hu : Valued.v (u : v.adicCompletion K) = 1) (g : AdelicGL2 (𝓞 K) K) (α : Kˣ) :
    d010 d archR archC dR dC dF (diagOne (d004 v u) * g) α =
      ((epsS v u : ℂˣ) : ℂ) * d010 d archR archC dR dC dF g α := by
  unfold d010
  rw [t0518 d hv hu, t0392, t0521,
    t0520 dF hv]
  ring1

private theorem t0523 (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ S) {u : (v.adicCompletion K)ˣ}
    (hu : Valued.v (u : v.adicCompletion K) = 1) (g : AdelicGL2 (𝓞 K) K) (α : Kˣ) :
    dualSeriesTerm d archR archC dR dC dF (diagOne (d004 v u) * g) α =
      ((epsS v u : ℂˣ) : ℂ) * dualSeriesTerm d archR archC dR dC dF g α := by
  unfold dualSeriesTerm
  rw [t0518 d hv hu, t0392, t0521,
    t0520 dF hv]
  ring1

private theorem t0524 (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ S) {u : (v.adicCompletion K)ˣ}
    (hu : Valued.v (u : v.adicCompletion K) = 1) (g : AdelicGL2 (𝓞 K) K) :
    jlSeries' d archR archC dR dC dF (diagOne (d004 v u) * g) =
      ((epsS v u : ℂˣ) : ℂ) * jlSeries' d archR archC dR dC dF g := by
  rw [t0146, t0146]
  simp only [t0522 archR archC dR dC d dF hv hu]
  exact tsum_mul_left

private theorem t0525 (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ S) {u : (v.adicCompletion K)ˣ}
    (hu : Valued.v (u : v.adicCompletion K) = 1) (g : AdelicGL2 (𝓞 K) K) :
    dualSeries' d archR archC dR dC dF (diagOne (d004 v u) * g) =
      ((epsS v u : ℂˣ) : ℂ) * dualSeries' d archR archC dR dC dF g := by
  unfold dualSeries'
  simp only [t0523 archR archC dR dC d dF hv hu]
  exact tsum_mul_left

private theorem t0526 {v : HeightOneSpectrum (𝓞 K)} {u : (v.adicCompletion K)ˣ}
    (hn : d004 v u ∈ normOneIdeles K) (q : ↥(torusClass (K := K) S)) :
    (QuotientGroup.mk (torusLift (d038 S (d004 v u) * q)) : NormOneQuot (K := K)) =
      QuotientGroup.mk (torusLift q * ⟨d004 v u, hn⟩) := by
  rw [mul_comm (torusLift q)]
  simp only [t0236, QuotientGroup.mk_mul, Subgroup.coe_mul, t0514 hn]

private theorem t0527 (d : JLData K S epsS ω)
    (dF : FinWhittakerDatum K S Pi) (g : AdelicGL2 (𝓞 K) K) {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ S)
    {u : (v.adicCompletion K)ˣ} (hu : Valued.v (u : v.adicCompletion K) = 1)
    (p : ↥(torusClass (K := K) S) × ℝ) :
    jlSeries' d archR archC dR dC dF (torusPoint g (d038 S (d004 v u) * p.1, p.2)) =
      ((epsS v u : ℂˣ) : ℂ) * jlSeries' d archR archC dR dC dF (torusPoint g p) := by
  have hn : d004 v u ∈ normOneIdeles K := t0512 v hu
  have hy : ((torusLift p.1 * ⟨d004 v u, hn⟩ : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) ∈
      unitIdelesAt S := by
    rw [Subgroup.coe_mul]
    exact Subgroup.mul_mem _ (t0235 p.1) (t0511 S v hu)
  unfold torusPoint
  rw [t0232 d archR archC dR dC dF (t0235 _) hy
    (t0526 hn p.1)]
  rw [Subgroup.coe_mul, mul_comm ((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ), mul_assoc,
    map_mul diagOne ((⟨d004 v u, hn⟩ : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ)]

  show jlSeries' d archR archC dR dC dF (diagOne (d004 v u) *
        diagOne (((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) *
          Ideles.archScale K p.2) * g) =
      ((epsS v u : ℂˣ) : ℂ) *
        jlSeries' d archR archC dR dC dF
          (diagOne (((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) *
            Ideles.archScale K p.2) * g)
  rw [mul_assoc, t0524 archR archC dR dC d dF hv hu]

private theorem t0528 (hω : IsAdmissibleTwist K ω)
    (hωunr : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S → IsUnramifiedCharAt ω v)
    (hωb : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S →
      ((ω (uniformizerIdele K v) : ℂˣ) : ℂ) =
        (Pi.twist fun v => (((Ideal.absNorm v.asIdeal : ℝ) ^ (-(1 / 2 : ℝ)) : ℝ) : ℂ)).b v)
    (hωR : ∀ (w : InfinitePlace K) (hw : w.IsReal),
      IsArchCompAt K ω w (archR w hw).centralExponent ((archR w hw).centralSign.val : ℤ))
    (hωC : ∀ (w : InfinitePlace K) (hw : w.IsComplex),
      IsArchCompAt K ω w (archC w hw).centralExponent (archC w hw).centralTwist)
    (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi) (g : AdelicGL2 (𝓞 K) K)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∈ S) {u : (v.adicCompletion K)ˣ}
    (hu : Valued.v (u : v.adicCompletion K) = 1) (p : ↥(torusClass (K := K) S) × ℝ) :
    dualSeries' d archR archC dR dC dF (torusPoint g (d038 S (d004 v u) * p.1, p.2)) =
      ((epsS v u : ℂˣ) : ℂ) * dualSeries' d archR archC dR dC dF (torusPoint g p) := by
  have hn : d004 v u ∈ normOneIdeles K := t0512 v hu
  have hy : ((torusLift p.1 * ⟨d004 v u, hn⟩ : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) ∈
      unitIdelesAt S := by
    rw [Subgroup.coe_mul]
    exact Subgroup.mul_mem _ (t0235 p.1) (t0511 S v hu)
  unfold torusPoint
  rw [t0470 hω hωunr hωb hωR hωC d dR dC dF (t0235 _) hy
    (t0526 hn p.1)]
  rw [Subgroup.coe_mul, mul_comm ((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ), mul_assoc,
    map_mul diagOne ((⟨d004 v u, hn⟩ : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ)]

  show dualSeries' d archR archC dR dC dF (diagOne (d004 v u) *
        diagOne (((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) *
          Ideles.archScale K p.2) * g) =
      ((epsS v u : ℂˣ) : ℂ) *
        dualSeries' d archR archC dR dC dF
          (diagOne (((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) *
            Ideles.archScale K p.2) * g)
  rw [mul_assoc, t0525 archR archC dR dC d dF hv hu]

private theorem t0529 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (q : ↥(torusClass (K := K) S)) :
    MeasureTheory.MeasurePreserving (fun p : ↥(torusClass (K := K) S) × ℝ => (q * p.1, p.2)) (d012 S)
      (d012 S) := by
  haveI := t0147 (K := K) S
  exact (MeasureTheory.measurePreserving_mul_left (d011 S) q).prod
    (MeasureTheory.MeasurePreserving.id MeasureTheory.volume)

private theorem t0530 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (q : ↥(torusClass (K := K) S)) (f : ↥(torusClass (K := K) S) × ℝ → ℂ) :
    ∫ p, f (q * p.1, p.2) ∂(d012 S) = ∫ p, f p ∂(d012 S) :=
  (t0529 S q).integral_comp
