    FiniteDimensional.of_finrank_pos (K := K) (V := ↥W) (by rw [_hrank]; exact Nat.zero_lt_two)
  have hWle : W ≤ ((tateSub _hsmul D.toric).baseChange O'').baseChange K :=
    le_of_one_lt_finrank_inf W _ hgt _hrank

  obtain ⟨σ, hσI, n, a, hμa, hnot1⟩ :=
    exists_inertiaSubgroupIn_rootOfUnity_pow_ne_one lam Fact.out A hA
