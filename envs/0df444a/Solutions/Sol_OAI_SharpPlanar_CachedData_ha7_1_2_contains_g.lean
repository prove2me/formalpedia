lemma ha7_1_2_eq (j : Fin 7) : ha7_1_2 j = ((ha7_1_1 j).mul (piI.mul (atomPoints j).z)).scale 1 2 := by fin_cases j <;> decide +kernel
lemma ha7_1_2_contains_g_oai (j : Fin 7) : (ha7_1_2 j).Contains (fullFactor true 7 2 ((j.val:ℝ)/6)) := by
  rw [ha7_1_2_eq]
  simpa only [Bool.false_eq_true,ite_false, if_false,ite_true, if_true,Nat.cast_ofNat,Nat.cast_zero,Nat.cast_one,Int.reduceAdd,Nat.reduceAdd] using @fullFactor_step_atom_contains (ha7_1_1 j) true 7 1 j (ha7_1_1_contains j)
