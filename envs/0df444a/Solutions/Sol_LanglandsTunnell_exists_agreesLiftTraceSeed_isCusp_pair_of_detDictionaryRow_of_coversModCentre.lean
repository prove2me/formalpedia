  have hpow : arithFrobAt ℤ (L ≃ₐ[ℚ] L) (((τ : L ≃ₐ[ℚ] L)) • _root_.LanglandsTunnell.P2.primeOver H w) ^ n
      = (τ : L ≃ₐ[ℚ] L) * seedFrob H w * (τ : L ≃ₐ[ℚ] L)⁻¹ := by
