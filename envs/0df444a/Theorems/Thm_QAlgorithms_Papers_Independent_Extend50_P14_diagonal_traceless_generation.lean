-- title:
--   Lemma 5: diagonal sector-traceless operators
-- statement:
--   For n≥2 the diagonal skew-Hermitian matrices with zero trace in every Hamming-weight sector are exactly the matrices
--
--   $$A=i\sum_{b\in\{0,1\}^n}a_b Z^b,\qquad a_b\in\mathbb R,\qquad\sum_{w(b)=l}a_b=0\quad(0\le l\le n).$$
--
--   This common set is contained in the real Lie algebra generated by iR_{rs} and iZ_r. The constraints at l=0 and l=n are included.
-- source:
--   Restrictions on realizable unitary operations imposed by symmetry and locality, arXiv:2003.05524v3, PDF p. 26, Lemma 5: diagonal sector-traceless operators and their generation

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P14

noncomputable section

namespace QAlgorithms.Papers.Independent.Extend50.P14

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius

open MeasureTheory

-- Exact accepted aliases and physical operators, without local redeclarations.

open QAlgorithms.Papers.Independent.Information100.P60 (Mat)

open QAlgorithms.Papers.Independent.Advance50.P49 (onWire multiSwap)

attribute [local instance 100] LieRing.ofAssociativeRing

/-- PDF p.26, Lemma 5/C24: equality of the two diagonal sets, followed by
inclusion in the exchange/Z algebra; all weights, including 0 and n, are constrained. -/
theorem diagonal_traceless_generation (n : ℕ) (hn : 2 ≤ n) :
    {A : QMat n | A + Aᴴ = 0 ∧ Matrix.IsDiag A ∧
      ∀ m : Fin (n+1), Matrix.trace (A * chargeSector n m.val) = 0} =
    {A : QMat n | ∃ a : Qubits n → ℝ,
      A = Complex.I • ∑ b : Qubits n, (a b : ℂ) • zString b ∧
      ∀ l : Fin (n+1), ∑ b ∈ Finset.univ.filter (fun b => qubitWeight b = l.val), a b = 0} ∧
    {A : QMat n | A + Aᴴ = 0 ∧ Matrix.IsDiag A ∧
      ∀ m : Fin (n+1), Matrix.trace (A * chargeSector n m.val) = 0} ⊆
      (xyZLie n : Set (QMat n)) := by sorry

end QAlgorithms.Papers.Independent.Extend50.P14

end
