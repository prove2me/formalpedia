theorem mem_zipWith' {α β γ : Type*} {f : α → β → γ} :
    ∀ {l : List α} {l' : List β} {z : γ}, z ∈ List.zipWith f l l' →
      ∃ a ∈ l, ∃ b ∈ l', z = f a b
