private theorem ordinary_branch
    (p : ℕ) [Fact p.Prime] (hp2 : p ≠ 2) (hp3 : p = 3) (W : WeierstrassCurve ℤ)
    (hΔ : W.Δ ≠ 0) (hW : W.IsSemistableModel) (hirr : W.ModRepIsIrreducible p)
    (hns : ∀ A : ValuationSubring (AlgebraicClosure ℚ), A.LiesOverPrime p →
      ∀ x : Submodule.torsionBy ℤ ((W.map (Int.castRingHom ℚ))⁄(AlgebraicClosure ℚ)).Point p,
        (∀ σ ∈ A.inertiaSubgroupIn ℚ, σ • x = x) → x = 0)
    (hcard : Nat.card (Submodule.torsionBy ℤ
      ((W.map (Int.castRingHom ℚ))⁄(AlgebraicClosure ℚ)).Point p) = p ^ 2)
    (hker : GaloisFactorsThroughFiniteLevel
      (WeierstrassCurve.Affine.Point.galoisRepModuleEnd (K := AlgebraicClosure ℚ) ℚ
        (W.map (Int.castRingHom ℚ)) p))
    (N' : ℕ) [NeZero N'] (hpN' : ¬ p ∣ N')
    (hKatz : 5 ≤ p ∨ ∃ q : ℕ, q.Prime ∧ q ∣ N' ∧ q % 3 = 2)
