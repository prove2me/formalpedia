    (vector : Fin dimension → ℤ) : vector ∈ (_root_.AFT.GaussianSource.latticeGaussian dimension width hwidth).support :=
  _root_.AFT.GaussianSource.independentCoordinates_full_support _ (_root_.AFT.GaussianSource.integerGaussian_full_support width hwidth) dimension vector
