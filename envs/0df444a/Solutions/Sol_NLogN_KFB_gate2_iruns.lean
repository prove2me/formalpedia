  obtain ⟨hbp, hbs⟩ := GB_append.1 hb
  -- pushes
  have p1 := Sp.push s f (i := NLogN.KFB.rB) (e := .lit (B1 : ℤ)) (B := Z) (by decide) (clean_lit _) trivial
    trivial (zl B1 (by omega))
