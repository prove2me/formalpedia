/-- The upper bound in (2) makes the `H^{α/2}` form dominate the `H_k` form on
every set. This is both the "reverse inequality in (3)", which the paper notes
"trivially holds true", and the inequality behind the inclusion (5). -/
theorem solution {Γ : QFS.Configuration (EuclideanSpace ℝ (Fin d))} {α Λ : ℝ}
    {k : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℝ≥0∞}
    (hk : QFS.KernelBounds Γ α Λ k) (Ω : Set (EuclideanSpace ℝ (Fin d)))
    (f : EuclideanSpace ℝ (Fin d) → ℝ) :
    QFS.form Ω k f ≤ ENNReal.ofReal Λ * QFS.formHs Ω α f := by
  have hstep : ∀ p : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d),
      ENNReal.ofReal ((f p.2 - f p.1) ^ 2) * k p.1 p.2
        ≤ ENNReal.ofReal Λ *
          (ENNReal.ofReal ((f p.2 - f p.1) ^ 2) * QFS.jumpKernel d α p.1 p.2) := by
    intro p
    calc ENNReal.ofReal ((f p.2 - f p.1) ^ 2) * k p.1 p.2
        ≤ ENNReal.ofReal ((f p.2 - f p.1) ^ 2) *
            (ENNReal.ofReal Λ * QFS.jumpKernel d α p.1 p.2) :=
          mul_le_mul' (le_refl _) (hk.upper _ _)
      _ = ENNReal.ofReal Λ *
            (ENNReal.ofReal ((f p.2 - f p.1) ^ 2) * QFS.jumpKernel d α p.1 p.2) := by ring
  calc QFS.form Ω k f
      ≤ ∫⁻ p in Ω ×ˢ Ω, ENNReal.ofReal Λ *
          (ENNReal.ofReal ((f p.2 - f p.1) ^ 2) * QFS.jumpKernel d α p.1 p.2) :=
        lintegral_mono (fun p => hstep p)
    _ = ENNReal.ofReal Λ * QFS.formHs Ω α f :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
