    (hKN : s0.G NLogN.Rsp.KN = .int ((s + (2 * HvdH.sWidth p α + 1) : ℕ) : ℤ) :: LKN)
    (hR : s0.G NLogN.Rsp.BR = .int (2 ^ (2 * p)) :: LR) (hN : s0.G NLogN.Rsp.BN = .int t :: LN)
    (hNR : s0.G NLogN.Rsp.BNR = .int ((2 * HvdH.sWidth p α + 1 : ℕ) : ℤ) :: LNR)
    (hNW : s0.G NLogN.Rsp.BNW = .int ((t * (2 * HvdH.sWidth p α + 1) : ℕ) : ℤ) :: LNW)
    (hW : s0.G NLogN.Rsp.BW = NLogN.ints (NLogN.Rsp.sTab p s t α).flatten ++ RW)
    (hD : s0.G NLogN.Rsp.BD = NLogN.ints ((NLogN.Rsp.sDel s t).map (Nat.cast : ℕ → ℤ)) ++ RD)
