private theorem isAddLeftInvariant_map_of_forall_integral {P : Measure A} [IsFiniteMeasure P] (hΘm : AEMeasurable Θ P) (hsurj : Surjective Θ)
    (h : ∀ (y₀ : A) (G : UnitAddTorus ι →ᵇ ℝ), ∫ a, G (Θ a + Θ y₀) ∂P = ∫ a, G (Θ a) ∂P) :
    (Measure.map Θ P).IsAddLeftInvariant := by
