/-! ### Sigma-algebras of the head block and of the tail block -/

/-- The sigma-algebra generated by the coordinates `0, …, s` is contained in the pullback of the
product sigma-algebra along the projection onto the first `s + 1` coordinates. -/
private lemma l2_sigmaWindow_head_le {S : Type} [MeasurableSpace S] (s m : ℕ) :
    (sigmaWindow (S := S) (s + 1 + m) 0 s)
      ≤ MeasurableSpace.comap (headTraj (S := S) (s + 1) m) inferInstance := by
  unfold sigmaWindow
  refine iSup_le fun t => iSup_le fun ht => ?_
  have ht' : (t : ℕ) < s + 1 := by omega
  have hfun : (fun ω : Traj S (s + 1 + m) => ω t)
      = (fun η : Traj S (s + 1) => η ⟨t, ht'⟩) ∘ headTraj (S := S) (s + 1) m := by
    funext ω
    simp only [Function.comp, headTraj]
    congr 1
  rw [hfun, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (measurable_pi_apply _).comap_le

/-- The sigma-algebra generated by the coordinates `s + h + 1, …` is contained in the pullback of
the product sigma-algebra along the projection onto the last `n` coordinates. -/
private lemma l2_sigmaWindow_tail_le {S : Type} [MeasurableSpace S] (s h n : ℕ) :
    (sigmaWindow (S := S) (s + 1 + (h + n)) (s + h + 1) (s + 1 + (h + n)))
      ≤ MeasurableSpace.comap
          (fun ω : Traj S (s + 1 + (h + n)) => tailTraj h n (tailTraj (s + 1) (h + n) ω))
          inferInstance := by
  unfold sigmaWindow
  refine iSup_le fun t => iSup_le fun ht => ?_
  have ht' : (t : ℕ) - (s + 1 + h) < n := by omega
  have hfun : (fun ω : Traj S (s + 1 + (h + n)) => ω t)
      = (fun η : Traj S n => η ⟨(t : ℕ) - (s + 1 + h), ht'⟩)
          ∘ (fun ω : Traj S (s + 1 + (h + n)) => tailTraj h n (tailTraj (s + 1) (h + n) ω)) := by
    funext ω
    simp only [Function.comp, tailTraj]
    congr 1
    apply Fin.ext
    simp only [Fin.natAdd_mk]
    omega
  rw [hfun, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono (measurable_pi_apply _).comap_le

/-! ### Finite algebra -/

/-- The final estimate: a row vector contracted in `ℓ¹` paired with a vector bounded by one. -/
private lemma l2_pairing_bound {S : Type} [Fintype S] (v β : S → ℝ) (g N : ℝ)
    (hβ : ∀ b, |β b| ≤ 1) (hv : ∑ b, |v b| ≤ g * N) (hg : 0 ≤ g) (hN : N ≤ 1) :
    |∑ b, v b * β b| ≤ g := by
  calc |∑ b, v b * β b| ≤ ∑ b, |v b * β b| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ b, |v b| := by
        refine Finset.sum_le_sum fun b _ => ?_
        rw [abs_mul]
        exact mul_le_of_le_one_right (abs_nonneg _) (hβ b)
    _ ≤ g * N := hv
    _ ≤ g * 1 := mul_le_mul_of_nonneg_left hN hg
    _ = g := mul_one g

/-- `ℓ¹` bound for the centered vector `c = f - m π` when `0 ≤ f ≤ π`, `∑ f = m`, `∑ π = 1`. -/
private lemma l2_centered_l1 {S : Type} [Fintype S] (f p : S → ℝ) (m : ℝ)
    (hf0 : ∀ a, 0 ≤ f a) (hfp : ∀ a, f a ≤ p a) (hfs : ∑ a, f a = m) (hps : ∑ a, p a = 1)
    (hm0 : 0 ≤ m) (hm1 : m ≤ 1) :
    ∑ a, |f a - m * p a| ≤ 1 := by
  have h1 : ∀ a, |f a - m * p a| ≤ (1 - m) * f a + m * (p a - f a) := by
    intro a
    have e1 : 0 ≤ (1 - m) * f a := mul_nonneg (by linarith) (hf0 a)
    have e2 : 0 ≤ m * (p a - f a) := mul_nonneg hm0 (by linarith [hfp a])
    rw [abs_le]
    constructor <;> nlinarith
  calc ∑ a, |f a - m * p a| ≤ ∑ a, ((1 - m) * f a + m * (p a - f a)) :=
        Finset.sum_le_sum fun a _ => h1 a
    _ = (1 - m) * ∑ a, f a + m * (∑ a, p a - ∑ a, f a) := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, Finset.sum_sub_distrib]
    _ = 2 * m * (1 - m) := by rw [hfs, hps]; ring
    _ ≤ 1 := by nlinarith [sq_nonneg (2 * m - 1)]

/-! ### The core estimate on a horizon of the form `s + 1 + (h + n)` -/

private lemma l2_core {S : Type} [Fintype S] [DecidableEq S] [MeasurableSpace S]
    [MeasurableSingletonClass S]
    (E : Env S) (θ γ : ℝ) (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) (hγ0 : 0 ≤ γ)
    (s h n : ℕ) (hmix : E.Mixing (s + 1 + (h + n)) γ)
    (A' : Set (Traj S (s + 1))) (B' : Set (Traj S n))
    (hA' : MeasurableSet A') (hB' : MeasurableSet B') :
    |(E.trajLaw (s + 1 + (h + n)) (fun _ => θ)).real
          (headTraj (s + 1) (h + n) ⁻¹' A'
            ∩ (fun ω : Traj S (s + 1 + (h + n)) =>
                tailTraj h n (tailTraj (s + 1) (h + n) ω)) ⁻¹' B')
        - (E.trajLaw (s + 1 + (h + n)) (fun _ => θ)).real (headTraj (s + 1) (h + n) ⁻¹' A')
          * (E.trajLaw (s + 1 + (h + n)) (fun _ => θ)).real
              ((fun ω : Traj S (s + 1 + (h + n)) =>
                tailTraj h n (tailTraj (s + 1) (h + n) ω)) ⁻¹' B')|
      ≤ γ ^ h := by
  set q : ℕ → ℝ := fun _ => θ with hq_def
  have hq : ∀ t : ℕ, 0 ≤ q t ∧ q t ≤ 1 := fun _ => ⟨hθ0, hθ1⟩
  set μ := E.trajLaw (s + 1 + (h + n)) q with hμ_def
  set ν := E.trajLaw (s + 1) q with hν_def
  have hμP : IsProbabilityMeasure μ := isProbabilityMeasure_trajLaw E _ q hq
  have hνP : IsProbabilityMeasure ν := isProbabilityMeasure_trajLaw E _ q hq
  set hd : Traj S (s + 1 + (h + n)) → Traj S (s + 1) := headTraj (s + 1) (h + n) with hhd
  set tl : Traj S (s + 1 + (h + n)) → Traj S n :=
    fun ω => tailTraj h n (tailTraj (s + 1) (h + n) ω) with htl
  have hhd_meas : Measurable hd := by
    rw [hhd]; unfold headTraj
    exact measurable_pi_lambda _ fun i => measurable_pi_apply _
  have htl_meas : Measurable tl := by
    rw [htl]; unfold tailTraj
    exact measurable_pi_lambda _ fun i => measurable_pi_apply _
  -- indicator functions
  set F : Traj S (s + 1) → ℝ := A'.indicator (fun _ => (1 : ℝ)) with hF_def
  set G : Traj S n → ℝ := B'.indicator (fun _ => (1 : ℝ)) with hG_def
  have hF : Measurable F := measurable_const.indicator hA'
  have hG : Measurable G := measurable_const.indicator hB'
  have hF0 : ∀ ω, 0 ≤ F ω := fun ω => Set.indicator_nonneg (fun _ _ => zero_le_one) ω
  have hF1 : ∀ ω, F ω ≤ 1 := fun ω => by
    rw [hF_def]; by_cases hω : ω ∈ A' <;> simp [hω]
  have hG0 : ∀ ω, 0 ≤ G ω := fun ω => Set.indicator_nonneg (fun _ _ => zero_le_one) ω
  have hG1 : ∀ ω, G ω ≤ 1 := fun ω => by
    rw [hG_def]; by_cases hω : ω ∈ B' <;> simp [hω]
  have hFb : ∀ ω, |F ω| ≤ 1 := fun ω => by rw [abs_of_nonneg (hF0 ω)]; exact hF1 ω
  have hGb : ∀ ω, |G ω| ≤ 1 := fun ω => by rw [abs_of_nonneg (hG0 ω)]; exact hG1 ω
  -- transition weights out of the last head time
  set p : S → Traj S (s + 1) → ℝ :=
    fun a ω => E.P s (Z (Fin.last s) ω) (X (Fin.last s) ω) a with hp_def
  have hp_meas : ∀ a, Measurable (p a) := by
    intro a
    have hZ : Measurable (Z (S := S) (Fin.last s)) := by
      unfold Z; exact (measurable_pi_apply _).snd.fst
    have hX : Measurable (X (S := S) (Fin.last s)) := by
      unfold X; exact (measurable_pi_apply _).fst
    exact (Measurable.of_discrete (f := fun zx : Bool × S => E.P s zx.1 zx.2 a)).comp
      (hZ.prodMk hX)
  have hp0 : ∀ a ω, 0 ≤ p a ω := fun a ω => E.P_nonneg _ _ _ _
  have hp_sum : ∀ ω, ∑ a, p a ω = 1 := fun ω => E.P_row_sum _ _ _
  have hp1 : ∀ a ω, p a ω ≤ 1 := by
    intro a ω
    rw [← hp_sum ω]
    exact Finset.single_le_sum (f := fun a => p a ω) (fun b _ => hp0 b ω) (Finset.mem_univ a)
  have hp_int : ∀ a, Integrable (p a) ν := fun a =>
    Integrable.of_bound (hp_meas a).aestronglyMeasurable 1
      (Filter.Eventually.of_forall fun ω => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hp0 a ω)]; exact hp1 a ω)
  have hFp_int : ∀ a, Integrable (fun ω => F ω * p a ω) ν := fun a =>
    Integrable.of_bound (hF.mul (hp_meas a)).aestronglyMeasurable 1
      (Filter.Eventually.of_forall fun ω => by
        rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (hF0 ω) (hp0 a ω))]
        exact mul_le_one₀ (hF1 ω) (hp0 a ω) (hp1 a ω))
  -- the vectors
  set f : S → ℝ := fun a => ∫ ω, F ω * p a ω ∂ν with hf_def
  set π : S → ℝ := fun a => ∫ ω, p a ω ∂ν with hπ_def
  set Pi : Matrix S S ℝ :=
    ((List.Ico (s + 1) (s + 1 + h)).map (fun u => E.PMix (q u) u)).prod with hPi_def
  set β : S → ℝ := fun b =>
    ∫ ω, G ω ∂((E.shift (s + 1 + h) b).trajLaw n (fun t => q (s + 1 + h + t))) with hβ_def
  -- measures as integrals
  have hAB : μ.real (hd ⁻¹' A' ∩ tl ⁻¹' B') = ∫ ω, F (hd ω) * G (tl ω) ∂μ := by
    rw [← integral_indicator_one ((hhd_meas hA').inter (htl_meas hB'))]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
    by_cases h1 : hd ω ∈ A' <;> by_cases h2 : tl ω ∈ B' <;>
      simp [hF_def, hG_def, Set.indicator, h1, h2]
  have hA : μ.real (hd ⁻¹' A') = ∫ ω, F (hd ω) ∂μ := by
    rw [← integral_indicator_one (hhd_meas hA')]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
    by_cases h1 : hd ω ∈ A' <;> simp [hF_def, Set.indicator, h1]
  have hB : μ.real (tl ⁻¹' B') = ∫ ω, G (tl ω) ∂μ := by
    rw [← integral_indicator_one (htl_meas hB')]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
    by_cases h2 : tl ω ∈ B' <;> simp [hG_def, Set.indicator, h2]
  -- Markov property across the gap
  have h1 : ∫ ω, F (hd ω) * G (tl ω) ∂μ = ∑ a, ∑ b, f a * Pi a b * β b :=
    integral_head_mul_gap_tail E s h n q hq F G hF hG 1 1 hFb hGb
  have h2 : ∫ ω, G (tl ω) ∂μ = ∑ a, ∑ b, π a * Pi a b * β b := by
    have key := integral_head_mul_gap_tail E s h n q hq (fun _ => (1 : ℝ)) G measurable_const hG
      1 1 (fun _ => by simp) hGb
    simp only [one_mul] at key
    exact key
  have h3 : ∫ ω, F (hd ω) ∂μ = ∑ a, f a := by
    have key := integral_head_mul_tail E s (h + n) q hq F (fun _ => (1 : ℝ)) hF measurable_const
      1 1 hFb (fun _ => by simp)
    have hone : ∀ a : S,
        ∫ _ω, (1 : ℝ) ∂((E.shift (s + 1) a).trajLaw (h + n) (fun t => q (s + 1 + t))) = 1 := by
      intro a
      have : IsProbabilityMeasure
          ((E.shift (s + 1) a).trajLaw (h + n) (fun t => q (s + 1 + t))) :=
        isProbabilityMeasure_trajLaw _ _ _ (fun t => hq (s + 1 + t))
      simp
    simp only [mul_one, hone] at key
    exact key
  -- properties of the vectors
  have hπ_sum : ∑ a, π a = 1 := by
    rw [hπ_def]
    rw [← integral_finsetSum _ (fun a _ => hp_int a)]
    simp only [hp_sum]
    simp
  have hf0 : ∀ a, 0 ≤ f a := fun a =>
    integral_nonneg fun ω => mul_nonneg (hF0 ω) (hp0 a ω)
  have hfπ : ∀ a, f a ≤ π a := fun a =>
    integral_mono (hFp_int a) (hp_int a) fun ω =>
      mul_le_of_le_one_left (hp0 a ω) (hF1 ω)
  have hβ : ∀ b, |β b| ≤ 1 := by
    intro b
    have : IsProbabilityMeasure
        ((E.shift (s + 1 + h) b).trajLaw n (fun t => q (s + 1 + h + t))) :=
      isProbabilityMeasure_trajLaw _ _ _ (fun t => hq (s + 1 + h + t))
    have hβb : β b = ((E.shift (s + 1 + h) b).trajLaw n (fun t => q (s + 1 + h + t))).real B' :=
      integral_indicator_one hB'
    rw [hβb, abs_of_nonneg measureReal_nonneg]
    exact measureReal_le_one
  set mA : ℝ := μ.real (hd ⁻¹' A') with hmA_def
  have hmA0 : 0 ≤ mA := measureReal_nonneg
  have hmA1 : mA ≤ 1 := measureReal_le_one
  have hfs : ∑ a, f a = mA := by rw [← h3, ← hA]
  set c : S → ℝ := fun a => f a - mA * π a with hc_def
  have hc0 : ∑ a, c a = 0 := by
    rw [hc_def]
    simp only [Finset.sum_sub_distrib, ← Finset.mul_sum, hfs, hπ_sum]
    ring
  have hc1 : ∑ a, |c a| ≤ 1 := l2_centered_l1 f π mA hf0 hfπ hfs hπ_sum hmA0 hmA1
  have hcontr : ∑ b, |Matrix.vecMul c Pi b| ≤ γ ^ h * ∑ a, |c a| := by
    have key := mixing_contraction E (s + 1 + (h + n)) γ hγ0 hmix q hq (s + 1) (s + 1 + h)
      (by omega) (by omega) c hc0
    have hsub : s + 1 + h - (s + 1) = h := by omega
    rw [hsub] at key
    exact key
  -- the covariance as a pairing
  have hmain : μ.real (hd ⁻¹' A' ∩ tl ⁻¹' B') - mA * μ.real (tl ⁻¹' B')
      = ∑ b, Matrix.vecMul c Pi b * β b := by
    rw [hAB, hB, h1, h2]
    simp only [Matrix.vecMul, dotProduct, Finset.sum_mul]
    rw [Finset.mul_sum]
    rw [← Finset.sum_sub_distrib]
    refine Eq.trans ?_ Finset.sum_comm
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [hc_def]
    ring
  rw [hmain]
  exact l2_pairing_bound _ β (γ ^ h) (∑ a, |c a|) hβ hcontr (pow_nonneg hγ0 h) hc1

/-! ### Lemma 2 -/

theorem solution {S : Type} [Fintype S] [MeasurableSpace S] [MeasurableSingletonClass S]
    (E : Env S) (T : ℕ) (θ γ M : ℝ)
    (hθ0 : 0 < θ) (hθ1 : θ < 1) (hγ0 : 0 < γ) (hγ1 : γ < 1)
    (hmix : E.Mixing T γ) (hM : E.RewardBound M)
    (s h : ℕ) (hsh : s + h + 1 < T)
    (A B : Set (Traj S T))
    (hA : MeasurableSet[sigmaWindow T 0 s] A)
    (hB : MeasurableSet[sigmaWindow T (s + h + 1) T] B) :
    |(E.expLaw T θ).real (A ∩ B) - (E.expLaw T θ).real A * (E.expLaw T θ).real B|
      ≤ γ ^ h := by
  classical
  obtain ⟨n, rfl⟩ : ∃ n, T = s + 1 + (h + n) := ⟨T - (s + 1 + h), by omega⟩
  have hA1 := l2_sigmaWindow_head_le (S := S) s (h + n) A hA
  have hB1 := l2_sigmaWindow_tail_le (S := S) s h n B hB
  obtain ⟨A', hA', rfl⟩ := hA1
  obtain ⟨B', hB', rfl⟩ := hB1
  exact l2_core E θ γ hθ0.le hθ1.le hγ0.le s h n hmix A' B' hA' hB'
