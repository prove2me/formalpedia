lemma Line.apply_shift (l : Line) (c : Bool) (u w a b : ℤ) :
    l.apply c (u + 2 * a, w + 2 * b) = ((l.apply c (u, w)).1 + 2 * a, (l.apply c (u, w)).2 + 2 * b) := by
  have hu : (u + 2 * a) % 2 = u % 2 := Int.add_mul_emod_self_left u 2 a
  have hw : (w + 2 * b) % 2 = w % 2 := Int.add_mul_emod_self_left w 2 b
  unfold Line.apply
  dsimp only
  rw [hu, hw]
  split_ifs <;> ext <;> simp <;> ring

lemma foldl_shift (c : Bool) (a b : ℤ) : ∀ (ls : List Line) (u w : ℤ),
    ls.foldl (fun p l => l.apply c p) (u + 2 * a, w + 2 * b) =
      ((ls.foldl (fun p l => l.apply c p) (u, w)).1 + 2 * a,
       (ls.foldl (fun p l => l.apply c p) (u, w)).2 + 2 * b)
  | [], u, w => rfl
  | l :: ls, u, w => by
    simp only [List.foldl_cons]
    rw [Line.apply_shift]
    exact foldl_shift c a b ls _ _

/-- (21): the composite flips the parity of `u` exactly when `c = 1` and restores `w`. -/
theorem run8_eq (c : Bool) (u w : ℤ) :
    run8 c (u, w) = (u + (if c then 1 else 0) * (1 - 2 * (u % 2)), w) := by
  have eu := Int.emod_add_mul_ediv u 2
  have ew := Int.emod_add_mul_ediv w 2
  have key : run8 c (u, w) = ((run8 c (u % 2, w % 2)).1 + 2 * (u / 2),
      (run8 c (u % 2, w % 2)).2 + 2 * (w / 2)) := by
    unfold run8; rw [← foldl_shift, eu, ew]
  rw [key]
  rcases Int.emod_two_eq_zero_or_one u with hu | hu <;>
  rcases Int.emod_two_eq_zero_or_one w with hw | hw <;>
  rw [hu, hw] <;> cases c <;>
  · have h : ∀ v : ℤ × ℤ, v = (v.1, v.2) := fun v => rfl
    simp only [run8, lines, List.foldl, Line.apply]
    norm_num
    constructor <;> omega

/-- The coordinates move by at most one per line. -/
lemma Line.apply_bound (l : Line) (hl : l ∈ lines) (c : Bool) (p : ℤ × ℤ) :
    |(l.apply c p).1 - p.1| ≤ 1 ∧ |(l.apply c p).2 - p.2| ≤ 1 := by
  simp only [lines, List.mem_cons, List.not_mem_nil, or_false] at hl
  rcases hl with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp only [Line.apply] <;> split_ifs <;> simp

variable (K : ℕ)

lemma pk_add (n : ℕ) (u δ : ℕ → ℤ) (h : ℤ) :
    Butterfly.pk K n u h + Butterfly.pk K n δ 0 = Butterfly.pk K n (fun i => u i + δ i) h := by
  induction n generalizing u δ with
  | zero => simp [Butterfly.pk]
  | succ n ih =>
    simp only [Butterfly.pk]
    rw [← ih (fun i => u (i + 1)) (fun i => δ (i + 1))]; ring

lemma sum_eq_pk (n : ℕ) (g : ℕ → ℤ) :
    ∑ i ∈ range n, (2 : ℤ) ^ (i * K) * g i = Butterfly.pk K n g 0 := by
  induction n generalizing g with
  | zero => simp [Butterfly.pk]
  | succ n ih =>
    rw [Finset.sum_range_succ', Butterfly.pk, ← ih]
    simp only [zero_mul, pow_zero, one_mul, Finset.mul_sum]
    rw [add_comm]; congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [show (i + 1) * K = K + i * K by ring, pow_add]; ring

/-- Range of a packing. -/
lemma pk_bounds (n : ℕ) (u : ℕ → ℤ) (h H : ℤ) (hu : ∀ i < n, 0 ≤ u i ∧ u i < 2 ^ K)
    (hh : 0 ≤ h) (hH : h < H) : 0 ≤ Butterfly.pk K n u h ∧ Butterfly.pk K n u h < 2 ^ (n * K) * H := by
  induction n generalizing u with
  | zero => simp [Butterfly.pk]; exact ⟨hh, hH⟩
  | succ n ih =>
    obtain ⟨h0, h1⟩ := ih (fun i => u (i + 1)) (fun i hi => hu (i + 1) (by omega))
    obtain ⟨u0, u1⟩ := hu 0 (by omega)
    simp only [Butterfly.pk]
    have hK : (0 : ℤ) < 2 ^ K := by positivity
    constructor
    · positivity
    · have : Butterfly.pk K n (fun i => u (i + 1)) h + 1 ≤ 2 ^ (n * K) * H := by linarith
      calc u 0 + 2 ^ K * Butterfly.pk K n (fun i => u (i + 1)) h
          < 2 ^ K + 2 ^ K * Butterfly.pk K n (fun i => u (i + 1)) h := by linarith
        _ = 2 ^ K * (Butterfly.pk K n (fun i => u (i + 1)) h + 1) := by ring
        _ ≤ 2 ^ K * (2 ^ (n * K) * H) := by gcongr
        _ = 2 ^ ((n + 1) * K) * H := by rw [show (n + 1) * K = K + n * K by ring, pow_add]; ring

/-- Division of a packing by `2^{iK}` drops the lowest `i` segments. -/
lemma pk_div (n : ℕ) (u : ℕ → ℤ) (h : ℤ) (hu : ∀ i < n, 0 ≤ u i ∧ u i < 2 ^ K) (hh : 0 ≤ h) :
    ∀ i ≤ n, Butterfly.pk K n u h / 2 ^ (i * K) = Butterfly.pk K (n - i) (fun j => u (j + i)) h := by
  induction n generalizing u with
  | zero => intro i hi; obtain rfl : i = 0 := by omega
            simp
  | succ n ih =>
    intro i hi
    rcases i with _ | i
    · simp
    · have hK : (0 : ℤ) < 2 ^ K := by positivity
      obtain ⟨u0, u1⟩ := hu 0 (by omega)
      have hrest := ih (fun j => u (j + 1)) (fun j hj => hu (j + 1) (by omega)) i (by omega)
      simp only [Butterfly.pk]
      rw [show (i + 1) * K = K + i * K by ring, pow_add, ← Int.ediv_ediv_of_nonneg hK.le]
      rw [show u 0 + 2 ^ K * Butterfly.pk K n (fun i => u (i + 1)) h =
          u 0 + Butterfly.pk K n (fun i => u (i + 1)) h * 2 ^ K by ring,
        Int.add_mul_ediv_right _ _ hK.ne', Int.ediv_eq_zero_of_lt u0 u1, zero_add, hrest]
      rw [show n + 1 - (i + 1) = n - i by omega]
      congr 1

/-- The lowest bit of a packing is the parity of its lowest segment (`K ≥ 1`). -/
lemma pk_mod_two (n : ℕ) (hK : 1 ≤ K) (u : ℕ → ℤ) (h : ℤ) (hn : 0 < n) :
    Butterfly.pk K n u h % 2 = u 0 % 2 := by
  obtain ⟨n, rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
  simp only [Butterfly.pk]
  rw [show (2 : ℤ) ^ K = 2 * 2 ^ (K - 1) by rw [← pow_succ']; congr 1; omega]
  rw [mul_assoc, Int.add_mul_emod_self_left]

/-- Bit `ρ + iK` of a packed number is the parity of segment `i`. -/
lemma bitAt_packed (ρ n : ℕ) (hK : 1 ≤ K) (lo : ℤ) (u : ℕ → ℤ) (h : ℤ)
    (hlo : 0 ≤ lo ∧ lo < 2 ^ ρ) (hu : ∀ i < n, 0 ≤ u i ∧ u i < 2 ^ K) (hh : 0 ≤ h)
    (i : ℕ) (hi : i < n) : bitAt (packed K ρ n lo u h) (ρ + i * K) = u i % 2 := by
  have hρ : (0 : ℤ) < 2 ^ ρ := by positivity
  unfold bitAt packed
  rw [pow_add, ← Int.ediv_ediv_of_nonneg hρ.le,
    show lo + 2 ^ ρ * Butterfly.pk K n u h = lo + Butterfly.pk K n u h * 2 ^ ρ by ring,
    Int.add_mul_ediv_right _ _ hρ.ne', Int.ediv_eq_zero_of_lt hlo.1 hlo.2, zero_add,
    pk_div K n u h hu hh i hi.le, pk_mod_two K (n - i) hK _ h (by omega)]
  simp

