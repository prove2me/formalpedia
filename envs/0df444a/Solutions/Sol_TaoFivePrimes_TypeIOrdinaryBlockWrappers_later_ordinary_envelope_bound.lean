private theorem reciprocalBudget_nonneg (x : ℝ) (hx : 1 ≤ x) :
    0 ≤ ordinaryReciprocalBudget x := by
  unfold ordinaryReciprocalBudget
  have hlog2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hlog2x : 0 ≤ Real.log (2 * x) := by
    apply Real.log_nonneg
    nlinarith
  positivity
theorem later_ordinary_envelope_bound
    (x : ℝ) (a q k : ℕ) (gamma beta : ℝ)
    (hx : 1 ≤ x) (hq : 4 ≤ q) (haq : Nat.Coprime a q)
    (hgamma : 2 * gamma = (a : ℝ) / (q : ℝ) + beta)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2) :
    (∑ d ∈ laterOddDivisors q k,
      safeCap (ordinaryDivisorCap x (d : ℝ))
        (ordinaryReciprocalBudget x)
        (Real.pi * gamma * (d : ℝ))) ≤
      (x * Real.log x) / (2 * (q : ℝ)) *
          (1 / ((k : ℝ) + 5 / 4)) +
        ordinaryReciprocalBudget x * oddVinogradovBlockConstant q := by
  have hq2 : 2 ≤ q := by omega
  have hq0 : (0 : ℝ) < (q : ℝ) := by
    exact_mod_cast (show 0 < q by omega)
  have hx0 : 0 ≤ x := (by linarith : (0 : ℝ) ≤ x)
  have hlogx : 0 ≤ Real.log x := Real.log_nonneg hx
  have hB : 0 ≤ ordinaryReciprocalBudget x :=
    reciprocalBudget_nonneg x hx
  let A : ℝ :=
    (1 / 2 : ℝ) * (x / laterBlockLower q k) * Real.log x +
      ordinaryReciprocalBudget x
  have hLower : 0 < laterBlockLower q k := by
    unfold laterBlockLower
    positivity
  have hA : 0 ≤ A := by
