theorem isDominant_barPt (A : ValuationSubring (AlgebraicClosure ℚ)) : IsDominant (barPt A) := by
  refine ⟨?_⟩
  show DenseRange (PrimeSpectrum.comap (CommRingCat.ofHom A.subtype).hom)
  rw [PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical]
  have hk : RingHom.ker (CommRingCat.ofHom A.subtype).hom = ⊥ :=
    (RingHom.injective_iff_ker_eq_bot _).mp (by rw [CommRingCat.hom_ofHom]; exact Subtype.val_injective)
  rw [hk]; exact bot_le

private theorem _root_.ModularCurve.JZeroNeronObjectAtP.NeronExtension.ext_of_barPt (hsep : IsSeparated F.gN) (s s' : SchemeHomOver (shPt A) F.gN)
    (h : barPt A ≫ s.1 = barPt A ≫ s'.1) : s = s' := by
  apply Subtype.ext
  haveI := hsep
  haveI := isDominant_barPt A
  exact ext_of_isDominant_of_isSeparated F.gN (by rw [s.2, s'.2]) (barPt A) h

p2m_export "ModularCurve.JZeroNeronObjectAtP.NeronExtension" "ext_of_barPt"
section spN
variable (hsep : IsSeparated F.gN)

private def _root_.ModularCurve.JZeroNeronObjectAtP.NeronExtension.spN : ↥F.extPts →+ componentGroup O.width where
  toFun x := F.specN x.2.choose
  map_zero' := by
    rw [F.specN_eq_zero_iff]
    refine ⟨O.L.one Λ.σA, F.ext_of_barPt hsep _ _ ?_⟩
    have h0 : (F.ptsN 0).1 = barPt A ≫ ((F.extPts.zero_mem : (0 : JZero (N₀ * p)) ∈ F.extPts).choose).1 :=
      (F.extPts.zero_mem).choose_spec
    rw [← h0]
    change barPt A ≫ ((Λ.shLift (O.L.one Λ.σA)).1 ≫ F.openImm.1) = (Λ.shGenLift (O.pts 0)).1 ≫ F.openImm.1
    rw [← Category.assoc, ← Λ.shGenLift_eq_comp_shLift (O.pts 0) (O.L.one Λ.σA) (by
      rw [O.pts_zero, ← O.L.one_natural Λ.σA (genPt p) (barPt A) Λ.hσA]; rfl)]
  map_add' := by
    intro x y
    rw [← F.specN_mul]
    congr 1
    apply F.ext_of_barPt hsep
    have hx : F.ptsN (x : JZero (N₀ * p)) = GoodReductionJacobian.schemeHomOverComp (barPt A) rfl x.2.choose :=
      Subtype.ext x.2.choose_spec
    have hy : F.ptsN (y : JZero (N₀ * p)) = GoodReductionJacobian.schemeHomOverComp (barPt A) rfl y.2.choose :=
      Subtype.ext y.2.choose_spec
    have hxy : (F.ptsN ((x : JZero (N₀ * p)) + y)).1 = barPt A ≫ ((F.extPts.add_mem x.2 y.2).choose).1 :=
      (F.extPts.add_mem x.2 y.2).choose_spec
    rw [← hxy]
    change (F.ptsN ((x : JZero (N₀ * p)) + y)).1 =
      (GoodReductionJacobian.schemeHomOverComp (barPt A) rfl (F.LN.mul (shPt A) x.2.choose y.2.choose)).1
    rw [F.LN.mul_natural, F.ptsN_add]
    conv_lhs => rw [hx, hy]

p2m_export "ModularCurve.JZeroNeronObjectAtP.NeronExtension" "spN"
theorem spN_eq_specN (x : ↥F.extPts) (s : SchemeHomOver (shPt A) F.gN)
    (hs : (F.ptsN (x : JZero (N₀ * p))).1 = barPt A ≫ s.1) : F.spN hsep x = F.specN s := by
  change F.specN _ = _
  congr 1
  apply F.ext_of_barPt hsep
  rw [← hs]
  exact x.2.choose_spec.symm

private theorem _root_.ModularCurve.JZeroNeronObjectAtP.NeronExtension.spN_eq_comp (x : ↥F.extPts) (hx : (x : JZero (N₀ * p)) ∈ inertiaInvariants A (N₀ * p)) :
    F.spN hsep x = O.comp ⟨x, hx⟩ := by
  have h : (F.ptsN (x : JZero (N₀ * p))).1 = barPt A ≫ (x.2.choose).1 := x.2.choose_spec
  change F.specN _ = _
  exact (F.comp_eq_specN ⟨x, hx⟩ _ h).symm

p2m_export "ModularCurve.JZeroNeronObjectAtP.NeronExtension" "spN_eq_comp"

private theorem _root_.ModularCurve.JZeroNeronObjectAtP.NeronExtension.spN_eq_zero_iff (x : ↥F.extPts) : F.spN hsep x = 0 ↔ (x : JZero (N₀ * p)) ∈ O.extPts := by
  change F.specN _ = 0 ↔ _
  rw [F.specN_eq_zero_iff]
  constructor
  · rintro ⟨s₀, hs₀⟩
    refine ⟨s₀, ?_⟩
    have h := x.2.choose_spec
    rw [← hs₀] at h

    haveI := F.openImm_isOpenImmersion
    have h' : (Λ.shGenLift (O.pts (x : JZero (N₀ * p)))).1 ≫ F.openImm.1 =
        (barPt A ≫ (Λ.shLift s₀).1) ≫ F.openImm.1 := by
      rw [Category.assoc]; exact h
    have h'' := congrArg (· ≫ Limits.pullback.fst O.g Λ.shStr) ((cancel_mono F.openImm.1).mp h')
    simp only [Category.assoc, Λ.shGenLift_fst, Λ.shLift_fst] at h''
    exact h''
  · rintro ⟨s₀, hs₀⟩
    refine ⟨s₀, F.ext_of_barPt hsep _ _ ?_⟩
    rw [← x.2.choose_spec]
    change barPt A ≫ ((Λ.shLift s₀).1 ≫ F.openImm.1) = (Λ.shGenLift (O.pts _)).1 ≫ F.openImm.1
    rw [← Category.assoc, Λ.shGenLift_eq_comp_shLift _ s₀ hs₀]

