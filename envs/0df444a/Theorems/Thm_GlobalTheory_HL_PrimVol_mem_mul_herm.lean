theorem GlobalTheory.HL.PrimVol.mem_mul_herm {m : ℕ} {p : E} (hp : IsUnit p) (hc : L.cj p = p) (X : Matrix (Fin m) (Fin m) E) :
    X ∈ (hermLat L m).map (DistribMulAction.toAddMonoidHom _ p) ↔
      IsHerm L X ∧ ∀ a b, ∃ c ∈ L.O, X a b = p * c := by sorry
