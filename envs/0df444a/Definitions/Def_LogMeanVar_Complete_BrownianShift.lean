-- title:
--   p. 8 — the Brownian increments after time t, B_{t+u} − B_t, and their natural filtration
-- statement:
--   Let $B=(B_s)_{s\ge0}$ be a real-valued process on a measurable space $\Omega$ and let $t\ge0$. The **Brownian increments after $t$** are the process
--   $$B^{(t)}_u = B_{t+u}-B_t,\qquad u\ge0,$$
--   indexed by the time $u$ elapsed since $t$, and their **natural filtration** is
--   $$\mathcal F^{(t)}_u=\sigma\big(B^{(t)}_w : 0\le w\le u\big),\qquad u\ge0 .$$
--
--   These are the driving noise and the information flow of the log-return equation (6) started at time $t$: the reward $J(t,y;\pi)$ of p. 8 is computed on the process started at $(t,y)$, which only sees the increments of $B$ after $t$.
--
--   **Formalization Note** Times are real numbers; $t$ is converted to $\mathbb R_{\ge0}$ with `Real.toNNReal` (the definition is only used for $t\ge0$). Elapsed time $u\in\mathbb R_{\ge0}$ is the clock of the published Itô relation `EthierKurtz.HasBrownianItoIntegral`. The filtration is a family of σ-algebras indexed by $\mathbb R_{\ge0}$, not a Mathlib `Filtration` structure, which is the form that relation takes.
-- source:
--   Dai, Jin, Kou, Xu, A Dynamic Mean-Variance Analysis for Log Returns, SSRN 3437268 (version of Aug 2019), pp. 7–8, (1), (6), J

import Mathlib

open MeasureTheory
open scoped NNReal

namespace LogMeanVar.Complete

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The Brownian increments after time `t`: `u ↦ B_{t+u} - B_t`, indexed by the elapsed time
`u ∈ ℝ≥0` (the clock of `EthierKurtz.HasBrownianItoIntegral`). -/
noncomputable def shiftBM (B : ℝ≥0 → Ω → ℝ) (t : ℝ) : ℝ≥0 → Ω → ℝ :=
  fun u ω => B (t.toNNReal + u) ω - B t.toNNReal ω

/-- The natural filtration of the increments after `t`: at elapsed time `u` it is generated by
`B_{t+w} - B_t`, `w ≤ u`. -/
noncomputable def shiftFiltration (B : ℝ≥0 → Ω → ℝ) (t : ℝ) : ℝ≥0 → MeasurableSpace Ω :=
  fun u => ⨆ (w : ℝ≥0) (_ : w ≤ u), MeasurableSpace.comap (shiftBM B t w) (by infer_instance)

end LogMeanVar.Complete


