theorem solution
    {T R : Type} [CommRing T] [CommRing R] (φ : T →+* R) (hφ : Function.Injective φ)
    {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of T)} (L : RelativeGroupLaw T f) (hA : AbelianSchemePropertyBundle T f)
    (𝓜 𝓝 : A.Modules) (h𝓜 : Scheme.Modules.IsInvertible 𝓜) (h𝓝 : Scheme.Modules.IsInvertible 𝓝)
    {A' : Scheme.{0}} {f' : A' ⟶ Spec (CommRingCat.of R)} (g : A' ⟶ A)
    (hg : IsPullback g f' f (Spec.map (CommRingCat.ofHom φ)))
    (h : LocIsoOnBase f' ((Scheme.Modules.pullback g).obj 𝓜) ((Scheme.Modules.pullback g).obj 𝓝)) :
    LocIsoOnBase f 𝓜 𝓝 := by

  obtain ⟨M, hM⟩ :=
    AbelianSchemePropertyBundle.exists_rigidifiedLineBundle_forall_locIsoOnBase_pullback_iff L hA 𝓜 𝓝 h𝓜 h𝓝
  have hR := (hM R φ g hg).mp h

  obtain ⟨Z, ι, hι, -, hZ⟩ :=
    RigidifiedLineBundle.exists_isClosedImmersion_locallyOfFinitePresentation_forall_iff_of_locallyOfFinitePresentation
      L hA (𝟙 (Spec (CommRingCat.of T))) M
  haveI := hι

  obtain ⟨ψ₀, hψ₀⟩ := (hZ (Spec.map (CommRingCat.ofHom φ)) ⟨Spec.map (CommRingCat.ofHom φ), Category.comp_id _⟩).mp hR
  haveI : IsIso ι := isIso_of_isClosedImmersion_of_comp_eq_specMap φ hφ ι ψ₀ hψ₀

  have hT := (hZ (Spec.map (CommRingCat.ofHom (RingHom.id T)))
      ⟨Spec.map (CommRingCat.ofHom (RingHom.id T)), Category.comp_id _⟩).mpr
    ⟨Spec.map (CommRingCat.ofHom (RingHom.id T)) ≫ inv ι, by simp⟩
  have hg1 : IsPullback (𝟙 A) f f (Spec.map (CommRingCat.ofHom (RingHom.id T))) := by
    rw [CommRingCat.ofHom_id, Spec.map_id]
    exact IsPullback.of_id_fst
  have H := (hM T (RingHom.id T) (𝟙 A) hg1).mpr hT

  have E := AlgebraicGeometry.Polarisation.LocIsoOnBase.equivalence f
  exact E.trans (locIsoOnBase_of_iso f ((Scheme.Modules.pullbackId A).app 𝓜).symm)
    (E.trans H (locIsoOnBase_of_iso f ((Scheme.Modules.pullbackId A).app 𝓝)))

