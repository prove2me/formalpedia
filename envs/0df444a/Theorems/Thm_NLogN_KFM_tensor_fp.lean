variable {d : ℕ}

theorem NLogN.KFM.tensor_fp (p : ℕ) {a b : Fin d → ℕ} [∀ i, NeZero (a i)] [∀ i, NeZero (b i)]
    (Aa : Fin d → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ))
    (L : (i : Fin d) → (ZMod (a i) → ℂ) →L[ℂ] (ZMod (b i) → ℂ)) (ε : Fin d → ℝ)
    (hA : ∀ i, FPApprox p (Aa i) (NLogN.KFM.liftL (L i)) (ε i)) (hL : ∀ i, SupLip (NLogN.KFM.liftL (L i)))
    (U : (Fin d → ℕ) → ℤ × ℤ) (hU : InDisc p U) :
    InDisc p (tensorMapZ Aa U) ∧ ∀ j : Fin d → ℕ,
      ‖gC (tensorMapZ Aa U j) - 2 ^ p * IntMul.OpenAI.RT.tens (kerL L)
          (fun k => gC (U (fun i => (k i).val)) / 2 ^ p) (fun i => ((j i : ℕ) : ZMod (b i)))‖
        ≤ ∑ i, ε i := by sorry
