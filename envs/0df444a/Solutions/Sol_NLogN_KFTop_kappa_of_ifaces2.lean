theorem kTable_fixed (ext : Fin E → IStmt HS (7 + E)) (Ei off : ℕ) (h : off + Ei ≤ E)
    (exti : Fin Ei → IStmt HS (7 + Ei)) (j : Fin (7 + Ei)) (hj : j.val < 7) :
    kTable ext (NLogN.KFM.gI Ei E off h j) = (kTable exti j).ren id (NLogN.KFM.gI Ei E off h) := by
  have e : NLogN.KFM.gI Ei E off h j = ⟨j.val, by omega⟩ := by simp [NLogN.KFM.gI, hj]
  rw [e]
  unfold kTable
  by_cases h0 : j.val = 0
  · rw [dif_pos h0, dif_pos h0, IStmt.ren_ren, gI_gL]; rfl
  by_cases h1 : j.val = 1
  · rw [dif_neg h0, dif_pos h1, dif_neg h0, dif_pos h1]
    simp only [mulWrap, IStmt.ren, IOp.ren, id]
    rw [← gI_gM Ei E off h]; rfl
  · rw [dif_neg h0, dif_neg h1, dif_pos hj, dif_neg h0, dif_neg h1, dif_pos hj, IStmt.ren_ren,
      gI_gM]; rfl

variable (ext₁ : Fin E₁ → IStmt HS (7 + E₁)) (ext₂ : Fin E₂ → IStmt HS (7 + E₂))
