-- title:
--   Proposition 7 — the algorithm (3.1) is well defined when T⁻¹0 ≠ ∅
-- statement:
--   Let $E$ be a reflexive, strictly convex and smooth real Banach space with duality mapping $J$, and let $T:E\to2^{E^*}$ be maximal monotone with $T^{-1}0\neq\emptyset$. Then the sequence generated by the algorithm (3.1) is well defined: for every starting point $x_0\in E$ and every sequence $(r_n)$ of positive reals there exist sequences $(x_n)$, $(y_n)$ in $E$ and $(v_n)$ in $E^*$, with the given $x_0$, such that for every $n\ge0$
--   $$0=v_n+\frac1{r_n}(Jy_n-Jx_n),\quad v_n\in Ty_n,\qquad x_{n+1}=Q_{H_n\cap W_n}x_0,$$
--   where $H_n=\{z:\langle z-y_n,v_n\rangle\le0\}$ and $W_n=\{z:\langle z-x_n,Jx_0-Jx_n\rangle\le0\}$.
--
--   It guarantees that the convergence statement of Theorem 8 is about sequences that actually exist.
--
--   **Formalization Note** "Well defined" is formalized as existence of a run from every starting point; uniqueness of each step is not claimed here ($x_{n+1}$ is unique by Proposition 3).
-- source:
--   Kamimura and Takahashi, Strong convergence of a proximal-type algorithm in a Banach space, SIAM J. Optim. 13(3), 2003, p. 942, Proposition 7 (with the standing assumption of §3 that T is maximal monotone)

import Mathlib
import Definitions.Def_ProximalBanach_Hybrid_Basic

namespace ProximalBanach.Hybrid

open Filter Topology

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

/-- Proposition 7 (p. 942): in a reflexive, strictly convex, smooth Banach space, with
`T` maximal monotone and `T⁻¹0 ≠ ∅`, the sequence generated by (3.1) is well defined: from
every starting point `x₀` and every sequence of positive `r_n` there is a run of (3.1). -/
theorem prop7_well_defined [StrictConvexSpace ℝ E] (hR : IsReflexive E) (hS : IsSmooth E)
    (J : E → StrongDual ℝ E) (hJ : ∀ x, J x ∈ dualityMap x)
    (T : E → Set (StrongDual ℝ E)) (hT : IsMaximalMonotone T) (hZ : (zeros T).Nonempty)
    (r : ℕ → ℝ) (hr : ∀ n, 0 < r n) (x₀ : E) :
    ∃ (x y : ℕ → E) (v : ℕ → StrongDual ℝ E), x 0 = x₀ ∧ IsHybridRun T J r x y v := by sorry

end ProximalBanach.Hybrid
