theorem hv_multipliesAt {n₀ : ℕ} {st : RM} {lin : ℕ → ℕ} {calls : ℕ → List (ℕ × ℕ)}
    (hst : StepOK st n₀ lin calls) (K D : ℕ) (hD : 1 ≤ D)
    (hL : ∀ N, n₀ ≤ N → topCost n₀ N + lin N + 2 ≤ K * TT' N)
    (hR : ∀ N, n₀ ≤ N → D * ((calls N).map fun q => q.1 * TT' q.2).sum + TT' N ≤ D * TT' N)
    (n : ℕ) :
    MultipliesAt (hvMachine n₀ st) n ((2000 + 2 * (K * D + smallS n₀) + 1) * TT' n) := by
  set C := K * D + smallS n₀
  apply multipliesAt_of_iexec (hvProg n₀ st) (by norm_num) n
  intro x y hx hy
  have hall := mul_ok_all hst (I := inputCodes x y) (iprog := hvProg n₀ st) rfl rfl rfl rfl
    (fun N => C * TT' N) (fun a b h => Nat.mul_le_mul_left _ (TT'_mono h))
    (fun N => cost_sol K D hD hL hR N)
  have h1 := zsz_val_le x
  have h2 := zsz_val_le y
  obtain ⟨s', c, hE, hout, hc⟩ := main_exec (hvProg n₀ st) rfl _ x y (hx.trans hy.symm)
    (hall (n + 1)) ⟨by omega, by omega⟩
  refine ⟨s', c, hE, by rw [hout, hx], ?_⟩
  have hm := mainHCost_le x.length ((Mlt (fun N => C * TT' N) (n + 1)).Φ (val y) (val x))
  have hG : (Mlt (fun N => C * TT' N) (n + 1)).Φ (val y) (val x) ≤ C * TT' n :=
    Nat.mul_le_mul_left _ (TT'_mono (max_le (by omega) (by omega)))
  have hT : n + 1 ≤ TT' n := Nat.le_mul_of_pos_right _ (by omega)
  rw [hx] at hm hc
  have : 2 * c + 1 ≤ (2000 + 2 * C + 1) * TT' n := by
    have e : (2000 + 2 * C + 1) * TT' n = 2000 * TT' n + 2 * (C * TT' n) + TT' n := by ring
    rw [e]; omega
  exact_mod_cast this

theorem TT'_real (n : ℕ) (hn : 3 ≤ n) : (TT' n : ℝ) ≤ 10 * (n * Real.log n) := by
  have hz := zsz_nat_real_bound n (by omega)
  have hn3 : (3 : ℝ) ≤ n := by exact_mod_cast hn
  have hL : 1 ≤ Real.log n := by
    rw [← Real.log_exp 1]
    apply Real.log_le_log (Real.exp_pos _)
    have := Real.exp_one_lt_d9; linarith
  simp only [TT']; push_cast
  nlinarith

end NLogN.Top

end

section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.Top
open IntMul NLogN
theorem solution {n₀ : ℕ} {st : RM} {lin : ℕ → ℕ} {calls : ℕ → List (ℕ × ℕ)}
    (hst : StepOK st n₀ lin calls) (K D : ℕ) (hD : 1 ≤ D)
    (hL : ∀ N, n₀ ≤ N → topCost n₀ N + lin N + 2 ≤ K * TT' N)
    (hR : ∀ N, n₀ ≤ N → D * ((calls N).map fun q => q.1 * TT' q.2).sum + TT' N ≤ D * TT' N) :
    MulTimeBound fun n => (n : ℝ) * Real.log n := by
  set B : ℕ := 2000 + 2 * (K * D + NLogN.Top.smallS n₀) + 1
  refine ⟨NLogN.Top.hvMachine n₀ st, fun n _ => ⟨_, NLogN.Top.hv_multipliesAt hst K D hD hL hR n⟩, 10 * B,
    by positivity, 3, fun n hn _ => NLogN.multipliesAt_mono (NLogN.Top.hv_multipliesAt hst K D hD hL hR n) ?_⟩
  have := NLogN.Top.TT'_real n hn
  have hB : (0 : ℝ) ≤ B := by positivity
  have eB : (B : ℝ) = 2000 + 2 * ((K : ℝ) * D + NLogN.Top.smallS n₀) + 1 := by simp only [B]; push_cast; ring
  show (2000 + 2 * ((K : ℝ) * D + NLogN.Top.smallS n₀) + 1) * (NLogN.Top.TT' n : ℝ) ≤ 10 * (B : ℝ) * ((n : ℝ) * Real.log n)
  rw [← eB]
  nlinarith
end
