/-- PDF p.7, (21): the same nonnegative Gaussian diffusion time on the
output equals diffusion of both independent inputs before mixing. No energy,
Gaussianity or differentiability restriction; t=0 and lambda=0,1 are retained. -/
theorem diffusionBeamSplitterClosed {n : ℕ} (hn : 0 < n)
    (t lam : ℝ) (ht : 0 ≤ t) (hlam0 : 0 ≤ lam) (hlam1 : lam ≤ 1)
    (rhoX rhoY : State (FockIndex n)) :
    diffusionChannel t (beamSplitter lam
      (productCoeff rhoX.coefficients rhoY.coefficients)) =
    beamSplitter lam (productCoeff
      (diffusionChannel t rhoX.coefficients)
      (diffusionChannel t rhoY.coefficients)) := by sorry

end QAlgorithms.Papers.Independent.Intakenext100.P62

