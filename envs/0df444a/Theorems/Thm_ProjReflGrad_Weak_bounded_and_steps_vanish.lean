-- title:
--   Proof of Theorem 3.2, pp. 5–6 — the iterates are bounded and ‖x_{n+1} − x_n‖ → 0, ‖x_{n+1} − y_n‖ → 0
-- statement:
--   Under the assumptions of Theorem 3.2 (that is, $C$ closed and convex, (C1)–(C3), $0<\lambda<(\sqrt2-1)/L$), every sequence $(x_n),(y_n)$ generated by Algorithm 3.1 satisfies:
--
--   1. $(x_n)$ is bounded;
--   2. $\displaystyle\lim_{n\to\infty}\|x_{n+1}-x_n\|=0$;
--   3. $\displaystyle\lim_{n\to\infty}\|x_{n+1}-y_n\|=0$.
--
--   These asymptotic regularity properties are what allows passing to the limit along weakly convergent subsequences.
-- source:
--   Malitsky, Projected Reflected Gradient Methods for Monotone Variational Inequalities, arXiv:1502.04968v1, pp. 5–6, proof of Theorem 3.2

import Mathlib
import Definitions.Def_ProjReflGrad_Weak_Setting

namespace ProjReflGrad.Weak

/-- Proof of Theorem 3.2 (Malitsky 2015, pp. 5–6): every run of Algorithm 3.1 is bounded, and
`‖x_{n+1} - x_n‖ → 0` and `‖x_{n+1} - y_n‖ → 0`. -/
theorem bounded_and_steps_vanish {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H]
    (C : Set H) (hCcl : IsClosed C) (hCcv : Convex ℝ C) (F : H → H) (L lam : ℝ)
    (hC1 : (solSet C F).Nonempty) (hC2 : IsMonotoneMap F) (hL : 0 < L) (hC3 : IsLipschitzMap F L)
    (hlam0 : 0 < lam) (hlam1 : lam < (Real.sqrt 2 - 1) / L)
    (x y : ℕ → H) (hrun : IsPRGRun C F lam x y) :
    Bornology.IsBounded (Set.range x) ∧
      Filter.Tendsto (fun n => ‖x (n + 1) - x n‖) Filter.atTop (nhds 0) ∧
      Filter.Tendsto (fun n => ‖x (n + 1) - y n‖) Filter.atTop (nhds 0) := by sorry

end ProjReflGrad.Weak
