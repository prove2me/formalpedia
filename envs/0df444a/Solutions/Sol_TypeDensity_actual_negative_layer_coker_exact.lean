    (hL : ∀ r : R, ∀ ell : ℤ, (L (LaurentPolynomial.C (Ideal.Quotient.mk (Ideal.span {t,x}) r) *
      LaurentPolynomial.T ell)).val = principalLayerMap (BlowupOverlap R t x) (algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartBase R t x t)) j (algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartBase R t x r) *
        z ell))
    (q : Polynomial R) :
    ∃ F : LaurentPolynomial (R ⧸ Ideal.span {t,x}), (∀ ℓ : ℤ, (j:ℤ) - d < ℓ → F.coeff ℓ = 0) ∧
      (L F).val = Ideal.Quotient.mk _ ((algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartBase R t x t)) ^ j * (z ((j:ℤ) - d) *
