  have hb : 48 * d * α2P6 P n ≤ 6 * b'P6 P n := by
    have := Nat.div_mul_le_self (6 * b'P6 P n) (48 * d)
    have e2 : α2P6 P n = 6 * b'P6 P n / (48 * d) := rfl
    rw [e2]; linarith
  have e4 : pP6 P n = 6 * b'P6 P n := rfl
  have : 48 * d * αN6 P n ^ 2 ≤ 48 * d * α2P6 P n := Nat.mul_le_mul_left _ ha
  omega

