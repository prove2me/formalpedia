open IntMul KIL KFB KFC KFT KFU AModel AModelL12 NLogN.KFUU

/-! ## `cFwdE`, `cBwdE` against `natCost` -/

theorem cFwdE_nat (τ K : ℝ) (w h d : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) (B Z Br Bb : ℕ)
    (hV : vol (shP h (bsL d bL).reverse) * 2 = vol (shR d (tP d h bL))) :
    cFwdE τ K w h d bL sF B Z Br Bb + 2 + (d + 1) ≤
      natCost w d (vol (shR d (tP d h bL))) (vol (shR d (sP d sF))) (vol ((List.range (d - 1)).map sF))
        B Z Br Bb +
