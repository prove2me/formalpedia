theorem _root_.Prove2MeSourceProof.h_a284e225504f48706843f4e8 [SigmaFinite ν] {n : ℕ} {Λ : ℝ → Ω → Fin n → ℝ}
    (hΛ : Measurable[predictableSigma ℱ] fun p : ℝ × Ω => Λ p.1 p.2)
    {f : ℝ → (Fin n → ℝ) → E → ℝ}
    (hf : Measurable fun q : ℝ × (Fin n → ℝ) × E => f q.1 q.2.1 q.2.2) :
    MarkedPredictable ℱ ν fun (ω : Ω) (s : ℝ) (e : E) => if 0 < s then f s (Λ s ω) e else 0 := by
  classical
  have hpos := LevyStochCalc.Probability.measurableSet_markedPredictableSigma_pos (Ω := Ω) (E := E) ℱ ν
  have h1 : Measurable[LevyStochCalc.Probability.traceSigma (LevyStochCalc.Probability.markedPredictableSigma ℱ ν) hpos]
      fun p : Ω × ℝ × E => p.2.1 := by
    intro D hD
    have hrw : ((fun p : Ω × ℝ × E => p.2.1) ⁻¹' D) ∩ {p : Ω × ℝ × E | 0 < p.2.1}
        = (Set.univ : Set Ω) ×ˢ ((D ×ˢ (Set.univ : Set E))
            ∩ Set.Ioi (0 : ℝ) ×ˢ (Set.univ : Set E)) := by
      ext p
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_setOf_eq, Set.mem_prod,
        Set.mem_univ, true_and, and_true, Set.mem_Ioi]
    change MeasurableSet[LevyStochCalc.Probability.markedPredictableSigma ℱ ν] (_ ∩ _)
    rw [hrw]
    exact _root_.Prove2MeSourceProof.h_801b26c6530d1a0902cf7deb (hD.prod MeasurableSet.univ)
  have h2 : Measurable[LevyStochCalc.Probability.traceSigma (LevyStochCalc.Probability.markedPredictableSigma ℱ ν) hpos]
      fun p : Ω × ℝ × E => p.2.2 := by
    intro D hD
    have hrw : ((fun p : Ω × ℝ × E => p.2.2) ⁻¹' D) ∩ {p : Ω × ℝ × E | 0 < p.2.1}
        = (Set.univ : Set Ω) ×ˢ (((Set.univ : Set ℝ) ×ˢ D)
            ∩ Set.Ioi (0 : ℝ) ×ˢ (Set.univ : Set E)) := by
      ext p
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_setOf_eq, Set.mem_prod,
        Set.mem_univ, true_and, and_true, Set.mem_Ioi]
    change MeasurableSet[LevyStochCalc.Probability.markedPredictableSigma ℱ ν] (_ ∩ _)
    rw [hrw]
    exact _root_.Prove2MeSourceProof.h_801b26c6530d1a0902cf7deb (MeasurableSet.univ.prod hD)
  have h3 : Measurable[LevyStochCalc.Probability.traceSigma (LevyStochCalc.Probability.markedPredictableSigma ℱ ν) hpos]
      fun p : Ω × ℝ × E => Λ p.2.1 p.1 := fun D hD =>
    _root_.Prove2MeSourceProof.h_ad0e73cfa88ab4d66c003162 (E := E) (ν := ν) (hΛ hD)
  have hcomp : Measurable[LevyStochCalc.Probability.traceSigma (LevyStochCalc.Probability.markedPredictableSigma ℱ ν) hpos]
      fun p : Ω × ℝ × E => f p.2.1 (Λ p.2.1 p.1) p.2.2 :=
    hf.comp (h1.prodMk (h3.prodMk h2))
  intro U hU
  have hkey : MeasurableSet[LevyStochCalc.Probability.markedPredictableSigma ℱ ν]
      (((fun p : Ω × ℝ × E => f p.2.1 (Λ p.2.1 p.1) p.2.2) ⁻¹' U)
        ∩ {p : Ω × ℝ × E | 0 < p.2.1}) := hcomp hU
  change MeasurableSet[LevyStochCalc.Probability.markedPredictableSigma ℱ ν]
    ((fun p : Ω × ℝ × E => if 0 < p.2.1 then f p.2.1 (Λ p.2.1 p.1) p.2.2 else 0) ⁻¹' U)
  by_cases h0 : (0 : ℝ) ∈ U
  · have hrw : (fun p : Ω × ℝ × E =>
        if 0 < p.2.1 then f p.2.1 (Λ p.2.1 p.1) p.2.2 else 0) ⁻¹' U
        = (((fun p : Ω × ℝ × E => f p.2.1 (Λ p.2.1 p.1) p.2.2) ⁻¹' U)
            ∩ {p : Ω × ℝ × E | 0 < p.2.1}) ∪ {p : Ω × ℝ × E | 0 < p.2.1}ᶜ := by
      ext p
      by_cases hp : 0 < p.2.1 <;> simp [hp, h0]
    rw [hrw]
    exact hkey.union hpos.compl
  · have hrw : (fun p : Ω × ℝ × E =>
        if 0 < p.2.1 then f p.2.1 (Λ p.2.1 p.1) p.2.2 else 0) ⁻¹' U
        = ((fun p : Ω × ℝ × E => f p.2.1 (Λ p.2.1 p.1) p.2.2) ⁻¹' U)
            ∩ {p : Ω × ℝ × E | 0 < p.2.1} := by
      ext p
      by_cases hp : 0 < p.2.1 <;> simp [hp, h0]
    rw [hrw]
    exact hkey
