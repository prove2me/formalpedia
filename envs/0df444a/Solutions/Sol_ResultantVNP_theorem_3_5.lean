open Finset ResultantVNP AssignmentContributions

namespace GridOrientations

lemma grid_reachable {m : ℕ} [NeZero m] (R : (ZMod m × ZMod m) → (ZMod m × ZMod m) → Prop)
    (hR : ∀ p,Relation.ReflTransGen R p (gridRight p))
    (hD : ∀ p,Relation.ReflTransGen R p (gridDown p)) :
    ∀ u v,Relation.ReflTransGen R u v := by
  intro u v
  have hr (k : ℕ) : Relation.ReflTransGen R u (u.1 + (k : ZMod m),u.2) := by
    induction k with
    | zero => simpa using (Relation.ReflTransGen.refl : Relation.ReflTransGen R u u)
    | succ k ih =>
      simpa only [gridRight,Nat.cast_succ,add_assoc] using ih.trans (hR _)
  have hr' : Relation.ReflTransGen R u (v.1,u.2) := by
    simpa only [ZMod.natCast_zmod_val,add_sub_cancel] using hr (v.1-u.1).val
  have hd (k : ℕ) : Relation.ReflTransGen R (v.1,u.2) (v.1,u.2 + (k : ZMod m)) := by
    induction k with
    | zero => simpa using (Relation.ReflTransGen.refl : Relation.ReflTransGen R (v.1,u.2) (v.1,u.2))
    | succ k ih =>
      simpa only [gridDown,Nat.cast_succ,add_assoc] using ih.trans (hD _)
  have hd' : Relation.ReflTransGen R (v.1,u.2) v := by
    simpa only [ZMod.natCast_zmod_val,add_sub_cancel] using hd (v.2-u.2).val
  exact hr'.trans hd'

lemma in_triangle_connected {ι : Type} (f g : ι → ι) (p x y : ι)
    (hx : x ∈ (p ::ₛ f p ::ₛ g p ::ₛ Sym.nil : Sym ι 3))
    (hy : y ∈ (p ::ₛ f p ::ₛ g p ::ₛ Sym.nil : Sym ι 3)) :
    Relation.ReflTransGen (fun a b => f a = b ∨ g a = b ∨ f b = a ∨ g b = a) x y := by
  have hxp : Relation.ReflTransGen (fun a b => f a = b ∨ g a = b ∨ f b = a ∨ g b = a) x p := by
    simp only [Sym.mem_cons,Sym.notMem_nil,or_false] at hx
    rcases hx with rfl | rfl | rfl
    · exact .refl
    · exact .single (Or.inr (Or.inr (Or.inl rfl)))
    · exact .single (Or.inr (Or.inr (Or.inr rfl)))
  have hpy : Relation.ReflTransGen (fun a b => f a = b ∨ g a = b ∨ f b = a ∨ g b = a) p y := by
    simp only [Sym.mem_cons,Sym.notMem_nil,or_false] at hy
    rcases hy with rfl | rfl | rfl
    · exact .refl
    · exact .single (Or.inl rfl)
    · exact .single (Or.inr (Or.inl rfl))
  exact hxp.trans hpy

theorem orientation_connected {m : ℕ} [NeZero m]
    (f g : (ZMod m × ZMod m) → (ZMod m × ZMod m))
    (hcover : ∀ p,∃ u,
      (u ::ₛ f u ::ₛ g u ::ₛ Sym.nil : Sym (ZMod m × ZMod m) 3) =
        p ::ₛ gridRight p ::ₛ gridDown p ::ₛ Sym.nil) :
    ∀ u v,Relation.ReflTransGen
      (fun a b => f a = b ∨ g a = b ∨ f b = a ∨ g b = a) u v := by
  apply grid_reachable
  · intro p
    obtain ⟨u,hu⟩ := hcover p
    apply in_triangle_connected f g u
    · rw [hu]; simp
    · rw [hu]; simp
  · intro p
    obtain ⟨u,hu⟩ := hcover p
    apply in_triangle_connected f g u
    · rw [hu]; simp
    · rw [hu]; simp

lemma sum_single_cover {α β γ : Type} [Fintype α] [Fintype β]
    (f : α → γ) (g : β → γ)
    (h : (∑ a,Finsupp.single (f a) 1 : γ →₀ ℕ) = ∑ b,Finsupp.single (g b) 1) :
    ∀ b,∃ a,f a = g b := by
  classical
  intro b
  by_contra hn
  push_neg at hn
  have hl : (∑ a,Finsupp.single (f a) 1 : γ →₀ ℕ) (g b) = 0 := by
    simp [Finsupp.finsetSum_apply,Finsupp.single_apply,hn]
  have hr : 1 ≤ (∑ b',Finsupp.single (g b') 1 : γ →₀ ℕ) (g b) := by
    rw [Finsupp.finsetSum_apply]
    simpa only [Finsupp.single_eq_same] using
      (Finset.single_le_sum (fun a (_ : a ∈ (Finset.univ : Finset β)) =>
        Nat.zero_le (Finsupp.single (g a) 1 (g b))) (Finset.mem_univ b))
  rw [← h,hl] at hr
  omega

theorem contribution_orientation {m n : ℕ} [NeZero m]
    (cls : Fin n → ZMod m × ZMod m) (ν : ∀ p,{a // cls a = p})
    (μ : CoeffVar (fun _ : Fin n => 2) →₀ ℕ)
    (hb : ∀ i,Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => v.2.1 i) μ =
      2 * Finsupp.weight (fun v : CoeffVar (fun _ : Fin n => 2) => if v.1 = i then 1 else 0) μ)
    (hm : μ.mapDomain coefficientTriple = assignMonomial cls ν)
    (q : ZMod m × ZMod m → CoeffVar (fun _ : Fin n => 2))
    (hrow : ∀ p,(q p).1 = (ν p).val) (hq : μ = ∑ p,Finsupp.single (q p) 1)
    (f g : (ZMod m × ZMod m) → (ZMod m × ZMod m))
    (hpair : ∀ p,(q p).2.1 = Finsupp.single (ν (f p)).val 1 + Finsupp.single (ν (g p)).val 1) :
    (∀ v,(Finset.univ.filter (fun u => f u = v)).card +
      (Finset.univ.filter (fun u => g u = v)).card = 2) ∧
    (∀ u v,Relation.ReflTransGen
      (fun a b => f a = b ∨ g a = b ∨ f b = a ∨ g b = a) u v) := by
  classical
  have hinj : Function.Injective (fun p => (ν p).val) := by
    intro p r h
    have hh := congrArg cls h
    simpa only [(ν p).property,(ν r).property] using hh
  have ht (p) : Sym.map cls (coefficientTriple (q p)) =
      p ::ₛ f p ::ₛ g p ::ₛ Sym.nil := by
    rw [coefficientTriple_pair (q p) _ _ (hpair p),hrow]
    simp only [Sym.map_cons,(ν p).property,(ν (f p)).property,(ν (g p)).property]
    rfl
  constructor
  · intro v
    have hb' := hb (ν v).val
    rw [equation_count_one cls ν μ hb hm v,mul_one] at hb'
    rw [hq,Finsupp.weight_apply,← Finsupp.sum_finsetSum_index (by intros; simp)
      (by intros; simp only [nsmul_eq_mul,Nat.cast_id,add_mul])] at hb'
    simp only [Finsupp.sum_single_index,zero_nsmul,one_nsmul,hpair,Finsupp.add_apply,
      Finsupp.single_apply,hinj.eq_iff,Finset.sum_add_distrib] at hb'
    simpa only [Finset.card_eq_sum_ones,Finset.sum_filter] using hb'
  · apply orientation_connected f g
    have hh := congrArg (Finsupp.mapDomain (Sym.map cls)) hm
    rw [hq,assignMonomial] at hh
    simp only [Finsupp.mapDomain_finsetSum,Finsupp.mapDomain_single,ht] at hh
    have ha (p) : Sym.map cls (assignTriple cls ν p) =
        p ::ₛ gridRight p ::ₛ gridDown p ::ₛ Sym.nil := by
      simp only [assignTriple,Sym.map_cons,(ν p).property,
        (ν (gridRight p)).property,(ν (gridDown p)).property]
      rfl
    simp_rw [ha] at hh
    exact sum_single_cover _ _ hh

end GridOrientations

