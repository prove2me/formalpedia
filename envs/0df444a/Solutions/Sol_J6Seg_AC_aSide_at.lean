  have hc0 : (0 : ℝ) ≤ c := Nat.cast_nonneg _
  have h2 : (Y : ℝ) ≤ (2 * c) * ((TP6 P n : ℝ) * pP6 P n) * L ^ 2 := by
    have : ((Nat.log 2 (bP6 n) : ℕ) : ℝ) + 1 ≤ 2 * L ^ 2 := by nlinarith
    calc (Y : ℝ) ≤ c * ((TP6 P n : ℝ) * pP6 P n * ((Nat.log 2 (bP6 n) : ℕ) + 1)) := hY'
