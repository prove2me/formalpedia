namespace ExactVacuumAtlas.EinsteinMaxwell.ES5

theorem hasDerivAt_of_cd {R : Set ℝ} {f : ℝ → ℝ} (hR : IsOpen R) (h : ContDiffOn ℝ ∞ f R) {s : ℝ}
    (hs : s ∈ R) : HasDerivAt f (deriv f s) s :=
  ((h.contDiffAt (hR.mem_nhds hs)).differentiableAt (by simp)).hasDerivAt

namespace ESData

variable {R : Set ℝ} {B D A H W Φ Ψ : ℝ → ℝ} {x : Pt 5}

theorem d0D (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) : HasDerivAt D (deriv D (x 1)) (x 1) :=
  hasDerivAt_of_cd hE.isOpen hE.cD hx.1

theorem nz (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) :
    B (x 1) ≠ 0 ∧ D (x 1) ≠ 0 ∧ A (x 1) ≠ 0 ∧ H (x 1) ≠ 0 ∧ x 2 ≠ 0 ∧ 1 - x 2 ≠ 0 :=
  ⟨hE.nB _ hx.1, hE.nD _ hx.1, hE.nA _ hx.1, hE.nH _ hx.1, hx.2.1.ne', (sub_pos.mpr hx.2.2).ne'⟩

end ESData

end ExactVacuumAtlas.EinsteinMaxwell.ES5
