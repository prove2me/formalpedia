/-- The position map `p ↦ (p % b) * a + p / b` of an `a × b` transposition. -/
theorem tpos_lt (a b p : ℕ) (hp : p < a * b) : (p % b) * a + p / b < a * b := by
  have hb : 0 < b := by
    rcases Nat.eq_zero_or_pos b with h | h
    · subst h; simp at hp
    · exact h
  have h1 : p / b < a := Nat.div_lt_of_lt_mul (by rwa [Nat.mul_comm] at hp)
  have h2 : p % b < b := Nat.mod_lt _ hb
  calc (p % b) * a + p / b < (p % b) * a + a := by omega
    _ = (p % b + 1) * a := by ring
    _ ≤ b * a := Nat.mul_le_mul_right _ h2
    _ = a * b := Nat.mul_comm _ _

theorem tpos_inv (a b p : ℕ) (hp : p < a * b) :
    (((p % b) * a + p / b) % a) * b + ((p % b) * a + p / b) / a = p := by
  have hb : 0 < b := by
    rcases Nat.eq_zero_or_pos b with h | h
    · subst h; simp at hp
    · exact h
  have h1 : p / b < a := Nat.div_lt_of_lt_mul (by rwa [Nat.mul_comm] at hp)
  have ha : 0 < a := lt_of_le_of_lt (Nat.zero_le _) h1
  have e1 : ((p % b) * a + p / b) % a = p / b := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt h1]
  have e2 : ((p % b) * a + p / b) / a = p % b := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ ha, Nat.div_eq_of_lt h1, Nat.zero_add]
  rw [e1, e2, Nat.mul_comm]; exact Nat.div_add_mod p b

theorem transpose_sorted (n m kb : ℕ) (D : List (List ℤ)) (hN : n * m ≤ 2 ^ kb) :
    radixSort kb ((List.range (n * m)).map (keyRec n m D)) =
      (List.range (n * m)).map fun (q : ℕ) => (q : ℤ) :: D.getD ((q % n) * m + q / n) [] := by
  have := radixSort_keys kb (n * m) (fun p => (p % m) * n + p / m) (fun q => (q % n) * m + q / n)
    (fun p => D.getD p []) hN (fun p hp => tpos_lt n m p hp)
    (fun q hq => by have := tpos_lt m n q (by rwa [Nat.mul_comm m n]); rwa [Nat.mul_comm m n] at this)
    (fun q hq => tpos_inv m n q (by rwa [Nat.mul_comm m n]))
    (fun p hp => tpos_inv n m p hp)
  exact this

theorem transposeL_eq (n m : ℕ) (D : List (List ℤ)) :
    IntMul.HvdH.Ref.transposeL n m D =
      (List.range (n * m)).map fun q => D.getD ((q % n) * m + q / n) [] := by
  simp only [IntMul.HvdH.Ref.transposeL, Nat.mul_comm m n]
  rfl

/-- **Transposition.** The row-major `n × m` array `D` of records of `d` integers on stack `0`
(with `n` on `1`, `m` on `2` and `kb` with `n * m ≤ 2 ^ kb` on `3`) is replaced by
`transposeL n m D`; every other stack is restored. -/
theorem transP_spec (d n m kb : ℕ) (D : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hD : D.length = n * m) (hDw : ∀ r ∈ D, r.length = d) (hN : n * m ≤ 2 ^ kb)
    (L1 L2 L3 : List Item) (h0 : s.G 0 = ints D.flatten ++ Rest) (h1 : s.G 1 = .int n :: L1)
    (h2 : s.G 2 = .int m :: L2) (h3 : s.G 3 = .int kb :: L3) :
    (transP d).ok s ∧
      (transP d).run s = s.upd 0 (ints (IntMul.HvdH.Ref.transposeL n m D).flatten ++ Rest) := by
  have hA := attachP_spec d n m D Rest s hD hDw L1 L2 h0 h1 h2
  set s1 := (((s.upd 0 (ints (kflat n m D (n * m)) ++ Rest)).upd 42 (.int (n : ℤ) :: s.G 42)).upd 45
        (.int ((n * m * (d + 1) : ℕ) : ℤ) :: s.G 45)).upd 54 (.int ((n * m : ℕ) : ℤ) :: s.G 54)
    with hs1
  set K := (List.range (n * m)).map (keyRec n m D) with hK
  have hKw : ∀ r ∈ K, r.length = d + 1 := by
    intro r hr; simp only [hK, List.mem_map, List.mem_range] at hr
    obtain ⟨p, hp, rfl⟩ := hr
    simp only [keyRec, List.length_cons, List.getD_eq_getElem _ _ (by omega : p < D.length),
      hDw _ (List.getElem_mem _)]
  have s10 : s1.G 0 = ints K.flatten ++ Rest := by
    simp only [hs1, IState.upd_G]; simp (config := {decide := true}) [hK, kflat]
  have s154 : s1.G 54 = .int K.length :: s.G 54 := by simp [hs1, hK]
  have s13 : s1.G 3 = .int kb :: L3 := by
    simp only [hs1, IState.upd_G]; simp (config := {decide := true}) [h3]
  have hW := sortW_spec (d + 1) kb s1 K Rest hKw (by omega) (s.G 54) L3 s10 s154 s13
  set S := radixSort kb K with hS
  have hSe : S = (List.range (n * m)).map fun (q : ℕ) => (q : ℤ) :: D.getD ((q % n) * m + q / n) [] :=
    transpose_sorted n m kb D hN
  have hSw : ∀ r ∈ S, r.length = d + 1 := fun r hr => hKw r ((radixSort_perm kb K).subset hr)
  have hSl : S.length = K.length := (radixSort_perm kb K).length_eq
  set s2 := s1.upd 0 (ints S.flatten ++ Rest) with hs2
  have s254 : s2.G 54 = .int S.length :: s.G 54 := by
    simp only [hs2, IState.upd_G]; simp (config := {decide := true}) [hSl, s154]
  have s245 : s2.G 45 = .int ((n * m * (d + 1) : ℕ) : ℤ) :: s.G 45 := by
    simp only [hs2, hs1, IState.upd_G]; simp (config := {decide := true})
  have hP := stripP_spec d S Rest s2 hSw (s.G 54) s254 (by simp [hs2]) (IState.isInt_of s245)
  set s3 := (s2.upd 0 (ints (S.map List.tail).flatten ++ Rest)).upd 45
        (.int ((S.length * d : ℕ) : ℤ) :: (s2.G 45).tail) with hs3
  have s354 : s3.G 54 = .int S.length :: s.G 54 := by
    simp only [hs3, IState.upd_G]; simp (config := {decide := true}) [s254]
  have s345' : s3.G 45 = .int ((S.length * d : ℕ) : ℤ) :: s.G 45 := by
    simp only [hs3, IState.upd_G]; simp (config := {decide := true}) [s245]
  have s342' : s3.G 42 = .int (n : ℤ) :: s.G 42 := by
    simp only [hs3, hs2, hs1, IState.upd_G]; simp (config := {decide := true})
  have s345 : ((pop 54).run s3).G 45 = .int ((S.length * d : ℕ) : ℤ) :: s.G 45 := by
    simp only [run_pop_G, hs3, IState.upd_G]; simp (config := {decide := true}) [s245]
  have s342 : ((pop 45).run ((pop 54).run s3)).G 42 = .int (n : ℤ) :: s.G 42 := by
    simp only [run_pop_G, hs3, hs2, hs1, IState.upd_G]; simp (config := {decide := true})
  have hT : (S.map List.tail) = IntMul.HvdH.Ref.transposeL n m D := by
    rw [transposeL_eq, hSe, List.map_map]; rfl
  refine ⟨⟨hA.1, ?_⟩, ?_⟩
  · rw [hA.2]
    refine ⟨hW.1, ?_⟩
    rw [hW.2]
    refine ⟨hP.1, ?_⟩
    rw [hP.2]
    exact ⟨⟨by decide, IState.isInt_of s354⟩, ⟨by decide, IState.isInt_of s345⟩, by decide,
      IState.isInt_of s342⟩
  · simp only [transP, run_seq]
    rw [hA.2, hW.2, hP.2]
    apply IState.ext' _ (by simp [hs3, hs2, hs1]) (by simp [hs3, hs2, hs1])
    intro x
    simp only [run_pop_G, IState.upd_G]
    by_cases x42 : x = 42
    · subst x42; simp (config := {decide := true}) [s342']
    by_cases x45 : x = 45
    · subst x45; simp (config := {decide := true}) [s345']
    by_cases x54 : x = 54
    · subst x54; simp (config := {decide := true}) [s354]
    simp only [if_neg x42, if_neg x45, if_neg x54]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [hs3, hT]
    simp [hs3, hs2, hs1, x0, x42, x45, x54]

theorem transposeL_map {α β : Type*} [Inhabited α] [Inhabited β] (f : α → β) (n m : ℕ)
    (L : List α) (hL : L.length = n * m) :
    IntMul.HvdH.Ref.transposeL n m (L.map f) = (IntMul.HvdH.Ref.transposeL n m L).map f := by
  simp only [IntMul.HvdH.Ref.transposeL, List.map_map]
  apply List.map_congr_left
  intro q hq
  rw [List.mem_range] at hq
  have hi : (q % n) * m + q / n < L.length := by
    rw [hL]; exact tpos_lt m n q hq |>.trans_le (le_of_eq (Nat.mul_comm m n))
  have hi' : (q % n) * m + q / n < (L.map f).length := by simpa using hi
  rw [Function.comp_apply, List.getD_eq_getElem _ _ hi', List.getD_eq_getElem _ _ hi,
    List.getElem_map]

theorem singles_flatten (L : List ℤ) : (L.map fun x => [x]).flatten = L := by
  induction L with
  | nil => rfl
  | cons a L ih => simp only [List.map_cons, List.flatten_cons, ih]; rfl

/-- Transposition of an `n × m` integer array. -/
theorem transP_spec_int (n m kb : ℕ) (L : List ℤ) (Rest : List Item) (s : IState HS)
    (hL : L.length = n * m) (hN : n * m ≤ 2 ^ kb)
    (L1 L2 L3 : List Item) (h0 : s.G 0 = ints L ++ Rest) (h1 : s.G 1 = .int n :: L1)
    (h2 : s.G 2 = .int m :: L2) (h3 : s.G 3 = .int kb :: L3) :
    (transP 1).ok s ∧
      (transP 1).run s = s.upd 0 (ints (IntMul.HvdH.Ref.transposeL n m L) ++ Rest) := by
  have H := transP_spec 1 n m kb (L.map fun x => [x]) Rest s (by simpa using hL)
    (by intro r hr; simp only [List.mem_map] at hr; obtain ⟨x, _, rfl⟩ := hr; rfl) hN L1 L2 L3
    (by rw [singles_flatten]; exact h0) h1 h2 h3
  rw [transposeL_map _ n m L hL, singles_flatten] at H
  exact H

theorem transP_cost_int (n m kb B : ℕ) (L : List ℤ) (Rest : List Item) (s : IState HS)
    (hL : L.length = n * m) (hN : n * m ≤ 2 ^ kb) (hm : 1 ≤ m)
    (L1 L2 L3 : List Item) (h0 : s.G 0 = ints L ++ Rest) (h1 : s.G 1 = .int n :: L1)
    (h2 : s.G 2 = .int m :: L2) (h3 : s.G 3 = .int kb :: L3) (hB : Bnd B L) :
    (transP 1).cost s ≤ 10 ^ 6 * (kb + 1) * (n * m + 1) * 2 * (B + kb + 5) := by
  have := transP_cost 1 n m kb B (L.map fun x => [x]) Rest s (by simpa using hL)
    (by intro r hr; simp only [List.mem_map] at hr; obtain ⟨x, _, rfl⟩ := hr; rfl) hN hm L1 L2 L3
    (by rw [singles_flatten]; exact h0) h1 h2 h3
    (by
      intro r hr; simp only [List.mem_map] at hr; obtain ⟨x, hx, rfl⟩ := hr
      intro y hy; simp at hy; subst hy; exact hB y hx)
  simpa using this

