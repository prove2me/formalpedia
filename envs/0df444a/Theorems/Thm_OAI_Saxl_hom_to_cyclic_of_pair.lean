-- title:
--   A nonzero pairing with a real vector gives a nonzero intertwiner into its cyclic module
-- statement:
--   Fix $n,d,e\in\mathbb{N}$ and let $W_{n,d}$ denote the space of functions on words $[n]\to[d]$ (with $[d]=\{0,\dots,d-1\}$), on which $S_n$ acts by $(g\cdot x)(a)=x(a\circ g)$. A matrix $L=(L_{\alpha\beta})\in\mathbb{C}^{d\times e}$ induces its $n$-th tensor power in word coordinates,
--   $$L^{\otimes n}:W_{n,d}\to W_{n,e},\qquad (L^{\otimes n}x)(b)=\sum_{a:[n]\to[d]}x(a)\prod_{p\in[n]}L_{a(p)\,b(p)},$$
--   which commutes with the $S_n$-action. Write $\langle y,z\rangle=\sum_b y(b)\,z(b)$ for the bilinear coordinate pairing on $W_{n,e}$.
--
--   Let $S\subseteq W_{n,d}$ be an $S_n$-invariant subspace, $x\in S$, and $u\in W_{n,e}$ a real vector ($\bar u=u$, i.e. all coordinates of $u$ are real). If
--   $$\langle L^{\otimes n}x,\,u\rangle\neq0,$$
--   then there is a nonzero $S_n$-equivariant linear map $f:S\to\mathbb{C}[S_n]u$, where $\mathbb{C}[S_n]u=\operatorname{span}_{\mathbb{C}}\{g\cdot u:g\in S_n\}$ is the cyclic subrepresentation generated by $u$.
--
--   This turns a single nonvanishing scalar computation into the existence of a nonzero intertwiner. It is the device by which an occurrence of a representation $S$ (for example a Specht module) in a cyclic module is certified by evaluating one explicit contraction.
--
--   **Formalization Note** $L^{\otimes n}$ is `wordMap L`, the pairing is `dotProduct`, and the hypothesis $\bar u=u$ is `star u = u`; the target representation is `(cyclic (wordRep n e) u).toRepresentation`.
-- source:
--   https://github.com/openai/math/blob/1581d4cbdd69a0faf34b2089614fe2a814316a6a/lean/OAI/RepresentationTheory/Saxl/SpechtDuality.lean#L120-L139

import Mathlib
import Definitions.Def_Saxl
import Definitions.Def_OAI_RepresentationTheory_Saxl_Basic
import Definitions.Def_OAI_RepresentationTheory_Saxl_Polytabloid
import Definitions.Def_OAI_RepresentationTheory_Saxl_SpechtSubmodule
import Definitions.Def_OAI_RepresentationTheory_Saxl_SpechtDuality

open OAI OAI.Saxl
open scoped TensorProduct

theorem OAI.Saxl.hom_to_cyclic_of_pair {n d e : ℕ} (L : Fin d → Fin e → ℂ)
    (S : Subrepresentation (wordRep n d)) (x : S.toSubmodule)
    (u : WordSpace n e) (hu : star u = u)
    (h : dotProduct (wordMap L x.val) u ≠ 0) :
    ∃ f : Representation.IntertwiningMap S.toRepresentation
      (cyclic (wordRep n e) u).toRepresentation, f ≠ 0 := by sorry
