  have hdataT : ∀ ℓ : Nat.Primes, X₂.heckeData.T ℓ = X₂.edgeHecke ℓ := by
    intro ℓ
    unfold SSLevelDatum.heckeData
    rw [dif_pos hX₂]
  have hY' : ∀ (ℓ : Nat.Primes) (m : Yo₂),
      ((eY₂ (heckeGen ℓ • m) : ↥(CerednikDrinfeld.ribbonKernel X₂.degeneracyData)) :
          ↥(ssPlaces q (N * q') (IsLocalRing.ResidueField ↥A₂)) → ℤ) =
        (X₂.edgeHecke ℓ).mulVec ((eY₂ m : ↥(CerednikDrinfeld.ribbonKernel X₂.degeneracyData)) :
