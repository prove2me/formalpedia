  simp only [mvBody, RS.ok, RS.run, withCtr, mvSt]
  refine ⟨⟨by omega, RS.clean_of_lt (by omega), ?_⟩, by omega, ?_⟩
  · simp [Ex.ok, IState.IsInt, IState.top, IState.upd_G, hci.symm, hij, hd]
  · simp [IState.IsInt, IState.top, IState.upd_G, hci.symm, hij, hd]

theorem mvList_cost (i j c : Fin HS) (n : Ex HS) (s : IState HS) (l : List ℤ) (Ri : List Item)
    (hij : i ≠ j) (hci : c ≠ i) (hcj : c ≠ j) (hi : s.G i = ints l ++ Ri)
    (hn : n.eval s = l.length) (B : ℕ) (hl : n.Lin) (hnB : n.Bnd s B)
