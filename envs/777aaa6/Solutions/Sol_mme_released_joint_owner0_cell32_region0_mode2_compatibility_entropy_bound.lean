private def x (a : Rows) (w : CompleteWord 2) : ℚ :=
  (massNumerator a w : ℚ) / 1000000000000000000000000000000000000000000000000

private def lower (a : Rows) (w : CompleteWord 2) : ℚ :=
  -(lowerMagnitude a w : ℚ) / 1000000000000

private def upper (a : Rows) (w : CompleteWord 2) : ℚ :=
  -(upperMagnitude a w : ℚ) / 1000000000000

private def actual (a : Rows) (w : CompleteWord 2) : ℕ :=
  match a with
  | Sum.inl c => if yzBoundary 1 ⟨32, c⟩ then (integerProfile 0 1 2) ⟨32, c⟩ w else 0
  | Sum.inr a => ∑ c : MME.RecursiveThinSplit.Split 4 (parent 0 32),
      if ¬ yzBoundary 1 ⟨32, c⟩ ∧ c.val 2 = a then (integerProfile 0 1 2) ⟨32, c⟩ w else 0

private theorem log_bounds (a : Rows) (w : CompleteWord 2)
    (hp : 0 < x a w / ∑ v, x a v) :
    (lower a w : ℝ) ≤ Real.log ((x a w / ∑ v, x a v : ℚ) : ℝ) ∧
      Real.log ((x a w / ∑ v, x a v : ℚ) : ℝ) ≤ (upper a w : ℝ) := by
  apply mme_rational_log_series_certificate _ hp (logScale a w) 16
  all_goals revert a w; decide +kernel

attribute [-instance] boundaryDecidable

/-- An upper bound for the actual compatibility entropy in one parent
component, with boundary classes retained and interior classes pooled. -/
theorem solution :
    ((∑ c : MME.RecursiveThinSplit.Split 4 (parent 0 32),
        if yzBoundary 1 ⟨32, c⟩ then massEntropy (fun w ↦ ((integerProfile 0 1 2) ⟨32, c⟩ w : ℝ)) else 0) +
      ∑ a : Fin 5, massEntropy (fun w ↦ ∑ c : MME.RecursiveThinSplit.Split 4 (parent 0 32),
        if ¬ yzBoundary 1 ⟨32, c⟩ ∧ c.val 2 = a then ((integerProfile 0 1 2) ⟨32, c⟩ w : ℝ) else 0)) ≤
      (denominator : ℝ) ^ 5 * (26964115166 / 1000000000000 : ℝ) := by
  have hx : ∀ a w, 0 ≤ x a w := by decide +kernel
  have h := mme_rational_scaled_mass_entropy_sum_upper_certificate x hx lower upper
    log_bounds ((denominator : ℝ) ^ 5) (by positivity) (26964115166 / 1000000000000) (by decide +kernel)
  have hid : ∀ a w, (denominator : ℚ) ^ 5 * x a w = (actual a w : ℚ) := by
    decide +kernel
  have he (a : Rows) (w : CompleteWord 2) :
      (denominator : ℝ) ^ 5 * (x a w : ℝ) = (actual a w : ℝ) := by
    exact_mod_cast hid a w
  simp_rw [he] at h
  have hb (c : MME.RecursiveThinSplit.Split 4 (parent 0 32)) :
      massEntropy (fun w ↦ (actual (Sum.inl c) w : ℝ)) =
        if yzBoundary 1 ⟨32, c⟩ then massEntropy (fun w ↦ ((integerProfile 0 1 2) ⟨32, c⟩ w : ℝ)) else 0 := by
    by_cases hc : yzBoundary 1 ⟨32, c⟩ <;> simp [actual, hc, massEntropy, entropy]
  simp only [Fintype.sum_sum_type] at h
  simp_rw [hb] at h
  simpa only [actual, Nat.cast_sum, Nat.cast_ite, Nat.cast_zero, Rat.cast_div,
    Rat.cast_natCast] using h


