theorem jFinal_eq (Q R kJ s t lam w α : ℕ) (a9 a10 wd pre post a11 a12 : ℤ) (c : Cs)
    (e0 : ∀ j : Fin HS, j.val ≠ 49 → j.val ≠ 55 → c j = []) :
    let L := Jlist (mkBlocks s t lam w)
    let A := capI Q (mkTables Q R s t α) (mkBlocks s t lam w)
    let FS := fsOf Q L (lam + w) (s - lam - w) A
    let BS := bsOf Q L (lam + w) (s - lam - w) A
    let CC := ccRows (mkTables Q R s t α) (mkBlocks s t lam w) L L.length
    let bl : ℤ := ((JK.flatT FS ++ JK.flatB kJ BS).length : ℤ) + L.length * (2 * (w : ℤ) + 2)
    tailSt Q kJ s lam w L A a9 a10 wd pre post (headSt Q R s t lam w α pre post wd a11 a12 c) =
      update (update (update c sX
        (jVs wd pre post ((2 ^ Nat.clog 2 L.length : ℕ) : ℤ) (Nat.clog 2 L.length))) sOut
        (hdrL a9 a10 ((2 ^ kJ : ℕ) : ℤ) (JK.nBd BS) w bl L.length ++ JK.jBody kJ FS BS CC)) sLn
        [bl + 9] := by
  intro L A FS BS CC bl
  funext j
  simp only [tailSt, headSt, tabSt]
  by_cases hj : j ∈ ([sX, sOut, sLn, sSt, 30, 31, 14, 32, 33, SDI, SDD, SGM, SGI] : List (Fin HS))
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp (disch := decide) only [update_self, update_of_ne, e0, List.append_nil, JK.jBody,
        List.append_assoc] <;> rfl
  · simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hj
    obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13⟩ := hj
    simp (disch := assumption) only [update_of_ne]

end J6Seg.PJ

