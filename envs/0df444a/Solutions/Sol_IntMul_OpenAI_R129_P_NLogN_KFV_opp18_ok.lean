    (hB : (pLP D ℓ K long).n + ℓ + 5 ≤ B) (hNB : D * qq ℓ K + D + 1 ≤ B) (hWB : W ≤ B) :
    LayerU (r := 2 ^ ℓ) I iprog (fun s => LRg s (pLP D ℓ K long) mk W) (layOut eSw dW)
      (pull (binSh (pLP D ℓ K long).n) (binSh (pLP D ℓ K long).n)
        (relabel (tgtL D ℓ K long) (initL D ℓ long)) 0) (2 ^ (pLP D ℓ K long).n) p W
      (cLayOut D ℓ K long Kc (pLP D ℓ K long).n W B) := by
  have hn0 := pLP_n D ℓ K long hK (by omega)
  have hn3 : (pLP D ℓ K long).n = (lstL D ℓ K long).length + D * qq ℓ K * K :=
    (pLP_OK D ℓ K long hK (by omega)).hn
  have h1 := (ph1R_ok (D := D) (ℓ := ℓ) (long := long) (L := pLP D ℓ K long) (I := I)
    (iprog := iprog) (p := p) (W := W) hn0 rfl rfl hmk hℓ hB).ctx
    (Ctx' := fun s => LRg s (pLP D ℓ K long) mk W) (fun s h => ⟨h, rfl⟩)
  have h2 := ph2R_ok D ℓ K long (I := I) (iprog := iprog) (p := p) (mk := mk) (W := W) hK hℓ hq1 hB
  have h3 := ph3R_ok D ℓ K long (I := I) (iprog := iprog) (p := p) (mk := mk) HSw hd0 hd56 hKc hdW
    hK hℓ hB hNB hWB
