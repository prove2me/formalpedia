  have pre1 : 1 ≤ preT P n D k := an.pre1
  have post1 : 1 ≤ postT P n D k := an.post1
  have t1 : 1 ≤ tF6 P n k := an.t1
  have p1 : 1 ≤ pP6 P n := an.p1
  have pT : pP6 P n ≤ TP6 P n := an.pT
  have sizeT : Nat.size (2 * TP6 P n) ≤ pP6 P n := an.sizeT
  have Qp : segPF (pP6 P n) (dP6 P n) (src k) ≤ 3 * pP6 P n := an.Qp
  have pQ : pP6 P n + 1 ≤ segPF (pP6 P n) (dP6 P n) (src k) := an.pQ
  have dT : dP6 P n ≤ TP6 P n := an.dT
  have d1 : 1 ≤ dP6 P n := an.d1
