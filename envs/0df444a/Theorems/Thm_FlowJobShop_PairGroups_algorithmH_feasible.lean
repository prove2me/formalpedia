-- title:
--   §2, algorithm H — the concatenation of feasible group schedules is a feasible schedule of the flow shop
-- statement:
--   Let $F$ be a flow shop with $m$ processors and $n$ jobs, and for every group $g=1,\dots,\lceil m/2\rceil$ let $R(g)$ be a feasible non-preemptive schedule of the flow shop $F_g$ on the processors $P_{2g-1},P_{2g}$. Then the schedule $S$ generated by algorithm H, in which every task on a processor of group $g$ starts at its start time in $R(g)$ plus $\sum_{h<g}\mathrm{FT}(R(h))$, is a feasible non-preemptive schedule of $F$:
--   $$S\ \text{is feasible for}\ F.$$
--
--   This is what makes the output of heuristic H a schedule of the original $m$-processor flow shop.
-- source:
--   Gonzalez, Sahni, Flowshop and Jobshop Schedules: Complexity and Approximation, Operations Research 26(1) (1978), p. 48, §2, description of algorithm H

import Mathlib
import Definitions.Def_FlowJobShop_PairGroups_FlowShop
import Definitions.Def_FlowJobShop_PairGroups_AlgorithmH

namespace FlowJobShop.PairGroups

open FlowShop

/-- §2, description of algorithm H (p. 48): concatenating feasible schedules `R g` of the group
flow shops, each shifted by `Σ_{h<g} FT(R(h))`, gives a feasible schedule of the original
`m`-processor flow shop. -/
theorem algorithmH_feasible {m n : ℕ} (F : FlowShop m n)
    (R : (g : Fin ((m + 1) / 2)) → Fin (groupSize m g) → Fin n → ℝ)
    (hR : ∀ g, (F.group g).IsFeasible (R g)) :
    F.IsFeasible (F.algorithmH R) := by sorry

end FlowJobShop.PairGroups
