open ModularCurve AlgebraicCurve
set_option synthInstance.maxHeartbeats 400000 in

theorem ModularCurve.ell_eq_degree_add_one_sub_genusFF_modularFunctionFieldFullC (K : Type*) [Field K] [IsAlgClosed K]
    (N : ℕ) [NeZero N] (D : AlgebraicCurve.Divisor K ↥(ModularCurve.modularFunctionFieldFullC K N))
    (hD : 2 * (AlgebraicCurve.genusFF K ↥(ModularCurve.modularFunctionFieldFullC K N) : ℤ) - 1 ≤ D.degree) :
    (AlgebraicCurve.ell D : ℤ)
      = D.degree + 1 - (AlgebraicCurve.genusFF K ↥(ModularCurve.modularFunctionFieldFullC K N) : ℤ) := by sorry
