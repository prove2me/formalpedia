  have hrange : ∀ j < decoderCapacity t, padeWritable (decoderRowBase t 0) (decoderRowBase t 1)
      (decoderRowBase t 2) (decoderRowBase t 3) (decoderCapacity t) (C' + j) := by
    intro j hj
