def blankRow (V : NPVerifier) : List Token :=
  (List.finRange (indexing V).symbolCount).map fun j =>
    let symbol := (indexing V).symbols.symm j
    .const (decide ((none : Option (V.computation.tm.Γ symbol.1)) = symbol.2))

