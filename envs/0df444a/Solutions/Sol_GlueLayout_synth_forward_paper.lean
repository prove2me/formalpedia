lemma getBit_setBit_ne {h k : ℕ} (hne : k ≠ h) (v : ℕ) (b : Fin 2) :
    getBit k (setBit h v b) = getBit k v := by
  rcases Nat.lt_or_gt_of_ne hne with hk | hk
  · rw [← getBit_mod_of_lt hk, setBit_mod, getBit_mod_of_lt hk]
  · exact getBit_setBit_of_lt hk v b

/-- Numbers below `2^K` are determined by their bits. -/
lemma eq_of_getBit {K x x' : ℕ} (hx : x < 2 ^ K) (hx' : x' < 2 ^ K)
    (h : ∀ t < K, getBit t x = getBit t x') : x = x' := by
  rw [← Nat.mod_eq_of_lt hx, ← Nat.mod_eq_of_lt hx', ← sum_bits_eq_mod, ← sum_bits_eq_mod]
  exact sum_congr rfl (fun t ht => by rw [h t (mem_range.1 ht)])

/-- Overwriting one digit of a binary digit sum is `setBit`. -/
lemma bitsum_update (c : ℕ → ℕ) (hc : ∀ t, c t < 2) {a h : ℕ} (hh : h < a) (b : Fin 2) :
    ∑ t ∈ range a, (if t = h then (b : ℕ) else c t) * 2 ^ t =
      setBit h (∑ t ∈ range a, c t * 2 ^ t) b := by
  set c' : ℕ → ℕ := fun t => if t = h then (b : ℕ) else c t with hc'
  have hc'2 : ∀ t, c' t < 2 := fun t => by
    simp only [hc']; split_ifs
    · exact b.isLt
    · exact hc t
  apply eq_of_getBit (K := a) (bitsum_lt c' hc'2 a) (setBit_lt hh (bitsum_lt c hc a) b)
  intro t ht
  apply Fin.ext
  rw [getBit_bitsum c' hc'2 a t ht]
  by_cases hth : t = h
  · subst hth; rw [getBit_setBit]; simp [hc']
  · rw [getBit_setBit_ne hth, getBit_bitsum c hc a t ht]; simp [hc', hth]

variable {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma PosData.val_of_not (P : PosData n ι) (v : List ℕ) (y : ι → Fin 2) {k : ℕ}
    (hk : ∀ i, P.pos i ≠ k) : P.val v y k = v.getD k 0 := by
  have : P.inv k = none := by
    rcases h : P.inv k with _ | i
    · rfl
    · exact absurd ((P.inv_iff k i).1 h) (hk i)
  simp [PosData.val, this]

lemma posSel_bits (P : PosData n ι) {v : List ℕ} (hv : Valid (binSh n) v) (i : ι) :
    ((posSel P).bits v i : ℕ) = v.getD (P.pos i) 0 := by
  show v.getD (P.pos i) 0 % 2 = _
  exact Nat.mod_eq_of_lt (valid_getD_lt_two hv _)

section Slots

variable (D : ℕ) [NeZero D]

variable (a : Fin D → ℕ) (arr : List ℕ)

variable {D a arr}

lemma SlotArr.spos_inj (hS : SlotArr D a arr) {i i' : Fin D} {h h' : ℕ} (hh : h < a i)
    (hh' : h' < a i') (he : spos D arr i h = spos D arr i' h') : i = i' ∧ h = h' := by
  have e1 := hS.getD_spos hh
  rw [he, hS.getD_spos hh'] at e1
  exact nm_inj D e1.symm

variable (D a arr)

variable {D a arr}

/-- **The slot selected bits are compatible with the slot layout.** -/
theorem slot_compat (hS : SlotArr D a arr) (h : ℕ) (P : Finset (Fin D)) (hP : ∀ i ∈ P, h < a i) :
    SelCompat (slotLayout hS) h P (slotSel hS h P hP) where
  bits_eq v hv i := by
    apply Fin.ext
    rw [slotSel, posSel_bits _ hv]
    show v.getD (spos D arr i.1 h) 0 = (getBit h (coordS D a arr v i.1) : ℕ)
    unfold coordS
    rw [getBit_bitsum _ (fun t => valid_getD_lt_two hv _) _ _ (hP i.1 i.2)]
  set_eq v hv yb := by
    have hl := (valid_binSh_iff.1 hv).1
    funext j
    show coordS D a arr ((slotPos hS h P hP).setL v yb) j = _
    unfold coordS
    have hval : ∀ t ∈ range (a j), ((slotPos hS h P hP).setL v yb).getD (spos D arr j t) 0 =
        (slotPos hS h P hP).val v yb (spos D arr j t) := fun t ht =>
      (slotPos hS h P hP).getD_setL v yb (by rw [hl]; exact hS.spos_lt (mem_range.1 ht))
    rw [sum_congr rfl (fun t ht => by rw [hval t ht])]
    by_cases hj : j ∈ P
    · rw [dif_pos hj]
      show _ = setBit h (∑ t ∈ range (a j), v.getD (spos D arr j t) 0 * 2 ^ t) (yb ⟨j, hj⟩)
      rw [← bitsum_update _ (fun t => valid_getD_lt_two hv _) (hP j hj)]
      apply sum_congr rfl
      intro t ht
      have ht' := mem_range.1 ht
      by_cases hth : t = h
      · subst hth
        rw [if_pos rfl]
        exact congrArg (· * 2 ^ t) ((slotPos hS t P hP).val_pos v yb ⟨j, hj⟩)
      · rw [if_neg hth, (slotPos hS h P hP).val_of_not v yb]
        intro i hi
        exact hth (hS.spos_inj (hP i.1 i.2) ht' hi).2.symm
    · rw [dif_neg hj]
      apply sum_congr rfl
      intro t ht
      rw [(slotPos hS h P hP).val_of_not v yb]
      intro i hi
      have := (hS.spos_inj (hP i.1 i.2) (mem_range.1 ht) hi).1
      exact hj (this ▸ i.2)

variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ)

/-- **§6.1 on any slot arrangement.** -/
theorem synth_forward_slots (hS : SlotArr D a arr) {ℓ : ℕ} (hy : y ^ (2 ^ ℓ) = -1)
    (ha : ∀ i, a i ≤ ℓ) {xs : List R} (hlen : xs.length = vol (binSh arr.length))
    {v : List ℕ} (hv : Valid (binSh arr.length) v) :
    (procL y (slotLayout hS) ℓ (partAxes a)
      (fun h => slotSel hS h (partAxes a h) partAxes_lt) ℓ xs).getD
        (encode (binSh arr.length) v) 0 =
      Fm y ℓ a (fn (slotLayout hS) xs) (revV a ((slotLayout hS).coord v)) :=
  synth_forward_list y (slotLayout hS) hy ha
    (fun h _ => slot_compat hS h (partAxes a h) partAxes_lt) hlen hv

end Slots

