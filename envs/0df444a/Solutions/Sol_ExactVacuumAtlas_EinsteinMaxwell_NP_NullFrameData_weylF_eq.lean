open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
open ExactVacuumAtlas.EinsteinMaxwell.NP.NullFrameData
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
theorem solution (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (I J A B : Fin 4) :
    weylF g gi E I J A B x = riemFL g gi E Θ I J A B x
      - (etaNull I A * ricF g gi E J B x - etaNull I B * ricF g gi E J A x
        - etaNull J A * ricF g gi E I B x + etaNull J B * ricF g gi E I A x) / 2
      + (ricciScalar g gi x : ℂ) * (etaNull I A * etaNull J B - etaNull I B * etaNull J A) / 6 := by
  have hw : weyl g gi = fun a b c d y => riemLow g gi a b c d y
      - (g a c y * ricciOf g gi b d y - g a d y * ricciOf g gi b c y
        - g b c y * ricciOf g gi a d y + g b d y * ricciOf g gi a c y) / 2
      + ricciScalar g gi y * (g a c y * g b d y - g a d y * g b c y) / 6 := rfl
  unfold weylF ricF
  rw [hw, ccontr4_add, ccontr4_sub, ccontr4_div_const, ccontr4_div_const, ccontr4_mul_left, ccontr4_add,
    ccontr4_sub, ccontr4_sub, ccontr4_sub, ccontr4_prod, ccontr4_prod_ad_bc, ccontr4_prod_bc_ad,
    ccontr4_prod_bd_ac, ccontr4_prod, ccontr4_prod_ad_bc, ← hN.riemFL_eq hx]
  simp only [hN.gram_apply hx]
  push_cast
  ring
