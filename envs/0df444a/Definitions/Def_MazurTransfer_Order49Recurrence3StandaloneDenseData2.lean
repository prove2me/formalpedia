/-- Add two little-endian dense coefficient lists. -/
def add : List ℤ → List ℤ → List ℤ
  | [], ys => ys
  | xs, [] => xs
  | x :: xs, y :: ys => (x + y) :: add xs ys

/-- Scale a little-endian dense coefficient list. -/
def scale (a : ℤ) : List ℤ → List ℤ
  | [] => []
  | x :: xs => (a * x) :: scale a xs

/-- Convolve two little-endian dense coefficient lists. -/
def mul : List ℤ → List ℤ → List ℤ
  | [], _ => []
  | x :: xs, ys => MazurTransfer.Order49Recurrence3Standalone.MazurTorsion.Kubert.OrderSevenBacktrackingCertificate.Internal.ResultantCertificate.IntegerDenseCertificate.add (MazurTransfer.Order49Recurrence3Standalone.MazurTorsion.Kubert.OrderSevenBacktrackingCertificate.Internal.ResultantCertificate.IntegerDenseCertificate.scale x ys) (0 :: mul xs ys)









