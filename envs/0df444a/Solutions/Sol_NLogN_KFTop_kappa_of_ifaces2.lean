theorem gI_gM (Ei E off : ℕ) (h : off + Ei ≤ E) : NLogN.KFM.gI Ei E off h ∘ gM Ei = gM E := by
  funext j; have := j.isLt; apply Fin.ext
  show (NLogN.KFM.gI Ei E off h (gM Ei j)).val = (gM E j).val
  unfold NLogN.KFM.gI gM
  split_ifs with hh
  · rfl
  · simp at hh; omega

