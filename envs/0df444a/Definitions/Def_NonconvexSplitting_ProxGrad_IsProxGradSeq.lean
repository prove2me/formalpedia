-- name    : NonconvexSplitting_ProxGrad_IsProxGradSeq
-- status  : Definition
-- author  : @mikedeng1
-- created : 2026-09-29T19:10:56.071098+00:00
-- url     : https://prove2.me/theorems/17b4fb76-6a24-4a1b-a6a0-d568a9cb1623
-- title:
--   Sequence generated by the proximal gradient update (43)
-- statement:
--   Let $h : \mathbb{R}^n \to \mathbb{R}$ be differentiable, $P : \mathbb{R}^n \to (-\infty, +\infty]$, and $\beta \in \mathbb{R}$ a step size. A sequence $(x^t)_{t \ge 0}$ in $\mathbb{R}^n$ is **generated by the proximal gradient update** if for every $t \ge 0$
--   $$
--   x^{t+1} \in \operatorname*{Arg\,min}_x \Bigl\{ \langle \nabla h(x^t), x - x^t\rangle + \frac{1}{2\beta}\|x - x^t\|^2 + P(x) \Bigr\},
--   $$
--   i.e. the value of the bracket at $x^{t+1}$ is at most its value at every $w \in \mathbb{R}^n$.
--
--   The minimizer need not be unique; any selection is allowed. The initial point $x^0$ is arbitrary (it need not lie in the domain of $P$).
--
--   **Formalization Note** The comparison is made in `EReal`, so that $P$ may take the value $+\infty$. Iterates are indexed from $t = 0$.
-- source:
--   Li & Pong, Global Convergence of Splitting Methods for Nonconvex Composite Optimization, arXiv:1407.0753v6, p. 18, Eq. (43)

import Mathlib

open scoped InnerProductSpace

namespace NonconvexSplitting.ProxGrad

/-- `x : ℕ → ℝⁿ` is generated by the proximal gradient update (43) of Li–Pong (p. 18) with step
size `β`: for every `t`, `x (t+1)` is a (not necessarily unique) minimizer over `w` of
`⟪∇h(x t), w - x t⟫ + (1/(2β)) ‖w - x t‖² + P(w)`, compared in `EReal`. The start `x 0` is free. -/
def IsProxGradSeq {n : ℕ} (h : EuclideanSpace ℝ (Fin n) → ℝ)
    (P : EuclideanSpace ℝ (Fin n) → EReal) (β : ℝ) (x : ℕ → EuclideanSpace ℝ (Fin n)) : Prop :=
  ∀ t w,
    ((⟪gradient h (x t), x (t + 1) - x t⟫_ℝ + 1 / (2 * β) * ‖x (t + 1) - x t‖ ^ 2 : ℝ) : EReal)
        + P (x (t + 1)) ≤
      ((⟪gradient h (x t), w - x t⟫_ℝ + 1 / (2 * β) * ‖w - x t‖ ^ 2 : ℝ) : EReal) + P w

end NonconvexSplitting.ProxGrad


