open Sendov
namespace Sendov
theorem _root_.solution (g : List ℤ) (r : List (List ℤ)) :
    l1row (rscale g r) ≤ l1 g * l1row r := by
  induction r with
  | nil => simp [rscale]
  | cons p r ih =>
    have := l1_pmul g p
    simp only [rscale, List.map_cons, l1row_cons] at *
    nlinarith [ih, l1_nonneg g, l1row_nonneg r]
end Sendov
