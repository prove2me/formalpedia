namespace NLogN.KIL

open AModel

theorem encode4 (a b c d i j k l : ℕ) :
    encode [a, b, c, d] [i, j, k, l] = ((i * b + j) * c + k) * d + l := by
  simp [encode, AModel.vol]; ring

theorem vol4 (a b c d : ℕ) : AModel.vol [a, b, c, d] = a * b * c * d := by
  simp [AModel.vol]; ring

end NLogN.KIL

