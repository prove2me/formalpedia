variable {R : Type} [CommRing R] {X Y : Type} [AddCommGroup X] [AddCommGroup Y]
variable {I J : Type} [Fintype I] [Fintype J]

theorem GlobalTheory.Diag.dualBasis_comp [DecidableEq J] (b : Module.Basis I ℤ X)
    (b' : Module.Basis J ℤ Y) (u : Y →+ X) (i : I) :
    (dualBasis R b i).comp u =
      ∑ j, (LinearMap.toMatrix b' b u.toIntLinearMap i j : R) • dualBasis R b' j := by sorry
