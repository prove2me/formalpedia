theorem OAI.MixedCrossSeparation.convertedColumnBlock_univ {ι : Type*} [Fintype ι] [DecidableEq ι]
    (p : ι → O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hg : ∀ i, lambda ∉ Ideal.span {p i}) (b : Bool) :
    convertedColumnBlock p hp hg Finset.univ b =
      canonicalCrossFactor p hg ^ (if b then 5 else 1) *
        ∏ i, convertedLocal (p i) (hp i) (hg i) b := by sorry
