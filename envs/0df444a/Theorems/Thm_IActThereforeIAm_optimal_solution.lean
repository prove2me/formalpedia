-- title:
--   Theorem 2.1: global optima of the information-theoretic JEPA objective
-- statement:
--   Let the observations be generated by the latent causal model of Eqs. (1)-(2), with $\mathbf g$ measurable. Let $\{p_\phi\}_{\phi\in\Theta}$ be a parameterized transition model and $\lambda\ge1$. Let $(\mathbf h^\star,\phi^\star)$ be a global minimizer of
--
--   $$\mathcal L_\lambda(\mathbf h,\phi)=-\mathbb E[\log p_\phi(\mathbf z_t\mid\mathbf z_{t-1},\mathbf a_{t-1})]-\lambda H(\mathbf z_t),\qquad \mathbf h:\mathcal X\to(0,1)^d,$$
--
--   that attains its lower bound, $\mathcal L_\lambda(\mathbf h^\star,\phi^\star)=-I(\mathbf s_t;\mathbf s_{t-1},\mathbf a_{t-1})$. Then
--
--   $$I(\mathbf z_t;\mathbf z_{t-1},\mathbf a_{t-1})=I(\mathbf s_t;\mathbf s_{t-1},\mathbf a_{t-1}),$$
--
--   and $p_{\phi^\star}(\mathbf z_t\mid\mathbf z_{t-1},\mathbf a_{t-1})=Q_{\mathbf h^\star}(\mathbf z_t\mid\mathbf z_{t-1},\mathbf a_{t-1})$ almost everywhere.
--
--   So at an optimum the representation keeps all of the transition information in the latent state, and the learned transition model is the true induced one.
--
--   **Formalization Note** "Attains its lower bound" means equality with $-I(\mathbf s_t;\mathbf s_{t-1},\mathbf a_{t-1})$, the bound of Eq. (21). The a.e. equality of densities is stated as an equality of measures: the joint law of $(\mathbf z_{t-1},\mathbf a_{t-1},\mathbf z_t)$ equals the law of $(\mathbf z_{t-1},\mathbf a_{t-1})$ times $p_{\phi^\star}(\mathbf z\mid\cdot)\,d\mathbf z$. Minimization is over admissible pairs, those with finite objective.
-- source:
--   Liu, Huang and Shi, I Act Therefore I Am: When Is JEPA's Action-Conditioning Enough to Learn Causal Mechanisms?, arXiv:2609.31161v1 (2026), Section 2.2, Theorem 2.1, Eqs. (4)-(6), p. 3; proof in Appendix C, p. 18

import Mathlib
import Definitions.Def_IActThereforeIAm_Basic

open MeasureTheory Filter Topology
open scoped ENNReal NNReal ContDiff

namespace IActThereforeIAm

theorem optimal_solution {d : ℕ} {A X Θ : Type*} [MeasurableSpace A] [MeasurableSpace X]
    (M : LatentSCM d A) (hM : M.IsValid) (g : (Fin d → ℝ) → X) (hg : Measurable g)
    (lam : ℝ) (hlam : 1 ≤ lam) (model : Θ → (Fin d → ℝ) × A → (Fin d → ℝ) → ℝ)
    (h : X → Fin d → ℝ) (φ : Θ) (hmin : IsGlobalMin M g lam model h φ)
    (hattain : ((objective M g lam h (model φ) : ℝ) : EReal) = -((latentInfo M : ℝ≥0∞) : EReal)) :
    reprInfo M g h = latentInfo M ∧ IsReprTransitionDensity M g h (model φ) := by sorry

end IActThereforeIAm
