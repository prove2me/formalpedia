private theorem ideleNorm_prod {ι : Type} (s : Finset ι) (f : ι → (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    ideleNorm ℚ (∏ i ∈ s, f i) = ∏ i ∈ s, ideleNorm ℚ (f i) := by
