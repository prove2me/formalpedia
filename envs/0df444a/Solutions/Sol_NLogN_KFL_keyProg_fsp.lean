  simp only [trF]; rw [Function.update_self]
theorem trF_ne (H : Fin HS → List ℤ) (c : Tr) {j : Fin HS} (h1 : j ≠ rX) (h2 : j ≠ rY)
    (h3 : j ≠ rZ) : trF H c j = H j := by
  simp only [trF]; rw [upd_ne h3, upd_ne h2, upd_ne h1]

theorem trF_updY (H : Fin HS → List ℤ) (c : Tr) (n : ℕ) :
    Function.update (trF H c) rY ((n : ℤ) :: H rY) = trF H (c.1, n, c.2.2) := by
  funext j; simp only [trF, Function.update_apply]
  by_cases h1 : j = rZ
  · subst h1; simp +decide
  by_cases h2 : j = rY
  · subst h2; simp +decide
  simp [h1, h2]

theorem trF_updZ (H : Fin HS → List ℤ) (c : Tr) (n : ℕ) :
    Function.update (trF H c) rZ ((n : ℤ) :: H rZ) = trF H (c.1, c.2.1, n) := by
  funext j; simp only [trF, Function.update_apply]
  by_cases h1 : j = rZ
  · subst h1; simp +decide
  by_cases h2 : j = rY
  · subst h2; simp +decide
  simp [h1, h2]

theorem zfacts {K ρ f Bb : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f)
    (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb) :
    (∀ v : ℤ, |v| ≤ 4 * 2 ^ (f * K) → zsz v ≤ Bb) ∧ (2 : ℤ) ^ ρ * 2 ^ ((f - 1) * K) ≤ 2 ^ (f * K) ∧
    zsz ((2 : ℤ) ^ ρ) ≤ Bb ∧ zsz ((2 : ℤ) ^ K) ≤ Bb ∧ zsz ((f - 1 : ℕ) : ℤ) ≤ Bb ∧
    zsz ((2 : ℤ) ^ (f * K)) ≤ Bb := by
  have hb : ((4 * 2 ^ (f * K) : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hbig
  push_cast at hb
  have zl : ∀ v : ℤ, |v| ≤ 4 * 2 ^ (f * K) → zsz v ≤ Bb := fun v hv => zsz_of_le hb hv
  have hn : (f - 1) * K + ρ ≤ f * K := by
    have : (f - 1) * K + K = f * K := by
      have : f = (f - 1) + 1 := by omega
      conv_rhs => rw [this]
      ring
    omega
  have hQ0 : (0 : ℤ) < 2 ^ (f * K) := by positivity
  have pw : ∀ j, j ≤ f * K → (2 : ℤ) ^ j ≤ 2 ^ (f * K) := fun j hj =>
    pow_le_pow_right₀ (by norm_num) hj
  refine ⟨zl, by rw [← pow_add]; exact pw _ (by omega), ?_, ?_, ?_, ?_⟩
  · apply zl; rw [abs_of_pos (by positivity)]; have := pw ρ (by nlinarith); linarith
  · apply zl; rw [abs_of_pos (by positivity)]; have := pw K (by nlinarith); linarith
  · apply zl; rw [abs_of_nonneg (by positivity)]
    have h1 : f - 1 < 2 ^ (f - 1) := Nat.lt_two_pow_self
    have h2 : ((f - 1 : ℕ) : ℤ) < 2 ^ (f - 1) := by exact_mod_cast h1
    have := pw (f - 1) (by nlinarith); linarith
  · apply zl; rw [abs_of_pos hQ0]; linarith

theorem lineVal {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (l : Line)
    (hs : l.sgn = 1 ∨ l.sgn = -1) (x t y : ℕ) (hy : y < 2 ^ (f * K)) :
    (((y + 2 ^ (f * K) - amt K ρ f l x t) % 2 ^ (f * K) : ℕ) : ℤ) =
      ((y : ℤ) + 2 ^ (f * K) - l.sgn * Butterfly.offset K ρ f x t l.b) % 2 ^ (f * K) := by
  have hQ : (0 : ℤ) < 2 ^ (f * K) := by positivity
  set o := l.sgn * Butterfly.offset K ρ f x t l.b
  have ha : ((amt K ρ f l x t : ℕ) : ℤ) = o % 2 ^ (f * K) := by
    simp only [amt]; rw [Int.toNat_of_nonneg (Int.emod_nonneg _ hQ.ne')]
  have hlt : amt K ρ f l x t < 2 ^ (f * K) := by
    have h := Int.emod_lt_of_pos o hQ
    rw [← ha] at h; exact_mod_cast h
  push_cast [Nat.cast_sub (show amt K ρ f l x t ≤ y + 2 ^ (f * K) by omega)]
  rw [ha]
  rw [Int.sub_emod, Int.emod_emod_of_dvd _ (dvd_refl _), ← Int.sub_emod]

set_option maxHeartbeats 1000000 in
theorem lineR_fsp {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (l : Line)
    (hs : l.sgn = 1 ∨ l.sgn = -1) (hb : l.b = 0 ∨ l.b = 1) {Bb : ℕ} (hB2 : 2 ≤ Bb)
    (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb) (s : IState HS) (H : Fin HS → List ℤ) (hHc : H rC = [])
    (c : Tr) (hc : TV (2 ^ (f * K)) c) :
    FSp (lineR K ρ f l) (encK s (trF H c)) (encK s (trF H (lineP K ρ f l c))) (cLine K f l.b Bb) := by
  obtain ⟨zl, hpw, zr, zK, zf, zQ⟩ := zfacts hK hρK hf hbig
  obtain ⟨hx, hy, hz⟩ := hc
  set Q : ℤ := 2 ^ (f * K) with hQdef
  have hQ0 : (0 : ℤ) < Q := by positivity
  have hρ0 : (0 : ℤ) < 2 ^ ρ := by positivity
  set G := trF H c
  have hGc : G rC = [] := by
    simp only [G]; rw [trF_ne H c (j := rC) (by decide) (by decide) (by decide)]; exact hHc
  set tv : ℕ := if l.tgtY then c.2.1 else c.2.2
  set ov : ℕ := if l.tgtY then c.2.2 else c.2.1
  have htv : tv < 2 ^ (f * K) := by simp only [tv]; split_ifs <;> assumption
  have hov : ov < 2 ^ (f * K) := by simp only [ov]; split_ifs <;> assumption
  have hGt : G (tgtR l) = (tv : ℤ) :: H (tgtR l) := by
    simp only [G, tgtR, tv]; split_ifs
    · exact trF_Y H c
    · exact trF_Z H c
  have hGo : G (othR l) = (ov : ℤ) :: H (othR l) := by
    simp only [G, othR, ov]; split_ifs
    · exact trF_Z H c
    · exact trF_Y H c
  have ht : (tgtR l).val < 56 ∧ tgtR l ≠ rA ∧ tgtR l ≠ NLogN.KFL.rU ∧ tgtR l ≠ rV ∧ tgtR l ≠ rW ∧
      tgtR l ≠ rC := by
    simp only [tgtR]; split_ifs <;> decide
  have ho : (othR l).val < 56 ∧ othR l ≠ rA ∧ othR l ≠ NLogN.KFL.rU ∧ othR l ≠ rV ∧ othR l ≠ rW := by
    simp only [othR]; split_ifs <;> decide
  have hxl : ((c.1 : ℤ) / 2 ^ ρ) ≤ Q := by
    have := Int.ediv_le_self (2 ^ ρ) (by positivity : (0 : ℤ) ≤ c.1)
    have : (c.1 : ℤ) < Q := by simp only [Q]; exact_mod_cast hx
    linarith
  have hol : ((ov : ℤ) / 2 ^ ρ) ≤ Q := by
    have := Int.ediv_le_self (2 ^ ρ) (by positivity : (0 : ℤ) ≤ ov)
    have : (ov : ℤ) < Q := by simp only [Q]; exact_mod_cast hov
    linarith
  have hxQ : (c.1 : ℤ) < Q := by simp only [Q]; exact_mod_cast hx
  have hoQ : (ov : ℤ) < Q := by simp only [Q]; exact_mod_cast hov
  have htQ : (tv : ℤ) < Q := by simp only [Q]; exact_mod_cast htv
  have Eu : ESp (.ndiv (.reg rX) (.lit (2 ^ ρ))) (encK s G) Bb ((c.1 : ℤ) / 2 ^ ρ) :=
    ESp.ndiv (ESp.reg (by decide) (trF_X H c) (zl _ (by rw [abs_of_nonneg (by positivity)]; linarith)))
      (ESp.lit zr) (by positivity) hρ0
      (zl _ (by rw [abs_of_nonneg (by positivity)]; linarith))
  have Ev : ESp (.ndiv (.reg (othR l)) (.lit (2 ^ ρ))) (encK s G) Bb ((ov : ℤ) / 2 ^ ρ) :=
    ESp.ndiv (ESp.reg ho.1 hGo (zl _ (by rw [abs_of_nonneg (by positivity)]; linarith)))
      (ESp.lit zr) (by positivity) hρ0
      (zl _ (by rw [abs_of_nonneg (by positivity)]; linarith))
  have Ea : ESp (.lit 0) (encK s G) Bb 0 := ESp.lit (by rw [zsz_zero]; omega)
  obtain ⟨ho0, hoM⟩ := offset_bounds (K := K) (ρ := ρ) (f := f) hK hρK hf (c.1 : ℤ) (ov : ℤ) l.b
  set off := Butterfly.offset K ρ f (c.1 : ℤ) (ov : ℤ) l.b
  have hacc : (0 : ℤ) + segAcc K (tfB l.b) ((c.1 : ℤ) / 2 ^ ρ) ((ov : ℤ) / 2 ^ ρ) (2 ^ ρ) (f - 1) =
      off := by rw [zero_add]; exact (offset_seg K ρ f c.1 ov l.b hb).symm
  have hso : |l.sgn * off| ≤ Q := by
    rcases hs with h | h <;> rw [h] <;> simp [abs_of_nonneg ho0] <;> linarith
  have hpos : 0 ≤ (tv : ℤ) + Q + -(l.sgn * off) := by
    have := abs_le.1 hso; have : (0 : ℤ) ≤ tv := by positivity
    linarith
  set r := ((tv : ℤ) + Q + -(l.sgn * off)) % Q
  have Efin : ∀ G' : Fin HS → List ℤ, G' rA = (0 + segAcc K (tfB l.b) ((c.1 : ℤ) / 2 ^ ρ)
      ((ov : ℤ) / 2 ^ ρ) (2 ^ ρ) (f - 1)) :: G rA →
      (∀ i, i ≠ rA → i ≠ NLogN.KFL.rU → i ≠ rV → i ≠ rW → G' i = G i) →
      ESp (.nmod (.add (.add (.reg (tgtR l)) (.lit (2 ^ (f * K)))) (.neg (.mul (.lit l.sgn)
        (.reg rA)))) (.lit (2 ^ (f * K)))) (encK s G') Bb r := by
    intro G' hA ho'
    rw [hacc] at hA
    have hT : G' (tgtR l) = (tv : ℤ) :: H (tgtR l) := by
      rw [ho' _ ht.2.1 ht.2.2.1 ht.2.2.2.1 ht.2.2.2.2.1]; exact hGt
    have z0 : zsz (tv : ℤ) ≤ Bb := zl _ (by rw [abs_of_nonneg (by positivity)]; linarith)
    refine ESp.nmod (ESp.add (ESp.add (ESp.reg ht.1 hT z0) (ESp.lit zQ) ?_)
      (ESp.neg (ESp.mul (ESp.lit ?_) (ESp.reg (by decide) hA ?_) ?_)) ?_) (ESp.lit zQ) hpos hQ0 ?_
    · apply zl; rw [abs_of_nonneg (by positivity)]; linarith
    · rcases hs with h | h <;> rw [h]
      · rw [zsz_one]; omega
      · rw [zsz_neg, zsz_one]; omega
    · apply zl; rw [abs_of_nonneg ho0]; linarith
    · apply zl; linarith
    · apply zl; rw [abs_of_nonneg hpos]; have := abs_le.1 hso; linarith
    · apply zl
      rw [abs_of_nonneg (Int.emod_nonneg _ hQ0.ne')]
      have := Int.emod_lt_of_pos ((tv : ℤ) + Q + -(l.sgn * off)) hQ0; linarith
  have hbig' : |(0 : ℤ)| + 2 * 2 ^ ρ * 2 ^ ((f - 1) * K) < 2 ^ Bb := by
    have : (4 * Q : ℤ) < 2 ^ Bb := by simp only [Q]; exact_mod_cast hbig
    simp only [abs_zero]; nlinarith
  have NV : NoSeg (.ndiv (.reg (othR l)) (.lit (2 ^ ρ))) := by
    intro i hi; simp only [Ex.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
      or_false] at hi; subst hi; exact ⟨ho.2.1, ho.2.2.1, ho.2.2.2.1, ho.2.2.2.2⟩
  have NA : NoSeg (.lit 0) := by intro i hi; simp [Ex.regs] at hi
  have S := segStep_fsp hK (segT_offE l.b hB2) s G hGc ht.1 ht.2.1 ht.2.2.1 ht.2.2.2.1
    ht.2.2.2.2.1 ht.2.2.2.2.2 hGt (zl _ (by rw [abs_of_nonneg (by positivity)]; linarith))
    (by positivity) (by positivity) hρ0 (zl _ (by rw [abs_of_nonneg (by positivity)]; linarith))
    (zl _ (by rw [abs_of_nonneg (by positivity)]; linarith)) zr zK zf hbig' NV NA Eu Ev Ea Efin
  refine (S.congr ?_).mono (le_of_eq ?_)
  · congr 1
    have hr : r = (((tv + 2 ^ (f * K) - amt K ρ f l c.1 ov) % 2 ^ (f * K) : ℕ) : ℤ) := by
      rw [lineVal hK hρK hf l hs c.1 ov tv htv]; simp only [r, Q, off]; congr 1
    rw [hr]
    obtain ⟨x, y, z⟩ := c
    simp only [G, tgtR, lineP, tv, ov]
    cases hY : l.tgtY
    · simp only [if_false, Bool.false_eq_true]; exact trF_updZ H _ _
    · simp only [if_true]; exact trF_updY H _ _
  · simp only [cLine, Ex.size, Nat.reduceAdd]

theorem segT_t0E {Bb : ℕ} (hB : 2 ≤ Bb) : SegT t0E tf0 Bb where
  regs := by intro i hi; simp [t0E, Ex.regs] at hi; tauto
  ev := by intro t a c ha hc; simp only [t0E, tf0, Ex.eval, ha, hc]; ring
  ok := by
    intro t a c ha hc hia hic ha0 hc0 hab hcb
    have z2 : zsz (2 : ℤ) ≤ Bb := by
      apply zsz_le_of_lt
      have : (2 : ℕ) ^ 2 ≤ 2 ^ Bb := Nat.pow_le_pow_right (by norm_num) hB
      simp only [Int.reduceAbs]; norm_num at this ⊢; omega
    have z1 : zsz (1 : ℤ) ≤ Bb := by rw [zsz_one]; omega
    have ea : (Ex.reg NLogN.KFL.rU : Ex HS).eval t = a := by simp [Ex.eval, ha]
    have ec : (Ex.reg rV : Ex HS).eval t = c := by simp [Ex.eval, hc]
    have zs : ∀ v : ℤ, |v| ≤ 2 → zsz v ≤ Bb := fun v hv => le_trans (zsz_mono (by
      have : (v.natAbs : ℤ) ≤ ((2 : ℤ)).natAbs := by rw [Int.natCast_natAbs]; simpa using hv
      exact_mod_cast this)) z2
    have ma := emod2_cases a
    have mc := emod2_cases c
    refine ⟨⟨⟨hia, trivial, by rw [ea]; exact ha0, by simp [Ex.eval]⟩,
      ⟨trivial, ⟨trivial, ⟨hic, trivial, by rw [ec]; exact hc0, by simp [Ex.eval]⟩⟩⟩⟩, ?_⟩
    simp only [t0E, Ex.Bnd, Ex.eval, ha, hc]
    refine ⟨⟨hab, z2, zs _ ?_⟩, ⟨z1, ⟨z2, ⟨hcb, z2, zs _ ?_⟩, zs _ ?_⟩, zs _ ?_⟩, zs _ ?_⟩ <;>
      rcases ma with h1 | h1 <;> rcases mc with h2 | h2 <;> simp [h1, h2]
  abs := by
    intro a c; unfold tf0
    rcases emod2_cases a with h1 | h1 <;> rcases emod2_cases c with h2 | h2 <;> simp [h1, h2]

theorem t0_seg (K ρ n : ℕ) (x y : ℕ) :
    (y : ℤ) + segAcc K tf0 ((x : ℤ) / 2 ^ ρ) ((y : ℤ) / 2 ^ ρ) (2 ^ ρ) n = T0n K ρ n x y := by
  unfold T0n segAcc
  congr 1
  refine Finset.sum_congr rfl (fun i _ => ?_)
  have e1 : (x : ℤ) / 2 ^ ρ / 2 ^ (i * K) = x / 2 ^ (ρ + i * K) := by
    rw [Int.ediv_ediv_of_nonneg (by positivity), ← pow_add]
  have e2 : (y : ℤ) / 2 ^ ρ / 2 ^ (i * K) = y / 2 ^ (ρ + i * K) := by
    rw [Int.ediv_ediv_of_nonneg (by positivity), ← pow_add]
  rw [e1, e2, ← pow_add, tf0]
  unfold ctl bitAt
  rcases emod2_cases ((x : ℤ) / 2 ^ (ρ + i * K)) with h | h <;> simp [h]

set_option maxHeartbeats 1000000 in
theorem t0R_fsp {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {Bb : ℕ} (hB2 : 2 ≤ Bb)
    (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb) (s : IState HS) (H : Fin HS → List ℤ) (hHc : H rC = [])
    (c : Tr) (hc : TV (2 ^ (f * K)) c) :
    FSp (t0R K ρ f) (encK s (trF H c)) (encK s (trF H (T0c K ρ f c))) (cT0 K f Bb) := by
  obtain ⟨zl, hpw, zr, zK, zf, zQ⟩ := zfacts hK hρK hf hbig
  obtain ⟨hx, hy, hz⟩ := hc
  set Q : ℤ := 2 ^ (f * K) with hQdef
  have hQ0 : (0 : ℤ) < Q := by positivity
  have hρ0 : (0 : ℤ) < 2 ^ ρ := by positivity
  set G := trF H c
  have hGc : G rC = [] := by
    simp only [G]; rw [trF_ne H c (j := rC) (by decide) (by decide) (by decide)]; exact hHc
  have hxQ : (c.1 : ℤ) < Q := by simp only [Q]; exact_mod_cast hx
  have hyQ : (c.2.1 : ℤ) < Q := by simp only [Q]; exact_mod_cast hy
  have dle : ∀ v : ℤ, 0 ≤ v → v / 2 ^ ρ ≤ v := fun v hv => Int.ediv_le_self _ hv
  have hx0 : (0 : ℤ) ≤ c.1 := by positivity
  have hy0 : (0 : ℤ) ≤ c.2.1 := by positivity
  have zx : zsz (c.1 : ℤ) ≤ Bb := zl _ (by rw [abs_of_nonneg hx0]; linarith)
  have zy : zsz (c.2.1 : ℤ) ≤ Bb := zl _ (by rw [abs_of_nonneg hy0]; linarith)
  have Eu : ESp (.ndiv (.reg rX) (.lit (2 ^ ρ))) (encK s G) Bb ((c.1 : ℤ) / 2 ^ ρ) :=
    ESp.ndiv (ESp.reg (by decide) (trF_X H c) zx) (ESp.lit zr) hx0 hρ0
      (zl _ (by rw [abs_of_nonneg (by positivity)]; have := dle _ hx0; linarith))
  have Ev : ESp (.ndiv (.reg rY) (.lit (2 ^ ρ))) (encK s G) Bb ((c.2.1 : ℤ) / 2 ^ ρ) :=
    ESp.ndiv (ESp.reg (by decide) (trF_Y H c) zy) (ESp.lit zr) hy0 hρ0
      (zl _ (by rw [abs_of_nonneg (by positivity)]; have := dle _ hy0; linarith))
  have Ea : ESp (.reg rY) (encK s G) Bb (c.2.1 : ℤ) := ESp.reg (by decide) (trF_Y H c) zy
  set r : ℤ := (c.2.1 : ℤ) + segAcc K tf0 ((c.1 : ℤ) / 2 ^ ρ) ((c.2.1 : ℤ) / 2 ^ ρ) (2 ^ ρ) (f - 1)
  have hacc := segAcc_abs hK (segT_t0E hB2).abs ((c.1 : ℤ) / 2 ^ ρ) ((c.2.1 : ℤ) / 2 ^ ρ) (2 ^ ρ)
    hρ0.le (f - 1)
  have hr4 : |r| ≤ 4 * Q := by
    have := abs_add_le (c.2.1 : ℤ) (segAcc K tf0 ((c.1 : ℤ) / 2 ^ ρ) ((c.2.1 : ℤ) / 2 ^ ρ) (2 ^ ρ)
      (f - 1))
    rw [abs_of_nonneg hy0] at this
    have : (0 : ℤ) ≤ 2 ^ ((f - 1) * K) := by positivity
    nlinarith
  have Efin : ∀ G' : Fin HS → List ℤ, G' rA = r :: G rA →
      (∀ i, i ≠ rA → i ≠ NLogN.KFL.rU → i ≠ rV → i ≠ rW → G' i = G i) → ESp (.reg rA) (encK s G') Bb r :=
    fun G' hA _ => ESp.reg (by decide) hA (zl _ hr4)
  have hbig' : |(c.2.1 : ℤ)| + 2 * 2 ^ ρ * 2 ^ ((f - 1) * K) < 2 ^ Bb := by
    have : (4 * Q : ℤ) < 2 ^ Bb := by simp only [Q]; exact_mod_cast hbig
    rw [abs_of_nonneg hy0]; nlinarith
  have NV : NoSeg (.ndiv (.reg rY) (.lit (2 ^ ρ))) := by
    intro i hi; simp only [Ex.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
      or_false] at hi; subst hi; decide
  have NA : NoSeg (.reg rY) := by
    intro i hi; simp only [Ex.regs, List.mem_singleton] at hi; subst hi; decide
  have S := segStep_fsp hK (segT_t0E hB2) s G hGc (tgt := rY) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (trF_Y H c) zy (u := (c.1 : ℤ) / 2 ^ ρ)
    (v := (c.2.1 : ℤ) / 2 ^ ρ) (by positivity) (by positivity) hρ0
    (zl _ (by rw [abs_of_nonneg (by positivity)]; have := dle _ hx0; linarith))
    (zl _ (by rw [abs_of_nonneg (by positivity)]; have := dle _ hy0; linarith)) zr zK zf hbig'
    NV NA Eu Ev Ea Efin
  refine (S.congr ?_).mono (le_of_eq ?_)
  · congr 1
    have hr : r = ((c.2.1 ^^^ (c.1 &&& selM K ρ (f - 1)) : ℕ) : ℤ) := by
      simp only [r]; rw [t0_seg K ρ (f - 1) c.1 c.2.1, T0n_eq hK]
    rw [hr]
    exact trF_updY H c _
  · simp only [cT0, Ex.size, Nat.reduceAdd]

theorem cLine_le {K f Bb : ℕ} {b : ℤ} (hb : b = 0 ∨ b = 1) : cLine K f b Bb ≤ cLine K f 0 Bb := by
  rcases hb with rfl | rfl
  · exact le_rfl
  · unfold cLine cStep
    have : cSegIt (offE 1) Bb ≤ cSegIt (offE 0) Bb := by
      unfold cSegIt
      have : (offE 1).size ≤ (offE 0).size := by simp [offE, Ex.size]
      have := Nat.mul_le_mul_right (4 * 10 ^ 7 * (Bb + 2) ^ 2) (Nat.add_le_add_right this 8)
      nlinarith
    have := cLp_mono (N := f - 1) (Bb := Bb) le_rfl this le_rfl
    omega

theorem progL_fsp {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {Bb : ℕ} (hB2 : 2 ≤ Bb)
    (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb) (s : IState HS) (H : Fin HS → List ℤ) (hHc : H rC = []) :
    ∀ (ls : List Line), (∀ l ∈ ls, LineOK l) → ∀ c : Tr, TV (2 ^ (f * K)) c →
      FSp (progL K ρ f ls) (encK s (trF H c))
        (encK s (trF H (ls.foldr (fun l c => lineP K ρ f l c) c)))
        (1 + ls.length * cLine K f 0 Bb)
  | [], _, c, _ => by
    simp only [progL, List.length_nil, zero_mul, add_zero, List.foldr_nil]; exact FSp.skip _
  | l :: ls, hl, c, hc => by
    have h1 := progL_fsp hK hρK hf hB2 hbig s H hHc ls (fun l' hl' => hl l' (by simp [hl'])) c hc
    have hc' := TV_foldr (K := K) (ρ := ρ) (f := f) ls c hc
    obtain ⟨hs, hb⟩ := hl l (by simp)
    have h2 := lineR_fsp hK hρK hf l hs hb hB2 hbig s H hHc _ hc'
    refine (h1.seq h2).mono ?_
    have := cLine_le (K := K) (f := f) (Bb := Bb) hb
    simp only [List.length_cons]; nlinarith

theorem fst_FSc (K ρ f : ℕ) (c : Tr) : (FSc K ρ f c).1 = c.1 := by
  unfold FSc
  induction lines with
  | nil => rfl
  | cons l ls ih =>
    simp only [List.foldr_cons]
    unfold lineP; split_ifs <;> exact ih

end NLogN.KFL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD Butterfly
set_option maxHeartbeats 2000000
theorem solution {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {g : NLogN.KFL.Geo} (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * g.V < 2 ^ Bb)
    (s : NLogN.IState NLogN.HS) (G : Fin NLogN.HS → List ℤ) (hGc : G NLogN.KFL.rC = []) {m : ℕ} (hm : m < g.V)
    {lm : List ℤ} (hGm : G NLogN.KFL.rm = (m : ℤ) :: lm) :
    NLogN.KFD.FSp (NLogN.KFL.keyProg K ρ f g) (NLogN.KIL.encK s G)
      (NLogN.KIL.encK s (Function.update G NLogN.KFL.rK ((NLogN.KFL.phi g (NLogN.KFL.keyc K ρ f) m : ℤ) :: G NLogN.KFL.rK))) (NLogN.KFL.cKey K f Bb) := by
  have hS0 : g.S0 ≤ g.V := by
    show g.S0 ≤ g.Q * g.S0 * g.N0
    calc g.S0 = 1 * g.S0 * 1 := by ring
      _ ≤ g.Q * g.S0 * g.N0 := Nat.mul_le_mul (Nat.mul_le_mul hg.q le_rfl) hg.n0
  have hQS1 : g.Q * g.S1 ≤ g.S0 := Nat.le_mul_of_pos_right _ hg.n1
  have hS0V : g.Q * g.S1 ≤ g.V := le_trans hQS1 hS0
  have hS1V : g.S1 ≤ g.V := le_trans (Nat.le_mul_of_pos_left _ hg.q) hS0V
  have hS2 : g.Q * g.S2 ≤ g.S1 := Nat.le_mul_of_pos_right _ hg.n2
  have hQV : g.Q ≤ g.V := le_trans (Nat.le_mul_of_pos_right _ hg.s1) hS0V
  have hbigQ : 4 * 2 ^ (f * K) < 2 ^ Bb := by rw [← hQe]; omega
  obtain ⟨zl, hpw, zr, zK, zf, zQ⟩ := NLogN.KFL.zfacts hK hρK hf hbigQ
  have hb4 : ((4 * g.V : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hbig
  push_cast at hb4
  have zV : ∀ v : ℤ, |v| ≤ 4 * g.V → NLogN.zsz v ≤ Bb := fun v hv => NLogN.KFL.zsz_of_le hb4 hv
  have zN : ∀ n : ℕ, n ≤ g.V → NLogN.zsz (n : ℤ) ≤ Bb := fun n hn => zV _ (by
    rw [abs_of_nonneg (by positivity)]; have : (n : ℤ) ≤ g.V := by exact_mod_cast hn
    linarith)
  -- the coordinates
  set c := NLogN.KFL.trOf g m with hc_def
  have hcT : NLogN.KFL.TV (2 ^ (f * K)) c := by rw [← hQe]; exact NLogN.KFL.TV_trOf hg m
  have Egc : ∀ (G' : Fin NLogN.HS → List ℤ), G' NLogN.KFL.rm = (m : ℤ) :: lm → ∀ S : ℕ, 0 < S → S ≤ g.V →
      NLogN.KFL.ESp (NLogN.KFL.gcE S g.Q) (NLogN.KIL.encK s G') Bb ((NLogN.KFL.gc g.Q S m : ℕ) : ℤ) := by
    intro G' hG' S hS hSV
    have e : ((NLogN.KFL.gc g.Q S m : ℕ) : ℤ) = (m : ℤ) / S % g.Q := by simp [NLogN.KFL.gc]
    rw [e]
    refine NLogN.KFL.ESp.nmod (NLogN.KFL.ESp.ndiv (NLogN.KFL.ESp.reg (by decide) hG' (zN _ hm.le)) (NLogN.KFL.ESp.lit (zN _ hSV))
      (by positivity) (by exact_mod_cast hS) ?_) (NLogN.KFL.ESp.lit (zN _ hQV)) (by positivity)
      (by exact_mod_cast hg.q) ?_
    · have : (m : ℤ) / S = ((m / S : ℕ) : ℤ) := by push_cast; rfl
      rw [this]; exact zN _ (le_trans (Nat.div_le_self _ _) hm.le)
    · rw [← e]; exact zN _ (le_trans (NLogN.KFL.gc_lt hg.q _).le hQV)
  have s0p := hg.s0
  have s1p := hg.s1
  have s2p := hg.s2
  have S2V : g.S2 ≤ g.V := le_trans (le_trans (Nat.le_mul_of_pos_left _ hg.q) hS2) hS1V
  -- pushes
  have S1 := NLogN.KIL.Sp.pushQ s G (i := NLogN.KFL.rY0) (by decide) (Egc G hGm g.S1 s1p hS1V).clean
    (Egc G hGm g.S1 s1p hS1V).ok (Egc G hGm g.S1 s1p hS1V).bnd
  rw [(Egc G hGm g.S1 s1p hS1V).ev] at S1
  set G1 := Function.update G NLogN.KFL.rY0 ((c.2.1 : ℤ) :: G NLogN.KFL.rY0) with hG1
  have g1m : G1 NLogN.KFL.rm = (m : ℤ) :: lm := by simp only [G1]; rw [NLogN.KFL.upd_ne (by decide)]; exact hGm
  have S2 := NLogN.KIL.Sp.pushQ s G1 (i := NLogN.KFL.rZ0) (by decide) (Egc G1 g1m g.S2 s2p S2V).clean
    (Egc G1 g1m g.S2 s2p S2V).ok (Egc G1 g1m g.S2 s2p S2V).bnd
  rw [(Egc G1 g1m g.S2 s2p S2V).ev] at S2
  set G2 := Function.update G1 NLogN.KFL.rZ0 ((c.2.2 : ℤ) :: G1 NLogN.KFL.rZ0) with hG2
  have g2m : G2 NLogN.KFL.rm = (m : ℤ) :: lm := by simp only [G2]; rw [NLogN.KFL.upd_ne (by decide)]; exact g1m
  have S3 := NLogN.KIL.Sp.pushQ s G2 (i := NLogN.KFL.rX) (by decide) (Egc G2 g2m g.S0 s0p hS0).clean
    (Egc G2 g2m g.S0 s0p hS0).ok (Egc G2 g2m g.S0 s0p hS0).bnd
  rw [(Egc G2 g2m g.S0 s0p hS0).ev] at S3
  set G3 := Function.update G2 NLogN.KFL.rX ((c.1 : ℤ) :: G2 NLogN.KFL.rX) with hG3
  have g3m : G3 NLogN.KFL.rm = (m : ℤ) :: lm := by simp only [G3]; rw [NLogN.KFL.upd_ne (by decide)]; exact g2m
  have S4 := NLogN.KIL.Sp.pushQ s G3 (i := NLogN.KFL.rY) (by decide) (Egc G3 g3m g.S1 s1p hS1V).clean
    (Egc G3 g3m g.S1 s1p hS1V).ok (Egc G3 g3m g.S1 s1p hS1V).bnd
  rw [(Egc G3 g3m g.S1 s1p hS1V).ev] at S4
  set G4 := Function.update G3 NLogN.KFL.rY ((c.2.1 : ℤ) :: G3 NLogN.KFL.rY) with hG4
  have g4m : G4 NLogN.KFL.rm = (m : ℤ) :: lm := by simp only [G4]; rw [NLogN.KFL.upd_ne (by decide)]; exact g3m
  have S5 := NLogN.KIL.Sp.pushQ s G4 (i := NLogN.KFL.rZ) (by decide) (Egc G4 g4m g.S2 s2p S2V).clean
    (Egc G4 g4m g.S2 s2p S2V).ok (Egc G4 g4m g.S2 s2p S2V).bnd
  rw [(Egc G4 g4m g.S2 s2p S2V).ev] at S5
  have e5 : Function.update G4 NLogN.KFL.rZ ((c.2.2 : ℤ) :: G4 NLogN.KFL.rZ) = NLogN.KFL.trF G2 c := by
    funext j; simp only [G4, G3, NLogN.KFL.trF, Function.update_apply]
    by_cases h1 : j = NLogN.KFL.rZ
    · subst h1; simp +decide
    by_cases h2 : j = NLogN.KFL.rY
    · subst h2; simp +decide
    by_cases h3 : j = NLogN.KFL.rX
    · subst h3; simp +decide
    simp [h1, h2, h3]
  have S5' : NLogN.KIL.Sp (.push NLogN.KFL.rZ (NLogN.KFL.gcE g.S2 g.Q)) (NLogN.KIL.encK s G4) (NLogN.KIL.encK s (NLogN.KFL.trF G2 c))
      (((NLogN.KFL.gcE g.S2 g.Q).size + 1) * 10 ^ 7 * (Bb + 2) ^ 2) := by
    rw [← e5]; exact S5
  have g2c : G2 NLogN.KFL.rC = [] := by
    simp only [G2, G1]; rw [NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide)]; exact hGc
  -- lines and T0
  have SL := NLogN.KFL.progL_fsp hK hρK hf hB2 hbigQ s G2 g2c Butterfly.lines NLogN.KFL.lines_ok c hcT
  have hcT' := NLogN.KFL.TV_foldr (K := K) (ρ := ρ) (f := f) Butterfly.lines c hcT
  have ST := NLogN.KFL.t0R_fsp hK hρK hf hB2 hbigQ s G2 g2c _ hcT'
  set kc := NLogN.KFL.T0c K ρ f (Butterfly.lines.foldr (fun l c => NLogN.KFL.lineP K ρ f l c) c) with hkc
  have hkc' : kc = NLogN.KFL.keyc K ρ f c := rfl
  have hkT : NLogN.KFL.TV (2 ^ (f * K)) kc := NLogN.KFL.TV_keyc c hcT
  -- the key
  set G6 := NLogN.KFL.trF G2 kc with hG6
  have g6m : G6 NLogN.KFL.rm = (m : ℤ) :: lm := by
    simp only [G6]; rw [NLogN.KFL.trF_ne _ _ (by decide) (by decide) (by decide)]; exact g2m
  have g6y0 : G6 NLogN.KFL.rY0 = (c.2.1 : ℤ) :: G rY0 := by
    simp only [G6]; rw [NLogN.KFL.trF_ne _ _ (by decide) (by decide) (by decide)]; simp only [G2, G1]
    rw [NLogN.KFL.upd_ne (by decide), Function.update_self]
  have g6z0 : G6 NLogN.KFL.rZ0 = (c.2.2 : ℤ) :: G rZ0 := by
    simp only [G6]; rw [NLogN.KFL.trF_ne _ _ (by decide) (by decide) (by decide)]; simp only [G2, G1]
    rw [Function.update_self, NLogN.KFL.upd_ne (by decide)]
  obtain ⟨kx, ky, kz⟩ := hkT
  obtain ⟨cx, cy, cz⟩ := hcT
  have hQi : ((2 ^ (f * K) : ℕ) : ℤ) = (g.Q : ℤ) := by rw [hQe]
  have hyd : |(kc.2.1 : ℤ) + -(c.2.1 : ℤ)| ≤ g.Q := by
    rw [abs_le]; constructor <;> push_cast at hQi ⊢ <;>
    · have : (kc.2.1 : ℤ) < g.Q := by rw [← hQi]; exact_mod_cast ky
      have : (c.2.1 : ℤ) < g.Q := by rw [← hQi]; exact_mod_cast cy
      have : (0 : ℤ) ≤ kc.2.1 := by positivity
      have : (0 : ℤ) ≤ c.2.1 := by positivity
      linarith
  have hzd : |(kc.2.2 : ℤ) + -(c.2.2 : ℤ)| ≤ g.Q := by
    rw [abs_le]; constructor <;> push_cast at hQi ⊢ <;>
    · have : (kc.2.2 : ℤ) < g.Q := by rw [← hQi]; exact_mod_cast kz
      have : (c.2.2 : ℤ) < g.Q := by rw [← hQi]; exact_mod_cast cz
      have : (0 : ℤ) ≤ kc.2.2 := by positivity
      have : (0 : ℤ) ≤ c.2.2 := by positivity
      linarith
  have QS1 : (g.Q : ℤ) * g.S1 ≤ g.V := by exact_mod_cast hS0V
  have QS2 : (g.Q : ℤ) * g.S2 ≤ g.V := by exact_mod_cast (le_trans hS2 hS1V)
  have hmV : (m : ℤ) ≤ g.V := by exact_mod_cast hm.le
  have h1 : |((kc.2.1 : ℤ) + -(c.2.1 : ℤ)) * g.S1| ≤ g.V := by
    rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℤ) ≤ g.S1)]
    nlinarith [abs_nonneg ((kc.2.1 : ℤ) + -(c.2.1 : ℤ))]
  have h2 : |((kc.2.2 : ℤ) + -(c.2.2 : ℤ)) * g.S2| ≤ g.V := by
    rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℤ) ≤ g.S2)]
    nlinarith [abs_nonneg ((kc.2.2 : ℤ) + -(c.2.2 : ℤ))]
  have hQV' : (g.Q : ℤ) ≤ g.V := by exact_mod_cast hQV
  set kv := (m : ℤ) + (((kc.2.1 : ℤ) + -(c.2.1 : ℤ)) * g.S1 + ((kc.2.2 : ℤ) + -(c.2.2 : ℤ)) * g.S2)
  have EK : NLogN.KFL.ESp (NLogN.KFL.keyE g.S1 g.S2) (NLogN.KIL.encK s G6) Bb kv := by
    have rk : ∀ v : ℤ, |v| ≤ 3 * g.V → NLogN.zsz v ≤ Bb := fun v hv => zV v (by
      have : (0 : ℤ) ≤ g.V := by positivity
      linarith)
    refine NLogN.KFL.ESp.add (NLogN.KFL.ESp.reg (by decide) g6m (zN _ hm.le)) (NLogN.KFL.ESp.add (NLogN.KFL.ESp.mul (NLogN.KFL.ESp.add
      (NLogN.KFL.ESp.reg (by decide) (NLogN.KFL.trF_Y G2 kc) ?_) (NLogN.KFL.ESp.neg (NLogN.KFL.ESp.reg (by decide) g6y0 ?_)) ?_)
      (NLogN.KFL.ESp.lit (zN _ hS1V)) (rk _ (by linarith))) (NLogN.KFL.ESp.mul (NLogN.KFL.ESp.add
      (NLogN.KFL.ESp.reg (by decide) (NLogN.KFL.trF_Z G2 kc) ?_) (NLogN.KFL.ESp.neg (NLogN.KFL.ESp.reg (by decide) g6z0 ?_)) ?_)
      (NLogN.KFL.ESp.lit (zN _ S2V)) (rk _ (by linarith))) (rk _ ?_)) (rk _ ?_)
    · exact zN _ (by rw [← hQe] at ky; omega)
    · exact zN _ (by rw [← hQe] at cy; omega)
    · exact rk _ (by linarith)
    · exact zN _ (by rw [← hQe] at kz; omega)
    · exact zN _ (by rw [← hQe] at cz; omega)
    · exact rk _ (by linarith)
    · exact le_trans (abs_add_le _ _) (by linarith)
    · refine le_trans (abs_add_le _ _) ?_
      rw [abs_of_nonneg (by positivity : (0 : ℤ) ≤ m)]
      have := abs_add_le (((kc.2.1 : ℤ) + -(c.2.1 : ℤ)) * g.S1)
        (((kc.2.2 : ℤ) + -(c.2.2 : ℤ)) * g.S2)
      linarith
  have hkey : kv = (NLogN.KFL.phi g (NLogN.KFL.keyc K ρ f) m : ℤ) := by
    have hF : ∀ c, NLogN.KFL.TV g.Q c → NLogN.KFL.TV g.Q (NLogN.KFL.keyc K ρ f c) := fun c hc => by
      rw [hQe] at hc ⊢; exact NLogN.KFL.TV_keyc c hc
    rw [NLogN.KFL.phi_int hg hF m, ← hc_def, ← hkc']
    have hx1 : kc.1 = c.1 := by rw [hkc]; simp only [NLogN.KFL.T0c]; exact NLogN.KFL.fst_FSc K ρ f c
    rw [hx1]; simp only [kv]; ring
  have S6 := NLogN.KIL.Sp.pushQ s G6 (i := NLogN.KFL.rK) (by decide) EK.clean EK.ok EK.bnd
  rw [EK.ev, hkey] at S6
  set key := (NLogN.KFL.phi g (NLogN.KFL.keyc K ρ f) m : ℤ)
  set G7 := Function.update G6 NLogN.KFL.rK (key :: G6 NLogN.KFL.rK) with hG7
  -- pops
  have g7x : G7 NLogN.KFL.rX = (kc.1 : ℤ) :: G2 rX := by
    simp only [G7]; rw [NLogN.KFL.upd_ne (by decide)]; exact NLogN.KFL.trF_X G2 kc
  have S7 := NLogN.KIL.Sp.pop s G7 (B := Bb) (by decide) g7x (zN _ (by rw [← hQe] at kx; omega))
  set G8 := Function.update G7 NLogN.KFL.rX (G2 NLogN.KFL.rX)
  have g8y : G8 NLogN.KFL.rY = (kc.2.1 : ℤ) :: G2 rY := by
    simp only [G8, G7]; rw [NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide)]; exact NLogN.KFL.trF_Y G2 kc
  have S8 := NLogN.KIL.Sp.pop s G8 (B := Bb) (by decide) g8y (zN _ (by rw [← hQe] at ky; omega))
  set G9 := Function.update G8 NLogN.KFL.rY (G2 NLogN.KFL.rY)
  have g9z : G9 NLogN.KFL.rZ = (kc.2.2 : ℤ) :: G2 rZ := by
    simp only [G9, G8, G7]; rw [NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide)]
    exact NLogN.KFL.trF_Z G2 kc
  have S9 := NLogN.KIL.Sp.pop s G9 (B := Bb) (by decide) g9z (zN _ (by rw [← hQe] at kz; omega))
  set G10 := Function.update G9 NLogN.KFL.rZ (G2 NLogN.KFL.rZ)
  have g10y : G10 NLogN.KFL.rY0 = (c.2.1 : ℤ) :: G rY0 := by
    simp only [G10, G9, G8, G7]
    rw [NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide)]
    exact g6y0
  have S10 := NLogN.KIL.Sp.pop s G10 (B := Bb) (by decide) g10y (zN _ (by rw [← hQe] at cy; omega))
  set G11 := Function.update G10 NLogN.KFL.rY0 (G NLogN.KFL.rY0)
  have g11z : G11 NLogN.KFL.rZ0 = (c.2.2 : ℤ) :: G rZ0 := by
    simp only [G11, G10, G9, G8, G7]
    rw [NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide), NLogN.KFL.upd_ne (by decide),
      NLogN.KFL.upd_ne (by decide)]
    exact g6z0
  have S11 := NLogN.KIL.Sp.pop s G11 (B := Bb) (by decide) g11z (zN _ (by rw [← hQe] at cz; omega))
  have hfin : Function.update G11 NLogN.KFL.rZ0 (G NLogN.KFL.rZ0) = Function.update G NLogN.KFL.rK (key :: G NLogN.KFL.rK) := by
    funext j
    simp only [G11, G10, G9, G8, G7, G6, NLogN.KFL.trF, G2, G1, Function.update_apply]
    by_cases a1 : j = NLogN.KFL.rZ0
    · subst a1; simp +decide
    by_cases a2 : j = NLogN.KFL.rY0
    · subst a2; simp +decide
    by_cases a3 : j = NLogN.KFL.rZ
    · subst a3; simp +decide
    by_cases a4 : j = NLogN.KFL.rY
    · subst a4; simp +decide
    by_cases a5 : j = NLogN.KFL.rX
    · subst a5; simp +decide
    by_cases a6 : j = NLogN.KFL.rK
    · subst a6; simp +decide
    simp [a1, a2, a3, a4, a5, a6]
  have H := (NLogN.KFD.FSp.of_norep rfl S1).seq ((NLogN.KFD.FSp.of_norep rfl S2).seq ((NLogN.KFD.FSp.of_norep rfl S3).seq
    ((NLogN.KFD.FSp.of_norep rfl S4).seq ((NLogN.KFD.FSp.of_norep rfl S5').seq (SL.seq (ST.seq
    ((NLogN.KFD.FSp.of_norep rfl S6).seq ((NLogN.KFD.FSp.of_norep rfl S7).seq ((NLogN.KFD.FSp.of_norep rfl S8).seq
    ((NLogN.KFD.FSp.of_norep rfl S9).seq ((NLogN.KFD.FSp.of_norep rfl S10).seq (NLogN.KFD.FSp.of_norep rfl S11))))))))))))
  refine (H.congr (by rw [hfin])).mono ?_
  simp only [NLogN.KFL.cKey, NLogN.KFL.gcE, NLogN.KFL.keyE, NLogN.Ex.size, List.length, Butterfly.lines]
  have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
  generalize (Bb + 2) ^ 2 = X at *
  generalize NLogN.KFL.cLine K f 0 Bb = Y
  generalize NLogN.KFL.cT0 K f Bb = Z
  omega
end
