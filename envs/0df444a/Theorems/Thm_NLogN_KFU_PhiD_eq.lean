open NLogN
open NLogN.KFU
open IntMul KFC AModel AModelL12
variable {d : ℕ} {sF μ : ℕ → ℕ}
open Classical

theorem NLogN.KFU.PhiD_eq (H : CrtOK d sF μ) (h : ℕ) (bL : ℕ → Bool) (hst : ∀ j < d, sF j ≤ 2 ^ h)
    (xs : List ℤ) :
    PhiD h d bL sF μ xs = (List.range (vol (shR d (NLogN.KFU.tP d h bL)))).map fun j =>
      if Valid (shR d (sP d sF)) (decode (shR d (NLogN.KFU.tP d h bL)) j) then
        xs.getD (2 * NLogN.KFU.kOf d sF μ (decode (shR d (NLogN.KFU.tP d h bL)) j) +
          (decode (shR d (NLogN.KFU.tP d h bL)) j).getD d 0) 0
      else 0 := by sorry
