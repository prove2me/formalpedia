-- Source module: Solutions.KFDLevel
/-!
# KFD: the fine body of one uniform level

`bodyF C tpl j0` is KIL5's `bodyU` with every per-element piece replaced by its fine form:
`fcode (subU …)`, the row split / merge by KFC's `bwdF` / `fwdF`, the fine network `netCF`
with fine frame changes `edgeCF` (fine level steps `fcode (stepU …)`), the fine routing
`fcode (rebuildCU …)`.  `bodyF_run`: the same denotation `levelR` as `bodyU_run`, with the fine
cost `bodyCF`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedVariables false

namespace NLogN

open IntMul RS

namespace KFD

open KIL AModel AModelL12

section Gen

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- Push `l`, run the item program `p`, pop. -/
def withPushI (l : List (Fin HS × Ex HS)) (p : IStmt HS Pp) : IStmt HS Pp :=
  .seq (pushes l).code (.seq p (popsR (l.map Prod.fst)).code)

end Gen

section Code

variable {Pp : ℕ}

/-- The fine code of one template. -/
def tCodeF (m : ℕ) (j0 : Fin Pp) : TStep m → IStmt HS Pp
  | .sh T => fcode (stepU m rXs T)
  | .sw a b => NLogN.KIL.swC m j0 (a : ℕ) (b : ℕ)

/-- The fine code of a frame change. -/
def edgeCF (m : ℕ) (j0 : Fin Pp) (Ts : List (TStep m)) : IStmt HS Pp :=
  KIL.seqL (Ts.map (tCodeF m j0))

end Code

section Edge

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

end Edge

section Body

variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}

/-- **The fine uniform level body.** -/
def bodyF (tpl : IMat m → List (TStep m)) (j0 : Fin Pp) : IStmt HS Pp :=
  .seq (fcode (subU m rXb)) (.seq (withPushI (splitL W) KFC.bwdF)
  (.seq (netCF (fun X => edgeCF m j0 (tpl X)) C.Mout C.Min C.gates)
  (.seq (fcode (rebuildCU W (NLogN.KIL.permT C))) (.seq (withPushI (splitL W) KFC.fwdF)
    (fcode (flipU m rXb))))))

/-- Fine cost of a shift template on streams of volume `v` (bit data). -/
def cShTF (v Bb : ℕ) (T : TSh m) : ℕ :=
  cStepGF T.k T.d (stgT rXs T).length v 1 Bb (paT rXs T) (pcT T) (stgT rXs T)

/-- Fine cost of the body (`cC`: cost of one child call wrapper). -/
def bodyCF (tpl : IMat m → List (TStep m)) (N P L' : ℕ) (A B Cs : Shape) (cC Bb : ℕ) : ℕ :=
  cStepsUF rXb (vol (P :: W * L' :: hdShape A B Cs m N)) 1 Bb (subT m) +
  (cSplit W Bb + KFC.cBwdF 1 W (P * L') (vol (hdShape A B Cs m N)) 1) +
  (netCIF (fun X => edgeCost (cShTF (vol (P :: L' :: hdShape A B Cs m N)) Bb) cC (tpl X))
    (W * vol (P :: L' :: hdShape A B Cs m N)) Bb C.Mout C.Min C.gates +
  (cRebuildF W (W * vol (P :: L' :: hdShape A B Cs m N)) Bb +
  ((cSplit W Bb + KFC.cFwdF 1 W (P * L') (vol (hdShape A B Cs m N)) 1) +
  cStepsUF rXb (vol (P :: W * L' :: hdShape A B Cs m N)) 1 Bb (flipT m))))

end Body

end KFD

end NLogN

end

section
-- Source module: Solutions.KFDProg
/-!
# KFD: the fine uniform Prop. 11 procedure

* `swapEF`, `lev0F`: the level-`0` digit interchange by KFC's fine field moves (`fwdF`/`bwdF`),
  cost `≤ (4q+136)·kap w·V + 10^9 (Bb+2)²` (`cLev0F_le`).
* `levF`, `progF`: KIL5's `levU`/`progU` with the fine body `bodyF` and `lev0F`.
* `levelCostF_le`: one level costs `KlevF·(V+1) + KbF·(Bb+2)² + SWn·cC` — linear in the
  volume, plus a per-call `poly(Bb)` overhead.
* `progF_run`: the same denotation `prog C q k P L A B Cs` as `progU_run`, cost `ilCostF`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedVariables false

namespace NLogN

open IntMul RS

namespace KFD

open KIL AModel AModelL12

section Swap

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The fine level-`0` interchange with parameters `a = vol A0`, `q`, `b = vol B`, `c = vol Cs`. -/
def swapEF (a q b c : Ex HS) : IStmt HS Pp :=
  .seq (withPushI [(1, a), (2, q), (3, .mul b q), (4, c)] KFC.fwdF)
    (withPushI [(1, a), (2, q), (3, b), (4, .mul q c)] KFC.bwdF)

/-- Fine cost of `swapEF` (`w`: bit size of the entries). -/
def cSwapEF (a q b c : Ex HS) (qn V Bb w : ℕ) : ℕ :=
  pushCost Bb [(1, a), (2, q), (3, .mul b q), (4, c)] + pushCost Bb [(1, a), (2, q), (3, b), (4, .mul q c)] +
    ((2 * qn + 67) * KFC.kap w * V + (2 * qn + 69) * KFC.kap w * V) +
    2 * (4 * (2 * Bb + 2) + 1)

/-- The fine level-`0` code. -/
def lev0F : IStmt HS Pp :=
  swapEF (.mul (.reg NLogN.KIL.dP) (.mul (.reg dL) (.reg dA))) (.reg dT) (.reg dB) (.reg dC)

def cLev0F (q V Bb w : ℕ) : ℕ :=
  cSwapEF (.mul (.reg NLogN.KIL.dP) (.mul (.reg dL) (.reg dA))) (.reg dT) (.reg dB) (.reg dC) q V Bb w

end Swap

section Costs

variable {m : ℕ}

/-- Sum of the fine template constants of the shifts of a template list. -/
def shKF : List (TStep m) → ℕ
  | [] => 0
  | .sh T :: Ts => tKF rXs T + shKF Ts
  | .sw _ _ :: Ts => shKF Ts

/-- The per-shift fine cost unit on bit data, `v` the stream volume. -/
def zU (v Bb : ℕ) : ℕ := 10 ^ 13 * ((v + 1) * (1 + 2)) + 10 ^ 10 * (Bb + 2) ^ 2

end Costs

section LevCost

variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W) (tpl : IMat m → List (TStep m))

/-- Fine template constants of all shifts of all frame changes of one level. -/
def KShF : ℕ := frameSum (fun X => shKF (tpl X)) C.gates C.Min C.Mout

/-- Number of table units (frame changes and gates) of one level. -/
def nTab : ℕ := nFr C + (C.gates.length + 1) * (W * (2 * W + 2) + 202)

/-- The fine level constants: linear part and per-call `(Bb+2)²` part. -/
def KlevF : ℕ :=
  3 * 10 ^ 13 * (tKFs rXb (subT m) + tKFs rXb (flipT m) + KShF C tpl) +
    2 * (2 * W + 69) * 276 + 10 ^ 9 * nTab C + 100

def KbF : ℕ :=
  10 ^ 10 * (tKFs rXb (subT m) + tKFs rXb (flipT m) + KShF C tpl) +
    2 * ((pushSz (splitL W) + 1) * 10 ^ 7 + 10) + 10 ^ 8 * nTab C +
    (pushSz (entL W m) + 5) * 10 ^ 7 + nTab C + 100

end LevCost

/-- **The fine cost recursion** (`K`: linear level constant, `Kb`: per-call `(Bb+2)²` constant,
`Kd`: per-child-call descriptor constant, `S`: number of child calls per level). -/
def ilCostF (W K Kb Kd S q Bb : ℕ) : ℕ → ℕ → ℕ
  | 0, V => K * (q + 1) * (V + 1) + Kb * (Bb + 2) ^ 2
  | j + 1, V => K * (V + 1) + Kb * (Bb + 2) ^ 2 +
      S * (ilCostF W K Kb Kd S q Bb j (V / W) + Kd * (Bb + 2) ^ 2)

section Main

variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W) (tpl : IMat m → List (TStep m))

/-- One fine level `≥ 1`: entry, fine body, exit. -/
def levF : IStmt HS 1 := .seq (entryU W m).code (.seq (bodyF C tpl (0 : Fin 1)) (exitU W m).code)

/-- **The fine uniform procedure table** (one procedure). -/
def progF : Fin 1 → IStmt HS 1 :=
  fun _ => .ite dJ (fun c => c == .zero) lev0F (levF C tpl)

end Main

end KFD

end NLogN

end

