private theorem t0102 (w : InfinitePlace K) (a : (AdeleRing (𝓞 K) K)ˣ) :
    archDetNorm w (diagOne a) = ‖((a : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w‖ := by
