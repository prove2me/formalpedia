noncomputable def restrictIso {S' : Type} [CommRing S'] {X : Scheme.{0}} (g : X ⟶ Spec (CommRingCat.of S'))
    {M M' : X.Modules} {U V : (Spec (CommRingCat.of S')).Opens} (h : V ≤ U)
    (e : (Scheme.Modules.pullback (g ⁻¹ᵁ U).ι).obj M ≅ (Scheme.Modules.pullback (g ⁻¹ᵁ U).ι).obj M') :
    (Scheme.Modules.pullback (g ⁻¹ᵁ V).ι).obj M ≅ (Scheme.Modules.pullback (g ⁻¹ᵁ V).ι).obj M' :=
  have hVU : g ⁻¹ᵁ V ≤ g ⁻¹ᵁ U := leOfHom ((TopologicalSpace.Opens.map g.base).map (homOfLE h))
  (Scheme.Modules.pullbackCongr (X.homOfLE_ι hVU).symm).app M ≪≫
    ((Scheme.Modules.pullbackComp (X.homOfLE hVU) (g ⁻¹ᵁ U).ι).app M).symm ≪≫
    (Scheme.Modules.pullback (X.homOfLE hVU)).mapIso e ≪≫
    (Scheme.Modules.pullbackComp (X.homOfLE hVU) (g ⁻¹ᵁ U).ι).app M' ≪≫
    (Scheme.Modules.pullbackCongr (X.homOfLE_ι hVU)).app M'

theorem locIsoOnBase_trans {S' : Type} [CommRing S'] {X : Scheme.{0}} (g : X ⟶ Spec (CommRingCat.of S'))
    {M M' M'' : X.Modules} (h : LocIsoOnBase g M M') (h' : LocIsoOnBase g M' M'') : LocIsoOnBase g M M'' := by
  intro s
  obtain ⟨U, hs, ⟨e⟩⟩ := h s
  obtain ⟨U', hs', ⟨e'⟩⟩ := h' s
  exact ⟨U ⊓ U', ⟨hs, hs'⟩, ⟨restrictIso g inf_le_left e ≪≫ restrictIso g inf_le_right e'⟩⟩

end STO22

