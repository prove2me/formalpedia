theorem solution {Pp : ℕ} {I : List NLogN.Sym} {iprog : Fin Pp → NLogN.IStmt NLogN.HS Pp}
    {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (g : NLogN.KFL.Geo) (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) (l : Butterfly.Line) (hs : l.sgn = 1 ∨ l.sgn = -1)
    (hb : l.b = 0 ∨ l.b = 1) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb)
    (zV : NLogN.zsz (g.V : ℤ) ≤ Bb) (w : ℕ)
    (t : NLogN.IState NLogN.HS) (xs : List ℤ) (R : List NLogN.Item) (hlen : xs.length = g.V) (hbw : NLogN.Bnd w xs)
    (h0 : t.G 0 = NLogN.ints xs ++ R) :
    NLogN.IRuns I iprog (NLogN.KFL.rotStep K ρ f (g.N2 * g.Q * g.N1) g.N2 g.Q
        (g.N0 * g.Q * g.N1 * g.Q * g.N2) g.S2 l.sgn l.b) t
      (t.upd 0 (NLogN.ints (NLogN.KFL.rixT g (NLogN.KFL.rot2 g.Q (NLogN.KFL.amt K ρ f l)) xs) ++ R))
      (NLogN.KFL.cRot K f l.b (g.N0 * g.Q * g.N1 * g.Q * g.N2) g.Q g.S2 w Bb) := by
  have hV : g.V = g.N0 * g.Q * g.N1 * g.Q * g.N2 * g.Q * g.S2 := by
    simp only [NLogN.KFL.Geo.V, NLogN.KFL.Geo.S0, NLogN.KFL.Geo.S1]; ring
  have le : ∀ a : ℕ, 0 < a → a ∣ g.V → NLogN.zsz (a : ℤ) ≤ Bb := fun a ha hd =>
    le_trans (NLogN.KIL.zsz_nat_le (Nat.le_of_dvd (by have := hg.v; omega) hd)) zV
  have H := NLogN.KFL.rotStep_runs (I := I) (iprog := iprog) hK hρK hf
    (Nat.mul_pos (Nat.mul_pos hg.n2 hg.q) hg.n1) hg.n2 hQe l hs hb hB2 hbig
    (le _ (Nat.mul_pos (Nat.mul_pos hg.n2 hg.q) hg.n1) ⟨g.N0 * g.Q * g.Q * g.S2, by rw [hV]; ring⟩)
    (le _ hg.n2 ⟨g.N0 * g.Q * g.N1 * g.Q * g.Q * g.S2, by rw [hV]; ring⟩)
    (g.N0 * g.Q * g.N1 * g.Q * g.N2) g.S2 w
    (le _ (by have := hg.n0; have := hg.q; have := hg.n1; have := hg.n2; positivity)
      ⟨g.Q * g.S2, by rw [hV]; ring⟩)
    (le _ hg.s2 ⟨g.N0 * g.Q * g.N1 * g.Q * g.N2 * g.Q, by rw [hV]; ring⟩)
    t xs R (by rw [hlen, hV]) hbw h0
  have e := NLogN.KFL.pull_rot g hg (NLogN.KFL.amt K ρ f l) (NLogN.KFL.tabA K ρ f (g.N2 * g.Q * g.N1) g.N2 g.Q l)
    (fun p => by simp only [NLogN.KFL.tabA]) xs
  have hS2 : g.S2 = g.S2 := rfl
  rw [e] at H
  exact H
end
