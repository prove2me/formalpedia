/-! Descent to the prime field and coefficient extension of generation by the modular units. -/
noncomputable section

namespace N25.Endgame

open N25 AlgebraicCurve

/-- The field generated by the two units has finite positive relative degree in the modular field. -/
theorem _root_.solution (K : Type*) [Field K] [PerfectField K] :
    0 < IntermediateField.relfinrank (unitLaurentField25C K)
      (ModularCurve.qExpFunctionFieldC K Γ25) := by
  let S : IntermediateField K (FBase K) :=
    IntermediateField.adjoin K ({U25C K 0} : Set (FBase K))
  let P : IntermediateField K (FBase K) :=
    IntermediateField.adjoin K
      ({U25C K 0, U25C K 0 / U25C K 1} : Set (FBase K))
  let : IsCurveOver K (FBase K) := xH25C_isCurveOver K
  let : Algebra.EssFiniteType K (FBase K) := xH25C_essFiniteType K
  let : FiniteDimensional S (FBase K) :=
    IsCurveOver.finiteDimensional_adjoin_simple_of_transcendental_of_essFiniteType
      (U25C_zero_transcendental K)
  have hSP : S ≤ P := IntermediateField.adjoin.mono _ _ _ (by
    intro z hz
    have he : z = U25C K 0 := Set.mem_singleton_iff.mp hz
    subst z
    exact Set.mem_insert _ _)
  have hsimple : 0 < IntermediateField.relfinrank S (⊤ : IntermediateField K (FBase K)) := by
    rw [IntermediateField.relfinrank_top_right]
    exact Module.finrank_pos
  have hpair : 0 < IntermediateField.relfinrank P (⊤ : IntermediateField K (FBase K)) :=
    Nat.pos_of_dvd_of_pos
      (IntermediateField.relfinrank_dvd_of_le_left (⊤ : IntermediateField K (FBase K)) hSP)
      hsimple
  have hmap := IntermediateField.relfinrank_map_map P
    (⊤ : IntermediateField K (FBase K)) (FBase K).val
  have hPmap : P.map (FBase K).val = unitLaurentField25C K :=
    (unitLaurentField25C_eq_map K).symm
  rw [hPmap, modularField_top_map_val25] at hmap
  rw [hmap]
  exact hpair

end N25.Endgame
