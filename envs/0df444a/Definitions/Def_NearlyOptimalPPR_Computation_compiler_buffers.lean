-- Buffer and update interface from Solutions.StoredNeighborBody

set_option autoImplicit false
set_option maxRecDepth 10000
open scoped ENNReal
namespace NearlyOptimalPPR.Computation
noncomputable section

def storedNeighborVertex {n : ℕ} (g : InputGraph n) (source : Fin n) (i : ℕ) : Fin n :=
  ((g.neighbors source)[i]?).getD source

def storedNeighborMemoryUpdate {n : ℕ} (g : InputGraph n) (source : Fin n)
    (logical : RecursiveState n) (ell : ℕ) (delta : ℝ) (i : ℕ) (payload : (ℤ → ℤ) × (ℤ → ℝ)) :
    (ℤ → ℤ) × (ℤ → ℝ) :=
  let v := storedNeighborVertex g source i
  (Function.update payload.1 (vertexRecordAddress (16*(ell+3)) v.val 0) ((g.neighbors v).length : ℤ),
    levelRealMemoryFold (domainResidualMemoryUpdate logical (16*(ell+3)) v delta) 0 (logical.top+1) payload.2)

end
end NearlyOptimalPPR.Computation

-- Buffer and update interface from Solutions.ActivationBoundary

