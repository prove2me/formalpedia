    · have hx2 : x 2 ∈ Icc (((A2_num + k * h2 : ℕ) : ℝ) / D_den) (((A2_num + k * h2 + h2 : ℕ) : ℝ) / D_den) := by
        simpa using hx 2
      refine ⟨le_trans (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDpos)) hx2.1,
              le_trans hx2.2 (div_le_div_of_nonneg_right (by exact_mod_cast h2_le) (le_of_lt hDpos))⟩
  have hcover1d : ∀ (A B hh : ℕ) (x : ℝ), 0 < hh → N * hh = B - A → A ≤ B →
      (A : ℝ) / D_den ≤ x → x ≤ (B : ℝ) / D_den →
      ∃ i < N, ((A + i * hh : ℕ) : ℝ) / D_den ≤ x ∧ x ≤ ((A + i * hh + hh : ℕ) : ℝ) / D_den := by
    intro A B hh x hhh hNh hAB hxlo hxhi
    by_cases htop : x = (B : ℝ) / D_den
    · refine ⟨N - 1, by omega, ?_, ?_⟩
      · rw [htop]
