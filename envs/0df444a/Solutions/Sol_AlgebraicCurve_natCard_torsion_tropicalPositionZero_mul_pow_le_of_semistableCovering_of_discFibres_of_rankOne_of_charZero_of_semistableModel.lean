        ↥(NodalData.admissible (K := ResidueField A) (Fbar := Fbar) src tgt xs xt))) :
          ↥(NodalData.admissible (K := ResidueField A) (Fbar := Fbar) src tgt xs xt)) : NodalData (ResidueField A) Fbar) =
        fun i => Finsupp.mapDomain (C i).placeMap (((ℓ ^ K : ℕ) : ℤ) • Dc c hc i) := by
      rw [AddSubgroupClass.coe_zsmul]
      funext i
      show ((ℓ ^ K : ℕ) : ℤ) • Finsupp.mapDomain (C i).placeMap (Dc c hc i) = Finsupp.mapDomain.addMonoidHom (C i).placeMap (((ℓ ^ K : ℕ) : ℤ) • Dc c hc i)
      rw [map_zsmul]; rfl
    rw [hcoe]; exact hIN
  let Φ : ↥S → T := fun c => ⟨NodalPic0.mk src tgt xs xt ⟨_, hadm (Dc c.1 c.2) (hDc c.1 c.2).1 (hDc c.1 c.2).2.1⟩,
