theorem GlobalTheory.JR.WeilQuad.NonNorm.dual_mul (A : Et F E) (ψ : AddChar F ℂ) (O : Subring A.L) (t a : A.K) :
    {y : A.L | ∀ m ∈ O, A.kerL ψ (t * a) y m = 1} =
      {y : A.L | ∀ m ∈ O, A.kerL ψ a (algebraMap A.K A.L t * y) m = 1} := by sorry
