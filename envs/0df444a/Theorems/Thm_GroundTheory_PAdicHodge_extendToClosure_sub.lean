theorem GroundTheory.PAdicHodge.extendToClosure_sub {x x' : ℂ_[p]} (hx : x ∈ closureInCp E) (hx' : x' ∈ closureInCp E) :
    extendToClosure E R (x - x') = extendToClosure E R x - extendToClosure E R x' := by sorry
