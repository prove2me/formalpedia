lemma rW_ne_rT {n n' : ℕ} : rW n ≠ rT n' := by simp [rW, rT]

/-! ## Role indices -/

lemma rc_rT {n : ℕ} (h : n < Tn) : rc (rT n) = Wn + n := by simp [rc, rT, Nat.mod_eq_of_lt h]

lemma rc_ι1 {b w : ℕ} (hb : b < NV) (hw : w < NL) : rc (ι1 b w) = f1 b w := by
  unfold ι1 f1
  simp only [NL, NV, NR] at hb hw
  split_ifs with h1 h2 h3
  · exact rc_rW (by simp only [xI, Wn, NV] at *; nlinarith)
  · have hk : w - NV < NV := by simp only [NV] at *; omega
    exact rc_rW (by simp only [yI, Wn, NN, NV] at *; nlinarith)
  · have hk : w - 2 * NV < NR := by simp only [NV, NR] at *; omega
    exact rc_rW (by simp only [a1I, Wn, NN, NV, NR] at *; nlinarith)
  · exact rc_rT (by simp only [m1I, Tn, NV, NR] at *; omega)

lemma rc_ι2 {a w : ℕ} (ha : a < NV) (hw : w < NL) : rc (ι2 a w) = f2 a w := by
  unfold ι2 f2
  simp only [NL, NV, NR] at ha hw
  split_ifs with h1 h2 h3
  · exact rc_rW (by simp only [yI, Wn, NN, NV] at *; nlinarith)
  · have hk : w - NV < NV := by simp only [NV] at *; omega
    exact rc_rW (by simp only [xI, Wn, NV] at *; nlinarith)
  · have hk : w - 2 * NV < NR := by simp only [NV, NR] at *; omega
    exact rc_rW (by simp only [a2I, Wn, NN, NV, NR] at *; nlinarith)
  · exact rc_rT (by simp only [m2I, Tn, NV, NR] at *; omega)

lemma f1_cases {b w : ℕ} (hb : b < NV) (hw : w < NL) :
    (w < NV ∧ f1 b w = w * NV + b) ∨ (NV ≤ w ∧ w < 2 * NV ∧ f1 b w = NN + (w - NV) * NV + b ∧ w - NV < NV) ∨
    (2 * NV ≤ w ∧ w < 2 * NV + NR ∧ f1 b w = 2 * NN + b * NR + (w - 2 * NV) ∧ w - 2 * NV < NR) ∨
    (2 * NV + NR ≤ w ∧ f1 b w = Wn + (24 * b + (w - (2 * NV + NR))) ∧ w - (2 * NV + NR) < 24) := by
  have e : f1 b w = if w < NV then _ else if w < 2 * NV then _ else if w < 2 * NV + NR then _ else _ := rfl
  rw [e]
  simp only [xI, yI, a1I, m1I]
  simp only [NL] at hw
  by_cases h1 : w < NV
  · left; rw [if_pos h1]; exact ⟨h1, rfl⟩
  · by_cases h2 : w < 2 * NV
    · right; left; rw [if_neg h1, if_pos h2]; refine ⟨by omega, h2, rfl, by omega⟩
    · by_cases h3 : w < 2 * NV + NR
      · right; right; left; rw [if_neg h1, if_neg h2, if_pos h3]
        refine ⟨by omega, h3, rfl, by omega⟩
      · right; right; right; rw [if_neg h1, if_neg h2, if_neg h3]
        refine ⟨by omega, rfl, by simp only [NR, NV] at *; omega⟩

lemma f2_cases {a w : ℕ} (ha : a < NV) (hw : w < NL) :
    (w < NV ∧ f2 a w = NN + a * NV + w) ∨ (NV ≤ w ∧ w < 2 * NV ∧ f2 a w = a * NV + (w - NV) ∧ w - NV < NV) ∨
    (2 * NV ≤ w ∧ w < 2 * NV + NR ∧ f2 a w = 2 * NN + NV * NR + a * NR + (w - 2 * NV) ∧ w - 2 * NV < NR) ∨
    (2 * NV + NR ≤ w ∧ f2 a w = Wn + (24 * NV + 24 * a + (w - (2 * NV + NR))) ∧ w - (2 * NV + NR) < 24) := by
  have e : f2 a w = if w < NV then _ else if w < 2 * NV then _ else if w < 2 * NV + NR then _ else _ := rfl
  rw [e]
  simp only [yI, xI, a2I, m2I]
  simp only [NL] at hw
  by_cases h1 : w < NV
  · left; rw [if_pos h1]; exact ⟨h1, rfl⟩
  · by_cases h2 : w < 2 * NV
    · right; left; rw [if_neg h1, if_pos h2]; refine ⟨by omega, h2, rfl, by omega⟩
    · by_cases h3 : w < 2 * NV + NR
      · right; right; left; rw [if_neg h1, if_neg h2, if_pos h3]
        refine ⟨by omega, h3, rfl, by omega⟩
      · right; right; right; rw [if_neg h1, if_neg h2, if_neg h3]
        refine ⟨by omega, rfl, by simp only [NR, NV] at *; omega⟩

lemma dmU {n B q r : ℕ} (hB : 0 < B) (h : n = r + B * q) (hr : r < B) : n / B = q ∧ n % B = r :=
  (Nat.div_mod_unique hB).2 ⟨h.symm, hr⟩

