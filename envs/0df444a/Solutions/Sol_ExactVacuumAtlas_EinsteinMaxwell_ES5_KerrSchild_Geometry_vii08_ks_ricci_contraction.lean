open scoped ContDiff Topology Matrix
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.NullDirections (contract2)
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geodesic
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geometry
variable {b bi : Metric 5} {v : Pt 5 → ℝ} {k : Pt 5 → Fin 5 → ℝ} {U : Set (Pt 5)}
theorem solution (hD : KSData b bi v k U) {x : Pt 5} (hx : x ∈ U) :
    contract2 (ricciOf (ksMetric b v k) (ksInverse bi v k)) x (k x) =
      contract2 (ricciOf b bi) x (k x) - v x * contract2 b x (accel b bi k x) := by
  have hR := ricci_contract_diff (Γ := christoffel (ksMetric b v k) (ksInverse bi v k))
    (Γb := christoffel b bi) (K := k) hD.isOpen hx (hD.diff_christoffel_ks hx)
    (hD.diff_christoffel_bg hx) (hD.diff_k hx) (hD.bchr_symm hx)
    (fun y hy a p q => hD.ksC_symm hy a p q) (fun y hy a => hD.ksC_kk hy a)
    (fun y hy p => by
      rw [← hD.ksC_trace hy p]
      exact Finset.sum_congr rfl fun a _ => hD.ksC_symm hy a p a)
  have hMB := hD.sum_M_covD hx
  have hMM := hD.sum_M_sq hx
  unfold ksC at hMB hMM
  unfold contract2 ricciOf
  rw [hR, hMB, hMM]
  ring
