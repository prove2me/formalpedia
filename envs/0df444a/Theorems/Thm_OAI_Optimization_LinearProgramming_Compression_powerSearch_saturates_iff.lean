theorem powerSearch_saturates_iff (fuel : ℕ) {mag : ℚ} (hm : 0 < mag) :
    (powerSearch fuel (normalizedMagnitude mag) 2).answer = none ↔
      (2 : ℝ) ^ fuel ≤ |Real.logb 2 (mag : ℝ)| := by sorry
