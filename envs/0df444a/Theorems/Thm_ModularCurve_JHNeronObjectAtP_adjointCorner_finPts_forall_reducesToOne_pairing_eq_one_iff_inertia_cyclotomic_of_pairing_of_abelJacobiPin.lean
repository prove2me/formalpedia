theorem ModularCurve.JHNeronObjectAtP.adjointCorner_finPts_forall_reducesToOne_pairing_eq_one_iff_inertia_cyclotomic_of_pairing_of_abelJacobiPin
    (p : ℕ) [Fact p.Prime] (hp2 : p ≠ 2) (M : ℕ) [NeZero M] (hpM : p ∣ M) (hpM2 : ¬ p ^ 2 ∣ M)
