-- Source module: Solutions.KFLXor
/-!
# KFL §8: the last selected bit (two-bit XOR)

`xorStep`: table `b(c₀) = bit j of c₀` (`j = ρ + (f-1)K`, `xorGen`), then `rotF` on the view
`[N0·Q·N1·E, 2, D·S1]` (`D = 2^j`, `Q = 2 D E`): the bit `j` of the `y` chunk is flipped iff bit
`j` of `x` is set.  `xorStep_geo`: the result is `rixT g (XLc K ρ f)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFL

open IntMul RS KIL KFD Butterfly AModel

/-- `((p / d) % Q / 2^j) % 2` for `p = N - 1`. -/
def bE (d Q j : ℕ) : Ex HS := .nmod (uE d Q j) (.lit 2)

/-- One table entry. -/
def xorBody (d Q j : ℕ) : RS :=
  .seq (.push 14 (bE d Q j)) (.asg NLogN.KFL.rP (.add (.reg NLogN.KFL.rP) (.lit (-1))))

/-- The bit table: `bit_j ((p / d) % Q)` for `p = P-1, …, 0`. -/
def xorGen (d Q j P : ℕ) : RS :=
  .seq (.push NLogN.KFL.rP (.lit (P : ℤ))) (.seq (.rep NLogN.KFL.rq (.lit (P : ℤ)) (xorBody d Q j)) (.pop NLogN.KFL.rP))

/-- Table entries. -/
def xorA (d Q j : ℕ) (p : ℕ) : ℕ := p / d % Q / 2 ^ j % 2

def cXorGen (P Bb : ℕ) : ℕ := cLp P (20 * 10 ^ 7 * (Bb + 2) ^ 2) Bb + 3 * 10 ^ 7 * (Bb + 2) ^ 2

section
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- **The last-bit step**: bit table, then `rotF` on `[P', 2, B']`. -/
def xorStep (d Q j P B : ℕ) : IStmt HS Pp :=
  KFD.withPushI (rotL P 2 B) (.seq (fcode (xorGen d Q j P)) KFC.rotF)

def cXor (P B w Bb : ℕ) : ℕ := cXorGen P Bb + KFC.cRotF P 2 B w + 10 ^ 8 * (Bb + 2) ^ 2

end

/-! ## The pipeline on the canonical layout -/

/-- The correction map: position `c` receives the record at `S0c (T0c c)`. -/
def corrc (K ρ f : ℕ) (c : Tr) : Tr := S0c K ρ f (T0c K ρ f c)
end NLogN.KFL
end

