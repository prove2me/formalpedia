theorem ord_nonneg_of_mem'' {K F : Type*} [Field K] [Field F] [Algebra K F] (v : Place K F) {f : F}
    (hf : f ∈ v.toValuationSubring) : 0 ≤ v.ord f := by
  rcases eq_or_ne f 0 with rfl | hf0
  · simp
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible v.toValuationSubring
  obtain ⟨n, u, hu⟩ :=
    IsDiscreteValuationRing.eq_unit_mul_pow_irreducible
      (x := (⟨f, hf⟩ : v.toValuationSubring)) (by simpa [Subtype.ext_iff] using hf0) hπ
  have hcoe : f = ((u : v.toValuationSubring) : F) * ((π : F) ^ (n : ℤ)) := by
    have h := congrArg (Subtype.val) hu
    push_cast at h
    rw [zpow_natCast]
    exact h
  rw [hcoe, v.ord_unit_smul_zpow u hπ (n : ℤ)]
  exact Int.natCast_nonneg n

theorem isAlgebraic_of_ringHom_curve {κ F₀ F : Type*} [Field κ] [PerfectField κ] [Field F₀] [Field F] [Algebra κ F₀] [Algebra κ F]
    [IsCurveOver κ F₀] [Algebra.EssFiniteType κ F₀] [IsCurveOver κ F] [Algebra.EssFiniteType κ F]
    [Algebra F₀ F] [IsScalarTower κ F₀ F] : Algebra.IsAlgebraic F₀ F := by
  obtain ⟨t0, ht0, -, -⟩ := AlgebraicCurve.IsCurveOver.exists_separating_transcendental (K := κ) (F := F₀)
  have hinj : Function.Injective (algebraMap F₀ F) := (algebraMap F₀ F).injective
  have ht : Transcendental κ (algebraMap F₀ F t0) := (transcendental_algebraMap_iff hinj).mpr ht0
  obtain ⟨t, ht', hfin, -⟩ := AlgebraicCurve.IsCurveOver.exists_separating_transcendental (K := κ) (F := F)
  haveI := hfin
  haveI : Algebra.IsAlgebraic ↥κ⟮t⟯ F := Algebra.IsAlgebraic.of_finite _ _
  have hA1 : Algebra.IsAlgebraic ↥κ⟮algebraMap F₀ F t0⟯ F := AlgebraicCurve.isAlgebraic_adjoin_of_transcendental t ht
  haveI hIST : IsScalarTower ↥κ⟮t0⟯ F₀ F := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hmem : ∀ y : ↥κ⟮t0⟯, algebraMap F₀ F (y : F₀) ∈ κ⟮algebraMap F₀ F t0⟯ := by
    intro y
    obtain ⟨r, s, hy⟩ := (IntermediateField.mem_adjoin_simple_iff κ _).mp y.2
    rw [hy, map_div₀]
    have e1 : ∀ p : Polynomial κ, algebraMap F₀ F (Polynomial.aeval t0 p) = Polynomial.aeval (algebraMap F₀ F t0) p :=
      fun p => by rw [← Polynomial.aeval_algebraMap_apply]
    rw [e1, e1]
    exact (IntermediateField.mem_adjoin_simple_iff κ _).mpr ⟨r, s, rfl⟩
  let f : ↥κ⟮t0⟯ →+* ↥κ⟮algebraMap F₀ F t0⟯ :=
    ((algebraMap F₀ F).comp (algebraMap ↥κ⟮t0⟯ F₀)).codRestrict (κ⟮algebraMap F₀ F t0⟯) hmem
  have hfsurj : Function.Surjective f := by
    rintro ⟨z, hz⟩
    obtain ⟨r, s, hz'⟩ := (IntermediateField.mem_adjoin_simple_iff κ _).mp hz
    refine ⟨⟨Polynomial.aeval t0 r / Polynomial.aeval t0 s,
      (IntermediateField.mem_adjoin_simple_iff κ _).mpr ⟨r, s, rfl⟩⟩, Subtype.ext ?_⟩
    show algebraMap F₀ F (Polynomial.aeval t0 r / Polynomial.aeval t0 s) = z
    rw [hz', map_div₀, ← Polynomial.aeval_algebraMap_apply, ← Polynomial.aeval_algebraMap_apply]
  refine ⟨fun x => ?_⟩
  have hx := hA1.isAlgebraic x
  have hxR : IsAlgebraic ↥κ⟮t0⟯ x :=
    IsAlgebraic.of_ringHom_of_comp_eq (A := F) f (RingHom.id F) (a := x) hx hfsurj (fun a b h => h) (by ext y; rfl)
  exact IsAlgebraic.extendScalars (S := F₀) (A := F) (algebraMap ↥κ⟮t0⟯ F₀).injective hxR

