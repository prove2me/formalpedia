section Call

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

lemma regs_chN_mem (m : ℕ) (ρ : ℕ × ℕ × ℕ) :
    ∀ p ∈ chN m ρ, ∀ r ∈ p.2.regs, r = gF ∨ r = rLp ∨ r = gA ∨ r = sQQ ∨ r = rVB ∨ r = rVC := by
  intro p hp r hr
  simp only [chN, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl <;>
    simp only [NE.regs, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hr
  · rcases hr with h | h
    · simp at h
    · exact Or.inl h
  · exact Or.inr (Or.inl hr)
  · rcases hr with h | h
    · exact Or.inr (Or.inr (Or.inl h))
    · have := npow_regs _ _ r h; simp [NE.regs] at this; tauto
  · rcases hr with h | h | h
    · have := npow_regs _ _ r h; simp [NE.regs] at this; tauto
    · tauto
    · have := npow_regs _ _ r h; simp [NE.regs] at this; tauto
  · rcases hr with h | h
    · have := npow_regs _ _ r h; simp [NE.regs] at this; tauto
    · tauto

/-- **The call wrapper of a run.** The registers `gF, rLp, gA, sQQ, rVB, rVC, dP` hold
`f, L', vol A, N, vol B, vol Cs, P`; if procedure `j0` maps every state with the child descriptor
to the child's array, then `callR` does so on the level's state. -/
theorem callR_runs_sol_aux (j0 : Fin Pp) (m : ℕ) (ρ : ℕ × ℕ × ℕ) (hρ : ρ.1 + ρ.2.2 ≤ m)
    (hρ' : ρ.2.1 + ρ.2.2 ≤ m) {f N P L' a b c : ℕ}
    (ch : List (ZMod 2) → List (ZMod 2)) (c0 V : ℕ)
    (hrec : ∀ (t' : IState HS) (R' : List Item) (ys : List (ZMod 2)),
      DescG t' (ρ.2.2 * f) P L' (a * N ^ ρ.1) (N ^ (m - ρ.1 - ρ.2.2) * (b * N ^ ρ.2.1))
        (N ^ (m - ρ.2.1 - ρ.2.2) * c) →
      ys.length = V →
      IRuns I iprog (iprog j0) (t'.upd 0 (ints (enc2 ys) ++ R'))
        (t'.upd 0 (ints (enc2 (ch ys)) ++ R')) c0)
    {M Bb : ℕ} (hM : zsz (M : ℤ) ≤ Bb) (hM1 : 1 ≤ M) (hN : 1 ≤ N) (hNM : N ≤ M) (hfM : f ≤ M)
    (hbA : a * N ^ ρ.1 ≤ M) (hbB : N ^ (m - ρ.1 - ρ.2.2) * (b * N ^ ρ.2.1) ≤ M)
    (hbC : N ^ (m - ρ.2.1 - ρ.2.2) * c ≤ M) (hbE : ρ.2.2 * f ≤ M) (hbL : L' ≤ M)
    (ha1 : 1 ≤ a) (hb1 : 1 ≤ b) (hc1 : 1 ≤ c) (hrM : ρ.2.2 ≤ M)
    (t : IState HS) {L1 L2 L3 L4 L5 L6 L7 : List Item}
    (hF : t.G gF = .int (f : ℤ) :: L1) (hLp : t.G rLp = .int (L' : ℤ) :: L2)
    (hA : t.G gA = .int (a : ℤ) :: L3) (hQQ : t.G sQQ = .int (N : ℤ) :: L4)
    (hB : t.G rVB = .int (b : ℤ) :: L5) (hC : t.G rVC = .int (c : ℤ) :: L6)
    (hP : t.G dP = .int (P : ℤ) :: L7)
    (R : List Item) (ys : List (ZMod 2)) (hys : ys.length = V) :
    IRuns I iprog (callR j0 m ρ) (t.upd 0 (ints (enc2 ys) ++ R))
      (t.upd 0 (ints (enc2 (ch ys)) ++ R)) (cCallR m ρ Bb c0) := by
  obtain ⟨i, j, r⟩ := ρ
  simp only at hρ hρ' hrec hbA hbB hbC hbE hrM ⊢
  set t0 := t.upd 0 (ints (enc2 ys) ++ R) with ht0
  have g : ∀ r : Fin HS, r ≠ 0 → t0.G r = t.G r := fun r hr => by simp [t0, hr]
  -- the valuation of the read registers
  set v : Fin HS → ℕ := fun x => if x = gF then f else if x = rLp then L' else if x = gA then a
    else if x = sQQ then N else if x = rVB then b else if x = rVC then c else 0 with hv
  have hold : ∀ x : Fin HS, (x = gF ∨ x = rLp ∨ x = gA ∨ x = sQQ ∨ x = rVB ∨ x = rVC) →
      ∃ L, t0.G x = .int (v x : ℤ) :: L := by
    intro x hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨L1, by rw [g _ (by decide), hF]; simp +decide [hv]⟩
    · exact ⟨L2, by rw [g _ (by decide), hLp]; simp +decide [hv]⟩
    · exact ⟨L3, by rw [g _ (by decide), hA]; simp +decide [hv]⟩
    · exact ⟨L4, by rw [g _ (by decide), hQQ]; simp +decide [hv]⟩
    · exact ⟨L5, by rw [g _ (by decide), hB]; simp +decide [hv]⟩
    · exact ⟨L6, by rw [g _ (by decide), hC]; simp +decide [hv]⟩
  have vF : v gF = f := by simp +decide [hv]
  have vL : v rLp = L' := by simp +decide [hv]
  have vA : v gA = a := by simp +decide [hv]
  have vQ : v sQQ = N := by simp +decide [hv]
  have vB : v rVB = b := by simp +decide [hv]
  have vC : v rVC = c := by simp +decide [hv]
  have hN1 : ∀ k, 1 ≤ N ^ k := fun k => Nat.one_le_pow _ _ hN
  have hNi : N ^ i ≤ M := le_trans (Nat.le_mul_of_pos_left _ ha1) hbA
  have haM : a ≤ M := le_trans (Nat.le_mul_of_pos_right _ (hN1 i)) hbA
  have hNj : N ^ j ≤ M := le_trans (le_trans (Nat.le_mul_of_pos_left _ hb1)
    (Nat.le_mul_of_pos_left _ (hN1 _))) hbB
  have hbN : b * N ^ j ≤ M := le_trans (Nat.le_mul_of_pos_left _ (hN1 _)) hbB
  have hbM : b ≤ M := le_trans (Nat.le_mul_of_pos_right _ (hN1 j)) hbN
  have hNk : N ^ (m - i - r) ≤ M := le_trans (Nat.le_mul_of_pos_right _ (Nat.mul_pos hb1 (hN1 j))) hbB
  have hNl : N ^ (m - j - r) ≤ M := le_trans (Nat.le_mul_of_pos_right _ hc1) hbC
  have hcM : c ≤ M := le_trans (Nat.le_mul_of_pos_left _ (hN1 _)) hbC
  have hQ : (NE.reg sQQ).OK v M := by show v sQQ ≤ M; rw [vQ]; exact hNM
  have hnp : ∀ k, N ^ k ≤ M → (npow (.reg sQQ) k).OK v M := fun k hk =>
    npow_OK hQ (by show 1 ≤ v sQQ; rw [vQ]; exact hN) hM1 k (by show v sQQ ^ k ≤ M; rw [vQ]; exact hk)
  have hok : ∀ p ∈ chN m (i, j, r), p.1.val < 56 ∧ p.2.RegsLt ∧
      (∀ x ∈ p.2.regs, x ∉ (chN m (i, j, r)).map Prod.fst) ∧ NE.Holds t0 v p.2 ∧ p.2.OK v M := by
    intro p hp
    have hreg := regs_chN_mem m (i, j, r) p hp
    refine ⟨?_, fun x hx => ?_, fun x hx hm => ?_, fun x hx => hold x (hreg x hx), ?_⟩
    · simp only [chN, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl | rfl | rfl <;> (dsimp only; decide)
    · rcases hreg x hx with rfl | rfl | rfl | rfl | rfl | rfl <;> decide
    · simp only [chN, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil,
        or_false] at hm
      rcases hreg x hx with rfl | rfl | rfl | rfl | rfl | rfl <;>
        rcases hm with h | h | h | h | h <;> exact absurd h (by decide)
    · simp only [chN, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl | rfl | rfl
      · exact ⟨hrM, by show v gF ≤ M; rw [vF]; exact hfM, by simp only [NE.val, vF]; exact hbE⟩
      · show v rLp ≤ M; rw [vL]; exact hbL
      · exact ⟨by show v gA ≤ M; rw [vA]; exact haM, hnp i hNi,
          by simp only [NE.val, npow_val, vA, vQ]; exact hbA⟩
      · exact ⟨hnp _ hNk, ⟨by show v rVB ≤ M; rw [vB]; exact hbM, hnp j hNj,
          by simp only [NE.val, npow_val, vB, vQ]; exact hbN⟩,
          by simp only [NE.val, npow_val, vB, vQ]; exact hbB⟩
      · exact ⟨hnp _ hNl, by show v rVC ≤ M; rw [vC]; exact hcM,
          by simp only [NE.val, npow_val, vC, vQ]; exact hbC⟩
  obtain ⟨hPO1, hev1⟩ := pushOK_NE (t := t0) hM (chN m (i, j, r)) hok
  have hB1 : 1 ≤ Bb := le_trans (by simpa [zsz_one] using zsz_natCast_le' hM1) hM
  have hPO : PushOK t0 Bb (chR m (i, j, r)) := by
    intro p hp
    simp only [chR, List.mem_cons] at hp
    rcases hp with rfl | hp
    · refine ⟨by decide, clean_lit _, by simp [Ex.regs], trivial, ?_⟩
      simp only [Ex.Bnd, zsz_neg_one]; exact hB1
    · obtain ⟨a1, a2, a3, a4, a5⟩ := hPO1 p hp
      refine ⟨a1, a2, fun x hx hm => ?_, a4, a5⟩
      simp only [chR, List.map_cons, List.mem_cons] at hm
      rcases hm with hm | hm
      · simp only [List.mem_map] at hp
        obtain ⟨p', hp', rfl⟩ := hp
        rw [NE.regs_toEx] at hx
        rcases regs_chN_mem m (i, j, r) p' hp' x hx with h | h | h | h | h | h <;>
          (rw [h] at hm; exact absurd hm (by decide))
      · exact a3 x hx hm
  have S1 := Sp.pushes Bb (chR m (i, j, r)) t0 hPO
  set evl : List (Fin HS × ℤ) := [(dJ, -1), (dT, ((r * f : ℕ) : ℤ)), (dL, (L' : ℤ)),
    (dA, ((a * N ^ i : ℕ) : ℤ)), (dB, ((N ^ (m - i - r) * (b * N ^ j) : ℕ) : ℤ)),
    (dC, ((N ^ (m - j - r) * c : ℕ) : ℤ))] with hevl
  have hev : (chR m (i, j, r)).map (fun p => (p.1, p.2.eval t0)) = evl := by
    have h2 : ((chN m (i, j, r)).map fun p => (p.1, p.2.toEx)).map (fun p => (p.1, p.2.eval t0)) =
        (chN m (i, j, r)).map fun p => (p.1, ((p.2.val v : ℕ) : ℤ)) := hev1
    simp only [chR, List.map_cons, h2]
    simp [chN, evl, NE.val, npow_val, vF, vL, vA, vB, vC, vQ, Ex.eval]
  rw [hev] at S1
  set t1 := pushSt t0 evl with ht1
  have h0n : (0 : Fin HS) ∉ evl.map Prod.fst := by simp +decide [evl]
  have hD : DescG t1 (r * f) P L' (a * N ^ i) (N ^ (m - i - r) * (b * N ^ j))
