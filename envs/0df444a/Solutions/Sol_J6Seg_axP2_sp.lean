-- Source module: Solutions.J6SegILSweep2
/-!
# B-line IL, B6 §2: reading the line descriptor

`hdrA σ dS` (on `dS = descLine6 = p :: α :: h :: d :: (bits ++ svals)`): pop `p, α, h, d` into
`σ 0..3`, move the `d` bits onto `σ 12` while counting the ones in `σ 4`, move them on to `σ 13`
(in order), then `σ 5 := T = 2^{h d + #ones}`, `σ 6 := 1` (`pre`), `σ 8 := 0` (`k`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

theorem zsz_le_one {b : ℤ} (h : b = 0 ∨ b = 1) {B : ℕ} (hB : 1 ≤ B) : zsz b ≤ B := by
  rcases h with rfl | rfl
  · simp [zsz_zero]
  · exact le_trans (by simpa using zsz_natCast_le_self 1) hB

end J6Seg

end

