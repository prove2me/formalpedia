    (dF : FinWhittakerDatum K S Pi) (z : (AdeleRing (𝓞 K) K)ˣ) (x : AdelicGL2 (𝓞 K) K) :
    dF.Wf (centralScalar (𝓞 K) K z * x) = ((ω (z / NumberField.Idele.partAt K S z) : ℂˣ) : ℂ) * dF.Wf x := by
