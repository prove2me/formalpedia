/-! ## The checker -/

theorem allL_spec_sol_aux {α : Type} {p : α → Bool} : ∀ {l : List α}, allL p l = true → ∀ a ∈ l, p a = true
  | [], _, a, ha => by simp at ha
  | b :: l, h, a, ha => by
    have h' : p b = true ∧ allL p l = true := by
      simpa [allL] using h
    rcases List.mem_cons.1 ha with rfl | ha
    · exact h'.1
    · exact allL_spec_sol_aux h'.2 a ha

