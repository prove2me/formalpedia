  obtain ⟨hVQ, hVc⟩ := mem_powersetCard.1 hV
  rw [IsBox, BV_starLevels hπ, BV_P0Levels hπ, add_comm,
    card_sdiff_add_card_eq_card (FV_subset _ _)]
  refine ⟨hVc.le, fun ℓ hℓ ℓ' hℓ' => ?_⟩
