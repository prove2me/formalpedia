section
-- Source module: Solutions.J6SegSideCost1
/-!
# Side costs 1: the size of the near-boundary list `LJ`

* `bad_count`: `#{l < m : ¬ stepOK l} + m ≤ rrZ m` (`0 < s ≤ t`), hence at most `t - s + 1` bad
  steps below `s - 1`;
* `cuts_card`: `#{c < s : cutP c} ≤ s/λ + (t - s + 1) + 1`;
* **`LJ_len_le`**: `|LJ s t λ w| ≤ 2w (s/λ + (t - s) + 4)` (every near-boundary position is within
  `w` of a cut or of `s`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.Side
open J6Seg J6Seg.Src

variable {s t lam : ℕ}

theorem rrZ_zero (hs : 0 < s) : rrZ s t 0 = 0 := by
  unfold rrZ; simp only [mul_zero, zero_add]
  exact Int.ediv_eq_zero_of_lt (by omega) (by omega)

theorem rrZ_succ_ge (hs : 0 < s) (hst : s ≤ t) (m : ℕ) :
    rrZ s t ((m : ℤ) + 1) ≥ rrZ s t m + 1 := by
  unfold rrZ
  have h2s : (0 : ℤ) < 2 * s := by omega
  have e : (2 * (t : ℤ) * m + s + 1 * (2 * s)) / (2 * s) = (2 * (t : ℤ) * m + s) / (2 * s) + 1 :=
    Int.add_mul_ediv_right _ _ (by omega)
  rw [← e]
  apply Int.ediv_le_ediv h2s
  have : (s : ℤ) ≤ t := by exact_mod_cast hst
  nlinarith

theorem rrZ_le (hs : 0 < s) (hst : s ≤ t) : rrZ s t ((s - 1 : ℕ) : ℤ) ≤ t := by
  unfold rrZ
  apply Int.le_of_lt_add_one
  apply Int.ediv_lt_of_lt_mul (by omega)
  have h1 : (((s - 1 : ℕ) : ℤ)) = (s : ℤ) - 1 := by push_cast [Nat.cast_sub (by omega : 1 ≤ s)]; ring
  rw [h1]
  have : (s : ℤ) ≤ t := by exact_mod_cast hst
  nlinarith

/-- **Bad steps**: `#{l < m : ¬ stepOK l} + m ≤ rrZ m`. -/
theorem bad_count (hs : 0 < s) (hst : s ≤ t) (m : ℕ) :
    ((((range m).filter (fun l => ¬ stepOK s t l)).card + m : ℕ) : ℤ) ≤ rrZ s t m := by
  induction m with
  | zero => simp [rrZ_zero hs]
  | succ m ih =>
    rw [range_add_one, filter_insert]
    have hge := rrZ_succ_ge (t := t) hs hst m
    by_cases h : stepOK s t m
    · rw [if_neg (by simpa using h)]
      have e := (stepOK_iff hs m).1 h
      push_cast at ih e ⊢
      linarith
    · rw [if_pos h, card_insert_of_notMem (by simp)]
      have hne : rrZ s t ((m : ℤ) + 1) ≠ rrZ s t m + 1 := fun e => h ((stepOK_iff hs m).2 e)
      push_cast at ih hne hge ⊢
      omega

theorem bad_le (hs : 0 < s) (hst : s ≤ t) :
    ((range (s - 1)).filter (fun l => ¬ stepOK s t l)).card ≤ t - s + 1 := by
  have h1 := bad_count (t := t) hs hst (s - 1)
  have h2 := rrZ_le (t := t) hs hst
  have : ((((range (s - 1)).filter (fun l => ¬ stepOK s t l)).card + (s - 1) : ℕ) : ℤ) ≤ t :=
    h1.trans h2
  omega

theorem mult_card (hl : 1 ≤ lam) : ((range s).filter (fun c => c % lam = 0)).card ≤ s / lam + 1 := by
  have : ((range s).filter (fun c => c % lam = 0)).card ≤ (range (s / lam + 1)).card := by
    apply card_le_card_of_injOn (fun c => c / lam)
    · intro c hc
      simp only [coe_filter, mem_range, Set.mem_ofPred_eq] at hc
      simp only [coe_range, Set.mem_Iio]
      exact Nat.lt_succ_of_le (Nat.div_le_div_right hc.1.le)
    · intro a ha b hb hab
      simp only [coe_filter, mem_range, Set.mem_ofPred_eq] at ha hb
      have h1 := Nat.div_add_mod a lam
      have h2 := Nat.div_add_mod b lam
      simp only at hab
      rw [ha.2] at h1; rw [hb.2] at h2
      rw [← h1, ← h2, hab]
  simpa using this

/-- **Cuts below `s`.** -/
theorem cuts_card (hs : 0 < s) (hst : s ≤ t) (hl : 1 ≤ lam) :
    ((range s).filter (fun c => cutP s t lam c)).card ≤ s / lam + (t - s + 1) + 1 := by
  have hsub : (range s).filter (fun c => cutP s t lam c) ⊆
      ((range s).filter (fun c => c % lam = 0)) ∪
        (((range (s - 1)).filter (fun l => ¬ stepOK s t l)).image (· + 1)) := by
    intro c hc
    simp only [mem_filter, mem_range] at hc
    obtain ⟨hcs, hcut⟩ := hc
    simp only [mem_union, mem_filter, mem_range, mem_image]
    rcases hcut with h | h | h
    · exact Or.inl ⟨hcs, by subst h; simp⟩
    · exact Or.inl ⟨hcs, h⟩
    · by_cases h0 : c = 0
      · exact Or.inl ⟨hcs, by subst h0; simp⟩
      · exact Or.inr ⟨c - 1, ⟨by omega, h⟩, by omega⟩
  calc _ ≤ _ := card_le_card hsub
    _ ≤ _ := card_union_le _ _
    _ ≤ _ := by
        have := mult_card (s := s) hl
        have := card_image_le (s := (range (s - 1)).filter (fun l => ¬ stepOK s t l)) (f := (· + 1))
        have := bad_le (t := t) hs hst
        omega

/-- The end of a block is a cut or `s`. -/
theorem eB_cut_or (hs : 0 < s) {j : ℕ} (hj : j < s) :
    cutP s t lam (eB s t lam j) ∨ eB s t lam j = s := by
  have h := Nat.find_spec (enF_ex s t lam (stF s t lam j))
  have hle := eB_le (t := t) (lam := lam) hj
  unfold eB
  rcases h with h | h
  · left; unfold enF; rwa [Nat.add_assoc] at h
  · right; unfold eB at hle; unfold enF at hle ⊢; omega

/-- **The near-boundary list is short.** -/
theorem LJ_len_le (hs : 0 < s) (hst : s ≤ t) (hl : 1 ≤ lam) (w : ℕ) :
    (LJ s t lam w).length ≤ 2 * w * (s / lam + (t - s) + 4) := by
  set Cs := ((range s).filter (fun c => cutP s t lam c)) ∪ {s} with hCs
  have hsub : (LJ s t lam w).toFinset ⊆ Cs.biUnion (fun c => Ico (c - w) (c + w)) := by
    intro j hj
    rw [List.mem_toFinset] at hj
    unfold LJ Jlist at hj
    rw [List.mem_filter, List.mem_range] at hj
    obtain ⟨hjs, hn⟩ := hj
    have hjs' : j < s := hjs
    rw [nearB_eq, decide_eq_true_eq] at hn
    simp only [mem_biUnion, mem_Ico, hCs, mem_union, mem_filter, mem_range, mem_singleton]
    have hst' := stF_le (s := s) (t := t) (lam := lam) j
    rcases hn with h | h
    · exact ⟨stF s t lam j, Or.inl ⟨by omega, stF_cut j⟩, by omega, by omega⟩
    · have hlt := lt_eB (t := t) (lam := lam) hs hjs'
      have hle := eB_le (t := t) (lam := lam) hjs'
      rcases eB_cut_or (t := t) (lam := lam) hs hjs' with hc | hc
      · by_cases he : eB s t lam j = s
        · exact ⟨s, Or.inr rfl, by omega, by omega⟩
        · exact ⟨eB s t lam j, Or.inl ⟨by omega, hc⟩, by omega, by omega⟩
      · exact ⟨s, Or.inr rfl, by omega, by omega⟩
  have hcard := card_le_card hsub
  rw [List.toFinset_card_of_nodup (LJ_nodup s t lam w)] at hcard
  have h2 : (Cs.biUnion (fun c => Ico (c - w) (c + w))).card ≤ Cs.card * (2 * w) := by
    refine (card_biUnion_le).trans ?_
    calc ∑ c ∈ Cs, (Ico (c - w) (c + w)).card ≤ ∑ c ∈ Cs, 2 * w := by
          apply sum_le_sum; intro c _; simp; omega
      _ = Cs.card * (2 * w) := by rw [sum_const, smul_eq_mul]
  have h3 : Cs.card ≤ s / lam + (t - s) + 4 := by
    rw [hCs]
    have := cuts_card (t := t) hs hst hl
    have := card_union_le ((range s).filter (fun c => cutP s t lam c)) {s}
    simp only [card_singleton] at this
    omega
  calc (LJ s t lam w).length ≤ Cs.card * (2 * w) := hcard.trans h2
    _ ≤ (s / lam + (t - s) + 4) * (2 * w) := Nat.mul_le_mul_right _ h3
    _ = _ := by ring

end J6Seg.Side

end

section
-- Source module: Solutions.J6SegSideCost2
/-!
# Side costs 2: the sizes of one round-six axis

`AxNum P n src D k`: the natural-number facts the side costs need, on axis `k`
(`T = TP6`, `p = pP6`, `β = log₂ lg n`):
`pre · t · post = T`, `pre, post ≥ 1`, `p ≤ T`, `size (2T) ≤ p`, `Q ≤ 3p`, `log₂ λ ≤ 2β + 2`,
`pre · nc · λ · post ≤ T`, **`d · (pre · G · post) ≤ 99 T`**, `log₂ G ≤ ℓ ≤ p`, `G ≤ 3t`,
`d ≤ T`, `lg n < 2^(β+1)`.
`axNum_ev`: all of them for large `n`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

/-- `|LJ|` on a round-six axis: `d |LJ| ≤ 49 t`. -/
theorem dLJ_le {d s t : ℕ} (hd : 1 ≤ d) (hs : 0 < s) (hst : s ≤ t) (h8 : 8 * d ^ 2 ≤ t)
    (hts : 8 * d ^ 2 * (t - s) ≤ 2 * t) :
    d * (LJ s t (lamP d) (wF d)).length ≤ 49 * t := by
  have hl : 1 ≤ lamP d := Nat.one_le_two_pow
  have hL := LJ_len_le (t := t) (lam := lamP d) hs hst hl (wF d)
  have hk : kF d ≤ 2 * d := by unfold kF; have := Nat.sqrt_le_self d; omega
  have hlam : lamF d < 2 * lamP d := by
    have := Nat.lt_pow_succ_log_self (b := 2) (by norm_num) (lamF d)
    unfold lamP; rw [pow_succ] at this; omega
  have hw : wF d = 7 * kF d := rfl
  have hlF : lamF d = d * kF d := rfl
  -- the three parts
  have a1 : d * (2 * wF d * (s / lamP d)) ≤ 28 * s := by
    have e : d * (2 * wF d * (s / lamP d)) = 14 * lamF d * (s / lamP d) := by rw [hw, hlF]; ring
    rw [e]
    have h1 : lamF d * (s / lamP d) ≤ 2 * (lamP d * (s / lamP d)) := by
      have := Nat.mul_le_mul_right (s / lamP d) hlam.le; nlinarith
    have h2 : lamP d * (s / lamP d) ≤ s := Nat.mul_div_le s (lamP d)
    nlinarith
  have a2 : d * (2 * wF d * (t - s)) ≤ 7 * t := by
    have e : d * (2 * wF d * (t - s)) = 14 * (d * kF d) * (t - s) := by rw [hw]; ring
    rw [e]
    have h1 : d * kF d ≤ 2 * d ^ 2 := by nlinarith
    have h2 : 14 * (d * kF d) * (t - s) ≤ 14 * (2 * d ^ 2) * (t - s) :=
      Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ h1)
    nlinarith
  have a3 : d * (2 * wF d * 4) ≤ 14 * t := by
    have e : d * (2 * wF d * 4) = 56 * (d * kF d) := by rw [hw]; ring
    rw [e]; nlinarith
  calc d * (LJ s t (lamP d) (wF d)).length ≤ d * (2 * wF d * (s / lamP d + (t - s) + 4)) :=
        Nat.mul_le_mul_left _ hL
    _ = d * (2 * wF d * (s / lamP d)) + d * (2 * wF d * (t - s)) + d * (2 * wF d * 4) := by ring
    _ ≤ 28 * s + 7 * t + 14 * t := by omega
    _ ≤ 49 * t := by omega

/-! ## Pure helpers -/

theorem segPF_le3 {p d s : ℕ} (hp : 2 ≤ p) (h : NF d s < 2 ^ p) : segPF p d s ≤ 3 * p := by
  have hsz : Nat.size (NF d s) ≤ p := Nat.size_le.2 h
  unfold segPF; omega

theorem log_lamF_le {d b : ℕ} (hd1 : 1 ≤ d) (hdb : d ≤ b) :
    Nat.log 2 (lamF d) ≤ 2 * Nat.log 2 b + 2 := by
  have hb1 : 1 ≤ b := le_trans hd1 hdb
  generalize hβ : Nat.log 2 b = β
  have h1 : b < 2 ^ (β + 1) := hβ ▸ Nat.lt_pow_succ_log_self (by norm_num) b
  have hk : kF d ≤ 2 * b := by unfold kF; have := Nat.sqrt_le_self d; omega
  have h2 : lamF d ≤ b * (2 * b) := Nat.mul_le_mul hdb hk
  generalize hX : 2 ^ (β + 1) = X at h1
  have e : 2 ^ (2 * β + 3) = 2 * X * X := by rw [← hX]; ring
  have h3 : b * (2 * b) < 2 * X * X := by nlinarith
  have hlb : lamF d < 2 ^ (2 * β + 3) := by omega
  have hl0 : lamF d ≠ 0 := by
    unfold lamF kF; positivity
  have := Nat.log_lt_of_lt_pow hl0 hlb
  omega

theorem dG_le {d t m G : ℕ} (hLJ : d * m ≤ 49 * t) (hG : G ≤ 2 * m + 1) (h8 : 8 * d ^ 2 ≤ t)
    (hd1 : 1 ≤ d) : d * G ≤ 99 * t := by
  have h1 : d * G ≤ d * (2 * m + 1) := Nat.mul_le_mul_left d hG
  have hdt : d ≤ t := by nlinarith
  nlinarith

theorem p_le_T {b T : ℕ} (hb : 64 ≤ b) (hb6 : b ^ 6 ≤ T) : 6 * b ≤ T := by
  have e : b ^ 6 = b * b ^ 5 := by ring
  have : 6 ≤ b ^ 5 := le_trans (by omega) (Nat.le_self_pow (by norm_num) _)
  nlinarith

theorem window {t s d : ℕ} (hlo : t - 2 * (t / (8 * d ^ 2)) < s) (hhi : s ≤ t - t / (8 * d ^ 2))
    (hd1 : 1 ≤ d) : 8 * d ^ 2 ≤ t ∧ 8 * d ^ 2 * (t - s) ≤ 2 * t := by
  generalize hW : t / (8 * d ^ 2) = W at hlo hhi
  have hw1 : 1 ≤ W := by omega
  have h2 : 8 * d ^ 2 * W ≤ t := hW ▸ Nat.mul_div_le t _
  have h1 : t - s ≤ 2 * W := by omega
  constructor
  · nlinarith
  · nlinarith

/-- **The axis facts, eventually.** -/
theorem axNum_ev_sol_aux (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D, AxNum P n src D k := by
  obtain ⟨n₁, hQ⟩ := qok_of P hP
  obtain ⟨n₂, hN⟩ := r6_axis_nat P hP
  refine ⟨max n₁ n₂, fun n hn src hsrc D hD k hk => ?_⟩
  have hq := hQ n (le_of_max_le_left hn) src hsrc
  obtain ⟨hs0, hst, -, -, -, -, -, -, -, hd1⟩ :=
    hN n (le_of_max_le_right hn) src hsrc k (by omega)
  clear hQ hN
  have hb64 : 64 ≤ b'P6 P n := hq.hb
  have hLb : LP6 P n + 2 ≤ b'P6 P n := hq.hLb
  have hdb : dP6 P n + 4 ≤ b'P6 P n := hq.hdb
  have hb6 : b'P6 P n ^ 6 ≤ TP6 P n := hq.hb6
  have hl2 : 2 ≤ ℓP6 P n := hq.hℓ2
  have hpe : pP6 P n = 6 * b'P6 P n := rfl
  have hTL : TP6 P n = 2 ^ LP6 P n := rfl
  have hprod : (List.ofFn (tD6 P n D)).prod = TP6 P n := TW_eq P n D hD (by omega)
  have htot := pre_t_post P n D k hk
  rw [hprod] at htot
  have hlo := hsrc.lo k (by omega)
  have hhi := hsrc.hi k (by omega)
  have hwnd : wnd6 P n k = tF6 P n k / (8 * dP6 P n ^ 2) := rfl
  rw [hwnd] at hlo hhi
  obtain ⟨h8, hts⟩ := window hlo hhi hd1
  have hLJ := dLJ_le hd1 hs0 hst.le h8 hts
  have hLJs := LJ_length_le_s (src k) (tF6 P n k) (lamP (dP6 P n)) (wF (dP6 P n))
  have hGle := Val.pow_clog_le (LJ (src k) (tF6 P n k) (lamP (dP6 P n)) (wF (dP6 P n))).length
  have hdb' : dP6 P n ≤ bP6 n := d_le_b P hP n
  have hbb : bP6 n ≤ b'P6 P n := by
    unfold b'P6; exact Nat.le_self_pow (by omega) _
  have hβb : Nat.log 2 (bP6 n) ≤ bP6 n := Nat.log_le_self 2 _
  have ht2 : tF6 P n k ≤ 2 ^ ℓP6 P n := by
    have e : ℓP6 P n = hN6 P n + 1 := by unfold hN6; omega
    unfold tF6; rw [e, pow_succ]; split_ifs <;> omega
  have hT1 : 1 ≤ TP6 P n := by rw [hTL]; exact Nat.one_le_two_pow
  have hpre1 : 1 ≤ preT P n D k := Nat.pos_of_ne_zero (fun h => by rw [h] at htot; omega)
  have hpost1 : 1 ≤ postT P n D k := Nat.pos_of_ne_zero (fun h => by rw [h] at htot; omega)
  have htT : tF6 P n k ≤ TP6 P n := by
    rw [← htot]
    calc tF6 P n k = 1 * tF6 P n k * 1 := by ring
      _ ≤ _ := Nat.mul_le_mul (Nat.mul_le_mul_right _ hpre1) hpost1
  have hNF := NF_lt (d := dP6 P n) hb64 (by omega) hst htT hb6 hTL (by omega)
  have hℓL : ℓP6 P n ≤ LP6 P n + 1 := by
    unfold ℓP6; apply Nat.div_le_of_le_mul
    have : LP6 P n ≤ dP6 P n * LP6 P n := Nat.le_mul_of_pos_left _ hd1
    rw [Nat.mul_succ]; omega
  have hpT := p_le_T hb64 hb6
  have hdG := dG_le hLJ hGle h8 hd1
  have hlamF := log_lamF_le hd1 hdb'
  have hnc : axnc6 P n k * axl6 P n ≤ axt6 P n k := Nat.div_mul_le_self _ _
  have hfJle : Nat.clog 2 (LJ (src k) (tF6 P n k) (lamP (dP6 P n)) (wF (dP6 P n))).length ≤
      ℓP6 P n := Nat.clog_le_of_le_pow (hLJs.trans (by omega))
  have hG2 : 2 ^ Nat.clog 2 (LJ (src k) (tF6 P n k) (lamP (dP6 P n)) (wF (dP6 P n))).length ≤
      3 * tF6 P n k := by omega
  have hVJ : dP6 P n * (preT P n D k * 2 ^ Nat.clog 2 (LJ (src k) (tF6 P n k) (lamP (dP6 P n))
      (wF (dP6 P n))).length * postT P n D k) ≤ 99 * TP6 P n := by
    rw [← htot]
    calc dP6 P n * (preT P n D k * _ * postT P n D k)
        = preT P n D k * (dP6 P n * _) * postT P n D k := by ring
      _ ≤ preT P n D k * (99 * tF6 P n k) * postT P n D k :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hdG)
      _ = 99 * (preT P n D k * tF6 P n k * postT P n D k) := by ring
  have hVC : preT P n D k * axnc6 P n k * axl6 P n * postT P n D k ≤ TP6 P n := by
    rw [← htot]
    calc preT P n D k * axnc6 P n k * axl6 P n * postT P n D k
        = preT P n D k * (axnc6 P n k * axl6 P n) * postT P n D k := by ring
      _ ≤ preT P n D k * tF6 P n k * postT P n D k :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hnc)
  have hsz : Nat.size (2 * TP6 P n) ≤ pP6 P n := by
    rw [Nat.size_le, hTL, ← pow_succ']
    exact Nat.pow_lt_pow_right (by norm_num) (by omega)
  have hdT : dP6 P n ≤ TP6 P n := by
    have : dP6 P n ≤ tF6 P n k := by nlinarith
    omega
  have hQle : segPF (pP6 P n) (dP6 P n) (src k) ≤ 3 * pP6 P n := segPF_le3 (by omega) (by rw [hpe]; exact hNF)
  have hpQ : pP6 P n + 1 ≤ segPF (pP6 P n) (dP6 P n) (src k) := by unfold segPF; omega
  exact ⟨htot, hprod, hpre1, hpost1, (by show 1 ≤ tF6 P n k; omega), by omega, by omega, hsz, hQle, hpQ, hlamF, rfl,
    hVC, hnc, hVJ, hG2, rfl, hfJle, by omega, hdT, hd1, by omega,
    Nat.lt_pow_succ_log_self (by norm_num) _⟩

end J6Seg.Side
end

end

theorem solution : type_of% @J6Seg.Side.axNum_ev_sol_aux := @J6Seg.Side.axNum_ev_sol_aux
