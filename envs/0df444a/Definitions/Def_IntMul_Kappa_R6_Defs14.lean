    (2 * B + 2) + cRevE τ K h w 2 1 (bsL d bL).reverse Z + 6 * 10 ^ 7 * (B + 2) ^ 2 +
    (d + 1) * (cStepU d (vol ((List.range (d - 1)).map sF)) (vol (shR d (sP d sF))) w Br Bb + 3000) +
