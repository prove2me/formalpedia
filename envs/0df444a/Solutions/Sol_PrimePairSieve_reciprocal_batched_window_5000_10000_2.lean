theorem solution (z : ℝ) (hz : 5000 ≤ z) (hupper : z ≤ 10000) :
    Real.log (4*z)^2/(2*TaoFivePrimes.twinPrimeConstant) /
      (1-((z+1)*(Real.log (4*z)^2/(2*TaoFivePrimes.twinPrimeConstant))/(16*z^2))) ≤
      ∑ n ∈ Finset.Icc 1 ⌊z⌋₊,
        (if Squarefree n then ∏ p ∈ n.primeFactors, if p = 2 then (1:ℝ) else 2/((p:ℝ)-2) else 0)/(1+(n:ℝ)/z) := by

  by_cases h6345 : z ≤ 6345
  · exact BatchedWindow5000_10000.cell_5000 z (by linarith) h6345

  by_cases h7739 : z ≤ 7739
  · exact BatchedWindow5000_10000.cell_6345 z (by linarith) h7739

  by_cases h9141 : z ≤ 9141
  · exact BatchedWindow5000_10000.cell_7739 z (by linarith) h9141

  exact BatchedWindow5000_10000.cell_9141 z (by linarith) hupper

example : ∀ z : ℝ, 5000 ≤ z → z ≤ 10000 →
      (Real.log (4 * z)) ^ 2 / (2 * TaoFivePrimes.twinPrimeConstant) /
          (1 - ((z + 1) * ((Real.log (4 * z)) ^ 2 /
            (2 * TaoFivePrimes.twinPrimeConstant)) / (16 * z ^ 2)))
        ≤ ∑ q ∈ Finset.Icc 1 ⌊z⌋₊,
          (if Squarefree q then
            ∏ p ∈ q.primeFactors, if p = 2 then (1 : ℝ) else 2 / ((p : ℝ) - 2)
          else 0) / (1 + (q : ℝ) / z) := solution

