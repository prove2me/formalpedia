/-
Copyright (c) 2026 Vas and contributors. Released under Apache-2.0.
Design boundary: construct the actual reciprocal-patch algebra map into the
localized finite coordinate algebra by recovered z,w and their literal sextic.
Named downstream consumer: the third single-section chart comparison.
No bijectivity or whole-curve complement is assumed or asserted.
-/

noncomputable section
universe u
namespace MazurTransfer.Order13SingleSectionFiniteAlgebra
open Polynomial
open MazurTorsion.XOneThirteenAffineCurve
open MazurTorsion.XOneThirteenProjectiveCurve
open Order13SingleSectionFiniteMapIdentities
variable (R : Type u) [CommRing R]

abbrev infinityLocalization := Localization.Away (infinityPatchElement R)
def infinityParameter : infinityLocalization R :=
  algebraMap (candidateAlgebra R) (infinityLocalization R) (parameterElement R)
def infinityP : infinityLocalization R :=
  algebraMap (candidateAlgebra R) (infinityLocalization R) (pElement R)
def infinityQ : infinityLocalization R :=
  algebraMap (candidateAlgebra R) (infinityLocalization R) (qElement R)
def infinityPInverse : infinityLocalization R :=
  (infinityP R + infinityParameter R) * IsLocalization.Away.invSelf (infinityPatchElement R)

theorem infinityP_mul_inverse : infinityP R * infinityPInverse R = 1 := by
  rw [infinityPInverse,← mul_assoc]
  change algebraMap (candidateAlgebra R) (infinityLocalization R) (pElement R) *
    (algebraMap (candidateAlgebra R) (infinityLocalization R) (pElement R) +
      algebraMap (candidateAlgebra R) (infinityLocalization R) (parameterElement R)) * _ = 1
  rw [← map_add,← map_mul]
  exact IsLocalization.Away.mul_invSelf (infinityPatchElement R)

theorem infinityP_mul_P_add_parameter_isUnit :
    IsUnit (infinityP R * (infinityP R + infinityParameter R)) := by
  change IsUnit (algebraMap (candidateAlgebra R) (infinityLocalization R) (pElement R) *
    (algebraMap (candidateAlgebra R) (infinityLocalization R) (pElement R) +
      algebraMap (candidateAlgebra R) (infinityLocalization R) (parameterElement R)))
  rw [← map_add,← map_mul]
  exact IsLocalization.Away.algebraMap_isUnit (infinityPatchElement R)

theorem infinityP_isUnit : IsUnit (infinityP R) :=
  isUnit_of_mul_isUnit_left (infinityP_mul_P_add_parameter_isUnit R)
theorem infinityP_add_parameter_isUnit : IsUnit (infinityP R + infinityParameter R) :=
  isUnit_of_mul_isUnit_right (infinityP_mul_P_add_parameter_isUnit R)
theorem infinityPInverse_isUnit : IsUnit (infinityPInverse R) := by
  have h : IsUnit (infinityP R * infinityPInverse R) := by rw [infinityP_mul_inverse]; exact isUnit_one
  exact isUnit_of_mul_isUnit_right h

def infinityRecoveredZ : infinityLocalization R := infinityParameter R * infinityPInverse R
def infinityRecoveredD : infinityLocalization R := 4 * (1 + infinityRecoveredZ R) * infinityPInverse R
def infinityRecoveredW : infinityLocalization R :=
  infinityRecoveredD R + 1 + infinityRecoveredZ R + infinityRecoveredZ R ^ 3

theorem infinityP_mul_one_add_recoveredZ :
    infinityP R * (1 + infinityRecoveredZ R) = infinityP R + infinityParameter R := by
  dsimp [infinityRecoveredZ]
  linear_combination (infinityParameter R) * infinityP_mul_inverse R

theorem one_add_infinityRecoveredZ_isUnit : IsUnit (1 + infinityRecoveredZ R) := by
  have h := infinityP_add_parameter_isUnit R
  rw [← infinityP_mul_one_add_recoveredZ] at h
  exact isUnit_of_mul_isUnit_right h

theorem infinityRecoveredD_isUnit (h2 : IsUnit (2 : R)) : IsUnit (infinityRecoveredD R) := by
  have h4 : IsUnit (4 : infinityLocalization R) := by
    have h := (h2.map (algebraMap R (infinityLocalization R))).pow 2
    simpa only [_root_.map_ofNat,show (2 : infinityLocalization R) ^ 2 = 4 by ring] using h
  exact (h4.mul (one_add_infinityRecoveredZ_isUnit R)).mul (infinityPInverse_isUnit R)

theorem candidate_parameter_quartic :
    parameterElement R ^ 4 - 2 * pElement R ^ 3 - 2 * pElement R ^ 2 * parameterElement R -
      2 * parameterElement R ^ 3 - 4 * pElement R ^ 2 - 4 * pElement R * parameterElement R = 0 := by
  apply Subtype.val_injective
  change (parameterElement R : CoordinateRing R) ^ 4 - 2 * p R ^ 3 -
    2 * p R ^ 2 * (parameterElement R : CoordinateRing R) -
    2 * (parameterElement R : CoordinateRing R) ^ 3 - 4 * p R ^ 2 -
    4 * p R * (parameterElement R : CoordinateRing R) = 0
  rw [parameterElement_coe]
  exact Order13SingleSectionReciprocalRecoveryIdentities.actual_parameter_quartic R

theorem infinity_parameter_quartic :
    infinityParameter R ^ 4 - 2 * infinityP R ^ 3 - 2 * infinityP R ^ 2 * infinityParameter R -
      2 * infinityParameter R ^ 3 - 4 * infinityP R ^ 2 - 4 * infinityP R * infinityParameter R = 0 := by
  simpa only [map_sub,map_mul,map_pow,_root_.map_ofNat,map_zero,infinityParameter,infinityP]
    using congrArg (algebraMap (candidateAlgebra R) (infinityLocalization R)) (candidate_parameter_quartic R)

theorem infinity_recovered_reciprocal_equation :
    infinityRecoveredW R ^ 2 = aeval (infinityRecoveredZ R) (reciprocalPolynomial R) := by
  simpa only [infinityRecoveredW,infinityRecoveredD,infinityRecoveredZ,reciprocalPolynomial,
    map_add,map_mul,map_pow,_root_.map_ofNat,map_one,aeval_X] using
    Order13SingleSectionReciprocalRecoveryIdentities.recovered_reciprocal_equation
      (infinityParameter R) (infinityP R) (infinityPInverse R)
      (infinityP_mul_inverse R) (infinity_parameter_quartic R)

def recoveredReciprocalBase : ReciprocalRing R →ₐ[R] infinityLocalization R :=
  AdjoinRoot.liftAlgHom (reciprocalEquation R) (aeval (infinityRecoveredZ R))
    (infinityRecoveredW R) (by
      simpa [reciprocalEquation,Polynomial.aeval_def] using
        sub_eq_zero.mpr (infinity_recovered_reciprocal_equation R))

theorem recoveredReciprocalBase_z : recoveredReciprocalBase R (zCoordinate R) = infinityRecoveredZ R := by
  simp [recoveredReciprocalBase,zCoordinate]
theorem recoveredReciprocalBase_w : recoveredReciprocalBase R (wCoordinate R) = infinityRecoveredW R := by
  simp [recoveredReciprocalBase,wCoordinate]

theorem recoveredReciprocalBase_d :
    recoveredReciprocalBase R (Order13SingleSectionReciprocalPatch.d R) = infinityRecoveredD R := by
  simp only [Order13SingleSectionReciprocalPatch.d,map_sub,map_pow,map_one,
    recoveredReciprocalBase_z,recoveredReciprocalBase_w,infinityRecoveredW]
  ring

theorem recovered_second_denominator_isUnit (h2 : IsUnit (2 : R)) :
    IsUnit (recoveredReciprocalBase R (Order13SingleSectionReciprocalPatch.dPrime R)) := by
  have hw := infinity_recovered_reciprocal_equation R
  simp only [reciprocalPolynomial,map_add,map_mul,map_pow,_root_.map_ofNat,map_one,aeval_X] at hw
  have heq : (infinityRecoveredW R + 1 + infinityRecoveredZ R - infinityRecoveredZ R ^ 3) *
      (infinityRecoveredW R - 1 - infinityRecoveredZ R + infinityRecoveredZ R ^ 3) =
        4 * infinityRecoveredZ R ^ 3 * (1 + infinityRecoveredZ R) ^ 2 := by
    linear_combination hw
  have hd : IsUnit (infinityRecoveredW R - 1 - infinityRecoveredZ R - infinityRecoveredZ R ^ 3) := by
    have he : infinityRecoveredW R - 1 - infinityRecoveredZ R - infinityRecoveredZ R ^ 3 =
        infinityRecoveredD R := by dsimp [infinityRecoveredW]; ring
    rw [he];exact infinityRecoveredD_isUnit R h2
  have htwo : IsUnit (2 : infinityLocalization R) := by
    simpa only [_root_.map_ofNat] using h2.map (algebraMap R (infinityLocalization R))
  simpa only [Order13SingleSectionReciprocalPatch.dPrime,map_sub,map_add,map_pow,map_one,
    recoveredReciprocalBase_z,recoveredReciprocalBase_w] using
      Order13SingleSectionReciprocalPatch.second_denominator_isUnit
        (infinityRecoveredZ R) (infinityRecoveredW R) htwo hd
        (one_add_infinityRecoveredZ_isUnit R) heq

def recoveredReciprocalPatch (h2 : IsUnit (2 : R)) :
    Order13SingleSectionReciprocalPatch.PatchRing R →ₐ[R] infinityLocalization R :=
  IsLocalization.Away.liftAlgHom
    (Order13SingleSectionReciprocalPatch.d R * Order13SingleSectionReciprocalPatch.dPrime R)
    (f := recoveredReciprocalBase R) (by
      rw [map_mul,recoveredReciprocalBase_d]
      exact (infinityRecoveredD_isUnit R h2).mul (recovered_second_denominator_isUnit R h2))

theorem recoveredReciprocalPatch_algebraMap (h2 : IsUnit (2 : R)) (b : ReciprocalRing R) :
    recoveredReciprocalPatch R h2
      (algebraMap (ReciprocalRing R) (Order13SingleSectionReciprocalPatch.PatchRing R) b) =
      recoveredReciprocalBase R b := by
  simp [recoveredReciprocalPatch,IsLocalization.Away.liftAlgHom,IsLocalization.Away.lift_eq]

end MazurTransfer.Order13SingleSectionFiniteAlgebra
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.infinity_recovered_reciprocal_equation
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.recoveredReciprocalPatch
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.recoveredReciprocalPatch_algebraMap

end
