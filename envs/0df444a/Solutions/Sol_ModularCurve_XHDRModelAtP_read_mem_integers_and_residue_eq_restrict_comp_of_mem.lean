  have hιAρO : ιA.comp ρO = ρ := by
    have h3 : A.subtype.comp (ιA.comp ρO) = A.subtype.comp ρ := by rw [← RingHom.comp_assoc, hιA, hjO, hρ]
    exact RingHom.ext fun x => Subtype.val_injective (congrArg (fun φ : R p →+* AlgebraicClosure ℚ => φ x) h3)

