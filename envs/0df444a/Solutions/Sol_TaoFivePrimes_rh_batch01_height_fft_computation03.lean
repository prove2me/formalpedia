lemma eq_of_zip_check {α : Type} [DecidableEq α] (a b : List α)
    (hlen:a.length=b.length) (h:(a.zip b).all (fun p => decide (p.1=p.2))=true) : a=b := by
  induction a generalizing b with
  | nil => cases b with
    | nil => rfl
    | cons x xs => simp at hlen
  | cons x xs ih => cases b with
    | nil => simp at hlen
    | cons y ys =>
      simp only [List.zip_cons_cons,List.all_cons,Bool.and_eq_true,decide_eq_true_eq] at h
      have htail:xs=ys:=ih ys (by simpa using hlen) h.2
      simp only [h.1,htail]
lemma final_eq : finalOutput=expected := by
  have h := finalChecked
  change (decide (finalOutput.length=2048 ∧ expected.length=2048) && (finalOutput.zip expected).all (fun p => decide (p.1=p.2)))=true at h
  simp only [Bool.and_eq_true,decide_eq_true_eq] at h
  exact eq_of_zip_check _ _ (by omega) h.2
end RHBatch01StagedConv03
