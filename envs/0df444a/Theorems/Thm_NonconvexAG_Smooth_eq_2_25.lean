-- title:
--   (2.25) — Σ_{k≤N} (α_k/(λ_kΓ_k))[‖x_{k−1} − x‖² − ‖x_k − x‖²] ≤ ‖x_0 − x‖²/λ_1
-- statement:
--   Let $x_k,x^{md}_k,x^{ag}_k$ be generated by Algorithm 1 from $x_0$ with step sizes $\alpha_1=1$, $\alpha_k\in(0,1)$ ($k\ge2$), $\beta_k>0$, $\lambda_k>0$, using an arbitrary map $\nabla\Psi:\mathbb R^n\to\mathbb R^n$; $\Gamma_k$ as in (2.6). Let $N\ge1$ and suppose (2.10) holds on $k=1,\dots,N$: $\alpha_k/(\lambda_k\Gamma_k)\le\alpha_{k-1}/(\lambda_{k-1}\Gamma_{k-1})$ for $2\le k\le N$. Then for every $x\in\mathbb R^n$,
--   $$\sum_{k=1}^N\frac{\alpha_k}{\lambda_k\Gamma_k}\Big[\|x_{k-1}-x\|^2-\|x_k-x\|^2\Big]\le\frac{\|x_0-x\|^2}{\lambda_1}.$$
--
--   This weighted telescoping bound is the second inequality in (2.24).
--
--   **Formalization Note** The statement is the outer ends of (2.25) (the middle term is $\alpha_1\|x_0-x\|^2/(\lambda_1\Gamma_1)$ and $\alpha_1=\Gamma_1=1$). It is stated for any map `g`.
-- source:
--   Ghadimi & Lan, Accelerated Gradient Methods for Nonconvex Nonlinear and Stochastic Programming, arXiv:1310.3787v1, p. 7, (2.25)

import Mathlib
import Definitions.Def_ConvexOptAlg_SmoothGD_Defs
import Definitions.Def_NonconvexAG_Smooth_AGRun

namespace NonconvexAG.Smooth

/-- (2.25), p. 7 (outer ends), under (2.10) for `k = 1, …, N`, for every `x ∈ ℝⁿ`. -/
theorem eq_2_25 {n : ℕ} (g : E n → E n) (α β lam : ℕ → ℝ) (hstep : AGStepsizes α β lam) (x0 : E n) (N : ℕ) (hN : 1 ≤ N)
    (h210 : ∀ k ∈ Finset.Icc 1 N, 2 ≤ k →
      α k / (lam k * Gamma α k) ≤ α (k - 1) / (lam (k - 1) * Gamma α (k - 1))) :
    ∀ x : E n,
      ∑ k ∈ Finset.Icc 1 N,
          α k / (lam k * Gamma α k) * (‖xSeq g α β lam x0 (k - 1) - x‖ ^ 2 - ‖xSeq g α β lam x0 k - x‖ ^ 2) ≤
        ‖x0 - x‖ ^ 2 / lam 1 := by sorry

end NonconvexAG.Smooth
