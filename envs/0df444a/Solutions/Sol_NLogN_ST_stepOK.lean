theorem tensorGo_len {α : Type*} [Inhabited α] : ∀ (As : List (ℕ × (List α → List α))) (dims : List ℕ)
    (L : List α), As ≠ [] → As.length ≤ dims.length → (∀ n ∈ dims, 0 < n) →
    (∀ a ∈ As, 0 < a.1 ∧ ∀ X, (a.2 X).length = a.1) →
    (tensorGo As dims L).length = (dims.drop As.length).prod * (As.map Prod.fst).prod
  | [], _, _, h, _, _, _ => absurd rfl h
  | _ :: _, [], _, _, hl, _, _ => by simp at hl
  | (n', A) :: As, n :: rest, L, _, hl, hd, ha => by
    simp only [tensorGo]
    have hn : 0 < n := hd n (by simp)
    have hA := ha (n', A) (by simp)
    set C := chunkL n (transposeL n rest.prod L) with hC
    have hCl : C.length = rest.prod := GL.chunkL_length n rest.prod _ hn (GL.transposeL_length _ _ _)
    have hL' : (C.flatMap A).length = rest.prod * n' := by
      rw [List.length_flatMap]
      have : (C.map fun c => (A c).length) = C.map fun _ => n' := List.map_congr_left (fun c _ => hA.2 c)
      rw [this, List.map_const', List.sum_replicate, hCl, smul_eq_mul]
    by_cases hAs : As = []
    · subst hAs; simp [tensorGo, hL']
    · have hl' : As.length ≤ rest.length := by simp at hl; omega
      rw [tensorGo_len As (rest ++ [n']) _ hAs (by simp; omega)
        (fun m hm => by
          simp only [List.mem_append, List.mem_singleton] at hm
          rcases hm with hm | rfl
          · exact hd m (by simp [hm])
          · exact hA.1)
        (fun a haa => ha a (by simp [haa]))]
      rw [List.drop_append_of_le_length hl']
      simp only [List.prod_append, List.prod_singleton, List.length_cons, List.drop_succ_cons,
        List.map_cons, List.prod_cons, List.prod_nil, mul_one, List.drop_nil]
      ring

theorem wl_of (K N : ℕ) (hK : 20 ≤ K) (hN : n0K K ≤ N) (u v : List ℤ) :
    (exactConvL (mkParams K N) u v).length = (mkParams K N).S := by
