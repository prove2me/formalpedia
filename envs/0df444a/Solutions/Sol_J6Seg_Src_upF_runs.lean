    Sp (popL rg) (encK s0 (RF v c)) (encK s0 c) (22 * uC A DD) := by
  have h := popL_sp s0 rg (RF v c) rg_nodup (fun i hi => ⟨rg_lt i hi, v i, [], RF_in hi, hv i hi⟩)
  have e : (fun j => if j ∈ rg then (RF v c j).tail else RF v c j) = c := by
    funext j; by_cases hj : j ∈ rg
    · simp [hj, RF_in, hc j hj]
    · simp [hj, RF_out]
  rw [e] at h
  exact h

/-! ## Parking the descriptor -/

theorem park_sp (s : IState HS) (f : Fin HS → List ℤ) {X Y Z C : Fin HS} (hXY : X ≠ Y)
    (hXZ : X ≠ Z) (hYZ : Y ≠ Z) (hXC : X ≠ C) (hYC : Y ≠ C) (hZC : Z ≠ C) (hX5 : X.val < 56)
    (hY5 : Y.val < 56) (hZ5 : Z.val < 56) (hC5 : C.val < 56) {L : List ℤ} (hL8 : L.length = 8)
    (hfX : f X = L) (hfY : f Y = []) (hfZ : f Z = []) {B : ℕ} (hB : Bnd B L) (h8 : zsz 8 ≤ B) :
    Sp (park X Y Z C) (encK s f) (encK s (update (update f X []) Z L)) (parkC B) := by
  have h1 := Sp.mvK hXY hXC hYC hX5 hY5 hC5 s f (.lit 8) (clean_of_regs' (fun i hi => by simp [Ex.regs] at hi))
    trivial L [] (by rw [hfX, List.append_nil]) (by simp [Ex.eval, hL8]) B hB trivial h8
  have h2 := Sp.mvK hYZ hYC hZC hY5 hZ5 hC5 s (update (update f X []) Y (L.reverse ++ f Y))
    (.lit 8) (clean_of_regs' (fun i hi => by simp [Ex.regs] at hi)) trivial L.reverse []
    (by rw [update_self, hfY, List.append_nil]) (by simp [Ex.eval, hL8]) B
    (fun a ha => hB a (List.mem_reverse.1 ha)) trivial h8
  have e : update (update (update (update f X []) Y (L.reverse ++ f Y)) Y [])
      Z ((L.reverse).reverse ++ update (update f X []) Y (L.reverse ++ f Y) Z) =
      update (update f X []) Z L := by
    funext j
    by_cases hjZ : j = Z
    · subst hjZ; simp [update_of_ne hYZ.symm, update_of_ne hXZ.symm, hfZ]
    by_cases hjY : j = Y
    · subst hjY; simp [update_of_ne hjZ, update_of_ne hXY.symm, hfY]
    simp [update_of_ne hjZ, update_of_ne hjY]
  rw [e] at h2
  refine (h1.seq h2).mono (le_of_eq ?_)
  simp only [parkC, Ex.size, List.length_reverse, hL8]; ring

end J6Seg.Src

end

section
-- Source module: Solutions.J6SegAxis3
/-!
# B-line axis program (`AxisU6`), part 3: the slab passes as `PassOK` steps

The slab passes (B1, `J6SegILSlab8`) read the skeleton registers
`rC = flatC cs`, `rM = [2 post]`, `rNC = [|cs|]`, `rNB = [pre]`, `rTOT = [pre · n' · 2 post]`
(and `rK1 = [2^(P-p)]`, `rK2 = [2^p]` for the output pass). They are built from the descriptor
by a set-up / tear-down pair:

* `SetupS Isym tbl stUp stDn ρ dA desc V C`: from any managed state in which only `0`, `sZ`,
  `dA` and the registers `ρ` may be nonempty (registers empty, `desc` on `dA`), `stUp` writes the
  register file `V` and `stDn` clears it, everything else unchanged, each at cost `≤ C`
  (B1's source-table producers and `ctlB`; `J6SegILSrc*`, `J6SegILCtl*`).
* `slabV cs pre post n' K1 K2`: the register file on `ρS = (rC, rM, rNC, rNB, rTOT, rK1, rK2)`.

`slabId_ok`, `slabSc_ok` (`PassOK`) and `slabOut_ok` (`Pass2OK`): set-up; the B1 pass; tear-down.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open J6Seg.Slab
open NLogN.KFUU (lA lC lD)

theorem ρS_inj : Injective ρS := by
  intro a b h; fin_cases a <;> fin_cases b <;> simp_all +decide [ρS]

section gen
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

theorem extS (V : Fin 7 → List ℤ) (F : Fin HS → List ℤ) (i : Fin 7) :
    extend ρS V F (ρS i) = V i := ρS_inj.extend_apply V F i

theorem extS_out {j : Fin HS} (hj : ∀ i, ρS i ≠ j) (V : Fin 7 → List ℤ) (F : Fin HS → List ℤ) :
    extend ρS V F j = F j := extend_apply' _ _ _ (fun ⟨a, ha⟩ => hj a ha)

end gen

end J6Seg.Ax

end

end

section
-- Source module: Solutions.J6SegILSrc13
/-!
# B-line IL, source-table producers, part 13: the set-up frame

`upF dA Z Z1 Cm body`: park the descriptor `dA → Z` (through `Z1`, counter `Cm`), push `0` on
the parameter registers `rg`, run D2's parameter phase `parP 0 0 0 0 Z`, run `body`, pop `rg`,
and park the descriptor back `Z → dA`. Theorem `upF_runs`: if `body` takes `RF v c₀` to
`RF v (extend ρS V c₀)` for every `v` satisfying `ParV` (`c₀` = the input with the descriptor
moved to `Z`), then `upF` takes `F` to `extend ρS V F` (the first half of `SetupS`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.PJ (rg RF RF_in RF_out ParV BV parBig cPar dsc Rn)
open J6Seg.Ax (ρS sZ)

theorem rg_out : ∀ j ∈ rg, j ≠ 0 ∧ j ≠ sZ ∧ ∀ i, ρS i ≠ j := by
  intro j hj
  refine ⟨?_, ?_, fun i => ?_⟩
  · intro h; subst h; revert hj; decide
  · intro h; subst h; revert hj; decide
  · intro h; subst h; revert hj; revert i; decide

theorem n48_out : (48 : Fin HS) ≠ 0 ∧ (48 : Fin HS) ≠ sZ ∧ ∀ i, ρS i ≠ 48 := by
  refine ⟨by decide, by decide, fun i => ?_⟩; revert i; decide

theorem upF_runs_sol_aux {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} {dA Z Z1 Cm : Fin HS}
    (hP : ParkOK dA Z Z1 Cm) {body : IStmt HS Pp} {m : ℕ} {ρ : Fin m → Fin HS}
    (s : IState HS) (F : Fin HS → List ℤ)
    (hF : ∀ j, j ≠ 0 → j ≠ sZ → j ≠ dA → (∀ i, ρS i ≠ j) → F j = [])
    {k pre post sv t p α d W : ℕ} (hdA : F dA = dsc k pre post sv t p α d)
    (hW : parBig 0 0 0 0 k pre post sv t p α d < 2 ^ W) (hW3 : 3 ≤ W)
    (V : Fin 7 → List ℤ) {cB : ℕ}
    (hB : ∀ v, ParV 0 0 0 0 pre post sv t p α d v → BV W v →
      IRuns I iprog body (encK s (RF v (c0 F dA Z (dsc k pre post sv t p α d))))
        (encK s (RF v (extend ρS V (c0 F dA Z (dsc k pre post sv t p α d))))) cB) :
    IRuns I iprog (upF dA Z Z1 Cm body) (encK s F) (encK s (extend ρS V F))
      (parkC (W + 1) + 22 * (2 * uC 2 DD) +
        cPar 0 0 0 0 W d (NF d sv) (segPF p d sv) (0 * segPF p d sv + 0) +
        cB + (22 * uC W DD + parkC (W + 1))) := by
  obtain ⟨⟨l1, l2, l3, l4⟩, ⟨n1, n2, n3, n4, n5, n6⟩, ⟨r1, r2, r3⟩, ⟨z1, z2, z3⟩, hout, ⟨a1, a2, a3⟩⟩ := hP
  have oZ := hout Z (by simp)
  have oZ1 := hout Z1 (by simp)
  have oC := hout Cm (by simp)
  have hFZ : F Z = [] := hF Z oZ.1 oZ.2.1 (Ne.symm n1) oZ.2.2
  have hFZ1 : F Z1 = [] := hF Z1 oZ1.1 oZ1.2.1 (Ne.symm n2) oZ1.2.2
  obtain ⟨bNF, bkJ, bQ, bk, bpre, bpost, bs, bt, bα, bp, bd, blF, bwF, bwd, bkJ', b1500, bwA, bwC,
    bkA, bkC⟩ := J6Seg.PJ.parB hW
  have hBd : Bnd (W + 1) (dsc k pre post sv t p α d) := by
    intro x hx
    simp only [dsc, List.mem_cons, List.not_mem_nil, or_false] at hx
    have hW' : (2 : ℤ) ^ W < 2 ^ (W + 1) := by
      rw [pow_succ]; have : (0 : ℤ) < 2 ^ W := by positivity
      linarith
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      (apply NLogN.zsz_le_of_abs; rw [abs_of_nonneg (by positivity)];
       exact lt_trans (by exact_mod_cast (by omega)) hW')
  have h8 : zsz (8 : ℤ) ≤ W + 1 := by
    apply NLogN.zsz_le_of_abs
    have : (2 : ℤ) ^ 4 ≤ 2 ^ (W + 1) := pow_le_pow_right₀ (by norm_num) (by omega)
    rw [abs_of_nonneg (by norm_num)]; linarith
  have h1 := park_sp s F (X := dA) (Y := Z1) (Z := Z) (C := Cm) n2 n1 (Ne.symm n4) n3 n6 n5
    l1 l3 l2 l4 rfl hdA hFZ1 hFZ hBd h8
  set c := c0 F dA Z (dsc k pre post sv t p α d) with hc
  have hrg : ∀ j ∈ rg, c j = [] := by
    intro j hj
    have hZj : j ≠ Z := fun h => r1 (h ▸ hj)
    rw [hc, c0, update_of_ne hZj]
    by_cases hjd : j = dA
    · subst hjd; simp
    · rw [update_of_ne hjd]; exact hF j (rg_out j hj).1 (rg_out j hj).2.1 hjd (rg_out j hj).2.2
  have h2 := pushZ_rg s c hrg
  have hcZ : c Z = dsc k pre post sv t p α d := by simp [hc, c0]
  have hcL : c 48 = [] := by
    have h48Z : (48 : Fin HS) ≠ Z := Ne.symm z3
    rw [hc, c0, update_of_ne h48Z]
    by_cases h48 : (48 : Fin HS) = dA
    · rw [← h48]; simp
    · rw [update_of_ne h48]; exact hF 48 n48_out.1 n48_out.2.1 h48 n48_out.2.2
  obtain ⟨v, ⟨hPV, hBV⟩, hS⟩ := J6Seg.PJ.Rn.parP (Z := Z) r1 l2 z1 z2 (kA := 0) (kC := 0) (wA := 0)
    (wC := 0) hcZ hcL hW
  have h3 := hS s
  have h4 := hB v hPV hBV
  have hext : ∀ j, (∀ i, ρS i ≠ j) → extend ρS V c j = c j := fun j hj => J6Seg.Ax.extS_out hj V c
  have h5 := popL_rg s v (extend ρS V c) (A := W) (fun j hj => hBV j hj)
    (fun j hj => by rw [hext j (rg_out j hj).2.2]; exact hrg j hj)
  have hdA' : (∀ i, ρS i ≠ dA) := a3
  have h6 := park_sp s (extend ρS V c) (X := Z) (Y := Z1) (Z := dA) (C := Cm) n4 (Ne.symm n1)
    (Ne.symm n2) n5 n6 n3 l2 l3 l1 l4 rfl (by rw [hext Z oZ.2.2, hcZ])
    (by rw [hext Z1 oZ1.2.2, hc, c0, update_of_ne (Ne.symm n4), update_of_ne (Ne.symm n2), hFZ1])
    (by rw [hext dA a3, hc, c0, update_of_ne n1]; simp) hBd h8
  have e : update (update (extend ρS V c) Z []) dA (dsc k pre post sv t p α d) = extend ρS V F := by
    funext j
    by_cases hj : ∃ i, ρS i = j
    · obtain ⟨i, rfl⟩ := hj
      rw [update_of_ne (a3 i), update_of_ne (oZ.2.2 i),
        J6Seg.Ax.extS, J6Seg.Ax.extS]
    · push_neg at hj
      rw [J6Seg.Ax.extS_out hj]
      by_cases hjd : j = dA
      · subst hjd; rw [update_self, hdA]
      rw [update_of_ne hjd]
      by_cases hjZ : j = Z
      · subst hjZ; rw [update_self, hFZ]
      rw [update_of_ne hjZ, hext j hj, hc, c0, update_of_ne hjZ, update_of_ne hjd]
  rw [e] at h6
  have HA : Sp (upA dA Z Z1 Cm) (encK s F) (encK s (RF v c)) _ := h1.seq (h2.seq h3)
  have HB : Sp (upB dA Z Z1 Cm) (encK s (RF v (extend ρS V c))) (encK s (extend ρS V F)) _ :=
    h5.seq h6
  refine ((HA.toIRuns (I := I) (iprog := iprog)).seq (h4.seq (HB.toIRuns))).mono (le_of_eq ?_)
  ring

end J6Seg.Src

end

theorem solution : type_of% @J6Seg.Src.upF_runs_sol_aux := @J6Seg.Src.upF_runs_sol_aux
