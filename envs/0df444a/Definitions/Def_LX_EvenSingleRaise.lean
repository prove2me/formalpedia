open LX.AffineScan LX.CenteredLift
variable {n : ℕ} [NeZero n]

def evenBase (m : ℕ) (c : Fin n) : Fin n → ℤ :=
  perturbedBoard m ((c : ℤ)+1) (Equiv.swap 1 2)











