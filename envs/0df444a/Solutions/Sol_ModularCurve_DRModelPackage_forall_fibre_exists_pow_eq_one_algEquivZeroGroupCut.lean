private theorem eq_one_of_pow_prime_pow_eq_one {K : Type*} [Field K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (a : ℕ) (y : K) (h : y ^ (p ^ a) = 1) : y = 1 := by
  have h2 : (y - 1) ^ (p ^ a) = 0 := by
    rw [sub_pow_char_pow, h, one_pow, sub_self]
  exact sub_eq_zero.mp (pow_eq_zero_iff (pow_ne_zero a (Fact.out : p.Prime).ne_zero) |>.mp h2)

private theorem exists_pos_not_dvd_pow_eq_one {K : Type*} [Field K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (hK : ∀ u : Kˣ, IsOfFinOrder u) {n : ℕ} (f : Fin n → Kˣ) :
    ∃ m : ℕ, 0 < m ∧ ¬ p ∣ m ∧ f ^ m = 1 := by
  classical
  have hp : p.Prime := Fact.out

  have hcoord : ∀ i, ∃ d : ℕ, 0 < d ∧ ¬ p ∣ d ∧ f i ^ d = 1 := by
    intro i
    have hord : 0 < orderOf (f i) := (hK (f i)).orderOf_pos
    obtain ⟨a, d, hd, hdecomp⟩ := Nat.exists_eq_pow_mul_and_not_dvd hord.ne' p hp.ne_one
    refine ⟨d, Nat.pos_of_ne_zero ?_, hd, ?_⟩
    · rintro rfl
      rw [mul_zero] at hdecomp
      exact hord.ne' hdecomp
    · have h1 : (f i) ^ (p ^ a * d) = 1 := by rw [← hdecomp]; exact pow_orderOf_eq_one (f i)
      have h2 : ((f i : K) ^ d) ^ (p ^ a) = 1 := by
        rw [← pow_mul, mul_comm, ← Units.val_pow_eq_pow_val, h1, Units.val_one]
      have h3 : ((f i : K) ^ d) = 1 := eq_one_of_pow_prime_pow_eq_one p a _ h2
      exact Units.ext (by rw [Units.val_pow_eq_pow_val, h3, Units.val_one])
  choose d hdpos hdp hdpow using hcoord
  refine ⟨∏ i, d i, Finset.prod_pos fun i _ => hdpos i, ?_, ?_⟩
  · rw [hp.prime.dvd_finsetProd_iff]
    rintro ⟨i, -, hi⟩
    exact hdp i hi
  · funext i
    obtain ⟨c, hc⟩ : d i ∣ ∏ j, d j := Finset.dvd_prod_of_mem d (Finset.mem_univ i)
    rw [Pi.pow_apply, hc, pow_mul, hdpow i, one_pow, Pi.one_apply]

private theorem exists_pos_not_dvd_pow_eq_one_quotient {K : Type*} [Field K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (hK : ∀ u : Kˣ, IsOfFinOrder u) {n : ℕ}
    (z : (Fin n → Kˣ) ⧸ (Pi.constMonoidHom (Fin n) Kˣ).range) :
    ∃ m : ℕ, 0 < m ∧ ¬ p ∣ m ∧ z ^ m = 1 := by
  induction z using QuotientGroup.induction_on with
  | H f =>
    obtain ⟨m, hm, hpm, hf⟩ := exists_pos_not_dvd_pow_eq_one p hK f
    exact ⟨m, hm, hpm, by rw [← QuotientGroup.mk_pow, hf, QuotientGroup.mk_one]⟩

theorem solution
    (p : ℕ) [Fact p.Prime] (𝔛 : DRModelPackage p) (I : 𝔛.LegTwoInput) :
    ∀ (K : Type) [Field K] [CharP K p] [IsAlgClosed K], (∀ u : Kˣ, IsOfFinOrder u) →
