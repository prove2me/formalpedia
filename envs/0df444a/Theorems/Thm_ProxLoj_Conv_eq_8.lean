-- name    : ProxLoj.Conv.eq_8
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T09:37:51.83558+00:00
-- url     : https://prove2.me/theorems/4a77630d-da34-4949-bc39-763fe1cbab26
-- title:
--   (8), proof of Theorem 4, p. 5 — |x^{k+1} − x^k|² / |x^k − x^{k−1}| ≤ M((f(x^k) − ℓ)^{1−θ} − (f(x^{k+1}) − ℓ)^{1−θ}) for k ≥ N₀
-- statement:
--   Throughout, $f:\mathbb R^n\to\mathbb R\cup\{+\infty\}$ is proper and lower semicontinuous, $\partial f$ is the limiting subdifferential, $\operatorname{crit} f=\{x: 0\in\partial f(x)\}$, and $(x^k)_{k\in\mathbb N}$ is generated by the proximal algorithm
--   $$x^{k+1}\in\operatorname{argmin}\Big\{f(u)+\frac{1}{2\lambda_k}|u-x^k|^2 : u\in\mathbb R^n\Big\}\qquad(2)$$
--   from an arbitrary $x^0\in\mathbb R^n$, with step sizes $\lambda_k\in(\lambda_-,\lambda_+)$ for fixed $0<\lambda_-<\lambda_+<+\infty$.
--
--   Assume that $f$ satisfies (H1), (H2), (H3), that $(x^k)$ is bounded, and that $x^{k+1}\ne x^k$ for every $k$. Let $\ell=\inf_{k\ge0}f(x^k)$; by (H1) and properness this is a real number. Then there exist $\theta\in(0,1)$, $M>0$ and an integer $N_0\ge1$ such that
--   $$\frac{|x^{k+1}-x^k|^2}{|x^k-x^{k-1}|}\le M\Big(\big(f(x^k)-\ell\big)^{1-\theta}-\big(f(x^{k+1})-\ell\big)^{1-\theta}\Big)\qquad(8)$$
--   for all $k\ge N_0$.
--
--   This is the key one-step estimate of the convergence proof. On the page $f$ has been replaced by $f-\inf_{k\ge0}f(x^k)$, so $f(x^k)^{1-\theta}$ there is $(f(x^k)-\ell)^{1-\theta}$ here; the page combines (7) with the estimate "$0<|f(x^k)|^\theta\le C|g^k|=\frac{C}{\lambda_k}|x^k-x^{k-1}|$ for all $k\ge N_0$", obtained from Proposition 2 (iii)–(iv) and Lemma 3 with $K=\omega(x_0)$.
--
--   **Formalization Note** The hypothesis $x^{k+1}\ne x^k$ for all $k$ is the proof's own reduction ("we may suppose that $|x^{k+1}-x^k|>0$ for all $k\ge0$"); it belongs to this milestone only, not to Theorem 4. Under it, $f(x^k)$ is finite and $f(x^k)-\ell>0$ for $k\ge1$, so the real powers are of positive numbers; $N_0\ge1$ keeps the index $k-1$ meaningful.
-- source:
--   Attouch & Bolte, On the convergence of the proximal algorithm for nonsmooth functions involving analytic features, author's version hal-00803898v1, p. 5, proof of Theorem 4, display (8) (and the display before it, whose C/λ_k should read C/λ_{k−1})

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonsmoothLojasiewicz_Continuous_slope
import Definitions.Def_ProxLoj_Conv_Setting

open Filter Topology NonconvexSplitting.Shared NonsmoothLojasiewicz.Continuous

namespace ProxLoj.Conv

/-- (8), proof of Theorem 4, p. 5. In the proof's normalisation (`f` shifted by
`ℓ = inf_k f(x^k)`, and `x^{k+1} ≠ x^k` for all `k`) there are `θ ∈ (0, 1)`, `M > 0` and
`N₀ ≥ 1` with `‖x^{k+1} - x^k‖² / ‖x^k - x^{k-1}‖ ≤ M ((f(x^k) - ℓ)^{1-θ} - (f(x^{k+1}) - ℓ)^{1-θ})`
for all `k ≥ N₀`. -/
theorem eq_8 {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → EReal)
    (hproper : IsProper f) (hlsc : LowerSemicontinuous f)
    (hH1 : H1 f) (hH2 : H2 f) (hH3 : HasLojProperty f)
    (lam : ℕ → ℝ) (lamMinus lamPlus : ℝ) (hstep : StepBounds lam lamMinus lamPlus)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hx : IsProxRun f lam x)
    (hbdd : Bornology.IsBounded (Set.range x))
    (hne : ∀ k, x (k + 1) ≠ x k) (ℓ : ℝ) (hℓ : ℓ = (⨅ k, f (x k)).toReal) :
    ∃ θ M : ℝ, ∃ N0 : ℕ, 0 < θ ∧ θ < 1 ∧ 0 < M ∧ 1 ≤ N0 ∧
      ∀ k, N0 ≤ k → ‖x (k + 1) - x k‖ ^ 2 / ‖x k - x (k - 1)‖ ≤
        M * (((f (x k)).toReal - ℓ) ^ (1 - θ) - ((f (x (k + 1))).toReal - ℓ) ^ (1 - θ)) := by sorry

end ProxLoj.Conv
