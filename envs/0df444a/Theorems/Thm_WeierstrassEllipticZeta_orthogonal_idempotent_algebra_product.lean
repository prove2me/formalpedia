-- title:
--   Canonical algebra product from a complete orthogonal idempotent family
-- statement:
--   Let $R$ be a commutative ring, $B$ a commutative $R$-algebra, and $(\varepsilon_i)_{i\in I}$ a finite family satisfying
--   $$
--   \varepsilon_i^2=\varepsilon_i,\qquad
--   \varepsilon_i\varepsilon_j=0\quad(i\ne j),\qquad
--   \sum_i\varepsilon_i=1.
--   $$
--   For each index let $J_i$ be the ideal of $B$ generated by $1-\varepsilon_i$. Then
--   $$
--   a\in J_i\quad\Longleftrightarrow\quad\varepsilon_i a=0.
--   $$
--   There is an $R$-algebra equivalence
--   $$
--   \Phi:B\xrightarrow{\;\sim\;}\prod_{i\in I}B/J_i
--   $$
--   whose $i$th coordinate is the canonical quotient map. In particular,
--   $$
--   \Phi(a)_i=[a]_{J_i},\qquad
--   \Phi(\varepsilon_j)_i=
--   \begin{cases}1&i=j,\\0&i\ne j.\end{cases}
--   $$
--   The result allows zero idempotents and does not require a field, finite-dimensionality or a nonempty index type. If an idempotent is zero, its associated factor is the zero quotient algebra.
-- source:
--   Derived commutative-algebra lemma for the approach associated with Senthil Kumar K (2026), Appendix A and Theorem A.2, https://doi.org/10.1017/S001309152610145X. This lemma is proved here and is not quoted from the article. A finite family of pairwise annihilating idempotents summing to 1 yields an algebra equivalence with the product of quotients by the ideals generated by 1 minus each idempotent. Each ideal is exactly the annihilator of multiplication by that idempotent. The equivalence is the tuple of quotient maps and takes each idempotent to its standard coordinate. Uses Mathlib complete orthogonal idempotents and quotient maps. No new definitions or Prove2Me theorem dependencies.

import Mathlib.RingTheory.Idempotents
import Mathlib.Algebra.Algebra.Pi

open scoped Classical

theorem WeierstrassEllipticZeta.orthogonal_idempotent_algebra_product
    (R B ι : Type*) [CommRing R] [CommRing B] [Algebra R B] [Fintype ι]
    (ε : ι → B) (hidem : ∀ i, IsIdempotentElem (ε i))
    (horth : ∀ i j, i ≠ j → ε i * ε j = 0) (hsum : (∑ i, ε i) = 1) :
    (∀ i a, a ∈ Ideal.span ({1 - ε i} : Set B) ↔ ε i * a = 0) ∧
    ∃ Φ : B ≃ₐ[R] (∀ i, B ⧸ Ideal.span ({1 - ε i} : Set B)),
      (∀ a i, Φ a i = Ideal.Quotient.mk (Ideal.span {1 - ε i}) a) ∧
      ∀ i j, Φ (ε j) i = if i = j then 1 else 0 := by sorry
