theorem NLogN.KFUU.p2St_zero (t : IState HS) (R : List Item) (u cz cr : ℕ) (bs : List Bool) (xs0 : List ℤ)
    (LA LM LB : List Item) :
    p2St t R u cz cr bs xs0 LA LM LB 0 =
      (((t.upd 0 (ints (Dl (mzB u bs.length cz) (bgB bs) (List.range bs.length ++ [bs.length])
        (lay1 (bgB bs) bs.length 0) xs0 0) ++ R)).upd rA (.int 1 :: LA)).upd NLogN.KFUU.rM
        (.int (((2 ^ u) ^ bs.length : ℕ) : ℤ) :: LM)).upd NLogN.KFUU.rB
        (.int ((vol (ctB u cz bs) * cr : ℕ) : ℤ) :: LB) := by sorry
