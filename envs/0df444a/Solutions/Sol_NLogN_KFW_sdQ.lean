    exact ⟨L, by simp [hji, hL]⟩

theorem agree_pushSt' : ∀ (l : List (Fin HS × ℤ)) {σ : Fin HS → Option ℤ} {t : IState HS},
    Agree σ t → Agree (σPush σ l) (pushSt t l)
