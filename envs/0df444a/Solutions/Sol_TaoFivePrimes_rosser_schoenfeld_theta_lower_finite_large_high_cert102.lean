    (Nat.ble (c' * 10995116277760000000000) (C * 10000000000 + A * 7621233844999975600128) ||
      Nat.ble ((c' * 10995116277760000000000 - (C * 10000000000 + A * 7621233844999975600128)) ^ 2)
