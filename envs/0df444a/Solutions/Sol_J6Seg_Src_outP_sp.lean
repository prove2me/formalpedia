theorem free55 : Free 55 := by unfold Free; decide

theorem tbS_upd55 (G : Fin HS → List ℤ) (x43 x44 v : List ℤ) :
    update (tbS G x43 x44) 55 v = tbS (update G 55 v) x43 x44 := by
  rw [tbS, tbS, bS_upd_G _ _ _ _ _ _ _ _ _ _ _ free55]
  simp only [update_of_ne (show (13 : Fin HS) ≠ 55 by decide),
    update_of_ne (show (14 : Fin HS) ≠ 55 by decide), update_of_ne (show (15 : Fin HS) ≠ 55 by decide),
    update_of_ne (show (30 : Fin HS) ≠ 55 by decide), update_of_ne (show (31 : Fin HS) ≠ 55 by decide),
    update_of_ne (show (32 : Fin HS) ≠ 55 by decide), update_of_ne (show (33 : Fin HS) ≠ 55 by decide)]

/-- The table loop with counter `55`. -/
theorem tab_loop55 (s0 : IState HS) (G : Fin HS → List ℤ) {iN : Fin HS} (fN : Free iN)
    (h55 : G 55 = []) {n' A c : ℕ}
    {LN : List ℤ} (hGN : G iN = (n' : ℤ) :: LN) (hnA : n' ≤ 2 ^ A) {b : RS}
    (hw : (55 : Fin HS) ∉ b.writes) (src : ℕ → Option ℕ) (argOf : ℕ → ℤ)
    (hb : ∀ j < n', Sp b (encK s0 (update (tbS G [] (tlT src argOf n' (j + 1) ++ G 44)) 55
        [(j : ℤ) + 1]))
      (encK s0 (update (tbS G [] (tlT src argOf n' j ++ G 44)) 55 [(j : ℤ) + 1])) c) :
    Sp (.rep 55 (.reg iN) b) (encK s0 (tbS G [] (G 44)))
      (encK s0 (tbS G [] (srcTab src argOf n' ++ G 44))) ((n' + 1) * (c + uC A DD)) := by
  have H := repP (C := 55) (i := iN) (b := b) (s0 := s0)
    (F := fun k => tbS G [] (tlT src argOf n' (n' - k) ++ G 44)) (N := n') (A := A) (D := DD) (c := c)
    (by decide) (fun k => by simp only [tbS]; rw [bS_free _ _ _ _ _ _ _ _ _ _ free55]; exact h55)
    hw fN.1 (by simp only [tbS]; rw [bS_free _ _ _ _ _ _ _ _ _ _ fN]; exact hGN)
    hnA (by decide) (fun k hk => by
      obtain ⟨j, hj⟩ : ∃ j, n' - k = j + 1 := ⟨n' - k - 1, by omega⟩
      have e2 : n' - (k + 1) = j := by omega
      have e3 : (n' : ℤ) - k = (j : ℤ) + 1 := by omega
      simp only [hj, e2, e3]
      exact hb j (by omega))
  simpa [tlT_end, tlT_zero] using H

