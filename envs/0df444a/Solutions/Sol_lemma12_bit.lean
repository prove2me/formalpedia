    chain rk (MinL ind (NetScalar.wS j p n)) (labelsOn (NetScalar.wS j p n) (gatesL ind)) (MoutL ind (NetScalar.wS j p n)) =
      (h : ℚ) ^ 3 := by
  rw [gatesL, NetProp7.labelsOn_labelled, NetProp7.names_S, ← card_cube (h := h)]
  have h1 : (ind n.1.1 ∩ ind n.1.2).card = 1 := n.2
  have h2 : (ind n.1.2 ∩ ind n.1.1).card = 1 := by rw [Finset.inter_comm]; exact n.2
  fin_cases j <;>
  simp only [List.map_append, List.map_cons, List.map_nil, List.reverse_cons, List.reverse_nil,
    List.nil_append, List.cons_append, List.singleton_append, chain, labG, MinL, MoutL, NetScalar.wS,
    NetProp7.time, τo, Fin.isValue, Fin.reduceEq, if_true, if_false, Fin.coe_ofNat_eq_mod, Nat.reduceMod,
    Nat.reduceSub, Fin.val_zero, Fin.val_one, Fin.val_two, Fin.zero_eta, Fin.mk_one,
    Fin.reduceFinMk]
  · exact (srel ind hcard 0 p).chainS n.1.1 n.1.2 h1 h2
  · exact (srel ind hcard 1 p).chainS n.1.2 n.1.1 h2 h1
  · exact (srel ind hcard 2 p).chainS n.1.1 n.1.2 h1 h2

/-- **Lemma 6 / Prop. 7 rank sum (general `h`, general card-3 family).** With `v = |𝒯|`,
`z = |Nb|` (ordered neighbour pairs) and `m = h³`:
`Σ_e rank(M_head − M_tail) = v³ m + v³ (m − 1) + 3v² (z m + h (m + 2h))`. -/
theorem frameSum_gatesL :
    frameSum rk (gatesL ind) (MinL ind) (MoutL ind) =
      (Fintype.card T : ℚ) ^ 3 * (h : ℚ) ^ 3 + (Fintype.card T : ℚ) ^ 3 * ((h : ℚ) ^ 3 - 1) +
