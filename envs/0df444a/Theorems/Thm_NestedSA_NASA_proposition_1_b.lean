-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-09T10:40:00.704306+00:00
-- url     : https://prove2.me/theorems/7b5d3c27-b0aa-495f-ab11-149b4acddc83
-- title:
--   Proposition 1(b) — the expected remainders of Lemma 4 sum to at most σ² Σ τ_k²
-- statement:
--   Let $x^k,z^k,u^k$ be generated by Algorithm 1 under Assumptions 1 and 2, with constant $\beta>0$, deterministic stepsizes with $\tau_0=1/a$, $\tau_k\le1$ for all $k$ and $a\tau_k\le1/\sqrt2$ for $k\ge1$, and $\gamma>0$. Then for every $N$ the variables $\|z^{k+1}-z^k\|^2$ and $r^{k+1}$ are integrable and
--   $$\sum_{k=0}^{N-1}\mathbb E\|z^{k+1}-z^k\|^2\le2\Big[\|z^0\|^2+24a^2\sigma_J^2\sigma_s^2\sum_{k=0}^{N-1}\tau_k^2\Big],\qquad \sum_{k=0}^{N-1}\mathbb E\big[r^{k+1}\big]\le\hat\sigma^2\sum_{k=0}^{N-1}\tau_k^2,$$
--   where $r^{k+1}$ is the remainder of Lemma 4 and
--   $$\hat\sigma^2=\tfrac12\Big(\big[aL_{\nabla F}+L_{\nabla\eta}+\gamma L_g^2+2aL_g^2L_{\nabla f}\big]\frac{\max(\sigma_J^2\sigma_s^2,\|z^0\|^2)}{\beta^2}+\gamma b^2\sigma_G^2+4L_{\nabla\eta}\big[\max\big(1,\tfrac{a^2}2\big)\|z^0\|^2+24a^2\sigma_J^2\sigma_s^2\big]\Big).$$
--
--   Combined with Lemma 4, this bounds the expected weighted sum of steps and tracking errors by $W(x^0,z^0,u^0)+\hat\sigma^2\sum\tau_k^2$.
--
--   **Formalization Note** The paper prints (3.25) as infinite sums of conditional expectations; it is stated here in total expectation for every finite horizon, which is the form the proof establishes and the form Theorem 2 uses. The paper prints $\sigma^2$ (3.26) with $L_{\nabla F}$, $\sigma_J^2\sigma_s^2$, $b^2\sigma_g^2$ and $\|z^0\|^2$; its proof establishes the constant $\hat\sigma^2$ above ($aL_{\nabla F}$ from $r^{k+1}$; the $k=0$ term uses $\|d^0\|^2\le\|z^0\|^2/\beta^2$; the factor $\gamma$ is the one missing from (3.18); the term $L_{\nabla\eta}\|z^0\|^2$ coming from the first inequality is absorbed through $\sum_k\tau_k^2\ge\tau_0^2=1/a^2$, which needs the factor $\max(1,a^2/2)$, equal to $1$ when $a\le\sqrt2$, as in part (c)). The hypotheses $\tau_0=1/a$ (from part (a)) and $\tau_k\le1$ are used but not printed.
-- source:
--   Ghadimi, Ruszczyński, Wang, A Single Time-Scale Stochastic Approximation Method for Nested Stochastic Optimization, arXiv:1812.01094v2, p. 12, Proposition 1(b), (3.25)–(3.26)

import Mathlib
import Definitions.Def_SpectralProjGrad_Shared_IsProjOnto
import Definitions.Def_NestedSA_NASA_Basic
import Definitions.Def_NestedSA_NASA_Model

open MeasureTheory ProbabilityTheory

namespace NestedSA.NASA

/-- Proposition 1(b), (3.25) (p. 12), in total expectation over a finite horizon and with the corrected constant
`σ̂²` (`sigmaHatSq`). Let `x, z, u` be generated by Algorithm 1 under Assumptions 1 and 2, with constant
`β_k ≡ β > 0`, deterministic stepsizes with `τ₀ = 1/a`, `τ_k ≤ 1` for all `k` and `aτ_k ≤ 1/√2` for
`k ≥ 1`, and `γ > 0`. Then for every `N`, every `‖z^{k+1} − z^k‖²` and `r^{k+1}` is integrable,
`Σ_{k<N} E‖z^{k+1} − z^k‖² ≤ 2(‖z⁰‖² + 24a²σ_J²σ_s² Σ_{k<N} τ_k²)` and
`Σ_{k<N} E[r^{k+1}] ≤ σ̂² Σ_{k<N} τ_k²`. -/
theorem proposition_1_b {n m : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (ℱ : Filtration ℕ mΩ)
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX_cl : IsClosed X) (hX_cvx : Convex ℝ X)
    (P : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hP : SpectralProjGrad.Shared.IsProjOnto X P)
    (f : EuclideanSpace ℝ (Fin m) → ℝ) (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m))
    (Lf Lg Ldf Ldg : ℝ) (hA2 : Assumption2 f g Lf Lg Ldf Ldg)
    (a b β : ℝ) (τ : ℕ → ℝ) (x0 z0 : EuclideanSpace ℝ (Fin n)) (u0 : EuclideanSpace ℝ (Fin m))
    (x z : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (u G s : ℕ → Ω → EuclideanSpace ℝ (Fin m))
    (J : ℕ → Ω → (EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m)))
    (hrun : IsStochRun X P a b β τ x0 z0 u0 x z u G s J)
    (σG σJ σs : ℝ) (hA1 : Assumption1 μ ℱ f g x z u G s J σG σJ σs)
    (γ : ℝ) (hγ : 0 < γ)
    (hτ_one : ∀ k, τ k ≤ 1) (hτ0 : τ 0 = 1 / a)
    (haτ : ∀ k, 1 ≤ k → a * τ k ≤ 1 / Real.sqrt 2) :
    ∀ N : ℕ,
      (∀ k, Integrable (fun ω => ‖z (k + 1) ω - z k ω‖ ^ 2) μ) ∧
      (∀ k, Integrable (fun ω => rTerm P f g a b γ β Lf Lg Ldf Ldg τ (fun i => x i ω) (fun i => z i ω)
          (fun i => u i ω) (fun i => G i ω) (fun i => s i ω) (fun i => J i ω) k) μ) ∧
      ∑ k ∈ Finset.range N, ∫ ω, ‖z (k + 1) ω - z k ω‖ ^ 2 ∂μ ≤
        2 * (‖z0‖ ^ 2 + 24 * a ^ 2 * σJ ^ 2 * σs ^ 2 * ∑ k ∈ Finset.range N, τ k ^ 2) ∧
      ∑ k ∈ Finset.range N, ∫ ω, rTerm P f g a b γ β Lf Lg Ldf Ldg τ (fun i => x i ω) (fun i => z i ω)
          (fun i => u i ω) (fun i => G i ω) (fun i => s i ω) (fun i => J i ω) k ∂μ ≤
        sigmaHatSq a b γ β Lf Lg Ldf Ldg σG σJ σs z0 * ∑ k ∈ Finset.range N, τ k ^ 2 := by sorry

end NestedSA.NASA
