-- title:
--   Theorem 6(a) — optimal return among π-generated plans
-- statement:
--   Let $\pi$ be a Markov plan, let $U_\pi$ be the supremum of its one-step operators, and let $u^*\in M(S)$ be its fixed point. Then every $\pi$-generated Markov plan $\pi'$ has $I(\pi')\le u^*$ pointwise. For every $\varepsilon>0$ there is a $\pi$-generated measurable rule $f$ with
--
--   $$I(f^{(\infty)})(s)\ge u^*(s)-\varepsilon\qquad(s\in S).$$
--
--   Every measurable rule $f$ satisfying $T_fu^*\ge u^*-\varepsilon(1-\beta)$ has the displayed return bound as well, whether or not $f$ is $\pi$-generated.
--
--   This identifies the fixed point as the optimal return for the generated comparison class.
--
--   **Formalization Note** Existence and uniqueness of the fixed point follow from Theorem 5; this item states the result for that fixed point, characterized by $U_\pi u^*=u^*$ and $u^*\in M(S)$. The last clause does not impose generatedness on $f$.
-- source:
--   Blackwell, Discounted Dynamic Programming, Ann. Math. Statist. 36 (1965), p. 232 (PDF 7), Theorem 6(a)

import Mathlib
import Definitions.Def_DiscountedDP_Stationary_Operators

namespace DiscountedDP.Stationary

open MeasureTheory ProbabilityTheory

/-- Blackwell (1965), Theorem 6(a), p. 232. The fixed point exists and is
unique by Theorem 5. The last clause applies to every measurable rule,
including rules not generated by `π`. -/
theorem theorem6a_generated_optimal
    {S A : Type*} [MeasurableSpace S] [StandardBorelSpace S] [Nonempty S]
    [MeasurableSpace A] [StandardBorelSpace A] [Nonempty A]
    (P : Problem S A) (π : MarkovPlan S A) (ustar : S → ℝ)
    (hu : IsBM ustar) (hfix : ∀ s, U P π ustar s = ustar s) :
    (∀ π' : MarkovPlan S A, IsGeneratedPlan π π' →
      ∀ s, I P π'.toPlan s ≤ ustar s) ∧
    (∀ ε : ℝ, 0 < ε → ∃ f : {g : S → A // Measurable g},
      IsGenerated π f ∧ ∀ s,
        ustar s - ε ≤ I P (stationary f).toPlan s) ∧
    (∀ ε : ℝ, 0 < ε → ∀ f : {g : S → A // Measurable g},
      (∀ s, ustar s - ε * (1 - P.β) ≤ T P f ustar s) →
      ∀ s, ustar s - ε ≤ I P (stationary f).toPlan s) := by sorry

end DiscountedDP.Stationary
