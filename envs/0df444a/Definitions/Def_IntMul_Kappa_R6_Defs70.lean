-- Source module: Solutions.R6SNeed
/-!
# Round-six setup, part 9: `SetupNeed6`

The procedure is `startP` (frozen: `n` and `b = lg n`), the compiled register program `setRS`,
and `oP` (frozen: `2^{2n}` on `rO`). Its cost is `O(n) + cSet · kU`; the second term is
`O(d r² p²) ≤ T p` for large `n` (since `T ≥ r³/4` once `d ≥ 3`, and `r = 2^ℓ` beats every fixed
power of `b`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFM RS Finset Function

noncomputable section

/-- The constant of the main cost term. -/
def KcS (P : Prm) (a c : ℕ) : ℕ := 4 * 10 ^ 10 * (a + c + P.x + 1) * DgS P a c ^ 2

/-- The setup procedure. -/
def setupI (a c X : ℕ) : IStmt HS 8 := .seq startP (.seq (setRS a c X).code oP)

end

end IntMul.Kappa.R6

end

