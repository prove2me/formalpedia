import Definitions.Def_FourColor_CompactCatalogue

namespace FourColor
theorem catalogue_reducibility_certificates :
  ∀ C ∈ CompactCatalogue.configurations,
    ∃ certificate : C.ReducibilityCertificate, C.checkReducibility certificate = true := by sorry
end FourColor
