-- title:
--   Vélu quotient j-invariant is a root of Φ₂ₙ₊₁(j(W), · )
-- statement:
--   Let $F$ be an algebraically closed field of characteristic zero and let $W$ be a Weierstrass curve over $F$ which is elliptic (its discriminant is a unit). Let $n$ be a natural number and $Q$ a point of the associated affine curve whose additive order is exactly $2n+1$. Form the finite set $S \subseteq F \times F$ of the coordinate pairs of the multiples $k \cdot Q$ for $1 \le k \le n$ (the zero point contributing $(0,0)$), and let $W' =$ `W.veluQuotient S` be the Weierstrass curve with the same $a_1, a_2, a_3$ as $W$ and with $a_4' = a_4 - 5\sum_{P \in S} t(P)$, $a_6' = a_6 - b_2 \sum_{P \in S} t(P) - 7\sum_{P \in S} w(P)$, where $t$ and $w$ are Vélu's local quantities. Assume the discriminant of $W'$ is nonzero, so that $W'$ is again elliptic. Finally let `data` be a modular-polynomial datum of level $2n+1$: a polynomial $\Phi \in \mathbb{Z}[X][Y]$, monic in $Y$, of degree in $Y$ equal to $\sum_{d \mid 2n+1,\ d \text{ squarefree}} (2n+1)/d$, and satisfying $\Phi(j(q), j(q^{2n+1})) = 0$ as a Laurent series over $\mathbb{Q}$. Then, specialising the coefficients of $\Phi$ by evaluating the $X$-variable at $j(W) \in F$ via $\mathbb{Z} \to F$, the resulting polynomial in $F[Y]$ has $j(W')$ as a root, i.e. $\Phi(j(W), j(W')) = 0$.
--
--   This is the forward half of the splitting of the modular polynomial in the level $2n+1$ cyclic-isogeny case: the $j$-invariant of the Vélu quotient of $W$ by the cyclic group generated by an odd-order point satisfies the level $2n+1$ modular equation with $j(W)$. It is used in the study of the specialised polynomial $\Phi(j(W), Y)$, in particular its separability, and in the construction of reductions of elliptic curves with prescribed isogeny behaviour.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_ModularPolynomialData_isRoot_map_j_veluQuotient_j_of_addOrderOf_eq_of_isAlgClosed.lean

import Mathlib
import Definitions.Def_ModularCurve_X0
import Definitions.Def_WeierstrassCurve_Velu
import Definitions.Def_WeierstrassCurve_OddOrderSummingSet

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open WeierstrassCurve WeierstrassCurve.Affine

theorem ModularCurve.ModularPolynomialData.isRoot_map_j_veluQuotient_j_of_addOrderOf_eq_of_isAlgClosed
    {F : Type*} [Field F] [DecidableEq F] [CharZero F] [IsAlgClosed F]
    (W : WeierstrassCurve F) [W.IsElliptic]
    (n : ℕ) (Q : W.toAffine.Point) (hQ : addOrderOf Q = 2 * n + 1)
    (hΔ : (W.veluQuotient (W.oddOrderSummingSet Q n)).Δ ≠ 0)
    (data : ModularCurve.ModularPolynomialData (2 * n + 1)) :
    haveI : (W.veluQuotient (W.oddOrderSummingSet Q n)).IsElliptic := ⟨isUnit_iff_ne_zero.mpr hΔ⟩
    (data.Φ.map (Polynomial.eval₂RingHom (Int.castRingHom F) W.j)).IsRoot
      (W.veluQuotient (W.oddOrderSummingSet Q n)).j := by sorry
