theorem J6A.fp_of_sexact (p s t α : ℕ) [NeZero s] [NeZero t] (hα : 2 ≤ α) (hαp : α ^ 2 ≤ p)
    (Aa : (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ)) (E₁ : ℝ)
    (hAa : ∀ U, InDisc p U → ∀ k,
      ‖gC (Aa U k) - 2 ^ p * Sexact s t α (fun i => gC (U i) / 2 ^ p) k‖ ≤ E₁)
    (L : (ZMod s → ℂ) →L[ℂ] (ZMod t → ℂ))
    (hL : ∀ U, InDisc p U → ∀ k : ZMod t,
      ‖gC (Sapprox p s t α U k.val) - 2 ^ p * L (fun j => gC (U j.val) / 2 ^ p) k‖
        ≤ 6 * sWidth p α + 4)
    (hE : 0.55 * 2 ^ p + E₁ ≤ 2 ^ p) :
    FPApprox p Aa (NLogN.KFM.liftL L) (E₁ + 12 * sWidth p α + 8) := by sorry
