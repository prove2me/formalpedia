variable (F : Type) [Field F] [NumberField F]

local notation "𝔸" => AdeleRing (𝓞 F) F

private def zeroAt (w : InfinitePlace F) (a : 𝔸) : 𝔸 := toAdele' F (Function.update a.1 w 0) a.2

private theorem zeroAt_fst_of_ne {w : InfinitePlace F} (a : 𝔸) {v : InfinitePlace F} (hvw : v ≠ w) :
    (zeroAt F w a).1 v = a.1 v := by
  show Function.update a.1 w 0 v = a.1 v
  rw [Function.update_of_ne hvw]

private theorem zeroAt_fst_self (w : InfinitePlace F) (a : 𝔸) : (zeroAt F w a).1 w = 0 := by
  show Function.update a.1 w 0 w = 0
  rw [Function.update_self]

private theorem zeroAt_snd (w : InfinitePlace F) (a : 𝔸) : (zeroAt F w a).2 = a.2 := rfl

private theorem Dy_eq_max_mul_Dy_of_agree (w : InfinitePlace F) {x x' : 𝔸}
    (h1 : ∀ v, v ≠ w → x'.1 v = x.1 v) (hw0 : x'.1 w = 0) (h2 : x'.2 = x.2) :
    Dy F x = max 1 ‖x.1 w‖ ^ w.mult * Dy F x' := by
  have hx : (∏ v, max 1 ‖x.1 v‖ ^ v.mult)
      = max 1 ‖x.1 w‖ ^ w.mult * ∏ v ∈ Finset.univ.erase w, max 1 ‖x.1 v‖ ^ v.mult :=
    (Finset.mul_prod_erase _ _ (Finset.mem_univ w)).symm
  have hx' : (∏ v, max 1 ‖x'.1 v‖ ^ v.mult)
      = max 1 ‖x'.1 w‖ ^ w.mult * ∏ v ∈ Finset.univ.erase w, max 1 ‖x'.1 v‖ ^ v.mult :=
    (Finset.mul_prod_erase _ _ (Finset.mem_univ w)).symm
  have hcongr : ∏ v ∈ Finset.univ.erase w, max 1 ‖x'.1 v‖ ^ v.mult
      = ∏ v ∈ Finset.univ.erase w, max 1 ‖x.1 v‖ ^ v.mult :=
    Finset.prod_congr rfl fun v hv => by rw [h1 v (Finset.ne_of_mem_erase hv)]
  rw [Dy_eq_prod_mul_relIndex, Dy_eq_prod_mul_relIndex, dilate_finPart_of_snd_eq F x x' h2, hx, hx', hcongr, hw0, norm_zero,
    max_eq_left (zero_le_one' ℝ), one_pow, one_mul]
  ring

