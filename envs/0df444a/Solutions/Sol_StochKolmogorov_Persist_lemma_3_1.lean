    (C : Coeffs n) (B : ℝ≥0 → Ω → SDEState n) (hB : IsStandardBrownian P B)
    (c : SDEState n) (γb : ℝ) (hA : Assumption11 C c γb) {x : SDEState n} (hx : x ∈ orthant n) :
