      simp only [Option.toList_some, hd, List.get_eq_getElem]
      congr 2
      try omega
    have hdd := hdig d (List.get_mem _ _)
    have hkp := kpack_nonneg b (dl.drop (dl.length - k))
      (fun x hx => (hdig x (List.mem_of_mem_drop hx)).1)
    have hApos : 0 < kpack (2 ^ b) (dl.drop (dl.length - k)) + (y + 1) * 2 ^ (b * k) := by
      have : (0 : ℤ) < (y + 1) * 2 ^ (b * k) := by positivity
      omega
    simp only [asmBody, RM.run, withCtr, c2St]
    rw [htk]
    simp (config := {decide := true}) only [IOp.run, IState.upd_G, if_true, if_false,
      List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append, ints,
      List.map_append, List.map_cons, List.map_nil, List.singleton_append, List.cons_append, hR,
      rulerExp_two_pow]
    generalize hA : kpack (2 ^ b) (dl.drop (dl.length - k)) + (y + 1) * 2 ^ (b * k) = A at *
    have e1 : ¬ (A = 0 ∨ d < 0 ∨ 2 ^ b ≤ d) := by omega
    simp only [false_or, e1, if_false, Int.toNat_of_nonneg hdd.1]
    have ea : sg A (A.natAbs * 2 ^ b + d.toNat) = A * 2 ^ b + d := by
      unfold sg; rw [if_neg (by omega)]; push_cast
      rw [abs_of_pos hApos, Int.toNat_of_nonneg hdd.1]
    simp only [ea, hdr]
    have eA : A * 2 ^ b + d = kpack (2 ^ b) (d :: dl.drop (dl.length - k)) +
        (y + 1) * 2 ^ (b * (k + 1)) := by
      simp only [kpack, ← hA]; rw [show b * (k + 1) = b * k + b by ring, pow_add]; ring
    have eP : (2 : ℤ) ^ (b * k) * 2 ^ b = 2 ^ (b * (k + 1)) := by
      rw [show b * (k + 1) = b * k + b by ring, pow_add]
    rw [eA]
    simp (config := {decide := true}) only [IState.upd_G, if_true, if_false, hR, rulerExp_two_pow,
      eP]
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all (config := {decide := true})

theorem carryP_run (s : IState HS) (b : ℕ) (c : List ℤ) (y0 : ℤ) (RA LY LR LM : List Item)
    (hA : s.G CA = ints c ++ RA) (hY : s.G CY = .int y0 :: LY) (hR : s.G CR = .int (2 ^ b) :: LR)
    (hM : s.G CM = .int c.length :: LM) (hy0 : 0 ≤ y0) (hc : ∀ x ∈ c, 0 ≤ x) :
    carryP.run s = (s.upd CA RA).upd CY (.int (kpack (2 ^ b) c + y0) :: LY) := by
  rw [carryP, RM.run_seq, carry1_run s b c y0 RA LY LR LM hA hY hR hM hy0 hc]
  set dl := (carryL b c y0).1 with hdl
  set yM := (carryL b c y0).2 with hyM
  have hlen : dl.length = c.length := carryL_length b c y0
  have hyM0 : 0 ≤ yM := carryL_carry_nonneg b c y0 hy0 hc
  set s1 := ((s.upd CA RA).upd CY (.int yM :: LY)).upd CD (ints dl.reverse ++ s.G CD) with hs1
  have hR1 : s1.G CR = .int (2 ^ b) :: LR := by
    simp (config := {decide := true}) [hs1, IState.upd_G, hR]
  have hM1 : s1.G CM = .int dl.length :: LM := by
    simp (config := {decide := true}) [hs1, IState.upd_G, hM, hlen]
  have e0 : (RS.seq (.asg CY (.add (.reg CY) (.lit 1))) (.push CP (.lit 1))).run s1 =
      c2St s1 b dl yM LY (s.G CD) (s.G CP) 0 := by
    simp only [c2St, Nat.sub_zero, List.drop_length, List.take_length, mul_zero, pow_zero]
    apply IState.ext' <;> intros <;>
      simp (config := {decide := true}) only [RS.run, IState.upd_G, IState.upd_ip,
        IState.upd_out, Ex.eval, IState.top, hs1] <;>
      split_ifs <;> simp_all (config := {decide := true}) [kpack]
  have hst := asm_states s1 b dl yM LY (s.G CD) (s.G CP) LR LM (carryL_digits b c y0) hyM0 hR1 hM1
  simp only [carry2, RM.run_seq, RM.run_rs]
  rw [e0, hst.run]
  have hN : (Ex.eval (c2St s1 b dl yM LY (s.G CD) (s.G CP) 0) (Ex.reg CM)).toNat = dl.length := by
    simp (config := {decide := true}) [Ex.eval, IState.top, hM1, c2St, IState.upd_G]
  rw [hN]
  have hv := carryL_val b c y0
  rw [← hdl, ← hyM, ← hlen] at hv
  simp only [c2St, Nat.sub_self, List.drop_zero, List.take_zero, List.reverse_nil, ints_nil,
    List.nil_append]
  apply IState.ext' <;> intros <;>
    simp (config := {decide := true}) only [RS.run, IState.upd_G, IState.upd_ip,
      IState.upd_out, Ex.eval, IState.top, hs1, List.tail_cons] <;>
    split_ifs <;> simp_all (config := {decide := true}) <;> linarith

end NLogN

end

section
-- Source module: NLogN.HListOps
set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

theorem mvList_states (i j c : Fin HS) (n : Ex HS) (s : IState HS) (l : List ℤ) (Ri : List Item)
    (hij : i ≠ j) (hci : c ≠ i) (hcj : c ≠ j) (hi : s.G i = ints l ++ Ri)
    (hn : n.eval s = l.length) :
    RepStates c n (mvBody i j) s (mvSt i j s l Ri) where
  nonneg := by rw [hn]; omega
  hw := by simp [mvBody, RS.writes, hci, hcj]
  h0 := by
    simp only [mvSt, List.drop_zero, List.take_zero, List.reverse_nil, ints_nil, List.nil_append]
    rw [← hi]; simp
  hG := fun k => by simp [mvSt, IState.upd_G, hci, hcj]
  step := fun k hk => by
    have hk' : k < l.length := by rw [hn] at hk; simpa using hk
    obtain ⟨x, rest, hd⟩ : ∃ x rest, l.drop k = x :: rest := ⟨_, _, List.drop_eq_getElem_cons hk'⟩
    have hd2 : l.drop (k + 1) = rest := by
      rw [← List.drop_drop, hd]; rfl
    have ht : l.take (k + 1) = l.take k ++ [x] := by
      rw [List.take_add_one, List.getElem?_eq_getElem hk']
      have : l[k] = x := by
        have := congrArg List.head? hd
        rw [List.head?_drop, List.getElem?_eq_getElem hk'] at this
        simpa using this
      simp [this]
    simp only [mvBody, RS.run, withCtr, mvSt]
    apply IState.ext' <;> intros <;>
      simp only [IState.upd_G, IState.upd_ip, IState.upd_out, Ex.eval, IState.top, hd, hd2, ht,
        ints_cons, List.cons_append, List.reverse_append, List.reverse_cons, List.reverse_nil,
        List.nil_append, List.singleton_append, ints, List.map_cons, List.map_append] <;>
      split_ifs <;> simp_all [ints]

theorem mvList_run (i j c : Fin HS) (n : Ex HS) (s : IState HS) (l : List ℤ) (Ri : List Item)
    (hij : i ≠ j) (hci : c ≠ i) (hcj : c ≠ j) (hi : s.G i = ints l ++ Ri)
    (hn : n.eval s = l.length) :
    (mvList i j c n).run s = (s.upd i Ri).upd j (ints l.reverse ++ s.G j) := by
  rw [mvList, (mvList_states i j c n s l Ri hij hci hcj hi hn).run]
  have : (n.eval s).toNat = l.length := by rw [hn]; simp
  rw [this]; simp [mvSt]

end NLogN

end

section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul IntMul.HvdH IntMul.HvdH.Ref
theorem solution (Ei X : Fin HS) (s : IState HS) (b : ℕ) (L : List ℤ) (Ri LR LM : List Item)
    (hEi : s.G Ei = ints L.reverse ++ Ri) (hR : s.G CR = .int (2 ^ b) :: LR)
    (hM : s.G CM = .int L.length :: LM) (hL : ∀ x ∈ L, 0 ≤ x)
    (h1 : Ei ≠ CA) (h2 : Ei ≠ CY) (h3 : Ei ≠ CR) (h4 : Ei ≠ CM) (h5 : Ei ≠ EC) (h6 : Ei ≠ X)
    (h7 : X ≠ CA) (h8 : X ≠ CY) (h9 : X ≠ CR) (h10 : X ≠ CM) (h11 : X ≠ EC) :
    (packOne Ei X).run s = (s.upd Ei Ri).upd X (.int (kpack (2 ^ b) L) :: s.G X) := by
  simp only [NLogN.packOne, NLogN.RM.seqL, NLogN.RM.run_seq, NLogN.RM.run_rs]
  rw [NLogN.mvList_run Ei NLogN.CA NLogN.EC (.reg NLogN.CM) s L.reverse Ri h1 h5.symm (by decide) hEi
    (by simp [NLogN.Ex.eval, NLogN.IState.top, hM])]
  rw [List.reverse_reverse]
  set s1 := ((s.upd Ei Ri).upd NLogN.CA (NLogN.ints L ++ s.G NLogN.CA)) with hs1
  set s2 := (NLogN.RS.push NLogN.CY (.lit 0)).run s1 with hs2
  have e2 : s2.G NLogN.CA = NLogN.ints L ++ s.G CA := by
    simp (config := {decide := true}) [hs2, hs1, NLogN.RS.run, NLogN.IState.upd_G, h1, h1.symm]
  have eY : s2.G NLogN.CY = .int 0 :: s.G CY := by
    simp (config := {decide := true}) [hs2, hs1, NLogN.RS.run, NLogN.IState.upd_G, h2, h2.symm, NLogN.Ex.eval]
  have eR : s2.G NLogN.CR = .int (2 ^ b) :: LR := by
    simp (config := {decide := true}) [hs2, hs1, NLogN.RS.run, NLogN.IState.upd_G, h3, h3.symm, hR]
  have eM : s2.G NLogN.CM = .int L.length :: LM := by
    simp (config := {decide := true}) [hs2, hs1, NLogN.RS.run, NLogN.IState.upd_G, h4, h4.symm, hM]
  rw [NLogN.carryP_run s2 b L 0 (s.G NLogN.CA) (s.G NLogN.CY) LR LM e2 eY eR eM le_rfl hL]
  apply NLogN.IState.ext' _ (by simp [hs2, hs1, NLogN.RS.run]) (by simp [hs2, hs1, NLogN.RS.run])
  intro x
  have := h1.symm; have := h2.symm; have := h3.symm; have := h4.symm; have := h5.symm
  have := h6.symm; have := h7.symm; have := h8.symm; have := h9.symm; have := h10.symm
  have := h11.symm
  simp only [NLogN.RS.run, NLogN.IState.upd_G, NLogN.Ex.eval, NLogN.IState.top, add_zero, List.tail_cons]
  by_cases a1 : x = Ei <;> by_cases a2 : x = X <;> by_cases a3 : x = NLogN.CY <;> by_cases a4 : x = NLogN.CA <;>
    simp_all (config := {decide := true}) [hs2, hs1, NLogN.RS.run, NLogN.IState.upd_G]
end
