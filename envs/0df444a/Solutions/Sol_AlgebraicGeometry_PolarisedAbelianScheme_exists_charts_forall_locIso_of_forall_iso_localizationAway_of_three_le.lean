open CategoryTheory CategoryTheory.Limits AlgebraicGeometry NeronModelInfra GoodReductionJacobian
open scoped TensorProduct
open AlgebraicGeometry.Polarisation

namespace G2ChartData

variable {g d n : ℕ} (S : Type) [CommRing S] {k : ℕ} (r : Fin k → S)
  (B : Fin k → Type) [∀ i, CommRing (B i)] [∀ i, Algebra S (B i)] [∀ i, IsLocalization.Away (r i) (B i)]
  (u : ∀ i, PolarisedAbelianScheme g d n (B i))

abbrev C (i j : Fin k) : Type := B i ⊗[S] B j

scoped instance isLocalizationAway_C (i j : Fin k) : IsLocalization.Away (r i * r j) (C S B i j) :=
  IsLocalization.Away.mul' (B i) (B i ⊗[S] B j) (r i) (r j)

abbrev ρ₁ (i j : Fin k) : B i →ₐ[S] C S B i j := Algebra.TensorProduct.includeLeft
abbrev ρ₂ (i j : Fin k) : B j →ₐ[S] C S B i j := Algebra.TensorProduct.includeRight

theorem ρ₁_toRingHom (i j : Fin k) : (ρ₁ S B i j).toRingHom = algebraMap (B i) (C S B i j) := RingHom.ext fun _ => rfl

include r in
theorem isOpenImmersion_specρ₁ (i j : Fin k) : IsOpenImmersion (Spec.map (CommRingCat.ofHom (ρ₁ S B i j).toRingHom)) := by
  rw [ρ₁_toRingHom]
  exact IsOpenImmersion.of_isLocalization (algebraMap S (B i) (r j))

noncomputable def v₁ (i j : Fin k) : PolarisedAbelianScheme g d n (C S B i j) :=
  (AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback (ρ₁ S B i j).toRingHom (u i)).choose

theorem hv₁ (i j : Fin k) : PolarisedAbelianScheme.IsPullback (ρ₁ S B i j).toRingHom (u i) (v₁ S B u i j) :=
  (AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback (ρ₁ S B i j).toRingHom (u i)).choose_spec

noncomputable def v₂ (i j : Fin k) : PolarisedAbelianScheme g d n (C S B i j) :=
  (AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback (ρ₂ S B i j).toRingHom (u j)).choose

theorem hv₂ (i j : Fin k) : PolarisedAbelianScheme.IsPullback (ρ₂ S B i j).toRingHom (u j) (v₂ S B u i j) :=
  (AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback (ρ₂ S B i j).toRingHom (u j)).choose_spec

noncomputable def gA₁ (i j : Fin k) : (v₁ S B u i j).A ⟶ (u i).A := (hv₁ S B u i j).choose
noncomputable def gA₂ (i j : Fin k) : (v₂ S B u i j).A ⟶ (u j).A := (hv₂ S B u i j).choose

theorem gA₁_isPullback (i j : Fin k) :
    IsPullback (gA₁ S B u i j) (v₁ S B u i j).f (u i).f (Spec.map (CommRingCat.ofHom (ρ₁ S B i j).toRingHom)) :=
  (hv₁ S B u i j).choose_spec.choose

theorem gA₂_isPullback (i j : Fin k) :
    IsPullback (gA₂ S B u i j) (v₂ S B u i j).f (u j).f (Spec.map (CommRingCat.ofHom (ρ₂ S B i j).toRingHom)) :=
  (hv₂ S B u i j).choose_spec.choose

include r in
theorem isOpenImmersion_gA₁ (i j : Fin k) : IsOpenImmersion (gA₁ S B u i j) :=
  MorphismProperty.of_isPullback (P := @IsOpenImmersion) (gA₁_isPullback S B u i j).flip (isOpenImmersion_specρ₁ S r B i j)

noncomputable abbrev alg (i : Fin k) : Spec (CommRingCat.of (B i)) ⟶ Spec (CommRingCat.of S) :=
  Spec.map (CommRingCat.ofHom (algebraMap S (B i)))

noncomputable abbrev p (i : Fin k) : (u i).A ⟶ Spec (CommRingCat.of S) := (u i).f ≫ alg S B i

noncomputable abbrev V (i j : Fin k) : (u i).A.Opens := (p S B u i) ⁻¹ᵁ PrimeSpectrum.basicOpen (r j)

theorem range_eq_preimage_of_isPullback {P X Y Z : Scheme.{0}} {c : P ⟶ X} {f' : P ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
    (h : IsPullback c f' f g) : Set.range c.base = f.base ⁻¹' Set.range g.base := by
  ext x
  constructor
  · rintro ⟨z, rfl⟩
    refine ⟨f'.base z, ?_⟩
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, h.w]
  · intro hx
    have hx' : x ∈ Set.range (pullback.fst f g).base := by rw [Scheme.Pullback.range_fst]; exact hx
    obtain ⟨z, hz⟩ := hx'
    refine ⟨h.isoPullback.inv.base z, ?_⟩
    rw [← Scheme.Hom.comp_apply, h.isoPullback_inv_fst]; exact hz

include r in
theorem mem_range_gA₁_iff (i j : Fin k) (x : ↥(u i).A) :
    x ∈ Set.range (gA₁ S B u i j).base ↔ x ∈ V S r B u i j := by
  rw [range_eq_preimage_of_isPullback (gA₁_isPullback S B u i j), Set.mem_preimage]
  have hR : Set.range (PrimeSpectrum.comap (algebraMap (B i) (C S B i j))) = _ :=
    PrimeSpectrum.localization_away_comap_range (C S B i j) (algebraMap S (B i) (r j))
  have h1 : (u i).f.base x ∈ Set.range (Spec.map (CommRingCat.ofHom (ρ₁ S B i j).toRingHom)).base ↔
      (u i).f.base x ∈ Set.range (PrimeSpectrum.comap (algebraMap (B i) (C S B i j))) := by
    rw [ρ₁_toRingHom]; exact Iff.rfl
  rw [h1, hR]
  show algebraMap S (B i) (r j) ∉ ((u i).f.base x).asIdeal ↔ r j ∉ (((u i).f ≫ alg S B i).base x).asIdeal
  exact Iff.rfl

include r in
theorem range_gA₁ (i j : Fin k) : Set.range (gA₁ S B u i j).base = ((V S r B u i j : (u i).A.Opens) : Set ↥(u i).A) :=
  Set.ext (mem_range_gA₁_iff S r B u i j)

noncomputable def θ (i j : Fin k) : ((V S r B u i j : (u i).A.Opens) : Scheme.{0}) ≅ (v₁ S B u i j).A :=
  haveI := isOpenImmersion_gA₁ S r B u i j
  IsOpenImmersion.isoOfRangeEq (V S r B u i j).ι (gA₁ S B u i j) (by rw [Scheme.Opens.range_ι, range_gA₁ S r B u i j])

theorem θ_hom_gA₁ (i j : Fin k) : (θ S r B u i j).hom ≫ gA₁ S B u i j = (V S r B u i j).ι := by
  haveI := isOpenImmersion_gA₁ S r B u i j
  exact IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _

variable (hover : ∀ (i j : Fin k) (C : Type) [CommRing C] [Algebra S C] [IsLocalization.Away (r i * r j) C]
    (ρ₁ : B i →ₐ[S] C) (ρ₂ : B j →ₐ[S] C) (v₁ v₂ : PolarisedAbelianScheme g d n C),
    PolarisedAbelianScheme.IsPullback ρ₁.toRingHom (u i) v₁ →
    PolarisedAbelianScheme.IsPullback ρ₂.toRingHom (u j) v₂ →
    PolarisedAbelianScheme.Iso v₁ v₂)

include hover in
theorem iso_v (i j : Fin k) : PolarisedAbelianScheme.Iso (v₁ S B u i j) (v₂ S B u i j) :=
  hover i j (C S B i j) (ρ₁ S B i j) (ρ₂ S B i j) _ _ (hv₁ S B u i j) (hv₂ S B u i j)

noncomputable def e (i j : Fin k) : (v₁ S B u i j).A ≅ (v₂ S B u i j).A := (iso_v S r B u hover i j).choose

theorem e_over (i j : Fin k) : (e S r B u hover i j).hom ≫ (v₂ S B u i j).f = (v₁ S B u i j).f :=
  (iso_v S r B u hover i j).choose_spec.choose

noncomputable def t (i j : Fin k) : ((V S r B u i j : (u i).A.Opens) : Scheme.{0}) ⟶ (u j).A :=
  (θ S r B u i j).hom ≫ (e S r B u hover i j).hom ≫ gA₂ S B u i j

theorem specρ₁_alg (i j : Fin k) : Spec.map (CommRingCat.ofHom (ρ₁ S B i j).toRingHom) ≫ alg S B i =
    Spec.map (CommRingCat.ofHom (algebraMap S (C S B i j))) := by
  have h : (ρ₁ S B i j).toRingHom.comp (algebraMap S (B i)) = algebraMap S (C S B i j) := RingHom.ext fun x => (ρ₁ S B i j).commutes x
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]

theorem specρ₂_alg (i j : Fin k) : Spec.map (CommRingCat.ofHom (ρ₂ S B i j).toRingHom) ≫ alg S B j =
    Spec.map (CommRingCat.ofHom (algebraMap S (C S B i j))) := by
  have h : (ρ₂ S B i j).toRingHom.comp (algebraMap S (B j)) = algebraMap S (C S B i j) := RingHom.ext fun x => (ρ₂ S B i j).commutes x
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]

theorem t_over (i j : Fin k) : t S r B u hover i j ≫ p S B u j = (V S r B u i j).ι ≫ p S B u i := by
  simp only [t, Category.assoc]
  rw [← Category.assoc (gA₂ S B u i j), (gA₂_isPullback S B u i j).w, Category.assoc, specρ₂_alg,
    ← Category.assoc (e S r B u hover i j).hom, e_over,
    ← θ_hom_gA₁ S r B u i j, Category.assoc, ← Category.assoc (gA₁ S B u i j), (gA₁_isPullback S B u i j).w,
    Category.assoc, specρ₁_alg]

theorem mul_val_congr' {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f)
    {T₀ : Scheme.{0}} {t₁ t₂ : T₀ ⟶ Spec (CommRingCat.of R)} (h : t₁ = t₂)
    (x₁ y₁ : SchemeHomOver t₁ f) (x₂ y₂ : SchemeHomOver t₂ f) (hx : x₁.1 = x₂.1) (hy : y₁.1 = y₂.1) :
    (L.mul t₁ x₁ y₁).1 = (L.mul t₂ x₂ y₂).1 := by
  subst h; cases Subtype.ext hx; cases Subtype.ext hy; rfl

section Comp

variable {R T : Type} [CommRing R] [CommRing T] {φ : R →+* T}
  {X : PolarisedAbelianScheme g d n R} {X' X'' : PolarisedAbelianScheme g d n T}
  (gA : X''.A ⟶ X.A) (hpb : IsPullback gA X''.f X.f (Spec.map (CommRingCat.ofHom φ)))
  (hmul : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of T)) (x y : SchemeHomOver t' X''.f),
      (X''.L.mul t' x y).1 ≫ gA =
        (X.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
          ⟨x.1 ≫ gA, by rw [Category.assoc, hpb.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ gA, by rw [Category.assoc, hpb.w, ← Category.assoc, y.2]⟩).1)
  (hP : ∀ i, (X''.P i).1 ≫ gA = Spec.map (CommRingCat.ofHom φ) ≫ (X.P i).1)
  (hpol : Nonempty ((Scheme.Modules.pullback gA).obj X.pol ≅ X''.pol))
  (e : X'.A ≅ X''.A) (he : e.hom ≫ X''.f = X'.f)
  (hemul : ∀ {T₀ : Scheme.{0}} (t : T₀ ⟶ Spec (CommRingCat.of T)) (x y : SchemeHomOver t X'.f),
      (X'.L.mul t x y).1 ≫ e.hom =
        (X''.L.mul t ⟨x.1 ≫ e.hom, by rw [Category.assoc, he]; exact x.2⟩
          ⟨y.1 ≫ e.hom, by rw [Category.assoc, he]; exact y.2⟩).1)
  (helev : ∀ i, (X'.P i).1 ≫ e.hom = (X''.P i).1)
  (hepol : ∀ s : ↥(Spec (CommRingCat.of T)), ∃ U : (Spec (CommRingCat.of T)).Opens, s ∈ U ∧
      Nonempty ((Scheme.Modules.pullback (X'.f ⁻¹ᵁ U).ι).obj ((Scheme.Modules.pullback e.hom).obj X''.pol) ≅
        (Scheme.Modules.pullback (X'.f ⁻¹ᵁ U).ι).obj X'.pol))

omit hmul hP hpol hemul helev hepol in
include hpb he in
theorem comp_isPullback : IsPullback (e.hom ≫ gA) X'.f X.f (Spec.map (CommRingCat.ofHom φ)) := by
  have sq : IsPullback e.hom X'.f X''.f (𝟙 _) := IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id, he]⟩
  simpa using sq.paste_horiz hpb

theorem mul_val_congr (L : RelativeGroupLaw R X.f) {T₀ : Scheme.{0}} (t : T₀ ⟶ Spec (CommRingCat.of R))
    {P P' Q Q' : SchemeHomOver t X.f} (h₁ : P = P') (h₂ : Q = Q') : (L.mul t P Q).1 = (L.mul t P' Q').1 := by
  subst h₁ h₂; rfl

omit hP hpol helev hepol in
include hmul hemul in
theorem comp_mul {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of T)) (x y : SchemeHomOver t' X'.f) :
    (X'.L.mul t' x y).1 ≫ (e.hom ≫ gA) =
      (X.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
        ⟨x.1 ≫ (e.hom ≫ gA), by rw [Category.assoc, (comp_isPullback gA hpb e he).w, ← Category.assoc, x.2]⟩
        ⟨y.1 ≫ (e.hom ≫ gA), by rw [Category.assoc, (comp_isPullback gA hpb e he).w, ← Category.assoc, y.2]⟩).1 := by
  rw [← Category.assoc, hemul, hmul]
  exact mul_val_congr X.L _ (Subtype.ext (Category.assoc _ _ _)) (Subtype.ext (Category.assoc _ _ _))

omit hmul hpol hemul hepol in
include hP helev in
theorem comp_P (i : Fin (2 * g)) : (X'.P i).1 ≫ (e.hom ≫ gA) = Spec.map (CommRingCat.ofHom φ) ≫ (X.P i).1 := by
  rw [← Category.assoc, helev i, hP i]

omit hmul hP hemul helev in
include hpol hepol in
theorem comp_pol (s : ↥(Spec (CommRingCat.of T))) : ∃ U : (Spec (CommRingCat.of T)).Opens, s ∈ U ∧
    Nonempty ((Scheme.Modules.pullback (X'.f ⁻¹ᵁ U).ι).obj ((Scheme.Modules.pullback (e.hom ≫ gA)).obj X.pol) ≅
      (Scheme.Modules.pullback (X'.f ⁻¹ᵁ U).ι).obj X'.pol) := by
  obtain ⟨U, hs, ⟨i⟩⟩ := hepol s
  let j : (Scheme.Modules.pullback (e.hom ≫ gA)).obj X.pol ≅ (Scheme.Modules.pullback e.hom).obj X''.pol :=
    ((Scheme.Modules.pullbackComp e.hom gA).app X.pol).symm ≪≫ (Scheme.Modules.pullback e.hom).mapIso hpol.some
  exact ⟨U, hs, ⟨(Scheme.Modules.pullback _).mapIso j ≪≫ i⟩⟩

end Comp

section Transport

variable {R T : Type} [CommRing R] [CommRing T]
  {X : PolarisedAbelianScheme g d n R} {X' : PolarisedAbelianScheme g d n T} (g₀ : X'.A ⟶ X.A)

theorem clauses_congr {φ₁ φ₂ : R →+* T} (hφ : φ₁ = φ₂)
    (h : IsPullback g₀ X'.f X.f (Spec.map (CommRingCat.ofHom φ₂)))
    (hmul : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of T)) (x y : SchemeHomOver t' X'.f),
      (X'.L.mul t' x y).1 ≫ g₀ =
        (X.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ₂))
          ⟨x.1 ≫ g₀, by rw [Category.assoc, h.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ g₀, by rw [Category.assoc, h.w, ← Category.assoc, y.2]⟩).1)
    (hP : ∀ i, (X'.P i).1 ≫ g₀ = Spec.map (CommRingCat.ofHom φ₂) ≫ (X.P i).1) :
    ∃ (h' : IsPullback g₀ X'.f X.f (Spec.map (CommRingCat.ofHom φ₁))),
      (∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of T)) (x y : SchemeHomOver t' X'.f),
        (X'.L.mul t' x y).1 ≫ g₀ =
          (X.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ₁))
            ⟨x.1 ≫ g₀, by rw [Category.assoc, h'.w, ← Category.assoc, x.2]⟩
            ⟨y.1 ≫ g₀, by rw [Category.assoc, h'.w, ← Category.assoc, y.2]⟩).1) ∧
      (∀ i, (X'.P i).1 ≫ g₀ = Spec.map (CommRingCat.ofHom φ₁) ≫ (X.P i).1) := by
  subst hφ
  exact ⟨h, hmul, hP⟩

end Transport

section CompGen

variable {R T T' : Type} [CommRing R] [CommRing T] [CommRing T'] {φ : R →+* T} {ψ : T →+* T'}
  {X : PolarisedAbelianScheme g d n R} {X'' : PolarisedAbelianScheme g d n T} {X' : PolarisedAbelianScheme g d n T'}
  (gA : X''.A ⟶ X.A) (hpb : IsPullback gA X''.f X.f (Spec.map (CommRingCat.ofHom φ)))
  (hmul : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of T)) (x y : SchemeHomOver t' X''.f),
      (X''.L.mul t' x y).1 ≫ gA =
        (X.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
          ⟨x.1 ≫ gA, by rw [Category.assoc, hpb.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ gA, by rw [Category.assoc, hpb.w, ← Category.assoc, y.2]⟩).1)
  (hP : ∀ i, (X''.P i).1 ≫ gA = Spec.map (CommRingCat.ofHom φ) ≫ (X.P i).1)
  (hpol : Nonempty ((Scheme.Modules.pullback gA).obj X.pol ≅ X''.pol))
  (c : X'.A ⟶ X''.A) (hcpb : IsPullback c X'.f X''.f (Spec.map (CommRingCat.ofHom ψ)))
  (hcmul : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of T')) (x y : SchemeHomOver t' X'.f),
      (X'.L.mul t' x y).1 ≫ c =
        (X''.L.mul (t' ≫ Spec.map (CommRingCat.ofHom ψ))
          ⟨x.1 ≫ c, by rw [Category.assoc, hcpb.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ c, by rw [Category.assoc, hcpb.w, ← Category.assoc, y.2]⟩).1)
  (hcP : ∀ i, (X'.P i).1 ≫ c = Spec.map (CommRingCat.ofHom ψ) ≫ (X''.P i).1)
  (hcpol : Nonempty ((Scheme.Modules.pullback c).obj X''.pol ≅ X'.pol))

theorem specMap_comp_eq (φ' : R →+* T) (ψ' : T →+* T') :
    Spec.map (CommRingCat.ofHom ψ') ≫ Spec.map (CommRingCat.ofHom φ') = Spec.map (CommRingCat.ofHom (ψ'.comp φ')) := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]

omit hmul hP hpol hcmul hcP hcpol in
include hpb hcpb in
theorem compg_isPullback : IsPullback (c ≫ gA) X'.f X.f (Spec.map (CommRingCat.ofHom (ψ.comp φ))) := by
  rw [← specMap_comp_eq]
  exact hcpb.paste_horiz hpb

omit hP hpol hcP hcpol in
include hmul hcmul in
theorem compg_mul {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of T')) (x y : SchemeHomOver t' X'.f) :
    (X'.L.mul t' x y).1 ≫ (c ≫ gA) =
      (X.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (ψ.comp φ)))
        ⟨x.1 ≫ (c ≫ gA), by rw [Category.assoc, (compg_isPullback gA hpb c hcpb).w, ← Category.assoc, x.2]⟩
        ⟨y.1 ≫ (c ≫ gA), by rw [Category.assoc, (compg_isPullback gA hpb c hcpb).w, ← Category.assoc, y.2]⟩).1 := by
  rw [← Category.assoc, hcmul, hmul]
  have hb : (t' ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ Spec.map (CommRingCat.ofHom φ) =
      t' ≫ Spec.map (CommRingCat.ofHom (ψ.comp φ)) := by rw [Category.assoc, specMap_comp_eq]
  exact mul_val_congr' X.L hb _ _ _ _ (Category.assoc _ _ _) (Category.assoc _ _ _)

omit hmul hpol hcmul hcpol in
include hP hcP in
theorem compg_P (i : Fin (2 * g)) : (X'.P i).1 ≫ (c ≫ gA) = Spec.map (CommRingCat.ofHom (ψ.comp φ)) ≫ (X.P i).1 := by
  rw [← Category.assoc, hcP i, Category.assoc, hP i, ← Category.assoc, specMap_comp_eq]

omit hmul hP hcmul hcP in
include hpol hcpol in
theorem compg_pol : Nonempty ((Scheme.Modules.pullback (c ≫ gA)).obj X.pol ≅ X'.pol) :=
  ⟨((Scheme.Modules.pullbackComp c gA).app X.pol).symm ≪≫ (Scheme.Modules.pullback c).mapIso hpol.some ≪≫ hcpol.some⟩

end CompGen

include hover in
theorem ρ₁_eq_ρ₂ (i : Fin k) : ρ₁ S B i i = ρ₂ S B i i :=
  (IsLocalization.algHom_subsingleton (Submonoid.powers (r i))).elim _ _

include hover in
theorem e_hom_gA₂_eq_gA₁ (hn : 3 ≤ n) (hn' : IsUnit ((n : ℕ) : S)) (i : Fin k) :
    (e S r B u hover i i).hom ≫ gA₂ S B u i i = gA₁ S B u i i := by
  obtain ⟨hpb₁, hmul₁, hP₁, hpol₁⟩ := (hv₁ S B u i i).choose_spec
  obtain ⟨hpb₂, hmul₂, hP₂, hpol₂⟩ := (hv₂ S B u i i).choose_spec
  obtain ⟨he, hemul, helev, hepol⟩ := (iso_v S r B u hover i i).choose_spec
  have hρ : (ρ₁ S B i i).toRingHom = (ρ₂ S B i i).toRingHom := by rw [ρ₁_eq_ρ₂ S r B u hover i]

  have c₁ := comp_isPullback (gA₂ S B u i i) hpb₂ (e S r B u hover i i) he
  obtain ⟨c₁', c₂', c₃'⟩ := clauses_congr ((e S r B u hover i i).hom ≫ gA₂ S B u i i) hρ c₁
    (comp_mul (gA₂ S B u i i) hpb₂ hmul₂ (e S r B u hover i i) he hemul)
    (comp_P (gA := gA₂ S B u i i) (hP := hP₂) (e := e S r B u hover i i) (helev := helev))
  have hnC : IsUnit ((n : ℕ) : C S B i i) := by simpa using hn'.map (algebraMap S (C S B i i))
  symm
  exact AlgebraicGeometry.PolarisedAbelianScheme.eq_of_isPullback_of_isPullback_of_three_le_of_locally hn
    (ρ₁ S B i i).toRingHom hnC (u i) (v₁ S B u i i) (gA₁ S B u i i) ((e S r B u hover i i).hom ≫ gA₂ S B u i i)
    hpb₁ hmul₁ hP₁ (fun s => ⟨⊤, trivial, ⟨(Scheme.Modules.pullback _).mapIso hpol₁.some⟩⟩)
    c₁' c₂' c₃' (comp_pol (gA₂ S B u i i) hpol₂ (e S r B u hover i i) hepol)

include hover in
theorem t_self (hn : 3 ≤ n) (hn' : IsUnit ((n : ℕ) : S)) (i : Fin k) :
    t S r B u hover i i = (V S r B u i i).ι := by
  simp only [t]
  rw [e_hom_gA₂_eq_gA₁ S r B u hover hn hn' i, θ_hom_gA₁]

private noncomputable abbrev _root_.G2ChartData.flip (i j : Fin k) : C S B j i →+* C S B i j :=
  (Algebra.TensorProduct.comm S (B j) (B i)).toAlgHom.toRingHom

p2m_export "G2ChartData" "flip"
theorem flip_comp_ρ₁ (i j : Fin k) : (flip S B i j).comp (ρ₁ S B j i).toRingHom = (ρ₂ S B i j).toRingHom :=
  RingHom.ext fun _ => rfl

theorem flip_comp_ρ₂ (i j : Fin k) : (flip S B i j).comp (ρ₂ S B j i).toRingHom = (ρ₁ S B i j).toRingHom :=
  RingHom.ext fun _ => rfl

include hover in

theorem exists_κ (i j : Fin k) :
    ∃ (κ : (v₁ S B u i j).A ⟶ (v₁ S B u j i).A) (_ : κ ≫ gA₁ S B u j i = (e S r B u hover i j).hom ≫ gA₂ S B u i j)
      (hc : IsPullback κ (v₁ S B u i j).f (v₁ S B u j i).f (Spec.map (CommRingCat.ofHom (flip S B i j)))),
      (∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B i j))) (x y : SchemeHomOver t' (v₁ S B u i j).f),
        ((v₁ S B u i j).L.mul t' x y).1 ≫ κ =
          ((v₁ S B u j i).L.mul (t' ≫ Spec.map (CommRingCat.ofHom (flip S B i j)))
            ⟨x.1 ≫ κ, by rw [Category.assoc, hc.w, ← Category.assoc, x.2]⟩
            ⟨y.1 ≫ κ, by rw [Category.assoc, hc.w, ← Category.assoc, y.2]⟩).1) ∧
      (∀ m, ((v₁ S B u i j).P m).1 ≫ κ = Spec.map (CommRingCat.ofHom (flip S B i j)) ≫ ((v₁ S B u j i).P m).1) ∧
      (∀ s : ↥(Spec (CommRingCat.of (C S B i j))), ∃ U : (Spec (CommRingCat.of (C S B i j))).Opens, s ∈ U ∧
        Nonempty ((Scheme.Modules.pullback ((v₁ S B u i j).f ⁻¹ᵁ U).ι).obj ((Scheme.Modules.pullback κ).obj (v₁ S B u j i).pol) ≅
          (Scheme.Modules.pullback ((v₁ S B u i j).f ⁻¹ᵁ U).ι).obj (v₁ S B u i j).pol)) := by
  obtain ⟨hpb₁, hmul₁, hP₁, hpol₁⟩ := (hv₁ S B u j i).choose_spec
  obtain ⟨hpb₂, hmul₂, hP₂, hpol₂⟩ := (hv₂ S B u i j).choose_spec
  obtain ⟨he, hemul, helev, hepol⟩ := (iso_v S r B u hover i j).choose_spec

  obtain ⟨d₁, d₂, d₃⟩ := clauses_congr (gA₂ S B u i j) (flip_comp_ρ₁ S B i j) hpb₂ hmul₂ hP₂

  obtain ⟨κ₀, hκ₀, hκ₀pb, hκ₀mul, hκ₀P, hκ₀pol⟩ :=
    AlgebraicGeometry.PolarisedAbelianScheme.exists_hom_comp_eq_isPullback_of_comp (ρ₁ S B j i).toRingHom (flip S B i j)
      (u j) (v₁ S B u j i) (v₂ S B u i j) (gA₁ S B u j i) hpb₁ hmul₁ hP₁ hpol₁ (gA₂ S B u i j) d₁ d₂ d₃ hpol₂
  refine ⟨(e S r B u hover i j).hom ≫ κ₀, by rw [Category.assoc, hκ₀],
    comp_isPullback κ₀ hκ₀pb (e S r B u hover i j) he,
    comp_mul κ₀ hκ₀pb hκ₀mul (e S r B u hover i j) he hemul,
    comp_P (gA := κ₀) (hP := hκ₀P) (e := e S r B u hover i j) (helev := helev),
    comp_pol κ₀ hκ₀pol (e S r B u hover i j) hepol⟩

section PolLocal

variable {R T T' : Type} [CommRing R] [CommRing T] [CommRing T'] {φ : R →+* T} {ψ : T →+* T'}
  {X : PolarisedAbelianScheme g d n R} {X'' : PolarisedAbelianScheme g d n T} {X' : PolarisedAbelianScheme g d n T'}

theorem locIsoOnBase_iff (g₀ : X'.A ⟶ X.A) :
    LocIsoOnBase X'.f ((Scheme.Modules.pullback g₀).obj X.pol) X'.pol ↔
      ∀ s : ↥(Spec (CommRingCat.of T')), ∃ U : (Spec (CommRingCat.of T')).Opens, s ∈ U ∧
        Nonempty ((Scheme.Modules.pullback (X'.f ⁻¹ᵁ U).ι).obj ((Scheme.Modules.pullback g₀).obj X.pol) ≅
          (Scheme.Modules.pullback (X'.f ⁻¹ᵁ U).ι).obj X'.pol) := Iff.rfl

theorem locIsoOnBase_of_iso {Y : Scheme.{0}} (gY : Y ⟶ Spec (CommRingCat.of T')) {M M' : Y.Modules} (i : M ≅ M') :
    LocIsoOnBase gY M M' :=
  fun _ => ⟨⊤, trivial, ⟨(Scheme.Modules.pullback _).mapIso i⟩⟩

theorem pol_local_comp (gA : X''.A ⟶ X.A) (c : X'.A ⟶ X''.A)
    (hcw : c ≫ X''.f = X'.f ≫ Spec.map (CommRingCat.ofHom ψ))
    (hg : LocIsoOnBase X''.f ((Scheme.Modules.pullback gA).obj X.pol) X''.pol)
    (hc : LocIsoOnBase X'.f ((Scheme.Modules.pullback c).obj X''.pol) X'.pol) :
    LocIsoOnBase X'.f ((Scheme.Modules.pullback (c ≫ gA)).obj X.pol) X'.pol := by
  have E := LocIsoOnBase.equivalence X'.f
  have h1 := LocIsoOnBase.pullback_of_comp_eq X'.f c (Spec.map (CommRingCat.ofHom ψ)) hcw hg
  exact E.trans (E.trans (locIsoOnBase_of_iso X'.f ((Scheme.Modules.pullbackComp c gA).app X.pol).symm) h1) hc

end PolLocal

