-- title:
--   Lemma 2 (i) — KM estimators induced by the KM-myopic policy converge on $[0,\mathcal R]$
-- statement:
--   Let the demands $D_1,D_2,\dots$ be independent copies of a nonnegative integer-valued random variable $D$, let $h,b>0$ and $r^*=b/(b+h)$, and let $Y^{KM}_t$ be the orders of the KM-myopic policy with target ratio $r^*$ and an arbitrary initial order $y_1$. Let $\bar F_T$ be the Kaplan–Meier estimator built from the first $T$ observations $(Z_t,\delta_t)$ generated by the policy, and $\mathcal R$ the convergence radius. Then for every integer $d$ with $0\le d\le\mathcal R$, almost surely,
--   $$\bar F_T(d)\longrightarrow\bar F(d)=P[D>d]\qquad(T\to\infty).$$
--
--   This is the policy-specific instance of Theorem 2: the KM-myopic orders are predictable censoring levels, and every $d\le\mathcal R$ is reached by them infinitely often almost surely.
--
--   **Formalization Note** Time is $0$-based (Lean period $n$ is the source's period $n+1$). The costs $h,b$ enter only through $r^*$. No hypothesis beyond the source's is added; the statement holds for every initial order $y_1$.
-- source:
--   Huh, Levi, Rusmevichientong, Orlin, Adaptive Data-Driven Inventory Control with Censored Demand Based on Kaplan-Meier Estimator, Oper. Res. 59(4) (2011), doi:10.1287/opre.1100.0906, p. 935, Lemma 2 (i)

import Mathlib
import Definitions.Def_KMNewsvendor_quantile
import Definitions.Def_KMNewsvendor_kmSurv
import Definitions.Def_KMNewsvendor_kmOrder
import Definitions.Def_KMNewsvendor_radius
open MeasureTheory ProbabilityTheory Filter Finset Topology

namespace KMNewsvendor

/-- Lemma 2 (i) (p. 935): under the KM-myopic policy with critical ratio `r* = b/(b+h)` and any
initial order `y₁`, the KM estimator `F̄_T(d)` built from the first `T` observations converges
almost surely to `F̄(d)` for every integer `d` in the convergence interval `[0, ℛ]`. -/
theorem km_converges_on_radius {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (D : ℕ → Ω → ℕ) (hmeas : ∀ t, Measurable (D t)) (hindep : iIndepFun D μ)
    (hident : ∀ t, IdentDistrib (D t) (D 0) μ μ)
    (h b : ℝ) (hh : 0 < h) (hb : 0 < b) (y₁ : ℕ)
    (d : ℕ) (hd : d ≤ radius μ D (critRatio b h) y₁) :
    ∀ᵐ ω ∂μ, Tendsto (fun T : ℕ =>
        kmSurv T (kmSales (critRatio b h) y₁ (fun t => D t ω))
          (kmUncensored (critRatio b h) y₁ (fun t => D t ω)) d)
      atTop (𝓝 (survival μ (D 0) d)) := by sorry

end KMNewsvendor
