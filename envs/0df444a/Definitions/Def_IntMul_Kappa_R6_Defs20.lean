/-! ## Record-wise reindexing -/

/-! ## Fields with a record factor -/

/-! ## Rotations on records -/

/-- The pull of the rotation of field `(Q, S)` by the table `as` (indexed by the prefix). -/
def rotP (Q S : ℕ) (as : ℕ → ℕ) (m : ℕ) : ℕ := sc Q S ((gc Q S m + Q - as (m / (Q * S))) % Q) m

/-! ## Swaps on records -/

/-- The pull of the swap of the fields `(F, S1)` (upper) and `(F, S2)` (lower). -/
def swP (F S1 S2 m : ℕ) : ℕ := sc F S1 (gc F S2 m) (sc F S2 (gc F S1 m) m)

/-! ## Nested fields -/

/-! ## The layout of a record index -/

/-- The five fields of a record index: `T, U` (size `QC`), `X, Y` (size `QL`), `Bk` (size `QC`). -/
structure Lay where
  QC : ℕ
  QL : ℕ
  sT : ℕ
  sU : ℕ
  sX : ℕ
  sY : ℕ
  sB : ℕ
  M : ℕ

/-- `T > U > {X, Y} > Bk` (record order, most significant first), all nested. -/
structure Lay.OK (l : Lay) : Prop where
  qc : 0 < l.QC
  ql : 0 < l.QL
  pB : 0 < l.sB
  kTU : ∃ k, 0 < k ∧ l.sT = l.sU * l.QC * k
  kUX : ∃ k, 0 < k ∧ l.sU = l.sX * l.QL * k
  kUY : ∃ k, 0 < k ∧ l.sU = l.sY * l.QL * k
  kXB : ∃ k, 0 < k ∧ l.sX = l.sB * l.QC * k
  kYB : ∃ k, 0 < k ∧ l.sY = l.sB * l.QC * k
  kXY : (∃ k, 0 < k ∧ l.sX = l.sY * l.QL * k) ∨ (∃ k, 0 < k ∧ l.sY = l.sX * l.QL * k)
  kM : ∃ k, 0 < k ∧ l.M = l.sT * l.QC * k

namespace Lay

variable {l : Lay}

/-- The state `(t, u, y)` of record `m`. -/
def cs (l : Lay) (m : ℕ) : CS := ⟨gc l.QC l.sT m, gc l.QC l.sU m, gc l.QL l.sY m⟩

/-- The source slot of record `m`. -/
def xv (l : Lay) (m : ℕ) : ℕ := gc l.QL l.sX m

/-- Record `m` with the state `c`. -/
def set (l : Lay) (c : CS) (m : ℕ) : ℕ := sc l.QC l.sT c.t (sc l.QC l.sU c.u (sc l.QL l.sY c.y m))

/-- The box of states. -/
def BoxL (l : Lay) (c : CS) : Prop := c.t < l.QC ∧ c.u < l.QC ∧ c.y < l.QL

/-- A step of the program as a record pull. -/
def stepP (l : Lay) (F : ℕ → CS → CS) (m : ℕ) : ℕ := l.set (F (l.xv m) (l.cs m)) m

