theorem inversePower11_eval (k : ℂ) (z : ℂ × ℂ) :
    eval k (mulTrunc 24 (parameter (-11)) inverseSum11) z = eval k inversePower11 z := by
  have he := eval_eq_of_degrees 24 k inversePower11_raw inversePower11 z
    (degreeBound_sound inversePower11_raw_bound) (degreeBound_sound inversePower11_result_bound)
    inversePower11_degrees
  change eval k (normalize inversePower11_raw) z = eval k inversePower11 z
  rw [eval_normalize]
  exact he

theorem inversePower11_approximates {k : ℂ} (hk : k ≠ 0) (hklog : k = (Real.log 2:ℂ)) :
    Approximates 24 k (fun z => ((meanFunction z)⁻¹)^11) inversePower11 := by
  have h23 := (lossPower23_approximates hk hklog).scale (92561040 : ℚ)
  have h22 := ((lossPower22_approximates hk hklog).scale (64512240 : ℚ)).addAppend h23
