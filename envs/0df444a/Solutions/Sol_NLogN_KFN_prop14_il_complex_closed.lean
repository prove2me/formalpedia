      rw [e]
      have : b * ((m : ℝ) ^ k + 1) ^ τ ≤ b * (2 * R ^ k) := mul_le_mul_of_nonneg_left hg hb
      nlinarith
    have hRk1 : R ^ k ≤ R ^ (k + 1) := pow_le_pow_right₀ hR (by omega)
