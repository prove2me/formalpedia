theorem L0_ι1 {b w : ℕ} (hb : b < 1771) (hw : w < 43642) : L0 ch N (ι1 b w) = lab1 ch N b (codeOf SG1_0 w) := by
  unfold ι1 g1
  by_cases h1 : w < 1771
  · rw [if_pos h1, gw_lt (by omega), L0]
    dsimp only
    rw [if_pos (by omega), show (w * 1771 + b) % 1771 = b by omega, show (w * 1771 + b) / 1771 = w by omega]
    exact (k1x h1).symm ▸ rfl
  · by_cases h2 : w < 3542
    · obtain ⟨t, rfl⟩ : ∃ t, w = 1771 + t := ⟨w - 1771, by omega⟩
      rw [if_neg h1, if_pos h2, gw_lt (by omega), L0]
      dsimp only
      rw [if_neg (by omega), show codeOf SG1_0 (1771 + t) = cLOW from k1y (by omega), lab1_low h]
    · by_cases h3 : w < 43619
      · obtain ⟨q, rfl⟩ : ∃ q, w = 3542 + q := ⟨w - 3542, by omega⟩
        rw [if_neg h1, if_neg h2, if_pos h3, gw_lt (by omega), L0]
        dsimp only
        rw [if_neg (by omega), show codeOf SG1_0 (3542 + q) = cLOW from k1s (by omega), lab1_low h]
      · rw [if_neg h1, if_neg h2, if_neg h3, gw_ge (by omega) (by omega), L0]
        dsimp only
        rw [if_pos (by omega), show (148225616 + 23 * b + (w - 43619) - 148225616) / 23 = b by omega,
          show 43619 + (148225616 + 23 * b + (w - 43619) - 148225616) % 23 = w by omega]

/-- Labels at stage-two wires before stage two. -/
theorem L1_pre {a w : ℕ} (ha : a < 1771) (hw : w < 45413) (L1 : Wr → FMat 529 N)
    (hs1 : ∀ b ∈ List.range 1771, ∀ w, w < 43642 → L1 (ι1 b w) = fin1 ch N b w)
    (hs2 : ∀ x, (∀ b ∈ List.range 1771, ∀ w, w < 43642 → ι1 b w ≠ x) → L1 x = L0 ch N x) :
    L1 (ι2 a w) = pre2 ch N a w := by
  unfold pre2
  by_cases h1 : w < 1771
  · rw [if_pos h1, ι2, g2_x h1 ha, ← ι1, hs1 w (List.mem_range.2 h1) _ (wY_lt ha), fin1,
      if_neg (by simp only [wY, Nat.add_eq]; omega), k3y ha]
  · by_cases h2 : w < 3542
    · obtain ⟨t, rfl⟩ : ∃ t, w = 1771 + t := ⟨w - 1771, by omega⟩
      have ht : t < 1771 := by omega
      rw [if_neg h1, if_pos h2, Nat.add_sub_cancel_left, show 1771 + t = wY t from rfl, ι2, g2_y ht ha, ← ι1,
        hs1 t (List.mem_range.2 ht) _ (wX_lt ha), fin1, if_neg (by simp only [wX]; omega), k3x ha]
    · rw [if_neg h1, if_neg h2, hs2 (ι2 a w) (fun b hb w' hw' e => g2_ne_g1 ha (by omega) hw
        (List.mem_range.1 hb) hw' (gw_inj (g2_lt ha hw) (g1_lt (List.mem_range.1 hb) hw') e.symm))]
      unfold ι2 g2
      by_cases h3 : w < 43619
      · rw [if_pos h3, if_neg h1, if_neg h2, if_pos h3, gw_lt (by omega), L0]
        dsimp only
        rw [if_neg (by omega)]
      · by_cases h4 : w < 43642
        · rw [if_neg h3, if_pos h4, if_neg h1, if_neg h2, if_neg h3, if_pos h4, gw_ge (by omega) (by omega), L0]
          dsimp only
          rw [if_neg (by omega), if_pos (by omega),
            show (148225616 + 40733 + 23 * a + (w - 43619) - 148225616 - 40733) / 23 = a by omega,
            show 43619 + (148225616 + 40733 + 23 * a + (w - 43619) - 148225616 - 40733) % 23 = w by omega]
        · rw [if_neg h3, if_neg h4, if_neg h1, if_neg h2, if_neg h3, if_neg h4, gw_ge (by omega) (by omega), L0]
          dsimp only
          rw [if_neg (by omega), if_neg (by omega)]

/-- **Labels of the whole program.** -/
theorem lab_prog : LabGates N (prog ch) (L0 ch N) ∧
    (∀ a < 1771, ∀ s < 1771, (prog ch).foldl (labStepH N) (L0 ch N) (ι2 a (wY s)) = swapMat ∧
      (prog ch).foldl (labStepH N) (L0 ch N) (ι2 a (wX s)) = lab2 ch N a (cND (s + 1))) ∧
    (∀ b < 1771, ∀ q < 40077, (prog ch).foldl (labStepH N) (L0 ch N) (ι1 b (wS q)) = swapMat) ∧
    (∀ a < 1771, ∀ q < 40077, (prog ch).foldl (labStepH N) (L0 ch N) (ι2 a (wS q)) = swapMat) := by
  obtain ⟨r1, r2, r3⟩ := flat_fold (labStepH N) (LabGates N) (fun p q L => labGates_append p q L)
    (fun L => labGates_nil' L) ι1 (· < 43642) (fun b w => lab1 ch N b (codeOf SG1_0 w)) (fin1 ch N) (blk1 ch)
    (List.range 1771) List.nodup_range
    (fun b hb b' hb' hne w w' hw hw' e => hne (ι1_inj (List.mem_range.1 hb) (List.mem_range.1 hb') hw hw' e).1)
    (fun b hb L hL => blk1_lab h (List.mem_range.1 hb) L hL) (L0 ch N)
    (fun b hb w hw => L0_ι1 h (List.mem_range.1 hb) hw)
  obtain ⟨L1, hL1⟩ : ∃ L1, L1 = ((List.range 1771).flatMap (blk1 ch)).foldl (labStepH N) (L0 ch N) := ⟨_, rfl⟩
  rw [← hL1] at r2 r3
  obtain ⟨t1, t2, t3⟩ := flat_fold (labStepH N) (LabGates N) (fun p q L => labGates_append p q L)
    (fun L => labGates_nil' L) ι2 (· < 45413) (pre2 ch N) (fin2 ch N) (blk2 ch)
    (List.range 1771) List.nodup_range
    (fun a ha a' ha' hne w w' hw hw' e => hne (ι2_inj (List.mem_range.1 ha) (List.mem_range.1 ha') hw hw' e).1)
    (fun a ha L hL => blk2_lab h (List.mem_range.1 ha) L hL) L1
    (fun a ha w hw => L1_pre h (List.mem_range.1 ha) hw L1 r2 r3)
  have hp : prog ch = (List.range 1771).flatMap (blk1 ch) ++ (List.range 1771).flatMap (blk2 ch) := rfl
  rw [hp, labGates_append, List.foldl_append, ← hL1]
  refine ⟨⟨?_, ?_⟩, fun a ha s hs => ⟨?_, ?_⟩, fun b hb q hq => ?_, fun a ha q hq => ?_⟩
  · exact r1
  · exact t1
  · rw [t2 a (List.mem_range.2 ha) _ (by have := wY_lt hs; simp only [NL] at this; omega), fin2,
      if_pos (show wY s < 43642 from wY_lt hs), k5y hs, lab2_low h]
  · rw [t2 a (List.mem_range.2 ha) _ (by have := wX_lt hs; simp only [NL] at this; omega), fin2,
      if_pos (show wX s < 43642 from wX_lt hs), k5x hs]
  · rw [t3 _ (fun a ha w hw e => by
        have e' := gw_inj (g2_lt (List.mem_range.1 ha) hw) (g1_lt hb (wS_lt hq)) e
        have ha' := List.mem_range.1 ha
        rw [show g1 b (wS q) = 6272882 + b * 40077 + q by
          rw [show wS q = 3542 + q from rfl]; unfold g1
          rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]; omega] at e'
        unfold g2 at e'; split_ifs at e' <;> omega),
      r2 b (List.mem_range.2 hb) _ (wS_lt hq), fin1, if_pos (by simp only [wS, Nat.add_eq]; omega)]
  · rw [t2 a (List.mem_range.2 ha) _ (by have := wS_lt hq; simp only [NL] at this; omega), fin2,
      if_pos (show wS q < 43642 from wS_lt hq), k5s hq, lab2_low h]

end Prog

end IntMul.Kappa.R6.Bit.NB

