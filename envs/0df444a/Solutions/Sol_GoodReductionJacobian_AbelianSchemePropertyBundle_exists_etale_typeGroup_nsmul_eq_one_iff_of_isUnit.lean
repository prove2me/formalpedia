theorem solution
    {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle S f)
    (g : ℕ) (hdim : ∀ s : ↥(Spec (CommRingCat.of S)), topologicalKrullDim ↥(f.base ⁻¹' {s}) = g)
    (n : ℕ) (hn : 0 < n) (hunit : IsUnit ((n : ℕ) : S))
    (δ : Fin g → ℕ) (hδ : ∀ i, δ i = n) :
    ∃ (S' : Type) (_ : CommRing S') (_ : Algebra S S') (_ : Module.FaithfullyFlat S S') (_ : Algebra.Etale S S')
      (x : PolarisedAbelianScheme.typeGroup δ → SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap S S'))) f),
      (x 0 = L.one _ ∧ ∀ h h' : PolarisedAbelianScheme.typeGroup δ, x (h + h') = L.mul _ (x h) (x h')) ∧
      (∀ (k : Type) [Field k] [IsAlgClosed k] (sk : S' →+* k) (h h' : PolarisedAbelianScheme.typeGroup δ),
        Spec.map (CommRingCat.ofHom sk) ≫ (x h).1 = Spec.map (CommRingCat.ofHom sk) ≫ (x h').1 → h = h') ∧
      (∀ (R : Type) [CommRing R] [Algebra S' R]
        (y : SchemeHomOver (Spec.map (CommRingCat.ofHom ((algebraMap S' R).comp (algebraMap S S')))) f),
        L.nsmul _ n y = L.one _ ↔
          ∃ (m : ℕ) (r : Fin m → R), Ideal.span (Set.range r) = ⊤ ∧ ∀ j, ∃ h : PolarisedAbelianScheme.typeGroup δ,
            Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (r j)))) ≫ y.1 =
              Spec.map (CommRingCat.ofHom ((algebraMap R (Localization.Away (r j))).comp (algebraMap S' R))) ≫ (x h).1) := by
  classical

  obtain rfl : δ = fun _ => n := funext hδ

  obtain ⟨B, _, _, _, _, hrank, ι, hι, hιc, hιn⟩ :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.exists_finite_etale_rankAtStalk_eq_pow_nsmul_eq_one_iff_of_isUnit
      L hc hA g hdim n hn hunit

  have hfib := fun (k : Type) [Field k] [IsAlgClosed k] (sk : S →+* k) =>
    GoodReductionJacobian.AbelianSchemePropertyBundle.exists_finComb_basis_nsmul_eq_one_of_isAlgClosed
      L hc hA g hdim n hn hunit k sk

  obtain ⟨S', _, _, _, _, _, P, hP, hinj, hspan⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_finite_etale_faithfullyFlat_finComb_basis_of_forall_isAlgClosed
      L hc n (2 * g) B ι hι hιc hιn hfib

  let t : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of S) := Spec.map (CommRingCat.ofHom (algebraMap S S'))
  let x : PolarisedAbelianScheme.typeGroup (fun _ : Fin g => n) → SchemeHomOver t f :=
    fun h => L.finComb t P (fun i => ((SplitEtKit.coords hn h i : Fin n) : ℕ))
  have hx : ∀ h, x h = L.finComb t P (fun i => ((SplitEtKit.coords hn h i : Fin n) : ℕ)) := fun _ => rfl
  refine ⟨S', inferInstance, inferInstance, inferInstance, inferInstance, x, ⟨?_, ?_⟩, ?_, ?_⟩
  ·
    rw [hx]
    exact SplitEtKit.finComb_zero L hc t P _ (fun i => SplitEtKit.coords_zero hn i)
  ·
    intro h h'
    rw [hx, hx, hx, ← SplitEtKit.finComb_add_mod L hc t P hP]
    congr 1
    funext i
    rw [SplitEtKit.coords_add hn h h' i]
  ·
    intro k _ _ sk h h' H
    exact SplitEtKit.coords_injective hn (hinj k sk (SplitEtKit.coords hn h) (SplitEtKit.coords hn h') H)
  ·
    intro R _ _ y
    constructor
    · intro hy
      obtain ⟨M, r, hr, hloc⟩ :=
        GoodReductionJacobian.RelativeGroupLaw.exists_cover_comp_eq_comp_finComb_of_nsmul_eq_one_of_etale
          L hc n B ι hι hιc hιn S' P hP hspan R y hy
      refine ⟨M, r, hr, fun j => ?_⟩
      obtain ⟨c, hcj⟩ := hloc j
      refine ⟨SplitEtKit.ofCoords c, ?_⟩
      rw [hx, SplitEtKit.coords_ofCoords hn c]
      exact hcj
    · rintro ⟨M, r, hr, hloc⟩

      apply Subtype.ext
      refine (Scheme.affineOpenCoverOfSpanRangeEqTop (R := CommRingCat.of R) r hr).openCover.hom_ext _ _ fun j => ?_
      obtain ⟨h, hh⟩ := hloc j
      let tR : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S) :=
        Spec.map (CommRingCat.ofHom ((algebraMap S' R).comp (algebraMap S S')))
      let ψ : Spec (CommRingCat.of (Localization.Away (r j))) ⟶ Spec (CommRingCat.of R) :=
        Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away (r j))))
      let ψ' : Spec (CommRingCat.of (Localization.Away (r j))) ⟶ Spec (CommRingCat.of S') :=
        Spec.map (CommRingCat.ofHom ((algebraMap R (Localization.Away (r j))).comp (algebraMap S' R)))
      have hψ' : ψ' ≫ t = ψ ≫ tR := by
        simp only [ψ', t, ψ, tR, ← Spec.map_comp, ← CommRingCat.ofHom_comp, RingHom.comp_assoc]
      show ψ ≫ (L.nsmul tR n y).1 = ψ ≫ (L.one tR).1
      have e1 : ψ ≫ (L.nsmul tR n y).1 = (L.nsmul (ψ ≫ tR) n (schemeHomOverComp ψ rfl y)).1 := by
        rw [← SplitEtKit.nsmul_natural L tR (ψ ≫ tR) ψ rfl n y]; rfl
      have e2 : ψ ≫ (L.one tR).1 = (L.one (ψ ≫ tR)).1 := by
        rw [← L.one_natural tR (ψ ≫ tR) ψ rfl]; rfl
      have e3 : schemeHomOverComp ψ rfl y = schemeHomOverComp ψ' hψ' (x h) := Subtype.ext hh
      rw [e1, e2, e3, ← SplitEtKit.nsmul_natural L t (ψ ≫ tR) ψ' hψ' n (x h), hx,
        SplitEtKit.nsmul_finComb_eq_one L hc t n P hP, L.one_natural]

