/-! ## Prefix-Determined Games -/

/-- A game is n-prefix-determined if membership depends only on the first n moves. -/
def PrefixDetermined {α : Type*} (A : Set (ℕ → α)) (n : ℕ) : Prop :=
  ∀ x y : ℕ → α, (∀ i, i < n → x i = y i) → (x ∈ A ↔ y ∈ A)





/-! ## Wadge Reducibility -/

/-- **Wadge reducibility**: A ≤_W B via a Lipschitz-continuous reduction on Baire space. -/
def WadgeReducible {α : Type*} (A B : Set (ℕ → α)) : Prop :=
  ∃ f : (ℕ → α) → (ℕ → α),
    (∀ x, x ∈ A ↔ f x ∈ B) ∧
    (∀ x y : ℕ → α, ∀ n : ℕ, (∀ i, i < n → x i = y i) →
      ∀ i, i < n → f x i = f y i)

scoped infixl:50 " ≤_W " => WadgeReducible





/-! ## Game Rank -/

/-- The **game rank**: minimum prefix length for determination, or ⊤ if none. -/
noncomputable def gameRank {α : Type*} (A : Set (ℕ → α)) : ℕ∞ :=
  if h : ∃ n : ℕ, PrefixDetermined A n then (Nat.find h : ℕ∞) else ⊤





/-! ## Quasi-Strategies -/

/-- A **quasi-strategy** for Player I: at each history, a nonempty set of allowed moves. -/
structure QuasiStrategyI (α : Type*) where
  allowed : List α → Set α
  nonempty : ∀ h : List α, (allowed h).Nonempty

def Strategy.toQuasiI {α : Type*} (σ : Strategy α) : QuasiStrategyI α where
  allowed := fun h => {σ h}
  nonempty := fun h => ⟨σ h, rfl⟩

def QuasiStrategyI.Refines {α : Type*} (q₁ q₂ : QuasiStrategyI α) : Prop :=
  ∀ h : List α, q₁.allowed h ⊆ q₂.allowed h




/-- Every quasi-strategy can be refined to a deterministic strategy (via choice). -/
noncomputable def QuasiStrategyI.toStrategy {α : Type*} (q : QuasiStrategyI α) :
    Strategy α := fun h => (q.nonempty h).some



/-! ## Game Morphisms -/

/-- A **game morphism** from G(A) to G(B) preserves winning for both players.
    This is a novel categorical notion capturing strategic embedding. -/
structure GameMorphism (α β : Type*) (A : Set (ℕ → α)) (B : Set (ℕ → β)) where
  mapI : Strategy α → Strategy β
  mapII : Strategy α → Strategy β
  preserves_winI : ∀ σ : Strategy α, (∀ τ, playOf σ τ ∈ A) →
    ∀ τ' : Strategy β, playOf (mapI σ) τ' ∈ B
  preserves_winII : ∀ τ : Strategy α, (∀ σ, playOf σ τ ∉ A) →
    ∀ σ' : Strategy β, playOf σ' (mapII τ) ∉ B


def GameMorphism.id {α : Type*} (A : Set (ℕ → α)) : GameMorphism α α A A where
  mapI := _root_.id
  mapII := _root_.id
  preserves_winI := fun _ hσ τ => hσ τ
  preserves_winII := fun _ hτ σ => hτ σ


/-! ## Strategic Equivalence -/

/-- Two games are strategically equivalent if morphisms exist in both directions. -/
def StrategicEquiv {α β : Type*} (A : Set (ℕ → α)) (B : Set (ℕ → β)) : Prop :=
  Nonempty (GameMorphism α β A B) ∧ Nonempty (GameMorphism β α B A)




