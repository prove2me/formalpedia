theorem child35_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu154.lin : ℝ) ≤ (S : ℝ) * logProd gu154.lo) :
    (gu157.lfin : ℝ) ≤ (S : ℝ) * logProd gu157.top ∧
      (∀ x : ℝ, (gu154.lo : ℝ) < x → x ≤ (gu157.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u154 hγ hstate
  have s1 := sol_u155 hγ (by simpa [gu154, gu155] using s0.1)
  have s2 := sol_u156 hγ (by simpa [gu155, gu156] using s1.1)
  have s3 := sol_u157 hγ (by simpa [gu156, gu157] using s2.1)
  refine ⟨s3.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu154.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu155.lo : ℝ) < x := by
        have hb : (gu154.top : ℝ) = (gu155.lo : ℝ) := by simp [gu154, gu155]
        linarith
    by_cases h1 : x ≤ (gu155.top : ℝ)
    · exact s1.2 x hx1 h1
    · have hx2 : (gu156.lo : ℝ) < x := by
          have hb : (gu155.top : ℝ) = (gu156.lo : ℝ) := by simp [gu155, gu156]
          linarith
      by_cases h2 : x ≤ (gu156.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu157.lo : ℝ) < x := by
            have hb : (gu156.top : ℝ) = (gu157.lo : ℝ) := by simp [gu156, gu157]
            linarith
        exact s3.2 x hx3 htop

