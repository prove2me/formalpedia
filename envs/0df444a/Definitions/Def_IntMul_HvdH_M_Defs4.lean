-- Source module: NLogN.HFW10
/-!
# Fermat-ring convolution machine, part 10: the program `fwP` computing `Ref.fermatW`

Stack layout of `fwP` (all stacks hold the value on top, below it arbitrary contents):

* inputs: `GU = 45`: `gints U`, `VI = 12`: `gints V` (both consumed);
* encoder registers: `CR = 23`: `2^P`, `CM = 26`: `r`, `RW = 52`: `2^(2rP)`, `FR = 53`: `2^fn + 1`;
* decoder registers: `KB = 32`: `2^P`, `KN = 33`: `2^fn`, `KR = 34`: `r`;
* transform registers: `XN = 2`: `2^fn`, `XF = 3`: `2^fn + 1`;
* sizes: `NN = 19`: `N = 2^logOuter`, `KBR = 27`: `kb` (with `N ≤ 2^kb`), `NAX = 18`: `K - 1`,
  `SH = 28`: `2^(fn - logOuter)`;
* level descriptors: `AXS = 15`: `ints ((descs q.outerAxes 1).flatMap enc8)` (restored at the end);
* output: `OUT = 0`: `gints (fermatW q U V)` pushed on top of the old contents.

Everything else (`XD = 8`, `YC = 4`, `SA = 20`, `AXR = 16`, `KO = 31`, counters, scratch) is restored.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.FW

open IntMul IntMul.HvdH NLogN

abbrev VI : Fin HS := 12
abbrev SA : Fin HS := 20

def σV : Equiv.Perm (Fin HS) := swapsPerm [(GU, VI)]

/-- The encoder reading from `VI` instead of `GU`. -/
def encV : RM := encL.ren σV

/-! ## The program -/

/-- `8 (K - 1)`: the number of descriptor integers. -/
def c8E : Ex HS := .shl (.reg NAX) (.lit 8)

def fwP : RM :=
  RM.seqL [encL, passP AXS AXR difPrc, .rs (mvList XD NLogN.FW.SA C2 (.reg NN)), encV,
    .rs (mvList AXR AXS C2 c8E), passP AXS AXR difPrc, .rs (mvList NLogN.FW.SA YC C2 (.reg NN)), pmL,
    passP AXR AXS ditPrc, dcL, mvPairs]

/-- The bit bound used throughout. -/
def fwW (q : Ref.Params) (kb : ℕ) : ℕ := 2 * q.fn + kb + 3

/-- The bit bound of the decoded pairs and their count. -/
def fwW2 (q : Ref.Params) (kb : ℕ) : ℕ := q.P + kb + q.e + 3

/-- The bit bound of the encoder/decoder scalars. -/
def fwQ (q : Ref.Params) : ℕ := q.P + q.e + 1

/-- The explicit cost of `fwP`. -/
def fwCost (q : Ref.Params) (kb Φm : ℕ) : ℕ :=
  2 * encCost (2 ^ q.logOuter) q.r q.P (fwQ q) (fwW q kb) +
    3 * passCost (q.K - 1) q.fn kb (fwW q kb) (2 ^ q.logOuter) q.e +
    2 * (2 ^ q.logOuter * (14000 * (fwW q kb + 2) + 30) + 4000 * (fwW q kb + 2) + 32) +
    (8000 * (fwW q kb + 2) + 8 * (q.K - 1) * (14000 * (fwW q kb + 2) + 30) + 32) +
    pmCost (2 ^ q.logOuter) (fwW q kb) Φm + dcCost (2 ^ q.logOuter) q.r q.P (fwQ q) (fwW q kb) +
    (8000 * (fwW2 q kb + 2) + 2 ^ q.logOuter * 2 ^ q.e * (40000 * (fwW2 q kb + 2)) + 32)

