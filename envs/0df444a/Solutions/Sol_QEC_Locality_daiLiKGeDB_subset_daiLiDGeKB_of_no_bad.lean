universe u v
variable {ι : Type u} [Fintype ι] [DecidableEq ι]
variable {κ : Type v} [Fintype κ]
attribute [local instance] QEC.Locality.instClassicalDecidableDGeK
namespace QEC.Locality
theorem _root_.solution
    (P : BinaryStabilizerPresentation (ι := ι) (κ := κ))
    (embedding : UnitSeparatedEmbedding2D ι) (d : ℕ) (threshold w ell : ℝ)
    (t : GridTranslation w)
    (hNoBad : daiLiBadGridCells P embedding threshold d w (gridOrigin w t) = ∅) :
    (daiLiKGeDBSubsystem P embedding d threshold w ell t
      (daiLiBadGridCells P embedding threshold d w (gridOrigin w t))
      (fun _ => [])).selected ⊆
      (daiLiDGeKBSubsystem P embedding threshold w ell t).selected := by
  intro q hq
  rcases Finset.mem_union.mp hq with hGrid | hInternal
  · change q ∈ (daiLiGridSideCandidates embedding w (gridOrigin w t)).biUnion
      (fun side => (daiLiKGeDGridSideFamily P embedding threshold w ell t
        (daiLiBadGridCells P embedding threshold d w (gridOrigin w t))
        (fun _ => []) side).selected) at hGrid
    rcases Finset.mem_biUnion.mp hGrid with ⟨side, hSide, hqSide⟩
    apply mem_daiLiDGeKGoodSide_into_B P embedding threshold w ell t side hSide q
    apply Finset.mem_sdiff.mpr
    refine ⟨(Finset.mem_sdiff.mp hqSide).1, ?_⟩
    intro hEndpoint
    exact (Finset.mem_sdiff.mp hqSide).2
      (Finset.mem_union_left _ (Finset.mem_union_right _ hEndpoint))
  · change q ∈ (daiLiKGeDInternalSideCandidates P embedding threshold d w
      (gridOrigin w t) (fun _ => [])).biUnion
        (fun side => (daiLiKGeDInternalSideFamily P embedding threshold w ell t
          (daiLiBadGridCells P embedding threshold d w (gridOrigin w t))
          (fun _ => []) side).selected) at hInternal
    rcases Finset.mem_biUnion.mp hInternal with ⟨side, hSide, _⟩
    have hBad := (mem_daiLiKGeDInternalSideCandidates_iff P embedding threshold d w
      (gridOrigin w t) (fun _ => []) side.1 side.2).1 hSide |>.1
    simpa [hNoBad] using hBad
end QEC.Locality
