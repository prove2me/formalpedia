        rw [hEq]
      _ = G ^ 10 * (PowerSeries.X * F ^ 6 * (1 - 11 * Y - Y ^ 2)) := by
        rw [hcore]
        ring
  exact ((isUnit_pentagonal023SeriesPS_rat.pow 10).mul_right_inj.mp hmul)
