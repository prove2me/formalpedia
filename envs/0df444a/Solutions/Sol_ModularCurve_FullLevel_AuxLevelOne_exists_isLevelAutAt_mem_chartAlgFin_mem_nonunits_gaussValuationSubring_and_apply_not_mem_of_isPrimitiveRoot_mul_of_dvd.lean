theorem solution
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')

    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ12 : ℓ % 12 = 11) (hℓM' : ℓ ∣ M')
    (L : Type) [Field L] [CharZero L] [IsCyclotomicExtension {q * ℓ} ℚ L]
    (ζ : L) (hζ : IsPrimitiveRoot ζ q)
    (ξ : L) (hξ : IsPrimitiveRoot ξ (q * ℓ))
    (hζξ : ζ = ξ ^ ℓ)
    (H₁ : Subgroup (ZMod (q ^ 2 * M'))ˣ)
    (hH₁ : H₁ = ModularCurve.FullLevel.levelH q M' ⊓ (ZMod.unitsMap (Dvd.dvd.mul_left hℓM' (q ^ 2))).ker)
    (K : IntermediateField L (LaurentSeries L))
    (hK : K = ModularCurve.laurentBaseChange L (ModularCurve.xHFunctionField (q ^ 2 * M') H₁))
    (A : Type) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [Algebra A L] [IsFractionRing A L]
    (hAq : (q : A) ∈ IsLocalRing.maximalIdeal A) (hζA : ∃ x : A, algebraMap A L x = ζ)
    [Algebra A ↥K] [IsScalarTower A L ↥K]
    (j : ↥K) (hj : ((j : LaurentSeries L)) = ModularCurve.coeffEmb L ModularCurve.jq) [Fact (j ≠ 0)]
    (ϖ : A) (hϖ : IsLocalRing.maximalIdeal A = Ideal.span {ϖ})

    (W₀ : ValuationSubring ↥K)
    (hW₀ : ∀ f : ↥K, f ∈ W₀ ↔ ∃ x y : PowerSeries A, y.map (IsLocalRing.residue A) ≠ 0 ∧
      (f : LaurentSeries L) * HahnSeries.ofPowerSeries ℤ L (y.map (algebraMap A L))
        = HahnSeries.ofPowerSeries ℤ L (x.map (algebraMap A L))) :
    ∃ (γ : SL(2, ℤ)) (_ : γ ∈ CongruenceSubgroup.Gamma ℓ) (_ : γ ∈ CongruenceSubgroup.Gamma0 M')
      (τ : ↥K ≃ₐ[L] ↥K) (_ : ModularCurve.FullLevel.IsLevelAutAt L q ζ q (q ^ 2 * M') H₁ γ⁻¹ K τ)
      (H : ↥K), H ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin A (↥K) j ∧ H ∈ W₀.nonunits ∧ τ H ∉ W₀.nonunits := by
  classical
  haveI hqne : NeZero q := ⟨(Fact.out : q.Prime).ne_zero⟩
  obtain ⟨γ, hγℓ, hγM, τ, hτ, H, hHC, u₁, u₂, c, ζ', c', j₂, ⟨x₁, y₁, hx₁, hy₁, hu₁⟩, ⟨x₂, y₂, hx₂, hy₂, hu₂⟩,
      hc, hζ'c, hζ', hj₂, hj₂q, hH, hτH⟩ :=
    ModularCurve.FullLevel.AuxLevelOne.exists_isLevelAutAt_mem_chartAlgFin_coe_eq_tateToricPoint_sub_and_apply_eq_of_isPrimitiveRoot_mul_of_dvd
      q M' hqM' ℓ hℓ12 hℓM' L ζ hζ ξ hξ hζξ H₁ hH₁ K hK A hAq hζA j hj ϖ hϖ
  refine ⟨γ, hγℓ, hγM, τ, hτ, H, hHC, ?_⟩

  obtain ⟨D, hDcoef, hD⟩ :=
    ModularCurve.exists_powerSeries_forall_coeff_mem_span_sub_one_ofPowerSeries_eq_tateToricPoint_mul_sub_tateToricPoint
      L A q c ζ' hc hζ'c
  obtain ⟨E, hEred, hE⟩ :=
    ModularCurve.exists_powerSeries_map_residue_ne_zero_ofPowerSeries_eq_tateToricPoint_sub_nonToricPoint_units
      L A q c hc c' j₂ hj₂ hj₂q
  rw [← hD] at hH
  rw [← hE] at hτH

  have hinjAL : Function.Injective (algebraMap A L) := IsFractionRing.injective A L
  have hcoeC : ∀ c : L, ((algebraMap L ↥K c : ↥K) : LaurentSeries L) = HahnSeries.C c := by
    intro c
    rw [SubalgebraClass.coe_algebraMap, algebraMap_laurentSeries_eq_single, HahnSeries.C_apply]
  have hcoeA : ∀ a : A, ((algebraMap A ↥K a : ↥K) : LaurentSeries L) = HahnSeries.C (algebraMap A L a) := by
    intro a; rw [IsScalarTower.algebraMap_apply A L ↥K, hcoeC]
  have hofC : ∀ a : A, HahnSeries.ofPowerSeries ℤ L ((PowerSeries.C a).map (algebraMap A L)) =
      HahnSeries.C (algebraMap A L a) := by
    intro a; rw [PowerSeries.map_C, HahnSeries.ofPowerSeries_C]
  have hmapinj : ∀ x y : PowerSeries A, x.map (algebraMap A L) = y.map (algebraMap A L) → x = y := by
    intro x y h
    ext n
