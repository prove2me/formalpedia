    have e := NLogN.KFM.getElem?_oprod Δ (NLogN.KFM.axTab Δ (s (Fin.last d)) (t (Fin.last d))) hl
      (NLogN.KFM.chirpArr Δ d (fun i => s i.castSucc) (fun i => t i.castSucc))
