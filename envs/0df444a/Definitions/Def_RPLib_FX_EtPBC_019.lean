  {J : Type u₃} [Category.{v₃} J]
  (L : C ⥤ D) [L.Additive] [PreservesFiniteLimits L] [PreservesFiniteColimits L]
  (A : J ⥤ C) (B : D) (u : ∀ j, B ⟶ L.obj (A.obj j))

theorem mem_bcImg [IsCofiltered J] (hu : ∀ {j j' : J} (a : j' ⟶ j), u j' ≫ L.map (A.map a) = u j) (F : C)
    (q : ℕ) (β : Ext B (L.obj F) q) :
    β ∈ bcImg L A B u hu F q ↔ ∃ (j : J) (α : Ext (A.obj j) F q), bc L A B u j F q α = β := Iff.rfl

theorem surjAt_iff_bcImg [IsCofiltered J] (hu : ∀ {j j' : J} (a : j' ⟶ j), u j' ≫ L.map (A.map a) = u j)
    (F : C) (q : ℕ) : SurjAt L A B u q F ↔ ∀ β, β ∈ bcImg L A B u hu F q := Iff.rfl

