theorem J6Seg.PJ.Rn.serPs {v : Vr} {c : Cs} (hF : Fx Q kk m mw cB v) (hS : StS m L Mf c)
    (hB : BdS W m L Mf) (hLm : L.length = m) (hv : BV W v) (hc50 : c 50 = []) (hc51 : c 51 = [])
    (hW8 : 8 * (m + 1) ^ 2 ≤ 2 ^ W) :
    Rn J6Seg.PJ.serP v c (fun v' =>
      (∀ i ∉ ([1, 2, 3, 4, 5, 6, 7, 8, 22, 23, 29] : List (Fin HS)), v' i = v i) ∧
      v' 22 = (flN cB L m : ℤ) ∧ v' 23 = ((serL Q kk m mw cB L Mf).length : ℤ) ∧ BV W v')
      (update c 41 ((serL Q kk m mw cB L Mf).reverse ++ c 41)) (cSer W m) := by sorry
