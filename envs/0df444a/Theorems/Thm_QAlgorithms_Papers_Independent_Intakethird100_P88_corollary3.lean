-- title:
--   Weak and trace-norm topologies on the positive cone and normalized states
-- statement:
--   Let $H$ be a complex Hilbert space. Let $\mathcal T_{\mathrm{sa}}^+(H)$ be its cone of positive trace-class operators, and let $\mathcal D(H)$ be the trace-one part of this cone. The weak topology is generated by the trace pairings with bounded self-adjoint operators; the weak operator topology is generated by quadratic forms. Then
--
--   $$
--   \tau_{\mathrm{weak}}|_{\mathcal T_{\mathrm{sa}}^+}
--   =\tau_{\|\cdot\|_1}|_{\mathcal T_{\mathrm{sa}}^+},
--   \qquad
--   \tau_{\mathrm{weak}}|_{\mathcal D}
--   =\tau_{\|\cdot\|_1}|_{\mathcal D}
--   =\tau_{\mathrm{WOT}}|_{\mathcal D}.
--   $$
--
--   The second equality applies to normalized states; it does not identify the weak operator and trace-norm topologies on the entire positive cone.
-- source:
--   Asymptotic state transformations of continuous variable resources, arXiv:2010.00044v3, PDF p. 4, II A: Corollary3

import Definitions.Def_QAlgorithms_Papers_Independent_Intakethird100_P88

noncomputable section

namespace QAlgorithms.Papers.Independent.Intakethird100.P88

open Filter

open QAlgorithms.Papers.Independent.Dependency50.P13

open QAlgorithms.Papers.Independent.Dependency50.P39 (Fock fockKet fockDyad)

open QAlgorithms.Papers.Independent.Information100.P62 (logTwo)

attribute [local instance] Classical.propDecidable

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- PDF p.4, Corollary 3: both cone topologies coincide; on normalized states,
they also coincide with WOT. Hilbert-basis coordinates do not restrict dimension. -/
theorem corollary3 {I : Type*} (b : HilbertBasis I ℂ H) :
    weakPositiveTopology b = normPositiveTopology (H := H) ∧
    weakStateTopology b = stateTraceNormTopology b ∧
    weakOperatorStateTopology b = stateTraceNormTopology b := by sorry

end QAlgorithms.Papers.Independent.Intakethird100.P88

end
