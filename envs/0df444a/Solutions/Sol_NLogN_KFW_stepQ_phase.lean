    simp only [Ex.regs] at h; simp only [Ex.sub, Ex.sub_id σ a h]
  | .sel c x y, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.sub, Ex.sub_id σ c (fun i hi => h i (Or.inl (Or.inl hi))),
