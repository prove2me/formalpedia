section slice

variable {F : ℝ → ℝ → ℂ} {f : Pt 4 → ℂ}

theorem cpdC_r (hf : ∀ y, f y = F (y 1) (y 2)) (x : Pt 4) {d : ℂ}
    (h : HasDerivAt (fun u => F u (x 2)) d (x 1)) : cpdC 1 f x = d := by
  unfold cpdC
  have e : (fun u => f (Function.update x 1 u)) = fun u => F u (x 2) := funext fun u => by
    rw [hf]; simp [Function.update_apply]
  rw [e]; exact h.deriv

theorem cpdC_th (hf : ∀ y, f y = F (y 1) (y 2)) (x : Pt 4) {d : ℂ}
    (h : HasDerivAt (fun u => F (x 1) u) d (x 2)) : cpdC 2 f x = d := by
  unfold cpdC
  have e : (fun u => f (Function.update x 2 u)) = fun u => F (x 1) u := funext fun u => by
    rw [hf]; simp [Function.update_apply]
  rw [e]; exact h.deriv

theorem cpdC_t (hf : ∀ y, f y = F (y 1) (y 2)) (x : Pt 4) : cpdC 0 f x = 0 := by
  unfold cpdC
  have e : (fun u => f (Function.update x 0 u)) = fun _ => F (x 1) (x 2) := funext fun u => by
    rw [hf]; simp [Function.update_apply]
  rw [e]; exact deriv_const _ _

theorem cpdC_ph (hf : ∀ y, f y = F (y 1) (y 2)) (x : Pt 4) : cpdC 3 f x = 0 := by
  unfold cpdC
  have e : (fun u => f (Function.update x 3 u)) = fun _ => F (x 1) (x 2) := funext fun u => by
    rw [hf]; simp [Function.update_apply]
  rw [e]; exact deriv_const _ _

