theorem solution (m : TypeDensity.ConcreteMember) (c : m.cellIndex) :
    Nonempty (TypeDensity.CellChildData m c) := by
  obtain ⟨e, he, heZ⟩ := TypeDensity.exceptional_line_equiv_residue_field m.O m.R m.S
  have hinf : (TypeDensity.infinityPoint m.R m.S.t m.S.x).IsPrime :=
    (TypeDensity.infinity_point_maximal m.O m.R m.S).1.isPrime
  have : Finite (IsLocalRing.ResidueField m.R) := Finite.of_equiv _ m.S.residueEquiv.toEquiv
