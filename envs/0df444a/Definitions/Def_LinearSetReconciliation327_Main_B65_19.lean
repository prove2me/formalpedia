          (MemoryFrame.update_allowed _ _ 111 fs.length (by left; dsimp [rootEmissionMeta]; omega)))
        (MemoryFrame.update_allowed _ _ 100 1 (by left; dsimp [rootEmissionMeta]; omega)))
      (MemoryFrame.update_allowed _ _ 101 0 (by left; dsimp [rootEmissionMeta]; omega))
  have hv1 : RootEmissionView b N ι BQ cap B fs [] fs m1 := by
