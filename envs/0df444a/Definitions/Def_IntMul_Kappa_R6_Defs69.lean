open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

/-! ## The block offset -/

def eKc : E := .add (.mul (.r 24) (.add (.r 8) (.r 8))) (.r 8)
def eJc : E := .dv (.add (.mul (.mul (.k 2) (.r 3)) eKc) (.r 4)) (.mul (.k 2) (.r 4))
def eA0 : E := .sub (.mul (.r 4) (.sub eJc (.r 9))) (.mul (.r 3) eKc)

/-! ## The header -/

def eW2 : E := .add (.r 9) (.r 9)
def eBk : E := .add (.r 8) (.r 8)
def eWin : E := .mul (.k 8) (.r 8)

/-- `|tab|` and the header `aHdr2`, in reading order. -/
def hdrE : List E :=
  [.add (.mul (.k 4) (.add (.r 9) (.r 8))) (.k 17),
   .add (.add eW2 eBk) eW2, eW2, .mul (.k 2) (.sel (.sub eWin eW2) (.k 0) (.sub eWin eW2)),
   .mul (.k 2) eBk, .mul (.k 2) eW2, eBk, .mul (.k 2) (.sub eWin eBk), .add eW2 eBk,
   .mul (.k 2) (.add eW2 eBk), .r 12, .mul (.k 2) (.r 12), .r 20, .mul (.k 2) (.add eW2 eBk),
   .r 22, .r 21, .r 23, .k 1]

/-! ## The block body -/

def e2W : E := .add (.r 9) (.r 9)
def e2W2H : E := .add (.add (.r 9) (.r 9)) (.add (.r 8) (.r 8))
def e2H : E := .add (.r 8) (.r 8)

/-- **The block body.** -/
def blockB : RS :=
  .seq (.asg 25 eA0.ex) (.seq (pushes sS hdrE) (.seq (.asg 10 e2W.ex) (.seq loopA
    (.seq (.asg 10 e2W2H.ex) (.seq loopR (.seq (.asg 10 e2H.ex) loopC))))))

def cBlock (W p α : ℕ) : ℕ :=
  cT eA0.ex W + (cPushes W hdrE + (cT e2W.ex W + (cFor W (2 * J6A.WA p α (HAx p α)) (cBodyA W) +
    (cT e2W2H.ex W + (cFor W (2 * J6A.WA p α (HAx p α) + 2 * HAx p α) (cBodyR W) +
    (cT e2H.ex W + cFor W (2 * HAx p α) (cBodyC W)))))))

