theorem solution {st : Fin m × κ → ℕ} {n : ℕ} (h : NLogN.KFN.SLaws st n) (T : Butterfly.Op κ) :
    ∀ (l : List (P8Lift.RStep (Fin W) m)) (X : Fin W → List M), (∀ w, (X w).length = n) →
      NLogN.KFN.roleOpF st n (P8Lift.denListR T l) X = NLogN.KFN.runSteps st n T l X := by
