-- Source module: Solutions.AModelNet
/-!
# Row streams and the gate network (Stage 3 of the interchange procedure)

1. Cyclic row split / merge (primitive (b)) on shapes `P :: (W * L) :: rest`:
   row `r = W * g + w` of the big array becomes row `g` of stream `w`.
2. The abstract network theorem: a circuit of pointwise linear gates, executed physically with
   frame changes `Φ (M_g - label)` on every wire, realizes `Φ I0` on every wire, routed by `ρ`.
3. The combination: split, run the network with `Φ_M = pull` by `π_M` on the `rest` digits, merge
   back with `ρ` undone; this equals the `pull` of the whole array by `π_{I0}` on the `rest` digits.
-/

namespace AModel

open Matrix

/-! ## 1. Cyclic row split and merge -/

section RowSplit

variable {α : Type*}

@[simp] lemma length_rowSplit (P W L : ℕ) (rest : Shape) (w : Fin W) (d : α) (xs : List α) :
    (rowSplit P W L rest w d xs).length = vol (P :: L :: rest) := by
  simp [rowSplit]

@[simp] lemma length_rowMerge (P W L : ℕ) [NeZero W] (rest : Shape) (d : α)
    (s : Fin W → List α) : (rowMerge P W L rest d s).length = vol (P :: W * L :: rest) := by
  simp [rowMerge]

lemma valid_rowSplitAddr {P W L : ℕ} {rest : Shape} {w : ℕ} (hw : w < W) {a : List ℕ}
    (ha : Valid (P :: L :: rest) a) : Valid (P :: W * L :: rest) (rowSplitAddr W w a) := by
  obtain ⟨p, q, x, rfl, hp, hq, hx⟩ := valid_cons2 ha
  refine valid_cons2_mk hp ?_ hx
  simp only [List.tail_cons, List.headD_cons]
  have := Nat.mul_le_mul_left W (show q + 1 ≤ L from hq)
  rw [Nat.mul_succ] at this
  omega

lemma valid_rowMergeAddr {P W L : ℕ} [NeZero W] {rest : Shape} {a : List ℕ}
    (ha : Valid (P :: W * L :: rest) a) : Valid (P :: L :: rest) (rowMergeAddr W a) := by
  obtain ⟨p, q, x, rfl, hp, hq, hx⟩ := valid_cons2 ha
  refine valid_cons2_mk hp ?_ hx
  exact (Nat.div_lt_iff_lt_mul (NeZero.pos W)).2 (by rw [Nat.mul_comm]; exact hq)

lemma rowSplitAddr_rowMergeAddr {W : ℕ} [NeZero W] (a : List ℕ) (ha : 2 ≤ a.length) :
    rowSplitAddr W (rowIdx W a) (rowMergeAddr W a) = a := by
  match a, ha with
  | p :: q :: x, _ => simp [rowSplitAddr, rowMergeAddr, rowIdx, Nat.div_add_mod]

lemma two_le_length_of_valid {P Q : ℕ} {sh : Shape} {a : List ℕ}
    (h : Valid (P :: Q :: sh) a) : 2 ≤ a.length := by
  obtain ⟨p, q, x, rfl, -⟩ := valid_cons2 h
  simp

/-- merge ∘ split = id. -/
theorem rowMerge_rowSplit (P W L : ℕ) [NeZero W] (rest : Shape) (d : α) {xs : List α}
    (hxs : xs.length = vol (P :: W * L :: rest)) :
    rowMerge P W L rest d (fun w => rowSplit P W L rest w d xs) = xs := by
  apply List.ext_getElem (by simp [hxs])
  intro j h₁ h₂
  simp only [length_rowMerge] at h₁
  have hv := valid_decode h₁
  have hm := valid_rowMergeAddr hv
  have hlt := encode_lt hm
  simp only [rowMerge, List.getElem_map, List.getElem_range]
  simp only [rowSplit]
  rw [List.getD_eq_getElem _ _ (by simpa using hlt), getElem_pull, decode_encode hm,
    rowSplitAddr_rowMergeAddr _ (two_le_length_of_valid hv), encode_decode h₁,
    List.getD_eq_getElem]

/-- `rowSplit` commutes with a pull acting only on the `rest` digits. -/
theorem rowSplit_pull_rowLift (P W L : ℕ) (rest : Shape) (w : Fin W) (g : List ℕ → List ℕ)
    (hg : ∀ x, Valid rest x → Valid rest (g x)) (d : α) (xs : List α) :
    rowSplit P W L rest w d (pull (P :: W * L :: rest) (P :: W * L :: rest) (rowLift g) d xs) =
      pull (P :: L :: rest) (P :: L :: rest) (rowLift g) d (rowSplit P W L rest w d xs) := by
  unfold rowSplit
  rw [pull_comp _ _ (fun a ha => valid_rowSplitAddr w.isLt ha),
    pull_comp _ _ (fun a ha => valid_rowLift hg ha)]
  rfl

end RowSplit

