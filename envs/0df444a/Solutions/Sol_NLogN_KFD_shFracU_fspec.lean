      simp only [hne, if_false, Function.update_of_ne hji]
      have hd := hD.digit_lt Λ j
      have hkl : k < D.length := by simpa using h1
      simp only [act, ZMod.val_natCast, Nat.mod_eq_of_lt hd]
      rw [List.getD_eq_getElem _ _ (by omega)]
