section transport
variable {E₁ V₁ E₂ V₂ : Type} [Fintype E₁] [DecidableEq V₁] [Fintype E₂] [DecidableEq V₂]
  {D₁ : DegeneracyData E₁ V₁} {D₂ : DegeneracyData E₂ V₂}
  {K L : Type} [Field K] [Field L] [Algebra K L] {ord : Additive Kˣ →+ ℤ}

def pdTransport (P : PeriodDatum D₁ K L ord) (e : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₂))
    (hiso : ∀ x y : ↥(ribbonKernel D₁), ribbonGram D₂ (e x) (e y) = ribbonGram D₁ x y) :
    PeriodDatum D₂ K L ord where
  Q := P.Q.compl₁₂ e.symm.toLinearMap e.symm.toLinearMap
  Q_symm x y := by simp only [LinearMap.compl₁₂_apply]; exact P.Q_symm _ _
  ord_Q x y := by
    simp only [LinearMap.compl₁₂_apply, LinearEquiv.coe_coe]
    rw [P.ord_Q, ← hiso, LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]

@[scoped simp] theorem pdTransport_Q (P : PeriodDatum D₁ K L ord) (e : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₂))
    (hiso : ∀ x y : ↥(ribbonKernel D₁), ribbonGram D₂ (e x) (e y) = ribbonGram D₁ x y)
    (x y : ↥(ribbonKernel D₂)) :
    (pdTransport P e hiso).Q x y = P.Q (e.symm x) (e.symm y) := rfl

def torusPull (P : PeriodDatum D₁ K L ord) (e : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₂))
    (hiso : ∀ x y : ↥(ribbonKernel D₁), ribbonGram D₂ (e x) (e y) = ribbonGram D₁ x y) :
    (pdTransport P e hiso).TorusPoints →ₗ[ℤ] P.TorusPoints :=
  LinearMap.lcomp ℤ (Additive Lˣ) e.toLinearMap

@[scoped simp] theorem torusPull_apply (P : PeriodDatum D₁ K L ord) (e : ↥(ribbonKernel D₁) ≃ₗ[ℤ] ↥(ribbonKernel D₂))
    (hiso : ∀ x y : ↥(ribbonKernel D₁), ribbonGram D₂ (e x) (e y) = ribbonGram D₁ x y)
    (u : (pdTransport P e hiso).TorusPoints) (z : ↥(ribbonKernel D₁)) :
    torusPull P e hiso u z = u (e z) := rfl

end transport
