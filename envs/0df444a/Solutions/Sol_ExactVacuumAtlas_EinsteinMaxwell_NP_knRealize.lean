variable {M a Q : ℝ}
theorem solution {U : Set (Pt 4)} (hU : IsOpen U) (hUD : U ⊆ domReg M a Q) {h : Metric 4} {f : TwoForm 4}
    {B : Fin 4 → Fin 4 → Pt 4 → ℂ} (ht : RealFrameTangent (gKN M a Q) (knE M a Q) U h f B) :
    ∃ (g gi : ℝ → Metric 4) (F : ℝ → TwoForm 4) (E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ) (W : Set (ℝ × Pt 4)),
      KNFam M a Q g gi F E Θ W ∧ NPTangent g F E W h f B ∧ {y | ((0 : ℝ), y) ∈ W} = U := by
  have hN := (nullFrameData_KN M a Q).restrict hU hUD
  have hR0 : RealPattern (knE M a Q) U := fun y _ A μ => knE_swap M a Q A μ y
  obtain ⟨hFam, hT, hg0, hgi0, hF0, hE0, hΘ0, hsl⟩ := realize hN ht hR0
    (fun i j => ((KN.certReg M a Q).smooth_F i j).mono hUD) (fun y hy => (KN.certReg M a Q).antisymm y (hUD hy))
  refine ⟨_, _, _, _, _, _, ⟨hFam, hg0, hgi0, hF0, hE0, hΘ0, fun y hy => hUD ?_⟩, hT, hsl⟩
  rw [← hsl]; exact hy
