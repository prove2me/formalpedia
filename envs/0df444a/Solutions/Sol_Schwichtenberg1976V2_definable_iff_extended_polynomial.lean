-- ===== Proofs/Schwichtenberg1976V2/Basic.lean =====
/-!
# Basic facts about the Schwichtenberg 1976 (V2) λ-calculus

Free variables, β-normality, and inversion and uniqueness of typing.
-/

namespace Schwichtenberg1976V2.Proofs

open Schwichtenberg1976V2

/-! ## Constructive list facts

Core's `List.eq_nil_iff_forall_not_mem` is proved classically, so we use our own version. -/

theorem eq_nil_of_forall_not_mem {α : Type} {l : List α} (h : ∀ x, x ∉ l) : l = [] := by
  cases l with
  | nil => rfl
  | cons a l => exact absurd (List.mem_cons_self ..) (h a)

/-- Every term is an abstraction or is not, decided by its head constructor. -/
theorem lam_or_not (s : Term) : (∃ x c, s = .lam x c) ∨ (∀ x c, s ≠ .lam x c) := by
  cases s with
  | lam x c => exact Or.inl ⟨x, c, rfl⟩
  | var v => exact Or.inr fun _ _ h => Term.noConfusion h
  | app p q => exact Or.inr fun _ _ h => Term.noConfusion h

/-! ## Free variables -/

theorem mem_eraseDupsBy_loop (v : Var) (as : List Var) :
    ∀ acc : List Var, v ∈ List.eraseDupsBy.loop (· == ·) as acc ↔ v ∈ as ∨ v ∈ acc := by
  induction as with
  | nil =>
      intro acc
      simp [List.eraseDupsBy.loop]
  | cons a as ih =>
      intro acc
      rw [List.eraseDupsBy.loop]
      cases h : acc.any (fun x => a == x)
      · rw [ih (a :: acc), List.mem_cons, List.mem_cons]
        exact ⟨
          fun
            | Or.inl h1 => Or.inl (Or.inr h1)
            | Or.inr (Or.inl h2) => Or.inl (Or.inl h2)
            | Or.inr (Or.inr h3) => Or.inr h3,
          fun
            | Or.inl (Or.inl h1) => Or.inr (Or.inl h1)
            | Or.inl (Or.inr h2) => Or.inl h2
            | Or.inr h3 => Or.inr (Or.inr h3)⟩
      · rw [ih acc, List.mem_cons]
        simp only [List.any_eq_true, beq_iff_eq] at h
        rcases h with ⟨x, hx, rfl⟩
        exact ⟨
          fun
            | Or.inl h1 => Or.inl (Or.inr h1)
            | Or.inr h2 => Or.inr h2,
          fun
            | Or.inl (Or.inl rfl) => Or.inr hx
            | Or.inl (Or.inr h1) => Or.inl h1
            | Or.inr h2 => Or.inr h2⟩

/-- Membership in `freeVars t` is membership in `freeVarOccurrences t`. -/
theorem mem_freeVars_iff (t : Term) (v : Var) :
    v ∈ freeVars t ↔ v ∈ freeVarOccurrences t := by
  unfold freeVars List.eraseDups List.eraseDupsBy
  rw [mem_eraseDupsBy_loop]
  simp

@[simp] theorem mem_fvo_var (x v : Var) :
    v ∈ freeVarOccurrences (.var x) ↔ v = x := by
  simp [freeVarOccurrences]

@[simp] theorem mem_fvo_app (t s : Term) (v : Var) :
    v ∈ freeVarOccurrences (.app t s) ↔
      v ∈ freeVarOccurrences t ∨ v ∈ freeVarOccurrences s := by
  simp [freeVarOccurrences]

@[simp] theorem mem_fvo_lam (x : Var) (t : Term) (v : Var) :
    v ∈ freeVarOccurrences (.lam x t) ↔ v ∈ freeVarOccurrences t ∧ v ≠ x := by
  simp [freeVarOccurrences]

/-- Every free variable identifier is bounded by the maximum identifier of the term. -/
theorem freeVar_id_le_maxVarId (t : Term) (v : Var)
    (h : v ∈ freeVarOccurrences t) : v.id ≤ maxVarId t := by
  induction t with
  | var x =>
      simp [freeVarOccurrences, maxVarId] at h ⊢
      subst h
      exact Nat.le_refl _
  | app r s ihr ihs =>
      simp [freeVarOccurrences, maxVarId, Nat.max_def] at h ⊢
      rcases h with hr | hs
      · have := ihr hr; split <;> omega
      · have := ihs hs; split <;> omega
  | lam x r ih =>
      simp [freeVarOccurrences, maxVarId, Nat.max_def] at h ⊢
      have := ih h.1; split <;> omega

/-! ## β-normal forms -/

theorem isBetaNormal_app {a b : Term} (h : IsBetaNormal (.app a b)) :
    (∀ x c, a ≠ .lam x c) ∧ IsBetaNormal a ∧ IsBetaNormal b := by
  unfold IsBetaNormal at *
  cases a with
  | lam x c => simp [hasBetaRedex] at h
  | var v =>
      simp only [hasBetaRedex, Bool.false_or] at h
      exact ⟨fun _ _ hc => Term.noConfusion hc, rfl, h⟩
  | app p q =>
      simp only [hasBetaRedex, Bool.or_eq_false_iff] at h
      exact ⟨fun _ _ hc => Term.noConfusion hc, by simpa [hasBetaRedex] using h.1, h.2⟩

theorem isBetaNormal_lam {x : Var} {b : Term} (h : IsBetaNormal (.lam x b)) :
    IsBetaNormal b := by
  unfold IsBetaNormal at *
  simpa [hasBetaRedex] using h

/-! ## Typing -/

theorem hasType_var_inv {x : Var} {τ : Ty} (h : HasType (.var x) τ) : τ = x.ty := by
  cases h; rfl

theorem hasType_app_inv {t s : Term} {τ : Ty} (h : HasType (.app t s) τ) :
    ∃ σ, HasType t (.arr σ τ) ∧ HasType s σ := by
  cases h with
  | app ht hs => exact ⟨_, ht, hs⟩

theorem hasType_lam_inv {x : Var} {b : Term} {τ : Ty} (h : HasType (.lam x b) τ) :
    ∃ ρ, τ = .arr x.ty ρ ∧ HasType b ρ := by
  cases h with
  | lam _ hb => exact ⟨_, rfl, hb⟩

/-- Types are unique: the calculus is Church-style. -/
theorem hasType_unique {t : Term} {τ τ' : Ty} (h : HasType t τ) (h' : HasType t τ') :
    τ = τ' := by
  induction h generalizing τ' with
  | var x => exact (hasType_var_inv h').symm
  | app ht hs iht ihs =>
      obtain ⟨σ', ht', hs'⟩ := hasType_app_inv h'
      have := iht ht'
      injection this
  | lam x hb ih =>
      obtain ⟨ρ', rfl, hb'⟩ := hasType_lam_inv h'
      rw [ih hb']

/-! ## The type-`0 → 0` grammar -/

theorem chain_ty {Fs : List Var} {α z : Var} {t : Term}
    (h : IsBasicType00Chain Fs α z t) : z.ty = .zero := by
  induction t generalizing z with
  | var v =>
      cases h with
      | base _ hz => exact hz
  | app a b _ ihb =>
      cases h with
      | step _ hb => exact ihb hb
  | lam x b _ => cases h

theorem basic_of_type00_not_lam {Fs : List Var} {α : Var} {t : Term}
    (h : IsType00Subterm Fs α t) (hnl : ∀ x c, t ≠ .lam x c) : IsBasicType00 Fs α t := by
  cases h with
  | basic hb => exact hb
  | chainLam y z _ _ _ => exact absurd rfl (hnl y _)

end Schwichtenberg1976V2.Proofs

-- ===== Proofs/Schwichtenberg1976V2/Reduction.lean =====
/-!
# Reduction toolkit: substitution, iteration and Church numerals

Equations for `substTerm`, `renameFreeVar` and `substMany` on the term shapes that occur
when Church numerals are applied, and the basic reductions:

* `n̄ t ⊳ λu. tⁿ u` for a binder `u` of type `0` that is not free in `t`;
* `(λy. α^Q y)ⁿ u ⊳ α^{n·Q} u`, the "bound" case;
* `(λy. α^Q w)^{n+1} u ⊳ α^Q w` for `w ≠ y`, the "constant" case.

Every substitution here is into a term without abstractions or into a closed numeral, so all
equations hold literally, not just up to α-equivalence.
-/

namespace Schwichtenberg1976V2.Proofs

open Schwichtenberg1976V2

/-! ## Reflexivity -/

theorem ReducesTo.rfl' (t : Term) : ReducesTo t t := .refl_alpha (.refl t)

/-! ## Equations for `substTerm` -/

theorem subst_var (v x : Var) (s : Term) :
    substTerm (.var v) x s = if v = x then s else .var v := by
  rw [substTerm]; simp

theorem subst_app (a b : Term) (x : Var) (s : Term) :
    substTerm (.app a b) x s = .app (substTerm a x s) (substTerm b x s) := by
  rw [substTerm]

theorem subst_lam_self (x : Var) (b s : Term) :
    substTerm (.lam x b) x s = .lam x b := by
  rw [substTerm]; simp

theorem subst_lam_fresh {v x : Var} (b s : Term) (hvx : v ≠ x)
    (hv : v ∉ freeVarOccurrences s) :
    substTerm (.lam v b) x s = .lam v (substTerm b x s) := by
  rw [substTerm]; simp [hvx, hv]

theorem subst_lam_capture {v x : Var} (b s : Term) (hvx : v ≠ x)
    (hv : v ∈ freeVarOccurrences s) :
    substTerm (.lam v b) x s =
      let v' : Var := ⟨Nat.max (maxVarId b) (Nat.max (maxVarId s) x.id) + 1, v.ty⟩
      .lam v' (substTerm (renameFreeVar b v v') x s) := by
  rw [substTerm]; simp [hvx, hv]

/-- Substituting into a term in which `x` is not free, with a closed term, changes nothing. -/
theorem subst_closed_of_not_mem {s : Term} (hs : freeVarOccurrences s = []) :
    ∀ (t : Term) (x : Var), x ∉ freeVarOccurrences t → substTerm t x s = t := by
  intro t
  induction t with
  | var v =>
      intro x hx
      rw [subst_var]
      have : v ≠ x := by intro h; subst h; simp at hx
      simp [this]
  | app a b iha ihb =>
      intro x hx
      simp only [mem_fvo_app, not_or] at hx
      rw [subst_app, iha x hx.1, ihb x hx.2]
  | lam v b ih =>
      intro x hx
      by_cases hvx : v = x
      · subst hvx; exact subst_lam_self _ _ _
      · rw [subst_lam_fresh b s hvx (by simp [hs]), ih x]
        intro hxb
        exact hx ((mem_fvo_lam v b x).2 ⟨hxb, fun h => hvx h.symm⟩)

/-! ## Iterated application -/

theorem iterApp_succ (a b : Term) (n : Nat) :
    iterApp a b (n + 1) = .app a (iterApp a b n) := rfl

theorem iterApp_add (a b : Term) (m : Nat) :
    ∀ n, iterApp a (iterApp a b m) n = iterApp a b (n + m) := by
  intro n
  induction n with
  | zero => simp [iterApp]
  | succ n ih =>
      rw [iterApp_succ, ih, show n + 1 + m = (n + m) + 1 by omega, iterApp_succ]

theorem subst_iterApp (a b : Term) (x : Var) (s : Term) :
    ∀ n, substTerm (iterApp a b n) x s = iterApp (substTerm a x s) (substTerm b x s) n := by
  intro n
  induction n with
  | zero => rfl
  | succ n ih => rw [iterApp_succ, subst_app, ih, iterApp_succ]

theorem mem_fvo_iterApp (a b : Term) (v : Var) :
    ∀ n, v ∈ freeVarOccurrences (iterApp a b n) ↔
      (0 < n ∧ v ∈ freeVarOccurrences a) ∨ v ∈ freeVarOccurrences b := by
  intro n
  induction n with
  | zero => simp [iterApp]
  | succ n ih =>
      rw [iterApp_succ, mem_fvo_app, ih]
      constructor
      · rintro (h | ⟨_, h⟩ | h)
        · exact Or.inl ⟨by omega, h⟩
        · exact Or.inl ⟨by omega, h⟩
        · exact Or.inr h
      · rintro (⟨_, h⟩ | h)
        · exact Or.inl h
        · exact Or.inr (Or.inr h)

theorem allVars_iterApp_var (a b : Var) (v : Var) :
    ∀ n, v ∈ allVars (iterApp (.var a) (.var b) n) → v = a ∨ v = b := by
  intro n
  induction n with
  | zero => simp only [iterApp, allVars, List.mem_singleton]; exact Or.inr
  | succ n ih =>
      intro h
      rw [iterApp_succ] at h
      simp only [allVars, List.mem_append, List.mem_singleton] at h
      rcases h with h | h
      · exact Or.inl h
      · exact ih h

theorem rename_iterApp_var {a b : Var} (c : Var) (hab : a ≠ b) :
    ∀ n, renameFreeVar (iterApp (.var a) (.var b) n) b c = iterApp (.var a) (.var c) n := by
  intro n
  induction n with
  | zero => simp [iterApp, renameFreeVar]
  | succ n ih =>
      rw [iterApp_succ, iterApp_succ, renameFreeVar, ih]
      simp [renameFreeVar, hab]

/-- `(λu. a^m u)` and `(λz. a^m z)` are α-equivalent. -/
theorem alpha_lam_iterApp {a u z : Var} (m : Nat) (hty : u.ty = z.ty)
    (hau : a ≠ u) (haz : a ≠ z) :
    AlphaEq (.lam u (iterApp (.var a) (.var u) m)) (.lam z (iterApp (.var a) (.var z) m)) := by
  have h := AlphaEq.lam_rename u z (iterApp (.var a) (.var u) m) hty (by
    by_cases hzu : z = u
    · exact Or.inl hzu
    · refine Or.inr fun hz => ?_
      rcases allVars_iterApp_var a u z m hz with h | h
      · exact haz h.symm
      · exact hzu h)
  rwa [rename_iterApp_var z hau] at h

/-! ## Church numerals -/

/-- The variables used inside `churchNumeral`. -/
def numα : Var := ⟨1, Ty.endo⟩
def numx : Var := ⟨0, .zero⟩

theorem churchNumeral_eq (n : Nat) :
    churchNumeral n = .lam numα (.lam numx (iterApp (.var numα) (.var numx) n)) := rfl

theorem fvo_churchNumeral (n : Nat) : freeVarOccurrences (churchNumeral n) = [] := by
  rw [churchNumeral_eq]
  refine eq_nil_of_forall_not_mem fun v hv => ?_
  simp only [mem_fvo_lam, mem_fvo_iterApp, mem_fvo_var] at hv
  obtain ⟨⟨h | h, hx⟩, hα⟩ := hv
  · exact hα h.2
  · exact hx h

/-- Applying a Church numeral: `n̄ t ⊳ λu. tⁿ u` with `u : 0` not free in `t`. -/
theorem numeral_app (n : Nat) (t : Term) :
    ∃ u : Var, u.ty = .zero ∧ u ∉ freeVarOccurrences t ∧
      ReducesTo (.app (churchNumeral n) t) (.lam u (iterApp t (.var u) n)) := by
  have hβ := ReducesTo.beta numα (.lam numx (iterApp (.var numα) (.var numx) n)) t
  rw [← churchNumeral_eq] at hβ
  have hxα : numx ≠ numα := by decide
  have hαx : numα ≠ numx := by decide
  by_cases hx : numx ∈ freeVarOccurrences t
  · rw [subst_lam_capture _ _ hxα hx] at hβ
    dsimp only at hβ
    have hne : ∀ m : Nat, numα ≠ (⟨m, numx.ty⟩ : Var) := by
      intro m h
      have := congrArg Var.ty h
      simp [numα, numx, Ty.endo] at this
    rw [rename_iterApp_var _ hαx, subst_iterApp, subst_var, if_pos rfl, subst_var,
      if_neg (fun h => hne _ h.symm)] at hβ
    refine ⟨_, rfl, ?_, hβ⟩
    intro hut
    have hle := freeVar_id_le_maxVarId t _ hut
    have h1 : maxVarId t ≤ Nat.max (maxVarId (iterApp (.var numα) (.var numx) n))
        (Nat.max (maxVarId t) numα.id) :=
      Nat.le_trans (Nat.le_max_left _ _) (Nat.le_max_right _ _)
    dsimp only at hle
    omega
  · rw [subst_lam_fresh _ _ hxα hx, subst_iterApp] at hβ
    rw [subst_var, if_pos rfl, subst_var, if_neg hxα] at hβ
    exact ⟨numx, rfl, hx, hβ⟩

/-! ## Iterating `λy. α^Q y` and `λy. α^Q w` -/

/-- Bound case: `(λy. a^Q y)ⁿ u ⊳ a^{n·Q} u`. -/
theorem iter_bound {a y : Var} (Q : Nat) (hay : a ≠ y) (u : Term) :
    ∀ n, ReducesTo (iterApp (.lam y (iterApp (.var a) (.var y) Q)) u n)
      (iterApp (.var a) u (n * Q)) := by
  intro n
  induction n with
  | zero => simpa [iterApp] using ReducesTo.rfl' u
  | succ n ih =>
      rw [iterApp_succ]
      refine .trans (.app (ReducesTo.rfl' _) ih) ?_
      have hβ := ReducesTo.beta y (iterApp (.var a) (.var y) Q) (iterApp (.var a) u (n * Q))
      rw [subst_iterApp, subst_var, if_neg hay, subst_var, if_pos rfl, iterApp_add] at hβ
      rwa [Nat.succ_mul, Nat.add_comm (n * Q)]

/-- Constant case: `(λy. a^Q w)^{n+1} u ⊳ a^Q w` when `w ≠ y`. -/
theorem iter_const {a y w : Var} (Q : Nat) (hay : a ≠ y) (hwy : w ≠ y) (u : Term) (n : Nat) :
    ReducesTo (iterApp (.lam y (iterApp (.var a) (.var w) Q)) u (n + 1))
      (iterApp (.var a) (.var w) Q) := by
  rw [iterApp_succ]
  have hβ := ReducesTo.beta y (iterApp (.var a) (.var w) Q)
    (iterApp (.lam y (iterApp (.var a) (.var w) Q)) u n)
  rwa [subst_iterApp, subst_var, if_neg hay, subst_var, if_neg hwy] at hβ

/-! ## Sequential substitution of closed terms -/

theorem substMany_app (a b : Term) :
    ∀ l : List (Var × Term),
      substMany (.app a b) l = .app (substMany a l) (substMany b l) := by
  intro l
  induction l generalizing a b with
  | nil => rfl
  | cons p l ih => obtain ⟨x, s⟩ := p; simp only [substMany]; rw [subst_app, ih]

/-- A binder that is not a key passes through a substitution of closed terms. -/
theorem substMany_lam (y : Var) (b : Term) :
    ∀ l : List (Var × Term), (∀ p ∈ l, p.1 ≠ y ∧ freeVarOccurrences p.2 = []) →
      substMany (.lam y b) l = .lam y (substMany b l) := by
  intro l
  induction l generalizing b with
  | nil => intro _; rfl
  | cons p l ih =>
      obtain ⟨x, s⟩ := p
      intro hl
      obtain ⟨hxy, hs⟩ := hl (x, s) (by simp)
      simp only [substMany]
      rw [subst_lam_fresh b s (fun h => hxy h.symm) (by simp [hs])]
      exact ih _ (fun p hp => hl p (by simp [hp]))

theorem substMany_var_of_not_key (x : Var) :
    ∀ l : List (Var × Term), (∀ p ∈ l, p.1 ≠ x) → substMany (.var x) l = .var x := by
  intro l
  induction l with
  | nil => intro _; rfl
  | cons p l ih =>
      obtain ⟨y, s⟩ := p
      intro hl
      have hyx : y ≠ x := hl (y, s) (by simp)
      simp only [substMany]
      rw [subst_var, if_neg (fun h => hyx h.symm)]
      exact ih (fun p hp => hl p (by simp [hp]))

theorem substMany_closed {t : Term} (ht : freeVarOccurrences t = []) :
    ∀ l : List (Var × Term), (∀ p ∈ l, freeVarOccurrences p.2 = []) → substMany t l = t := by
  intro l
  induction l with
  | nil => intro _; rfl
  | cons p l ih =>
      obtain ⟨y, s⟩ := p
      intro hl
      simp only [substMany]
      rw [subst_closed_of_not_mem (hl (y, s) (by simp)) t y (by simp [ht])]
      exact ih (fun p hp => hl p (by simp [hp]))

/-- Looking up an injectively indexed key in a substitution of closed terms. -/
theorem substMany_var_index {k : Nat} (Fs : Fin k → Var) (hinj : Function.Injective Fs)
    (N : Fin k → Term) (hN : ∀ j, freeVarOccurrences (N j) = []) (i : Fin k) :
    ∀ L : List (Fin k),
      substMany (.var (Fs i)) (L.map fun j => (Fs j, N j)) =
        if i ∈ L then N i else .var (Fs i) := by
  intro L
  induction L with
  | nil => simp [substMany]
  | cons j L ih =>
      simp only [List.map_cons, substMany]
      rw [subst_var]
      by_cases hij : i = j
      · subst hij
        rw [if_pos rfl, substMany_closed (hN i) _ (by simp [hN]), if_pos (by simp)]
      · rw [if_neg (fun h => hij (hinj h)), ih]
        simp [hij]

end Schwichtenberg1976V2.Proofs

-- ===== Proofs/Schwichtenberg1976V2/NormalSubterms.lean =====
/-!
# Subterms of a normal term of type `0 → 0` (p. 114, lines 3–13)

Let `r` be a β-normal term of type `0 → 0` whose free variables are among
`F₁, …, Fₖ : ν` and `α : 0 → 0`. Every bound variable of `r` then has type `0`. Every
subterm of `r` has type `0`, `0 → 0` or `ν`. A subterm of type `ν` is one of the `Fᵢ`, and a
subterm of type `0 → 0` is generated by clauses (1)–(3).

The proof tracks the invariant `Good t τ`: `t` is normal, has type `τ`, its free variables
are allowed (an `Fᵢ`, `α`, or of type `0`), and `t` is not an abstraction unless `τ` is `0`
or `0 → 0`. The invariant holds for `r` and passes to immediate subterms.
-/

namespace Schwichtenberg1976V2.Proofs

open Schwichtenberg1976V2

section

variable (Fs : List Var) (α : Var)

/-- A free variable is allowed if it is an `Fᵢ`, the variable `α`, or of type `0`. -/
def Allowed (v : Var) : Prop := v ∈ Fs ∨ v = α ∨ v.ty = .zero

/-- The invariant on (occurrences of) subterms of `r`. -/
def Good (t : Term) (τ : Ty) : Prop :=
  IsBetaNormal t ∧ HasType t τ ∧ (∀ v ∈ freeVarOccurrences t, Allowed Fs α v) ∧
    (τ = .zero ∨ τ = Ty.endo ∨ ∀ x c, t ≠ .lam x c)

end

variable {Fs : List Var} {α : Var}

theorem ty_nu_ne_endo : Ty.nu ≠ Ty.endo := by decide
theorem ty_nu_ne_zero : Ty.nu ≠ .zero := by decide
theorem ty_endo_ne_zero : Ty.endo ≠ .zero := by decide

/-- Neutral terms: a normal non-abstraction with allowed free variables has type `ν`
(and is then an `Fᵢ`), `0 → 0`, or `0`. -/
theorem neutral_shape (hFs : ∀ F ∈ Fs, F.ty = Ty.nu) (hα : α.ty = Ty.endo) :
    ∀ (t : Term) (τ : Ty), IsBetaNormal t → (∀ x c, t ≠ .lam x c) → HasType t τ →
      (∀ v ∈ freeVarOccurrences t, Allowed Fs α v) →
      (τ = Ty.nu ∧ ∃ F ∈ Fs, t = .var F) ∨ τ = Ty.endo ∨ τ = .zero := by
  intro t
  induction t with
  | var v =>
      intro τ _ _ hty hfv
      have hτ := hasType_var_inv hty
      subst hτ
      rcases hfv v (by simp) with hF | hαv | hz
      · exact Or.inl ⟨hFs v hF, v, hF, rfl⟩
      · subst hαv; exact Or.inr (Or.inl hα)
      · exact Or.inr (Or.inr hz)
  | app a b iha _ =>
      intro τ hn _ hty hfv
      obtain ⟨hnl, hna, _⟩ := isBetaNormal_app hn
      obtain ⟨σ, hta, _⟩ := hasType_app_inv hty
      have hfva : ∀ v ∈ freeVarOccurrences a, Allowed Fs α v :=
        fun v hv => hfv v (by simp [hv])
      rcases iha _ hna hnl hta hfva with ⟨h, _⟩ | h | h
      · -- `σ → τ = ν = (0 → 0) → (0 → 0)`
        simp only [Ty.nu] at h
        injection h with _ h2
        exact Or.inr (Or.inl h2)
      · simp only [Ty.endo] at h
        injection h with _ h2
        exact Or.inr (Or.inr h2)
      · exact absurd h (by intro hc; cases hc)
  | lam x c _ =>
      intro τ _ hnl _ _
      exact absurd rfl (hnl x c)

/-- Shape of good terms: of type `0 → 0` they satisfy clauses (1)–(3); of type `0` they are
chains `s₁(…(s_q z)…)`. -/
theorem good_shape (hFs : ∀ F ∈ Fs, F.ty = Ty.nu) (hα : α.ty = Ty.endo) :
    ∀ (t : Term) (τ : Ty), Good Fs α t τ →
      (τ = Ty.endo → IsType00Subterm Fs α t) ∧
      (τ = .zero → ∃ z, IsBasicType00Chain Fs α z t) := by
  intro t
  induction t with
  | var v =>
      intro τ ⟨_, hty, hfv, _⟩
      have hτ := hasType_var_inv hty
      subst hτ
      rcases hfv v (by simp) with hF | hαv | hz
      · rw [hFs v hF]
        exact ⟨fun h => absurd h ty_nu_ne_endo, fun h => absurd h ty_nu_ne_zero⟩
      · subst hαv
        rw [hα]
        exact ⟨fun _ => .basic .alpha, fun h => absurd h ty_endo_ne_zero⟩
      · rw [hz]
        exact ⟨fun h => absurd h.symm ty_endo_ne_zero, fun _ => ⟨v, .base v hz⟩⟩
  | lam y b ih =>
      intro τ ⟨hn, hty, hfv, hpos⟩
      obtain ⟨ρ, rfl, hb⟩ := hasType_lam_inv hty
      have hendo : Ty.arr y.ty ρ = Ty.endo := by
        rcases hpos with h | h | h
        · cases h
        · exact h
        · exact absurd rfl (h y b)
      simp only [Ty.endo] at hendo
      injection hendo with hy hρ
      subst hρ
      have hgood : Good Fs α b .zero := by
        refine ⟨isBetaNormal_lam hn, hb, ?_, Or.inl rfl⟩
        intro v hv
        by_cases hvy : v = y
        · subst hvy; exact Or.inr (Or.inr hy)
        · exact hfv v (by simp [hv, hvy])
      obtain ⟨z, hz⟩ := (ih .zero hgood).2 rfl
      refine ⟨fun _ => .chainLam y z hy (chain_ty hz) hz, fun h => ?_⟩
      cases h
  | app a b iha ihb =>
      intro τ ⟨hn, hty, hfv, _⟩
      obtain ⟨hnl, hna, hnb⟩ := isBetaNormal_app hn
      obtain ⟨σ, hta, htb⟩ := hasType_app_inv hty
      have hfva : ∀ v ∈ freeVarOccurrences a, Allowed Fs α v :=
        fun v hv => hfv v (by simp [hv])
      have hfvb : ∀ v ∈ freeVarOccurrences b, Allowed Fs α v :=
        fun v hv => hfv v (by simp [hv])
      rcases neutral_shape hFs hα a _ hna hnl hta hfva with ⟨h, F, hF, rfl⟩ | h | h
      · -- `a = Fᵢ : ν`, so `σ = τ = 0 → 0`
        simp only [Ty.nu] at h
        injection h with hσ hτ
        subst hσ; subst hτ
        have hgb : Good Fs α b Ty.endo := ⟨hnb, htb, hfvb, Or.inr (Or.inl rfl)⟩
        exact ⟨fun _ => .basic (.appF hF ((ihb _ hgb).1 rfl)),
          fun h => absurd h ty_endo_ne_zero⟩
      · -- `a : 0 → 0`, so `σ = τ = 0`
        simp only [Ty.endo] at h
        injection h with hσ hτ
        subst hσ; subst hτ
        have hga : Good Fs α a Ty.endo := ⟨hna, hta, hfva, Or.inr (Or.inl rfl)⟩
        have hgb : Good Fs α b .zero := ⟨hnb, htb, hfvb, Or.inl rfl⟩
        have hbasic := basic_of_type00_not_lam ((iha _ hga).1 rfl) hnl
        obtain ⟨z, hz⟩ := (ihb _ hgb).2 rfl
        exact ⟨fun h => absurd h.symm ty_endo_ne_zero, fun _ => ⟨z, .step hbasic hz⟩⟩
      · exact absurd h (by intro hc; cases hc)

/-- The invariant passes from a term to each of its subterms. -/
theorem good_subterm (hFs : ∀ F ∈ Fs, F.ty = Ty.nu) (hα : α.ty = Ty.endo)
    {s t : Term} (hsub : IsSubterm s t) :
    ∀ τ, Good Fs α t τ → ∃ σ, Good Fs α s σ := by
  induction hsub with
  | refl => exact fun τ h => ⟨τ, h⟩
  | @appLeft t u _ ih =>
      intro τ ⟨hn, hty, hfv, _⟩
      obtain ⟨hnl, hnt, _⟩ := isBetaNormal_app hn
      obtain ⟨σ, htt, _⟩ := hasType_app_inv hty
      exact ih _ ⟨hnt, htt, fun v hv => hfv v (by simp [hv]), Or.inr (Or.inr hnl)⟩
  | @appRight t u _ ih =>
      intro τ ⟨hn, hty, hfv, _⟩
      obtain ⟨hnl, hnt, hnu⟩ := isBetaNormal_app hn
      obtain ⟨σ, htt, htu⟩ := hasType_app_inv hty
      have hfvt : ∀ v ∈ freeVarOccurrences t, Allowed Fs α v :=
        fun v hv => hfv v (by simp [hv])
      have hσ : σ = .zero ∨ σ = Ty.endo := by
        rcases neutral_shape hFs hα t _ hnt hnl htt hfvt with ⟨h, _⟩ | h | h
        · simp only [Ty.nu] at h
          injection h with h1 _
          exact Or.inr h1
        · simp only [Ty.endo] at h
          injection h with h1 _
          exact Or.inl h1
        · cases h
      have hpos : σ = .zero ∨ σ = Ty.endo ∨ ∀ x c, u ≠ .lam x c := by
        rcases hσ with h | h
        · exact Or.inl h
        · exact Or.inr (Or.inl h)
      exact ih _ ⟨hnu, htu, fun v hv => hfv v (by simp [hv]), hpos⟩
  | @lamBody t x _ ih =>
      intro τ ⟨hn, hty, hfv, hpos⟩
      obtain ⟨ρ, rfl, hb⟩ := hasType_lam_inv hty
      have hendo : Ty.arr x.ty ρ = Ty.endo := by
        rcases hpos with h | h | h
        · cases h
        · exact h
        · exact absurd rfl (h x t)
      simp only [Ty.endo] at hendo
      injection hendo with hx hρ
      subst hρ
      refine ih .zero ⟨isBetaNormal_lam hn, hb, ?_, Or.inl rfl⟩
      intro v hv
      by_cases hvx : v = x
      · subst hvx; exact Or.inr (Or.inr hx)
      · exact hfv v (by simp [hv, hvx])

/-- **Milestone 2** (`normal_subterm_structure`, p. 114, lines 3–13). -/
theorem normal_subterm_structure
    (Fs : List Var) (α : Var) (r : Term)
    (hFs : ∀ F ∈ Fs, F.ty = Ty.nu)
    (hα : α.ty = Ty.endo)
    (hr_ty : HasType r Ty.endo)
    (hr_norm : IsBetaNormal r)
    (hr_fv : ∀ v ∈ freeVars r, v ∈ Fs ∨ v = α) :
    (∀ s τ, IsSubterm s r → HasType s τ → τ = .zero ∨ τ = Ty.endo ∨ τ = Ty.nu) ∧
    (∀ s, IsSubterm s r → HasType s Ty.nu → ∃ F ∈ Fs, s = .var F) ∧
    (∀ s, IsSubterm s r → HasType s Ty.endo → IsType00Subterm Fs α s) := by
  have hr : Good Fs α r Ty.endo := by
    refine ⟨hr_norm, hr_ty, ?_, Or.inr (Or.inl rfl)⟩
    intro v hv
    rcases hr_fv v ((mem_freeVars_iff r v).2 hv) with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
  -- Every subterm is good, at its unique type.
  have hsub : ∀ s τ, IsSubterm s r → HasType s τ → Good Fs α s τ := by
    intro s τ hs hty
    obtain ⟨σ, hg⟩ := good_subterm hFs hα hs _ hr
    have := hasType_unique hg.2.1 hty
    subst this
    exact hg
  refine ⟨?_, ?_, ?_⟩
  · intro s τ hs hty
    have hg := hsub s τ hs hty
    rcases lam_or_not s with hlam | hlam
    · rcases hg.2.2.2 with h | h | h
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · obtain ⟨x, c, rfl⟩ := hlam
        exact absurd rfl (h x c)
    · rcases neutral_shape hFs hα s τ hg.1 hlam hty hg.2.2.1 with ⟨h, _⟩ | h | h
      · exact Or.inr (Or.inr h)
      · exact Or.inr (Or.inl h)
      · exact Or.inl h
  · intro s hs hty
    have hg := hsub s _ hs hty
    rcases lam_or_not s with hlam | hlam
    · rcases hg.2.2.2 with h | h | h
      · exact absurd h ty_nu_ne_zero
      · exact absurd h ty_nu_ne_endo
      · obtain ⟨x, c, rfl⟩ := hlam
        exact absurd rfl (h x c)
    · rcases neutral_shape hFs hα s _ hg.1 hlam hty hg.2.2.1 with ⟨_, h⟩ | h | h
      · exact h
      · exact absurd h ty_nu_ne_endo
      · exact absurd h ty_nu_ne_zero
  · intro s hs hty
    exact (good_shape hFs hα s _ (hsub s _ hs hty)).1 rfl

end Schwichtenberg1976V2.Proofs

-- ===== Proofs/Schwichtenberg1976V2/Combinators.lean =====
/-!
# Closed normal numerals and the basic combinators (p. 113)

* Every closed β-normal term of type `ν` is α-equivalent to a Church numeral `n̄` or to the
  identity `λα. α`.
* `addComb`, `mulComb`, `constComb c` and `condComb` define `+`, `·`, the constant `c`, and
  the conditional `d(n, m, i)`.
-/

namespace Schwichtenberg1976V2.Proofs

open Schwichtenberg1976V2

/-! ## Substitution of closed terms -/

theorem subst_lam_closed {s : Term} (hs : freeVarOccurrences s = []) (v x : Var) (b : Term) :
    substTerm (.lam v b) x s = if v = x then .lam v b else .lam v (substTerm b x s) := by
  by_cases h : v = x
  · subst h; rw [subst_lam_self, if_pos rfl]
  · rw [subst_lam_fresh b s h (by simp [hs]), if_neg h]

/-- `n̄ a s ⊳ aⁿ s`. -/
theorem numeral_app_app (n : Nat) (a : Var) (s : Term) :
    ReducesTo (.app (.app (churchNumeral n) (.var a)) s) (iterApp (.var a) s n) := by
  obtain ⟨u, _, hu, hr⟩ := numeral_app n (.var a)
  refine .trans (.app hr (ReducesTo.rfl' s)) ?_
  have hβ := ReducesTo.beta u (iterApp (.var a) (.var u) n) s
  have hau : a ≠ u := fun h => hu (by simp [h])
  rwa [subst_iterApp, subst_var, if_neg hau, subst_var, if_pos rfl] at hβ

theorem var_ne_of_ty' {a b : Var} (h : a.ty ≠ b.ty) : a ≠ b := fun e => h (e ▸ rfl)

theorem rename_iterApp_head {a b : Var} (c : Var) (hba : b ≠ a) :
    ∀ n, renameFreeVar (iterApp (.var a) (.var b) n) a c = iterApp (.var c) (.var b) n := by
  intro n
  induction n with
  | zero => simp [iterApp, renameFreeVar, hba]
  | succ n ih =>
      rw [iterApp_succ, iterApp_succ, renameFreeVar, ih]
      simp [renameFreeVar]

/-! ## Closed normal terms of type `ν` -/

theorem chain_nil_shape {a z : Var} {body : Term} (h : IsBasicType00Chain [] a z body) :
    ∃ q, body = iterApp (.var a) (.var z) q := by
  induction body generalizing z with
  | var v =>
      cases h with
      | base _ _ => exact ⟨0, rfl⟩
  | app s₁ rest _ ih =>
      cases h with
      | step hb hc =>
          obtain ⟨q, rfl⟩ := ih hc
          cases hb with
          | alpha => exact ⟨q + 1, rfl⟩
          | appF hF _ => simp at hF
  | lam _ _ _ => cases h

theorem fvo_nil_of_closed {t : Term} (h : IsClosed t) : freeVarOccurrences t = [] := by
  refine eq_nil_of_forall_not_mem fun v hv => ?_
  have := (mem_freeVars_iff t v).2 hv
  rw [IsClosed] at h
  rw [h] at this
  simp at this

theorem closed_normal_nu (t : Term) (hty : HasType t Ty.nu) (hcl : IsClosed t)
    (hn : IsBetaNormal t) :
    (∃ n : Nat, AlphaEq t (churchNumeral n)) ∨
    (∃ α : Var, α.ty = Ty.endo ∧ AlphaEq t (.lam α (.var α))) := by
  have hfv := fvo_nil_of_closed hcl
  cases t with
  | var v => simp [freeVarOccurrences] at hfv
  | app p q =>
      exfalso
      rcases neutral_shape (Fs := []) (α := numα) (by simp) rfl (.app p q) _ hn
          (fun _ _ h => Term.noConfusion h) hty (by simp [hfv]) with ⟨_, F, hF, _⟩ | h | h
      · simp at hF
      · exact ty_nu_ne_endo h
      · exact ty_nu_ne_zero h
  | lam a b =>
      obtain ⟨ρ, hρ, hb⟩ := hasType_lam_inv hty
      simp only [Ty.nu] at hρ
      injection hρ with ha hρ
      subst hρ
      have hfvb : ∀ v ∈ freeVarOccurrences b, v = a := by
        intro v hv
        refine Decidable.byContradiction fun hva => ?_
        have : v ∈ freeVarOccurrences (.lam a b) := (mem_fvo_lam a b v).2 ⟨hv, hva⟩
        rw [hfv] at this
        simp at this
      have hgood : Good [] a b Ty.endo :=
        ⟨isBetaNormal_lam hn, hb, fun v hv => Or.inr (Or.inl (hfvb v hv)),
          Or.inr (Or.inl rfl)⟩
      have h00 := (good_shape (Fs := []) (α := a) (by simp) ha.symm b _ hgood).1 rfl
      cases h00 with
      | basic hb0 =>
          cases hb0 with
          | alpha => exact Or.inr ⟨a, ha.symm, .refl _⟩
          | appF hF _ => simp at hF
      | chainLam y z hy hz hc =>
          obtain ⟨q, rfl⟩ := chain_nil_shape hc
          have hza : z ≠ a := fun h => by rw [h, ← ha] at hz; cases hz
          have hzy : z = y := by
            refine Decidable.byContradiction fun hzy => ?_
            have hz' : z ∈ freeVarOccurrences (.lam y (iterApp (.var a) (.var z) q)) :=
              (mem_fvo_lam _ _ _).2 ⟨(mem_fvo_iterApp _ _ _ _).2 (Or.inr (by simp)), hzy⟩
            exact hza (hfvb z hz')
          subst hzy
          refine Or.inl ⟨q, ?_⟩
          have hαz : numα ≠ z := fun h => by rw [← h] at hz; cases hz
          have h1 := AlphaEq.lam_rename a numα (.lam z (iterApp (.var a) (.var z) q))
            (by rw [← ha]; rfl) (by
              by_cases hαa : numα = a
              · exact Or.inl hαa
              · refine Or.inr fun hm => ?_
                simp only [allVars, List.mem_cons] at hm
                rcases hm with h | h
                · exact hαz h
                · rcases allVars_iterApp_var a z numα q h with h | h
                  · exact hαa h
                  · exact hαz h)
          have hza' : (z == a) = false := by simp [hza]
          simp only [renameFreeVar, hza'] at h1
          rw [rename_iterApp_head numα hza] at h1
          refine .trans h1 (.lam_congr numα ?_)
          exact alpha_lam_iterApp q hz hαz (by decide)

/-! ## The combinators -/

def vF : Var := ⟨3, Ty.nu⟩
def vG : Var := ⟨4, Ty.nu⟩
def vH : Var := ⟨5, Ty.nu⟩
def vy : Var := ⟨2, .zero⟩

theorem addComb_eq : addComb = .lam vF (.lam vG (.lam numα (.lam numx
    (.app (.app (.var vF) (.var numα)) (.app (.app (.var vG) (.var numα)) (.var numx)))))) := by
  decide

theorem mulComb_eq : mulComb = .lam vF (.lam vG (.lam numα
    (.app (.var vF) (.app (.var vG) (.var numα))))) := by
  decide

theorem constComb_eq (c : Nat) : constComb c = .lam vF (churchNumeral c) := by
  simp only [constComb, iterTerm, freshVarFor, churchNumeral]
  rfl

theorem condComb_eq : condComb = .lam vF (.lam vG (.lam vH (.lam numα (.lam numx
    (.app (.app (.var vH) (.lam vy (.app (.app (.var vG) (.var numα)) (.var numx))))
      (.app (.app (.var vF) (.var numα)) (.var numx))))))) := rfl

theorem subst_numeral {s : Term} (hs : freeVarOccurrences s = []) (n : Nat) (x : Var) :
    substTerm (churchNumeral n) x s = churchNumeral n :=
  subst_closed_of_not_mem hs _ x (by simp [fvo_churchNumeral])

theorem closed_of_fvo_nil {t : Term} (h : freeVarOccurrences t = []) : IsClosed t := by
  unfold IsClosed freeVars
  rw [h]
  rfl

theorem iterApp_hasType {a : Var} {b : Term} (ha : a.ty = Ty.endo) (hb : HasType b .zero) :
    ∀ n, HasType (iterApp (.var a) b n) .zero := by
  intro n
  induction n with
  | zero => exact hb
  | succ n ih =>
      have h : HasType (.var a) (.arr .zero .zero) := by
        have := HasType.var a
        rw [ha] at this
        exact this
      exact .app h ih

theorem numeral_hasType (n : Nat) : HasType (churchNumeral n) Ty.nu :=
  .lam numα (.lam numx (iterApp_hasType rfl (.var numx) n))

theorem ne_αx : numα ≠ numx := by decide
theorem ne_xα : numx ≠ numα := by decide

/-- `λα x. n̄ α (m̄ α x) ⊳ (n+m)‾`. -/
theorem add_body_reduces (n m : Nat) :
    ReducesTo (.lam numα (.lam numx (.app (.app (churchNumeral n) (.var numα))
        (.app (.app (churchNumeral m) (.var numα)) (.var numx)))))
      (churchNumeral (n + m)) := by
  rw [churchNumeral_eq (n + m)]
  refine .lam numα (.lam numx (.trans (.app (ReducesTo.rfl' _)
    (numeral_app_app m numα (.var numx))) ?_))
  have := numeral_app_app n numα (iterApp (.var numα) (.var numx) m)
  rwa [iterApp_add] at this

theorem addComb_reduces (n m : Nat) :
    ReducesTo (.app (.app addComb (churchNumeral n)) (churchNumeral m))
      (churchNumeral (n + m)) := by
  rw [addComb_eq]
  refine .trans (.app (.beta _ _ _) (ReducesTo.rfl' _)) ?_
  simp (config := { decide := true }) only [subst_lam_closed (fvo_churchNumeral _),
    subst_app, subst_var, if_true, if_false]
  refine .trans (.beta _ _ _) ?_
  simp (config := { decide := true }) only [subst_lam_closed (fvo_churchNumeral _),
    subst_app, subst_var, subst_numeral (fvo_churchNumeral _), if_true, if_false]
  exact add_body_reduces n m

theorem addComb_defines :
    DefinesFunction 2 addComb (fun v => v ⟨0, by decide⟩ + v ⟨1, by decide⟩) := by
  refine ⟨?_, by unfold IsClosed; decide, fun v => addComb_reduces _ _⟩
  rw [addComb_eq]
  exact .lam _ (.lam _ (.lam _ (.lam _
    (.app (.app (.var _) (.var _)) (.app (.app (.var _) (.var _)) (.var _))))))

theorem mulComb_reduces (n m : Nat) :
    ReducesTo (.app (.app mulComb (churchNumeral n)) (churchNumeral m))
      (churchNumeral (n * m)) := by
  rw [mulComb_eq]
  refine .trans (.app (.beta _ _ _) (ReducesTo.rfl' _)) ?_
  simp (config := { decide := true }) only [subst_lam_closed (fvo_churchNumeral _),
    subst_app, subst_var, if_true, if_false]
  refine .trans (.beta _ _ _) ?_
  simp (config := { decide := true }) only [subst_lam_closed (fvo_churchNumeral _),
    subst_app, subst_var, subst_numeral (fvo_churchNumeral _), if_true, if_false]
  rw [churchNumeral_eq (n * m)]
  obtain ⟨u, hu, _, hr1⟩ := numeral_app m (.var numα)
  obtain ⟨w, hw, _, hr2⟩ := numeral_app n (.lam u (iterApp (.var numα) (.var u) m))
  have hαu : numα ≠ u := var_ne_of_ty' (by rw [hu]; decide)
  refine .lam numα (.trans (.app (ReducesTo.rfl' _) hr1) (.trans hr2 ?_))
  refine .trans (.lam w (iter_bound m hαu (.var w) n)) (.refl_alpha ?_)
  exact alpha_lam_iterApp _ hw (var_ne_of_ty' (by rw [hw]; decide)) ne_αx

theorem mulComb_defines :
    DefinesFunction 2 mulComb (fun v => v ⟨0, by decide⟩ * v ⟨1, by decide⟩) := by
  refine ⟨?_, by unfold IsClosed; decide, fun v => mulComb_reduces _ _⟩
  rw [mulComb_eq]
  exact .lam _ (.lam _ (.lam _ (.app (.var _) (.app (.var _) (.var _)))))

theorem constComb_defines (c : Nat) : DefinesFunction 1 (constComb c) (fun _ => c) := by
  rw [constComb_eq]
  refine ⟨.lam vF (numeral_hasType c), closed_of_fvo_nil ?_, fun v => ?_⟩
  · simp [freeVarOccurrences, fvo_churchNumeral]
  · show ReducesTo (.app (.lam vF (churchNumeral c)) (churchNumeral (v ⟨0, by decide⟩))) _
    refine .trans (.beta _ _ _) ?_
    rw [subst_numeral (fvo_churchNumeral _)]
    exact ReducesTo.rfl' _

theorem condComb_reduces (n m i : Nat) :
    ReducesTo (.app (.app (.app condComb (churchNumeral n)) (churchNumeral m)) (churchNumeral i))
      (churchNumeral (condNat n m i)) := by
  rw [condComb_eq]
  refine .trans (.app (.app (.beta _ _ _) (ReducesTo.rfl' _)) (ReducesTo.rfl' _)) ?_
  simp (config := { decide := true }) only [subst_lam_closed (fvo_churchNumeral _),
    subst_app, subst_var, if_true, if_false]
  refine .trans (.app (.beta _ _ _) (ReducesTo.rfl' _)) ?_
  simp (config := { decide := true }) only [subst_lam_closed (fvo_churchNumeral _),
    subst_app, subst_var, subst_numeral (fvo_churchNumeral _), if_true, if_false]
  refine .trans (.beta _ _ _) ?_
  simp (config := { decide := true }) only [subst_lam_closed (fvo_churchNumeral _),
    subst_app, subst_var, subst_numeral (fvo_churchNumeral _), if_true, if_false]
  -- reduce the two inner numeral applications
  have hcong := ReducesTo.app (.app (ReducesTo.rfl' (churchNumeral i))
      (.lam vy (numeral_app_app m numα (.var numx))))
    (numeral_app_app n numα (.var numx))
  obtain ⟨u, hu, hufree, hr⟩ := numeral_app i (.lam vy (iterApp (.var numα) (.var numx) m))
  have hαu : numα ≠ u := var_ne_of_ty' (by rw [hu]; decide)
  have hxu : numx ≠ u := by
    intro h
    apply hufree
    rw [← h]
    exact (mem_fvo_lam _ _ _).2 ⟨(mem_fvo_iterApp _ _ _ _).2 (Or.inr (by simp)), by decide⟩
  rw [churchNumeral_eq]
  refine .lam numα (.lam numx (.trans hcong (.trans (.app hr (ReducesTo.rfl' _)) ?_)))
  cases i with
  | zero =>
      have hβ := ReducesTo.beta u (.var u) (iterApp (.var numα) (.var numx) n)
      rw [subst_var, if_pos rfl] at hβ
      exact hβ
  | succ j =>
      refine .trans (.app (.lam u (iter_const m (by decide) (by decide) (.var u) j))
        (ReducesTo.rfl' _)) ?_
      have hβ := ReducesTo.beta u (iterApp (.var numα) (.var numx) m)
        (iterApp (.var numα) (.var numx) n)
      rw [subst_iterApp, subst_var, if_neg hαu, subst_var, if_neg hxu] at hβ
      exact hβ

theorem condComb_defines :
    DefinesFunction 3 condComb
      (fun v => condNat (v ⟨0, by decide⟩) (v ⟨1, by decide⟩) (v ⟨2, by decide⟩)) := by
  refine ⟨?_, by unfold IsClosed; decide, fun v => condComb_reduces _ _ _⟩
  rw [condComb_eq]
  exact .lam _ (.lam _ (.lam _ (.lam _ (.lam _
    (.app (.app (.var _) (.lam _ (.app (.app (.var _) (.var _)) (.var _))))
      (.app (.app (.var _) (.var _)) (.var _)))))))

end Schwichtenberg1976V2.Proofs

-- ===== Proofs/Schwichtenberg1976V2/Sufficiency.lean =====
/-!
# Every extended polynomial is λ-definable (pp. 113–114)

Projections are defined by `λF₁ … Fₖ. Fᵢ`. Composition `g(h₁(v), …, h_m(v))` is defined by
`λF⃗. G (H₁ F⃗) … (H_m F⃗)` from closed defining terms `G` and `Hⱼ`. Constants, `+`, `·` and
the conditional are compositions with `n̄` and the combinators of p. 113.

All proofs are constructive. The family `H₁, …, H_m` comes from finite choice, proved by
induction on `m`.
-/

namespace Schwichtenberg1976V2.Proofs

open Schwichtenberg1976V2

/-! ## Lists -/

theorem nodup_map_of_injective {α β : Type} {f : α → β} (hf : Function.Injective f) :
    ∀ {l : List α}, l.Nodup → (l.map f).Nodup
  | [], _ => List.nodup_nil
  | a :: l, h => by
      rw [List.nodup_cons] at h
      rw [List.map_cons, List.nodup_cons]
      refine ⟨fun hm => ?_, nodup_map_of_injective hf h.2⟩
      obtain ⟨b, hb, hfb⟩ := List.mem_map.1 hm
      exact h.1 (hf hfb ▸ hb)

theorem numeralArgs_eq (k : Nat) (v : Fin k → Nat) :
    numeralArgs k v = (List.finRange k).map (fun i => churchNumeral (v i)) := by
  induction k with
  | zero => rfl
  | succ k ih =>
      rw [numeralArgs, ih, List.finRange_succ, List.map_cons, List.map_map]
      rfl

/-- Finite choice, proved by induction on `m` without the axiom of choice. -/
theorem fin_choice {m : Nat} {P : Fin m → Term → Prop} (h : ∀ j, ∃ t, P j t) :
    ∃ H : Fin m → Term, ∀ j, P j (H j) := by
  induction m with
  | zero => exact ⟨fun j => j.elim0, fun j => j.elim0⟩
  | succ m ih =>
      obtain ⟨t0, h0⟩ := h 0
      obtain ⟨H', hH'⟩ := ih (P := fun j => P j.succ) (fun j => h j.succ)
      exact ⟨Fin.cases t0 H', fun j => Fin.cases h0 hH' j⟩

/-! ## Application and abstraction blocks -/

theorem appMany_cons (t a : Term) (args : List Term) :
    Term.appMany t (a :: args) = Term.appMany (.app t a) args := rfl

theorem appMany_cong {α : Type} (f g : α → Term) :
    ∀ (L : List α) {t t' : Term}, ReducesTo t t' → (∀ x ∈ L, ReducesTo (f x) (g x)) →
      ReducesTo (Term.appMany t (L.map f)) (Term.appMany t' (L.map g))
  | [], _, _, ht, _ => ht
  | x :: L, _, _, ht, hL => by
      simp only [List.map_cons, appMany_cons]
      exact appMany_cong f g L (.app ht (hL x (List.mem_cons_self ..)))
        (fun y hy => hL y (List.mem_cons_of_mem _ hy))

theorem appMany_cong_head (args : List Term) {t t' : Term} (ht : ReducesTo t t') :
    ReducesTo (Term.appMany t args) (Term.appMany t' args) := by
  have := appMany_cong id id args ht (fun x _ => ReducesTo.rfl' x)
  simpa using this

theorem substMany_appMany (l : List (Var × Term)) :
    ∀ (args : List Term) (t : Term),
      substMany (Term.appMany t args) l =
        Term.appMany (substMany t l) (args.map (substMany · l))
  | [], _ => rfl
  | a :: args, t => by
      rw [appMany_cons, substMany_appMany l args, substMany_app, List.map_cons, appMany_cons]

theorem subst_lamMany_closed {s : Term} (hs : freeVarOccurrences s = []) (x : Var) (b : Term) :
    ∀ xs : List Var, x ∉ xs → substTerm (Term.lamMany xs b) x s = Term.lamMany xs (substTerm b x s)
  | [], _ => rfl
  | y :: xs, hx => by
      have hyx : y ≠ x := fun h => hx (h ▸ List.mem_cons_self ..)
      simp only [Term.lamMany]
      rw [subst_lam_fresh _ s hyx (by simp [hs]),
        subst_lamMany_closed hs x b xs (fun h => hx (List.mem_cons_of_mem _ h))]

/-- β-reducing a block `(λx₁ … xₙ. b) a₁ … aₙ` of closed arguments. -/
theorem beta_lamMany :
    ∀ (ps : List (Var × Term)) (b : Term), (ps.map Prod.fst).Nodup →
      (∀ p ∈ ps, freeVarOccurrences p.2 = []) →
      ReducesTo (Term.appMany (Term.lamMany (ps.map Prod.fst) b) (ps.map Prod.snd))
        (substMany b ps)
  | [], b, _, _ => ReducesTo.rfl' b
  | (x, a) :: ps, b, hnd, hcl => by
      rw [List.map_cons, List.nodup_cons] at hnd
      have ha : freeVarOccurrences a = [] := hcl (x, a) (List.mem_cons_self ..)
      simp only [List.map_cons, Term.lamMany, appMany_cons, substMany]
      refine .trans (appMany_cong_head _ (.beta _ _ _)) ?_
      rw [subst_lamMany_closed ha x b _ hnd.1]
      exact beta_lamMany ps _ hnd.2 (fun p hp => hcl p (List.mem_cons_of_mem _ hp))

/-! ## Typing and free variables of the blocks -/

theorem lamMany_hasType {b : Term} (hb : HasType b Ty.nu) :
    ∀ xs : List Var, (∀ x ∈ xs, x.ty = Ty.nu) →
      HasType (Term.lamMany xs b) (Ty.nuArity xs.length)
  | [], _ => hb
  | x :: xs, hxs => by
      have h := HasType.lam x (lamMany_hasType hb xs fun y hy => hxs y (List.mem_cons_of_mem _ hy))
      rw [hxs x (List.mem_cons_self ..)] at h
      exact h

theorem appMany_hasType :
    ∀ (args : List Term) {t : Term}, HasType t (Ty.nuArity args.length) →
      (∀ a ∈ args, HasType a Ty.nu) → HasType (Term.appMany t args) Ty.nu
  | [], _, ht, _ => ht
  | a :: args, _, ht, ha =>
      appMany_hasType args (.app ht (ha a (List.mem_cons_self ..)))
        (fun b hb => ha b (List.mem_cons_of_mem _ hb))

theorem mem_fvo_appMany (v : Var) :
    ∀ (args : List Term) (t : Term), v ∈ freeVarOccurrences (Term.appMany t args) →
      v ∈ freeVarOccurrences t ∨ ∃ a ∈ args, v ∈ freeVarOccurrences a
  | [], _, h => Or.inl h
  | a :: args, t, h => by
      rcases mem_fvo_appMany v args _ h with h | ⟨b, hb, hv⟩
      · rcases (mem_fvo_app _ _ _).1 h with h | h
        · exact Or.inl h
        · exact Or.inr ⟨a, List.mem_cons_self .., h⟩
      · exact Or.inr ⟨b, List.mem_cons_of_mem _ hb, hv⟩

theorem mem_fvo_lamMany (v : Var) (b : Term) :
    ∀ xs : List Var, v ∈ freeVarOccurrences (Term.lamMany xs b) →
      v ∈ freeVarOccurrences b ∧ v ∉ xs
  | [], h => ⟨h, by simp⟩
  | x :: xs, h => by
      simp only [Term.lamMany, mem_fvo_lam] at h
      obtain ⟨hb, hx⟩ := mem_fvo_lamMany v b xs h.1
      exact ⟨hb, by simp [hx, h.2]⟩

/-! ## The argument variables -/

/-- The bound variables `F₁, …, Fₖ` of the defining terms. -/
def argVar {k : Nat} (i : Fin k) : Var := ⟨i.val, Ty.nu⟩

theorem argVar_injective {k : Nat} : Function.Injective (argVar (k := k)) := by
  intro i j h
  exact Fin.ext (congrArg Var.id h)

def argVars (k : Nat) : List Var := (List.finRange k).map argVar

/-- The substitution `Fᵢ ↦ v̄ᵢ` performed by applying a defining term to numerals. -/
def argSubst (k : Nat) (v : Fin k → Nat) : List (Var × Term) :=
  (List.finRange k).map (fun i => (argVar i, churchNumeral (v i)))

theorem argSubst_spec (k : Nat) (v : Fin k → Nat) :
    (argSubst k v).map Prod.fst = argVars k ∧
    (argSubst k v).map Prod.snd = numeralArgs k v ∧
    (argVars k).Nodup ∧
    ∀ p ∈ argSubst k v, freeVarOccurrences p.2 = [] := by
  refine ⟨by simp [argSubst, argVars, List.map_map], ?_, ?_, ?_⟩
  · rw [numeralArgs_eq]; simp [argSubst, List.map_map]
  · exact nodup_map_of_injective argVar_injective (List.nodup_finRange k)
  · intro p hp
    simp only [argSubst, List.mem_map] at hp
    obtain ⟨i, _, rfl⟩ := hp
    exact fvo_churchNumeral _

/-- Applying `λF⃗. b` to numerals reduces to `b` with the numerals substituted. -/
theorem apply_lamMany (k : Nat) (v : Fin k → Nat) (b : Term) :
    ReducesTo (Term.appMany (Term.lamMany (argVars k) b) (numeralArgs k v))
      (substMany b (argSubst k v)) := by
  obtain ⟨h1, h2, h3, h4⟩ := argSubst_spec k v
  have := beta_lamMany (argSubst k v) b (h1 ▸ h3) h4
  rwa [h1, h2] at this

theorem substMany_argVar (k : Nat) (v : Fin k → Nat) (i : Fin k) :
    substMany (.var (argVar i)) (argSubst k v) = churchNumeral (v i) := by
  have := substMany_var_index argVar argVar_injective (fun j => churchNumeral (v j))
    (fun j => fvo_churchNumeral _) i (List.finRange k)
  rw [if_pos (List.mem_finRange i)] at this
  exact this

theorem substMany_closed' {t : Term} (ht : freeVarOccurrences t = []) (k : Nat)
    (v : Fin k → Nat) : substMany t (argSubst k v) = t :=
  substMany_closed ht _ (argSubst_spec k v).2.2.2

theorem fvo_nil_of_defines {k : Nat} {t : Term} {f : (Fin k → Nat) → Nat}
    (h : DefinesFunction k t f) : freeVarOccurrences t = [] :=
  fvo_nil_of_closed h.2.1

/-! ## Projections and composition -/

theorem proj_definable (k : Nat) (i : Fin k) : IsLambdaDefinable k (fun v => v i) := by
  refine ⟨Term.lamMany (argVars k) (.var (argVar i)), ?_, ?_, fun v => ?_⟩
  · have := lamMany_hasType (HasType.var (argVar i)) (argVars k) (by simp [argVars, argVar])
    simpa [argVars] using this
  · refine closed_of_fvo_nil (eq_nil_of_forall_not_mem fun x hx => ?_)
    obtain ⟨hx1, hx2⟩ := mem_fvo_lamMany x _ _ hx
    rw [mem_fvo_var] at hx1
    subst hx1
    exact hx2 (List.mem_map.2 ⟨i, List.mem_finRange i, rfl⟩)
  · refine .trans (apply_lamMany k v _) ?_
    rw [substMany_argVar]
    exact ReducesTo.rfl' _

theorem comp_definable {k m : Nat} {g : (Fin m → Nat) → Nat}
    {hs : Fin m → (Fin k → Nat) → Nat}
    (hg : IsLambdaDefinable m g) (hh : ∀ j, IsLambdaDefinable k (hs j)) :
    IsLambdaDefinable k (fun v => g (fun j => hs j v)) := by
  obtain ⟨G, hG⟩ := hg
  obtain ⟨H, hH⟩ := fin_choice hh
  let inner (j : Fin m) : Term := Term.appMany (H j) ((argVars k).map Term.var)
  let body : Term := Term.appMany G ((List.finRange m).map inner)
  refine ⟨Term.lamMany (argVars k) body, ?_, ?_, fun v => ?_⟩
  · -- typing
    have hargs : ∀ a ∈ (argVars k).map Term.var, HasType a Ty.nu := by
      intro a ha
      simp only [argVars, List.map_map, List.mem_map] at ha
      obtain ⟨i, _, rfl⟩ := ha
      exact HasType.var (argVar i)
    have hinner : ∀ j, HasType (inner j) Ty.nu := fun j =>
      appMany_hasType _ (by simpa [argVars] using (hH j).1) hargs
    have hbody : HasType body Ty.nu :=
      appMany_hasType _ (by simpa using hG.1) (by
        intro a ha
        simp only [List.mem_map] at ha
        obtain ⟨j, _, rfl⟩ := ha
        exact hinner j)
    have := lamMany_hasType hbody (argVars k) (by simp [argVars, argVar])
    simpa [argVars] using this
  · -- closedness
    refine closed_of_fvo_nil (eq_nil_of_forall_not_mem fun x hx => ?_)
    obtain ⟨hx1, hx2⟩ := mem_fvo_lamMany x _ _ hx
    rcases mem_fvo_appMany x _ _ hx1 with h | ⟨a, ha, h⟩
    · rw [fvo_nil_of_defines hG] at h; simp at h
    · simp only [List.mem_map] at ha
      obtain ⟨j, _, rfl⟩ := ha
      rcases mem_fvo_appMany x _ _ h with h | ⟨b, hb, h⟩
      · rw [fvo_nil_of_defines (hH j)] at h; simp at h
      · simp only [List.mem_map] at hb
        obtain ⟨y, hy, rfl⟩ := hb
        rw [mem_fvo_var] at h
        subst h
        exact hx2 hy
  · -- computation
    refine .trans (apply_lamMany k v body) ?_
    have hsub : substMany body (argSubst k v) =
        Term.appMany G ((List.finRange m).map fun j =>
          Term.appMany (H j) (numeralArgs k v)) := by
      simp only [body, inner, substMany_appMany, substMany_closed' (fvo_nil_of_defines hG),
        List.map_map]
      congr 1
      apply List.map_congr_left
      intro j _
      simp only [Function.comp, substMany_appMany, substMany_closed' (fvo_nil_of_defines (hH j)),
        List.map_map]
      congr 1
      rw [numeralArgs_eq]
      simp only [argVars, List.map_map]
      apply List.map_congr_left
      intro i _
      exact substMany_argVar k v i
    rw [hsub]
    refine .trans (appMany_cong (fun j => Term.appMany (H j) (numeralArgs k v))
      (fun j => churchNumeral (hs j v)) (List.finRange m) (ReducesTo.rfl' G)
      (fun j _ => (hH j).2.2 v)) ?_
    have := hG.2.2 (fun j => hs j v)
    rwa [numeralArgs_eq] at this

theorem definable_congr {k : Nat} {f g : (Fin k → Nat) → Nat} (hfg : ∀ v, f v = g v)
    (h : IsLambdaDefinable k f) : IsLambdaDefinable k g := by
  have : f = g := funext hfg
  exact this ▸ h

/-- The argument families of the binary and ternary operations. -/
def pair {k : Nat} (f g : (Fin k → Nat) → Nat) (j : Fin 2) : (Fin k → Nat) → Nat :=
  match j with
  | ⟨0, _⟩ => f
  | _ => g

def triple {k : Nat} (f g h : (Fin k → Nat) → Nat) (j : Fin 3) : (Fin k → Nat) → Nat :=
  match j with
  | ⟨0, _⟩ => f
  | ⟨1, _⟩ => g
  | _ => h

theorem pair_definable {k : Nat} {f g : (Fin k → Nat) → Nat}
    (hf : IsLambdaDefinable k f) (hg : IsLambdaDefinable k g) :
    ∀ j, IsLambdaDefinable k (pair f g j)
  | ⟨0, _⟩ => hf
  | ⟨1, _⟩ => hg

theorem triple_definable {k : Nat} {f g h : (Fin k → Nat) → Nat}
    (hf : IsLambdaDefinable k f) (hg : IsLambdaDefinable k g) (hh : IsLambdaDefinable k h) :
    ∀ j, IsLambdaDefinable k (triple f g h j)
  | ⟨0, _⟩ => hf
  | ⟨1, _⟩ => hg
  | ⟨2, _⟩ => hh

/-- **Sufficiency**: every extended polynomial is λ-definable. -/
theorem sufficiency : ∀ {k : Nat} {f : (Fin k → Nat) → Nat},
    IsExtendedPolyInd f → IsLambdaDefinable k f := by
  intro k f h
  induction h with
  | const c =>
      have h0 : IsLambdaDefinable 0 (fun _ => c) :=
        ⟨churchNumeral c, numeral_hasType c, closed_of_fvo_nil (fvo_churchNumeral c),
          fun _ => ReducesTo.rfl' _⟩
      exact comp_definable (hs := fun j => j.elim0) h0 (fun j => j.elim0)
  | proj i => exact proj_definable _ i
  | add _ _ ihf ihg =>
      exact definable_congr (fun v => rfl)
        (comp_definable ⟨_, addComb_defines⟩ (pair_definable ihf ihg))
  | mul _ _ ihf ihg =>
      exact definable_congr (fun v => rfl)
        (comp_definable ⟨_, mulComb_defines⟩ (pair_definable ihf ihg))
  | cond _ _ _ ihf ihg ihh =>
      exact definable_congr (fun v => rfl)
        (comp_definable ⟨_, condComb_defines⟩ (triple_definable ihf ihg ihh))
  | comp _ _ ihg ihhs => exact comp_definable ihg ihhs

/-- **Milestone 1** (`combinators_and_sufficiency`, pp. 113–114). -/
theorem combinators_and_sufficiency :
    (∀ t : Term,
      HasType t Ty.nu →
      IsClosed t →
      IsBetaNormal t →
      (∃ n : Nat, AlphaEq t (churchNumeral n)) ∨
      (∃ α : Var, α.ty = Ty.endo ∧ AlphaEq t (.lam α (.var α)))) ∧
    DefinesFunction 2 addComb (fun v => v ⟨0, by decide⟩ + v ⟨1, by decide⟩) ∧
    DefinesFunction 2 mulComb (fun v => v ⟨0, by decide⟩ * v ⟨1, by decide⟩) ∧
    (∀ c : Nat, DefinesFunction 1 (constComb c) (fun _ => c)) ∧
    DefinesFunction 3 condComb
      (fun v => condNat (v ⟨0, by decide⟩) (v ⟨1, by decide⟩) (v ⟨2, by decide⟩)) ∧
    (∀ {k : Nat} {f : (Fin k → Nat) → Nat},
      IsExtendedPolyInd f → IsLambdaDefinable k f) :=
  ⟨closed_normal_nu, addComb_defines, mulComb_defines, constComb_defines, condComb_defines,
    sufficiency⟩

end Schwichtenberg1976V2.Proofs

-- ===== Proofs/Schwichtenberg1976V2/Piecewise.lean =====
/-!
# Extended polynomials are the piecewise polynomials (p. 114)

`f` is an extended polynomial iff, for every zero/non-zero pattern `σ` of the arguments, `f`
agrees on that pattern with a polynomial.

* (⇒) On a fixed pattern, a polynomial is either always `0` or never `0`, so a conditional
  `d(f, g, h)` always selects the same branch. Composition is closed because polynomials are
  closed under substitution.
* (⇐) `f(v) = Σ_σ χ_σ(v) · P_σ(v)`, where the indicator `χ_σ` is a product of `sg(vᵢ)` and
  `s̄g(vᵢ)`, both of which are conditionals.

Everything is constructive.
-/

namespace Schwichtenberg1976V2.Proofs

open Schwichtenberg1976V2

/-- `v` has the zero/non-zero pattern `σ`. -/
def Matches {k : Nat} (σ : Fin k → Bool) (v : Fin k → Nat) : Prop :=
  ∀ i : Fin k, (v i != 0) = σ i

/-- The pattern of `v`. -/
def patternOf {k : Nat} (v : Fin k → Nat) : Fin k → Bool := fun i => v i != 0

theorem matches_patternOf {k : Nat} (v : Fin k → Nat) : Matches (patternOf v) v :=
  fun _ => rfl

/-! ## Polynomials -/

/-- On a fixed pattern a polynomial is identically `0` or nowhere `0`. -/
theorem poly_dichotomy {k : Nat} {P : (Fin k → Nat) → Nat} (hP : IsPolynomial P)
    (σ : Fin k → Bool) :
    (∀ v, Matches σ v → P v = 0) ∨ (∀ v, Matches σ v → P v ≠ 0) := by
  induction hP with
  | const c =>
      cases c with
      | zero => exact Or.inl fun _ _ => rfl
      | succ c => exact Or.inr fun _ _ => Nat.succ_ne_zero c
  | proj i =>
      cases hσ : σ i with
      | false =>
          refine Or.inl fun v hv => ?_
          have := hv i
          rw [hσ] at this
          simpa using this
      | true =>
          refine Or.inr fun v hv => ?_
          have := hv i
          rw [hσ] at this
          simpa using this
  | add _ _ ihP ihQ =>
      rcases ihP with hP | hP
      · rcases ihQ with hQ | hQ
        · exact Or.inl fun v hv => by dsimp only; rw [hP v hv, hQ v hv]
        · exact Or.inr fun v hv => by dsimp only; have := hQ v hv; omega
      · exact Or.inr fun v hv => by dsimp only; have := hP v hv; omega
  | mul _ _ ihP ihQ =>
      rcases ihP with hP | hP
      · exact Or.inl fun v hv => by dsimp only; rw [hP v hv, Nat.zero_mul]
      · rcases ihQ with hQ | hQ
        · exact Or.inl fun v hv => by dsimp only; rw [hQ v hv, Nat.mul_zero]
        · exact Or.inr fun v hv => Nat.mul_ne_zero (hP v hv) (hQ v hv)

/-- Polynomials are closed under substitution of polynomials. -/
theorem poly_comp {k m : Nat} {Q : (Fin m → Nat) → Nat} (hQ : IsPolynomial Q)
    {Ps : Fin m → (Fin k → Nat) → Nat} (hPs : ∀ j, IsPolynomial (Ps j)) :
    IsPolynomial (fun v => Q (fun j => Ps j v)) := by
  induction hQ with
  | const c => exact .const c
  | proj j => exact hPs j
  | add _ _ ih1 ih2 => exact .add ih1 ih2
  | mul _ _ ih1 ih2 => exact .mul ih1 ih2

theorem poly_extended {k : Nat} {P : (Fin k → Nat) → Nat} (hP : IsPolynomial P) :
    IsExtendedPolyInd P := by
  induction hP with
  | const c => exact .const c
  | proj i => exact .proj i
  | add _ _ ih1 ih2 => exact .add ih1 ih2
  | mul _ _ ih1 ih2 => exact .mul ih1 ih2

/-! ## (⇒) Extended polynomials are piecewise polynomials -/

/-- Finite choice, by induction on `m`. -/
theorem fin_choice' {β : Type} {m : Nat} {R : Fin m → β → Prop}
    (h : ∀ j, ∃ b, R j b) : ∃ bs : Fin m → β, ∀ j, R j (bs j) := by
  induction m with
  | zero => exact ⟨fun j => j.elim0, fun j => j.elim0⟩
  | succ m ih =>
      obtain ⟨P0, h0⟩ := h 0
      obtain ⟨Ps', hPs'⟩ := ih (R := fun j => R j.succ) (fun j => h j.succ)
      exact ⟨Fin.cases P0 Ps', fun j => Fin.cases h0 hPs' j⟩

theorem extended_piecewise {k : Nat} {f : (Fin k → Nat) → Nat} (hf : IsExtendedPolyInd f) :
    IsPiecewisePolynomial k f := by
  induction hf with
  | const c => exact fun _ => ⟨_, .const c, fun _ _ => rfl⟩
  | proj i => exact fun _ => ⟨_, .proj i, fun _ _ => rfl⟩
  | add _ _ ihf ihg =>
      intro σ
      obtain ⟨P, hP, hfP⟩ := ihf σ
      obtain ⟨Q, hQ, hgQ⟩ := ihg σ
      exact ⟨_, .add hP hQ, fun v hv => by simp only [hfP v hv, hgQ v hv]⟩
  | mul _ _ ihf ihg =>
      intro σ
      obtain ⟨P, hP, hfP⟩ := ihf σ
      obtain ⟨Q, hQ, hgQ⟩ := ihg σ
      exact ⟨_, .mul hP hQ, fun v hv => by simp only [hfP v hv, hgQ v hv]⟩
  | cond _ _ _ ihf ihg ihh =>
      intro σ
      obtain ⟨P, hP, hfP⟩ := ihf σ
      obtain ⟨Q, hQ, hgQ⟩ := ihg σ
      obtain ⟨R, hR, hhR⟩ := ihh σ
      rcases poly_dichotomy hR σ with h0 | h0
      · refine ⟨P, hP, fun v hv => ?_⟩
        show condNat _ _ _ = _
        rw [hhR v hv, h0 v hv, hfP v hv]
        rfl
      · refine ⟨Q, hQ, fun v hv => ?_⟩
        have hne := h0 v hv
        show condNat _ _ _ = _
        rw [hhR v hv, hgQ v hv]
        cases hR : R v with
        | zero => exact absurd hR hne
        | succ n => rfl
  | @comp k m g hs _ _ ihg ihhs =>
      intro σ
      obtain ⟨Ps, hPs⟩ := fin_choice' (fun j => ihhs j σ)
      -- on the pattern `σ` each inner polynomial is always zero or never zero
      have hj : ∀ j, ∃ b : Bool, ∀ v, Matches σ v → (Ps j v != 0) = b := by
        intro j
        rcases poly_dichotomy (hPs j).1 σ with h | h
        · exact ⟨false, fun v hv => by rw [h v hv]; rfl⟩
        · refine ⟨true, fun v hv => ?_⟩
          have hne := h v hv
          cases hP : Ps j v with
          | zero => exact absurd hP hne
          | succ n => rfl
      obtain ⟨ρ, hρ⟩ := fin_choice' hj
      obtain ⟨Q, hQ, hgQ⟩ := ihg ρ
      refine ⟨fun v => Q (fun j => Ps j v), poly_comp hQ fun j => (hPs j).1, fun v hv => ?_⟩
      have hinner : (fun j => hs j v) = (fun j => Ps j v) := funext fun j => (hPs j).2 v hv
      have hmatch : Matches ρ (fun j => Ps j v) := fun j => hρ j v hv
      show g (fun j => hs j v) = Q (fun j => Ps j v)
      rw [hinner, hgQ _ hmatch]

/-! ## (⇐) Piecewise polynomials are extended polynomials

Free the argument positions one at a time. If `f` is an extended polynomial `E₀` wherever
`vⱼ = 0` and `E₁` wherever `vⱼ ≠ 0` (with the other positions constrained as before), then
`f = d(E₀, E₁, vⱼ)` there. -/

/-- `v` agrees with the pattern `σ` at the positions `≥ j`. -/
def MatchesFrom {k : Nat} (j : Nat) (σ : Fin k → Bool) (v : Fin k → Nat) : Prop :=
  ∀ i : Fin k, j ≤ i.val → (v i != 0) = σ i

theorem piecewise_cascade {k : Nat} {f : (Fin k → Nat) → Nat} (hf : IsPiecewisePolynomial k f) :
    ∀ j : Nat, ∀ σ : Fin k → Bool,
      ∃ E : (Fin k → Nat) → Nat, IsExtendedPolyInd E ∧ ∀ v, MatchesFrom j σ v → f v = E v := by
  intro j
  induction j with
  | zero =>
      intro σ
      obtain ⟨P, hP, hfP⟩ := hf σ
      exact ⟨P, poly_extended hP, fun v hv => hfP v fun i => hv i (Nat.zero_le _)⟩
  | succ j ih =>
      intro σ
      by_cases hj : j < k
      · let upd (b : Bool) : Fin k → Bool := fun i => if i.val = j then b else σ i
        obtain ⟨E₀, hE₀, hf₀⟩ := ih (upd false)
        obtain ⟨E₁, hE₁, hf₁⟩ := ih (upd true)
        refine ⟨fun v => condNat (E₀ v) (E₁ v) (v ⟨j, hj⟩), .cond hE₀ hE₁ (.proj ⟨j, hj⟩),
          fun v hv => ?_⟩
        have hrest : ∀ b, (v ⟨j, hj⟩ != 0) = b → MatchesFrom j (upd b) v := by
          intro b hb i hi
          by_cases hij : i.val = j
          · have : i = ⟨j, hj⟩ := Fin.ext hij
            subst this
            simp only [upd, if_pos rfl]
            exact hb
          · simp only [upd, if_neg hij]
            exact hv i (by omega)
        show f v = condNat (E₀ v) (E₁ v) (v ⟨j, hj⟩)
        cases h : v ⟨j, hj⟩ with
        | zero =>
            rw [hf₀ v (hrest false (by rw [h]; rfl))]
            rfl
        | succ n =>
            rw [hf₁ v (hrest true (by rw [h]; rfl))]
            rfl
      · obtain ⟨E, hE, hfE⟩ := ih σ
        exact ⟨E, hE, fun v hv => hfE v fun i hi => hv i (by have := i.isLt; omega)⟩

theorem piecewise_extended {k : Nat} {f : (Fin k → Nat) → Nat}
    (hf : IsPiecewisePolynomial k f) : IsExtendedPolyInd f := by
  obtain ⟨E, hE, hfE⟩ := piecewise_cascade hf k (fun _ => false)
  have : f = E := funext fun v => hfE v fun i hi => absurd i.isLt (by omega)
  exact this ▸ hE

theorem piecewise_iff_extended {k : Nat} (f : (Fin k → Nat) → Nat) :
    IsPiecewisePolynomial k f ↔ IsExtendedPolyInd f :=
  ⟨piecewise_extended, extended_piecewise⟩

end Schwichtenberg1976V2.Proofs

-- ===== Proofs/Schwichtenberg1976V2/Semantics.lean =====
/-!
# Set-theoretic semantics and soundness of reduction

Types denote sets: `⟦0⟧ = ℕ` and `⟦σ → τ⟧ = ⟦σ⟧ → ⟦τ⟧`. A typed term denotes a function
of the environment. Reduction preserves typing and denotation (`reducesTo_sound`), including
the capture-avoiding renaming inside `substTerm`.

Everything is constructive. The casts between `⟦τ⟧` and `⟦τ'⟧` use decidable equality of
types.
-/

namespace Schwichtenberg1976V2.Proofs

open Schwichtenberg1976V2

/-! ## Denotations -/

@[reducible] def Sem : Ty → Type
  | .zero => Nat
  | .arr a b => Sem a → Sem b

def Sem.default : (τ : Ty) → Sem τ
  | .zero => (0 : Nat)
  | .arr _ b => fun _ => Sem.default b

/-- Environments assign every typed variable a value of its type. -/
def Env : Type := (x : Var) → Sem x.ty

def Env.upd (ρ : Env) (x : Var) (a : Sem x.ty) : Env :=
  fun v => if h : v = x then cast (congrArg (fun y : Var => Sem y.ty) h.symm) a else ρ v

theorem Env.upd_same (ρ : Env) (x : Var) (a : Sem x.ty) : ρ.upd x a x = a := by
  simp [Env.upd]

theorem Env.upd_other (ρ : Env) {x v : Var} (a : Sem x.ty) (h : v ≠ x) : ρ.upd x a v = ρ v := by
  simp [Env.upd, h]

theorem Env.upd_upd_same (ρ : Env) (x : Var) (a b : Sem x.ty) :
    (ρ.upd x a).upd x b = ρ.upd x b := by
  funext v
  by_cases h : v = x
  · subst h; simp [Env.upd]
  · simp [Env.upd, h]

theorem Env.upd_comm (ρ : Env) {x y : Var} (a : Sem x.ty) (b : Sem y.ty) (h : x ≠ y) :
    (ρ.upd x a).upd y b = (ρ.upd y b).upd x a := by
  funext v
  by_cases hx : v = x
  · subst hx; simp [Env.upd, h]
  · by_cases hy : v = y
    · subst hy; simp [Env.upd, hx]
    · simp [Env.upd, hx, hy]

/-- Inferred type of a raw term (meaningful for typed terms). -/
def resTy : Ty → Ty
  | .arr _ b => b
  | .zero => .zero

def tyOf : Term → Ty
  | .var x => x.ty
  | .lam x b => .arr x.ty (tyOf b)
  | .app t _ => resTy (tyOf t)

def applySem : (A S : Ty) → Sem A → Sem S → Sem (resTy A)
  | .arr a b, S, f, x => if h : S = a then f (cast (congrArg Sem h) x) else Sem.default b
  | .zero, _, _, _ => (0 : Nat)

/-- Denotation of a raw term; ill-typed applications get a default value. -/
def eval : (t : Term) → Env → Sem (tyOf t)
  | .var x, ρ => ρ x
  | .lam x b, ρ => fun a => eval b (ρ.upd x a)
  | .app t s, ρ => applySem (tyOf t) (tyOf s) (eval t ρ) (eval s ρ)

theorem tyOf_of_hasType {t : Term} {τ : Ty} (h : HasType t τ) : tyOf t = τ := by
  induction h with
  | var x => rfl
  | app _ _ iht ihs => simp [tyOf, iht, resTy]
  | lam x _ ih => simp [tyOf, ih]

/-- Denotation at a prescribed type. -/
def evalT (τ : Ty) (t : Term) (ρ : Env) : Sem τ :=
  if h : tyOf t = τ then cast (congrArg Sem h) (eval t ρ) else Sem.default τ

theorem evalT_var (x : Var) (ρ : Env) : evalT x.ty (.var x) ρ = ρ x := by
  unfold evalT
  split
  · rfl
  · rename_i h; exact absurd rfl h

theorem cast_lam_aux {A B τ : Ty} (h : B = τ) (f : Sem A → Sem B) :
    cast (congrArg Sem (congrArg (Ty.arr A) h)) f = fun a => cast (congrArg Sem h) (f a) := by
  subst h; rfl

theorem evalT_lam {x : Var} {b : Term} {τ : Ty} (hb : HasType b τ) (ρ : Env) :
    evalT (.arr x.ty τ) (.lam x b) ρ = fun a => evalT τ b (ρ.upd x a) := by
  have h := tyOf_of_hasType hb
  have h' : tyOf (.lam x b) = .arr x.ty τ := by simp [tyOf, h]
  simp only [evalT, dif_pos h', dif_pos h]
  exact cast_lam_aux h _

theorem applySem_arr (S τ : Ty) (f : Sem S → Sem τ) (x : Sem S) :
    applySem (.arr S τ) S f x = f x := by
  show (if h : S = S then f (cast (congrArg Sem h) x) else Sem.default τ) = f x
  rw [dif_pos rfl]
  rfl

theorem cast_app_aux {A S σ τ : Ty} (hA : A = .arr σ τ) (hS : S = σ) (f : Sem A) (x : Sem S)
    (hR : resTy A = τ) :
    cast (congrArg Sem hR) (applySem A S f x) =
      (cast (congrArg Sem hA) f : Sem σ → Sem τ) (cast (congrArg Sem hS) x) := by
  subst hA; subst hS
  exact applySem_arr S τ f x

theorem evalT_app {t s : Term} {σ τ : Ty} (ht : HasType t (.arr σ τ)) (hs : HasType s σ)
    (ρ : Env) :
    evalT τ (.app t s) ρ = (evalT (.arr σ τ) t ρ) (evalT σ s ρ) := by
  have h1 := tyOf_of_hasType ht
  have h2 := tyOf_of_hasType hs
  have h' : tyOf (.app t s) = τ := by simp [tyOf, h1, resTy]
  simp only [evalT, dif_pos h', dif_pos h1, dif_pos h2]
  exact cast_app_aux h1 h2 _ _ h'

/-! ## Coincidence: only free variables matter -/

theorem eval_coincide :
    ∀ (t : Term) (ρ ρ' : Env), (∀ v ∈ freeVarOccurrences t, ρ v = ρ' v) → eval t ρ = eval t ρ'
  | .var x, ρ, ρ', h => h x (by simp)
  | .app t s, ρ, ρ', h => by
      simp only [eval]
      rw [eval_coincide t ρ ρ' (fun v hv => h v (by simp [hv])),
        eval_coincide s ρ ρ' (fun v hv => h v (by simp [hv]))]
  | .lam x b, ρ, ρ', h => by
      simp only [eval]
      funext a
      apply eval_coincide b
      intro v hv
      by_cases hvx : v = x
      · subst hvx; rw [Env.upd_same, Env.upd_same]
      · rw [Env.upd_other _ _ hvx, Env.upd_other _ _ hvx]
        exact h v (by simp [hv, hvx])

theorem evalT_coincide (τ : Ty) (t : Term) {ρ ρ' : Env}
    (h : ∀ v ∈ freeVarOccurrences t, ρ v = ρ' v) : evalT τ t ρ = evalT τ t ρ' := by
  simp only [evalT, eval_coincide t ρ ρ' h]

/-! ## Renaming -/

theorem renameFreeVar_self (x : Var) : ∀ t : Term, renameFreeVar t x x = t
  | .var v => by simp only [renameFreeVar]; split <;> simp_all
  | .app r s => by simp [renameFreeVar, renameFreeVar_self x r, renameFreeVar_self x s]
  | .lam v b => by simp only [renameFreeVar]; split <;> simp [renameFreeVar_self x b]

theorem rename_hasType_iff {x y : Var} (hty : y.ty = x.ty) :
    ∀ (t : Term) (τ : Ty), HasType (renameFreeVar t x y) τ ↔ HasType t τ
  | .var v, τ => by
      simp only [renameFreeVar]
      by_cases h : v = x
      · subst h
        simp only [beq_self_eq_true, if_true]
        constructor
        · intro hy; have := hasType_var_inv hy; rw [this, hty]; exact .var _
        · intro hv; have := hasType_var_inv hv; rw [this, ← hty]; exact .var _
      · simp [h]
  | .app r s, τ => by
      simp only [renameFreeVar]
      constructor
      · intro h
        obtain ⟨σ, hr, hs⟩ := hasType_app_inv h
        exact .app ((rename_hasType_iff hty r _).1 hr) ((rename_hasType_iff hty s _).1 hs)
      · intro h
        obtain ⟨σ, hr, hs⟩ := hasType_app_inv h
        exact .app ((rename_hasType_iff hty r _).2 hr) ((rename_hasType_iff hty s _).2 hs)
  | .lam v b, τ => by
      simp only [renameFreeVar]
      split
      · exact Iff.rfl
      · constructor
        · intro h
          obtain ⟨ρ, rfl, hb⟩ := hasType_lam_inv h
          exact .lam v ((rename_hasType_iff hty b _).1 hb)
        · intro h
          obtain ⟨ρ, rfl, hb⟩ := hasType_lam_inv h
          exact .lam v ((rename_hasType_iff hty b _).2 hb)

/-- Renaming a free variable `x` to a fresh `y` of the same type. -/
theorem rename_eval {x : Var} (n : Nat) :
    ∀ (t : Term), (⟨n, x.ty⟩ : Var) ∉ allVars t → ∀ (τ : Ty), HasType t τ → ∀ ρ : Env,
      evalT τ (renameFreeVar t x ⟨n, x.ty⟩) ρ = evalT τ t (ρ.upd x (ρ ⟨n, x.ty⟩))
  | .var v, hfresh, τ, ht, ρ => by
      have := hasType_var_inv ht
      subst this
      simp only [renameFreeVar]
      by_cases h : v = x
      · subst h
        simp only [beq_self_eq_true, if_true]
        rw [show evalT v.ty (.var ⟨n, v.ty⟩) ρ = ρ ⟨n, v.ty⟩ from evalT_var ⟨n, v.ty⟩ ρ,
          evalT_var, Env.upd_same]
      · simp only [beq_iff_eq, h, if_false]
        rw [evalT_var, evalT_var, Env.upd_other _ _ h]
  | .app r s, hfresh, τ, ht, ρ => by
      simp only [allVars, List.mem_append, not_or] at hfresh
      obtain ⟨σ, hr, hs⟩ := hasType_app_inv ht
      have hty : (⟨n, x.ty⟩ : Var).ty = x.ty := rfl
      simp only [renameFreeVar]
      rw [evalT_app ((rename_hasType_iff hty r _).2 hr) ((rename_hasType_iff hty s _).2 hs),
        evalT_app hr hs, rename_eval n r hfresh.1 _ hr, rename_eval n s hfresh.2 _ hs]
  | .lam v b, hfresh, τ, ht, ρ => by
      simp only [allVars, List.mem_cons, not_or] at hfresh
      obtain ⟨ρ', rfl, hb⟩ := hasType_lam_inv ht
      simp only [renameFreeVar]
      by_cases h : v = x
      · subst h
        simp only [beq_self_eq_true, if_true]
        rw [evalT_lam hb, evalT_lam hb]
        funext a
        rw [Env.upd_upd_same]
      · simp only [beq_iff_eq, h, if_false]
        have hty : (⟨n, x.ty⟩ : Var).ty = x.ty := rfl
        rw [evalT_lam ((rename_hasType_iff hty b _).2 hb), evalT_lam hb]
        funext a
        have hval : (ρ.upd v a) ⟨n, x.ty⟩ = ρ ⟨n, x.ty⟩ := Env.upd_other _ _ hfresh.1
        rw [rename_eval n b hfresh.2 _ hb, hval, Env.upd_comm _ _ _ h]

/-! ## Substitution -/

theorem allVar_id_le_maxVarId : ∀ (t : Term) (v : Var), v ∈ allVars t → v.id ≤ maxVarId t
  | .var x, v, h => by simp [allVars] at h; subst h; simp [maxVarId]
  | .app r s, v, h => by
      simp only [allVars, List.mem_append] at h
      simp only [maxVarId]
      rcases h with h | h
      · exact Nat.le_trans (allVar_id_le_maxVarId r v h) (Nat.le_max_left _ _)
      · exact Nat.le_trans (allVar_id_le_maxVarId s v h) (Nat.le_max_right _ _)
  | .lam x b, v, h => by
      simp only [allVars, List.mem_cons] at h
      simp only [maxVarId]
      rcases h with h | h
      · subst h; exact Nat.le_max_left _ _
      · exact Nat.le_trans (allVar_id_le_maxVarId b v h) (Nat.le_max_right _ _)

theorem fvo_subset_allVars : ∀ (t : Term) (v : Var), v ∈ freeVarOccurrences t → v ∈ allVars t
  | .var x, v, h => by simpa [allVars] using h
  | .app r s, v, h => by
      rcases (mem_fvo_app _ _ _).1 h with h | h
      · exact List.mem_append_left _ (fvo_subset_allVars r v h)
      · exact List.mem_append_right _ (fvo_subset_allVars s v h)
  | .lam x b, v, h => List.mem_cons_of_mem _ (fvo_subset_allVars b v ((mem_fvo_lam _ _ _).1 h).1)

theorem subst_sound (x : Var) (s : Term) (hs : HasType s x.ty) :
    ∀ (t : Term) (τ : Ty), HasType t τ →
      HasType (substTerm t x s) τ ∧
      ∀ ρ : Env, evalT τ (substTerm t x s) ρ = evalT τ t (ρ.upd x (evalT x.ty s ρ))
  | .var v, τ, ht => by
      have := hasType_var_inv ht
      subst this
      rw [subst_var]
      by_cases h : v = x
      · subst h
        refine ⟨by rw [if_pos rfl]; exact hs, fun ρ => ?_⟩
        rw [if_pos rfl, evalT_var, Env.upd_same]
      · refine ⟨by rw [if_neg h]; exact ht, fun ρ => ?_⟩
        rw [if_neg h, evalT_var, evalT_var, Env.upd_other _ _ h]
  | .app r u, τ, ht => by
      obtain ⟨σ, hr, hu⟩ := hasType_app_inv ht
      obtain ⟨hr', er⟩ := subst_sound x s hs r _ hr
      obtain ⟨hu', eu⟩ := subst_sound x s hs u _ hu
      rw [subst_app]
      exact ⟨.app hr' hu', fun ρ => by rw [evalT_app hr' hu', evalT_app hr hu, er, eu]⟩
  | .lam v body, τ, ht => by
      obtain ⟨ρ', rfl, hb⟩ := hasType_lam_inv ht
      by_cases hvx : v = x
      · subst hvx
        rw [subst_lam_self]
        refine ⟨ht, fun ρ => ?_⟩
        rw [evalT_lam hb, evalT_lam hb]
        funext a
        rw [Env.upd_upd_same]
      · by_cases hvs : v ∈ freeVarOccurrences s
        · rw [subst_lam_capture _ _ hvx hvs]
          dsimp only
          -- the fresh binder `v'`
          let N := Nat.max (maxVarId body) (Nat.max (maxVarId s) x.id) + 1
          have hNb : (⟨N, v.ty⟩ : Var) ∉ allVars body := fun h => by
            have := allVar_id_le_maxVarId body _ h
            have : maxVarId body ≤ Nat.max (maxVarId body) (Nat.max (maxVarId s) x.id) :=
              Nat.le_max_left _ _
            dsimp only [N] at *; omega
          have hNs : (⟨N, v.ty⟩ : Var) ∉ freeVarOccurrences s := fun h => by
            have := freeVar_id_le_maxVarId s _ h
            have : maxVarId s ≤ Nat.max (maxVarId body) (Nat.max (maxVarId s) x.id) :=
              Nat.le_trans (Nat.le_max_left _ _) (Nat.le_max_right _ _)
            dsimp only [N] at *; omega
          have hNx : (⟨N, v.ty⟩ : Var) ≠ x := fun h => by
            have := congrArg Var.id h
            have : x.id ≤ Nat.max (maxVarId body) (Nat.max (maxVarId s) x.id) :=
              Nat.le_trans (Nat.le_max_right _ _) (Nat.le_max_right _ _)
            dsimp only [N] at *; omega
          have hb' : HasType (renameFreeVar body v ⟨N, v.ty⟩) ρ' :=
            (rename_hasType_iff (x := v) (y := ⟨N, v.ty⟩) rfl body ρ').2 hb
          obtain ⟨hsub, esub⟩ := subst_sound x s hs (renameFreeVar body v ⟨N, v.ty⟩) ρ' hb'
          refine ⟨.lam _ hsub, fun ρ => ?_⟩
          rw [show evalT (.arr v.ty ρ') (.lam ⟨N, v.ty⟩ (substTerm (renameFreeVar body v
              ⟨N, v.ty⟩) x s)) ρ = fun a => evalT ρ' (substTerm (renameFreeVar body v
              ⟨N, v.ty⟩) x s) (ρ.upd ⟨N, v.ty⟩ a) from evalT_lam (x := ⟨N, v.ty⟩) hsub ρ,
            evalT_lam hb]
          funext a
          rw [esub, evalT_coincide x.ty s (ρ := ρ.upd ⟨N, v.ty⟩ a) (ρ' := ρ) (fun w hw => by
              rw [Env.upd_other _ _ (fun e => hNs (by rw [← e]; exact hw))]),
            rename_eval N body hNb ρ' hb]
          apply evalT_coincide
          intro w hw
          have hwN : w ≠ ⟨N, v.ty⟩ := fun e => hNb (e ▸ fvo_subset_allVars body w hw)
          by_cases hwv : w = v
          · subst hwv
            rw [Env.upd_same, Env.upd_same, Env.upd_other _ _ hNx, Env.upd_same]
          · rw [Env.upd_other _ _ hwv, Env.upd_other _ _ hwv]
            by_cases hwx : w = x
            · subst hwx; rw [Env.upd_same, Env.upd_same]
            · rw [Env.upd_other _ _ hwx, Env.upd_other _ _ hwx, Env.upd_other _ _ hwN]
        · rw [subst_lam_fresh _ _ hvx hvs]
          obtain ⟨hsub, esub⟩ := subst_sound x s hs body ρ' hb
          refine ⟨.lam v hsub, fun ρ => ?_⟩
          rw [evalT_lam hsub, evalT_lam hb]
          funext a
          rw [esub, evalT_coincide x.ty s (ρ := ρ.upd v a) (ρ' := ρ) (fun w hw => by
              rw [Env.upd_other _ _ (fun e => hvs (by rw [← e]; exact hw))]),
            Env.upd_comm _ _ _ hvx]
termination_by t => rawSize t
decreasing_by
  all_goals simp_wf
  all_goals (simp only [rawSize, renameFreeVar_rawSize]; omega)

/-! ## α-equivalence and reduction -/

theorem alpha_sound {t t' : Term} (h : AlphaEq t t') :
    ∀ τ, (HasType t τ → HasType t' τ ∧ ∀ ρ, evalT τ t ρ = evalT τ t' ρ) ∧
      (HasType t' τ → HasType t τ ∧ ∀ ρ, evalT τ t ρ = evalT τ t' ρ) := by
  induction h with
  | refl t => exact fun τ => ⟨fun h => ⟨h, fun _ => rfl⟩, fun h => ⟨h, fun _ => rfl⟩⟩
  | symm _ ih =>
      intro τ
      exact ⟨fun h => let r := (ih τ).2 h; ⟨r.1, fun ρ => (r.2 ρ).symm⟩,
        fun h => let r := (ih τ).1 h; ⟨r.1, fun ρ => (r.2 ρ).symm⟩⟩
  | trans _ _ ih1 ih2 =>
      intro τ
      refine ⟨fun h => ?_, fun h => ?_⟩
      · obtain ⟨h1, e1⟩ := (ih1 τ).1 h
        obtain ⟨h2, e2⟩ := (ih2 τ).1 h1
        exact ⟨h2, fun ρ => (e1 ρ).trans (e2 ρ)⟩
      · obtain ⟨h2, e2⟩ := (ih2 τ).2 h
        obtain ⟨h1, e1⟩ := (ih1 τ).2 h2
        exact ⟨h1, fun ρ => (e1 ρ).trans (e2 ρ)⟩
  | app _ _ iht ihs =>
      intro τ
      refine ⟨fun h => ?_, fun h => ?_⟩
      · obtain ⟨σ, ht, hs⟩ := hasType_app_inv h
        obtain ⟨ht', et⟩ := (iht _).1 ht
        obtain ⟨hs', es⟩ := (ihs _).1 hs
        exact ⟨.app ht' hs', fun ρ => by rw [evalT_app ht hs, evalT_app ht' hs', et, es]⟩
      · obtain ⟨σ, ht', hs'⟩ := hasType_app_inv h
        obtain ⟨ht, et⟩ := (iht _).2 ht'
        obtain ⟨hs, es⟩ := (ihs _).2 hs'
        exact ⟨.app ht hs, fun ρ => by rw [evalT_app ht hs, evalT_app ht' hs', et, es]⟩
  | lam_congr x _ ih =>
      intro τ
      refine ⟨fun h => ?_, fun h => ?_⟩
      · obtain ⟨ρ', rfl, hb⟩ := hasType_lam_inv h
        obtain ⟨hb', eb⟩ := (ih _).1 hb
        exact ⟨.lam x hb', fun ρ => by rw [evalT_lam hb, evalT_lam hb']; funext a; exact eb _⟩
      · obtain ⟨ρ', rfl, hb'⟩ := hasType_lam_inv h
        obtain ⟨hb, eb⟩ := (ih _).2 hb'
        exact ⟨.lam x hb, fun ρ => by rw [evalT_lam hb, evalT_lam hb']; funext a; exact eb _⟩
  | lam_rename x y t hty hy =>
      intro τ
      rcases hy with rfl | hy
      · rw [renameFreeVar_self]
        exact ⟨fun h => ⟨h, fun _ => rfl⟩, fun h => ⟨h, fun _ => rfl⟩⟩
      · obtain ⟨n, yty⟩ := y
        simp only at hty
        subst hty
        have key : ∀ ρ', HasType t ρ' → ∀ ρ,
            evalT (.arr x.ty ρ') (.lam x t) ρ =
              evalT (.arr x.ty ρ') (.lam ⟨n, x.ty⟩ (renameFreeVar t x ⟨n, x.ty⟩)) ρ := by
          intro ρ' hb ρ
          have hb' := (rename_hasType_iff (x := x) (y := ⟨n, x.ty⟩) rfl t ρ').2 hb
          rw [evalT_lam hb, show evalT (.arr x.ty ρ') (.lam ⟨n, x.ty⟩ (renameFreeVar t x
              ⟨n, x.ty⟩)) ρ = fun a => evalT ρ' (renameFreeVar t x ⟨n, x.ty⟩)
              (ρ.upd ⟨n, x.ty⟩ a) from evalT_lam (x := ⟨n, x.ty⟩) hb' ρ]
          funext a
          rw [rename_eval n t hy ρ' hb, Env.upd_same]
          apply evalT_coincide
          intro w hw
          have hwn : w ≠ ⟨n, x.ty⟩ := fun e => hy (e ▸ fvo_subset_allVars t w hw)
          by_cases hwx : w = x
          · subst hwx; rw [Env.upd_same, Env.upd_same]
          · rw [Env.upd_other _ _ hwx, Env.upd_other _ _ hwx, Env.upd_other _ _ hwn]
        refine ⟨fun h => ?_, fun h => ?_⟩
        · obtain ⟨ρ', rfl, hb⟩ := hasType_lam_inv h
          exact ⟨.lam _ ((rename_hasType_iff (x := x) (y := ⟨n, x.ty⟩) rfl t ρ').2 hb),
            key ρ' hb⟩
        · obtain ⟨ρ', hτ, hb'⟩ := hasType_lam_inv h
          subst hτ
          have hb := (rename_hasType_iff (x := x) (y := ⟨n, x.ty⟩) rfl t ρ').1 hb'
          exact ⟨.lam x hb, key ρ' hb⟩

/-- **Soundness of reduction**: typing and denotation are preserved. -/
theorem reduces_sound {t t' : Term} (h : ReducesTo t t') :
    ∀ τ, HasType t τ → HasType t' τ ∧ ∀ ρ, evalT τ t ρ = evalT τ t' ρ := by
  induction h with
  | beta x b s =>
      intro τ h
      obtain ⟨σ, hl, hs⟩ := hasType_app_inv h
      obtain ⟨ρ', hρ', hb⟩ := hasType_lam_inv hl
      injection hρ' with hσ hτ
      subst hσ; subst hτ
      obtain ⟨hsub, esub⟩ := subst_sound x s hs b _ hb
      exact ⟨hsub, fun ρ => by rw [evalT_app hl hs, evalT_lam hb, esub]⟩
  | app _ _ ih1 ih2 =>
      intro τ h
      obtain ⟨σ, ht, hs⟩ := hasType_app_inv h
      obtain ⟨ht', e1⟩ := ih1 _ ht
      obtain ⟨hs', e2⟩ := ih2 _ hs
      exact ⟨.app ht' hs', fun ρ => by rw [evalT_app ht hs, evalT_app ht' hs', e1, e2]⟩
  | lam x _ ih =>
      intro τ h
      obtain ⟨ρ', rfl, hb⟩ := hasType_lam_inv h
      obtain ⟨hb', eb⟩ := ih _ hb
      exact ⟨.lam x hb', fun ρ => by rw [evalT_lam hb, evalT_lam hb']; funext a; exact eb _⟩
  | refl_alpha h => exact fun τ ht => (alpha_sound h τ).1 ht
  | trans _ _ ih1 ih2 =>
      intro τ h
      obtain ⟨h1, e1⟩ := ih1 τ h
      obtain ⟨h2, e2⟩ := ih2 τ h1
      exact ⟨h2, fun ρ => (e1 ρ).trans (e2 ρ)⟩

end Schwichtenberg1976V2.Proofs

-- ===== Proofs/Schwichtenberg1976V2/Necessity.lean =====
/-!
# λ-definable functions are piecewise polynomials

Fix a zero/non-zero pattern `σ`. Values are taken as *families*: they depend on the input
`v` (with pattern `σ`) and on the values `ζ j` of formal variables of type `0`. A Kripke
logical relation `Rel n τ` (where the world `n` means "formal variables `< n` are in
scope") says at base type that a family has the form `P(v) + ζ j` or `P(v)` for a
polynomial `P`.

The probe with a fresh formal variable shows that a related family of type `0 → 0` is a
translation `x ↦ Q(v) + x` or a constant. Iterating a translation `vᵢ` times gives a
polynomial again, and iterating a constant gives the same constant when `vᵢ ≠ 0` (fixed by
`σ`). So the numerals `v̄ᵢ` are related, and by the fundamental lemma so is every closed term.
Soundness of reduction then turns "`t` defines `f`" into "`f` is that polynomial on `σ`".

No normalization or confluence theorem is needed, and everything is constructive.
-/

namespace Schwichtenberg1976V2.Proofs

open Schwichtenberg1976V2

/-! ## Iteration -/

def itr (f : Nat → Nat) : Nat → Nat → Nat
  | 0, x => x
  | n + 1, x => f (itr f n x)

theorem itr_translate {f : Nat → Nat} {q : Nat} (hf : ∀ x, f x = q + x) :
    ∀ n y, itr f n y = n * q + y
  | 0, y => by simp [itr]
  | n + 1, y => by rw [itr, hf, itr_translate hf n y, Nat.succ_mul]; omega

theorem itr_const {f : Nat → Nat} {c : Nat} (hf : ∀ x, f x = c) (n y : Nat) :
    itr f (n + 1) y = c := hf _

theorem itr_succ_zero : ∀ n, itr Nat.succ n 0 = n
  | 0 => rfl
  | n + 1 => by rw [itr, itr_succ_zero n]

/-- The semantic Church numeral. -/
def churchSem (n : Nat) : Sem Ty.nu := fun g x => itr g n x

/-! ## Families and the Kripke relation -/

section

variable {k : Nat} (σ : Fin k → Bool)

abbrev Inp := {v : Fin k → Nat // Matches σ v}

abbrev Fam (τ : Ty) := (Nat → Nat) → Inp σ → Sem τ

def Indep (n : Nat) {τ : Ty} (a : Fam σ τ) : Prop :=
  ∀ ζ ζ' : Nat → Nat, (∀ j, j < n → ζ j = ζ' j) → ∀ v, a ζ v = a ζ' v

def Rel : Nat → (τ : Ty) → Fam σ τ → Prop
  | n, .zero, a => ∃ P : (Fin k → Nat) → Nat, IsPolynomial P ∧
      ((∃ j, j < n ∧ ∀ ζ v, a ζ v = P v.1 + ζ j) ∨ (∀ ζ v, a ζ v = P v.1))
  | n, .arr A B, g => Indep σ n g ∧
      ∀ m, n ≤ m → ∀ a : Fam σ A, Rel m A a → Rel m B (fun ζ v => g ζ v (a ζ v))

end

variable {k : Nat} {σ : Fin k → Bool}

theorem rel_indep : ∀ {n : Nat} {τ : Ty} {a : Fam σ τ}, Rel σ n τ a → Indep σ n a
  | n, .zero, a, ⟨P, _, h⟩ => by
      intro ζ ζ' hζ v
      rcases h with ⟨j, hj, h⟩ | h
      · rw [h, h, hζ j hj]
      · rw [h, h]
  | _, .arr _ _, _, h => h.1

theorem rel_mono : ∀ {n m : Nat} {τ : Ty} {a : Fam σ τ}, n ≤ m → Rel σ n τ a → Rel σ m τ a
  | n, m, .zero, a, hnm, ⟨P, hP, h⟩ => by
      refine ⟨P, hP, ?_⟩
      rcases h with ⟨j, hj, h⟩ | h
      · exact Or.inl ⟨j, by omega, h⟩
      · exact Or.inr h
  | n, m, .arr _ _, g, hnm, ⟨hind, hg⟩ =>
      ⟨fun ζ ζ' hζ v => hind ζ ζ' (fun j hj => hζ j (by omega)) v,
        fun m' hm' a ha => hg m' (by omega) a ha⟩

theorem rel_default : ∀ (n : Nat) (τ : Ty), Rel σ n τ (fun _ _ => Sem.default τ)
  | n, .zero => ⟨fun _ => 0, .const 0, Or.inr fun _ _ => rfl⟩
  | n, .arr _ B => ⟨fun _ _ _ _ => rfl, fun m _ _ _ => rel_default m B⟩

/-! ## The fundamental lemma -/

theorem fundamental {t : Term} {τ : Ty} (ht : HasType t τ) :
    ∀ (n : Nat) (γ : ∀ x : Var, Fam σ x.ty), (∀ x, Rel σ n x.ty (γ x)) →
      Rel σ n τ (fun ζ v => evalT τ t (fun x => γ x ζ v)) := by
  induction ht with
  | var x =>
      intro n γ hγ
      have : (fun ζ v => evalT x.ty (.var x) (fun y => γ y ζ v)) = γ x := by
        funext ζ v; exact evalT_var _ _
      rw [this]; exact hγ x
  | @app t s σ' τ ht hs iht ihs =>
      intro n γ hγ
      have : (fun ζ v => evalT τ (.app t s) (fun y => γ y ζ v)) =
          fun ζ v => (evalT (.arr σ' τ) t (fun y => γ y ζ v)) (evalT σ' s (fun y => γ y ζ v)) := by
        funext ζ v; exact evalT_app ht hs _
      rw [this]
      exact (iht n γ hγ).2 n (Nat.le_refl n) _ (ihs n γ hγ)
  | @lam x b τ hb ih =>
      intro n γ hγ
      have : (fun ζ v => evalT (.arr x.ty τ) (.lam x b) (fun y => γ y ζ v)) =
          fun ζ v => fun a => evalT τ b (Env.upd (fun y => γ y ζ v) x a) := by
        funext ζ v; exact evalT_lam hb _
      rw [this]
      refine ⟨?_, fun m hnm a ha => ?_⟩
      · intro ζ ζ' hζ v
        have henv : (fun y => γ y ζ v) = (fun y => γ y ζ' v) := by
          funext y; exact rel_indep (hγ y) ζ ζ' hζ v
        show (fun a => evalT τ b (Env.upd (fun y => γ y ζ v) x a)) =
          (fun a => evalT τ b (Env.upd (fun y => γ y ζ' v) x a))
        rw [henv]
      · let γ' : ∀ y : Var, Fam σ y.ty := fun y ζ v => Env.upd (fun y => γ y ζ v) x (a ζ v) y
        have hγ' : ∀ y, Rel σ m y.ty (γ' y) := by
          intro y
          by_cases hyx : y = x
          · subst hyx
            have : γ' y = a := by funext ζ v; exact Env.upd_same _ _ _
            rw [this]; exact ha
          · have : γ' y = γ y := by funext ζ v; exact Env.upd_other _ _ hyx
            rw [this]; exact rel_mono hnm (hγ y)
        exact ih m γ' hγ'

/-! ## The base families -/

theorem rel_succ (n : Nat) : Rel σ n Ty.endo (fun _ _ => Nat.succ) := by
  refine ⟨fun _ _ _ _ => rfl, fun m _ a ⟨P, hP, h⟩ => ⟨fun v => P v + 1, .add hP (.const 1), ?_⟩⟩
  rcases h with ⟨j, hj, h⟩ | h
  · exact Or.inl ⟨j, hj, fun ζ v => by
      show Nat.succ (a ζ v) = P v.1 + 1 + ζ j; rw [h]; omega⟩
  · exact Or.inr fun ζ v => by show Nat.succ (a ζ v) = P v.1 + 1; rw [h]

/-- A related family of type `0 → 0` is a translation or a constant. -/
theorem char_endo {m : Nat} {g : Fam σ Ty.endo} (hg : Rel σ m Ty.endo g) :
    (∃ Q : (Fin k → Nat) → Nat, IsPolynomial Q ∧ ∀ ζ v x, g ζ v x = Q v.1 + x) ∨
    (∃ c : Fam σ .zero, Rel σ m .zero c ∧ ∀ ζ v x, g ζ v x = c ζ v) := by
  obtain ⟨hind, hg⟩ := hg
  have hprobe : Rel σ (m + 1) .zero (fun ζ _ => ζ m) :=
    ⟨fun _ => 0, .const 0, Or.inl ⟨m, by omega, fun ζ v => by show ζ m = 0 + ζ m; omega⟩⟩
  obtain ⟨P, hP, h⟩ := hg (m + 1) (by omega) _ hprobe
  let upd (ζ : Nat → Nat) (x : Nat) : Nat → Nat := fun j => if j = m then x else ζ j
  have hg_upd : ∀ ζ v x, g ζ v x = g (upd ζ x) v x := by
    intro ζ v x
    rw [hind ζ (upd ζ x) (fun j hj => by simp [upd, Nat.ne_of_lt hj]) v]
  have hval : ∀ ζ v x, g ζ v x = g (upd ζ x) v (upd ζ x m) := by
    intro ζ v x
    rw [hg_upd ζ v x]
    simp [upd]
  have hum : ∀ ζ x, upd ζ x m = x := fun ζ x => if_pos rfl
  rcases h with ⟨j, hj, h⟩ | h
  · by_cases hjm : j = m
    · refine Or.inl ⟨P, hP, fun ζ v x => ?_⟩
      have e : g (upd ζ x) v (upd ζ x m) = P v.1 + upd ζ x j := h (upd ζ x) v
      refine (hval ζ v x).trans (e.trans ?_)
      rw [hjm, hum]
    · refine Or.inr ⟨fun ζ v => P v.1 + ζ j, ⟨P, hP, Or.inl ⟨j, by omega, fun _ _ => rfl⟩⟩,
        fun ζ v x => ?_⟩
      have e : g (upd ζ x) v (upd ζ x m) = P v.1 + upd ζ x j := h (upd ζ x) v
      refine (hval ζ v x).trans (e.trans ?_)
      show P v.1 + (if j = m then x else ζ j) = P v.1 + ζ j
      rw [if_neg hjm]
  · refine Or.inr ⟨fun _ v => P v.1, ⟨P, hP, Or.inr fun _ _ => rfl⟩, fun ζ v x => ?_⟩
    have e : g (upd ζ x) v (upd ζ x m) = P v.1 := h (upd ζ x) v
    exact (hval ζ v x).trans e

theorem rel_numeral (n : Nat) (i : Fin k) :
    Rel σ n Ty.nu (fun _ v => churchSem (v.1 i)) := by
  refine ⟨fun _ _ _ _ => rfl, fun m _ g hg => ⟨?_, fun m' hmm' a ha => ?_⟩⟩
  · intro ζ ζ' hζ v
    show (fun x => itr (g ζ v) (v.1 i) x) = (fun x => itr (g ζ' v) (v.1 i) x)
    rw [rel_indep hg ζ ζ' hζ v]
  · show Rel σ m' .zero (fun ζ v => itr (g ζ v) (v.1 i) (a ζ v))
    obtain ⟨P', hP', ha⟩ := ha
    rcases char_endo hg with ⟨Q, hQ, hgQ⟩ | ⟨c, hc, hgc⟩
    · -- translation: iterating adds `vᵢ · Q(v)`
      refine ⟨fun v => v i * Q v + P' v, .add (.mul (.proj i) hQ) hP', ?_⟩
      rcases ha with ⟨j, hj, ha⟩ | ha
      · refine Or.inl ⟨j, hj, fun ζ v => ?_⟩
        have e : a ζ v = P' v.1 + ζ j := ha ζ v
        show itr (g ζ v) (v.1 i) (a ζ v) = v.1 i * Q v.1 + P' v.1 + ζ j
        refine (itr_translate (hgQ ζ v) _ _).trans ?_
        rw [e]; omega
      · refine Or.inr fun ζ v => ?_
        have e : a ζ v = P' v.1 := ha ζ v
        show itr (g ζ v) (v.1 i) (a ζ v) = v.1 i * Q v.1 + P' v.1
        refine (itr_translate (hgQ ζ v) _ _).trans ?_
        rw [e]
    · -- constant: `σ` fixes whether `vᵢ = 0`
      cases hσ : σ i with
      | false =>
          refine ⟨P', hP', ?_⟩
          have hv0 : ∀ v : Inp σ, v.1 i = 0 := by
            intro v
            have := v.2 i
            rw [hσ] at this
            cases h : v.1 i with
            | zero => rfl
            | succ n => rw [h] at this; exact Bool.noConfusion this
          rcases ha with ⟨j, hj, ha⟩ | ha
          · exact Or.inl ⟨j, hj, fun ζ v =>
              (congrArg (fun n => itr (g ζ v) n (a ζ v)) (hv0 v)).trans (ha ζ v)⟩
          · exact Or.inr fun ζ v =>
              (congrArg (fun n => itr (g ζ v) n (a ζ v)) (hv0 v)).trans (ha ζ v)
      | true =>
          have hv1 : ∀ v : Inp σ, ∃ n, v.1 i = n + 1 := by
            intro v
            have := v.2 i
            rw [hσ] at this
            cases h : v.1 i with
            | zero => rw [h] at this; exact Bool.noConfusion this
            | succ n => exact ⟨n, rfl⟩
          obtain ⟨Pc, hPc, hcf⟩ := rel_mono hmm' hc
          refine ⟨Pc, hPc, ?_⟩
          have hit : ∀ ζ v, itr (g ζ v) (v.1 i) (a ζ v) = c ζ v := by
            intro ζ v
            obtain ⟨n, hn⟩ := hv1 v
            exact (congrArg (fun n => itr (g ζ v) n (a ζ v)) hn).trans
              (itr_const (hgc ζ v) n _)
          rcases hcf with ⟨j, hj, hcf⟩ | hcf
          · exact Or.inl ⟨j, hj, fun ζ v => (hit ζ v).trans (hcf ζ v)⟩
          · exact Or.inr fun ζ v => (hit ζ v).trans (hcf ζ v)

/-! ## Applying a defining term to numerals -/

def applyAll : (k : Nat) → Sem (Ty.nuArity k) → (Fin k → Sem Ty.nu) → Sem Ty.nu
  | 0, f, _ => f
  | k + 1, f, xs => applyAll k (f (xs 0)) (fun i => xs i.succ)

theorem rel_applyAll {n : Nat} :
    ∀ (m : Nat) {F : Fam σ (Ty.nuArity m)} {G : Fin m → Fam σ Ty.nu},
      Rel σ n (Ty.nuArity m) F → (∀ i, Rel σ n Ty.nu (G i)) →
      Rel σ n Ty.nu (fun ζ v => applyAll m (F ζ v) (fun i => G i ζ v))
  | 0, _, _, hF, _ => hF
  | m + 1, F, G, hF, hG =>
      rel_applyAll m (F := fun ζ v => F ζ v (G 0 ζ v)) (G := fun i => G i.succ)
        (hF.2 n (Nat.le_refl n) _ (hG 0)) (fun i => hG i.succ)

theorem evalT_iterApp (ρ : Env) {b : Term} (hb : HasType b .zero) :
    ∀ n, evalT .zero (iterApp (.var numα) b n) ρ = itr (ρ numα) n (evalT .zero b ρ)
  | 0 => rfl
  | n + 1 => by
      have hα : HasType (.var numα) (.arr .zero .zero) := .var numα
      rw [iterApp_succ, evalT_app hα (iterApp_hasType rfl hb n), evalT_iterApp ρ hb n]
      rfl

theorem evalT_numeral (n : Nat) (ρ : Env) : evalT Ty.nu (churchNumeral n) ρ = churchSem n := by
  have hbody : HasType (iterApp (.var numα) (.var numx) n) .zero :=
    iterApp_hasType rfl (.var numx) n
  have hinner : HasType (.lam numx (iterApp (.var numα) (.var numx) n)) Ty.endo :=
    .lam numx hbody
  rw [churchNumeral_eq]
  rw [show evalT Ty.nu (.lam numα (.lam numx (iterApp (.var numα) (.var numx) n))) ρ =
      fun g => evalT Ty.endo (.lam numx (iterApp (.var numα) (.var numx) n)) (ρ.upd numα g)
    from evalT_lam (x := numα) hinner ρ]
  funext g x
  rw [show evalT Ty.endo (.lam numx (iterApp (.var numα) (.var numx) n)) (ρ.upd numα g) =
      fun x => evalT .zero (iterApp (.var numα) (.var numx) n) ((ρ.upd numα g).upd numx x)
    from evalT_lam (x := numx) hbody _]
  show evalT .zero (iterApp (.var numα) (.var numx) n) (((ρ.upd numα g).upd numx x)) =
    itr g n x
  rw [evalT_iterApp _ (.var numx) n]
  have h1 : (ρ.upd numα g).upd numx x numα = g :=
    (Env.upd_other _ _ ne_αx).trans (Env.upd_same _ _ _)
  have h2 : evalT .zero (.var numx) ((ρ.upd numα g).upd numx x) = x :=
    (evalT_var numx _).trans (Env.upd_same _ _ _)
  exact (congrArg (fun f => itr f n (evalT .zero (.var numx) ((ρ.upd numα g).upd numx x)))
    h1).trans (congrArg (fun y => itr g n y) h2)

theorem evalT_appMany_numerals (ρ : Env) :
    ∀ (m : Nat) (t : Term) (v : Fin m → Nat), HasType t (Ty.nuArity m) →
      evalT Ty.nu (Term.appMany t (numeralArgs m v)) ρ =
        applyAll m (evalT (Ty.nuArity m) t ρ) (fun i => churchSem (v i))
  | 0, t, v, _ => rfl
  | m + 1, t, v, ht => by
      have hn := numeral_hasType (v 0)
      show evalT Ty.nu (Term.appMany (.app t (churchNumeral (v 0)))
        (numeralArgs m (fun i => v i.succ))) ρ = _
      rw [evalT_appMany_numerals ρ m _ _ (.app ht hn)]
      show applyAll m (evalT (Ty.nuArity m) (.app t (churchNumeral (v 0))) ρ) _ =
        applyAll m (evalT (Ty.nuArity (m + 1)) t ρ (churchSem (v 0))) _
      rw [evalT_app ht hn, evalT_numeral]
      rfl

/-! ## Necessity -/

theorem necessity {k : Nat} {f : (Fin k → Nat) → Nat} (h : IsLambdaDefinable k f) :
    IsPiecewisePolynomial k f := by
  obtain ⟨t, hty, _, hred⟩ := h
  intro σ
  let ρ0 : Env := fun x => Sem.default x.ty
  -- `f v` is read off the denotation of `t`
  have hval : ∀ v, f v = applyAll k (evalT (Ty.nuArity k) t ρ0) (fun i => churchSem (v i))
      Nat.succ 0 := by
    intro v
    have hT : HasType (Term.appMany t (numeralArgs k v)) Ty.nu := by
      rw [numeralArgs_eq]
      exact appMany_hasType _ (by simpa using hty) (by
        intro a ha
        simp only [List.mem_map] at ha
        obtain ⟨i, _, rfl⟩ := ha
        exact numeral_hasType _)
    have := (reduces_sound (hred v) Ty.nu hT).2 ρ0
    rw [evalT_appMany_numerals ρ0 k t v hty, evalT_numeral] at this
    rw [this]
    exact (itr_succ_zero (f v)).symm
  -- the fundamental lemma for `t`, applied to the numerals, `succ` and a formal variable
  have hF : Rel σ 0 (Ty.nuArity k) (fun _ _ => evalT (Ty.nuArity k) t ρ0) :=
    fundamental hty 0 (fun x _ _ => Sem.default x.ty) (fun x => rel_default 0 x.ty)
  have hH := rel_applyAll k hF (fun i => rel_numeral (σ := σ) 0 i)
  have h1 := hH.2 0 (Nat.le_refl 0) _ (rel_succ 0)
  obtain ⟨P, hP, hform⟩ := h1.2 1 (by omega) (fun ζ _ => ζ 0)
    ⟨fun _ => 0, .const 0, Or.inl ⟨0, by omega, fun ζ v => by show ζ 0 = 0 + ζ 0; omega⟩⟩
  refine ⟨P, hP, fun v hv => ?_⟩
  rw [hval v]
  rcases hform with ⟨j, hj, hform⟩ | hform
  · have := hform (fun _ => 0) ⟨v, hv⟩
    simpa using this
  · exact hform (fun _ => 0) ⟨v, hv⟩

end Schwichtenberg1976V2.Proofs

