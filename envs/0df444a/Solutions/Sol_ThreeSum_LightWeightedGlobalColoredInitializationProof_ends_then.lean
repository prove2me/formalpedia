attribute [local simp] _root_.ThreeSum.LightWeightedGlobalColoredInitializationProof.read_setLocal
theorem _root_.solution {lim : Limits} {radix D E K bDigit a b scaleBase p R F n header depth tailTime : ℕ}
    (raws : List ℤ) (words maps : List ℕ) (xl yl zl xr yr zr : List ℤ) (suffix : Program) (locals : List ℤ) (μ : ℕ → ℤ)
    (h : ℕ → ℕ) (h1 : frame locals 1 = (n : ℤ)) (h5 : frame locals 5 = (header : ℤ))
    (hread : ∀ i < 19, μ (header + i) = (h i : ℤ)) (hHeader : header + 19 ≤ h 13) (hn : 1 ≤ n) (hbDigit : 1 ≤ bDigit)
    (hw : (lim.space : ℤ) ≤ lim.word) (hend : finish (h 13) (capacity D E (n + h 14)) ≤ lim.space)
    (hUW : ((n + h 14 : ℕ) : ℤ) + 1 ≤ lim.word) (hEW : (E : ℤ) ≤ lim.word) (hqC : h 17 * h 17 ≤ capacity D E (n + h 14))
    (hconstants : p + R + F ≤ capacity D E (n + h 14))
    (hword : (LightTernaryInitialBudgets.word K bDigit a b scaleBase n (h 16) (h 9) : ℤ) ≤ lim.word)
    (hd : depth + 1 < lim.depth) (tail : Stmt) (Q : State → Prop)
    (next :
      ∀ σ,
        Initialized D E K bDigit a b scaleBase n (h 14) (h 13) (h 17) (h 16) (h 9) (runtimeValues n p R F h)
            (frame locals) σ.loc μ σ.mem →
          Ends lim (libraries radix D E K bDigit a b scaleBase p R F raws words maps xl yl zl xr yr zr ++ suffix) depth
            tail σ tailTime Q) :
    Ends lim (libraries radix D E K bDigit a b scaleBase p R F raws words maps xl yl zl xr yr zr ++ suffix) depth
      (initChunk p R F tail) ⟨frame locals, μ⟩ (time E K + tailTime) Q :=
  by
  change locals[1]?.getD 0 = (n : ℤ) at h1
  change locals[5]?.getD 0 = (header : ℤ) at h5
  let af := h 13
  let C := capacity D E (n + h 14)
  let xs := runtimeValues n p R F h
  have endArena : af + 67 * C ≤ lim.space := hend
  have hCmin : 256 ≤ C := capacity_pos D E (n + h 14)
  have hCspace : C ≤ lim.space := by change af + 67 * C ≤ lim.space at hend; omega
  have hCword : (C : ℤ) ≤ lim.word := (Int.ofNat_le.mpr hCspace).trans hw
  have haf : af + 1 < lim.space := by change af + 67 * C ≤ lim.space at hend; omega
  have hHspace : header + 19 ≤ lim.space := by dsimp only [af] at haf; omega
  have hp : (p : ℤ) ≤ lim.word := by dsimp only [C] at hCword; omega
  have hR : (R : ℤ) ≤ lim.word := by dsimp only [C] at hCword; omega
  have hF : (F : ℤ) ≤ lim.word := by dsimp only [C] at hCword; omega
  have htc :=
    (template_call (K := K) (bDigit := bDigit) (a := a) (b := b) (scaleBase := scaleBase) (p := p) (R := R) (F := F)
          (D := D) (E := E) (radix := radix) raws words maps xl yl zl xr yr zr xs rfl μ rfl rfl rfl hw hend hUW hEW hqC
          hd).append
      suffix
  have readI (i : ℤ) (hi : 0 ≤ i) (hj : i < 19) : μ ((header : ℤ) + i).toNat = (h i.toNat : ℤ) :=
    by
    rw [show ((header : ℤ) + i).toNat = header + i.toNat by omega]
    exact hread _ (by omega)
  unfold initChunk time H arenaArgs A
  simp only [H]
  focus
    ((first
        | refine _root_.Light.Ends.seqSelf ?_
        | refine _root_.Light.Ends.skipLast ?_);
      (repeat
          with_unfolding_none
            first
            | refine _root_.Light.Ends.seqAssoc ?_
            | refine _root_.Light.Ends.skipThen ?_))
    refine _root_.Light.Ends.setToThen af ?_ ?_ ?_
    on_goal -1 =>
      first
      | ( simp only [_root_.Light.Stmt.blockCost, _root_.Light.Cond.cost, _root_.Light.Expr.cost, _root_.List.map_cons,
            _root_.List.map_nil, _root_.List.sum_cons, _root_.List.sum_nil, H, h5, readI, af]
          first
          | omega
          | (ring_nf; omega))
      | omega
      |
        (simp [H, h5, readI, af] <;> first
            | omega
            | (ring_nf; omega))
    on_goal -1 =>
      ( (try have := _root_.Light.Std.space_le (by assumption))
        (try have := _root_.Light.Std.const_le (by assumption))
        simp [_root_.Light.Limits.Addr, _root_.abs_le, -_root_.abs_mul, H, h5, readI, af] <;> omega)
    try with_unfolding_none refine _root_.Light.Ends.skip ?_
  focus
    ((first
        | refine _root_.Light.Ends.seqSelf ?_
        | refine _root_.Light.Ends.skipLast ?_);
      (repeat
          with_unfolding_none
            first
            | refine _root_.Light.Ends.seqAssoc ?_
            | refine _root_.Light.Ends.skipThen ?_))
    first
    | refine _root_.Light.Ends.callToThen (htc _ (by omega)) ?_ ?_ ?_ ?_
    | refine _root_.Light.Ends.callToThen htc ?_ ?_ ?_ ?_
    on_goal -1 =>
      first
      | ( simp only [_root_.Light.Stmt.blockCost, _root_.Light.Cond.cost, _root_.Light.Expr.cost, _root_.List.map_cons,
            _root_.List.map_nil, _root_.List.sum_cons, _root_.List.sum_nil, arenaArgs, H, h1, h5, readI, xs,
            runtimeValues, values, af]
          first
          | omega
          | (ring_nf; omega))
      | omega
      |
        (simp [arenaArgs, H, h1, h5, readI, xs, runtimeValues, values, af] <;> first
            | omega
            | (ring_nf; omega))
    on_goal -1 => omega
    on_goal -1 =>
      ( (try have := _root_.Light.Std.space_le (by assumption))
        (try have := _root_.Light.Std.const_le (by assumption))
        simp [_root_.Light.Limits.Addr, _root_.abs_le, -_root_.abs_mul, arenaArgs, H, h1, h5, readI, xs, runtimeValues,
            values, af] <;> omega)
    on_goal -1 => (rintro rt μt ⟨hrt, host, seed, keep⟩; try with_unfolding_none refine _root_.Light.Ends.skip ?_)
  have ht (i : ℕ) (hi : i < 19) : μt (header + i) = (h i : ℤ) := (keep _ (by dsimp only [af]; omega)).trans (hread i hi)
  have readIT (i : ℤ) (hi : 0 ≤ i) (hj : i < 19) : μt ((header : ℤ) + i).toNat = (h i.toNat : ℤ) :=
    by
