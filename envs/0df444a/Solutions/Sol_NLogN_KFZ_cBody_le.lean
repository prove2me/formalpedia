theorem cRepl_le (N M B : ℕ) : cRepl N M B ≤ 10 ^ 4 * (N + 1) * (M + 1) * (B + 2) := by
  have h1 := KFT.cRpt_le M; have h2 := cCnt_le M
  have h3 := KFT.cRpt_le N; have h4 := cCnt_le N
  have hW : 1 ≤ (M + 1) * (B + 2) := Nat.one_le_iff_ne_zero.mpr (by positivity)
  have f1 : M * (110 * (B + 1) + 64) = 110 * (M * B) + 174 * M := by ring
  have f2 : M * (410 * (B + 1) + 64) = 410 * (M * B) + 474 * M := by ring
  have f3 : 5000 * ((M + 1) * (B + 2)) = 5000 * (M * B) + 10000 * M + 5000 * B + 10000 := by ring
  have e : M * (110 * (B + 1) + 64) + 60 + KFT.cRpt M + cCnt M +
      (M * (410 * (B + 1) + 64) + 60 + KFT.cRpt M + cCnt M) + 64 ≤ 5000 * ((M + 1) * (B + 2)) := by
    have := Nat.zero_le (M * B); rw [f1, f2, f3]; linarith
  unfold cRepl
  have e2 := Nat.mul_le_mul_left N e
  have e3 : 10 ^ 4 * (N + 1) * (M + 1) * (B + 2) =
      10 ^ 4 * (N * ((M + 1) * (B + 2))) + 10 ^ 4 * ((M + 1) * (B + 2)) := by ring
  have e4 : N * (5000 * ((M + 1) * (B + 2))) = 5000 * (N * ((M + 1) * (B + 2))) := by ring
  have e5 : N ≤ N * ((M + 1) * (B + 2)) := Nat.le_mul_of_pos_right _ hW
  rw [e3]; rw [e4] at e2
  generalize N * ((M + 1) * (B + 2)) = V at e2 e5 ⊢
  generalize (M + 1) * (B + 2) = W at hW ⊢
