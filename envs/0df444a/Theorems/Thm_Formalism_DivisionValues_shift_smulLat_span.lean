variable {K : Type} [Field K] [NumberField K] [StarRing K] {d : ℕ}

theorem Formalism.DivisionValues.shift_smulLat_span (a : K) (f : Fin d → Fin d → K) :
    smulLat a (Submodule.span (𝓞 K) (Set.range f)) =
      Submodule.span (𝓞 K) (Set.range fun k => a • f k) := by sorry
