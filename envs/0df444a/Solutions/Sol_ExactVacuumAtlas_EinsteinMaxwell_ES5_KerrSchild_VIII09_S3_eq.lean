theorem hasDerivAt_inv (R : ℝ) (hR : R ≠ 0) : HasDerivAt (fun s : ℝ => 1 / s) (-1 / R ^ 2) R := by
  have h : HasDerivAt (fun s : ℝ => s⁻¹) (-1 / R ^ 2) R := by
    have hd : DifferentiableAt ℝ (fun s : ℝ => s⁻¹) R := by fun_prop
    have hdv : deriv (fun s : ℝ => s⁻¹) R = -1 / R ^ 2 := by
      rw [deriv_inv]
      ring
    rw [← hdv]
    exact hd.hasDerivAt
  simpa [one_div] using h

theorem hasDerivAt_Ztilde (j : ℝ) {R : ℝ} (hR : 3 < R) :
    HasDerivAt (Ztilde j) (-(j ^ 2 * ((1 / R) ^ 2 * (Zbar (1 / R) + (1 / R) * ZbarD (1 / R))))) R := by
  have hR0 : (R:ℝ) ≠ 0 := by linarith
  have hx : (1:ℝ) / R ∈ UG := one_div_mem_UG_of_three hR
  have h1 : HasDerivAt (fun s : ℝ => 1 / s) (-1 / R ^ 2) R := hasDerivAt_inv R hR0
  have h2 := (hasDerivAt_Zbar hx).comp R h1
  have h3 := h1.mul h2
  have h4 := h3.const_mul (j ^ 2)
  have hgoal : (-(j ^ 2 * ((1 / R) ^ 2 * (Zbar (1 / R) + (1 / R) * ZbarD (1 / R)))))
      = j ^ 2 * (-1 / R ^ 2 * Zbar (1 / R) + 1 / R * (ZbarD (1 / R) * (-1 / R ^ 2))) := by
    field_simp
    ring
  rw [hgoal]
  have hfun : Ztilde j = fun y : ℝ => j ^ 2 * ((fun s : ℝ => 1 / s) * Zbar ∘ fun s : ℝ => 1 / s) y := by
    funext y
    simp only [Ztilde, Pi.mul_apply, Function.comp_apply]
  rw [hfun]
  exact h4

/-! ## The actual first-order coefficients and their derivatives -/

theorem bstar_anchor_eq {j R : ℝ} : bstar 3 1 (3 / 2) j R = -3 * j / (8 * R) := by
  unfold bstar n1
  norm_num
  ring

theorem hasDerivAt_bstar_anchor (j : ℝ) {R : ℝ} (hR : R ≠ 0) :
    HasDerivAt (bstar 3 1 (3 / 2) j) (3 * j / (8 * R ^ 2)) R := by
  have h : HasDerivAt (fun s : ℝ => -3 * j / (8 * s)) (3 * j / (8 * R ^ 2)) R := by
    have h1 : HasDerivAt (fun s : ℝ => 8 * s) 8 R := by
      simpa using (hasDerivAt_id R).const_mul 8
    have h2 := (hasDerivAt_const (x := R) (-3 * j)).div h1 (by simpa using hR)
    have hsum : HasDerivAt (fun s : ℝ => -3 * j / (8 * s))
        ((0 * (8 * R) - -3 * j * 8) / (8 * R) ^ 2) R := by
      convert h2 using 1 <;> first | rfl | (funext y; simp [Pi.div_apply])
    refine hsum.congr_deriv ?_
    field_simp
    ring
  refine h.congr_of_eventuallyEq ?_
  filter_upwards with s
  exact bstar_anchor_eq

theorem deriv_bstar (j : ℝ) {R : ℝ} (hR : 3 < R) :
    deriv (bstar 3 1 (3 / 2) j) R = 3 * j / (8 * R ^ 2) :=
  (hasDerivAt_bstar_anchor j (by linarith)).deriv

theorem deriv_Ztilde (j : ℝ) {R : ℝ} (hR : 3 < R) :
    deriv (Ztilde j) R
      = -(j ^ 2 * ((1 / R) ^ 2 * (Zbar (1 / R) + (1 / R) * ZbarD (1 / R)))) :=
  (hasDerivAt_Ztilde j hR).deriv

