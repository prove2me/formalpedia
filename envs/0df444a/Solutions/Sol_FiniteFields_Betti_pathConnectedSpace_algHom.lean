section

/-!
# Topologie faible sur `Pts A` et propreté de la projection (A6)

* `Pts A` porte la topologie faible des évaluations `φ ↦ φ(a)` (instance locale `ptsTop`).
* `norm_le_rootBound` : borne de Cauchy, continue en `z`, sur les racines de `F(z, ·)`.
* `exists_tendsto_subseq` : une suite de points dont les projections convergent a une
  sous-suite convergente (Bolzano–Weierstrass sur des générateurs `bⱼ` de `A`, puis passage à
  la limite dans les identités d'anneau).
* `isClosedMap_proj` : la projection de Noether est fermée.
-/

open Polynomial Filter Topology

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

section Top

variable {A : Type} [CommRing A] [Algebra ℂ A]

/-- La topologie faible sur `Pts A`. -/
noncomputable scoped instance ptsTop : TopologicalSpace (Pts A) :=
  TopologicalSpace.induced (fun φ : Pts A ↦ (⇑φ : A → ℂ)) inferInstance

theorem isEmbedding_coe_pts : Topology.IsEmbedding (fun φ : Pts A ↦ (⇑φ : A → ℂ)) :=
  ⟨⟨rfl⟩, DFunLike.coe_injective⟩

instance : T2Space (Pts A) := isEmbedding_coe_pts.t2Space

theorem continuous_apply_pts (a : A) : Continuous fun φ : Pts A ↦ φ a :=
  (continuous_apply a).comp isEmbedding_coe_pts.continuous

theorem continuous_pts_iff {Y : Type*} [TopologicalSpace Y] (f : Y → Pts A) :
    Continuous f ↔ ∀ a, Continuous fun y ↦ f y a := by
  rw [isEmbedding_coe_pts.isInducing.continuous_iff, continuous_pi_iff]
  rfl

theorem tendsto_pts_iff {ι : Type*} {l : Filter ι} (f : ι → Pts A) (φ : Pts A) :
    Tendsto f l (𝓝 φ) ↔ ∀ a, Tendsto (fun i ↦ f i a) l (𝓝 (φ a)) := by
  rw [isEmbedding_coe_pts.isInducing.tendsto_nhds_iff, tendsto_pi_nhds]
  rfl

end Top

variable {n : ℕ} {A : Type} [CommRing A] [Algebra ℂ A] [Algebra (Sn n) A]
  [IsScalarTower ℂ (Sn n) A]

theorem continuous_proj : Continuous (proj (n := n) (A := A)) :=
  continuous_pi fun _ ↦ continuous_apply_pts _

/-! ### Borne de Cauchy -/

/-- Borne continue en `z` sur les racines de `F(z, ·)`. -/
noncomputable def rootBound (F : (Sn n)[X]) (z : Fin n → ℂ) : ℝ :=
  1 + ∑ i ∈ Finset.range (F.natDegree + 1), ‖MvPolynomial.eval z (F.coeff i)‖

theorem continuous_rootBound (F : (Sn n)[X]) : Continuous (rootBound F) := by
  unfold rootBound
  refine continuous_const.add (continuous_finsetSum _ fun i _ ↦ ?_)
  exact (MvPolynomial.continuous_eval _).norm

theorem norm_le_rootBound {F : (Sn n)[X]} (hF : F.Monic) (z : Fin n → ℂ) {t : ℂ}
    (ht : (specz F z).IsRoot t) : ‖t‖ ≤ rootBound F z := by
  have hm : (specz F z).Monic := hF.map _
  have hlt : ‖t‖₊ < cauchyBound (specz F z) := ht.norm_lt_cauchyBound hm.ne_zero
  have hsup : (Finset.range (specz F z).natDegree).sup (‖(specz F z).coeff ·‖₊) ≤
      ∑ i ∈ Finset.range (F.natDegree + 1), ‖MvPolynomial.eval z (F.coeff i)‖₊ := by
    refine Finset.sup_le fun i hi ↦ ?_
    rw [specz, coeff_map]
    refine Finset.single_le_sum (f := fun i ↦ ‖MvPolynomial.eval z (F.coeff i)‖₊)
      (fun _ _ ↦ zero_le) ?_
    rw [show (specz F z).natDegree = F.natDegree from hF.natDegree_map _] at hi
    simp only [Finset.mem_range] at hi ⊢
    omega
  have hcb : (cauchyBound (specz F z) : ℝ) ≤ rootBound F z := by
    rw [cauchyBound, hm.leadingCoeff, nnnorm_one, div_one, NNReal.coe_add, NNReal.coe_one,
      rootBound, add_comm]
    gcongr
    refine (NNReal.coe_le_coe.mpr hsup).trans_eq ?_
    simp
  calc ‖t‖ = (‖t‖₊ : ℝ) := rfl
    _ ≤ cauchyBound (specz F z) := NNReal.coe_le_coe.mpr hlt.le
    _ ≤ rootBound F z := hcb

/-! ### Propreté -/

section Limit

variable [Module.Finite (Sn n) A]

/-- **Bolzano–Weierstrass dans `Pts A`.** -/
theorem exists_tendsto_subseq (φ : ℕ → Pts A) {z : Fin n → ℂ}
    (hz : Tendsto (fun k ↦ proj (φ k)) atTop (𝓝 z)) :
    ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∃ φ₀ : Pts A, Tendsto (φ ∘ ψ) atTop (𝓝 φ₀) := by
  classical
  obtain ⟨r, b, hb⟩ := Module.Finite.exists_fin (R := Sn n) (M := A)
  let w : ℕ → (Fin r → ℂ) := fun k j ↦ φ k (b j)
  -- les coordonnées `φₖ(bⱼ)` sont bornées
  have hM : ∀ j, ∃ M, ∀ k, rootBound (minpoly (Sn n) (b j)) (proj (φ k)) ≤ M := fun j ↦ by
    have ht := ((continuous_rootBound (minpoly (Sn n) (b j))).tendsto z).comp hz
    obtain ⟨M, hM⟩ := (Metric.isBounded_range_of_tendsto _ ht).bddAbove
    exact ⟨M, fun k ↦ hM ⟨k, rfl⟩⟩
  choose M hM using hM
  have hbd : Bornology.IsBounded (Set.range w) := by
    refine isBounded_iff_forall_norm_le.mpr ⟨∑ j, |M j|, ?_⟩
    rintro _ ⟨k, rfl⟩
    refine (pi_norm_le_iff_of_nonneg (by positivity)).mpr fun j ↦ ?_
    have h1 := norm_le_rootBound (minpoly.monic (Algebra.IsIntegral.isIntegral (R := Sn n) (b j)))
      (proj (φ k)) (isRoot_apply (φ k))
    calc ‖w k j‖ ≤ M j := h1.trans (hM j k)
      _ ≤ |M j| := le_abs_self _
      _ ≤ ∑ j, |M j| := Finset.single_le_sum (f := fun j ↦ |M j|) (fun _ _ ↦ abs_nonneg _)
          (Finset.mem_univ j)
  obtain ⟨w₀, -, ψ, hψ, hw⟩ := tendsto_subseq_of_bounded hbd fun k ↦ Set.mem_range_self k
  refine ⟨ψ, hψ, ?_⟩
  -- passage à la limite dans chaque évaluation
  have hcoef : ∀ a : A, ∃ s : Fin r → Sn n, ∑ j, s j • b j = a := fun a ↦
    (Submodule.mem_span_range_iff_exists_fun _).mp (hb ▸ Submodule.mem_top)
  choose s hs using hcoef
  have hz' := hz.comp hψ.tendsto_atTop
  let L : A → ℂ := fun a ↦ ∑ j, MvPolynomial.eval z (s a j) * w₀ j
  have hL : ∀ a, Tendsto (fun k ↦ φ (ψ k) a) atTop (𝓝 (L a)) := fun a ↦ by
    have hform : ∀ k, φ (ψ k) a = ∑ j, MvPolynomial.eval (proj (φ (ψ k))) (s a j) *
        φ (ψ k) (b j) := fun k ↦ by
      conv_lhs => rw [← hs a]
      rw [map_sum]
      exact Finset.sum_congr rfl fun j _ ↦ apply_smul _ _ _
    simp_rw [hform]
    refine tendsto_finsetSum _ fun j _ ↦ ?_
    refine Tendsto.mul (((MvPolynomial.continuous_eval _).tendsto z).comp hz') ?_
    exact ((continuous_apply j).tendsto w₀).comp hw
  let φ₀ : Pts A :=
    { toFun := L
      map_one' := tendsto_nhds_unique (hL 1) (by simp)
      map_mul' := fun a a' ↦ tendsto_nhds_unique (hL (a * a'))
        (by simpa only [map_mul] using (hL a).mul (hL a'))
      map_zero' := tendsto_nhds_unique (hL 0) (by simp)
      map_add' := fun a a' ↦ tendsto_nhds_unique (hL (a + a'))
        (by simpa only [map_add] using (hL a).add (hL a'))
      commutes' := fun c ↦ tendsto_nhds_unique (hL (algebraMap ℂ A c)) (by simp) }
  exact ⟨φ₀, (tendsto_pts_iff _ _).mpr hL⟩

/-- **La projection de Noether est fermée.** -/
theorem isClosedMap_proj : IsClosedMap (proj (n := n) (A := A)) := by
  intro C hC
  refine isClosed_of_closure_subset fun z hz ↦ ?_
  obtain ⟨zs, hzs, hlim⟩ := mem_closure_iff_seq_limit.mp hz
  choose φ hφC hφz using hzs
  have hlim' : Tendsto (fun k ↦ proj (φ k)) atTop (𝓝 z) := by simpa [hφz] using hlim
  obtain ⟨ψ, hψ, φ₀, hφ₀⟩ := exists_tendsto_subseq φ hlim'
  refine ⟨φ₀, hC.mem_of_tendsto hφ₀ (Eventually.of_forall fun k ↦ hφC (ψ k)), ?_⟩
  exact tendsto_nhds_unique ((continuous_proj.tendsto φ₀).comp hφ₀)
    (hlim'.comp hψ.tendsto_atTop)

end Limit

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/LocalRoot.lean` -/

section

/-!
# Racines locales holomorphes (A6)

Pour `F ∈ S[W]`, soit `P(z, t) = F(z, t)`. Si `t₀` est racine simple de `F(z₀, ·)`, le théorème
d'inversion locale appliqué à `Φ(z, t) = (z, P(z, t))` donne une racine locale `τ`, continue et
ℂ-différentiable près de `z₀`, avec unicité locale (`exists_localRoot`).
-/

open Polynomial Filter Topology

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

variable {n : ℕ}

theorem contDiff_mvEval (q : Sn n) : ContDiff ℂ ⊤ fun z : Fin n → ℂ ↦ MvPolynomial.eval z q := by
  induction q using MvPolynomial.induction_on with
  | C r => simpa using contDiff_const
  | add p q hp hq => simpa using hp.add hq
  | mul_X p i hp => simpa using hp.mul (contDiff_apply ℂ ℂ i)

/-- `P(z, t) = F(z, t)`. -/
noncomputable def Pf (F : (Sn n)[X]) (p : (Fin n → ℂ) × ℂ) : ℂ := (specz F p.1).eval p.2

theorem Pf_eq_sum (F : (Sn n)[X]) (p : (Fin n → ℂ) × ℂ) :
    Pf F p = ∑ i ∈ Finset.range (F.natDegree + 1), MvPolynomial.eval p.1 (F.coeff i) * p.2 ^ i := by
  rw [Pf, specz, eval_eq_sum_range' (n := F.natDegree + 1)
    (Nat.lt_succ_of_le (natDegree_map_le))]
  simp [coeff_map]

theorem contDiff_Pf (F : (Sn n)[X]) : ContDiff ℂ ⊤ (Pf F) := by
  have : Pf F = fun p ↦ ∑ i ∈ Finset.range (F.natDegree + 1),
      MvPolynomial.eval p.1 (F.coeff i) * p.2 ^ i := funext (Pf_eq_sum F)
  rw [this]
  refine ContDiff.sum fun i _ ↦ ?_
  exact ((contDiff_mvEval _).comp contDiff_fst).mul (contDiff_snd.pow i)

/-- `Φ(z, t) = (z, P(z, t))`. -/
noncomputable def Phi (F : (Sn n)[X]) (p : (Fin n → ℂ) × ℂ) : (Fin n → ℂ) × ℂ := (p.1, Pf F p)

theorem contDiff_Phi (F : (Sn n)[X]) : ContDiff ℂ ⊤ (Phi F) :=
  contDiff_fst.prodMk (contDiff_Pf F)

/-- **La dérivée de `Φ` est inversible en une racine simple.** -/
theorem exists_hasFDerivAt_equiv (F : (Sn n)[X]) (p₀ : (Fin n → ℂ) × ℂ)
    (h : (derivative (specz F p₀.1)).eval p₀.2 ≠ 0) :
    ∃ f' : ((Fin n → ℂ) × ℂ) ≃L[ℂ] ((Fin n → ℂ) × ℂ),
      HasFDerivAt (Phi F) (f' : ((Fin n → ℂ) × ℂ) →L[ℂ] ((Fin n → ℂ) × ℂ)) p₀ := by
  set D := fderiv ℂ (Phi F) p₀
  have hD : HasFDerivAt (Phi F) D p₀ :=
    ((contDiff_Phi F).differentiable (by simp)).differentiableAt.hasFDerivAt
  have h1 : ∀ w, (D w).1 = w.1 := by
    have hfst : HasFDerivAt (fun p ↦ (Phi F p).1)
        ((ContinuousLinearMap.fst ℂ (Fin n → ℂ) ℂ).comp D) p₀ := hasFDerivAt_fst.comp p₀ hD
    have hfst' : HasFDerivAt (fun p : (Fin n → ℂ) × ℂ ↦ (Phi F p).1)
        (ContinuousLinearMap.fst ℂ (Fin n → ℂ) ℂ) p₀ := hasFDerivAt_fst
    intro w
    exact congrArg (fun L : ((Fin n → ℂ) × ℂ) →L[ℂ] (Fin n → ℂ) ↦ L w) (hfst.unique hfst')
  have h2 : (D (0, 1)).2 = (derivative (specz F p₀.1)).eval p₀.2 := by
    have hlin : HasDerivAt (fun t : ℂ ↦ ((p₀.1, t) : (Fin n → ℂ) × ℂ)) (0, 1) p₀.2 :=
      (hasDerivAt_const _ _).prodMk (hasDerivAt_id _)
    have hline : HasDerivAt (fun t : ℂ ↦ Phi F (p₀.1, t)) (D (0, 1)) p₀.2 := by
      exact hD.comp_hasDerivAt (x := p₀.2) (by simpa using hlin)
    have hsnd : HasDerivAt (fun t : ℂ ↦ (specz F p₀.1).eval t) (D (0, 1)).2 p₀.2 :=
      (hasFDerivAt_snd.comp_hasDerivAt p₀.2 hline :)
    exact hsnd.unique (Polynomial.hasDerivAt _ _)
  have hinj : Function.Injective D := by
    intro w w' hww
    have hw : D (w - w') = 0 := by rw [map_sub, hww, sub_self]
    set v := w - w' with hv
    have hv1 : v.1 = 0 := by rw [← h1 v, hw]; rfl
    have hvv : v = v.2 • ((0 : Fin n → ℂ), (1 : ℂ)) := Prod.ext (by simp [hv1]) (by simp)
    rw [hvv, map_smul] at hw
    have h3 := congrArg Prod.snd hw
    simp only [Prod.smul_snd, smul_eq_mul, Prod.snd_zero, h2, mul_eq_zero, h, or_false] at h3
    exact sub_eq_zero.mp (Prod.ext hv1 h3)
  let e : ((Fin n → ℂ) × ℂ) ≃ₗ[ℂ] ((Fin n → ℂ) × ℂ) :=
    LinearEquiv.ofInjectiveEndo D.toLinearMap hinj
  refine ⟨e.toContinuousLinearEquiv, ?_⟩
  convert hD using 1
  exact ContinuousLinearMap.ext fun w ↦ rfl

/-- **Racine locale** : près d'une racine simple `t₀` de `F(z₀, ·)`, une racine `τ(z)` de
`F(z, ·)`, ℂ-différentiable, et localement unique. -/
theorem exists_localRoot (F : (Sn n)[X]) (z₀ : Fin n → ℂ) (t₀ : ℂ)
    (h0 : (specz F z₀).IsRoot t₀) (hs : (derivative (specz F z₀)).eval t₀ ≠ 0) :
    ∃ (N : Set (Fin n → ℂ)) (W : Set ((Fin n → ℂ) × ℂ)) (τ : (Fin n → ℂ) → ℂ),
      IsOpen N ∧ z₀ ∈ N ∧ IsOpen W ∧ (z₀, t₀) ∈ W ∧ τ z₀ = t₀ ∧
      (∀ z ∈ N, DifferentiableAt ℂ τ z) ∧
      (∀ z ∈ N, (z, τ z) ∈ W ∧ (specz F z).IsRoot (τ z)) ∧
      (∀ p ∈ W, (specz F p.1).IsRoot p.2 → p.2 = τ p.1) := by
  set p₀ : (Fin n → ℂ) × ℂ := (z₀, t₀)
  obtain ⟨f', hf'⟩ := exists_hasFDerivAt_equiv F p₀ hs
  have hcd : ContDiffAt ℂ 1 (Phi F) p₀ := (contDiff_Phi F).contDiffAt.of_le (by simp)
  set H := hcd.toOpenPartialHomeomorph (Phi F) hf' one_ne_zero with hH
  have hHcoe : (H : _ → _) = Phi F := rfl
  have hp₀ : p₀ ∈ H.source := hcd.mem_toOpenPartialHomeomorph_source hf' one_ne_zero
  have hΦp₀ : Phi F p₀ = (z₀, 0) := by
    simp only [Phi, Pf, p₀]
    rw [h0.eq_zero]
  have hκ : ContDiffAt ℂ 1 H.symm (Phi F p₀) := hcd.to_localInverse hf' one_ne_zero
  obtain ⟨T, hTsub, hTopen, hTmem⟩ := eventually_nhds_iff.mp (hκ.eventually (by simp))
  set τ : (Fin n → ℂ) → ℂ := fun z ↦ (H.symm (z, 0)).2
  have hcont0 : Continuous fun z : Fin n → ℂ ↦ ((z, (0 : ℂ)) : (Fin n → ℂ) × ℂ) :=
    continuous_id.prodMk continuous_const
  set N := {z : Fin n → ℂ | (z, (0 : ℂ)) ∈ H.target ∩ T}
  have hNopen : IsOpen N := (H.open_target.inter hTopen).preimage hcont0
  have hz₀ : z₀ ∈ N := by
    refine ⟨?_, ?_⟩
    · rw [← hΦp₀, ← hHcoe]; exact H.map_source hp₀
    · rw [← hΦp₀]; exact hTmem
  -- `H.symm (z, 0) = (z, τ z)`
  have hsymm : ∀ z ∈ N, H.symm (z, 0) = (z, τ z) := fun z hz ↦ by
    have h := H.right_inv hz.1
    refine Prod.ext ?_ rfl
    have := congrArg Prod.fst h
    rw [hHcoe] at this
    exact this
  refine ⟨N, H.source, τ, hNopen, hz₀, H.open_source, hp₀, ?_, ?_, ?_, ?_⟩
  · simp only [τ]
    rw [← hΦp₀, ← hHcoe, H.left_inv hp₀]
  · intro z hz
    have hd : DifferentiableAt ℂ H.symm (z, 0) := (hTsub _ hz.2).differentiableAt one_ne_zero
    exact (hd.comp z (differentiableAt_id.prodMk (differentiableAt_const _))).snd
  · intro z hz
    have hmem : H.symm (z, 0) ∈ H.source := H.map_target hz.1
    refine ⟨by rw [← hsymm z hz]; exact hmem, ?_⟩
    have h := H.right_inv hz.1
    rw [hsymm z hz, hHcoe] at h
    have := congrArg Prod.snd h
    exact this
  · intro p hp hroot
    have hΦ : H p = (p.1, 0) := by
      rw [hHcoe]
      exact Prod.ext rfl hroot
    have := H.left_inv hp
    rw [hΦ] at this
    rw [show τ p.1 = (H.symm (p.1, 0)).2 from rfl, this]

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/Covering.lean` -/

section

/-!
# La projection est un revêtement au-dessus de `V = {c δ ≠ 0}` (A6)

* Pour `z ∈ V`, `F(z, ·)` est séparable : ses racines sont simples (`separable_specz`).
* `ptOf z (τ z)` dépend continûment de `z` le long d'une racine locale (`continuousOn_ptOf`).
* `proj` est un homéomorphisme local sur `proj⁻¹(V)` (`isLocalHomeomorphOn_proj`), donc un
  revêtement au-dessus de `V` (fermée, fibres finies : `isCoveringMapOn_proj`).
-/

open Polynomial Filter Topology

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

variable {n : ℕ} {A : Type} [CommRing A] [IsDomain A] [Algebra ℂ A] [Algebra (Sn n) A]
  [IsScalarTower ℂ (Sn n) A] [Module.Finite (Sn n) A] [Module.IsTorsionFree (Sn n) A]

/-- L'ouvert `V = {c δ ≠ 0}`. -/
def GoodElt.V (e : GoodElt n A) : Set (Fin n → ℂ) :=
  {z | MvPolynomial.eval z (e.c * e.δ) ≠ 0}

theorem GoodElt.isOpen_V (e : GoodElt n A) : IsOpen e.V :=
  isOpen_ne_fun (MvPolynomial.continuous_eval _) continuous_const

theorem GoodElt.c_ne (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    MvPolynomial.eval z e.c ≠ 0 := by
  have : MvPolynomial.eval z (e.c * e.δ) ≠ 0 := hz
  rw [map_mul] at this
  exact left_ne_zero_of_mul this

theorem GoodElt.δ_ne (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    MvPolynomial.eval z e.δ ≠ 0 := by
  have : MvPolynomial.eval z (e.c * e.δ) ≠ 0 := hz
  rw [map_mul] at this
  exact right_ne_zero_of_mul this

theorem separable_specz (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    (specz e.F z).Separable := by
  obtain ⟨a, b, hab⟩ := e.bezout
  have h := congrArg (Polynomial.map (MvPolynomial.eval z)) hab
  simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C] at h
  rw [← derivative_map] at h
  refine ⟨C (MvPolynomial.eval z e.δ)⁻¹ * a.map (MvPolynomial.eval z),
    C (MvPolynomial.eval z e.δ)⁻¹ * b.map (MvPolynomial.eval z), ?_⟩
  rw [specz, mul_assoc, mul_assoc, ← mul_add, h, ← C_mul, inv_mul_cancel₀ (e.δ_ne hz), C_1]

theorem derivative_ne_zero (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) {t : ℂ}
    (ht : (specz e.F z).IsRoot t) : (derivative (specz e.F z)).eval t ≠ 0 := by
  have := (separable_specz e hz).aeval_derivative_ne_zero (S := ℂ) (x := t) (by simpa using ht)
  simpa using this

/-! ### Continuité de `ptOf` le long d'une racine -/

theorem evAdj_aeval (e : GoodElt n A) (z : Fin n → ℂ) (t : ℂ) (ht : (specz e.F z).IsRoot t)
    (q : (Sn n)[X]) :
    evAdj e z t ht ⟨aeval e.u q, aeval_mem_adjoin_singleton _ _⟩ = (specz q z).eval t := by
  induction q using Polynomial.induction_on' with
  | add p q hp hq =>
    rw [show (⟨aeval e.u (p + q), aeval_mem_adjoin_singleton _ _⟩ :
        Algebra.adjoin (Sn n) {e.u}) = ⟨aeval e.u p, aeval_mem_adjoin_singleton _ _⟩ +
          ⟨aeval e.u q, aeval_mem_adjoin_singleton _ _⟩ from Subtype.ext (map_add _ _ _),
      map_add, hp, hq, specz, specz, specz, Polynomial.map_add, eval_add]
  | monomial k s =>
    rw [show (⟨aeval e.u (monomial k s), aeval_mem_adjoin_singleton _ _⟩ :
        Algebra.adjoin (Sn n) {e.u}) = algebraMap (Sn n) _ s *
          (⟨e.u, Algebra.self_mem_adjoin_singleton _ _⟩) ^ k from
      Subtype.ext (by simp [aeval_monomial]),
      map_mul, map_pow, evAdj_algebraMap, evAdj_gen, specz, Polynomial.map_monomial,
      eval_monomial]

/-- Représentation `c · a = q_a(u)`. -/
theorem exists_aeval_eq_cA (e : GoodElt n A) (a : A) :
    ∃ q : (Sn n)[X], aeval e.u q = e.c • a := by
  have h := e.conductor a
  rw [Algebra.adjoin_singleton_eq_range_aeval] at h
  exact h

theorem ptOf_apply_eq (e : GoodElt n A) (z : Fin n → ℂ) (t : ℂ) (ht : (specz e.F z).IsRoot t)
    (hc : MvPolynomial.eval z e.c ≠ 0) (a : A) (q : (Sn n)[X]) (hq : aeval e.u q = e.c • a) :
    ptOf e z t ht hc a = Pf q (z, t) / MvPolynomial.eval z e.c := by
  rw [ptOf_apply, show cA e a = ⟨aeval e.u q, aeval_mem_adjoin_singleton _ _⟩ from
    Subtype.ext hq.symm, evAdj_aeval]
  rfl

theorem ptOf_congr (e : GoodElt n A) {z z' : Fin n → ℂ} {t t' : ℂ} (hz : z = z') (ht : t = t')
    (h : (specz e.F z).IsRoot t) (h' : (specz e.F z').IsRoot t')
    (hc : MvPolynomial.eval z e.c ≠ 0) (hc' : MvPolynomial.eval z' e.c ≠ 0) :
    ptOf e z t h hc = ptOf e z' t' h' hc' := by
  subst hz ht
  rfl

theorem continuousOn_pts_iff {Y : Type*} [TopologicalSpace Y] (f : Y → Pts A) (s : Set Y) :
    ContinuousOn f s ↔ ∀ a, ContinuousOn (fun y ↦ f y a) s := by
  constructor
  · intro h a
    exact (continuous_apply_pts a).comp_continuousOn h
  · intro h x hx
    exact (tendsto_pts_iff _ _).mpr fun a ↦ h a x hx

/-! ### Homéomorphisme local et revêtement -/

/-- **`proj` est un homéomorphisme local au-dessus de `V`.** -/
theorem isLocalHomeomorphOn_proj (e : GoodElt n A) :
    IsLocalHomeomorphOn (proj (n := n) (A := A)) (proj ⁻¹' e.V) := by
  classical
  intro φ₀ hφ₀
  have hroot0 := isRoot_apply_u e φ₀
  obtain ⟨N, W, τ, hN, hz₀N, hW, hW₀, hτ₀, hτd, hτW, hτu⟩ :=
    exists_localRoot e.F (proj φ₀) (φ₀ e.u) hroot0 (derivative_ne_zero e hφ₀ hroot0)
  set N' := N ∩ e.V with hN'def
  have hN' : IsOpen N' := hN.inter e.isOpen_V
  let inv : (Fin n → ℂ) → Pts A := fun z ↦
    if h : z ∈ N' then ptOf e z (τ z) (hτW z h.1).2 (e.c_ne h.2) else φ₀
  have hinv : ∀ z (h : z ∈ N'), inv z = ptOf e z (τ z) (hτW z h.1).2 (e.c_ne h.2) :=
    fun z h ↦ dif_pos h
  have hcontW : Continuous fun φ : Pts A ↦ (proj (n := n) φ, φ e.u) :=
    continuous_proj.prodMk (continuous_apply_pts _)
  have hτc : ContinuousOn τ N' := fun z hz ↦ (hτd z hz.1).continuousAt.continuousWithinAt
  refine ⟨{ toFun := proj
            invFun := inv
            source := {φ | proj (n := n) φ ∈ N' ∧ (proj φ, φ e.u) ∈ W}
            target := N'
            map_source' := fun φ hφ ↦ hφ.1
            map_target' := fun z hz ↦ by
              rw [hinv z hz]
              refine ⟨by rw [proj_ptOf]; exact hz, ?_⟩
              rw [proj_ptOf, ptOf_u]
              exact (hτW z hz.1).1
            left_inv' := fun φ hφ ↦ by
              rw [hinv _ hφ.1]
              have ht : φ e.u = τ (proj φ) := hτu _ hφ.2 (isRoot_apply_u e φ)
              exact (ptOf_congr e rfl ht.symm _ _ _ _).trans (eq_ptOf e φ (e.c_ne hφ.1.2)).symm
            right_inv' := fun z hz ↦ by rw [hinv z hz]; exact proj_ptOf _ _ _ _ _
            open_source := (hN'.preimage continuous_proj).inter (hW.preimage hcontW)
            open_target := hN'
            continuousOn_toFun := continuous_proj.continuousOn
            continuousOn_invFun := ?_ }, ⟨⟨hz₀N, hφ₀⟩, hW₀⟩, rfl⟩
  · refine (continuousOn_pts_iff _ _).mpr fun a ↦ ?_
    obtain ⟨q, hq⟩ := exists_aeval_eq_cA e a
    have hg : ContinuousOn (fun z ↦ Pf q (z, τ z) / MvPolynomial.eval z e.c) N' := by
      refine ContinuousOn.div ?_ (MvPolynomial.continuous_eval _).continuousOn
        fun z hz ↦ e.c_ne hz.2
      exact (contDiff_Pf q).continuous.comp_continuousOn (continuousOn_id.prodMk hτc)
    refine hg.congr fun z hz ↦ ?_
    simp only
    rw [hinv z hz, ptOf_apply_eq e _ _ _ _ a q hq]

/-- **`proj` est un revêtement au-dessus de `V`.** -/
theorem isCoveringMapOn_proj (e : GoodElt n A) : IsCoveringMapOn (proj (n := n) (A := A)) e.V :=
  isClosedMap_proj.isCoveringMapOn_of_isLocalHomeomorphOn (fun z _ ↦ finite_fiber z)
    (isLocalHomeomorphOn_proj e)

/-- **Section locale** du revêtement par un point `φ₀` au-dessus de `V`, avec `z ↦ σ(z)(u)`
holomorphe. -/
theorem exists_localSection (e : GoodElt n A) (φ₀ : Pts A) (hφ₀ : proj φ₀ ∈ e.V) :
    ∃ (N : Set (Fin n → ℂ)) (σ : (Fin n → ℂ) → Pts A), IsOpen N ∧ proj φ₀ ∈ N ∧ N ⊆ e.V ∧
      σ (proj φ₀) = φ₀ ∧ ContinuousOn σ N ∧ (∀ z ∈ N, proj (σ z) = z) ∧
      (∀ z ∈ N, DifferentiableAt ℂ (fun z ↦ σ z e.u) z) := by
  classical
  have hroot0 := isRoot_apply_u e φ₀
  obtain ⟨N, W, τ, hN, hz₀N, hW, hW₀, hτ₀, hτd, hτW, hτu⟩ :=
    exists_localRoot e.F (proj φ₀) (φ₀ e.u) hroot0 (derivative_ne_zero e hφ₀ hroot0)
  set N' := N ∩ e.V with hN'def
  have hN' : IsOpen N' := hN.inter e.isOpen_V
  let σ : (Fin n → ℂ) → Pts A := fun z ↦
    if h : z ∈ N' then ptOf e z (τ z) (hτW z h.1).2 (e.c_ne h.2) else φ₀
  have hσ : ∀ z (h : z ∈ N'), σ z = ptOf e z (τ z) (hτW z h.1).2 (e.c_ne h.2) :=
    fun z h ↦ dif_pos h
  have hτc : ContinuousOn τ N' := fun z hz ↦ (hτd z hz.1).continuousAt.continuousWithinAt
  have hσu : ∀ z ∈ N', σ z e.u = τ z := fun z hz ↦ by rw [hσ z hz, ptOf_u]
  refine ⟨N', σ, hN', ⟨hz₀N, hφ₀⟩, Set.inter_subset_right, ?_, ?_, ?_, ?_⟩
  · rw [hσ _ ⟨hz₀N, hφ₀⟩]
    exact (ptOf_congr e rfl hτ₀ _ _ _ _).trans (eq_ptOf e φ₀ (e.c_ne hφ₀)).symm
  · refine (continuousOn_pts_iff _ _).mpr fun a ↦ ?_
    obtain ⟨q, hq⟩ := exists_aeval_eq_cA e a
    have hg : ContinuousOn (fun z ↦ Pf q (z, τ z) / MvPolynomial.eval z e.c) N' := by
      refine ContinuousOn.div ?_ (MvPolynomial.continuous_eval _).continuousOn
        fun z hz ↦ e.c_ne hz.2
      exact (contDiff_Pf q).continuous.comp_continuousOn (continuousOn_id.prodMk hτc)
    refine hg.congr fun z hz ↦ ?_
    simp only
    rw [hσ z hz, ptOf_apply_eq e _ _ _ _ a q hq]
  · intro z hz
    rw [hσ z hz]
    exact proj_ptOf _ _ _ _ _
  · intro z hz
    refine (hτd z hz.1).congr_of_eventuallyEq ?_
    filter_upwards [hN'.mem_nhds hz] with y hy
    exact hσu y hy

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/Fiber.lean` -/

section

/-!
# Fibres au-dessus de `V` (A6)

Pour `z ∈ V`, la fibre `fib z` a `d = deg F` éléments, en bijection par `φ ↦ φ(u)` avec les
racines de `F(z, ·)`, et `∏_{φ ∈ fib z} (X - φ(u)) = F(z, ·)`.
-/

open Polynomial Filter Topology

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

variable {n : ℕ} {A : Type} [CommRing A] [IsDomain A] [Algebra ℂ A] [Algebra (Sn n) A]
  [IsScalarTower ℂ (Sn n) A] [Module.Finite (Sn n) A] [Module.IsTorsionFree (Sn n) A]

/-- La fibre au-dessus de `z`, comme ensemble fini. -/
noncomputable def fib (z : Fin n → ℂ) : Finset (Pts A) := (finite_fiber (A := A) z).toFinset

theorem mem_fib {z : Fin n → ℂ} {φ : Pts A} : φ ∈ fib z ↔ proj φ = z :=
  Set.Finite.mem_toFinset _

/-- Les racines de `F(z, ·)`. -/
noncomputable def rootsF (e : GoodElt n A) (z : Fin n → ℂ) : Finset ℂ :=
  (specz e.F z).roots.toFinset

theorem mem_rootsF (e : GoodElt n A) {z : Fin n → ℂ} {t : ℂ} :
    t ∈ rootsF e z ↔ (specz e.F z).IsRoot t := by
  rw [rootsF, Multiset.mem_toFinset, mem_roots (specz_monic e z).ne_zero]

theorem image_fib (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    (fib z).image (fun φ : Pts A ↦ φ e.u) = rootsF e z := by
  ext t
  simp only [Finset.mem_image, mem_fib, mem_rootsF]
  constructor
  · rintro ⟨φ, hφ, rfl⟩
    rw [← hφ]
    exact isRoot_apply_u e φ
  · intro ht
    exact ⟨ptOf e z t ht (e.c_ne hz), proj_ptOf _ _ _ _ _, ptOf_u _ _ _ _ _⟩

theorem injOn_fib (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    Set.InjOn (fun φ : Pts A ↦ φ e.u) (fib (A := A) z : Set (Pts A)) := by
  intro φ hφ ψ hψ h
  have hφ' : proj φ = z := mem_fib.mp hφ
  have hψ' : proj ψ = z := mem_fib.mp hψ
  rw [eq_ptOf e φ (by rw [hφ']; exact e.c_ne hz), eq_ptOf e ψ (by rw [hψ']; exact e.c_ne hz)]
  exact ptOf_congr e (hφ'.trans hψ'.symm) h _ _ _ _

theorem nodup_roots_specz (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    (specz e.F z).roots.Nodup :=
  nodup_roots (separable_specz e hz)

theorem card_rootsF (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    (rootsF e z).card = e.F.natDegree := by
  rw [rootsF, Multiset.toFinset_card_of_nodup (nodup_roots_specz e hz),
    IsAlgClosed.card_roots_eq_natDegree, natDegree_specz]

theorem card_fib (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    (fib (A := A) z).card = e.F.natDegree := by
  rw [← card_rootsF e hz, ← image_fib e hz, Finset.card_image_of_injOn (injOn_fib e hz)]

theorem prod_rootsF (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    ∏ t ∈ rootsF e z, (X - C t) = specz e.F z := by
  rw [Finset.prod_eq_multiset_prod, rootsF, Multiset.toFinset_val,
    (nodup_roots_specz e hz).dedup]
  exact ((IsAlgClosed.splits _).eq_prod_roots_of_monic (specz_monic e z)).symm

/-- **Produit sur la fibre.** -/
theorem prod_fib (e : GoodElt n A) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    ∏ φ ∈ fib (A := A) z, (X - C (φ e.u)) = specz e.F z := by
  rw [← prod_rootsF e hz, ← image_fib e hz, Finset.prod_image (injOn_fib e hz)]

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/PolyBounds.lean` -/

section

/-!
# Bornes et régularité des coefficients (A6)

* `norm_coeff_prod_X_sub_C_le` : les coefficients de `∏ (X - tᵢ)` sont bornés par `(1 + R)ᵏ`
  si `‖tᵢ‖ ≤ R`.
* `norm_eval_le` : `‖Q(z)‖ ≤ K_Q (1 + ‖z‖)^{deg Q}` pour un polynôme en `n` variables.
* `differentiableAt_coeff_prod` : les coefficients de `∏ (X - fᵢ(z))` sont ℂ-différentiables
  si les `fᵢ` le sont.
-/

open Polynomial

namespace FiniteFields.Betti.Connected

theorem norm_coeff_mul_X_sub_C_le {P : ℂ[X]} {B : ℝ} (hB : ∀ k, ‖P.coeff k‖ ≤ B) (t : ℂ) (k : ℕ) :
    ‖(P * (X - C t)).coeff k‖ ≤ B * (1 + ‖t‖) := by
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0)
  cases k with
  | zero =>
    rw [mul_coeff_zero, coeff_sub, coeff_X_zero, coeff_C_zero, zero_sub, mul_neg, norm_neg,
      norm_mul]
    nlinarith [hB 0, norm_nonneg t, norm_nonneg (P.coeff 0)]
  | succ k =>
    rw [coeff_mul_X_sub_C]
    calc ‖P.coeff k - P.coeff (k + 1) * t‖ ≤ ‖P.coeff k‖ + ‖P.coeff (k + 1)‖ * ‖t‖ := by
          rw [← norm_mul]; exact norm_sub_le _ _
      _ ≤ B + B * ‖t‖ := by gcongr <;> exact hB _
      _ = B * (1 + ‖t‖) := by ring

theorem norm_coeff_prod_X_sub_C_le {ι : Type*} (s : Finset ι) (f : ι → ℂ) {R : ℝ} (hR0 : 0 ≤ R)
    (hR : ∀ i ∈ s, ‖f i‖ ≤ R) (k : ℕ) :
    ‖(∏ i ∈ s, (X - C (f i))).coeff k‖ ≤ (1 + R) ^ s.card := by
  classical
  induction s using Finset.induction_on generalizing k with
  | empty =>
    simp only [Finset.prod_empty, Finset.card_empty, pow_zero, coeff_one]
    split_ifs <;> simp
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.card_insert_of_notMem ha, mul_comm, pow_succ]
    have ih' : ∀ k, ‖(∏ i ∈ s, (X - C (f i))).coeff k‖ ≤ (1 + R) ^ s.card := fun k ↦
      ih (fun i hi ↦ hR i (Finset.mem_insert_of_mem hi)) k
    refine (norm_coeff_mul_X_sub_C_le ih' (f a) k).trans ?_
    gcongr
    exact hR a (Finset.mem_insert_self a s)

/-- Somme des normes des coefficients. -/
noncomputable def coeffSum {n : ℕ} (Q : MvPolynomial (Fin n) ℂ) : ℝ :=
  ∑ m ∈ Q.support, ‖Q.coeff m‖

theorem norm_eval_le {n : ℕ} (Q : MvPolynomial (Fin n) ℂ) (z : Fin n → ℂ) :
    ‖MvPolynomial.eval z Q‖ ≤ coeffSum Q * (1 + ‖z‖) ^ Q.totalDegree := by
  rw [MvPolynomial.eval_eq', coeffSum, Finset.sum_mul]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m hm ↦ ?_)
  rw [norm_mul, norm_prod]
  gcongr
  have h1 : (1 : ℝ) ≤ 1 + ‖z‖ := by linarith [norm_nonneg z]
  calc ∏ i, ‖z i ^ m i‖ ≤ ∏ i, (1 + ‖z‖) ^ m i := by
        refine Finset.prod_le_prod (fun _ _ ↦ norm_nonneg _) fun i _ ↦ ?_
        rw [norm_pow]
        gcongr
        linarith [norm_le_pi_norm z i]
    _ = (1 + ‖z‖) ^ (∑ i, m i) := Finset.prod_pow_eq_pow_sum _ _ _
    _ ≤ (1 + ‖z‖) ^ Q.totalDegree := by
        refine pow_le_pow_right₀ h1 ?_
        have := MvPolynomial.le_totalDegree hm
        rwa [Finsupp.sum_fintype _ _ (fun _ ↦ rfl)] at this

theorem differentiableAt_coeff_X_sub_C {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {f : E → ℂ} {z₀ : E} (hf : DifferentiableAt ℂ f z₀) (i : ℕ) :
    DifferentiableAt ℂ (fun z ↦ (X - C (f z)).coeff i) z₀ := by
  simp only [coeff_sub, coeff_X, coeff_C]
  split_ifs <;> fun_prop

theorem differentiableAt_coeff_prod {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {ι : Type*} (s : Finset ι) (f : ι → E → ℂ) {z₀ : E}
    (hf : ∀ i ∈ s, DifferentiableAt ℂ (f i) z₀) (k : ℕ) :
    DifferentiableAt ℂ (fun z ↦ (∏ i ∈ s, (X - C (f i z))).coeff k) z₀ := by
  classical
  induction s using Finset.induction_on generalizing k with
  | empty =>
    simp only [Finset.prod_empty, coeff_one]
    exact differentiableAt_const _
  | insert a s ha ih =>
    simp only [Finset.prod_insert ha, coeff_mul]
    refine DifferentiableAt.fun_sum fun p _ ↦ ?_
    exact (differentiableAt_coeff_X_sub_C (hf a (Finset.mem_insert_self a s)) p.1).mul
      (ih (fun i hi ↦ hf i (Finset.mem_insert_of_mem hi)) p.2)

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/Entire.lean` -/

section

/-!
# Fonctions entières à croissance polynomiale (A6)

* `exists_poly_of_growth` : une fonction entière `f` avec `‖f s‖ ≤ C (1 + ‖s‖)ᴺ` est un polynôme
  de degré `≤ N` (Liouville, puis récurrence sur `N` par la pente `dslope f 0`).
* `exists_poly_of_growth_off_finite` : même conclusion pour `f` holomorphe hors d'un ensemble
  fini `Z`, avec la borne hors de `Z` (singularités effaçables, la borne donnant la
  bornitude locale).
-/

open Filter Topology Metric Polynomial

namespace FiniteFields.Betti.Connected

theorem exists_poly_of_growth (N : ℕ) : ∀ (f : ℂ → ℂ), Differentiable ℂ f → ∀ C : ℝ,
    (∀ s, ‖f s‖ ≤ C * (1 + ‖s‖) ^ N) → ∃ P : ℂ[X], P.natDegree ≤ N ∧ ∀ s, f s = P.eval s := by
  induction N with
  | zero =>
    intro f hf C hC
    have hb : Bornology.IsBounded (Set.range f) := by
      refine isBounded_iff_forall_norm_le.mpr ⟨C, ?_⟩
      rintro _ ⟨s, rfl⟩
      simpa using hC s
    obtain ⟨c, hc⟩ := hf.exists_const_forall_eq_of_bounded hb
    exact ⟨Polynomial.C c, by simp, fun s ↦ by simp [hc s]⟩
  | succ N ih =>
    intro f hf C hC
    set g := dslope f 0 with hgdef
    have hg : Differentiable ℂ g := by
      rw [← differentiableOn_univ]
      exact (Complex.differentiableOn_dslope Filter.univ_mem).mpr hf.differentiableOn
    have hfg : ∀ s, f s = f 0 + s * g s := fun s ↦ by
      have := sub_smul_dslope f 0 s
      simp only [sub_zero, smul_eq_mul] at this
      rw [this]
      ring
    -- borne sur la boule unité, par compacité
    obtain ⟨M, hM⟩ : ∃ M, ∀ s ∈ closedBall (0 : ℂ) 1, ‖g s‖ ≤ M :=
      (isCompact_closedBall (0 : ℂ) 1).exists_bound_of_continuousOn hg.continuous.continuousOn
    have hbound : ∀ s, ‖g s‖ ≤ (max M 0 + 2 * |C| + 2 * ‖f 0‖) * (1 + ‖s‖) ^ N := by
      intro s
      have h1 : (1 : ℝ) ≤ (1 + ‖s‖) ^ N := one_le_pow₀ (by linarith [norm_nonneg s])
      by_cases hs : ‖s‖ ≤ 1
      · have := hM s (by simpa using hs)
        have h2 : 0 ≤ 2 * |C| + 2 * ‖f 0‖ := by positivity
        nlinarith [le_max_left M 0, le_max_right M 0]
      · rw [not_le] at hs
        have hs0 : 0 < ‖s‖ := by linarith
        have hgs : ‖g s‖ * ‖s‖ ≤ |C| * (1 + ‖s‖) ^ (N + 1) + ‖f 0‖ := by
          have : s * g s = f s - f 0 := by rw [hfg s]; ring
          rw [mul_comm, ← norm_mul, this]
          calc ‖f s - f 0‖ ≤ ‖f s‖ + ‖f 0‖ := norm_sub_le _ _
            _ ≤ |C| * (1 + ‖s‖) ^ (N + 1) + ‖f 0‖ := by
              gcongr
              exact (hC s).trans (mul_le_mul_of_nonneg_right (le_abs_self C) (by positivity))
        -- `1 + ‖s‖ ≤ 2 ‖s‖`
        have hle : (1 + ‖s‖) ≤ 2 * ‖s‖ := by linarith
        have key : ‖g s‖ * (1 + ‖s‖) ≤ (2 * |C| + 2 * ‖f 0‖) * (1 + ‖s‖) ^ (N + 1) := by
          have hpow : (1 : ℝ) ≤ (1 + ‖s‖) ^ (N + 1) := one_le_pow₀ (by linarith)
          nlinarith [norm_nonneg (g s), abs_nonneg C, norm_nonneg (f 0)]
        have hpos : 0 < 1 + ‖s‖ := by linarith
        rw [pow_succ] at key
        have : ‖g s‖ ≤ (2 * |C| + 2 * ‖f 0‖) * (1 + ‖s‖) ^ N := by
          have h3 : ‖g s‖ * (1 + ‖s‖) ≤ ((2 * |C| + 2 * ‖f 0‖) * (1 + ‖s‖) ^ N) * (1 + ‖s‖) := by
            linarith [key]
          exact le_of_mul_le_mul_right h3 hpos
        nlinarith [le_max_right M 0]
    obtain ⟨Q, hQd, hQ⟩ := ih g hg (max M 0 + 2 * |C| + 2 * ‖f 0‖) hbound
    refine ⟨Polynomial.C (f 0) + X * Q, ?_, fun s ↦ by rw [hfg s, hQ s]; simp⟩
    refine (natDegree_add_le _ _).trans (max_le (by simp) ?_)
    refine natDegree_mul_le.trans ?_
    have := natDegree_X_le (R := ℂ)
    omega

/-- Un point d'un ensemble fini en est isolé. -/
theorem exists_ball_inter_finset (Z : Finset ℂ) (c : ℂ) :
    ∃ ε > 0, ∀ s ∈ ball c ε, s ∈ Z → s = c := by
  have hcl : IsClosed ((Z.erase c : Finset ℂ) : Set ℂ) := (Z.erase c).finite_toSet.isClosed
  have hc : c ∈ (((Z.erase c : Finset ℂ) : Set ℂ))ᶜ := by simp
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hcl.isOpen_compl c hc
  refine ⟨ε, hε, fun s hs hsZ ↦ by_contra fun hne ↦ ?_⟩
  exact hball hs (by simp [hne, hsZ])

theorem eventually_notMem_finset (Z : Finset ℂ) (c : ℂ) : ∀ᶠ s in 𝓝[≠] c, s ∉ Z := by
  obtain ⟨ε, hε, h⟩ := exists_ball_inter_finset Z c
  filter_upwards [inter_mem_nhdsWithin {c}ᶜ (ball_mem_nhds c hε)] with s hs
  exact fun hsZ ↦ hs.1 (h s hs.2 hsZ)

/-- **Croissance polynomiale hors d'un ensemble fini.** -/
theorem exists_poly_of_growth_off_finite (Z : Finset ℂ) (f : ℂ → ℂ)
    (hf : ∀ s ∉ Z, DifferentiableAt ℂ f s) (N : ℕ) (C : ℝ)
    (hC : ∀ s ∉ Z, ‖f s‖ ≤ C * (1 + ‖s‖) ^ N) :
    ∃ P : ℂ[X], P.natDegree ≤ N ∧ ∀ s ∉ Z, f s = P.eval s := by
  classical
  let g : ℂ → ℂ := fun s ↦ if s ∈ Z then limUnder (𝓝[≠] s) f else f s
  have hgf : ∀ s ∉ Z, g =ᶠ[𝓝 s] f := fun s hs ↦ by
    have : ((Z : Set ℂ))ᶜ ∈ 𝓝 s := Z.finite_toSet.isClosed.isOpen_compl.mem_nhds (by simpa using hs)
    filter_upwards [this] with t ht
    simp [g, show t ∉ Z by simpa using ht]
  -- différentiabilité aux points de `Z`
  have hdiffZ : ∀ c ∈ Z, DifferentiableAt ℂ g c := fun c hc ↦ by
    obtain ⟨ε, hε, hZ⟩ := exists_ball_inter_finset Z c
    have hU : ball c ε ∈ 𝓝 c := ball_mem_nhds c hε
    have hd : DifferentiableOn ℂ f (ball c ε \ {c}) := fun s hs ↦
      (hf s fun hsZ ↦ hs.2 (hZ s hs.1 hsZ)).differentiableWithinAt
    have hb : BddAbove (norm ∘ f '' (ball c ε \ {c})) := by
      refine ⟨|C| * (1 + (‖c‖ + ε)) ^ N, ?_⟩
      rintro _ ⟨s, hs, rfl⟩
      have hsZ : s ∉ Z := fun hsZ ↦ hs.2 (hZ s hs.1 hsZ)
      have hsn : ‖s‖ ≤ ‖c‖ + ε := by
        have := mem_ball_iff_norm.mp hs.1
        linarith [norm_le_insert' s c]
      calc ‖f s‖ ≤ C * (1 + ‖s‖) ^ N := hC s hsZ
        _ ≤ |C| * (1 + ‖s‖) ^ N := mul_le_mul_of_nonneg_right (le_abs_self C) (by positivity)
        _ ≤ |C| * (1 + (‖c‖ + ε)) ^ N := by gcongr
    have H := Complex.differentiableOn_update_limUnder_of_bddAbove hU hd hb
    refine (H.differentiableAt hU).congr_of_eventuallyEq ?_
    filter_upwards [hU] with s hs
    by_cases hsc : s = c
    · subst hsc; simp [g, hc]
    · have hsZ : s ∉ Z := fun hsZ ↦ hsc (hZ s hs hsZ)
      simp [g, hsZ, Function.update_of_ne hsc]
  have hdiff : Differentiable ℂ g := fun s ↦ by
    by_cases hs : s ∈ Z
    · exact hdiffZ s hs
    · exact (hf s hs).congr_of_eventuallyEq (hgf s hs)
  have hgrowth : ∀ s, ‖g s‖ ≤ C * (1 + ‖s‖) ^ N := fun s ↦ by
    by_cases hs : s ∈ Z
    · have hcont : Tendsto g (𝓝[≠] s) (𝓝 (g s)) :=
        (hdiff s).continuousAt.tendsto.mono_left nhdsWithin_le_nhds
      refine le_of_tendsto_of_tendsto hcont.norm
        (((show Continuous fun t : ℂ ↦ C * (1 + ‖t‖) ^ N by fun_prop).tendsto s).mono_left
          nhdsWithin_le_nhds) ?_
      filter_upwards [eventually_notMem_finset Z s] with t ht
      simpa [g, ht] using hC t ht
    · simpa [g, hs] using hC s hs
  obtain ⟨P, hPd, hP⟩ := exists_poly_of_growth N g hdiff C hgrowth
  exact ⟨P, hPd, fun s hs ↦ by rw [← hP s]; simp [g, hs]⟩

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/Lines.lean` -/

section

/-!
# Polynômes le long des droites complexes (A6)

* `lineP Q a v` : le polynôme `t ↦ Q(a + t v)` en une variable.
* `isPathConnected_setOf_eval_ne` : le complémentaire `{D ≠ 0}` d'une hypersurface de `ℂⁿ` est
  connexe par arcs (une droite le rencontre hors d'un ensemble fini).
* `exists_mvPoly_of_lines` : une fonction définie sur `{D ≠ 0}`, polynomiale de degré `≤ N`
  le long de chaque droite, est la restriction d'un polynôme (récurrence sur `n`, interpolation
  de Lagrange en la première variable).
-/

open Polynomial

namespace FiniteFields.Betti.Connected

variable {n : ℕ}

/-- Le polynôme `t ↦ Q(a + t v)`. -/
noncomputable def lineP (Q : MvPolynomial (Fin n) ℂ) (a v : Fin n → ℂ) : ℂ[X] :=
  MvPolynomial.aeval (fun i ↦ C (a i) + C (v i) * X) Q

theorem eval_lineP (Q : MvPolynomial (Fin n) ℂ) (a v : Fin n → ℂ) (t : ℂ) :
    (lineP Q a v).eval t = MvPolynomial.eval (a + t • v) Q := by
  induction Q using MvPolynomial.induction_on with
  | C r => simp [lineP]
  | add p q hp hq =>
    simp only [lineP, map_add, eval_add] at hp hq ⊢
    rw [hp, hq]
  | mul_X p i hp =>
    simp only [lineP, map_mul, eval_mul] at hp ⊢
    rw [hp]
    simp only [MvPolynomial.aeval_X, MvPolynomial.eval_X, eval_add,
      eval_C, eval_mul, eval_X, Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    ring

theorem exists_eval_ne_zero {D : MvPolynomial (Fin n) ℂ} (hD : D ≠ 0) :
    ∃ z, MvPolynomial.eval z D ≠ 0 := by
  by_contra h
  push Not at h
  exact hD (MvPolynomial.funext fun z ↦ by simp [h z])

theorem lineP_ne_zero {D : MvPolynomial (Fin n) ℂ} {a v : Fin n → ℂ} {t : ℂ}
    (h : MvPolynomial.eval (a + t • v) D ≠ 0) : lineP D a v ≠ 0 := fun h0 ↦ by
  rw [← eval_lineP, h0, eval_zero] at h
  exact h rfl

theorem finite_setOf_eval_lineP_eq_zero {D : MvPolynomial (Fin n) ℂ} {a v : Fin n → ℂ} {t : ℂ}
    (h : MvPolynomial.eval (a + t • v) D ≠ 0) :
    {s : ℂ | MvPolynomial.eval (a + s • v) D = 0}.Finite := by
  have := Polynomial.finite_setOfPred_isRoot (lineP_ne_zero h)
  simpa [Polynomial.IsRoot, eval_lineP] using this

/-- **Le complémentaire d'une hypersurface est connexe par arcs.** -/
theorem isPathConnected_setOf_eval_ne {D : MvPolynomial (Fin n) ℂ} (hD : D ≠ 0) :
    IsPathConnected {z : Fin n → ℂ | MvPolynomial.eval z D ≠ 0} := by
  obtain ⟨z₀, hz₀⟩ := exists_eval_ne_zero hD
  refine ⟨z₀, hz₀, fun {b} hb ↦ ?_⟩
  set v := b - z₀
  let γ : ℂ → (Fin n → ℂ) := fun t ↦ z₀ + t • v
  have hγ : Continuous γ := by fun_prop
  have hfin := finite_setOf_eval_lineP_eq_zero (a := z₀) (v := v) (t := 0) (by simpa using hz₀)
  have hpc : IsPathConnected {s : ℂ | MvPolynomial.eval (z₀ + s • v) D = 0}ᶜ := by
    refine hfin.countable.isPathConnected_compl_of_one_lt_rank ?_
    rw [Complex.rank_real_complex]
    norm_num
  have himg := hpc.image hγ
  have h0 : γ 0 ∈ γ '' {s : ℂ | MvPolynomial.eval (z₀ + s • v) D = 0}ᶜ :=
    ⟨0, by simpa using hz₀, rfl⟩
  have h1 : γ 1 ∈ γ '' {s : ℂ | MvPolynomial.eval (z₀ + s • v) D = 0}ᶜ :=
    ⟨1, by simpa [v] using hb, rfl⟩
  have hj := himg.joinedIn _ h0 _ h1
  have e0 : γ 0 = z₀ := by simp [γ]
  have e1 : γ 1 = b := by simp [γ, v]
  rw [e0, e1] at hj
  refine hj.mono ?_
  rintro _ ⟨s, hs, rfl⟩
  exact hs

/-! ### Polynomiale sur les droites ⇒ polynomiale -/

theorem eval_cons_eq (D : MvPolynomial (Fin (n + 1)) ℂ) (s : ℂ) (z : Fin n → ℂ) :
    MvPolynomial.eval (Fin.cons s z) D =
      MvPolynomial.eval z (Polynomial.eval (MvPolynomial.C s) (MvPolynomial.finSuccEquiv ℂ n D)) := by
  rw [MvPolynomial.eval_eq_eval_mv_eval', Polynomial.eval_map]
  change _ = MvPolynomial.eval z (Polynomial.eval₂ (RingHom.id _) (MvPolynomial.C s) _)
  rw [Polynomial.hom_eval₂]
  simp

theorem cons_add_smul (α : ℂ) (a v : Fin n → ℂ) (t : ℂ) :
    (Fin.cons α a : Fin (n + 1) → ℂ) + t • Fin.cons 0 v = Fin.cons α (a + t • v) := by
  funext i
  refine Fin.cases ?_ (fun j ↦ ?_) i <;> simp

theorem cons_add_smul' (α : ℂ) (z : Fin n → ℂ) (t : ℂ) :
    (Fin.cons α z : Fin (n + 1) → ℂ) + t • Fin.cons 1 0 = Fin.cons (α + t) z := by
  funext i
  refine Fin.cases ?_ (fun j ↦ ?_) i <;> simp

theorem eval_aeval_X_zero (p : ℂ[X]) (x : Fin (n + 1) → ℂ) :
    MvPolynomial.eval x (Polynomial.aeval (MvPolynomial.X 0) p) = p.eval (x 0) := by
  rw [Polynomial.aeval_def, Polynomial.hom_eval₂, MvPolynomial.eval_X]
  change eval₂ _ _ p = eval₂ (RingHom.id ℂ) _ p
  congr 1
  ext r
  simp

/-- **Une fonction polynomiale le long des droites est polynomiale.** -/
theorem exists_mvPoly_of_lines : ∀ (n : ℕ) (D : MvPolynomial (Fin n) ℂ), D ≠ 0 →
    ∀ (N : ℕ) (g : (Fin n → ℂ) → ℂ),
    (∀ a v, MvPolynomial.eval a D ≠ 0 → ∃ P : ℂ[X], P.natDegree ≤ N ∧
      ∀ t : ℂ, MvPolynomial.eval (a + t • v) D ≠ 0 → g (a + t • v) = P.eval t) →
    ∃ Q : MvPolynomial (Fin n) ℂ, ∀ z, MvPolynomial.eval z D ≠ 0 → g z = MvPolynomial.eval z Q := by
  intro n
  induction n with
  | zero =>
    intro D _ N g _
    refine ⟨MvPolynomial.C (g 0), fun z _ ↦ ?_⟩
    rw [MvPolynomial.eval_C, Subsingleton.elim z 0]
  | succ n ih =>
    classical
    intro D hD N g hg
    set D' := MvPolynomial.finSuccEquiv ℂ n D with hD'
    have hD'0 : D' ≠ 0 := by
      rw [hD']; exact (map_ne_zero_iff _ (MvPolynomial.finSuccEquiv ℂ n).injective).mpr hD
    let Dα : ℂ → MvPolynomial (Fin n) ℂ := fun α ↦ Polynomial.eval (MvPolynomial.C α) D'
    have hDα : ∀ α z, MvPolynomial.eval z (Dα α) = MvPolynomial.eval (Fin.cons α z) D :=
      fun α z ↦ (eval_cons_eq D α z).symm
    -- les mauvaises valeurs de `α` sont en nombre fini
    have hB : {α : ℂ | Dα α = 0}.Finite := by
      refine (D'.roots.toFinset.finite_toSet.preimage
        (MvPolynomial.C_injective (Fin n) ℂ).injOn).subset fun α hα ↦ ?_
      simp only [Set.mem_preimage, Finset.mem_coe, Multiset.mem_toFinset]
      exact (Polynomial.mem_roots hD'0).mpr hα
    let e : ℕ ↪ ({α : ℂ | Dα α = 0}ᶜ : Set ℂ) := hB.infinite_compl.natEmbedding _
    let α : Fin (N + 1) → ℂ := fun j ↦ (e j : ℂ)
    have hαinj : Function.Injective α := fun i j h ↦
      Fin.val_injective (e.injective (Subtype.ext h))
    have hαgood : ∀ j, Dα (α j) ≠ 0 := fun j ↦ (e j).2
    -- récurrence sur les tranches `z₀ = α j`
    have hQ : ∀ j, ∃ Q : MvPolynomial (Fin n) ℂ, ∀ z, MvPolynomial.eval z (Dα (α j)) ≠ 0 →
        g (Fin.cons (α j) z) = MvPolynomial.eval z Q := fun j ↦ by
      refine ih (Dα (α j)) (hαgood j) N (fun z ↦ g (Fin.cons (α j) z)) fun a v ha ↦ ?_
      obtain ⟨P, hPd, hP⟩ := hg (Fin.cons (α j) a) (Fin.cons 0 v) (by rwa [← hDα])
      refine ⟨P, hPd, fun t ht ↦ ?_⟩
      have := hP t (by rw [cons_add_smul, ← hDα]; exact ht)
      rwa [cons_add_smul] at this
    choose Q hQ using hQ
    let L : Fin (N + 1) → ℂ[X] := Lagrange.basis Finset.univ α
    let Qt : MvPolynomial (Fin (n + 1)) ℂ :=
      ∑ j, MvPolynomial.rename Fin.succ (Q j) * Polynomial.aeval (MvPolynomial.X 0) (L j)
    have hQt : ∀ s z, MvPolynomial.eval (Fin.cons s z) Qt =
        ∑ j, MvPolynomial.eval z (Q j) * (L j).eval s := fun s z ↦ by
      simp only [Qt, map_sum, map_mul, MvPolynomial.eval_rename, eval_aeval_X_zero, Fin.cons_zero]
      rfl
    -- le produit des `Dα (α j)`
    set E := ∏ j, Dα (α j) with hE
    have hE0 : E ≠ 0 := Finset.prod_ne_zero_iff.mpr fun j _ ↦ hαgood j
    have hEval : ∀ z, MvPolynomial.eval z E ≠ 0 → ∀ j, MvPolynomial.eval z (Dα (α j)) ≠ 0 :=
      fun z hz j ↦ by
        rw [hE, map_prod] at hz
        exact Finset.prod_ne_zero_iff.mp hz j (Finset.mem_univ j)
    -- étape 1 : sur les droites horizontales génériques
    have step1 : ∀ s z, MvPolynomial.eval z E ≠ 0 → MvPolynomial.eval (Fin.cons s z) D ≠ 0 →
        g (Fin.cons s z) = MvPolynomial.eval (Fin.cons s z) Qt := fun s z hz hsz ↦ by
      have hz' := hEval z hz
      obtain ⟨P, hPd, hP⟩ := hg (Fin.cons (α 0) z) (Fin.cons 1 0) (by rw [← hDα]; exact hz' 0)
      let P' := P.comp (X - C (α 0))
      have hP' : ∀ s', MvPolynomial.eval (Fin.cons s' z) D ≠ 0 → g (Fin.cons s' z) = P'.eval s' :=
        fun s' hs' ↦ by
          have := hP (s' - α 0) (by rw [cons_add_smul']; simpa using hs')
          rw [cons_add_smul'] at this
          simpa [P'] using this
      have hP'd : P'.degree < (Finset.univ : Finset (Fin (N + 1))).card := by
        rw [Finset.card_univ, Fintype.card_fin]
        refine (degree_le_natDegree).trans_lt ?_
        have : P'.natDegree ≤ N := by
          refine natDegree_comp_le.trans ?_
          have h1 : (X - C (α 0)).natDegree = 1 := natDegree_X_sub_C _
          rw [h1, mul_one]
          exact hPd
        exact_mod_cast Nat.lt_succ_of_le this
      have hint := Lagrange.eq_interpolate_of_eval_eq (s := Finset.univ) (v := α)
        (r := fun j ↦ MvPolynomial.eval z (Q j)) hαinj.injOn hP'd fun j _ ↦ by
          rw [← hP' (α j) (by rw [← hDα]; exact hz' j), hQ j z (hz' j)]
      rw [hP' s hsz, hint, Lagrange.interpolate_apply, hQt, eval_finsetSum]
      simp [L]
    -- étape 2 : partout, par une droite vers un point générique
    refine ⟨Qt, fun z hz ↦ ?_⟩
    let Et : MvPolynomial (Fin (n + 1)) ℂ := MvPolynomial.rename Fin.succ E
    have hEt : ∀ x, MvPolynomial.eval x Et = MvPolynomial.eval (Fin.tail x) E := fun x ↦ by
      simp only [Et, MvPolynomial.eval_rename]
      rfl
    have hEt0 : Et ≠ 0 := fun h ↦ hE0
      ((MvPolynomial.rename_injective _ (Fin.succ_injective n)) (by simpa [Et] using h))
    obtain ⟨w, hw⟩ := exists_eval_ne_zero hEt0
    set v := w - z
    obtain ⟨P, -, hP⟩ := hg z v hz
    have hfin1 := finite_setOf_eval_lineP_eq_zero (a := z) (v := v) (t := 0) (D := D) (by simpa)
    have hfin2 := finite_setOf_eval_lineP_eq_zero (a := z) (v := v) (t := 1) (D := Et)
      (by simpa [v] using hw)
    have hPR : P = lineP Qt z v := by
      refine Polynomial.eq_of_infinite_eval_eq _ _ ((hfin1.union hfin2).infinite_compl.mono ?_)
      intro t ht
      simp only [Set.mem_compl_iff, Set.mem_union, Set.mem_ofPred_eq, not_or] at ht
      simp only [Set.mem_ofPred_eq]
      rw [← hP t ht.1, eval_lineP]
      have h1 : MvPolynomial.eval (Fin.tail (z + t • v)) E ≠ 0 := by rw [← hEt]; exact ht.2
      have h2 : MvPolynomial.eval (Fin.cons ((z + t • v) 0) (Fin.tail (z + t • v))) D ≠ 0 := by
        rw [Fin.cons_self_tail]; exact ht.1
      have := step1 _ _ h1 h2
      rwa [Fin.cons_self_tail] at this
    have := hP 0 (by simpa using hz)
    rw [zero_smul, add_zero] at this
    rw [this, hPR, eval_lineP, zero_smul, add_zero]

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/Transitivity.lean` -/

section

/-!
# Transitivité : `proj⁻¹(V)` est connexe (A6)

Soit `U ⊆ Pts A` ouvert, avec `proj⁻¹(V) ∖ U` ouvert. Le polynôme
`e_U(z) = ∏_{φ ∈ fib z ∩ U} (X - φ(u))` a des coefficients :
* ℂ-différentiables sur `V` (sections locales du revêtement : `differentiableAt_coeff_eC`) ;
* à croissance polynomiale le long de chaque droite (`growth_line`).

Ce sont donc des polynômes en `z` (`exists_Q`). On obtient `F = F_U · F_{U'}` dans `S[W]`, et
`F` étant premier, l'un des facteurs est constant : `U` contient toute la fibre au-dessus de
`V`, ou rien (`fib_subset_or_disjoint`).
-/

open Polynomial Filter Topology

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

variable {n : ℕ} {A : Type} [CommRing A] [IsDomain A] [Algebra ℂ A] [Algebra (Sn n) A]
  [IsScalarTower ℂ (Sn n) A] [Module.Finite (Sn n) A] [Module.IsTorsionFree (Sn n) A]

open scoped Classical in
/-- `e_U(z) = ∏_{φ ∈ fib z ∩ U} (X - φ(u))`. -/
noncomputable def eC (e : GoodElt n A) (U : Set (Pts A)) (z : Fin n → ℂ) : ℂ[X] :=
  ∏ φ ∈ (fib z).filter (· ∈ U), (X - C (φ e.u))

theorem one_le_rootBound (F : (Sn n)[X]) (z : Fin n → ℂ) : 1 ≤ rootBound F z := by
  unfold rootBound
  linarith [Finset.sum_nonneg fun i (_ : i ∈ Finset.range (F.natDegree + 1)) ↦
    norm_nonneg (MvPolynomial.eval z (F.coeff i))]

theorem norm_coeff_eC_le (e : GoodElt n A) (U : Set (Pts A)) {z : Fin n → ℂ} (hz : z ∈ e.V)
    (k : ℕ) : ‖(eC e U z).coeff k‖ ≤ (1 + rootBound e.F z) ^ e.F.natDegree := by
  classical
  have hR0 : 0 ≤ rootBound e.F z := by linarith [one_le_rootBound e.F z]
  refine (norm_coeff_prod_X_sub_C_le _ (fun φ : Pts A ↦ φ e.u) hR0 (fun φ hφ ↦ ?_) k).trans ?_
  · have hφ' : proj φ = z := mem_fib.mp (Finset.mem_filter.mp hφ).1
    rw [← hφ']
    exact norm_le_rootBound e.monic _ (isRoot_apply_u e φ)
  · refine pow_le_pow_right₀ (by linarith) ?_
    rw [← card_fib e hz]
    exact Finset.card_filter_le _ _

/-- **Holomorphie des coefficients de `e_U` sur `V`.** -/
theorem differentiableAt_coeff_eC (e : GoodElt n A) (U : Set (Pts A)) (hU1 : IsOpen U)
    (hU2 : IsOpen (proj ⁻¹' e.V \ U)) {z₀ : Fin n → ℂ} (hz₀ : z₀ ∈ e.V) (k : ℕ) :
    DifferentiableAt ℂ (fun z ↦ (eC e U z).coeff k) z₀ := by
  classical
  set S := fib (A := A) z₀ with hS
  have hsec : ∀ φ ∈ S, ∃ (N : Set (Fin n → ℂ)) (σ : (Fin n → ℂ) → Pts A), IsOpen N ∧
      proj φ ∈ N ∧ N ⊆ e.V ∧ σ (proj φ) = φ ∧ ContinuousOn σ N ∧ (∀ z ∈ N, proj (σ z) = z) ∧
      (∀ z ∈ N, DifferentiableAt ℂ (fun z ↦ σ z e.u) z) := fun φ hφ ↦
    exists_localSection e φ (by rw [mem_fib.mp hφ]; exact hz₀)
  choose! N σ hN hmem hNV hσ0 hσc hσp hσd using hsec
  have hproj : ∀ φ ∈ S, proj φ = z₀ := fun φ hφ ↦ mem_fib.mp hφ
  have hz₀N : ∀ φ ∈ S, z₀ ∈ N φ := fun φ hφ ↦ hproj φ hφ ▸ hmem φ hφ
  have hσz₀ : ∀ φ ∈ S, σ φ z₀ = φ := fun φ hφ ↦ hproj φ hφ ▸ hσ0 φ hφ
  have hσcont : ∀ φ ∈ S, ContinuousAt (σ φ) z₀ := fun φ hφ ↦
    (hσc φ hφ).continuousAt ((hN φ hφ).mem_nhds (hz₀N φ hφ))
  -- les propriétés valables près de `z₀`
  have ev1 : ∀ᶠ z in 𝓝 z₀, ∀ φ ∈ S, z ∈ N φ :=
    (Finset.eventually_all S).mpr fun φ hφ ↦ (hN φ hφ).mem_nhds (hz₀N φ hφ)
  have ev2 : ∀ᶠ z in 𝓝 z₀, ∀ φ ∈ S, (σ φ z ∈ U ↔ φ ∈ U) := by
    refine (Finset.eventually_all S).mpr fun φ hφ ↦ ?_
    by_cases hφU : φ ∈ U
    · filter_upwards [(hσcont φ hφ).preimage_mem_nhds (hU1.mem_nhds (by rwa [hσz₀ φ hφ]))]
        with z hz
      exact ⟨fun _ ↦ hφU, fun _ ↦ hz⟩
    · have hφ' : σ φ z₀ ∈ proj ⁻¹' e.V \ U := by
        rw [hσz₀ φ hφ]
        exact ⟨by rw [Set.mem_preimage, hproj φ hφ]; exact hz₀, hφU⟩
      filter_upwards [(hσcont φ hφ).preimage_mem_nhds (hU2.mem_nhds hφ')] with z hz
      exact ⟨fun h ↦ absurd h hz.2, fun h ↦ absurd h hφU⟩
  have ev3 : ∀ᶠ z in 𝓝 z₀, ∀ φ ∈ S, ∀ ψ ∈ S, φ ≠ ψ → σ φ z e.u ≠ σ ψ z e.u := by
    refine (Finset.eventually_all S).mpr fun φ hφ ↦ (Finset.eventually_all S).mpr fun ψ hψ ↦ ?_
    by_cases hφψ : φ = ψ
    · exact Eventually.of_forall fun _ h ↦ absurd hφψ h
    · have hne : σ φ z₀ e.u ≠ σ ψ z₀ e.u := by
        rw [hσz₀ φ hφ, hσz₀ ψ hψ]
        exact fun h ↦ hφψ (injOn_fib e hz₀ hφ hψ h)
      have hc1 := ((hσd φ hφ) z₀ (hz₀N φ hφ)).continuousAt
      have hc2 := ((hσd ψ hψ) z₀ (hz₀N ψ hψ)).continuousAt
      filter_upwards [(hc1.sub hc2).eventually_ne (sub_ne_zero.mpr hne)] with z hz
      exact fun _ h ↦ hz (sub_eq_zero.mpr h)
  have ev4 : ∀ᶠ z in 𝓝 z₀, z ∈ e.V := e.isOpen_V.mem_nhds hz₀
  -- la description locale de `e_U`
  have hloc : (fun z ↦ (eC e U z).coeff k) =ᶠ[𝓝 z₀]
      fun z ↦ (∏ φ ∈ S.filter (· ∈ U), (X - C (σ φ z e.u))).coeff k := by
    filter_upwards [ev1, ev2, ev3, ev4] with z h1 h2 h3 h4
    have hinj : Set.InjOn (fun φ ↦ σ φ z) (S : Set (Pts A)) := fun φ hφ ψ hψ h ↦ by
      by_contra hne
      exact h3 φ hφ ψ hψ hne (by simp only at h; rw [h])
    have himg : S.image (fun φ ↦ σ φ z) = fib z := by
      refine Finset.eq_of_subset_of_card_le (fun ψ hψ ↦ ?_) ?_
      · obtain ⟨φ, hφ, rfl⟩ := Finset.mem_image.mp hψ
        exact mem_fib.mpr (hσp φ hφ z (h1 φ hφ))
      · rw [Finset.card_image_of_injOn hinj, card_fib e h4, hS, card_fib e hz₀]
    congr 1
    rw [eC, ← himg, Finset.filter_image,
      Finset.prod_image (hinj.mono fun x hx ↦ (Finset.mem_filter.mp hx).1)]
    refine Finset.prod_congr (Finset.filter_congr fun φ hφ ↦ h2 φ hφ) fun _ _ ↦ rfl
  refine DifferentiableAt.congr_of_eventuallyEq ?_ hloc
  exact differentiableAt_coeff_prod _ (fun φ z ↦ σ φ z e.u)
    (fun φ hφ ↦ hσd φ (Finset.mem_filter.mp hφ).1 z₀ (hz₀N φ (Finset.mem_filter.mp hφ).1)) k

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/Factor.lean` -/

section

/-!
# Polynomialité des coefficients de `e_U` et factorisation de `F` (A6)

* `growth_line` : sur la droite `a + s v`, les coefficients de `e_U` sont `O((1 + |s|)ᴺ)`, avec
  `N = D · d` uniforme (`D` le degré total maximal des coefficients de `F`).
* `exists_Q` : chaque coefficient de `e_U` coïncide sur `V` avec un polynôme en `z`.
* `fib_subset_or_disjoint` : `F = F_U · F_{U'}` dans `S[W]` ; `F` étant premier, `U` contient
  toutes les fibres au-dessus de `V` ou n'en rencontre aucune.
-/

open Polynomial Filter Topology

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

variable {n : ℕ} {A : Type} [CommRing A] [IsDomain A] [Algebra ℂ A] [Algebra (Sn n) A]
  [IsScalarTower ℂ (Sn n) A] [Module.Finite (Sn n) A] [Module.IsTorsionFree (Sn n) A]

/-- Le degré total maximal des coefficients de `F`. -/
noncomputable def Dg (e : GoodElt n A) : ℕ :=
  (Finset.range (e.F.natDegree + 1)).sup fun i ↦ (e.F.coeff i).totalDegree

theorem coeffSum_nonneg (Q : Sn n) : 0 ≤ coeffSum Q :=
  Finset.sum_nonneg fun _ _ ↦ norm_nonneg _

/-- Somme des `coeffSum` des coefficients de `F`. -/
noncomputable def KF (e : GoodElt n A) : ℝ :=
  1 + ∑ i ∈ Finset.range (e.F.natDegree + 1), coeffSum (e.F.coeff i)

theorem one_le_KF (e : GoodElt n A) : 1 ≤ KF e := by
  unfold KF
  linarith [Finset.sum_nonneg fun i (_ : i ∈ Finset.range (e.F.natDegree + 1)) ↦
    coeffSum_nonneg (e.F.coeff i)]

theorem rootBound_le (e : GoodElt n A) (z : Fin n → ℂ) :
    rootBound e.F z ≤ KF e * (1 + ‖z‖) ^ Dg e := by
  have h1 : (1 : ℝ) ≤ 1 + ‖z‖ := by linarith [norm_nonneg z]
  have hP : (1 : ℝ) ≤ (1 + ‖z‖) ^ Dg e := one_le_pow₀ h1
  have hterm : ∀ i ∈ Finset.range (e.F.natDegree + 1),
      ‖MvPolynomial.eval z (e.F.coeff i)‖ ≤ coeffSum (e.F.coeff i) * (1 + ‖z‖) ^ Dg e :=
    fun i hi ↦ (norm_eval_le _ z).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ h1 (Finset.le_sup (f := fun i ↦ (e.F.coeff i).totalDegree) hi))
      (coeffSum_nonneg _))
  have hsum := Finset.sum_le_sum hterm
  rw [← Finset.sum_mul] at hsum
  unfold rootBound KF
  nlinarith [Finset.sum_nonneg fun i (_ : i ∈ Finset.range (e.F.natDegree + 1)) ↦
    coeffSum_nonneg (e.F.coeff i)]

theorem norm_line_le (a v : Fin n → ℂ) (s : ℂ) :
    1 + ‖a + s • v‖ ≤ (1 + ‖a‖ + ‖v‖) * (1 + ‖s‖) := by
  have h := norm_add_le a (s • v)
  rw [norm_smul] at h
  nlinarith [norm_nonneg a, norm_nonneg v, norm_nonneg s, mul_nonneg (norm_nonneg s) (norm_nonneg a)]

/-- **Croissance polynomiale le long d'une droite.** -/
theorem growth_line (e : GoodElt n A) (U : Set (Pts A)) (a v : Fin n → ℂ) :
    ∃ K : ℝ, ∀ s : ℂ, a + s • v ∈ e.V → ∀ k,
      ‖(eC e U (a + s • v)).coeff k‖ ≤ K * (1 + ‖s‖) ^ (Dg e * e.F.natDegree) := by
  set M := 1 + ‖a‖ + ‖v‖
  have hM : 0 ≤ M := by positivity
  refine ⟨(1 + KF e * M ^ Dg e) ^ e.F.natDegree, fun s hs k ↦ ?_⟩
  have hs1 : (1 : ℝ) ≤ (1 + ‖s‖) ^ Dg e := one_le_pow₀ (by linarith [norm_nonneg s])
  have hR : rootBound e.F (a + s • v) ≤ KF e * M ^ Dg e * (1 + ‖s‖) ^ Dg e := by
    refine (rootBound_le e _).trans ?_
    rw [mul_assoc, ← mul_pow]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) (norm_line_le a v s) _)
      (by linarith [one_le_KF e])
  have hKM : 0 ≤ KF e * M ^ Dg e := mul_nonneg (by linarith [one_le_KF e]) (pow_nonneg hM _)
  have h1 : 1 + rootBound e.F (a + s • v) ≤ (1 + KF e * M ^ Dg e) * (1 + ‖s‖) ^ Dg e := by
    nlinarith
  calc ‖(eC e U (a + s • v)).coeff k‖ ≤ (1 + rootBound e.F (a + s • v)) ^ e.F.natDegree :=
        norm_coeff_eC_le e U hs k
    _ ≤ ((1 + KF e * M ^ Dg e) * (1 + ‖s‖) ^ Dg e) ^ e.F.natDegree :=
        pow_le_pow_left₀ (by linarith [one_le_rootBound e.F (a + s • v)]) h1 _
    _ = (1 + KF e * M ^ Dg e) ^ e.F.natDegree * (1 + ‖s‖) ^ (Dg e * e.F.natDegree) := by
        rw [mul_pow, ← pow_mul]

/-- **Les coefficients de `e_U` sont polynomiaux sur `V`.** -/
theorem exists_Q (e : GoodElt n A) (U : Set (Pts A)) (hU1 : IsOpen U)
    (hU2 : IsOpen (proj ⁻¹' e.V \ U)) (k : ℕ) :
    ∃ Q : Sn n, ∀ z ∈ e.V, (eC e U z).coeff k = MvPolynomial.eval z Q := by
  have hD : e.c * e.δ ≠ 0 := mul_ne_zero e.hc e.hδ
  obtain ⟨Q, hQ⟩ := exists_mvPoly_of_lines n (e.c * e.δ) hD (Dg e * e.F.natDegree)
    (fun z ↦ (eC e U z).coeff k) fun a v ha ↦ by
      have hfin := finite_setOf_eval_lineP_eq_zero (D := e.c * e.δ) (a := a) (v := v) (t := 0)
        (by simpa using ha)
      obtain ⟨K, hK⟩ := growth_line e U a v
      have hmemV : ∀ s, s ∉ hfin.toFinset → a + s • v ∈ e.V := fun s hs ↦ by
        simpa [GoodElt.V] using hs
      obtain ⟨P, hPd, hP⟩ := exists_poly_of_growth_off_finite hfin.toFinset
        (fun s ↦ (eC e U (a + s • v)).coeff k)
        (fun s hs ↦ (differentiableAt_coeff_eC e U hU1 hU2 (hmemV s hs) k).comp s
          ((differentiableAt_const a).add (differentiableAt_id.smul_const v)))
        _ K (fun s hs ↦ hK s (hmemV s hs) k)
      exact ⟨P, hPd, fun t ht ↦ hP t (by simpa using ht)⟩
  exact ⟨Q, fun z hz ↦ hQ z hz⟩

/-! ### Factorisation -/

/-- Le polynôme `Σ_{k ≤ d} Q_k Wᵏ`. -/
noncomputable def polyOf (Q : ℕ → Sn n) (d : ℕ) : (Sn n)[X] :=
  ∑ k ∈ Finset.range (d + 1), C (Q k) * X ^ k

open scoped Classical in
theorem natDegree_eC (e : GoodElt n A) (U : Set (Pts A)) (z : Fin n → ℂ) :
    (eC e U z).natDegree = ((fib (A := A) z).filter (· ∈ U)).card := by
  classical
  unfold eC
  rw [natDegree_prod _ _ fun i _ ↦ X_sub_C_ne_zero _]
  simp

theorem notMem_of_natDegree_eC (e : GoodElt n A) (U : Set (Pts A)) (z : Fin n → ℂ)
    (h : (eC e U z).natDegree = 0) : ∀ φ ∈ fib (A := A) z, φ ∉ U := by
  classical
  intro φ hφ hφU
  have hmem : φ ∈ (fib z).filter (· ∈ U) := Finset.mem_filter.mpr ⟨hφ, hφU⟩
  rw [natDegree_eC, Finset.card_eq_zero] at h
  rw [h] at hmem
  simp at hmem

open scoped Classical in
theorem natDegree_eC_le (e : GoodElt n A) (U : Set (Pts A)) {z : Fin n → ℂ} (hz : z ∈ e.V) :
    (eC e U z).natDegree ≤ e.F.natDegree := by
  classical
  rw [natDegree_eC, ← card_fib e hz]
  exact Finset.card_filter_le _ _

theorem specz_polyOf (e : GoodElt n A) (U : Set (Pts A)) (Q : ℕ → Sn n)
    (hQ : ∀ k, ∀ z ∈ e.V, (eC e U z).coeff k = MvPolynomial.eval z (Q k)) {z : Fin n → ℂ}
    (hz : z ∈ e.V) : specz (polyOf Q e.F.natDegree) z = eC e U z := by
  rw [as_sum_range' (eC e U z) (e.F.natDegree + 1) (Nat.lt_succ_of_le (natDegree_eC_le e U hz))]
  simp only [specz, polyOf, Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_C,
    Polynomial.map_pow, Polynomial.map_X]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  rw [hQ k z hz, C_mul_X_pow_eq_monomial]

open scoped Classical in
/-- **Dichotomie** : un ouvert `U` avec `proj⁻¹(V) ∖ U` ouvert contient toutes les fibres
au-dessus de `V`, ou n'en rencontre aucune. -/
theorem fib_subset_or_disjoint (e : GoodElt n A) (U : Set (Pts A)) (hU1 : IsOpen U)
    (hU2 : IsOpen (proj ⁻¹' e.V \ U)) :
    (∀ z ∈ e.V, ∀ φ ∈ fib (A := A) z, φ ∈ U) ∨ (∀ z ∈ e.V, ∀ φ ∈ fib (A := A) z, φ ∉ U) := by
  set U₂ := proj ⁻¹' e.V \ U with hU₂
  have hU2' : IsOpen (proj ⁻¹' e.V \ U₂) := by
    rw [hU₂, Set.sdiff_sdiff_right_self]
    exact (e.isOpen_V.preimage continuous_proj).inter hU1
  choose Q₁ hQ₁ using exists_Q e U hU1 hU2
  choose Q₂ hQ₂ using exists_Q e U₂ hU2 hU2'
  set F₁ := polyOf Q₁ e.F.natDegree
  set F₂ := polyOf Q₂ e.F.natDegree
  have h1 : ∀ z ∈ e.V, specz F₁ z = eC e U z := fun z hz ↦ specz_polyOf e U Q₁ hQ₁ hz
  have h2 : ∀ z ∈ e.V, specz F₂ z = eC e U₂ z := fun z hz ↦ specz_polyOf e U₂ Q₂ hQ₂ hz
  have hfil : ∀ z ∈ e.V, eC e U₂ z = ∏ φ ∈ (fib z).filter (· ∉ U), (X - C (φ e.u)) := by
    intro z hz
    unfold eC
    refine Finset.prod_congr ?_ fun _ _ ↦ rfl
    ext φ
    simp only [Finset.mem_filter]
    constructor
    · rintro ⟨hφ, h⟩
      exact ⟨hφ, h.2⟩
    · rintro ⟨hφ, h⟩
      exact ⟨hφ, by rw [Set.mem_preimage, mem_fib.mp hφ]; exact hz, h⟩
  have hprod : ∀ z ∈ e.V, specz (F₁ * F₂) z = specz e.F z := by
    intro z hz
    rw [specz, Polynomial.map_mul, ← specz, ← specz, h1 z hz, h2 z hz, hfil z hz, eC,
      Finset.prod_filter_mul_prod_filter_not, prod_fib e hz]
  have hF : F₁ * F₂ = e.F := by
    refine Polynomial.ext fun k ↦ ?_
    have hz : ∀ z, MvPolynomial.eval z (((F₁ * F₂).coeff k - e.F.coeff k) * (e.c * e.δ)) = 0 := by
      intro z
      by_cases hz : z ∈ e.V
      · have := congrArg (fun p ↦ p.coeff k) (hprod z hz)
        simp only [specz, coeff_map] at this
        rw [map_mul, map_sub, this, sub_self, zero_mul]
      · have : MvPolynomial.eval z (e.c * e.δ) = 0 := by
          by_contra h; exact hz h
        rw [map_mul, this, mul_zero]
    have h0 : ((F₁ * F₂).coeff k - e.F.coeff k) * (e.c * e.δ) = 0 :=
      MvPolynomial.funext fun z ↦ by simpa using hz z
    exact sub_eq_zero.mp ((mul_eq_zero.mp h0).resolve_right (mul_ne_zero e.hc e.hδ))
  have hprime : Prime e.F := minpoly.prime_of_isIntegrallyClosed (isIntegral_u e)
  have hunit : ∀ {G H : (Sn n)[X]}, G * H = e.F → e.F ∣ G → ∃ r, H = C r := by
    intro G H hGH hdvd
    obtain ⟨g, hg⟩ := hdvd
    have : e.F * (g * H) = e.F * 1 := by rw [mul_one, ← mul_assoc, ← hg, hGH]
    have hgH := mul_left_cancel₀ hprime.ne_zero this
    obtain ⟨r, -, hr⟩ := Polynomial.isUnit_iff.mp (IsUnit.of_mul_eq_one_right g hgH)
    exact ⟨r, hr.symm⟩
  rcases hprime.dvd_or_dvd (show e.F ∣ F₁ * F₂ by rw [hF]) with hd | hd
  · obtain ⟨r, hr⟩ := hunit hF hd
    left
    intro z hz φ hφ
    by_contra hφU
    have hc : (eC e U₂ z).natDegree = 0 := by
      rw [← h2 z hz, hr, specz, Polynomial.map_C, natDegree_C]
    exact notMem_of_natDegree_eC e U₂ z hc φ hφ
      ⟨by rw [Set.mem_preimage, mem_fib.mp hφ]; exact hz, hφU⟩
  · obtain ⟨r, hr⟩ := hunit (by rw [mul_comm]; exact hF) hd
    right
    intro z hz φ hφ hφU
    have hc : (eC e U z).natDegree = 0 := by
      rw [← h1 z hz, hr, specz, Polynomial.map_C, natDegree_C]
    exact notMem_of_natDegree_eC e U z hc φ hφ hφU

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/PathConnV.lean` -/

section

/-!
# `proj⁻¹(V)` est connexe par arcs (A6)

Chaque point de `proj⁻¹(V)` a un voisinage ouvert connexe par arcs (image d'une boule par
l'inverse local de `proj`). La composante par arcs d'un point est donc ouverte, de complémentaire
ouvert dans `proj⁻¹(V)` ; la dichotomie `fib_subset_or_disjoint` conclut.
-/

open Polynomial Filter Topology Metric

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

variable {n : ℕ} {A : Type} [CommRing A] [IsDomain A] [Algebra ℂ A] [Algebra (Sn n) A]
  [IsScalarTower ℂ (Sn n) A] [Module.Finite (Sn n) A] [Module.IsTorsionFree (Sn n) A]

theorem exists_pathConnected_nhds (e : GoodElt n A) {φ : Pts A} (hφ : proj φ ∈ e.V) :
    ∃ O : Set (Pts A), IsOpen O ∧ φ ∈ O ∧ O ⊆ proj ⁻¹' e.V ∧ IsPathConnected O := by
  obtain ⟨H, hφH, hH⟩ := isLocalHomeomorphOn_proj e φ hφ
  have hVo : IsOpen (proj ⁻¹' e.V : Set (Pts A)) := e.isOpen_V.preimage continuous_proj
  have hW : IsOpen (H.target ∩ H.symm ⁻¹' (H.source ∩ proj ⁻¹' e.V)) :=
    H.continuousOn_symm.isOpen_inter_preimage H.open_target (H.open_source.inter hVo)
  have hφW : H φ ∈ H.target ∩ H.symm ⁻¹' (H.source ∩ proj ⁻¹' e.V) :=
    ⟨H.map_source hφH, by rw [Set.mem_preimage, H.left_inv hφH]; exact ⟨hφH, hφ⟩⟩
  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hW _ hφW
  have hBt : ball (H φ) r ⊆ H.target := fun y hy ↦ (hball hy).1
  refine ⟨H.symm '' ball (H φ) r, ?_, ⟨H φ, mem_ball_self hr, H.left_inv hφH⟩, ?_, ?_⟩
  · rw [H.symm_image_eq_source_inter_preimage hBt]
    exact H.isOpen_inter_preimage isOpen_ball
  · rintro _ ⟨y, hy, rfl⟩
    exact (hball hy).2.2
  · exact (convex_ball _ _).isPathConnected (nonempty_ball.mpr hr) |>.image'
      (H.continuousOn_symm.mono hBt)

/-- **`proj⁻¹(V)` est connexe par arcs.** -/
theorem isPathConnected_preimage_V (e : GoodElt n A) {φ₀ : Pts A} (hφ₀ : proj φ₀ ∈ e.V) :
    IsPathConnected (proj ⁻¹' e.V : Set (Pts A)) := by
  set X := (proj ⁻¹' e.V : Set (Pts A))
  let U : Set (Pts A) := {φ | φ ∈ X ∧ JoinedIn X φ₀ φ}
  have hU1 : IsOpen U := by
    refine isOpen_iff_forall_mem_open.mpr fun φ hφ ↦ ?_
    obtain ⟨O, hO, hφO, hOX, hOp⟩ := exists_pathConnected_nhds e hφ.1
    refine ⟨O, fun φ' hφ' ↦ ⟨hOX hφ', hφ.2.trans ((hOp.joinedIn φ hφO φ' hφ').mono hOX)⟩, hO, hφO⟩
  have hU2 : IsOpen (X \ U) := by
    refine isOpen_iff_forall_mem_open.mpr fun φ hφ ↦ ?_
    obtain ⟨O, hO, hφO, hOX, hOp⟩ := exists_pathConnected_nhds e hφ.1
    refine ⟨O, fun φ' hφ' ↦ ⟨hOX hφ', fun hU ↦ hφ.2 ⟨hφ.1, hU.2.trans
      ((hOp.joinedIn φ' hφ' φ hφO).mono hOX)⟩⟩, hO, hφO⟩
  have hφ₀U : φ₀ ∈ U := ⟨hφ₀, JoinedIn.refl hφ₀⟩
  rcases fib_subset_or_disjoint e U hU1 hU2 with h | h
  · exact ⟨φ₀, hφ₀, fun {φ} hφ ↦ (h (proj φ) hφ φ (mem_fib.mpr rfl)).2⟩
  · exact absurd hφ₀U (h (proj φ₀) hφ₀ φ₀ (mem_fib.mpr rfl))

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/Cluster.lean` -/

section

/-!
# Convergence par adhérence finie (A6)

`tendsto_of_cluster_finite` : une fonction continue `g : ℝ → ℂ`, bornée près de `+∞`, dont
toutes les valeurs d'adhérence en `+∞` sont dans un ensemble fini `R`, converge vers un point de
`R`. (L'image de `[r₁, +∞[` est connexe, et les boules autour des points de `R` sont disjointes.)
-/

open Filter Topology Metric

namespace FiniteFields.Betti.Connected

/-- Un écart minimal positif entre les points distincts d'un ensemble fini. -/
theorem exists_sep (R : Finset ℂ) :
    ∃ ρ > 0, ∀ t ∈ R, ∀ t' ∈ R, t ≠ t' → 2 * ρ ≤ dist t t' := by
  classical
  let D := ((R ×ˢ R).filter fun p ↦ p.1 ≠ p.2).image fun p ↦ dist p.1 p.2
  by_cases hD : D.Nonempty
  · refine ⟨D.min' hD / 2, ?_, fun t ht t' ht' hne ↦ ?_⟩
    · obtain ⟨p, hp, hpe⟩ := Finset.mem_image.mp (D.min'_mem hD)
      have := (Finset.mem_filter.mp hp).2
      rw [← hpe]
      exact half_pos (dist_pos.mpr this)
    · have : dist t t' ∈ D := Finset.mem_image.mpr
        ⟨(t, t'), Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨ht, ht'⟩, hne⟩, rfl⟩
      linarith [D.min'_le _ this]
  · refine ⟨1, one_pos, fun t ht t' ht' hne ↦ absurd ⟨_, Finset.mem_image.mpr
      ⟨(t, t'), Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨ht, ht'⟩, hne⟩, rfl⟩⟩ hD⟩

/-- **Convergence par adhérence finie.** -/
theorem tendsto_of_cluster_finite (g : ℝ → ℂ) (hg : Continuous g) (R : Finset ℂ)
    (hbd : ∃ M, ∀ᶠ r in atTop, ‖g r‖ ≤ M)
    (hcl : ∀ (rs : ℕ → ℝ) (t : ℂ), Tendsto rs atTop atTop →
      Tendsto (g ∘ rs) atTop (𝓝 t) → t ∈ R) :
    ∃ t ∈ R, Tendsto g atTop (𝓝 t) := by
  obtain ⟨M, hM⟩ := hbd
  -- étape 1 : `g` finit près de `R`
  have step1 : ∀ ρ > 0, ∀ᶠ r in atTop, ∃ t ∈ R, dist (g r) t < ρ := by
    intro ρ hρ
    by_contra h
    rw [Filter.not_eventually] at h
    have hfr := h.and_eventually hM
    rw [Filter.frequently_atTop] at hfr
    choose rs hrs hP using fun k : ℕ ↦ hfr k
    have hrs' : Tendsto rs atTop atTop :=
      tendsto_atTop_mono hrs tendsto_natCast_atTop_atTop
    have hb : Bornology.IsBounded (Set.range (g ∘ rs)) :=
      isBounded_iff_forall_norm_le.mpr ⟨M, by rintro _ ⟨k, rfl⟩; exact (hP k).2⟩
    obtain ⟨t, -, φ, hφ, hlim⟩ := tendsto_subseq_of_bounded hb fun k ↦ Set.mem_range_self k
    have htR := hcl (rs ∘ φ) t (hrs'.comp hφ.tendsto_atTop) hlim
    have hfar : ∀ k, ρ ≤ dist ((g ∘ rs ∘ φ) k) t := fun k ↦ by
      have := (hP (φ k)).1
      push Not at this
      exact this t htR
    have := ge_of_tendsto (hlim.dist tendsto_const_nhds) (Eventually.of_forall hfar)
    simp at this
    linarith
  obtain ⟨ρ₀, hρ₀, hsep⟩ := exists_sep R
  -- étape 2 : `g` finit dans une seule boule
  obtain ⟨r₁, hr₁⟩ := Filter.eventually_atTop.mp (step1 ρ₀ hρ₀)
  obtain ⟨t₀, ht₀, hgt₀⟩ := hr₁ r₁ le_rfl
  have hin : g '' Set.Ici r₁ ⊆ ball t₀ ρ₀ := by
    have hpre : IsPreconnected (g '' Set.Ici r₁) :=
      isPreconnected_Ici.image g hg.continuousOn
    refine hpre.subset_left_of_subset_union isOpen_ball
      (isOpen_biUnion fun t _ ↦ isOpen_ball (x := t) (ε := ρ₀) :
        IsOpen (⋃ t ∈ R.erase t₀, ball t ρ₀)) ?_ ?_ ⟨g r₁, ⟨r₁, Set.self_mem_Ici, rfl⟩, hgt₀⟩
    · rw [Set.disjoint_iff]
      rintro y ⟨hy1, hy2⟩
      simp only [Set.mem_iUnion] at hy2
      obtain ⟨t, ht, hy2⟩ := hy2
      obtain ⟨hne, htR⟩ := Finset.mem_erase.mp ht
      have := hsep t htR t₀ ht₀ hne
      have := dist_triangle t y t₀
      rw [mem_ball] at hy1 hy2
      rw [dist_comm] at hy2
      linarith
    · rintro _ ⟨r, hr, rfl⟩
      obtain ⟨t, ht, hgt⟩ := hr₁ r hr
      by_cases htt : t = t₀
      · left; rw [← htt]; exact hgt
      · right
        simp only [Set.mem_iUnion]
        exact ⟨t, Finset.mem_erase.mpr ⟨htt, ht⟩, hgt⟩
  -- étape 3 : convergence
  refine ⟨t₀, ht₀, Metric.tendsto_atTop.mpr fun ε hε ↦ ?_⟩
  obtain ⟨r₂, hr₂⟩ := Filter.eventually_atTop.mp (step1 (min ε ρ₀) (lt_min hε hρ₀))
  refine ⟨max r₁ r₂, fun r hr ↦ ?_⟩
  obtain ⟨t, ht, hgt⟩ := hr₂ r (le_of_max_le_right hr)
  have hg0 : dist (g r) t₀ < ρ₀ := hin ⟨r, le_of_max_le_left hr, rfl⟩
  by_cases htt : t = t₀
  · rw [← htt]
    exact hgt.trans_le (min_le_left _ _)
  · have h1 := hsep t ht t₀ ht₀ htt
    have h2 := dist_triangle t (g r) t₀
    rw [dist_comm] at hgt
    have := min_le_right ε ρ₀
    linarith

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/Branch.lean` -/

section

/-!
# Chemins vers les points de branchement (A6)

Soit `ψ` un point au-dessus de `b`, et `u` un bon élément qui sépare la fibre de `b`. On relève
dans le revêtement `proj⁻¹(V) → V` un chemin `γ : ℝ → V` qui tend vers `b` en `+∞`
(`exists_lift`). Chaque relèvement converge (adhérence finie : `tendsto_lift`). Les relèvements
issus des `d` points d'une fibre remplissent les fibres, et l'un d'eux tend vers `ψ`, faute de
quoi `F(γ(r), ψ(u))` resterait loin de `0` (`exists_joined_preimage_V`).
-/

open Polynomial Filter Topology Metric

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

variable {n : ℕ} {A : Type} [CommRing A] [IsDomain A] [Algebra ℂ A] [Algebra (Sn n) A]
  [IsScalarTower ℂ (Sn n) A] [Module.Finite (Sn n) A] [Module.IsTorsionFree (Sn n) A]

theorem isCoveringMap_restrict (e : GoodElt n A) :
    IsCoveringMap (e.V.restrictPreimage (proj (n := n) (A := A))) :=
  (isCoveringMapOn_proj e).isCoveringMap_restrictPreimage e.V

/-- **Relèvement** d'un chemin `γ : ℝ → V`. -/
theorem exists_lift (e : GoodElt n A) (γ : ℝ → Fin n → ℂ) (hγ : Continuous γ)
    (hγV : ∀ r, γ r ∈ e.V) (x : Pts A) (hx : proj x = γ 0) :
    ∃ F : ℝ → Pts A, Continuous F ∧ F 0 = x ∧ ∀ r, proj (F r) = γ r := by
  let G : C(ℝ, e.V) := ⟨fun r ↦ ⟨γ r, hγV r⟩, hγ.subtype_mk _⟩
  have hxV : x ∈ proj ⁻¹' e.V := by rw [Set.mem_preimage, hx]; exact hγV 0
  obtain ⟨F, ⟨hF0, hFp⟩, -⟩ := (isCoveringMap_restrict e).existsUnique_continuousMap_lifts G 0
    ⟨x, hxV⟩ (Subtype.ext hx)
  refine ⟨fun r ↦ (F r).1, continuous_subtype_val.comp F.continuous, by simp only [hF0], fun r ↦ ?_⟩
  have := congrFun hFp r
  exact congrArg Subtype.val this

/-- **Unicité du relèvement.** -/
theorem lift_unique (e : GoodElt n A) (γ : ℝ → Fin n → ℂ) (hγV : ∀ r, γ r ∈ e.V)
    (F₁ F₂ : ℝ → Pts A) (h₁ : Continuous F₁) (h₂ : Continuous F₂)
    (hp₁ : ∀ r, proj (F₁ r) = γ r) (hp₂ : ∀ r, proj (F₂ r) = γ r) (r₀ : ℝ)
    (h : F₁ r₀ = F₂ r₀) : F₁ = F₂ := by
  have hm : ∀ (F : ℝ → Pts A), (∀ r, proj (F r) = γ r) → ∀ r, F r ∈ proj ⁻¹' e.V :=
    fun F hF r ↦ by rw [Set.mem_preimage, hF r]; exact hγV r
  let G₁ : ℝ → proj ⁻¹' e.V := fun r ↦ ⟨F₁ r, hm F₁ hp₁ r⟩
  let G₂ : ℝ → proj ⁻¹' e.V := fun r ↦ ⟨F₂ r, hm F₂ hp₂ r⟩
  have := (isCoveringMap_restrict e).eq_of_comp_eq (g₁ := G₁) (g₂ := G₂)
    (h₁.subtype_mk _) (h₂.subtype_mk _) (funext fun r ↦ Subtype.ext ((hp₁ r).trans (hp₂ r).symm))
    r₀ (Subtype.ext h)
  funext r
  exact congrArg Subtype.val (congrFun this r)

/-- **Convergence d'un relèvement** vers un point de la fibre de `b`, si `u` sépare cette
fibre. -/
theorem tendsto_lift (e : GoodElt n A) {b : Fin n → ℂ}
    (hsep : ∀ φ φ' : Pts A, proj φ = b → proj φ' = b → φ e.u = φ' e.u → φ = φ')
    (γ : ℝ → Fin n → ℂ) (hγb : Tendsto γ atTop (𝓝 b)) (F : ℝ → Pts A) (hF : Continuous F)
    (hp : ∀ r, proj (F r) = γ r) :
    ∃ φ : Pts A, proj φ = b ∧ Tendsto F atTop (𝓝 φ) := by
  have hpF : Tendsto (fun r ↦ proj (F r)) atTop (𝓝 b) := by simpa [hp] using hγb
  -- la coordonnée `u` converge
  obtain ⟨t, -, ht⟩ := tendsto_of_cluster_finite (fun r ↦ F r e.u)
    ((continuous_apply_pts e.u).comp hF) (rootsF e b)
    ⟨rootBound e.F b + 1, by
      have hrb := ((continuous_rootBound e.F).tendsto b).comp hpF
      filter_upwards [hrb.eventually (gt_mem_nhds (lt_add_one _))] with r hr
      exact (norm_le_rootBound e.monic _ (isRoot_apply_u e (F r))).trans hr.le⟩
    fun rs t hrs hlim ↦ by
      rw [mem_rootsF, IsRoot.def]
      have h1 : Tendsto (fun k ↦ Pf e.F (proj (F (rs k)), F (rs k) e.u)) atTop
          (𝓝 (Pf e.F (b, t))) :=
        ((contDiff_Pf e.F).continuous.tendsto _).comp ((hpF.comp hrs).prodMk_nhds hlim)
      have h0 : ∀ k, Pf e.F (proj (F (rs k)), F (rs k) e.u) = 0 := fun k ↦
        isRoot_apply_u e (F (rs k))
      simp only [h0] at h1
      exact tendsto_nhds_unique h1 tendsto_const_nhds
  -- la limite le long des entiers
  obtain ⟨ψ, hψ, φ₀, hφ₀⟩ := exists_tendsto_subseq (fun k : ℕ ↦ F k)
    (hpF.comp tendsto_natCast_atTop_atTop)
  have hlimit : ∀ (ns : ℕ → ℝ) (φ : Pts A), Tendsto ns atTop atTop →
      Tendsto (fun k ↦ F (ns k)) atTop (𝓝 φ) → proj φ = b ∧ φ e.u = t := fun ns φ hns hφ ↦
    ⟨tendsto_nhds_unique ((continuous_proj.tendsto φ).comp hφ) (hpF.comp hns),
      tendsto_nhds_unique (((continuous_apply_pts e.u).tendsto φ).comp hφ) (ht.comp hns)⟩
  have h₀ := hlimit (fun k ↦ ((ψ k : ℕ) : ℝ)) φ₀
    (tendsto_natCast_atTop_atTop.comp hψ.tendsto_atTop) hφ₀
  refine ⟨φ₀, h₀.1, Filter.tendsto_of_subseq_tendsto fun ns hns ↦ ?_⟩
  obtain ⟨ms, hms, φ₁, hφ₁⟩ := exists_tendsto_subseq (fun k ↦ F (ns k)) (hpF.comp hns)
  have h₁ := hlimit (fun k ↦ ns (ms k)) φ₁ (hns.comp hms.tendsto_atTop) hφ₁
  refine ⟨ms, ?_⟩
  rw [hsep φ₀ φ₁ h₀.1 h₁.1 (h₀.2.trans h₁.2.symm)]
  exact hφ₁

/-- Un chemin `[0, 1] → Pts A` qui part de la limite d'une fonction `H : ℝ → Pts A` en `+∞`. -/
theorem joined_of_tendsto (H : ℝ → Pts A) (hH : Continuous H) {ψ : Pts A}
    (hL : Tendsto H atTop (𝓝 ψ)) : Joined ψ (H 0) := by
  classical
  let p : unitInterval → Pts A := fun t ↦ if (t : ℝ) = 0 then ψ else H ((1 - t) / t)
  have hcont : Continuous p := by
    rw [continuous_iff_continuousAt]
    intro t
    by_cases ht : (t : ℝ) = 0
    · have ht0 : t = 0 := Subtype.ext ht
      subst ht0
      rw [ContinuousAt, _root_.tendsto_nhds]
      intro W hW hψW
      have hp0 : p 0 = ψ := if_pos rfl
      rw [hp0] at hψW
      obtain ⟨R, hR⟩ := Filter.eventually_atTop.mp (hL.eventually (hW.mem_nhds hψW))
      set δ : ℝ := 1 / (|R| + 1)
      have hδ : 0 < δ := by positivity
      have hopen : IsOpen {s : unitInterval | (s : ℝ) < δ} :=
        isOpen_lt continuous_subtype_val continuous_const
      refine Filter.mem_of_superset (hopen.mem_nhds (by simpa using hδ)) fun s hs ↦ ?_
      simp only [Set.mem_ofPred_eq] at hs
      simp only [Set.mem_preimage, p]
      split_ifs with h0
      · exact hψW
      · have hs0 : 0 < (s : ℝ) := lt_of_le_of_ne s.2.1 (Ne.symm h0)
        refine hR _ ?_
        rw [le_div_iff₀ hs0]
        have h1 : (s : ℝ) * (|R| + 1) < 1 := by
          rw [show δ = 1 / (|R| + 1) from rfl, lt_div_iff₀ (by positivity)] at hs
          linarith
        nlinarith [le_abs_self R, abs_nonneg R]
    · have hev : p =ᶠ[𝓝 t] fun s ↦ H ((1 - s) / s) := by
        have hopen : IsOpen {s : unitInterval | (s : ℝ) ≠ 0} :=
          isOpen_ne_fun continuous_subtype_val continuous_const
        filter_upwards [hopen.mem_nhds ht] with s hs
        simp only [p, if_neg hs]
      refine ContinuousAt.congr ?_ hev.symm
      refine hH.continuousAt.comp (ContinuousAt.div ?_ continuous_subtype_val.continuousAt ht)
      exact (continuous_const.sub continuous_subtype_val).continuousAt
  refine ⟨⟨⟨p, hcont⟩, if_pos rfl, ?_⟩⟩
  show p 1 = H 0
  simp [p]

/-- **Un point au-dessus de `b` est relié à `proj⁻¹(V)`**, si `u` sépare la fibre de `b`. -/
theorem exists_joined_preimage_V (e : GoodElt n A) (ψ : Pts A)
    (hsep : ∀ φ φ' : Pts A, proj (n := n) φ = proj (n := n) ψ →
      proj (n := n) φ' = proj (n := n) ψ → φ e.u = φ' e.u → φ = φ') :
    ∃ φ ∈ (proj ⁻¹' e.V : Set (Pts A)), Joined ψ φ := by
  classical
  set b := proj (n := n) ψ with hb
  have hD : e.c * e.δ ≠ 0 := mul_ne_zero e.hc e.hδ
  obtain ⟨w, hw⟩ := exists_eval_ne_zero hD
  set v := w - b
  have hfin := finite_setOf_eval_lineP_eq_zero (D := e.c * e.δ) (a := b) (v := v) (t := 1)
    (by simpa [v] using hw)
  obtain ⟨ε, hε, hεZ⟩ := exists_ball_inter_finset hfin.toFinset 0
  let σr : ℝ → ℝ := fun r ↦ ε / 2 / (1 + Real.exp r)
  have hσpos : ∀ r, 0 < σr r := fun r ↦ by positivity
  have hσlt : ∀ r, σr r < ε := fun r ↦ by
    have : σr r ≤ ε / 2 := div_le_self (by positivity) (by linarith [Real.exp_pos r])
    linarith
  have hσc : Continuous σr :=
    continuous_const.div (continuous_const.add Real.continuous_exp) fun r ↦ by positivity
  let γ : ℝ → Fin n → ℂ := fun r ↦ b + ((σr r : ℝ) : ℂ) • v
  have hγc : Continuous γ :=
    continuous_const.add ((Complex.continuous_ofReal.comp hσc).smul continuous_const)
  have hγV : ∀ r, γ r ∈ e.V := fun r ↦ by
    have hs : ((σr r : ℝ) : ℂ) ∈ ball (0 : ℂ) ε := by
      rw [mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (hσpos r)]
      exact hσlt r
    have hne : ((σr r : ℝ) : ℂ) ≠ 0 := by exact_mod_cast (hσpos r).ne'
    have hZ : ((σr r : ℝ) : ℂ) ∉ hfin.toFinset := fun h ↦ hne (hεZ _ hs h)
    simpa [GoodElt.V, γ] using hZ
  have hγb : Tendsto γ atTop (𝓝 b) := by
    have hσ0 : Tendsto σr atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop (tendsto_atTop_add_const_left _ _ Real.tendsto_exp_atTop)
    have h1 := (Complex.continuous_ofReal.tendsto 0).comp hσ0
    have h2 := (tendsto_const_nhds (x := b)).add (h1.smul_const v)
    simpa [γ] using h2
  -- les relèvements depuis la fibre de `γ 0`
  set S₀ := fib (A := A) (γ 0) with hS₀
  have hlift : ∀ x ∈ S₀, ∃ F : ℝ → Pts A, Continuous F ∧ F 0 = x ∧ ∀ r, proj (F r) = γ r :=
    fun x hx ↦ exists_lift e γ hγc hγV x (mem_fib.mp hx)
  choose! Fx hFc hF0 hFp using hlift
  have hlim : ∀ x ∈ S₀, ∃ φ : Pts A, proj φ = b ∧ Tendsto (Fx x) atTop (𝓝 φ) := fun x hx ↦
    tendsto_lift e hsep γ hγb (Fx x) (hFc x hx) (hFp x hx)
  choose! L hLp hL using hlim
  have hinj : ∀ r, Set.InjOn (fun x ↦ Fx x r) (S₀ : Set (Pts A)) := fun r x hx y hy h ↦ by
    have := lift_unique e γ hγV (Fx x) (Fx y) (hFc x hx) (hFc y hy) (hFp x hx) (hFp y hy) r h
    rw [← hF0 x hx, ← hF0 y hy, this]
  have himg : ∀ r, S₀.image (fun x ↦ Fx x r) = fib (γ r) := fun r ↦ by
    refine Finset.eq_of_subset_of_card_le (fun φ hφ ↦ ?_) ?_
    · obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hφ
      exact mem_fib.mpr (hFp x hx r)
    · rw [Finset.card_image_of_injOn (hinj r), card_fib e (hγV r), hS₀, card_fib e (hγV 0)]
  have hprod : ∀ r, (specz e.F (γ r)).eval (ψ e.u) = ∏ x ∈ S₀, (ψ e.u - Fx x r e.u) := by
    intro r
    rw [← prod_rootsF e (hγV r), eval_prod, ← image_fib e (hγV r),
      Finset.prod_image (injOn_fib e (hγV r)), ← himg r, Finset.prod_image (hinj r)]
    simp
  -- l'une des limites est `ψ`
  have hex : ∃ x ∈ S₀, L x = ψ := by
    by_contra hne
    push Not at hne
    have hδ : ∀ x ∈ S₀, 0 < ‖ψ e.u - L x e.u‖ := fun x hx ↦ norm_pos_iff.mpr
      (sub_ne_zero.mpr fun h ↦ hne x hx (hsep _ _ (hLp x hx) rfl h.symm))
    have hev : ∀ᶠ r in atTop, ∀ x ∈ S₀, ‖ψ e.u - L x e.u‖ / 2 ≤ ‖ψ e.u - Fx x r e.u‖ :=
      (Finset.eventually_all _).mpr fun x hx ↦ by
        have ht := ((continuous_apply_pts e.u).tendsto _).comp (hL x hx)
        filter_upwards [ht.eventually (Metric.ball_mem_nhds _ (half_pos (hδ x hx)))] with r hr
        rw [Function.comp_apply, dist_eq_norm] at hr
        have := norm_sub_le_norm_sub_add_norm_sub (ψ e.u) (Fx x r e.u) (L x e.u)
        linarith
    set c := ∏ x ∈ S₀, ‖ψ e.u - L x e.u‖ / 2
    have hc : 0 < c := Finset.prod_pos fun x hx ↦ half_pos (hδ x hx)
    have hto : Tendsto (fun r ↦ (specz e.F (γ r)).eval (ψ e.u)) atTop (𝓝 0) := by
      have h1 : Tendsto (fun r ↦ Pf e.F (γ r, ψ e.u)) atTop (𝓝 (Pf e.F (b, ψ e.u))) :=
        ((contDiff_Pf e.F).continuous.tendsto _).comp (hγb.prodMk_nhds tendsto_const_nhds)
      have h0 : Pf e.F (b, ψ e.u) = 0 := isRoot_apply_u e ψ
      rw [h0] at h1
      exact h1
    obtain ⟨r, hr1, hr2⟩ := (hev.and (hto.eventually (Metric.ball_mem_nhds _ hc))).exists
    rw [dist_zero_right, hprod r, norm_prod] at hr2
    have : c ≤ ∏ x ∈ S₀, ‖ψ e.u - Fx x r e.u‖ :=
      Finset.prod_le_prod (fun x hx ↦ (half_pos (hδ x hx)).le) hr1
    linarith
  obtain ⟨x₀, hx₀, hLx₀⟩ := hex
  refine ⟨x₀, ?_, ?_⟩
  · rw [Set.mem_preimage, mem_fib.mp hx₀]
    exact hγV 0
  · have := joined_of_tendsto (Fx x₀) (hFc x₀ hx₀) (hLx₀ ▸ hL x₀ hx₀)
    rwa [hF0 x₀ hx₀] at this

end FiniteFields.Betti.Connected

end

/-! ## Recopié de `Bridge/Betti/Connected/Exists.lean` -/

section

/-!
# Existence d'un bon élément séparant une fibre (A6)

Soit `b ∈ ℂⁿ`. Il existe un bon élément `u = Σ cⁱ bᵢ` (les `bᵢ` engendrent `A` sur `S`) tel que
`u` sépare les points de la fibre au-dessus de `b`. Pour presque tout `c ∈ ℂ` :
* `u` est primitif pour `Frac A / Frac S`, car les plongements dans une clôture algébrique
  prennent des valeurs distinctes en `u` (`primitive_element_iff_algHom_eq_of_eval'`) ;
* `u` sépare la fibre, finie, au-dessus de `b`.

Le conducteur s'obtient en chassant les dénominateurs des écritures `bᵢ = qᵢ(u)`, et le
discriminant en chassant ceux d'une relation de Bézout entre `F` et `F'` (caractéristique 0).
-/

open Polynomial

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

attribute [local instance low] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra

variable {n : ℕ} {A : Type} [CommRing A] [IsDomain A] [Algebra ℂ A] [Algebra (Sn n) A]
  [IsScalarTower ℂ (Sn n) A] [Module.Finite (Sn n) A] [Module.IsTorsionFree (Sn n) A]

local notation "KS" => FractionRing (Sn n)
local notation "LA" => FractionRing A

/-- Raccourci d'instance : trouvée par `FractionRing.liftAlgebra` (priorité basse, pour ne pas
ralentir `Algebra KS Ω`), chaque `Algebra KS LA` coûtait près d'une seconde. -/
noncomputable local instance (priority := high) algebraKSLA : Algebra KS LA := FractionRing.liftAlgebra (Sn n) LA

local instance (priority := high) isScalarTowerKSLA : IsScalarTower (Sn n) KS LA :=
  FractionRing.isScalarTower_liftAlgebra (Sn n) LA

/-- Deux plongements qui coïncident sur une famille `S`-génératrice de `A` sont égaux. -/
theorem algHom_eq_of_gens {Ω : Type} [Field Ω] [Algebra KS Ω] {r : ℕ} (b : Fin r → A)
    (hb : Submodule.span (Sn n) (Set.range b) = ⊤) (σ τ : LA →ₐ[KS] Ω)
    (h : ∀ i, σ (algebraMap A LA (b i)) = τ (algebraMap A LA (b i))) : σ = τ := by
  have hA : ∀ a : A, σ (algebraMap A LA a) = τ (algebraMap A LA a) := fun a ↦ by
    have ha : a ∈ Submodule.span (Sn n) (Set.range b) := hb ▸ Submodule.mem_top
    induction ha using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      exact h i
    | zero => simp
    | add x y _ _ hx hy => simp only [map_add, hx, hy]
    | smul t x _ hx =>
      rw [Algebra.smul_def, map_mul, map_mul, map_mul, hx, ← IsScalarTower.algebraMap_apply,
        IsScalarTower.algebraMap_apply (Sn n) KS LA, AlgHom.commutes, AlgHom.commutes]
  have : σ.toRingHom = τ.toRingHom :=
    IsLocalization.ringHom_ext (nonZeroDivisors A) (RingHom.ext hA)
  exact AlgHom.ext fun x ↦ congrArg (fun f : LA →+* Ω ↦ f x) this
/-- `u_c = Σ cⁱ bᵢ`. -/
noncomputable def ucomb {r : ℕ} (b : Fin r → A) (c : ℂ) : A := ∑ i : Fin r, (c ^ (i : ℕ)) • b i

/-- Le polynôme `Σ xᵢ Tⁱ`. -/
noncomputable def coeffPoly {R : Type*} [CommRing R] {r : ℕ} (x : Fin r → R) : R[X] :=
  ∑ i : Fin r, C (x i) * X ^ (i : ℕ)

theorem eval_coeffPoly {R : Type*} [CommRing R] {r : ℕ} (x : Fin r → R) (t : R) :
    (coeffPoly x).eval t = ∑ i, x i * t ^ (i : ℕ) := by
  simp [coeffPoly, eval_finsetSum]

theorem coeffPoly_ne_zero {R : Type*} [CommRing R] {r : ℕ} (x : Fin r → R) (h : ∃ i, x i ≠ 0) :
    coeffPoly x ≠ 0 := by
  obtain ⟨i, hi⟩ := h
  intro h0
  have := congrArg (fun p ↦ p.coeff i) h0
  simp only [coeffPoly, finsetSum_coeff, coeff_C_mul_X_pow, coeff_zero, Fin.val_inj,
    Finset.sum_ite_eq, Finset.mem_univ, if_true] at this
  exact hi this

theorem apply_ucomb {r : ℕ} (b : Fin r → A) (c : ℂ) (φ : Pts A) :
    φ (ucomb b c) = (coeffPoly fun i ↦ φ (b i)).eval c := by
  simp [ucomb, eval_coeffPoly, mul_comm]

/-- **Existence d'un bon élément séparant la fibre au-dessus de `bpt`.** -/
theorem exists_goodElt (bpt : Fin n → ℂ) : ∃ e : GoodElt n A,
    ∀ φ ψ : Pts A, proj φ = bpt → proj ψ = bpt → φ e.u = ψ e.u → φ = ψ := by
  classical
  obtain ⟨r, b, hb⟩ := Module.Finite.exists_fin (R := Sn n) (M := A)
  let Ω := AlgebraicClosure KS
  let ι : ℂ →+* Ω := (algebraMap KS Ω).comp ((algebraMap (Sn n) KS).comp (algebraMap ℂ (Sn n)))
  have hι : Function.Injective ι := ι.injective
  let b' : Fin r → LA := fun i ↦ algebraMap A LA (b i)
  have hσS : ∀ (σ : LA →ₐ[KS] Ω) (s : Sn n),
      σ (algebraMap A LA (algebraMap (Sn n) A s)) = algebraMap KS Ω (algebraMap (Sn n) KS s) :=
    fun σ s ↦ by
      rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply (Sn n) KS LA,
        AlgHom.commutes]
  have hσu : ∀ (σ : LA →ₐ[KS] Ω) (c : ℂ),
      σ (algebraMap A LA (ucomb b c)) = (coeffPoly fun i ↦ σ (b' i)).eval (ι c) := fun σ c ↦ by
    simp only [ucomb, map_sum, eval_coeffPoly]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [Algebra.smul_def, IsScalarTower.algebraMap_apply ℂ (Sn n) A, map_mul, map_mul, hσS,
      mul_comm]
    simp only [map_pow, ι, RingHom.comp_apply, b']
  -- les mauvaises valeurs de `c`
  let bad1 : Set ℂ := ⋃ στ : {στ : (LA →ₐ[KS] Ω) × (LA →ₐ[KS] Ω) // στ.1 ≠ στ.2},
    {c | (coeffPoly fun i ↦ στ.1.1 (b' i) - στ.1.2 (b' i)).eval (ι c) = 0}
  have hbad1 : bad1.Finite := by
    refine Set.finite_iUnion fun στ ↦ ?_
    have hne : coeffPoly (fun i ↦ στ.1.1 (b' i) - στ.1.2 (b' i)) ≠ 0 := by
      refine coeffPoly_ne_zero _ ?_
      by_contra h
      push Not at h
      exact στ.2 (algHom_eq_of_gens b hb _ _ fun i ↦ sub_eq_zero.mp (h i))
    exact (Polynomial.finite_setOfPred_isRoot hne).preimage hι.injOn
  let Φ := {φ : Pts A | proj φ = bpt}
  have hΦ : Φ.Finite := finite_fiber bpt
  have : Finite Φ := hΦ.to_subtype
  let bad2 : Set ℂ := ⋃ p : {p : Φ × Φ // p.1 ≠ p.2},
    {c | (coeffPoly fun i ↦ p.1.1.1 (b i) - p.1.2.1 (b i)).eval c = 0}
  have hbad2 : bad2.Finite := by
    refine Set.finite_iUnion fun p ↦ ?_
    have hne : coeffPoly (fun i ↦ p.1.1.1 (b i) - p.1.2.1 (b i)) ≠ 0 := by
      refine coeffPoly_ne_zero _ ?_
      by_contra h
      push Not at h
      refine p.2 (Subtype.ext (eq_of_span b hb _ _ ?_ fun i ↦ sub_eq_zero.mp (h i)))
      exact p.1.1.2.trans p.1.2.2.symm
    exact Polynomial.finite_setOfPred_isRoot hne
  obtain ⟨c, hc⟩ := (hbad1.union hbad2).infinite_compl.nonempty
  simp only [Set.mem_compl_iff, Set.mem_union, not_or] at hc
  set u := ucomb b c with hu
  -- `u` est primitif
  have hprim : IntermediateField.adjoin KS {algebraMap A LA u} = ⊤ := by
    rw [Field.primitive_element_iff_algHom_eq_of_eval' KS Ω (fun x ↦ IsAlgClosed.splits _)]
    intro σ τ hστ
    by_contra hne
    refine hc.1 (Set.mem_iUnion.mpr ⟨⟨(σ, τ), hne⟩, ?_⟩)
    have h1 := hσu σ c
    have h2 := hσu τ c
    simp only [Set.mem_ofPred_eq, eval_coeffPoly, sub_mul, Finset.sum_sub_distrib]
    rw [eval_coeffPoly] at h1 h2
    rw [← h1, ← h2]
    exact sub_eq_zero.mpr hστ
  have hintS : IsIntegral (Sn n) u := Algebra.IsIntegral.isIntegral u
  have hint : IsIntegral KS (algebraMap A LA u) := Algebra.IsIntegral.isIntegral _
  have hsmulA : ∀ (s : Sn n) (a : A), s • algebraMap A LA a = algebraMap A LA (s • a) :=
    fun s a ↦ by
      rw [Algebra.smul_def, Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply]
  -- conducteur
  have hmem : ∀ y : LA, ∃ q : KS[X], aeval (algebraMap A LA u) q = y := fun y ↦ by
    have hy : y ∈ (IntermediateField.adjoin KS {algebraMap A LA u}).toSubalgebra := by
      rw [hprim]; trivial
    rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hint.isAlgebraic,
      Algebra.adjoin_singleton_eq_range_aeval] at hy
    exact hy
  have hcond : ∀ i, ∃ s : Sn n, s ≠ 0 ∧ s • b i ∈ Algebra.adjoin (Sn n) {u} := fun i ↦ by
    obtain ⟨q, hq⟩ := hmem (b' i)
    obtain ⟨s, hs, hsq⟩ :=
      IsLocalization.integerNormalization_spec (nonZeroDivisors (Sn n)) q
    refine ⟨s, nonZeroDivisors.ne_zero hs, ?_⟩
    have key : aeval u (IsLocalization.integerNormalization (nonZeroDivisors (Sn n)) q) =
        s • b i := by
      apply IsFractionRing.injective A LA
      rw [← aeval_algebraMap_apply, ← aeval_map_algebraMap KS, hsq, Algebra.smul_def, map_mul,
        hq, ← hsmulA, Algebra.smul_def, Polynomial.algebraMap_apply, aeval_C,
        ← IsScalarTower.algebraMap_apply]
    rw [← key]
    exact Polynomial.aeval_mem_adjoin_singleton _ _
  choose sc hsc0 hsc using hcond
  let cc : Sn n := ∏ i, sc i
  have hcc0 : cc ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ ↦ hsc0 i
  have hconductor : ∀ a : A, cc • a ∈ Algebra.adjoin (Sn n) {u} := fun a ↦ by
    have ha : a ∈ Submodule.span (Sn n) (Set.range b) := hb ▸ Submodule.mem_top
    induction ha using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨i, rfl⟩ := hx
      rw [show cc = (∏ j ∈ Finset.univ.erase i, sc j) * sc i from
        (Finset.prod_erase_mul _ _ (Finset.mem_univ i)).symm, mul_smul]
      exact Subalgebra.smul_mem _ (hsc i) _
    | zero => rw [smul_zero]; exact Subalgebra.zero_mem _
    | add x y _ _ hx hy => rw [smul_add]; exact Subalgebra.add_mem _ hx hy
    | smul t x _ hx => rw [smul_comm]; exact Subalgebra.smul_mem _ hx _
  -- discriminant
  set F := minpoly (Sn n) u with hF
  have hFK : minpoly KS (algebraMap A LA u) = F.map (algebraMap (Sn n) KS) :=
    minpoly.isIntegrallyClosed_eq_field_fractions KS LA hintS
  have hsep : (minpoly KS (algebraMap A LA u)).Separable :=
    Algebra.IsSeparable.isSeparable KS _
  obtain ⟨α, β, hαβ⟩ := hsep
  obtain ⟨s₁, hs₁, h₁⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors (Sn n)) α
  obtain ⟨s₂, hs₂, h₂⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors (Sn n)) β
  set α' := IsLocalization.integerNormalization (nonZeroDivisors (Sn n)) α
  set β' := IsLocalization.integerNormalization (nonZeroDivisors (Sn n)) β
  have hbez : (C s₂ * α') * F + (C s₁ * β') * derivative F = C (s₁ * s₂) := by
    apply Polynomial.map_injective (algebraMap (Sn n) KS) (IsFractionRing.injective _ _)
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, ← Polynomial.derivative_map]
    rw [h₁, h₂, ← hFK, Algebra.smul_def, Algebra.smul_def, Polynomial.algebraMap_apply,
      Polynomial.algebraMap_apply, map_mul, C_mul]
    linear_combination (C (algebraMap (Sn n) KS s₁) * C (algebraMap (Sn n) KS s₂)) * hαβ
  have hδ0 : s₁ * s₂ ≠ 0 := mul_ne_zero (nonZeroDivisors.ne_zero hs₁) (nonZeroDivisors.ne_zero hs₂)
  refine ⟨⟨u, cc, s₁ * s₂, hcc0, hδ0, hconductor, ⟨_, _, hbez⟩⟩, fun φ ψ hφ hψ h ↦ ?_⟩
  by_contra hne
  have hne' : (⟨φ, hφ⟩ : Φ) ≠ ⟨ψ, hψ⟩ := fun h' ↦ hne (congrArg Subtype.val h')
  refine hc.2 (Set.mem_iUnion.mpr ⟨⟨(⟨φ, hφ⟩, ⟨ψ, hψ⟩), hne'⟩, ?_⟩)
  have h1 := apply_ucomb b c φ
  have h2 := apply_ucomb b c ψ
  simp only [Set.mem_ofPred_eq, eval_coeffPoly, sub_mul, Finset.sum_sub_distrib]
  rw [eval_coeffPoly] at h1 h2
  simp only [mul_comm] at h1 h2 ⊢
  rw [← h1, ← h2]
  exact sub_eq_zero.mpr h

end FiniteFields.Betti.Connected

end

