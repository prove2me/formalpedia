-- Source module: Solutions.KFMU4
/-!
# KFM U4: `lg n` from the ruler `2^n` in linear time

Setup step 0 needs `b = lg n = max (clog 2 n) 1` from the input. The IL `read` leaves the ruler
`2^n` (not `n`), and a bit-length procedure on an `n`-bit number costs `Θ(n log n)`, which is over
budget. Instead `lgLoop` splits `2^n` by the rulers `2^{2^0}, 2^{2^1}, …` (each squared by one `shl`),
so the `k`-th step costs `O(2^k)` and the loop `O(n)`:

* state `k`: `gA = 2^{n+1−2^k}` (or `0` once `2^k > n+1`), `gR = 2^{2^k}`, `gP = 2^{2^{k−1}}`, `gJ = k`;
* it stops at `J = Nat.size (n+1)` (`2^{J−1} ≤ n+1 < 2^J`).

**`lgP_runs`**: `lgP` (init, loop, one exact test `n ≤ 2^{J−1}` by a split of a copy of `2^n`)
pushes `lg n` on `gJ` for `n ≥ 3`, everything else restored, cost `≤ 10^6 (n + 1)`.

Stacks (KFM range): `gA = 20`, `gR = 21`, `gP = 22`, `gJ = 23`, `gT = 34`, input copy on `gN = 35`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFM

open IntMul KFC KFB KFT

abbrev gA : Fin HS := 20
abbrev gR : Fin HS := 21
abbrev gP : Fin HS := 22
abbrev gJ : Fin HS := 23
abbrev gT : Fin HS := 34
abbrev gN : Fin HS := 35

/-! ## Arithmetic -/

/-- The remaining power after `k` splits. -/
def aK (n k : ℕ) : ℕ := if 2 ^ k ≤ n + 1 then 2 ^ (n + 1 - 2 ^ k) else 0

/-- The previous ruler exponent's power. -/
def prvK (k : ℕ) : ℕ := if k = 0 then 0 else 2 ^ (2 ^ (k - 1))

/-! ## One step -/

section IL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

def lgB : IStmt HS P :=
  .seq (.op (.drop gP)) (.seq (.op (.dup gR gP)) (.seq (.op (.split gA gR gT)) (.seq (.op (.drop gT))
    (.seq (.op (.dup gR gT)) (.seq (.op (.shl gR gT)) (.seq (.op (.drop gT)) (.seq (.op (.const gT 1))
      (.op (.add gJ gT gJ)))))))))

/-- The loop state. -/
def lgS (s : IState HS) (LA LR LP LJ : List Item) (n k : ℕ) : IState HS :=
  (((s.upd gA (.int (aK n k : ℤ) :: LA)).upd gR (.int ((2 : ℤ) ^ (2 ^ k)) :: LR)).upd gP
    (.int (prvK k : ℤ) :: LP)).upd gJ (.int (k : ℤ) :: LJ)

def cLgB (k : ℕ) : ℕ := 10 ^ 4 * (2 ^ k + k + 2)

/-! ## The loop -/

def isPosC (c : Cls) : Bool := c == .pos

def lgLoop : IStmt HS P := .loop gA isPosC lgB

/-! ## The exact test and the full procedure -/

def lgPost : IStmt HS P :=
  .seq (.seq (.op (.drop gA)) (.op (.drop gR))) (.seq (.seq (.op (.const gT 2)) (.seq (.op (.shl gP gT))
    (.op (.drop gT)))) (.seq (.op (.dup gN gA)) (.seq (.op (.split gA gP gT))
    (.seq (.op (.drop gT)) (.seq (.ite gA isPosC .skip (.seq (.op (.const gT (-1)))
      (.op (.add gJ gT gJ)))) (.seq (.op (.drop gA)) (.op (.drop gP))))))))

def lgInit : IStmt HS P :=
  .seq (.op (.dup gN gA)) (.seq (.op (.const gR 2)) (.seq (.op (.const gP 0)) (.op (.const gJ 0))))

/-- **`lg n` from the ruler `2^n` on `gN`.** -/
def lgP : IStmt HS P := .seq lgInit (.seq lgLoop lgPost)

/-- The value left by the test. -/
def lgV (n : ℕ) : ℕ := if 2 ^ (Nat.size (n + 1) - 1) + 1 ≤ n then Nat.size (n + 1) else Nat.size (n + 1) - 1

end IL

end NLogN.KFM

end

