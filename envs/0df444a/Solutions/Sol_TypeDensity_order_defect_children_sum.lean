theorem solution (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (A : Type) [CommRing A] [Algebra O A] [Module.Finite O A] (n : ℕ) (B : Fin n → Type)
    [∀ j, CommRing (B j)] [∀ j, Algebra O (B j)] [∀ j, Module.Finite O (B j)]
    [∀ j, Module.Free O (B j)] (ψ : A →ₐ[O] ∀ j, B j) (hinj : Function.Injective ψ) (ℓ : ℕ)
    (hℓ : Module.length O ((∀ j, B j) ⧸ LinearMap.range ψ.toLinearMap) = ℓ) :
    TypeDensity.orderDefect O A = ∑ j, TypeDensity.orderDefect O (B j) + ℓ := by
  have h := TypeDensity.baseChange_bijective_of_finite_cokernel O A (∀ j, B j) ψ.toLinearMap hinj ℓ hℓ
  have hbij : Function.Bijective
      (Algebra.TensorProduct.map (AlgHom.id (TypeDensity.BaseField O) (TypeDensity.BaseField O)) ψ) := by
    have : ⇑(Algebra.TensorProduct.map (AlgHom.id (TypeDensity.BaseField O) (TypeDensity.BaseField O)) ψ) =
      ⇑(LinearMap.baseChange (TypeDensity.BaseField O) ψ.toLinearMap) := by
      funext x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a b => simp
      | add x y hx hy => simp only [map_add, hx, hy]
    exact this ▸ h
  rw [TypeDensity.order_defect_transport O A (∀ j, B j) ψ hbij ℓ hℓ,
    TypeDensity.order_defect_pi]
