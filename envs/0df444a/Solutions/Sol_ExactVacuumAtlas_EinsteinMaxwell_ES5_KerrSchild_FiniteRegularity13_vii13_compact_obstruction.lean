theorem cda_le {g : ℝ → ℝ} {x : ℝ} {m n : ℕ} (hg : ContDiffAt ℝ n g x) (h : m ≤ n) :
    ContDiffAt ℝ m g x :=
  hg.of_le (by exact_mod_cast h)

/-- Finite iterated derivatives: `C^(n+k) g` at `x` gives `C^n (iteratedDeriv k g)` at `x`. -/
theorem cda_iteratedDeriv_fin {g : ℝ → ℝ} {x : ℝ} :
    ∀ (k n : ℕ), ContDiffAt ℝ ((n + k : ℕ) : WithTop ℕ∞) g x →
      ContDiffAt ℝ n (iteratedDeriv k g) x
  | 0, n, hg => by simpa using hg
  | k + 1, n, hg => by
    rw [iteratedDeriv_succ]
    have hg' : ContDiffAt ℝ (((n + 1) + k : ℕ) : WithTop ℕ∞) g x := by
      rwa [show n + 1 + k = n + (k + 1) by omega]
    exact (cda_iteratedDeriv_fin k (n + 1) hg').derivWithin (by push_cast; exact le_rfl)

/-! ## Finite one-sided extraction -/

/-- If `g` is `C^n` at `0` and vanishes on `(0, ε)`, then every `iteratedDeriv k g 0`, `k ≤ n`,
vanishes (derivatives vanish on the open interval, then continuity at `0` from the right).
Only finitely many orders are used; `g 0 = 0` alone would not kill the higher derivatives. -/
