namespace NLogN.KFY

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

theorem cdE_facts (rT rS : Fin HS) (hT : rT.val < 56) (hS : rS.val < 56) (st : IState HS)
    (s t Q : ℕ) (LT LS : List Item) (hst : s ≤ t) (eT : st.G rT = .int (t : ℤ) :: LT)
    (eS : st.G rS = .int (s : ℤ) :: LS) (hQ : zsz ((2 * t : ℕ) : ℤ) ≤ Q) :
    (cdE rT rS).eval st = ((2 * (t - s) : ℕ) : ℤ) ∧ (cdE rT rS).Clean ∧ (cdE rT rS).ok st ∧
      (cdE rT rS).Lin ∧ (cdE rT rS).Bnd st Q ∧ (cdE rT rS).size = 8 := by
  have hQs : zsz ((2 * s : ℕ) : ℤ) ≤ Q := le_trans (zsz_natCast_le' (by omega)) hQ
  obtain ⟨a1, a2, a3, a4, -⟩ := cnt2_facts' rT (by omega) st t LT Q eT hQ
  obtain ⟨b1, b2, b3, b4, -⟩ := cnt2_facts' rS (by omega) st s LS Q eS hQs
  have ev : (cdE rT rS).eval st = ((2 * (t - s) : ℕ) : ℤ) := by
    simp only [cdE, Ex.eval]; rw [a1, b1]; push_cast [Nat.cast_sub hst]; ring
  refine ⟨ev, ?_, ⟨a3, b3⟩, ⟨cnt2_lin rT, cnt2_lin rS⟩, ⟨a4, b4, ?_⟩, rfl⟩
  · intro j hj
    simp only [cdE, Ex.regs, List.mem_append] at hj
    rcases hj with hj | hj
    · exact a2 j hj
    · exact b2 j hj
  · have : (cnt2 rT).eval st + (Ex.neg (cnt2 rS)).eval st = ((2 * (t - s) : ℕ) : ℤ) := ev
    rw [this]; exact le_trans (zsz_natCast_le' (by omega)) hQ

theorem gints_zeros (k : ℕ) : gints (List.replicate k ((0 : ℤ), (0 : ℤ))) =
    ints (List.replicate (2 * k) 0) := by
  induction k with
  | zero => rfl
  | succ k ih =>
    rw [List.replicate_succ, show 2 * (k + 1) = 2 * k + 1 + 1 by ring, List.replicate_succ,
      List.replicate_succ]
    simp only [gints, ints, List.flatMap_cons, List.map_cons] at ih ⊢
    rw [ih]
    rfl

section core

variable {M : MulSpec} {Ctx : IState HS → Prop} {B : ℕ}

end core

theorem pushZ_states {X C : Fin HS} (hXC : X ≠ C) (n : Ex HS) (s : IState HS) (N : ℕ)
    (hn : n.eval s = N) :
    RepStates C n (.push X (.lit 0)) s
      (fun j => s.upd X (ints (List.replicate j 0) ++ s.G X)) where
  nonneg := by rw [hn]; positivity
  hw := by simp [RS.writes, hXC.symm]
  h0 := by simp [ints]
  hG := fun k => by simp [hXC.symm]
  step := by
    intro k hk
    apply IState.ext' _ (by simp [withCtr, RS.run]) (by simp [withCtr, RS.run])
    intro x
    simp only [withCtr, RS.run, IState.upd_G, Ex.eval]
    by_cases h1 : x = X
    · subst h1; simp [hXC, List.replicate_succ, ints]
    · by_cases h2 : x = C
      · subst h2; simp [hXC.symm]
      · simp [h1, h2]

theorem pushZ_spec {X C : Fin HS} (hXC : X ≠ C) (hX5 : X.val < 56) (hC5 : C.val < 56) (n : Ex HS)
    (hnc : n.Clean) (s : IState HS) (N : ℕ) (hno : n.ok s) (hn : n.eval s = N) :
    (pushZ X C n).ok s ∧ (pushZ X C n).run s = s.upd X (ints (List.replicate N 0) ++ s.G X) := by
  have H := pushZ_states hXC n s N hn
  refine ⟨H.ok hC5 hnc hno ?_, ?_⟩
  · intro k hk
    exact ⟨hX5, fun j hj => by simp [Ex.regs] at hj, trivial⟩
  · rw [pushZ, H.run, hn, Int.toNat_natCast]

theorem pushZ_cost {X C : Fin HS} (hXC : X ≠ C) (n : Ex HS) (s : IState HS) (N : ℕ)
    (hn : n.eval s = N) (B : ℕ) (hnl : n.Lin) (hnb : n.Bnd s B) :
    (pushZ X C n).cost s ≤ (n.size + 1) * 2000 * (B + 2) + N * (200 + 8000 * (B + 2) + 30) + 32 := by
  have H := pushZ_states hXC n s N hn
  have := H.cost_le_lin B 200 hnl hnb (fun k hk => by
    simp [RS.cost, Ex.cost, Ex.eval, zsz_zero, moveCost])
  rw [hn, Int.toNat_natCast] at this
  exact this

