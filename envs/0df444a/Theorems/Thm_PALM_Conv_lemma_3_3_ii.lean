-- title:
--   Lemma 3.3 (ii) — ∑ ‖zᵏ⁺¹ − zᵏ‖² < ∞ for a PALM sequence, hence ‖zᵏ⁺¹ − zᵏ‖ → 0
-- statement:
--   Under the hypotheses of Lemma 3.3 (Assumptions A and B, $\gamma_1,\gamma_2>1$, $z^k=(x^k,y^k)$ generated by PALM),
--   $$\sum_{k=1}^\infty\|x^{k+1}-x^k\|^2+\|y^{k+1}-y^k\|^2=\sum_{k=1}^\infty\|z^{k+1}-z^k\|^2<\infty,$$
--   and hence $\lim_{k\to\infty}\|z^{k+1}-z^k\|=0$.
--
--   Square-summability of the steps is what makes the limit point set of a bounded PALM sequence connected and contained in the critical set.
--
--   **Formalization Note** The statement has three conjuncts: the termwise identity $\|x^{k+1}-x^k\|^2+\|y^{k+1}-y^k\|^2=\|z^{k+1}-z^k\|^2$ (the Euclidean product norm), summability of $\|z^{k+1}-z^k\|^2$ (the starting index of the series is irrelevant), and convergence of $\|z^{k+1}-z^k\|$ to $0$. No boundedness of the sequence is assumed, as on the page.
-- source:
--   Bolte, Sabach, Teboulle, Proximal alternating linearized minimization for nonconvex and nonsmooth problems, Math. Program. 146 (2014), doi:10.1007/s10107-013-0701-9 (source: author version), p. 14, Lemma 3.3 (ii), (3.14)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_ADMMKL_KLProperty
import Definitions.Def_ProxAltMin_Conv_Setting
import Definitions.Def_PALM_Conv_Setting
open NonconvexSplitting.Shared NonconvexSplitting.ADMMKL ProxAltMin.Conv PALM.Conv
open Filter Topology

namespace PALM.Conv

/-- Lemma 3.3 (ii), p. 14: under Assumptions A and B, along a PALM sequence
`‖xᵏ⁺¹ - xᵏ‖² + ‖yᵏ⁺¹ - yᵏ‖² = ‖zᵏ⁺¹ - zᵏ‖²`, the series `∑ ‖zᵏ⁺¹ - zᵏ‖²` converges (3.14),
and hence `‖zᵏ⁺¹ - zᵏ‖ → 0`. -/
theorem lemma_3_3_ii {n m : ℕ} (f : EuclideanSpace ℝ (Fin n) → EReal) (H : Z n m → ℝ)
    (g : EuclideanSpace ℝ (Fin m) → EReal)
    (L₁ : EuclideanSpace ℝ (Fin m) → ℝ) (L₂ : EuclideanSpace ℝ (Fin n) → ℝ)
    (γ₁ γ₂ lam1m lam1p lam2m lam2p : ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y : ℕ → EuclideanSpace ℝ (Fin m))
    (hA : AssumptionH f H g) (hB : AssumptionB f H g L₁ L₂ x y lam1m lam1p lam2m lam2p)
    (hγ₁ : 1 < γ₁) (hγ₂ : 1 < γ₂) (hrun : IsPALMRun f H g L₁ L₂ γ₁ γ₂ x y) :
    (∀ k : ℕ, ‖x (k + 1) - x k‖ ^ 2 + ‖y (k + 1) - y k‖ ^ 2 =
      ‖pt (x (k + 1)) (y (k + 1)) - pt (x k) (y k)‖ ^ 2) ∧
    Summable (fun k : ℕ => ‖pt (x (k + 1)) (y (k + 1)) - pt (x k) (y k)‖ ^ 2) ∧
    Tendsto (fun k : ℕ => ‖pt (x (k + 1)) (y (k + 1)) - pt (x k) (y k)‖) atTop (𝓝 0) := by sorry

end PALM.Conv
