theorem solution
    (p : ℕ) [Fact p.Prime] :
    ∀ M : ℕ, ∀ x ∈ eisensteinTorsionBar p 2 M,
      ∃ M' : ℕ, ∃ y ∈ eisensteinTorsionBar p 2 M', 2 • y = x := by

  letI := heckeModuleBar p
  intro M x hx
  have hp : p.Prime := Fact.out
  haveI : NeZero p := ⟨hp.ne_zero⟩
  have h2P : ((2 : ℕ) : HeckeAlg) ∈ (eisensteinMaximalIdeal p 2) := natCast_mem_eisensteinMaximalIdeal p 2
  have hx' : ∀ a ∈ (eisensteinMaximalIdeal p 2) ^ M, a • x = 0 := fun a ha =>
    (Submodule.mem_torsionBySet_iff _ x).mp hx ⟨a, ha⟩

  haveI hfin : Finite ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) :=
    ModularCurve.heckeTorsion_jZero_finite_of_natCast_mem p _ (2 ^ (M + 1)) (pow_pos two_pos _)
      (Ideal.mem_span_singleton_self _)
  have h2M1 : ((2 ^ (M + 1) : ℕ) : HeckeAlg) ∈ (eisensteinMaximalIdeal p 2) ^ M := by
    rw [pow_succ, Nat.cast_mul, Nat.cast_pow]
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow h2P M)
  have hmemK : ∀ z : JZero p, ((2 ^ (M + 1) : ℕ) : HeckeAlg) • z = 0 → z ∈ (heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) := by
    intro z hz
    rw [mem_heckeTorsion_iff]
    intro s hs
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hs
    have hz0 : r • (0 : JZero p) = 0 := smul_zero r
    rw [mul_smul, hz]
    exact hz0
  have hxK : x ∈ (heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) := hmemK x (hx' _ h2M1)

  have hmono : ∀ a b : ℕ, a ≤ b → (Submodule.torsionBySet HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) (↑((eisensteinMaximalIdeal p 2) ^ a) : Set HeckeAlg)) ≤ (Submodule.torsionBySet HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) (↑((eisensteinMaximalIdeal p 2) ^ b) : Set HeckeAlg)) := by
    intro a b hab v hv
    rw [Submodule.mem_torsionBySet_iff] at hv ⊢
    intro s
    exact hv ⟨s, Ideal.pow_le_pow_right hab s.2⟩
  haveI : Finite (Submodule HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)}))) :=
    Finite.of_injective (fun Q : Submodule HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) => (Q : Set ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})))) SetLike.coe_injective
  obtain ⟨N₀, hN₀⟩ := WellFoundedGT.monotone_chain_condition
    (⟨fun n => (Submodule.torsionBySet HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) (↑((eisensteinMaximalIdeal p 2) ^ n) : Set HeckeAlg)), fun a b hab => hmono a b hab⟩ : ℕ →o Submodule HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})))
  obtain ⟨N, hN₀N, hMN⟩ : ∃ N : ℕ, N₀ ≤ N ∧ M ≤ N := ⟨max N₀ M, le_max_left _ _, le_max_right _ _⟩
  have hstab : (Submodule.torsionBySet HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) (↑((eisensteinMaximalIdeal p 2) ^ (N + 1)) : Set HeckeAlg)) = (Submodule.torsionBySet HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) (↑((eisensteinMaximalIdeal p 2) ^ N) : Set HeckeAlg)) := by
    have h1 : (Submodule.torsionBySet HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) (↑((eisensteinMaximalIdeal p 2) ^ N₀) : Set HeckeAlg)) = (Submodule.torsionBySet HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) (↑((eisensteinMaximalIdeal p 2) ^ (N + 1)) : Set HeckeAlg)) := hN₀ (N + 1) (hN₀N.trans (Nat.le_succ N))
    have h2 : (Submodule.torsionBySet HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) (↑((eisensteinMaximalIdeal p 2) ^ N₀) : Set HeckeAlg)) = (Submodule.torsionBySet HeckeAlg ↥(heckeTorsion (JZero p) (Ideal.span {((2 ^ (M + 1) : ℕ) : HeckeAlg)})) (↑((eisensteinMaximalIdeal p 2) ^ N) : Set HeckeAlg)) := hN₀ N hN₀N
    exact h1.symm.trans h2

