      (_hc : ∀ i,ringChar (O ⧸ Ideal.span {p i}) ≠ 2) (_hpr : ∀ i,lambda^2 ∣ p i-1)
      (pool : Finset ι) (s : Finset (GlobalFirstData ι))
      (w : GlobalFirstData ι → ℂ) (Γ θ K ell B F H : ℝ) (side : Bool)
      (Ψ : O →* ℂ) (m : O),
      0≤Γ → (∀ b∈s,‖w b‖≤Γ) → 0<K → 0<ell → 0<B → 0<F → 0≤H →
