theorem solution : ∀ {f g : Nat → Nat} {a : Real},
  ThreeSum.StageBounds.PowerBound f a →
    ThreeSum.StageBounds.PowerBound g a →
      ThreeSum.StageBounds.PowerBound
        (fun (n : Nat) => @HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) (f n) (g n)) a := by
  exact @ThreeSum.StageBounds.PowerBound.add_same_sourceProof

