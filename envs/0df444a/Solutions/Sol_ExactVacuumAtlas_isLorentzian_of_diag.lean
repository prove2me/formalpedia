open ExactVacuumAtlas
theorem solution {n : ℕ} {G : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ}
    (E : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) (d : Fin (n + 1) → ℝ)
    (h : E.transpose * G * E = Matrix.diagonal d) (h0 : d 0 < 0)
    (hpos : ∀ i, i ≠ 0 → 0 < d i) : IsLorentzian G := by
  set N : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ :=
    Matrix.diagonal fun i => 1 / Real.sqrt |d i| with hN
  refine isLorentzian_of_frame (E * N) ?_
  have hNt : N.transpose = N := Matrix.diagonal_transpose _
  have hassoc : (E * N).transpose * G * (E * N) = N * (E.transpose * G * E) * N := by
    rw [Matrix.transpose_mul, hNt]; simp only [Matrix.mul_assoc]
  rw [hassoc, h, hN, Matrix.diagonal_mul_diagonal, Matrix.diagonal_mul_diagonal]
  unfold eta
  congr 1
  funext i
  have hd : d i ≠ 0 := by
    by_cases hi : i = 0
    · subst hi; exact h0.ne
    · exact (hpos i hi).ne'
  have habs : 0 < |d i| := abs_pos.mpr hd
  have hs : Real.sqrt |d i| ≠ 0 := (Real.sqrt_pos.mpr habs).ne'
  have hsq : Real.sqrt |d i| ^ 2 = |d i| := Real.sq_sqrt habs.le
  have key : 1 / Real.sqrt |d i| * d i * (1 / Real.sqrt |d i|) = d i / Real.sqrt |d i| ^ 2 := by
    ring
  rw [key, hsq]
  by_cases hi : i = 0
  · subst hi
    rw [if_pos rfl, abs_of_neg h0, div_neg, div_self hd]
  · rw [if_neg hi, abs_of_pos (hpos i hi), div_self hd]
