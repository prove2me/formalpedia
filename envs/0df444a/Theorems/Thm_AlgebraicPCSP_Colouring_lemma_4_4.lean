-- title:
--   Lemma 4.4 — homomorphisms F_M(A) → B correspond 1-to-1 to minion homomorphisms M → Pol(A, B)
-- statement:
--   Let $\mathscr M$ be a minion and $(\mathbf A, \mathbf B)$ a PCSP template, where the domain of $\mathbf A$ is enumerated as $e(1), \dots, e(n)$, and let $\mathbf F_{\mathscr M}(\mathbf A)$ be the free structure of $\mathscr M$ generated by $\mathbf A$. To a minion homomorphism $\xi : \mathscr M \to \mathrm{Pol}(\mathbf A, \mathbf B)$ assign the map
--   $$
--   c_\xi : \mathscr M^{(n)} \to B, \qquad c_\xi(f) = \xi(f)\big(e(1), \dots, e(n)\big).
--   $$
--   Then $\xi \mapsto c_\xi$ is a one-to-one correspondence between minion homomorphisms $\mathscr M \to \mathrm{Pol}(\mathbf A, \mathbf B)$ and homomorphisms $\mathbf F_{\mathscr M}(\mathbf A) \to \mathbf B$:
--
--   1. for every minion homomorphism $\xi$, the map $c_\xi$ is a homomorphism $\mathbf F_{\mathscr M}(\mathbf A) \to \mathbf B$;
--   2. for every homomorphism $c : \mathbf F_{\mathscr M}(\mathbf A) \to \mathbf B$ there is a minion homomorphism $\xi$ with $c_\xi = c$, and every minion homomorphism $\chi$ with $c_\chi = c$ agrees with $\xi$ on every member of $\mathscr M$.
--
--   The lemma turns the existence of a minion homomorphism into the existence of an ordinary structure homomorphism, which is how Theorem 6.2 produces its minion homomorphism into $\mathrm{Pol}(\mathbf H_2, \mathbf H_K)$ from a colouring of a hypergraph.
--
--   **Formalization Note** Minion homomorphisms are families of maps whose values outside $\mathscr M$ are unconstrained, so "one-to-one" is stated up to agreement on $\mathscr M$: surjectivity is the existence in item 2 and injectivity is its uniqueness clause. No finiteness is assumed of the minion's sets (Remark 4.5 notes the lemma holds for minions on infinite sets); the domain of $\mathbf A$ is finite through the enumeration $e$.
-- source:
--   L. Barto, J. Bulín, A. Krokhin, J. Opršal, Algebraic approach to promise constraint satisfaction, arXiv:1811.00970v3, p. 24, Lemma 4.4

import Mathlib
import Definitions.Def_PCSPBLPAff_Symmetric_Setting
import Definitions.Def_AlgebraicPCSP_Colouring_Minion
import Definitions.Def_AlgebraicPCSP_Colouring_FreeStructure

namespace AlgebraicPCSP.Colouring

open PCSPBLPAff.Symmetric

/-- Lemma 4.4 (arXiv:1811.00970v3, p. 24): for a minion `M` and a PCSP template `(𝔸, 𝔹)` with
the domain of `𝔸` enumerated as `e : Fin n ≃ A`, homomorphisms `F_M(𝔸) → 𝔹` correspond 1-to-1
to minion homomorphisms `M → Pol(𝔸, 𝔹)` (two minion homomorphisms being the same when they
agree on `M`). The correspondence sends `ξ` to `c_ξ : f ↦ ξ(f)(e(1), …, e(n))`:
1. for every minion homomorphism `ξ`, `c_ξ` is a homomorphism `F_M(𝔸) → 𝔹`;
2. every homomorphism `c : F_M(𝔸) → 𝔹` is `c_ξ` for some minion homomorphism `ξ`, and any
   minion homomorphism `χ` with `c_χ = c` agrees with `ξ` on all of `M`. -/
theorem lemma_4_4 {τ : Type} {ar : τ → ℕ} {A B A' B' : Type} {n : ℕ}
    (M : Minion A' B') (𝔸 : RelStruct τ ar A) (𝔹 : RelStruct τ ar B)
    (h : IsPromiseTemplate 𝔸 𝔹) (e : Fin n ≃ A) :
    (∀ ξ : (m : ℕ) → ((Fin m → A') → B') → ((Fin m → A) → B),
        IsMinionHom M (Pol 𝔸 𝔹 h) ξ →
          IsHom (FreeStruct M 𝔸 e) 𝔹 (fun f => ξ n f.1 (fun i => e i))) ∧
    (∀ c : {f // f ∈ M.mem n} → B, IsHom (FreeStruct M 𝔸 e) 𝔹 c →
      ∃ ξ : (m : ℕ) → ((Fin m → A') → B') → ((Fin m → A) → B),
        IsMinionHom M (Pol 𝔸 𝔹 h) ξ ∧
        (∀ f : {f // f ∈ M.mem n}, ξ n f.1 (fun i => e i) = c f) ∧
        ∀ χ : (m : ℕ) → ((Fin m → A') → B') → ((Fin m → A) → B),
          IsMinionHom M (Pol 𝔸 𝔹 h) χ →
          (∀ f : {f // f ∈ M.mem n}, χ n f.1 (fun i => e i) = c f) →
          ∀ (m : ℕ) (g : (Fin m → A') → B'), g ∈ M.mem m → χ m g = ξ m g) := by sorry

end AlgebraicPCSP.Colouring
