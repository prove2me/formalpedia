/-- The model space is the span of finitely many functions, hence finite-dimensional and
complete. -/
instance : Module.Finite ℂ ↥(Sw w) := by
  rw [Module.finite_def, Submodule.fg_def]
  refine ⟨Set.range (wf w), Set.finite_range _, ?_⟩
  rw [eq_top_iff]
  intro z _
  exact wf_spanning w z

/-- The basis elements are the `wf`. -/
lemma bS_apply (hw : LinearIndependent ℂ w) (i : Fin n) :
    (bS w hw) i = wf w i := Basis.mk_apply _ _ i

/-- The function of a basis element. -/
lemma wf_fun (i : Fin n) : ((wf w i : X → ℂ)) = w i := rfl

/-- Sum over a Finsupp with vanishing summands is the full sum. -/
lemma finsupp_sum_univ {M : Type*} [AddCommMonoid M] (t : Fin n →₀ ℂ) (g : Fin n → ℂ → M)
    (h : ∀ i, g i 0 = 0) : t.sum g = ∑ i, g i (t i) := by
  classical
  simp only [Finsupp.sum]
  rw [Finset.sum_subset (Finset.subset_univ t.support)]
  · intro i _ hi
    have hz : t i = 0 := by
      by_contra hne
      exact hi (Finsupp.mem_support_iff.mpr hne)
    rw [hz, h i]

/-- Coordinates of a combination are the coefficients. -/
lemma repr_comb (hw : LinearIndependent ℂ w) (c : Fin n → ℂ) :
    (bS w hw).repr (∑ i, c i • (wf w i)) = Finsupp.equivFunOnFinite.symm c := by
  have hcoe : ∀ i : Fin n, (Finsupp.equivFunOnFinite.symm c : Fin n →₀ ℂ) i = c i :=
    fun i => congrFun (Finsupp.coe_equivFunOnFinite_symm c) i
  have h1 : (Finsupp.linearCombination ℂ (wf w) (Finsupp.equivFunOnFinite.symm c))
      = ∑ i, c i • (wf w i) := by
    rw [Finsupp.linearCombination_apply, finsupp_sum_univ _ _ (fun i => by simp)]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hcoe i]
  rw [← h1]
  have h2 : (Finsupp.linearCombination ℂ (wf w)) = (Finsupp.linearCombination ℂ (bS w hw)) := by
    apply LinearMap.ext
    intro t
    rw [Finsupp.linearCombination_apply, Finsupp.linearCombination_apply]
    refine Finsupp.sum_congr (fun i _ => ?_)
    rw [bS_apply w hw i]
  rw [h2]
  exact Module.Basis.repr_linearCombination (bS w hw)
    (Finsupp.equivFunOnFinite.symm c)

/-- Coordinates of a combination, as a function. -/
lemma repr_comb_fn (hw : LinearIndependent ℂ w) (c : Fin n → ℂ) (j : Fin n) :
    (((bS w hw).repr (∑ i, c i • (wf w i))) : Fin n → ℂ) j = c j := by
  rw [repr_comb w hw c]
  rfl

/-- The kernel element of the model at `y`. -/
noncomputable def kS (hβ : β.PosDef) (hw : LinearIndependent ℂ w) (y : X) : ↥(Sw w) :=
  ∑ i, (∑ j, β i j * star (w j y)) • (wf w i)

/-- The coordinates of the kernel element. -/
lemma repr_kS (hβ : β.PosDef) (hw : LinearIndependent ℂ w) (y : X) (i : Fin n) :
    (((bS w hw).repr (kS β w hβ hw y)) : Fin n → ℂ) i = ∑ j, β i j * star (w j y) := by
  have h := repr_comb w hw (fun i => ∑ j, β i j * star (w j y))
  rw [show kS β w hβ hw y = ∑ i, (∑ j, β i j * star (w j y)) • (wf w i) from rfl, h]
  rfl

/-- Entry of `β * β⁻¹ = 1`, in the orientation needed below. -/
lemma starβG_entry (hβ : β.PosDef) (l j : Fin n) :
    ∑ i, star (β i l) * (G β) i j = if l = j then (1 : ℂ) else 0 := by
  have hconv : ∀ i : Fin n, star (β i l) = β l i := fun i => hβ.1.apply l i
  have h0 : ∑ i, β l i * (G β) i j = if l = j then (1 : ℂ) else 0 := by
    have h1 : (β * (G β)) l j = if l = j then 1 else 0 := by
      rw [show (G β) = β⁻¹ from rfl,
        Matrix.mul_nonsing_inv β (by
          rw [← Matrix.isUnit_iff_isUnit_det]
          exact hβ.isUnit),
        Matrix.one_apply]
    rw [Matrix.mul_apply] at h1
    exact h1
  rw [Finset.sum_congr rfl fun i _ => by rw [hconv i]]
  exact h0

/-- Triple sum swap. -/
lemma sum_univ3_comm (t : Fin n → Fin n → Fin n → ℂ) :
    ∑ i, ∑ j, ∑ l, t i j l = ∑ l, ∑ i, ∑ j, t i j l := by
  have h1 : ∑ i, ∑ j, ∑ l, t i j l = ∑ i, ∑ l, ∑ j, t i j l :=
    Finset.sum_congr rfl fun i _ => Finset.sum_comm
  rw [h1]
  exact Finset.sum_comm

/-- The kernel element reproduces evaluation. -/
lemma inS_kS (hβ : β.PosDef) (hw : LinearIndependent ℂ w) (y : X) (g : ↥(Sw w)) :
    inS w β hw (kS β w hβ hw y) g = ((g : X → ℂ)) y := by
  -- the star of the kernel coordinates expands entrywise
  have hstar : ∀ i : Fin n, star (((bS w hw).repr (kS β w hβ hw y) : Fin n → ℂ) i)
      = ∑ l, star (β i l) * (w l y) := by
    intro i
    rw [repr_kS β w hβ hw y i]
    rw [show star (∑ j, β i j * star (w j y)) = ∑ l, star (β i l * star (w l y)) from
      map_sum (starRingEnd ℂ) (fun l => β i l * star (w l y)) Finset.univ]
    exact Finset.sum_congr rfl fun l _ => by
      rw [show star (β i l * star (w l y)) = star (β i l) * (w l y) from by
        have h := map_mul (starRingEnd ℂ) (β i l) (star (w l y))
        have hs : (starRingEnd ℂ) (star (w l y)) = (w l y) := star_star _
        rw [hs] at h
        exact h]
  -- the inner double sum collapses by the entry identity `∑ i ⋆β_il (β⁻¹)_ij = δ_lj`
  have hinner : ∀ l : Fin n, ∑ i, ∑ j, (G β) i j * star (β i l)
      * (((bS w hw).repr g : Fin n → ℂ) j)
      = (((bS w hw).repr g : Fin n → ℂ) l) := by
    intro l
    have hstep1 : ∀ i : Fin n, ∑ j, (G β) i j * star (β i l)
        * (((bS w hw).repr g : Fin n → ℂ) j)
        = ∑ j, star (β i l) * ((G β) i j * (((bS w hw).repr g : Fin n → ℂ) j)) :=
      fun i => Finset.sum_congr rfl fun j _ => by ring
    have hstep2 : ∑ i, ∑ j, star (β i l) * ((G β) i j
          * (((bS w hw).repr g : Fin n → ℂ) j))
        = ∑ j, (((bS w hw).repr g : Fin n → ℂ) j)
          * (∑ i, star (β i l) * (G β) i j) := by
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun i _ => by ring
    rw [Finset.sum_congr rfl fun i _ => hstep1 i, hstep2]
    rw [Finset.sum_congr rfl fun j _ => by rw [starβG_entry β hβ l j]]
    simp
  -- full computation
  calc inS w β hw (kS β w hβ hw y) g
      = ∑ i, ∑ j, (G β) i j * star (((bS w hw).repr (kS β w hβ hw y) : Fin n → ℂ) i)
          * (((bS w hw).repr g : Fin n → ℂ) j) := rfl
    _ = ∑ i, ∑ j, ∑ l, (G β) i j * star (β i l) * (w l y)
          * (((bS w hw).repr g : Fin n → ℂ) j) := by
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
        have hstep : (G β) i j * star (((bS w hw).repr (kS β w hβ hw y) :
            Fin n → ℂ) i) * (((bS w hw).repr g : Fin n → ℂ) j)
            = ∑ l, (G β) i j * star (β i l) * (w l y)
              * (((bS w hw).repr g : Fin n → ℂ) j) := by
          conv_lhs => rw [hstar i, Finset.mul_sum, Finset.sum_mul]
          exact Finset.sum_congr rfl fun l _ => by ring
        rw [hstep]
    _ = ∑ l, ∑ i, ∑ j, ((G β) i j * star (β i l)
          * (((bS w hw).repr g : Fin n → ℂ) j)) * (w l y) := by
        refine sum_univ3_comm (fun i j l => (G β) i j * star (β i l) * (w l y)
          * (((bS w hw).repr g : Fin n → ℂ) j)) |>.trans ?_
        refine Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun i _ =>
          Finset.sum_congr rfl fun j _ => ?_
        ring
    _ = ∑ l, (w l y) * (∑ i, ∑ j, (G β) i j * star (β i l)
          * (((bS w hw).repr g : Fin n → ℂ) j)) := by
        refine Finset.sum_congr rfl fun l _ => ?_
        have hfactor : ∑ i, ∑ j, (G β) i j * star (β i l)
            * (((bS w hw).repr g : Fin n → ℂ) j) * (w l y)
            = (∑ i, (∑ j, (G β) i j * star (β i l)
              * (((bS w hw).repr g : Fin n → ℂ) j)) * (w l y)) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Finset.sum_mul (f := fun j => (G β) i j * star (β i l)
            * (((bS w hw).repr g : Fin n → ℂ) j))
            (a := w l y)]
        rw [hfactor]
        conv_lhs => rw [← Finset.sum_mul]
        ring
    _ = ∑ l, (w l y) * (((bS w hw).repr g : Fin n → ℂ) l) := by
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [hinner l]
    _ = ((g : X → ℂ)) y := by
        have hgy : ((g : X → ℂ)) y
            = ∑ l, (((bS w hw).repr g : Fin n → ℂ) l) * (w l y) := by
          have h2 := Basis.sum_repr (bS w hw) g
          rw [Finset.sum_congr rfl fun l _ => by rw [bS_apply w hw l]] at h2
          conv_lhs => rw [← h2]
          rw [show ((∑ l, ((bS w hw).repr g) l • (wf w l) : ↥(Sw w)) : X → ℂ)
              = ∑ l, ((((bS w hw).repr g) l • (wf w l) : ↥(Sw w)) : X → ℂ) from
            Submodule.coe_sum (Sw w)
              (fun l => ((bS w hw).repr g) l • (wf w l)) Finset.univ]
          rw [Finset.sum_apply y Finset.univ
            (fun l => ((((bS w hw).repr g) l • (wf w l) : ↥(Sw w)) : X → ℂ))]
          refine Finset.sum_congr rfl fun l _ => ?_
          rfl
        rw [hgy]
        exact Finset.sum_congr rfl fun l _ => by rw [mul_comm]

/-- Evaluation of the kernel element as a function. -/
lemma kS_fun (hβ : β.PosDef) (hw : LinearIndependent ℂ w) (y x : X) :
    ((kS β w hβ hw y : X → ℂ)) x = ∑ i, ∑ j, β i j * (w i x) * star (w j y) := by
  have hcoe : ((kS β w hβ hw y : X → ℂ))
      = fun x' => ∑ i, (∑ j, β i j * star (w j y)) * (w i x') := by
    rw [show ((kS β w hβ hw y : X → ℂ))
        = ((∑ i, (∑ j, β i j * star (w j y)) • (wf w i) : ↥(Sw w))) from rfl,
      Submodule.coe_sum (Sw w)
        (fun i => (∑ j, β i j * star (w j y)) • (wf w i)) Finset.univ]
    funext x'
    rw [Finset.sum_apply x' Finset.univ
      (fun i => (((∑ j, β i j * star (w j y)) • (wf w i) : ↥(Sw w)) : X → ℂ))]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hsmul : (((((∑ j, β i j * star (w j y)) • (wf w i) : ↥(Sw w))) : X → ℂ))
        = fun x' => (∑ j, β i j * star (w j y)) * (w i x') := by
      funext x'
      show (((((∑ j, β i j * star (w j y)) • (wf w i) : ↥(Sw w))) : X → ℂ)) x'
          = (∑ j, β i j * star (w j y)) * (w i x')
      rfl
    rw [hsmul]
  rw [hcoe]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.sum_mul]
  exact Finset.sum_congr rfl fun j _ => by ring

/-- The scalar kernel identity: the inner product of two kernel elements is the
platform's `β`-form. -/
lemma inS_kS_kS (hβ : β.PosDef) (hw : LinearIndependent ℂ w) (x y : X) :
    inS w β hw (kS β w hβ hw x) (kS β w hβ hw y)
      = ∑ i, ∑ j, β i j * (w i x) * star (w j y) := by
  rw [show inS w β hw (kS β w hβ hw x) (kS β w hβ hw y)
      = ((kS β w hβ hw y : X → ℂ)) x from inS_kS β w hβ hw x (kS β w hβ hw y)]
  exact kS_fun β w hβ hw y x





end Model


section PartA

open RKHS AronszajnRK.Sum

variable {X : Type u} {H : Type v} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H] [RKHS ℂ H X ℂ]

/-- Every finite-dimensional RKHS has a kernel of Aronszajn's form (6), with `β = 1` and
`w` the functions of an orthonormal basis. -/
theorem exists_kernelFn_of_finiteDimensional (hfd : FiniteDimensional ℂ H) :
    ∃ (n : ℕ) (γ : Matrix (Fin n) (Fin n) ℂ) (w : Fin n → X → ℂ),
      γ.PosDef ∧ LinearIndependent ℂ w ∧
      kernelFn H = fun x y => ∑ i, ∑ j, γ i j * w i x * star (w j y) := by
  haveI : FiniteDimensional ℂ H := hfd
  classical
  set b := stdOrthonormalBasis ℂ H with hb
  set w : Fin (Module.finrank ℂ H) → X → ℂ :=
    fun i => ((coeCLM ℂ (b.toBasis i) : X → ℂ)) with hwdef
  refine ⟨Module.finrank ℂ H, 1, w, Matrix.PosDef.one, ?_, ?_⟩
  · -- linear independence of the coordinate functions
    have hinj : LinearMap.ker ((coeCLM ℂ) : H →L[ℂ] (X → ℂ)).toLinearMap = ⊥ := by
      rw [LinearMap.ker_eq_bot]
      exact RKHS.coeCLM_injective
    exact (b.toBasis.linearIndependent).map' _ hinj
  · -- the kernel identity
    funext x y
    have h1 : kernelFn H x y = (kerFun H y 1) x := by
      rw [kernelFn, kerFun_apply]
    have h2 : kerFun H y 1
        = ∑ i, ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ • (b.toBasis i : H) :=
      (OrthonormalBasis.sum_repr' b _).symm
    have h3 : ∀ i : Fin (Module.finrank ℂ H),
        ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ = star ((w i) y) := by
      intro i
      rw [inner_kerFun]
      simp only [RCLike.inner_apply, map_one, one_mul]
      rfl
    have h2' : ((kerFun H y 1 : H) : X → ℂ)
        = ((∑ i, ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ • (b.toBasis i : H) : H) : X → ℂ) := by
      simp only [OrthonormalBasis.coe_toBasis]
      rw [OrthonormalBasis.sum_repr' b (kerFun H y 1)]
    have h4 : ((∑ i, ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ • (b.toBasis i : H) : H) : X → ℂ)
        = fun x' => ∑ i, ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ * ((w i) x') := by
      funext x'
      have hmap : ((coeCLM ℂ) : H →L[ℂ] (X → ℂ))
          (∑ i, ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ • (b.toBasis i : H))
          = ∑ i, ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ • ((coeCLM ℂ) (b.toBasis i) : X → ℂ) := by
        rw [map_sum]
        exact Finset.sum_congr rfl fun i _ => (map_smul (coeCLM ℂ) _ _)
      rw [show ((∑ i, ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ • (b.toBasis i : H) : H) : X → ℂ)
          = ((coeCLM ℂ) : H →L[ℂ] (X → ℂ))
            (∑ i, ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ • (b.toBasis i : H)) from rfl,
        hmap]
      rw [Finset.sum_apply x' Finset.univ
        (fun i => ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ • ((coeCLM ℂ) (b.toBasis i) : X → ℂ))]
      refine Finset.sum_congr rfl fun i _ => ?_
      rfl
    calc kernelFn H x y = ((kerFun H y 1 : H) : X → ℂ) x := h1
      _ = ((∑ i, ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ • (b.toBasis i : H) : H) : X → ℂ) x := by
          rw [h2']
      _ = ∑ i, ⟪(b.toBasis i : H), kerFun H y 1⟫_ℂ * ((w i) x) := by
          rw [h4]
      _ = ∑ i, star ((w i) y) * ((w i) x) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [h3 i]
      _ = ∑ i, ∑ j, (1 : Matrix (Fin (Module.finrank ℂ H)) (Fin (Module.finrank ℂ H)) ℂ) i j
            * ((w i) x) * star ((w j) y) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          simp only [Matrix.one_apply, ite_mul, zero_mul, one_mul,
            Finset.sum_ite_eq, Finset.mem_univ, if_true]
          ring

end PartA


/-! ## Moore uniqueness transfer (verbatim from the accepted moore solution) -/

namespace ZFinAux

open RKHS ContinuousLinearMap

/-! ## Uniqueness: two RKHSs with the same scalar kernel -/

section Uniqueness

variable {X : Type*} {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H] [RKHS ℂ H X ℂ]

/-- The inner product of two kernel functions is the scalar kernel. -/
lemma inner_kerFun (y y' : X) :
    ⟪kerFun H y 1, kerFun H y' 1⟫_ℂ = AronszajnRK.Sum.kernelFn H y y' := by
  rw [AronszajnRK.Sum.kernelFn, kerFun_inner]
  simp
  rw [kerFun_apply]

/-- The combination map: a finitely supported family of scalars gives the corresponding
combination of kernel functions. -/
noncomputable def e {X : Type*} (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] [RKHS ℂ H X ℂ] : (X →₀ ℂ) →ₗ[ℂ] H :=
  Finsupp.linearCombination ℂ (fun y : X => kerFun H y 1)

lemma e_apply (c : X →₀ ℂ) :
    e H c = c.sum fun y cy => cy • kerFun H y 1 := rfl

/-- Point evaluation of a combination of kernel functions. -/
lemma eval_e (c : X →₀ ℂ) (x : X) :
    (e H c) x = c.sum fun y cy => cy * AronszajnRK.Sum.kernelFn H x y := by
  have h1 : (e H c) x = ⟪kerFun H x 1, e H c⟫_ℂ := by
    rw [kerFun_inner]; simp
  rw [h1, e_apply, Finsupp.inner_sum]
  refine Finsupp.sum_congr fun y _ => ?_
  rw [inner_smul_right, inner_kerFun]

/-- The inner product of two combinations depends only on the scalar kernel. -/
lemma inner_e (c d : X →₀ ℂ) :
    ⟪e H c, e H d⟫_ℂ = c.sum fun y cy => d.sum fun y' dy' => (star cy) * dy' *
      AronszajnRK.Sum.kernelFn H y y' := by
  rw [e_apply, e_apply, Finsupp.sum_inner]
  refine Finsupp.sum_congr fun y _ => ?_
  rw [Finsupp.inner_sum]
  refine Finsupp.sum_congr fun y' _ => ?_
  rw [inner_smul_left, inner_smul_right, inner_kerFun]
  simp [mul_assoc, mul_comm, mul_left_comm]

variable {H₁ H₂ : Type*} [NormedAddCommGroup H₁] [InnerProductSpace ℂ H₁] [CompleteSpace H₁]
  [RKHS ℂ H₁ X ℂ] [NormedAddCommGroup H₂] [InnerProductSpace ℂ H₂] [CompleteSpace H₂]
  [RKHS ℂ H₂ X ℂ]

lemma inner_e_congr (hk : AronszajnRK.Sum.kernelFn H₁ = AronszajnRK.Sum.kernelFn H₂)
    (c d : X →₀ ℂ) : ⟪e H₁ c, e H₁ d⟫_ℂ = ⟪e H₂ c, e H₂ d⟫_ℂ := by
  rw [inner_e, inner_e, hk]

lemma norm_e_eq (hk : AronszajnRK.Sum.kernelFn H₁ = AronszajnRK.Sum.kernelFn H₂)
    (c : X →₀ ℂ) : ‖e H₁ c‖ = ‖e H₂ c‖ := by
  have h : RCLike.re ⟪e H₁ c, e H₁ c⟫_ℂ = RCLike.re ⟪e H₂ c, e H₂ c⟫_ℂ := by
    rw [inner_e_congr hk]
  have h2 : (‖e H₁ c‖ : ℝ) ^ 2 = (‖e H₂ c‖ : ℝ) ^ 2 := by
    calc (‖e H₁ c‖ : ℝ) ^ 2 = RCLike.re ⟪e H₁ c, e H₁ c⟫_ℂ := (inner_self_eq_norm_sq _).symm
      _ = RCLike.re ⟪e H₂ c, e H₂ c⟫_ℂ := h
      _ = (‖e H₂ c‖ : ℝ) ^ 2 := inner_self_eq_norm_sq _
  nlinarith [norm_nonneg (e H₁ c), norm_nonneg (e H₂ c)]

lemma kerFun_smul_one (x : X) (v : ℂ) : kerFun H x v = v • kerFun H x 1 := by
  have := (kerFun H x).map_smul v (1 : ℂ)
  simpa using this

lemma span_kerFun_eq :
    Submodule.span ℂ {kerFun H x v | (x) (v)}
      = Submodule.span ℂ (Set.range fun y : X => kerFun H y 1) := by
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro z ⟨x, v, rfl⟩
    rw [kerFun_smul_one]
    exact Submodule.smul_mem _ _
      (Submodule.subset_span (Set.mem_range_self x))
  · rw [Submodule.span_le]
    rintro z ⟨y, rfl⟩
    exact Submodule.subset_span ⟨y, 1, rfl⟩

/-- The combinations of kernel functions are dense. -/
lemma dense_range_e : Dense (Set.range fun c : X →₀ ℂ => e H c) := by
  have h1 : LinearMap.range (e H)
      = Submodule.span ℂ (Set.range fun y : X => kerFun H y 1) := by
    show LinearMap.range (Finsupp.linearCombination ℂ (fun y : X => kerFun H y 1)) = _
    rw [Finsupp.range_linearCombination]
  have h2 : (Submodule.span ℂ (Set.range fun y : X => kerFun H y 1)).topologicalClosure = ⊤ := by
    have := kerFun_dense H
    rwa [span_kerFun_eq] at this
  rw [show Set.range (fun c : X →₀ ℂ => e H c) = ↑(LinearMap.range (e H)) from
      (LinearMap.coe_range (e H)).symm,
    h1, Submodule.dense_iff_topologicalClosure_eq_top]
  exact h2

/-- Given two RKHSs with the same scalar kernel, there is a continuous norm-preserving map
sending every function to a function with the same values. -/
theorem exists_kernel_preserving_isometry
    (hk : AronszajnRK.Sum.kernelFn H₁ = AronszajnRK.Sum.kernelFn H₂) :
    ∃ T : H₁ → H₂, Continuous T ∧ (∀ f : H₁, ∀ x : X, T f x = f x) ∧ ∀ f : H₁, ‖T f‖ = ‖f‖ := by
  classical
  set E₁ : (X →₀ ℂ) → H₁ := fun c => e H₁ c with hE₁
  have hdense : Dense (Set.range E₁) := dense_range_e (H := H₁)
  set corr : Set.range E₁ → H₂ := fun z => e H₂ (Function.invFun E₁ z.1) with hcorrdef
  -- `invFun` lands in a preimage
  have hpre : ∀ z : Set.range E₁, e H₁ (Function.invFun E₁ z.1) = z.1 := by
    intro z
    exact Function.invFun_eq z.2
  -- the correspondence is well defined on values
  have hwd : ∀ c c' : X →₀ ℂ, E₁ c = E₁ c' → e H₂ c = e H₂ c' := by
    intro c c' h
    have h2 : e H₁ (c - c') = 0 := by
      have h3 : e H₁ (c - c') = E₁ c - E₁ c' := by simp [hE₁, map_sub]
      rw [h3, h, sub_self]
    have h4 : ‖e H₂ (c - c')‖ = 0 := by
      rw [← norm_e_eq hk, h2, norm_zero]
    have h5 : e H₂ c - e H₂ c' = e H₂ (c - c') := by simp [map_sub]
    rw [← sub_eq_zero, h5]
    exact norm_eq_zero.mp h4
  have hcorr_eq : ∀ c : X →₀ ℂ, corr ⟨E₁ c, ⟨c, rfl⟩⟩ = e H₂ c := by
    intro c
    exact hwd _ _ (Function.invFun_eq ⟨c, rfl⟩)
  have hiso : Isometry corr := by
    refine isometry_iff_dist_eq.mpr fun z z' => ?_
    have h5 : corr z - corr z' = e H₂ (Function.invFun E₁ z.1 - Function.invFun E₁ z'.1) := by
      show e H₂ (Function.invFun E₁ z.1) - e H₂ (Function.invFun E₁ z'.1)
        = e H₂ (Function.invFun E₁ z.1 - Function.invFun E₁ z'.1)
      rw [map_sub]
    have h6 : e H₁ (Function.invFun E₁ z.1 - Function.invFun E₁ z'.1) = z.1 - z'.1 := by
      rw [map_sub, hpre, hpre]
    calc dist (corr z) (corr z') = ‖corr z - corr z'‖ := dist_eq_norm (corr z) (corr z')
      _ = ‖e H₂ (Function.invFun E₁ z.1 - Function.invFun E₁ z'.1)‖ := by rw [h5]
      _ = ‖e H₁ (Function.invFun E₁ z.1 - Function.invFun E₁ z'.1)‖ := (norm_e_eq hk _).symm
      _ = ‖z.1 - z'.1‖ := by rw [h6]
      _ = dist z.1 z'.1 := (dist_eq_norm z.1 z'.1).symm
      _ = dist z z' := (Subtype.dist_eq z z').symm
  have hu : UniformContinuous corr := hiso.uniformContinuous
  have hTcont : Continuous (hdense.extend corr) :=
    (Dense.uniformContinuous_extend hdense hu).continuous
  have hTe : ∀ c : X →₀ ℂ, (hdense.extend corr) (E₁ c) = e H₂ c := by
    intro c
    have h := Dense.extend_of_ind hdense hu (⟨E₁ c, ⟨c, rfl⟩⟩ : Set.range E₁)
    simp only [Subtype.coe_mk] at h
    rw [h]
    exact hcorr_eq c
  refine ⟨hdense.extend corr, hTcont, ?_, ?_⟩
  · -- functions are preserved
    intro f x
    have hg : Continuous (fun g : H₁ => (hdense.extend corr) g x) :=
      (RKHS.continuous_eval x).comp hTcont
    have hh : Continuous (fun g : H₁ => g x) := RKHS.continuous_eval x
    have hagree : ∀ c : X →₀ ℂ, (fun g : H₁ => (hdense.extend corr) g x) (E₁ c)
        = (fun g : H₁ => g x) (E₁ c) := by
      intro c
      show (hdense.extend corr (E₁ c)) x = (E₁ c) x
      rw [hTe, eval_e (H := H₂), eval_e (H := H₁), hk]
    exact congrFun (DenseRange.equalizer hdense hg hh (funext hagree)) f
  · -- norms are preserved
    intro f
    have hg : Continuous (fun g : H₁ => ‖(hdense.extend corr) g‖) :=
      continuous_norm.comp hTcont
    have hh : Continuous (fun g : H₁ => ‖g‖) := continuous_norm
    have hagree : ∀ c : X →₀ ℂ, (fun g : H₁ => ‖(hdense.extend corr) g‖) (E₁ c)
        = (fun g : H₁ => ‖g‖) (E₁ c) := by
      intro c
      show ‖hdense.extend corr (E₁ c)‖ = ‖E₁ c‖
      rw [hTe, norm_e_eq hk]
    exact congrFun (DenseRange.equalizer hdense hg hh (funext hagree)) f

/-- **Uniqueness half of Moore's theorem.** -/
theorem moore_uniqueness (hk : AronszajnRK.Sum.kernelFn H₁ = AronszajnRK.Sum.kernelFn H₂) :
    Set.range (fun f : H₁ => (f : X → ℂ)) = Set.range (fun f : H₂ => (f : X → ℂ)) ∧
      ∀ (f₁ : H₁) (f₂ : H₂), (f₁ : X → ℂ) = (f₂ : X → ℂ) → ‖f₁‖ = ‖f₂‖ := by
  obtain ⟨T, hTcont, hTfun, hTiso⟩ := exists_kernel_preserving_isometry hk
  obtain ⟨S, hScont, hSfun, hSiso⟩ := exists_kernel_preserving_isometry hk.symm
  refine ⟨?_, ?_⟩
  · ext g
    constructor
    · rintro ⟨f₁, rfl⟩
      exact ⟨T f₁, funext fun x => hTfun f₁ x⟩
    · rintro ⟨f₂, rfl⟩
      exact ⟨S f₂, funext fun x => hSfun f₂ x⟩
  · intro f₁ f₂ hf
    have hT : T f₁ = f₂ := by
      refine RKHS.ext (fun x => ?_)
      rw [hTfun f₁ x]
      exact congrFun hf x
    rw [← hT, hTiso]

end Uniqueness

end ZFinAux





section Final

open RKHS AronszajnRK.Sum

/-- Double-sum swap by index relabeling. -/
lemma sum2_comm {n : ℕ} (t : Fin n → Fin n → ℂ) :
    (∑ i, ∑ j, t i j) = ∑ i, ∑ j, t j i := by
  rw [Finset.sum_comm]

end Final

end FinDimAux

open FinDimAux RKHS AronszajnRK.Sum

/-- **Aronszajn §3, Theorem (finite-dimensional classes)** — see the docstring of
`finite_dimensional_classes` for the statement. -/
theorem solution {X : Type u} :
    (∀ (H : Type v) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
      [RKHS ℂ H X ℂ], FiniteDimensional ℂ H →
        ∃ (n : ℕ) (β : Matrix (Fin n) (Fin n) ℂ) (w : Fin n → X → ℂ),
          β.PosDef ∧ LinearIndependent ℂ w ∧
          kernelFn H = fun x y => ∑ i, ∑ j, β i j * w i x * star (w j y)) ∧
    ∀ (n : ℕ) (β : Matrix (Fin n) (Fin n) ℂ) (w : Fin n → X → ℂ),
      β.PosDef → LinearIndependent ℂ w →
        (∃ (H : Type u) (_ : NormedAddCommGroup H) (_ : InnerProductSpace ℂ H)
            (_ : CompleteSpace H) (_ : RKHS ℂ H X ℂ), FiniteDimensional ℂ H ∧
            kernelFn H = fun x y => ∑ i, ∑ j, β i j * w i x * star (w j y)) ∧
        ∀ (H : Type v) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
          [RKHS ℂ H X ℂ],
          kernelFn H = (fun x y => ∑ i, ∑ j, β i j * w i x * star (w j y)) →
            FiniteDimensional ℂ H ∧
            Set.range (fun f : H => (f : X → ℂ)) =
              {g : X → ℂ | ∃ ζ : Fin n → ℂ, g = ∑ k, ζ k • w k} ∧
            ∀ (f : H) (ζ : Fin n → ℂ), (f : X → ℂ) = ∑ k, ζ k • w k →
              ((‖f‖ ^ 2 : ℝ) : ℂ) =
                ∑ i, ∑ j, (β.map star)⁻¹ i j * ζ i * star (ζ j) := by
  constructor
  · -- **Part A**: every finite-dimensional RKHS has a kernel of the form (6)
    intro H _ _ _ _ hfd
    exact exists_kernelFn_of_finiteDimensional hfd
  · -- **Part B**: given `β` positive definite and `w` linearly independent
    intro n β w hβ hw
    classical
    -- #### the transparent instance tower on the model `↥(Sw w)`
    letI core : InnerProductSpace.Core ℂ ↥(Sw w) := inSCore β w hβ hw
    letI precore : PreInnerProductSpace.Core ℂ ↥(Sw w) := { core with }
    letI semi : SeminormedAddCommGroup ↥(Sw w) :=
      InnerProductSpace.Core.toSeminormedAddCommGroup (c := precore)
    letI munif : UniformSpace ↥(Sw w) :=
      @PseudoMetricSpace.toUniformSpace _ semi.toPseudoMetricSpace
    letI mtopo : TopologicalSpace ↥(Sw w) := @UniformSpace.toTopologicalSpace _ munif
    letI nAG : NormedAddCommGroup ↥(Sw w) :=
      InnerProductSpace.Core.toNormedAddCommGroup (cd := core)
    have hn : ∀ x : ↥(Sw w),
        @Norm.norm ↥(Sw w) (@NormedAddCommGroup.toNorm _ nAG) x
          = @Norm.norm ↥(Sw w) (@SeminormedAddCommGroup.toNorm _ semi) x := fun x => rfl
    letI ipsN : @InnerProductSpace ℂ ↥(Sw w) _
        (@NormedAddCommGroup.toSeminormedAddCommGroup _ nAG) :=
      { toInner := ⟨fun u v => inS w β hw u v⟩
        toNormedSpace := ⟨(InnerProductSpace.Core.toNormedSpace (c := precore)).norm_smul_le⟩
        norm_sq_eq_re_inner := fun x => by
          show (@Norm.norm ↥(Sw w) (@NormedAddCommGroup.toNorm _ nAG) x) ^ 2
              = RCLike.re (inS w β hw x x)
          rw [hn x]
          rw [show @Norm.norm ↥(Sw w) (@SeminormedAddCommGroup.toNorm _ semi) x
              = √(RCLike.re (inS w β hw x x)) from
            InnerProductSpace.Core.norm_eq_sqrt_re_inner (c := precore) x]
          exact Real.sq_sqrt
            (InnerProductSpace.Core.inner_self_nonneg (c := precore) (x := x))
        conj_inner_symm := fun x y =>
          InnerProductSpace.Core.inner_conj_symm (c := precore) (x := x) (y := y)
        add_left := fun x y z =>
          InnerProductSpace.Core.inner_add_left (c := precore) (x := x) (y := y) (z := z)
        smul_left := fun x y r =>
          InnerProductSpace.Core.inner_smul_left (c := precore) (x := x) (y := y) (r := r) }
    haveI : IsUniformAddGroup ↥(Sw w) :=
      @SeminormedAddCommGroup.to_isUniformAddGroup _ semi
    haveI : FiniteDimensional ℂ ↥(Sw w) := inferInstance
    haveI : @T0Space ↥(Sw w) mtopo :=
      ⟨fun {x y} hxy => by
        have hd : dist x y = 0 :=
          (@Metric.inseparable_iff ↥(Sw w) semi.toPseudoMetricSpace x y).mp hxy
        rw [dist_eq_norm, ← hn (x - y)] at hd
        have hs2 : RCLike.re ⟪x - y, x - y⟫_ℂ = 0 := by
          have h1 := @inner_self_eq_norm_sq ℂ ↥(Sw w) _ _ ipsN (x - y)
          rw [h1, hd]
          norm_num
        have hzz : ⟪x - y, x - y⟫_ℂ = 0 :=
          Complex.ext hs2 (by
            simpa using (@inner_self_im ℂ ↥(Sw w) _ _ ipsN (x - y)))
        exact sub_eq_zero.mp ((InnerProductSpace.Core.inner_self_eq_zero (cd := core)).mp hzz)⟩
    haveI : ContinuousSMul ℂ ↥(Sw w) :=
      @IsBoundedSMul.continuousSMul ℂ ↥(Sw w) _ semi.toPseudoMetricSpace _ _ _
        (@NormedSpace.toIsBoundedSMul ℂ ↥(Sw w) _ semi
          (InnerProductSpace.Core.toNormedSpace (c := precore)))
    haveI : CompleteSpace ↥(Sw w) := FiniteDimensional.complete ℂ ↥(Sw w)
    have hinner : ∀ u v : ↥(Sw w), ⟪u, v⟫_ℂ = inS w β hw u v := fun u v => rfl
    -- #### point evaluations and the RKHS structure
    let evl : (x : X) → ↥(Sw w) →ₗ[ℂ] ℂ := fun x =>
      { toFun := fun g => (g.val : X → ℂ) x
        map_add' := fun g h => rfl
        map_smul' := fun c g => rfl }
    have hbnd : ∀ (x : X) (g : ↥(Sw w)), ‖(evl x) g‖ ≤ ‖kS β w hβ hw x‖ * ‖g‖ := by
      intro x g
      have hrep : (evl x) g = ⟪kS β w hβ hw x, g⟫_ℂ := by
        show (g.val : X → ℂ) x = _
        rw [hinner (kS β w hβ hw x) g]
        exact (inS_kS β w hβ hw x g).symm
      rw [hrep]
      exact @norm_inner_le_norm ℂ ↥(Sw w) _ _ ipsN _ _
    let evlCLM : (x : X) → ↥(Sw w) →L[ℂ] ℂ :=
      fun x => LinearMap.mkContinuous (evl x) ‖kS β w hβ hw x‖ (hbnd x)
    letI rkhsInst : RKHS ℂ ↥(Sw w) X ℂ :=
      { coeCLM := ContinuousLinearMap.pi fun x => evlCLM x
        coeCLM_injective := by
          intro g h hgh
          apply Subtype.ext
          funext x
          exact congrFun hgh x }
    have hcoe : ∀ (g : ↥(Sw w)) (x : X), (coeCLM ℂ g) x = (g.val : X → ℂ) x :=
      fun g x => rfl
    have hkerFun : ∀ y : X, kerFun ↥(Sw w) y (1 : ℂ) = kS β w hβ hw y := by
      intro y
      refine ext_inner_left ℂ (fun v => ?_)
      rw [inner_kerFun]
      simp only [RCLike.inner_apply, map_one, mul_one, one_mul]
      have hv : ((v : X → ℂ)) y = (v.val : X → ℂ) y := hcoe v y
      rw [hv, hinner v (kS β w hβ hw y),
        show inS w β hw v (kS β w hβ hw y)
            = (starRingEnd ℂ) (inS w β hw (kS β w hβ hw y) v) from
          (InnerProductSpace.Core.inner_conj_symm (c := precore) (x := v)
            (y := kS β w hβ hw y)).symm,
        inS_kS β w hβ hw y v]
    -- #### the model kernel identity
    have hKm : kernelFn ↥(Sw w) = fun x y => ∑ i, ∑ j, β i j * w i x * star (w j y) := by
      funext x y
      have h1 : kernelFn ↥(Sw w) x y = (kerFun ↥(Sw w) y (1 : ℂ)) x := by
        rw [kernelFn, kerFun_apply]
      rw [h1, hkerFun y]
      exact kS_fun β w hβ hw y x
    -- #### the RKHS coercion of the model is the subtype coercion
    have hcoeF : ∀ g : ↥(Sw w), ((g : X → ℂ)) = (g.val : X → ℂ) :=
      fun g => funext fun x => hcoe g x
    -- #### B1: the witness
    refine ⟨⟨↥(Sw w), nAG, ipsN, inferInstance, rkhsInst, inferInstance, hKm⟩, ?_⟩
    -- #### B2: uniqueness consequences
    intro H _ _ _ _ hK
    -- Moore uniqueness against the model
    obtain ⟨hrange, hnormeq⟩ :=
      ZFinAux.moore_uniqueness (H₁ := ↥(Sw w)) (H₂ := H) (hk := hKm.trans hK.symm)
    -- the model's function range is exactly the set of combinations of `w`
    have hMrange : Set.range (fun g : ↥(Sw w) => (g : X → ℂ))
        = {g : X → ℂ | ∃ ζ : Fin n → ℂ, g = ∑ k, ζ k • w k} := by
      ext g
      constructor
      · rintro ⟨gg, rfl⟩
        simp only [Set.mem_setOf_eq]
        rw [hcoeF gg]
        obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp gg.2
        exact ⟨c, hc.symm⟩
      · rintro ⟨ζ, rfl⟩
        refine ⟨∑ k, ζ k • wf w k, ?_⟩
        show ((∑ k, ζ k • wf w k : ↥(Sw w)) : X → ℂ) = ∑ k, ζ k • w k
        rw [hcoeF _]
        rw [show ((∑ k, ζ k • wf w k : ↥(Sw w)).val : X → ℂ)
            = ∑ k, ζ k • w k from by
          rw [Submodule.coe_sum (Sw w) (fun k => ζ k • wf w k) Finset.univ]
          exact Finset.sum_congr rfl fun k _ => rfl]
    have hr1 : Set.range (fun f : H => (f : X → ℂ))
        = {g : X → ℂ | ∃ ζ : Fin n → ℂ, g = ∑ k, ζ k • w k} := hrange.symm.trans hMrange
    -- finite-dimensionality via the injective coordinate map into the model
    have hmemb : ∀ f : H, (f : X → ℂ) ∈ Sw w := by
      intro f
      have hmem : (f : X → ℂ) ∈ Set.range (fun f : H => (f : X → ℂ)) := ⟨f, rfl⟩
      rw [hr1] at hmem
      simp only [Set.mem_setOf_eq] at hmem
      obtain ⟨ζ, hζ⟩ := hmem
      rw [hζ]
      exact Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _ (memSw w k)
    -- the injective linear map `H → ↥(Sw w)`
    let φ : H →ₗ[ℂ] ↥(Sw w) :=
      { toFun := fun f => ⟨(f : X → ℂ), hmemb f⟩
        map_add' := fun f g => by
          apply Subtype.ext
          funext x
          simp
        map_smul' := fun c f => by
          apply Subtype.ext
          funext x
          simp }
    have hφinj : Function.Injective ⇑φ := by
      intro f g hfg
      have hval : (f : X → ℂ) = (g : X → ℂ) := congrArg Subtype.val hfg
      exact RKHS.ext fun x => congrFun hval x
    have hfin : FiniteDimensional ℂ H := FiniteDimensional.of_injective φ hφinj
    refine ⟨hfin, hr1, ?_⟩
    -- #### the norm formula (2): `‖f‖² = ∑ᵢⱼ αᵢⱼ ζᵢ ζ̄ⱼ` with `α = β̄⁻¹`
    intro f ζ hf
    have hgζfn : ((∑ k, ζ k • wf w k : ↥(Sw w)) : X → ℂ) = ∑ k, ζ k • w k := by
      rw [hcoeF _]
      rw [show ((∑ k, ζ k • wf w k : ↥(Sw w)).val : X → ℂ)
          = ∑ k, ζ k • w k from by
        rw [Submodule.coe_sum (Sw w) (fun k => ζ k • wf w k) Finset.univ]
        exact Finset.sum_congr rfl fun k _ => rfl]
    have hnm : ‖(∑ k, ζ k • wf w k : ↥(Sw w))‖ = ‖f‖ :=
      hnormeq _ _ (hgζfn.trans hf.symm)
    -- the model element has coordinates `ζ`
    have hreprζ : ∀ i : Fin n,
        (((bS w hw).repr (∑ k, ζ k • wf w k) : Fin n → ℂ)) i = ζ i :=
      repr_comb_fn w hw ζ
    have hinSval : inS w β hw (∑ k, ζ k • wf w k) (∑ k, ζ k • wf w k)
        = ∑ i, ∑ j, (G β) i j * star (ζ i) * ζ j := by
      show ∑ i, ∑ j, (G β) i j
          * star (((bS w hw).repr (∑ k, ζ k • wf w k) : Fin n → ℂ) i)
          * (((bS w hw).repr (∑ k, ζ k • wf w k) : Fin n → ℂ) j) = _
      simp only [hreprζ]
    -- self-inner-products are real
    have hreal : ∀ z : ℂ, RCLike.im z = 0 → ((RCLike.re z : ℝ) : ℂ) = z := fun z hz =>
      Complex.ext (by rw [Complex.ofReal_re]; rfl) (by rw [Complex.ofReal_im]; exact hz.symm)
    -- `(β̄)⁻¹ = (β⁻¹)ᵀ` for Hermitian `β`
    have hinv : (β.map star)⁻¹ = (G β).transpose := by
      rw [herm_eq β hβ.1]
      exact (Matrix.transpose_nonsing_inv β).symm
    calc ((‖f‖ ^ 2 : ℝ) : ℂ)
        = ((‖(∑ k, ζ k • wf w k : ↥(Sw w))‖ ^ 2 : ℝ) : ℂ) := by rw [hnm]
      _ = ((RCLike.re ⟪(∑ k, ζ k • wf w k : ↥(Sw w)),
            (∑ k, ζ k • wf w k : ↥(Sw w))⟫_ℂ : ℝ) : ℂ) :=
            congrArg _ ((@inner_self_eq_norm_sq ℂ ↥(Sw w) _ _ ipsN
              (∑ k, ζ k • wf w k : ↥(Sw w))).symm)
      _ = ⟪(∑ k, ζ k • wf w k : ↥(Sw w)),
          (∑ k, ζ k • wf w k : ↥(Sw w))⟫_ℂ :=
            hreal ⟪(∑ k, ζ k • wf w k : ↥(Sw w)),
              (∑ k, ζ k • wf w k : ↥(Sw w))⟫_ℂ
              (@inner_self_im ℂ ↥(Sw w) _ _ ipsN
                (∑ k, ζ k • wf w k : ↥(Sw w)))
      _ = inS w β hw (∑ k, ζ k • wf w k) (∑ k, ζ k • wf w k) :=
            (hinner _ _).symm
      _ = ∑ i, ∑ j, (G β) i j * star (ζ i) * ζ j := hinSval
      _ = ∑ i, ∑ j, (β.map star)⁻¹ i j * ζ i * star (ζ j) := by
            rw [hinv]
            simp only [Matrix.transpose_apply]
            rw [sum2_comm (fun i j => (G β) j i * ζ i * star (ζ j))]
            refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
            ring
