namespace C1Glue

/-- The σ-algebra generated by the first `k + 1` coordinates of a path. -/
def pathSigma (X : Type*) [MeasurableSpace X] (k : ℕ) : MeasurableSpace (ℕ → X) :=
  MeasurableSpace.comap (Preorder.frestrictLe (π := fun _ : ℕ => X) k) inferInstance

/-- The natural filtration of path space. -/
noncomputable def pathFilt (X : Type*) [MeasurableSpace X] :
    Filtration ℕ (inferInstance : MeasurableSpace (ℕ → X)) where
  seq k := pathSigma X k
  mono' i j hij := by
    show pathSigma X i ≤ pathSigma X j
    simp only [pathSigma]
    rw [← Preorder.frestrictLe₂_comp_frestrictLe (π := fun _ : ℕ => X) hij,
      ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono
      (Measurable.comap_le (Preorder.measurable_frestrictLe₂ (X := fun _ : ℕ => X) hij))
  le' k := by
    show pathSigma X k ≤ _
    simp only [pathSigma]
    exact Measurable.comap_le (Preorder.measurable_frestrictLe (X := fun _ : ℕ => X) k)

variable {Ω : Type*} {m0 : MeasurableSpace Ω}

/-- A factor measurable with respect to the past is orthogonal to a martingale increment. -/
lemma integral_mul_past_eq_zero (μ : Measure Ω) [IsFiniteMeasure μ]
    (ℱ : Filtration ℕ m0) (V c : Ω → ℝ) (j : ℕ)
    (hV : MemLp V 2 μ) (hc : MemLp c 2 μ)
    (hcm : StronglyMeasurable[ℱ j] c) (hmds : μ[V | ℱ j] =ᵐ[μ] 0) :
    ∫ ω, V ω * c ω ∂μ = 0 := by
  have hint : Integrable V μ := hV.integrable one_le_two
  have hintmul : Integrable (fun ω => c ω * V ω) μ := hc.integrable_mul hV
  have hpull : μ[fun ω => c ω * V ω | ℱ j] =ᵐ[μ] fun ω => c ω * (μ[V | ℱ j]) ω := by
    have := condExp_mul_of_stronglyMeasurable_left (m := ℱ j) (μ := μ)
      (f := c) (g := V) hcm (by simpa [Pi.mul_apply] using hintmul) hint
    simpa [Pi.mul_apply] using this
  have hzero : μ[fun ω => c ω * V ω | ℱ j] =ᵐ[μ] 0 := by
    filter_upwards [hpull, hmds] with ω h1 h2
    simp [h1, h2]
  have hkey : ∫ ω, c ω * V ω ∂μ = 0 := by
    calc ∫ ω, c ω * V ω ∂μ
        = ∫ ω, (μ[fun ω => c ω * V ω | ℱ j]) ω ∂μ := (integral_condExp (ℱ.le j)).symm
      _ = 0 := by rw [integral_congr_ae hzero]; simp
  simpa [mul_comm] using hkey

end C1Glue

open C1Glue

theorem solution {S : Type*} [Fintype S] [DecidableEq S]
    [MeasurableSpace S] [MeasurableSingletonClass S]
    (M : Model S) (m : S → Bool → ℝ) (v : S → Bool → ℝ≥0)
    (hgauss : M.GaussianRewards m v)
    (hpos : ∀ s a j, 0 < M.trans s (M.act a s) j)
    (ν : Measure (Step S)) [IsProbabilityMeasure ν]
    (hinv : Kernel.Invariant (expKernel M) ν)
    (huni : MarkovChainCLT.UniformlyErgodic (expKernel M) ν)
    (δ : (T : ℕ) → (Fin T → Step S) → S → ℝ)
    (hmeas : ∀ T s, Measurable (fun path => δ T path s))
    (hL2 : ∀ T s, MemLp (fun ω : ℕ → Step S => δ T (fun i => ω (i.1 + 1)) s) 2
      (MarkovChainCLT.chainMeasure (expKernel M) ν))
    (hunbiased : ∀ (M' : Model S), M'.crucial = M.crucial → M'.γdisc = M.γdisc →
      (∃ m' : S → Bool → ℝ, M'.GaussianRewards m' v) →
      ∀ (ν' : Measure (Step S)) (_ : IsProbabilityMeasure ν'),
        Kernel.Invariant (expKernel M') ν' →
        MarkovChainCLT.UniformlyErgodic (expKernel M') ν' →
        ∀ T : ℕ, 1 ≤ T → ∀ s,
          ∫ ω, δ T (fun i => ω (i.1 + 1)) s
            ∂(MarkovChainCLT.chainMeasure (expKernel M') ν') = M'.ate s) :
    ∀ w : S → ℝ, ∃ κ : ℝ, 0 ≤ κ ∧ ∀ T : ℕ, 1 ≤ T →
      ∃ g : (ℕ → Step S) → ℝ,
        MemLp g 2 (MarkovChainCLT.chainMeasure (expKernel M) ν) ∧
        ∫ ω, g ω ∂(MarkovChainCLT.chainMeasure (expKernel M) ν) = 0 ∧
        ∫ ω, (∑ s, w s * δ T (fun i => ω (i.1 + 1)) s) * g ω
            ∂(MarkovChainCLT.chainMeasure (expKernel M) ν)
          = ∑ s, ∑ s', w s * mbISCov M ν s s' * w s' ∧
        ∫ ω, (g ω) ^ 2 ∂(MarkovChainCLT.chainMeasure (expKernel M) ν)
          ≤ ((T : ℝ) + κ) * ∑ s, ∑ s', w s * mbISCov M ν s s' * w s' := by
  classical
  intro w
  obtain ⟨V, c, hVmem, hVadapt, hVmds, hVsq, hcmem, hcadapt, hc0, hcov⟩ :=
    TreatmentLocality.exists_martingale_score_of_unbiased M m v hgauss hpos ν hinv huni
      δ hmeas hL2 hunbiased w
  set P := MarkovChainCLT.chainMeasure (expKernel M) ν with hP
  set Q := ∑ s, ∑ s', w s * mbISCov M ν s s' * w s' with hQdef
  have hQ0 : 0 ≤ Q := by
    rw [← hVsq 0]
    exact integral_nonneg fun ω => sq_nonneg _
  by_cases hQz : Q = 0
  · refine ⟨0, le_refl 0, fun T hT => ⟨fun _ => (0 : ℝ), memLp_const 0, by simp, ?_, ?_⟩⟩
    · simp [hQz]
    · simp [hQz]
  · have hQpos : 0 < Q := lt_of_le_of_ne hQ0 (Ne.symm hQz)
    have hc2 : 0 ≤ ∫ ω, (c ω) ^ 2 ∂P := integral_nonneg fun ω => sq_nonneg _
    -- transport the adaptedness and martingale hypotheses to the path filtration
    have hVadapt' : ∀ j, StronglyMeasurable[(pathFilt (Step S)) (j + 1)] (V j) := hVadapt
    have hVmds' : ∀ j, P[V j | (pathFilt (Step S)) j] =ᵐ[P] 0 := hVmds
    have hcadapt' : ∀ j, StronglyMeasurable[(pathFilt (Step S)) j] c := fun j =>
      (show StronglyMeasurable[(pathFilt (Step S)) 0] c from hcadapt).mono
        ((pathFilt (Step S)).mono (Nat.zero_le j))
    have hVint : ∀ j, Integrable (V j) P := fun j => (hVmem j).integrable one_le_two
    have hVzero : ∀ j, ∫ ω, V j ω ∂P = 0 := by
      intro j
      have h1 : ∫ ω, (P[V j | (pathFilt (Step S)) j]) ω ∂P = ∫ ω, V j ω ∂P :=
        integral_condExp ((pathFilt (Step S)).le j)
      rw [← h1, integral_congr_ae (hVmds' j)]
      simp
    refine ⟨(∫ ω, (c ω) ^ 2 ∂P) / Q, div_nonneg hc2 hQ0, fun T hT => ?_⟩
    have hSmem : MemLp (fun ω => ∑ j ∈ Finset.range T, V j ω) 2 P :=
      memLp_finsetSum (μ := P) (p := 2) (Finset.range T) (f := fun j ω => V j ω)
        (fun j _ => hVmem j)
    have hSint : Integrable (fun ω => ∑ j ∈ Finset.range T, V j ω) P :=
      integrable_finsetSum (μ := P) (f := fun j ω => V j ω) (Finset.range T) (fun j _ => hVint j)
    refine ⟨fun ω => (∑ j ∈ Finset.range T, V j ω) + c ω, hSmem.add hcmem, ?_, hcov T hT, ?_⟩
    · rw [integral_add hSint (hcmem.integrable one_le_two),
        integral_finsetSum (μ := P) (f := fun j ω => V j ω) (Finset.range T)
          (fun j _ => hVint j), hc0]
      simp [hVzero]
    · -- the second moment: Pythagoras for the martingale part, no cross term, plus `∫ c²`
      have hpyth : ∫ ω, (∑ j ∈ Finset.range T, V j ω) ^ 2 ∂P
          = ∑ j ∈ Finset.range T, ∫ ω, (V j ω) ^ 2 ∂P :=
        Martingale.integral_sq_sum_eq_sum_integral_sq P (pathFilt (Step S)) V hVmem
          hVadapt' hVmds' T
      have hsq : ∑ j ∈ Finset.range T, ∫ ω, (V j ω) ^ 2 ∂P = (T : ℝ) * Q := by
        simp [hVsq, Finset.sum_const, mul_comm]
      have hcross : ∫ ω, (∑ j ∈ Finset.range T, V j ω) * c ω ∂P = 0 := by
        have e : (fun ω => (∑ j ∈ Finset.range T, V j ω) * c ω)
            = fun ω => ∑ j ∈ Finset.range T, V j ω * c ω := by
          funext ω; rw [Finset.sum_mul]
        rw [e, integral_finsetSum (μ := P) (f := fun j ω => V j ω * c ω) (Finset.range T)
          (fun j _ => (hVmem j).integrable_mul hcmem)]
        refine Finset.sum_eq_zero fun j _ => ?_
        exact integral_mul_past_eq_zero P (pathFilt (Step S)) (V j) c j (hVmem j) hcmem
          (hcadapt' j) (hVmds' j)
      have hexp : (fun ω => ((∑ j ∈ Finset.range T, V j ω) + c ω) ^ 2)
          = fun ω => (∑ j ∈ Finset.range T, V j ω) ^ 2
              + (2 * ((∑ j ∈ Finset.range T, V j ω) * c ω) + (c ω) ^ 2) := by
        funext ω; ring
      have hi1 : Integrable (fun ω => (∑ j ∈ Finset.range T, V j ω) ^ 2) P := hSmem.integrable_sq
      have hi2 : Integrable (fun ω => 2 * ((∑ j ∈ Finset.range T, V j ω) * c ω)) P :=
        (hSmem.integrable_mul hcmem).const_mul 2
      have hi3 : Integrable (fun ω => (c ω) ^ 2) P := hcmem.integrable_sq
      have hi23 : Integrable (fun ω => 2 * ((∑ j ∈ Finset.range T, V j ω) * c ω) + (c ω) ^ 2) P :=
        hi2.add hi3
      rw [hexp, integral_add hi1 hi23, integral_add hi2 hi3, integral_const_mul,
        hpyth, hsq, hcross]
      have hfin : ((T : ℝ) + (∫ ω, (c ω) ^ 2 ∂P) / Q) * Q
          = (T : ℝ) * Q + ∫ ω, (c ω) ^ 2 ∂P := by
        field_simp
      rw [hfin]
      linarith
