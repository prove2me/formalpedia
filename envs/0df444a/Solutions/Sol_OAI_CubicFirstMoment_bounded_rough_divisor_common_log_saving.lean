lemma rough_common_large_outer {Z A D : ℝ} (hZ : 2 ≤ Z)
    (hD : 0 < D) (hDhi : D ≤ Z^(1/1000:ℝ)) (hA : Z^(3/2:ℝ) ≤ A) :
