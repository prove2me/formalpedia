  have h𝔫inj : Function.Injective (Ideal.quotientMap xT (algebraMap (Pz.B₀ ⧸ 𝔭z) ((Pz.B₀ ⧸ 𝔭z) ⊗[V] A)) (le_of_eq h𝔫def.symm) : (Pz.B₀ ⧸ 𝔭z) ⧸ 𝔫 →+* ((Pz.B₀ ⧸ 𝔭z) ⊗[V] A) ⧸ xT) := by
