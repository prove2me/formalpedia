  induction n using Nat.strong_induction_on with
  | _ n ihn =>
  intro p
  induction p with
  | skip => intro s s' c h; simp [IStmt.run] at h; obtain ⟨rfl, rfl⟩ := h; exact .skip s
  | op o => intro s s' c h; simp only [IStmt.run] at h; exact .op (IOp.run_step h)
  | seq p q ihp ihq =>
    intro s s' c h
    simp only [IStmt.run] at h
    split at h <;> try simp at h
    rename_i s₁ c₁ h₁
    split at h <;> try simp at h
    rename_i s₂ c₂ h₂
    obtain ⟨rfl, rfl⟩ := h
    exact .seq (ihp _ _ _ h₁) (ihq _ _ _ h₂)
  | ite i f p q ihp ihq =>
    intro s s' c h
    simp only [IStmt.run] at h
    split_ifs at h with hf
    · obtain ⟨⟨s₁, c₁⟩, h₁, he⟩ := Option.map_eq_some_iff.mp h
      simp only [Prod.mk.injEq] at he; obtain ⟨rfl, rfl⟩ := he
      exact .iteT hf (ihp _ _ _ h₁)
    · obtain ⟨⟨s₁, c₁⟩, h₁, he⟩ := Option.map_eq_some_iff.mp h
      simp only [Prod.mk.injEq] at he; obtain ⟨rfl, rfl⟩ := he
      exact .iteF (by simpa using hf) (ihq _ _ _ h₁)
