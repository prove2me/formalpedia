    simp [Ne.symm h0, Ne.symm h1, Ne.symm h2, Ne.symm h3, Ne.symm h4, Ne.symm h5, Ne.symm h6]

theorem c1_notin (K ρ f : ℕ) (g : Geo) : NLogN.KFL.c1 ∉ (NLogN.KFL.p1B K ρ f g).writes := by
