theorem GlobalTheory.JetOnly.coeff_DmonOf_congr (F : Fin d → PS k 2 d) {ι : Type} [Fintype ι] (u : ι → Fin d → k)
    (m : ι →₀ ℕ) (f g : PS k 1 d) (n : ℕ)
    (h : ∀ mo : Fin 1 × Fin d →₀ ℕ, mo.degree ≤ n + m.degree → coeff mo f = coeff mo g)
    (mo : Fin 1 × Fin d →₀ ℕ) (hmo : mo.degree ≤ n) :
    coeff mo (DmonOf F u m f) = coeff mo (DmonOf F u m g) := by sorry
