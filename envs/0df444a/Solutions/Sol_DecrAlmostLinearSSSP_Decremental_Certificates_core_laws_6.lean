set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreGradientEndpoints
open Structured
lemma tail_eval (s : Data) : Eval tailCode s 3 (tailPrepared s) := eval_sequence_atoms tailAtoms s
lemma head_eval (s : Data) : Eval headCode s 3 (headPrepared s) := eval_sequence_atoms headAtoms s
lemma tail_fields (s : Data) (hz : s.realReg 56 = 0) :
    (tailPrepared s).natReg 620 = s.natReg 554+2*s.natReg 626 ∧
    (tailPrepared s).realReg 626 = -s.realReg 612 := by
  simp [tailPrepared,tailAtoms,Atom.effect,instructionEffect,data,Data.machine,hz,two_mul]
lemma head_fields (s : Data) (hz : s.realReg 56 = 0) :
    (headPrepared s).natReg 620 = s.natReg 554+2*s.natReg 628 ∧
    (headPrepared s).realReg 626 = s.realReg 612 := by
  simp [headPrepared,headAtoms,Atom.effect,instructionEffect,data,Data.machine,hz,two_mul]
lemma tail_nat_frame (k : ℕ) (hk : k ≠ 620) : NatFrame tailCode k := by simp [tailCode,tailAtoms,Structured.sequence,NatFrame,writesNat,Ne.symm hk]
lemma head_nat_frame (k : ℕ) (hk : k ≠ 620) : NatFrame headCode k := by simp [headCode,headAtoms,Structured.sequence,NatFrame,writesNat,Ne.symm hk]
lemma tail_real_frame (k : ℕ) (hk : k ≠ 626) : RealFrame tailCode k := by simp [tailCode,tailAtoms,Structured.sequence,RealFrame,writesReal,Ne.symm hk]
lemma head_real_frame (k : ℕ) (hk : k ≠ 626) : RealFrame headCode k := by simp [headCode,headAtoms,Structured.sequence,RealFrame,writesReal,Ne.symm hk]
lemma tail_no_memory : NoMemory tailCode := by simp [tailCode,tailAtoms,Structured.sequence,NoMemory,NoStore]
lemma head_no_memory : NoMemory headCode := by simp [headCode,headAtoms,Structured.sequence,NoMemory,NoStore]
end DecrAlmostLinearSSSP.Decremental.CoreGradientEndpoints
