    have hF' : IRuns I iprog ditSegF s5 s6 (1000 * (n + 3)) := by
      apply IRuns.of_runsTo 0
      simp +decide [ditSegF, IStmt.run, IOp.run, s5, s4, s3, s2, NLogN.zsz_two_pow]
      refine ⟨by simp only [hs6, hs5, hs4, hs3, hs2]; clear * - hL hDE; ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
      omega
    -- segment C: dt from U to V
    have hC := mvH_runs (I := I) (iprog := iprog) (X := U) (Y := NLogN.V) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) s6 dt.reverse (s.G U) (s.G HH)
      (n + 1) (by simp +decide [s6, s5, s4, s3, s2, s1, ints_reverse])
      (by simp +decide [s6, s5, s4, s3, s2, s1, hdtl])
