--   Georges Gonthier, A Computer-Checked Proof of the Four Colour Theorem (2005), https://www.microsoft.com/en-us/research/wp-content/uploads/2012/10/4colproof.pdf; Section 5.5, PDF p. 45, paragraph on PDF p. 45 giving the discharge formula; PDF pp. 44–48, interval splitting, configuration matching, hubcap and presentation paragraphs. Relevant displays are unnumbered. Pinned executable reference: https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/hubcap.v#L126-L153; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/hubcap.v#L305-L375; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/present.v#L74-L204. Georges Gonthier, A Computer-Checked Proof of the Four Colour Theorem (2005), https://www.microsoft.com/en-us/research/wp-content/uploads/2012/10/4colproof.pdf; Section 5.5, PDF p. 45, paragraph on PDF p. 45 giving the unnumbered discharge formula; PDF pp. 44–48, including the 71-pattern paragraph on p. 45. Relevant displays are unnumbered. Pinned executable reference: https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/part.v#L159-L175; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/part.v#L603-L626; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/part.v#L801-L852; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/part.v#L892-L927; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/discharge.v#L66-L172; https://github.com/rocq-community/fourcolor/blob/c1d6b1cd5288bea4b067aac13cdde3c18dffe018/theories/proof/discharge.v#L378-L398.

import Definitions.Def_FourColor_Reflection
import Definitions.Def_FourColor_DischargeCertificate

namespace FourColor
theorem discharge_presentation_soundness :
  ∀ (catalogue : List Configuration), (∀ C ∈ catalogue, C.Embeddable) →
    ∀ (degree : ℕ) (certificate : Discharge.PresentationCertificate catalogue),
      Discharge.checkPresentation catalogue degree certificate = true →
        ∀ (n : ℕ) (H : Hypermap n), H.Plain → H.Cubic →
          (∀ x : Fin n, 5 ≤ H.faceArity x) → ∀ x : Fin n,
            H.faceArity x = degree → 0 < Discharge.score H x →
              ∃ C ∈ catalogue, C.OccursUpToReflection H := by sorry
end FourColor
