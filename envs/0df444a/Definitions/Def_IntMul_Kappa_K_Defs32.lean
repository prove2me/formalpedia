-- Source module: Solutions.KFWC11
/-!
# KFW C-layer 11: the run-time loops `EACC` (total scale) and `LOGp` (level `k = log_m D`)

Both loops are continuation-passing: the last iteration runs a continuation code `cont`
(with the computed values in registers), every other iteration calls the loop again.

* `eaccC jE cont`: registers `11 j`, `12 R`, `13 acc`, `14 m^j`, `15 ES j` (`LowR`); takes
  `ES j` while `R ≥ m^j`, steps down while `j > 0`, then pushes
  `E = acc + q₀ + ⌊D/2⌋ + D mod 2` on `24` and runs `cont`.  **`eaccQ`**: `acc = lowF ES k D'`.
* `logC jG cont`: registers `11 k'`, `12 G^{k'}`, `13 W^{k'}`, `14 m^{k'}`, `15 ES k'` (`LogR`),
  steps while `m^{k'+1} ≤ D`, then runs `cont`.  **`logQ`**: `k' = log_m D`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-! ## The scale loop -/

/-- The take frame of the scale loop. -/
def eTk : List (Fin HS × NE) := [(12, .sub (.reg 12) (.reg 14)), (13, .add (.reg 13) (.reg 15))]

/-- The final frame: `E = acc + q₀ + ⌊D/2⌋ + D mod 2` on `24`. -/
def eFin : List (Fin HS × NE) :=
  [(24, .add (.add (.reg 13) (.reg 28)) (.add (.div (.reg 22) (.lit 2)) (.mod (.reg 22) (.lit 2))))]

/-- The scale loop. -/
noncomputable def eaccC {Pp : ℕ} (jE : Fin Pp) (cont : IStmt HS Pp) : IStmt HS Pp :=
  testC 16 (.lt (.reg 12) (.reg 14) (.lit 1) (.lit 0))
    (withPushI (fr eTk) (.call jE))
    (testC 17 (.lt (.lit 0) (.reg 11) (.lit 0) (.lit 1)) (withPushI (fr lowDn) (.call jE))
      (withPushI (fr eFin) cont))

/-- Per-iteration overhead of the loops. -/
def cEO (Bz : ℕ) : ℕ :=
  2 + 2 * (cFrame 1 12 Bz + 25 + (1 * (2 * Bz + 2) + 1)) + cFrame 5 12 Bz + 2 +
    (5 * (2 * Bz + 2) + 1)

section Loops

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

end Loops

end NLogN.KFW

end

section
-- Source module: Solutions.KFWC12
/-!
# KFW C-layer 12: the level loop `LOGp`

Descriptor registers (`DescR`): `21 P`, `1 K`, `22 D`, `3 S`, `23 ρ`, `4 r`, `25 w` (a width bound).
Loop registers (`LogR`): `11 j`, `12 G^j`, `13 W^j`, `14 m^j`, `15 ES j` (`G = Gb Lc sc W A₀`).

**`logQ`**: `logC jG cont` steps `j ↦ j + 1` while `m^{j+1} ≤ D`, then runs `cont` with
`j = log_m D`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-- The descriptor registers. -/
structure DescR (σ : Fin HS → Option ℤ) (P K D S ρ r w : ℕ) : Prop where
  base : BaseR σ
  hP : σ 21 = some (P : ℤ)
  hK : σ 1 = some (K : ℤ)
  hD : σ 22 = some (D : ℤ)
  hS : σ 3 = some (S : ℤ)
  hρ : σ 23 = some (ρ : ℤ)
  hr : σ 4 = some (r : ℤ)
  hw : σ 25 = some (w : ℤ)

/-- The descriptor register list. -/
def descL : List (Fin HS) := [21, 1, 22, 3, 23, 4, 25]

/-- The gate-class growth constant. -/
noncomputable abbrev Gc : ℕ := NLogN.KFN.Gb Lc P8Lift.sc P8Lift.Wc NLogN.KFW.A0

/-- The loop registers of `LOGp`. -/
structure LogR (σ : Fin HS → Option ℤ) (j : ℕ) : Prop where
  h11 : σ 11 = some (j : ℤ)
  h12 : σ 12 = some ((Gc ^ j : ℕ) : ℤ)
  h13 : σ 13 = some ((P8Lift.Wc ^ j : ℕ) : ℤ)
  h14 : σ 14 = some ((mC ^ j : ℕ) : ℤ)
  h15 : σ 15 = some ((ES j : ℕ) : ℤ)

/-- One step of `LOGp`. -/
noncomputable def logStep : List (Fin HS × NE) :=
  [(11, .add (.reg 11) (.lit 1)), (12, .mul (.reg 12) (.lit Gc)), (13, .mul (.reg 13) (.lit P8Lift.Wc)),
    (14, .mul (.reg 14) (.lit mC)), (15, .add (.lit NLogN.KFW.cL) (.mul (.lit P8Lift.sc) (.reg 15)))]

/-- The test `m^{j+1} < D + 1` (value `0` when true). -/
def logCond : NE := .lt (.mul (.reg 14) (.lit mC)) (.add (.reg 22) (.lit 1)) (.lit 0) (.lit 1)

/-- The level loop. -/
noncomputable def logC {Pp : ℕ} (jG : Fin Pp) (cont : IStmt HS Pp) : IStmt HS Pp :=
  testC 16 logCond (withPushI (fr logStep) (.call jG)) cont

section Log

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

end Log

end NLogN.KFW

end

section
-- Source module: Solutions.KFWC7
/-!
# KFW C-layer 7: expression frames and the phase `S_D` of the layer

* `FrXOK`, **`sImplQ_frX`**, **`runQ_frX`**: frames of general expression pushes (with `pow2`).
* **`sdQ`**: the fixed code `sdC` (a frame on `12 … 16`, then the uniform phase pass `phLU` with
  the constant exponent `εLit`) implements `S_D` on the selected bits of the layer.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-! ## Expression frames -/

/-- The side conditions of an expression frame. -/
def FrXOK (σ : Fin HS → Option ℤ) (B sz : ℕ) (l : List (Fin HS × Ex HS × ℤ)) : Prop :=
  ∀ x ∈ l, x.1.val < 56 ∧ x.2.1.Clean ∧ x.2.1.size ≤ sz ∧ ExV σ x.2.1 x.2.2 B

section Frames

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {ι : Type*} [Fintype ι] [DecidableEq ι] {lo hi r : ℕ} {st : ι → ℕ} {n : ℕ}

end Frames

/-! ## The phase `S_D` -/

/-- The frame expressions of `S_D`: `S r`, `K D`, `0`, `2 P S r 2^{KD}`, `ρ + K D - K`. -/
def sdE : List (Fin HS × Ex HS) :=
  [(12, .mul (.reg 3) (.reg 4)), (13, .mul (.reg 1) (.reg 22)), (14, .lit 0),
    (15, .mul (.lit 2) (.mul (.reg 21) (.mul (.mul (.reg 3) (.reg 4)) (.pow2 (.mul (.reg 1) (.reg 22)))))),
    (16, .add (.add (.reg 23) (.mul (.reg 1) (.reg 22))) (.neg (.reg 1)))]

/-- The frame with values. -/
def sdL (K S r P D ρ : ℕ) : List (Fin HS × Ex HS × ℤ) :=
  [(12, .mul (.reg 3) (.reg 4), ((S * r : ℕ) : ℤ)), (13, .mul (.reg 1) (.reg 22), ((K * D : ℕ) : ℤ)),
    (14, .lit 0, ((0 % 4 : ℕ) : ℤ)),
    (15, .mul (.lit 2) (.mul (.reg 21) (.mul (.mul (.reg 3) (.reg 4)) (.pow2 (.mul (.reg 1) (.reg 22))))),
      ((2 * (P * (S * r * 2 ^ (K * D))) : ℕ) : ℤ)),
    (16, .add (.add (.reg 23) (.mul (.reg 1) (.reg 22))) (.neg (.reg 1)), ((ρ + K * (D - 1) : ℕ) : ℤ))]

/-- The exponent expression of `S_D`. -/
def εSD : Ex HS := εLit 16 1 22 ((1 % 4 : ℕ) : ℤ)

/-- The code of `S_D`. -/
def sdC {Pp : ℕ} : IStmt HS Pp := withPushI sdE (fcode (phLU 12 13 21 14 15 εSD))

/-- The cost of `S_D`. -/
def cSD (K S r P D Z : ℕ) (w : ℕ) : ℕ :=
  cFrame 5 16 Z + cPhU w (P * (S * r * 2 ^ (K * D))) (K * D) P Z (S * r) (xPh εSD Z Z) +
    (5 * (2 * Z + 2) + 1)

section SD

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

end SD

end NLogN.KFW

end

section
-- Source module: Solutions.KFWC4
/-!
# KFW C-layer 4: uniform truncation and uniform padding

* `truncU xD xN`: `KFH.truncP` with the divisor `2^Δ` read from `xD` and the item count from
  `xN`; **`runQ_truncU`**: on records at scale `p + Δ` it gives `Q_p` at scale `p` (a fixed run).
* `padPreU xL xQ`, `padPostU xL xQ`: `KFN.padPre/padPost` with the lengths read from registers;
  **`sImplQ_padU`**: a uniform program on `np ≥ n` records implements the same operator on `n`
  records, padded (as `KFN.sImpl_pad`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-! ## Truncation -/

/-- Uniform truncation: divisor on `xD`, item count on `xN`. -/
def truncU (xD xN : Fin HS) : RS :=
  .seq (.push NLogN.KFB.rN (.reg xN)) (.seq (.rep c1 (.reg NLogN.KFB.rN) (.seq (.push qO (.quo (.reg 0) (.reg xD)))
    (.pop 0))) (.seq (NLogN.mvK qO 0 c1 (.reg NLogN.KFB.rN)) (.pop NLogN.KFB.rN)))

section Trunc

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

end Trunc

/-! ## Padding -/

/-- Pad by `Q` zeros (lengths from registers). -/
def padPreU (xL xQ : Fin HS) : RS :=
  .seq (NLogN.mvK 0 qP c1 (.reg xL)) (.seq (.rep c1 (.reg xQ) (.push 0 (.lit 0)))
    (NLogN.mvK qP 0 c1 (.reg xL)))

/-- Unpad (lengths from registers). -/
def padPostU (xL xQ : Fin HS) : RS :=
  .seq (NLogN.mvK 0 qP c1 (.reg xL)) (.seq (.rep c1 (.reg xQ) (.pop 0))
    (NLogN.mvK qP 0 c1 (.reg xL)))

/-- The padded program. -/
def padCU {Pp : ℕ} (xL xQ : Fin HS) (U : IStmt HS Pp) : IStmt HS Pp :=
  .seq (fcode (padPreU xL xQ)) (.seq U (fcode (padPostU xL xQ)))

section Pad

variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}

end Pad

end NLogN.KFW

end

section
-- Source module: Solutions.KFWC9
/-!
# KFW C-layer 9: the `C`-layer `tens Cm` on the whole layer

`clC jT jW`: the top kernels on the bits `x < q₀` (level-`0` calls, `topC` from `i = 0`), then,
if `q₀ < D`, the low bits `q₀ ≤ x < D` by digit pieces (`lowC` from `j = k`, `R = D'`, `o = 0`)
on the layout padded from `P 2^{K q₀}` to `B'` blocks (`padCU` with the frame `padL` on
`17`, `18`).

**`clQ`**: `clC` implements `tens Cm` on the layer, scale `q₀ + lowF ES k D'`, width
`2 q₀ + lowF DWl k D'`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-- The entry frame of the low loop: `j = k`, `R = D'`, `o = 0`, `m^k`, `ES k`. -/
def lowIn : List (Fin HS × NE) :=
  [(11, .reg 27), (12, .reg 29), (13, .lit 0), (14, .reg 32), (15, .reg 19)]

/-- `2 n r` (`n = P 2^{K D} S`). -/
def eL : Ex HS :=
  .mul (.lit 2) (.mul (.mul (.reg 21) (.pow2 (.mul (.reg 1) (.reg 22)))) (.mul (.reg 3) (.reg 4)))

/-- `2 (n' - n) r` (`n' = B' 2^{K D'} S`). -/
def eQ : Ex HS :=
  .mul (.lit 2) (.mul (.add (.mul (.reg 20) (.pow2 (.mul (.reg 1) (.reg 29))))
    (.neg (.mul (.reg 21) (.pow2 (.mul (.reg 1) (.reg 22)))))) (.mul (.reg 3) (.reg 4)))

/-- The pad frame with values. -/
def padL (n np r : ℕ) : List (Fin HS × Ex HS × ℤ) :=
  [(17, NLogN.KFW.eL, ((2 * (n * r) : ℕ) : ℤ)), (18, eQ, ((2 * ((np - n) * r) : ℕ) : ℤ))]

def padE : List (Fin HS × Ex HS) := [(17, NLogN.KFW.eL), (18, eQ)]

/-- The low part. -/
def lowPart {Pp : ℕ} (jW : Fin Pp) : IStmt HS Pp :=
  withPushI padE (padCU 17 18 (withPushI (fr lowIn) (.call jW)))

/-- The test `q₀ < D` (value `0` when true). -/
def clCond : NE := .lt (.reg 28) (.reg 22) (.lit 0) (.lit 1)

/-- The `C`-layer. -/
def clC {Pp : ℕ} (jT jW : Fin Pp) : IStmt HS Pp :=
  .seq (withPushI (fr [(11, .lit 0)]) (.call jT)) (testC 16 clCond (lowPart jW) .skip)

/-- The cost of the low part. -/
noncomputable def cLowPart (Kc : ℝ) (K S r H P D k q0 Bp Z Zr Bz : ℕ) (w : ℕ) : ℕ :=
  cFrame 2 32 Z + (400 * (cPadC (2 * (P * 2 ^ (K * D) * S * r))
      (2 * ((Bp * 2 ^ (K * (D - q0)) * S - P * 2 ^ (K * D) * S) * r)) Z w
      (lowF DWl k (D - q0))
      (fun _ => cFrame 5 12 Bz + (lowF (cLowP Kc K S r H (D - q0) Bp Zr Bz) k (D - q0) +
        (k + 1) * cLowS Bz) + (5 * (2 * Bz + 2) + 1)) + 0) +
    (cFrame 5 12 Bz + (lowF (cLowP Kc K S r H (D - q0) Bp Zr Bz) k (D - q0) +
        (k + 1) * cLowS Bz) + (5 * (2 * Bz + 2) + 1))) + (2 * (2 * Z + 2) + 1)

/-- The cost of the `C`-layer. -/
noncomputable def cCL (Kc : ℝ) (K S r H P D k q0 Bp Z Zr Bz : ℕ) (w : ℕ) : ℕ :=
  (cFrame 1 12 Bz + (q0 * (⌊cbW Kc K 0 * ((P * 2 ^ (K * D) * S * Yu r Zr H : ℕ) : ℝ)⌋₊ +
      cTopO Bz) + cTopE Bz + 2) + (1 * (2 * Bz + 2) + 1)) +
    (cFrame 1 12 Bz + (cLowPart Kc K S r H P D k q0 Bp Z Zr Bz (w + 2 * q0) + 25) +
      (1 * (2 * Bz + 2) + 1))

section CL

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

/-- The conditions of the low part. -/
structure LowPre (K S r H P D ρ k q0 Bp Z Zr Mb Bz : ℕ) : Prop where
  ctx : LowCtx K S r H P D ρ k q0 Bp Z Zr Mb Bz
  hR : D - q0 < mC ^ (k + 1)
  hBp : P * 2 ^ (K * q0) ≤ Bp

end CL

end NLogN.KFW

