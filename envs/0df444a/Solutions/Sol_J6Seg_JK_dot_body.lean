theorem clean_of_regs {e : Ex HS} (h : ∀ i ∈ e.regs, i.val < 56) : e.Clean :=
  fun i hi => RS.clean_of_lt (h i hi) i (by simp [Ex.regs])

theorem zsz_pow2_le (P : ℕ) : zsz ((2 : ℤ) ^ P) ≤ P + 1 := by
  apply zsz_le_of_lt
  rw [Int.natAbs_pow]
  exact Nat.pow_lt_pow_right (by norm_num) (by omega)

theorem rsE_size (r : Fin HS) : (rsE r).size = 18 := rfl

theorem rsE_spec (t : IState HS) (r : Fin HS) (x : ℤ) (P B : ℕ) (hr : t.IsInt r)
    (hx : t.top r = x) (hpi : t.IsInt rP) (hp : t.top rP = 2 ^ P) (hp1i : t.IsInt rP1)
    (hp1 : t.top rP1 = 2 ^ (P + 1)) (hB : zsz x + 3 ≤ B) (hPB : P + 3 ≤ B) :
    (rsE r).ok t ∧ (rsE r).Lin ∧ (rsE r).Bnd t B ∧ (rsE r).eval t = J6Seg.rs P x := by
  have hd : 0 < (Ex.reg (S := HS) rP1).eval t := by simp [Ex.eval, hp1]
  have hev : (rsE r).eval t = J6Seg.rs P x := by
    rw [rsE, floorDivE_eval _ _ _ hd, rs_eq]; simp only [Ex.eval, hx, hp, hp1]; ring_nf
  have z1 : zsz (x + x) ≤ zsz x + 1 := by have := zsz_add_le x x; simpa using this
  have z3 := zsz_pow2_le P
  have z4 := zsz_pow2_le (P + 1)
  have z2 : zsz (x + x + 2 ^ P) + 1 ≤ B := by
    have h := zsz_add_le (x + x) (2 ^ P)
    rcases le_total (zsz (x + x)) (zsz ((2 : ℤ) ^ P)) with hm | hm
    · rw [max_eq_right hm] at h; omega
    · rw [max_eq_left hm] at h; omega
  have z5 : zsz ((x + x + 2 ^ P) / 2 ^ (P + 1)) + 1 ≤ B := by
    have := zsz_mono (Int.natAbs_ediv_le_natAbs (x + x + 2 ^ P) (2 ^ (P + 1))); omega
  have hm : ∃ m : ℕ, (2 : ℤ) ^ (P + 1) = 2 ^ m := ⟨_, rfl⟩
  refine ⟨?_, ?_, ?_, hev⟩
  · simp [rsE, floorDivE, Ex.ok, Ex.eval, hr, hpi, hp1i, hp1, hm]
  · simp [rsE, floorDivE, Ex.Lin]
  · simp only [rsE, floorDivE, Ex.Bnd, Ex.eval, hx, hp, hp1]
    rw [ediv_of_tdiv _ _ (by positivity)]
    constructorm* _ ∧ _
    all_goals first | omega | (split_ifs <;> first | (rw [zsz_neg, zsz_one]; omega) | (rw [zsz_zero]; omega))

/-! ## The dot loop -/

section dot
variable (P : ℕ) (F : Fin HS → List ℤ) (X : Fin HS) (cs acc R T0 : List ℤ) (S0 : ℤ) (Ls : List ℤ)

variable {P F X cs acc R T0 S0 Ls}

theorem dot_body_sol_aux {M : MulSpec} {Xb Φm Bx : ℕ} (hMB : MulBnd M Xb Φm) (hX : XOK X)
    (s : IState HS) {lp lp1 : List ℤ} (hPX : F PX = []) (hrP : F rP = 2 ^ P :: lp)
    (hrP1 : F rP1 = 2 ^ (P + 1) :: lp1) (N k : ℕ) (hk : k < cs.length)
    (hca : cs.length ≤ acc.length) (hc : zsz cs[k] ≤ Xb) (ha : zsz (acc[k]'(by omega)) ≤ Xb)
    (hXB : 2 * Xb + 3 ≤ Bx) (hPB : P + 3 ≤ Bx) (hS0 : zsz (S0 + dotF P (cs.take k) acc) ≤ Bx)
    (hS1 : zsz (S0 + dotF P (cs.take (k + 1)) acc) ≤ Bx) :
    MSp M (kD X) (encK s (update (dSt P F X cs acc R T0 S0 Ls k) CD [(N : ℤ) - k]))
      (encK s (update (dSt P F X cs acc R T0 S0 Ls (k + 1)) CD [(N : ℤ) - k]))
      (Φm + 10 ^ 5 * (Bx + 2)) := by
