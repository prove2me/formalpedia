private def dens (x : K) : ℝ≥0∞ := (modulus x : ℝ≥0∞)⁻¹

private theorem dens_ne_zero (x : K) : dens x ≠ 0 :=
  ENNReal.inv_ne_zero.mpr ENNReal.coe_ne_top

