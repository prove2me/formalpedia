theorem sq_two_pow_le : ∀ k : ℕ, (k + 2) ^ 2 ≤ 9 * 2 ^ k
  | 0 => by norm_num
  | 1 => by norm_num
  | k + 2 => by
    have ih := sq_two_pow_le (k + 1)
    have : (k + 2 + 2) ^ 2 ≤ 2 * (k + 1 + 2) ^ 2 := by
      have e1 : (k + 2 + 2) ^ 2 = k * k + 8 * k + 16 := by ring
      have e2 : 2 * (k + 1 + 2) ^ 2 = 2 * (k * k) + 12 * k + 18 := by ring
      rw [e1, e2]; omega
    calc (k + 2 + 2) ^ 2 ≤ 2 * (k + 1 + 2) ^ 2 := this
      _ ≤ 2 * (9 * 2 ^ (k + 1)) := by omega
      _ = 9 * 2 ^ (k + 2) := by ring

theorem sq_zsz_le {x : ℕ} (hx : 1 ≤ x) : (zsz (x : ℤ) + 2) ^ 2 ≤ 18 * x := by
  obtain ⟨k, hk⟩ : ∃ k, zsz (x : ℤ) = k := ⟨_, rfl⟩
  rw [hk]
  rcases k with _ | k
  · omega
  · have h1 : ¬ zsz (x : ℤ) ≤ k := by omega
    rw [zsz_le_iff] at h1
    have h2 : 2 ^ k ≤ x := by simpa using h1
    have h3 := sq_two_pow_le (k + 1)
    calc (k + 1 + 2) ^ 2 ≤ 9 * 2 ^ (k + 1) := h3
      _ = 18 * 2 ^ k := by ring
      _ ≤ 18 * x := by omega

