variable {mT : MeasurableSpace (v.adicCompletion ℚ)ˣ} (μ : Measure (v.adicCompletion ℚ)ˣ)

private theorem setIntegral_shell_eq (hmeas : ∀ n : ℤ, MeasurableSet (shell v n))
    (hμ : ∀ n : ℤ, μ (shell v n) = 1) (φ : (v.adicCompletion ℚ)ˣ → ℂ) (τ : ℤ → ℂ)
    (hφ : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) → φ t = τ n)
    (χv : (v.adicCompletion ℚ)ˣ →* ℂˣ) (u : ℂˣ)
    (hχ : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) → χv t = u ^ n)
    (hmod : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) →
      (TateLocal.modulus (t : v.adicCompletion ℚ) : ℝ) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n)
    (s : ℂ) (n : ℤ) :
    ∫ a in shell v n,
        φ a * ((χv a : ℂˣ) : ℂ) * ((TateLocal.modulus (a : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1) ∂μ =
      τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1) := by
  rw [setIntegral_congr_fun (hmeas n)
      (g := fun _ => τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1))
      fun t ht => ?_, setIntegral_const, measureReal_def, hμ n]
  · simp
  · rw [mem_shell] at ht
    simp only [hφ t n ht, hχ t n ht, hmod t n ht]

private theorem summable_shellTerm (hmeas : ∀ n : ℤ, MeasurableSet (shell v n))
    (hμ : ∀ n : ℤ, μ (shell v n) = 1) (φ : (v.adicCompletion ℚ)ˣ → ℂ) (τ : ℤ → ℂ)
    (hφ : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) → φ t = τ n)
    (χv : (v.adicCompletion ℚ)ˣ →* ℂˣ) (u : ℂˣ)
    (hχ : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) → χv t = u ^ n)
    (hmod : ∀ (t : (v.adicCompletion ℚ)ˣ) (n : ℤ), Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-n) →
      (TateLocal.modulus (t : v.adicCompletion ℚ) : ℝ) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n)
    (s : ℂ)
    (hint : Integrable (fun a : (v.adicCompletion ℚ)ˣ =>
      φ a * ((χv a : ℂˣ) : ℂ) * ((TateLocal.modulus (a : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1)) μ) :
    Summable fun n : ℤ =>
      τ n * ((u ^ n : ℂˣ) : ℂ) * (((((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ n : ℝ)) : ℂ) ^ (s - 1) :=
  (hasSum_integral_iUnion hmeas (shell_disjoint v) hint.integrableOn).summable.congr fun n =>
    setIntegral_shell_eq v μ hmeas hμ φ τ hφ χv u hχ hmod s n

