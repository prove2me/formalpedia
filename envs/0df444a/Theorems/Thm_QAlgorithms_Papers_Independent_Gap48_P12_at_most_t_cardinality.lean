-- title:
--   Corollary 1: number of operations with at most n T gates
-- statement:
--   Let $M_n$ be the set of distinct exact one-qubit matrices computed by $H/P/T$ words containing at most $n$ $T$ gates, with no bound on $H/P$ gates. Let $C_1$ be the exact group generated by $H,P$. For every nonnegative integer $n$, both sets are finite and
--
--   $$|M_n|=|C_1|(3\cdot2^n-2)=192(3\cdot2^n-2).$$
--
--   Global phases distinguish matrices. In particular the formula yields $192$ at $n=0$ and $768$ at $n=1$. Finiteness is part of the conclusion, ensuring that the cardinality expression is not a default value for an infinite set.
-- source:
--   Representation of Quantum Circuits with Clifford and $π/8$ Gates, arXiv:0806.3834v1, PDF p. 13, Corollary 1: number of operations with at most n T gates

import Definitions.Def_QAlgorithms_Papers_Independent_Gap48_P12

noncomputable section

namespace QAlgorithms.Papers.Independent.Gap48.P12

local notation "Mat" => Matrix Bool Bool ℂ

local notation "Vec" => EuclideanSpace ℂ Bool

local notation "wordMatrix" => fun (B : CircuitBasis) (w : CircuitWord) =>
  QAlgorithms.Papers.Independent.Next46.P21.wordMatrix (chronologicalInstructions B w)

/-- PDF p.13, Corollary 1: finiteness and both exact count expressions,
including n=0. Count matrices, not words or projective operations. -/
theorem at_most_t_cardinality (n : ℕ) :
    (atMostT n).Finite ∧ (cliffordSet .hp).Finite ∧
    (atMostT n).ncard = (cliffordSet .hp).ncard * (3 * 2 ^ n - 2) ∧
    (atMostT n).ncard = 192 * (3 * 2 ^ n - 2) := by sorry

end QAlgorithms.Papers.Independent.Gap48.P12

end
