theorem Catalog.Geometry.Peel.shellPeel_size(d N k : ℕ) (hd : 0 < d) {R : ℝ} (hR : 0 ≤ R) :
    (shellPeel d R N).size k = ballVol d (shellRadius R d N k) := by sorry
