variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution {w : ℕ} (S T : AModel.Shape) {xs : List ℤ} (h : NLogN.Bnd w xs) : NLogN.Bnd w (AModelL12.embed S T 0 xs) := by
  classical
  intro a ha
  simp only [AModelL12.embed, List.mem_map, List.mem_range] at ha
  obtain ⟨j, -, rfl⟩ := ha
  split_ifs
  · unfold List.getD
    rcases hx : xs[AModel.encode S (AModel.decode T j)]? with _ | x
    · simp [NLogN.zsz_zero]
    · exact h x (List.mem_of_getElem? hx)
  · simp [NLogN.zsz_zero]
end
