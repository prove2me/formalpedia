/-- The finite Boolean algebra generated by genuinely adapted marked
predictable rectangles is measure-dense for every finite measure on the
actual predictable time-history times mark sigma algebra. -/
theorem solution
    {Ω ι E : Type*} [mΩ : MeasurableSpace Ω]
    [LinearOrder ι] [OrderBot ι] [mE : MeasurableSpace E]
    (𝓕 : Filtration ι mΩ)
    [mHist : MeasurableSpace (ι × Ω)]
    (hHist : mHist = 𝓕.predictable)
    [mMarked : MeasurableSpace ((ι × Ω) × E)]
    (hMarked : mMarked = @Prod.instMeasurableSpace (ι × Ω) E mHist mE)
    (μ : Measure ((ι × Ω) × E)) [IsFiniteMeasure μ] :
    let G : Set (Set (ι × Ω)) :=
      {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
                S = ({⊥} ×ˢ A)) ∨
           (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
                S = (Set.Ioi i ×ˢ A))}
    let GM : Set (Set ((ι × Ω) × E)) :=
      Set.image2 (· ×ˢ ·) G {C : Set E | MeasurableSet C}
    μ.MeasureDense (generateSetAlgebra GM) := by
  classical
  let G : Set (Set (ι × Ω)) :=
    {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
              S = ({⊥} ×ˢ A)) ∨
         (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
              S = (Set.Ioi i ×ˢ A))}
  let GM : Set (Set ((ι × Ω) × E)) :=
    Set.image2 (· ×ˢ ·) G {C : Set E | MeasurableSet C}
  change μ.MeasureDense (generateSetAlgebra GM)
  have hSigma : mMarked = MeasurableSpace.generateFrom GM := by
    rw [hMarked]
    exact (avram_wave4_p1_predictable_marked_product_rectangle_generator 𝓕 hHist).symm
  have hAlg : IsSetAlgebra (generateSetAlgebra GM) :=
    isSetAlgebra_generateSetAlgebra
  have hEq : mMarked = MeasurableSpace.generateFrom (generateSetAlgebra GM) := by
    rw [generateFrom_generateSetAlgebra_eq]
    exact hSigma
  exact Measure.MeasureDense.of_generateFrom_isSetAlgebra_finite μ hAlg hEq