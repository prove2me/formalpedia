theorem Formalism.ELL.FormalGroupPointsHom.tan_x_id {z w c v : E} (hw : w ≠ 0) (hM : -2 + W.a₁ * z + W.a₃ * w ≠ 0) (hv : v ≠ 0) :
    (c / v - W.addX (z / w) (z / w) ((3 * (z / w) ^ 2 + 2 * W.a₂ * (z / w) + W.a₄ - W.a₁ * (-1 / w)) /
      (-1 / w - W.negY (z / w) (-1 / w)))) * (v * w ^ 2 * (-2 + W.a₁ * z + W.a₃ * w) ^ 2)
      = tanPX W.a₁ W.a₂ W.a₃ W.a₄ z w c v := by sorry
