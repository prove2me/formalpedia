section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

variable {A : Subring ℝ}

/-- an integer matrix in `SL(2, A)` -/
def mkSL (A : Subring ℝ) (a b c d : ℤ) (h : a * d - b * c = 1) :
    Matrix.SpecialLinearGroup (Fin 2) A :=
  ⟨!![(a : A), b; c, d], by
    rw [Matrix.det_fin_two_of]
    exact_mod_cast congrArg (fun z : ℤ => (z : A)) h⟩

lemma ent_mkSL (a b c d : ℤ) (h : a * d - b * c = 1) :
    ent (mkSL A a b c d h) 0 0 = a ∧ ent (mkSL A a b c d h) 0 1 = b ∧
    ent (mkSL A a b c d h) 1 0 = c ∧ ent (mkSL A a b c d h) 1 1 = d := by
  simp [ent, mkSL]

lemma H_of_G_infty {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G A) (h : f ∞ = ∞) : f ∈ H A :=
  Subgroup.mem_inf.2 ⟨hf, h⟩

/-- rational approximation data -/
lemma rat_data {lo hi : ℝ} (h : lo < hi) :
    ∃ α γ u v : ℤ, 1 ≤ γ ∧ lo < (α : ℝ) / γ ∧ (α : ℝ) / γ < hi ∧ u * α + v * γ = 1 := by
  obtain ⟨q, h1, h2⟩ := exists_rat_btwn h
  have hcop : IsCoprime q.num (q.den : ℤ) := by
    rw [Int.isCoprime_iff_gcd_eq_one]
    have := q.reduced
    rw [Int.gcd, Int.natAbs_natCast]
    exact this
  obtain ⟨u, v, huv⟩ := hcop
  refine ⟨q.num, q.den, u, v, by exact_mod_cast q.pos, ?_, ?_, huv⟩
  · have := Rat.cast_def (K := ℝ) q; push_cast at this ⊢; rw [← this]; exact h1
  · have := Rat.cast_def (K := ℝ) q; push_cast at this ⊢; rw [← this]; exact h2

theorem right_piece (p : ℝ) (n : ℕ) : ∃ R ∈ H ⊥,
    (∀ w : ℝ, w < p → w < n → R (w : OnePoint ℝ) = w) ∧
    (∀ δ : ℝ, 0 < δ → 1 / ((n : ℝ) + 1) ≤ δ / 2 → ∀ q : ℝ, p + δ ≤ q →
      ∃ w : ℝ, R (q : OnePoint ℝ) = w ∧ (n : ℝ) - 2 / δ ≤ w) := by
  have hn1 : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
  obtain ⟨α, γ, u, v, hγ, hlo, hhi, huv⟩ := rat_data (show p < p + 1 / ((n : ℝ) + 1) by linarith)
  set t : ℤ := n + |u| + |α| + 3 with ht
  set D : ℤ := -u + t * γ with hD
  set b : ℤ := -v - t * α with hb
  have hdet : D * -α - b * γ = 1 := by rw [hD, hb]; linear_combination huv
  set k := mkSL ⊥ D b γ (-α) hdet with hk
  obtain ⟨e00, e01, e10, e11⟩ := ent_mkSL (A := ⊥) D b γ (-α) hdet
  have hγR : (1 : ℝ) ≤ γ := by exact_mod_cast hγ
  have hDn : (γ : ℝ) * n ≤ D := by
    have : γ * (n : ℤ) ≤ D := by
      rw [hD, ht]
      have h1 : 0 ≤ |u| := abs_nonneg u
      have h2 : 0 ≤ |α| := abs_nonneg α
      have h3 : u ≤ |u| := le_abs_self u
      have h4 : |u| ≤ γ * |u| := by nlinarith
      have h5 : 0 ≤ γ * |α| := mul_nonneg (by linarith) h2
      have h6 : (-u + (n + |u| + |α| + 3) * γ) - γ * n = (γ * |u| - u) + γ * |α| + 3 * γ := by
        ring
      linarith
    exact_mod_cast this
  have hyp : IsHyperbolic k := by
    unfold IsHyperbolic
    rw [trace_ent, e00, e11]
    have : (2 : ℤ) < D + -α := by
      rw [hD, ht]
      have h3 : -u ≥ -|u| := by linarith [le_abs_self u]
      have h4 : -α ≥ -|α| := by linarith [le_abs_self α]
      nlinarith [abs_nonneg u, abs_nonneg α]
    have : (2 : ℝ) < (D : ℝ) + ((-α : ℤ) : ℝ) := by exact_mod_cast this
    rw [abs_of_pos (by linarith)]; exact this
  have hc : 0 < ent k 1 0 := by rw [e10]; linarith
  obtain ⟨f, hfG, hfin, hfout, hfinf⟩ := glue_in k hyp hc
  -- the key identity for the fixed-point quadratic
  have hQ : ∀ w : ℝ, (γ : ℝ) * Qf k w = ((γ : ℝ) * w - α) * ((γ : ℝ) * w - D) + 1 := by
    intro w
    unfold Qf
    rw [e00, e01, e10, e11]
    have huvR : (u : ℝ) * α + v * γ = 1 := by exact_mod_cast huv
    rw [hD, hb]; push_cast
    linear_combination huvR
  have hqr : (α : ℝ) = γ * ((α : ℝ) / γ) := by field_simp
  refine ⟨f, H_of_G_infty hfG hfinf, ?_, ?_⟩
  · intro w hwp hwn
    apply hfout
    have h1 : (γ : ℝ) * w - α < 0 := by
      rw [hqr]; nlinarith
    have h2 : (γ : ℝ) * w - D < 0 := by nlinarith
    have h3 := hQ w
    have h4 : 0 < (γ : ℝ) * Qf k w := by nlinarith
    exact (pos_of_mul_pos_right h4 (by linarith)).le
  · intro δ hδ hnδ q hq
    have he : (γ : ℝ) * (δ / 2) ≤ (γ : ℝ) * q - α := by
      rw [hqr, ← mul_sub]
      apply mul_le_mul_of_nonneg_left _ (by linarith)
      linarith
    have he' : δ / 2 ≤ (γ : ℝ) * q - α := by nlinarith
    have hepos : 0 < (γ : ℝ) * q - α := by linarith
    by_cases hQq : Qf k q < 0
    · refine ⟨(D * q + b) / (γ * q - α), ?_, ?_⟩
      · rw [hfin q hQq, mob_coe, e00, e01, e10, e11]
        push_cast
        rw [if_neg (by linarith)]
        congr 1
      · have hid : ((D : ℝ) * q + b) / (γ * q - α) = D / γ - 1 / (γ * (γ * q - α)) := by
          have huvR : (u : ℝ) * α + v * γ = 1 := by exact_mod_cast huv
          have hne : (γ : ℝ) * q - α ≠ 0 := by linarith
          have hγ0 : (γ : ℝ) ≠ 0 := by linarith
          have hb' : (γ : ℝ) * b = -D * α - 1 := by
            rw [hD, hb]; push_cast; linear_combination (-1 : ℝ) * huvR
          rw [div_sub_div _ _ hγ0 (mul_ne_zero hγ0 hne), div_eq_div_iff hne
            (mul_ne_zero hγ0 (mul_ne_zero hγ0 hne))]
          linear_combination (γ * (γ * q - α)) * hb'
        rw [hid]
        have h1 : (n : ℝ) ≤ D / γ := by rw [le_div_iff₀ (by linarith)]; linarith
        have h2 : 1 / (γ * (γ * q - α)) ≤ 2 / δ := by
          rw [div_le_div_iff₀ (by positivity) hδ]
          nlinarith
        linarith
    · refine ⟨q, hfout q (not_lt.1 hQq), ?_⟩
      by_contra hlt
      push_neg at hlt
      have h1 : (γ : ℝ) * (2 / δ) < D - γ * q := by nlinarith
      have h2 : (γ : ℝ) * (δ / 2) * ((γ : ℝ) * (2 / δ)) = γ * γ := by field_simp
      have h3 : (γ : ℝ) * γ < ((γ : ℝ) * q - α) * (D - γ * q) := by
        rw [← h2]
        apply mul_lt_mul' he h1 (by positivity) hepos
      have h4 := hQ q
      have h5 : (γ : ℝ) * Qf k q < 0 := by nlinarith
      have h6 : 0 ≤ (γ : ℝ) * Qf k q := mul_nonneg (by linarith) (not_lt.1 hQq)
      linarith

theorem left_piece (p : ℝ) (n : ℕ) : ∃ L ∈ H ⊥,
    (∀ w : ℝ, p < w → -(n : ℝ) < w → L (w : OnePoint ℝ) = w) ∧
    (∀ δ : ℝ, 0 < δ → 1 / ((n : ℝ) + 1) ≤ δ / 2 → ∀ q : ℝ, q ≤ p - δ →
      ∃ w : ℝ, L (q : OnePoint ℝ) = w ∧ w ≤ -(n : ℝ) + 2 / δ) := by
  have hn1 : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
  obtain ⟨α, γ, u, v, hγ, hlo, hhi, huv⟩ := rat_data (show p - 1 / ((n : ℝ) + 1) < p by linarith)
  set t : ℤ := n + |u| + |α| + 3 with ht
  set E : ℤ := u + t * γ with hE
  set b : ℤ := -v + t * α with hb
  have hdet : -E * -α - b * γ = 1 := by rw [hE, hb]; linear_combination huv
  set k := mkSL ⊥ (-E) b γ (-α) hdet with hk
  obtain ⟨e00, e01, e10, e11⟩ := ent_mkSL (A := ⊥) (-E) b γ (-α) hdet
  have hγR : (1 : ℝ) ≤ γ := by exact_mod_cast hγ
  have hEn : (γ : ℝ) * n ≤ E := by
    have : γ * (n : ℤ) ≤ E := by
      rw [hE, ht]
      have h1 : 0 ≤ |u| := abs_nonneg u
      have h2 : 0 ≤ |α| := abs_nonneg α
      have h3 : u ≥ -|u| := by linarith [neg_abs_le u]
      nlinarith
    exact_mod_cast this
  have hyp : IsHyperbolic k := by
    unfold IsHyperbolic
    rw [trace_ent, e00, e11]
    have : -E + -α < (-2 : ℤ) := by
      rw [hE, ht]
      have h3 : u ≥ -|u| := by linarith [neg_abs_le u]
      have h4 : α ≥ -|α| := by linarith [neg_abs_le α]
      nlinarith [abs_nonneg u, abs_nonneg α]
    have : ((-E : ℤ) : ℝ) + ((-α : ℤ) : ℝ) < -2 := by exact_mod_cast this
    rw [abs_of_neg (by linarith)]; linarith
  have hc : 0 < ent k 1 0 := by rw [e10]; linarith
  obtain ⟨f, hfG, hfin, hfout, hfinf⟩ := glue_in k hyp hc
  have hQ : ∀ w : ℝ, (γ : ℝ) * Qf k w = ((γ : ℝ) * w - α) * ((γ : ℝ) * w + E) + 1 := by
    intro w
    unfold Qf
    rw [e00, e01, e10, e11]
    have huvR : (u : ℝ) * α + v * γ = 1 := by exact_mod_cast huv
    rw [hE, hb]; push_cast
    linear_combination huvR
  have hqr : (α : ℝ) = γ * ((α : ℝ) / γ) := by field_simp
  refine ⟨f, H_of_G_infty hfG hfinf, ?_, ?_⟩
  · intro w hwp hwn
    apply hfout
    have h1 : 0 < (γ : ℝ) * w - α := by
      rw [hqr]; nlinarith
    have h2 : 0 < (γ : ℝ) * w + E := by nlinarith
    have h3 := hQ w
    have h4 : 0 < (γ : ℝ) * Qf k w := by nlinarith
    exact (pos_of_mul_pos_right h4 (by linarith)).le
  · intro δ hδ hnδ q hq
    have he : (γ : ℝ) * (δ / 2) ≤ α - (γ : ℝ) * q := by
      rw [hqr, ← mul_sub]
      apply mul_le_mul_of_nonneg_left _ (by linarith)
      linarith
    have he' : δ / 2 ≤ α - (γ : ℝ) * q := by nlinarith
    have hepos : 0 < α - (γ : ℝ) * q := by linarith
    by_cases hQq : Qf k q < 0
    · refine ⟨(-E * q + b) / (γ * q - α), ?_, ?_⟩
      · rw [hfin q hQq, mob_coe, e00, e01, e10, e11]
        push_cast
        rw [if_neg (by linarith)]
        congr 1
      · have hid : ((-E : ℝ) * q + b) / (γ * q - α) = -E / γ + 1 / (γ * (α - γ * q)) := by
          have huvR : (u : ℝ) * α + v * γ = 1 := by exact_mod_cast huv
          have hne : (γ : ℝ) * q - α ≠ 0 := by linarith
          have hne' : (α : ℝ) - γ * q ≠ 0 := by linarith
          have hγ0 : (γ : ℝ) ≠ 0 := by linarith
          have hb' : (γ : ℝ) * b = E * α - 1 := by
            rw [hE, hb]; push_cast; linear_combination (-1 : ℝ) * huvR
          rw [div_add_div _ _ hγ0 (mul_ne_zero hγ0 hne'), div_eq_div_iff hne
            (mul_ne_zero hγ0 (mul_ne_zero hγ0 hne'))]
          linear_combination (γ * (α - γ * q)) * hb'
        rw [hid]
        have h1 : -(E : ℝ) / γ ≤ -n := by
          rw [neg_div, neg_le_neg_iff, le_div_iff₀ (by linarith)]; linarith
        have h2 : 1 / (γ * (α - γ * q)) ≤ 2 / δ := by
          rw [div_le_div_iff₀ (by positivity) hδ]
          nlinarith
        linarith
    · refine ⟨q, hfout q (not_lt.1 hQq), ?_⟩
      by_contra hlt
      push_neg at hlt
      have h1 : (γ : ℝ) * (2 / δ) < γ * q + E := by nlinarith
      have h2 : (γ : ℝ) * (δ / 2) * ((γ : ℝ) * (2 / δ)) = γ * γ := by field_simp
      have h3 : (γ : ℝ) * γ < (α - (γ : ℝ) * q) * (γ * q + E) := by
        rw [← h2]
        apply mul_lt_mul' he h1 (by positivity) hepos
      have h4 := hQ q
      have h5 : (γ : ℝ) * Qf k q < 0 := by nlinarith
      have h6 : 0 ≤ (γ : ℝ) * Qf k q := mul_nonneg (by linarith) (not_lt.1 hQq)
      linarith

theorem exists_tendsto_infty_H_bot' (p : ℝ) :
    ∃ g : ℕ → H ⊥, ∀ C : Set (OnePoint ℝ), IsCompact C → (p : OnePoint ℝ) ∉ C →
      ∀ V ∈ nhds OnePoint.infty, ∀ᶠ n in Filter.atTop, ∀ q ∈ C,
        (g n : OnePoint ℝ ≃ₜ OnePoint ℝ) q ∈ V := by
  choose R hRH hR1 hR2 using right_piece p
  choose L hLH hL1 hL2 using left_piece p
  refine ⟨fun n => ⟨L n * R n, mul_mem (hLH n) (hRH n)⟩, ?_⟩
  intro C hC hpC V hV
  -- δ
  have hCc : Cᶜ ∈ 𝓝 (p : OnePoint ℝ) := hC.isClosed.isOpen_compl.mem_nhds hpC
  rw [nhds_coe_eq, mem_map] at hCc
  obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhds_iff.1 hCc
  -- M1, M2
  obtain ⟨M1, hM1⟩ := eventually_atTop.1 (Filter.mem_map.1 (atTop_le_coe_nhds_infty hV))
  obtain ⟨M2, hM2⟩ := eventually_atBot.1 (Filter.mem_map.1 (atBot_le_coe_nhds_infty hV))
  have hVinf : (∞ : OnePoint ℝ) ∈ V := mem_of_mem_nhds hV
  set N0 : ℝ := max (max (2 / δ) (M1 + 2 / δ)) (max (|p| + 1 + 2 / δ) (2 / δ - M2))
  filter_upwards [(tendsto_natCast_atTop_atTop (R := ℝ)).eventually_ge_atTop N0] with n hn
  have hn1 : 2 / δ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn
  have hn2 : M1 + 2 / δ ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn
  have hn3 : |p| + 1 + 2 / δ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
  have hn4 : 2 / δ - M2 ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hn
  have hnδ : 1 / ((n : ℝ) + 1) ≤ δ / 2 := by
    rw [div_le_div_iff₀ (by positivity) (by norm_num)]
    have : 2 ≤ δ * n := by
      have := mul_le_mul_of_nonneg_left hn1 hδ.le
      rwa [mul_div_cancel₀ _ hδ.ne'] at this
    linarith
  have hp1 : p ≤ |p| := le_abs_self p
  have hδ2 : 0 < 2 / δ := by positivity
  have hp0 : 0 ≤ |p| := abs_nonneg p
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  intro q hq
  show L n (R n q) ∈ V
  cases q with
  | infty =>
    have h1 : R n ∞ = ∞ := (Subgroup.mem_inf.1 (hRH n)).2
    have h2 : L n ∞ = ∞ := (Subgroup.mem_inf.1 (hLH n)).2
    rw [h1, h2]; exact hVinf
  | coe t =>
    have hfar : δ ≤ |t - p| := by
      by_contra h
      push_neg at h
      exact hball (by rw [Metric.mem_ball, Real.dist_eq]; exact h) hq
    rcases le_abs'.1 hfar with h | h
    · -- left side
      have ht : t ≤ p - δ := by linarith
      rw [hR1 n t (by linarith) (by linarith)]
      obtain ⟨w, hw, hwle⟩ := hL2 n δ hδ hnδ t ht
      rw [hw]
      exact hM2 w (by linarith)
    · -- right side
      have ht : p + δ ≤ t := by linarith
      obtain ⟨w, hw, hwle⟩ := hR2 n δ hδ hnδ t ht
      rw [hw, hL1 n w (by linarith) (by linarith)]
      exact hM1 w (by linarith)

end Monod.Dev.Dyn
end

