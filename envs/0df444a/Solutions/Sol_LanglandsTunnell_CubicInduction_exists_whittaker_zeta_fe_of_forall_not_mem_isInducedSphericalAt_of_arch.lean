open NumberField NumberField.InfinitePlace.Completion

variable {K : Type} [Field K] [NumberField K]

omit [NumberField K] in

private theorem extensionEmbedding_div_norm_zpow_two_eq_one_of_isReal {w : InfinitePlace K} (hw : w.IsReal) :
    ∀ x : (w.Completion)ˣ,
      (extensionEmbedding w (x : w.Completion) / ((‖(x : w.Completion)‖ : ℝ) : ℂ)) ^ (2 : ℤ) = 1 := by
  intro x
  have hr : extensionEmbeddingOfIsReal hw (x : w.Completion) ≠ 0 := (map_ne_zero _).mpr x.ne_zero
  have hnorm : ‖(x : w.Completion)‖ = |extensionEmbeddingOfIsReal hw (x : w.Completion)| := by
    rw [← Real.norm_eq_abs,
      (isometry_extensionEmbeddingOfIsReal hw).norm_map_of_map_zero (map_zero (extensionEmbeddingOfIsReal hw))
        (x : w.Completion)]
  rw [← extensionEmbeddingOfIsReal_apply hw, hnorm, ← Complex.ofReal_div, zpow_ofNat, ← Complex.ofReal_pow,
    Complex.ofReal_eq_one, div_pow, sq_abs, div_self (pow_ne_zero 2 hr)]

end LanglandsTunnell.CubicInduction.RealPlaceSign
