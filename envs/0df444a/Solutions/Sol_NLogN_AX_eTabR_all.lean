      wP.run (withCtr CK t0 NK j (iSt T t0 wf NK i j)) = withCtr CK t0 NK j (iSt T t0 wf NK i (j + 1)) ∧
      wP.cost (withCtr CK t0 NK j (iSt T t0 wf NK i j)) ≤ Cw := by
    intro j hj
    have H := hw.spec (withCtr CK t0 NK j (iSt T t0 wf NK i j)) i (NK - 1 - j) Li (t0.G CK) hi
      (by omega)
      (by simp [withCtr, iSt, hd.iK, hd.tI.symm, hI])
      (by simp [withCtr, iSt]; omega)
      (by
        intro x h1 h2 h3
        simp [withCtr, iSt, h2, h3]; exact hO x h1 h3)
      (by simp [withCtr, iSt, hip]) (by simp [withCtr, iSt, hout])
    refine ⟨H.1, ?_, H.2.2⟩
    rw [H.2.1]
    apply IState.ext' _ (by simp [withCtr, iSt]) (by simp [withCtr, iSt])
    intro x
    simp only [withCtr, iSt, IState.upd_G]
    by_cases h1 : x = T
    · subst h1
      simp only [if_neg hd.tK, if_true]
      rw [drop_pred_cons _ NK j (rowL_length _ _ _) hj]
      simp [rowL]
    · simp [h1]
  have R : RepStates CK (.reg RK) wP t0 (iSt T t0 wf NK i) :=
    { nonneg := by rw [hev]; positivity
      hw := hw.wK
      h0 := by simp [iSt, List.drop_eq_nil_of_le (le_of_eq (rowL_length wf NK i))]
      hG := fun k => by simp [iSt, hd.tK.symm]
      step := by
        intro j hj; rw [hev, Int.toNat_natCast] at hj ⊢; exact (step j hj).2.1 }
  refine ⟨R, ?_, ?_, ?_⟩
  · refine R.ok hd.k5 (RS.clean_of_lt hd.rk5) (IState.isInt_of hRK') ?_
    intro j hj; rw [hev, Int.toNat_natCast] at hj ⊢; exact (step j hj).1
  · rw [R.run, hev, Int.toNat_natCast]
  · have := R.cost_le_lin (zsz (NK : ℤ)) Cw (by simp [Ex.Lin])
      (by simp [Ex.Bnd, IState.top_eq hRK']) (by
        intro j hj; rw [hev, Int.toNat_natCast] at hj ⊢; exact (step j hj).2.2)
    rw [hev, Int.toNat_natCast] at this
    simpa [Ex.size] using this

theorem tabP_all {T CI CK RI RK : Fin HS} (hd : TDist T CI CK RI RK) {wP : RS}
    {s0 : IState HS} {NI NK : ℕ} {wf : ℕ → ℕ → ℤ} {Cw : ℕ} (hw : WSpec wP T CI CK s0 NI NK wf Cw)
    (LI LK : List Item) (hRI : s0.G RI = .int (NI : ℤ) :: LI)
    (hRK : s0.G RK = .int (NK : ℤ) :: LK) :
    (tabP T CI CK RI RK wP).ok s0 ∧
      (tabP T CI CK RI RK wP).run s0 = s0.upd T (ints (tabL wf NI NK) ++ s0.G T) ∧
      (tabP T CI CK RI RK wP).cost s0 ≤ tabCost NI NK Cw := by
  have hev : (Ex.reg (S := HS) RI).eval s0 = NI := by simp [Ex.eval, IState.top_eq hRI]
  have step : ∀ j < NI,
      let t0 := withCtr CI s0 NI j (oSt T s0 wf NI NK j)
      (rep CK (.reg RK) wP).ok t0 ∧
      (rep CK (.reg RK) wP).run t0 = withCtr CI s0 NI j (oSt T s0 wf NI NK (j + 1)) ∧
      (rep CK (.reg RK) wP).cost t0 ≤ 2 * 2000 * (zsz (NK : ℤ) + 2) +
        NK * (Cw + 8000 * (zsz (NK : ℤ) + 2) + 30) + 32 := by
    intro j hj t0
    have H := tinner_states hd hw LK hRK t0 (NI - 1 - j) (by omega) (s0.G CI)
      (by simp [t0, withCtr, oSt, hd.tI.symm]; omega)
      (by intro x h1 h2; simp [t0, withCtr, oSt, h1, h2])
      (by simp [t0, withCtr, oSt]) (by simp [t0, withCtr, oSt])
    refine ⟨H.2.1, ?_, H.2.2.2⟩
    rw [H.2.2.1]
    apply IState.ext' _ (by simp [t0, withCtr, oSt, iSt]) (by simp [t0, withCtr, oSt, iSt])
    intro x
    simp only [t0, withCtr, oSt, iSt, IState.upd_G]
    by_cases h1 : x = T
    · subst h1
      simp only [if_neg hd.tI, if_true, Nat.sub_self, List.drop_zero]
      rw [drop_pred_cons _ NI j (by simp) hj]
      simp [ints_append]
    · simp [h1]
  have R : RepStates CI (.reg RI) (rep CK (.reg RK) wP) s0 (oSt T s0 wf NI NK) :=
    { nonneg := by rw [hev]; positivity
      hw := by simp [RS.writes, hd.iK, hw.wI]
      h0 := by
        apply IState.ext' _ (by simp [oSt]) (by simp [oSt])
        intro x
        by_cases h1 : x = T
        · subst h1; simp [oSt, List.drop_eq_nil_of_le (le_of_eq (by simp : ((List.range NI).map (rowL wf NK)).length = NI))]
        · simp [oSt, h1]
      hG := fun k => by simp [oSt, hd.tI.symm]
      step := by
        intro j hj; rw [hev, Int.toNat_natCast] at hj ⊢; exact (step j hj).2.1 }
  refine ⟨?_, ?_, ?_⟩
  · refine R.ok hd.i5 (RS.clean_of_lt hd.ri5) (IState.isInt_of hRI) ?_
    intro j hj; rw [hev, Int.toNat_natCast] at hj ⊢; exact (step j hj).1
  · rw [tabP, R.run, hev, Int.toNat_natCast]
    simp [oSt, tabL]
  · have := R.cost_le_lin (zsz (NI : ℤ)) _ (by simp [Ex.Lin])
      (by simp [Ex.Bnd, IState.top_eq hRI]) (by
        intro j hj; rw [hev, Int.toNat_natCast] at hj ⊢; exact (step j hj).2.2)
    rw [hev, Int.toNat_natCast] at this
    rw [tabP, tabCost]
    simpa [Ex.size] using this

end NLogN.Rsp

