section
-- Source module: Solutions.KFMTable
/-!
# KFM 7: one procedure table for Lemma 12 / Prop 14 and the FM multiplier

Procedure tables are merged by renaming procedure indices (`IStmt.ren id g`, nlogn `HRen`).

* **`IRuns.relabel`**, **`SImplI.relabel`**, **`RowHyp.relabel`**: runs, `SImplI` implementations
  and the row hypothesis move to any table `iprog'` that contains the old one at `g`
  (`iprog' (g j) = (iprog j).ren id g`), with the same costs.
* **`kTable ext`**: the table `[l12, mulWrap, mulProg 0..4, ext 0..E-1]` (`7 + E` procedures);
  `ext` are further procedures (pointwise passes, line maps, …) that may call everything.
* **`kTable_mulOK`**: procedure `1` satisfies `MulOK` with cost `mulCostH (zsz a + zsz b)`.
* **`prop14Ph_kTable`**: `prop14Ph_l12` (unconditional Prop 14, `λ = τ50`) for `kTable ext`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFM

open IntMul RS AModel KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

section Relabel

variable {S P P' : ℕ} {I : List Sym}

end Relabel

section RelabelHS

variable {P P' : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {iprog' : Fin P' → IStmt HS P'}
  {g : Fin P → Fin P'}

end RelabelHS

/-! ## The merged table -/

section Table

variable {E : ℕ}

/-- Index of the Lemma 12 procedure. -/
def gL (E : ℕ) : Fin 1 → Fin (7 + E) := fun _ => ⟨0, by omega⟩

/-- Indices of the renamed `mulProg`. -/
def gM (E : ℕ) : Fin 5 → Fin (7 + E) := fun j => ⟨j.val + 2, by omega⟩

/-- Index of the `MulOK` wrapper. -/
def pMul (E : ℕ) : Fin (7 + E) := ⟨1, by omega⟩

/-- The merged table `[l12, mulWrap, mulProg 0..4, ext 0..E-1]`. -/
noncomputable def kTable (ext : Fin E → IStmt HS (7 + E)) : Fin (7 + E) → IStmt HS (7 + E) :=
  fun i =>
    if h0 : i.val = 0 then (KFL.l12prog 0).ren id (gL E)
    else if h1 : i.val = 1 then mulWrap (gM E)
    else if h7 : i.val < 7 then (mulProg ⟨i.val - 2, by omega⟩).ren ssE (gM E)
    else ext ⟨i.val - 7, by omega⟩

end Table

end NLogN.KFM

end

section
-- Source module: Solutions.KFMP18
/-!
# KFM 14: Proposition 18 as an explicit IL hypothesis `P18IL`

`P18IL` is the interface between the assembly (item 14) and Prop 18 in IL (item 13).

* The procedure table is **one fixed table** `kTable ext` (`ext`, `entry` and the descriptor stack
  `dS` are chosen before `n`). The final machine must not depend on `n`, so every `n`-dependent
  quantity (`p, ℓ, K, D`, the axis lengths `t_i`) is run-time data on stack `dS`, not a literal
  in the code.
* Data: two arrays `f, g` of `N = ∏ t_i` records in row-major order over `t_1 × … × t_D`
  (last axis fastest). Each record is `r = 2^ℓ` Gaussian coefficients at scale `2^p` (`RecRep`),
  in the unit disk, width `W = p + 2`. They sit on stack `0` (`f` on top). All other managed
  stacks are empty and the rest of the state (`s`) is arbitrary and preserved.
* Result: one array `h` (`RecRep r p`, width `W`) replacing `f, g` on stack `0`, within
  `2 N (3ℓ + 1) 2^{-p}` of `M_r(f, g) = (f ∗ g)/(r N)` in every coefficient (the bound of
  `GlueProp18.prop18_scaled_full`, with `√2 ≤ 2`, transported to the row-major order).
* Cost `≤ C₀ · N r (W + 1) · Ncost(6 lg n, d, K, ℓ, α) · (log(6 lg n) + 1)^A` for `n ≥ n₁`,
  with `D + 1 = d = dP n`, `ℓ = ℓP n`, `K = KP n`, `p = pP n`, `t_i ∈ {r/2, r}`.
-/

namespace NLogN.KFM

open IntMul KIL KFB KFH IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

/-- Negacyclic product of two coefficient vectors (`C[y]/(y^r + 1)`). -/
def ncm {r : ℕ} (u v : Fin r → ℂ) : Fin r → ℂ := fun k =>
  ∑ i : Fin r, ∑ j : Fin r,
    if i.val + j.val = k.val then u i * v j
    else if i.val + j.val = k.val + r then -(u i * v j) else 0

/-- Row-major index of `j - k` (componentwise, mod `t_i`), last axis fastest. -/
def rmSub : List ℕ → ℕ → ℕ → ℕ
  | [], _, _ => 0
  | t :: ts, j, k =>
    ((j / ts.prod % t + t - k / ts.prod % t) % t) * ts.prod + rmSub ts (j % ts.prod) (k % ts.prod)

/-- The normalized cyclic convolution `M_r(f, g) = (f ∗ g)/(r N)` over `∏ ℤ/t_i` with values in
`C[y]/(y^r + 1)`, on row-major lists of coefficient vectors. -/
def mrL (r : ℕ) (ts : List ℕ) (xf xg : List (Fin r → ℂ)) : List (Fin r → ℂ) :=
  (List.range ts.prod).map fun j =>
    ((r * ts.prod : ℕ) : ℂ)⁻¹ • ∑ k ∈ Finset.range ts.prod, ncm (xf.getD k 0) (xg.getD (rmSub ts j k) 0)

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMBridge
/-!
# KFM 14: `P18IL`'s row-major lists vs. the box of the error chain

`P18IL` speaks about row-major lists of records (`mrL`, `rmSub`); `chain_concrete` about functions
on the box `∏_{i ≤ D} ℤ/t_i` (`mrX`, last axis = record coefficient).

* `digL ts x i`: digit `i` of the row-major index `x` (first axis most significant);
  `rmSub_lt`, **`digL_rmSub`** (digits of `rmSub` are the differences mod `t_i`), `digL_lt`,
  `digL_inj`.
* `fullIdx t j c`: the box point of record `j`, coefficient `c`; **`fullIdx_bij`** (a bijection
  `Fin N × Fin r ≃ box`), `recL t f` (box function → row-major list of records),
  `boxOf t xs` (its inverse), `recL_boxOf`, `boxOf_recL`.
* **`mrL_box`**: `mrL r ts (recL f) (recL g) = recL (mrX t f g)`.
* **`mrt_err_of_list`**: a coefficientwise list bound against `mrL` (the form of `P18IL`) gives
  the sup-norm bound `‖boxOf xh - mrX f g‖ ≤ E` that `chain_concrete` needs (`hMrt`).
-/

namespace NLogN.KFM

open Complex

noncomputable section

/-! ## Row-major digits -/

/-- Digit `i` of the row-major index `x` over the axis lengths `ts`. -/
def digL : List ℕ → ℕ → ℕ → ℕ
  | [], _, _ => 0
  | t :: ts, x, 0 => x / ts.prod % t
  | _ :: ts, x, i + 1 => digL ts (x % ts.prod) i

lemma prod_pos_of {ts : List ℕ} (h : ∀ t ∈ ts, 0 < t) : 0 < ts.prod :=
  List.prod_pos h

theorem digL_lt : ∀ (ts : List ℕ), (∀ t ∈ ts, 0 < t) → ∀ x i (hi : i < ts.length),
    digL ts x i < ts[i]
  | [], _, _, _, hi => by simp at hi
  | t :: ts, h, x, i, hi => by
    have ht : 0 < t := h t (by simp)
    have h' : ∀ u ∈ ts, 0 < u := fun u hu => h u (by simp [hu])
    rcases i with _ | i
    · simp only [digL, List.getElem_cons_zero]; exact Nat.mod_lt _ ht
    · simp only [digL, List.getElem_cons_succ]; exact digL_lt ts h' _ i (by simpa using hi)

theorem digL_inj : ∀ (ts : List ℕ), (∀ t ∈ ts, 0 < t) → ∀ x y, x < ts.prod → y < ts.prod →
    (∀ i (hi : i < ts.length), digL ts x i = digL ts y i) → x = y
  | [], _, x, y, hx, hy, _ => by simp at hx hy; omega
  | t :: ts, h, x, y, hx, hy, hd => by
    have h' : ∀ u ∈ ts, 0 < u := fun u hu => h u (by simp [hu])
    have hR := prod_pos_of h'
    simp only [List.prod_cons] at hx hy
    have hx' : x / ts.prod < t := Nat.div_lt_of_lt_mul (by rwa [Nat.mul_comm])
    have hy' : y / ts.prod < t := Nat.div_lt_of_lt_mul (by rwa [Nat.mul_comm])
    have h0 := hd 0 (by simp)
    simp only [digL] at h0
    rw [Nat.mod_eq_of_lt hx', Nat.mod_eq_of_lt hy'] at h0
    have hm := digL_inj ts h' (x % ts.prod) (y % ts.prod) (Nat.mod_lt _ hR) (Nat.mod_lt _ hR)
      (fun i hi => by have := hd (i + 1) (by simpa using hi); simpa [digL] using this)
    rw [← Nat.div_add_mod x ts.prod, ← Nat.div_add_mod y ts.prod, h0, hm]

/-! ## The box and the record lists -/

variable {D : ℕ}

/-- The axis lengths of the first `D` axes, as a list. -/
def tsOf (t : Fin (D + 1) → ℕ) : List ℕ := List.ofFn fun i : Fin D => t i.castSucc

lemma tsOf_length (t : Fin (D + 1) → ℕ) : (tsOf t).length = D := by simp [tsOf]

lemma tsOf_get (t : Fin (D + 1) → ℕ) (i : ℕ) (hi : i < (tsOf t).length) :
    (tsOf t)[i] = t ⟨i, by rw [tsOf_length] at hi; omega⟩ := by
  simp [tsOf]

lemma tsOf_pos (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] : ∀ u ∈ tsOf t, 0 < u := by
  intro u hu
  simp only [tsOf, List.mem_ofFn] at hu
  obtain ⟨i, rfl⟩ := hu
  exact Nat.pos_of_ne_zero (NeZero.ne _)

lemma tsOf_prod (t : Fin (D + 1) → ℕ) : (tsOf t).prod = ∏ i : Fin D, t i.castSucc := by
  simp [tsOf, List.prod_ofFn]

/-- The box point of record `j`, coefficient `c`. -/
def fullIdx (t : Fin (D + 1) → ℕ) (j c : ℕ) : (i : Fin (D + 1)) → ZMod (t i) :=
  fun i => ((if i.val < D then digL (tsOf t) j i.val else c : ℕ) : ZMod (t i))

lemma val_cast_lt {m x : ℕ} [NeZero m] (h : x < m) : ((x : ℕ) : ZMod m).val = x := by
  rw [ZMod.val_natCast, Nat.mod_eq_of_lt h]

theorem fullIdx_inj (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] {j j' c c' : ℕ}
    (hj : j < (tsOf t).prod) (hj' : j' < (tsOf t).prod) (hc : c < t (Fin.last D))
    (hc' : c' < t (Fin.last D)) (h : fullIdx t j c = fullIdx t j' c') : j = j' ∧ c = c' := by
  have hpos := tsOf_pos t
  constructor
  · refine digL_inj _ hpos _ _ hj hj' fun i hi => ?_
    have hiD : i < D := by rw [tsOf_length] at hi; exact hi
    have e := congrFun h ⟨i, by omega⟩
    simp only [fullIdx, hiD, if_true] at e
    have l1 := digL_lt _ hpos j i hi
    have l2 := digL_lt _ hpos j' i hi
    rw [tsOf_get] at l1 l2
    have := congrArg ZMod.val e
    rwa [val_cast_lt l1, val_cast_lt l2] at this
  · have e := congrArg ZMod.val (congrFun h (Fin.last D))
    simp only [fullIdx, Fin.val_last, lt_irrefl, if_false] at e
    rwa [val_cast_lt hc, val_cast_lt hc'] at e

/-- The map `Fin N × Fin r → box`. -/
def phiB (t : Fin (D + 1) → ℕ) : Fin (tsOf t).prod × Fin (t (Fin.last D)) → ((i : Fin (D + 1)) → ZMod (t i)) :=
  fun x => fullIdx t x.1 x.2

theorem phiB_bij (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] : Function.Bijective (phiB t) := by
  rw [Fintype.bijective_iff_injective_and_card]
  refine ⟨fun x y h => ?_, ?_⟩
  · obtain ⟨h1, h2⟩ := fullIdx_inj t x.1.2 y.1.2 x.2.2 y.2.2 h
    exact Prod.ext (Fin.ext h1) (Fin.ext h2)
  · simp only [Fintype.card_prod, Fintype.card_fin, Fintype.card_pi, ZMod.card, tsOf_prod]
    rw [Fin.prod_univ_castSucc]

/-- Box function → row-major list of records. -/
def recL (t : Fin (D + 1) → ℕ) (f : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) :
    List (Fin (t (Fin.last D)) → ℂ) :=
  (List.range (tsOf t).prod).map fun j c => f (fullIdx t j c)

/-- Row-major list of records → box function. -/
def boxOf (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (xs : List (Fin (t (Fin.last D)) → ℂ)) :
    ((i : Fin (D + 1)) → ZMod (t i)) → ℂ := fun K =>
  let x := (Equiv.ofBijective _ (phiB_bij t)).symm K
  xs.getD x.1 0 x.2

/-! ## The ring convolution on both sides -/

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMNeed
/-!
# KFM: the uniform interfaces `PhiNeed` and `SwapNeed` (hypotheses of the assembly)

These are stated in the style of `P18IL`. Each one asks for a fixed table `kTable ext`, with
`ext`, the entry points and the descriptor stack `dS` all chosen before any parameter. Every
size-dependent quantity is run-time data on `dS`. The data sit on stack `0` (array on top, then
an arbitrary tail `l`). Every other managed stack is empty (`f j = []` for `j ≠ 0, dS`), so a
procedure may use any stack as scratch as long as it leaves it as it found it. The unmanaged
part `s` underneath is arbitrary and preserved. On exit, `dS` still holds its descriptor.

* **`PhiNeed`**: uniform `Φ` / `Φ⁻¹` of §9.3, with the denotations `KFU.PhiD` / `KFU.PhiInvD`.
  These are KFU's `phi_spec` / `phiInv_spec` with the literals `w, h, d, bL, s_j, μ_j` moved into
  the descriptor `descPhi`. Cost: a constant times KFU's `cPhi` (Lemma 12 constant `1`), plus a
  descriptor term `(d+1)(h+w+size V_S+1)²`.
* **`SwapNeed`**: uniform Lemma 12 on Gaussian (record) arrays: interchange two axes `p < q` of
  equal size `2^u` in an array of any positive shape `sh`. This is KFS's `swAxG_spec`, with
  `w, u, p, q, sh` in the descriptor `descSw`. Records of `r` entries use the shape `sh ++ [r]`.
  Cost: `K (w+1)(V+1) u^τ`, plus a descriptor term `(|sh|+1)(size V+w+u+1)²`. The assembly
  builds the axis exposure (moving an axis innermost before a line map, and back after it)
  from these swaps. A `2^{h+1}` axis is split as `2 × 2^h` by a free reshape.

* **`TransNeed`**: uniform axis rotation (`transposeL t (V/t)`) on padded Gaussian arrays whose
  axes are all `2^h` or `2^{h+1}`. This is the exposure step that replaces nlogn's `transP 2`
  inside `GL.axisP`. Equal-size swaps cannot do it when the sizes are mixed (see the docstring).

The final theorem may take `P18IL ∧ PhiNeed ∧ TransNeed` (and `SwapNeed` if it is used). The tables are merged by relabelling
(`IRuns.relabel`).
-/

namespace NLogN.KFM

open IntMul KIL KFB AModel AModelL12

noncomputable section

/-! ## `Φ` / `Φ⁻¹` -/

/-! ## Axis swaps (Lemma 12 on Gaussian record arrays) -/

/-- The descriptor of a swap call: `[w, u, p, q, |sh|, sh_0, …]`. -/
def descSw (w u p q : ℕ) (sh : Shape) : List ℤ :=
  (w : ℤ) :: (u : ℤ) :: (p : ℤ) :: (q : ℤ) :: (sh.length : ℤ) :: sh.map (fun a => (a : ℤ))

/-- **Lemma 12 on Gaussian arrays in IL, uniform** (hypothesis of the assembly). It is
`KFS.swAxG_spec` with the code fixed and `w, u, p, q, sh` read from `dS`. -/
def SwapNeed : Prop :=
  ∃ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (entry : Fin (7 + E)) (dS : Fin HS) (K : ℝ),
    dS ≠ 0 ∧ 0 ≤ K ∧
  ∀ (Isym : List Sym) (u w : ℕ) (sh : Shape) (p q : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) →
    p < q → q < sh.length → sh.getD p 0 = 2 ^ u → sh.getD q 0 = 2 ^ u →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = descSw w u p q sh →
    f 0 = gflat zs ++ l → zs.length = vol sh → NLogN.KFB.GB w zs →
    ∃ c : ℕ, IRuns Isym (kTable ext) (.call entry) (encK s f)
        (encK s (Function.update f 0 (gflat (pull sh sh (swapPos p q) 0 zs) ++ l))) c ∧
      (c : ℝ) ≤ K * (((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ KFS.τS +
        (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ))

/-! ## Axis rotation on padded arrays (the exposure step around the line maps) -/

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMPw
/-!
# KFM 9a: the pointwise Gaussian product pass `Q_Δ(θ · f)` with `MulOK` products

`gmulP pM Δ N`: stack `0` holds `gflat zs ++ R0` (`N` Gaussian entries on top), stack `pW` holds
`gflat ts ++ RW` (the multipliers, numerators at scale `2^Δ`), stack `pR` holds the ruler `2^Δ`.
The pass replaces the entries by `gmulT Δ z t = ((z·t).re.tdiv 2^Δ, (z·t).im.tdiv 2^Δ)`
(four `MulOK` products per entry, `split` by the ruler for `tdiv`) and consumes the multipliers:

* **`entry_runs`**: one entry; result pushed (imaginary part last) on `pO`.
* **`gmulP_runs`**: the pass, `0 = gflat (zipWith (gmulT Δ) zs ts) ++ R0`, `pW = RW`, at cost
  `N (4 φ + 10^5 (w + Δ + 1)) + 10^4 (N + 1)` when all products cost `≤ φ` on `w`-bit factors.

On numerators (`RecRep`) this is the twist / chirp step `Q_p(θ̃ · f)` of §9.4–9.5
(`gmulT_eq`: `gmulT Δ z t = KFH.gtr Δ (gmul z t)`, and `toC_gmul`).
**`gmulP_kTable`**: the FM instance in the merged table, cost `N·4·fmB(2w) + 10^6 (N+1)(w+Δ+1)`.

Generic per-item pass **`itemP body N`** (`itemP_runs`: `x ↦ f x` on `N` integer items of
stack `0`) with three instances for §9.3/§9.6: **`shlP_runs`** (`× 2^γ`), **`roundP_runs`**
(`(x + h).tdiv 2^Δ`, i.e. rounding when `h = 2^{Δ-1}`, `x + h ≥ 0`), **`smulP_runs`**
(`(S x).tdiv 2^Δ`, one `MulOK` product per item).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFM

open IntMul KFC KFB KFT KIL

/-! ## Stacks -/

abbrev pW : Fin HS := 43
abbrev pO : Fin HS := 44
abbrev pR : Fin HS := 45
abbrev pX1 : Fin HS := 46
abbrev pX2 : Fin HS := 47
abbrev pX3 : Fin HS := 48
abbrev pX4 : Fin HS := 49
abbrev pP1 : Fin HS := 50
abbrev pP2 : Fin HS := 51
abbrev pT : Fin HS := 53
abbrev pA : Fin HS := 60
abbrev pC : Fin HS := 61
abbrev pD : Fin HS := 62

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## One product through `MulOK` -/

/-- Push `top j * top i` on `k` via the multiplication procedure (the `RM.mul` code). -/
def mulC (pM : Fin P) (k i j : Fin HS) : IStmt HS P :=
  .seq (.op (.dup i ARGM)) (.seq (.op (.dup j ARGM)) (.seq (.call pM) (.op (.mv ARGM k))))

/-- The cost of `mulC` on factors `a` (from `i`) and `c` (from `j`). -/
def cMulC (M : MulSpec) (a c : ℤ) : ℕ :=
  (dupCost (zsz a) + 17) + (dupCost (zsz c) + 17) + (M.Φ c a + 2) + (2 * moveCost (zsz (c * a)) + 19)

/-! ## Combining two products: `(u ± v).tdiv 2^Δ` pushed on `pO` -/

/-- `neg` (if `sub`) then `add`, `split` by the ruler on `pR`, drop the remainder, push on `pO`. -/
def combC (sub : Bool) : IStmt HS P :=
  .seq (if sub then .op (.neg pP2) else .skip) (.seq (.op (.add pP1 pP2 pP1))
    (.seq (.op (.split pP1 pR pT)) (.seq (.op (.drop pT)) (.op (.mv pP1 pO)))))

/-! ## One entry -/

/-- The Gaussian product with truncation, `Q_Δ`. -/
def gmulT (Δ : ℕ) (z t : GI) : GI :=
  ((z.1 * t.1 - z.2 * t.2).tdiv (2 ^ Δ), (z.1 * t.2 + z.2 * t.1).tdiv (2 ^ Δ))

/-- One entry: pop `a, b` from `0` and `c, d` from `pW`, push `Q_Δ((a+bi)(c+di))` on `pO`. -/
def entryB (pM : Fin P) : IStmt HS P :=
  .seq (.seq (.op (.mv 0 pX1)) (.seq (.op (.mv 0 pX2)) (.seq (.op (.mv pW pX3)) (.op (.mv pW pX4)))))
    (.seq (mulC pM pP1 pX1 pX3) (.seq (mulC pM pP2 pX2 pX4) (.seq (combC true)
    (.seq (mulC pM pP1 pX1 pX4) (.seq (mulC pM pP2 pX2 pX3) (.seq (combC false)
    (.seq (.op (.drop pX1)) (.seq (.op (.drop pX2)) (.seq (.op (.drop pX3))
      (.op (.drop pX4)))))))))))

/-! ## Moving the results back -/

/-- Move one item from `pO` to `0`. -/
def mvB : IStmt HS P := .op (.mv pO 0)

/-! ## The pass -/

/-- **The pointwise Gaussian product pass** on `N` entries. -/
def gmulP (pM : Fin P) (N : ℕ) : IStmt HS P :=
  .seq (rpt pA pC pD N (entryB pM)) (rpt pA pC pD (2 * N) mvB)

/-- The cost of `gmulP` on `N` entries of `w` bits with products `≤ φ`. -/
def cGmul (N w Δ φ : ℕ) : ℕ :=
  N * (4 * φ + 100000 * (w + Δ + 1) + 64) + 60 + cRpt N +
    ((2 * N) * (110 * (4 * w + 2) + 64) + 60 + cRpt (2 * N))

/-! ## Generic per-item pass -/

/-- Stacks that a per-item body may change: `0`, `pO`, and the `rpt` counters. -/
def Fixd (s st : IState HS) : Prop :=
  ∀ j : Fin HS, j ≠ 0 → j ≠ pO → j ≠ pA → j ≠ pC → j ≠ pD → st.G j = s.G j

/-- **Per-item pass**: apply `body` (top of `0` ↦ pushed on `pO`) to `N` items, move back. -/
def itemP (body : IStmt HS P) (N : ℕ) : IStmt HS P :=
  .seq (rpt pA pC pD N body) (rpt pA pC pD N mvB)

/-! ## Instances: `× 2^γ`, `Q_Δ(· × S)`, rounding -/

/-- `x ↦ x · 2^γ` with the ruler `2^γ` on `pR`. -/
def shlB : IStmt HS P := .seq (.op (.mv 0 pP1)) (.seq (.op (.shl pP1 pR)) (.op (.mv pP1 pO)))

/-- `x ↦ (x + h).tdiv 2^Δ` with `h` on `pX2` and the ruler `2^Δ` on `pR` (rounding when
`h = 2^{Δ-1}` and `x + h ≥ 0`). -/
def roundB : IStmt HS P := .seq (.op (.mv 0 pP1)) (.seq (.op (.dup pX2 pP2)) (combC false))

/-- `x ↦ (x · S).tdiv 2^Δ` with `S` on `pX3` and the ruler `2^Δ` on `pR` (one `MulOK` call). -/
def smulB (pM : Fin P) : IStmt HS P :=
  .seq (.op (.mv 0 pX1)) (.seq (mulC pM pP1 pX1 pX3) (.seq (.op (.const pP2 0))
    (.seq (combC false) (.op (.drop pX1)))))

/-! ## The three passes -/

/-- Cost of a per-item pass with per-item cost `c` and output width `B`. -/
def cItem (N c B : ℕ) : ℕ :=
  N * (c + 64) + 60 + cRpt N + (N * (110 * (B + 1) + 64) + 60 + cRpt N)

/-! ## Denotation and the FM instance -/

/-- The closed FM cost bound as a function of the total bit length. -/
def fmB (n : ℕ) : ℕ :=
  (8 * fmA + 10 ^ 7 + 10 ^ 5) * (n + 1) * (zsz ((n + 1 : ℕ) : ℤ) + 2) *
    (zsz (((zsz ((n + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1)

/-- The FM multiplication spec of `KFMMul`. -/
def fmSpec : MulSpec := ⟨fun a b => mulCostH (zsz a + zsz b), fun _ _ => True⟩

end NLogN.KFM

end

