theorem NLogN.KFM.mc_exact (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (ζ : ℂ)
    (hζ : ζ ^ t (Fin.last D) = -1) (f g : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) :
    (fun j => (twX t ζ j)⁻¹) * mrX t (twX t ζ * f) (twX t ζ * g) =
      fun j => (∏ i, (t i : ℂ))⁻¹ * cconv t f g j := by sorry
