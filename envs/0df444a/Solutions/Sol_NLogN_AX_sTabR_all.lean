theorem betaExp_zsz (p α K2 j Bq : ℕ) (h : (4 * p + 35) * 2 ^ (2 * p) < 2 ^ Bq) :
    zsz (HvdH.betaT p α * HvdH.expNeg p K2 j) ≤ Bq := by
