theorem NLogN.KFM.cLayerT {P K D S ρ : ℕ} (hGc : GClass J A) (hrow : RowHyp Isym iprog K m r Z Ψ CR τ)
    (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hsW : W ≤ s) (hm : 2 ≤ m) (hr : 1 ≤ r) (hΨm : Monotone Ψ)
    (hZΨ : ∀ v, Z + 2 ≤ Ψ v) (L2 : ℕ) (hL2 : W ≤ 2 ^ L2) (hρ : ρ < K)
    (hS : 1 ≤ S) (hP : 1 ≤ P) (hD : 1 ≤ D)
    (hZ : zsz ((32 * (vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ) ≤ Z) :
    ∃ (code : ℕ → IStmt HS Pp) (E dC : ℕ) (cost : ℕ → ℕ),
      SImplI Isym iprog r (fun i : Fin D => KFH.stT K D S ρ i) (vol (Butterfly.layerShape P K D S))
        (Butterfly.tens Cm : Butterfly.Op (Fin D)) code E dC cost ∧
      E ≤ D + (Nat.log m D + 1) * m * Eb J.net.length s (Nat.log m D) ∧
      dC ≤ 2 * D + (Nat.log m D + 1) * m * DWb J.net.length s W A (Nat.log m D) ∧
      ∀ w, (cost w : ℝ) ≤ (2 * ((((Nat.log m D + 1) * m : ℕ) : ℝ) *
