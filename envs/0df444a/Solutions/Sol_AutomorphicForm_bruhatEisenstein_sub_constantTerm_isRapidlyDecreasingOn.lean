private theorem dirFlow_apply (c : d → ℝ) (t : ℝ) (i : d) : dirFlow c t i = ((t * c i : ℝ) : UnitAddCircle) := rfl

variable [Fintype d]

private def dirFreq (n : d → ℤ) (c : d → ℝ) : ℝ := ∑ i, (n i : ℝ) * c i

@[scoped simp] private theorem dirFreq_zero_left (c : d → ℝ) : dirFreq (0 : d → ℤ) c = 0 := by simp [dirFreq]

@[scoped simp] private theorem dirFreq_zero_right (n : d → ℤ) : dirFreq n (0 : d → ℝ) = 0 := by simp [dirFreq]

private theorem mFourier_apply_add (n : d → ℤ) (x y : UnitAddTorus d) : mFourier n (x + y) = mFourier n x * mFourier n y := by
  simp only [mFourier, ContinuousMap.coe_mk, Pi.add_apply, fourier_apply, zsmul_add, AddCircle.toCircle_add, Circle.coe_mul,
    Finset.prod_mul_distrib]

private theorem mFourier_apply_zero (n : d → ℤ) : mFourier n (0 : UnitAddTorus d) = 1 := by
  simp only [mFourier, ContinuousMap.coe_mk, Pi.zero_apply, fourier_eval_zero, Finset.prod_const_one]

private theorem mFourier_neg_apply_neg (n : d → ℤ) (y : UnitAddTorus d) : mFourier (-n) (-y) = mFourier n y := by
  simp only [mFourier, ContinuousMap.coe_mk, Pi.neg_apply, fourier_apply, neg_zsmul, zsmul_neg, neg_neg]

private theorem norm_mFourier_apply_le_one (n : d → ℤ) (x : UnitAddTorus d) : ‖mFourier n x‖ ≤ 1 :=
  ((mFourier n).norm_coe_le_norm x).trans mFourier_norm.le

private theorem norm_mFourier_smul_le {E : Type*} [SeminormedAddCommGroup E] [NormedSpace ℂ E] (n : d → ℤ) (x : UnitAddTorus d) (v : E) :
    ‖mFourier n x • v‖ ≤ ‖v‖ := by
  rw [norm_smul]
  exact mul_le_of_le_one_left (norm_nonneg v) (norm_mFourier_apply_le_one n x)

private theorem mFourier_dirFlow (n : d → ℤ) (c : d → ℝ) (t : ℝ) :
    mFourier n (dirFlow c t) = Complex.exp (2 * π * I * dirFreq n c * t) := by
  simp only [mFourier, ContinuousMap.coe_mk, dirFlow_apply, fourier_coe_apply, Complex.ofReal_one, div_one]
  rw [← Complex.exp_sum]
  congr 1
  simp only [dirFreq, Complex.ofReal_sum, Complex.ofReal_mul, Complex.ofReal_intCast, Finset.mul_sum, Finset.sum_mul]
  exact Finset.sum_congr rfl fun i _ => by ring

private theorem hasDerivAt_mFourier_dirFlow (n : d → ℤ) (c : d → ℝ) (t : ℝ) :
    HasDerivAt (fun s : ℝ => mFourier n (dirFlow c s)) (2 * π * I * dirFreq n c * mFourier n (dirFlow c t)) t := by
  simp_rw [mFourier_dirFlow]
  have h1 : HasDerivAt (fun z : ℂ => 2 * π * I * dirFreq n c * z) (2 * π * I * dirFreq n c) (t : ℂ) :=
    ((hasDerivAt_id' (t : ℂ)).const_mul (2 * π * I * dirFreq n c)).congr_deriv (mul_one _)
  exact h1.cexp.comp_ofReal.congr_deriv (mul_comm _ _)

section Coeff

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]

private theorem mFourierCoeff_eq_integral_torusMeasure (f : UnitAddTorus d → E) (n : d → ℤ) :
    mFourierCoeff f n = ∫ t, mFourier (-n) t • f t ∂(torusMeasure d) := rfl

private theorem norm_mFourierCoeff_le {f : UnitAddTorus d → E} {C : ℝ} (hC : ∀ x, ‖f x‖ ≤ C) (n : d → ℤ) : ‖mFourierCoeff f n‖ ≤ C := by
  rw [mFourierCoeff_eq_integral_torusMeasure]
  have h := norm_integral_le_of_norm_le_const (μ := torusMeasure d) (C := C) (f := fun t => mFourier (-n) t • f t)
    (Filter.Eventually.of_forall fun t => (norm_mFourier_smul_le (-n) t (f t)).trans (hC t))
  simpa only [probReal_univ, mul_one] using h

private theorem mFourierCoeff_comp_add_right (f : UnitAddTorus d → E) (n : d → ℤ) (y : UnitAddTorus d) :
    mFourierCoeff (fun x => f (x + y)) n = mFourier n y • mFourierCoeff f n := by
  simp only [mFourierCoeff_eq_integral_torusMeasure]
  have h := integral_add_right_eq_self (μ := torusMeasure d) (fun z => mFourier (-n) (z - y) • f z) y
  simp only [add_sub_cancel_right] at h
  rw [h]
  simp_rw [sub_eq_add_neg, mFourier_apply_add, mFourier_neg_apply_neg, mul_comm _ (mFourier n y), mul_smul]
  exact integral_smul _ _

end Coeff
