variable {K : Type*} [Field K] [TopologicalSpace K] [T1Space K] [MeasurableSpace K] [BorelSpace K]

private theorem measurableSet_image_val {s : Set Kˣ} (hs : MeasurableSet s) :
    MeasurableSet (Units.val '' s) := by
  obtain ⟨t, ht, rfl⟩ := MeasurableSpace.measurableSet_comap.mp hs
  rw [Set.image_preimage_eq_inter_range, range_val]
  exact ht.inter (measurableSet_singleton (0 : K)).compl

private theorem comap_val_apply (m : Measure K) {s : Set Kˣ} (hs : MeasurableSet s) :
    Measure.comap Units.val m s = m (Units.val '' s) :=
  Measure.comap_apply Units.val Units.val_injective (fun _ h => measurableSet_image_val h) m hs

end
