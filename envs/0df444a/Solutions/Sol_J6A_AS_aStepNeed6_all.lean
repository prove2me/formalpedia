      _ ≤ (Z + 3) ^ 6 := Nat.pow_le_pow_right (by omega) (by omega)
  have e : (2 * (Z + 3)) ^ 6 = 64 * (Z + 3) ^ 6 := by ring
  have h4 : NLogN.KFM.fmB (2 * Z) ≤ 128 * cM * (Z + 3) ^ 6 :=
    h1.trans (calc 2 * cM * (2 * Z + 3) ^ 6 ≤ 2 * cM * (2 * (Z + 3)) ^ 6 :=
          Nat.mul_le_mul_left _ h2
      _ = 128 * cM * (Z + 3) ^ 6 := by rw [e]; ring)
  generalize (Z + 3) ^ 6 = Y at *
  generalize NLogN.KFM.fmB (2 * Z) = f at *
  linarith

/-! ## The slab pieces -/

theorem ctlPhC_le (A n n' : ℕ) :
    J6Seg.Src.ctlPhC A n n' ≤ (n + n' + 1) * (Kc * (A + 4) ^ 6) := by
