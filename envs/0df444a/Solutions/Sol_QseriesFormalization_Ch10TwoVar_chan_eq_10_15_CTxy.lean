/-- Coefficient formula for `thetaMon`. -/
theorem thetaMon_coeff (A e i j : ℤ) (hA : 0 < A) (g : ExpQXY) :
    (thetaMon A e i j hA).coeff g =
      ∑ᶠ n, (monom (thetaQDeg A e n) (i * n) (j * n) ((-1) ^ n)).coeff g := by
