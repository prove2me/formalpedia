      ((s.upd NLogN.KFM.pQ1 R1).upd NLogN.KFM.pQ3 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFM.oprod Δ A B)).reverse ++ s.G NLogN.KFM.pQ3))
      (A.length * (NLogN.KFM.cOb B.length w Δ φ + 64) + 60 + NLogN.KFT.cRpt A.length) := by
  let T : ℕ → NLogN.IState HS := fun k =>
    (s.upd NLogN.KFM.pQ1 (NLogN.ints (NLogN.KFB.gflat (A.drop k)) ++ R1)).upd NLogN.KFM.pQ3
      (NLogN.ints (NLogN.KFB.gflat (NLogN.KFM.oprod Δ (A.take k) B)).reverse ++ s.G NLogN.KFM.pQ3)
  have H := NLogN.KFT.rpt_runs (I := I) (iprog := iprog) (A := NLogN.KFM.oA) (C := NLogN.KFM.oC) (D := NLogN.KFM.oD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) A.length T
    (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) (fun k => by simp +decide [T])
    (NLogN.KFM.obB pM B.length) (NLogN.KFM.cOb B.length w Δ φ)
    (by
      intro k hk LA LC LD
      have hd : A.drop k = A[k] :: A.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hmem := List.getElem_mem hk
      have Hb := NLogN.KFM.obB_runs (I := I) (iprog := iprog) hM hdom hΦ Δ (NLogN.KFT.cf3 (T k) NLogN.KFM.oA NLogN.KFM.oC NLogN.KFM.oD LA LC LD)
        A[k] B (NLogN.ints (NLogN.KFB.gflat (A.drop (k + 1))) ++ R1) R2 LR
        (by simp +decide only [T, NLogN.KFT.cf3, NLogN.IState.upd_G, if_true, if_false]
            simp only [hd, NLogN.ints, NLogN.KFB.gflat_cons, List.map_cons, List.cons_append])
        (by simp +decide [T, NLogN.KFT.cf3, h2]) (by simp +decide [T, NLogN.KFT.cf3, hR]) (hA _ hmem) hB
        (hC.sub (fun z hz => by
