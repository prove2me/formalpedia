-- ===== S4.Def_RP_EtPBC_A_CovAs6e =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As6e): the lift from a completed cover and an approximation property

* `ker_comp_equiv`: kernels along a ring isomorphism compatible with the structure maps.
* **`assemble`** (generic `S`, flat over `A`, with a residue `res : S →+* K` and an ideal `pI` it kills): if every
  finitely generated `C ≤ S` maps residually to an etale neighbourhood `(R', χ')` of `χ` (in the application
  `S = Â`, from `approxAlg`), then a completed cover over `S` of the shape of `hat_lift` gives a `CoverLift`.
-/

set_option autoImplicit false

open Polynomial TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section KerEquiv

variable {P X Y G : Type u} [CommRing P] [CommRing X] [CommRing Y] [CommRing G]

theorem ker_comp_equiv (E : X ≃+* Y) (f : P →+* X) (b : P →+* Y) (hb : ∀ a, E (f a) = b a) (θ : Y →+* G)
    (J : Ideal P) (h : RingHom.ker θ = J.map b) : RingHom.ker (θ.comp (E : X →+* Y)) = J.map f := by
  ext x
  rw [RingHom.mem_ker, RingHom.comp_apply]
  constructor
  · intro hx
    have h1 : (E : X →+* Y) x ∈ J.map b := h ▸ RingHom.mem_ker.mpr hx
    have h2 := Ideal.mem_map_of_mem (E.symm : Y →+* X) h1
    rw [Ideal.map_map] at h2
    have h3 : (E.symm : Y →+* X).comp b = f := RingHom.ext fun a => by
      rw [RingHom.comp_apply, ← hb a]
      exact E.symm_apply_apply (f a)
    rw [h3, show (E.symm : Y →+* X) ((E : X →+* Y) x) = x from E.symm_apply_apply x] at h2
    exact h2
  · intro hx
    have h2 := Ideal.mem_map_of_mem (E : X →+* Y) hx
    rw [Ideal.map_map] at h2
    have h3 : (E : X →+* Y).comp f = b := RingHom.ext fun a => hb a
    rw [h3, ← h] at h2
    exact RingHom.mem_ker.mp h2

end KerEquiv

section Assemble

end Assemble

end RamanujanPetersson.EtPBC.Cov

end

