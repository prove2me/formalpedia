namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

section tab
variable {Q R s t lam α pk b BH : ℕ}

theorem tabK2_len (hl : 1 ≤ lam) (q : ℕ) :
    (tabK2 Q pk b lam (diL Q R s t lam α) (giL Q R s t lam α) (gamL Q R s t lam α)
      (ddL Q R s t lam α) (descsOf s t lam (TT Q R s t α) q)).length ≤ 8 + 10 * lam := by
  have hds := descsOf_ok (s := s) (t := t) hl (TT Q R s t α) q
  have hE := length_dsEnc2 b (descsOf s t lam (TT Q R s t α) q)
    (fun d hd => ⟨(hds d hd).2.1, (hds d hd).2.2.1⟩)
  have hn := length_le_sumN (descsOf s t lam (TT Q R s t α) q) (fun d hd => (hds d hd).1)
  have hs := sumN_descsOf (s := s) (t := t) hl (TT Q R s t α) q
  simp only [tabK2, List.length_append, List.length_cons, List.length_nil, List.length_reverse,
    diL, giL, gamL, ddL, List.length_map, List.length_range]
  omega

end tab

theorem tabsT_len (tab : ℕ → List ℤ) (L : ℕ) :
    ∀ nc, (∀ q < nc, (tab q).length ≤ L) → (tabsT tab nc).length ≤ nc * (L + 1)
  | 0, _ => by simp [tabsT]
  | nc + 1, h => by
    have ih := tabsT_len tab L nc (fun q hq => h q (by omega))
    have hq := h nc (by omega)
    unfold tabsT at ih ⊢
    rw [List.range_succ, List.flatMap_append, List.length_append]
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil, segT, List.length_cons]
    have : (nc + 1) * (L + 1) = nc * (L + 1) + (L + 1) := by ring
    omega

theorem kerC_leN (Ckn B m post Lmax nc Tot pre N : ℕ) :
    kerC Ckn B m post Lmax nc Tot pre N ≤ pre * nc * post * Ckn +
      100000 * (B + 2) * (pre * nc * post * (m + 1) + pre * nc * (Lmax + 1) + pre * (Tot + 2) +
        N + 2) := by
  unfold kerC cIL cIb cQb cTab cRows
  ring_nf
  omega

