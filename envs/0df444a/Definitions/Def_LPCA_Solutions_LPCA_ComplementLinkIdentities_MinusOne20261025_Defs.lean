namespace LPCA

open CategoryTheory

universe u

variable {V W : Type u} [DecidableEq V] [DecidableEq W]







variable (k : Type u) [Field k] [Fintype V]

/-- Equality of complexes transports the actual restriction map,
including the signs induced by the fixed vertex ordering. -/
theorem reducedFaceCohomologyRestriction_congr (rank : V ↪ ℕ)
    {K K' L L' : Complex V} (h : K.faces ⊆ L.faces)
    (h' : K'.faces ⊆ L'.faces) (hK : K = K') (hL : L = L') (r : ℤ) :
    reducedFaceCohomologyRestriction k rank h r ≫
        (eqToIso (congrArg (fun A => reducedFaceCohomology k rank A r) hK)).hom =
      (eqToIso (congrArg (fun A => reducedFaceCohomology k rank A r) hL)).hom ≫
        reducedFaceCohomologyRestriction k rank h' r := by
  subst K'
  subst L'
  simp only [eqToIso_refl, Iso.refl_hom, Category.comp_id, Category.id_comp]

end LPCA


