-- title:
--   Smooth graph
-- statement:
--   A **smooth graph** is a Borel graph of countable degree whose connected-component relation (the equivalence relation generated by $G$) is smooth. A graphical game over a smooth graph is a **smooth graphical game**.
-- source:
--   Hellman–Levy, Equilibria Existence in Bayesian Games: Climbing the Countable Borel Equivalence Relation Hierarchy, author's manuscript (2020-07-14), Definition 3.4, p.15

import Mathlib
import Definitions.Def_HellmanLevy_Graphical_IsGraph
import Definitions.Def_HellmanLevy_CBER_IsSmooth

namespace HellmanLevy.Graphical

/-- A **smooth graph**: a Borel graph of countable degree whose connected-component relation
(the equivalence relation generated by `G`) is smooth. A graphical game over a smooth graph is a
**smooth graphical game**.
Hellman–Levy, *Equilibria Existence in Bayesian Games: Climbing the Countable Borel Equivalence
Relation Hierarchy*, author's manuscript (2020-07-14), Definition 3.4, p.15; Definition 3.3, p.14. -/
def IsSmoothGraph {X : Type*} [MeasurableSpace X] (G : X → X → Prop) : Prop :=
  IsGraph G ∧ CBER.IsSmooth (Relation.EqvGen G)

end HellmanLevy.Graphical


