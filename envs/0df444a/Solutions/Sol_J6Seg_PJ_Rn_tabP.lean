theorem atanP_run (x N K : ℕ) (σ : ℤ) (hx : 0 < x) (s : IState HS) (L0 L1 : List Item)
    (h0 : s.G 0 = .int N :: L0) (h1 : s.G 1 = .int K :: L1) :
    (atanP x σ).run s = s.upd 2 (.int (atanSum x N σ K) :: s.G 2) :=
  (atanP_spec x N K σ hx s L0 L1 h0 h1).2

