theorem solution {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {φ : ℝ} (hφ : 2 ≤ φ) (hφtop : φ ≤ (7 / 2 : ℝ)) :
    buchstabIntegral ω 2 (fun j => (r0j18_lo j : ℝ)) (fun j => (r0j18_hi j : ℝ)) φ ≤
      ((155569 / 1000000000) : ℝ) :=
  SolBuchstab4D.r0j18_short_proved hω hz hφ hφtop
