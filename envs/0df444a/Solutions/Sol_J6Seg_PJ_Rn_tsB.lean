        (by rw [q3 26 (by decide) (by decide) (by decide) (by decide), h26]) hca huu)
      (den_tVE (by rw [q3 1 (by decide) (by decide) (by decide) (by decide), h1])
        (by rw [q3 2 (by decide) (by decide) (by decide) (by decide), h2])
        (by rw [q3 3 (by decide) (by decide) (by decide) (by decide), h3])
        (by rw [q3 7 (by decide) (by decide) (by decide) (by decide), h7])
