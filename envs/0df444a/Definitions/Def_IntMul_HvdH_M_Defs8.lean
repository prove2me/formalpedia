section
-- Source module: NLogN.HSt10
/-!
# The recursive step, part 10: parameter choices, the cost decomposition `lin`/`calls`
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unreachableTactic false
set_option linter.unusedTactic false

namespace NLogN.ST

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref

/-! ## The derived quantities (explicit functions of `K` and `N`) -/

/-- Key width `kb = logT + 2`. -/
def kbK (K N : ℕ) : ℕ := (mkParams K N).logT + 2

/-- Bit bound of the `S̃` stage `k` inputs. -/
def BSf (K N k : ℕ) : ℕ :=
  Nat.size (BD.Bq (mkParams K N)) + k * Nat.size (BD.cS1 (mkParams K N).p (mkParams K N).α)

/-- Bit bound of the `B̃` stage `k` inputs. -/
def BBf (K N k : ℕ) : ℕ :=
  Nat.size (BD.Bq (mkParams K N) + BD.BC (mkParams K N)) +
    k * Nat.size (BD.cB1 (mkParams K N).p (mkParams K N).α (BD.Jm (mkParams K N)))

/-- The size of all small multiplications. -/
def mmK (K N : ℕ) : ℕ :=
  BSf K N K + BBf K N K + 2 * (mkParams K N).p +
    BD.Jm (mkParams K N) * Nat.size (BD.cE1 (mkParams K N).p (mkParams K N).α) +
    Nat.size (BD.Jm (mkParams K N) + 1) + Nat.size (4 * (mkParams K N).p + 35) + 64

/-- Accumulator bits of the axis transforms (also their scalar bound). -/
def BaccK (K N : ℕ) : ℕ :=
  2 * mmK K N + 2 * (mkParams K N).p + 2 * (mkParams K N).logT +
    2 * Nat.size (2 * eWidth (mkParams K N).p (mkParams K N).α + 2 * sWidth (mkParams K N).p (mkParams K N).α + 4) +
    64

/-- Table bits of the axis transforms. -/
def BqT (K N : ℕ) : ℕ :=
  2 * (mkParams K N).p + Nat.size (4 * (mkParams K N).p + 35) +
    24 * Nat.size ((mkParams K N).α ^ 2 + 2 * 2 ^ (mkParams K N).e + 2 * eWidth (mkParams K N).p (mkParams K N).α +
      2 * sWidth (mkParams K N).p (mkParams K N).α + 2) + 8

/-- Scalar bits of the axis loops. -/
def BxK (K N : ℕ) : ℕ := Nat.size (EX.Vx (mkParams K N) (kbK K N))

/-- Bits of the `fwdL` lists. -/
def QK (K N : ℕ) : ℕ := 2 * mmK K N + GL.exC (mkParams K N) + 2 * (mkParams K N).p + 2 * (mkParams K N).logT + 64

/-- Bits of the `exactLW` environment scalars. -/
def BsK (K N : ℕ) : ℕ :=
  2 * (mkParams K N).fn + 2 * (mkParams K N).p + 2 * (mkParams K N).logT + GL.exC (mkParams K N) + 64

/-- Bits of the CRT / chirp / tail values (`O(log N)`). -/
def BcK (K N : ℕ) : ℕ := 2 * (mkParams K N).p + 2 * (mkParams K N).logT + 2 * (mkParams K N).b + 4 * K + 64

/-- Bits of the descriptor values (`O(fn)`, only `O(K)` of them). -/
def BdK (K N : ℕ) : ℕ := 2 * (mkParams K N).fn + 2 * (mkParams K N).p + 2 * (mkParams K N).logT + 4 * K + 64

/-! ## The axis cost bounds, affine in `Φ` -/

def sapF (K N Φ k : ℕ) : ℕ :=
  AX.sapAxCost (mkParams K N).p (EX.sK (mkParams K N) k) (EX.tK (mkParams K N) k) (mkParams K N).α
    (EX.mS (mkParams K N) k) (kbK K N) (BSf K N k) (mmK K N) Φ (BaccK K N) (BaccK K N) (NLogN.ST.BqT K N)

def bapF (K N Φ k : ℕ) : ℕ :=
  AX.bapAxCost (mkParams K N).p (EX.sK (mkParams K N) k) (EX.tK (mkParams K N) k) (mkParams K N).α
    (EX.mB (mkParams K N) k) (kbK K N) (BBf K N k) (mmK K N) Φ (BaccK K N) (BaccK K N) (NLogN.ST.BqT K N)

def CS0 (K N : ℕ) : ℕ := (Finset.range K).sup (sapF K N 0)
def DS (K N : ℕ) : ℕ := (Finset.range K).sup (fun k => sapF K N 1 k - sapF K N 0 k)
def CB0 (K N : ℕ) : ℕ := (Finset.range K).sup (bapF K N 0)
def DB (K N : ℕ) : ℕ := (Finset.range K).sup (fun k => bapF K N 1 k - bapF K N 0 k)

def CSK (K N Φ : ℕ) : ℕ := CS0 K N + Φ * DS K N
def CBK (K N Φ : ℕ) : ℕ := CB0 K N + Φ * DB K N

/-! ## The total cost, `lin` and `calls` -/

/-- The cost bound of the step with Fermat-product cost `Φf` and small-product cost `Φm`. -/
def GK (K N Φf Φm : ℕ) : ℕ :=
  stepCost K N Φf Φm (BsK K N) (CSK K N Φm) (CBK K N Φm) (BxK K N) (QK K N) (BcK K N) (BdK K N)

/-- The non-multiplication part of the cost. -/
def lin (K N : ℕ) : ℕ := GK K N 0 0

/-- Number of Fermat-ring products (each of `fn + 1` bits). -/
def cntF (K N : ℕ) : ℕ := GK K N 1 0 - GK K N 0 0

/-- Number of small products (each of `mmK K N` bits). -/
def cntM (K N : ℕ) : ℕ := GK K N 0 1 - GK K N 0 0

/-- The multiplications performed on `N`-bit inputs: `(count, size)`. -/
def calls (K N : ℕ) : List (ℕ × ℕ) := [(cntF K N, (mkParams K N).fn + 1), (cntM K N, mmK K N)]

end NLogN.ST

end

