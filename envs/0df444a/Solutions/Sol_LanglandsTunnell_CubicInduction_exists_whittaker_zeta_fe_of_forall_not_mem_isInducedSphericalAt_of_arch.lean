private theorem ofReal_prod_cpow {ι : Type*} (s : Finset ι) (f : ι → ℝ) (hf : ∀ i ∈ s, 0 ≤ f i) (r : ℂ) :
    ((∏ i ∈ s, f i : ℝ) : ℂ) ^ r = ∏ i ∈ s, ((f i : ℝ) : ℂ) ^ r := by
  classical
  revert hf
  refine Finset.induction_on s (fun _ => by simp) fun a s ha ih hf => ?_
  rw [Finset.prod_insert ha, Finset.prod_insert ha, Complex.ofReal_mul,
    Complex.mul_cpow_ofReal_nonneg (hf a (Finset.mem_insert_self a s))
      (Finset.prod_nonneg fun i hi => hf i (Finset.mem_insert_of_mem hi)),
    ih fun i hi => hf i (Finset.mem_insert_of_mem hi)]

private theorem iotaGL_diagUnitGL2_one (v : HeightOneSpectrum (𝓞 ℚ)) :
    iotaGL (diagUnitGL2 (1 : (v.adicCompletion ℚ)ˣ)) = 1 :=
  map_one (iotaGL.comp diagHom)

variable (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ) {Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ}
  {T : Finset (HeightOneSpectrum (𝓞 ℚ))} {g : AdelicGL 3 (𝓞 ℚ) ℚ}

private theorem integrand_embHom_eq (hone : ∀ v, v ∉ T → ∀ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, Wloc v k = 1)
    (hg : ∀ v, v ∉ T → componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (s : ℂ) (t : TorusProduct T) :
    adelicProduct Warch Wloc (iotaGL (diagUnitGL2 (embHom T t)) * g) * ((χ (embHom T t) : ℂˣ) : ℂ) *
        ((TateGlobal.ideleNorm ℚ (embHom T t) : ℝ) : ℂ) ^ (s - 1) =
      (∏ v : T, localIntegrand (Wloc v) (componentAt3 (𝓞 ℚ) ℚ v g) (TateGlobal.localChar χ v) s (t.1 v)) *
        archIntegrand Warch (archComponent3 (𝓞 ℚ) ℚ g) (χ.comp archIdeleHom) s t.2 := by

  have hW : adelicProduct Warch Wloc (iotaGL (diagUnitGL2 (embHom T t)) * g) =
      Warch (iotaGL (diagUnitGL2 t.2) * archComponent3 (𝓞 ℚ) ℚ g) *
        ∏ v : T, Wloc v (iotaGL (diagUnitGL2 (t.1 v)) * componentAt3 (𝓞 ℚ) ℚ v g) := by
    rw [adelicProduct_eq_prod Warch hone (iotaGL (diagUnitGL2 (embHom T t)) * g) T (Finset.Subset.refl T)
        (fun v hv => ?_),
      archComponent3_iotaGL_diagUnitGL2_mul, unitsAtInfinity_embHom, ← Finset.prod_coe_sort T]
    · congr 1
      exact Finset.prod_congr rfl fun v _ => by
        simp only [componentAt3_iotaGL_diagUnitGL2_mul, unitsAt_embHom_of_mem]
    · simp only [componentAt3_iotaGL_diagUnitGL2_mul, unitsAt_embHom_of_not_mem T t hv, iotaGL_diagUnitGL2_one,
        one_mul]
      exact hg v hv

  have hχ : ((χ (embHom T t) : ℂˣ) : ℂ) =
      ((χ (archIdeleHom t.2) : ℂˣ) : ℂ) * ∏ v : T, ((TateGlobal.localChar χ v (t.1 v) : ℂˣ) : ℂ) := by
    rw [embHom_apply, map_mul, map_prod χ, Units.val_mul, Units.coe_prod]
    simp only [apply_finPlace]

  have hn : ((TateGlobal.ideleNorm ℚ (embHom T t) : ℝ) : ℂ) ^ (s - 1) =
      ((‖(t.2 : InfiniteAdeleRing ℚ)‖ : ℝ) : ℂ) ^ (s - 1) *
        ∏ v : T, ((TateLocal.modulus (t.1 v : (v : HeightOneSpectrum (𝓞 ℚ)).adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1) := by
    have h0 : 0 ≤ ‖(t.2 : InfiniteAdeleRing ℚ)‖ := by
      rw [InfiniteAdeleRing.norm_def]
      exact Finset.prod_nonneg fun w _ => pow_nonneg (norm_nonneg _) _
    have hsplit := Complex.mul_cpow_ofReal_nonneg h0
      (Finset.prod_nonneg fun (v : T) (_ : v ∈ (Finset.univ : Finset T)) =>
        NNReal.coe_nonneg (TateLocal.modulus (t.1 v : (v : HeightOneSpectrum (𝓞 ℚ)).adicCompletion ℚ))) (s - 1)
    have hprod := ofReal_prod_cpow (Finset.univ : Finset T)
      (fun v : T => ((TateLocal.modulus (t.1 v : (v : HeightOneSpectrum (𝓞 ℚ)).adicCompletion ℚ) : ℝ≥0) : ℝ))
      (fun v _ => NNReal.coe_nonneg _) (s - 1)
    rw [ideleNorm_embHom, Complex.ofReal_mul, hsplit, hprod]
  rw [hW, hχ, hn]
  simp only [localIntegrand, archIntegrand, MonoidHom.comp_apply, Finset.prod_mul_distrib]
  ring

end
