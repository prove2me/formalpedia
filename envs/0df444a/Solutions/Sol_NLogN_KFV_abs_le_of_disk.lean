variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution {r p : ℕ} {zs : List NLogN.KFB.GI} {xs : List (Fin r → ℂ)} (h : NLogN.KFH.RecRep r p zs xs)
    (hd : NLogN.KFV.Disk xs) : ∀ z ∈ zs, |z.1| ≤ 2 ^ p ∧ |z.2| ≤ 2 ^ p := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
  have hr : 0 < r := by
    have h1 : zs.length = xs.length * r := h.1
    have : xs.length * r ≠ 0 := by omega
    exact Nat.pos_of_ne_zero (right_ne_zero_of_mul this)
  set j := i / r
  have hj : j < xs.length := by
    rw [h.1] at hi; exact (Nat.div_lt_iff_lt_mul hr).2 hi
  set c : Fin r := ⟨i % r, Nat.mod_lt _ hr⟩
  have hi' : i = j * r + c := by simp [j, c, Nat.div_add_mod']
  have e := h.2 j c hj
  rw [← hi', List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hj] at e
  have hn : ‖xs[j] c‖ ≤ 1 := le_trans (norm_le_pi_norm _ c) (hd j hj)
  have hz : ‖NLogN.KFB.toC zs[i]‖ ≤ 2 ^ p := by
    rw [e, norm_mul]; simp only [norm_pow, Complex.norm_ofNat]
    calc (2 : ℝ) ^ p * ‖xs[j] c‖ ≤ 2 ^ p * 1 := by gcongr
      _ = 2 ^ p := mul_one _
  have hre : (NLogN.KFB.toC zs[i]).re = ((zs[i].1 : ℤ) : ℝ) := by rw [NLogN.KFV.toC_eq_mk]
  have him : (NLogN.KFB.toC zs[i]).im = ((zs[i].2 : ℤ) : ℝ) := by rw [NLogN.KFV.toC_eq_mk]
  have h1 : |((zs[i].1 : ℤ) : ℝ)| ≤ 2 ^ p := by
    have := Complex.abs_re_le_norm (NLogN.KFB.toC zs[i]); rw [hre] at this; linarith
  have h2 : |((zs[i].2 : ℤ) : ℝ)| ≤ 2 ^ p := by
    have := Complex.abs_im_le_norm (NLogN.KFB.toC zs[i]); rw [him] at this; linarith
  constructor <;> [exact_mod_cast h1; exact_mod_cast h2]
end
