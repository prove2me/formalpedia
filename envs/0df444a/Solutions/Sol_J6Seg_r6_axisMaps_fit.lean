/-!
# Segmented inverse (S2): `B₀` maps the zero line to the zero line

**`B0seg_zero`**: under the hypotheses of `prop_4_7_seg` (pivots of the capacitance elimination
positive), `B0seg … (fun _ => 0) = fun _ => 0`. The machine needs this exactly: in the tensor
pass the padded entries (some coordinate `≥ s_i`) stay `0`.
-/

open Complex Real

namespace J6Seg
open IntMul.HvdH

theorem B0seg_zero (p P R lam w s t α : ℕ) (hs : 0 < s) (hst : s < t) (hα : 2 ≤ α)
    (hx3 : 3 * s ≤ α ^ 2 * (t - s)) (hl : 1 ≤ lam) (hw : w ≤ s)
    (hR : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ R)
    (hP : 1000 * fullG lam w s t α (1 / 2) ≤ 2 ^ P) :
    B0seg p P R lam w s t α (fun _ => (0, 0)) = fun _ => (0, 0) := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  have hx3' : 3 ≤ JPf.xθ s t α := by
    unfold JPf.xθ; rw [le_div_iff₀ hsR]; exact_mod_cast hx3
  have hz := segInvFullS_zero (P := P) (R := R) (w := w) (Bu := 1 / 2) hs hst.le hα hx3' hl hw hR
    (by norm_num) hP
  funext l
  simp [B0seg, Dapprox, segJ, cSel, hz]

end J6Seg

end

