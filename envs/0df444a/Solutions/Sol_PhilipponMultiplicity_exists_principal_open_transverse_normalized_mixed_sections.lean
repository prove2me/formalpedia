theorem specialize_universalRow (l : List M.FactorIndex)
    (c : Fin l.length → M.Variable → K) (j : Fin l.length) :
    map (eval (Function.uncurry c)) (universalRow M l j) =
      MixedFlag.polynomial M l c j := by
  simp [universalRow, MixedFlag.polynomial, MixedFlag.rowForm, smul_eq_C_mul]

/-- The universal normalized ideal specializes into the exact ideal of the target. -/
theorem specialize_normalizedIdeal_le (l : List M.FactorIndex) (S : Set M.Point)
    (c : Fin l.length → M.Variable → K)
    (b : ∀ i : M.FactorIndex, Fin (M.ambientDimension i + 1)) :
    (normalizedIdeal M l S b).map (map (eval (Function.uncurry c))) ≤
      MixedFlag.ideal M (M.vanishingIdeal S) l c l.length ⊔
        Ideal.span (Set.range (fun i : M.FactorIndex =>
          (X (⟨i,b i⟩ : M.Variable) : M.CoordinateRing) - 1)) := by
  classical
  let φ : UniversalRing M l →+* M.CoordinateRing := map (eval (Function.uncurry c))
  let J : Ideal M.CoordinateRing :=
    MixedFlag.ideal M (M.vanishingIdeal S) l c l.length ⊔
      Ideal.span (Set.range (fun i : M.FactorIndex =>
        (X (⟨i,b i⟩ : M.Variable) : M.CoordinateRing) - 1))
  change (normalizedIdeal M l S b).map φ ≤ J
  have hcomp : φ.comp (map C) = RingHom.id M.CoordinateRing := by
    ext r j <;> simp [φ]
  rw [normalizedIdeal, Ideal.map_sup, Ideal.map_sup, Ideal.map_map, hcomp, Ideal.map_id]
  apply sup_le
  · apply sup_le
    · exact le_sup_of_le_left le_sup_left
    · rw [Ideal.map_iSup]
      apply iSup_le
      intro j
      apply Ideal.map_le_iff_le_comap.mpr
      apply Ideal.span_le.mpr
      rintro P (rfl : P = universalRow M l j)
      change map (eval (Function.uncurry c)) (universalRow M l j) ∈ J
      rw [specialize_universalRow]
      have hcut : Ideal.span {MixedFlag.polynomial M l c j} ≤
          MixedFlag.ideal M (M.vanishingIdeal S) l c l.length :=
        le_sup_of_le_right (le_iSup_of_le j (le_iSup_of_le j.isLt le_rfl))
      exact (le_sup_left : MixedFlag.ideal M (M.vanishingIdeal S) l c l.length ≤ J)
        (hcut (Ideal.subset_span (Set.mem_singleton _)))
  · apply Ideal.map_le_iff_le_comap.mpr
    apply Ideal.span_le.mpr
    rintro P ⟨i, rfl⟩
    change map (eval (Function.uncurry c)) (X (⟨i,b i⟩ : M.Variable) - 1) ∈ J
    simp only [map_sub, map_X, map_one]
    exact (le_sup_right : Ideal.span (Set.range (fun i : M.FactorIndex =>
      (X (⟨i,b i⟩ : M.Variable) : M.CoordinateRing) - 1)) ≤ J)
        (Ideal.subset_span (Set.mem_range_self i))

/-- Normalize a projective zero in a pivot chart, retaining every equation of the ideal. -/
theorem normalized_zero
    (I : Ideal M.CoordinateRing) (hI : M.IsHomogeneousIdeal I)
    (x : M.Point) (hx : x ∈ M.zeroLocus I)
    (b : ∀ i : M.FactorIndex, Fin (M.ambientDimension i + 1))
    (hb : ∀ i, M.coordinate x ⟨i,b i⟩ ≠ 0) :
    ∀ P ∈ I ⊔ Ideal.span (Set.range (fun i : M.FactorIndex =>
      (X (⟨i,b i⟩ : M.Variable) : M.CoordinateRing) - 1)),
      eval (fun j => M.coordinate x j / M.coordinate x ⟨j.1,b j.1⟩) P = 0 := by
  let n : M.Variable → K := fun j => M.coordinate x j / M.coordinate x ⟨j.1,b j.1⟩
  have hker : I ⊔ Ideal.span (Set.range (fun i : M.FactorIndex =>
      (X (⟨i,b i⟩ : M.Variable) : M.CoordinateRing) - 1)) ≤ RingHom.ker (eval n) := by
    apply sup_le
    · rw [hI]
      apply Ideal.span_le.mpr
      rintro P ⟨hP, D, hD⟩
      have hs := M.eval_block_scale P D hD (M.coordinate x)
        (fun i => (M.coordinate x ⟨i,b i⟩)⁻¹)
      have hz : eval (M.coordinate x) P = 0 := hx P hP
      change eval n P = 0
      simpa only [n, div_eq_mul_inv, mul_comm, hz, mul_zero, zero_mul] using hs
    · apply Ideal.span_le.mpr
      rintro _ ⟨i, rfl⟩
      change eval n (X (⟨i,b i⟩ : M.Variable) - 1) = 0
      simp [n, div_self (hb i)]
  exact hker

theorem mixed_zero (l : List M.FactorIndex) (S : Set M.Point)
    (c : Fin l.length → M.Variable → K) (x : M.Point) (hx : x ∈ S)
    (hrows : ∀ j : Fin l.length, M.eval (MixedFlag.polynomial M l c j) x = 0) :
    x ∈ M.zeroLocus (MixedFlag.ideal M (M.vanishingIdeal S) l c l.length) := by
  have hle : MixedFlag.ideal M (M.vanishingIdeal S) l c l.length ≤
      RingHom.ker (eval (M.coordinate x)) := by
    apply sup_le
    · intro P hP
      exact M.eval_eq_zero_of_mem_vanishingIdeal hP hx
    · apply iSup_le
      intro j
      apply iSup_le
      intro hj
      apply Ideal.span_le.mpr
      rintro P (rfl : P = MixedFlag.polynomial M l c j)
      exact hrows j
  exact hle

/-- Unit boundary ideals in all normalized charts imply the required projective avoidance. -/
theorem boundary_disjoint
    (l : List M.FactorIndex) (W B : Set M.Point) (c : Fin l.length → M.Variable → K)
    (h : ∀ b : ∀ i : M.FactorIndex, Fin (M.ambientDimension i + 1),
      MixedFlag.ideal M (M.vanishingIdeal B) l c l.length ⊔
        Ideal.span (Set.range (fun i : M.FactorIndex =>
          (X (⟨i,b i⟩ : M.Variable) : M.CoordinateRing) - 1)) = ⊤) :
    Disjoint {x : M.Point | x ∈ W ∧
      ∀ j : Fin l.length, M.eval (MixedFlag.polynomial M l c j) x = 0} B := by
  classical
  apply Set.disjoint_left.mpr
  rintro x ⟨hxW, hrows⟩ hxB
  have hex (i : M.FactorIndex) : ∃ j, M.coordinate x ⟨i,j⟩ ≠ 0 := by
    simpa only [MultiProjectiveSpace.coordinate, ne_eq, _root_.funext_iff,
      Pi.zero_apply, not_forall] using (x i).rep_nonzero
  choose b hb using hex
  have hzero := normalized_zero M _
    (NormalizedChartRadical.mixed_ideal_homogeneous M B l c l.length)
    x (mixed_zero M l B c x hxB hrows) b hb
  have h1 := hzero 1 (by rw [h b]; trivial)
  exact (one_ne_zero : (1 : K) ≠ 0) (by simpa using h1)

end PhilipponMultiplicity.GenericMixedSections
end
