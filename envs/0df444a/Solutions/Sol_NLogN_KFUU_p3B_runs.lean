namespace NLogN.KIL

open AModel AModelL12

theorem encode_app4 (A F G C : Shape) (a f g c : List ℕ) (ha : a.length = A.length)
    (hf : f.length = F.length) (hg : g.length = G.length) :
    encode (A ++ F ++ G ++ C) (a ++ f ++ g ++ c) =
      ((encode A a * AModel.vol F + encode F f) * AModel.vol G + encode G g) * AModel.vol C + encode C c := by
  rw [encode_append_len _ _ (by simp [ha, hf, hg]), encode_append_len _ _ (by simp [ha, hf]),
    encode_append_len _ _ ha]

theorem swapMid_app (a f g c : List ℕ) :
    swapMid a.length f.length g.length (a ++ g ++ f ++ c) = a ++ f ++ g ++ c := by
  unfold swapMid
  simp only [List.append_assoc]
  have e1 : List.drop (a.length + g.length) (a ++ (g ++ (f ++ c))) = f ++ c := by
    rw [List.drop_append, List.drop_eq_nil_of_le (by omega)]; simp
  have e2 : List.drop a.length (a ++ (g ++ (f ++ c))) = g ++ (f ++ c) := List.drop_left' rfl
  have e3 : List.drop (a.length + g.length + f.length) (a ++ (g ++ (f ++ c))) = c := by
    rw [Nat.add_assoc, List.drop_append, List.drop_eq_nil_of_le (by omega)]; simp
  rw [e1, e2, e3, List.take_left' rfl, List.take_left' rfl, List.take_left' rfl]

theorem pull_swapMid {α : Type*} (A F G C : Shape) (d : α) (xs : List α) :
    AModel.pull (A ++ F ++ G ++ C) (A ++ G ++ F ++ C) (swapMid A.length F.length G.length) d xs =
      AModel.pull [AModel.vol A, AModel.vol F, AModel.vol G, AModel.vol C] [AModel.vol A, AModel.vol G, AModel.vol F, AModel.vol C] NLogN.KIL.gS d xs := by
  have hv : AModel.vol (A ++ G ++ F ++ C) = AModel.vol [AModel.vol A, AModel.vol G, AModel.vol F, AModel.vol C] := by
    simp only [vol_append, vol4]
  apply List.ext_getElem (by rw [length_pull, length_pull, hv])
  intro j h1 h2
  simp only [length_pull] at h1 h2
  rw [getElem_pull, getElem_pull]
  congr 1
  -- digits of `j` in the collapsed output shape
  have hval := valid_decode h2
  obtain ⟨a, g, f, c, hdec, ha, hg, hf, hc⟩ : ∃ a g f c, decode [AModel.vol A, AModel.vol G, AModel.vol F, AModel.vol C] j =
      [a, g, f, c] ∧ a < AModel.vol A ∧ g < AModel.vol G ∧ f < AModel.vol F ∧ c < AModel.vol C := by
    generalize decode [AModel.vol A, AModel.vol G, AModel.vol F, AModel.vol C] j = D at hval
    rcases hval with _ | ⟨ha, _ | ⟨hg, _ | ⟨hf, _ | ⟨hc, h⟩⟩⟩⟩
    cases h
    exact ⟨_, _, _, _, rfl, ha, hg, hf, hc⟩
  have hj : j = ((a * AModel.vol G + g) * AModel.vol F + f) * AModel.vol C + c := by
    rw [← encode_decode h2, hdec, encode4]
  set D := decode A a ++ decode G g ++ decode F f ++ decode C c with hD
  have hDv : AModel.Valid (A ++ G ++ F ++ C) D :=
    valid_append (valid_append (valid_append (valid_decode ha) (valid_decode hg)) (valid_decode hf))
      (valid_decode hc)
  have hDe : encode (A ++ G ++ F ++ C) D = j := by
    rw [hD, encode_app4 _ _ _ _ _ _ _ _ (AModel.length_decode _ _) (AModel.length_decode _ _) (AModel.length_decode _ _),
      encode_decode ha, encode_decode hg, encode_decode hf, encode_decode hc, hj]
  have hdD : decode (A ++ G ++ F ++ C) j = D := by rw [← hDe, decode_encode hDv]
  rw [hdD, hdec, hD]
  have e1 := swapMid_app (decode A a) (decode F f) (decode G g) (decode C c)
  rw [AModel.length_decode, AModel.length_decode, AModel.length_decode] at e1
  rw [e1, encode_app4 _ _ _ _ _ _ _ _ (AModel.length_decode _ _) (AModel.length_decode _ _) (AModel.length_decode _ _),
    encode_decode ha, encode_decode hg, encode_decode hf, encode_decode hc]
  simp [NLogN.KIL.gS, encode4]

