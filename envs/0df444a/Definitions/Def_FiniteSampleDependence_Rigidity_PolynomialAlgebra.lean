-- title:
--   The polynomial ring $\mathbb R[U_{i\alpha}]$, maximal-minor ideal $I_n$, the ideal $(\tau-1)$ and $F_{\mathrm{Gram}}=\det(UU^\top)$
-- statement:
--   Let $R_{n,m}=\mathbb R[X_{i\alpha}: 1\le i\le n,\ 1\le\alpha\le m]$ be the real polynomial ring in $nm$ independent variables, and $X=(X_{i\alpha})$ the generic $n\times m$ matrix. A polynomial $P\in R_{n,m}$ defines the functional $U\mapsto P(U)$ by evaluating $X_{i\alpha}$ at $U_{i\alpha}$.
--
--   Put $\tau=\sum_{i,\alpha}X_{i\alpha}$ and let $(\tau-1)$ be the principal ideal it generates; two polynomials agree on $\Delta_{n,m}$ exactly when their difference lies in $(\tau-1)$.
--
--   For an $n$-element set of columns $S=\{s_1<\dots<s_n\}\subseteq\{1,\dots,m\}$ the **maximal minor** is $\Delta_S=\det X_{\bullet S}$, and the **maximal-minor ideal** is
--   $$I_n=\langle \Delta_S:\ S\subseteq[m],\ |S|=n\rangle\subseteq R_{n,m}.$$
--   Its square $I_n^2$ is the ordinary ideal product, generated by products of two maximal minors, and $I_n^2+(\tau-1)$ is an ideal sum.
--
--   The **Gram polynomial** is
--   $$F_{\mathrm{Gram}}=\det(XX^\top)\in R_{n,m},$$
--   whose value at a real matrix $U$ is $\det(UU^\top)$ (proved in the file).
--
--   These are the algebraic objects of the paper's determinantal-rigidity theorem.
--
--   **Formalization Note** $R_{n,m}$ is `MvPolynomial (Fin n × Fin m) ℝ` and $X$ is Mathlib's `Matrix.mvPolynomialX`. A column set is given by a strictly increasing map `Fin n → Fin m`, which lists an $n$-subset in increasing order; the ideal does not depend on the order chosen. Degree is `MvPolynomial.totalDegree`.
-- source:
--   Yuqing Kong, Limits of Finite-Sample Dependence Measures under Data Processing Inequality, STOC 2027 submission #152 (October 2026; SHA-256 f5e620d74cb49d294e046590e96036aa28bf617d4b212a292b7bb68435363118), Section 2 'Polynomial functions on the simplex', PDF p. 7 (printed p. 6); Section 4 opening (I_n, Δ_S), PDF p. 11 (printed p. 10); Proposition 4.4 (F_Gram), PDF p. 14 (printed p. 13)

import Mathlib
import Definitions.Def_FiniteSampleDependence_Rigidity_Model

namespace FiniteSampleDependence.Rigidity

open Matrix MvPolynomial

/-- `R_{n,m} = ℝ[U_{iα}]`: the real polynomial ring in the `nm` independent matrix entries. -/
abbrev PolyRing (n m : ℕ) := MvPolynomial (Fin n × Fin m) ℝ

/-- The generic `n × m` matrix `X = (X_{iα})` over `R_{n,m}`. -/
noncomputable abbrev genericMatrix (n m : ℕ) : Matrix (Fin n) (Fin m) (PolyRing n m) :=
  Matrix.mvPolynomialX (Fin n) (Fin m) ℝ

/-- Evaluation of a polynomial `P ∈ R_{n,m}` at a real matrix `U`, i.e. the functional
`U ↦ P(U)` defined by `P`. -/
noncomputable def polyFun {n m : ℕ} (P : PolyRing n m) : Matrix (Fin n) (Fin m) ℝ → ℝ :=
  fun U => MvPolynomial.eval (fun p : Fin n × Fin m => U p.1 p.2) P

/-- The polynomial `τ = ∑_{i,α} X_{iα}`. -/
noncomputable def tauPoly (n m : ℕ) : PolyRing n m :=
  ∑ i : Fin n, ∑ α : Fin m, X (i, α)

/-- The ideal `(τ − 1) ⊆ R_{n,m}` of polynomials vanishing identically on the simplex
equation. -/
noncomputable def simplexIdeal (n m : ℕ) : Ideal (PolyRing n m) :=
  Ideal.span {tauPoly n m - 1}

/-- The maximal minor `Δ_S = det X_{•S}` for the column set `S = {s 0 < s 1 < ⋯ < s (n-1)}`,
given by a strictly increasing `s : Fin n → Fin m` (equivalently an `n`-element subset of the
columns, listed in increasing order). -/
noncomputable def maxMinor {n m : ℕ} (s : Fin n → Fin m) : PolyRing n m :=
  ((genericMatrix n m).submatrix id s).det

/-- The maximal-minor ideal `I_n = ⟨Δ_S : S ⊆ [m], |S| = n⟩ ⊆ R_{n,m}`. -/
noncomputable def maxMinorIdeal (n m : ℕ) : Ideal (PolyRing n m) :=
  Ideal.span {p | ∃ s : Fin n → Fin m, StrictMono s ∧ p = maxMinor s}

/-- The Gram-determinant polynomial `F_Gram = det(X Xᵀ) ∈ R_{n,m}`, whose value at `U` is
`det(U Uᵀ)`. -/
noncomputable def gramPoly (n m : ℕ) : PolyRing n m :=
  (genericMatrix n m * (genericMatrix n m)ᵀ).det

/-- Sanity check of the encoding: `F_Gram(U) = det(U Uᵀ)`. -/
theorem polyFun_gramPoly {n m : ℕ} (U : Matrix (Fin n) (Fin m) ℝ) :
    polyFun (gramPoly n m) U = (U * Uᵀ).det := by
  unfold polyFun gramPoly
  rw [RingHom.map_det, RingHom.mapMatrix_apply, Matrix.map_mul]
  congr 3 <;> ext i j <;> simp [genericMatrix, Matrix.mvPolynomialX_apply]

/-- Sanity check of the encoding: `τ(U)` is the value of `τ` at `U`. -/
theorem polyFun_tauPoly {n m : ℕ} (U : Matrix (Fin n) (Fin m) ℝ) :
    polyFun (tauPoly n m) U = tau U := by
  simp [polyFun, tauPoly, tau]

end FiniteSampleDependence.Rigidity


