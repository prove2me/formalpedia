section bridge

variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}

theorem pdMC_Omega (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (μ B : Fin n) :
    pdMC μ (Omega g gi E Θ B) x = ∑ ν, (cpdC μ (E B ν) x • omegaC g gi E Θ ν x
      + E B ν x • pdMC μ (omegaC g gi E Θ ν) x) := by
  have hU := hF.isOpen
  unfold Omega
  rw [pdMC_sum hU hx μ Finset.univ fun ν _ => SmoothOnC.smul (hF.smooth_E B ν) (hF.smoothOnC_omegaC ν)]
  exact Finset.sum_congr rfl fun ν _ => pdMC_smul hU hx μ (hF.smooth_E B ν) (hF.smoothOnC_omegaC ν)

theorem Dmat_Omega (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (A B : Fin n) :
    Dmat E A (Omega g gi E Θ B) x = ∑ ν, fdir E A (E B ν) x • omegaC g gi E Θ ν x
      + ∑ μ, ∑ ν, (E A μ x * E B ν x) • pdMC μ (omegaC g gi E Θ ν) x := by
  unfold Dmat
  simp only [pdMC_Omega hF hx, Finset.smul_sum, smul_add, Finset.sum_add_distrib, smul_smul]
  congr 1
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ν _ => ?_
  simp only [fdir, Finset.sum_smul]

theorem sum_cfr_Omega (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (A B : Fin n) :
    ∑ C, cfr E Θ C A B x • Omega g gi E Θ C x = ∑ ν, brk E A B ν x • omegaC g gi E Θ ν x := by
  simp only [Omega, Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ν _ => ?_
  rw [← Finset.sum_smul]
  congr 1
  exact hF.sum_coeff hx (fun ρ => brk E A B ρ x) ν

theorem Omega_mul (A B : Fin n) (x : Pt n) :
    Omega g gi E Θ A x * Omega g gi E Θ B x
      = ∑ μ, ∑ ν, (E A μ x * E B ν x) • (omegaC g gi E Θ μ x * omegaC g gi E Θ ν x) := by
  simp only [Omega, Finset.sum_mul, Finset.mul_sum, Matrix.smul_mul, Matrix.mul_smul, smul_smul]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun ν _ => by rw [mul_comm (E B ν x)]

end bridge

