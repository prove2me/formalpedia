theorem ode_unique_Icc {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] {F : E → E} (hF : ContDiff ℝ 1 F)
    {a b : ℝ} {f g : ℝ → E}
    (hf : ContinuousOn f (Icc a b)) (hg : ContinuousOn g (Icc a b))
    (hf' : ∀ t ∈ Ico a b, HasDerivWithinAt f (F (f t)) (Ici t) t)
    (hg' : ∀ t ∈ Ico a b, HasDerivWithinAt g (F (g t)) (Ici t) t)
    (ha : f a = g a) : EqOn f g (Icc a b) := by
  obtain ⟨r, hr⟩ := ((isCompact_Icc.image_of_continuousOn hf).union
    (isCompact_Icc.image_of_continuousOn hg)).isBounded.subset_closedBall (0 : E)
  obtain ⟨K, hK⟩ := hF.contDiffOn.exists_lipschitzOnWith one_ne_zero
    (convex_closedBall (0 : E) r) (isCompact_closedBall (0 : E) r)
  exact ODE_solution_unique_of_mem_Icc_right (fun _ _ ↦ hK) hf hf'
    (fun t ht ↦ hr (Or.inl ⟨t, ⟨ht.1, ht.2.le⟩, rfl⟩)) hg hg'
    (fun t ht ↦ hr (Or.inr ⟨t, ⟨ht.1, ht.2.le⟩, rfl⟩)) ha

