theorem cbar_mul (a b : Sp.CornerRing i₀) : cb (a * b) = cstar c RR (cb a) (cb b) := by
  show (red r) ∘ crdO (ΞAA ((a : 𝕋) * (b : 𝕋))) = _
  rw [map_mul, crd_mul T u c 𝒪 huindO huspanO hu_mul, cstar_map]
  rfl

