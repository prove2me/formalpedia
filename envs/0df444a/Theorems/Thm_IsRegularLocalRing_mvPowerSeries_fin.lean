theorem IsRegularLocalRing.mvPowerSeries_fin (𝓞 : Type*) [CommRing 𝓞] [IsDomain 𝓞]
    [IsDiscreteValuationRing 𝓞] (n : ℕ) :
    IsRegularLocalRing (MvPowerSeries (Fin n) 𝓞) := by sorry
