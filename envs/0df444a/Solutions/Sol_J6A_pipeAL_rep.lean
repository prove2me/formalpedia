/-!
# B-line machine, sweep 2: the per-axis passes on line representations

A `(pre, n, post)` array `L` *represents* the lines `φ b c` (`LRep pre n post L φ`) when
`L[b (n·post) + a·post + c] = (φ b c)[a]`. The machine's passes act on representations:

* **`LRep_axisL`**: the in-place axis map applies `f` to every line;
* **`LRep_slabPass`**: a monotone slab pass (output slab `l` = `h l` of input slab `src l`, or
  zeros) applies `slabLine` to every line (selection, `J` gather and scatter, output);
* **`LRep_kerPass`**: expose `(A, m, post) → (A, post, m)` (`blkTg`), apply a kernel to each
  contiguous `m`-row (indexed by its block), expose back;
* **`LRep_split` / `LRep_join`**: `(pre, nc·λ, post)` is `(pre·nc, λ, post)`;
* **`LRep_chunkPass`**: the chunk kernel `chunksG g λ nc` on every line, by one `λ`-exposure.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

section passes
variable {α β : Type*} [Inhabited α] [Inhabited β]

lemma idx3_lt {pre n post b a c : ℕ} (hb : b < pre) (ha : a < n) (hc : c < post) :
    b * (n * post) + a * post + c < pre * (n * post) := by
  have h1 := lt_mul_of_split ha hc
  have : (b + 1) * (n * post) ≤ pre * (n * post) := Nat.mul_le_mul_right _ (by omega)
  rw [Nat.succ_mul] at this; omega

theorem LRep_congr {pre n post : ℕ} {L : List α} {φ ψ : ℕ → ℕ → List α}
    (h : LRep pre n post L φ) (he : ∀ b < pre, ∀ c < post, φ b c = ψ b c) :
    LRep pre n post L ψ :=
  ⟨h.1, fun b hb c hc => by rw [← he b hb c hc]; exact h.2.1 b hb c hc,
    fun b hb a ha c hc => by rw [← he b hb c hc]; exact h.2.2 b hb a ha c hc⟩

/-! ## Slab passes -/

/-! ## Exposures and kernels on rows -/

theorem length_blkTg (m k a : ℕ) (zs : List α) : (blkTg m k a zs).length = a * (k * m) := by
  unfold blkTg
  rw [List.flatMap_def, IntMul.HvdH.RefPf.length_flatten_uniform (k * m)]
  · simp
  · intro row hrow
    simp only [List.mem_map, List.mem_range] at hrow
    obtain ⟨i, _, rfl⟩ := hrow
    exact IntMul.HvdH.RefPf.transposeL_length m k _

theorem blkTg_getD (m k a : ℕ) (zs : List α) {i c r : ℕ} (hi : i < a) (hc : c < k)
    (hr : r < m) :
    (blkTg m k a zs).getD (i * (k * m) + c * m + r) default =
      zs.getD (i * (m * k) + r * k + c) default := by
  unfold blkTg
  have hrows : ∀ row ∈ (List.range a).map (fun i => transposeL m k ((zs.drop (i * (m * k))).take
      (m * k))), row.length = k * m := by
    intro row hrow
    simp only [List.mem_map, List.mem_range] at hrow
    obtain ⟨i, _, rfl⟩ := hrow
    exact IntMul.HvdH.RefPf.transposeL_length m k _
  rw [List.flatMap_def, Nat.add_assoc, IntMul.HvdH.RefPf.flatten_getD_uniform (k * m) default _
    hrows i (by simp; exact hi) _ (lt_mul_of_split hc hr)]
  rw [List.getD_eq_getElem _ [] (by simp; exact hi), List.getElem_map, List.getElem_range]
  obtain ⟨e1, e2⟩ := mod_div_split (a := c) (post := m) hr
  rw [IntMul.HvdH.RefPf.transposeL_getD m k _ _ (lt_mul_of_split hc hr), e1, e2,
    getD_drop_take zs _ _ _ (lt_mul_of_split hr hc), Nat.add_assoc]

theorem rowMap_spec (n R : ℕ) (g : ℕ → List α → List α)
    (hg : ∀ r X, X.length = n → (g r X).length = n) (X : List α) (hX : X.length = R * n) :
    (rowMap n R g X).length = R * n ∧ ∀ r < R, ∀ a < n,
      (rowMap n R g X).getD (r * n + a) default = (g r ((X.drop (r * n)).take n)).getD a default := by
  have hrows : ∀ row ∈ (List.range R).map (fun r => g r ((X.drop (r * n)).take n)),
      row.length = n := by
    intro row hrow
    simp only [List.mem_map, List.mem_range] at hrow
    obtain ⟨r, hr, rfl⟩ := hrow
    apply hg
    simp only [List.length_take, List.length_drop, hX]
    have : (r + 1) * n ≤ R * n := Nat.mul_le_mul_right _ hr
    rw [Nat.succ_mul] at this; omega
  refine ⟨?_, fun r hr a ha => ?_⟩
  · unfold rowMap
    rw [List.flatMap_def, IntMul.HvdH.RefPf.length_flatten_uniform n _ hrows]; simp
  · unfold rowMap
    rw [List.flatMap_def, IntMul.HvdH.RefPf.flatten_getD_uniform n default _ hrows r
      (by simp; exact hr) a ha]
    rw [List.getD_eq_getElem _ [] (by simp; exact hr), List.getElem_map, List.getElem_range]

theorem LRep_kerPass {A m post : ℕ} (hm : 0 < m) (hp : 0 < post) {L : List α}
    {φ : ℕ → ℕ → List α} (hL : LRep A m post L φ) (g : ℕ → List α → List α)
    (hg : ∀ b X, X.length = m → (g b X).length = m) :
    LRep A m post (kerPass m post A g L) (fun b c => g b (φ b c)) := by
  set X := blkTg m post A L with hXdef
  have hXl : X.length = A * post * m := by rw [length_blkTg]; ring
  obtain ⟨hYl, hY⟩ := rowMap_spec m (A * post) (fun r => g (r / post)) (fun r X h => hg _ X h) X hXl
  have hrow : ∀ b < A, ∀ c < post, (X.drop ((b * post + c) * m)).take m = φ b c := by
    intro b hb c hc
    apply ext_getD' (by
      rw [hL.2.1 b hb c hc]; simp only [List.length_take, List.length_drop, hXl]
      have : (b * post + c + 1) * m ≤ A * post * m :=
        Nat.mul_le_mul_right _ (by
          have : (b + 1) * post ≤ A * post := Nat.mul_le_mul_right _ hb
          rw [Nat.succ_mul] at this; omega)
      rw [Nat.succ_mul] at this; omega)
    intro k hk
    have hkm : k < m := by simp only [List.length_take] at hk; omega
    rw [getD_drop_take X _ _ _ hkm, hXdef,
      show (b * post + c) * m + k = b * (post * m) + c * m + k by ring,
      blkTg_getD m post A L hb hc hkm]
    exact hL.2.2 b hb k hkm c hc
  refine ⟨?_, fun b hb c hc => hg b _ (hL.2.1 b hb c hc), fun b hb a ha c hc => ?_⟩
  · unfold kerPass; rw [length_blkTg]
  unfold kerPass
  rw [blkTg_getD post m A _ hb ha hc, show b * (post * m) + c * m + a = (b * post + c) * m + a by
    ring, hY _ (by
      have : (b + 1) * post ≤ A * post := Nat.mul_le_mul_right _ hb
      rw [Nat.succ_mul] at this; omega) a ha]
  have hdiv : (b * post + c) / post = b := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hp, Nat.div_eq_of_lt hc, zero_add]
  simp only [hdiv]
  rw [hrow b hb c hc]

/-! ## Reshaping `(pre, nc·λ, post) ↔ (pre·nc, λ, post)` -/

theorem LRep_join {pre nc lam post : ℕ} (hl : 0 < lam) {L : List α}
    {ψ : ℕ → ℕ → List α} (hL : LRep (pre * nc) lam post L ψ) :
    LRep pre (nc * lam) post L (fun b c => joinC nc fun q => ψ (b * nc + q) c) := by
  have hbq : ∀ b < pre, ∀ q < nc, b * nc + q < pre * nc := by
    intro b hb q hq
    have : (b + 1) * nc ≤ pre * nc := Nat.mul_le_mul_right _ hb
    rw [Nat.succ_mul] at this; omega
  have hrows : ∀ b < pre, ∀ c < post, ∀ row ∈ (List.range nc).map (fun q => ψ (b * nc + q) c),
      row.length = lam := by
    intro b hb c hc row hrow
    simp only [List.mem_map, List.mem_range] at hrow
    obtain ⟨q, hq, rfl⟩ := hrow
    exact hL.2.1 _ (hbq b hb q hq) c hc
  refine ⟨by rw [hL.1]; ring, fun b hb c hc => ?_, fun b hb a ha c hc => ?_⟩
  · beta_reduce
    unfold joinC
    rw [List.flatMap_def, IntMul.HvdH.RefPf.length_flatten_uniform lam _ (hrows b hb c hc)]
    simp [Nat.mul_comm]
  · obtain ⟨q, r, rfl, hr⟩ : ∃ q r, a = q * lam + r ∧ r < lam :=
      ⟨a / lam, a % lam, (Nat.div_add_mod' a lam).symm, Nat.mod_lt _ hl⟩
    have hq : q < nc := by
      by_contra hcon; push Not at hcon
      have : nc * lam ≤ q * lam := Nat.mul_le_mul_right _ hcon
      omega
    beta_reduce
    unfold joinC
    rw [List.flatMap_def, IntMul.HvdH.RefPf.flatten_getD_uniform lam default _ (hrows b hb c hc) q
      (by simp; exact hq) r hr]
    rw [List.getD_eq_getElem _ [] (by simp; exact hq), List.getElem_map, List.getElem_range,
      ← hL.2.2 _ (hbq b hb q hq) r hr c hc]
    congr 1; ring

end passes

end J6Seg

