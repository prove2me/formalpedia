def embeddingMap (e : X ↪ Y) (he : ∀ x y, dist (e x) (e y) ≤ dist x y) (r : ℝ) :
    CocompactMap (OAI.CoarseAssembly.Rips.Point X r) (OAI.CoarseAssembly.Rips.Point Y r) := by
  classical
  have OAI.CoarseAssembly.Rips.coordinate_continuous {X : Type _} [inst_local_1 : PseudoMetricSpace X] {r : ℝ} (x : X) :
      Continuous (fun p : OAI.CoarseAssembly.Rips.Point X r => p.weight x)  :=
    open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Rips in
    open Topology in
    (continuous_apply x).comp (
      let local_proof {X : Type _} [inst_local_1 : PseudoMetricSpace X] {r : ℝ} : Continuous (OAI.CoarseAssembly.Rips.coordinates (X := X) (r := r)) :=
        open OAI OAI.CoarseAssembly OAI.CoarseAssembly.Rips in
