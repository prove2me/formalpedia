theorem ModularCurve.finrank_adjoin_jqN_eq {N : ℕ} [NeZero N] (data : ModularPolynomialData N) (h : PhiIrreducible data) : Module.finrank (IntermediateField.adjoin ℚ ({jq} : Set (LaurentSeries ℚ))) (IntermediateField.adjoin (IntermediateField.adjoin ℚ ({jq} : Set (LaurentSeries ℚ))) ({jqN N} : Set (LaurentSeries ℚ))) = dedekindPsi N := by sorry
