theorem GlobalTheory.SplitUnitary.form_add_left (Q : Matrix α α E) (w₁ w₂ w' : Matrix α (ν ⊕ ν) E) :
    form c Q (w₁ + w₂) w' = form c Q w₁ w' + form c Q w₂ w' := by sorry
