/-! ## Single pieces -/

theorem cChirpG_le' (n φ w Δ : ℕ) :
    cChirpG n φ w Δ ≤ (n + 1) * (8 * φ + 10 ^ 6 * (w + Δ + 1)) := by
  unfold cChirpG; nlinarith

theorem cTw_le' (n k j : ℕ) :
    cTw n k j ≤ 10 ^ 23 * (n + zsz (j : ℤ) + zsz (k : ℤ) + 30) ^ 5 := by
  have hn := zsz_natCast_le_self' n
  unfold cTw twiddleCost
  have h1 : (zsz (n : ℤ) + zsz (k : ℤ) + zsz (j : ℤ) + 2) ^ 2 ≤
      (n + zsz (j : ℤ) + zsz (k : ℤ) + 30) ^ 5 := by
    calc (zsz (n : ℤ) + zsz (k : ℤ) + zsz (j : ℤ) + 2) ^ 2 ≤ (n + zsz (j : ℤ) + zsz (k : ℤ) + 30) ^ 2 :=
          Nat.pow_le_pow_left (by omega) 2
      _ ≤ _ := Nat.pow_le_pow_right (by omega) (by norm_num)
  have h2 : n + 4 ≤ (n + zsz (j : ℤ) + zsz (k : ℤ) + 30) ^ 5 := by
    calc n + 4 ≤ (n + zsz (j : ℤ) + zsz (k : ℤ) + 30) ^ 1 := by rw [pow_one]; omega
      _ ≤ _ := Nat.pow_le_pow_right (by omega) (by norm_num)
  have h3 : (n + zsz (j : ℤ) + zsz (k : ℤ) + 30) ^ 5 = (n + zsz (j : ℤ) + zsz (k : ℤ) + 30) ^ 5 := rfl
  nlinarith

/-! ## The pieces of `cBody` -/

section Pieces

variable {p h D σ B Bd b len P N : ℕ} {sv t : Fin (D + 1) → ℕ}

theorem zsz_tw (h t : ℕ) (ht : t ≤ 2 ^ (h + 1)) : zsz ((2 * t : ℕ) : ℤ) ≤ h + 3 := by
  apply zsz_le_of_lt
  have : 2 ^ (h + 3) = 4 * 2 ^ (h + 1) := by rw [pow_add, pow_add]; ring
  simp only [Int.natAbs_natCast]
  have : 1 ≤ 2 ^ (h + 1) := Nat.one_le_two_pow
  omega

theorem cAxU_le'_sol_aux (hP : dlV p h (D + 1) + 3 ≤ P) (s t : ℕ) (hst : s ≤ t) (ht : t ≤ 2 ^ (h + 1)) :
    cAxU (dlV p h (D + 1)) s t (KFM.fmB (2 * (dlV p h (D + 1) + 2))) ≤
      10 ^ 27 * ((P + 31) ^ 5 + (2 ^ (h + 1) + 1) * (FM P + P + 1)) := by
  set Δ := dlV p h (D + 1) with hΔ
  have hhΔ : h ≤ Δ := by rw [hΔ]; unfold dlV; omega
  have hφ : KFM.fmB (2 * (Δ + 2)) ≤ FM P := fmB_mono (by omega)
  have a0 := cAxU_le Δ s t (KFM.fmB (2 * (Δ + 2)))
  have z1 := zsz_tw h t ht
  have z2 : zsz ((2 * t - s : ℕ) : ℤ) ≤ h + 3 := (zsz_natCast_le (by omega)).trans z1
  have z3 : zsz ((t : ℕ) : ℤ) ≤ h + 3 := (zsz_natCast_le (by omega)).trans z1
  have z4 : zsz ((t - s : ℕ) : ℤ) ≤ h + 3 := (zsz_natCast_le (by omega)).trans z1
  have b1 := cTw_le' Δ (2 * t) (2 * t - s)
  have b2 := cTw_le' Δ t (t - s)
  have hb : ∀ x y : ℕ, x ≤ h + 3 → y ≤ h + 3 → (Δ + x + y + 30) ^ 5 ≤ 243 * (P + 31) ^ 5 := by
    intro x y hx hy
    calc (Δ + x + y + 30) ^ 5 ≤ (3 * (P + 31)) ^ 5 := Nat.pow_le_pow_left (by omega) 5
      _ = 243 * (P + 31) ^ 5 := by ring
  have b1' := hb _ _ z2 z1
  have b2' := hb _ _ z4 z3
  have b3 := cChirpG_le' t (KFM.fmB (2 * (Δ + 2))) (Δ + 2) Δ
  unfold cAx at a0
  have c1 : cTw Δ (2 * t) (2 * t - s) ≤ 10 ^ 23 * (243 * (P + 31) ^ 5) :=
    b1.trans (Nat.mul_le_mul_left _ b1')
  have c2 : cTw Δ t (t - s) ≤ 10 ^ 23 * (243 * (P + 31) ^ 5) :=
    b2.trans (Nat.mul_le_mul_left _ b2')
  have hX : 1 ≤ (P + 31) ^ 5 := Nat.one_le_pow _ _ (by omega)
  generalize FM P = F at hφ ⊢
  generalize KFM.fmB (2 * (Δ + 2)) = φ at hφ a0 b3 ⊢
  have hr1 : 1 ≤ 2 ^ (h + 1) := Nat.one_le_two_pow
  generalize 2 ^ (h + 1) = r at ht hr1 ⊢
  have b4 : (t + 1) * (8 * φ + 10 ^ 6 * (Δ + 2 + Δ + 1)) ≤ 4 * 10 ^ 6 * ((r + 1) * (F + P + 1)) := by
    calc _ ≤ (r + 1) * (4 * 10 ^ 6 * (F + P + 1)) := Nat.mul_le_mul (by omega) (by omega)
      _ = _ := by ring
  have b5 : Δ + t + 3 ≤ (r + 1) * (F + P + 1) := by
    have e1 : (r + 1) * (F + P + 1) = r * (F + P + 1) + (F + P + 1) := by ring
    have e2 : r ≤ r * (F + P + 1) := Nat.le_mul_of_pos_right _ (by omega)
    omega
  have b34 := b3.trans b4
  clear b3 b4
  generalize (P + 31) ^ 5 = X at c1 c2 hX ⊢
  generalize (r + 1) * (F + P + 1) = Y at b34 b5 ⊢
  linarith

end Pieces

