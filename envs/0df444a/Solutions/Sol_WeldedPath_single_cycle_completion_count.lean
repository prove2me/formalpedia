section
namespace SingleCycleCount

open WeldedPath.SingleCycleGraph
open scoped BigOperators

variable {α V : Type*} [Fintype α] [DecidableEq α] [DecidableEq V]

theorem two_fiber_mate (b : α → V) (v : α)
    (hc : (Finset.univ.filter fun x => b x = b v).card = 2) :
    ∃ v', v' ≠ v ∧ ∀ x, b x = b v ↔ x = v ∨ x = v' := by
  obtain ⟨x, y, hxy, hs⟩ := Finset.card_eq_two.mp hc
  have hv : v ∈ ({x, y} : Finset α) := by rw [← hs]; simp
  simp only [Finset.mem_insert, Finset.mem_singleton] at hv
  rcases hv with hx | hy
  · subst x
    refine ⟨y, Ne.symm hxy, ?_⟩
    intro z
    have hz : (z ∈ Finset.univ.filter fun a => b a = b v) ↔ z ∈ ({v, y} : Finset α) := by rw [hs]
    simpa using hz
  · subst y
    refine ⟨x, hxy, ?_⟩
    intro z
    have hz : (z ∈ Finset.univ.filter fun a => b a = b v) ↔ z ∈ ({x, v} : Finset α) := by rw [hs]
    simpa [or_comm] using hz

/-- Exchange two right-only fixed components, with a specified endpoint sent to
the specified endpoint. The two-component case exchanges both pairs at once. -/
theorem right_pair_transport (a b : α → V) (v z : α)
    (hv : (Finset.univ.filter fun x => b x = b v).card = 2)
    (hz : (Finset.univ.filter fun x => b x = b z).card = 2)
    (ha : ∀ x, a x ≠ b v ∧ a x ≠ b z) :
    ∃ (ρ : Equiv.Perm α) (τ : Equiv.Perm V),
      ρ v = z ∧ (∀ x, b (ρ x) = τ (b x)) ∧ (∀ x, τ (a x) = a x) := by
  by_cases hsame : b v = b z
  · refine ⟨Equiv.swap v z, Equiv.refl _, Equiv.swap_apply_left _ _, ?_, ?_⟩
    · intro x
      exact Equiv.apply_swap_eq_self hsame x
    · intro x; rfl
  obtain ⟨v', hv'ne, hv'⟩ := two_fiber_mate b v hv
  obtain ⟨z', hz'ne, hz'⟩ := two_fiber_mate b z hz
  have hv'b : b v' = b v := (hv' v').2 (Or.inr rfl)
  have hz'b : b z' = b z := (hz' z').2 (Or.inr rfl)
  have hvz : v ≠ z := by intro h; exact hsame (congrArg b h)
  have hvz' : v ≠ z' := by intro h; exact hsame ((congrArg b h).trans hz'b)
  have hv'z : v' ≠ z := by intro h; exact hsame (hv'b.symm.trans (congrArg b h))
  have hv'z' : v' ≠ z' := by intro h; exact hsame (hv'b.symm.trans ((congrArg b h).trans hz'b))
  let ρ := (Equiv.swap v z).trans (Equiv.swap v' z')
  let τ := Equiv.swap (b v) (b z)
  refine ⟨ρ, τ, ?_, ?_, ?_⟩
  · simp [ρ, Equiv.swap_apply_of_ne_of_ne (Ne.symm hv'z) (Ne.symm hz'ne)]
  · intro x
    by_cases hxv : x = v
    · subst x
      simp [ρ, τ, Equiv.swap_apply_of_ne_of_ne (Ne.symm hv'z) (Ne.symm hz'ne)]
    by_cases hxv' : x = v'
    · subst x
      simp [ρ, τ, Equiv.swap_apply_of_ne_of_ne hv'ne hv'z, hv'b, hz'b]
    by_cases hxz : x = z
    · subst x
      simp [ρ, τ, Equiv.swap_apply_of_ne_of_ne (Ne.symm hv'ne) hvz']
    by_cases hxz' : x = z'
    · subst x
      simp [ρ, τ, Equiv.swap_apply_of_ne_of_ne (Ne.symm hvz') hz'ne, hv'b, hz'b]
    have hbxv : b x ≠ b v := by intro h; rcases (hv' x).1 h with h | h <;> contradiction
    have hbxz : b x ≠ b z := by intro h; rcases (hz' x).1 h with h | h <;> contradiction
    simp only [ρ, τ, Equiv.trans_apply,
      Equiv.swap_apply_of_ne_of_ne hxv hxz,
      Equiv.swap_apply_of_ne_of_ne hxv' hxz',
      Equiv.swap_apply_of_ne_of_ne hbxv hbxz]
  · intro x
    exact Equiv.swap_apply_of_ne_of_ne (ha x).1 (ha x).2

def endpointMatchingIso (a b a' b' : α → V) (τ : Equiv.Perm V)
    (ha : ∀ i, τ (a i) = a' i) (hb : ∀ i, τ (b i) = b' i) :
    matchingGraph ⊥ a b ≃g matchingGraph ⊥ a' b' := by
  refine ⟨τ, ?_⟩
  intro x y
  simp only [matchingGraph, SimpleGraph.sup_adj, SimpleGraph.bot_adj, false_or,
    SimpleGraph.fromRel_adj]
  change ((τ x ≠ τ y) ∧
    ((∃ i, τ x = a' i ∧ τ y = b' i) ∨ (∃ i, τ y = a' i ∧ τ x = b' i))) ↔
    (x ≠ y) ∧ ((∃ i, x = a i ∧ y = b i) ∨ (∃ i, y = a i ∧ x = b i))
  constructor
  · rintro ⟨hne, h | h⟩
    · obtain ⟨i, hx, hy⟩ := h
      exact ⟨fun he => hne (congrArg τ he),
        Or.inl ⟨i, τ.injective (hx.trans (ha i).symm), τ.injective (hy.trans (hb i).symm)⟩⟩
    · obtain ⟨i, hy, hx⟩ := h
      exact ⟨fun he => hne (congrArg τ he),
        Or.inr ⟨i, τ.injective (hy.trans (ha i).symm), τ.injective (hx.trans (hb i).symm)⟩⟩
  · rintro ⟨hne, h | h⟩
    · obtain ⟨i, hx, hy⟩ := h
      exact ⟨fun he => hne (τ.injective he),
        Or.inl ⟨i, (congrArg τ hx).trans (ha i), (congrArg τ hy).trans (hb i)⟩⟩
    · obtain ⟨i, hy, hx⟩ := h
      exact ⟨fun he => hne (τ.injective he),
        Or.inr ⟨i, (congrArg τ hy).trans (ha i), (congrArg τ hx).trans (hb i)⟩⟩

theorem partnerFiber_card_eq_of_postcompose (C : Finset (Equiv.Perm α)) (u v z : α)
    (ρ : Equiv.Perm α) (hv : ρ v = z)
    (hstable : ∀ π, π.trans ρ ∈ C ↔ π ∈ C) :
    (partnerFiber C u v).card = (partnerFiber C u z).card := by
  refine Finset.card_bij' (s := partnerFiber C u v) (t := partnerFiber C u z)
    (fun π _ => π.trans ρ) (fun π _ => π.trans ρ.symm) ?_ ?_ ?_ ?_
  · intro π hπ
    obtain ⟨hC, hp⟩ := (mem_partnerFiber _ _ _ _).1 hπ
    refine (mem_partnerFiber C u z (π.trans ρ)).2 ⟨(hstable π).2 hC, ?_⟩
    change ρ (π u) = z
    rw [hp]
    exact hv
  · intro π hπ
    obtain ⟨hC, hp⟩ := (mem_partnerFiber _ _ _ _).1 hπ
    refine (mem_partnerFiber C u v (π.trans ρ.symm)).2 ⟨?_, ?_⟩
    · apply (hstable (π.trans ρ.symm)).1
      simpa [Equiv.trans_assoc] using hC
    · simp [hp, ← hv]
  · intro π _
    simp [Equiv.trans_assoc]
  · intro π _
    simp [Equiv.trans_assoc]

end SingleCycleCount
end
-- END Solutions.SingleCycleCountPairSymmetry

-- BEGIN Solutions.SingleCycleCountAbstract
section
namespace SingleCycleCount

open Classical WeldedPath.SingleCycleGraph
open scoped BigOperators

set_option linter.unusedSectionVars false

variable {α V : Type*} [Fintype α] [DecidableEq α] [DecidableEq V]

noncomputable def completionSet (a b : α → V) : Finset (Equiv.Perm α) :=
  Finset.univ.filter fun π => (matchingGraph ⊥ a (fun i => b (π i))).Preconnected

@[simp] theorem mem_completionSet (a b : α → V) (π : Equiv.Perm α) :
    π ∈ completionSet a b ↔ (matchingGraph ⊥ a (fun i => b (π i))).Preconnected := by
  simp [completionSet]

theorem single_fiber_iff (a : α → V) (u : α)
    (h : (Finset.univ.filter fun i => a i = a u).card = 1) (i : α) :
    a i = a u ↔ i = u := by
  obtain ⟨j, hj⟩ := Finset.card_eq_one.mp h
  have hu : u ∈ ({j} : Finset α) := by rw [← hj]; simp
  have hju : j = u := (Finset.mem_singleton.mp hu).symm
  subst j
  have hi : (i ∈ Finset.univ.filter fun j => a j = a u) ↔ i ∈ ({u} : Finset α) := by rw [hj]
  simpa using hi

theorem shiftPartner_as_insertion (π : Equiv.Perm α) (u w v i : α) :
    shiftPartner π u w v i = normalizePartner π u w
      (Equiv.swap u ((normalizePartner π u w).symm v) i) := by
  change Equiv.swap w v (normalizePartner π u w i) = _
  simpa only [normalizePartner_apply, Equiv.apply_symm_apply] using
    (normalizePartner π u w).injective.swap_apply u ((normalizePartner π u w).symm v) i

theorem matching_shift_eq_inserted (a b : α → V) (π : Equiv.Perm α) (u w v : α) :
    matchingGraph ⊥ a (fun i => b (shiftPartner π u w v i)) =
      insertedGraph ⊥ a (fun i => b (normalizePartner π u w i))
        u ((normalizePartner π u w).symm v) := by
  unfold insertedGraph
  apply congrArg (matchingGraph ⊥ a)
  funext i
  exact congrArg b (shiftPartner_as_insertion π u w v i)

theorem lr_avoids_own_partner (a b : α → V) (u w : α)
    (hm : 2 ≤ Fintype.card α) (haw : a u = b w)
    (ha : ∀ i, a i = a u ↔ i = u) (hb : ∀ i, b i = b w ↔ i = w)
    (π : Equiv.Perm α) (hπ : π ∈ completionSet a b) : π u ≠ w := by
  intro hp
  have hpre := (mem_completionSet a b π).1 hπ
  have : Nontrivial α := Fintype.one_lt_card_iff_nontrivial.mp (by omega)
  obtain ⟨j, hju⟩ := exists_ne u
  have haj : a u ≠ a j := by intro he; exact hju ((ha j).1 he.symm)
  have : Nontrivial V := ⟨⟨a u, a j, haj⟩⟩
  apply hpre.not_isIsolated (a u)
  intro x hx
  simp only [matchingGraph, SimpleGraph.sup_adj, SimpleGraph.bot_adj, false_or,
    SimpleGraph.fromRel_adj] at hx
  obtain ⟨hne, h | h⟩ := hx
  · obtain ⟨i, hai, hxb⟩ := h
    have hi : i = u := (ha i).1 hai.symm
    subst i
    apply hne
    rw [hxb, hp, haw]
  · obtain ⟨i, hxa, hbi⟩ := h
    have hiw : π i = w := (hb (π i)).1 (hbi.symm.trans haw)
    have hi : i = u := π.injective (hiw.trans hp.symm)
    subst i
    exact hne hxa.symm

theorem lr_shift_stable (a b : α → V) (u w : α)
    (hm : 2 ≤ Fintype.card α) (haw : a u = b w)
    (ha : ∀ i, a i = a u ↔ i = u) (hb : ∀ i, b i = b w ↔ i = w)
    (π : Equiv.Perm α) (hπ : π ∈ completionSet a b) (v : α) (hvw : v ≠ w) :
    shiftPartner π u w v ∈ completionSet a b := by
  let θ := normalizePartner π u w
  have hθ : θ u = w := normalizePartner_apply π u w
  have hpw := lr_avoids_own_partner a b u w hm haw ha hb π hπ
  have hj : θ.symm (π u) ≠ u := by
    intro he
    have hh := congrArg θ he
    simp only [Equiv.apply_symm_apply, hθ] at hh
    exact hpw hh
  have hk : θ.symm v ≠ u := by
    intro he
    have hh := congrArg θ he
    simp only [Equiv.apply_symm_apply, hθ] at hh
    exact hvw hh
  have hu : (⊥ : SimpleGraph V).Reachable (a u) (b (θ u)) := by
    rw [SimpleGraph.reachable_bot, hθ]
    exact haw
  have hsep : ∀ i, i ≠ u → ¬ (⊥ : SimpleGraph V).Reachable (a u) (a i) ∧
      ¬ (⊥ : SimpleGraph V).Reachable (a u) (b (θ i)) := by
    intro i hi
    simp only [SimpleGraph.reachable_bot]
    constructor
    · intro he; exact hi ((ha i).1 he.symm)
    · intro he
      have htw : θ i = w := (hb (θ i)).1 (he.symm.trans haw)
      exact hi (θ.injective (htw.trans hθ.symm))
  have hconn :
      (insertedGraph ⊥ a (fun i => b (θ i)) u (θ.symm (π u))).Preconnected ↔
        (insertedGraph ⊥ a (fun i => b (θ i)) u (θ.symm v)).Preconnected := by
    simpa only [true_implies, SimpleGraph.Preconnected] using
      insertion_connectedOn_iff ⊥ a (fun i => b (θ i)) u (θ.symm (π u))
        (θ.symm v) (fun _ => True) hu hj hk hsep trivial trivial
  apply (mem_completionSet _ _ _).2
  rw [matching_shift_eq_inserted]
  apply hconn.mp
  have hold := (mem_completionSet a b π).1 hπ
  change (insertedGraph ⊥ a (fun i => b (normalizePartner π u w i))
    u ((normalizePartner π u w).symm (π u))).Preconnected
  rw [← matching_shift_eq_inserted, shiftPartner_original]
  exact hold

theorem lr_partner_exact (a b : α → V) (u w v : α)
    (hm : 2 ≤ Fintype.card α) (haw : a u = b w)
    (ha : ∀ i, a i = a u ↔ i = u) (hb : ∀ i, b i = b w ↔ i = w)
    (hv : v ≠ w) :
    (Fintype.card α - 1) * (partnerFiber (completionSet a b) u v).card =
      (completionSet a b).card :=
  partnerFiber_exact_of_shift (completionSet a b) u w v hv
    (lr_avoids_own_partner a b u w hm haw ha hb)
    (lr_shift_stable a b u w hm haw ha hb)

theorem matching_inverse (a b : α → V) (π : Equiv.Perm α) :
    matchingGraph ⊥ a (fun i => b (π i)) =
      matchingGraph ⊥ b (fun i => a (π.symm i)) := by
  ext x y
  simp only [matchingGraph, SimpleGraph.sup_adj, SimpleGraph.bot_adj, false_or,
    SimpleGraph.fromRel_adj]
  constructor
  · rintro ⟨hne, h | h⟩
    · obtain ⟨i, hx, hy⟩ := h
      exact ⟨hne, Or.inr ⟨π i, hy, by simpa using hx⟩⟩
    · obtain ⟨i, hy, hx⟩ := h
      exact ⟨hne, Or.inl ⟨π i, hx, by simpa using hy⟩⟩
  · rintro ⟨hne, h | h⟩
    · obtain ⟨i, hx, hy⟩ := h
      exact ⟨hne, Or.inr ⟨π.symm i, hy, by simpa using hx⟩⟩
    · obtain ⟨i, hy, hx⟩ := h
      exact ⟨hne, Or.inl ⟨π.symm i, hx, by simpa using hy⟩⟩

theorem completionSet_inverse_iff (a b : α → V) (π : Equiv.Perm α) :
    π.symm ∈ completionSet b a ↔ π ∈ completionSet a b := by
  simp only [mem_completionSet, matching_inverse a b π]

theorem completionSet_card_inverse (a b : α → V) :
    (completionSet a b).card = (completionSet b a).card := by
  refine Finset.card_bij' (s := completionSet a b) (t := completionSet b a)
    (fun π _ => π.symm) (fun π _ => π.symm) ?_ ?_ ?_ ?_
  · intro π hπ; exact (completionSet_inverse_iff a b π).2 hπ
  · intro π hπ; exact (completionSet_inverse_iff b a π).2 hπ
  · intro π _; simp
  · intro π _; simp

theorem partnerFiber_card_inverse (a b : α → V) (u v : α) :
    (partnerFiber (completionSet a b) u v).card =
      (partnerFiber (completionSet b a) v u).card := by
  refine Finset.card_bij' (s := partnerFiber (completionSet a b) u v)
    (t := partnerFiber (completionSet b a) v u)
    (fun π _ => π.symm) (fun π _ => π.symm) ?_ ?_ ?_ ?_
  · intro π hπ
    obtain ⟨hC, hp⟩ := (mem_partnerFiber _ _ _ _).1 hπ
    apply (mem_partnerFiber (completionSet b a) v u π.symm).2
    refine ⟨(completionSet_inverse_iff a b π).2 hC, ?_⟩
    rw [← hp, Equiv.symm_apply_apply]
  · intro π hπ
    obtain ⟨hC, hp⟩ := (mem_partnerFiber _ _ _ _).1 hπ
    apply (mem_partnerFiber (completionSet a b) u v π.symm).2
    refine ⟨(completionSet_inverse_iff b a π).2 hC, ?_⟩
    rw [← hp, Equiv.symm_apply_apply]
  · intro π _; simp
  · intro π _; simp

theorem rl_partner_exact (a b : α → V) (u w v : α)
    (hm : 2 ≤ Fintype.card α) (haw : a w = b v)
    (ha : ∀ i, a i = a w ↔ i = w) (hb : ∀ i, b i = b v ↔ i = v)
    (hu : u ≠ w) :
    (Fintype.card α - 1) * (partnerFiber (completionSet a b) u v).card =
      (completionSet a b).card := by
  have hh := lr_partner_exact b a v w u hm haw.symm hb ha hu
  rwa [← partnerFiber_card_inverse a b u v, ← completionSet_card_inverse a b] at hh

theorem rr_partner_equal (a b : α → V) (u v z : α)
    (hv : (Finset.univ.filter fun x => b x = b v).card = 2)
    (hz : (Finset.univ.filter fun x => b x = b z).card = 2)
    (ha : ∀ x, a x ≠ b v ∧ a x ≠ b z) :
    (partnerFiber (completionSet a b) u v).card =
      (partnerFiber (completionSet a b) u z).card := by
  obtain ⟨ρ, τ, hρ, hb, ha⟩ := right_pair_transport a b v z hv hz ha
  apply partnerFiber_card_eq_of_postcompose (completionSet a b) u v z ρ hρ
  intro π
  have hi := endpointMatchingIso a (fun i => b (π i)) a
    (fun i => b ((π.trans ρ) i)) τ ha (fun i => (hb (π i)).symm)
  simpa only [mem_completionSet] using hi.preconnected_iff.symm

theorem fiber_one_exists (f : α → V) (c : V)
    (hc : (Finset.univ.filter fun i => f i = c).card = 1) :
    ∃ w, f w = c ∧ ∀ i, f i = c ↔ i = w := by
  obtain ⟨w, hs⟩ := Finset.card_eq_one.mp hc
  have hw : w ∈ Finset.univ.filter fun i => f i = c := by rw [hs]; simp
  refine ⟨w, (Finset.mem_filter.mp hw).2, ?_⟩
  intro i
  have hi : (i ∈ Finset.univ.filter fun j => f j = c) ↔ i ∈ ({w} : Finset α) := by rw [hs]
  simpa using hi

theorem left_single_cap (a b : α → V)
    (hports : ∀ c, (Finset.univ.filter fun i => a i = c).card +
      (Finset.univ.filter fun i => b i = c).card = 2)
    (hm : 2 ≤ Fintype.card α) (u v : α)
    (hau : (Finset.univ.filter fun i => a i = a u).card = 1) :
    (Fintype.card α - 1) * (partnerFiber (completionSet a b) u v).card ≤
      (completionSet a b).card := by
  have hbu : (Finset.univ.filter fun i => b i = a u).card = 1 := by
    have := hports (a u)
    omega
  obtain ⟨w, hw, hbw⟩ := fiber_one_exists b (a u) hbu
  have ha := single_fiber_iff a u hau
  have hb : ∀ i, b i = b w ↔ i = w := by intro i; rw [hw]; exact hbw i
  by_cases hvw : v = w
  · subst v
    have hzero : (partnerFiber (completionSet a b) u w).card = 0 := by
      apply Finset.card_eq_zero.mpr
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro π hπ
      obtain ⟨hC, hp⟩ := (mem_partnerFiber _ _ _ _).1 hπ
      exact lr_avoids_own_partner a b u w hm hw.symm ha hb π hC hp
    simp [hzero]
  · exact (lr_partner_exact a b u w v hm hw.symm ha hb hvw).le

theorem right_single_exact (a b : α → V)
    (hports : ∀ c, (Finset.univ.filter fun i => a i = c).card +
      (Finset.univ.filter fun i => b i = c).card = 2)
    (hm : 2 ≤ Fintype.card α) (u v : α) (hnot : a u ≠ b v)
    (hbv : (Finset.univ.filter fun i => b i = b v).card = 1) :
    (Fintype.card α - 1) * (partnerFiber (completionSet a b) u v).card =
      (completionSet a b).card := by
  have hav : (Finset.univ.filter fun i => a i = b v).card = 1 := by
    have := hports (b v)
    omega
  obtain ⟨w, hw, haw⟩ := fiber_one_exists a (b v) hav
  have ha : ∀ i, a i = a w ↔ i = w := by intro i; rw [hw]; exact haw i
  have hb := single_fiber_iff b v hbv
  have huw : u ≠ w := by intro he; exact hnot ((congrArg a he).trans hw)
  exact rl_partner_exact a b u w v hm hw ha hb huw

theorem left_avoids_double_right (a b : α → V)
    (hports : ∀ c, (Finset.univ.filter fun i => a i = c).card +
      (Finset.univ.filter fun i => b i = c).card = 2)
    (v : α) (hbv : (Finset.univ.filter fun i => b i = b v).card = 2) (i : α) :
    a i ≠ b v := by
  have haz : (Finset.univ.filter fun j => a j = b v).card = 0 := by
    have := hports (b v)
    omega
  intro he
  have hp : 0 < (Finset.univ.filter fun j => a j = b v).card :=
    Finset.card_pos.mpr ⟨i, by simp [he]⟩
  omega

/-- Completion counting for a finite collection of fixed paths, represented by
their two endpoints. This is the static combinatorial core of equation (76). -/
theorem completionSet_partner_cap (a b : α → V)
    (hports : ∀ c, (Finset.univ.filter fun i => a i = c).card +
      (Finset.univ.filter fun i => b i = c).card = 2)
    (u v : α) :
    (Fintype.card α - 1) * (partnerFiber (completionSet a b) u v).card ≤
      (completionSet a b).card := by
  by_cases hm : 2 ≤ Fintype.card α
  · have hapos : 0 < (Finset.univ.filter fun i => a i = a u).card :=
      Finset.card_pos.mpr ⟨u, by simp⟩
    have hacases : (Finset.univ.filter fun i => a i = a u).card = 1 ∨
        (Finset.univ.filter fun i => a i = a u).card = 2 := by
      have := hports (a u)
      omega
    rcases hacases with haone | hatwo
    · exact left_single_cap a b hports hm u v haone
    have hbu : (Finset.univ.filter fun i => b i = a u).card = 0 := by
      have := hports (a u)
      omega
    have hnot (z : α) : a u ≠ b z := by
      intro he
      have hp : 0 < (Finset.univ.filter fun i => b i = a u).card :=
        Finset.card_pos.mpr ⟨z, by simp [he]⟩
      omega
    have hbcases (z : α) : (Finset.univ.filter fun i => b i = b z).card = 1 ∨
        (Finset.univ.filter fun i => b i = b z).card = 2 := by
      have hp : 0 < (Finset.univ.filter fun i => b i = b z).card :=
        Finset.card_pos.mpr ⟨z, by simp⟩
      have := hports (b z)
      omega
    rcases hbcases v with hvone | hvtwo
    · exact (right_single_exact a b hports hm u v (hnot v) hvone).le
    apply partnerFiber_cap_of_exact_or_equal
    intro z
    rcases hbcases z with hzone | hztwo
    · exact Or.inl (right_single_exact a b hports hm u z (hnot z) hzone)
    · apply Or.inr
      exact (rr_partner_equal a b u v z hvtwo hztwo
        (fun i => ⟨left_avoids_double_right a b hports v hvtwo i,
          left_avoids_double_right a b hports z hztwo i⟩)).symm
  · have hz : Fintype.card α - 1 = 0 := by omega
    simp [hz]

end SingleCycleCount
end
