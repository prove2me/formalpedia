/-- The slice context of the `B̃` axis. -/
structure CtxB (p s t α kb : ℕ) (st : IState HS) : Prop where
  t1 : ∃ L, st.G bT = .int (t : ℤ) :: L
  kb2 : ∃ L, st.G bKB = .int (kb : ℤ) :: L
  k3 : ∃ R, st.G bK3 = natInts (ptKeys s t) ++ R
  kS : ∃ R, st.G bKS = natInts (psKeys s t) ++ R
