--   theorem IntMul.Kappa.R6.Bit.progH_correct (C : QHNet R W T m) {q : ℕ} (hq : 1 ≤ q) (hm : 2 ≤ m)
--       (hOK : ∀ f, C.OK (q ^ f)) :
