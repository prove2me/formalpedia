variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem finPlace_uniformizerUnit : finPlace v (uniformizerUnit ℚ v) = AutomorphicForm.uniformizerIdele ℚ v :=
  rfl

private theorem ideleNorm_finPlace_uniformizerUnit :
    ideleNorm ℚ (finPlace v (uniformizerUnit ℚ v)) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ := by
  rw [finPlace_uniformizerUnit]
  exact ideleNorm_uniformizerIdele ℚ v

private theorem finitePartUnits_finPlace_apply_mem {w : (v.adicCompletion ℚ)ˣ}
    (hw : Valued.v (w : v.adicCompletion ℚ) ≤ 1) (w' : HeightOneSpectrum (𝓞 ℚ)) :
    ((finitePartUnits (𝓞 ℚ) ℚ (finPlace v w) : (FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) : FiniteAdeleRing (𝓞 ℚ) ℚ) w' ∈
      w'.adicCompletionIntegers ℚ := by
  rw [val_finitePartUnits]
  change ((localUnit (𝓞 ℚ) ℚ v w : (FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) : FiniteAdeleRing (𝓞 ℚ) ℚ) w' ∈
    w'.adicCompletionIntegers ℚ
  by_cases hw' : w' = v
  · rw [hw', localUnit_apply_self]
    exact (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hw
  · rw [localUnit_apply_of_ne (𝓞 ℚ) ℚ v _ hw']
    exact one_mem _

private theorem finitePartUnits_finPlace_mem_unitIdeles {w : (v.adicCompletion ℚ)ˣ}
    (hw : Valued.v (w : v.adicCompletion ℚ) = 1) :
    finitePartUnits (𝓞 ℚ) ℚ (finPlace v w) ∈ FiniteAdeleRing.unitIdeles (𝓞 ℚ) ℚ := by
  have hinv : Valued.v ((w⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = 1 := by
    rw [Units.val_inv_eq_inv_val, map_inv₀, hw, inv_one]
  rw [FiniteAdeleRing.mem_unitIdeles_iff]
  refine ⟨fun w' => finitePartUnits_finPlace_apply_mem v hw.le w', fun w' => ?_⟩
  rw [← map_inv, ← map_inv]
  exact finitePartUnits_finPlace_apply_mem v hinv.le w'

private theorem ideleNorm_finPlace_of_valued_eq_one {w : (v.adicCompletion ℚ)ˣ}
    (hw : Valued.v (w : v.adicCompletion ℚ) = 1) : ideleNorm ℚ (finPlace v w) = 1 :=
  ideleNorm_eq_one_of_fst_eq_one_of_finitePartUnits_mem_unitIdeles ℚ (finPlace v w) rfl
    (finitePartUnits_finPlace_mem_unitIdeles v hw)

private theorem ideleNorm_finPlace_of_valued_eq (t : (v.adicCompletion ℚ)ˣ) {m : ℤ}
    (ht : Valued.v (t : v.adicCompletion ℚ) = WithZero.exp (-m)) :
    ideleNorm ℚ (finPlace v t) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ m := by
  obtain ⟨w, hw, rfl⟩ := exists_valued_eq_one_and_eq_zpow_mul v t ht
  rw [map_mul, map_zpow, ideleNorm_mul, ideleNorm_zpow, ideleNorm_finPlace_uniformizerUnit,
    ideleNorm_finPlace_of_valued_eq_one v hw, mul_one]

private theorem ideleNorm_finPlace (t : (v.adicCompletion ℚ)ˣ) :
    ideleNorm ℚ (finPlace v t) = (TateLocal.modulus (t : v.adicCompletion ℚ) : ℝ) := by
  obtain ⟨m, hm⟩ := units_exists_valued_eq_exp_neg v t
  rw [ideleNorm_finPlace_of_valued_eq v t hm, modulus_eq_of_valued_eq v t m hm]

end
