-- title:
--   (48), proof of Lemma 5.1, p. 15 — the monotonicity inequality of A at x_{k+1} and a zero of A + B + C
-- statement:
--   Let $H$ be a real inner product space, $A:H\rightrightarrows H$ monotone, and $B,C:H\to H$ arbitrary maps. Let $\lambda>0$, let $J_{\lambda A}$ be the resolvent of $\lambda A$, and let $(x_k)_{k\ge -1}$ be generated by the three-operator scheme (47),
--   $$x_{k+1}=J_{\lambda A}\big(x_k-2\lambda B(x_k)+\lambda B(x_{k-1})-\lambda C(x_k)\big)\qquad\forall k\in\mathbb N.$$
--   Let $x\in(A+B+C)^{-1}(0)$, i.e. $-(B+C)(x)\in A(x)$. Then for every $k\in\mathbb N$,
--
--   $$\begin{aligned}0\le{}&\langle x_{k+1}-x_k,\,x-x_{k+1}\rangle+\lambda\langle B(x_k)-B(x),\,x-x_{k+1}\rangle\\&+\lambda\langle B(x_k)-B(x_{k-1}),\,x-x_k\rangle+\lambda\langle B(x_k)-B(x_{k-1}),\,x_k-x_{k+1}\rangle\\&+\lambda\langle C(x_k)-C(x),\,x-x_k\rangle+\lambda\langle C(x_k)-C(x),\,x_k-x_{k+1}\rangle.\end{aligned}$$
--
--   This is the starting inequality of the analysis of the scheme: each of the six terms is then estimated separately, using the monotonicity and Lipschitz continuity of $B$ and the cocoercivity of $C$, to obtain the energy inequality of Lemma 5.1.
--
--   **Formalization Note.** The resolvent is a hypothesis: `J : ℝ → H → H` with `IsResolventFamily A J`, i.e. $\gamma^{-1}(w-J_\gamma w)\in A(J_\gamma w)$ for every $\gamma>0$ and $w$. Indices are shifted by one: Lean's `x j` is $x_{j-1}$, so $x_{k+1},x_k,x_{k-1}$ are `x (k+2)`, `x (k+1)`, `x k`. The inequality uses only the monotonicity of $A$, so the statement assumes only that (no maximality, no Lipschitz or cocoercivity hypotheses on $B$ and $C$); it is therefore slightly more general than the paper's setting.
-- source:
--   Malitsky & Tam, A Forward-Backward Splitting Method for Monotone Inclusions Without Cocoercivity, arXiv:1808.04162v4, p. 15, (48) in the proof of Lemma 5.1

import Mathlib
import Definitions.Def_ThreeOpSplitting_Accel_MonotoneOperators
import Definitions.Def_FRBSplitting_ThreeOp_Setting
open InnerProductSpace ThreeOpSplitting.Accel

namespace FRBSplitting.ThreeOp

theorem eq_48 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H → Set H) (B C : H → H) (J : ℝ → H → H) (lam : ℝ)
    (hA : IsMonotoneOp A)
    (hJ : IsResolventFamily A J)
    (hlam0 : 0 < lam)
    (x : ℕ → H) (hrun : IsThreeOpRun J B C lam x)
    (xs : H) (hxs : xs ∈ FRBSplitting.Weak.zeroSet A (fun y => B y + C y)) :
    ∀ k : ℕ, 0 ≤ ⟪x (k + 2) - x (k + 1), xs - x (k + 2)⟫_ℝ
        + lam * ⟪B (x (k + 1)) - B xs, xs - x (k + 2)⟫_ℝ
        + lam * ⟪B (x (k + 1)) - B (x k), xs - x (k + 1)⟫_ℝ
        + lam * ⟪B (x (k + 1)) - B (x k), x (k + 1) - x (k + 2)⟫_ℝ
        + lam * ⟪C (x (k + 1)) - C xs, xs - x (k + 1)⟫_ℝ
        + lam * ⟪C (x (k + 1)) - C xs, x (k + 1) - x (k + 2)⟫_ℝ := by sorry

end FRBSplitting.ThreeOp
