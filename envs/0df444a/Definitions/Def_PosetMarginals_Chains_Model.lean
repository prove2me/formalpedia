-- title:
--   §2.1–§2.3 — maximal chains, conservation, problems (D) and (Q)
-- statement:
--   Let $P=(X,\preceq)$ be a finite poset. A **maximal chain** is a chain maximal under inclusion, and $\mathcal C$ is their family. Two maximal chains meeting at $x$ can be spliced by taking the first chain through $x$ and the second chain from $x$ upward. The parameter $\rho_x$ is an element marginal; $\pi_C$ is a target probability that a random subset meets $C$. Condition (2) bounds $\pi_C$ by $\sum_{x\in C}\rho_x$. Condition (3) requires $\pi_{C^1}+\pi_{C^2}=\pi_{C^2_1}+\pi_{C^1_2}$ at every common splice point.
--
--   Problem (D) asks for nonnegative weights $\sigma_S$ on **every** $S\subseteq X$, including $\varnothing$, such that
--   $$\sum_{S\ni x}\sigma_S=\rho_x,\qquad \sum_{S:S\cap C\ne\varnothing}\sigma_S\ge\pi_C,\qquad\sum_{S\subseteq X}\sigma_S=1.$$
--   With $\delta_C=\sum_{x\in C}\rho_x-\pi_C$, the auxiliary linear program (Q) minimizes $\sum_S\sigma_S$ subject to the same marginal equalities, nonnegativity, and
--   $$\sum_{S:|S\cap C|\ge2}\sigma_S(|S\cap C|-1)\le\delta_C\quad(C\in\mathcal C).$$
--   Its optimal value is $z^*_{\mathcal Q}$. The model also defines the chain-generated relation used in Lemma 2.
--
--   These shared definitions determine the meaning of the feasibility and optimality results in the mission.
--
--   **Formalization Note** The ground set is a finite type. Subsets are finite sets, and $\pi$ is represented as a total function on finite sets but is constrained or used only on maximal chains. The infimum defining $z^*_{\mathcal Q}$ has its intended meaning under the standing parameter assumptions used by the theorems. Cardinalities are cast to real numbers before subtracting $1$.
-- source:
--   Dahan, Amin & Jaillet, arXiv:1811.08516v3, pp. 5–11, §2.1–§2.3, eqs. (1)–(6)

import Mathlib

open Classical

namespace PosetMarginals.Chains

variable {α : Type*} [PartialOrder α] [Fintype α]

/-- The maximal chains of the finite poset. -/
noncomputable def maxChains (α : Type*) [PartialOrder α] [Fintype α] : Finset (Finset α) :=
  Finset.univ.filter (fun C : Finset α => IsMaxChain (· ≤ ·) (C : Set α))

/-- The first chain below the splice point, followed by the second chain above it. -/
noncomputable def splice (C1 C2 : Finset α) (x : α) : Finset α :=
  C1.filter (· ≤ x) ∪ C2.filter (x ≤ ·)

/-- Equation (2): the sum of element marginals on a maximal chain bounds its hitting target. -/
def Cond2 (ρ : α → ℝ) (π : Finset α → ℝ) : Prop :=
  ∀ C ∈ maxChains α, π C ≤ ∑ x ∈ C, ρ x

/-- Equation (3): conservation at every common point of two maximal chains. -/
def Cond3 (π : Finset α → ℝ) : Prop :=
  ∀ C1 ∈ maxChains α, ∀ C2 ∈ maxChains α, ∀ x ∈ C1 ∩ C2,
    π C1 + π C2 = π (splice C1 C2 x) + π (splice C2 C1 x)

/-- The standing parameter conditions from Section 2.2. -/
def Standing (ρ : α → ℝ) (π : Finset α → ℝ) : Prop :=
  (∀ x, 0 ≤ ρ x ∧ ρ x ≤ 1) ∧
  (∀ C ∈ maxChains α, π C ≤ 1) ∧ Cond2 ρ π ∧ Cond3 π

/-- Conditions (1a)–(1c), including nonnegativity on the empty subset. -/
def FeasibleD (ρ : α → ℝ) (π : Finset α → ℝ) (σ : Finset α → ℝ) : Prop :=
  (∀ S, 0 ≤ σ S) ∧
  (∀ x, ∑ S ∈ Finset.univ.filter (fun S : Finset α => x ∈ S), σ S = ρ x) ∧
  (∀ C ∈ maxChains α,
    π C ≤ ∑ S ∈ Finset.univ.filter (fun S : Finset α => (S ∩ C).Nonempty), σ S) ∧
  ∑ S, σ S = 1

/-- Feasibility of problem (D). -/
def ProblemD (ρ : α → ℝ) (π : Finset α → ℝ) : Prop :=
  ∃ σ, FeasibleD ρ π σ

/-- The slack δ_C of equation (4). -/
def delta (ρ : α → ℝ) (π : Finset α → ℝ) (C : Finset α) : ℝ :=
  ∑ x ∈ C, ρ x - π C

/-- Conditions (5)–(6) of the auxiliary linear program (Q). -/
def FeasibleQ (ρ : α → ℝ) (π : Finset α → ℝ) (σ : Finset α → ℝ) : Prop :=
  (∀ S, 0 ≤ σ S) ∧
  (∀ x, ∑ S ∈ Finset.univ.filter (fun S : Finset α => x ∈ S), σ S = ρ x) ∧
  (∀ C ∈ maxChains α,
    ∑ S ∈ Finset.univ.filter (fun S : Finset α => 2 ≤ (S ∩ C).card),
      σ S * (((S ∩ C).card : ℝ) - 1) ≤ delta ρ π C)

/-- The optimal value of (Q), as the infimum of its feasible objective values. -/
noncomputable def zQ (ρ : α → ℝ) (π : Finset α → ℝ) : ℝ :=
  sInf {v : ℝ | ∃ σ, FeasibleQ ρ π σ ∧ ∑ S, σ S = v}

/-- The finite maximum occurring in Theorem 2. -/
noncomputable def maxValue (ρ : α → ℝ) (π : Finset α → ℝ) : ℝ :=
  sSup (Set.range ρ ∪ π '' (maxChains α : Set (Finset α)))

/-- The relation generated by a family of maximal chains on a chosen subset. -/
def relGen (C' : Finset (Finset α)) (x y : α) : Prop :=
  x = y ∨ ∃ C ∈ C', x ∈ C ∧ y ∈ C ∧ x < y

/-- The generated relation is a partial order on the specified carrier. -/
def IsPosetOn (X' : Finset α) (C' : Finset (Finset α)) : Prop :=
  (∀ x ∈ X', relGen C' x x) ∧
  (∀ x ∈ X', ∀ y ∈ X', relGen C' x y → relGen C' y x → x = y) ∧
  (∀ x ∈ X', ∀ y ∈ X', ∀ z ∈ X',
    relGen C' x y → relGen C' y z → relGen C' x z)

/-- Closure of a chain family under both splices at points of `X'`. -/
def PreservesDecomp (X' : Finset α) (C' : Finset (Finset α)) : Prop :=
  ∀ C1 ∈ C', ∀ C2 ∈ C', ∀ x ∈ C1 ∩ C2 ∩ X',
    splice C1 C2 x ∈ C' ∧ splice C2 C1 x ∈ C'

/-- Maximal chain of the generated subposet, expressed by maximality among its finite chains. -/
def IsMaxChainOf (X' : Finset α) (C' : Finset (Finset α)) (C : Finset α) : Prop :=
  C ⊆ X' ∧ IsChain (relGen C') (C : Set α) ∧
  ∀ D : Finset α, D ⊆ X' → IsChain (relGen C') (D : Set α) → C ⊆ D → D = C

end PosetMarginals.Chains


