open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Compact
variable {I : Set ℝ} {s h x : ℝ}
variable {f m N w p a : ℝ → ℝ}
theorem solution (hP : PaperData I f m N w p a) (hN : FactorizedN I N s h) (hx : x ≠ 0)
    (hxI : s + x⁻¹ ∈ I) (Q J : ℝ) :
    (realPF h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      realPM h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      realPA h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      realPC h Q J (pull s f) (pullM s m) (pull s a) x = 0) ↔
    (paperFResidual f m N a Q (s + x⁻¹) = 0 ∧ paperMResidual f m N a Q J (s + x⁻¹) = 0 ∧
      eq24cResidual f m N a Q J (s + x⁻¹) = 0 ∧
      paperConstraintResidual f m N a Q J (s + x⁻¹) = 0) := by
  have hf : pull s f x ≠ 0 := hP.nf _ hxI
  have hb : pullM s m x ≠ 0 := mul_ne_zero hx (hP.nm _ hxI)
  have hu := u_chart_ne_zero hP hx hxI hN
  rw [realPF_eq hP hx hxI hN, realPM_eq hP hx hxI hN, realPA_eq hP hx hxI hN,
    realPC_eq hP hx hxI hN]
  have k1 : 3 * pull s f x * (1 - h * x) ^ 2 ≠ 0 := by positivity
  have k2 : 3 * x * pullM s m x * (1 - h * x) ^ 2 / pull s f x ≠ 0 := by positivity
  have k3 : (1 - h * x) ^ 2 ≠ 0 := by positivity
  have k4 : 4 * x * pullM s m x * pull s f x ^ 2 * (1 - h * x) ^ 2 ≠ 0 := by positivity
  simp only [mul_eq_zero, k1, k2, k3, k4, false_or]
