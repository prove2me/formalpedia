section
-- Source module: Solutions.J6SegILSrc22
/-!
# B-line IL, source-table producers, part 22: the set-up costs at `A = W = 4p`

With `u = uC (4p) DD`, `e = ePC (4p) p α`, `c = cU (4p + 1)` and the unit `U = u + e + c + 20000`,
every set-up / tear-down cost is `≤ Kb · X · U` with `X = t + NF d s + p + 1` (`costs_le`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (ctlCost)
open NLogN.KFUU (cU)

/-- The unit. -/
def Ut (p α : ℕ) : ℕ := uC (4 * p) DD + ePC (4 * p) p α + cU (4 * p + 1) + 20000

/-- The constant. -/
def Kb : ℕ := 10 ^ 6 + 100 * Kp

end J6Seg.Src

end

section
-- Source module: Solutions.J6SegILSrc23
/-!
# B-line IL, source-table producers, part 23: the four slab set-ups on plain parameters

With the parking registers `ParkOK dA Z Z1 Cm`, `ZOK Z`, `CmOK Cm`, and the numerical regime of an
axis (`pre · t · post = T`, `2T < 2^p`, `p + 1 ≤ Q ≤ 3p`, …), the procedures
`upF dA Z Z1 Cm body{1,3,5,7}` / `dn0 Cm`, `dn7 Cm` are `SetupS` pairs for the slab register
files at cost `B0 = (Kb + 10^4) (NF d s + p + t + 1) · Ut p α` (`pass1` … `pass7`), with `A = W = 4p`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (srcTab flatC ctlB ctlCost argO)
open J6Seg.PJ (rg RF RF_in RF_out ParV BV parBig cPar dsc)
open J6Seg.Ax (ρS sZ slabV SetupS)

/-- The common budget. -/
def B0 (p d s t α : ℕ) : ℕ := (Kb + 10000) * (NF d s + p + t + 1) * Ut p α

/-- The numerical regime of an axis. -/
structure Reg (k pre post s t p α d T : ℕ) : Prop where
  tot : pre * t * post = T
  pre1 : 1 ≤ pre
  post1 : 1 ≤ post
  hs : 0 < s
  hst : s < t
  h2T : 2 * T < 2 ^ p
  pQ : p + 1 ≤ segPF p d s
  Qp : segPF p d s ≤ 3 * p
  p0 : 18432 ≤ p
  dp : d ≤ p
  d1 : 1 ≤ d
  α1 : 1 ≤ α
  αp : α ≤ p
  kT : k ≤ T
  pT : p ≤ T
  dT : d ≤ T

end J6Seg.Src

end

section
-- Source module: Solutions.J6SegSlabCost1
/-!
# Slab set-up cost (the asymptotic half of `SlabNeed6`)

`slabCost6_all K`: eventually, on every axis,
`K · (NF d s + p + t + 1) · Ut p α + 2 ≤ cU6 P n 0 / (D + 1)`, where
`Ut p α = uC (4p) DD + ePC (4p) p α + cU (4p+1) + 20000` (inlined).
Everything is a polynomial in `X = p + t + 1` of degree `≤ 19`; we close with `budget_ev` (`e = 20`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

noncomputable section

namespace J6Seg.Side

open IntMul NLogN IntMul.Kappa.R6 J6Seg

/-- The `NF` constant. -/
def CN : ℕ := 1500 * 28 * 3 * 29 * 4

/-- The `fmB` constant. -/
def FB : ℕ := 2 * (8 * NLogN.fmA + 10 ^ 7 + 10 ^ 5)

/-- The constant of the unit bound. -/
def CUt : ℕ := 10 ^ 7 * 67 ^ 2 + 10 ^ 35 * 161 ^ 10 + 6 * 10 ^ 4 +
  FB * 13 ^ 6 + 20000

end J6Seg.Side
end

end

section
-- Source module: Solutions.J6SegILSrc24
/-!
# B-line IL, source-table producers, part 24: **`SlabNeed6 P`** (B1)

`slabNeed6 P hP : SlabNeed6 P` for every `P.Ok`. The family `USf dA` (8 procedures, uniform in the
table): `upF dA Z Z1 Cm body{1,3,5,7}` and `dn0 Cm` / `dn7 Cm`, with parking registers
`Z, Z1, Cm ∈ {49, 50, 51, 54} \ {dA}`. The procedure index map: `e1u = 0, e1d = 1, e3u = 2, …,
e7d = 7`. Constants: `Cs = 1`, `A = 0` (every set-up / tear-down costs `≤ B0 + 2 ≤ cU6 P n 0 / (D+1)`,
via `J6Seg.Side.slabCost6_all` with `K = Kb + 10000`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg IntMul.Kappa.R6 J6Seg.Side
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (argO)
open J6Seg.PJ (rg dsc)
open J6Seg.Ax (ρS sZ slabV SetupS Fam SlabNeed6 SlabFree slabV1 slabV3 slabV5 slabV7 ctl1 ctl3 ctl5 ctl7 AxReg)

/-- The parking registers. -/
def zOf (dA : Fin HS) : Fin HS := if dA = 49 then 54 else 49
def z1Of (dA : Fin HS) : Fin HS := if dA = 50 then 54 else 50
def cmOf (dA : Fin HS) : Fin HS := if dA = 51 then 54 else 51

/-- **The B1 family.** -/
def USf (dA : Fin HS) : Fam 8 := fun E _ =>
  ![upF dA (zOf dA) (z1Of dA) (cmOf dA) body1, (dn0 (cmOf dA)).code,
    upF dA (zOf dA) (z1Of dA) (cmOf dA) body3, (dn0 (cmOf dA)).code,
    upF dA (zOf dA) (z1Of dA) (cmOf dA) body5, (dn0 (cmOf dA)).code,
    upF dA (zOf dA) (z1Of dA) (cmOf dA) body7, (dn7 (cmOf dA)).code]

end J6Seg.Src
end

end

section
-- Source module: Solutions.J6SegILPreJK1
/-!
# B5 `J` side, part K1: the capacitance row, data part

For a row `a` of the capacitance matrix (block start `c = B.st a`, length `n = B.len a`):

* `tsT c u v k` — the `TsumI` summand; `miV a u = MinvI a (c + u)` as nested `fmul`s of table
  entries and the `tsT` sum (`miV_eq`);
* the expressions of the inner loop (`r1 = c`, `r2 = n`, `r3 = u`, `r4 = k`, `r7 = a`,
  `r26 = w`, `r24 = λ`): `tUE`, `tVE` (`tU`, `tV`), the reversed-list read indices `ixAE`, `ixGE`,
  the accumulation `tmE`; their values.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function Finset

section math
variable (P : ℕ) (T : Tables) (B : Blocks)

/-- The `TsumI` summand. -/
def tsT (c u v k : ℕ) : ℤ :=
  if max u v ≤ k then T.ap c (k - u) * fmul P (T.gam k) (T.am c (k - v)) else 0

/-- Entry `u` of the `M⁻¹` row of `a` inside its block. -/
def miV (a u : ℕ) : ℤ := MinvI P T B a (B.st a + u)

end math

namespace E

/-- `max x y`. -/
def mxE (x y : E) : E := .sel (.sub x y) y x
/-- `a - c`. -/
def uaE : E := .sub (.r 7) (.r 1)
/-- `max (a - c) u + 2w + 3 - n` (negative iff the far case of `TinvI`). -/
def kcE : E := .sub (.add (.add (mxE uaE (.r 3)) (.mul (.k 2) (.r 26))) (.k 3)) (.r 2)
/-- `tU`. -/
def tUE : E := .sel kcE (.sub (.sub (.r 2) (.k 1)) (.r 3)) uaE
/-- `tV`. -/
def tVE : E := .sel kcE (.sub (.sub (.r 2) (.k 1)) uaE) (.r 3)
/-- Read index of entry `k - t` of a reversed `n`-list (`0`-clamped). -/
def ixAE (tE : E) : E := .sub (.sub (.r 2) (.k 1)) (mx0E (.sub (.r 4) tE))
/-- Read index of entry `x` of a reversed `λ`-list. -/
def ixGE (x : E) : E := .sub (.sub (.r 24) (.k 1)) x
/-- `1` iff `max tU tV ≤ k`. -/
def geE : E := .sub (.k 1) (ltE (.r 4) (mxE tUE tVE))
/-- The accumulation step. -/
def tmE : E := .add (.r 8) (.mul geE (.mul (.r 5) (fmE (.r 12) (.r 11))))

end E

open E

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK2
/-!
# B5 `J` side, part K2: the `TsumI` inner loop

Stacks: `SAP = 38`, `SAM = 39` (the block's `a⁺`, `a⁻` lists, reversed), `SGM = 36` (`Γ`,
reversed, length `λ`). Body `PJ.tsB` (step `k` on `4`): read `a⁺_{k-tU}`, `a⁻_{k-tV}`, `Γ_k` and
add the `TsumI` summand to `8` (`Rn.tsB`); the loop `PJ.tsL = forL 51 2 4 PJ.tsB` sums it over
`k < n` (`Rn.tsL`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

abbrev SDI : Fin HS := 34
abbrev SDD : Fin HS := 35
abbrev SGM : Fin HS := 36
abbrev SGI : Fin HS := 37
abbrev SAP : Fin HS := 38
abbrev SAM : Fin HS := 39
abbrev SMI : Fin HS := 40

/-- The inner body. -/
def tsB : List Ins := [.rd SAP (ixAE tUE) 5, .rd SAM (ixAE tVE) 11, .rd SGM (ixGE (.r 4)) 12, .a 8 tmE]

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK3
/-!
# B5 `J` side, part K3: the `TsumI` loop and the `M⁻¹` row tail

* `PJ.tsL = forL 51 2 4 PJ.tsB`: `8 ← 8 + Σ_{k<n} tsT` (`Rn.tsL`);
* `PJ.miT`: from the sum on `8`, the entry `miV a u` of the `M⁻¹` row (tables `SGI = 37`,
  `SDD = 35`, `SDI = 34`, reversed, length `λ`), pushed on `SMI = 40` (`Rn.miT`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

def tsL : RS := forL 51 2 4 (progL tsB)

/-- Frame: registers outside `l` unchanged. -/
def Fxk (l : List (Fin HS)) (v u : Vr) : Prop := ∀ j, j ∉ l → u j = v j

/-- The tail: `M⁻¹` row entry from the `TsumI` sum on `8`, pushed on `SMI`. -/
def miT : List Ins :=
  [.rd SGI (ixGE tUE) 4, .rd SGI (ixGE tVE) 5, .a 8 (fmE (fmE (.r 4) (.r 5)) (fmE (.r 8) (.k 1))),
   .rd SDD (ixGE uaE) 4, .rd SDI (ixGE (.r 3)) 5, .a 8 (fmE (fmE (.r 4) (.r 5)) (.r 8)),
   .pu SMI (.r 8)]

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK4
/-!
# B5 `J` side, part K4: the capacitance row, slot values

For row `a` (block start `c` on `1`, length `n` on `2`) and slot `y < n (2w+1)` on `3`
(`u = y / (2w+1)`, `j = y % (2w+1)`): the body `PJ.vlB` reads `miV a u` from `SMI` (reversed),
computes the coupling entry with one `expNeg` call and pushes
`gV y = fmul (miV a u) (cpl (c+u) (j-w))` on `SV = 46` and the column tag
`gC y = if hcT then col else -1` on `SC = 13` (`Rn.vlB`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

abbrev SV : Fin HS := 46
abbrev SC : Fin HS := 13

section math
variable (P : ℕ) (T : Tables) (B : Blocks)

/-- Slot value. -/
def gV (a y : ℕ) : ℤ :=
  fmul P (miV P T B a (y / (2 * B.w + 1)))
    (T.cpl (B.st a + y / (2 * B.w + 1)) (((y % (2 * B.w + 1) : ℕ) : ℤ) - B.w))

/-- Slot column tag. -/
def gC (c y : ℕ) : ℤ :=
  if hcT B (c + y / (2 * B.w + 1)) (y % (2 * B.w + 1)) then
    (col B.s (c + y / (2 * B.w + 1)) (((y % (2 * B.w + 1) : ℕ) : ℤ) - B.w) : ℤ) else -1

end math

namespace E

def dWE : E := .add (.mul (.k 2) (.r 26)) (.k 1)
def uyE : E := .dv (.r 3) dWE
def jyE : E := .md (.r 3) dWE
def hhE : E := .sub jyE (.r 26)
def iyE : E := .add (.r 1) uyE
def ixSE : E := .sub (.sub (.r 2) (.k 1)) uyE
def kzE : E := .sub (.mul (.add (.mul (.r 23) hhE) (bOfE iyE)) (.add (.mul (.r 23) hhE) (bOfE iyE)))
  (.mul (bOfE (.add iyE hhE)) (bOfE (.add iyE hhE)))
def xE : E := .mul (.mul (.r 25) (.r 25)) (mx0E kzE)
def c1E : E := .sub (.k 1) (eqE jyE (.r 26))
def c2E : E := .mul (ltE (.k (-1)) (.add uyE hhE)) (ltE (.add uyE hhE) (.r 2))
def cdE : E := .mul c1E (.sub (.k 1) c2E)
def colE : E := .md (.add iyE hhE) (.r 22)
def scE : E := .sub (.mul cdE (.add colE (.k 1))) (.k 1)

end E

/-- The slot body. -/
def vlB : List Ins :=
  [.rd SMI ixSE 4, .a 5 (.mul (.r 22) (.r 22)), .a 8 xE, .en 8 20 5 8, .pu SV (fmE (.r 4) (.r 8)),
   .pu SC scE]

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK5
/-!
# B5 `J` side, part K5: the slot loop

`PJ.vlL = forL 50 11 3 PJ.vlB` (count `n (2w+1)` on `11`): pushes `gV y` on `SV` and `gC y` on `SC`
for all slots `y` (`Rn.vlL`); both stacks end reversed.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

def vlL : RS := forL 50 11 3 (progL vlB)

/-- The stacks after `k` slots. -/
def cfV (D : Cs) (f g : ℕ → ℤ) (k : ℕ) : Cs :=
  update (update D SV ((List.range k).map f).reverse) SC ((List.range k).map g).reverse

end J6Seg.PJ

end


