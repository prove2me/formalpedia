    (by omega))) (z _ (by omega) (by omega))).cast (v' := ((n + ℓ + 1 : ℕ) : ℤ))
    (by push_cast; ring) |>.pow2 (by omega)
  set v := gflat zs ++ l
  have S1 := NLogN.KFV.pushV s (o0 v) (i := yN) (by decide)
    (clean_gIn (RG.pow2 (RG.add (RG.add (RG.reg (by decide)) (RG.reg (by decide))) (RG.lit _)))) E
    (by simp +decide [o0, Function.update_apply])
  set F1 := Function.update (o0 v) yN [((2 ^ (n + ℓ + 1) : ℕ) : ℤ)]
  have S2 := NLogN.KFV.pushV s F1 (i := NLogN.KFV.yW) (v := 1) (B := B) (by decide) (fun r hr => by simp [Ex.regs] at hr)
    (EV.lit (z _ (by omega) (by omega))) (by simp +decide [F1, o0, Function.update_apply])
  set F2 := Function.update F1 NLogN.KFV.yW [1]
  have hC : Cl F2 := by
    refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
      simp +decide [F2, F1, o0, Function.update_apply]
  obtain ⟨R1, R2, R3⟩ := truncU_fsp s F2 zs xs l (r := 2 ^ ℓ) (p := p) (Δ := 0) (w := W)
    (by simpa using hx) (by simp +decide [F2, F1, o0, Function.update_apply, v]) hC hb B
    (by rw [hz]; exact zsz_nat_lt (by
      calc 2 * (2 ^ n * 2 ^ ℓ) = 2 ^ (n + ℓ + 1) := by ring
        _ < 2 ^ B := Nat.pow_lt_pow_right (by norm_num) (by omega)))
    (L1 := s.G yN) (L2 := s.G NLogN.KFV.yW)
    (by simp +decide [F2, F1, Function.update_apply, ints, hz]; ring)
    (by simp +decide [F2, F1, Function.update_apply, ints])
  set G := Function.update F2 0 (gflat (zs.map (gtr 0)) ++ l)
  have P1 := Sp.pop s G (i := NLogN.KFV.yW) (a := 1) (l := []) (B := B) (by decide)
    (by simp +decide [G, F2, Function.update_apply]) (z _ (by omega) (by omega))
  have P2 := Sp.pop s (Function.update G NLogN.KFV.yW []) (i := yN) (a := ((2 ^ (n + ℓ + 1) : ℕ) : ℤ))
    (l := []) (B := B) (by decide) (by simp +decide [G, F2, F1, Function.update_apply])
    (zsz_nat_lt (Nat.pow_lt_pow_right (by norm_num) (by omega)))
  have e : Function.update (Function.update G NLogN.KFV.yW []) yN [] = o0 (gflat (zs.map (gtr 0)) ++ l) := by
    funext j
    by_cases hj : j = 0
    · subst hj; simp +decide [G, F2, F1, o0, Function.update_apply]
    · simp only [G, F2, F1, o0, Function.update_apply, hj, if_false]
