    (h1 : v 1 = cN) (h12 : v 12 = u) :
    jME.eval (encK s (RF v c)) = ((aN ^ 2 * ((tN : ℤ) - 2 * bOf sN tN cN).toNat * u : ℕ) : ℤ) := by
  simp only [jME, Ex.eval, mx0_eval, bOE_eval h22 h23 h1, top_RF (show (23 : Fin HS) ∈ rg by decide),
