  have hper : ∀ A ∈ S, ((W.veluY {A} r s - s) ^ 2
        + W.a₁ * (W.veluX {A} r - r) * (W.veluY {A} r s - s))
      = (W.veluY {A} r s - s) ^ 2
        + W.a₁ * ((W.veluX {A} r - r) * (W.veluY {A} r s - s)) := fun A _ => by ring
  rw [Finset.sum_congr rfl hper, Finset.sum_add_distrib, ← Finset.mul_sum]
