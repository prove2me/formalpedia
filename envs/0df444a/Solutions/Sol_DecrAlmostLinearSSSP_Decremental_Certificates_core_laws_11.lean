section s379
set_option autoImplicit false
open scoped ENNReal NNReal
namespace DecrAlmostLinearSSSP.Decremental
lemma ReadoutCertificate.comparison (b : Core) (s : State b) (hs : ReadoutCertificate b s)
    (v : Fin b.input.n) (hv : v ≠ b.input.source) :
    ∃ z : ℝ, 0 ≤ z ∧ coreDistance b s.active v = ENNReal.ofReal z ∧
      0 ≤ s.sample v ∧ z ≤ (1+b.input.accuracy/2)*s.sample v ∧
      (1+b.input.accuracy/2)*s.sample v ≤ (1+b.input.accuracy)*z ∧
      (7/10 : ℝ)*z ≤ s.sample v ∧ s.sample v ≤ (9/8 : ℝ)*z := by
  obtain ⟨es,hw,hd⟩ := coreDistance_min b s.active v
  let z : ℝ := (es.map (fun e => cost b s.active (.inl e))).sum
  have hz : 0 ≤ z := List.sum_nonneg (by
    intro x hx; obtain ⟨e,_,rfl⟩ := List.mem_map.mp hx; exact (core_cost_bounds b s.active e).1)
  have hall := hs.targets
  have hp : 0 ≤ labels b s v := by
    have hp' := hall.1 (.inr ⟨v,hv⟩)
    have hsrc : labels b s b.input.source = 0 := by simp [labels,initialLabel]
    simp only [slack,cost,incidence,tail,head,hsrc,sub_zero,zero_add] at hp'
    exact (core_kappa_bounds b).1.le.trans hp'.le
  have hpz : labels b s v ≤ z := by
    have hh := (hall.2 v hv).1
    rw [hd] at hh
    exact (ENNReal.ofReal_le_ofReal_iff hz).mp hh
  have hzp : z ≤ (1+b.input.accuracy/4)*labels b s v := by
    have hh := (hall.2 v hv).2
    rw [hd] at hh
    exact (ENNReal.ofReal_le_ofReal_iff (mul_nonneg (by have he := b.valid.2.2.2.1;linarith) hp)).mp hh
  have hr := hs.samples v hv
  have ha := readout_error_arithmetic b.valid.2.2.2.1 b.valid.2.2.2.2.1 hp hpz hzp hr.1 hr.2
  exact ⟨z,hz,hd,ha⟩
end DecrAlmostLinearSSSP.Decremental
end s379
section s380
set_option autoImplicit false
open scoped ENNReal NNReal
namespace DecrAlmostLinearSSSP.Decremental
lemma ReadoutCertificate.reachable (b : Core) (s : State b) (hs : ReadoutCertificate b s)
    (v : Fin b.input.n) (hv : v ≠ b.input.source)
    (hr : Reachable b.input.graph s.active b.input.source v) :
    distance b.input.graph s.active (fun e => (b.input.weight e : ℝ≥0∞)) b.input.source v ≤ s.output v ∧
      s.output v ≤ ENNReal.ofReal (1+b.input.accuracy)*
        distance b.input.graph s.active (fun e => (b.input.weight e : ℝ≥0∞)) b.input.source v ∧
      s.output v ≠ ⊤ := by
  obtain ⟨d,hd,hdhi,hdinput,hdcore⟩ := coreDistance_reachable b s.active v hr
  obtain ⟨z,hz,hzcore,hrpos,hrlo,hrhi,hrzlo,hrzhi⟩ := ReadoutCertificate.comparison b s hs v hv
  have hz' : z = d / Q b := by
    have hh := hzcore.symm.trans hdcore
    exact le_antisymm ((ENNReal.ofReal_le_ofReal_iff (div_nonneg hd (core_Q_pos b).le)).mp hh.le)
      ((ENNReal.ofReal_le_ofReal_iff hz).mp hh.ge)
  have hQz : Q b*z = d := by rw [hz']; field_simp [(core_Q_pos b).ne']
  have hQr : Q b*s.sample v ≤ (9/8 : ℝ)*d := by
    have hh := mul_le_mul_of_nonneg_left hrzhi (core_Q_pos b).le
    nlinarith only [hh,hQz]
  have hfinite : ¬ Q b*s.sample v > H b/2 := by
    have hH := core_H_pos b
    dsimp [H] at hH ⊢
    nlinarith only [hQr,hdhi,hH]
  have hout : s.output v = ENNReal.ofReal ((1+b.input.accuracy/2)*Q b*s.sample v) := by
    rw [hs.output v,if_neg hv]
    exact if_neg hfinite
  have hlow : d ≤ (1+b.input.accuracy/2)*Q b*s.sample v := by
    have hh := mul_le_mul_of_nonneg_left hrlo (core_Q_pos b).le
    nlinarith only [hh,hQz]
  have hhigh : (1+b.input.accuracy/2)*Q b*s.sample v ≤ (1+b.input.accuracy)*d := by
    have hh := mul_le_mul_of_nonneg_left hrhi (core_Q_pos b).le
    rw [← hQz]
    nlinarith only [hh]
  rw [hdinput,hout]
  refine ⟨ENNReal.ofReal_le_ofReal hlow,?_,ENNReal.ofReal_ne_top⟩
  rw [← ENNReal.ofReal_mul (by have he := b.valid.2.2.2.1;linarith)]
  exact ENNReal.ofReal_le_ofReal hhigh
end DecrAlmostLinearSSSP.Decremental
end s380
section s381
set_option autoImplicit false
open scoped ENNReal NNReal
namespace DecrAlmostLinearSSSP.Decremental
lemma ReadoutCertificate.unreachable (b : Core) (s : State b) (hs : ReadoutCertificate b s)
    (v : Fin b.input.n) (hv : v ≠ b.input.source)
    (hr : ¬ Reachable b.input.graph s.active b.input.source v) : s.output v = ⊤ := by
  obtain ⟨z,hz,hzcore,hrpos,hrlo,hrhi,hrzlo,hrzhi⟩ := ReadoutCertificate.comparison b s hs v hv
  have hzlower : H b / Q b ≤ z := by
    have hh := coreDistance_unreachable b s.active v hr
    rw [hzcore] at hh
    exact (ENNReal.ofReal_le_ofReal_iff hz).mp hh
  have hQz : H b ≤ Q b*z := by
    have hh := (div_le_iff₀ (core_Q_pos b)).mp hzlower
    nlinarith only [hh]
  have hQr : (7/10 : ℝ)*H b ≤ Q b*s.sample v := by
    have hh := mul_le_mul_of_nonneg_left hrzlo (core_Q_pos b).le
    nlinarith only [hh,hQz]
  have htest : Q b*s.sample v > H b/2 := by
    nlinarith only [hQr,core_H_pos b]
  rw [hs.output v,if_neg hv]
  exact if_pos htest
end DecrAlmostLinearSSSP.Decremental
end s381
section s382
set_option autoImplicit false
open scoped ENNReal NNReal
namespace DecrAlmostLinearSSSP.Decremental
lemma ReadoutCertificate.correct (b : Core) (s : State b) (hs : ReadoutCertificate b s) :
    s.output b.input.source = 0 ∧ ∀ v,
      distance b.input.graph s.active (fun e => (b.input.weight e : ℝ≥0∞)) b.input.source v ≤ s.output v ∧
      s.output v ≤ ENNReal.ofReal (1+b.input.accuracy)*
        distance b.input.graph s.active (fun e => (b.input.weight e : ℝ≥0∞)) b.input.source v ∧
      (s.output v = ⊤ ↔ ¬ Reachable b.input.graph s.active b.input.source v) := by
  have hout0 : s.output b.input.source = 0 := by
    simp [hs.output]
  refine ⟨hout0,?_⟩
  intro v
  by_cases hv : v = b.input.source
  · subst v
    have hd := Exact.distance_self_zero b.input.graph s.active
      (fun e => (b.input.weight e : ℝ≥0∞)) b.input.source
    have hr : Reachable b.input.graph s.active b.input.source b.input.source := ⟨[],.nil _⟩
    simp [hd,hout0,hr]
  · by_cases hr : Reachable b.input.graph s.active b.input.source v
    · obtain ⟨hl,hu,hfinite⟩ := ReadoutCertificate.reachable b s hs v hv hr
      exact ⟨hl,hu,by simp [hfinite,hr]⟩
    · have hout := ReadoutCertificate.unreachable b s hs v hv hr
      have hd := distance_top_of_unreachable b.input.graph s.active
        (fun e => (b.input.weight e : ℝ≥0∞)) b.input.source v hr
      have hfactor : ENNReal.ofReal (1+b.input.accuracy) ≠ 0 := by
        exact (ENNReal.ofReal_pos.mpr (by have he := b.valid.2.2.2.1;linarith)).ne'
      simp [hout,hd,ENNReal.mul_top hfactor,hr]
end DecrAlmostLinearSSSP.Decremental
end s382
section s383
set_option autoImplicit false
open scoped ENNReal NNReal
namespace DecrAlmostLinearSSSP.Decremental.CoreHost
open Structured
lemma Image.certified (b : Core) (B : ℕ) (K : ℝ) (state : State b) (s : Data)
    (h : Image b B K state s) (hc : ReadoutCertificate b state) :
    stored s.machine b.input.source.val = 0 ∧
      (∀ v : Fin b.input.n, s.natMem v.val ≤ 1 ∧ (s.natMem v.val = 0 → 0 ≤ s.realMem v.val)) ∧
      ∀ v : Fin b.input.n,
        distance b.input.graph state.active (fun e => (b.input.weight e : ℝ≥0∞)) b.input.source v ≤ stored s.machine v.val ∧
        stored s.machine v.val ≤ ENNReal.ofReal (1+b.input.accuracy)*
          distance b.input.graph state.active (fun e => (b.input.weight e : ℝ≥0∞)) b.input.source v ∧
        (stored s.machine v.val = ⊤ ↔ ¬Reachable b.input.graph state.active b.input.source v) := by
  have hcorrect := hc.correct b state
  refine ⟨(h.answers b.input.source).trans hcorrect.1,h.normal,?_⟩
  intro v
  rw [h.answers v]
  exact hcorrect.2 v
end DecrAlmostLinearSSSP.Decremental.CoreHost
end s383
