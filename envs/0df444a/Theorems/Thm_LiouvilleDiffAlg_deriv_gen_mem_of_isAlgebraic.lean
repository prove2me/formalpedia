-- title:
--   Derivative of an algebraic generator lies in the extension
-- statement:
--   Let $G$ be a field of characteristic zero with a derivation $D$, let $F\subseteq G$ be a subfield, and let $K$ be an intermediate field $F\subseteq K\subseteq G$ with $D(K)\subseteq K$. Let $t\in G$ be algebraic over $K$. Then the derivative of $t$ lies in the field generated by $K$ and $t$:
--
--   $$Dt\in K(t).$$
--
--   Together with the logarithmic and exponential generators ($Dt=Ds/s$, respectively $Dt=t\,Ds$, with $s\in K$), this shows that every step of an elementary tower of intermediate fields of a differential field $G$ is closed under $D$, so the tower consists of differential subfields of $G$.
--
--   **Formalization Note** Only a derivation on $G$ is assumed; the base field $F$ carries no differential structure here. The field $K(t)$ is `IntermediateField.adjoin F (insert t K)`.
-- source:
--   Wikipedia, "Liouville's theorem (differential algebra)", revision oldid=1349223559, section "Basic theorem"; proof: Geddes–Czapor–Labahn, Algorithms for Computer Algebra (Kluwer, 1992), §12.4; Rosenlicht, Integration in finite terms, Amer. Math. Monthly 79 (1972), 963–972

import Mathlib
import Definitions.Def_LiouvilleDiffAlg_Basic
import Definitions.Def_LiouvilleDiffAlg_Form

open scoped Differential

namespace LiouvilleDiffAlg

theorem deriv_gen_mem_of_isAlgebraic {F G : Type*} [Field F] [Field G] [Differential G]
    [Algebra F G] [CharZero G] (K : IntermediateField F G) (hK : ∀ x ∈ K, x′ ∈ K)
    {t : G} (ht : IsAlgebraic K t) :
    t′ ∈ IntermediateField.adjoin F (insert t (K : Set G)) := by sorry

end LiouvilleDiffAlg
