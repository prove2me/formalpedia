open AlgebraicCurve ModularCurve

theorem AlgebraicCurve.pairHt_comm {F : Type} [Field F] [Algebra (AlgebraicClosure ℚ) F] {r : ℕ} (s : Fin r → F) (v w : Place (AlgebraicClosure ℚ) F) :
    pairHt s v w = pairHt s w v := by sorry
