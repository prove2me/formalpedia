variable {A : Type*} [CommRing A] [TopologicalSpace A] [IsTopologicalRing A] [T2Space A]

private def torusTranslate (g : GL (Fin 3) A) (a : Aˣ) : GL (Fin 3) A := iotaGL (diagUnitGL2 a) * g

private theorem coe_torusTranslate (g : GL (Fin 3) A) (a : Aˣ) :
    ((torusTranslate g a : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) =
      !![(a : A), 0, 0; 0, 1, 0; 0, 0, 1] * (g : Matrix (Fin 3) (Fin 3) A) := by
  rw [torusTranslate, Units.val_mul, coe_iotaGL, coe_diagUnitGL2]
  congr 1

private theorem coe_inv_torusTranslate (g : GL (Fin 3) A) (a : Aˣ) :
    (((torusTranslate g a)⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) =
      ((g⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) * !![((a⁻¹ : Aˣ) : A), 0, 0; 0, 1, 0; 0, 0, 1] := by
  rw [torusTranslate, _root_.mul_inv_rev, Units.val_mul, ← map_inv]
  have hinv : ((diagUnitGL2 a)⁻¹ : GL (Fin 2) A) = diagUnitGL2 a⁻¹ := Units.ext rfl
  rw [hinv, coe_iotaGL, coe_diagUnitGL2]
  congr 1

private theorem continuous_torusTranslate (g : GL (Fin 3) A) : Continuous (torusTranslate g) := by
  refine Units.continuous_iff.2 ⟨?_, ?_⟩
  · simp only [Function.comp_def, coe_torusTranslate]
    refine Continuous.mul ?_ continuous_const
    refine continuous_matrix fun i j => ?_
    fin_cases i <;> fin_cases j <;> first | exact Units.continuous_val | exact continuous_const
  · simp only [coe_inv_torusTranslate]
    refine Continuous.mul continuous_const ?_
    refine continuous_matrix fun i j => ?_
    fin_cases i <;> fin_cases j <;> first | exact Units.continuous_coe_inv | exact continuous_const

private def torusReadback (g : GL (Fin 3) A) (h : GL (Fin 3) A) : A × Aᵐᵒᵖ :=
  (((h : Matrix (Fin 3) (Fin 3) A) * ((g⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A)) 0 0,
    MulOpposite.op (((g : Matrix (Fin 3) (Fin 3) A) * ((h⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A)) 0 0))

private theorem continuous_torusReadback (g : GL (Fin 3) A) : Continuous (torusReadback g) :=
  ((Units.continuous_val.mul continuous_const).matrix_elem 0 0).prodMk
    (MulOpposite.continuous_op.comp ((continuous_const.mul Units.continuous_coe_inv).matrix_elem 0 0))

private theorem torusReadback_torusTranslate (g : GL (Fin 3) A) (a : Aˣ) :
    torusReadback g (torusTranslate g a) = Units.embedProduct A a := by
  have h1 : (g : Matrix (Fin 3) (Fin 3) A) * ((g⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) = 1 := by
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  rw [torusReadback, coe_torusTranslate, coe_inv_torusTranslate, Matrix.mul_assoc, h1, Matrix.mul_one,
    ← Matrix.mul_assoc, h1, Matrix.one_mul]
  ext <;> simp

private theorem isCompact_preimage_torusTranslate (g : GL (Fin 3) A) {K : Set (GL (Fin 3) A)} (hK : IsCompact K)
    (hKc : IsClosed K) : IsCompact (torusTranslate g ⁻¹' K) :=
  isCompact_preimage_of_comp_eq_embedProduct (continuous_torusTranslate g) (continuous_torusReadback g)
    (torusReadback_torusTranslate g) hK hKc

private def torusUnipotentTranslate (g : GL (Fin 3) A) (p : Aˣ × A) : GL (Fin 3) A :=
  iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 * g

private theorem coe_torusUnipotentTranslate (g : GL (Fin 3) A) (p : Aˣ × A) :
    ((torusUnipotentTranslate g p : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) =
      !![(p.1 : A), 0, 0; p.2, 1, 0; 0, 0, 1] * (g : Matrix (Fin 3) (Fin 3) A) := by
  rw [torusUnipotentTranslate, Units.val_mul, Units.val_mul, coe_iotaGL, coe_diagUnitGL2, lowerUnipotent21_coe]
  congr 1
  ext i j
  fin_cases i <;> fin_cases j <;> simp [embedMat2, Matrix.mul_apply, Fin.sum_univ_three]

private theorem coe_inv_torusUnipotentTranslate (g : GL (Fin 3) A) (p : Aˣ × A) :
    (((torusUnipotentTranslate g p)⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) =
      ((g⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) *
        !![((p.1⁻¹ : Aˣ) : A), 0, 0; -p.2 * ((p.1⁻¹ : Aˣ) : A), 1, 0; 0, 0, 1] := by
  rw [torusUnipotentTranslate, _root_.mul_inv_rev, _root_.mul_inv_rev, Units.val_mul, Units.val_mul, ← map_inv]
  have hinv : ((diagUnitGL2 p.1)⁻¹ : GL (Fin 2) A) = diagUnitGL2 p.1⁻¹ := Units.ext rfl
  have hu : (((lowerUnipotent21 p.2)⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) =
      !![1, 0, 0; -p.2, 1, 0; 0, 0, 1] := rfl
  rw [hinv, hu, coe_iotaGL, coe_diagUnitGL2]
  congr 1
  ext i j
  fin_cases i <;> fin_cases j <;> simp [embedMat2, Matrix.mul_apply, Fin.sum_univ_three]

private theorem continuous_torusUnipotentTranslate (g : GL (Fin 3) A) : Continuous (torusUnipotentTranslate g) := by
  refine Units.continuous_iff.2 ⟨?_, ?_⟩
  · simp only [Function.comp_def, coe_torusUnipotentTranslate]
    refine Continuous.mul ?_ continuous_const
    refine continuous_matrix fun i j => ?_
    fin_cases i <;> fin_cases j <;>
      first
        | exact Units.continuous_val.comp continuous_fst
        | exact continuous_snd
        | exact continuous_const
  · simp only [coe_inv_torusUnipotentTranslate]
    refine Continuous.mul continuous_const ?_
    refine continuous_matrix fun i j => ?_
    fin_cases i <;> fin_cases j <;>
      first
        | exact Units.continuous_coe_inv.comp continuous_fst
        | exact (continuous_snd.neg).mul (Units.continuous_coe_inv.comp continuous_fst)
        | exact continuous_const

private def torusUnipotentReadback (g : GL (Fin 3) A) (h : GL (Fin 3) A) : (A × Aᵐᵒᵖ) × A :=
  (torusReadback g h, ((h : Matrix (Fin 3) (Fin 3) A) * ((g⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A)) 1 0)

private theorem continuous_torusUnipotentReadback (g : GL (Fin 3) A) : Continuous (torusUnipotentReadback g) :=
  (continuous_torusReadback g).prodMk ((Units.continuous_val.mul continuous_const).matrix_elem 1 0)

private theorem torusUnipotentReadback_torusUnipotentTranslate (g : GL (Fin 3) A) (p : Aˣ × A) :
    torusUnipotentReadback g (torusUnipotentTranslate g p) = (Units.embedProduct A p.1, p.2) := by
  have h1 : (g : Matrix (Fin 3) (Fin 3) A) * ((g⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) = 1 := by
    rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
  rw [torusUnipotentReadback, torusReadback, coe_torusUnipotentTranslate, coe_inv_torusUnipotentTranslate,
    Matrix.mul_assoc, h1, Matrix.mul_one, ← Matrix.mul_assoc, h1, Matrix.one_mul]
  ext <;> simp

private theorem isCompact_preimage_torusUnipotentTranslate (g : GL (Fin 3) A) {K : Set (GL (Fin 3) A)}
    (hK : IsCompact K) (hKc : IsClosed K) : IsCompact (torusUnipotentTranslate g ⁻¹' K) :=
  isCompact_preimage_of_comp_eq_embedProduct_prod (continuous_torusUnipotentTranslate g)
    (continuous_torusUnipotentReadback g) (torusUnipotentReadback_torusUnipotentTranslate g) hK hKc

private theorem hasCompactSupport_comp_of_isCompact_preimage {Y : Type*} [TopologicalSpace Y]
    {W : GL (Fin 3) A → ℂ} (hWc : HasCompactSupport W) {τ : Y → GL (Fin 3) A}
    (hpre : ∀ {K : Set (GL (Fin 3) A)}, IsCompact K → IsClosed K → IsCompact (τ ⁻¹' K)) (hτ : Continuous τ) :
    HasCompactSupport fun y => W (τ y) := by
  refine HasCompactSupport.intro' (hpre hWc (isClosed_tsupport W)) ((isClosed_tsupport W).preimage hτ) ?_
  intro y hy
  by_contra hne
  exact hy (subset_tsupport W hne)

private theorem hasCompactSupport_torusTranslate
    {W : GL (Fin 3) A → ℂ} (hWc : HasCompactSupport W) (g : GL (Fin 3) A) :
    HasCompactSupport fun a : Aˣ => W (iotaGL (diagUnitGL2 a) * g) :=
  hasCompactSupport_comp_of_isCompact_preimage hWc (fun hK hKc => isCompact_preimage_torusTranslate g hK hKc)
    (continuous_torusTranslate g)

private theorem hasCompactSupport_torusUnipotentTranslate {W : GL (Fin 3) A → ℂ} (hWc : HasCompactSupport W)
    (g : GL (Fin 3) A) :
    HasCompactSupport fun p : Aˣ × A => W (iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 * g) :=
  hasCompactSupport_comp_of_isCompact_preimage hWc
    (fun hK hKc => isCompact_preimage_torusUnipotentTranslate g hK hKc) (continuous_torusUnipotentTranslate g)

private theorem transposeInv3_transposeInv3 (h : GL (Fin 3) A) : transposeInv3 (transposeInv3 h) = h :=
  Units.ext (Matrix.transpose_transpose _)

private theorem continuous_transposeInv3 : Continuous (transposeInv3 : GL (Fin 3) A → GL (Fin 3) A) := by
  refine Units.continuous_iff.2 ⟨?_, ?_⟩
  · exact Units.continuous_coe_inv.matrix_transpose
  · exact Units.continuous_val.matrix_transpose

private def dualHomeomorph : GL (Fin 3) A ≃ₜ GL (Fin 3) A where
  toFun h := longWeyl3 * transposeInv3 h
  invFun h := transposeInv3 (longWeyl3⁻¹ * h)
  left_inv h := by simp only [inv_mul_cancel_left, transposeInv3_transposeInv3]
  right_inv h := by simp only [transposeInv3_transposeInv3, mul_inv_cancel_left]
  continuous_toFun := by
    refine Units.continuous_iff.2 ⟨?_, ?_⟩
    · simp only [Function.comp_def, Units.val_mul]
      exact continuous_const.mul (Units.continuous_val.comp continuous_transposeInv3)
    · simp only [_root_.mul_inv_rev, Units.val_mul]
      exact (Units.continuous_coe_inv.comp continuous_transposeInv3).mul continuous_const
  continuous_invFun := continuous_transposeInv3.comp (continuous_const.mul continuous_id)

private theorem dualWhittakerFn3_eq_comp
    (W : GL (Fin 3) A → ℂ) : dualWhittakerFn3 W = W ∘ (dualHomeomorph (A := A)) := rfl

private theorem continuous_dualWhittakerFn3
    {W : GL (Fin 3) A → ℂ} (hW : Continuous W) : Continuous (dualWhittakerFn3 W) := by
  rw [dualWhittakerFn3_eq_comp]
  exact hW.comp dualHomeomorph.continuous

private theorem hasCompactSupport_dualWhittakerFn3 {W : GL (Fin 3) A → ℂ} (hWc : HasCompactSupport W) :
    HasCompactSupport (dualWhittakerFn3 W) :=
  hasCompactSupport_comp_of_isCompact_preimage hWc (fun hK _ => dualHomeomorph.isCompact_preimage.2 hK)
    dualHomeomorph.continuous

private theorem locallyCompactSpace_units [LocallyCompactSpace A] : LocallyCompactSpace Aˣ :=
  Units.isClosedEmbedding_embedProduct.locallyCompactSpace

private theorem continuous_charFactor {χ : Aˣ →* ℂˣ} (hχ : Continuous χ) : Continuous fun a : Aˣ => ((χ a : ℂˣ) : ℂ) :=
  Units.continuous_val.comp hχ

