-- Source module: Solutions.J6SegSlabCost1
/-!
# Slab set-up cost (the asymptotic half of `SlabNeed6`)

`slabCost6_all K`: eventually, on every axis,
`K · (NF d s + p + t + 1) · Ut p α + 2 ≤ cU6 P n 0 / (D + 1)`, where
`Ut p α = uC (4p) DD + ePC (4p) p α + cU (4p+1) + 20000` (inlined).
Everything is a polynomial in `X = p + t + 1` of degree `≤ 19`; we close with `budget_ev` (`e = 20`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

noncomputable section

namespace J6Seg.Side

open IntMul NLogN IntMul.Kappa.R6 J6Seg

/-- **The slab set-up cost**, `K`-parametric, with `Ut` inlined. -/
theorem slabCost6_all (P : Prm) (hP : P.Ok) (K : ℕ) :
    ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ k ≤ D,
      ((K * (NF (dP6 P n) (src k) + pP6 P n + tF6 P n k + 1) *
          (J6Seg.Src.uC (4 * pP6 P n) J6Seg.Src.DD + J6Seg.Src.ePC (4 * pP6 P n) (pP6 P n) (αN6 P n) +
            NLogN.KFUU.cU (4 * pP6 P n + 1) + 20000) : ℕ) : ℝ) + 2 ≤
        cU6 P n 0 / (D + 1) := by
  obtain ⟨n₁, hB⟩ := J6Seg.PJ.budget_ev P hP ((K * (CN + 1) * CUt + 2) * 3 ^ 19) 20
  obtain ⟨n₂, hb⟩ := eventually_b_ge 1
  refine ⟨max n₁ n₂, fun n hn src hs D hD k hk => ?_⟩
  have hb1 : 1 ≤ bP6 n := hb n (le_trans (le_max_right _ _) hn)
  have hdb : dP6 P n ≤ bP6 n := d_le_b P hP n
  have hbp : bP6 n ≤ pP6 P n := by
    show bP6 n ≤ 6 * b'P6 P n
    have : bP6 n ≤ bP6 n ^ (1 + P.x) := Nat.le_self_pow (by omega) _
    have e : b'P6 P n = bP6 n ^ (1 + P.x) := rfl
    omega
  have hp1 : 1 ≤ pP6 P n := le_trans hb1 hbp
  have ht1 : 1 ≤ tF6 P n k := by
    unfold tF6; split_ifs
    · have := Nat.one_le_two_pow (n := hN6 P n); omega
    · exact Nat.one_le_two_pow
  have hkd : k < dP6 P n := by omega
  have hst : src k ≤ tF6 P n k := by have := hs.hi k hkd; omega
  have hα : αN6 P n ^ 2 ≤ pP6 P n := by
    unfold αN6
    have h1 : Nat.sqrt (α2P6 P n) ^ 2 ≤ α2P6 P n := by
      exact Nat.sqrt_le' _
    have h2 : α2P6 P n ≤ pP6 P n := Nat.div_le_self _ _
    omega
  have hpoly := slab_poly (K := K) (α := αN6 P n) hp1 ht1 hb1 (hdb.trans hbp) hst hα
  have hbud := hB n (le_trans (le_max_left _ _) hn) src hs D hD k hk 0
  calc _ = ((K * (NF (dP6 P n) (src k) + pP6 P n + tF6 P n k + 1) *
          (J6Seg.Src.uC (4 * pP6 P n) J6Seg.Src.DD + J6Seg.Src.ePC (4 * pP6 P n) (pP6 P n) (αN6 P n) +
            NLogN.KFUU.cU (4 * pP6 P n + 1) + 20000) + 2 : ℕ) : ℝ) := by push_cast; ring
    _ ≤ _ := Nat.cast_le.2 hpoly
    _ ≤ _ := hbud

