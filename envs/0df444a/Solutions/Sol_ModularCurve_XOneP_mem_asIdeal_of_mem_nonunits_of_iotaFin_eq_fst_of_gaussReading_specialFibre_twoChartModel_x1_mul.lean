  have hξV : g.base ξ' ∈ U := by rw [hgξ]; exact hyU
  have hnu : ∀ (x₀ : ↥(ModularCurve.TwoChartModel A (↥K) j)) (hx₀ : x₀ ∈ U), x₀ = g.base ξ' →
      ¬ IsUnit ((ModularCurve.TwoChartModel A (↥K) j).presheaf.germ U x₀ hx₀ t) := by
    rintro x₀ hx₀ rfl hu
    have key := Scheme.Hom.germ_stalkMap_apply g U ξ' hx₀ t
    have hu' := hu.map (g.stalkMap ξ').hom
    rw [key] at hu'
    have : Mdl₁.C.presheaf.germ V ξ' hx₀ s = 0 := by rw [hs, map_zero]
    rw [this] at hu'
    exact not_isUnit_zero hu'
  have hnu₀ := hnu _ hyU hgξ.symm

  by_contra hay
  apply hnu₀
  rw [← Scheme.mem_basicOpen]
  show (ModularCurve.TwoChart.ιFin A (↥K) j).base y ∈ (ModularCurve.TwoChartModel A (↥K) j).basicOpen t
  rw [← Scheme.image_basicOpen]
  refine ⟨y, ?_, rfl⟩
  show y ∈ (ModularCurve.TwoChart.XFin A (↥K) j).basicOpen ((Scheme.ΓSpecIso (CommRingCat.of ↥(ModularCurve.TwoChart.chartAlgFin A (↥K) j))).inv a)
