-- title:
--   (2.13), (2.14), (3.1), (4.1), pp. 2711–2724 — solutions of the McKean–Vlasov FBSDE and the mean-field cost J
-- statement:
--   This module defines what a solution of the mean-field FBSDE of Carmona and Delarue is, and the limiting mean-field cost.
--
--   Let $(\Omega,\mathbb P)$ carry an $m$-dimensional Brownian motion $W$, with the filtration generated by $W$ and augmented by the $\mathbb P$-null sets. For a flow $\mu=(\mu_t)_{0\le t\le T}$ of measures on $\mathbb R^d$, a triple $(X,Y,Z)$ with $X,Y$ valued in $\mathbb R^d$ and $Z$ in $\mathbb R^{d\times m}$ solves (2.13) if
--   $$\begin{cases} dX_t = b(t,X_t,\mu_t,\hat\alpha(t,X_t,\mu_t,Y_t))\,dt + \sigma\,dW_t, & X_0 = x_0,\\ dY_t = -\partial_x H(t,X_t,\mu_t,Y_t,\hat\alpha(t,X_t,\mu_t,Y_t))\,dt + Z_t\,dW_t, & Y_T = \partial_x g(X_T,\mu_T),\end{cases}$$
--   $X$ and $Y$ have continuous paths, and the integrability (2.14) holds:
--   $$\mathbb E\Big[\sup_{0\le t\le T}(|X_t|^2+|Y_t|^2) + \int_0^T |Z_t|^2\,dt\Big] < +\infty.$$
--   The triple solves the McKean–Vlasov FBSDE (3.1) if it solves (2.13) for the flow of its own marginal laws, $\mu_t = \mathbb P_{X_t}$.
--
--   For a flow $\mu$ and processes $X, Y$, the mean-field cost (4.1) is
--   $$J = \mathbb E\Big[g(X_T,\mu_T) + \int_0^T f\big(t,X_t,\mu_t,\hat\alpha(t,X_t,\mu_t,Y_t)\big)\,dt\Big].$$
--
--   Equation (3.1) is the probabilistic characterization of the mean-field game equilibrium, and $J$ evaluated along its solution is the cost the $N$-player costs are compared to in §4.
--
--   **Formalization Note** The forward and backward equations use the published Itô-process and BSDE predicates of Peng (`Peng1990.SMP.SolvesSDE`, `SolvesBSDE`), whose backward form $Y_t = \xi + \int_t^T F\,ds - \sum_j\int_t^T Z^j\,dW^j$ is the integrated form of $dY_t = -F\,dt + Z_t dW_t$. States are Euclidean vectors converted to coordinates for those predicates; $Z$ is given by its $m$ columns and $|Z_t|^2$ is the sum of their squared norms. The filtration is the published augmented Brownian filtration (`ReflectedBSDE.Existence.augmentedFiltration`); the page says only "progressively measurable". Path continuity and (2.14) are part of the solution notion: the page never defines a solution of (3.1), and (2.14) is the class Theorem 2.2 works in. Time is $\mathbb R_{\ge0}$ and the time integral is over $[0,T]$. The integrals of nonnegative quantities are in $[0,\infty]$; $J$ is a real expectation. This module repeats, in `ProbMFG.Nash`, the solution notion of the series' first mission.
-- source:
--   Carmona and Delarue, Probabilistic analysis of mean-field games, SIAM J. Control Optim. 51 (2013), p. 2711, (2.13)–(2.14); p. 2712, (3.1); p. 2724, (4.1)

import Mathlib
import Definitions.Def_ProbMFG_Nash_Model
import Definitions.Def_Peng1990_SMP_Stochastic
import Definitions.Def_ReflectedBSDE_Existence_Setting

open MeasureTheory
open scoped NNReal ENNReal RealInnerProductSpace

namespace ProbMFG.Nash

variable {d m k : ℕ} {Ω : Type*} [MeasurableSpace Ω]

/-- The `j`-th column `σ e_j ∈ ℝ^d` of the volatility matrix, as a diffusion coefficient in Peng's
format (constant in time, randomness and state). -/
noncomputable def sigmaCols (M : Model d m k) :
    Fin m → ℝ≥0 → Ω → (Fin d → ℝ) → (Fin d → ℝ) :=
  fun j _ _ _ => (M.σ (EuclideanSpace.single j 1)).ofLp

/-- The flow of marginal laws `t ↦ ℙ_{X_t}` of a process `X`. -/
noncomputable def lawFlow (P : Measure Ω) (X : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d)) :
    ℝ≥0 → Measure (EuclideanSpace ℝ (Fin d)) :=
  fun t => P.map (X t)

/-- (2.13) with the integrability (2.14), for a given flow `μ = (μ_t)`, on `(Ω, P)` with the
`m`-dimensional Brownian motion `W` and its augmented natural filtration:
`dX_t = b(t, X_t, μ_t, α̂(t, X_t, μ_t, Y_t)) dt + σ dW_t`, `X₀ = x₀`;
`dY_t = −∂ₓH(t, X_t, μ_t, Y_t, α̂(t, X_t, μ_t, Y_t)) dt + Z_t dW_t`, `Y_T = ∂ₓg(X_T, μ_T)`;
`X` and `Y` have almost surely continuous paths on `[0, T]`, and
`𝔼[sup_{t ≤ T}(|X_t|² + |Y_t|²) + ∫₀ᵀ |Z_t|² dt] < ∞`.
`Z j` is the `j`-th column of `Z_t ∈ ℝ^{d×m}`; `|Z_t|² = Σⱼ |Z_t e_j|²`. -/
def SolvesFrozen (M : Model d m k) (P : Measure Ω) {W : ℝ≥0 → Ω → Fin m → ℝ}
    (hW : Peng1990.SMP.IsStdBrownian P W) (μ : ℝ≥0 → Measure (EuclideanSpace ℝ (Fin d)))
    (X Y : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d))
    (Z : Fin m → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d)) : Prop :=
  Peng1990.SMP.SolvesSDE (ReflectedBSDE.Existence.augmentedFiltration P hW) P M.T W M.x₀.ofLp
      (fun s ω x => (M.b s (WithLp.toLp 2 x) (μ s)
        (M.alphaHat s (WithLp.toLp 2 x) (μ s) (Y s ω))).ofLp)
      (sigmaCols M) (fun t ω => (X t ω).ofLp) ∧
  Peng1990.SMP.SolvesBSDE (ReflectedBSDE.Existence.augmentedFiltration P hW) P M.T W
      (fun ω => (M.dgx (X M.T ω) (μ M.T)).ofLp)
      (fun s ω y _ => (M.dxH s (X s ω) (μ s) (WithLp.toLp 2 y)
        (M.alphaHat s (X s ω) (μ s) (WithLp.toLp 2 y))).ofLp)
      (fun t ω => (Y t ω).ofLp) (fun j t ω => (Z j t ω).ofLp) ∧
  (∀ᵐ ω ∂P, ContinuousOn (fun t => X t ω) (Set.Iic M.T) ∧
    ContinuousOn (fun t => Y t ω) (Set.Iic M.T)) ∧
  (∫⁻ ω, (⨆ t ≤ M.T, (‖X t ω‖ₑ ^ 2 + ‖Y t ω‖ₑ ^ 2)) ∂P) +
    ∫⁻ ω, ∫⁻ s in Set.Icc (0 : ℝ) M.T, ∑ j, ‖Z j s.toNNReal ω‖ₑ ^ 2 ∂volume ∂P < ⊤

/-- (3.1): the McKean–Vlasov FBSDE, i.e. (2.13)–(2.14) with the flow `μ_t = ℙ_{X_t}` equal to the law
of the forward component itself. -/
def SolvesMKV (M : Model d m k) (P : Measure Ω) {W : ℝ≥0 → Ω → Fin m → ℝ}
    (hW : Peng1990.SMP.IsStdBrownian P W) (X Y : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d))
    (Z : Fin m → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d)) : Prop :=
  SolvesFrozen M P hW (lawFlow P X) X Y Z

/-- (4.1): the cost of the limiting mean-field problem along `(X, Y)` and the flow `μ`,
`J = 𝔼[g(X_T, μ_T) + ∫₀ᵀ f(t, X_t, μ_t, α̂(t, X_t, μ_t, Y_t)) dt]`. -/
noncomputable def Jmf (M : Model d m k) (P : Measure Ω)
    (μ : ℝ≥0 → Measure (EuclideanSpace ℝ (Fin d)))
    (X Y : ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d)) : ℝ :=
  ∫ ω, (M.g (X M.T ω) (μ M.T) +
    ∫ s in Set.Icc (0 : ℝ) M.T,
      M.f s.toNNReal (X s.toNNReal ω) (μ s.toNNReal)
        (M.alphaHat s.toNNReal (X s.toNNReal ω) (μ s.toNNReal) (Y s.toNNReal ω))) ∂P

end ProbMFG.Nash


