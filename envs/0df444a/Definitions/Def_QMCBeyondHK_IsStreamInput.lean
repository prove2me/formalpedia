-- status  : Definition
-- author  : @iris
-- created : 2026-11-06T06:35:21.580489+00:00
-- url     : https://prove2.me/theorems/cff1c65e-80bb-4adf-aa6b-54d12c591ae5
-- title:
--   Independent uniform input streams of the thinning framework, with and without the shift, and the filtration of the steps
-- statement:
--   Let $(\Omega, \mathbb P)$ be a probability space.
--
--   1. An **input stream** consists of random variables $x_t, y_t : \Omega \to \mathbb R^d$ and $\xi_t : \Omega \to \mathbb R$, $t \in \mathbb N$, all measurable and mutually independent, with $x_t, y_t \sim \mathrm{Unif}[0,1)^d$ and $\xi_t \sim \mathrm{Unif}[0,1)$.
--   2. A **shifted input stream** adds a measurable shift $s \sim \mathrm{Unif}[0,1)^d$, and requires $s$ and all the stream variables to be mutually independent.
--   3. $\mathcal F_t$ is the $\sigma$-algebra generated by $x_u, \xi_u, y_u$ for $u < t$: the randomness of the strategy in steps $0,\dots,t-1$.
--
--   These encode the paper's "i.i.d. uniform samples", the coins of the rejection steps, and the uniformly random shift.
--
--   **Formalization Note** Mutual independence is `iIndep` of the generated $\sigma$-algebras, indexed by $\mathbb N \sqcup \mathbb N \sqcup \mathbb N$ (and one more index for the shift). Any probability space carrying such variables is allowed; the canonical product space is one.
-- source:
--   Ezeunala, Jha, Jiang, Quasi-Monte Carlo Beyond Hardy–Krause II: (1 + ε)n Samples Suffice, arXiv:2609.10921 (sha256 bc273e88…), §2.1, p.7 (PDF p.9): x_t ∼ Unif[0,1)^d, ξ_t ∼ Unif[0,1), y_t ∼ Unif[0,1)^d; §3.1, p.9 (PDF p.11): s ∼ Unif[0,1)^d; §3.4.2, p.14 (PDF p.16): E_{t−1}

import Mathlib
import Definitions.Def_QMCBeyondHK_cube

set_option autoImplicit false

open MeasureTheory ProbabilityTheory

namespace QMCBeyondHK

/-- The σ-algebras generated by the individual inputs `x_t`, `ξ_t`, `y_t` of the thinning
framework, indexed by `ℕ ⊕ ℕ ⊕ ℕ` (`inl t ↦ x_t`, `inr (inl t) ↦ ξ_t`, `inr (inr t) ↦ y_t`)
(arXiv:2609.10921, sha256 bc273e88…, §2.1, p.7, PDF p.9). -/
def streamSigma {d : ℕ} {Ω : Type*} (X : ℕ → Ω → Fin d → ℝ) (Ξ : ℕ → Ω → ℝ)
    (Y : ℕ → Ω → Fin d → ℝ) : ℕ ⊕ ℕ ⊕ ℕ → MeasurableSpace Ω
  | Sum.inl t => MeasurableSpace.comap (X t) inferInstance
  | Sum.inr (Sum.inl t) => MeasurableSpace.comap (Ξ t) inferInstance
  | Sum.inr (Sum.inr t) => MeasurableSpace.comap (Y t) inferInstance

/-- The input stream of the thinning framework (arXiv:2609.10921, sha256 bc273e88…, §2.1, p.7,
PDF p.9): on a probability space `(Ω, P)`, the samples `x_t ∼ Unif[0,1)^d`, the coins
`ξ_t ∼ Unif[0,1)` and the fresh samples `y_t ∼ Unif[0,1)^d`, `t ∈ ℕ`, are measurable and mutually
independent.

**Formalization Note** Any probability space carrying such variables is allowed (the canonical
product space is one); the stream is unbounded and the algorithm reads what it needs. -/
structure IsStreamInput {d : ℕ} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (X : ℕ → Ω → Fin d → ℝ) (Ξ : ℕ → Ω → ℝ) (Y : ℕ → Ω → Fin d → ℝ) : Prop where
  measurable_X : ∀ t, Measurable (X t)
  measurable_Ξ : ∀ t, Measurable (Ξ t)
  measurable_Y : ∀ t, Measurable (Y t)
  law_X : ∀ t, P.map (X t) = unif d
  law_Ξ : ∀ t, P.map (Ξ t) = volume.restrict (Set.Ico (0 : ℝ) 1)
  law_Y : ∀ t, P.map (Y t) = unif d
  indep : iIndep (streamSigma X Ξ Y) P

/-- The σ-algebras of the shift `s` (index `none`) and of the stream inputs (index `some i`). -/
def shiftedStreamSigma {d : ℕ} {Ω : Type*} (s : Ω → Fin d → ℝ) (X : ℕ → Ω → Fin d → ℝ)
    (Ξ : ℕ → Ω → ℝ) (Y : ℕ → Ω → Fin d → ℝ) : Option (ℕ ⊕ ℕ ⊕ ℕ) → MeasurableSpace Ω
  | none => MeasurableSpace.comap s inferInstance
  | some i => streamSigma X Ξ Y i

/-- The randomness of the uniformly-shifted Haar-thinning algorithm (arXiv:2609.10921,
sha256 bc273e88…, §3.1, p.9, PDF p.11): a shift `s ∼ Unif[0,1)^d` and an input stream as in
`IsStreamInput`, all mutually independent. -/
structure IsShiftedStreamInput {d : ℕ} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (s : Ω → Fin d → ℝ) (X : ℕ → Ω → Fin d → ℝ) (Ξ : ℕ → Ω → ℝ) (Y : ℕ → Ω → Fin d → ℝ) :
    Prop where
  stream : IsStreamInput P X Ξ Y
  measurable_s : Measurable s
  law_s : P.map s = unif d
  indep : iIndep (shiftedStreamSigma s X Ξ Y) P

/-- The σ-algebra of the randomness of the strategy in steps `0, …, t − 1`, generated by
`x_u, ξ_u, y_u` for `u < t` (arXiv:2609.10921, sha256 bc273e88…, §3.4.2, p.14, PDF p.16: the
conditioning of `E_{t−1}`). -/
def stepSigma {d : ℕ} {Ω : Type*} (X : ℕ → Ω → Fin d → ℝ) (Ξ : ℕ → Ω → ℝ)
    (Y : ℕ → Ω → Fin d → ℝ) (t : ℕ) : MeasurableSpace Ω :=
  ⨆ u, ⨆ (_ : u < t), (MeasurableSpace.comap (X u) inferInstance ⊔
    MeasurableSpace.comap (Ξ u) inferInstance ⊔ MeasurableSpace.comap (Y u) inferInstance)

end QMCBeyondHK


