theorem passC_gen {pre t post L Ba cu Tt Bo a : ℕ} (hpre : 1 ≤ pre) (hpost : 1 ≤ post)
    (ht : 1 ≤ t) (ha : 1 ≤ a) (hL : L + 1 ≤ a * t) (hT : Tt ≤ a * (pre * t * post)) :
    Slab.passC pre L (2 * post) Ba cu Tt Bo ≤
      200000 * a * (pre * t * post) * (cu + Ba + Bo + 50) := by
  have h := Slab.passC_le pre L (2 * post) Ba cu Tt Bo
  generalize hV : pre * t * post = V at hT
  generalize hY : cu + Ba + Bo + 50 = Y
  have hX : cu + Ba + 1 ≤ Y := by omega
  have hBo : Bo + 43 ≤ Y := by omega
  have hY1 : 1 ≤ Y := by omega
  have hpreV : pre ≤ V := by
    rw [← hV]
    calc pre = pre * 1 * 1 := by ring
      _ ≤ pre * t * post := Nat.mul_le_mul (Nat.mul_le_mul_left _ ht) hpost
  have h1 : (L + 1) * ((2 * post + 1) * (cu + Ba + 1)) ≤ (a * t) * ((3 * post) * Y) :=
    Nat.mul_le_mul hL (Nat.mul_le_mul (by omega) hX)
  have h2 : (pre + 1) * (20000 * ((L + 1) * ((2 * post + 1) * (cu + Ba + 1))) + 3000) ≤
      (2 * pre) * (20000 * ((a * t) * ((3 * post) * Y)) + 3000 * Y) :=
    Nat.mul_le_mul (by omega) (Nat.add_le_add (Nat.mul_le_mul_left _ h1) (by nlinarith))
  have e2 : (2 * pre) * (20000 * ((a * t) * ((3 * post) * Y)) + 3000 * Y) =
      120000 * a * (pre * t * post) * Y + 6000 * pre * Y := by ring
  rw [hV] at e2
  have h3 : (Tt + 1) * (76 * Bo + 3200) ≤ (2 * a * V) * (76 * Y) := by
    have hV1 : 1 ≤ V := le_trans (by omega) hpreV
    have : Tt + 1 ≤ 2 * a * V := by nlinarith
    exact Nat.mul_le_mul this (by omega)
  have h4 : 6000 * pre * Y ≤ 6000 * a * V * Y := by
    have : pre ≤ a * V := le_trans hpreV (Nat.le_mul_of_pos_left _ ha)
    nlinarith
  calc Slab.passC pre L (2 * post) Ba cu Tt Bo
      ≤ (pre + 1) * (20000 * ((L + 1) * ((2 * post + 1) * (cu + Ba + 1))) + 3000) +
        (Tt + 1) * (76 * Bo + 3200) := by
        have e : 2 * post + 1 = (2 * post) + 1 := rfl
        exact h
    _ ≤ (120000 * a * V * Y + 6000 * pre * Y) + (2 * a * V) * (76 * Y) := by
        rw [← e2]; exact Nat.add_le_add h2 h3
    _ ≤ 120000 * a * V * Y + 6000 * a * V * Y + (2 * a * V) * (76 * Y) := by omega
    _ ≤ 200000 * a * V * Y := by nlinarith

/-- `moveCost m ≤ 41 (m + 1)`. -/
theorem moveCost_le (m : ℕ) : moveCost m ≤ 41 * (m + 1) := by unfold moveCost; omega

/-- **Passes 3 and 5** (`Bu = wd`, `n, n' ≤ 3t`). -/
theorem slabId_le {pre n n' t post wd : ℕ} (hpre : 1 ≤ pre) (hpost : 1 ≤ post) (ht : 1 ≤ t)
    (hn : n ≤ 3 * t) (hn' : n' ≤ 3 * t) :
    cSlabId pre n n' post wd ≤ 1400000 * (pre * t * post) * (1000 * (wd + 1)) := by
  unfold cSlabId
  have h := passC_gen (t := t) (a := 7) (L := n + n') (Tt := pre * (n' * (2 * post)))
    (Ba := 1) (Bo := wd)
    (cu := 2 * wd + 2 + (2 * moveCost wd + 19) + 300 * (wd + 1) + (2 * moveCost wd + 19))
    hpre hpost ht (by norm_num) (by omega) (by
        have : n' * (2 * post) ≤ 7 * (t * post) := by nlinarith
        calc pre * (n' * (2 * post)) ≤ pre * (7 * (t * post)) := Nat.mul_le_mul_left _ this
          _ = 7 * (pre * t * post) := by ring)
  have hm := moveCost_le wd
  refine h.trans ?_
  have : 2 * wd + 2 + (2 * moveCost wd + 19) + 300 * (wd + 1) + (2 * moveCost wd + 19) + 1 +
      wd + 50 ≤ 1000 * (wd + 1) := by omega
  calc 200000 * 7 * (pre * t * post) * _ ≤ 200000 * 7 * (pre * t * post) * (1000 * (wd + 1)) :=
        Nat.mul_le_mul_left _ this
    _ = _ := by ring

/-- `cFine` as a natural number. -/
theorem fineN (w f a y : ℕ) : cFine w f a y =
    (((w + 1) * (a * 2 ^ f * y + 1) * (f + 1) + (Nat.size (a * 2 ^ f * y) + w + f + 4) ^ 2 : ℕ) : ℝ) := by
  unfold cFine; push_cast; ring

