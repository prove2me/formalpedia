  intro j t A R LL LE LN LF E hA hjE hc hX hL hE hN hF
  have h := dif_runs (I := I) (iprog := fun _ => difBody pD) pD rfl n hn j (IState.pull f t) A R
    LL LE LN LF E hA hjE hc hX hL hE hN hF
  have h' := IRuns.ren hf (iprog' := iprog') (g := fun _ => pD)
    (fun _ => by rw [hP, difBody_ren_const]) h t
  rwa [IState.embed_upd hf, IState.embed_pull hf] at h'

