    a q (n0 / 2) q hq haq alpha beta theta A B
    halpha hbeta hA hB
  have hprog' : (∑ j ∈ Finset.range q, f (n0 + 2 * j)) ≤ C := by
    have hpredlt : q - 1 < q := Nat.sub_lt (by omega) (by omega)
    have hfactor : ((q - 1) / q + 1 : ℕ) = 1 := by
      rw [Nat.div_eq_of_lt hpredlt]
    rw [hfactor] at hprog
    norm_num at hprog
    convert hprog using 1
    apply Finset.sum_congr rfl
    intro j hj
    dsimp [f]
    have hnj : n0 + 2 * j = 2 * (n0 / 2 + j) + 1 := by omega
    rw [hnj]
    push_cast
    congr 1
  calc
    (∑ n ∈ s, f n) ≤ ∑ n ∈ pad, f n := by
      apply Finset.sum_le_sum_of_subset_of_nonneg hsub
      intro n hn hns
      exact safeCappedCosecant_nonneg hA hB
    _ = ∑ j ∈ Finset.range q, f (n0 + 2 * j) := hpad
    _ ≤ C := hprog'
