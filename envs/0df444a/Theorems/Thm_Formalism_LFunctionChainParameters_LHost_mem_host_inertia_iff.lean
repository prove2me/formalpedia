theorem Formalism.LFunctionChainParameters.LHost.mem_host_inertia_iff (p : ℕ) (x : E0 × HA e) :
    x ∈ (hostData e q d).inertia p ↔ ∃ u ∈ localUnits (hostN e q d) p, Multiplicative.toAdd (recMap e q d u) = x := by sorry
