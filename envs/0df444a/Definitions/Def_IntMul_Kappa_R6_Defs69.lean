namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

def distP (X : Fin HS) : List (Fin HS) → RS
  | [] => .skip
  | j :: l => .seq (.push j (.reg X)) (.seq (.pop X) (distP X l))

/-- `[a_i]` onto the `i`-th stack of `l`. -/
def putL : List (Fin HS) → List ℤ → Cs → Cs
  | j :: l, a :: as, f => putL l as (update f j [a])
  | _, _, f => f

/-- The cost of one move. -/
def cDist (B : ℕ) : ℕ := ((Ex.reg (S := HS) 0).size + 1) * 2000 * (B + 2) + (2 * B + 2)

end J6Seg.PJ

