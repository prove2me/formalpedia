-- title:
--   Galois symbols generate $H^n(F,\mathbb{Z}/2)$ for $n\le 1$
-- statement:
--   Let $F$ be a field of characteristic different from $2$, let $F^{\mathrm{sep}}$ be a separable closure and $G_F=\operatorname{Gal}(F^{\mathrm{sep}}/F)$ with its Krull topology, and let $H^n(F,\mathbb{Z}/2)$ be the continuous cohomology of $G_F$ with coefficients in the trivial module $\mathbb{Z}/2$. For $a\in F^\times$ let $\chi_a:G_F\to\mathbb{Z}/2$ be the Kummer character ($\chi_a(\sigma)=0$ iff $\sigma$ fixes a chosen square root of $a$). For $a=(a_1,\dots,a_n)\in(F^\times)^n$, the Galois symbol $\mathrm{gs}(a_1,\dots,a_n)\in H^n(F,\mathbb{Z}/2)$ is the cup product $\chi_{a_1}\cup\cdots\cup\chi_{a_n}$ (with $\mathrm{gs}()=1\in H^0$).
--
--   Then for $n\in\{0,1\}$ the Galois symbols generate the cohomology group:
--
--   $$\big\langle\, \mathrm{gs}(a_1,\dots,a_n) \;:\; a_1,\dots,a_n\in F^\times \,\big\rangle \;=\; H^n(F,\mathbb{Z}/2)\qquad (n\le 1).$$
--
--   For $n=0$ this says $H^0(F,\mathbb{Z}/2)\cong\mathbb{Z}/2$ is generated by the unit class. For $n=1$ it is the surjectivity half of Kummer theory: every continuous character $G_F\to\mathbb{Z}/2$ is a Kummer character $\chi_a$. This is the degree $\le 1$ case of the surjectivity part of the Milnor conjecture, i.e. the base case of Voevodsky's induction on the weight.
-- source:
--   V. Voevodsky, Motivic cohomology with Z/2-coefficients, Publ. Math. IHES 98 (2003), 59-104, https://doi.org/10.1007/s10240-003-0010-6: Corollary 7.5 in degrees n = 0, 1, which is also the conclusion of Corollary 6.10 (p. 91) for w = 1. Classical: degree 0 is trivial, degree 1 is Kummer theory, cf. J. Milnor, Algebraic K-theory and quadratic forms, Invent. Math. 9 (1970), 318-344, https://doi.org/10.1007/BF01425486.

import Mathlib
import Definitions.Def_MilnorConjecture_MilnorK
import Definitions.Def_MilnorConjecture_GaloisSymbol

namespace MilnorConjecture
theorem galoisSymbol_generate_of_le_one (F : Type) [Field F] [NeZero (2 : F)] (n : ℕ) (hn : n ≤ 1) :
    AddSubgroup.closure (Set.range (galoisSymbol (F := F) (n := n))) = ⊤ := by sorry
end MilnorConjecture
