  | .seq a b, h, s => by
    simp only [norep, Bool.and_eq_true] at h
    simp only [fcost, RS.cost, fcost_norep a h.1, fcost_norep b h.2]
  | .ite c a b, h, s => by
    simp only [norep, Bool.and_eq_true] at h
