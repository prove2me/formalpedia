theorem cost_sol {n₀ : ℕ} {lin : ℕ → ℕ} {calls : ℕ → List (ℕ × ℕ)} (K D : ℕ) (hD : 1 ≤ D)
    (hL : ∀ N, n₀ ≤ N → topCost n₀ N + lin N + 2 ≤ K * TT' N)
    (hR : ∀ N, n₀ ≤ N → D * ((calls N).map fun q => q.1 * TT' q.2).sum + TT' N ≤ D * TT' N)
    (N : ℕ) :
    let C := K * D + smallS n₀
    topCost n₀ N + (if N < n₀ then smallCost N else
        lin N + ((calls N).map fun q => q.1 * (C * TT' q.2)).sum) + 2 ≤ C * TT' N := by
