private theorem exists_uniform_coeff_bound_penta {N : ℕ} {a b c d e : Fin N → ℝ → ℂ}
    (h : ∀ i j, ∃ C, ∀ θ : ℝ, ‖iteratedDeriv j (a i) θ‖ ≤ C ∧ ‖iteratedDeriv j (b i) θ‖ ≤ C ∧
      ‖iteratedDeriv j (c i) θ‖ ≤ C ∧ ‖iteratedDeriv j (d i) θ‖ ≤ C ∧ ‖iteratedDeriv j (e i) θ‖ ≤ C)
    (n : ℕ) :
    ∃ Cc : ℝ, 0 ≤ Cc ∧ ∀ i,
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (a i) θ‖ ≤ Cc) ∧ (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (b i) θ‖ ≤ Cc) ∧
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (c i) θ‖ ≤ Cc) ∧ (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (d i) θ‖ ≤ Cc) ∧
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (e i) θ‖ ≤ Cc) := by
  choose C hC using h
  refine ⟨∑ i, ∑ j ∈ Finset.range (n + 1), max (C i j) 0, by positivity, fun i => ?_⟩
  have key : ∀ j, j ≤ n → max (C i j) 0 ≤ ∑ i, ∑ j ∈ Finset.range (n + 1), max (C i j) 0 := by
    intro j hj
    calc max (C i j) 0 ≤ ∑ j ∈ Finset.range (n + 1), max (C i j) 0 :=
          Finset.single_le_sum (f := fun j => max (C i j) 0) (fun _ _ => le_max_right _ _)
            (Finset.mem_range.2 (Nat.lt_succ_of_le hj))
      _ ≤ ∑ i, ∑ j ∈ Finset.range (n + 1), max (C i j) 0 :=
          Finset.single_le_sum (f := fun i => ∑ j ∈ Finset.range (n + 1), max (C i j) 0)
            (fun _ _ => Finset.sum_nonneg fun _ _ => le_max_right _ _) (Finset.mem_univ i)
  exact ⟨fun j hj θ => ((hC i j θ).1.trans (le_max_left _ _)).trans (key j hj),
    fun j hj θ => ((hC i j θ).2.1.trans (le_max_left _ _)).trans (key j hj),
    fun j hj θ => ((hC i j θ).2.2.1.trans (le_max_left _ _)).trans (key j hj),
    fun j hj θ => ((hC i j θ).2.2.2.1.trans (le_max_left _ _)).trans (key j hj),
    fun j hj θ => ((hC i j θ).2.2.2.2.trans (le_max_left _ _)).trans (key j hj)⟩

private theorem penta_bounds_mono {N : ℕ} {a b c d e : Fin N → ℝ → ℂ} {n : ℕ} {Cc Cc' : ℝ} (hCC : Cc ≤ Cc')
    (h : ∀ i,
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (a i) θ‖ ≤ Cc) ∧ (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (b i) θ‖ ≤ Cc) ∧
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (c i) θ‖ ≤ Cc) ∧ (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (d i) θ‖ ≤ Cc) ∧
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (e i) θ‖ ≤ Cc)) :
    ∀ i,
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (a i) θ‖ ≤ Cc') ∧ (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (b i) θ‖ ≤ Cc') ∧
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (c i) θ‖ ≤ Cc') ∧ (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (d i) θ‖ ≤ Cc') ∧
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (e i) θ‖ ≤ Cc') :=
  fun i => ⟨fun j hj θ => ((h i).1 j hj θ).trans hCC, fun j hj θ => ((h i).2.1 j hj θ).trans hCC,
    fun j hj θ => ((h i).2.2.1 j hj θ).trans hCC, fun j hj θ => ((h i).2.2.2.1 j hj θ).trans hCC,
    fun j hj θ => ((h i).2.2.2.2 j hj θ).trans hCC⟩

private theorem faaDatum_facts {g : Matrix (Fin 2) (Fin 2) ℂ} {n : ℕ} {H Arc : ℝ} (Psi : ℝ) (hH1 : 1 ≤ H)
    (hH : hatD g (n + 1) ≤ H) :
    1 ≤ n ! * max 1 Arc * max 1 Psi * (2 * H) ^ (6 * n + 2)
    ∧ (∀ Arc' : ℝ, Arc' ≤ Arc →
        n ! * max 1 Arc' * hatD g n ≤ n ! * max 1 Arc * max 1 Psi * (2 * H) ^ (6 * n + 2))
    ∧ Psi * hatD g n ^ (6 * n + 2) ≤ n ! * max 1 Arc * max 1 Psi * (2 * H) ^ (6 * n + 2)
    ∧ n ! * max 1 (muRatio g) ≤ n ! * max 1 Arc * max 1 Psi * (2 * H) ^ (6 * n + 2) := by
  have hfac : (1 : ℝ) ≤ n ! := Nat.one_le_cast.2 (Nat.factorial_pos n)
  have hfac0 : (0 : ℝ) ≤ n ! := zero_le_one.trans hfac
  have hA1 : (1 : ℝ) ≤ max 1 Arc := le_max_left _ _
  have hP1 : (1 : ℝ) ≤ max 1 Psi := le_max_left _ _
  have hDn : hatD g n ≤ H := (hatD_mono g (Nat.le_succ n)).trans hH
  have h2H : (1 : ℝ) ≤ 2 * H := by linarith
  have hpowself : 2 * H ≤ (2 * H) ^ (6 * n + 2) := le_self_pow₀ h2H (by omega : 6 * n + 2 ≠ 0)
  have hpow1 : (1 : ℝ) ≤ (2 * H) ^ (6 * n + 2) := h2H.trans hpowself
  have hpow0 : (0 : ℝ) ≤ (2 * H) ^ (6 * n + 2) := zero_le_one.trans hpow1
  have hfA : (1 : ℝ) ≤ n ! * max 1 Arc := one_le_mul_of_one_le_of_one_le hfac hA1
  have hfA0 : (0 : ℝ) ≤ n ! * max 1 Arc := zero_le_one.trans hfA
  have hfAP : (1 : ℝ) ≤ n ! * max 1 Arc * max 1 Psi := one_le_mul_of_one_le_of_one_le hfA hP1
  have hfAP0 : (0 : ℝ) ≤ n ! * max 1 Arc * max 1 Psi := zero_le_one.trans hfAP
  refine ⟨one_le_mul_of_one_le_of_one_le hfAP hpow1, ?_, ?_, ?_⟩
  · intro Arc' hArc'
    have hA' : max 1 Arc' ≤ max 1 Arc := max_le_max le_rfl hArc'
    have hD : hatD g n ≤ max 1 Psi * (2 * H) ^ (6 * n + 2) :=
      calc hatD g n ≤ 2 * H := by linarith
        _ ≤ (2 * H) ^ (6 * n + 2) := hpowself
        _ ≤ max 1 Psi * (2 * H) ^ (6 * n + 2) := le_mul_of_one_le_left hpow0 hP1
    calc n ! * max 1 Arc' * hatD g n ≤ n ! * max 1 Arc * (max 1 Psi * (2 * H) ^ (6 * n + 2)) :=
          mul_le_mul (mul_le_mul_of_nonneg_left hA' hfac0) hD (hatD_pos g n).le hfA0
      _ = n ! * max 1 Arc * max 1 Psi * (2 * H) ^ (6 * n + 2) := by ring
  · have hpow : hatD g n ^ (6 * n + 2) ≤ (2 * H) ^ (6 * n + 2) :=
      pow_le_pow_left₀ (hatD_pos g n).le (by linarith) _
    calc Psi * hatD g n ^ (6 * n + 2) ≤ max 1 Psi * (2 * H) ^ (6 * n + 2) :=
          mul_le_mul (le_max_right _ _) hpow (pow_nonneg (hatD_pos g n).le _) (zero_le_one.trans hP1)
      _ ≤ n ! * max 1 Arc * (max 1 Psi * (2 * H) ^ (6 * n + 2)) :=
          le_mul_of_one_le_left (mul_nonneg (zero_le_one.trans hP1) hpow0) hfA
      _ = n ! * max 1 Arc * max 1 Psi * (2 * H) ^ (6 * n + 2) := by ring
  · have hmu : max 1 (muRatio g) ≤ (2 * H) ^ (6 * n + 2) := by
      refine max_le hpow1 ?_
      calc muRatio g ≤ 2 * hatD g (n + 1) := muRatio_le_two_mul_hatD g (by omega : 1 ≤ n + 1)
        _ ≤ 2 * H := by linarith
        _ ≤ (2 * H) ^ (6 * n + 2) := hpowself
    calc n ! * max 1 (muRatio g) ≤ n ! * (2 * H) ^ (6 * n + 2) := mul_le_mul_of_nonneg_left hmu hfac0
      _ ≤ n ! * max 1 Arc * max 1 Psi * (2 * H) ^ (6 * n + 2) :=
          mul_le_mul_of_nonneg_right
            ((le_mul_of_one_le_right hfac0 hA1).trans (le_mul_of_one_le_right hfA0 hP1)) hpow0

private theorem contDiff_coeffWord {a b c d e : ℝ → ℂ} (ha : ContDiff ℝ ∞ a) (hb : ContDiff ℝ ∞ b)
    (hc : ContDiff ℝ ∞ c) (hd : ContDiff ℝ ∞ d) (he : ContDiff ℝ ∞ e) {μf ψf δf : ℝ → ℝ}
    (hμ : ContDiff ℝ ∞ μf) (hψ : ContDiff ℝ ∞ ψf) (hδ : ContDiff ℝ ∞ δf) :
    ContDiff ℝ ∞ fun t => a (μf t / 2) * b (ψf t / 2) * c (δf t) * d (ψf t / 2 + Real.pi / 2)
      * e (μf t / 2) := by
  have hμ2 : ContDiff ℝ ∞ fun t => μf t / 2 := hμ.div_const 2
  have hψ2 : ContDiff ℝ ∞ fun t => ψf t / 2 := hψ.div_const 2
  have hψ2' : ContDiff ℝ ∞ fun t => ψf t / 2 + Real.pi / 2 := hψ2.add contDiff_const
  have cA : ContDiff ℝ ∞ fun t => a (μf t / 2) := ha.comp hμ2
  have cB : ContDiff ℝ ∞ fun t => b (ψf t / 2) := hb.comp hψ2
  have cC : ContDiff ℝ ∞ fun t => c (δf t) := hc.comp hδ
  have cD : ContDiff ℝ ∞ fun t => d (ψf t / 2 + Real.pi / 2) := hd.comp hψ2'
  have cE : ContDiff ℝ ∞ fun t => e (μf t / 2) := he.comp hμ2
  exact (((cA.mul cB).mul cC).mul cD).mul cE

private theorem iteratedDeriv_sum_const_mul_zero {m : ℕ} (F₀ : Fin m → ℂ) (mf : Fin m → ℝ → ℂ)
    (hm : ∀ i, ContDiff ℝ ∞ (mf i)) (n : ℕ) :
    iteratedDeriv n (fun y => ∑ i, F₀ i * mf i y) 0 = ∑ i, F₀ i * iteratedDeriv n (mf i) 0 := by
  have h := M4aP3B.PlaceEstimate.iteratedDeriv_sum_const_mul_shift F₀ mf hm n 0 0
  simpa only [zero_add] using h

section PlaceRows

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsComplex)

variable {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}

private theorem contDiff_psiWC_line (hΨ : IsOneParamGroup (psiWC hw χ₁ χ₂)) {g : Matrix (Fin 2) (Fin 2) ℂ}
    (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) :
    ContDiff ℝ ∞ fun r : ℝ =>
      psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + r * Complex.exp (θ * Complex.I)))) := by
  have hcomp : (fun r : ℝ => psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + r * Complex.exp (θ * Complex.I)))))
      = psiWC hw χ₁ χ₂ ∘ fun r : ℝ => Real.log (radC g (z₀ + r * Complex.exp (θ * Complex.I))) := rfl
  rw [hcomp, log_radC_line_eq hg z₀ θ]
  exact hΨ.contDiff.comp (contDiff_const.add (contDiff_log_rad (det_lineMat_ne_zero hg z₀ θ)))

private def assemblyConst (n : ℕ) (Bχ κ H Fl Cc Dd : ℝ) : ℝ :=
  Bχ * (2 ^ n * ((n ! * (max 1 κ ^ n * (n ! * H) ^ n) * Fl)
    * (2 ^ (4 * n) * (n ! * Cc * Dd ^ n) ^ 5)))

private theorem assemblyConst_nonneg (n : ℕ) {Bχ κ H Fl Cc Dd : ℝ} (hB : 0 ≤ Bχ) (hH : 0 ≤ H) (hFl : 0 ≤ Fl)
    (hCc : 0 ≤ Cc) (hDd : 0 ≤ Dd) : 0 ≤ assemblyConst n Bχ κ H Fl Cc Dd := by
  unfold assemblyConst
  have h1 : (0 : ℝ) ≤ max 1 κ ^ n := pow_nonneg (zero_le_one.trans (le_max_left _ _)) n
  have h2 : (0 : ℝ) ≤ (n ! * H) ^ n := pow_nonneg (mul_nonneg (Nat.cast_nonneg _) hH) n
  have h3 : (0 : ℝ) ≤ (n ! * Cc * Dd ^ n) ^ 5 :=
    pow_nonneg (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hCc) (pow_nonneg hDd n)) 5
  exact mul_nonneg hB (mul_nonneg (pow_nonneg zero_le_two n) (mul_nonneg
    (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg h1 h2)) hFl)
    (mul_nonneg (pow_nonneg zero_le_two _) h3)))

private theorem core_at_zero (hΨ : IsOneParamGroup (psiWC hw χ₁ χ₂)) {g : Matrix (Fin 2) (Fin 2) ℂ}
    (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) (n : ℕ) {aw bw : ℝ} (haw : aw < 0) (hbw : 0 < bw)
    {slice K : ℝ → ℂ} {c₀ : ℂ}
    (hslice : ∀ u : ℝ, slice u
      = c₀ * psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + u * Complex.exp (θ * Complex.I)))) * K u)
    {ψ₀ : AdelicGL2 (𝓞 F) F → ℂ} {N : ℕ} {kv₀ : Fin N → AdelicGL2 (𝓞 F) F} {A B Cf D₀ E₀ : Fin N → ℝ → ℂ}
    (hsm : ∀ i, ContDiff ℝ ∞ (A i) ∧ ContDiff ℝ ∞ (B i) ∧ ContDiff ℝ ∞ (Cf i) ∧ ContDiff ℝ ∞ (D₀ i) ∧
      ContDiff ℝ ∞ (E₀ i))
    {Cc : ℝ}
    (hCc : ∀ i, (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (A i) θ‖ ≤ Cc) ∧
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (B i) θ‖ ≤ Cc) ∧ (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (Cf i) θ‖ ≤ Cc) ∧
      (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (D₀ i) θ‖ ≤ Cc) ∧ (∀ j ≤ n, ∀ θ : ℝ, ‖iteratedDeriv j (E₀ i) θ‖ ≤ Cc))
    (hpen : ∀ (α β γ δ ε : ℝ) (y : AdelicGL2 (𝓞 F) F),
      ψ₀ (y * dPhiW hw α * rhoCW hw β * dPhiW hw γ * rhoCW hw δ * dPhiW hw ε)
        = ∑ i, A i α * B i β * Cf i γ * D₀ i δ * E₀ i ε * ψ₀ (y * kv₀ i))
    {y₀ : AdelicGL2 (𝓞 F) F} {μf ψf δf : ℝ → ℝ} (hμ : ContDiff ℝ ∞ μf) (hψ : ContDiff ℝ ∞ ψf)
    (hδ : ContDiff ℝ ∞ δf)
    (hwin : ∀ u ∈ Set.Icc aw bw, K u
      = ψ₀ (y₀ * dPhiW hw (μf u / 2) * rhoCW hw (ψf u / 2) * dPhiW hw (δf u)
          * rhoCW hw (ψf u / 2 + Real.pi / 2) * dPhiW hw (μf u / 2)))
    {Dd : ℝ} (hDd1 : 1 ≤ Dd)
    (hμD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i μf 0‖ ≤ Dd ^ i)
    (hψD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i ψf 0‖ ≤ Dd ^ i)
    (hδD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i δf 0‖ ≤ Dd ^ i)
    {Bχ H Fl V : ℝ} (hc₀ : ‖c₀‖ ≤ Bχ) (hH : hatRatio g ≤ H)
    (hval : ‖psiWC hw χ₁ χ₂ (Real.log (radC g z₀))‖ ≤ Fl * V) :
    ‖iteratedDeriv n slice 0‖
      ≤ assemblyConst n Bχ ‖deriv (psiWC hw χ₁ χ₂) 0‖ H Fl Cc Dd * V * ∑ i, ‖ψ₀ (y₀ * kv₀ i)‖ := by

  obtain ⟨mf, hmf⟩ : ∃ mf : Fin N → ℝ → ℂ, mf = fun i (u : ℝ) =>
      psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + u * Complex.exp (θ * Complex.I))))
        * (A i (μf u / 2) * B i (ψf u / 2) * Cf i (δf u) * D₀ i (ψf u / 2 + Real.pi / 2) * E₀ i (μf u / 2)) :=
    ⟨_, rfl⟩
  obtain ⟨F₀, hF₀⟩ : ∃ F₀ : Fin N → ℂ, F₀ = fun i => c₀ * ψ₀ (y₀ * kv₀ i) := ⟨_, rfl⟩
  have hΨcd := contDiff_psiWC_line hw hΨ hg z₀ θ
  have hwcd : ∀ i, ContDiff ℝ ∞ fun u => A i (μf u / 2) * B i (ψf u / 2) * Cf i (δf u)
      * D₀ i (ψf u / 2 + Real.pi / 2) * E₀ i (μf u / 2) := fun i =>
    contDiff_coeffWord (hsm i).1 (hsm i).2.1 (hsm i).2.2.1 (hsm i).2.2.2.1 (hsm i).2.2.2.2 hμ hψ hδ
  have hmcd : ∀ i, ContDiff ℝ ∞ (mf i) := by
    intro i
    simp only [hmf]
    exact hΨcd.mul (hwcd i)

  have hev : slice =ᶠ[nhds (0 : ℝ)] fun u => ∑ i, F₀ i * mf i u := by
    filter_upwards [Icc_mem_nhds haw hbw] with u hu
    rw [hslice u, hwin u hu, hpen, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [hmf, hF₀]
    ring
  rw [hev.iteratedDeriv_eq n, iteratedDeriv_sum_const_mul_zero F₀ mf hmcd n]

  have hz : z₀ + ((0 : ℝ) : ℂ) * Complex.exp (θ * Complex.I) = z₀ := by simp
  have hK₁ : ∀ j ≤ n, ‖iteratedFDeriv ℝ j
      (fun u : ℝ => psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + u * Complex.exp (θ * Complex.I))))) 0‖
        ≤ n ! * (max 1 ‖deriv (psiWC hw χ₁ χ₂) 0‖ ^ n * (n ! * H) ^ n) * (Fl * V) := by
    intro j hj
    have h := norm_iteratedFDeriv_psiWC_line_le hw hΨ hg z₀ θ hj 0
    rw [hz] at h
    refine h.trans (mul_le_mul ?_ hval (norm_nonneg _) ?_)
    · refine mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left ?_ (pow_nonneg (zero_le_one.trans (le_max_left _ _)) n)) (Nat.cast_nonneg _)
      exact pow_le_pow_left₀ (mul_nonneg (Nat.cast_nonneg _) (hatRatio_nonneg g))
        (mul_le_mul_of_nonneg_left hH (Nat.cast_nonneg _)) n
    · have hH0 : 0 ≤ H := (hatRatio_nonneg g).trans hH
      exact mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (pow_nonneg (zero_le_one.trans (le_max_left _ _)) n)
        (pow_nonneg (mul_nonneg (Nat.cast_nonneg _) hH0) n))
  have hW : ∀ i, ∀ j ≤ n, ‖iteratedFDeriv ℝ j (fun u => A i (μf u / 2) * B i (ψf u / 2) * Cf i (δf u)
      * D₀ i (ψf u / 2 + Real.pi / 2) * E₀ i (μf u / 2)) 0‖ ≤ 2 ^ (4 * n) * (n ! * Cc * Dd ^ n) ^ 5 :=
    fun i j hj => norm_iteratedFDeriv_coeffWord_le (hsm i).1 (hsm i).2.1 (hsm i).2.2.1 (hsm i).2.2.2.1
      (hsm i).2.2.2.2 (hCc i).1 (hCc i).2.1 (hCc i).2.2.1 (hCc i).2.2.2.1 (hCc i).2.2.2.2 hμ hψ hδ hDd1
      hμD hψD hδD hj
  have hM : ∀ i, ‖iteratedDeriv n (mf i) 0‖
      ≤ 2 ^ n * ((n ! * (max 1 ‖deriv (psiWC hw χ₁ χ₂) 0‖ ^ n * (n ! * H) ^ n) * (Fl * V))
          * (2 ^ (4 * n) * (n ! * Cc * Dd ^ n) ^ 5)) := by
    intro i
    rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    simp only [hmf]
    exact norm_iteratedFDeriv_mul_zero_le hΨcd (hwcd i) hK₁ (hW i) le_rfl

  have hBχ0 : 0 ≤ Bχ := (norm_nonneg _).trans hc₀
  calc ‖∑ i, F₀ i * iteratedDeriv n (mf i) 0‖ ≤ ∑ i, ‖F₀ i * iteratedDeriv n (mf i) 0‖ := norm_sum_le _ _
    _ ≤ ∑ i, assemblyConst n Bχ ‖deriv (psiWC hw χ₁ χ₂) 0‖ H Fl Cc Dd * V * ‖ψ₀ (y₀ * kv₀ i)‖ := by
        refine Finset.sum_le_sum fun i _ => ?_
        rw [hF₀, norm_mul, norm_mul]
        calc ‖c₀‖ * ‖ψ₀ (y₀ * kv₀ i)‖ * ‖iteratedDeriv n (mf i) 0‖
            ≤ Bχ * ‖ψ₀ (y₀ * kv₀ i)‖
                * (2 ^ n * ((n ! * (max 1 ‖deriv (psiWC hw χ₁ χ₂) 0‖ ^ n * (n ! * H) ^ n) * (Fl * V))
                    * (2 ^ (4 * n) * (n ! * Cc * Dd ^ n) ^ 5))) :=
              mul_le_mul (mul_le_mul_of_nonneg_right hc₀ (norm_nonneg _)) (hM i) (norm_nonneg _)
                (mul_nonneg hBχ0 (norm_nonneg _))
          _ = assemblyConst n Bχ ‖deriv (psiWC hw χ₁ χ₂) 0‖ H Fl Cc Dd * V * ‖ψ₀ (y₀ * kv₀ i)‖ := by
              unfold assemblyConst
              ring
    _ = assemblyConst n Bχ ‖deriv (psiWC hw χ₁ χ₂) 0‖ H Fl Cc Dd * V * ∑ i, ‖ψ₀ (y₀ * kv₀ i)‖ := by
        rw [Finset.mul_sum]

end PlaceRows
