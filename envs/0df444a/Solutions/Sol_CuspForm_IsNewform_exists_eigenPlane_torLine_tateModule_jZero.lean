variable {K L : Type*} [Field K] [Field L] [Algebra K L]

theorem inv_mul_mem_inertiaSubgroupIn_of_isFrobeniusAt
    {A : ValuationSubring L} {σ σ' : L ≃ₐ[K] L} {q : ℕ}
    (h : A.IsFrobeniusAt σ q) (h' : A.IsFrobeniusAt σ' q) :
    σ⁻¹ * σ' ∈ A.inertiaSubgroupIn K := by
  obtain ⟨hσ, hx⟩ := h
  obtain ⟨hσ', hx'⟩ := h'
  have hmem : (⟨σ, hσ⟩⁻¹ * ⟨σ', hσ'⟩ : A.decompositionSubgroup K) ∈ A.inertiaSubgroup K := by
    rw [ValuationSubring.inertiaSubgroup, MonoidHom.mem_ker]
    ext x
    change ((⟨σ, hσ⟩⁻¹ * ⟨σ', hσ'⟩ : A.decompositionSubgroup K) • x) = x
    rw [mul_smul, hx', smul_pow']
    have h1 := hx ((⟨σ, hσ⟩ : A.decompositionSubgroup K)⁻¹ • x)
    rw [smul_inv_smul] at h1
    exact h1.symm
  show σ⁻¹ * σ' ∈ (A.inertiaSubgroup K).map (A.decompositionSubgroup K).subtype
  exact Subgroup.mem_map.mpr ⟨_, hmem, rfl⟩

theorem baseChange_apply_eq_of_inv_mul {R S M G : Type*} [CommSemiring R] [Semiring S]
    [Algebra R S] [AddCommMonoid M] [Module R M] [Group G]
    (ρ : G →* Module.End R M) {σ σ' : G} {v : TensorProduct R S M}
    (hfix : (ρ (σ⁻¹ * σ')).baseChange S v = v) :
    (ρ σ').baseChange S v = (ρ σ).baseChange S v := by
  conv_lhs => rw [← mul_inv_cancel_left σ σ']
  rw [map_mul, LinearMap.baseChange_mul, Module.End.mul_apply, hfix]

end Frob
