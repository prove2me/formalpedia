noncomputable section

namespace QAlgorithms.Papers.Independent.Intakethird100.P88

open Filter
open QAlgorithms.Papers.Independent.Dependency50.P13
open QAlgorithms.Papers.Independent.Dependency50.P39 (Fock fockKet fockDyad)
open QAlgorithms.Papers.Independent.Information100.P62 (logTwo)

attribute [local instance] Classical.propDecidable

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- PDF p.3: bounded self-adjoint operators on the entire Hilbert space. -/
abbrev BoundedSelfAdjoint (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] := {A : H →L[ℂ] H // A.adjoint = A}

/-- PDF pp.3–4: the weak topology on the positive trace-class cone, tested
against all bounded self-adjoint operators, rather than just compact ones. -/
def weakPositiveTopology {I : Type*} (b : HilbertBasis I ℂ H) :
    TopologicalSpace (PositiveTraceClass H) :=
  TopologicalSpace.induced
    (fun T : PositiveTraceClass H => fun A : BoundedSelfAdjoint H =>
      (operatorTrace b (T.val.val.comp A.val)).re) inferInstance

/-- PDF p.4: restriction of the accepted nuclear trace-norm topology to the cone. -/
def normPositiveTopology : TopologicalSpace (PositiveTraceClass H) :=
  TopologicalSpace.induced (fun T : PositiveTraceClass H => T.val) traceNormTopology

/-- PDF p.3: WOT on the self-adjoint positive cone is generated by all quadratic forms. -/
def weakOperatorPositiveTopology : TopologicalSpace (PositiveTraceClass H) :=
  TopologicalSpace.induced
    (fun T : PositiveTraceClass H => fun x : H => (inner ℂ x (T.val.val x)).re)
    inferInstance

/-- PDF pp.3–4: weak topology restricted to trace-one positive states. -/
def weakStateTopology {I : Type*} (b : HilbertBasis I ℂ H) : TopologicalSpace (State b) :=
  TopologicalSpace.induced
    (fun rho : State b => fun A : BoundedSelfAdjoint H =>
      (operatorTrace b (rho.val.val.comp A.val)).re) inferInstance

/-- PDF pp.3–4: WOT restricted to trace-one positive states. -/
def weakOperatorStateTopology {I : Type*} (b : HilbertBasis I ℂ H) :
    TopologicalSpace (State b) :=
  TopologicalSpace.induced
    (fun rho : State b => fun x : H => (inner ℂ x (rho.val.val x)).re) inferInstance

/-- PDF p.5: a single classical KL summand, extended on support failure.
No trace-correction term is added for an unnormalized second argument. -/
def measuredKLSummand (p q : ℝ) : EReal :=
  if p = 0 then 0 else if q = 0 then ⊤ else (p * (logTwo p - logTwo q) : ℝ)

/-- PDF pp.3,5: exactly finite-outcome POVMs of positive bounded effects. -/
def FinitePOVM {n : ℕ} (M : Fin n → H →L[ℂ] H) : Prop :=
  (∀ i, IsPositive (M i)) ∧ ∑ i, M i = 1

/-- PDF p.5, (10), extended to the positive trace-class second argument of
Lemma 20, p.11. EReal retains negative finite values when Tr sigma exceeds one.
The input rho is always a positive trace-one state. The accepted Bridge50.P11
measuredEntropy is a natural-log variational program on algebra functionals,
not this finite-POVM definition with an unnormalized trace-class reference.
Source correction: printed (10), p.5, repeats P_rho in both arguments.
Changed: the second distribution is P_sigma. Why: the surrounding two-state
definition and the explicit Tr(sigma E_x) calculation on pp.19-20 require it;
the literal printed expression would be identically zero on normalized rho. -/
def traceClassMeasuredEntropyBits {I : Type*} (b : HilbertBasis I ℂ H) (rho : State b)
    (sigma : PositiveTraceClass H) : EReal :=
  ⨆ n : ℕ, ⨆ M : {M : Fin n → H →L[ℂ] H // FinitePOVM M},
    ∑ i, measuredKLSummand
      (operatorTrace b (rho.val.val.comp (M.val i))).re
      (operatorTrace b (sigma.val.val.comp (M.val i))).re

/-- PDF pp.11,18: strict positivity means a positive quadratic form on every
nonzero vector, without a uniform spectral lower bound. The accepted
Dependency50.P37.StrictlyPositive is instead a predicate on CP maps. -/
def StrictlyPositiveQuadraticForm (L : H →L[ℂ] H) : Prop :=
  IsPositive L ∧ ∀ x : H, x ≠ 0 → 0 < (inner ℂ x (L x)).re

/-- PDF p.18: L has some positive lower spectral bound depending on L.
The proof explicitly uses L >= delta I. This is stronger than zero kernel. -/
def UniformlyPositive (L : H →L[ℂ] H) : Prop :=
  IsPositive L ∧ ∃ delta : ℝ, 0 < delta ∧
    ∀ x : H, delta * ‖x‖ ^ 2 ≤ (inner ℂ x (L x)).re

/-- PDF pp.11,18: the bounded positive exponential 2^h, via real continuous
functional calculus on the bounded spectrum of a self-adjoint h. -/
def twoPower (h : BoundedSelfAdjoint H) : H →L[ℂ] H :=
  cfc (fun x : ℝ => Real.rpow 2 x) h.val

/-- PDF pp.18–19: extended logarithmic expectation. The continuous bounded-below
spectral cutoffs log2(max(x,1/(n+1))) decrease to log2(x). The infimum is in
EReal, so nonintegrable negative logarithmic tails give minus infinity.
Only positive L and trace-one rho are used; this is not cfc Real.log at zero. -/
def logarithmicExpectation {I : Type*} (b : HilbertBasis I ℂ H) (rho : State b)
    (L : H →L[ℂ] H) : EReal :=
  ⨅ n : ℕ, ((operatorTrace b
    (rho.val.val.comp (cfc
      (fun x : ℝ => logTwo (max x ((n + 1 : ℝ)⁻¹))) L))).re : EReal)

/-- PDF p.11, (23)–(24): optimization over all bounded self-adjoint h.
The Bool selects the linear penalty (true) or logarithmic penalty (false).
The false branch is used only with sigma nonzero. -/
def exponentialProgram {I : Type*} (b : HilbertBasis I ℂ H) (rho : State b)
    (sigma : PositiveTraceClass H) (linear : Bool) : EReal :=
  ⨆ h : BoundedSelfAdjoint H,
    let t := (operatorTrace b (sigma.val.val.comp (twoPower h))).re
    (((operatorTrace b (rho.val.val.comp h.val)).re +
      if linear then (1 - t) / Real.log 2 else -logTwo t : ℝ) : EReal)

/-- PDF p.11, (25)–(28): optimization over bounded uniformly positive L
(uniform=true) or bounded strictly positive L (uniform=false), with either
penalty. The logarithmic penalty is used only with sigma nonzero. -/
def positiveProgram {I : Type*} (b : HilbertBasis I ℂ H) (rho : State b)
    (sigma : PositiveTraceClass H) (uniform linear : Bool) : EReal :=
  ⨆ L : {L : H →L[ℂ] H // if uniform then UniformlyPositive L else StrictlyPositiveQuadraticForm L},
    let t := (operatorTrace b (sigma.val.val.comp L.val)).re
    logarithmicExpectation b rho L.val +
      ((if linear then (1 - t) / Real.log 2 else -logTwo t : ℝ) : EReal)

/-- PDF p.20, Remark 32: the zero positive trace-class operator, explicitly
without a normalization or nonzero requirement. -/
def zeroPositive : PositiveTraceClass H :=
  ⟨⟨0, by
    unfold IsTraceClass NuclearRepresentation
    refine ⟨fun _ => 0, fun _ => 0, ?_, ?_⟩
    · simp
    · intro x
      simp⟩, by
    constructor
    · simp
    · intro x
      simp⟩

example : logTwo 1 = 0 := by simp [logTwo]

example (q : ℝ) : measuredKLSummand 0 q = 0 := by simp [measuredKLSummand]

example (p : ℝ) (hp : p ≠ 0) : measuredKLSummand p 0 = ⊤ := by
  simp [measuredKLSummand, hp]

example : measuredKLSummand 1 1 = 0 := by simp [measuredKLSummand, logTwo]

example : measuredKLSummand 1 2 = (-1 : EReal) := by
  have hlog : Real.log 2 ≠ 0 := Real.log_ne_zero_of_pos_of_ne_one (by norm_num) (by norm_num)
  simp [measuredKLSummand, logTwo, hlog]

example : IsPositive (0 : H →L[ℂ] H) := by
  constructor
  · simp
  · intro x
    simp

example : (zeroPositive (H := H)).val.val = 0 := rfl

example (x : H) : (inner ℂ x ((zeroPositive (H := H)).val.val x)).re = 0 := by simp [zeroPositive]

example (L : H →L[ℂ] H) (h : UniformlyPositive L) : IsPositive L := h.1

example (L : H →L[ℂ] H) (h : StrictlyPositiveQuadraticForm L) : IsPositive L := h.1

end QAlgorithms.Papers.Independent.Intakethird100.P88


