theorem FunctorialResolution.EmbeddedResolution.MarkedIdealWithBoundary.baseChange_boundary (T : MarkedIdealWithBoundary.{u}) (L : Type u) [Field L] (f : T.base →+* L) :
    (T.baseChange L f).boundary =
      T.boundary.map
        (fun D => D.comap (pullback.fst T.structMap (specMapOfFieldHom T.base L f))) := by sorry
