variable {n : ℕ}

/-! ### Inverse of a matrix family -/

section inverse

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem contDiffOn_det_of {s : Set E} {A : E → Matrix (Fin n) (Fin n) ℝ}
    (hA : ∀ a b, ContDiffOn ℝ ∞ (fun p => A p a b) s) : ContDiffOn ℝ ∞ (fun p => (A p).det) s := by
  simp only [Matrix.det_apply, Units.smul_def, zsmul_eq_mul]
  exact ContDiffOn.sum fun σ _ => contDiffOn_const.mul (contDiffOn_prod fun e _ => hA (σ e) e)

end inverse

