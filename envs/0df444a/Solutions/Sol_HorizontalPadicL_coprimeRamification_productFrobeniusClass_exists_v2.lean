/-- The canonical copy inside `MTT.Qbar` of the field generated by the
`n`-th roots of unity. -/
def cyclotomicFieldQbar (n : ℕ) : IntermediateField ℚ MTT.Qbar :=
  IntermediateField.adjoin ℚ
    {x : MTT.Qbar | ∃ d ∈ ({n} : Set ℕ), d ≠ 0 ∧ x ^ d = 1}

instance (n : ℕ) [NeZero n] :
    IsCyclotomicExtension {n} ℚ (cyclotomicFieldQbar n) := by
  apply IntermediateField.isCyclotomicExtension_adjoin_of_exists_isPrimitiveRoot
  intro d hd hd0
  rw [Set.mem_singleton_iff] at hd
  subst d
  exact HasEnoughRootsOfUnity.exists_primitiveRoot MTT.Qbar n

instance (n : ℕ) [NeZero n] : NumberField (cyclotomicFieldQbar n) :=
  IsCyclotomicExtension.numberField {n} ℚ _

instance (n : ℕ) [NeZero n] : IsGalois ℚ (cyclotomicFieldQbar n) :=
  IsCyclotomicExtension.isGalois {n} ℚ _

/-- Prime support bounds for two discriminants imply their coprimality when
the corresponding natural-number bounds are coprime. -/
theorem discr_isCoprime_of_prime_support
    (K₀ K₁ : Type*) [Field K₀] [NumberField K₀]
    [Field K₁] [NumberField K₁]
    (A B : ℕ) (hAB : Nat.Coprime A B)
    (h₀ : ∀ {l : ℕ}, l.Prime →
      (l : ℤ) ∣ NumberField.discr K₀ → l ∣ A)
    (h₁ : ∀ {l : ℕ}, l.Prime →
      (l : ℤ) ∣ NumberField.discr K₁ → l ∣ B) :
    IsCoprime (NumberField.discr K₀) (NumberField.discr K₁) := by
  rw [Int.isCoprime_iff_nat_coprime]
  apply Nat.coprime_of_dvd
  intro l hl hld0 hld1
  have hlA := h₀ hl (Int.natCast_dvd.mpr hld0)
  have hlB := h₁ hl (Int.natCast_dvd.mpr hld1)
  exact (hl.coprime_iff_not_dvd.mp (hAB.coprime_dvd_left hlA)) hlB

/-- A unit modulo the declared level gives a unit modulo the conductor with
the same character value. -/
theorem exists_conductorUnit_characterValue_eq
    (η : DirichletCharacterWithLevel)
    (a : (ZMod η.1.1)ˣ) :
    ∃ ac : (ZMod η.2.conductor)ˣ,
      η.2.primitiveCharacter ac = η.2 a := by
  letI : NeZero η.1.1 := ⟨Nat.ne_of_gt η.1.2⟩
  letI : NeZero η.2.conductor := ⟨η.2.conductor_ne_zero⟩
  let aval : ℕ := (a : ZMod η.1.1).val
  have hacopLevel : Nat.Coprime aval η.1.1 := by
    apply (ZMod.isUnit_iff_coprime aval η.1.1).mp
    rw [show (aval : ZMod η.1.1) = (a : ZMod η.1.1) by
      exact ZMod.natCast_zmod_val (a : ZMod η.1.1)]
    exact a.isUnit
  have hacopCond : Nat.Coprime aval η.2.conductor :=
    hacopLevel.coprime_dvd_right η.2.conductor_dvd_level
  let ac : (ZMod η.2.conductor)ˣ :=
    ZMod.unitOfCoprime aval hacopCond
  refine ⟨ac, ?_⟩
  have hacval : (ac : ZMod η.2.conductor) = aval := by
    simp [ac, ZMod.coe_unitOfCoprime]
  have haval : (a : ZMod η.1.1) = aval := by
    exact (ZMod.natCast_zmod_val (a : ZMod η.1.1)).symm
  change η.2.primitiveCharacter (ac : ZMod η.2.conductor) =
    η.2 (a : ZMod η.1.1)
  rw [hacval, haval]
  convert DirichletCharacter.primitiveCharacter_apply_of_isCoprime
    (χ := η.2) (a := (aval : ℤ))
    (Nat.isCoprime_iff_coprime.mpr hacopLevel) using 1 <;> norm_cast

/-- An arithmetic Frobenius restricts to an arithmetic Frobenius on a
normal intermediate number field. -/
theorem isArithFrobAt_restrictNormal
    (K L : Type*) [Field K] [NumberField K]
    [Field L] [NumberField L]
    [Algebra K L] [IsScalarTower ℚ K L] [Normal ℚ K]
    (σ : L ≃ₐ[ℚ] L) (Q : Ideal (𝓞 L))
    (hσ : IsArithFrobAt ℤ σ Q) :
    IsArithFrobAt ℤ (σ.restrictNormal K)
      (Q.comap (algebraMap (𝓞 K) (𝓞 L))) := by
  intro x
  change algebraMap (𝓞 K) (𝓞 L)
      ((σ.restrictNormal K) • x -
        x ^ Nat.card (ℤ ⧸
          (Q.comap (algebraMap (𝓞 K) (𝓞 L))).under ℤ)) ∈ Q
  rw [map_sub, map_pow]
  have hunder :
      (Q.comap (algebraMap (𝓞 K) (𝓞 L))).under ℤ = Q.under ℤ := by
    rw [← Ideal.under_under (A := ℤ) (B := 𝓞 K) (C := 𝓞 L)]
  rw [hunder]
  convert hσ (algebraMap (𝓞 K) (𝓞 L) x) using 1
  congr 1
  apply Subtype.ext
  exact AlgEquiv.restrictNormal_commutes σ K (x : K)

/-- At an unramified prime, the chosen Frobenius in a Galois extension
restricts to the chosen Frobenius in a normal subextension. -/
theorem restrictNormal_arithFrobAt_eq
    (K L : Type*) [Field K] [NumberField K]
    [Field L] [NumberField L]
    [Algebra K L] [IsScalarTower ℚ K L]
    [IsGalois ℚ K] [IsGalois ℚ L]
    (Q : Ideal (𝓞 L)) [Q.IsPrime] [Finite ((𝓞 L) ⧸ Q)]
    [(Q.comap (algebraMap (𝓞 K) (𝓞 L))).IsPrime]
    [Finite ((𝓞 K) ⧸ (Q.comap (algebraMap (𝓞 K) (𝓞 L))))]
    (hunr : (Q.comap (algebraMap (𝓞 K) (𝓞 L))).inertia
      (K ≃ₐ[ℚ] K) = ⊥) :
    (arithFrobAt ℤ (L ≃ₐ[ℚ] L) Q).restrictNormal K =
      arithFrobAt ℤ (K ≃ₐ[ℚ] K)
        (Q.comap (algebraMap (𝓞 K) (𝓞 L))) := by
  let q := Q.comap (algebraMap (𝓞 K) (𝓞 L))
  have htop := IsArithFrobAt.arithFrobAt ℤ (L ≃ₐ[ℚ] L) Q
  have h₁ : IsArithFrobAt ℤ
      ((arithFrobAt ℤ (L ≃ₐ[ℚ] L) Q).restrictNormal K) q :=
    isArithFrobAt_restrictNormal K L _ Q htop
  have h₂ : IsArithFrobAt ℤ
      (arithFrobAt ℤ (K ≃ₐ[ℚ] K) q) q :=
    IsArithFrobAt.arithFrobAt ℤ (K ≃ₐ[ℚ] K) q
  have hmem := h₁.mul_inv_mem_inertia h₂
  rw [hunr, Subgroup.mem_bot] at hmem
  exact mul_inv_eq_one.mp hmem

/-- Arithmetic Frobenius at `l` in an `n`-th cyclotomic field is the
class of `l` in `(ZMod n)ˣ`. -/
theorem cyclotomic_galEquivZMod_of_isArithFrobAt
    (n : ℕ) [NeZero n]
    (K : Type*) [Field K] [NumberField K]
    [IsCyclotomicExtension {n} ℚ K]
    {l : ℕ} (hl : l.Prime) (hn : Nat.Coprime l n)
    (Q : Ideal (𝓞 K))
    (hQover : Q.LiesOver (ratPrimeIdeal l))
    (σ : K ≃ₐ[ℚ] K) (hσ : IsArithFrobAt ℤ σ Q) :
    IsCyclotomicExtension.Rat.galEquivZMod n K σ =
      ZMod.unitOfCoprime l hn := by
  let ζ := IsCyclotomicExtension.zeta n ℚ K
  have hζ := IsCyclotomicExtension.zeta_spec n ℚ K
  have hnQ : (n : 𝓞 K) ∉ Q := by
    intro hnmem
    have hnunder : (n : ℤ) ∈ Q.under ℤ := by
      change algebraMap ℤ (𝓞 K) (n : ℤ) ∈ Q
      simpa using hnmem
    rw [← hQover.over] at hnunder
    have hldvd : l ∣ n := by
      rw [ratPrimeIdeal, Ideal.mem_span_singleton] at hnunder
      exact_mod_cast hnunder
    exact (hl.coprime_iff_not_dvd.mp hn) hldvd
  have hpow := hσ.apply_of_pow_eq_one
    hζ.toInteger_isPrimitiveRoot.pow_eq_one hnQ
  rw [← hQover.over, Int.card_ideal_quot] at hpow
  have hgal := IsCyclotomicExtension.Rat.galEquivZMod_smul_of_pow_eq
    n K σ hζ.toInteger_isPrimitiveRoot.pow_eq_one
  change σ • hζ.toInteger = hζ.toInteger ^ l at hpow
  rw [hgal] at hpow
  rw [(hζ.toInteger_isPrimitiveRoot.isOfFinOrder (NeZero.ne _)).pow_inj_mod,
    ← hζ.toInteger_isPrimitiveRoot.eq_orderOf,
    ← ZMod.natCast_eq_natCast_iff'] at hpow
  apply Units.ext
  simpa [ZMod.coe_unitOfCoprime] using hpow

/-- Automorphisms of a field algebra-equivalent to a cyclotomic field
commute.  This lets us remove conjugacy after restricting a Chebotarev
class to the seed cyclotomic factor. -/
theorem algAut_commute_of_cyclotomic_equiv
    (n : ℕ) [NeZero n]
    (K L : Type*) [Field K] [Field L]
    [Algebra ℚ K] [Algebra ℚ L]
    [IsCyclotomicExtension {n} ℚ K]
    (e : K ≃ₐ[ℚ] L) (σ τ : L ≃ₐ[ℚ] L) :
    Commute σ τ := by
  let σK : K ≃ₐ[ℚ] K := e.trans (σ.trans e.symm)
  let τK : K ≃ₐ[ℚ] K := e.trans (τ.trans e.symm)
  have hK : Commute σK τK := by
    letI := IsCyclotomicExtension.isMulCommutative {n} ℚ K
    exact Std.Commutative.comm σK τK
  apply AlgEquiv.ext
  intro x
  obtain ⟨y, rfl⟩ := e.surjective x
  have hy := DFunLike.congr_fun hK.eq y
  simpa [σK, τK] using congrArg e hy

/-- The exponent identifying a cyclotomic automorphism is unchanged when
the cyclotomic field is transported across a rational algebra equivalence. -/
theorem galEquivZMod_conj_algEquiv
    (n : ℕ) [NeZero n]
    (K L : Type*) [Field K] [Field L] [NumberField K] [NumberField L]
    [IsCyclotomicExtension {n} ℚ K]
    [IsCyclotomicExtension {n} ℚ L]
    (e : K ≃ₐ[ℚ] L) (σ : K ≃ₐ[ℚ] K) :
    IsCyclotomicExtension.Rat.galEquivZMod n L
        (e.symm.trans (σ.trans e)) =
      IsCyclotomicExtension.Rat.galEquivZMod n K σ := by
  let ζ := IsCyclotomicExtension.zeta n ℚ K
  have hζ := IsCyclotomicExtension.zeta_spec n ℚ K
  have heζ : IsPrimitiveRoot (e ζ) n := hζ.map_of_injective e.injective
  have hL := IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq
    n L (e.symm.trans (σ.trans e)) heζ.pow_eq_one
  have hK := IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq
    n K σ hζ.pow_eq_one
  have hp :
      (e ζ) ^ (IsCyclotomicExtension.Rat.galEquivZMod n L
          (e.symm.trans (σ.trans e))).val.val =
        (e ζ) ^ (IsCyclotomicExtension.Rat.galEquivZMod n K σ).val.val := by
    rw [← hL, ← map_pow, ← hK]
    simp
    rfl
  rw [(heζ.isOfFinOrder (NeZero.ne _)).pow_inj_mod,
    ← heζ.eq_orderOf, ← ZMod.natCast_eq_natCast_iff'] at hp
  apply Units.ext
  simpa [ZMod.natCast_zmod_val] using hp

/-- Transport a cyclotomic-extension structure across an algebra
equivalence. -/
theorem isCyclotomicExtension_of_algEquiv
    (S : Set ℕ) (A K L : Type*)
    [CommRing A] [CommRing K] [CommRing L]
    [Algebra A K] [Algebra A L]
    [IsCyclotomicExtension S A K]
    (e : K ≃ₐ[A] L) : IsCyclotomicExtension S A L := by
  constructor
  · intro n hn hn0
    obtain ⟨r, hr⟩ :=
      IsCyclotomicExtension.exists_isPrimitiveRoot A K hn hn0
    exact ⟨e r, hr.map_of_injective e.injective⟩
  · intro x
    obtain ⟨y, rfl⟩ := e.surjective x
    let T := Algebra.adjoin A
      {b : L | ∃ n : ℕ, n ∈ S ∧ n ≠ 0 ∧ b ^ n = 1}
    apply Algebra.adjoin_induction (R := A) (A := K)
      (s := {b : K | ∃ n : ℕ, n ∈ S ∧ n ≠ 0 ∧ b ^ n = 1})
      (p := fun y _ ↦ e y ∈ T)
    · intro y hy
      apply Algebra.subset_adjoin
      obtain ⟨n, hn, hn0, hyn⟩ := hy
      exact ⟨n, hn, hn0, by simpa using congrArg e hyn⟩
    · intro r
      simpa using T.algebraMap_mem r
    · intro x y _ _ hx hy
      simpa using T.add_mem hx hy
    · intro x y _ _ hx hy
      simpa using T.mul_mem hx hy
    · exact IsCyclotomicExtension.adjoin_roots y

theorem IsConj.eq_of_left_commutes
    {G : Type*} [Group G] {x y : G}
    (hxy : IsConj x y) (hx : ∀ z : G, Commute x z) : x = y := by
  obtain ⟨z, hz⟩ := hxy
  apply @mul_right_cancel G _ _ x (z : G) y
  calc
    x * z = z * x := (hx z).eq
    _ = y * z := hz

/-- The natural action of the rational Galois group on the ring of integers
has no extra integral fixed points.  Mathlib's general theorem uses a locally
installed action obtained from `galRestrict`; this specialization records the
same fact for the standard `RingOfIntegers` action used by Frobenius. -/
theorem ringOfIntegers_isInvariant_galois
    (L : Type*) [Field L] [NumberField L] [h : IsGalois ℚ L] :
    Algebra.IsInvariant ℤ (𝓞 L) (L ≃ₐ[ℚ] L) := by
  replace h := ((IsGalois.tfae (F := ℚ) (E := L)).out 0 1).mp h
  refine ⟨fun b hb ↦ ?_⟩
  replace hb : algebraMap (𝓞 L) L b ∈
      IntermediateField.fixedField (⊤ : Subgroup (L ≃ₐ[ℚ] L)) := by
    rintro ⟨g, -⟩
    exact congrArg Subtype.val (hb g)
  rw [h, IntermediateField.mem_bot] at hb
  obtain ⟨q, hq⟩ := hb
  have hb : IsIntegral ℤ b := IsIntegralClosure.isIntegral ℤ L b
  rw [← isIntegral_algebraMap_iff
      (FaithfulSMul.algebraMap_injective (𝓞 L) L),
    ← hq, isIntegral_algebraMap_iff
      (FaithfulSMul.algebraMap_injective ℚ L)] at hb
  obtain ⟨z, rfl⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hb
  rw [← IsScalarTower.algebraMap_apply,
    IsScalarTower.algebraMap_apply ℤ (𝓞 L) L,
    (FaithfulSMul.algebraMap_injective (𝓞 L) L).eq_iff] at hq
  exact ⟨z, hq⟩

/-- The residual, cyclotomic-congruence, and seed-character Frobenius
conditions can be imposed in one Chebotarev class because the two relevant
number fields have coprime ramification. -/
theorem _root_.solution
    {N k p : ℕ} [Fact p.Prime]
    (hN : 0 < N) (hk : 2 ≤ k)
    (ι : MTT.Qbar →+* ℂ) (f : MTT.Eigenform N k ι)
    (η : DirichletCharacterWithLevel)
    (m B : ℕ) (hB : 0 < B)
    (hηcoprime : Nat.Coprime (N * p) η.2.conductor)
    (V : SeededEigenformPadicPlaceData (p := p) f η)
    (D : EigenformResidualGaloisRepresentationData hN hk f V.embedding)
    (a : (ZMod η.1.1)ˣ)
    (ha : orderOf (η.2 (a : ZMod η.1.1)) = orderOf η.2)
    (hdiscr :
      letI : Field D.kernelField := D.kernelField_field
      letI : NumberField D.kernelField := D.kernelField_numberField
      ∀ {l : ℕ}, l.Prime →
        (l : ℤ) ∣ NumberField.discr D.kernelField → l ∣ N * p)
    (hsup : ∀ (K₁ K₂ : IntermediateField ℚ MTT.Qbar)
      [NumberField K₁] [NumberField K₂]
      {l : ℤ}, Prime l →
      ¬ l ∣ NumberField.discr K₁ →
      ¬ l ∣ NumberField.discr K₂ →
      letI : NumberField ↥(K₁ ⊔ K₂) :=
        { to_charZero := inferInstance
          to_finiteDimensional := IntermediateField.finiteDimensional_sup K₁ K₂ }
      ¬ l ∣ NumberField.discr ↥(K₁ ⊔ K₂))
    (hcyclo : ∀ (n : ℕ) [NeZero n]
      (K : IntermediateField ℚ MTT.Qbar) [NumberField K]
      [IsCyclotomicExtension {n} ℚ K]
      {l : ℕ}, l.Prime →
      (l : ℤ) ∣ NumberField.discr K → l ∣ n) :
    Nonempty (SeededOrderlyFrobeniusClassData f η m B V) := by
  letI : Field D.kernelField := D.kernelField_field
  letI : NumberField D.kernelField := D.kernelField_numberField
  letI : IsGalois ℚ D.kernelField := D.kernelField_galois
  let iD : D.kernelField →ₐ[ℚ] MTT.Qbar := IsAlgClosed.lift
  let KD : IntermediateField ℚ MTT.Qbar := iD.fieldRange
  letI : NumberField KD :=
    { to_charZero := inferInstance
      to_finiteDimensional :=
        iD.equivFieldRange.toLinearEquiv.finiteDimensional }
  letI : IsGalois ℚ KD := IsGalois.of_algEquiv iD.equivFieldRange
  letI : @Normal ℚ KD _ _ KD.algebra' :=
    (IsGalois.of_algEquiv iD.equivFieldRange).to_normal
  let n₀ := p ^ m * N
  have hn₀ : n₀ ≠ 0 :=
    Nat.mul_ne_zero (pow_ne_zero _ (Fact.out : p.Prime).ne_zero)
      (Nat.ne_of_gt hN)
  letI : NeZero n₀ := ⟨hn₀⟩
  let Kpm := cyclotomicFieldQbar n₀
  letI : @Normal ℚ Kpm _ _ Kpm.algebra' :=
    (IsCyclotomicExtension.isGalois {n₀} ℚ Kpm).to_normal
  let K₀ : IntermediateField ℚ MTT.Qbar := KD ⊔ Kpm
  letI : NumberField K₀ :=
    { to_charZero := inferInstance
      to_finiteDimensional := IntermediateField.finiteDimensional_sup KD Kpm }
  letI : IsGalois ℚ K₀ :=
    { to_normal := IntermediateField.normal_sup ℚ MTT.Qbar KD Kpm
      to_isSeparable := inferInstance }
  letI : @Normal ℚ K₀ _ _ K₀.algebra' :=
    IntermediateField.normal_sup ℚ MTT.Qbar KD Kpm
  have hKDsupport : ∀ {l : ℕ}, l.Prime →
      (l : ℤ) ∣ NumberField.discr KD → l ∣ N * p := by
    intro l hl hld
    apply hdiscr hl
    simpa [NumberField.discr_eq_discr_of_algEquiv
      D.kernelField iD.equivFieldRange] using hld
  have hKpmsupport : ∀ {l : ℕ}, l.Prime →
      (l : ℤ) ∣ NumberField.discr Kpm → l ∣ N * p := by
    intro l hl hld
    have hln₀ : l ∣ n₀ := hcyclo n₀ Kpm hl hld
    rcases hl.dvd_mul.mp hln₀ with hlpow | hlN
    · exact dvd_mul_of_dvd_right (hl.dvd_of_dvd_pow hlpow) N
    · exact dvd_mul_of_dvd_left hlN p
  have hK₀support : ∀ {l : ℕ}, l.Prime →
      (l : ℤ) ∣ NumberField.discr K₀ → l ∣ N * p := by
    intro l hl hld
    by_contra hln
    have hKDnot : ¬ (l : ℤ) ∣ NumberField.discr KD :=
      fun h ↦ hln (hKDsupport hl h)
    have hKpmnot : ¬ (l : ℤ) ∣ NumberField.discr Kpm :=
      fun h ↦ hln (hKpmsupport hl h)
    exact (hsup KD Kpm (Nat.prime_iff_prime_int.mp hl)
      hKDnot hKpmnot) hld
  letI : NeZero η.1.1 := ⟨Nat.ne_of_gt η.1.2⟩
  letI : NeZero η.2.conductor := ⟨η.2.conductor_ne_zero⟩
  let K₁ := cyclotomicFieldQbar η.2.conductor
  letI : @Normal ℚ K₁ _ _ K₁.algebra' :=
    (IsCyclotomicExtension.isGalois {η.2.conductor} ℚ K₁).to_normal
  have hK₁support : ∀ {l : ℕ}, l.Prime →
      (l : ℤ) ∣ NumberField.discr K₁ → l ∣ η.2.conductor := by
    intro l hl hld
    exact hcyclo η.2.conductor K₁ hl hld
  have hdiscCoprime :
      IsCoprime (NumberField.discr K₀) (NumberField.discr K₁) :=
    discr_isCoprime_of_prime_support K₀ K₁ (N * p) η.2.conductor
      hηcoprime hK₀support hK₁support
  let E : IntermediateField ℚ MTT.Qbar := K₀ ⊔ K₁
  -- Use the intermediate-field algebra structure consistently below.  It is
  -- propositionally equal to the rational algebra structure supplied by the
  -- field instance, but fixing it here avoids duplicate-instance terms in
  -- `lift`, `restrict`, and the Galois restriction maps.
  letI : Algebra ℚ E := E.algebra'
  letI : NumberField E :=
    { to_charZero := inferInstance
      to_finiteDimensional := IntermediateField.finiteDimensional_sup K₀ K₁ }
  letI : IsGalois ℚ E :=
    { to_normal := IntermediateField.normal_sup ℚ MTT.Qbar K₀ K₁
      to_isSeparable := inferInstance }
  have hiDEmem (x : D.kernelField) : iD x ∈ E := by
    exact ((show KD ≤ K₀ from le_sup_left).trans
      (show K₀ ≤ E from le_sup_left))
      (show iD x ∈ KD from ⟨x, rfl⟩)
  let iDE : D.kernelField →ₐ[ℚ] E :=
    iD.codRestrict E.toSubalgebra hiDEmem
  letI : Algebra D.kernelField E := iDE.toAlgebra
  letI : IsScalarTower ℚ D.kernelField E :=
    IsScalarTower.of_algebraMap_eq (fun q ↦ by
      apply Subtype.ext
      simp [iDE])
  let K₀E : IntermediateField ℚ E :=
    IntermediateField.restrict (show K₀ ≤ E from le_sup_left)
  let K₁E : IntermediateField ℚ E :=
    IntermediateField.restrict (show K₁ ≤ E from le_sup_right)
  have hKpmE : Kpm ≤ E := le_sup_right.trans le_sup_left
  let KpmE : IntermediateField ℚ E :=
    IntermediateField.restrict hKpmE
  let e₀ : K₀ ≃ₐ[ℚ] K₀E :=
    IntermediateField.restrict_algEquiv (show K₀ ≤ E from le_sup_left)
  let e₁ : K₁ ≃ₐ[ℚ] K₁E :=
    IntermediateField.restrict_algEquiv (show K₁ ≤ E from le_sup_right)
  let epm : Kpm ≃ₐ[ℚ] KpmE :=
    IntermediateField.restrict_algEquiv hKpmE
  letI : NumberField K₀E :=
    { to_charZero := inferInstance
      to_finiteDimensional := e₀.toLinearEquiv.finiteDimensional }
  letI : NumberField K₁E :=
    { to_charZero := inferInstance
      to_finiteDimensional := e₁.toLinearEquiv.finiteDimensional }
  letI : NumberField KpmE :=
    { to_charZero := inferInstance
      to_finiteDimensional := epm.toLinearEquiv.finiteDimensional }
  letI : IsCyclotomicExtension {η.2.conductor} ℚ K₁E :=
    isCyclotomicExtension_of_algEquiv {η.2.conductor} ℚ K₁ K₁E e₁
  letI : IsCyclotomicExtension {n₀} ℚ KpmE :=
    isCyclotomicExtension_of_algEquiv {n₀} ℚ Kpm KpmE epm
  letI : IsGalois ℚ KpmE :=
    IsCyclotomicExtension.isGalois {n₀} ℚ KpmE
  have hg₀canonical : @IsGalois ℚ _ K₀E _ K₀E.algebra' :=
    IsGalois.of_algEquiv e₀
  have hg₁canonical : @IsGalois ℚ _ K₁E _ K₁E.algebra' :=
    IsGalois.of_algEquiv e₁
  have hg₀ : IsGalois ℚ K₀E := by
    let A₀ : Algebra ℚ K₀E := inferInstance
    have hA₀ : A₀ = K₀E.algebra' := Subsingleton.elim _ _
    exact cast (congrArg
      (fun A : Algebra ℚ K₀E => @IsGalois ℚ _ K₀E _ A) hA₀).symm
      hg₀canonical
  have hg₁ : IsGalois ℚ K₁E := by
    let A₁ : Algebra ℚ K₁E := inferInstance
    have hA₁ : A₁ = K₁E.algebra' := Subsingleton.elim _ _
    exact cast (congrArg
      (fun A : Algebra ℚ K₁E => @IsGalois ℚ _ K₁E _ A) hA₁).symm
      hg₁canonical
  letI : IsGalois ℚ K₀E := hg₀
  letI : IsGalois ℚ K₁E := hg₁
  have hdiscCoprimeE :
      IsCoprime (NumberField.discr K₀E) (NumberField.discr K₁E) := by
    rw [← NumberField.discr_eq_discr_of_algEquiv K₀ e₀,
      ← NumberField.discr_eq_discr_of_algEquiv K₁ e₁]
    exact hdiscCoprime
  have hlinear : K₀E.LinearDisjoint K₁E := by
    exact NumberField.linearDisjoint_of_isGalois_isCoprime_discr
      E K₀E K₁E hdiscCoprimeE
  have hinf : K₁E ⊓ K₀E = ⊥ := by
    rw [inf_comm]
    exact IntermediateField.LinearDisjoint.iff_inf_eq_bot.mp hlinear
  have hsupTop : K₀E ⊔ K₁E = ⊤ := by
    apply IntermediateField.lift_injective
    rw [IntermediateField.lift_sup,
      IntermediateField.lift_restrict,
      IntermediateField.lift_restrict,
      IntermediateField.lift_top]
  letI : IsGalois K₀E E :=
    IsGalois.sup_right K₁E K₀E (by simpa [sup_comm] using hsupTop)
  letI : FiniteDimensional K₀E E :=
    FiniteDimensional.right ℚ K₀E E
  obtain ⟨ac, hac⟩ := exists_conductorUnit_characterValue_eq η a
  let τ₁ : K₁ ≃ₐ[ℚ] K₁ :=
    (IsCyclotomicExtension.Rat.galEquivZMod η.2.conductor K₁).symm ac
  let τ₁E : K₁E ≃ₐ[ℚ] K₁E := e₁.symm.trans (τ₁.trans e₁)
  obtain ⟨φprod, hφprod⟩ :=
    IntermediateField.restrictRestrictAlgEquivMapHom_surjective
      K₁E K₀E hinf τ₁E
  let σ : E ≃ₐ[ℚ] E :=
    MulSemiringAction.toAlgAut (E ≃ₐ[K₀E] E) ℚ E φprod
  have hσK₀ : σ.restrictNormal K₀E = 1 := by
    apply AlgEquiv.ext
    intro x
    apply (algebraMap K₀E E).injective
    rw [AlgEquiv.restrictNormal_commutes]
    exact φprod.commutes x
  have hσK₁ : σ.restrictNormal K₁E = τ₁E := hφprod
  -- Delete primes dividing the declared level of the seed character as well
  -- as its conductor.  This is needed to compare the imprimitive character
  -- with its primitive character at every prime in the class.
  let bad : ℕ := B * (N * p * η.1.1)
  have hbad : bad ≠ 0 := by
    exact Nat.mul_ne_zero (Nat.ne_of_gt hB)
      (Nat.mul_ne_zero
        (Nat.mul_ne_zero (Nat.ne_of_gt hN) (Fact.out : p.Prime).ne_zero)
        (Nat.ne_of_gt η.1.2))
  let S : Finset ℕ := bad.primeFactors
  let hgE : IsGalois ℚ E := inferInstance
  letI : IsGalois ℚ E := hgE
  letI : Algebra.IsInvariant ℤ (𝓞 E) (E ≃ₐ[ℚ] E) :=
    ringOfIntegers_isInvariant_galois (h := hgE) E
  letI : Algebra.IsInvariant ℤ (𝓞 D.kernelField)
      (D.kernelField ≃ₐ[ℚ] D.kernelField) :=
    ringOfIntegers_isInvariant_galois D.kernelField
  let A : Set ℕ := {l : ℕ |
    l ∉ S ∧ @LanglandsTunnell.classIndicator E _ _ hgE σ l = 1}
  have hcheb : IsChebotarevPrimeClass A :=
    @IsChebotarevPrimeClass.ofFiniteGalois A E _ _ hgE σ S rfl
  have hprime : ∀ ⦃l : ℕ⦄, l ∈ A → l.Prime := by
    intro l hl
    have hind := hl.2
    unfold LanglandsTunnell.classIndicator at hind
    split at hind
    · rename_i hex
      exact hex.choose
    · simp at hind
  have hnotdvdBad : ∀ ⦃l : ℕ⦄, l ∈ A → ¬ l ∣ bad := by
    intro l hl hldvd
    exact hl.1 (Nat.mem_primeFactors.mpr ⟨hprime hl, hldvd, hbad⟩)
  have havoids : ∀ ⦃l : ℕ⦄, l ∈ A → Nat.Coprime l B := by
    intro l hl
    apply (hprime hl).coprime_iff_not_dvd.mpr
    exact fun hldvd ↦ hnotdvdBad hl (dvd_mul_of_dvd_left hldvd _)
  have hcopLevelSeed : ∀ ⦃l : ℕ⦄, l ∈ A →
      Nat.Coprime l (N * η.2.conductor) := by
    intro l hl
    apply (hprime hl).coprime_iff_not_dvd.mpr
    intro hldvd
    apply hnotdvdBad hl
    have hcondLevel : N * η.2.conductor ∣ N * η.1.1 :=
      Nat.mul_dvd_mul_left N η.2.conductor_dvd_level
    simpa [bad, mul_assoc, mul_comm, mul_left_comm] using
      dvd_mul_of_dvd_right
        (dvd_mul_of_dvd_left (hldvd.trans hcondLevel) p) B
  have hcopDeclared : ∀ ⦃l : ℕ⦄, l ∈ A →
      Nat.Coprime l η.1.1 := by
    intro l hl
    apply (hprime hl).coprime_iff_not_dvd.mpr
    intro hldvd
    apply hnotdvdBad hl
    simpa [bad, mul_assoc, mul_comm, mul_left_comm] using
      dvd_mul_of_dvd_right (dvd_mul_of_dvd_right hldvd (N * p)) B
  have hcopNp : ∀ ⦃l : ℕ⦄, l ∈ A → Nat.Coprime l (N * p) := by
    intro l hl
    apply (hprime hl).coprime_iff_not_dvd.mpr
    intro hldvd
    apply hnotdvdBad hl
    simpa [bad, mul_assoc, mul_comm, mul_left_comm] using
      dvd_mul_of_dvd_right (dvd_mul_of_dvd_right hldvd η.1.1) B
  have hrestrict_of_conj
      (φ : E ≃ₐ[ℚ] E) (hconj : IsConj σ φ) :
      φ.restrictNormal K₀E = 1 ∧ φ.restrictNormal K₁E = τ₁E := by
    constructor
    · have hc :=
        (AlgEquiv.restrictNormalHom K₀E).map_isConj hconj
      have hs : (AlgEquiv.restrictNormalHom K₀E) σ = 1 := by
        exact hσK₀
      rw [hs] at hc
      change (AlgEquiv.restrictNormalHom K₀E) φ = 1
      exact isConj_one_right.mp hc
    · have hc :=
        (AlgEquiv.restrictNormalHom K₁E).map_isConj hconj
      have hs : (AlgEquiv.restrictNormalHom K₁E) σ = τ₁E := by
        exact hσK₁
      rw [hs] at hc
      change (AlgEquiv.restrictNormalHom K₁E) φ = τ₁E
      symm
      apply IsConj.eq_of_left_commutes hc
      intro z
      exact algAut_commute_of_cyclotomic_equiv
        η.2.conductor K₁ K₁E e₁ τ₁E z
  have hKpmK₀ : KpmE ≤ K₀E := by
    intro x hx
    rw [IntermediateField.mem_restrict] at hx ⊢
    exact (show Kpm ≤ K₀ from le_sup_right) hx
  have hiDEK₀ (x : D.kernelField) :
      algebraMap D.kernelField E x ∈ K₀E := by
    rw [IntermediateField.mem_restrict]
    change (iDE x : MTT.Qbar) ∈ K₀
    simp only [iDE, AlgHom.coe_codRestrict, AlgHom.coe_coe]
    exact (show KD ≤ K₀ from le_sup_left)
      (show iD x ∈ KD from ⟨x, rfl⟩)
  have hrestrictD_of_restrictK₀
      (φ : E ≃ₐ[ℚ] E) (hφ₀ : φ.restrictNormal K₀E = 1) :
      φ.restrictNormal D.kernelField = 1 := by
    apply AlgEquiv.ext
    intro x
    let y : K₀E := ⟨algebraMap D.kernelField E x, hiDEK₀ x⟩
    have hy := DFunLike.congr_fun hφ₀ y
    apply (algebraMap D.kernelField E).injective
    rw [AlgEquiv.restrictNormal_commutes]
    change φ (algebraMap D.kernelField E x) = algebraMap D.kernelField E x
    have hyE := congrArg (algebraMap K₀E E) hy
    simpa [AlgEquiv.restrictNormal_commutes] using hyE
  have hmodN₀ : ∀ ⦃l : ℕ⦄, l ∈ A → Nat.ModEq n₀ l 1 := by
    intro l hl
    have hlp := hprime hl
    have hind := hl.2
    unfold LanglandsTunnell.classIndicator at hind
    split at hind
    · rename_i hex
      obtain ⟨_hlp, Q, hQp, hQover, hQunr, hconj⟩ := hex
      letI : Q.IsPrime := hQp
      letI : Finite ((𝓞 E) ⧸ Q) :=
        finite_quotient_of_ne_bot (ne_bot_of_liesOver_ratPrimeIdeal hlp)
      let φ := arithFrobAt ℤ (E ≃ₐ[ℚ] E) Q
      have hφconj : IsConj σ φ := by
        change IsConj σ (arithFrobAt ℤ (E ≃ₐ[ℚ] E) Q)
        exact hconj
      have hφ₀ := (hrestrict_of_conj φ hφconj).1
      have hφpm : φ.restrictNormal KpmE = 1 := by
        apply AlgEquiv.ext
        intro x
        let y : K₀E := ⟨x, hKpmK₀ x.property⟩
        have hy := DFunLike.congr_fun hφ₀ y
        apply (algebraMap KpmE E).injective
        rw [AlgEquiv.restrictNormal_commutes]
        change φ (algebraMap KpmE E x) = algebraMap KpmE E x
        have hyE := congrArg (algebraMap K₀E E) hy
        simpa [AlgEquiv.restrictNormal_commutes] using hyE
      let qpm : Ideal (𝓞 KpmE) :=
        Q.comap (algebraMap (𝓞 KpmE) (𝓞 E))
      have hqover : qpm.LiesOver (ratPrimeIdeal l) := by
        rw [Ideal.liesOver_iff]
        calc
          ratPrimeIdeal l = Q.under ℤ := hQover.over
          _ = (Q.under (𝓞 KpmE)).under ℤ :=
            (Ideal.under_under (A := ℤ) (B := 𝓞 KpmE) (C := 𝓞 E) Q).symm
          _ = qpm.under ℤ := by rfl
      have hcopn₀ : Nat.Coprime l n₀ := by
        apply hlp.coprime_iff_not_dvd.mpr
        intro hldvd
        rcases hlp.dvd_mul.mp hldvd with hlpow | hlN
        · have hlpdiv : l ∣ p := hlp.dvd_of_dvd_pow hlpow
          exact (hlp.coprime_iff_not_dvd.mp
            ((hcopNp hl).coprime_dvd_right (dvd_mul_left p N))) hlpdiv
        · exact (hlp.coprime_iff_not_dvd.mp
            ((hcopNp hl).coprime_dvd_right (dvd_mul_right N p))) hlN
      have harith : IsArithFrobAt ℤ (φ.restrictNormal KpmE) qpm :=
        isArithFrobAt_restrictNormal KpmE E φ Q
          (IsArithFrobAt.arithFrobAt ℤ (E ≃ₐ[ℚ] E) Q)
      have hgal := cyclotomic_galEquivZMod_of_isArithFrobAt
        n₀ KpmE hlp hcopn₀ qpm hqover
        (φ.restrictNormal KpmE) harith
      rw [hφpm, map_one] at hgal
      have hzmod : (l : ZMod n₀) = 1 := by
        simpa [ZMod.coe_unitOfCoprime] using congrArg Units.val hgal.symm
      exact (ZMod.natCast_eq_natCast_iff l 1 n₀).mp (by
        simpa only [Nat.cast_one] using hzmod)
    · simp at hind
  have hseedValue : ∀ ⦃l : ℕ⦄, l ∈ A → η.2 l = η.2 a := by
    intro l hl
    have hlp := hprime hl
    have hind := hl.2
    unfold LanglandsTunnell.classIndicator at hind
    split at hind
    · rename_i hex
      obtain ⟨_hlp, Q, hQp, hQover, _hQunr, hconj⟩ := hex
      letI : Q.IsPrime := hQp
      letI : Finite ((𝓞 E) ⧸ Q) :=
        finite_quotient_of_ne_bot (ne_bot_of_liesOver_ratPrimeIdeal hlp)
      let φ := arithFrobAt ℤ (E ≃ₐ[ℚ] E) Q
      have hφconj : IsConj σ φ := by
        change IsConj σ (arithFrobAt ℤ (E ≃ₐ[ℚ] E) Q)
        exact hconj
      have hφ₁ := (hrestrict_of_conj φ hφconj).2
      let q₁ : Ideal (𝓞 K₁E) :=
        Q.comap (algebraMap (𝓞 K₁E) (𝓞 E))
      have hqover : q₁.LiesOver (ratPrimeIdeal l) := by
        rw [Ideal.liesOver_iff]
        calc
          ratPrimeIdeal l = Q.under ℤ := hQover.over
          _ = (Q.under (𝓞 K₁E)).under ℤ :=
            (Ideal.under_under (A := ℤ) (B := 𝓞 K₁E) (C := 𝓞 E) Q).symm
          _ = q₁.under ℤ := by rfl
      have hcopCond : Nat.Coprime l η.2.conductor :=
        (hcopLevelSeed hl).coprime_dvd_right
          (dvd_mul_of_dvd_right (dvd_refl η.2.conductor) N)
      have harith : IsArithFrobAt ℤ (φ.restrictNormal K₁E) q₁ :=
        isArithFrobAt_restrictNormal K₁E E φ Q
          (IsArithFrobAt.arithFrobAt ℤ (E ≃ₐ[ℚ] E) Q)
      have hgal := cyclotomic_galEquivZMod_of_isArithFrobAt
        η.2.conductor K₁E hlp hcopCond q₁ hqover
        (φ.restrictNormal K₁E) harith
      rw [hφ₁, galEquivZMod_conj_algEquiv
        η.2.conductor K₁ K₁E e₁ τ₁] at hgal
      have hτ : IsCyclotomicExtension.Rat.galEquivZMod
          η.2.conductor K₁ τ₁ = ac := by
        exact (IsCyclotomicExtension.Rat.galEquivZMod
          η.2.conductor K₁).apply_symm_apply ac
      rw [hτ] at hgal
      have hηl : η.2.primitiveCharacter
          (ZMod.unitOfCoprime l hcopCond) = η.2 l := by
        change η.2.primitiveCharacter
            (ZMod.unitOfCoprime l hcopCond : ZMod η.2.conductor) =
          η.2 (l : ZMod η.1.1)
        rw [ZMod.coe_unitOfCoprime]
        convert DirichletCharacter.primitiveCharacter_apply_of_isCoprime
          (χ := η.2) (a := (l : ℤ))
          (Nat.isCoprime_iff_coprime.mpr
            (hcopDeclared hl)) using 1 <;> norm_cast
      calc
        η.2 l = η.2.primitiveCharacter
            (ZMod.unitOfCoprime l hcopCond) := hηl.symm
        _ = η.2.primitiveCharacter ac :=
          congrArg _ (congrArg Units.val hgal.symm)
        _ = η.2 a := hac
    · simp at hind
  have hcoeffNear : ∀ ⦃l : ℕ⦄, l ∈ A →
      ‖V.embedding (f.coeff l - 2)‖ < 1 := by
    intro l hl
    have hlp := hprime hl
    have hind := hl.2
    unfold LanglandsTunnell.classIndicator at hind
    split at hind
    · rename_i hex
      obtain ⟨_hlp, Q, hQp, hQover, _hQunr, hconj⟩ := hex
      letI : Q.IsPrime := hQp
      letI : Finite ((𝓞 E) ⧸ Q) :=
        finite_quotient_of_ne_bot (ne_bot_of_liesOver_ratPrimeIdeal hlp)
      let φ := arithFrobAt ℤ (E ≃ₐ[ℚ] E) Q
      have hφconj : IsConj σ φ := by
        change IsConj σ (arithFrobAt ℤ (E ≃ₐ[ℚ] E) Q)
        exact hconj
      have hφ₀ := (hrestrict_of_conj φ hφconj).1
      have hφD : φ.restrictNormal D.kernelField = 1 :=
        hrestrictD_of_restrictK₀ φ hφ₀
      let qD : Ideal (𝓞 D.kernelField) :=
        Q.comap (algebraMap (𝓞 D.kernelField) (𝓞 E))
      have hqover : qD.LiesOver (ratPrimeIdeal l) := by
        rw [Ideal.liesOver_iff]
        calc
          ratPrimeIdeal l = Q.under ℤ := hQover.over
          _ = (Q.under (𝓞 D.kernelField)).under ℤ :=
            (Ideal.under_under (A := ℤ) (B := 𝓞 D.kernelField)
              (C := 𝓞 E) Q).symm
          _ = qD.under ℤ := by rfl
      have hqprime : qD.IsPrime := by
        exact Ideal.comap_isPrime
          (algebraMap (𝓞 D.kernelField) (𝓞 E)) Q
      letI : qD.IsPrime := hqprime
      letI : Finite ((𝓞 D.kernelField) ⧸ qD) :=
        finite_quotient_of_ne_bot (ne_bot_of_liesOver_ratPrimeIdeal hlp)
      have hunr := D.unramified_outside hlp (hcopNp hl)
        qD hqprime hqover
      have hArithRestr : IsArithFrobAt ℤ
          (φ.restrictNormal D.kernelField) qD :=
        isArithFrobAt_restrictNormal D.kernelField E φ Q
          (IsArithFrobAt.arithFrobAt ℤ (E ≃ₐ[ℚ] E) Q)
      have hArithChosen : IsArithFrobAt ℤ
          (arithFrobAt ℤ (D.kernelField ≃ₐ[ℚ] D.kernelField) qD) qD :=
        IsArithFrobAt.arithFrobAt ℤ
          (D.kernelField ≃ₐ[ℚ] D.kernelField) qD
      have hmem := hArithRestr.mul_inv_mem_inertia hArithChosen
      rw [hunr, Subgroup.mem_bot] at hmem
      have hrestr : φ.restrictNormal D.kernelField =
          arithFrobAt ℤ (D.kernelField ≃ₐ[ℚ] D.kernelField) qD :=
        mul_inv_eq_one.mp hmem
      have hFrobD : arithFrobAt ℤ
          (D.kernelField ≃ₐ[ℚ] D.kernelField) qD = 1 := by
        rw [← hrestr]
        exact hφD
      have htr := D.trace_frobenius hlp (hcopNp hl)
        qD hqprime hqover
      rw [hFrobD, map_one] at htr
      have hmk : Ideal.Quotient.mk (f.coefficientPrime V.embedding)
          (f.integralCoeff hN hk l - 2) = 0 := by
        rw [map_sub, map_ofNat, ← htr]
        simp
      have hmem : f.integralCoeff hN hk l - 2 ∈
          f.coefficientPrime V.embedding :=
        Ideal.Quotient.eq_zero_iff_mem.mp hmk
      have hnorm := (f.mem_coefficientPrime_iff V.embedding
        (f.integralCoeff hN hk l - 2)).mp hmem
      have hcoe :
          (((f.integralCoeff hN hk l - 2 : 𝓞 f.coefficientField) :
              f.coefficientField) : MTT.Qbar) = f.coeff l - 2 := by
        rfl
      rw [hcoe] at hnorm
      simpa [map_sub, map_ofNat] using hnorm
    · simp at hind
  have hcongPm : ∀ ⦃l : ℕ⦄, l ∈ A → Nat.ModEq (p ^ m) l 1 := by
    intro l hl
    apply Nat.ModEq.of_dvd (dvd_mul_right (p ^ m) N)
    exact hmodN₀ hl
  have hnebentypeNear : ∀ ⦃l : ℕ⦄, l ∈ A →
      ‖V.embedding (f.epsilon l - 1)‖ < 1 := by
    intro l hl
    have hmodN : Nat.ModEq N l 1 := by
      apply Nat.ModEq.of_dvd (dvd_mul_left N (p ^ m))
      exact hmodN₀ hl
    have hzmod : (l : ZMod N) = 1 :=
      by simpa only [Nat.cast_one] using
        (ZMod.natCast_eq_natCast_iff l 1 N).mpr hmodN
    have heps : f.epsilon l = 1 := by
      change f.epsilon (l : ZMod N) = 1
      rw [hzmod, map_one]
    rw [heps, sub_self, map_zero, norm_zero]
    exact zero_lt_one
  have hseedOrder : ∀ ⦃l : ℕ⦄, l ∈ A →
      orderOf (η.2 l) = orderOf η.2 := by
    intro l hl
    rw [hseedValue hl]
    exact ha
  exact ⟨{
    primes := A
    chebotarevClass := hcheb
    prime_of_mem := hprime
    avoids := havoids
    congruent_one_mod_pm := hcongPm
    coprime_level_seed := hcopLevelSeed
    coeff_near_two := hcoeffNear
    nebentype_near_one := hnebentypeNear
    seed_value_has_full_order := hseedOrder }⟩

end HorizontalPadicL
