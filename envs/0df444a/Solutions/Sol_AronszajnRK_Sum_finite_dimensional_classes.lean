          * (bS w hw).repr v j := rfl
      _ = ∑ i, ∑ j, (starRingEnd ℂ) r * ((G β) i j
            * star ((bS w hw).repr u i) * (bS w hw).repr v j) :=
            Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => hterm i j
      _ = (starRingEnd ℂ) r * ∑ i, ∑ j, (G β) i j
            * star ((bS w hw).repr u i) * (bS w hw).repr v j := by
            simp only [Finset.mul_sum]
      _ = (starRingEnd ℂ) r * inS w β hw u v := rfl
  definite := by
    intro u hu
    have hsum : (∑ i, ∑ j, (G β) i j * star ((bS w hw).repr u i)
        * (bS w hw).repr u j)
        = ∑ i, star ((bS w hw).repr u i) * ∑ j, (G β) i j * (bS w hw).repr u j := by
      refine Finset.sum_congr rfl fun i _ => ?_
