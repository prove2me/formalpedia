theorem TateCurve.pointY_zpow_mul {K : Type*} [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K] {q u : K} (hq0 : q ≠ 0) (n : ℤ) : pointY q (q ^ n * u) = pointY q u := by sorry
