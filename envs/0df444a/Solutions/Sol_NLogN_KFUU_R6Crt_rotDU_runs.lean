`rotCU neg`: the table set-up `tabU neg` (register code), KFC `rotF`, and the pops of the
parameters.  `rotCU_runs`: for `A = [s_0, …, s_{i-1}]` and any suffix `C` with
`vol C = Bv`, the data `xs` of shape `A ++ Q :: C` become KFU's controlled shift
`pull … (rotG |A| Q (fun a => lf cs a % Q))` with `cs = [cF neg sF μ Q j | j < i]`; the code does
not depend on `i, Q, μ, C`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL KFC AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem encK_upd0' (s : IState HS) (f : Fin HS → List ℤ) (hf : f 0 = []) (X : List Item) :
    (encK s f).upd 0 X = encK (s.upd 0 X) f := by
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases h : j = 0
  · subst h; simp [hf]
  · simp [h]

end NLogN.KFUU

end

section
-- Source module: Solutions.R6CrtTab
/-!
# CRT reversal §1: the digit-selector rotation `rotDU`

A copy of KFUU's uniform shift `rotCU` (KFUURot2–5) whose coefficient of field `j` is
`cFd = μ · (P_j / D) mod Q` (register `oDc = D`) instead of `μ P_j mod Q`.  With all field sizes
equal to `Q` and `D = Q^k`, the coefficient is `μ · [j = k]`, so `rotDU` adds `μ · a_k` to the
target digit: one shear `y += μ x_k` of the additive-swap reversal (see `jain6/crt/DESIGN.md`).
`rotDU_runs`: the KFU form `pull … (rotG i Q (fun a => lf cs a % Q))`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU.R6Crt

open IntMul KIL KFC AModel AModelL12 NLogN.KFUU

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

set_option maxHeartbeats 8000000 in
theorem rotDU_runs_sol_aux (sF : ℕ → ℕ) (μ D Q i : ℕ) (C : Shape)
    (hs : ∀ j < i, 1 ≤ sF j) (hQ1 : 1 ≤ Q) (hμ : μ < Q) (hD1 : 1 ≤ D) (hDP : D ≤ Pv sF i) (B Bb w : ℕ)
    (hB : zsz ((Q * Pv sF i : ℕ) : ℤ) ≤ B) (hiB : zsz (i : ℤ) ≤ B) (hBvB : zsz ((vol C : ℕ) : ℤ) ≤ B)
    (hBb : zsz ((2 * (Q * Pv sF i)) : ℕ) ≤ Bb)
    (xs : List ℤ) (hlen : xs.length = vol ((List.range i).map sF ++ Q :: C)) (hb : Bnd w xs)
    (t : IState HS) (R RSP : List Item) {LQ LM LP LD LI LB : List Item}
    (h0 : t.G 0 = ints xs ++ R)
    (hQ : t.G oQ = .int Q :: LQ) (hMu : t.G oMu = .int μ :: LM)
    (hPi : t.G oPi = .int (Pv sF i) :: LP) (hDc : t.G oDc = .int D :: LD)
    (hI : t.G oI = .int i :: LI)
    (hBv : t.G oBv = .int (vol C) :: LB)
    (hSP : t.G oSP = ints ((List.range i).map fun j => (sF j : ℤ)).reverse ++ RSP) :
    IRuns I iprog (rotDU) t
      (t.upd 0 (ints (pull ((List.range i).map sF ++ Q :: C) ((List.range i).map sF ++ Q :: C)
        (KFU.rotG i Q (fun a => KIL.lf (csUd sF μ D Q i) a % Q)) 0 xs) ++ R))
      (cRotU i (Pv sF i) Q (vol C) w B Bb) := by
  set A := (List.range i).map sF with hA
  set cs := csUd sF μ D Q i with hcs
  set aL := (List.range i).map fun j => (sF j : ℤ) with haL
  set s := t.upd oSP RSP with hsdef
  have ht : t = encK s (Function.update (fun _ => []) oSP aL.reverse) := by
    have := encK_lift t (fun _ => []) oSP aL.reverse RSP hSP
    rw [encK_nil] at this
    simpa using this
  have sQ : s.G oQ = .int Q :: LQ := by simp +decide [s, hQ]
  have sM : s.G oMu = .int μ :: LM := by simp +decide [s, hMu]
  have sP : s.G oPi = .int (Pv sF i) :: LP := by simp +decide [s, hPi]
  have sI : s.G oI = .int i :: LI := by simp +decide [s, hI]
  have sB : s.G oBv = .int (vol C) :: LB := by simp +decide [s, hBv]
  have sD : s.G oDc = .int D :: LD := by simp +decide [s, hDc]
  -- 1. table
  have T1 := tabUd_sp sF μ D Q i (vol C) hs hQ1 hμ hD1 hDP B Bb hB hiB hBvB hBb s sQ sM sP sD sI sB
  obtain ⟨c1, hc1, R1⟩ := Sp.irun (I := I) (iprog := iprog) T1
  rw [← ht] at R1
  -- the table as a function
  have hAl : A.length = i := by simp [A]
  have hcsl : cs.length = A.length := by simp [cs, csUd, A]
  have hfst : (A.zip cs).map Prod.fst = A := List.map_fst_zip (by omega)
  set as : ℕ → ℕ := fun p => KIL.lf cs (decode A p) % Q with has
  have htbl : tbl Q (acLd sF μ D Q i) = (List.range (vol A)).map fun p => ((as p : ℕ) : ℤ) := by
    show tbl Q (A.zip cs) = _
    rw [KIL.tbl_zip A cs (by omega)]
    refine List.map_congr_left fun p _ => ?_
    simp [as]
  have hvA : vol A = Pv sF i := rfl
  -- 2. rotF
  set E := tabEndd sF μ D Q i (Pv sF i) (vol C) with hE
  set u := encK s E
  have R2 := rotF_spec (I := I) (iprog := iprog) u xs as (Pv sF i) Q (vol C) w R (s.G 1) (s.G 2)
    (s.G 4) (s.G 14) (fun p => (Nat.mod_lt _ (by omega)).le)
    (by rw [hlen, vol_append, vol_cons, hvA]; ring) hb
    (by simp +decide [u, E, tabEndd, Function.update_apply, s, h0])
    (by simp +decide [u, E, tabEndd, Function.update_apply, ints])
    (by simp +decide [u, E, tabEndd, Function.update_apply, ints])
    (by simp +decide [u, E, tabEndd, Function.update_apply, ints])
    (by simp +decide [u, E, tabEndd, Function.update_apply, htbl, ← hvA, ints_append])
  set out := pull [Pv sF i, Q, vol C] [Pv sF i, Q, vol C] (KIL.rotAddr Q as) 0 xs
  have hE0 : E 0 = [] := by simp +decide [E, tabEndd, Function.update_apply]
  set s2 := s.upd 0 (ints out ++ R)
  have e2 : (u.upd 0 (ints out ++ R)).upd 14 (s.G 14) = encK s2 (Function.update E 14 []) := by
    rw [encK_upd0' s E hE0, show s.G 14 = ints [] ++ s2.G 14 by simp +decide [s2], encK_upd]
  rw [e2] at R2
  -- 3. pops
  set E1 := Function.update E 14 []
  have P1 := Sp.pop s2 E1 (i := 1) (a := (Pv sF i : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [E1, E, tabEndd, Function.update_apply]) (zB (Nat.le_mul_of_pos_left _ hQ1) hB)
  have P2 := Sp.pop s2 (Function.update E1 1 []) (i := 2) (a := (Q : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [E1, E, tabEndd, Function.update_apply])
    (zB (Nat.le_mul_of_pos_right _ (Pv_pos sF hs i le_rfl)) hB)
  have P3 := Sp.pop s2 (Function.update (Function.update E1 1 []) 2 []) (i := 4) (a := (vol C : ℤ))
    (l := []) (B := B) (by decide) (by simp +decide [E1, E, tabEndd, Function.update_apply]) hBvB
  have P4 := Sp.pop s2 (Function.update (Function.update (Function.update E1 1 []) 2 []) 4 [])
    (i := sNQ) (a := -(Q : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [E1, E, tabEndd, Function.update_apply])
    (by rw [zsz_neg]; exact zB (Nat.le_mul_of_pos_right _ (Pv_pos sF hs i le_rfl)) hB)
  obtain ⟨c3, hc3, R3⟩ := Sp.irun (I := I) (iprog := iprog) (p := postU) (P1.seq (P2.seq (P3.seq P4)))
  -- the address map
  have eo : pull (A ++ Q :: C) (A ++ Q :: C) (KFU.rotG A.length Q (fun a => KIL.lf cs a % Q)) 0 xs =
      out := by
    simp only [out, ← hvA]
    rw [← KFU.pull_rotG A C Q as 0 xs]
    apply pull_congr
    intro a ha
    have hl : (a.take A.length).length = A.length := by
      have := ha.length_eq; simp at this ⊢; omega
    have hvA' : Valid A (a.take A.length) := by
      have := ha
      rw [← List.take_append_drop A.length a] at this
      exact ((KIL.valid_append_iff hl).1 this).1
    simp only [KFU.rotG, as, decode_encode hvA']
  rw [hAl] at eo
  rw [eo]
  refine ((R1.mono hc1).seq (R2.seq (R3.mono hc3))).mono' ?_ ?_
  · refine IState.ext' (fun j => ?_) rfl rfl
    by_cases j0 : j = 0
    · subst j0; simp +decide [s2, E1, E, tabEndd, Function.update_apply]
    by_cases j1 : j = oSP
    · subst j1; simp +decide [s2, s, E1, E, tabEndd, Function.update_apply, hSP, aL]
    by_cases j2 : j = 1
    · subst j2; simp +decide [s2, s, E1, E, tabEndd, Function.update_apply]
    by_cases j3 : j = 2
    · subst j3; simp +decide [s2, s, E1, E, tabEndd, Function.update_apply]
    by_cases j4 : j = 4
    · subst j4; simp +decide [s2, s, E1, E, tabEndd, Function.update_apply]
    by_cases j5 : j = 14
    · subst j5; simp +decide [s2, s, E1, E, tabEndd, Function.update_apply]
    by_cases j6 : j = sNQ
    · subst j6; simp +decide [s2, s, E1, E, tabEndd, Function.update_apply]
    simp [s2, s, E1, E, tabEndd, Function.update_apply, j0, j1, j2, j3, j4, j5, j6]
  · unfold cRotU; omega

end NLogN.KFUU.R6Crt

end

theorem solution : type_of% @NLogN.KFUU.R6Crt.rotDU_runs_sol_aux := @NLogN.KFUU.R6Crt.rotDU_runs_sol_aux
