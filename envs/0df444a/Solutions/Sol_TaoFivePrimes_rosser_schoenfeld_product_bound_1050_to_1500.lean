/-! ### Finisher (B form) -/
lemma rs_finish (x c s A Q : ℝ) (hs0 : 0 < s) (hc0 : 0 ≤ c) (hx0 : 0 < x)
    (hsq : Real.sqrt x ≤ s) (hc : c ≤ Real.log x)
    (hA : A ≤ Real.exp Real.eulerMascheroniConstant)
    (hQ : Q < A * (c + 2 / s)) :
    Q < Real.exp Real.eulerMascheroniConstant * Real.log x +
      2 * Real.exp Real.eulerMascheroniConstant / Real.sqrt x := by
  have hsx : 0 < Real.sqrt x := Real.sqrt_pos.2 hx0
  have h2p : (0 : ℝ) < 2 / s := div_pos (by norm_num) hs0
  have h2s : 2 / s ≤ 2 / Real.sqrt x := by
    rw [div_le_div_iff₀ hs0 hsx]
    nlinarith [hsq]
  have hcs : c + 2 / s ≤ Real.log x + 2 / Real.sqrt x := by linarith
  have hcs0 : 0 ≤ c + 2 / s := by linarith
  have hA0 : (0 : ℝ) ≤ Real.exp Real.eulerMascheroniConstant := by positivity
  have h1 : A * (c + 2 / s) ≤
      Real.exp Real.eulerMascheroniConstant * Real.log x +
      2 * Real.exp Real.eulerMascheroniConstant / Real.sqrt x := by
    calc A * (c + 2 / s) ≤
        Real.exp Real.eulerMascheroniConstant * (c + 2 / s) :=
        mul_le_mul_of_nonneg_right hA hcs0
    _ ≤ Real.exp Real.eulerMascheroniConstant *
        (Real.log x + 2 / Real.sqrt x) :=
        mul_le_mul_of_nonneg_left hcs hA0
    _ = Real.exp Real.eulerMascheroniConstant * Real.log x +
        2 * Real.exp Real.eulerMascheroniConstant / Real.sqrt x := by ring
  linarith

/-! ### Per-checkpoint assembly (B form) -/
lemma rs_assemble (k : ℕ) (hk : k < 64) (x : ℝ) (hx0 : 0 < x)
    (hlo : ((rsPtab k : ℕ) : ℝ) ≤ x) (hhi : x < ((rsHiIvl k : ℕ) : ℝ)) :
    ∏ p ∈ Nat.primesLE (rsPtab k), (p : ℝ) / ((p : ℝ) - 1) <
      Real.exp Real.eulerMascheroniConstant * Real.log x +
      2 * Real.exp Real.eulerMascheroniConstant / Real.sqrt x := by
  have h0 : rsPnum k * (10 ^ 12 * rsSqu k) <
      1781071 * (rsClo k * rsSqu k + 2 * 10 ^ 12) * rsPden k := by
    interval_cases k <;> decide
  have h0R : ((rsPnum k : ℕ) : ℝ) * (10 ^ 12 * ((rsSqu k : ℕ) : ℝ)) <
      (1781071 : ℝ) * (((rsClo k : ℕ) : ℝ) * ((rsSqu k : ℕ) : ℝ) + 2 * 10 ^ 12) *
        ((rsPden k : ℕ) : ℝ) := by
    exact_mod_cast h0
  have hcr : (0 : ℝ) < ((rsClo k : ℕ) : ℝ) := by
    have h2 : (0 : ℕ) < rsClo k := by
      have h1 : 10 ^ 6 ≤ rsClo k := rs_clo_pos k hk
      omega
    exact_mod_cast h2
  have hpd0 : (0 : ℝ) < ((rsPden k : ℕ) : ℝ) := by
    have h2 : (0 : ℕ) < rsPden k := by
      have h1 : (1 : ℕ) ≤ rsPden k := rs_pden_pos k hk
      omega
    exact_mod_cast h2
  have hsn0 : (0 : ℝ) < ((rsSqu k : ℕ) : ℝ) / 10 ^ 6 := by
    have h2 : (0 : ℕ) < rsSqu k := (rs_sqhi k hk).2
    exact div_pos (by exact_mod_cast h2) (by norm_num)
  have hD12 : (0 : ℝ) < 10 ^ 12 := by norm_num
  have hsn0R : (0 : ℝ) < ((rsSqu k : ℕ) : ℝ) := by
    exact_mod_cast (rs_sqhi k hk).2
  have hdiv : (0 : ℝ) < 10 ^ 12 * ((rsSqu k : ℕ) : ℝ) := mul_pos hD12 hsn0R
  rw [rs_prod_id k hk]
  have hck : ((rsPnum k : ℕ) : ℝ) / ((rsPden k : ℕ) : ℝ) <
      (1781071 : ℝ) / 10 ^ 6 *
        (((rsClo k : ℕ) : ℝ) / 10 ^ 6 + 2 / (((rsSqu k : ℕ) : ℝ) / 10 ^ 6)) := by
    rw [div_lt_iff₀ hpd0]
    have hZexpr : (1781071 : ℝ) / 10 ^ 6 *
          (((rsClo k : ℕ) : ℝ) / 10 ^ 6 + 2 / (((rsSqu k : ℕ) : ℝ) / 10 ^ 6)) =
        1781071 * (((rsClo k : ℕ) : ℝ) * ((rsSqu k : ℕ) : ℝ) + 2 * 10 ^ 12) /
          (10 ^ 12 * ((rsSqu k : ℕ) : ℝ)) := by
      field_simp
    have hmul : (1781071 : ℝ) *
          (((rsClo k : ℕ) : ℝ) * ((rsSqu k : ℕ) : ℝ) + 2 * 10 ^ 12) /
          (10 ^ 12 * ((rsSqu k : ℕ) : ℝ)) * ((rsPden k : ℕ) : ℝ) =
        1781071 * (((rsClo k : ℕ) : ℝ) * ((rsSqu k : ℕ) : ℝ) + 2 * 10 ^ 12) *
          ((rsPden k : ℕ) : ℝ) / (10 ^ 12 * ((rsSqu k : ℕ) : ℝ)) := by
      field_simp
    rw [hZexpr, hmul, lt_div_iff₀ hdiv]
    exact h0R
  have hlg : Real.log ((rsPtab k : ℕ) : ℝ) ≤ Real.log x := by
    refine Real.log_le_log ?_ hlo
    have h2 : (0 : ℕ) < rsPtab k := Nat.Prime.pos (rs_tab_prime k hk)
    exact_mod_cast h2
  have hcL : ((rsClo k : ℕ) : ℝ) / 10 ^ 6 < Real.log x := by
    rw [div_lt_iff₀ (by norm_num : (0 : ℝ) < 10 ^ 6)]
    have h1 := rs_loglo_all k hk
    have h2 : Real.log ((rsPtab k : ℕ) : ℝ) * 10 ^ 6 ≤ Real.log x * 10 ^ 6 :=
      mul_le_mul_of_nonneg_right hlg (by norm_num : (0 : ℝ) ≤ 10 ^ 6)
    linarith
  have hsq : Real.sqrt x ≤ ((rsSqu k : ℕ) : ℝ) / 10 ^ 6 := by
    have hs1 : Real.sqrt x < Real.sqrt ((rsHiIvl k : ℕ) : ℝ) :=
      Real.sqrt_lt_sqrt hx0.le hhi
    have hs2 : Real.sqrt ((rsHiIvl k : ℕ) : ℝ) ≤ ((rsSqu k : ℕ) : ℝ) / 10 ^ 6 := by
      rw [Real.sqrt_le_iff]
      refine ⟨by positivity, ?_⟩
      have hsq2 : (((rsSqu k : ℕ) : ℝ) / 10 ^ 6) ^ 2 =
          ((rsSqu k : ℕ) : ℝ) ^ 2 / 10 ^ 12 := by
        rw [div_pow]
        norm_num
      rw [hsq2, le_div_iff₀ hD12]
      exact_mod_cast (rs_sqhi k hk).1
    exact le_trans hs1.le hs2
  have hc0 : (0 : ℝ) ≤ ((rsClo k : ℕ) : ℝ) / 10 ^ 6 :=
    div_nonneg hcr.le (by norm_num)
  exact rs_finish x (((rsClo k : ℕ) : ℝ) / 10 ^ 6) (((rsSqu k : ℕ) : ℝ) / 10 ^ 6)
    ((1781071 : ℝ) / 10 ^ 6) _ hsn0 hc0 hx0 hsq hcL.le rs_exp_gamma_ge hck


/-! ### Main theorem: dispatch over the largest prime ≤ ⌊x⌋₊ -/
theorem solution (x : ℝ) (hx : 1050 ≤ x) (hx' : x ≤ 1500) :
    ∏ p ∈ Nat.primesLE ⌊x⌋₊, (p : ℝ) / ((p : ℝ) - 1) <
      Real.exp Real.eulerMascheroniConstant * Real.log x +
        2 * Real.exp Real.eulerMascheroniConstant / Real.sqrt x := by
  have hx0 : 0 < x := by linarith
  have hnx : (⌊x⌋₊ : ℝ) ≤ x := Nat.floor_le hx0.le
  have hnlo : 1050 ≤ ⌊x⌋₊ := Nat.le_floor hx
  have hn1500 : ⌊x⌋₊ ≤ 1500 := by
    have h1 : (⌊x⌋₊ : ℝ) ≤ 1500 := le_trans hnx hx'
    have h2 : ⌊x⌋₊ ≤ 1500 := by exact_mod_cast h1
    omega
  have hne : (Nat.primesLE ⌊x⌋₊).Nonempty := by
    refine ⟨2, ?_⟩
    exact Nat.mem_primesLE.mpr ⟨by omega, Nat.prime_two⟩
  set q := (Nat.primesLE ⌊x⌋₊).max' hne with hqdef
  have hqmem : q ∈ Nat.primesLE ⌊x⌋₊ := Finset.max'_mem _ hne
  have hqpr : q.Prime := (Nat.mem_primesLE.mp hqmem).2
  have hqle : q ≤ ⌊x⌋₊ := (Nat.mem_primesLE.mp hqmem).1
  have h1049mem : 1049 ∈ Nat.primesLE ⌊x⌋₊ :=
    Nat.mem_primesLE.mpr ⟨by omega, by decide⟩
  have hq1049 : 1049 ≤ q := Finset.le_max' _ _ h1049mem
  have hqhi : q ≤ 1499 := by
    rcases Nat.lt_or_ge q 1500 with h | h
    · omega
    · have hq1500 : q = 1500 := by omega
      rw [hq1500] at hqpr
      exact absurd hqpr rs_no_prime_1500
  obtain ⟨k, hklt, hktab⟩ := rs_prime_in_table q (le_trans (by decide : 1049 ≤ 1049) hq1049) hqhi hqpr
  have hsub : Nat.primesLE ⌊x⌋₊ = Nat.primesLE q := by
    refine subset_antisymm ?_ ?_
    · intro p hp
      exact Nat.mem_primesLE.mpr
        ⟨Finset.le_max' _ _ hp, (Nat.mem_primesLE.mp hp).2⟩
    · intro p hp
      exact Nat.primesLE_mono hqle hp
  rw [hsub, ← hktab]
  refine rs_assemble k hklt x hx0 ?_ ?_
  · rw [hktab]
    exact le_trans (Nat.cast_le.mpr hqle) hnx
  · rcases Nat.lt_or_ge k (64 - 1) with hklast | hkge
    · by_contra hcon
      have hx1 : ((rsHiIvl k : ℕ) : ℝ) ≤ x := le_of_not_gt hcon
      have hxp : rsPtab (k + 1) ≤ ⌊x⌋₊ :=
        Nat.le_floor (by rw [rs_hii_next k (by omega)]; exact hx1)
      have hpm : rsPtab (k + 1) ∈ Nat.primesLE ⌊x⌋₊ :=
        Nat.mem_primesLE.mpr ⟨hxp, rs_tab_prime (k + 1) (by omega)⟩
      have hqge : rsPtab (k + 1) ≤ q := Finset.le_max' _ _ hpm
      have hbad := rs_tab_mono k (by omega)
      rw [← hktab] at hqge
      omega
    · have hkl : k = 64 - 1 := by omega
      subst hkl
      rw [rs_hii_last]
      exact lt_of_le_of_lt hx' (by norm_num : (1500 : ℝ) < 1501)

end TaoFivePrimes

open TaoFivePrimes

/-- Root re-export for the verification harness. -/
theorem solution (x : ℝ) (hx : 1050 ≤ x) (hx' : x ≤ 1500) :
    ∏ p ∈ Nat.primesLE ⌊x⌋₊, (p : ℝ) / ((p : ℝ) - 1) <
      Real.exp Real.eulerMascheroniConstant * Real.log x +
        2 * Real.exp Real.eulerMascheroniConstant / Real.sqrt x :=
  TaoFivePrimes.solution x hx hx'

#print axioms solution

