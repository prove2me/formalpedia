variable {k : Type} [CommRing k] {d : ℕ}

theorem GlobalTheory.ChartTrans.dof_eq (F : Fin d → PS k 2 d) (hF : ∀ i, constantCoeff (F i) = 0)
    (hu : ∀ i, ev (n := 1) ![pt k (n := 1) d 0, 0] (F i) = (X ((0 : Fin 1), i) : PS k 1 d))
    (u : Fin d → k) (g : PS k 1 d) :
    Dof F u g = ∑ i, C (u i) *
      ev (n := 1) ![pt k (n := 1) d 0, 0] (pderiv k ((1 : Fin 2), i) (ev (n := 2) ![F] g)) := by sorry
