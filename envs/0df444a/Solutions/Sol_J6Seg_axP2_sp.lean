section steps
variable {σ : Fin 19 → Fin HS} {dS dA : Fin HS} (hW : SwOK σ dS dA)
  (s : IState HS) (F : Fin HS → List ℤ) (z ds : List ℤ) (v : Fin 19 → List ℤ) (B : ℕ)
include hW

theorem popR_sp (i : Fin 19) (x : ℤ) (l : List ℤ) (hvi : v i = x :: l) (hz : zsz x ≤ B) :
    Sp (.pop (σ i)) (encK s (SS σ dS F z ds v)) (encK s (SS σ dS F z ds (update v i l)))
      (2 * B + 2) := by
  have S := Sp.pop s (SS σ dS F z ds v) (i := σ i) (a := x) (l := l) (B := B) (hW.lt i)
    (by rw [SS_at hW, hvi]) hz
  rwa [SS_v hW] at S

theorem asgQ_sp (i : Fin 19) (a : ℤ) (hvi : v i = [a]) (ha : zsz a ≤ B) (e : Ex HS) (x : ℤ)
    (hc : e.Clean) (hok : e.ok (encK s (SS σ dS F z ds v)))
    (hB : e.Bnd (encK s (SS σ dS F z ds v)) B) (hx : e.eval (encK s (SS σ dS F z ds v)) = x) :
    Sp (.asg (σ i) e) (encK s (SS σ dS F z ds v)) (encK s (SS σ dS F z ds (update v i [x])))
      ((e.size + 1) * 10 ^ 7 * (B + 2) ^ 2) := by
  have S := Sp.asgQ s (SS σ dS F z ds v) (i := σ i) (e := e) (a := a) (l := []) (B := B)
    (hW.lt i) (by rw [SS_at hW, hvi]) ha hc hok hB
  rwa [hx, SS_v hW] at S

end steps

/-! ## Value facts -/

theorem zle_of {B : ℕ} {x M : ℕ} (hM : zsz (M : ℤ) ≤ B) (h : x ≤ M) : zsz (x : ℤ) ≤ B :=
  le_trans (zsz_nat_le h) hM

end J6Seg

