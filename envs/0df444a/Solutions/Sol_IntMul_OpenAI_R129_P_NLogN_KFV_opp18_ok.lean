variable (D ℓ K : ℕ) (long : Fin D → Bool)

lemma length_chunk (i : Fin D) {j : ℕ} (hj : j < Synth.qq ℓ K) : (Synth.chunk D ℓ K i j).length = K := by
  unfold Synth.chunk
  rw [List.length_take, List.length_drop, Synth.length_restA]
  have : j * K + K ≤ Synth.qq ℓ K * K := by nlinarith
  omega

lemma length_axisMajor : (axisMajor D ℓ K).length = D * Synth.qq ℓ K := by
  simp [axisMajor, List.length_flatMap, List.sum_replicate]

lemma getD_flatten_uniform {α : Type*} (d : α) {K : ℕ} :
    ∀ (L : List (List α)), (∀ c ∈ L, c.length = K) → ∀ u m, m < K →
      L.flatten.getD (u * K + m) d = (L.getD u []).getD m d
  | [], _, u, m, _ => by simp
  | c :: L, hL, u, m, hm => by
    have hc := hL c (by simp)
    rw [List.flatten_cons]
    rcases u with _ | u
    · simp only [zero_mul, zero_add, List.getD_cons_zero]
      rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by omega),
        ← List.getD_eq_getElem?_getD]
    · rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by rw [hc]; nlinarith),
        ← List.getD_eq_getElem?_getD, hc, show (u + 1) * K + m - K = u * K + m by
          rw [Nat.succ_mul]; omega, getD_flatten_uniform d L (fun c' h' => hL c' (by simp [h']))
          u m hm]
      simp

lemma length_initL (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    (initL D ℓ long).length = (lstL D ℓ K long).length + D * Synth.qq ℓ K * K := by
  have h1 := (List.filter_append_perm (fun x => decide (x ∈ lstL D ℓ K long)) (initL D ℓ long)).length_eq
  have h2 : ((initL D ℓ long).filter fun x => decide (x ∈ lstL D ℓ K long)).length =
      (lstL D ℓ K long).length := by
    apply List.Perm.length_eq
    rw [List.perm_ext_iff_of_nodup ((initL_nodup D ℓ long).filter _) (lstL_nodup D ℓ K long)]
    intro x; simp only [List.mem_filter, decide_eq_true_eq]
    exact ⟨fun h => h.2, fun h => ⟨lstL_sub_initL D ℓ K long hℓ x h, h⟩⟩
  have h3 := initL_filter D ℓ K long hK hℓ
  rw [List.length_append, h2] at h1
  rw [← h1]
  have : ((initL D ℓ long).filter fun x => !decide (x ∈ lstL D ℓ K long)) =
      (initL D ℓ long).filter (· ∉ lstL D ℓ K long) := by
    apply List.filter_congr; intro x _; simp
  rw [this, h3, length_flatten_uniform (K := K) _ (fun c hc => by
    obtain ⟨i, j, hj, rfl⟩ := (mem_axisMajor D ℓ K).1 hc; exact Synth.length_chunk D ℓ K i hj),
    length_axisMajor]

end Synth

