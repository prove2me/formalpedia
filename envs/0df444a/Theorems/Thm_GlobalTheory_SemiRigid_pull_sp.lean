theorem GlobalTheory.SemiRigid.pull_sp {A C : CommRingCat.{0}} (ψ : A ⟶ C) {s : Spec A ⟶ S} {s' : Spec C ⟶ S}
    (h : Spec.map ψ ≫ s = s') {Y : Type} [AddCommGroup Y] (g : Over.mk s ⟶ splitTorus S Y)
    (u : Γ((splitTorus S Y).left, ⊤)) : pull (sp ψ h ≫ g) u = ψ.hom (pull g u) := by sorry
