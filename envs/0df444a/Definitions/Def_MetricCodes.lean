  have hx : 0 ≤ quadraticCoordinate u := by
    unfold quadraticCoordinate
    positivity
  have hrad : 0 ≤ 1 + 4 * c * quadraticCoordinate u := by positivity
  have hsquare := Real.sq_sqrt hrad
  have hsqrt := Real.sqrt_nonneg (1 + 4 * c * quadraticCoordinate u)
  unfold scaleCoordinate
  nlinarith [mul_nonneg hc hx]
theorem quadraticCoordinate_scaleCoordinate {c u : ℝ}
    (hc : 0 ≤ c) (hu : 0 ≤ u) :
    quadraticCoordinate (scaleCoordinate c u) =
