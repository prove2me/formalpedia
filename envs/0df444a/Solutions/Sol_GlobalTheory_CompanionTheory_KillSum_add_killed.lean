    congr 1
    apply Multiset.map_congr rfl
    intro a _
    simp only [map_add]
    ring
  choose q hq using key
  rw [Multiset.map_bind, Multiset.prod_bind]
  simp only [Multiset.map_map, Function.comp_def]
