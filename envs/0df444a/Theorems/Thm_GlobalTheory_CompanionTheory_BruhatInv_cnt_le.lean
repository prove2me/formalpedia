theorem GlobalTheory.CompanionTheory.BruhatInv.cnt_le {s s' : ℕ} (b : ι → Fin s) (b' : ι → Fin s') (σ τ : Equiv.Perm ι)
    (h : ∃ β ∈ parab K b', ∃ α ∈ parab K b, pm K τ = β * pm K σ * α) (a a' : ℕ) :
    cnt b b' τ a a' ≤ cnt b b' σ a a' := by sorry
