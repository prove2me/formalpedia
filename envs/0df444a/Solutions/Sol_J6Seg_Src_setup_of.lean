-- Source module: Solutions.J6SegILSrc15
/-!
# B-line IL, source-table producers, part 15: the register file; pass 1 and pass 7 bodies

* `regOut F cs pre post n' K1 K2`: `F` with the slab register file pushed (`rC, rNC, rNB, rM, rTOT,
  rK1, rK2`); `regOut_RF`: on `RF v c` with empty registers it is `RF v (extend ρS (slabV …) c)`.
* `body1`: `2^(Q-p-1)` on `46` (`pw2P`), `selP 22 23 46 23`, `ctlPh 23 23`, `cntP 3 4 23`, pop `46`.
  Input registers (as left by `parP`): `1 = p`, `3 = pre`, `4 = post`, `20 = Q`, `22 = s`, `23 = t`.
* `body7`: `outP 1 22 23 25 23`, `ctlPh 23 23`, `cntP 3 4 23`, `2^(Q-p)` on `41`, `2^p` on `42`
  (`25 = α`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (srcTab flatC ctlB ctlCost)
open J6Seg.PJ (rg RF RF_in RF_out upd_RF_out)
open J6Seg.Ax (ρS slabV)

theorem regOut_ext (c : Fin HS → List ℤ) (cs : List (ℤ × ℤ)) (pre post n' : ℕ) (K1 K2 : List ℤ)
    (hc : ∀ i, c (ρS i) = []) :
    regOut c cs pre post n' K1 K2 = extend ρS (slabV cs pre post n' K1 K2) c := by
  have h45 : c 45 = [] := hc 0
  have h39 : c 39 = [] := hc 1
  have h38 : c 38 = [] := hc 2
  have h37 : c 37 = [] := hc 3
  have h40 : c 40 = [] := hc 4
  have h41 : c 41 = [] := hc 5
  have h42 : c 42 = [] := hc 6
  funext j
  by_cases hj : ∃ i, ρS i = j
  · obtain ⟨i, rfl⟩ := hj
    rw [J6Seg.Ax.extS]
    fin_cases i <;> simp [regOut, slabV, ρS, update_apply, h45, h39, h38, h37, h40, h41, h42,
      J6Seg.Slab.rC, J6Seg.Slab.rM, J6Seg.Slab.rNC, J6Seg.Slab.rNB, J6Seg.Slab.rTOT, J6Seg.Slab.rK1,
      J6Seg.Slab.rK2]
  · push_neg at hj
    rw [J6Seg.Ax.extS_out hj]
    have n0 : j ≠ 45 := fun h => hj 0 h.symm
    have n1 : j ≠ 39 := fun h => hj 1 h.symm
    have n2 : j ≠ 38 := fun h => hj 2 h.symm
    have n3 : j ≠ 37 := fun h => hj 3 h.symm
    have n4 : j ≠ 40 := fun h => hj 4 h.symm
    have n5 : j ≠ 41 := fun h => hj 5 h.symm
    have n6 : j ≠ 42 := fun h => hj 6 h.symm
    simp only [regOut, update_of_ne n0, update_of_ne n1, update_of_ne n2, update_of_ne n3,
      update_of_ne n4, update_of_ne n5, update_of_ne n6]

theorem regOut_RF (v : Fin HS → ℤ) (c : Fin HS → List ℤ) (cs : List (ℤ × ℤ)) (pre post n' : ℕ)
    (K1 K2 : List ℤ) (hc : ∀ i, c (ρS i) = []) :
    regOut (RF v c) cs pre post n' K1 K2 = RF v (extend ρS (slabV cs pre post n' K1 K2) c) := by
  rw [← regOut_ext c cs pre post n' K1 K2 hc]
  simp only [regOut, RF_out (show (45 : Fin HS) ∉ rg by decide),
    RF_out (show (38 : Fin HS) ∉ rg by decide), RF_out (show (37 : Fin HS) ∉ rg by decide),
    RF_out (show (39 : Fin HS) ∉ rg by decide), RF_out (show (40 : Fin HS) ∉ rg by decide),
    RF_out (show (41 : Fin HS) ∉ rg by decide), RF_out (show (42 : Fin HS) ∉ rg by decide),
    upd_RF_out (show (45 : Fin HS) ∉ rg by decide),
    upd_RF_out (show (38 : Fin HS) ∉ rg by decide), upd_RF_out (show (37 : Fin HS) ∉ rg by decide),
    upd_RF_out (show (39 : Fin HS) ∉ rg by decide), upd_RF_out (show (40 : Fin HS) ∉ rg by decide),
    upd_RF_out (show (41 : Fin HS) ∉ rg by decide), upd_RF_out (show (42 : Fin HS) ∉ rg by decide)]

/-! ## Pass 1 -/

/-! ## Pass 7 -/

end J6Seg.Src

