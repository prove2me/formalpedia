open Module IsDiscreteValuationRing
open GlobalTheory
variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable {V : Type*} [AddCommGroup V] [Module R V] {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem GlobalTheory.relLength_span_eq_addVal_det {A : Submodule R V} (b : Basis ι R A) (v : ι → A) :
    relLength A (Submodule.span R (Set.range fun i => (v i : V))) = addVal R (b.det v) := by sorry
