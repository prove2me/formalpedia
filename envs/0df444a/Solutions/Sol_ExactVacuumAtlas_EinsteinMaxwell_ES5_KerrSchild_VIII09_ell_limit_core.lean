theorem solution (j : ℝ) {R : ℝ} (hR : 3 < R) :
    Tendsto (fun ε : ℝ =>
        (ellFun (fE j ε) (mE j ε) (N0 3 1) (wE j ε) (pE j ε) (aE j ε) R + 2 * ε * j) / ε ^ 3)
      (𝓝[≠] (0:ℝ)) (𝓝 (ellE3 j R)) := by
  have hnum : ContinuousAt (fun ε : ℝ => ellE3 j R + ε ^ 2 * (ellE5 j R + ε ^ 2 * (ellE7 j R
      + ε ^ 2 * (ellE9 j R + ε ^ 2 * ellE11 j R)))) 0 := by
    have h0 : ContinuousAt (fun ε : ℝ => ε ^ 2 * ellE11 j R) 0 :=
      (continuousAt_id.pow 2).mul continuousAt_const
    have h1 : ContinuousAt (fun ε : ℝ => ellE9 j R + ε ^ 2 * ellE11 j R) 0 :=
      continuousAt_const.add h0
    have h2 : ContinuousAt (fun ε : ℝ => ε ^ 2 * (ellE9 j R + ε ^ 2 * ellE11 j R)) 0 :=
      (continuousAt_id.pow 2).mul h1
    have h3 : ContinuousAt (fun ε : ℝ => ellE7 j R + ε ^ 2 * (ellE9 j R + ε ^ 2 * ellE11 j R)) 0 :=
      continuousAt_const.add h2
    have h4 : ContinuousAt (fun ε : ℝ => ε ^ 2 * (ellE7 j R + ε ^ 2 * (ellE9 j R + ε ^ 2 * ellE11 j R))) 0 :=
      (continuousAt_id.pow 2).mul h3
    have h5 : ContinuousAt (fun ε : ℝ => ellE5 j R + ε ^ 2 * (ellE7 j R
        + ε ^ 2 * (ellE9 j R + ε ^ 2 * ellE11 j R))) 0 := continuousAt_const.add h4
    have h6 : ContinuousAt (fun ε : ℝ => ε ^ 2 * (ellE5 j R + ε ^ 2 * (ellE7 j R
        + ε ^ 2 * (ellE9 j R + ε ^ 2 * ellE11 j R)))) 0 := (continuousAt_id.pow 2).mul h5
    exact continuousAt_const.add h6
  have hden : ContinuousAt (fun ε : ℝ => (1 + ε ^ 2 * uA j R) * (1 + ε ^ 2 * zA j R)) 0 := by
    have h0 : ContinuousAt (fun ε : ℝ => ε ^ 2 * uA j R) 0 :=
      (continuousAt_id.pow 2).mul continuousAt_const
    have h1 : ContinuousAt (fun ε : ℝ => ε ^ 2 * zA j R) 0 :=
      (continuousAt_id.pow 2).mul continuousAt_const
    exact (continuousAt_const.add h0).mul (continuousAt_const.add h1)
  have hne : (1 + (0:ℝ) ^ 2 * uA j R) * (1 + (0:ℝ) ^ 2 * zA j R) ≠ 0 := by norm_num
  have hdiv : ContinuousAt (fun ε : ℝ => (ellE3 j R + ε ^ 2 * (ellE5 j R + ε ^ 2 * (ellE7 j R
      + ε ^ 2 * (ellE9 j R + ε ^ 2 * ellE11 j R))))
      / ((1 + ε ^ 2 * uA j R) * (1 + ε ^ 2 * zA j R))) 0 := by
    convert hnum.div hden hne using 1
    funext x
    simp [Pi.div_apply]
  have hval : (ellE3 j R + (0:ℝ) ^ 2 * (ellE5 j R + (0:ℝ) ^ 2 * (ellE7 j R
      + (0:ℝ) ^ 2 * (ellE9 j R + (0:ℝ) ^ 2 * ellE11 j R))))
      / ((1 + (0:ℝ) ^ 2 * uA j R) * (1 + (0:ℝ) ^ 2 * zA j R)) = ellE3 j R := by
    norm_num
  have ht : Tendsto (fun ε : ℝ => (ellE3 j R + ε ^ 2 * (ellE5 j R + ε ^ 2 * (ellE7 j R
      + ε ^ 2 * (ellE9 j R + ε ^ 2 * ellE11 j R))))
      / ((1 + ε ^ 2 * uA j R) * (1 + ε ^ 2 * zA j R))) (𝓝[≠] (0:ℝ)) (𝓝 (ellE3 j R)) := by
    have h0 : (𝓝[≠] (0:ℝ)) ≤ 𝓝 (0:ℝ) := nhdsWithin_le_nhds
    have h1 := hdiv.tendsto.mono_left h0
    rwa [hval] at h1
  exact ht.congr' (ell_div_cube j hR).symm
