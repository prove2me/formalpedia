open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Kerr
open ExactVacuumAtlas
open ExactVacuumAtlas.Kerr
open ExactVacuumAtlas.Kerr.R3
set_option maxHeartbeats 4000000
variable (M a : ℝ)
theorem solution {r : ℝ} (hr : r ∈ radDom M a) : HasDerivAt (K M a) (1 / Delta M a r) r := by
  unfold K
  rcases lt_trichotomy 0 (M ^ 2 - a ^ 2) with hpos | hzero | hneg
  · simp only [if_pos hpos]
    exact hasDerivAt_Ktwo M a (Real.sqrt_pos.mpr hpos) (Real.sq_sqrt hpos.le) hr
  · have h1 : ¬ 0 < M ^ 2 - a ^ 2 := by rw [← hzero]; exact lt_irrefl 0
    have h2 : ¬ M ^ 2 - a ^ 2 < 0 := by rw [← hzero]; exact lt_irrefl 0
    simp only [if_neg h1, if_neg h2]
    exact hasDerivAt_Kdbl M a (by linarith) hr
  · have h1 : ¬ 0 < M ^ 2 - a ^ 2 := not_lt.mpr hneg.le
    simp only [if_neg h1, if_pos hneg]
    have hpos' : 0 < a ^ 2 - M ^ 2 := by linarith
    exact hasDerivAt_Karc M a (Real.sqrt_pos.mpr hpos') (Real.sq_sqrt hpos'.le) r
