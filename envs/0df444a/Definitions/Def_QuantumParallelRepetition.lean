              (fun ω : ExactOutcome X Y A B n => ω.1)
              (strategyEventLaw (G.repeat n) S).weight xs =
            @groupedMass
              (ExactOutcome X Y A B n) inferInstance
              (Fin n → X)
              (fun a b => Classical.propDecidable (a = b))
              (fun ω : ExactOutcome X Y A B n => ω.1)
              (strategyEventLaw (G.repeat n) S).weight xs := by
