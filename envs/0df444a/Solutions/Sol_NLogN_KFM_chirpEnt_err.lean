theorem solution {d : ℕ} (P : ℕ) (s t : Fin d → ℕ) [∀ i, NeZero (t i)]
    (hst : ∀ i, s i ≤ t i) (T : ℕ) (hT : ∀ i, t i ≤ T)
    (hu : d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ P ≤ 1) (j : (i : Fin d) → ZMod (t i)) :
    ‖NLogN.KFM.vP P (NLogN.KFM.chirpEnt P s t j) - IntMul.OpenAI.RC.chirp s t j‖ ≤
      d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ P := by
  have hu0 : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ P := by positivity
  have key : ∀ i, ‖NLogN.KFM.vP P ((NLogN.KFM.axTab P (s i) (t i)).getD (j i).val 0) -
      IntMul.OpenAI.RC.gch (s i) (t i) (j i)‖ ≤ 4 * (T : ℝ) ^ 2 * (2 : ℝ)⁻¹ ^ P := by
    intro i
    have ht : 0 < t i := Nat.pos_of_ne_zero (NeZero.ne _)
    have hk : (j i).val < t i := ZMod.val_lt _
    have hd : (1 : ℝ) ≤ d := by
      have := i.2; exact_mod_cast (show 1 ≤ d by omega)
    have hTt : (t i : ℝ) ≤ T := by exact_mod_cast hT i
    have ht0 : (0 : ℝ) ≤ t i := by positivity
    have hsq : (t i : ℝ) ^ 2 ≤ (T : ℝ) ^ 2 := by gcongr
    have hu' : (4 * (t i : ℝ) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ P ≤ 1 := by
      refine le_trans ?_ hu
      have : (4 * (t i : ℝ) ^ 2 + 1) ≤ d * (8 * (T : ℝ) ^ 2 + 2) := by nlinarith
      exact mul_le_mul_of_nonneg_right this hu0
    rw [List.getD_eq_getElem _ _ (by rw [NLogN.KFM.length_axTab]; exact hk)]
    refine (NLogN.KFM.axTab_err P (s i) (t i) (hst i) ht hu' _ hk).trans ?_
    gcongr
  have hX : ∀ i, ‖IntMul.OpenAI.RC.gch (s i) (t i) (j i)‖ ≤ 1 := fun i =>
    NLogN.KFM.norm_exp_phase (-(Real.pi * s i * ((j i).val : ℝ) ^ 2 / t i)) _ (by
      push_cast; ring)
  have h := NLogN.KFM.prodF_err P (by positivity) d _ _ hX key (by
    refine le_trans (le_of_eq ?_) hu; ring)
  refine h.trans (le_of_eq ?_)
