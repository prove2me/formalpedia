  have hdec : decode sh' j = φ a := by
    have : j = encode sh' (φ a) := by rw [henc a ha, hadef, encode_decode h1]
    rw [this, decode_encode (hval a ha)]
  rw [getElem_selOp, getElem_selOp, hdec]
  symm
  refine Fintype.sum_equiv (e.arrowCongr (Equiv.refl (Fin 2))).symm _ _ (fun y' => ?_)
  set y := (e.arrowCongr (Equiv.refl (Fin 2))).symm y' with hy
  have hy' : y' = y ∘ e.symm := by
    funext i'; simp [hy, Equiv.arrowCongr]
  rw [hy']
  congr 1
  · simp only [Butterfly.tens, tensF]
    rw [← Fintype.prod_equiv e (fun i => A (Sb.bits a i) (y i))]
    · intro i; simp [hbits a ha i]
  · rw [hset a ha y, henc _ (Sb.valid_set a y ha)]

