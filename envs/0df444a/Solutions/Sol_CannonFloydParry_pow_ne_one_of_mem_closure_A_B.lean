import Theorems.Thm_CannonFloydParry_exists_biInvariant_linearOrder
import Mathlib

/-! CFP p. 248: the subgroup of `V₁` generated by `A` and `B` is torsion-free, because it maps
injectively to `F ⊆ V` (Theorem 3.4), and `F` is torsion-free (Theorem 4.11). -/

namespace CannonFloydParry.TorsionAB

open Equiv

/-- A group with a bi-invariant linear order is torsion-free. -/
lemma eq_one_of_pow_eq_one {G : Type*} [Group G] (l : LinearOrder G)
    (hl : ∀ a b c : G, l.le a b → l.le (c * a) (c * b) ∧ l.le (a * c) (b * c))
    {y : G} {k : ℕ} (hk : 0 < k) (hy : y ^ k = 1) : y = 1 := by
  let := l
  have up : 1 ≤ y → ∀ n : ℕ, y ≤ y ^ (n + 1) := by
    intro h n
    induction n with
    | zero => simp
    | succ n ih =>
      have := (hl 1 (y ^ (n + 1)) y (le_trans h ih)).2
      rw [one_mul, ← pow_succ] at this
      exact this
  have down : y ≤ 1 → ∀ n : ℕ, y ^ (n + 1) ≤ y := by
    intro h n
    induction n with
    | zero => simp
    | succ n ih =>
      have := (hl (y ^ (n + 1)) 1 y (le_trans ih h)).2
      rw [one_mul, ← pow_succ] at this
      exact this
  obtain ⟨n, rfl⟩ : ∃ n, k = n + 1 := ⟨k - 1, by omega⟩
  rcases le_total 1 y with h | h
  · exact le_antisymm (hy ▸ up h n) h
  · exact le_antisymm h (hy ▸ down h n)

/-- `F₁ → V₁`, `A ↦ A`, `B ↦ B`: the two relators of `F₁` are the first two of `V₁`. -/
def embAB : FormalAB → FormalV
  | FormalAB.A => FormalV.A
  | FormalAB.B => FormalV.B

lemma rels_lift (r : FreeGroup FormalAB) (hr : r ∈ relsF1) :
    FreeGroup.lift (fun s => (PresentedGroup.of (embAB s) : V1)) r = 1 := by
  have h1 := PresentedGroup.one_of_mem (rels := relsV1)
    (x := (FreeGroup.of FormalV.A * (FreeGroup.of FormalV.B)⁻¹) * wordX 2 *
      (FreeGroup.of FormalV.A * (FreeGroup.of FormalV.B)⁻¹)⁻¹ * (wordX 2)⁻¹) (by simp [relsV1])
  have h2 := PresentedGroup.one_of_mem (rels := relsV1)
    (x := (FreeGroup.of FormalV.A * (FreeGroup.of FormalV.B)⁻¹) * wordX 3 *
      (FreeGroup.of FormalV.A * (FreeGroup.of FormalV.B)⁻¹)⁻¹ * (wordX 3)⁻¹) (by simp [relsV1])
  simp only [wordX, map_mul, map_inv, map_pow, pow_one] at h1 h2
  simp only [relsF1, Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl
  · simp only [map_mul, map_inv, FreeGroup.lift_apply_of, embAB]
    exact h1
  · simp only [map_mul, map_inv, map_pow, FreeGroup.lift_apply_of, embAB, inv_pow]
    exact h2

/-- The homomorphism `F₁ → V₁` onto `⟨A, B⟩`. -/
def beta : F1 →* V1 := PresentedGroup.toGroup rels_lift

lemma beta_range : beta.range =
    Subgroup.closure {PresentedGroup.of FormalV.A, PresentedGroup.of FormalV.B} := by
  rw [MonoidHom.range_eq_map, ← PresentedGroup.closure_range_of, MonoidHom.map_closure,
    ← Set.range_comp]
  congr 1
  ext g
  constructor
  · rintro ⟨s, rfl⟩
    cases s <;> simp [beta, PresentedGroup.toGroup.of, embAB]
  · rintro (rfl | rfl)
    · exact ⟨FormalAB.A, by simp [beta, PresentedGroup.toGroup.of, embAB]⟩
    · exact ⟨FormalAB.B, by simp [beta, PresentedGroup.toGroup.of, embAB]⟩

lemma icoPerm_mul (f g : UI ≃o UI) : icoPerm (f * g) = icoPerm f * icoPerm g := by
  ext x; rfl

lemma toCircle_mul (f g : UI ≃o UI) : toCircle (f * g) = toCircle f * toCircle g := by
  ext x
  simp only [toCircle, Equiv.Perm.coe_mul, Function.comp_apply, Equiv.trans_apply,
    Equiv.apply_symm_apply, icoPerm_mul]

lemma toCircle_one : toCircle 1 = 1 := by
  ext x
  simp only [toCircle, Equiv.trans_apply, Equiv.Perm.coe_one, id]
  have : icoPerm (1 : UI ≃o UI) = 1 := by ext y; rfl
  rw [this, Equiv.Perm.coe_one, id, Equiv.symm_apply_apply]

/-- `toCircle` as a group homomorphism. -/
noncomputable def toCircleHom : (UI ≃o UI) →* Perm UnitAddCircle where
  toFun := toCircle
  map_one' := toCircle_one
  map_mul' := toCircle_mul

lemma toCircle_eq_one {f : UI ≃o UI} (h : toCircle f = 1) : f = 1 := by
  have hico : icoPerm f = 1 := by
    ext x
    have := congrArg (fun g : Perm UnitAddCircle =>
      (AddCircle.equivIco (1 : ℝ) 0 (g ((AddCircle.equivIco (1 : ℝ) 0).symm x)) : ℝ)) h
    simpa only [toCircle, Perm.coe_one, id, Equiv.trans_apply, Equiv.apply_symm_apply] using this
  ext x
  rcases eq_or_lt_of_le x.2.2 with hx | hx
  · have : x = ⟨1, one_mem_UI⟩ := Subtype.ext hx
    subst this
    rw [orderIso_one]; rfl
  · have := congrArg (fun p : Set.Ico (0 : ℝ) (0 + 1) => (p : ℝ))
      (congrFun (congrArg DFunLike.coe hico) ⟨x, x.2.1, by simpa using hx⟩)
    exact this

end CannonFloydParry.TorsionAB

open CannonFloydParry in
theorem solution {g : V1}
    (hg : g ∈ Subgroup.closure {PresentedGroup.of FormalV.A, PresentedGroup.of FormalV.B})
    (h1 : g ≠ 1) (k : ℕ) (hk : 0 < k) : g ^ k ≠ 1 := by
  open TorsionAB in
  obtain ⟨φ, -, hφ⟩ := exists_surjective_V1_V
  obtain ⟨e, heA, heB⟩ := exists_mulEquiv_F1_F
  obtain ⟨l, hl⟩ := exists_biInvariant_linearOrder
  have hcomm : (V.subtype.comp φ).comp beta =
      (toCircleHom.comp F.subtype).comp e.toMonoidHom := by
    refine PresentedGroup.ext fun s => ?_
    cases s
    · simp [beta, PresentedGroup.toGroup.of, embAB, hφ, symV, toCircleHom, heA]
    · simp [beta, PresentedGroup.toGroup.of, embAB, hφ, symV, toCircleHom, heB]
  rw [← beta_range] at hg
  obtain ⟨x, rfl⟩ := hg
  intro hpow
  apply h1
  have h2 : toCircle ((e x ^ k : F) : UI ≃o UI) = 1 := by
    have := congrArg (V.subtype.comp φ) hpow
    rw [← map_pow, ← MonoidHom.comp_apply, hcomm, map_one] at this
    simpa [toCircleHom] using this
  have h3 : e x ^ k = 1 := Subtype.ext (toCircle_eq_one h2)
  have h4 : x = 1 := e.injective ((eq_one_of_pow_eq_one l hl hk h3).trans e.map_one.symm)
  rw [h4, map_one]
