    · exact (tendsto_betaratio_zero hqc.continuousOn).mono_left
        (nhdsWithin_mono 0 (Ioc_subset_Ioi_self : Ioc (0:ℝ) (1/4) ⊆ Ioi 0))
  · exact (continuousAt_betaratio_pos hqc h0 hx.2).continuousWithinAt

theorem continuousOn_hfun {j : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
