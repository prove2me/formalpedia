theorem GlobalTheory.FieldRestrictionTest.isPullF_iff (σ : TF (R := R) F ⟶ T) (g : GtPt D T) (g' : GtPtF D F) :
    GtPt.IsPullF F σ.left g g' ↔ g'.b = σ ≫ g.b ∧
      ∀ χ y J, Good D.P.L y J → val (g'.s χ) (𝟙 _) y J = val (g.s χ) σ.left y J := by sorry
