theorem solution {xs : List TypeDensity.Expr} (h : ∀ z ∈ xs, z.wf) :
    (TypeDensity.Expr.sum xs).rational = (xs.map TypeDensity.Expr.rational).sum := by
  induction xs with
  | nil => simpa [TypeDensity.Expr.sum] using TypeDensity.Expr.rational_const 0
  | cons a t ih =>
    have ht : ∀ z ∈ t, z.wf := fun z hz ↦ h z (by simp [hz])
    change (TypeDensity.Expr.add a (TypeDensity.Expr.sum t)).rational = _
    rw [TypeDensity.Expr.rational_add (h a (by simp)) (TypeDensity.Expr.wf_sum ht), ih ht]; simp
