/-! ## Locally Representable Sections -/

/-- A section is **locally representable** if at each prime, it agrees with a constant
section on some open neighborhood. This is the sheaf condition that prevents the
representation from being tautological. -/
def IsLocallyRepresentable (f : StalkProduct P) : Prop :=
  ∀ p : PrimeConSpec P, ∃ (a : P) (U : Set (PrimeConSpec P)),
    IsOpen U ∧ p ∈ U ∧ ∀ q ∈ U, f q = q.con.toQuotient a

/-- Constant sections are locally representable. -/
theorem isLocallyRepresentable_toStalkProduct (a : P) :
    IsLocallyRepresentable (toStalkProduct P a) :=
  fun p => ⟨a, Set.univ, isOpen_univ, Set.mem_univ p, fun _ _ => rfl⟩

/-! ## Basis Global Sections as a Subsemiring -/

/-- The **subsemiring of locally representable sections** in the stalk product. -/
noncomputable def basisGlobalSectionsSubsemiring : Subsemiring (StalkProduct P) where
  carrier := { f | IsLocallyRepresentable f }
  mul_mem' {f g} hf hg := by
    intro p
    obtain ⟨a, U, hUo, hpU, ha⟩ := hf p
    obtain ⟨b, V, hVo, hpV, hb⟩ := hg p
    exact ⟨a * b, U ∩ V, hUo.inter hVo, ⟨hpU, hpV⟩, fun q ⟨hqU, hqV⟩ => by
      show f q * g q = q.con.toQuotient (a * b); rw [ha q hqU, hb q hqV]; rfl⟩
  one_mem' := fun p => ⟨1, Set.univ, isOpen_univ, Set.mem_univ p, fun _ _ => rfl⟩
  add_mem' {f g} hf hg := by
    intro p
    obtain ⟨a, U, hUo, hpU, ha⟩ := hf p
    obtain ⟨b, V, hVo, hpV, hb⟩ := hg p
    exact ⟨a + b, U ∩ V, hUo.inter hVo, ⟨hpU, hpV⟩, fun q ⟨hqU, hqV⟩ => by
      show f q + g q = q.con.toQuotient (a + b); rw [ha q hqU, hb q hqV]; rfl⟩
  zero_mem' := fun p => ⟨0, Set.univ, isOpen_univ, Set.mem_univ p, fun _ _ => rfl⟩

/-- The type of basis global sections. -/
def BasisGlobalSections (P : Type u) [CommSemiring P] : Type u :=
  basisGlobalSectionsSubsemiring (P := P)

noncomputable instance : CommSemiring (BasisGlobalSections P) :=
  Subsemiring.toCommSemiring basisGlobalSectionsSubsemiring

/-- The canonical map `P →+* BasisGlobalSections P`. -/
noncomputable def toBasisGlobalSections (P : Type u) [CommSemiring P] :
    P →+* BasisGlobalSections P :=
  (toStalkProduct P).codRestrict basisGlobalSectionsSubsemiring
    (fun a => isLocallyRepresentable_toStalkProduct a)

