variable {P : Type*} [CStarAlgebra P] {q : P} {hq : IsStarProjection q}

theorem haarCornerLetter_mul_star_self (z : unitary (CStarCorner q hq))
    {a : ℝ} (ha : 0 ≤ a) (n : ℕ) :
