    · have hm1 : h * (1000 * (n + 1 + NLogN.zsz (h : ℤ) + 3)) ≤ 2000 * (h * (n + 3)) :=
        calc h * (1000 * (n + 1 + NLogN.zsz (h : ℤ) + 3)) ≤ h * (2000 * (n + 3)) :=
