      toCfg S hk P (some q') (T.write (fix S.st T.read w)) := by
  have h' : P.δ q (fun i => T.cells i (T.head i)) = some (q', w) := h
  simp only [MultitapeTM.step, toCfg, IntMul.Mach.compile, h', Tapes.write]
