/-!
# Kernel-checked pair coverage of the literal checkpoint graphs

Circulant masks are checked once per nonzero displacement. For Paley 2659,
this file supplies a square witness for either sign of every nonzero residue.
Lean checks every witness using ordinary reduction, and the general checker
soundness proof converts the certificate into the actual existential arc.
-/

namespace SensitivityRankMapCheckpoint

open SensitivityRankedConstruction

set_option maxRecDepth 32768
set_option maxHeartbeats 2000000







 def verifySquareWitnesses (start : ℕ) : List ℕ → Bool
  | [] => true
  | z :: rest => decide (z < 2659 ∧ z ≠ 0 ∧
      ((z * z) % 2659 = start ∨ (z * z) % 2659 = 2659 - start)) &&
      verifySquareWitnesses (start + 1) rest



