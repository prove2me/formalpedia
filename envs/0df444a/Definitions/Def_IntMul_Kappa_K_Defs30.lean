-- Source module: Solutions.KFV31LayOps
/-!
# KFV §34: the layout moves in the closed forms the IL loops generate

* `genOps1`: `genOps` with a single (possibly trivial) move `mv c (c + |T| δ)` per triple
  (`|T| ≤ 1`); **`applyN_genOps1`**: same arrangement (`mv c c` is the identity);
  **`genOps1_eq`**: closed form by prefix sums.
* `ops1` (one move per axis, `rank`/`flag` closed forms), `ops2` (one move per `k < b D`),
  `ops3 = xchOps …` and **`applyN_lay3`**: `applyN (ops1 ++ ops2 ++ ops3) initL = tgtL`.
* `iterL_runArr`: a loop applying `runArr (g k)` in iteration `k` is `runArr` of the
  concatenation.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open Synth AModel AModelL12

/-! ## Single-move passes -/

def tL (x : List ℕ × List ℕ × List ℕ) : ℕ := x.2.1.length

def uvL (x : List ℕ × List ℕ × List ℕ) : ℕ := x.1.length + x.2.2.length

/-- One move per triple. -/
def genOps1 : ℕ → ℕ → List (List ℕ × List ℕ × List ℕ) → List LOp
  | _, _, [] => []
  | c, d, (U, T, V) :: xs =>
    LOp.mv c (c + T.length * (d + U.length)) :: genOps1 (c + T.length) (d + U.length + V.length) xs

/-! ## Ranges -/

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

/-- The flag of axis `k` as a number. -/
def fbk (k : ℕ) : ℕ := if h : k < D then (if long ⟨k, h⟩ then 1 else 0) else 0

/-- The number of long axes before `k`. -/
def rkS (k : ℕ) : ℕ := ((List.range k).map (fbk D long)).sum

/-- Phase 1 in closed form. -/
def ops1 : List LOp :=
  (List.range D).map fun k => LOp.mv (rkS D long k) (rkS D long k + fbk D long k * (k * (ℓ - 1)))

/-- The `δ` of the move `k` of phase 2. -/
def dl2 (k : ℕ) : ℕ := k % D * (qq ℓ K * K + (bb ℓ K - 1 - k / D)) + qq ℓ K * K

/-- Phase 2 in closed form. -/
def ops2 : List LOp :=
  (List.range (bb ℓ K * D)).map fun k =>
    LOp.mv (nLong D long + k) (nLong D long + k + dl2 D ℓ K k)

/-- Phase 3. -/
def ops3 : List LOp := xchOps (srcT D (qq ℓ K)) (D * qq ℓ K) K (lstL D ℓ K long)

end Paper

/-! ## Loops of primitives -/

end NLogN.KFV

end

section
-- Source module: Solutions.KFV32LayLoop1
/-!
# KFV §35: phase 1 of the layout (the tops of the long axes) as a fixed IL loop

The long-axis flags are the bits of the mask register `gMk` (`mkOf`). Iteration `k < D` of a
unary loop moves the bit at position `rank + flag·k(ℓ-1)` to position `rank` (`mvB`), then
`rank += flag`, `k += 1` (registers `gRk`, `gI`).  **`ph1_ok`**: the loop computes
`runArr n 0 (ops1 …)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## The mask -/

/-- Bits `b_0, b_1, …` as the number `Σ b_i 2^i`. -/
def mkOf : List Bool → ℕ
  | [] => 0
  | b :: bs => (if b then 1 else 0) + 2 * mkOf bs

/-! ## Registers -/

abbrev gMk : Fin HS := 53

/-- `r` holds `v` on top. -/
def RT (s : IState HS) (r : Fin HS) (v : ℤ) : Prop := ∃ L, s.G r = .int v :: L

/-- The layout registers on a base state. -/
structure LRg (s : IState HS) (L : LP) (mk W : ℕ) : Prop where
  d : RT s NLogN.KFV.gD L.D
  l : RT s gLl L.ℓ
  k : RT s gKk L.K
  b : RT s gBb L.b
  q : RT s gQq L.q
  nl : RT s gNL L.nL
  st : RT s gLst L.Lst
  n : RT s gNn L.n
  m : RT s gMk mk
  w : RT s gWw W

def lRegs : List (Fin HS) := [NLogN.KFV.gD, gLl, gKk, gBb, gQq, gNL, gLst, gNn, gMk, gWw]

/-- The loop frame stacks of the layout loops. -/
abbrev fA : Fin HS := tbQ
abbrev fC : Fin HS := tbN
abbrev fD : Fin HS := tbM

/-! ## The code of phase 1 -/

/-- The flag of axis `k = gI`. -/
def eFl : Ex HS := .nmod (.ndiv (.reg gMk) (.pow2 (.reg NLogN.KFV.gI))) (.lit 2)

def eA1 : Ex HS := .reg gRk

def eF1 : Ex HS := .mul eFl (.mul (.reg NLogN.KFV.gI) (.add (.reg gLl) (.lit (-1))))

/-- `n - c - δ + ℓ`. -/
def eCm (eA eF : Ex HS) : Ex HS := .add (.add (.reg gNn) (.neg eA)) (.add (.neg eF) (.reg gLl))

def up1 : RS := .seq (.asg gRk (.add (.reg gRk) eFl)) (.asg NLogN.KFV.gI (.add (.reg NLogN.KFV.gI) (.lit 1)))

def body1 : IStmt HS Pp := .seq (mvB eA1 eF1 (eCm eA1 eF1)) (fcode up1)

def ph1 : IStmt HS Pp :=
  .seq (fcode (.seq (.push NLogN.KFV.gI (.lit 0)) (.push gRk (.lit 0))))
    (.seq (KFT.rptX NLogN.KFV.gD fA NLogN.KFV.fC fD body1) (fcode (.seq (.pop gRk) (.pop NLogN.KFV.gI))))

/-! ## The loop body -/

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

/-- The loop frame of phase 1 at iteration `k`. -/
def F1 (k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (fun _ => []) NLogN.KFV.gI [(k : ℤ)]) gRk [(rkS D long k : ℤ)]

/-- The move of iteration `k`. -/
def op1 (k : ℕ) : LOp :=
  LOp.mv (rkS D long k) (rkS D long k + fbk D long k * (k * (ℓ - 1)))

/-- The record array after phase 1's iteration `k`. -/
noncomputable def cBody1 (n W B : ℕ) (k : ℕ) : ℕ :=
  cMvB eA1 eF1 (eCm eA1 eF1) (rkS D long k) (fbk D long k * (k * (ℓ - 1)))
    (n - (rkS D long k + fbk D long k * (k * (ℓ - 1))) + ℓ) W B +
    ((((Ex.reg gRk).add eFl).size + 1) * 10 ^ 7 * (B + 2) ^ 2 +
      (((Ex.reg NLogN.KFV.gI).add (Ex.lit 1)).size + 1) * 10 ^ 7 * (B + 2) ^ 2)

/-- Cost of phase 1. -/
noncomputable def cPh1 (n W B : ℕ) : ℕ :=
  2 * (2 * 10 ^ 7 * (B + 2) ^ 2) +
    ((∑ k ∈ Finset.range D, (cBody1 D ℓ long n W B k + 64)) + 60 + cRpt D +
      (dupCost (zsz (D : ℤ)) + 17)) + 2 * (2 * B + 2)

end Paper

end NLogN.KFV

end

section
-- Source module: Solutions.KFV46KronStage
/-!
# KFV §49: the Kronecker stage with its parameters (`kronS`)

`kronS pM = kPushS ; kronU pM ; kPopS`. From the registers `p` (`gPp`), `ℓ` (`gLl`) and `n`
(`gNn`) of the base, `kPushS` pushes the record-product parameters of `kronU` (`b = 2p + ℓ + 3`,
`r = 2^ℓ`, `ρ = ℓ`) on `50 … 55`, `N = 2^n` on `vRH`, `2 N r` on `vT` and `0` on `vZ`; `kPopS`
removes them. **`kronS_runs`**: on `N` records `zf` over `zg` (both disk records at scale
`2^p`), the stage leaves `kmulN r p ℓ N zf zg`, which stores `zipWith (ppq r p) xf xg`
(again disk records, `p + 1`-bit).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KIL KFD KFT KFB KFC KFH RS

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The digit width of the Kronecker products. -/
def kb (p ℓ : ℕ) : ℕ := 2 * p + ℓ + 3

def eKb : Ex HS := .add (.add (.reg gPp) (.reg gPp)) (.add (.reg gLl) (.lit 3))

def eKG : Ex HS :=
  .ndiv (.mul (.pow2 (.reg gPp)) (.add (.pow2 (.mul eKb (.pow2 (.reg gLl)))) (.lit (-1))))
    (.add (.pow2 eKb) (.lit (-1)))

def eKJ : Ex HS := .pow2 (.mul eKb (.add (.pow2 (.reg gLl)) (.pow2 (.reg gLl))))

def eKT : Ex HS := .pow2 (.add (.add (.reg gNn) (.reg gLl)) (.lit 1))

/-- The parameter pushes. -/
def kPushS : RS :=
  .seq (.push kc (.pow2 (.reg gPp))) <|
  .seq (.push kr (.pow2 (.reg gLl))) <|
  .seq (.push kK eKG) <|
  .seq (.push kB (.pow2 eKb)) <|
  .seq (.push kJ eKJ) <|
  .seq (.push kD (.pow2 (.add (.reg gPp) (.reg gLl)))) <|
  .seq (.push vRH (.pow2 (.reg gNn))) <|
  .seq (.push NLogN.KFV.vT eKT) <|
  .push vZ (.lit 0)

/-- The parameter pops. -/
def kPopS : RS :=
  .seq (.pop vZ) <| .seq (.pop NLogN.KFV.vT) <| .seq (.pop vRH) <| .seq (.pop kD) <| .seq (.pop kJ) <|
  .seq (.pop kB) <| .seq (.pop kK) <| .seq (.pop kr) (.pop kc)

/-- The Kronecker stage. -/
def kronS (pM : Fin Pp) : IStmt HS Pp := .seq (fcode kPushS) (.seq (kronU pM) (fcode kPopS))

/-- The parameter frame. -/
def fK (p ℓ n : ℕ) (j : Fin HS) : List ℤ :=
  if j = kc then [(2 : ℤ) ^ p]
  else if j = kr then [((2 ^ ℓ : ℕ) : ℤ)]
  else if j = kK then [kG (NLogN.KFV.kb p ℓ) (2 ^ ℓ) ((2 : ℤ) ^ p)]
  else if j = kB then [(2 : ℤ) ^ NLogN.KFV.kb p ℓ]
  else if j = kJ then [((2 : ℤ) ^ NLogN.KFV.kb p ℓ) ^ (2 * 2 ^ ℓ)]
  else if j = kD then [(2 : ℤ) ^ (p + ℓ)]
  else if j = vRH then [((2 ^ n : ℕ) : ℤ)]
  else if j = NLogN.KFV.vT then [((2 * (2 ^ n * 2 ^ ℓ) : ℕ) : ℤ)]
  else if j = vZ then [0]
  else []

/-! ## Arithmetic -/

/-! ## Records -/

/-! ## The stage -/

/-- Cost of the Kronecker stage. -/
def cKronS (p ℓ n BK φ : ℕ) : ℕ :=
  100 * 10 ^ 7 * (BK + 2) ^ 2 + (cKron (2 ^ n) (2 ^ ℓ) p (NLogN.KFV.kb p ℓ) ℓ φ + 9 * (2 * BK + 2))

end NLogN.KFV

