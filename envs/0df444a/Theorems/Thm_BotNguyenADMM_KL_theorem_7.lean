-- title:
--   Theorem 7 — F_k decreases, converges to F_* ∈ ℝ, and the increments of the iterates tend to 0
-- statement:
--   Suppose Assumption 1 holds and $\{(x^k,z^k,y^k)\}_{k\ge0}$, generated by Algorithm 1 or Algorithm 2, is bounded. Let $F_k=F_r(x^k,z^k,y^k,x^{k-1},y^{k-1})$ for $k\ge1$. Then:
--   1. for every $k\ge1$,
--   $$F_{k+1}+\tfrac{C_1}4\|x^{k+1}-x^k\|^2+\tfrac12\|z^{k+1}-z^k\|^2_{M_2^k}\le F_k;$$
--   2. $\{F_k\}_{k\ge1}$ is bounded from below and convergent, and $x^{k+1}-x^k\to0$, $z^{k+1}-z^k\to0$, $y^{k+1}-y^k\to0$;
--   3. $\{F_k\}$, $\{L_r(x^k,z^k,y^k)\}$ and $\{h(x^k)+g(z^k)\}$ have the same limit $F_*\in\mathbb R$.
--
--   This is the first convergence result of the paper: $F_r$ is a Lyapunov function for both algorithms.
--
--   **Formalization Note** The paper writes $\{F_k\}_{k\ge0}$ although $F_k$ is defined for $k\ge1$; the lower bound is stated for $k\ge1$, and limits do not depend on the value at $k=0$. The inequality in (i) is stated in `EReal` without subtraction; the common limit is a real number.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, pp. 15–16, Theorem 7, (50)–(51)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_BotNguyenADMM_KL_Setting
open NonconvexSplitting.Shared BotNguyenADMM.KL
open Filter Topology
open scoped RealInnerProductSpace

namespace BotNguyenADMM.KL

/-- Theorem 7 (pp. 15–16). Under Assumption 1, let `{(xᵏ, zᵏ, yᵏ)}` be a bounded sequence
generated by Algorithm 1 or Algorithm 2, and `F_k = F_r(xᵏ, zᵏ, yᵏ, xᵏ⁻¹, yᵏ⁻¹)` (47). Then
(i) for every `k ≥ 1`, (50): `F_{k+1} + (C₁/4)‖xᵏ⁺¹ − xᵏ‖² + ½‖zᵏ⁺¹ − zᵏ‖²_{M₂ᵏ} ≤ F_k`;
(ii) `{F_k}_{k≥1}` is bounded from below and convergent, and (51) `xᵏ⁺¹ − xᵏ → 0`,
`zᵏ⁺¹ − zᵏ → 0`, `yᵏ⁺¹ − yᵏ → 0`;
(iii) `{F_k}`, `{L_r(xᵏ, zᵏ, yᵏ)}` and `{h(xᵏ) + g(zᵏ)}` have the same limit `F_* ∈ ℝ`. -/
theorem theorem_7 {n m : ℕ} (v : Variant) (P : Data n m) (hA : Assumption1 v P)
    (x : ℕ → E n) (z y : ℕ → E m) (hrun : IsRun v P x z y)
    (hbdd : Bornology.IsBounded (Set.range fun k => pack3 (x k) (z k) (y k))) :
    (∀ k, 1 ≤ k →
      Fseq v P x z y (k + 1)
          + ((C1 v P / 4 * ‖x (k + 1) - x k‖ ^ 2
            + 1 / 2 * ⟪P.M₂ k (z (k + 1) - z k), z (k + 1) - z k⟫ : ℝ) : EReal)
        ≤ Fseq v P x z y k) ∧
    (∃ c : ℝ, ∀ k, 1 ≤ k → (c : EReal) ≤ Fseq v P x z y k) ∧
    Tendsto (fun k => x (k + 1) - x k) atTop (𝓝 0) ∧
    Tendsto (fun k => z (k + 1) - z k) atTop (𝓝 0) ∧
    Tendsto (fun k => y (k + 1) - y k) atTop (𝓝 0) ∧
    ∃ Fstar : ℝ,
      Tendsto (Fseq v P x z y) atTop (𝓝 (Fstar : EReal)) ∧
      Tendsto (fun k => Lr P (x k) (z k) (y k)) atTop (𝓝 (Fstar : EReal)) ∧
      Tendsto (fun k => P.g (z k) + (P.h (x k) : EReal)) atTop (𝓝 (Fstar : EReal)) := by sorry

end BotNguyenADMM.KL
