-- title:
--   The canonical filtration $\{\mathcal B_t\}$ on $W(G)$
-- statement:
--   $\mathcal B_t$ is the $\sigma$-algebra on $W(G)$ generated by the projections $g_r$, $0\le r\le t$. This is the filtration for which $g$ is a Brownian motion on $G$.
-- source:
--   Albeverio, Driver, Gordina, Vershik, Equivalence of the Brownian and energy representations, arXiv:1511.07378v1, Theorem 2.4, p.4

import Mathlib
import Definitions.Def_BrownianEnergyRep_WienerGroup

set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter Set
open scoped ENNReal NNReal Topology ContDiff RealInnerProductSpace

namespace BrownianEnergyRep

/-- The canonical σ-algebra `𝓑_s` of the paths up to time `s` (arXiv:1511.07378v1, Theorem 2.4, p.4). -/
@[instance_reducible] noncomputable def canonicalPast {n : ℕ} (G : Subgroup (GL (Fin n) ℝ))
    (T : ℝ) [Fact (0 < T)] (s : ℝ) : MeasurableSpace ↥(WienerGroup G T) :=
  ⨆ r ∈ Icc 0 s, MeasurableSpace.comap (fun γ => pathAt γ r) inferInstance

/-- The filtration `{𝓑_t}` on `W(G)` (arXiv:1511.07378v1, Theorem 2.4, p.4). -/
noncomputable def canonicalFiltration {n : ℕ} (G : Subgroup (GL (Fin n) ℝ)) (T : ℝ)
    [hT : Fact (0 < T)] : Filtration (Icc (0 : ℝ) T) (wienerGroupMeasurableSpace G T) where
  seq t := canonicalPast G T t
  mono' := fun s t hst => biSup_mono fun r hr => ⟨hr.1, hr.2.trans hst⟩
  le' := fun t => iSup₂_le fun r _ => by
    have hc : Continuous fun γ : ↥(WienerGroup G T) => pathAt γ r := by
      refine Continuous.subtype_mk ?_ _
      exact (continuous_eval_const _).comp continuous_subtype_val
    exact hc.measurable.comap_le

end BrownianEnergyRep


