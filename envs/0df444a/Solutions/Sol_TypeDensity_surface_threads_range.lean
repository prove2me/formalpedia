theorem solution (R : Type) [CommRing R] (t x : R)
    [IsAdicComplete (Ideal.span {t,x}) R] (hreg : TypeDensity.RegularParameterPair R t x)
    (hregSwap : TypeDensity.RegularParameterPair R x t) (beta : TypeDensity.BlowupRestriction R t x)
    (hpres : ∀ j : ℕ, TypeDensity.cechInputLattice R t x j ≤ (TypeDensity.cechOutputLattice R t x j).comap
    (TypeDensity.fullCechDifferential R t x beta 0)) :
    LinearMap.range (TypeDensity.surfaceThreads R t x) = ⨅ j : ℕ, LinearMap.ker
      ((TypeDensity.finiteCechDifferential R t x beta 0 j (hpres j)).comp (TypeDensity.cechInputThreadLinear R t x j)) := by
  set I : Ideal R := Ideal.span {t,x}
  -- key: equal images iff difference in I^j
  have hEq : ∀ (j : ℕ) (r s : R), TypeDensity.surfaceToCechInput R t x j r = TypeDensity.surfaceToCechInput R t x j s ↔
      r - s ∈ I ^ j := by
    intro j r s
    rw [← sub_eq_zero, ← map_sub, ← LinearMap.mem_ker, TypeDensity.surface_to_cech_kernel R t x hreg j]
  have hcoord : ∀ (r : R) (j : ℕ), TypeDensity.cechInputThreadLinear R t x j (TypeDensity.surfaceThreads R t x r) =
      TypeDensity.surfaceToCechInput R t x j r := fun _ _ => rfl
  apply le_antisymm
  · rintro _ ⟨r, rfl⟩
    rw [Submodule.mem_iInf]
    intro j
    rw [LinearMap.mem_ker, LinearMap.comp_apply, hcoord]
    exact TypeDensity.surface_section_closed R t x beta j (hpres j) r
  · intro a ha
    rw [Submodule.mem_iInf] at ha
    have hr : ∀ j, ∃ r : R, TypeDensity.surfaceToCechInput R t x j r = TypeDensity.cechInputThreadLinear R t x j a := by
      intro j
      have := ha j
      rwa [LinearMap.mem_ker, LinearMap.comp_apply, ← LinearMap.mem_ker,
        ← TypeDensity.surface_to_cech_range R t x hreg hregSwap beta j (hpres j)] at this
    choose f hf using hr
    have hcompat : ∀ j, TypeDensity.cechInputReduction R t x j (TypeDensity.cechInputThreadLinear R t x (j+1) a) =
        TypeDensity.cechInputThreadLinear R t x j a :=
      fun j => (sub_eq_zero.mp (congrFun (LinearMap.mem_ker.mp a.2) j :)).symm
    have hstep : ∀ j, f (j+1) - f j ∈ I ^ j := by
      intro j
      rw [← hEq, hf j, ← hcompat j, ← hf (j+1)]
      rfl
    have hcauchy : ∀ m n, m ≤ n → f n - f m ∈ I ^ m := by
      intro m n hmn
      induction n, hmn using Nat.le_induction with
      | base => simp
      | succ n hmn ih => simpa using Submodule.add_mem _ (Ideal.pow_le_pow_right hmn (hstep n)) ih
    obtain ⟨L, hL⟩ := IsPrecomplete.prec (IsAdicComplete.toIsPrecomplete (I := I) (M := R))
      (f := f) (fun {m n} hmn => by
        rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top, ← neg_mem_iff, neg_sub]
        exact hcauchy m n hmn)
    refine ⟨L, ?_⟩
    apply Subtype.ext
    funext j
    change TypeDensity.surfaceToCechInput R t x j L = TypeDensity.cechInputThreadLinear R t x j a
    rw [← hf j, hEq]
    have := hL j
    rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top] at this
    rwa [← neg_mem_iff, neg_sub]
