variable {G : Subgroup Γ} {A : Γ → X →+ X} {g : Γ} {w : X}

theorem GlobalTheory.Cyc.Procyclic.psum_add (hg : g ∈ G) (hone : ∀ y, A 1 y = y)
    (hmul : ∀ σ ∈ G, ∀ τ ∈ G, ∀ y, A (σ * τ) y = A σ (A τ y)) (a b : ℕ) :
    psum A g w (a + b) = psum A g w a + A (g ^ a) (psum A g w b) := by sorry
