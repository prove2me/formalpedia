theorem MIPStarRE.LDT.SelfImprovement.matrixSdpCanonicalDualFeasible_isClosed
    (params : Parameters) [FieldModel params.q]
    (model : MatrixSdpRealization params) :
    IsClosed
      {Z : MatrixOperator model.space |
        ∀ g : Polynomial params,
          0 ≤ matrixSdpDualSlackOperator params model Z g} := by sorry
