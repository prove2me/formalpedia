          ‖(h (j + 1) - h j) * e j‖ := norm_add_le _ _
      _ = ‖h (j + 1)‖ * ‖e (j + 1) - e j‖ +
          ‖h (j + 1) - h j‖ * ‖e j‖ := by rw [norm_mul, norm_mul]
      _ ≤ H * ‖e (j + 1) - e j‖ +
          ‖h (j + 1) - h j‖ * ‖e j‖ := by
            gcongr
            exact hH (j + 1) hjN
