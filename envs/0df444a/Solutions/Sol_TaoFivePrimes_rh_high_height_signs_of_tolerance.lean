import Mathlib
import Definitions.Def_TaoFivePrimes_RHHighHeightBracketInterface
set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 10000
namespace RHHighTolerance
open RHHighHeightBracketData RHHighHeightBracketInterface
noncomputable def leftValue (b : Bracket) : ℝ := ((b.llo:ℝ)+b.lhi)/(2*scale)
noncomputable def rightValue (b : Bracket) : ℝ := ((b.rlo:ℝ)+b.rhi)/(2*scale)
def margin (b : Bracket) : Prop :=
  ((2^44:Int)<b.llo ∧ b.rhi< -(2^44:Int)) ∨
  (b.lhi< -(2^44:Int) ∧ (2^44:Int)<b.rlo)
def treeMargin : {l r n : Nat} → Tree l r n → Prop
  | _,_,_,Tree.leaf b => margin b
  | _,_,_,Tree.join u v _ => treeMargin u ∧ treeMargin v
lemma leaf_margin {l r n : Nat} (t : Tree l r n) (h : treeMargin t) :
    ∀ b ∈ leaves t, margin b := by
  induction t with
  | leaf b => simpa [leaves,treeMargin] using h
  | join u v hh iu iv =>
    intro b hb
    rcases List.mem_append.mp hb with hb|hb
    · exact iu h.1 b hb
    · exact iv h.2 b hb
lemma positive_mid (a b : Int) (hab : a≤b) (ha : (2^44:Int)<a) :
    (1/2^20:ℝ)<((a:ℝ)+b)/(2*scale) := by
  have hS : (0:ℝ)<scale := by norm_num [scale]
  apply (lt_div_iff₀ (by positivity : (0:ℝ)<2*scale)).mpr
  have haR : (2^44:ℝ)<(a:ℝ) := by exact_mod_cast ha
  have habR : (a:ℝ)≤(b:ℝ) := by exact_mod_cast hab
  have he : (1/2^20:ℝ)*(2*scale)=2*(2^44:ℝ) := by norm_num [scale]
  rw [he]
  linarith
lemma negative_mid (a b : Int) (hab : a≤b) (hb : b< -(2^44:Int)) :
    ((a:ℝ)+b)/(2*scale)< -(1/2^20:ℝ) := by
  have hS : (0:ℝ)<scale := by norm_num [scale]
  apply (div_lt_iff₀ (by positivity : (0:ℝ)<2*scale)).mpr
  have hbR : (b:ℝ)< -(2^44:ℝ) := by exact_mod_cast hb
  have habR : (a:ℝ)≤(b:ℝ) := by exact_mod_cast hab
  have he : -(1/2^20:ℝ)*(2*scale)= -2*(2^44:ℝ) := by norm_num [scale]
  rw [he]
  linarith
lemma signs_from_tolerance (b : Bracket) (hm : margin b) (x y : ℝ)
    (hx : |x-leftValue b|≤1/2^20) (hy : |y-rightValue b|≤1/2^20) : x*y<0 := by
  have hx' := abs_le.mp hx
  have hy' := abs_le.mp hy
  rcases hm with hm|hm
  · have hl : (1/2^20:ℝ)<leftValue b := positive_mid _ _ b.boxOrder.1 hm.1
    have hr : rightValue b< -(1/2^20:ℝ) := negative_mid _ _ b.boxOrder.2 hm.2
    exact mul_neg_of_pos_of_neg (by linarith [hx'.1]) (by linarith [hy'.2])
  · have hl : leftValue b< -(1/2^20:ℝ) := negative_mid _ _ b.boxOrder.1 hm.1
    have hr : (1/2^20:ℝ)<rightValue b := positive_mid _ _ b.boxOrder.2 hm.2
    exact mul_neg_of_neg_of_pos (by linarith [hx'.2]) (by linarith [hy'.1])
