/-- `b ≥ 2^{18} d^5`. -/
lemma b_ge_d5 {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : (2 : ℝ) ^ 18 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 5 ≤ bP n := by
  set B : ℝ := (bP n : ℝ)
  have hB : (2 : ℝ) ^ 36 ≤ B := b_ge_real hn 36 (by norm_num)
  have hB1 : 1 ≤ B := le_trans (by norm_num) hB
  have hB0 : 0 ≤ B := by linarith
  have hd5 : (IntMul.OpenAI.R129.dP n : ℝ) ^ 5 ≤ B ^ (5 * IntMul.OpenAI.R129.ε) := by
    calc (IntMul.OpenAI.R129.dP n : ℝ) ^ 5 ≤ (B ^ IntMul.OpenAI.R129.ε) ^ 5 := by
          gcongr; exact d_le_beps n
      _ = B ^ (5 * IntMul.OpenAI.R129.ε) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hB0]; congr 1; push_cast; ring
  have hsq : (2 : ℝ) ^ 18 ≤ B ^ ((1 : ℝ) / 2) := by
    rw [← sqrt_pow_two 18]
    exact Real.rpow_le_rpow (by positivity) (by simpa using hB) (by norm_num)
  have hhalf : B ^ ((1 : ℝ) / 2) ≤ B ^ (1 - 5 * IntMul.OpenAI.R129.ε) :=
    Real.rpow_le_rpow_of_exponent_le hB1 (by unfold IntMul.OpenAI.R129.ε; norm_num)
  have hsplit : B = B ^ (1 - 5 * IntMul.OpenAI.R129.ε) * B ^ (5 * IntMul.OpenAI.R129.ε) := by
    rw [← Real.rpow_add (by linarith)]; simp
  have hpos : 0 ≤ (IntMul.OpenAI.R129.dP n : ℝ) ^ 5 := by positivity
  calc (2 : ℝ) ^ 18 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 5 ≤ B ^ (1 - 5 * IntMul.OpenAI.R129.ε) * B ^ (5 * IntMul.OpenAI.R129.ε) := by
        apply mul_le_mul (hsq.trans hhalf) hd5 hpos (Real.rpow_nonneg hB0 _)
    _ = B := hsplit.symm

/-- `28 d² √b ≤ b/4`. -/
lemma gamma_room {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : 28 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * Real.sqrt (bP n) ≤ (bP n : ℝ) / 4 := by
  set B : ℝ := (bP n : ℝ)
  have hB : (2 : ℝ) ^ 36 ≤ B := b_ge_real hn 36 (by norm_num)
  have hB1 : 1 ≤ B := le_trans (by norm_num) hB
  have hB0 : 0 ≤ B := by linarith
  have hd2 : (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 ≤ B ^ (2 * IntMul.OpenAI.R129.ε) := by
    calc (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 ≤ (B ^ IntMul.OpenAI.R129.ε) ^ 2 := by gcongr; exact d_le_beps n
      _ = B ^ (2 * IntMul.OpenAI.R129.ε) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hB0]; congr 1; push_cast; ring
  -- `112 B^{2ε} √B ≤ B`
  have hq : (2 : ℝ) ^ 9 ≤ B ^ ((1 : ℝ) / 4) := by
    have : ((2 : ℝ) ^ 36) ^ ((1 : ℝ) / 4) = 2 ^ 9 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num), ← Real.rpow_natCast]
      congr 1; norm_num
    rw [← this]; exact Real.rpow_le_rpow (by positivity) hB (by norm_num)
  have hq2 : B ^ ((1 : ℝ) / 4) ≤ B ^ (1 / 2 - 2 * IntMul.OpenAI.R129.ε) :=
    Real.rpow_le_rpow_of_exponent_le hB1 (by unfold IntMul.OpenAI.R129.ε; norm_num)
  have hsplit : B = B ^ (2 * IntMul.OpenAI.R129.ε) * B ^ ((1 : ℝ) / 2) * B ^ (1 / 2 - 2 * IntMul.OpenAI.R129.ε) := by
    rw [← Real.rpow_add (by linarith), ← Real.rpow_add (by linarith)]
    rw [show 2 * IntMul.OpenAI.R129.ε + 1 / 2 + (1 / 2 - 2 * IntMul.OpenAI.R129.ε) = (1 : ℝ) by ring, Real.rpow_one]
  have hsqrt : Real.sqrt B = B ^ ((1 : ℝ) / 2) := Real.sqrt_eq_rpow B
  rw [hsqrt]
  have h1 : 0 ≤ B ^ ((1 : ℝ) / 2) := Real.rpow_nonneg hB0 _
  have h2 : 0 ≤ B ^ (2 * IntMul.OpenAI.R129.ε) := Real.rpow_nonneg hB0 _
  have h112 : (112 : ℝ) ≤ B ^ (1 / 2 - 2 * IntMul.OpenAI.R129.ε) := le_trans (by norm_num) (hq.trans hq2)
  calc 28 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * B ^ ((1 : ℝ) / 2) ≤ 28 * B ^ (2 * IntMul.OpenAI.R129.ε) * B ^ ((1 : ℝ) / 2) := by
        gcongr
    _ = (B ^ (2 * IntMul.OpenAI.R129.ε) * B ^ ((1 : ℝ) / 2) * 112) / 4 := by ring
    _ ≤ (B ^ (2 * IntMul.OpenAI.R129.ε) * B ^ ((1 : ℝ) / 2) * B ^ (1 / 2 - 2 * IntMul.OpenAI.R129.ε)) / 4 := by gcongr
    _ = B / 4 := by rw [← hsplit]

/-- **The pointwise parameter conditions of §8–9 hold for `n ≥ n₀`.** -/
theorem params_ok {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) :
    -- thresholds
    2 ≤ (bP n : ℝ) ^ IntMul.OpenAI.R129.ε ∧ 2 ≤ (IntMul.OpenAI.R129.dP n : ℝ) ^ IntMul.OpenAI.R129.c ∧ 8192 ≤ bP n ∧ 1 ≤ IntMul.OpenAI.R129.dP n ∧ IntMul.OpenAI.R129.dP n ≤ bP n ∧
    -- box exponent and volume
    bP n ≤ 2 * IntMul.OpenAI.Glue.LP n ∧ IntMul.OpenAI.Glue.LP n < bP n ∧ IntMul.OpenAI.Glue.TP n < 2 ^ bP n ∧
    24 * (n : ℝ) ≤ IntMul.OpenAI.Glue.VP n ∧ IntMul.OpenAI.Glue.VP n ≤ 48 * n ∧
    -- axis exponent, factorial bound, source lengths
    (pP n : ℝ) / (12 * IntMul.OpenAI.R129.dP n) ≤ ℓP n ∧ (ℓP n : ℝ) ≤ (pP n : ℝ) / (3 * IntMul.OpenAI.R129.dP n) ∧
    64 * IntMul.OpenAI.R129.dP n ^ 2 * (256 * IntMul.OpenAI.R129.dP n ^ 2).factorial ≤ IntMul.OpenAI.R129.rP n ∧ 2 ∣ IntMul.OpenAI.R129.rP n ∧
    -- resampling / error budget
    2 * IntMul.OpenAI.R129.dP n * pP n ^ 2 < IntMul.OpenAI.Glue.TP n * IntMul.OpenAI.Glue.LP n ∧ 12 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * bP n ≤ (αP n : ℝ) ^ 4 ∧
    γP n ≤ (bP n : ℝ) / 4 ∧
    -- the hypotheses of `kappaBound_of_table`
    (6 * (IntMul.lg n : ℝ)) ^ IntMul.OpenAI.R129.ε / 12 ≤ IntMul.OpenAI.R129.dP n ∧ (IntMul.OpenAI.R129.dP n : ℝ) ≤ (6 * (IntMul.lg n : ℝ)) ^ IntMul.OpenAI.R129.ε ∧
    (6 * (IntMul.lg n : ℝ)) ^ (IntMul.OpenAI.R129.ε * IntMul.OpenAI.R129.c) / 24 ≤ KP n ∧ (KP n : ℝ) ≤ (6 * (IntMul.lg n : ℝ)) ^ (IntMul.OpenAI.R129.ε * IntMul.OpenAI.R129.c) ∧
    (ℓP n : ℝ) ≤ 6 * (IntMul.lg n : ℝ) / (3 * IntMul.OpenAI.R129.dP n) ∧
    (αP n : ℝ) ≤ 4 * (6 * (IntMul.lg n : ℝ)) ^ (1 / 4 + IntMul.OpenAI.R129.ε / 2) := by
  obtain ⟨hT1, hT2, hLb, h2L⟩ := L_facts hn
  have hbe := two_le_beps hn
  have hdc := two_le_dc hn
  have hd1 := d_pos hn
  have hdb := d_le_b hn
  have hb8 : 8192 ≤ bP n := le_trans (by norm_num) ((b0_ge 13 (by norm_num)).trans (b_ge hn))
  have hb1 : (1 : ℝ) ≤ bP n := by exact_mod_cast bP_pos n
  -- d and K bounds
  obtain ⟨hD1, hD2⟩ := concrete_d_bounds (bP n : ℝ) hb1 hbe
  have hp1 : (1 : ℝ) ≤ 6 * bP n := by linarith
  obtain ⟨hK1, hK2⟩ := concrete_K_bounds (6 * bP n) (IntMul.OpenAI.R129.dP n) hp1 hD1 hD2 hdc
  -- ℓ bounds
  obtain ⟨hl1, hl2⟩ := RP.ell_bounds (IntMul.OpenAI.Glue.LP n) (IntMul.OpenAI.R129.dP n) (bP n) (by omega) hdb h2L hLb.le
  -- α
  have hX1 : (1 : ℝ) ≤ (12 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) := by
    apply Real.one_le_rpow _ (by norm_num)
    have : (1 : ℝ) ≤ IntMul.OpenAI.R129.dP n := by exact_mod_cast hd1
    nlinarith
  have hα := concrete_alpha_bound (bP n) (IntMul.OpenAI.R129.dP n) hb1 (Nat.cast_nonneg _) hD2 hX1
  have hα4 : 12 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * bP n ≤ (αP n : ℝ) ^ 4 := by
    have h0 : 0 ≤ 12 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * bP n := by positivity
    have hc : (12 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) ≤ αP n := Nat.le_ceil _
    have : ((12 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4)) ^ 4 = 12 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * bP n := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul h0]; norm_num
    rw [← this]; gcongr
  -- γ
  have hγ : γP n ≤ (bP n : ℝ) / 4 := by
    have hαle : (αP n : ℝ) ≤ 2 * (12 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) := by
      have := Nat.ceil_lt_add_one (show 0 ≤ (12 * (IntMul.OpenAI.R129.dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) by
        positivity)
      unfold αP; linarith
    have hd0 : (0 : ℝ) < IntMul.OpenAI.R129.dP n := by exact_mod_cast hd1
    have := RP.gamma_bound (IntMul.OpenAI.R129.dP n) (bP n) (αP n) hd0 (by linarith) (Nat.cast_nonneg _) hαle
    unfold γP; linarith [gamma_room hn]
  -- factorial bound
  have hfact : 64 * IntMul.OpenAI.R129.dP n ^ 2 * (256 * IntMul.OpenAI.R129.dP n ^ 2).factorial ≤ IntMul.OpenAI.R129.rP n := by
    refine (fact_bound (IntMul.OpenAI.R129.dP n)).trans (Nat.pow_le_pow_right (by norm_num) ?_)
    have h5 := b_ge_d5 hn
    have hd0 : (0 : ℝ) < IntMul.OpenAI.R129.dP n := by exact_mod_cast hd1
    have : ((2 ^ 17 * IntMul.OpenAI.R129.dP n ^ 4 : ℕ) : ℝ) ≤ ℓP n := by
      refine le_trans ?_ hl1
      push_cast
      rw [le_div_iff₀ (by positivity)]
      nlinarith
    exact_mod_cast this
  have hr2 : 2 ∣ IntMul.OpenAI.R129.rP n := by
    have hℓ1 : 1 ≤ ℓP n := by
      have : (1 : ℝ) ≤ ℓP n := by
        refine le_trans ?_ hl1
        rw [le_div_iff₀ (by positivity)]
        have h5 := b_ge_d5 hn
        have hd' : (1 : ℝ) ≤ IntMul.OpenAI.R129.dP n := by exact_mod_cast hd1
        have : (IntMul.OpenAI.R129.dP n : ℝ) ≤ (IntMul.OpenAI.R129.dP n : ℝ) ^ 5 := le_self_pow₀ hd' (by norm_num)
        nlinarith
      exact_mod_cast this
    exact dvd_pow_self 2 (by omega)
  -- 2 d p² < T L
  have hdp : 2 * IntMul.OpenAI.R129.dP n * pP n ^ 2 < IntMul.OpenAI.Glue.TP n * IntMul.OpenAI.Glue.LP n := by
    have hcube := cube_lt_pow (bP n) (by omega)
    have h1 : 2 * IntMul.OpenAI.R129.dP n * pP n ^ 2 ≤ 72 * bP n ^ 3 := by
      unfold pP; nlinarith
    have hgt := n_gt hn
    have hpow : 2 ^ bP n = 2 * 2 ^ (bP n - 1) := by rw [← pow_succ']; congr 1; omega
    have h2 : 2 ^ bP n < IntMul.OpenAI.Glue.TP n * IntMul.OpenAI.Glue.LP n * 2 := by nlinarith
    have h3 : 2 ^ bP n ≤ IntMul.OpenAI.Glue.TP n * IntMul.OpenAI.Glue.LP n := by
      have : IntMul.OpenAI.Glue.TP n * bP n ≤ IntMul.OpenAI.Glue.TP n * (2 * IntMul.OpenAI.Glue.LP n) := Nat.mul_le_mul_left _ h2L
      nlinarith
    omega
  -- volume
  have hV1 : 24 * (n : ℝ) ≤ IntMul.OpenAI.Glue.VP n := by
    unfold IntMul.OpenAI.Glue.VP pP; push_cast
    have : ((4 * n : ℕ) : ℝ) ≤ ((IntMul.OpenAI.Glue.TP n * bP n : ℕ) : ℝ) := by exact_mod_cast hT1
    push_cast at this; nlinarith
  have hV2 : IntMul.OpenAI.Glue.VP n ≤ 48 * n := by
    unfold IntMul.OpenAI.Glue.VP pP; push_cast
    have : ((IntMul.OpenAI.Glue.TP n * bP n : ℕ) : ℝ) ≤ ((8 * n : ℕ) : ℝ) := by exact_mod_cast hT2.le
    push_cast at this; nlinarith
  have hTlt : IntMul.OpenAI.Glue.TP n < 2 ^ bP n := Nat.pow_lt_pow_right (by norm_num) hLb
  refine ⟨hbe, hdc, hb8, hd1, hdb, h2L, hLb, hTlt, hV1, hV2, ?_, ?_, hfact, hr2, hdp, hα4, hγ,
    hD1, hD2, ?_, ?_, ?_, hα⟩
  · unfold pP; push_cast; exact hl1
  · unfold pP; push_cast; exact hl2
  · exact hK1
  · exact hK2
  · exact hl2

end

end IntMul.OpenAI.R129.P.IntMul.OpenAI.Glue

