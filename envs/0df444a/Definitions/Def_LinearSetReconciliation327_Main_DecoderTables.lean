section Expand

variable {F : Type} [Field F] [Algebra (ZMod 2) F]

/-- The sequence of field elements the expansion writes: `eSeq 0 = P_1`, `eSeq (2k) = P_{k+1}` (the
layout the read loop produced), and `eSeq (2k+1) = (eSeq k)^2` — the paper's `P_{2a} = P_a²` in
characteristic two. -/
noncomputable def eSeq {w : ℕ} (b : Module.Basis (Fin w) (ZMod 2) F) {M : ℕ} (y : Fin M → ZMod 2) :
    ℕ → F
  | 0 => payloadField b y 0
  | n + 1 => if Even (n + 1) then payloadField b y ((n + 1) / 2)
             else (eSeq b y ((n + 1) / 2)) ^ 2
termination_by n => n
decreasing_by exact Nat.div_lt_self (Nat.succ_pos n) (by norm_num)

end Expand

