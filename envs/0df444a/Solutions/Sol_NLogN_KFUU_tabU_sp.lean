namespace NLogN.KIL

open IntMul RS AModel

theorem gStage_eq_T (Q a c M : ℕ) :
    gStage Q a c M = gStageT (.lit (-(Q : ℤ))) (.lit a) (.lit c) (.lit M) (.lit ((a * M : ℕ) : ℤ)) :=
  rfl

theorem ESim.mAddT {π : PMap} {n n' x x' y y' : Ex HS} (hn : ESim π n n') (hx : ESim π x x')
    (hy : ESim π y y') : ESim π (mAddT n x y) (mAddT n' x' y') :=
  .sel (.add (.add hx hy) hn) (.add hx hy) (.add (.add hx hy) hn)

theorem RSim.mvK {π : PMap} (X Y C : Fin HS) {n n' : Ex HS} (h : ESim π n n') :
    RSim π (NLogN.mvK X Y C n) (NLogN.mvK X Y C n') :=
  .rep C h (.seq (.push Y (.reg X)) (.pop X))

theorem rsim_gStageT {π : PMap} {n n' a a' c c' M M' aM aM' : Ex HS} (hn : ESim π n n')
    (ha : ESim π a a') (hc : ESim π c c') (hM : ESim π M M') (haM : ESim π aM aM') :
    RSim π (gStageT n a c M aM) (gStageT n' a' c' M' aM') := by
  unfold gStageT gBodyT gInnerT
  exact .seq (.push _ (.lit _)) (.seq (.rep _ ha (.seq (.rep _ hM (.seq (.push _
