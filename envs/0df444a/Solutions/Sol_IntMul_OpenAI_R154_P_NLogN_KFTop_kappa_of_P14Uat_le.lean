/-- Generic: a flatMap of pieces each of length `≤ c·#p + d`. -/
theorem len_flatMap_le {α β : Type*} (p : β → Bool) (c d : ℕ) (f : α → List β) :
    ∀ l : List α, (∀ x ∈ l, (f x).length ≤ c * (f x).countP p + d) →
      (l.flatMap f).length ≤ c * (l.flatMap f).countP p + d * l.length
  | [], _ => by simp
  | a :: l, hl => by
    have ih := len_flatMap_le p c d f l fun x hx => hl x (List.mem_cons_of_mem _ hx)
    have ha := hl a List.mem_cons_self
    simp only [List.flatMap_cons, List.length_append, List.countP_append, List.length_cons]
    rw [mul_add, mul_add, mul_one]
    linarith

section Chunk

variable {R : Type} [Fintype R] [DecidableEq R] {m : ℕ}

theorem rowAddsFor_len (w : R) (h : Fin m) (js : List (Fin m)) :
    (rowAddsFor w h js).length ≤ js.length := by
  have := len_flatMap_le RStep.isChild 0 1
    (fun j => if hj : h = j then [] else [RStep.rowAdd w h j hj]) js
    (fun j _ => by split_ifs <;> simp)
  simpa [rowAddsFor] using this

theorem chunkFor_len (w : R) (ε : ℤ) (v : Fin m → ZMod 2) :
    (chunkFor w ε v).length ≤ (2 * m + 1) * (chunkFor w ε v).countP RStep.isChild + 0 := by
  by_cases hv0 : v = 0
  · have : chunkFor w ε v = [] := by
      unfold chunkFor
      rw [dif_neg]
      rintro ⟨h, hh⟩
      exact hh (by rw [hv0]; rfl)
    rw [this]; simp
  · rw [chunkFor_count w ε v hv0]
    unfold chunkFor
    split_ifs with hv
    · simp only [List.length_append, List.length_singleton]
      have h1 := rowAddsFor_len w (Classical.choose hv)
        (univ.filter fun j => v j ≠ 0).toList
      have h2 := rowAddsFor_len w (Classical.choose hv)
        (univ.filter fun j => v j ≠ 0).toList.reverse
      rw [List.length_reverse] at h2
      have h3 : (univ.filter fun j => v j ≠ 0).toList.length ≤ m := by
        rw [Finset.length_toList]
        exact (Finset.card_le_univ _).trans (by simp)
      omega
    · simp

theorem frameSteps_len (w : R) (L : List (ℤ × (Fin m → ZMod 2))) :
    (frameSteps w L).length ≤ (2 * m + 1) * (frameSteps w L).countP RStep.isChild := by
  have := len_flatMap_le RStep.isChild (2 * m + 1) 0 (fun p => chunkFor w p.1 p.2) L.reverse
    (fun x _ => chunkFor_len w x.1 x.2)
  simpa [frameSteps] using this

end Chunk

section Net

variable {R : Type} [Fintype R] [DecidableEq R] {h : ℕ}

theorem edgeSteps_len (w : R) (V U : Submodule (ZMod 2) (NetComplexP8.Vc h)) :
    (edgeSteps w V U).length ≤ (2 * h ^ 3 + 1) * (edgeSteps w V U).countP RStep.isChild + 0 := by
  rw [add_zero]; exact frameSteps_len w _

theorem netSteps_len (Mout : R → NetComplexP8.LabG h) :
    ∀ (gs : List (AModel.NGate R ℂ (NetComplexP8.LabG h))) (lab : R → NetComplexP8.LabG h),
      (netSteps gs lab Mout).length ≤
        (2 * h ^ 3 + 1) * (netSteps gs lab Mout).countP RStep.isChild + gs.length
  | [], lab => by
    have := len_flatMap_le RStep.isChild (2 * h ^ 3 + 1) 0
      (fun w => edgeSteps w (NetComplexP8.dec (Mout w)) (NetComplexP8.dec (lab w)))
      (univ : Finset R).toList (fun x _ => edgeSteps_len _ _ _)
    simpa [netSteps] using this
  | g :: gs, lab => by
    have ih := netSteps_len Mout gs (AModel.labStep lab g)
    have he := len_flatMap_le RStep.isChild (2 * h ^ 3 + 1) 0
      (fun w => edgeSteps w (NetComplexP8.dec g.2.2) (NetComplexP8.dec (lab w)))
      g.2.1.toList (fun x _ => edgeSteps_len _ _ _)
    simp only [zero_mul, add_zero] at he
    simp only [netSteps, gateSteps, List.length_append, List.countP_append, List.length_singleton,
      List.length_cons, List.countP_singleton, RStep.isChild, List.length_nil]
    simp only [cond_false, add_zero, Bool.false_eq_true, if_false]
    rw [mul_add]
    linarith

end Net

