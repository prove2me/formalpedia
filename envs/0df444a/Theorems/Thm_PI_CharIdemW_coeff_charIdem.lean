variable {G : Type} [Group G] [Fintype G]

theorem PI.CharIdemW.coeff_charIdem (V : FDRep ℂ G) (g : G) :
    (charIdem V).coeff g =
      ((Module.finrank ℂ V : ℂ) / (Fintype.card G : ℂ)) * V.character g⁻¹ := by sorry
