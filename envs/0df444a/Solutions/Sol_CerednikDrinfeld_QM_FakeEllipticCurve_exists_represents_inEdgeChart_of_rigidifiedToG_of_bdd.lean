theorem p7_etale_of_forall_existsUnique_lift {W Y : Scheme.{0}} (ξ : W ⟶ Y) [IsLocallyNoetherian Y]
    [LocallyOfFinitePresentation ξ]
    (h : ∀ (T' T : Type) [CommRing T'] [IsLocalRing T'] [IsArtinianRing T'] [IsAlgClosed (IsLocalRing.ResidueField T')]
      [CommRing T] [Nontrivial T] (p : T' →+* T), Function.Surjective p → RingHom.ker p * IsLocalRing.maximalIdeal T' = ⊥ →
      ∀ (s : Spec (CommRingCat.of T') ⟶ Y) (m : Spec (CommRingCat.of T) ⟶ W),
        m ≫ ξ = Spec.map (CommRingCat.ofHom p) ≫ s →
        ∃! m' : Spec (CommRingCat.of T') ⟶ W, m' ≫ ξ = s ∧ Spec.map (CommRingCat.ofHom p) ≫ m' = m) :
    Etale ξ := by
  apply IsZariskiLocalAtTarget.of_iSup_eq_top (P := @Etale) (fun V : Y.affineOpens => (V : Y.Opens))
    (iSup_affineOpens_eq_top Y)
  intro V
  haveI : IsNoetherianRing Γ(Y, V) := IsLocallyNoetherian.component_noetherian V
  let e := V.2.isoSpec

  rw [← MorphismProperty.cancel_right_of_respectsIso @Etale (ξ ∣_ (V : Y.Opens)) e.hom]
  haveI : LocallyOfFinitePresentation (ξ ∣_ (V : Y.Opens)) := IsZariskiLocalAtTarget.restrict ‹_› _
  haveI : LocallyOfFinitePresentation ((ξ ∣_ (V : Y.Opens)) ≫ e.hom) := inferInstance
  apply AlgebraicGeometry.Etale.of_forall_existsUnique_lift_of_isArtinianRing_of_isNoetherianRing
    (R := Γ(Y, V)) ((ξ ∣_ (V : Y.Opens)) ≫ e.hom)
  intro T' T _ _ _ _ _ _ p hp hker s m hsm

  let s' : Spec (CommRingCat.of T') ⟶ Y := s ≫ e.inv ≫ (V : Y.Opens).ι
  let m' : Spec (CommRingCat.of T) ⟶ W := m ≫ (ξ ⁻¹ᵁ (V : Y.Opens)).ι
  have hsm2 : m ≫ ξ ∣_ (V : Y.Opens) = (Spec.map (CommRingCat.ofHom p) ≫ s) ≫ e.inv := by
    rw [← hsm]; simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have hsm' : m' ≫ ξ = Spec.map (CommRingCat.ofHom p) ≫ s' := by
    show (m ≫ (ξ ⁻¹ᵁ (V : Y.Opens)).ι) ≫ ξ = Spec.map (CommRingCat.ofHom p) ≫ (s ≫ e.inv ≫ (V : Y.Opens).ι)
    rw [Category.assoc, ← morphismRestrict_ι, ← Category.assoc, hsm2]
    simp only [Category.assoc]
  obtain ⟨n, ⟨hn₁, hn₂⟩, hnu⟩ := h T' T p hp hker s' m' hsm'

  have hrange : Set.range n.base ⊆ Set.range (ξ ⁻¹ᵁ (V : Y.Opens)).ι.base := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    show ξ.base (n.base x) ∈ (V : Y.Opens)
    have h1 : ξ.base (n.base x) = (V : Y.Opens).ι.base ((s ≫ e.inv).base x) := by
      rw [← Scheme.Hom.comp_apply, hn₁]; rfl
    have h2 : (V : Y.Opens).ι.base ((s ≫ e.inv).base x) ∈ Set.range (V : Y.Opens).ι.base := ⟨_, rfl⟩
    rw [Scheme.Opens.range_ι] at h2
    rw [h1]; exact h2
  let n' : Spec (CommRingCat.of T') ⟶ (ξ ⁻¹ᵁ (V : Y.Opens) : Scheme.{0}) :=
    IsOpenImmersion.lift (ξ ⁻¹ᵁ (V : Y.Opens)).ι n hrange
  have hn' : n' ≫ (ξ ⁻¹ᵁ (V : Y.Opens)).ι = n := IsOpenImmersion.lift_fac _ _ _
  refine ⟨n', ⟨?_, ?_⟩, ?_⟩
  ·
    rw [← cancel_mono (e.inv ≫ (V : Y.Opens).ι), Category.assoc, Category.assoc, Iso.hom_inv_id_assoc,
      morphismRestrict_ι, ← Category.assoc, hn', hn₁]
  · rw [← cancel_mono (ξ ⁻¹ᵁ (V : Y.Opens)).ι, Category.assoc, hn', hn₂]
  · rintro n'' ⟨h₁, h₂⟩
    have h₁' : n'' ≫ ξ ∣_ (V : Y.Opens) = s ≫ e.inv := by
      rw [← h₁]; simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
    have : n'' ≫ (ξ ⁻¹ᵁ (V : Y.Opens)).ι = n := by
      apply hnu
      refine ⟨?_, ?_⟩
      · show (n'' ≫ (ξ ⁻¹ᵁ (V : Y.Opens)).ι) ≫ ξ = s ≫ e.inv ≫ (V : Y.Opens).ι
        rw [Category.assoc, ← morphismRestrict_ι, ← Category.assoc, h₁', Category.assoc]
      · show Spec.map (CommRingCat.ofHom p) ≫ n'' ≫ (ξ ⁻¹ᵁ (V : Y.Opens)).ι = m ≫ (ξ ⁻¹ᵁ (V : Y.Opens)).ι
        rw [← Category.assoc, h₂]
    rw [← cancel_mono (ξ ⁻¹ᵁ (V : Y.Opens)).ι, hn', this]

theorem p7_factor {C : Type} [CommRing C] (a : C) (W : Scheme.{0}) (h : W ⟶ Spec (CommRingCat.of C))
    (hpt : ∀ (R : CommRingCat.{0}) (x : Spec R ⟶ W), (Spec.preimage (x ≫ h)).hom a = 0) :
    ∃ hb : W ⟶ Spec (CommRingCat.of (C ⧸ Ideal.span ({a} : Set C))),
      hb ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({a} : Set C)))) = h := by
  classical

  let c : CommRingCat.of C ⟶ Γ(W, ⊤) := (Scheme.ΓSpecIso (CommRingCat.of C)).inv ≫ h.appTop
  have hc : h = W.toSpecΓ ≫ Spec.map c := by
    have h1 := Scheme.toSpecΓ_naturality h
    rw [← SpecMap_ΓSpecIso_hom] at h1

    have h2 : h = (W.toSpecΓ ≫ Spec.map h.appTop) ≫ Spec.map (Scheme.ΓSpecIso (CommRingCat.of C)).inv := by
      rw [← h1, Category.assoc, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
    rw [h2, Category.assoc, ← Spec.map_comp]

  have hca : c.hom a = 0 := by
    apply Scheme.zero_of_zero_cover (𝒰 := W.affineCover)
    intro i

    have hnat := Scheme.ΓSpecIso_naturality (Spec.preimage (W.affineCover.f i ≫ h))
    rw [Spec.map_preimage, Scheme.Hom.comp_appTop] at hnat
    have hpre : Spec.preimage (W.affineCover.f i ≫ h) =
        (Scheme.ΓSpecIso (CommRingCat.of C)).inv ≫ (h.appTop ≫ (W.affineCover.f i).appTop) ≫ (Scheme.ΓSpecIso _).hom :=
      (Iso.eq_inv_comp _).mpr hnat.symm
    have h0 := hpt _ (W.affineCover.f i)
    rw [hpre] at h0
    have h0' : (Scheme.ΓSpecIso _).hom ((W.affineCover.f i).appTop (c.hom a)) = 0 := by
      simp [CommRingCat.comp_apply] at h0
      exact h0
    exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso _).hom).1
      (h0'.trans (map_zero (Scheme.ΓSpecIso _).hom.hom).symm)

  have hker : ∀ x ∈ Ideal.span ({a} : Set C), c.hom x = 0 := by
    intro x hx
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    rw [map_mul, hca, mul_zero]
  let cb : C ⧸ Ideal.span ({a} : Set C) →+* Γ(W, ⊤) := Ideal.Quotient.lift _ c.hom hker
  have hcomp : CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span ({a} : Set C))) ≫ CommRingCat.ofHom cb = c := by
    apply CommRingCat.hom_ext
    ext x
    rfl
  refine ⟨W.toSpecΓ ≫ Spec.map (CommRingCat.ofHom cb), ?_⟩
