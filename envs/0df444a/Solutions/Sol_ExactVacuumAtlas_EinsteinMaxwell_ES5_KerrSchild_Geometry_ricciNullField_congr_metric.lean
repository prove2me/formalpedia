theorem solution {g g' gi gi' : Metric 5} {U : Set (Pt 5)}
    (hU : IsOpen U) (hg : ∀ i j, Set.EqOn (g i j) (g' i j) U)
    (hgi : ∀ i j, Set.EqOn (gi i j) (gi' i j) U) {K : Pt 5 → Fin 5 → ℝ}
    (hF : RicciNullPregeodesicField g gi U K) : RicciNullPregeodesicField g' gi' U K where
  smooth := hF.smooth
  ne_zero := hF.ne_zero
  null x hx := by
    rw [← hF.null x hx]
    unfold contract2
    exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun c _ => by rw [hg a c hx]
  ricci_null x hx := by
    rw [← hF.ricci_null x hx]
    unfold contract2
    exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun c _ => by
      rw [ricciOf_congr_of_eqOn hU hg hgi hx a c]
  pregeodesic x hx := (pregeodesicAt_congr_metric hU hg hgi K hx).mp (hF.pregeodesic x hx)
