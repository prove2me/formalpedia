-- Source module: Solutions.GlueParams
/-!
# Glue 3: explicit parameters `n ↦ (b, L, T, d, K, ℓ, α, p)` of §9.2 and the threshold `n₀`

For an input length `n` (§9.2.1):
* `b = lg n` (`bP`), `p = 6b` (`pP`), `d = ⌊b^ε⌋` (`dP`), `K = ⌊d^c⌋` (`KP`),
  `α = ⌈(12 d² b)^{1/4}⌉` (`αP`);
* `L` (`LP`) = the least `L` with `4n ≤ 2^L b`, `T = 2^L` (`TP`), so `4n ≤ T b < 8n`;
* `ℓ = ⌈L/d⌉` (`ℓP`, `RP.ell`), `r = 2^ℓ` (`rP`), bit volume `V = T p` (`VP`), `γ = 2dα²` (`γP`).

The threshold is `n₀ = 2^{b₀}` with `b₀ = 2^{2^{132}}` (`n0`, `b0`); for `n ≥ n₀` we have
`b ≥ b₀` (`b_ge`), and `params_ok` proves every pointwise condition used in §8–9:
`b^ε ≥ 2`, `d^c ≥ 2`, `1 ≤ d ≤ b`, `b/2 ≤ L < b`, `24n ≤ Tp ≤ 48n`, `p/(12d) ≤ ℓ ≤ p/(3d)`,
`64d²(256d²)! ≤ r`, `2 | r`, `2dp² < TL`, `b ≥ 8192`, `T < 2^b`, `12 d² b ≤ α⁴`,
`γ ≤ b/4`, the bounds of `kappaBound_of_table` on `d, K, ℓ, α`, and the existence of the
pairwise coprime odd source lengths (`RP.sources_exist`).

**`kappaBound_of_machine`**: the only hypotheses left are about the machine `M`
(correct for all `n ≥ 1`; time `≤ C₀ (V · Ncost + n)` for `n ≥ n₀` with these parameters).
-/

open Real

namespace IntMul.OpenAI.Glue

open RCost

noncomputable section

/-! ## 1. The parameter map -/

/-- `b₀ = 2^{2^{132}}`, written as the ceiling of the real number `2^{2^{132}}` (an integer)
so that the kernel never tries to evaluate the tower. -/
def b0 : ℕ := ⌈(2 : ℝ) ^ ((2 : ℝ) ^ 132)⌉₊
/-- `n₀ = 2^{b₀}`. -/
def n0 : ℕ := 2 ^ b0

/-- `b = lg n`. -/
def bP (n : ℕ) : ℕ := IntMul.lg n
/-- `p = 6b`. -/
def pP (n : ℕ) : ℕ := 6 * bP n
/-- `d = ⌊b^ε⌋`. -/
def dP (n : ℕ) : ℕ := ⌊(bP n : ℝ) ^ IntMul.OpenAI.RCost.ε⌋₊
/-- `K = ⌊d^c⌋`. -/
def KP (n : ℕ) : ℕ := ⌊(dP n : ℝ) ^ c⌋₊
/-- `α = ⌈(12 d² b)^{1/4}⌉`. -/
def αP (n : ℕ) : ℕ := ⌈(12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4)⌉₊

lemma bP_pos (n : ℕ) : 1 ≤ bP n := le_max_right _ _

lemma LP_exists (n : ℕ) : ∃ L : ℕ, 4 * n ≤ 2 ^ L * bP n := ⟨4 * n, by
  have h1 := bP_pos n
  have h2 : 4 * n < 2 ^ (4 * n) := Nat.lt_two_pow_self
  nlinarith⟩

/-- `L`: least exponent with `4n ≤ 2^L b`. -/
def LP (n : ℕ) : ℕ := Nat.find (LP_exists n)
/-- `T = 2^L`. -/
def TP (n : ℕ) : ℕ := 2 ^ LP n
/-- `ℓ = ⌈L/d⌉`. -/
def ℓP (n : ℕ) : ℕ := RP.ell (LP n) (dP n)
/-- `r = 2^ℓ`. -/
def rP (n : ℕ) : ℕ := 2 ^ ℓP n
/-- Bit volume `V = T p`. -/
def VP (n : ℕ) : ℝ := (TP n : ℝ) * (pP n : ℝ)
/-- `γ = 2 d α²`. -/
def γP (n : ℕ) : ℝ := 2 * (dP n : ℝ) * (αP n : ℝ) ^ 2

