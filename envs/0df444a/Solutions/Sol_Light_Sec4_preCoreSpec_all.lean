leaves with at most r symbols P₀. -/
theorem memEnc_eq {L r : ℕ} {μ : ℕ → ℤ} {a : ℕ} {enc : Leaf L → ℤ}
    (h : Sec2.RetSeg L r μ a (arrT enc)) (τ : Leaf L) (hτ : (digitsT τ).count 9 ≤ r) :
    memEnc μ a L τ = enc τ :=
