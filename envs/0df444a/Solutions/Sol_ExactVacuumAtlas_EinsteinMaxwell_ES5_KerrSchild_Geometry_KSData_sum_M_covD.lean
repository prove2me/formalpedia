variable {b bi : Metric 5} {v : Pt 5 → ℝ} {k : Pt 5 → Fin 5 → ℝ} {U : Set (Pt 5)}
variable (hD : KSData b bi v k U)
include hD
theorem solution {x : Pt 5} (hx : x ∈ U) :
    ∑ a, ∑ p, mOf (ksC b bi v k) k x a p * covD (christoffel b bi) k x a p =
      v x * (∑ a, ∑ p, b a p x * accel b bi k x a * accel b bi k x p) / 2 := by
  calc _ = ∑ a, ∑ p, ((dprof v k x * k x a * lowerK b k x p
          + v x * accel b bi k x a * lowerK b k x p + v x * k x a * accL b bi k x p) / 2)
          * covD (christoffel b bi) k x a p :=
        Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun p _ => by rw [hD.mOf_ks hx]
    _ = ∑ a, ((dprof v k x * k x a + v x * accel b bi k x a)
          * (∑ p, lowerK b k x p * covD (christoffel b bi) k x a p)
          + v x * k x a * ∑ p, accL b bi k x p * covD (christoffel b bi) k x a p) / 2 :=
        Finset.sum_congr rfl fun a _ => by
          rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib, Finset.sum_div]
          exact Finset.sum_congr rfl fun p _ => by ring
    _ = ∑ a, (v x * k x a * ∑ p, accL b bi k x p * covD (christoffel b bi) k x a p) / 2 :=
        Finset.sum_congr rfl fun a _ => by rw [hD.lower_covD_null hx a]; ring
    _ = v x * (∑ p, accL b bi k x p * ∑ a, k x a * covD (christoffel b bi) k x a p) / 2 := by
        rw [← Finset.sum_div]
        congr 1
        simp only [Finset.mul_sum]
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun a _ => by ring
    _ = v x * (∑ p, accL b bi k x p * accel b bi k x p) / 2 := by
        simp only [← accel_eq_sum_covD]
    _ = _ := by
        congr 2
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun p _ => ?_
        unfold accL
        rw [Finset.sum_mul]
        exact Finset.sum_congr rfl fun a _ => by rw [hD.symm x hx a p]
