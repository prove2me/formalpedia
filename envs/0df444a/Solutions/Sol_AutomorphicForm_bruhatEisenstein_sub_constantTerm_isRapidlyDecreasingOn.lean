section ChartClamp

private noncomputable def clampAbove (c η t : ℝ) : ℝ :=
  t * (1 - Real.smoothTransition ((t - c) / η))
    + (c + η / 2) * Real.smoothTransition ((t - c) / η)

private theorem clampAbove_of_le {c η t : ℝ} (hη : 0 < η) (h : t ≤ c) : clampAbove c η t = t := by
  have hx : (t - c) / η ≤ 0 := div_nonpos_iff.mpr (Or.inr ⟨sub_nonpos.2 h, hη.le⟩)
  rw [clampAbove, Real.smoothTransition.zero_of_nonpos hx]
  ring

private theorem clampAbove_of_ge {c η t : ℝ} (hη : 0 < η) (h : c + η ≤ t) :
    clampAbove c η t = c + η / 2 := by
  have hx : 1 ≤ (t - c) / η := (one_le_div hη).mpr (by linarith)
  rw [clampAbove, Real.smoothTransition.one_of_one_le hx]
  ring

private theorem clampAbove_mem {c η t : ℝ} (hη : 0 < η) (h : c ≤ t) :
    clampAbove c η t ∈ Set.Icc c (c + η) := by
  rcases le_total t (c + η) with hle | hge
  · have h0 := Real.smoothTransition.nonneg ((t - c) / η)
    have h1 := Real.smoothTransition.le_one ((t - c) / η)
    constructor
    · rw [clampAbove]; nlinarith
    · rw [clampAbove]; nlinarith
  · rw [clampAbove_of_ge hη hge]
    constructor <;> linarith

private theorem contDiff_clampAbove (c η : ℝ) : ContDiff ℝ ∞ (clampAbove c η) := by
  have hst : ContDiff ℝ ∞ (fun t : ℝ => Real.smoothTransition ((t - c) / η)) :=
    Real.smoothTransition.contDiff.comp ((contDiff_id.sub contDiff_const).div_const η)
  exact (contDiff_id.mul (contDiff_const.sub hst)).add (contDiff_const.mul hst)

private noncomputable def clampBelow (c η t : ℝ) : ℝ := -(clampAbove (-c) η (-t))

private theorem clampBelow_of_ge {c η t : ℝ} (hη : 0 < η) (h : c ≤ t) : clampBelow c η t = t := by
  rw [clampBelow, clampAbove_of_le hη (by linarith), neg_neg]

private theorem clampBelow_mem {c η t : ℝ} (hη : 0 < η) (h : t ≤ c) :
    clampBelow c η t ∈ Set.Icc (c - η) c := by
  have hmem := clampAbove_mem (c := -c) hη (t := -t) (by linarith)
  obtain ⟨h1, h2⟩ := hmem
  rw [clampBelow]
  exact ⟨by linarith, by linarith⟩

private theorem contDiff_clampBelow (c η : ℝ) : ContDiff ℝ ∞ (clampBelow c η) :=
  ((contDiff_clampAbove (-c) η).comp contDiff_neg).neg

private noncomputable def chartClamp (a b η t : ℝ) : ℝ := clampAbove b η (clampBelow a η t)

private theorem chartClamp_of_mem {a b η t : ℝ} (hη : 0 < η)
    (h : t ∈ Set.Icc a b) : chartClamp a b η t = t := by
  rw [chartClamp, clampBelow_of_ge hη h.1, clampAbove_of_le hη h.2]

private theorem chartClamp_mem {a b η : ℝ} (hη : 0 < η) (hab : a ≤ b) (t : ℝ) :
    chartClamp a b η t ∈ Set.Icc (a - η) (b + η) := by
  rcases le_total t a with hta | hat
  · have hmem := clampBelow_mem hη hta
    rw [chartClamp, clampAbove_of_le hη (hmem.2.trans hab)]
    exact ⟨hmem.1, hmem.2.trans (by linarith)⟩
  · rw [chartClamp, clampBelow_of_ge hη hat]
    rcases le_total t b with htb | hbt
    · rw [clampAbove_of_le hη htb]
      exact ⟨by linarith, by linarith⟩
    · have hmem := clampAbove_mem (c := b) hη hbt
      exact ⟨by linarith [hmem.1], hmem.2⟩

private theorem contDiff_chartClamp (a b η : ℝ) : ContDiff ℝ ∞ (chartClamp a b η) :=
  (contDiff_clampAbove b η).comp (contDiff_clampBelow a η)

end ChartClamp
