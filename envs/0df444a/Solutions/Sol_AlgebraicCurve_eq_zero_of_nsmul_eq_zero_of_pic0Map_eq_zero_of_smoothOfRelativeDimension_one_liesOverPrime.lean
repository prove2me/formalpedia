        rw [hajP]
        show Spec.map (CommRingCat.ofHom O.subtype) ≫ PtP.1 ≫ e₀ ≫ pullback.fst π₀ (Spec.map (CommRingCat.ofHom j)) ≫ aj.1 =
          (𝔐.pointEquivPlace.symm P).1 ≫ e' ≫ pullback.fst π₀ sQ ≫ aj.1
        rw [← Category.assoc, hPtP, ← Category.assoc (e'), he'fst]
        simp only [Category.assoc]

      have hredP := hred P PtP (by rw [hPtP])
      obtain ⟨Dk, hDk, hajk⟩ := hptsk_aj (𝔐k.pointEquivPlace.symm (red P)) (𝔐k.pointEquivPlace.symm (red P₀)) hsk₀
      have hDk' : (Dk : Divisor k K) = Finsupp.mapDomain red (DP : Divisor (AlgebraicClosure ℚ) F) := by
        rw [hDk, hDP, Equiv.apply_symm_apply, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        show _ = Finsupp.mapDomain.addMonoidHom red (Finsupp.single P 1 - Finsupp.single P₀ 1)
        rw [map_sub]
        show _ = Finsupp.mapDomain red (Finsupp.single P 1) - Finsupp.mapDomain red (Finsupp.single P₀ 1)
        rw [Finsupp.mapDomain_single, Finsupp.mapDomain_single]
      rw [hr, show (⟨Finsupp.mapDomain red (DP : Divisor (AlgebraicClosure ℚ) F), hred0 _ DP.2⟩ : Divisor.degZero (K := k) (F := K)) = Dk from
        Subtype.ext hDk'.symm, hwP]
      apply Subtype.ext
      rw [hajk]
      show (𝔐k.pointEquivPlace.symm (red P)).1 ≫ ek' ≫ pullback.fst π₀ sk ≫ aj.1 =
        Spec.map (CommRingCat.ofHom res) ≫ PtP.1 ≫ e₀ ≫ pullback.fst π₀ (Spec.map (CommRingCat.ofHom j)) ≫ aj.1
      rw [← Category.assoc (Spec.map _), ← hredP, ← Category.assoc (ek'), hek'fst]
      simp only [Category.assoc]

    intro c
    obtain ⟨D, rfl⟩ := Pic0.mk_surjective c
    have hgen := AlgebraicCurve.Divisor.degZero_le_closure_single_sub_single_of_surjective (AlgebraicClosure ℚ) F
      {q : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ 𝔐.C // q ≫ 𝔐.toBase = 𝟙 _} 𝔐.pointEquivPlace 𝔐.pointEquivPlace.surjective D.2
    have hsub : AddSubgroup.closure {D : Divisor (AlgebraicClosure ℚ) F | ∃ a b : {q : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ 𝔐.C // q ≫ 𝔐.toBase = 𝟙 _},
        D = Finsupp.single (𝔐.pointEquivPlace a) 1 - Finsupp.single (𝔐.pointEquivPlace b) 1} ≤ Divisor.degZero (K := AlgebraicClosure ℚ) (F := F) := by
      rw [AddSubgroup.closure_le]
      rintro D ⟨a, b, rfl⟩
      obtain ⟨Da, hDa, -⟩ := key (𝔐.pointEquivPlace a)
      obtain ⟨Db, hDb, -⟩ := key (𝔐.pointEquivPlace b)
      have : Finsupp.single (𝔐.pointEquivPlace a) 1 - Finsupp.single (𝔐.pointEquivPlace b) 1 = (Da : Divisor (AlgebraicClosure ℚ) F) - (Db : Divisor (AlgebraicClosure ℚ) F) := by
        rw [hDa, hDb]; abel
      show _ ∈ Divisor.degZero (K := AlgebraicClosure ℚ) (F := F)
      rw [this]; exact sub_mem Da.2 Db.2
    suffices h : ∀ (x : Divisor (AlgebraicClosure ℚ) F), x ∈ AddSubgroup.closure {D : Divisor (AlgebraicClosure ℚ) F | ∃ a b : {q : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ 𝔐.C // q ≫ 𝔐.toBase = 𝟙 _},
        D = Finsupp.single (𝔐.pointEquivPlace a) 1 - Finsupp.single (𝔐.pointEquivPlace b) 1} →
        ∀ hx : x ∈ Divisor.degZero (K := AlgebraicClosure ℚ) (F := F), Pic0.mk ⟨x, hx⟩ ∈ S by
      exact h D hgen D.2
    intro x hx
    refine AddSubgroup.closure_induction (p := fun y _ => ∀ hy : y ∈ Divisor.degZero (K := AlgebraicClosure ℚ) (F := F), Pic0.mk ⟨y, hy⟩ ∈ S)
      ?_ ?_ ?_ ?_ hx
    · rintro y ⟨a, b, rfl⟩ hy
      obtain ⟨Da, hDa, hSa⟩ := key (𝔐.pointEquivPlace a)
      obtain ⟨Db, hDb, hSb⟩ := key (𝔐.pointEquivPlace b)
