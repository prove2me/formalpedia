theorem exists_quotField_restrict (q : ℕ) [Fact q.Prime] (κ : Type) [Field κ] [Algebra (GaloisField q 2) κ]
    [IsDomain (CoordRing q κ)] (Cs : Subgroup (rootsOfUnity (q + 1) (GaloisField q 2)))
    (h : ↥(hSubgroup q))
    (hcomm : ∀ ζ : ↥Cs, h * ⟨(1, ((ζ : rootsOfUnity (q + 1) (GaloisField q 2)) : (GaloisField q 2)ˣ)), one_mem_hSubgroup_of_mem q ζ⟩ =
      ⟨(1, ((ζ : rootsOfUnity (q + 1) (GaloisField q 2)) : (GaloisField q 2)ˣ)), one_mem_hSubgroup_of_mem q ζ⟩ * h) :
    ∃ T : ↥(quotField q κ Cs) ≃+* ↥(quotField q κ Cs),
      (∀ z : ↥(quotField q κ Cs), ((T z : ↥(quotField q κ Cs)) : drinfeldFunctionField q κ) = hFunctionFieldAction q κ h z) ∧
      (∀ x : κ, T (algebraMap κ _ x) = algebraMap κ _ x) := by

  have hstab : ∀ (g : ↥(hSubgroup q)), (∀ ζ : ↥Cs, g * ⟨(1, ((ζ : rootsOfUnity (q + 1) (GaloisField q 2)) : (GaloisField q 2)ˣ)), one_mem_hSubgroup_of_mem q ζ⟩ =
      ⟨(1, ((ζ : rootsOfUnity (q + 1) (GaloisField q 2)) : (GaloisField q 2)ˣ)), one_mem_hSubgroup_of_mem q ζ⟩ * g) →
      ∀ z : drinfeldFunctionField q κ, z ∈ quotField q κ Cs → hFunctionFieldAction q κ g z ∈ quotField q κ Cs := by
    intro g hg z hz
    rw [quotField, IntermediateField.mem_fixedField_iff] at hz ⊢
    intro σ hσ
    induction hσ using Subgroup.closure_induction with
    | mem σ hσ =>
      obtain ⟨ζ, rfl⟩ := hσ
      have hz1 := hz _ (Subgroup.subset_closure ⟨ζ, rfl⟩)
      show hFunctionFieldAction q κ _ (hFunctionFieldAction q κ g z) = hFunctionFieldAction q κ g z
      rw [← AlgEquiv.mul_apply, ← map_mul, ← hg ζ, map_mul, AlgEquiv.mul_apply, hz1]
    | one => rfl
    | mul σ τ _ _ ihσ ihτ => rw [AlgEquiv.mul_apply, ihτ, ihσ]
    | inv σ _ ih =>
      have h2 : σ⁻¹ (σ (hFunctionFieldAction q κ g z)) = hFunctionFieldAction q κ g z := by
        rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]
      rw [ih] at h2; exact h2
  have hcomm' : ∀ ζ : ↥Cs, h⁻¹ * ⟨(1, ((ζ : rootsOfUnity (q + 1) (GaloisField q 2)) : (GaloisField q 2)ˣ)), one_mem_hSubgroup_of_mem q ζ⟩ =
      ⟨(1, ((ζ : rootsOfUnity (q + 1) (GaloisField q 2)) : (GaloisField q 2)ˣ)), one_mem_hSubgroup_of_mem q ζ⟩ * h⁻¹ := by
    intro ζ
    have hc := hcomm ζ
    have := congrArg (fun x => h⁻¹ * x * h⁻¹) hc
    simpa [mul_assoc] using this.symm
  let f : ↥(quotField q κ Cs) → ↥(quotField q κ Cs) := fun z => ⟨hFunctionFieldAction q κ h z, hstab h hcomm z z.2⟩
  let g : ↥(quotField q κ Cs) → ↥(quotField q κ Cs) := fun z => ⟨hFunctionFieldAction q κ h⁻¹ z, hstab h⁻¹ hcomm' z z.2⟩
  have hfg : ∀ z, f (g z) = z := fun z => Subtype.ext (by
    show hFunctionFieldAction q κ h (hFunctionFieldAction q κ h⁻¹ z) = z
    rw [← AlgEquiv.mul_apply, ← map_mul, mul_inv_cancel, map_one, AlgEquiv.one_apply])
  have hgf : ∀ z, g (f z) = z := fun z => Subtype.ext (by
    show hFunctionFieldAction q κ h⁻¹ (hFunctionFieldAction q κ h z) = z
    rw [← AlgEquiv.mul_apply, ← map_mul, inv_mul_cancel, map_one, AlgEquiv.one_apply])
  refine ⟨{ toFun := f, invFun := g, left_inv := hgf, right_inv := hfg,
            map_mul' := fun a b => Subtype.ext (map_mul (hFunctionFieldAction q κ h) _ _),
            map_add' := fun a b => Subtype.ext (map_add (hFunctionFieldAction q κ h) _ _) }, fun z => rfl, fun x => ?_⟩
  apply Subtype.ext
  show hFunctionFieldAction q κ h (algebraMap κ (drinfeldFunctionField q κ) x) = algebraMap κ (drinfeldFunctionField q κ) x
  exact AlgEquiv.commutes _ x

theorem hFF_comm {q : ℕ} [Fact q.Prime] {κ : Type} [Field κ] [Algebra (GaloisField q 2) κ] [IsDomain (CoordRing q κ)]
    (h₀ g₁ g₂ : ↥(hSubgroup q)) (hcomm : h₀ * g₁ = g₂ * h₀) (z : drinfeldFunctionField q κ) :
    hFunctionFieldAction q κ h₀ (hFunctionFieldAction q κ g₁ z) = hFunctionFieldAction q κ g₂ (hFunctionFieldAction q κ h₀ z) := by
  rw [← AlgEquiv.mul_apply, ← map_mul, hcomm, map_mul, AlgEquiv.mul_apply]

section M3transport
variable {q : ℕ} [Fact q.Prime] {κ : Type} [Field κ] [Algebra (GaloisField q 2) κ] [IsDomain (CoordRing q κ)]
variable {Ab Ak B₀ B : Type} [CommRing Ab] [CommRing Ak] [CommRing B₀] [Algebra Ak B₀] [CommRing B]

theorem exists_rho_transport (Cs : Subgroup (rootsOfUnity (q + 1) (GaloisField q 2)))
    (ρ₀ : B₀ →+* ↥(quotField q κ Cs))
    (T : ↥(quotField q κ Cs) ≃+* ↥(quotField q κ Cs)) (h₀ : ↥(hSubgroup q))
    (hT : ∀ z : ↥(quotField q κ Cs), ((T z : ↥(quotField q κ Cs)) : drinfeldFunctionField q κ) = hFunctionFieldAction q κ h₀ z)
    (hTκ : ∀ x : κ, T (algebraMap κ _ x) = algebraMap κ _ x)
    (eB : B₀ ≃+* B) (ψ : Ab ≃+* Ak) (alg : Algebra Ab B)
    (halgB : ∀ a : Ab, @algebraMap Ab B _ _ alg a = eB (algebraMap Ak B₀ (ψ a)))
    (π : Ak) (ϖb : Ab)
    (hideal : Ideal.span {@algebraMap Ab B _ _ alg ϖb} = (Ideal.span {algebraMap Ak B₀ π}).map eB.toRingHom)
    (hker : RingHom.ker ρ₀ = Ideal.span {algebraMap Ak B₀ π})
    (r : Ak → κ) (rb : Ab → κ) (hr : ∀ a : Ab, r (ψ a) = rb a)
    (hconst : ∀ a : Ak, ρ₀ (algebraMap Ak B₀ a) = algebraMap κ _ (r a))
    (hfrac : ∀ z : ↥(quotField q κ Cs), ∃ g h : B₀, ρ₀ h ≠ 0 ∧ z * ρ₀ h = ρ₀ g)
    (hrange : ∀ z : ↥(quotField q κ Cs), z ∈ Set.range ρ₀ ↔
      (z : drinfeldFunctionField q κ) ∈ Set.range (algebraMap (CoordRing q κ) (drinfeldFunctionField q κ))) :
    ∃ ρ : B →+* ↥(quotField q κ Cs),
      (∀ y : B₀, ρ (eB y) = T (ρ₀ y)) ∧
      RingHom.ker ρ = Ideal.span {@algebraMap Ab B _ _ alg ϖb} ∧
      (∀ a : Ab, ρ (@algebraMap Ab B _ _ alg a) = algebraMap κ _ (rb a)) ∧
      (∀ z : ↥(quotField q κ Cs), ∃ g h : B, ρ h ≠ 0 ∧ z * ρ h = ρ g) ∧
      (∀ z : ↥(quotField q κ Cs), z ∈ Set.range ρ ↔
        (z : drinfeldFunctionField q κ) ∈ Set.range (algebraMap (CoordRing q κ) (drinfeldFunctionField q κ))) := by
  let ρ : B →+* ↥(quotField q κ Cs) := T.toRingHom.comp (ρ₀.comp eB.symm.toRingHom)
  have hρ : ∀ y : B₀, ρ (eB y) = T (ρ₀ y) := fun y => by
    show T (ρ₀ (eB.symm (eB y))) = T (ρ₀ y); rw [RingEquiv.symm_apply_apply]
  have hρ' : ∀ f : B, ρ f = T (ρ₀ (eB.symm f)) := fun f => rfl
  refine ⟨ρ, hρ, ?_, ?_, ?_, ?_⟩
  ·
    rw [hideal]
    ext f
    rw [RingHom.mem_ker, hρ', map_eq_zero_iff T T.injective, ← RingHom.mem_ker, hker,
      Ideal.mem_map_iff_of_surjective eB.toRingHom eB.surjective]
    constructor
    · intro hf; exact ⟨eB.symm f, hf, by simp⟩
    · rintro ⟨y, hy, rfl⟩; simpa using hy
  ·
    intro a
    rw [halgB, hρ, hconst, hTκ, hr]
  ·
    intro z
    obtain ⟨g, h, hh0, hzh⟩ := hfrac (T.symm z)
    refine ⟨eB g, eB h, ?_, ?_⟩
    · rw [hρ]; exact fun h0 => hh0 (by simpa using congrArg T.symm h0)
    · rw [hρ, hρ]
      have := congrArg T hzh
      rw [map_mul, RingEquiv.apply_symm_apply] at this
      exact this
  ·
    intro z
    have hz : z ∈ Set.range ρ ↔ T.symm z ∈ Set.range ρ₀ := by
      constructor
      · rintro ⟨f, rfl⟩; exact ⟨eB.symm f, by rw [hρ', RingEquiv.symm_apply_apply]⟩
      · rintro ⟨y, hy⟩; exact ⟨eB y, by rw [hρ, hy, RingEquiv.apply_symm_apply]⟩
    rw [hz, hrange]

    have hTs : ((T.symm z : ↥(quotField q κ Cs)) : drinfeldFunctionField q κ) = hFunctionFieldAction q κ h₀⁻¹ z := by
      have h1 := hT (T.symm z)
      rw [RingEquiv.apply_symm_apply] at h1
      rw [h1, ← AlgEquiv.mul_apply, ← map_mul, inv_mul_cancel, map_one, AlgEquiv.one_apply]
    rw [hTs]
    constructor
    · rintro ⟨a, ha⟩
      refine ⟨hAction q κ h₀ a, ?_⟩
      rw [← hFunctionFieldAction_algebraMap, ha, ← AlgEquiv.mul_apply, ← map_mul, mul_inv_cancel, map_one, AlgEquiv.one_apply]
    · rintro ⟨a, ha⟩
      exact ⟨hAction q κ h₀⁻¹ a, by rw [← hFunctionFieldAction_algebraMap, ha]⟩

end M3transport
