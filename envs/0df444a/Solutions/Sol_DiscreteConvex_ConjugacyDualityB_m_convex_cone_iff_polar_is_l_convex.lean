variable {V : Type*} [Fintype V] [DecidableEq V]

lemma K_eq_polarP (R : V → V → Prop) [DecidableRel R] : K R = polar (P R) :=
  le_antisymm (K_sub_polarP R) (polarP_sub_K R)

lemma polar_convex (S : Set (V → ℝ)) : Convex ℝ (polar S) := by
  intro y hy z hz a b ha hb hab x hx
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, add_mul, Finset.sum_add_distrib]
  have h1 := hy x hx; have h2 := hz x hx
  have e1 : ∑ v, a * y v * x v = a * ∑ v, y v * x v := by
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro v _; ring
  have e2 : ∑ v, b * z v * x v = b * ∑ v, z v * x v := by
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro v _; ring
  rw [e1, e2]; nlinarith

lemma K_convex (R : V → V → Prop) [DecidableRel R] : Convex ℝ (K R) := by
  rw [K_eq_polarP]; exact polar_convex _

def closedS (R : V → V → Prop) (S : Finset V) : Prop := ∀ i j, R i j → j ∈ S → i ∈ S

def Bset (R : V → V → Prop) : Set (V → ℤ) := {z | (fun v => (z v : ℝ)) ∈ K R}

/-- integer `q ≥ 0`, monotone along `R`, pairs nonpositively with `z`. -/
lemma nat_pair (R : V → V → Prop) (z : V → ℤ)
    (hz : ∀ S, closedS R S → ∑ v ∈ S, z v ≤ 0) :
    ∀ N, ∀ q : V → ℕ, (∀ i j, R i j → q j ≤ q i) → ∑ v, q v = N →
      ∑ v, z v * (q v : ℤ) ≤ 0 := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro q hq hN
  by_cases h0 : ∀ v, q v = 0
  · simp [h0]
  push Not at h0
  obtain ⟨v0, hv0⟩ := h0
  let S : Finset V := univ.filter (fun v => 0 < q v)
  have hS : closedS R S := by
    intro i j hij hj
    simp only [S, Finset.mem_filter, Finset.mem_univ, true_and] at hj ⊢
    exact lt_of_lt_of_le hj (hq i j hij)
  let q' : V → ℕ := fun v => q v - 1
  have hq' : ∀ i j, R i j → q' j ≤ q' i := by
    intro i j hij; simp only [q']; have := hq i j hij; omega
  have hsplit : ∀ v, (q v : ℤ) = (if v ∈ S then 1 else 0) + (q' v : ℤ) := by
    intro v; simp only [S, q', Finset.mem_filter, Finset.mem_univ, true_and]
    split_ifs with h <;> omega
  have hlt : ∑ v, q' v < N := by
    rw [← hN]
    apply Finset.sum_lt_sum
    · intro v _; simp only [q']; omega
    · exact ⟨v0, Finset.mem_univ _, by simp only [q']; omega⟩
  have h1 := ih _ hlt q' hq' rfl
  have h2 := hz S hS
  calc ∑ v, z v * (q v : ℤ) = ∑ v ∈ S, z v + ∑ v, z v * (q' v : ℤ) := by
        simp_rw [hsplit, mul_add, Finset.sum_add_distrib, mul_ite, mul_one, mul_zero,
          Finset.sum_ite_mem, Finset.univ_inter]
    _ ≤ 0 := by linarith

lemma charB (R : V → V → Prop) [DecidableRel R] (z : V → ℤ) :
    z ∈ Bset R ↔ ∑ v, z v = 0 ∧ ∀ S, closedS R S → ∑ v ∈ S, z v ≤ 0 := by
