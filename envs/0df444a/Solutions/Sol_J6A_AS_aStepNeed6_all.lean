        Nat.mul_le_mul_left _ (Nat.pow_le_pow_left this 2)
    _ = 10 ^ 7 * (D + 3) ^ 2 * (A + 2) ^ 2 := by ring

theorem uC32 (A : ℕ) : J6Seg.Src.uC A 32 ≤ 2 * 10 ^ 10 * (A + 2) ^ 2 :=
  (uC_le A 32).trans (Nat.mul_le_mul_right _ (by norm_num))

theorem uCDD (A : ℕ) : J6Seg.Src.uC A J6Seg.Src.DD ≤ 10 ^ 10 * (A + 2) ^ 2 :=
  (uC_le A J6Seg.Src.DD).trans (Nat.mul_le_mul_right _ (by norm_num [J6Seg.Src.DD]))

theorem fmB_le (m : ℕ) : NLogN.KFM.fmB m ≤ 2 * cM * (m + 3) ^ 6 := by
  unfold NLogN.KFM.fmB cM
  generalize 8 * NLogN.fmA + 10 ^ 7 + 10 ^ 5 = F
  have zN : ∀ k : ℕ, zsz (k : ℤ) ≤ k := fun k =>
    zsz_le_of_lt (by simpa using (Nat.lt_two_pow_self (n := k)))
