theorem bad_parameters_closed (q : ℕ) (x : ZMod (4*q))
    (hx : x ∈ badParameters q) : x+q ∈ badParameters q := by
  have h4 := four_quarters_zero q
  simp only [badParameters,mem_insert,mem_singleton] at hx ⊢
  rcases hx with rfl|rfl|rfl|rfl
  · exact Or.inr (Or.inl (zero_add _))
  · exact Or.inr (Or.inr (Or.inl (by abel)))
  · exact Or.inr (Or.inr (Or.inr (by abel)))
  · left
    calc 3 • (q : ZMod (4*q))+q=4 • (q : ZMod (4*q)) := by abel
         _=0 := h4

theorem p2m_local_admissible_shift_iff (q : ℕ) (x : ZMod (4*q)) :
    x+q ∉ badParameters q ↔ x ∉ badParameters q := by
  constructor
  · intro hn hx
    exact hn (bad_parameters_closed q x hx)
  · intro hn hx
    have h1 := bad_parameters_closed q (x+q) hx
    have h2 := bad_parameters_closed q ((x+q)+q) h1
    have h3 := bad_parameters_closed q (((x+q)+q)+q) h2
    have he : (((x+q)+q)+q)+q=x := by
      calc _=x+4 • (q : ZMod (4*q)) := by abel
           _=x := by rw [four_quarters_zero,add_zero]
    rw [he] at h3
    exact hn h3











