theorem charP_residueField (O : Type*) [CommRing O] [IsLocalRing O] (hq : ((q : ℕ) : O) ∈ maximalIdeal O) :
    CharP (ResidueField O) q := by
  refine (CharP.charP_iff_prime_eq_zero (Fact.out : q.Prime)).mpr ?_
  rw [← map_natCast (residue O), residue_eq_zero_iff]
  exact hq

theorem natCast_mem_maximalIdeal_of_frame
    (Onr : Type) [CommRing Onr] [IsDomain Onr] [IsDiscreteValuationRing Onr] [Algebra ℤ_[q] Onr]
    (hOnr_max : (Ideal.span {algebraMap ℤ_[q] Onr (q : ℤ_[q])}).IsMaximal) :
    ((q : ℕ) : Onr) ∈ maximalIdeal Onr := by
  rw [← IsLocalRing.eq_maximalIdeal hOnr_max, ← map_natCast (algebraMap ℤ_[q] Onr)]
  exact Ideal.subset_span rfl

theorem algebraMap_mem_maximalIdeal_of_frame
    (Onr : Type) [CommRing Onr] [IsDomain Onr] [IsDiscreteValuationRing Onr] [Algebra ℤ_[q] Onr]
