set_option linter.unusedSimpArgs false

namespace NLogN.KIL

open IntMul AModel

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}

theorem bnd_pull {sh' : Shape} {g : List ℕ → List ℕ} {Bb : ℕ} {xs : List ℤ} (h : Bnd Bb xs) :
    Bnd Bb (AModel.pull sh' sh g 0 xs) := by
  intro a ha
  simp only [AModel.pull, List.mem_map] at ha
  obtain ⟨j, -, rfl⟩ := ha
  by_cases hj : encode sh' (g (decode sh j)) < xs.length
  · rw [List.getD_eq_getElem _ _ hj]; exact h _ (List.getElem_mem hj)
  · rw [List.getD_eq_default _ _ (by omega), zsz_zero]; exact Nat.zero_le _

theorem DOK_arr {Bb : ℕ} (s : Step n Q) {ys : List ℤ} (h : DOK sh Bb ys) :
    DOK sh Bb (s.arr Λ 0 ys) :=
  ⟨by simp [Step.arr], NLogN.KIL.bnd_pull h.2⟩

/-- **The step runner.** -/
theorem runCode_spec (scode : Step n Q → IStmt HS Pp) (jOf : Fin n → Fin n → Fin Pp)
    (child : Fin n → Fin n → List ℤ → List ℤ) (t : IState HS) (R : List Item) (Bb cS : ℕ)
    (cC : Fin n → Fin n → ℕ) :
    ∀ steps : List (Step n Q),
    (∀ i u c, Step.shift i u c ∈ steps → ∀ ys, DOK sh Bb ys →
      IRuns I iprog (scode (.shift i u c)) (t.upd 0 (ints ys ++ R))
        (t.upd 0 (ints ((Step.shift i u c).arr Λ 0 ys) ++ R)) cS) →
    (∀ a b, Step.swap a b ∈ steps → ∀ ys, DOK sh Bb ys →
      IRuns I iprog (iprog (jOf a b)) (t.upd 0 (ints ys ++ R))
        (t.upd 0 (ints (child a b ys) ++ R)) (cC a b) ∧ DOK sh Bb (child a b ys)) →
    ∀ xs, DOK sh Bb xs →
      IRuns I iprog (runCode scode jOf steps) (t.upd 0 (ints xs ++ R))
        (t.upd 0 (ints (runC Λ child 0 steps xs) ++ R)) (runCostI cS cC steps)
  | [], _, _, xs, _ => by
    simpa [runCode, runC, runCostI] using IRuns.skip (I := I) (iprog := iprog) (t.upd 0 (ints xs ++ R))
  | s :: rest, hS, hC, xs, hx => by
    have hS' : ∀ i u c, Step.shift i u c ∈ rest → _ := fun i u c h => hS i u c (List.mem_cons_of_mem _ h)
    have hC' : ∀ a b, Step.swap a b ∈ rest → _ := fun a b h => hC a b (List.mem_cons_of_mem _ h)
    have e : runC Λ child 0 (s :: rest) xs = runC Λ child 0 rest (stepC Λ child 0 xs s) := rfl
    cases s with
    | shift i u c =>
      have h1 := hS i u c List.mem_cons_self xs hx
      have h2 := runCode_spec scode jOf child t R Bb cS cC rest hS' hC'
        ((Step.shift i u c).arr Λ 0 xs) (DOK_arr Λ (Step.shift i u c) hx)
      refine (h1.seq h2).mono' (by rw [e]; rfl) ?_
      simp [runCostI, stepCost]; omega
    | swap a b =>
      have h1 := hC a b List.mem_cons_self xs hx
      have h2 := runCode_spec scode jOf child t R Bb cS cC rest hS' hC' (child a b xs) h1.2
      refine ((IRuns.call h1.1).seq h2).mono' (by rw [e]; rfl) ?_
      simp [runCostI, stepCost]; omega

theorem runC_eq_runArr_dok (child : Fin n → Fin n → List ℤ → List ℤ) (Bb : ℕ) :
    ∀ steps : List (Step n Q),
    (∀ a b, Step.swap a b ∈ steps → ∀ ys, DOK sh Bb ys →
      child a b ys = (Step.swap a b).arr Λ 0 ys) →
    ∀ xs, DOK sh Bb xs → runC Λ child 0 steps xs = AModel.runArr Λ 0 steps xs
  | [], _, _, _ => rfl
  | s :: rest, hC, xs, hx => by
    have hC' : ∀ a b, Step.swap a b ∈ rest → _ := fun a b h => hC a b (List.mem_cons_of_mem _ h)
    have e : stepC Λ child 0 xs s = s.arr Λ 0 xs := by
      cases s with
      | shift i u c => rfl
      | swap a b => exact hC a b List.mem_cons_self xs hx
    show runC Λ child 0 rest (stepC Λ child 0 xs s) = AModel.runArr Λ 0 rest (s.arr Λ 0 xs)
    rw [e]
    exact runC_eq_runArr_dok child Bb rest hC' _ (DOK_arr Λ s hx)

end NLogN.KIL

end

