namespace EditApproximation



theorem wideActionGridWithWork_cost {nx ny : ℕ} (M : ℕ) (parent : TargetInterval nx)
    (r : TargetInterval ny) (b P C : ℕ) (hP : 0 < P)
    (hc : ∀ i : Fin M, (wideChildGridWithWork parent r b P i).2 ≤ C) :
