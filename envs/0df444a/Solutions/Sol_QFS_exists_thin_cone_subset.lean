variable {d : ℕ}

/-- **Lemma 3.3** of Bux–Kassmann–Schulze, for one cone and `d ≥ 2`: a thin cone
whose lattice points all lie deep inside the given cone. -/
theorem solution (hd : 2 ≤ d) {r : ℝ} (hr : 0 < r)
    {u : EuclideanSpace ℝ (Fin d)} (hu : ‖u‖ = 1) {ϑ : ℝ} (hϑ : 0 < ϑ) (hϑ' : ϑ ≤ π / 2) :
    ∃ (v : EuclideanSpace ℝ (Fin d)) (θ : ℝ), ‖v‖ = 1 ∧ 0 < θ ∧ θ ≤ ϑ / 4 ∧
      QFS.doubleCone v θ ∩ QFS.lattice d ⊆ QFS.shrink (QFS.doubleCone u ϑ) r ∩ QFS.lattice d := by
  classical
  obtain ⟨w, hw, huw⟩ := QFS.exists_orthogonal_unit hd hu
  have hpi := pi_pos
  have hsin4 : 0 < Real.sin (ϑ / 4) :=
    Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith)
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = (r + 1) / Real.sin (ϑ / 4) := ⟨_, rfl⟩
  have hM0 : 0 < M := by rw [hMdef]; positivity
  have hMsin : M * Real.sin (ϑ / 4) = r + 1 := by
    rw [hMdef]; field_simp
  -- the finitely many short lattice points, whose directions the axis must avoid
  obtain ⟨Sset, hSdef⟩ : ∃ S : Set (EuclideanSpace ℝ (Fin d)),
      S = {q | q ∈ QFS.lattice d ∧ q ≠ 0 ∧ ‖q‖ ≤ M} := ⟨_, rfl⟩
  have hSfin : Sset.Finite := by
    refine (QFS.lattice_inter_closedBall_finite (0 : EuclideanSpace ℝ (Fin d)) M).subset ?_
    rw [hSdef]
    rintro q ⟨hq1, -, hq3⟩
    exact ⟨hq1, by rw [Metric.mem_closedBall, dist_zero_right]; exact hq3⟩
  have hrotnorm : ∀ t : ℝ, ‖QFS.rotAxis u w t‖ = 1 := QFS.norm_rotAxis hu hw huw
  -- **the rotation avoiding all of them.** Each short lattice point is parallel
  -- to at most one rotation, and there are infinitely many rotations to choose.
  obtain ⟨t, htI, htgood⟩ : ∃ t ∈ Set.Ioo (0:ℝ) (ϑ / 2),
      ∀ q ∈ Sset, angle (QFS.rotAxis u w t) q ≠ 0 := by
    by_contra hcon
    have hall : ∀ t : ℝ, ∃ q : EuclideanSpace ℝ (Fin d),
        t ∈ Set.Ioo (0:ℝ) (ϑ / 2) → (q ∈ Sset ∧ angle (QFS.rotAxis u w t) q = 0) := by
      intro t
      by_cases htI : t ∈ Set.Ioo (0:ℝ) (ϑ / 2)
      · have hnot : ¬ (∀ q, q ∈ Sset → angle (QFS.rotAxis u w t) q ≠ 0) :=
          fun h => hcon ⟨t, htI, h⟩
        rw [not_forall] at hnot
        obtain ⟨q, hq⟩ := hnot
        rw [Classical.not_imp] at hq
        exact ⟨q, fun _ => ⟨hq.1, not_not.mp hq.2⟩⟩
      · exact ⟨0, fun hc => absurd hc htI⟩
    choose g hg using hall
    have hbound : ∀ t ∈ Set.Ioo (0:ℝ) (ϑ / 2), t ≤ π := by
      intro t ht
      have := ht.2
      linarith
    have hinj : Set.InjOn g (Set.Ioo (0:ℝ) (ϑ / 2)) := by
      intro t₁ h₁ t₂ h₂ heq
      obtain ⟨-, c₁, hc₁, he₁⟩ := angle_eq_zero_iff.mp (hg t₁ h₁).2
      obtain ⟨-, c₂, hc₂, he₂⟩ := angle_eq_zero_iff.mp (hg t₂ h₂).2
      have hn₁ : ‖g t₁‖ = c₁ := by
        rw [he₁, norm_smul, hrotnorm, Real.norm_eq_abs, abs_of_pos hc₁, mul_one]
      have hn₂ : ‖g t₂‖ = c₂ := by
        rw [he₂, norm_smul, hrotnorm, Real.norm_eq_abs, abs_of_pos hc₂, mul_one]
      have hcc : c₁ = c₂ := by rw [← hn₁, ← hn₂, heq]
      have heq2 : c₁ • QFS.rotAxis u w t₁ = c₁ • QFS.rotAxis u w t₂ := by
        rw [← he₁, heq, he₂, hcc]
      have hrr : QFS.rotAxis u w t₁ = QFS.rotAxis u w t₂ :=
        smul_right_injective _ (ne_of_gt hc₁) heq2
      have e₁ := QFS.angle_rotAxis hu hw huw (le_of_lt h₁.1) (hbound t₁ h₁)
      have e₂ := QFS.angle_rotAxis hu hw huw (le_of_lt h₂.1) (hbound t₂ h₂)
      rw [← e₁, ← e₂, hrr]
    have himg : g '' Set.Ioo (0:ℝ) (ϑ / 2) ⊆ Sset := by
      rintro _ ⟨t, ht, rfl⟩
      exact (hg t ht).1
    exact (Set.Ioo_infinite (show (0:ℝ) < ϑ / 2 by linarith)) (
      Set.Finite.of_finite_image (hSfin.subset himg) hinj)
  -- **the apex angle**: below the least angle to a short lattice point
  obtain ⟨ε, hε0, hε⟩ : ∃ ε : ℝ, 0 < ε ∧ ∀ q ∈ Sset, ε ≤ angle (QFS.rotAxis u w t) q := by
    rcases Set.eq_empty_or_nonempty Sset with hS | hSne
    · exact ⟨1, one_pos, by simp [hS]⟩
    · obtain ⟨q₀, hq₀, hmin⟩ :=
        Set.exists_min_image Sset (fun q => angle (QFS.rotAxis u w t) q) hSfin hSne
      exact ⟨angle (QFS.rotAxis u w t) q₀,
        lt_of_le_of_ne (angle_nonneg _ _) (Ne.symm (htgood q₀ hq₀)), hmin⟩
  refine ⟨QFS.rotAxis u w t, min ε (ϑ / 4), hrotnorm t, lt_min hε0 (by linarith),
    min_le_right _ _, ?_⟩
  -- **the estimate**: a lattice point of the thin cone is long and nearly parallel
  -- to `u`, so its gap to the boundary of `V^m` exceeds `r`
  have hθ0 : 0 < min ε (ϑ / 4) := lt_min hε0 (by linarith)
  have hkey : ∀ q, q ∈ QFS.cone (QFS.rotAxis u w t) (min ε (ϑ / 4)) → q ∈ QFS.lattice d →
      r < QFS.coneGap u ϑ q := by
    intro q hq hqlat
    have hqang : q ≠ 0 ∧ angle (QFS.rotAxis u w t) q < min ε (ϑ / 4) :=
      (QFS.mem_cone_iff_angle (hrotnorm t) hθ0.le
        (by linarith [min_le_right ε (ϑ / 4)])).mp hq
    have hfar : M < ‖q‖ := by
      by_contra hc
      have hmem : q ∈ Sset := by
        rw [hSdef]
        exact ⟨hqlat, hqang.1, le_of_not_gt hc⟩
      have h1 := hε q hmem
      have h2 := hqang.2
      have h3 := min_le_left ε (ϑ / 4)
      linarith
    have hang : angle u q < 3 * ϑ / 4 := by
      have h1 : angle u q ≤ angle u (QFS.rotAxis u w t) + angle (QFS.rotAxis u w t) q :=
        angle_le_angle_add_angle u (QFS.rotAxis u w t) q
      have h2 : angle u (QFS.rotAxis u w t) = t :=
        QFS.angle_rotAxis hu hw huw (le_of_lt htI.1) (by linarith [htI.2])
      have h3 := hqang.2
      have h4 := min_le_right ε (ϑ / 4)
      have h5 := htI.2
      linarith
    have hnn : 0 ≤ angle u q := angle_nonneg _ _
    have hsinle : Real.sin (ϑ / 4) ≤ Real.sin (ϑ - angle u q) :=
      Real.sin_le_sin_of_le_of_le_pi_div_two (by linarith) (by linarith) (by linarith)
    rw [QFS.coneGap_eq_norm_mul_sin hu]
    have hs0 : 0 ≤ Real.sin (ϑ / 4) := hsin4.le
    nlinarith [hMsin, hfar, hsinle, hM0]
  -- assemble
  rintro p ⟨hp, hplat⟩
  refine ⟨?_, hplat⟩
  rcases QFS.mem_doubleCone_iff.mp hp with h | h
  · have hgap := hkey p h hplat
    refine ⟨Or.inl ((QFS.mem_cone_iff_coneGap_pos hu hϑ hϑ' p).mpr (by linarith)), fun y hy => ?_⟩
    exact Or.inl (QFS.closedBall_subset_cone hu hϑ hϑ' hgap hy)
  · have hgap := hkey (-p) h (QFS.neg_mem_lattice hplat)
    have hin : -p ∈ QFS.cone u ϑ := (QFS.mem_cone_iff_coneGap_pos hu hϑ hϑ' (-p)).mpr (by linarith)
    refine ⟨Or.inr hin, fun y hy => ?_⟩
    refine Or.inr ?_
    refine QFS.closedBall_subset_cone hu hϑ hϑ' hgap ?_
    rw [Metric.mem_closedBall, dist_eq_norm] at hy ⊢
    have he : -y - -p = -(y - p) := by abel
    rw [he, norm_neg]
    exact hy
