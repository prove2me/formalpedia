theorem cost_absorbE {u c Bb V : ℕ} {K D : ℝ} (hu : 1 ≤ u) (hK : 0 ≤ K) (hD0 : 0 ≤ D)
    (hov : ((Bb : ℝ) + 2) ^ 2 ≤ D * V) (X : ℕ) (hX : X ≤ 10 ^ 9 * (Bb + 2) ^ 2 + 1)
    (hc : (c : ℝ) ≤ K * ((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 42)) :
    (((X + c + (4 * (2 * Bb + 2) + 1) : ℕ)) : ℝ)
      ≤ (K + 10 ^ 10 * D) * ((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 42) := by
  set x := (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 42)
  have hx : (1 : ℝ) ≤ x := Real.one_le_rpow (by exact_mod_cast hu) (by norm_num)
  have hB : (0 : ℝ) ≤ Bb := Nat.cast_nonneg _
  have hV0 : (0 : ℝ) ≤ V := Nat.cast_nonneg _
  have h1 : D * V ≤ D * (((V : ℝ) + 1) * x) := by
    apply mul_le_mul_of_nonneg_left _ hD0; nlinarith
  have hXr : (X : ℝ) ≤ 10 ^ 9 * ((Bb : ℝ) + 2) ^ 2 + 1 := by exact_mod_cast hX
  push_cast
  have e : (K + 10 ^ 10 * D) * ((V : ℝ) + 1) * x =
      K * ((V : ℝ) + 1) * x + 10 ^ 10 * (D * (((V : ℝ) + 1) * x)) := by ring
  rw [e]
  have hBB : 10 ^ 9 * ((Bb : ℝ) + 2) ^ 2 + 1 + 4 * (2 * (Bb : ℝ) + 2) + 1 ≤
      10 ^ 10 * ((Bb : ℝ) + 2) ^ 2 := by nlinarith
  have h2 : 10 ^ 10 * ((Bb : ℝ) + 2) ^ 2 ≤ 10 ^ 10 * (D * (((V : ℝ) + 1) * x)) := by
    have := le_trans hov h1
    linarith
  linarith

/-- **The swap with expression parameters.** Stack 0 is `enc2 xs ++ R`; the expressions
evaluate (with `≤ zsz V + 3` bits) to `vol Pre, vol G, vol Suf, u`; the two `[2^u]` fields are
interchanged at cost `≤ K (V+1) u^τ`. -/
theorem swE_spec :
    ∃ T q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u : ℕ) (Pre G Suf : Shape), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      ∀ (I : List Sym) (t : IState HS) (xs : List (ZMod 2)) (R : List Item),
      t.G 0 = ints (enc2 xs) ++ R →
      xs.length = vol (binShape Pre G Suf (2 ^ u)) →
      ∀ (eP eG eS eU : Ex HS) (Bb : ℕ), Bb ≤ zsz (vol (binShape Pre G Suf (2 ^ u)) : ℤ) + 3 →
      eP.size + eG.size + eS.size + eU.size ≤ 50 →
      NoK eP → NoK eG → NoK eS → NoK eU →
      ESp eP t Bb (vol Pre : ℤ) → ESp eG t Bb (vol G : ℤ) → ESp eS t Bb (vol Suf : ℤ) →
      ESp eU t Bb (u : ℤ) →
      ∃ c : ℕ, IRuns I l12prog (swE q eP eG eS eU) t
        (t.upd 0 (ints (pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
          (swapPos Pre.length (Pre.length + 1 + G.length)) 0 (enc2 xs)) ++ R)) c ∧
        (c : ℝ) ≤ K * ((vol (binShape Pre G Suf (2 ^ u)) : ℝ) + 1) *
          (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 42) := by
  obtain ⟨T, q₀, H⟩ := lemma12_fine_canon
  refine ⟨T, q₀, fun q hq hq₀ => ?_⟩
  obtain ⟨K, hK, HK⟩ := H q hq hq₀
  obtain ⟨D, hD0, hD⟩ := overhead_le 0 3
  refine ⟨K + 10 ^ 10 * D, by positivity,
    fun u Pre G Suf hu hPre hG hS I t xs R h0 hxs eP eG eS eU Bb hBb hsz nP nG nS nU
      r1 r2 r3 r4 => ?_⟩
  set V := vol (binShape Pre G Suf (2 ^ u)) with hVdef
  have hV1 : 1 ≤ V := le_trans Nat.one_le_two_pow (two_pow_le_vol Pre G Suf hPre hG hS)
  have hzV := succ_le_zsz_vol (u := u) Pre G Suf hPre hG hS
  set s := t.upd 0 R
  set F := Fsw (enc2 xs) (vol Pre) (vol G) (vol Suf) u
  obtain ⟨c, Hc, hc⟩ := HK u Pre G Suf hu hPre hG hS I s F xs [] [] [] []
    (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw])
    (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw])
    (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw])
    (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw])
    (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw]) hxs
  set ys := pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
    (swapPos Pre.length (Pre.length + 1 + G.length)) 0 (enc2 xs)
  rw [update_Fsw, enc2_pull] at Hc
  have ev : evalP t (swPl eP eG eS eU) =
      [(kP, ((vol Pre : ℕ) : ℤ)), (NLogN.KIL.kG, ((vol G : ℕ) : ℤ)), (NLogN.KIL.kS, ((vol Suf : ℕ) : ℤ)),
        (aU, (u : ℤ))] := by
    simp only [evalP, swPl, List.map_cons, List.map_nil, r1.ev, r2.ev, r3.ev, r4.ev]
  have eIn : NLogN.KIL.encK s F = pushSt t (evalP t (swPl eP eG eS eU)) := by
    rw [ev, encK_Fsw]
    conv_rhs => rw [← upd_self (pushSt _ _) 0]
    congr 1
    rw [pushSt_G_of_not_mem _ _ _ (by simp +decide), h0]
  have eOut : NLogN.KIL.encK s (Fsw ys (vol Pre) (vol G) (vol Suf) u) =
      (pushSt t (evalP t (swPl eP eG eS eU))).upd 0 (ints ys ++ R) := by
    rw [ev, encK_Fsw]
  rw [eIn, eOut] at Hc
  have nk : ∀ e : Ex HS, NoK e → ∀ r ∈ e.regs, r ∉ (swPl eP eG eS eU).map Prod.fst := by
    intro e he r hr
    obtain ⟨a, b, c, d⟩ := he r hr
    simp only [swPl, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil, or_false]
    tauto
  have hl : NLogN.KIL.PushOK t Bb (swPl eP eG eS eU) := by
    intro p hp
    simp only [swPl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact ⟨by simp +decide, r1.clean, nk _ nP, r1.ok, r1.bnd⟩
    · exact ⟨by simp +decide, r2.clean, nk _ nG, r2.ok, r2.bnd⟩
    · exact ⟨by simp +decide, r3.clean, nk _ nS, r3.ok, r3.bnd⟩
    · exact ⟨by simp +decide, r4.clean, nk _ nU, r4.ok, r4.bnd⟩
  have hv : ∀ p ∈ swPl eP eG eS eU, zsz (p.2.eval t) ≤ Bb := by
    intro p hp
    simp only [swPl, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact Ex.zsz_eval_le t Bb _ r1.bnd
    · exact Ex.zsz_eval_le t Bb _ r2.bnd
    · exact Ex.zsz_eval_le t Bb _ r3.bnd
    · exact Ex.zsz_eval_le t Bb _ r4.bnd
  have W := IRuns.withPushI (I := I) (iprog := l12prog) _ (l12C q) t Bb hl hv
    (by simp +decide [swPl]) ys R c Hc
  refine ⟨_, W, ?_⟩
  have hpc : pushCost Bb (swPl eP eG eS eU) ≤ 10 ^ 9 * (Bb + 2) ^ 2 + 1 := by
    rw [pushCost]; simp only [swPl, List.map_cons, List.map_nil]
    rw [List.sum_cons, List.sum_cons, List.sum_cons, List.sum_cons, List.sum_nil]
    have : (eP.size + 1) * 10 ^ 7 * (Bb + 2) ^ 2 + ((eG.size + 1) * 10 ^ 7 * (Bb + 2) ^ 2 +
        ((eS.size + 1) * 10 ^ 7 * (Bb + 2) ^ 2 + ((eU.size + 1) * 10 ^ 7 * (Bb + 2) ^ 2 + 0))) =
        (eP.size + eG.size + eS.size + eU.size + 4) * (10 ^ 7 * (Bb + 2) ^ 2) := by ring
    rw [this]
    have h2 : (eP.size + eG.size + eS.size + eU.size + 4) * (10 ^ 7 * (Bb + 2) ^ 2) ≤
        54 * (10 ^ 7 * (Bb + 2) ^ 2) := Nat.mul_le_mul_right _ (by omega)
    omega
  have hl4 : (swPl eP eG eS eU).length = 4 := rfl
  rw [hl4]
  have hz1 := KFB.one_le_zsz hV1
  have hov := hD 0 V Bb hV1 (by omega) (by omega)
  rw [← hVdef] at hc
  exact cost_absorbE hu hK hD0 (by simpa using hov) _ hpc hc

/-- **Slot swap `i` on the geometry** with expression parameters. -/
theorem swE_geo :
    ∃ T q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ (i : Fin 3) (g : Geo), g.Pos → ∀ u : ℕ, 1 ≤ u → g.Q = 2 ^ u →
      ∀ (I : List Sym) (t : IState HS) (zs : List ℤ) (R : List Item),
      KFL.Bits zs → t.G 0 = ints zs ++ R → zs.length = g.V →
      ∀ (eP eG eS eU : Ex HS) (Bb : ℕ), Bb ≤ zsz (g.V : ℤ) + 3 →
      eP.size + eG.size + eS.size + eU.size ≤ 50 →
      NoK eP → NoK eG → NoK eS → NoK eU →
      ESp eP t Bb (svP g i : ℤ) → ESp eG t Bb (svG g i : ℤ) → ESp eS t Bb (svS g i : ℤ) →
      ESp eU t Bb (u : ℤ) →
      ∃ c : ℕ, IRuns I l12prog (swE q eP eG eS eU) t
          (t.upd 0 (ints (rixT g (swT i) zs) ++ R)) c ∧
          (c : ℝ) ≤ K * ((g.V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 42) := by
  obtain ⟨T, q₀, H⟩ := swE_spec
  refine ⟨T, q₀, fun q hq hq₀ => ?_⟩
  obtain ⟨K, hK, HK⟩ := H q hq hq₀
  refine ⟨K, hK, fun i g hg u hu hQ I t zs R hb h0 hlen eP eG eS eU Bb hBb hsz nP nG nS nU
    r1 r2 r3 r4 => ?_⟩
  set xs : List (ZMod 2) := zs.map fun z : ℤ => (Int.cast z : ZMod 2)
  have hx : enc2 xs = zs := bits_enc2 zs hb
  have hq := hg.q; have h0' := hg.n0; have h1 := hg.n1; have h2 := hg.n2; have h3 := hg.n3
  have hB := hg.b
  have hxl : xs.length = g.V := by simp [xs, hlen]
  have hsh : ∀ Pre G Suf : Shape, binShape Pre G Suf (2 ^ u) = g.sh8 →
      vol (binShape Pre G Suf (2 ^ u)) = g.V := fun Pre G Suf e => by rw [e, Geo.vol_sh8]
  fin_cases i
  · have e : binShape [g.N0] [g.N1] [g.N2, g.Q, g.N3, g.B] (2 ^ u) = g.sh8 := by
      simp [binShape, Geo.sh8, hQ]
    obtain ⟨c, Hc, hc⟩ := HK u [g.N0] [g.N1] [g.N2, g.Q, g.N3, g.B] hu (by simp; omega)
      (by simp; omega) (by simp; omega) I t xs R (by rw [hx]; exact h0) (by rw [hsh _ _ _ e, hxl])
      eP eG eS eU Bb (by rw [hsh _ _ _ e]; exact hBb) hsz nP nG nS nU
      (by simpa [vol, svP] using r1) (by simpa [vol, svG] using r2)
      (by simpa [svS] using r3) r4
    rw [e, hx] at Hc; rw [hsh _ _ _ e] at hc
    refine ⟨c, ?_, hc⟩
    show IRuns I l12prog (swE q eP eG eS eU) t (t.upd 0 (ints (rixT g sw01 zs) ++ R)) c
    rw [← pull_swap13 g hg]; simpa [vol] using Hc
  · have e : binShape [g.N0, g.Q, g.N1] [g.N2] [g.N3, g.B] (2 ^ u) = g.sh8 := by
      simp [binShape, Geo.sh8, hQ]
    obtain ⟨c, Hc, hc⟩ := HK u [g.N0, g.Q, g.N1] [g.N2] [g.N3, g.B] hu (by simp; omega)
      (by simp; omega) (by simp; omega) I t xs R (by rw [hx]; exact h0) (by rw [hsh _ _ _ e, hxl])
      eP eG eS eU Bb (by rw [hsh _ _ _ e]; exact hBb) hsz nP nG nS nU
      (by simpa [svP] using r1) (by simpa [vol, svG] using r2)
      (by simpa [svS] using r3) r4
    rw [e, hx] at Hc; rw [hsh _ _ _ e] at hc
    refine ⟨c, ?_, hc⟩
    show IRuns I l12prog (swE q eP eG eS eU) t (t.upd 0 (ints (rixT g sw12 zs) ++ R)) c
    rw [← pull_swap35 g hg]; simpa [vol] using Hc
  · have e : binShape [g.N0] [g.N1, g.Q, g.N2] [g.N3, g.B] (2 ^ u) = g.sh8 := by
      simp [binShape, Geo.sh8, hQ]
    obtain ⟨c, Hc, hc⟩ := HK u [g.N0] [g.N1, g.Q, g.N2] [g.N3, g.B] hu (by simp; omega)
      (by simp; omega) (by simp; omega) I t xs R (by rw [hx]; exact h0) (by rw [hsh _ _ _ e, hxl])
      eP eG eS eU Bb (by rw [hsh _ _ _ e]; exact hBb) hsz nP nG nS nU
      (by simpa [vol, svP] using r1) (by simpa [svG] using r2)
      (by simpa [svS] using r3) r4
    rw [e, hx] at Hc; rw [hsh _ _ _ e] at hc
    refine ⟨c, ?_, hc⟩
    show IRuns I l12prog (swE q eP eG eS eU) t (t.upd 0 (ints (rixT g sw02 zs) ++ R)) c
    rw [← pull_swap15 g hg]; simpa [vol] using Hc

end IntMul.OpenAI.R129.P.NLogN.KFX

