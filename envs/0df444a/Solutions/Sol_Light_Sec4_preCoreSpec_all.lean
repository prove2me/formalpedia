                                                  (try have := Light.Std.const_le (by assumption))
                                                  (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))) (hs : c.Safe lim σ := by (( (try have := Light.Std.space_le (by assumption))
                                                                                                                                          (try have := Light.Std.const_le (by assumption))
                                                                                                                                          (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))) :
