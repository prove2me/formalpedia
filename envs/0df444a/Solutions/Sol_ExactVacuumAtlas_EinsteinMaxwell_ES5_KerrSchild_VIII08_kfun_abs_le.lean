    rw [abs_of_nonneg ht0]
    exact mul_le_mul_of_nonneg_left hBabs ht0
  have hcoef : (243 / 32 * (3 * |j| + Aq) * t) * ((2 / 3) * ((1 / 3) ^ 2))
