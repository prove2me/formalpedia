theorem solution (q : ℚ) (n : ℕ) :
    (TypeDensity.projectiveNormalizer n).eval q = ∑ i ∈ Finset.range (n+1), q ^ i ∧
      (∑ i ∈ Finset.range (n+1), q ^ i) * (q - 1) = q ^ (n+1) - 1 := by
  have hpow : ∀ (x : TypeDensity.Expr) (m : ℕ), (x.pow m).eval q = (x.eval q) ^ m := by
    intro x m
    induction m with
    | zero => simp [TypeDensity.Expr.pow, TypeDensity.Expr.eval]
    | succ m ih => simp [TypeDensity.Expr.pow, TypeDensity.Expr.eval, ih, pow_succ]
  have hsum : ∀ xs : List TypeDensity.Expr, (TypeDensity.Expr.sum xs).eval q = (xs.map (TypeDensity.Expr.eval q)).sum := by
    intro xs
    induction xs with
    | nil => simp [TypeDensity.Expr.sum, TypeDensity.Expr.eval]
    | cons x xs ih =>
      simp only [TypeDensity.Expr.sum, List.foldr_cons, TypeDensity.Expr.eval, List.map_cons, List.sum_cons] at ih ⊢
      rw [ih]
  refine ⟨?_, geom_sum_mul q (n+1)⟩
  unfold TypeDensity.projectiveNormalizer
  rw [hsum, List.map_map]
  have : (TypeDensity.Expr.eval q ∘ fun i => TypeDensity.Expr.pow TypeDensity.Expr.var i) = fun i => q ^ i := by
    funext i; simp [hpow, TypeDensity.Expr.eval]
  rw [this]
  simp [Finset.sum, Finset.range_val, Multiset.range]
