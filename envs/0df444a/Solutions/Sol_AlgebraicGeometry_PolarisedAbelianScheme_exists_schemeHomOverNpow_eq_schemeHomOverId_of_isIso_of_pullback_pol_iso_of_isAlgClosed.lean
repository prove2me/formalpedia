  rw [schemeHomOverId_coe]
  apply hg.hom_ext
  · rw [npow_comp_eq gA σ₀ σ hcomm m, hordR, schemeHomOverId_coe, Category.comp_id, Category.id_comp]
  · rw [(schemeHomOverNpow σ m).2, Category.id_comp]

