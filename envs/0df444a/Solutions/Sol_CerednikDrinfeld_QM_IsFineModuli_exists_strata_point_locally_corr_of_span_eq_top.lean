  obtain ⟨e, x₀, hx₀C, hloc⟩ := GPShift.core 𝒪 π Onr Λ hΛℤ A₀ n M fM C ψ X ξ ptX hx2 hx3 hx4 Abar hA0 m fbar hfbar Bbar d x hxC
    Dbar τR τL hoverC

  have hx₀M : x₀ ≫ ξ e = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C A (algebraMap 𝒪 C π)}))) ≫ t₀ := by
    apply GPShift.glue_points_ext (Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))) Abar m fbar hfbar Bbar
    · rw [Category.assoc, hx₀C]
