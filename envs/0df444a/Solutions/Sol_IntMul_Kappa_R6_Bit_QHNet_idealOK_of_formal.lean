variable {R : Type*} [CommRing R] {W T m : ℕ}

/-- **`IdealOK` from formal correctness.** No condition on gates. -/
theorem idealOK_of_formal_sol_aux (C : QHNet R W T m) {N : ℕ} [NeZero N] (hE : C.EdgesOK N)
    (hF : C.FormalOK N) : C.IdealOK N := by
  intro sh Λ ins hins w
  have hinit : ∀ x, (initH (T := T) (vol sh) ins x).length = vol sh := by
    intro x; cases x with
    | inl w => exact hins w
    | inr t => simp [initH]
  have hst : ∀ x, ∀ i < vol sh, (initH (T := T) (vol sh) ins x).getD i 0 =
      den Λ ins i (fInit (T := T) (m := m) N x) := by
    intro x i hi
    cases x with
    | inl u =>
      simp only [initH, fInit, Sum.elim_inl, den, Finsupp.linearCombination_single, one_smul]
      rw [frameArr_one Λ (hins u)]
    | inr t => simp [initH, fInit, den]
  have hlenR := (netRunH_congr (vol sh) (fun e => runArr Λ 0 (e.steps N))
    (fun e => runArr Λ 0 (e.steps N)) (fun e ys hys => length_runArr Λ 0 _ hys) C.prog
    (fun _ _ _ _ => rfl) _ hinit).2 (.inl (C.ρ w))
  have key := physical_formal Λ ins C.prog hE _ _ hinit hst (.inl (C.ρ w))
  rw [hF w] at key
  apply List.ext_getElem
  · rw [idealOut, hlenR]; simp
  · intro i h₁ h₂
    have hi : i < vol sh := by rw [idealOut, hlenR] at h₁; exact h₁
    rw [← List.getD_eq_getElem _ 0, ← List.getD_eq_getElem _ 0, idealOut, key i hi]
    simp only [den, Finsupp.linearCombination_single, one_smul]
    rw [frameArr, Matrix.inv_eq_left_inv swapMat_mul_self]

end QHNet

