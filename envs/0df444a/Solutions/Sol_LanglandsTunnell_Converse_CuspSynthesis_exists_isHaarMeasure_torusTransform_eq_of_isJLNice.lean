variable {K : Type} [Field K] [NumberField K]

private theorem t0334 {C : Type*} [Group C] [TopologicalSpace C] [CompactSpace C]
    (χ : C →* ℂˣ) (hχ : Continuous χ) (q : C) : ‖((χ q : ℂˣ) : ℂ)‖ = 1 := by
  have hcont : Continuous fun c : C => ‖((χ c : ℂˣ) : ℂ)‖ := (Units.continuous_val.comp hχ).norm
  obtain ⟨M, hM⟩ := (isCompact_range hcont).bddAbove
  have hr0 : 0 < ‖((χ q : ℂˣ) : ℂ)‖ := norm_pos_iff.2 (χ q).ne_zero
  have hpow : ∀ n : ℕ, ‖((χ q : ℂˣ) : ℂ)‖ ^ n ≤ M := fun n => by
    have h : ‖((χ (q ^ n) : ℂˣ) : ℂ)‖ ≤ M := hM ⟨q ^ n, rfl⟩
    rwa [map_pow, Units.val_pow_eq_pow_val, norm_pow] at h
  have hpow' : ∀ n : ℕ, ‖((χ q : ℂˣ) : ℂ)‖⁻¹ ^ n ≤ M := fun n => by
    have h : ‖((χ (q⁻¹ ^ n) : ℂˣ) : ℂ)‖ ≤ M := hM ⟨q⁻¹ ^ n, rfl⟩
    rwa [map_pow, map_inv, Units.val_pow_eq_pow_val, Units.val_inv_eq_inv_val, norm_pow, norm_inv] at h
  rcases lt_trichotomy ‖((χ q : ℂˣ) : ℂ)‖ 1 with h | h | h
  · obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt M ((one_lt_inv₀ hr0).2 h)
    exact absurd (hpow' n) (not_le_of_gt hn)
  · exact h
  · obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt M h
    exact absurd (hpow n) (not_le_of_gt hn)

private noncomputable def d038 (S : Finset (HeightOneSpectrum (𝓞 K))) :
    (AdeleRing (𝓞 K) K)ˣ →* ↥(torusClass (K := K) S) :=
  MonoidHom.mk' (fun z => (d022 S z).1) fun y z => congrArg Prod.fst (t0280 S y z)

private theorem t0335 (S : Finset (HeightOneSpectrum (𝓞 K))) (z : (AdeleRing (𝓞 K) K)ˣ) :
    d038 S z = (d022 S z).1 := rfl

private noncomputable def d039 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (χ : ↥(torusClass (K := K) S) →* ℂˣ) : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ :=
  χ.comp (d038 S)

private theorem t0336 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (χ : ↥(torusClass (K := K) S) →* ℂˣ) (z : (AdeleRing (𝓞 K) K)ˣ) :
    d039 S χ z = χ (d022 S z).1 := rfl

private theorem t0337 {S : Finset (HeightOneSpectrum (𝓞 K))}
    (χ : ↥(torusClass (K := K) S) →* ℂˣ) (q : ↥(torusClass (K := K) S)) (t : ℝ) :
    d039 S χ (((torusLift q : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K t)
      = χ q := by
  rw [t0336, t0281]

private theorem t0338 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (χ : ↥(torusClass (K := K) S) →* ℂˣ) : IsIdeleClassChar (𝓞 K) K (d039 S χ) := by
  intro u
  have h : d038 S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) u) = 1 := by
    rw [← map_one (d038 S), ← Subtype.coe_inj, ← mul_one (Units.map _ u)]
    exact congrArg (fun p => ((Prod.fst p : ↥(torusClass (K := K) S)) : NormOneQuot (K := K)))
      (t0279 S u 1)
  rw [d039, MonoidHom.comp_apply, h, map_one]

private theorem t0339 {S : Finset (HeightOneSpectrum (𝓞 K))}
    {χ : ↥(torusClass (K := K) S) →* ℂˣ} (hχ : Continuous χ) : Continuous (d039 S χ) := by
  show Continuous fun z => χ (d022 S z).1
  exact hχ.comp (continuous_fst.comp (t0282 S))

private theorem t0340 {S : Finset (HeightOneSpectrum (𝓞 K))}
    {χ : ↥(torusClass (K := K) S) →* ℂˣ} (hχ : Continuous χ) : IsUnitaryChar (𝓞 K) K (d039 S χ) := by
  haveI := t0140 (K := K) S
  intro z
  rw [t0336]
  exact t0334 χ hχ _

private theorem t0341 {S : Finset (HeightOneSpectrum (𝓞 K))}
    {χ : ↥(torusClass (K := K) S) →* ℂˣ} (hχ : Continuous χ) : IsAdmissibleTwist K (d039 S χ) :=
  ⟨t0338 S χ, t0339 hχ, t0340 hχ⟩

end TorusCharacter
