theorem kap_le {p : ℕ} (hp : 6 ≤ p) : kap (p + 2) ≤ 211 * p := by unfold kap; omega

/-- The frozen part. -/
theorem T0_le_sol_aux (w d h VT VS PM Bb p T : ℕ) (hVT : VT = 2 * T) (hw : w = p + 2) (hp : 6 ≤ p)
    (hVS : VS ≤ VT) (hsz : h + Nat.size VS + 3 ≤ 2 * p) (hBb : Bb + 2 ≤ p)
    (hPM : PM * 2 ^ h ≤ 2 * T) (hdh : d + 1 ≤ 2 ^ h) (hpT : p ≤ T) :
    (d + 1) * cScan VT w + (d + 1) * (h + w + Nat.size VS + 1) ^ 2 + d * cRb d w VS PM Bb ≤
      10 ^ 6 * ((d + 1) * T * p) := by
  subst hVT hw
  have hk := kap_le hp
  have hTp : 1 ≤ T * p := Nat.mul_pos (by omega) (by omega)
  -- scan
  have hscan : cScan (2 * T) (p + 2) ≤ 100001 * (T * p) := by
    unfold cScan
    have m1 : (p + 2 + 1) * (2 * (2 * T) + 1) ≤ (2 * p) * (5 * T) :=
      Nat.mul_le_mul (by omega) (by omega)
    nlinarith
  have G1 : (d + 1) * cScan (2 * T) (p + 2) ≤ 100001 * ((d + 1) * T * p) :=
    calc (d + 1) * cScan (2 * T) (p + 2) ≤ (d + 1) * (100001 * (T * p)) :=
          Nat.mul_le_mul_left _ hscan
      _ = 100001 * ((d + 1) * T * p) := by ring
  -- square
  have hS : (h + (p + 2) + Nat.size VS + 1) ^ 2 ≤ 16 * (T * p) := by
    have a : h + (p + 2) + Nat.size VS + 1 ≤ 4 * p := by omega
    have b : (h + (p + 2) + Nat.size VS + 1) ^ 2 ≤ (4 * p) ^ 2 := Nat.pow_le_pow_left a 2
    have c : p * p ≤ T * p := Nat.mul_le_mul_right p hpT
    nlinarith
  have G2 : (d + 1) * (h + (p + 2) + Nat.size VS + 1) ^ 2 ≤ 16 * ((d + 1) * T * p) :=
    calc (d + 1) * (h + (p + 2) + Nat.size VS + 1) ^ 2 ≤ (d + 1) * (16 * (T * p)) :=
          Nat.mul_le_mul_left _ hS
      _ = 16 * ((d + 1) * T * p) := by ring
  -- rotations
  have f1 : kap (p + 2) * VS ≤ (211 * p) * (2 * T) := Nat.mul_le_mul hk hVS
  have h3b : d * PM ≤ 2 * T := by
    have : d * PM ≤ 2 ^ h * PM := Nat.mul_le_mul_right _ (by omega)
    rw [mul_comm (2 ^ h)] at this; omega
  have f2 : d * PM * (Bb + 2) ≤ (2 * T) * p := Nat.mul_le_mul h3b hBb
  have hRb : cRb d (p + 2) VS PM Bb ≤ 842201 * (T * p) := by
    unfold cRb
    have e1 : 100 * kap (p + 2) * VS = 100 * (kap (p + 2) * VS) := by ring
    have e2 : 400000 * d * PM * (Bb + 2) = 400000 * (d * PM * (Bb + 2)) := by ring
    have e3 : 211 * p * (2 * T) = 422 * (T * p) := by ring
    have e4 : 2 * T * p = 2 * (T * p) := by ring
    rw [e1, e2]; rw [e3] at f1; rw [e4] at f2
    omega
  have G3 : d * cRb d (p + 2) VS PM Bb ≤ 842201 * ((d + 1) * T * p) :=
    calc d * cRb d (p + 2) VS PM Bb ≤ (d + 1) * cRb d (p + 2) VS PM Bb :=
          Nat.mul_le_mul_right _ (by omega)
      _ ≤ (d + 1) * (842201 * (T * p)) := Nat.mul_le_mul_left _ hRb
      _ = 842201 * ((d + 1) * T * p) := by ring
  omega

