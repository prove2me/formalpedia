variable {W : Type*} [Fintype W] [DecidableEq W]

theorem eMat_apply (l : List (W × W × ℤ × ℕ)) (p q : W) :
    eMat l p q = (l.map fun x => if x.1 = p ∧ x.2.1 = q then (x.2.2.1 : ℂ) / 2 ^ x.2.2.2 else 0).sum := by
  induction l with
  | nil => simp [eMat]
  | cons x l ih =>
    simp only [eMat, List.map_cons, List.sum_cons, Matrix.add_apply] at ih ⊢
    rw [ih, single_apply]

/-- `egM` with dyadic coefficients and disjoint targets/sources is `GOK`. -/
theorem egM_GOK {ι : Type*} (A : Finset ι) (r c : ι → W) (k : ι → ℂ) (ε : ι → ℤ) (hh : ι → ℕ)
    (hk : ∀ x ∈ A, k x = (ε x : ℂ) / 2 ^ hh x) (hε : ∀ x ∈ A, ε x = 1 ∨ ε x = -1)
    (hh1 : ∀ x ∈ A, hh x ≤ 1) (hts : ∀ x ∈ A, ∀ y ∈ A, r x ≠ c y) :
    GOK (1 + NetComplex.egM A r c k) := by
  refine ⟨A.toList.map fun x => (r x, c x, ε x, hh x), ?_, ?_, ?_⟩
  · congr 1
    rw [NetComplex.egM, eMat, List.map_map, ← Finset.sum_map_toList A (fun x => single (r x) (c x) (k x))]
    congr 1
    refine List.map_congr_left fun x hx => ?_
    rw [Finset.mem_toList] at hx
    simp [hk x hx]
  · intro x hx y hy
    simp only [List.mem_map, Finset.mem_toList] at hx hy
    obtain ⟨a, ha, rfl⟩ := hx
    obtain ⟨b, hb, rfl⟩ := hy
    exact hts a ha b hb
  · intro x hx
    simp only [List.mem_map, Finset.mem_toList] at hx
    obtain ⟨a, ha, rfl⟩ := hx
    exact ⟨hε a ha, hh1 a ha⟩

/-- Inverting a gate (`1 - (G - 1)`) keeps `GOK`. -/
theorem GOK_inv {G : Matrix W W ℂ} (h : GOK G) : GOK (1 - (G - 1)) := by
  obtain ⟨l, rfl, hts, hc⟩ := h
  refine ⟨l.map fun x => (x.1, x.2.1, -x.2.2.1, x.2.2.2), ?_, ?_, ?_⟩
  · have : ∀ l : List (W × W × ℤ × ℕ),
        eMat (l.map fun x => (x.1, x.2.1, -x.2.2.1, x.2.2.2)) = -eMat l := by
      intro l
      induction l with
      | nil => simp [eMat]
      | cons x l ih =>
        simp only [eMat, List.map_cons, List.sum_cons] at ih ⊢
        rw [ih, neg_add, Int.cast_neg, neg_div, single_neg]
    rw [this]; abel
  · intro x hx y hy
    simp only [List.mem_map] at hx hy
    obtain ⟨a, ha, rfl⟩ := hx
    obtain ⟨b, hb, rfl⟩ := hy
    exact hts a ha b hb
  · intro x hx
    simp only [List.mem_map] at hx
    obtain ⟨a, ha, rfl⟩ := hx
    obtain ⟨h1, h2⟩ := hc a ha
    refine ⟨?_, h2⟩
    rcases h1 with e | e <;> simp [e]

/-- **A `GOK` gate is a KFG atom gate.** -/
theorem GOK_atoms {n : ℕ} (e : W ≃ Fin n) {G : Matrix W W ℂ} (h : GOK G) :
    ∃ as : List KFG.Atom, (∀ a ∈ as, a.Ok n ∧ a.h ≤ 1) ∧ KFG.NoTS as ∧
      (fun i j => G (e.symm i) (e.symm j)) = KFG.gateMat n as := by
  obtain ⟨l, rfl, hts, hc⟩ := h
  refine ⟨atomsOf e l, ?_, ?_, ?_⟩
  · intro a ha
    simp only [atomsOf, List.mem_map] at ha
    obtain ⟨x, hx, rfl⟩ := ha
    have hne : x.1 ≠ x.2.1 := hts x hx x hx
    refine ⟨⟨(e x.1).isLt, (e x.2.1).isLt, fun h' => hne (e.injective (Fin.ext h')), ?_⟩, (hc x hx).2⟩
    rcases (hc x hx).1 with h1 | h1 <;> simp [KFB.Sm, h1]
  · intro a ha b hb
    simp only [atomsOf, List.mem_map] at ha hb
    obtain ⟨x, hx, rfl⟩ := ha
    obtain ⟨y, hy, rfl⟩ := hb
    exact fun h' => hts x hx y hy (e.injective (Fin.ext h'))
  · funext i j
    simp only [KFG.gateMat, Matrix.add_apply, Matrix.one_apply, eMat_apply, atomsOf, List.map_map]
    congr 1
    · simp [e.symm.injective.eq_iff]
    · congr 1
      refine List.map_congr_left fun x _ => ?_
      simp only [Function.comp_apply]
      have e1 : (x.1 = e.symm i) ↔ ((e x.1).val = i.val) := by
        rw [Equiv.eq_symm_apply, Fin.val_inj]
      have e2 : (x.2.1 = e.symm j) ↔ ((e x.2.1).val = j.val) := by
        rw [Equiv.eq_symm_apply, Fin.val_inj]
      by_cases h1 : (e x.1).val = i.val <;> by_cases h2 : (e x.2.1).val = j.val <;>
        simp [h1, h2, e1, e2, KFB.toC]

end Generic

section Complex

variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}
/-- The side coefficient `kD = -(|S ∩ T| - 1)/2` is `±1/2`. -/
theorem kD_eq (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) (n : NetComplex.Nb ind) :
    (NetComplex.kD ind n : ℂ) =
      ((if #(ind n.1.1 ∩ ind n.1.2) = 0 then (1 : ℤ) else -1 : ℤ) : ℂ) / 2 ^ 1 := by
  have hle := NetComplex.inter_le_two hcard hinj n.2.1
  have hev := n.2.2
  unfold NetComplex.kD
  rw [invOf_eq_inv]
  generalize #(ind n.1.1 ∩ ind n.1.2) = c at hle hev ⊢
  interval_cases c
  · norm_num
  · simp at hev
  · norm_num

theorem kS_eq (o : Option (Fin h)) :
    (NetComplex.kS o : ℂ) = ((match o with | none => (-1 : ℤ) | some _ => 1 : ℤ) : ℂ) / 2 ^ 1 := by
  cases o <;> simp [NetComplex.kS, invOf_eq_inv] <;> ring

variable {Wt : Type*} [Fintype Wt] [DecidableEq Wt]

theorem sideG_GOK (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) {I : NetComplex.Inv ind Wt} (hG : I.Good) (σ : ℤ) (hσ : σ = 1 ∨ σ = -1)
    (S : T) : GOK (I.sideG ℂ (σ : ℂ) S).1 := by
  refine egM_GOK _ _ _ _ (fun n => σ * (if #(ind n.1.1 ∩ ind n.1.2) = 0 then (1 : ℤ) else -1))
    (fun _ => 1) (fun n _ => ?_) (fun n _ => ?_) (fun _ _ => le_rfl)
    (fun x _ y _ => hG.ts _ _)
  · rw [kD_eq hcard hinj]; push_cast; ring
  · split_ifs <;> rcases hσ with rfl | rfl <;> simp

theorem copyG_GOK {I : NetComplex.Inv ind Wt} (hG : I.Good) (σ : ℤ) (hσ : σ = 1 ∨ σ = -1)
    (t : T) : GOK (I.copyG ℂ (σ : ℂ) t).1 :=
  egM_GOK _ _ _ _ (fun _ => σ) (fun _ => 0) (fun n _ => by simp)
    (fun _ _ => hσ) (fun _ _ => by norm_num) (fun x _ y _ => (hG.ss _ _).symm)

theorem scatG_GOK {I : NetComplex.Inv ind Wt} (hG : I.Good) (σ : ℤ) (hσ : σ = 1 ∨ σ = -1) :
    GOK (I.scatG ℂ (σ : ℂ)).1 := by
  refine egM_GOK _ _ _ _ (fun q => σ * (match q.1 with | none => (-1 : ℤ) | some _ => 1))
    (fun _ => 1) (fun q _ => ?_) (fun q _ => ?_) (fun _ _ => le_rfl)
    (fun x _ y _ => hG.tc _ _)
  · rw [kS_eq]; push_cast; ring
  · rcases q with ⟨_ | _, _⟩ <;> rcases hσ with rfl | rfl <;> simp

theorem gathG_GOK {I : NetComplex.Inv ind Wt} (hG : I.Good) (σ : ℤ) (hσ : σ = 1 ∨ σ = -1) :
    GOK (I.gathG ℂ (σ : ℂ)).1 :=
  egM_GOK _ _ _ _ (fun _ => σ) (fun _ => 0) (fun n _ => by simp)
    (fun _ _ => hσ) (fun _ _ => by norm_num) (fun x _ y _ => (hG.sc _ _).symm)

/-- Every gate of one invocation's schedule is `GOK`. -/
theorem named_GOK (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) {I : NetComplex.Inv ind Wt} (hG : I.Good) :
    ∀ g ∈ I.named ℂ, GOK g.2.1 := by
  intro g hg
  have e1 : ((-1 : ℂ)) = ((-1 : ℤ) : ℂ) := by push_cast; rfl
  have e2 : ((1 : ℂ)) = ((1 : ℤ) : ℂ) := by push_cast; rfl
  simp only [NetComplex.Inv.named, List.mem_append, List.mem_map, Finset.mem_toList,
    Finset.mem_univ, true_and, List.mem_singleton] at hg
  rcases hg with ((((((⟨S, rfl⟩ | rfl) | ⟨t, rfl⟩) | rfl) | rfl) | ⟨S, rfl⟩) | rfl) | ⟨t, rfl⟩
  · rw [e1]; exact sideG_GOK hcard hinj hG _ (Or.inr rfl) S
  · rw [e1]; exact scatG_GOK hG _ (Or.inr rfl)
  · rw [e2]; exact copyG_GOK hG _ (Or.inl rfl) t
  · rw [e2]; exact gathG_GOK hG _ (Or.inl rfl)
  · rw [e2]; exact scatG_GOK hG _ (Or.inl rfl)
  · rw [e2]; exact sideG_GOK hcard hinj hG _ (Or.inl rfl) S
  · rw [e1]; exact gathG_GOK hG _ (Or.inr rfl)
  · rw [e1]; exact copyG_GOK hG _ (Or.inr rfl) t

/-- **Every gate of the three-stage complex schedule is a dyadic `GOK` gate.** -/
theorem cxNamed_GOK (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) : ∀ g ∈ NetComplex.cxNamed ℂ ind, GOK g.2.1 := by
  intro g hg
  simp only [NetComplex.cxNamed, List.mem_flatMap, List.mem_map] at hg
  obtain ⟨j, _, p, _, g', hg', rfl⟩ := hg
  have hG := NetComplex.inv_good (ind := ind) j p
  unfold NetComplex.schedJ at hg'
  split_ifs at hg'
  · simp only [NetComplex.invNamed, List.mem_reverse, List.mem_map] at hg'
    obtain ⟨g'', hg'', rfl⟩ := hg'
    exact GOK_inv (named_GOK hcard hinj hG g'' hg'')
  · exact named_GOK hcard hinj hG g' hg'

/-- The sign gate is diagonal `±1`. -/
theorem fixG_diag :
    (NetComplex.fixG ℂ ind).1 = Matrix.diagonal fun w =>
      if w ∈ (Finset.univ.image (NetComplex.wX (ind := ind))) then -1 else 1 := by
  ext p q
  simp only [NetComplex.fixG]
  rw [Matrix.add_apply, NetComplex.egM_apply, Matrix.diagonal_apply,
    Matrix.one_apply]
  by_cases hpq : p = q
  · subst hpq
    simp only [if_true]
    by_cases hx : p ∈ Finset.univ.image (NetComplex.wX (ind := ind))
    · obtain ⟨a, -, rfl⟩ := Finset.mem_image.1 hx
      rw [if_pos hx, Finset.sum_eq_single a]
      · simp; norm_num
      · intro b _ hb; simp [NetComplex.wX, hb]
      · simp
    · rw [if_neg hx, Finset.sum_eq_zero]
      · simp
      · intro a _
        rw [if_neg]
        rintro ⟨h1, -⟩
        exact hx (Finset.mem_image.2 ⟨a, Finset.mem_univ _, h1⟩)
  · rw [if_neg hpq, if_neg hpq, zero_add, Finset.sum_eq_zero]
    intro a _
    rw [if_neg]
    rintro ⟨h1, h2⟩
    exact hpq (h1.symm.trans h2)

/-- Classification of the gates of the corrected complex network. -/
theorem cxFixNamed_class (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) (g) (hg : g ∈ NetComplex.cxFixNamed ℂ ind) :
    GOK g.2.1 ∨ g.2.1 = (NetComplex.fixG ℂ ind).1 := by
  simp only [NetComplex.cxFixNamed, List.mem_append, List.mem_map, List.mem_singleton] at hg
  rcases hg with ⟨g', hg', rfl⟩ | rfl
  · exact Or.inl (cxNamed_GOK hcard hinj g' hg')
  · exact Or.inr rfl

end Complex

section Steps

open P8Lift

variable {R : Type} [Fintype R] [DecidableEq R]

theorem not_gate_rowAddsFor {m : ℕ} (w : R) (hh : Fin m) (js : List (Fin m)) (G : Matrix R R ℂ) :
    RStep.gate G ∉ rowAddsFor w hh js := by
  intro hm
  simp only [rowAddsFor, List.mem_flatMap] at hm
  obtain ⟨j, -, hj⟩ := hm
  split_ifs at hj
  · simp at hj
  · simp at hj

theorem not_gate_chunkFor {m : ℕ} (w : R) (ε : ℤ) (v : Fin m → ZMod 2) (G : Matrix R R ℂ) :
    RStep.gate G ∉ chunkFor w ε v := by
  intro hm
  unfold chunkFor at hm
  split_ifs at hm
  · simp only [List.mem_append, List.mem_singleton] at hm
    rcases hm with (h1 | h1) | h1
    · exact not_gate_rowAddsFor _ _ _ _ h1
    · cases h1
    · exact not_gate_rowAddsFor _ _ _ _ h1
  · simp at hm

theorem not_gate_edgeSteps {h : ℕ} (w : R) (V U : Submodule (ZMod 2) (NetComplexP8.Vc h))
    (G : Matrix R R ℂ) : RStep.gate G ∉ edgeSteps w V U := by
  intro hm
  simp only [edgeSteps, frameSteps, List.mem_flatMap] at hm
  obtain ⟨p, -, hp⟩ := hm
  exact not_gate_chunkFor _ _ _ _ hp

theorem gate_mem_netSteps {h : ℕ} (G : Matrix R R ℂ) :
    ∀ (gs : List (AModel.NGate R ℂ (NetComplexP8.LabG h))) (lab Mout : R → NetComplexP8.LabG h),
      RStep.gate G ∈ netSteps gs lab Mout → ∃ g ∈ gs, G = g.1
  | [], lab, Mout, hm => by
    simp only [netSteps, List.mem_flatMap] at hm
    obtain ⟨w, -, hw⟩ := hm
    exact absurd hw (not_gate_edgeSteps _ _ _ _)
  | g :: gs, lab, Mout, hm => by
    simp only [netSteps, gateSteps, List.mem_append, List.mem_flatMap, List.mem_singleton] at hm
    rcases hm with (⟨w, -, hw⟩ | h1) | h2
    · exact absurd hw (not_gate_edgeSteps _ _ _ _)
    · cases h1; exact ⟨g, List.mem_cons_self, rfl⟩
    · obtain ⟨g', hg', e⟩ := gate_mem_netSteps G gs _ Mout h2
      exact ⟨g', List.mem_cons_of_mem _ hg', e⟩

end Steps

open P8Lift in
/-- A gate step of `prog ind` is a gate of `cxFixNamed`. -/
theorem gate_mem_prog {h : ℕ} {T : Type} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}
    (G : Matrix (NetComplex.Wr ind) (NetComplex.Wr ind) ℂ) (hm : RStep.gate G ∈ prog ind) :
    ∃ g ∈ NetComplex.cxFixNamed ℂ ind, G = g.2.1 := by
  simp only [prog, List.mem_append, List.mem_flatMap, List.mem_singleton] at hm
  rcases hm with ((⟨w, -, hw⟩ | hn) | ⟨w, -, hw⟩) | hp
  · rcases w with a | a | s <;> simp [preSteps] at hw
  · obtain ⟨g, hg, rfl⟩ := gate_mem_netSteps G _ _ _ hn
    simp only [NetComplexP8.gatesF, NetComplex.labelled, List.mem_map] at hg
    obtain ⟨g', hg', rfl⟩ := hg
    exact ⟨g', hg', rfl⟩
  · rcases w with a | a | (s | s) <;> simp [postSteps] at hw
  · cases hp

end NLogN.KFN

