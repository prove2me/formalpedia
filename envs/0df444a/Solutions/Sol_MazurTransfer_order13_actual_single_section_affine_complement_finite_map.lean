Design boundary: the actual finite coordinate scheme maps to the actual
glued curve with exact ordinary and reciprocal restrictions and exact
section-complement image. Named downstream consumer: proving this comparison
an open immersion and constructing the affine complement isomorphism.
-/

noncomputable section
universe u
namespace MazurTransfer.Order13SingleSectionFiniteAlgebra
open CategoryTheory Limits AlgebraicGeometry
open MazurTorsion.XOneThirteenProjectiveCurve
open Order13ActualPositiveInfinityComplement
variable (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]

theorem finiteScheme_mixed_chart_curve_compatibility (h104 : IsUnit (104 : R)) :
    pullback.fst (ordinaryToFiniteAffineScheme R) (reciprocalToFiniteAffineScheme R h104) ≫
      ordinaryChartMap R =
    pullback.snd (ordinaryToFiniteAffineScheme R) (reciprocalToFiniteAffineScheme R h104) ≫
      reciprocalPatchChartMap R := by
  have h := (ordinaryInfinityOverlap_isPullback R h104).flip
  apply (cancel_epi h.isoPullback.hom).mp
  simpa only [← Category.assoc,IsPullback.isoPullback_hom_fst,IsPullback.isoPullback_hom_snd]
    using finiteScheme_concrete_overlap_curve_compatibility R h104

def finiteSchemeChartToCurve : (b : Bool) → finiteSchemeChart R b ⟶ curveScheme R
  | true => ordinaryChartMap R
  | false => reciprocalPatchChartMap R

theorem finiteScheme_chart_curve_compatibility (h104 : IsUnit (104 : R)) (i j : Bool) :
    pullback.fst (finiteSchemeChartMap R h104 i) (finiteSchemeChartMap R h104 j) ≫
      finiteSchemeChartToCurve R i =
    pullback.snd (finiteSchemeChartMap R h104 i) (finiteSchemeChartMap R h104 j) ≫
      finiteSchemeChartToCurve R j := by
  cases i with
  | false =>
    cases j with
    | false =>
      let := reciprocalToFiniteAffineScheme_isOpenImmersion R h104
      have he : pullback.fst (reciprocalToFiniteAffineScheme R h104)
          (reciprocalToFiniteAffineScheme R h104) = pullback.snd _ _ :=
        (cancel_mono (reciprocalToFiniteAffineScheme R h104)).mp pullback.condition
      change pullback.fst (reciprocalToFiniteAffineScheme R h104) (reciprocalToFiniteAffineScheme R h104) ≫ reciprocalPatchChartMap R = pullback.snd (reciprocalToFiniteAffineScheme R h104) (reciprocalToFiniteAffineScheme R h104) ≫ reciprocalPatchChartMap R
      rw [he]
    | true =>
      change pullback.fst (reciprocalToFiniteAffineScheme R h104) (ordinaryToFiniteAffineScheme R) ≫
        reciprocalPatchChartMap R = pullback.snd (reciprocalToFiniteAffineScheme R h104)
          (ordinaryToFiniteAffineScheme R) ≫ ordinaryChartMap R
      apply (cancel_epi (pullbackSymmetry (ordinaryToFiniteAffineScheme R)
        (reciprocalToFiniteAffineScheme R h104)).hom).mp
      rw [← Category.assoc,← Category.assoc,
        pullbackSymmetry_hom_comp_fst,pullbackSymmetry_hom_comp_snd]
      exact (finiteScheme_mixed_chart_curve_compatibility R h104).symm
  | true =>
    cases j with
    | false => exact finiteScheme_mixed_chart_curve_compatibility R h104
    | true =>
      let := ordinaryToFiniteAffineScheme_isOpenImmersion R (two_isUnit_of_104 R h104)
      have he : pullback.fst (ordinaryToFiniteAffineScheme R)
          (ordinaryToFiniteAffineScheme R) = pullback.snd _ _ :=
        (cancel_mono (ordinaryToFiniteAffineScheme R)).mp pullback.condition
      change pullback.fst (ordinaryToFiniteAffineScheme R) (ordinaryToFiniteAffineScheme R) ≫ ordinaryChartMap R = pullback.snd (ordinaryToFiniteAffineScheme R) (ordinaryToFiniteAffineScheme R) ≫ ordinaryChartMap R
      rw [he]

def finiteModelToCurve (h104 : IsUnit (104 : R)) : finiteAffineScheme R ⟶ curveScheme R :=
  (finiteSchemeOpenCover R h104).glueMorphisms (finiteSchemeChartToCurve R)
    (finiteScheme_chart_curve_compatibility R h104)

theorem ordinaryToFiniteAffineScheme_finiteModelToCurve (h104 : IsUnit (104 : R)) :
    ordinaryToFiniteAffineScheme R ≫ finiteModelToCurve R h104 = ordinaryChartMap R :=
  (finiteSchemeOpenCover R h104).ι_glueMorphisms _ _ true

theorem reciprocalToFiniteAffineScheme_finiteModelToCurve (h104 : IsUnit (104 : R)) :
    reciprocalToFiniteAffineScheme R h104 ≫ finiteModelToCurve R h104 = reciprocalPatchChartMap R :=
  (finiteSchemeOpenCover R h104).ι_glueMorphisms _ _ false

theorem finiteModelToCurve_range (h104 : IsUnit (104 : R)) :
    Set.range (finiteModelToCurve R h104) =
      Set.range (ordinaryChartMap R) ∪ Set.range (reciprocalPatchChartMap R) := by
  ext q
  constructor
  · rintro ⟨p,rfl⟩
    have hp : p ∈ Set.range (ordinaryToFiniteAffineScheme R) ∪
        Set.range (reciprocalToFiniteAffineScheme R h104) := by
      rw [finiteScheme_two_chart_range_cover]
      trivial
    rcases hp with ⟨a,rfl⟩ | ⟨a,rfl⟩
    · rw [← Scheme.Hom.comp_apply,ordinaryToFiniteAffineScheme_finiteModelToCurve]
      exact Or.inl ⟨a,rfl⟩
    · rw [← Scheme.Hom.comp_apply,reciprocalToFiniteAffineScheme_finiteModelToCurve]
      exact Or.inr ⟨a,rfl⟩
  · rintro (⟨a,rfl⟩ | ⟨a,rfl⟩)
    · refine ⟨ordinaryToFiniteAffineScheme R a,?_⟩
      rw [← Scheme.Hom.comp_apply,ordinaryToFiniteAffineScheme_finiteModelToCurve]
    · refine ⟨reciprocalToFiniteAffineScheme R h104 a,?_⟩
      rw [← Scheme.Hom.comp_apply,reciprocalToFiniteAffineScheme_finiteModelToCurve]

theorem finiteModelToCurve_range_eq_section_complement (h104 : IsUnit (104 : R)) :
    Set.range (finiteModelToCurve R h104) =
      (Set.range (Order13IntegralSections.infinityMorphism R 1 (by simp)))ᶜ := by
  rw [finiteModelToCurve_range]
  exact sectionComplementOpen_eq_section_image_complement R

end MazurTransfer.Order13SingleSectionFiniteAlgebra
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.finiteModelToCurve
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.finiteModelToCurve_range_eq_section_complement

end
