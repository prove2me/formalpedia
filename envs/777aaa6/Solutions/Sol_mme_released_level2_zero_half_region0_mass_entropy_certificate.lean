theorem solution :
    ((2090774427307984000000000000000000000000000000000000000000000 : ℕ) : ℝ) ≤
      ∑ c : {c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 0) // ∃ j, (c.2.val j).val = 0},
        (MME.RegionRate.massEntropy (fun w ↦ (RecStage.mu3 0
            (if (c.1.2.val 0).val = 0 then 1 else if (c.1.2.val 1).val = 0 then 2 else 0)
            c.1 w : ℝ)) +
          ((∑ w, RecStage.mu3 0
            (if (c.1.2.val 0).val = 0 then 1 else if (c.1.2.val 1).val = 0 then 2 else 0)
            c.1 w * Boundary.ones w : ℕ) : ℝ) * Real.log 5) := by
  have hs := sum_ok
  have h1 : ((∑ z : Z, g z : ℚ) : ℝ) ≤ ∑ z : Z,
      (MME.RegionRate.massEntropy (fun w ↦ (RecStage.mu3 0 (md z.1) z.1 w : ℝ)) +
        ((∑ w, RecStage.mu3 0 (md z.1) z.1 w * Boundary.ones w : ℕ) : ℝ) * Real.log 5) := by
    rw [Rat.cast_sum]
    exact Finset.sum_le_sum (fun z _ ↦ cell_bound z)
  have h2 : ((2090774427307984000000000000000000000000000000000000000000000 : ℕ) : ℝ) ≤ ((∑ z : Z, g z : ℚ) : ℝ) := by exact_mod_cast hs
  exact h2.trans h1
