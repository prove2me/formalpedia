-- title:
--   Formal node structure passes to a layer over a DVR extension
-- statement:
--   Write $\widehat{R}$ for the adic completion of a local ring $R$ at its maximal ideal, and for a commutative ring $W$ and $\pi\in W$ write $W[[U,V]]/(UV-\pi)$ for the quotient of $\mathrm{MvPowerSeries}\,(\mathrm{Fin}\,2)\,W$ by the ideal generated by $X_0X_1-C(\pi)$, with $\mathrm{const}$ denoting the class of a constant power series. Let $N_0$ be a noetherian local ring, let $W$ be a complete discrete valuation domain (adically complete at its maximal ideal) with an irreducible element $\pi$, let $\sigma : W \to \widehat{N_0}$ be a ring homomorphism, let $\varpi \in N_0$ satisfy $\sigma(\pi) =$ the image of $\varpi$ in $\widehat{N_0}$, let $E \ge 1$, and let $\iota : \widehat{N_0} \cong W[[U,V]]/(UV-\pi^E)$ be a ring isomorphism with $\iota(\sigma(o)) = \mathrm{const}(\pi^E,o)$ for all $o \in W$. Let $N_1$ be a noetherian local ring, $f : N_0 \to N_1$ a local homomorphism, $C'$ a commutative ring, $c' : C' \to N_1$ a ring homomorphism, $\varpi' \in C'$ and $e \in \mathbb{N}$ such that $f(\varpi) = v\,c'(\varpi')^e$ for some unit $v$ of $N_1$, such that every $g \in N_1$ satisfies $g - c'(o)$ non-unit for some $o \in C'$, such that $\mathfrak m_{N_1} \subseteq \mathfrak m_{N_0}N_1 + (c'(\varpi'))$, and such that $\mathrm{ringKrullDim}\,N_1 \ge 2$. Finally let $W'$ be a complete discrete valuation domain with an irreducible element $\pi'$ and $j : C' \to W'$ a ring homomorphism with $j(\varpi') = \pi'$, with $j(c) \in (\pi'^n)$ implying $c \in (\varpi'^n)$ for all $n$ and $c$, and with every $w \in W'$ congruent to some $j(c)$ modulo $(\pi'^n)$ for every $n$. Then there exist a ring homomorphism $\sigma' : W' \to \widehat{N_1}$ and a ring isomorphism $\iota' : \widehat{N_1} \cong W'[[U,V]]/(UV-\pi'^{eE})$ such that $\sigma'(j(c))$ is the image of $c'(c)$ in $\widehat{N_1}$ for every $c \in C'$, and $\iota'(\sigma'(o)) = \mathrm{const}(\pi'^{eE},o)$ for every $o \in W'$.
--
--   This is a ring-theoretic form of the base-change statement for an ordinary double point (Liu, Algebraic Geometry and Arithmetic Curves, 10.3.22): a formal node presentation of $\widehat{N_0}$ of thickness $E$ over $W$ propagates to a presentation of $\widehat{N_1}$ of thickness $eE$ over $W'$, the ramification index $e$ being read off from $f(\varpi) = v\,c'(\varpi')^e$. It is used in the passage from a semistable model over a non-discrete valuation ring to noetherian layers, where the node structure of the completed local rings at a double point is needed at each finite level; it is cited by the results on node ring layers, on primes of the node chart, and on integral closedness of pullback stalks.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_IsLocalRing_exists_ringEquiv_adicCompletion_uvCrossingModel_of_isLocalHom_of_layer.lean

import Mathlib
import Definitions.Def_ModularCurve_UVCrossingModel

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open IsLocalRing ModularCurve ModularCurve.UVCrossingModel

theorem IsLocalRing.exists_ringEquiv_adicCompletion_uvCrossingModel_of_isLocalHom_of_layer

    {N₀ : Type*} [CommRing N₀] [IsLocalRing N₀] [IsNoetherianRing N₀]
    {W : Type*} [CommRing W] [IsDomain W] [IsDiscreteValuationRing W] [IsAdicComplete (maximalIdeal W) W]
    (π : W) (hπ : Irreducible π)
    (σ : W →+* AdicCompletion (maximalIdeal N₀) N₀)
    (ϖ : N₀) (hσπ : σ π = algebraMap N₀ (AdicCompletion (maximalIdeal N₀) N₀) ϖ)
    (E : ℕ) (hE : 1 ≤ E)
    (ι : AdicCompletion (maximalIdeal N₀) N₀ ≃+* UVCrossingModel W (π ^ E))
    (hconst : ∀ o : W, ι (σ o) = const (π ^ E) o)

    {N₁ : Type*} [CommRing N₁] [IsLocalRing N₁] [IsNoetherianRing N₁]
    (f : N₀ →+* N₁) [IsLocalHom f]
    {C' : Type*} [CommRing C'] (c' : C' →+* N₁) (ϖ' : C')
    (e : ℕ) (hϖe : ∃ v : N₁, IsUnit v ∧ f ϖ = v * c' ϖ' ^ e)
    (hres' : ∀ g : N₁, ∃ o : C', ¬ IsUnit (g - c' o))
    (hgen' : maximalIdeal N₁ ≤ (maximalIdeal N₀).map f ⊔ Ideal.span {c' ϖ'})
    (hdim : 2 ≤ ringKrullDim N₁)

    {W' : Type*} [CommRing W'] [IsDomain W'] [IsDiscreteValuationRing W'] [IsAdicComplete (maximalIdeal W') W']
    (π' : W') (hπ' : Irreducible π') (j : C' →+* W') (hjϖ : j ϖ' = π')
    (hjinj : ∀ (n : ℕ) (c : C'), j c ∈ Ideal.span {π' ^ n} → c ∈ Ideal.span {ϖ' ^ n})
    (hjsur : ∀ (n : ℕ) (w : W'), ∃ c : C', w - j c ∈ Ideal.span {π' ^ n}) :
    ∃ (σ' : W' →+* AdicCompletion (maximalIdeal N₁) N₁)
      (ι' : AdicCompletion (maximalIdeal N₁) N₁ ≃+* UVCrossingModel W' (π' ^ (e * E))),
      (∀ c : C', σ' (j c) = algebraMap N₁ (AdicCompletion (maximalIdeal N₁) N₁) (c' c)) ∧
      (∀ o : W', ι' (σ' o) = const (π' ^ (e * E)) o) := by sorry
