section LA

variable {n : ℕ}

theorem dot_sum {k : ℕ} (a : (Fin n → ZMod 2)) (c : Fin k → ZMod 2) (v : Fin k → (Fin n → ZMod 2)) :
    a ⬝ᵥ (∑ i, c i • v i) = ∑ i, c i * (a ⬝ᵥ v i) := by
  rw [dotProduct_sum]
  simp [dotProduct_smul]

theorem nondeg_of_dual_sol_aux {k : ℕ} {b d : Fin k → (Fin n → ZMod 2)} (hd : ∀ j, d j ∈ spanF b)
    (hdb : ∀ j i, d j ⬝ᵥ b i = if i = j then 1 else 0) : NondegF (spanF b) := by
  intro x hx hperp
  obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hx
  have hc : ∀ j, c j = 0 := by
    intro j
    have h1 := hperp (d j) (hd j)
    rw [dotProduct_comm, dot_sum] at h1
    simpa [hdb, Finset.sum_ite_eq'] using h1
  simp [hc]

end LA

