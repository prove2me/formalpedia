    I.hpts_gal I.uH I.H₁ I.e₁ I.he₁_mul I.he₁_nat I.t₁H I.ht₁H I.huH_pts).elim fun eG hc1 => ?_
  have heG_add := hc1.1
  have heG_gal := hc1.2.1
  have hφ_aug := hc1.2.2.1
  have hφ_act := hc1.2.2.2.1
  have heG_pts := hc1.2.2.2.2
  have heG_red := ModularCurve.reductionModL_clause_of_relJacobian_torsionModel M p I.L I.hJ I.pts
