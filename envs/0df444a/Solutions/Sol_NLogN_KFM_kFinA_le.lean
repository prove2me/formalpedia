open AModel AModelL12 IntMul KIL KFB KFT KFU RS IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.RC IntMul.OpenAI.Glue
  IntMul.OpenAI.RCost

noncomputable section

theorem sCmp_eq {n D : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (hD : IntMul.OpenAI.Glue.dP n = D + 1) (hlt : ∀ i, sBD n D i < tBD n D i) :
    sCmp n = ∏ i, sBD n D i := by
  have hLb := (setup_facts hn).2.2.2.2.2.1
  have e1 : ∏ j ∈ Finset.range (IntMul.OpenAI.Glue.dP n), srcN n j = ∏ i, sBD n D i := by
    rw [hD, ← Fin.prod_univ_eq_prod_range]; rfl
  have h2 : ∏ i, sBD n D i ≤ ∏ i, tBD n D i :=
    Finset.prod_le_prod (fun i _ => Nat.zero_le _) (fun i _ => (hlt i).le)
  rw [KFQ.prod_tBD hn hD, IntMul.OpenAI.Glue.TP] at h2
  have h3 : 2 ^ IntMul.OpenAI.Glue.LP n < 2 ^ bP n := Nat.pow_lt_pow_right (by norm_num) hLb
  unfold sCmp; rw [e1]; exact Nat.mod_eq_of_lt (by omega)

end

end NLogN.KFM

end

