-- Source module: Solutions.J6SieveStep
/-!
# J6Sieve, part 3: one greedy step

If `Q` is a set of at most `Ω + 1` primes, all `> z = 4(Ω+1)`, and `H` exceeds the
explicit bound, then every interval `(A, A+H]` contains a `z`-rough integer
divisible by no element of `Q`.
-/

namespace J6Sieve
open Finset

/-- The greedy step. -/
theorem step (d X H A : ℕ) (Q : Finset ℕ) (hQp : ∀ q ∈ Q, q.Prime)
    (hQz : ∀ q ∈ Q, q ∉ P (zz d X)) (hQc : Q.card ≤ Om d X + 1) (hH : sieveBound d X < H) :
    ∃ n, A < n ∧ n ≤ A + H ∧ rough (zz d X) n ∧ ∀ q ∈ Q, ¬ q ∣ n :=
  step_core (zz d X) (Om d X) (kk d X) (mm d X) H A Q rfl
    (Nat.lt_pow_succ_log_self (by norm_num) _) rfl hQp hQz hQc hH

end J6Sieve

end

section
-- Source module: Solutions.J6Sieve
/-!
# J6Sieve: pairwise coprime odd numbers in short windows

Elementary (Brun pure sieve + greedy) construction: if `d` windows `(A_i, A_i + H]` lie in
`(0, X]` and `H > sieveBound d X`, one can choose odd, pairwise coprime `s_i` in them.
`sieveBound d X < 2 ^ (4 * (log₂ (4 (d (log₂ X + 1) + 1)) + 2)^2)`.
-/

namespace J6Sieve
open Finset

lemma card_primeFactors_le_log (s : ℕ) (hs : s ≠ 0) : s.primeFactors.card ≤ Nat.log 2 s := by
  apply Nat.le_log_of_pow_le (by norm_num)
  calc 2 ^ s.primeFactors.card ≤ ∏ p ∈ s.primeFactors, p :=
        Finset.pow_card_le_prod _ _ _ fun p hp => (Nat.prime_of_mem_primeFactors hp).two_le
    _ ≤ s := Nat.le_of_dvd (Nat.pos_of_ne_zero hs) (Nat.prod_primeFactors_dvd s)

/-- Greedy construction over the first `k` windows. -/
theorem greedy_sol_aux (d X H : ℕ) (A : ℕ → ℕ) (hA : ∀ i < d, A i + H ≤ X)
    (hH : sieveBound d X < H) :
    ∀ k ≤ d, ∃ s : ℕ → ℕ, (∀ i < k, rough (zz d X) (s i) ∧ A i < s i ∧ s i ≤ A i + H) ∧
      ∀ i < k, ∀ j < k, i ≠ j → Nat.Coprime (s i) (s j) := by
  intro k
  induction k with
  | zero => intro _; exact ⟨fun _ => 0, by simp, by simp⟩
  | succ k ih =>
    intro hk
    obtain ⟨s, hs, hcop⟩ := ih (by omega)
    set Q := (range k).biUnion (fun i => (s i).primeFactors) with hQ
    have hs0 : ∀ i < k, s i ≠ 0 := fun i hi => by have := (hs i hi).2.1; omega
    have hQp : ∀ q ∈ Q, q.Prime := by
      intro q hq
      obtain ⟨i, _, hi⟩ := mem_biUnion.1 hq
      exact Nat.prime_of_mem_primeFactors hi
    have hQz : ∀ q ∈ Q, q ∉ P (zz d X) := by
      intro q hq hqP
      obtain ⟨i, hik, hi⟩ := mem_biUnion.1 hq
      exact (hs i (mem_range.1 hik)).1 q hqP (Nat.dvd_of_mem_primeFactors hi)
    have hQc : Q.card ≤ Om d X + 1 := by
      refine card_biUnion_le.trans ?_
      calc ∑ i ∈ range k, (s i).primeFactors.card ≤ ∑ _i ∈ range k, Nat.log 2 X := by
            apply sum_le_sum; intro i hi
            have hi' := mem_range.1 hi
            refine (card_primeFactors_le_log _ (hs0 i hi')).trans (Nat.log_mono_right ?_)
            have := (hs i hi').2.2; have := hA i (by omega); omega
        _ = k * Nat.log 2 X := by simp
        _ ≤ d * (Nat.log 2 X + 1) := Nat.mul_le_mul (by omega) (by omega)
        _ ≤ Om d X + 1 := by simp [Om]
    obtain ⟨n, hn1, hn2, hnr, hnQ⟩ := step d X H (A k) Q hQp hQz hQc hH
    have hncop : ∀ i < k, Nat.Coprime (s i) n := by
      intro i hi
      apply Nat.coprime_of_dvd
      intro p hp hpi hpn
      exact hnQ p (mem_biUnion.2 ⟨i, mem_range.2 hi,
        Nat.mem_primeFactors.2 ⟨hp, hpi, hs0 i hi⟩⟩) hpn
    refine ⟨fun i => if i = k then n else s i, ?_, ?_⟩
    · intro i hi
      by_cases hik : i = k
      · subst hik; simp only [if_true]; exact ⟨hnr, hn1, hn2⟩
      · simp only [if_neg hik]; exact hs i (by omega)
    · intro i hi j hj hij
      by_cases hik : i = k
      · subst hik
        have hjk : j ≠ i := fun h => hij h.symm
        simp only [if_true, if_neg hjk]
        exact (hncop j (by omega)).symm
      · by_cases hjk : j = k
        · subst hjk; simp only [if_true, if_neg hik]; exact hncop i (by omega)
        · simp only [if_neg hik, if_neg hjk]; exact hcop i (by omega) j (by omega) hij

end J6Sieve

end

theorem solution : type_of% @J6Sieve.greedy_sol_aux := @J6Sieve.greedy_sol_aux
