-- url     : https://prove2.me/theorems/79f9516d-d060-4576-a506-14f8680b8fee
-- title:
--   (9), proof of Theorem 4, p. 6 — Σ_{k=N₀}^{N}|x^{k+1} − x^k| ≤ (r/(1−r))|x^{N₀} − x^{N₀−1}| + (M/(r(1−r)))[(f(x^{N₀}) − ℓ)^{1−θ} − (f(x^{N+1}) − ℓ)^{1−θ}]
-- statement:
--   Throughout, $f:\mathbb R^n\to\mathbb R\cup\{+\infty\}$ is proper and lower semicontinuous, $\partial f$ is the limiting subdifferential, $\operatorname{crit} f=\{x: 0\in\partial f(x)\}$, and $(x^k)_{k\in\mathbb N}$ is generated by the proximal algorithm
--   $$x^{k+1}\in\operatorname{argmin}\Big\{f(u)+\frac{1}{2\lambda_k}|u-x^k|^2 : u\in\mathbb R^n\Big\}\qquad(2)$$
--   from an arbitrary $x^0\in\mathbb R^n$, with step sizes $\lambda_k\in(\lambda_-,\lambda_+)$ for fixed $0<\lambda_-<\lambda_+<+\infty$.
--
--   Assume that $f$ satisfies (H1), that $x^{k+1}\ne x^k$ for every $k$, and let $\ell=\inf_{k\ge0}f(x^k)$. Suppose that $\theta\in(0,1)$, $M>0$ and an integer $N_0\ge1$ satisfy (8):
--   $$\frac{|x^{k+1}-x^k|^2}{|x^k-x^{k-1}|}\le M\Big(\big(f(x^k)-\ell\big)^{1-\theta}-\big(f(x^{k+1})-\ell\big)^{1-\theta}\Big)\qquad(k\ge N_0).$$
--   Then for every $r\in(0,1)$ and every $N\ge N_0$,
--   $$\sum_{k=N_0}^{N}|x^{k+1}-x^k|\le\frac{r}{1-r}|x^{N_0}-x^{N_0-1}|+\frac{M}{r(1-r)}\Big[\big(f(x^{N_0})-\ell\big)^{1-\theta}-\big(f(x^{N+1})-\ell\big)^{1-\theta}\Big].\qquad(9)$$
--
--   Since the bracket is bounded independently of $N$, (9) yields the finite length of the proximal sequence.
--
--   **Formalization Note** (8) is taken as a hypothesis with its data $\theta,M,N_0$; (H2), (H3) and boundedness are then not needed and are dropped. The hypothesis $x^{k+1}\ne x^k$ is the proof's reduction, as in (8). On the page $f$ has been shifted by $\ell$.
-- source:
--   Attouch & Bolte, On the convergence of the proximal algorithm for nonsmooth functions involving analytic features, author's version hal-00803898v1, p. 6, proof of Theorem 4, display (9) (with the case analysis on p. 5–6)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonsmoothLojasiewicz_Continuous_slope
import Definitions.Def_ProxLoj_Conv_Setting

open Filter Topology NonconvexSplitting.Shared NonsmoothLojasiewicz.Continuous

namespace ProxLoj.Conv

/-- (9), proof of Theorem 4, p. 6: from (8), for every `r ∈ (0, 1)` and `N ≥ N₀`,
`Σ_{k=N₀}^{N} ‖x^{k+1} - x^k‖ ≤ r/(1-r) ‖x^{N₀} - x^{N₀-1}‖
  + M/(r(1-r)) ((f(x^{N₀}) - ℓ)^{1-θ} - (f(x^{N+1}) - ℓ)^{1-θ})`. -/
theorem eq_9 {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → EReal) (hproper : IsProper f)
    (hH1 : H1 f) (lam : ℕ → ℝ) (lamMinus lamPlus : ℝ) (hstep : StepBounds lam lamMinus lamPlus)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hx : IsProxRun f lam x)
    (hne : ∀ k, x (k + 1) ≠ x k) (ℓ : ℝ) (hℓ : ℓ = (⨅ k, f (x k)).toReal)
    (θ M : ℝ) (N0 : ℕ) (hθ : 0 < θ ∧ θ < 1) (hM : 0 < M) (hN0 : 1 ≤ N0)
    (h8 : ∀ k, N0 ≤ k → ‖x (k + 1) - x k‖ ^ 2 / ‖x k - x (k - 1)‖ ≤
      M * (((f (x k)).toReal - ℓ) ^ (1 - θ) - ((f (x (k + 1))).toReal - ℓ) ^ (1 - θ))) :
    ∀ r : ℝ, 0 < r → r < 1 → ∀ N : ℕ, N0 ≤ N →
      ∑ k ∈ Finset.Icc N0 N, ‖x (k + 1) - x k‖ ≤
        r / (1 - r) * ‖x N0 - x (N0 - 1)‖ +
          M / (r * (1 - r)) *
            (((f (x N0)).toReal - ℓ) ^ (1 - θ) - ((f (x (N + 1))).toReal - ℓ) ^ (1 - θ)) := by sorry

end ProxLoj.Conv
