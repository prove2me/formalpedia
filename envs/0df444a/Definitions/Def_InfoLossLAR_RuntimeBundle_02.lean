def floorValue (q : ℚ) : ℕ := if q<0 then 0 else q.num.natAbs/q.den







def dyadicPower (xs : List Unit) : ℕ := 2^xs.length


def dyadicFloor (x : ℚ × List Unit) : ℕ := ⌊(2 : ℚ)^x.2.length*x.1⌋₊


def natSum (xs : List ℕ) : ℕ := xs.sum


def clipped (q : ℚ) : ℚ := if q<0 then 0 else if q<1 then q else 1




def tapeValue (xs : List Bool) : ℕ := _root_.AFT.BinaryArithmetic.value xs


def ticks (xs : List Bool) : List Unit := xs.map (fun _ => ())


