/-- **The adapter.** -/
theorem ad_runs_sol_aux {I : List Sym} {tab : Fin 1 → IStmt HS 1} (m k M Bb : ℕ)
    (hM : zsz (M : ℤ) ≤ Bb) (hkM : m ^ k ≤ M) (hmM : m ≤ M) (hm : 1 ≤ m) (hk : k ≤ M)
    (t : IState HS) (R1 : List Item) (hJ : t.G dJ = .int (k : ℤ) :: R1) (X Y : List Item) (c0 : ℕ)
    (hcall : ∀ t' : IState HS, t'.G dJ = .int (-1) :: t.G dJ →
      t'.G dT = .int ((m ^ k : ℕ) : ℤ) :: t.G dT → (∀ j, j ≠ dJ → j ≠ dT → t'.G j = t.G j) →
      IRuns I tab (tab 0) (t'.upd 0 X) (t'.upd 0 Y) c0) :
    IRuns I tab (adS m) (t.upd 0 X) (t.upd 0 Y) (cAd m k Bb c0) := by
  set s1 := t.upd dJ R1 with hs1
  set F : Fin HS → List ℤ := Function.update (fun _ => []) dJ [(k : ℤ)] with hF
  have hF0 : F 0 = [] := by simp +decide [F]
  have hT : ∀ Z, t.upd 0 Z = encK (s1.upd 0 Z) F := by
    intro Z
    rw [← encK_upd0_free hF0]
    congr 1
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases hj : j = dJ
    · subst hj; simp +decide [F, s1, hJ, ints]
    · simp +decide [F, s1, hj]
  have hM1 : 1 ≤ M := by omega
  set s := s1.upd 0 X with hs
  -- 1. the scratch register
  have S0 := Sp.pushZ s Bb [gTV] F (by decide) (by decide)
  set v0 : Fin HS → ℕ := Function.update (fun _ => 0) dJ k with hv0
  rw [regState_congr F [gTV] (v' := v0) (fun i hi => by
    simp at hi; subst hi; simp +decide [v0])] at S0
  have SA := Sp.asgs s F [gTV] hM [(gTV, NE.lit 1)] v0 (by
    simp +decide [OKA, RegsIn, NE.regs, NE.OK, NE.val, v0, Function.update_apply]
    omega)
  set v1 := evalA [(gTV, NE.lit 1)] v0 with hv1
  have v1J : v1 dJ = k := by simp +decide [v1, v0, evalA, NE.val, Function.update_apply]
  have v1T : v1 gTV = 1 := by simp +decide [v1, v0, evalA, NE.val, Function.update_apply]
  -- 2. the loop for `m ^ k`
  have SB := Sp.repA s F [gTV] hM (C := gC) (by decide) (by decide) (by simp +decide [F])
    (mulL gTV m) (by simp +decide [mulL]) (.reg dJ) trivial v1 (fun j hj => by
      simp +decide [NE.regs] at hj; subst hj
      exact ⟨by decide, Or.inr ⟨[], by simp +decide [F, v1J]⟩⟩)
    (by show v1 dJ ≤ M; rw [v1J]; exact hk)
    (by
      intro j hj
      simp only [NE.val, v1J] at hj
      rw [iter_mulL, v1T, one_mul]
      have hk2 : m ^ j * m ≤ m ^ k := by
        rw [← pow_succ]; exact Nat.pow_le_pow_right hm hj
      have hk3 : m ^ j ≤ m ^ k := Nat.pow_le_pow_right hm hj.le
      exact okA_mulL (by decide) (by decide) hmM (by simp; omega) (by simp; omega))
  simp only [NE.val, v1J] at SB
  rw [iter_mulL, v1T, one_mul] at SB
  set v2 := Function.update v1 gTV (m ^ k) with hv2
  set G := regState F v2 [gTV] with hG
  have hTop : G gTV = ((m ^ k : ℕ) : ℤ) :: F gTV := by
    rw [hG, regState_mem (by decide), hv2, Function.update_self]
  -- 3. push `m ^ k` on `dT`
  have SC := Sp.push s G (i := dT) (e := .reg gTV) (B := Bb) (by decide)
    (clean_reg (by decide)) (isInt_encK hTop) trivial
    (by show zsz ((encK _ _).top gTV) ≤ Bb; rw [top_encK hTop]; exact le_trans (zsz_nat_le hkM) hM)
  have hev : (Ex.reg gTV).eval (encK s G) = ((m ^ k : ℕ) : ℤ) := by
    simp only [Ex.eval, top_encK hTop]
  have hGT : G dT = [] := by rw [hG, regState_nmem (by decide)]; simp +decide [F]
  rw [hev, hGT] at SC
  set F2 := Function.update F dT [((m ^ k : ℕ) : ℤ)] with hF2
  have e2 : Function.update G dT [((m ^ k : ℕ) : ℤ)] = regState F2 v2 [gTV] := by
    funext j
    by_cases hj : j = dT
    · subst hj; simp +decide [hG, F2, regState]
    · simp +decide [hG, F2, regState, hj]
  rw [e2] at SC
  -- 4. drop the scratch register
  have SD := Sp.popD s Bb [gTV] F2 v2 (by decide) (by decide) (by
    intro i hi; simp at hi; subst hi
    rw [hv2, Function.update_self]; exact le_trans (zsz_nat_le hkM) hM)
  -- 5. push `-1` on `dJ`
  have SE := Sp.push s F2 (i := dJ) (e := .lit (-1)) (B := Bb) (by decide) (clean_lit _) trivial trivial
    (by
      show zsz (-1 : ℤ) ≤ Bb
      rw [zsz_neg]
      exact le_trans (zsz_nat_le hM1) hM)
  have hF2J : F2 dJ = [(k : ℤ)] := by simp +decide [F2, F]
  rw [hF2J] at SE
  set F3 := Function.update F2 dJ [Ex.eval (encK s F2) (Ex.lit (-1)), (k : ℤ)] with hF3
  have hF3J : F3 dJ = [-1, (k : ℤ)] := by simp +decide [F3, Ex.eval]
