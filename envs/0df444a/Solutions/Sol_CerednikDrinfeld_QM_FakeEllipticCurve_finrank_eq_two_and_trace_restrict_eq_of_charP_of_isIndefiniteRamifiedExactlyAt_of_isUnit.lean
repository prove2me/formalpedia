      simp only [TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_top] at h
      exact h.symm
    rw [hU]
    exact isCompact_iUnion fun i => (𝒦.isAffineOpen i).isCompact

  have hkerC : LinearMap.ker cls =
      (LinearMap.range ((OModulePresheaf.unit E.f).d 𝒦 0)).comap
        (LinearMap.ker ((OModulePresheaf.unit E.f).d 𝒦 1)).subtype := by
    ext z; rw [LinearMap.mem_ker, hker z, Submodule.mem_comap]; rfl
  have e1 : (OModulePresheaf.unit E.f).HSucc 𝒦 0 ≃ₗ[k] ↥(LinearMap.range cls) :=
    (Submodule.quotEquivOfEq _ _ hkerC.symm).trans cls.quotKerEquivRange
  have hfin : Module.finrank k ↥A₁ = 2 := by
    rw [← hrange, ← LinearEquiv.finrank_eq e1, ← OModulePresheaf.cechFinrank_succ]
    exact GoodReductionJacobian.AbelianSchemePropertyBundle.cechFinrank_unit_one_eq_of_charP
      k p E.f E.L E.comm E.bundle 2 𝒦
  refine ⟨hfin, fun m n hmn => ?_⟩

  obtain ⟨Hp, _instCR, _instHA, hfinH, hcoc, hH, hHp, e, he_mul, he_nat⟩ :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.exists_hopfAlgebra_torsion_finrank_eq_pow_and_nsmulAlgHom_eq
      k E.f E.L E.comm E.bundle 2 p (Nat.Prime.ne_zero Fact.out)
  haveI := hfinH
  haveI := hcoc

  obtain ⟨θ, hθinj, hθsurj, hθnat⟩ :=
