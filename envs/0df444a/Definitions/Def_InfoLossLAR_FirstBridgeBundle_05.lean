namespace InfoLossLAR.WorstCase

open QAlgorithms.Complexity AFT
open scoped Classical

/-- The actual independently sampled affine image of a public matrix and an error. -/
noncomputable def affineMatrixErrorLaw {q d N : ℕ} [NeZero q]
    {Ω : Type} [Fintype Ω] [Nonempty Ω]
    (samp : Ω → Matrix (Fin d) (Fin d) ℤ × (Fin d → ℤ))
    (source : _root_.AFT.FiniteDist (Fin d → ZMod q)) :
    _root_.AFT.FiniteDist (Matrix (Fin d) (Fin N) (ZMod q) × (Fin d → ZMod q)) :=
  (_root_.AFT.FiniteDist.uniform Ω).mix fun seed =>
    ((_root_.AFT.FiniteDist.uniform (Matrix (Fin d) (Fin N) (ZMod q))).prod source).map
      (fun draw => (matModq q (samp seed).1 * draw.1,
        evalAffine (samp seed).1 (samp seed).2 draw.2))

/-- The transported source as a normalized finite law, with no hidden-input dependence. -/
noncomputable def affineSourceLaw {q d : ℕ} [NeZero q]
    {Ω : Type} [Fintype Ω] [Nonempty Ω]
    (samp : Ω → Matrix (Fin d) (Fin d) ℤ × (Fin d → ℤ))
    (source : _root_.AFT.FiniteDist (Fin d → ZMod q)) : _root_.AFT.FiniteDist (Fin d → ZMod q) :=
  (_root_.AFT.FiniteDist.uniform Ω).mix fun seed => source.map
    (evalAffine (samp seed).1 (samp seed).2)









/-- The ordinary one-block LWE source retains the supplied secret explicitly. -/
noncomputable def lweBlockLaw {q d N : ℕ} [NeZero q]
    (source : _root_.AFT.FiniteDist (Fin d → ZMod q)) (secret : Fin N → ZMod q) :
    _root_.AFT.FiniteDist (Matrix (Fin d) (Fin N) (ZMod q) × (Fin d → ZMod q)) :=
  ((_root_.AFT.FiniteDist.uniform (Matrix (Fin d) (Fin N) (ZMod q))).prod source).map
    (fun draw => (draw.1, draw.1.mulVec secret + draw.2))

/-- Literal affine preprocessing of one real LWE sample. The same public
map is applied to its matrix and response, independently of the secret and error. -/
noncomputable def affineLWEBlockLaw {q d N : ℕ} [NeZero q]
    {Ω : Type} [Fintype Ω] [Nonempty Ω]
    (samp : Ω → Matrix (Fin d) (Fin d) ℤ × (Fin d → ℤ))
    (source : _root_.AFT.FiniteDist (Fin d → ZMod q)) (secret : Fin N → ZMod q) :
    _root_.AFT.FiniteDist (Matrix (Fin d) (Fin N) (ZMod q) × (Fin d → ZMod q)) :=
  (_root_.AFT.FiniteDist.uniform Ω).mix fun seed =>
    ((_root_.AFT.FiniteDist.uniform (Matrix (Fin d) (Fin N) (ZMod q))).prod source).map
      (fun draw => (matModq q (samp seed).1 * draw.1,
        evalAffine (samp seed).1 (samp seed).2 (draw.1.mulVec secret + draw.2)))
















/-- Real acceptance after applying fresh affine preprocessing independently
to each block. The secret is sampled once outside the block product. -/
noncomputable def affinePreprocessedReal {q d N : ℕ} [NeZero q]
    {Ω : Type} [Fintype Ω] [Nonempty Ω]
    (D : Family) (lam : ℕ) (pp : Str) (t : ℕ)
    (samp : Ω → Matrix (Fin d) (Fin d) ℤ × (Fin d → ℤ))
    (source : _root_.AFT.FiniteDist (Fin d → ZMod q)) : ℝ :=
  avg fun secret : Fin N → ZMod q =>
    (_root_.AFT.FiniteDist.independent (fun _ : Fin t => _root_.InfoLossLAR.WorstCase.affineLWEBlockLaw samp source secret)).expectation
      (fun table => acceptProb D (encInput lam pp (encTable table)))










/-- Ideal acceptance under the same literal finite affine preprocessor. -/
noncomputable def affinePreprocessedIdeal {q d N : ℕ} [NeZero q]
    {Ω : Type} [Fintype Ω] [Nonempty Ω]
    (D : Family) (lam : ℕ) (pp : Str) (t : ℕ)
    (samp : Ω → Matrix (Fin d) (Fin d) ℤ × (Fin d → ℤ)) : ℝ :=
  (_root_.AFT.FiniteDist.independent (fun _ : Fin t =>
    _root_.InfoLossLAR.WorstCase.affineMatrixErrorLaw (N := N) samp (_root_.AFT.FiniteDist.uniform (Fin d → ZMod q)))).expectation
      (fun table => acceptProb D (encInput lam pp (encTable table)))



/-- The distinguishing advantage of the explicit finite affine preprocessor. -/
noncomputable def affinePreprocessedAdv {q d N : ℕ} [NeZero q]
    {Ω : Type} [Fintype Ω] [Nonempty Ω]
    (D : Family) (lam : ℕ) (pp : Str) (t : ℕ)
    (samp : Ω → Matrix (Fin d) (Fin d) ℤ × (Fin d → ℤ))
    (source : _root_.AFT.FiniteDist (Fin d → ZMod q)) : ℝ :=
  |_root_.InfoLossLAR.WorstCase.affinePreprocessedReal (N := N) D lam pp t samp source -
    _root_.InfoLossLAR.WorstCase.affinePreprocessedIdeal (q := q) (N := N) D lam pp t samp|







end InfoLossLAR.WorstCase

end

