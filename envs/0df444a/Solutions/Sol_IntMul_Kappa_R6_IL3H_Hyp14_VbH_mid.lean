  have hP := h.P_lt
  have hN2 : 2 ^ (K * D) < 2 ^ p := by have := h.N_ge; omega
  have hw : w + EwH c D < 2 ^ p := by omega
  have a1 : 32 * c.Wr * (P * 2 ^ (K * D) * S * r) ≤ 32 * c.Wr * 2 ^ p :=
