      (fun draw block => _root_.InfoLossLAR.WorstCase.coordinateShiftPreprocess index guess shift (draw block).2
        ((draw block).1, (draw block).1.mulVec secret + noise block))
noncomputable def coordinateRealLaw {F : Type*} [CommRing F] [Fintype F] {N d t : ℕ}
    (errors : _root_.AFT.FiniteDist (Fin t → Fin d → F)) :
    _root_.AFT.FiniteDist (Fin t → Matrix (Fin d) (Fin N) F × (Fin d → F)) :=
  (_root_.AFT.FiniteDist.uniform (Fin N → F)).mix fun secret => errors.mix fun noise =>
    (_root_.AFT.FiniteDist.uniform (Fin t → Matrix (Fin d) (Fin N) F)).map
      (fun matrices block => (matrices block, (matrices block).mulVec secret + noise block))
