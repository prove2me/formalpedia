open IsDedekindDomain NumberField

private theorem isUnramifiedAt_int_of_isUnramifiedAt_ratIntegers (K : Type) [Field K] [NumberField K]
    [Algebra (𝓞 ℚ) (𝓞 K)] (P : Ideal (𝓞 K)) [P.IsPrime] (h : Algebra.IsUnramifiedAt (𝓞 ℚ) P) :
    Algebra.IsUnramifiedAt ℤ P := by
  have hsurj : Function.Surjective (Algebra.ofId ℤ (𝓞 ℚ)) := by
    have hf : (Algebra.ofId ℤ (𝓞 ℚ)).toRingHom = (Rat.ringOfIntegersEquiv.symm : ℤ →+* 𝓞 ℚ) :=
      Subsingleton.elim _ _
    intro x
    refine ⟨Rat.ringOfIntegersEquiv x, ?_⟩
    show (Algebra.ofId ℤ (𝓞 ℚ)).toRingHom (Rat.ringOfIntegersEquiv x) = x
    rw [hf]
    exact Rat.ringOfIntegersEquiv.symm_apply_apply x
  haveI : Algebra.FormallyUnramified ℤ (𝓞 ℚ) := Algebra.FormallyUnramified.of_surjective (Algebra.ofId ℤ (𝓞 ℚ)) hsurj
  haveI : Algebra.FormallyUnramified (𝓞 ℚ) (Localization.AtPrime P) := h
  haveI := IsScalarTower.of_algebraMap_eq' (Subsingleton.elim (algebraMap ℤ (Localization.AtPrime P))
    ((algebraMap (𝓞 ℚ) (Localization.AtPrime P)).comp (algebraMap ℤ (𝓞 ℚ))))
  convert Algebra.FormallyUnramified.comp ℤ (𝓞 ℚ) (Localization.AtPrime P)

private theorem exists_mem_of_forall_mem_iff_isBadPlace (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)]
    [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (hdeg : Module.finrank ℚ K = 3) (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (S : Finset (HeightOneSpectrum (𝓞 ℚ))) (hS : ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∈ S ↔ IsBadPlace K μ v) :
    ∃ v : HeightOneSpectrum (𝓞 ℚ), v ∈ S := by
  obtain ⟨P, hPmax, hP⟩ :=
    NumberField.exists_not_isUnramifiedAt_int (K := K) (𝒪 := 𝓞 K) (by rw [hdeg]; decide)
  haveI := hPmax.isPrime
  have hP0 : P ≠ ⊥ := Ring.ne_bot_of_isMaximal_of_not_isField hPmax (RingOfIntegers.not_isField (K := K))
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  haveI : IsScalarTower ℤ (𝓞 ℚ) (𝓞 K) := IsScalarTower.of_algebraMap_eq' (Subsingleton.elim _ _)
  haveI : Module.Finite (𝓞 ℚ) (𝓞 K) := Module.Finite.of_restrictScalars_finite ℤ (𝓞 ℚ) (𝓞 K)
  let 𝔓 : HeightOneSpectrum (𝓞 K) := ⟨P, hPmax.isPrime, hP0⟩
  haveI : P.LiesOver (𝔓.under (𝓞 ℚ)).asIdeal := ⟨rfl⟩
  refine ⟨𝔓.under (𝓞 ℚ), (hS _).2 (Or.inl ⟨𝔓, rfl, fun he => hP ?_⟩)⟩
  exact isUnramifiedAt_int_of_isUnramifiedAt_ratIntegers K P
    ((Algebra.isUnramifiedAt_iff_of_isDedekindDomain (R := 𝓞 ℚ)).mpr
      (by rw [Ideal.ramificationIdx'_eq_ramificationIdx _ P (𝔓.under (𝓞 ℚ)).ne_bot] at he; exact he))

end LanglandsTunnell.CubicInduction.BadPlaceExists

