  apply NLogN.IState.ext' _ (by simp [hs7, hs6, hs5, hs4, hs3, hs2, hs1])
    (by simp [hs7, hs6, hs5, hs4, hs3, hs2, hs1])
  intro x
  by_cases x1 : x = NLogN.Rsp.CU
  · subst x1; simp (config := {decide := true}) [hs7, hs6, hs5, hs4, hs3, hs2, hs1, NLogN.Rsp.gresL, hoR, hoI]
  by_cases x2 : x = NLogN.Rsp.SA
  · subst x2; simp (config := {decide := true}) [hs7, hs6, hs5, hs4, hs3, hs2, hs1]
  by_cases x3 : x = NLogN.Rsp.SB
  · subst x3; simp (config := {decide := true}) [hs7, hs6, hs5, hs4, hs3, hs2, hs1]
  simp only [hs7, hs6, hs5, hs4, hs3, hs2, hs1, NLogN.IState.upd_G, if_neg x1, if_neg x2, if_neg x3]
end
