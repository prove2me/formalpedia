import Definitions.Def_FourColor_Reflection

namespace FourColor
theorem mirror_minimal_counterexample :
  ∀ (n : ℕ) (H : Hypermap n), H.MinimalCounterexample → H.mirror.MinimalCounterexample := by sorry
end FourColor
