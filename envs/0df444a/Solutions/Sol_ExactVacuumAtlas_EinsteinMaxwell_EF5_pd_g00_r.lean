theorem div_four (K r : ℝ) (hr : r ≠ 0) : HasDerivAt (fun u => K / u ^ 4) (-4 * K / r ^ 5) r := by
  refine ((hasDerivAt_const r K).fun_div ((hasDerivAt_id' r).fun_pow 4)
