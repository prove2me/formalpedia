lemma target_piece_bound {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {φ : ℝ} {pa_n pb_n : ℕ} {t : BoxTree}
    (htv : treeValid .tri01 t = true)
    (hpa_ge : B0_num + 2 * B1_num + B2_num ≤ pa_n) (hpab : pa_n ≤ pb_n)
    (hφ_lo : (pa_n : ℝ) / D_den ≤ φ) (hφ_hi : φ ≤ (pb_n : ℝ) / D_den)
    (hcert : evalTreeWith buchstabUB pa_n pb_n .tri01 t A0_num B0_num A1_num B1_num A2_num B2_num ≤ targetBoundNat) :
    buchstabIntegral ω 1 (fun j => (r2j10_lo j : ℝ)) (fun j => (r2j10_hi j : ℝ)) φ ≤ ((3714811 / 500000000) : ℝ) := by
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  unfold buchstabIntegral
  rw [target_domain_eq]
  have hv : cellValid .tri01 A0_num B0_num A1_num B1_num A2_num B2_num := by
    unfold cellValid A0_num B0_num A1_num B1_num A2_num B2_num
    refine ⟨by omega, by omega, by omega, by omega, by omega, by omega, ?_, ?_, ?_⟩ <;> simp
  have h1 := evalTree_sound hω hz buchstabUB
    (fun _ _ hk01 _ hlo hhi => buchstab_le_buchstabUB hω hk01 hlo hhi)
    hpab hφ_lo hφ_hi t .tri01 A0_num B0_num A1_num B1_num A2_num B2_num htv hv hpa_ge
  refine le_trans h1 ?_
  have hcert_r : (evalTreeWith buchstabUB pa_n pb_n .tri01 t A0_num B0_num A1_num B1_num A2_num B2_num : ℝ) ≤
      (targetBoundNat : ℝ) := by exact_mod_cast hcert
  set ev : ℝ := (evalTreeWith buchstabUB pa_n pb_n .tri01 t A0_num B0_num A1_num B1_num A2_num B2_num : ℝ)
  have hden_pos : (0 : ℝ) < (S_scale : ℝ) * W_scale * W_scale * W_scale :=
    mul_pos (mul_pos (mul_pos hSpos hWpos) hWpos) hWpos
  rw [div_le_div_iff₀ hden_pos (by norm_num)]
  unfold targetBoundNat at hcert_r
  unfold S_scale W_scale
  push_cast at hcert_r ⊢
  linarith

end

