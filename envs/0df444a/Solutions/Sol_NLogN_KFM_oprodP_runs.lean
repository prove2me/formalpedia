namespace NLogN.KFM

open IntMul KFC KFB KFT KIL

theorem oprod_nil (Δ : ℕ) (B : List GI) : oprod Δ [] B = [] := rfl

theorem oprod_cons (Δ : ℕ) (a : GI) (A B : List GI) :
    oprod Δ (a :: A) B = B.map (gmulT Δ a) ++ oprod Δ A B := by
  simp [oprod, List.flatMap_cons]

theorem oprod_append (Δ : ℕ) (A A' B : List GI) :
    oprod Δ (A ++ A') B = oprod Δ A B ++ oprod Δ A' B := by
  simp [oprod, List.flatMap_append]

section IL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem oprod_take_succ (Δ : ℕ) (A B : List GI) (k : ℕ) (hk : k < A.length) :
    oprod Δ (A.take (k + 1)) B = oprod Δ (A.take k) B ++ B.map (gmulT Δ A[k]) := by
  rw [List.take_add_one, List.getElem?_eq_getElem hk, Option.toList_some, oprod_append,
    oprod_cons, oprod_nil, List.append_nil]

end IL

end NLogN.KFM

