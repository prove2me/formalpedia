      (_ : SMulCommClass G ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin A (↥K₀') j₀') ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin A (↥K) j))
