  rw [mem_nIdeal]
  have : Sp.toCornerRing i (Sp.e i) = 1 := Subtype.ext (by
    rw [IdempotentSplitting.coe_toCornerRing, (Sp.idem i).eq, (Sp.idem i).eq]; rfl)
  rw [this, map_one]
