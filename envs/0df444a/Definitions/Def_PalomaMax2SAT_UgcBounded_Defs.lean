import Mathlib

section Bundle_CutTransfer
/-!
# MAX-CUT as MAX 2-SAT

For a graph with edge list `left, right : Fin m → Fin n`, the formula `F_G` has, for every
edge `e`, the clauses `(x_l ∨ x_r)` and `(¬x_l ∨ ¬x_r)`. An assignment is a set `S` of
true variables. This module proves that the number of satisfied clauses is
`m + cut(S)` (Proposition `prop:cut2sat` of the paper) and the arithmetic of the ratio
transfer from `F_G` and from `T_H` to the cut.

The conflict-graph identity `α(H) = m + maxcut(G)` (Proposition `prop:cutconflict`) is
proved in `ConflictGraph`.
-/

namespace PalomaMax2SAT.CutTransfer

/-- A graph given by the endpoints of its `m` edges. -/
structure EdgeGraph (n m : ℕ) where
  left : Fin m → Fin n
  right : Fin m → Fin n
  left_ne_right : ∀ e, left e ≠ right e

/-- The number of edges with exactly one endpoint in `S`. -/
def cutCount {n m : ℕ} (G : EdgeGraph n m) (S : Finset (Fin n)) : ℕ :=
  (Finset.univ.filter fun e : Fin m =>
    (G.left e ∈ S ∧ G.right e ∉ S) ∨ (G.left e ∉ S ∧ G.right e ∈ S)).card

/-- The number of satisfied clauses among the two clauses of the edge `e`. -/
def edgeValue {n m : ℕ} (G : EdgeGraph n m) (S : Finset (Fin n)) (e : Fin m) : ℕ :=
  (if G.left e ∈ S ∨ G.right e ∈ S then 1 else 0) +
    (if G.left e ∉ S ∨ G.right e ∉ S then 1 else 0)

end PalomaMax2SAT.CutTransfer

end Bundle_CutTransfer

section Bundle_ConflictGraph
/-!
# The conflict graph of `F_G` (Proposition `prop:cutconflict`)

The formula `F_G` has, for every edge `e` with endpoints `left e`, `right e`, the clauses
`(x_{left e} ∨ x_{right e})` and `(¬x_{left e} ∨ ¬x_{right e})`. Its literal occurrences are the
triples `(e, s, b)` of `Occ m`: the edge `e`, the sign `s` of the clause (`true` for the positive
clause) and the endpoint `b` (`true` for `left`). Two occurrences are adjacent in the conflict
graph when they are distinct and either lie in the same clause or belong to the same variable
with opposite signs.

This module proves `α(H) = m + maxcut(G)` for every graph `G`: independent sets of the conflict
graph have at most `m + cut(S)` elements for a suitable `S`, and every `S` yields an independent
set with exactly `m + cut(S)` elements. Regularity and the degree count are in
`PalomaMax2SAT.ConflictDegree`.
-/

namespace PalomaMax2SAT.ConflictGraph

open PalomaMax2SAT.CutTransfer

variable {n m : ℕ}

/-- Literal occurrences of `F_G`: edge, sign of the clause, endpoint. -/
abbrev Occ (m : ℕ) := Fin m × Bool × Bool

/-- The variable of the endpoint `b` of the edge `e`. -/
def ov (G : EdgeGraph n m) (e : Fin m) : Bool → Fin n
  | true => G.left e
  | false => G.right e

/-- The variable of a literal occurrence. -/
def var (G : EdgeGraph n m) (p : Occ m) : Fin n := ov G p.1 p.2.2

/-- Adjacency in the conflict graph. -/
def Adj (G : EdgeGraph n m) (p q : Occ m) : Prop :=
  p ≠ q ∧ ((p.1 = q.1 ∧ p.2.1 = q.2.1) ∨ (var G p = var G q ∧ p.2.1 ≠ q.2.1))

instance (G : EdgeGraph n m) : DecidableRel (Adj G) := fun p q => by
  unfold Adj
  infer_instance

/-- Independent sets of the conflict graph. -/
def Ind (G : EdgeGraph n m) (I : Finset (Occ m)) : Prop :=
  ∀ p ∈ I, ∀ q ∈ I, ¬ Adj G p q

def IsMaxCut (G : EdgeGraph n m) (mc : ℕ) : Prop :=
  (∀ S, cutCount G S ≤ mc) ∧ ∃ S, cutCount G S = mc

def IsIndNumber (G : EdgeGraph n m) (a : ℕ) : Prop :=
  (∀ I, Ind G I → I.card ≤ a) ∧ ∃ I, Ind G I ∧ I.card = a

/-! ### From a cut to an independent set -/

/-- Whether the occurrence `(e, s, b)` is the chosen witness of its clause under `S`. -/
def selB (G : EdgeGraph n m) (S : Finset (Fin n)) (e : Fin m) : Bool → Bool → Bool
  | true, true => decide (G.left e ∈ S)
  | true, false => decide (G.right e ∈ S) && decide (G.left e ∉ S)
  | false, true => decide (G.left e ∉ S)
  | false, false => decide (G.right e ∉ S) && decide (G.left e ∈ S)

/-- The independent set of size `m + cut(S)`. -/
def selSet (G : EdgeGraph n m) (S : Finset (Fin n)) : Finset (Occ m) :=
  Finset.univ.filter fun p => selB G S p.1 p.2.1 p.2.2 = true

/-! ### From an independent set to a cut -/

/-- The variables that have a chosen positive literal. -/
def cutOf (G : EdgeGraph n m) (I : Finset (Occ m)) : Finset (Fin n) :=
  Finset.univ.filter fun v => ∃ p ∈ I, var G p = v ∧ p.2.1 = true

/-! ### The identity `α(H) = m + maxcut(G)` -/

end PalomaMax2SAT.ConflictGraph

end Bundle_ConflictGraph

section Bundle_ConflictDegree
/-!
# Degrees of the conflict graph of `F_G`

For the conflict graph `H(G)` on the literal occurrences `Occ m` of `F_G` this module proves:

* `occurrences_eq`: the variable `x_v` occurs in exactly `2 deg(v)` clauses (Proposition
  `prop:cut2sat`, item 2);
* `card_nbrs`: the occurrence `(e, s, b)` has `1 + deg(var)` neighbours, so `H(G)` is
  `(d + 1)`-regular when `G` is `d`-regular (Proposition `prop:cutconflict`);
* `card_occ`: `H(G)` has `4 m` vertices.

Here `deg(v) = occ G v` is the number of edge endpoints equal to `v`.
-/

namespace PalomaMax2SAT.ConflictDegree

open PalomaMax2SAT.CutTransfer PalomaMax2SAT.ConflictGraph

variable {n m : ℕ}

/-- The degree of `v`: the number of edge endpoints equal to `v`. -/
def occ (G : EdgeGraph n m) (v : Fin n) : ℕ :=
  ∑ e : Fin m, ((if G.left e = v then 1 else 0) + (if G.right e = v then 1 else 0))

/-- The edge-endpoint slots at `v`. -/
def slots (G : EdgeGraph n m) (v : Fin n) : Finset (Fin m × Bool) :=
  Finset.univ.filter fun x => ov G x.1 x.2 = v

/-- The neighbours of an occurrence in the conflict graph. -/
def nbrs (G : EdgeGraph n m) (p : Occ m) : Finset (Occ m) :=
  Finset.univ.filter fun q => Adj G p q

end PalomaMax2SAT.ConflictDegree

end Bundle_ConflictDegree

section Bundle_GeneralDegreeFormula
/-!
# The formula `T_H` for a per-vertex degree function

For a finite simple graph `H` with degrees `d_v` and a port labelling, the formula `T_H` has
`d_v + 1` Boolean clones `(v, 0), …, (v, d_v)` per vertex `v`: the clone `(v, 0)` occurs in the
unit clause `(¬ (v,0))`, the clone `(v, p+1)` occurs in the edge clause of the edge at port `p`
of `v`, and the `d_v + 1` cyclic implications `(¬ (v,i) ∨ (v,i+1))` (indices modulo `d_v + 1`)
enforce consistency. This module proves, for every degree function:

* `Σ_v d_v = 2 m`, hence `Σ_v (d_v + 1) + m = n + 3 m`;
* the number of satisfied clauses equals `U(z) + (m - F(z)) + (Σ_v (d_v + 1) - T(z))`;
* the optimum equals `B + α` with `B = Σ_v (d_v + 1) + m` (`optimum_identity`);
* the lift of an independent set `I` has value `B + |I|` (`lift_satCount`).

The vertex `v` has the port set `Fin (d_v)`; the port structure is a bijection between the
`2 m` edge ends and the ports.
-/

namespace PalomaMax2SAT.GeneralDegreeFormula

/-- A graph on `n` vertices with `m` edges and a port labelling for the degree function `deg`:
the `2 m` edge ends are in bijection with the ports `Σ v, Fin (deg v)`. -/
structure GPortGraph (n m : ℕ) (deg : Fin n → ℕ) where
  leftPt : Fin m → Σ v : Fin n, Fin (deg v)
  rightPt : Fin m → Σ v : Fin n, Fin (deg v)
  left_ne_right : ∀ e, (leftPt e).1 ≠ (rightPt e).1
  ports_bijective : Function.Bijective (Sum.elim leftPt rightPt)

def GPortGraph.left {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg) (e : Fin m) :
    Fin n := (G.leftPt e).1

def GPortGraph.right {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg) (e : Fin m) :
    Fin n := (G.rightPt e).1

/-- The clone used by the left end of `e`: port `p` uses the clone `p + 1`. -/
def GPortGraph.leftClone {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg) (e : Fin m) :
    ℕ := ((G.leftPt e).2 : ℕ) + 1

def GPortGraph.rightClone {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg) (e : Fin m) :
    ℕ := ((G.rightPt e).2 : ℕ) + 1

def Independent {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (I : Finset (Fin n)) : Prop :=
  ∀ e, ¬ (G.left e ∈ I ∧ G.right e ∈ I)

def IsIndependenceNumber {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (alpha : ℕ) : Prop :=
  (∀ I, Independent G I → I.card ≤ alpha) ∧ ∃ I, Independent G I ∧ I.card = alpha

/-! ### Assignments and the score -/

/-- The successor of the clone `i` in the cycle of length `D + 1`. -/
def cyc (D i : ℕ) : ℕ := if i = D then 0 else i + 1

/-- A transition `1 → 0` of the cycle at `v` at the position `i`. -/
abbrev transAt {n : ℕ} (deg : Fin n → ℕ) (z : Fin n → ℕ → Bool) (v : Fin n) (i : ℕ) :
    Prop :=
  z v i = true ∧ z v (cyc (deg v) i) = false

/-- The number of transitions of the cycle at `v`. -/
def transCount {n : ℕ} (deg : Fin n → ℕ) (z : Fin n → ℕ → Bool) (v : Fin n) : ℕ :=
  ∑ i ∈ Finset.range (deg v + 1), if transAt deg z v i then 1 else 0

def selectedVertices {n : ℕ} (z : Fin n → ℕ → Bool) : Finset (Fin n) :=
  Finset.univ.filter fun v => z v 0 = false

def transVertices {n : ℕ} (deg : Fin n → ℕ) (z : Fin n → ℕ → Bool) : Finset (Fin n) :=
  Finset.univ.filter fun v => 0 < transCount deg z v

def cleanVertices {n : ℕ} (deg : Fin n → ℕ) (z : Fin n → ℕ → Bool) : Finset (Fin n) :=
  selectedVertices z \ transVertices deg z

def falseEdges {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (z : Fin n → ℕ → Bool) : Finset (Fin m) :=
  Finset.univ.filter fun e =>
    z (G.left e) (G.leftClone e) = false ∧ z (G.right e) (G.rightClone e) = false

def deletionSet {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (z : Fin n → ℕ → Bool) : Finset (Fin n) :=
  (Finset.univ.filter fun e =>
      G.left e ∈ cleanVertices deg z ∧ G.right e ∈ cleanVertices deg z).image G.left

def repairedSet {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (z : Fin n → ℕ → Bool) : Finset (Fin n) :=
  cleanVertices deg z \ deletionSet G z

/-- Satisfied unit, edge, and cyclic-consistency clauses. -/
def score {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (z : Fin n → ℕ → Bool) : ℕ :=
  (selectedVertices z).card + (m - (falseEdges G z).card) +
    (∑ v, (deg v + 1) - ∑ v, transCount deg z v)

/-- The assignment of the independent set `I`: clones of `v ∈ I` false, all others true. -/
def assignmentOfIndependent {n : ℕ} (I : Finset (Fin n)) : Fin n → ℕ → Bool :=
  fun v _ => if v ∈ I then false else true

/-! ### The formula as an explicit list of clauses -/

/-- A literal over the clone variables `(v, i)`; `positive = false` is a negated literal. -/
structure Lit (n : ℕ) where
  var : Fin n × ℕ
  positive : Bool

abbrev Clause (n : ℕ) := List (Lit n)

def Lit.eval {n : ℕ} (z : Fin n → ℕ → Bool) (l : Lit n) : Bool :=
  if l.positive then z l.var.1 l.var.2 else !z l.var.1 l.var.2

def Clause.satisfied {n : ℕ} (z : Fin n → ℕ → Bool) (c : Clause n) : Bool :=
  c.any (Lit.eval z)

/-- Indices of the clauses of `T_H`: one unit clause per vertex, one edge clause per edge,
and `deg v + 1` cyclic implications per vertex `v`. -/
abbrev ClauseIdx {n : ℕ} (m : ℕ) (deg : Fin n → ℕ) :=
  Fin n ⊕ Fin m ⊕ (Σ v : Fin n, Fin (deg v + 1))

def unitClause {n : ℕ} (v : Fin n) : Clause n :=
  [Lit.mk (v, 0) false]

def edgeClause {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg) (e : Fin m) :
    Clause n :=
  [Lit.mk (G.left e, G.leftClone e) true, Lit.mk (G.right e, G.rightClone e) true]

def consClause {n : ℕ} {deg : Fin n → ℕ} (p : Σ v : Fin n, Fin (deg v + 1)) : Clause n :=
  [Lit.mk (p.1, (p.2 : ℕ)) false, Lit.mk (p.1, cyc (deg p.1) (p.2 : ℕ)) true]

def clauseOf {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg) :
    ClauseIdx m deg → Clause n :=
  Sum.elim unitClause (Sum.elim (edgeClause G) consClause)

/-- The number of clauses of `T_H` satisfied by `z`. -/
noncomputable def satCount {n m : ℕ} {deg : Fin n → ℕ} (G : GPortGraph n m deg)
    (z : Fin n → ℕ → Bool) : ℕ :=
  (Finset.univ.filter fun c : ClauseIdx m deg =>
    Clause.satisfied z (clauseOf G c) = true).card

end PalomaMax2SAT.GeneralDegreeFormula

end Bundle_GeneralDegreeFormula


