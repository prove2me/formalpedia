  have H := loopMV (I := I) (iprog := iprog) (X := bN') (by decide) n' s (mS G src argOf n' LX)
    (fun j => by simp [mS, hA]) (fun j => by simp [mS, hC]) (fun j => by simp [mS, hD])
    (LM := L1) (by rw [mS, cS_G _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide)
