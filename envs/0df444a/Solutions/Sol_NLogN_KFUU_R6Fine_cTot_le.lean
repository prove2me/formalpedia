namespace NLogN.KFUU

open IntMul KIL KFB KFC KFT KFU AModel AModelL12

theorem size_sq_le (V : ℕ) (hV : 1 ≤ V) : Nat.size V ^ 2 ≤ 64 * V := by
  have h1 := pow4_le (Nat.size V)
  have h2 := two_pow_size_le hV
  have h3 : Nat.size V ^ 2 ≤ Nat.size V ^ 4 := by
    rcases Nat.eq_zero_or_pos (Nat.size V) with h0 | h0
    · rw [h0]; simp
    · exact Nat.pow_le_pow_right h0 (by norm_num)
  omega

