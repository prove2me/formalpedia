theorem aut_hom_comp_hom (a b : G) : (ρ a).hom ≫ (ρ b).hom = (ρ (b * a)).hom := by
  rw [map_mul, CategoryTheory.Aut.Aut_mul_def]; rfl

theorem aut_inv_hom (a : G) : (ρ a⁻¹).hom = (ρ a).inv := by
  rw [map_inv, CategoryTheory.Aut.Aut_inv_def]; rfl

theorem eq_comp_of_comp_eq {X : Scheme.{0}} {x y : X ⟶ M} (a : G) (h : x ≫ (ρ a).hom = y) :
    x = y ≫ (ρ a⁻¹).hom := by
  rw [aut_inv_hom, ← h, Category.assoc, Iso.hom_inv_id, Category.comp_id]

