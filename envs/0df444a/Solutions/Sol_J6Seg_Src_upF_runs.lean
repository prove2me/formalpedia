namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS E Function

theorem parB {kA kC wA wC k pre post s t p α d W : ℕ}
    (hW : parBig kA kC wA wC k pre post s t p α d < 2 ^ W) :
    NF d s + 1 < 2 ^ W ∧ 2 ^ (kA * segPF p d s + kC + 1) < 2 ^ W ∧ 2 ^ (segPF p d s + 2) < 2 ^ W ∧
    k < 2 ^ W ∧ pre < 2 ^ W ∧ post < 2 ^ W ∧ s < 2 ^ W ∧ t < 2 ^ W ∧ α < 2 ^ W ∧ p < 2 ^ W ∧
    2 * d + 8 < 2 ^ W ∧ 2 * lamF d + 8 < 2 ^ W ∧ wF d < 2 ^ W ∧ wA * segPF p d s + wC < 2 ^ W ∧
    kA * segPF p d s + kC < 2 ^ W ∧ 1500 + 8 < 2 ^ W ∧ wA ≤ 2 ^ W ∧ wC ≤ 2 ^ W ∧ kA ≤ 2 ^ W ∧
    kC ≤ 2 ^ W := by
  have h1 : wA ≤ wA * segPF p d s + wA := by
    rcases Nat.eq_zero_or_pos (segPF p d s) with h | h
    · omega
    · have := Nat.le_mul_of_pos_right wA h; omega
  have h2 : kA ≤ kA * segPF p d s + kA := by
    rcases Nat.eq_zero_or_pos (segPF p d s) with h | h
    · omega
    · have := Nat.le_mul_of_pos_right kA h; omega
  have hs : 1 ≤ segPF p d s := by unfold segPF; omega
  have h1' : wA ≤ wA * segPF p d s := Nat.le_mul_of_pos_right wA hs
  have h2' : kA ≤ kA * segPF p d s := Nat.le_mul_of_pos_right kA hs
  unfold parBig at hW
  generalize 2 ^ (kA * segPF p d s + kC + 1) = X1 at hW ⊢
  generalize 2 ^ (segPF p d s + 2) = X2 at hW ⊢
  generalize 2 ^ W = X3 at hW ⊢
  refine ⟨by omega, by omega, by omega, by omega, by omega, by omega, by omega, by omega, by omega,
    by omega, by omega, by omega, by omega, by omega, by omega, by omega, by omega, by omega,
    by omega, by omega⟩

