theorem KNFam.smooth_FfrFVar (A K : Fin 4) :
    ContDiffOn ℝ ∞ (FfrFVar FK f EK B A K) {y | ((0 : ℝ), y) ∈ W} := by
  have := hK.fam.smooth_FfrFVar ht A K
  rwa [hK.F0, hK.E0] at this

