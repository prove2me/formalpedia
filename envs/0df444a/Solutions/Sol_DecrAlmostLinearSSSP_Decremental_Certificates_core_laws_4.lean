lemma RuntimeInvariant.readout_certificate (b : Core) (K : ℝ) (hK : 32 ≤ K) (s : State b)
    (hs : RuntimeInvariant b K s) (hdrain : s.pending = [])
    (hstop : s.nonzeroEntries = 0 ∨ ∃ r : CutReply b,
      RatioGuarantee (cachedPhysical b s) K r.G r.U r.cut ∧ -1/(4*K) ≤ r.G/r.U) :
    ReadoutCertificate b s := by
  have hstop' : s.cachedGradient = 0 ∨ ∃ r : CutReply b,
      RatioGuarantee (cachedPhysical b s) K r.G r.U r.cut ∧ -1/(4*K) ≤ r.G/r.U :=
    hstop.imp (zero_counter_gradient b s hs.counter) id
  have hb := invariant_stopping_balance b K hK s hs.cache hdrain hstop'
  have hall := all_target_certificate b s.active (labels b s) (by simp [labels,initialLabel]) hb
  exact ⟨hall,invariant_return_accuracy b K hK s hs.cache hdrain hs.sample hall,hs.output⟩
end DecrAlmostLinearSSSP.Decremental
