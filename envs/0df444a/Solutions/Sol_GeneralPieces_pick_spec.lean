open GeneralPieces
open Groundwork PaddedDescent.F ClauseBound.Alg ClauseBound.Gen ClauseBound.Gen.Seq Levels.Gen
namespace GeneralPieces
theorem _root_.solution (P : PiecesF) (x₀ : ℕ) : PolyT (Pick.pick P x₀) ∧ (∀ b, (Pick.pick P x₀ b).2 = idx P x₀ (Pick.pick P x₀ b).1.length) ∧
    (∀ b, K x₀ 0 ≤ b.length → K x₀ (Pick.pick P x₀ b).1.length ≤ b.length) ∧ ∀ b, b.length < K x₀ ((Pick.pick P x₀ b).1.length + 1) := by
  refine ⟨Pick.pick_polyT P x₀, fun b => ?_, fun b h0 => ?_, fun b => ?_⟩ <;> obtain ⟨l, h1, h2, h3, h4⟩ := Pick.rounds P x₀ b b.length le_rfl <;> have hl : Pick.loop P x₀ b = Pick.state P x₀ l := h1 <;> simp only [Pick.pick, hl, Pick.state, rep, List.length_replicate]
  · rfl
  · rcases h3 with rfl | h3
    · exact h0
    · exact h3
  · rcases h4 with h4 | h4
    · exact h4.trans_lt (Pick.lt_K_succ x₀ l)
    · exact h4
end GeneralPieces
