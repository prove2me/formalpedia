/-- `a = 0`: the metric equals RN in standard coordinates on the common regular set. -/
theorem gA0 (M Q : ℝ) (i j : Fin 4) : Set.EqOn (gKN M 0 Q i j) (RNStd.gStdRN M Q i j) (domReg M 0 Q) := by
  intro x hx
  fin_cases i <;> fin_cases j
  exacts [gA0_0_0 M Q hx, gA0_0_1 M Q hx, gA0_0_2 M Q hx, gA0_0_3 M Q hx, gA0_1_0 M Q hx, gA0_1_1 M Q hx, gA0_1_2 M Q hx, gA0_1_3 M Q hx, gA0_2_0 M Q hx, gA0_2_1 M Q hx, gA0_2_2 M Q hx, gA0_2_3 M Q hx, gA0_3_0 M Q hx, gA0_3_1 M Q hx, gA0_3_2 M Q hx, gA0_3_3 M Q hx]
/-- `a = 0`: the inverse equals the RN standard inverse on the common regular set. -/
theorem giA0 (M Q : ℝ) (i j : Fin 4) : Set.EqOn (giKN M 0 Q i j) (RNStd.giStdRN M Q i j) (domReg M 0 Q) := by
  intro x hx
  fin_cases i <;> fin_cases j
  exacts [giA0_0_0 M Q hx, giA0_0_1 M Q hx, giA0_0_2 M Q hx, giA0_0_3 M Q hx, giA0_1_0 M Q hx, giA0_1_1 M Q hx, giA0_1_2 M Q hx, giA0_1_3 M Q hx, giA0_2_0 M Q hx, giA0_2_1 M Q hx, giA0_2_2 M Q hx, giA0_2_3 M Q hx, giA0_3_0 M Q hx, giA0_3_1 M Q hx, giA0_3_2 M Q hx, giA0_3_3 M Q hx]
/-- `a = 0`: the field equals the RN standard field `F_rt = Q/r²` on the common regular set. -/
theorem FA0 (M Q : ℝ) (i j : Fin 4) : Set.EqOn (faradayKN 0 Q i j) (RNStd.faradayStdRN Q i j) (domReg M 0 Q) := by
  intro x hx
  fin_cases i <;> fin_cases j
  exacts [FA0_0_0 M Q hx, FA0_0_1 M Q hx, FA0_0_2 M Q hx, FA0_0_3 M Q hx, FA0_1_0 M Q hx, FA0_1_1 M Q hx, FA0_1_2 M Q hx, FA0_1_3 M Q hx, FA0_2_0 M Q hx, FA0_2_1 M Q hx, FA0_2_2 M Q hx, FA0_2_3 M Q hx, FA0_3_0 M Q hx, FA0_3_1 M Q hx, FA0_3_2 M Q hx, FA0_3_3 M Q hx]

