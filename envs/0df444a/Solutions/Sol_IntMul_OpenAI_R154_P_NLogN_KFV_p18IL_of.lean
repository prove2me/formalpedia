variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem tens_Sm : (Butterfly.tens Butterfly.Sm : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) = SD := by
  rw [Butterfly.Sm, diag2_tens, Butterfly.SD]; congr 1; funext x; exact prod_phase I x

/-- (18): `H0^{⊗D} = b^D S_D C^{⊗D} S_D`. -/
theorem tens_H0 : (Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) =
    Butterfly.cb ^ Fintype.card ι • (Butterfly.SD * Butterfly.tens Butterfly.Cm * Butterfly.SD) := by
  rw [H0_eq, tens_smul, tens_mul, tens_mul, tens_Sm]

/-- The scalar of (18): `b^D = (-i/2)^{⌊D/2⌋} b^{D mod 2}`. -/
theorem cb_pow (D : ℕ) : Butterfly.cb ^ D = (-I / 2) ^ (D / 2) * Butterfly.cb ^ (D % 2) := by
  conv_lhs => rw [← Nat.div_add_mod D 2, pow_add, pow_mul, cb_sq]

/-- Every row of `H0^{⊗D}` has absolute row sum one. -/
theorem tens_H0_row_sum (x : ι → Fin 2) : ∑ y, ‖(Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) x y‖ = 1 := by
  simp only [Butterfly.tens, tensF, norm_prod]
  rw [← Fintype.prod_sum (fun i j => ‖H0 (x i) j‖)]
  apply Finset.prod_eq_one
  intro i _
  rcases Fin.exists_fin_two.1 ⟨x i, rfl⟩ with h | h <;>
    simp [h, H0, Fin.sum_univ_two] <;> norm_num

