/-- The index data of the merged table (`E₀ = 1`, `own 0 = bigP`). -/
def ixM (E₁ E₂ E₃ : ℕ) (eF eI : Fin (7 + E₁)) (eA eB : Fin (7 + E₂)) (eC : Fin (7 + E₃))
    (dSΦ dSL dSC : Fin HS) : Ix (7 + (E₁ + E₂ + E₃ + 1)) where
