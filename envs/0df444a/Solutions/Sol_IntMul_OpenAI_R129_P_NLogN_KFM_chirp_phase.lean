  have hdO : dst ≠ mOc := fun e => by have := hdst.ge; rw [e] at this; exact absurd this (by decide)
  apply pushLoop_run (.push dst (NLogN.KFM.srcE ixO)) dst hdO s d LD hD (by simp [RS.writes, Ne.symm hdO])
  intro L c hc1 hcd
  set u := (s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc) with hu
  have hR : SrcRegs u d' Q Mh Mf :=
    (h.upd dst hdst.ne.2 _).upd mOc (by decide) _
  have uO : u.G mOc = .int (c : ℤ) :: s.G mOc := by simp [hu]
  obtain ⟨k, e⟩ := srcE_spec u ixO d' Q Mh Mf (c - 1) hR
    (by simp only [ixO, Ex.eval, IState.top_eq uO]; omega) ⟨IState.isInt_of uO, trivial⟩
    (hj _ (by omega))
  refine ⟨⟨hdst.lt, NLogN.KFM.clean_of_regs _ (by decide), k⟩, ?_⟩
  simp only [RS.run, e]
  rw [show u.G dst = L ++ s.G dst by simp [hu, IState.upd_G, hdO]]
  rfl

end NLogN.KFM

