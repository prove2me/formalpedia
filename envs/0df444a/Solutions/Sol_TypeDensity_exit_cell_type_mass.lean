        (U.M i).q * (U.M i).μ (U.M i).stateSet := by
  -- sum the child box masses over the finitely many child types with nonzero coefficient
  have hq : 2 ≤ (U.M i).q := (TypeDensity.universe_basic_facts U i).1
  set A : ℚ := (TypeDensity.divisorProbability (U.M i).s ((U.M i).cellDegree c.1)).eval ((U.M i).q : ℚ) *
    (TypeDensity.stateVolume (U.M i).s).eval ((U.M i).q : ℚ) with hAdef
  let C : (U.M i).childIdx c.1 → TypeDensity.FactorType → ℚ := fun j t ↦
    (TypeDensity.lawCoeff (TypeDensity.stateLaw (((U.M i).childList c.1).get j).2) t).eval
      (((U.M i).q : ℚ) ^ (((U.M i).childList c.1).get j).1)
