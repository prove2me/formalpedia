theorem run_grid_region (q : K) (M : ℕ) (a : State K)
    (hpc : a.pc = 35) (ho : a.output = none) (hd : a.data 0 = q) (hm : a.index 0 = M) :
    ∃ u, runExactly mantissaProgram a (7 + 13*M + 2) = some u ∧
