/-! ## Euler's pentagonal recurrence

Euler's identity `(∑ₙ p(n) qⁿ) · ∏_{i ≥ 1} (1 - qⁱ) = 1` and the pentagonal number theorem
`∏_{i ≥ 1} (1 - qⁱ) = ∑_{k ∈ ℤ} (-1)ᵏ q^{k(3k-1)/2}` (both available in Mathlib) give, on comparing
the coefficients of `qⁿ` for `n ≥ 1`,

  `p(n) = ∑_{k ≥ 1} (-1)^{k+1} (p(n - k(3k-1)/2) + p(n - k(3k+1)/2))`,

where terms with a negative argument are omitted. `partitionCountRec` evaluates exactly this
recurrence from the table of earlier values, so it agrees with `partitionCount` for every `n`
(`partitionCountRec_eq_partitionCount`). The concrete values `p(2), …, p(11)` below (and
`p(12), …` in the companion files) then follow by evaluating `partitionCountRec`, without
enumerating partitions. -/

section EulerRecurrence

open scoped PowerSeries.WithPiTopology

private theorem le_pentagonalLower (k : Nat) : k ≤ pentagonalLower k := by
  unfold pentagonalLower
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · exact Nat.zero_le _
  · rw [Nat.le_div_iff_mul_le (by norm_num)]
    exact Nat.mul_le_mul le_rfl (by omega)

private theorem pentagonalLower_le_pentagonalUpper (k : Nat) :
    pentagonalLower k ≤ pentagonalUpper k := by
  unfold pentagonalLower pentagonalUpper
  exact Nat.div_le_div_right (Nat.mul_le_mul le_rfl (by omega))

/-- Reading the table `[p(0), …, p(n)]` at an index `i ≤ n`. -/
private theorem getD_map_range_partitionCount {n i : Nat} (hi : i ≤ n) :
    ((List.range (n + 1)).map partitionCount).getD i 0 = partitionCount i := by
  simp [List.getD_eq_getElem?_getD, Nat.lt_succ_of_le hi]

end EulerRecurrence
end Ch01
end QseriesFormalization

open QseriesFormalization QseriesFormalization.Ch01
open scoped PowerSeries.WithPiTopology
theorem solution (n : Nat) :
    partitionCountRecFrom ((List.range (n + 1)).map partitionCount) (n + 1) =
      partitionCount (n + 1) := by
  unfold partitionCountRecFrom
  try simp only
  rw [← Int.toNat_natCast (partitionCount (n + 1)),
    partitionCount_pentagonal_recurrence (n := n + 1) (by omega)]
  congr 1
  refine Finset.sum_congr rfl fun j _ => ?_
  have hL := le_pentagonalLower (j + 1)
  have hU := pentagonalLower_le_pentagonalUpper (j + 1)
  have hsign : (-1 : ℤ) ^ j = if (j + 1) % 2 = 1 then 1 else -1 := by
    split_ifs with hj
    · exact Even.neg_one_pow (Nat.even_iff.mpr (by omega))
    · exact Odd.neg_one_pow (Nat.odd_iff.mpr (by omega))
  rw [getD_map_range_partitionCount (show n + 1 - pentagonalLower (j + 1) ≤ n by omega),
    getD_map_range_partitionCount (show n + 1 - pentagonalUpper (j + 1) ≤ n by omega), hsign]
  split_ifs <;> push_cast <;> ring
