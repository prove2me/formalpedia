        (∑ a ∈ row, rawTotal a * valuation p a) - 0 =
      (∑ m : B.sampleData.Sample,
          roundedSeed m * valuation p (B.sampleData.value m)) -
        betaAct / B.L * ∑ a ∈ pool, valuation p a
  rw [hsource, hraw]
  ring



