theorem xi_natural (B B' : Type) [CommRing B] [CommRing B'] (ψ : O →+* B) (ψ' : O →+* B')
    (hB : IsNilpotent (p : B)) (hB' : IsNilpotent (p : B')) (f : B →+* B') (hf : f.comp ψ = ψ') (x : Gobj B ψ) :
    xi p hpO hpO0 D hB' (Gmap f hf x) = Hmap f hf (xi p hpO hpO0 D hB x) := by
  classical
  funext ρ'
  let σ : Adm B ψ := Adm.comap f hf ρ'
  let n : ℕ := Gpt.lvl p hpO hpO0 hB (x σ)
  have hn : maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker (x σ).1 :=
