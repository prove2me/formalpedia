    ∀ (Isym : List Sym) (n : ℕ), IntMul.OpenAI.Glue.n0 ≤ n → n₁ ≤ n → ∀ D, IntMul.OpenAI.R129.dP n = D + 1 →
      lineG Isym ext eA eB dS C₀ A n (D + 1) := by
