section
open Light
open Light.Sec3
open ThreeSumApsp
theorem solution (hlop : Claim.LopDetectP aeModel) :
    Claim.ExactTriangleUniform aeModel (143 / 68400) 2 := by
  obtain ⟨n₀, h⟩ := theorem19_mid aeModel
    (claim_ae_theorem_17_mid 13 228 11 300 (by norm_num) (by norm_num) (by norm_num)
      (by norm_num)) hlop
  exact exactTriangleUniform_of_explicitAt _ 2 n₀ (by norm_num) (by norm_num) h
    claim_aeBruteForce closure_aeChooseBySize closure_aeMono
end
