  have : 2 ^ pP6 P n ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) (by omega)
  have e : (2 : ℕ) ^ 1 = 2 := by norm_num
  omega

theorem n3 : cSlabSc (axpre6 P n D k) (axnc6 P n k * axl6 P n) (axpost6 P n D k) (axp6 P n + 2)
    (axQ6 P n src k - axp6 P n - 1) ≤ 4 * 10 ^ 9 * (2 * (TP6 P n * pP6 P n)) := by
  have := slabSc_le (t := axt6 P n k) (p := pP6 P n) (e := axQ6 P n src k - axp6 P n - 1)
    h.pre1 h.post1 h.t1 h.ncl
    (by have := h.Qp; show axQ6 P n src k - pP6 P n - 1 ≤ 3 * pP6 P n; omega) h.p1
  rw [h.tot] at this
  refine this.trans ?_
  have hp := h.p1
  generalize TP6 P n = T at *
  generalize pP6 P n = p at *
  calc 600000 * T * (3000 * (p + 1)) ≤ 600000 * T * (3000 * (2 * p)) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
    _ = 3600000000 * (T * p) := by ring
    _ ≤ 8000000000 * (T * p) := Nat.mul_le_mul_right _ (by norm_num)
    _ = _ := by ring

end ax

end J6Seg.Side
