  have hT := ccontr4_lin_T (T := weylVar g gi (lcomb c₁ h₁ c₂ h₂)) (T₁ := weylVar g gi h₁) (T₂ := weylVar g gi h₂)
    (x := x) (c₁ := c₁) (c₂ := c₂) (fun a b c d => weylVar_lcomb hU hg hgi hh₁ hh₂ hx a b c d)
  have hv : ∀ A, fvec (lcombC c₁ B₁ c₂ B₂) A x = fun μ => (c₁ : ℂ) * fvec B₁ A x μ + (c₂ : ℂ) * fvec B₂ A x μ :=
    fun A => rfl
  simp only [weylFVar, hT, hv, ccontr4_lin1, ccontr4_lin2, ccontr4_lin3, ccontr4_lin4]
