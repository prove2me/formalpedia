  obtain ⟨hfin, hfl, -, -⟩ := FakeEllipticCurve.isFinite_flat_surjective_of_isIsogenyPair hΛℤ r (2 * k) _ E E _ _
    (isIsogenyPair_act_rpow hΛℤ E r k)
  exact finrank_act_eq_of_isPullbackVia_id E E' uA huA _ y'

theorem finrank_eq_of_rigidification_isPullbackVia {r : ℕ} [Fact r.Prime] {𝒪 : Type} [CommRing 𝒪] {π : 𝒪}
    {Onr : Type} [CommRing Onr] [Algebra 𝒪 Onr] (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    {A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})}
    {B B' : Type} [CommRing B] [Algebra 𝒪 B] [CommRing B'] [Algebra 𝒪 B'] {ψ : Onr →ₐ[𝒪] B} (f : B →ₐ[𝒪] B')
    {E : FakeEllipticCurve Λ N B} {E' : FakeEllipticCurve Λ N B'} (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia (f : B →+* B') E E' g)
    (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (ρ' : FakeEllipticCurve.Rigidification r π A₀ (f.comp ψ) E')
    (h : FakeEllipticCurve.Rigidification.IsPullbackVia f g hg ρ ρ') :
    ∃ (q : (B ⧸ Ideal.span {algebraMap 𝒪 B π}) →+* (B' ⧸ Ideal.span {algebraMap 𝒪 B' π})) (uA : ρ'.Ab.A ⟶ ρ.Ab.A),
      q.comp (Ideal.Quotient.mk _) = (Ideal.Quotient.mk _).comp (f : B →+* B') ∧
      uA ≫ ρ.gA = ρ'.gA ∧ uA ≫ ρ.Ab.f = ρ'.Ab.f ≫ Spec.map (CommRingCat.ofHom q) ∧
      ∀ y : ↥ρ'.Ab.A, ρ'.φ.finrank y = ρ.φ.finrank (uA.base y) ∧
        ∀ k : ℕ, (ρ'.Ab.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩).finrank y =
          (ρ.Ab.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩).finrank (uA.base y) := by
  obtain ⟨ub, uA, hEb, hgb, hAb, hgA, hd, hφ⟩ := h
  obtain ⟨sqE, -, -, -⟩ := hEb
  obtain ⟨sqA, -, hΛA, -⟩ := hAb
  refine ⟨_, uA, ?_, hgA, sqA.w, fun y => ⟨?_, fun k => ?_⟩⟩
  · ext x; simp
  · obtain ⟨hfin, hfl, -, -⟩ := FakeEllipticCurve.isFinite_flat_surjective_of_isIsogenyPair hΛℤ r ρ.d _
      ρ.Eb ρ.Ab ρ.φ ρ.φ' ρ.isIsogenyPair
    have s := sqE
    rw [← ρ.φ_over, ← ρ'.φ_over] at s
    have sq : CategoryTheory.IsPullback ub ρ'.φ ρ.φ uA := s.of_bot hφ sqA
    exact Scheme.Hom.finrank_of_isPullback _ _ _ _ sq y
  · obtain ⟨hfin, hfl, -, -⟩ := FakeEllipticCurve.isFinite_flat_surjective_of_isIsogenyPair hΛℤ r (2 * k) _
      ρ.Ab ρ.Ab _ _ (isIsogenyPair_act_rpow hΛℤ ρ.Ab r k)
    have s := sqA
    rw [← ρ.Ab.act_over ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩, ← ρ'.Ab.act_over ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩] at s
    have sq : CategoryTheory.IsPullback uA (ρ'.Ab.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩)
        (ρ.Ab.act ⟨(((r ^ k : ℕ) : ℤ) : ℚ), hΛℤ _⟩) uA := s.of_bot (hΛA _).symm sqA
    exact Scheme.Hom.finrank_of_isPullback _ _ _ _ sq y

end GPShift.RankKit

