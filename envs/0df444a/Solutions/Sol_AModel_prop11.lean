section Rev

variable {n Q : ℕ}

lemma Step.rev_vec (s : Step n Q) : s.rev.vec = s.invVec := by
  cases s with
  | shift i u c =>
    funext x
    simp only [Step.rev, Step.vec, Step.invVec, shiftVec, shiftInvVec]
    congr 1
    simp only [neg_mul, Finset.sum_neg_distrib, mul_sub, Finset.mul_sum, mul_assoc]
    ring
  | swap i j => rfl

lemma Step.rev_WF {s : Step n Q} (hs : s.WF) : s.rev.WF := by
  cases s with
  | shift i u c =>
    refine ⟨⟨⟨u⁻¹, u, ZMod.inv_mul_of_unit _ hs.1, ZMod.mul_inv_of_unit _ hs.1⟩, rfl⟩,
      fun j hj => ?_⟩
    simp [hs.2 j hj]
  | swap i j => trivial

lemma Step.vec_invVec {s : Step n Q} (hs : s.WF) (x : Fin n → ZMod Q) : s.vec (s.invVec x) = x := by
  cases s with
  | shift i u c => exact shiftVec_shiftInvVec hs.1 hs.2 x
  | swap i j => funext k; simp [Step.vec, Step.invVec]

lemma revSteps_cons (s : Step n Q) (l : List (Step n Q)) :
    revSteps (s :: l) = revSteps l ++ [s.rev] := by simp [revSteps]

lemma runVec_cons (s : Step n Q) (l : List (Step n Q)) (x : Fin n → ZMod Q) :
    runVec (s :: l) x = runVec l (s.vec x) := rfl

lemma runVec_revSteps_runVec {l : List (Step n Q)} (hl : ∀ s ∈ l, s.WF) (x : Fin n → ZMod Q) :
    runVec (revSteps l) (runVec l x) = x := by
  induction l generalizing x with
  | nil => rfl
  | cons s l ih =>
    rw [revSteps_cons, runVec_append, runVec_cons s l,
      ih (fun t ht => hl t (List.mem_cons_of_mem _ ht))]
    change s.rev.vec (s.vec x) = x
    rw [Step.rev_vec]; exact Step.invVec_vec (hl s List.mem_cons_self) x

lemma runVec_runVec_revSteps {l : List (Step n Q)} (hl : ∀ s ∈ l, s.WF) (x : Fin n → ZMod Q) :
    runVec l (runVec (revSteps l) x) = x := by
  induction l generalizing x with
  | nil => rfl
  | cons s l ih =>
    rw [revSteps_cons, runVec_append, runVec_cons]
    change runVec l (s.vec (s.rev.vec _)) = x
    rw [Step.rev_vec, Step.vec_invVec (hl s List.mem_cons_self),
      ih (fun t ht => hl t (List.mem_cons_of_mem _ ht))]

lemma revSteps_WF {l : List (Step n Q)} (hl : ∀ s ∈ l, s.WF) : ∀ s ∈ revSteps l, s.WF := by
  intro s hs
  simp only [revSteps, List.mem_reverse, List.mem_map] at hs
  obtain ⟨t, ht, rfl⟩ := hs
  exact Step.rev_WF (hl t ht)

lemma countP_revSteps (l : List (Step n Q)) :
    (revSteps l).countP Step.isSwap = l.countP Step.isSwap := by
  rw [revSteps, List.countP_reverse, List.countP_map]
  congr 1; funext s; cases s <;> rfl

end Rev

section Tri

variable {m Q : ℕ}

lemma hIdx_pairwise : (hIdx m).Pairwise (· > ·) := by
  rw [hIdx, List.pairwise_map, List.pairwise_reverse]
  exact (List.pairwise_lt_finRange m).imp fun h => by rw [gt_iff_lt, Fin.lt_def]; exact h

lemma dIdx_pairwise : (dIdx m).Pairwise (· > ·) := by
  rw [dIdx, List.pairwise_map, List.pairwise_reverse]
  exact (List.pairwise_lt_finRange m).imp fun h => (Fin.natAdd_lt_natAdd_iff m).2 h

lemma castAdd_mem_hIdx (i : Fin m) : Fin.castAdd m i ∈ hIdx m := by simp [hIdx]

lemma natAdd_not_mem_hIdx (j : Fin m) : Fin.natAdd m j ∉ hIdx m := by
  simp only [hIdx, List.mem_map, not_exists, not_and]
  intro i _ h; exact castAdd_ne_natAdd i j h

lemma natAdd_mem_dIdx (j : Fin m) : Fin.natAdd m j ∈ dIdx m := by
  simp only [dIdx, List.mem_map, List.mem_reverse, List.mem_finRange, true_and]; exact ⟨j, rfl⟩

lemma castAdd_not_mem_dIdx (i : Fin m) : Fin.castAdd m i ∉ dIdx m := by
  simp only [dIdx, List.mem_map, not_exists, not_and]
  intro j _ h; exact castAdd_ne_natAdd i j h.symm

lemma one_lower : ∀ i j : Fin m, i < j → (1 : Matrix (Fin m) (Fin m) (ZMod Q)) i j = 0 :=
  fun _ _ h => one_apply_ne h.ne

lemma runVec_hSteps {E : Matrix (Fin m) (Fin m) (ZMod Q)} (hE : ∀ i j, i < j → E i j = 0)
    (x : Fin (m + m) → ZMod Q) :
    hv (runVec (hSteps E) x) = E *ᵥ hv x ∧ dv (runVec (hSteps E) x) = dv x := by
  rw [hSteps, runVec_shifts_aux (blk_lower hE one_lower 0) _ hIdx_pairwise]
  have hb := blk_mulVec E 0 0 1 x
  refine ⟨?_, ?_⟩
  · funext i
    have := congrFun hb.1 i
    simp only [hv, castAdd_mem_hIdx, if_true] at this ⊢
    simpa using this
  · funext j
    simp only [dv, natAdd_not_mem_hIdx, if_false]

lemma runVec_dSteps {E : Matrix (Fin m) (Fin m) (ZMod Q)} (hE : ∀ i j, i < j → E i j = 0)
    (x : Fin (m + m) → ZMod Q) :
    hv (runVec (dSteps E) x) = hv x ∧ dv (runVec (dSteps E) x) = E *ᵥ dv x := by
  rw [dSteps, runVec_shifts_aux (blk_lower one_lower hE 0) _ dIdx_pairwise]
  have hb := blk_mulVec 1 0 0 E x
  refine ⟨?_, ?_⟩
  · funext i
    simp only [hv, castAdd_not_mem_dIdx, if_false]
  · funext j
    have := congrFun hb.2 j
    simp only [dv, natAdd_mem_dIdx, if_true] at this ⊢
    simpa using this

lemma shiftStep_WF {n : ℕ} {E : Matrix (Fin n) (Fin n) (ZMod Q)} {i : Fin n} (hd : IsUnit (E i i)) :
    (shiftStep E i).WF :=
  ⟨hd, fun j hj => by simp [not_lt.2 hj]⟩

lemma hSteps_WF {E : Matrix (Fin m) (Fin m) (ZMod Q)} (hd : ∀ i, IsUnit (E i i)) :
    ∀ s ∈ hSteps E, s.WF := by
  intro s hs
  simp only [hSteps, hIdx, List.mem_map, List.mem_reverse, List.mem_finRange, true_and] at hs
  obtain ⟨_, ⟨i, rfl⟩, rfl⟩ := hs
  exact shiftStep_WF (by simpa [AModel.blk] using hd i)

lemma dSteps_WF {E : Matrix (Fin m) (Fin m) (ZMod Q)} (hd : ∀ i, IsUnit (E i i)) :
    ∀ s ∈ dSteps E, s.WF := by
  intro s hs
  simp only [dSteps, dIdx, List.mem_map, List.mem_reverse, List.mem_finRange, true_and] at hs
  obtain ⟨_, ⟨i, rfl⟩, rfl⟩ := hs
  exact shiftStep_WF (by simpa [AModel.blk, -Fin.natAdd_eq_addNat] using hd i)

lemma countP_hSteps (E : Matrix (Fin m) (Fin m) (ZMod Q)) : (hSteps E).countP Step.isSwap = 0 := by
  rw [List.countP_eq_zero]
  intro s hs
  simp only [hSteps, List.mem_map] at hs
  obtain ⟨_, -, rfl⟩ := hs; simp [shiftStep, Step.isSwap]

lemma countP_dSteps (E : Matrix (Fin m) (Fin m) (ZMod Q)) : (dSteps E).countP Step.isSwap = 0 := by
  rw [List.countP_eq_zero]
  intro s hs
  simp only [dSteps, List.mem_map] at hs
  obtain ⟨_, -, rfl⟩ := hs; simp [shiftStep, Step.isSwap]

