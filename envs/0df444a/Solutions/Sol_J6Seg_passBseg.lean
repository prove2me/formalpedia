section
-- Source module: Solutions.J6SegLn11
/-!
# Segmented inverse (S2), machine side 11: the `B₀` tensor pass

Axis by axis (`tensorGo`, as the frozen `KFY.passB`), every `t_i`-line `X` is replaced by the
`t_i` values `B0seg … (X as a function) l` (zero for `l ≥ s_i`): this is what `lineB` computes
(`lineB_list`, with `n_c λ = t_i`).

**`passBseg`**: for per-axis maps `Bm i` with `‖Bm i‖ ≤ 1/2`, the per-axis bound `9` of
`r6_axisMaps_fit` and `B0seg 0 = 0`, from `RepFull ys y`, `‖y‖ ≤ 1`:
`RepPad` of the result, every entry in the disc (`GB (p+2)`), and
`‖vOf − tensCLM (kerB Bm) y‖ ≤ 9 d · 2^{-p}`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Complex

namespace J6Seg
open IntMul IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf NLogN.KFM NLogN.KFY IntMul.OpenAI.RT
open NLogN.KFB (GI gflat)

/-! ## `lineB` as a list map -/

/-! ## Facts on `B0seg` -/

theorem B0seg_ge {p P R lam w s t α : ℕ} (U : ℕ → ℤ × ℤ) {l : ℕ} (hl : s ≤ l) :
    B0seg p P R lam w s t α U l = (0, 0) := by
  simp [B0seg, Dapprox, segJ, not_lt.2 hl]

theorem B0seg_congr {p P R lam w s t α : ℕ} (ht : 0 < t) {U U' : ℕ → ℤ × ℤ}
    (h : ∀ j < t, U j = U' j) : B0seg p P R lam w s t α U = B0seg p P R lam w s t α U' := by
  haveI : NeZero t := ⟨by omega⟩
  have hc : cSel s t U = cSel s t U' := funext fun l => by
    unfold cSel; exact h _ (ZMod.val_lt _)
  unfold B0seg; rw [hc]

/-! ## Padded vs periodic slice maps -/

section gen
variable {d : ℕ} (s : Fin d → ℕ) (F G : Fin d → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ))

theorem gen_vanish (hF0 : ∀ i, F i (fun _ => (0, 0)) = fun _ => (0, 0))
    (hpad : ∀ i U l, s i ≤ l → F i U l = (0, 0)) :
    ∀ (l : List (Fin d)) (x : (Fin d → ℕ) → ℤ × ℤ) (j : Fin d → ℕ),
      (∃ i ∈ l, s i ≤ j i) → sliceCompZ F l x j = (0, 0)
  | [], _, _, ⟨i, hi, _⟩ => by simp at hi
  | i0 :: l, x, j, ⟨i, hi, hij⟩ => by
    simp only [sliceCompZ, Function.comp]
    by_cases hl : ∃ i ∈ l, s i ≤ j i
    · exact gen_vanish hF0 hpad l _ j hl
    · push Not at hl
      have hi0 : i = i0 := by
        rcases List.mem_cons.1 hi with h | h
        · exact h
        · exact absurd hij (not_le.2 (hl i h))
      subst hi0
      have hnl : i ∉ l := fun h => absurd hij (not_le.2 (hl i h))
      rw [sliceCompZ_local F i (j i) l hnl _ (fun _ => (0, 0)) (fun m hm => by
          simp only [sliceMapZ, hm, hpad i _ _ hij]) j rfl,
        sliceCompZ_zero F hF0 l]

theorem gen_agree (hFG : ∀ i U l, l < s i → F i U l = G i U l) :
    ∀ (l : List (Fin d)), l.Nodup → ∀ (x : (Fin d → ℕ) → ℤ × ℤ) (j : Fin d → ℕ),
      (∀ i, j i < s i) → sliceCompZ F l x j = sliceCompZ G l x j
  | [], _, _, _, _ => rfl
  | i0 :: l, hnd, x, j, hj => by
    rw [List.nodup_cons] at hnd
    simp only [sliceCompZ, Function.comp]
    rw [gen_agree hFG l hnd.2 _ j hj]
    refine sliceCompZ_local G i0 (j i0) l hnd.1 _ _ (fun m hm => ?_) j rfl
    simp only [sliceMapZ, hm]
    exact hFG i0 _ _ (hj i0)

end gen

/-! ## The tensor pass -/

section pass
variable {d : ℕ} (p R lam w α : ℕ) (Pf : ℕ → ℕ) (s t : Fin d → ℕ) [∀ i, NeZero (s i)]
  [∀ i, NeZero (t i)]

lemma B0F_eq (i : Fin d) : B0F p R lam w α Pf s t i =
    B0seg p (Pf (s i)) R lam w (s i) (t i) α := by
  simp only [B0F, B0ax, ofFn_getD]

theorem tensorGo_mapsBs (ys : List GI) (hz : ys.length = (List.ofFn t).prod) :
    tensorGo (mapsBs p R lam w α Pf s t) (List.ofFn t) ys = listOf (List.ofFn t) fun j =>
      tensorMapZ (B0F p R lam w α Pf s t) (gIn (List.ofFn t) ys) fun i => j i := by
  have hpos : ∀ i < d, 0 < (List.ofFn t).getD i 1 := fun i hi => by
    rw [ofFn_getD t ⟨i, hi⟩]; exact Nat.pos_of_ne_zero (NeZero.ne _)
  have h := tensorGo_eq d (List.ofFn t) (List.ofFn t) (by simp) (by simp) hpos
    (B0ax p R lam w α Pf s t)
    (fun i hi U U' h => B0seg_congr (hpos i hi) h)
    (gIn (List.ofFn t) ys)
  rw [listOf_gIn (List.ofFn t) (by simp) ys hz] at h
  exact h

/-- **The `B₀` tensor pass with the segmented inverse.** -/
theorem passBseg_sol_aux (hp18 : 18 ≤ (2 : ℝ) ^ p) (hst : ∀ i, s i ≤ t i) (ys : List GI)
    (y : ((i : Fin d) → ZMod (t i)) → ℂ) (hrep : RepFull p t ys y) (hy : ‖y‖ ≤ 1)
    (Bm : (i : Fin d) → (ZMod (t i) → ℂ) →L[ℂ] (ZMod (s i) → ℂ))
    (hBn : ∀ i, ‖Bm i‖ ≤ 1 / 2)
    (hErr : ∀ i (W : ℕ → ℤ × ℤ), (∀ k, ‖IntMul.HvdH.P47.toC (W k)‖ ≤ 2 ^ p) →
      ∀ l : ZMod (s i), ‖IntMul.HvdH.P47.toC (B0seg p (Pf (s i)) R lam w (s i) (t i) α W l.val) -
        2 ^ p * Bm i (fun k => IntMul.HvdH.P47.toC (W k.val) / 2 ^ p) l‖ ≤ 9)
    (hZ : ∀ i, B0seg p (Pf (s i)) R lam w (s i) (t i) α (fun _ => (0, 0)) = fun _ => (0, 0)) :
    RepPad p s t (tensorGo (mapsBs p R lam w α Pf s t) (List.ofFn t) ys)
        (vOf p s t (tensorGo (mapsBs p R lam w α Pf s t) (List.ofFn t) ys)) ∧
      DiscL p (tensorGo (mapsBs p R lam w α Pf s t) (List.ofFn t) ys) ∧
      ‖vOf p s t (tensorGo (mapsBs p R lam w α Pf s t) (List.ofFn t) ys) - tensCLM (kerB Bm) y‖ ≤
        (9 * d) * hp p := by
  rw [tensorGo_mapsBs p R lam w α Pf s t ys hrep.1]
  set F := B0F p R lam w α Pf s t with hFdef
  set G := B0G p R lam w α Pf s t with hGdef
  set U := gIn (d := d) (List.ofFn t) ys with hU
  set L := listOf (List.ofFn t) fun j => tensorMapZ F U fun i => j i with hL
  have hUd : InDisc p U := fun j => repFull_disc p t hrep hy _
  have hp0 : (0 : ℝ) < 2 ^ p := by positivity
  -- the periodic maps are `FPApprox` of the lifted `Bm i`
  have hFP : ∀ i, FPApprox p (G i) (liftL (Bm i)) 9 := by
    intro i W hW
    have hs0 : 0 < s i := Nat.pos_of_ne_zero (NeZero.ne _)
    have hW' : ∀ k, ‖IntMul.HvdH.P47.toC (W k)‖ ≤ 2 ^ p := hW
    have key : ∀ l : ℕ, G i W l =
        B0seg p (Pf (s i)) R lam w (s i) (t i) α W ((l : ZMod (s i)).val) := by
      intro l
      simp only [hGdef, B0G, ZMod.val_natCast]
      rw [show B0ax p R lam w α Pf s t i = B0seg p (Pf (s i)) R lam w (s i) (t i) α from
        B0F_eq p R lam w α Pf s t i]
    have herr : ∀ l : ℕ, ‖gC (G i W l) - 2 ^ p * liftL (Bm i) (fun j => gC (W j) / 2 ^ p) l‖ ≤ 9 := by
      intro l
      rw [key]
      exact hErr i W hW' (l : ZMod (s i))
    refine ⟨fun l => ?_, herr⟩
    -- the output stays in the disc: `‖Bm i x‖ ≤ 1/2` on the unit disc
    have hx : ‖(fun k : ZMod (t i) => gC (W k.val) / 2 ^ p)‖ ≤ 1 := by
      refine (pi_norm_le_iff_of_nonneg zero_le_one).2 fun k => ?_
      rw [norm_div, norm_pow, RCLike.norm_ofNat, div_le_one hp0]
      exact hW _
    have hBx : ‖liftL (Bm i) (fun j => gC (W j) / 2 ^ p) l‖ ≤ 1 / 2 := by
      unfold liftL
      calc ‖Bm i (fun k => gC (W k.val) / 2 ^ p) (l : ZMod (s i))‖
          ≤ ‖Bm i (fun k => gC (W k.val) / 2 ^ p)‖ := norm_le_pi_norm _ _
        _ ≤ ‖Bm i‖ * ‖(fun k : ZMod (t i) => gC (W k.val) / 2 ^ p)‖ := (Bm i).le_opNorm _
        _ ≤ 1 / 2 * 1 := mul_le_mul (hBn i) hx (norm_nonneg _) (by norm_num)
        _ = 1 / 2 := by ring
    have h1 := herr l
    have h2 : ‖gC (G i W l)‖ ≤ 9 + 2 ^ p * (1 / 2) := by
      have := norm_sub_norm_le (gC (G i W l)) (2 ^ p * liftL (Bm i) (fun j => gC (W j) / 2 ^ p) l)
      rw [norm_mul, norm_pow, RCLike.norm_ofNat] at this
      nlinarith
    linarith
  have hLip : ∀ i, SupLip (liftL (Bm i)) := fun i => supLip_liftL _ (by linarith [hBn i])
  obtain ⟨h1, h2⟩ := tensor_fp p G Bm (fun _ => 9) hFP hLip U hUd
  have hy' : (fun k : (i : Fin d) → ZMod (t i) => gC (U fun i => (k i).val) / 2 ^ p) = y := by
    funext k
    obtain ⟨hx, hdig⟩ := box_pt t (fun i => (k i).val) (fun i => ZMod.val_lt _)
    simp only [hU, gIn]
    rw [hrep.2 _ hx]
    have : (fun i => (((boxIx t (rmPos (List.ofFn t) (extF fun i => (k i).val)) i : ℕ) :
        ZMod (t i)))) = k := by
      funext i; simp only [boxIx, hdig, extF, dif_pos i.2]; simp
    rw [this]; field_simp
  have hnd : (List.finRange d).Nodup := List.nodup_finRange d
  have hFG : ∀ i U l, l < s i → F i U l = G i U l := by
    intro i U l hl
    simp only [hFdef, hGdef, B0F, B0G, Nat.mod_eq_of_lt hl]
  have hF0 : ∀ i, F i (fun _ => (0, 0)) = fun _ => (0, 0) := by
    intro i; rw [hFdef, B0F_eq]; exact hZ i
  have hpad : ∀ i U l, s i ≤ l → F i U l = (0, 0) := by
    intro i U l hl; rw [hFdef, B0F_eq]; exact B0seg_ge U hl
  have hagree : ∀ j : Fin d → ℕ, (∀ i, j i < s i) → tensorMapZ F U j = tensorMapZ G U j :=
    fun j hj => gen_agree s F G hFG _ hnd U j hj
  have hvan : ∀ j : Fin d → ℕ, (∃ i, s i ≤ j i) → tensorMapZ F U j = (0, 0) :=
    fun j ⟨i, hi⟩ => gen_vanish s F hF0 hpad _ U j ⟨i, List.mem_finRange i, hi⟩
  have hLl : L.length = (List.ofFn t).prod := length_listOf _ _
  have hLx : ∀ x < (List.ofFn t).prod,
      L.getD x 0 = tensorMapZ F U fun i => digL (List.ofFn t) x i := by
    intro x hx
    rw [hL, getD_listOf' _ _ _ hx]
  refine ⟨⟨hLl, fun x hx => ⟨fun hin => ?_, fun hout => ?_⟩⟩, ?_, ?_⟩
  · -- inside the source box
    simp only [vOf]
    have hv : ∀ i : Fin d, ((boxIx t x i : ℕ) : ZMod (s i)).val = digL (List.ofFn t) x i :=
      fun i => val_cast_lt (hin i)
    simp only [hv]
    rw [extF_digL, rmPos_digL _ x hx]
    field_simp
  · -- outside: exact zeros
    push Not at hout
    obtain ⟨i, hi⟩ := hout
    rw [hLx x hx]
    exact hvan _ ⟨i, hi⟩
  · -- disc
    intro z hz
    simp only [hL, listOf, List.mem_map] at hz
    obtain ⟨l, -, rfl⟩ := hz
    set j := fun i : Fin d => (fun i => l.getD i 0) (i : ℕ)
    by_cases hin : ∀ i, j i < s i
    · rw [hagree j hin]; exact h1 _
    · push Not at hin
      rw [hvan j hin, gC_zero', norm_zero]; positivity
  · -- error
    refine (pi_norm_le_iff_of_nonneg (by unfold hp; positivity)).2 fun pt => ?_
    have hst' : ∀ i, (pt i).val < t i := fun i => lt_of_lt_of_le (ZMod.val_lt _) (hst i)
    obtain ⟨hx, hdig⟩ := box_pt t (fun i => (pt i).val) hst'
    have hval : vOf p s t L pt = gC (tensorMapZ G U fun i => (pt i).val) / 2 ^ p := by
      simp only [vOf]
      rw [hLx _ hx]
      have : (fun i : Fin d => digL (List.ofFn t)
          (rmPos (List.ofFn t) (extF fun i => (pt i).val)) i) = fun i => (pt i).val := by
        funext i; rw [hdig]; simp [extF]
      rw [this, hagree _ (fun i => ZMod.val_lt _)]
    rw [Pi.sub_apply, hval, tensCLM_apply, kerB_eq_kerL]
    have e2 := h2 (fun i => (pt i).val)
    rw [hy'] at e2
    simp only [ZMod.natCast_zmod_val] at e2
    have : gC (tensorMapZ G U fun i => (pt i).val) / 2 ^ p - tens (kerL Bm) y pt =
        (gC (tensorMapZ G U fun i => (pt i).val) - 2 ^ p * tens (kerL Bm) y pt) / 2 ^ p := by
      field_simp
    rw [this, norm_div, norm_pow, RCLike.norm_ofNat, div_le_iff₀ hp0]
    have hh : hp p * 2 ^ p = 1 := by
      unfold hp; rw [inv_pow, inv_mul_cancel₀ (by positivity)]
    refine e2.trans (le_of_eq ?_)
    rw [mul_assoc, hh, mul_one]
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    ring

end pass

