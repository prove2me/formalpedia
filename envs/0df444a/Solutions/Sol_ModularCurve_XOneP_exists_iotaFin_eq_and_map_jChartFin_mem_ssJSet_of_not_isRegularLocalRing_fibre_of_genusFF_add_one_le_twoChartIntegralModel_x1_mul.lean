  obtain ⟨𝒱, -, -⟩ := AlgebraicCurve.TwoChartIntegralModel.exists_twoAffineOpenCover_U0_eq_chartFinOpen A (↥K) j
  let 𝒱b : Xb.TwoAffineOpenCover := 𝒱.pullback (toBase A (↥K) j) Ω₀

  have hδ := AlgebraicGeometry.eulerChar_sectionsOf_le_sub_genusFF_sub_natCard_not_isRegularLocalRing
