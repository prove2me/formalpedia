variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

theorem NLogN.KFW.mdTQ {K S r H P D ρ k q0 Bp Z Mb Bz : ℕ} (lo hi : ℕ) (hρ : ρ < K) (hS : 1 ≤ S)
    (hP : 1 ≤ P) (hr : 1 ≤ r) (hD : 1 ≤ D)
    (hZ16 : zsz ((16 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z)
    (hMb : zsz (Mb : ℤ) ≤ Bz) (hM : K * D + P + 10 ≤ Mb) :
    ∀ f j (σ : Fin HS → Option ℤ), CoreR σ K S r H P D ρ k q0 Bp → j ≤ D % 8 → D % 8 ≤ j + f →
      j + f ≤ 7 →
      SImplQ Isym tbl (fun s => Agree σ s) lo hi r (fun x : Fin D => KFH.stT K D S ρ x)
        (P * 2 ^ (K * D) * S) (tensF (kerAt (⟨0, hD⟩ : Fin D) (Butterfly.cb ^ D • (1 : M2))))
        (mdT j f) (D / 2 + D % 2) 2
        (fun w => f * cMdT Bz + cMdK (P * 2 ^ (K * D) * S * r) Z Bz w) := by sorry
