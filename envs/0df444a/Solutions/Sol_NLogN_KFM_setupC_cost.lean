  have h4 : 64 * x ^ 2 * m.factorial ≤ 2 ^ (64 * x ^ 2) * (2 ^ m) ^ m :=
    Nat.mul_le_mul h3 (h1.trans h2)
  rw [← pow_mul, ← pow_add] at h4
  refine h4.trans (Nat.pow_le_pow_right (by norm_num) ?_)
  rw [hm]
  nlinarith [sq_nonneg (x ^ 2), Nat.zero_le (x ^ 2), Nat.zero_le (x ^ 4)]

