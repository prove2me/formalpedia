theorem geomFibreH0Finrank_id (k : Type) [Field k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k)) [IsProper f]
    (M : A.Modules) (hM : Scheme.Modules.IsInvertible M) (𝒰 : A.OrderedAffineCover) :
    Scheme.Modules.geomFibreH0Finrank f M k (RingHom.id k) =
