    (decN : ∀ σ ∈ A.decompositionSubgroup ℚ, ∀ x : JZero (N₀ * p), F.ExtN x → F.ExtN (σ • x))
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (hσ : σ ∈ A.decompositionSubgroup ℚ) {x : JZero (N₀ * p)} (hx : x ∈ F.extPts) : σ • x ∈ F.extPts :=
