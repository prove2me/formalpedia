  have S8 := Sp.popI ((t5.upd 1 (t.G 1)).upd 2 (t.G 2)) (i := 4) (by decide) (a := (vol C : ℤ))
    (L := t.G 4) (by simp (config := {decide := true}) [t5, t4, t3, t2, t1]) zC
  have H := G.seq (S2.seq (S3.seq (S4.seq (S5.seq (S6.seq (S7.seq S8))))))
