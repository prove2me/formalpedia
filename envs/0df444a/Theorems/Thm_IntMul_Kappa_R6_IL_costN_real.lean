variable {W T m : ℕ} [NeZero W]

theorem IntMul.Kappa.R6.IL.costN_real (C : Bit.QHNet (ZMod 2) W T m) (q Bb : ℕ) (hm : 2 ≤ m) (hruns : C.RunsOK) :
    ∀ e, 1 ≤ e → ∀ V : ℕ, (costN C q Bb e V : ℝ) ≤
      (2 * cq q + Kv C : ℝ) * ((V : ℝ) * Bit.cH C e) + (KA C q : ℝ) * ovN C e * ((Bb : ℝ) + 2) ^ 2 := by sorry
