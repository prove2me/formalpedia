theorem solution (k : Type) [Field k] (n : ℕ) (D : TypeDensity.ExceptionalDivisor k)
    (hD : TypeDensity.exceptionalDegree k D = n) :
    (TypeDensity.divisorAffinePolynomial k D).Monic ∧ (TypeDensity.divisorAffinePolynomial k D).natDegree = n - D
      (TypeDensity.infinityDirection k) ∧ D (TypeDensity.infinityDirection k) ≤ n ∧ TypeDensity.formPoly (TypeDensity.divisorVector k n D) =
      TypeDensity.divisorAffinePolynomial k D ∧ TypeDensity.divisorVector k n D (⟨n - D (TypeDensity.infinityDirection k),
      Nat.lt_succ_of_le (Nat.sub_le _ _)⟩ :
      Fin (n+1)) = 1 ∧ (∀ i : Fin (n+1), n - D (TypeDensity.infinityDirection k) < i.val → TypeDensity.divisorVector k n D
      i = 0) ∧ TypeDensity.divisorVector k n D ≠ 0 := by
  classical
  set g : TypeDensity.ClosedDirection k → ℕ → Polynomial k :=
    fun P r => (match P with | none => 1 | some phi => phi.val ^ r) with hg
  have hmon : ∀ P r, (g P r).Monic := by
    intro P r
    cases P with
    | none => exact Polynomial.monic_one
    | some phi => exact phi.property.1.pow r
  have hM : (TypeDensity.divisorAffinePolynomial k D).Monic := by
    unfold TypeDensity.divisorAffinePolynomial
    exact Polynomial.monic_prod_of_monic _ _ (fun P _ => hmon P (D P))
  have hdeg : (TypeDensity.divisorAffinePolynomial k D).natDegree = ∑ P ∈ D.support, (g P (D P)).natDegree := by
    unfold TypeDensity.divisorAffinePolynomial
    exact Polynomial.natDegree_prod_of_monic _ _ (fun P _ => hmon P (D P))
  have hsum : TypeDensity.exceptionalDegree k D = (TypeDensity.divisorAffinePolynomial k D).natDegree + D none := by
    rw [hdeg]
    have : ∀ P ∈ D.support, TypeDensity.directionDegree k P * D P = (g P (D P)).natDegree +
        (if none = P then D P else 0) := by
      intro P _
      cases P with
      | none => simp [TypeDensity.directionDegree, hg]
      | some phi => simp [TypeDensity.directionDegree, hg, Polynomial.natDegree_pow]; ring
    unfold TypeDensity.exceptionalDegree Finsupp.sum
    rw [Finset.sum_congr rfl this, Finset.sum_add_distrib]
    congr 1
    by_cases h : none ∈ D.support
    · rw [Finset.sum_eq_single none]
      · simp
      · intro b _ hb; exact if_neg (Ne.symm hb)
      · intro h'; exact absurd h h'
    · have : D none = 0 := by simpa using h
      simp [this]
  have hinf : TypeDensity.infinityDirection k = none := rfl
  simp only [hinf]
  have h1 : (TypeDensity.divisorAffinePolynomial k D).natDegree = n - D none := by omega
  have h2 : D none ≤ n := by omega
  have hle : (TypeDensity.divisorAffinePolynomial k D).natDegree < n + 1 := by omega
  have hcoef : TypeDensity.divisorVector k n D (⟨n - D none, by omega⟩ : Fin (n+1)) = 1 := by
    change (TypeDensity.divisorAffinePolynomial k D).coeff (n - D none) = 1
    rw [← h1]; exact hM
  refine ⟨hM, h1, h2, ?_, hcoef, ?_, ?_⟩
  · unfold TypeDensity.formPoly
    conv_rhs => rw [Polynomial.as_sum_range' _ (n+1) hle]
    rw [← Fin.sum_univ_eq_sum_range (fun i => Polynomial.monomial i
        ((TypeDensity.divisorAffinePolynomial k D).coeff i))]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Polynomial.C_mul_X_pow_eq_monomial]; rfl
  · intro i hi
    exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
  · intro h0
    have := congrFun h0 ⟨n - D none, by omega⟩
    rw [hcoef] at this
    simp at this
