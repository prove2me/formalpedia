-- Source module: Solutions.R6CxCost
/-!
# R2: cost of the recursive C-layer through a `Prop8IfaceH` network (moment recurrence)

Cost model (§5.3, as `Butterfly.recCost`, now on any number of axes `e = m f + r`): a node on
`e ≥ m` axes and data volume `V` costs `Lloc · V` for the local steps of one network invocation
(`locWork_le_vol`: `Lloc = nloc (W+T)²/W` bounds the actual entry operations), `r · V` for the
`r = e mod m` leftover individual kernels, and one recursive call on `|S| f` axes and volume
`V / W` per child; a leaf (`e < m`) costs `e · V` (individual kernels).

* `recCostH_lin`: `recCostH e V = V · recCostH e 1`.
* `recCostH_unit_node`: the per-volume recurrence `c(e) = Lloc + r + (1/W) ∑_w n_w c(w f)`.
* **`recCostH_le`**: if `∑_w n_w (w/m)^σ < W` (`histMoment h m σ < W`), then
  `recCostH e V ≤ K · V · e^σ` for all `e, V ≥ 0` (via `moment_recurrence_bound` applied to the
  running maximum of `c`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx

open Matrix Finset Complex Butterfly P8Lift

variable {W T m : ℕ} {h : List (ℕ × ℕ)} [NeZero W]

/-! ## The local work of one invocation -/

section Local

variable {R : Type} [Fintype R] [DecidableEq R]

lemma HStep.locR_isChild (st : HStep R m) (r : RStep R m) (hr : st.locR = some r) :
    r.isChild = false := by
  cases st <;> simp [HStep.locR] at hr <;> subst hr <;> rfl

end Local

/-- **Local work** `≤ nloc · (W+T) · |states|`, i.e. `≤ (nloc (W+T)²/W) · V` with the data
volume `V = W · 2^{m|κ|}`. -/
theorem Prop8IfaceH.locWork_le_vol_sol_aux (J : Prop8IfaceH W T m h) (κ : Type) [Fintype κ]
    [DecidableEq κ] :
    (J.locWork κ : ℝ) ≤ ((J.net.filterMap HStep.locR).length * ((W + T : ℕ) : ℝ) ^ 2 / W) *
      (W * 2 ^ (m * Fintype.card κ)) := by
  have hW : (0 : ℝ) < W := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne W)
  have key : J.locWork κ ≤ (J.net.filterMap HStep.locR).length *
      ((W + T) * Fintype.card ((Fin W ⊕ Fin T) × Addr m κ)) := by
    unfold Prop8IfaceH.locWork
    have hb : ∀ r ∈ J.net.filterMap HStep.locR, r.work (1 : Op κ) ≤
        (W + T) * Fintype.card ((Fin W ⊕ Fin T) × Addr m κ) := by
      intro r hr
      obtain ⟨st, -, hst⟩ := List.mem_filterMap.1 hr
      have := RStep.work_le (1 : Op κ) r (HStep.locR_isChild st r hst)
      simpa using this
    generalize J.net.filterMap HStep.locR = l at hb
    induction l with
    | nil => simp
    | cons a l ih =>
      simp only [List.map_cons, List.sum_cons, List.length_cons]
      have := hb a List.mem_cons_self
      have := ih fun r hr => hb r (List.mem_cons_of_mem _ hr)
      nlinarith
  have hcard : Fintype.card ((Fin W ⊕ Fin T) × Addr m κ) = (W + T) * 2 ^ (m * Fintype.card κ) := by
    simp [Fintype.card_prod, Fintype.card_sum, Fintype.card_fun, Fintype.card_fin]
  rw [hcard] at key
  have key' : (J.locWork κ : ℝ) ≤ (J.net.filterMap HStep.locR).length *
      (((W + T : ℕ) : ℝ) * (((W + T : ℕ) : ℝ) * 2 ^ (m * Fintype.card κ))) := by
    exact_mod_cast key
  calc (J.locWork κ : ℝ) ≤ _ := key'
    _ = _ := by field_simp

end IntMul.Kappa.R6.Cx

end

theorem solution : type_of% @IntMul.Kappa.R6.Cx.Prop8IfaceH.locWork_le_vol_sol_aux := @IntMul.Kappa.R6.Cx.Prop8IfaceH.locWork_le_vol_sol_aux
