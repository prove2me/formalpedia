variable {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}

theorem isInStabilizer_of_iso (L : RelativeGroupLaw R f) {𝓛 𝓛' : A.Modules} (e : 𝓛 ≅ 𝓛')
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (x : SchemeHomOver t f)
    (h : L.IsInStabilizer 𝓛' t x) : L.IsInStabilizer 𝓛 t x := by
  unfold RelativeGroupLaw.IsInStabilizer at h ⊢
  exact ((Scheme.Modules.LocallyIsoOver.of_iso _ ((Scheme.Modules.pullback _).mapIso e)).trans h).trans
    (Scheme.Modules.LocallyIsoOver.of_iso _ ((Scheme.Modules.pullback _).mapIso e.symm))

theorem pow_eq_nsmul (L : RelativeGroupLaw R f) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R))
    (x : SchemeHomOver t f) (n : ℕ) :
    (letI := L.pointGroup t; x ^ n) = L.nsmul t n x := by
  letI := L.pointGroup t
  induction n with
  | zero => rw [pow_zero]; rfl
  | succ n ih => rw [pow_succ, ih]; rfl

theorem val_nsmul_eq_comp_schemeNsmul (L : RelativeGroupLaw R f) (n : ℕ)
    (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of R))) f) :
    (L.nsmul (𝟙 (Spec (CommRingCat.of R))) n x).1 = x.1 ≫ L.schemeNsmul n := by
  have hx : GoodReductionJacobian.schemeHomOverComp x.1 x.2 (RelativeGroupLaw.idPoint (f := f)) = x :=
    Subtype.ext (Category.comp_id _)
  have h := L.nsmul_natural f (𝟙 (Spec (CommRingCat.of R))) x.1 x.2 n RelativeGroupLaw.idPoint
  rw [hx] at h
  rw [← h]
  rfl

end AlgebraicGeometry.Polarisation.KernelPowFinite

open AlgebraicGeometry.Polarisation.KernelPowFinite in
theorem solution
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle k f)
    (𝓜 : A.Modules) (h𝓜 : Scheme.Modules.IsInvertible 𝓜) (hK : (kernelPts f L 𝓜).Finite)
    (n : ℕ) (hn : 0 < n) (𝓝 : A.Modules) (e : 𝓝 ≅ 𝓜.tensorPow n) :
    (kernelPts f L 𝓝).Finite := by
  classical

  obtain ⟨hfin, -⟩ :=
    RelativeGroupLaw.isFinite_and_flat_schemeNsmul L hA (fun t x y => hc t x y) n hn

  have hsub : kernelPts f L 𝓝 ⊆ ⋃ y ∈ kernelPts f L 𝓜,
      {x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f |
        L.nsmul (𝟙 (Spec (CommRingCat.of k))) n x = y} := by
    intro x hx
    have hx' : L.IsInStabilizer 𝓝 (𝟙 (Spec (CommRingCat.of k))) x := hx
    have hxM : L.IsInStabilizer (𝓜.tensorPow n) (𝟙 (Spec (CommRingCat.of k))) x :=
      isInStabilizer_of_iso L e.symm _ x hx'
    have hpow := RelativeGroupLaw.isInStabilizer_pow_of_isInStabilizer_tensorPow_of_abelianSchemePropertyBundle
      k f L hc hA 𝓜 h𝓜 n (𝟙 (Spec (CommRingCat.of k))) x hxM
    rw [pow_eq_nsmul] at hpow
    simp only [Set.mem_iUnion, Set.mem_setOf_eq, exists_prop]
    exact ⟨L.nsmul (𝟙 (Spec (CommRingCat.of k))) n x, hpow, rfl⟩
  refine Set.Finite.subset (Set.Finite.biUnion hK fun y _ => ?_) hsub

  haveI := hfin
  have hF : Finite (SchemeHomOver y.1 (L.schemeNsmul n)) :=
    AlgebraicGeometry.finite_schemeHomOver_of_isFinite (L.schemeNsmul n) k y.1
  refine Set.finite_coe_iff.mp (Finite.of_injective
    (fun x : {x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f |
        L.nsmul (𝟙 (Spec (CommRingCat.of k))) n x = y} =>
      (⟨x.1.1, by
        have hx2 : L.nsmul (𝟙 (Spec (CommRingCat.of k))) n x.1 = y := x.2
        rw [← val_nsmul_eq_comp_schemeNsmul, hx2]⟩ : SchemeHomOver y.1 (L.schemeNsmul n))) ?_)
  intro a b hab
  have h := congrArg Subtype.val hab
  exact Subtype.ext (Subtype.ext h)

end S_AlgebraicGeometry_Polarisation_finite_kernelPts_of_iso_tensorPow_of_finite_kernelPts
