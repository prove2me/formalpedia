/-!
# Round six, item language (I3): cost bounds of the pads

With `Y = Yu r Z H`:

* `cost_padH`: the register part of a pad (`padCU`) on `≤ 2 Nn r` entries costs `≤ 10^8 Nn Y`;
* `cost_scaleH`: the scale pad on `N` records costs `≤ 10^16 N Y`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly

/-- **The register part of a pad.** -/
theorem cost_padH_sol_aux {L0 Q Z w dw r H Nn : ℕ} (hL : L0 ≤ 2 * (Nn * r)) (hQ : Q ≤ 2 * (Nn * r))
    (hw : w + dw ≤ H) (hZ : zsz (L0 : ℤ) ≤ Z) (hN : 1 ≤ Nn) :
    400 * (cPadC L0 Q Z w dw (fun _ => 0) + 0) ≤ 10 ^ 8 * (Nn * Yu r Z H) := by
  unfold cPadC KFN.cMv cLp cRep
  set R := Nn * r with hR
  have hY1 := yu_z1 r Z H
  have hYr := yu_r r Z H
  have hY8 := yu_8 r Z H
  set Y := Yu r Z H
  have hNY : Y ≤ Nn * Y := Nat.le_mul_of_pos_left _ hN
  have hRY : R * (2 * H + 21) ≤ Nn * Y := by
    calc R * (2 * H + 21) = Nn * (r * (2 * H + 21)) := by rw [hR]; ring
      _ ≤ Nn * Y := Nat.mul_le_mul_left _ hYr
  have a1 : L0 * (250 * (w + 2)) ≤ 250 * (R * (2 * H + 21)) := by
    calc L0 * (250 * (w + 2)) ≤ (2 * R) * (250 * (w + 2)) := Nat.mul_le_mul_right _ hL
      _ = 250 * (R * (2 * w + 4)) := by ring
      _ ≤ 250 * (R * (2 * H + 21)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
  have a2 : L0 * (250 * (w + dw + 2)) ≤ 250 * (R * (2 * H + 21)) := by
    calc L0 * (250 * (w + dw + 2)) ≤ (2 * R) * (250 * (w + dw + 2)) := Nat.mul_le_mul_right _ hL
      _ = 250 * (R * (2 * (w + dw) + 4)) := by ring
      _ ≤ 250 * (R * (2 * H + 21)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
  have a3 : Q * (2 * (w + dw) + 2 + 1100) ≤ 106 * (R * (2 * H + 21)) := by
    calc Q * (2 * (w + dw) + 2 + 1100) ≤ (2 * R) * (2 * (w + dw) + 2 + 1100) :=
          Nat.mul_le_mul_right _ hQ
      _ = 2 * (R * (2 * (w + dw) + 1102)) := by ring
      _ ≤ 2 * (R * (53 * (2 * H + 21))) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
      _ = 106 * (R * (2 * H + 21)) := by ring
  have a4 : Q * (8000 + 1100) ≤ 9100 * (R * (2 * H + 21)) := by
    calc Q * (8000 + 1100) ≤ (2 * R) * 9100 := Nat.mul_le_mul_right _ hQ
      _ = 9100 * (R * 2) := by ring
      _ ≤ 9100 * (R * (2 * H + 21)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
  have a5 : 1100 * L0 ≤ 1100 * (R * (2 * H + 21)) := by
    calc 1100 * L0 ≤ 1100 * (2 * R) := Nat.mul_le_mul_left _ hL
      _ = 1100 * (R * 2) := by ring
      _ ≤ 1100 * (R * (2 * H + 21)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
  have hZY : Z + 2 ≤ Nn * Y := le_trans hY1 hNY
  have hzL : zsz (L0 : ℤ) ≤ Nn * Y := by omega
  have h8 : 8 ≤ Nn * Y := le_trans hY8 hNY
  have hRY' := hRY
  generalize Nn * Y = P at *
  generalize R * (2 * H + 21) = M at *
  norm_num
  omega

end IntMul.Kappa.R6.IL3H

end

