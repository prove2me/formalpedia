    CardinalityAJ p (JZero N) (genusFF (AlgebraicClosure ℚ) (modularFunctionFieldBar N)) := by
  haveI := ModularCurve.hasCanonicalDivisor_modularFunctionFieldBar N
  haveI := ModularCurve.isCurveOver_modularFunctionFieldBar N
