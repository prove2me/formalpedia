    have hb := code_runs_r6c r s1 hcb ((ok_upd s 56 _ r hcb.not56).2 hor)
    rw [eval_upd s 56 _ r hcb.not56, cost_upd s 56 _ r hcb.not56, hm] at hb
    have hr : IRuns I iprog (.seq (.op (.mv zX.V zX.A)) (.seq (.op (.split zX.V zX.A zX.B))
        (.seq (.op (.drop zX.B)) (.op (.drop zX.A))))) (s1.upd 56 (.int (2 ^ m) :: s1.G 56))
        (s.upd 56 (.int (sg (a.eval s) ((a.eval s).natAbs / 2 ^ m)) :: s.G 56))
        (2 * moveCost (zsz ((2 : ℤ) ^ m)) + 19 + (splitCost m + 17) +
