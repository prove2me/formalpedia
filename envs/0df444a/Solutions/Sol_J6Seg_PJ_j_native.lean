open IntMul NLogN NLogN.KIL RS Function IntMul.Kappa.R6 J6Seg.Side

/-- `Lg L i` lies in every tail `L.drop r` with `r ≤ i`. -/
theorem getD_mem_drop' {L : List ℕ} {r i : ℕ} (hr : r ≤ i) (hi : i < L.length) :
    L.getD i 0 ∈ L.drop r := by
  rw [List.getD_eq_getElem _ _ hi]
  have hl : i - r < (L.drop r).length := by simp; omega
  refine List.mem_iff_getElem.2 ⟨i - r, hl, ?_⟩
  rw [List.getElem_drop]
  congr 1
  omega

/-- **The entries of the elimination on line indices.** -/
theorem hMb_of {Q : ℕ} {S : ℕ → ℕ → Prop} [DecidableRel S] {L : List ℕ} {A : ℕ → ℕ → ℤ}
    (hA : ∀ r ≤ L.length, ∀ i ∈ L.drop r, ∀ k ∈ L.drop r, |Aseq Q S L A r i k| ≤ 2 ^ (Q + 1))
    {q i k : ℕ} (hq : q ≤ L.length) (hi : i < L.length) (hk : k < L.length) :
    |Mseq Q S L A q i k| ≤ 2 ^ (Q + 1) := by
  by_cases h : q ≤ min i k
  · rw [Mseq_eq Q S L A q hq i k (le_trans h (min_le_left _ _)) (le_trans h (min_le_right _ _))]
    exact hA q hq _ (getD_mem_drop' (le_trans h (min_le_left _ _)) hi) _
      (getD_mem_drop' (le_trans h (min_le_right _ _)) hk)
  · rw [Mseq_frz Q S L A i k q (by omega),
      Mseq_eq Q S L A (min i k) (by omega) i k (min_le_left _ _) (min_le_right _ _)]
    exact hA _ (by omega) _ (getD_mem_drop' (min_le_left _ _) hi) _
      (getD_mem_drop' (min_le_right _ _) hk)

end J6Seg.PJ
