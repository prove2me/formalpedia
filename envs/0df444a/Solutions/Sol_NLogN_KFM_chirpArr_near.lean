theorem chirpArr_near_aux (Δ T : ℕ) : ∀ (d : ℕ) (s t : Fin d → ℕ), (∀ i, s i ≤ t i) →
    (∀ i, 0 < t i) → (∀ i, t i ≤ T) → d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 →
    ∀ x ∈ NLogN.KFM.chirpArr Δ d s t, NLogN.KFM.NearU Δ (d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ) x 
  | 0, s, t, _, _, _, _ => by
    intro x hx
    simp only [NLogN.KFM.chirpArr, List.mem_singleton] at hx
    subst hx
    exact ⟨1, by simp, by simp [NLogN.KFM.vP_oneP]⟩
  | d + 1, s, t, hst, ht, hT, hu => by
    have hu0 : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ Δ := by positivity
    have hT0 : (0 : ℝ) ≤ (T : ℝ) ^ 2 := by positivity
    have hu' : d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 := by
      refine le_trans ?_ hu; push_cast
      have : (0 : ℝ) ≤ (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ := by positivity
      nlinarith
    have ih := chirpArr_near_aux Δ T d (fun i => s i.castSucc) (fun i => t i.castSucc)
      (fun i => hst _) (fun i => ht _) (fun i => hT _) hu'
    have htl : (t (Fin.last d) : ℝ) ≤ T := by exact_mod_cast hT _
    have htl0 : (0 : ℝ) ≤ t (Fin.last d) := Nat.cast_nonneg _
    have hsq : (t (Fin.last d) : ℝ) ^ 2 ≤ (T : ℝ) ^ 2 := by gcongr
    have hax : (4 * (t (Fin.last d) : ℝ) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 := by
      have h4 : 4 * (t (Fin.last d) : ℝ) ^ 2 + 1 ≤ ((d + 1 : ℕ) : ℝ) * (8 * (T : ℝ) ^ 2 + 2) := by
        push_cast; nlinarith
      exact (mul_le_mul_of_nonneg_right h4 hu0).trans hu
    have hB := NLogN.KFM.axTab_near Δ _ _ (hst _) (ht _) hax
    have hB' : ∀ b ∈ NLogN.KFM.axTab Δ (s (Fin.last d)) (t (Fin.last d)),
        NLogN.KFM.NearU Δ (4 * (T : ℝ) ^ 2 * (2 : ℝ)⁻¹ ^ Δ) b := fun b hb =>
      (hB b hb).mono (by gcongr)
    intro x hx
    rw [NLogN.KFM.chirpArr] at hx
    refine (NLogN.KFM.oprod_near Δ _ _ ih hB' hu' x hx).mono (le_of_eq ?_)
    push_cast; ring

theorem solution (Δ T : ℕ) : ∀ (d : ℕ) (s t : Fin d → ℕ), (∀ i, s i ≤ t i) →
    (∀ i, 0 < t i) → (∀ i, t i ≤ T) → d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 →
    ∀ x ∈ NLogN.KFM.chirpArr Δ d s t, NLogN.KFM.NearU Δ (d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ) x := by
  first
  | exact chirpArr_near_aux
  | exact chirpArr_near_aux Δ T
  | (intros; apply chirpArr_near_aux <;> assumption)
