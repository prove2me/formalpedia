open NLogN
open NLogN.KFV
open IntMul RS KIL KFD KFB KFT Synth
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution {S P : Fin NLogN.HS} (hS0 : S ≠ 0) (hSL : S ≠ NLogN.KFV.vL) (hP0 : P ≠ 0) (hPS : P ≠ S)
    (hS5 : S.val < 56) (hP5 : P.val < 56) {b r w Bp : ℕ} (hb : 1 ≤ b) (KG : ℤ)
    (s : NLogN.IState NLogN.HS) (f : Fin NLogN.HS → List ℤ) (zA : List NLogN.KFB.GI) (lS : List ℤ)
    (hlen : zA.length = r) (hS : f S = (NLogN.KFB.gflat zA).reverse ++ lS) (hL : f NLogN.KFV.vL = [])
    (hre : ∀ z ∈ zA, 0 ≤ z.1) (hw : NLogN.KFB.GB w zA)
    (hB1 : NLogN.zsz (NLogN.KFT.carOut b zA : ℤ) ≤ Bp) (hB2 : NLogN.zsz KG ≤ Bp) (hB3 : NLogN.zsz ((NLogN.KFT.carOut b zA : ℤ) - KG) ≤ Bp)
    (hn : NLogN.zsz ((2 * r : ℕ) : ℤ) ≤ Bp) (hfok : NLogN.KFD.fok (NLogN.mvK S 0 NLogN.KFV.vL (.lit ((2 * r : ℕ) : ℤ))) = true) :
    NLogN.IRuns I iprog (NLogN.KFV.packI S P b r KG) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update (Function.update f S lS) P (((NLogN.KFT.carOut b zA : ℤ) - KG) :: f P)))
      (NLogN.KFV.cPack r w b Bp) := by
  have hLl : ((NLogN.KFB.gflat zA).reverse).length = 2 * r := by simp [hlen]
  have m := NLogN.KFD.FSp.mvL hS0 hSL (by decide) hS5 (by decide) (by decide) s f (NLogN.KFB.gflat zA).reverse lS hS w Bp
    (NLogN.bnd_reverse hw.bnd) (by rw [hLl]; exact hn)
  rw [hLl, List.reverse_reverse] at m
  have m' := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) hfok m
  set f1 := Function.update (Function.update f S lS) 0 (NLogN.KFB.gflat zA ++ f 0) with hf1
  have c1 := NLogN.KFV.carE (I := I) (iprog := iprog) (B := w) hb zA hre hw s f1 (f 0) (by simp [hf1])
  rw [hlen] at c1
  set f2 := Function.update f1 0 ((NLogN.KFT.carOut b zA : ℤ) :: f 0) with hf2
  have h20 : f2 0 = (NLogN.KFT.carOut b zA : ℤ) :: f 0 := by simp [hf2]
  have p1 := NLogN.KIL.Sp.push s f2 (i := P) (e := .add (.reg 0) (.lit (-KG))) (B := Bp) hP5
    (NLogN.KIL.clean_add (NLogN.KIL.clean_reg (by decide)) (NLogN.KIL.clean_lit _)) ⟨NLogN.KIL.ok_reg h20, trivial⟩ ⟨trivial, trivial⟩
    ⟨NLogN.KIL.bnd_reg h20 hB1, by show NLogN.zsz (-KG) ≤ Bp; rw [NLogN.zsz_neg]; exact hB2, by
      simp only [NLogN.Ex.eval]; rw [NLogN.KIL.top_encK h20, ← sub_eq_add_neg]; exact hB3⟩
  rw [show NLogN.Ex.eval (NLogN.KIL.encK s f2) (.add (.reg 0) (.lit (-KG))) = (NLogN.KFT.carOut b zA : ℤ) - KG by
    simp only [NLogN.Ex.eval]; rw [NLogN.KIL.top_encK h20, ← sub_eq_add_neg]] at p1
  set f3 := Function.update f2 P (((NLogN.KFT.carOut b zA : ℤ) - KG) :: f2 P) with hf3
  have h30 : f3 0 = (NLogN.KFT.carOut b zA : ℤ) :: f 0 := by simp [hf3, hP0.symm, h20]
  have p2 := NLogN.KIL.Sp.pop s f3 (i := 0) (B := Bp) (by decide) h30 hB1
  have pp := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) rfl (NLogN.KFD.FSp.of_norep rfl (p1.seq p2))
  refine (m'.seq (c1.seq pp)).mono' ?_ ?_
  · congr 1; funext j
    simp only [hf3, hf2, hf1, Function.update_apply]
    by_cases e1 : j = 0
    · subst e1; simp [hP0.symm, hS0.symm]
    by_cases e2 : j = P
    · subst e2; simp [hP0, hPS, e1]
    · simp [e1, e2]
  · unfold NLogN.KFV.cPack; simp only [NLogN.Ex.size]; omega
