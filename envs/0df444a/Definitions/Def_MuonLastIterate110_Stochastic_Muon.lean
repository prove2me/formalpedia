-- title:
--   Assumption 3.1, the finite-step Muon trajectory (3.1)–(3.3), the noise model (5.3) and the schedule (5.4)
-- statement:
--   **Assumption 3.1.** $F:\mathbb R^{m\times n}\to\mathbb R$ is continuously differentiable (the standing hypothesis of §3.1), and there are $L>0$ and $F_{\inf}\in\mathbb R$ with $F(X)\ge F_{\inf}$ and $\|\nabla F(X)-\nabla F(Y)\|\le L\|X-Y\|$ for all $X,Y$.
--
--   **Muon trajectory.** Given $J$, $\varepsilon$, deterministic sequences $\eta_t,\beta_t,\theta_t$ ($t\ge1$), deterministic $W_1$, $M_0$, and perturbations $\zeta_t$, let $g_t=\nabla F(W_t)$, $G_t=g_t+\zeta_t$ and
--
--   $$
--   M_t=\beta_tM_{t-1}+(1-\beta_t)G_t,\qquad N_t=\theta_tM_t+(1-\theta_t)G_t,\qquad D_t=\Phi_\varepsilon(N_t),\qquad W_{t+1}=W_t-\eta_tD_t .
--   $$
--
--   Also $r_t=N_t-g_t$ and $e_t=M_t-g_t$. The run is *admissible* if $J\ge1$, $\varepsilon\ge0$, and $\eta_t>0$, $\beta_t\in[0,1)$, $\theta_t\in[0,1]$ for all $t\ge1$.
--
--   **Schedule (5.4).** $\eta_t=\eta_0t^{-p}$ and $\beta_t=1-\alpha_0t^{-q}$ for $t\ge1$. **Mixing choice:** $\theta_t=1$ for every $t\ge1$, or $\theta_t=\beta_t$ for every $t\ge1$.
--
--   **Memory products.** $R_{s:t}=\prod_{j=s}^t\beta_j$, with $R_{t+1:t}=1$.
--
--   **Noise model (5.3).** On a probability space with filtration $(\mathcal F_t)_{t\ge0}$ and random perturbations $\zeta_t$: for every $t\ge1$, $W_t$ and $M_{t-1}$ are $\mathcal F_{t-1}$-measurable, and
--
--   $$
--   \mathbb E[\zeta_t\mid\mathcal F_{t-1}]=0,\qquad \mathbb E[\|\zeta_t\|^2\mid\mathcal F_{t-1}]\le\sigma^2\quad\text{a.s.}
--   $$
--
--   These definitions fix the dynamics that the convergence theorems are about: the iterates are generated by the recursion from the given initial data, not assumed.
--
--   **Formalization Note** The trajectory is computed by recursion on the pair $(W_{k+1},M_k)$; `W t` is meaningful for $t\ge1$ and `M t` for $t\ge0$ (the value `W 0` is never used). A random run applies the deterministic recursion pathwise to $t\mapsto\zeta_t(\omega)$. Mathlib's conditional expectation of a non-integrable function is $0$, so the noise model also requires $\zeta_t$ and $\|\zeta_t\|^2$ to be integrable; the source's conditional expectations presuppose both. Indices are shifted ($t+1$ for $t$) so that no natural-number subtraction occurs.
-- source:
--   Ping Li and Vincent Y. F. Tan, Last-Iterate Stationarity of Muon with Finitely Many Newton-Schulz Iterations, STOC 2027 submission #110 preprint (2026), source.pdf SHA-256 5362e7185a9ddcba39d1a70da110a8b04f1d179ad818e6d5d0ec73bf29586372, p.5 Assumption 3.1, (3.1)–(3.3) and the standing C¹ hypothesis of §3.1; p.7 r_t; p.9 (5.3); p.10 (5.4); p.23 §C.3.1 R_{s:t}; p.24 e_t; https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/110.pdf

import Mathlib
import Definitions.Def_MuonLastIterate110_Stochastic_NewtonSchulz

open MeasureTheory

namespace MuonLastIterate110.Stochastic

/-- Assumption 3.1 (p.5) together with the standing hypothesis of §3.1 that the loss is
continuously differentiable: `L > 0`, `F(X) ≥ F_inf` for all `X`, and
`‖∇F(X) − ∇F(Y)‖ ≤ L‖X − Y‖` for all `X, Y`. -/
def Assumption31 {m n : ℕ} (F : Mat m n → ℝ) (L Finf : ℝ) : Prop :=
  ContDiff ℝ 1 F ∧ 0 < L ∧ (∀ X, Finf ≤ F X) ∧
    ∀ X Y, ‖gradient F X - gradient F Y‖ ≤ L * ‖X - Y‖

/-- The data of a finite-step Muon run (§3.1, p.5): the loss `F`, the number `J` of
Newton–Schulz steps, the stabilizer `ε`, the deterministic sequences `η_t, β_t, θ_t`
(only `t ≥ 1` is used), and the deterministic initial points `W₁` and `M₀`. -/
structure Muon (m n : ℕ) where
  F : Mat m n → ℝ
  J : ℕ
  ε : ℝ
  η : ℕ → ℝ
  β : ℕ → ℝ
  θ : ℕ → ℝ
  W₁ : Mat m n
  M₀ : Mat m n

namespace Muon

variable {m n : ℕ} (S : Muon m n) (ζ : ℕ → Mat m n)

/-- One step of (3.1)–(3.3) at time `t`, from `(W_t, M_{t−1})` to `(W_{t+1}, M_t)`, with
perturbed gradient `G_t = ∇F(W_t) + ζ_t`. -/
noncomputable def step (t : ℕ) (x : Mat m n × Mat m n) : Mat m n × Mat m n :=
  let G := gradient S.F x.1 + ζ t
  let M := S.β t • x.2 + (1 - S.β t) • G
  let N := S.θ t • M + (1 - S.θ t) • G
  (x.1 - S.η t • Phi S.J S.ε N, M)

/-- `state k = (W_{k+1}, M_k)`: the recursion (3.1)–(3.3) started from `(W₁, M₀)`, driven by the
perturbation sequence `ζ`. -/
noncomputable def state : ℕ → Mat m n × Mat m n
  | 0 => (S.W₁, S.M₀)
  | k + 1 => S.step ζ (k + 1) (state k)

/-- The iterate `W_t` (`t ≥ 1`; the value at `t = 0` is never used). -/
noncomputable def W (t : ℕ) : Mat m n := (S.state ζ (t - 1)).1

/-- The momentum `M_t` (`t ≥ 0`, with `M 0 = M₀`). -/
noncomputable def M (t : ℕ) : Mat m n := (S.state ζ t).2

/-- The true gradient `g_t = ∇F(W_t)`. -/
noncomputable def g (t : ℕ) : Mat m n := gradient S.F (S.W ζ t)

/-- The perturbed gradient `G_t = g_t + ζ_t`. -/
noncomputable def G (t : ℕ) : Mat m n := S.g ζ t + ζ t

/-- The Newton–Schulz input `N_t = θ_t M_t + (1 − θ_t) G_t` of (3.2). -/
noncomputable def N (t : ℕ) : Mat m n := S.θ t • S.M ζ t + (1 - S.θ t) • S.G ζ t

/-- The update direction `D_t = Φ_ε(N_t)` of (3.3). -/
noncomputable def D (t : ℕ) : Mat m n := Phi S.J S.ε (S.N ζ t)

/-- The input discrepancy `r_t = N_t − g_t` (p.7). -/
noncomputable def r (t : ℕ) : Mat m n := S.N ζ t - S.g ζ t

/-- The momentum tracking error `e_t = M_t − g_t` (Lemma C.5, p.24). -/
noncomputable def e (t : ℕ) : Mat m n := S.M ζ t - S.g ζ t

/-- The standing conditions of §3.1 on the run: `J ≥ 1`, `ε ≥ 0`, and for every `t ≥ 1`,
`η_t > 0`, `β_t ∈ [0, 1)`, `θ_t ∈ [0, 1]`. -/
def Admissible : Prop :=
  1 ≤ S.J ∧ 0 ≤ S.ε ∧
    ∀ t : ℕ, 1 ≤ t → 0 < S.η t ∧ 0 ≤ S.β t ∧ S.β t < 1 ∧ 0 ≤ S.θ t ∧ S.θ t ≤ 1

/-- The polynomial schedule (5.4) (p.10): `η_t = η₀ t^{−p}` and `β_t = 1 − α₀ t^{−q}` for every
`t ≥ 1`. The sign conditions on `η₀, α₀` and the exponent ranges are separate hypotheses. -/
def PolySchedule (η₀ p α₀ q : ℝ) : Prop :=
  ∀ t : ℕ, 1 ≤ t → S.η t = η₀ * (t : ℝ) ^ (-p) ∧ S.β t = 1 - α₀ * (t : ℝ) ^ (-q)

/-- The mixing choice of Theorem 5.2 and Lemma C.5: either `θ_t = 1` for every `t ≥ 1`, or
`θ_t = β_t` for every `t ≥ 1`. -/
def ThetaChoice : Prop :=
  (∀ t : ℕ, 1 ≤ t → S.θ t = 1) ∨ (∀ t : ℕ, 1 ≤ t → S.θ t = S.β t)

end Muon

/-- `R_{s:t} = ∏_{j=s}^{t} β_j`, with the empty product `R_{t+1:t} = 1` (§C.3.1, p.23). -/
def memProd (β : ℕ → ℝ) (s t : ℕ) : ℝ := ∏ j ∈ Finset.Icc s t, β j

/-- The noise model (5.3) (p.9) for a run `S` driven by random perturbations `ζ_t(ω)`, on a
probability space with filtration `(ℱ_t)_{t ≥ 0}` (`ℱ 0` is the first σ-algebra): for every
`t ≥ 1`,
1. `W_t` and `M_{t−1}` are `ℱ_{t−1}`-measurable;
2. `ζ_t` is integrable and `E[ζ_t | ℱ_{t−1}] = 0` a.s.;
3. `‖ζ_t‖²` is integrable and `E[‖ζ_t‖² | ℱ_{t−1}] ≤ σ²` a.s.
Indices are written with `t + 1` in place of `t`, so no natural subtraction occurs. -/
def NoiseModel {m n : ℕ} (S : Muon m n) {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (μ : Measure Ω) (ℱ : Filtration ℕ mΩ) (ζ : ℕ → Ω → Mat m n) (σ : ℝ) : Prop :=
  ∀ t : ℕ,
    Measurable[ℱ t] (fun ω => S.W (fun s => ζ s ω) (t + 1)) ∧
    Measurable[ℱ t] (fun ω => S.M (fun s => ζ s ω) t) ∧
    Integrable (ζ (t + 1)) μ ∧
    μ[ζ (t + 1) | ℱ t] =ᵐ[μ] 0 ∧
    Integrable (fun ω => ‖ζ (t + 1) ω‖ ^ 2) μ ∧
    μ[(fun ω => ‖ζ (t + 1) ω‖ ^ 2) | ℱ t] ≤ᵐ[μ] fun _ => σ ^ 2

end MuonLastIterate110.Stochastic


