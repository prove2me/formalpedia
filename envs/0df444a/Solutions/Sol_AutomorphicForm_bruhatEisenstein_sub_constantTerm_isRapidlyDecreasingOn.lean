section Torus

private def torusGL {A : Type*} [CommRing A] (t₁ t₂ : Aˣ) : GL (Fin 2) A where
  val := !![(t₁ : A), 0; 0, (t₂ : A)]
  inv := !![((t₁⁻¹ : Aˣ) : A), 0; 0, ((t₂⁻¹ : Aˣ) : A)]
  val_inv := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
  inv_val := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]

private theorem continuous_torusGL_fst : Continuous fun r : ℝˣ => torusGL r (1 : ℝˣ) := by
  refine Units.continuous_iff.2 ⟨continuous_matrix fun i j => ?_, continuous_matrix fun i j => ?_⟩
  · fin_cases i <;> fin_cases j
    · show Continuous fun r : ℝˣ => ((r : ℝˣ) : ℝ)
      exact Units.continuous_val
    · show Continuous fun _ : ℝˣ => (0 : ℝ)
      exact continuous_const
    · show Continuous fun _ : ℝˣ => (0 : ℝ)
      exact continuous_const
    · show Continuous fun _ : ℝˣ => ((1 : ℝˣ) : ℝ)
      exact continuous_const
  · fin_cases i <;> fin_cases j
    · show Continuous fun r : ℝˣ => ((r⁻¹ : ℝˣ) : ℝ)
      exact Units.continuous_coe_inv
    · show Continuous fun _ : ℝˣ => (0 : ℝ)
      exact continuous_const
    · show Continuous fun _ : ℝˣ => (0 : ℝ)
      exact continuous_const
    · show Continuous fun _ : ℝˣ => (((1 : ℝˣ)⁻¹ : ℝˣ) : ℝ)
      exact continuous_const

private theorem continuous_torusGL_snd : Continuous fun r : ℝˣ => torusGL (1 : ℝˣ) r := by
  refine Units.continuous_iff.2 ⟨continuous_matrix fun i j => ?_, continuous_matrix fun i j => ?_⟩
  · fin_cases i <;> fin_cases j
    · show Continuous fun _ : ℝˣ => ((1 : ℝˣ) : ℝ)
      exact continuous_const
    · show Continuous fun _ : ℝˣ => (0 : ℝ)
      exact continuous_const
    · show Continuous fun _ : ℝˣ => (0 : ℝ)
      exact continuous_const
    · show Continuous fun r : ℝˣ => ((r : ℝˣ) : ℝ)
      exact Units.continuous_val
  · fin_cases i <;> fin_cases j
    · show Continuous fun _ : ℝˣ => (((1 : ℝˣ)⁻¹ : ℝˣ) : ℝ)
      exact continuous_const
    · show Continuous fun _ : ℝˣ => (0 : ℝ)
      exact continuous_const
    · show Continuous fun _ : ℝˣ => (0 : ℝ)
      exact continuous_const
    · show Continuous fun r : ℝˣ => ((r⁻¹ : ℝˣ) : ℝ)
      exact Units.continuous_coe_inv

end Torus
