-- title:
--   Fractional Brownian motion, Hölder norms, Young integration, and coefficient classes
-- statement:
--   This file sets up the objects used in the paper's semideterministic averaging theorem. The driver is a two-sided, centered, vector-valued fractional Brownian motion with independent Gaussian coordinates and covariance
--
--   $$\mathbb E[B_s^i B_t^j] = \mathbf 1_{i=j}\frac{|s|^{2H}+|t|^{2H}-|t-s|^{2H}}{2}.$$
--
--   Paths use the homogeneous Hölder seminorm on a specified time interval. A Young integral is the common limit of left-point Riemann sums along every sequence of partitions whose mesh tends to zero. A Young solution starts at the specified point and satisfies its integral equation at every time. The file also defines bounded $C^2$ coefficients, time-Hölder $BC^2$ coefficients, the covariance profile (3.2), the negative Hölder bounds (3.12), and the process seminorm (3.16).
--
--   These definitions give the goal and its estimates a shared meaning. Norms that may be infinite take values in $[0,\infty]$; (3.12) is expressed through any admissible real upper bound $K$.
--
--   **Formalization Note** The full fBm covariance, including the zero cross-coordinate covariances, is part of the definition. The almost surely Hölder version is a separate predicate. The increment sigma algebra is generated by past increments $B_u-B_v$. Time-dependent coefficient conditions and negative Hölder bounds are read on the stated interval $[0,T]$.
-- source:
--   Hairer and Li, Averaging dynamics driven by fractional Brownian motion, Ann. Probab. 48(4) (2020), https://doi.org/10.1214/19-AOP1408, p. 1826 (fBm); p. 1829 (notation); p. 1832, (3.2); p. 1835, (3.11)–(3.12); p. 1836, Definition 3.9 and (3.16); p. 1838 (C^{α,2})

import Mathlib

namespace HairerLiFBM.SemiDet

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal

abbrev E (n : ℕ) := EuclideanSpace ℝ (Fin n)

/-- The two-sided, coordinatewise independent, centred fractional Brownian motion of p. 1826. -/
def IsFBM {Ω : Type*} [MeasurableSpace Ω] (m : ℕ) (H : ℝ)
    (B : ℝ → Ω → E m) (P : Measure Ω) : Prop :=
  IsGaussianProcess (fun q : ℝ × Fin m => fun ω => B q.1 ω q.2) P ∧
    (∀ t i, P[fun ω => B t ω i] = 0) ∧
    ∀ s t i j, cov[fun ω => B s ω i, fun ω => B t ω j; P] =
      if i = j then (1 / 2 : ℝ) * (|s| ^ (2 * H) + |t| ^ (2 * H) - |t - s| ^ (2 * H)) else 0

/-- The homogeneous Hölder seminorm on a time set, retaining infinity. -/
noncomputable def holderSemi {F : Type*} [NormedAddCommGroup F]
    (α : ℝ) (S : Set ℝ) (x : ℝ → F) : ℝ≥0∞ :=
  ⨆ (s ∈ S) (t ∈ S) (_ : s ≠ t), ‖x t - x s‖ₑ / ENNReal.ofReal (|t - s| ^ α)

noncomputable def supNorm {F : Type*} [NormedAddCommGroup F]
    (S : Set ℝ) (x : ℝ → F) : ℝ≥0∞ :=
  ⨆ t ∈ S, ‖x t‖ₑ

/-- The continuous-path version specified on p. 1826. -/
def HasHolderPaths {Ω : Type*} [MeasurableSpace Ω] (m : ℕ) (H : ℝ)
    (B : ℝ → Ω → E m) (P : Measure Ω) : Prop :=
  ∀ᵐ ω ∂P, ∀ β : ℝ, 0 < β → β < H → ∀ T : ℝ, 0 < T →
    holderSemi β (Set.Icc (-T) T) (fun t => B t ω) < ⊤

/-- The sigma algebra generated by all past increments. -/
@[instance_reducible]
def incrSigma {Ω : Type*} [MeasurableSpace Ω] {m : ℕ}
    (B : ℝ → Ω → E m) (s : ℝ) : MeasurableSpace Ω :=
  ⨆ (u : ℝ) (_ : u ≤ s) (v : ℝ) (_ : v ≤ s),
    MeasurableSpace.comap (fun ω => B u ω - B v ω) inferInstance

/-- A monotone partition of `[s,t]`, including a zero-cell partition when `s=t`. -/
structure Partition (s t : ℝ) where
  n : ℕ
  pt : Fin (n + 1) → ℝ
  mono : Monotone pt
  first : pt 0 = s
  last : pt (Fin.last n) = t

noncomputable def Partition.mesh {s t : ℝ} (π : Partition s t) : ℝ :=
  ⨆ i : Fin π.n, π.pt i.succ - π.pt i.castSucc

/-- All left-point Riemann sums converge to `I` as the mesh tends to zero. -/
def IsYoungIntegral {V W : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    [NormedAddCommGroup W] [NormedSpace ℝ W]
    (f : ℝ → V →L[ℝ] W) (g : ℝ → V) (s t : ℝ) (I : W) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ ∀ π : Partition s t, π.mesh < δ →
    ‖(∑ i : Fin π.n,
      f (π.pt i.castSucc) (g (π.pt i.succ) - g (π.pt i.castSucc))) - I‖ < ε

/-- The pathwise Young solution of (3.23) on `[0,T]` from `x₀`. -/
def IsYoungSolution {m d : ℕ} (α T : ℝ)
    (g : ℝ → E d → (E m →L[ℝ] E d)) (b : ℝ → E m) (x0 : E d)
    (x : ℝ → E d) : Prop :=
  holderSemi α (Set.Icc 0 T) x < ⊤ ∧ x 0 = x0 ∧
    ∀ t ∈ Set.Icc 0 T, IsYoungIntegral (fun r => g r (x r)) b 0 t (x t - x0)

/-- Bounded C² maps, including their values and derivatives. -/
def IsBC2 {X Y : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
    [NormedAddCommGroup Y] [NormedSpace ℝ Y] (F : X → Y) : Prop :=
  ContDiff ℝ 2 F ∧ ∃ K : ℝ, ∀ k : ℕ, k ≤ 2 → ∀ x,
    ‖iteratedFDeriv ℝ k F x‖ ≤ K

/-- Time-Hölder maps into BC², as introduced on p. 1838. -/
def InCzeta2 {m d : ℕ} (ζ : ℝ)
    (f : ℝ → E d → (E m →L[ℝ] E d)) : Prop :=
  (∀ t, 0 ≤ t → IsBC2 (f t)) ∧
    ∃ K : ℝ, ∀ s t, 0 ≤ s → 0 ≤ t → ∀ k : ℕ, k ≤ 2 → ∀ x,
      ‖iteratedFDeriv ℝ k (f t) x - iteratedFDeriv ℝ k (f s) x‖
        ≤ K * |t - s| ^ ζ

/-- The two inequalities (3.12) on the fixed interval `[0,T]`, for an ordinary coefficient. -/
def NegHolderBound {m d : ℕ} (κ γ T K : ℝ)
    (f : ℝ → E d → (E m →L[ℝ] E d)) : Prop :=
  ∀ s ∈ Set.Icc 0 T, ∀ t ∈ Set.Icc 0 T, |t - s| ≤ 1 → ∀ x y : E d,
    ‖∫ r in s..t, f r x‖ ≤ K * |t - s| ^ (1 - κ) ∧
    ‖∫ r in s..t, (f r x - f r y)‖ ≤
      K * |t - s| ^ (1 - κ) * ‖x - y‖ ^ γ

/-- The scalar negative Hölder norm from p. 1829. -/
noncomputable def negHolder (κ a b : ℝ) (h : ℝ → ℝ) : ℝ≥0∞ :=
  ⨆ (s ∈ Set.Icc a b) (t ∈ Set.Icc a b) (_ : s ≠ t),
    ENNReal.ofReal (|t - s| ^ (κ - 1) * |∫ r in s..t, h r|)

/-- The covariance profile in (3.2), used by Lemma 3.3. -/
noncomputable def Rhat (H t : ℝ) : ℝ :=
  ∫ u in (0 : ℝ)..1, (1 - u) ^ (H - 1 / 2) * (1 + t - u) ^ (H - 1 / 2)

/-- The covariance R of the future fractional Brownian component, (3.2). -/
noncomputable def Rcov (H r s : ℝ) : ℝ :=
  (min r s) ^ (2 * H) * Rhat H (|r - s| / min r s)

/-- The classical mixed derivative of R away from the diagonal. -/
noncomputable def d2R (H r s : ℝ) : ℝ :=
  deriv (fun r' => deriv (fun s' => Rcov H r' s') s) r

/-- The process Hölder seminorm (3.16) on `[0,T]`. -/
noncomputable def procHolder {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}
    (α : ℝ) (p : ℝ≥0∞) (T : ℝ) (x : ℝ → Ω → E d) (P : Measure Ω) : ℝ≥0∞ :=
  ⨆ (s ∈ Set.Icc 0 T) (t ∈ Set.Icc 0 T) (_ : s ≠ t),
    eLpNorm (fun ω => x t ω - x s ω) p P /
      ENNReal.ofReal (|t - s| ^ α)

end HairerLiFBM.SemiDet


