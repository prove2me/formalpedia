      (readCfg (q := q) (x := x) (σ.stk q) σ hlt (W.reverse ++ σ.stk x) (σ.ip + W.length + 1)) m ∧
      m ≤ W.length + 2 := by
    rcases W with _ | ⟨w, W⟩
    · refine ⟨1 + 1, h0.trans ?_, by simp⟩
      simp only [List.length_nil, add_zero] at hstop
      rw [hstop]
      refine Reaches.step' (by simp [readCfg, hlt]) ?_ (Reaches.refl _)
      simp [mstep, St.tops, readCfg, St.top_set, hqx', readδ, runOps, Op.run, St.pop_set_ne, hqx]
    · have hw0 := hk 0 (by simp)
