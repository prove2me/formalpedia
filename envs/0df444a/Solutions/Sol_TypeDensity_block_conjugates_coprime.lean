    [Finite (IsLocalRing.ResidueField O)] (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ)
    [IsDomain (AdjoinRoot Φ)] (r : ℕ) (b : Fin r → AdjoinRoot Φ) (hb : b ∈ TypeDensity.blockCell O Φ r) :
    ∀ i j : Fin Φ.natDegree, i ≠ j →
      IsCoprime (((TypeDensity.monicPolyO b).map (TypeDensity.frobeniusIter O Φ i).toRingHom).map
          (algebraMap (AdjoinRoot Φ) (TypeDensity.BaseField (AdjoinRoot Φ))))
        (((TypeDensity.monicPolyO b).map (TypeDensity.frobeniusIter O Φ j).toRingHom).map
