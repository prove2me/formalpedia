theorem solution (j : ℝ) {R : ℝ} (hR : 3 < R) :
    Tendsto (fun ε : ℝ =>
        (ellFun (fE j ε) (mE j ε) (N0 3 1) (wE j ε) (pE j ε) (aE j ε) R + 2 * ε * j) / ε ^ 3)
      (𝓝[≠] (0:ℝ)) (𝓝 0) := by
  have h := ell_limit j hR
  have hD := dj_DellEq j R (mem_Ioi.mpr hR)
  have hz : R ^ 3 * deriv (d3f j) R + 6 * c3f j R - r3j j (1 / R) / R = 0 := by
    have h' : R ^ 3 * deriv (dj j) R + 6 * cj j R = r3j j (1 / R) / R := by
      unfold Dell at hD
      simpa using hD
    show R ^ 3 * deriv (dj j) R + 6 * cj j R - r3j j (1 / R) / R = 0
    linarith
  rw [hz] at h
  exact h
