/-- tail lemma: a nonneg random variable with exponential tails has mean `1/c`. -/
lemma expTail {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (Y : Ω → ℝ) (c : ℝ) (hc : 0 < c)
    (hYm : Measurable Y) (hnn : 0 ≤ᵐ[P] Y)
    (htail : ∀ t : ℝ, 0 < t → P {ω | t < Y ω} = ENNReal.ofReal (Real.exp (-(c * t)))) :
    Integrable Y P ∧ ∫ ω, Y ω ∂P = 1 / c := by
  have hint : IntegrableOn (fun t : ℝ => Real.exp (-(c * t))) (Ioi 0) := by
    simpa [neg_mul] using exp_neg_integrableOn_Ioi 0 hc
  have hval : ∫ t in Ioi (0:ℝ), Real.exp (-(c * t)) = 1 / c := by
    have := integral_exp_mul_Ioi (a := -c) (by linarith) 0
    simp only [neg_mul, mul_zero, Real.exp_zero] at this
    rw [this]; field_simp
  have key : ∫⁻ ω, ENNReal.ofReal (Y ω) ∂P = ENNReal.ofReal (1 / c) := by
    rw [lintegral_eq_lintegral_meas_lt P hnn hYm.aemeasurable]
    rw [setLIntegral_congr_fun measurableSet_Ioi (g := fun t => ENNReal.ofReal (Real.exp (-(c * t))))
      (fun t ht => htail t ht)]
    rw [← ofReal_integral_eq_lintegral_ofReal hint (Filter.Eventually.of_forall fun _ => (Real.exp_pos _).le),
      hval]
  have hfin : HasFiniteIntegral Y P := by
    rw [hasFiniteIntegral_iff_ofReal hnn, key]; exact ENNReal.ofReal_lt_top
  refine ⟨⟨hYm.aestronglyMeasurable, hfin⟩, ?_⟩
  rw [integral_eq_lintegral_of_nonneg_ae hnn hYm.aestronglyMeasurable, key,
    ENNReal.toReal_ofReal (by positivity)]

lemma expMeasure_Ioi (c : ℝ) (hc : 0 < c) (t : ℝ) (ht : 0 ≤ t) :
    expMeasure c (Ioi t) = ENNReal.ofReal (Real.exp (-(c * t))) := by
  have := isProbabilityMeasure_expMeasure hc
  rw [← compl_Iic, prob_compl_eq_one_sub measurableSet_Iic, ← ofReal_cdf, cdf_expMeasure_eq hc,
    if_pos ht, ← ENNReal.ofReal_one, ← ENNReal.ofReal_sub _ (by
      simp only [sub_nonneg, Real.exp_le_one_iff, Left.neg_nonpos_iff]; positivity)]
  congr 1; ring

lemma expMeasure_nonneg (c : ℝ) (hc : 0 < c) : ∀ᵐ x ∂(expMeasure c), 0 ≤ x := by
  have := isProbabilityMeasure_expMeasure hc
  rw [ae_iff]
  apply measure_mono_null (t := Iic 0)
  · intro x hx; simp only [mem_ofPred_eq, not_le] at hx; exact hx.le
  · rw [← ofReal_cdf, cdf_expMeasure_eq hc, if_pos le_rfl]; simp
/-- time index of a primitive variable -/
def ix {k : ℕ} : Idx k → ℕ
  | .spec t => t
  | .real t => t
  | .branch t _ => t

/-- σ-algebra generated by the variables indexed by `S`. -/
def mS {Ω : Type*} {k : ℕ} (X : Idx k → Ω → ℝ) (S : Set (Idx k)) : MeasurableSpace Ω :=
  ⨆ j ∈ S, MeasurableSpace.comap (X j) (inferInstance : MeasurableSpace ℝ)

def Bt (k t : ℕ) : Set (Idx k) := {j | ∃ i, j = Idx.branch t i}

def T0 (k t : ℕ) : Set (Idx k) := {j | j = Idx.spec t ∨ j = Idx.real t}

def Ge (k t : ℕ) : Set (Idx k) := {j | t ≤ ix j}

def hitSet {Ω : Type*} {k : ℕ} (X : Idx k → Ω → ℝ) (t : ℕ) : Set Ω := {ω | hitAt X t ω}

noncomputable def hI {Ω : Type*} {k : ℕ} (X : Idx k → Ω → ℝ) (t : ℕ) (ω : Ω) : ℝ :=
  (hitSet X t).indicator (fun _ => (1:ℝ)) ω

