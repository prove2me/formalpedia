section io
variable {s : IState HS} {F : Fin HS → List ℤ}

theorem zerP_spec {m G : ℕ} {l lg lm : List ℤ} {B : ℕ} (h0 : F 0 = l) (hCR : F CR = [])
    (hG : F HG = (G : ℤ) :: lg) (hM : F HM = (m : ℤ) :: lm) (hmG : m ≤ G)
    (hzB : zsz (G : ℤ) ≤ B) :
    Sp zerP (encK s F) (encK s (update F 0 (List.replicate (2 * (G - m)) 0 ++ l)))
      ((G - m) * 10 ^ 5 * (B + 2) + 10 ^ 5 * (B + 2)) := by
  set Fk : ℕ → Fin HS → List ℤ := fun k => update F 0 (List.replicate (2 * k) 0 ++ l) with hFk
  have e0 : Fk 0 = F := by simp [hFk, ← h0]
  have hzG : ∀ a : ℕ, a ≤ G → zsz (a : ℤ) ≤ B := fun a ha => le_trans (zsz_natCast_le ha) hzB
  have H := Sp.rep (s := s) (C := CR) (n := .add (.reg HG) (.neg (.reg HM)))
    (b := .seq (.push 0 (.lit 0)) (.push 0 (.lit 0)))
    (F := Fk) (N := G - m) (B := B) (c := 10 ^ 4 * (B + 2)) (by decide)
    (fun k => by simp +decide [hFk, update_apply, hCR])
    (by simp +decide [RS.writes]) (clean_of_regs (by decide))
    (by rw [e0]; exact ⟨isInt_encK hG, isInt_encK hM⟩) ⟨trivial, trivial⟩
    (by rw [e0]; simp only [Ex.Bnd, Ex.eval, top_encK hG, top_encK hM]
        refine ⟨hzG G le_rfl, hzG m hmG, ?_⟩
        rw [show (G : ℤ) + -m = ((G - m : ℕ) : ℤ) by push_cast [hmG]; ring]; exact hzG _ (by omega))
    (by rw [e0]; simp only [Ex.eval, top_encK hG, top_encK hM]; push_cast [hmG]; ring)
    (fun k hk => by
      have s1 := Sp.push (s := s) (f := update (Fk k) CR [((G - m : ℕ) : ℤ) - k]) (i := 0)
        (e := .lit 0) (B := B) (by decide) (by intro i hi; simp [Ex.regs] at hi) trivial trivial
        (by simp [Ex.Bnd, zsz_zero])
      refine ((s1.seq (Sp.push (s := s) (f := _) (i := 0) (e := .lit 0) (B := B) (by decide)
        (by intro i hi; simp [Ex.regs] at hi) trivial trivial (by simp [Ex.Bnd, zsz_zero]))).congr ?_).mono ?_
      · congr 1
        funext j
        simp only [hFk, update_apply, Ex.eval]
        by_cases j1 : j = 0
        · subst j1; simp +decide [show 2 * (k + 1) = 2 * k + 1 + 1 by ring, List.replicate_succ]
        simp [j1]
      · simp only [Ex.size]; omega)
  rw [e0] at H
  refine H.mono ?_
  simp only [Ex.size]; nlinarith

end io

