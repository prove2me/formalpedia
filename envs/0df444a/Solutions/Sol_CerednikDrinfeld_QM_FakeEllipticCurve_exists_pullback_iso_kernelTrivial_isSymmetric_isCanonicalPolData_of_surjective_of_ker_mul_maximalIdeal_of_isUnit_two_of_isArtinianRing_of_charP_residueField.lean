          ⟨Q.1 ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))), by rw [Category.assoc, pullback.condition, ← Category.assoc, Q.2]⟩).1)
  (E' : FakeEllipticCurve Λ N R) (g : E'.A ⟶ E.A) (hg : IsPullback g E'.f E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))))
  (hmul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t' E'.f),
      (E'.L.mul t' P Q).1 ≫ g =
        (E.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap S R)))
          ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1)
  (hact : ∀ x : ↥Λ, E'.act x ≫ g = g ≫ E.act x)

include hL' hmul in

theorem law_compat_hom {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R)) (x y : SchemeHomOver t' E'.f) :
    (E'.L.mul t' x y).1 ≫ hg.isoPullback.hom =
      (L'.mul t' ⟨x.1 ≫ hg.isoPullback.hom, by rw [Category.assoc, IsPullback.isoPullback_hom_snd]; exact x.2⟩
        ⟨y.1 ≫ hg.isoPullback.hom, by rw [Category.assoc, IsPullback.isoPullback_hom_snd]; exact y.2⟩).1 := by
  apply pullback.hom_ext
  · rw [Category.assoc, IsPullback.isoPullback_hom_fst, hmul, hL']
    exact mul_val_congr E.L rfl _ _ _ _ (by simp) (by simp)
  · change ((E'.L.mul t' x y).1 ≫ hg.isoPullback.hom) ≫ pullback.snd _ _ = (L'.mul t' _ _).1 ≫ pullback.snd _ _
    rw [(L'.mul t' _ _).2]
    simp only [Category.assoc, IsPullback.isoPullback_hom_snd]
    exact (E'.L.mul t' x y).2

include hL' hmul in
theorem law_compat_inv {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R))
    (x y : SchemeHomOver t' (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))))) :
    (L'.mul t' x y).1 ≫ hg.isoPullback.inv =
      (E'.L.mul t' ⟨x.1 ≫ hg.isoPullback.inv, by rw [Category.assoc, IsPullback.isoPullback_inv_snd]; exact x.2⟩
        ⟨y.1 ≫ hg.isoPullback.inv, by rw [Category.assoc, IsPullback.isoPullback_inv_snd]; exact y.2⟩).1 := by
  rw [← cancel_mono hg.isoPullback.hom, Category.assoc, Iso.inv_hom_id, Category.comp_id,
    law_compat_hom E R L' hL' E' g hg hmul]
  exact mul_val_congr L' rfl _ _ _ _ (by simp) (by simp)

include hact in

theorem act_compat_hom (x : ↥Λ) :
    E'.act x ≫ hg.isoPullback.hom =
      hg.isoPullback.hom ≫ pullback.lift (pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))) ≫ E.act x)
        (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))))
        (by rw [Category.assoc, E.act_over]; exact pullback.condition) := by
  apply pullback.hom_ext
  · rw [Category.assoc, IsPullback.isoPullback_hom_fst, hact, Category.assoc, pullback.lift_fst, ← Category.assoc,
      IsPullback.isoPullback_hom_fst]
  · rw [Category.assoc, IsPullback.isoPullback_hom_snd, E'.act_over, Category.assoc, pullback.lift_snd,
      IsPullback.isoPullback_hom_snd]

include hact in
theorem act_compat_inv (x : ↥Λ) :
    pullback.lift (pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))) ≫ E.act x)
        (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))))
        (by rw [Category.assoc, E.act_over]; exact pullback.condition) ≫ hg.isoPullback.inv =
      hg.isoPullback.inv ≫ E'.act x := by
  rw [← cancel_epi hg.isoPullback.hom, ← Category.assoc, ← act_compat_hom E R E' g hg hact x, Category.assoc,
    Iso.hom_inv_id, Category.comp_id, Iso.hom_inv_id_assoc]

include hL' in

theorem law_eq_baseChange : L' = E.L.baseChange (Spec.map (CommRingCat.ofHom (algebraMap S R))) :=
  GoodReductionJacobian.RelativeGroupLaw.eq_of_forall_mul_comp_fst_eq (Spec.map (CommRingCat.ofHom (algebraMap S R))) E.L L'
    (E.L.baseChange (Spec.map (CommRingCat.ofHom (algebraMap S R)))) hL' (fun _ _ _ _ => pullback.lift_fst _ _ _)

include hL' in
theorem law_isCommutative : L'.IsCommutative := by
  rw [law_eq_baseChange E R L' hL']; exact RelativeGroupLaw.IsCommutative.baseChange _ E.comm

include hL' in

theorem act_hom' (x : ↥Λ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R))
    (P Q : SchemeHomOver t (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))))) :
    pushPt (pullback.lift (pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))) ≫ E.act x)
        (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))))
        (by rw [Category.assoc, E.act_over]; exact pullback.condition)) (pullback.lift_snd _ _ _) (L'.mul t P Q) =
      L'.mul t
        (pushPt (pullback.lift (pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))) ≫ E.act x)
          (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))))
          (by rw [Category.assoc, E.act_over]; exact pullback.condition)) (pullback.lift_snd _ _ _) P)
        (pushPt (pullback.lift (pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))) ≫ E.act x)
          (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))))
          (by rw [Category.assoc, E.act_over]; exact pullback.condition)) (pullback.lift_snd _ _ _) Q) := by
  apply Subtype.ext
  apply pullback.hom_ext
  · simp only [pushPt, mapPt, Category.assoc, pullback.lift_fst]
    rw [← Category.assoc, hL', hL']
    have h := congrArg Subtype.val (E.act_hom x (t ≫ Spec.map (CommRingCat.ofHom (algebraMap S R)))
      ⟨P.1 ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))), by rw [Category.assoc, pullback.condition, ← Category.assoc, P.2]⟩
      ⟨Q.1 ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R))), by rw [Category.assoc, pullback.condition, ← Category.assoc, Q.2]⟩)
    simp only [pushPt, mapPt] at h
    rw [h]
    exact mul_val_congr E.L rfl _ _ _ _ (by simp only [Category.assoc, pullback.lift_fst]) (by simp only [Category.assoc, pullback.lift_fst])
  · simp only [pushPt, mapPt, Category.assoc, pullback.lift_snd]
    rw [(L'.mul t P Q).2, (L'.mul t _ _).2]

end Level

end PLFasm
open PLFasm

set_option maxHeartbeats 3200000 in
set_option synthInstance.maxHeartbeats 1600000 in
theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (N : ℕ) (S : Type) [CommRing S] (E : FakeEllipticCurve Λ N S)
    (R₁ R₀ : Type) [CommRing R₁] [IsLocalRing R₁] [IsNoetherianRing R₁] [IsArtinianRing R₁] [IsAlgClosed (IsLocalRing.ResidueField R₁)]
    [CommRing R₀] [Nontrivial R₀] [Algebra S R₁] [Algebra S R₀]
    (φ : R₁ →ₐ[S] R₀) (hφ : Function.Surjective φ)
    (hsmall : ∀ x ∈ RingHom.ker φ.toRingHom, ∀ m ∈ IsLocalRing.maximalIdeal R₁, x * m = 0)
    (h2 : IsUnit (2 : R₁))
    (p : ℕ) [Fact p.Prime] [CharP (IsLocalRing.ResidueField R₁) p]
    (t : pullback E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀))) ⟶ pullback E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁))))
    (ht₁ : t ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁))) = pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀))))
    (ht₂ : t ≫ pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁))) = pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀))) ≫ Spec.map (CommRingCat.ofHom φ.toRingHom))
    (L₁ : RelativeGroupLaw R₁ (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁)))))
    (hL₁ : (∀ (T : Scheme) (t' : T ⟶ Spec (CommRingCat.of R₁))
            (P Q : SchemeHomOver t' (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁))))),
            (L₁.mul t' P Q).1 ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁))) =
              (E.L.mul (t' ≫ (Spec.map (CommRingCat.ofHom (algebraMap S R₁))))
                ⟨P.1 ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁))), by rw [Category.assoc, pullback.condition, ← Category.assoc, P.2]⟩
                ⟨Q.1 ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁))), by rw [Category.assoc, pullback.condition, ← Category.assoc, Q.2]⟩).1))
    (L₀ : RelativeGroupLaw R₀ (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))))
    (hL₀ : (∀ (T : Scheme) (t' : T ⟶ Spec (CommRingCat.of R₀))
            (P Q : SchemeHomOver t' (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀))))),
            (L₀.mul t' P Q).1 ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀))) =
              (E.L.mul (t' ≫ (Spec.map (CommRingCat.ofHom (algebraMap S R₀))))
                ⟨P.1 ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀))), by rw [Category.assoc, pullback.condition, ← Category.assoc, P.2]⟩
                ⟨Q.1 ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀))), by rw [Category.assoc, pullback.condition, ← Category.assoc, Q.2]⟩).1))
    (𝓛₀ : (pullback E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))).Modules)
    (h𝓛₀ : Scheme.Modules.IsInvertible 𝓛₀ ∧
      KernelTrivial (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))) L₀ 𝓛₀ ∧
      IsSymmetric (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))) L₀ 𝓛₀ ∧
      CerednikDrinfeld.QM.IsCanonicalPolData (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))) L₀
            (fun x : ↥Λ => pullback.lift (pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀))) ≫ E.act x) (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀))))
              (by rw [Category.assoc, E.act_over]; exact pullback.condition))
            (fun x => pullback.lift_snd _ _ _)
            star (𝓛₀ ⊗ (Scheme.Modules.pullback (negMor (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))) L₀)).obj 𝓛₀)) :
    ∃ 𝓛₁ : (pullback E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁)))).Modules,
      Nonempty ((Scheme.Modules.pullback t).obj 𝓛₁ ≅ 𝓛₀) ∧
      Scheme.Modules.IsInvertible 𝓛₁ ∧
      KernelTrivial (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁)))) L₁ 𝓛₁ ∧
      IsSymmetric (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁)))) L₁ 𝓛₁ ∧
      CerednikDrinfeld.QM.IsCanonicalPolData (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁)))) L₁
            (fun x : ↥Λ => pullback.lift (pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁))) ≫ E.act x) (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁))))
              (by rw [Category.assoc, E.act_over]; exact pullback.condition))
            (fun x => pullback.lift_snd _ _ _)
            star (𝓛₁ ⊗ (Scheme.Modules.pullback (negMor (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁)))) L₁)).obj 𝓛₁) := by
  classical

  letI instAlg : Algebra R₁ R₀ := φ.toRingHom.toAlgebra
  have halg : algebraMap R₁ R₀ = φ.toRingHom := rfl
  have hπ : Function.Surjective (algebraMap R₁ R₀) := hφ
  have hkm : RingHom.ker φ.toRingHom ≤ IsLocalRing.maximalIdeal R₁ :=
    IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top φ.toRingHom)
  have hker : IsNilpotent (RingHom.ker (algebraMap R₁ R₀)) :=
    ⟨2, by
      rw [pow_two, Submodule.zero_eq_bot, ← le_bot_iff, Ideal.mul_le]
      intro x hx y hy
      rw [Submodule.mem_bot]
      exact hsmall x hx y (hkm hy)⟩
  have hcomp : (algebraMap R₁ R₀).comp (algebraMap S R₁) = algebraMap S R₀ := RingHom.ext fun s => φ.commutes s
  have hιcomp : Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap S R₁)) =
      Spec.map (CommRingCat.ofHom (algebraMap S R₀)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg (fun r => Spec.map (CommRingCat.ofHom r)) hcomp

  have hsq : IsPullback t (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀))))
      (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁)))) (Spec.map (CommRingCat.ofHom φ.toRingHom)) := by
    have big : IsPullback (t ≫ pullback.fst E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁))))
        (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))) E.f
        (Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap S R₁))) := by
      rw [ht₁, hιcomp]; exact IsPullback.of_hasPullback _ _
    exact IsPullback.of_right big ht₂ (IsPullback.of_hasPullback _ _)

  have hc₁ : L₁.IsCommutative := law_isCommutative E R₁ L₁ hL₁
  have hA₁ : AbelianSchemePropertyBundle R₁ (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₁)))) :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.of_isPullback E.bundle (IsPullback.of_hasPullback _ _)

  obtain ⟨E₁', g₁, hg₁, hmul₁, hact₁, hlev₁, hlev₁'⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff (algebraMap S R₁) E
  obtain ⟨E₀', g₀, hg₀, hmul₀, hact₀, hlev₀, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff (algebraMap S R₀) E
  let c₁ := hg₁.isoPullback
  let c₀ := hg₀.isoPullback
  have hc₁1 : c₁.hom ≫ pullback.fst _ _ = g₁ := hg₁.isoPullback_hom_fst
  have hc₁2 : c₁.hom ≫ pullback.snd _ _ = E₁'.f := hg₁.isoPullback_hom_snd
  have hc₀1 : c₀.hom ≫ pullback.fst _ _ = g₀ := hg₀.isoPullback_hom_fst
  have hc₀2 : c₀.hom ≫ pullback.snd _ _ = E₀'.f := hg₀.isoPullback_hom_snd
  have hc₁2' : c₁.inv ≫ E₁'.f = pullback.snd _ _ := hg₁.isoPullback_inv_snd
  have hc₀2' : c₀.inv ≫ E₀'.f = pullback.snd _ _ := hg₀.isoPullback_inv_snd

  obtain ⟨g', hg'g, hg'f, -, hvia⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_comp_eq_and_isPullbackVia_of_comp_eq
      (algebraMap S R₁) (algebraMap R₁ R₀) (algebraMap S R₀) hcomp E E₁' E₀' g₁ ⟨hg₁, hmul₁, hact₁, hlev₁⟩ hlev₁'
      g₀ ⟨hg₀, hmul₀, hact₀, hlev₀⟩
  have ht : t = c₀.inv ≫ g' ≫ c₁.hom := by
    apply pullback.hom_ext
    · rw [ht₁, Category.assoc, Category.assoc, hc₁1, hg'g, ← hc₀1, Iso.inv_hom_id_assoc]
    · rw [ht₂, Category.assoc, Category.assoc, hc₁2, hg'f, ← Category.assoc, hc₀2', halg]

  have hcan₀ := h𝓛₀.2.2.2
  have hRsymP₀ := hcan₀.2.2.2.2.2
  have hinvsymP₀ := hcan₀.1
  let 𝓛₀' : E₀'.A.Modules := (Scheme.Modules.pullback c₀.hom).obj 𝓛₀
  have h𝓛₀' : Scheme.Modules.IsInvertible 𝓛₀' := Scheme.Modules.IsInvertible.pullback c₀.hom h𝓛₀.1
  have hsqc₀ := isPullback_of_iso c₀ (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))) E₀'.f hc₀2
  have hmulc₀ : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R₀)) (P Q : SchemeHomOver t' E₀'.f),
      (E₀'.L.mul t' P Q).1 ≫ c₀.hom =
        (L₀.mul (t' ≫ Spec.map (CommRingCat.ofHom (RingHom.id R₀)))
          ⟨P.1 ≫ c₀.hom, by rw [Category.assoc, hsqc₀.w, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ c₀.hom, by rw [Category.assoc, hsqc₀.w, ← Category.assoc, Q.2]⟩).1 := by
    intro T t' P Q
    rw [law_compat_hom E R₀ L₀ hL₀ E₀' g₀ hg₀ hmul₀]
    exact mul_val_congr L₀ (by rw [specMap_id, Category.comp_id]) _ _ _ _ rfl rfl
  have hRsymE₀ : RosatiCompatible E₀'.f E₀'.L ((Scheme.Modules.pullback c₀.hom).obj
      (𝓛₀ ⊗ (Scheme.Modules.pullback (negMor (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))) L₀)).obj 𝓛₀))
      E₀'.act E₀'.act_over star :=
    AlgebraicGeometry.Polarisation.RosatiCompatible.pullback_of_isPullback R₀ R₀ (RingHom.id R₀)
      (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))) L₀ E₀'.f E₀'.L c₀.hom hsqc₀ hmulc₀
      _ _ E₀'.act E₀'.act_over (fun x => act_compat_hom E R₀ E₀' g₀ hg₀ hact₀ x) star _ hinvsymP₀ hRsymP₀

  have hneg₀ : c₀.hom ≫ negMor (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))) L₀ =
      negMor E₀'.f E₀'.L ≫ c₀.hom :=
    GoodReductionJacobian.RelativeGroupLaw.comp_negMor_eq_negMor_comp_of_hom (RingHom.id R₀) L₀ E₀'.L c₀.hom
      (by rw [specMap_id, Category.comp_id, hc₀2]) (fun T t' P Q => hmulc₀ t' P Q)
  have σ₀ : (Scheme.Modules.pullback c₀.hom).obj
      (𝓛₀ ⊗ (Scheme.Modules.pullback (negMor (pullback.snd E.f (Spec.map (CommRingCat.ofHom (algebraMap S R₀)))) L₀)).obj 𝓛₀) ≅
      𝓛₀' ⊗ (Scheme.Modules.pullback (negMor E₀'.f E₀'.L)).obj 𝓛₀' :=
    Scheme.Modules.pullbackTensorObjIso c₀.hom _ _ ≪≫
      (Iso.refl _ ⊗ᵢ ((Scheme.Modules.pullbackComp c₀.hom _).app 𝓛₀ ≪≫ (Scheme.Modules.pullbackCongr hneg₀).app 𝓛₀ ≪≫
        ((Scheme.Modules.pullbackComp (negMor E₀'.f E₀'.L) c₀.hom).app 𝓛₀).symm))
  have hRsymE₀' : RosatiCompatible E₀'.f E₀'.L (𝓛₀' ⊗ (Scheme.Modules.pullback (negMor E₀'.f E₀'.L)).obj 𝓛₀')
      E₀'.act E₀'.act_over star :=
    rosatiCompatible_of_iso' E₀'.f E₀'.L E₀'.act E₀'.act_over star _ _
      (Scheme.Modules.IsInvertible.pullback c₀.hom hinvsymP₀) σ₀ hRsymE₀

  haveI hlocR₀ : IsLocalRing R₀ := IsLocalRing.of_surjective' φ.toRingHom hφ
  haveI hnoeR₀ : IsNoetherianRing R₀ := isNoetherianRing_of_surjective R₁ R₀ φ.toRingHom hφ
  haveI hartR₀ : IsArtinianRing R₀ := Function.Surjective.isArtinianRing (f := φ.toRingHom) hφ
  haveI hlocφ : IsLocalHom φ.toRingHom := IsLocalHom.of_surjective φ.toRingHom hφ
  haveI hacR₀ : IsAlgClosed (IsLocalRing.ResidueField R₀) := by
    have hsurj : Function.Surjective (IsLocalRing.ResidueField.map φ.toRingHom) := by
      intro x
      obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
      obtain ⟨z, rfl⟩ := hφ y
      exact ⟨IsLocalRing.residue R₁ z, rfl⟩
    exact IsAlgClosed.of_ringEquiv (k := IsLocalRing.ResidueField R₁) (IsLocalRing.ResidueField R₀)
      (RingEquiv.ofBijective (IsLocalRing.ResidueField.map φ.toRingHom)
        ⟨(IsLocalRing.ResidueField.map φ.toRingHom).injective, hsurj⟩)
