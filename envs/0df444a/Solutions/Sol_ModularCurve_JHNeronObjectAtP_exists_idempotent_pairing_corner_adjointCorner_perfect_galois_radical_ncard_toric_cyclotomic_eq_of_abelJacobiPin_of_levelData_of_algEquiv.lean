theorem coeffMap_comp_coeffEmb (L : Type*) [Field L] [Algebra ℚ L] (ιA : L →+* AlgebraicClosure ℚ) (x : LaurentSeries ℚ) :
    coeffMap ιA (coeffEmb L x) = coeffEmb (AlgebraicClosure ℚ) x := by
