set_option autoImplicit true
@[expose] public section
public section
variable {X : Type*} [AddCommGroup X] [Lattice X] [IsOrderedAddMonoid X]
  [VectorLattice X]
open VectorSublattice
variable (Y : VectorSublattice X)
open scoped Pointwise

theorem VectorSublattice.generated_pointedCone_eq_sub_infClosure (C : PointedCone ℝ X) :
    (generated (C : Set X) : Set X)
      = infClosure (C : Set X) - infClosure (C : Set X) := by sorry
