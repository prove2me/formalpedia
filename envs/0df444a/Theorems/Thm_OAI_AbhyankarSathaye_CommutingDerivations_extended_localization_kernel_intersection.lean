open OAI OAI.AbhyankarSathaye OAI.AbhyankarSathaye.CommutingDerivations
open MvPolynomial

theorem OAI.AbhyankarSathaye.CommutingDerivations.extended_localization_kernel_intersection {n : ℕ} (hn : 4 ≤ n)
    (r : MvPolynomial (Fin n) ℂ) :
    (∃ b : LaurentCoefficients,
      extendedLocalizationEquiv hn (extendedLocMap hn r) = C b) ↔
    r ∈ Algebra.adjoin ℂ ({extendedF hn} : Set (MvPolynomial (Fin n) ℂ)) := by sorry
