-- title:
--   The generated quotient and simple cluster construction
-- statement:
--   The underlying ternary relational structure is the published general relational-structure type, specialized to one ternary symbol. For a layered instance, occurrences are pairs $(x,A)$ with $A\in W_x$. Take the quotient by the equivalence relation generated by
--   $$(x,\pi_e^{-1}(B))\sim(y,B)\qquad(e:x\to y,\ B\in W_y).$$
--   Every coordinatewise not-all-equal triple from every full closed domain gives an ordered quotient triple. Repeated quotient vertices remain in these constraints.
--
--   For the simple conversion, replace each quotient vertex $v$ by $\{v\}\times[2C+1]$. A bijective numbering identifies all cluster vertices with a finite initial segment. Include every three-element set having pairwise distinct representatives from a relational triple, then deduplicate. The output is the published simple 3-uniform hypergraph type. The construction is defined for any numbering, so the mathematical conclusions do not depend on a choice of names for vertices.
--
--   This definition computes the relation and edges from the input data; it does not assume either coloring implication.
--
--   The explicit empty-alphabet NO branch is the complete 3-uniform hypergraph on $2C+1$ vertices together with $n$ isolated vertices, with actual vertex count $2C+1+n$.
-- source:
--   Amey Bhangale, STOC 2027 submission #1052 (October 2026), §§3.4–3.6, pp. 16–19 (printed pages = PDF pages); https://github.com/sigact-stoc/stoc2027/releases/download/papers-2/1052.pdf

import Mathlib
import Definitions.Def_BhangaleHypergraph_Main_Outer
import Definitions.Def_FourToOneGames_Hypergraph
import Definitions.Def_PCSPBLPAff_Symmetric_Setting

namespace BhangaleHypergraph.Main

/-- A relational NAE instance retains ordered triples, even with repeated entries. -/
abbrev RelInstance (V : Type) := PCSPBLPAff.Symmetric.RelStruct Unit (fun _ => 3) V

def RelInstance.triple {V : Type} (I : RelInstance V) (u v w : V) : Prop :=
  ![u, v, w] ∈ I.rel ()

def RelColorable {V : Type} (I : RelInstance V) (k : ℕ) : Prop :=
  ∃ f : V → Fin k, ∀ u v w, I.triple u v w → ¬ (f u = f v ∧ f v = f w)

abbrev Occurrence (G : Layered) (C : ℕ) :=
  (x : Fin G.n) × {A : Finset (Fin (G.R x)) // A ∈ Closed G C (C ^ (C - 1)) x}

/-- Precisely the generating identifications of §3.4. -/
def Identification (G : Layered) (C : ℕ) (a b : Occurrence G C) : Prop :=
  ∃ (e : Fin G.edges) (B : Finset (Fin (G.R (G.dst e))))
    (hB : B ∈ Closed G C (C ^ (C - 1)) (G.dst e))
    (hA : Preimage (G.proj e) B ∈ Closed G C (C ^ (C - 1)) (G.src e)),
    a = ⟨G.src e, ⟨Preimage (G.proj e) B, hA⟩⟩ ∧ b = ⟨G.dst e, ⟨B, hB⟩⟩

/-- `Quot` takes the equivalence relation generated by all identifications. -/
abbrev RelVertex (G : Layered) (C : ℕ) := Quot (Identification G C)

instance (G : Layered) (C : ℕ) : Finite (RelVertex G C) :=
  Finite.of_surjective (Quot.mk (Identification G C)) (Quot.mk_surjective)

noncomputable instance (G : Layered) (C : ℕ) : Fintype (RelVertex G C) := Fintype.ofFinite _

def Relational (G : Layered) (C : ℕ) : RelInstance (RelVertex G C) where
  rel _ := {t | ∃ (x : Fin G.n)
    (A B D : {A : Finset (Fin (G.R x)) // A ∈ Closed G C (C ^ (C - 1)) x}),
    BooleanNAE A.val B.val D.val ∧
      t 0 = Quot.mk _ ⟨x, A⟩ ∧ t 1 = Quot.mk _ ⟨x, B⟩ ∧ t 2 = Quot.mk _ ⟨x, D⟩}

/-- Pull clusters back through any explicit numbering. All repetitions in the
relational triple are retained; only the chosen cluster vertices must be distinct. -/
noncomputable def Cluster {V : Type} (I : RelInstance V) (C n : ℕ)
    (numbering : Fin n ≃ V × Fin (2 * C + 1)) : FourToOneGames.Hypergraph3 := by
  classical
  let es : Finset (Finset (Fin n)) := Finset.univ.filter fun E =>
    E.card = 3 ∧ ∃ a b c : Fin n,
      E = {a, b, c} ∧ a ≠ b ∧ a ≠ c ∧ b ≠ c ∧
        I.triple (numbering a).1 (numbering b).1 (numbering c).1
  refine ⟨n, es, ?_⟩
  intro E hE
  exact (Finset.mem_filter.mp hE).2.1

/-- Numbering is an explicit interface: no correctness property is bundled in it.
Every numbering gives the same hypergraph up to isomorphism. -/
noncomputable def Composed (G : Layered) (C n : ℕ)
    (numbering : Fin n ≃ RelVertex G C × Fin (2 * C + 1)) : FourToOneGames.Hypergraph3 :=
  Cluster (Relational G C) C n numbering

/-- The explicit §3.6 empty-alphabet branch: a complete 3-uniform hypergraph
on `2C+1` vertices, followed by `n` isolated vertices. -/
def EmptyAlphabetNo (C n : ℕ) : FourToOneGames.Hypergraph3 := by
  let es : Finset (Finset (Fin (2 * C + 1 + n))) := Finset.univ.filter fun E =>
    E.card = 3 ∧ ∀ v ∈ E, v.val < 2 * C + 1
  refine ⟨2 * C + 1 + n, es, ?_⟩
  intro E hE
  exact (Finset.mem_filter.mp hE).2.1

end BhangaleHypergraph.Main


