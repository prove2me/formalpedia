section
-- Source module: Solutions.R6CxNetMaskAll
/-!
# The mask identity for the network data

Chains the kernel segment checks `chkM0 … chkM6` (gate DAG on spread inputs), the placement check
`chkMP` and the readout check `chkMR` into `MaskOK dat`, plus the range facts used by the stage
effects (`NetEff.stage1`, `NetEff.stage2`).
-/

namespace IntMul.Kappa.R6.Cx.NetEff

open NetBT NetSpec NetFast NetMask NetData

lemma seg {ops : List (ℕ × ℕ)} {t S : BT} {C : ℕ → ℕ → ℕ} (hE : Enc t C)
    (h : simK (fun t' => beqR t' S) ops t = true) :
    Enc S (runP ops C) ∧ GOK ops := by
  obtain ⟨t', hE', hk, hb⟩ := simK_sound _ ops t C hE h
  rw [beqR_eq] at hk
  rw [← BT.eq_of_beq _ _ hk]
  exact ⟨hE', hb⟩

lemma gok_append {a b : List (ℕ × ℕ)} (ha : GOK a) (hb : GOK b) : GOK (a ++ b) := fun o ho => by
  rcases List.mem_append.1 ho with h | h
  · exact ha o h
  · exact hb o h

lemma src_lt16 (t : ℕ) : dat.src t < 2 ^ 16 := Nat.mod_lt _ (Nat.two_pow_pos 16)

lemma gates_gqs : dat.gates.flatMap gq =
    gqs gD0 ++ gqs gD1 ++ gqs (gD2 ++ gD3) ++ gqs (gD4 ++ gD5) ++ gqs (gD6 ++ gD7) ++
      gqs (gD8 ++ gD9) ++ gqs gD10 := by
  show gqs gD = _
  simp only [gD, gqs_append, List.append_assoc]

lemma rdTerms_eq (hlen : dat.pieces.length = NV) :
    rdTerms dat = (List.range NV).map fun S => (S, rdL dat S) := by
  unfold rdTerms
  rw [zip_range_eq _ _ hlen [], List.map_map]
  rfl

/-- **All data facts of the scalar side.** -/
theorem maskAll_sol_aux : MaskOK dat ∧ GOK (dat.gates.flatMap gq) ∧ (∀ t < NV, dat.src t < NR) ∧ RdOK dat ∧
    dat.pieces.length = NV := by
  have hP := chkMP
  simp only [Bool.and_eq_true] at hP
  have hsrc : ∀ t < NV, dat.src t < NR := fun t ht => by
    have := allR_spec hP.1 t (List.mem_range.2 ht)
    simpa using this
  have hb := hP.2
  rw [beqR_eq] at hb
  have E0 : Enc SM0 (place dat.src NV) := by
    rw [← BT.eq_of_beq _ _ hb]; exact placeK_enc _ src_lt16 NV
  obtain ⟨E1, g1⟩ := seg E0 chkM0
  obtain ⟨E2, g2⟩ := seg E1 chkM1
  obtain ⟨E3, g3⟩ := seg E2 chkM2
  obtain ⟨E4, g4⟩ := seg E3 chkM3
  obtain ⟨E5, g5⟩ := seg E4 chkM4
  obtain ⟨E6, g6⟩ := seg E5 chkM5
  obtain ⟨E7, g7⟩ := seg E6 chkM6
  simp only [← runP_append] at E7
  have hR := chkRd
  simp only [Bool.and_eq_true] at hR
  obtain ⟨⟨hrs, hlen⟩, hps⟩ := hR
  have hlen' : dat.pieces.length = NV := Nat.eq_of_beq_eq_true hlen
  have hRd : RdOK dat := by
    refine ⟨fun j hj => by simpa using allR_spec hrs j (List.mem_range.2 hj), fun S hS p hp => ?_⟩
    rw [List.getD_eq_getElem?_getD] at hp
    have hSl : S < dat.pieces.length := by omega
    rw [List.getElem?_eq_getElem hSl] at hp
    have h1 := allR_spec hps _ (List.getElem_mem hSl)
    simpa using allR_spec h1 p hp
  refine ⟨fun S hS u => ?_, ?_, hsrc, hRd, hlen'⟩
  · have hm : (S, rdL dat S) ∈ rdTerms dat := by
      rw [rdTerms_eq hlen']; exact List.mem_map.2 ⟨S, List.mem_range.2 hS, rfl⟩
    have := rdS_sound _ _ E7 S (rdL dat S) (allR_spec chkMR _ hm) u
    rw [gates_gqs]
    simpa only [List.append_assoc] using this
  · rw [gates_gqs]
    exact gok_append (gok_append (gok_append (gok_append (gok_append (gok_append g1 g2) g3) g4) g5) g6) g7

end IntMul.Kappa.R6.Cx.NetEff

end

theorem solution : type_of% @IntMul.Kappa.R6.Cx.NetEff.maskAll_sol_aux := @IntMul.Kappa.R6.Cx.NetEff.maskAll_sol_aux
