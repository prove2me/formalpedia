namespace ExactVacuumAtlas.Variation

variable {n : ℕ}

section line

variable {U : Set (Pt n)} {g gi h : Metric n} {F f : TwoForm n}

theorem zero_mem_lineDom (hinv : ∀ y ∈ U, metricMatrix gi y * metricMatrix g y = 1) {x : Pt n}
    (hx : x ∈ U) : ((0 : ℝ), x) ∈ lineDom U g h := by
  refine ⟨hx, ?_⟩
  have e : metricMatrix (lineMetric g h 0) x = metricMatrix g x := by
    ext i j; simp [lineMetric, metricMatrix]
  rw [e]
  exact Matrix.det_ne_zero_of_left_inverse (hinv x hx)

theorem isTangent_line : IsTangent (lineMetric g h) (lineMetric F f) (lineDom U g h) h f where
  metric y _ i j := by
    simpa [lineMetric] using ((hasDerivAt_id (0 : ℝ)).mul_const (h i j y)).const_add (g i j y)
  field y _ i j := by
    simpa [lineMetric] using ((hasDerivAt_id (0 : ℝ)).mul_const (f i j y)).const_add (F i j y)

theorem lineMetric_zero (g h : Metric n) : lineMetric g h 0 = g := by
  funext i j y; simp [lineMetric]

theorem lineInv_zero_eqOn (hinv : ∀ y ∈ U, metricMatrix gi y * metricMatrix g y = 1) (i j : Fin n) :
    Set.EqOn (lineInv g h 0 i j) (gi i j) U := by
  intro y hy
  simp only [lineInv, lineMetric_zero]
  rw [Matrix.inv_eq_left_inv (hinv y hy)]
  rfl

end line

section line4

variable {U : Set (Pt 4)} {g gi h : Metric 4} {F f : TwoForm 4}
  (hU : IsOpen U) (hg : ∀ i j, ContDiffOn ℝ ∞ (g i j) U)
  (hinv : ∀ y ∈ U, metricMatrix gi y * metricMatrix g y = 1) (hF : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
  (hh : ∀ i j, ContDiffOn ℝ ∞ (h i j) U) (hf : ∀ i j, ContDiffOn ℝ ∞ (f i j) U)
include hU hg hinv hF hh hf

end line4

end ExactVacuumAtlas.Variation

-- ==== solution ====
open Filter Topology
open scoped ContDiff
open Matrix
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
variable {n : ℕ}
variable {U : Set (Pt 4)} {g gi h : Metric 4} {F f : TwoForm 4}
  (hU : IsOpen U) (hg : ∀ i j, ContDiffOn ℝ ∞ (g i j) U)
  (hinv : ∀ y ∈ U, metricMatrix gi y * metricMatrix g y = 1) (hF : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
  (hh : ∀ i j, ContDiffOn ℝ ∞ (h i j) U) (hf : ∀ i j, ContDiffOn ℝ ∞ (f i j) U)
include hU hg hinv hF hh hf
theorem solution {x : Pt 4} (hx : x ∈ U) (b : Fin 4) :
    HasDerivAt (fun ε => maxwellDiv (lineMetric g h ε) (lineInv g h ε) (lineMetric F f ε) b x)
      (linMaxwell g gi F h f b x) 0 := by
  have hb := (familyData_line hU hg hh hF hf).bridge_maxwell isTangent_line (zero_mem_lineDom hinv hx) b
  rwa [lineMetric_zero, lineMetric_zero,
    linMaxwell_congr hU (fun _ _ => Set.eqOn_refl _ _) (lineInv_zero_eqOn hinv)
      (fun _ _ => Set.eqOn_refl _ _) (fun _ _ => Set.eqOn_refl _ _) (fun _ _ => Set.eqOn_refl _ _) hx b] at hb
