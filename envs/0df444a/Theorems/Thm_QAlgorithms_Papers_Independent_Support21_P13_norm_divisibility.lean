-- title:
--   Norm divisibility and the primitive valuation bound
-- statement:
--   Let $x\in\mathbb Z[\omega]$, and interpret all divisibility inside this ring. With $v$ denoting its $\sqrt2$ dividing exponent,
--
--   $$
--   \sqrt2\mid x\quad\Longleftrightarrow\quad 2\mid |x|^2,\qquad
--   v(x)=0\quad\Longrightarrow\quad v(|x|^2)\le1.
--   $$
--
--   The equivalence includes $x=0$. The second conclusion requires primitivity and allows norm valuation one, as needed for denominator analysis.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 21, Appendix A unnumbered consequence: divisibility and primitive norm bound

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Appendix A, PDF p.21: the divisibility equivalence includes zero; the
primitive norm bound has its own primitive premise. Bases differ in the iff. -/
theorem norm_divisibility (x : integralRing) :
    (DividesIntegral ((Real.sqrt 2 : ℝ) : ℂ) (x : ℂ) ↔
      DividesIntegral 2 (normSquared (x : ℂ))) ∧
    (gde (x : ℂ) = 0 → gde (normSquared (x : ℂ)) ≤ 1) := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
