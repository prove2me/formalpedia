open scoped BigOperators ENNReal

private theorem directionDegree_mul_le_exceptionalDegree (k : Type) [Field k]
    (D : ExceptionalDivisor k) (Q : ClosedDirection k) :
    directionDegree k Q * D Q ≤ exceptionalDegree k D := by
  by_cases hQ : D Q = 0
  · simp [hQ]
  · exact Finset.single_le_sum (f := fun Q => directionDegree k Q * D Q) (by intros; positivity)
      (Finsupp.mem_support_iff.mpr hQ)

end TypeDensity

open TypeDensity
open scoped BigOperators ENNReal

theorem solution (k : Type) [Field k] (n : ℕ) (D : TypeDensity.ExceptionalDivisor k)
    (hD : TypeDensity.exceptionalDegree k D = n) (m : TypeDensity.Pattern n) (hm : TypeDensity.HasArray k n D m) :
    ∃ e : Fin (TypeDensity.otherChildren 1 m).length ≃ D.support, ∀ j, (TypeDensity.otherChildren 1 m).get j =
      (TypeDensity.directionDegree k (e j), TypeDensity.State.single 1 (D (e j))) := by
  set Ls := TypeDensity.otherChildren 1 m with hLs
  let ℓ₁ : Fin Ls.length → ℕ × TypeDensity.State := fun j => Ls.get j
  let ℓ₂ : D.support → ℕ × TypeDensity.State := fun Q => (TypeDensity.directionDegree k Q, TypeDensity.State.single 1 (D Q))
  have hdeg := TypeDensity.directionDegree_pos k
  have hle : ∀ Q ∈ D.support, TypeDensity.directionDegree k Q * D Q ≤ n := fun Q _ ↦ hD ▸
      TypeDensity.directionDegree_mul_le_exceptionalDegree k D Q
  have hcard : ∀ x, Fintype.card {j // ℓ₁ j = x} = Fintype.card {Q // ℓ₂ Q = x} := by
    intro x
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]
    have h1 : Nat.card {j // ℓ₁ j = x} = Ls.count x := by
      convert TypeDensity.list_get_fiber_card _ Ls x using 2
      exact lawful_beq_subsingleton _ _
    rw [h1]
    by_cases hx : ∃ δ r, x = (δ, TypeDensity.State.single 1 r)
    · obtain ⟨δ, r, rfl⟩ := hx
      rw [(TypeDensity.other_children_count n m δ r).1]
      have hR : Nat.card {Q // ℓ₂ Q = (δ, TypeDensity.State.single 1 r)} =
          Nat.card {Q : TypeDensity.ClosedDirection k // TypeDensity.directionDegree k Q = δ ∧ D Q = r ∧ 0 < r} := by
        apply Nat.card_congr
        exact
          { toFun := fun Q => ⟨Q.1.1, by
              have h := Q.2
              simp only [ℓ₂, Prod.mk.injEq, TypeDensity.State.single.injEq, true_and] at h
              have hs := Finsupp.mem_support_iff.mp Q.1.2
              exact ⟨h.1, h.2, by omega⟩⟩
            invFun := fun Q => ⟨⟨Q.1, Finsupp.mem_support_iff.mpr (by omega)⟩, by
              simp only [ℓ₂, Prod.mk.injEq, TypeDensity.State.single.injEq, true_and]
              exact ⟨Q.2.1, Q.2.2.1⟩⟩
            left_inv := fun Q => rfl
            right_inv := fun Q => rfl }
      rw [hR]
      split_ifs with h
      · rw [← hm (⟨δ - 1, by omega⟩, ⟨r - 1, by omega⟩)]
        apply Nat.card_congr
        apply Equiv.subtypeEquivRight
        intro Q
        simp only
        omega
      · symm; rw [Nat.card_eq_zero]
        left
        refine ⟨fun ⟨Q, hQ1, hQ2, hQ3⟩ => h ?_⟩
        have h1 := hdeg Q
        have hQs : Q ∈ D.support := Finsupp.mem_support_iff.mpr (by omega)
        have h2 := hle Q hQs
        rw [hQ1] at h1; rw [hQ1, hQ2] at h2
        refine ⟨h1, ?_, hQ3, ?_⟩
        · nlinarith
        · nlinarith
    · have hL : Ls.count x = 0 := by
        rw [List.count_eq_zero]
        intro hmem
        obtain ⟨ij, hij⟩ := (TypeDensity.other_children_count n m 0 0).2.1 x hmem
        exact hx ⟨_, _, hij⟩
      rw [hL]
      symm
      rw [Nat.card_eq_zero]
      left
      exact ⟨fun ⟨Q, hQ⟩ => hx ⟨_, _, hQ.symm⟩⟩
  refine ⟨(Equiv.sigmaFiberEquiv ℓ₁).symm.trans
    ((Equiv.sigmaCongrRight fun x => Fintype.equivOfCardEq (hcard x)).trans
      (Equiv.sigmaFiberEquiv ℓ₂)), fun j => ?_⟩
  have := ((Fintype.equivOfCardEq (hcard (ℓ₁ j))) ⟨j, rfl⟩).2
  exact this.symm
