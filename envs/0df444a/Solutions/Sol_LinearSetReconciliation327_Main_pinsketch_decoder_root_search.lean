theorem RootWorkspace.basis_meta_readonly {R U D C TB ZB cap Q0 Q1 T : ℕ}
    (h : RootWorkspace R U D C TB ZB cap) (hQ0 : 128 ≤ Q0) (hQ1 : 128 ≤ Q1)
    (slot : ℕ) (hs : slot < 128) (hn : ¬ rootBasisMeta slot) :
    ¬ rootBasisWritable R U D C TB cap Q0 Q1 T slot := by
  intro hbad
  rcases hbad with hm | hw | h0 | h1
  · exact hn hm
  · apply h.compute_meta_readonly slot hs ?_ hw
    intro hc
    apply hn
    dsimp [rootBasisMeta, rootLevelMeta, rootNodeMeta]
    first | omega | tauto
  · omega
  · omega

theorem RootWorkspace.basis_zero_readonly {R U D C TB ZB cap Q0 Q1 T : ℕ}
    (h : RootWorkspace R U D C TB ZB cap)
    (hQ0 : Q0 + T * cap ≤ ZB ∨ ZB + cap ≤ Q0) (hQ1 : Q1 + T * cap ≤ ZB ∨ ZB + cap ≤ Q1)
    (i : ℕ) (hi : i < cap) : ¬ rootBasisWritable R U D C TB cap Q0 Q1 T (ZB + i) := by
  have hz := h.Zlow
  intro hbad
  rcases hbad with hm | hw | h0 | h1
  · dsimp [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta] at hm
    omega
  · exact h.zero_readonly i hi hw
  · omega
  · omega

theorem RootConstants.of_basis_frame {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {R U D C TB ZB cap L Q0 Q1 T : ℕ} {m m' : ℕ → ℕ}
    (h : RootConstants b R U D C TB ZB cap L m) (hl : RootWorkspace R U D C TB ZB cap)
    (hQ0 : 128 ≤ Q0) (hQ1 : 128 ≤ Q1)
    (hQ0Z : Q0 + T * cap ≤ ZB ∨ ZB + cap ≤ Q0) (hQ1Z : Q1 + T * cap ≤ ZB ∨ ZB + cap ≤ Q1)
    (hf : MemoryFrame (rootBasisWritable R U D C TB cap Q0 Q1 T) m m') :
    RootConstants b R U D C TB ZB cap L m' := by
  have hmeta (slot : ℕ) (hs : slot < 128) (hn : ¬ rootBasisMeta slot) : m' slot = m slot :=
    hf slot (hl.basis_meta_readonly hQ0 hQ1 slot hs hn)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, h.zero.of_frame hf (hl.basis_zero_readonly hQ0Z hQ1Z)⟩
  · exact (hmeta 76 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.length
  · exact (hmeta 77 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.dimension
  · exact (hmeta 78 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.unit
  · exact (hmeta 81 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.capacity
  · exact (hmeta 102 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedR
  · exact (hmeta 103 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedD
  · exact (hmeta 104 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedU
  · exact (hmeta 105 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedC
  · exact (hmeta 106 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedT
  · exact (hmeta 108 (by norm_num) (by norm_num [rootBasisMeta, rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedZ

