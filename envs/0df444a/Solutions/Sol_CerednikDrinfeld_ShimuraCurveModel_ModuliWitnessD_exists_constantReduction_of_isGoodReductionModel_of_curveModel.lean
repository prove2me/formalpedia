  have hs𝔅 : Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ Spec.map (CommRingCat.ofHom i) = w.sbar := by
    rw [hsbar]; simp only [i, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]

  obtain ⟨hprop₀, hsm₀, hgi₀, ⟨ε₀⟩⟩ :=
    AlgebraicGeometry.SmoothProperCurve.isProper_and_smooth_and_geometricallyIntegral_and_nonempty_section_pullback_of_henselianLocalRing
