section Piece_EtPi1Geo_Cmp


/-!
# S4-EtPi1Geo, G4 (Cmp): `π₁(A'_K) ≅ π₁^geo(A')` as conjugation by a field identification

`A'` a domain with fraction field `F` (characteristic `p`), `FK ⊇ F` algebraic and generated by constants
(`hgen`), `AK` an `A'`-algebra integral over `A'` with `AK → FK` (e.g. `A'_K = K ⊗ A'`, `FK = Frac A'_K`).
* `phiFK : FK →ₐ[F] F̄`, `iotaK : F̄ ≃ₐ[F] F̄K` (`FK`-linear for `phiFK`);
* `jι` (S4-EtPi1) is bijective (`jK_surjective`, by the descent `mem_maxUnram_of_unrIn_const`);
  **`iota : maxUnram AK FK ≃ₐ[F] maxUnram A' F`** its inverse, `iota_algebraMap` (`ι` is `phiFK` on `FK`);
* **`cmp : Pi1 AK FK ≃ₜ* pi1geo A' F q`** (`q = p ^ e`, `FK` containing the constants of `F̄K`: `hcl`),
  **`cmp_apply`**: `cmp g x = iota (g (iota.symm x))`.
-/

set_option autoImplicit false

namespace RamanujanPetersson
namespace EtPi1Geo

open Polynomial IntermediateField CurveCoh GalCover Lefschetz

noncomputable section

section Cmp

variable (p : ℕ) [hp : Fact p.Prime] (A' F FK AK : Type) [CommRing A'] [IsDomain A'] [Field F] [Algebra A' F]
  [IsFractionRing A' F] [CharP F p] [Field FK] [Algebra F FK] [Algebra A' FK] [IsScalarTower A' F FK]
  [Algebra.IsAlgebraic F FK] [CommRing AK] [Algebra A' AK] [Algebra AK FK] [IsScalarTower A' AK FK]
  [Algebra.IsIntegral A' AK]

/-- The chosen `F`-embedding `FK → F̄`. -/
def phiFK : FK →ₐ[F] AlgebraicClosure F := IsAlgClosed.lift

/-- `F̄` as an `FK`-algebra through `phiFK` (not an instance). -/
def algFK : Algebra FK (AlgebraicClosure F) := (phiFK F FK).toRingHom.toAlgebra

theorem towerFK : @IsScalarTower F FK (AlgebraicClosure F) _ (algFK F FK).toSMul _ := by
  letI := algFK F FK
  exact IsScalarTower.of_algebraMap_eq fun c => ((phiFK F FK).commutes c).symm

/-- The identification `F̄ ≃ F̄K`, `FK`-linear for `phiFK`. -/
def iotaK : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure FK :=
  letI := algFK F FK
  haveI := towerFK F FK
  haveI : IsAlgClosure FK (AlgebraicClosure F) :=
    ⟨inferInstance, Algebra.IsAlgebraic.tower_top (K := F) FK⟩
  (IsAlgClosure.equiv FK (AlgebraicClosure F) (AlgebraicClosure FK)).restrictScalars F

theorem iotaK_phiFK (c : FK) : iotaK F FK (phiFK F FK c) = algebraMap FK (AlgebraicClosure FK) c := by
  letI := algFK F FK
  haveI := towerFK F FK
  haveI : IsAlgClosure FK (AlgebraicClosure F) :=
    ⟨inferInstance, Algebra.IsAlgebraic.tower_top (K := F) FK⟩
  exact (IsAlgClosure.equiv FK (AlgebraicClosure F) (AlgebraicClosure FK)).commutes c

/-- **Descent**: `ι⁻¹` maps `maxUnram AK FK` into `maxUnram A' F`. -/
theorem iotaK_symm_mem (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) {y : AlgebraicClosure FK}
    (hy : y ∈ maxUnram AK FK) : (iotaK F FK).symm y ∈ maxUnram A' F := by
  letI := algFK F FK
  haveI := towerFK F FK
  haveI : IsAlgClosure FK (AlgebraicClosure F) :=
    ⟨inferInstance, Algebra.IsAlgebraic.tower_top (K := F) FK⟩
  rw [maxUnram_eq_tower A' AK FK] at hy
  obtain ⟨L, hL, hyL⟩ := (mem_maxUnram_iff_of_equiv A' FK
    (IsAlgClosure.equiv FK (AlgebraicClosure F) (AlgebraicClosure FK)).symm y).1 hy
  exact mem_maxUnram_of_unrIn_const p A' F FK hgen L hL hyL

/-- `ι = iotaK` restricted: `maxUnram A' F → maxUnram AK FK` is bijective. -/
theorem jK_surjective (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) :
    Function.Surjective (EtPi1.jι (A := A') (A' := AK) (iotaK F FK).toAlgHom) := fun y =>
  ⟨⟨(iotaK F FK).symm y, iotaK_symm_mem p A' F FK AK hgen y.2⟩, Subtype.ext ((iotaK F FK).apply_symm_apply _)⟩

/-- `jι` as an isomorphism `maxUnram A' F ≃ₐ[F] maxUnram AK FK`. -/
def jEquiv (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) : maxUnram A' F ≃ₐ[F] maxUnram AK FK :=
  AlgEquiv.ofBijective (EtPi1.jι (A := A') (A' := AK) (iotaK F FK).toAlgHom)
    ⟨EtPi1.jι_injective _, jK_surjective p A' F FK AK hgen⟩

/-- **The field identification** `ι : maxUnram AK FK ≃ₐ[F] maxUnram A' F`. -/
def iota (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) : maxUnram AK FK ≃ₐ[F] maxUnram A' F :=
  (jEquiv p A' F FK AK hgen).symm

theorem jEquiv_apply (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (x : maxUnram A' F) :
    jEquiv p A' F FK AK hgen x = EtPi1.jι (A := A') (A' := AK) (iotaK F FK).toAlgHom x := rfl

theorem coe_iota_symm (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (x : maxUnram A' F) :
    (((iota p A' F FK AK hgen).symm x : maxUnram AK FK) : AlgebraicClosure FK) = iotaK F FK x := rfl

theorem coe_iota (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (y : maxUnram AK FK) :
    ((iota p A' F FK AK hgen y : maxUnram A' F) : AlgebraicClosure F) = (iotaK F FK).symm y := by
  rw [AlgEquiv.eq_symm_apply, ← coe_iota_symm p A' F FK AK hgen, AlgEquiv.symm_apply_apply]

/-- `ι` is `phiFK` on `FK` (it fixes `F`, sends the constants of `FK` to constants of `F̄`). -/
theorem iota_algebraMap (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (c : FK) :
    ((iota p A' F FK AK hgen (algebraMap FK (maxUnram AK FK) c) : maxUnram A' F) : AlgebraicClosure F) =
      phiFK F FK c := by
  rw [coe_iota p A' F FK AK hgen, AlgEquiv.symm_apply_eq]
  exact (iotaK_phiFK F FK c).symm

variable (q : ℕ)

omit hp [IsDomain A'] [IsFractionRing A' F] [CharP F p] [Algebra.IsIntegral A' AK] in
theorem pi1Fun_mem_pi1geo_K (hq : ∃ e, 0 < e ∧ q = p ^ e)
    (hcl : ∀ x : AlgebraicClosure FK, IsConst p x → ∃ c : FK, algebraMap FK _ c = x) (σ : Pi1 AK FK) :
    EtPi1.pi1Fun (A := A') (A' := AK) (iotaK F FK).toAlgHom σ ∈ pi1geo A' F q := by
  refine (mem_pi1geo A' F q _).2 fun x hx => ?_
  obtain ⟨e, he, rfl⟩ := hq
  have hx' : IsConst p x := (isConst_pow_iff p he x).1 hx
  have hx2 : IsConst p (EtPi1.jι (A := A') (A' := AK) (iotaK F FK).toAlgHom x) :=
    hx'.map (EtPi1.jι (A := A') (A' := AK) (iotaK F FK).toAlgHom)
  obtain ⟨c, hc⟩ := hcl _ (hx2.map (maxUnram AK FK).val)
  have h1 : EtPi1.jι (A := A') (A' := AK) (iotaK F FK).toAlgHom x = algebraMap FK (maxUnram AK FK) c :=
    Subtype.ext hc.symm
  apply EtPi1.jι_injective (A := A') (A' := AK) (iotaK F FK).toAlgHom
  rw [EtPi1.pi1Fun_apply, h1, AlgEquiv.commutes]

/-- `π₁(AK) → π₁^geo(A')`, `σ ↦ ι σ ι⁻¹`. -/
def cmpHom (hq : ∃ e, 0 < e ∧ q = p ^ e)
    (hcl : ∀ x : AlgebraicClosure FK, IsConst p x → ∃ c : FK, algebraMap FK _ c = x) :
    Pi1 AK FK →* pi1geo A' F q :=
  (EtPi1.pi1Fun (A := A') (A' := AK) (iotaK F FK).toAlgHom).codRestrict (pi1geo A' F q)
    (pi1Fun_mem_pi1geo_K p A' F FK AK q hq hcl)

theorem cmpHom_injective (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (hq : ∃ e, 0 < e ∧ q = p ^ e)
    (hcl : ∀ x : AlgebraicClosure FK, IsConst p x → ∃ c : FK, algebraMap FK _ c = x) :
    Function.Injective (cmpHom p A' F FK AK q hq hcl) := fun σ τ h => by
  have h' := congrArg Subtype.val h
  refine AlgEquiv.ext fun y => ?_
  obtain ⟨x, rfl⟩ := jK_surjective p A' F FK AK hgen y
  rw [← EtPi1.pi1Fun_apply, ← EtPi1.pi1Fun_apply]
  exact congrArg _ (DFunLike.congr_fun h' x)

theorem cmpHom_coe (hq : ∃ e, 0 < e ∧ q = p ^ e)
    (hcl : ∀ x : AlgebraicClosure FK, IsConst p x → ∃ c : FK, algebraMap FK _ c = x) (σ : Pi1 AK FK) :
    (cmpHom p A' F FK AK q hq hcl σ : Pi1 A' F) = EtPi1.pi1Fun (A := A') (A' := AK) (iotaK F FK).toAlgHom σ :=
  rfl

omit hp [CharP F p] [Algebra.IsAlgebraic F FK] in
/-- Two `F`-algebra maps out of `FK` that agree on constants agree (`hgen`). -/
theorem algHom_ext_const (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) {M : Type} [Field M]
    [Algebra F M] {f g : FK →ₐ[F] M} (h : ∀ x : FK, IsConst p x → f x = g x) : f = g := by
  have hS : (⊤ : IntermediateField F FK) = adjoin F {x : FK | IsConst p x} :=
    (eq_top_iff.2 fun c _ => hgen c).symm
  have hfg : f.comp (topEquiv : (⊤ : IntermediateField F FK) ≃ₐ[F] FK).toAlgHom =
      g.comp (topEquiv : (⊤ : IntermediateField F FK) ≃ₐ[F] FK).toAlgHom :=
    algHom_ext_of_eq_adjoin F hS fun x hx => h x hx
  ext c
  exact DFunLike.congr_fun hfg ⟨c, mem_top⟩

/-- Conjugation `jι ∘ τ ∘ jι⁻¹` of `τ ∈ π₁(A')`. -/
def conjAlg (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (τ : Pi1 A' F) :
    maxUnram AK FK ≃ₐ[F] maxUnram AK FK :=
  ((jEquiv p A' F FK AK hgen).symm.trans τ).trans (jEquiv p A' F FK AK hgen)

theorem conjAlg_fix (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (τ : pi1geo A' F q)
    (hq : ∃ e, 0 < e ∧ q = p ^ e) (c : FK) :
    conjAlg p A' F FK AK hgen τ (algebraMap FK (maxUnram AK FK) c) = algebraMap FK (maxUnram AK FK) c := by
  obtain ⟨e, he, hqe⟩ := hq
  have key : (conjAlg p A' F FK AK hgen τ).toAlgHom.comp (IsScalarTower.toAlgHom F FK (maxUnram AK FK)) =
      IsScalarTower.toAlgHom F FK (maxUnram AK FK) := by
    refine algHom_ext_const p F FK hgen fun x hx => ?_
    have hc : IsConst p ((jEquiv p A' F FK AK hgen).symm (algebraMap FK (maxUnram AK FK) x)) :=
      ((show IsConst p x from hx).map (algebraMap FK (maxUnram AK FK))).map (jEquiv p A' F FK AK hgen).symm
    have hc' : IsConst q ((jEquiv p A' F FK AK hgen).symm (algebraMap FK (maxUnram AK FK) x)) := by
      rw [hqe]; exact isConst_pow_of e hc
    have hτ := (mem_pi1geo A' F q τ).1 τ.2 _ hc'
    show (jEquiv p A' F FK AK hgen) ((τ : Pi1 A' F) ((jEquiv p A' F FK AK hgen).symm
      (algebraMap FK (maxUnram AK FK) x))) = algebraMap FK (maxUnram AK FK) x
    rw [hτ, AlgEquiv.apply_symm_apply]
  exact DFunLike.congr_fun key c

/-- The preimage of `τ ∈ π₁^geo(A')`: `jι τ jι⁻¹`, `FK`-linear. -/
def conjPi1 (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (hq : ∃ e, 0 < e ∧ q = p ^ e)
    (τ : pi1geo A' F q) : Pi1 AK FK :=
  AlgEquiv.ofRingEquiv (f := (conjAlg p A' F FK AK hgen τ).toRingEquiv) (conjAlg_fix p A' F FK AK q hgen τ hq)

theorem cmpHom_surjective (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (hq : ∃ e, 0 < e ∧ q = p ^ e)
    (hcl : ∀ x : AlgebraicClosure FK, IsConst p x → ∃ c : FK, algebraMap FK _ c = x) :
    Function.Surjective (cmpHom p A' F FK AK q hq hcl) := fun τ => by
  refine ⟨conjPi1 p A' F FK AK q hgen hq τ, Subtype.ext ?_⟩
  rw [cmpHom_coe]
  refine (EtPi1.pi1Fun_eq_iff (A := A') (A' := AK) (iotaK F FK).toAlgHom _ _).2 fun y => ?_
  show _ = jEquiv p A' F FK AK hgen ((τ : Pi1 A' F) ((jEquiv p A' F FK AK hgen).symm
    (jEquiv p A' F FK AK hgen y)))
  rw [AlgEquiv.symm_apply_apply]
  rfl

/-- `cmp` as a group isomorphism. -/
def cmpEquiv (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (hq : ∃ e, 0 < e ∧ q = p ^ e)
    (hcl : ∀ x : AlgebraicClosure FK, IsConst p x → ∃ c : FK, algebraMap FK _ c = x) :
    Pi1 AK FK ≃* pi1geo A' F q :=
  MulEquiv.ofBijective (cmpHom p A' F FK AK q hq hcl)
    ⟨cmpHom_injective p A' F FK AK q hgen hq hcl, cmpHom_surjective p A' F FK AK q hgen hq hcl⟩

/-- **PI1-CMP**: `π₁(AK) ≃ₜ* π₁^geo(A')`, conjugation by `iota`. -/
def cmp (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (hq : ∃ e, 0 < e ∧ q = p ^ e)
    (hcl : ∀ x : AlgebraicClosure FK, IsConst p x → ∃ c : FK, algebraMap FK _ c = x) :
    Pi1 AK FK ≃ₜ* pi1geo A' F q :=
  have hc : Continuous (cmpEquiv p A' F FK AK q hgen hq hcl) :=
    (EtPi1.pi1Fun_continuous (A := A') (A' := AK) (iotaK F FK).toAlgHom).subtype_mk _
  have : T2Space (Pi1 A' F) := krullTopology_t2
  { cmpEquiv p A' F FK AK q hgen hq hcl with
    continuous_toFun := hc
    continuous_invFun :=
      (Continuous.homeoOfEquivCompactToT2 (f := (cmpEquiv p A' F FK AK q hgen hq hcl).toEquiv) hc).symm.continuous }

theorem cmp_coe (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (hq : ∃ e, 0 < e ∧ q = p ^ e)
    (hcl : ∀ x : AlgebraicClosure FK, IsConst p x → ∃ c : FK, algebraMap FK _ c = x) (σ : Pi1 AK FK) :
    (cmp p A' F FK AK q hgen hq hcl σ : Pi1 A' F) =
      EtPi1.pi1Fun (A := A') (A' := AK) (iotaK F FK).toAlgHom σ := rfl

/-- **`cmp_apply`**: `cmp g = ι ∘ g ∘ ι⁻¹`. -/
theorem cmp_apply (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (hq : ∃ e, 0 < e ∧ q = p ^ e)
    (hcl : ∀ x : AlgebraicClosure FK, IsConst p x → ∃ c : FK, algebraMap FK _ c = x) (σ : Pi1 AK FK)
    (x : maxUnram A' F) :
    (cmp p A' F FK AK q hgen hq hcl σ : Pi1 A' F) x =
      iota p A' F FK AK hgen (σ ((iota p A' F FK AK hgen).symm x)) := by
  rw [cmp_coe p A' F FK AK q hgen hq hcl]
  show _ = (jEquiv p A' F FK AK hgen).symm (σ (jEquiv p A' F FK AK hgen x))
  rw [AlgEquiv.eq_symm_apply]
  exact EtPi1.pi1Fun_apply _ σ x

end Cmp

end

end EtPi1Geo
