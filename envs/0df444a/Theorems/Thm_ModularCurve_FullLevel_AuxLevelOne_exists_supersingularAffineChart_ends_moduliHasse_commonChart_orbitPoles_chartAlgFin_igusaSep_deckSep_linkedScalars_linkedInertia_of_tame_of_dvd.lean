      (∃ (n : ℕ) (_ : 1 ≤ n) (_ : n ∣ q + 1) (γ₀ : SL(2, ℤ)) (_ : γ₀ ∈ CongruenceSubgroup.Gamma q) (_ : γ₀ ∈ CongruenceSubgroup.Gamma0 M')
