  rcases h with h | h | h
  · subst h
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
  · exact padeWritable_le_rootComputeWritable R U D C TB cap addr h
  · exact rootComputeWritable.of_TB h.1 h.2

theorem gcd_writable_le_root (R U D C TB cap addr : ℕ) (h : gcdProcedureWritable R U D C cap addr) :
    rootComputeWritable R U D C TB cap addr := by
