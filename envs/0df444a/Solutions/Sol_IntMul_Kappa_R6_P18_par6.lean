section
-- Source module: Solutions.R6P18Par
/-!
# Round six, Proposition 18: the numeric side conditions at the round-six parameters

`Par6 P Ew K₀ n` collects every numeric hypothesis of the Proposition 18 program (the frozen
`Par18Need` list with `D = d - 1`, `K = ℓ - 1`, `p = pP6`) together with the guard bound
`Ew D ≤ p + 2` and the three size hypotheses of `IL3.P14NeedH'` (constant `K₀`, at `D = d - 1`).
**`par6`**: they all hold for large `n` (for `P.Ok`, a guard with `EwOK6 P Ew`, any `K₀`).

Every condition is "polynomial in `b` below `2^K`" (**`big_K`**: `b ≤ (2ℓ)^m`), except the guard
(`ε C₁ < 1 + x`) and `P14NeedH'` (3) (`IL3.p14_hyps_r6`, i.e. `ε (2 - lamp) < 1`).
-/

set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.P18

open IntMul NLogN Real IntMul.Kappa.R6.IL3

noncomputable section

/-- A polynomial in `b` is eventually below `2^K` (`K = ℓ - 1`). -/
theorem big_K (P : Prm) (hP : P.Ok) (C j : ℕ) :
    ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → C * bP6 n ^ j < 2 ^ KP6 P n := by
  obtain ⟨n₀, hn₀⟩ := params6_ok P hP
  obtain ⟨S₀, hS₀⟩ := small_of_pow_le (C * 2 ^ (mExp P * j)) (mExp P * j)
  obtain ⟨n₂, hn₂⟩ := eventually_b_ge ((2 * S₀) ^ mExp P)
  refine ⟨max n₀ n₂, fun n hn => ?_⟩
  have hG := hn₀ n (le_of_max_le_left hn)
  have hl := ell_ge_of P hP hG S₀ (hn₂ n (le_of_max_le_right hn))
  have hbm := b_le_ell_pow P hP hG
  have h1 : bP6 n ^ j ≤ 2 ^ (mExp P * j) * (ℓP6 P n + 1) ^ (mExp P * j) := by
    calc bP6 n ^ j ≤ ((2 * ℓP6 P n) ^ mExp P) ^ j := Nat.pow_le_pow_left hbm j
      _ = 2 ^ (mExp P * j) * ℓP6 P n ^ (mExp P * j) := by rw [← pow_mul, mul_pow]
      _ ≤ 2 ^ (mExp P * j) * (ℓP6 P n + 1) ^ (mExp P * j) :=
          Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by omega) _)
  have h2 := hS₀ (ℓP6 P n) hl
  have hK : KP6 P n = ℓP6 P n - 1 := rfl
  rw [hK]
  have e : 6 * (C * 2 ^ (mExp P * j)) * (ℓP6 P n + 1) ^ (mExp P * j) =
      6 * (C * (2 ^ (mExp P * j) * (ℓP6 P n + 1) ^ (mExp P * j))) := by ring
  have h3 : C * bP6 n ^ j ≤ C * (2 ^ (mExp P * j) * (ℓP6 P n + 1) ^ (mExp P * j)) :=
    Nat.mul_le_mul_left _ h1
  omega

theorem sixteen_le (b : ℕ) (hb : 8 ≤ b) : 16 * b ≤ 2 ^ b := by
  induction b, hb using Nat.le_induction with
  | base => norm_num
  | succ k hk ih =>
    have : 16 ≤ 2 ^ k := le_trans (by norm_num) (Nat.pow_le_pow_right (by norm_num) (by omega :
      4 ≤ k))
    rw [pow_succ]; omega

/-- The guard is eventually below `b' = b^{1+x}` (`ε C₁ < 1 + x`). -/
theorem ew_small (P : Prm) (hP : P.Ok) {Ew : ℕ → ℕ} (hEw : EwOK6 P Ew) :
    ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ D, 1 ≤ D → D ≤ dP6 P n → Ew D ≤ b'P6 P n := by
  obtain ⟨C, hC⟩ := hEw
  set g : ℝ := 1 + (P.x : ℝ) - P.ε * (P.C1 : ℝ) with hg
  have hg0 : 0 < g := by have := hP.eps_C1; rw [hg]; linarith
  obtain ⟨n₂, hn₂⟩ := eventually_b_ge (C ^ ⌈1 / g⌉₊ + 1)
  refine ⟨n₂, fun n hn D hD1 hDd => ?_⟩
  have hbC := hn₂ n hn
  set b := bP6 n with hb
  have hb1n : 1 ≤ b := bP6_pos n
  have hb1 : (1 : ℝ) ≤ b := by exact_mod_cast hb1n
  have hb0 : (0 : ℝ) ≤ b := by linarith
  -- `C ≤ b^g`
  have hCf : C ≤ ⌊(b : ℝ) ^ g⌋₊ := by
    by_contra h
    push_neg at h
    have h1 := b_le_floor_pow hg0 hb1n
    have h2 : (⌊(b : ℝ) ^ g⌋₊ + 1) ^ ⌈1 / g⌉₊ ≤ C ^ ⌈1 / g⌉₊ := Nat.pow_le_pow_left (by omega) _
    omega
  have hCg : (C : ℝ) ≤ (b : ℝ) ^ g :=
    le_trans (by exact_mod_cast hCf) (Nat.floor_le (Real.rpow_nonneg hb0 _))
  -- `D^C₁ ≤ b^{ε C₁}`
  have hDb : (D : ℝ) ≤ (b : ℝ) ^ P.ε :=
    le_trans (by exact_mod_cast hDd) (d_le_beps P n)
  have h1 : ((D ^ P.C1 : ℕ) : ℝ) ≤ (b : ℝ) ^ (P.ε * (P.C1 : ℝ)) := by
    rw [Nat.cast_pow, Real.rpow_mul hb0, Real.rpow_natCast]
    exact pow_le_pow_left₀ (Nat.cast_nonneg _) hDb _
  have h2 : (C : ℝ) * ((D ^ P.C1 : ℕ) : ℝ) ≤ (b : ℝ) ^ g * (b : ℝ) ^ (P.ε * (P.C1 : ℝ)) :=
    mul_le_mul hCg h1 (Nat.cast_nonneg _) (Real.rpow_nonneg hb0 _)
  have h3 : (b : ℝ) ^ g * (b : ℝ) ^ (P.ε * (P.C1 : ℝ)) = ((b ^ (1 + P.x) : ℕ) : ℝ) := by
    rw [← Real.rpow_add (by linarith), show g + P.ε * (P.C1 : ℝ) = ((1 + P.x : ℕ) : ℝ) by
      rw [hg]; push_cast; ring, Real.rpow_natCast]
    norm_cast
  have h4 : (Ew D : ℝ) ≤ ((b ^ (1 + P.x) : ℕ) : ℝ) := by
    have := hC D hD1
    have h5 : (Ew D : ℝ) ≤ ((C * D ^ P.C1 : ℕ) : ℝ) := by exact_mod_cast this
    push_cast at h5 h2 h3 ⊢
    linarith
  exact_mod_cast h4

/-- `3 ≤ d` once `b ≥ 36`. -/
theorem d_ge_three (P : Prm) (hP : P.Ok) {n : ℕ} (hG : Good P n) (hb : 36 ≤ bP6 n) :
    3 ≤ dP6 P n := by
  have hb1 : (1 : ℝ) ≤ bP6 n := by exact_mod_cast (show 1 ≤ bP6 n by omega)
  have h1 : (bP6 n : ℝ) ^ ((1 : ℝ) / 2) ≤ (bP6 n : ℝ) ^ P.ε :=
    Real.rpow_le_rpow_of_exponent_le hb1 hP.eps_ge
  have h36 : (36 : ℝ) ^ ((1 : ℝ) / 2) = 6 := by
    rw [show (36 : ℝ) = 6 ^ (2 : ℝ) by rw [Real.rpow_two]; norm_num, ← Real.rpow_mul (by norm_num)]
    norm_num
  have h2 : (36 : ℝ) ^ ((1 : ℝ) / 2) ≤ (bP6 n : ℝ) ^ ((1 : ℝ) / 2) :=
    Real.rpow_le_rpow (by norm_num) (by exact_mod_cast hb) (by norm_num)
  have h3 := hG.d_ge
  have : (3 : ℝ) ≤ dP6 P n := by linarith
  exact_mod_cast this

/-- `P14NeedH'` (3) at `D = d - 1` from the same condition at `d` with `2 K₀`. -/
theorem n3_pred (P : Prm) (hP : P.Ok) {K₀ K d z : ℕ} (hd : 2 ≤ d)
    (h : ((2 * K₀ * d * z : ℕ) : ℝ) ≤ K * (d : ℝ) ^ P.lamp) :
    ((K₀ * (d - 1) * z : ℕ) : ℝ) ≤ K * ((d - 1 : ℕ) : ℝ) ^ P.lamp := by
  have hl0 : 0 ≤ P.lamp := by have := hP.tau_lt_lamp; have := hP.tau_pos; linarith
  have hl1 : P.lamp ≤ 1 := hP.lamp_lt.le
  have hD : (d : ℝ) ≤ 2 * ((d - 1 : ℕ) : ℝ) := by
    have : d ≤ 2 * (d - 1) := by omega
    exact_mod_cast this
  have h1 : (d : ℝ) ^ P.lamp ≤ 2 * ((d - 1 : ℕ) : ℝ) ^ P.lamp := by
    calc (d : ℝ) ^ P.lamp ≤ (2 * ((d - 1 : ℕ) : ℝ)) ^ P.lamp :=
          Real.rpow_le_rpow (Nat.cast_nonneg _) hD hl0
      _ = (2 : ℝ) ^ P.lamp * ((d - 1 : ℕ) : ℝ) ^ P.lamp :=
          Real.mul_rpow (by norm_num) (Nat.cast_nonneg _)
      _ ≤ 2 * ((d - 1 : ℕ) : ℝ) ^ P.lamp := by
          apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg (Nat.cast_nonneg _) _)
          calc (2 : ℝ) ^ P.lamp ≤ (2 : ℝ) ^ (1 : ℝ) :=
                Real.rpow_le_rpow_of_exponent_le (by norm_num) hl1
            _ = 2 := Real.rpow_one 2
  have h2 : ((K₀ * (d - 1) * z : ℕ) : ℝ) ≤ ((2 * K₀ * d * z : ℕ) : ℝ) / 2 := by
    have : K₀ * (d - 1) * z ≤ K₀ * d * z := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ (by omega))
    have e : ((2 * K₀ * d * z : ℕ) : ℝ) / 2 = ((K₀ * d * z : ℕ) : ℝ) := by push_cast; ring
    rw [e]; exact_mod_cast this
  have hK0 : (0 : ℝ) ≤ K := Nat.cast_nonneg _
  have h3 := mul_le_mul_of_nonneg_left h1 hK0
  linarith

/-- **The side conditions hold for all large `n`.** -/
theorem par6_sol_aux (P : Prm) (hP : P.Ok) {Ew : ℕ → ℕ} (hEw : EwOK6 P Ew) (K₀ : ℕ) :
    ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → Par6 P Ew K₀ n := by
  obtain ⟨m1, H1⟩ := p14_hyps_r6 P hP K₀
  obtain ⟨m2, H2⟩ := p14_hyps_r6 P hP (2 * K₀)
  obtain ⟨m3, H3⟩ := ew_small P hP hEw
  obtain ⟨m4, H4⟩ := eventually_b_ge 64
  obtain ⟨m5, H5⟩ := big_K P hP 2400 2
  obtain ⟨m6, H6⟩ := big_K P hP 13 (1 + P.x)
  obtain ⟨m7, H7⟩ := big_K P hP 2663 3
  obtain ⟨m8, H8⟩ := big_K P hP 18 2
  obtain ⟨m9, H9⟩ := big_K P hP (NLogN.KFV.P18M.Cu * 33 ^ 6) (6 * (1 + P.x))
  refine ⟨m1 + m2 + m3 + m4 + m5 + m6 + m7 + m8 + m9, fun n hn => ?_⟩
  obtain ⟨hG, hK6, hn1, hn2, hn3⟩ := H1 n (by omega)
  obtain ⟨-, -, -, -, hn3'⟩ := H2 n (by omega)
  have hb := H4 n (by omega)
  have h5 := H5 n (by omega)
  have h6 := H6 n (by omega)
  have h7 := H7 n (by omega)
  have h8 := H8 n (by omega)
  have h9 := H9 n (by omega)
  have hd3 : 3 ≤ dP6 P n := d_ge_three P hP hG (by omega)
  have hdb := hG.d_le_b
  have hdl := hG.dℓ_le
  have hLb := hG.L_le
  have hl1 := hG.ell_pos
  have hKl : KP6 P n + 1 = ℓP6 P n := by
    have : KP6 P n = ℓP6 P n - 1 := rfl
    omega
  have hsq := b'_ge_sq P hP n
  have hy1 : 1 ≤ b'P6 P n := b'P6_pos P n
  have hp : pP6 P n = 6 * b'P6 P n := rfl
  have hy : b'P6 P n = bP6 n ^ (1 + P.x) := rfl
  set b := bP6 n with hbdef
  set d := dP6 P n with hddef
  set ℓ := ℓP6 P n with hℓdef
  set K := KP6 P n with hKdef
  set y := b'P6 P n with hydef
  have hdl2 : d * ℓ ≤ 2 * b := by omega
  have hDl : (d - 1) * ℓ ≤ d * ℓ := Nat.mul_le_mul_right _ (by omega)
  have hlD : ℓ ≤ d * ℓ := Nat.le_mul_of_pos_left _ (by omega)
  have hby : b ≤ y := by
    have : b ≤ b ^ 2 := Nat.le_self_pow (by norm_num) _
    omega
  have hKl' : K ≤ ℓ := by omega
  have h2K : 2 ^ K ≤ 2 ^ ℓ := Nat.pow_le_pow_right (by norm_num) hKl'
  set Zm := (d - 1) * ℓ + ℓ + 8 with hZm
  have hZ : Zm ≤ 5 * b := by omega
  have hb16 : 16 * b ≤ 2 ^ b := sixteen_le b (by omega)
  refine ⟨hG, hb, hd3, hK6, hKl, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hby, ?_, hn1, hn2, ?_⟩
  all_goals try simp only [← hbdef, ← hddef, ← hℓdef, ← hKdef, ← hydef]
  all_goals try simp only [← hZm]
  · -- c3
    have a1 : 80 * Zm * (Zm + 2) ≤ 80 * (5 * b) * (6 * b) :=
      Nat.mul_le_mul (Nat.mul_le_mul_left _ hZ) (by omega)
    have a2 : 80 * (5 * b) * (6 * b) = 2400 * b ^ 2 := by ring
    omega
  · -- p7
    have : 2 * pP6 P n + 7 ≤ 13 * b ^ (1 + P.x) := by
      rw [hp, ← hy]; omega
    omega
  · -- c8
    have a1 : 2 * Zm + 4 ≤ 11 * b := by omega
    have a2 : (2 * Zm + 4) ^ 3 ≤ (11 * b) ^ 3 := Nat.pow_le_pow_left a1 3
    have a3 : (11 * b) ^ 3 = 1331 * b ^ 3 := by ring
    have a4 : 1 ≤ b ^ 3 := Nat.one_le_pow _ _ (by omega)
    omega
  · -- c9
    have a0 : K * (d - 1) ≤ d * ℓ := by
      have : K * (d - 1) ≤ ℓ * d := Nat.mul_le_mul hKl' (by omega)
      rw [Nat.mul_comm ℓ d] at this; exact this
    have a1 : (K * (d - 1) + 11) * (Zm + 2) ≤ (3 * b) * (6 * b) :=
      Nat.mul_le_mul (by omega) (by omega)
    have a2 : (3 * b) * (6 * b) = 18 * b ^ 2 := by ring
    omega
  · -- ov
    intro B hB
    have a1 : B ≤ 15 * y := by omega
    have a2 := NLogN.KFV.P18M.cU_le B
    have a3 : (2 * B + 3) ^ 6 ≤ (33 * y) ^ 6 := Nat.pow_le_pow_left (by omega) 6
    have a4 : (33 * y) ^ 6 = 33 ^ 6 * b ^ (6 * (1 + P.x)) := by
      rw [mul_pow, hy, ← pow_mul, Nat.mul_comm (1 + P.x) 6]
    have a5 : NLogN.KFV.P18M.Cu * (2 * B + 3) ^ 6 ≤ NLogN.KFV.P18M.Cu * 33 ^ 6 * b ^ (6 * (1 + P.x)) := by
      rw [Nat.mul_assoc, ← a4]; exact Nat.mul_le_mul_left _ a3
    omega
  · -- err
    have a1 : 2 * (3 * ℓ + 1) ≤ 2 ^ b := by omega
    have a2 : 2 ^ ((d - 1) * ℓ) ≤ 2 ^ (2 * b) := Nat.pow_le_pow_right (by norm_num) (by omega)
    have a3 : 2 * 2 ^ ((d - 1) * ℓ) * (3 * ℓ + 1) ≤ 2 ^ b * 2 ^ (2 * b) := by
      calc 2 * 2 ^ ((d - 1) * ℓ) * (3 * ℓ + 1) = 2 * (3 * ℓ + 1) * 2 ^ ((d - 1) * ℓ) := by ring
        _ ≤ 2 ^ b * 2 ^ (2 * b) := Nat.mul_le_mul a1 a2
    have a4 : 2 ^ b * 2 ^ (2 * b) ≤ 2 ^ (pP6 P n / 2) := by
      rw [← pow_add]; exact Nat.pow_le_pow_right (by norm_num) (by rw [hp]; omega)
    omega
  · -- Dl
    omega
  · -- ew
    exact H3 n (by omega) (d - 1) (by omega) (by omega)
  · -- n3
    exact n3_pred P hP (K₀ := K₀) (K := K) (d := d) (by omega) hn3'

end

end IntMul.Kappa.R6.P18

