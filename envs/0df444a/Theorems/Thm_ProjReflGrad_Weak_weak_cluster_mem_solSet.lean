-- title:
--   (3.7), proof of Theorem 3.2, p. 6 — every weak cluster point of a run lies in S
-- statement:
--   Under the assumptions of Theorem 3.2, let $(x_n),(y_n)$ be generated by Algorithm 3.1. If a subsequence $(x_{n_i})$ converges weakly to some $x^*\in H$, then $x^*\in S$, i.e.
--   $$x^*\in C\quad\text{and}\quad\langle F(x^*),x-x^*\rangle\ge0\qquad\forall x\in C .$$
--
--   Together with the convergence of the perturbed distances to solutions, this is one of the two ingredients of the Opial-type argument that concludes the proof of Theorem 3.2.
--
--   **Formalization Note.** A subsequence is $x\circ\varphi$ with $\varphi:\mathbb N\to\mathbb N$ strictly increasing.
-- source:
--   Malitsky, Projected Reflected Gradient Methods for Monotone Variational Inequalities, arXiv:1502.04968v1, p. 6, (3.7), proof of Theorem 3.2

import Mathlib
import Definitions.Def_ProjReflGrad_Weak_Setting

namespace ProjReflGrad.Weak

/-- Proof of Theorem 3.2, (3.7) and its conclusion (Malitsky 2015, p. 6): every weak cluster
point of a run of Algorithm 3.1 lies in the solution set `S`. -/
theorem weak_cluster_mem_solSet {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H]
    (C : Set H) (hCcl : IsClosed C) (hCcv : Convex ℝ C) (F : H → H) (L lam : ℝ)
    (hC1 : (solSet C F).Nonempty) (hC2 : IsMonotoneMap F) (hL : 0 < L) (hC3 : IsLipschitzMap F L)
    (hlam0 : 0 < lam) (hlam1 : lam < (Real.sqrt 2 - 1) / L)
    (x y : ℕ → H) (hrun : IsPRGRun C F lam x y) :
    ∀ φ : ℕ → ℕ, StrictMono φ → ∀ xs : H, IsWeakLimit (x ∘ φ) xs → xs ∈ solSet C F := by sorry

end ProjReflGrad.Weak
