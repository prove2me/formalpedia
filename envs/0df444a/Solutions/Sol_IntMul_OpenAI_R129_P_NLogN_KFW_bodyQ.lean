    (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ)) (F w : ℕ)
    (hC : Clean0 f) (h0 : f 0 = gflat zs ++ l) (hx : RecRep r F zs xs) (hl : xs.length = n)
    (hb : NLogN.KFB.GB w zs) (hlo : lo ≤ w) (hhi : w + dw ≤ hi) :
    ∃ zs', RecRep r (F + e) zs' (selOpF st n T xs) ∧ NLogN.KFB.GB (w + dw) zs' ∧
      RunQ I iprog σ U f (Function.update f 0 (gflat zs' ++ l)) (cost w) := by
  obtain ⟨zs0, r0, b0, -⟩ := H (KFW.stOf σ) f zs l xs F w (agree_stOf σ) hC h0 hx hl hb hlo hhi
  refine ⟨zs0, r0, b0, fun s hs => ?_⟩
  obtain ⟨zs1, r1, b1, f1⟩ := H s f zs l xs F w hs hC h0 hx hl hb hlo hhi
  rw [recRep_uniq r1 r0] at f1
  exact f1

