theorem kcB_kk' (H b : ℕ) (hH : 1 ≤ H) : J6A.kcB H (J6A.kkA H b) = b * (2 * H) + H := by
  unfold J6A.kcB J6A.kkA
  rw [Nat.mul_div_cancel _ (by omega)]

theorem posE_cast (s t : ℕ) (e : ℤ) (he : -(s : ℤ) ≤ e) :
    ((J6A.posE s t e : ℕ) : ℤ) =
      if e < 0 then (s : ℤ) + e else if e - s < 0 then (t : ℤ) + e else 2 * t + e - s := by
  unfold J6A.posE
  split_ifs with h1 h2 h3 h3 <;> push_cast <;> omega

theorem posEE_val (s t : ℕ) (e : ℤ) (he : -(s : ℤ) ≤ e) :
    (if e < 0 then (s : ℤ) + e else if e + -(s : ℤ) < 0 then (t : ℤ) + e
      else (t : ℤ) + t + e + -(s : ℤ)) = ((J6A.posE s t e : ℕ) : ℤ) := by
  rw [posE_cast s t e he]
  split_ifs <;> omega

