  | seq a b, s => by
    simp only [NLogN.RS.run]
    exact ⟨(run_ip_out b _).1.trans (run_ip_out a s).1, (run_ip_out b _).2.trans (run_ip_out a s).2⟩
  | ite c a b, s => by
    simp only [NLogN.RS.run]; split_ifs
    · exact run_ip_out a s
    · exact run_ip_out b s
