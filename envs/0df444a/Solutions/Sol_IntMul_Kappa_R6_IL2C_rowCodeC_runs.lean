  have r24 : t4.G kR2 = .int ((2 ^ (e % K) : ℕ) : ℤ) :: t3.G kR2 := by
    rw [T4 kR2 (.reg mR2) (by simp [hdrC]), eR23.ev]
  have o4 : ∀ x, x ∉ hdrC.map Prod.fst → ∀ {v : ℤ} {L : List Item}, t3.G x = .int v :: L →
      ∃ L, t4.G x = .int v :: L := fun x hx v L h => ⟨L, by rw [T4' x hx, h]⟩
  have hsx := strd_row (B := B) (T := T) (r := r) hp hij
  have hCE : CEnv t4 l K (e % K) G (F - 1) (e % K + (F - 1) * K) (r * (2 * (H + 1)))
