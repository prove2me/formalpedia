    | linear_combination ((2*M*a^3*r*s^2*S*D + a^5*s^2*c^2*S*D + a^3*r^2*s^2*S*D)) * hp + ((-2*M*a*r*s^2*D - a^3*s^4*D - a^3*s^2*c^2*D + a^3*s^2*D)) * hSi + ((a*s^2)) * hDi
    | linear_combination ((a^2*s^2)) * hp + (0) * hSi + (0) * hDi
