open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
variable {V : Set (Pt 4)} {g g' ginv ginv' h h' : Metric 4} {F F' f f' : TwoForm 4}
theorem solution (hV : IsOpen V) (hg : ∀ i j, Set.EqOn (g i j) (g' i j) V)
    (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) V) (hF : ∀ i j, Set.EqOn (F i j) (F' i j) V)
    (hh : ∀ i j, Set.EqOn (h i j) (h' i j) V) (hf : ∀ i j, Set.EqOn (f i j) (f' i j) V)
    {x : Pt 4} (hx : x ∈ V) (a b : Fin 4) :
    linEinstein g ginv F h f a b x = linEinstein g' ginv' F' h' f' a b x := by
  have e0 : ∀ i j, g i j x = g' i j x := fun i j => hg i j hx
  have e1 : ∀ i j, ginv i j x = ginv' i j x := fun i j => hgi i j hx
  have e2 : ∀ i j, h i j x = h' i j x := fun i j => hh i j hx
  have e3 : ∀ i j, F i j x = F' i j x := fun i j => hF i j hx
  have e4 : ∀ i j, f i j x = f' i j x := fun i j => hf i j hx
  have e5 : ∀ i j, ricciVar g ginv h i j x = ricciVar g' ginv' h' i j x :=
    fun i j => ricciVar_congr hV hg hgi hh i j hx
  have e6 := ricciScalar_congr hV hg hgi hx
  have e7 := scalarVar_congr hV hg hgi hh hx
  have e8 : ∀ a b, raise2 ginv F a b x = raise2 ginv' F' a b x := fun a b => raise2_congr hgi hF a b hx
  have e9 : ∀ a b, raise2Var ginv h F f a b x = raise2Var ginv' h' F' f' a b x :=
    fun a b => raise2Var_congr hgi hh hF hf a b hx
  simp only [linEinstein, emStressVar, fieldSqVar, fieldSq, invVar, e0, e1, e2, e3, e4, e5, e6, e7, e8, e9]
