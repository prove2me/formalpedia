theorem ModularCurve.full_sq_mul_prime_eq_adjoin (p ℓ : ℕ) [hp : Fact (Nat.Prime p)] [hl : Fact (Nat.Prime ℓ)] (hpl : p ≠ ℓ) : modularFunctionFieldFull (p * p * ℓ) = IntermediateField.adjoin ℚ ({jq, jqN ℓ, jqN p, jqN (p * p)} : Set (LaurentSeries ℚ)) := by sorry
