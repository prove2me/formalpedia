          ∃ m : ↥(cornerSubmodule (M := M) (Sp.e i)), w = a • m}) = ⊤) :
    Submodule.span B ({x, y} : Set ↥(cornerSubmodule (M := M) (Sp.e i))) = ⊤ := by
  set N' : Submodule B ↥(cornerSubmodule (M := M) (Sp.e i)) :=
    Submodule.span B ({x, y} : Set ↥(cornerSubmodule (M := M) (Sp.e i))) with hN'
  set 𝔫 : Ideal B := nIdeal Sp i χ with h𝔫

  set Q : Submodule B ↥(cornerSubmodule (M := M) (Sp.e i)) := N' ⊔ 𝔫 • ⊤ with hQ

  let QA : Submodule (Sp.CornerRing i) ↥(cornerSubmodule (M := M) (Sp.e i)) :=
    { carrier := Q
      add_mem' := fun ha hb => Q.add_mem ha hb
      zero_mem' := Q.zero_mem
      smul_mem' := fun a z hz => by
        show a • z ∈ Q
        have : a • z = (a : B) • z := rfl
