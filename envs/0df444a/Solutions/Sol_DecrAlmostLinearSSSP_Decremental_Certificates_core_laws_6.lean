    (hv : s.natReg 626 = v) (hs : s.natReg 578 = sampleAddress) (hne : sampleAddress ≠ v)
    (hr : s.realReg 616 = r) (hzn : s.natReg 56 = 0) (hz : s.realReg 56 = 0)
    (hq : s.realReg 502 = Q b) (hh : s.realReg 534 = H b/2)
    (hf : s.realReg 518 = (1+b.input.accuracy/2)*Q b) :
    ∃ cost t, Eval code s cost t ∧ cost ≤ 11 ∧
      stored t.machine v = readout b r ∧ t.realMem sampleAddress = r ∧
      t.natMem v ≤ 1 ∧ (t.natMem v = 0 → 0 ≤ t.realMem v) ∧
      (∀ j, j ≠ v → t.natMem j = s.natMem j) ∧
      (∀ j, j ≠ v → j ≠ sampleAddress → t.realMem j = s.realMem j) := by
  let a : Data := {s with realMem := Function.update s.realMem (s.natReg 578) (s.realReg 616)}
  let u : Data := {a with natReg := Function.update a.natReg 620 (a.natReg 626+a.natReg 56)}
  have ha := eval_store s 578 616
  have hu := eval_nadd a 620 626 56
  have hu620 : u.natReg 620 = v := by simp [u,a,hv,hzn]
  obtain ⟨co,t,ht,hco,hto,htn,htpos,htframe⟩ := CoreOutput.eval_code b u v r hu620 hr hz hq hh hf
  refine ⟨1+(1+co),t,Eval.seq ha (Eval.seq hu ht),by omega,hto,?_,htn,htpos,?_,?_⟩
  · rw [(htframe sampleAddress hne).2]
    simp [u,a,hs,hr]
  · intro j hj
    exact (htframe j hj).1
  · intro j hj hjs
    rw [(htframe j hj).2]
    simp [u,a,hs,Function.update_of_ne hjs]
