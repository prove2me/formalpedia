theorem GlobalTheory.SW.UnitaryLeft.expo_mul {h : Matrix (Fin n) (Fin n) E} (hh : ccT h * h = 1)
    (x : Matrix (Fin n) (Fin N) E) (Z : CM Ψ N N) (z z' : CM Ψ n N) :
