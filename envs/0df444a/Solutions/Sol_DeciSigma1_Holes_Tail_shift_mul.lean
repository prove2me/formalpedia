theorem _root_.solution {f : ℕ → α} {A h : ℕ} (hper : ∀ p, A ≤ p → f (p + h) = f p) :
    ∀ j p, A ≤ p → f (p + j * h) = f p := by
  intro j
  induction j with
  | zero => intro p _; simp
  | succ j ih =>
    intro p hp
    rw [show p + (j + 1) * h = (p + j * h) + h by ring, hper _ (by nlinarith), ih p hp]
end DeciSigma1.Holes.Tail
