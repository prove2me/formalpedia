open OAI OAI.Release075 OAI.Release075.PermCycles
open Equiv
attribute [local instance] Classical.propDecidable Classical.decEq
variable {A : Type*} [Fintype A]

theorem OAI.Release075.PermCycles.PlanarMap.swap_left {f g : Perm A} (hp : PlanarMap f g) {a b : A}
    (hab : f.SameCycle a b) : PlanarMap (Equiv.swap a b * f) g := by sorry
