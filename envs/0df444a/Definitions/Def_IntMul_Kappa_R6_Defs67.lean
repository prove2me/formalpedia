-- Source module: Solutions.J6AIL16
/-!
# A lines, IL side 16: the prologues of the gather and compress slab set-ups

* `gP1 X = initP; parAX X; 12 := 8 (M · 8H); 7 := 4 (8 t); gthP 3 4 8 9 10 11 12`
  (**`gP1_sp`**): the gather source table `srcTab (srcG s t H W M 8H) 0 n'` on `44`,
  `n = 32 t` on `7`, `n' = 8 (M · 8H)` on `12`;
* `cP1 X = initP; parAX X; 7 := (M · 8) · 8H; cmpP 8 11 4` (**`cP1_sp`**): the compress source
  table `srcTab (srcC H 8H) 0 t` on `44`, `n = M · 8 · 8H` on `7`, `n' = t` on `4`.

Here `H = HH p α`, `W = WA p α H`, `M = t / 16H` (the registers of `parAX`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6A.SL

open IntMul NLogN NLogN.KIL Function RS J6Seg.PJ J6A.PA J6A.ST IntMul.HvdH
open J6Seg.Slab (srcTab flatC)
open J6Seg.Src (uC DD)

/-- `8 (M · 8H)`. -/
def nPG : Ex HS := .mul (.lit 8) (.mul (.reg 10) (.reg 11))
/-- `4 (8 t)`. -/
def nG : Ex HS := .mul (.lit 4) (.mul (.lit 8) (.reg 4))
/-- `(M · 8) · 8H`. -/
def nC : Ex HS := .mul (.mul (.reg 10) (.lit 8)) (.reg 11)

/-- **The gather prologue.** -/
def gP1 (X : Fin HS) : RS :=
  .seq (initP rg) (.seq (parAX X) (.seq (.asg 12 nPG) (.seq (.asg 7 nG)
    (J6A.ST.gthP 3 4 8 9 10 11 12))))

/-- **The compress prologue.** -/
def cP1 (X : Fin HS) : RS :=
  .seq (initP rg) (.seq (parAX X) (.seq (.asg 7 nC) (J6A.ST.cmpP 8 11 4)))

/-- Gather prologue cost. -/
def cG1 (W p m n' : ℕ) : ℕ :=
  (21 * 8001 + 1) + (cParA W p m + (J6Seg.PJ.cT nPG W + (J6Seg.PJ.cT nG W +
    (n' + 1) * (303 * uC W 32 + uC W DD))))

/-- Compress prologue cost. -/
def cC1 (W p m t : ℕ) : ℕ :=
  (21 * 8001 + 1) + (cParA W p m + (J6Seg.PJ.cT nC W + (t + 1) * (203 * uC W 32 + uC W DD)))

end J6A.SL

end

