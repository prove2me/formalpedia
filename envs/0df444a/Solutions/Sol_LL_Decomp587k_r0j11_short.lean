          cellSet .tri12 ((m : ℝ) / D_den) ((x0b : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) := by
        intro x hx
