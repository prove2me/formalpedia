variable (A : Type uA) [CommRing A] [IsDomain A] [CharZero A] [IsLocalRing A]
  {p : ℕ} (hp : p.Prime) (k : ℕ)
  (hmax : IsLocalRing.maximalIdeal A = Ideal.span {(p : A)})

include hp hmax

