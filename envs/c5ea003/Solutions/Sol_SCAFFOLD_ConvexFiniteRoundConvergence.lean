section SCAFFOLDBundleModule6
/-!
Energy bookkeeping for SCAFFOLD finite-round convergence, Appendix E.1,
PDF pp. 30-31, Lemma 15, and E.2, PDF pp. 34-35, Lemma 19.
The nonconvex coefficient 4 belongs to the repaired intermediate recurrence;
the published finite-round theorem has the same constants 14 and 70.
-/

noncomputable section
open MeasureTheory
namespace SCAFFOLD

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

def distanceEnergy (A : Run P ν S K T ηl ηg init) (xstar : Space d) (r : ℕ) : ℝ :=
  ∫ ω, ‖A.x r ω - xstar‖ ^ 2 ∂ν

def gradientEnergy (A : Run P ν S K T ηl ηg init) (r : ℕ) : ℝ :=
  ∫ ω, ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 ∂ν

def objectiveEnergy (A : Run P ν S K T ηl ηg init) (r : ℕ) : ℝ :=
  ∫ ω, objective P.f (A.x r ω) ∂ν

def convexPotential (A : Run P ν S K T ηl ηg init) (xstar : Space d) (r : ℕ) : ℝ :=
  distanceEnergy A xstar r +
    9 * (N : ℝ) * (effectiveStep K ηl ηg) ^ 2 / (S : ℝ) * controlEnergy A xstar r

def nonconvexPotential (A : Run P ν S K T ηl ηg init) (r : ℕ) : ℝ :=
  objectiveEnergy A r + 4 * P.β ^ 3 * (effectiveStep K ηl ηg) ^ 2 /
    ((S : ℝ) / (N : ℝ)) * lagEnergy A r

theorem distanceEnergy_nonneg (A : Run P ν S K T ηl ηg init) (xstar : Space d) (r : ℕ) :
    0 ≤ distanceEnergy A xstar r := integral_nonneg (fun _ ↦ sq_nonneg _)

theorem gradientEnergy_nonneg (A : Run P ν S K T ηl ηg init) (r : ℕ) :
    0 ≤ gradientEnergy A r := integral_nonneg (fun _ ↦ sq_nonneg _)

theorem convexPotential_nonneg (A : Run P ν S K T ηl ηg init) (xstar : Space d) (r : ℕ) :
    0 ≤ convexPotential A xstar r :=
  add_nonneg (distanceEnergy_nonneg A xstar r)
    (mul_nonneg (by positivity) (controlEnergy_nonneg A xstar r))

theorem Run.distanceEnergy_initial (A : Run P ν S K T ηl ηg init) (xstar : Space d) :
    distanceEnergy A xstar 0 = ‖P.x0 - xstar‖ ^ 2 := by
  have heq : (fun ω ↦ ‖A.x 0 ω - xstar‖ ^ 2) =ᵐ[ν] fun _ ↦ ‖P.x0 - xstar‖ ^ 2 :=
    A.initial_x.fun_comp (fun x ↦ ‖x - xstar‖ ^ 2)
  simp only [distanceEnergy, integral_congr_ae heq, integral_const, probReal_univ,
    smul_eq_mul, one_mul]

theorem Run.objectiveEnergy_initial (A : Run P ν S K T ηl ηg init) :
    objectiveEnergy A 0 = objective P.f P.x0 := by
  have heq : (fun ω ↦ objective P.f (A.x 0 ω)) =ᵐ[ν] fun _ ↦ objective P.f P.x0 :=
    A.initial_x.fun_comp (objective P.f)
  simp only [objectiveEnergy, integral_congr_ae heq, integral_const, probReal_univ,
    smul_eq_mul, one_mul]

theorem Run.convexPotential_initial {c0 : Fin N → Space d}
    (A : Run P ν S K T ηl ηg (some c0)) (xstar : Space d) :
    convexPotential A xstar 0 = initialPotential P S (effectiveStep K ηl ηg) c0 xstar := by
  rw [convexPotential, A.distanceEnergy_initial, A.controlEnergy_initial]
  rfl

theorem Run.nonconvexPotential_initial (A : Run P ν S K T ηl ηg init) :
    nonconvexPotential A 0 = objective P.f P.x0 := by
  rw [nonconvexPotential, A.objectiveEnergy_initial, A.lagEnergy_initial, mul_zero, add_zero]

theorem Run.objectiveEnergy_lower (A : Run P ν S K T ηl ηg init) {r : ℕ} (hr : r ≤ T)
    {fLower : ℝ} (hl : ∀ x, fLower ≤ objective P.f x) : fLower ≤ objectiveEnergy A r := by
  have h := integral_mono (integrable_const fLower)
    (P.objective_integrable_comp (A.x_memLp r hr)) (fun ω ↦ hl (A.x r ω))
  simpa only [integral_const, probReal_univ, smul_eq_mul, one_mul] using h

theorem Run.nonconvexPotential_lower (A : Run P ν S K T ηl ηg init) {r : ℕ} (hr : r ≤ T)
    {fLower : ℝ} (hl : ∀ x, fLower ≤ objective P.f x) :
    fLower ≤ nonconvexPotential A r := by
  have hb := P.smoothness_pos.le
  exact (A.objectiveEnergy_lower hr hl).trans (le_add_of_nonneg_right
    (mul_nonneg (by positivity) (lagEnergy_nonneg A r)))

theorem Run.expectedGap_eq_objectiveEnergy_sub (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r ≤ T) (xstar : Space d) :
    expectedGap A xstar r = objectiveEnergy A r - objective P.f xstar := by
  rw [expectedGap, integral_sub (P.objective_integrable_comp (A.x_memLp r hr))
    (integrable_const _)]
  simp only [objectiveEnergy, integral_const, probReal_univ, smul_eq_mul, one_mul]

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule6
/- END Definitions.SCAFFOLD.Potentials -/

/- BEGIN Definitions.SCAFFOLD.Telescoping -/
section SCAFFOLDBundleModule7
/-!
Finite-sum bridges for SCAFFOLD, Appendix E.1, PDF pp. 30-31 (Lemma 15 and
the unnumbered averaging display), and E.2, PDF pp. 34-35 (Lemma 19).
These generic telescoping facts do not assert algorithmic descent.
-/

noncomputable section
open scoped BigOperators
namespace SCAFFOLD

theorem weighted_descent_sum {q h B : ℝ} (hq : 0 < q)
    (V F : ℕ → ℝ) (T : ℕ)
    (hstep : ∀ r, r < T → V (r + 1) ≤ q * V r - h * F r + B) :
    h * ∑ r ∈ Finset.range T, q⁻¹ ^ (r + 1) * F r ≤
      V 0 - q⁻¹ ^ T * V T + B * ∑ r ∈ Finset.range T, q⁻¹ ^ (r + 1) := by
  have hscale (r : ℕ) : q⁻¹ ^ (r + 1) * q = q⁻¹ ^ r := by
    rw [pow_succ]
    field_simp
  have hterm (r : ℕ) (hr : r < T) :
      h * (q⁻¹ ^ (r + 1) * F r) ≤
        (q⁻¹ ^ r * V r - q⁻¹ ^ (r + 1) * V (r + 1)) +
          B * q⁻¹ ^ (r + 1) := by
    have hs := mul_le_mul_of_nonneg_left (hstep r hr)
      (pow_nonneg (inv_nonneg.mpr hq.le) (r + 1))
    have heq : q⁻¹ ^ (r + 1) * (q * V r) = q⁻¹ ^ r * V r := by
      rw [← mul_assoc, hscale]
    nlinarith only [hs, heq]
  have hs := Finset.sum_le_sum (s := Finset.range T)
    (fun r hr ↦ hterm r (Finset.mem_range.mp hr))
  simpa only [← Finset.mul_sum, Finset.sum_add_distrib, Finset.sum_range_sub',
    pow_zero, one_mul] using hs

theorem weighted_descent_average {q h B : ℝ} (hq : 0 < q) (hh : 0 < h)
    (V F : ℕ → ℝ) {T : ℕ} (hT : 0 < T) (hV : 0 ≤ V T)
    (hstep : ∀ r, r < T → V (r + 1) ≤ q * V r - h * F r + h ^ 2 * B) :
    (∑ r ∈ Finset.range T, q⁻¹ ^ (r + 1))⁻¹ *
        ∑ r ∈ Finset.range T, q⁻¹ ^ (r + 1) * F r ≤
      V 0 / (h * ∑ r ∈ Finset.range T, q⁻¹ ^ (r + 1)) + h * B := by
  let W := ∑ r ∈ Finset.range T, q⁻¹ ^ (r + 1)
  have hW : 0 < W := Finset.sum_pos (fun _ _ ↦ pow_pos (inv_pos.mpr hq) _)
    ⟨0, Finset.mem_range.mpr hT⟩
  have hs := weighted_descent_sum hq V F T hstep
  have hterminal : 0 ≤ q⁻¹ ^ T * V T :=
    mul_nonneg (pow_nonneg (inv_nonneg.mpr hq.le) _) hV
  have hb : h * (∑ r ∈ Finset.range T, q⁻¹ ^ (r + 1) * F r) ≤
      V 0 + h ^ 2 * B * W := by linarith
  change W⁻¹ * _ ≤ V 0 / (h * W) + h * B
  apply (mul_le_mul_iff_right₀ (mul_pos hh hW)).mp
  field_simp
  simpa only [one_div, mul_assoc, mul_comm, mul_left_comm] using hb

theorem descent_sum {a B : ℝ} (V F : ℕ → ℝ) (T : ℕ)
    (hstep : ∀ r, r < T → V (r + 1) ≤ V r - a * F r + B) :
    a * ∑ r ∈ Finset.range T, F r ≤ V 0 - V T + (T : ℝ) * B := by
  have hs := Finset.sum_le_sum (s := Finset.range T)
    (fun r hr ↦ show a * F r ≤ V r - V (r + 1) + B by
      linarith [hstep r (Finset.mem_range.mp hr)])
  simpa only [← Finset.mul_sum, Finset.sum_add_distrib, Finset.sum_range_sub',
    Finset.sum_const, Finset.card_range, nsmul_eq_mul] using hs

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule7
/- END Definitions.SCAFFOLD.Telescoping -/

/- BEGIN Definitions.SCAFFOLD.ConvergenceFinish -/
section SCAFFOLDBundleModule8
/-!
Terminal bridges from the actual SCAFFOLD Lyapunov recurrences to the published
finite-round target types. Source: Appendix E.1, PDF pp. 30-31, Lemma 15;
Appendix E.2, PDF pp. 34-35, Lemma 19. Recurrence premises in these local
intermediate lemmas remain obligations, never new assumptions on the Run.
-/

noncomputable section
open MeasureTheory
open scoped BigOperators
namespace SCAFFOLD

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

theorem Run.effectiveStep_pos (A : Run P ν S K T ηl ηg init)
    (hl : 0 < ηl) (hg : 1 ≤ ηg) : 0 < effectiveStep K ηl ηg :=
  mul_pos (mul_pos (by exact_mod_cast A.steps_pos) hl) (by linarith)

theorem Run.convex_weight_base_pos (A : Run P ν S K T ηl ηg init) {μ : ℝ}
    (hμ : μ * effectiveStep K ηl ηg ≤ (S : ℝ) / (15 * (N : ℝ))) :
    0 < 1 - μ * effectiveStep K ηl ηg / 2 := by
  have hN : (0 : ℝ) < N := by exact_mod_cast P.clients_pos
  have hSN : (S : ℝ) ≤ N := by exact_mod_cast A.sample_le
  have hbound : (S : ℝ) / (15 * (N : ℝ)) ≤ 1 / 15 := by
    apply (div_le_iff₀ (mul_pos (by norm_num) hN)).2
    linarith
  linarith

theorem Run.convex_finiteRound_of_recurrence {c0 : Fin N → Space d}
    (A : Run P ν S K T ηl ηg (some c0)) (xstar : Space d) (μ : ℝ)
    (hh : 0 < effectiveStep K ηl ηg)
    (hq : 0 < 1 - μ * effectiveStep K ηl ηg / 2)
    (hstep : ∀ r, r < T → convexPotential A xstar (r + 1) ≤
      (1 - μ * effectiveStep K ηl ηg / 2) * convexPotential A xstar r -
      effectiveStep K ηl ηg * expectedGap A xstar r +
      12 * (effectiveStep K ηl ηg) ^ 2 * P.σ ^ 2 / ((K : ℝ) * (S : ℝ)) *
        (1 + (S : ℝ) / ηg ^ 2)) :
    weightedGap A xstar μ ≤ convexRHS P S K T ηl ηg μ c0 xstar := by
  have hs (r : ℕ) (hr : r < T) : convexPotential A xstar (r + 1) ≤
      (1 - μ * effectiveStep K ηl ηg / 2) * convexPotential A xstar r -
      effectiveStep K ηl ηg * expectedGap A xstar r +
      (effectiveStep K ηl ηg) ^ 2 *
        (12 * P.σ ^ 2 / ((K : ℝ) * (S : ℝ)) * (1 + (S : ℝ) / ηg ^ 2)) := by
    convert hstep r hr using 1
    ring
  have hout := weighted_descent_average hq hh (convexPotential A xstar)
    (expectedGap A xstar) A.rounds_pos (convexPotential_nonneg A xstar T) hs
  rw [A.convexPotential_initial] at hout
  convert hout using 1
  dsimp [convexRHS, weightSum, weight]
  ring

private theorem finite_average_of_sum {h F B : ℝ} {T : ℕ} (hh : 0 < h)
    (hT : 0 < T) (G : ℕ → ℝ)
    (hs : (h / 14) * ∑ r ∈ Finset.range T, G r ≤ F + (T : ℝ) * B) :
    (T : ℝ)⁻¹ * ∑ r ∈ Finset.range T, G r ≤ 14 * F / (h * (T : ℝ)) + 14 * B / h := by
  have hTr : (0 : ℝ) < T := by exact_mod_cast hT
  apply (mul_le_mul_iff_of_pos_right (mul_pos hh hTr)).mp
  field_simp
  nlinarith

theorem Run.nonconvex_finiteRound_of_recurrence (A : Run P ν S K T ηl ηg none)
    (fLower : ℝ) (hl : ∀ x, fLower ≤ objective P.f x)
    (hh : 0 < effectiveStep K ηl ηg)
    (hstep : ∀ r, r < T → nonconvexPotential A (r + 1) ≤
      nonconvexPotential A r - (effectiveStep K ηl ηg / 14) * gradientEnergy A r +
      5 * P.β * (effectiveStep K ηl ηg) ^ 2 * P.σ ^ 2 / ((K : ℝ) * (S : ℝ)) *
        (1 + (S : ℝ) / ηg ^ 2)) :
    averageGradientSq A ≤ nonconvexRHS P S K T ηl ηg fLower := by
  let B := 5 * P.β * (effectiveStep K ηl ηg) ^ 2 * P.σ ^ 2 /
    ((K : ℝ) * (S : ℝ)) * (1 + (S : ℝ) / ηg ^ 2)
  have hs := descent_sum (nonconvexPotential A) (gradientEnergy A) T hstep
  rw [A.nonconvexPotential_initial] at hs
  have hterminal := A.nonconvexPotential_lower le_rfl hl
  have hs' : (effectiveStep K ηl ηg / 14) *
      ∑ r ∈ Finset.range T, gradientEnergy A r ≤
      (objective P.f P.x0 - fLower) + (T : ℝ) * B := by
    dsimp [B]
    linarith
  have hout := finite_average_of_sum hh A.rounds_pos (gradientEnergy A) hs'
  change averageGradientSq A ≤ _ at hout
  convert hout using 1
  dsimp [nonconvexRHS, B]
  have hK : (K : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.steps_pos
  have hS : (S : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.sample_pos
  have hT : (T : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt A.rounds_pos
  have hg : ηg ≠ 0 := by
    intro hz
    simp [effectiveStep, hz] at hh
  field_simp
  ring

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule8
/- END Definitions.SCAFFOLD.ConvergenceFinish -/

