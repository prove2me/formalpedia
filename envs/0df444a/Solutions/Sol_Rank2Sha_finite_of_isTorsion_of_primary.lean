import Mathlib

/-!
# Solution of `Rank2Sha.finite_of_isTorsion_of_primary`

Let `A` be the union over the primes `p` of `S` of the sets `{x | ∃ n, p ^ n • x = 0}`.
It is finite. Every `x` with `n • x = 0`, `n ≠ 0`, lies in the subgroup generated by `A`,
by induction on `n` through prime powers and coprime products. So `G` is finitely
generated and torsion, hence finite.
-/

theorem solution {G : Type*} [AddCommGroup G]
    (hT : IsAddTorsion G) (S : Finset ℕ)
    (hout : ∀ p : ℕ, p.Prime → p ∉ S → ∀ x : G, p • x = 0 → x = 0)
    (hin : ∀ p ∈ S, p.Prime → {x : G | ∃ n : ℕ, p ^ n • x = 0}.Finite) :
    Finite G := by
  classical
  -- the finite generating set
  set A : Set G := ⋃ p ∈ S.filter Nat.Prime, {x : G | ∃ n : ℕ, p ^ n • x = 0} with hA
  have hAfin : A.Finite :=
    Set.Finite.biUnion (Finset.finite_toSet _) fun p hp ↦
      hin p (Finset.mem_filter.mp hp).1 (Finset.mem_filter.mp hp).2
  -- a prime outside `S` kills no nonzero element, nor does any of its powers
  have hpow : ∀ p : ℕ, p.Prime → p ∉ S → ∀ k : ℕ, ∀ x : G, p ^ k • x = 0 → x = 0 := by
    intro p hp hpS k
    induction k with
    | zero => intro x hx; simpa using hx
    | succ k ih =>
      intro x hx
      refine ih x (hout p hp hpS _ ?_)
      rw [← mul_nsmul, ← pow_succ]
      exact hx
  -- every element killed by a nonzero integer lies in the subgroup generated by `A`
  have key : ∀ n : ℕ, n ≠ 0 → ∀ x : G, n • x = 0 → x ∈ AddSubgroup.closure A := by
    intro n
    induction n using Nat.recOnPrimeCoprime with
    | zero => intro h; exact absurd rfl h
    | prime_pow p k hp =>
      intro _ x hx
      by_cases hpS : p ∈ S
      · refine AddSubgroup.subset_closure ?_
        rw [hA]
        exact Set.mem_biUnion (Finset.mem_filter.mpr ⟨hpS, hp⟩) ⟨k, hx⟩
      · rw [hpow p hp hpS k x hx]
        exact zero_mem _
    | coprime a b ha hb hab iha ihb =>
      intro _ x hx
      obtain ⟨u, v, huv⟩ := (Nat.isCoprime_iff_coprime.mpr hab)
      have hx' : ((a : ℤ) * (b : ℤ)) • x = 0 := by
        rw [← Nat.cast_mul, natCast_zsmul]
        exact hx
      have h1 : x = (u * (a : ℤ)) • x + (v * (b : ℤ)) • x := by
        rw [← add_smul, huv, one_smul]
      have hy : b • ((u * (a : ℤ)) • x) = 0 := by
        rw [← natCast_zsmul, ← mul_smul, show (b : ℤ) * (u * (a : ℤ)) = u * ((a : ℤ) * b) by ring,
          mul_smul, hx', smul_zero]
      have hz : a • ((v * (b : ℤ)) • x) = 0 := by
        rw [← natCast_zsmul, ← mul_smul, show (a : ℤ) * (v * (b : ℤ)) = v * ((a : ℤ) * b) by ring,
          mul_smul, hx', smul_zero]
      rw [h1]
      exact add_mem (ihb (by omega) _ hy) (iha (by omega) _ hz)
  -- `G` is finitely generated
  have htop : AddSubgroup.closure A = ⊤ := by
    rw [eq_top_iff]
    intro x _
    exact key (addOrderOf x) (hT x).addOrderOf_pos.ne' x (addOrderOf_nsmul_eq_zero x)
  have : AddGroup.FG G := AddGroup.fg_iff.mpr ⟨A, htop, hAfin⟩
  exact AddCommGroup.finite_of_fg_isAddTorsion G hT
