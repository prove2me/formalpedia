-- title:
--   Lemma 3 — R is a countable union of bounded sets, and a bounded set is a finite union of graphs of partial transformations
-- statement:
--   Throughout, $X$ is a standard Borel space, $\mu$ a $\sigma$-finite measure on $X$, and $R \subseteq X \times X$ a discrete measured equivalence relation for $\mu$ (`IsDiscreteMeasured`): a Borel equivalence relation whose classes are countable and for which $\mu$ is quasi-invariant (the saturation of a null Borel set is null).
--
--   (a) $R$ is the union of countably many bounded subsets $K_0, K_1, \dots$ (`IsBoundedSubset`: Borel subsets of $R$ whose horizontal and vertical sections have uniformly bounded size and on which the module $\delta$ lies between $c$ and $c^{-1}$ for some $c > 0$, $m$-almost everywhere).
--
--   (b) Every bounded subset $K$ of $R$ is the union of the graphs $\{(a, \phi_i(a)) \mid a \in \operatorname{Dom} \phi_i\}$ of finitely many partial transformations $\phi_1, \dots, \phi_n$ of $R$ (`Monod.PartialTransformation`), each with bounded Radon–Nikodym derivative: for each $i$ there is $c > 0$ such that the Radon–Nikodym derivative $d\mu(\phi_i(a))/d\mu(a)$ of the measure $A \mapsto \mu(\phi_i(A))$ on $\operatorname{Dom} \phi_i$ with respect to $\mu$ lies between $c$ and $c^{-1}$ at $\mu$-almost every $a \in \operatorname{Dom} \phi_i$.
--
--   “Bounded” is read as bounded away from $0$ and $\infty$, as for $\operatorname{Sup}_K |\operatorname{Log} \delta|$ in the definition of a bounded set.
-- source:
--   Connes, A., Feldman, J., Weiss, B., An amenable equivalence relation is generated by a single transformation, Ergodic Theory Dynam. Systems 1 (1981) 431–450, https://doi.org/10.1017/S014338570000136X, p. 435, Lemma 3

import Mathlib
import Definitions.Def_Monod_PiecewiseProjective
import Definitions.Def_ConnesFeldmanWeiss

namespace ConnesFeldmanWeiss

theorem exists_isBoundedSubset_cover_and_eq_iUnion_graph {X : Type*} [MeasurableSpace X]
    [StandardBorelSpace X] (μ : MeasureTheory.Measure X) [MeasureTheory.SigmaFinite μ]
    (R : Set (X × X)) (hR : IsDiscreteMeasured μ R) :
    (∃ K : ℕ → Set (X × X), (∀ n, IsBoundedSubset μ R (K n)) ∧ R = ⋃ n, K n) ∧
    ∀ K, IsBoundedSubset μ R K → ∃ (n : ℕ) (φ : Fin n → Monod.PartialTransformation R),
      (∀ i, ∃ c : NNReal, 0 < c ∧ ∀ᵐ a ∂(μ.comap ((↑) : (φ i).dom → X)),
        (c : ENNReal) ≤ ((μ.comap ((↑) : (φ i).cod → X)).map (φ i).e.symm).rnDeriv
            (μ.comap ((↑) : (φ i).dom → X)) a ∧
          ((μ.comap ((↑) : (φ i).cod → X)).map (φ i).e.symm).rnDeriv
            (μ.comap ((↑) : (φ i).dom → X)) a ≤ (c : ENNReal)⁻¹) ∧
      K = ⋃ i, {p | ∃ a : (φ i).dom, p = ((a : X), ((φ i).e a : X))} := by
  sorry

end ConnesFeldmanWeiss
