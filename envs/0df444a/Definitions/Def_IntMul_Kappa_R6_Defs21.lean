-- Source module: Solutions.R6IL2CLoop
/-!
# Round six, compact controls (I2C): segment loops with three radices

`segLoopR T` (`n` iterations, `n` on register `pN`):
`rA += rW · T(rU, rV); rU /= ru; rV /= rv; rW *= rw` with the radices `ru, rv, rw` on the
registers `pRu, pRv, pRw` (left untouched).  After the loop `rA = a + segSum tf ru rv rw w u v n`
(`segLoopR_fsp`).  `segStepR`: push `u, v, w, a`, loop, assign a function of the accumulator to a
target, pop (`segStepR_fsp`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## Parameter registers -/

abbrev rA : Fin HS := KFL.rA
abbrev rC : Fin HS := KFL.rC
abbrev rU : Fin HS := KFL.rU
abbrev rV : Fin HS := KFL.rV
abbrev rW : Fin HS := KFL.rW

abbrev pRu : Fin HS := 6
abbrev pRv : Fin HS := 7
abbrev pRw : Fin HS := 8
abbrev pN : Fin HS := 10
abbrev pR : Fin HS := 11

/-! ## The loop -/

def segBodyR (T : Ex HS) : RS :=
  .seq (.asg rA (.add (.reg rA) (.mul (.reg rW) T)))
    (.seq (.asg rU (.ndiv (.reg rU) (.reg pRu)))
    (.seq (.asg rV (.ndiv (.reg rV) (.reg pRv)))
      (.asg rW (.mul (.reg rW) (.reg pRw)))))

def segLoopR (T : Ex HS) : RS := .rep rC (.reg pN) (segBodyR T)

/-- The managed state after `k` iterations. -/
def segFR (F : Fin HS → List ℤ) (tf : ℤ → ℤ → ℤ) (ru rv rw a u v w : ℤ) (k : ℕ) :
    Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update F
    rA ((a + segSum tf ru rv rw w u v k) :: (F rA).tail))
    rU ((u / ru ^ k) :: (F rU).tail))
    rV ((v / rv ^ k) :: (F rV).tail))
    rW ((w * rw ^ k) :: (F rW).tail)

/-- Hypotheses on the term `T`: it reads `rU, rV` and the parameter `pR` only; on states where
`pR` holds `Rv`, it has semantics `tf`, is executable and bounded. -/
structure SegTR (T : Ex HS) (tf : ℤ → ℤ → ℤ) (Bb : ℕ) (Tm Rv : ℤ) : Prop where
  regs : ∀ i ∈ T.regs, i = rU ∨ i = rV ∨ i = pR
  ev : ∀ (t : IState HS) (a b : ℤ) (L : List Item), t.G pR = .int Rv :: L → t.top rU = a →
    t.top rV = b → T.eval t = tf a b
  ok : ∀ (t : IState HS) (a b : ℤ) (L : List Item), t.G pR = .int Rv :: L → t.top rU = a →
    t.top rV = b → t.IsInt rU → t.IsInt rV → 0 ≤ a → 0 ≤ b → zsz a ≤ Bb → zsz b ≤ Bb →
    T.ok t ∧ T.Bnd t Bb
  abs : ∀ a b, |tf a b| ≤ Tm

def cSegItR (T : Ex HS) (Bb : ℕ) : ℕ := (T.size + 8) * 4 * 10 ^ 7 * (Bb + 2) ^ 2

end IntMul.Kappa.R6.IL2C

end

