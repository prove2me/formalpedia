variable {p : ℕ} [Fact p.Prime] {N r : ℕ}
namespace Formalism.InvariantFactorPaths.L4
theorem _root_.solution (LL : Letters N) (i0 : Fin N) (h0 : (i0 : ℕ) = 0) (c d : Fin r)
    (x : MvPolynomial (Fin N × Fin r) ℚ_[p]) :
    glAct p LL 1 c d x =
      if LL.vec i0 then X (i0, c) * pderiv (i0, d) x else -(X (i0, d) * pderiv (i0, c) x) := by
  simp only [Formalism.GM.M.glAct]
  rw [Finset.sum_eq_single i0]
  · have hlt : (i0 : ℕ) < 1 := by omega
    rw [if_pos hlt]
    split_ifs <;> simp
  · intro b _ hb
    have hnb : ¬ (b : ℕ) < 1 := by
      intro hlt
      exact hb (Fin.ext (by omega))
    rw [if_neg hnb]
  · intro hn
    exact absurd (Finset.mem_univ i0) hn
end Formalism.InvariantFactorPaths.L4
