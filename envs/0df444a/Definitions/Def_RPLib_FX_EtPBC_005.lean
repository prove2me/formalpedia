variable {k : Type u} [Field k] {Λ : Type u} [CommRing Λ] {P : Scheme.{u}}

/-- `Spec B ⟶ A¹ ⟶ P` as an étale object. -/
abbrev chEt (c : A1 k ⟶ P) {B : CommRingCat.{u}} (φ : CommRingCat.of k[X] ⟶ B) [Etale (Spec.map φ ≫ c)] :
