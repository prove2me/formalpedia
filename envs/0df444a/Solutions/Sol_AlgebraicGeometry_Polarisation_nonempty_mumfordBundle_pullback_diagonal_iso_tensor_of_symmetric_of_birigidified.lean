namespace SP2Aux

variable {X' Y' Z' : Scheme.{0}}

noncomputable def pbEq {a b : X' ⟶ Y'} (h : a = b) (N : Y'.Modules) :
    (Scheme.Modules.pullback a).obj N ≅ (Scheme.Modules.pullback b).obj N := (Scheme.Modules.pullbackCongr h).app N

noncomputable def pbComp (a : X' ⟶ Y') (b : Y' ⟶ Z') (N : Z'.Modules) :
    (Scheme.Modules.pullback (a ≫ b)).obj N ≅ (Scheme.Modules.pullback a).obj ((Scheme.Modules.pullback b).obj N) :=
  ((Scheme.Modules.pullbackComp a b).app N).symm

noncomputable def pbUnit (a : X' ⟶ Y') (N : Y'.Modules) (e : N ≅ 𝟙_ Y'.Modules) :
    (Scheme.Modules.pullback a).obj N ≅ 𝟙_ X'.Modules :=
  (Scheme.Modules.pullback a).mapIso e ≪≫ Scheme.Modules.pullbackTensorUnitObjIso a

variable {C : Type*} [Category C] [MonoidalCategory C] [BraidedCategory C]

noncomputable def shuffle (P Q R S : C) : (P ⊗ Q) ⊗ (R ⊗ S) ≅ (P ⊗ R) ⊗ (Q ⊗ S) :=
  α_ P Q (R ⊗ S) ≪≫ whiskerLeftIso P ((α_ Q R S).symm ≪≫ whiskerRightIso (β_ Q R) S ≪≫ α_ R Q S) ≪≫ (α_ P R (Q ⊗ S)).symm

end SP2Aux

open SP2Aux in
theorem solution
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle k f)
    (g : ℕ) (hdim : ∀ s : ↥(Spec (CommRingCat.of k)), topologicalKrullDim ↥(f.base ⁻¹' {s}) = g)
    (𝓟 : (pullback f f).Modules) (h𝓟 : Scheme.Modules.IsInvertible 𝓟)
    (h₁ : Nonempty ((Scheme.Modules.pullback (sliceAt f (RelativeGroupLaw.AlgPoints.toPoint (0 : L.AlgPoints hc k)))).obj 𝓟 ≅ 𝟙_ _))
    (h₂ : Nonempty ((Scheme.Modules.pullback (sliceAt f (RelativeGroupLaw.AlgPoints.toPoint (0 : L.AlgPoints hc k)))).obj
        ((Scheme.Modules.pullback (pullbackSymmetry f f).hom).obj 𝓟) ≅ 𝟙_ _))
    (h₃ : Nonempty ((Scheme.Modules.pullback (pullbackSymmetry f f).hom).obj 𝓟 ≅ 𝓟)) :
    Nonempty (mumfordBundle f L ((Scheme.Modules.pullback (pullback.lift (𝟙 A) (𝟙 A) rfl)).obj 𝓟) ≅ 𝓟 ⊗ 𝓟) := by
  classical
  obtain ⟨e₃⟩ := h₃

  set Δ : A ⟶ pullback f f := pullback.lift (𝟙 A) (𝟙 A) rfl with hΔ
  set N : A.Modules := (Scheme.Modules.pullback Δ).obj 𝓟 with hN
  have hNi : Scheme.Modules.IsInvertible N := h𝓟.pullback _
  set m13 := pullback.lift (pullback.fst (pullback.fst f f ≫ f) f ≫ addMor f L) (pullback.snd (pullback.fst f f ≫ f) f)
      (by rw [Category.assoc, addMor_over]; exact pullback.condition) with hm13
  set p13 := pullback.lift (pullback.fst (pullback.fst f f ≫ f) f ≫ pullback.fst f f) (pullback.snd (pullback.fst f f ≫ f) f)
      (by rw [Category.assoc]; exact pullback.condition) with hp13
  set p23 := pullback.lift (pullback.fst (pullback.fst f f ≫ f) f ≫ pullback.snd f f) (pullback.snd (pullback.fst f f ≫ f) f)
      (by rw [Category.assoc, ← pullback.condition (f := f) (g := f)]; exact pullback.condition) with hp23

  have SP1 : ∀ (w : pullback f f ⟶ pullback (pullback.fst f f ≫ f) f),
      Nonempty ((Scheme.Modules.pullback (w ≫ m13)).obj 𝓟 ≅
        (Scheme.Modules.pullback (w ≫ p13)).obj 𝓟 ⊗ (Scheme.Modules.pullback (w ≫ p23)).obj 𝓟) := by
    intro w
    obtain ⟨e⟩ := AlgebraicGeometry.Polarisation.nonempty_pullback_addMorProd_iso_tensor_of_birigidified k f L hc hA g hdim 𝓟 h𝓟 h₁ h₂
    exact ⟨pbComp w m13 𝓟 ≪≫ (Scheme.Modules.pullback w).mapIso e ≪≫ Scheme.Modules.pullbackTensorObjIso w _ _ ≪≫
      tensorIso (pbComp w p13 𝓟).symm (pbComp w p23 𝓟).symm⟩

  let u : pullback f f ⟶ pullback (pullback.fst f f ≫ f) f :=
    pullback.lift (𝟙 _) (addMor f L) (by rw [Category.id_comp, addMor_over])
  let v₁ : pullback f f ⟶ pullback (pullback.fst f f ≫ f) f :=
    pullback.lift (𝟙 _) (pullback.fst f f) (by rw [Category.id_comp])
  let v₂ : pullback f f ⟶ pullback (pullback.fst f f ≫ f) f :=
    pullback.lift (𝟙 _) (pullback.snd f f) (by rw [Category.id_comp, pullback.condition])
  let a₁ : pullback f f ⟶ pullback f f := pullback.lift (pullback.fst f f) (addMor f L) (by rw [addMor_over])
  let a₂ : pullback f f ⟶ pullback f f := pullback.lift (pullback.snd f f) (addMor f L) (by rw [addMor_over, pullback.condition])
  have U1 : u ≫ m13 = addMor f L ≫ Δ := by
    apply pullback.hom_ext <;> simp [u, hm13, hΔ, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc, pullback.lift_snd_assoc]
  have U2 : u ≫ p13 = a₁ := by
    apply pullback.hom_ext <;> simp [u, a₁, hp13, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc, pullback.lift_snd_assoc]
  have U3 : u ≫ p23 = a₂ := by
    apply pullback.hom_ext <;> simp [u, a₂, hp23, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc, pullback.lift_snd_assoc]
  have V1m : v₁ ≫ m13 = a₁ ≫ (pullbackSymmetry f f).hom := by
    apply pullback.hom_ext <;> simp [v₁, a₁, hm13, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc, pullback.lift_snd_assoc]
  have V1p : v₁ ≫ p13 = pullback.fst f f ≫ Δ := by
    apply pullback.hom_ext <;> simp [v₁, hp13, hΔ, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc, pullback.lift_snd_assoc]
  have V1q : v₁ ≫ p23 = (pullbackSymmetry f f).hom := by
    apply pullback.hom_ext <;> simp [v₁, hp23, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc, pullback.lift_snd_assoc]
  have V2m : v₂ ≫ m13 = a₂ ≫ (pullbackSymmetry f f).hom := by
    apply pullback.hom_ext <;> simp [v₂, a₂, hm13, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc, pullback.lift_snd_assoc]
  have V2p : v₂ ≫ p13 = 𝟙 _ := by
    apply pullback.hom_ext <;> simp [v₂, hp13, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc, pullback.lift_snd_assoc]
  have V2q : v₂ ≫ p23 = pullback.snd f f ≫ Δ := by
    apply pullback.hom_ext <;> simp [v₂, hp23, hΔ, pullback.lift_fst, pullback.lift_snd, pullback.lift_fst_assoc, pullback.lift_snd_assoc]

  obtain ⟨S1⟩ := SP1 v₁
  obtain ⟨S2⟩ := SP1 v₂
  obtain ⟨Su⟩ := SP1 u
  set P1 := (Scheme.Modules.pullback (pullback.fst f f)).obj N with hP1
  set P2 := (Scheme.Modules.pullback (pullback.snd f f)).obj N with hP2

  have A1 : (Scheme.Modules.pullback a₁).obj 𝓟 ≅ P1 ⊗ 𝓟 :=
    (Scheme.Modules.pullback a₁).mapIso e₃.symm ≪≫ (pbComp a₁ _ 𝓟).symm ≪≫ pbEq V1m.symm 𝓟 ≪≫ S1 ≪≫
      tensorIso (pbEq V1p 𝓟 ≪≫ pbComp _ Δ 𝓟) (pbEq V1q 𝓟 ≪≫ e₃)

  have A2 : (Scheme.Modules.pullback a₂).obj 𝓟 ≅ 𝓟 ⊗ P2 :=
    (Scheme.Modules.pullback a₂).mapIso e₃.symm ≪≫ (pbComp a₂ _ 𝓟).symm ≪≫ pbEq V2m.symm 𝓟 ≪≫ S2 ≪≫
      tensorIso (pbEq V2p 𝓟 ≪≫ (Scheme.Modules.pullbackId _).app 𝓟) (pbEq V2q 𝓟 ≪≫ pbComp _ Δ 𝓟)

  have Mm : (Scheme.Modules.pullback (addMor f L)).obj N ≅ (𝓟 ⊗ 𝓟) ⊗ (P1 ⊗ P2) :=
    (pbComp (addMor f L) Δ 𝓟).symm ≪≫ pbEq U1.symm 𝓟 ≪≫ Su ≪≫ tensorIso (pbEq U2 𝓟 ≪≫ A1 ≪≫ β_ P1 𝓟) (pbEq U3 𝓟 ≪≫ A2) ≪≫
      shuffle 𝓟 P1 𝓟 P2

  obtain ⟨eN⟩ := hNi.dual_monoidalV2.2
  have Q : (Scheme.Modules.pullback (pullback.fst f f)).obj (Scheme.Modules.dual N) ⊗
      (Scheme.Modules.pullback (pullback.snd f f)).obj (Scheme.Modules.dual N) ≅
      (Scheme.Modules.pullback (pullback.fst f f)).obj (Scheme.Modules.dual N) ⊗
      (Scheme.Modules.pullback (pullback.snd f f)).obj (Scheme.Modules.dual N) := Iso.refl _
  have C1 : P1 ⊗ (Scheme.Modules.pullback (pullback.fst f f)).obj (Scheme.Modules.dual N) ≅ 𝟙_ _ :=
    (Scheme.Modules.pullbackTensorObjIso (pullback.fst f f) N (Scheme.Modules.dual N)).symm ≪≫ pbUnit _ _ eN
  have C2 : P2 ⊗ (Scheme.Modules.pullback (pullback.snd f f)).obj (Scheme.Modules.dual N) ≅ 𝟙_ _ :=
    (Scheme.Modules.pullbackTensorObjIso (pullback.snd f f) N (Scheme.Modules.dual N)).symm ≪≫ pbUnit _ _ eN
  refine ⟨?_⟩
  change (Scheme.Modules.pullback (addMor f L)).obj N ⊗
      ((Scheme.Modules.pullback (pullback.fst f f)).obj (Scheme.Modules.dual N) ⊗
        (Scheme.Modules.pullback (pullback.snd f f)).obj (Scheme.Modules.dual N)) ≅ 𝓟 ⊗ 𝓟
  exact whiskerRightIso Mm _ ≪≫ α_ _ _ _ ≪≫
    whiskerLeftIso (𝓟 ⊗ 𝓟) (shuffle P1 P2 _ _ ≪≫ tensorIso C1 C2 ≪≫ λ_ (𝟙_ _)) ≪≫ ρ_ (𝓟 ⊗ 𝓟)

end S_AlgebraicGeometry_Polarisation_nonempty_mumfordBundle_pullback_diagonal_iso_tensor_of_symmetric_of_birigidified
