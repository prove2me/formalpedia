theorem shlN_runs {i j : Fin HS} (hij : i ≠ j) (t : IState HS) {a m : ℕ} {Li Lj : List Item}
    (hi : t.G i = .int (a : ℤ) :: Li) (hj : t.G j = .int ((2 ^ m : ℕ) : ℤ) :: Lj) :
    IRuns I iprog (.op (.shl i j)) t (t.upd i (.int ((a * 2 ^ m : ℕ) : ℤ) :: Li)) (200 * (m + 1)) := by
