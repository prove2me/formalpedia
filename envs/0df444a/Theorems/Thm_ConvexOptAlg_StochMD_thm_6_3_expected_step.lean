-- title:
--   §6.2, proof of Theorem 6.3, p. 333 — E f(x_{s+1}) − f(x∗) ≤ (β + 1/η)E(D_Φ(x∗, x_s) − D_Φ(x∗, x_{s+1})) + ησ²/2
-- statement:
--   Let $E$ be a finite-dimensional real normed space, $\mathcal X\subseteq E$ compact and convex, $\Phi$ a mirror map on $\mathcal D\subseteq E$ with $\mathcal X\subseteq\overline{\mathcal D}$ and $\mathcal X\cap\mathcal D\ne\emptyset$, $1$-strongly convex on $\mathcal X\cap\mathcal D$ with respect to $\|\cdot\|$. Let $x_1$ minimize $\Phi$ on $\mathcal X\cap\mathcal D$ and let $R$ satisfy $\Phi(x)-\Phi(x_1)\le R^2$ for $x\in\mathcal X\cap\mathcal D$. Let $f$ be convex and $\beta$-smooth on $\mathcal X$, $\beta\ge0$. On a probability space, let $(x_s,\tilde g_s)_{s\ge1}$ be an S-MD run started at $x_1$ with step size $1/(\beta+1/\eta)$, $\eta>0$, driven by a stochastic oracle with $\mathbb E(\tilde g_s\mid x_s)=\nabla f(x_s)$ and $\mathbb E(\|\tilde g_s-\nabla f(x_s)\|_*^2\mid x_s)\le\sigma^2$. Then for every $s\ge1$ and every $x^*\in\mathcal X$, the random variables $f(x_{s+1})$ and $D_\Phi(x^*,x_s)-D_\Phi(x^*,x_{s+1})$ are integrable and
--   $$\mathbb E f(x_{s+1})-f(x^*)\le\Big(\beta+\frac1\eta\Big)\mathbb E\big(D_\Phi(x^*,x_s)-D_\Phi(x^*,x_{s+1})\big)+\frac{\eta\sigma^2}{2}.$$
--
--   This is the expected one-step bound of the proof of Theorem 6.3; summing it from $s=1$ to $t$ telescopes the Bregman terms and gives the theorem.
--
--   **Formalization Note** The expectation is the integral over the probability space; integrability of both random variables is part of the conclusion (a non-integrable function has integral $0$ in Lean). The conditional expectations are given the σ-algebra generated by $x_s$. The bound $R$ (a hypothesis of Theorem 6.3) is assumed because it keeps the Bregman terms integrable. The book applies the bound to the minimizer $x^*$ of $f$; it holds for every $x^*\in\mathcal X$. $\beta\ge0$ is the nonnegativity of a smoothness constant.
-- source:
--   Bubeck, arXiv:1405.4980v2, §6.2, proof of Theorem 6.3, fourth display, p. 333

import Mathlib
import Definitions.Def_ConvexOptAlg_StochMD_Defs

namespace ConvexOptAlg.StochMD

open MeasureTheory

/-- Bubeck, arXiv:1405.4980v2, proof of Theorem 6.3, printed p. 333, fourth display ("In
particular this yields …"): in the setting of Theorem 6.3, for a run of S-MD with step size
`1/(β + 1/η)` (any `η > 0`) driven by a stochastic oracle that is conditionally unbiased for `∇f`
with conditional variance at most `σ²`, for every `s ≥ 1` and every `x∗ ∈ X`, the random variables
`f(x_{s+1})` and `D_Φ(x∗, x_s) − D_Φ(x∗, x_{s+1})` are integrable and
`E f(x_{s+1}) − f(x∗) ≤ (β + 1/η) E(D_Φ(x∗, x_s) − D_Φ(x∗, x_{s+1})) + ησ²/2`. -/
theorem thm_6_3_expected_step {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]
    {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (X D : Set E) (hXcpt : IsCompact X) (hXconv : Convex ℝ X) (hXD : X ⊆ closure D)
    (hXDne : (X ∩ D).Nonempty)
    (Φ : E → ℝ) (Φ' : E → E →L[ℝ] ℝ) (hΦ : IsMirrorMap D Φ Φ')
    (hΦsc : IsStronglyConvexWRT (X ∩ D) Φ Φ' 1)
    (x₁ : E) (R : ℝ) (hR : ∀ z ∈ X ∩ D, Φ z - Φ x₁ ≤ R ^ 2)
    (f : E → ℝ) (f' : E → E →L[ℝ] ℝ) (β : ℝ) (hβ : 0 ≤ β)
    (hf : ConvexOn ℝ X f) (hsmooth : IsSmoothWRT X f f' β)
    (σ : ℝ) (x : ℕ → Ω → E) (gt : ℕ → Ω → E →L[ℝ] ℝ)
    (horacle : IsSmoothStochOracle μ f' σ x gt)
    (η : ℝ) (hη : 0 < η) (hrun : IsSMDRun X D Φ Φ' (1 / (β + 1 / η)) x₁ x gt)
    (xstar : E) (hxstar : xstar ∈ X) (s : ℕ) (hs : 1 ≤ s) :
    Integrable (fun ω => f (x (s + 1) ω)) μ ∧
      Integrable (fun ω => bregman Φ Φ' xstar (x s ω) - bregman Φ Φ' xstar (x (s + 1) ω)) μ ∧
      (∫ ω, f (x (s + 1) ω) ∂μ) - f xstar ≤
        (β + 1 / η) *
            (∫ ω, (bregman Φ Φ' xstar (x s ω) - bregman Φ Φ' xstar (x (s + 1) ω)) ∂μ) +
          η * σ ^ 2 / 2 := by sorry

end ConvexOptAlg.StochMD
