variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem NLogN.KFM.chirpP_runs {M : MulSpec} {pM : Fin P} (hM : MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {Δ φ : ℕ} (hΦ : ∀ x y : ℤ, zsz x ≤ Δ + 2 → zsz y ≤ Δ + 2 → M.Φ x y ≤ φ) (T : ℕ) :
    ∀ (d : ℕ) (s t : Fin d → ℕ), (∀ i, s i ≤ t i) → (∀ i, 0 < t i) → (∀ i, t i ≤ T) →
      d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 →
      ∀ (st : IState HS) (LR : List Item), st.G pR = .int (2 ^ Δ) :: LR →
      IRuns I iprog (chirpP pM Δ d s t) st
        (st.upd pQ1 (ints (gflat (chirpArr Δ d s t)) ++ st.G pQ1)) (cChirpP Δ φ d s t) := by sorry
