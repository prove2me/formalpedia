namespace K2Sol

theorem eq_of_pow_eq_pow {Γ : Type*} [LinearOrderedCommGroupWithZero Γ] {a b : Γ} {n : ℕ} (hn : n ≠ 0)
    (h : a ^ n = b ^ n) : a = b := by
  have h' : a ^ (n : ℤ) = b ^ (n : ℤ) := by rw [zpow_natCast, zpow_natCast]; exact h
  exact (zpow_left_inj₀ zero_le' zero_le' (by exact_mod_cast hn)).mp h'

section Generic

variable {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]
  {Fbar : Type*} [Field Fbar] [Algebra (ResidueField A) Fbar]

theorem residue_congr (R : RegularProlongation A F Fbar) {x y : F} (hxy : x = y) (hx : x ∈ R.integers)
    (hy : y ∈ R.integers) : R.residue ⟨x, hx⟩ = R.residue ⟨y, hy⟩ := by
  subst hxy; rfl

theorem inv_algebraMap_mul_smul {c : L} (hc : c ≠ 0) (f : F) : (algebraMap L F c)⁻¹ * (c • f) = f := by
  rw [Algebra.smul_def, ← mul_assoc, inv_mul_cancel₀ ((map_ne_zero (algebraMap L F)).mpr hc), one_mul]

theorem gu_ne_zero (R : RegularProlongation A F Fbar) {x : F} (hx : ∃ h : x ∈ R.integers, R.residue ⟨x, h⟩ ≠ 0) :
    x ≠ 0 := by
  obtain ⟨h, hres⟩ := hx
  rintro rfl
  apply hres
  have : (⟨(0 : F), h⟩ : R.integers) = 0 := rfl
  rw [this, map_zero]

theorem gu_congr (R : RegularProlongation A F Fbar) {x y : F} (hxy : x = y)
    (hx : ∃ h : x ∈ R.integers, R.residue ⟨x, h⟩ ≠ 0) : ∃ h : y ∈ R.integers, R.residue ⟨y, h⟩ ≠ 0 := by
  subst hxy; exact hx

theorem gu_one (R : RegularProlongation A F Fbar) : ∃ h : (1 : F) ∈ R.integers, R.residue ⟨1, h⟩ ≠ 0 := by
  refine ⟨one_mem _, ?_⟩
  have : (⟨(1 : F), one_mem _⟩ : R.integers) = 1 := rfl
  rw [this, map_one]; exact one_ne_zero

theorem gu_mul (R : RegularProlongation A F Fbar) {x y : F} (hx : ∃ h : x ∈ R.integers, R.residue ⟨x, h⟩ ≠ 0)
    (hy : ∃ h : y ∈ R.integers, R.residue ⟨y, h⟩ ≠ 0) : ∃ h : x * y ∈ R.integers, R.residue ⟨x * y, h⟩ ≠ 0 := by
  obtain ⟨hx, hxr⟩ := hx
  obtain ⟨hy, hyr⟩ := hy
  refine ⟨mul_mem hx hy, ?_⟩
  have : (⟨x * y, mul_mem hx hy⟩ : R.integers) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
  rw [this, map_mul]
  exact mul_ne_zero hxr hyr

theorem gu_pow (R : RegularProlongation A F Fbar) {x : F} (hx : ∃ h : x ∈ R.integers, R.residue ⟨x, h⟩ ≠ 0) (n : ℕ) :
    ∃ h : x ^ n ∈ R.integers, R.residue ⟨x ^ n, h⟩ ≠ 0 := by
  induction n with
  | zero => rw [pow_zero]; exact gu_one R
  | succ n ih => rw [pow_succ]; exact gu_mul R ih hx

theorem coe_units_inv (S : ValuationSubring F) (u : (↥S)ˣ) : (((u⁻¹ : (↥S)ˣ) : ↥S) : F) = ((u : ↥S) : F)⁻¹ := by
  have h1 : ((u : ↥S) : F) * (((u⁻¹ : (↥S)ˣ) : ↥S) : F) = 1 := by
    rw [← MulMemClass.coe_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, OneMemClass.coe_one]
  exact (eq_inv_of_mul_eq_one_right h1)

theorem gu_inv (R : RegularProlongation A F Fbar) {x : F} (hx : ∃ h : x ∈ R.integers, R.residue ⟨x, h⟩ ≠ 0) :
    ∃ h : x⁻¹ ∈ R.integers, R.residue ⟨x⁻¹, h⟩ ≠ 0 := by
  obtain ⟨hf, h⟩ := hx
  obtain ⟨u, hu⟩ := R.isUnit_of_residue_ne_zero h
  have hcoe : ((u : R.integers) : F) = x := by rw [hu]
  have hinv : (((u⁻¹ : (↥R.integers)ˣ) : R.integers) : F) = x⁻¹ := by rw [coe_units_inv, hcoe]
  have hmem : x⁻¹ ∈ R.integers := hinv ▸ SetLike.coe_mem _
  refine ⟨hmem, ?_⟩
  have hx : (⟨x⁻¹, hmem⟩ : R.integers) = ((u⁻¹ : (↥R.integers)ˣ) : R.integers) := Subtype.ext hinv.symm
  rw [hx]
  exact R.residue_ne_zero_of_isUnit (Units.isUnit _)

theorem gu_prod {ι : Type*} (R : RegularProlongation A F Fbar) (s : Finset ι) (x : ι → F)
    (hx : ∀ i ∈ s, ∃ h : x i ∈ R.integers, R.residue ⟨x i, h⟩ ≠ 0) :
    ∃ h : (∏ i ∈ s, x i) ∈ R.integers, R.residue ⟨∏ i ∈ s, x i, h⟩ ≠ 0 := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.prod_empty]; exact gu_one R
  | insert a s ha ih =>
    rw [Finset.prod_insert ha]
    exact gu_mul R (hx a (Finset.mem_insert_self a s)) (ih fun i hi => hx i (Finset.mem_insert_of_mem hi))

theorem gu_algebraMap (R : RegularProlongation A F Fbar) {c : L} (hcA : c ∈ A) (hu : IsUnit (⟨c, hcA⟩ : A)) :
    ∃ h : algebraMap L F c ∈ R.integers, R.residue ⟨algebraMap L F c, h⟩ ≠ 0 := by
  have hmem : algebraMap L F c ∈ R.integers := (R.algebraMap_mem_iff c).mpr hcA
  refine ⟨hmem, ?_⟩
  have h := R.residue_algebraMap ⟨c, hcA⟩
  have hx : (⟨algebraMap L F c, hmem⟩ : R.integers) =
      ⟨algebraMap L F ((⟨c, hcA⟩ : A) : L), (R.algebraMap_mem_iff _).mpr (⟨c, hcA⟩ : A).2⟩ := rfl
  rw [hx, h]
  intro h0
  have hres0 : IsLocalRing.residue A ⟨c, hcA⟩ = 0 :=
    (algebraMap (ResidueField A) Fbar).injective (by rw [h0, map_zero])
  rw [IsLocalRing.residue_eq_zero_iff] at hres0
  exact (IsLocalRing.mem_maximalIdeal _).mp hres0 hu

theorem ord_finset_prod {ι : Type*} (V : Place L F) (s : Finset ι) (f : ι → F) (hf : ∀ i ∈ s, f i ≠ 0) :
    V.ord (∏ i ∈ s, f i) = ∑ i ∈ s, V.ord (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.sum_insert ha,
      V.ord_mul (hf a (Finset.mem_insert_self a s))
        (Finset.prod_ne_zero_iff.mpr fun i hi => hf i (Finset.mem_insert_of_mem hi)),
      ih fun i hi => hf i (Finset.mem_insert_of_mem hi)]

theorem ord_pow' (V : Place L F) (f : F) (n : ℕ) : V.ord (f ^ n) = (n : ℤ) * V.ord f := by
  rw [← zpow_natCast, V.ord_zpow]

noncomputable def nfold (n : ℕ) (D : Divisor L F) : Divisor L F :=
  Finsupp.mapRange (fun m : ℤ => (n : ℤ) * m) (by simp) D

@[scoped simp] theorem nfold_apply (n : ℕ) (D : Divisor L F) (P : Place L F) : nfold n D P = (n : ℤ) * D P :=
  Finsupp.mapRange_apply ..

theorem support_nfold_subset (n : ℕ) (D : Divisor L F) : (nfold n D).support ⊆ D.support :=
  Finsupp.support_mapRange

theorem prod_nfold {Γ : Type*} [CommGroupWithZero Γ] (n : ℕ) (D : Divisor L F) (X : Place L F → Γ) :
    ((nfold n D).prod fun P m => X P ^ m) = (D.prod fun P m => X P ^ m) ^ n := by
  unfold nfold
  rw [Finsupp.prod_mapRange_index (fun _ => zpow_zero _)]
  simp only [Finsupp.prod]
  rw [← Finset.prod_pow]
  refine Finset.prod_congr rfl fun P _ => ?_
  rw [mul_comm, zpow_mul, zpow_natCast]

theorem valuation_finsupp_prod_zpow (E : Place L F →₀ ℤ) (x : Place L F → L) :
    A.valuation (E.prod fun P m => x P ^ m) = E.prod fun P m => A.valuation (x P) ^ m := by
  rw [map_finsuppProd]
  refine Finsupp.prod_congr fun P _ => ?_
  rw [map_zpow₀]

theorem isUnit_of_valuation_eq_one {x : L} (hx : A.valuation x = 1) : ∃ h : x ∈ A, IsUnit (⟨x, h⟩ : A) := by
  have hxA : x ∈ A := (A.valuation_le_one_iff x).mp hx.le
  refine ⟨hxA, ?_⟩
  have hx0 : x ≠ 0 := by
    intro h0; rw [h0, map_zero] at hx; exact zero_ne_one hx
  have hinvA : x⁻¹ ∈ A := (A.valuation_le_one_iff _).mp (by rw [map_inv₀, hx, inv_one])
  exact ⟨⟨⟨x, hxA⟩, ⟨x⁻¹, hinvA⟩, Subtype.ext (mul_inv_cancel₀ hx0), Subtype.ext (inv_mul_cancel₀ hx0)⟩, rfl⟩

end Generic

section Wide

variable {L : Type*} [Field L] [IsAlgClosed L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]

theorem exists_root_mem_maximalIdeal {π : L} (hπA : π ∈ A) (hπ : A.valuation π < 1) (hπ0 : π ≠ 0)
    {k : ℕ} (hk : 0 < k) :
    ∃ r : L, r ^ k = π ∧ ∃ hr : r ∈ A, (⟨r, hr⟩ : A) ∈ maximalIdeal A ∧ r ≠ 0 := by
  obtain ⟨r, hr⟩ := IsAlgClosed.exists_pow_nat_eq π hk
  have hr0 : r ≠ 0 := by rintro rfl; apply hπ0; rw [← hr, zero_pow hk.ne']
  have hvr : A.valuation r < 1 := by
    by_contra hle
    push Not at hle
    have : 1 ≤ A.valuation π := by
      rw [← hr, map_pow]; exact one_le_pow₀ hle
    exact absurd hπ (not_lt.mpr this)
  have hrA : r ∈ A := (A.valuation_le_one_iff r).mp hvr.le
  exact ⟨r, hr, hrA, (A.valuation_lt_one_iff ⟨r, hrA⟩).mpr hvr, hr0⟩

theorem wide_of_modulus_eq_pow_mul_unit (An : Annulus A F) {p e : ℕ} (he : 0 < e) {u : A} (hu : IsUnit u)
    (hmod : An.modulus = ((p : ℕ) : A) ^ e * u) (hp : ((p : ℕ) : A) ∈ maximalIdeal A) (hp0 : ((p : ℕ) : L) ≠ 0) :
    ∃ Q₁ ∈ An.dom, ∃ Q₂ ∈ An.dom, A.valuation (Q₁.evalAt An.param) ≠ A.valuation (Q₂.evalAt An.param) := by
  have hpA : ((p : ℕ) : L) ∈ A := by
    have : (((p : ℕ) : A) : L) = ((p : ℕ) : L) := by push_cast; rfl
    rw [← this]; exact Subtype.coe_prop _
  have hvp : A.valuation ((p : ℕ) : L) < 1 := by
    have := (A.valuation_lt_one_iff ((p : ℕ) : A)).mp hp
    simpa using this
  have hadm : ∀ {k : ℕ}, 2 ≤ k → ∀ r : L, r ^ k = (p : L) → ∀ hr : r ∈ A, (⟨r, hr⟩ : A) ∈ maximalIdeal A → r ≠ 0 →
      ∃ m ∈ maximalIdeal A, (An.modulus : L) = r * m := by
    intro k hk r hr hrA hrm hr0
    have hke : 1 ≤ k * e := Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) he.ne')
    refine ⟨⟨r, hrA⟩ ^ (k * e - 1) * u, ?_, ?_⟩
    · refine Ideal.mul_mem_right _ _ (Ideal.pow_mem_of_mem _ hrm _ ?_)
      have : 2 * 1 ≤ k * e := Nat.mul_le_mul hk he
      omega
    · rw [hmod]
      push_cast
      rw [← hr, ← pow_mul, ← mul_assoc, ← pow_succ', Nat.sub_add_cancel hke]
  obtain ⟨r₂, hr₂, hr₂A, hr₂m, hr₂0⟩ := exists_root_mem_maximalIdeal hpA hvp hp0 (k := 2) (by norm_num)
  obtain ⟨r₄, hr₄, hr₄A, hr₄m, hr₄0⟩ := exists_root_mem_maximalIdeal hpA hvp hp0 (k := 4) (by norm_num)
  obtain ⟨Q₁, ⟨hQ₁, hQ₁z⟩, -⟩ := An.existsUnique_evalAt_eq ⟨r₂, hr₂A⟩ hr₂m hr₂0 (hadm le_rfl r₂ hr₂ hr₂A hr₂m hr₂0)
  obtain ⟨Q₂, ⟨hQ₂, hQ₂z⟩, -⟩ := An.existsUnique_evalAt_eq ⟨r₄, hr₄A⟩ hr₄m hr₄0 (hadm (by norm_num) r₄ hr₄ hr₄A hr₄m hr₄0)
  refine ⟨Q₁, hQ₁, Q₂, hQ₂, ?_⟩
  change A.valuation (Q₁.evalAt An.param) ≠ A.valuation (Q₂.evalAt An.param)
  rw [show Q₁.evalAt An.param = r₂ from hQ₁z, show Q₂.evalAt An.param = r₄ from hQ₂z]
  intro heq
  have hv4 : A.valuation r₄ < 1 := by
    have := (A.valuation_lt_one_iff ⟨r₄, hr₄A⟩).mp hr₄m; simpa using this
  have h1 : A.valuation r₄ ^ 4 = A.valuation r₄ ^ 2 := by
    have h := congrArg A.valuation (hr₄.trans hr₂.symm)
    rw [map_pow, map_pow, heq] at h
    exact h
  have hv0 : A.valuation r₄ ≠ 0 := (map_ne_zero _).mpr hr₄0
  have h2 : A.valuation r₄ ^ 2 = 1 := by
    have h4 : A.valuation r₄ ^ 4 = A.valuation r₄ ^ 2 * A.valuation r₄ ^ 2 := by rw [← pow_add]
    rw [h4] at h1
    exact (mul_eq_right₀ (pow_ne_zero _ hv0)).mp h1
  have : A.valuation r₄ ^ 2 < 1 := pow_lt_one₀ zero_le' hv4 (by norm_num)
  exact absurd h2 this.ne

end Wide

