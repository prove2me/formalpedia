theorem OAI.GaussianPropeller.Reduction.remove_null_partition {A:Fin (k+1)→Set (Space d)} (hA:IsPartition A)
    (i:Fin (k+1)) (hi:gaussian d (A i)=0) :
    IsPartition (fun j:Fin k=>A (i.succAbove j)) := by sorry
