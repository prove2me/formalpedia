    b x * rootE h Q J x (F x) (b x) (Zf h F x) (Vf A x) (Wf b A x) (Df F b x) = deriv b x := by
  filter_upwards [ev_ne, S.eF, S.eb, ev_u h, S.hPC, S.branch] with x hx hF hb hu hPC hbr
