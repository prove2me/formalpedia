section

/-!
# Cadre algébrique du cœur affine (A6)

`S = ℂ[z₁, …, zₙ]`, et `A` une `S`-algèbre intègre, finie, compatible à `ℂ`. Les points sont
`Pts A = A →ₐ[ℂ] ℂ`, et `proj φ = (φ(z₁), …, φ(zₙ))`.

Un **bon élément** `u ∈ A` (`GoodElt`) a un conducteur `c ∈ S ∖ 0` (`c·A ⊆ S[u]`) et un
discriminant `δ ∈ S ∖ 0` (`δ ∈ (F, F')`, où `F = minpoly S u`). Au-dessus de `z` avec
`c(z) ≠ 0`, les points sont en bijection avec les racines de `F(z, ·)` (`ptOf`, `eq_ptOf`) ;
si de plus `δ(z) ≠ 0`, ces racines sont simples.
-/

open Polynomial

set_option linter.unusedSectionVars false

namespace FiniteFields.Betti.Connected

/-- L'anneau de polynômes `ℂ[z₁, …, zₙ]`. -/
abbrev Sn (n : ℕ) := MvPolynomial (Fin n) ℂ

variable {n : ℕ} (A : Type) [CommRing A] [Algebra ℂ A]
  [Algebra (Sn n) A] [IsScalarTower ℂ (Sn n) A]

/-- Les points complexes `Hom_ℂ(A, ℂ)`. -/
abbrev Pts := A →ₐ[ℂ] ℂ

variable {A}

/-- La projection de Noether `φ ↦ (φ(zᵢ))ᵢ`. -/
noncomputable def proj (φ : Pts A) : Fin n → ℂ := fun i ↦ φ (algebraMap (Sn n) A (MvPolynomial.X i))

theorem apply_algebraMap (φ : Pts A) (s : Sn n) :
    φ (algebraMap (Sn n) A s) = MvPolynomial.eval (proj φ) s := by
  have : (φ.comp (IsScalarTower.toAlgHom ℂ (Sn n) A)) = MvPolynomial.aeval (proj φ) :=
    MvPolynomial.algHom_ext fun i ↦ by simp [proj]
  have h := congrArg (fun ψ : Sn n →ₐ[ℂ] ℂ ↦ ψ s) this
  simpa [MvPolynomial.coe_aeval_eq_eval] using h

/-- `F(z, ·)` : le polynôme `F` spécialisé en `z`. -/
noncomputable def specz (F : (Sn n)[X]) (z : Fin n → ℂ) : ℂ[X] := F.map (MvPolynomial.eval z)

theorem eval_specz_apply (φ : Pts A) (F : (Sn n)[X]) (u : A) :
    φ (aeval u F) = (specz F (proj φ)).eval (φ u) := by
  rw [specz, eval_map, aeval_def, ← AlgHom.coe_toRingHom, hom_eval₂]
  congr 1
  refine RingHom.ext fun s ↦ ?_
  simp [apply_algebraMap]

/-- **Bon élément** : conducteur et discriminant non nuls. -/
structure GoodElt (n : ℕ) (A : Type) [CommRing A] [IsDomain A] [Algebra ℂ A] [Algebra (Sn n) A] where
  u : A
  c : Sn n
  δ : Sn n
  hc : c ≠ 0
  hδ : δ ≠ 0
  conductor : ∀ a : A, c • a ∈ Algebra.adjoin (Sn n) {u}
  bezout : ∃ a b : (Sn n)[X], a * minpoly (Sn n) u + b * derivative (minpoly (Sn n) u) = C δ

section Points

variable [IsDomain A] [Module.Finite (Sn n) A] [Module.IsTorsionFree (Sn n) A]

theorem isIntegral_u (e : GoodElt n A) : IsIntegral (Sn n) e.u := Algebra.IsIntegral.isIntegral _

/-- Le polynôme minimal `F = minpoly S u`. -/
noncomputable abbrev GoodElt.F (e : GoodElt n A) : (Sn n)[X] := minpoly (Sn n) e.u

theorem GoodElt.monic (e : GoodElt n A) : e.F.Monic := minpoly.monic (isIntegral_u e)

theorem specz_monic (e : GoodElt n A) (z : Fin n → ℂ) : (specz e.F z).Monic := e.monic.map _

theorem natDegree_specz (e : GoodElt n A) (z : Fin n → ℂ) :
    (specz e.F z).natDegree = e.F.natDegree := e.monic.natDegree_map _

/-- `φ(u)` est racine de `F(proj φ, ·)`. -/
theorem isRoot_apply_u (e : GoodElt n A) (φ : Pts A) : (specz e.F (proj φ)).IsRoot (φ e.u) := by
  rw [IsRoot.def, ← eval_specz_apply, minpoly.aeval, map_zero]

/-- L'évaluation `S[u] → ℂ`, `z ↦ z`, `u ↦ t`, pour une racine `t` de `F(z, ·)`. -/
noncomputable def evAdj (e : GoodElt n A) (z : Fin n → ℂ) (t : ℂ) (ht : (specz e.F z).IsRoot t) :
    Algebra.adjoin (Sn n) {e.u} →+* ℂ :=
  (AdjoinRoot.lift (MvPolynomial.eval z) t (by rwa [IsRoot.def, specz, eval_map] at ht)).comp
    (minpoly.equivAdjoin (isIntegral_u e)).symm.toRingEquiv.toRingHom

theorem evAdj_algebraMap (e : GoodElt n A) (z : Fin n → ℂ) (t : ℂ) (ht : (specz e.F z).IsRoot t)
    (s : Sn n) : evAdj e z t ht (algebraMap (Sn n) _ s) = MvPolynomial.eval z s := by
  simp only [evAdj, RingHom.coe_comp, Function.comp_apply]
  rw [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, AlgEquiv.coe_ringEquiv,
    AlgEquiv.commutes]
  exact AdjoinRoot.lift_of _

theorem evAdj_gen (e : GoodElt n A) (z : Fin n → ℂ) (t : ℂ) (ht : (specz e.F z).IsRoot t) :
    evAdj e z t ht ⟨e.u, Algebra.self_mem_adjoin_singleton _ _⟩ = t := by
  have : (minpoly.equivAdjoin (isIntegral_u e)).symm ⟨e.u, Algebra.self_mem_adjoin_singleton _ _⟩ =
      AdjoinRoot.root e.F := by
    rw [AlgEquiv.symm_apply_eq]
    rw [minpoly.coe_equivAdjoin, AdjoinRoot.root]
    exact Subtype.ext (AdjoinRoot.Minpoly.coe_toAdjoin_mk_X).symm
  simp only [evAdj, RingHom.coe_comp, Function.comp_apply]
  rw [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, AlgEquiv.coe_ringEquiv, this]
  exact AdjoinRoot.lift_root _

/-- `c · a ∈ S[u]`. -/
def cA (e : GoodElt n A) (a : A) : Algebra.adjoin (Sn n) {e.u} := ⟨e.c • a, e.conductor a⟩

theorem cA_mul (e : GoodElt n A) (a b : A) :
    cA e a * cA e b = algebraMap (Sn n) _ e.c * cA e (a * b) := by
  apply Subtype.ext
  simp only [cA, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Algebra.smul_def]
  ring

theorem cA_add (e : GoodElt n A) (a b : A) : cA e (a + b) = cA e a + cA e b :=
  Subtype.ext (smul_add _ _ _)

theorem cA_algebraMap (e : GoodElt n A) (s : Sn n) :
    cA e (algebraMap (Sn n) A s) = algebraMap (Sn n) _ (e.c * s) := by
  apply Subtype.ext
  simp [cA, Algebra.smul_def]

theorem cA_u (e : GoodElt n A) :
    cA e e.u = algebraMap (Sn n) _ e.c * ⟨e.u, Algebra.self_mem_adjoin_singleton _ _⟩ := by
  apply Subtype.ext
  simp [cA, Algebra.smul_def]

/-- **Le point au-dessus de `z` défini par la racine `t`** (`c(z) ≠ 0`). -/
noncomputable def ptOf (e : GoodElt n A) (z : Fin n → ℂ) (t : ℂ) (ht : (specz e.F z).IsRoot t)
    (hc : MvPolynomial.eval z e.c ≠ 0) : Pts A where
  toFun a := evAdj e z t ht (cA e a) / MvPolynomial.eval z e.c
  map_one' := by
    rw [show (1 : A) = algebraMap (Sn n) A 1 from (map_one _).symm, cA_algebraMap,
      evAdj_algebraMap, mul_one, div_self hc]
  map_mul' a b := by
    have h := congrArg (evAdj e z t ht) (cA_mul e a b)
    rw [map_mul, map_mul, evAdj_algebraMap] at h
    field_simp
    rw [h, mul_comm]
  map_zero' := by
    rw [show (0 : A) = algebraMap (Sn n) A 0 from (map_zero _).symm, cA_algebraMap,
      evAdj_algebraMap, mul_zero, map_zero, zero_div]
  map_add' a b := by
    rw [cA_add, map_add, add_div]
  commutes' r := by
    rw [IsScalarTower.algebraMap_apply ℂ (Sn n) A, cA_algebraMap, evAdj_algebraMap, map_mul,
      MvPolynomial.algebraMap_eq, MvPolynomial.eval_C, mul_div_cancel_left₀ _ hc]
    rfl

theorem ptOf_apply (e : GoodElt n A) (z : Fin n → ℂ) (t : ℂ) (ht : (specz e.F z).IsRoot t)
    (hc : MvPolynomial.eval z e.c ≠ 0) (a : A) :
    ptOf e z t ht hc a = evAdj e z t ht (cA e a) / MvPolynomial.eval z e.c := rfl

theorem proj_ptOf (e : GoodElt n A) (z : Fin n → ℂ) (t : ℂ) (ht : (specz e.F z).IsRoot t)
    (hc : MvPolynomial.eval z e.c ≠ 0) : proj (ptOf e z t ht hc) = z := by
  funext i
  rw [proj, ptOf_apply, cA_algebraMap, evAdj_algebraMap, map_mul, MvPolynomial.eval_X,
    mul_div_cancel_left₀ _ hc]

theorem ptOf_u (e : GoodElt n A) (z : Fin n → ℂ) (t : ℂ) (ht : (specz e.F z).IsRoot t)
    (hc : MvPolynomial.eval z e.c ≠ 0) : ptOf e z t ht hc e.u = t := by
  rw [ptOf_apply, cA_u, map_mul, evAdj_algebraMap, evAdj_gen, mul_div_cancel_left₀ _ hc]

/-- Un point coïncide avec `evAdj` sur `S[u]`. -/
theorem apply_eq_evAdj (e : GoodElt n A) (φ : Pts A) (x : Algebra.adjoin (Sn n) {e.u}) :
    φ x = evAdj e (proj φ) (φ e.u) (isRoot_apply_u e φ) x := by
  obtain ⟨x, hx⟩ := x
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact (evAdj_gen e _ _ _).symm
  | algebraMap s =>
    rw [show (⟨algebraMap (Sn n) A s, _⟩ : Algebra.adjoin (Sn n) {e.u}) =
      algebraMap (Sn n) _ s from rfl, evAdj_algebraMap]
    exact apply_algebraMap φ s
  | add x y hx hy ihx ihy =>
    rw [show (⟨x + y, Subalgebra.add_mem _ hx hy⟩ : Algebra.adjoin (Sn n) {e.u}) =
      ⟨x, hx⟩ + ⟨y, hy⟩ from rfl, map_add, ← ihx, ← ihy]
    exact map_add φ x y
  | mul x y hx hy ihx ihy =>
    rw [show (⟨x * y, Subalgebra.mul_mem _ hx hy⟩ : Algebra.adjoin (Sn n) {e.u}) =
      ⟨x, hx⟩ * ⟨y, hy⟩ from rfl, map_mul, ← ihx, ← ihy]
    exact map_mul φ x y

/-- **Unicité** : un point est déterminé par `proj φ` et `φ(u)` (si `c(proj φ) ≠ 0`). -/
theorem eq_ptOf (e : GoodElt n A) (φ : Pts A) (hc : MvPolynomial.eval (proj φ) e.c ≠ 0) :
    φ = ptOf e (proj φ) (φ e.u) (isRoot_apply_u e φ) hc := by
  ext a
  rw [ptOf_apply, ← apply_eq_evAdj, eq_div_iff hc]
  change _ = φ (e.c • a)
  rw [Algebra.smul_def, map_mul, apply_algebraMap, mul_comm]

end Points

section Fiber

theorem apply_smul (φ : Pts A) (t : Sn n) (a : A) :
    φ (t • a) = MvPolynomial.eval (proj φ) t * φ a := by
  rw [Algebra.smul_def, map_mul, apply_algebraMap]

/-- Deux points de même projection qui coïncident sur une partie `S`-génératrice sont égaux. -/
theorem eq_of_span {ι : Type*} (b : ι → A) (hb : Submodule.span (Sn n) (Set.range b) = ⊤)
    (φ ψ : Pts A) (hp : proj (n := n) φ = proj ψ) (h : ∀ i, φ (b i) = ψ (b i)) : φ = ψ := by
  ext a
  have ha : a ∈ Submodule.span (Sn n) (Set.range b) := hb ▸ Submodule.mem_top
  induction ha using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact h i
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, map_add, hx, hy]
  | smul t x _ hx => rw [apply_smul, apply_smul, hx, hp]

/-- `φ(a)` est racine de `minpoly S a` spécialisé en `proj φ`. -/
theorem isRoot_apply (φ : Pts A) {a : A} :
    (specz (minpoly (Sn n) a) (proj φ)).IsRoot (φ a) := by
  rw [IsRoot.def, ← eval_specz_apply, minpoly.aeval, map_zero]

variable [Module.Finite (Sn n) A]

/-- **Les fibres de `proj` sont finies.** -/
theorem finite_fiber (z : Fin n → ℂ) : {φ : Pts A | proj φ = z}.Finite := by
  obtain ⟨r, b, hb⟩ := Module.Finite.exists_fin (R := Sn n) (M := A)
  let R : Fin r → Set ℂ := fun i ↦ {t | (specz (minpoly (Sn n) (b i)) z).IsRoot t}
  have hR : ∀ i, (R i).Finite := fun i ↦ by
    have hm : (specz (minpoly (Sn n) (b i)) z).Monic :=
      (minpoly.monic (Algebra.IsIntegral.isIntegral (b i))).map _
    exact Polynomial.finite_setOfPred_isRoot hm.ne_zero
  let f : Pts A → (Fin r → ℂ) := fun φ i ↦ φ (b i)
  refine Set.Finite.of_finite_image (f := f) ((Set.Finite.pi hR).subset ?_) ?_
  · rintro _ ⟨φ, hφ, rfl⟩
    simp only [Set.mem_pi, Set.mem_univ, true_implies]
    intro i
    have := isRoot_apply (n := n) φ (a := b i)
    rwa [show proj φ = z from hφ] at this
  · exact fun φ hφ ψ hψ h ↦ eq_of_span b hb φ ψ (hφ.trans hψ.symm) fun i ↦ congrFun h i

end Fiber

end FiniteFields.Betti.Connected

end

