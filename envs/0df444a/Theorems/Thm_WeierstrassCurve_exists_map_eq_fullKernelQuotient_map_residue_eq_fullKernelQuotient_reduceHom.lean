-- title:
--   Vélu's full-kernel quotient commutes with reduction
-- statement:
--   Let $L$ be a field, $A\subseteq L$ a valuation subring with residue field $\mathrm{ResidueField}(A)$ and residue map $\mathrm{residue}\,A$, and let $W$ be a Weierstrass curve with coefficients in $A$ whose reduction $W.\mathrm{map}(\mathrm{residue}\,A)$ has nonzero discriminant, so that the additive reduction map `reduceHom` from the points of the base change $W.\mathrm{map}\,A.\mathrm{subtype}$ over $L$ to the points of the reduction is available (it sends the point at infinity to itself, an affine point $(x,y)$ with $x\in A$ to the pair of residues, and any other affine point to the point at infinity). Let $N\in\mathbb{N}$ and let $Q$ be an $L$-point of $W.\mathrm{map}\,A.\mathrm{subtype}$ whose reduction has additive order exactly $N$. Here, for a curve $V$ over a field and a point $P$, $V.\mathrm{fullKernelQuotient}\,P\,N$ is the Vélu model $(a_1,a_2,a_3,a_4-5t,a_6-b_2t-7w)$ with $t=\sum g_x(x_0,y_0)$ and $w=\sum\bigl(x_0g_x(x_0,y_0)-y_0g_y(x_0,y_0)\bigr)$, the sums running over the finite set of coordinate pairs $(x_0,y_0)$ of the multiples $kP$ for $1\le k\le N-1$ (the point at infinity contributing $(0,0)$), where $g_x=3x^2+2a_2x+a_4-a_1y$ and $g_y=-(2y+a_1x+a_3)$. The assertion is that there exists a Weierstrass curve $W'$ over $A$ whose base change to $L$ equals $(W.\mathrm{map}\,A.\mathrm{subtype}).\mathrm{fullKernelQuotient}\,Q\,N$ and whose reduction equals $(W.\mathrm{map}(\mathrm{residue}\,A)).\mathrm{fullKernelQuotient}$ of the reduction of $Q$ at $N$, and moreover that whenever the latter quotient has nonzero discriminant, the quotient over $L$ also has nonzero discriminant, its $j$-invariant (formed using the invertibility of that discriminant) lies in $A$, and the residue of that element of $A$ is the $j$-invariant of the quotient over the residue field.
--
--   This is the statement that Vélu's formulae for the quotient by the cyclic subgroup generated by a point of order $N$ produce a curve with integral coefficients and commute with reduction at a valuation subring, together with the resulting congruence between the $j$-invariants of the two quotients. It is used in the study of moduli points of modular curves, in particular for the compatibility of Atkin–Lehner involutions and of $q$-expansions with the reduction of full-kernel quotients.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_WeierstrassCurve_exists_map_eq_fullKernelQuotient_map_residue_eq_fullKernelQuotient_reduceHom.lean

import Mathlib
import Definitions.Def_WeierstrassCurve_FullKernelQuotient
import Definitions.Def_WeierstrassCurve_ReduceHom

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open WeierstrassCurve IsLocalRing

universe u in

theorem WeierstrassCurve.exists_map_eq_fullKernelQuotient_map_residue_eq_fullKernelQuotient_reduceHom
    {L : Type u} [Field L] [DecidableEq L] {A : ValuationSubring L} [DecidableEq (ResidueField A)]
    {W : WeierstrassCurve A} (hΔ : (W.map (residue A)).Δ ≠ 0)
    (N : ℕ) (Q : (W.map A.subtype).toAffine.Point) (hQ : addOrderOf (reduceHom hΔ Q) = N) :
    ∃ W' : WeierstrassCurve A,
      W'.map A.subtype = (W.map A.subtype).fullKernelQuotient Q N ∧
      W'.map (residue A) = (W.map (residue A)).fullKernelQuotient (reduceHom hΔ Q) N ∧
      ∀ hΔ₀ : ((W.map (residue A)).fullKernelQuotient (reduceHom hΔ Q) N).Δ ≠ 0,
        ∃ (hΔ' : ((W.map A.subtype).fullKernelQuotient Q N).Δ ≠ 0)
          (hmem : @WeierstrassCurve.j L _ ((W.map A.subtype).fullKernelQuotient Q N)
              ⟨isUnit_iff_ne_zero.mpr hΔ'⟩ ∈ A),
          residue A ⟨_, hmem⟩ =
            @WeierstrassCurve.j (ResidueField A) _
              ((W.map (residue A)).fullKernelQuotient (reduceHom hΔ Q) N)
              ⟨isUnit_iff_ne_zero.mpr hΔ₀⟩ := by sorry
