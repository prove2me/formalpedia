theorem TensorProduct.mk_one_injective_of_flat (p : ℕ) [Fact p.Prime] {M : Type*} [AddCommGroup M] [Module ℤ_[p] M]
    [Module.Flat ℤ_[p] M] : Function.Injective (TensorProduct.mk ℤ_[p] ℚ_[p] M 1) := by
  have h1 : Function.Injective ((Algebra.linearMap ℤ_[p] ℚ_[p]).rTensor M) :=
    Module.Flat.rTensor_preserves_injective_linearMap _ (IsFractionRing.injective ℤ_[p] ℚ_[p])
  have h2 : (TensorProduct.mk ℤ_[p] ℚ_[p] M 1 : M → ℚ_[p] ⊗[ℤ_[p]] M)
      = ((Algebra.linearMap ℤ_[p] ℚ_[p]).rTensor M) ∘ (TensorProduct.lid ℤ_[p] M).symm := by
    funext m
    simp [LinearMap.rTensor_tmul]
  rw [h2]
  exact h1.comp (TensorProduct.lid ℤ_[p] M).symm.injective

