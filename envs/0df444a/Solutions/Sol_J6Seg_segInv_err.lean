-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section glob
variable {s t α : ℕ} {B : Blocks}

lemma mem_blS {i k : ℕ} : k ∈ blS B i ↔ B.st i ≤ k ∧ k < B.st i + B.len i := by
  simp [blS]

lemma blS_self (hB : BlocksOK s t B) {i : ℕ} (hi : i < s) : i ∈ blS B i := by
  have := hB.cover i hi; rw [mem_blS]; omega

lemma blS_lt (hB : BlocksOK s t B) {i k : ℕ} (hi : i < s) (hk : k ∈ blS B i) : k < s := by
  have := hB.cover i hi; rw [mem_blS] at hk; omega

lemma blS_eq (hB : BlocksOK s t B) {i k : ℕ} (hi : i < s) (hk : k ∈ blS B i) :
    blS B k = blS B i := by
  rw [mem_blS] at hk
  obtain ⟨h1, h2⟩ := hB.cons i hi k hk.1 hk.2
  simp only [blS, h1, h2]

lemma MxG_loc (hB : BlocksOK s t B) (hs : 0 < s) {i : ℕ} (hi : i < s) {u v : ℕ}
    (hu : u < B.len i) (hv : v < B.len i) :
    MxG s t α (B.st i + u) (B.st i + v) =
      MF (α : ℝ) ((t : ℝ) / s) ((bOf s t (B.st i) : ℝ) / s) u v := by
  unfold MxG
  by_cases huv : u = v
  · subst huv
    rw [MF_diag, kd_self]; simp [eEx]
  · have hk : kd (B.st i + u) (B.st i + v) = 0 := by simp [kd]; omega
    rw [hk, zero_add]
    have e1 : (((B.st i + v : ℕ) : ℤ) - ((B.st i + u : ℕ) : ℤ)) = (v : ℤ) - u := by push_cast; ring
    have e2 : (((B.st i + u : ℕ) : ℤ)) = (B.st i : ℤ) + u := by push_cast; ring
    rw [e1, e2]
