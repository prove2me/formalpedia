/-!
# Exact bridges for compact low-degree consistency

This module identifies the compact effect sums and three low-degree defects
with the corresponding library measurements and consistency defects.  It also
gives the inverse numerical-record conversion needed to apply the registered
soundness theorem to compact parameters.

## References

`references/qpbt-paper/06_nonlocal_games_and_mipstar.tex:232-248` and
`references/qpbt-paper/08_classical_and_quantum_low_degree_tests.tex:394-440`.
-/

@[expose] public section

open scoped BigOperators

namespace MIPStarRE.QPBT.Palomar

open LIDT.MIPStarRE.LDT LIDT.MIPStarRE.Quantum

noncomputable section

/-- A compact parameter record carries the registered admissible-size predicate. -/
theorem LowDegreeParams.is_admissible_size (P : _root_.MIPStarRE.QPBT.Palomar.LowDegreeParams) :
    _root_.MIPStarRE.QPBT.IsAdmissibleSize P.q :=
  P.hq

/-- Copy compact numerical parameters into the registered low-degree domain. -/
def LowDegreeParams.toLdParams (P : _root_.MIPStarRE.QPBT.Palomar.LowDegreeParams) : _root_.MIPStarRE.QPBT.LdParams where
  q := P.q
  m := P.m
  d := P.d
  k := P.k
  hm := P.hm
  hd := P.hd
  hk := P.hk
  hq := P.is_admissible_size
  hdvd := P.hdvd

/-- Compact parameters are recovered exactly after conversion to the library record. -/
@[simp] theorem LowDegreeParams.ofLdParams_toLdParams (P : _root_.MIPStarRE.QPBT.Palomar.LowDegreeParams) :
    _root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams P.toLdParams = P := by
  cases P
  rfl

/-- Library parameters are recovered exactly after conversion to the compact record. -/
@[simp] theorem LowDegreeParams.toLdParams_ofLdParams (P : _root_.MIPStarRE.QPBT.LdParams) :
    (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams P).toLdParams = P := by
  cases P
  rfl

/-- Compact postprocessing of a converted library measurement has the original effect. -/
@[simp] theorem postprocessEffect_ofMeasurement {A B I : Type*}
    [Fintype A] [DecidableEq A] [Fintype B] [DecidableEq B]
    [Fintype I] [DecidableEq I] (M : _root_.LIDT.MIPStarRE.Quantum.Measurement A I)
    (f : A → B) (b : B) :
    _root_.MIPStarRE.QPBT.Palomar.postprocessEffect (_root_.MIPStarRE.QPBT.Palomar.POVM.ofMeasurement M) f b = (M.postprocess f).effect b :=
  rfl





/-- Compact and library point questions agree under the question equivalence. -/
@[simp] theorem lowDegreeQuestionEquiv_symm_point (L : _root_.MIPStarRE.QPBT.LdParams)
    (u : Fin L.m → _root_.MIPStarRE.QPBT.ScalarQ L) :
    (_root_.MIPStarRE.QPBT.Palomar.lowDegreeQuestionEquiv L).symm (_root_.MIPStarRE.QPBT.ldPointQuestionOf L u) =
      _root_.MIPStarRE.QPBT.Palomar.lowDegreePointQuestion (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams L) u := by
  rfl

/-- The wrong-form-to-zero point map is unchanged by answer relabeling. -/
@[simp] theorem ldPointValuesOrZero_answerEquiv (L : _root_.MIPStarRE.QPBT.LdParams)
    (a : _root_.MIPStarRE.QPBT.Palomar.LowDegreeAnswer (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams L)
      (_root_.MIPStarRE.QPBT.ScalarQ L)) :
    _root_.MIPStarRE.QPBT.ldPointValuesOrZero L (_root_.MIPStarRE.QPBT.Palomar.lowDegreeAnswerEquiv L a) =
      _root_.MIPStarRE.QPBT.Palomar.lowDegreePointValuesOrZero a := by
  rcases a with a | (a | a) <;> rfl

/-- Compact and library polynomial-tuple evaluation are definitionally identical. -/
@[simp] theorem evalLowDegreePolynomialTuple_eq (L : _root_.MIPStarRE.QPBT.LdParams)
    (u : Fin L.m → _root_.MIPStarRE.QPBT.ScalarQ L)
    (g : _root_.MIPStarRE.QPBT.Palomar.LowDegreePolynomialTuple (_root_.MIPStarRE.QPBT.Palomar.LowDegreeParams.ofLdParams L)
      (_root_.MIPStarRE.QPBT.ScalarQ L)) :
    _root_.MIPStarRE.QPBT.Palomar.evalLowDegreePolynomialTuple u g = _root_.MIPStarRE.QPBT.evalPolyTupleAt u g :=
  rfl













/-- The compact error function is definitionally the registered `deltaLd`. -/
@[simp] theorem deltaLd_eq_library (a b ε : ℝ) (q m d k : ℕ) :
    _root_.MIPStarRE.QPBT.Palomar.deltaLd a b ε q m d k = _root_.MIPStarRE.QPBT.deltaLd a b ε q m d k :=
  rfl

