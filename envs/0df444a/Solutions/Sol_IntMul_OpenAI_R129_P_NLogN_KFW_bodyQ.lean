/-- **The scalar pass `b^D`.** -/
theorem mdQ {σ : Fin HS → Option ℤ} {K S r H P D ρ k q0 Bp Z Mb Bz : ℕ} (lo hi : ℕ)
    (hC : CoreR σ K S r H P D ρ k q0 Bp) (hρ : ρ < K) (hS : 1 ≤ S) (hP : 1 ≤ P) (hr : 1 ≤ r)
    (hD : 1 ≤ D) (hZ16 : zsz ((16 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z)
    (hMb : zsz (Mb : ℤ) ≤ Bz) (hM : K * D + P + 10 ≤ Mb) :
    SImplQ Isym tbl (fun s => Agree σ s) lo hi r (fun x : Fin D => KFH.stT K D S ρ x)
      (P * 2 ^ (K * D) * S) (tensF (kerAt (⟨0, hD⟩ : Fin D) (Butterfly.cb ^ D • (1 : M2))))
      mdC (D / 2 + D % 2) 2
      (fun w => 7 * cMdT Bz + cMdK (P * 2 ^ (K * D) * S * r) Z Bz w) :=
  mdTQ lo hi hρ hS hP hr hD hZ16 hMb hM 7 0 σ hC (Nat.zero_le _)
    (by have := Nat.mod_lt D (show 0 < 8 by norm_num); omega) (by omega)

