theorem GlobalTheory.CompanionTheory.SW.RingDiag.cT_uni_mul (σ : A →+* A) (P : Matrix (Fin (m + 1)) (Fin (m + 1)) A) (r : Fin m → A)
    (j : Fin (m + 1)) :
    (cT σ (uni r) * P) 0 j = P 0 j ∧
      ∀ i : Fin m, (cT σ (uni r) * P) i.succ j = P i.succ j + σ (r i) * P 0 j := by sorry
