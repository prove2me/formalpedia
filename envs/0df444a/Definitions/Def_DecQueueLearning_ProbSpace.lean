-- title:
--   The probability space of arrivals, service coins, perturbations and exploration samples
-- statement:
--   All randomness is generated by five mutually independent families of primitives:
--   1. arrivals $A_i(t)\sim\mathrm{Bernoulli}(\lambda_i)$, for every queue $i$ and slot $t$;
--   2. service coins $S_{i,j}(t)\sim\mathrm{Bernoulli}(\mu_{i,j})$, for every pair and slot; a request of $i$ to $j$ selected by $j$ at slot $t$ succeeds iff $S_{i,j}(t)=1$;
--   3. perturbations $\eta_i\sim\mathrm{Uniform}(0,10^{-9})$, one per queue;
--   4. exploration coins $E_{\ell,i}\sim\mathrm{Bernoulli}(q_\ell)$, one per queue and epoch;
--   5. explored servers $\sigma_{\ell,i}\sim\mathrm{Uniform}(\mathcal K)$, one per queue and epoch.
--
--   The measure for DAM.K takes $q_\ell=0$ (it never explores); the measure for DAM.FE with parameter $\gamma$ takes $q_\ell=\min(1,K/\ell^\gamma)$.
--
--   **Formalization Note** The space is the product of the five coordinate spaces with the product of the laws (`Measure.infinitePi`, `Measure.pi`, `Measure.prod`); it is a probability measure (proved in the mission's sanity file). The Bernoulli parameter is clipped to $[0,1]$, which changes nothing for the parameters used.
-- source:
--   Freund, Lykouris, Weng, Efficient decentralized multi-agent learning in asymmetric bipartite queueing systems, arXiv:2206.03324v3, §2 p. 6; Algorithm 1 p. 10; Algorithm 4 lines 2, 6, 8, p. 17

import Mathlib
import Definitions.Def_DecQueueLearning_System

open MeasureTheory ProbabilityTheory

namespace DecQueueLearning

/-- **The sample space** of the primitive randomness, arXiv:2206.03324v3, §2 (p. 6) and
Algorithms 1 and 4 (pp. 10, 17). A point `ω` consists of
1. the arrivals `A t i` (`= true` iff queue `i` receives a new job in slot `t`);
2. the service coins `S t i j` (`= true` iff a request of queue `i` to server `j` in slot `t`
   would be successful when `j` selects `i`);
3. the price perturbations `ηᵢ`;
4. the exploration coins `E ℓ i` of queue `i` in epoch `ℓ` (Algorithm 4, line 6);
5. the explored servers `X ℓ i` (Algorithm 4, line 8). -/
abbrev Omega (N K : ℕ) :=
  (ℕ → Fin N → Bool) × (ℕ → Fin N → Fin K → Bool) × (Fin N → ℝ) × (ℕ → Fin N → Bool) ×
    (ℕ → Fin N → Fin K)

/-- The arrivals `Aᵢ(t)`. -/
def arrivals {N K : ℕ} (ω : Omega N K) : ℕ → Fin N → Bool := ω.1
/-- The service coins `S t i j`. -/
def services {N K : ℕ} (ω : Omega N K) : ℕ → Fin N → Fin K → Bool := ω.2.1
/-- The price perturbations `ηᵢ`. -/
def eta {N K : ℕ} (ω : Omega N K) : Fin N → ℝ := ω.2.2.1
/-- The exploration coins `E_ℓ` of each queue. -/
def exploreCoin {N K : ℕ} (ω : Omega N K) : ℕ → Fin N → Bool := ω.2.2.2.1
/-- The explored servers. -/
def exploreServer {N K : ℕ} (ω : Omega N K) : ℕ → Fin N → Fin K := ω.2.2.2.2

/-- The Bernoulli law on `Bool` with `P{true} = p` (for `p ∈ [0, 1]`; `p` is clipped to `[0, 1]`
otherwise). -/
noncomputable def bern (p : ℝ) : Measure Bool :=
  bernoulliMeasure true false (Set.projIcc 0 1 zero_le_one p)

/-- The uniform law on `(0, 10⁻⁹)`, the law of each `ηᵢ` (Algorithm 1 and Algorithm 4, line 2). -/
noncomputable def etaLaw : Measure ℝ :=
  (10 ^ 9 : NNReal) • volume.restrict (Set.Ioo (0 : ℝ) (1 / 10 ^ 9))

/-- The exploration probability `min(1, K/ℓ^γ)` of epoch `ℓ` (Algorithm 4, line 6). -/
noncomputable def exploreProb (K : ℕ) (γ : ℝ) (ℓ : ℕ) : ℝ := min 1 ((K : ℝ) / (ℓ : ℝ) ^ γ)

/-- **The probability measure** on `Omega N K`: all primitives are mutually independent, with
`Aᵢ(t) ~ Bernoulli(λᵢ)`, `S t i j ~ Bernoulli(µᵢⱼ)`, `ηᵢ ~ Uniform(0, 10⁻⁹)`,
`E ℓ i ~ Bernoulli(q ℓ)` and `X ℓ i ~ Uniform(𝒦)`. -/
noncomputable def probMeasure {N K : ℕ} [NeZero K] (s : System N K) (q : ℕ → ℝ) :
    Measure (Omega N K) :=
  (Measure.infinitePi fun _ : ℕ => Measure.pi fun i => bern (s.lam i)).prod
    ((Measure.infinitePi fun _ : ℕ => Measure.pi fun i => Measure.pi fun j => bern (s.mu i j)).prod
      ((Measure.pi fun _ : Fin N => etaLaw).prod
        ((Measure.infinitePi fun ℓ : ℕ => Measure.pi fun _ : Fin N => bern (q ℓ)).prod
          (Measure.infinitePi fun _ : ℕ => Measure.pi fun _ : Fin N =>
            (PMF.uniformOfFintype (Fin K)).toMeasure))))

/-- The measure for DAM.K (Algorithm 1), which uses no exploration coins (they are set to
`Bernoulli(0)` and never read). -/
noncomputable def damKMeasure {N K : ℕ} [NeZero K] (s : System N K) : Measure (Omega N K) :=
  probMeasure s fun _ => 0

/-- The measure for DAM.FE (Algorithm 4) with exploration parameter `γ`: `E ℓ i ~
Bernoulli(min(1, K/ℓ^γ))`. -/
noncomputable def damFEMeasure {N K : ℕ} [NeZero K] (s : System N K) (γ : ℝ) :
    Measure (Omega N K) :=
  probMeasure s (exploreProb K γ)

end DecQueueLearning


