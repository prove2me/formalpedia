    (hA0 : 1 ≤ vol A0) (hq : 1 ≤ q) (hB : 1 ≤ vol B) (hC : 1 ≤ vol Cs)
    (hV : zsz ((vol (A0 ++ q :: (B ++ q :: Cs)) : ℕ) : ℤ) ≤ Bb)
    (ga : GoodE t Bb a) (gq : GoodE t Bb eq) (gb : GoodE t Bb b) (gc : GoodE t Bb c)
    (ea : a.eval t = vol A0) (eq' : eq.eval t = q) (eb : b.eval t = vol B) (ec : c.eval t = vol Cs) :
    IRuns I iprog (swapEF a eq b c) t
      (t.upd 0 (ints (AModel.pull (A0 ++ q :: (B ++ q :: Cs)) (A0 ++ q :: (B ++ q :: Cs))
