  have f31 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 3 x)
  have f32 := ccontr_antisymm (hFa x hx) (fvec E 2 x) (fvec E 3 x)
  have fdg : ∀ A, FfrF F E A A x = 0 := fun A => by
    have h := ccontr_antisymm (hFa x hx) (fvec E A x) (fvec E A x); unfold FfrF; linear_combination h / 2
  have g10 : ∀ D, fdir E D (FfrF F E 1 0) x = -fdir E D (FfrF F E 0 1) x := fun D => fdir_FfrF_swap hF hFa hx 0 1 D
  have g20 : ∀ D, fdir E D (FfrF F E 2 0) x = -fdir E D (FfrF F E 0 2) x := fun D => fdir_FfrF_swap hF hFa hx 0 2 D
  have g30 : ∀ D, fdir E D (FfrF F E 3 0) x = -fdir E D (FfrF F E 0 3) x := fun D => fdir_FfrF_swap hF hFa hx 0 3 D
  have g21 : ∀ D, fdir E D (FfrF F E 2 1) x = -fdir E D (FfrF F E 1 2) x := fun D => fdir_FfrF_swap hF hFa hx 1 2 D
  have g31 : ∀ D, fdir E D (FfrF F E 3 1) x = -fdir E D (FfrF F E 1 3) x := fun D => fdir_FfrF_swap hF hFa hx 1 3 D
  have g32 : ∀ D, fdir E D (FfrF F E 3 2) x = -fdir E D (FfrF F E 2 3) x := fun D => fdir_FfrF_swap hF hFa hx 2 3 D
  have gdg : ∀ D A, fdir E D (FfrF F E A A) x = 0 := fun D A => by
    have h := fdir_FfrF_swap hF hFa hx A A D; linear_combination h / 2
  change FfrF F E 1 0 x = -FfrF F E 0 1 x at f10
  change FfrF F E 2 0 x = -FfrF F E 0 2 x at f20
  change FfrF F E 3 0 x = -FfrF F E 0 3 x at f30
  change FfrF F E 2 1 x = -FfrF F E 1 2 x at f21
  change FfrF F E 3 1 x = -FfrF F E 1 3 x at f31
  change FfrF F E 3 2 x = -FfrF F E 2 3 x at f32
  simp only [f10, f20, f30, f21, f31, f32, fdg, g10, g20, g30, g21, g31, g32, gdg]
  try (clear f10 f20 f30 f21 f31 f32 fdg g10 g20 g30 g21 g31 g32 gdg)))
  ring))

/-- **NP Maxwell equation 3 with sources**: `δΦ₁ − ΔΦ₀ − (μ − 2γ)Φ₀ − 2τΦ₁ + σΦ₂ = ½ (θ^{m̄}(J) + H(n, m, l))`. -/
theorem np_maxwell_3 (hN : NullFrameData g gi E Θ U) (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    (hFa : ∀ y ∈ U, ∀ i j, F i j y = -F j i y) {x : Pt 4} (hx : x ∈ U) :
    fdir E 2 (fun z => phi1 E z F) x - fdir E 1 (FfrF F E 0 2) x
      - (npMu g gi E Θ x - 2 * npGamma g gi E Θ x) * phi0 E x F - 2 * npTau g gi E Θ x * phi1 E x F
      + npSigma g gi E Θ x * phi2 E x F
      = (Jfr g gi F Θ 3 x + Hfr F E 1 2 0 x) / 2 := by
  have hF := hN.toFrameData
  rw [fdir_phi1 hF hFs hx]
  ( (
  rw [frame_dF hN.toFrameData hFs hFa hx, frame_divF hN hFs hx]
  simp only [fdir_Fup hN.toFrameData hFs hx, Fup, Fin.sum_univ_four, NullFrameData.Omega_eq_omL, cfr_eq_cL',
    hN.cL_eq_omL hx]
  ( (
  obtain ⟨e00, e01, e02, e03, e10, e11, e12, e13, e20, e21, e22, e23, e30, e31, e32, e33⟩ := eta_vals
  simp only [Fin.sum_univ_four, NullFrameData.Omega_eq_omL, cfr_eq_cL', e00, e01, e02, e03, e10, e11, e12,
    e13, e20, e21, e22, e23, e30, e31, e32, e33, zero_mul, mul_zero, add_zero, zero_add, sub_zero, zero_sub,
    neg_zero, one_mul, mul_one, neg_mul, mul_neg, neg_neg, zero_div]
  try (clear e00 e01 e02 e03 e10 e11 e12 e13 e20 e21 e22 e23 e30 e31 e32 e33)))
  ( (
  have f10 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 1 x)
  have f20 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 2 x)
  have f30 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 3 x)
  have f21 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 2 x)
  have f31 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 3 x)
  have f32 := ccontr_antisymm (hFa x hx) (fvec E 2 x) (fvec E 3 x)
  have fdg : ∀ A, FfrF F E A A x = 0 := fun A => by
    have h := ccontr_antisymm (hFa x hx) (fvec E A x) (fvec E A x); unfold FfrF; linear_combination h / 2
  have g10 : ∀ D, fdir E D (FfrF F E 1 0) x = -fdir E D (FfrF F E 0 1) x := fun D => fdir_FfrF_swap hF hFa hx 0 1 D
  have g20 : ∀ D, fdir E D (FfrF F E 2 0) x = -fdir E D (FfrF F E 0 2) x := fun D => fdir_FfrF_swap hF hFa hx 0 2 D
  have g30 : ∀ D, fdir E D (FfrF F E 3 0) x = -fdir E D (FfrF F E 0 3) x := fun D => fdir_FfrF_swap hF hFa hx 0 3 D
  have g21 : ∀ D, fdir E D (FfrF F E 2 1) x = -fdir E D (FfrF F E 1 2) x := fun D => fdir_FfrF_swap hF hFa hx 1 2 D
  have g31 : ∀ D, fdir E D (FfrF F E 3 1) x = -fdir E D (FfrF F E 1 3) x := fun D => fdir_FfrF_swap hF hFa hx 1 3 D
  have g32 : ∀ D, fdir E D (FfrF F E 3 2) x = -fdir E D (FfrF F E 2 3) x := fun D => fdir_FfrF_swap hF hFa hx 2 3 D
  have gdg : ∀ D A, fdir E D (FfrF F E A A) x = 0 := fun D A => by
    have h := fdir_FfrF_swap hF hFa hx A A D; linear_combination h / 2
  change FfrF F E 1 0 x = -FfrF F E 0 1 x at f10
  change FfrF F E 2 0 x = -FfrF F E 0 2 x at f20
  change FfrF F E 3 0 x = -FfrF F E 0 3 x at f30
  change FfrF F E 2 1 x = -FfrF F E 1 2 x at f21
  change FfrF F E 3 1 x = -FfrF F E 1 3 x at f31
  change FfrF F E 3 2 x = -FfrF F E 2 3 x at f32
  simp only [f10, f20, f30, f21, f31, f32, fdg, g10, g20, g30, g21, g31, g32, gdg]
  try (clear f10 f20 f30 f21 f31 f32 fdg g10 g20 g30 g21 g31 g32 gdg)))
  simp only [npPi, npAlpha, npRho, npKappa, npMu, npGamma, npTau, npSigma, npLambda, npEps, npNu, npBeta,
    phi0, phi1, phi2]
  ( (
  have hd : ∀ C A, omL g gi E Θ C A C x = 0 := fun C A => by
    have h := hN.omL_antisymm hx C A C; linear_combination h / 2
  have a10 : ∀ A, omL g gi E Θ 1 A 0 x = -omL g gi E Θ 0 A 1 x := fun A => hN.omL_antisymm hx 1 A 0
  have a20 : ∀ A, omL g gi E Θ 2 A 0 x = -omL g gi E Θ 0 A 2 x := fun A => hN.omL_antisymm hx 2 A 0
  have a30 : ∀ A, omL g gi E Θ 3 A 0 x = -omL g gi E Θ 0 A 3 x := fun A => hN.omL_antisymm hx 3 A 0
  have a21 : ∀ A, omL g gi E Θ 2 A 1 x = -omL g gi E Θ 1 A 2 x := fun A => hN.omL_antisymm hx 2 A 1
  have a31 : ∀ A, omL g gi E Θ 3 A 1 x = -omL g gi E Θ 1 A 3 x := fun A => hN.omL_antisymm hx 3 A 1
  have a32 : ∀ A, omL g gi E Θ 3 A 2 x = -omL g gi E Θ 2 A 3 x := fun A => hN.omL_antisymm hx 3 A 2
  simp only [hd, a10, a20, a30, a21, a31, a32]
  try (clear hd a10 a20 a30 a21 a31 a32)))
  ( (
  have f10 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 1 x)
  have f20 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 2 x)
  have f30 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 3 x)
  have f21 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 2 x)
  have f31 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 3 x)
  have f32 := ccontr_antisymm (hFa x hx) (fvec E 2 x) (fvec E 3 x)
  have fdg : ∀ A, FfrF F E A A x = 0 := fun A => by
    have h := ccontr_antisymm (hFa x hx) (fvec E A x) (fvec E A x); unfold FfrF; linear_combination h / 2
  have g10 : ∀ D, fdir E D (FfrF F E 1 0) x = -fdir E D (FfrF F E 0 1) x := fun D => fdir_FfrF_swap hF hFa hx 0 1 D
  have g20 : ∀ D, fdir E D (FfrF F E 2 0) x = -fdir E D (FfrF F E 0 2) x := fun D => fdir_FfrF_swap hF hFa hx 0 2 D
  have g30 : ∀ D, fdir E D (FfrF F E 3 0) x = -fdir E D (FfrF F E 0 3) x := fun D => fdir_FfrF_swap hF hFa hx 0 3 D
  have g21 : ∀ D, fdir E D (FfrF F E 2 1) x = -fdir E D (FfrF F E 1 2) x := fun D => fdir_FfrF_swap hF hFa hx 1 2 D
  have g31 : ∀ D, fdir E D (FfrF F E 3 1) x = -fdir E D (FfrF F E 1 3) x := fun D => fdir_FfrF_swap hF hFa hx 1 3 D
  have g32 : ∀ D, fdir E D (FfrF F E 3 2) x = -fdir E D (FfrF F E 2 3) x := fun D => fdir_FfrF_swap hF hFa hx 2 3 D
  have gdg : ∀ D A, fdir E D (FfrF F E A A) x = 0 := fun D A => by
    have h := fdir_FfrF_swap hF hFa hx A A D; linear_combination h / 2
  change FfrF F E 1 0 x = -FfrF F E 0 1 x at f10
  change FfrF F E 2 0 x = -FfrF F E 0 2 x at f20
  change FfrF F E 3 0 x = -FfrF F E 0 3 x at f30
  change FfrF F E 2 1 x = -FfrF F E 1 2 x at f21
  change FfrF F E 3 1 x = -FfrF F E 1 3 x at f31
  change FfrF F E 3 2 x = -FfrF F E 2 3 x at f32
  simp only [f10, f20, f30, f21, f31, f32, fdg, g10, g20, g30, g21, g31, g32, gdg]
  try (clear f10 f20 f30 f21 f31 f32 fdg g10 g20 g30 g21 g31 g32 gdg)))
  ring))

end npmax

/-! ### The Maxwell combination (geometric source of `res1d`) -/

theorem contDiffOn_phi1 (hF : FrameData g gi E Θ U) {F : TwoForm 4} (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U) :
    ContDiffOn ℝ ∞ (fun z => phi1 E z F) U := by
  have e : (fun z => phi1 E z F) = fun z => (1 / 2 : ℂ) * (FfrF F E 0 1 z + FfrF F E 3 2 z) :=
    funext fun z => by simp only [phi1]; ring
  rw [e]
  exact contDiffOn_const.mul ((contDiffOn_FfrF hF hFs 0 1).add (contDiffOn_FfrF hF hFs 3 2))

end ExactVacuumAtlas.EinsteinMaxwell.NP
end R05Seg10

-- ==== solution ====
open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
theorem solution (hN : NullFrameData g gi E Θ U) {F : TwoForm 4} (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    (hFa : ∀ y ∈ U, ∀ i j, F i j y = -F j i y) {x : Pt 4} (hx : x ∈ U) :
    (fdir E 2 (fun z => (Hfr F E 0 3 2 z - Jfr g gi F Θ 1 z) / 2 + fdir E 3 (FfrF F E 0 2) z
          + (npPi g gi E Θ z - 2 * npAlpha g gi E Θ z) * phi0 E z F - npKappa g gi E Θ z * phi2 E z F) x
        + (npPiB g gi E Θ x - npBeta g gi E Θ x - npAlphaB g gi E Θ x - 2 * npTau g gi E Θ x)
          * ((Hfr F E 0 3 2 x - Jfr g gi F Θ 1 x) / 2 + fdir E 3 (FfrF F E 0 2) x
            + (npPi g gi E Θ x - 2 * npAlpha g gi E Θ x) * phi0 E x F - npKappa g gi E Θ x * phi2 E x F))
      - (fdir E 0 (fun z => (Jfr g gi F Θ 3 z + Hfr F E 1 2 0 z) / 2 + fdir E 1 (FfrF F E 0 2) z
          + (npMu g gi E Θ z - 2 * npGamma g gi E Θ z) * phi0 E z F - npSigma g gi E Θ z * phi2 E z F) x
        + (npEpsB g gi E Θ x - npEps g gi E Θ x - npRhoB g gi E Θ x - 2 * npRho g gi E Θ x)
          * ((Jfr g gi F Θ 3 x + Hfr F E 1 2 0 x) / 2 + fdir E 1 (FfrF F E 0 2) x
            + (npMu g gi E Θ x - 2 * npGamma g gi E Θ x) * phi0 E x F - npSigma g gi E Θ x * phi2 E x F))
      = 2 * phi1 E x F * (2 * psi1 g gi E x + fdir E 1 (omL g gi E Θ 0 0 2) x - fdir E 3 (omL g gi E Θ 0 2 2) x
          + (npTauB g gi E Θ x + npPi g gi E Θ x + 3 * npAlpha g gi E Θ x - npBetaB g gi E Θ x)
            * npSigma g gi E Θ x
          - (3 * npGamma g gi E Θ x + npGammaB g gi E Θ x + npMu g gi E Θ x - npMuB g gi E Θ x)
            * npKappa g gi E Θ x)
        + npKappa g gi E Θ x * fdir E 1 (fun z => phi1 E z F) x
        - npSigma g gi E Θ x * fdir E 3 (fun z => phi1 E z F) x := by
  have hU := hN.isOpen
  have h1 : ∀ z ∈ U, fdir E 0 (fun w => phi1 E w F) z - 2 * npRho g gi E Θ z * phi1 E z F
      = (Hfr F E 0 3 2 z - Jfr g gi F Θ 1 z) / 2 + fdir E 3 (FfrF F E 0 2) z
        + (npPi g gi E Θ z - 2 * npAlpha g gi E Θ z) * phi0 E z F - npKappa g gi E Θ z * phi2 E z F := by
    intro z hz; have := np_maxwell_1 hN hFs hFa hz; linear_combination this
  have h3 : ∀ z ∈ U, fdir E 2 (fun w => phi1 E w F) z - 2 * npTau g gi E Θ z * phi1 E z F
      = (Jfr g gi F Θ 3 z + Hfr F E 1 2 0 z) / 2 + fdir E 1 (FfrF F E 0 2) z
        + (npMu g gi E Θ z - 2 * npGamma g gi E Θ z) * phi0 E z F - npSigma g gi E Θ z * phi2 E z F := by
    intro z hz; have := np_maxwell_3 hN hFs hFa hz; linear_combination this
  have hc := np_maxwell_combo_core hN hx (contDiffOn_phi1 hN.toFrameData hFs)
  rw [fdir_congr_of_eqOn hU hx (fun z hz => h1 z hz) 2, fdir_congr_of_eqOn hU hx (fun z hz => h3 z hz) 0,
    h1 x hx, h3 x hx] at hc
  exact hc
