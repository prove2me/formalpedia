    (m : ℕ) (hX : s.G X = ints A ++ R) (hH : s.G DL = .int A.length :: LH) (hA : Bnd m A) :
    IRuns I iprog (mvK X Y) s ((s.upd X R).upd Y ((ints A).reverse ++ s.G Y))
      (A.length * (1000 * (m + zsz (A.length : ℤ) + 3)) + 300 * (zsz (A.length : ℤ) + 1) + 40) := by
  have h1 : IRuns I iprog (.op (.dup DL CC)) s (s.upd CC (.int A.length :: s.G CC))
      (300 * (zsz (A.length : ℤ) + 1)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hH]
    have := dupCost_le (zsz (A.length : ℤ)); omega
  have h2 := mvN_runs (I := I) (iprog := iprog) hXY hXC hYC hX3 hY3 (by decide)
    (s.upd CC (.int A.length :: s.G CC)) A R (s.G CC) m (by simp [hXC, hX]) (by simp) hA
  have h3 : IRuns I iprog (.op (.drop CC))
      ((((s.upd CC (.int A.length :: s.G CC)).upd X R).upd Y
        ((ints A).reverse ++ (s.upd CC (.int A.length :: s.G CC)).G Y)).upd CC (.int 0 :: s.G CC))
      ((s.upd X R).upd Y ((ints A).reverse ++ s.G Y)) 2 := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, zsz_zero]
    apply IState.ext' <;> intros <;> simp [hYC] <;> split_ifs <;> simp_all
  exact (IRuns.seq h1 (IRuns.seq h2 h3)).mono (by omega)
end
