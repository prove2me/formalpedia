section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open Set PaperBox PaperBox.Bounds


theorem Piece.cast_qslope (r : Piece) (x : ℚ) : (r.qslope x:ℝ)=r.slope x := by
  simp [qslope,slope,cast_qhorner]


theorem endpointSlope_secant (row : ℚ → Piece)
    (spec : ∀ {z : ℚ}, z∈Icc 0 1 → row z∈pieces ∧ (row z).lo ≤ z ∧ z ≤ (row z).hi)
    {i : Bounds} {x y : ℝ} (hlo : lamQ ≤ i.lo) (hhi : i.hi ≤ 1) (hx : i.Holds x) (hy : i.Holds y) :
    Secants totalScore x y (endpointSlope row i) := by
  have ord : i.lo ≤ i.hi := by exact_mod_cast hx.1.trans hx.2
  have low : i.lo∈Icc (0:ℚ) 1 := ⟨(by norm_num [lamQ] : (0:ℚ) ≤ lamQ).trans hlo,ord.trans hhi⟩
  have high : i.hi∈Icc (0:ℚ) 1 := ⟨low.1.trans ord,hhi⟩
  have hr {k : ℚ} (hk : k∈Icc (0:ℚ) 1) : (k:ℝ)∈Icc ((row k).lo:ℝ) (row k).hi := by
    obtain ⟨_,hl,hh⟩ := spec hk
    exact ⟨by exact_mod_cast hl,by exact_mod_cast hh⟩
  have domain {u : ℝ} (hu : i.Holds u) : u∈Icc (0:ℝ) 1 :=
    ⟨(by exact_mod_cast low.1 : (0:ℝ) ≤ i.lo).trans hu.1,hu.2.trans (by exact_mod_cast hhi)⟩
  have hlam : lam ≤ (i.lo:ℝ) := by unfold lam;exact_mod_cast hlo
  have clamp_id {u : ℝ} (hu : i.Holds u) : totalScore u=score u := by
    exact congrArg score (clamp_eq (domain hu))
  let k := endpointSlope row i
  have ordered {u v : ℝ} (hu : i.Holds u) (hv : i.Holds v) (lt : u<v) : Secants totalScore u v k := by
    have lo := PaperEndpoint.chain_slope_lower data_chain (f:=score) (fun _ h _ h' => score_on_piece h h')
      (x:=u) (y:=v) (by simpa [startKnot] using (domain hu).1) (by simpa [endKnot] using (domain hv).2)
      lt.le (v:=(k.lo:ℝ)) (by
        intro r h t ht hut htv
        have hd := PaperEndpoint.post_slopes data_chain PaperEndpoint.data_descending h (spec high).1
          (show t∈Icc (r.lo:ℝ) r.hi from ⟨ht.1.le,ht.2.le⟩) (hr high) ((hlam.trans hu.1).trans_lt hut) (htv.trans_le hv.2)
        have de : (k.lo:ℝ) ≤ (row i.hi).slope i.hi := by
          rw [← Piece.cast_qslope]; unfold k endpointSlope;push_cast;exact min_le_left _ _
        exact de.trans hd)
    have hi : score v-score u ≤ (k.hi:ℝ)*(v-u) := by
      by_cases he : i.lo ≤ lamQ
      · have ha := score_add_antitone (show u∈Icc lam 1 from ⟨hlam.trans hu.1,(domain hu).2⟩)
          (show v∈Icc lam 1 from ⟨hlam.trans hv.1,(domain hv).2⟩) lt.le
        simp only [k,endpointSlope,if_pos he,Rat.cast_neg,Rat.cast_one]
        linarith only [ha]
      have hl : lam < (i.lo:ℝ) := by unfold lam;exact_mod_cast lt_of_not_ge he
      apply PaperEndpoint.chain_slope_upper data_chain (f:=score) (fun _ h _ h' => score_on_piece h h')
        (x:=u) (y:=v) (by simpa [startKnot] using (domain hu).1) (by simpa [endKnot] using (domain hv).2) lt.le
      intro r h t ht hut _
      have hd := PaperEndpoint.post_slopes data_chain PaperEndpoint.data_descending (spec low).1 h (hr low)
        (show t∈Icc (r.lo:ℝ) r.hi from ⟨ht.1.le,ht.2.le⟩) hl (hu.1.trans_lt hut)
      simpa only [k,endpointSlope,if_neg he,Piece.cast_qslope] using hd
    refine ⟨(score v-score u)/(v-u),⟨(le_div_iff₀ (sub_pos.mpr lt)).mpr lo,(div_le_iff₀ (sub_pos.mpr lt)).mpr hi⟩,?_⟩
    rw [clamp_id hv,clamp_id hu,div_mul_cancel₀ _ (sub_pos.mpr lt).ne']
  rcases lt_trichotomy x y with lt|rfl|gt
  · exact ordered hx hy lt
  · refine ⟨(k.hi:ℝ),⟨?_,le_rfl⟩,by simp⟩
    unfold k endpointSlope;push_cast;exact min_le_right _ _
  · obtain ⟨m,hm,eq⟩ := ordered hy hx gt
    exact ⟨m,hm,by linear_combination -eq⟩

end StableVotingDistortion.PaperCurve
end

