theorem accSeq_sumG (g : ℕ → ℤ) (N a0 : ℤ) (N' : ℕ) :
    ∀ k ≤ N', accSeq (sumG g N') a0 k = a0 + ∑ j ∈ Finset.range k, g (N' - j)
  | 0, _ => by simp [accSeq]
  | k + 1, hk => by
    rw [accSeq, accSeq_sumG g N a0 N' k (by omega), Finset.sum_range_succ, sumG]; ring

theorem sum_Icc_eq_range (g : ℕ → ℤ) : ∀ N : ℕ,
    ∑ x ∈ Finset.Icc 1 N, g x = ∑ j ∈ Finset.range N, g (j + 1)
  | 0 => by simp
  | N + 1 => by
    rw [Finset.sum_Icc_succ_top (by omega), Finset.sum_range_succ, sum_Icc_eq_range g N]

/-- The full sum: `a0 + Σ_{x = 1}^{N} g x`. -/
theorem accSeq_sum (g : ℕ → ℤ) (a0 : ℤ) (N : ℕ) :
    accSeq (sumG g N) a0 N = a0 + ∑ x ∈ Finset.Icc 1 N, g x := by
  rw [accSeq_sumG g 0 a0 N N le_rfl, sum_Icc_eq_range]
  congr 1
  rw [← Finset.sum_range_reflect (fun j => g (j + 1)) N]
  refine Finset.sum_congr rfl (fun j hj => ?_)
  simp only [Finset.mem_range] at hj
  congr 1; omega

theorem accSeq_satSq (cap : ℤ) (hcap : 1 ≤ cap) (x : ℤ) (hx : 0 ≤ x) (hxc : x ≤ cap) :
    ∀ m : ℕ, accSeq (satG cap) x m = min (x ^ (2 ^ m)) cap
  | 0 => by simp [accSeq, hxc]
  | m + 1 => by
    rw [accSeq, accSeq_satSq cap hcap x hx hxc m, satG]
    have hp : x ^ (2 ^ (m + 1)) = x ^ (2 ^ m) * x ^ (2 ^ m) := by rw [pow_succ, pow_mul, pow_two]
    have h0 : 0 ≤ x ^ (2 ^ m) := pow_nonneg hx _
    rcases le_total (x ^ (2 ^ m)) cap with h | h
    · rw [min_eq_left h, hp]
      split_ifs with h1
      · rw [min_eq_right (by linarith)]
      · rw [min_eq_left (by linarith)]
    · rw [min_eq_right h]
      have h2 : cap ≤ x ^ (2 ^ m) * x ^ (2 ^ m) := by nlinarith
      rw [hp, min_eq_right h2]
      split_ifs with h1
      · rfl
      · nlinarith

