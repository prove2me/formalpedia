-- title:
--   Lemma 6.2 — for any J there exists J* so that P(J, J*) is feasible
-- statement:
--   Let $w(\pi)=\min_k\{c_k+\pi\cdot v_k\}$ on $E^n$ be bounded above, and let $\{\pi^j\}$ be generated by the subgradient algorithm (2.6), $\pi^{j+1}=\pi^j+t_j v^j$ with $v^j=v_{k(j)}$ and $k(j)$ attaining the minimum in (2.2) at $\pi^j$, with positive step sizes satisfying (2.7). Suppose the sequence $\{\pi^j\}$ is bounded. Then for every $J$ there is $J^*>J$ such that the core problem
--   $$P(J,J^*):\quad \min\Big\{\sum_{j=J}^{J^*} c^j y_j : y_j\ge0,\ \sum_{j=J}^{J^*} y_j=1,\ \sum_{j=J}^{J^*} -v^j y_j=0\Big\}$$
--   is feasible; equivalently, the origin lies in the convex hull of $v^J,\dots,v^{J^*}$.
--
--   Feasibility of the core problem is the first half of Theorem 6.3.
--
--   **Formalization Note** The hypotheses are the standing assumptions of Section 6 ((2.6), (2.7), $w$ bounded above) plus boundedness of $\{\pi^j\}$, as in the paper; the paper's argument uses only $t_j>0$, $\sum_j t_j=\infty$ and boundedness among them. $J<J^*$ is required, as in the definition of $P(J,J^*)$.
-- source:
--   Held, Wolfe & Crowder, Validation of subgradient optimization, Math. Programming 6 (1974), p. 82, Lemma 6.2

import Mathlib
import Definitions.Def_HeldWolfeCrowder_CoreProblem_Setting

namespace HeldWolfeCrowder.CoreProblem

open scoped InnerProductSpace
open Filter Topology

/-- **Held, Wolfe & Crowder (1974), Lemma 6.2, p. 82.** Under the standing assumptions of §6
(`w` bounded above; `{π^j}` generated by (2.6) with positive step sizes satisfying (2.7)) and
`{π^j}` bounded: for any `J` there exists `J* > J` such that the core problem `P(J, J*)` is
feasible. -/
theorem core_problem_feasible {n : ℕ} {ι : Type*} [Fintype ι] [Nonempty ι]
    (c : ι → ℝ) (v : ι → EuclideanSpace ℝ (Fin n)) (hw : BddAbove (Set.range (w c v)))
    (t : ℕ → ℝ) (π : ℕ → EuclideanSpace ℝ (Fin n)) (k : ℕ → ι)
    (hrun : IsSubgradientRun c v t π k) (ht : StepSizeCond t)
    (hbdd : Bornology.IsBounded (Set.range π)) :
    ∀ J : ℕ, ∃ Jstar : ℕ, J < Jstar ∧ ∃ y : ℕ → ℝ, CoreFeasible v k J Jstar y := by sorry

end HeldWolfeCrowder.CoreProblem
