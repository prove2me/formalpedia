-- url     : https://prove2.me/theorems/ad1d5234-d9fc-4265-8ef6-b631ef0a73fb
-- title:
--   §2.3.4, §2.3.9, §2.4, pp. 12–17 — the cleared ideal t·I⁻¹, the quotients M/N, the map θ_t, the primes q_i = ⟨q, ζ − ω^i⟩, the ℓ_p norms
-- statement:
--   Let $K$ be a number field with ring of integers $R = \mathcal{O}_K$. Fractional ideals of $K$ are the nonzero finitely generated $R$-submodules of $K$ (together with the zero submodule, which Lean also admits); an integral ideal $I \subseteq R$ is regarded as a fractional ideal. This file fixes the objects used by Lemmas 2.9 and 2.14–2.16 and by §4.2 of Lyubashevsky–Peikert–Regev.
--
--   1. **The cleared ideal.** For $t \in R$ and an ideal $I \subseteq R$,
--   $$t \cdot I^{-1} = \langle t\rangle \cdot I^{-1},$$
--   the product of the principal fractional ideal generated by $t$ with the inverse of $I$.
--   2. **"$t\cdot I^{-1}$ is coprime to $J$."** For ideals $I, J \subseteq R$ and $t \in R$, the predicate $\mathrm{ClearedCoprime}(t, I, J)$ holds when $t\cdot I^{-1}$ is an integral ideal, $t\cdot I^{-1} \subseteq R$, and
--   $$t\cdot I^{-1} + J = R .$$
--   3. **Quotients of fractional ideals.** For fractional ideals $M$ and $N$, $\mathrm{sub}(M,N)$ is $N \cap M$ viewed as an $R$-submodule of $M$, and $M/N$ denotes the quotient $R$-module $M/(N\cap M)$. When $N \subseteq M$ (as for $N = JM$ with $J$ integral) this is the usual quotient $M/N$.
--   4. **The map induced by $\theta_t$.** For $t \in I$ and a fractional ideal $M$, the $R$-linear map
--   $$\theta_t : M \to IM/IJM, \qquad u \mapsto (t\cdot u) \bmod IJM ,$$
--   which is well defined because $t u \in IM$.
--   5. **The primes $\mathfrak{q}_i$.** Let $\zeta \in K$ be a primitive $m$-th root of unity, $q$ a natural number, $\omega \in \mathbb{Z}_q$ and $i \in \mathbb{Z}_m^*$. Then
--   $$\mathfrak{q}_i = \langle q,\ \zeta - \omega^i \rangle \subseteq R,$$
--   where $\omega^i \in \mathbb{Z}_q$ is lifted to $R$ through its representative in $\{0,\dots,q-1\}$ (any lift gives the same ideal, since $q \in \mathfrak{q}_i$) and the exponent $i$ is read through its representative in $\{0, \dots, m-1\}$.
--   6. **The $\ell_p$ norms.** For $x \in K$ and real $p$, $\|x\|_p = \bigl(\sum_{\sigma} |\sigma(x)|^p\bigr)^{1/p}$, and $\|x\|_\infty = \max_\sigma |\sigma(x)|$, where $\sigma$ runs over all $n$ ring embeddings $K \to \mathbb{C}$ (complex-conjugate pairs counted separately), as in the canonical embedding of §2.3.2.
--
--   These objects are shared by every statement of the mission, so that "coprime", "quotient" and "the map induced by multiplication by $t$" mean the same thing throughout.
--
--   **Formalization Note** The paper excludes the zero ideal by convention (footnote 2, p. 13); the theorems that use these definitions carry the corresponding nonzero hypotheses. Coprimality of the fractional ideal $t\cdot I^{-1}$ with $J$ is expressed as integrality plus $t\cdot I^{-1} + J = 1$ in the semiring of fractional ideals, not with `IsCoprime` on fractional ideals. The lemma `mul_mem_coeIdeal_mul` is the one-line membership fact $t\in I,\ u\in M \Rightarrow tu \in IM$ used to define $\theta_t$.
-- source:
--   Lyubashevsky, Peikert & Regev, On ideal lattices and learning with errors over rings, J. ACM 60(6) (2013), p. 12 (§2.3.2, ℓp norms), p. 13 (§2.3.4, ideals, footnote 2), pp. 16–17 (§2.3.9, Lemmas 2.14, 2.15), p. 17 (§2.4, q_i = ⟨q, ζ − ω^i⟩)

import Mathlib

namespace LPRRingLWE.Clear

open NumberField
open scoped nonZeroDivisors

variable {K : Type*} [Field K] [NumberField K]

/-- The cleared ideal `t · I⁻¹`, a fractional ideal of `K` (§2.3.9, Lemma 2.14). -/
noncomputable def cleared (t : 𝓞 K) (I : Ideal (𝓞 K)) : FractionalIdeal (𝓞 K)⁰ K :=
  FractionalIdeal.spanSingleton (𝓞 K)⁰ (algebraMap (𝓞 K) K t) * (I : FractionalIdeal (𝓞 K)⁰ K)⁻¹

/-- "The ideal `t · I⁻¹ ⊆ R` is coprime to `J`": `t · I⁻¹` is integral and `t · I⁻¹ + J = R`. -/
def ClearedCoprime (t : 𝓞 K) (I J : Ideal (𝓞 K)) : Prop :=
  cleared t I ≤ 1 ∧ cleared t I + (J : FractionalIdeal (𝓞 K)⁰ K) = 1

/-- `N ∩ M`, seen as an `𝓞 K`-submodule of `M`; for `N ≤ M` this is `N` inside `M`. -/
def sub (M N : FractionalIdeal (𝓞 K)⁰ K) : Submodule (𝓞 K) (M : Submodule (𝓞 K) K) :=
  (N : Submodule (𝓞 K) K).comap (M : Submodule (𝓞 K) K).subtype

/-- The quotient `𝓞 K`-module `M / N` of the fractional ideal `M` by `N` (`N ∩ M` in general). -/
abbrev Quot (M N : FractionalIdeal (𝓞 K)⁰ K) : Type _ :=
  (M : Submodule (𝓞 K) K) ⧸ sub M N

omit [NumberField K] in
lemma mul_mem_coeIdeal_mul {t : 𝓞 K} {I : Ideal (𝓞 K)} (ht : t ∈ I)
    {M : FractionalIdeal (𝓞 K)⁰ K} {u : K} (hu : u ∈ M) :
    algebraMap (𝓞 K) K t * u ∈ (I : FractionalIdeal (𝓞 K)⁰ K) * M :=
  FractionalIdeal.mul_mem_mul (FractionalIdeal.mem_coeIdeal_of_mem (𝓞 K)⁰ ht) hu

/-- The map `M → IM/IJM`, `u ↦ (t · u) mod IJM`, induced by `θ_t(u) = t · u` for `t ∈ I`
(Lemma 2.15). -/
noncomputable def theta (t : 𝓞 K) (I J : Ideal (𝓞 K)) (ht : t ∈ I)
    (M : FractionalIdeal (𝓞 K)⁰ K) :
    (M : Submodule (𝓞 K) K) →ₗ[𝓞 K]
      Quot ((I : FractionalIdeal (𝓞 K)⁰ K) * M) ((I : FractionalIdeal (𝓞 K)⁰ K) * J * M) :=
  (sub ((I : FractionalIdeal (𝓞 K)⁰ K) * M) ((I : FractionalIdeal (𝓞 K)⁰ K) * J * M)).mkQ ∘ₗ
    { toFun := fun u => ⟨algebraMap (𝓞 K) K t * u, mul_mem_coeIdeal_mul ht u.2⟩
      map_add' := fun u v => by ext; simp [mul_add]
      map_smul' := fun r u => by ext; simp [Algebra.smul_def]; ring }

/-- The prime `q_i = ⟨q, ζ − ω^i⟩` of §2.4 (p. 17), for `i ∈ ℤ_m^*`; the residue `ω^i ∈ ℤ_q` is
lifted to `𝓞 K` through its representative in `{0, …, q − 1}`. -/
noncomputable def qPrime {m : ℕ} [NeZero m] {ζ : K} (hζ : IsPrimitiveRoot ζ m) (q : ℕ)
    (ω : ZMod q) (i : (ZMod m)ˣ) : Ideal (𝓞 K) :=
  Ideal.span {(q : 𝓞 K), hζ.toInteger - (((ω ^ ((i : ZMod m)).val).val : ℕ) : 𝓞 K)}

/-- The `ℓ_p` norm `‖x‖_p = (∑_φ |φ(x)|^p)^{1/p}` over all `n` complex embeddings (§2.3.2, p. 12). -/
noncomputable def lpNorm (p : ℝ) (x : K) : ℝ :=
  (∑ φ : K →+* ℂ, ‖φ x‖ ^ p) ^ (1 / p)

/-- The `ℓ_∞` norm `‖x‖_∞ = max_φ |φ(x)|` over all complex embeddings (§2.3.2, p. 12). -/
noncomputable def supNorm (x : K) : ℝ :=
  ⨆ φ : K →+* ℂ, ‖φ x‖

end LPRRingLWE.Clear


