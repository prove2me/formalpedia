      Set.univ ∧ zeroCell O Φ r ∩ typeEvent (AdjoinRoot Φ) r τ =
      (fun z : Fin r → AdjoinRoot Φ => algebraMap O (AdjoinRoot Φ) pi • z) '' rootEvent
      (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) r τ ∧
