theorem finrank_φ_const (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}))
    (T : Type) [CommRing T] [Algebra 𝒪 T] (hTc : ∀ e : T, IsIdempotentElem e → e = 0 ∨ e = 1)
    (h0 : algebraMap 𝒪 T π = 0)
