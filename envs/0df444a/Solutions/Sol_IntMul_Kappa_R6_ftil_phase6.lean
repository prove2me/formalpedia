/-- **The `A`-lines call.** -/
theorem lineA_phase6 [instS : ∀ i, NeZero (Q.sB D i)] [instT : ∀ i, NeZero (Q.tB D i)]
    {eA eB : Fin (7 + E)} {dS : Fin HS} {C₀ : ℝ} {A : ℕ} (hd0 : dS ≠ 0)
    (M : AxisMaps6 Q.α (Q.sB D) (Q.tB D))
    (hL : lineG6 Isym (IL.kTableP tab ext) eA eB dS C₀ A Q D M) (Bd : ℕ)
    (hBd : ∀ x ∈ Q.dLn, zsz x ≤ Bd)
    (t : IState HS) (hR : Q.Base t) (zs : List GI) (u : ((i : Fin (D + 1)) → ZMod (Q.sB D i)) → ℂ)
    (R0 : List Item) (h0 : t.G 0 = ints (gflat zs) ++ R0)
    (hu : RepPad Q.p (Q.sB D) (Q.tB D) zs u) (hu1 : ‖u‖ ≤ 1 / 2) :
    ∃ (zs' : List GI) (w : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ) (c : ℕ),
      IRuns Isym iprog (callW (cpyD zLn (bX dS) 2 4) (bX dS) (bY dS) dS (g eA)) t
        (t.upd 0 (ints (gflat zs') ++ R0)) c ∧
