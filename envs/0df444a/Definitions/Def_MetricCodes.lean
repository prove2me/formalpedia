         (∏ q ∈ Finset.range (r + j.val + 2),
            ((lam i : ℝ) - (i.val : ℝ) + (r : ℝ) - (q : ℝ))) *
          (∏ q ∈ Finset.range (2 * r + 2 - (r + j.val + 2)),
            ((n : ℝ) + (lam i : ℝ) - (i.val : ℝ) +
