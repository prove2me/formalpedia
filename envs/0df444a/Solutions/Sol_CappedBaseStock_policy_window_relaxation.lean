namespace CappedWindowApproximation

lemma realInventory_le_integral_approx {n : ℕ} (W : WindowLaw n)
    (r z δ : ℝ) (hδ : 0 ≤ δ)
    (hinit : (∫ w, (w.1 : ℝ) ∂W.law) = z)
    (hdelivery : ∀ i : Fin n, r - δ ≤ ∫ w, (w.2 i : ℝ) ∂W.law)
    (d : DemandPath) (m : ℕ) (hm : m ≤ n) :
    realInventory d r z m ≤ (∫ w, (windowInventory w d m : ℝ) ∂W.law) + (m : ℝ) * δ := by
  induction m with
  | zero => simpa only [realInventory, windowInventory, Nat.cast_zero, zero_mul, add_zero]
      using hinit.ge
  | succ m ih =>
    have hmn : m < n := lt_of_lt_of_le (Nat.lt_succ_self m) hm
    have hprev := ih (Nat.le_of_lt hmn)
    have hdel : r - δ ≤ ∫ w, (windowDelivery w m : ℝ) ∂W.law := by
      simpa only [windowDelivery, dif_pos hmn] using hdelivery ⟨m, hmn⟩
    simp only [realInventory, Nat.cast_add, Nat.cast_one]
    apply max_le
    · have hi : 0 ≤ ∫ w, (windowInventory w d (m + 1) : ℝ) ∂W.law :=
        integral_nonneg (fun w => NNReal.coe_nonneg (windowInventory w d (m + 1)))
      positivity
    · have hstep :
          (∫ w, (windowInventory w d m : ℝ) + (windowDelivery w m : ℝ) - (d m : ℝ) ∂W.law) ≤
            ∫ w, (windowInventory w d (m + 1) : ℝ) ∂W.law := by
        apply integral_mono
          (((integrable_windowInventory_fiber W d m).add (integrable_windowDelivery W m)).sub
            (integrable_const _))
          (integrable_windowInventory_fiber W d (m + 1))
        intro w
        simp only [windowInventory, NNReal.coe_sub_def, NNReal.coe_add]
        exact le_max_left _ _
      rw [integral_sub
          (f := fun w : WindowInput n => (windowInventory w d m : ℝ) + (windowDelivery w m : ℝ))
          (g := fun _ : WindowInput n => (d m : ℝ))
          ((integrable_windowInventory_fiber W d m).add (integrable_windowDelivery W m))
          (integrable_const _),
        integral_add (integrable_windowInventory_fiber W d m) (integrable_windowDelivery W m),
        integral_const, measureReal_def, measure_univ, ENNReal.toReal_one, one_smul] at hstep
      nlinarith

lemma integral_realInventory_le_windowInventory_prod_approx (P : DemandLaw) {n : ℕ}
    (W : WindowLaw n) (r z δ : ℝ) (hr : 0 ≤ r) (hz : 0 ≤ z) (hδ : 0 ≤ δ)
    (hinit : (∫ w, (w.1 : ℝ) ∂W.law) = z)
    (hdelivery : ∀ i : Fin n, r - δ ≤ ∫ w, (w.2 i : ℝ) ∂W.law)
    (m : ℕ) (hm : m ≤ n) :
    (∫ d, realInventory d r z m ∂demandPathLaw P) ≤
      (∫ wd : WindowInput n × DemandPath,
        (windowInventory wd.1 wd.2 m : ℝ) ∂(W.law.prod (demandPathLaw P))) + (m : ℝ) * δ := by
  rw [integral_prod_symm _ (integrable_windowInventory_prod P W m)]
  have hInt := (integrable_windowInventory_prod P W m).integral_prod_right
  have hle := integral_mono (integrable_realInventory P r z hr hz m)
    (hInt.add (integrable_const ((m : ℝ) * δ)))
    (fun d => realInventory_le_integral_approx W r z δ hδ hinit hdelivery d m hm)
  change (∫ d, realInventory d r z m ∂demandPathLaw P) ≤
    (∫ d, (∫ w, (windowInventory w d m : ℝ) ∂W.law) + (m : ℝ) * δ ∂demandPathLaw P) at hle
  rw [integral_add
    (f := fun d : DemandPath => ∫ w, (windowInventory w d m : ℝ) ∂W.law)
    (g := fun _ : DemandPath => (m : ℝ) * δ) hInt (integrable_const _),
    integral_const, measureReal_def, measure_univ, ENNReal.toReal_one, one_smul] at hle
  exact hle

/-- The deterministic window with inventory z and every committed delivery r. -/
def diracWindowLaw (n : ℕ) (r z : ℝ≥0) : WindowLaw n where
  law := Measure.dirac (z, fun _ => r)
  probability := by infer_instance
  inventory_integrable := integrable_dirac (by finiteness)
  delivery_integrable _ := integrable_dirac (by finiteness)

lemma diracWindowLaw_means (n : ℕ) (r z : ℝ≥0) :
    WindowMeans (diracWindowLaw n r z) r z := by
  constructor
  · simp [diracWindowLaw]
  · intro i
    simp [diracWindowLaw]

lemma windowInventory_diracInput_eq (n : ℕ) (r z : ℝ≥0) (d : DemandPath)
    (m : ℕ) (hm : m ≤ n) :
    (windowInventory (z, fun _ : Fin n => r) d m : ℝ) = realInventory d r z m := by
  induction m with
  | zero => rfl
  | succ m ih =>
    have hmn : m < n := lt_of_lt_of_le (Nat.lt_succ_self m) hm
    simp only [windowInventory, windowDelivery, dif_pos hmn, NNReal.coe_sub_def,
      NNReal.coe_add, realInventory, ih (Nat.le_of_lt hmn), max_comm]

lemma windowExpectedInventory_dirac (P : DemandLaw) (n : ℕ) (r z : ℝ≥0)
    (m : ℕ) (hm : m ≤ n) :
    windowExpectedInventory P (diracWindowLaw n r z) m =
      ENNReal.ofReal (∫ d, realInventory d r z m ∂demandPathLaw P) := by
  rw [← ofReal_integral_windowInventory_prod P (diracWindowLaw n r z) m,
    integral_prod_symm _ (integrable_windowInventory_prod P (diracWindowLaw n r z) m)]
  congr 1
  apply integral_congr_ae
  filter_upwards [] with d
  simp only [diracWindowLaw, integral_dirac]
  exact windowInventory_diracInput_eq n r z d m hm

lemma realInventory_lipschitz (d : DemandPath) (r z r' z' : ℝ) (m : ℕ) :
    |realInventory d r z m - realInventory d r' z' m| ≤ |z - z'| + (m : ℝ) * |r - r'| := by
  induction m with
  | zero => simp [realInventory]
  | succ m ih =>
    have hm := abs_max_sub_max_le_abs
      (realInventory d r z m + r - (d m : ℝ))
      (realInventory d r' z' m + r' - (d m : ℝ)) 0
    have heq : (realInventory d r z m + r - (d m : ℝ)) -
        (realInventory d r' z' m + r' - (d m : ℝ)) =
          (realInventory d r z m - realInventory d r' z' m) + (r - r') := by ring
    rw [heq] at hm
    have ht := hm.trans (abs_add_le _ _)
    simp only [realInventory, max_comm, Nat.cast_add, Nat.cast_one]
    exact ht.trans (by nlinarith)

lemma integral_realInventory_lipschitz (P : DemandLaw) (r z r' z' : ℝ)
    (hr : 0 ≤ r) (hz : 0 ≤ z) (hr' : 0 ≤ r') (hz' : 0 ≤ z') (m : ℕ) :
    |(∫ d, realInventory d r z m ∂demandPathLaw P) -
        (∫ d, realInventory d r' z' m ∂demandPathLaw P)| ≤
      |z - z'| + (m : ℝ) * |r - r'| := by
  rw [← integral_sub (integrable_realInventory P r z hr hz m)
    (integrable_realInventory P r' z' hr' hz' m)]
  calc
    _ ≤ ∫ d, |realInventory d r z m - realInventory d r' z' m| ∂demandPathLaw P :=
      abs_integral_le_integral_abs
    _ ≤ ∫ _d : DemandPath, (|z - z'| + (m : ℝ) * |r - r'|) ∂demandPathLaw P := by
      apply integral_mono
        ((integrable_realInventory P r z hr hz m).sub
          (integrable_realInventory P r' z' hr' hz' m)).abs
        (integrable_const _)
      intro d
      exact realInventory_lipschitz d r z r' z' m
    _ = _ := by simp

end CappedWindowApproximation
end
