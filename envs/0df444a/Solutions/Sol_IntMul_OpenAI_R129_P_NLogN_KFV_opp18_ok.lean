/-- **Phase 2 of the layout, backwards, uniform.** -/
theorem ph2R_ok (hK : 0 < K) (hℓ : 2 ≤ ℓ) (hq1 : 1 ≤ qq ℓ K) {mk p W B : ℕ}
    (hB : (pLP D ℓ K long).n + ℓ + 5 ≤ B) :
    LayerU (r := 2 ^ ℓ) I iprog (fun s => LRg s (pLP D ℓ K long) mk W) ph2R
      (runArrR (pLP D ℓ K long).n 0 (ops2 D ℓ K long)) (2 ^ (pLP D ℓ K long).n) p W
      (cPh2R D ℓ K long (pLP D ℓ K long).n W B) := by
  intro s hQ zs l xs hx hl hb hd
  set v := gflat zs ++ l
  have hn0 := pLP_n D ℓ K long hK (by omega)
  have hbq : bb ℓ K + qq ℓ K * K = ℓ - 1 := hbq ℓ K hK (by omega)
  have hbD : bb ℓ K * D ≤ (pLP D ℓ K long).n := by
    rw [hn0]; have := Nat.mul_le_mul_right D (show bb ℓ K ≤ ℓ - 1 by omega); nlinarith
  have zN : zsz ((bb ℓ K * D : ℕ) : ℤ) ≤ B := zsz_nat_le (by omega)
  have hFr : ∀ r : Fin HS, r ≠ 0 → o0 v r = [] := fun r h => o0_ne v h
  have vBD : ∀ f : Fin HS → List ℤ, f gBb = [] → f NLogN.KFV.gD = [] →
