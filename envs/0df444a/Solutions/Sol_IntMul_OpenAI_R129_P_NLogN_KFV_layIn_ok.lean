    initL D ℓ long = (xs1 D ℓ K long).flatMap trip := by
  unfold initL xs1
  rw [List.flatMap_map]
  apply List.flatMap_congr
  intro i _
  rw [axis_split D ℓ K long hK hℓ i]; simp [trip]

theorem loS_succ {u : ℕ} (hu : u < bb ℓ K) (i : Fin D) :
    loS D ℓ K u i = nm D i (bb ℓ K - 1 - u) :: loS D ℓ K (u + 1) i := by
  unfold loS
  rw [show bb ℓ K - u = (bb ℓ K - (u + 1)) + 1 by omega, List.range_succ, List.reverse_append]
  simp only [List.reverse_singleton, List.singleton_append, List.map_cons]
  congr 2; omega

