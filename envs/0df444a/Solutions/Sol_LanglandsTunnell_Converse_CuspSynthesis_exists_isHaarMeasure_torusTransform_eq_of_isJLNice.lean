      Matrix (Fin 2) (Fin 2) (v.adicCompletion K)) i j
    = (unitAt v z : v.adicCompletion K) * ((compAt v g : GL (Fin 2) (v.adicCompletion K)) :
      Matrix (Fin 2) (Fin 2) (v.adicCompletion K)) i j
