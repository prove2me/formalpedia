            ExactForwardSeed M)) => c.otherCut.val) hctx
    exact hv
  subst lc'
  subst rc'
  change
    exactReverseAliceContext
        ({ coordinate := i, partition := p, leftOrder := l,
           rightOrder := r, leftCut := lc, rightCut := rc } :
          ExactForwardSeed M) =
      exactReverseAliceContext
        ({ coordinate := i, partition := p, leftOrder := l',
