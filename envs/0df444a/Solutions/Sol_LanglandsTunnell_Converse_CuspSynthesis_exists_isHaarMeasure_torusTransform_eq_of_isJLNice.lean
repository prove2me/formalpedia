variable {K : Type} [Field K] [NumberField K]

private theorem t0544 {w : InfinitePlace K} (hw : w.IsReal) (b : (AdeleRing (𝓞 K) K)ˣ) :
    realCoord hw (NumberField.Idele.partAt K ∅ b) = realCoord hw b := by
  unfold realCoord
  rw [NumberField.Idele.partAt_fst]

private theorem t0545 {w : InfinitePlace K} (hw : w.IsComplex) (b : (AdeleRing (𝓞 K) K)ˣ) :
    d049 hw (NumberField.Idele.partAt K ∅ b) = d049 hw b := by
  unfold d049
  rw [NumberField.Idele.partAt_fst]

private theorem t0546 {w : InfinitePlace K} (hw : w.IsReal) (b : (AdeleRing (𝓞 K) K)ˣ) :
    ‖((b : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w‖ = |realCoord hw b| := by
  unfold realCoord
  rw [ringEquivRealOfIsReal_apply, ← Real.norm_eq_abs,
    (isometry_extensionEmbeddingOfIsReal hw).norm_map_of_map_zero (map_zero _)]

private theorem t0547 {w : InfinitePlace K} (hw : w.IsReal)
    (b : (AdeleRing (𝓞 K) K)ˣ) :
    extensionEmbedding w (((b : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w) = ((realCoord hw b : ℝ) : ℂ) := by
  unfold realCoord
  rw [ringEquivRealOfIsReal_apply, extensionEmbeddingOfIsReal_apply]

private theorem t0548 {w : InfinitePlace K} (hw : w.IsComplex)
    (b : (AdeleRing (𝓞 K) K)ˣ) :
    ‖((b : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w‖ = ‖d049 hw b‖ := by
  unfold d049
  rw [ringEquivComplexOfIsComplex_apply, (isometry_extensionEmbedding w).norm_map_of_map_zero (map_zero _)]

private theorem t0549 {w : InfinitePlace K} (hw : w.IsComplex)
    (b : (AdeleRing (𝓞 K) K)ˣ) :
    extensionEmbedding w (((b : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w) = d049 hw b := by
  unfold d049
  rw [ringEquivComplexOfIsComplex_apply]

variable (archR : ∀ w : InfinitePlace K, w.IsReal → RealArchParam)
  (archC : ∀ w : InfinitePlace K, w.IsComplex → ComplexArchParam)
  (dR : ∀ (w : InfinitePlace K) (hw : w.IsReal), ArchDatumR (archR w hw))
  (dC : ∀ (w : InfinitePlace K) (hw : w.IsComplex), ArchDatumC (archC w hw))

private noncomputable def d050 {w : InfinitePlace K} (hw : w.IsReal) (g₀ : AdelicGL2 (𝓞 K) K) (u : ℂ) (a : ℤ)
    (s : ℂ) (y : ℝ) : ℂ :=
  (dR w hw).W (ArchR.diagOne y * realComponent w hw g₀) * ((Real.sqrt |y| : ℝ) : ℂ)⁻¹ *
      ((Real.sqrt |(realComponent w hw g₀).det| : ℝ) : ℂ)⁻¹ *
    (((|y| : ℝ) : ℂ) ^ ((w.mult : ℂ) * u) * (((y : ℝ) : ℂ) / ((|y| : ℝ) : ℂ)) ^ a) *
    ((|y| ^ w.mult : ℝ) : ℂ) ^ (s - 1)

private noncomputable def d051 {w : InfinitePlace K} (hw : w.IsComplex) (g₀ : AdelicGL2 (𝓞 K) K) (u : ℂ)
    (k : ℤ) (s : ℂ) (z : ℂ) : ℂ :=
  (dC w hw).W (ArchC.diagOne z * complexComponent w hw g₀) * ((‖z‖ : ℝ) : ℂ)⁻¹ *
      ((‖(complexComponent w hw g₀).det‖ : ℝ) : ℂ)⁻¹ *
    (((‖z‖ : ℝ) : ℂ) ^ ((w.mult : ℂ) * u) * (z / ((‖z‖ : ℝ) : ℂ)) ^ k) *
    ((‖z‖ ^ w.mult : ℝ) : ℂ) ^ (s - 1)

private theorem t0550 (g₀ : AdelicGL2 (𝓞 K) K) {η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
    {uR : ∀ w : InfinitePlace K, w.IsReal → ℂ} {aR : ∀ w : InfinitePlace K, w.IsReal → ℤ}
    {uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ} {kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ}
    (hR : ∀ w (hw : w.IsReal), IsArchCompAt K η w (uR w hw) (aR w hw))
    (hC : ∀ w (hw : w.IsComplex), IsArchCompAt K η w (uC w hw) (kC w hw)) (s : ℂ) (b : (AdeleRing (𝓞 K) K)ˣ) :
    zetaIntegrand (fun g => archW' archR archC dR dC (g * g₀)) η s (NumberField.Idele.partAt K ∅ b) =
      (∏ v : {w : InfinitePlace K // w.IsReal},
          d050 archR dR v.2 g₀ (uR v.1 v.2) (aR v.1 v.2) s (realCoord v.2 b)) *
        ∏ v : {w : InfinitePlace K // w.IsComplex},
            d051 archC dC v.2 g₀ (uC v.1 v.2) (kC v.1 v.2) s (d049 v.2 b) := by

  have hfactor : ∀ w : InfinitePlace K,
      d015 archR archC dR dC w (diagOne (NumberField.Idele.partAt K ∅ b) * g₀) *
          ((archLocalChar η w (d006 w b) : ℂˣ) : ℂ) *
          ((‖((b : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w‖ ^ w.mult : ℝ) : ℂ) ^ (s - 1) =
        if hw : w.IsReal then d050 archR dR hw g₀ (uR w hw) (aR w hw) s (realCoord hw b)
        else d051 archC dC (not_isReal_iff_isComplex.mp hw) g₀ (uC w (not_isReal_iff_isComplex.mp hw))
          (kC w (not_isReal_iff_isComplex.mp hw)) s (d049 (not_isReal_iff_isComplex.mp hw) b) := by
    intro w
    split_ifs with hw
    · rw [t0542 archR archC dR dC w hw, t0544, hR w hw (d006 w b),
        t0053, t0546 hw, t0547 hw]
      unfold d050
      ring1
    · have hw' : w.IsComplex := not_isReal_iff_isComplex.mp hw
      rw [t0543 archR archC dR dC w hw', t0545,
        hC w hw' (d006 w b), t0053, t0548 hw',
        t0549 hw']
      unfold d051
      ring1
  unfold zetaIntegrand
  show archW' archR archC dR dC (diagOne (NumberField.Idele.partAt K ∅ b) * g₀) *
      ((η (NumberField.Idele.partAt K ∅ b) : ℂˣ) : ℂ) *
      ((ideleNorm K (NumberField.Idele.partAt K ∅ b) : ℝ) : ℂ) ^ (s - 1) = _
  rw [t0218, t0537,
    ideleNorm_eq_prod_norm_infinitePlace_pow_mult_of_snd_eq_one K _ (t0536 b)]
  simp only [NumberField.Idele.partAt_fst]
  rw [t0491 Finset.univ
      (fun w : InfinitePlace K => ‖((b : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w‖ ^ w.mult)
      (fun w _ => pow_nonneg (norm_nonneg _) _) (s - 1), ← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
  simp only [hfactor]
  rw [← Fintype.prod_subtype_mul_prod_subtype (fun w : InfinitePlace K => w.IsReal)]
  congr 1
  · exact Finset.prod_congr rfl fun v _ => by rw [dif_pos v.2]
  · refine Fintype.prod_equiv (Equiv.subtypeEquivRight fun w => not_isReal_iff_isComplex) _ _ fun v => ?_
    rw [dif_neg v.2]
    rfl

