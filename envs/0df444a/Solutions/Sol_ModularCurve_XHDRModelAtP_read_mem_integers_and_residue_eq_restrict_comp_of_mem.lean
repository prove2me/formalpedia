    refine ⟨h₂, ⟨hg₁, hres.trans (congrArg _ (germ_app_congr_aux E21.symm V _ hg₁' hg₁ g))⟩, fun hu => hunit ?_⟩
    have hu' := (isUnit_germ_congr_aux V hξz h0 h0' g hu).map (bcOA.stalkMap _).hom
