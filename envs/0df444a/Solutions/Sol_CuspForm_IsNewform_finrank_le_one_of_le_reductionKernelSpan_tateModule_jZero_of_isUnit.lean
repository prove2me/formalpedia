      fitProj (flvl p f k) ⟨x k, hx k⟩ := Subtype.ext rfl
  show ((fitProj (flvl p f k) ⟨seqπ p f hfin x hx k, seqπ_mem p f hfin x hx k⟩ : lvl J p k) : J) = _
  rw [e, h]
