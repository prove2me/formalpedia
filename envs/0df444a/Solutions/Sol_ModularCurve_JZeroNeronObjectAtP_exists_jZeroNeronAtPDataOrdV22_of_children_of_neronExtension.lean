p2m_export "ModularCurve.JZeroNeronObjectAtP" "smul_mem_extPts"
theorem pts_nsmul (n : ℕ) (x : JZero (N₀ * p)) : O.pts (n • x) = O.L.nsmul (genPt p) n (O.pts x) := by
  induction n with
  | zero => rw [zero_nsmul, pts_zero]; rfl
  | succ n ih => rw [succ_nsmul, O.pts_add, ih]; rfl

private theorem _root_.ModularCurve.JZeroNeronObjectAtP.exists_extPts_nsmul_eq {m : ℕ}
    (hdiv : ∀ s : SchemeHomOver Λ.σA O.g, ∃ z : SchemeHomOver Λ.σA O.g, O.L.nsmul Λ.σA m z = s)
    {x : JZero (N₀ * p)} (hx : x ∈ O.extPts) : ∃ e ∈ O.extPts, m • e = x := by
  obtain ⟨s, hs⟩ := (O.ext_iff x).mp hx
  obtain ⟨z, hz⟩ := hdiv s
  refine ⟨O.pts.symm (GoodReductionJacobian.schemeHomOverComp (barPt A) Λ.hσA z), ⟨z, ?_⟩, ?_⟩
  · rw [Equiv.apply_symm_apply]; rfl
  · apply O.pts.injective
    rw [pts_nsmul, Equiv.apply_symm_apply, ← RelativeGroupLaw.nsmul_natural, hz]
    exact hs.symm

