@[scoped simp] private theorem levelFactor_mk {I J : Ideal A} (h : J ≤ I) (x : X) :
    levelFactor X h (Submodule.Quotient.mk x) = Submodule.Quotient.mk x := rfl

private theorem levelFactor_surjective {I J : Ideal A} (h : J ≤ I) :
    Function.Surjective (levelFactor X h) := fun z => by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ z
