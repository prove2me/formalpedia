/-- The four Wronskian rotations of `(R,S)=(a-b,a+b)` in explicit form. -/
theorem gaussK_explicit (a b : ℤ) :
    gaussK (a,b) =
      wronskianRSWeight (a - b) (a + b) +
      wronskianRSWeight (-(a + b)) (a - b) +
      wronskianRSWeight (-(a - b)) (-(a + b)) +
      wronskianRSWeight (a + b) (-(a - b)) := by
  unfold gaussK
  rw [Fin.sum_univ_four]
  simp [gaussUnitRotate]

