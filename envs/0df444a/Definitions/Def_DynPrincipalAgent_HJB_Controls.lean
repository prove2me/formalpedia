-- title:
--   Definition 2.1, (2.3), (2.14)–(2.16), (3.9) — admissible contracts, Girsanov measures, the agent's forward utility and his quitting time
-- statement:
--   This file sets up the stochastic layer of the model.
--
--   **Setting.** $(\Omega,\mathcal F,\mathbb P)$ is a probability space carrying a standard one-dimensional Brownian motion $B$. For a starting time $t$, $\mathbb F^t$ is the filtration generated by the shifted Brownian motion $B^t_s=B_s-B_t$.
--
--   **Admissible controls** (Definition 2.1 on $[t,T]$). $\mathcal A^P_t$ is the set of $\mathbb F^t$-progressively measurable payment processes $\eta$ with $-C(\eta)\le\eta\le C_0$; $\mathcal A^A_t$ is the set of $\mathbb F^t$-progressively measurable processes $Z$ with
--   $$\mathbb E^{\mathbb P}\Big[\int_s^T|Z_r|^2dr\ \Big|\ \mathcal F^t_s\Big]\le C(Z),\qquad t\le s\le T.\qquad(2.1)$$
--
--   **Girsanov measures** (2.3), (2.16). For a drift $\alpha$, $d\mathbb P^\alpha=\exp\big(\int_t^T\alpha_s\,dB_s-\tfrac12\int_t^T|\alpha_s|^2ds\big)d\mathbb P$. The agent's effort is $\alpha=I^h(\theta;\cdot,Z)$, giving $\mathbb P^{\theta,Z}$ and $\mathbb E^{\theta,Z}$.
--
--   **Forward utility** (2.14)–(2.15). For $(\eta,Z)\in\mathcal A^P_t\times\mathcal A^A_t$,
--   $$\mathcal X^{\theta;t,x,\eta,Z}_s=x-\int_t^s\big[f(\theta;r,\eta_r)+H(\theta;r,Z_r)\big]dr+\int_t^sZ_r\,dB_r,\qquad t\le s\le T,$$
--   and $\mathcal A^\theta_{t,x}$ is the set of $(\eta,Z)$ with $\mathcal X^{\theta;t,x,\eta,Z}_T=0$.
--
--   **Quitting time** (3.9). $\tau^{\theta;t,x,\eta,Z}=\inf\{s\ge t:\mathcal X^{\theta;t,x,\eta,Z}_s=\underline L^\theta_s\}\wedge T$.
--
--   **The contract (3.6).** With $\varepsilon_n=(\overline L^\theta_t-x)/n$, $\eta^n_s=I^f\big(\theta;s,f(\theta;s,C_0)-n\big)\mathbf 1_{[t,t+\varepsilon_n)}(s)+C_0\mathbf 1_{[t+\varepsilon_n,T]}(s)$.
--
--   **Formalization Note.** Process time is $\mathbb R_{\ge0}$. The Itô integral is the published `Peng1990.SMP.IsItoIntegral` of $Z\mathbf 1_{[t,\infty)}$ for the filtration $\mathbb F^t$, so $\int_a^bZ\,dB=J_b-J_a$ for $t\le a\le b$; because hitting times read whole paths, the version $J$ used in $\mathcal X$ is required to have almost surely continuous paths on $[t,T]$. The conditional bound (2.1) is written as $\mathbb E[\mathbf 1_A\int_s^T|Z_r|^2dr]\le C(Z)\,\mathbb P(A)$ for all $A\in\mathcal F^t_s$ (a lower integral, so no junk value arises). Membership in $\mathcal A^\theta_{t,x}$ also asks that almost surely the drift of (2.14) is integrable on $[t,T]$, so that the Lebesgue integral in $\mathcal X$ is the genuine one; this holds for every admissible pair. The quitting time is the first time in $[t,T]$ with $\mathcal X_s-\underline L^\theta_s\le0$ (Mathlib's `hittingBtwn`, equal to $T$ if there is none); for a start $x>\underline L^\theta_t$ and continuous paths it is the first time $\mathcal X_s=\underline L^\theta_s$. The forward process is written with $H$ against $dB$, the first of the two equal forms in (2.14).
-- source:
--   Zhang & Zhu, A Dynamic Principal Agent Problem with One-sided Commitment, arXiv:2208.06473v3, Definition 2.1 and (2.3), p. 7; (2.14)–(2.16), pp. 9–10; p. 11 (shifted filtration); (3.6), p. 14; (3.9), p. 15

import Mathlib
import Definitions.Def_Peng1990_SMP_Stochastic
import Definitions.Def_DynPrincipalAgent_HJB_Model

open MeasureTheory ProbabilityTheory Set Filter Topology
open scoped NNReal ENNReal

namespace DynPrincipalAgent.HJB

open Peng1990.SMP

/-- The probabilistic setting (p. 7): a probability space `(Ω, 𝓕, ℙ)` carrying a standard
one-dimensional Brownian motion `B` (Mathlib's `IsBrownianReal`), with measurable coordinates `B_s`.
Process time is `ℝ≥0`. -/
structure Setting (Ω : Type) [MeasurableSpace Ω] where
  /-- the probability measure `ℙ` -/
  P : Measure Ω
  isProb : IsProbabilityMeasure P
  /-- the Brownian motion `B` -/
  B : ℝ≥0 → Ω → ℝ
  meas : ∀ s, Measurable (B s)
  brownian : IsBrownianReal B P

namespace Setting

variable {Ω : Type} [mΩ : MeasurableSpace Ω] (S : Setting Ω)

/-- The shifted Brownian motion `B^t_s = B_s − B_t` on `[t, T]` (p. 11), extended by `0` for `s < t`. -/
def shiftB (t : ℝ≥0) : ℝ≥0 → Ω → ℝ :=
  fun s ω => S.B (max s t) ω - S.B t ω

/-- The filtration `𝔽^t = 𝔽^{B^t}` generated by the shifted Brownian motion (p. 11). -/
noncomputable def filt (t : ℝ≥0) : Filtration ℝ≥0 mΩ :=
  Filtration.natural (S.shiftB t) (fun _ => ((S.meas _).sub (S.meas _)).stronglyMeasurable)

end Setting

variable {Ω : Type} [mΩ : MeasurableSpace Ω]

/-- A process `u` with values in a measurable space is progressively measurable for `𝓕`: for every `s`,
`(r, ω) ↦ u r ω` on `[0, s] × Ω` is measurable for `𝓑([0, s]) ⊗ 𝓕_s`. -/
def IsProg {β : Type} [MeasurableSpace β] (𝓕 : Filtration ℝ≥0 mΩ) (u : ℝ≥0 → Ω → β) : Prop :=
  ∀ s, Measurable[Subtype.instMeasurableSpace.prod (𝓕 s)] fun p : Set.Iic s × Ω => u p.1 p.2

/-- The process `Z 1_{[t, ∞)}`: a process on `[t, T]` extended by `0` before `t`, so that its Itô
integral `J` from `0` satisfies `∫_a^b Z dB = J_b − J_a` for `t ≤ a ≤ b`. -/
noncomputable def startAt (t : ℝ≥0) (Z : ℝ≥0 → Ω → ℝ) : ℝ≥0 → Ω → ℝ :=
  fun s ω => if t ≤ s then Z s ω else 0

namespace Model

variable {Θ : Type} (M : Model Θ) (S : Setting Ω)

/-- `𝒜^P_t` (Definition 2.1 (i) on the shifted space, p. 11): `η` is `𝔽^t`-progressively measurable and
`−C(η) ≤ η_s ≤ C₀` for `s ∈ [t, T]`, for some constant `C(η)`. -/
def IsAP (t : ℝ≥0) (η : ℝ≥0 → Ω → ℝ) : Prop :=
  IsStronglyProgressive (S.filt t) η ∧
    ∃ K : ℝ, ∀ s : ℝ≥0, t ≤ s → s ≤ M.T → ∀ ω, -K ≤ η s ω ∧ η s ω ≤ M.C₀

/-- `𝒜^A_t` (Definition 2.1 (ii) on the shifted space, p. 11): `Z` is `𝔽^t`-progressively measurable and
satisfies (2.1): `E^ℙ[∫_s^T |Z_r|² dr | 𝓕^t_s] ≤ C(Z)` a.s. for every `s ∈ [t, T]`, written as
`E^ℙ[1_A ∫_s^T |Z_r|² dr] ≤ C(Z) ℙ(A)` for every `A ∈ 𝓕^t_s` (a lower integral in `ℝ≥0∞`). -/
def IsAA (t : ℝ≥0) (Z : ℝ≥0 → Ω → ℝ) : Prop :=
  IsStronglyProgressive (S.filt t) Z ∧
    ∃ K : ℝ, ∀ s : ℝ≥0, t ≤ s → s ≤ M.T → ∀ A : Set Ω, MeasurableSet[S.filt t s] A →
      ∫⁻ ω in A, ∫⁻ r in Icc (s : ℝ) M.T, ‖Z r.toNNReal ω‖ₑ ^ 2 ∂volume ∂S.P
        ≤ ENNReal.ofReal K * S.P A

/-- `J` is a continuous version of the Itô integral `∫_0^· Z_r 1_{[t,T]}(r) dB_r` for the filtration
`𝔽^t` (`Peng1990.SMP.IsItoIntegral`), with almost surely continuous paths on `[t, T]`. Then
`∫_a^b Z dB = J_b − J_a` for `t ≤ a ≤ b ≤ T`. -/
def IsStochInt (t : ℝ≥0) (Z J : ℝ≥0 → Ω → ℝ) : Prop :=
  IsItoIntegral (S.filt t) S.P M.T S.B (startAt t Z) J ∧
    ∀ᵐ ω ∂S.P, ContinuousOn (fun s => J s ω) (Icc t M.T)

/-- The agent's effort `α_s = I^h(ζ_s; s, Z_s)` induced by a sensitivity process `Z` when the agent in
place at time `s` has type `ζ_s`. -/
noncomputable def alpha (ζ : ℝ≥0 → Ω → Θ) (Z : ℝ≥0 → Ω → ℝ) : ℝ≥0 → Ω → ℝ :=
  fun s ω => M.Ih (ζ s ω) s (Z s ω)

/-- The Girsanov measure (2.3), (2.16) on `[t, T]` for the drift `α`, given the Itô integral `I` of
`α 1_{[t,T]}` against `B`: `dℙ^α = exp(∫_t^T α dB − ½ ∫_t^T |α_r|² dr) dℙ`. With `α = I^h(θ; ·, Z)` this is
`ℙ^{θ,Z}`, and with `α = I^h(ζ; ·, Z)` it is `ℙ^{ζ,Z}` (p. 29). -/
noncomputable def girsanov (t : ℝ≥0) (α I : ℝ≥0 → Ω → ℝ) : Measure Ω :=
  S.P.withDensity fun ω => ENNReal.ofReal (Real.exp
    (I M.T ω - I t ω - (1 / 2) * ∫ r in Icc (t : ℝ) M.T, (α r.toNNReal ω) ^ 2))

/-- The drift `r ↦ f(θ; r, η_r) + H(θ; r, Z_r)` of the forward process (2.14), on a path `ω`. -/
noncomputable def drift (θ : Θ) (η Z : ℝ≥0 → Ω → ℝ) (ω : Ω) : ℝ → ℝ :=
  fun r => M.f θ r (η r.toNNReal ω) + M.H θ r (Z r.toNNReal ω)

/-- The forward process (2.14) started at time `t` from `x`, for the type `θ`, path by path:
`𝒳^{θ;t,x,η,Z}_s = x − ∫_t^s [f(θ; r, η_r) + H(θ; r, Z_r)] dr + ∫_t^s Z_r dB_r`, where
`∫_t^s Z dB = J_s − J_t` for a continuous version `J` of the Itô integral (`IsStochInt`). The same
formula with a random start `(τ_i, 𝒳_{τ_i})` and type `ζ_{τ_i}` is used in (5.8). -/
noncomputable def fwd (θ : Θ) (t : ℝ≥0) (x : ℝ) (η Z J : ℝ≥0 → Ω → ℝ) (s : ℝ≥0) (ω : Ω) : ℝ :=
  x - (∫ r in Icc (t : ℝ) s, M.drift θ η Z ω r) + (J s ω - J t ω)

/-- `(η, Z) ∈ 𝒜^θ_{t,x}` ((2.15)) with a fixed continuous version `J` of `∫ Z dB`: `η ∈ 𝒜^P_t`,
`Z ∈ 𝒜^A_t`, almost surely the drift of (2.14) is integrable on `[t, T]`, and `𝒳^{θ;t,x,η,Z}_T = 0`. -/
def InAWith (θ : Θ) (t : ℝ≥0) (x : ℝ) (η Z J : ℝ≥0 → Ω → ℝ) : Prop :=
  M.IsAP S t η ∧ M.IsAA S t Z ∧ M.IsStochInt S t Z J ∧
    ∀ᵐ ω ∂S.P, IntegrableOn (M.drift θ η Z ω) (Icc (t : ℝ) M.T) ∧ M.fwd θ t x η Z J M.T ω = 0

/-- `(η, Z) ∈ 𝒜^θ_{t,x}` ((2.15)). -/
def InA (θ : Θ) (t : ℝ≥0) (x : ℝ) (η Z : ℝ≥0 → Ω → ℝ) : Prop :=
  ∃ J, M.InAWith S θ t x η Z J

/-- The quitting time (3.9) `τ^{θ;t,x,η,Z} = inf{s ≥ t : 𝒳^{θ;t,x,η,Z}_s = L̲^θ_s} ∧ T`, as the first
time in `[t, T]` at which `𝒳_s − L̲^θ_s ≤ 0` (Mathlib's `hittingBtwn`, which is `T` when there is no
such time). For a start `x > L̲^θ_t` and continuous paths this is the first time `𝒳_s = L̲^θ_s`. -/
noncomputable def hitTime (θ : Θ) (t : ℝ≥0) (x : ℝ) (η Z J : ℝ≥0 → Ω → ℝ) : Ω → ℝ≥0 :=
  hittingBtwn (fun s ω => M.fwd θ t x η Z J s ω - M.Lund θ s) (Iic 0) t M.T

/-- The deterministic contract (3.6) of Lemma 3.4, as a function of time: with
`ε_n = (L̄^θ_t − x)/n`, `η^n_s = I^f(θ; s, f(θ; s, C₀) − n) 1_{[t, t+ε_n)}(s) + C₀ 1_{[t+ε_n, T]}(s)`. -/
noncomputable def eta36 (θ : Θ) (t : ℝ≥0) (x : ℝ) (n : ℕ) (s : ℝ) : ℝ :=
  if (t : ℝ) ≤ s ∧ s < t + (M.Lbar θ t - x) / n then M.If θ s (M.f θ s M.C₀ - n)
  else if (t : ℝ) + (M.Lbar θ t - x) / n ≤ s ∧ s ≤ M.T then M.C₀ else 0

end Model

end DynPrincipalAgent.HJB


