variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]

/-- The convex cone generated by a finite family. -/
def cone {ι : Type*} [Fintype ι] (v : ι → V) : Set V :=
  {x | ∃ α : ι → ℝ, (∀ k, 0 ≤ α k) ∧ x = ∑ k, α k • v k}

/-- Conic Carathéodory: a nonnegative combination is a nonnegative combination of a linearly
independent subfamily. -/
lemma carath {ι : Type*} [Fintype ι] [DecidableEq ι] (v : ι → V) :
    ∀ (T : Finset ι) (α : ι → ℝ), (∀ k, 0 ≤ α k) → (∀ k ∉ T, α k = 0) →
      ∃ S : Finset ι, LinearIndependent ℝ (fun k : S => v k) ∧
        ∃ β : S → ℝ, (∀ k, 0 ≤ β k) ∧ ∑ k : S, β k • v k = ∑ k, α k • v k := by
  intro T
  induction T using Finset.strongInduction with
  | H T ih =>
  intro α hα hT
  have hsumT : ∑ k : T, α k • v k = ∑ k, α k • v k := by
    rw [Finset.sum_coe_sort T (fun k => α k • v k)]
    apply Finset.sum_subset (Finset.subset_univ _)
    intro k _ hk; simp [hT k hk]
  by_cases hli : LinearIndependent ℝ (fun k : T => v k)
  · exact ⟨T, hli, fun k => α k, fun k => hα k, hsumT⟩
  · obtain ⟨g, hg, i, hi⟩ := Fintype.not_linearIndependent_iff.mp hli
    obtain ⟨g', hg', i, hi'⟩ : ∃ g' : T → ℝ, ∑ k, g' k • v k = 0 ∧ ∃ i, 0 < g' i := by
      rcases lt_or_gt_of_ne hi with h | h
      · refine ⟨-g, ?_, i, by simp only [Pi.neg_apply]; linarith⟩
        simp only [Pi.neg_apply, neg_smul, Finset.sum_neg_distrib, hg, neg_zero]
      · exact ⟨g, hg, i, h⟩
    set G : ι → ℝ := fun k => if h : k ∈ T then g' ⟨k, h⟩ else 0 with hGdef
    have hGT : ∀ k : T, G k = g' k := by intro k; simp [hGdef, k.2]
    have hGout : ∀ k ∉ T, G k = 0 := by intro k hk; simp [hGdef, hk]
    have hGsum : ∑ k, G k • v k = 0 := by
      rw [← Finset.sum_subset (Finset.subset_univ T) (fun k _ hk => by simp [hGout k hk])]
      rw [← Finset.sum_coe_sort T]
      simp only [hGT]; exact hg'
    set P := T.filter (fun k => 0 < G k) with hPdef
    have hP : P.Nonempty := ⟨i, by rw [hPdef, Finset.mem_filter, hGT i]; exact ⟨i.2, hi'⟩⟩
    obtain ⟨k0, hk0P, hk0min⟩ := P.exists_min_image (fun k => α k / G k) hP
    have hk0T : k0 ∈ T := (Finset.mem_filter.mp hk0P).1
    have hGk0 : 0 < G k0 := (Finset.mem_filter.mp hk0P).2
    set t := α k0 / G k0 with htdef
    have ht0 : 0 ≤ t := div_nonneg (hα k0) hGk0.le
    set α' : ι → ℝ := fun k => α k - t * G k with hα'def
    have hα' : ∀ k, 0 ≤ α' k := by
      intro k
      by_cases hk : k ∈ T ∧ 0 < G k
      · have h1 := hk0min k (Finset.mem_filter.mpr hk)
        have h2 : t * G k ≤ α k := (le_div_iff₀ hk.2).mp h1
        simp only [hα'def]; linarith
      · by_cases hkT : k ∈ T
        · have : G k ≤ 0 := by
            by_contra hc; exact hk ⟨hkT, lt_of_not_ge hc⟩
          simp only [hα'def]; nlinarith [hα k]
        · simp only [hα'def, hGout k hkT]; simp [hα k]
    have hα'0 : ∀ k ∉ T.erase k0, α' k = 0 := by
      intro k hk
      rw [Finset.mem_erase, not_and_or, not_not] at hk
      rcases hk with rfl | hk
      · simp only [hα'def, htdef]; field_simp; ring
      · simp only [hα'def, hGout k hk, hT k hk]; ring
    have hsum' : ∑ k, α' k • v k = ∑ k, α k • v k := by
      simp only [hα'def, sub_smul, mul_smul, Finset.sum_sub_distrib, ← Finset.smul_sum, hGsum,
        smul_zero, sub_zero]
    obtain ⟨S, hS, β, hβ, hβs⟩ := ih (T.erase k0) (Finset.erase_ssubset hk0T) α' hα' hα'0
    exact ⟨S, hS, β, hβ, hβs.trans hsum'⟩

lemma cone_closed {ι : Type*} [Fintype ι] (v : ι → V) : IsClosed (cone v) := by
  classical
  have hEq : cone v = ⋃ (S : Finset ι), ⋃ (_ : LinearIndependent ℝ (fun k : S => v k)),
      (Fintype.linearCombination ℝ (fun k : S => v k)) '' {β | ∀ k, 0 ≤ β k} := by
    ext x; constructor
    · rintro ⟨α, hα, rfl⟩
      obtain ⟨S, hS, β, hβ, hsum⟩ := carath v Finset.univ α hα (by simp)
      simp only [Set.mem_iUnion, Set.mem_image, Set.mem_ofPred_eq]
      exact ⟨S, hS, β, hβ, by rw [Fintype.linearCombination_apply]; exact hsum⟩
    · simp only [Set.mem_iUnion, Set.mem_image, Set.mem_ofPred_eq]
      rintro ⟨S, -, β, hβ, rfl⟩
      refine ⟨fun k => if h : k ∈ S then β ⟨k, h⟩ else 0, ?_, ?_⟩
      · intro k; dsimp only; split_ifs
        · exact hβ _
        · exact le_rfl
      · rw [Fintype.linearCombination_apply]
        rw [← Finset.sum_subset (Finset.subset_univ S) (fun k _ hk => by simp [hk])]
        rw [← Finset.sum_coe_sort S]
        simp
  rw [hEq]
  refine isClosed_iUnion_of_finite (fun S => isClosed_iUnion_of_finite (fun hS => ?_))
  have hinj : LinearMap.ker (Fintype.linearCombination ℝ (fun k : S => v k)) = ⊥ := by
    rw [LinearMap.ker_eq_bot]
    exact linearIndependent_iff_injective_fintypeLinearCombination.mp hS
  have hemb := LinearMap.isClosedEmbedding_of_injective hinj
  apply hemb.isClosedMap
  have : {β : S → ℝ | ∀ k, 0 ≤ β k} = ⋂ k, {β | 0 ≤ β k} := by ext; simp
  rw [this]
  exact isClosed_iInter fun k => isClosed_le continuous_const (continuous_apply k)

lemma cone_convex {ι : Type*} [Fintype ι] (v : ι → V) : Convex ℝ (cone v) := by
  rintro _ ⟨α, hα, rfl⟩ _ ⟨β, hβ, rfl⟩ a b ha hb _
  refine ⟨fun k => a * α k + b * β k, fun k => by have := hα k; have := hβ k; positivity, ?_⟩
  simp [Finset.smul_sum, Finset.sum_add_distrib, add_smul, mul_smul]

/-- Farkas' lemma for finitely generated cones. -/
lemma farkas {ι : Type*} [Fintype ι] [DecidableEq ι] (v : ι → V) (b : V) (hb : b ∉ cone v) :
    ∃ f : StrongDual ℝ V, (∀ k, 0 ≤ f (v k)) ∧ f b < 0 := by
  obtain ⟨f, u, hf, hu⟩ := geometric_hahn_banach_closed_point (cone_convex v) (cone_closed v) hb
  have h0 : (0 : V) ∈ cone v := ⟨0, fun _ => le_rfl, by simp⟩
  have hu0 : 0 < u := by simpa using hf 0 h0
  refine ⟨-f, ?_, ?_⟩
  · intro k
    by_contra hneg
    have hpos : 0 < f (v k) := by
      simp only [neg_apply, not_le, neg_neg_iff_pos] at hneg; exact hneg
    have hmem : (u / f (v k)) • v k ∈ cone v := by
      refine ⟨fun j => if j = k then u / f (v k) else 0, fun j => ?_, ?_⟩
      · dsimp only; split_ifs
        · exact div_nonneg hu0.le hpos.le
        · exact le_rfl
      · simp [ite_smul]
    have := hf _ hmem
    rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ hpos.ne'] at this
    exact lt_irrefl _ this
  · simp only [neg_apply, neg_neg_iff_pos]
    linarith

end SOSLPAux

open SOSLPAux in
theorem solution {l n : ℕ} {ι : Type*} [Fintype ι] (hn : 0 < n) (x : Fin n → E l) (z : ι → E l)
    (hx : ∀ i, ∃ j, z j = x i) (hfeas : ∃ cpl, IsFeasibleCoupling (n := n) z 0 cpl) :
    IsGreatest
      {v : ℝ | ∃ (lam : E l) (γ : Fin n → ℝ), (∀ i, 0 ≤ γ i) ∧
        (∀ i, -⟪lam, x i⟫ - γ i ≤ ⨅ j, (-⟪lam, z j⟫ + ‖x i - z j‖ ^ 2)) ∧
        v = -⟪lam, xbar x⟫ - (1 / (n : ℝ)) * ∑ i, γ i}
      (sos x z 0) := by
  classical
  set p := sos x z 0 with hpdef
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have hιne : Nonempty ι := ⟨(hx ⟨0, hn⟩).choose⟩
  set A := transportCost x z '' {cpl | IsFeasibleCoupling (n := n) z 0 cpl} with hA
  have hne : A.Nonempty := by
    obtain ⟨cpl, h⟩ := hfeas; exact ⟨_, cpl, h, rfl⟩
  have hbdd : BddBelow A := by
    refine ⟨0, ?_⟩
    rintro _ ⟨cpl, ⟨hnn, -, -⟩, rfl⟩
    unfold transportCost
    exact Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ =>
      mul_nonneg (hnn i j) (by positivity)
  have hp_le : ∀ cpl, IsFeasibleCoupling (n := n) z 0 cpl → p ≤ transportCost x z cpl :=
    fun cpl h => csInf_le hbdd ⟨cpl, h, rfl⟩
  have hxbar : ∀ lam : E l, ⟪lam, xbar x⟫ = (1 / (n : ℝ)) * ∑ i, ⟪lam, x i⟫ := by
    intro lam; unfold xbar; rw [inner_smul_right, inner_sum]
  -- weak duality
  have weak : ∀ (lam : E l) (γ : Fin n → ℝ),
      (∀ i, -⟪lam, x i⟫ - γ i ≤ ⨅ j, (-⟪lam, z j⟫ + ‖x i - z j‖ ^ 2)) →
      -⟪lam, xbar x⟫ - (1 / (n : ℝ)) * ∑ i, γ i ≤ p := by
    intro lam γ hcon
    apply le_csInf hne
    rintro _ ⟨cpl, ⟨hnn, hrow, hmean⟩, rfl⟩
    have hij : ∀ i j, cpl i j * (⟪lam, z j⟫ - ⟪lam, x i⟫ - γ i) ≤ cpl i j * ‖x i - z j‖ ^ 2 := by
      intro i j
      have h1 := (hcon i).trans (ciInf_le (Finite.bddBelow_range _) j)
      exact mul_le_mul_of_nonneg_left (by linarith) (hnn i j)
    have hsum := Finset.sum_le_sum fun i (_ : i ∈ Finset.univ) =>
      Finset.sum_le_sum fun j (_ : j ∈ Finset.univ) => hij i j
    have e1 : ∑ i, ∑ j, cpl i j * (⟪lam, z j⟫ - ⟪lam, x i⟫ - γ i) =
        ⟪lam, ∑ i, ∑ j, cpl i j • z j⟫ - ∑ i, (∑ j, cpl i j) * (⟪lam, x i⟫ + γ i) := by
      simp only [inner_sum, inner_smul_right, Finset.sum_mul, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
    rw [e1, hmean, inner_zero_right] at hsum
    simp only [hrow] at hsum
    unfold transportCost
    rw [hxbar, ← Finset.mul_sum, Finset.sum_add_distrib, mul_add] at *
    linarith
  -- strong duality via Farkas
  let c : Fin n → ι → ℝ := fun i j => ‖x i - z j‖ ^ 2
  let gen : Option (Option (Fin n × ι)) → ((Fin n → ℝ) × E l × ℝ) := fun o =>
    match o with
    | none => (0, 0, 1)
    | some none => (fun _ => -(1 / (n : ℝ)), 0, -p)
    | some (some ij) => (Pi.single ij.1 1, z ij.2, c ij.1 ij.2)
  have hnot : (-((0, 0, 1) : ((Fin n → ℝ) × E l × ℝ))) ∉ cone gen := by
    rintro ⟨α, hα, hαeq⟩
    simp only [Fintype.sum_option, Fintype.sum_prod_type, gen] at hαeq
    set a0 := α none
    set a1 := α (some none)
    set π : Fin n → ι → ℝ := fun i j => α (some (some (i, j))) with hπ
    have hπnn : ∀ i j, 0 ≤ π i j := fun i j => hα _
    have hA1 : ∀ i, ∑ j, π i j = a1 / n := by
      intro i
      have := congrArg (fun w : ((Fin n → ℝ) × E l × ℝ) => w.1 i) hαeq
      simp [Prod.fst_sum, Finset.sum_apply, Pi.single_apply] at this
      rw [hπ]; simp only
      field_simp at this ⊢
      linarith
    have hB : ∑ i, ∑ j, π i j • z j = 0 := by
      have := congrArg (fun w : ((Fin n → ℝ) × E l × ℝ) => w.2.1) hαeq
      simp [Prod.snd_sum, Prod.fst_sum] at this
      rw [hπ]; exact this.symm
    have hC : a0 - a1 * p + ∑ i, ∑ j, π i j * c i j = -1 := by
      have := congrArg (fun w : ((Fin n → ℝ) × E l × ℝ) => w.2.2) hαeq
      simp [Prod.snd_sum] at this
      rw [hπ]; simp only [c]; linarith
    have ha0 : 0 ≤ a0 := hα _
    have ha1 : 0 ≤ a1 := hα _
    rcases ha1.eq_or_lt with h1 | h1
    · have hz : ∀ i j, π i j = 0 := by
        intro i j
        have hs := hA1 i
        rw [← h1, zero_div] at hs
        exact (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => hπnn i j)).mp hs j (Finset.mem_univ _)
      simp only [hz, zero_mul, Finset.sum_const_zero, add_zero, ← h1] at hC
      linarith
    · let cpl : Fin n → ι → ℝ := fun i j => π i j / a1
      have hfc : IsFeasibleCoupling (n := n) z 0 cpl := by
        refine ⟨fun i j => div_nonneg (hπnn i j) h1.le, fun i => ?_, ?_⟩
        · simp only [cpl, ← Finset.sum_div, hA1 i]; field_simp
        · simp only [cpl, div_eq_mul_inv, mul_comm _ a1⁻¹, mul_smul, ← Finset.smul_sum, hB,
            smul_zero]
      have hcost : transportCost x z cpl = (∑ i, ∑ j, π i j * c i j) / a1 := by
        unfold transportCost
        simp only [cpl, c, Finset.sum_div]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring
      have := hp_le cpl hfc
      rw [hcost, le_div_iff₀ h1] at this
      nlinarith
  obtain ⟨f, hfgen, hfb⟩ := farkas gen _ hnot
  set s := f ((0, 0, 1) : ((Fin n → ℝ) × E l × ℝ)) with hs
  have hspos : 0 < s := by
    rw [map_neg] at hfb; linarith
  let u : Fin n → ℝ := fun i => f ((Pi.single i 1, 0, 0) : ((Fin n → ℝ) × E l × ℝ))
  let g : StrongDual ℝ (E l) :=
    (f.comp (ContinuousLinearMap.inr ℝ (Fin n → ℝ) (E l × ℝ))).comp
      (ContinuousLinearMap.inl ℝ (E l) ℝ)
  set μ : E l := (InnerProductSpace.toDual ℝ (E l)).symm g with hμ
  have hμg : ∀ y, ⟪μ, y⟫ = f ((0, y, 0) : ((Fin n → ℝ) × E l × ℝ)) := by
    intro y; rw [hμ, InnerProductSpace.toDual_symm_apply]; rfl
  have hdecomp : ∀ (a : Fin n → ℝ) (y : E l) (t : ℝ),
      f ((a, y, t) : ((Fin n → ℝ) × E l × ℝ)) = ∑ i, a i * u i + ⟪μ, y⟫ + t * s := by
    intro a y t
    have : ((a, y, t) : ((Fin n → ℝ) × E l × ℝ)) = ∑ i, a i • ((Pi.single i 1, 0, 0) : ((Fin n → ℝ) × E l × ℝ)) + ((0, y, 0) : ((Fin n → ℝ) × E l × ℝ)) +
        t • ((0, 0, 1) : ((Fin n → ℝ) × E l × ℝ)) := by
      ext k
      · simp [Prod.fst_sum, Finset.sum_apply, Pi.single_apply]
      · simp [Prod.snd_sum, Prod.fst_sum]
      · simp [Prod.snd_sum]
    rw [this, map_add, map_add, map_sum, map_smul, hμg]
    simp only [map_smul, smul_eq_mul, u]
    rfl
  have hgen_ij : ∀ i j, 0 ≤ u i + ⟪μ, z j⟫ + c i j * s := by
    intro i j
    have := hfgen (some (some (i, j)))
    simp only [gen] at this
    rw [hdecomp] at this
    simpa [Pi.single_apply] using this
  have hgen_b : 0 ≤ -(1 / (n : ℝ)) * ∑ i, u i - p * s := by
    have := hfgen (some none)
    simp only [gen] at this
    rw [hdecomp, inner_zero_right, ← Finset.mul_sum] at this
    linarith
  let lam : E l := -(1 / s) • μ
  let γ : Fin n → ℝ := fun i => (u i + ⟪μ, x i⟫) / s
  have hlam : ∀ y, ⟪lam, y⟫ = -(⟪μ, y⟫ / s) := by
    intro y; simp only [lam, inner_smul_left, inner_neg_left]; simp; ring
  have hγ : ∀ i, 0 ≤ γ i := by
    intro i
    obtain ⟨j, hj⟩ := hx i
    have := hgen_ij i j
    simp only [c, hj, sub_self, norm_zero] at this
    exact div_nonneg (by simpa using this) hspos.le
  have hcon : ∀ i, -⟪lam, x i⟫ - γ i ≤ ⨅ j, (-⟪lam, z j⟫ + ‖x i - z j‖ ^ 2) := by
    intro i
    apply le_ciInf
    intro j
    have := hgen_ij i j
    rw [hlam, hlam]
    simp only [γ, c] at this ⊢
    have e : ⟪μ, z j⟫ / s + ‖x i - z j‖ ^ 2 - (⟪μ, x i⟫ / s - (u i + ⟪μ, x i⟫) / s) =
        (u i + ⟪μ, z j⟫ + ‖x i - z j‖ ^ 2 * s) / s := by
      field_simp; ring
    rw [← sub_nonneg]
    simp only [neg_neg]
    rw [e]
    exact div_nonneg this hspos.le
  have hval : p ≤ -⟪lam, xbar x⟫ - (1 / (n : ℝ)) * ∑ i, γ i := by
    rw [hlam, hxbar]
    simp only [γ, ← Finset.sum_div, Finset.sum_add_distrib]
    rw [← sub_nonneg]
    have e : - -((1 / (n : ℝ) * ∑ i, ⟪μ, x i⟫) / s) -
        1 / (n : ℝ) * ((∑ i, u i + ∑ i, ⟪μ, x i⟫) / s) - p =
        (-(1 / (n : ℝ)) * ∑ i, u i - p * s) / s := by
      field_simp; ring
    rw [e]
    exact div_nonneg hgen_b hspos.le
  refine ⟨⟨lam, γ, hγ, hcon, le_antisymm hval (weak lam γ hcon)⟩, ?_⟩
  rintro _ ⟨lam', γ', -, hcon', rfl⟩
  exact weak lam' γ' hcon'
