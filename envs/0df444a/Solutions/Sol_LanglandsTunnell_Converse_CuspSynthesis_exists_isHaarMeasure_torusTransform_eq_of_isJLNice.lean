    ((AdelicDock.finEmbed (𝓞 K) K) (AdelicDock.localEmbed (𝓞 K) K v k))) :
    GL (Fin 2) (w.adicCompletion K)) : Matrix (Fin 2) (Fin 2) (w.adicCompletion K)) = _
