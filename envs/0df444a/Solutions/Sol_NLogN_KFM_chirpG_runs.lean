theorem chirpLoop_runs {M : MulSpec} {pM : Fin P} (hM : MulOK I iprog pM M)
    (hdom : ∀ x y, M.dom x y) {w φ : ℕ} (hΦ : ∀ x y : ℤ, zsz x ≤ w → zsz y ≤ w → M.Φ x y ≤ φ)
    (Δ n : ℕ) (s : IState HS) (h g c : GI) (R0 RH RK LR : List Item)
    (h0 : s.G 0 = .int g.1 :: .int g.2 :: R0) (hH : s.G pH = .int h.1 :: .int h.2 :: RH)
    (hK : s.G pK = .int c.1 :: .int c.2 :: RK) (hR : s.G pR = .int (2 ^ Δ) :: LR)
    (hB : ∀ k ≤ n, GBnd w (cst Δ c h g k).1 ∧ GBnd w (cst Δ c h g k).2) (hc : GBnd w c) :
    IRuns I iprog (rpt pA pC pD n (chirpB pM)) s
      (((s.upd 0 (.int (cst Δ c h g n).2.1 :: .int (cst Δ c h g n).2.2 :: R0)).upd pH
        (.int (cst Δ c h g n).1.1 :: .int (cst Δ c h g n).1.2 :: RH)).upd pV
        (ints (gflat (outL Δ c h g n).reverse) ++ s.G pV))
      (n * (cChirpB φ w Δ + 64) + 60 + cRpt n) := by
  let T : ℕ → IState HS := fun k =>
    ((s.upd 0 (.int (cst Δ c h g k).2.1 :: .int (cst Δ c h g k).2.2 :: R0)).upd pH
        (.int (cst Δ c h g k).1.1 :: .int (cst Δ c h g k).1.2 :: RH)).upd pV
        (ints (gflat (outL Δ c h g k).reverse) ++ s.G pV)
  have H := rpt_runs (I := I) (iprog := iprog) (A := pA) (C := pC) (D := pD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) n T
    (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) (fun k => by simp +decide [T])
    (chirpB pM) (cChirpB φ w Δ)
    (by
      intro k hk LA LC LD
      have e1 : gmulT Δ (cst Δ c h g k).2 (cst Δ c h g k).1 = (cst Δ c h g (k + 1)).2 := by
        rw [cst_succ]; rfl
      have e2 : gmulT Δ (cst Δ c h g k).1 c = (cst Δ c h g (k + 1)).1 := by
        rw [cst_succ]; rfl
      have Hb := chirpB_runs (I := I) (iprog := iprog) hM hdom hΦ Δ (cf3 (T k) pA pC pD LA LC LD)
        (cst Δ c h g k).1 (cst Δ c h g k).2 c R0 RH RK LR
        (by simp +decide [T, cf3]) (by simp +decide [T, cf3]) (by simp +decide [T, cf3, hK])
        (by simp +decide [T, cf3, hR]) (hB k hk.le).2 (hB k hk.le).1 hc
        (by rw [e1]; exact (hB (k + 1) hk).2) (by rw [e2]; exact (hB (k + 1) hk).1)
      rw [e1, e2] at Hb
      refine Hb.mono' ?_ le_rfl
      have e3 : ints (gflat (outL Δ c h g (k + 1)).reverse) =
          .int (cst Δ c h g k).2.1 :: .int (cst Δ c h g k).2.2 ::
            ints (gflat (outL Δ c h g k).reverse) := by
        rw [outL_succ, List.reverse_append]; simp [ints]
      simp only [T, cf3, e3]
      clear Hb e1 e2 e3
      ((apply NLogN.IState.ext' <;> intros <;>
               simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
             split_ifs <;>
           simp_all +decide)))
  have e0 : T 0 = s := by
    simp only [T, outL, List.range_zero, List.map_nil, List.reverse_nil, gflat_nil, cst,
      Function.iterate_zero, id]
    rw [← h0, ← hH]; simp [ints]
  rw [e0] at H
  exact H

theorem revP_runs (L : List GI) (B : ℕ) (hB : ∀ z ∈ L, GBnd B z) (s : IState HS) (RV : List Item)
    (hV : s.G pV = ints (gflat L.reverse) ++ RV) :
    IRuns I iprog (rpt pA pC pD L.length (mvPB pV pW)) s
      ((s.upd pV RV).upd pW (ints (gflat L) ++ s.G pW))
      (L.length * (1000 * (2 * B + 2) + 64) + 60 + cRpt L.length) := by
  set Mr := L.reverse with hMr
  have hlen : Mr.length = L.length := List.length_reverse
  let T : ℕ → IState HS := fun k =>
    (s.upd pV (ints (gflat (Mr.drop k)) ++ RV)).upd pW (ints (gflat (Mr.take k).reverse) ++ s.G pW)
  have H := rpt_runs (I := I) (iprog := iprog) (A := pA) (C := pC) (D := pD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) L.length T
    (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) (fun k => by simp +decide [T])
    (mvPB pV pW) (1000 * (2 * B + 2))
    (by
      intro k hk LA LC LD
      have hk' : k < Mr.length := by rw [hlen]; exact hk
      have hd : Mr.drop k = Mr[k] :: Mr.drop (k + 1) := List.drop_eq_getElem_cons hk'
      have hz : GBnd B Mr[k] := hB _ (List.mem_reverse.1 (List.getElem_mem hk'))
      have Hb := mvPB_runs (I := I) (iprog := iprog) pV pW (by decide) (by decide) (by decide)
        (cf3 (T k) pA pC pD LA LC LD) Mr[k].1 Mr[k].2 (ints (gflat (Mr.drop (k + 1))) ++ RV)
        (by simp +decide only [T, cf3, IState.upd_G, if_true, if_false]
            simp only [hd, ints, gflat_cons, List.map_cons, List.cons_append])
      refine Hb.mono' ?_ ?_
      · have ht : Mr.take (k + 1) = Mr.take k ++ [Mr[k]] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hk']; rfl
        have e2 : ints (gflat (Mr.take (k + 1)).reverse) =
            .int Mr[k].1 :: .int Mr[k].2 :: ints (gflat (Mr.take k).reverse) := by
          rw [ht, List.reverse_append]; simp [ints]
        simp only [T, cf3, e2]
        clear Hb e2 ht hd
        ((apply NLogN.IState.ext' <;> intros <;>
                 simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
               split_ifs <;>
             simp_all +decide))
      · unfold cPair; obtain ⟨_, _⟩ := hz; omega)
  have e0 : T 0 = s := by
    simp only [T, List.drop_zero, List.take_zero, List.reverse_nil, gflat_nil]
    rw [← hV]; simp [ints]
  have e1 : T L.length = (s.upd pV RV).upd pW (ints (gflat L) ++ s.G pW) := by
    simp only [T]
    rw [← hlen, List.drop_length, List.take_length, hMr, List.reverse_reverse]; simp [ints]
  rw [e0, e1] at H
  exact H

theorem drop6B_runs (s : IState HS) (g h c : GI) (R0 RH RK : List Item)
    (h0 : s.G 0 = .int g.1 :: .int g.2 :: R0) (hH : s.G pH = .int h.1 :: .int h.2 :: RH)
    (hK : s.G pK = .int c.1 :: .int c.2 :: RK) :
