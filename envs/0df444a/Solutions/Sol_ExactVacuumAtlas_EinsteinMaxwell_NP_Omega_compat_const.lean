theorem cpdC_const (c : ℂ) (i : Fin n) (x : Pt n) : cpdC i (fun _ => c) x = 0 := by
  simp [cpdC]

/-- `cpdC` is local. -/
theorem cpdC_congr_of_eqOn {f h : Pt n → ℂ} {V : Set (Pt n)} (hV : IsOpen V) {x : Pt n}
    (hx : x ∈ V) (hfh : Set.EqOn f h V) (i : Fin n) : cpdC i f x = cpdC i h x := by
  unfold cpdC
  apply Filter.EventuallyEq.deriv_eq
  filter_upwards [eventually_update_mem hV hx i] with u hu
  exact hfh hu

