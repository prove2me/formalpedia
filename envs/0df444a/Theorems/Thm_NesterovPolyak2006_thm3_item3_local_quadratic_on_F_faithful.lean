-- title:
--   Theorem 3 (item 3) on a closed convex set $F$ — quadratic convergence of (3.5), (3.8)
-- statement:
--   Let $F\subseteq\mathbb{R}^n$ ($n\ge1$) be a closed convex set and $f:\mathbb{R}^n\to\mathbb{R}$ twice differentiable at every point of $F$, with gradient $f'$ and Hessian $f''$, whose Hessian is Lipschitz on $F$ in the spectral norm with constant $L>0$: $\|f''(x)-f''(y)\|\le L\|x-y\|$ for all $x,y\in F$. Let $x_0\in\operatorname{int}F$ with $\{x: f(x)\le f(x_0)\}\subseteq\operatorname{int}F$. Let $\{x_k\}_{k\ge0}$ be generated by the relaxed cubic regularization of Newton method
--
--   $$x_{k+1}=T_{M_k}(x_k),\qquad M_k\in(0,2L],$$
--
--   where $T_M(x)$ is any global minimizer over $\mathbb{R}^n$ of $y\mapsto\langle f'(x),y-x\rangle+\tfrac12\langle f''(x)(y-x),y-x\rangle+\tfrac M6\|y-x\|^3$. Suppose $f''(x_0)\succ0$ and $\delta_0=L\|f'(x_0)\|/\lambda_n^2(f''(x_0))\le\frac14$, where $\lambda_n$ is the smallest eigenvalue. Then $x_k$ converges to a point $x^*$ with $f'(x^*)=0$, $f''(x^*)\succ0$ and $x^*$ a local minimizer of $f$, and for every $k\ge1$
--
--   $$\|f'(x_k)\|\le\lambda_n^2(f''(x_0))\,\frac{9e^{3/2}}{16L}\left(\frac12\right)^{2^k}.$$
--
--   This is Theorem 3, item 3, of Nesterov and Polyak under the paper's standing assumptions of Section 2, with a general set $F$. The existing theorem CubicNewton.LocalQuad.theorem3_local_quadratic is the case $F=\mathbb{R}^n$.
--
--   **Formalization Note** $\lambda_n$ is `lamMin`, the infimum of $\langle Av,v\rangle$ over the unit sphere; $\delta_0$ is `deltaMeasure`. Derivatives are two-sided at every point of $F$, as in the other missions on this paper. The hypothesis $x_0\in\operatorname{int}F$ is implied by the level-set hypothesis and is kept because the paper states it.
-- source:
--   Nesterov & Polyak, Cubic regularization of Newton method and its global performance, Math. Program. Ser. A 108 (2006) 177–205, doi:10.1007/s10107-006-0706-8, p. 187, Theorem 3, item 3, inequality (3.8); standing assumptions pp. 180–181; method (3.5) p. 186

import Mathlib
import Definitions.Def_CubicNewton_LocalQuad_IsRelaxedRun
import Definitions.Def_CubicNewton_LocalQuad_deltaMeasure

theorem NesterovPolyak2006.thm3_item3_local_quadratic_on_F_faithful {n : ℕ}
    (F : Set (EuclideanSpace ℝ (Fin n))) (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (H : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (L : ℝ)
    (hF_closed : IsClosed F) (hF_convex : Convex ℝ F)
    (hf : ∀ x ∈ F, HasGradientAt f (g x) x) (hg : ∀ x ∈ F, HasFDerivAt g (H x) x)
    (hL : 0 < L) (hLip : ∀ x ∈ F, ∀ y ∈ F, ‖H x - H y‖ ≤ L * ‖x - y‖)
    (hn : 0 < n) (x : ℕ → EuclideanSpace ℝ (Fin n)) (M : ℕ → ℝ)
    (hx₀ : x 0 ∈ interior F) (hlevel : {y | f y ≤ f (x 0)} ⊆ interior F)
    (hrun : CubicNewton.LocalQuad.IsRelaxedRun L g H x M)
    (hpos : 0 < CubicNewton.Shared.lamMin (H (x 0)))
    (hδ0 : CubicNewton.LocalQuad.deltaMeasure L g H (x 0) ≤ 1 / 4) :
    ∃ xs : EuclideanSpace ℝ (Fin n),
      Filter.Tendsto x Filter.atTop (nhds xs) ∧ g xs = 0 ∧ 0 < CubicNewton.Shared.lamMin (H xs) ∧
      IsLocalMin f xs ∧
      ∀ k, 1 ≤ k → ‖g (x k)‖ ≤
        CubicNewton.Shared.lamMin (H (x 0)) ^ 2 * (9 * Real.exp (3 / 2) / (16 * L)) * (1 / 2 : ℝ) ^ (2 ^ k) := by sorry
