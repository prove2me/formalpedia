    (b := Q.p / 6) (len := (dsG Q.p Q.h (D + 1) (σ6 Q) Q.K).length) (P := BN6 Q)
    (sv := Q.sB D) (t := Q.tB D) hP le_rfl le_rfl hb hlen (s_le6 hQ hD) (t_ge6 hQ hD)
