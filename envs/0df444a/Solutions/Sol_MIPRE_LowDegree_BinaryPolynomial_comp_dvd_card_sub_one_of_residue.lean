    [Algebra F K] [Fintype K] (f : Polynomial F) (hi : Irreducible f)
    (a b : K) (ha : aeval a f = 0) (ha0 : a ≠ 0) (q : ℕ)
    (hq : q ∣ Fintype.card K - 1) (hb : b ^ q = a) :
    f.comp (X ^ q) ∣ X ^ (Fintype.card K - 1) - 1 := by
  have hb0 : b ≠ 0 := by
    intro h
    subst b
    by_cases hq0 : q = 0
