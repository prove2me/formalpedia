    have hπT : ∀ k, k ≤ n → ∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓS : ℓ ∉ (↑S : Set ℕ)) (hℓk : ¬ ℓ ∣ Nf k) (hℓn : ¬ ℓ ∣ Nf n),
