-- title:
--   Proof of Theorem 4.1, pp. 481–482, (6)–(8) — window limits z¹, …, z^T of a convergent subsequence and their block-minimality
-- statement:
--   Assume $f$ never takes the value $-\infty$, $f(x^0)<\infty$, $X^0=\{x: f(x)\le f(x^0)\}$ is compact and $f$ is continuous at every point of $X^0$. Let $\{x^r\}$ be generated by the BCD method from $x^0$, let $T\ge N$, and let $\{x^r\}_{r\in\mathcal R}$ be a subsequence converging to $z$. Then, after passing to a further subsequence of $\mathcal R$, there are points $z^1,\dots,z^T$ and blocks $s^1,\dots,s^T$ such that:
--   1. for $j=1,\dots,T$, $\{x^{r-T+1+j}\}_{r\in\mathcal R}$ converges to $z^j$, and the block chosen at iteration $r-T+1+j$ equals $s^j$ for every $r\in\mathcal R$; moreover $z^{T-1}=z$;
--   2. (6) for $j=1,\dots,T$: $\;f(x^0)\ge\lim_{r\to\infty}f(x^r)=f(z^j)$;
--   3. (7) for $j=1,\dots,T$ and all $d_{s^j}$: $\;f(z^j)\le f(z^j+(0,\dots,d_{s^j},\dots,0))$; and for $j=2,\dots,T$, $z^j_k=z^{j-1}_k$ for all $k\ne s^j$;
--   4. (8) for $j=2,\dots,T$ and all $d_{s^j}$:
--   $$f(z^{j-1})\le f(z^{j-1}+(0,\dots,d_{s^j},\dots,0)).$$
--
--   These limit relations reduce the convergence analysis of Theorem 4.1 to statements about finitely many points $z^1,\dots,z^T$.
--
--   **Formalization Note.** The subsequence $\mathcal R$ is indexed by its window start: $\rho(m)$ is the paper's $r-T+1$, so $x^{r-T+1+j}$ is `x (ρ m + j)` and $x^r$ is `x (ρ m + (T - 1))`; the further subsequence is $\rho\circ\psi$ with $\psi$ strictly increasing. The block chosen at iteration $r-T+1+j$ is `s (ρ m + j - 1)`. Blocks are 0-based. The essentially cyclic rule is not needed for (6)–(8) and is not assumed; only $T\ge N$ is kept. When $T=1$, $z^0$ (that is $z^{T-1}$) is just the limit $z$. Continuity is continuity of $f$ at every point of $X^0$ (see the goal theorem).
-- source:
--   Tseng, Convergence of a block coordinate descent method for nondifferentiable minimization, J. Optim. Theory Appl. 109 (2001), pp. 481–482, proof of Theorem 4.1, (6), (7), (8)

import Mathlib
import Definitions.Def_TsengBCD_Stationary_Setting

namespace TsengBCD.Stationary

open Filter Topology

theorem limit_chain {N : ℕ} [NeZero N] {n : Fin N → ℕ} (f : X n → EReal)
    (hbot : ∀ x, f x ≠ ⊥) (x0 : X n) (hx0 : f x0 ≠ ⊤) (hcpt : IsCompact (levelSet f x0))
    (hcont : ∀ y ∈ levelSet f x0, ContinuousAt f y)
    (s : ℕ → Fin N) (x : ℕ → X n) (hx : x 0 = x0) (hrun : IsBCDRun f s x)
    (T : ℕ) (hT : N ≤ T) (ρ : ℕ → ℕ) (hρ : StrictMono ρ) (z : X n)
    (hz : Tendsto (fun m => x (ρ m + (T - 1))) atTop (𝓝 z)) :
    ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∃ (zs : ℕ → X n) (ss : ℕ → Fin N),
      (∀ j, 1 ≤ j → j ≤ T →
        Tendsto (fun m => x (ρ (ψ m) + j)) atTop (𝓝 (zs j)) ∧
          ∀ m, s (ρ (ψ m) + j - 1) = ss j) ∧
      zs (T - 1) = z ∧
      (∀ j, 1 ≤ j → j ≤ T →
        f (zs j) ≤ f x0 ∧ Tendsto (fun r => f (x r)) atTop (𝓝 (f (zs j)))) ∧
      (∀ j, 1 ≤ j → j ≤ T → ∀ d : EuclideanSpace ℝ (Fin (n (ss j))),
        f (zs j) ≤ f (zs j + Pi.single (ss j) d)) ∧
      (∀ j, 2 ≤ j → j ≤ T → ∀ k : Fin N, k ≠ ss j → zs j k = zs (j - 1) k) ∧
      (∀ j, 2 ≤ j → j ≤ T → ∀ d : EuclideanSpace ℝ (Fin (n (ss j))),
        f (zs (j - 1)) ≤ f (zs (j - 1) + Pi.single (ss j) d)) := by sorry

end TsengBCD.Stationary
