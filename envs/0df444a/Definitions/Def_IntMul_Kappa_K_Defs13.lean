section
-- Source module: Solutions.KFDGen
/-!
# KFD: the fine offset-table generator

Fine specifications of KIL2's `genP` stages and KIL4's uniform generator `genPU` (programs
unchanged).  All entries are residues `< Q`, so every element operation costs `O(b)` with the
*local* bound `zsz (2Q) ≤ b`; loop counts enter only linearly (`cLp N c N`, since
`zsz N ≤ N`).  `genPU_fsp`: cost `≤ 10^9 · (n + 1) · (vol A + 1) · (b + 2)`, where `vol A` is
the number of table entries (blocks).  No global size bound is needed.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KIL AModel

section Proofs

variable (s : IState HS) {Q b : ℕ}

def cBodyF (M b : ℕ) : ℕ :=
  cLp M (cInner b) M + cLp M (250 * (b + 2)) M + (14 + 1) * 2000 * (b + 2)

def cOuterF (a M b : ℕ) : ℕ := cLp a (cBodyF M b) a

def cStageF (a M b : ℕ) : ℕ :=
  (1 + 1) * 2000 * (b + 2) + cOuterF a M b + (2 * b + 2) + cLp M (2 * b + 2) M +
    cLp (a * M) (250 * (b + 2)) (a * M)

end Proofs

/-! ## The uniform stage and generator -/

def cStageUF (a M b : ℕ) : ℕ := 200 * cStageF a M b + 2 * (2 * a + 2) + 2 * (2 * b + 2) +
  2 * (2 * M + 2) + 2 * (2 * (a * M) + 2)

/-- Fine cost of the uniform stages. -/
def stCostF (b : ℕ) : List (ℕ × ℕ) → List (ℕ × ℕ) → ℕ
  | [], _ => 1
  | x :: rv, suf => cStageUF x.1 (vol (suf.map Prod.fst)) b + stCostF b rv (x :: suf)

end KFD

end NLogN

end

section
-- Source module: Solutions.KFDRot
/-!
# KFD: the fine block rotation `rotP`

Fine specification of KILRot's `rotP` (program unchanged).  Every record move is a fine `mvK`
(`O(B·(w+2))` for a record of `B` entries of size `≤ w`), every per-block number (`Q`, `a_p`,
`Q - a_p`) is bounded by `Q` itself (`zsz Q ≤ Q`), so a block of `Q` records costs
`O(Q·B·(w+2))`; one multiplication `P·Q·B` per call costs `O((Bb+2)^2)`.

`rotP_fspec`: `rotP` at cost `≤ 10^6 (P·Q·B + 1)(w + 2) + 10^8 (Bb + 2)^2`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KIL AModel

/-- Fine cost of moving one record of `B` entries of size `≤ w`. -/
def cRecF (B w : ℕ) : ℕ := 3000 * (B + 1) * (w + 2)

/-- Fine cost bound of one rotated block. -/
def cRBlkF (Q B w : ℕ) : ℕ :=
  4 * (8000 * (Q + 2) + (1500 * Q + 1200) + Q * cRecF B w) + (2 * Q + 2)

section Proof

variable (s : IState HS) (r : ℕ → ℕ → List ℤ) (P Q B w : ℕ) (as : ℕ → ℕ)

/-- Fine cost bound of `rotP`. -/
def cRotF (P Q B w Bb : ℕ) : ℕ :=
  (5 + 1) * 10 ^ 7 * (Bb + 2) ^ 2 + (1000 * (Bb + 2) + P * (cRBlkF Q B w + 1100)) +
    (200 * (Bb + 2) + (1500 * (P * (Q * B)) + 1200) + P * (Q * B) * (250 * (w + 2))) + (2 * Bb + 2)

end Proof

end KFD

end NLogN

