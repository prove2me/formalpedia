theorem Formalism.DivisionValues.OperatorNormFrames.quot_rep {n D : ℕ} (Hc X0 : Matrix (Fin n) (Fin n) ℂ) (h0 : IsUnit X0.det)
    (hH : (X0⁻¹)ᴴ * X0⁻¹ = Hc) (Pc : Matrix (Fin D) (Fin n) ℂ) (XQ : Matrix (Fin D) (Fin D) ℂ)
    (hQ : IsUnit XQ.det) (hG : (XQ⁻¹)ᴴ * XQ⁻¹ = (Pc * Hc⁻¹ * Pcᴴ)⁻¹) (y : Fin D → ℂ) :
    ∃ x : Fin n → ℂ, Pc.mulVec x = y ∧ fnorm X0 x = fnorm XQ y ∧
      ∀ u : Fin n → ℂ, Pc.mulVec u = 0 → fmaj X0 x u = 0 := by sorry
