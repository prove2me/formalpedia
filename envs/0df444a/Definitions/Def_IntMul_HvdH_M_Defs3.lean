def stripBody (d : ℕ) : RS :=
  NLogN.RS.seq (pop 0) (NLogN.RS.seq (mvK 0 40 51 (.lit d)) (asg 45 (.add (.reg 45) (.lit d))))

def stripLoop (d : ℕ) : RS := rep 43 (.reg 54) (stripBody d)

def stripP (d : ℕ) : RS := NLogN.RS.seq (asg 45 (.lit 0)) (NLogN.RS.seq (stripLoop d) (mvK 40 0 51 (.reg 45)))

def stripSt (s : IState HS) (S : List (List ℤ)) (Rest : List Item) (d q : ℕ) : IState HS :=
  ((s.upd 0 (ints (S.drop q).flatten ++ Rest)).upd 40
    (ints ((S.take q).map List.tail).flatten.reverse ++ s.G 40)).upd 45
    (.int ((q * d : ℕ) : ℤ) :: (s.G 45).tail)

/-! ## The whole transposition -/

/-- Radix sort with the record count on `54` and the key bits on `3`. -/
def sortW (w : ℕ) : RS :=
  NLogN.RS.seq (push 1 (.reg 54)) (NLogN.RS.seq (push 2 (.reg 3)) (NLogN.RS.seq (sortP w) (NLogN.RS.seq (pop 2) (pop 1))))

def transP (d : ℕ) : RS :=
  NLogN.RS.seq (attachP d) (NLogN.RS.seq (sortW (d + 1)) (NLogN.RS.seq (stripP d) (NLogN.RS.seq (pop 54) (NLogN.RS.seq (pop 45) (pop 42)))))

