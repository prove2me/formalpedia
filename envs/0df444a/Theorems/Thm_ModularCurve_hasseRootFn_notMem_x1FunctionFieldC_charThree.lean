theorem ModularCurve.hasseRootFn_notMem_x1FunctionFieldC_charThree
    (M : ℕ) [NeZero M] (hM : 5 ≤ M) (h3M : ¬ 3 ∣ M)
    (κ : Type) [Field κ] [IsAlgClosed κ] [CharP κ 3]
    (w : ModularCurve.IntegralWeightOneForm κ M) :
