-- title:
--   Canonical output characterizes the large-branch trace certificate
-- statement:
--   For a finite abelian group of order $M$ generated by $P$, suppose a native factor base with at least two blocks represents every group element by a block tuple. For any reference base and output predicate, the full Stage II trace certificate holds exactly when the predicate accepts the canonical exponent of the target. This characterization distinguishes existence of an algebraic certificate from the physical cost of computing its output.
-- source:
--   Deterministic Discrete Logarithms, §4.1–4.3, equations (4.1)–(4.5) and proof of Theorem 1.1, pp. 13–16; referee revisions R1 and R2.

import Definitions.Def_DetDLP_W3_Driver
set_option autoImplicit false
open DetDLP

theorem DetDLP.w3_driver_trace_certificate {V : Type} [AddCommGroup V] [Fintype V] [DecidableEq V] {M m : ℕ} [NeZero M]
    (hm : 2 ≤ m) (hM : 2 ≤ M) (hcard : Nat.card V = M) (P Q : V) (hg : addOrderOf P = M)
    (ref B : IndexedFactorBase V m) (hB : Function.Surjective B.tupleVal) (accepts : ℕ → Prop) :
    w3_traceOutput ref B M P Q accepts ↔ ∃ u, u < M ∧ u • P = Q ∧ accepts u := by sorry
