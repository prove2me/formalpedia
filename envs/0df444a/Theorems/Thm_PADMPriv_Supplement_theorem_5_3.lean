-- url     : https://prove2.me/theorems/2e5774c2-2cd2-439c-b802-2803143dd620
-- title:
--   Theorem 5.3 — Stop-PADM-$L_\lambda$ is $(\alpha,\varepsilon)$-RDP and $\mathbb E[\|\tilde x_{(K)}-x_\star\|_2^2+\|\tilde y_{(K)}-y_\star\|_2^2]$ obeys the explicit $\tilde O(1/n)$ bound
-- statement:
--   Assume: $A$, $B$ have full row rank and $m\ge1$; $(R,P_R)$ is a probability space and $f:\mathbb R^p\times R\to\mathbb R$ is such that each $f(\cdot,d)$ is convex, differentiable and $L$-Lipschitz with $L>0$ (Proposition 4.1), each $f(x,\cdot)$ is measurable and integrable, and $F(x)=\mathbb E_d f(x,d)$; the samplewise recovery condition $f(VAx,d)\le f(x,d)$ for all $x$ and $P_R$-a.e. $d$ (25) holds; $g$ is convex and $B$-induced $\varrho_g$-strongly convex.
--   Fix $\alpha>1$, $\varepsilon>0$ and $n\ge 8\ln(en)$, and set
--   $$
--   \beta=\frac{\varrho_g n}{8\ln(en)},\qquad C=\frac{L}{\beta\sqrt{\omega_A}},\qquad \lambda^2=m\alpha C^2\max\Big\{\alpha-1,\ \frac{2(e^2-1)\ln(en)}{n\varepsilon}\Big\}.
--   $$
--   Then Stop-PADM-$L_\lambda$ achieves $(\alpha,\varepsilon)$-RDP, $T_F$ has a unique fixed point, and with $\tilde x_{(K)}=V\tilde u_{(K)}$, $\tilde y_{(K)}=U(c-\tilde u_{(K)})$, $x_\star=Vu_\star$, $y_\star=U(c-u_\star)$ for the fixed point $u_\star$ of $T_F$,
--   $$
--   \begin{aligned}
--   \mathbb E\big(\|\tilde x_{(K)}-x_\star\|_2^2+\|\tilde y_{(K)}-y_\star\|_2^2\,\big|\,\Gamma_0\big)\le{}& \frac{4(\|V\|_2^2+\|U\|_2^2)\|\tilde u_{(0)}-u_\star\|_2^2}{(en)^2}+\frac{64L^2(\|V\|_2^2+\|U\|_2^2)\ln(en)}{\varrho_g^2\omega_A n}\\
--   &+\frac{32m^2\alpha L^2(\|V\|_2^2+\|U\|_2^2)\ln(en)}{\varrho_g^2\omega_A n}\max\Big\{\alpha-1,\frac{2(e^2-1)\ln(en)}{n\varepsilon}\Big\},
--   \end{aligned}
--   $$
--   which is the explicit form of the $\tilde O$ bound (27) and decays as $\tilde O(1/n)$.
--
--   This is the Laplace counterpart of Theorem 5.2: the same privacy level and rate, with the extra factor $m$ coming from $\mathbb E\|z_{(k)}\|_2^2=2m\lambda^2$.
--
--   **Formalization Note** The expectation is over the joint law of the i.i.d. records, the i.i.d. $L_m(0_m,\lambda)$ noise and $K$ (the published `PADMPriv.jointLaw`); the scale is called `s` and is the nonnegative square root. $\beta$, $C$, $\lambda$ are variables bound by their defining equations. The proximal problems (13) for every $f(\cdot,d)$ and for $g$ are assumed to have minimizers. The encoding is that of the published Gaussian twin `PADMPriv.theorem_5_2`.
--
--   Differences from the source:
--   - generalization: the Õ bound (27) → the explicit nonasymptotic bound derived on p.34; reason: the explicit bound implies (27) (bound the maximum by the sum of its terms); Õ alone has no formal content
--   - generalization: the bound on the conditional expectation → also concludes that the squared distance is integrable; reason: the proof establishes it; it rules out a junk integral
--   - encoding: E[· | Γ₀] → plain expectation over the joint law of data, noise and K; reason: Γ₀ is generated by the deterministic ũ₍₀₎ = A x̃₍₀₎, so it is trivial
--   - encoding: u⋆ the fixed point of T_F → concludes that T_F has exactly one fixed point and states the bound for every u⋆ with T_F(u⋆) = u⋆; reason: the same claim, written without a choice of u⋆
--   - encoding: F(x) := E_{d∼P_R}[f(x, d)] → f(x, ·) measurable and P_R-integrable for every x; reason: needed for the expectation to be defined; excludes only undefined cases
--   - encoding: ω_A > 0 the smallest eigenvalue of AAᵀ → hypothesis 0 < m; reason: ω_A is undefined for m = 0
--   - encoding: sample horizon n with n ≥ 8 ln(en) → n ≥ 1 together with n ≥ 8 ln(en); reason: at n = 0 Lean's ln(0) is 0 and the window is empty; n ≥ 1 is implicit
--   - encoding: the sample proximal operators P_{β,f(·,d),A} used as everywhere defined → hypothesis that (13) for f(·,d) has a minimizer for every record d and input u; reason: Algorithm 1 is undefined otherwise; excludes only undefined cases
--   - encoding: P_{β,g,B} used as everywhere defined → hypothesis that (13) for g has a minimizer at every input; reason: T_{f_k} is undefined otherwise; excludes only undefined cases
--   - encoding: β, C, λ² set by formulas → variables with hypotheses equating them to the formulas, the scale s the nonnegative square root; reason: names for the paper's values; same instances
--   - encoding: Laplace noise L_m(0_m, λ) with λ > 0 (p.10) → lapNoise m s: the product of m copies of the published one-dimensional Laplace law of scale s, with hypothesis 0 < s; reason: the same law; the scale is renamed because λ is a Lean keyword
--   - encoding: Condition 1 with C > 0 and Laplace scale λ > 0 (pp.9-10), with C = L/(β√ω_A) and λ² = mαC² max{…} → hypothesis 0 < L; reason: C > 0 and λ > 0 are equivalent to L > 0 under the other hypotheses; at L = 0 the scale is 0 and L(0, 0) is not a distribution; excludes only undefined cases
--   - encoding: the Rényi divergence of Definition 2 → computed through dP/dQ, +∞ when P is not absolutely continuous with respect to Q; reason: equal to Definition 2 for α > 1
-- source:
--   Li–Lai–Weng, Exact Feasibility and Privacy Amplification for Linearly Constrained Optimization, STOC 2027 submission (manuscript sha256 d58edbe0…0f3d), Theorem 5.3, p.12 (proof A.15, p.34; explicit bound p.34; (73)–(74), p.33)

import Mathlib
import Definitions.Def_PADMPriv_padmIter
import Definitions.Def_PADMPriv_Supplement_stopPadmLawLap
import Definitions.Def_PADMPriv_jointLaw
import Definitions.Def_PADMPriv_IsRDP
import Definitions.Def_PADMPriv_popLoss
import Definitions.Def_PADMPriv_pinvRight
import Definitions.Def_PADMPriv_omegaA
import Definitions.Def_LiqPremiaEq_opNorm
import Definitions.Def_PADMPriv_IsInducedStronglyConvex

namespace PADMPriv.Supplement

open MeasureTheory

/-- Theorem 5.3 (privacy–utility tradeoff of Stop-PADM-L_λ) of Li–Lai–Weng, *Exact Feasibility and
Privacy Amplification for Linearly Constrained Optimization*, STOC 2027 submission manuscript
(sha256 d58edbe0…0f3d), p.12 (proof A.15, p.34). Assume the hypotheses of Proposition 4.1, the
samplewise recovery condition (25) and `B`-induced `ϱ_g`-strong convexity of `g`. Fix `α > 1`,
`ε > 0` and `n ≥ 8 ln(en)`, and set `β = ϱ_g n/(8 ln(en))`, `C = L/(β√ω_A)`,
`λ² = mαC² max{α − 1, 2(e² − 1) ln(en)/(nε)}`. Then Stop-PADM-L_λ achieves `(α, ε)`-RDP, `T_F` has
a unique fixed point `u⋆`, and, with `x̃₍K₎ = Vũ₍K₎`, `ỹ₍K₎ = U(c − ũ₍K₎)`, `x⋆ = Vu⋆`,
`y⋆ = U(c − u⋆)`,
`E[‖x̃₍K₎ − x⋆‖₂² + ‖ỹ₍K₎ − y⋆‖₂²] ≤ 4(‖V‖₂² + ‖U‖₂²)‖ũ₍₀₎ − u⋆‖₂²/(en)²
+ 64L²(‖V‖₂² + ‖U‖₂²) ln(en)/(ϱ_g² ω_A n)
+ 32m²αL²(‖V‖₂² + ‖U‖₂²) ln(en)/(ϱ_g² ω_A n) · max{α − 1, 2(e² − 1) ln(en)/(nε)}` (p.34), the
explicit form of the `Õ` bound (27).

**Formalization Note** The `Õ` of (27) is replaced by the explicit bound the proof derives on
p.34 (from (73)–(74) with `δ² = E‖z₍ₖ₎‖₂² = 2mλ²`). The noise is `L_m(0_m, λ)` (`lapNoise`), the
scale named `s`; `L > 0`, so that `λ > 0` (p.10; Condition 1 has `C > 0`). The expectation is
over the published `jointLaw` with the Laplace noise; `E[· | Γ₀]` is a plain expectation (`Γ₀` is
generated by the deterministic `ũ₍₀₎ = A x̃₍₀₎`); the integrand is shown integrable. `β`, `C`, `s`
are variables bound by their defining equations (`s` the nonnegative square root). `m ≥ 1`,
`n ≥ 1`. Other conventions as in the published `PADMPriv.theorem_5_2`. -/
theorem theorem_5_3 {m p l : ℕ} {R : Type*} [MeasurableSpace R]
    (hm : 0 < m) (A : Matrix (Fin m) (Fin p) ℝ) (B : Matrix (Fin m) (Fin l) ℝ)
    (c : EuclideanSpace ℝ (Fin m)) (hA : A.rank = m) (hB : B.rank = m)
    (PR : Measure R) [IsProbabilityMeasure PR]
    (f : EuclideanSpace ℝ (Fin p) → R → ℝ) (L : NNReal) (hL : 0 < L)
    (hfconv : ∀ d, ConvexOn ℝ Set.univ (fun x => f x d))
    (hfdiff : ∀ d, Differentiable ℝ (fun x => f x d))
    (hfLip : ∀ d, LipschitzWith L (fun x => f x d))
    (hfmeas : ∀ x, Measurable (fun d => f x d)) (hfint : ∀ x, Integrable (fun d => f x d) PR)
    (hrec : ∀ x, ∀ᵐ d ∂PR,
      f (Matrix.toEuclideanLin (pinvRight A) (Matrix.toEuclideanLin A x)) d ≤ f x d)
    (g : EuclideanSpace ℝ (Fin l) → ℝ) (hg : ConvexOn ℝ Set.univ g) (ϱg : ℝ)
    (hgsc : IsInducedStronglyConvex B ϱg g)
    (α : ℝ) (hα : 1 < α) (ε : ℝ) (hε : 0 < ε) (n : ℕ) (hn : 1 ≤ n)
    (hnlog : 8 * Real.log (Real.exp 1 * n) ≤ n) (β : ℝ)
    (hβdef : β = ϱg * n / (8 * Real.log (Real.exp 1 * n))) (C : ℝ)
    (hCdef : C = L / (β * Real.sqrt (omegaA A))) (s : ℝ)
    (hsdef : s = Real.sqrt (m * α * C ^ 2 *
      max (α - 1) (2 * (Real.exp 2 - 1) * Real.log (Real.exp 1 * n) / (n * ε))))
    (hfprox : ∀ d u, ∃ x, IsProxMin β (fun x => f x d) A u x)
    (hgprox : ∀ v, ∃ y, IsProxMin β g B v y) (x₀ : EuclideanSpace ℝ (Fin p)) :
    IsRDP α ε (fun D : Fin n → R => stopPadmLawLap β s f g A B c x₀ D) ∧
      (∃! u : EuclideanSpace ℝ (Fin m), padmOp β (popLoss f PR) g A B c u = u) ∧
      ∀ ustar : EuclideanSpace ℝ (Fin m), padmOp β (popLoss f PR) g A B c ustar = ustar →
      Integrable (fun ω : ((Fin n → R) × (Fin n → EuclideanSpace ℝ (Fin m))) × ℕ =>
          let u := padmIter β f g A B c x₀ ω.1.1 ω.1.2 ω.2
          ‖Matrix.toEuclideanLin (pinvRight A) u - Matrix.toEuclideanLin (pinvRight A) ustar‖ ^ 2 +
            ‖Matrix.toEuclideanLin (pinvRight B) (c - u) -
              Matrix.toEuclideanLin (pinvRight B) (c - ustar)‖ ^ 2)
        (jointLaw n PR (lapNoise m s)) ∧
      ∫ ω, (let u := padmIter β f g A B c x₀ ω.1.1 ω.1.2 ω.2
          ‖Matrix.toEuclideanLin (pinvRight A) u - Matrix.toEuclideanLin (pinvRight A) ustar‖ ^ 2 +
            ‖Matrix.toEuclideanLin (pinvRight B) (c - u) -
              Matrix.toEuclideanLin (pinvRight B) (c - ustar)‖ ^ 2)
          ∂(jointLaw n PR (lapNoise m s)) ≤
        4 * (LiqPremiaEq.opNorm (pinvRight A) ^ 2 + LiqPremiaEq.opNorm (pinvRight B) ^ 2) *
            ‖Matrix.toEuclideanLin A x₀ - ustar‖ ^ 2 / (Real.exp 1 * n) ^ 2 +
          64 * (L : ℝ) ^ 2 * (LiqPremiaEq.opNorm (pinvRight A) ^ 2 + LiqPremiaEq.opNorm (pinvRight B) ^ 2) *
            Real.log (Real.exp 1 * n) / (ϱg ^ 2 * omegaA A * n) +
          32 * m ^ 2 * α * (L : ℝ) ^ 2 * (LiqPremiaEq.opNorm (pinvRight A) ^ 2 + LiqPremiaEq.opNorm (pinvRight B) ^ 2) *
            Real.log (Real.exp 1 * n) / (ϱg ^ 2 * omegaA A * n) *
            max (α - 1) (2 * (Real.exp 2 - 1) * Real.log (Real.exp 1 * n) / (n * ε)) := by sorry

end PADMPriv.Supplement
