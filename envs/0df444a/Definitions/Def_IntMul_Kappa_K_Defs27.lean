-- Source module: Solutions.KFUUBase
/-!
# KFUU §0: tools for the uniform `Φ` / `Φ⁻¹`

* `MS`: the `MulOK` spec of `kTable` (`KFM.mulCostH (zsz a + zsz b)`, total domain).
  `mulC pM a b r` pushes `top b * top a` on `r` with one call (`mulC_runs`).
* `ISim.uloop`, `ISim.rpt`: literal-count repetitions `rpt` become register-count `rptX`.
* `scan_runs`: a register-counted loop that moves a list from `X` to `Y` one entry per
  iteration and runs a body before each move.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU

open IntMul KIL KFC KFT AModel AModelL12

/-- The multiplication spec of `kTable`. -/
def MS : MulSpec := ⟨fun a b => KFM.mulCostH (zsz a + zsz b), fun _ _ => True⟩

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## One multiplication -/

/-- Push `top b * top a` on `r` (via `ARGM = 55`). -/
def mulC (pM : Fin P) (a b r : Fin HS) : IStmt HS P :=
  .seq (.op (.dup a ARGM)) (.seq (.op (.dup b ARGM)) (.seq (.call pM) (.op (.mv ARGM r))))

def cMul (x y : ℤ) : ℕ :=
  (dupCost (zsz x) + 17) + (dupCost (zsz y) + 17) + KFM.mulCostH (zsz y + zsz x) +
    (2 * moveCost (zsz (y * x)) + 19)

/-! ## Literal counts to register counts -/

/-! ## Scanning a list -/

/-- The scan state: `U k` with `X` holding the rest and `Y` the moved entries. -/
def scS (U : ℕ → IState HS) (X Y : Fin HS) (L : List ℤ) (RX RY : List Item) (k : ℕ) : IState HS :=
  ((U k).upd X (ints (L.drop k) ++ RX)).upd Y (ints (L.take k).reverse ++ RY)

/-- The state after the body of iteration `k` (before the move). -/
def scM (U : ℕ → IState HS) (X Y : Fin HS) (L : List ℤ) (RX RY : List Item) (k : ℕ) : IState HS :=
  ((U (k + 1)).upd X (ints (L.drop k) ++ RX)).upd Y (ints (L.take k).reverse ++ RY)

/-! ## The cost unit -/

/-- One arithmetic step (a multiplication or a small stack operation) on numbers of size `≤ Z`. -/
def cU (Z : ℕ) : ℕ := 10 ^ 4 * (Z + 1) + KFM.fmB (2 * Z)

end Gen

end NLogN.KFUU

end

