section
-- Source module: Solutions.KFMS4
/-!
# KFM S4: the cost of the scalar setup program

For `n ≥ n₀`, with `b = lg n`, every atom the setup expressions read is at most `A = 2^{b+2}`.
The expressions have degree at most `8`, so all values have fewer than `B = 8b+17` bits
(`KFMSm`). This gives

* **`setupA_cost`**, **`setupB_cost`**, **`setupC_cost`**: each at most `10^15 (b+1)^4`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS

/-- The size facts used by the cost bounds. -/
theorem setup_facts_r6c {n : ℕ} (hn : n0 ≤ n) :
    8192 ≤ bP n ∧ 1 ≤ dP n ∧ dP n ≤ bP n ∧ dP n ^ 2 ≤ bP n ∧ n ≤ 2 ^ bP n ∧ LP n < bP n ∧
    ℓP n ≤ LP n ∧ 64 * dP n ^ 2 * (256 * dP n ^ 2).factorial ≤ rP n ∧ rP n ≤ 2 ^ bP n ∧
    12 * dP n ^ 2 * bP n ≤ 2 ^ bP n ∧ 64 ≤ rP n ∧ srcQ (dP n) (rP n) ≤ 3 * 2 ^ bP n := by
  obtain ⟨-, -, hb, hd1, hdb, -, hLb, -, -, -, -, -, hbig, -⟩ := params_ok hn
  have hd2 : dP n ^ 2 ≤ bP n :=
    le_trans (Nat.pow_le_pow_right hd1 (by norm_num : 2 ≤ 2 ^ 75)) (dP_spec_r6c n).1
  have hnb : n ≤ 2 ^ bP n :=
    le_trans (Nat.le_pow_clog (by norm_num) n) (Nat.pow_le_pow_right (by norm_num) (le_max_left _ _))
  have hel : ℓP n ≤ LP n := by
    obtain ⟨-, h2⟩ := ell_spec (LP n) (dP n) (by omega)
    unfold ℓP
    by_contra hc
    push Not at hc
    have : dP n * (LP n + 1) ≤ dP n * ell (LP n) (dP n) := Nat.mul_le_mul_left _ hc
    rw [Nat.mul_add, mul_one] at this
    have : LP n ≤ dP n * LP n := Nat.le_mul_of_pos_left _ hd1
    omega
  have hr : rP n ≤ 2 ^ bP n := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hF1 : 1 ≤ (256 * dP n ^ 2).factorial := Nat.one_le_iff_ne_zero.2 (Nat.factorial_ne_zero _)
  have h1d : 1 ≤ dP n ^ 2 := Nat.one_le_pow _ _ hd1
  have hr64 : 64 ≤ rP n := by nlinarith
  have hX : 12 * dP n ^ 2 * bP n ≤ 2 ^ bP n := by
    have := cube_lt_pow (bP n) (by omega)
    have : bP n ≤ bP n ^ 2 := by nlinarith
    nlinarith
  refine ⟨hb, hd1, hdb, hd2, hnb, hLb, hel, hbig, hr, hX, hr64, ?_⟩
  -- Q ≤ r + 2F
  unfold srcQ
  set F := (256 * dP n ^ 2).factorial
  set D := 256 * dP n ^ 2
  have hD1 : 1 ≤ D := by omega
  have h1 : 2 * F * (rP n / (2 * F * D)) ≤ rP n := by
    calc 2 * F * (rP n / (2 * F * D)) ≤ 2 * F * D * (rP n / (2 * F * D)) :=
          Nat.mul_le_mul_right _ (Nat.le_mul_of_pos_right _ hD1)
      _ ≤ rP n := Nat.mul_div_le _ _
  have h2 : 2 * F ≤ rP n := by nlinarith
  rw [Nat.mul_add, mul_one]; omega

end NLogN.KFM

end

