theorem germ_app_congr_aux {M X : Scheme} {F G : M ⟶ X} (e : F = G) (V : X.Opens) (ξ : M)
    (hF : ξ ∈ F ⁻¹ᵁ V) (hG : ξ ∈ G ⁻¹ᵁ V) (g : Γ(X, V)) :
    M.presheaf.germ (F ⁻¹ᵁ V) ξ hF ((F.app V).hom g) = M.presheaf.germ (G ⁻¹ᵁ V) ξ hG ((G.app V).hom g) := by
  subst e; rfl

theorem isUnit_germ_congr_aux {X : Scheme} (V : X.Opens) {x y : X} (e : x = y) (hx : x ∈ V) (hy : y ∈ V) (g : Γ(X, V)) :
    IsUnit (X.presheaf.germ V x hx g) → IsUnit (X.presheaf.germ V y hy g) := by
  subst e; exact id

