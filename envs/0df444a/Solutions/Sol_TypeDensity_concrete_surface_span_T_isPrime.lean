  have himg : (Ideal.span {TypeDensity.surfaceRelation O pi u a b, TypeDensity.axisT O}).map (TypeDensity.surfaceMk O pi u a b) =
      Ideal.span {TypeDensity.surfaceT O pi u a b} := by
    rw [Ideal.map_span, Set.image_pair, h0, Ideal.span_insert_zero]; rfl
  exact himg ▸ Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker
