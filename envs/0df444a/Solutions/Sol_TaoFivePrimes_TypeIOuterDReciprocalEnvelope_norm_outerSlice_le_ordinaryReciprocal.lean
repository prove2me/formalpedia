  unfold firstBoundaryVariation multiplierStepMass at *
  calc
    ‖h 0 * e 0‖ +
          (∑ j ∈ Finset.range N,
            ‖h (j + 1) * e (j + 1) - h j * e j‖) +
          ‖h N * e N‖
