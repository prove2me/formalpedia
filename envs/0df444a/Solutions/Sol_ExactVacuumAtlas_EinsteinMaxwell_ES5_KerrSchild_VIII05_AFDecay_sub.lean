theorem solution {Rh : ℝ} {u1 u2 : ℝ → ℝ} (h1 : ContDiffOn ℝ 1 u1 (Ioi Rh))
    (h2 : ContDiffOn ℝ 1 u2 (Ioi Rh)) (a1 : AFDecay Rh u1) (a2 : AFDecay Rh u2) :
    AFDecay Rh (fun s => u1 s - u2 s) := by
  obtain ⟨C1, hC1, Rs1, hRs1, hb1⟩ := a1
  obtain ⟨C2, hC2, Rs2, hRs2, hb2⟩ := a2
  refine ⟨C1 + C2, add_nonneg hC1 hC2, max Rs1 Rs2, lt_max_of_lt_left hRs1, fun R hR => ?_⟩
  have hR1 : R ≥ Rs1 := le_trans (le_max_left _ _) hR
  have hR2 : R ≥ Rs2 := le_trans (le_max_right _ _) hR
  have hRI : R ∈ Ioi Rh := lt_of_lt_of_le hRs1 hR1
  obtain ⟨x1, d1⟩ := hb1 R hR1
  obtain ⟨x2, d2⟩ := hb2 R hR2
  have hd : deriv (fun s => u1 s - u2 s) R = deriv u1 R - deriv u2 R :=
    deriv_sub ((h1.contDiffAt (isOpen_Ioi.mem_nhds hRI)).differentiableAt one_ne_zero)
      ((h2.contDiffAt (isOpen_Ioi.mem_nhds hRI)).differentiableAt one_ne_zero)
  constructor
  · calc |u1 R - u2 R| ≤ |u1 R| + |u2 R| := abs_sub _ _
      _ ≤ C1 / R + C2 / R := add_le_add x1 x2
      _ = (C1 + C2) / R := by ring
  · rw [hd]
    calc |deriv u1 R - deriv u2 R| ≤ |deriv u1 R| + |deriv u2 R| := abs_sub _ _
      _ ≤ C1 / R ^ 2 + C2 / R ^ 2 := add_le_add d1 d2
      _ = (C1 + C2) / R ^ 2 := by ring
