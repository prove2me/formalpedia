  obtain rfl := LanglandsTunnell.CubicInduction.RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hF : (primeFibre ℚ K v).Finite := LanglandsTunnell.CubicInduction.FibreDegree.primeFibre_finite K v
  have hz : ((localChar χ v (uniformizerUnit ℚ v) : ℂˣ) : ℂ) ≠ 0 := Units.ne_zero _
  have hR : ∀ 𝔓 ∈ primeFibre ℚ K v,
      stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓)
        = ((localChar χ v (uniformizerUnit ℚ v) : ℂˣ) : ℂ)
            ^ ((v.asIdeal.inertiaDeg' 𝔓.asIdeal : ℤ) * pinnedExp K μ 𝔓) * stdRootNumberAt K 𝔓 (localChar μ 𝔓) := by
    intro 𝔓 h𝔓
    have hw : 𝔓.under (𝓞 ℚ) = v := (mem_primeFibre ℚ v 𝔓).1 h𝔓
