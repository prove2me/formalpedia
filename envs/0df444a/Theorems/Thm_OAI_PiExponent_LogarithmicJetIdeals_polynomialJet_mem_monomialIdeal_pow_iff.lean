-- title:
--   Polynomial jets transport logarithmic ideal powers to monomial ideal powers
-- statement:
--   The triangular polynomial jet substitution carries membership in a power of the logarithmic coordinate ideal exactly to membership in the corresponding power of the monomial ideal generated by coordinate powers.
-- source:
--   https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Approximation/AdmissibleMatrixGeometry.lean#L41-L44

import Definitions.Def_OAI_PiExponent_PolynomialLogarithmicJets
import Mathlib.RingTheory.Ideal.Operations

open OAI.PiExponent.LogarithmicJetIdeals
open scoped BigOperators

theorem OAI.PiExponent.LogarithmicJetIdeals.polynomialJet_mem_monomialIdeal_pow_iff
    {m : ℕ} (c : Fin m → ℂ) (T : Fin m → ℕ)
    (e : Fin (m + 1) → ℕ) (he : ∀ i, 0 < e i)
    (k : ℕ) (P : MvPolynomial (Fin (m + 1)) ℂ) :
    P ∈ localJetIdeal c T e ^ k ↔
      polynomialJet c T P ∈
        Ideal.span (Set.range (fun i : Fin (m + 1) => MvPolynomial.X i ^ e i)) ^ k := by sorry
