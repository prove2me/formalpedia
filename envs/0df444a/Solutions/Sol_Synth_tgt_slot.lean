-- Source module: Solutions.SynthLayoutPaper
/-!
# §6.2 Lemma 16: the paper's layout `L`

Axes `i < D` have `a_i = ℓ` (long) or `ℓ - 1` (short) address bits; slot `h` of axis `i` is named
`nm i h = h·D + i`. With `b = (ℓ-1) mod K` and `q = ⌊(ℓ-1)/K⌋`:

* the **prefix list** `Lst`: the top slots `(i, ℓ-1)` of the long axes (increasing `i`), then
  `(i, h)` for `h = b-1, …, 0` and, within each `h`, increasing `i`;
* after the prefix moves every axis keeps the `qK` slots `h = ℓ-2, …, b` (`restA`), which are
  `q` consecutive `K`-bit chunks (`chunk i j`, numbered from the top);
* the target order `tgt = Lst ++ (chunks in chunk-major order)`.

`paper_layout`: `L` is reached by `|Lst| ≤ D(b+1)` single moves and at most `Dq - 1` chunk
exchanges, and its array denotation is the `pull` by `relabel init tgt`.
`tgt_slot`: in the target, slot `(i, h)` (`b ≤ h ≤ ℓ-2`) lies in chunk `i` of chunk group
`j = ⌊(qK-1-(h-b))/K⌋`, at offset `(h - b) mod K` from the least significant end — the common
offset used by the simultaneous layer (Proposition 14).
-/

set_option linter.unusedSectionVars false

namespace Synth

open AModel AModelL12

variable (D ℓ K : ℕ) (long : Fin D → Bool)

/-! ## 1. Names -/

/-! ## 2. Counting -/

lemma length_chunk (i : Fin D) {j : ℕ} (hj : j < qq ℓ K) : (chunk D ℓ K i j).length = K := by
  unfold chunk
  rw [List.length_take, List.length_drop, length_restA]
  have : j * K + K ≤ qq ℓ K * K := by nlinarith
  omega

/-! ## 3. Flattening uniform blocks -/

lemma getD_flatten_uniform {α : Type*} (d : α) {K : ℕ} :
    ∀ (L : List (List α)), (∀ c ∈ L, c.length = K) → ∀ u m, m < K →
      L.flatten.getD (u * K + m) d = (L.getD u []).getD m d
  | [], _, u, m, _ => by simp
  | c :: L, hL, u, m, hm => by
    have hc := hL c (by simp)
    rw [List.flatten_cons]
    rcases u with _ | u
    · simp only [zero_mul, zero_add, List.getD_cons_zero]
      rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by omega),
        ← List.getD_eq_getElem?_getD]
    · rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by rw [hc]; nlinarith),
        ← List.getD_eq_getElem?_getD, hc, show (u + 1) * K + m - K = u * K + m by
          rw [Nat.succ_mul]; omega, getD_flatten_uniform d L (fun c' h' => hL c' (by simp [h']))
          u m hm]
      simp

/-! ## 4. After the prefix moves -/

/-! ## 5. Nodup and the chunk permutation -/

/-! ## 6. Lemma 16, layout part -/

/-! ## 7. Round geometry -/

lemma getD_map_range {β : Type*} {d : β} (f : ℕ → β) {n u : ℕ} (hu : u < n) :
    ((List.range n).map f).getD u d = f u := by
  rw [List.getD_eq_getElem _ _ (by simp [hu])]; simp

lemma getD_map_finRange {β : Type*} {d : β} (g : Fin D → β) (i : Fin D) :
    ((List.finRange D).map g).getD i d = g i := by
  rw [List.getD_eq_getElem _ _ (by simp)]; simp

/-- **Common offset.** In the target order, slot `(i, h)` with `b ≤ h < b + qK` sits in the
`i`-th chunk of chunk group `j = ⌊(qK-1-(h-b))/K⌋`, at offset `ρ = (h-b) mod K` from the least
significant end of that chunk (position `K-1-ρ` inside it). -/
theorem tgt_slot_sol_aux (hK : 0 < K) (i : Fin D) {h : ℕ} (hb : bb ℓ K ≤ h) (hh : h < bb ℓ K + qq ℓ K * K) :
    let e := qq ℓ K * K - 1 - (h - bb ℓ K)
    (tgtL D ℓ K long).getD ((lstL D ℓ K long).length + ((e / K) * D + i) * K + (e % K)) 0 =
      nm D i h ∧ K - 1 - e % K = (h - bb ℓ K) % K := by
  intro e
  have he : e < qq ℓ K * K := by omega
  have hj : e / K < qq ℓ K := by rw [Nat.div_lt_iff_lt_mul hK]; exact he
  have hm : e % K < K := Nat.mod_lt _ hK
  constructor
  · unfold tgtL
    rw [getD_append_eq, if_neg (by omega), show (lstL D ℓ K long).length + (e / K * D + i) * K +
      e % K - (lstL D ℓ K long).length = (e / K * D + i) * K + e % K by omega]
    have hcm : ∀ c ∈ chunkMajor D ℓ K, c.length = K := fun c hc => by
      obtain ⟨i, j, hj, rfl⟩ := (mem_chunkMajor D ℓ K).1 hc; exact length_chunk D ℓ K i hj
    rw [getD_flatten_uniform 0 _ hcm _ _ hm]
    have hcol : chunkMajor D ℓ K = ((List.range (qq ℓ K)).map fun j =>
        (List.finRange D).map fun i => chunk D ℓ K i j).flatten := by
      unfold chunkMajor; rw [List.flatMap_def]
    rw [hcol, getD_flatten_uniform [] _ (fun c hc => by
      simp only [List.mem_map, List.mem_range] at hc
      obtain ⟨j, -, rfl⟩ := hc; simp) _ _ i.isLt]
    rw [getD_map_range _ hj, getD_map_finRange]
    unfold chunk
    rw [getD_take_eq _ _ _ hm, getD_drop_eq,
      List.getD_eq_getElem _ _ (by rw [length_restA]; have := Nat.div_add_mod e K; nlinarith)]
    unfold restA
    rw [List.getElem_map, List.getElem_reverse, List.getElem_range]
    simp only [List.length_range]
    congr 1
    have := Nat.div_add_mod' e K
    have he' : e = qq ℓ K * K - 1 - (h - bb ℓ K) := rfl
    clear_value e
    generalize e / K * K = P2 at *
    generalize qq ℓ K * K = QK at *
    omega
  · have h1 := Nat.div_add_mod' e K
    have he' : e = qq ℓ K * K - 1 - (h - bb ℓ K) := rfl
    clear_value e
    have key : h - bb ℓ K = (qq ℓ K - 1 - e / K) * K + (K - 1 - e % K) := by
      have hq : (qq ℓ K - 1 - e / K) * K + e / K * K + K = qq ℓ K * K := by
        have : qq ℓ K - 1 - e / K + e / K + 1 = qq ℓ K := by omega
        calc (qq ℓ K - 1 - e / K) * K + e / K * K + K =
            (qq ℓ K - 1 - e / K + e / K + 1) * K := by ring
          _ = qq ℓ K * K := by rw [this]
      generalize (qq ℓ K - 1 - e / K) * K = P1 at *
      generalize e / K * K = P2 at *
      generalize qq ℓ K * K = QK at *
      omega
    rw [key, show (qq ℓ K - 1 - e / K) * K + (K - 1 - e % K) =
      (K - 1 - e % K) + (qq ℓ K - 1 - e / K) * K by ring, Nat.add_mul_mod_self_right,
      Nat.mod_eq_of_lt (show K - 1 - e % K < K by omega)]

end Synth

end

theorem solution : type_of% @Synth.tgt_slot_sol_aux := @Synth.tgt_slot_sol_aux
