lemma eval_code (source target : ℕ) (s : Data) (hz : s.realReg 56 = 0) :
    ∃ cost, Eval (code source target) s cost (result source target s) ∧ cost ≤ 5 := by
  by_cases hn : s.realReg source < 0
  · have ht : (Test.realLess source 56).holds s := by simpa only [Test.holds,hz] using hn
    have hne : s.realReg source ≠ 0 := ne_of_lt hn
    refine ⟨2,?_,by omega⟩
    simpa only [code,result,nonzero,if_neg hne] using
      Eval.branchYes (no := Cmd.branch (.realLess 56 source) (natural target 1) (natural target 0)) ht (eval_natural s target 1)
  · have ht : ¬ (Test.realLess source 56).holds s := by simpa only [Test.holds,hz] using hn
    by_cases hp : 0 < s.realReg source
    · have ht' : (Test.realLess 56 source).holds s := by simpa only [Test.holds,hz] using hp
      have hne : s.realReg source ≠ 0 := ne_of_gt hp
      refine ⟨4,?_,by omega⟩
      simpa only [code,result,nonzero,if_neg hne] using Eval.branchNo (yes := natural target 1) ht
        (Eval.branchYes (no := natural target 0) ht' (eval_natural s target 1))
    · have ht' : ¬ (Test.realLess 56 source).holds s := by simpa only [Test.holds,hz] using hp
      have heq : s.realReg source = 0 := le_antisymm (le_of_not_gt hp) (le_of_not_gt hn)
      refine ⟨5,?_,le_rfl⟩
      simpa only [code,result,nonzero,if_pos heq] using Eval.branchNo (yes := natural target 1) ht
        (Eval.branchNo (yes := natural target 1) ht' (eval_natural s target 0))
