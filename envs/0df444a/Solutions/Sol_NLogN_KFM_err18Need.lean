  unfold nrotS NLogN.KFV.dbl
  rw [Nat.zero_mod, Nat.sub_zero, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega), dif_pos hq]

theorem nrotS_succ (s : ℕ) (v : Fin r → ℂ) : nrotS (s + 1) v = cyc (nrotS s v) := by
  funext q
  have hq := q.isLt
  have hr : 0 < 2 * r := by omega
  set m := s % (2 * r) with hm
  have hm2 : m < 2 * r := Nat.mod_lt _ hr
  have hs1 : (s + 1) % (2 * r) = if m + 1 < 2 * r then m + 1 else 0 := by
    have h1 : 1 % (2 * r) = 1 := Nat.mod_eq_of_lt (by omega)
    rw [Nat.add_mod, ← hm, h1]
    split_ifs with h
    · exact Nat.mod_eq_of_lt h
    · rw [show m + 1 = 2 * r by omega, Nat.mod_self]
  unfold nrotS cyc
  rw [hs1, ← hm]
  by_cases hq0 : (q : ℕ) = 0
  · rw [dif_pos hq0, hq0]
    simp only [zero_add]
    by_cases hm1 : m + 1 < 2 * r
    · rw [if_pos hm1, Nat.mod_eq_of_lt (show 2 * r - (m + 1) < 2 * r by omega)]
      by_cases hmr : m < r
      · have e2 : (r - 1 + 2 * r - m) % (2 * r) = r - 1 - m := by
          rw [show r - 1 + 2 * r - m = (r - 1 - m) + 2 * r by omega, Nat.add_mod_right,
            Nat.mod_eq_of_lt (by omega)]
        unfold NLogN.KFV.dbl
        rw [e2, dif_neg (by omega), dif_pos (by omega), dif_pos (by omega)]
        congr 2; ext; simp; omega
      · have e2 : (r - 1 + 2 * r - m) % (2 * r) = 3 * r - 1 - m := by
          rw [Nat.mod_eq_of_lt (by omega)]; omega
        unfold NLogN.KFV.dbl
        rw [e2, dif_pos (by omega), dif_neg (by omega), dif_pos (by omega), neg_neg]
        congr 1; ext; simp; omega
    · rw [if_neg hm1, Nat.sub_zero, Nat.mod_self]
      have e2 : (r - 1 + 2 * r - m) % (2 * r) = r := by
        rw [show r - 1 + 2 * r - m = r by omega, Nat.mod_eq_of_lt (by omega)]
      unfold NLogN.KFV.dbl
      rw [e2, dif_pos (by omega), dif_neg (by omega), dif_pos (by omega), neg_neg]
      congr 1; ext; simp
  · rw [dif_neg hq0]
    simp only
    by_cases hm1 : m + 1 < 2 * r
    · rw [if_pos hm1, show (q : ℕ) - 1 + 2 * r - m = q + 2 * r - (m + 1) by omega]
