  set cW := 2 * pl.kC + pl.wC + 1600 with hcW
  set Cs := 2 * (3 * aW + cW) + 2 * (3 * pl.kA + pl.kC) + 3654000 + 200 with hCs
  obtain ⟨n₅, hBud⟩ := budget_ev P hP (K * Cs ^ e) (7 * e)
