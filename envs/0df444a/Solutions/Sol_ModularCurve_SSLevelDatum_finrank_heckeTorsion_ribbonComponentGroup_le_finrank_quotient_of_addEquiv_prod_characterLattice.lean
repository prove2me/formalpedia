theorem δ_law (ℓ : Nat.Primes) (x : Q.L) : Q.δh (heckeGen ℓ • x) = heckeGen ℓ • Q.δh x := by
  rw [Q.L_heckeGen_smul, Q.Xp_heckeGen_smul]
  show Q.δ₀ (Q.tE ℓ x) = Q.tX ℓ (Q.δ₀ x)
  by_cases h : ℓ = Q.s
  · subst h
    rw [tX, if_pos rfl]
    apply Prod.ext
    · apply Subtype.ext
      show (degeneracyMatrix Q.D.a).mulVec ((Q.TE Q.s).mulVec x.1) =
        (Q.TV Q.s).mulVec ((degeneracyMatrix Q.D.a).mulVec x.1) - (degeneracyMatrix Q.D.b).mulVec x.1
      exact Q.c3_Ua x.1
    · apply Subtype.ext
      show (degeneracyMatrix Q.D.b).mulVec ((Q.TE Q.s).mulVec x.1) =
        ((Q.s : ℕ) : ℤ) • (degeneracyMatrix Q.D.a).mulVec x.1
      exact Q.c3_Ub x.1
  · rw [tX, if_neg h]
    apply Prod.ext
    · apply Subtype.ext
      show (degeneracyMatrix Q.D.a).mulVec ((Q.TE ℓ).mulVec x.1) = (Q.TV ℓ).mulVec ((degeneracyMatrix Q.D.a).mulVec x.1)
      have h0 := Q.eqv ℓ h 0 x.1
      simpa [jointDelta, pushforward] using h0
    · apply Subtype.ext
      show (degeneracyMatrix Q.D.b).mulVec ((Q.TE ℓ).mulVec x.1) = (Q.TV ℓ).mulVec ((degeneracyMatrix Q.D.b).mulVec x.1)
      have h1 := Q.eqv ℓ h 1 x.1
      simpa [jointDelta, pushforward] using h1
theorem ι_law (ℓ : Nat.Primes) (x : Q.Y) : Q.ιh (heckeGen ℓ • x) = heckeGen ℓ • Q.ιh x := by
  rw [Q.Y_heckeGen_smul, Q.L_heckeGen_smul]
  apply Subtype.ext
  rfl

theorem adjoint_unique {ι : Type} [Fintype ι] [DecidableEq ι] (w : ι → ℕ) (hw : ∀ i, 0 < w i) (g g' : ι → ℤ)
    (h : ∀ x : ι → ℤ, widthPairing w x g = widthPairing w x g') : g = g' := by
  funext i
  have hi := h (Pi.single i 1)
  simp only [widthPairing_apply, Pi.single_apply, ite_mul, one_mul, zero_mul, mul_ite, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, if_true] at hi
  have hw' : (w i : ℤ) ≠ 0 := by exact_mod_cast (hw i).ne'
  exact mul_left_cancel₀ hw' hi

theorem TE_padj_comm_aux (ℓ : Nat.Primes) (f : E → V) (p : (V → ℤ) →ₗ[ℤ] (E → ℤ))
    (hadjf : ∀ (x : V → ℤ) (z : E → ℤ),
      widthPairing (fun e => (Q.D.w e : ℕ)) z (p x) = widthPairing Q.wV ((degeneracyMatrix f).mulVec z) x)
    (heqv : ∀ z : E → ℤ,
      (degeneracyMatrix f).mulVec ((Q.adjE ℓ).mulVec z) = (Q.adjV ℓ).mulVec ((degeneracyMatrix f).mulVec z))
    (v : V → ℤ) : (Q.TE ℓ).mulVec (p v) = p ((Q.TV ℓ).mulVec v) := by
  apply adjoint_unique (fun e => (Q.D.w e : ℕ)) (fun e => (Q.D.w e).pos)
  intro y
  calc widthPairing (fun e => (Q.D.w e : ℕ)) y ((Q.TE ℓ).mulVec (p v))
        = widthPairing (fun e => (Q.D.w e : ℕ)) ((Q.adjE ℓ).mulVec y) (p v) := by
          rw [widthPairing_comm, Q.adjE_law, widthPairing_comm]
    _ = widthPairing Q.wV ((degeneracyMatrix f).mulVec ((Q.adjE ℓ).mulVec y)) v := hadjf v _
    _ = widthPairing Q.wV ((Q.adjV ℓ).mulVec ((degeneracyMatrix f).mulVec y)) v := by rw [heqv]
    _ = widthPairing Q.wV ((degeneracyMatrix f).mulVec y) ((Q.TV ℓ).mulVec v) := by
          rw [widthPairing_comm, ← Q.adjV_law, widthPairing_comm]
    _ = widthPairing (fun e => (Q.D.w e : ℕ)) y (p ((Q.TV ℓ).mulVec v)) := (hadjf _ y).symm

theorem hadj_pairing (i : Fin 2) (x : V → ℤ) (z : E → ℤ) :
    widthPairing (fun e => (Q.D.w e : ℕ)) z (Q.padj i x) =
      widthPairing Q.wV ((degeneracyMatrix (![Q.D.a, Q.D.b] i)).mulVec z) x := by
  rw [widthPairing_apply, widthPairing_apply]
  have h := Q.hadj i x z
  rw [show (∑ e, ((Q.D.w e : ℕ) : ℤ) * (z e * Q.padj i x e)) = ∑ e, (Q.D.w e : ℤ) * z e * Q.padj i x e from
    Finset.sum_congr rfl fun e _ => by push_cast; ring]
  rw [← h]
  exact Finset.sum_congr rfl fun v _ => by ring

theorem TE_padj_comm (ℓ : Nat.Primes) (hℓ : ℓ ≠ Q.s) (i : Fin 2) (v : V → ℤ) :
    (Q.TE ℓ).mulVec (Q.padj i v) = Q.padj i ((Q.TV ℓ).mulVec v) := by
  fin_cases i
  · refine Q.TE_padj_comm_aux ℓ Q.D.a (Q.padj 0) (fun x z => by simpa using Q.hadj_pairing 0 x z) (fun z => ?_) v
    simpa [jointDelta, pushforward] using Q.eqvAdj ℓ hℓ 0 z
  · refine Q.TE_padj_comm_aux ℓ Q.D.b (Q.padj 1) (fun x z => by simpa using Q.hadj_pairing 1 x z) (fun z => ?_) v
    simpa [jointDelta, pushforward] using Q.eqvAdj ℓ hℓ 1 z

theorem σ_law_off (ℓ : Nat.Primes) (hℓ : ℓ ≠ Q.s) (x : Q.Xp) : Q.σh (heckeGen ℓ • x) = heckeGen ℓ • Q.σh x := by
  rw [Q.Xp_heckeGen_smul, Q.L_heckeGen_smul]
  show Q.σ₀ (Q.tX ℓ x) = Q.tE ℓ (Q.σ₀ x)
  rw [tX, if_neg hℓ]
  apply Subtype.ext
  set x₁ : V → ℤ := ((x.1 : ↥(characterLattice V)) : V → ℤ) with hx₁
  set x₂ : V → ℤ := ((x.2 : ↥(characterLattice V)) : V → ℤ) with hx₂
  show Q.padj 0 (-((Q.TV ℓ).mulVec x₁)) + Q.padj 1 ((Q.TV Q.s).mulVec ((Q.TV ℓ).mulVec x₁) - (Q.TV ℓ).mulVec x₂) =
    (Q.TE ℓ).mulVec (Q.padj 0 (-x₁) + Q.padj 1 ((Q.TV Q.s).mulVec x₁ - x₂))
  rw [Matrix.mulVec_add, Q.TE_padj_comm ℓ hℓ 0, Q.TE_padj_comm ℓ hℓ 1, Matrix.mulVec_neg, Matrix.mulVec_sub,
    Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, (Q.commV Q.s ℓ).eq]

theorem hadj0 (x : V → ℤ) (z : E → ℤ) :
    widthPairing (fun e => (Q.D.w e : ℕ)) z (Q.padj 0 x) = widthPairing Q.wV ((degeneracyMatrix Q.D.a).mulVec z) x := by
  simpa using Q.hadj_pairing 0 x z
theorem hadj1 (x : V → ℤ) (z : E → ℤ) :
    widthPairing (fun e => (Q.D.w e : ℕ)) z (Q.padj 1 x) = widthPairing Q.wV ((degeneracyMatrix Q.D.b).mulVec z) x := by
  simpa using Q.hadj_pairing 1 x z

theorem adjU_padj0 (v : V → ℤ) :
    (Q.adjE Q.s).mulVec (Q.padj 0 v) = Q.padj 0 ((Q.TV Q.s).mulVec v) - Q.padj 1 v := by
  apply adjoint_unique (fun e => (Q.D.w e : ℕ)) (fun e => (Q.D.w e).pos)
  intro y
  calc widthPairing (fun e => (Q.D.w e : ℕ)) y ((Q.adjE Q.s).mulVec (Q.padj 0 v))
        = widthPairing (fun e => (Q.D.w e : ℕ)) ((Q.TE Q.s).mulVec y) (Q.padj 0 v) := (Q.adjE_law Q.s y _).symm
    _ = widthPairing Q.wV ((degeneracyMatrix Q.D.a).mulVec ((Q.TE Q.s).mulVec y)) v := Q.hadj0 v _
    _ = widthPairing Q.wV ((Q.TV Q.s).mulVec ((degeneracyMatrix Q.D.a).mulVec y) - (degeneracyMatrix Q.D.b).mulVec y) v := by
          rw [Q.c3_Ua]
    _ = widthPairing Q.wV ((Q.TV Q.s).mulVec ((degeneracyMatrix Q.D.a).mulVec y)) v -
          widthPairing Q.wV ((degeneracyMatrix Q.D.b).mulVec y) v := by rw [LinearMap.map_sub₂]
    _ = widthPairing Q.wV ((degeneracyMatrix Q.D.a).mulVec y) ((Q.TV Q.s).mulVec v) -
          widthPairing Q.wV ((degeneracyMatrix Q.D.b).mulVec y) v := by rw [Q.adjV_law, Q.adjV_s]
    _ = widthPairing (fun e => (Q.D.w e : ℕ)) y (Q.padj 0 ((Q.TV Q.s).mulVec v)) -
          widthPairing (fun e => (Q.D.w e : ℕ)) y (Q.padj 1 v) := by rw [Q.hadj0, Q.hadj1]
    _ = widthPairing (fun e => (Q.D.w e : ℕ)) y (Q.padj 0 ((Q.TV Q.s).mulVec v) - Q.padj 1 v) := by rw [map_sub]

theorem adjU_padj1 (v : V → ℤ) :
    (Q.adjE Q.s).mulVec (Q.padj 1 v) = ((Q.s : ℕ) : ℤ) • Q.padj 0 v := by
  apply adjoint_unique (fun e => (Q.D.w e : ℕ)) (fun e => (Q.D.w e).pos)
  intro y
  calc widthPairing (fun e => (Q.D.w e : ℕ)) y ((Q.adjE Q.s).mulVec (Q.padj 1 v))
        = widthPairing (fun e => (Q.D.w e : ℕ)) ((Q.TE Q.s).mulVec y) (Q.padj 1 v) := (Q.adjE_law Q.s y _).symm
    _ = widthPairing Q.wV ((degeneracyMatrix Q.D.b).mulVec ((Q.TE Q.s).mulVec y)) v := Q.hadj1 v _
    _ = widthPairing Q.wV (((Q.s : ℕ) : ℤ) • (degeneracyMatrix Q.D.a).mulVec y) v := by rw [Q.c3_Ub]
    _ = ((Q.s : ℕ) : ℤ) * widthPairing Q.wV ((degeneracyMatrix Q.D.a).mulVec y) v := by
          rw [LinearMap.map_smul₂, smul_eq_mul]
    _ = ((Q.s : ℕ) : ℤ) * widthPairing (fun e => (Q.D.w e : ℕ)) y (Q.padj 0 v) := by rw [Q.hadj0]
    _ = widthPairing (fun e => (Q.D.w e : ℕ)) y (((Q.s : ℕ) : ℤ) • Q.padj 0 v) := by rw [map_smul, smul_eq_mul]

theorem U_apply_eq (z : E → ℤ) (e : E) :
    (Q.TE Q.s).mulVec z e = (Q.adjE Q.s).mulVec (z ∘ Q.π) (Q.π e) := by
  simp only [Matrix.mulVec, dotProduct, Function.comp, Q.adjE_s, Q.c3bis_inv]
  exact (Equiv.sum_comp Q.π (fun k => Q.TE Q.s e k * z k)).symm

theorem padj0_comp_π (v : V → ℤ) : Q.padj 0 v ∘ Q.π = Q.padj 1 v := by
  funext e; exact (Q.padj_π v e).symm
theorem padj1_comp_π (v : V → ℤ) : Q.padj 1 v ∘ Q.π = Q.padj 0 v := by
  funext e
  show Q.padj 1 v (Q.π e) = Q.padj 0 v e
  rw [Q.padj_π, Q.c3bis_inv]

theorem U_padj0 (v : V → ℤ) : (Q.TE Q.s).mulVec (Q.padj 0 v) = ((Q.s : ℕ) : ℤ) • Q.padj 1 v := by
  funext e
  rw [U_apply_eq, padj0_comp_π, adjU_padj1, Pi.smul_apply, Pi.smul_apply, ← Q.padj_π]

theorem U_padj1 (v : V → ℤ) :
    (Q.TE Q.s).mulVec (Q.padj 1 v) = Q.padj 1 ((Q.TV Q.s).mulVec v) - Q.padj 0 v := by
  funext e
  rw [U_apply_eq, padj1_comp_π, adjU_padj0, Pi.sub_apply, Pi.sub_apply, ← Q.padj_π, Q.padj_π v, Q.c3bis_inv]

theorem σ_law_s (x : Q.Xp) : Q.σh (heckeGen Q.s • x) = heckeGen Q.s • Q.σh x := by
  rw [Q.Xp_heckeGen_smul, Q.L_heckeGen_smul, famX_T_s]
  show Q.σ₀ (Q.compS x) = Q.tE Q.s (Q.σ₀ x)
  apply Subtype.ext
  set x₁ : V → ℤ := ((x.1 : ↥(characterLattice V)) : V → ℤ) with hx₁
  set x₂ : V → ℤ := ((x.2 : ↥(characterLattice V)) : V → ℤ) with hx₂
  show Q.padj 0 (-((Q.TV Q.s).mulVec x₁ - x₂)) +
      Q.padj 1 ((Q.TV Q.s).mulVec ((Q.TV Q.s).mulVec x₁ - x₂) - ((Q.s : ℕ) : ℤ) • x₁) =
    (Q.TE Q.s).mulVec (Q.padj 0 (-x₁) + Q.padj 1 ((Q.TV Q.s).mulVec x₁ - x₂))
  rw [Matrix.mulVec_add, U_padj0, U_padj1]
  simp only [map_neg, map_sub, map_smul, smul_neg, smul_sub]
  abel

theorem σ_law (ℓ : Nat.Primes) (x : Q.Xp) : Q.σh (heckeGen ℓ • x) = heckeGen ℓ • Q.σh x := by
  by_cases h : ℓ = Q.s
  · subst h
    exact Q.σ_law_s x
  · exact Q.σ_law_off ℓ h x
theorem gL_law (ℓ : Nat.Primes) (x : Q.L) : Q.gLh (heckeGen ℓ • x) = heckeGen ℓ • Q.gLh x := by
  rw [Q.L_heckeGen_smul, Q.Ld_heckeGen_smul]
  refine LinearMap.ext fun y => ?_
  show widthPairing (fun e => (Q.D.w e : ℕ)) ((Q.TE ℓ).mulVec x.1) y.1 =
    widthPairing (fun e => (Q.D.w e : ℕ)) x.1 ((Q.adjE ℓ).mulVec y.1)
  exact Q.adjE_law ℓ _ _
theorem gX₀_apply (p q : ↥(characterLattice V) × ↥(characterLattice V)) :
    Q.gX₀ p q = widthPairing Q.wV p.1.1 q.1.1 + widthPairing Q.wV p.2.1 q.2.1 := rfl

theorem gX_law (ℓ : Nat.Primes) (x : Q.Xp) : Q.gXh (heckeGen ℓ • x) = heckeGen ℓ • Q.gXh x := by
  rw [Q.Xp_heckeGen_smul, Q.Xd_heckeGen_smul]
  refine LinearMap.ext fun y => ?_
  show Q.gX₀ (Q.tX ℓ x) y = Q.gX₀ x (Q.tXadj ℓ y)
  rw [gX₀_apply, gX₀_apply]
  by_cases h : ℓ = Q.s
  · subst h
    rw [tX, tXadj, if_pos rfl, if_pos rfl]
    show widthPairing Q.wV ((Q.TV Q.s).mulVec x.1.1 - x.2.1) y.1.1 + widthPairing Q.wV (((Q.s : ℕ) : ℤ) • x.1.1) y.2.1 =
      widthPairing Q.wV x.1.1 ((Q.adjV Q.s).mulVec y.1.1 + ((Q.s : ℕ) : ℤ) • y.2.1) + widthPairing Q.wV x.2.1 (-y.1.1)
    rw [LinearMap.map_sub₂, LinearMap.map_smul₂, map_add, map_smul, map_neg, Q.adjV_law]
    simp only [smul_eq_mul]
    ring
  · rw [tX, tXadj, if_neg h, if_neg h]
    show widthPairing Q.wV ((Q.TV ℓ).mulVec x.1.1) y.1.1 + widthPairing Q.wV ((Q.TV ℓ).mulVec x.2.1) y.2.1 =
      widthPairing Q.wV x.1.1 ((Q.adjV ℓ).mulVec y.1.1) + widthPairing Q.wV x.2.1 ((Q.adjV ℓ).mulVec y.2.1)
    rw [Q.adjV_law, Q.adjV_law]
theorem gY_law (ℓ : Nat.Primes) (x : Q.Y) : Q.gYh (heckeGen ℓ • x) = heckeGen ℓ • Q.gYh x := by
  rw [Q.Y_heckeGen_smul, Q.Yd_heckeGen_smul]
  refine LinearMap.ext fun y => ?_
  show widthPairing (fun e => (Q.D.w e : ℕ)) ((Q.TE ℓ).mulVec x.1) y.1 =
    widthPairing (fun e => (Q.D.w e : ℕ)) x.1 ((Q.adjE ℓ).mulVec y.1)
  exact Q.adjE_law ℓ _ _
theorem ρd_law (ℓ : Nat.Primes) (x : Q.Ld) : Q.ρdh (heckeGen ℓ • x) = heckeGen ℓ • Q.ρdh x := by
  rw [Q.Ld_heckeGen_smul, Q.Yd_heckeGen_smul]
  refine LinearMap.ext fun y => ?_
  show (id x : Module.Dual ℤ ↥(characterLattice E)) (Q.tEadj ℓ (Q.ι₀ y)) =
    (id x : Module.Dual ℤ ↥(characterLattice E)) (Q.ι₀ (Q.tYadj ℓ y))
  congr 1

theorem Aa_adjU (z : E → ℤ) :
    (degeneracyMatrix Q.D.a).mulVec ((Q.adjE Q.s).mulVec z) = ((Q.s : ℕ) : ℤ) • (degeneracyMatrix Q.D.b).mulVec z := by
  apply adjoint_unique Q.wV Q.wV_pos
  intro x
  calc widthPairing Q.wV x ((degeneracyMatrix Q.D.a).mulVec ((Q.adjE Q.s).mulVec z))
        = widthPairing (fun e => (Q.D.w e : ℕ)) ((Q.adjE Q.s).mulVec z) (Q.padj 0 x) := by
          rw [widthPairing_comm, ← Q.hadj0]
    _ = widthPairing (fun e => (Q.D.w e : ℕ)) ((Q.TE Q.s).mulVec (Q.padj 0 x)) z := by
          rw [widthPairing_comm, ← Q.adjE_law]
    _ = ((Q.s : ℕ) : ℤ) * widthPairing (fun e => (Q.D.w e : ℕ)) z (Q.padj 1 x) := by
          rw [U_padj0, LinearMap.map_smul₂, smul_eq_mul, widthPairing_comm]
    _ = ((Q.s : ℕ) : ℤ) * widthPairing Q.wV ((degeneracyMatrix Q.D.b).mulVec z) x := by rw [Q.hadj1]
    _ = widthPairing Q.wV x (((Q.s : ℕ) : ℤ) • (degeneracyMatrix Q.D.b).mulVec z) := by
          rw [map_smul, smul_eq_mul, widthPairing_comm]

theorem Ab_adjU (z : E → ℤ) :
    (degeneracyMatrix Q.D.b).mulVec ((Q.adjE Q.s).mulVec z) =
      (Q.TV Q.s).mulVec ((degeneracyMatrix Q.D.b).mulVec z) - (degeneracyMatrix Q.D.a).mulVec z := by
  apply adjoint_unique Q.wV Q.wV_pos
  intro x
  calc widthPairing Q.wV x ((degeneracyMatrix Q.D.b).mulVec ((Q.adjE Q.s).mulVec z))
        = widthPairing (fun e => (Q.D.w e : ℕ)) ((Q.adjE Q.s).mulVec z) (Q.padj 1 x) := by
          rw [widthPairing_comm, ← Q.hadj1]
    _ = widthPairing (fun e => (Q.D.w e : ℕ)) ((Q.TE Q.s).mulVec (Q.padj 1 x)) z := by
          rw [widthPairing_comm, ← Q.adjE_law]
    _ = widthPairing (fun e => (Q.D.w e : ℕ)) z (Q.padj 1 ((Q.TV Q.s).mulVec x)) -
          widthPairing (fun e => (Q.D.w e : ℕ)) z (Q.padj 0 x) := by
          rw [U_padj1, LinearMap.map_sub₂, widthPairing_comm _ _ z, widthPairing_comm _ (Q.padj 0 x) z]
    _ = widthPairing Q.wV ((degeneracyMatrix Q.D.b).mulVec z) ((Q.TV Q.s).mulVec x) -
          widthPairing Q.wV ((degeneracyMatrix Q.D.a).mulVec z) x := by rw [Q.hadj1, Q.hadj0]
    _ = widthPairing Q.wV x ((Q.TV Q.s).mulVec ((degeneracyMatrix Q.D.b).mulVec z)) -
          widthPairing Q.wV x ((degeneracyMatrix Q.D.a).mulVec z) := by
          rw [widthPairing_comm Q.wV _ ((Q.TV Q.s).mulVec x), Q.adjV_law, Q.adjV_s,
            widthPairing_comm Q.wV ((degeneracyMatrix Q.D.a).mulVec z) x]
    _ = widthPairing Q.wV x ((Q.TV Q.s).mulVec ((degeneracyMatrix Q.D.b).mulVec z) - (degeneracyMatrix Q.D.a).mulVec z) := by
          rw [map_sub]

theorem αδ_adj_comm (ℓ : Nat.Primes) (y : ↥(characterLattice E)) :
    Q.tXadj ℓ (Q.αadj (Q.δ₀ y)) = Q.αadj (Q.δ₀ (Q.tEadj ℓ y)) := by
  by_cases h : ℓ = Q.s
  · subst h
    rw [tXadj, if_pos rfl]
    apply Prod.ext
    · apply Subtype.ext
      show (Q.adjV Q.s).mulVec (-((degeneracyMatrix Q.D.a).mulVec y.1) + (Q.adjV Q.s).mulVec ((degeneracyMatrix Q.D.b).mulVec y.1)) +
          ((Q.s : ℕ) : ℤ) • (-((degeneracyMatrix Q.D.b).mulVec y.1)) =
        -((degeneracyMatrix Q.D.a).mulVec ((Q.adjE Q.s).mulVec y.1)) +
          (Q.adjV Q.s).mulVec ((degeneracyMatrix Q.D.b).mulVec ((Q.adjE Q.s).mulVec y.1))
      rw [Aa_adjU, Ab_adjU, Q.adjV_s, Matrix.mulVec_add, Matrix.mulVec_neg, Matrix.mulVec_sub, smul_neg]
      abel
    · apply Subtype.ext
      show -(-((degeneracyMatrix Q.D.a).mulVec y.1) + (Q.adjV Q.s).mulVec ((degeneracyMatrix Q.D.b).mulVec y.1)) =
        -((degeneracyMatrix Q.D.b).mulVec ((Q.adjE Q.s).mulVec y.1))
      rw [Ab_adjU, Q.adjV_s]
      abel
  · rw [tXadj, if_neg h]
    have ha : (degeneracyMatrix Q.D.a).mulVec ((Q.adjE ℓ).mulVec y.1) = (Q.adjV ℓ).mulVec ((degeneracyMatrix Q.D.a).mulVec y.1) := by
      simpa [jointDelta, pushforward] using Q.eqvAdj ℓ h 0 y.1
    have hb : (degeneracyMatrix Q.D.b).mulVec ((Q.adjE ℓ).mulVec y.1) = (Q.adjV ℓ).mulVec ((degeneracyMatrix Q.D.b).mulVec y.1) := by
      simpa [jointDelta, pushforward] using Q.eqvAdj ℓ h 1 y.1
    apply Prod.ext
    · apply Subtype.ext
      show (Q.adjV ℓ).mulVec (-((degeneracyMatrix Q.D.a).mulVec y.1) + (Q.adjV Q.s).mulVec ((degeneracyMatrix Q.D.b).mulVec y.1)) =
        -((degeneracyMatrix Q.D.a).mulVec ((Q.adjE ℓ).mulVec y.1)) +
          (Q.adjV Q.s).mulVec ((degeneracyMatrix Q.D.b).mulVec ((Q.adjE ℓ).mulVec y.1))
      rw [ha, hb]
      simp only [Matrix.mulVec_add, Matrix.mulVec_neg, Matrix.mulVec_mulVec, ← Matrix.mul_assoc, (Q.commAdjV ℓ Q.s).eq]
    · apply Subtype.ext
      show (Q.adjV ℓ).mulVec (-((degeneracyMatrix Q.D.b).mulVec y.1)) = -((degeneracyMatrix Q.D.b).mulVec ((Q.adjE ℓ).mulVec y.1))
      rw [hb, Matrix.mulVec_neg]

theorem κd_law (ℓ : Nat.Primes) (x : Q.Xd) : Q.κdh (heckeGen ℓ • x) = heckeGen ℓ • Q.κdh x := by
  rw [Q.Xd_heckeGen_smul, Q.Ld_heckeGen_smul]
  refine LinearMap.ext fun y => ?_
  show (id x : Module.Dual ℤ (↥(characterLattice V) × ↥(characterLattice V))) (Q.tXadj ℓ (Q.αadj (Q.δ₀ y))) =
    (id x : Module.Dual ℤ (↥(characterLattice V) × ↥(characterLattice V))) (Q.αadj (Q.δ₀ (Q.tEadj ℓ y)))
  rw [αδ_adj_comm]

noncomputable def δ : Q.L →ₗ[HeckeAlg] Q.Xp := mkHeckeLinear Q.δh Q.δ_law
