-- title:
--   Repair, refresh, deletion and historical array readout semantics
-- statement:
--   A state stores active original identifiers, implicit potentials, exact cached capacities, detector baselines, explicit cached vertex gradients and their nonzero count, the last return-refresh samples, the output array, pending reports and the control-flow stop flag. Labels are $p_v=p_v^0+y_v-y_s$.
--
--   Refresh recomputes the single edge capacity, replaces its detector baseline, changes the two endpoint gradients by $(-\Delta f,+\Delta f)$ and removes only that edge's pending duplicates. For a return edge, it also samples the current label and overwrites that vertex's output. Repair drains reports first, stops on zero cached gradient or on $G/U\ge-1/(4K)$, and otherwise toggles the returned cut with
--
--   $$\tau=\frac{1}{K^2U},\qquad \xi=K^{-2}.$$
--
--   A deletion changes its retained core cost to $H/Q$, refreshes it and restarts Repair. Initialization sets all caches, gradients and outputs before its first repair. The state is stable precisely when this control flow returns. Attained states are generated by these operations from initialization, with no accuracy or balance assumption. A ghost counter records the number of executed toggles. A ghost operation history permits the cut selector to represent a dynamic implementation whose private state depends on past operations, without requiring a memoryless rule. Initialization passes the explicit capacity bound $\kappa^{-2}$ and detector threshold $K^{-2}$ to the interface. Neither ghost is a correctness certificate or a unit-cost evaluation instruction.
--
--   This makes the historical sample $\bar p_v$ execution-derived. **Formalization Note** A deterministic cut-response selector has a quality property only on attained report-drained states. Analytic milestones assume the supplied interface guarantee, exactly as the paper does; the implementation's existence and charged costs remain conclusions of Lemma 3.2 and the main runtime theorems. Set descriptions of implicit labels and reports are denotational specifications, never unit-cost machine instructions.
-- source:
--   Bin Cui, Hanqing Li, Xupeng Miao, Haoze Wang, STOC 2027 submission #912 (October 2026), pp. 9–11, §3.2.2, Initialize, Repair, Refresh, Update and Query; p. 16, §3.4.4; pinned PDF: https://github.com/sigact-stoc/stoc2027/releases/download/papers-2/912.pdf

import Mathlib
import Definitions.Def_DecrAlmostLinearSSSP_Decremental_CutProtocol

set_option autoImplicit false
open scoped ENNReal NNReal

namespace DecrAlmostLinearSSSP.Decremental

/-- A tuple returned by the dynamic cut implementation. Quality is a theorem/property of
an implementation, never a field of this tuple. -/
structure CutReply (b : Core) where
  G : ℝ
  U : ℝ
  cut : Finset (Fin b.input.n)


/-- A ghost history permits the deterministic dynamic cut structure to depend on its
past operations and private representation, rather than imposing a memoryless selector. -/
inductive Event (b : Core)
  | refresh (e : Edge b)
  | toggle (reply : CutReply b)
  | deletion (e : Fin b.input.k)
  | stop

/-- Mathematical state represented implicitly by the cut data structure and explicitly by
caches and the output array. It has no accuracy, termination or complexity fields. -/
structure State (b : Core) where
  active : Finset (Fin b.input.k)
  y : Fin b.input.n → ℝ
  cache : Edge b → ℝ
  baseline : Edge b → ℝ
  cachedGradient : Fin b.input.n → ℝ
  nonzeroEntries : ℕ
  sample : Fin b.input.n → ℝ
  output : Fin b.input.n → ℝ≥0∞
  pending : List (Edge b)
  stopped : Bool
  toggles : ℕ
  history : List (Event b)

noncomputable def labels (b : Core) (s : State b) (v : Fin b.input.n) : ℝ :=
  initialLabel b v + s.y v - s.y b.input.source

noncomputable def cachedPhysical (b : Core) (s : State b) : Physical b.input.n (Fintype.card (Edge b)) :=
  let equiv := Fintype.equivFin (Edge b)
  { graph := ⟨fun e => tail b (equiv.symm e), fun e => head b (equiv.symm e)⟩
    active := Finset.univ
    u := fun e => s.cache (equiv.symm e)
    gamma := s.cachedGradient }

noncomputable def freshReply (b : Core) (s : State b) (choose : State b → CutReply b) : CutReply b := choose s

noncomputable def nonzero (x : ℝ) : ℕ := if x = 0 then 0 else 1

/-- Refresh changes one cached coefficient and precisely its two incident gradient entries.
The current labels and all unrelated pending identifiers are preserved. -/
noncomputable def refresh (b : Core) (s : State b) (e : Edge b) : State b := by
  classical
  let p := labels b s
  let f := capacity b s.active p e
  let delta := f - s.cache e
  let a := tail b e
  let z := head b e
  let g : Fin b.input.n → ℝ := fun v => s.cachedGradient v - (if v = a then delta else 0) +
    (if v = z then delta else 0)
  let count := if a = z then s.nonzeroEntries else
    s.nonzeroEntries + nonzero (g a) + nonzero (g z) - nonzero (s.cachedGradient a) -
      nonzero (s.cachedGradient z)
  exact { s with
    cache := Function.update s.cache e f
    baseline := Function.update s.baseline e (s.y a - s.y z)
    cachedGradient := g
    nonzeroEntries := count
    sample := match e with | .inl _ => s.sample | .inr v => Function.update s.sample v.val (p v.val)
    output := match e with | .inl _ => s.output | .inr v => Function.update s.output v.val (readout b (p v.val))
    pending := s.pending.filter (fun a => a ≠ e)
    history := s.history ++ [.refresh e] }

noncomputable def initializeState (b : Core) : State b :=
  let f := capacity b Finset.univ (initialLabel b)
  let g := gradient b f
  { active := Finset.univ
    y := 0
    cache := f
    baseline := 0
    cachedGradient := g
    nonzeroEntries := ∑ v, nonzero (g v)
    sample := initialLabel b
    output := fun v => if v = b.input.source then 0 else readout b (initialLabel b v)
    pending := []
    stopped := false
    toggles := 0
    history := [] }


/-- The actual interface initialization request uses the paper's explicit detector threshold
and capacity bound. Logical core plus return identifiers fit the size bound 2m. -/
noncomputable def initializeCutMachine (b : Core) (K : ℝ) (p : Program) : Machine :=
  cutInitial p (cachedPhysical b (initializeState b)) (2 * b.input.size)
    (K ^ (-2 : ℤ)) (kappa b ^ (-2 : ℤ))

/-- Failed stopping test: shift the most recently returned cut by exactly 1/(K² U).
The finite predicate describes the detector's report set; it is not a unit-cost scanning
instruction. Machine realizations must implement this set and pay all emitted reports. -/
noncomputable def toggle (b : Core) (K : ℝ) (s : State b) (r : CutReply b) : State b := by
  classical
  let tau := 1 / (K ^ 2 * r.U)
  let y : Fin b.input.n → ℝ := fun v => s.y v + if v ∈ r.cut then tau else 0
  let reports := Finset.univ.toList.filter fun e : Edge b =>
    K ^ (-2 : ℤ) ≤ |s.cache e * (y (tail b e) - y (head b e) - s.baseline e)|
  exact {s with y := y, pending := reports, toggles := s.toggles + 1, history := s.history ++ [.toggle r]}

/-- Repair is a deterministic small-step control flow. It may run forever; termination
is a conclusion of the theorems, rather than fuel truncation or an input field. -/
noncomputable def repairStep (b : Core) (K : ℝ) (choose : State b → CutReply b) (s : State b) : State b := by
  classical
  exact if s.stopped then s else match s.pending with
    | e :: _ => refresh b s e
    | [] => if s.nonzeroEntries = 0 then {s with stopped := true, history := s.history ++ [.stop]} else
      let r := freshReply b s choose
      if r.G / r.U ≥ -1 / (4 * K) then {s with stopped := true, history := s.history ++ [.stop]} else toggle b K s r

noncomputable def repairPrefix (b : Core) (K : ℝ) (choose : State b → CutReply b)
    (s : State b) (t : ℕ) : State b := (repairStep b K choose)^[t] s

/-- External deletion keeps labels fixed, changes only the normalized core cost, refreshes
that edge and starts repair. It is legal only at a stopped state with the edge active. -/
noncomputable def deleteState (b : Core) (s : State b) (e : Fin b.input.k) : State b :=
  refresh b {s with active := s.active.erase e, stopped := false, history := s.history ++ [.deletion e]} (.inl e)

/-- Actual algorithm prefixes, including intermediate repair and forced refresh states.
No detector accuracy, balance, or target-accuracy predicate is a constructor argument. -/
inductive Attained (b : Core) (K : ℝ) (choose : State b → CutReply b) : State b → Prop
  | start : Attained b K choose (initializeState b)
  | repair {s : State b} (h : Attained b K choose s) :
      Attained b K choose (repairStep b K choose s)
  | deletion {s : State b} (h : Attained b K choose s) (hs : s.stopped = true)
      (e : Fin b.input.k) (he : e ∈ s.active) : Attained b K choose (deleteState b s e)

def CutQuality (b : Core) (K : ℝ) (choose : State b → CutReply b) : Prop :=
  ∀ s, Attained b K choose s → s.pending = [] → s.cachedGradient ≠ 0 →
    RatioGuarantee (cachedPhysical b s) K (choose s).G (choose s).U (choose s).cut

def Stable (b : Core) (s : State b) : Prop := s.stopped = true

/-- Constant-query readout uses only the stored historical output, never fresh implicit labels. -/
def query (b : Core) (s : State b) (v : Fin b.input.n) : ℝ≥0∞ := s.output v

end DecrAlmostLinearSSSP.Decremental


