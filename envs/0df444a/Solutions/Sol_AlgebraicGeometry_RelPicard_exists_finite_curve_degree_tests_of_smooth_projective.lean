    (n : ℕ)
    (i : X ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K))
    [IsClosedImmersion i] (hi : i ≫ ProjSpace.π K n = π) :
    ∃ s : Finset (CurveDegreeTests.Probe π),
      ∀ M : X.Modules, Scheme.Modules.IsInvertible M →
        (∀ t ∈ s, t.degree M = 0) → CurveDegreeTests.NumericallyTrivial π M := by
  obtain ⟨s, hs⟩ := PhilipponFiniteCurveTests.finite_profile_detection
    (fun M : {M : X.Modules // Scheme.Modules.IsInvertible M} =>
      (fun t : CurveDegreeTests.Probe π => (t.degree M.val : ℚ)))
    (RelPicard.finite_curve_degree_profile_span_of_smooth_projective K π n i hi)
  refine ⟨s, ?_⟩
  intro M hM hzero
  have hall := hs ⟨M, hM⟩ (by
    intro t ht
    exact congrArg (fun a : ℤ => (a : ℚ)) (hzero t ht))
  intro t
  exact Int.cast_eq_zero.mp (hall t)
