namespace OAI

/-!
# Auxiliary-column Gram matrices

The functions in manuscript §4 are interpreted, with the same sampled
column in all factors. Real Gram forms are nonnegative for any real positive
semidefinite coefficient matrix. No numerical certificate is assumed here.
-/

noncomputable section
open scoped BigOperators ComplexConjugate
open Matrix

namespace MUB6

/-- Real Gram pairing on a uniformly sampled finite space. -/
def realGram {Ω : Type*} [Fintype Ω] (F G : Ω → ℂ) : ℝ :=
  average (fun ω => (F ω * conj (G ω)).re)

def pairLabelEmbedding (s : Fin 5) : Fin 2 ↪ Coord :=
  ⟨![s.succ, 0], by
    intro i j h
    fin_cases i <;> fin_cases j <;> simp_all
    all_goals exact (Fin.succ_ne_zero _ h.symm).elim⟩

end MUB6

end

end OAI
