    WeierstrassProjModel.RelativeGroupLaw.IsDrinfeldBasisOver.exists_comp_fst_schemeKer_eq _ hq2 hover
  have hns : ((𝒢.restrictScalars W₀) Pet.B₀ xet.curve xet.isUnit_Δ).nsmul _ q
      ⟨Qk.1 ≫ eqToHom (congrArg projModelCR rfl) ≫ Proj.map φc hφc, hQov⟩ =
      ((𝒢.restrictScalars W₀) Pet.B₀ xet.curve xet.isUnit_Δ).one _ :=
    glue_nsmul_eq_one_of_comp_fst_schemeKer _ q _ p hpfst
  obtain ⟨χa, hχa, -⟩ := (hrep k ⟨Qk.1 ≫ eqToHom (congrArg projModelCR rfl) ≫ Proj.map φc hφc, hQov⟩).mp hns
  simp only [eqToHom_refl, Category.id_comp] at hχa
  have hχψ : ∀ b : Pet.B₀, χa.toRingHom (algebraMap Pet.B₀ CQ b) = ψet b := fun b => χa.commutes b
  have hpin : Qk.1 ≫ Proj.map φc hφc = Spec.map (CommRingCat.ofHom χa.toRingHom) ≫ Qu.1 := hχa.symm

  have hQ0 : Spec.map (CommRingCat.ofHom χa.toRingHom) ≫ Qu.1 ≠
