section
-- Source module: Solutions.KFY13AxB
/-!
# KFY 13: one axis of the `B₀` pass

`axB X Kc` is `axA X Kc` with two changes:

* after `t_k`, `m_k` it computes `u_k = (s_k mod t_k)^{-1}` into `yU = 17` (`invP`: KFM's
  `sumLoop`, `u = ∑_{y ∈ [1, t]} y·[y s ≡ 1 (mod t)]`, **`inv_sum`**), popped at the end;
* the line program is the padded `B̃₀` (`bap0AxQ`, registers `regsB`).

**`axB_all`**: the array `X` on stack `0` becomes `stepL R_k (b0Pad' p s_k t_k α) X`, with the
line map `x ↦ b0L p s t α x ++ replicate (t − s) 0`; `s_k` moves from `dS` to `yS`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp
open NLogN.KFM (shPad bsN)

abbrev yU : Fin HS := 17

/-! ## The modular inverse -/

/-- `u = s^{-1} mod t` into `yU` (`s` on `yS`, `t` on `yT`). -/
def invP : RS :=
  .seq (.push KFM.mS (.reg yT)) (.seq (.push KFM.mP (.reg yS)) (.seq (.push KFM.mM (.lit 0))
    (.seq (.rep KFM.mIc (.reg KFM.mS) KFM.sumB) (.seq (.push NLogN.KFY.yU (.reg KFM.mM))
      (.seq (.pop KFM.mM) (.seq (.pop KFM.mP) (.pop KFM.mS)))))))

/-- The cost bound of `invP`. -/
def invC (t B : ℕ) : ℕ :=
  (t + 1) * 40 * (10 ^ 7 * (B + 2) ^ 2) + 8 * (10 ^ 7 * (B + 2) ^ 2) + 6 * B + 6

/-! ## The `B̃₀` registers -/

/-- `α² (t − s)`. -/
def dJE : Ex HS := .mul (.mul (.reg yA) (.reg yA)) (.add (.reg yT) (.neg (.reg yS)))
/-- `J = ⌈p s / (α² (t − s))⌉`. -/
def jE : Ex HS := .ndiv (.add (.add (.mul (.reg NLogN.KFY.yP) (.reg yS)) dJE) (.lit (-1))) dJE

/-- The registers of `bap0AxQ`. -/
def regsB : List (Fin HS × Ex HS) :=
  [(NLogN.AX.bT, .reg yT), (bKB, .reg yT), (bS, .reg yS), (bPR, .pow2 (.reg NLogN.KFY.yP)), (bKs, .reg yS),
    (bKa, .nmod (.add (.reg yS) (.neg (.nmod (.reg NLogN.KFY.yW) (.reg yS)))) (.reg yS)),
    (bKN, .add (.reg yS) nrE), (bR, .pow2 (.reg NLogN.KFY.yP)), (AX.bN, .reg yS), (bNR, nrE),
    (bNW, .mul (.reg yS) nrE), (bJL, .add (.reg yS) (.reg yS)), (bJN, jE), (bO, .reg NLogN.KFY.yP),
    (bI, .mul (.reg yA) (.reg yA)), (bKS, .reg NLogN.KFY.yU), (bM, .reg NLogN.KFY.yM),
    (bTot, .mul (.reg NLogN.KFY.yM) (.reg yT))]

/-- **One axis of the `B₀` pass.** -/
noncomputable def axB (X : Fin HS) (Kc : ℝ) : RM :=
  .seq (.rs (takeD yS (.reg NLogN.KFY.dS))) (brk [(NLogN.KFY.yB, bitE)] (brk [(yT, NLogN.KFY.tE), (NLogN.KFY.yM, mE)]
    (.seq (.rs invP) (.seq (.seq (brk [(zw, wE), (zm, kE)] (trBlk X Kc zw zm))
      (brk regsB bap0AxQ)) (.rs (.pop NLogN.KFY.yU))))))

/-- The cost bound of one `B₀` axis. -/
noncomputable def axBC (Kc : ℝ) (n t B K Ctr Cbap : ℕ) : ℕ :=
  (2 * 10 ^ 7 * (B + 2) ^ 2 + (2 * B + 2)) +
    brkC 1 K B (brkC 2 K B (invC t B + ((brkC 2 K B (1 + (10 ^ 12 * (IntMul.OpenAI.Glue.bP n + 1) ^ 3 + Ctr)) +
      brkC 18 K B Cbap) + (2 * B + 2))))

/-- Size bounds for one axis (`B₀` pass). -/
structure AxBndB (n A B : ℕ) : Prop where
  env : KFM.CostEnv A B
  pA : 2 ^ (2 * IntMul.OpenAI.Glue.pP n) ≤ A
  αA : IntMul.OpenAI.Glue.αP n ^ 2 * IntMul.OpenAI.Glue.rP n ^ 2 ≤ A
  jA : IntMul.OpenAI.Glue.pP n * IntMul.OpenAI.Glue.rP n + IntMul.OpenAI.Glue.αP n ^ 2 * IntMul.OpenAI.Glue.rP n ≤ A
  wA : IntMul.OpenAI.Glue.rP n * (2 * HvdH.eWidth (IntMul.OpenAI.Glue.pP n) (IntMul.OpenAI.Glue.αP n) + 1) + IntMul.OpenAI.Glue.rP n ≤ A
  LA : 2 ^ IntMul.OpenAI.Glue.LP n ≤ A
  dA : IntMul.OpenAI.Glue.dP n ≤ A
  pB : 2 * IntMul.OpenAI.Glue.pP n + 1 ≤ B
  LB : IntMul.OpenAI.Glue.LP n + 2 ≤ B

/-- The padded `B̃₀` line map. -/
def b0Q (p s t α : ℕ) (x : List KFB.GI) : List KFB.GI :=
  KFM.b0L p s t α x ++ List.replicate (t - s) (0, 0)

end NLogN.KFY

