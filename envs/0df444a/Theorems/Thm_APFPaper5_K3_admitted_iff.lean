theorem APFPaper5.K3.admitted_iff (hroot : ∀ t : ℝ, 0 ≤ t → ∃ r : ℝ, 0 ≤ r ∧ r * r = t) (T : Held2 → Held2) :
    (AdditiveHomogeneous T ∧ PreservesTotalCost T ∧ CommonTurnUnseenAfter T) ↔
      (BuiltFromTurns T ∨ BuiltFromTurns (fun h => rateFlip (T h))) := by sorry
