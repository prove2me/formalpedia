-- title:
--   Zero-one germ sits in the null generateFrom sigma-algebra
-- statement:
--   If every germSigma Y set has probability 0 or 1, then germSigma Y is leq the sigma-algebra generated by subsets of measurable null sets.
-- source:
--   Kyprianou Ch.3 Blumenthal packaging; Durrett 7.2

import Mathlib
import Definitions.Def_DurrettProbability_Brownian
open MeasureTheory ProbabilityTheory DurrettProbability Set
open scoped NNReal
set_option autoImplicit false

namespace Kyprianou.Ch03

/-- A $0$–$1$ germ $\sigma$-algebra is contained in the null-set `generateFrom` $\sigma$-algebra. -/
theorem germ_zero_one_le_nullCompletion
    {Omega : Type} [MeasurableSpace Omega]
    (P : Measure Omega) [IsProbabilityMeasure P]
    (Y : NNReal → Omega → Real)
    (h01 : ∀ {A : Set Omega}, @MeasurableSet Omega (germSigma Y) A → P A = 0 ∨ P A = 1) :
    germSigma Y ≤
      MeasurableSpace.generateFrom
        {A : Set Omega | ∃ N : Set Omega, MeasurableSet N ∧ P N = 0 ∧ A ⊆ N} := by
  sorry

end Kyprianou.Ch03
