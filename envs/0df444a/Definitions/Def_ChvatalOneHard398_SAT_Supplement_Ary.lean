-- title:
--   General q-ary lattice data and membership
-- statement:
--   Let $A\in\mathbb Z^{n\times m}$ and let $q$ be a modulus. Valid data represent residues by $0,\ldots,q-1$. The general q-ary lattice is generated by the rows of $A$, viewed as columns in $\mathbb R^m$, together with $qe_1,\ldots,qe_m$:
--   $$\Lambda_q(A^T)=A^T\mathbb Z^n+q\mathbb Z^m.$$
--   An integer vector $y$ belongs exactly when $y\equiv A^Ts\pmod q$ for some integral $s$. Matrices have no rank assumption. Target data add an integral vector with the same residue convention. This object is independent of the subsequent choice of Hermite basis, formulas and Gaussian parameters.
-- source:
--   Alberto Del Pia, 0/1 integer programming over polytopes of Chvátal rank one is as hard as lattice problems, STOC 2027 submission #398 (October 2026), p.9, 14, §2 and §4.2. https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/398.pdf

import Mathlib
import Definitions.Def_ChvatalOneHard398_SAT_Supplement_Geometry

namespace ChvatalOneHard398.SAT.Supplement
open scoped BigOperators

structure AryMatrix where
  n : ℕ
  m : ℕ
  q : ℕ
  A : Matrix (Fin n) (Fin m) ℤ

structure AryInput extends AryMatrix where
  t : Fin m → ℤ

def AryMatrix.Valid (a : AryMatrix) : Prop :=
  ∀ i j, 0 ≤ a.A i j ∧ a.A i j < (a.q : ℤ)

def AryInput.Valid (a : AryInput) : Prop :=
  a.toAryMatrix.Valid ∧ ∀ j, 0 ≤ a.t j ∧ a.t j < (a.q : ℤ)

def aryMember (a : AryMatrix) (y : Fin a.m → ℤ) : Prop :=
  ∃ s : Fin a.n → ℤ, ∀ j, (a.q : ℤ) ∣ y j - ∑ i, a.A i j * s i

noncomputable def aryLattice (a : AryMatrix) : Submodule ℤ (E a.m) :=
  Submodule.span ℤ ((Set.range fun i : Fin a.n => zVec (a.A i)) ∪
    (Set.range fun i : Fin a.m => zVec (fun j => if j = i then (a.q : ℤ) else 0)))

end ChvatalOneHard398.SAT.Supplement


