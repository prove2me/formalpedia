-- Source module: Solutions.KFGPhase
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFG

open IntMul RS AModel KIL KFD KFB Complex

theorem I_pow_mod4 (n : ℕ) : I ^ (n % 4) = I ^ n := by
  conv_rhs => rw [← Nat.div_add_mod n 4, pow_add, pow_mul, Complex.I_pow_four, one_pow, one_mul]

theorem phOut_spec (K off u : ℕ) (aE : ℕ → ℕ) (zs : List GI) (hlen : off + 2 ^ K ≤ zs.length) :
    (phOut K off u aE zs).length = zs.length ∧
    ∀ i, NLogN.KFB.toC ((phOut K off u aE zs).getD i 0) =
      (if off ≤ i ∧ i < off + 2 ^ K then
        I ^ (u + ∑ p ∈ Finset.range K, aE p * ((i - off) / 2 ^ p % 2)) else 1) *
      NLogN.KFB.toC (zs.getD i 0) := by
  have hT := length_tbl u aE K
  have hs : ((zs.drop off).take (2 ^ K)).length = 2 ^ K := by simp; omega
  have hm : (mulL (tbl u aE K) ((zs.drop off).take (2 ^ K))).length = 2 ^ K := by
    rw [length_mulL _ _ (hT.trans hs.symm), hs]
  have hp : (zs.take off).length = off := by simp; omega
  refine ⟨by rw [phOut, List.length_append, List.length_append, hp, hm, List.length_drop]; omega,
    fun i => ?_⟩
  unfold phOut
  by_cases h1 : i < off
  · rw [if_neg (by omega), List.getD_append _ _ _ _ (by omega), getD_take' _ _ _ h1, one_mul]
  rw [List.getD_append_right _ _ _ _ (by omega), hp]
  by_cases h2 : i < off + 2 ^ K
  · rw [if_pos ⟨by omega, h2⟩, List.getD_append _ _ _ _ (by omega)]
    have hq : i - off < 2 ^ K := by omega
    rw [List.getD_eq_getElem _ _ (by omega)]
    simp only [mulL, List.getElem_zipWith]
    have e4 := (ex4_tbl u aE K) _ (List.getElem_mem (show i - off < (tbl u aE K).length by omega))
    rw [toC_rot e4.1 e4.2]
    have ht : (tbl u aE K)[i - off] = (((u + ∑ p ∈ Finset.range K, aE p * ((i - off) / 2 ^ p % 2))
        % 4 : ℕ) : ℤ) := by
      rw [← getD_tbl u aE K _ hq, List.getD_eq_getElem]
    rw [ht, Int.toNat_natCast, I_pow_mod4, List.getElem_take, List.getElem_drop,
      ← List.getD_eq_getElem _ 0 (by omega)]
    congr 3; omega
  · rw [if_neg (show ¬(off ≤ i ∧ i < off + 2 ^ K) by omega), one_mul,
      List.getD_append_right _ _ _ _ (by rw [hm]; omega), hm, NLogN.KFB.getD_drop']
    rw [show off + 2 ^ K + (i - off - 2 ^ K) = i by omega]

theorem rep_phaseT {W m n : ℕ} (T : Butterfly.Op (Fin n)) (w : Fin W)
    (k₀ k₁ : ℕ) (a : Fin m → ℕ) (zs : List GI) (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ)
    (hx : Rep zs x) :
    Rep (phOut (m * n) (w.val * 2 ^ (m * n)) (k₀ + k₁ * n) (phE (n := n) a) zs)
      ((P8Lift.RStep.den T (P8Lift.RStep.phase w k₀ k₁ a)).mulVec x) := by
  obtain ⟨hl, hv⟩ := hx
  have hw : w.val * 2 ^ (m * n) + 2 ^ (m * n) ≤ zs.length := by
    rw [hl, ← Nat.succ_mul]; exact Nat.mul_le_mul_right _ w.isLt
  obtain ⟨L, S⟩ := phOut_spec (m * n) _ (k₀ + k₁ * n) (phE a) zs hw
  refine ⟨L.trans hl, fun w' b => ?_⟩
  rw [S, hv, P8Lift.RStep.den, Matrix.mulVec_diagonal]
  have hb := aidx_lt b
  by_cases e : w' = w
  · subst e
    rw [if_pos ((seg_iff hb).2 rfl), if_pos rfl]
    congr 1
    simp only [P8Lift.RStep.phExp, Fintype.card_fin, Nat.add_sub_cancel_left]
    rw [phase_sum_eq a b]
    rfl
  · rw [if_neg (fun h => e (Fin.ext ((seg_iff hb).1 h))), if_neg e]

end NLogN.KFG

end

