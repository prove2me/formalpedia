theorem fok_accCU (w : ℕ) : fok (accCU w) = true := by simp +decide [copyCU, accCU, zipKE, dupKE, fok, touch, scr, NLogN.mvK, Ex.regs, mAdd, KFC.uK, KFC.uR, KFC.uY, KFC.uB]

