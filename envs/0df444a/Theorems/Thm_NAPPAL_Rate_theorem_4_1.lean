-- title:
--   Theorem 4.1, p. 16 — convergence of NAPP-AL: bounded iterates, vanishing steps and residuals, stationary cluster points
-- statement:
--   Let Assumptions 1 and 2 hold, set $\delta_k$ as in (8), and let $\{w^k\}$ be generated by NAPP-AL. Then there is a real number $\Lambda^*$ such that:
--   1. $\{\Lambda^k\}_{k\ge1}$ is bounded below and $\lim_{k\to\infty}\Lambda^k=\Lambda^*$;
--   2. $\{w^k\}$ is bounded and $\|w^k-w^{k+1}\|\to0$;
--   3. $\mathcal L_\gamma(w^k)\to\Lambda^*$, $F(u^k,v^k)\to\Lambda^*$ and $\Theta(u^k)+Bv^k\to0$;
--   4. there is $c_5>0$ with
--   $$\operatorname{dist}\big(0,\partial\mathcal L_\gamma(w^{k+1})\big)\le c_5\|w^k-w^{k+1}\|\qquad\text{for all }k,$$
--   and hence $\operatorname{dist}(0,\partial\mathcal L_\gamma(w^k))\to0$;
--   5. every cluster point $\bar w$ of $\{w^k\}$ is a stationary point of (P), i.e. $0\in\partial\mathcal L_\gamma(\bar w)$, and $\mathcal L_\gamma(\bar w)=\Lambda^*$.
--
--   This is the global subsequential convergence theorem for NAPP-AL; the rate result Proposition 4.1 combines part 4 with the sufficient decrease of Lemma 4.3.
--
--   **Formalization Note** One number $\Lambda^*$ serves parts 1, 3 and 5. Part 4 is printed as "$\operatorname{dist}(0,\partial\mathcal L_\gamma(u^k))\le c_5\|w^k-w^{k+1}\|$"; $\partial\mathcal L_\gamma$ is a function of $w$, and the proof (via Proposition 3.1) and the later uses in Propositions 6.1–6.2 bound the residual at $w^{k+1}$, which is the form stated. The "hence" clause is at $w^k$, as printed. $\operatorname{dist}$ takes values in $[0,+\infty]$ and is $+\infty$ on the empty set. Cluster points are taken in the (Euclidean) topology of $\mathbb R^n\times\mathbb R^d\times\mathbb R^m$.
-- source:
--   Zhu, Zhao, Zhang, A First-Order Primal-Dual Method for Nonconvex Constrained Optimization Based on the Augmented Lagrangian, arXiv:2007.12219v1, p. 16, Theorem 4.1(i)–(v); (iv) read at w^{k+1}, see the Formalization Note

import Mathlib
import Definitions.Def_NAPPAL_Rate_Setting
open Filter Topology
open scoped InnerProductSpace

namespace NAPPAL.Rate

theorem theorem_4_1 {n d m : ℕ} (P : NAPPAL.KL.Problem n d m) (LG LH L0 LK β γ σ : ℝ) (LOmj : Fin m → ℝ)
    (K : NAPPAL.KL.E n → ℝ) (δ ε : ℕ → ℝ) (u : ℕ → NAPPAL.KL.E n) (v : ℕ → NAPPAL.KL.E d) (p : ℕ → NAPPAL.KL.E m)
    (hrun : RunHyp P LG LH L0 LOmj K β LK γ σ δ ε u v p) :
    ∃ Λstar : ℝ,
      -- (i)
      (BddBelow (NAPPAL.KL.Lam P LG LH L0 γ u v p '' Set.Ici 1) ∧
        Tendsto (NAPPAL.KL.Lam P LG LH L0 γ u v p) atTop (𝓝 Λstar)) ∧
      -- (ii)
      ((∃ R : ℝ, ∀ k, NAPPAL.KL.tnorm ((u k, v k, p k) : NAPPAL.KL.W n d m) ≤ R) ∧
        Tendsto (fun k => NAPPAL.KL.wdist (u k, v k, p k) (u (k + 1), v (k + 1), p (k + 1))) atTop
          (𝓝 0)) ∧
      -- (iii)
      (Tendsto (fun k => NAPPAL.KL.augLag P γ (u k, v k, p k)) atTop (𝓝 Λstar) ∧
        Tendsto (fun k => NAPPAL.KL.F P (u k) (v k)) atTop (𝓝 Λstar) ∧
        Tendsto (fun k => NAPPAL.KL.Theta P (u k) + P.B (v k)) atTop (𝓝 0)) ∧
      -- (iv)
      ((∃ c5 : ℝ, 0 < c5 ∧ ∀ k, NAPPAL.KL.distZero (NAPPAL.KL.dAugLag P γ (u (k + 1), v (k + 1), p (k + 1))) ≤
          ENNReal.ofReal (c5 * NAPPAL.KL.wdist (u k, v k, p k) (u (k + 1), v (k + 1), p (k + 1)))) ∧
        Tendsto (fun k => NAPPAL.KL.distZero (NAPPAL.KL.dAugLag P γ (u k, v k, p k))) atTop (𝓝 0)) ∧
      -- (v)
      (∀ wbar : NAPPAL.KL.W n d m, MapClusterPt wbar atTop (fun k => ((u k, v k, p k) : NAPPAL.KL.W n d m)) →
        NAPPAL.KL.IsStationary P γ wbar ∧ NAPPAL.KL.augLag P γ wbar = Λstar) := by sorry

end NAPPAL.Rate
