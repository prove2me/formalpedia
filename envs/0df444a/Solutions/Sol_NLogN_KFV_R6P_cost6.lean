namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

theorem ops1_wf (hℓ : 2 ≤ ℓ) : ∀ o ∈ ops1 D ℓ long, o.WF (nLong D long + D * (ℓ - 1)) := by
  intro o ho
  simp only [ops1, List.mem_map, List.mem_range] at ho
  obtain ⟨k, hk, rfl⟩ := ho
  simp only [LOp.WF]
  have hfb1 := fbk_le D long k
  have hcl : rkS D long k + fbk D long k ≤ nLong D long := by
    rw [← rkS_succ, ← rkS_D]; exact rkS_mono D long (by omega)
  have hkl : (k + 1) * (ℓ - 1) ≤ D * (ℓ - 1) := Nat.mul_le_mul_right _ (by omega)
  have hkk : k * (ℓ - 1) + (ℓ - 1) = (k + 1) * (ℓ - 1) := by ring
  rcases Nat.le_one_iff_eq_zero_or_eq_one.1 hfb1 with h | h
  · rw [h, zero_mul]; omega
  · rw [h, one_mul]; omega

theorem ops2_wf (hK : 0 < K) (hℓ : 2 ≤ ℓ) (hq1 : 1 ≤ qq ℓ K) :
    ∀ o ∈ ops2 D ℓ K long, o.WF (nLong D long + D * (ℓ - 1)) := by
  intro o ho
  simp only [ops2, List.mem_map, List.mem_range] at ho
  obtain ⟨k, hk, rfl⟩ := ho
  simp only [LOp.WF]
  set b := bb ℓ K with hb
  set q := qq ℓ K with hq
  have hbq : b + q * K = ℓ - 1 := hbq ℓ K hK (by omega)
  have hD : 0 < D := Nat.pos_of_ne_zero (NeZero.ne D)
  set u := k / D with hu
  set i := k % D with hi
  have hki : u * D + i = k := by rw [hu, hi, Nat.mul_comm]; exact Nat.div_add_mod k D
  have hiD : i < D := Nat.mod_lt _ hD
  have hub : u < b := by rw [hu]; exact (Nat.div_lt_iff_lt_mul hD).2 hk
  set w := b - 1 - u with hw
  have hδ' : dl2 D ℓ K k = i * (q * K + w) + q * K := by rw [dl2]
  have h1 : i * w ≤ D * w := Nat.mul_le_mul_right _ hiD.le
  have h2 : (i + 1) * (q * K) ≤ D * (q * K) := Nat.mul_le_mul_right _ hiD
  have hKq : K ≤ q * K := Nat.le_mul_of_pos_left _ hq1
  refine ⟨by omega, ?_⟩
  rw [hδ', ← hki]
  have : ℓ - 1 = u + 1 + w + q * K := by omega
  rw [this]; nlinarith

end Paper

end NLogN.KFV

