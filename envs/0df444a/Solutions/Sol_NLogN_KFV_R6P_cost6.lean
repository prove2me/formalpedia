    ((Ex.sel (.add (.reg gV) (.neg (.reg gI))) (srcE (.reg gV)) (.reg gV)) : Ex HS).size ≤ 200 := by
  decide
theorem sz_cnd : eCnd.size ≤ 200 := by decide

/-! ## One move -/

theorem kap_le (W : ℕ) : kap W ≤ 200 * (W + 1) := by unfold kap; omega

theorem pow_split {c δ E m : ℕ} (h : c + δ + E = m) : 2 ^ c * 2 * 2 ^ δ * 2 ^ E = 2 * 2 ^ m := by
  rw [← h]; ring

