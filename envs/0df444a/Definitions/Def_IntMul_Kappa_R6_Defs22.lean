-- Source module: Solutions.R6IL3Def
/-!
# Round six, item language (I3): the level procedure for a network with slot-set children

The level procedure `levCH c jL rowC` (to be placed at index `jL` of the table) implements
`tens Cm` on `E` bits (`E` on `vk`) at positions `e - K i` (`e` on `vE`), strides
`2^{e - K i} S₀`, of `B 2^t S₀` records.  Configuration `c : Cfg`: `W` data roles, `T`
temporaries, slot count `m`, gate-class bound `A`, the scale parameters `Aw`, `p`, and the
network `c.net` (the normalized network on `Fin (W + T)`, `R6IL3Net.netF`).

* `E = 0`: nothing;
* `0 < E < 2m` (`chainC`): the kernel on bit `e` (a frozen level-`0` frame and `leafC`), then the
  level call on the `E - 1` bits below;
* `E ≥ 2m` (`nodeC`): with `F = E / m`, the node registers (`nodeFr1`, `nodeFr2`), the steps of
  the network on `W + T` roles of `B/W 2^t S₀` records (temporaries allocated as zero records by
  `padCU`), the leftover `E mod m` bits (a level call), and the scale pad `scaleQ` by
  `δ = Gs E - cL - ∑ Gs (s F) - E mod m`.

A child step `child w S _` (with `S = pref m s`) pushes `wP = 2^{Gs (sF)}`, the child frame
`vX = Gs (sF)`, `vB = B/W`, `vk = s F` (`vE` unchanged: the slots `< s` are the top `s F` bits)
and runs `wrapQ` around the call.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- The configuration of the level procedure. -/
structure Cfg where
  W : ℕ
  T : ℕ
  m : ℕ
  A : ℕ
  Aw : ℕ
  p : ℕ
  net : List (HStep (Fin (W + T)) m)

namespace Cfg

/-- The number of roles. -/
abbrev Wr (c : Cfg) : ℕ := c.W + c.T

/-- The scale function. -/
abbrev G (c : Cfg) (x : ℕ) : ℕ := Gs c.Aw c.p c.m x

end Cfg

/-! ## Natural expressions -/

/-- `x ^ k`. -/
def powNE (x : NE) : ℕ → NE
  | 0 => .lit 1
  | k + 1 => .mul (powNE x k) x

/-- `Gs Aw p m x`. -/
def gsNE (Aw p m : ℕ) (x : NE) : NE :=
  .lt x (.lit (2 * m)) x (.mul (.lit Aw) (.sub (powNE (.add x (.lit 1)) p) (.lit 1)))

/-! ## The gate choice and the local scale -/

/-- `G` is the gate of the atoms `as` (on `W'` roles, at most `A` atoms). -/
def GAtH (W' A : ℕ) (G : Matrix (Fin W') (Fin W') ℂ) (as : List KFG.Atom) : Prop :=
  as.length ≤ A ∧ (∀ a ∈ as, a.Ok W' ∧ a.h ≤ 1) ∧ KFG.NoTS as ∧ G = KFG.gateMat W' as

open Classical in
/-- The chosen atoms of a gate. -/
noncomputable def gAtH (W' A : ℕ) (G : Matrix (Fin W') (Fin W') ℂ) : Option (List KFG.Atom) :=
  if h : ∃ as, GAtH W' A G as then some (Classical.choose h) else none

open Classical in
/-- The chosen sign set of a `±1` role diagonal. -/
noncomputable def gDiagH (W' : ℕ) (G : Matrix (Fin W') (Fin W') ℂ) : Option (Finset (Fin W')) :=
  if h : ∃ U : Finset (Fin W'), G = Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1 then
    some (Classical.choose h) else none

/-- The scale of a local step. -/
noncomputable def eLocH (W' A m : ℕ) : HStep (Fin W') m → ℕ
  | .gate G => match gAtH W' A G with
    | some as => gδ as
    | none => 0
  | _ => 0

/-- The scale of the local steps of a node. -/
noncomputable def cLH (c : Cfg) : ℕ := (c.net.map (eLocH c.Wr c.A c.m)).sum

/-- The child widths of the network. -/
def chWs (c : Cfg) : List ℕ := c.net.filterMap HStep.width

/-- `∑_{children} Gs (s F)` with `F` on `wF`. -/
def sumGsNE (c : Cfg) : List ℕ → NE
  | [] => .lit 0
  | s :: l => .add (gsNE c.Aw c.p c.m (.mul (.lit s) (.reg wF))) (sumGsNE c l)

/-- The pad scale `δ = Gs E - cL - ∑ Gs (s F) - E mod m` (`Gs E` on `vX`, `E` on `vk`). -/
noncomputable def δNE (c : Cfg) : NE :=
  .sub (.sub (.sub (.reg vX) (.lit (cLH c))) (sumGsNE c (chWs c))) (.mod (.reg vk) (.lit c.m))

/-- The value of `δ`. -/
noncomputable def δv (c : Cfg) (E : ℕ) : ℕ :=
  c.G E - cLH c - ((chWs c).map fun s => c.G (s * (E / c.m))).sum - E % c.m

/-! ## Codes -/

variable {Pp : ℕ}

/-- A gate of atoms on `W'` roles, then the leveling. -/
def gateUH (W' : ℕ) (as : List KFG.Atom) : RS :=
  .seq (gatePG as (fun _ => 0) wL) (gatePG (levOf W' as) (gateE as (fun _ => 0)) wL)

/-- A phase step on role `w` (row exponents `a`). -/
def phH (W' : ℕ) (w : ℕ) (k0 k1 : ℕ) (a : List ℕ) : IStmt HS Pp :=
  wrapQ W' w wL w1 (withPushI [(wU, uE (k0 % 4) (k1 % 4))]
    (fcode (phLU wR0 vT wB wU wV (εTab vE vK vF wF a))))

/-- Code of the phase steps of a sign diagonal. -/
def phStepH {W' m : ℕ} : RStep (Fin W') m → IStmt HS Pp
  | .phase w k0 k1 a => phH W' w.val k0 k1 (List.ofFn a)
  | _ => .skip

/-- The register of the compact-controls field width `G` (pushed once by the entry). -/
abbrev vG : Fin HS := 24

/-- The row-addition parameters: `[F, K, e, t, S₀, B/W, r, H, i, j]` on `36 … 45`, then the
compact-controls parameters `[G, Bf, Sb] = [G, 1, 1]` on `46, 47, 48`. -/
def rowPushH (i j : ℕ) : List (Fin HS × Ex HS) :=
  [(36, .reg wF), (37, .reg vK), (38, .reg vE), (39, .reg vT), (40, .reg vS), (41, .reg wB),
    (42, .reg vR), (43, .reg vH), (44, .lit (i : ℤ)), (45, .lit (j : ℤ)), (46, .reg vG),
    (47, .lit 1), (48, .lit 1)]

/-- The child frame of width `s F`: `wP = 2^{Gs (sF)}`, `vX = Gs (sF)`, `vB = B/W`, `vk = s F`. -/
def childFrH (c : Cfg) (s : ℕ) : List (Fin HS × Ex HS) :=
  [(wP, .pow2 (gsNE c.Aw c.p c.m (.mul (.lit s) (.reg wF))).toEx),
    (vX, (gsNE c.Aw c.p c.m (.mul (.lit s) (.reg wF))).toEx), (vB, .reg wB),
    (vk, (NE.mul (.lit s) (.reg wF)).toEx)]

/-- The code of one step of the network. -/
noncomputable def stepH (c : Cfg) (jL : Fin Pp) (rowC : IStmt HS Pp) :
    HStep (Fin c.Wr) c.m → IStmt HS Pp
  | .gate G => match gAtH c.Wr c.A G with
    | some as => fcode (gateUH c.Wr as)
    | none => match gDiagH c.Wr G with
      | some U => seqLQ phStepH (negSteps (m := c.m) U.toList)
      | none => .skip
  | .rowAdd w i j _ => wrapQ c.Wr w.val wL w1 (withPushI (rowPushH i.val j.val) rowC)
  | .phase w k0 k1 a => phH c.Wr w.val k0 k1 (List.ofFn a)
  | .perm σ => fcode (swapsG wL (permSw σ))
  | .child w S _ => withPushI (childFrH c S.card) (wrapQ c.Wr w.val wL wP (.call jL))

/-- The node registers (natural expressions): `F = E/m`, `B/W`, `S₀ r`, `K F`, `1`, `vF = m F`. -/
def nodeFr1 (c : Cfg) : List (Fin HS × NE) :=
  [(wF, .div (.reg vk) (.lit c.m)), (wB, .div (.reg vB) (.lit c.W)), (wR0, .mul (.reg vS) (.reg vR)),
    (wKF, .mul (.reg vK) (.div (.reg vk) (.lit c.m))), (w1, .lit 1),
    (vF, .mul (.lit c.m) (.div (.reg vk) (.lit c.m)))]

/-- `B/W 2^t S₀ r` (the role length). -/
def eRole : Ex HS := .mul (.mul (.reg wB) (.pow2 (.reg vT))) (.reg wR0)

/-- `B 2^t S₀ r` (the data length). -/
def eData : Ex HS := .mul (.mul (.reg vB) (.pow2 (.reg vT))) (.reg wR0)

/-- The node registers (expressions): the pad register `26 = 2^δ`, `wL`, `wV`, the allocation
lengths `21 = 2 T (B/W) 2^t S₀ r`, `23 = 2 B 2^t S₀ r`, the pad register `25 = B 2^t S₀ r`. -/
noncomputable def nodeFr2 (c : Cfg) : List (Fin HS × Ex HS) :=
  [(26, .pow2 (δNE c).toEx), (wL, eRole),
    (wV, .mul (.lit 2) (.mul (.reg wB) (.mul (.reg wR0) (.pow2 (.reg vT))))),
    (21, .mul (.lit (2 * c.T : ℕ)) eRole), (23, .mul (.lit 2) eData), (25, eData)]

/-- The frame of the leftover call: `E mod m` bits at `e - K m F` (truncated at `0`; the test
keeps the natural expression defined when `E mod m = 0`). -/
def leftFr (c : Cfg) : List (Fin HS × NE) :=
  [(vX, .mod (.reg vk) (.lit c.m)),
    (vE, .lt (.mul (.reg vK) (.mul (.lit c.m) (.reg wF))) (.add (.reg vE) (.lit 1))
      (.sub (.reg vE) (.mul (.reg vK) (.mul (.lit c.m) (.reg wF)))) (.lit 0)),
    (vk, .mod (.reg vk) (.lit c.m))]

/-- A node. -/
noncomputable def nodeC (c : Cfg) (jL : Fin Pp) (rowC : IStmt HS Pp) : IStmt HS Pp :=
  withPushI (fr (nodeFr1 c)) (withPushI (nodeFr2 c)
    (.seq (padCU 23 21 (seqLQ (stepH c jL rowC) c.net))
      (.seq (withPushI (fr (leftFr c)) (.call jL)) (scaleQ 23 23 25 26))))

/-- The frozen level-`0` frame (`vk = 0`, `vF = 1`, `vX = ES 0 = 1`). -/
def kerFr : List (Fin HS × NE) := [(vk, .lit 0), (vF, .lit 1), (vX, .lit 1)]

/-- The frame of the chain call: `E - 1` bits at `e - K` (truncated at `0`). -/
def chainFr : List (Fin HS × NE) :=
  [(vX, .sub (.reg vk) (.lit 1)),
    (vE, .lt (.reg vK) (.add (.reg vE) (.lit 1)) (.sub (.reg vE) (.reg vK)) (.lit 0)),
    (vk, .sub (.reg vk) (.lit 1))]

/-- A chain: the kernel on bit `e`, then the `E - 1` bits below. -/
def chainC (jL : Fin Pp) : IStmt HS Pp :=
  .seq (withPushI (fr kerFr) leafC) (withPushI (fr chainFr) (.call jL))

/-- The chain test: `0` iff `E < 2m`. -/
def ltNE (c : Cfg) : NE := .lt (.reg vk) (.lit (2 * c.m)) (.lit 0) (.lit 1)

/-- **The level procedure.** -/
noncomputable def levCH (c : Cfg) (jL : Fin Pp) (rowC : IStmt HS Pp) : IStmt HS Pp :=
  .ite vk (fun x => decide (x = NLogN.Cls.zero)) .skip
    (testC 19 (ltNE c) (chainC jL) (nodeC c jL rowC))

/-! ## Register facts -/

/-- The registers of a level call on `E` bits. -/
structure LevRH (c : Cfg) (σ : Fin HS → Option ℤ) (K t S0 r H E e B : ℕ) : Prop where
  off : OffG σ
  offp : ∀ i ∈ KFW.pT, σ i = none
  lt : ∀ i v, σ i = some v → i.val < 56
  hK : σ vK = some (K : ℤ)
  ht : σ vT = some (t : ℤ)
  hS : σ vS = some (S0 : ℤ)
  hr : σ vR = some (r : ℤ)
  hH : σ vH = some (H : ℤ)
  hk : σ vk = some (E : ℤ)
  hE : σ vE = some (e : ℤ)
  hB : σ vB = some (B : ℤ)
  hX : σ vX = some ((c.G E : ℕ) : ℤ)

/-- The registers of a node on `E` bits (`F = E/m`, `B/W` blocks per role). -/
structure NodeRH (c : Cfg) (σ : Fin HS → Option ℤ) (K t S0 r H E e B : ℕ) : Prop where
  lev : LevRH c σ K t S0 r H E e B
  hF : σ vF = some ((c.m * (E / c.m) : ℕ) : ℤ)
  gF : σ wF = some ((E / c.m : ℕ) : ℤ)
  gB : σ wB = some ((B / c.W : ℕ) : ℤ)
  gR0 : σ wR0 = some ((S0 * r : ℕ) : ℤ)
  gL : σ wL = some ((nN (B / c.W) t S0 * r : ℕ) : ℤ)
  gV : σ wV = some ((2 * (B / c.W * (S0 * r * 2 ^ t)) : ℕ) : ℤ)
  gKF : σ wKF = some ((K * (E / c.m) : ℕ) : ℤ)
  g1 : σ w1 = some 1
  g21 : σ 21 = some ((2 * (c.T * (nN (B / c.W) t S0 * r)) : ℕ) : ℤ)
  g23 : σ 23 = some ((2 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ)
  g25 : σ 25 = some ((B * 2 ^ t * S0 * r : ℕ) : ℤ)
  g26 : σ 26 = some ((2 : ℤ) ^ δv c E)

end IntMul.Kappa.R6.IL3H

end

