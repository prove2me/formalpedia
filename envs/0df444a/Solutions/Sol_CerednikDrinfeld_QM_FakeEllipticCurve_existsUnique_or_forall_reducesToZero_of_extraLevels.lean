theorem exists_levelSubmodule
    (ℓ : ℕ) [Fact ℓ.Prime]
    (φ : ↥Λ →ₗ[ℤ] Matrix (Fin 2) (Fin 2) (ZMod ℓ)) (hφsurj : Function.Surjective φ)
    (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ))
    [inst : Module (Matrix (Fin 2) (Fin 2) (ZMod ℓ)) ↥(TorsPts E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) ℓ)]
    (hinst : ∀ (m : ↥Λ) (v : ↥(TorsPts E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) ℓ)),
      (φ m) • v = TorsPts.torsAct E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) ℓ m v)
    (K : E.ExtraLevel ℓ) :
    ∃ SK : Submodule (Matrix (Fin 2) (Fin 2) (ZMod ℓ)) ↥(TorsPts E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) ℓ),
      (∀ v : ↥(TorsPts E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) ℓ),
          v ∈ SK ↔ FactorsThrough K.levK (Pts.val E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) (v : Pts E (𝟙 _)))) ∧
      Nat.card ↥SK = ℓ ^ 2 := by
  let SK : Submodule (Matrix (Fin 2) (Fin 2) (ZMod ℓ)) ↥(TorsPts E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) ℓ) :=
    { carrier := {v | FactorsThrough K.levK (Pts.val E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) (v : Pts E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))))}
      zero_mem' := K.levK_one (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))
      add_mem' := fun {v w} hv hw => (K.levK_sub (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) _ _ hv hw).1
      smul_mem' := fun r {v} hv => by
        obtain ⟨m, rfl⟩ := hφsurj r
        show FactorsThrough K.levK (Pts.val E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) ((φ m • v : ↥(TorsPts E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) ℓ)) : Pts E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))))
        rw [hinst m v, TorsPts.coe_torsAct, Pts.actHom_apply]
        exact K.levK_stable m (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) _ hv }
  refine ⟨SK, fun v => Iff.rfl, ?_⟩
  have hℓ : ((ℓ : ℕ) : AlgebraicClosure ℚ) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero
  rw [← RedKer.natCard_extraLevelPts E ℓ K hℓ]
  apply Nat.card_congr
  exact
    { toFun := fun v => ⟨Pts.val E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) (v.1 : Pts E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))))), v.2⟩
      invFun := fun P => ⟨⟨Pts.of E (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) P.1, K.levK_torsion (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) P.1 P.2⟩, P.2⟩
      left_inv := fun v => rfl
      right_inv := fun P => rfl }

end External
