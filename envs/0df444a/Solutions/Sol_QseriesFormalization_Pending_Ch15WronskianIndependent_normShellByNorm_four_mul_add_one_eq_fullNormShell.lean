  intro z
  constructor
  · intro hz
    rw [normShellByNorm, Finset.mem_filter] at hz
    rcases hz with ⟨_hbox, hnorm⟩
    have hnorm' : z.1 ^ 2 + z.2 ^ 2 = 4 * (N : ℤ) + 1 := by
