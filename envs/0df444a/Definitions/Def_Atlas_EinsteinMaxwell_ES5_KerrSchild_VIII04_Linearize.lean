/-- The magnetic operator `L b = (P b')' - V b`, `P = N0/R`, `V = 1/R + 4Q²/R³`. -/
noncomputable def Lop (Rh Ri Q : ℝ) (b : ℝ → ℝ) (R : ℝ) : ℝ :=
  deriv (fun s => Pc Rh Ri s * deriv b s) R - Vc Q R * b R

