namespace CLRS.GraphTraversal

/-- A finite directed multigraph. Each list position is one adjacency occurrence;
parallel arcs and self-loops are allowed. Rows outside the vertex range are ignored. -/
structure Graph where
  size : Nat
  neighbors : Nat → List Nat
  bounded : ∀ u, u < size → ∀ v ∈ neighbors u, v < size

def Vertex (g : Graph) (v : Int) : Prop := 0 ≤ v ∧ v < (g.size : Int)

def Edge (g : Graph) (u v : Int) : Prop :=
  Vertex g u ∧ Vertex g v ∧ v.toNat ∈ g.neighbors u.toNat

/-- Input size counts adjacency occurrences, including parallel arcs. -/
def edgeCount (g : Graph) : Nat :=
  ((List.range g.size).map fun u => (g.neighbors u).length).sum

/-- A path of exactly the stated number of edges; vertices may repeat. -/
inductive Walk (g : Graph) : Nat → Int → Int → Prop where
  | zero (v : Int) : Vertex g v → Walk g 0 v v
  | cons {length : Nat} {u v w : Int} :
      Edge g u v → Walk g length v w → Walk g (length + 1) u w

def Reachable (g : Graph) (u v : Int) : Prop := ∃ length, Walk g length u v

def Shortest (g : Graph) (u v : Int) (distance : Nat) : Prop :=
  Walk g distance u v ∧ ∀ length, Walk g length u v → distance ≤ length

def StronglyConnected (g : Graph) (u v : Int) : Prop :=
  Reachable g u v ∧ Reachable g v u

/-- The finite graph represented by allocated, read-only arrays of arrays.
Only each row's declared prefix is meaningful; rows are allowed to alias. -/
def GraphRep (heap : Heap) (ref : ObjectRef) (g : Graph) : Prop :=
  Algo.graph_input.Algo2LeanGenerated.is_UnweightedGraph heap ref ∧
  Algo.graph_input.Algo2LeanGenerated.field_UnweightedGraph_size heap ref = some (g.size : Int) ∧
  ∃ adj degree,
    Algo.graph_input.Algo2LeanGenerated.field_UnweightedGraph_adj heap ref = some adj ∧
    Algo.graph_input.Algo2LeanGenerated.field_UnweightedGraph_degree heap ref = some degree ∧
    Algo.graph_input.Algo2LeanGenerated.seq_Seq_Int.valid heap adj ∧ degree < heap.nextRef ∧
    ∀ u : Nat, u < g.size →
      heap.read degree (u : Int) = ((g.neighbors u).length : Int) ∧
      ∃ row,
        Algo.graph_input.Algo2LeanGenerated.seq_Seq_Int.get heap adj (u : Int) = some row ∧
        row < heap.nextRef ∧
        ∀ j : Nat, j < (g.neighbors u).length →
          heap.read row (j : Int) = ((g.neighbors u)[j]! : Int)

/-- All initially allocated caller storage survives; new storage may be allocated.
Costs are increments from the caller's actual clocks, without resetting them. -/
structure Preserves (before after : Heap) : Prop where
  sequences : ∀ ref, ref < before.nextRef → after.read ref = before.read ref
  objects : ∀ ref, ref < before.nextObject → after.objects ref = before.objects ref
  collections : ∀ ref, ref < before.nextCollection → after.collections ref = before.collections ref
  sequenceAllocation : before.nextRef ≤ after.nextRef
  objectAllocation : before.nextObject ≤ after.nextObject
  collectionAllocation : before.nextCollection ≤ after.nextCollection
  workMonotone : before.clocks "graph_work" ≤ after.clocks "graph_work"
  otherClocks : ∀ name, name ≠ "graph_work" → after.clocks name = before.clocks name

def work (before after : Heap) : Nat := Heap.cost before after "graph_work"

def FreshObject (before after : Heap) (result : ObjectRef) : Prop :=
  before.nextObject ≤ result ∧ result < after.nextObject

def FreshArrays (before after : Heap) (refs : List SeqRef) : Prop :=
  refs.Pairwise (fun a b => a ≠ b) ∧
  ∀ ref ∈ refs, before.nextRef ≤ ref ∧ ref < after.nextRef

/-- Every vertex occurs exactly once in the finite sequence prefix. -/
def VertexOrder (g : Graph) (order : Seq) : Prop :=
  ∃ values : List Int,
    values.Perm ((List.range g.size).map Int.ofNat) ∧
    ∀ j : Nat, j < g.size → order (j : Int) = values[j]!

/-- Reverse every edge while retaining its multiplicity. Adjacency row order may change. -/
def IsTranspose (g transpose : Graph) : Prop :=
  transpose.size = g.size ∧
  ∀ u v : Nat, u < g.size → v < g.size →
    (transpose.neighbors u).count v = (g.neighbors v).count u

end CLRS.GraphTraversal


