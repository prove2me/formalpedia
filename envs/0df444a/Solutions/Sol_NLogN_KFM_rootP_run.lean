theorem lpSt_G_a (s : IState HS) (i a : Fin HS) (La : List Item) (N k : ℕ) (c : ℤ) :
    (lpSt s i a La N k c).G a = .int c :: La := by
  simp [lpSt, IState.upd_G]

theorem lpSt_G_ne (s : IState HS) (i a : Fin HS) (La : List Item) (N k : ℕ) (c : ℤ) (j : Fin HS)
    (hi : j ≠ i) (ha : j ≠ a) : (lpSt s i a La N k c).G j = s.G j := by
