namespace Compression

open scoped BigOperators

def smallProxyLeft {n : ℕ} (D : ℕ) (a : Fin n → ℤ) : Fin (n+1) → ℚ :=
  Fin.cases (D : ℚ) (fun i => (a i : ℚ))

def smallProxyRight {n : ℕ} (c : ℤ) (grid : Fin n → ℤ) : Fin (n+1) → ℚ :=
  Fin.cases (c : ℚ) (fun i => (grid i : ℚ))

