/-- Rewriting both the function and the derivative of a `HasDerivAt` statement. -/
theorem hasDerivAt_of_congr {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G] {f₁ f : ℝ → G} {d d₁ : G}
    (hf : HasDerivAt f d 0) (h1 : ∀ ε, f₁ ε = f ε) (h2 : d = d₁) : HasDerivAt f₁ d₁ 0 := by
  rw [show f₁ = f from funext h1, ← h2]; exact hf

namespace NPFamily

variable {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ} {W : Set (ℝ × Pt 4)}
  {h : Metric 4} {f : TwoForm 4} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}

variable (hF : NPFamily g gi F E Θ W) (ht : NPTangent g F E W h f B) {x : Pt 4} (hx : ((0 : ℝ), x) ∈ W)
include hF ht hx

theorem hasDerivAt_riem (a b c d : Fin 4) :
    HasDerivAt (fun ε => riem (g ε) (gi ε) a b c d x) (riemVar (g 0) (gi 0) h a b c d x) 0 := by
  have hc := fun a b c => hF.fam.hasDerivAt_christoffel ht.tangent hx a b c
  have hp := fun i a b c => hF.fam.hasDerivAt_pd_christoffel ht.tangent hx i a b c
  have := ((hp c a d b).sub (hp d a c b)).add (HasDerivAt.fun_sum (u := Finset.univ) fun e _ =>
    (((hc a c e).mul (hc e d b)).sub ((hc a d e).mul (hc e c b))))
  refine hasDerivAt_of_congr this (fun ε => by simp only [riem_expand]; rfl) ?_
  simp only [riemVar]

end NPFamily

end ExactVacuumAtlas.EinsteinMaxwell.NP
