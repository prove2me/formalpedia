open CircuitLowerBound
open ENP Groundwork
open CircuitLowerBound.Parse
namespace CircuitLowerBound.Parse
theorem _root_.solution {W : ℕ} {g : GateD} (h1 : g.2.1 < 2 ^ W) (h2 : g.2.2 < 2 ^ W) : gateOfW W (gateW W g) = g := by
  obtain ⟨⟨b0, b1, b2, b3⟩, i, j⟩ := g
  have e1 : ((gateW W ((b0, b1, b2, b3), i, j)).drop 4).take W = toWord W i := by
    simp [gateW]
  have e2 : (gateW W ((b0, b1, b2, b3), i, j)).drop (4 + W) = toWord W j := by
    rw [← List.drop_drop]
    simp [gateW]
  unfold gateOfW
  rw [e1, e2, ofWord_toWord h1, ofWord_toWord h2]
  simp [gateW]
end CircuitLowerBound.Parse
