            ∃ (L : Type) (_ : CommRing L) (_ : Algebra ((D) ⧸ Ideal.span {algebraMap C (D) (algebraMap 𝒪 C π)}) L) (_ : IsLocalization.Away (g k) L) (_ : Algebra C L)
              (_ : IsScalarTower C ((D) ⧸ Ideal.span {algebraMap C (D) (algebraMap 𝒪 C π)}) L) (_ : Algebra 𝒪 L) (_ : IsScalarTower 𝒪 C L)
              (h0 : algebraMap C L (algebraMap 𝒪 C π) = 0)
              (v v' : FakeEllipticCurve.WithFullLevel Λ N n L)
              (ϱ : FakeEllipticCurve.Rigidification r π A₀ ((IsScalarTower.toAlgHom 𝒪 C L).comp ψ) v.1)
              (ϱ' : FakeEllipticCurve.Rigidification r π A₀ ((IsScalarTower.toAlgHom 𝒪 C L).comp ψ) v'.1)
              (hϱ : ϱ.d = d i) (hϱ' : ϱ'.d = d j)
              (i₀ : v.1.A ≅ v'.1.A) (hi : i₀.hom ≫ v'.1.f = v.1.f) (_ : FakeEllipticCurve.WithFullLevel.IsoVia v v' i₀ hi)
              (_ : (∃ (ib : ϱ.Eb.A ⟶ ϱ'.Eb.A) (_ : ib ≫ ϱ'.gb = ϱ.gb ≫ i₀.hom) (_ : ib ≫ ϱ'.Eb.f = ϱ.Eb.f)
                  (uA : ϱ'.Ab.A ⟶ ϱ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ϱ.Ab ϱ'.Ab uA) (_ : uA ≫ ϱ.gA = ϱ'.gA)
                  (i₁ j₁ : ℕ),
                  ib ≫ ϱ'.φ ≫ uA ≫ ϱ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ϱ.φ ≫ ϱ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩)),
              (ptX (d i) L _ rfl v ϱ hϱ h0).1 = Spec.map (CommRingCat.ofHom (algebraMap ((D) ⧸ Ideal.span {algebraMap C (D) (algebraMap 𝒪 C π)}) L)) ≫ (Spec.map (CommRingCat.ofHom τ₁) ≫ x i) ∧
                (ptX (d j) L _ rfl v' ϱ' hϱ' h0).1 = Spec.map (CommRingCat.ofHom (algebraMap ((D) ⧸ Ideal.span {algebraMap C (D) (algebraMap 𝒪 C π)}) L)) ≫ (Spec.map (CommRingCat.ofHom τ₂) ≫ x j))) :
    ∃ (e : ℕ) (x₀ : Spec (CommRingCat.of ((A) ⧸ Ideal.span {algebraMap C (A) (algebraMap 𝒪 C π)})) ⟶ X e)
      (_ : x₀ ≫ ξ e = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {algebraMap C (A) (algebraMap 𝒪 C π)}))) ≫ t₀),
      ∀ (i : Fin m) (τ : ((A) ⧸ Ideal.span {algebraMap C (A) (algebraMap 𝒪 C π)}) →+* ((B i) ⧸ Ideal.span {algebraMap C (B i) (algebraMap 𝒪 C π)}))
        (_ : τ.comp (Ideal.Quotient.mk _) = (Ideal.Quotient.mk _).comp (algebraMap A (B i))),
        (∃ (mL : ℕ) (g : Fin mL → ((B i) ⧸ Ideal.span {algebraMap C (B i) (algebraMap 𝒪 C π)})), Ideal.span (Set.range g) = ⊤ ∧
          ∀ k : Fin mL,
            ∃ (L : Type) (_ : CommRing L) (_ : Algebra ((B i) ⧸ Ideal.span {algebraMap C (B i) (algebraMap 𝒪 C π)}) L) (_ : IsLocalization.Away (g k) L) (_ : Algebra C L)
              (_ : IsScalarTower C ((B i) ⧸ Ideal.span {algebraMap C (B i) (algebraMap 𝒪 C π)}) L) (_ : Algebra 𝒪 L) (_ : IsScalarTower 𝒪 C L)
              (h0 : algebraMap C L (algebraMap 𝒪 C π) = 0)
              (v v' : FakeEllipticCurve.WithFullLevel Λ N n L)
              (ϱ : FakeEllipticCurve.Rigidification r π A₀ ((IsScalarTower.toAlgHom 𝒪 C L).comp ψ) v.1)
              (ϱ' : FakeEllipticCurve.Rigidification r π A₀ ((IsScalarTower.toAlgHom 𝒪 C L).comp ψ) v'.1)
              (hϱ : ϱ.d = e) (hϱ' : ϱ'.d = d i)
              (i₀ : v.1.A ≅ v'.1.A) (hi : i₀.hom ≫ v'.1.f = v.1.f) (_ : FakeEllipticCurve.WithFullLevel.IsoVia v v' i₀ hi)
              (_ : (∃ (ib : ϱ.Eb.A ⟶ ϱ'.Eb.A) (_ : ib ≫ ϱ'.gb = ϱ.gb ≫ i₀.hom) (_ : ib ≫ ϱ'.Eb.f = ϱ.Eb.f)
                  (uA : ϱ'.Ab.A ⟶ ϱ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ϱ.Ab ϱ'.Ab uA) (_ : uA ≫ ϱ.gA = ϱ'.gA)
                  (i₁ j₁ : ℕ),
                  ib ≫ ϱ'.φ ≫ uA ≫ ϱ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ϱ.φ ≫ ϱ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩)),
              (ptX (e) L _ rfl v ϱ hϱ h0).1 = Spec.map (CommRingCat.ofHom (algebraMap ((B i) ⧸ Ideal.span {algebraMap C (B i) (algebraMap 𝒪 C π)}) L)) ≫ (Spec.map (CommRingCat.ofHom τ) ≫ x₀) ∧
                (ptX (d i) L _ rfl v' ϱ' hϱ' h0).1 = Spec.map (CommRingCat.ofHom (algebraMap ((B i) ⧸ Ideal.span {algebraMap C (B i) (algebraMap 𝒪 C π)}) L)) ≫ (x i)) := by
  classical

  let ϖ : C := algebraMap 𝒪 C π
  let Abar : Type := A ⧸ GPShift.Wrap.I ϖ A
  let Bbar : Fin m → Type := fun i => B i ⧸ GPShift.Wrap.I ϖ (B i)
  letI instAB : ∀ i, Algebra Abar (Bbar i) := fun i => GPShift.Wrap.algebraQuot ϖ A (B i)
  haveI instTB : ∀ i, IsScalarTower C Abar (Bbar i) := fun i => GPShift.Wrap.isScalarTower_quot ϖ A (B i)
  let fbar : Fin m → Abar := fun i => Ideal.Quotient.mk _ (f i)
  haveI instLB : ∀ i, IsLocalization.Away (fbar i) (Bbar i) := fun i => GPShift.Wrap.away_quot ϖ A (B i) (f i)
  have hA0 : algebraMap C Abar (algebraMap 𝒪 C π) = 0 := by
    rw [← Ideal.Quotient.mk_algebraMap]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  have hfbar : Ideal.span (Set.range fbar) = ⊤ := by
    have : Set.range fbar = Ideal.Quotient.mk (GPShift.Wrap.I ϖ A) '' Set.range f := by rw [← Set.range_comp]; rfl
    rw [this, ← Ideal.map_span, hf, Ideal.map_top]
  have hxC : ∀ i, x i ≫ ξ (d i) ≫ Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
      Spec.map (CommRingCat.ofHom (algebraMap C (Bbar i))) := by
    intro i
    rw [← Category.assoc, hx i, Category.assoc, ht i, ← Spec.map_comp, ← CommRingCat.ofHom_comp, Ideal.Quotient.mk_comp_algebraMap]

  let D : Fin m → Fin m → Type := fun i j => Localization.Away (f i * f j)
  let σR : ∀ i j, B i →ₐ[A] D i j := fun i j =>
    { toRingHom := IsLocalization.Away.awayToAwayRight (S := B i) (f i) (f j) (P := D i j)
      commutes' := fun a => IsLocalization.Away.awayToAwayRight_eq (S := B i) (f i) (f j) (P := D i j) a }
  let σL : ∀ i j, B j →ₐ[A] D i j := fun i j =>
    { toRingHom := IsLocalization.Away.awayToAwayLeft (S := B j) (f j) (f i) (P := D i j)
      commutes' := fun a => IsLocalization.Away.awayToAwayLeft_eq (S := B j) (f j) (f i) (P := D i j) a }
  have hleσ : ∀ (i j : Fin m) {S : Type} [CommRing S] [Algebra A S] [Algebra C S] [IsScalarTower C A S] (σ : S →ₐ[A] D i j),
      GPShift.Wrap.I ϖ S ≤ (GPShift.Wrap.I ϖ (D i j)).comap (σ : S →+* D i j) := by
    intro i j S _ _ _ _ σ
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, IsScalarTower.algebraMap_apply C A S]
    show σ (algebraMap A S (algebraMap C A ϖ)) ∈ GPShift.Wrap.I ϖ (D i j)
    rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
    exact Ideal.subset_span rfl
  let Dbar : Fin m → Fin m → Type := fun i j => D i j ⧸ GPShift.Wrap.I ϖ (D i j)
  letI instAD : ∀ i j, Algebra Abar (Dbar i j) := fun i j => GPShift.Wrap.algebraQuot ϖ A (D i j)
  haveI instTD : ∀ i j, IsScalarTower C Abar (Dbar i j) := fun i j => GPShift.Wrap.isScalarTower_quot ϖ A (D i j)
  haveI instLD : ∀ i j, IsLocalization.Away (fbar i * fbar j) (Dbar i j) := fun i j => by
    have := GPShift.Wrap.away_quot ϖ A (D i j) (f i * f j)
    rwa [map_mul] at this

  have red : ∀ (i j : Fin m) {S : Type} [CommRing S] [Algebra A S] [Algebra C S] [IsScalarTower C A S] (σ : S →ₐ[A] D i j),
      letI := GPShift.Wrap.algebraQuot ϖ A S
      ∀ a : Abar, Ideal.quotientMap _ (σ : S →+* D i j) (hleσ i j σ) (algebraMap Abar (S ⧸ GPShift.Wrap.I ϖ S) a) =
        algebraMap Abar (Dbar i j) a := by
    intro i j S _ _ _ _ σ a
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
    show Ideal.quotientMap _ _ _ (Ideal.quotientMap _ _ _ (Ideal.Quotient.mk _ a)) = Ideal.quotientMap _ _ _ (Ideal.Quotient.mk _ a)
    rw [Ideal.quotientMap_mk, Ideal.quotientMap_mk, Ideal.quotientMap_mk]
    exact congrArg (Ideal.Quotient.mk _) (σ.commutes a)
  let τR : ∀ i j, Bbar i →ₐ[Abar] Dbar i j := fun i j =>
    { toRingHom := Ideal.quotientMap _ (σR i j : B i →+* D i j) (hleσ i j (σR i j)), commutes' := red i j (σR i j) }
  let τL : ∀ i j, Bbar j →ₐ[Abar] Dbar i j := fun i j =>
    { toRingHom := Ideal.quotientMap _ (σL i j : B j →+* D i j) (hleσ i j (σL i j)), commutes' := red i j (σL i j) }
  have hoverC : ∀ (i j : Fin m),
