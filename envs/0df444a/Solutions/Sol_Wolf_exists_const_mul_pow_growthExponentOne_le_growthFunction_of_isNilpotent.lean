/-!
# Chou §3, p. 399: the growth rate of a finitely generated group

Milnor's observation that `|B(n)|^{1/n}` converges, and Wolf's observation that exponential
growth does not depend on the choice of finite generating set.  Both come from Fekete's lemma
applied to the subadditive sequence `n ↦ log |B(n)|`: Mathlib's `Subadditive.lim` is *defined*
as the infimum of `u n / n` over `n ≥ 1`, so the limit `v` satisfies `v ^ n ≤ |B(n)|` for
**every** `n`, not merely eventually — which is what the `∀ n` in `HasExponentialGrowth` needs.
-/

namespace Chou
namespace Lib

open Chou

variable {G : Type*} [Group G]

/-! ### Elementary properties of word balls -/

lemma one_mem_wordBall (S : Set G) (n : ℕ) : (1 : G) ∈ wordBall S n :=
  ⟨[], by simp, by simp, by simp⟩

lemma wordBall_mono (S : Set G) {m n : ℕ} (h : m ≤ n) : wordBall S m ⊆ wordBall S n := by
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact ⟨l, hlen.trans h, hmem, rfl⟩

lemma mul_mem_wordBall {S : Set G} {a b : G} {m n : ℕ} (ha : a ∈ wordBall S m)
    (hb : b ∈ wordBall S n) : a * b ∈ wordBall S (m + n) := by
  obtain ⟨l₁, h₁, hm₁, rfl⟩ := ha
  obtain ⟨l₂, h₂, hm₂, rfl⟩ := hb
  refine ⟨l₁ ++ l₂, ?_, ?_, ?_⟩
  · simpa using Nat.add_le_add h₁ h₂
  · intro x hx
    rcases List.mem_append.1 hx with h | h
    · exact hm₁ x h
    · exact hm₂ x h
  · simp

lemma inv_mem_wordBall {S : Set G} {a : G} {n : ℕ} (ha : a ∈ wordBall S n) :
    a⁻¹ ∈ wordBall S n := by
  obtain ⟨l, hlen, hmem, rfl⟩ := ha
  refine ⟨(l.map fun x => x⁻¹).reverse, ?_, ?_, (List.prod_inv_reverse l).symm⟩
  · simpa using hlen
  · intro x hx
    simp only [List.mem_reverse, List.mem_map] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    rcases hmem y hy with h | h
    · exact Or.inr (by simpa using h)
    · exact Or.inl h

/-- Every element of the subgroup generated by `T` lies in some `T`-ball. -/
lemma exists_mem_wordBall_of_mem_closure {T : Set G} {g : G} (hg : g ∈ Subgroup.closure T) :
    ∃ m : ℕ, g ∈ wordBall T m := by
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact ⟨1, [x], by simp, by simpa using Or.inl hx, by simp⟩
  | one => exact ⟨0, one_mem_wordBall T 0⟩
  | mul x y _ _ ihx ihy =>
      obtain ⟨m, hm⟩ := ihx
      obtain ⟨n, hn⟩ := ihy
      exact ⟨m + n, mul_mem_wordBall hm hn⟩
  | inv x _ ih =>
      obtain ⟨m, hm⟩ := ih
      exact ⟨m, inv_mem_wordBall hm⟩

/-- Comparison of balls for two generating sets: if every element of `T` is an `S`-word of
length at most `k`, then the `T`-ball of radius `n` sits inside the `S`-ball of radius `k * n`. -/
lemma wordBall_subset_wordBall_of_forall_mem {S T : Set G} {k : ℕ}
    (h : ∀ t ∈ T, t ∈ wordBall S k) (n : ℕ) : wordBall T n ⊆ wordBall S (k * n) := by
  have hstep : ∀ x : G, (x ∈ T ∨ x⁻¹ ∈ T) → x ∈ wordBall S k := by
    rintro x (hx | hx)
    · exact h x hx
    · simpa using inv_mem_wordBall (h _ hx)
  have main : ∀ l : List G, (∀ x ∈ l, x ∈ wordBall S k) →
      l.prod ∈ wordBall S (k * l.length) := by
    intro l
    induction l with
    | nil => intro _; simpa using one_mem_wordBall S 0
    | cons a t ih =>
        intro hl
        have harith : k * (a :: t).length = k + k * t.length := by
          simp only [List.length_cons]; ring
        rw [List.prod_cons, harith]
        exact mul_mem_wordBall (hl a (by simp)) (ih fun x hx => hl x (List.mem_cons_of_mem _ hx))
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact wordBall_mono S (Nat.mul_le_mul le_rfl hlen) (main l fun x hx => hstep x (hmem x hx))

/-! ### Finiteness and cardinality of balls -/

/-- For a finite generating set the balls are finite. -/
lemma finite_wordBall (S : Finset G) (n : ℕ) : (wordBall (S : Set G) n).Finite := by
  classical
  set T : Finset G := S ∪ S.image (fun x => x⁻¹) with hT
  have key : wordBall (S : Set G) n ⊆
      (fun l : List T => (l.map Subtype.val).prod) '' {l : List T | l.length ≤ n} := by
    rintro g ⟨l, hlen, hmem, rfl⟩
    have hmemT : ∀ x ∈ l, x ∈ T := by
      intro x hx
      rcases hmem x hx with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ (Finset.mem_image.2 ⟨x⁻¹, h, by simp⟩)
    refine ⟨l.attach.map (fun x => (⟨x.1, hmemT x.1 x.2⟩ : T)), ?_, ?_⟩
    · simpa using hlen
    · simp
  exact Set.Finite.subset (Set.Finite.image _ (List.finite_length_le _ n)) key

lemma one_le_card_wordBall (S : Finset G) (n : ℕ) : 1 ≤ Nat.card (wordBall (S : Set G) n) := by
  rw [Nat.card_coe_set_eq]
  exact (Set.ncard_pos (finite_wordBall S n)).2 ⟨1, one_mem_wordBall _ _⟩

lemma card_wordBall_le_of_subset {S T : Finset G} {m n : ℕ}
    (h : wordBall (S : Set G) m ⊆ wordBall (T : Set G) n) :
    Nat.card (wordBall (S : Set G) m) ≤ Nat.card (wordBall (T : Set G) n) := by
  simp only [Nat.card_coe_set_eq]
  exact Set.ncard_le_ncard h (finite_wordBall T n)

/-! ### Fekete's lemma applied to `log |B(n)|` -/

/-! ### The two theorems -/

/-- Every `S`-ball sits inside a `T`-ball of a uniformly rescaled radius, when `T` generates. -/
lemma exists_wordBall_subset (S T : Finset G) (hT : Subgroup.closure (T : Set G) = ⊤) :
    ∃ k : ℕ, 0 < k ∧ ∀ n : ℕ, wordBall (S : Set G) n ⊆ wordBall (T : Set G) (k * n) := by
  classical
  have H : ∀ s ∈ S, ∃ m : ℕ, s ∈ wordBall (T : Set G) m := fun s _ =>
    exists_mem_wordBall_of_mem_closure (by rw [hT]; trivial)
  choose f hf using H
  refine ⟨(S.attach.sup fun s => f s.1 s.2) + 1, Nat.succ_pos _, fun n => ?_⟩
  refine wordBall_subset_wordBall_of_forall_mem (fun s hs => ?_) n
  have hs' : s ∈ S := hs
  refine wordBall_mono _ ?_ (hf s hs')
  have hsup : f s hs' ≤ S.attach.sup fun s : {x // x ∈ S} => f s.1 s.2 :=
    Finset.le_sup (f := fun s : {x // x ∈ S} => f s.1 s.2) (Finset.mem_attach S ⟨s, hs'⟩)
  omega

end Lib
end Chou

/-!
# Finite generation: the two directions across a finite-index subgroup

Mathlib has Schreier's lemma `Subgroup.fg_of_index_ne_zero`, that a finite-index subgroup of a
finitely generated group is finitely generated.  Wolf's Proposition 4.1 needs the converse as
well, that finite generation passes *up* from a finite-index subgroup, and the standard
"generators of the quotient together with the kernel" principle.
-/

namespace Wolf
namespace Lib

open Subgroup

/-- Transport finite generation along an isomorphism. -/
theorem fg_of_mulEquiv {A B : Type*} [Group A] [Group B] [Group.FG A] (e : A ≃* B) :
    Group.FG B :=
  Group.fg_of_surjective (f := (e : A →* B)) e.surjective

end Lib
end Wolf

/-!
# The lower central series: plumbing

The terms `Γ_k` of the lower central series, the canonical surjection `Γ_k → Γ_k/Γ_{k+1}` of the
definition bundle, and the consequence that a finitely generated factor is witnessed by finitely
many elements of `Γ_k` together with `Γ_{k+1}`.

These were part of the nilpotent-groups module, which imports Wolf's Theorem 3.2; they are
separated out because a solution *of* Theorem 3.2 needs them and cannot import it.
-/

namespace Wolf
namespace Lib

open Subgroup

variable {Γ : Type*} [Group Γ]

/-- The canonical surjection `Γ_k → Γ_k/Γ_{k+1}` of the definition bundle, which factors
through the abelianization of `Γ_k` because `⁅Γ_k, Γ_k⁆ ≤ Γ_{k+1}`. -/
noncomputable def toLcsFactor (k : ℕ) :
    ↥(MilnorWolf.lcs Γ k) →* MilnorWolf.lcsFactor Γ k :=
  (QuotientGroup.mk' _).comp Abelianization.of

theorem toLcsFactor_surjective (k : ℕ) : Function.Surjective (toLcsFactor (Γ := Γ) k) :=
  (QuotientGroup.mk'_surjective _).comp (fun x => Quot.inductionOn x fun y => ⟨y, rfl⟩)

end Lib
end Wolf

/-!
# Words modulo a normal subgroup

Wolf's inductions in Theorem 3.2 (p. 425) never say that an element *is* a short word on the
generating set; they say it is one **modulo** the next term of the lower central series.  This
module gives that notion a name and the closure properties the inductions use: the image in
`Γ ⧸ N` of the ball of radius `L`.

Working in the quotient rather than with an explicit discrepancy keeps the bookkeeping short —
products and inverses are then inherited from the ball itself, and the length adds because a
product of a word of length `≤ L` and one of length `≤ L'` is a word of length `≤ L + L'`.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib
open scoped commutatorElement

variable {Γ : Type*} [Group Γ]

/-- A power of a generator is a word of the corresponding length: `u ^ p` uses `|p|` letters. -/
theorem zpow_mem_wordBall {U : Set Γ} {u : Γ} (hu : u ∈ U) (p : ℤ) :
    u ^ p ∈ wordBall U p.natAbs := by
  by_cases hp : 0 ≤ p
  · refine ⟨List.replicate p.natAbs u, by simp, ?_, ?_⟩
    · intro x hx
      rw [List.eq_of_mem_replicate hx]
      exact Or.inl hu
    · rw [List.prod_replicate, ← zpow_natCast, Int.natAbs_of_nonneg hp]
  · refine ⟨List.replicate p.natAbs u⁻¹, by simp, ?_, ?_⟩
    · intro x hx
      rw [List.eq_of_mem_replicate hx]
      exact Or.inr (by simpa using hu)
    · rw [List.prod_replicate, ← zpow_natCast, ← zpow_neg_one, ← zpow_mul]
      congr 1
      omega

/-- The elements of `Γ ⧸ N` that are words of length `≤ L` on `U` modulo `N`. -/
def ballMod (U : Set Γ) (L : ℕ) (N : Subgroup Γ) [N.Normal] : Set (Γ ⧸ N) :=
  (QuotientGroup.mk : Γ → Γ ⧸ N) '' wordBall U L

variable {U : Set Γ} {N : Subgroup Γ} [N.Normal]

theorem mem_ballMod_of_mem_wordBall {L : ℕ} {g : Γ} (hg : g ∈ wordBall U L) :
    (QuotientGroup.mk g : Γ ⧸ N) ∈ ballMod U L N := ⟨g, hg, rfl⟩

theorem one_mem_ballMod (L : ℕ) : (1 : Γ ⧸ N) ∈ ballMod U L N :=
  ⟨1, one_mem_wordBall U L, rfl⟩

theorem ballMod_mono {L L' : ℕ} (h : L ≤ L') : ballMod U L N ⊆ ballMod U L' N := by
  rintro _ ⟨g, hg, rfl⟩
  exact ⟨g, wordBall_mono U h hg, rfl⟩

theorem mul_mem_ballMod {L L' : ℕ} {x y : Γ ⧸ N} (hx : x ∈ ballMod U L N)
    (hy : y ∈ ballMod U L' N) : x * y ∈ ballMod U (L + L') N := by
  obtain ⟨a, ha, rfl⟩ := hx
  obtain ⟨b, hb, rfl⟩ := hy
  exact ⟨a * b, mul_mem_wordBall ha hb, rfl⟩

theorem inv_mem_ballMod {L : ℕ} {x : Γ ⧸ N} (hx : x ∈ ballMod U L N) :
    x⁻¹ ∈ ballMod U L N := by
  obtain ⟨a, ha, rfl⟩ := hx
  exact ⟨a⁻¹, inv_mem_wordBall ha, rfl⟩

/-- The commutator of two elements that are short words modulo `N` is a short word modulo `N`,
of length the sum of twice each.  This is the shape Wolf's induction step produces. -/
theorem commutator_mem_ballMod {L L' : ℕ} {x y : Γ ⧸ N} (hx : x ∈ ballMod U L N)
    (hy : y ∈ ballMod U L' N) : ⁅x, y⁆ ∈ ballMod U (2 * (L + L')) N := by
  have h : ⁅x, y⁆ = x * y * x⁻¹ * y⁻¹ := rfl
  rw [h]
  have hcomp := mul_mem_ballMod
    (mul_mem_ballMod (mul_mem_ballMod hx hy) (inv_mem_ballMod hx)) (inv_mem_ballMod hy)
  exact ballMod_mono (by omega) hcomp

/-- A list of short words multiplies to a short word, the lengths adding.  Stated for a list
rather than a `Finset` product because the quotient `Γ ⧸ N` need not be commutative: only the
image of `Γ_k` in it is, and the induction never needs to reorder. -/
theorem list_prod_mem_ballMod {L : ℕ} (l : List (Γ ⧸ N))
    (h : ∀ x ∈ l, x ∈ ballMod U L N) : l.prod ∈ ballMod U (l.length * L) N := by
  induction l with
  | nil => simpa using one_mem_ballMod (U := U) (N := N) 0
  | cons c t ih =>
      have hc := h c (by simp)
      have ht := ih fun x hx => h x (by simp [hx])
      rw [List.prod_cons, List.length_cons]
      have hlen : (t.length + 1) * L = L + t.length * L := by ring
      rw [hlen]
      exact mul_mem_ballMod hc ht

end Lib
end Wolf

/-!
# Lemma 3.7: the commutator step

Wolf's computation on p. 428.  In `Δ = Γ/Γ_{k+2}` the factor `Γ_{k+1}/Γ_{k+2}` is central, so
the commutator is bilinear in each slot there; consequently `Γ_{k+1}/Γ_{k+2}` is generated by
the images of the commutators `⁅x, y⁆` with `x` running over a generating set of `Γ` and `y`
over a set whose image generates `Γ_k/Γ_{k+1}`.

This is the half of Lemma 3.7 that Wolf's proof really establishes, and it is needed on any
route to the lemma.  The other half — extracting from that generating family an *independent*
one consisting of commutators — is the step whose justification in the paper ("choose any
independent generating subset") does not follow from finite generation alone; see
`wolf/NOTES-lemma37-choice-gap.md`.
-/

namespace Wolf
namespace Lib

open scoped commutatorElement

variable {Γ : Type*} [Group Γ]

/-- `⁅a, b⁆` lies in `Γ_{k+1}` when `b` lies in `Γ_k`. -/
theorem commutatorElement_mem_lcs_succ {k : ℕ} (a : Γ) {b : Γ}
    (hb : b ∈ MilnorWolf.lcs Γ k) : ⁅a, b⁆ ∈ MilnorWolf.lcs Γ (k + 1) := by
  have h : ⁅a, b⁆ ∈ ⁅(⊤ : Subgroup Γ), MilnorWolf.lcs Γ k⁆ :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top a) hb
  rwa [Subgroup.commutator_comm] at h

/-! ### Bilinearity as a homomorphism

The membership lemmas above say that `⁅a, b⁆` *lands in* a subgroup lying above `Γ_{k+2}`.
Wolf's word-length induction in Theorem 3.2 needs more: that `⁅a, bᵖ⁆` and `⁅a, b⁆ᵖ` are *equal*
modulo `Γ_{k+2}`.  That is the statement that `b ↦ ⁅a, b⁆` is a homomorphism into
`Γ / Γ_{k+2}`, which is what the centrality of `Γ_{k+1}/Γ_{k+2}` really buys.
-/

/-- Conjugation is invisible modulo `Γ_{k+2}` on elements of `Γ_{k+1}`. -/
theorem mk_conj_eq_mk {k : ℕ} (g : Γ) {c : Γ} (hc : c ∈ MilnorWolf.lcs Γ (k + 1)) :
    (QuotientGroup.mk (g * c * g⁻¹) : Γ ⧸ MilnorWolf.lcs Γ (k + 2))
      = QuotientGroup.mk c := by
  rw [QuotientGroup.eq]
  have h2 : (g * c * g⁻¹)⁻¹ * c = ⁅g, c⁻¹⁆ := by group
  rw [h2]
  have h3 : ⁅g, c⁻¹⁆ ∈ ⁅(⊤ : Subgroup Γ), MilnorWolf.lcs Γ (k + 1)⁆ :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top g)
      ((MilnorWolf.lcs Γ (k + 1)).inv_mem hc)
  rwa [Subgroup.commutator_comm] at h3

/-- **Bilinearity in the second slot.**  For a fixed `a`, taking the commutator with `a` is a
homomorphism from `Γ_k` to `Γ / Γ_{k+2}`. -/
noncomputable def commutatorHom (a : Γ) (k : ℕ) :
    ↥(MilnorWolf.lcs Γ k) →* Γ ⧸ MilnorWolf.lcs Γ (k + 2) where
  toFun b := QuotientGroup.mk ⁅a, (b : Γ)⁆
  map_one' := by
    simp only [OneMemClass.coe_one, commutatorElement_one_right]
    rfl
  map_mul' b b' := by
    have hfac : ⁅a, (b : Γ) * (b' : Γ)⁆
        = ⁅a, (b : Γ)⁆ * ((b : Γ) * ⁅a, (b' : Γ)⁆ * (b : Γ)⁻¹) := by group
    show (QuotientGroup.mk ⁅a, ((b * b' : ↥(MilnorWolf.lcs Γ k)) : Γ)⁆ : Γ ⧸ _) = _
    rw [Subgroup.coe_mul, hfac, QuotientGroup.mk_mul,
      mk_conj_eq_mk (k := k) (b : Γ) (commutatorElement_mem_lcs_succ a b'.2)]

@[simp] theorem commutatorHom_apply (a : Γ) (k : ℕ) (b : ↥(MilnorWolf.lcs Γ k)) :
    commutatorHom a k b = QuotientGroup.mk ⁅a, (b : Γ)⁆ := rfl

/-- What the induction actually uses: `⁅a, bᵖ⁆ ≡ ⁅a, b⁆ᵖ` modulo `Γ_{k+2}`. -/
theorem mk_commutator_zpow {k : ℕ} (a : Γ) {b : Γ} (hb : b ∈ MilnorWolf.lcs Γ k) (p : ℤ) :
    (QuotientGroup.mk ⁅a, b ^ p⁆ : Γ ⧸ MilnorWolf.lcs Γ (k + 2))
      = QuotientGroup.mk ⁅a, b⁆ ^ p := by
  have h := map_zpow (commutatorHom a k) ⟨b, hb⟩ p
  have hc : (((⟨b, hb⟩ : ↥(MilnorWolf.lcs Γ k)) ^ p : ↥(MilnorWolf.lcs Γ k)) : Γ) = b ^ p := by
    push_cast
    rfl
  rw [commutatorHom_apply, commutatorHom_apply, hc] at h
  exact h

/-- Modulo `Γ_{k+2}`, the image of `Γ_{k+1}` is central. -/
theorem mk_commute_of_mem_lcs_succ {k : ℕ} {c : Γ} (hc : c ∈ MilnorWolf.lcs Γ (k + 1)) (g : Γ) :
    Commute (QuotientGroup.mk c : Γ ⧸ MilnorWolf.lcs Γ (k + 2)) (QuotientGroup.mk g) := by
  have h := mk_conj_eq_mk (k := k) g hc
  rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul, QuotientGroup.mk_inv] at h
  have h2 := congrArg (fun z => z * (QuotientGroup.mk g : Γ ⧸ MilnorWolf.lcs Γ (k + 2))) h
  simp only [inv_mul_cancel_right] at h2
  exact h2.symm

/-- **Bilinearity in the first slot.**  For `b` in `Γ_k`, taking the commutator with `b` is a
homomorphism from `Γ` to `Γ / Γ_{k+2}`.  Wolf's induction uses this together with the second-slot
version to spread an exponent `am` across the two arguments as `⁅aᵐ, bᵃ⁆`. -/
noncomputable def commutatorHomLeft {k : ℕ} {b : Γ} (hb : b ∈ MilnorWolf.lcs Γ k) :
    Γ →* Γ ⧸ MilnorWolf.lcs Γ (k + 2) where
  toFun a := QuotientGroup.mk ⁅a, b⁆
  map_one' := by
    simp only [commutatorElement_one_left]
    rfl
  map_mul' a a' := by
    have hfac : ⁅a * a', b⁆ = ⁅a, ⁅a', b⁆⁆ * (⁅a', b⁆ * ⁅a, b⁆) := by group
    have hmem : ⁅a, ⁅a', b⁆⁆ ∈ MilnorWolf.lcs Γ (k + 2) :=
      commutatorElement_mem_lcs_succ a (commutatorElement_mem_lcs_succ a' hb)
    show (QuotientGroup.mk ⁅a * a', b⁆ : Γ ⧸ _) = _
    rw [hfac, QuotientGroup.mk_mul, (QuotientGroup.eq_one_iff _).2 hmem, one_mul,
      QuotientGroup.mk_mul]
    exact mk_commute_of_mem_lcs_succ (k := k) (commutatorElement_mem_lcs_succ a' hb) ⁅a, b⁆

@[simp] theorem commutatorHomLeft_apply {k : ℕ} {b : Γ} (hb : b ∈ MilnorWolf.lcs Γ k) (a : Γ) :
    commutatorHomLeft hb a = QuotientGroup.mk ⁅a, b⁆ := rfl

/-- `⁅aᵖ, b⁆ ≡ ⁅a, b⁆ᵖ` modulo `Γ_{k+2}`. -/
theorem mk_commutator_zpow_left {k : ℕ} (a : Γ) {b : Γ} (hb : b ∈ MilnorWolf.lcs Γ k) (p : ℤ) :
    (QuotientGroup.mk ⁅a ^ p, b⁆ : Γ ⧸ MilnorWolf.lcs Γ (k + 2))
      = QuotientGroup.mk ⁅a, b⁆ ^ p := by
  have h := map_zpow (commutatorHomLeft hb) a p
  rw [commutatorHomLeft_apply, commutatorHomLeft_apply] at h
  exact h

/-- Wolf's step in one line: an exponent `s * p` on the commutator can be spread across the two
arguments as `⁅aˢ, bᵖ⁆`, which is what keeps the word length linear in `m`. -/
theorem mk_commutator_zpow_zpow {k : ℕ} (a : Γ) {b : Γ} (hb : b ∈ MilnorWolf.lcs Γ k) (s p : ℤ) :
    (QuotientGroup.mk ⁅a ^ s, b ^ p⁆ : Γ ⧸ MilnorWolf.lcs Γ (k + 2))
      = QuotientGroup.mk ⁅a, b⁆ ^ (s * p) := by
  have hbp : b ^ p ∈ MilnorWolf.lcs Γ k := (MilnorWolf.lcs Γ k).zpow_mem hb p
  rw [mk_commutator_zpow_left a hbp s, mk_commutator_zpow a hb p, ← zpow_mul, mul_comm]

/-- A factor from `Γ_k` in the second argument is invisible modulo `Γ_{k+1}`.  This is what lets
the induction replace `bᵖ` by the word representing it: the discrepancy lies in `Γ_k`, and the
commutator turns that into `Γ_{k+1}`. -/
theorem mk_commutator_mul_right {k : ℕ} (a B : Γ) {c : Γ} (hc : c ∈ MilnorWolf.lcs Γ k) :
    (QuotientGroup.mk ⁅a, B * c⁆ : Γ ⧸ MilnorWolf.lcs Γ (k + 1))
      = QuotientGroup.mk ⁅a, B⁆ := by
  have hfac : ⁅a, B * c⁆ = ⁅a, B⁆ * (B * ⁅a, c⁆ * B⁻¹) := by group
  have hmem : B * ⁅a, c⁆ * B⁻¹ ∈ MilnorWolf.lcs Γ (k + 1) :=
    Subgroup.Normal.conj_mem inferInstance _ (commutatorElement_mem_lcs_succ a hc) B
  rw [hfac, QuotientGroup.mk_mul, (QuotientGroup.eq_one_iff _).2 hmem, mul_one]

/-! ### Wolf's collection step

The mechanism behind (3.10), p. 430: "if the previously introduced word is `η = η₁ ⋯ η_s` with
`η_k` a word on `T_k`, then `η τ^{±1} = τ^{±1} η'` where `η'_k = ⁅η_{k-1}, τ^{∓1}⁆ η_k`."  In
other words, moving a generator past an element of `Γ_j` leaves that element where it was and
introduces a correction one level up.  Iterating this is what makes the exponent double. -/

end Lib
end Wolf

/-!
# Wolf's word-length induction, (3.8)

Wolf, p. 436: “If `|a| ≤ m^k`, then by induction on `k` the elements `y`, `y^m` and `y^a` are
expressible modulo `Γ_k` as words of length `≤ 8^{k-1} m` based on `T₀`; if `|am + b| ≤ m^{k+1}`
it follows that `z`, `z^m` and `z^{am+b}` are expressible modulo `Γ_{k+1}` as words of length
`≤ 8^k m` based on `T₀`.”

The induction takes the adapted families of Lemma 3.7 as data rather than importing that lemma,
so this module stands alone: all it needs is that the `k`-th family lies in `Γ_k`, that the
`0`-th lies in the generating set, and that each member of the `(k+1)`-st is a commutator of a
member of the `0`-th with a member of the `k`-th.

The step is Wolf's: split the exponent as `p = am + b` with `|b| ≤ m` and `|a| ≤ m^{k+1}`, and
spread it across the two arguments of the commutator, `z^{am} ≡ ⁅x^m, y^a⁆`.  That is what keeps
the length linear in `m`: `x^m` costs `m` letters and `y^a` costs `8^k m` by the inductive
hypothesis, so the commutator costs `2(m + 8^k m)`, and the leftover `z^b ≡ ⁅x, y^b⁆` costs
`2(1 + 8^k m)`.  The two together are at most `8^{k+1} m`, because `2m + 2 ≤ 4·8^k m` once
`m ≥ 1`.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib
open scoped commutatorElement

variable {Γ : Type*} [Group Γ]

/-- Division with remainder, in the form the induction needs: if `|p| ≤ M m` then `p = am + b`
with `|b| ≤ m` and `|a| ≤ M`. -/
theorem exists_quotient_decomposition {m : ℕ} (hm : 1 ≤ m) {M p : ℤ} (hp : |p| ≤ M * m) :
    ∃ a b : ℤ, p = a * m + b ∧ |b| ≤ m ∧ |a| ≤ M := by
  have hm0 : (0 : ℤ) < (m : ℤ) := by exact_mod_cast hm
  refine ⟨p / (m : ℤ), p % (m : ℤ), ?_, ?_, ?_⟩
  · have h := Int.mul_ediv_add_emod p (m : ℤ)
    have hc : (m : ℤ) * (p / (m : ℤ)) = (p / (m : ℤ)) * (m : ℤ) := mul_comm _ _
    linarith
  · have h1 : 0 ≤ p % (m : ℤ) := Int.emod_nonneg p (ne_of_gt hm0)
    have h2 : p % (m : ℤ) < (m : ℤ) := Int.emod_lt_of_pos p hm0
    rw [abs_of_nonneg h1]
    linarith
  · have hub : p / (m : ℤ) ≤ M := by
      have h := Int.ediv_le_ediv hm0 (le_of_abs_le hp)
      rwa [Int.mul_ediv_cancel _ (ne_of_gt hm0)] at h
    have hlb : -M ≤ p / (m : ℤ) := by
      have hle : -(M * (m : ℤ)) ≤ p := neg_le_of_abs_le hp
      have h := Int.ediv_le_ediv hm0 hle
      rwa [show -(M * (m : ℤ)) = (-M) * (m : ℤ) by ring,
        Int.mul_ediv_cancel _ (ne_of_gt hm0)] at h
    rw [abs_le]
    exact ⟨hlb, hub⟩

/-- The projection is a homomorphism, so it carries commutators to commutators. -/
theorem mk_commutatorElement {N : Subgroup Γ} [N.Normal] (A B : Γ) :
    (QuotientGroup.mk ⁅A, B⁆ : Γ ⧸ N) = ⁅(QuotientGroup.mk A : Γ ⧸ N), QuotientGroup.mk B⁆ := by
  simp [commutatorElement_def]

/-- A single generator is a word of length one. -/
theorem mem_wordBall_one' {U : Set Γ} {u : Γ} (hu : u ∈ U) : u ∈ wordBall U 1 :=
  ⟨[u], by simp, by
    intro x hx
    rw [List.mem_singleton.1 hx]
    exact Or.inl hu, by simp⟩

/-- **Wolf's (3.8).**  Every power `τ_{k,i}^p` with `|p| ≤ m^{k+1}` is a word of length
`≤ 8^k m` on `T₀`, modulo `Γ_{k+1}`. -/
theorem zpow_mem_ballMod_of_adapted (T₀ : Set Γ) (r : ℕ → ℕ) (t : ∀ k, Fin (r k) → Γ)
    (ht0 : ∀ i, t 0 i ∈ T₀) (htk : ∀ k i, t k i ∈ MilnorWolf.lcs Γ k)
    (hcomm : ∀ (k : ℕ) (l : Fin (r (k + 1))), ∃ (i : Fin (r 0)) (j : Fin (r k)),
      t (k + 1) l = ⁅t 0 i, t k j⁆)
    {m : ℕ} (hm : 1 ≤ m) :
    ∀ (k : ℕ) (i : Fin (r k)) (p : ℤ), |p| ≤ (m : ℤ) ^ (k + 1) →
      (QuotientGroup.mk (t k i ^ p) : Γ ⧸ MilnorWolf.lcs Γ (k + 1))
        ∈ ballMod T₀ (8 ^ k * m) (MilnorWolf.lcs Γ (k + 1)) := by
  intro k
  induction k with
  | zero =>
      intro i p hp
      have hnat : p.natAbs ≤ m := by
        have h : |p| ≤ (m : ℤ) := by simpa using hp
        rw [abs_le] at h
        omega
      refine ballMod_mono (by simpa using hnat) ?_
      exact mem_ballMod_of_mem_wordBall (zpow_mem_wordBall (ht0 i) p)
  | succ k ih =>
      intro l p hp
      obtain ⟨i, j, heq⟩ := hcomm k l
      have hyk : t k j ∈ MilnorWolf.lcs Γ k := htk k j
      -- split the exponent
      have hpM : |p| ≤ (m : ℤ) ^ (k + 1) * (m : ℤ) := by
        calc |p| ≤ (m : ℤ) ^ (k + 1 + 1) := hp
          _ = (m : ℤ) ^ (k + 1) * (m : ℤ) := by ring
      obtain ⟨a, b, hab, hb, ha⟩ := exists_quotient_decomposition hm hpM
      -- the inductive hypothesis, as "a commutator with `y ^ q` is one with a short word"
      have key : ∀ q : ℤ, |q| ≤ (m : ℤ) ^ (k + 1) → ∀ A : Γ,
          ∃ w ∈ wordBall T₀ (8 ^ k * m),
            (QuotientGroup.mk ⁅A, t k j ^ q⁆ : Γ ⧸ MilnorWolf.lcs Γ (k + 1 + 1))
              = QuotientGroup.mk ⁅A, w⁆ := by
        intro q hq A
        obtain ⟨w, hw, hmkw⟩ := ih j q hq
        have hc : w⁻¹ * t k j ^ q ∈ MilnorWolf.lcs Γ (k + 1) := QuotientGroup.eq.1 hmkw
        have hsplit : t k j ^ q = w * (w⁻¹ * t k j ^ q) := by group
        exact ⟨w, hw, by rw [hsplit, mk_commutator_mul_right (k := k + 1) A w hc]⟩
      have hbsmall : |b| ≤ (m : ℤ) ^ (k + 1) := by
        refine le_trans hb ?_
        calc (m : ℤ) = (m : ℤ) ^ 1 := (pow_one _).symm
          _ ≤ (m : ℤ) ^ (k + 1) := pow_le_pow_right₀ (by exact_mod_cast hm) (by omega)
      obtain ⟨wa, hwa, hea⟩ := key a ha (t 0 i ^ (m : ℤ))
      obtain ⟨wb, hwb, heb⟩ := key b hbsmall (t 0 i)
      -- the two pieces of `z ^ p`, with the exponent spread across the arguments
      have hza : (QuotientGroup.mk (t (k + 1) l ^ (a * (m : ℤ))) :
          Γ ⧸ MilnorWolf.lcs Γ (k + 1 + 1))
          = QuotientGroup.mk ⁅t 0 i ^ (m : ℤ), t k j ^ a⁆ := by
        rw [heq, mk_commutator_zpow_zpow (t 0 i) hyk (m : ℤ) a, mul_comm (m : ℤ) a]
        exact map_zpow (QuotientGroup.mk' (MilnorWolf.lcs Γ (k + 1 + 1))) _ _
      have hzb : (QuotientGroup.mk (t (k + 1) l ^ b) :
          Γ ⧸ MilnorWolf.lcs Γ (k + 1 + 1))
          = QuotientGroup.mk ⁅t 0 i, t k j ^ b⁆ := by
        rw [heq, mk_commutator_zpow (t 0 i) hyk b]
        exact map_zpow (QuotientGroup.mk' (MilnorWolf.lcs Γ (k + 1 + 1))) _ _
      have hprod : (QuotientGroup.mk (t (k + 1) l ^ p) :
          Γ ⧸ MilnorWolf.lcs Γ (k + 1 + 1))
          = QuotientGroup.mk ⁅t 0 i ^ (m : ℤ), wa⁆ * QuotientGroup.mk ⁅t 0 i, wb⁆ := by
        rw [hab, zpow_add, QuotientGroup.mk_mul, hza, hzb, hea, heb]
      rw [hprod]
      -- lengths
      have hxm : (QuotientGroup.mk (t 0 i ^ (m : ℤ)) : Γ ⧸ MilnorWolf.lcs Γ (k + 1 + 1))
          ∈ ballMod T₀ m (MilnorWolf.lcs Γ (k + 1 + 1)) :=
        ballMod_mono (by simp) (mem_ballMod_of_mem_wordBall (zpow_mem_wordBall (ht0 i) _))
      have hx1 : (QuotientGroup.mk (t 0 i) : Γ ⧸ MilnorWolf.lcs Γ (k + 1 + 1))
          ∈ ballMod T₀ 1 (MilnorWolf.lcs Γ (k + 1 + 1)) :=
        mem_ballMod_of_mem_wordBall (mem_wordBall_one' (ht0 i))
      have hA : (QuotientGroup.mk ⁅t 0 i ^ (m : ℤ), wa⁆ : Γ ⧸ MilnorWolf.lcs Γ (k + 1 + 1))
          ∈ ballMod T₀ (2 * (m + 8 ^ k * m)) (MilnorWolf.lcs Γ (k + 1 + 1)) := by
        rw [mk_commutatorElement]
        exact commutator_mem_ballMod hxm (mem_ballMod_of_mem_wordBall hwa)
      have hB : (QuotientGroup.mk ⁅t 0 i, wb⁆ : Γ ⧸ MilnorWolf.lcs Γ (k + 1 + 1))
          ∈ ballMod T₀ (2 * (1 + 8 ^ k * m)) (MilnorWolf.lcs Γ (k + 1 + 1)) := by
        rw [mk_commutatorElement]
        exact commutator_mem_ballMod hx1 (mem_ballMod_of_mem_wordBall hwb)
      refine ballMod_mono ?_ (mul_mem_ballMod hA hB)
      have h8 : 1 ≤ 8 ^ k := Nat.one_le_pow _ _ (by omega)
      have hmE : m ≤ 8 ^ k * m := Nat.le_mul_of_pos_left m h8
      have hsplit : 8 ^ (k + 1) * m = 8 * (8 ^ k * m) := by ring
      rw [hsplit]
      omega

end Lib
end Wolf

/-!
# Counting along a descending chain, for Wolf's (3.8)

The lower bound of Theorem 3.2 counts the elements `∏_k ∏_i τ_{k,i}^{p_{k,i}}` and needs them to
be distinct.  Wolf gets that from the independence of the `τ_{k,i}` in each factor
`Γ_k/Γ_{k+1}`; the passage from "distinct in each factor" to "distinct in `Γ`" is the elementary
fact isolated here:

*if `D` is a set of elements pairwise distinct modulo `N`, and `C` is a subset of `N`, then
multiplication `D × C → Γ` is injective, so `|D · C| = |D| · |C|.*

Applied along the chain `Γ ⊇ Γ_1 ⊇ ⋯` this multiplies the counts of the individual factors,
which is exactly the product `∏_k (2m^{k+1}+1)^{n_k}` that Wolf's estimate produces.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {Γ : Type*} [Group Γ]

/-- Distinct coset representatives times a subset of the subgroup: multiplication is injective. -/
theorem injOn_mul_of_distinct_mod {N : Subgroup Γ} {D C : Set Γ}
    (hD : ∀ a ∈ D, ∀ a' ∈ D, a⁻¹ * a' ∈ N → a = a') (hC : C ⊆ (N : Set Γ)) :
    Set.InjOn (fun p : Γ × Γ => p.1 * p.2) (D ×ˢ C) := by
  rintro ⟨a, b⟩ ⟨ha, hb⟩ ⟨a', b'⟩ ⟨ha', hb'⟩ h
  simp only at h
  have hmemb : b ∈ N := hC hb
  have hmemb' : b' ∈ N := hC hb'
  have heq : a⁻¹ * a' = b * b'⁻¹ := by
    have h2 : a⁻¹ * (a * b) = a⁻¹ * (a' * b') := by rw [h]
    rw [← mul_assoc, inv_mul_cancel, one_mul] at h2
    rw [h2]
    group
  have haa' : a⁻¹ * a' ∈ N := by
    rw [heq]
    exact N.mul_mem hmemb (N.inv_mem hmemb')
  have hae : a = a' := hD a ha a' ha' haa'
  subst hae
  exact Prod.ext rfl (mul_left_cancel h)

/-- The product set is exactly as large as the product of the sizes.  No finiteness is needed:
`Set.ncard` is `0` on an infinite set, and the identity survives that convention. -/
theorem ncard_mul_eq {N : Subgroup Γ} {D C : Set Γ}
    (hD : ∀ a ∈ D, ∀ a' ∈ D, a⁻¹ * a' ∈ N → a = a') (hC : C ⊆ (N : Set Γ)) :
    ((fun p : Γ × Γ => p.1 * p.2) '' (D ×ˢ C)).ncard = D.ncard * C.ncard := by
  rw [Set.InjOn.ncard_image (injOn_mul_of_distinct_mod hD hC), Set.ncard_prod]

/-! ### Independence gives distinct exponent tuples -/

/-- If the cyclic subgroups generated by the `a i` are independent and each `a i` has infinite
order, then distinct exponent tuples give distinct products.  This is what Wolf's "independent
generating set" buys in the counting: the `(2m^{k+1}+1)^{n_k}` tuples give that many distinct
elements of `Γ_k/Γ_{k+1}`. -/
theorem injective_zpow_prod {ι : Type*} [Fintype ι] {A : Type*} [CommGroup A] (a : ι → A)
    (hind : iSupIndep (fun i => Subgroup.zpowers (a i)))
    (hinf : ∀ (i : ι) (n : ℤ), a i ^ n = 1 → n = 0) :
    Function.Injective (fun p : ι → ℤ => ∏ i, a i ^ p i) := by
  intro p q h
  simp only at h
  funext i
  have hdiv : ∏ i, a i ^ (p i - q i) = 1 := by
    simp only [zpow_sub, ← div_eq_mul_inv]
    rw [Finset.prod_div_distrib, h, div_self']
  have hnc : Finset.univ.noncommProd (fun i => a i ^ (p i - q i))
      (fun x _ y _ _ => Commute.all _ _) = 1 := by
    rw [Finset.noncommProd_eq_prod]
    exact hdiv
  have hone := Subgroup.eq_one_of_noncommProd_eq_one_of_iSupIndep Finset.univ
    (fun i => a i ^ (p i - q i)) (fun x _ y _ _ => Commute.all _ _)
    (fun i => Subgroup.zpowers (a i)) hind
    (fun x _ => Subgroup.zpow_mem_zpowers _ _) hnc i (Finset.mem_univ i)
  have := hinf i _ hone
  omega

/-! ### The rank counts only the infinite-order members

Wolf's `n_k` is the number of members of the adapted family of infinite order, while the
definition bundle's `lcsRank` is `finrank ℤ` of the factor.  These agree because the torsion
members contribute nothing: the submodule they span has torsion quotient, hence rank zero, and
rank is additive over that quotient because `ℤ` is a domain and so has rank–nullity.
-/

/-! ### Multiplying the levels together -/

/-- **Wolf's count, assembled along the chain.**  Given at each level `k` a set `D k` inside
`A k`, consisting of words of length `≤ L k` and pairwise distinct modulo `A (k+1)`, the products
`D k · D (k+1) ⋯` form a set inside `A k`, consisting of words of length `≤ ∑ L`, and at least
as numerous as `∏ |D|`.

This is the step that turns Wolf's per-factor counts `(2m^{k+1}+1)^{n_k}` into their product. -/
theorem exists_prod_set (A : ℕ → Subgroup Γ) (hanti : ∀ k, A (k + 1) ≤ A k) (T₀ : Set Γ)
    (D : ℕ → Set Γ) (L : ℕ → ℕ) (hDA : ∀ k, D k ⊆ (A k : Set Γ))
    (hDB : ∀ k, D k ⊆ wordBall T₀ (L k))
    (hdist : ∀ k, ∀ x ∈ D k, ∀ y ∈ D k, x⁻¹ * y ∈ A (k + 1) → x = y) :
    ∀ (n k : ℕ), ∃ C : Set Γ, C ⊆ (A k : Set Γ) ∧
      C ⊆ wordBall T₀ (∑ j ∈ Finset.range n, L (k + j)) ∧
      (∏ j ∈ Finset.range n, (D (k + j)).ncard) ≤ C.ncard := by
  intro n
  induction n with
  | zero =>
      intro k
      refine ⟨{1}, ?_, ?_, ?_⟩
      · simpa using (A k).one_mem
      · simpa using one_mem_wordBall T₀ 0
      · simp
  | succ n ih =>
      intro k
      obtain ⟨C', hCA, hCB, hCcard⟩ := ih (k + 1)
      refine ⟨(fun p : Γ × Γ => p.1 * p.2) '' (D k ×ˢ C'), ?_, ?_, ?_⟩
      · rintro _ ⟨⟨x, y⟩, ⟨hx, hy⟩, rfl⟩
        exact (A k).mul_mem (hDA k hx) (hanti k (hCA hy))
      · rintro _ ⟨⟨x, y⟩, ⟨hx, hy⟩, rfl⟩
        have hlen : L k + ∑ j ∈ Finset.range n, L (k + 1 + j)
            = ∑ j ∈ Finset.range (n + 1), L (k + j) := by
          rw [Finset.sum_range_succ']
          simp only [Nat.add_zero]
          rw [Nat.add_comm]
          congr 1
          refine Finset.sum_congr rfl fun j _ => ?_
          congr 1
          omega
        rw [← hlen]
        exact mul_mem_wordBall (hDB k hx) (hCB hy)
      · have hcard := ncard_mul_eq (N := A (k + 1)) (hdist k) hCA
        rw [hcard, Finset.prod_range_succ']
        simp only [Nat.add_zero]
        rw [Nat.mul_comm]
        refine Nat.mul_le_mul_left _ ?_
        refine le_trans (le_of_eq ?_) hCcard
        refine Finset.prod_congr rfl fun j _ => ?_
        congr 2
        omega

/-! ### One level -/

/-- **One level of Wolf's count.**  From `d` elements of `K` whose powers with exponent at most
`P` are words of length `≤ ℓ` modulo `N`, and whose exponent tuples give distinct products, one
gets a set inside `K` of at least `(2P+1)^d` elements, pairwise distinct modulo `N`, each a word
of length `≤ d ℓ`.

Commutativity is not needed here — the products are taken in a fixed order — so the burden of
producing `hinj` stays with the caller, where the factor `Γ_k/Γ_{k+1}` really is abelian. -/
theorem exists_level_set {N : Subgroup Γ} [N.Normal] (U : Set Γ) (K : Subgroup Γ)
    (hNK : N ≤ K) {d : ℕ} (b : Fin d → Γ) (hb : ∀ i, b i ∈ K) (P ℓ : ℕ)
    (hshort : ∀ (i : Fin d) (p : ℤ), |p| ≤ (P : ℤ) →
      (QuotientGroup.mk (b i ^ p) : Γ ⧸ N) ∈ ballMod U ℓ N)
    (hinj : Function.Injective fun p : Fin d → ℤ =>
      (QuotientGroup.mk ((List.ofFn fun i => b i ^ p i).prod) : Γ ⧸ N)) :
    ∃ D : Set Γ, D ⊆ (K : Set Γ) ∧ D ⊆ wordBall U (d * ℓ) ∧
      (∀ x ∈ D, ∀ y ∈ D, x⁻¹ * y ∈ N → x = y) ∧
      (2 * P + 1) ^ d ≤ D.ncard := by
  classical
  set g : (Fin d → ℤ) → Γ := fun p => (List.ofFn fun i => b i ^ p i).prod with hg
  have hgK : ∀ p, g p ∈ K := by
    intro p
    refine Subgroup.list_prod_mem _ ?_
    intro x hx
    obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hx
    exact K.zpow_mem (hb i) _
  set Box : Finset (Fin d → ℤ) :=
    Fintype.piFinset fun _ => Finset.Icc (-(P : ℤ)) (P : ℤ) with hBox
  have hBoxcard : Box.card = (2 * P + 1) ^ d := by
    have hIcc : (Finset.Icc (-(P : ℤ)) (P : ℤ)).card = 2 * P + 1 := by
      rw [Int.card_Icc]
      omega
    rw [hBox, Fintype.card_piFinset]
    simp [hIcc]
  -- a word representing each product
  have hex : ∀ p ∈ Box, ∃ w : Γ, w ∈ wordBall U (d * ℓ) ∧
      (QuotientGroup.mk w : Γ ⧸ N) = QuotientGroup.mk (g p) := by
    intro p hp
    have hclasses : ∀ x ∈ ((List.ofFn fun i => b i ^ p i).map (QuotientGroup.mk' N)),
        x ∈ ballMod U ℓ N := by
      intro x hx
      obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hx
      obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hy
      refine hshort i (p i) ?_
      have hi := (Fintype.mem_piFinset.1 hp) i
      rw [Finset.mem_Icc] at hi
      rw [abs_le]
      exact ⟨hi.1, hi.2⟩
    have hmem := list_prod_mem_ballMod (U := U) (N := N) _ hclasses
    rw [List.length_map, List.length_ofFn, ← map_list_prod (QuotientGroup.mk' N)] at hmem
    obtain ⟨w, hw, hwe⟩ := hmem
    exact ⟨w, hw, hwe⟩
  choose! f hf1 hf2 using hex
  have hfK : ∀ p ∈ Box, f p ∈ K := by
    intro p hp
    have h := QuotientGroup.eq.1 (hf2 p hp).symm
    have : f p = g p * ((g p)⁻¹ * f p) := by group
    rw [this]
    exact K.mul_mem (hgK p) (hNK h)
  have hinjOn : Set.InjOn f (Box : Set (Fin d → ℤ)) := by
    intro x hx y hy hxy
    have hcl : (QuotientGroup.mk (g x) : Γ ⧸ N) = QuotientGroup.mk (g y) := by
      rw [← hf2 x hx, ← hf2 y hy, hxy]
    exact hinj hcl
  refine ⟨f '' (Box : Set (Fin d → ℤ)), ?_, ?_, ?_, ?_⟩
  · rintro _ ⟨p, hp, rfl⟩
    exact hfK p hp
  · rintro _ ⟨p, hp, rfl⟩
    exact hf1 p hp
  · rintro _ ⟨p, hp, rfl⟩ _ ⟨q, hq, rfl⟩ hmem
    have hcl : (QuotientGroup.mk (f p) : Γ ⧸ N) = QuotientGroup.mk (f q) :=
      QuotientGroup.eq.2 hmem
    rw [hf2 p hp, hf2 q hq] at hcl
    rw [hinj hcl]

  · rw [Set.ncard_image_of_injOn hinjOn, Set.ncard_coe_finset, hBoxcard]

/-! ### Transferring between the two quotients

Lemma 3.7 states independence in `Γ_k/Γ_{k+1}`, the quotient of the subgroup; the word lengths
of Theorem 3.2 live in `Γ/Γ_{k+1}`, the quotient of the whole group.  The comparison is cheap:
two elements of `K` are congruent modulo `N` in the big quotient exactly when they are in the
small one, because `N.subgroupOf K` is by definition the elements of `K` lying in `N`. -/
theorem mk_eq_mk_iff_subgroupOf {K N : Subgroup Γ} [N.Normal] (x y : ↥K) :
    (QuotientGroup.mk (x : Γ) : Γ ⧸ N) = QuotientGroup.mk (y : Γ) ↔
      (QuotientGroup.mk x : ↥K ⧸ N.subgroupOf K) = QuotientGroup.mk y := by
  rw [QuotientGroup.eq, QuotientGroup.eq, Subgroup.mem_subgroupOf]
  simp

/-- Independence in the subgroup quotient `K/N` gives injectivity of the ordered product read in
the whole quotient `Γ/N`.  This is the hypothesis `exists_level_set` asks for, produced from what
Lemma 3.7 actually supplies. -/
theorem injective_mk_list_prod_of_indep {K N : Subgroup Γ} [N.Normal] {d : ℕ} (b : Fin d → ↥K)
    (hcomm : ∀ x y : ↥K ⧸ N.subgroupOf K, x * y = y * x)
    (hind : iSupIndep fun i =>
      Subgroup.zpowers (QuotientGroup.mk (b i) : ↥K ⧸ N.subgroupOf K))
    (hinf : ∀ (i : Fin d) (n : ℤ),
      (QuotientGroup.mk (b i) : ↥K ⧸ N.subgroupOf K) ^ n = 1 → n = 0) :
    Function.Injective fun p : Fin d → ℤ =>
      (QuotientGroup.mk ((List.ofFn fun i => ((b i : Γ)) ^ p i).prod) : Γ ⧸ N) := by
  letI : CommGroup (↥K ⧸ N.subgroupOf K) := ⟨hcomm⟩
  have hcoe : ∀ r : Fin d → ℤ,
      (((List.ofFn fun i => b i ^ r i).prod : ↥K) : Γ)
        = (List.ofFn fun i => ((b i : Γ)) ^ r i).prod := by
    intro r
    rw [SubmonoidClass.coe_list_prod, List.map_ofFn]
    congr 1
  have hprod : ∀ r : Fin d → ℤ,
      (QuotientGroup.mk ((List.ofFn fun i => b i ^ r i).prod) : ↥K ⧸ N.subgroupOf K)
        = ∏ i, (QuotientGroup.mk (b i) : ↥K ⧸ N.subgroupOf K) ^ r i := by
    intro r
    show (QuotientGroup.mk' (N.subgroupOf K)) ((List.ofFn fun i => b i ^ r i).prod) = _
    rw [map_list_prod, List.map_ofFn, List.prod_ofFn]
    refine Finset.prod_congr rfl fun i _ => ?_
    simp
  intro p q h
  have h1 : (QuotientGroup.mk (((List.ofFn fun i => b i ^ p i).prod : ↥K) : Γ) : Γ ⧸ N)
      = QuotientGroup.mk (((List.ofFn fun i => b i ^ q i).prod : ↥K) : Γ) := by
    rw [hcoe p, hcoe q]
    exact h
  have hkey := (mk_eq_mk_iff_subgroupOf _ _).1 h1
  rw [hprod p, hprod q] at hkey
  exact injective_zpow_prod _ hind hinf hkey

/-! ### The arithmetic of Wolf's count

`∏_k (2m^{k+1}+1)^{d_k} ≥ m^{∑ (k+1) n_k}` whenever `n_k ≤ d_k`: this is what turns the product
of the per-level counts into `m^{E₁}`. -/
theorem pow_sum_le_prod (m : ℕ) (hm : 1 ≤ m) (n d : ℕ → ℕ) (hnd : ∀ k, n k ≤ d k) (N : ℕ) :
    m ^ (∑ k ∈ Finset.range N, (k + 1) * n k)
      ≤ ∏ k ∈ Finset.range N, (2 * m ^ (k + 1) + 1) ^ d k := by
  rw [← Finset.prod_pow_eq_pow_sum]
  refine Finset.prod_le_prod' fun k _ => ?_
  have hbase : 1 ≤ m ^ (k + 1) := Nat.one_le_pow _ _ (by omega)
  calc m ^ ((k + 1) * n k) = (m ^ (k + 1)) ^ n k := by rw [pow_mul]
    _ ≤ (m ^ (k + 1)) ^ d k := Nat.pow_le_pow_right hbase (hnd k)
    _ ≤ (2 * m ^ (k + 1) + 1) ^ d k := Nat.pow_le_pow_left (by omega) _

/-- **Wolf's (3.8), assembled into a ball count.**  Per-level sets that are short words and
pairwise distinct modulo the next term give a ball of radius `∑ L` with at least `∏ |D|`
elements. -/
theorem prod_le_card_wordBall (T₀ : Finset Γ) (A : ℕ → Subgroup Γ)
    (hanti : ∀ k, A (k + 1) ≤ A k) (D : ℕ → Set Γ) (L : ℕ → ℕ)
    (hDA : ∀ k, D k ⊆ (A k : Set Γ))
    (hDB : ∀ k, D k ⊆ wordBall (T₀ : Set Γ) (L k))
    (hdist : ∀ k, ∀ x ∈ D k, ∀ y ∈ D k, x⁻¹ * y ∈ A (k + 1) → x = y) (n : ℕ) :
    (∏ k ∈ Finset.range n, (D k).ncard)
      ≤ Nat.card (wordBall (T₀ : Set Γ) (∑ k ∈ Finset.range n, L k)) := by
  obtain ⟨C, hCA, hCB, hCcard⟩ :=
    exists_prod_set A hanti (T₀ : Set Γ) D L hDA hDB hdist n 0
  simp only [Nat.zero_add] at hCB hCcard
  refine le_trans hCcard ?_
  rw [Nat.card_coe_set_eq]
  exact Set.ncard_le_ncard hCB (finite_wordBall T₀ _)

/-! ### Infinite order, in the two forms the pieces want -/

/-- Not of finite order: no nonzero power is trivial.  This is the form `injective_zpow_prod`
asks for. -/
theorem zpow_eq_one_imp_eq_zero {A : Type*} [Group A] {x : A} (h : ¬ IsOfFinOrder x) (n : ℤ)
    (hn : x ^ n = 1) : n = 0 := by
  by_contra hne
  exact h (isOfFinOrder_iff_zpow_eq_one.2 ⟨n, hne, hn⟩)

/-- **Wolf's `n_k`, bounded, from a free part of finite index.**  If the cyclic subgroups on the
members indexed by `J` generate a subgroup of finite index, then any quotient of the group has
rank at most `#J`: the quotient of `Additive A` by the span of those members is torsion, since
the `index`-th power of every element lies in that subgroup, so the rank is carried by the span.
This is the form the corrected Lemma 3.7 supplies (Wolf's p. 429: the first `n_k` members
generate a free abelian subgroup of finite index `l_k`). -/
theorem finrank_le_card_of_finiteIndex {A : Type*} [CommGroup A] {ι : Type*}
    (a : ι → A) (J : Finset ι)
    (hfin : (⨆ j : J, Subgroup.zpowers (a j)).FiniteIndex)
    {P : Type*} [AddCommGroup P] (f : Additive A →+ P) (hf : Function.Surjective f) :
    Module.finrank ℤ P ≤ J.card := by
  classical
  set H : Subgroup A := ⨆ j : J, Subgroup.zpowers (a j) with hHdef
  set s : Finset P := J.image fun j => f (Additive.ofMul (a j)) with hsdef
  set N : Submodule ℤ P := Submodule.span ℤ (s : Set P) with hNdef
  have hHN : ∀ x ∈ H, f (Additive.ofMul x) ∈ N := by
    intro x hx
    refine Subgroup.iSup_induction (fun j : J => Subgroup.zpowers (a j))
      (C := fun g => f (Additive.ofMul g) ∈ N) hx ?_ ?_ ?_
    · rintro j y ⟨n, rfl⟩
      have hz : f (Additive.ofMul (a j ^ n)) = n • f (Additive.ofMul (a j)) := by
        rw [← map_zsmul]; rfl
      rw [hz]
      refine Submodule.smul_mem _ _ (Submodule.subset_span ?_)
      rw [hsdef, Finset.coe_image]
      exact ⟨j, j.2, rfl⟩
    · have h0 : f (Additive.ofMul (1 : A)) = 0 := map_zero f
      rw [h0]; exact N.zero_mem
    · intro y z hy hz
      have hyz : f (Additive.ofMul (y * z)) = f (Additive.ofMul y) + f (Additive.ofMul z) :=
        map_add f _ _
      rw [hyz]; exact N.add_mem hy hz
  have hidx : H.index ≠ 0 := hfin.index_ne_zero
  have htor : Module.IsTorsion ℤ (P ⧸ N) := by
    intro q
    obtain ⟨p, rfl⟩ := Submodule.Quotient.mk_surjective N q
    obtain ⟨x, rfl⟩ := hf p
    refine ⟨⟨(H.index : ℤ), mem_nonZeroDivisors_of_ne_zero (by exact_mod_cast hidx)⟩, ?_⟩
    show (H.index : ℤ) • (Submodule.Quotient.mk (f x) : P ⧸ N) = 0
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, ← map_zsmul]
    have hmem := hHN _ (H.pow_index_mem (Additive.toMul x))
    have hsm : Additive.ofMul (Additive.toMul x ^ H.index) = (H.index : ℤ) • x := by
      rw [natCast_zsmul]; rfl
    rwa [hsm] at hmem
  have hq0 : Module.rank ℤ (P ⧸ N) = 0 := Module.rank_eq_zero_iff_isTorsion.2 htor
  have hsum := rank_quotient_add_rank_of_isDomain N
  have hNle : Module.rank ℤ N ≤ J.card :=
    (rank_span_finset_le s).trans (by exact_mod_cast Finset.card_image_le)
  apply Module.finrank_le_of_rank_le
  calc Module.rank ℤ P = Module.rank ℤ (P ⧸ N) + Module.rank ℤ N := hsum.symm
    _ = Module.rank ℤ N := by rw [hq0, zero_add]
    _ ≤ J.card := hNle

/-! ### Covering along the chain

The lower bound *packs* the chain: per-level sets that are distinct modulo the next term give a
product at least as large as the product of their sizes.  The upper bound *covers* it: if every
element of `A k` is a member of `C k` times an element of `A (k+1)`, then `A 0` sits inside the
product of the `C k`, whose size is at most the product of theirs.  This is Wolf's (3.9), the
normal form, separated from the estimate (3.10) on the exponents. -/

end Lib
end Wolf

/-!
# Wolf's Lemma 3.4 (p. 426): rescaling a polynomial lower bound

Two upgrades of a lower bound on the growth function, both of which Theorem 3.2 uses.  A bound
`c (m - r)^q` becomes `c' m^q`, because `(m - r)/m ≥ 1/(r+1)` once `m ≥ r + 1`, and below that the
ball already has at least one element.  A bound along the multiples of `l` becomes a bound for
every `m`, by dropping from `m` to the largest multiple `l ⌊m/l⌋` below it, which is at least
`m / l` once `m ≥ l`.

Wolf takes the constant to be a minimum over the finitely many small values of the growth
function; since every ball contains the identity, `min c 1` divided by `(r+1)^q`, resp. `l^q`,
serves in both ranges at once.  The second half is proved directly rather than, as Wolf does, by
reducing it to the first.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {Γ : Type*} [Group Γ]

theorem one_le_growthFunction (S : Finset Γ) (m : ℕ) :
    (1 : ℝ) ≤ (MilnorWolf.growthFunction S m : ℝ) := by
  exact_mod_cast one_le_card_wordBall S m

theorem growthFunction_mono (S : Finset Γ) {a b : ℕ} (h : a ≤ b) :
    (MilnorWolf.growthFunction S a : ℝ) ≤ (MilnorWolf.growthFunction S b : ℝ) := by
  exact_mod_cast card_wordBall_le_of_subset (wordBall_mono (S : Set Γ) h)

/-- **Wolf's Lemma 3.4, second half.**  A lower bound along the multiples of `l` upgrades to all
`m`: drop from `m` to `l ⌊m/l⌋`, which is at least `m / l` once `m ≥ l`. -/
theorem exists_const_of_le_mul (S : Finset Γ) (l q : ℕ) (c : ℝ) (hl : 0 < l) (hc : 0 < c)
    (h : ∀ m : ℕ, 1 ≤ m →
      c * ((l * m : ℕ) : ℝ) ^ q ≤ (MilnorWolf.growthFunction S (l * m) : ℝ)) :
    ∃ c'' : ℝ, 0 < c'' ∧ ∀ m : ℕ, 1 ≤ m →
      c'' * (m : ℝ) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ) := by
  have hl0 : (0 : ℝ) < (l : ℝ) := by exact_mod_cast hl
  refine ⟨min c 1 / (l : ℝ) ^ q, by positivity, ?_⟩
  intro m hm
  have hm0 : (0 : ℝ) ≤ (m : ℝ) := by positivity
  by_cases hcase : l ≤ m
  · -- drop to the largest multiple of `l` below `m`
    set a : ℕ := m / l with ha
    have ha1 : 1 ≤ a := (Nat.one_le_div_iff hl).2 hcase
    have hal : l * a ≤ m := by rw [ha]; exact Nat.mul_div_le m l
    have h1 : m + 1 ≤ a * l + l := by
      have h2 : m / l < a + 1 := by rw [← ha]; exact Nat.lt_succ_self a
      have h3 : m < (a + 1) * l := (Nat.div_lt_iff_lt_mul hl).1 h2
      rw [add_one_mul] at h3
      omega
    have hbig : (m : ℝ) / (l : ℝ) ≤ ((l * a : ℕ) : ℝ) := by
      have hb : (m : ℝ) + 1 ≤ (a : ℝ) * (l : ℝ) + (l : ℝ) := by exact_mod_cast h1
      have hlm : (l : ℝ) ≤ (m : ℝ) := by exact_mod_cast hcase
      have hl1 : (1 : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl
      rw [div_le_iff₀ hl0]
      push_cast
      nlinarith [mul_nonneg (sub_nonneg.2 hl1) (sub_nonneg.2 hlm),
        mul_le_mul_of_nonneg_left hb hl0.le]
    have hpow : ((m : ℝ) / (l : ℝ)) ^ q ≤ ((l * a : ℕ) : ℝ) ^ q :=
      pow_le_pow_left₀ (by positivity) hbig q
    calc min c 1 / (l : ℝ) ^ q * (m : ℝ) ^ q
        = min c 1 * ((m : ℝ) / (l : ℝ)) ^ q := by rw [div_pow]; ring
      _ ≤ c * ((l * a : ℕ) : ℝ) ^ q := by
          refine mul_le_mul (min_le_left _ _) hpow (by positivity) hc.le
      _ ≤ (MilnorWolf.growthFunction S (l * a) : ℝ) := h a ha1
      _ ≤ (MilnorWolf.growthFunction S m : ℝ) := growthFunction_mono S hal
  · -- the small range
    have hml : (m : ℝ) ≤ (l : ℝ) := by
      have : m ≤ l := by omega
      exact_mod_cast this
    have hpow : (m : ℝ) ^ q ≤ (l : ℝ) ^ q := pow_le_pow_left₀ hm0 hml q
    have hle : min c 1 / (l : ℝ) ^ q * (m : ℝ) ^ q ≤ 1 := by
      rw [div_mul_eq_mul_div, div_le_one (by positivity)]
      calc min c 1 * (m : ℝ) ^ q ≤ 1 * (l : ℝ) ^ q := by
            refine mul_le_mul (min_le_right _ _) hpow (by positivity) zero_le_one
        _ = (l : ℝ) ^ q := one_mul _
    exact hle.trans (one_le_growthFunction S m)

end Lib
end Wolf

/-!
# The lower-central factor in the shape Lemma 3.7 states it

Lemma 3.7 describes `Γ_k/Γ_{k+1}` as the quotient of the subgroup `Γ_k` by `Γ_{k+1}` sitting
inside it, while the published growth bundle's `lcsFactor` goes through the abelianization of
`Γ_k`.  This module holds the comparison, and the first half of Theorem 3.2 that follows from
it: every lower-central factor of a finitely generated nilpotent group is finitely generated.

Separated from the Theorem 3.2 module because that one imports the two published statements of
the growth bounds, so nothing in it could be used by a proof *of* either bound.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {Γ : Type*} [Group Γ]

/-- `Γ_k/Γ_{k+1}` in the shape Lemma 3.7 states it. -/
abbrev lcsQuot (Γ : Type*) [Group Γ] (k : ℕ) : Type _ :=
  ↥(MilnorWolf.lcs Γ k) ⧸ ((MilnorWolf.lcs Γ (k + 1)).subgroupOf (MilnorWolf.lcs Γ k))

/-- `Γ_{k+1}`, viewed inside `Γ_k`, is killed by the projection onto the definition bundle's
factor `lcsFactor Γ k`. -/
theorem subgroupOf_le_ker_toLcsFactor (k : ℕ) :
    (MilnorWolf.lcs Γ (k + 1)).subgroupOf (MilnorWolf.lcs Γ k) ≤
      (toLcsFactor (Γ := Γ) k).ker := by
  intro x hx
  rw [MonoidHom.mem_ker, toLcsFactor, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
    QuotientGroup.eq_one_iff]
  exact ⟨x, hx, rfl⟩

/-- The projection of `Γ_k/Γ_{k+1}` onto the definition bundle's `lcsFactor Γ k`. -/
noncomputable def lcsQuotToFactor (k : ℕ) : lcsQuot Γ k →* MilnorWolf.lcsFactor Γ k :=
  QuotientGroup.lift _ (toLcsFactor (Γ := Γ) k) (subgroupOf_le_ker_toLcsFactor k)

theorem lcsQuotToFactor_surjective (k : ℕ) :
    Function.Surjective (lcsQuotToFactor (Γ := Γ) k) := by
  intro y
  obtain ⟨x, rfl⟩ := toLcsFactor_surjective (Γ := Γ) k y
  exact ⟨QuotientGroup.mk' _ x, rfl⟩

/-- The hypotheses Lemma 3.7 asks for, for a finitely generated nilpotent group. -/
theorem lcs_nilpotencyClass_eq_bot [Group.IsNilpotent Γ] :
    MilnorWolf.lcs Γ (Group.nilpotencyClass Γ) = ⊥ :=
  Subgroup.lowerCentralSeries_nilpotencyClass

theorem fg_lcsQuot_zero [Group.FG Γ] : Group.FG (lcsQuot Γ 0) := by
  haveI : Group.FG ↥(MilnorWolf.lcs Γ 0) :=
    fg_of_mulEquiv (Subgroup.topEquiv (G := Γ)).symm
  exact Group.fg_of_surjective (f := QuotientGroup.mk' _) (QuotientGroup.mk'_surjective _)

end Lib
end Wolf

/-!
# Theorem 3.2, lower bound: instantiating Wolf's (3.8)

The general theory is elsewhere: the word-length induction, the per-level count, the chain
assembly, the rank bridge.  What happens here is the instantiation at the adapted families of the
corrected Lemma 3.7 — taking, at each level, the independent subfamily of infinite order that
spans a subgroup of finite index, reindexing it, and feeding the result through with the
exponent bound `P = m^{k+1}` and the length `ℓ = 8^k m`.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib
open scoped commutatorElement

variable {Γ : Type*} [Group Γ]

/-- **One level of Wolf's count**, from the corrected Lemma 3.7's data at that level: a family
generating the factor, and a subfamily `J` that is independent, of infinite order, and spans a
subgroup of finite index.  The set produced has at least `(2P+1)^{n_k}` elements, where `n_k` is
the bundle's `lcsRank`, because `J` has at least that many members. -/
theorem exists_level_of_adapted (T₀ : Set Γ) (k rk : ℕ) (τ : Fin rk → ↥(MilnorWolf.lcs Γ k))
    (hcomm : ∀ x y : lcsQuot Γ k, x * y = y * x)
    (J : Finset (Fin rk))
    (hind : iSupIndep fun j : J => Subgroup.zpowers (QuotientGroup.mk (τ j) : lcsQuot Γ k))
    (hinf : ∀ j ∈ J, ¬ IsOfFinOrder (QuotientGroup.mk (τ j) : lcsQuot Γ k))
    (hfin : (⨆ j : J, Subgroup.zpowers (QuotientGroup.mk (τ j) : lcsQuot Γ k)).FiniteIndex)
    (P ℓ : ℕ)
    (hshort : ∀ (i : Fin rk) (p : ℤ), |p| ≤ (P : ℤ) →
      (QuotientGroup.mk (((τ i : Γ)) ^ p) : Γ ⧸ MilnorWolf.lcs Γ (k + 1))
        ∈ ballMod T₀ ℓ (MilnorWolf.lcs Γ (k + 1))) :
    ∃ D : Set Γ, D ⊆ (MilnorWolf.lcs Γ k : Set Γ) ∧ D ⊆ wordBall T₀ (rk * ℓ) ∧
      (∀ x ∈ D, ∀ y ∈ D, x⁻¹ * y ∈ MilnorWolf.lcs Γ (k + 1) → x = y) ∧
      (2 * P + 1) ^ (MilnorWolf.lcsRank Γ k) ≤ D.ncard := by
  classical
  letI : CommGroup (lcsQuot Γ k) := ⟨hcomm⟩
  -- enumerate the members of `J`
  set b : Fin J.card → Fin rk := fun j => ((J.equivFin.symm j : {i // i ∈ J}) : Fin rk) with hbdef
  have hbinj : Function.Injective b := by
    intro x y hxy
    exact J.equivFin.symm.injective (Subtype.ext hxy)
  have hbJ : ∀ j, b j ∈ J := fun j => (J.equivFin.symm j).2
  -- the enumerated family is still independent, and of infinite order
  have hind' : iSupIndep fun j =>
      Subgroup.zpowers (QuotientGroup.mk (τ (b j)) : lcsQuot Γ k) :=
    hind.comp J.equivFin.symm.injective
  have hinf' : ∀ (j : Fin J.card) (n : ℤ),
      (QuotientGroup.mk (τ (b j)) : lcsQuot Γ k) ^ n = 1 → n = 0 :=
    fun j n hn => zpow_eq_one_imp_eq_zero (hinf (b j) (hbJ j)) n hn
  -- the level set
  obtain ⟨D, hDK, hDB, hdist, hcard⟩ :=
    exists_level_set (N := MilnorWolf.lcs Γ (k + 1)) T₀ (MilnorWolf.lcs Γ k)
      ((⊤ : Subgroup Γ).lowerCentralSeries_antitone (Nat.le_succ k))
      (fun j => ((τ (b j) : Γ))) (fun j => (τ (b j)).2) P ℓ
      (fun j p hp => hshort (b j) p hp)
      (injective_mk_list_prod_of_indep (fun j => τ (b j)) hcomm hind' hinf')
  refine ⟨D, hDK, ?_, hdist, ?_⟩
  · refine hDB.trans (wordBall_mono T₀ ?_)
    exact Nat.mul_le_mul_right ℓ (le_trans (Finset.card_le_univ J) (by simp))
  · refine le_trans (Nat.pow_le_pow_right (by omega) ?_) hcard
    -- `lcsRank Γ k ≤ J.card`
    exact finrank_le_card_of_finiteIndex (fun i => (QuotientGroup.mk (τ i) : lcsQuot Γ k)) J hfin
      (MonoidHom.toAdditive (lcsQuotToFactor (Γ := Γ) k)) (lcsQuotToFactor_surjective k)

/-- **Wolf's (3.8).**  For a finitely generated nilpotent group there is a generating set `T₀`
and a radius factor `B` such that the ball of radius `B m` has at least `m^{E₁}` elements. -/
theorem exists_pow_growthExponentOne_le_card_wordBall [Group.FG Γ] [Group.IsNilpotent Γ] :
    ∃ (T₀ : Finset Γ) (B : ℕ), 0 < B ∧ Subgroup.closure (T₀ : Set Γ) = ⊤ ∧
      ∀ m : ℕ, 1 ≤ m →
        m ^ (MilnorWolf.growthExponentOne Γ) ≤ Nat.card (wordBall (T₀ : Set Γ) (B * m)) := by
  classical
  obtain ⟨r, τ, hi, hii, hiii⟩ :=
    _root_.Wolf.exists_commutator_generating_sets_with_free_finiteIndex_subfamily_lowerCentralSeries
      (Γ := Γ) (Group.nilpotencyClass Γ)
      (by
        have h := lcs_nilpotencyClass_eq_bot (Γ := Γ)
        have hle : MilnorWolf.lcs Γ (Group.nilpotencyClass Γ + 1) ≤
            MilnorWolf.lcs Γ (Group.nilpotencyClass Γ) :=
          (⊤ : Subgroup Γ).lowerCentralSeries_antitone (Nat.le_succ _)
        rw [h] at hle
        exact le_bot_iff.1 hle)
      fg_lcsQuot_zero
  set n : ℕ := Group.nilpotencyClass Γ with hn
  set T₀ : Finset Γ := Finset.univ.image fun i : Fin (r 0) => ((τ 0 i : Γ)) with hT₀
  have hT₀coe : (T₀ : Set Γ) = Set.range fun i : Fin (r 0) => ((τ 0 i : Γ)) := by
    rw [hT₀, Finset.coe_image, Finset.coe_univ, Set.image_univ]
  have hgen : Subgroup.closure (T₀ : Set Γ) = ⊤ := by rw [hT₀coe]; exact hiii
  set B : ℕ := (∑ k ∈ Finset.range n, r k * 8 ^ k) + 1 with hB
  refine ⟨T₀, B, by omega, hgen, ?_⟩
  intro m hm
  -- Wolf's (3.8) for this family
  have hshort := zpow_mem_ballMod_of_adapted (T₀ : Set Γ) r (fun k i => ((τ k i : Γ)))
    (fun i => by rw [hT₀coe]; exact ⟨i, rfl⟩) (fun k i => (τ k i).2)
    (fun k l => by
      obtain ⟨i, j, hij⟩ := hii k l
      exact ⟨i, j, hij⟩) hm
  -- one set per level
  have hlevel : ∀ k, ∃ D : Set Γ, D ⊆ (MilnorWolf.lcs Γ k : Set Γ) ∧
      D ⊆ wordBall (T₀ : Set Γ) (r k * (8 ^ k * m)) ∧
      (∀ x ∈ D, ∀ y ∈ D, x⁻¹ * y ∈ MilnorWolf.lcs Γ (k + 1) → x = y) ∧
      (2 * m ^ (k + 1) + 1) ^ (MilnorWolf.lcsRank Γ k) ≤ D.ncard := by
    intro k
    obtain ⟨-, hc, -, J, hindJ, hinfJ, hfinJ⟩ := hi k
    refine exists_level_of_adapted (T₀ : Set Γ) k (r k) (τ k) hc J hindJ hinfJ hfinJ
      (m ^ (k + 1)) (8 ^ k * m) ?_
    intro i p hp
    refine hshort k i p ?_
    have : ((m ^ (k + 1) : ℕ) : ℤ) = (m : ℤ) ^ (k + 1) := by push_cast; ring
    rwa [this] at hp
  choose D hDA hDB hdist hDcard using hlevel
  -- assemble
  have hcount := prod_le_card_wordBall T₀ (fun k => MilnorWolf.lcs Γ k)
    (fun k => (⊤ : Subgroup Γ).lowerCentralSeries_antitone (Nat.le_succ k)) D
    (fun k => r k * (8 ^ k * m)) hDA hDB hdist n
  have hprod : (∏ k ∈ Finset.range n, (2 * m ^ (k + 1) + 1) ^ (MilnorWolf.lcsRank Γ k))
      ≤ ∏ k ∈ Finset.range n, (D k).ncard :=
    Finset.prod_le_prod' fun k _ => hDcard k
  have harith := pow_sum_le_prod m hm (fun k => MilnorWolf.lcsRank Γ k)
    (fun k => MilnorWolf.lcsRank Γ k) (fun _ => le_refl _) n
  have hradius : (∑ k ∈ Finset.range n, r k * (8 ^ k * m)) ≤ B * m := by
    have : (∑ k ∈ Finset.range n, r k * (8 ^ k * m))
        = (∑ k ∈ Finset.range n, r k * 8 ^ k) * m := by
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun k _ => by ring
    rw [this, hB]
    nlinarith [Nat.zero_le (∑ k ∈ Finset.range n, r k * 8 ^ k), hm]
  calc m ^ (MilnorWolf.growthExponentOne Γ) = m ^ (∑ k ∈ Finset.range n, (k + 1) *
        MilnorWolf.lcsRank Γ k) := by rw [MilnorWolf.growthExponentOne, hn]
    _ ≤ ∏ k ∈ Finset.range n, (2 * m ^ (k + 1) + 1) ^ (MilnorWolf.lcsRank Γ k) := harith
    _ ≤ ∏ k ∈ Finset.range n, (D k).ncard := hprod
    _ ≤ Nat.card (wordBall (T₀ : Set Γ) (∑ k ∈ Finset.range n, r k * (8 ^ k * m))) := hcount
    _ ≤ Nat.card (wordBall (T₀ : Set Γ) (B * m)) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_le_ncard (wordBall_mono _ hradius) (finite_wordBall T₀ _)

/-- **Wolf's Theorem 3.2, lower bound.**  The count on the adapted generating set transfers to an
arbitrary one: every element of `T₀` is an `S`-word of bounded length, so the balls compare, and
the second half of Lemma 3.4 turns a bound along the multiples of a fixed radius into one for
every radius. -/
theorem exists_const_mul_pow_growthExponentOne_le_growthFunction_of_isNilpotent'
    [Group.FG Γ] [Group.IsNilpotent Γ] (S : Finset Γ)
    (hS : Subgroup.closure (S : Set Γ) = ⊤) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ, 1 ≤ m →
      c * (m : ℝ) ^ (MilnorWolf.growthExponentOne Γ)
        ≤ (MilnorWolf.growthFunction S m : ℝ) := by
  classical
  obtain ⟨T₀, B, hB, hgen, hcount⟩ := exists_pow_growthExponentOne_le_card_wordBall (Γ := Γ)
  obtain ⟨k, hk, hkball⟩ := exists_wordBall_subset T₀ S hS
  set L : ℕ := k * B with hL
  have hLpos : 0 < L := Nat.mul_pos hk hB
  have hLR : (0 : ℝ) < (L : ℝ) := by exact_mod_cast hLpos
  set E : ℕ := MilnorWolf.growthExponentOne Γ with hE
  refine exists_const_of_le_mul S L E (1 / (L : ℝ) ^ E) hLpos (by positivity) ?_
  intro m hm
  have hchain : m ^ E ≤ MilnorWolf.growthFunction S (L * m) := by
    refine le_trans (hcount m hm) ?_
    have hsub : wordBall (T₀ : Set Γ) (B * m) ⊆ wordBall (S : Set Γ) (L * m) := by
      have hb := hkball (B * m)
      rw [hL, Nat.mul_assoc]
      exact hb
    simp only [MilnorWolf.growthFunction, Nat.card_coe_set_eq]
    exact Set.ncard_le_ncard hsub (finite_wordBall S _)
  have hcast : (m : ℝ) ^ E ≤ (MilnorWolf.growthFunction S (L * m) : ℝ) := by exact_mod_cast hchain
  have hLm : ((L * m : ℕ) : ℝ) ^ E = (L : ℝ) ^ E * (m : ℝ) ^ E := by push_cast; ring
  rw [hLm]
  have hsimp : 1 / (L : ℝ) ^ E * ((L : ℝ) ^ E * (m : ℝ) ^ E) = (m : ℝ) ^ E := by
    field_simp
  rw [hsimp]
  exact hcast

end Lib
end Wolf

open Wolf

theorem solution {Γ : Type*}
    [Group Γ] [Group.FG Γ] [Group.IsNilpotent Γ] (S : Finset Γ)
    (hS : Subgroup.closure (S : Set Γ) = ⊤) :
    ∃ c : ℝ, 0 < c ∧ ∀ m : ℕ, 1 ≤ m →
      c * (m : ℝ) ^ (MilnorWolf.growthExponentOne Γ) ≤ (MilnorWolf.growthFunction S m : ℝ) :=
  Wolf.Lib.exists_const_mul_pow_growthExponentOne_le_growthFunction_of_isNilpotent' S hS
