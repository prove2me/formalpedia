def Em {I : Type*} (A : I → I → S110Q4) : Matrix I I ℂ := Matrix.of fun i j => ev (A i j)

def foldS {I : Type*} (l : List I) (f : I → S110Q4) : S110Q4 :=
  l.foldr (fun k acc => add (f k) acc) zero

def mulL {I : Type*} (l : List I) (A B : I → I → S110Q4) : I → I → S110Q4 :=
  fun i j => foldS l (fun k => mul (A i k) (B k j))

def ctL {I : Type*} (A : I → I → S110Q4) : I → I → S110Q4 := fun i j => cj (A j i)

theorem ev_foldS {I : Type*} (l : List I) (f : I → S110Q4) :
    ev (foldS l f) = (l.map (fun k => ev (f k))).sum := by
  induction l with
  | nil => simp [foldS, ev_zero]
  | cons a l ih => simp only [foldS, List.foldr_cons, ev_add, List.map_cons, List.sum_cons] at *; rw [ih]

theorem Em_mul {I : Type*} [Fintype I] [DecidableEq I] (l : List I) (hl : l.Nodup) (hall : ∀ i, i ∈ l)
    (A B : I → I → S110Q4) : Em A * Em B = Em (mulL l A B) := by
  ext i j
  simp only [Em, Matrix.mul_apply, Matrix.of_apply, mulL, ev_foldS, ev_mul]
  have hu : (Finset.univ : Finset I) = l.toFinset := by
    ext x; simp [hall x]
  rw [hu, List.sum_toFinset _ hl]

theorem Em_ct {I : Type*} (A : I → I → S110Q4) : (Em A)ᴴ = Em (ctL A) := by
  ext i j
  simp [Em, ctL, Matrix.conjTranspose_apply, ev_cj]

theorem Em_congr {I : Type*} {A B : I → I → S110Q4} (h : A = B) : Em A = Em B := by rw [h]

