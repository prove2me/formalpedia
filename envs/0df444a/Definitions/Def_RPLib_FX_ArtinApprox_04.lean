/-! ### piece ArA7c -/
section Piece_ArA7c


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA7c: `AA n` for all `n` (perfect `K`)

* `succ_core`: a system with a Jacobian datum `(h, U, G)` whose `δ·G` (`δ` the Tougeron minor) has a Weierstrass
  factorization in `x_0` is solved (`aSide_solution` + `bSide`).
* `AA.zero`: power series in no variables are constants.
* `AA.succ`: `jacobian_nested`, `G := x_0·G₀`, the coordinate change `τ_c` (`exists_weierstrass_tau`), `succ_core`
  on the transported system, `SolNbhd.of_ringEquiv` back.
* `AA.all`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Induction

variable {K : Type u} [Field K]

theorem succ_core {n N m r : ℕ} (hA : AA K n) (f : Fin m → MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K))
    (h : Fin r → MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K)) (U : Fin r → Fin N)
    (G : MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K)) (ŷ : Fin N → MvPowerSeries (Fin (n + 1)) K)
    (hh : ∀ j, MvPolynomial.aeval ŷ (h j) = 0) (hGf : ∀ j, G * f j ∈ Ideal.span (Set.range h))
    (hg0 : MvPowerSeries.constantCoeff
      (MvPolynomial.aeval ŷ ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G)) = 0)
    {P : Polynomial (MvPowerSeries (Fin n) K)} {V : PowerSeries (MvPowerSeries (Fin n) K)}
    (hPU : (MvPowerSeries.finSuccEquiv K n
      (MvPolynomial.aeval ŷ ((Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det * G))).IsWeierstrassFactorization
        P V) :
    SolNbhd (MvPolynomial.constantCoeff : MvPolynomial (Fin (n + 1)) K →+* K) f
      fun i => MvPowerSeries.constantCoeff (ŷ i) := by
  obtain ⟨hd, z, hz, hzP, hzR, hzV⟩ := aSide_solution h _ ŷ hh hg0 hPU
  exact bSide hA f h U G hGf _ hd z hz hzP hzR hzV

theorem AA.zero : AA K 0 := by
  classical
  intro N m f ŷ hf
  have hŷ : ∀ i, ŷ i = algebraMap (MvPolynomial (Fin 0) K) (MvPowerSeries (Fin 0) K)
      (MvPolynomial.C (MvPowerSeries.constantCoeff (ŷ i))) := by
    intro i
    rw [algebraMap_mvPolynomial_eq]
    ext d
    rw [MvPolynomial.coeff_coe, Subsingleton.elim d 0, MvPolynomial.coeff_C, if_pos rfl,
      MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
  have hy : (⇑(algebraMap (MvPolynomial (Fin 0) K) (MvPowerSeries (Fin 0) K)) ∘
      fun i => MvPolynomial.C (MvPowerSeries.constantCoeff (ŷ i))) = ŷ := funext fun i => (hŷ i).symm
  have hy0 : ∀ j, MvPolynomial.eval (fun i => MvPolynomial.C (MvPowerSeries.constantCoeff (ŷ i))) (f j) = 0 := by
    intro j
    have h2 : algebraMap (MvPolynomial (Fin 0) K) (MvPowerSeries (Fin 0) K)
        (MvPolynomial.eval (fun i => MvPolynomial.C (MvPowerSeries.constantCoeff (ŷ i))) (f j)) = 0 := by
      rw [MvPolynomial.eval₂_comp, ← MvPolynomial.aeval_def, hy]
      exact hf j
    rw [algebraMap_mvPolynomial_eq] at h2
    exact MvPolynomial.coe_injective (σ := Fin 0) (R := K) (h2.trans MvPolynomial.coe_zero.symm)
  have h3 := SolNbhd.refl (MvPolynomial.constantCoeff : MvPolynomial (Fin 0) K →+* K) (f := f)
    (fun i => MvPolynomial.C (MvPowerSeries.constantCoeff (ŷ i))) hy0
  simpa only [MvPolynomial.constantCoeff_C] using h3

theorem AA.succ [PerfectField K] {n : ℕ} (hA : AA K n) : AA K (n + 1) := by
  classical
  intro N m f ŷ hf
  haveI : IsDomain (MvPowerSeries (Fin (n + 1)) K) := NoZeroDivisors.to_isDomain _
  obtain ⟨r, h, T, hh, hδ, G₀, hG, hGI⟩ := jacobian_nested ŷ
  have hδ' : MvPolynomial.aeval ŷ (Matrix.of fun k j => MvPolynomial.pderiv (T k) (h j)).det ≠ 0 := by
    rw [← Matrix.det_transpose]
    exact hδ
  have hX : MvPolynomial.aeval ŷ
      (MvPolynomial.C (MvPolynomial.X 0) : MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K)) =
        MvPowerSeries.X 0 := by
    rw [MvPolynomial.aeval_C, algebraMap_mvPolynomial_eq, MvPolynomial.coe_X]
  have hX0 : (MvPowerSeries.X 0 : MvPowerSeries (Fin (n + 1)) K) ≠ 0 := by
    intro h0
    have h1 := congrArg (MvPowerSeries.coeff (Finsupp.single 0 1)) h0
    simp at h1
  obtain ⟨s, hs⟩ : ∃ s, s = MvPolynomial.aeval ŷ ((Matrix.of fun k j => MvPolynomial.pderiv (T k) (h j)).det *
      (MvPolynomial.C (MvPolynomial.X 0) * G₀)) := ⟨_, rfl⟩
  have hs0 : s ≠ 0 := by
    rw [hs, map_mul, map_mul, hX]
    exact mul_ne_zero hδ' (mul_ne_zero hX0 hG)
  have hcs : MvPowerSeries.constantCoeff s = 0 := by
    rw [hs, map_mul, map_mul (MvPolynomial.aeval ŷ) (MvPolynomial.C (MvPolynomial.X 0)) G₀, hX]
    simp
  obtain ⟨c, hc2, P, V, hPU⟩ := exists_weierstrass_tau s hs0
  have hc1 : 1 ≤ c := by omega
  have hh' : ∀ j, MvPolynomial.aeval (fun k => MvPowerSeries.subst (tauSub (K := K) c n) (ŷ k))
      (MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (h j)) = 0 := fun j => by
    rw [aeval_map_tau hc1, hh j, ← MvPowerSeries.coe_substAlgHom (hasSubst_tau (K := K) hc1 n), map_zero]
  have hGf' : ∀ j, MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (MvPolynomial.C (MvPolynomial.X 0) * G₀) *
      MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (f j) ∈
        Ideal.span (Set.range fun j => MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (h j)) := fun j => by
    rw [← map_mul]
    have h5 := Ideal.mem_map_of_mem (MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom)
      (show MvPolynomial.C (MvPolynomial.X 0) * G₀ * f j ∈ Ideal.span (Set.range h) by
        rw [mul_assoc]
        exact Ideal.mul_mem_left _ _ (hGI _ (hf j)))
    rw [Ideal.map_span, ← Set.range_comp] at h5
    exact h5
  have hg' : (Matrix.of fun k j => MvPolynomial.pderiv (T k)
      (MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (h j))).det *
        MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (MvPolynomial.C (MvPolynomial.X 0) * G₀) =
      MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom
        ((Matrix.of fun k j => MvPolynomial.pderiv (T k) (h j)).det * (MvPolynomial.C (MvPolynomial.X 0) * G₀)) := by
    rw [map_mul _ (Matrix.of fun k j => MvPolynomial.pderiv (T k) (h j)).det, RingHom.map_det]
    congr 2
    ext k j
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, MvPolynomial.pderiv_map]
  have hs' : MvPolynomial.aeval (fun k => MvPowerSeries.subst (tauSub (K := K) c n) (ŷ k))
      ((Matrix.of fun k j => MvPolynomial.pderiv (T k)
        (MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (h j))).det *
          MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (MvPolynomial.C (MvPolynomial.X 0) * G₀)) =
      MvPowerSeries.subst (tauSub (K := K) c n) s := by
    rw [hg', aeval_map_tau hc1, ← hs]
  have hg0' := hcs
  rw [← constantCoeff_subst_tau hc1 n, ← hs'] at hg0'
  rw [← hs'] at hPU
  have key := succ_core hA (fun j => MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (f j))
    (fun j => MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (h j)) T
    (MvPolynomial.map (tauEquiv c n).toRingEquiv.toRingHom (MvPolynomial.C (MvPolynomial.X 0) * G₀))
    (fun k => MvPowerSeries.subst (tauSub (K := K) c n) (ŷ k)) hh' hGf' hg0' hPU
  have hres : (fun i => MvPowerSeries.constantCoeff (MvPowerSeries.subst (tauSub (K := K) c n) (ŷ i))) =
      fun i => MvPowerSeries.constantCoeff (ŷ i) := funext fun i => constantCoeff_subst_tau hc1 n (ŷ i)
  beta_reduce at key
  rw [hres] at key
  exact SolNbhd.of_ringEquiv (tauEquiv c n).toRingEquiv (constantCoeff_tau hc1 n) key

theorem AA.all [PerfectField K] (n : ℕ) : AA K n := by
  induction n with
  | zero => exact AA.zero
  | succ n ih => exact AA.succ ih

end Induction

end RamanujanPetersson.EtPBC.Cov
