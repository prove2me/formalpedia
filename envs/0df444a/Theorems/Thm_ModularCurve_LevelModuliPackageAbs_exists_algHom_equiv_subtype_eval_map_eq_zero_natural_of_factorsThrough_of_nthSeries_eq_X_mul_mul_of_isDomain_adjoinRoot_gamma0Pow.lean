      ∀ (T : Type) [CommRing T] [IsLocalRing T] [IsArtinianRing T] [Algebra W₀ T]
        (hT : Function.Surjective (⇑(residue T) ∘ ⇑(algebraMap W₀ T)))
        (T' : Type) [CommRing T'] [IsLocalRing T'] [IsArtinianRing T'] [Algebra W₀ T']
        (hT' : Function.Surjective (⇑(residue T') ∘ ⇑(algebraMap W₀ T')))
        (f : T →ₐ[W₀] T') (φ : R →ₐ[W₀] T),
        ((η T' hT' (f.comp φ)).1 : (S →ₐ[W₀] T') × T') = (f.comp (η T hT φ).1.1, f (η T hT φ).1.2) := by sorry
