section T

variable (p : ℕ) (J : Type) [AddCommGroup J] [Module HeckeAlg J]

omit [Module HeckeAlg J] in

theorem nsmul_eq_of_mod_eq {n a b : ℕ} (hab : a % p ^ n = b % p ^ n) {y : J}
    (hy : p ^ n • y = 0) : a • y = b • y := by
  have key : ∀ c : ℕ, (c % p ^ n) • y = c • y := by
    intro c
    conv_rhs => rw [← Nat.div_add_mod c (p ^ n), add_smul, mul_comm, mul_smul, hy, smul_zero,
      zero_add]
  rw [← key a, hab, key b]

def evalk (k : ℕ) : ModularCurve.TateModule p J →+ J where
  toFun x := (x : ℕ → J) k
  map_zero' := rfl
  map_add' _ _ := rfl

@[scoped simp] theorem evalk_apply (k : ℕ) (x : ModularCurve.TateModule p J) :
    evalk p J k x = (x : ℕ → J) k := rfl

theorem evalk_mem_torsionBy (k : ℕ) (x : ModularCurve.TateModule p J) :
    evalk p J k x ∈ Submodule.torsionBy ℤ J ((p : ℤ) ^ k) := by
  rw [Submodule.mem_torsionBy_iff, evalk_apply, ← Nat.cast_pow, natCast_zsmul]
  exact ModularCurve.TateModule.pow_smul_apply x.2 k

def evalkT (k : ℕ) : ModularCurve.TateModule p J →+ ↥(Submodule.torsionBy ℤ J ((p : ℤ) ^ k)) :=
  (evalk p J k).codRestrict (Submodule.torsionBy ℤ J ((p : ℤ) ^ k)) (evalk_mem_torsionBy p J k)

@[scoped simp] theorem coe_evalkT_apply (k : ℕ) (x : ModularCurve.TateModule p J) :
    ((evalkT p J k x : ↥(Submodule.torsionBy ℤ J ((p : ℤ) ^ k))) : J) = (x : ℕ → J) k := rfl

section Galois

variable {G : Type} [Group G] [DistribMulAction G J]

theorem evalk_smul (g : G) (k : ℕ) (x : ModularCurve.TateModule p J) :
    evalk p J k ⟨g • (x : ℕ → J), ModularCurve.TateModule.smul_mem g x.2⟩ = g • evalk p J k x := rfl

end Galois
