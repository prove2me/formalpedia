open ModularCurve

theorem ModPForms.exists_mem_modPCusp_ofPowerSeries_eq_qexpOfWeight_of_isModPCuspFormFn
    (p : ℕ) [Fact p.Prime] (hp5 : 5 ≤ p) (N : ℕ) [NeZero N] (hpN : ¬ p ∣ N)
    (K : Type) [Field K] [CharP K p] (m : ℕ)
    (G : ↥(modularFunctionFieldC K N)) (hG : IsModPCuspFormFn K m (G : LaurentSeries K)) :
    ∃ φ : PowerSeries K, φ ∈ ModPForms.modPCusp N (2 * (m : ℤ)) K ∧
      HahnSeries.ofPowerSeries ℤ K φ = qexpOfWeight K (m : ℤ) (G : LaurentSeries K) := by sorry
