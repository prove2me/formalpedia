  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  rw [Nat.ceil_eq_iff (by omega)]
  constructor
  · by_contra h
    push Not at h
    have := (Real.rpow_inv_le_iff_of_pos (Nat.cast_nonneg _) (Nat.cast_nonneg _) hm').1
      (by rw [← one_div]; exact h)
    rw [Real.rpow_natCast] at this
    have : X ≤ (a - 1) ^ m := by exact_mod_cast this
    omega
  · rw [one_div, Real.rpow_inv_le_iff_of_pos (Nat.cast_nonneg _) (Nat.cast_nonneg _) hm',
      Real.rpow_natCast]
    exact_mod_cast h2

end

