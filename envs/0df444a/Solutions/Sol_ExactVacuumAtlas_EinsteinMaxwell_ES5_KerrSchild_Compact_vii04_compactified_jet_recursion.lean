/-- Undivided elimination identity: no division by `M`, `J`, `Q`, `h` or `c`. -/
theorem elimination_identity (M h J Q c : ℝ) :
    ((32 : ℝ) / 15) * J ^ 3 * Q ^ 5 =
      ((3 : ℝ) / 4) * elimS M h J Q c * C6 M h J Q c
      - Q * M ^ 3 * C8 M h J Q c
      + Q * M ^ 3 * elimA M h J Q c * C7 M h J Q c := by
  unfold C6 C7 C8 elimA elimS
  ring

theorem obstruction_of_three_coefficients (M h J Q c : ℝ)
    (h6 : C6 M h J Q c = 0) (h7 : C7 M h J Q c = 0)
    (h8 : C8 M h J Q c = 0) : J ^ 3 * Q ^ 5 = 0 := by
  have hid := elimination_identity M h J Q c
  rw [h6, h7, h8] at hid
  linear_combination ((15 : ℝ) / 32) * hid

theorem zero_branch_of_three_coefficients (M h J Q c : ℝ)
    (h6 : C6 M h J Q c = 0) (h7 : C7 M h J Q c = 0)
    (h8 : C8 M h J Q c = 0) : J = 0 ∨ Q = 0 := by
  have hz := obstruction_of_three_coefficients M h J Q c h6 h7 h8
  rcases mul_eq_zero.mp hz with hj | hq
  · exact Or.inl (pow_eq_zero_iff (by norm_num) |>.mp hj)
  · exact Or.inr (pow_eq_zero_iff (by norm_num) |>.mp hq)

