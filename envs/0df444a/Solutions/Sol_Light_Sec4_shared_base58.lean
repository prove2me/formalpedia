  obtain ⟨htrue, hfalse⟩ := count_take_maskOf Q n
  rw [List.getElem_ofFn, ← List.getD_eq_getElem _ 0 hweave, getD_weaveList,
    if_pos (by rwa [length_maskOf]), htrue, hfalse, getD_maskOf Q hn]
