theorem norm_sub_multipliable {I : Type*} (a : I → ℂ)
    (h : Summable (fun i => ‖a i-1‖)) : Multipliable a := by
  have hp := Summable.hasProdUniformlyOn_one_add
    (f := fun i (_ : ℂ) => a i-1) (u := fun i => ‖a i-1‖)
    (K := ({0} : Set ℂ)) isCompact_singleton h
    (Filter.Eventually.of_forall (fun i z hz => le_rfl))
    (fun i => continuous_const.continuousOn)
  have hh := (hp.hasProd (Set.mem_singleton (0 : ℂ))).multipliable
  simpa using hh

theorem split_products {I J : Type*} (a : J → ℂ) (e : I ⊕ I ≃ J)
    (h : Summable (fun j => ‖a j-1‖)) :
    Multipliable (fun i => a (e (Sum.inl i))) ∧
    Multipliable (fun i => a (e (Sum.inr i))) ∧
    (∏' j, a j) = (∏' i, a (e (Sum.inl i))) * (∏' i, a (e (Sum.inr i))) := by
  have hl := h.comp_injective (e.injective.comp Sum.inl_injective)
  have hr := h.comp_injective (e.injective.comp Sum.inr_injective)
  have hpl := norm_sub_multipliable (fun i => a (e (Sum.inl i))) hl
  have hpr := norm_sub_multipliable (fun i => a (e (Sum.inr i))) hr
  refine ⟨hpl,hpr,?_⟩
  rw [← e.tprod_eq a]
  exact hpl.tprod_sum hpr
