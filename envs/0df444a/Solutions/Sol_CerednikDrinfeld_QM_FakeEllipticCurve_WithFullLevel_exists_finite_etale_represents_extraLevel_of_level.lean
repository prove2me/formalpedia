section ZModCount

theorem natCard_nsmul_eq_zero_zmod (n d : ℕ) [NeZero n] (hd : d ∣ n) :
    Nat.card {a : ZMod n // d • a = 0} = d := by
  obtain ⟨m, hm⟩ := hd
  have hn : n ≠ 0 := NeZero.ne n
  have hm0 : m ≠ 0 := by rintro rfl; rw [mul_zero] at hm; exact hn hm
  have hd0 : d ≠ 0 := by rintro rfl; rw [zero_mul] at hm; exact hn hm
  let φ : ZMod n →+ ZMod n := DistribSMul.toAddMonoidHom (ZMod n) d
  have hφ : ∀ a : ZMod n, φ a = d • a := fun a => rfl
  have hker : Nat.card φ.ker = Nat.card {a : ZMod n // d • a = 0} := by
    apply Nat.card_congr
    exact Equiv.subtypeEquivRight (fun a => by rw [AddMonoidHom.mem_ker, hφ])
  have hrange : φ.range = AddSubgroup.zmultiples ((d : ℕ) : ZMod n) := by
    ext x
    simp only [AddMonoidHom.mem_range, hφ, AddSubgroup.mem_zmultiples_iff]
    constructor
    · rintro ⟨a, rfl⟩
      refine ⟨(a.val : ℤ), ?_⟩
      rw [nsmul_eq_mul, zsmul_eq_mul, Int.cast_natCast, ZMod.natCast_zmod_val, mul_comm]
    · rintro ⟨z, rfl⟩
      refine ⟨(z : ZMod n), ?_⟩
      rw [nsmul_eq_mul, zsmul_eq_mul, mul_comm]
  have hcr : Nat.card φ.range = m := by
    rw [hrange, Nat.card_zmultiples, ZMod.addOrderOf_coe _ hn, hm, Nat.gcd_mul_right_left,
      Nat.mul_div_cancel_left _ (Nat.pos_of_ne_zero hd0)]
  have htot : Nat.card (ZMod n) = Nat.card φ.ker * Nat.card φ.range := by
    rw [← Nat.card_congr (QuotientAddGroup.quotientKerEquivRange φ).toEquiv, mul_comm,
      ← AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup]
  have h2 : Nat.card φ.ker * m = d * m := by
    have h3 := htot
    rw [Nat.card_zmod, hcr] at h3
    rw [← h3]; exact hm
  rw [← hker]
  exact Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero hm0) h2

theorem natCard_nsmul_eq_zero_zmod_prod (n d : ℕ) [NeZero n] (hd : d ∣ n) :
    Nat.card {x : ZMod n × ZMod n // d • x = 0} = d ^ 2 := by
  have e : {x : ZMod n × ZMod n // d • x = 0} ≃ {a : ZMod n // d • a = 0} × {a : ZMod n // d • a = 0} :=
    { toFun := fun x => (⟨x.1.1, (Prod.ext_iff.mp x.2).1⟩, ⟨x.1.2, (Prod.ext_iff.mp x.2).2⟩)
      invFun := fun p => ⟨(p.1.1, p.2.1), by rw [Prod.smul_mk, p.1.2, p.2.2]; rfl⟩
      left_inv := fun x => rfl
      right_inv := fun p => rfl }
  rw [Nat.card_congr e, Nat.card_prod, natCard_nsmul_eq_zero_zmod n d hd, pow_two]

end ZModCount
