variable {R : Type*} [CommRing R] {m : ℕ} {Wr : Type*} [Fintype Wr] [DecidableEq Wr] {U : Type*}
  (N : ℕ)

theorem IntMul.Kappa.R6.Bit.formal_labels : ∀ (prog : List (Instr Wr R m)) (L : Wr → FMat m N) (φ : Wr → FV R U m N),
    LabGates N prog L →
      prog.foldl (fStep N) (fun w => lmulF (L w) (φ w)) =
        fun w => lmulF (prog.foldl (labStepH N) L w) (prog.foldl scalarStepM φ w) := by sorry
