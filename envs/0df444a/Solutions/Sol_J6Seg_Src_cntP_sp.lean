theorem cntP_sp_sol_aux (s0 : IState HS) (F : Fin HS → List ℤ) {iPre iPost iN : Fin HS}
    (h1 : iPre.val < 56) (h2 : iPost.val < 56) (h3 : iN.val < 56)
    (d1 : iPre ≠ 37 ∧ iPre ≠ 39) (d2 : iPost ≠ 37 ∧ iPost ≠ 39) (d3 : iN ≠ 37 ∧ iN ≠ 39)
    {pre post n' A : ℕ} {L1 L2 L3 : List ℤ}
    (hG1 : F iPre = (pre : ℤ) :: L1) (hG2 : F iPost = (post : ℤ) :: L2) (hG3 : F iN = (n' : ℤ) :: L3)
    (hpA : pre ≤ 2 ^ A) (hqA : post ≤ 2 ^ A) (hnA : n' ≤ 2 ^ A) (hA : 2 ≤ A) :
    Sp (cntP iPre iPost iN) (encK s0 F) (encK s0 (cntOut F pre post n')) (30 * uC A DD) := by
  have a1 : (encK s0 F).top iPre = pre ∧ (encK s0 F).IsInt iPre := ⟨topv hG1, isInt_encK hG1⟩
  have k1 := pushP s0 F (i := 37) (e := .reg iPre) (v := pre) (A := A) (D := DD) (by decide)
    (fun r hr => by simp [Ex.regs] at hr; subst hr; exact h1) a1.2 a1.1
    (fun r hr => by simp [Ex.regs] at hr; subst hr; rw [a1.1]; exact abs_nat_le hpA) hA
    (by simp [J6Seg.PreT.Poly]) (by simp [J6Seg.PreT.dg, DD])
  have q2 : update F 37 ((pre : ℤ) :: F 37) iPost = (post : ℤ) :: L2 := by
    rw [update_of_ne d2.1]; exact hG2
  have b2 : (encK s0 (update F 37 ((pre : ℤ) :: F 37))).top iPost = post ∧
      (encK s0 (update F 37 ((pre : ℤ) :: F 37))).IsInt iPost := ⟨topv q2, isInt_encK q2⟩
  have k2 := pushP s0 (update F 37 ((pre : ℤ) :: F 37)) (i := 39) (e := .add (.reg iPost) (.reg iPost))
    (v := ((2 * post : ℕ) : ℤ)) (A := A) (D := DD) (by decide)
    (fun r hr => by simp [Ex.regs] at hr; subst hr; exact h2) ⟨b2.2, b2.2⟩
    (by simp only [Ex.eval, b2.1]; push_cast; ring)
    (fun r hr => by simp [Ex.regs] at hr; subst hr; rw [b2.1]; exact abs_nat_le hqA) hA
    (by simp [J6Seg.PreT.Poly]) (by simp [J6Seg.PreT.dg, DD])
  rw [update_of_ne (show (39 : Fin HS) ≠ 37 by decide)] at k2
  set F2 := update (update F 37 ((pre : ℤ) :: F 37)) 39 (((2 * post : ℕ) : ℤ) :: F 39) with hF2
  have q1 : F2 iPre = (pre : ℤ) :: L1 := by
    rw [hF2, update_of_ne d1.2, update_of_ne d1.1]; exact hG1
  have q2' : F2 iPost = (post : ℤ) :: L2 := by
    rw [hF2, update_of_ne d2.2, update_of_ne d2.1]; exact hG2
  have q3 : F2 iN = (n' : ℤ) :: L3 := by
    rw [hF2, update_of_ne d3.2, update_of_ne d3.1]; exact hG3
  have k3 := pushP s0 F2 (i := 40) (e := .mul (.reg iPre) (.mul (.reg iN) (.add (.reg iPost) (.reg iPost))))
    (v := ((pre * (n' * (2 * post)) : ℕ) : ℤ)) (A := A) (D := DD) (by decide)
    (fun r hr => by
      simp only [Ex.regs, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hr
      repeat' rcases hr with hr | hr
      all_goals assumption)
    ⟨isInt_encK q1, isInt_encK q3, isInt_encK q2', isInt_encK q2'⟩
    (by simp only [Ex.eval, topv q1, topv q2', topv q3]; push_cast; ring)
    (fun r hr => by
      simp only [Ex.regs, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hr
      repeat' rcases hr with hr | hr
      all_goals first
        | (rw [topv q1]; exact abs_nat_le hpA)
        | (rw [topv q3]; exact abs_nat_le hnA)
        | (rw [topv q2']; exact abs_nat_le hqA)) hA
    (by simp [J6Seg.PreT.Poly]) (by simp [J6Seg.PreT.dg, DD])
  have e3 : F2 40 = F 40 := by
    rw [hF2, update_of_ne (by decide), update_of_ne (by decide)]
  rw [e3] at k3
  refine (k1.seq (k2.seq k3)).mono ?_
  simp only [Ex.size]
  generalize uC A DD = u
  nlinarith

end J6Seg.Src

