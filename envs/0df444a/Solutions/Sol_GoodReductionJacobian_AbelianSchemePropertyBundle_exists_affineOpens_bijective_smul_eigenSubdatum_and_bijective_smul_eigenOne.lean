namespace EigenFramesRed

open TopologicalSpace Opposite

variable {K : Type u} [Field K] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of K)}
  (L : RelativeGroupLaw K f) (n : ℕ)
  (hG : ∀ x ∈ L.torsionSubset (𝟙 (Spec (CommRingCat.of K))) n, L.translate x ≫ L.schemeNsmul n = L.schemeNsmul n)

abbrev phi (U : A.Opens) : Γ(A, U) ⟶ Γ(A, (L.schemeNsmul n) ⁻¹ᵁ U) :=
  (L.schemeNsmul n).appLE U ((L.schemeNsmul n) ⁻¹ᵁ U) le_rfl

abbrev val {χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K} {U : A.Opens}
    (s : (L.eigenSubdatum n hG χ).obj U) : Γ(A, (L.schemeNsmul n) ⁻¹ᵁ U) := s.1

theorem val_injective {χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K} {U : A.Opens}
    {s t : (L.eigenSubdatum n hG χ).obj U} (h : val L n hG s = val L n hG t) : s = t :=
  Subtype.ext h

theorem val_smul (χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K) (U : A.Opens) (a : Γ(A, U))
    (s : (L.eigenSubdatum n hG χ).obj U) :
    val L n hG (a • s) = (phi L n U).hom a * val L n hG s := rfl

theorem val_eigenOne (U : A.Opens) : val L n hG (L.eigenOne n hG U) = 1 := rfl

theorem val_res (χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K) {U U' : A.Opens} (h : U ≤ U')
    (s : (L.eigenSubdatum n hG χ).obj U') :
    val L n hG ((L.eigenSubdatum n hG χ).res h s) =
      (A.presheaf.map (homOfLE ((Opens.map (L.schemeNsmul n).base).monotone h)).op).hom (val L n hG s) := rfl

theorem val_eigenMul {χ ψ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K} {U : A.Opens}
    (s : (L.eigenSubdatum n hG χ).obj U) (t : (L.eigenSubdatum n hG ψ).obj U) :
    val L n hG (L.eigenMul n hG s t) = val L n hG s * val L n hG t := rfl

theorem deckApp_val {χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K} {U : A.Opens}
    (s : (L.eigenSubdatum n hG χ).obj U)
    (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f) (hx : x ∈ L.torsionSubset (𝟙 (Spec (CommRingCat.of K))) n) :
    (L.deckApp n x (hG x hx) U).hom (val L n hG s) = L.nsmulConst n U (χ x) * val L n hG s :=
  s.2 x hx

theorem nsmulConst_one (U : A.Opens) : L.nsmulConst n U 1 = 1 := by
  rw [RelativeGroupLaw.nsmulConst_def, map_one, map_one]

theorem isUnit_res (χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K) {U U' : A.Opens} (h : U ≤ U')
    (s : (L.eigenSubdatum n hG χ).obj U') (hs : IsUnit (val L n hG s)) :
    IsUnit (val L n hG ((L.eigenSubdatum n hG χ).res h s)) := by
  rw [val_res]
  exact hs.map _

theorem isUnit_eigenMul {χ ψ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K} {U : A.Opens}
    (s : (L.eigenSubdatum n hG χ).obj U) (t : (L.eigenSubdatum n hG ψ).obj U)
    (hs : IsUnit (val L n hG s)) (ht : IsUnit (val L n hG t)) :
    IsUnit (val L n hG (L.eigenMul n hG s t)) := by
  rw [val_eigenMul]
  exact hs.mul ht

section WithBase

variable (U : A.Opens) (hb : Function.Bijective (fun a : Γ(A, U) => a • L.eigenOne n hG U))

include hb

theorem phi_injective : Function.Injective (phi L n U).hom := by
  intro a b hab
  apply hb.1
  apply val_injective L n hG
  rw [val_smul, val_smul, hab]

theorem exists_phi_eq_of_invariant (s : Γ(A, (L.schemeNsmul n) ⁻¹ᵁ U))
    (hs : ∀ (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f)
      (hx : x ∈ L.torsionSubset (𝟙 (Spec (CommRingCat.of K))) n), (L.deckApp n x (hG x hx) U).hom s = s) :
    ∃ a : Γ(A, U), (phi L n U).hom a = s := by
  have hmem : ∀ (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f)
      (hx : x ∈ L.torsionSubset (𝟙 (Spec (CommRingCat.of K))) n),
      (L.deckApp n x (hG x hx) U).hom s = L.nsmulConst n U ((1 : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K) x) * s := by
    intro x hx
    rw [hs x hx, Pi.one_apply, nsmulConst_one, _root_.one_mul]
  let m : (L.eigenSubdatum n hG 1).obj U := ⟨s, hmem⟩
  obtain ⟨a, ha⟩ := hb.2 m
  refine ⟨a, ?_⟩
  have h1 := val_smul L n hG 1 U a (L.eigenOne n hG U)
  rw [val_eigenOne, _root_.mul_one] at h1
  rw [← h1]
  exact congrArg (val L n hG) ha

theorem bijective_smul_of_isUnit (χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K)
    (σ : (L.eigenSubdatum n hG χ).obj U) (hσ : IsUnit (val L n hG σ)) :
    Function.Bijective (fun a : Γ(A, U) => a • σ) := by
  constructor
  · intro a b hab
    have h1 := congrArg (val L n hG) hab
    simp only [val_smul] at h1
    exact phi_injective L n hG U hb (hσ.mul_right_cancel h1)
  · intro m
    obtain ⟨u, hu⟩ := hσ
    have hinv : ∀ (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f)
        (hx : x ∈ L.torsionSubset (𝟙 (Spec (CommRingCat.of K))) n),
        (L.deckApp n x (hG x hx) U).hom (val L n hG m * ↑u⁻¹) = val L n hG m * ↑u⁻¹ := by
      intro x hx
      have hm := deckApp_val L n hG m x hx
      have hs : (L.deckApp n x (hG x hx) U).hom ↑u = L.nsmulConst n U (χ x) * ↑u := by
        rw [hu]; exact deckApp_val L n hG σ x hx
      have h1 : (L.deckApp n x (hG x hx) U).hom ↑u⁻¹ * (L.deckApp n x (hG x hx) U).hom ↑u = 1 := by
        rw [← map_mul, Units.inv_mul, map_one]
      rw [hs] at h1
      have key : (L.deckApp n x (hG x hx) U).hom ↑u⁻¹ * L.nsmulConst n U (χ x) = ↑u⁻¹ := by
        calc (L.deckApp n x (hG x hx) U).hom ↑u⁻¹ * L.nsmulConst n U (χ x)
            = (L.deckApp n x (hG x hx) U).hom ↑u⁻¹ * L.nsmulConst n U (χ x) *
                ((↑u : Γ(A, (L.schemeNsmul n) ⁻¹ᵁ U)) * ↑u⁻¹) := by
              rw [Units.mul_inv, _root_.mul_one]
          _ = ((L.deckApp n x (hG x hx) U).hom ↑u⁻¹ * (L.nsmulConst n U (χ x) * ↑u)) * ↑u⁻¹ := by ring
          _ = ↑u⁻¹ := by rw [h1, _root_.one_mul]
      rw [map_mul, hm]
      calc L.nsmulConst n U (χ x) * val L n hG m * (L.deckApp n x (hG x hx) U).hom ↑u⁻¹
          = val L n hG m * ((L.deckApp n x (hG x hx) U).hom ↑u⁻¹ * L.nsmulConst n U (χ x)) := by ring
        _ = val L n hG m * ↑u⁻¹ := by rw [key]
    obtain ⟨a, ha⟩ := exists_phi_eq_of_invariant L n hG U hb (val L n hG m * ↑u⁻¹) hinv
    refine ⟨a, val_injective L n hG ?_⟩
    rw [val_smul, ha, ← hu, Units.inv_mul_cancel_right]

end WithBase

