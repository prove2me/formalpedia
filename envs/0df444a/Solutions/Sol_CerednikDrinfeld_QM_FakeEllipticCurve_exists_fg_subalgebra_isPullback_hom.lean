theorem solution
    {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (N : ℕ) (R : Type) [CommRing R] (E : FakeEllipticCurve Λ N R) :
    ∃ (T : Subalgebra ℤ R) (_ : T.FG) (ET : FakeEllipticCurve Λ N ↥T) (g : E.A ⟶ ET.A)
      (hg : CategoryTheory.IsPullback g E.f ET.f (Spec.map (CommRingCat.ofHom T.val.toRingHom))),
      (∀ {X : Scheme.{0}} (t' : X ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t' E.f),
        (E.L.mul t' P Q).1 ≫ g =
          (ET.L.mul (t' ≫ Spec.map (CommRingCat.ofHom T.val.toRingHom))
            ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1) ∧
      (∀ x : ↥Λ, E.act x ≫ g = g ≫ ET.act x) := by
  classical

  obtain ⟨S₀, _, _, hft, E₀, g, hg, hlaw, hact, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_finiteType_int_isPullback Λ hΛ N R E
  haveI := hft

  let φ₀ : S₀ →ₐ[ℤ] R := (algebraMap S₀ R).toIntAlgHom
  let T : Subalgebra ℤ R := (⊤ : Subalgebra ℤ S₀).map φ₀
  have hTfg : T.FG := (Algebra.FiniteType.out : (⊤ : Subalgebra ℤ S₀).FG).map φ₀
  let ψ : S₀ →ₐ[ℤ] ↥T := φ₀.codRestrict T (fun x => Subalgebra.mem_map.mpr ⟨x, trivial, rfl⟩)
  have hcomp : T.val.toRingHom.comp ψ.toRingHom = algebraMap S₀ R := RingHom.ext fun _ => rfl
  have hbase : Spec.map (CommRingCat.ofHom (algebraMap S₀ R)) =
      Spec.map (CommRingCat.ofHom T.val.toRingHom) ≫ Spec.map (CommRingCat.ofHom ψ.toRingHom) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]

  obtain ⟨ET, h, hh, hlawh, hacth, -, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff ψ.toRingHom E₀
  let gT : E.A ⟶ ET.A := hh.lift g (E.f ≫ Spec.map (CommRingCat.ofHom T.val.toRingHom)) (by rw [hg.w, hbase, Category.assoc])
  have hg1 : gT ≫ h = g := hh.lift_fst _ _ _
  have hg2 : gT ≫ ET.f = E.f ≫ Spec.map (CommRingCat.ofHom T.val.toRingHom) := hh.lift_snd _ _ _
  have hgT : IsPullback gT E.f ET.f (Spec.map (CommRingCat.ofHom T.val.toRingHom)) := by
    have big : IsPullback (gT ≫ h) E.f E₀.f
        (Spec.map (CommRingCat.ofHom T.val.toRingHom) ≫ Spec.map (CommRingCat.ofHom ψ.toRingHom)) := by
      rw [hg1, ← hbase]; exact hg
    exact IsPullback.of_right big hg2 hh
  refine ⟨T, hTfg, ET, gT, hgT, ?_, ?_⟩
  · intro X t' P Q
    apply hh.hom_ext
    · rw [Category.assoc, hg1, hlaw t' P Q, hlawh]
      refine mul_val_congr E₀.L ?_ _ _ _ _ ?_ ?_
      · rw [Category.assoc, ← hbase]
      · simp only [Category.assoc, hg1]
      · simp only [Category.assoc, hg1]
    · conv_lhs => rw [Category.assoc, hg2, ← Category.assoc, (E.L.mul t' P Q).2]
      exact ((ET.L.mul (t' ≫ Spec.map (CommRingCat.ofHom T.val.toRingHom)) _ _).2).symm
  · intro x
    apply hh.hom_ext
    · rw [Category.assoc, hg1, hact, Category.assoc, hacth, ← Category.assoc, hg1]
    · rw [Category.assoc, hg2, ← Category.assoc, E.act_over, Category.assoc, ET.act_over, hg2]

