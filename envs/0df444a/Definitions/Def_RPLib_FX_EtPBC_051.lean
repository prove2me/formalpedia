-- ===== S4.Def_RP_EtPBC_A_O2Gl1c =====
section

/-!
# S4-EtPBC-A, O2 GLOB (O2Gl1c): the geometric inputs of stages S1-S2

GLOB/REL PLAN v1, stage S1. For an affine `X` with `g : X ⟶ Spec A` etale (`A` a domain, e.g. `A = k[X]`):
* `gamMap g : A →+* Γ(X)`;
* `exists_frac_dvd` (3a): `u ≠ 0` in `Frac(Γ(X) ⧸ p)` is `x / y` with `x ∣ c_x`, `y ∣ c_y`, `c_x, c_y ∈ A ∖ 0`;
* `toPiQ_gamMap_ne_zero`: a nonzero `r ∈ A` is nonzero on every piece (flatness);
* `exists_L` (3b): one `L ≠ 0` with `L^N y` integral over `A` for every `y`;
* `mem_adjoin_wm` (Gen): `Γ(W₁) = B'[Γ(W)]` along a chart map `d` with `d.left = Spec.map ι`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits

noncomputable section

namespace RamanujanPetersson.EtPBC.EtKum

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.EtMV
  RamanujanPetersson.EtPBC.EtShap

open scoped nonZeroDivisors

universe u

section Gam

variable {A : Type u} [CommRing A] {X : Scheme.{u}} [IsAffine X] (g : X ⟶ Spec (CommRingCat.of A)) [Etale g]

variable [IsDomain A]

/-- (3a) **`u = x / y` with `x ∣ c_x`, `y ∣ c_y`** for `c_x, c_y ∈ A ∖ 0`. -/
theorem exists_frac_dvd (p : minimalPrimes Γ(X, ⊤)) {u : FractionRing (Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤)))} (hu : u ≠ 0) :
    ∃ x y : Γ(X, ⊤), Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) x ≠ 0 ∧ Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) y ≠ 0 ∧
      u = algebraMap _ _ (Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) x) /
        algebraMap _ _ (Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) y) ∧
      ∃ cx cy : A, cx ≠ 0 ∧ cy ≠ 0 ∧
        Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) x ∣ Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) (gamMap g cx) ∧
        Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) y ∣ Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) (gamMap g cy) := by
  let _ : Algebra A Γ(X, ⊤) := gamAlg g
  have : Algebra.Etale A Γ(X, ⊤) := etale_gamAlg g
  have : Algebra.IsAlgebraic A Γ(X, ⊤) := algebra_isAlgebraic_of_etale
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := Γ(X, ⊤) ⧸ (p : Ideal Γ(X, ⊤))) u
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective b
  have hy0 : Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) y ≠ 0 := nonZeroDivisors.ne_zero hb
  have hx0 : Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) x ≠ 0 := by
    rintro h
    apply hu
    rw [h, map_zero, zero_div]
  have halg : ∀ z : Γ(X, ⊤), IsAlgebraic A (Ideal.Quotient.mk (p : Ideal Γ(X, ⊤)) z) := fun z =>
    (Algebra.IsAlgebraic.isAlgebraic z).algHom (Ideal.Quotient.mkₐ A (p : Ideal Γ(X, ⊤)))
  obtain ⟨cx, hcx, hx⟩ := exists_dvd_algebraMap (mem_nonZeroDivisors_of_ne_zero hx0) (halg x)
  obtain ⟨cy, hcy, hy⟩ := exists_dvd_algebraMap (mem_nonZeroDivisors_of_ne_zero hy0) (halg y)
  exact ⟨x, y, hx0, hy0, rfl, cx, cy, hcx, hcy, hx, hy⟩

end Gam

section Gen

end Gen

end RamanujanPetersson.EtPBC.EtKum

end

