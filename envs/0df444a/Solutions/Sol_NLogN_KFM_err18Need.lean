    unfold sOf; rw [Int.toNat_of_nonneg hm]; have := Int.mul_ediv_add_emod e (2 * (r : ℤ)); linarith
  have hu2 : (y ^ (2 * (r : ℤ)) : Rˣ) = 1 := by
    rw [show (2 * (r : ℤ)) = ((2 * r : ℕ) : ℤ) by push_cast; ring, zpow_natCast, hu]
  have key : (y ^ e : Rˣ) = y ^ (sOf r e) := by
    conv_lhs => rw [he]
    rw [zpow_add, zpow_mul, hu2, one_zpow, one_mul, zpow_natCast]
  unfold yp
