variable {R : Type} [CommRing R] {d n : ℕ}
variable {ι : Type} [Fintype ι]

theorem GlobalTheory.dmonN_smul (F : Fin d → PS R 2 d) (cp : ι → Fin n) (u : ι → Fin d → R) (m : ι →₀ ℕ)
    (t : R) (f : PS R n d) :
    DmonN F cp u m (t • f) = t • DmonN F cp u m f := by sorry
