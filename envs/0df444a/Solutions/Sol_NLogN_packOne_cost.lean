    (hM : s.G CM = .int L.length :: LM) (hL : ∀ x ∈ L, 0 ≤ x ∧ x < 2 ^ b)
    (hb1 : 1 ≤ b) (hbQ : b ≤ Q) (hMQ : zsz (L.length : ℤ) ≤ Q)
    (h1 : Ei ≠ CA) (h2 : Ei ≠ CY) (h3 : Ei ≠ CR) (h4 : Ei ≠ CM) (h5 : Ei ≠ EC) (h6 : Ei ≠ X)
    (h7 : X ≠ CA) (h8 : X ≠ CY) (h9 : X ≠ CR) (h10 : X ≠ CM) (h11 : X ≠ EC) :
    (packOne Ei X).cost M s ≤ 200000 * (L.length + 1) * (Q + 3) +
      30000 * (b * L.length + Q + 4) := by
  have hL0 : ∀ x ∈ L, 0 ≤ x := fun x hx => (hL x hx).1
  have hpow : (2 : ℤ) ^ b ≤ 2 ^ Q := pow_le_pow_right₀ (by norm_num) hbQ
  have k1 := NLogN.mvList_cost Ei NLogN.CA NLogN.EC (.reg NLogN.CM) s L.reverse Ri h1 h5.symm (by decide) hEi
    (by simp [NLogN.Ex.eval, NLogN.IState.top, hM]) Q trivial (by simp [NLogN.Ex.Bnd, NLogN.IState.top, hM, hMQ])
    (fun x hx => by
      have := hL x (List.mem_reverse.1 hx)
      exact NLogN.zsz_le_of_nonneg_lt this.1 (by omega))
  simp only [NLogN.packOne, NLogN.RM.seqL, NLogN.RM.cost_seq', NLogN.RM.cost_rs', NLogN.RM.run_seq, NLogN.RM.run_rs]
  rw [NLogN.mvList_run Ei NLogN.CA NLogN.EC (.reg NLogN.CM) s L.reverse Ri h1 h5.symm (by decide) hEi
    (by simp [NLogN.Ex.eval, NLogN.IState.top, hM]), List.reverse_reverse]
  set s1 := ((s.upd Ei Ri).upd NLogN.CA (NLogN.ints L ++ s.G NLogN.CA)) with hs1
  have k2 := NLogN.cpush_lit0 NLogN.CY s1 Q
  set s2 := (NLogN.RS.push NLogN.CY (.lit 0)).run s1 with hs2
  have e2 : s2.G NLogN.CA = NLogN.ints L ++ s.G CA := by
    simp (config := {decide := true}) [hs2, hs1, NLogN.RS.run, NLogN.IState.upd_G, h1, h1.symm]
  have eY : s2.G NLogN.CY = .int 0 :: s.G CY := by
    simp (config := {decide := true}) [hs2, hs1, NLogN.RS.run, NLogN.IState.upd_G, h2, h2.symm, NLogN.Ex.eval]
  have eR : s2.G NLogN.CR = .int (2 ^ b) :: LR := by
    simp (config := {decide := true}) [hs2, hs1, NLogN.RS.run, NLogN.IState.upd_G, h3, h3.symm, hR]
  have eM : s2.G NLogN.CM = .int L.length :: LM := by
    simp (config := {decide := true}) [hs2, hs1, NLogN.RS.run, NLogN.IState.upd_G, h4, h4.symm, hM]
  have k3 := NLogN.carryP_cost M s2 b Q L 0 (s.G NLogN.CA) (s.G NLogN.CY) LR LM e2 eY eR eM le_rfl (by positivity)
    (fun x hx => ⟨(hL x hx).1, by have := (hL x hx).2; omega⟩) hb1 hbQ hMQ
  rw [NLogN.carryP_run s2 b L 0 (s.G NLogN.CA) (s.G NLogN.CY) LR LM e2 eY eR eM le_rfl hL0]
  have hkp := NLogN.kpack_nonneg b L hL0
  have hkl := NLogN.kpack_lt b L hL
  have hz : NLogN.zsz (kpack (2 ^ b) L + 0) ≤ b * L.length :=
    NLogN.zsz_le_of_nonneg_lt (by simpa using hkp) (by simpa using hkl)
  set s3 := (s2.upd NLogN.CA (s.G NLogN.CA)).upd NLogN.CY (.int (kpack (2 ^ b) L + 0) :: s.G NLogN.CY) with hs3
  have k4 := NLogN.cpush_reg X NLogN.CY s3 (b * L.length)
    (by simpa (config := {decide := true}) [hs3, NLogN.IState.top, NLogN.IState.upd_G] using hz)
  have k5 := NLogN.cpop NLogN.CY ((NLogN.RS.push X (.reg NLogN.CY)).run s3) (b * L.length)
    (by simpa (config := {decide := true}) [hs3, NLogN.IState.top, NLogN.IState.upd_G, NLogN.RS.run, h8.symm]
      using hz)
  simp only [List.length_reverse, NLogN.Ex.size] at k1
  nlinarith
end
