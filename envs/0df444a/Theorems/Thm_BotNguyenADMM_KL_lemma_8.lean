-- title:
--   Lemma 8 — d^{k+1} ∈ ∂L_r(x^{k+1}, z^{k+1}, y^{k+1}) with |||d^{k+1}||| ≤ C_5‖Δx‖ + C_6‖Δz‖ + C_7‖Δy‖
-- statement:
--   Suppose Assumption 1 holds and $\{(x^k,z^k,y^k)\}_{k\ge0}$ is generated by Algorithm 1 or Algorithm 2. For every $k\ge0$ the vector $d^{k+1}=(d_x^{k+1},d_z^{k+1},d_y^{k+1})$, where
--   $$d_x^{k+1}=C_2(\nabla h(x^{k+1})-\nabla h(x^k))+A^*(y^{k+1}-y^k)+M_1^k(x^k-x^{k+1}),$$
--   $$d_z^{k+1}=y^k-y^{k+1}+rA(x^k-x^{k+1})+M_2^k(z^k-z^{k+1}),\qquad d_y^{k+1}=\tfrac1{\rho r}(y^{k+1}-y^k),$$
--   belongs to the limiting subdifferential $\partial L_r(x^{k+1},z^{k+1},y^{k+1})$, and
--   $$|||d^{k+1}|||\le C_5\|x^{k+1}-x^k\|+C_6\|z^{k+1}-z^k\|+C_7\|y^{k+1}-y^k\|,$$
--   with $C_2=0$ (Algorithm 1) or $1$ (Algorithm 2), $C_5=C_2L+\mu_1+r\|A\|$, $C_6=\mu_2$, $C_7=1+\|A\|+\frac1{\rho r}$.
--
--   It gives an explicit subgradient of $L_r$ at each iterate, bounded by the increments.
--
--   **Formalization Note** $|||\cdot|||$ is the norm of the Euclidean (`WithLp 2`) product; $\partial$ is the published `LimitingSubdiff` on that product.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, p. 17, Lemma 8, (52)–(54)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_BotNguyenADMM_KL_Setting
open NonconvexSplitting.Shared BotNguyenADMM.KL
open Filter Topology
open scoped RealInnerProductSpace

namespace BotNguyenADMM.KL

/-- Lemma 8 (p. 17). Under Assumption 1, for a sequence generated by Algorithm 1 or
Algorithm 2 and every `k ≥ 0`, the element `dᵏ⁺¹` of (53a)–(53c) lies in the limiting
subdifferential `∂L_r(xᵏ⁺¹, zᵏ⁺¹, yᵏ⁺¹)` (52), and (54):
`|||dᵏ⁺¹||| ≤ C₅‖xᵏ⁺¹ − xᵏ‖ + C₆‖zᵏ⁺¹ − zᵏ‖ + C₇‖yᵏ⁺¹ − yᵏ‖`. -/
theorem lemma_8 {n m : ℕ} (v : Variant) (P : Data n m) (hA : Assumption1 v P)
    (x : ℕ → E n) (z y : ℕ → E m) (hrun : IsRun v P x z y) (k : ℕ) :
    dVec v P x z y k ∈ LimitingSubdiff (LrT P) (pack3 (x (k + 1)) (z (k + 1)) (y (k + 1))) ∧
    ‖dVec v P x z y k‖ ≤ C5 v P * ‖x (k + 1) - x k‖ + C6 P * ‖z (k + 1) - z k‖
      + C7 P * ‖y (k + 1) - y k‖ := by sorry

end BotNguyenADMM.KL
