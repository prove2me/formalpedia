/-- **The chirp call.** -/
theorem chirp_phase6 [∀ i, NeZero (Q.tB D i)] {eC : Fin (7 + E)} {dS : Fin HS} {C₀ : ℝ} {A : ℕ}
    {θt θit at' bt : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ} (hd0 : dS ≠ 0)
    (hC : chirpG6 Isym (IL.kTableP tab ext) eC dS C₀ A Q D θt θit at' bt) (Bd : ℕ)
