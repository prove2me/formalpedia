open scoped ContDiff
open ExactVacuumAtlas
open ExactVacuumAtlas.CoordRelation
variable {g₁ g₂ g₃ : Metric 4} {U V W : Set (Pt 4)} {Φ₁ Ψ₁ Φ₂ Ψ₂ : Pt 4 → Pt 4}
  {J₁ J₂ : Pt 4 → Matrix (Fin 4) (Fin 4) ℝ}
theorem solution (hV : IsOpen V) (h₁ : CoordRelation g₁ g₂ U V Φ₁ Ψ₁ J₁)
    (h₂ : CoordRelation g₂ g₃ V W Φ₂ Ψ₂ J₂) {x : Pt 4} (hx : x ∈ U) (k i : Fin 4) :
    HasDerivAt (fun u => Φ₂ (Φ₁ (Function.update x i u)) k) ((J₂ (Φ₁ x) * J₁ x) k i) (x i) := by
  have hy : Φ₁ x ∈ V := h₁.bijOn.mapsTo hx
  have hγ : HasDerivAt (fun u => Φ₁ (Function.update x i u)) (fun j => J₁ x j i) (x i) :=
    hasDerivAt_pi.mpr fun j => h₁.jacobian x hx j i
  have hd : DifferentiableAt ℝ Φ₂ (Φ₁ x) :=
    (h₂.smooth.contDiffAt (hV.mem_nhds hy)).differentiableAt (by simp)
  have hd' : HasFDerivAt Φ₂ (fderiv ℝ Φ₂ (Φ₁ x)) (Φ₁ (Function.update x i (x i))) := by
    rw [Function.update_eq_self]; exact hd.hasFDerivAt
  have hcomp := HasFDerivAt.comp_hasDerivAt (x := x i) (hl := hd') (hf := hγ)
  have hk := (hasDerivAt_pi.mp hcomp) k
  have key : fderiv ℝ Φ₂ (Φ₁ x) (fun j => J₁ x j i) k = (J₂ (Φ₁ x) * J₁ x) k i := by
    have hv : (fun j => J₁ x j i) = ∑ j : Fin 4, (J₁ x j i) • (Pi.single j (1 : ℝ) : Pt 4) := by
      ext m; simp [Finset.sum_apply, Pi.single_apply]
    rw [hv, map_sum]
    simp only [map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Matrix.mul_apply]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [fderiv_single_eq hV h₂ hy k j, mul_comm]
  rw [← key]
  exact hk
