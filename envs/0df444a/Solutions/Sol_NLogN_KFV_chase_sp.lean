section
-- Source module: Solutions.KFV34LayLoop3
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem EV.selT {st : IState HS} {B : ℕ} {c x y : Ex HS} {u v : ℤ} (hc : EV st B c u) (hu : u < 0)
    (hx : EV st B x v) : EV st B (.sel c x y) v :=
  ⟨⟨hc.1, by rw [hc.2.1, if_pos hu]; exact hx.1⟩, by simp [Ex.eval, hc.2.1, hu, hx.2.1],
    ⟨hc.2.2, by rw [hc.2.1, if_pos hu]; exact hx.2.2⟩⟩

theorem EV.selF {st : IState HS} {B : ℕ} {c x y : Ex HS} {u v : ℤ} (hc : EV st B c u) (hu : ¬ u < 0)
    (hy : EV st B y v) : EV st B (.sel c x y) v :=
  ⟨⟨hc.1, by rw [hc.2.1, if_neg hu]; exact hy.1⟩, by simp [Ex.eval, hc.2.1, hu, hy.2.1],
    ⟨hc.2.2, by rw [hc.2.1, if_neg hu]; exact hy.2.2⟩⟩

theorem chF_step (src : ℕ → ℕ) (t : ℕ) : ∀ (m y : ℕ),
    chF src t m (if y < t then src y else y) =
      (fun z => if z < t then src z else z) (chF src t m y)
  | 0, y => rfl
  | m + 1, y => by
    simp only [chF]
    exact chF_step src t m _

theorem chF_succ (src : ℕ → ℕ) (t m y : ℕ) :
    chF src t (m + 1) y = (fun z => if z < t then src z else z) (chF src t m y) := by
  rw [chF, chF_step]

theorem chF_lt (src : ℕ → ℕ) (N t : ℕ) (hs : ∀ y < N, src y < N) :
    ∀ m y, y < N → chF src t m y < N
  | 0, y, h => h
  | m + 1, y, h => by
    rw [chF]; apply chF_lt src N t hs; split_ifs <;> [exact hs y h; exact h]

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

theorem evSrc {st : IState HS} {B : ℕ} {y : Ex HS} {a : ℕ} (hy : EV st B y (a : ℤ))
    (hD : EV st B (.reg NLogN.KFV.gD) ((D : ℕ) : ℤ)) (hq : EV st B (.reg gQq) ((qq ℓ K : ℕ) : ℤ))
    (hb : a ≤ B) (hb2 : NLogN.KFV.srcP D ℓ K a ≤ B) :
    EV st B (NLogN.KFV.srcE y) ((NLogN.KFV.srcP D ℓ K a : ℕ) : ℤ) := by
  have hD0 : 0 < D := Nat.pos_of_ne_zero (NeZero.ne D)
  have e : NLogN.KFV.srcP D ℓ K a = a % D * qq ℓ K + a / D := rfl
  have h1 := hy.nmod hD hD0 (zsz_nat_le ((Nat.mod_le _ _).trans hb))
  have h2 := h1.mul hq (by
    rw [← Nat.cast_mul]; exact zsz_nat_le (le_trans (by rw [e]; exact Nat.le_add_right _ _) hb2))
  have h3 := hy.ndiv hD hD0 (zsz_nat_le ((Nat.div_le_self _ _).trans hb))
  exact (h2.add h3 (by rw [← Nat.cast_mul, ← Nat.cast_add, ← e]; exact zsz_nat_le hb2)).cast
    (by rw [e]; push_cast; ring)

end Paper

end NLogN.KFV

end

section
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFV
open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)
set_option maxHeartbeats 2000000
theorem solution (s : NLogN.IState NLogN.HS) (f0 : Fin NLogN.HS → List ℤ) {t B : ℕ}
    (hV : f0 NLogN.KFV.gV = []) (hT2 : f0 NLogN.KFV.gT2 = []) (hT : f0 NLogN.KFV.gT = [((D * Synth.qq ℓ K : ℕ) : ℤ)])
    (hI : f0 NLogN.KFV.gI = [(t : ℤ)]) (hD : NLogN.KFV.RT s NLogN.KFV.gD D) (hq : NLogN.KFV.RT s NLogN.KFV.gQq (Synth.qq ℓ K))
    (hfD : f0 NLogN.KFV.gD = []) (hfq : f0 NLogN.KFV.gQq = [])
    (ht : t < D * Synth.qq ℓ K) (hNB : D * Synth.qq ℓ K + D + 1 ≤ B) :
    NLogN.KIL.Sp NLogN.KFV.chase (NLogN.KIL.encK s f0) (NLogN.KIL.encK s (Function.update f0 NLogN.KFV.gV [(NLogN.KFV.xT (NLogN.KFV.srcP D ℓ K) (D * Synth.qq ℓ K) t : ℤ)]))
      (NLogN.KFV.cChase (D * Synth.qq ℓ K) B) := by
  set N := D * Synth.qq ℓ K with hN
  set src := NLogN.KFV.srcP D ℓ K
  have hs : ∀ y < N, src y < N := fun y hy => NLogN.KFV.srcP_lt D ℓ K hy
  have zB : ∀ x : ℕ, x ≤ B → NLogN.zsz (x : ℤ) ≤ B := fun x hx => NLogN.KFV.zsz_nat_le hx
  have hq1 : Synth.qq ℓ K ≤ N := by
    rcases Nat.eq_zero_or_pos D with h | h
    · exact absurd h (NeZero.ne D)
    · rw [hN]; exact Nat.le_mul_of_pos_left _ h
  -- the push
  have eD : ∀ f : Fin NLogN.HS → List ℤ, f NLogN.KFV.gD = [] → NLogN.KFV.EV (NLogN.KIL.encK s f) B (.reg NLogN.KFV.gD) ((D : ℕ) : ℤ) :=
    fun f hf => NLogN.KFV.rt_ev hD hf (zB _ (by omega))
  have eq : ∀ f : Fin NLogN.HS → List ℤ, f NLogN.KFV.gQq = [] → NLogN.KFV.EV (NLogN.KIL.encK s f) B (.reg NLogN.KFV.gQq) ((Synth.qq ℓ K : ℕ) : ℤ) :=
    fun f hf => NLogN.KFV.rt_ev hq hf (zB _ (by omega))
  have vI : NLogN.KFV.EV (NLogN.KIL.encK s f0) B (.reg NLogN.KFV.gI) ((t : ℕ) : ℤ) := NLogN.KFV.EV.reg (L := s.G NLogN.KFV.gI) (by simp [hI, NLogN.ints])
    (zB _ (by omega))
  have vS := NLogN.KFV.evSrc D ℓ K vI (eD f0 hfD) (eq f0 hfq) (by omega) (by have : NLogN.KFV.srcP D ℓ K t < N := hs t ht; omega)
  have P1 := NLogN.KFV.pushV (i := NLogN.KFV.gV) s f0 (by decide) (by
    intro r hr; revert r; decide) vS hV
  -- the loop
  let Fj : ℕ → Fin NLogN.HS → List ℤ := fun j => Function.update f0 NLogN.KFV.gV [((NLogN.KFV.xC D ℓ K t j : ℕ) : ℤ)]
  have hF0 : Fj 0 = Function.update f0 NLogN.KFV.gV [((src t : ℕ) : ℤ)] := rfl
  have hxlt : ∀ j, NLogN.KFV.xC D ℓ K t j < N := fun j => NLogN.KFV.chF_lt src N t hs j _ (hs t ht)
  have hb : ∀ j < N, NLogN.KIL.Sp NLogN.KFV.chStep (NLogN.KIL.encK s (Function.update (Fj j) NLogN.KFV.gT2 [(N : ℤ) - j]))
      (NLogN.KIL.encK s (Function.update (Fj (j + 1)) NLogN.KFV.gT2 [(N : ℤ) - j])) (NLogN.KFV.cStep B) := by
    intro j hj
    obtain ⟨x, hx⟩ : ∃ x, NLogN.KFV.xC D ℓ K t j = x := ⟨_, rfl⟩
    have hxN : x < N := hx ▸ hxlt j
    set f := Function.update (Fj j) NLogN.KFV.gT2 [(N : ℤ) - j] with hf
    have fV : f NLogN.KFV.gV = [(x : ℤ)] := by simp +decide [hf, Fj, Function.update_apply, hx]
    have fI : f NLogN.KFV.gI = [(t : ℤ)] := by simp +decide [hf, Fj, Function.update_apply, hI]
    have vV : NLogN.KFV.EV (NLogN.KIL.encK s f) B (.reg NLogN.KFV.gV) ((x : ℕ) : ℤ) :=
      NLogN.KFV.EV.reg (L := s.G NLogN.KFV.gV) (by simp [fV, NLogN.ints]) (zB _ (by have := hxN; omega))
    have vI' : NLogN.KFV.EV (NLogN.KIL.encK s f) B (.reg NLogN.KFV.gI) ((t : ℕ) : ℤ) :=
      NLogN.KFV.EV.reg (L := s.G NLogN.KFV.gI) (by simp [fI, NLogN.ints]) (zB _ (by omega))
    have fD : f NLogN.KFV.gD = [] := by simp +decide [hf, Fj, Function.update_apply, hfD]
    have fq : f NLogN.KFV.gQq = [] := by simp +decide [hf, Fj, Function.update_apply, hfq]
    have vc := vV.add vI'.neg (NLogN.KFV.zsz_le_B (by have := hxN; omega) (by have := hxN; omega))
    have hstep : ((NLogN.KFV.xC D ℓ K t (j + 1) : ℕ) : ℤ) = if x < t then ((src x : ℕ) : ℤ) else (x : ℤ) := by
      rw [NLogN.KFV.xC, NLogN.KFV.chF_succ, ← NLogN.KFV.xC, hx]; beta_reduce; split_ifs <;> rfl
    have vE : NLogN.KFV.EV (NLogN.KIL.encK s f) B (.sel (.add (.reg NLogN.KFV.gV) (.neg (.reg NLogN.KFV.gI))) (NLogN.KFV.srcE (.reg NLogN.KFV.gV)) (.reg NLogN.KFV.gV))
        ((NLogN.KFV.xC D ℓ K t (j + 1) : ℕ) : ℤ) := by
      rw [hstep]
      by_cases hxt : x < t
      · rw [if_pos hxt]
        exact vc.selT (by omega) (NLogN.KFV.evSrc D ℓ K vV (eD f fD) (eq f fq) (by have := hxN; omega)
          (by have : NLogN.KFV.srcP D ℓ K x < N := hs x hxN; omega))
      · rw [if_neg hxt]
        exact vc.selF (by omega) vV
    have S := NLogN.KIL.Sp.asgQ s f (i := NLogN.KFV.gV) (a := (x : ℤ)) (l := []) (B := B) (by decide) fV
      (zB _ (by have := hxN; omega))
      (by intro r hr; revert r; decide)
      vE.1 vE.2.2
    rw [vE.2.1] at S
    have e : Function.update f NLogN.KFV.gV [((NLogN.KFV.xC D ℓ K t (j + 1) : ℕ) : ℤ)] =
        Function.update (Fj (j + 1)) NLogN.KFV.gT2 [(N : ℤ) - j] := by
      simp only [hf, Fj]
      rw [Function.update_comm (show NLogN.KFV.gT2 ≠ NLogN.KFV.gV by decide), Function.update_idem,
        Function.update_comm (show NLogN.KFV.gV ≠ NLogN.KFV.gT2 by decide)]
    rw [e] at S
    exact S
  have vT : NLogN.KFV.EV (NLogN.KIL.encK s (Fj 0)) B (.reg NLogN.KFV.gT) ((N : ℕ) : ℤ) :=
    NLogN.KFV.EV.reg (L := s.G NLogN.KFV.gT) (by simp +decide [Fj, Function.update_apply, hT, NLogN.ints]) (zB _ (by omega))
  have R := NLogN.KIL.Sp.rep (C := NLogN.KFV.gT2) (n := .reg NLogN.KFV.gT) (b := NLogN.KFV.chStep) (s := s) (F := Fj) (N := N) (B := B)
    (c := NLogN.KFV.cStep B) (by decide) (fun j => by simp +decide [Fj, Function.update_apply, hT2])
    (by decide) (by intro r hr; simp [NLogN.Ex.regs] at hr; subst hr; decide)
    vT.1 trivial vT.2.2 vT.2.1 hb
  rw [← hF0] at P1
  have := P1.seq R
  simp only [Fj, NLogN.KFV.xC] at this
  refine this.mono ?_
  unfold NLogN.KFV.cChase
  omega
end
