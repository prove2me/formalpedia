private theorem exists_galFC_aux
    {r : ℕ} [Fact r.Prime] (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime r)
    [Fact (A.DecompositionIsometric ℚ)]
    (S : Type) [Group S] (scalar : S →* ↥(A.decompositionSubgroup ℚ))
    (F : Type) [Field F] [Algebra (AlgebraicClosure ℚ) F] [IsCurveOver (AlgebraicClosure ℚ) F]
    (hfg : ∃ x : F, Transcendental (AlgebraicClosure ℚ) x ∧
      FiniteDimensional (IntermediateField.adjoin (AlgebraicClosure ℚ) ({x} : Set F)) F)
    (galF : S →* SemilinearAut (AlgebraicClosure ℚ) F)
    (hgalF : ∀ (σ : S) (a : AlgebraicClosure ℚ),
      SemilinearAut.baseAut (galF σ) a = ((scalar σ : ↥(A.decompositionSubgroup ℚ)) : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) a)
    (FC : Type) [Field FC] [Algebra A.valuation.Completion FC] [Algebra F FC] [Algebra (AlgebraicClosure ℚ) FC]
    [IsScalarTower (AlgebraicClosure ℚ) A.valuation.Completion FC] [IsScalarTower (AlgebraicClosure ℚ) F FC]
    [IsCurveOver A.valuation.Completion FC]
    (hfg' : ∃ x : FC, Transcendental A.valuation.Completion x ∧
      FiniteDimensional (IntermediateField.adjoin A.valuation.Completion ({x} : Set FC)) FC)
    (hgen : IntermediateField.adjoin A.valuation.Completion (Set.range (algebraMap F FC)) = ⊤) :
    ∃ galFC : S →* SemilinearAut A.valuation.Completion FC,
      (∀ (σ : S) (c : A.valuation.Completion), SemilinearAut.baseAut (galFC σ) c = (scalar σ) • c) ∧
      (∀ (σ : S) (f : F), galFC σ • algebraMap F FC f = algebraMap F FC (galF σ • f)) := by

  have hτ : ∀ (σ : S) (z : AlgebraicClosure ℚ),
      (ValuationSubring.completionRingAut.comp scalar) σ (algebraMap (AlgebraicClosure ℚ) A.valuation.Completion z) =
        algebraMap (AlgebraicClosure ℚ) A.valuation.Completion (SemilinearAut.baseAut (galF σ) z) := by
    intro σ z
    rw [MonoidHom.comp_apply, ValuationSubring.completionRingAut_apply, Valuation.algebraMap_completion_apply,
      Valuation.algebraMap_completion_apply, ValuationSubring.smul_completion_coe, hgalF]
  obtain ⟨galFC, ⟨hbase, hext⟩, -⟩ :=
    AlgebraicCurve.SemilinearAut.existsUnique_monoidHom_baseAut_eq_smul_algebraMap_eq_of_constantFieldExtension
      (AlgebraicClosure ℚ) F A.valuation.Completion FC hfg hfg' hgen S galF
      (ValuationSubring.completionRingAut.comp scalar) hτ
  exact ⟨galFC, fun σ c => hbase σ c, fun σ f => hext σ f⟩

private theorem exists_constantFieldExtension_pair_aux
    (K F : Type) [Field K] [Field F] [Algebra K F] [IsAlgClosed K] [CharZero K] [IsCurveOver K F]
    (hfg : ∃ x : F, Transcendental K x ∧ FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F)
    (F' : Type) [Field F'] [Algebra K F'] [IsCurveOver K F']
    (hfg' : ∃ x' : F', Transcendental K x' ∧ FiniteDimensional (IntermediateField.adjoin K ({x'} : Set F')) F')
    (φ ψ : F →ₐ[K] F') (hφ : φ.toRingHom.IsIntegral) (hψ : ψ.toRingHom.IsIntegral)
    (hFI : FundamentalIdentityAlong K φ hφ) (hfin : FiniteAlong K ψ) (hN : NormFormulaAlong K ψ hfin)
    (E FE : Type) [Field E] [Field FE] [Algebra K E] [Algebra E FE] [Algebra F FE] [Algebra K FE]
    [IsScalarTower K E FE] [IsScalarTower K F FE] [IsAlgClosed E] [IsCurveOver E FE]
    (hfgE : ∃ x : FE, Transcendental E x ∧ FiniteDimensional (IntermediateField.adjoin E ({x} : Set FE)) FE)
    (hgen : IntermediateField.adjoin E (Set.range (algebraMap F FE)) = ⊤) :
    ∃ (F'E : Type) (_ : Field F'E) (_ : Algebra E F'E) (_ : Algebra F' F'E) (_ : Algebra K F'E)
      (_ : IsScalarTower K E F'E) (_ : IsScalarTower K F' F'E) (_ : IsCurveOver E F'E)
      (φE ψE : FE →ₐ[E] F'E),
      (∃ x' : F'E, Transcendental E x' ∧ FiniteDimensional (IntermediateField.adjoin E ({x'} : Set F'E)) F'E) ∧
      IntermediateField.adjoin E (Set.range (algebraMap F' F'E)) = ⊤ ∧
      (∀ f : F, φE (algebraMap F FE f) = algebraMap F' F'E (φ f)) ∧
      (∀ f : F, ψE (algebraMap F FE f) = algebraMap F' F'E (ψ f)) ∧
      φE.toRingHom.IsIntegral ∧ ψE.toRingHom.IsIntegral ∧
      FiniteAlong E φE ∧ FiniteAlong E ψE ∧ SeparableAlong E φE ∧ SeparableAlong E ψE := by
  haveI : HasPrincipalDivisors K F' := IsCurveOver.hasPrincipalDivisors
  obtain ⟨F'E, instF, instAE, instAF', instAK, instTE, instTF', instCurve, φE, ψE, hφE, hψE, -, -, -, hfgE', hgen',
      hcommφ, hcommψ, -, -, -⟩ :=
    AlgebraicCurve.exists_baseChange_correspondence_of_constantFieldExtension K F hfg F' φ ψ hφ hψ hFI hfin hN E FE
      hfgE hgen
  haveI : CharZero FE := charZero_of_injective_algebraMap (algebraMap K FE).injective
  refine ⟨F'E, instF, instAE, instAF', instAK, instTE, instTF', instCurve, φE, ψE, hfgE', hgen', hcommφ, hcommψ, hφE, hψE,
    ?_, ?_, separableAlong_of_charZero φE hφE, separableAlong_of_charZero ψE hψE⟩
  · exact (finrankAlong_eq_and_trace_eq_of_constantFieldExtension_of_isAlgClosed K F hfg F' hfg' φ hφ E FE hfgE hgen
      F'E hfgE' hgen' φE hcommφ hφE).2.1
  · exact (finrankAlong_eq_and_trace_eq_of_constantFieldExtension_of_isAlgClosed K F hfg F' hfg' ψ hψ E FE hfgE hgen
      F'E hfgE' hgen' ψE hcommψ hψE).2.1

private theorem smul_algHom_eq_algHom_smul_aux
    {K F F' E FE F'E : Type} [Field K] [Field F] [Field F'] [Field E] [Field FE] [Field F'E]
    [Algebra K F] [Algebra K F'] [Algebra E FE] [Algebra E F'E] [Algebra F FE] [Algebra F' F'E]
    (φ : F →ₐ[K] F') (φE : FE →ₐ[E] F'E)
    (hcomm : ∀ f : F, φE (algebraMap F FE f) = algebraMap F' F'E (φ f))
    (hgen : IntermediateField.adjoin E (Set.range (algebraMap F FE)) = ⊤)
    (gF : SemilinearAut K F) (gF' : SemilinearAut K F') (hgal : ∀ f : F, gF' • φ f = φ (gF • f))
    (g : SemilinearAut E FE) (g' : SemilinearAut E F'E)
    (hbase : SemilinearAut.baseAut g = SemilinearAut.baseAut g')
    (hext : ∀ f : F, g • algebraMap F FE f = algebraMap F FE (gF • f))
    (hext' : ∀ f' : F', g' • algebraMap F' F'E f' = algebraMap F' F'E (gF' • f')) :
    ∀ x : FE, g' • φE x = φE (g • x) := by

  let h₁ : FE →+* F'E := (MulSemiringAction.toRingHom (SemilinearAut E F'E) F'E g').comp φE.toRingHom
  let h₂ : FE →+* F'E := φE.toRingHom.comp (MulSemiringAction.toRingHom (SemilinearAut E FE) FE g)
  have key : Set.EqOn h₁ h₂ (Set.range (algebraMap E FE) ∪ Set.range (algebraMap F FE)) := by
    rintro x (⟨c, rfl⟩ | ⟨f, rfl⟩)
    ·
      show g' • φE (algebraMap E FE c) = φE (g • algebraMap E FE c)
      rw [φE.commutes, SemilinearAut.smul_algebraMap, SemilinearAut.smul_algebraMap, φE.commutes, hbase]
    ·
      show g' • φE (algebraMap F FE f) = φE (g • algebraMap F FE f)
      rw [hcomm, hext', hgal, hext, hcomm]
  intro x
  have hx : x ∈ (IntermediateField.adjoin E (Set.range (algebraMap F FE))).toSubfield := by
    rw [hgen]; trivial
  rw [IntermediateField.adjoin_toSubfield] at hx
  exact RingHom.eqOn_field_closure key hx

structure FCSide {q q' : ℕ} {Fbase : Type} [Field Fbase] [Algebra (AlgebraicClosure ℚ) Fbase]
    (𝕋 : TowerData q q' Fbase) (A : ValuationSubring (AlgebraicClosure ℚ))
    (S : Type) [Group S] (scalar : S →* ↥(A.decompositionSubgroup ℚ))
    (galF : ∀ j : Obj q q', S →* SemilinearAut (AlgebraicClosure ℚ) (𝕋.objField j)) : Type 1 where

  FC : Obj q q' → Type
  [instField : ∀ j, Field (FC j)]
  [instAlgC : ∀ j, Algebra A.valuation.Completion (FC j)]
  [instAlgF : ∀ j, Algebra (𝕋.objField j) (FC j)]
  [instAlgK : ∀ j, Algebra (AlgebraicClosure ℚ) (FC j)]
  [instTowC : ∀ j, IsScalarTower (AlgebraicClosure ℚ) A.valuation.Completion (FC j)]
  [instTowF : ∀ j, IsScalarTower (AlgebraicClosure ℚ) (𝕋.objField j) (FC j)]
  [instCurve : ∀ j, IsCurveOver A.valuation.Completion (FC j)]
  hfg' : ∀ j, ∃ x : FC j, Transcendental A.valuation.Completion x ∧
    FiniteDimensional (IntermediateField.adjoin A.valuation.Completion ({x} : Set (FC j))) (FC j)
  hgen : ∀ j, IntermediateField.adjoin A.valuation.Completion (Set.range (algebraMap (𝕋.objField j) (FC j))) = ⊤

  galFC : ∀ j, S →* SemilinearAut A.valuation.Completion (FC j)
  hgalFC_base : ∀ j (σ : S) (c : A.valuation.Completion), SemilinearAut.baseAut (galFC j σ) c = (scalar σ) • c
  hgalFC_ext : ∀ j (σ : S) (f : 𝕋.objField j),
    galFC j σ • algebraMap (𝕋.objField j) (FC j) f = algebraMap (𝕋.objField j) (FC j) (galF j σ • f)

  φC : ∀ α : Arr q q', FC (cod α) →ₐ[A.valuation.Completion] FC (dom α)
  hcomm : ∀ (α : Arr q q') (f : 𝕋.objField (cod α)),
    φC α (@algebraMap _ _ _ _ (instAlgF (cod α)) f) = @algebraMap _ _ _ _ (instAlgF (dom α)) (𝕋.φ α f)
  hφC_int : ∀ α, (φC α).toRingHom.IsIntegral
  hφC_fin : ∀ α, FiniteAlong A.valuation.Completion (φC α)
  hφC_sep : ∀ α, SeparableAlong A.valuation.Completion (φC α)

  hgalC : ∀ (α : Arr q q') (σ : S) (x : FC (cod α)), galFC (dom α) σ • φC α x = φC α (galFC (cod α) σ • x)

attribute [scoped instance] FCSide.instField FCSide.instAlgC FCSide.instAlgF FCSide.instAlgK FCSide.instTowC FCSide.instTowF
  FCSide.instCurve

