/-! ### Part 1: Pure Nat and SegTree lemmas -/

lemma le_mul_ceilDiv {a b : ℕ} (hb : 0 < b) : a ≤ b * ceilDiv a b := by
  unfold ceilDiv
  have h1 := Nat.div_add_mod (a + b - 1) b
  have hmod : (a + b - 1) % b < b := Nat.mod_lt _ hb
  omega

lemma allTree_sound : ∀ (d k₀ : ℕ) (p : ℕ → Bool),
    allTree d k₀ p = true → ∀ k, k₀ ≤ k → k < k₀ + 2 ^ d → p k = true
  | 0, k₀, p, hp, k, hk0, hk1 => by
      have : k = k₀ := by omega
      subst this; simpa [allTree] using hp
  | d + 1, k₀, p, hp, k, hk0, hk1 => by
      simp only [allTree, Bool.and_eq_true] at hp
      by_cases h : k < k₀ + 2 ^ d
      · exact allTree_sound d k₀ p hp.1 k hk0 h
      · have hk' : k₀ + 2 ^ d ≤ k := by omega
        have hk'' : k < (k₀ + 2 ^ d) + 2 ^ d := by
          have : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by ring
          omega
        exact allTree_sound d (k₀ + 2 ^ d) p hp.2 k hk' hk''

lemma segTree_get_le_top : ∀ (d : ℕ) (t : SegTree) (k : ℕ),
    t.isValid d = true → k < 2 ^ d → t.get d k ≤ t.top
  | 0, .L v, _, _, _ => le_refl v
  | d + 1, .N m l r, k, hv, hk => by
      simp only [SegTree.isValid, Bool.and_eq_true, decide_eq_true_eq] at hv
      simp only [SegTree.get]
      split_ifs with h
      · exact le_trans (segTree_get_le_top d l k hv.1.1.1 h) hv.1.2
      · have hr : k - 2 ^ d < 2 ^ d := by
          have : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by ring
          omega
        exact le_trans (segTree_get_le_top d r (k - 2 ^ d) hv.1.1.2 hr) hv.2
  | 0, .N _ _ _, _, hv, _ => by simp [SegTree.isValid] at hv
  | _ + 1, .L _, _, hv, _ => by simp [SegTree.isValid] at hv

lemma segTree_get_le_rangeMax : ∀ (d : ℕ) (t : SegTree) (half lo hi k : ℕ),
    t.isValid d = true → (0 < d → half = 2 ^ (d - 1)) →
    lo ≤ k → k ≤ hi → hi < 2 ^ d →
    t.get d k ≤ t.rangeMax half lo hi
  | 0, .L v, _, _, _, _, _, _, _, _, _ => by simp [SegTree.get, SegTree.rangeMax]
  | 0, .N _ _ _, _, _, _, _, hv, _, _, _, _ => by simp [SegTree.isValid] at hv
  | d + 1, .L _, _, _, _, _, hv, _, _, _, _ => by simp [SegTree.isValid] at hv
  | d + 1, .N m l r, half, lo, hi, k, hv, hhalf, hlo, hhi, hlt => by
      have hh : half = 2 ^ d := by simpa using hhalf (Nat.succ_pos d)
      subst hh
      have hh2 : (0 < d → 2 ^ d / 2 = 2 ^ (d - 1)) := by
        intro hd
        cases d with
        | zero => omega
        | succ d' => simp [pow_succ]
      simp only [SegTree.isValid, Bool.and_eq_true, decide_eq_true_eq] at hv
      rw [SegTree.rangeMax]
      split_ifs with hfull hleft hright
      · exact le_trans (segTree_get_le_top (d + 1) (.N m l r) k
          (by simp [SegTree.isValid, hv]) (lt_of_le_of_lt hhi hlt)) (le_refl m)
      · have hkd : k < 2 ^ d := lt_of_le_of_lt hhi hleft
        simpa [SegTree.get, hkd] using
          segTree_get_le_rangeMax d l (2 ^ d / 2) lo hi k hv.1.1.1 hh2 hlo hhi hleft
      · have hkd : ¬ k < 2 ^ d := by omega
        have hr : hi - 2 ^ d < 2 ^ d := by omega
        simpa [SegTree.get, hkd] using
          segTree_get_le_rangeMax d r (2 ^ d / 2) (lo - 2 ^ d) (hi - 2 ^ d) (k - 2 ^ d)
            hv.1.1.2 hh2 (by omega) (by omega) hr
      · by_cases hkd : k < 2 ^ d
        · have h1 := segTree_get_le_rangeMax d l (2 ^ d / 2) lo (2 ^ d - 1) k
            hv.1.1.1 hh2 hlo (by omega) (Nat.sub_lt (by positivity) Nat.one_pos)
          simpa [SegTree.get, hkd] using le_trans h1 (le_max_left _ _)
        · have hr : hi - 2 ^ d < 2 ^ d := by omega
          have h2 := segTree_get_le_rangeMax d r (2 ^ d / 2) 0 (hi - 2 ^ d) (k - 2 ^ d)
            hv.1.1.2 hh2 (Nat.zero_le _) (by omega) hr
          simpa [SegTree.get, hkd] using le_trans h2 (le_max_right _ _)

/-! ### Part 2: Buchstab function soundness -/

lemma buchstab_nonneg_on_Icc {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    ∀ (N : ℕ) (u : ℝ), 1 ≤ u → u ≤ (N + 2 : ℕ) → 0 ≤ ω u := by
  intro N
  induction N with
  | zero =>
      intro u hu1 hu2
      have h2 : u ≤ 2 := by norm_num at hu2; exact hu2
      rw [hω.2.1 u hu1 h2]
      positivity
  | succ N ih =>
      intro u hu1 huN
      by_cases hle : u ≤ (N + 2 : ℕ)
      · exact ih u hu1 hle
      · have hgt : ((N + 2 : ℕ) : ℝ) < u := lt_of_not_ge hle
        have hGcont : ContinuousOn (fun v => v * ω v) (Icc ((N + 2 : ℕ) : ℝ) u) :=
          continuousOn_id.mul (hω.1.mono (fun v hv => by
            have : (1 : ℝ) ≤ (N + 2 : ℕ) := by exact_mod_cast (by omega : 1 ≤ N + 2)
            exact le_trans this hv.1))
        have hGderiv : ∀ v ∈ Ioo ((N + 2 : ℕ) : ℝ) u, HasDerivAt (fun t => t * ω t) (ω (v - 1)) v := by
          intro v hv
          have hv2 : 2 < v := by
            have : (2 : ℝ) ≤ (N + 2 : ℕ) := by exact_mod_cast (by omega : 2 ≤ N + 2)
            exact lt_of_le_of_lt this hv.1
          exact hω.2.2 v hv2
        have hGmono : MonotoneOn (fun v => v * ω v) (Icc ((N + 2 : ℕ) : ℝ) u) := by
          apply monotoneOn_of_deriv_nonneg (convex_Icc _ _) hGcont
          · intro v hv
            rw [interior_Icc] at hv
            exact (hGderiv v hv).differentiableAt.differentiableWithinAt
          · intro v hv
            rw [interior_Icc] at hv
            rw [(hGderiv v hv).deriv]
            have hv1 : 1 ≤ v - 1 := by
              have : (2 : ℝ) ≤ (N + 2 : ℕ) := by exact_mod_cast (by omega : 2 ≤ N + 2)
              linarith [hv.1]
            have hvN : v - 1 ≤ ((N + 2 : ℕ) : ℝ) := by
              have huN' : u ≤ ((N + 2 : ℕ) : ℝ) + 1 := by exact_mod_cast huN
              linarith [hv.2]
            exact ih (v - 1) hv1 hvN
        have hbase : 0 ≤ ((N + 2 : ℕ) : ℝ) * ω ((N + 2 : ℕ) : ℝ) := by
          apply mul_nonneg (by positivity)
          exact ih ((N + 2 : ℕ) : ℝ) (by exact_mod_cast (by omega : 1 ≤ N + 2)) (le_refl _)
        have hGu : ((N + 2 : ℕ) : ℝ) * ω ((N + 2 : ℕ) : ℝ) ≤ u * ω u :=
          hGmono ⟨le_refl _, le_of_lt hgt⟩ ⟨le_of_lt hgt, le_refl _⟩ (le_of_lt hgt)
        have hposu : 0 < u := lt_of_lt_of_le zero_lt_one hu1
        exact nonneg_of_mul_nonneg_right (le_trans hbase hGu) hposu

lemma buchstab_nonneg {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω) (u : ℝ) : 0 ≤ ω u := by
  by_cases h : u < 1
  · rw [hz u h]
  · have hu1 : 1 ≤ u := le_of_not_gt h
    obtain ⟨N, hN⟩ := exists_nat_ge u
    have hle : u ≤ ((N + 2 : ℕ) : ℝ) := by
      have : (N : ℝ) ≤ ((N + 2 : ℕ) : ℝ) := by exact_mod_cast (by omega : N ≤ N + 2)
      linarith
    exact buchstab_nonneg_on_Icc hω N u hu1 hle

lemma buchstab_G_eq_two_three {ω : ℝ → ℝ} (hω : IsBuchstab ω) {u : ℝ} (hu2 : 2 ≤ u) (hu3 : u ≤ 3) :
    u * ω u = 1 + Real.log (u - 1) := by
  by_cases heq : u = 2
  · subst heq
    have h2 : ω 2 = 1 / 2 := hω.2.1 2 (by norm_num) (le_refl 2)
    rw [h2]; norm_num
  · have hlt : 2 < u := lt_of_le_of_ne hu2 (Ne.symm heq)
    set f : ℝ → ℝ := fun v => v * ω v - (1 + Real.log (v - 1))
    have hf_cont : ContinuousOn f (Icc 2 u) := by
      refine (continuousOn_id.mul (hω.1.mono (fun v (hv : _ ≤ v ∧ v ≤ _) => show (1 : ℝ) ≤ v by linarith))).sub ?_
      refine continuousOn_const.add (Real.continuousOn_log.comp (continuousOn_id.sub continuousOn_const) ?_)
      intro v hv
      simp only [mem_compl_iff, mem_singleton_iff]
      exact ne_of_gt (by linarith [hv.1])
    have hf_deriv : ∀ v ∈ Ioo 2 u, HasDerivAt f 0 v := by
      intro v hv
      have hG := hω.2.2 v hv.1
      have hlog : HasDerivAt (fun t => 1 + Real.log (t - 1)) (1 / (v - 1)) v := by
        have hsub : HasDerivAt (fun t : ℝ => t - 1) 1 v := (hasDerivAt_id v).sub_const 1
        have hpos : v - 1 ≠ 0 := by linarith [hv.1]
        simpa [one_div] using (hsub.log hpos).const_add 1
      have hωv1 : ω (v - 1) = 1 / (v - 1) := hω.2.1 (v - 1) (by linarith [hv.1]) (by linarith [hv.2])
      have hd := hG.sub hlog
      rwa [hωv1, sub_self] at hd
    have hmono : MonotoneOn f (Icc 2 u) := monotoneOn_of_deriv_nonneg (convex_Icc 2 u) hf_cont
      (fun v hv => by rw [interior_Icc] at hv; exact (hf_deriv v hv).differentiableAt.differentiableWithinAt)
      (fun v hv => by rw [interior_Icc] at hv; rw [(hf_deriv v hv).deriv])
    have hanti : AntitoneOn f (Icc 2 u) := antitoneOn_of_deriv_nonpos (convex_Icc 2 u) hf_cont
      (fun v hv => by rw [interior_Icc] at hv; exact (hf_deriv v hv).differentiableAt.differentiableWithinAt)
      (fun v hv => by rw [interior_Icc] at hv; rw [(hf_deriv v hv).deriv])
    have hle1 : f 2 ≤ f u := hmono ⟨le_refl 2, le_of_lt hlt⟩ ⟨le_of_lt hlt, le_refl u⟩ (le_of_lt hlt)
    have hle2 : f u ≤ f 2 := hanti ⟨le_refl 2, le_of_lt hlt⟩ ⟨le_of_lt hlt, le_refl u⟩ (le_of_lt hlt)
    have hf2 : f 2 = 0 := by
      have h2 : ω 2 = 1 / 2 := hω.2.1 2 (by norm_num) (le_refl 2)
      dsimp [f]; rw [h2]; norm_num
    have hfu : f u = 0 := by linarith
    linarith [show f u = u * ω u - (1 + Real.log (u - 1)) from rfl]

lemma log_succ_div_le (k : ℕ) (hk : 0 < k) :
    Real.log (((k : ℝ) + 1) / k) ≤ (2 * (k : ℝ) + 1) / (2 * k * (k + 1)) := by
  have hkpos : (0 : ℝ) < k := by exact_mod_cast hk
  have hk1 : (0 : ℝ) < k + 1 := by positivity
  have hlog : Real.log (((k : ℝ) + 1) / k) = ∫ t in (k : ℝ)..(k + 1 : ℝ), (1 / t : ℝ) := by
    simp_rw [one_div]
    exact (integral_inv_of_pos hkpos hk1).symm
  rw [hlog]
  have hlin : ∀ t ∈ Icc (k : ℝ) (k + 1 : ℝ),
      (1 / t : ℝ) ≤ (1 / k : ℝ) + ((1 / (k + 1 : ℝ)) - (1 / k : ℝ)) * (t - k) := by
    intro t ht
    have htpos : 0 < t := lt_of_lt_of_le hkpos ht.1
    rw [← sub_nonneg]
    have heq : (1 / k : ℝ) + ((1 / (k + 1 : ℝ)) - (1 / k : ℝ)) * (t - k) - 1 / t =
        (t - k) * ((k + 1) - t) / (k * (k + 1) * t) := by
      field_simp; ring
    rw [heq]
    exact div_nonneg (mul_nonneg (sub_nonneg.mpr ht.1) (sub_nonneg.mpr ht.2)) (by positivity)
  have hint1 : IntervalIntegrable (fun t : ℝ => 1 / t) volume (k : ℝ) (k + 1 : ℝ) := by
    apply ContinuousOn.intervalIntegrable_of_Icc (by linarith)
    exact continuousOn_const.div continuousOn_id (fun t ht => ne_of_gt (lt_of_lt_of_le hkpos ht.1))
  have hint2 : IntervalIntegrable (fun t : ℝ => (1 / k : ℝ) + ((1 / (k + 1 : ℝ)) - (1 / k : ℝ)) * (t - k)) volume (k : ℝ) (k + 1 : ℝ) :=
    Continuous.intervalIntegrable (by continuity) _ _
  have hle := intervalIntegral.integral_mono_on (by linarith) hint1 hint2 hlin
  have hderiv : ∀ t : ℝ, HasDerivAt
      (fun x : ℝ => (1 / k : ℝ) * x + ((1 / (k + 1 : ℝ)) - (1 / k : ℝ)) * ((x - k) ^ 2 / 2))
      ((1 / k : ℝ) + ((1 / (k + 1 : ℝ)) - (1 / k : ℝ)) * (t - k)) t := by
    intro t
    have h1 : HasDerivAt (fun x : ℝ => (1 / k : ℝ) * x) (1 / k : ℝ) t := by
      simpa using (hasDerivAt_id t).const_mul (1 / k : ℝ)
    have h2 : HasDerivAt (fun x : ℝ => ((x - k) ^ 2 / 2)) (t - k) t := by
      have hs := ((hasDerivAt_id t).sub_const (k : ℝ)).pow 2
      have he : (2 : ℝ) * (t - k) ^ 1 / 2 = t - k := by ring
      simpa [he] using hs.div_const 2
    exact h1.add (h2.const_mul _)
  have heval := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hderiv t) hint2
  rw [heval] at hle
  have hring : ((1 / (k : ℝ)) * (k + 1) + (1 / ((k : ℝ) + 1) - 1 / k) * (((k + 1 - k) ^ 2 / 2))) -
      ((1 / (k : ℝ)) * k + (1 / ((k : ℝ) + 1) - 1 / k) * ((k - k) ^ 2 / 2)) =
      (2 * (k : ℝ) + 1) / (2 * k * (k + 1)) := by
    field_simp; ring
  linarith

lemma linear_div_le_endpoints {a b c₀ c₁ M u : ℝ} (_ha : 0 < a) (hau : a ≤ u) (hub : u ≤ b)
    (h0 : c₀ ≤ a * M) (h1 : c₀ + (b - a) * c₁ ≤ b * M) :
    c₀ + (u - a) * c₁ ≤ u * M := by
  by_cases hba : b = a
  · rw [hba] at hub
    have hua : u = a := le_antisymm hub hau
    rw [hua]; simpa using h0
  · have hpos : 0 < b - a := sub_pos.mpr (lt_of_le_of_ne (by linarith) (Ne.symm hba))
    set θ : ℝ := (u - a) / (b - a)
    have hθ0 : 0 ≤ θ := div_nonneg (sub_nonneg.mpr hau) (le_of_lt hpos)
    have hθ1 : θ ≤ 1 := (div_le_one hpos).mpr (by linarith)
    have hu_eq : u = (1 - θ) * a + θ * b := by dsimp [θ]; field_simp; ring
    have hc_eq : c₀ + (u - a) * c₁ = (1 - θ) * c₀ + θ * (c₀ + (b - a) * c₁) := by
      dsimp [θ]; field_simp; ring
    rw [hc_eq, hu_eq]
    have hcomb := add_le_add (mul_le_mul_of_nonneg_left h0 (sub_nonneg.mpr hθ1))
      (mul_le_mul_of_nonneg_left h1 hθ0)
    linarith

lemma buchstab_table_sound_aux {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    ∀ k ≤ 4 * K_grid,
      ((1 + (k : ℝ) / K_grid) * ω (1 + (k : ℝ) / K_grid) ≤ (getV k : ℝ) / S_scale) ∧
      (∀ m < k, ∀ u : ℝ, 1 + (m : ℝ) / K_grid ≤ u → u ≤ 1 + ((m : ℝ) + 1) / K_grid →
        ω u ≤ (getU m : ℝ) / S_scale) := by
  have hcert := validBuchstabCert_ok
  simp only [validBuchstabCert, Bool.and_eq_true, decide_eq_true_eq] at hcert
  have hKpos : (0 : ℝ) < K_grid := by unfold K_grid; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hstep : ∀ k < 4 * K_grid, checkBuchstabStep k = true := by
    intro k hk
    exact allTree_sound T_depth 0 checkBuchstabStep hcert.2 k (Nat.zero_le _)
      (by unfold T_depth K_grid at *; omega)
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
    intro hk4
    have hVk : (1 + (k : ℝ) / K_grid) * ω (1 + (k : ℝ) / K_grid) ≤ (getV k : ℝ) / S_scale := by
      by_cases hk1 : k ≤ K_grid
      · have hle2 : 1 + (k : ℝ) / K_grid ≤ 2 := by
          have : (k : ℝ) / K_grid ≤ 1 := (div_le_one hKpos).mpr (by exact_mod_cast hk1)
          linarith
        have hge1 : 1 ≤ 1 + (k : ℝ) / K_grid := by linarith [show (0 : ℝ) ≤ (k : ℝ) / K_grid by positivity]
        rw [hω.2.1 _ hge1 hle2]
        have hpos : (1 + (k : ℝ) / K_grid) ≠ 0 := ne_of_gt (by positivity)
        rw [mul_one_div_cancel hpos, one_le_div hSpos]
        by_cases hklt : k < K_grid
        · have hs := hstep k (by unfold K_grid at *; omega)
          have hltK : k < K_grid := hklt
          simp only [checkBuchstabStep, hltK, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hs
          exact_mod_cast hs.1
        · have hkeq : k = K_grid := by omega
          subst hkeq
          exact_mod_cast hcert.1.2
      · have hkgt : K_grid < k := Nat.lt_of_not_ge hk1
        obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 := ⟨k - 1, by omega⟩
        have ihm := ih m (Nat.lt_succ_self m) (by omega)
        have hsm := hstep m (by omega)
        by_cases hm2K : m < 2 * K_grid
        · have hmgeK : ¬ m < K_grid := by omega
          have hmlt2K : m < 2 * K_grid := hm2K
          simp only [checkBuchstabStep, hmgeK, hmlt2K, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hsm
          have hVdiff : (S_scale : ℝ) * (2 * m + 1) ≤ 2 * m * (m + 1) * ((getV (m + 1) : ℝ) - getV m) := by
            have hsub : ((getV (m + 1) - getV m : ℕ) : ℝ) = (getV (m + 1) : ℝ) - getV m :=
              Nat.cast_sub hsm.1.1.1
            rw [← hsub]; exact_mod_cast hsm.1.1.2
          have hmpos : 0 < m := by unfold K_grid at hkgt; omega
          have hG0 := buchstab_G_eq_two_three hω (u := 1 + (m : ℝ) / K_grid)
            (by have : 1 ≤ (m : ℝ) / K_grid := (le_div_iff₀ hKpos).mpr (by exact_mod_cast (by unfold K_grid at hkgt; omega : K_grid ≤ m)); linarith)
            (by have : (m : ℝ) / K_grid ≤ 2 := (div_le_iff₀ hKpos).mpr (by exact_mod_cast (by unfold K_grid at hm2K; omega : m ≤ 2 * K_grid)); linarith)
          have hG1 := buchstab_G_eq_two_three hω (u := 1 + ((m + 1 : ℕ) : ℝ) / K_grid)
            (by have : 1 ≤ ((m + 1 : ℕ) : ℝ) / K_grid := (le_div_iff₀ hKpos).mpr (by exact_mod_cast (by unfold K_grid at hkgt; omega : K_grid ≤ m + 1)); linarith)
            (by have : ((m + 1 : ℕ) : ℝ) / K_grid ≤ 2 := (div_le_iff₀ hKpos).mpr (by exact_mod_cast (by unfold K_grid at hm2K; omega : m + 1 ≤ 2 * K_grid)); linarith)
          have hlog : (1 + ((m + 1 : ℕ) : ℝ) / K_grid) * ω (1 + ((m + 1 : ℕ) : ℝ) / K_grid) -
              (1 + (m : ℝ) / K_grid) * ω (1 + (m : ℝ) / K_grid) =
              Real.log (((m : ℝ) + 1) / m) := by
            rw [hG1, hG0]
            have hmposr : (0 : ℝ) < m := by exact_mod_cast hmpos
            have heq : (((1 + ((m + 1 : ℕ) : ℝ) / K_grid - 1)) / (1 + (m : ℝ) / K_grid - 1)) = ((m : ℝ) + 1) / m := by
              simp only [add_sub_cancel_left]; push_cast; field_simp
            have hnum_pos : 0 < 1 + ((m + 1 : ℕ) : ℝ) / K_grid - 1 := by simp only [add_sub_cancel_left]; push_cast; positivity
            have hden_pos : 0 < 1 + (m : ℝ) / K_grid - 1 := by simp only [add_sub_cancel_left]; positivity
            rw [← heq, Real.log_div (ne_of_gt hnum_pos) (ne_of_gt hden_pos)]
            ring
          have hlog_le := log_succ_div_le m hmpos
          have hdiff_le : Real.log (((m : ℝ) + 1) / m) ≤ (getV (m + 1) : ℝ) / S_scale - (getV m : ℝ) / S_scale := by
            have hmposr : (0 : ℝ) < m := by exact_mod_cast hmpos
            have h1 : (2 * (m : ℝ) + 1) / (2 * m * (m + 1)) ≤ ((getV (m + 1) : ℝ) - getV m) / S_scale := by
              rw [div_le_div_iff₀ (by positivity) hSpos]
              linarith
            rw [sub_div] at h1
            exact le_trans hlog_le h1
          linarith [ihm.1]
        · have hmgeK : ¬ m < K_grid := by omega
          have hmge2K : ¬ m < 2 * K_grid := hm2K
          simp only [checkBuchstabStep, hmgeK, hmge2K, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hsm
          rcases hsm with ⟨⟨⟨⟨hVle, hVstep⟩, _⟩, _⟩, _⟩
          have hVdiff : (getU (m - K_grid) : ℝ) ≤ K_grid * ((getV (m + 1) : ℝ) - getV m) := by
            have hsub : ((getV (m + 1) - getV m : ℕ) : ℝ) = (getV (m + 1) : ℝ) - getV m :=
              Nat.cast_sub hVle
            rw [← hsub]
            exact_mod_cast hVstep
          set a : ℝ := 1 + (m : ℝ) / K_grid
          set b : ℝ := 1 + ((m + 1 : ℕ) : ℝ) / K_grid
          have hab : a < b := by
            dsimp [a, b]; push_cast
            have : (m : ℝ) / K_grid < (m + 1 : ℝ) / K_grid := div_lt_div_of_pos_right (by linarith) hKpos
            linarith
          have ha2 : 2 < a := by
            dsimp [a]
            have : (2 : ℝ) ≤ (m : ℝ) / K_grid := (le_div_iff₀ hKpos).mpr (by exact_mod_cast (by unfold K_grid at *; omega : 2 * K_grid ≤ m))
            linarith
          have hGcont : ContinuousOn (fun v => v * ω v) (Icc a b) :=
            continuousOn_id.mul (hω.1.mono (fun v (hv : _ ≤ v ∧ v ≤ _) => show (1 : ℝ) ≤ v by linarith [ha2]))
          have hGderiv : ∀ v ∈ Ioo a b, HasDerivAt (fun t => t * ω t) (ω (v - 1)) v := by
            intro v hv; exact hω.2.2 v (lt_trans ha2 hv.1)
          obtain ⟨c, hc, hcmvt⟩ := exists_hasDerivAt_eq_slope (fun v => v * ω v) (fun v => ω (v - 1))
            hab hGcont (fun v hv => hGderiv v hv)
          have hc1_lo : 1 + ((m - K_grid : ℕ) : ℝ) / K_grid ≤ c - 1 := by
            have hsub_nat : ((m - K_grid : ℕ) : ℝ) = (m : ℝ) - K_grid := by
              rw [Nat.cast_sub (by unfold K_grid at hkgt; omega)]
            rw [hsub_nat]
            have h1 : a - 1 = 1 + ((m : ℝ) - K_grid) / K_grid := by
              dsimp [a]; field_simp; ring
            linarith [hc.1]
          have hc1_hi : c - 1 ≤ 1 + (((m - K_grid : ℕ) : ℝ) + 1) / K_grid := by
            have hsub_nat : ((m - K_grid : ℕ) : ℝ) = (m : ℝ) - K_grid := by
              rw [Nat.cast_sub (by unfold K_grid at hkgt; omega)]
            rw [hsub_nat]
            have h1 : b - 1 = 1 + (((m : ℝ) - K_grid) + 1) / K_grid := by
              dsimp [b]; push_cast; field_simp; ring
            linarith [hc.2]
          have hωc : ω (c - 1) ≤ (getU (m - K_grid) : ℝ) / S_scale :=
            ihm.2 (m - K_grid) (by unfold K_grid at *; omega) (c - 1) hc1_lo hc1_hi
          have hba_eq : b - a = 1 / (K_grid : ℝ) := by
            dsimp [a, b]; push_cast; field_simp; ring
          have hGdiff : b * ω b - a * ω a = (b - a) * ω (c - 1) := by
            have hba_ne : b - a ≠ 0 := sub_ne_zero.mpr (ne_of_gt hab)
            rw [hcmvt]; field_simp [hba_ne]
          have hGdiff_le : b * ω b - a * ω a ≤ (getV (m + 1) : ℝ) / S_scale - (getV m : ℝ) / S_scale := by
            rw [hGdiff, hba_eq]
            have h1 : (1 / (K_grid : ℝ)) * ω (c - 1) ≤ (1 / (K_grid : ℝ)) * ((getU (m - K_grid) : ℝ) / S_scale) :=
              mul_le_mul_of_nonneg_left hωc (by positivity)
            have h2 : (1 / (K_grid : ℝ)) * ((getU (m - K_grid) : ℝ) / S_scale) ≤ ((getV (m + 1) : ℝ) - getV m) / S_scale := by
              rw [div_mul_div_comm, one_mul, div_le_div_iff₀ (by positivity) hSpos]
              linarith [mul_le_mul_of_nonneg_right hVdiff (le_of_lt hSpos)]
            rw [sub_div] at h2
            exact le_trans h1 h2
          have hVb : b * ω b ≤ (getV (m + 1) : ℝ) / S_scale := by linarith [ihm.1]
          simpa [b] using hVb
    refine ⟨hVk, ?_⟩
    intro m hm u hu0 hu1
    by_cases hmprev : m + 1 < k
    · obtain ⟨j, hj⟩ : ∃ j, m < j ∧ j < k := ⟨m + 1, Nat.lt_succ_self m, hmprev⟩
      exact (ih j hj.2 (by omega)).2 m hj.1 u hu0 hu1
    · have hkeq : k = m + 1 := by omega
      subst hkeq
      have ihm := ih m (Nat.lt_succ_self m) (by omega)
      have hsm := hstep m (by omega)
      by_cases hmK : m < K_grid
      · have hmltK : m < K_grid := hmK
        simp only [checkBuchstabStep, hmltK, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hsm
        have hu2 : u ≤ 2 := by
          have : ((m : ℝ) + 1) / K_grid ≤ 1 := (div_le_one hKpos).mpr (by exact_mod_cast (by omega : m + 1 ≤ K_grid))
          linarith
        have hu_ge1 : 1 ≤ u := by
          have : (0 : ℝ) ≤ (m : ℝ) / K_grid := by positivity
          linarith
        rw [hω.2.1 u hu_ge1 hu2]
        have hpos_lo : (0 : ℝ) < 1 + (m : ℝ) / K_grid := by positivity
        have h1 : 1 / u ≤ 1 / (1 + (m : ℝ) / K_grid) := one_div_le_one_div_of_le hpos_lo hu0
        have h2 : 1 / (1 + (m : ℝ) / K_grid) = (K_grid : ℝ) / (K_grid + m) := by field_simp
        have h3 : (K_grid : ℝ) / (K_grid + m) ≤ (getU m : ℝ) / S_scale := by
          rw [div_le_div_iff₀ (by positivity) hSpos]
          exact_mod_cast hsm.2
        exact le_trans h1 (h2 ▸ h3)
      · have hmgeK : ¬ m < K_grid := hmK
        by_cases hm2K : m < 2 * K_grid
        · have hmlt2K : m < 2 * K_grid := hm2K
          simp only [checkBuchstabStep, hmgeK, hmlt2K, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hsm
          set a : ℝ := 1 + (m : ℝ) / K_grid
          set b : ℝ := 1 + ((m : ℝ) + 1) / K_grid
          have ha2 : 2 ≤ a := by
            dsimp [a]
            have : (1 : ℝ) ≤ (m : ℝ) / K_grid := (le_div_iff₀ hKpos).mpr (by exact_mod_cast (by unfold K_grid at hmK; omega : K_grid ≤ m))
            linarith
          have hb3 : b ≤ 3 := by
            dsimp [b]
            have : ((m : ℝ) + 1) / K_grid ≤ 2 := (div_le_iff₀ hKpos).mpr (by exact_mod_cast (by unfold K_grid at hm2K; omega : m + 1 ≤ 2 * K_grid))
            linarith
          have hu2 : 2 ≤ u := le_trans ha2 hu0
          have hu3 : u ≤ 3 := le_trans hu1 hb3
          have hGu := buchstab_G_eq_two_three hω hu2 hu3
          have hGa := buchstab_G_eq_two_three hω ha2 (le_trans (by linarith [hu0, hu1]) hb3)
          have hlog_le : Real.log ((u - 1) / (a - 1)) ≤ (u - a) / (a - 1) := by
            have ha1pos : 0 < a - 1 := by linarith
            have hu1pos : 0 < u - 1 := by linarith
            have h := Real.log_le_sub_one_of_pos (div_pos hu1pos ha1pos)
            have heq : (u - 1) / (a - 1) - 1 = (u - a) / (a - 1) := by field_simp; ring
            linarith
          have hGdiff : u * ω u ≤ (getV m : ℝ) / S_scale + (u - a) * ((K_grid : ℝ) / m) := by
            have hmpos : (0 : ℝ) < m := by exact_mod_cast (by unfold K_grid at hmK; omega : 0 < m)
            have ha_sub : a - 1 = (m : ℝ) / K_grid := by dsimp [a]; ring
            have h1 : (u - a) / (a - 1) = (u - a) * ((K_grid : ℝ) / m) := by rw [ha_sub]; field_simp
            have hlog_eq : u * ω u - a * ω a = Real.log ((u - 1) / (a - 1)) := by
              rw [hGu, hGa, Real.log_div (by linarith) (by linarith)]; ring
            linarith [ihm.1]
          have hlin : (getV m : ℝ) / S_scale + (u - a) * ((K_grid : ℝ) / m) ≤ u * ((getU m : ℝ) / S_scale) := by
            apply linear_div_le_endpoints (by linarith) hu0 hu1
            · have ha_eq : a = (K_grid + m : ℝ) / K_grid := by dsimp [a]; field_simp
              rw [ha_eq, div_mul_div_comm, div_le_div_iff₀ hSpos (by positivity)]
              have hle_nat : (K_grid : ℝ) * getV m ≤ getU m * (K_grid + m) := by exact_mod_cast hsm.1.2
              calc (getV m : ℝ) * (K_grid * S_scale) = ((K_grid : ℝ) * getV m) * S_scale := by ring
                _ ≤ (getU m * (K_grid + m)) * S_scale := mul_le_mul_of_nonneg_right hle_nat (le_of_lt hSpos)
                _ = (K_grid + m) * getU m * S_scale := by ring
            · have hmpos : (0 : ℝ) < m := by exact_mod_cast (by unfold K_grid at hmK; omega : 0 < m)
              have hba_eq : b - a = 1 / (K_grid : ℝ) := by dsimp [a, b]; field_simp <;> ring
              have hb_eq : b = (K_grid + m + 1 : ℝ) / K_grid := by dsimp [b]; field_simp <;> ring
              have hlhs : (getV m : ℝ) / S_scale + (b - a) * ((K_grid : ℝ) / m) =
                  ((m : ℝ) * getV m + S_scale) / ((m : ℝ) * S_scale) := by
                rw [hba_eq]; field_simp <;> ring
              have hrhs : b * ((getU m : ℝ) / S_scale) =
                  ((K_grid + m + 1 : ℝ) * getU m) / ((K_grid : ℝ) * S_scale) := by
                rw [hb_eq]; field_simp <;> ring
              rw [hlhs, hrhs, div_le_div_iff₀ (by positivity) (by positivity)]
              have hle_nat : (K_grid : ℝ) * (m * getV m + S_scale) ≤ m * (K_grid + m + 1) * getU m := by
                exact_mod_cast hsm.2
              calc ((m : ℝ) * getV m + S_scale) * (K_grid * S_scale)
                  = ((K_grid : ℝ) * (m * getV m + S_scale)) * S_scale := by ring
                _ ≤ (m * (K_grid + m + 1) * getU m) * S_scale := mul_le_mul_of_nonneg_right hle_nat (le_of_lt hSpos)
                _ = (K_grid + m + 1) * getU m * (m * S_scale) := by ring
          have hupos : 0 < u := by linarith
          exact le_of_mul_le_mul_left (le_trans hGdiff hlin) hupos
        · have hmge2K : ¬ m < 2 * K_grid := hm2K
          simp only [checkBuchstabStep, hmgeK, hmge2K, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hsm
          set a : ℝ := 1 + (m : ℝ) / K_grid
          set b : ℝ := 1 + ((m : ℝ) + 1) / K_grid
          have ha2 : 2 < a := by
            dsimp [a]
            have : (2 : ℝ) ≤ (m : ℝ) / K_grid := (le_div_iff₀ hKpos).mpr (by exact_mod_cast (by unfold K_grid at hm2K; omega : 2 * K_grid ≤ m))
            linarith
          have hG_bound : u * ω u ≤ (getV m : ℝ) / S_scale + (u - a) * ((K_grid : ℝ) * ((getV (m + 1) : ℝ) - getV m) / S_scale) := by
            by_cases hua : u = a
            · subst hua; simp [ihm.1]
            · have hau : a < u := lt_of_le_of_ne hu0 (Ne.symm hua)
              have hGcont : ContinuousOn (fun v => v * ω v) (Icc a u) :=
                continuousOn_id.mul (hω.1.mono (fun v (hv : _ ≤ v ∧ v ≤ _) => show (1 : ℝ) ≤ v by linarith [ha2]))
              have hGderiv : ∀ v ∈ Ioo a u, HasDerivAt (fun t => t * ω t) (ω (v - 1)) v := by
                intro v hv; exact hω.2.2 v (lt_trans ha2 hv.1)
              obtain ⟨c, hc, hcmvt⟩ := exists_hasDerivAt_eq_slope (fun v => v * ω v) (fun v => ω (v - 1))
                hau hGcont (fun v hv => hGderiv v hv)
              have hc1_lo : 1 + ((m - K_grid : ℕ) : ℝ) / K_grid ≤ c - 1 := by
                have hsub_nat : ((m - K_grid : ℕ) : ℝ) = (m : ℝ) - K_grid := by
                  rw [Nat.cast_sub (by unfold K_grid at hmK; omega)]
                rw [hsub_nat]
                have h1 : a - 1 = 1 + ((m : ℝ) - K_grid) / K_grid := by dsimp [a]; field_simp; ring
                linarith [hc.1]
              have hc1_hi : c - 1 ≤ 1 + (((m - K_grid : ℕ) : ℝ) + 1) / K_grid := by
                have hsub_nat : ((m - K_grid : ℕ) : ℝ) = (m : ℝ) - K_grid := by
                  rw [Nat.cast_sub (by unfold K_grid at hmK; omega)]
                rw [hsub_nat]
                have h1 : b - 1 = 1 + (((m : ℝ) - K_grid) + 1) / K_grid := by dsimp [b]; field_simp; ring
                linarith [hc.2, hu1]
              have hωc : ω (c - 1) ≤ (getU (m - K_grid) : ℝ) / S_scale :=
                ihm.2 (m - K_grid) (by unfold K_grid at *; omega) (c - 1) hc1_lo hc1_hi
              have hVdiff : (getU (m - K_grid) : ℝ) ≤ K_grid * ((getV (m + 1) : ℝ) - getV m) := by
                have hsub : ((getV (m + 1) - getV m : ℕ) : ℝ) = (getV (m + 1) : ℝ) - getV m :=
                  Nat.cast_sub hsm.1.1.1.1
                rw [← hsub]; exact_mod_cast hsm.1.1.1.2
              have hGeq : u * ω u - a * ω a = (u - a) * ω (c - 1) := by
                rw [hcmvt]; field_simp
              have hωc' : ω (c - 1) ≤ (K_grid : ℝ) * ((getV (m + 1) : ℝ) - getV m) / S_scale :=
                le_trans hωc (div_le_div_of_nonneg_right hVdiff (le_of_lt hSpos))
              have hmul : (u - a) * ω (c - 1) ≤ (u - a) * ((K_grid : ℝ) * ((getV (m + 1) : ℝ) - getV m) / S_scale) :=
                mul_le_mul_of_nonneg_left hωc' (sub_nonneg.mpr hu0)
              linarith [ihm.1]
          have hlin : (getV m : ℝ) / S_scale + (u - a) * ((K_grid : ℝ) * ((getV (m + 1) : ℝ) - getV m) / S_scale) ≤
              u * ((getU m : ℝ) / S_scale) := by
            apply linear_div_le_endpoints (by linarith) hu0 hu1
            · have ha_eq : a = (K_grid + m : ℝ) / K_grid := by dsimp [a]; field_simp
              rw [ha_eq, div_mul_div_comm, div_le_div_iff₀ hSpos (by positivity)]
              have hle_nat : (K_grid : ℝ) * getV m ≤ getU m * (K_grid + m) := by exact_mod_cast hsm.1.1.2
              calc (getV m : ℝ) * (K_grid * S_scale) = ((K_grid : ℝ) * getV m) * S_scale := by ring
                _ ≤ (getU m * (K_grid + m)) * S_scale := mul_le_mul_of_nonneg_right hle_nat (le_of_lt hSpos)
                _ = (K_grid + m) * getU m * S_scale := by ring
            · have hba_eq : b - a = 1 / (K_grid : ℝ) := by dsimp [a, b]; field_simp <;> ring
              have hb_eq : b = (K_grid + m + 1 : ℝ) / K_grid := by dsimp [b]; field_simp <;> ring
              have hlhs : (getV m : ℝ) / S_scale + (b - a) * ((K_grid : ℝ) * ((getV (m + 1) : ℝ) - getV m) / S_scale) =
                  (getV (m + 1) : ℝ) / S_scale := by
                rw [hba_eq]; field_simp <;> ring
              rw [hlhs, hb_eq, div_mul_div_comm, div_le_div_iff₀ hSpos (by positivity)]
              have hle_nat : (K_grid : ℝ) * getV (m + 1) ≤ getU m * (K_grid + m + 1) := by exact_mod_cast hsm.1.2
              calc (getV (m + 1) : ℝ) * (K_grid * S_scale) = ((K_grid : ℝ) * getV (m + 1)) * S_scale := by ring
                _ ≤ (getU m * (K_grid + m + 1)) * S_scale := mul_le_mul_of_nonneg_right hle_nat (le_of_lt hSpos)
                _ = (K_grid + m + 1) * getU m * S_scale := by ring
          have hupos : 0 < u := by linarith
          exact le_of_mul_le_mul_left (le_trans hG_bound hlin) hupos

lemma buchstab_le_M4 {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    ∀ u : ℝ, 4 ≤ u → ω u ≤ (M4_val : ℝ) / S_scale := by
  have htab := buchstab_table_sound_aux hω (4 * K_grid) (le_refl _)
  have hcert := validBuchstabCert_ok
  simp only [validBuchstabCert, Bool.and_eq_true, decide_eq_true_eq] at hcert
  have hKpos : (0 : ℝ) < K_grid := by unfold K_grid; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hstep : ∀ k < 4 * K_grid, checkBuchstabStep k = true := fun k hk =>
    allTree_sound T_depth 0 checkBuchstabStep hcert.2 k (Nat.zero_le _)
      (by unfold T_depth K_grid at *; omega)
  have h45 : ∀ u : ℝ, 4 ≤ u → u ≤ 5 → ω u ≤ (M4_val : ℝ) / S_scale := by
    intro u hu4 hu5
    by_cases hu5_eq : u = 5
    · subst hu5_eq
      set k := 4 * K_grid - 1
      have hk4 : k < 4 * K_grid := by dsimp only [k]; unfold K_grid; omega
      have hk0 : 1 + (k : ℝ) / K_grid ≤ 5 := by
        have : (k : ℝ) ≤ 4 * K_grid := by exact_mod_cast (by dsimp only [k]; unfold K_grid; omega : k ≤ 4 * K_grid)
        have : (k : ℝ) / K_grid ≤ 4 := (div_le_iff₀ hKpos).mpr (by linarith)
        linarith
      have hk1 : (5 : ℝ) ≤ 1 + ((k : ℝ) + 1) / K_grid := by
        have : (k : ℝ) + 1 = 4 * K_grid := by exact_mod_cast (by dsimp only [k]; unfold K_grid; omega : k + 1 = 4 * K_grid)
        rw [this]; field_simp; ring_nf; exact le_refl _
      have hU := htab.2 k hk4 5 hk0 hk1
      have hs := hstep k hk4
      have hgeK : ¬ k < K_grid := by dsimp only [k]; unfold K_grid; omega
      have hge2K : ¬ k < 2 * K_grid := by dsimp only [k]; unfold K_grid; omega
      have hge3K : 3 * K_grid ≤ k := by dsimp only [k]; unfold K_grid; omega
      simp only [checkBuchstabStep, hgeK, hge2K, hge3K, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hs
      exact le_trans hU (div_le_div_of_nonneg_right (by exact_mod_cast hs.2) (le_of_lt hSpos))
    · have hu5_lt : u < 5 := lt_of_le_of_ne hu5 hu5_eq
      set k := Nat.floor ((u - 1) * K_grid)
      have hk_lo : 3 * K_grid ≤ k := by
        apply Nat.le_floor
        push_cast; nlinarith [hu4, hKpos]
      have hk_hi : k < 4 * K_grid := by
        rw [Nat.floor_lt (by nlinarith [hu4, hKpos])]
        push_cast; nlinarith [hu5_lt, hKpos]
      have hku0 : 1 + (k : ℝ) / K_grid ≤ u := by
        have hfl := Nat.floor_le (show 0 ≤ (u - 1) * K_grid by nlinarith [hu4, hKpos])
        have : (k : ℝ) / K_grid ≤ u - 1 := (div_le_iff₀ hKpos).mpr hfl
        linarith
      have hku1 : u ≤ 1 + ((k : ℝ) + 1) / K_grid := by
        have hfl := Nat.lt_floor_add_one ((u - 1) * K_grid)
        have : u - 1 < ((k : ℝ) + 1) / K_grid := (lt_div_iff₀ hKpos).mpr hfl
        linarith
      have hU := htab.2 k hk_hi u hku0 hku1
      have hs := hstep k hk_hi
      have hgeK : ¬ k < K_grid := Nat.not_lt.mpr (le_trans (by unfold K_grid; omega) hk_lo)
      have hge2K : ¬ k < 2 * K_grid := Nat.not_lt.mpr (le_trans (by unfold K_grid; omega) hk_lo)
      have hge3K : 3 * K_grid ≤ k := hk_lo
      simp only [checkBuchstabStep, hgeK, hge2K, hge3K, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hs
      exact le_trans hU (div_le_div_of_nonneg_right (by exact_mod_cast hs.2) (le_of_lt hSpos))
  have hind : ∀ (n : ℕ) (u : ℝ), 4 ≤ u → u ≤ (n + 5 : ℕ) → ω u ≤ (M4_val : ℝ) / S_scale := by
    intro n
    induction n with
    | zero => intro u hu4 hu5; exact h45 u hu4 (by norm_num at hu5; exact hu5)
    | succ n ih =>
        intro u hu4 huN
        by_cases hle : u ≤ ((n + 5 : ℕ) : ℝ)
        · exact ih u hu4 hle
        · have hgt : ((n + 5 : ℕ) : ℝ) < u := lt_of_not_ge hle
          have hGcont : ContinuousOn (fun v => v * ω v) (Icc ((n + 5 : ℕ) : ℝ) u) :=
            continuousOn_id.mul (hω.1.mono (fun v (hv : _ ≤ v ∧ v ≤ _) => by
              have : (1 : ℝ) ≤ (n + 5 : ℕ) := by exact_mod_cast (by omega : 1 ≤ n + 5)
              exact le_trans this hv.1))
          have hGderiv : ∀ v ∈ Ioo ((n + 5 : ℕ) : ℝ) u, HasDerivAt (fun t => t * ω t) (ω (v - 1)) v := by
            intro v hv
            have hv2 : 2 < v := by
              have : (2 : ℝ) ≤ (n + 5 : ℕ) := by exact_mod_cast (by omega : 2 ≤ n + 5)
              exact lt_of_le_of_lt this hv.1
            exact hω.2.2 v hv2
          obtain ⟨c, hc, hcmvt⟩ := exists_hasDerivAt_eq_slope (fun v => v * ω v) (fun v => ω (v - 1))
            hgt hGcont (fun v hv => hGderiv v hv)
          have hc1_4 : 4 ≤ c - 1 := by
            have : (5 : ℝ) ≤ (n + 5 : ℕ) := by exact_mod_cast (by omega : 5 ≤ n + 5)
            linarith [hc.1]
          have hc1_N : c - 1 ≤ ((n + 5 : ℕ) : ℝ) := by
            have : u ≤ ((n + 5 : ℕ) : ℝ) + 1 := by exact_mod_cast huN
            linarith [hc.2]
          have hωc : ω (c - 1) ≤ (M4_val : ℝ) / S_scale := ih (c - 1) hc1_4 hc1_N
          have hω5 : ω ((n + 5 : ℕ) : ℝ) ≤ (M4_val : ℝ) / S_scale :=
            ih ((n + 5 : ℕ) : ℝ) (by exact_mod_cast (by omega : 4 ≤ n + 5)) (le_refl _)
          have hGeq : u * ω u = ((n + 5 : ℕ) : ℝ) * ω ((n + 5 : ℕ) : ℝ) + (u - ((n + 5 : ℕ) : ℝ)) * ω (c - 1) := by
            have hne : u - ((n + 5 : ℕ) : ℝ) ≠ 0 := sub_ne_zero.mpr (ne_of_gt hgt)
            rw [hcmvt]; field_simp [hne]; ring
          have hG_le : u * ω u ≤ ((n + 5 : ℕ) : ℝ) * ((M4_val : ℝ) / S_scale) +
              (u - ((n + 5 : ℕ) : ℝ)) * ((M4_val : ℝ) / S_scale) := by
            rw [hGeq]
            exact add_le_add (mul_le_mul_of_nonneg_left hω5 (by positivity))
              (mul_le_mul_of_nonneg_left hωc (sub_nonneg.mpr (le_of_lt hgt)))
          have hG_le' : u * ω u ≤ u * ((M4_val : ℝ) / S_scale) := by linarith
          exact le_of_mul_le_mul_left hG_le' (by linarith)
  intro u hu4
  obtain ⟨N, hN⟩ := exists_nat_ge u
  exact hind N u hu4 (by exact_mod_cast (by linarith [show u ≤ (N : ℝ) from hN, show (N : ℝ) ≤ (N + 5 : ℕ) by exact_mod_cast (by omega : N ≤ N + 5)]))

lemma buchstab_le_buchstabUB {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {k0 k1 : ℕ} {u : ℝ}
    (hlo : 1 ≤ u → 1 + (k0 : ℝ) / K_grid ≤ u)
    (hhi : u < 1 + ((k1 : ℝ) + 1) / K_grid) :
    ω u ≤ (buchstabUB k0 k1 : ℝ) / S_scale := by
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  by_cases hu1 : u < 1
  · rw [hz u hu1]; positivity
  · have hu_ge1 : 1 ≤ u := le_of_not_gt hu1
    have hKpos : (0 : ℝ) < K_grid := by unfold K_grid; positivity
    set k := Nat.floor ((u - 1) * K_grid)
    have hku0 : 1 + (k : ℝ) / K_grid ≤ u := by
      have hfl := Nat.floor_le (show 0 ≤ (u - 1) * K_grid by nlinarith [hu_ge1, hKpos])
      have : (k : ℝ) / K_grid ≤ u - 1 := (div_le_iff₀ hKpos).mpr hfl
      linarith
    have hku1 : u < 1 + ((k : ℝ) + 1) / K_grid := by
      have hfl := Nat.lt_floor_add_one ((u - 1) * K_grid)
      have : u - 1 < ((k : ℝ) + 1) / K_grid := (lt_div_iff₀ hKpos).mpr hfl
      linarith
    have hk0_le : k0 ≤ k := by
      have h1 : 1 + (k0 : ℝ) / K_grid < 1 + ((k : ℝ) + 1) / K_grid := lt_of_le_of_lt (hlo hu_ge1) hku1
      have h2 : (k0 : ℝ) < (k : ℝ) + 1 := (div_lt_div_iff_of_pos_right hKpos).mp (by linarith)
      exact Nat.lt_succ_iff.mp (by exact_mod_cast h2)
    have hk_le1 : k ≤ k1 := by
      have h1 : 1 + (k : ℝ) / K_grid < 1 + ((k1 : ℝ) + 1) / K_grid := lt_of_le_of_lt hku0 hhi
      have h2 : (k : ℝ) < (k1 : ℝ) + 1 := (div_lt_div_iff_of_pos_right hKpos).mp (by linarith)
      exact Nat.lt_succ_iff.mp (by exact_mod_cast h2)
    have hcert := validBuchstabCert_ok
    simp only [validBuchstabCert, Bool.and_eq_true, decide_eq_true_eq] at hcert
    have hUvalid : U_tree.isValid T_depth = true := hcert.1.1
    by_cases hk4 : 4 * K_grid ≤ k
    · have hu4 : 4 ≤ u := by
        have : (4 : ℝ) ≤ (k : ℝ) / K_grid := (le_div_iff₀ hKpos).mpr (by exact_mod_cast (by unfold K_grid at *; omega : 4 * K_grid ≤ k))
        linarith
      have hM := buchstab_le_M4 hω u hu4
      refine le_trans hM (div_le_div_of_nonneg_right ?_ (le_of_lt hSpos))
      exact_mod_cast (by
        unfold buchstabUB
        split_ifs with c1 c2
        · exact le_refl M4_val
        · omega
        · exact le_max_right _ _)
    · have hklt : k < 4 * K_grid := Nat.lt_of_not_ge hk4
      have htab := buchstab_table_sound_aux hω (4 * K_grid) (le_refl _)
      have hU := htab.2 k hklt u hku0 (le_of_lt hku1)
      refine le_trans hU (div_le_div_of_nonneg_right ?_ (le_of_lt hSpos))
      exact_mod_cast (by
        unfold buchstabUB
        have hn0 : ¬ 4 * K_grid ≤ k0 := by unfold K_grid at *; omega
        rw [if_neg hn0]
        have hhalf : 0 < T_depth → 2 * K_grid = 2 ^ (T_depth - 1) := by
          intro _; unfold T_depth K_grid; norm_num
        have h2d : 2 ^ T_depth = 4 * K_grid := by unfold T_depth K_grid; norm_num
        split_ifs with h1
        · exact segTree_get_le_rangeMax T_depth U_tree (2 * K_grid) k0 k1 k hUvalid hhalf hk0_le hk_le1 (by rw [h2d]; exact h1)
        · have hmax := segTree_get_le_rangeMax T_depth U_tree (2 * K_grid) k0 (4 * K_grid - 1) k hUvalid hhalf hk0_le (by omega) (by rw [h2d]; omega)
          exact le_trans hmax (le_max_left _ _))

/-! ### Part 3: Weight integrals, Simpson, Diagonal bounds, and BoxTree induction -/

def ordBox3 (a0 b0 a1 b1 a2 b2 : ℝ) : Set (Fin 3 → ℝ) :=
  {x | x 0 ∈ Icc a0 b0 ∧ x 1 ∈ Icc a1 b1 ∧ x 2 ∈ Icc a2 b2 ∧ x 0 ≤ x 1 ∧ x 1 ≤ x 2}

lemma ordBox3_measurable (a0 b0 a1 b1 a2 b2 : ℝ) : MeasurableSet (ordBox3 a0 b0 a1 b1 a2 b2) := by
  have h1 : MeasurableSet {x : Fin 3 → ℝ | x 0 ∈ Icc a0 b0} := measurableSet_Icc.preimage (measurable_pi_apply 0)
  have h2 : MeasurableSet {x : Fin 3 → ℝ | x 1 ∈ Icc a1 b1} := measurableSet_Icc.preimage (measurable_pi_apply 1)
  have h3 : MeasurableSet {x : Fin 3 → ℝ | x 2 ∈ Icc a2 b2} := measurableSet_Icc.preimage (measurable_pi_apply 2)
  have h4 : MeasurableSet {x : Fin 3 → ℝ | x 0 ≤ x 1} := measurableSet_le (measurable_pi_apply 0) (measurable_pi_apply 1)
  have h5 : MeasurableSet {x : Fin 3 → ℝ | x 1 ≤ x 2} := measurableSet_le (measurable_pi_apply 1) (measurable_pi_apply 2)
  simpa only [ordBox3, setOf_and] using (h1.inter (h2.inter (h3.inter (h4.inter h5))))

lemma integral_inv_sq_eq {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in a..b, (1 / (t * t) : ℝ) = 1 / a - 1 / b := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hderiv : ∀ t ∈ uIcc a b, HasDerivAt (fun x : ℝ => - (1 / x)) (1 / (t * t)) t := by
    intro t ht
    have ht' : t ∈ Icc a b := by simpa [uIcc_of_le hab] using ht
    have htpos : t ≠ 0 := ne_of_gt (lt_of_lt_of_le ha ht'.1)
    have h1 : HasDerivAt (fun x : ℝ => x⁻¹) (- (t ^ 2)⁻¹) t := hasDerivAt_inv htpos
    have h2 : HasDerivAt (fun x : ℝ => - (1 / x)) (- (- (t ^ 2)⁻¹)) t := by
      simpa [one_div] using h1.fun_neg
    convert h2 using 1
    field_simp
  have hint : IntervalIntegrable (fun t : ℝ => 1 / (t * t)) volume a b := by
    apply ContinuousOn.intervalIntegrable_of_Icc hab
    exact continuousOn_const.div (continuousOn_id.mul continuousOn_id)
      (fun t ht => mul_ne_zero (ne_of_gt (lt_of_lt_of_le ha ht.1)) (ne_of_gt (lt_of_lt_of_le ha ht.1)))
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint]
  ring

lemma integral_inv_le_simpson {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in a..b, (1 / t : ℝ) ≤ (b - a) * ((a + b) ^ 2 + 8 * a * b) / (6 * a * b * (a + b)) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  set m : ℝ := (a + b) / 2
  have hm : 0 < m := by positivity
  set D : ℝ := a * b * m ^ 2
  have hD : 0 < D := by positivity
  set H : ℝ → ℝ := fun t => (-t ^ 3 + 4 * m * t ^ 2 - (5 * m ^ 2 + a * b) * t + 2 * m * (m ^ 2 + a * b)) / D
  set F : ℝ → ℝ := fun t => (-t ^ 4 / 4 + 4 * m * t ^ 3 / 3 - (5 * m ^ 2 + a * b) * t ^ 2 / 2 + 2 * m * (m ^ 2 + a * b) * t) / D
  have hle : ∀ t ∈ Icc a b, (1 / t : ℝ) ≤ H t := by
    intro t ht
    have htpos : 0 < t := lt_of_lt_of_le ha ht.1
    rw [← sub_nonneg]
    have heq : H t - 1 / t = (t - a) * (b - t) * (t - m) ^ 2 / (D * t) := by
      dsimp [H, D, m]; field_simp; ring
    rw [heq]
    exact div_nonneg (mul_nonneg (mul_nonneg (sub_nonneg.mpr ht.1) (sub_nonneg.mpr ht.2)) (sq_nonneg _))
      (mul_nonneg (le_of_lt hD) (le_of_lt htpos))
  have hint1 : IntervalIntegrable (fun t : ℝ => 1 / t) volume a b := by
    apply ContinuousOn.intervalIntegrable_of_Icc hab
    exact continuousOn_const.div continuousOn_id (fun t ht => ne_of_gt (lt_of_lt_of_le ha ht.1))
  have hint2 : IntervalIntegrable H volume a b := Continuous.intervalIntegrable (by continuity) _ _
  have hmono := intervalIntegral.integral_mono_on hab hint1 hint2 hle
  have hderiv : ∀ t : ℝ, HasDerivAt F (H t) t := by
    intro t
    have h1 : HasDerivAt (fun x : ℝ => -x ^ 4 / 4) (-t ^ 3) t := by
      have hd := ((hasDerivAt_pow 4 t).fun_neg).div_const 4
      have heq : -(↑(4 : ℕ) * t ^ (4 - 1)) / 4 = -t ^ 3 := by norm_num; ring
      exact heq ▸ hd
    have h2 : HasDerivAt (fun x : ℝ => 4 * m * x ^ 3 / 3) (4 * m * t ^ 2) t := by
      have hd := (((hasDerivAt_pow 3 t).const_mul (4 * m))).div_const 3
      have heq : 4 * m * (↑(3 : ℕ) * t ^ (3 - 1)) / 3 = 4 * m * t ^ 2 := by norm_num; ring
      exact heq ▸ hd
    have h3 : HasDerivAt (fun x : ℝ => (5 * m ^ 2 + a * b) * x ^ 2 / 2) ((5 * m ^ 2 + a * b) * t) t := by
      have hd := (((hasDerivAt_pow 2 t).const_mul (5 * m ^ 2 + a * b))).div_const 2
      have heq : (5 * m ^ 2 + a * b) * (↑(2 : ℕ) * t ^ (2 - 1)) / 2 = (5 * m ^ 2 + a * b) * t := by norm_num; ring
      exact heq ▸ hd
    have h4 : HasDerivAt (fun x : ℝ => 2 * m * (m ^ 2 + a * b) * x) (2 * m * (m ^ 2 + a * b)) t := by
      simpa using (hasDerivAt_id t).const_mul (2 * m * (m ^ 2 + a * b))
    exact (((h1.add h2).sub h3).add h4).div_const D
  have heval := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hderiv t) hint2
  rw [heval] at hmono
  have hring : F b - F a = (b - a) * ((a + b) ^ 2 + 8 * a * b) / (6 * a * b * (a + b)) := by
    dsimp [F, D, m]; field_simp; ring
  linarith

lemma wSimp_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in ((a : ℝ) / D_den)..((b : ℝ) / D_den), (1 / t : ℝ) ≤ (wSimp a b : ℝ) / W_scale := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have habr : (a : ℝ) / D_den ≤ (b : ℝ) / D_den :=
    div_le_div_of_nonneg_right (by exact_mod_cast hab) (le_of_lt hDpos)
  have hsimp := integral_inv_le_simpson (div_pos har hDpos) habr
  have heq : ((b : ℝ) / D_den - (a : ℝ) / D_den) *
      (((a : ℝ) / D_den + (b : ℝ) / D_den) ^ 2 + 8 * ((a : ℝ) / D_den) * ((b : ℝ) / D_den)) /
      (6 * ((a : ℝ) / D_den) * ((b : ℝ) / D_den) * ((a : ℝ) / D_den + (b : ℝ) / D_den)) =
      ((b : ℝ) - a) * (((a : ℝ) + b) ^ 2 + 8 * a * b) / (6 * a * b * (a + b)) := by
    field_simp
  rw [heq] at hsimp
  have hden_pos : 0 < 6 * a * b * (a + b) := by positivity
  have hceil : W_scale * (b - a) * ((a + b) ^ 2 + 8 * a * b) ≤ (6 * a * b * (a + b)) * wSimp a b :=
    le_mul_ceilDiv hden_pos
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * ((b : ℝ) - a) * (((a : ℝ) + b) ^ 2 + 8 * a * b) ≤
      (6 * (a : ℝ) * b * (a + b)) * (wSimp a b : ℝ) := by
    rw [← hsub]; exact_mod_cast hceil
  have hle : ((b : ℝ) - a) * (((a : ℝ) + b) ^ 2 + 8 * a * b) / (6 * a * b * (a + b)) ≤ (wSimp a b : ℝ) / W_scale := by
    rw [div_le_div_iff₀ (by positivity) hWpos]
    linarith
  exact le_trans hsimp hle

lemma wInvSq_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in ((a : ℝ) / D_den)..((b : ℝ) / D_den), (1 / (t * t) : ℝ) ≤ (wInvSq a b : ℝ) / W_scale := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have habr : (a : ℝ) / D_den ≤ (b : ℝ) / D_den :=
    div_le_div_of_nonneg_right (by exact_mod_cast hab) (le_of_lt hDpos)
  rw [integral_inv_sq_eq (div_pos har hDpos) habr]
  have hsimp : 1 / ((a : ℝ) / D_den) - 1 / ((b : ℝ) / D_den) =
      (D_den : ℝ) * ((b : ℝ) - a) / ((a : ℝ) * b) := by field_simp
  rw [hsimp]
  have hab_pos : 0 < a * b := Nat.mul_pos ha hb
  have hceil : W_scale * D_den * (b - a) ≤ (a * b) * wInvSq a b := by
    simpa [wInvSq, mul_assoc] using le_mul_ceilDiv (a := W_scale * D_den * (b - a)) (b := a * b) hab_pos
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * D_den * ((b : ℝ) - a) ≤ (a : ℝ) * b * (wInvSq a b : ℝ) := by
    rw [← hsub]; exact_mod_cast hceil
  rw [div_le_div_iff₀ (by positivity) hWpos]
  linarith

noncomputable def e012 : (Fin 3 → ℝ) ≃ᵐ ℝ × (ℝ × ℝ) :=
  (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0).trans
    ((MeasurableEquiv.refl ℝ).prodCongr MeasurableEquiv.finTwoArrow)

lemma volume_preserving_e012 : MeasurePreserving e012 volume volume := by
  have h1 : MeasurePreserving (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 0) volume volume :=
    MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 0
  have h2 : MeasurePreserving ((MeasurableEquiv.refl ℝ).prodCongr MeasurableEquiv.finTwoArrow) volume volume :=
    (MeasurePreserving.id volume).prod (MeasureTheory.volume_preserving_finTwoArrow ℝ)
  exact h2.comp h1

lemma e012_apply (x : Fin 3 → ℝ) : e012 x = (x 0, (x 1, x 2)) := rfl

noncomputable def e201 : (Fin 3 → ℝ) ≃ᵐ ℝ × (ℝ × ℝ) :=
  (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 2).trans
    ((MeasurableEquiv.refl ℝ).prodCongr MeasurableEquiv.finTwoArrow)

lemma volume_preserving_e201 : MeasurePreserving e201 volume volume := by
  have h1 : MeasurePreserving (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 2) volume volume :=
    MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 2
  have h2 : MeasurePreserving ((MeasurableEquiv.refl ℝ).prodCongr MeasurableEquiv.finTwoArrow) volume volume :=
    (MeasurePreserving.id volume).prod (MeasureTheory.volume_preserving_finTwoArrow ℝ)
  exact h2.comp h1

lemma e201_apply (x : Fin 3 → ℝ) : e201 x = (x 2, (x 0, x 1)) := rfl

noncomputable def e210 : (Fin 3 → ℝ) ≃ᵐ ℝ × (ℝ × ℝ) :=
  e201.trans ((MeasurableEquiv.refl ℝ).prodCongr MeasurableEquiv.prodComm)

lemma volume_preserving_e210 : MeasurePreserving e210 volume volume := by
  have hswap : MeasurePreserving (⇑(MeasurableEquiv.prodComm (α := ℝ) (β := ℝ)))
      ((volume : Measure ℝ).prod (volume : Measure ℝ))
      ((volume : Measure ℝ).prod (volume : Measure ℝ)) :=
    Measure.measurePreserving_swap
  have h2 : MeasurePreserving (⇑((MeasurableEquiv.refl ℝ).prodCongr (MeasurableEquiv.prodComm (α := ℝ) (β := ℝ))))
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod (volume : Measure ℝ)))
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod (volume : Measure ℝ))) :=
    (MeasurePreserving.id (volume : Measure ℝ)).prod hswap
  exact h2.comp volume_preserving_e201

lemma e210_apply (x : Fin 3 → ℝ) : e210 x = (x 2, (x 1, x 0)) := rfl

lemma weight_eq_e201 (x : Fin 3 → ℝ) :
    (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) =
      (fun p : ℝ × (ℝ × ℝ) => (1 / p.1) * (1 / (p.2.1 * p.2.2 * p.2.2))) (e201 x) := by
  simp only [e201_apply, Fin.prod_univ_three]
  ring

lemma volume_diag_zero : (volume : Measure (ℝ × ℝ)) {p | p.1 = p.2} = 0 := by
  have hm : MeasurableSet {p : ℝ × ℝ | p.1 = p.2} := measurableSet_eq_fun measurable_fst measurable_snd
  rw [Measure.volume_eq_prod, Measure.prod_apply hm]
  simp only [lintegral_eq_zero_iff (measurable_measure_prodMk_left hm)]
  filter_upwards with x
  have : Prod.mk x ⁻¹' {p : ℝ × ℝ | p.1 = p.2} = {x} := by ext y; simp [eq_comm]
  simp [this, Real.volume_singleton]

lemma ordBox3_box_weight {x0a x0b x1a x1b x2a x2b : ℕ}
    (h0p : 0 < x0a) (h0 : x0a ≤ x0b) (h1p : 0 < x1a) (h1 : x1a ≤ x1b) (h2p : 0 < x2a) (h2 : x2a ≤ x2b)
    (h01 : x0b ≤ x1a) (h12 : x1b ≤ x2a) :
    ∫ x in ordBox3 ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                   ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                   ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den),
      (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) ≤
      (wSimp x0a x0b : ℝ) / W_scale * ((wInvSq x1a x1b : ℝ) / W_scale) * ((wSimp x2a x2b : ℝ) / W_scale) := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  set a0 := (x0a : ℝ) / D_den; set b0 := (x0b : ℝ) / D_den
  set a1 := (x1a : ℝ) / D_den; set b1 := (x1b : ℝ) / D_den
  set a2 := (x2a : ℝ) / D_den; set b2 := (x2b : ℝ) / D_den
  have hbox : ordBox3 a0 b0 a1 b1 a2 b2 = univ.pi ![Icc a0 b0, Icc a1 b1, Icc a2 b2] := by
    ext x
    simp only [ordBox3, mem_setOf_eq, mem_univ_pi]
    constructor
    · rintro ⟨hx0, hx1, hx2, _, _⟩ j; fin_cases j <;> simpa using ‹_›
    · intro h
      have hx0 := by simpa using h 0
      have hx1 := by simpa using h 1
      have hx2 := by simpa using h 2
      have h01r : b0 ≤ a1 := div_le_div_of_nonneg_right (by exact_mod_cast h01) (le_of_lt hDpos)
      have h12r : b1 ≤ a2 := div_le_div_of_nonneg_right (by exact_mod_cast h12) (le_of_lt hDpos)
      exact ⟨hx0, hx1, hx2, le_trans hx0.2 (le_trans h01r hx1.1), le_trans hx1.2 (le_trans h12r hx2.1)⟩
  rw [hbox]
  have hfun : (fun x : Fin 3 → ℝ => (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ)) =
      (fun x : Fin 3 → ℝ => ∏ j : Fin 3,
        (![fun t : ℝ => 1 / t, fun t : ℝ => 1 / (t * t), fun t : ℝ => 1 / t] j) (x j)) := by
    ext x; simp only [Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val]; ring
  rw [hfun, show (volume : Measure (Fin 3 → ℝ)) = Measure.pi (fun _ => volume) from rfl, Measure.restrict_pi_pi, MeasureTheory.integral_fintype_prod_eq_prod]
  simp only [Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val]
  have ha0 : a0 ≤ b0 := div_le_div_of_nonneg_right (by exact_mod_cast h0) (le_of_lt hDpos)
  have ha1 : a1 ≤ b1 := div_le_div_of_nonneg_right (by exact_mod_cast h1) (le_of_lt hDpos)
  have ha2 : a2 ≤ b2 := div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hDpos)
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le ha0,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le ha1,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le ha2]
  have hI0 := wSimp_bound h0p h0
  have hI1 := wInvSq_bound h1p h1
  have hI2 := wSimp_bound h2p h2
  have h0nn : 0 ≤ ∫ t in a0..b0, (1 / t : ℝ) :=
    intervalIntegral.integral_nonneg ha0 (fun t ht => div_nonneg zero_le_one (le_of_lt (lt_of_lt_of_le (div_pos (by exact_mod_cast h0p) hDpos) ht.1)))
  have h1nn : 0 ≤ ∫ t in a1..b1, (1 / (t * t) : ℝ) :=
    intervalIntegral.integral_nonneg ha1 (fun t _ => div_nonneg zero_le_one (mul_self_nonneg t))
  have h2nn : 0 ≤ ∫ t in a2..b2, (1 / t : ℝ) :=
    intervalIntegral.integral_nonneg ha2 (fun t ht => div_nonneg zero_le_one (le_of_lt (lt_of_lt_of_le (div_pos (by exact_mod_cast h2p) hDpos) ht.1)))
  exact mul_le_mul (mul_le_mul hI0 hI1 h1nn (by positivity)) hI2 h2nn (by positivity)

lemma ordBox3_d01_weight {a b x2a x2b : ℕ}
    (hap : 0 < a) (hab : a ≤ b) (h2p : 0 < x2a) (h2 : x2a ≤ x2b) (hb2 : b ≤ x2a) :
    ∫ x in ordBox3 ((a : ℝ) / D_den) ((b : ℝ) / D_den)
                   ((a : ℝ) / D_den) ((b : ℝ) / D_den)
                   ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den),
      (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) ≤
      (ceilDiv (wSimp a b * wInvSq a b) 2 : ℝ) / (W_scale * W_scale) * ((wSimp x2a x2b : ℝ) / W_scale) := by
