# KFZ Full: the whole chirp procedure body

`body j d18 = setupP; T1; …; T7; wP setC (PP j d18); popsL regL`.

**`body_runs`**: from `encK s f` (stack `0` = `gflat xs ++ l`, the chirp descriptor on `cS`, all
other managed stacks empty) the body ends in `encK s (update f 0 (gflat ys ++ l))` with
`ys = Q(Q(H θ̃⁻) ã)`, given the run of the Prop 18 call on its state.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue

theorem EmptyEx.app {f : Fin HS → List ℤ} (hf : EmptyEx f) {j : Fin HS} (h0 : j ≠ 0)
    (h1 : j ≠ cS) : f j = [] := hf j h0 h1

theorem pops_end_sol_aux (s : IState HS) (f : Fin HS → List ℤ) (hf : EmptyEx f) {p h d σ K B : ℕ}
    (hB : RB p h d σ K B) (z : List ℤ) :
    Sp (popsL regL) (encK s (St f p h d σ K [] z [] [] [] [] []))
      (encK s (Function.update f 0 z)) (5 * (2 * B + 2) + 1) := by
  have hb := hB.big; have hK := hB.K; have hσ := hB.σd
  unfold dlV at hb
  have k := popsL_sp s B (vsR p h d σ K) (Function.update f 0 z) (fun q hq => by
    simp only [vsR, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl | rfl | rfl | rfl
    · exact ⟨by dsimp only; decide, zszS (by omega)⟩
    · exact ⟨by dsimp only; decide, zszS (by omega)⟩
    · exact ⟨by dsimp only; decide, zszS (by omega)⟩
    · exact ⟨by dsimp only; decide, zszS (by omega)⟩
    · exact ⟨by dsimp only; decide, zszS (by omega)⟩)
  have hn : ((vsR p h d σ K).map Prod.fst).Nodup := by unfold vsR; ((simp only [List.map_cons, List.map_nil]; decide))
  have e : pushF (Function.update f 0 z) (vsR p h d σ K) = St f p h d σ K [] z [] [] [] [] [] := by
    have u : ∀ j, j ∉ (vsR p h d σ K).map Prod.fst →
        pushF (Function.update f 0 z) (vsR p h d σ K) j = Function.update f 0 z j :=
      fun j hj => pushF_apply_ne _ _ j hj
    have ue : ∀ j, j ≠ 0 → j ≠ cS → j ∉ (vsR p h d σ K).map Prod.fst →
        pushF (Function.update f 0 z) (vsR p h d σ K) j = [] := fun j h0 h1 hj => by
      rw [u j hj, Function.update_of_ne h0, hf.app h0 h1]
    have ur : ∀ (j : Fin HS) (v : ℤ), j ≠ 0 → j ≠ cS → (j, v) ∈ vsR p h d σ K →
        pushF (Function.update f 0 z) (vsR p h d σ K) j = [v] := fun j v h0 h1 hm => by
      rw [pf_top hn hm, Function.update_of_ne h0, hf.app h0 h1]
    symm
    refine St_eq f _ p h d σ K [] z [] [] [] [] [] ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_
    · rw [u 0 (by unfold vsR; ((simp only [List.map_cons, List.map_nil]; decide))), Function.update_self]
    · exact ue pW (by decide) (by decide) (by unfold vsR; ((simp only [List.map_cons, List.map_nil]; decide)))
    · exact ue tD (by decide) (by decide) (by unfold vsR; ((simp only [List.map_cons, List.map_nil]; decide)))
    · exact ue qB (by decide) (by decide) (by unfold vsR; ((simp only [List.map_cons, List.map_nil]; decide)))
    · exact ue qA (by decide) (by decide) (by unfold vsR; ((simp only [List.map_cons, List.map_nil]; decide)))
    · exact ue qT (by decide) (by decide) (by unfold vsR; ((simp only [List.map_cons, List.map_nil]; decide)))
    · exact ue qI (by decide) (by decide) (by unfold vsR; ((simp only [List.map_cons, List.map_nil]; decide)))
    · exact ur rgP _ (by decide) (by decide) (by simp [vsR])
    · exact ur rgH _ (by decide) (by decide) (by simp [vsR])
    · exact ur rgD _ (by decide) (by decide) (by simp [vsR])
    · exact ur rgS _ (by decide) (by decide) (by simp [vsR])
    · exact ur rgK _ (by decide) (by decide) (by simp [vsR])
    · intro j h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11
      rw [u j (by simp [vsR]; exact ⟨h7, h8, h9, h10, h11⟩), Function.update_of_ne h0]
  have e2 : (vsR p h d σ K).map Prod.fst = regL := rfl
  rw [e2, e] at k
  exact k

/-! ## The product-phase state -/

end NLogN.KFZ

end

theorem solution : type_of% @NLogN.KFZ.pops_end_sol_aux := @NLogN.KFZ.pops_end_sol_aux
