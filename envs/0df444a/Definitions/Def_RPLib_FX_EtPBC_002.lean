/-- The prime of `f x` is the contraction of the prime of `x`. -/
theorem toSpecΓ_map_asIdeal {X Z : Scheme.{u}} (f : X ⟶ Z) (x : X) :
    Ideal.comap f.appTop.hom (PrimeSpectrum.asIdeal (X.toSpecΓ x)) = PrimeSpectrum.asIdeal (Z.toSpecΓ (f x)) := by
  have h := congrArg (fun φ => φ.base x) (Scheme.toSpecΓ_naturality f)
  exact (congrArg PrimeSpectrum.asIdeal h).symm

/-- On `Spec R` the prime of `y` under `toSpecΓ` is `y` (through `ΓSpecIso`). -/
theorem toSpecΓ_Spec_asIdeal (R : CommRingCat.{u}) (y : Spec R) :
    Ideal.comap (Scheme.ΓSpecIso R).inv.hom (PrimeSpectrum.asIdeal ((Spec R).toSpecΓ y)) =
      PrimeSpectrum.asIdeal y := by
  have h0 : PrimeSpectrum.asIdeal ((Spec R).toSpecΓ y) = Ideal.comap (Scheme.ΓSpecIso R).hom.hom
      (PrimeSpectrum.asIdeal y) :=
    (congrArg (fun φ => PrimeSpectrum.asIdeal (φ.base y)) (SpecMap_ΓSpecIso_hom R)).symm
  rw [h0]
  ext r
  have h := congrArg (fun φ => φ.hom r) (Scheme.ΓSpecIso R).inv_hom_id
  show (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom r) ∈ PrimeSpectrum.asIdeal y ↔ _
  rw [show (Scheme.ΓSpecIso R).hom.hom ((Scheme.ΓSpecIso R).inv.hom r) = r from h]

theorem mem_basicOpen_iff {X : Scheme.{u}} (s : Γ(X, ⊤)) (x : X) :
    x ∈ (X.basicOpen s : Set X) ↔ s ∉ PrimeSpectrum.asIdeal (X.toSpecΓ x) := by
  rw [← Scheme.toSpecΓ_preimage_basicOpen]
  exact Iff.rfl

