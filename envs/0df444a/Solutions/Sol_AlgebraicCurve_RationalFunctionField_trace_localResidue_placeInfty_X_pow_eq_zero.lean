def P1PlaceInftySimplePoleResidueEulerValueX : Prop :=
  ∀ (himem : p1PrincipalPartAtom K (X : K[X]) 1 1 * (p1PlaceInfty K).differentialCoeff (dX K)
        ∈ (p1PlaceInfty K).simplePoleSubmodule),
