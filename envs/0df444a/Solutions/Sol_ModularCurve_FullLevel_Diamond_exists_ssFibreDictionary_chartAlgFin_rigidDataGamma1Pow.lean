theorem inv_apply_00 (A : SL(2, ℤ)) : (A⁻¹) 0 0 = A 1 1 := by
  rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]; rfl

theorem relabel_one {A : Type u} [CommRing A] {T : Type u} [CommRing T] [Algebra A T]
    (𝒢 : GroupLaws A) (x : RawDrinfeldPair T) (hΔ : IsUnit x.curve.Δ) :
    ModularCurve.LevelRelabelling.RawDrinfeldPair.relabel 𝒢 (1 : Matrix (Fin 2) (Fin 2) ℤ) x hΔ = x := by
  obtain ⟨c, P, Q⟩ := x
  have h01 : (1 : Matrix (Fin 2) (Fin 2) ℤ) 0 1 = 0 := by decide
  have h10 : (1 : Matrix (Fin 2) (Fin 2) ℤ) 1 0 = 0 := by decide
  have h00 : (1 : Matrix (Fin 2) (Fin 2) ℤ) 0 0 = 1 := by decide
  have h11 : (1 : Matrix (Fin 2) (Fin 2) ℤ) 1 1 = 1 := by decide
  simp only [ModularCurve.LevelRelabelling.RawDrinfeldPair.relabel, h01, h10, h00, h11]
  have e1 : ∀ R : Section c, ModularCurve.LevelRelabelling.zsmulSection (𝒢 T c hΔ) 1 R = R := by
    intro R
    show (𝒢 T c hΔ).nsmul _ 1 R = R
    rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_zero, (𝒢 T c hΔ).one_mul]
  have e0 : ∀ R : Section c, ModularCurve.LevelRelabelling.zsmulSection (𝒢 T c hΔ) 0 R = (𝒢 T c hΔ).one _ := by
    intro R
    show (𝒢 T c hΔ).nsmul _ 0 R = (𝒢 T c hΔ).one _
    rw [RelativeGroupLaw.nsmul_zero]
  simp only [ModularCurve.LevelRelabelling.zlinComb, e1, e0, (𝒢 T c hΔ).mul_one, (𝒢 T c hΔ).one_mul]

end Dict25

