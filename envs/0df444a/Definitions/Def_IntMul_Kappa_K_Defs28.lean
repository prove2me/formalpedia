/-!
# KFUU §2f: the layouts of phase 2 (swaps of the main fields)

After phase 1 the layout is `lay1 bg n 0 = mains ++ bitsR ++ [2n]`, of field sizes
`2^u (n times) ++ ctB ++ [cz]`. Swap `k` exchanges the main fields `k` and `n-1-k`; on the data it
is the 5-field swap `[U^k, U, U^{n-2-2k}, U, U^k·vol ctB·cz]`, `U = 2^u`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU

open IntMul KIL KFB KFC KFT KFU AModel AModelL12

/-- The bit fields after phase 1. -/
def ctB (u cz : ℕ) (bs : List Bool) : Shape :=
  (bitsR (bgB bs) (List.range bs.length)).map (asz (mzB u bs.length cz))
end NLogN.KFUU
end

