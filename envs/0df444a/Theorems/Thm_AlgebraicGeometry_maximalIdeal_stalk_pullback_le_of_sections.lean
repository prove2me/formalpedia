-- title:
--   Maximal ideal at a rational point of a fibre product over a field
-- statement:
--   Let $k$ be a field and let $Y$ and $Z$ be schemes, equipped with morphisms $p_Y : Y \to \operatorname{Spec} k$ and $p_Z : Z \to \operatorname{Spec} k$. Suppose given sections $y : \operatorname{Spec} k \to Y$ of $p_Y$, so that $y$ followed by $p_Y$ is the identity of $\operatorname{Spec} k$, and $z : \operatorname{Spec} k \to Z$ of $p_Z$, so that $z$ followed by $p_Z$ is the identity. Let $w$ be a point of the underlying space of the fibre product $Y \times_{\operatorname{Spec} k} Z$ (taken as the categorical pullback of $p_Y$ and $p_Z$ in schemes), and assume that $w$ is the image of the closed point of $\operatorname{Spec} k$ under the morphism $\operatorname{Spec} k \to Y \times_{\operatorname{Spec} k} Z$ induced by the pair $(y,z)$, which agree after composing with $p_Y$, resp. $p_Z$. The conclusion is that the maximal ideal of the local ring of $Y \times_{\operatorname{Spec} k} Z$ at $w$ is contained in the sum of the ideals generated by the images of the maximal ideals of the local rings at the images of $w$ under the two projections, via the respective stalk maps of the first and second projection at $w$. (Since both ideals in the sum consist of non-units, the inclusion is in fact an equality.) The point $w$ is kept as a free variable constrained by the hypothesis, so that users need not transport along an equality of points.
--
--   This is the standard local description of a fibre product of $k$-schemes at a pair of $k$-rational points: the cotangent space at $(y,z)$ is spanned by the pullbacks of the cotangent spaces of the two factors. It is used in the construction of the relative group law on the Jacobian, where it feeds the production of an affine neighbourhood on which a stalk map is formally unramified.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicGeometry_maximalIdeal_stalk_pullback_le_of_sections.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry IsLocalRing

universe u

theorem AlgebraicGeometry.maximalIdeal_stalk_pullback_le_of_sections
    {k : Type u} [Field k] {Y Z : Scheme.{u}} (pY : Y ⟶ Spec (.of k)) (pZ : Z ⟶ Spec (.of k))
    (y : Spec (.of k) ⟶ Y) (hy : y ≫ pY = 𝟙 _) (z : Spec (.of k) ⟶ Z) (hz : z ≫ pZ = 𝟙 _)
    (w : ↑(pullback pY pZ)) (hw : w = (pullback.lift y z (hy.trans hz.symm)) (closedPoint k)) :
    maximalIdeal ((pullback pY pZ).presheaf.stalk w) ≤
      (maximalIdeal _).map ((pullback.fst pY pZ).stalkMap w).hom ⊔
        (maximalIdeal _).map ((pullback.snd pY pZ).stalkMap w).hom := by sorry
