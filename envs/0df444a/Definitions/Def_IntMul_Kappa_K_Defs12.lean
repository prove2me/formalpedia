-- Source module: Solutions.KIL4Ctrl
/-!
# KIL4: run-time controls `p·q⁻¹ mod N`

For a fixed fraction `p / q` (`p ∈ ℤ`, `q ≥ 1`), `ctrlE p q` is an expression reading only the
modulus `N` (stack `22`) whose value is the representative in `[0, N)` of `p·q⁻¹` in `ZMod N`
(when `q` is prime to `N`): with `r = N mod q` and the compile-time table `t_r` (`q ∣ r·t_r + 1`),
`x = (N·t_r + 1) / q` is an inverse of `q` mod `N`, and the value is
`(p·x + |p|·x·N) mod N`.  Cost `O(q·(Bb + 2)²)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

/-- The least `t < q` with `q ∣ r·t + 1` (`0` if none). -/
def invT (q r : ℕ) : ℕ := ((List.range q).find? (fun t => (r * t + 1) % q = 0)).getD 0

/-- Selection by the value of `e` among `vs` (indices from `k`). -/
def selL (e : Ex HS) : ℕ → List ℤ → Ex HS
  | _, [] => .lit 0
  | k, v :: vs => .sel (.add e (.lit (-((k : ℤ) + 1)))) (.lit v) (selL e (k + 1) vs)

/-- `p·q⁻¹` in `ZMod N`. -/
def fracZ (N : ℕ) (p : ℤ) (q : ℕ) : ZMod N := (p : ZMod N) * (q : ZMod N)⁻¹

def tTab (q : ℕ) : List ℤ := (List.range q).map fun r => (invT q r : ℤ)

/-- An inverse of `q` modulo `N` (stack `22`). -/
def invE (q : ℕ) : Ex HS :=
  .ndiv (.add (.mul (.reg sQQ) (selL (.nmod (.reg sQQ) (.lit q)) 0 (tTab q))) (.lit 1)) (.lit q)

/-- The control `p·q⁻¹ mod N` (representative in `[0, N)`). -/
def ctrlE (p : ℤ) (q : ℕ) : Ex HS :=
  .nmod (.add (.mul (.lit p) (invE q)) (.mul (.mul (.lit (p.natAbs : ℤ)) (invE q)) (.reg sQQ)))
    (.reg sQQ)

/-- The size bound needed by `ctrlE p q` at modulus `N`. -/
def ctrlBnd (p : ℤ) (q N : ℕ) : ℕ := 2 * (p.natAbs + 1) * (q + 1) * (N + 1) ^ 2

end NLogN.KIL

end

