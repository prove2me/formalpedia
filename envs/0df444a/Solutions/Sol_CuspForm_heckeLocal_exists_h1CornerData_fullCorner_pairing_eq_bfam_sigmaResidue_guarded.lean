  have hu𝔪 : u ∉ Sp.𝔪 i := fun h => hψu (hψ𝔪 u h)
  obtain ⟨w, hwu, -⟩ := isUnit_iff_exists.mp (hunit_of_notMem u hu𝔪)
  have hcsu : ∀ m : ↥(cornerSubmodule (M := H1 (N * r) H₀ 𝒪) (Sp.e i)),
