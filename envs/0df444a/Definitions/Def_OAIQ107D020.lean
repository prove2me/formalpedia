namespace OAI

namespace CycleClique
open scoped SimpleGraph

theorem compactNodupLabels_spec (L : List ℕ) : compactNodupLabels L = true ↔ L.Nodup := by
  induction L with
  | nil => simp [compactNodupLabels]
  | cons a L ih => simp [compactNodupLabels, ih]

end CycleClique

end OAI
