theorem factorsThrough_one_iff (E : FakeEllipticCurve Λ N S) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S))
    (P : SchemeHomOver t E.f) :
    FactorsThrough (E.L.one (𝟙 _)).1 P ↔ P = E.L.one t := by
  have key : (E.L.one t).1 = t ≫ (E.L.one (𝟙 _)).1 := by
    have := E.L.one_natural (𝟙 (Spec (CommRingCat.of S))) t t (Category.comp_id t)
    rw [← this]; rfl
  constructor
  · rintro ⟨P₀, hP₀⟩
    have hP₀t : P₀ = t := by
      have := congrArg (· ≫ E.f) hP₀
      simp only [Category.assoc] at this
      rw [(E.L.one (𝟙 _)).2, P.2, Category.comp_id] at this
      exact this
    apply Subtype.ext
    rw [key, ← hP₀, hP₀t]
  · rintro rfl
    exact ⟨t, key.symm⟩

theorem pushPt_one (E : FakeEllipticCurve Λ N S) (x : ↥Λ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) :
    pushPt (E.act x) (E.act_over x) (E.L.one t) = E.L.one t := by
  letI := E.L.pointGroup t
  have h := E.act_hom x t (E.L.one t) (E.L.one t)
  rw [E.L.one_mul] at h

  have : pushPt (E.act x) (E.act_over x) (E.L.one t) * 1 =
      pushPt (E.act x) (E.act_over x) (E.L.one t) * pushPt (E.act x) (E.act_over x) (E.L.one t) := by
    rw [mul_one]; exact h
  exact (mul_left_cancel this).symm

noncomputable def forgetLevel (E : FakeEllipticCurve Λ N S) : FakeEllipticCurve Λ 1 S where
  A := E.A
  f := E.f
  L := E.L
  comm := E.comm
  bundle := E.bundle
  dim_fibre := E.dim_fibre
  act := E.act
  act_over := E.act_over
  act_hom := E.act_hom
  act_one := E.act_one
  act_mul := E.act_mul
  act_add := E.act_add
  act_trace := E.act_trace
  C := Spec (CommRingCat.of S)
  lev := (E.L.one (𝟙 _)).1
  lev_closed := by
    haveI : IsProper E.f := E.bundle.proper
    haveI : IsClosedImmersion ((E.L.one (𝟙 _)).1 ≫ E.f) := by rw [(E.L.one (𝟙 _)).2]; infer_instance
    exact IsClosedImmersion.of_comp _ E.f
  lev_sub := by
    intro T t P Q hP hQ
    rw [factorsThrough_one_iff] at hP hQ ⊢
    rw [factorsThrough_one_iff]
    subst hP; subst hQ
    letI := E.L.pointGroup t
    exact ⟨E.L.one_mul t _, show (1 : SchemeHomOver t E.f)⁻¹ = 1 from inv_one⟩
  lev_one := by
    intro T t
    exact (factorsThrough_one_iff E t _).mpr rfl
  lev_torsion := by
    intro T t P hP
    rw [factorsThrough_one_iff] at hP
    subst hP
    show E.L.mul t (E.L.one t) (E.L.one t) = E.L.one t
    exact E.L.one_mul t _
  lev_stable := by
    intro x T t P hP
    rw [factorsThrough_one_iff] at hP ⊢
    subst hP
    exact pushPt_one E x t
  lev_finite := by rw [(E.L.one (𝟙 _)).2]; infer_instance
  lev_flat := by rw [(E.L.one (𝟙 _)).2]; infer_instance
  lev_finitePresentation := by rw [(E.L.one (𝟙 _)).2]; infer_instance
  lev_rank := by
    intro s
    rw [(E.L.one (𝟙 _)).2, Scheme.Hom.finrank_eq_one_of_isIso]
    simp
  lev_fibre := by
    intro k _ _ sk _
    haveI : Unique {P : SchemeHomOver (geomPoint k sk) E.f // FactorsThrough (E.L.one (𝟙 _)).1 P} :=
      { default := ⟨E.L.one _, (factorsThrough_one_iff E _ _).mpr rfl⟩
        uniq := fun P => Subtype.ext ((factorsThrough_one_iff E _ _).mp P.2) }
    haveI : Subsingleton (ZMod 1) := ZMod.subsingleton_iff.mpr rfl
    haveI : Unique (ZMod 1 × ZMod 1) := uniqueOfSubsingleton (0, 0)
    let e : ZMod 1 × ZMod 1 ≃ {P : SchemeHomOver (geomPoint k sk) E.f // FactorsThrough (E.L.one (𝟙 _)).1 P} :=
      Equiv.ofUnique _ _
    refine ⟨e, fun x y => ?_⟩
    have h1 : ∀ z, ((e z : {P : SchemeHomOver (geomPoint k sk) E.f // FactorsThrough (E.L.one (𝟙 _)).1 P}) :
        SchemeHomOver (geomPoint k sk) E.f) = E.L.one _ :=
      fun z => (factorsThrough_one_iff E _ _).mp (e z).2
    rw [h1, h1, h1, E.L.one_mul]

