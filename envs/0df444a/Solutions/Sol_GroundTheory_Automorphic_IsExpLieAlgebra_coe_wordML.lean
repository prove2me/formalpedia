theorem _root_.solution {v : E} (hv : h.IsSmoothVector π v) :
    ∀ (k : ℕ) (Y : Fin k → 𝔤), ((h.wordML π hv k Y : h.smoothVectors π) : E) = h.wordOp π Y v
  | 0, _ => rfl
  | k + 1, Y => by
