  obtain ⟨hfst, ⟨E⟩⟩ := point_of_prime (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) ι k g hg q

  have hϖq : algebraMap A ↥S ϖ ∈ ((Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := ↥S) (B := k)))).base q).asIdeal := by
    show Algebra.TensorProduct.includeLeftRingHom (R := A) (A := ↥S) (B := k) (algebraMap A ↥S ϖ) ∈ 𝔐
    rw [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.algebraMap_eq_smul_one ϖ, TensorProduct.smul_tmul,
