theorem disj_of_locDisj [IsFinite (E'.L.schemeKerStr N)] [Etale (E'.L.schemeKerStr N)] (U' : (E'.L.schemeKer N).Opens)
    (h : ∀ t : ↥(Spec (CommRingCat.of T)), t ∈ locDisj E'.L N (U' : Set _) (VC (N := N) E' hM : Set _))
    {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t E'.f)
    (hPU : CerednikDrinfeld.QM.FactorsThrough (U'.ι ≫ KerOps.ι E'.L N) P)
