section
-- Source module: Solutions.R6P18Lay
/-!
# Round six, Proposition 18: the layout and round costs with one chunk per axis

At the round-six parameters `K = ℓ - 1` (Idea C), so `q = ⌊(ℓ-1)/K⌋ = 1` and
`b = (ℓ-1) mod K = 0`. Then

* phase 3 of the layout has `D` steps whose exchange is trivial (`xT t = t`, cost `1`):
  **`cLayIn_q1`**, **`cLayOut_q1`**: the layout programs cost `≤ 10^6 (D+1)(W+1) 2^{n+ℓ}`
  (no exchange is ever called, so the swap's exponent does not enter the cost);
* there are no prefix leaves: **`cFwd_q1`**, **`cOpp_q1`**: the Lemma 16 procedures cost
  `≤ 10^12 (W+1) X (ℓ + 2(D+1)) + ℓ · cCh`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV.R6P

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12 GlueLayout GlueP14 GlueError

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

theorem sum_brR18_b0 (hb0 : bb ℓ K = 0) (cCh W : ℕ) :
    ∑ h ∈ Finset.range ℓ, brR18 D ℓ K long h cCh W ≤
      2 * 10 ^ 11 * (D + 1) * (W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ) + ℓ * cCh := by
  unfold brR18
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_const, Finset.card_range,
    smul_eq_mul]
  have h2 := sum_ite_eq ℓ (ℓ - 1) (2 * 10 ^ 11 * (D + 1) * (W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ))
  simp only [hb0, Nat.not_lt_zero, if_false, Finset.sum_const_zero]
  omega

/-- **The opposite procedure with one chunk per axis.** -/
theorem cOpp_q1_sol_aux (hK : 0 < K) (hℓ : 1 ≤ ℓ) (hb0 : bb ℓ K = 0) {W B cCh U : ℕ} (hDW : D ≤ W)
    (hS : 10 ^ 12 * (B + 2) ^ 3 ≤ 2 ^ ℓ) (hBW : B + 2 ≤ 6 * (W + 1)) (hDl : D * ℓ ≤ B)
    (hU : zsz (U : ℤ) ≤ B) :
    cOpp D ℓ K long W B cCh U ≤
      10 ^ 12 * (W + 1) * (2 ^ nB D ℓ K long * 2 ^ ℓ) * (ℓ + 2 * (D + 1)) + ℓ * cCh := by
  set X := 2 ^ nB D ℓ K long * 2 ^ ℓ with hX
  have hX1 : 2 ^ ℓ ≤ X := Nat.le_mul_of_pos_left _ (Nat.two_pow_pos _)
  have hB2 : (B + 2) ^ 2 ≤ (B + 2) ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have hD1 : 1 ≤ D := Nat.one_le_iff_ne_zero.2 (NeZero.ne D)
  have hlB : ℓ ≤ B := le_trans (Nat.le_mul_of_pos_left _ hD1) hDl
  have hs : ∀ k ∈ Finset.range ℓ, cRndO D ℓ K long k W B cCh U + cStepH 1 B + 64 ≤
      12 * 10 ^ 9 * (W + 1) * X + brR18 D ℓ K long k cCh W := by
    intro k hk
    simp only [Finset.mem_range] at hk
    have := rndO_le D ℓ K long hK hℓ (h := k) hk hDW hS hBW hDl hU (cCh := cCh)
    rw [← hX] at this
    have hc : cStepH 1 B + 64 ≤ X := by unfold cStepH; simp [Ex.size]; nlinarith
    have hWX : X ≤ (W + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
    have e : 12 * 10 ^ 9 * (W + 1) * X = 12 * 10 ^ 9 * ((W + 1) * X) := by ring
    have e2 : 11 * 10 ^ 9 * (W + 1) * X = 11 * 10 ^ 9 * ((W + 1) * X) := by ring
    rw [e]; rw [e2] at this; omega
  have hsum := Finset.sum_le_sum hs
  have hR : ∑ i ∈ Finset.range ℓ, (12 * 10 ^ 9 * (W + 1) * X + brR18 D ℓ K long i cCh W) =
      ℓ * (12 * 10 ^ 9 * (W + 1) * X) + ∑ h ∈ Finset.range ℓ, brR18 D ℓ K long h cCh W := by
    rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul]
  rw [hR] at hsum
  have hb := sum_brR18_b0 D ℓ K long hb0 cCh W
  rw [← hX] at hb
  have hr := cRpt_le ℓ
  have hd := dupCost_le (zsz (ℓ : ℤ))
  have hz : zsz (ℓ : ℤ) ≤ ℓ := zsz_natCast_le_self' ℓ
  have hsm : ((Ex.lit 0 : Ex HS).size + 1) * 10 ^ 7 * (B + 2) ^ 2 + (60 + cRpt ℓ +
      (dupCost (zsz (ℓ : ℤ)) + 17)) + (2 * B + 2) ≤ X := by
    simp only [Ex.size]; nlinarith
  have hWX : X ≤ (W + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
  unfold cOpp
  have e1 : 10 ^ 12 * (W + 1) * X * (ℓ + 2 * (D + 1)) =
      10 ^ 12 * ((W + 1) * X * ℓ) + 2 * 10 ^ 12 * ((D + 1) * ((W + 1) * X)) := by ring
  have e2 : ℓ * (12 * 10 ^ 9 * (W + 1) * X) = 12 * 10 ^ 9 * ((W + 1) * X * ℓ) := by ring
  have e3 : 2 * 10 ^ 11 * (D + 1) * (W + 1) * X = 2 * 10 ^ 11 * ((D + 1) * ((W + 1) * X)) := by
    ring
  have hl1 : (W + 1) * X ≤ (W + 1) * X * ℓ := Nat.le_mul_of_pos_right _ (by omega)
  rw [e1]; rw [e2] at hsum; rw [e3] at hb
  omega

end Paper

end NLogN.KFV.R6P

end

theorem solution : type_of% @NLogN.KFV.R6P.cOpp_q1_sol_aux := @NLogN.KFV.R6P.cOpp_q1_sol_aux
