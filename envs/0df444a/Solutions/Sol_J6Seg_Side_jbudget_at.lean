theorem mulSup_le_fmB (m : ℕ) : mulSup m ≤ KFM.fmB m := by
  unfold mulSup
  apply Finset.sup_le
  intro a ha
  rw [mem_range] at ha
  refine le_trans ?_ (KFM.fmB_mono (show a ≤ m by omega))
  have := KFM.mulCostH_le a
  unfold KFM.fmB; exact this

