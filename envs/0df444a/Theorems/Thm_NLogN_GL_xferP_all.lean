theorem NLogN.GL.xferP_all (M : MulSpec) (i j : Fin HS) (n : Ex HS) (s : IState HS) (l : List ℤ)
    (Ri : List Item) (B : ℕ) (hij : i ≠ j) (hiT : i ≠ gZT) (hjT : j ≠ gZT) (hiV : i ≠ gCV)
    (hjV : j ≠ gCV) (hi55 : i.val < 55) (hj55 : j.val < 55)
    (hi : s.G i = ints l ++ Ri) (hn : n.eval s = l.length) (hnc : n.Clean) (hno : n.ok s)
    (hl : n.Lin) (hnB : n.Bnd s B) (hB : ∀ x ∈ l, zsz x ≤ B)
    (hnr : ∀ t : IState HS, (∀ x, x ≠ i → x ≠ gZT → t.G x = s.G x) →
      n.eval t = n.eval s ∧ n.ok t ∧ n.Bnd t B) :
    (xferP i j n).run s = (s.upd i Ri).upd j (ints l ++ s.G j) ∧
    (xferP i j n).ok M s ∧
    (xferP i j n).cost M s ≤ 2 * ((n.size + 1) * 2000 * (B + 2) +
      l.length * (14000 * (B + 2) + 30) + 32) := by sorry
