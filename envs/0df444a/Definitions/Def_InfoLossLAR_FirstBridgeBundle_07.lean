set_option maxHeartbeats 2000000

namespace InfoLossLAR.WorstCase
open AFT
open scoped BigOperators Classical

/-- Translation equivariance gives an explicit unique zero-fiber/label decomposition. -/
def zeroFiberCoordinates {V K : Type*} [AddCommGroup V] [AddCommGroup K]
    (label : V → K) (direction : K →+ V)
    (htranslate : ∀ x k, label (x + direction k) = label x + k) :
    ({x : V // label x = 0} × K) ≃ V where
  toFun pair := pair.1.val + direction pair.2
  invFun x := (⟨x + direction (-label x), by rw [htranslate]; simp⟩, label x)
  left_inv pair := by
    rcases pair with ⟨⟨x,hx⟩,k⟩
    apply Prod.ext
    · apply Subtype.ext
      simp only [htranslate,hx,zero_add,map_neg]
      abel
    · simpa only [htranslate,hx,zero_add]
  right_inv x := by
    simp only [map_neg]
    abel









/-- The integer preimage of a unit carry at the first endpoint. Its existence
comes from the proved integral image lattice of the actual rounding map. -/
noncomputable def roundingDirectionInteger (n q : ℕ) [NeZero q]
    (column : Fin (n+1) → ℤ) (hcolumn : _root_.AFT.totalCharge column = (q : ℤ)) :
    (Fin n → ℤ) × ℤ :=
  (_root_.AFT.roundingCoordinates n (q : ℤ) (by exact_mod_cast NeZero.ne q) column hcolumn).symm
    ⟨(q : ℤ) • (Pi.single (0 : Fin (n+1)) (1 : ℤ)), by
      change (q : ℤ) ∣ _root_.AFT.totalCharge ((q : ℤ) • (Pi.single (0 : Fin (n+1)) (1 : ℤ)))
      rw [_root_.AFT.totalCharge_smul]
      exact dvd_mul_right _ _⟩






/-- Reduction of the integer carry direction is an additive modular direction. -/
noncomputable def roundingDirection (n q : ℕ) [NeZero q]
    (column : Fin (n+1) → ℤ) (hcolumn : _root_.AFT.totalCharge column = (q : ℤ)) :
    ZMod q →+ ((Fin n → ZMod q) × ZMod q) where
  toFun amount := amount • _root_.AFT.reduceCoordinates n q (_root_.InfoLossLAR.WorstCase.roundingDirectionInteger n q column hcolumn)
  map_zero' := zero_smul _ _
  map_add' a b := add_smul a b _






/-- The field direction in the platform's edge-then-last coordinate order. -/
noncomputable def fixedRoundingDirection (q n : ℕ) [NeZero q] (hq : q ≤ n+1) :
    ZMod q →+ (Fin (n+1) → ZMod q) where
  toFun amount := Fin.lastCases
    (_root_.InfoLossLAR.WorstCase.roundingDirection n q (_root_.AFT.injectionColumn n q) (_root_.AFT.totalCharge_injectionColumn n q hq) amount).2
    (_root_.InfoLossLAR.WorstCase.roundingDirection n q (_root_.AFT.injectionColumn n q) (_root_.AFT.totalCharge_injectionColumn n q hq) amount).1
  map_zero' := by
    funext i
    refine Fin.lastCases ?_ (fun j => ?_) i <;> simp
  map_add' a b := by
    funext i
    refine Fin.lastCases ?_ (fun j => ?_) i <;> simp





/-- The zero input has the zero platform label, providing a concrete
nonempty witness for the finite zero fiber. -/
theorem fT63_zero (q d : ℕ) : fT63 q d 0 = 0 := by
  have hl : InfoLossLAR.WorstCase.lift (0 : Fin d → ZMod q) = 0 := by
    funext i
    simp [InfoLossLAR.WorstCase.lift]
  unfold fT63 AR
  rw [hl,Matrix.mulVec_zero]
  simp [carry]

/-- A normalized finite distribution with exactly the platform zero-fiber density. -/
noncomputable def fixedZeroFiberLaw (q d : ℕ) [NeZero q] :
    _root_.AFT.FiniteDist (Fin d → ZMod q) := by
  letI : Nonempty {x : Fin d → ZMod q // fT63 q d x = 0} := ⟨⟨0,_root_.InfoLossLAR.WorstCase.fT63_zero q d⟩⟩
  exact (_root_.AFT.FiniteDist.uniform {x : Fin d → ZMod q // fT63 q d x = 0}).map Subtype.val





end InfoLossLAR.WorstCase

end

