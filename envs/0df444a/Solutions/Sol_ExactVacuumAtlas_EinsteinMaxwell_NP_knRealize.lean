  rw [Finset.sum_comm]

theorem quad_eta_apply' (X Y : Matrix (Fin 4) (Fin 4) ℂ) (μ ν : Fin 4) :
    (X * etaNull * Yᵀ) μ ν = ∑ C, ∑ D, X μ C * etaNull C D * Y ν D := by
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_mul]
  rw [Finset.sum_comm]

