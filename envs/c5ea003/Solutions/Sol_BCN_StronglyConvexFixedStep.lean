section BCNBundleModule1
/-!
Strong-convexity geometry used by Bottou–Curtis–Nocedal, arXiv:1606.04838v3,
Section 4.2, PDF p. 26, Assumption 4.5 and equations (4.11)–(4.12).
The infimum formulation proves the same gap bound without assuming a minimizer.
Mathlib's `strongConvexOn_iff_convex` and convex derivative slope inequality supply
the first-order bridge; Mathlib's strong-convexity file does not yet contain it.
-/

noncomputable section

open Set
open scoped InnerProductSpace

namespace BCN.Objective

variable {d : ℕ} (P : Objective d) {c : ℝ}

/-- Equation (4.11), derived from Mathlib's Jensen-form strong convexity. -/
theorem strongConvex_lower (hsc : StrongConvexOn univ c P.F) (x y : Space d) :
    P.F x + ⟪gradient P.F x, y - x⟫_ℝ + c / 2 * ‖y - x‖ ^ 2 ≤ P.F y := by
  let q : Space d → ℝ := fun z ↦ P.F z - c / 2 * ‖z‖ ^ 2
  have hconv : ConvexOn ℝ univ (q ∘ (AffineMap.lineMap x y : ℝ →ᵃ[ℝ] Space d)) := by
    simpa [q] using (strongConvexOn_iff_convex.mp hsc).comp_affineMap
      (AffineMap.lineMap x y)
  have hline : HasDerivAt (P.F ∘ AffineMap.lineMap x y)
      ⟪gradient P.F x, y - x⟫_ℝ (0 : ℝ) := by
    simpa using (P.hasGradient (AffineMap.lineMap x y (0 : ℝ))).hasFDerivAt.comp_hasDerivAt 0
      (AffineMap.hasDerivAt_lineMap (a := x) (b := y) (x := (0 : ℝ)))
  have hnorm : HasDerivAt (fun t : ℝ ↦ ‖AffineMap.lineMap x y t‖ ^ 2)
      (2 * ⟪x, y - x⟫_ℝ) 0 := by
    simpa using (AffineMap.hasDerivAt_lineMap (a := x) (b := y) (x := (0 : ℝ))).norm_sq
  have hder : HasDerivAt (q ∘ AffineMap.lineMap x y)
      (⟪gradient P.F x, y - x⟫_ℝ - c / 2 * (2 * ⟪x, y - x⟫_ℝ)) (0 : ℝ) :=
    hline.sub (hnorm.const_mul (c / 2))
  have hs := hconv.le_slope_of_hasDerivAt (x := 0) (y := 1)
    (mem_univ _) (mem_univ _) zero_lt_one hder
  simp only [slope_def_field, Function.comp_apply, AffineMap.lineMap_apply_zero,
    AffineMap.lineMap_apply_one, sub_zero, div_one, q] at hs
  rw [norm_sub_sq_real, real_inner_comm x y]
  simp only [inner_sub_right, real_inner_self_eq_norm_sq] at hs ⊢
  nlinarith

/-- Completing the lower quadratic in (4.11), before taking its infimum. -/
theorem strongConvex_global_lower (hc : 0 < c) (hsc : StrongConvexOn univ c P.F)
    (x y : Space d) :
    P.F x - ‖gradient P.F x‖ ^ 2 / (2 * c) ≤ P.F y := by
  have hfirst := P.strongConvex_lower hsc x y
  have hinner := real_inner_le_norm (gradient P.F x) (-(y - x))
  rw [inner_neg_right, norm_neg] at hinner
  have hquad : 2 * c * (P.F x - P.F y) ≤ ‖gradient P.F x‖ ^ 2 := by
    nlinarith [sq_nonneg (c * ‖y - x‖ - ‖gradient P.F x‖)]
  have hdiv : P.F x - P.F y ≤ ‖gradient P.F x‖ ^ 2 / (2 * c) := by
    apply (le_div_iff₀ (by positivity : 0 < 2 * c)).mpr
    nlinarith [hquad]
  linarith

/-- Strong convexity makes the real infimum defining `optimalValue` meaningful. -/
theorem strongConvex_bddBelow (hc : 0 < c) (hsc : StrongConvexOn univ c P.F) :
    BddBelow (range P.F) := by
  refine ⟨P.F 0 - ‖gradient P.F 0‖ ^ 2 / (2 * c), ?_⟩
  rintro _ ⟨x, rfl⟩
  exact P.strongConvex_global_lower hc hsc 0 x

theorem optimalValue_le (hc : 0 < c) (hsc : StrongConvexOn univ c P.F) (x : Space d) :
    optimalValue P ≤ P.F x :=
  csInf_le (P.strongConvex_bddBelow hc hsc) (mem_range_self x)

/-- Equation (4.12), with the optimal value defined by its infimum. -/
theorem strongConvex_pl (hc : 0 < c) (hsc : StrongConvexOn univ c P.F) (x : Space d) :
    2 * c * (P.F x - optimalValue P) ≤ ‖gradient P.F x‖ ^ 2 := by
  have hinf : P.F x - ‖gradient P.F x‖ ^ 2 / (2 * c) ≤ optimalValue P := by
    apply le_csInf (range_nonempty P.F)
    rintro _ ⟨y, rfl⟩
    exact P.strongConvex_global_lower hc hsc x y
  have hdiv : P.F x - optimalValue P ≤ ‖gradient P.F x‖ ^ 2 / (2 * c) := by
    linarith
  have hmul := (le_div_iff₀ (by positivity : 0 < 2 * c)).mp hdiv
  nlinarith

/-- The comparison following (4.12), restricted to positive dimension. -/
theorem strongConvex_le_smooth (hd : 0 < d) (hsc : StrongConvexOn univ c P.F) :
    c ≤ P.L := by
  letI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  obtain ⟨y, hy⟩ := exists_ne (0 : Space d)
  have hn : 0 < ‖y - 0‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr (sub_ne_zero.mpr hy))
  have hfirst := P.strongConvex_lower hsc 0 y
  have hsmooth := P.descent 0 y
  nlinarith

end BCN.Objective
