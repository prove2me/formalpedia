/-! ### Reality of a null frame: `m ↔ m̄` -/

/-- `0 ↦ 0, 1 ↦ 1, 2 ↦ 3, 3 ↦ 2` (exchange of `m` and `m̄`). -/
def swap23 : Fin 4 → Fin 4 := ![0, 1, 3, 2]

theorem swap23_swap23 (A : Fin 4) : swap23 (swap23 A) = A := by
  fin_cases A <;> rfl

