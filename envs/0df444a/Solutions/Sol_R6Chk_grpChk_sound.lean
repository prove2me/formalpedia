/-! ## Soundness -/

section Sound

variable {n bad : ℕ}

/-- **Soundness of a group.** -/
theorem grpChk_sound_sol_aux (hbad : bad = BADf n) (hn : n ≤ 24) {G : ℕ} (h : grpChk n bad G = true) :
    finrank (ZMod 2) (spanP n (grpV n G).1 (grpV n G).2) = (grpV n G).2 ∧
      NondegF (spanP n (grpV n G).1 (grpV n G).2) ∧
      ∀ p ∈ grpEnts n G, PairOK n p.1 p.2 (grpV n G).1 (grpV n G).2 :=
  grpBody_sound hbad hn (tk_lt _ _) (tk_lt _ _) (tk_lt _ _) (tk_lt _ _) h

end Sound

end R6Chk

end

