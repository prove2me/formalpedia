-- Source module: Solutions.J6SegILPre6
/-!
# B-line IL, pre-tables (B5), part 6: the call loop

`cLoop O cl` = `U := 0; repeat N = v 24 times { cl; push X on O; U := U + 1 }` where the call `cl`
sets `X = v 11 := f U`. `cLoop_sp`: it pushes `f 0, …, f (N-1)` onto `O` (so `O` gains `rv f N`);
the registers end as `wS v f N` (only `11, 12` change).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

theorem VB_upd {v : Fin HS → ℤ} {A : ℕ} (h : VB v A) (j : Fin HS) {a : ℤ} (ha : |a| ≤ 2 ^ A) :
    VB (Function.update v j a) A := by
  intro i hi
  by_cases e : i = j
  · subst e; simpa using ha
  · rw [Function.update_of_ne e]; exact h i hi

theorem cu_nrg : Cu ∉ rg := by decide

theorem mgB {A : ℕ} (hA : 2 ≤ A) {e : Ex HS} (hp : Poly e = true) (hd : dg e ≤ 40) :
    mg (fun _ => 2 ^ A) e < 2 ^ BW A := mg_lt (fun _ => le_rfl) hA hp hd

theorem vb_regs {v : Fin HS → ℤ} {A : ℕ} (h : VB v A) {e : Ex HS} (he : InRg e) :
    ∀ j ∈ e.regs, |v j| ≤ (fun _ => 2 ^ A) j := fun j hj => h j (he j hj)

theorem inRg_reg {j : Fin HS} (h : j ∈ rg) : InRg (.reg j) := by
  intro i hi; simp [Ex.regs] at hi; subst hi; exact h

/-- **The call loop** (general register sequence): `W k` the registers before step `k`, `W' k`
after the call of step `k` (which sets `11 := f k`). -/
theorem cLoopR_sp_sol_aux {r : Fin HS} (hr : r ∈ rg) (hr12 : r ≠ 12) (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {O : Fin HS} (hO : O ∉ rg)
    (hO5 : O.val < 56) (hOC : O ≠ Cu) (hc : c Cu = []) {cl : RS} (hw : Cu ∉ cl.writes)
    {A N : ℕ} (hA : 2 ≤ A) (hv : VB v A) (h24 : v r = N) (hN : N ≤ 2 ^ A) (f : ℕ → ℤ)
    (W W' : ℕ → Fin HS → ℤ) (hW0 : W 0 = Function.update v 12 0)
    (hWs : ∀ k, W (k + 1) = Function.update (W' k) 12 (k + 1))
    (hW11 : ∀ k < N, W' k 11 = f k) (hW12 : ∀ k < N, W' k 12 = k)
    (hWV : ∀ k < N, VB (W' k) A) {Cc : ℕ}
    (hcl : ∀ k < N, ∀ cc : Fin HS → List ℤ,
      Sp cl (encK s (RF (W k) cc)) (encK s (RF (W' k) cc)) Cc) :
    Sp (cLoopR O cl r) (encK s (RF v c)) (encK s (RF (W N) (Function.update c O (rv f N ++ c O))))
      (cE (.lit 0) (BW A) + (2 * 2000 * (BW A + 2) + N * (Cc + cE (.reg 11) (BW A) +
        cE (.add (.reg 12) (.lit 1)) (BW A) + 8000 * (BW A + 2) + 30) + 32)) := by
  have s0 := spA s v c (i := 12) (by decide) (e := .lit 0) (by intro i hi; simp [Ex.regs] at hi)
    trivial (V := fun _ => 2 ^ A) (B := BW A) (by intro j hj; simp [Ex.regs] at hj)
    (hv 12 (by decide)) (mgB hA (by decide) (by decide))
    (Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega))
  simp only [Ex.eval] at s0
  rw [← hW0] at s0
  have hV0 : VB (W 0) A := by rw [hW0]; exact VB_upd hv 12 (by simp)
  have hl := pushLoop s c (C := Cu) (O := O) cu_nrg (Ne.symm hOC) (by decide) hc
    (b := cBody O cl) (by simp [cBody, RS.writes, hw, Ne.symm hOC, show ¬ (Cu = 12) by decide]) (n := .reg r)
    (inRg_reg hr) trivial W
    (ok_RF (inRg_reg hr) rfl) (N := N)
    (by rw [ev_reg hr, hW0, Function.update_of_ne hr12, h24])
    (V := fun _ => 2 ^ A) (B := BW A)
    (by intro j hj; simp [Ex.regs] at hj; rw [hj]; exact hV0 r hr)
    (mgB hA rfl (by simp [dg])) f
    (cb := Cc + cE (.reg 11) (BW A) + cE (.add (.reg 12) (.lit 1)) (BW A)) (by
      intro k hk
      set cc := Function.update (Function.update c O (rv f k ++ c O)) Cu [(N : ℤ) - k]
      have h1 := hcl k hk cc
      have hvk' := hWV k hk
      have h2 := spU s (W' k) cc hO hO5 (e := .reg 11)
        (by intro i hi; simp [Ex.regs] at hi; subst hi; decide)
        (ok_RF (by intro i hi; simp [Ex.regs] at hi; subst hi; decide) rfl)
        (V := fun _ => 2 ^ A) (B := BW A)
        (vb_regs hvk' (by intro i hi; simp [Ex.regs] at hi; subst hi; decide))
        (mgB hA (by decide) (by decide))
      rw [ev_reg (by decide), hW11 k hk] at h2
      set cc2 := Function.update cc O (f k :: cc O)
      have h3 := spA s (W' k) cc2 (i := 12) (by decide)
        (e := .add (.reg 12) (.lit 1)) (by intro i hi; simp [Ex.regs] at hi; subst hi; decide)
        (ok_RF (by intro i hi; simp [Ex.regs] at hi; subst hi; decide) rfl)
        (V := fun _ => 2 ^ A) (B := BW A)
        (vb_regs hvk' (by intro i hi; simp [Ex.regs] at hi; subst hi; decide)) (hvk' 12 (by decide))
        (mgB hA (by decide) (by decide)) (Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega))
      simp only [Ex.eval, top_RF (show (12 : Fin HS) ∈ rg by decide), hW12 k hk] at h3
      have e1 : Function.update (W' k) 12 ((k : ℤ) + 1) = W (k + 1) := by
        rw [hWs k]
      have e2 : cc2 = Function.update (Function.update c O (rv f (k + 1) ++ c O)) Cu
          [(N : ℤ) - k] := by
        simp only [cc2, cc, rv_succ]
        rw [Function.update_of_ne hOC, Function.update_self, Function.update_comm hOC,
          Function.update_idem]
        rw [Function.update_comm hOC]; rfl
      rw [e1] at h3
      have h4 := h3.congr (t' := encK s (RF (W (k + 1)) (Function.update (Function.update c O
        (rv f (k + 1) ++ c O)) Cu [(N : ℤ) - k]))) (by rw [e2])
      refine (h1.seq (h2.seq h4)).mono ?_
      omega)
  have T := s0.seq hl
  exact T.mono (by simp only [cE, Ex.size]; omega)

end J6Seg.PreT

end

theorem solution : type_of% @J6Seg.PreT.cLoopR_sp_sol_aux := @J6Seg.PreT.cLoopR_sp_sol_aux
