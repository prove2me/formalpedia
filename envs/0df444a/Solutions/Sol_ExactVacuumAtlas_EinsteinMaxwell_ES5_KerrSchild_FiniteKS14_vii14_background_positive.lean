theorem contDiffOn_ricciOf_of_smooth {g gi : Metric 5} {W : Set (Pt 5)} (hW : IsOpen W)
    (hg : ∀ i j, ContDiffOn ℝ ∞ (g i j) W) (hgi : ∀ i j, ContDiffOn ℝ ∞ (gi i j) W)
