    have a9 : w2 9 = 2 ^ Q := by rw [q2 9 (by decide) (by decide) (by decide), h9]
    have a10 : w2 10 = 2 ^ (Q + 1) := by rw [q2 10 (by decide) (by decide) (by decide), h10]
    simp only [den_fmE a9 a10, E.den]
    rw [q2 8 (by decide) (by decide) (by decide), hw2, update_of_ne (by decide), update_of_ne (by decide),
      update_self, hw1, update_self, hGI, rev_getD _ (by omega : tu < lam),
      rev_getD _ (by omega : tv < lam)]
  obtain ⟨y1, hy1⟩ : ∃ y1 : ℤ, y1 = fmul Q (fmul Q (T.gi tu) (T.gi tv)) (fmul Q (u 8) 1) := ⟨_, rfl⟩
  obtain ⟨w3, hw3⟩ : ∃ w3 : Vr, w3 = update w2 8 y1 := ⟨_, rfl⟩
