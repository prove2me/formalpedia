theorem solution (j : ℝ) {R : ℝ} (hR : 3 < R) :
    (fun ε : ℝ =>
        (ellFun (fE j ε) (mE j ε) (N0 3 1) (wE j ε) (pE j ε) (aE j ε) R + 2 * ε * j) / ε ^ 3)
      =ᶠ[𝓝[≠] (0:ℝ)]
    (fun ε : ℝ => (ellE3 j R + ε ^ 2 * (ellE5 j R + ε ^ 2 * (ellE7 j R + ε ^ 2 * (ellE9 j R
            + ε ^ 2 * ellE11 j R))))
          / ((1 + ε ^ 2 * uA j R) * (1 + ε ^ 2 * zA j R))) := by
  have hden : ∀ᶠ ε : ℝ in 𝓝[≠] (0:ℝ),
      (1 + ε ^ 2 * uA j R) * (1 + ε ^ 2 * zA j R) ≠ 0 := by
    have hcont : ContinuousAt (fun ε : ℝ => (1 + ε ^ 2 * uA j R) * (1 + ε ^ 2 * zA j R)) 0 := by
      have hu : ContinuousAt (fun ε : ℝ => ε ^ 2 * uA j R) 0 :=
        (continuousAt_id.pow 2).mul continuousAt_const
      have hz : ContinuousAt (fun ε : ℝ => ε ^ 2 * zA j R) 0 :=
        (continuousAt_id.pow 2).mul continuousAt_const
      exact (continuousAt_const.add hu).mul (continuousAt_const.add hz)
    have hne : (1 + (0:ℝ) ^ 2 * uA j R) * (1 + (0:ℝ) ^ 2 * zA j R) ≠ 0 := by norm_num
    exact (hcont.eventually_ne hne).filter_mono nhdsWithin_le_nhds
  filter_upwards [self_mem_nhdsWithin, hden] with ε hε hne
  have hε0 : ε ≠ 0 := hε
  have h1 : 1 + ε ^ 2 * uA j R ≠ 0 := by
    intro h
    exact hne (by rw [h]; ring)
  have h2 : 1 + ε ^ 2 * zA j R ≠ 0 := by
    intro h
    exact hne (by rw [h]; ring)
  have hid := ellIdentity j ε hR h1 h2
  have hP : ellP j ε R = ε ^ 3 * (ellE3 j R + ε ^ 2 * (ellE5 j R + ε ^ 2 * (ellE7 j R
      + ε ^ 2 * (ellE9 j R + ε ^ 2 * ellE11 j R)))) := by
    unfold ellP
    rw [ellE1_eq_zero j hR]
    ring
  rw [hP] at hid
  field_simp at hid ⊢
  linarith [hid]
