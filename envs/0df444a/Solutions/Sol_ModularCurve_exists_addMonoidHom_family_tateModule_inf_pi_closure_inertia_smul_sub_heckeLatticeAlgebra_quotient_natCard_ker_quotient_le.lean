  have hgen := ModularCurve.exists_nsmul_generator_idempotent_tower_heckeAlg_tateModule_inf_pi_closure_inertia_smul_sub p B hB
  obtain ⟨a, b, s₀, hs₀, te, -, hI2, hI3, hI4, hG⟩ := hgen

  have hDisp : ∀ (t : HeckeAlg), ∀ y ∈ (AddSubgroup.closure
            {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
