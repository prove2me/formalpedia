theorem solution
    (g N n : ℕ) (δ : Fin g → ℕ) [hδ : ∀ i, NeZero (δ i)] (hδd : ∏ i, δ i = N + 1)
    (e : Fin (N + 1) ≃ ((i : Fin g) → ZMod (δ i)))
    (B : Type) [CommRing B] (hd : IsUnit ((N + 1 : ℕ) : B))
    (ζ : B) (hζ : ζ ^ (N + 1) = 1) (hζu : ∀ j : ℕ, 0 < j → j < N + 1 → IsUnit (1 - ζ ^ j))
    (ω : B) (hω : ω ^ 2 = ζ)
    (hn : 3 ≤ n) (hn' : IsUnit ((n : ℕ) : B))
    (hint : ∀ γ : (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)), ∃ U : Matrix (Fin (N + 1)) (Fin (N + 1)) B, ThetaLevel.IsIntertwiner δ (N + 1) B ω e γ.1 U)
    {S : Type} [CommRing S] (φB : B →+* S)
    (X X' : FramedPolarisedAbelianScheme g N n S) (hX : X.IsThetaAdapted δ e) (hX' : X'.IsThetaAdapted δ e)
    (hiso : PolarisedAbelianScheme.Iso X.toPolarisedAbelianScheme X'.toPolarisedAbelianScheme) :
    ∃ (m : ℕ) (r : Fin m → S), Ideal.span (Set.range r) = ⊤ ∧ ∀ (j : Fin m)
      (Y Y' : FramedPolarisedAbelianScheme g N n (Localization.Away (r j))),
      FramedPolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r j))) X Y →
      FramedPolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r j))) X' Y' →
      ∃ γ : (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)), ∀ Y'' : FramedPolarisedAbelianScheme g N n (Localization.Away (r j)),
        Y.IsReframe ((Matrix.transpose (ThetaLevel.inter δ (N + 1) B ω e ((γ)⁻¹).1)).map ((algebraMap S (Localization.Away (r j))).comp φB)) Y'' →
        FramedPolarisedAbelianScheme.Iso Y'' Y' := by
  classical

  obtain ⟨m, r, hr, hloc⟩ := AlgebraicGeometry.PolarisedAbelianScheme.exists_cover_isPullback_of_isPullback_of_iso X.toPolarisedAbelianScheme X'.toPolarisedAbelianScheme hiso

  choose Ya Ya' Xa k ε γ c hYa hYa' hXa hε₁ hε₂ hε₃ hre using
    fun a => K79CL7.perPiece g N n δ hδd e B hd ζ hζ hζu ω hω hint φB X X' hX hX' r hloc a

  obtain ⟨m', t, ht, href⟩ := Ideal.exists_span_eq_top_forall_exists_ringHom_localizationAway_idempotent_eq_one r hr k ε hε₁ hε₂ (fun a i j h => hε₃ a i j h)
  refine ⟨m', t, ht, fun b Y Y' hY hY' => ?_⟩
  obtain ⟨a, i, ρ, hρ, hρ1, hρ0⟩ := href b
  refine ⟨γ a i, fun Y'' hY'' => ?_⟩

  set M : Matrix (Fin (N + 1)) (Fin (N + 1)) (Localization.Away (t b)) :=
    (Matrix.transpose (ThetaLevel.inter δ (N + 1) B ω e ((γ a i)⁻¹).1)).map ((algebraMap S (Localization.Away (t b))).comp φB)
    with hM
  have hW : Matrix.map (fun i' j' => ∑ l, ε a l * (c a : Localization.Away (r a)) *
        ((algebraMap S (Localization.Away (r a))).comp φB)
          ((Matrix.transpose (ThetaLevel.inter δ (N + 1) B ω e ((γ a l)⁻¹).1)) i' j')) ρ =
      ρ (c a) • M := by
    ext i' j'
    have hρ' : ∀ y : S, ρ (algebraMap S (Localization.Away (r a)) y) = algebraMap S (Localization.Away (t b)) y :=
      fun y => by rw [← RingHom.comp_apply, hρ]
    simp only [Matrix.map_apply, Matrix.smul_apply, hM, smul_eq_mul, map_sum, map_mul, RingHom.comp_apply, hρ']
    rw [Fintype.sum_eq_single i (fun l hl => by rw [hρ0 l hl, zero_mul, zero_mul]), hρ1, one_mul]

  obtain ⟨Z, hZ⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isPullback_type0 ρ (Ya a)
  obtain ⟨Z', hZ'⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isPullback_type0 ρ (Ya' a)
  have hMu' : IsUnit M := by
    have hB : IsUnit (Matrix.transpose (ThetaLevel.inter δ (N + 1) B ω e ((γ a i)⁻¹).1)) := by
      rw [Matrix.isUnit_transpose]
      exact (ThetaLevel.isIntertwiner_inter δ (N + 1) B ω e ((γ a i)⁻¹).1 (hint (γ a i)⁻¹)).1
    exact hB.map ((algebraMap S (Localization.Away (t b))).comp φB).mapMatrix
  have hMu : IsUnit (ρ (c a) • M) := by
    rw [Matrix.isUnit_iff_isUnit_det, Matrix.det_smul, Fintype.card_fin]
    exact (((c a).isUnit.map ρ).pow _).mul ((Matrix.isUnit_iff_isUnit_det _).mp hMu')
  obtain ⟨Zp, hZp⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isReframe Z (ρ (c a) • M) hMu
  have hZpPB : FramedPolarisedAbelianScheme.IsPullback ρ (Xa a) Zp := by
    have := AlgebraicGeometry.FramedPolarisedAbelianScheme.isPullback_of_isPullback_of_isReframe ρ _ (Ya a) (Xa a) Z Zp hZ (hre a) (by rw [hW]; exact hZp)
    exact this

  have hZX : FramedPolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (t b))) X Z := by
    rw [← hρ]; exact AlgebraicGeometry.FramedPolarisedAbelianScheme.isPullback_comp _ ρ X (Ya a) Z (hYa a) hZ
  have hZ'X' : FramedPolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (t b))) X' Z' := by
    rw [← hρ]; exact AlgebraicGeometry.FramedPolarisedAbelianScheme.isPullback_comp _ ρ X' (Ya' a) Z' (hYa' a) hZ'
  have iZY : FramedPolarisedAbelianScheme.Iso Z Y := AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_of_isPullback_of_isPullback _ X Z Y hZX hY
  have iZ'Y' : FramedPolarisedAbelianScheme.Iso Z' Y' := AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_of_isPullback_of_isPullback _ X' Z' Y' hZ'X' hY'

  have iZpZ' : FramedPolarisedAbelianScheme.Iso Zp Z' :=
    AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_of_iso_of_isPullback_of_isPullback ρ (Xa a) (Ya' a) Zp Z' (hXa a) hZpPB hZ'

  obtain ⟨Z₁, hZ₁⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isReframe Z M hMu'
  have iZ₁Y'' : FramedPolarisedAbelianScheme.Iso Z₁ Y'' := AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_of_iso_of_isReframe M Z Y Z₁ Y'' iZY hZ₁ hY''
  have iZpZ₁ : FramedPolarisedAbelianScheme.Iso Zp Z₁ :=
    H12_iso_of_isReframe_smul Z Z₁ Zp M (ρ (c a)) ((c a).isUnit.map ρ) hZ₁ hZp

  exact AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_trans _ _ _ (AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_symm _ _ iZ₁Y'')
    (AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_trans _ _ _ (AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_symm _ _ iZpZ₁) (AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_trans _ _ _ iZpZ' iZ'Y'))

