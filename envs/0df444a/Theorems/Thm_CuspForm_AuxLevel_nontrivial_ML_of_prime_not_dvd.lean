    (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [IsDiscreteValuationRing 𝒪] [CharZero 𝒪]
    (θ : CuspForm.heckeAlgebra N 2 S →+* ResidueField 𝒪)
    (hc : CuspForm.AuxLevel.OpComm N r S 𝒪) :
    Nontrivial (CuspForm.AuxLevel.ML N r S 𝒪 θ hc) := by sorry
