attribute [local instance] Classical.propDecidable Classical.decEq

variable {d : ℕ} [NeZero d]

/-- Corollary, PDF p.7: maximal degenerate subgroup suffices for saturation. -/
theorem maximalDegenerateSaturation (Phi : Op (ZMod d) →ₗ[ℂ] Op (ZMod d))
    (hPhi : NormalizedWeylMap Phi) (G : AddSubgroup (WeylLabel d))
    (hG : MaximalDegenerate G) (hopt : (G : Set (WeylLabel d)) ⊆ optimizers (symbol Phi) ∪ {0}) :
    nu 2 Phi = saturationValue (symbol Phi) := by sorry

end QAlgorithms.Papers.Independent.Bridge50.P05

