variable {P s t α : ℕ} {B : Blocks} {T : Tables} {E Dm : ℝ}

theorem J6Seg.cap_term (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α)
    (hx : 3 ≤ xθ s t α) (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E) {lam : ℕ}
    (hlam : ∀ i < s, B.len i ≤ lam) (hP : 100 * (((lam : ℝ) + 1) * E + 1) ≤ 2 ^ P)
    {a : ℕ} (ha : a < s) {i : ℕ} (hia : i ∈ blS B a) {h : ℤ} (hh : h ∈ Hset B i) :
    |(fmul P (MinvI P T B a i) (T.cpl i h) : ℝ) / 2 ^ P - MiG s t α B a i * eEx s t α i h| ≤
      15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P := by sorry
