open scoped ENNReal NNReal
namespace DecrAlmostLinearSSSP.Decremental.Native
open Structured
lemma AdapterMemory.utility_frame {i : Input} {B reserve N : ℕ} {a : AdapterState i}
    {xs : List (Fin i.n)} {s t : Data} (h : AdapterMemory i B reserve N a xs s) (hB : i.n ≤ B)
    (hf : ∀ address, address < (scaleLayout B i.n (scaleCount i) reserve N).utility →
      t.natMem address = s.natMem address ∧ t.realMem address = s.realMem address)
    (hc : t.natReg 182 = s.natReg 182) (hp : t.natReg 180 = s.natReg 180) :
    AdapterMemory i B reserve N a xs t := by
  let l := pointerLayout B i.n (scaleCount i) reserve N
  have hrecordBefore : l.record < (scaleLayout B i.n (scaleCount i) reserve N).utility := by
    dsimp [l,pointerLayout,scaleLayout,Layout.addresses]
    have hs : 1 ≤ scaleCount i := by unfold scaleCount;omega
    nlinarith
  have harray (address : ℕ) (ha : PointerArrayCell l i.n address) :
      t.natMem address = s.natMem address ∧ t.realMem address = s.realMem address := by
    apply hf
    exact (pointerArray_before_record ha).trans hrecordBefore
  have hlen : xs.length ≤ i.n := by simpa only [Fintype.card_fin] using h.pending.nodup.length_le_card
  constructor
  · constructor
    · exact h.table.positive
    · intro j
      apply (h.table.metadata j).frame
      intro offset hoff
      have ho : offset = 0 ∨ offset = 2 ∨ offset = 4 := by simpa using hoff
      apply hf
      rcases ho with rfl | rfl | rfl
      · simpa only [pointerLayout,Nat.mul_zero,Nat.add_zero] using record_cell_before_utility B i.n (scaleCount i) reserve N j.val 0 j.isLt (by omega)
      · exact record_cell_before_utility B i.n (scaleCount i) reserve N j.val 1 j.isLt (by omega)
      · exact record_cell_before_utility B i.n (scaleCount i) reserve N j.val 2 j.isLt (by omega)
    · intro j
      apply (h.table.cache j).frame
      intro v
      exact hf _ (cache_cell_before_utility B i.n (scaleCount i) reserve N j.val v.val j.isLt v.isLt)
  · intro v
    exact (harray _ ⟨v.val,v.isLt,Or.inl rfl⟩).1.trans (h.pointers v)
  · apply h.pending.frame
    · intro v;exact (harray _ ⟨v.val,v.isLt,Or.inr (Or.inl rfl)⟩).1
    · intro r hr;exact (harray _ ⟨r,by omega,Or.inr (Or.inr rfl)⟩).1
    · exact hc
    · exact hp
  · exact h.covered
  · intro v
    have hmem := hf v.val (by dsimp [scaleLayout,Layout.addresses];omega)
    change (if t.natMem v.val = 1 then ⊤ else ENNReal.ofReal (t.realMem v.val)) = a.output v
    rw [hmem.1,hmem.2];exact h.output v
end DecrAlmostLinearSSSP.Decremental.Native
end s241
