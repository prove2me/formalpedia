-- identity being proved.

theorem solution
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters)
    [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (ψbi : _root_.LIDT.MIPStarRE.LDT.QuantumState (ι × ι))
    (family : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily params ι)
    {k ℓ : ℕ} (hℓ : ℓ < k) :
    _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGStageMass params ψbi family k ℓ =
      ∑ p : Bool × _root_.LIDT.MIPStarRE.LDT.Pasting.GHatType (k - (ℓ + 1)),
        _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGTailStageMass params ψbi family ℓ (_root_.LIDT.MIPStarRE.LDT.Pasting.prependTypeBit p.1 p.2) := by
  classical
  unfold _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGStageMass
  have hsub : k - ℓ = (k - (ℓ + 1)) + 1 := by omega
  rw [hsub]
  let n := k - (ℓ + 1)
  change (∑ τtail : _root_.LIDT.MIPStarRE.LDT.Pasting.GHatType (n + 1),
      _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGTailStageMass params ψbi family ℓ τtail) =
    ∑ p : Bool × _root_.LIDT.MIPStarRE.LDT.Pasting.GHatType n,
      _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGTailStageMass params ψbi family ℓ (_root_.LIDT.MIPStarRE.LDT.Pasting.prependTypeBit p.1 p.2)
  exact Fintype.sum_equiv
    ((Fin.consEquiv (fun _ : Fin (n + 1) => Bool)).symm)
    (fun τtail : _root_.LIDT.MIPStarRE.LDT.Pasting.GHatType (n + 1) =>
      _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGTailStageMass params ψbi family ℓ τtail)
    (fun p : Bool × _root_.LIDT.MIPStarRE.LDT.Pasting.GHatType n =>
      _root_.LIDT.MIPStarRE.LDT.Pasting.fromHToGTailStageMass params ψbi family ℓ (_root_.LIDT.MIPStarRE.LDT.Pasting.prependTypeBit p.1 p.2))
    (by
      intro τtail
      congr 1
      funext i
      cases i using Fin.cases with
      | zero => rfl
      | succ j => rfl)
