theorem abs_sum_lt {H : ℤ} (hH : 1 ≤ H) {h : ℕ → ℤ} :
    ∀ J, (∀ j < J, |h j| ≤ H) → |∑ j ∈ range J, h j * (2 * H) ^ j| < (2 * H) ^ J
  | 0, _ => by simp
  | J + 1, hh => by
    rw [sum_range_succ]
    have ih := abs_sum_lt hH J (fun j hj => hh j (by omega))
    have h1 := hh J (by omega)
    have hp : (0 : ℤ) < (2 * H) ^ J := pow_pos (by omega) _
    calc |∑ j ∈ range J, h j * (2 * H) ^ j + h J * (2 * H) ^ J|
        ≤ |∑ j ∈ range J, h j * (2 * H) ^ j| + |h J * (2 * H) ^ J| := abs_add_le _ _
      _ < (2 * H) ^ J + H * (2 * H) ^ J := by
        rw [abs_mul, abs_of_pos hp]
        have := mul_le_mul_of_nonneg_right h1 hp.le
        linarith
      _ ≤ (2 * H) ^ (J + 1) := by rw [pow_succ]; nlinarith

theorem two_pow_pred {b : ℕ} (hb : 1 ≤ b) : (2 : ℤ) ^ b = 2 * 2 ^ (b - 1) := by
  rw [← pow_succ']; congr 1; omega

end Ext

end NLogN.KFV

