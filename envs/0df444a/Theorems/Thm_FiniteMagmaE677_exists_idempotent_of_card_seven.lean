open FiniteMagmaE677

theorem FiniteMagmaE677.exists_idempotent_of_card_seven :
∀ op : Fin 7 → Fin 7 → Fin 7, FiniteMagmaE677.E677 op → ∃ x : Fin 7, op x x = x := by sorry
