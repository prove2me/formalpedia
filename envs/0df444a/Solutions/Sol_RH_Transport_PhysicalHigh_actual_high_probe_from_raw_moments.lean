    _ = (Cp*Ca)*(η.modulus.absNorm:ℝ)^(2*eps)*(Z^(profileExponent (51/100) e)*
      Z^(v*(67/100+12*e+eps*(N+8))+loss-(3/20)*TunedCandidate.ell+mesh*TunedCandidate.ell)) := by ring
