-- title:
--   Theorem 3.4, p. 10 — with linesearch and locally Lipschitz B, the method converges to a zero of A + B in finite dimensions
-- statement:
--   Let $H$ be a finite-dimensional real inner product space, $A:H\rightrightarrows H$ maximally monotone with resolvents $J_{tA}=(I+tA)^{-1}$, and $B:H\to H$ monotone and locally Lipschitz continuous, and suppose $(A+B)^{-1}(0)\neq\emptyset$. Let $\delta\in(0,1)$, $\sigma\in(0,1)$, $\lambda_{-1}>0$ and $x_0,x_{-1}\in H$, and let $(x_k)$ be generated by Algorithm 1: in every iteration some $\rho\in\{1,\sigma^{-1}\}$ is chosen, $\lambda_k=\rho\lambda_{k-1}\sigma^i$ with $i$ the smallest nonnegative integer such that
--   $$x_{k+1}=J_{\lambda_kA}\big(x_k-\lambda_kB(x_k)-\lambda_{k-1}(B(x_k)-B(x_{k-1}))\big)\quad\text{satisfies}\quad\lambda_k\|B(x_{k+1})-B(x_k)\|\le\frac\delta2\|x_{k+1}-x_k\|.$$
--   Then there is $\bar x\in(A+B)^{-1}(0)$ with
--   $$\lim_{k\to\infty}x_k=\bar x .$$
--
--   The linesearch removes the need to know a Lipschitz constant of $B$, and the result covers operators that are only locally Lipschitz.
--
--   **Formalization Note.** The resolvent is a hypothesis: `J : ℝ → H → H` with `IsResolventFamily A J` (for maximally monotone $A$ it exists and is unique on $t>0$). The run predicate requires, at every iteration, the chosen $\rho\in\{1,\sigma^{-1}\}$ and the least accepted index $i$; $\rho$ may vary between iterations. Indices are shifted: `x j` $=x_{j-1}$, `lam j` $=\lambda_{j-1}$; Algorithm 1's $\lambda_0$ is never used by the iteration and is not a parameter. Convergence is in norm (equivalently in any norm, $H$ being finite dimensional).
-- source:
--   Malitsky & Tam, A Forward-Backward Splitting Method for Monotone Inclusions Without Cocoercivity, arXiv:1808.04162v4, p. 10, Theorem 3.4

import Mathlib
import Definitions.Def_ThreeOpSplitting_Accel_MonotoneOperators
import Definitions.Def_FRBSplitting_Linesearch_Setting
open InnerProductSpace ThreeOpSplitting.Accel

namespace FRBSplitting.Linesearch

theorem theorem_3_4 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [FiniteDimensional ℝ H]
    (A : H → Set H) (B : H → H) (J : ℝ → H → H) (δ σ : ℝ)
    (hA : IsMaximalMonotone A)
    (hJ : IsResolventFamily A J)
    (hBm : IsMonotoneFun B) (hBloc : LocallyLipschitz B)
    (hzer : (FRBSplitting.Weak.zeroSet A B).Nonempty)
    (hδ0 : 0 < δ) (hδ1 : δ < 1) (hσ0 : 0 < σ) (hσ1 : σ < 1)
    (lam : ℕ → ℝ) (x : ℕ → H) (hlam0 : 0 < lam 0) (hrun : IsLinesearchRun J B δ σ lam x) :
    ∃ xs ∈ FRBSplitting.Weak.zeroSet A B, Filter.Tendsto x Filter.atTop (nhds xs) := by sorry

end FRBSplitting.Linesearch
