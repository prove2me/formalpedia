theorem shift_eq_of_ratioWindow (c x y x' y' i j : ℕ) (hc : 2 ≤ c) (hx : 0 < x) (hx' : 0 < x')
    (hprod : x * y = x' * y') (hshift : x' * c ^ i = x * c ^ j)
    (hw : x ≤ y ∧ y < c ^ 2 * x) (hw' : x' ≤ y' ∧ y' < c ^ 2 * x') : i = j := by
  have hc0 : 0 < c := by omega
  rcases le_total i j with hij | hji
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hij

    have h1 : x' = x * c ^ k := by
      have : x' * c ^ i = (x * c ^ k) * c ^ i := by rw [hshift, pow_add]; ring
      exact Nat.eq_of_mul_eq_mul_right (Nat.pow_pos hc0) this

    have h2 : y = c ^ k * y' := by
      have : x * y = x * (c ^ k * y') := by rw [hprod, h1]; ring
      exact Nat.eq_of_mul_eq_mul_left hx this

    have h3 : c ^ k * (c ^ k * x) < c ^ 2 * x := by
      calc c ^ k * (c ^ k * x) = c ^ k * x' := by rw [h1]; ring
        _ ≤ c ^ k * y' := Nat.mul_le_mul_left _ hw'.1
        _ = y := h2.symm
        _ < c ^ 2 * x := hw.2
    have h4 : c ^ (2 * k) < c ^ 2 := by
      have : c ^ (2 * k) * x < c ^ 2 * x := by rw [two_mul, pow_add]; simpa [mul_assoc] using h3
      exact Nat.lt_of_mul_lt_mul_right this
    have h5 : 2 * k < 2 := (Nat.pow_lt_pow_iff_right (by omega)).mp h4
    omega
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hji
    have h1 : x = x' * c ^ k := by
      have : x * c ^ j = (x' * c ^ k) * c ^ j := by rw [← hshift, pow_add]; ring
      exact Nat.eq_of_mul_eq_mul_right (Nat.pow_pos hc0) this
    have h2 : y' = c ^ k * y := by
      have : x' * y' = x' * (c ^ k * y) := by rw [← hprod, h1]; ring
      exact Nat.eq_of_mul_eq_mul_left hx' this
    have h3 : c ^ k * (c ^ k * x') < c ^ 2 * x' := by
      calc c ^ k * (c ^ k * x') = c ^ k * x := by rw [h1]; ring
        _ ≤ c ^ k * y := Nat.mul_le_mul_left _ hw.1
        _ = y' := h2.symm
        _ < c ^ 2 * x' := hw'.2
    have h4 : c ^ (2 * k) < c ^ 2 := by
      have : c ^ (2 * k) * x' < c ^ 2 * x' := by rw [two_mul, pow_add]; simpa [mul_assoc] using h3
      exact Nat.lt_of_mul_lt_mul_right this
    have h5 : 2 * k < 2 := (Nat.pow_lt_pow_iff_right (by omega)).mp h4
    omega

theorem ptX_eq_of_ptR_eq_of_inWindow_conn
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N n r : ℕ}
    (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    {𝒪 : Type} [CommRing 𝒪] (π : 𝒪) {Onr : Type} [CommRing Onr] [Algebra 𝒪 Onr]
    (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}))
    {C : Type} [CommRing C] [Algebra 𝒪 C] (χC : Onr →ₐ[𝒪] C)
    {PR : AlgFunctor C} {M : Scheme.{0}} (fM : M ⟶ Spec (CommRingCat.of 𝒪))
    (Xs : ℕ → Scheme.{0}) (ξ : ∀ d, Xs d ⟶ Limits.pullback fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))))
    (ptR : ∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
        (ψS : Onr →ₐ[𝒪] S) (_ : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp χC)
        (u : FakeEllipticCurve.WithFullLevel Λ N n S), FakeEllipticCurve.Rigidification r π A₀ ψS u.1 → PR.obj S)
    (hR3i : ∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp χC)
          (hSc : ∀ e : S, IsIdempotentElem e → e = 0 ∨ e = 1)
          (u u' : FakeEllipticCurve.WithFullLevel Λ N n S)
          (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψS u'.1),
          ptR S ψS hψS u ρ = ptR S ψS hψS u' ρ' →
            ∃ (i : u.1.A ≅ u'.1.A) (hi : i.hom ≫ u'.1.f = u.1.f), FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi ∧
              ∃ (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (_ : ib ≫ ρ'.gb = ρ.gb ≫ i.hom) (_ : ib ≫ ρ'.Eb.f = ρ.Eb.f)
              (uA : ρ'.Ab.A ⟶ ρ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA) (_ : uA ≫ ρ.gA = ρ'.gA)
              (i₁ j₁ : ℕ),
              ib ≫ ρ'.φ ≫ uA ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩)
    (ptX : ∀ (d : ℕ) (T : Type) [CommRing T] [Algebra C T] [Algebra 𝒪 T] [IsScalarTower 𝒪 C T]
            (ψT : Onr →ₐ[𝒪] T) (_ : ψT = (IsScalarTower.toAlgHom 𝒪 C T).comp χC)
            (u : FakeEllipticCurve.WithFullLevel Λ N n T) (ρ : FakeEllipticCurve.Rigidification r π A₀ ψT u.1),
            ρ.d = d → algebraMap C T (algebraMap 𝒪 C π) = 0 →
              SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξ d ≫ Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))))
    (hx4 : ∀ (d : ℕ) (T : Type) [CommRing T] [Algebra C T] [Algebra 𝒪 T] [IsScalarTower 𝒪 C T]
              (ψT : Onr →ₐ[𝒪] T) (hψT : ψT = (IsScalarTower.toAlgHom 𝒪 C T).comp χC)
              (h0 : algebraMap C T (algebraMap 𝒪 C π) = 0)
              (u u' : FakeEllipticCurve.WithFullLevel Λ N n T)
              (ρ : FakeEllipticCurve.Rigidification r π A₀ ψT u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψT u'.1)
              (hd : ρ.d = d) (hd' : ρ'.d = d),
              (ptX d T ψT hψT u ρ hd h0 = ptX d T ψT hψT u' ρ' hd' h0 ↔
                ∃ (i : u.1.A ≅ u'.1.A) (hi : i.hom ≫ u'.1.f = u.1.f), FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi ∧
                  ∃ (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (_ : ib ≫ ρ'.gb = ρ.gb ≫ i.hom) (_ : ib ≫ ρ'.Eb.f = ρ.Eb.f)
                    (uA : ρ'.Ab.A ⟶ ρ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA) (_ : uA ≫ ρ.gA = ρ'.gA),
                    ib ≫ ρ'.φ ≫ uA = ρ.φ))

    (c : ℕ) (hc : 2 ≤ c)
    (deg deg' : ∀ {T : Type} [CommRing T] [Algebra 𝒪 T] {ψT : Onr →ₐ[𝒪] T} {E : FakeEllipticCurve Λ N T},
      FakeEllipticCurve.Rigidification r π A₀ ψT E → ℕ)
    (hpos : ∀ {T : Type} [CommRing T] [Algebra 𝒪 T] {ψT : Onr →ₐ[𝒪] T} {E : FakeEllipticCurve Λ N T}
      (ρ : FakeEllipticCurve.Rigidification r π A₀ ψT E), 0 < deg ρ)
    (hprod : ∀ {T : Type} [CommRing T] [Algebra 𝒪 T] {ψT : Onr →ₐ[𝒪] T} {E : FakeEllipticCurve Λ N T}
      (ρ : FakeEllipticCurve.Rigidification r π A₀ ψT E), deg ρ * deg' ρ = c ^ ρ.d)

    (hdegcorr : ∀ (T : Type) [CommRing T] [Algebra 𝒪 T] (ψT : Onr →ₐ[𝒪] T)
        (u u' : FakeEllipticCurve.WithFullLevel Λ N n T)
        (ρ : FakeEllipticCurve.Rigidification r π A₀ ψT u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψT u'.1)
        (i : u.1.A ≅ u'.1.A) (hi : i.hom ≫ u'.1.f = u.1.f) (hI : FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi)
        (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (_ : ib ≫ ρ'.gb = ρ.gb ≫ i.hom) (_ : ib ≫ ρ'.Eb.f = ρ.Eb.f)
        (uA : ρ'.Ab.A ⟶ ρ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA) (_ : uA ≫ ρ.gA = ρ'.gA)
        (i₁ j₁ : ℕ),
        ib ≫ ρ'.φ ≫ uA ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ →
          deg ρ' * c ^ i₁ = deg ρ * c ^ j₁)

    (htf : ∀ (T : Type) [CommRing T] [Algebra 𝒪 T] (ψT : Onr →ₐ[𝒪] T)
        (u u' : FakeEllipticCurve.WithFullLevel Λ N n T)
        (ρ : FakeEllipticCurve.Rigidification r π A₀ ψT u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψT u'.1)
        (i : u.1.A ≅ u'.1.A) (hi : i.hom ≫ u'.1.f = u.1.f) (hI : FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi)
        (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (_ : ib ≫ ρ'.gb = ρ.gb ≫ i.hom) (_ : ib ≫ ρ'.Eb.f = ρ.Eb.f)
        (uA : ρ'.Ab.A ⟶ ρ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA) (_ : uA ≫ ρ.gA = ρ'.gA)
        (i₁ : ℕ),
        ib ≫ ρ'.φ ≫ uA ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ →
          ib ≫ ρ'.φ ≫ uA = ρ.φ)
    (Nc : ℕ) :
    ∀ (T : Type) [CommRing T] [Algebra C T] [IsNoetherianRing T] [Algebra 𝒪 T] [IsScalarTower 𝒪 C T]
      (hTc : ∀ e : T, IsIdempotentElem e → e = 0 ∨ e = 1) (h0 : algebraMap C T (algebraMap 𝒪 C π) = 0)
      (ψT : Onr →ₐ[𝒪] T) (hψT : ψT = (IsScalarTower.toAlgHom 𝒪 C T).comp χC)
      (u u' : FakeEllipticCurve.WithFullLevel Λ N n T)
      (ρ : FakeEllipticCurve.Rigidification r π A₀ ψT u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψT u'.1)
      (hd : ρ.d = Nc) (hd' : ρ'.d = Nc),
      (deg ρ ≤ deg' ρ ∧ deg' ρ < c ^ 2 * deg ρ) → (deg ρ' ≤ deg' ρ' ∧ deg' ρ' < c ^ 2 * deg ρ') →
      ptR T ψT hψT u ρ = ptR T ψT hψT u' ρ' →
        ptX Nc T ψT hψT u ρ hd h0 = ptX Nc T ψT hψT u' ρ' hd' h0 := by
  intro T _ _ _ _ _ hTc h0 ψT hψT u u' ρ ρ' hd hd' hw hw' hpt
  obtain ⟨i, hi, hIso, ib, hib1, hib2, uA, huA1, huA2, i₁, j₁, hcorr⟩ := hR3i T ψT hψT hTc u u' ρ ρ' hpt
  have hshift := hdegcorr T ψT u u' ρ ρ' i hi hIso ib hib1 hib2 uA huA1 huA2 i₁ j₁ hcorr
  have hpr : deg ρ * deg' ρ = deg ρ' * deg' ρ' := by rw [hprod ρ, hprod ρ', hd, hd']
  have hij : i₁ = j₁ := shift_eq_of_ratioWindow c (deg ρ) (deg' ρ) (deg ρ') (deg' ρ') i₁ j₁ hc (hpos ρ) (hpos ρ') hpr hshift hw hw'
  subst hij
  have hcorr' : ib ≫ ρ'.φ ≫ uA = ρ.φ := htf T ψT u u' ρ ρ' i hi hIso ib hib1 hib2 uA huA1 huA2 i₁ hcorr
  exact (hx4 Nc T ψT hψT h0 u u' ρ ρ' hd hd').mpr ⟨i, hi, hIso, ib, hib1, hib2, uA, huA1, huA2, hcorr'⟩

theorem ptX_eq_of_ptR_eq_of_inWindow_conn'
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N n r : ℕ}
