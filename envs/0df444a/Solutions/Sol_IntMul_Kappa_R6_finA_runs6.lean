/-! ## The rounding passes -/

theorem zsz_S6 (hQ : QOk Q) (hD : Q.d = D + 1) : zsz (Q.S : ℤ) ≤ Q.b :=
  KFL.zsz_le_of_abs (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast hQ.S_lt_b hD)

set_option maxHeartbeats 4000000 in
/-- **The rounding passes.** -/
theorem finA_runs6_sol_aux {I : List Sym} (hQ : QOk Q) (hD : Q.d = D + 1)
    (t : IState HS) (hR : Q.Base t) (zsZ : List GI)
    (hl : zsZ.length = 2 ^ Q.L) (h0 : t.G 0 = ints (gflat zsZ)) (hg : GB (wU6 Q D) zsZ) :
    IRuns I (IL.kTableP tab extM) finA t
      (t.upd 0 (ints (gflat ((zsZ.map KFM.gconj).map fun z =>
        (rndV Q.p Q.b Q.S z.1, rndV Q.p Q.b Q.S z.2)))))
      (kFinA6 Q D) := by
  have hb : 64 ≤ Q.b := hQ.hb
  have zS := zsz_S6 hQ hD
  have hpw : wU6 Q D = Q.p + 2 + (2 * (D + 1) * Q.α ^ 2 + 1) := rfl
  have hpb : Q.p = 6 * Q.b := Q.p_eq
  -- conj
  have hT : KFM.Hold t KFM.rT (zsZ.length : ℤ) := by rw [hl]; push_cast; exact hR.hT
  have hT2' : KFM.Hold t KFM.rT2 ((2 * zsZ.length : ℕ) : ℤ) := by
    have := hR.hT2; rw [hl]; convert this using 2; push_cast; ring
  have r1 := conjW_runs (I := I) (iprog := IL.kTableP tab extM) (wU6 Q D) t zsZ []
    (by rw [h0, List.append_nil]) hg hT hT2'
  rw [List.append_nil] at r1
  set L0 := gflat (zsZ.map KFM.gconj) with hL0
  have hl0 : L0.length = 2 ^ (Q.L + 1) := by
    rw [hL0, length_gflat, List.length_map, hl, pow_succ]; ring
  have b0 : ∀ v ∈ L0, zsz v ≤ wU6 Q D := KFL.zsz_gflat (fun z hz => by
    obtain ⟨y, hy, rfl⟩ := List.mem_map.1 hz
    exact ⟨(hg y hy).1, by simp only [KFM.gconj, zsz_neg]; exact (hg y hy).2⟩)
  have hTL : ∀ (L : List ℤ), L.length = 2 ^ (Q.L + 1) → ∀ t', Q.Base t' →
      KFM.Hold t' KFM.rT2 (L.length : ℤ) := fun L hL t' h => by rw [hL]; push_cast; exact h.hT2
  have hR1 : Q.Base (t.upd 0 (ints L0)) := BaseOK6.upd hR 0 (by decide) _
  -- `×S`
  set f1 : ℤ → ℤ := fun x => ((Q.S : ℤ) * x).tdiv (2 ^ 0) with hf1
  have bf1 : ∀ v, zsz (f1 v) ≤ Q.b + zsz v := fun v => by
    simp only [hf1, pow_zero, Int.tdiv_one]
    exact (zsz_mul_le _ _).trans (by omega)
  have r2 := smulW_runs6 (I := I) tab extM (srcS := KFM.rS) (srcR := KFM.rOne) (by decide) (by decide)
    (by decide) (by decide) (by decide) (wFR6 Q D) 0 (Q.S : ℤ) (t.upd 0 (ints L0)) L0 []
    (by simp) (fun v hv => (b0 v hv).trans (by unfold wFR6; omega)) (by unfold wFR6; omega)
    (hTL L0 hl0 _ hR1) (by simpa using hR1.hOne) hR1.hS
  rw [IState.upd_upd_same, List.append_nil] at r2
  set L1 := L0.map f1 with hL1
  have hl1 : L1.length = 2 ^ (Q.L + 1) := by rw [hL1, List.length_map, hl0]
  have b1 : ∀ v ∈ L1, zsz v ≤ wU6 Q D + Q.b := fun v hv => by
    obtain ⟨u, hu, rfl⟩ := List.mem_map.1 hv
    have := b0 u hu; have := bf1 u; omega
  have hR2 : Q.Base (t.upd 0 (ints L1)) := BaseOK6.upd hR 0 (by decide) _
  have r3 := smulW_runs6 (I := I) tab extM (srcS := KFM.rS) (srcR := KFM.rOne) (by decide) (by decide)
    (by decide) (by decide) (by decide) (wFR6 Q D) 0 (Q.S : ℤ) (t.upd 0 (ints L1)) L1 []
    (by simp) (fun v hv => (b1 v hv).trans (by unfold wFR6; omega)) (by unfold wFR6; omega)
    (hTL L1 hl1 _ hR2) (by simpa using hR2.hOne) hR2.hS
  rw [IState.upd_upd_same, List.append_nil] at r3
  set L2 := L1.map f1 with hL2
  have hl2 : L2.length = 2 ^ (Q.L + 1) := by rw [hL2, List.length_map, hl1]
  have b2 : ∀ v ∈ L2, zsz v ≤ wU6 Q D + 2 * Q.b := fun v hv => by
    obtain ⟨u, hu, rfl⟩ := List.mem_map.1 hv
    have := b1 u hu; have := bf1 u; omega
  have hR3 : Q.Base (t.upd 0 (ints L2)) := BaseOK6.upd hR 0 (by decide) _
  -- `×2^{2b+4}`
  have r4 := shlW_runs (I := I) (iprog := IL.kTableP tab extM) (src := KFM.rF) (by decide) (by decide)
    (2 * Q.b + 4) (wFR6 Q D) (t.upd 0 (ints L2)) L2 [] (by simp)
    (fun v hv => (b2 v hv).trans (by unfold wFR6; omega)) (hTL L2 hl2 _ hR3) hR3.hF
  rw [IState.upd_upd_same, List.append_nil] at r4
  set L3 := L2.map (· * 2 ^ (2 * Q.b + 4)) with hL3
  have hl3 : L3.length = 2 ^ (Q.L + 1) := by rw [hL3, List.length_map, hl2]
  have b3 : ∀ v ∈ L3, zsz v ≤ wFR6 Q D := fun v hv => by
    obtain ⟨u, hu, rfl⟩ := List.mem_map.1 hv
    have := b2 u hu
    have := zsz_mul_le u (2 ^ (2 * Q.b + 4))
    have := KFM.zsz_two_pow (2 * Q.b + 4)
    unfold wFR6; omega
  have hR4 : Q.Base (t.upd 0 (ints L3)) := BaseOK6.upd hR 0 (by decide) _
  -- round
  have r5 := roundW_runs (I := I) (iprog := IL.kTableP tab extM) Q.p (wFR6 Q D) (2 ^ (Q.p - 1))
    (t.upd 0 (ints L3)) L3 [] (by simp) b3
    (by rw [NLogN.zsz_two_pow]; unfold wFR6 wU6; omega) (hTL L3 hl3 _ hR4) hR4.hP2 hR4.hH
  rw [IState.upd_upd_same, List.append_nil] at r5
  have eL : L3.map (fun x => (x + 2 ^ (Q.p - 1)).tdiv (2 ^ Q.p)) =
      gflat ((zsZ.map KFM.gconj).map fun z =>
        (rndV Q.p Q.b Q.S z.1, rndV Q.p Q.b Q.S z.2)) := by
    rw [hL3, hL2, hL1, hL0, List.map_map, List.map_map, List.map_map, gflat_map]
    rfl
  rw [eL] at r5
  refine (r1.seq (r2.seq (r3.seq (r4.seq r5)))).mono' (by simp) (le_of_eq ?_)
  unfold kFinA6 kCj6 kSm6 kShF6 kRd6
  rw [hl, hl0, hl1, hl2, hl3]

end

end IntMul.Kappa.R6

end

theorem solution : type_of% @IntMul.Kappa.R6.finA_runs6_sol_aux := @IntMul.Kappa.R6.finA_runs6_sol_aux
