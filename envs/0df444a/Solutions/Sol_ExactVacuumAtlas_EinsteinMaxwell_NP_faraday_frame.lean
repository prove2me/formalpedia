  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx; have hD : Del M a Q (x 1) ≠ 0 := domReg_D hx
  have hs := domReg_s hx
  simp [rcontr, Fin.sum_univ_four, lR, nR, faradayKN]
  field_simp
  simp only [Sig, cos_sq']; ring

