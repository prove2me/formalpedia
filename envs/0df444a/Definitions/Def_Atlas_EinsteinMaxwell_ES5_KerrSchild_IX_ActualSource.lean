import Mathlib

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.IX

noncomputable section

/-!
# Exact Spacetime Atlas IX — the actual-source adapter

This module is the uploadable B3 adapter for the local VIII15R/VIII17/VIII20
objects.  `PhysicalTrueState` carries the compact nine-slot jet read from a
local true state and its angular-momentum parameter.  The formulas below are
the compactified source formulas used by VIII13, the closed actual `M` source
of VIII17, and the generic completion and weighted residual rows of VIII20.

The adapter is intentionally algebraic.  A local VIII15R state supplies its
jet readout `jt σ` and parameter `σ.2` to `fromTrueState`.  Regularity and
non-degeneracy of that readout are explicit hypotheses of the bridge theorem.
The theorem therefore records the actual source construction without treating
the absorption identity or its positive margin as data fields.
-/

def KG : Set ℝ := Set.Icc 0 (1 / 3)

structure Jet9 where
  U0 : ℝ
  U1 : ℝ
  U2 : ℝ
  Z0 : ℝ
  Z1 : ℝ
  Z2 : ℝ
  B0 : ℝ
  B1 : ℝ
  B2 : ℝ

def nN (x : ℝ) : ℝ := 1 - 4 * x + 3 * x ^ 2

def p (x : ℝ) (w : Jet9) : ℝ := 1 + x * w.U0

def q (x : ℝ) (w : Jet9) : ℝ := 1 + x * w.Z0

def Uj (x : ℝ) (w : Jet9) : ℝ := w.U0 + x * w.U1

def Zj (x : ℝ) (w : Jet9) : ℝ := w.Z0 + x * w.Z1

def Bj (x : ℝ) (w : Jet9) : ℝ := w.B0 + x * w.B1

def qFj (x : ℝ) (w : Jet9) : ℝ :=
  (2 - 4 * x) * (w.U0 - w.Z0) * Zj x w / q x w
    - nN x * (Uj x w * Zj x w / q x w - 2 * (Uj x w) ^ 2 / p x w
      - p x w * (Zj x w) ^ 2 / (q x w) ^ 2)
    - (w.U0 ^ 2 - 4 * w.U0 * w.Z0 + 3 * w.Z0 ^ 2
      - 2 * x * w.U0 * w.Z0 ^ 2 + 2 * x * w.Z0 ^ 3) / (q x w) ^ 2
    - 3 * x ^ 2 * w.U0 ^ 2
    + 16 / 3 * nN x * x * p x w * q x w * (Bj x w) ^ 2
    - 8 / 3 * x * (p x w) ^ 2 * w.B0 ^ 2 / q x w

def qCj (x : ℝ) (w : Jet9) (J : ℝ) : ℝ :=
  w.Z0 * (w.Z0 - w.U0) / q x w + 9 * x ^ 2 * w.U0 * w.Z0
    + (w.Z0 - w.U0) * (1 + 4 * x - 9 * x ^ 2) * Uj x w / p x w
    - nN x * q x w * ((Uj x w) ^ 2 / (p x w) ^ 2
      - Uj x w * Zj x w / (p x w * q x w) + (Zj x w) ^ 2 / (q x w) ^ 2)
    - 4 * nN x * x * (q x w) ^ 2 * (Bj x w) ^ 2
    + 4 * p x w * x * w.B0 ^ 2
    + 4 * p x w * (q x w) ^ 2 * x * (J + 3 * x * w.B0) ^ 2

def qAj (x : ℝ) (w : Jet9) (J : ℝ) : ℝ :=
  -nN x * Zj x w * Bj x w / q x w
    - w.B0 * (2 * w.Z0 + x * w.Z0 ^ 2 - w.U0) / (q x w) ^ 2
    + 9 * x ^ 2 * w.U0 * w.B0 + 3 * x * w.U0 * J

structure PhysicalTrueState where
  jet : ℝ → Jet9
  J : ℝ
  sourceF : ℝ → ℝ
  sourceC : ℝ → ℝ
  sourceCDerivative : ℝ → ℝ
  sourceA : ℝ → ℝ
  sourceF_canonical : ∀ x, sourceF x = qFj x (jet x)
  sourceC_canonical : ∀ x, sourceC x = qCj x (jet x) J
  sourceA_canonical : ∀ x, sourceA x = qAj x (jet x) J

def fromTrueState (jt : ℝ → Jet9) (J : ℝ) (dC : ℝ → ℝ) : PhysicalTrueState :=
  ⟨jt, J, (fun x => qFj x (jt x)), (fun x => qCj x (jt x) J), dC,
    (fun x => qAj x (jt x) J), (fun _ => rfl), (fun _ => rfl), (fun _ => rfl)⟩

def qMj (x : ℝ) (w : Jet9) (J : ℝ) : ℝ :=
  w.Z0 * (w.U0 - w.Z0) / q x w + 3 * x ^ 2 * w.U0 * w.Z0
    + nN x * (Zj x w) ^ 2 / q x w
    + 8 / 3 * nN x * x * (q x w) ^ 2 * (Bj x w) ^ 2
    - 4 / 3 * x * p x w * w.B0 ^ 2
    + 4 * x * p x w * (q x w) ^ 2 * (J + 3 * x * w.B0) ^ 2

def srcMbar (σ : PhysicalTrueState) (x : ℝ) : ℝ := qMj x (σ.jet x) σ.J

def qMcK (σ : PhysicalTrueState) (x : ℝ) : ℝ :=
  ((1 + 4 * x - 9 * x ^ 2) * σ.sourceF x + (1 - 3 * x ^ 2) * σ.sourceC x
      + x * nN x * σ.sourceCDerivative x) / (2 - 4 * x)

def LF (x : ℝ) (w : Jet9) : ℝ :=
  nN x * (2 * w.U0 + 4 * x * w.U1 + x ^ 2 * w.U2)
    - (3 * nN x - 2 + 4 * x) * Uj x w - (2 - 4 * x) * Zj x w
    + (1 + 3 * x ^ 2) * w.U0 - 2 * w.Z0

def LM (x : ℝ) (w : Jet9) : ℝ :=
  nN x * (2 * w.Z0 + 4 * x * w.Z1 + x ^ 2 * w.Z2)
    - (2 - 4 * x) * Zj x w + (1 - 3 * x ^ 2) * w.U0 - 2 * w.Z0

def LC (x : ℝ) (w : Jet9) : ℝ :=
  -(1 + 4 * x - 9 * x ^ 2) * Uj x w + (2 - 4 * x) * Zj x w
    - (1 + 9 * x ^ 2) * w.U0 + 2 * w.Z0

def LA (x : ℝ) (w : Jet9) : ℝ :=
  -(1 - 3 * x ^ 2) * Bj x w + nN x * (2 * w.B0 + 4 * x * w.B1 + x ^ 2 * w.B2)
    - (1 + 9 * x ^ 2) * w.B0

def wF (σ : PhysicalTrueState) (x : ℝ) : ℝ := LF x (σ.jet x) - x * σ.sourceF x

def wMc (σ : PhysicalTrueState) (x : ℝ) : ℝ := LM x (σ.jet x) - x * qMcK σ x

def wC (σ : PhysicalTrueState) (x : ℝ) : ℝ := LC x (σ.jet x) - x * σ.sourceC x

def wA (σ : PhysicalTrueState) (x : ℝ) : ℝ :=
  x * (LA x (σ.jet x) - 3 * σ.J * x - x * σ.sourceA x)

def lamF (x : ℝ) (w : Jet9) : ℝ :=
  -(1 + 4 * x - 9 * x ^ 2) * (w.Z0 - w.U0) / p x w
    + nN x * (2 * q x w * Uj x w - p x w * Zj x w) / (p x w) ^ 2

def lamM (x : ℝ) (w : Jet9) : ℝ :=
  nN x * (2 * p x w * Zj x w - q x w * Uj x w) / (p x w * q x w)

def lamC (x : ℝ) (w : Jet9) : ℝ := 2 * nN x * Uj x w / p x w

def lamA (x : ℝ) (w : Jet9) : ℝ := 8 * nN x * (q x w) ^ 2 * Bj x w

def absorptionCoefficient (σ : PhysicalTrueState) (x : ℝ) : ℝ :=
  2 - 4 * x + x * lamM x (σ.jet x)

def sourceDefect (σ : PhysicalTrueState) (x : ℝ) : ℝ := srcMbar σ x - qMcK σ x

def physicalAbsorbedDefect (σ : PhysicalTrueState) (x : ℝ) : ℝ :=
  absorptionCoefficient σ x * sourceDefect σ x

def PhysicalSourceDataOfTrueState (σ : PhysicalTrueState) : Prop :=
  (∀ x, x ∈ KG → physicalAbsorbedDefect σ x =
      lamF x (σ.jet x) * wF σ x + lamM x (σ.jet x) * wMc σ x
        + lamC x (σ.jet x) * wC σ x + lamA x (σ.jet x) * wA σ x) ∧
    (∀ x, x ∈ KG → (11 / 24 : ℝ) ≤ absorptionCoefficient σ x)

end

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.IX


