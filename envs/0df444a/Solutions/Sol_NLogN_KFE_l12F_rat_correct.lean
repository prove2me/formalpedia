lemma qShape_split (Pre G Suf : Shape) (q r n : ℕ) :
    qShape Pre G Suf q (r + n) = (Pre ++ List.replicate r q) ++
      restShape (G ++ List.replicate r q) Suf q n := by
  simp only [qShape, restShape, List.replicate_add, List.append_assoc]

/-- The middle part is the interchange of the low `n` digits of the two chunks. -/
theorem l12mid_eq {child : Oracle α} {d : α} {W m q Kp : ℕ} (hspec : OracleSpec child d W m q Kp)
    (hm : 2 ≤ m) (hW : 1 ≤ W) (Pre G Suf : Shape) (r : ℕ) {n : ℕ} (hn : n ≤ m ^ Kp)
    (ys : List α) :
    l12mid child W m q Kp r Pre G Suf n d ys =
      AModel.pull (qShape Pre G Suf q (r + n)) (qShape Pre G Suf q (r + n))
        (blockSwap (Pre.length + r) (Pre.length + (r + n) + G.length + r) n) d ys := by
  unfold l12mid
  rw [middle_eq hspec hm hW (AModel.vol Pre) (q ^ r) (G ++ List.replicate r q) Suf hn ys]
  have hX : AModel.vol (Pre ++ List.replicate r q) = AModel.vol [AModel.vol Pre, q ^ r] := by
    simp [vol_append, vol_replicate]
  have H := pull_blockSwap_prefix (Pre ++ List.replicate r q) [AModel.vol Pre, q ^ r]
    (restShape (G ++ List.replicate r q) Suf q n) hX 0 (n + (G ++ List.replicate r q).length) n d ys
  rw [← qShape_split] at H
  rw [show rowShape (AModel.vol Pre) (q ^ r) (G ++ List.replicate r q) Suf q n =
    [AModel.vol Pre, q ^ r] ++ restShape (G ++ List.replicate r q) Suf q n from rfl]
  simp only [List.length_cons, List.length_nil, List.length_append, List.length_replicate] at H ⊢
  rw [show 2 = 0 + 1 + 1 + 0 from rfl, show n + (G.length + r) + 2 = 0 + 1 + 1 + (n + (G.length + r))
    by omega, ← H]
  congr 2 <;> omega

/-- **Correctness of the variant**: it is the interchange of the two `[2^u]` fields. -/
theorem l12v_correct {child : Oracle α} {d : α} {W m q Kp : ℕ}
    (hspec : OracleSpec child d W m q Kp) (hm : 2 ≤ m) (hW : 1 ≤ W) (ρ : ℕ)
    (Pre G Suf : Shape) {e u : ℕ} (he : e ≤ m ^ Kp) (hu : 2 ^ u ≤ q ^ e) (xs : List α) :
    l12v child W m q Kp ρ e u Pre G Suf d xs =
      AModel.pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
        (swapPos Pre.length (Pre.length + 1 + G.length)) d xs := by
  set ys := AModelL12.embed (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (q ^ e)) d xs
  have hys : ys.length = AModel.vol (qShape Pre G Suf q e) := by rw [length_embed, vol_binShape_q]
  have hlen := length_qShape Pre G Suf q e
  have hsz : ∀ k < e, (qShape Pre G Suf q e).getD (Pre.length + k) 0 =
      (qShape Pre G Suf q e).getD (Pre.length + e + G.length + k) 0 :=
    fun k hk => qShape_getD Pre G Suf q e hk
  obtain ⟨r, hr⟩ : ∃ r, min ρ e = r := ⟨_, rfl⟩
  have hre : r ≤ e := hr ▸ min_le_right _ _
  have H1 := highSwaps_eq (sh := qShape Pre G Suf q e) (i := Pre.length)
    (j := Pre.length + e + G.length) (r := r) (by omega) (by omega)
    (fun k hk => hsz k (by omega)) d hys
  have key : (if e - r = 0 then
      highSwaps (qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) r d ys
      else l12mid child W m q Kp r Pre G Suf (e - r) d
        (highSwaps (qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) r d ys)) =
      AModel.pull (qShape Pre G Suf q e) (qShape Pre G Suf q e)
        (blockSwap Pre.length (Pre.length + e + G.length) e) d ys := by
    rw [H1]
    split_ifs with h0
    · rw [show r = e by omega]
    · obtain ⟨n, hn⟩ : ∃ n, e = r + n := ⟨e - r, by omega⟩
      have hn' : e - r = n := by omega
      rw [hn', l12mid_eq hspec hm hW Pre G Suf r (by omega)]
      subst hn
      rw [pull_comp _ _ (fun a ha => valid_blockSwap (by omega) (by omega)
        (fun k hk => by
          have := hsz (r + k) (by omega)
          rw [show Pre.length + (r + k) = Pre.length + r + k by omega,
            show Pre.length + (r + n) + G.length + (r + k) = Pre.length + (r + n) + G.length + r + k
              by omega] at this
          exact this) ha)]
      apply pull_congr
      intro a ha
      simp only [Function.comp_apply]
      rw [blockSwap_blockSwap_adj (by omega) (by rw [ha.length_eq, hlen]; omega)]
  unfold l12v
  rw [hr, key, pull_qShape_eq_swap]
  have hg := binShape_getD Pre G Suf (2 ^ u)
  exact extract_pull_embed (shapeLE_binShape Pre G Suf hu) _
    (fun a ha => valid_swapPos (by rw [length_binShape]; omega)
      (by rw [length_binShape]; omega) (hg.1.trans hg.2.symm) ha) d xs

end Variant

