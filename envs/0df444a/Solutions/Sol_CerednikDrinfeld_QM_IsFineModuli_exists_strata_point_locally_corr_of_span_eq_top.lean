        (Spec.map (CommRingCat.ofHom (τL i j : Bbar j →+* Dbar i j)) ≫ x j) := fun i j =>
    hover i j (D i j) (σR i j) (σL i j) (Ideal.quotientMap _ (σR i j : B i →+* D i j) (hleσ i j (σR i j)))
