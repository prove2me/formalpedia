-- title:
--   The σ-algebra $\sigma(\delta_0,\dots,\delta_{t-1})$ of the past
-- statement:
--   For a sequence of random vectors $\delta_0,\delta_1,\dots$ on $\Omega$, $\sigma(\delta_0,\dots,\delta_{t-1})$ is the smallest σ-algebra on $\Omega$ for which $(\delta_0,\dots,\delta_{t-1})$ is measurable. For $t=0$ it is the trivial σ-algebra $\{\emptyset,\Omega\}$.
--
--   It is the conditioning in Lemma 21: $\mathbb E[\delta_t\mid\delta_0,\dots,\delta_{t-1}]$ and $\mathbb E[\|\delta_t\|^2\mid\delta_0,\dots,\delta_{t-1}]$.
-- source:
--   Yang, Li, Lan, Data-Driven Minimax Optimization with Expectation Constraints, arXiv:2202.07868v2, Lemma 21, p.27

import Mathlib

namespace ExpConMinimax

/-- **The σ-algebra generated by the past `δ₀, …, δ_{t−1}`.**
Yang, Li, Lan, arXiv:2202.07868v2, Lemma 21, p.27: the conditioning in
"`E[δₜ | δ₀, δ₁, ⋯, δ_{t−1}] = 0`" and "`E[‖δₜ‖² | δ₀, δ₁, ⋯, δ_{t−1}] ≤ σ²`".

`pastSigma δ t = σ(δ₀, …, δ_{t−1})`, the smallest σ-algebra on `Ω` making the vector
`(δ₀, …, δ_{t−1})` measurable. For `t = 0` it is the trivial σ-algebra `{∅, Ω}`. -/
def pastSigma {Ω E : Type*} [MeasurableSpace E] (δ : ℕ → Ω → E) (t : ℕ) :
    MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (s : Fin t) => δ s ω) inferInstance

end ExpConMinimax


