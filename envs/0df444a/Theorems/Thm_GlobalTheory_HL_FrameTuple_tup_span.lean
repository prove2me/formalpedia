variable {E V : Type} [CommRing E] [AddCommGroup V] [Module E V] {m : ℕ}

theorem GlobalTheory.HL.FrameTuple.tup_span {t θ : E} (h : θ * t = 1) (g g' : Fin m → V) :
    Submodule.span E (Set.range (tup t g g')) = Submodule.span E (Set.range (Sum.elim g g')) := by sorry
