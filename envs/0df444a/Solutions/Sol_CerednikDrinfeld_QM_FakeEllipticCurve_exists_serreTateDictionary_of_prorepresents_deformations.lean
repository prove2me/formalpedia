section Setting

variable {q : ℕ} [Fact q.Prime]
  {O : Type} [CommRing O] [IsLocalRing O] [Algebra ℤ_[q] O]
  {A : Type} [CommRing A] [IsLocalRing A] [Algebra O A]

theorem ker_eq_maximalIdeal (resA : A →+* ResidueField O) (hs : Function.Surjective resA) :
    RingHom.ker resA = maximalIdeal A :=
  IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective resA hs)

theorem isNilpotent_ker [IsArtinianRing A] (resA : A →+* ResidueField O) (hs : Function.Surjective resA) :
    IsNilpotent (RingHom.ker resA) := by
  rw [ker_eq_maximalIdeal resA hs, ← IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top]
  exact IsArtinianRing.isNilpotent_jacobson_bot

theorem residue_natCast_eq_zero (hqO : algebraMap ℤ_[q] O (q : ℤ_[q]) ∈ maximalIdeal O) :
    residue O (q : O) = 0 := by
  rw [IsLocalRing.residue_eq_zero_iff]
  simpa only [map_natCast] using hqO

theorem isNilpotent_natCast_residueField (hqO : algebraMap ℤ_[q] O (q : ℤ_[q]) ∈ maximalIdeal O) :
    IsNilpotent ((q : ℕ) : ResidueField O) := by
  have : ((q : ℕ) : ResidueField O) = residue O (q : O) := by rw [map_natCast]
  rw [this, residue_natCast_eq_zero hqO]
  exact IsNilpotent.zero

theorem isNilpotent_natCast [IsArtinianRing A] (hqO : algebraMap ℤ_[q] O (q : ℤ_[q]) ∈ maximalIdeal O)
    (resA : A →+* ResidueField O) (hs : Function.Surjective resA)
    (hc : resA.comp (algebraMap O A) = residue O) : IsNilpotent ((q : ℕ) : A) := by
  have hmem : ((q : ℕ) : A) ∈ RingHom.ker resA := by
    rw [RingHom.mem_ker]
    have : ((q : ℕ) : A) = algebraMap O A (q : O) := by rw [map_natCast]
    rw [this, ← RingHom.comp_apply, hc]
    exact residue_natCast_eq_zero hqO
  exact isNilpotent_of_mem (isNilpotent_ker resA hs) hmem

end Setting
