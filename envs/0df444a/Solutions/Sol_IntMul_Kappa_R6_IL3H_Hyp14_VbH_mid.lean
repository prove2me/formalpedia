/-- A configuration constant bound `cW + 3 (2 W' + 12) ≤ K₀`. -/
theorem K0_big : cWc c + 3 * (2 * c.Wr + 12) ≤ K0c c := by
  have := K0_ge c
  have := Zc_ge c
  have := cWc_le c
