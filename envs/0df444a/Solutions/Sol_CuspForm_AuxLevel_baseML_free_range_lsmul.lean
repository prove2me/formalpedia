def nIdeal : Ideal B := RingHom.ker (χ.comp (Sp.toCornerRing i))

theorem mem_nIdeal {b : B} : b ∈ nIdeal Sp i χ ↔ χ (Sp.toCornerRing i b) = 0 := by
  rw [nIdeal, RingHom.mem_ker, RingHom.comp_apply]

