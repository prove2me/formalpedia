theorem nextStep_exec (d : Ports k) (reply : Transcript → Word → Bool) (packet carry : Word)
    (h : Transcript) :
    let b := reply h packet
    Executes d.io (fun hist q => [reply hist q]) d.nextStep (d.mem (frame packet ++ carry) [] [] [] h)
