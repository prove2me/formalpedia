                 (try have := Light.Std.const_le (by assumption))
                 (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega))), by (( (try have := Light.Std.space_le (by assumption))
                                                                                   (try have := Light.Std.const_le (by assumption))
                                                                                   (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega))), hrow⟩
