      apply Finset.sum_le_sum; intro i hi
      apply Finset.sum_le_sum; intro j hj
      apply Finset.sum_le_sum; intro k hk
      simp only [Finset.mem_range] at hi hj hk
      have h0_le : A0_num + i * h0 + h0 ≤ B0_num := nat_grid_step_le (le_of_lt hAB0) hh0_eq hi
      have h1_le : A1_num + j * h1 + h1 ≤ B1_num := nat_grid_step_le (le_of_lt hAB1) hh1_eq hj
      have h2_le : A2_num + k * h2 + h2 ≤ B2_num := nat_grid_step_le (le_of_lt hAB2) hh2_eq hk
      exact r1j13_cell_bound hω ub hub
        (by unfold A0_num; omega) (by unfold A1_num; omega) (by unfold A2_num; omega)
