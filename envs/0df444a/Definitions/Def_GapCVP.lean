def rationalRadius_scanTrace
    (input : List Bool) (count : ℕ) :
    EvalsToInTime rationalRadiusMachine.step (rationalRadiusConfiguration 1 input
        (List.replicate (2 * count) true)
        (List.replicate (2 * count) true) []
