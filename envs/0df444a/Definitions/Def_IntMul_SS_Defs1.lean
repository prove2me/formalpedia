-- Source module: NLogNP.Shift
/-!
# Shifting and splitting integers by a power of two given as an item

A "ruler" is the item `int (2 ^ m)`; its bits are `m` zeros and a one.
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-! ## Bit lemmas -/

/-- Integer with the sign of `z` and magnitude `n`. -/
def sg (z : ℤ) (n : ℕ) : ℤ := if z < 0 then -(n : ℤ) else n

/-! ## Moving the zeros of a ruler -/

def g0 (s : Sym) : Option Sym := if s = 0 then some 0 else none

end NLogN

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-! ## Shift left by a ruler -/

def shlR (q i j t1 t2 : Fin S) : Stmt S P :=
  caseTop i fun o =>
    let h := if o = some hdNeg then hdNeg else hdPos
    .seq (.pop i) (.ite i isBitT
      (.seq (.pop j) (.seq (move q j t2 g0) (.seq (zip q t1 t2 i j true fCopy finNone false)
        (.seq (.push j hdPos) (.push i h)))))
      (.push i h))

def shlCost (m : ℕ) : ℕ := moveCost m + zipCost 0 m + 23

/-! ## Split by a ruler -/

def splitR (q i j k t1 t2 : Fin S) : Stmt S P :=
  caseTop i fun o =>
    let h := if o = some hdNeg then hdNeg else hdPos
    .seq (.pop i) (.seq (.pop j) (.seq (move q j t2 g0) (.seq (take q i t2 t1 j)
      (.seq (.push j hdPos) (.seq (trimTop t1) (.seq (moveBits q t1 k)
        (.seq (.ite k isBitT (.push k h) (.push k hdPos))
          (.ite i isBitT (.push i h) (.push i hdPos)))))))))

def splitCost (m : ℕ) : ℕ := moveCost m + takeCost m + 2 * m + moveCost m + 27

end NLogN

end

