-- Source module: Solutions.KFY1Pad
/-!
# KFY 1: the padded line passes (math side)

The machine keeps the array in the padded box `∏ t_i` on every axis (so that the axis rotations of
`TransNeed` always see the shapes `shPad h bs`). Axis by axis it applies

* **`A`**: a `t_i`-line `X` (only its first `s_i` entries are read) ↦ `sapL p s_i t_i α X`
  (`t_i` outputs);
* **`B₀`**: a `t_i`-line `X` ↦ `(B̃₀ X)_{0..s_i-1}` followed by `t_i − s_i` zeros (`b0Pad`).

As list pipelines these are `tensorGo (mapsA …)` and `tensorGo (mapsB …)` on the dims
`List.ofFn t`. This file proves that they meet the representation and error clauses of
`KFM.LineNeed`:

* **`passA`**: `RepPad zs u`, `‖u‖ ≤ 1/2` ↦ `RepFull L (wOf L)`, `GB (p+2) L` and
  `‖wOf L − tensCLM (kerA M.A) u‖ ≤ εA 2^{−p}` (base `tensor_fp`).
* **`passB`**: `RepFull ys y`, `‖y‖ ≤ 1` ↦ `RepPad L (vOf L)`, `GB (p+2) L` and
  `‖vOf L − tensCLM (kerB M.B) y‖ ≤ εB 2^{−p}`. The padded entries are exactly zero because
  `B̃₀ 0 = 0` (`B0P_zero`) and the slice maps are local (`sliceCompZ_local`).
* `discL_stepA/B`: every axis step keeps the entries in the disc `‖·‖ ≤ 2^p`, so all
  intermediate arrays are `GB (p+2)` (what the rotations and nlogn's slice programs need).
* `getD_listOf'`, `rmPos_digL`, `listOf_self`: `listOf` vs the digits `digL` of `KFMBridge`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf NLogN.KFM IntMul.OpenAI.RT Complex
open KFB (GI gflat)

/-! ## Row-major digits and `listOf` -/

theorem digL_ge : ∀ (dims : List ℕ) (x i : ℕ), dims.length ≤ i → digL dims x i = 0
  | [], _, _, _ => rfl
  | _ :: _, _, 0, h => by simp at h
  | _ :: ts, x, i + 1, h => digL_ge ts _ i (by simp at h; omega)

theorem boxIdxs_getElem? : ∀ (dims : List ℕ) (x : ℕ), x < dims.prod →
    (boxIdxs dims)[x]? = some ((List.range dims.length).map (digL dims x))
  | [], x, hx => by
    simp at hx; subst hx; simp [boxIdxs]
  | n :: ns, x, hx => by
    have hP : 0 < ns.prod := by
      rcases Nat.eq_zero_or_pos ns.prod with h | h
      · simp [h] at hx
      · exact h
    have hq : x / ns.prod < n := by
      rw [Nat.div_lt_iff_lt_mul hP]; simpa [mul_comm] using hx
    have hr : x % ns.prod < ns.prod := Nat.mod_lt _ hP
    have e : x = x / ns.prod * ns.prod + x % ns.prod := (Nat.div_add_mod' x ns.prod).symm
    rw [boxIdxs]
    conv_lhs => rw [e]
    rw [getElem?_flatMap_const n ns.prod _ (fun _ _ => by simp [length_boxIdxs]) _ _ hq hr,
      List.getElem?_map, boxIdxs_getElem? ns _ hr]
    simp only [Option.map_some]
    congr 1
    rw [List.length_cons, List.range_succ_eq_map, List.map_cons, List.map_map]
    congr 1
    all_goals (try simp [digL, Nat.mod_eq_of_lt hq])
    all_goals (try (apply List.map_congr_left; intro i _; simp [digL, Function.comp]))

theorem ixf_digL (dims : List ℕ) (x : ℕ) :
    ixf ((List.range dims.length).map (digL dims x)) = digL dims x :=
  ixf_map_range _ _ (fun i hi => digL_ge dims x i hi)

theorem getD_listOf' {α : Type*} (dims : List ℕ) (f : (ℕ → ℕ) → α) (dflt : α) {x : ℕ}
    (hx : x < dims.prod) : (listOf dims f).getD x dflt = f (digL dims x) := by
  rw [listOf, List.getD_eq_getElem?_getD, List.getElem?_map, boxIdxs_getElem? dims x hx]
  simp only [Option.map_some, Option.getD_some]
  exact congrArg f (ixf_digL dims x)

theorem rmPos_digL : ∀ (dims : List ℕ) (x : ℕ), x < dims.prod → rmPos dims (digL dims x) = x
  | [], x, hx => by simp at hx; subst hx; rfl
  | n :: ns, x, hx => by
    have hP : 0 < ns.prod := by
      rcases Nat.eq_zero_or_pos ns.prod with h | h
      · simp [h] at hx
      · exact h
    have hq : x / ns.prod < n := by
      rw [Nat.div_lt_iff_lt_mul hP]; simpa [mul_comm] using hx
    show digL (n :: ns) x 0 * ns.prod + rmPos ns (fun i => digL (n :: ns) x (i + 1)) = x
    have h1 : (fun i => digL (n :: ns) x (i + 1)) = digL ns (x % ns.prod) := by funext i; rfl
    rw [h1, rmPos_digL ns _ (Nat.mod_lt _ hP)]
    simp only [digL, Nat.mod_eq_of_lt hq]
    exact Nat.div_add_mod' x ns.prod

theorem listOf_self {α : Type*} (dims : List ℕ) (L : List α) (dflt : α)
    (hL : L.length = dims.prod) : listOf dims (fun j => L.getD (rmPos dims j) dflt) = L := by
  apply List.ext_getElem (by rw [length_listOf, hL])
  intro x h1 h2
  have hx : x < dims.prod := by rwa [length_listOf] at h1
  have := getD_listOf' dims (fun j => L.getD (rmPos dims j) dflt) dflt hx
  rw [List.getD_eq_getElem _ _ h1] at this
  rw [this, rmPos_digL dims x hx, List.getD_eq_getElem _ _ h2]

theorem digL_rmPos (dims : List ℕ) {l : List ℕ} (hl : l ∈ boxIdxs dims) :
    digL dims (rmPos dims (ixf l)) = ixf l := by
  have hx := rmPos_lt hl
  have h1 := getElem?_rmPos hl
  rw [boxIdxs_getElem? dims _ hx] at h1
  have h2 := Option.some_injective _ h1
  calc digL dims (rmPos dims (ixf l))
      = ixf ((List.range dims.length).map (digL dims (rmPos dims (ixf l)))) := (ixf_digL _ _).symm
    _ = ixf l := by rw [h2]

/-! ## Box points as natural-number index functions -/

variable {d : ℕ}

theorem extF_ixf {l : List ℕ} (hl : l.length = d) : extF (fun i : Fin d => ixf l i) = ixf l := by
  funext i
  unfold extF
  split_ifs with h
  · rfl
  · simp only [ixf]; rw [List.getD_eq_default _ _ (by omega)]

theorem listOf_extF {α : Type*} (dims : List ℕ) (hd : dims.length = d) (F : (ℕ → ℕ) → α) :
    listOf dims (fun j => F (extF (fun i : Fin d => j i))) = listOf dims F := by
  unfold listOf
  apply List.map_congr_left
  intro l hl
  have := (mem_boxIdxs.1 hl).1
  show F (extF fun i : Fin d => ixf l i) = F (ixf l)
  rw [extF_ixf (this.trans hd)]

theorem ofFn_getD (t : Fin d → ℕ) (i : Fin d) (c : ℕ) : (List.ofFn t).getD i c = t i := by
  simp [List.getD_eq_getElem?_getD]

/-- The point `j` of the box `t` (all `j i < t i`): its row-major index and digits. -/
theorem box_pt (t : Fin d → ℕ) (j : Fin d → ℕ) (hj : ∀ i, j i < t i) :
    rmPos (List.ofFn t) (extF j) < (List.ofFn t).prod ∧
      digL (List.ofFn t) (rmPos (List.ofFn t) (extF j)) = extF j := by
  have hl : (List.range d).map (extF j) ∈ boxIdxs (List.ofFn t) := by
    have := map_range_mem_boxIdxs (List.ofFn t) (extF j) (by
      intro i hi
      simp only [List.length_ofFn] at hi
      rw [show (List.ofFn t).getD i 1 = t ⟨i, hi⟩ from ofFn_getD t ⟨i, hi⟩ 1]
      simp only [extF, dif_pos hi]
      exact hj _)
    simpa using this
  have he : ixf ((List.range d).map (extF j)) = extF j :=
    ixf_map_range _ _ (fun i hi => by simp [extF]; omega)
  rw [← he]
  exact ⟨rmPos_lt hl, digL_rmPos _ hl⟩

theorem extF_digL (t : Fin d → ℕ) (x : ℕ) :
    extF (fun i : Fin d => digL (List.ofFn t) x i) = digL (List.ofFn t) x := by
  funext i
  unfold extF
  split_ifs with h
  · rfl
  · rw [digL_ge _ _ _ (by simp; omega)]

theorem listOf_gIn (dims : List ℕ) (hd : dims.length = d) (zs : List GI)
    (hz : zs.length = dims.prod) :
    listOf dims (fun j => gIn (d := d) dims zs (fun i : Fin d => j i)) = zs := by
  have := listOf_extF (d := d) dims hd (fun j => zs.getD (rmPos dims j) 0)
  show (listOf dims fun j => zs.getD (rmPos dims (extF (d := d) fun i : Fin d => j i)) 0) = zs
  rw [this, listOf_self dims zs 0 hz]

/-! ## Discs and bit bounds -/

theorem gC_zero : gC (0 : GI) = 0 := by simp [gC]

theorem gC_zero' : gC ((0, 0) : GI) = 0 := gC_zero

/-! ## The line maps -/

/-! ## Locality of slice maps -/

theorem sliceCompZ_local (A : Fin d → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ)) (i : Fin d) (c : ℕ) :
    ∀ (l : List (Fin d)), i ∉ l → ∀ (y y' : (Fin d → ℕ) → ℤ × ℤ),
      (∀ m, m i = c → y m = y' m) → ∀ m, m i = c → sliceCompZ A l y m = sliceCompZ A l y' m
  | [], _, y, y', h, m, hm => h m hm
  | i1 :: l, hil, y, y', h, m, hm => by
    have h1 : i1 ≠ i := fun e => hil (by simp [e])
    have h2 : i ∉ l := fun e => hil (by simp [e])
    simp only [sliceCompZ, Function.comp]
    refine sliceCompZ_local A i c l h2 _ _ (fun m' hm' => ?_) m hm
    simp only [sliceMapZ]
    congr 1
    funext k
    apply h
    rw [Function.update_of_ne (Ne.symm h1)]
    exact hm'

theorem sliceCompZ_zero (A : Fin d → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ))
    (hA : ∀ i, A i (fun _ => (0, 0)) = fun _ => (0, 0)) :
    ∀ l : List (Fin d), sliceCompZ A l (fun _ => (0, 0)) = fun _ => (0, 0)
  | [] => rfl
  | i :: l => by
    simp only [sliceCompZ, Function.comp]
    have : sliceMapZ i (A i) (fun _ => ((0 : ℤ), (0 : ℤ))) = fun _ => (0, 0) := by
      funext m; simp only [sliceMapZ, hA]
    rw [this, sliceCompZ_zero A hA l]

/-! ## The `A` pass -/

section passA

variable (p α : ℕ) (s t : Fin d → ℕ) [∀ i, NeZero (s i)] [∀ i, NeZero (t i)]

theorem repFull_disc {zs : List GI} {w : ((i : Fin d) → ZMod (t i)) → ℂ}
    (hrep : RepFull p t zs w) (hw : ‖w‖ ≤ 1) : ∀ x, ‖gC (zs.getD x 0)‖ ≤ 2 ^ p := by
  intro x
  by_cases hx : x < (List.ofFn t).prod
  · rw [hrep.2 x hx, norm_mul]
    have := (norm_le_pi_norm w (fun i => ((boxIx t x i : ℕ) : ZMod (t i)))).trans hw
    simp only [norm_pow, RCLike.norm_ofNat]
    nlinarith [pow_pos (show (0 : ℝ) < 2 by norm_num) p]
  · rw [List.getD_eq_default _ _ (by rw [hrep.1]; omega), gC_zero, norm_zero]; positivity

