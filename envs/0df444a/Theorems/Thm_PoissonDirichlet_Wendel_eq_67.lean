-- name    : PoissonDirichlet.Wendel.eq_67
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-06T17:35:42.411991+00:00
-- url     : https://prove2.me/theorems/eed6de2a-8f9b-4496-8a66-a1de19f7f965
-- title:
--   (67), p. 871 — E[exp(−λΣ_n) | Δ_1, …, Δ_n] = exp(−Δ_n^{−α} ∫_0^1 (1 − e^{−λu}) Λ_α(du))
-- statement:
--   Let $0<\alpha<1$, $C>0$, and let $\Delta_1>\Delta_2>\cdots$ be the ranked points of a Poisson random measure $\Lambda_\alpha$ on $(0,\infty)$ with $\Lambda_\alpha(x,\infty)=Cx^{-\alpha}$, so $\Lambda_\alpha(du)=C\alpha u^{-\alpha-1}du$. For $n\ge1$ put $\Sigma_n=(\Delta_{n+1}+\Delta_{n+2}+\cdots)/\Delta_n$. Then for every $\lambda\ge0$, almost surely
--   $$E\left[\exp(-\lambda\Sigma_n)\,\middle|\,\Delta_1,\dots,\Delta_n\right]=\exp\left(-\Delta_n^{-\alpha}\int_0^1\left(1-e^{-\lambda u}\right)\Lambda_\alpha(du)\right).$$
--
--   Integrating this against the gamma$(n)$ law of $C\Delta_n^{-\alpha}$ gives (37).
--
--   **Formalization Note** The ranked points $\Delta_1>\Delta_2>\cdots$ of a Poisson random measure $\Lambda_\alpha$ on $(0,\infty)$ with $\Lambda_\alpha(x,\infty)=Cx^{-\alpha}$ are represented through the arrival times of a unit-rate Poisson process, as in (27)–(28) of the paper: $X_n=\varepsilon_1+\cdots+\varepsilon_n$ with $\varepsilon_i$ i.i.d. standard exponential, and $\Delta_n=(C/X_n)^{1/\alpha}$, so that $X_n=C\Delta_n^{-\alpha}=\Lambda_\alpha(\Delta_n,\infty)$. No general Poisson random measure is built. The interarrival variables are assumed measurable so that the $\sigma$-algebra generated by $(\Delta_1,\dots,\Delta_n)$ is a sub-$\sigma$-algebra of the ambient one. The restriction $\alpha<1$ comes from the setting of Proposition 11, in whose proof (67) appears; for $\alpha\ge1$ the integral diverges. 0-based: $n=k+1$, `prmPoint α C ε k` is $\Delta_{k+1}$.
-- source:
--   Pitman and Yor, The two-parameter Poisson–Dirichlet distribution derived from a stable subordinator, Ann. Probab. 25 (1997), p. 871, (67), proof of Proposition 11

import Mathlib
import Definitions.Def_PoissonDirichlet_Wendel_Setting
open MeasureTheory ProbabilityTheory Filter Topology

namespace PoissonDirichlet.Wendel

/-- (67), p. 871: with `Δ_n` the PoissonDirichlet.Ratio.ranked PRM points of Lemma 24 (arrival-time representation),
0 < α < 1, and `Σ_n = (Δ_{n+1} + Δ_{n+2} + ⋯) / Δ_n`, for λ ≥ 0
`E[exp(-λ Σ_n) | Δ_1, …, Δ_n] = exp(-Δ_n^{-α} ∫_0^1 (1 - e^{-λu}) Λ_α(du))` a.s., where
`Λ_α(du) = C α u^{-α-1} du`. 0-based: n = k + 1, `prmPoint α C ε k` is `Δ_{k+1}`. -/
theorem eq_67 {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (α C : ℝ) (hα : 0 < α) (hα1 : α < 1) (hC : 0 < C) (ε : ℕ → Ω → ℝ)
    (hmeas : ∀ i, Measurable (ε i)) (hind : iIndepFun ε P)
    (hlaw : ∀ i, HasLaw (ε i) (expMeasure 1) P) (k : ℕ) (l : ℝ) (hl : 0 ≤ l) :
    P[fun ω => Real.exp (-l * ((∑' j : ℕ, prmPoint α C ε (k + 1 + j) ω) / prmPoint α C ε k ω)) |
        MeasurableSpace.comap (fun ω (i : Fin (k + 1)) => prmPoint α C ε i ω) inferInstance]
      =ᵐ[P] fun ω => Real.exp (-(prmPoint α C ε k ω ^ (-α)) *
        ∫ u in Set.Ioc (0 : ℝ) 1, (1 - Real.exp (-l * u)) * (C * α * u ^ (-α - 1))) := by sorry

end PoissonDirichlet.Wendel
