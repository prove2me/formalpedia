section Cert

lemma Lterms_eq (h i : ℕ) :
    Lterms (h := h) i = (LtermsZ h i).map fun s => ((s.1 : ℚ), s.2) := by
  unfold Lterms LtermsZ; split_ifs <;> simp

lemma Rterms_eq (h j : ℕ) :
    Rterms (h := h) j = (RtermsZ h j).map fun s => ((s.1 : ℚ), s.2) := by
  unfold Rterms RtermsZ; split_ifs <;> simp

lemma cor_cast {h : ℕ} (M : Matrix (Pr (h + 4)) (Pr (h + 4)) ℤ) (i j : ℕ) :
    cor (M.map (Int.cast : ℤ → ℚ)) i j = (corZ M i j : ℚ) := by
  unfold cor corZ
  rw [Lterms_eq, Rterms_eq]
  simp only [List.map_map, Function.comp_def, Int.cast_list_sum, Int.cast_mul, map_apply]

/-! ## List arithmetic -/

lemma dotL_eq {R : Type*} [CommRing R] : ∀ (a b : List ℕ) (hab : a.length = b.length),
    ((dotL a b : ℕ) : R) = ∑ l : Fin a.length, ((a.getD l 0 : ℕ) : R) * ((b.getD l 0 : ℕ) : R)
  | [], [], _ => by simp [dotL]
  | a :: as, b :: bs, hab => by
    simp only [List.length_cons, Nat.add_right_cancel_iff] at hab
    rw [dotL, Nat.cast_add, Nat.cast_mul, dotL_eq as bs hab]
    simp only [List.length_cons, Fin.sum_univ_succ, Fin.val_zero, List.getD_cons_zero,
      Fin.val_succ, List.getD_cons_succ]
  | [], _ :: _, hab => by simp at hab
  | _ :: _, [], hab => by simp at hab

lemma certChk_sound (rows cols : List (List ℕ)) (k p : ℕ) (hc : certChk rows cols k p = true) :
    (Matrix.of fun i l : Fin k => (((rows.getD i []).getD l 0 : ℕ) : ZMod p)) *
      (Matrix.of fun l j : Fin k => (((cols.getD j []).getD l 0 : ℕ) : ZMod p)) = 1 := by
  simp only [certChk, Bool.and_eq_true, beq_iff_eq, List.all_eq_true, List.mem_range] at hc
  obtain ⟨⟨⟨⟨hr, hcl⟩, hrl⟩, hcll⟩, hall⟩ := hc
  ext i j
  have hri : (rows.getD i []).length = k := by
    rw [List.getD_eq_getElem _ _ (by omega)]; exact hrl _ (List.getElem_mem _)
  have hcj : (cols.getD j []).length = k := by
    rw [List.getD_eq_getElem _ _ (by omega)]; exact hcll _ (List.getElem_mem _)
  have h1 := dotL_eq (R := ZMod p) (rows.getD i []) (cols.getD j []) (hri.trans hcj.symm)
  have h2 := hall i i.isLt j j.isLt
  rw [Matrix.mul_apply]
  simp only [of_apply]
  have h3 : ((dotL (rows.getD i []) (cols.getD j []) : ℕ) : ZMod p) =
      ((if (i : ℕ) = j then 1 else 0 : ℕ) : ZMod p) := by
    rw [← ZMod.natCast_mod, h2]
  rw [h1] at h3
  have h4 : (∑ l : Fin (rows.getD i []).length,
      (((rows.getD i []).getD l 0 : ℕ) : ZMod p) * (((cols.getD j []).getD l 0 : ℕ) : ZMod p)) =
      ∑ l : Fin k, (((rows.getD i []).getD l 0 : ℕ) : ZMod p) *
        (((cols.getD j []).getD l 0 : ℕ) : ZMod p) := by
    rw [hri]
  rw [h4] at h3
  rw [h3, Matrix.one_apply]
  by_cases e : i = j
  · subst e; simp
  · rw [if_neg (fun h => e (Fin.ext h)), if_neg e]; simp

lemma det_ne_zero_of_certChk {k p : ℕ} [Fact (1 < p)] (rows cols : List (List ℕ))
    (hc : certChk rows cols k p = true) :
    (Matrix.of fun i l : Fin k => (((rows.getD i []).getD l 0 : ℕ) : ZMod p)).det ≠ 0 := by
  have h := congrArg Matrix.det (certChk_sound rows cols k p hc)
  rw [det_mul, det_one] at h
  intro h0
  rw [h0, zero_mul] at h
  exact zero_ne_one h

/-! ## The witness -/

theorem cert_chk : certChk certRows certCols 45 certP = true := by decide +kernel

theorem cert_entries : ((List.range 45).all fun i => (List.range 45).all fun j =>
    decide (corZ (h := 19) MZ i j % (certP : ℤ) = (((certRows.getD i []).getD j 0 : ℕ) : ℤ))) =
    true := by
  decide +kernel

lemma qxy1 : qy1 ⬝ᵥ qx1 = 1 := by
  simp only [qx1, qy1, dotProduct, ← Int.cast_mul, ← Int.cast_sum]
  norm_cast

lemma qxy2 : qy2 ⬝ᵥ qx2 = 1 := by
  simp only [qx2, qy2, dotProduct, ← Int.cast_mul, ← Int.cast_sum]
  norm_cast

lemma MZ_map : MZ.map (Int.cast : ℤ → ℚ) =
    (1 - vecMulVec qx1 qy1) ⊗ₖ (1 - vecMulVec qx2 qy2) := by
  ext ⟨a, b⟩ ⟨c, d⟩
  simp only [MZ, map_apply, kronecker_apply, Matrix.sub_apply, vecMulVec_apply, Matrix.one_apply,
    qx1, qy1, qx2, qy2]
  push_cast
  split_ifs <;> simp

/-- **The data corner is invertible at the witness** (`h = 23`). -/
theorem data_cert : (Matrix.of fun i j : Fin 45 =>
    cor (h := 19) ((1 - vecMulVec qx1 qy1) ⊗ₖ (1 - vecMulVec qx2 qy2)) i.val j.val).det ≠ 0 := by
  have hD : (Matrix.of fun i j : Fin 45 =>
      cor (h := 19) ((1 - vecMulVec qx1 qy1) ⊗ₖ (1 - vecMulVec qx2 qy2)) i.val j.val) =
      (Matrix.of fun i j : Fin 45 => corZ (h := 19) MZ i.val j.val).map (Int.cast : ℤ → ℚ) := by
    ext i j
    rw [← MZ_map, of_apply, cor_cast]; rfl
  rw [hD]
  set Dz := Matrix.of fun i j : Fin 45 => corZ (h := 19) MZ i.val j.val with hDz
  have e1 : (Dz.map (Int.cast : ℤ → ℚ)).det = ((Dz.det : ℤ) : ℚ) := by
    have := RingHom.map_det (Int.castRingHom ℚ) Dz
    rw [RingHom.mapMatrix_apply] at this
    exact this.symm
  rw [e1, Int.cast_ne_zero]
  intro h0
  have e2 := RingHom.map_det (Int.castRingHom (ZMod certP)) Dz
  rw [RingHom.mapMatrix_apply, h0, map_zero] at e2
  have e3 : Dz.map (Int.castRingHom (ZMod certP)) =
      Matrix.of fun i l : Fin 45 => (((certRows.getD i []).getD l 0 : ℕ) : ZMod certP) := by
    ext i l
    have hc := cert_entries
    simp only [List.all_eq_true, List.mem_range, decide_eq_true_eq] at hc
    have := hc i i.isLt l l.isLt
    rw [map_apply, hDz, of_apply, of_apply, eq_intCast, ← ZMod.intCast_mod, this,
      Int.cast_natCast]
  rw [e3] at e2
  exact det_ne_zero_of_certChk certRows certCols cert_chk e2.symm

end Cert

