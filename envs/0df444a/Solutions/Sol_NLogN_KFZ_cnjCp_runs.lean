  have e : A.take (m + 1) = A.take m ++ [A[m]] := by
    rw [List.take_add_one, List.getElem?_eq_getElem hm]; rfl
  rw [e, gflat_append]; rfl

theorem cnjB_runs (H W : Fin HS) (hHU : H ≠ pU) (hWU : W ≠ pU) (hHW : H ≠ W)
    (st : IState HS) (a : GI) (LU : List Item) (hU : st.G pU = .int a.2 :: .int a.1 :: LU) :
    IRuns I iprog (cnjB H W) st
      (((st.upd pU LU).upd W (.int (gconj a).1 :: .int (gconj a).2 :: st.G W)).upd H
        (.int a.1 :: .int a.2 :: st.G H))
      (4 * (300 * (zsz a.1 + zsz a.2 + 1)) + 40) := by
  have k1 := IRuns.neg (I := I) (iprog := iprog) hU
  set s1 := st.upd pU (.int (-a.2) :: .int a.1 :: LU) with hs1
  have k2 := IRuns.dup (I := I) (iprog := iprog) (s := s1) (i := pU) (j := W) (a := -a.2)
    (L := .int a.1 :: LU) (Ne.symm hWU) (by simp [hs1])
  set s2 := s1.upd W (.int (-a.2) :: s1.G W) with hs2
  have k3 := IRuns.neg (I := I) (iprog := iprog) (s := s2) (i := pU) (a := -a.2)
    (L := .int a.1 :: LU) (by simp [hs2, hs1, hWU, Ne.symm hWU])
  set s3 := s2.upd pU (.int (- -a.2) :: .int a.1 :: LU) with hs3
  have k4 := IRuns.mv (I := I) (iprog := iprog) (s := s3) (i := pU) (j := H) (a := - -a.2)
    (L := .int a.1 :: LU) (Ne.symm hHU) (by simp [hs3])
  set s4 := (s3.upd pU (.int a.1 :: LU)).upd H (.int (- -a.2) :: s3.G H) with hs4
  have k5 := IRuns.dup (I := I) (iprog := iprog) (s := s4) (i := pU) (j := W) (a := a.1)
    (L := LU) (Ne.symm hWU) (by simp [hs4, hs3, hs2, hs1, hHU, Ne.symm hHU, hWU, Ne.symm hWU])
  set s5 := s4.upd W (.int a.1 :: s4.G W) with hs5
  have k6 := IRuns.mv (I := I) (iprog := iprog) (s := s5) (i := pU) (j := H) (a := a.1)
    (L := LU) (Ne.symm hHU) (by simp [hs5, hs4, hs3, hs2, hs1, hHU, hWU, Ne.symm hHU, Ne.symm hWU])
  refine (k1.seq (k2.seq (k3.seq (k4.seq (k5.seq k6))))).mono' ?_ ?_
  · have hWH : W ≠ H := Ne.symm hHW
    simp only [hs5, hs4, hs3, hs2, hs1, gconj, neg_neg]
    clear k1 k2 k3 k4 k5 k6
    ((apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out, cf] <;> split_ifs <;> simp_all +decide))
  · simp only [neg_neg]
    have z1 : zsz (-a.2) = zsz a.2 := zsz_neg _
    have d1 := dupCost_le (zsz (-a.2)); have d2 := dupCost_le (zsz a.1)
    have m1 := moveIntCost_le (zsz a.2); have m2 := moveIntCost_le (zsz a.1)
    rw [z1] at d1 ⊢
    omega

theorem cnjCp_runs_sol_aux (H W : Fin HS) (hHU : H ≠ pU) (hWU : W ≠ pU) (hHW : H ≠ W) (hH : NC H)
    (hW : NC W) (hHX : H ≠ nX) (hWX : W ≠ nX) (A : List GI) (B : ℕ) (hB : GB B A)
    (s : IState HS) (RH LX LX2 : List Item) (h0 : s.G H = ints (gflat A) ++ RH)
    (hX : s.G nX = .int (A.length : ℤ) :: LX)
    (hX2 : s.G nX2 = .int ((2 * A.length : ℕ) : ℤ) :: LX2) :
    IRuns I iprog (cnjCp H W) s (s.upd W (ints (gflat (A.map gconj)) ++ s.G W))
      (cCnj A.length B) := by
  set N := A.length with hN
  have h1 := NLogN.KFM.mvN_runs (I := I) (iprog := iprog) H pU hHU hH (by decide) (gflat A) B hB.bnd s RH h0
  rw [length_gflat] at h1
  have h1 := rptX_of_rpt (by decide) hX2 h1
  set s1 := (s.upd H RH).upd pU (ints (gflat A).reverse ++ s.G pU) with hs1
  let T : ℕ → IState HS := fun k =>
    ((s.upd pU (ints (gflat (A.take (N - k))).reverse ++ s.G pU)).upd H
      (ints (gflat (A.drop (N - k))) ++ RH)).upd W
      (ints (gflat ((A.drop (N - k)).map gconj)) ++ s.G W)
  have h2 := rpt_runs (I := I) (iprog := iprog) (A := pA) (C := pC) (D := pD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) N T
    (fun k => by simp +decide [T, hH.1.symm, hW.1.symm]) (fun k => by simp +decide [T, hH.2.1.symm, hW.2.1.symm])
    (fun k => by simp +decide [T, hH.2.2.symm, hW.2.2.symm]) (cnjB H W)
    (4 * (300 * (2 * B + 1)) + 40)
    (by
      intro k hk LA LC LD
      set m := N - (k + 1) with hm
      have hm1 : N - k = m + 1 := by omega
      have hmN : m < A.length := by omega
      have ht := gflat_take_succ A m hmN
      have hd : A.drop m = A[m] :: A.drop (m + 1) := List.drop_eq_getElem_cons hmN
      have hU : (cf3 (T k) pA pC pD LA LC LD).G pU =
          .int A[m].2 :: .int A[m].1 :: (ints (gflat (A.take m)).reverse ++ s.G pU) := by
        simp only [T, cf3, IState.upd_G, hm1, ht]
        simp +decide [hHU.symm, hWU.symm, ints]
      have H1 := cnjB_runs (I := I) (iprog := iprog) H W hHU hWU hHW _ A[m] _ hU
      refine H1.mono' ?_ ?_
      · have e1 : ints (gflat ((A.drop m).map gconj)) =
            .int (gconj A[m]).1 :: .int (gconj A[m]).2 :: ints (gflat ((A.drop (m + 1)).map gconj)) := by
          rw [hd, List.map_cons, gflat_cons]; rfl
        have e2 : ints (gflat (A.drop m)) =
            .int A[m].1 :: .int A[m].2 :: ints (gflat (A.drop (m + 1))) := by
          rw [hd, gflat_cons]; rfl
        have hm2 : N - (k + 1) = m := rfl
        simp only [T, cf3, hm1, hm2, e1, e2]
        clear H1 hU e1 e2 ht hd
        have hWH : W ≠ H := Ne.symm hHW
        ((apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out, cf] <;> split_ifs <;> simp_all +decide))
      · have := hB A[m] (List.getElem_mem hmN); omega)
  have e0 : T 0 = s1 := by
    simp only [T, Nat.sub_zero, List.take_length, List.drop_length, hN]
    simp only [hs1, List.map_nil, gflat_nil, ints, List.map_nil, List.nil_append]
    have hWH : W ≠ H := Ne.symm hHW
    ((apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out, cf] <;> split_ifs <;> simp_all +decide))
  have eN : T N = s.upd W (ints (gflat (A.map gconj)) ++ s.G W) := by
    simp only [T, Nat.sub_self, List.take_zero, List.drop_zero, gflat_nil, List.reverse_nil]
    rw [← h0]
    simp only [ints, List.map_nil, List.nil_append]
    have hWH : W ≠ H := Ne.symm hHW
    ((apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out, cf] <;> split_ifs <;> simp_all +decide))
  rw [e0, eN] at h2
  have h2 := rptX_of_rpt (by decide) (show s1.G nX = .int (N : ℤ) :: LX by
    simp +decide [hs1, hHX, Ne.symm hHX, hX]) h2
  refine (h1.seq h2).mono ?_
  unfold cCnj cCnt
  simp only [hN] at *
  omega

