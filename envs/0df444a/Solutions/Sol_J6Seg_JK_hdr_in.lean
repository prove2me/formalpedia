/-!
# B-line IL, the `J` kernel (B4), part 14: the kernel states

`kS B z0 re im v w tmp wr wi`: the managed state `B` (registers loaded, table body on `dTJ`)
with the stacks `0, RE, IM, V, W, TMP, WR, WI` replaced; lookup and update lemmas.
The header moves `hdrIn` / `hdrOut`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL NLogN.KFB Function Finset

/-! ## The header -/

theorem hdr_in_sol_aux {s : IState HS} {F : Fin HS → List ℤ} {h body : List ℤ} {B : ℕ}
    (hl : h.length = 8) (hT : F dTJ = h ++ body) (hR : ∀ X ∈ hdrRegs, F X = [])
    (hB : Bnd B h) :
    Sp hdrIn (encK s F) (encK s (hdrSt F h body)) (8 * (10000 * (B + 2))) := by
  match h, hl with
  | [a0, a1, a2, a3, a4, a5, a6, a7], _ =>
  have b : ∀ x ∈ [a0, a1, a2, a3, a4, a5, a6, a7], zsz x ≤ B := hB
  simp only [List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq] at b
  obtain ⟨b0, b1, b2, b3, b4, b5, b6, b7⟩ := b
  simp only [hdrRegs, List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq] at hR
  obtain ⟨r0, r1, r2, r3, r4, r5, r6, r7⟩ := hR
  have t0 : F dTJ = a0 :: (a1 :: a2 :: a3 :: a4 :: a5 :: a6 :: a7 :: body) := hT
  have hall := (rdH_spec (s := s) (X := rP) (by decide) (by decide) t0 b0).seq
    ((rdH_spec (X := rP1) (x := a1) (rest := a2 :: a3 :: a4 :: a5 :: a6 :: a7 :: body)
      (by decide) (by decide) (by simp) b1).seq
    ((rdH_spec (X := rK) (x := a2) (rest := a3 :: a4 :: a5 :: a6 :: a7 :: body)
      (by decide) (by decide) (by simp) b2).seq
    ((rdH_spec (X := HM) (x := a3) (rest := a4 :: a5 :: a6 :: a7 :: body)
      (by decide) (by decide) (by simp) b3).seq
    ((rdH_spec (X := HK) (x := a4) (rest := a5 :: a6 :: a7 :: body)
      (by decide) (by decide) (by simp) b4).seq
    ((rdH_spec (X := HG) (x := a5) (rest := a6 :: a7 :: body)
      (by decide) (by decide) (by simp) b5).seq
    ((rdH_spec (X := HNB) (x := a6) (rest := a7 :: body)
      (by decide) (by decide) (by simp) b6).seq
    (rdH_spec (X := HL) (x := a7) (rest := body) (by decide) (by decide) (by simp) b7)))))))
  refine (hall.congr ?_).mono (by omega)
  congr 1
  funext j
  simp only [hdrSt, update_apply, List.getD_cons_zero, List.getD_cons_succ]
  by_cases j0 : j = dTJ
  · subst j0; simp +decide
  by_cases j1 : j = rP
  · subst j1; simp +decide [r0]
  by_cases j2 : j = rP1
  · subst j2; simp +decide [r1]
  by_cases j3 : j = rK
  · subst j3; simp +decide [r2]
  by_cases j4 : j = HM
  · subst j4; simp +decide [r3]
  by_cases j5 : j = HK
  · subst j5; simp +decide [r4]
  by_cases j6 : j = HG
  · subst j6; simp +decide [r5]
  by_cases j7 : j = HNB
  · subst j7; simp +decide [r6]
  by_cases j8 : j = HL
  · subst j8; simp +decide [r7]
  simp [j0, j1, j2, j3, j4, j5, j6, j7, j8]

end J6Seg.JK

