theorem solution (k : Type) [Field k] [Finite k] (a b c h : ℕ) (ha : 0 < a)
    (hb : 0 < b) (hc : 0 < c) (hh : 0 < h) :
    Nat.card (TypeDensity.crossingResidueIdeals k a b c h) = (Nat.card k-1)*(Nat.card k)^(a*c+b*h-c-h) := by
  have hcN : c ≤ a * c := Nat.le_mul_of_pos_left c ha
  have hhN : h ≤ b * h := Nat.le_mul_of_pos_left h hb
  set N := a*c+b*h with hNdef
  let P : TypeDensity.TwoSeries k → Prop := fun F => TypeDensity.axisQuotientLength k 0 F = c ∧ TypeDensity.axisQuotientLength k 1 F = h
  have hlen : ∀ F, P F →
      Module.length (TypeDensity.TwoSeries k) (TypeDensity.TwoSeries k ⧸ (TypeDensity.monomialIdeal k a b ⊔ Ideal.span {F})) = N := by
    intro F hF
    have h5 := TypeDensity.length_double_quotient_eq (TypeDensity.TwoSeries k) (TypeDensity.monomialIdeal k a b) (Ideal.span {F})
    rw [Ideal.map_span, Set.image_singleton] at h5
    rw [← h5, TypeDensity.crossing_special_fiber_length k a b c h ha hb _
      (by rw [TypeDensity.contact_fiberT_eq_axisQuotientLength k a b ha, hF.1])
      (by rw [TypeDensity.contact_fiberX_eq_axisQuotientLength k a b hb, hF.2]), hNdef]
    push_cast; rfl
  have : Finite (IsLocalRing.ResidueField (TypeDensity.TwoSeries k)) :=
    .of_equiv _ (TypeDensity.twoSeriesResidueEquiv k).toEquiv.symm
  have hmemS : ∀ j < N+1, ((0:ℕ), j) ∈ TypeDensity.truncIndex a b (N+1) := by
    intro j hj; simp [TypeDensity.truncIndex]; omega
  have hmemS' : ∀ i < N+1, (i, (0:ℕ)) ∈ TypeDensity.truncIndex a b (N+1) := by
    intro i hi; simp [TypeDensity.truncIndex]; omega
  have hEj : ∀ j, TypeDensity.truncExponent ((0:ℕ), j) = Finsupp.single 1 j := by simp [TypeDensity.truncExponent]
  have hEi : ∀ i, TypeDensity.truncExponent (i, (0:ℕ)) = Finsupp.single 0 i := by simp [TypeDensity.truncExponent]
  let A1 : Finset (TypeDensity.truncIndex a b (N+1)) := Finset.univ.filter (fun s => s.1.1 = 0 ∧ s.1.2 < c)
  let A2 : Finset (TypeDensity.truncIndex a b (N+1)) := Finset.univ.filter (fun s => s.1.2 = 0 ∧ s.1.1 < h)
  let B : Finset (TypeDensity.truncIndex a b (N+1)) :=
    {⟨(0,c), hmemS c (by omega)⟩, ⟨(h,0), hmemS' h (by omega)⟩}
  have hA1 : A1.card = c := TypeDensity.card_truncIndex_axis_segment a b _ c Prod.fst Prod.snd ((0, ·))
    (fun _ => ⟨rfl, rfl⟩) (fun x h => Prod.ext h.symm rfl) fun j hj => hmemS j (by omega)
  have hA2 : A2.card = h := TypeDensity.card_truncIndex_axis_segment a b _ h Prod.snd Prod.fst ((·, 0))
    (fun _ => ⟨rfl, rfl⟩) (fun x h => Prod.ext rfl h.symm) fun i hi => hmemS' i (by omega)
  have hA12 : (A1 ∩ A2).card = 1 := by
    rw [Finset.card_eq_one]; refine ⟨⟨(0,0), hmemS 0 (by omega)⟩, ?_⟩
    ext ⟨⟨i, j⟩, hij⟩
    simp only [A1, A2, Finset.mem_inter, Finset.mem_filter, Finset.mem_univ, true_and,
