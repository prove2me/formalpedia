variable (s : Fin d → ℕ) [∀ i, NeZero (s i)]

/-- `e(t, a) = ∏ᵢ exp(2πi tᵢ aᵢ / sᵢ)` (from the base thread's `Conv.lean`). -/
noncomputable def ee (t a : Π i, ZMod (s i)) : ℂ := ∏ i, ZMod.stdAddChar (t i * a i)

/-- Normalized positive-sign transform `F_s⁺`. -/
noncomputable def dftP (u : ((i : Fin d) → ZMod (s i)) → ℂ) : ((i : Fin d) → ZMod (s i)) → ℂ :=
  fun k => (∏ i, (s i : ℂ))⁻¹ * ∑ j, (∏ i, (ZMod.stdAddChar (j i * k i) : ℂ)) * u j

/-- Cyclic convolution on `∏ ℤ/s_i`. -/
def cconv (u v : ((i : Fin d) → ZMod (s i)) → ℂ) : ((i : Fin d) → ZMod (s i)) → ℂ :=
  fun j => ∑ k, u k * v (j - k)

variable (t : Fin d → ℕ)

/-- `(R⁻¹ w)_j = w_{(t_i⁻¹ j_i)}`. -/
noncomputable def Rinv (w : ((i : Fin d) → ZMod (s i)) → ℂ) : ((i : Fin d) → ZMod (s i)) → ℂ :=
  fun j => w (fun i => (t i : ZMod (s i))⁻¹ * j i)

/-- The unit dilation used by `R`, as an equivalence of index sets. -/
noncomputable def dil (hcop : ∀ i, Nat.Coprime (s i) (t i)) :
    ((i : Fin d) → ZMod (s i)) ≃ ((i : Fin d) → ZMod (s i)) :=
  Equiv.piCongrRight (fun i =>
    { toFun := fun x => (t i : ZMod (s i)) * x
      invFun := fun x => (t i : ZMod (s i))⁻¹ * x
      left_inv := fun x => by
        simp only [← mul_assoc]
        rw [ZMod.inv_mul_of_unit _ ((ZMod.isUnit_iff_coprime _ _).2 (hcop i).symm), one_mul]
      right_inv := fun x => by
        simp only [← mul_assoc]
        rw [ZMod.coe_mul_inv_eq_one _ (hcop i).symm, one_mul] })

