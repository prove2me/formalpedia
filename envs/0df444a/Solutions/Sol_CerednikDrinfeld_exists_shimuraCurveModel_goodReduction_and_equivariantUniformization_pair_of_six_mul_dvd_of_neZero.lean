theorem tower_heckeAdj
    {N q q' : ℕ} [NeZero N] {r r' : ℕ} [Fact r.Prime] [Fact r'.Prime] (hrr' : r' ≠ r) (hrN : ¬ r ∣ N) (hr'N : ¬ r' ∣ N)
    (hcover : ∀ ℓ : Nat.Primes, (ℓ : ℕ) = r ∨ (ℓ : ℕ) = r' ∨ ((ℓ : ℕ) ≠ q ∧ (ℓ : ℕ) ≠ q'))
    {A : ValuationSubring (AlgebraicClosure ℚ)} {hA : A.LiesOverPrime r}
    {ad bd : ℚ} (hdef : IsDefiniteRamifiedExactlyAt (a := ad) (b := bd) r')
    (Λd Rd : Submodule ℤ ℍ[ℚ, ad, bd]) (hΛd : IsMaximalOrder Λd) (hRd : IsEichlerOrder Rd N) (hRΛd : Rd ≤ Λd)
    (nd : (ℍ[ℚ, ad, bd] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) (hnd : nd ∈ primeHeckeSet Rd r)
    (hSd : IsEichlerOrder (meetOrder Rd nd) (N * r))
    (hnormd : Submodule.conjByFiniteIdele (meetOrder Rd nd) nd = meetOrder Rd nd)
    (hsqd : ∀ x : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)),
      classSetShift _ nd (classSetShift _ nd x) = x)
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)))]
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    [DecidableEq (ClassSet (Submodule.finiteIdeleStabilizer Rd))]
    (hlawsd : ClassSetHeckeLaws N r Λd Rd nd)
    {Fbase : Type} [Field Fbase] [Algebra (AlgebraicClosure ℚ) Fbase] (𝕋 : HeckeTower.TowerData q q' Fbase)
    {S : Type} [Group S] {scalar : S →* ↥(A.decompositionSubgroup ℚ)} [Fact (A.DecompositionIsometric ℚ)]
    (σ₀ σ₁ : S) (hsc₀ : scalar σ₀ = 1) (hsc₁ : scalar σ₁ = 1) (hσ₁₁ : σ₁ * σ₁ = 1)
    {E𝒞 V𝒞 : HeckeTower.Obj q q' → Type} [∀ j, Fintype (E𝒞 j)] [∀ j, DecidableEq (E𝒞 j)] [∀ j, Fintype (V𝒞 j)] [∀ j, DecidableEq (V𝒞 j)]
    (𝒞 : ∀ j : HeckeTower.Obj q q', DegeneracyData (E𝒞 j) (V𝒞 j))
    (πEσ₀ : (E𝒞 none) → (E𝒞 none))
    (actZ : ∀ j, S →* (↥(ribbonKernel (𝒞 j)) ≃ₗ[ℤ] ↥(ribbonKernel (𝒞 j))))
    {T : HeckeTower.Obj q q' → Type} [∀ j, AddCommGroup (T j)] {galT : ∀ j, S →* AddAut (T j)}
    (𝒰f : ∀ j, EquivariantUniformization r (𝒞 j) A hA (T j) S scalar (actZ j) (galT j))
    (eE : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → (E𝒞 none))
    (e : ↥(ribbonKernel (𝒞 none)) ≃ₗ[ℤ] ↥(ribbonKernel (classSetDegeneracyData Rd nd)))
    (hshiftE : ∀ c, eE (classSetShift _ nd c) = πEσ₀ (eE c))
    (he_apply : ∀ (x : ↥(ribbonKernel (𝒞 none))) (c : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd))),
      ((e x : ↥(ribbonKernel (classSetDegeneracyData Rd nd))) : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) c =
        (x : (E𝒞 none) → ℤ) (eE c))
    (hiso : ∀ x y : ↥(ribbonKernel (𝒞 none)),
      ribbonGram (classSetDegeneracyData Rd nd) (e x) (e y) = ribbonGram (𝒞 none) x y)
    (hσ₀Z : ∀ x : ↥(ribbonKernel (𝒞 none)),
      ((actZ none σ₀ x : ↥(ribbonKernel (𝒞 none))) : (E𝒞 none) → ℤ) = fun e' => - (x : (E𝒞 none) → ℤ) (πEσ₀ e'))
    (hE3 : ∀ z : ↥(ribbonKernel (classSetDegeneracyData Rd nd)),
      e (actZ none σ₁ (e.symm z)) = heckeKernelMap (classSetHeckeData N r Λd Rd nd) ⟨r', Fact.out⟩ z)
    (μF : ∀ α : HeckeTower.Arr q q',
      DegeneracyData.FiniteHom (𝒞 (HeckeTower.dom α)) (𝒞 (HeckeTower.cod α)))
    (hHK : ∀ (ℓ : HeckeTower.AwayPrime q q') (z : ↥(ribbonKernel (classSetDegeneracyData Rd nd))),
      e ((μF (ℓ, 0)).pushforward ((μF (ℓ, 1)).pullback (e.symm z))) = heckeKernelMap (classSetHeckeData N r Λd Rd nd) ℓ.1 z)
    (hprojF : ∀ (α : HeckeTower.Arr q q') (x : ↥(ribbonKernel (𝒞 (HeckeTower.cod α))))
        (y : ↥(ribbonKernel (𝒞 (HeckeTower.dom α)))),
      ((((Additive.toMul ((𝒰f (HeckeTower.dom α)).P.Q ((μF α).pullback x) y)) : (↥(𝒰f (HeckeTower.dom α)).K)ˣ) :
          ↥(𝒰f (HeckeTower.dom α)).K) : A.valuation.Completion) =
        ((((Additive.toMul ((𝒰f (HeckeTower.cod α)).P.Q x ((μF α).pushforward y))) : (↥(𝒰f (HeckeTower.cod α)).K)ˣ) :
          ↥(𝒰f (HeckeTower.cod α)).K) : A.valuation.Completion)) :
    (pdTransport (𝒰f none).P e hiso).HeckeAdjointable (classSetHeckeData N r Λd Rd nd) := by

  have hSign : ∀ x : ↥(ribbonKernel (classSetDegeneracyData Rd nd)),
      ((heckeKernelMap (classSetHeckeData N r Λd Rd nd) ⟨r, Fact.out⟩ x :
          ↥(ribbonKernel (classSetDegeneracyData Rd nd))) : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) =
        fun c => - (x : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c) :=
    fun x => CerednikDrinfeld.heckeKernelMap_classSetHeckeData_apply_eq_neg_comp_classSetShift N r r' hrr' hrN hr'N hdef
      Λd Rd hΛd hRd hRΛd nd hSd hnd hnormd hsqd hlawsd x
  have hodd₀ := conjAct_eq_neg_shift σ₀ Rd nd e eE he_apply πEσ₀ hshiftE hσ₀Z
  intro ℓ y
  rcases hcover ℓ with h | h | ⟨h1, h2⟩
  ·
    obtain rfl : ℓ = ⟨r, Fact.out⟩ := Subtype.ext h
    refine heckeAdj_of_involutive_isometry _ (heckeKernelMap (classSetHeckeData N r Λd Rd nd) ⟨r, Fact.out⟩)
      (fun z => Subtype.ext ?_) (fun x' y' => ?_) y
    · rw [hSign, hSign]; funext c; simp [hsqd]
    · exact Q_transport_neg_shift_invariant (𝒰f none) σ₀ hsc₀ Rd nd e hiso hodd₀ x' y'
        (heckeKernelMap (classSetHeckeData N r Λd Rd nd) ⟨r, Fact.out⟩ x')
        (heckeKernelMap (classSetHeckeData N r Λd Rd nd) ⟨r, Fact.out⟩ y') (hSign x') (hSign y')
  ·
    obtain rfl : ℓ = ⟨r', Fact.out⟩ := Subtype.ext h
    exact heckeAdj_at_AL (𝒰f none) σ₁ hsc₁ hσ₁₁ e hiso
      ((heckeKernelMap (classSetHeckeData N r Λd Rd nd) ⟨r', Fact.out⟩ :
          ↥(ribbonKernel (classSetDegeneracyData Rd nd)) →ₗ[ℤ] ↥(ribbonKernel (classSetDegeneracyData Rd nd))))
      (fun z => by rw [conjAct_apply, ← hE3]) y
  ·
    let ℓ' : HeckeTower.AwayPrime q q' := ⟨ℓ, h1, h2⟩
    have hK : ∀ z : ↥(ribbonKernel (𝒞 none)),
        (μF (ℓ', 0)).pushforward ((μF (ℓ', 1)).pullback z) =
          e.symm (heckeKernelMap (classSetHeckeData N r Λd Rd nd) ℓ (e z)) := by
      intro z
      apply e.injective
      rw [LinearEquiv.apply_symm_apply, ← hHK ℓ' (e z), LinearEquiv.symm_apply_apply]
    exact heckeAdj_away (𝒞 none) (𝒰f none) (𝒞 (some ℓ')) (𝒰f (some ℓ')) (μF (ℓ', 1)) (μF (ℓ', 0))
      (hprojF (ℓ', 1)) (hprojF (ℓ', 0)) N Λd Rd nd e hiso ℓ hK y

end towerAdj
