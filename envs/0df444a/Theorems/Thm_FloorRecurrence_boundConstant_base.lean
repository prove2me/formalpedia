theorem FloorRecurrence.boundConstant_base (m : ℕ) (f : ℕ → ℝ) (C γ p : ℝ)
    (hγ : γ < 1) (hp : 0 ≤ p) (e : ℕ) (he : 0 < e) (hem : e < m) :
    f e ≤ boundConstant m f C γ * (e : ℝ) ^ p := by sorry
