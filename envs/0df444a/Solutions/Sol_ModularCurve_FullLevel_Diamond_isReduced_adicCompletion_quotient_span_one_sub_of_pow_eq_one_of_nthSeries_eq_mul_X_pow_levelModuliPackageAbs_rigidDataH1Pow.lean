theorem isReduced_adjoinRoot_quotient_span_one_sub
    (hq : 2 ≤ q) (hW₀ : maximalIdeal W₀ = Ideal.span {(q : W₀)})
    (g : (PowerSeries W₀)[X]) (hgm : g.Monic) (hgdeg : g.natDegree = q - 1)
    (hgcoeff : ∀ i < q - 1, g.coeff i ∈ maximalIdeal (PowerSeries W₀))
    (hg0 : ∃ u : PowerSeries W₀, IsUnit u ∧ g.coeff 0 = (q : PowerSeries W₀) * u)
    (ζ : AdjoinRoot g) (hζ : ζ ^ q = 1) :
    IsReduced (AdjoinRoot g ⧸ Ideal.span {1 - ζ}) := by
  classical
  haveI hSreg : IsRegularLocalRing S₀ := isRegularLocalRing_powerSeries W₀
  have hSdim : ringKrullDim S₀ = 2 := ringKrullDim_powerSeries W₀
  have hq1 : 1 ≤ q - 1 := by omega

  obtain ⟨u, hu, hgu⟩ := hg0
  have hg0' : g.coeff 0 ∉ maximalIdeal S₀ ^ 2 := by
    rw [hgu]; exact natCast_mul_not_mem_sq W₀ q hW₀ u hu
  obtain ⟨hRreg, -⟩ :=
    IsRegularLocalRing.adjoinRoot_of_monic_of_coeff_mem_maximalIdeal_of_coeff_zero_not_mem_sq
      S₀ g hgm (by rw [hgdeg]; exact hq1) (by rw [hgdeg]; exact hgcoeff) hg0'
  haveI := hRreg
  haveI hRdom : IsDomain (AdjoinRoot g) := IsRegularLocalRing.isDomain _
  have hgdeg0 : g.degree ≠ 0 := by
    rw [degree_eq_natDegree hgm.ne_zero, hgdeg]; exact_mod_cast (show q - 1 ≠ 0 by omega)
  have hofg : Function.Injective (AdjoinRoot.of g) := AdjoinRoot.of.injective_of_degree_ne_zero hgdeg0
  by_cases hζ1 : ζ = 1
  ·
    subst hζ1
    have h0 : Ideal.span {(1 : AdjoinRoot g) - 1} = ⊥ := by
      rw [sub_self]; exact Ideal.span_singleton_eq_bot.mpr rfl
    rw [h0]
    exact isReduced_of_injective (RingEquiv.quotientBot (AdjoinRoot g)) (RingEquiv.quotientBot _).injective

  have hsum : ∑ i ∈ Finset.range q, ζ ^ i = 0 := by
    have := geom_sum_mul ζ q
    rw [hζ, sub_self] at this
    exact (mul_eq_zero.mp this).resolve_right (sub_ne_zero.mpr hζ1)

  have hhm : (cycShift S₀ q).Monic := cycShift_monic _ q
  have hhdeg : (cycShift S₀ q).natDegree = q - 1 := cycShift_natDegree _ q
  have hh0 : (cycShift S₀ q).coeff 0 = (q : S₀) := cycShift_coeff_zero _ q
  have hhcoeff : ∀ i < (cycShift S₀ q).natDegree, (cycShift S₀ q).coeff i ∈ maximalIdeal S₀ := by
    intro i hi
    rw [hhdeg] at hi
    have := cycShift_coeff_mem S₀ q i hi
    exact (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (natCast_mem_maximalIdeal_powerSeries W₀ q hW₀))) this
  have hh0' : (cycShift S₀ q).coeff 0 ∉ maximalIdeal S₀ ^ 2 := by
    rw [hh0]; simpa using natCast_mul_not_mem_sq W₀ q hW₀ 1 isUnit_one
  obtain ⟨hDreg, hDdim⟩ :=
    IsRegularLocalRing.adjoinRoot_of_monic_of_coeff_mem_maximalIdeal_of_coeff_zero_not_mem_sq
      S₀ (cycShift S₀ q) hhm (by rw [hhdeg]; exact hq1) hhcoeff hh0'
  haveI := hDreg
  haveI hDdom : IsDomain (AdjoinRoot (cycShift S₀ q)) := IsRegularLocalRing.isDomain _
  haveI : UniqueFactorizationMonoid (AdjoinRoot (cycShift S₀ q)) :=
    IsRegularLocalRing.uniqueFactorizationMonoid_of_ringKrullDim_le_two _ (by rw [hDdim, hSdim])
  haveI : IsIntegrallyClosed (AdjoinRoot (cycShift S₀ q)) := inferInstance
  have hhdeg0 : (cycShift S₀ q).degree ≠ 0 := by
    rw [degree_eq_natDegree hhm.ne_zero, hhdeg]; exact_mod_cast (show q - 1 ≠ 0 by omega)
  have hofh : Function.Injective (AdjoinRoot.of (cycShift S₀ q)) :=
    AdjoinRoot.of.injective_of_degree_ne_zero hhdeg0

  have heval : Polynomial.eval₂ (↑(Algebra.ofId S₀ (AdjoinRoot g))) (ζ - 1) (cycShift S₀ q) = 0 := by
    have := cycShift_aeval S₀ (T := AdjoinRoot g) q ζ
    rw [hsum, aeval_def] at this
    exact this
  let φ : AdjoinRoot (cycShift S₀ q) →ₐ[S₀] AdjoinRoot g :=
    AdjoinRoot.liftAlgHom (cycShift S₀ q) (Algebra.ofId S₀ (AdjoinRoot g)) (ζ - 1) heval
  have hφroot : φ (AdjoinRoot.root (cycShift S₀ q)) = ζ - 1 := by
    simp [φ]

  haveI : Module.Finite S₀ (AdjoinRoot g) := Module.Finite.of_basis (AdjoinRoot.powerBasis' hgm).basis
  haveI : Module.Finite S₀ (AdjoinRoot (cycShift S₀ q)) :=
    Module.Finite.of_basis (AdjoinRoot.powerBasis' hhm).basis
  haveI : Algebra.IsIntegral S₀ (AdjoinRoot g) := Algebra.IsIntegral.of_finite _ _
  haveI : Algebra.IsIntegral S₀ (AdjoinRoot (cycShift S₀ q)) := Algebra.IsIntegral.of_finite _ _

  have hφinj : Function.Injective φ := by
    rw [← AlgHom.coe_toRingHom, RingHom.injective_iff_ker_eq_bot]
    apply Ideal.eq_bot_of_comap_eq_bot (R := S₀)
    rw [eq_bot_iff]
    intro s hs
    rw [Ideal.mem_comap, RingHom.mem_ker, AlgHom.coe_toRingHom, AlgHom.commutes] at hs
    rw [Ideal.mem_bot]
    exact hofg (by rw [map_zero]; exact hs)

  have hrank : Module.finrank S₀ (AdjoinRoot g) ≤
      Fintype.card (Fin (AdjoinRoot.powerBasis' hhm).dim) := by
    rw [Module.finrank_eq_card_basis (AdjoinRoot.powerBasis' hgm).basis, Fintype.card_fin, Fintype.card_fin,
      AdjoinRoot.powerBasis'_dim, AdjoinRoot.powerBasis'_dim, hgdeg, hhdeg]
  let v : Fin (AdjoinRoot.powerBasis' hhm).dim → AdjoinRoot g :=
    fun j => φ ((AdjoinRoot.powerBasis' hhm).basis j)
  have hv : LinearIndependent S₀ v :=
    (AdjoinRoot.powerBasis' hhm).basis.linearIndependent.map' φ.toLinearMap
      (LinearMap.ker_eq_bot.mpr hφinj)
  obtain ⟨c, hc0, hcmem⟩ := exists_smul_mem_span v hv hrank (AdjoinRoot.root g)
  have hcx : ∃ a : AdjoinRoot (cycShift S₀ q), c • AdjoinRoot.root g = φ a := by
    have hle : Submodule.span S₀ (Set.range v) ≤ LinearMap.range φ.toLinearMap := by
      rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      exact ⟨(AdjoinRoot.powerBasis' hhm).basis j, rfl⟩
    obtain ⟨a, ha⟩ := hle hcmem
    exact ⟨a, ha.symm⟩

  have hfrac : ∀ r : AdjoinRoot g, ∃ d a : AdjoinRoot (cycShift S₀ q), φ d ≠ 0 ∧ φ d * r = φ a := by
    let T : Subalgebra S₀ (AdjoinRoot g) :=
      { carrier := {r | ∃ d a : AdjoinRoot (cycShift S₀ q), φ d ≠ 0 ∧ φ d * r = φ a}
        mul_mem' := by
          rintro r₁ r₂ ⟨d₁, a₁, hd₁, h₁⟩ ⟨d₂, a₂, hd₂, h₂⟩
          refine ⟨d₁ * d₂, a₁ * a₂, by rw [map_mul]; exact mul_ne_zero hd₁ hd₂, ?_⟩
          rw [map_mul, map_mul, ← h₁, ← h₂]; ring
        add_mem' := by
          rintro r₁ r₂ ⟨d₁, a₁, hd₁, h₁⟩ ⟨d₂, a₂, hd₂, h₂⟩
          refine ⟨d₁ * d₂, d₂ * a₁ + d₁ * a₂, by rw [map_mul]; exact mul_ne_zero hd₁ hd₂, ?_⟩
          rw [map_mul, map_add, map_mul, map_mul, ← h₁, ← h₂]; ring
        algebraMap_mem' := by
          intro s
          refine ⟨1, algebraMap S₀ _ s, by rw [map_one]; exact one_ne_zero, ?_⟩
          rw [map_one, one_mul, AlgHom.commutes] }
    have hT : (⊤ : Subalgebra S₀ (AdjoinRoot g)) ≤ T := by
      rw [← AdjoinRoot.adjoinRoot_eq_top]
      refine Algebra.adjoin_le ?_
      rintro _ rfl
      obtain ⟨a, ha⟩ := hcx
      refine ⟨algebraMap S₀ _ c, a, ?_, ?_⟩
      · rw [AlgHom.commutes]
        exact fun h0 => hc0 (hofg (by rw [map_zero]; exact h0))
      · rw [AlgHom.commutes, ← ha, Algebra.smul_def]
    intro r
    exact hT (show r ∈ (⊤ : Subalgebra S₀ (AdjoinRoot g)) from Algebra.mem_top)

  have hint : ∀ r : AdjoinRoot g, ∃ p : (AdjoinRoot (cycShift S₀ q))[X],
      p.Monic ∧ p.eval₂ (φ : AdjoinRoot (cycShift S₀ q) →+* AdjoinRoot g) r = 0 := by
    intro r
    obtain ⟨p, hp, hpr⟩ := Algebra.IsIntegral.isIntegral (R := S₀) r
    refine ⟨p.map (algebraMap S₀ (AdjoinRoot (cycShift S₀ q))), hp.map _, ?_⟩
    rw [eval₂_map, AlgHom.comp_algebraMap]
    exact hpr
  have hφsurj : Function.Surjective φ :=
    surjective_of_isIntegrallyClosed (φ : AdjoinRoot (cycShift S₀ q) →+* AdjoinRoot g) hφinj hint hfrac

  let e : AdjoinRoot (cycShift S₀ q) ≃+* AdjoinRoot g := RingEquiv.ofBijective (φ : _ →+* _) ⟨hφinj, hφsurj⟩
  have hJ : Ideal.span {1 - ζ} = (Ideal.span {AdjoinRoot.root (cycShift S₀ q)}).map (e : _ →+* _) := by
    rw [Ideal.map_span, Set.image_singleton]
    rw [show (e : AdjoinRoot (cycShift S₀ q) →+* AdjoinRoot g) (AdjoinRoot.root (cycShift S₀ q)) = ζ - 1 from hφroot]
    rw [← Ideal.span_singleton_neg, neg_sub]
  have hDq : IsDomain (AdjoinRoot (cycShift S₀ q) ⧸ Ideal.span {AdjoinRoot.root (cycShift S₀ q)}) := by
    apply isDomain_adjoinRoot_quotient_span_root
    rw [hh0]
    exact isDomain_quotient_span_natCast W₀ q hW₀
  haveI : IsDomain (AdjoinRoot g ⧸ Ideal.span {1 - ζ}) :=
    MulEquiv.isDomain (AdjoinRoot (cycShift S₀ q) ⧸ Ideal.span {AdjoinRoot.root (cycShift S₀ q)})
      (Ideal.quotientEquiv _ _ e hJ).symm.toMulEquiv
  infer_instance

