private def unitsAtInfinity : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* (InfiniteAdeleRing ℚ)ˣ :=
  Units.map (RingHom.fst (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ)).toMonoidHom

private def unitsAt (v : HeightOneSpectrum (𝓞 ℚ)) : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* (v.adicCompletion ℚ)ˣ :=
  Units.map ((RestrictedProduct.evalRingHom (fun w : HeightOneSpectrum (𝓞 ℚ) => w.adicCompletion ℚ) v).comp
    (RingHom.snd (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ))).toMonoidHom

private theorem unitsAtInfinity_val (y : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    ((unitsAtInfinity y : (InfiniteAdeleRing ℚ)ˣ) : InfiniteAdeleRing ℚ) = (y : AdeleRing (𝓞 ℚ) ℚ).1 := rfl

private theorem unitsAt_val (v : HeightOneSpectrum (𝓞 ℚ)) (y : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    ((unitsAt v y : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) = (y : AdeleRing (𝓞 ℚ) ℚ).2 v := rfl

private def IsIntegralUnit (v : HeightOneSpectrum (𝓞 ℚ)) (t : (v.adicCompletion ℚ)ˣ) : Prop :=
  (t : v.adicCompletion ℚ) ∈ v.adicCompletionIntegers ℚ ∧
    ((t⁻¹ : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ) ∈ v.adicCompletionIntegers ℚ

private theorem isIntegralUnit_one (v : HeightOneSpectrum (𝓞 ℚ)) : IsIntegralUnit v 1 := by
  refine ⟨one_mem _, ?_⟩
  rw [inv_one]
  exact one_mem _

private theorem IsIntegralUnit.mul
    {v : HeightOneSpectrum (𝓞 ℚ)} {t t' : (v.adicCompletion ℚ)ˣ} (ht : IsIntegralUnit v t)
    (ht' : IsIntegralUnit v t') : IsIntegralUnit v (t * t') := by
  refine ⟨?_, ?_⟩
  · rw [Units.val_mul]
    exact mul_mem ht.1 ht'.1
  · rw [mul_inv_rev, Units.val_mul]
    exact mul_mem ht'.2 ht.2

private theorem IsIntegralUnit.inv
    {v : HeightOneSpectrum (𝓞 ℚ)} {t : (v.adicCompletion ℚ)ˣ} (ht : IsIntegralUnit v t) :
    IsIntegralUnit v t⁻¹ := by
  refine ⟨ht.2, ?_⟩
  rw [inv_inv]
  exact ht.1

private def unitIdelesTrivialAt (N : Finset (HeightOneSpectrum (𝓞 ℚ))) : Subgroup (AdeleRing (𝓞 ℚ) ℚ)ˣ where
  carrier := {y | unitsAtInfinity y = 1 ∧ (∀ v ∈ N, unitsAt v y = 1) ∧ ∀ v, IsIntegralUnit v (unitsAt v y)}
  one_mem' := by
    refine ⟨map_one _, fun v _ => map_one _, fun v => ?_⟩
    rw [map_one]
    exact isIntegralUnit_one v
  mul_mem' := by
    intro x y hx hy
    refine ⟨?_, fun v hv => ?_, fun v => ?_⟩
    · rw [map_mul, hx.1, hy.1, mul_one]
    · rw [map_mul, hx.2.1 v hv, hy.2.1 v hv, mul_one]
    · rw [map_mul]
      exact (hx.2.2 v).mul (hy.2.2 v)
  inv_mem' := by
    intro x hx
    refine ⟨?_, fun v hv => ?_, fun v => ?_⟩
    · rw [map_inv, hx.1, inv_one]
    · rw [map_inv, hx.2.1 v hv, inv_one]
    · rw [map_inv]
      exact (hx.2.2 v).inv

private theorem mem_unitIdelesTrivialAt {N : Finset (HeightOneSpectrum (𝓞 ℚ))} {y : (AdeleRing (𝓞 ℚ) ℚ)ˣ} :
    y ∈ unitIdelesTrivialAt N ↔
      unitsAtInfinity y = 1 ∧ (∀ v ∈ N, unitsAt v y = 1) ∧ ∀ v, IsIntegralUnit v (unitsAt v y) :=
  Iff.rfl

private theorem exists_finset_unitIdelesTrivialAt_subset {U : Set (AdeleRing (𝓞 ℚ) ℚ)ˣ}
    (hU : U ∈ nhds (1 : (AdeleRing (𝓞 ℚ) ℚ)ˣ)) :
    ∃ N : Finset (HeightOneSpectrum (𝓞 ℚ)), ∀ y ∈ unitIdelesTrivialAt N, y ∈ U := by
  classical
  rw [Units.isEmbedding_embedProduct.nhds_eq_comap, Filter.mem_comap] at hU
  obtain ⟨W, hW, hWU⟩ := hU
  rw [map_one] at hW
  have hW' : W ∈ nhds (((1 : AdeleRing (𝓞 ℚ) ℚ), (1 : (AdeleRing (𝓞 ℚ) ℚ)ᵐᵒᵖ)) :
      AdeleRing (𝓞 ℚ) ℚ × (AdeleRing (𝓞 ℚ) ℚ)ᵐᵒᵖ) := hW
  obtain ⟨U₁, hU₁, U₂, hU₂, hprod⟩ := mem_nhds_prod_iff.mp hW'
  have hU₂' : MulOpposite.op ⁻¹' U₂ ∈ nhds (1 : AdeleRing (𝓞 ℚ) ℚ) :=
    MulOpposite.continuous_op.continuousAt.preimage_mem_nhds (by rwa [MulOpposite.op_one])
  have hU₀ : U₁ ∩ MulOpposite.op ⁻¹' U₂ ∈
      nhds (((1 : InfiniteAdeleRing ℚ), (1 : FiniteAdeleRing (𝓞 ℚ) ℚ)) :
        InfiniteAdeleRing ℚ × FiniteAdeleRing (𝓞 ℚ) ℚ) :=
    Filter.inter_mem hU₁ hU₂'
  obtain ⟨Wi, hWi, Wf, hWf, hsub⟩ := mem_nhds_prod_iff.mp hU₀

  have hWf' := ((RestrictedProduct.isEmbedding_structureMap
      (R := fun w : HeightOneSpectrum (𝓞 ℚ) => w.adicCompletion ℚ)
      (A := fun w : HeightOneSpectrum (𝓞 ℚ) => (w.adicCompletionIntegers ℚ : Set (w.adicCompletion ℚ)))
      (𝓕 := Filter.cofinite)).continuous.continuousAt (x := 1)).preimage_mem_nhds hWf
  rw [nhds_pi, Filter.mem_pi] at hWf'
  obtain ⟨I, hI, t, ht, hIt⟩ := hWf'
  refine ⟨hI.toFinset, ?_⟩

  have hmem : ∀ y ∈ unitIdelesTrivialAt hI.toFinset, (y : AdeleRing (𝓞 ℚ) ℚ) ∈ U₁ ∩ MulOpposite.op ⁻¹' U₂ := by
    intro y hy
    obtain ⟨hyi, hyN, hyint⟩ := mem_unitIdelesTrivialAt.mp hy
    obtain ⟨z, hz⟩ := RestrictedProduct.exists_structureMap_eq_of_forall
      (fun w : HeightOneSpectrum (𝓞 ℚ) => w.adicCompletion ℚ)
      (fun w : HeightOneSpectrum (𝓞 ℚ) => (w.adicCompletionIntegers ℚ : Set (w.adicCompletion ℚ)))
      (x := (y : AdeleRing (𝓞 ℚ) ℚ).2) (fun w => (hyint w).1)
    refine hsub ⟨?_, ?_⟩
    · have h1 : ((unitsAtInfinity y : (InfiniteAdeleRing ℚ)ˣ) : InfiniteAdeleRing ℚ) = 1 := by rw [hyi, Units.val_one]
      rw [unitsAtInfinity_val] at h1
      rw [h1]
      exact mem_of_mem_nhds hWi
    · rw [← hz]
      refine hIt (Set.mem_pi.mpr fun w hw => ?_)
      have hw' : unitsAt w y = 1 := hyN w (hI.mem_toFinset.mpr hw)
      have hzw : z w = 1 := by
        have h2 : (z w).1 = (y : AdeleRing (𝓞 ℚ) ℚ).2 w := by
          rw [← hz]
          rfl
        have h3 : (z w).1 = 1 := by
          rw [h2, ← unitsAt_val, hw', Units.val_one]
        exact Subtype.ext h3
      rw [hzw]
      exact mem_of_mem_nhds (ht w)
  intro y hy
  apply hWU
  exact hprod ⟨(hmem y hy).1, (hmem y⁻¹ ((unitIdelesTrivialAt _).inv_mem hy)).2⟩

private def localIdele (v : HeightOneSpectrum (𝓞 ℚ)) : (v.adicCompletion ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ :=
  (Units.map (AdelicLevel.finIncl (𝓞 ℚ) ℚ)).comp (AdelicLevel.localUnit (𝓞 ℚ) ℚ v)

private theorem localChar_eq
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ)) (t : (v.adicCompletion ℚ)ˣ) :
    TateGlobal.localChar χ v t = χ (localIdele v t) := rfl

private theorem unitsAtInfinity_localIdele (v : HeightOneSpectrum (𝓞 ℚ)) (t : (v.adicCompletion ℚ)ˣ) :
    unitsAtInfinity (localIdele v t) = 1 := by
  apply Units.ext
  rw [unitsAtInfinity_val, Units.val_one]
  exact AdelicLevel.finIncl_apply_fst (𝓞 ℚ) ℚ _

private theorem unitsAt_localIdele_self (v : HeightOneSpectrum (𝓞 ℚ)) (t : (v.adicCompletion ℚ)ˣ) :
    unitsAt v (localIdele v t) = t := by
  apply Units.ext
  rw [unitsAt_val]
  exact AdelicLevel.localUnit_apply_self (𝓞 ℚ) ℚ v t

private theorem unitsAt_localIdele_of_ne {v w : HeightOneSpectrum (𝓞 ℚ)} (hw : w ≠ v) (t : (v.adicCompletion ℚ)ˣ) :
    unitsAt w (localIdele v t) = 1 := by
  apply Units.ext
  rw [unitsAt_val, Units.val_one]
  exact AdelicLevel.localUnit_apply_of_ne (𝓞 ℚ) ℚ v t hw

private def stripped (M : Finset (HeightOneSpectrum (𝓞 ℚ))) (y : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : (AdeleRing (𝓞 ℚ) ℚ)ˣ :=
  y * (∏ v ∈ M, localIdele v (unitsAt v y))⁻¹

private theorem apply_eq_prod_localChar_mul_apply_stripped (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (M : Finset (HeightOneSpectrum (𝓞 ℚ))) (y : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    χ y = (∏ v ∈ M, TateGlobal.localChar χ v (unitsAt v y)) * χ (stripped M y) := by
  unfold stripped
  rw [map_mul, map_inv, map_prod]
  have h : (∏ v ∈ M, TateGlobal.localChar χ v (unitsAt v y)) = ∏ v ∈ M, χ (localIdele v (unitsAt v y)) :=
    Finset.prod_congr rfl fun v _ => localChar_eq χ v _
  rw [h, mul_comm (χ y), mul_inv_cancel_left]

private theorem unitsAtInfinity_stripped (M : Finset (HeightOneSpectrum (𝓞 ℚ))) (y : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    unitsAtInfinity (stripped M y) = unitsAtInfinity y := by
  unfold stripped
  have h1 : (∏ v ∈ M, unitsAtInfinity (localIdele v (unitsAt v y))) = 1 :=
    Finset.prod_eq_one fun v _ => unitsAtInfinity_localIdele v _
  rw [map_mul, map_inv, map_prod, h1, inv_one, mul_one]

open scoped Classical in
private theorem unitsAt_stripped (M : Finset (HeightOneSpectrum (𝓞 ℚ))) (y : (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (w : HeightOneSpectrum (𝓞 ℚ)) :
    unitsAt w (stripped M y) = if w ∈ M then 1 else unitsAt w y := by
  unfold stripped
  rw [map_mul, map_inv, map_prod]
  have h : (∏ v ∈ M, unitsAt w (localIdele v (unitsAt v y))) =
      ∏ v ∈ M, (if w = v then unitsAt w y else 1) := by
    refine Finset.prod_congr rfl fun v _ => ?_
    by_cases hwv : w = v
    · subst hwv
      rw [unitsAt_localIdele_self, if_pos rfl]
    · rw [unitsAt_localIdele_of_ne hwv, if_neg hwv]
  rw [h, Finset.prod_ite_eq]
  by_cases hw : w ∈ M <;> simp [hw]

private theorem isIntegralUnit_unitsAt_stripped {M : Finset (HeightOneSpectrum (𝓞 ℚ))} {y : (AdeleRing (𝓞 ℚ) ℚ)ˣ}
    (hy : ∀ v, v ∉ M → IsIntegralUnit v (unitsAt v y)) (w : HeightOneSpectrum (𝓞 ℚ)) :
    IsIntegralUnit w (unitsAt w (stripped M y)) := by
  rw [unitsAt_stripped]
  by_cases hw : w ∈ M
  · rw [if_pos hw]
    exact isIntegralUnit_one w
  · rw [if_neg hw]
    exact hy w hw

private theorem norm_le_one_of_forall_pow (w : ℂˣ) (hw : ∀ n : ℕ, ‖((w ^ n : ℂˣ) : ℂ) - 1‖ < 1) : ‖(w : ℂ)‖ ≤ 1 := by
  by_contra hlt
  rw [not_le] at hlt
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (2 : ℝ) hlt
  have h1 := hw n
  rw [Units.val_pow_eq_pow_val] at h1
  have h2 := norm_sub_norm_le ((w : ℂ) ^ n) 1
  rw [norm_pow, norm_one] at h2
  linarith

private theorem re_pow_two_pow_gt
    (z : ℂ) (hz : ‖z‖ = 1) (k : ℕ) (hk : ‖z ^ 2 ^ k - 1‖ < 1) : 1 / 2 < (z ^ 2 ^ k).re := by
  set w := z ^ 2 ^ k with hw
  have hwn : ‖w‖ = 1 := by rw [hw, norm_pow, hz, one_pow]
  have h1 : Complex.normSq w = 1 := by rw [Complex.normSq_eq_norm_sq, hwn, one_pow]
  have h2 : Complex.normSq (w - 1) < 1 := by
    rw [Complex.normSq_eq_norm_sq]
    have h0 := norm_nonneg (w - 1)
    nlinarith
  rw [Complex.normSq_apply] at h1
  rw [Complex.normSq_apply, Complex.sub_re, Complex.sub_im, Complex.one_re, Complex.one_im] at h2
  nlinarith

private theorem one_sub_re_pow_two_pow_ge (z : ℂ) (hz : ‖z‖ = 1) (h : ∀ n : ℕ, ‖z ^ n - 1‖ < 1) (k : ℕ) :
    (3 : ℝ) ^ k * (1 - z.re) ≤ 1 - (z ^ 2 ^ k).re := by
  induction k with
  | zero => simp
  | succ k ih =>
    have hre : 1 / 2 < (z ^ 2 ^ k).re := re_pow_two_pow_gt z hz k (h _)
    have hre1 : (z ^ 2 ^ k).re ≤ 1 := by
      have := Complex.re_le_norm (z ^ 2 ^ k)
      rwa [norm_pow, hz, one_pow] at this
    have hwn : (z ^ 2 ^ k).re * (z ^ 2 ^ k).re + (z ^ 2 ^ k).im * (z ^ 2 ^ k).im = 1 := by
      rw [← Complex.normSq_apply, Complex.normSq_eq_norm_sq, norm_pow, hz, one_pow, one_pow]
    have hsq : (z ^ 2 ^ (k + 1)).re = (z ^ 2 ^ k).re * (z ^ 2 ^ k).re - (z ^ 2 ^ k).im * (z ^ 2 ^ k).im := by
      rw [pow_succ, pow_mul, sq, Complex.mul_re]
    have h3 : (0 : ℝ) ≤ 3 ^ k := pow_nonneg (by norm_num) k
    rw [hsq, pow_succ]
    nlinarith [ih, hre, hwn, hre1, h3, mul_nonneg (sub_nonneg.mpr hre1) (sub_pos.mpr hre).le,
      mul_nonneg h3 (sub_nonneg.mpr hre1)]

private theorem eq_one_of_forall_pow_norm_sub_one_lt (u : ℂˣ) (h : ∀ n : ℕ, ‖((u ^ n : ℂˣ) : ℂ) - 1‖ < 1)
    (h' : ∀ n : ℕ, ‖((u⁻¹ ^ n : ℂˣ) : ℂ) - 1‖ < 1) : u = 1 := by
  have hz0 : (u : ℂ) ≠ 0 := u.ne_zero
  have hle : ‖(u : ℂ)‖ ≤ 1 := norm_le_one_of_forall_pow u h
  have hle' : ‖(u : ℂ)⁻¹‖ ≤ 1 := by
    have := norm_le_one_of_forall_pow u⁻¹ h'
    rwa [Units.val_inv_eq_inv_val] at this
  have hz : ‖(u : ℂ)‖ = 1 := by
    have hmul : ‖(u : ℂ)‖ * ‖(u : ℂ)⁻¹‖ = 1 := by rw [← norm_mul, mul_inv_cancel₀ hz0, norm_one]
    have h0 := norm_nonneg (u : ℂ)
    have h0' := norm_nonneg (u : ℂ)⁻¹
    nlinarith
  have hpow : ∀ n : ℕ, ‖(u : ℂ) ^ n - 1‖ < 1 := fun n => by
    have := h n
    rwa [Units.val_pow_eq_pow_val] at this

  have hre : (u : ℂ).re = 1 := by
    have hre_le : (u : ℂ).re ≤ 1 := by
      have := Complex.re_le_norm (u : ℂ)
      rwa [hz] at this
    by_contra hne
    have hpos : 0 < 1 - (u : ℂ).re := sub_pos.mpr (lt_of_le_of_ne hre_le hne)
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ((1 / 2) / (1 - (u : ℂ).re)) (by norm_num : (1 : ℝ) < 3)
    have h1 := one_sub_re_pow_two_pow_ge (u : ℂ) hz hpow k
    have h2 := re_pow_two_pow_gt (u : ℂ) hz k (hpow _)
    have h3 : 1 / 2 < (3 : ℝ) ^ k * (1 - (u : ℂ).re) := by
      rwa [div_lt_iff₀ hpos] at hk
    linarith
  have him : (u : ℂ).im = 0 := by
    have h1 : Complex.normSq (u : ℂ) = 1 := by rw [Complex.normSq_eq_norm_sq, hz, one_pow]
    rw [Complex.normSq_apply, hre] at h1
    have h2 : (u : ℂ).im * (u : ℂ).im = 0 := by linarith
    exact mul_self_eq_zero.mp h2
  apply Units.ext
  rw [Units.val_one]
  exact Complex.ext (by simpa using hre) (by simpa using him)

private theorem apply_eq_one_of_forall_isUnramifiedCharAt (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (hχ : Continuous χ)
    (T : Finset (HeightOneSpectrum (𝓞 ℚ))) (hT : ∀ v, v ∉ T → TateGlobal.IsUnramifiedCharAt χ v)
    (y : (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (hyi : unitsAtInfinity y = 1) (hyT : ∀ v ∈ T, unitsAt v y = 1)
    (hyu : ∀ v, IsIntegralUnit v (unitsAt v y)) : χ y = 1 := by
  classical

  have hball : (fun u : ℂˣ => (u : ℂ)) ⁻¹' Metric.ball (1 : ℂ) 1 ∈ nhds (1 : ℂˣ) :=
    Units.continuous_val.continuousAt.preimage_mem_nhds (by simpa using Metric.ball_mem_nhds (1 : ℂ) one_pos)
  have hV : χ ⁻¹' ((fun u : ℂˣ => (u : ℂ)) ⁻¹' Metric.ball (1 : ℂ) 1) ∈ nhds (1 : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :=
    hχ.continuousAt.preimage_mem_nhds (by rwa [map_one])
  obtain ⟨N, hN⟩ := exists_finset_unitIdelesTrivialAt_subset hV
  have hsmall : ∀ s ∈ unitIdelesTrivialAt N, ‖((χ s : ℂˣ) : ℂ) - 1‖ < 1 := fun s hs => by
    have := hN s hs
    simpa [Metric.mem_ball, dist_eq_norm] using this

  rw [apply_eq_prod_localChar_mul_apply_stripped χ (N \ T) y]
  have hprod : (∏ v ∈ N \ T, TateGlobal.localChar χ v (unitsAt v y)) = 1 :=
    Finset.prod_eq_one fun v hv => hT v (Finset.mem_sdiff.mp hv).2 _ (hyu v).1 (hyu v).2
  rw [hprod, one_mul]

  have hr : stripped (N \ T) y ∈ unitIdelesTrivialAt N := by
    refine mem_unitIdelesTrivialAt.mpr ⟨?_, fun v hv => ?_, fun v => ?_⟩
    · rw [unitsAtInfinity_stripped, hyi]
    · rw [unitsAt_stripped]
      by_cases hvT : v ∈ N \ T
      · rw [if_pos hvT]
      · rw [if_neg hvT]
        exact hyT v (by simpa [Finset.mem_sdiff, hv] using hvT)
    · exact isIntegralUnit_unitsAt_stripped (fun w _ => hyu w) v
  refine eq_one_of_forall_pow_norm_sub_one_lt _ (fun n => ?_) (fun n => ?_)
  · rw [← map_pow]
    exact hsmall _ (pow_mem hr n)
  · rw [← map_inv, ← map_pow]
    exact hsmall _ (pow_mem ((unitIdelesTrivialAt N).inv_mem hr) n)

private theorem apply_eq_apply_unitsAtInfinity_mul_prod_localChar (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (hχ : Continuous χ)
    (N : Finset (HeightOneSpectrum (𝓞 ℚ))) (hN : ∀ v, v ∉ N → TateGlobal.IsUnramifiedCharAt χ v)
    (ι : (InfiniteAdeleRing ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (hι : ∀ a : (InfiniteAdeleRing ℚ)ˣ,
      ((ι a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ) = ((a : InfiniteAdeleRing ℚ), 1))
    (y : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (hy : ∀ v, v ∉ N → IsIntegralUnit v (unitsAt v y)) :
    χ y = χ (ι (unitsAtInfinity y)) * ∏ v ∈ N, TateGlobal.localChar χ v (unitsAt v y) := by
  have harch : ∀ a, unitsAtInfinity (ι a) = a := fun a => Units.ext (by rw [unitsAtInfinity_val, hι])
  have hfin : ∀ a v, unitsAt v (ι a) = 1 := fun a v => Units.ext (by
    rw [unitsAt_val, hι, Units.val_one]
    rfl)
  set y₁ : (AdeleRing (𝓞 ℚ) ℚ)ˣ := (ι (unitsAtInfinity y))⁻¹ * y with hy₁
  have hsplit : y = ι (unitsAtInfinity y) * y₁ := by rw [hy₁, mul_inv_cancel_left]
  have hy₁i : unitsAtInfinity y₁ = 1 := by rw [hy₁, map_mul, map_inv, harch, inv_mul_cancel]
  have hy₁f : ∀ v, unitsAt v y₁ = unitsAt v y := fun v => by
    rw [hy₁, map_mul, map_inv, hfin, inv_one, one_mul]
  conv_lhs => rw [hsplit, map_mul]
  congr 1
  rw [apply_eq_prod_localChar_mul_apply_stripped χ N y₁]
  have hprod : (∏ v ∈ N, TateGlobal.localChar χ v (unitsAt v y₁)) = ∏ v ∈ N, TateGlobal.localChar χ v (unitsAt v y) :=
    Finset.prod_congr rfl fun v _ => by rw [hy₁f]
  rw [hprod]
  have hone : χ (stripped N y₁) = 1 := by
    refine apply_eq_one_of_forall_isUnramifiedCharAt χ hχ N hN _ ?_ (fun v hv => ?_) ?_
    · rw [unitsAtInfinity_stripped, hy₁i]
    · rw [unitsAt_stripped, if_pos hv]
    · intro w
      refine isIntegralUnit_unitsAt_stripped (fun v hv => ?_) w
      rw [hy₁f]
      exact hy v hv
  rw [hone, mul_one]

end LanglandsTunnell.CubicInduction.CharacterComponents

