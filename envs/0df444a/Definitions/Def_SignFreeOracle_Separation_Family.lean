-- title:
--   Decorated YES graphs, projection, boundary and full-size NO graphs
-- statement:
--   Let $B$ be a connected simple $n$-regular base graph satisfying the paper's size and girth bounds. For each base vertex, attach $K$ fresh copies of each $\widehat T_{n,k}$ for $1\le k<K$. Label base vertices first and their fresh forests consecutively, then pad by isolates to $2^{m(n)}$ vertices. The resulting graph $G_n(B)$ has the explicit adjacency relation generated by these edges. The size guarantee needed to fit this construction is a conclusion in Lemma 3.9's construction package, rather than a supplied hypothesis. The constructor is total outside the eventually admissible regime by restricting the edge list to the specified label universe.
--
--   A tree vertex projects to its owning base vertex; isolates have no projection. Extended base distance to an empty set or an isolate is $+\infty$. Put $\overline U=\operatorname{clos}_{B,2\ell_{n,K}+3}(\operatorname{proj}_B U)$. Then
--   $$W=\{v:\operatorname{dist}_B(\overline U,v)\le\ell_{n,K}\}\cup\partial U,\quad \partial U=\{v\in V_B:\operatorname{dist}_B(\overline U,v)=\ell_{n,K}+1\}.$$
--   The graph $F_n(U)$ has the same full vertex set as $G_n$, retaining exactly the edges of $G_n[W]$. Base conditions contain only the original regularity, connectedness, size and girth assumptions, with no spectral or hardness assertions.
-- source:
--   Hamoudi, Le Borgne, Teganahally Sridhara, Quantum Advantage with Sign-Free Proofs: An Oracle Separation between StoqMA and MA, STOC 2027 submission #601 (October 2026), Definitions 3.7–3.10, pp. 11–12 (PDF pp. 11–12)

import Definitions.Def_SignFreeOracle_Separation_Graph
import Definitions.Def_SignFreeOracle_Separation_Trees

set_option autoImplicit false

namespace SignFreeOracle.Separation

/-- Turn an explicit edge list into a simple undirected graph. -/
def edgeGraph (N : ℕ) (edges : List (ℕ × ℕ)) : SimpleGraph (Fin N) where
  Adj u v := u ≠ v ∧ ((u.val, v.val) ∈ edges ∨ (v.val, u.val) ∈ edges)
  symm := ⟨by intro u v h; exact ⟨h.1.symm, h.2.elim Or.inr Or.inl⟩⟩
  loopless := ⟨by intro v h; exact h.1 rfl⟩

noncomputable def treeGraph (T : TreeShape) : SimpleGraph (Fin T.size) := edgeGraph T.size T.edges

noncomputable def forestSize (n : ℕ) : ℕ := ((baseForest n).map TreeShape.size).sum
noncomputable def nonisolatedSize (n NB : ℕ) : ℕ := NB * (1 + forestSize n)

/-- The nonisolated edge list, with base vertices first and fresh forests in base-vertex order. -/
noncomputable def decorationEdges (n NB : ℕ) : List (ℕ × ℕ) :=
  (List.range NB).flatMap fun u =>
    let placed := placeChildren 1 (baseForest n)
    let translate := fun j => if j = 0 then u else NB + u * forestSize n + j - 1
    placed.1.map fun e => (translate e.1, translate e.2)

/-- Actual Definition 3.7 graph on the specified full 2^m labels. The constructor is total;
for the sufficiently large admissible parameters of all construction theorems, no constructed
vertex is lost. The size assertion is an explicit conclusion of the construction package. -/
noncomputable def yesGraph (n NB : ℕ) (B : SimpleGraph (Fin NB)) :
    SimpleGraph (Fin (2 ^ bits n)) where
  Adj u v := u ≠ v ∧
    ((∃ (hu : u.val < NB) (hv : v.val < NB), B.Adj ⟨u.val, hu⟩ ⟨v.val, hv⟩) ∨
      (u.val, v.val) ∈ decorationEdges n NB ∨ (v.val, u.val) ∈ decorationEdges n NB)
  symm := ⟨by
    intro u v h
    refine ⟨h.1.symm, ?_⟩
    rcases h.2 with ⟨hu, hv, hb⟩ | he | he
    · exact Or.inl ⟨hv, hu, hb.symm⟩
    · exact Or.inr (Or.inr he)
    · exact Or.inr (Or.inl he)⟩
  loopless := ⟨by intro v h; exact h.1 rfl⟩

/-- Source assumptions on B, without any spectral or algorithmic conclusions. -/
noncomputable def BaseConditions (n NB : ℕ) (B : SimpleGraph (Fin NB)) : Prop :=
  B.Connected ∧ (∀ v, Nat.card {u : Fin NB // B.Adj v u} = n) ∧
  (2 : ℝ) ^ ((n : ℝ) ^ 3 * (logN n) ^ 2) ≤ NB ∧
  (NB : ℝ) ≤ (2 : ℝ) ^ (2 * (n : ℝ) ^ 3 * (logN n) ^ 2) ∧
  GirthAtLeast B (100 * (n : ℝ) ^ 2 * Real.sqrt n * logN n)

/-- Projection is absent for padded isolated vertices. -/
noncomputable def baseProjection (n NB : ℕ) (v : Fin (2 ^ bits n)) : Option (Fin NB) :=
  if h : v.val < NB then some ⟨v.val, h⟩
  else if v.val < nonisolatedSize n NB then
    let j := (v.val - NB) / forestSize n
    if hj : j < NB then some ⟨j, hj⟩ else none
  else none

/-- Base-distance to a set, using extended distances; the empty infimum is +infinity. -/
noncomputable def baseDistance (n NB : ℕ) (B : SimpleGraph (Fin NB))
    (S : Set (Fin NB)) (v : Fin (2 ^ bits n)) : ℕ∞ :=
  match baseProjection n NB v with
  | none => ⊤
  | some w => ⨅ u : S, B.edist u.val w

noncomputable def seedClosure (n NB : ℕ) (B : SimpleGraph (Fin NB))
    (U : Set (Fin (2 ^ bits n))) : Set (Fin NB) :=
  closure B (2 * depth n (Nat.sqrt n) + 3)
    {u | ∃ v ∈ U, baseProjection n NB v = some u}

noncomputable def boundary (n NB : ℕ) (B : SimpleGraph (Fin NB))
    (U : Set (Fin (2 ^ bits n))) : Set (Fin (2 ^ bits n)) :=
  {v | v.val < NB ∧ baseDistance n NB B (seedClosure n NB B U) v =
    (depth n (Nat.sqrt n) + 1 : ℕ)}

noncomputable def retained (n NB : ℕ) (B : SimpleGraph (Fin NB))
    (U : Set (Fin (2 ^ bits n))) : Set (Fin (2 ^ bits n)) :=
  {v | baseDistance n NB B (seedClosure n NB B U) v ≤ (depth n (Nat.sqrt n) : ℕ)} ∪
    boundary n NB B U

/-- Definition 3.10 keeps the full YES vertex set and deletes every edge outside W. -/
noncomputable def noGraph (n NB : ℕ) (B : SimpleGraph (Fin NB))
    (U : Set (Fin (2 ^ bits n))) : SimpleGraph (Fin (2 ^ bits n)) where
  Adj u v := (yesGraph n NB B).Adj u v ∧ u ∈ retained n NB B U ∧ v ∈ retained n NB B U
  symm := ⟨by intro u v h; exact ⟨h.1.symm, h.2.2, h.2.1⟩⟩
  loopless := ⟨by intro v h; exact (yesGraph n NB B).loopless.irrefl v h.1⟩

end SignFreeOracle.Separation


