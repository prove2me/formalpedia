/-!
# Section 6 — Averaged Slice Error Bounds: Successor Outputs

This module packages recursive answer-valued slice measurements and the final
self-improvement-to-main-induction error comparisons.
-/

@[expose] public section

open LIDT.MIPStarRE.LDT.MainInductionStep

open MIPStarRE.LDT
open scoped MatrixOrder

universe uι uF

variable {ι : Type uι} [Fintype ι] [DecidableEq ι]

theorem solution
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters)
    [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (strategy : _root_.LIDT.MIPStarRE.LDT.AnswerSymStrat params.next ι)
    (eps delta gamma : _root_.LIDT.MIPStarRE.LDT.Error)
    (k : ℕ)
    (hgood : strategy.IsGood eps delta gamma)
    (hsmall : _root_.LIDT.MIPStarRE.LDT.MainInductionStep.mainInductionError params.next k eps delta gamma < 1)
    (heps_le_one : eps ≤ 1) (hdelta_le_one : delta ≤ 1)
    (hdq_le_q : params.d ≤ params.q) :
    _root_.LIDT.MIPStarRE.LDT.MainInductionStep.selfImprovementInInductionError params.next eps delta gamma ≤
      _root_.LIDT.MIPStarRE.LDT.MainInductionStep.mainInductionNu params.next k eps delta gamma := by
  have heps_nonneg := _root_.LIDT.MIPStarRE.LDT.answer_eps_nonneg_of_isGood params.next strategy hgood
  have hdelta_nonneg := _root_.LIDT.MIPStarRE.LDT.answer_delta_nonneg_of_isGood params.next strategy hgood
  have hgamma_nonneg := _root_.LIDT.MIPStarRE.LDT.answer_gamma_nonneg_of_isGood params.next strategy hgood
  have hratio_le_one := _root_.LIDT.MIPStarRE.LDT.MainInductionStep.dq_ratio_le_one params hdq_le_q
  have hthree := _root_.LIDT.MIPStarRE.LDT.MainInductionStep.answer_three_le_k_sq_mul_next_m_of_hsmall params strategy hgood hsmall
  have hratio_nonneg : 0 ≤ ((params.d : _root_.LIDT.MIPStarRE.LDT.Error) / (params.q : _root_.LIDT.MIPStarRE.LDT.Error)) := by
    positivity
  calc
    _root_.LIDT.MIPStarRE.LDT.MainInductionStep.selfImprovementInInductionError params.next eps delta gamma
      = 3000 * (params.next.m : _root_.LIDT.MIPStarRE.LDT.Error) *
          (Real.rpow eps (1 / (32 : _root_.LIDT.MIPStarRE.LDT.Error)) +
            Real.rpow delta (1 / (32 : _root_.LIDT.MIPStarRE.LDT.Error)) +
            Real.rpow (((params.d : _root_.LIDT.MIPStarRE.LDT.Error) / (params.q : _root_.LIDT.MIPStarRE.LDT.Error))) (1 / (32 : _root_.LIDT.MIPStarRE.LDT.Error))) := by
          simp [_root_.LIDT.MIPStarRE.LDT.MainInductionStep.selfImprovementInInductionError]
    _ ≤ 3000 * (params.next.m : _root_.LIDT.MIPStarRE.LDT.Error) *
          (Real.rpow eps (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
            Real.rpow delta (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
            Real.rpow (((params.d : _root_.LIDT.MIPStarRE.LDT.Error) / (params.q : _root_.LIDT.MIPStarRE.LDT.Error))) (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error))) := by
          gcongr
          · exact Real.rpow_le_rpow_of_exponent_ge' heps_nonneg heps_le_one (by positivity)
              (by norm_num : (1 / (1024 : Error)) ≤ 1 / (32 : Error))
          · exact Real.rpow_le_rpow_of_exponent_ge' hdelta_nonneg hdelta_le_one (by positivity)
              (by norm_num : (1 / (1024 : Error)) ≤ 1 / (32 : Error))
          · exact Real.rpow_le_rpow_of_exponent_ge' hratio_nonneg hratio_le_one (by positivity)
              (by norm_num : (1 / (1024 : Error)) ≤ 1 / (32 : Error))
    _ ≤ 1000 * ((k : _root_.LIDT.MIPStarRE.LDT.Error) ^ (2 : ℕ)) * ((params.next.m : _root_.LIDT.MIPStarRE.LDT.Error) ^ (2 : ℕ)) *
          (Real.rpow eps (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
            Real.rpow delta (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
            Real.rpow (((params.d : _root_.LIDT.MIPStarRE.LDT.Error) / (params.q : _root_.LIDT.MIPStarRE.LDT.Error))) (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error))) := by
          have hcoef :
              3000 * (params.next.m : _root_.LIDT.MIPStarRE.LDT.Error) ≤
                1000 * ((k : _root_.LIDT.MIPStarRE.LDT.Error) ^ (2 : ℕ)) * ((params.next.m : _root_.LIDT.MIPStarRE.LDT.Error) ^ (2 : ℕ)) := by
            nlinarith [hthree]
          have hsum_nonneg :
              0 ≤ Real.rpow eps (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
                    Real.rpow delta (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
                    Real.rpow (((params.d : _root_.LIDT.MIPStarRE.LDT.Error) / (params.q : _root_.LIDT.MIPStarRE.LDT.Error)))
                      (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) := by
            exact add_nonneg
              (add_nonneg (Real.rpow_nonneg heps_nonneg _)
                (Real.rpow_nonneg hdelta_nonneg _))
              (Real.rpow_nonneg hratio_nonneg _)
          exact mul_le_mul_of_nonneg_right hcoef hsum_nonneg
    _ ≤ _root_.LIDT.MIPStarRE.LDT.MainInductionStep.mainInductionNu params.next k eps delta gamma := by
          have hgamma_root_nonneg : 0 ≤ Real.rpow gamma (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) :=
            Real.rpow_nonneg hgamma_nonneg (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error))
          have hsum_le :
              Real.rpow eps (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
                  Real.rpow delta (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
                  Real.rpow (((params.d : _root_.LIDT.MIPStarRE.LDT.Error) / (params.q : _root_.LIDT.MIPStarRE.LDT.Error))) (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) ≤
                Real.rpow eps (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
                  Real.rpow delta (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
                  Real.rpow gamma (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) +
                  Real.rpow (((params.d : _root_.LIDT.MIPStarRE.LDT.Error) / (params.q : _root_.LIDT.MIPStarRE.LDT.Error))) (1 / (1024 : _root_.LIDT.MIPStarRE.LDT.Error)) := by
            nlinarith [hgamma_root_nonneg]
          have hcoef_nonneg :
              0 ≤ 1000 * ((k : _root_.LIDT.MIPStarRE.LDT.Error) ^ (2 : ℕ)) * ((params.next.m : _root_.LIDT.MIPStarRE.LDT.Error) ^ (2 : ℕ)) := by
            positivity
          have hmul := mul_le_mul_of_nonneg_left hsum_le hcoef_nonneg
          simpa [_root_.LIDT.MIPStarRE.LDT.MainInductionStep.mainInductionNu, _root_.LIDT.MIPStarRE.LDT.Parameters.next, mul_assoc, mul_left_comm, mul_comm] using hmul
