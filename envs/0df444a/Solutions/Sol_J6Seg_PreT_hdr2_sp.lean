theorem spA' (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {A : ℕ} (hA : 2 ≤ A)
    (hv : VB v A) {i : Fin HS} (hi : i ∈ rg) {e : Ex HS} (he : InRg e) (hp : Poly e = true)
