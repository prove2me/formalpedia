-- title:
--   Lemma 2 — bounded iterates keep $(\lambda_k)$ and $(\theta_k)$ bounded and separated from 0
-- statement:
--   Let $\mathcal E$ be a finite-dimensional real inner product space, let $g$ satisfy (C2), and let $F$ be Lipschitz on every bounded subset of $\operatorname{dom} g$. Consider a run of Algorithm 1 with stepsizes $(\lambda_k)$, ratios $(\theta_k)$ and iterates $(z^k)$. If $(z^k)$ is bounded, then there are constants $0<c\le C$ and $0<c'\le C'$ with
--   $$c\le\lambda_k\le C \quad\text{and}\quad c'\le\theta_k\le C'\qquad\text{for all } k\ge0.$$
--
--   The lemma shows that the adaptive stepsizes, which approximate an inverse local Lipschitz constant of $F$, do not degenerate along bounded runs; this is what turns the energy inequality (27) into convergence.
--
--   **Formalization Note** The paper's Lemma 2 carries no explicit hypothesis; it is stated under the standing assumptions of §2.1 ("for our purposes, the locally Lipschitz-continuity of $F$ is sufficient") and (C2). The Lipschitz hypothesis is the one-constant-per-bounded-subset-of-$\operatorname{dom} g$ form used in the proof; it coincides with local Lipschitz continuity when $\operatorname{dom} g$ is closed.
-- source:
--   Malitsky, Golden Ratio Algorithms for Variational Inequalities, preprint (Optimization Online 6598, 2018), p. 6, Lemma 2

import Mathlib
import Definitions.Def_GoldenRatioVI_Explicit_viProblem
import Definitions.Def_GoldenRatioVI_Explicit_egraalRun

namespace GoldenRatioVI.Explicit

/-- Lemma 2 of Malitsky (p. 6): if the sequence `(z^k)` generated by Algorithm 1 is bounded,
then both `(λ_k)` and `(θ_k)` are bounded and separated from `0`. Standing assumptions of §2.1:
`g` satisfies (C2) and `F` is Lipschitz on bounded subsets of `dom g`. -/
theorem steps_bounded_below {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] (g : E → EReal) (F : E → E) (ϕ lamBar : ℝ)
    (z zbar : ℕ → E) (lam theta : ℕ → ℝ)
    (hg : IsProperConvexLSC g) (hL : IsLipschitzOnBoundedDom g F)
    (hrun : IsEGRAALRun g F ϕ lamBar z zbar lam theta)
    (hz : Bornology.IsBounded (Set.range z)) :
    (∃ C : ℝ, ∀ k, lam k ≤ C) ∧ (∃ c : ℝ, 0 < c ∧ ∀ k, c ≤ lam k) ∧
    (∃ C : ℝ, ∀ k, theta k ≤ C) ∧ (∃ c : ℝ, 0 < c ∧ ∀ k, c ≤ theta k) := by sorry

end GoldenRatioVI.Explicit
