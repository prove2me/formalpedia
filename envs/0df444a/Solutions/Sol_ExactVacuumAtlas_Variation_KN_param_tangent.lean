/-! ### Tangents and on-shell families -/

/-- Every admissible family has its componentwise parameter derivative as a genuine tangent. -/
theorem isTangent_paramTangent {g ginv : ℝ → Metric n} {F : ℝ → TwoForm n} {W : Set (ℝ × Pt n)}
    (hfam : FamilyData g ginv F W) : IsTangent g F W (paramTangent g) (paramTangent F) where
  metric _ hy i j := hasDerivAt_param_of_joint (Φ := fun ε => g ε i j) hfam.isOpen (hfam.smooth i j) hy
  field _ hy i j := hasDerivAt_param_of_joint (Φ := fun ε => F ε i j) hfam.isOpen (hfam.smooth_F i j) hy

/-- On-shell family for `E` (only `E = 0` on `W` is used): `LE(h, f) = 0` on the slice. -/
theorem linEinstein_eq_zero_of_onShell {g ginv : ℝ → Metric 4} {F : ℝ → TwoForm 4} {W : Set (ℝ × Pt 4)}
    {h : Metric 4} {f : TwoForm 4} (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f)
    (hE : ∀ p ∈ W, ∀ a b, einsteinMaxwell (g p.1) (ginv p.1) (F p.1) a b p.2 = 0)
    {x : Pt 4} (hx : ((0 : ℝ), x) ∈ W) (a b : Fin 4) :
    linEinstein (g 0) (ginv 0) (F 0) h f a b x = 0 :=
  eq_zero_of_hasDerivAt_onShell hfam.isOpen hx (hfam.bridge_einstein ht hx a b)
    fun ε hε => hE (ε, x) hε a b

