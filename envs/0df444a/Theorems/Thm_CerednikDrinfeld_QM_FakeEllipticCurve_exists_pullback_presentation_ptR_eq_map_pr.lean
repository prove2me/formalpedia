    (φ : S →ₐ[C] S')
    (hS : IsNilpotent (algebraMap 𝒪 S π)) (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp χC)
