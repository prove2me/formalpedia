theorem NLogN.KIL.fwdP_spec (t : IState HS) (xs : List ℤ) (P q M B Bb : ℕ) (R L1 L2 L3 L4 : List Item)
    (hlen : xs.length = P * q * M * B) (hb : Bnd Bb xs)
    (hB1 : 1 ≤ B) (hM1 : 1 ≤ M) (hq1 : 1 ≤ q) (hP1 : 1 ≤ P)
    (hV : zsz ((P * (q * (M * B)) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = ints xs ++ R) (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int q :: L2)
    (h3 : t.G 3 = .int M :: L3) (h4 : t.G 4 = .int B :: L4) :
    fwdP.ok t ∧ fwdP.run t = t.upd 0 (ints (AModel.pull [P, q, M, B] [P, M, q, B] gS 0 xs) ++ R) ∧
      fwdP.cost t ≤ cMove P q M B Bb := by sorry
