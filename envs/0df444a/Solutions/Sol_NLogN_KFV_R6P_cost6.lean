namespace EV

variable {st : IState HS} {B : ℕ}

theorem congr {st' : IState HS} {e : Ex HS} {v : ℤ} (h : EV st B e v)
    (hG : ∀ r ∈ e.regs, st.G r = st'.G r) : EV st' B e v := by
