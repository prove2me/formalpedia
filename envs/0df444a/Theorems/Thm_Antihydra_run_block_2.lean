-- title:
--   Antihydra: steps 50000–75000 keep the counter nonnegative
-- statement:
--   Let $a_0 = 8$, $a_{n+1} = \lfloor 3a_n/2 \rfloor$, and let $b_n$ be the Antihydra counter ($b_0 = 0$, $b_{n+1} = b_n + 2$ if $a_n$ is even, $b_n - 1$ if $a_n$ is odd). This lemma states that starting from the state $(a_{50000}, b_{50000}) = (A, 24961)$, where $A$ is the 8806-digit integer written in the formal statement, the simulator `AntihydraRun.run` performs 25000 steps without the counter ever becoming negative, and ends in the state $(a_{75000}, b_{75000}) = (A', 37662)$ given explicitly in the formal statement.
--
--   It is block 2 of 4 in a finite verification that $b_n \ge 0$ for all $n \le 100000$, a bounded case of the open Antihydra problem. It is a pure computation, checkable by kernel evaluation.
-- source:
--   https://github.com/google-deepmind/formal-conjectures/blob/main/FormalConjectures/Other/BeaverMathOlympiad.lean (Antihydra)

import Definitions.Def_AntihydraRun

namespace Antihydra
theorem run_block_2 :
    AntihydraRun.run 25000  24961 =
      some (, 37662) := by
  sorry
end Antihydra
