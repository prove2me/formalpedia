theorem RecRep_unique {r F : ℕ} {a b : List GI} {xs : List (Fin r → ℂ)} (ha : RecRep r F a xs)
    (hb : RecRep r F b xs) : a = b := by
  apply List.ext_getElem (ha.1.trans hb.1.symm)
  intro i h1 h2
  have hr : 0 < r := by
    rcases Nat.eq_zero_or_pos r with h | h
    · have e1 := ha.1
      simp only [h, Nat.mul_zero] at e1
      omega
    · exact h
  have hi : i / r * r + i % r = i := (Nat.div_add_mod' i r)
  have hj : i / r < xs.length := by
    have h1 := h1; rw [ha.1] at h1
    exact (Nat.div_lt_iff_lt_mul hr).2 h1
  have e1 := ha.2 (i / r) ⟨i % r, Nat.mod_lt _ hr⟩ hj
  have e2 := hb.2 (i / r) ⟨i % r, Nat.mod_lt _ hr⟩ hj
  simp only [hi] at e1 e2
  rw [← e2, List.getD_eq_getElem _ _ h1, List.getD_eq_getElem _ _ h2] at e1
  have hre := congrArg Complex.re e1
  have him := congrArg Complex.im e1
  simp [NLogN.KFB.toC] at hre him
  exact Prod.ext hre him

@[simp] theorem o0_zero (v : List ℤ) : o0 v 0 = v := by simp [o0]

/-- The managed part `o0 v` on top of the frame `fG` (with `fG 0 = []`). -/
theorem encK_o0 (s : IState HS) (fG : Fin HS → List ℤ) (v : List ℤ) :
    NLogN.KIL.encK (NLogN.KIL.encK s fG) (o0 v) = NLogN.KIL.encK s (Function.update fG 0 (v ++ fG 0)) := by
  rw [encK_encK]
  congr 1
  funext j
  by_cases h : j = 0
  · subst h; simp
  · simp [o0_ne v h, h]

section Layer

variable {r : ℕ}

variable {Ctx Ctx' : IState HS → Prop}

theorem LayerU.ctx {code : IStmt HS Pp} {T : List (Fin r → ℂ) → List (Fin r → ℂ)} {N p W c : ℕ}
    (h : LayerU I iprog Ctx code T N p W c) (hC : ∀ s, Ctx' s → Ctx s) :
    LayerU I iprog Ctx' code T N p W c :=
  fun s hs => h s (hC s hs)

theorem LayerU.congrT {code : IStmt HS Pp} {T T' : List (Fin r → ℂ) → List (Fin r → ℂ)}
    {N p W c : ℕ} (h : LayerU I iprog Ctx code T N p W c)
    (hT : ∀ xs, xs.length = N → T xs = T' xs) : LayerU I iprog Ctx code T' N p W c := by
  intro s hs zs l xs hx hl hb hd
  obtain ⟨zs', h1, h2, h3, h4, h5⟩ := h s hs zs l xs hx hl hb hd
  rw [hT xs hl] at h1 h3 h4
  exact ⟨zs', h1, h2, h3, h4, h5⟩

theorem LayerU.comp {c1 c2 : IStmt HS Pp} {T1 T2 : List (Fin r → ℂ) → List (Fin r → ℂ)}
    {N p W k1 k2 : ℕ} (h1 : LayerU I iprog Ctx c1 T1 N p W k1)
    (h2 : LayerU I iprog Ctx c2 T2 N p W k2) :
    LayerU I iprog Ctx (.seq c1 c2) (T2 ∘ T1) N p W (k1 + k2) := by
  intro s hs zs l xs hx hl hb hd
  obtain ⟨zs1, a1, b1, l1, d1, r1⟩ := h1 s hs zs l xs hx hl hb hd
  obtain ⟨zs2, a2, b2, l2, d2, r2⟩ := h2 s hs zs1 l (T1 xs) a1 l1 b1 d1
  exact ⟨zs2, a2, b2, l2, d2, r1.seq r2⟩

