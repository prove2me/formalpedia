-- Source module: Solutions.KFWWrap
/-!
# KFW: a uniform program on one role

`wrapQ W w ρ ρE U`: swap role `w` to the front, run `U` on the first segment, level the other
roles by `2^e` (the shift read from `ρE`), swap back.  The role length is read from `ρ`.

**`rImplQ_onRole`**: the uniform analogue of `KFN.rImplI_onRole`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- Run `U` on role `w`. -/
def wrapQ (W w : ℕ) (ρ ρE : Fin HS) (U : IStmt HS Pp) : IStmt HS Pp :=
  .seq (fcode (swapsG ρ (NLogN.KFN.swL w))) (.seq U (.seq (fcode (levG W ρ ρE)) (fcode (swapsG ρ (NLogN.KFN.swL w)))))

/-- Cost of the uniform wrapper. -/
def cWrapQ (W L Z e dw : ℕ) (cost : ℕ → ℕ) (w : ℕ) : ℕ :=
  cost w + 400 * ((W + 2) * cAtom (w + dw + (e + 2) * W) e L W Z + 3 + 3 * (W * Xp Z))

/-- The registers of a wrapper: role length `L` in `ρ`, `2^e` in `ρE`. -/
structure WReg (σ : Fin HS → Option ℤ) (ρ ρE : Fin HS) (L e : ℕ) : Prop where
  cl : SClean σ
  off : OffG σ
  l : σ ρ = some (L : ℤ)
  e : σ ρE = some ((2 : ℤ) ^ e)

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]
variable {Q : IState HS → Prop} {lo hi : ℕ}

end NLogN.KFW

end

section
-- Source module: Solutions.KFWPhase
/-!
# KFW: the uniform phase pass

`KFN.phL R0 t B u aE` builds its exponent table by `t` doublings `dblP ε_k` with literal
`ε_k = aE k mod 4` (`tblP`, unrolled `t` times).  Here:

* `dblU εE`: push `ε` computed by an expression `εE` (reading the loop counter `cT` and
  registers of the background), one doubling reading `ε` from `xE`, pop;
* `tblU ρt εE`: a counted loop over `k < t` (`t` read from `ρt`) of `dblU εE`
  (**`tblU_fsp`**, via `FSp.repSum`);
* `phLU ρR0 ρt ρB ρu ρV εE`: the whole pass with `R0`, `t`, `B`, `u mod 4` and `2 B R0 2^t`
  read from registers (**`phLU_fsp`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFN

/-- Counter of the table loop. -/
abbrev cT : Fin HS := 46
/-- The current doubling exponent. -/
abbrev xE : Fin HS := 47

/-- `dblP` with the exponent read from `xE`. -/
def dblX : RS :=
  .seq (NLogN.mvK NLogN.KFG.xA NLogN.KFG.xB NLogN.KFB.c1 (.reg xN))
  (.seq (.rep NLogN.KFB.c1 (.reg xN) (.seq (.push NLogN.KFG.xA (.rem (.add (.reg NLogN.KFG.xB) (.reg NLogN.KFW.xE)) (.lit 4)))
    (.seq (.push NLogN.KFG.xC (.reg NLogN.KFG.xB)) (.pop NLogN.KFG.xB))))
  (.seq (NLogN.mvK NLogN.KFG.xC NLogN.KFG.xD NLogN.KFB.c1 (.reg xN)) (.seq (NLogN.mvK NLogN.KFG.xD NLogN.KFG.xA NLogN.KFB.c1 (.reg xN))
  (.asg xN (.add (.reg xN) (.reg xN))))))

/-- The substitution `xE ↦ ε`. -/
def σE (ε : ℤ) : Fin HS → Option ℤ := fun i => if i = NLogN.KFW.xE then some ε else none

/-- One doubling with the exponent computed by `εE`. -/
def dblU (εE : Ex HS) : RS := .seq (.push NLogN.KFW.xE εE) (.seq dblX (.pop NLogN.KFW.xE))

/-- The iteration index of the table loop (a binary counter, readable by `εE`; the loop counter
`cT` itself is unary in the compiled code and must not be read by the body). -/
abbrev kS : Fin HS := 48

/-- One table step: a doubling, then `kS += 1`. -/
def bodyU (εE : Ex HS) : RS := .seq (dblU εE) (.asg NLogN.KFW.kS (.add (.reg NLogN.KFW.kS) (.lit 1)))

/-- The table loop. -/
def tblU (ρt : Fin HS) (εE : Ex HS) : RS :=
  .seq (.push NLogN.KFW.kS (.lit 0)) (.seq (.rep NLogN.KFW.cT (.reg ρt) (bodyU εE)) (.pop NLogN.KFW.kS))

/-- The exponent expression computes the doubling exponents: in iteration `k` (the index `k` on
`kS`, the registers of `εE` other than `kS` free in the managed state) it evaluates to
`aE k mod 4`, with values of at most `Bε` bits. -/
def EpsOK (s : IState HS) (εE : Ex HS) (t : ℕ) (aE : ℕ → ℕ) (Bε : ℕ) : Prop :=
  εE.Clean ∧ ∀ k < t, ∀ g : Fin HS → List ℤ, g NLogN.KFW.kS = [(k : ℤ)] →
    (∀ j ∈ εE.regs, j ≠ NLogN.KFW.kS → g j = []) →
    εE.ok (NLogN.KIL.encK s g) ∧ εE.eval (NLogN.KIL.encK s g) = ((aE k % 4 : ℕ) : ℤ) ∧ εE.Bnd (NLogN.KIL.encK s g) Bε

/-- Per-iteration cost of the table loop. -/
def cTbl (Xε T0 Z k : ℕ) : ℕ := Xε + 400 * cDbl (T0 * 2 ^ k) Z + 10000 * (Z + 2)

/-! ## The whole pass -/

/-- Stacks touched by the fixed parts of the phase pass. -/
def pT : List (Fin HS) := [0, 31, 35, 36, 37, 42, 43, 44, 45, 46, 47, 48, 55]

/-- **The uniform phase pass.** -/
def phLU (ρR0 ρt ρB ρu ρV : Fin HS) (εE : Ex HS) : RS :=
  .seq (.rep NLogN.KFB.c1 (.reg ρR0) (.push KFG.xA (.reg ρu)))
  (.seq (.push xN (.reg ρR0))
  (.seq (tblU ρt εE)
  (.seq (.rep NLogN.KFN.cO (.reg ρB) blkP)
  (.seq (NLogN.mvK KFG.xA NLogN.KFG.xB NLogN.KFB.c1 (.reg xN))
  (.seq (.rep NLogN.KFB.c1 (.reg xN) (.pop NLogN.KFG.xB))
  (.seq (.asg xN (.reg ρV))
  (.seq (NLogN.mvK qO 0 NLogN.KFB.c1 (.reg xN)) (.pop xN))))))))

/-- The registers of the phase pass. -/
structure PReg (σ : Fin HS → Option ℤ) (ρR0 ρt ρB ρu ρV : Fin HS) (R0 t B u : ℕ) : Prop where
  cl : SClean σ
  off : ∀ i ∈ NLogN.KFW.pT, σ i = none
  r0 : σ ρR0 = some (R0 : ℤ)
  lt : ∀ i v, σ i = some v → i.val < 56
  tt : σ ρt = some (t : ℤ)
  b : σ ρB = some (B : ℤ)
  u : σ ρu = some ((u % 4 : ℕ) : ℤ)
  v : σ ρV = some ((2 * (B * (R0 * 2 ^ t)) : ℕ) : ℤ)

/-- Cost of the uniform phase pass. -/
def cPhU (w V t B Z R0 Xε : ℕ) : ℕ :=
  400 * cPhL w V t B Z + 400 * (120000 * (R0 * 2 ^ t) + t * (10000 * (Z + 2) + 20000)) +
    t * Xε + 1000 * (Z + 2) + 20000 + cRep t

end NLogN.KFW

namespace NLogN.KFW
open IntMul KIL KFD KFB KFG KFN

end NLogN.KFW

end

section
-- Source module: Solutions.KFWPhSem
/-!
# KFW: the uniform phase pass as a selected-bit operator

**`sImplQ_phase`**: the uniform pass `phLU` (registers `PReg`, exponent expression `εE` with
`EpsOK` for `aEof pos a'` in every admissible background) implements the diagonal phase
`x ↦ i^{u + Σ a'_i x_i}`, as `KFN.sImpl_phase`, at cost `cPhU`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFN Complex

/-- The per-iteration exponent cost of the uniform phase pass. -/
def xPh (εE : Ex HS) (Bε Z : ℕ) : ℕ :=
  (εE.size + 1) * 10 ^ 7 * (Bε + 2) ^ 2 + (2 * Bε + 2) + 10000 * (Z + 2)

end NLogN.KFW

end

section
-- Source module: Solutions.KFWRowIface
/-!
# KFW: the uniform row-addition interface `RowU` (uniform Lemma 13, as the level procedure needs it)

The uniform Prop 14 level procedure performs the row additions `Pm i j` of the network
`complexIface` (label dimension `mC = 100³`) on the bits `Fin mC × Fin (mC^k)` of a node, laid out
at the descending stride-`K` positions

  `posR K e k (a, c) = e - K (c + mC^k a)`   (`AffK2` form, top chunk below `t`),

with record strides `2^{pos} · S0` on `n = B · 2^t · S0` records of `r` Gaussian entries.

**Parameters** are read at run time from ten background registers (tops of the stacks
`rowR q = 36 + q`, read-only for the caller's purposes; the callee may copy them):

  `[mC^k, K, e, t, S0, B, r, H, i, j]`

(`H` is a width bound: the data has width `w ≤ H`; the cost may be in terms of `H`.)

**`RowU Isym tbl rowC Kc`**: the single fixed code `rowC` implements `Pm i j` (scale and width
unchanged) on every admissible parameter set, as an `SImplQ` with background predicate
`rowQ …` (the registers hold the parameters), window `0 ≤ w ≤ H`, at cost
`≤ (Kc (K+2) + 1) · n · (r (H+1) ((mC^k)+1)^{τ50} + PsiR r Z H)` (the `RowHyp` shape of
`KFR.closedHyps_uncond`, with `w` replaced by `H`).

**`RowUP`**: a fixed list of procedures (placed anywhere in any extension of `KFM.kTable`) and a
code `rowC` with `RowU` for every symbol list.  This is what the uniform-Lemma-13 worker provides;
the KFW level procedure uses `RowUP` as a hypothesis (`RowUP → P14U`).
-/

set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN P8Lift Butterfly

/-- The label dimension of `complexIface`. -/
abbrev mC : ℕ := 100 ^ 3

/-- The stacks of the ten row-addition parameters. -/
def rowR (q : Fin 10) : Fin HS := ⟨36 + q.val, by have := q.isLt; unfold HS; omega⟩

/-- The row-addition parameters `[mC^k, K, e, t, S0, B, r, H, i, j]`. -/
def rowVals (k K e t S0 B r H : ℕ) (i j : Fin mC) : Fin 10 → ℤ :=
  ![((mC ^ k : ℕ) : ℤ), (K : ℤ), (e : ℤ), (t : ℤ), (S0 : ℤ), (B : ℤ), (r : ℤ), (H : ℤ),
    ((i : ℕ) : ℤ), ((j : ℕ) : ℤ)]

/-- The register assignment of a row addition. -/
def rowσ (k K e t S0 B r H : ℕ) (i j : Fin mC) : Fin HS → Option ℤ := fun x =>
  if h : 36 ≤ x.val ∧ x.val < 46 then
    some (rowVals k K e t S0 B r H i j ⟨x.val - 36, by omega⟩)
  else none

/-- The background holds the row-addition parameters in the registers `rowR`. -/
def rowQ (k K e t S0 B r H : ℕ) (i j : Fin mC) (s : IState HS) : Prop :=
  Agree (rowσ k K e t S0 B r H i j) s

/-- The bit positions of a node at level `k + 1` (row `a`, bit `c`). -/
def posR (K e k : ℕ) : Fin mC × Fin (mC ^ k) → ℕ := fun p => e - K * (p.2.val + mC ^ k * p.1.val)

/-- **Uniform row additions** for one table and one code. -/
def RowU {Pp : ℕ} (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp) (rowC : IStmt HS Pp)
    (Kc : ℝ) : Prop :=
  ∀ (k K e t S0 B r Z H : ℕ) (i j : Fin mC), i ≠ j → 6 ≤ K → 1 ≤ r → 80 * Z * (Z + 2) ≤ 2 ^ K →
    1 ≤ S0 → 1 ≤ B → K * (mC ^ (k + 1) - 1) ≤ e → e - e % K + K ≤ t →
    zsz ((16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Z →
    ∃ cost : ℕ → ℕ,
      SImplQ Isym tbl (rowQ k K e t S0 B r H i j) 0 H r (fun p => 2 ^ posR K e k p * S0)
        (B * 2 ^ t * S0) (Pm i j : Butterfly.Op (Fin mC × Fin (mC ^ k))) rowC 0 0 cost ∧
      ∀ w, w ≤ H → (cost w : ℝ) ≤ (Kc * (K + 2) + 1) * ((B * 2 ^ t * S0 : ℕ) : ℝ) *
        ((r : ℝ) * (H + 1) * ((mC : ℝ) ^ k + 1) ^ τ50 + (KFR.PsiR r Z H : ℝ))

/-- **Uniform row additions as procedures** of any extension of `KFM.kTable`. -/
def RowUP : Prop :=
  ∃ (nR : ℕ) (UR : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → Fin nR → IStmt HS (7 + E))
    (rowC : ∀ E : ℕ, (Fin nR → Fin (7 + E)) → IStmt HS (7 + E)) (Kc : ℝ), 0 ≤ Kc ∧
    ∀ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (idx : Fin nR → Fin (7 + E)),
      (∀ q, KFM.kTable ext (idx q) = UR E idx q) →
      ∀ Isym : List Sym, RowU Isym (KFM.kTable ext) (rowC E idx) Kc

end NLogN.KFW

end

section
-- Source module: Solutions.KFWEps
/-!
# KFW: the exponent expressions of the uniform phase passes

The uniform phase pass `phLU … εE` reads, in iteration `k` (index on `kS`), the exponent
`εE = aE k mod 4`.  For the stride-`K` layouts of the level procedure,
`pos i = e - K φ(i)` with `φ : ι ≃ Fin N`, so

  `aEof pos a' p = if p ≤ e ∧ K ∣ e - p ∧ (e - p)/K < N then a' (φ⁻¹ ((e-p)/K)) else 0`

(`aEof_equiv`), which the expression `εAff eR KR NR G` computes from the run-time registers
`eR = e`, `KR = K`, `NR = N` (`εAff_spec`), with `G` the exponent of a given index:

* `εLit c` (`G = c`): `S_D` (`c = 1`), `ZD` (`c = 2`), `fixG` (any, `a' = 0` uses `lit 0`);
* `εTab fR a` (`G q = a (q / f) mod 4` through a lookup list, `f` on `fR`): the node phases
  `a' (a, c) = a_a` on `Fin mC × Fin (mC^k)` (`φ = finProdFinEquiv`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFN

/-! ## The lookup expression -/

/-- `lookL l i0 x` evaluates to `l[x - i0] mod 4` (`0` past the end), for `x ≥ i0`. -/
def lookL : List ℕ → ℕ → Ex HS → Ex HS
  | [], _, _ => .lit 0
  | v :: l, i0, x => .sel (.add x (.lit (-((i0 : ℤ) + 1)))) (.lit ((v % 4 : ℕ) : ℤ))
      (lookL l (i0 + 1) x)

/-! ## The affine positions -/

/-! ## The affine exponent expression -/

/-- `d = e - k` (`e` on `eR`, `k` on `kS`). -/
def εD (eR : Fin HS) : Ex HS := .add (.reg eR) (.neg (.reg NLogN.KFW.kS))

/-- `if d < 0 ∨ K ∤ d ∨ d/K ≥ N then 0 else G (d/K)`. -/
def εAff (eR KR NR : Fin HS) (G : Ex HS → Ex HS) : Ex HS :=
  .sel (εD eR) (.lit 0)
    (.sel (.neg (.nmod (εD eR) (.reg KR))) (.lit 0)
      (.sel (.add (.ndiv (εD eR) (.reg KR)) (.neg (.reg NR))) (G (.ndiv (εD eR) (.reg KR)))
        (.lit 0)))

/-! ## The two instances -/

/-- Constant exponent `c` on the selected bits. -/
def εLit (eR KR NR : Fin HS) (c : ℤ) : Ex HS := εAff eR KR NR (fun _ => .lit c)

/-- Row exponents `a (q / f)` (`f` on `fR`). -/
def εTab (eR KR NR fR : Fin HS) (a : List ℕ) : Ex HS :=
  εAff eR KR NR (fun x => lookL a 0 (.ndiv x (.reg fR)))

/-- The common frame of the instances: `e`, `K`, `N` in registers of `σ`. -/
structure AffReg (σ : Fin HS → Option ℤ) (eR KR NR : Fin HS) (e K N : ℕ) : Prop where
  e : σ eR = some (e : ℤ)
  K : σ KR = some (K : ℤ)
  N : σ NR = some (N : ℤ)
  eS : eR ≠ NLogN.KFW.kS
  KS : KR ≠ NLogN.KFW.kS
  NS : NR ≠ NLogN.KFW.kS

end NLogN.KFW

end

section
-- Source module: Solutions.KFWFrame
/-!
# KFW: frames of run-time registers around uniform programs

* `σPush σ l`: the register assignment after pushing the values `l` (last push wins);
  `agree_pushSt'`: pushing keeps the background in agreement.
* `PushSeq σ pl vl c`: the pushes `pl` (expressions evaluated **sequentially**, each under the
  registers after the earlier pushes) push the values `vl`, at cost `≤ c`; `Sp.pushSeq`.
* **`sImplQ_push`**: push a frame, run a uniform `SImplQ` program on the extended background, pop.
* `sImplQ_call`, `sImplQ_ite`: procedure calls and register tests.
* `SImplQ.mono_dw`, `sImplQ_subOp`, `sImplQ_equiv`, `sImplQ_skip`: bookkeeping.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

/-! ## Register assignments after pushes -/

/-- The assignment after pushing `l` (in order; the last push of a register is its top). -/
def σPush (σ : Fin HS → Option ℤ) : List (Fin HS × ℤ) → Fin HS → Option ℤ
  | [] => σ
  | (i, v) :: l => σPush (Function.update σ i (some v)) l

/-- `σ'` extends `σ`. -/
def SExt (σ σ' : Fin HS → Option ℤ) : Prop := ∀ i v, σ i = some v → σ' i = some v

/-! ## Sequential pushes -/

/-- `pl` pushes `vl` sequentially from any state agreeing with `σ`, at cost `≤ c`. -/
def PushSeq (σ : Fin HS → Option ℤ) : List (Fin HS × Ex HS) → List (Fin HS × ℤ) → ℕ → Prop
  | [], [], c => 1 ≤ c
  | (i, e) :: l, (j, v) :: vl, c => i = j ∧ i.val < 56 ∧ e.Clean ∧ ∃ c1 c2, c1 + c2 ≤ c ∧
      (∀ t, Agree σ t → e.ok t ∧ e.eval t = v ∧
        e.cost t + (2 * moveCost (zsz v) + 19) ≤ c1) ∧
      PushSeq (Function.update σ i (some v)) l vl c2
  | _, _, _ => False

/-! ## Frames around uniform programs -/

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {Q : IState HS → Prop} {lo hi : ℕ}
variable {ι : Type*} [Fintype ι] [DecidableEq ι] {r : ℕ} {st : ι → ℕ} {n : ℕ}

end NLogN.KFW

end

section
-- Source module: Solutions.KFWLevDef
/-!
# KFW: the uniform level procedure (definitions)

The level procedure `levC jL rowC` (to be placed at index `jL` of the table) implements
`tens Cm` on the `m^k` bits (`m = mC`) at positions `e - K i`, strides `2^{e - K i} S₀`, of
`B 2^t S₀` records of `r` Gaussian entries.  Its parameters are read from a **frame** of
background registers (`levVals`):

  `vK = K, vT = t, vS = S₀, vR = r, vH = H` (constant over the recursion),
  `vk = k, vF = m^k, vE = e, vB = B, vX = ES k` (per level).

* `k = 0`: the kernel `leafC` (`qopU`, the uniform `kerP t 1 S₀ e B r 0 MC`);
* `k ≥ 1`: `nodeC`: push the node registers (`nodePush`), run the steps of the network
  `complexIface.net` (`stepC`), pop.  A child step pushes the child frame (`childPush`) and
  calls `jL` (the inverse child between two `ZD` passes, `cinvU`).

`ES k` is the exact scale of level `k`: `ES 0 = 1`, `ES (k+1) = cL + s ES k` (`cL`: the scale
of the atom gates of the network, with the atoms chosen once by `gAt`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

/-! ## Registers -/

abbrev vK : Fin HS := 1
abbrev vT : Fin HS := 2
abbrev vS : Fin HS := 3
abbrev vR : Fin HS := 4
abbrev vH : Fin HS := 5
abbrev vk : Fin HS := 6
abbrev vF : Fin HS := 7
abbrev vE : Fin HS := 8
abbrev vB : Fin HS := 9
abbrev vX : Fin HS := 10
abbrev wF : Fin HS := 11
abbrev wB : Fin HS := 12
abbrev wR0 : Fin HS := 13
abbrev wL : Fin HS := 14
abbrev wV : Fin HS := 15
abbrev wKF : Fin HS := 16
abbrev wP : Fin HS := 17
abbrev w1 : Fin HS := 18
abbrev wU : Fin HS := 20

/-! ## The gate class and the exact scales -/

open Classical in
/-- The gate-class constant of `complexIface` (the least one). -/
noncomputable def A0 : ℕ := Nat.find KFN.complexIface_gclass

/-- `G` is the gate of the atoms `as`. -/
def GAt (G : Matrix (Fin P8Lift.Wc) (Fin P8Lift.Wc) ℂ) (as : List KFG.Atom) : Prop :=
  as.length ≤ NLogN.KFW.A0 ∧ (∀ a ∈ as, a.Ok P8Lift.Wc ∧ a.h ≤ 1) ∧ KFG.NoTS as ∧ G = KFG.gateMat P8Lift.Wc as

open Classical in
/-- The chosen atoms of a gate. -/
noncomputable def gAt (G : Matrix (Fin P8Lift.Wc) (Fin P8Lift.Wc) ℂ) : Option (List KFG.Atom) :=
  if h : ∃ as, GAt G as then some (Classical.choose h) else none

open Classical in
/-- The chosen sign set of a `±1` role diagonal. -/
noncomputable def gDiag (G : Matrix (Fin P8Lift.Wc) (Fin P8Lift.Wc) ℂ) : Option (Finset (Fin P8Lift.Wc)) :=
  if h : ∃ U : Finset (Fin P8Lift.Wc), G = Matrix.diagonal fun w => if w ∈ U then (-1 : ℂ) else 1 then
    some (Classical.choose h) else none

/-- The scale of a local step. -/
noncomputable def eLoc : RStep (Fin P8Lift.Wc) mC → ℕ
  | .gate G => match gAt G with
    | some as => gδ as
    | none => 0
  | _ => 0

/-- The scale of the local steps of a node. -/
noncomputable def cL : ℕ := (complexIface.net.map eLoc).sum

/-- The exact scale of level `k`. -/
noncomputable def ES : ℕ → ℕ
  | 0 => 1
  | k + 1 => NLogN.KFW.cL + P8Lift.sc * ES k

/-! ## Codes -/

/-- `ES k` from `ES (k+1)` on `vX`. -/
noncomputable def esDown : Ex HS := .ndiv (.add (.reg NLogN.KFW.vX) (.lit (-(NLogN.KFW.cL : ℤ)))) (.lit (P8Lift.sc : ℤ))

/-- The phase constant `(k₀ + k₁ m^k) mod 4`. -/
def uE (k0 k1 : ℕ) : Ex HS := .nmod (.add (.lit (k0 : ℤ)) (.mul (.lit (k1 : ℤ)) (.reg NLogN.KFW.wF))) (.lit 4)

variable {Pp : ℕ}

/-- A phase step on role `w`. -/
def phC' (w : Fin P8Lift.Wc) (k0 k1 : ℕ) (a : Fin mC → ℕ) : IStmt HS Pp :=
  wrapQ P8Lift.Wc w.val wL NLogN.KFW.w1 (withPushI [(NLogN.KFW.wU, NLogN.KFW.uE (k0 % 4) (k1 % 4))]
    (fcode (phLU wR0 NLogN.KFW.vT NLogN.KFW.wB NLogN.KFW.wU wV (εTab NLogN.KFW.vE vK vF NLogN.KFW.wF (List.ofFn a)))))

/-- Code of the phase steps (other steps: `skip`). -/
def phStepC : RStep (Fin P8Lift.Wc) mC → IStmt HS Pp
  | .phase w k0 k1 a => phC' w k0 k1 a
  | _ => .skip

/-- A gate of atoms, then the leveling. -/
def gateU (as : List KFG.Atom) : RS :=
  .seq (gatePG as (fun _ => 0) wL) (gatePG (levOf P8Lift.Wc as) (gateE as (fun _ => 0)) wL)

/-- The row-addition parameters (`RowU`): `[m^k, K, e, t, S₀, B, r, H, i, j]` on `36 … 45`. -/
def rowPush (i j : Fin mC) : List (Fin HS × Ex HS) :=
  [(36, .reg NLogN.KFW.wF), (37, .reg vK), (38, .reg NLogN.KFW.vE), (39, .reg NLogN.KFW.vT), (40, .reg vS), (41, .reg NLogN.KFW.wB),
    (42, .reg vR), (43, .reg vH), (44, .lit ((i : ℕ) : ℤ)), (45, .lit ((j : ℕ) : ℤ))]

/-- The child frame of slot `h`. -/
noncomputable def childPush (h : Fin mC) : List (Fin HS × Ex HS) :=
  [(vk, .add (.reg vk) (.lit (-1))), (vF, .reg NLogN.KFW.wF),
    (NLogN.KFW.vE, .add (.reg NLogN.KFW.vE) (.neg (.mul (.lit ((h : ℕ) : ℤ)) (.reg wKF)))), (NLogN.KFW.vB, .reg NLogN.KFW.wB), (NLogN.KFW.vX, esDown)]

/-- A `ZD`-type phase pass on the child bits (`u` on `wU`). -/
def phZ (uX : Ex HS) : IStmt HS Pp :=
  withPushI [(NLogN.KFW.wU, uX)] (fcode (phLU wR0 NLogN.KFW.vT NLogN.KFW.wB NLogN.KFW.wU wV (εLit NLogN.KFW.vE vK vF ((2 % 4 : ℕ) : ℤ))))

/-- The inverse child: `ZD`, the forward child, `(-i)^{m^k} ZD`. -/
def cinvU (jL : Fin Pp) : IStmt HS Pp :=
  .seq (phZ (.lit 0)) (.seq (.call jL) (phZ (.nmod (.mul (.lit 3) (.reg vF)) (.lit 4))))

/-- The code of one step of the network. -/
noncomputable def stepC (jL : Fin Pp) (rowC : IStmt HS Pp) : RStep (Fin P8Lift.Wc) mC → IStmt HS Pp
  | .gate G => match gAt G with
    | some as => fcode (gateU as)
    | none => match gDiag G with
      | some U => seqLQ phStepC (negSteps (m := mC) U.toList)
      | none => .skip
  | .rowAdd w i j _ => wrapQ P8Lift.Wc w.val wL NLogN.KFW.w1 (withPushI (rowPush i j) rowC)
  | .phase w k0 k1 a => phC' w k0 k1 a
  | .perm σ => fcode (swapsG wL (permSw σ))
  | .child w h fwd => wrapQ P8Lift.Wc w.val wL NLogN.KFW.wP
      (withPushI (childPush h) (if fwd then .call jL else cinvU jL))

/-- The node registers. -/
noncomputable def nodePush : List (Fin HS × Ex HS) :=
  [(NLogN.KFW.wF, .ndiv (.reg vF) (.lit (mC : ℤ))), (NLogN.KFW.wB, .ndiv (.reg NLogN.KFW.vB) (.lit (P8Lift.Wc : ℤ))),
    (wR0, .mul (.reg vS) (.reg vR)), (wL, .mul (.mul (.reg NLogN.KFW.wB) (.pow2 (.reg NLogN.KFW.vT))) (.reg wR0)),
    (wV, .add (.reg wL) (.reg wL)), (wKF, .mul (.reg vK) (.reg NLogN.KFW.wF)), (NLogN.KFW.wP, .pow2 esDown),
    (NLogN.KFW.w1, .lit 1)]

/-- A node. -/
noncomputable def nodeC (jL : Fin Pp) (rowC : IStmt HS Pp) : IStmt HS Pp :=
  withPushI nodePush (seqLQ (stepC jL rowC) complexIface.net)

/-- `qopW` with the six descriptor values computed by expressions. -/
def qopU (Ms : List M2G) (eB1 eG : Ex HS) : RS :=
  .seq (.push NLogN.KFB.rB eB1) (.seq (.push NLogN.KFB.rB2 (.mul (.lit 2) eB1))
  (.seq (.push rB4 (.mul (.lit 4) eB1)) (.seq (.push NLogN.KFB.rG eG)
  (.seq (.push NLogN.KFB.rN (.mul (.lit ((4 * Ms.length : ℕ) : ℤ)) (.mul eG eB1)))
  (.seq (.push NLogN.KFB.rP (.lit 0))
  (.seq (NLogN.mvK 0 qP c1 (.reg NLogN.KFB.rP)) (.seq (qop Ms) (.seq (NLogN.mvK qP 0 c1 (.reg NLogN.KFB.rP))
  (.seq (.pop NLogN.KFB.rB) (.seq (.pop NLogN.KFB.rB2) (.seq (.pop rB4) (.seq (.pop NLogN.KFB.rG) (.seq (.pop NLogN.KFB.rN)
    (.pop NLogN.KFB.rP))))))))))))))

/-- `2^e S₀ r`. -/
def eB1L : Ex HS := .mul (.pow2 (.reg NLogN.KFW.vE)) (.mul (.reg vS) (.reg vR))

/-- `B 2^{t - e - 1}`. -/
def eGL : Ex HS := .mul (.reg NLogN.KFW.vB) (.pow2 (.add (.add (.reg NLogN.KFW.vT) (.neg (.reg NLogN.KFW.vE))) (.lit (-1))))

/-- The leaf: the kernel `C` on the single bit. -/
def leafC : IStmt HS Pp := fcode (qopU [MC] eB1L eGL)

/-- **The level procedure.** -/
noncomputable def levC (jL : Fin Pp) (rowC : IStmt HS Pp) : IStmt HS Pp :=
  .ite vk (fun c => decide (c = NLogN.Cls.zero)) leafC (nodeC jL rowC)

/-! ## Frames -/

end NLogN.KFW

end

section
-- Source module: Solutions.KFWStep1
/-!
# KFW: the uniform local steps of a node (gate, permutation)

A node of level `k + 1` (child level `k`) acts on `W` role streams of `n = Bn 2^t S₀` records,
bits `Fin mC × Fin (mC^k)` at the positions `posR K e k`, strides `stN K e k S₀`.
Its registers are described by **`NodeR σ K t S0 r H k e B Bn`** (the level frame and the node
frame `nodeVals`, everything `< 56`, the gate and phase scratch registers free).

* `stepQ_gate`: a gate of atoms (`gateU`), via `KFN.rImpl_gate` and `gatePG_href`;
* `stepQ_perm`: a role permutation (`swapsG`), via `KFN.rImpl_perm` and `swapsG_href`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-- The record count of a node role. -/
abbrev nN (Bn t S0 : ℕ) : ℕ := Bn * 2 ^ t * S0

/-- The strides of a node. -/
def stN (K e k S0 : ℕ) : Fin mC × Fin (mC ^ k) → ℕ := fun p => 2 ^ posR K e k p * S0

/-- The registers of a node of level `k + 1` with `Bn` blocks per role. -/
structure NodeR (σ : Fin HS → Option ℤ) (K t S0 r H k e B Bn : ℕ) : Prop where
  off : OffG σ
  offp : ∀ i ∈ NLogN.KFW.pT, σ i = none
  lt : ∀ i v, σ i = some v → i.val < 56
  hK : σ vK = some (K : ℤ)
  ht : σ NLogN.KFW.vT = some (t : ℤ)
  hS : σ vS = some (S0 : ℤ)
  hr : σ vR = some (r : ℤ)
  hH : σ vH = some (H : ℤ)
  hk : σ vk = some ((k + 1 : ℕ) : ℤ)
  hF : σ vF = some ((mC ^ (k + 1) : ℕ) : ℤ)
  hE : σ NLogN.KFW.vE = some (e : ℤ)
  hB : σ NLogN.KFW.vB = some (B : ℤ)
  hX : σ NLogN.KFW.vX = some ((ES (k + 1) : ℕ) : ℤ)
  gF : σ NLogN.KFW.wF = some ((mC ^ k : ℕ) : ℤ)
  gB : σ NLogN.KFW.wB = some (Bn : ℤ)
  gR0 : σ wR0 = some ((S0 * r : ℕ) : ℤ)
  gL : σ wL = some ((Bn * 2 ^ t * S0 * r : ℕ) : ℤ)
  gV : σ wV = some ((2 * (Bn * (S0 * r * 2 ^ t)) : ℕ) : ℤ)
  gKF : σ wKF = some ((K * mC ^ k : ℕ) : ℤ)
  gP : σ NLogN.KFW.wP = some ((2 : ℤ) ^ ES k)
  g1 : σ NLogN.KFW.w1 = some 1

section Steps

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {Q : IState HS → Prop}
  {lo hi : ℕ}
variable {σ : Fin HS → Option ℤ} {K t S0 r H k e B Bn : ℕ}

/-- The overhead of a uniform gate. -/
def xGate (as : List KFG.Atom) (Z : ℕ) : ℕ :=
  as.length * Xp Z + (levOf P8Lift.Wc as).length * Xp Z

end Steps

end NLogN.KFW

end

section
-- Source module: Solutions.KFWStep2
/-!
# KFW: expressions over a register assignment, and the uniform phase step

* `ExV σ e v B`: on every background agreeing with `σ`, `e` is defined, evaluates to `v`, and
  all its values have at most `B` bits (constructors `ExV.reg`, `ExV.lit`, `ExV.add`, …);
  `ExC σ e v c`: the same with cost `≤ c`.  `pushSeq_cons`, `pushSeq_nil`: building `PushSeq`.
* **`stepQ_phase`**: a phase step `phase w k₀ k₁ a` on the node roles (`phC'`), via
  `rImplQ_onRole`, `sImplQ_push` (the constant `u mod 4` on `wU`), `sImplQ_phase` and
  `epsOK_tab`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-! ## Expressions over a register assignment -/

/-- `e` evaluates to `v`, with values of at most `B` bits, on backgrounds agreeing with `σ`. -/
def ExV (σ : Fin HS → Option ℤ) (e : Ex HS) (v : ℤ) (B : ℕ) : Prop :=
  ∀ t, Agree σ t → e.ok t ∧ e.eval t = v ∧ e.Bnd t B

/-- `e` evaluates to `v` at cost at most `c` on backgrounds agreeing with `σ`. -/
def ExC (σ : Fin HS → Option ℤ) (e : Ex HS) (v : ℤ) (c : ℕ) : Prop :=
  ∀ t, Agree σ t → e.ok t ∧ e.eval t = v ∧ e.cost t ≤ c

namespace ExV

variable {σ : Fin HS → Option ℤ} {B : ℕ}

end ExV

/-! ## The phase step -/

/-- The push cost of the phase constant. -/
def cpU (Z : ℕ) (v : ℤ) : ℕ := 7 * 10 ^ 7 * (Z + 2) ^ 2 + (2 * moveCost (zsz v) + 19) + 1

/-- The body cost of a phase step. -/
def cPhStep (Z : ℕ) (v : ℤ) (εE : Ex HS) (Bn t S0 r : ℕ) (x : ℕ) : ℕ :=
  cpU Z v + cPhU x (Bn * (S0 * r * 2 ^ t)) t Bn Z (S0 * r) (xPh εE Z Z) + (1 * (2 * Z + 2) + 1)

section Steps

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {Q : IState HS → Prop}
  {lo hi : ℕ}
variable {σ : Fin HS → Option ℤ} {K t S0 r H k e B Bn : ℕ}

end Steps

end NLogN.KFW

end


