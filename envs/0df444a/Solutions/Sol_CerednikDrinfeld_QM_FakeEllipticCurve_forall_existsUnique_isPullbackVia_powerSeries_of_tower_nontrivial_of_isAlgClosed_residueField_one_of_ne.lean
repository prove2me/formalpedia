theorem Gpt.pow_le_ker_of_pow_eq_bot {B : Type} [CommRing B] [IsLocalRing B] {ψ : O →+* B} (ρ : Adm B ψ) (χ : Gpt B ψ)
    (n : ℕ) (hn : maximalIdeal B ^ (n + 1) = ⊥) : maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker χ.1 := by
  have hker : RingHom.ker ρ.1 = maximalIdeal B :=
