namespace CompareAway

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]}
variable {O : Type} [CommRing O] [IsLocalRing O]

abbrev Rn (O : Type) [CommRing O] [IsLocalRing O] (n : ℕ) : Type :=
  PowerSeries O ⧸ maximalIdeal (PowerSeries O) ^ (n + 1)

structure Tower (E₀ : FakeEllipticCurve Λ 1 (ResidueField O)) : Type 1 where
  ι₀ : Rn O 0 →+* ResidueField O
  hι₀ : Function.Bijective ι₀
  hι₀O : ι₀.comp ((Ideal.Quotient.mk (maximalIdeal (PowerSeries O) ^ (0 + 1))).comp (algebraMap O (PowerSeries O))) = residue O
  π : ∀ n : ℕ, Rn O (n + 1) →+* Rn O n
  hπ : ∀ n, (π n).comp (Ideal.Quotient.mk (maximalIdeal (PowerSeries O) ^ (n + 1 + 1))) =
    Ideal.Quotient.mk (maximalIdeal (PowerSeries O) ^ (n + 1))
  E : ∀ n : ℕ, FakeEllipticCurve Λ 1 (Rn O n)
  t : ∀ n : ℕ, (E n).A ⟶ (E (n + 1)).A
  ht : ∀ n, FakeEllipticCurve.IsPullbackVia (π n) (E (n + 1)) (E n) (t n)
  tchain : ∀ n : ℕ, (E 0).A ⟶ (E n).A
  htchain₀ : tchain 0 = 𝟙 _
  htchain : ∀ n, tchain (n + 1) = tchain n ≫ t n
  g₀ : E₀.A ⟶ (E 0).A
  hg₀ : FakeEllipticCurve.IsPullbackVia ι₀ (E 0) E₀ g₀

variable {E₀ : FakeEllipticCurve Λ 1 (ResidueField O)}

def Tower.ρn (D : Tower E₀) (n : ℕ) : Rn O n →+* ResidueField O :=
  D.ι₀.comp (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.le_add_left (0 + 1) n)))

theorem Tower.ρn_zero (D : Tower E₀) : D.ρn 0 = D.ι₀ := by
  apply Ideal.Quotient.ringHom_ext
  refine RingHom.ext fun x => ?_
  simp only [Tower.ρn, RingHom.comp_apply, Ideal.Quotient.factor_mk]

theorem Tower.ρn_comp_π (D : Tower E₀) (n : ℕ) : (D.ρn n).comp (D.π n) = D.ρn (n + 1) := by
  apply Ideal.Quotient.ringHom_ext
  refine RingHom.ext fun x => ?_
  have hx : D.π n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ x := RingHom.congr_fun (D.hπ n) x
  simp only [Tower.ρn, RingHom.comp_apply, hx, Ideal.Quotient.factor_mk]

theorem Tower.isPullbackVia_stage (D : Tower E₀) (n : ℕ) :
    FakeEllipticCurve.IsPullbackVia (D.ρn n) (D.E n) E₀ (D.g₀ ≫ D.tchain n) := by
  induction n with
  | zero => rw [Tower.ρn_zero, D.htchain₀, Category.comp_id]; exact D.hg₀
  | succ n ih =>
    rw [← Tower.ρn_comp_π, D.htchain, ← Category.assoc]
    exact FakeEllipticCurve.IsPullbackVia.comp (D.π n) (D.ρn n) (D.E (n + 1)) (D.E n) E₀ (D.t n) (D.g₀ ≫ D.tchain n) (D.ht n) ih

def Tower.T (D : Tower E₀) (n : ℕ) : Defm E₀ (Rn O n) (D.ρn n) :=
  ⟨D.E n, D.g₀ ≫ D.tchain n, D.isPullbackVia_stage n⟩

theorem Tower.factor_self (D : Tower E₀) (m : ℕ) (h : maximalIdeal (PowerSeries O) ^ (m + 1) ≤ maximalIdeal (PowerSeries O) ^ (m + 1)) :
    Ideal.Quotient.factor h = RingHom.id (Rn O m) := by
  apply Ideal.Quotient.ringHom_ext
  refine RingHom.ext fun x => ?_
  simp only [RingHom.comp_apply, Ideal.Quotient.factor_mk, RingHom.id_apply]

theorem Tower.exists_chain (D : Tower E₀) (m : ℕ) : ∀ d : ℕ,
    ∃ k : (D.E m).A ⟶ (D.E (m + d)).A,
      FakeEllipticCurve.IsPullbackVia
        (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ (Nat.le_add_right m d)) :
          maximalIdeal (PowerSeries O) ^ (m + d + 1) ≤ maximalIdeal (PowerSeries O) ^ (m + 1)))
        (D.E (m + d)) (D.E m) k ∧
      D.tchain m ≫ k = D.tchain (m + d)
  | 0 => by
    refine ⟨𝟙 _, ?_, by simp⟩
    rw [Tower.factor_self D m]
    exact isPullbackVia_id (D.E m)
  | d + 1 => by
    obtain ⟨k, hk, hck⟩ := Tower.exists_chain D m d
    refine ⟨k ≫ D.t (m + d), ?_, by rw [← Category.assoc, hck, ← D.htchain]; rfl⟩
    have hcomp := FakeEllipticCurve.IsPullbackVia.comp (D.π (m + d))
      (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ (Nat.le_add_right m d)) :
          maximalIdeal (PowerSeries O) ^ (m + d + 1) ≤ maximalIdeal (PowerSeries O) ^ (m + 1)))
      (D.E (m + d + 1)) (D.E (m + d)) (D.E m) (D.t (m + d)) k (D.ht (m + d)) hk
    have heq : (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ (Nat.le_add_right m d)) :
          maximalIdeal (PowerSeries O) ^ (m + d + 1) ≤ maximalIdeal (PowerSeries O) ^ (m + 1))).comp (D.π (m + d)) =
        Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ (Nat.le_add_right m (d + 1))) :
          maximalIdeal (PowerSeries O) ^ (m + (d + 1) + 1) ≤ maximalIdeal (PowerSeries O) ^ (m + 1)) := by
      apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext fun x => ?_
      have hx : D.π (m + d) (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ x := RingHom.congr_fun (D.hπ (m + d)) x
      simp only [RingHom.comp_apply, hx]
      rfl
    rw [heq] at hcomp
    exact hcomp

theorem Tower.rel_T_bc (D : Tower E₀) {m m' : ℕ} (hmm : m ≤ m')
    (hf : (D.ρn m).comp (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ hmm))) = D.ρn m') :
    Defm.Rel (D.T m) ((D.T m').bc (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ hmm))) hf) := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmm
  obtain ⟨k, hk, hck⟩ := Tower.exists_chain D m d
  exact Defm.rel_bc _ hf (D.T (m + d)) (D.T m) k hk (by simp only [Tower.T, Category.assoc, hck])

section Xi
variable {B : Type} [CommRing B] {ψ : O →+* B}

theorem Gpt.exists_pow_le_ker [IsDomain O] [IsDiscreteValuationRing O] (p : ℕ) (hpO : ((p : ℕ) : O) ∈ maximalIdeal O)
    (hpO0 : ((p : ℕ) : O) ≠ 0) (hB : IsNilpotent (p : B)) (χ : Gpt B ψ) :
    ∃ n : ℕ, maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker χ.1 := by
  classical
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible O
  have hmax : maximalIdeal O = Ideal.span {ϖ} := (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ

  have hψC : ∀ o : O, χ.1 (PowerSeries.C o) = ψ o := by
    intro o
    have := congrArg (fun f : O →+* B => f o) χ.2.1
    simpa using this
  have hϖnil : IsNilpotent (ψ ϖ) := by
    obtain ⟨v, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hpO0 hϖ
    have hv : v ≠ 0 := by
      rintro rfl
      rw [pow_zero, mul_one] at hu
      exact (IsLocalRing.mem_maximalIdeal _).mp hpO (hu ▸ u.isUnit)
    obtain ⟨m, hm⟩ := hB
    refine ⟨v * m, ?_⟩
    have e : ψ ϖ ^ v = ψ ((u⁻¹ : Oˣ) : O) * (p : B) := by
      rw [← map_pow, ← map_natCast ψ p, ← map_mul]; congr 1
      rw [hu, ← mul_assoc, Units.inv_mul, one_mul]
    rw [pow_mul, e, mul_pow, hm, mul_zero]

  let J : Ideal B := Ideal.span {ψ ϖ, χ.1 PowerSeries.X}
  have hJ : IsNilpotent J := by
    refine (Ideal.FG.isNilpotent_iff_le_nilradical ⟨{ψ ϖ, χ.1 PowerSeries.X}, by simp [J]⟩).mpr ?_
    refine Ideal.span_le.mpr ?_
    rintro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact hϖnil
    · exact χ.2.2
  obtain ⟨N, hN⟩ := hJ

  have hmle : Ideal.map χ.1 (maximalIdeal (PowerSeries O)) ≤ J := by
    rw [Ideal.map_le_iff_le_comap]
    intro f hf
    rw [Ideal.mem_comap]
    have hc : PowerSeries.constantCoeff f ∈ maximalIdeal O := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hf ⊢
      exact fun h => hf (PowerSeries.isUnit_iff_constantCoeff.mpr h)
    rw [hmax, Ideal.mem_span_singleton] at hc
    obtain ⟨o, ho⟩ := hc
    rw [PowerSeries.eq_X_mul_shift_add_const f, ho]
    simp only [map_add, map_mul, hψC]
    refine J.add_mem (J.mul_mem_right _ (Ideal.subset_span (by simp))) (J.mul_mem_right _ (Ideal.subset_span (by simp)))
  refine ⟨N, ?_⟩
  intro f hf
  rw [RingHom.mem_ker]
  have h1 : χ.1 f ∈ Ideal.map χ.1 (maximalIdeal (PowerSeries O) ^ (N + 1)) := Ideal.mem_map_of_mem _ hf
  rw [Ideal.map_pow] at h1
  have h2 : (Ideal.map χ.1 (maximalIdeal (PowerSeries O))) ^ (N + 1) ≤ J ^ N :=
    (Ideal.pow_right_mono hmle (N + 1)).trans (Ideal.pow_le_pow_right (Nat.le_succ N))
  have h3 := h2 h1
  rw [hN, Ideal.zero_eq_bot, Ideal.mem_bot] at h3
  exact h3

def Gpt.lvl [IsDomain O] [IsDiscreteValuationRing O] (p : ℕ) (hpO : ((p : ℕ) : O) ∈ maximalIdeal O)
    (hpO0 : ((p : ℕ) : O) ≠ 0) (hB : IsNilpotent (p : B)) (χ : Gpt B ψ) : ℕ :=
  Classical.choose (Gpt.exists_pow_le_ker p hpO hpO0 hB χ)

def Gpt.bar (χ : Gpt B ψ) (n : ℕ) (hn : maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker χ.1) : Rn O n →+* B :=
  Ideal.Quotient.lift _ χ.1 (fun a ha => hn ha)

theorem Gpt.bar_comp_mk (χ : Gpt B ψ) (n : ℕ) (hn : maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker χ.1) :
    (χ.bar n hn).comp (Ideal.Quotient.mk _) = χ.1 :=
  RingHom.ext fun _ => rfl

theorem Gpt.rho_comp_bar (D : Tower E₀) (χ : Gpt B ψ) (ρ : Adm B ψ) (n : ℕ)
    (hn : maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker χ.1) : ρ.1.comp (χ.bar n hn) = D.ρn n := by
  apply Ideal.Quotient.ringHom_ext
  rw [RingHom.comp_assoc, Gpt.bar_comp_mk]

  have hC : ∀ c : O, (ρ.1.comp χ.1) (algebraMap O (PowerSeries O) c) =
      ((D.ρn n).comp (Ideal.Quotient.mk (maximalIdeal (PowerSeries O) ^ (n + 1)))) (algebraMap O (PowerSeries O) c) := by
    intro c
    have h1 : (ρ.1.comp χ.1) (algebraMap O (PowerSeries O) c) = residue O c := by
      rw [RingHom.comp_apply, show χ.1 (algebraMap O (PowerSeries O) c) = ψ c from RingHom.congr_fun χ.2.1 c]
      exact RingHom.congr_fun ρ.2 c
    have h2 : ((D.ρn n).comp (Ideal.Quotient.mk (maximalIdeal (PowerSeries O) ^ (n + 1)))) (algebraMap O (PowerSeries O) c) =
        residue O c := by
      simp only [Tower.ρn, RingHom.comp_apply, Ideal.Quotient.factor_mk]
      exact RingHom.congr_fun D.hι₀O c
    rw [h1, h2]
  have hX1 : (ρ.1.comp χ.1) PowerSeries.X = 0 := (χ.2.2.map ρ.1).eq_zero
  have hXm : (PowerSeries.X : PowerSeries O) ∈ maximalIdeal (PowerSeries O) ^ (0 + 1) := by
    rw [zero_add, pow_one, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have h0 := PowerSeries.isUnit_iff_constantCoeff.mp hu
    rw [PowerSeries.constantCoeff_X] at h0
    exact not_isUnit_zero h0
  have hX2 : ((D.ρn n).comp (Ideal.Quotient.mk (maximalIdeal (PowerSeries O) ^ (n + 1)))) PowerSeries.X = 0 := by
    simp only [Tower.ρn, RingHom.comp_apply, Ideal.Quotient.factor_mk]
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hXm, map_zero]
  apply RingHom.ext
  intro f
  rw [PowerSeries.eq_shift_mul_X_add_const f]
  simp only [map_add, map_mul, hX1, hX2, mul_zero, zero_add]
  rw [PowerSeries.C_eq_algebraMap]
  exact hC _

theorem Tower.ρn_comp_factor (D : Tower E₀) {n m : ℕ} (h : n ≤ m) :
    (D.ρn n).comp (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ h))) = D.ρn m := by
  unfold Tower.ρn
  rw [RingHom.comp_assoc]
  congr 1
  apply RingHom.ext
  intro x
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [RingHom.comp_apply, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk, Ideal.Quotient.factor_mk]

theorem Gpt.bar_eq_comp (χ : Gpt B ψ) {n m : ℕ} (h : n ≤ m)
    (hn : maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker χ.1) (hm : maximalIdeal (PowerSeries O) ^ (m + 1) ≤ RingHom.ker χ.1) :
    χ.bar m hm = (χ.bar n hn).comp (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ h))) := by
  apply RingHom.ext
  intro x
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [RingHom.comp_apply, Ideal.Quotient.factor_mk]
  rfl

theorem ringHom_ext_powerSeries {S : Type} [CommRing S] (θ₁ θ₂ : PowerSeries O →+* S)
    (hC : θ₁.comp (algebraMap O (PowerSeries O)) = θ₂.comp (algebraMap O (PowerSeries O)))
    (h₁ : θ₁ PowerSeries.X = 0) (h₂ : θ₂ PowerSeries.X = 0) : θ₁ = θ₂ := by
  apply RingHom.ext
  intro φ
  have e : θ₁ (algebraMap O (PowerSeries O) (PowerSeries.constantCoeff φ)) =
      θ₂ (algebraMap O (PowerSeries O) (PowerSeries.constantCoeff φ)) := by
    rw [← RingHom.comp_apply, hC, RingHom.comp_apply]
  rw [PowerSeries.algebraMap_eq] at e
  rw [PowerSeries.eq_shift_mul_X_add_const φ, map_add, map_add, map_mul, map_mul, h₁, h₂, mul_zero, mul_zero, e]

theorem Gpt.subsingleton {B : Type} [CommRing B] [IsReduced B] (ψ : O →+* B) : Subsingleton (Gpt B ψ) :=
  ⟨fun χ χ' => Subtype.ext (ringHom_ext_powerSeries _ _ (by rw [χ.2.1, χ'.2.1]) χ.2.2.eq_zero χ'.2.2.eq_zero)⟩

def Gpt.const {B : Type} [CommRing B] (ψ : O →+* B) : Gpt B ψ :=
  ⟨ψ.comp PowerSeries.constantCoeff, by
    ext r
    rw [RingHom.comp_apply, RingHom.comp_apply, PowerSeries.algebraMap_eq, PowerSeries.constantCoeff_C], by
    rw [RingHom.comp_apply, PowerSeries.constantCoeff_X, map_zero]; exact IsNilpotent.zero⟩

def xiAt (D : Tower E₀) (χ : Gpt B ψ) (ρ : Adm B ψ) (n : ℕ) (hn : maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker χ.1) :
    DefCl E₀ B ρ.1 :=
  ⟦(D.T n).bc (χ.bar n hn) (Gpt.rho_comp_bar D χ ρ n hn)⟧

theorem xiAt_eq (D : Tower E₀) (χ : Gpt B ψ) (ρ : Adm B ψ) (n m : ℕ)
    (hn : maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker χ.1) (hm : maximalIdeal (PowerSeries O) ^ (m + 1) ≤ RingHom.ker χ.1) :
    xiAt D χ ρ n hn = xiAt D χ ρ m hm := by
  suffices key : ∀ (n m : ℕ) (h : n ≤ m) (hn : maximalIdeal (PowerSeries O) ^ (n + 1) ≤ RingHom.ker χ.1)
      (hm : maximalIdeal (PowerSeries O) ^ (m + 1) ≤ RingHom.ker χ.1), xiAt D χ ρ n hn = xiAt D χ ρ m hm by
    rcases le_total n m with h | h
    · exact key n m h hn hm
    · exact (key m n h hm hn).symm
  intro n m h hn hm
  apply Quotient.sound
  have hf := D.ρn_comp_factor h
  have hgf : ρ.1.comp ((χ.bar n hn).comp (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ h)))) = D.ρn m := by
    rw [← RingHom.comp_assoc, Gpt.rho_comp_bar D χ ρ n hn, hf]
  have r1 := Defm.bc_rel (χ.bar n hn) (Gpt.rho_comp_bar D χ ρ n hn) (D.rel_T_bc h hf)
  have r2 := Defm.bc_comp (Ideal.Quotient.factor (Ideal.pow_le_pow_right (Nat.succ_le_succ h))) (χ.bar n hn) hf
    (Gpt.rho_comp_bar D χ ρ n hn) hgf (D.T m)
  have r3 := Defm.bc_congr (Gpt.bar_eq_comp χ h hn hm).symm hgf (Gpt.rho_comp_bar D χ ρ m hm) (D.T m)
  exact (r1.trans r2).trans r3

def xi [IsDomain O] [IsDiscreteValuationRing O] (p : ℕ) (hpO : ((p : ℕ) : O) ∈ maximalIdeal O) (hpO0 : ((p : ℕ) : O) ≠ 0)
    (D : Tower E₀) (hB : IsNilpotent (p : B)) (x : Gobj B ψ) : Hobj E₀ B ψ :=
  fun ρ => xiAt D (x ρ) ρ (Gpt.lvl p hpO hpO0 hB (x ρ)) (Classical.choose_spec (Gpt.exists_pow_le_ker p hpO hpO0 hB (x ρ)))

