theorem map_smul_top_eq (k : ℕ) :
    Submodule.map (Ψ p O T).toLinearMap
        (((p : ℤ_[p]) ^ k) • ⊤ : Submodule ℤ_[p] (O ⊗[ℤ_[p]] T))
      = (((p : ℤ_[p]) ^ k) • ⊤ :
          Submodule ℤ_[p] (Module.Free.ChooseBasisIndex ℤ_[p] O → T)) := by
  rw [Submodule.map_pointwise_smul, Submodule.map_top, LinearEquiv.range]

