theorem OAI.Cotype.compactMap_walsh_bound (hAP : ApproximationProperty X)
    (J : G →L[ℝ] X) (hJ : IsCompactOperator J) (n : ℕ) {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hfin : ∀ T : G →L[ℝ] X, FiniteDimensional ℝ (LinearMap.range T.toLinearMap) →
      walshNorm n T ≤ ρ * ‖T‖) :
