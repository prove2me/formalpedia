-- Source module: Solutions.R6CxNetFast
/-!
# A kernel-fast form of `progChk` (moves only)

`progK` runs the moves of a spec list in continuation-passing style, with recursor-based tree
access written in raw `Nat` primitives and forced accumulators (kernel evaluation is
call-by-name). The op condition of `chunkOK` is not evaluated: it follows from `OpsIn` (every op
wire is one of the spec's wires, hence at `V` after the moves).

`progK_sound`: a passing `progK` gives a passing `progChk`, and the continuation holds at the
final state with the accumulated packed histogram and move count.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Cx.NetFast

noncomputable section

open NetBT NetLoc

lemma beqR_eq : ∀ a b : BT, beqR a b = BT.beq a b
  | .leaf a, .leaf b => rfl
  | .leaf _, .node _ _ => rfl
  | .node _ _, .leaf _ => rfl
  | .node l r, .node l' r' => by
    show (beqR l l' && beqR r r') = _
    rw [beqR_eq l l', beqR_eq r r']; rfl

end

end IntMul.Kappa.R6.Cx.NetFast

