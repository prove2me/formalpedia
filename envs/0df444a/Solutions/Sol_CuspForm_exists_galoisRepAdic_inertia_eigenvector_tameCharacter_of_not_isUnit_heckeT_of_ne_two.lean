private theorem levelFactor_quotEnd {I J : Ideal A} (h : J ≤ I) (ρ : G →* Module.End A X) (g : G)
    (z : X ⧸ (J • (⊤ : Submodule A X))) :
    levelFactor X h (quotEnd ρ J g z) = quotEnd ρ I g (levelFactor X h z) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ z
  rw [quotEnd_mk, levelFactor_mk, levelFactor_mk, quotEnd_mk]

end LevelFactor
