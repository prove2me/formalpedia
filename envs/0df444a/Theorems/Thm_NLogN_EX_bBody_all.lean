theorem NLogN.EX.bBody_all (M : MulSpec) (q : Params) (kb mm Φ Bacc Q Bq Bx : ℕ) (BB : ℕ → ℕ)
    (hM : MulBnd M mm Φ) (hsl : q.s.length = q.K) (hst : ∀ i < q.K, sK q i ≤ tK q i)
    (hα : 1 ≤ q.α) (hBx : Vx q kb < 2 ^ Bx) (k : ℕ) (hk : k < q.K)
    (H : BAx q kb mm Bacc Q Bq BB k)
    (Y : List (ℤ × ℤ)) (w : IState HS) (R LS LM LC : List Item) (hg : Glob q kb w)
    (hD : w.G gD = gints (XB q Y k) ++ R) (hL : (XB q Y k).length = NB q k)
    (hLB : GB (BB k) (XB q Y k))
    (hS : w.G xS = .int (sK q k : ℤ) :: LS) (hMx : w.G xM = .int (NB q k : ℤ) :: LM)
    (hc : w.G cL = .int ((q.K : ℤ) - k) :: LC) :
    bBody.run w = (((w.upd gD (gints (XB q Y (k + 1)) ++ R)).upd xM
        (.int (NB q (k + 1) : ℤ) :: LM)).upd xU (.int (sK q k : ℤ) :: w.G xU)).upd xS LS ∧
      bBody.ok M w ∧
      bBody.cost M w ≤
        bapAxCost q.p (sK q k) (tK q k) q.α (mB q k) kb (BB k) mm Φ Bacc Q Bq + bOver q Bx ∧
      (XB q Y (k + 1)).length = NB q (k + 1) ∧ GB (BB (k + 1)) (XB q Y (k + 1)) := by sorry
