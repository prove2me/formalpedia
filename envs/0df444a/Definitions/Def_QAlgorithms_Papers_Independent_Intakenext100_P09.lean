-- title:
--   Definitions for A Spectral Sequence Connecting Continuous With Locally Continuous Group Cohomology
-- statement:
--   The objects the formalized statements of *A Spectral Sequence Connecting Continuous With Locally Continuous Group Cohomology* (arXiv:1110.0994) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `Cochain`: PDF p. 2, Definition 1.1: unnormalized homogeneous cochains in degree `n`.
--   - `deleteCoordinate`: PDF pp. 2, 4: deletion of coordinate `i` in the homogeneous differential.
--   - `differential`: PDF p. 2, standard complex: the alternating homogeneous differential.
--   - `equivariantCochains`: PDF p. 2, Eq. (1.1): fixed points are precisely equivariant global cochains.
--   - `groupCochains`: PDF p. 2, Example 1.2: homogeneous group cochains for left translation.
--   - `continuousCochains`: PDF p. 2, Definition 1.1: global continuity with ordinary product topology.
--   - `OpenCover`: PDF p. 3: an open cover, allowing the empty cover when `X` is empty.
--   - `coverDiagonal`: PDF p. 3: `U[n]`, tuples lying in a single member of the cover.
--   - `coverCochains`: PDF p. 3: global cochains continuous on `U[n]`.
--   - `germCochains`: PDF pp. 3–4: degreewise cover colimit as subgroups of the global function group. Common intersection refinements make this supremum the directed union.
--   - `InvariantCover`: PDF p. 3: invariance of the family of cover members, not invariance of each member.
--   - `invariantCoverCochains`: PDF p. 3, Proposition 1.7: colimit of fixed subgroups over invariant covers.
--   - `coverComparison`: The degreewise canonical comparison in Proposition 1.7, PDF pp. 3–4.
--   - `translatedFamily`: PDF p. 3, Example 1.5: the translated family generated by an identity neighborhood.
--   - `IsInvariantDiagonalNeighborhood`: An invariant neighborhood of the diagonal, PDF p. 4, Corollary 1.8.
--   - `invariantNeighborhoodCochains`: PDF p. 4: subgroup of equivariant cochains continuous on some invariant open diagonal neighborhood. The supremum is a union since neighborhoods intersect.
--   - `cocycles`: PDF p. 3, Definition 1.3: cocycles in a specified family of cochain subgroups.
--   - `boundaries`: PDF p. 3: boundaries inside cycles. Pullback of the preceding differential's range makes the definition meaningful without assuming a square-zero law as data. For the source complexes it is precisely the ordinary boundary subgroup.
--   - `Cohomology`: PDF p. 3: actual abelian-group cohomology quotient, including degree zero.
--   - `cycleInclusion`: The identity-on-global-functions map on cycles for an inclusion of cochain families (PDF pp. 2–3).
--   - `cohomologyInclusion`: PDF pp. 2–3: the actual map on cohomology induced by inclusion, computed on representatives by the identity and descended through the boundary quotient.
--   - `continuousEquivariant`: PDF p. 2: continuous equivariant cochains.
--   - `germEquivariant`: PDF p. 3: locally continuous equivariant global cochains.
--   - `continuousToGerm`: PDF p. 2: inclusion of continuous into locally continuous equivariant cochains. The one-member cover suffices for every globally continuous cochain.
--   - `ColumnCoefficients`: PDF p. 8: the first-block continuous coefficient group, with no topology on this mapping group required for the algebraic column calculation.
--   - `columnAugmentation`: PDF p. 8, natural column augmentation: a coefficient is constant in the second block. Under currying it sends `c` to `(x,y) ↦ c(x)`.
-- source:
--   A Spectral Sequence Connecting Continuous With Locally Continuous Group Cohomology, arXiv:1110.0994v1, https://arxiv.org/abs/1110.0994v1

import Mathlib

/-!
Paper-local objects for arXiv:1110.0994v1, ordinary products only.
The coefficient group is additive, with no vector-space or contractibility assumption.
Cochains are global functions; cover colimits are directed unions of subgroups in
that same function group, never quotients by germ equality. Cohomology is the
abelian-group quotient of cycles by boundaries, with zero boundaries in degree 0.
The kTop and general BGN smooth interfaces are deferred in the accompanying GAPS.json.
-/

noncomputable section

namespace QAlgorithms.Papers.Independent.Intakenext100.P09

universe u v w

/-- PDF p. 2, Definition 1.1: unnormalized homogeneous cochains in degree `n`. -/
abbrev Cochain (X : Type u) (V : Type v) (n : ℕ) := (Fin (n + 1) → X) → V

/-- PDF pp. 2, 4: deletion of coordinate `i` in the homogeneous differential. -/
def deleteCoordinate {X : Type u} {n : ℕ} (i : Fin (n + 2))
    (x : Fin (n + 2) → X) : Fin (n + 1) → X :=
  fun j => x (i.succAbove j)

/-- PDF p. 2, standard complex: the alternating homogeneous differential. -/
def differential {X : Type u} {V : Type v} [AddCommGroup V] (n : ℕ) :
    Cochain X V n →+ Cochain X V (n + 1) where
  toFun f x := ∑ i : Fin (n + 2), ((-1 : ℤ) ^ i.val) • f (deleteCoordinate i x)
  map_zero' := by
    ext x
    simp
  map_add' := by
    intro f g
    ext x
    simp [smul_add, Finset.sum_add_distrib]

example {X : Type u} {V : Type v} [AddCommGroup V]
    (f : Cochain X V 0) (x : Fin 2 → X) :
    differential 0 f x = f (fun _ => x 1) - f (fun _ => x 0) := by
  have h0 : deleteCoordinate (n := 0) 0 x = (fun _ : Fin 1 => x 1) := by
    funext j
    have hj : j = (0 : Fin 1) := by
      apply Fin.ext
      omega
    rw [hj]
    rfl
  have h1 : deleteCoordinate (n := 0) 1 x = (fun _ : Fin 1 => x 0) := by
    funext j
    have hj : j = (0 : Fin 1) := by
      apply Fin.ext
      omega
    rw [hj]
    rfl
  simp [differential, Fin.sum_univ_two, sub_eq_add_neg, h0, h1]

/-- PDF p. 2, Eq. (1.1): fixed points are precisely equivariant global cochains. -/
def equivariantCochains (G : Type w) {X : Type u} {V : Type v}
    [Group G] [MulAction G X] [AddCommGroup V] [DistribMulAction G V] (n : ℕ) :
    AddSubgroup (Cochain X V n) where
  carrier := {f | ∀ (g : G) (x : Fin (n + 1) → X),
    f (fun i => g • x i) = g • f x}
  zero_mem' := by intro g x; simp
  add_mem' := by
    intro f h hf hh g x
    change f (fun i => g • x i) + h (fun i => g • x i) = g • (f x + h x)
    rw [hf g x, hh g x, smul_add]
  neg_mem' := by
    intro f hf g x
    change -f (fun i => g • x i) = g • (-f x)
    rw [hf g x, smul_neg]

/-- PDF p. 2, Example 1.2: homogeneous group cochains for left translation. -/
def groupCochains (G : Type u) (V : Type v) [Group G] [AddCommGroup V]
    [DistribMulAction G V] (n : ℕ) : AddSubgroup (Cochain G V n) where
  carrier := {f | ∀ (g : G) (x : Fin (n + 1) → G),
    f (fun i => g * x i) = g • f x}
  zero_mem' := by intro g x; simp
  add_mem' := by
    intro f h hf hh g x
    change f (fun i => g * x i) + h (fun i => g * x i) = g • (f x + h x)
    rw [hf g x, hh g x, smul_add]
  neg_mem' := by
    intro f hf g x
    change -f (fun i => g * x i) = g • (-f x)
    rw [hf g x, smul_neg]

/-- PDF p. 2, Definition 1.1: global continuity with ordinary product topology. -/
def continuousCochains {X : Type u} {V : Type v} [TopologicalSpace X]
    [TopologicalSpace V] [AddCommGroup V] [IsTopologicalAddGroup V] (n : ℕ) :
    AddSubgroup (Cochain X V n) where
  carrier := {f | Continuous f}
  zero_mem' := continuous_const
  add_mem' hf hh := hf.add hh
  neg_mem' hf := hf.neg

/-- PDF p. 3: an open cover, allowing the empty cover when `X` is empty. -/
structure OpenCover (X : Type u) [TopologicalSpace X] where
  sets : Set (Set X)
  isOpen : ∀ W ∈ sets, IsOpen W
  covers : ∀ x : X, ∃ W ∈ sets, x ∈ W

/-- PDF p. 3: `U[n]`, tuples lying in a single member of the cover. -/
def coverDiagonal {X : Type u} [TopologicalSpace X] (U : OpenCover X) (n : ℕ) :
    Set (Fin (n + 1) → X) :=
  {x | ∃ W ∈ U.sets, ∀ i, x i ∈ W}

/-- PDF p. 3: global cochains continuous on `U[n]`. -/
def coverCochains {X : Type u} {V : Type v} [TopologicalSpace X]
    [TopologicalSpace V] [AddCommGroup V] [IsTopologicalAddGroup V]
    (U : OpenCover X) (n : ℕ) : AddSubgroup (Cochain X V n) where
  carrier := {f | ContinuousOn f (coverDiagonal U n)}
  zero_mem' := continuousOn_const
  add_mem' hf hh := hf.add hh
  neg_mem' hf := hf.neg

/-- PDF pp. 3–4: degreewise cover colimit as subgroups of the global function group.
Common intersection refinements make this supremum the directed union. -/
def germCochains {X : Type u} {V : Type v} [TopologicalSpace X]
    [TopologicalSpace V] [AddCommGroup V] [IsTopologicalAddGroup V] (n : ℕ) :
    AddSubgroup (Cochain X V n) :=
  ⨆ U : OpenCover X, coverCochains U n

/-- PDF p. 3: invariance of the family of cover members, not invariance of each member. -/
def InvariantCover (G : Type w) {X : Type u} [Group G] [MulAction G X]
    [TopologicalSpace X] (U : OpenCover X) : Prop :=
  ∀ (g : G) (W : Set X), W ∈ U.sets → (fun x => g • x) '' W ∈ U.sets

/-- PDF p. 3, Proposition 1.7: colimit of fixed subgroups over invariant covers. -/
def invariantCoverCochains (G : Type w) {X : Type u} {V : Type v}
    [Group G] [MulAction G X] [TopologicalSpace X] [TopologicalSpace V]
    [AddCommGroup V] [IsTopologicalAddGroup V] [DistribMulAction G V] (n : ℕ) :
    AddSubgroup (Cochain X V n) :=
  ⨆ U : OpenCover X, ⨆ (_ : InvariantCover G U),
    coverCochains U n ⊓ equivariantCochains G n

/-- The degreewise canonical comparison in Proposition 1.7, PDF pp. 3–4. -/
def coverComparison (G : Type w) {X : Type u} {V : Type v}
    [Group G] [MulAction G X] [TopologicalSpace X] [TopologicalSpace V]
    [AddCommGroup V] [IsTopologicalAddGroup V] [DistribMulAction G V] (n : ℕ) :
    ↥(invariantCoverCochains G (X := X) (V := V) n) →+
      ↥((germCochains (X := X) (V := V) n ⊓
        equivariantCochains G (X := X) (V := V) n) : AddSubgroup (Cochain X V n)) :=
  AddSubgroup.inclusion (by
    apply iSup_le
    intro U
    apply iSup_le
    intro hU
    exact le_inf (le_trans inf_le_left (le_iSup (fun U : OpenCover X =>
      coverCochains (V := V) U n) U)) inf_le_right)

/-- PDF p. 3, Example 1.5: the translated family generated by an identity neighborhood. -/
def translatedFamily {G : Type u} [Group G] (U : Set G) : Set (Set G) :=
  {W | ∃ g : G, W = (fun x => g * x) '' U}

/-- An invariant neighborhood of the diagonal, PDF p. 4, Corollary 1.8. -/
def IsInvariantDiagonalNeighborhood (G : Type w) {X : Type u}
    [Group G] [MulAction G X] [TopologicalSpace X] (n : ℕ)
    (N : Set (Fin (n + 1) → X)) : Prop :=
  IsOpen N ∧ (∀ x : X, (fun _ => x) ∈ N) ∧
    ∀ (g : G) (x : Fin (n + 1) → X), x ∈ N → (fun i => g • x i) ∈ N

/-- PDF p. 4: subgroup of equivariant cochains continuous on some invariant
open diagonal neighborhood. The supremum is a union since neighborhoods intersect. -/
def invariantNeighborhoodCochains (G : Type w) {X : Type u} {V : Type v}
    [Group G] [MulAction G X] [TopologicalSpace X] [TopologicalSpace V]
    [AddCommGroup V] [IsTopologicalAddGroup V] [DistribMulAction G V] (n : ℕ) :
    AddSubgroup (Cochain X V n) :=
  ⨆ N : {N : Set (Fin (n + 1) → X) // IsInvariantDiagonalNeighborhood G n N},
    ({ carrier := {f | ContinuousOn f N.val}
       zero_mem' := continuousOn_const
       add_mem' := fun hf hh => hf.add hh
       neg_mem' := fun hf => hf.neg } : AddSubgroup (Cochain X V n)) ⊓
      equivariantCochains G n

/-- PDF p. 3, Definition 1.3: cocycles in a specified family of cochain subgroups. -/
def cocycles {X : Type u} {V : Type v} [AddCommGroup V]
    (S : ∀ n : ℕ, AddSubgroup (Cochain X V n)) (n : ℕ) :
    AddSubgroup (Cochain X V n) :=
  S n ⊓ (differential n).ker

/-- PDF p. 3: boundaries inside cycles. Pullback of the preceding differential's
range makes the definition meaningful without assuming a square-zero law as data.
For the source complexes it is precisely the ordinary boundary subgroup. -/
def boundaries {X : Type u} {V : Type v} [AddCommGroup V]
    (S : ∀ n : ℕ, AddSubgroup (Cochain X V n)) :
    (n : ℕ) → AddSubgroup (cocycles S n)
  | 0 => ⊥
  | k + 1 => (((differential k).comp (S k).subtype).range).comap
      (cocycles S (k + 1)).subtype

/-- PDF p. 3: actual abelian-group cohomology quotient, including degree zero. -/
abbrev Cohomology {X : Type u} {V : Type v} [AddCommGroup V]
    (S : ∀ n : ℕ, AddSubgroup (Cochain X V n)) (n : ℕ) :=
  (cocycles S n) ⧸ boundaries S n

/-- The identity-on-global-functions map on cycles for an inclusion of cochain
families (PDF pp. 2–3). -/
def cycleInclusion {X : Type u} {V : Type v} [AddCommGroup V]
    {S T : ∀ n : ℕ, AddSubgroup (Cochain X V n)} (h : ∀ n, S n ≤ T n) (n : ℕ) :
    cocycles S n →+ cocycles T n :=
  AddSubgroup.inclusion (fun _ hf => ⟨h n hf.1, hf.2⟩)

/-- PDF pp. 2–3: the actual map on cohomology induced by inclusion, computed on
representatives by the identity and descended through the boundary quotient. -/
def cohomologyInclusion {X : Type u} {V : Type v} [AddCommGroup V]
    {S T : ∀ n : ℕ, AddSubgroup (Cochain X V n)} (h : ∀ n, S n ≤ T n) (n : ℕ) :
    Cohomology S n →+ Cohomology T n :=
  QuotientAddGroup.map (boundaries S n) (boundaries T n) (cycleInclusion h n) (by
    intro z hz
    cases n with
    | zero =>
      have hz0 : z = 0 := hz
      change cycleInclusion h 0 z ∈ (⊥ : AddSubgroup (cocycles T 0))
      simp [hz0]
    | succ k =>
      change z.val ∈ ((differential k).comp (S k).subtype).range at hz
      obtain ⟨b, hb⟩ := hz
      change (cycleInclusion h (k + 1) z).val ∈
        ((differential k).comp (T k).subtype).range
      exact ⟨⟨b.val, h k b.property⟩, hb⟩)

example {X : Type u} {V : Type v} [AddCommGroup V]
    (S : ∀ n : ℕ, AddSubgroup (Cochain X V n)) :
    boundaries S 0 = ⊥ := rfl

example {X : Type u} {V : Type v} [AddCommGroup V]
    {S T : ∀ n : ℕ, AddSubgroup (Cochain X V n)} (h : ∀ n, S n ≤ T n)
    (n : ℕ) (f : cocycles S n) :
    cohomologyInclusion h n (QuotientAddGroup.mk f) =
      QuotientAddGroup.mk (cycleInclusion h n f) := rfl

/-- PDF p. 2: continuous equivariant cochains. -/
def continuousEquivariant (G : Type w) {X : Type u} {V : Type v}
    [Group G] [MulAction G X] [TopologicalSpace X] [TopologicalSpace V]
    [AddCommGroup V] [IsTopologicalAddGroup V] [DistribMulAction G V] (n : ℕ) :
    AddSubgroup (Cochain X V n) :=
  continuousCochains n ⊓ equivariantCochains G n

/-- PDF p. 3: locally continuous equivariant global cochains. -/
def germEquivariant (G : Type w) {X : Type u} {V : Type v}
    [Group G] [MulAction G X] [TopologicalSpace X] [TopologicalSpace V]
    [AddCommGroup V] [IsTopologicalAddGroup V] [DistribMulAction G V] (n : ℕ) :
    AddSubgroup (Cochain X V n) :=
  germCochains n ⊓ equivariantCochains G n

/-- PDF p. 2: inclusion of continuous into locally continuous equivariant cochains.
The one-member cover suffices for every globally continuous cochain. -/
def continuousToGerm {G : Type w} {X : Type u} {V : Type v}
    [Group G] [MulAction G X] [TopologicalSpace X] [TopologicalSpace V]
    [AddCommGroup V] [IsTopologicalAddGroup V] [DistribMulAction G V] (n : ℕ) :
    continuousEquivariant G (X := X) (V := V) n ≤ germEquivariant G n := by
  intro f hf
  refine ⟨?_, hf.2⟩
  let U : OpenCover X :=
    { sets := {Set.univ}
      isOpen := by
        intro W hW
        have hW0 : W = Set.univ := Set.mem_singleton_iff.mp hW
        rw [hW0]
        exact isOpen_univ
      covers := by
        intro x
        exact ⟨Set.univ, Set.mem_singleton _, Set.mem_univ x⟩ }
  exact (le_iSup (fun U : OpenCover X => coverCochains (V := V) U n) U)
    hf.1.continuousOn

/-- PDF p. 8: the first-block continuous coefficient group, with no topology
on this mapping group required for the algebraic column calculation. -/
abbrev ColumnCoefficients (X : Type u) (V : Type v) [TopologicalSpace X]
    [TopologicalSpace V] (p : ℕ) := C((Fin (p + 1) → X), V)

/-- PDF p. 8, natural column augmentation: a coefficient is constant in the
second block. Under currying it sends `c` to `(x,y) ↦ c(x)`. -/
def columnAugmentation {X : Type u} {V : Type v} [TopologicalSpace X]
    [TopologicalSpace V] [AddCommGroup V] [IsTopologicalAddGroup V] (p : ℕ) :
    ColumnCoefficients X V p →+ Cochain X (ColumnCoefficients X V p) 0 where
  toFun c _ := c
  map_zero' := rfl
  map_add' _ _ := rfl

example {X : Type u} {V : Type v} [TopologicalSpace X] [TopologicalSpace V]
    [AddCommGroup V] [IsTopologicalAddGroup V] (p : ℕ)
    (c : ColumnCoefficients X V p) (y : Fin 1 → X) (x : Fin (p + 1) → X) :
    columnAugmentation p c y x = c x := rfl

end QAlgorithms.Papers.Independent.Intakenext100.P09


