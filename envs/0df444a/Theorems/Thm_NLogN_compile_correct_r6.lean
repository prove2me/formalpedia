open NLogN
open IntMul
variable {S P : ℕ}
variable {I : List Sym} {prog : Fin P → Stmt (S + 4) P}

theorem NLogN.compile_correct_r6 {iprog : Fin P → IStmt S P} (hprog : ∀ j, prog j = compile (iprog j))
    {p : IStmt S P} {s s' : IState S} {c : ℕ} (h : IExec I iprog p s s' c) :
    Runs I prog (compile p) (encI s) (encI s') c ∧
      ∀ i f b, p = .loop i f b →
        Runs I prog (inner i f b) (encF i f s) ((encI s').push (s3 S) 0) (c - 24) ∧ 24 ≤ c := by sorry
