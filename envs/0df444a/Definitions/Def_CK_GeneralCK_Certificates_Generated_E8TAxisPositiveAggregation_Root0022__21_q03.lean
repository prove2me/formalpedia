    norm_num [E8TAxisProd0025Geometry.rectangle, E8TAxisProd0025Geometry.sLower, E8TAxisProd0025Geometry.sUpper, E8TAxisProd0025Geometry.tLower, E8TAxisProd0025Geometry.tUpper]

