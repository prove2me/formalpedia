-- title:
--   Eq. (2.7) with $\lambda_k \equiv 1$ — summability of $\|\nabla h(x^i_g) - \nabla h(x^*)\|^2$
-- statement:
--   In the setting of problem (3.1) ($f, g$ closed, proper, convex; $h$ convex, differentiable, $\nabla h$ $\beta^{-1}$-Lipschitz, $\beta > 0$), let $\gamma \in (0, 2\beta)$ and let $(z^k, x^k_g)_{k \ge 0}$ be generated by Algorithm 2 with $\lambda_k \equiv 1$. Let $z^*$ be a fixed point of $T$ and $x^* = \operatorname{prox}_{\gamma g}(z^*)$. Then for every $\varepsilon$ with $\gamma/(2\beta) < \varepsilon < 1$ the series $\sum_i \|\nabla h(x^i_g) - \nabla h(x^*)\|^2$ converges and, for every $k \ge 0$,
--   $$\sum_{i=k}^{\infty} \|\nabla h(x^i_g) - \nabla h(x^*)\|^2 \le \frac{\|z^k - z^*\|^2}{\gamma\,(2\beta - \gamma/\varepsilon)} .$$
--
--   In the proof of Theorem 3.2 this bound (at $k = 0$) controls the accumulated gradient error of the weighted ergodic sum.
--
--   **Formalization Note** Eq. (2.7) is stated for Algorithm 1 with $C x^i_B - C J_{\gamma B}(z^*)$ and denominator $\gamma\lambda_k(2\beta - \gamma/\varepsilon)$; here $C = \nabla h$, $x^i_B = x^i_g$, $J_{\gamma B}(z^*) = x^*$ and $\lambda_k \equiv 1$. The range of $\varepsilon$ is Corollary 2.1's $\gamma \in (0, 2\beta\varepsilon)$, $\varepsilon \in (0,1)$. Summability is stated explicitly, so the infinite sum is a genuine limit.
-- source:
--   Davis and Yin, A Three-Operator Splitting Scheme and its Optimization Applications, Set-Valued Var. Anal. 25 (2017), https://doi.org/10.1007/s11228-017-0421-z, p. 836, Eq. (2.7) (proof of Theorem 2.1, Part 1), as used on p. 841

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_ThreeOpSplitting_ConvexRates_Algorithm

open InnerProductSpace Filter Topology

namespace ThreeOpSplitting.ConvexRates

/-- Eq. (2.7) for Algorithm 2 with `λ_k ≡ 1`: for every `ε ∈ (γ/(2β), 1)` the squared gradient
differences `‖∇h(x^i_g) - ∇h(x*)‖²`, `x* = prox_{γg}(z*)`, are summable and their tail from `k` is at
most `‖z^k - z*‖² / (γ(2β - γ/ε))`. -/
theorem gradient_tail_sum
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (f g : H → EReal) (h : H → ℝ) (β γ : ℝ) (hβ : 0 < β) (hγ : 0 < γ) (hγβ : γ < 2 * β)
    (hf : IsProperClosedConvex f) (hg : IsProperClosedConvex g) (hh : IsSmoothConvex β h)
    (proxf proxg : H → H) (hproxf : IsProx γ f proxf) (hproxg : IsProx γ g proxg)
    (z0 zstar : H) (hfix : splittingOp proxf proxg (gradient h) γ zstar = zstar)
    (ε : ℝ) (hε₁ : γ / (2 * β) < ε) (hε₂ : ε < 1) :
    Summable (fun i : ℕ => ‖gradient h (algXg proxf proxg (gradient h) γ z0 i) - gradient h (proxg zstar)‖ ^ 2) ∧
      ∀ k : ℕ, ∑' i : ℕ, ‖gradient h (algXg proxf proxg (gradient h) γ z0 (i + k)) - gradient h (proxg zstar)‖ ^ 2 ≤
        ‖algZ proxf proxg (gradient h) γ z0 k - zstar‖ ^ 2 / (γ * (2 * β - γ / ε)) := by sorry

end ThreeOpSplitting.ConvexRates
