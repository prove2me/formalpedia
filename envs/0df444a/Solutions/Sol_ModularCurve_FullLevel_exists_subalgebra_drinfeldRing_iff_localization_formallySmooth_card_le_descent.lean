            have hO'const : ∀ a' : AlgebraicClosure ℚ,
                algebraMap (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M') a' ∈ O' := by
              intro a'
              have e : IntermediateField.inclusion hle (algebraMap (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M') a') =
                  algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') a' := Subtype.ext rfl
              rw [hO', e]; exact hconstVt a'
            have hjO' : (⟨coeffEmb (AlgebraicClosure ℚ) jq, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ)
                (modularFunctionField_le_full M' (jq_mem M'))⟩ : ↥(modularFunctionFieldBar M')) ∈ O' := by
              rw [hO']
              exact (hVt' ⟨_, hjF₀⟩).mpr (hBV ⟨_, hJ⟩)
            have hgO' : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ :
                ↥(modularFunctionFieldBar M')) ∈ O' := by
              by_cases hO'top : O' = ⊤
              · rw [hO'top]; exact ValuationSubring.mem_top _
              obtain ⟨xT, -, hfin⟩ := ModularCurve.exists_transcendental_finiteDimensional_modularFunctionFieldBar M'
              haveI := hfin
              obtain ⟨v, hv⟩ := AlgebraicCurve.Place.exists_of_valuationSubring_of_finiteDimensional xT O' hO'const hO'top
              rw [← hv]
              by_cases hg0 : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ :
                  ↥(modularFunctionFieldBar M')) = 0
              · rw [hg0]; exact ValuationSubring.zero_mem _
              apply SSC.Place.mem_of_ord_nonneg v hg0
              apply hcusp v
              apply SSC.Place.ord_nonneg_of_mem v
              rw [hv]; exact hjO'
            have hGVt : Gf ∈ Vt := by rw [hGf]; exact (hO' _).mp hgO'

            exact (hVt' ⟨Gf, hGF₀⟩).mp hGVt
      obtain ⟨b₀, hb₀⟩ := hGB
      exact ⟨b₀, congrArg (fun z : ↥F₀ => (z : ↥(fieldBar q M'))) hb₀⟩
    obtain ⟨b₀, hb₀⟩ := hgB

    obtain ⟨a, ha⟩ := IsLocalRing.residue_surjective (R := ↥A)
      ((s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩))
    obtain ⟨c, hcA, hsub, hmax⟩ := hκ (a : AlgebraicClosure ℚ) a.2
    have hresc : residue A ⟨(c : (AlgebraicClosure ℚ)), hcA⟩ =
        (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩) := by
      rw [← ha]
      have : a - ⟨(c : AlgebraicClosure ℚ), hcA⟩ = ⟨(a : AlgebraicClosure ℚ) - c, hsub⟩ := Subtype.ext rfl
      have hq0 : residue A (a - ⟨(c : AlgebraicClosure ℚ), hcA⟩) = 0 := by
        rw [this]; exact (IsLocalRing.residue_eq_zero_iff _).mpr hmax
      rw [map_sub, sub_eq_zero] at hq0
      exact hq0.symm
    obtain ⟨hF, hGW, hGm⟩ := hK4 g hg hgi hcusp hgs
    obtain ⟨hm, hmm⟩ := hGm c hcA hresc

    obtain ⟨hπW, hunifW⟩ := hK2unif
    have hmm' := hmm
    rw [hunifW, Ideal.mem_span_singleton'] at hmm'
    obtain ⟨w, hw⟩ := hmm'
    have hwval : ((w : ↥W₀) : ↥F₀') * algebraMap ↥k₀ ↥F₀' π₀ = (⟨_, hF⟩ : ↥F₀') - algebraMap ↥k₀ ↥F₀' c :=
      congrArg (fun z : ↥W₀ => (z : ↥F₀')) hw
    obtain ⟨g₁, h₁, hndvd, hwh⟩ := (hM2loc (w : ↥F₀')).mp w.2
    let a₀ : A₀ := eT1.symm ⟨c, hcA⟩
    have ha₀ : (eT1 a₀ : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) = ⟨c, hcA⟩ := eT1.apply_symm_apply _
    have hca₀ : ((algebraMap A₀ ↥F₀ a₀ : ↥F₀) : ↥(fieldBar q M')) = algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ) := by
      rw [hj₀, ← heT1 a₀, ha₀]; rfl
    have hπ₀val : ((algebraMap ↥k₀ ↥F₀' π₀ : ↥F₀') : ↥(fieldBar q M')) = algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π := by
      show algebraMap ↥k₀ ↥(fieldBar q M') π₀ = _
      rw [← hπ₀π]; rfl
    have hcval : ((algebraMap ↥k₀ ↥F₀' c : ↥F₀') : ↥(fieldBar q M')) = algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ) := rfl
    have hϖval : ((@algebraMap ↥Ab ↥B_DL _ _ algDL ϖb : ↥B_DL) : ↥(fieldBar q M')) = algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π := by
      rw [hM1]
    have hϖ₀B : ((algebraMap A₀ ↥B ϖ₀ : ↥B) : ↥F₀).1 = algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π := by
      show ((algebraMap A₀ ↥F₀ ϖ₀ : ↥F₀) : ↥(fieldBar q M')) = _
      rw [hj₀, hϖ₀π]
    let xB : ↥B := b₀ - algebraMap A₀ ↥B a₀
    have hxBval : ((xB : ↥F₀) : ↥(fieldBar q M')) = Gf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ) := by
      rw [← hb₀, ← hca₀]; rfl
    have hGfF : ((⟨_, hF⟩ : ↥F₀') : ↥(fieldBar q M')) = Gf := by rw [hGf]
    have hkey : ψ xB * h₁ = @algebraMap ↥Ab ↥B_DL _ _ algDL ϖb * g₁ := by
      apply Subtype.ext
      show ((xB : ↥F₀) : ↥(fieldBar q M')) * (h₁ : ↥(fieldBar q M')) =
        ((@algebraMap ↥Ab ↥B_DL _ _ algDL ϖb : ↥B_DL) : ↥(fieldBar q M')) * (g₁ : ↥(fieldBar q M'))
      have e1 := congrArg (fun z : ↥F₀' => (z : ↥(fieldBar q M'))) hwval
      simp only [MulMemClass.coe_mul, AddSubgroupClass.coe_sub] at e1
      rw [hxBval, hϖval, ← hwh, ← hGfF]
      rw [hπ₀val, hcval] at e1
      rw [← e1]; ring
    have hdvd : @algebraMap ↥Ab ↥B_DL _ _ algDL ϖb ∣ ψ xB := by
      rcases hM2prime.dvd_or_dvd ⟨g₁, hkey⟩ with hd | hd
      · exact hd
      · exact absurd hd hndvd
    obtain ⟨b₁, hb₁⟩ := Ideal.mem_span_singleton'.mp (h𝔮₀span ▸ (hmem𝔮₀ xB).mpr hdvd)
    have hGc : Gf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ) =
        ((b₁ : ↥F₀) : ↥(fieldBar q M')) * algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π := by
      rw [← hxBval, ← hb₁, ← hϖ₀B]; rfl

    have hπmax : (⟨π, hπP⟩ : ↥A) ∈ maximalIdeal ↥A := by
      have hqmem : ((q : ℕ) : ↥A) ∈ maximalIdeal ↥A :=
        ValuationSubring.coe_mem_nonunits_iff.mp (by push_cast; exact hA)
      have hpow : (⟨π, hπP⟩ : ↥A) ^ (q ^ 2 - 1) = ((q : ℕ) : ↥A) := by
        apply Subtype.ext; push_cast; exact hπ
      exact (maximalIdeal.isMaximal ↥A).isPrime.mem_of_pow_mem _ (hpow ▸ hqmem)

    have hconst_max : ∀ (x : AlgebraicClosure ℚ) (hx : x ∈ A)
        (hxS : algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') x ∈ OSS s'),
        (⟨_, hxS⟩ : ↥(OSS s')) ∈ maximalIdeal ↥(OSS s') → (⟨x, hx⟩ : ↥A) ∈ maximalIdeal ↥A := by
      intro x hx hxS hxm
      rw [mem_maximalIdeal, mem_nonunits_iff] at hxm ⊢
      intro hu
      apply hxm
      obtain ⟨hx0, hxinv⟩ := (SSC.isUnit_iff_ne_zero_and_inv_mem A x hx).mp hu
      refine (SSC.isUnit_iff_ne_zero_and_inv_mem (OSS s') _ hxS).mpr ⟨?_, ?_⟩
      · intro h0
        exact hx0 ((map_eq_zero_iff _ (algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M')).injective).mp h0)
      · rw [← map_inv₀]; exact (hSS_A s' _).mpr hxinv
    have hπS : algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') π ∈ OSS s' := (hSS_A s' π).mpr hπP
    have hπSmax : (⟨_, hπS⟩ : ↥(OSS s')) ∈ maximalIdeal ↥(OSS s') := by
      rw [mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      obtain ⟨hπ0, hπinv⟩ := (SSC.isUnit_iff_ne_zero_and_inv_mem (OSS s') _ hπS).mp hu
      have hπinvA : π⁻¹ ∈ A := by
        rw [← hSS_A s', map_inv₀]; exact hπinv
      have hπ0' : (π : AlgebraicClosure ℚ) ≠ 0 := fun h0 => hπ0 (by rw [h0, map_zero])
      exact (mem_maximalIdeal _).mp hπmax ((SSC.isUnit_iff_ne_zero_and_inv_mem A π hπP).mpr ⟨hπ0', hπinvA⟩)
    have hGcS : ∃ hGc' : Gf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ) ∈ OSS s',
        (⟨_, hGc'⟩ : ↥(OSS s')) ∈ maximalIdeal ↥(OSS s') := by
      refine ⟨?_, ?_⟩
      · rw [hGc]; exact (OSS s').mul_mem _ _ (hBs' b₁) hπS
      · have : (⟨Gf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ),
            by rw [hGc]; exact (OSS s').mul_mem _ _ (hBs' b₁) hπS⟩ : ↥(OSS s')) =
            ⟨_, hBs' b₁⟩ * ⟨_, hπS⟩ := Subtype.ext hGc
        rw [this]
        exact Ideal.mul_mem_left _ _ hπSmax
    obtain ⟨hGc', hGcm⟩ := hGcS

    obtain ⟨a', ha'⟩ := IsLocalRing.residue_surjective (R := ↥A)
      ((s' : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩))
    obtain ⟨-, hover'⟩ := hSS_over s' _ hgi hcusp hgs'
    have hmm'' : ∃ hm'' : Gf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (a' : AlgebraicClosure ℚ) ∈ OSS s',
        (⟨_, hm''⟩ : ↥(OSS s')) ∈ maximalIdeal ↥(OSS s') := by
      subst hGf
      exact hover' a' ha'
    obtain ⟨hm', hmm'⟩ := hmm''

    have hdiffS : algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') ((a' : AlgebraicClosure ℚ) - c) ∈ OSS s' :=
      (hSS_A s' _).mpr (A.sub_mem a'.2 hcA)
    have hdiffm : (⟨_, hdiffS⟩ : ↥(OSS s')) ∈ maximalIdeal ↥(OSS s') := by
      have : (⟨_, hdiffS⟩ : ↥(OSS s')) = ⟨_, hGc'⟩ - ⟨_, hm'⟩ := by
        apply Subtype.ext
        show algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') ((a' : AlgebraicClosure ℚ) - c) =
          (Gf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ)) -
            (Gf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (a' : AlgebraicClosure ℚ))
        rw [map_sub]; ring
      rw [this]
      exact Ideal.sub_mem _ hGcm hmm'
    have hdiffA := hconst_max _ (A.sub_mem a'.2 hcA) hdiffS hdiffm
    have hres0 : residue A a' = residue A ⟨(c : (AlgebraicClosure ℚ)), hcA⟩ := by
      have : (⟨(a' : AlgebraicClosure ℚ) - c, A.sub_mem a'.2 hcA⟩ : ↥A) = a' - ⟨(c : AlgebraicClosure ℚ), hcA⟩ := Subtype.ext rfl
      rw [this] at hdiffA
      have h0 : residue A (a' - ⟨(c : AlgebraicClosure ℚ), hcA⟩) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hdiffA
      rw [map_sub, sub_eq_zero] at h0
      exact h0
    exact hsep (by rw [← hresc, ← hres0, ha'])

  have hends : ∀ E : Finset (ValuationSubring ↥F₀),
      (∀ V ∈ E, (∀ f : ↥F₀, f ∈ V → (f : ↥(fieldBar q M')) ∈ OSS s) ∧
        (∃ f : ↥F₀, (f : ↥(fieldBar q M')) ∈ OSS s ∧ f ∉ V) ∧ (∃ b : ↥B, (b : ↥F₀) ∉ V)) →
      E.card ≤ q + 1 := by

    obtain ⟨FI, _instFI, _instAlgFI, R, hRW₀, hRres⟩ :=
      ModularCurve.FullLevel.exists_regularProlongation_integers_inter_levelField_eq_of_isDiscreteValuationRing
        q M' A hA k₀ π₀ hπ₀A hdvr hunif hhens hresk hκ F₀' hK1 W₀ hK2a hK2dvr hK2unif

    obtain ⟨ιG⟩ := ValuationSubring.nonempty_ringHom_residueField_of_finite_of_charP q A hA (GaloisField q 2)
    letI instG : Algebra (GaloisField q 2) (ResidueField ↥A) := ιG.toAlgebra
    haveI hdomC : IsDomain (DrinfeldCurve.CoordRing q (ResidueField ↥A)) :=
      DrinfeldCurve.isDomain_coordRing_of_ne_one q (Fact.out : q.Prime).one_lt.ne' (ResidueField ↥A)
    haveI halgc : IsAlgClosed (ResidueField ↥A) := ValuationSubring.isAlgClosed_residueField_of_isAlgClosed A
    have hdvrb : IsDiscreteValuationRing ↥Ab := SSC.isDiscreteValuationRing_of_ringEquiv eB
    have hhensb : HenselianLocalRing ↥Ab := SSC.henselianLocalRing_of_ringEquiv eB
    obtain ⟨N, Sb, φb, χb, Db, hNcard, hNchar, -⟩ :=
      ModularCurve.FullLevel.supersingularProlongation_ends_baseSmoothPointStalks_localization_of_affineChart
        q hq M' hqM' A hA W hW hle s k₀ π₀ hπ₀A hdvr hunif hhens hresk hκ halgc instG hdomC ζ Kb hKb Ab hAb hdvrb hhensb
        ϖb hϖb hϖb0 F₀' W₀ hK1 hK2a hK2dvr hK2unif hLD B_DL algDL hM1 hM0a hM0b hM4fs hM4fp hM4dim hM2a hM2prime hM2loc
        hM5j hM5aut hM3 FI R hRW₀

    let incl : ↥W₀ →+* ↥R.integers :=
      { toFun := fun w => ⟨((w : ↥F₀') : ↥(fieldBar q M')), (hRW₀ (w : ↥F₀')).mpr w.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let θ : ↥W₀ →+* FI := R.residue.comp incl
    have hθ : ∀ w : ↥W₀, θ w = R.residue ⟨((w : ↥F₀') : ↥(fieldBar q M')), (hRW₀ (w : ↥F₀')).mpr w.2⟩ := fun _ => rfl
    have hθsurj : Function.Surjective θ := by
      intro z
      obtain ⟨f, hf, hfz⟩ := hRres z
      exact ⟨⟨f, (hRW₀ f).mp hf⟩, hfz⟩
    have hθker : ∀ w : ↥W₀, θ w = 0 → w ∈ maximalIdeal ↥W₀ := by
      intro w h0
      have hm : incl w ∈ maximalIdeal ↥R.integers := by
        rw [← R.ker_residue]; exact h0
      rw [mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (mem_maximalIdeal _).mp hm (hu.map incl)

    have hκO : ∀ (O : ValuationSubring FI) (r : ResidueField ↥A), algebraMap (ResidueField ↥A) FI r ∈ O := by
      intro O r
      obtain ⟨eκ⟩ := ValuationSubring.nonempty_residueField_algEquiv_algebraicClosure_galoisField q A hA ιG
      haveI : Algebra.IsAlgebraic (GaloisField q 2) (ResidueField ↥A) :=
        (AlgEquiv.isAlgebraic_iff eκ).mpr (AlgebraicClosure.isAlgebraic _)
      have htop := SSC.valuationSubring_eq_top_of_isAlgebraic_of_finite (GaloisField q 2) (ResidueField ↥A)
        (O.comap (algebraMap (ResidueField ↥A) FI))
      have : r ∈ O.comap (algebraMap (ResidueField ↥A) FI) := by rw [htop]; exact ValuationSubring.mem_top r
      exact ValuationSubring.mem_comap.mp this

    have hFtr : ∃ x : ↥(fieldBar q M'), Transcendental (AlgebraicClosure ℚ) x ∧
        FiniteDimensional ↥(IntermediateField.adjoin (AlgebraicClosure ℚ) ({x} : Set ↥(fieldBar q M'))) ↥(fieldBar q M') := by
      haveI : NeZero (q ^ 2 * M') := ⟨mul_ne_zero (pow_ne_zero 2 (Fact.out : q.Prime).ne_zero) (NeZero.ne M')⟩
      haveI : (CohCarrier.GammaH (q ^ 2 * M') (levelH q M')).FiniteIndex :=
        Subgroup.finiteIndex_of_le (ModularCurve.Gamma1_le_GammaH (q ^ 2 * M') (levelH q M'))
      let ĵF : ↥(fieldBar q M') := IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M'))
      have hĵF : ((ĵF : ↥(fieldBar q M')) : LaurentSeries (AlgebraicClosure ℚ)) = jqModC (AlgebraicClosure ℚ) := by
        show coeffEmb (AlgebraicClosure ℚ) jq = _
        change (jqModC ℚ).map (algebraMap ℚ (AlgebraicClosure ℚ)) = _
        exact map_jqModC _
      exact ⟨ĵF, ModularCurve.transcendental_and_finiteDimensional_adjoin_laurentBaseChange_qExpFunctionFieldC_of_coe_eq_jqModC
        (AlgebraicClosure ℚ) (CohCarrier.GammaH (q ^ 2 * M') (levelH q M')) (ModularCurve.translation_mem_GammaH _ _) ĵF hĵF⟩
    have hFItr : ∃ t : FI, Transcendental (ResidueField ↥A) t := by
      obtain ⟨t, ht⟩ := hTR
      refine ⟨θ t, SSC.transcendental_of_not_mem_range (θ t) ?_⟩
      rintro ⟨r, hr⟩

      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective (R := ↥A) r
      obtain ⟨c, hcA, hsub, hmax⟩ := hκ (a : AlgebraicClosure ℚ) a.2
      have hresc : residue A a = residue A ⟨(c : (AlgebraicClosure ℚ)), hcA⟩ := by
        have : a - ⟨(c : AlgebraicClosure ℚ), hcA⟩ = ⟨(a : AlgebraicClosure ℚ) - c, hsub⟩ := Subtype.ext rfl
        have hq0 : residue A (a - ⟨(c : AlgebraicClosure ℚ), hcA⟩) = 0 := by
          rw [this]; exact (IsLocalRing.residue_eq_zero_iff _).mpr hmax
        rw [map_sub, sub_eq_zero] at hq0
        exact hq0

      let wc : ↥W₀ := ⟨algebraMap ↥k₀ ↥F₀' c, (hK2a c).mp hcA⟩
      have hθc : θ wc = algebraMap (ResidueField ↥A) FI (residue A ⟨(c : (AlgebraicClosure ℚ)), hcA⟩) := by
        rw [hθ, ← R.residue_algebraMap ⟨(c : (AlgebraicClosure ℚ)), hcA⟩]
        congr 1
      have h0 : θ (t - wc) = 0 := by rw [map_sub, hθc, ← hresc, hr, sub_self]
      have hm := hθker _ h0
      exact (mem_maximalIdeal _).mp hm (ht c hcA)
    obtain ⟨-, -, xb, -, hxbfin⟩ :=
      AlgebraicCurve.RegularProlongation.isCurveOver_and_essFiniteType_of_exists_transcendental hFtr R hFItr
    haveI := hxbfin

    intro E hE
    have hdict : ∀ V ∈ E, ∃ Q ∈ N, ∀ w : ↥W₀, θ w ∈ Q.toValuationSubring ↔ (w : ↥F₀') ∈ (V : ValuationSubring ↥F₀') := by
      intro V hV
      obtain ⟨hVle, ⟨f, hfS, hfV⟩, ⟨b, hbV⟩⟩ := hE V hV
      have hVle' : ∀ g : ↥F₀', g ∈ (V : ValuationSubring ↥F₀') → g ∈ W₀ :=
        fun g hg => (hSSID (g : ↥(fieldBar q M')) g.2).mpr (hVle ⟨(g : ↥(fieldBar q M')), g.2⟩ hg)
      obtain ⟨O, hO⟩ := SSC.exists_valuationSubring_apply_mem_iff W₀ θ hθsurj hθker (V : ValuationSubring ↥F₀') hVle'

      have hOtop : O ≠ ⊤ := by
        intro htop
        have hfW : (⟨(f : ↥(fieldBar q M')), f.2⟩ : ↥F₀') ∈ W₀ := (hSSID _ f.2).mpr hfS
        have : θ ⟨_, hfW⟩ ∈ O := by rw [htop]; exact ValuationSubring.mem_top _
        exact hfV ((hO _).mp this)

      obtain ⟨Q, hQ⟩ := AlgebraicCurve.Place.exists_of_valuationSubring_of_finiteDimensional xb O (hκO O) hOtop
      refine ⟨Q, ?_, fun w => by rw [hQ]; exact hO w⟩

      by_contra hQN
      obtain ⟨hbF, hbW⟩ := hM2a _ b.2
      have hbR : (((ψ b : ↥B_DL) : ↥(fieldBar q M'))) ∈ R.integers := (hRW₀ ⟨_, hbF⟩).mpr hbW
      have h1 := (hNchar Q).mp hQN (ψ b) hbR
      rw [hQ] at h1
      have h2 : θ ⟨⟨_, hbF⟩, hbW⟩ ∈ O := h1
      exact hbV ((hO _).mp h2)

    choose Φ hΦN hΦ using hdict
    let g : ↥E → ↥N := fun V => ⟨Φ V.1 V.2, hΦN V.1 V.2⟩
    have hg : Function.Injective g := by
      rintro ⟨V₁, hV₁⟩ ⟨V₂, hV₂⟩ h
      have hQ : Φ V₁ hV₁ = Φ V₂ hV₂ := congrArg Subtype.val h
      apply Subtype.ext
      ext x
      by_cases hxW : (⟨(x : ↥(fieldBar q M')), x.2⟩ : ↥F₀') ∈ W₀
      · have e1 := hΦ V₁ hV₁ ⟨_, hxW⟩
