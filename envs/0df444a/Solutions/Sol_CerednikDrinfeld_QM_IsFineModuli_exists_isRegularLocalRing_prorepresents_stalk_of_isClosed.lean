theorem natCast_mem_maximalIdeal_stalk {M₁ : Scheme.{0}} (π₁ : M₁ ⟶ Spec (CommRingCat.of ℤ_[q]))
    (x : M₁) (hxq : π₁ x = closedPoint ℤ_[q]) :
    ((q : ℕ) : M₁.presheaf.stalk x) ∈ maximalIdeal (M₁.presheaf.stalk x) := by
  obtain ⟨φ, hφ⟩ := Spec.map_surjective (M₁.fromSpecStalk x ≫ π₁)
  have h1 : Spec.map φ (closedPoint (M₁.presheaf.stalk x)) = closedPoint ℤ_[q] := by
    rw [hφ, Scheme.Hom.comp_apply, Scheme.fromSpecStalk_closedPoint, hxq]
  rw [Spec.map_apply] at h1
  haveI : IsLocalHom φ.hom :=
    (IsLocalRing.isLocalHom_iff_comap_closedPoint φ.hom).mpr h1
  have h2 : ((q : ℕ) : ℤ_[q]) ∈ maximalIdeal ℤ_[q] := PadicInt.p_nonunit
  have h3 := map_nonunit φ.hom ((q : ℕ) : ℤ_[q]) h2
  rwa [map_natCast] at h3

theorem exists_xbar {M₁ : Scheme.{0}} (π₁ : M₁ ⟶ Spec (CommRingCat.of ℤ_[q])) [LocallyOfFiniteType π₁]
    (x : M₁) (hx : IsClosed ({x} : Set M₁)) (hxq : π₁ x = closedPoint ℤ_[q])
    (k : Type) [Field k] [IsAlgClosed k] [CharP k q] :
    ∃ xbar : M₁.presheaf.stalk x →+* k, RingHom.ker xbar = maximalIdeal (M₁.presheaf.stalk x) := by
  haveI : Finite (ResidueField (M₁.presheaf.stalk x)) :=
    AlgebraicGeometry.finite_residueField_stalk_of_isClosed_of_locallyOfFiniteType π₁ x hx hxq
  haveI : CharP (ResidueField (M₁.presheaf.stalk x)) q :=
    charP_residueField _ (natCast_mem_maximalIdeal_stalk π₁ x hxq)
  letI : Algebra (ZMod q) (ResidueField (M₁.presheaf.stalk x)) := ZMod.algebra _ q
  letI : Algebra (ZMod q) k := ZMod.algebra _ q
  haveI : Algebra.IsAlgebraic (ZMod q) (ResidueField (M₁.presheaf.stalk x)) :=
    Algebra.IsAlgebraic.of_finite (ZMod q) _
  let e : ResidueField (M₁.presheaf.stalk x) →+* k :=
    (IsAlgClosed.lift : ResidueField (M₁.presheaf.stalk x) →ₐ[ZMod q] k).toRingHom
  refine ⟨e.comp (residue _), ?_⟩
  rw [← RingHom.comap_ker, (RingHom.injective_iff_ker_eq_bot e).mp e.injective, ← RingHom.ker,
    ker_residue]

