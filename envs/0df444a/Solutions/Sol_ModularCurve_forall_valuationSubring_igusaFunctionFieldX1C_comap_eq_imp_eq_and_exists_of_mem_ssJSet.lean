  have hab : (⟨w.hasseRootFn, ModularCurve.hasseRootFn_mem_igusaFunctionFieldX1C κ M w⟩ : ↥(ModularCurve.igusaFunctionFieldX1C κ M w)) ^ (p - 1) =
