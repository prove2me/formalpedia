-- Source module: Solutions.J6SegILJKer1
/-!
# B-line IL, the `J` kernel (B4), part 1: list model and arithmetic

The `J` kernel `jKer` (J6SegSw3) of a padded `G`-row `v` is

  `jKer v = W ++ 0^{G-m}`, `W_r = dotF (cc_r) ((zext K z).drop r)`,
  `z = bwdK bs (fwdK fs (v.take m) []) [] []`

for the coefficient streams `fs = fsOf …`, `bs = bsOf …`, `cc_r = ccL … r`. This file gives

* the generic kernel `jKerG P K G m fs bs cc v` (any streams) and the step forms of `fwdK`
  (`fA_succ`), `bwdK` (`bwdS_succ`) and `dotF` on prefixes (`dotF_take_succ`);
* the arithmetic of the IL: `ediv_of_tdiv` (floor division from `tdiv`/`tmod`), `rs_eq`
  (`rs P x = ⌊(2x + 2^P) / 2^{P+1}⌋`) and **`fdiv_recip`**: with `|2 a 2^P + pv| < 2^k` and
  `pv > 0`, `fdiv P a pv` is `q₀ + δ` where `q₀ = ⌊N iv / 2^k⌋` (`iv = ivOf k pv = ⌊2^k / 2pv⌋`)
  and the correction `δ ∈ {-1,0,1}` is read off the signs of `N - q₀ D` and `N - q₀ D - D`
  (`N = 2 a 2^P + pv`, `D = 2 pv`): two multiplications instead of a long division.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.JK

open Finset

/-! ## Arithmetic -/

theorem rs_eq (P : ℕ) (x : ℤ) : J6Seg.rs P x = (2 * x + 2 ^ P) / 2 ^ (P + 1) := by
  simp only [J6Seg.rs, J6Seg.rq, pow_succ]; ring_nf

/-! ## `dotF` on prefixes -/

/-! ## The forward kernel by steps -/

theorem fwdK_snoc (P : ℕ) : ∀ (a : List (List ℤ)) (b : List ℤ) (acc : List ℤ) (c : List ℤ) (y : ℤ),
    a.length = b.length →
    fwdK P (a ++ [c]) (b ++ [y]) acc = (y - dotF P c (fwdK P a b acc)) :: fwdK P a b acc
  | [], [], acc, c, y, _ => by simp [fwdK]
  | [], _ :: _, _, _, _, h => by simp at h
  | _ :: _, [], _, _, _, h => by simp at h
  | cs :: css, z :: zs, acc, c, y, h => by
    simp only [List.cons_append, fwdK]
    exact fwdK_snoc P css zs _ c y (by simpa using h)

theorem fA_zero (P : ℕ) (fs : List (List ℤ)) (v : List ℤ) : fA P fs v 0 = [] := by simp [fA, fwdK]

theorem fA_succ (P : ℕ) (fs : List (List ℤ)) (v : List ℤ) {r : ℕ} (hf : r < fs.length)
    (hv : r < v.length) : fA P fs v (r + 1) = (v[r] - dotF P fs[r] (fA P fs v r)) :: fA P fs v r := by
  unfold fA
  rw [← List.take_concat_get' fs r hf, ← List.take_concat_get' v r hv]
  exact fwdK_snoc P _ _ [] _ _ (by simp; omega)

theorem fA_length (P : ℕ) (fs : List (List ℤ)) (v : List ℤ) {r : ℕ} (hf : r ≤ fs.length)
    (hv : r ≤ v.length) : (fA P fs v r).length = r := by
  induction r with
  | zero => simp [fA_zero]
  | succ r ih => rw [fA_succ P fs v (by omega) (by omega), List.length_cons, ih (by omega) (by omega)]

