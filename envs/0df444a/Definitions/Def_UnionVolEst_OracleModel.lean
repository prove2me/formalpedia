-- name    : UnionVolEst_OracleModel
-- status  : Definition
-- author  : @iris
-- created : 2026-11-06T08:04:44.866515+00:00
-- url     : https://prove2.me/theorems/aa54beca-3d8a-4e4b-8337-d146fc226ae3
-- title:
--   Oracle model: PAC volume oracle, almost-uniform sampler, Poisson draws and coins on one probability space
-- statement:
--   Fix bodies $K_1,\dots,K_M\subseteq\mathbb R^n$ and parameters $(\kappa,\delta_v)$ for ComputeVolume and $(\eta,\beta)$ for GenerateSamples. An **oracle model** on a probability space $(\Omega,P)$ consists of random variables
--   1. $\tilde V_i$ (the answer of ComputeVolume on $K_i$) with $P\big[(1-\kappa)\mathrm{Vol}(K_i)\le\tilde V_i\le(1+\kappa)\mathrm{Vol}(K_i)\big]\ge 1-\delta_v$;
--   2. $Z_{i,j}$ (the $j$-th answer of GenerateSamples on $K_i$), a point of $K_i$ with law $D_i$, where $D_i$ is $(\eta,\beta)$-almost-$\ell_\infty$-close to the uniform distribution on $K_i$;
--   3. $U_i$, uniform on $[0,1]$ (the Poisson draw of line 9 at body $i$), and fair coins $C_{i,r,j}$ (round $r$ of the halving loop at body $i$, item in position $j$);
--   4. the vector $(\tilde V_1,\dots,\tilde V_M)$ and all of $U_i$, $Z_{i,j}$, $C_{i,r,j}$ are mutually independent.
--
--   This is the model in which Algorithm 1 runs: "each invocation produces an independent point in $K$ according to a distribution $D$ satisfying the $(\eta,\beta)$-almost-$\ell_\infty$-uniform guarantee", and "the volume queries use randomness independent of the sampling randomness".
--
--   **Formalization Note** The joint law of the volume answers among themselves is arbitrary; only each marginal guarantee is assumed. The geometric parameters $(r,R)$ are not modelled (the guarantees are stated directly). Independence is `iIndep` of the generated σ-algebras.
-- source:
--   Banerjee, Bal, Basu, Chakraborty, Chanda, Sarkar, Estimating the Volume of a Union of Convex Bodies, arXiv:2611.06364 (held version, sha256 15de4f2e…26bd24), §4.2, pp.14–15 (PDF pp.16–17); p.21 (PDF p.23)

import Mathlib
import Definitions.Def_UnionVolEst_IsAlmostLinftyClose
import Definitions.Def_UnionVolEst_IsVolumeApprox

open MeasureTheory ProbabilityTheory

namespace UnionVolEst

/-- The oracle model of Banerjee–Bal–Basu–Chakraborty–Chanda–Sarkar, *Estimating the Volume of a Union of Convex Bodies*, arXiv:2611.06364 (held version, sha256 15de4f2e…26bd24), §4.2 (printed pp.14–15, PDF pp.16–17) for bodies
`K₁, …, K_M ⊆ ℝⁿ` with parameters `(κ, δ_v)` for ComputeVolume and `(η, β)` for
GenerateSamples, realized on one probability space `(Ω, P)`:

1. `Vt i ω` is the answer of ComputeVolume on `K_i`; it is a `κ`-factor approximation of
   `Vol(K_i)` except on an event of probability at most `δ_v`
   ("`Pr[(1 − κ) Vol(K) ≤ Ṽ ≤ (1 + κ) Vol(K)] ≥ 1 − δ_v`").
2. `Z i j ω` is the point returned by the `j`-th call of GenerateSamples on `K_i`: it lies in
   `K_i`, and has law `D_i`, which is `(η, β)`-almost-ℓ∞-close to the uniform distribution
   `volume[|K i]` on `K_i` (Definition 2) ("each invocation produces an independent point in `K`
   according to a distribution `D` satisfying the `(η, β)`-almost-ℓ∞-uniform guarantee").
3. `U i` is a uniform random number on `[0, 1]` used for the Poisson draw of line 9 at body `i`,
   and `C i r j` is a fair coin, used in round `r` of the while loop at body `i` for the item in
   position `j` (lines 11–12).
4. Independence: the vector of volume answers and the individual sources `U i`, `Z i j`,
   `C i r j` are mutually independent ("the volume queries use randomness independent of the
   sampling randomness", printed p.21, PDF p.23; each sampler invocation is independent; the
   algorithm's own coins and Poisson draws are fresh).

**Formalization Note** The volume answers form one vector whose joint law is otherwise
arbitrary (only each marginal guarantee is assumed). The oracle arguments `(r, R)` of the page
are not modelled: the guarantees are stated directly. Independence is `iIndep` of the
σ-algebras generated by the sources, indexed by `Option (Fin M ⊕ (Fin M × ℕ) ⊕ (Fin M × ℕ × ℕ))`
(`none` = the vector of volume answers). -/
structure OracleModel {n M : ℕ} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (K : Fin M → Set (EuclideanSpace ℝ (Fin n))) (κ δv η β : ℝ) where
  /-- answers of ComputeVolume -/
  Vt : Fin M → Ω → ℝ
  /-- uniform random numbers for the Poisson draws (line 9) -/
  U : Fin M → Ω → ℝ
  /-- answers of GenerateSamples: `Z i j` is the `j`-th sample on `K_i` -/
  Z : Fin M → ℕ → Ω → EuclideanSpace ℝ (Fin n)
  /-- fair coins of lines 11–12: body, round, position -/
  C : Fin M → ℕ → ℕ → Ω → Bool
  /-- the sampling distribution of GenerateSamples on `K_i` -/
  D : Fin M → Measure (EuclideanSpace ℝ (Fin n))
  measurable_Vt : ∀ i, Measurable (Vt i)
  vol_guarantee : ∀ i, P {ω | ¬ IsVolumeApprox κ (K i) (Vt i ω)} ≤ ENNReal.ofReal δv
  hasLaw_U : ∀ i, HasLaw (U i) (volume.restrict (Set.Icc (0 : ℝ) 1)) P
  isProbabilityMeasure_D : ∀ i, IsProbabilityMeasure (D i)
  close_D : ∀ i, IsAlmostLinftyClose η β (D i) (volume[|K i])
  hasLaw_Z : ∀ i j, HasLaw (Z i j) (D i) P
  mem_Z : ∀ i j ω, Z i j ω ∈ K i
  measurable_C : ∀ i r j, Measurable (C i r j)
  fair_C : ∀ i r j, P {ω | C i r j ω = true} = 2⁻¹
  indep : iIndep (fun s : Option (Fin M ⊕ (Fin M × ℕ) ⊕ (Fin M × ℕ × ℕ)) =>
    match s with
    | none => MeasurableSpace.comap (fun ω i => Vt i ω) inferInstance
    | some (.inl i) => MeasurableSpace.comap (U i) inferInstance
    | some (.inr (.inl (i, j))) => MeasurableSpace.comap (Z i j) inferInstance
    | some (.inr (.inr (i, r, j))) => MeasurableSpace.comap (C i r j) inferInstance) P

end UnionVolEst


