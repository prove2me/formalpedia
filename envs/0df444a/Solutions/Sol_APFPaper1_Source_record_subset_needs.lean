import Definitions.Def_APFPaper1_OneRecordEach
import Definitions.Def_APF_B05_DeclaredInput_r2

set_option autoImplicit false

open APFPaper5.K1

namespace APFPaper1.Source

section
variable {D P R Record : Type*}
variable (wholeResource : P → R) (calibration : R → NNReal) (maintained : P → Set Record)
  (sufficient : P → Set Record → D → Prop) (usesToRealize : P → D → Set Record → Prop)

/-- One record each gives keeping-draws. -/
theorem keepingDraws_of_oneRecordEach_p2mProof
    (h : OneRecordEach maintained sufficient usesToRealize) :
    KeepingDraws maintained sufficient usesToRealize := by
  obtain ⟨recordOf, hrec⟩ := h
  intro p S hsub d hd
  refine (hrec p d).mpr (fun a ha => hsub ?_)
  show ∀ q : P, SourceServes maintained sufficient usesToRealize q S → a ∈ maintained q
  intro q hq
  exact (hrec q d).mp (hq d hd) ha

/-- Keeping-draws gives one record each: the record of a distinction is what it needs when held alone. -/
theorem oneRecordEach_of_keepingDraws_p2mProof
    (h : KeepingDraws maintained sufficient usesToRealize) :
    OneRecordEach maintained sufficient usesToRealize := by
  refine ⟨fun d => sourceNeeds maintained sufficient usesToRealize {d}, fun p d => ⟨?_, ?_⟩⟩
  · intro hdraw a ha
    have ha' : a ∈ sourceNeeds maintained sufficient usesToRealize ({d} : Finset D) := ha
    refine ha' p ?_
    intro e he
    rw [Finset.mem_singleton.mp he]
    exact hdraw
  · intro hsub
    exact h p {d} hsub d (Finset.mem_singleton_self d)

/-- "A distinction is recorded one way" and the keeping-draws clause of pass 115 say the same. -/
theorem oneRecordEach_iff_keepingDraws_p2mProof :
    OneRecordEach maintained sufficient usesToRealize ↔
      KeepingDraws maintained sufficient usesToRealize :=
  ⟨keepingDraws_of_oneRecordEach_p2mProof maintained sufficient usesToRealize,
    oneRecordEach_of_keepingDraws_p2mProof maintained sufficient usesToRealize⟩

/-- With one record each, what a protocol draws is its records' own. -/
theorem drawingCarries_of_oneRecordEach_p2mProof
    (h : OneRecordEach maintained sufficient usesToRealize) :
    DrawingCarries maintained sufficient usesToRealize := by
  obtain ⟨recordOf, hrec⟩ := h
  intro p q d hpq hdraw
  exact (hrec q d).mpr (Set.Subset.trans ((hrec p d).mp hdraw) hpq)

/-- With one record each, a family needs the record of each of its members. -/
theorem record_subset_needs_p2mProof (recordOf : D → Set Record)
    (hrec : ∀ (p : P) (d : D),
      (∃ sigma : Set Record,
          sigma ⊆ maintained p ∧ sufficient p sigma d ∧ usesToRealize p d sigma) ↔
        recordOf d ⊆ maintained p)
    (S : Finset D) (d : D) (hd : d ∈ S) :
    recordOf d ⊆ sourceNeeds maintained sufficient usesToRealize S := by
  intro a ha
  show ∀ q : P, SourceServes maintained sufficient usesToRealize q S → a ∈ maintained q
  intro q hq
  exact (hrec q d).mp (hq d hd) ha

/-- With one record each, where some protocol maintains exactly the record of a distinction: that record
is what the distinction needs when held alone. -/
theorem needs_singleton_eq_record_p2mProof (recordOf : D → Set Record)
    (hrec : ∀ (p : P) (d : D),
      (∃ sigma : Set Record,
          sigma ⊆ maintained p ∧ sufficient p sigma d ∧ usesToRealize p d sigma) ↔
        recordOf d ⊆ maintained p)
    (d : D) (q : P) (hq : maintained q = recordOf d) :
    sourceNeeds maintained sufficient usesToRealize ({d} : Finset D) = recordOf d := by
  apply Set.Subset.antisymm
  · intro a ha
    have hserve : SourceServes maintained sufficient usesToRealize q {d} := by
      intro e he
      rw [Finset.mem_singleton.mp he]
      exact (hrec q d).mpr hq.symm.subset
    have h1 : a ∈ maintained q := ha q hserve
    rw [hq] at h1
    exact h1
  · exact record_subset_needs_p2mProof maintained sufficient usesToRealize recordOf hrec {d} d
      (Finset.mem_singleton_self d)

/-- Among the protocols that draw a family, one keeps the fewest records. -/
theorem exists_fewest_records_p2mProof (kept : P → Finset Record) (S : Finset D)
    (hfeas : familyFeasible maintained sufficient usesToRealize S) :
    ∃ p : P, SourceServes maintained sufficient usesToRealize p S ∧
      ∀ q : P, SourceServes maintained sufficient usesToRealize q S →
        (kept p).card ≤ (kept q).card := by
  classical
  have hex : ∃ n : ℕ, ∃ p : P, SourceServes maintained sufficient usesToRealize p S ∧
      (kept p).card = n := by
    obtain ⟨p, hp⟩ := hfeas
    exact ⟨(kept p).card, p, hp, rfl⟩
  obtain ⟨p, hp, hpn⟩ := Nat.find_spec hex
  refine ⟨p, hp, fun q hq => ?_⟩
  rw [hpn]
  exact Nat.find_min' hex ⟨q, hq, rfl⟩

/-- At epsilon: the cost of a family is the bill of a protocol that draws it and keeps the fewest
records. The infimum is attained. -/
theorem familyCost_eq_bill_of_fewest_p2mProof (kept : P → Finset Record) (eps : ℝ)
    (h : BillIsEpsilonPerRecord wholeResource calibration maintained kept eps) (heps : 0 ≤ eps)
    (S : Finset D) (p : P) (hp : SourceServes maintained sufficient usesToRealize p S)
    (hmin : ∀ q : P, SourceServes maintained sufficient usesToRealize q S →
      (kept p).card ≤ (kept q).card) :
    familyCost wholeResource calibration maintained sufficient usesToRealize S =
      eps * ((kept p).card : ℝ) := by
  unfold familyCost
  apply IsLeast.csInf_eq
  refine ⟨⟨p, hp, h.2 p⟩, ?_⟩
  intro c hc
  obtain ⟨q, hq, rfl⟩ := hc
  rw [h.2 q]
  have hcard : ((kept p).card : ℝ) ≤ ((kept q).card : ℝ) := by
    exact_mod_cast hmin q hq
  exact mul_le_mul_of_nonneg_left hcard heps

/-- At epsilon, with epsilon positive: adding a support-novel distinction to a family raises the cost of
the family by at least epsilon. Nothing else is used. -/
theorem marginal_step_ge_eps_of_bill_p2mProof [DecidableEq D] (kept : P → Finset Record) (eps : ℝ)
    (h : BillIsEpsilonPerRecord wholeResource calibration maintained kept eps) (heps : 0 < eps)
    (S : Finset D) (d : D)
    (hS : familyFeasible maintained sufficient usesToRealize S)
    (hT : familyFeasible maintained sufficient usesToRealize (insert d S))
    (hnov : supportNovel wholeResource calibration maintained sufficient usesToRealize S d) :
    eps ≤ familyCost wholeResource calibration maintained sufficient usesToRealize (insert d S) -
      familyCost wholeResource calibration maintained sufficient usesToRealize S := by
  obtain ⟨p0, hp0, hmin0⟩ := exists_fewest_records_p2mProof maintained sufficient usesToRealize kept S hS
  obtain ⟨q, hq, hminq⟩ :=
    exists_fewest_records_p2mProof maintained sufficient usesToRealize kept (insert d S) hT
  have hcS := familyCost_eq_bill_of_fewest_p2mProof wholeResource calibration maintained sufficient
    usesToRealize kept eps h heps.le S p0 hp0 hmin0
  have hcT := familyCost_eq_bill_of_fewest_p2mProof wholeResource calibration maintained sufficient
    usesToRealize kept eps h heps.le (insert d S) q hq hminq
  have hqS : SourceServes maintained sufficient usesToRealize q S :=
    fun e he => hq e (Finset.mem_insert_of_mem he)
  have hle : (kept p0).card ≤ (kept q).card := hmin0 q hqS
  have hne : (kept p0).card ≠ (kept q).card := by
    intro heq
    obtain ⟨eta, heta, hall⟩ := hnov
    refine hall q hqS ?_ ?_
    · rw [hcS, h.2 q, heq]
      linarith
    · obtain ⟨sigma, hsub, hsuff, _⟩ := hq d (Finset.mem_insert_self d S)
      exact ⟨sigma, hsub, hsuff⟩
  have hlt : (kept p0).card < (kept q).card := Nat.lt_of_le_of_ne hle hne
  have hcast : ((kept p0).card : ℝ) + 1 ≤ ((kept q).card : ℝ) := by
    exact_mod_cast Nat.succ_le_of_lt hlt
  have hmul := mul_le_mul_of_nonneg_left hcast heps.le
  rw [hcT, hcS]
  linarith

/-- Keeping-draws and at epsilon: where a protocol maintains exactly the records a family needs, the cost
of the family is epsilon for each record it needs. -/
theorem familyCost_eq_eps_mul_card_of_exact_keeper_p2mProof (kept : P → Finset Record) (eps : ℝ)
    (hkd : KeepingDraws maintained sufficient usesToRealize)
    (h : BillIsEpsilonPerRecord wholeResource calibration maintained kept eps) (heps : 0 ≤ eps)
    (p : P) (S : Finset D)
    (hexact : maintained p = sourceNeeds maintained sufficient usesToRealize S) :
    familyCost wholeResource calibration maintained sufficient usesToRealize S =
      eps * ((kept p).card : ℝ) := by
  refine familyCost_eq_bill_of_fewest_p2mProof wholeResource calibration maintained sufficient usesToRealize
    kept eps h heps S p (hkd p S hexact.symm.subset) (fun q hq => Finset.card_le_card ?_)
  intro a ha
  have h1 : a ∈ maintained p := by
    rw [h.1 p]
    exact Finset.mem_coe.mpr ha
  rw [hexact] at h1
  have h2 : a ∈ maintained q := h1 q hq
  rw [h.1 q] at h2
  exact Finset.mem_coe.mp h2

end

/-- At epsilon in every context, with epsilon positive: B05's declared form, with the same epsilon. -/
theorem marginalFloor_of_bill_p2mProof {Context : Type*} {D P R Record : Context → Type*}
    [∀ g, DecidableEq (D g)]
    (wholeResource : (g : Context) → P g → R g)
    (calibration : (g : Context) → R g → NNReal)
    (maintained : (g : Context) → P g → Set (Record g))
    (sufficient : (g : Context) → P g → Set (Record g) → D g → Prop)
    (usesToRealize : (g : Context) → P g → D g → Set (Record g) → Prop)
    (tested : (g : Context) → D g → Prop)
    (C epsilon : Context → ℝ)
    (kept : (g : Context) → P g → Finset (Record g))
    (h : ∀ g, 0 < epsilon g ∧
      BillIsEpsilonPerRecord (wholeResource g) (calibration g) (maintained g) (kept g)
        (epsilon g)) :
    APFB05.MarginalFloor wholeResource calibration maintained sufficient usesToRealize tested C
      epsilon := by
  intro g
  refine ⟨(h g).1, fun S d _ hS hT hnov => ?_⟩
  exact marginal_step_ge_eps_of_bill_p2mProof (wholeResource g) (calibration g) (maintained g)
    (sufficient g) (usesToRealize g) (kept g) (epsilon g) (h g).2 (h g).1 S d hS.1 hT.1 hnov

end APFPaper1.Source


