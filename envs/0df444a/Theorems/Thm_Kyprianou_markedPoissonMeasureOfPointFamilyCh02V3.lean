-- title:
--   Lemma 2.2: counting measure of marked Poisson points
-- statement:
--   Prove that the counting measure generated by an independently marked Poisson point family is a genuine Poisson random measure. Its counts on finite-intensity sets are finite, and evaluations over mutually disjoint measurable sets are independent. The Poisson count law is supplied by the corresponding proved Poisson family result.
-- source:
--   Kyprianou (2006), Lemma 2.2 and (2.6), pp. 37-38

import Mathlib
import Definitions.Def_LeanLevy_RandomMeasure_PoissonPointFamily
import Definitions.Def_LeanLevy_RandomMeasure_PoissonRandomMeasure
import Definitions.Def_KLSModular_LevyStochCalc_Poisson_RandomMeasure
import Definitions.Def_LeanLevy_Processes_LevyProcess
open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal
set_option autoImplicit false

namespace Kyprianou

theorem markedPoissonMeasureOfPointFamilyCh02V3
    {Ω E : Type} [MeasurableSpace Ω] [MeasurableSpace E]
    [Nonempty E] (P : Measure Ω) [IsProbabilityMeasure P]
    (m : Measure E) [SigmaFinite m]
    (K : ℕ → Ω → ℕ) (Y : ℕ → ℕ → Ω → E)
    (hfamily : ProbabilityTheory.IsPoissonPointFamily K Y m P) :
    (∀ (A : Set E), MeasurableSet A → m A < ⊤ →
      P.map (fun ω =>
        ProbabilityTheory.poissonRandomMeasure K Y ω A) =
        (ProbabilityTheory.poissonMeasure (m A).toNNReal).map
          (Nat.cast : ℕ → ENNReal)) ∧
    (∀ (A : Set E), MeasurableSet A → m A < ⊤ →
      ∀ᵐ ω ∂P, ∃ n : ℕ, ProbabilityTheory.poissonRandomMeasure K Y ω A = n) ∧
    (∀ {ι : Type} [Countable ι] (A : ι → Set E),
      (∀ i, MeasurableSet (A i)) →
      Pairwise (fun i j => Disjoint (A i) (A j)) →
      ProbabilityTheory.iIndepFun
        (fun i (ω : Ω) =>
          ProbabilityTheory.poissonRandomMeasure K Y ω (A i)) P) := by sorry

end Kyprianou
