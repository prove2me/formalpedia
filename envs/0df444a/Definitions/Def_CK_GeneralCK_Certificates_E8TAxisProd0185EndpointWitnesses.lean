    centerALowerYBox.Contains (Y (lower E8TAxisProd0185PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0185PaddedInputs.centerAInput.alpha = ((2216017656540843594568486214625237657012888708 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
