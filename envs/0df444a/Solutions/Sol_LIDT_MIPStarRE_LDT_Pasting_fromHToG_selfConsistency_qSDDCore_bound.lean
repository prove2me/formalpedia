/-!
# Section 12 pasting: from-H-to-G collapsed bounds

Collapses the paper endpoint `M₄` to the next Lean stage and records the scalar
bounds used by the final telescope.
-/

@[expose] public section

open LIDT.MIPStarRE.LDT.Pasting

open MIPStarRE.LDT
open MIPStarRE.LDT.ExpansionHypercubeGraph
open MIPStarRE.LDT.CommutativityPoints
open scoped BigOperators MatrixOrder _root_.Matrix ComplexOrder

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem solution
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters) [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (ψbi : _root_.LIDT.MIPStarRE.LDT.QuantumState (ι × ι))
    (family : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily params ι)
    (zeta : _root_.LIDT.MIPStarRE.LDT.Error)
    (hcompleted :
      _root_.LIDT.MIPStarRE.LDT.SDDRel ψbi
        (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Pasting.SliceQuestion params))
        (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyLeftFamily params family)
        (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyRightFamily params family)
        (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyError zeta))
    {n : ℕ} :
    _root_.LIDT.MIPStarRE.LDT.avgOver (_root_.LIDT.MIPStarRE.LDT.uniformDistribution (_root_.LIDT.MIPStarRE.LDT.Fq params × _root_.LIDT.MIPStarRE.LDT.PointTuple params n)) (fun q =>
      _root_.LIDT.MIPStarRE.LDT.qSDDCore ψbi
        (fun g : _root_.LIDT.MIPStarRE.LDT.Pasting.GHatOutcome params =>
          _root_.LIDT.MIPStarRE.LDT.leftTensor (ι₂ := ι) ((_root_.LIDT.MIPStarRE.LDT.Pasting.gHatIdxMeas params family q.1).outcome g))
        (fun g : _root_.LIDT.MIPStarRE.LDT.Pasting.GHatOutcome params =>
          _root_.LIDT.MIPStarRE.LDT.rightTensor (ι₁ := ι) ((_root_.LIDT.MIPStarRE.LDT.Pasting.gHatIdxMeas params family q.1).outcome g))) ≤
      2 * zeta := by
  have hscOp := _root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistency_sddOpRel params ψbi family zeta hcompleted
  have hprod := _root_.LIDT.MIPStarRE.LDT.Pasting.sddOpRel_uniform_fst
    (α := _root_.LIDT.MIPStarRE.LDT.Pasting.SliceQuestion params) (β := _root_.LIDT.MIPStarRE.LDT.PointTuple params n) (Outcome := _root_.LIDT.MIPStarRE.LDT.Pasting.GHatOutcome params)
    (ι := ι) (ψ := ψbi)
    (A := _root_.LIDT.MIPStarRE.LDT.IdxSubMeas.toIdxOpFamily (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyLeftFamily params family))
    (B := _root_.LIDT.MIPStarRE.LDT.IdxSubMeas.toIdxOpFamily (_root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyRightFamily params family))
    (δ := _root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyError zeta) hscOp
  simpa [_root_.LIDT.MIPStarRE.LDT.Pasting.SliceQuestion, _root_.LIDT.MIPStarRE.LDT.sddErrorOp, _root_.LIDT.MIPStarRE.LDT.qSDDOp, _root_.LIDT.MIPStarRE.LDT.qSDDCore, _root_.LIDT.MIPStarRE.LDT.IdxSubMeas.toIdxOpFamily,
    _root_.LIDT.MIPStarRE.LDT.SubMeas.toOpFamily, _root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyLeftFamily, _root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyRightFamily,
    _root_.LIDT.MIPStarRE.LDT.Pasting.gHatSelfConsistencyError, _root_.LIDT.MIPStarRE.LDT.leftPlacedSubMeas, _root_.LIDT.MIPStarRE.LDT.rightPlacedSubMeas] using
      hprod.squaredDistanceBound
