import Definitions.Def_CalibratedMA_Randomized_Setting



open MeasureTheory

namespace CalibratedMA.Randomized.CalibrationUpper

lemma integrable_weight {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (P : Ω → ℝ) (hP : Measurable P)
    (f : Ω → ℝ) (hf : Integrable f μ)
    (h : ℝ → ℝ) (hh : Measurable h) (hbound : ∀ p, |h p| ≤ 1) :
    Integrable (fun ω => h (P ω) * f ω) μ := by
  apply hf.bdd_mul (hh.comp hP).aestronglyMeasurable
  exact Filter.Eventually.of_forall fun ω => by
    simpa only [Real.norm_eq_abs, Function.comp_apply] using hbound (P ω)

lemma weighted_integral_condExp {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (μ : Measure Ω) [IsFiniteMeasure μ] (P : Ω → ℝ) (hP : Measurable P)
    (f : Ω → ℝ) (hf : Integrable f μ)
    (h : ℝ → ℝ) (hh : Measurable h) (hbound : ∀ p, |h p| ≤ 1) :
    (∫ ω, h (P ω) * f ω ∂μ) =
      ∫ ω, h (P ω) * μ[f | MeasurableSpace.comap P inferInstance] ω ∂μ := by
  have hmP : MeasurableSpace.comap P inferInstance ≤ mΩ := hP.comap_le
  have hw : StronglyMeasurable[MeasurableSpace.comap P inferInstance] (fun ω => h (P ω)) :=
    (hh.comp (comap_measurable P)).stronglyMeasurable
  have hprod : Integrable ((fun ω => h (P ω)) * f) μ :=
    integrable_weight μ P hP f hf h hh hbound
  have hpull := condExp_mul_of_stronglyMeasurable_left (μ := μ)
    (m := MeasurableSpace.comap P inferInstance) hw hprod hf
  exact (integral_condExp (μ := μ) (f := (fun ω => h (P ω)) * f) hmP).symm.trans
    (integral_congr_ae hpull)

lemma weighted_integral_le_abs_condExp {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsFiniteMeasure μ] (P : Ω → ℝ) (hP : Measurable P)
    (f : Ω → ℝ) (hf : Integrable f μ)
    (h : ℝ → ℝ) (hh : Measurable h) (hbound : ∀ p, |h p| ≤ 1) :
    (∫ ω, h (P ω) * f ω ∂μ) ≤
      ∫ ω, |μ[f | MeasurableSpace.comap P inferInstance] ω| ∂μ := by
  rw [weighted_integral_condExp μ P hP f hf h hh hbound]
  apply integral_mono
    (integrable_weight μ P hP _ integrable_condExp h hh hbound) integrable_condExp.abs
  intro ω
  calc
    _ ≤ |h (P ω) * μ[f | MeasurableSpace.comap P inferInstance] ω| := le_abs_self _
    _ = |h (P ω)| * |μ[f | MeasurableSpace.comap P inferInstance] ω| := abs_mul _ _
    _ ≤ 1 * |μ[f | MeasurableSpace.comap P inferInstance] ω| :=
      mul_le_mul_of_nonneg_right (hbound (P ω)) (abs_nonneg _)
    _ = _ := one_mul _

lemma sign_abs_le_one (h : ℝ → ℝ) (hsign : ∀ p, h p = 1 ∨ h p = -1) :
    ∀ p, |h p| ≤ 1 := by
  intro p
  rcases hsign p with hp | hp <;> rw [hp] <;> norm_num

lemma sign_integral_le_abs_condExp {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsFiniteMeasure μ] (P : Ω → ℝ) (hP : Measurable P)
    (f : Ω → ℝ) (hf : Integrable f μ)
    (h : ℝ → ℝ) (hh : Measurable h) (hsign : ∀ p, h p = 1 ∨ h p = -1) :
    (∫ ω, h (P ω) * f ω ∂μ) ≤
      ∫ ω, |μ[f | MeasurableSpace.comap P inferInstance] ω| ∂μ :=
  weighted_integral_le_abs_condExp μ P hP f hf h hh (sign_abs_le_one h hsign)

end CalibratedMA.Randomized.CalibrationUpper


open MeasureTheory

namespace CalibratedMA.Randomized.CalibrationSign

/-- A real function measurable with respect to the value of `P` admits a
measurable sign test of `P` that realizes its absolute value pointwise. -/
lemma exists_measurable_sign {Ω : Type*} [MeasurableSpace Ω]
    (P g : Ω → ℝ)
    (hg : Measurable[MeasurableSpace.comap P inferInstance] g) :
    ∃ h : ℝ → ℝ, Measurable h ∧ (∀ p, h p = 1 ∨ h p = -1) ∧
      ∀ ω, h (P ω) * g ω = |g ω| := by
  classical
  obtain ⟨g', hg', heq⟩ := hg.exists_eq_measurable_comp
  let h : ℝ → ℝ := fun p => if 0 ≤ g' p then 1 else -1
  refine ⟨h, ?_, ?_, ?_⟩
  · apply Measurable.ite (measurableSet_le measurable_const hg')
    · exact measurable_const
    · exact measurable_const
  · intro p
    by_cases hp : 0 ≤ g' p
    · exact Or.inl (if_pos hp)
    · exact Or.inr (if_neg hp)
  · intro ω
    have hω : g ω = g' (P ω) := congrFun heq ω
    rw [hω]
    by_cases hnonneg : 0 ≤ g' (P ω)
    · simp only [h, if_pos hnonneg, one_mul, abs_of_nonneg hnonneg]
    · simp only [h, if_neg hnonneg, neg_one_mul, abs_of_neg (lt_of_not_ge hnonneg)]

/-- Conditional expectation on the sigma-algebra generated by a real score
has a measurable sign test that realizes its absolute value pointwise. -/
lemma exists_condExp_sign {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (P f : Ω → ℝ) :
    ∃ h : ℝ → ℝ, Measurable h ∧ (∀ p, h p = 1 ∨ h p = -1) ∧
      ∀ ω, h (P ω) * (μ[f | MeasurableSpace.comap P inferInstance]) ω =
        |(μ[f | MeasurableSpace.comap P inferInstance]) ω| := by
  exact exists_measurable_sign P _ stronglyMeasurable_condExp.measurable

end CalibratedMA.Randomized.CalibrationSign


open MeasureTheory ProbabilityTheory

namespace CalibratedMA.Randomized.CalibrationLaw

variable {X : Type*} [MeasurableSpace X]

/-- The law obtained by attaching the input and label to a sampled prediction
depends measurably on the labeled example. -/
lemma measurable_jointKernel (Q : X → Measure ℝ) (hQ : IsRandomizedPredictor Q) :
    Measurable (fun z : X × ℝ => (Q z.1).map (fun p => (z.1, z.2, p))) := by
  let κ : Kernel (X × ℝ) ℝ := ⟨fun z => Q z.1, hQ.1.comp measurable_fst⟩
  let : IsMarkovKernel κ := ⟨fun z => (hQ.2 z.1).1⟩
  let f : (X × ℝ) × ℝ → X × ℝ × ℝ := fun zp => (zp.1.1, zp.1.2, zp.2)
  have hf : Measurable f := by fun_prop
  let η : Kernel (X × ℝ) (X × ℝ × ℝ) := (Kernel.id ×ₖ κ).map f
  have heq : (fun z : X × ℝ => (Q z.1).map (fun p => (z.1, z.2, p))) = η := by
    funext z
    apply Measure.ext
    intro A hA
    change (Q z.1).map (fun p => (z.1, z.2, p)) A = ((Kernel.id ×ₖ κ).map f) z A
    rw [Kernel.map_apply' _ hf _ hA, Kernel.id_prod_apply' _ _ (hf hA)]
    rw [Measure.map_apply (by fun_prop) hA]
    rfl
  rw [heq]
  exact η.measurable

/-- An admissible predictor and a probability data distribution induce a probability joint law. -/
lemma jointLaw_isProbabilityMeasure (D : Measure (X × ℝ)) [IsProbabilityMeasure D]
    (Q : X → Measure ℝ) (hQ : IsRandomizedPredictor Q) :
    IsProbabilityMeasure (jointLaw D Q) := by
  apply isProbabilityMeasure_bind (measurable_jointKernel Q hQ).aemeasurable
  apply Filter.Eventually.of_forall
  intro z
  let : IsProbabilityMeasure (Q z.1) := (hQ.2 z.1).1
  exact Measure.isProbabilityMeasure_map (by fun_prop)

/-- The joint law retains the label support and the predictor's support. -/
lemma jointLaw_support (D : Measure (X × ℝ))
    (Q : X → Measure ℝ) (hD : ∀ᵐ z ∂D, z.2 ∈ Set.Icc (0 : ℝ) 1)
    (hQ : IsRandomizedPredictor Q) :
    ∀ᵐ w ∂jointLaw D Q,
      w.2.1 ∈ Set.Icc (0 : ℝ) 1 ∧ w.2.2 ∈ Set.Icc (0 : ℝ) 1 := by
  have hA : MeasurableSet {w : X × ℝ × ℝ |
      w.2.1 ∈ Set.Icc (0 : ℝ) 1 ∧ w.2.2 ∈ Set.Icc (0 : ℝ) 1} := by
    exact (measurableSet_Icc.preimage (by fun_prop)).inter
      (measurableSet_Icc.preimage (by fun_prop))
  rw [ae_iff]
  unfold jointLaw
  change (D.bind (fun z : X × ℝ => (Q z.1).map (fun p => (z.1, z.2, p))))
    ({w : X × ℝ × ℝ | w.2.1 ∈ Set.Icc (0 : ℝ) 1 ∧ w.2.2 ∈ Set.Icc (0 : ℝ) 1}ᶜ) = 0
  rw [Measure.bind_apply hA.compl (measurable_jointKernel Q hQ).aemeasurable]
  apply lintegral_eq_zero_of_ae_eq_zero
  filter_upwards [hD] with z hz
  rw [Measure.map_apply (by fun_prop) hA.compl]
  simpa only [Set.preimage_compl, Set.preimage_ofPred_eq, hz, true_and, Pi.zero_apply,
    Set.ofPred_mem_eq]
    using (hQ.2 z.1).2

/-- The bounded residual is integrable under the actual joint law. -/
lemma integrable_residual (D : Measure (X × ℝ)) [IsProbabilityMeasure D]
    (Q : X → Measure ℝ) (hD : ∀ᵐ z ∂D, z.2 ∈ Set.Icc (0 : ℝ) 1)
    (hQ : IsRandomizedPredictor Q) :
    Integrable (fun w : X × ℝ × ℝ => w.2.1 - w.2.2) (jointLaw D Q) := by
  let : IsProbabilityMeasure (jointLaw D Q) := jointLaw_isProbabilityMeasure D Q hQ
  apply (integrable_const (1 : ℝ)).mono'
    ((show Measurable (fun w : X × ℝ × ℝ => w.2.1 - w.2.2) by fun_prop).aestronglyMeasurable)
  filter_upwards [jointLaw_support D Q hD hQ] with w hw
  rw [Real.norm_eq_abs]
  exact abs_le.mpr ⟨by linarith [hw.1.1, hw.2.2], by linarith [hw.1.2, hw.2.1]⟩

end CalibratedMA.Randomized.CalibrationLaw


open MeasureTheory

namespace CalibratedMA.Randomized.CalibrationAssembly

lemma dual_isLUB {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsFiniteMeasure μ] (P : Ω → ℝ) (hP : Measurable P)
    (f : Ω → ℝ) (hf : Integrable f μ) :
    IsLUB {v : ℝ | ∃ h : ℝ → ℝ, Measurable h ∧ (∀ p, h p = 1 ∨ h p = -1) ∧
      v = ∫ ω, h (P ω) * f ω ∂μ}
      (∫ ω, |μ[f | MeasurableSpace.comap P inferInstance] ω| ∂μ) := by
  have hupper : ∀ v ∈ {v : ℝ | ∃ h : ℝ → ℝ, Measurable h ∧
      (∀ p, h p = 1 ∨ h p = -1) ∧ v = ∫ ω, h (P ω) * f ω ∂μ},
      v ≤ ∫ ω, |μ[f | MeasurableSpace.comap P inferInstance] ω| ∂μ := by
    rintro v ⟨h, hh, hsign, rfl⟩
    exact CalibrationUpper.sign_integral_le_abs_condExp μ P hP f hf h hh hsign
  have hattain : ∃ h : ℝ → ℝ, Measurable h ∧ (∀ p, h p = 1 ∨ h p = -1) ∧
      (∫ ω, |μ[f | MeasurableSpace.comap P inferInstance] ω| ∂μ) =
        ∫ ω, h (P ω) * f ω ∂μ := by
    obtain ⟨h, hh, hsign, heq⟩ := CalibrationSign.exists_condExp_sign μ P f
    refine ⟨h, hh, hsign, ?_⟩
    rw [CalibrationUpper.weighted_integral_condExp μ P hP f hf h hh
      (CalibrationUpper.sign_abs_le_one h hsign)]
    exact (integral_congr_ae (Filter.Eventually.of_forall heq)).symm
  exact ⟨hupper, fun b hb => hb hattain⟩

end CalibratedMA.Randomized.CalibrationAssembly

open CalibratedMA.Randomized

theorem solution {X : Type*} [MeasurableSpace X] (D : Measure (X × ℝ)) [IsProbabilityMeasure D]
    (hD : ∀ᵐ z ∂D, z.2 ∈ Set.Icc (0 : ℝ) 1) (Q : X → Measure ℝ)
    (hQ : IsRandomizedPredictor Q) :
    IsLUB {v : ℝ | ∃ h : ℝ → ℝ, Measurable h ∧ (∀ p, h p = 1 ∨ h p = -1) ∧
        v = ∫ w, h w.2.2 * (w.2.1 - w.2.2) ∂(jointLaw D Q)} (ECE D Q)  := by
  let : IsProbabilityMeasure (jointLaw D Q) := CalibrationLaw.jointLaw_isProbabilityMeasure D Q hQ
  exact CalibrationAssembly.dual_isLUB (jointLaw D Q) (fun w => w.2.2) (by fun_prop)
    (fun w => w.2.1 - w.2.2) (CalibrationLaw.integrable_residual D Q hD hQ)


