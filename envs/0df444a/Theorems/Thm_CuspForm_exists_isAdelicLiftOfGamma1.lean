theorem CuspForm.exists_isAdelicLiftOfGamma1 {M : ℕ} (hM : M ≠ 0) (g : CuspForm (CongruenceSubgroup.Gamma1 M) 2) :
    ∃ φ : AutomorphicForm.AdelicGL2 (NumberField.RingOfIntegers ℚ) ℚ → ℂ, CuspForm.IsAdelicLiftOfGamma1 g φ := by sorry
