open ExactVacuumAtlas.EinsteinMaxwell.EF5

namespace ExactVacuumAtlas.EinsteinMaxwell.EF5

variable (mu beta Q : ℝ)

/-! ## Potential, `F = dA`, `H = 0` -/

/-! ## Raised field and invariant -/

/-! ## Maxwell `J^b = 0` -/

/-! ## Einstein–Maxwell residual -/

/-- The coefficient table `B_{ab}` of `E_{ab} = (3β - Q²) B_{ab}`. -/
noncomputable def emFactorEF5 (x : Pt 5) : Fin 5 → Fin 5 → ℝ := fun a b =>
  match a, b with
  | 0, 0 => (1 - mu / x 1 ^ 2 + beta / x 1 ^ 4) / x 1 ^ 6
  | 0, 1 => -1 / x 1 ^ 6
  | 1, 0 => -1 / x 1 ^ 6
  | 2, 2 => 1 / (4 * x 1 ^ 4 * x 2 * (1 - x 2))
  | 3, 3 => x 2 / x 1 ^ 4
  | 4, 4 => (1 - x 2) / x 1 ^ 4
  | _, _ => 0

end ExactVacuumAtlas.EinsteinMaxwell.EF5


