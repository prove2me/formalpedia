section
-- Source module: Solutions.J6SegILSrc13
/-!
# B-line IL, source-table producers, part 13: the set-up frame

`upF dA Z Z1 Cm body`: park the descriptor `dA → Z` (through `Z1`, counter `Cm`), push `0` on
the parameter registers `rg`, run D2's parameter phase `parP 0 0 0 0 Z`, run `body`, pop `rg`,
and park the descriptor back `Z → dA`. Theorem `upF_runs`: if `body` takes `RF v c₀` to
`RF v (extend ρS V c₀)` for every `v` satisfying `ParV` (`c₀` = the input with the descriptor
moved to `Z`), then `upF` takes `F` to `extend ρS V F` (the first half of `SetupS`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.PJ (rg RF RF_in RF_out ParV BV parBig cPar dsc Rn)
open J6Seg.Ax (ρS sZ)

/-- The pre-body part of the set-up. -/
def upA (dA Z Z1 Cm : Fin HS) : RS :=
  .seq (park dA Z1 Z Cm) (.seq (pushZ rg) (J6Seg.PJ.parP 0 0 0 0 Z))

/-- The post-body part of the set-up. -/
def upB (dA Z Z1 Cm : Fin HS) : RS := .seq (popL rg) (park Z Z1 dA Cm)

/-- **The set-up frame.** -/
def upF {Pp : ℕ} (dA Z Z1 Cm : Fin HS) (body : IStmt HS Pp) : IStmt HS Pp :=
  .seq (upA dA Z Z1 Cm).code (.seq body (upB dA Z Z1 Cm).code)

/-- Admissible parking registers. -/
structure ParkOK (dA Z Z1 Cm : Fin HS) : Prop where
  lt : dA.val < 56 ∧ Z.val < 56 ∧ Z1.val < 56 ∧ Cm.val < 56
  ne : dA ≠ Z ∧ dA ≠ Z1 ∧ dA ≠ Cm ∧ Z ≠ Z1 ∧ Z ≠ Cm ∧ Z1 ≠ Cm
  rgZ : Z ∉ rg ∧ Z1 ∉ rg ∧ Cm ∉ rg
  pZ : Z ≠ 15 ∧ Z ≠ 47 ∧ Z ≠ 48
  outZ : ∀ j ∈ [Z, Z1, Cm], j ≠ 0 ∧ j ≠ sZ ∧ ∀ i, ρS i ≠ j
  dA0 : dA ≠ 0 ∧ dA ≠ sZ ∧ ∀ i, ρS i ≠ dA

/-- The input of the body: the descriptor moved to `Z`. -/
def c0 (F : Fin HS → List ℤ) (dA Z : Fin HS) (desc : List ℤ) : Fin HS → List ℤ :=
  update (update F dA []) Z desc

end J6Seg.Src

end

section
-- Source module: Solutions.J6SegILSrc14
/-!
# B-line IL, source-table producers, part 14: the control phase

`ctlPh Rn Rn'`: with the source table `srcTab src argOf n'` on `44` (alone), `n` on `Rn` and
`n'` on `Rn'`: push `n'`, `n` on `bN' = 20`, `bN = 21`, run `ctlB` (`J6SegILCtl5`), pop them and
drop the table. Output: `flatC (ctlOf n n' src argOf)` on `rC = 45`, `n + n'` on `rNC = 38`,
`44` emptied (`ctlPh_runs`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (srcTab flatC ctlB ctlCost)
open NLogN.KFUU (cU)

/-- The control phase. -/
def ctlPh {Pp : ℕ} (Rn Rn' : Fin HS) : IStmt HS Pp :=
  .seq (RS.seq (.push 20 (.reg Rn')) (.push 21 (.reg Rn))).code
    (.seq ctlB (RS.seq (.pop 20) (.seq (.pop 21) (dropP Rn' 44 2))).code)

/-- Its cost. -/
def ctlPhC (A n n' : ℕ) : ℕ :=
  4 * uC A DD + ctlCost (A + 1) n n' + (2 * uC A DD + (n' + 1) * (3 * uC A DD + uC A DD))

end J6Seg.Src

end

section
-- Source module: Solutions.J6SegILSrc15
/-!
# B-line IL, source-table producers, part 15: the register file; pass 1 and pass 7 bodies

* `regOut F cs pre post n' K1 K2`: `F` with the slab register file pushed (`rC, rNC, rNB, rM, rTOT,
  rK1, rK2`); `regOut_RF`: on `RF v c` with empty registers it is `RF v (extend ρS (slabV …) c)`.
* `body1`: `2^(Q-p-1)` on `46` (`pw2P`), `selP 22 23 46 23`, `ctlPh 23 23`, `cntP 3 4 23`, pop `46`.
  Input registers (as left by `parP`): `1 = p`, `3 = pre`, `4 = post`, `20 = Q`, `22 = s`, `23 = t`.
* `body7`: `outP 1 22 23 25 23`, `ctlPh 23 23`, `cntP 3 4 23`, `2^(Q-p)` on `41`, `2^p` on `42`
  (`25 = α`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (srcTab flatC ctlB ctlCost)
open J6Seg.PJ (rg RF RF_in RF_out upd_RF_out)
open J6Seg.Ax (ρS slabV)

/-- The register file pushed on `F`. -/
def regOut (F : Fin HS → List ℤ) (cs : List (ℤ × ℤ)) (pre post n' : ℕ) (K1 K2 : List ℤ) :
    Fin HS → List ℤ :=
  update (update (update (update (update (update (update F 45 (flatC cs ++ F 45)) 38
    ((cs.length : ℤ) :: F 38)) 37 ((pre : ℤ) :: F 37)) 39 (((2 * post : ℕ) : ℤ) :: F 39)) 40
    (((pre * (n' * (2 * post)) : ℕ) : ℤ) :: F 40)) 41 (K1 ++ F 41)) 42 (K2 ++ F 42)

/-! ## Pass 1 -/

/-- `Q - p - 1`. -/
def qpE : Ex HS := .add (.add (.reg 20) (.neg (.reg 1))) (.lit (-1))

/-- Before the control phase. -/
def a1 : RS := .seq (.push 13 qpE) (.seq (pw2P 13 46) (.seq (.pop 13) (selP 22 23 46 23)))

/-- After the control phase. -/
def b1 : RS := .seq (cntP 3 4 23) (.pop 46)

/-- **The pass-1 body.** -/
def body1 {Pp : ℕ} : IStmt HS Pp := .seq a1.code (.seq (ctlPh 23 23) b1.code)

/-- Its cost. -/
def cost1 (A Q t : ℕ) : ℕ :=
  (Q + t + 2) * (40 * uC A DD) + ctlPhC A t t

/-! ## Pass 7 -/

/-- `Q - p`. -/
def qE : Ex HS := .add (.reg 20) (.neg (.reg 1))

/-- After the control phase. -/
def b7 : RS :=
  .seq (cntP 3 4 23) (.seq (.push 13 qE) (.seq (pw2P 13 41) (.seq (.pop 13) (pw2P 1 42))))

/-- **The pass-7 body.** -/
def body7 {Pp : ℕ} : IStmt HS Pp := .seq (outP 1 22 23 25 23).code (.seq (ctlPh 23 23) b7.code)

/-- Its cost. -/
def cost7 (A Q p α t : ℕ) : ℕ :=
  (t + 1) * (c7 A p α + 4 * uC A DD + uC A DD) + ctlPhC A t t + (2 * Q + 4) * (40 * uC A DD)

end J6Seg.Src

end

section
-- Source module: Solutions.J6AIL15
/-!
# A lines, IL side 15: the gather and compress slab set-ups

* `slUp P1 Rn Rn'`: a register-file prologue `P1` (ending with the source table on `44`, `n` on
  `Rn`, `n'` on `Rn'`, `pre, post` on `1, 2`), then B1's `ctlPh Rn Rn'`, then `cntP 1 2 Rn'` and
  `finiP rg`. **`slUp_runs`**: it takes `F` to `extend ρS (slabV (ctlOf n n' src 0) pre post n' [] []) F`.
* `slDn`: `dropP 38 45 2; popL [38, 37, 39, 40]`, back (**`slDn_sp`**).
* The prologues `gP1 X` (gather: `parAX X`, `n' = 8 (M · 8H)` on `12`, `n = 32 t` on `7`,
  `gthP 3 4 8 9 10 11 12`) and `cP1 X` (compress: `n = M · 8 · 8H` on `7`, `cmpP 8 11 4`, `n' = t`
  on `4`) with **`gP1_sp`** / **`cP1_sp`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6A.SL

open IntMul NLogN NLogN.KIL Function RS J6Seg.PJ J6A.PA J6A.ST
open J6Seg.Slab (srcTab flatC)
open J6Seg.Src (ctlPh ctlPhC cntP cntOut dropP popL uC DD regOut)
open J6Seg.Ax (ρS slabV)

/-! ## The frame -/

/-- The epilogue. -/
def upTail (Rn' : Fin HS) : RS := .seq (cntP 1 2 Rn') (finiP rg)

/-- **The slab set-up.** -/
def slUp {Pp : ℕ} (P1 : RS) (Rn Rn' : Fin HS) : IStmt HS Pp :=
  .seq P1.code (.seq (ctlPh Rn Rn') (upTail Rn').code)

/-- **The slab tear-down.** -/
def slDn : RS := .seq (dropP 38 45 2) (popL [38, 37, 39, 40])

/-- Its cost. -/
def cTail (W : ℕ) : ℕ := 30 * uC W DD + (21 * (2 * (W + 1) + 2) + 1)

end J6A.SL

end

