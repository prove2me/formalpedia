-- title:
--   EFI pairs and expanding single-copy pseudorandom state generators
-- statement:
--   An EFI pair is generated by one uniform preparation receiving a branch bit. Its two output families are computationally indistinguishable, and their trace distance is eventually at least the inverse of an eventually positive polynomial. The amplified variant replaces that distance condition by $D\ge 1-\eta(\lambda)$ for a negligible nonnegative $\eta$; it does not define the original primitive.
--
--   A single-copy pseudorandom generator maps each fixed uniformly sampled hidden key to a normalized pure state. Its average output is computationally indistinguishable from the maximally mixed state. Expansion requires $n(\lambda)>r(\lambda)$ at every positive security parameter. Purity is imposed per key, not on the average, and security concerns one output copy. Both primitives use the actual circuit execution of the computation layer and are defined independently.
-- source:
--   Rishabh Batra, STOC 2027 submission #273 (October 2026), EFI ⇔ 1PRS, https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/273.pdf, Definitions 2.6 and 2.8, p.8

import Definitions.Def_EFI1PRS_Uniform_Computation
import Definitions.Def_QAlgorithms_Defs_MatrixDistances
import Definitions.Def_QAlgorithms_Defs_Ensemble

/-! Source: Batra, pinned October 2026 submission, Definitions 2.6 and 2.8,
pp.8–9. The predicates below are independent definitions of the two primitives. -/
noncomputable section
namespace EFI1PRS.Uniform
open QAlgorithms
open scoped BigOperators Matrix ComplexConjugate
attribute [local instance] Classical.propDecidable Classical.decEq

def distance {I : Type*} [Fintype I] [DecidableEq I]
    (ρ σ : Matrix I I ℂ) : ℝ := (1/2 : ℝ) * traceNorm (ρ - σ)

def maximallyMixed (n : ℕ) : Matrix (Qubits n) (Qubits n) ℂ :=
  ((2 : ℂ)^n)⁻¹ • (1 : Matrix (Qubits n) (Qubits n) ℂ)

/-- One program family receives the classical branch bit on its input wire. -/
structure PairPreparation where
  width : ℕ → ℕ
  program : (sec : ℕ) → Preparation 1 (width sec)

def PairPreparation.branch (g : PairPreparation) (b : Bool) (sec : ℕ) :=
  (g.program sec).onKey (fun _ => b)

def PairPreparation.hiding (g : PairPreparation) : Prop :=
  ComputationallyIndistinguishable (g.branch false) (g.branch true)

/-- Original inverse-polynomial separation, with one polynomial selected before sec.
The eventually-positive condition excludes a zero or negative denominator. -/
def IsEFI (g : PairPreparation) : Prop :=
  UniformPreparation g.program ∧ g.hiding ∧
  ∃ p : Polynomial ℝ, ∃ threshold : ℕ, ∀ sec,
    threshold ≤ sec → 1 ≤ sec →
    0 < p.eval (sec : ℝ) ∧ (p.eval (sec : ℝ))⁻¹ ≤ distance (g.branch false sec) (g.branch true sec)

/-- Amplified EFI uses an adversary-independent statistical error; hiding retains
its own adversary-dependent negligible bound. -/
def IsAmplifiedEFI (g : PairPreparation) : Prop :=
  UniformPreparation g.program ∧ g.hiding ∧
  ∃ η : ℕ → ℝ, Negligible η ∧ ∃ threshold : ℕ, ∀ sec,
    threshold ≤ sec → 1 ≤ sec →
    1 - η sec ≤ distance (g.branch false sec) (g.branch true sec)

structure KeyedPreparation where
  keyLength : ℕ → ℕ
  width : ℕ → ℕ
  program : (sec : ℕ) → Preparation (keyLength sec) (width sec)

/-- The uniform distribution on all keys, with exactly one copy of the output. -/
def KeyedPreparation.average (g : KeyedPreparation) (sec : ℕ) :=
  ((2 : ℂ)^(g.keyLength sec))⁻¹ •
    ∑ key : Qubits (g.keyLength sec), (g.program sec).onKey key

/-- Purity is checked separately for every fixed key. No multi-copy security or
purity of the average is required. Strict stretch holds at every positive sec. -/
def IsExpandingOneCopyPRS (g : KeyedPreparation) : Prop :=
  UniformPreparation g.program ∧
  (∀ sec, 1 ≤ sec → ∀ key : Qubits (g.keyLength sec),
    ∃ ψ : EuclideanSpace ℂ (Qubits (g.width sec)),
      IsState ψ ∧ (g.program sec).onKey key = pureDensity ψ) ∧
  ComputationallyIndistinguishable g.average (fun sec => maximallyMixed (g.width sec)) ∧
  ∀ sec, 1 ≤ sec → g.keyLength sec < g.width sec

end EFI1PRS.Uniform


