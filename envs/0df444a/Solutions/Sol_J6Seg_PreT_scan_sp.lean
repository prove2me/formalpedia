theorem spIT (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {e : Ex HS} (he : InRg e)
    (hok : e.ok (encK s (RF v c))) {V : Fin HS → ℕ} {B : ℕ} (hv : ∀ j ∈ e.regs, |v j| ≤ V j)
    (hm : mg V e < 2 ^ B) (hneg : e.eval (encK s (RF v c)) < 0) {a b : RS} {t : IState HS} {ca : ℕ}
    (ha : Sp a (encK s (RF v c)) t ca) :
