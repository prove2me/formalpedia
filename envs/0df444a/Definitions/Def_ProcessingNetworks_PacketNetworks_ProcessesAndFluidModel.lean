-- title:
--   Raw processes, fluid limit paths, the fluid equations, and fluid limit stability (Section 12.3, Definitions 12.14-12.15)
-- statement:
--   `Tproc dat P z s τ ω` is $T_s(\tau,\omega) = \sum_{\ell=1}^{\tau} 1\{s(\ell)=s\}$, the number of
--   timeslots through $\tau$ in which the Markovian policy employed schedule $s$ in the network
--   started from $z$; `Dproc` is $D(\tau) = s(1)+\dots+s(\tau)$ (Eq. 12.5), equivalently
--   $\sum_{s\in S} s\,T_s(\tau)$ (Eq. 12.27); `Zproc` is the packet count process $Z^z(\tau,\omega)$
--   of (12.6)–(12.8). With the fluid scaling $\hat D^z(t) = |z|^{-1}D^z(|z|t)$ (and likewise
--   $\hat T^z$, $\hat Z^z$, $\hat E^z$, sample paths viewed as right-continuous piecewise constant
--   functions), `SLLNHoldsAt P lam ω` says $\omega\in\Omega_1$: the SLLN (12.29),
--   $\lim_{|z|\to\infty}\sup_{0\le t\le M}|\hat E^z(t,\omega)-\lambda t| = 0$ for every $M>0$, holds
--   at $\omega$. `FluidScaledConverge` is the u.o.c. convergence (12.30) along a sequence of initial
--   states.
--
--   **Definition 12.14 (fluid limit path).** A triple $(\hat D,\hat T,\hat Z)$ occurring as a
--   limit in (12.30) along some $\{z_\ell\}$ with $|z_\ell|\to\infty$, for some $\omega\in\Omega_1$.
--
--   **The fluid equations (12.31)–(12.36).** $\hat Z(t)=\hat Z(0)+\lambda t - R\hat D(t)$;
--   $|\hat Z(0)|=1$; $\hat Z\ge 0$; $\hat D(t)=\sum_{s\in S} s\hat T_s(t)$; $\sum_{s\in S}\hat
--   T_s(t)=t$; each $\hat T_s$ nondecreasing and Lipschitz.
--
--   **Definition 12.15 (fluid limit stability).** There is $\delta>0$ with $\hat Z(t)=0$ for
--   every $t\ge\delta$ and every fluid limit path.
--
--   **Formalization note.** The raw processes are generated by the policy from the primitives
--   (Section 12.1), not taken as an arbitrary schedule-choice process. Fluid limit paths are limits
--   taken at sample points of $\Omega_1$ only, as Definition 12.14 says; admitting limits along
--   arbitrary $\omega$ would enlarge the fluid limit, strengthen Definition 12.15, and leave the
--   fluid-model route to fluid limit stability (Lemma 12.12 is what makes every fluid limit path a
--   fluid model solution) unavailable. `|z| → ∞` is rendered as a limit in the real scaling
--   parameter directly.
-- source:
--   Dai & Harrison, Processing Networks: Fluid Models and Stability, pre-publication draft 2020-4-2, p. 235-236, Section 12.3, Eqs. (12.27),(12.31)-(12.36), Definitions 12.14-12.15

import Mathlib
import Definitions.Def_ProcessingNetworks_PacketNetworks_PacketNetworkModel
import Definitions.Def_ProcessingNetworks_PacketNetworks_MarkovianPolicy

namespace ProcessingNetworks.PacketNetworks

open Filter

/-- `|z|`, the total packet count of an initial state (Section 12.2's `|z|` notation, used
throughout the scaling apparatus of Section 12.3). -/
noncomputable def sizeN {I : ℕ} (z : Fin I → ℕ) : ℝ := ∑ i, (z i : ℝ)

/-- `Tₛ(τ,ω) = ∑_{ℓ=1}^{τ} 1{s(ℓ) = s}` (Section 12.3, just before (12.27)): the cumulative number
of times schedule `s` has been used through the end of timeslot `τ`, where `s(ℓ) = f(Z(ℓ−1), U(ℓ))`
is the schedule the Markovian policy employs (`policySched`), in the network started from `z`. -/
noncomputable def Tproc {I J : ℕ} {Ω : Type*} (dat : PacketNetworkData I J)
    (P : PacketPrimitives I J Ω) (z : Fin I → ℕ) (s : Fin J → ℕ) (τ : ℕ) (ω : Ω) : ℝ :=
  (((Finset.Icc 1 τ).filter (fun ℓ => policySched dat P z ℓ ω = s)).card : ℝ)

/-- `D(τ) = s(1) + ⋯ + s(τ)` (Eq. 12.5), the cumulative activity-usage vector through timeslot
`τ`, indexed by activities `j ∈ J`; equivalently `D(τ) = ∑_{s∈S} s Tₛ(τ)` (Eq. 12.27). -/
noncomputable def Dproc {I J : ℕ} {Ω : Type*} (dat : PacketNetworkData I J)
    (P : PacketPrimitives I J Ω) (z : Fin I → ℕ) (τ : ℕ) (ω : Ω) : Fin J → ℝ :=
  fun j => ∑ ℓ ∈ Finset.Icc 1 τ, (policySched dat P z ℓ ω j : ℝ)

/-- `Zᶻ(τ,ω)`, the class-level packet counts at the end of timeslot `τ` in the network started
from `z` (the recursion (12.7)–(12.8), equivalently the system equation (12.6)
`Zᶻ(τ) = z + E(τ) − R D(τ)`), as a real vector. -/
noncomputable def Zproc {I J : ℕ} {Ω : Type*} (dat : PacketNetworkData I J)
    (P : PacketPrimitives I J Ω) (z : Fin I → ℕ) (τ : ℕ) (ω : Ω) : Fin I → ℝ :=
  fun i => (policyState dat P z τ ω i : ℝ)

/-- The sample point `ω` lies in `Ω₁` (Section 12.3, after Lemma 12.12): the functional SLLN
(12.29) holds at `ω`, i.e. for each `M > 0`, `sup_{0≤t≤M} |Êᶻ(t,ω) − λt| → 0` as `|z| → ∞`, where
`Êᶻ(t,ω) = |z|⁻¹ E(⌊|z|t⌋, ω)` (the right-continuous piecewise constant convention of Section
12.3). `|z| → ∞` is rendered as a limit in the real scaling parameter `size` directly. -/
def SLLNHoldsAt {I J : ℕ} {Ω : Type*} (P : PacketPrimitives I J Ω) (lam : Fin I → ℝ) (ω : Ω) :
    Prop :=
  ∀ M : ℝ, 0 < M → ∀ ε : ℝ, 0 < ε →
    ∃ Nb : ℝ, ∀ size : ℝ, Nb ≤ size → ∀ t ∈ Set.Icc (0 : ℝ) M, ∀ i,
      |size⁻¹ * (Ecum P ⌊size * t⌋₊ ω i : ℝ) - lam i * t| < ε

/-- Uniform convergence on compact sets ("u.o.c.", Definition A.6), `Fin I`-vector-valued —
restated in shape from mission III's `UOCConverges` (this chunk's own `BRIEF.md` lists no
continuous-time-mission dependency, so it is restated rather than cross-imported). -/
def UOCConverges {I : ℕ} (f : ℕ → ℝ → Fin I → ℝ) (g : ℝ → Fin I → ℝ) : Prop :=
  ∀ Tb : ℝ, 0 ≤ Tb → ∀ ε : ℝ, 0 < ε →
    ∃ N : ℕ, ∀ n ≥ N, ∀ t ∈ Set.Icc (0 : ℝ) Tb, ∀ i, |f n t i - g t i| < ε

/-- The same u.o.c. convergence, for a family indexed by membership in a finite schedule set `S`
(rather than by `Fin d`, since the natural index type here is `{s // s ∈ S}` and phrasing the
quantifier via `∀ s ∈ S` avoids introducing that subtype). -/
def UOCConvergesSchedIndexed {J : ℕ} (S : Finset (Fin J → ℕ)) (f : ℕ → ℝ → (Fin J → ℕ) → ℝ)
    (g : ℝ → (Fin J → ℕ) → ℝ) : Prop :=
  ∀ Tb : ℝ, 0 ≤ Tb → ∀ ε : ℝ, 0 < ε →
    ∃ N : ℕ, ∀ n ≥ N, ∀ t ∈ Set.Icc (0 : ℝ) Tb, ∀ s ∈ S, |f n t s - g t s| < ε

/-- The fluid-scaled processes of Section 12.3, `D̂ᶻ(t,ω) = |z|⁻¹ Dᶻ(|z|t, ω)`,
`T̂ᶻₛ(t,ω) = |z|⁻¹ Tᶻₛ(|z|t, ω)`, `Ẑᶻ(t,ω) = |z|⁻¹ Zᶻ(|z|t, ω)`, evaluated along a sequence of
initial states `zseq`, converge u.o.c. to `(D̂, T̂, Ẑ)` (Eq. 12.30). -/
def FluidScaledConverge {I J : ℕ} {Ω : Type*} (dat : PacketNetworkData I J)
    (P : PacketPrimitives I J Ω) (S : Finset (Fin J → ℕ)) (ω : Ω) (zseq : ℕ → Fin I → ℕ)
    (Dh : ℝ → Fin J → ℝ) (Th : ℝ → (Fin J → ℕ) → ℝ) (Zh : ℝ → Fin I → ℝ) : Prop :=
  UOCConverges
    (fun n t j => (sizeN (zseq n))⁻¹ * Dproc dat P (zseq n) ⌊sizeN (zseq n) * t⌋₊ ω j) Dh ∧
  UOCConvergesSchedIndexed S
    (fun n t s => (sizeN (zseq n))⁻¹ * Tproc dat P (zseq n) s ⌊sizeN (zseq n) * t⌋₊ ω) Th ∧
  UOCConverges
    (fun n t i => (sizeN (zseq n))⁻¹ * Zproc dat P (zseq n) ⌊sizeN (zseq n) * t⌋₊ ω i) Zh

/-- Definition 12.14, Dai & Harrison p. 236 (PDF p. 252): a fluid limit path (under policy `f`,
with arrival rate vector `lam`) is a triple `(D̂,T̂,Ẑ)` that occurs as a u.o.c. limit (12.30) of
the fluid-scaled raw processes along some sequence of initial states with `|zₙ| → ∞` (a sequence
from an unbounded set `G`), for some sample point `ω ∈ Ω₁`, i.e. one at which the SLLN (12.29)
holds. -/
def IsFluidLimitPath {I J : ℕ} {Ω : Type*} (dat : PacketNetworkData I J)
    (P : PacketPrimitives I J Ω) (S : Finset (Fin J → ℕ)) (lam : Fin I → ℝ)
    (Dh : ℝ → Fin J → ℝ) (Th : ℝ → (Fin J → ℕ) → ℝ) (Zh : ℝ → Fin I → ℝ) : Prop :=
  ∃ (ω : Ω) (zseq : ℕ → Fin I → ℕ), SLLNHoldsAt P lam ω ∧
    Tendsto (fun n => sizeN (zseq n)) atTop atTop ∧
    FluidScaledConverge dat P S ω zseq Dh Th Zh

/-- The fluid equations (12.31)-(12.36), Dai & Harrison p. 236 (PDF p. 252), that hold for every
fluid limit path under *any* control policy (Section 12.3's own remark that these do not depend on
the policy). -/
def SatisfiesPacketFluidEquations {I J : ℕ} (dat : PacketNetworkData I J) (S : Finset (Fin J → ℕ))
    (lam : Fin I → ℝ) (Dh : ℝ → Fin J → ℝ) (Th : ℝ → (Fin J → ℕ) → ℝ) (Zh : ℝ → Fin I → ℝ) : Prop :=
  (∀ t : ℝ, 0 ≤ t → ∀ i, Zh t i = Zh 0 i + lam i * t - (R dat).mulVec (Dh t) i) ∧
  (∑ i, Zh 0 i = 1) ∧
  (∀ t : ℝ, 0 ≤ t → ∀ i, 0 ≤ Zh t i) ∧
  (∀ t : ℝ, 0 ≤ t → ∀ j, Dh t j = ∑ s ∈ S, (s j : ℝ) * Th t s) ∧
  (∀ t : ℝ, 0 ≤ t → ∑ s ∈ S, Th t s = t) ∧
  ((∀ s ∈ S, Monotone (fun t => Th t s)) ∧
    ∃ Kc : ℝ, ∀ s ∈ S, ∀ t1 t2 : ℝ, 0 ≤ t1 → t1 ≤ t2 → |Th t2 s - Th t1 s| ≤ Kc * (t2 - t1))

/-- Definition 12.15, Dai & Harrison p. 236 (PDF p. 252): the fluid limit under policy `f` is
stable if there is a `δ > 0` such that every fluid limit path has `Ẑ(t) = 0` for all `t ≥ δ`. -/
def PacketFluidLimitStable {I J : ℕ} {Ω : Type*} (dat : PacketNetworkData I J)
    (P : PacketPrimitives I J Ω) (S : Finset (Fin J → ℕ)) (lam : Fin I → ℝ) : Prop :=
  ∃ δ : ℝ, 0 < δ ∧ ∀ (Dh : ℝ → Fin J → ℝ) (Th : ℝ → (Fin J → ℕ) → ℝ) (Zh : ℝ → Fin I → ℝ),
    IsFluidLimitPath dat P S lam Dh Th Zh → ∀ t : ℝ, δ ≤ t → Zh t = fun _ => 0

end ProcessingNetworks.PacketNetworks


