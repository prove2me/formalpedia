theorem transition_tsum_le_one (E : Set ℤ) (Q : ℤ → ℤ → ℝ) (hQ : IsQMatrix E Q) (t : ℝ)
    (x : ℤ) : ∑' y : ℤ, transition E Q t x y ≤ 1 := by sorry

