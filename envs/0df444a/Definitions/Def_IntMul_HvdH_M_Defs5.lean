-- Source module: NLogN.HCrMath
/-!
# Pure facts for chunking, CRT reindexing and the chirp table (namespace `NLogN.CR`)
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul IntMul.HvdH IntMul.HvdH.Ref

/-! ## Mixed-radix ranks -/

/-- The box index of row-major position `q` (inverse of `rmPos`). -/
def unrk : List ℕ → ℕ → ℕ → ℕ
  | [], _ => fun _ => 0
  | n :: ns, q => fun k => if k = 0 then q / ns.prod else unrk ns (q % ns.prod) (k - 1)

/-! ## The CRT keys -/

/-- The residues of `k`. -/
def resJ (s : List ℕ) (k : ℕ) : ℕ → ℕ := fun i => k % s.getD i 1

/-- Target position of digit `k` in `crtIn`: the row-major position of its residues. -/
def crtKey (s : List ℕ) (k : ℕ) : ℕ := rmPos s (resJ s k)

/-- The key list fed to `permP` for `crtIn`. -/
def keyL (s : List ℕ) : List ℕ := (List.range s.prod).map (crtKey s)

/-- The source lengths are positive and pairwise coprime. -/
def CrtOK (s : List ℕ) : Prop := s.Pairwise Nat.Coprime ∧ ∀ x ∈ s, 0 < x

/-- Zero padding of the digit list to length `n`. -/
def padL (c : List ℤ) (n : ℕ) : List ℤ := c ++ List.replicate (n - c.length) 0

/-- The inverse key list. -/
def invL (s : List ℕ) : List ℕ := (List.range s.prod).map fun q => crtIdx s (unrk s q)

end NLogN.CR

end

