theorem solution (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) :
    ∃ data : LambdaModularPolynomialData q, reduceModBivar q data.Ψ = (Polynomial.C Polynomial.X ^ q - Polynomial.X) * (Polynomial.C Polynomial.X - Polynomial.X ^ q) := by
