-- title:
--   The transporter $\mathrm{Trans}_{\Gamma_{\mathrm{in}}}(T,T')$ in a generated subgroup
-- statement:
--   Let $U_i=\mathbb F_q^{n_i}$ and let $\Gamma_{\mathrm{in}}\le\mathrm{GL}(U_1)\times\mathrm{GL}(U_2)\times\mathrm{GL}(U_3)$ be the subgroup generated by a given list of triples. For tensors $T,T'\in U_1\otimes U_2\otimes U_3$,
--   $$
--   \mathrm{Trans}_{\Gamma_{\mathrm{in}}}(T,T')=\{(g_1,g_2,g_3)\in\Gamma_{\mathrm{in}}:(g_1\otimes g_2\otimes g_3)T=T'\},
--   $$
--   and $\mathrm{Stab}_{\Gamma_{\mathrm{in}}}(T)=\mathrm{Trans}_{\Gamma_{\mathrm{in}}}(T,T)$. When nonempty, the transporter is a left coset $u\,\mathrm{Stab}_{\Gamma_{\mathrm{in}}}(T)$.
--
--   **Formalization Note** Tensors are 3-way arrays in the standard bases; `act3 g T` is $(g_1\otimes g_2\otimes g_3)T$.
-- source:
--   Qiao, Zhang, Testing isomorphism of finite groups in time polynomial in the group order, preprint, Nov. 3, 2026 (held version sha256 eb9a3355…), Theorem 8.1, p.71 (PDF p.75)

import Mathlib
import Definitions.Def_GroupIsoPoly_TensorIso

set_option autoImplicit false

namespace GroupIsoPoly

/-- The group `GL(U₁) × GL(U₂) × GL(U₃)` acting on `U₁ ⊗ U₂ ⊗ U₃`, `U_i = K^{n_i}`. -/
abbrev GL3 (K : Type*) [CommRing K] (n₁ n₂ n₃ : ℕ) : Type _ :=
  GL (Fin n₁) K × GL (Fin n₂) K × GL (Fin n₃) K

/-- `(g₁ ⊗ g₂ ⊗ g₃) T` for `g = (g₁, g₂, g₃)`. -/
def act3 {K : Type*} [CommRing K] {n₁ n₂ n₃ : ℕ} (g : GL3 K n₁ n₂ n₃) (T : Array3 K n₁ n₂ n₃) :
    Array3 K n₁ n₂ n₃ :=
  tensorAct (g.1 : Matrix (Fin n₁) (Fin n₁) K) (g.2.1 : Matrix (Fin n₂) (Fin n₂) K)
    (g.2.2 : Matrix (Fin n₃) (Fin n₃) K) T

/-- **The transporter** `Trans_Γin(T, T′)` in the subgroup generated by a list.

Qiao, Zhang, *Testing isomorphism of finite groups in time polynomial in the group order*, preprint,
Nov. 3, 2026 (held version sha256 eb9a3355…), Theorem 8.1, p.71 (PDF p.75): "Given T, T′ ∈
U1 ⊗Fq U2 ⊗Fq U3 and generators of Γin ≤ ∏_{i=1}^3 GL(Ui), … Trans_Γin(T, T′) :=
{(g1, g2, g3) ∈ Γin : (g1 ⊗ g2 ⊗ g3)T = T′}".

With `Γin` the subgroup generated by `gens`, `transIn gens T T'` is the set of `g ∈ Γin` with
`(g₁ ⊗ g₂ ⊗ g₃) T = T′`; `transIn gens T T` is the stabilizer `Stab_Γin(T)`. -/
def transIn {K : Type*} [CommRing K] {n₁ n₂ n₃ : ℕ} (gens : List (GL3 K n₁ n₂ n₃))
    (T T' : Array3 K n₁ n₂ n₃) : Set (GL3 K n₁ n₂ n₃) :=
  {g | g ∈ Subgroup.closure {x | x ∈ gens} ∧ act3 g T = T'}

end GroupIsoPoly


