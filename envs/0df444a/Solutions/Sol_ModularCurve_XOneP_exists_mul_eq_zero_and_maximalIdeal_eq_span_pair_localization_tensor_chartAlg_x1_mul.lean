  obtain ⟨htj, hFD, hsep⟩ := levelData p M L K hK A j hj
  haveI := hFD
  have hFT := AlgebraicCurve.TwoChartIntegralModel.finiteType_chartAlgFin_and_chartAlgInf A L (↥K) j htj hFD hsep
  haveI := hFT.1
  haveI := hFT.2
