variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem valN_chkN_aux (b : ℕ) : ∀ M x : ℕ, NLogN.KFT.valN b (NLogN.KFT.chkN b M x) = x % 2 ^ (b * M) 
  | 0, x => by simp [NLogN.KFT.chkN, NLogN.KFT.valN, Nat.mod_one]
  | M + 1, x => by
    have ih := valN_chkN_aux b M (x / 2 ^ b)
    have e : NLogN.KFT.chkN b (M + 1) x = x % 2 ^ b :: NLogN.KFT.chkN b M (x / 2 ^ b) := by
      simp only [NLogN.KFT.chkN, List.range_succ_eq_map, List.map_cons, List.map_map]
      congr 1
      · simp
      · apply List.map_congr_left; intro j _
        simp only [Function.comp_apply]
        rw [Nat.div_div_eq_div_mul, ← pow_add, Nat.succ_eq_add_one]; ring_nf
    rw [e, NLogN.KFT.valN, ih, show b * (M + 1) = b + b * M by ring, pow_add, Nat.mod_mul]

theorem solution (b : ℕ) : ∀ M x : ℕ, NLogN.KFT.valN b (NLogN.KFT.chkN b M x) = x % 2 ^ (b * M) := by
  first
  | exact valN_chkN_aux
  | (intros; apply valN_chkN_aux <;> assumption)
end
