          have h1 := Int.emod_lt_of_pos ((x : ℤ) / 2 ^ i) (b := 2) (by norm_num)
          omega)
      have hzi : zsz (i : ℤ) ≤ b := zsz_natCast_le hi.le
      have ediv : (x : ℤ) / 2 ^ i / 2 = (x : ℤ) / 2 ^ (i + 1) := by
        rw [Int.ediv_ediv_of_nonneg (by positivity), ← pow_succ]
      have e1 : (1 + (i : ℤ)) = ((i + 1 : ℕ) : ℤ) := by push_cast; ring
      simp +decide [IStmt.run, IOp.run, ss, hC5, hC6, hC7, hC5', hC6', hC7',
        sg_nonneg_div2 hnn, sg_nonneg_mod2 hnn, zsz_one, ediv, e1]
      constructor
      · (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
      · have := splitCost_le 1
        have := addIntCost_mono (show 1 + zsz (i : ℤ) ≤ b + 1 by omega)
        have := addIntCost_le (b + 1)
        omega)
  have hz0 : (x : ℤ) / 2 ^ ℓ = 0 := blen_div_zero x
  have h3 : IRuns I iprog (.seq (.op (.drop T5)) (.op (.drop T7))) (ss ℓ)
      (s.upd C (.int (ℓ : ℤ) :: s.G C)) 20 := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, ss, hz0, zsz_zero, hC5, hC7, hC5', hC7']
    try refine ⟨by (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := zsz_two
    omega
  refine (IRuns.seq h1 (IRuns.seq h2 h3)).mono ?_
  nlinarith

end blen

theorem mainA_runs {I : List Sym} (s : IState NS) (n : ℕ) (L1 : List Item)
    (hT1 : s.G T1 = .int (2 ^ n) :: L1) :
    IRuns I ssProg mainBody.mainA s
      ((((s.upd PRM (.int (mainN0 n) :: s.G PRM)).upd RN (.int (2 ^ mainN0 n) :: s.G RN)).upd RF
        (.int (2 ^ mainN0 n + 1) :: s.G RF)).upd ZZ (.int (n + 1) :: s.G ZZ))
      (mainACost n) := by
  set e := zsz ((n + 1 : ℕ) : ℤ) with he
  have eN : ((mainN0 n : ℕ) : ℤ) = (2 : ℤ) ^ (e + 1) := by simp [mainN0, he]
  have hP4 : ssProg 4 = pow2Body 4 := rfl
  have hen : e ≤ n + 1 := zsz_natCast_le_self _
  have he2 : e + 2 ≤ mainN0 n := by
    have := Nat.lt_two_pow_self (n := e + 1); show e + 2 ≤ 2 ^ (e + 1); omega
  have h1 := blenS_runs' (I := I) (iprog := ssProg) (X := T1) (C := ZZ) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s (2 ^ n) L1 (by rw [hT1]; push_cast; rfl)
  rw [zsz_natCast_two_pow] at h1
  have e1 : ((n + 1 : ℕ) : ℤ) = (n : ℤ) + 1 := by push_cast; rfl
  set s1 := s.upd ZZ (.int ((n + 1 : ℕ) : ℤ) :: s.G ZZ) with hs1
  have h2 := blenS_runs' (I := I) (iprog := ssProg) (X := ZZ) (C := PW) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s1 (n + 1) (s.G ZZ) (by simp [s1])
  rw [← he] at h2
  set s2 := s1.upd PW (.int (e : ℤ) :: s1.G PW) with hs2
  have h3 : IRuns I ssProg (.seq (.op (.const T4 1)) (.op (.add T4 PW PW))) s2
      (s1.upd PW (.int ((e + 1 : ℕ) : ℤ) :: s.G PW)) (1000 * (e + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hs2, hs1, zsz_one]
    refine ⟨by clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide); all_goals omega, ?_⟩
    have := addIntCost_le (e + 1)
    have := addIntCost_mono (show 1 + zsz (e : ℤ) ≤ e + 1 by have := zsz_natCast_le_self e; omega)
    omega
  have h4 := pow2_runs (I := I) (iprog := ssProg) 4 hP4 (e + 1)
    (s1.upd PW (.int ((e + 1 : ℕ) : ℤ) :: s.G PW)) (s.G PW) (by simp)
  have h5 : IRuns I ssProg (.seq (.op (.mv PW PRM)) (.op (.dup PRM PW)))
      ((s1.upd PW (.int ((e + 1 : ℕ) : ℤ) :: s.G PW)).upd PW (.int (2 ^ (e + 1)) :: s.G PW))
      ((s1.upd PRM (.int (mainN0 n) :: s.G PRM)).upd PW (.int (mainN0 n) :: s.G PW))
      (1000 * (e + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hs1, eN]
    refine ⟨by clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := moveIntCost_le (zsz ((2 : ℤ) ^ (e + 1))); have := dupCost_le (zsz ((2 : ℤ) ^ (e + 1)))
    have := zsz_two_pow (e + 1)
    omega
  have h6 := pow2_runs (I := I) (iprog := ssProg) 4 hP4 (mainN0 n)
    ((s1.upd PRM (.int (mainN0 n) :: s.G PRM)).upd PW (.int (mainN0 n) :: s.G PW)) (s.G PW)
    (by simp)
  have h7 : IRuns I ssProg (.seq (.op (.dup PW T4)) (.seq (.op (.mv PW RN)) (.seq (.op (.const T5 1))
      (.seq (.op (.add T5 T4 T4)) (.op (.mv T4 RF))))))
      (((s1.upd PRM (.int (mainN0 n) :: s.G PRM)).upd PW (.int (mainN0 n) :: s.G PW)).upd PW
        (.int (2 ^ mainN0 n) :: s.G PW))
      ((((s.upd PRM (.int (mainN0 n) :: s.G PRM)).upd RN (.int (2 ^ mainN0 n) :: s.G RN)).upd RF
        (.int (2 ^ mainN0 n + 1) :: s.G RF)).upd ZZ (.int (n + 1) :: s.G ZZ))
      (3000 * (mainN0 n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hs1, zsz_one, add_comm (1 : ℤ)]
    refine ⟨by clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := moveIntCost_le (zsz ((2 : ℤ) ^ mainN0 n)); have := zsz_two_pow (mainN0 n)
    have := moveIntCost_le (zsz ((2 : ℤ) ^ mainN0 n + 1))
    have := zsz_add_le ((2 : ℤ) ^ mainN0 n) 1; rw [zsz_one] at this
    have := dupCost_le (zsz ((2 : ℤ) ^ mainN0 n))
    have := addIntCost_mono (show 1 + zsz ((2 : ℤ) ^ mainN0 n) ≤ mainN0 n + 2 by omega)
    have := addIntCost_le (mainN0 n + 2)
    omega
  refine (IRuns.seq h1 (IRuns.seq h2 (IRuns.seq h3 (IRuns.seq h4 (IRuns.seq h5
    (IRuns.seq h6 h7)))))).mono ?_
  simp only [mainACost, pow2Cost, ← he]
  nlinarith

theorem mainN0_facts (n : ℕ) :
    2 * n < mainN0 n ∧ 1 ≤ mainN0 n ∧ 2 ^ fmK (mainN0 n) ∣ mainN0 n ∧
      fmL (mainN0 n) = zsz ((n + 1 : ℕ) : ℤ) + 2 := by
  set e := zsz ((n + 1 : ℕ) : ℤ) with he
  have h1 : n + 1 < 2 ^ e := by
    have := natAbs_lt_zsz ((n + 1 : ℕ) : ℤ); rw [Int.natAbs_natCast] at this; exact this
  have hL : fmL (mainN0 n) = e + 2 := by
    simp only [fmL, mainN0]; rw [zsz_natCast_two_pow]
  refine ⟨?_, Nat.one_le_two_pow, ?_, hL⟩
  · show 2 * n < 2 ^ (e + 1); rw [pow_succ]; omega
  · apply pow_dvd_pow
    simp only [fmK, hL]; omega

theorem ss_exec (x y : List Bool) (hxy : x.length = y.length) :
    ∃ s' c, IExec (inputCodes x y) ssProg (ssProg 0) ⟨fun _ => [], 0, []⟩ s' c ∧
      s'.out = bin (2 * x.length) (val x * val y) ∧ c ≤ mainCost x.length := by
  set n := x.length with hn
  set I := inputCodes x y with hI
  set s0 : IState NS := ⟨fun _ => [], 0, []⟩ with hs0
  obtain ⟨hN0, hN01, hdiv, hL⟩ := mainN0_facts n
  have hvx := val_lt x
  have hvy := val_lt y
  rw [← hxy] at hvy
  -- reads
  have r1 := IRuns.op (I := I) (iprog := ssProg) (IOp.Step.read (s := s0) (i := ARG) (j := T1)
    (stop := codeSep) x (by decide) (by decide) (by decide)
    (by intro k hk; simp [hI, inputCodes, hs0, List.getD_eq_getElem?_getD, List.getElem?_append_left,
      hk])
    (by simp [hI, inputCodes, hs0, List.getD_eq_getElem?_getD]))
  set s1 : IState NS := { (s0.upd ARG (.int (val x : ℤ) :: s0.G ARG)).upd T1
      (.int (2 ^ x.length) :: (s0.upd ARG (.int (val x : ℤ) :: s0.G ARG)).G T1) with
        ip := s0.ip + x.length + 1 } with hs1
  have hip : s1.ip = x.length + 1 := by rw [hs1]; simp [hs0]
  have r2 := IRuns.op (I := I) (iprog := ssProg) (IOp.Step.read (s := s1) (i := ARG) (j := T2)
    (stop := codeEnd) y (by decide) (by decide) (by decide)
    (by
      intro k hk
      rw [hI, inputCodes, hip, List.getD_eq_getElem?_getD,
        List.getElem?_append_right (by simp; omega)]
      simp [show x.length + 1 + k - x.length = k + 1 by omega, hk])
    (by
      rw [hI, inputCodes, hip, List.getD_eq_getElem?_getD,
        List.getElem?_append_right (by simp; omega)]
      simp [show x.length + 1 + y.length - x.length = y.length + 1 by omega]))
  set s2 : IState NS := { (s1.upd ARG (.int (val y : ℤ) :: s1.G ARG)).upd T2
      (.int (2 ^ y.length) :: (s1.upd ARG (.int (val y : ℤ) :: s1.G ARG)).G T2) with
        ip := s1.ip + y.length + 1 } with hs2
  have r3 := mainA_runs (I := I) s2 n [] (by simp +decide [hs2, hs1, hs0]; try rfl)
  set s3 := ((((s2.upd PRM (.int (mainN0 n) :: s2.G PRM)).upd RN
    (.int (2 ^ mainN0 n) :: s2.G RN)).upd RF (.int (2 ^ mainN0 n + 1) :: s2.G RF)).upd ZZ
      (.int (n + 1) :: s2.G ZZ)) with hs3
  obtain ⟨t, r4, hout⟩ := main_tail (I := I) n s3 (val x) (val y) hvx hvy [] [] []
    (by simp +decide [hs3, hs2, hs1, hs0]) (by simp +decide [hs3, hs2, hs1, hs0]; try rfl)
    (by simp +decide [hs3, hs2, hs1, hs0, ← hxy]) (by simp +decide [hs3, hs2, hs1, hs0])
    (by simp +decide [hs3, hs2, hs1, hs0]) (by simp +decide [hs3, hs2, hs1, hs0])
  obtain ⟨c, hc, hE⟩ := IRuns.seq r1 (IRuns.seq r2 (IRuns.seq r3 r4))
  refine ⟨t, c, hE, ?_, ?_⟩
  · rw [hout]; simp [hs3, hs2, hs1, hs0]
  · refine hc.trans (le_of_eq ?_)
    simp only [mainCost, ← hxy]
    ring

end NLogN

