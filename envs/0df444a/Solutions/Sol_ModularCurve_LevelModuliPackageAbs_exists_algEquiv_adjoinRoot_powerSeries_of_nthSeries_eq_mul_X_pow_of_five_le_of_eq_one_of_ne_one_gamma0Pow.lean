section S4dom_sec

open IsLocalRing Polynomial

theorem glue_S4dom
    (q : ℕ) [Fact q.Prime] (W₀ : Type) [CommRing W₀] [IsDomain W₀] [IsDiscreteValuationRing W₀]
    (hW₀ : maximalIdeal W₀ = Ideal.span {(q : W₀)})
    (S : Type) [CommRing S] [IsLocalRing S] [Algebra W₀ S]
    (e : PowerSeries W₀ ≃ₐ[W₀] S)
    (gS : S[X]) (hm : gS.Monic) (hdeg : gS.natDegree = q - 1)
    (hcoef : ∀ i < q - 1, gS.coeff i ∈ maximalIdeal S)
    (hc0 : ∃ w : S, IsUnit w ∧ gS.coeff 0 = (q : S) * w) :
    IsDomain (AdjoinRoot gS) ∧ (q : S) ≠ 0 := by
  classical
  set f : S ≃+* PowerSeries W₀ := e.symm.toRingEquiv with hf
  have hm' : (gS.map f.toRingHom).Monic := hm.map _
  have hdeg' : (gS.map f.toRingHom).natDegree = q - 1 := by
    rw [Polynomial.natDegree_map_eq_of_injective f.injective, hdeg]
  have hcoef' : ∀ i < q - 1, (gS.map f.toRingHom).coeff i ∈ maximalIdeal (PowerSeries W₀) := by
    intro i hi
    rw [Polynomial.coeff_map]
    have h := hcoef i hi
    rw [mem_maximalIdeal, mem_nonunits_iff] at h ⊢
    intro hu
    exact h ((MulEquiv.isUnit_map f).mp hu)
  have hc0' : ∃ u : PowerSeries W₀, IsUnit u ∧ (gS.map f.toRingHom).coeff 0 = (q : PowerSeries W₀) * u := by
    obtain ⟨w, hw, h0⟩ := hc0
    refine ⟨f w, hw.map f, ?_⟩
    rw [Polynomial.coeff_map, h0]
    simp
  obtain ⟨-, hdom'⟩ :=
    Polynomial.prime_and_isDomain_adjoinRoot_of_monic_of_coeff_mem_maximalIdeal_powerSeries_of_coeff_zero_eq_natCast_mul
      q (Fact.out : q.Prime).two_le W₀ hW₀ (gS.map f.toRingHom) hm' hdeg' hcoef' hc0'
  have hI : Ideal.span {gS.map f.toRingHom} = (Ideal.span {gS}).map (Polynomial.mapEquiv f : S[X] →+* (PowerSeries W₀)[X]) := by
    rw [Ideal.map_span, Set.image_singleton]; rfl
  let ψ : AdjoinRoot gS ≃+* AdjoinRoot (gS.map f.toRingHom) :=
    Ideal.quotientEquiv (Ideal.span {gS}) (Ideal.span {gS.map f.toRingHom}) (Polynomial.mapEquiv f) hI
  haveI := hdom'
  haveI : NoZeroDivisors (AdjoinRoot gS) := ψ.injective.noZeroDivisors ψ (map_zero ψ) (map_mul ψ)
  haveI : Nontrivial (AdjoinRoot gS) := ψ.symm.injective.nontrivial
  refine ⟨NoZeroDivisors.to_isDomain _, ?_⟩

  have hq0 : (q : W₀) ≠ 0 := by
    intro h0
    apply IsDiscreteValuationRing.not_a_field W₀
    rw [hW₀, h0, Ideal.span_singleton_eq_bot]
  intro hqS
  apply hq0
  have h1 : (q : S) = e (algebraMap W₀ (PowerSeries W₀) (q : W₀)) := by
    rw [AlgEquiv.commutes, map_natCast]
  rw [h1, map_eq_zero_iff _ e.injective, map_natCast] at hqS
  have h2 : PowerSeries.constantCoeff (q : PowerSeries W₀) = (q : W₀) := by simp
  rw [← h2, hqS, map_zero]

end S4dom_sec

