# KFUU §7d: the uniform table set-up of one shift

`tabU neg` (register code): from the registers `oI = i`, `oQ = Q = s_i`, `oMu = μ`,
`oPi = P_i`, `oBv = B` and the sizes `s_{i-1}, …, s_0` on `oSP`, it pushes the offset table
`tbl Q (acL neg sF μ Q i)` on stack `14`, `P_i, Q, B` on stacks `1, 2, 4` (the parameters of
KFC `rotF`) and `-Q` on `sNQ`; `oSP` is restored.  `tabU_sp`, cost `cTab`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

/-- The table set-up. -/
def tabU (neg : Bool) : RS :=
  .seq (.push oPr (.lit 1)) (.seq (NLogN.mvK oSP oSQ oCM (.reg oI)) (.seq (coefL neg)
    (.seq (.pop oPr) (.seq (.push sNQ (.neg (.reg oQ))) (.seq (.push 14 (.lit 0))
      (.seq (.rep oCS (.reg oI) stageU) (.seq (.push 1 (.reg oPi))
        (.seq (.push 2 (.reg oQ)) (.push 4 (.reg oBv))))))))))

/-- Its cost bound. -/
def cTab (i P B Bb : ℕ) : ℕ := 10 ^ 10 * (i + 1) * ((B + 2) ^ 2 + (P + 1) * (Bb + 2))

/-- The managed lists at the end of the set-up. -/
def tabEnd (neg : Bool) (sF : ℕ → ℕ) (μ Q i Pi Bv : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
    (Function.update (fun _ => []) oSP ((List.range i).map fun j => (sF j : ℤ)).reverse)
    14 (tbl Q (acL neg sF μ Q i))) 1 [(Pi : ℤ)]) 2 [(Q : ℤ)]) 4 [(Bv : ℤ)]) sNQ [-(Q : ℤ)]

end NLogN.KFUU

end

section
-- Source module: Solutions.KFUURot5
/-!
# KFUU §7e: one uniform prefix-controlled shift

`rotCU neg`: the table set-up `tabU neg` (register code), KFC `rotF`, and the pops of the
parameters.  `rotCU_runs`: for `A = [s_0, …, s_{i-1}]` and any suffix `C` with
`vol C = Bv`, the data `xs` of shape `A ++ Q :: C` become KFU's controlled shift
`pull … (rotG |A| Q (fun a => lf cs a % Q))` with `cs = [cF neg sF μ Q j | j < i]`; the code does
not depend on `i, Q, μ, C`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL KFC AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The pops after the shift. -/
def postU : RS := .seq (.pop 1) (.seq (.pop 2) (.seq (.pop 4) (.pop sNQ)))

/-- One uniform shift. -/
def rotCU (neg : Bool) : IStmt HS Pp := .seq (NLogN.KFUU.tabU neg).code (.seq rotF postU.code)

/-- The coefficients of target `i`. -/
def csU (neg : Bool) (sF : ℕ → ℕ) (μ Q i : ℕ) : List ℕ := (List.range i).map (cF neg sF μ Q)

/-- Its cost. -/
def cRotU (i P Q Bv w B Bb : ℕ) : ℕ := NLogN.KFUU.cTab i P B Bb + cRotF P Q Bv w + 8 * B + 8

end NLogN.KFUU

end

section
-- Source module: Solutions.KFUURot6
/-!
# KFUU §7f: register updates around the uniform shifts

* `rotIU_runs`: `rotCU` realises KFU's shift `gRot` of target `i` on `shR d (sP d sF)`
  (`neg = false`: the forward coefficients `csF`, `neg = true`: the backward `csB`).
* `preF`/`postF` (forward, targets `d-1, …, 0`) and `preB`/`postB` (backward, `0, …, d-1`):
  pop `s_i`, `μ_i` into `oQ`, `oMu` and update `oPi = P_i`, `oI`, `oBv` (register code).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL KFC AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The list of remaining sizes (backward). -/
abbrev oSL : Fin HS := 3
/-- The list of multipliers. -/
abbrev oML : Fin HS := 32

/-- The volume behind target `i`. -/
def Cv (d : ℕ) (sF : ℕ → ℕ) (i : ℕ) : ℕ := vol (((List.range d).drop (i + 1) ++ [d]).map (KFU.sP d sF))

/-! ## Register updates -/

/-- Forward: take target `i` (from `oI = i+1`, `oPi = P_{i+1}`). -/
def preF : RS :=
  .seq (.push oQ (.reg oSP)) (.seq (.pop oSP) (.seq (.push oMu (.reg oML)) (.seq (.pop oML)
    (.seq (.asg oPi (.ndiv (.reg oPi) (.reg oQ))) (.asg oI (.add (.reg oI) (.lit (-1))))))))

/-- Forward: after the shift (`oBv := oBv · Q`, pop `Q`, `μ`). -/
def postF : RS :=
  .seq (.asg oBv (.mul (.reg oBv) (.reg oQ))) (.seq (.pop oQ) (.pop oMu))

/-- Backward: take target `i` (from `oSL`, `oML`; `oBv := oBv / Q`). -/
def preB : RS :=
  .seq (.push oQ (.reg oSL)) (.seq (.pop oSL) (.seq (.push oMu (.reg oML)) (.seq (.pop oML)
    (.asg oBv (.ndiv (.reg oBv) (.reg oQ))))))

/-- Backward: after the shift (push `Q` on `oSP`, `oPi := oPi · Q`, `oI := oI + 1`, pops). -/
def postB : RS :=
  .seq (.push oSP (.reg oQ)) (.seq (.asg oPi (.mul (.reg oPi) (.reg oQ)))
    (.seq (.asg oI (.add (.reg oI) (.lit 1))) (.seq (.pop oQ) (.pop oMu))))

end NLogN.KFUU

end

section
-- Source module: Solutions.KFUUPad
/-!
# KFUU §1: uniform padding and deletion scans

`padIU` / `unpadIU` are KFU's `padI X B Z` / `unpadI X B C` with the three literal counts read
from the parameter stacks `qX, qB, qZ = 50, 51, 52` (for `unpadIU`, `qZ` holds `C - B`).
`padIU_runs` / `unpadIU_runs` follow from `padI_spec` / `unpadI_spec` by `KFV.ISim.runs`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU

open IntMul KIL KFC KFT KFU AModel AModelL12

abbrev qX : Fin HS := 50
abbrev qB : Fin HS := 51
abbrev qZ : Fin HS := 52

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

def padBlkU : IStmt HS P :=
  .seq (rptX NLogN.KFUU.qB zA zC NLogN.KFU.zD (.op (.mv 0 zO))) (rptX NLogN.KFUU.qZ zA zC NLogN.KFU.zD (.op (.const zO 0)))

/-- Uniform padding scan. -/
def padIU : IStmt HS P :=
  .seq (.op (.mark zO)) (.seq (rptX NLogN.KFUU.qX oA oC NLogN.KFU.oD padBlkU) (.seq (mvW zO 0) (.op (.unmark zO))))

def unpBlkU : IStmt HS P :=
  .seq (rptX NLogN.KFUU.qB zA zC NLogN.KFU.zD (.op (.mv 0 zO))) (rptX NLogN.KFUU.qZ zA zC NLogN.KFU.zD (.op (.drop 0)))

/-- Uniform deletion scan. -/
def unpadIU : IStmt HS P :=
  .seq (.op (.mark zO)) (.seq (rptX NLogN.KFUU.qX oA oC NLogN.KFU.oD unpBlkU) (.seq (mvW zO 0) (.op (.unmark zO))))

/-- The parameter map of one scan. -/
def π3 (X B Z : ℕ) : PMap := pmOf [(NLogN.KFUU.qX, (X : ℤ)), (NLogN.KFUU.qB, (B : ℤ)), (NLogN.KFUU.qZ, (Z : ℤ))]

/-! ## The field loop of `embed` -/

abbrev tS : Fin HS := 47
abbrev tT : Fin HS := 48
abbrev pV : Fin HS := 49
abbrev pXr : Fin HS := 53
abbrev tq : Fin HS := 54
abbrev lA : Fin HS := 34
abbrev lC : Fin HS := 35
abbrev lD : Fin HS := 36

/-- Parameters of one padding scan: `qX := X`, `qB := V_k`, `qZ := T_k V_{k+1} - V_k`. -/
def prmB (pM : Fin P) : IStmt HS P :=
  .seq (.op (.dup pXr NLogN.KFUU.qX)) (.seq (.op (.mv pV NLogN.KFUU.qB)) (.seq (mulC pM pV NLogN.KFUU.tT NLogN.KFUU.qZ)
    (.seq (.op (.dup NLogN.KFUU.qB tq)) (.seq (.op (.neg tq)) (.op (.add NLogN.KFUU.qZ tq NLogN.KFUU.qZ))))))

def cPrm (X Vk V1 Tk : ℤ) : ℕ :=
  (dupCost (zsz X) + 17) + (2 * moveCost (zsz Vk) + 19) + cMul V1 Tk + (dupCost (zsz Vk) + 17) + 20 +
    addIntCost (zsz (Tk * V1) + zsz (-Vk))

/-- Stacks that may hold the input lists of the generic passes. -/
def LS (i : Fin HS) : Prop :=
  i.val = 5 ∨ i.val = 6 ∨ i.val = 7 ∨ i.val = 8 ∨ i.val = 9 ∨ i.val = 43 ∨ i.val = 44 ∨ i.val = 45

/-- The count register of the generic passes. -/
abbrev nR : Fin HS := 46

/-- After one padding scan: drop the parameters, `X ← T_k X`, move `T_k` back to `pT`. -/
def finB (pM : Fin P) (pT : Fin HS) : IStmt HS P :=
  .seq (.op (.drop NLogN.KFUU.qX)) (.seq (.op (.drop NLogN.KFUU.qB)) (.seq (.op (.drop NLogN.KFUU.qZ)) (.seq (mulC pM pXr NLogN.KFUU.tT tq)
    (.seq (.op (.drop pXr)) (.seq (.op (.mv tq pXr)) (.op (.mv NLogN.KFUU.tT pT)))))))

def cFin (a b c X Tk : ℤ) : ℕ :=
  (2 * zsz a + 2) + (2 * zsz b + 2) + (2 * zsz c + 2) + cMul X Tk + (2 * zsz X + 2) +
    (2 * moveCost (zsz (Tk * X)) + 19) + (2 * moveCost (zsz Tk) + 19)

/-- One field of the padding loop. -/
def padMB (pM : Fin P) (pT : Fin HS) : IStmt HS P := .seq (prmB pM) (.seq padIU (finB pM pT))

def cMB (X Vk V1 Tk w : ℕ) : ℕ :=
  cPrm X Vk V1 Tk + 2000 * cPadI X Vk (Tk * V1 - Vk) w +
    cFin X Vk ((Tk * V1 - Vk : ℕ) : ℤ) X Tk

/-! ## The volume lists -/

/-- A shape as a list of integers. -/
def zl (S : Shape) : List ℤ := List.map (fun a : ℕ => (a : ℤ)) S

/-- The suffix volumes `vol (S.drop i)` for `j ≤ i ≤ |S|`. -/
def sufV (S : Shape) (j : ℕ) : List ℤ :=
  ((List.range (S.length + 1)).drop j).map (fun i => (vol (S.drop i) : ℤ))

/-- Phase 1 of `padAllU`: the suffix volumes of `S` (given reversed on `pS`) on `pV`, while `S`
moves to `tS` (in order). -/
def sufP (pM : Fin P) (pS : Fin HS) : IStmt HS P :=
  rptX nR NLogN.KFUU.lA lC lD (.seq (mulC pM pV pS pV) (.op (.mv pS tS)))

/-- Move a list of `n` entries (`n` on `nR`) from `X` to `Y` (reversing it). -/
def mvL (X Y : Fin HS) : IStmt HS P := rptX nR NLogN.KFUU.lA lC lD (.seq .skip (.op (.mv X Y)))

/-- The main loop of `padAllU`. -/
def padLp (pM : Fin P) (pS pT : Fin HS) : IStmt HS P :=
  rptX nR NLogN.KFUU.lA lC lD (.seq (padMB pM pT) (.op (.mv tS pS)))

/-- **Uniform padding** `S ↦ T` (`S.reverse` on `pS`, `T.reverse` on `pT`, `|S|` on `nR`). -/
def padAllU (pM : Fin P) (pS pT : Fin HS) : IStmt HS P :=
  .seq (.op (.const pV 1)) (.seq (sufP pM pS) (.seq (mvL pT NLogN.KFUU.tT) (.seq (.op (.const pXr 1))
    (.seq (padLp pM pS pT) (.seq (.op (.drop pXr)) (.op (.drop pV)))))))

end Gen

end NLogN.KFUU

end

section
-- Source module: Solutions.KFUUUnpad
/-!
# KFUU §1b: uniform deletion of the padding

`unpadAllU pM pS pT`: `ys` on the padded shape `T` becomes `extract S T 0 ys` (KFU
`unpadAll_spec` with the per-field counts computed at run time from `S.reverse` on `pS`,
`T.reverse` on `pT` and `|S|` on `nR`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU

open IntMul KIL KFC KFT KFU AModel AModelL12

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- Parameters of one deletion scan: `qX := X`, `qB := S_k W_{k+1}`, `qZ := W_k - S_k W_{k+1}`. -/
def prmU (pM : Fin P) : IStmt HS P :=
  .seq (.op (.dup pXr NLogN.KFUU.qX)) (.seq (.op (.mv pV NLogN.KFUU.qZ)) (.seq (mulC pM pV NLogN.KFUU.tT NLogN.KFUU.qB)
    (.seq (.op (.dup NLogN.KFUU.qB tq)) (.seq (.op (.neg tq)) (.op (.add NLogN.KFUU.qZ tq NLogN.KFUU.qZ))))))

def cPrmU (X Wk W1 Sk : ℤ) : ℕ :=
  (dupCost (zsz X) + 17) + (2 * moveCost (zsz Wk) + 19) + cMul W1 Sk +
    (dupCost (zsz (Sk * W1)) + 17) + 20 + addIntCost (zsz Wk + zsz (-(Sk * W1)))

/-- One field of the deletion loop. -/
def unpMB (pM : Fin P) (pS : Fin HS) : IStmt HS P := .seq (prmU pM) (.seq unpadIU (finB pM pS))

def cUMB (X Wk W1 Sk w : ℕ) : ℕ :=
  cPrmU X Wk W1 Sk + 2000 * cUnpadI X (Sk * W1) Wk w +
    cFin X ((Sk * W1 : ℕ) : ℤ) ((Wk - Sk * W1 : ℕ) : ℤ) X Sk

/-- The main loop of `unpadAllU`. -/
def unpLp (pM : Fin P) (pS pT : Fin HS) : IStmt HS P :=
  rptX nR NLogN.KFUU.lA lC lD (.seq (unpMB pM pS) (.op (.mv tS pT)))

/-- **Uniform deletion of the padding** `T ↦ S` (`S.reverse` on `pS`, `T.reverse` on `pT`,
`|S|` on `nR`). -/
def unpadAllU (pM : Fin P) (pS pT : Fin HS) : IStmt HS P :=
  .seq (.op (.const pV 1)) (.seq (sufP pM pT) (.seq (mvL pS NLogN.KFUU.tT) (.seq (.op (.const pXr 1))
    (.seq (unpLp pM pS pT) (.seq (.op (.drop pXr)) (.op (.drop pV)))))))

end Gen

end NLogN.KFUU

end

