-- title:
--   Galois transport of Fricke-rational modular forms on Γ₁(N)
-- statement:
--   Fix $N \ge 1$ and a family $L$ of period pairs with $(L\,\tau).\omega_1 = \tau$, $(L\,\tau).\omega_2 = 1$ for every $\tau \in \mathbb{H}$. Let $W$ be given by $W_v(\tau) = (2\pi i)^{-2}\,\wp_{L\tau}\big((v_0\tau + v_1)/N\big)$ for $v \in (\mathbb{Z}/N)^2$ (values of `PeriodPair.weierstrassP` at $N$-division points, integer lifts of the coordinates being used), and let $\mathrm{fricke}_v(\tau) = -\big(E_4(\tau)E_6(\tau)/\Delta(\tau)\big)/2592 \cdot W_v(\tau)$ and $jf(\tau) = E_4(\tau)^3/\Delta(\tau)$. Let $K = \mathbb{Q}(\zeta)$ with $\zeta = e^{2\pi i/N}$, viewed as an intermediate field of $\mathbb{C}/\mathbb{Q}$, let $s$ be coprime to $N$, and let $\varphi : K \to \mathbb{C}$ be a ring homomorphism with $\varphi(z) = \zeta^{s}$ for every $z \in K$ whose image in $\mathbb{C}$ is $\zeta$. Let $k \in \mathbb{Z}$ and $a,b,m \in \mathbb{N}$ satisfy $k + 4a + 6b = 12m$, let $f$ be a modular form of weight $k$ on $\Gamma_1(N)$, and let $P, Q$ be polynomials over $K$ in variables indexed by $\mathrm{Option}\,\{v \ne 0\}$, evaluated by sending the base variable to $jf$ and the variable $v$ to $\mathrm{fricke}_v$. Assume that the evaluation of $Q$ (coefficients pushed into $\mathbb{C}$) is not the zero function on $\mathbb{H}$, and that $f(\tau)\,E_4(\tau)^a E_6(\tau)^b\, Q(jf,\mathrm{fricke})(\tau) = \Delta(\tau)^m\, P(jf,\mathrm{fricke})(\tau)$ for all $\tau$. Then, writing $Q^\varphi, P^\varphi$ for the polynomials with coefficients mapped by $\varphi$ and evaluating them at $jf$ together with the twisted Fricke family $v \mapsto \mathrm{fricke}_{(v_0,\,s v_1)}$, the evaluation of $Q^\varphi$ is again not the zero function, and there exists a modular form $f'$ of weight $k$ on $\Gamma_1(N)$ with $f'(\tau)\,E_4(\tau)^a E_6(\tau)^b\,Q^\varphi(\tau) = \Delta(\tau)^m\,P^\varphi(\tau)$ for all $\tau \in \mathbb{H}$.
--
--   This is the modular-form form of the classical rationality statement that the field generated by the Fricke functions of level $N$ over the $j$-line carries the action $\zeta_N \mapsto \zeta_N^{s}$ matched with the substitution $v \mapsto v\,\mathrm{diag}(1,s)$ on division points, so that a weight-$k$ form on $\Gamma_1(N)$ whose weight-zero companion is a $K$-rational fraction in $j$ and the Fricke functions may be transported along $\varphi$. It feeds the statement [`ModularForm.exists_gamma1_qCoeff_eq_algEquiv_apply_of_even`](thm.html#ModularForm.exists_gamma1_qCoeff_eq_algEquiv_apply_of_even) on the Galois action on $q$-expansion coefficients.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularForm_exists_gamma1_frickeRational_sigmaTransport.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
open Complex Real UpperHalfPlane
open scoped Manifold MatrixGroups ModularForm

theorem ModularForm.exists_gamma1_frickeRational_sigmaTransport
    (N : ℕ) [NeZero N]
    (L : ℍ → PeriodPair) (hL : ∀ τ : ℍ, (L τ).ω₁ = (τ : ℂ) ∧ (L τ).ω₂ = 1)
    (W : (Fin 2 → ZMod N) → ℍ → ℂ)
    (hW : ∀ (v : Fin 2 → ZMod N) (τ : ℍ), W v τ = ((2 * (Real.pi : ℂ) * Complex.I) ^ 2)⁻¹ *
      PeriodPair.weierstrassP (L τ) ((((v 0).val : ℂ) * (τ : ℂ) + ((v 1).val : ℂ)) / (N : ℂ)))
    (fricke : (Fin 2 → ZMod N) → ℍ → ℂ)
    (hfricke : ∀ (v : Fin 2 → ZMod N) (τ : ℍ), fricke v τ =
      -(ModularForm.E₄ τ * ModularForm.E₆ τ / ModularForm.discriminant τ) / 2592 * W v τ)
    (jf : ℍ → ℂ)
    (hjf : ∀ τ : ℍ, jf τ = ModularForm.E₄ τ ^ 3 / ModularForm.discriminant τ)
    (K : IntermediateField ℚ ℂ)
    (hK : K = IntermediateField.adjoin ℚ
      {Complex.exp (2 * (Real.pi : ℂ) * Complex.I / (N : ℂ))})
    (s : ℕ) (hs : Nat.Coprime s N)
    (φ : ↥K →+* ℂ)
    (hφ : ∀ z : ↥K, (z : ℂ) = Complex.exp (2 * (Real.pi : ℂ) * Complex.I / (N : ℂ)) →
      φ z = Complex.exp (2 * (Real.pi : ℂ) * Complex.I / (N : ℂ)) ^ s)
    (k : ℤ) (a b m : ℕ) (hk : k + 4 * a + 6 * b = 12 * m)
    (f : ModularForm (CongruenceSubgroup.Gamma1 N) k)
    (P Q : MvPolynomial (Option {v : Fin 2 → ZMod N // v ≠ 0}) ↥K)
    (hQ0 : MvPolynomial.aeval (fun o : Option {v : Fin 2 → ZMod N // v ≠ 0} =>
      o.elim jf fun v => fricke v.1) (Q.map (algebraMap ↥K ℂ)) ≠ 0)
    (hid : ∀ τ : ℍ, f τ * (ModularForm.E₄ τ ^ a * ModularForm.E₆ τ ^ b) *
        MvPolynomial.aeval (fun o : Option {v : Fin 2 → ZMod N // v ≠ 0} =>
          o.elim jf fun v => fricke v.1) (Q.map (algebraMap ↥K ℂ)) τ =
      ModularForm.discriminant τ ^ m *
        MvPolynomial.aeval (fun o : Option {v : Fin 2 → ZMod N // v ≠ 0} =>
          o.elim jf fun v => fricke v.1) (P.map (algebraMap ↥K ℂ)) τ) :
    ∃ f' : ModularForm (CongruenceSubgroup.Gamma1 N) k,
      MvPolynomial.aeval (fun o : Option {v : Fin 2 → ZMod N // v ≠ 0} =>
        o.elim jf fun v => fricke ![v.1 0, (s : ZMod N) * v.1 1]) (Q.map φ) ≠ 0 ∧
      ∀ τ : ℍ, f' τ * (ModularForm.E₄ τ ^ a * ModularForm.E₆ τ ^ b) *
          MvPolynomial.aeval (fun o : Option {v : Fin 2 → ZMod N // v ≠ 0} =>
            o.elim jf fun v => fricke ![v.1 0, (s : ZMod N) * v.1 1]) (Q.map φ) τ =
        ModularForm.discriminant τ ^ m *
          MvPolynomial.aeval (fun o : Option {v : Fin 2 → ZMod N // v ≠ 0} =>
            o.elim jf fun v => fricke ![v.1 0, (s : ZMod N) * v.1 1]) (P.map φ) τ := by sorry
