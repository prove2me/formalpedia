/-- The width growth of the chain fits in `EwB`. -/
theorem dw_le_ewb (D : ℕ) (hD : 1 ≤ D) :
    2 * q0f D (Nat.log mC D) + lowF DWl (Nat.log mC D) (D - q0f D (Nat.log mC D)) + 2 ≤
