-- title:
--   The canonical tagged experiment of SHARP against adversaries that observe past tags and the current tag law
-- statement:
--   SHARP is deterministic given its past tags and losses: its tag law $q_t$ in round $t$ is a function of $(J_u,g_u)_{u<t}$, hence so are its announcement $\rho_t=\sum_jq_t(j)\delta_{x_j}$, its past announcements and its past points $x_u=x_{J_u}$. In the **tagged experiment** (the analysis model of the upper bounds) the adversary may observe past tags and the current $q_t$; it is a standard Borel private state $S_D$ with initial law $\lambda_D$, preparation kernels $(h,r)\mapsto$ law of $(g_t,\tilde r)$ and update kernels $(h,g_t,J_t,\tilde r)\mapsto$ law of $r'$, with $h$ the tag–loss history. Each round draws, in order,
--   $$(g_t,\tilde S^D_t)\sim B_t,\qquad J_t\sim q_t\ \text{(fresh)},\qquad S^D_t\sim C^D_t,$$
--   and the physical action is $x_t=x_{J_t}$. The law is recorded on the initial adversary state and, per round, $((J_t,g_t),\tilde S^D_t,S^D_t)$; $\mathcal F_t$ is generated by the coordinates of the first $t$ rounds. On a tag–loss history, $R_T$ is the realized full swap regret of $(x_{J_t},g_t)_t$ and $R^{\mathrm{tag}}_T$ its tag sum.
--
--   Lemma B.7 and Theorem 4.1 are statements about this experiment, uniformly over such adversaries.
--
--   **Formalization Note.** Rounds are 0-based. The tag draw is `∑ j, ENNReal.ofReal (q j) • dirac j`. `sharpLaw sel D t` is the law with $q_t$ = `sharpResp sel` of the history. Every adversary of the public protocol is a `TagAdversary` after composing its kernels with the map from tag–loss histories to public histories.
-- source:
--   Saravanan, Minimax Realized Full Swap Regret on the Euclidean Disk, STOC 2027 submission (manuscript sha256 e7138cc2…), p. 14 (Eq. (A.6), stronger adversary), p. 18 (§A.3), p. 25 (Eqs. (B.21)–(B.24)), p. 9 (Algorithm 4.1)

import Mathlib
import Definitions.Def_SwapDisk_Main_Sharp

/-!
# The canonical tagged experiment for SHARP, against adversaries that see past tags

Saravanan, *Minimax Realized Full Swap Regret on the Euclidean Disk*, STOC 2027 submission
(manuscript sha256 e7138cc2…): p. 14 (Eq. (A.6) and the stronger adversary), p. 18 (§A.3, the
canonical tagged experiment), p. 25 (Eqs. (B.21)–(B.24)), p. 9 (Algorithm 4.1).

Conventions.
* SHARP is deterministic given the tag–loss history: its response `q_t` is a function of the
  past `(J_u, g_u)_{u<t}`, so its announcement `ρ_t = ∑_j q_t(j) δ_{x_j}`, its past announcements,
  past physical points `x_u = x_{J_u}` and current tag law `q_t` are all functions of that
  history. An adversary that sees past tags and the current `q_t` (the stronger adversary of the
  upper-bound analysis, p. 14, §A.3) is therefore a `TagAdversary`: a standard Borel private state,
  an initial law, preparation kernels `(h, r) ↦ law of (g_t, r̃)` and post-round update kernels
  `(h, g_t, J_t, r̃) ↦ law of r'`, with `h` the tag–loss history. Every adversary of the public
  protocol is of this form (compose its kernels with the history-to-public-history map).
* Rounds are indexed from `0`. The law is recorded on `S_D × (Fin t → (J × K) × S_D × S_D)`:
  the initial adversary state and, per round, `(J_t, g_t)`, `S̃^D_t` and `S^D_t` (all
  coordinates through round `t`; the learner's state is a function of them).
* The round is generated in the order of Eq. (A.11) with the tagged draw of §A.3:
  `(g_t, S̃^D_t) ∼ B_t`, a fresh tag `J_t ∼ q_t`, then `S^D_t ∼ C^D_t`.
* The fresh tag draw `J_t ∼ q_t` is `∑_j q_t(j) δ_j` (`ENNReal.ofReal` of the coordinates).
-/

open MeasureTheory ProbabilityTheory

namespace SwapDisk.Main

/-- An adversary in the tagged experiment that observes past tags, past losses and (through
them) every announcement and the current tag law. -/
structure TagAdversary (J : Type) [MeasurableSpace J] where
  /-- private-state space `S_D` -/
  S : Type
  [mS : MeasurableSpace S]
  [sbS : StandardBorelSpace S]
  /-- initial law `λ_D` -/
  init : Measure S
  [init_prob : IsProbabilityMeasure init]
  /-- preparation kernel: `(h, r) ↦ law of (g_t, S̃^D_t)` -/
  prep : (t : ℕ) → Kernel ((Fin t → J × Disk) × S) (Disk × S)
  [prep_markov : ∀ t, IsMarkovKernel (prep t)]
  /-- post-round update kernel: `(h, g_t, J_t, S̃^D_t) ↦ law of S^D_t` -/
  update : (t : ℕ) → Kernel ((Fin t → J × Disk) × Disk × J × S) S
  [update_markov : ∀ t, IsMarkovKernel (update t)]

attribute [instance] TagAdversary.mS TagAdversary.sbS TagAdversary.init_prob
  TagAdversary.prep_markov TagAdversary.update_markov

/-- Trajectories of the tagged experiment after `t` rounds: the initial adversary state and,
per round, `((J_t, g_t), S̃^D_t, S^D_t)`. -/
abbrev TagTraj (J : Type) [MeasurableSpace J] (D : TagAdversary J) (t : ℕ) : Type :=
  D.S × (Fin t → (J × Disk) × D.S × D.S)

/-- The tag–loss history `(J_u, g_u)_{u<t}` of a tagged trajectory. -/
def TagTraj.hist {J : Type} [MeasurableSpace J] {D : TagAdversary J} {t : ℕ}
    (z : TagTraj J D t) : Fin t → J × Disk :=
  fun u => (z.2 u).1

/-- The current adversary state of a tagged trajectory. -/
def TagTraj.cur {J : Type} [MeasurableSpace J] {D : TagAdversary J} :
    {t : ℕ} → TagTraj J D t → D.S
  | 0, z => z.1
  | t + 1, z => (z.2 (Fin.last t)).2.2

/-- The first `t` rounds of a tagged trajectory with `t ≤ n` rounds (the coordinates generating
`F_t`). -/
def TagTraj.prefix {J : Type} [MeasurableSpace J] {D : TagAdversary J} {n : ℕ} (t : ℕ)
    (ht : t ≤ n) (z : TagTraj J D n) : TagTraj J D t :=
  (z.1, fun u => z.2 (Fin.castLE ht u))

/-- The fresh tag draw `J ∼ q`, `q ∈ Δ(J)`. -/
noncomputable def tagDraw {J : Type} [Fintype J] [MeasurableSpace J] (q : J → ℝ) : Measure J :=
  ∑ j, ENNReal.ofReal (q j) • Measure.dirac j

/-- The canonical law of the tagged experiment for a learner whose tag law in round `t` is
`resp t h` (a function of the tag–loss history), against a `TagAdversary`. -/
noncomputable def tagLaw {J : Type} [Fintype J] [MeasurableSpace J]
    (resp : (t : ℕ) → (Fin t → J × Disk) → (J → ℝ)) (D : TagAdversary J) :
    (t : ℕ) → Measure (TagTraj J D t)
  | 0 => D.init.map (fun r => (r, Fin.elim0))
  | t + 1 => (tagLaw resp D t).bind (fun z =>
      (D.prep t (z.hist, z.cur)).bind (fun gr =>
        (tagDraw (resp t z.hist)).bind (fun j =>
          (D.update t (z.hist, gr.1, j, gr.2)).map (fun r' =>
            (z.1, Fin.snoc (α := fun _ => (J × Disk) × D.S × D.S) z.2 ((j, gr.1), gr.2, r'))))))

/-- The SHARP run with design horizon implicit in the selector, resolution `γ = 2^{−ℓ}`, nets
`X` and response selector `sel`: its canonical tagged law against `D` after `t` rounds. -/
noncomputable def sharpLaw {ell : ℕ} {X : Fin (ell + 1) → Finset E2}
    (sel : (Con ell X → ℝ) → (Tag ell X → ℝ)) (D : TagAdversary (Tag ell X)) (t : ℕ) :
    Measure (TagTraj (Tag ell X) D t) :=
  tagLaw (fun _ h => sharpResp sel h) D t

/-- The physical points `x_t = x_{J_t}` of a tag–loss history. -/
noncomputable def physActions {ell : ℕ} {X : Fin (ell + 1) → Finset E2} {t : ℕ}
    (h : Fin t → Tag ell X × Disk) : Fin t → Disk :=
  fun u => tagPt (h u).1

/-- The realized full swap regret `R_T` of the physical transcript of a tag–loss history. -/
noncomputable def physRegret {ell : ℕ} {X : Fin (ell + 1) → Finset E2} {t : ℕ}
    (h : Fin t → Tag ell X × Disk) : ℝ :=
  swapRegret (physActions h) (fun u => (h u).2)

/-- The tag sum `R^tag_T` of a tag–loss history. -/
noncomputable def tagRegret {ell : ℕ} {X : Fin (ell + 1) → Finset E2} {t : ℕ}
    (h : Fin t → Tag ell X × Disk) : ℝ :=
  tagSum tagPt (fun u => (h u).1) (fun u => (h u).2)

end SwapDisk.Main


