/-- **The right-hand side of `(15)`, as an integral.** -/
theorem solution {h : ℝ} (hh : 0 < h) (S : Set (EuclideanSpace ℝ (Fin d))) (R₀ : ℝ)
    (k : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℝ≥0∞)
    (f : EuclideanSpace ℝ (Fin d) → ℝ) :
    ∫⁻ p : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d), QFS.stepG d h S R₀ k f p
      = ∫⁻ p : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d),
          QFS.discreteC d h S R₀ (QFS.discreteKernel d k h) (QFS.cubeAvg d h f)
            (QFS.stepIndex d h p.1, QFS.stepIndex d h p.2) := by
  rw [QFS.lintegral_eq_tsum_halfClosedCube₂ hh,
    QFS.lintegral_stepFun₂ hh (fun x y => QFS.discreteC d h S R₀ (QFS.discreteKernel d k h) (QFS.cubeAvg d h f)
      (x, y))]
  refine tsum_congr fun nm => ?_
  set x := QFS.latticePt d h nm.1 with hx
  set y := QFS.latticePt d h nm.2 with hy
  set c : ℝ≥0∞ := (QFS.discretePairs d h S R₀).indicator
    (fun q => ENNReal.ofReal ((QFS.cubeAvg d h f q.1 - QFS.cubeAvg d h f q.2) ^ 2)) (x, y) with hc
  have hcne : c ≠ ∞ := by
    by_cases hm : ((x, y) : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d))
        ∈ QFS.discretePairs d h S R₀
    · rw [hc, Set.indicator_of_mem hm]; exact ENNReal.ofReal_ne_top
    · rw [hc, Set.indicator_of_notMem hm]; exact ENNReal.zero_ne_top
  have hdisc : QFS.discreteC d h S R₀ (QFS.discreteKernel d k h) (QFS.cubeAvg d h f) (x, y)
      = c * QFS.discreteKernel d k h x y := by
    by_cases hm : ((x, y) : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d))
        ∈ QFS.discretePairs d h S R₀
    · rw [QFS.discreteC, Set.indicator_of_mem hm, hc, Set.indicator_of_mem hm]
    · rw [QFS.discreteC, Set.indicator_of_notMem hm, hc, Set.indicator_of_notMem hm, zero_mul]
  have hcongr : ∀ p ∈ QFS.halfClosedCube h x ×ˢ QFS.halfClosedCube h y,
      QFS.stepG d h S R₀ k f p = c * k p.1 p.2 := by
    intro p hp
    rw [QFS.stepG, hc, QFS.stepIndex_eq_of_mem hh (QFS.latticePt_mem_scaledLattice h nm.1) hp.1,
      QFS.stepIndex_eq_of_mem hh (QFS.latticePt_mem_scaledLattice h nm.2) hp.2]
  rw [setLIntegral_congr_fun ((QFS.measurableSet_halfClosedCube h x).prod
      (QFS.measurableSet_halfClosedCube h y)) hcongr,
    lintegral_const_mul' _ _ hcne, QFS.lintegral_halfClosedCube₂_eq_cube₂ hh, hdisc, mul_assoc,
    QFS.discreteKernel, mul_comm (ENNReal.ofReal ((h ^ (2 * d))⁻¹)), mul_assoc,
    QFS.ofReal_inv_pow_mul hh, mul_one]
