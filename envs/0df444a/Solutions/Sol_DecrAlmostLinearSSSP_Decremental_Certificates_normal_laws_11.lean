    (h1 : s.natReg 1 = 1) (h14 : s.natReg 14 = 2)
    (ins : Instruction) (cost : ℕ) (he : Eval (.seq (shadowAction ins) appendStoreReport) s cost t)
    (address : ℕ) (hout : ∀ a, address ≠ B+F*(2*a+1)) (hreport : address ≠ s.natReg 10) :
    t.realMem address = s.realMem address ∧ t.natMem address = s.natMem address := by
  cases he with
  | @seq _ _ _ u _ first last ha happ =>
    have hu1 : u.natReg 1 = 1 := (ha.nat_frame (shadowAction_nat_frame ins 1 (by omega) (by omega) (by omega) (by omega))).trans h1
    have hu14 : u.natReg 14 = 2 := (ha.nat_frame (shadowAction_even_frame ins 14 (by omega) (by decide))).trans h14
    have hu10 : u.natReg 10 = s.natReg 10 := ha.nat_frame (shadowAction_even_frame ins 10 (by omega) (by decide))
    have hmem := shadowAction_memory_frame h hb hf ins first ha address hout
    obtain ⟨_,rfl⟩ := happ.deterministic (append_report_eval u hu1 hu14)
    have hne : address ≠ u.natReg 10 := by rwa [hu10]
    exact ⟨hmem.1,(Function.update_of_ne hne _ _).trans hmem.2⟩
lemma observedAction_memory_frame {B F : ℕ} {s t : Data} {g : Machine}
    (h : ShadowDataRep B F s g) (hb : s.natReg 0 = B) (hf : s.natReg 7 = F)
    (h1 : s.natReg 1 = 1) (h14 : s.natReg 14 = 2)
    (ins : Instruction) (cost : ℕ) (he : Eval (observedAction ins) s cost t)
    (address : ℕ) (hout : ∀ a, address ≠ B+F*(2*a+1)) (hreport : address ≠ s.natReg 10) :
    t.realMem address = s.realMem address ∧ t.natMem address = s.natMem address := by
  by_cases hi : NoStore ins
  · have heq : observedAction ins = shadowAction ins := by cases ins <;> first | rfl | exact False.elim hi
    rw [heq] at he
    exact shadowAction_memory_frame h hb hf ins cost he address hout
  · cases ins with
    | store a d => exact shadowAction_append_memory_frame h hb hf h1 h14 (.store a d) cost he address hout hreport
    | storeN a d => exact shadowAction_append_memory_frame h hb hf h1 h14 (.storeN a d) cost he address hout hreport
