/-!
# Minkowski space in spherical coordinates `(t, r, θ, φ)`

`ds² = -dt² + dr² + r²(dθ² + sin²θ dφ²)` (Müller–Grave, *Catalogue of Spacetimes*, eq. minkSph).
The data below are written independently; the certificate is obtained by proving that they
coincide with standard Schwarzschild at `M = 0` on the domain, then transporting `Std.cert 0`.
Domain: `r > 0`, `0 < θ < π` (`domEF`), so the axis and the origin are excluded.
-/

open Real

namespace ExactVacuumAtlas.Minkowski

open ExactVacuumAtlas.Schwarzschild

theorem domStd_zero : domStd 0 = domSph := by
  ext x
  simp only [domStd, domSph, domEF, Set.mem_setOf_eq, mul_zero]
  constructor
  · rintro ⟨h1, -, h3, h4⟩; exact ⟨h1, h3, h4⟩
  · rintro ⟨h1, h3, h4⟩; exact ⟨h1, h1.ne', h3, h4⟩

theorem g_eq (i j : Fin 4) : Set.EqOn (gStd 0 i j) (gSph i j) domSph := by
  intro x _
  fin_cases i <;> fin_cases j <;> simp [gStd, gSph]

theorem gi_eq (i j : Fin 4) : Set.EqOn (giStd 0 i j) (giSph i j) domSph := by
  intro x _
  fin_cases i <;> fin_cases j <;> simp [giStd, giSph]

end ExactVacuumAtlas.Minkowski

-- ==== solution ====
open Real
open ExactVacuumAtlas
open ExactVacuumAtlas.Minkowski
open ExactVacuumAtlas.Schwarzschild
theorem solution : VacuumCertificate gSph giSph domSph := by
  have h := Std.cert 0
  rw [domStd_zero] at h
  exact h.congr g_eq gi_eq
