  · rw [NumberField.Idele.partAt_snd_of_not_mem K S _ hv, NumberField.Idele.partAt_snd_of_not_mem K S _ hv]

private theorem t0398 : MeasurableSet (Set.range (NumberField.Idele.partAt K S)) := by
  have h : Set.range (NumberField.Idele.partAt K S) = {a | NumberField.Idele.partAt K S a = a} := by
