-- title:
--   Eventual bounded representatives imply strict power generators
-- statement:
--   If all sufficiently high powers admit representatives with weighted degree growing at a fixed rate strictly below R, then some power is generated by elements of that power with a uniform cutoff strictly below its index times R.

import Definitions.Def_OAI_PiExponent_TruncatedPolynomialJets
import Definitions.Def_OAI_PiExponent_LogarithmicInterpolationNumerics
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Algebra.Polynomial.AlgebraMap

open scoped BigOperators
open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.bounded_quotient_representatives_imply_strict_power_generators
    {m : Nat} (w : Fin (m + 1) → Rat) (R : Rat)
    (I : Ideal (MvPolynomial (Fin (m + 1)) Complex))
    (hR : 0 < R) (hw : ∀ i, 0 < (w i : Real))
    (δ : Rat) (hδpos : 0 < δ) (hδR : δ < R)
    (n₀ : Nat)
    (hrep : ∀ n : Nat, n₀ ≤ n → ∀ p : MvPolynomial (Fin (m + 1)) Complex,
      ∃ q : MvPolynomial (Fin (m + 1)) Complex,
        p - q ∈ I ^ n ∧
        ∀ a ∈ q.support,
          ∑ i, (w i : Real) * (a i : Real) ≤ (n : Real) * (δ : Real)) :
    ∃ s : Nat, ∃ D : Rat,
      (D : Real) < (s : Real) * (R : Real) ∧
      I ^ s = Ideal.span {p : MvPolynomial (Fin (m + 1)) Complex |
        p ∈ I ^ s ∧
        ∀ a ∈ p.support, ∑ i, (w i : Real) * (a i : Real) ≤ (D : Real)} := by sorry
