      t.index 0 = (if tag = 0 then 7 else 7+d*n) ∧ t.data = s.data ∧
      ∀ j,j ≠ 0 → j ≠ 10 → j ≠ 11 → t.index j = s.index j := by
  by_cases ht : tag = 0
