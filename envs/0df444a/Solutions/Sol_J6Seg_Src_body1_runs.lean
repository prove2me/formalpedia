    update_of_ne (show (14 : Fin HS) ≠ 44 by decide), update_of_ne (show (15 : Fin HS) ≠ 44 by decide),
    update_of_ne (show (30 : Fin HS) ≠ 44 by decide), update_of_ne (show (31 : Fin HS) ≠ 44 by decide),
