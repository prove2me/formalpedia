section
-- Source module: Solutions.NetProp7Alg
/-!
# Prop. 7, part 2: the label algebra

The gate labels of table (6) are projections `P_U` onto tensor subspaces of `F^{⊗3}`,
`F = ℚ^h` with the form `G = I − J/9`. We work directly with their matrices:

* `piM S = ½ t_S (G t_S)ᵀ` is the `G`-orthogonal projection onto the triple line `⟨t_S⟩`
  (`piM_idem`, `trace_piM = 1`, and `piM S * piM T = 0` for neighbouring triples);
* in stage `j` (0-indexed) for the bank with fixed triples `S₁, S₂`, the projections
  `αM j` onto `P ⊗ F ⊗ Q`, `AM j` onto `A ⊗ F ⊗ Q` and `τM j t` onto
  `F^{⊗ j} ⊗ ⟨t⟩ ⊗ F^{⊗(2-j)}` are Kronecker products (`kr3`);
  `B ⊗ F ⊗ Q` has projection `AM − αM`.

The abstract relations (`SRel`) between `α, A, τ` give the rank of every edge difference of
table "Lemma 6" through `rank = trace` for idempotents. The per-wire chain identities
(`chainX`, `chainX0`, `chainY`, `chainC`, `chainS`) are the content of Lemma 6.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace NetProp7

open Matrix Finset NetLabels
open scoped Kronecker

/-! ## 1. Idempotent algebra -/

section Ring

variable {R : Type*} [Ring R]

end Ring

/-! ## 2. Rank of idempotents -/

section Rank

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Rank of a rational matrix, as a rational number. -/
noncomputable abbrev rk (E : Matrix n n ℚ) : ℚ := (E.rank : ℚ)

end Rank

/-! ## 3. Abstract stage relations and the edge ranks of Lemma 6 -/

section Stage

variable {n : Type*} [Fintype n] [DecidableEq n] {ι : Type*}

/-- Relations between the stage projections: `α` onto `P ⊗ F ⊗ Q`, `A` onto `A ⊗ F ⊗ Q`,
`τ t` onto the slot-`j` triple line; `Nb` the neighbour relation; `a = dim A`, `h = dim F`. -/
structure SRel (α A : Matrix n n ℚ) (τ : ι → Matrix n n ℚ) (Nb : ι → ι → Prop) (h a : ℚ) :
    Prop where
  αα : α * α = α
  AA : A * A = A
  Aα : A * α = α
  αA : α * A = α
  ττ : ∀ t, τ t * τ t = τ t
  τα : ∀ t, Commute (τ t) α
  τA : ∀ t, Commute (τ t) A
  nb : ∀ s t, Nb s t → τ s * τ t = 0
  trα : trace α = h
  trA : trace A = a * h
  trατ : ∀ t, trace (α * τ t) = 1
  trAτ : ∀ t, trace (A * τ t) = a

variable {α A : Matrix n n ℚ} {τ : ι → Matrix n n ℚ} {Nb : ι → ι → Prop} {h a : ℚ}

namespace SRel

variable (S : SRel α A τ Nb h a)
include S

end SRel

/-- The label of the gate at time `k` of table (6), with `τ` the gate's triple projection
(`B ⊗ ⟨t⟩`, `B ⊗ F`, `(B ⊗ F) ⊥ (P ⊗ ⟨t⟩)`, `A ⊗ F`, `B ⊗ F`, `(B ⊗ F) ⊥ (P ⊗ t^⊥)`,
`A ⊗ F`, `A ⊗ F`, all tensored with `Q`). -/
def labK (α A τ : Matrix n n ℚ) : ℕ → Matrix n n ℚ
  | 0 => (A - α) * τ
  | 1 => A - α
  | 2 => A - α + α * τ
  | 3 => A
  | 4 => A - α
  | 5 => A - α * τ
  | _ => A

namespace SRel

variable (S : SRel α A τ Nb h a)
include S

end SRel

end Stage

/-! ## 4. The concrete projections -/

section Concrete

variable {h : ℕ}

/-- Index set of `F^{⊗3}`. -/
abbrev Cube (h : ℕ) := Fin h × Fin h × Fin h

/-- The `G`-orthogonal projection onto the triple line `⟨t_S⟩`: `½ t_S (G t_S)ᵀ`. -/
noncomputable def piM (S : Finset (Fin h)) : Matrix (Fin h) (Fin h) ℚ :=
  (2 : ℚ)⁻¹ • vecMulVec (NetLabels.ind ℚ S) (bitGram ℚ h *ᵥ NetLabels.ind ℚ S)

/-- Triple Kronecker product on `Fin h × (Fin h × Fin h)`. -/
def kr3 (X Y Z : Matrix (Fin h) (Fin h) ℚ) : Matrix (Cube h) (Cube h) ℚ := X ⊗ₖ (Y ⊗ₖ Z)

/-- `P ⊗ F ⊗ Q` at stage `j` (0-indexed) for the bank with fixed triples `S₁, S₂`. -/
noncomputable def αM (j : Fin 3) (S₁ S₂ : Finset (Fin h)) : Matrix (Cube h) (Cube h) ℚ :=
  if j = 0 then kr3 1 (piM S₁) (piM S₂) else if j = 1 then kr3 (piM S₁) 1 (piM S₂)
  else kr3 (piM S₁) (piM S₂) 1

/-- `A ⊗ F ⊗ Q` at stage `j`. -/
noncomputable def AM (j : Fin 3) (S₁ S₂ : Finset (Fin h)) : Matrix (Cube h) (Cube h) ℚ :=
  if j = 0 then kr3 1 (piM S₁) (piM S₂) else if j = 1 then kr3 1 1 (piM S₂) else kr3 1 1 1

/-- `⟨t⟩` in slot `j`. -/
noncomputable def τM (j : Fin 3) (S : Finset (Fin h)) : Matrix (Cube h) (Cube h) ℚ :=
  if j = 0 then kr3 (piM S) 1 1 else if j = 1 then kr3 1 (piM S) 1 else kr3 1 1 (piM S)

/-- The pure-tensor line `U_a = ⟨t_{a₁} ⊗ t_{a₂} ⊗ t_{a₃}⟩`. -/
noncomputable def uM (S₁ S₂ S₃ : Finset (Fin h)) : Matrix (Cube h) (Cube h) ℚ :=
  kr3 (piM S₁) (piM S₂) (piM S₃)

variable {T : Type*} (ind : T → Finset (Fin h))

/-! Stage boundaries (§3.3: the outgoing labels of stage `j` are the incoming labels of stage
`j + 1`), and the terminal labels. Here `S₁, S₂, S₃` are the triples of `a`. -/

section Boundary

variable (S₁ S₂ S₃ : Finset (Fin h))

end Boundary

end Concrete

end NetProp7

end

