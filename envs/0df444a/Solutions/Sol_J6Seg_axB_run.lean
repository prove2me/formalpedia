-- Source module: Solutions.J6SegILSweep1
/-!
# B-line IL, B6 (the sweep over the axes) §1: the axis contract, the state, the arithmetic

* `descAx6 P n src D k = [k, pre_k, post_k, src k, t_k, p, α, d]` with `pre_k = ∏_{j<k} t_j`,
  `post_k = ∏_{k<j≤D} t_j` (as `List.ofFn (tD6 P n D)` take / drop products);
* **`AxisBody6`**: procedure `eX` runs the seven passes of axis `k` (`pipe6 P n src D k`) on
  stack `0`, reading `descAx6` from `dA` (the convention of `FineBody6` / `RowBody6`);
* `ax_call`: the call on any managed state with the descriptor pushed on `dA`;
* the sweep state `SS σ dS F z ds v` (registers `σ : Fin 19 → Fin HS` with contents `v`);
* the products: `t_j = 2^h (1 + b_j)`, `∏_{j<k} t_j = 2^{hk + #ones}`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-! ## The axis contract -/

/-- The axis call on any managed state with the descriptor on top of `dA`. -/
theorem ax_callF {Pp : ℕ} {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D : ℕ} {pf : ℕ → List GI → List GI}
    {Isym : List Sym}
    {tbl : Fin Pp → IStmt HS Pp} {eX : Fin Pp} {dA : Fin HS} {C : ℝ}
    (hX : AxisBodyF P n src D pf Isym tbl eX dA C) (hA0 : dA ≠ 0) (k : ℕ) (hk : k ≤ D)
    (s : IState HS) (G : Fin HS → List ℤ) (L : List GI) (l : List ℤ)
    (h0 : G 0 = gflat L ++ l) (hlen : L.length = (List.ofFn (tD6 P n D)).prod)
    (hgb : GB (pP6 P n + 2) L) :
    ∃ c : ℕ, IRuns Isym tbl (.call eX) (encK s (update G dA (descAx6 P n src D k ++ G dA)))
        (encK s (update (update G dA (descAx6 P n src D k ++ G dA)) 0
          (gflat (pf k L) ++ l))) c ∧ (c : ℝ) ≤ C := by
  set H : Fin HS → List ℤ := fun j => if j = 0 then G 0 else if j = dA then descAx6 P n src D k
    else [] with hH
  set Gb : Fin HS → List ℤ := fun j => if j = 0 then [] else G j with hGb
  have hs : ∀ v : List ℤ, ∀ j, update (update G dA (descAx6 P n src D k ++ G dA)) 0 v j =
      update H 0 v j ++ Gb j := by
    intro v j
    by_cases h1 : j = 0
    · subst h1; simp [hGb]
    by_cases h2 : j = dA
    · subst h2; simp [hH, hGb, h1]
    · simp [hH, hGb, h1, h2]
  have hk' : ∀ j, update G dA (descAx6 P n src D k ++ G dA) j = H j ++ Gb j := by
    intro j
    by_cases h1 : j = 0
    · subst h1; simp [hH, hGb, Ne.symm hA0]
    by_cases h2 : j = dA
    · subst h2; simp [hH, hGb, h1]
    · simp [hH, hGb, h1, h2]
  obtain ⟨c, r, k1⟩ := hX k hk (encK s Gb) H L l (fun j hj0 hjA => by simp [hH, hj0, hjA])
    (by simp [hH, hA0]) (by simp [hH, h0]) hlen hgb
  rw [encK_split s hk', encK_split s (hs _)]
  exact ⟨c, r, k1⟩

/-! ## The sweep state -/

section SSl
variable {σ : Fin 19 → Fin HS} {dS dA : Fin HS} (hW : SwOK σ dS dA)
  (F : Fin HS → List ℤ) (z ds : List ℤ) (v : Fin 19 → List ℤ)
include hW

theorem SS_at0 : SS σ dS F z ds v 0 = z := by simp [SS]

theorem SS_at (i : Fin 19) : SS σ dS F z ds v (σ i) = v i := by
  simp [SS, hW.ne0 i, hW.neS i, hW.inj.extend_apply]

theorem SS_z (x : List ℤ) : update (SS σ dS F z ds v) 0 x = SS σ dS F x ds v := by
  funext j
  by_cases h : j = 0
  · subst h; simp [SS]
  · simp [SS, update_of_ne h, h]

end SSl

/-! ## The products of the axis lengths -/

theorem preT_eq (P : Prm) (n D k : ℕ) (hk : k ≤ D + 1) :
    preT P n D k = ((List.range k).map (tF6 P n)).prod := by
  unfold preT
  rw [ofFn_tD6, ← List.map_take, List.take_range, Nat.min_eq_left hk]

theorem pre_t_post (P : Prm) (n D k : ℕ) (hk : k ≤ D) :
    preT P n D k * tF6 P n k * postT P n D k = (List.ofFn (tD6 P n D)).prod := by
  have h1 : preT P n D (k + 1) = preT P n D k * tF6 P n k := by
    rw [preT_eq P n D _ (by omega), preT_eq P n D _ (by omega), List.range_succ, List.map_append,
      List.prod_append]
    simp
  rw [← h1]
  unfold preT postT
  exact List.prod_take_mul_prod_drop _ _

theorem preT_pow (P : Prm) (n D k : ℕ) (hk : k ≤ D + 1) :
    preT P n D k = 2 ^ (hN6 P n * k + cntB P n k) := by
  rw [preT_eq P n D k hk, prod_range_tF6]

end J6Seg

end

