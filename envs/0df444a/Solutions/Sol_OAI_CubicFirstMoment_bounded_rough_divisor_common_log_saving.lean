  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a ha
  apply Finset.sum_congr rfl
  intro b hb
  simp only [divisorGramCoefficient,dispersionAmplitude,divisorTwistedCoefficient,
    mixedSymbol,star_mul,star_star]
