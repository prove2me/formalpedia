section Prologue

/-- The parameter block: `r0 = t`, `r1 = w`, `r2 = S0` (the syndrome base), `r3 = 2^w - 1` (the
field mask), `r4 = detSqBase w` (the squaring table), `r15 = 8w` (the word width), and the scratch
registers cleared. -/
def paramBody : List Instr :=
  movI r14 0 ++ tbl r0 r14 ++ movI r14 1 ++ tbl r1 r14 ++ movI r14 4 ++ tbl r2 r14 ++
  movI r14 5 ++ tbl r3 r14 ++ movI r14 6 ++ tbl r4 r14 ++ movI r14 12 ++ tbl r15 r14 ++
  movI r14 0 ++ movI r8 1

end Prologue

