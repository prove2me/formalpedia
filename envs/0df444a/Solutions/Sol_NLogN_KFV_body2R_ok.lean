    (by rw [vG]; exact Nat.one_le_two_pow) (by rw [vA]; exact Nat.one_le_two_pow)
    (by simp +decide [t, mvFr, Function.update_apply, v, ints])
    (LX := S.G qX) (LB := S.G NLogN.KFV.qB) (LZ := S.G qZ)
    (by simp +decide [t, mvFr, Function.update_apply, vA, ints])
    (by simp +decide [t, mvFr, Function.update_apply, vG, ints])
    (by simp +decide [t, mvFr, Function.update_apply, vC, ints])
  have hlA : A.length = c := by simp [A]
  have hlG : G.length = δ := by simp [G]
  rw [hlA, hlG, List.length_singleton] at R2
  have hP : pull (A ++ [2] ++ G ++ C) (A ++ G ++ [2] ++ C) (KIL.swapMid c 1 δ) 0 (gflat zs) =
      gflat (zMv (c + 1 + δ + e) (2 ^ ℓ) (KFU.mvIdx c 1 δ) zs) := by
    rw [hsh, hsh', gflat_zMv zs (by rw [vol_binSh_r]; exact hzs)]
  rw [hP] at R2
  set v' := gflat (zMv (c + 1 + δ + e) (2 ^ ℓ) (KFU.mvIdx c 1 δ) zs) ++ l
  have e2 : t.upd 0 (ints (gflat (zMv (c + 1 + δ + e) (2 ^ ℓ) (KFU.mvIdx c 1 δ) zs)) ++
      (ints l ++ S.G 0)) = encK S (mvFr v' c δ (e + ℓ + 1)) := by
    rw [← List.append_assoc, ← NLogN.ints_append, encK_upd]
    congr 1
    funext j
    by_cases h0 : j = 0
    · subst h0; simp +decide [mvFr, Function.update_apply, o0, v']
    · simp only [mvFr, Function.update_apply, o0, h0, if_false]
  rw [e2] at R2
  have R3 := FSp.irun (I := I) (iprog := iprog) fok_mvPop
    (mvPop_sp S v' (B := B) (a := c) (b := δ) (c := e + ℓ + 1) (by omega) (by omega) (by omega))
  refine (R1.seq (R2.seq R3)).mono' rfl ?_
  have v2 : vol [2] = 2 := by simp [vol]
  unfold cMvF cMvR
  simp only [vA, vG, vC, v2]
  omega

end NLogN.KFV

end

section
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFV
open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)
set_option maxHeartbeats 4000000
theorem solution (hK : 0 < K) (hℓ : 2 ≤ ℓ) (hq1 : 1 ≤ Synth.qq ℓ K) {mk p W B : ℕ}
    (hB : (NLogN.KFV.pLP D ℓ K long).n + ℓ + 5 ≤ B) :
    NLogN.KFV.LoopBody (r := 2 ^ ℓ) I iprog NLogN.KFV.body2R (fun s => NLogN.KFV.LRg s (NLogN.KFV.pLP D ℓ K long) mk W)
      (fun j s => NLogN.KIL.encK s (NLogN.KFV.F2 (Synth.bb ℓ K * D) (Synth.bb ℓ K * D - j)))
      (fun j => NLogN.KFV.runArrR (NLogN.KFV.pLP D ℓ K long).n 0 [NLogN.KFV.op2 D ℓ K long (Synth.bb ℓ K * D - 1 - j)])
      (2 ^ (NLogN.KFV.pLP D ℓ K long).n) p W (NLogN.KFV.cBody2R D ℓ K long (NLogN.KFV.pLP D ℓ K long).n W B) (Synth.bb ℓ K * D) := by
  intro j hj s hQ zs l xs hx hl hgb hd
  have e1 : Synth.bb ℓ K * D - j = (Synth.bb ℓ K * D - 1 - j) + 1 := by omega
  have e2 : Synth.bb ℓ K * D - (j + 1) = Synth.bb ℓ K * D - 1 - j := by omega
  beta_reduce
  rw [e1, e2]
  set k := Synth.bb ℓ K * D - 1 - j with hk_
  have hk : k < Synth.bb ℓ K * D := by omega
  have hn0 := NLogN.KFV.pLP_n D ℓ K long hK (by omega)
  set n := (NLogN.KFV.pLP D ℓ K long).n with hn
  set b := Synth.bb ℓ K with hb
  set q := Synth.qq ℓ K with hq
  set nL := NLogN.KFV.nLong D long with hnL
  have hbq : b + q * K = ℓ - 1 := NLogN.KFV.hbq ℓ K hK (by omega)
  have hD : 0 < D := Nat.pos_of_ne_zero (NeZero.ne D)
  set u := k / D with hu
  set i := k % D with hi
  have hki : u * D + i = k := by rw [hu, hi, Nat.mul_comm]; exact Nat.div_add_mod k D
  have hiD : i < D := Nat.mod_lt _ hD
  have hiK : i ≤ k := Nat.mod_le _ _
  have hub : u < b := by rw [hu]; exact (Nat.div_lt_iff_lt_mul hD).2 hk
  have huk : u ≤ k := Nat.div_le_self _ _
  have huk' : (((k / D : ℕ)) : ℤ) ≤ (k : ℤ) := by exact_mod_cast Nat.div_le_self k D
  have hub' : (((k / D : ℕ)) : ℤ) < (b : ℤ) := by exact_mod_cast hub
  have hkD0 : (0 : ℤ) ≤ (((k / D : ℕ)) : ℤ) := Int.natCast_nonneg _
  have hkD1 : (0 : ℤ) ≤ ((k : ℤ) / (D : ℤ)) := by positivity
  have hkD2 : ((k : ℤ) / (D : ℤ)) ≤ (k : ℤ) := Int.ediv_le_self _ (by positivity)
  have hkD3 : ((k : ℤ) / (D : ℤ)) < (b : ℤ) := by rw [← Int.natCast_ediv]; exact_mod_cast hub
  have hDl : ℓ - 1 ≤ D * (ℓ - 1) := Nat.le_mul_of_pos_left _ hD
  set w := b - 1 - u with hw
  set c := nL + k with hc
  set δ := NLogN.KFV.dl2 D ℓ K k with hδ
  have hδ' : δ = i * (q * K + w) + q * K := by rw [hδ, NLogN.KFV.dl2]
  have h1 : i * w ≤ D * w := Nat.mul_le_mul_right _ hiD.le
  have h2 : (i + 1) * (q * K) ≤ D * (q * K) := Nat.mul_le_mul_right _ hiD
  have hKq : K ≤ q * K := Nat.le_mul_of_pos_left _ hq1
  have hcδ : c + δ + 1 ≤ n := by
    rw [hn0, hc, hδ', ← hki]
    have : ℓ - 1 = u + 1 + w + q * K := by omega
    rw [this]; nlinarith
  set e := n - 1 - c - δ with he
  have hne : c + 1 + δ + e = n := by omega
  have hDn : D ≤ n := by
    have := Nat.mul_le_mul_left D (show 1 ≤ ℓ - 1 by omega); omega
  set v := NLogN.KFB.gflat zs ++ l with hv
  rw [NLogN.KFV.F2_G]
  -- the decrement
  have S0 := NLogN.KFV.stepD_sp s (Function.update (NLogN.KFV.F2 (b * D) (k + 1)) 0 v) (k := k) (B := B)
    (by simp +decide [NLogN.KFV.F2, Function.update_apply]) (by omega)
  have eF : Function.update (Function.update (NLogN.KFV.F2 (b * D) (k + 1)) 0 v) NLogN.KFV.gI [((k : ℕ) : ℤ)] =
      Function.update (NLogN.KFV.F2 (b * D) k) 0 v := by
    funext r
    simp only [NLogN.KFV.F2, Function.update_apply]
    split_ifs <;> simp_all +decide
  rw [eF] at S0
  have R1 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (p := NLogN.KFV.stepD) (by simp [NLogN.KFV.stepD, NLogN.KFD.fok])
    (NLogN.KFD.FSp.of_norep (by simp [NLogN.KFV.stepD, NLogN.KFD.norep]) S0)
  -- the registers
  set F := NLogN.KFV.F2 (b * D) k with hF
  set st := NLogN.KIL.encK s (Function.update F 0 v) with hst
  have hFr : ∀ r : Fin NLogN.HS, r ≠ 0 → r ≠ NLogN.KFV.gI → r ≠ NLogN.KFV.gT → Function.update F 0 v r = [] := by
    intro r h0 h1 h2; simp +decide [hF, NLogN.KFV.F2, Function.update_apply, h0, h1, h2]
  have zB : ∀ x : ℕ, x ≤ B → NLogN.zsz (x : ℤ) ≤ B := fun x hx => NLogN.KFV.zsz_nat_le hx
  have hkn : k ≤ n := by omega
  have vN : NLogN.KFV.EV st B (.reg NLogN.KFV.gNn) (n : ℤ) := NLogN.KFV.rt_ev hQ.n (hFr _ (by decide) (by decide) (by decide))
    (zB _ (by omega))
  have vL : NLogN.KFV.EV st B (.reg NLogN.KFV.gLl) (ℓ : ℤ) :=
    NLogN.KFV.rt_ev hQ.l (hFr _ (by decide) (by decide) (by decide)) (zB _ (by omega))
  have vD : NLogN.KFV.EV st B (.reg NLogN.KFV.gD) ((D : ℕ) : ℤ) :=
    NLogN.KFV.rt_ev hQ.d (hFr _ (by decide) (by decide) (by decide)) (zB _ (by omega))
  have vK : NLogN.KFV.EV st B (.reg NLogN.KFV.gKk) ((K : ℕ) : ℤ) :=
    NLogN.KFV.rt_ev hQ.k (hFr _ (by decide) (by decide) (by decide)) (zB _ (by omega))
  have vQ : NLogN.KFV.EV st B (.reg NLogN.KFV.gQq) ((q : ℕ) : ℤ) :=
    NLogN.KFV.rt_ev hQ.q (hFr _ (by decide) (by decide) (by decide)) (zB _ (by
      have : q ≤ q * K := Nat.le_mul_of_pos_right _ hK; omega))
  have vBb : NLogN.KFV.EV st B (.reg NLogN.KFV.gBb) ((b : ℕ) : ℤ) :=
    NLogN.KFV.rt_ev hQ.b (hFr _ (by decide) (by decide) (by decide)) (zB _ (by omega))
  have vNL : NLogN.KFV.EV st B (.reg NLogN.KFV.gNL) ((nL : ℕ) : ℤ) :=
    NLogN.KFV.rt_ev hQ.nl (hFr _ (by decide) (by decide) (by decide)) (zB _ (by omega))
  have vI : NLogN.KFV.EV st B (.reg NLogN.KFV.gI) ((k : ℕ) : ℤ) :=
    NLogN.KFV.EV.reg (L := s.G NLogN.KFV.gI) (by simp +decide [hst, hF, NLogN.KFV.F2, Function.update_apply, NLogN.ints]) (zB _ (by omega))
  have vA : NLogN.KFV.EV st B NLogN.KFV.eA2 ((c : ℕ) : ℤ) :=
    (vNL.add vI (by rw [← Nat.cast_add]; exact zB _ (by omega))).cast (by rw [hc]; push_cast; rfl)
  have vU : NLogN.KFV.EV st B NLogN.KFV.eU2 ((u : ℕ) : ℤ) := vI.ndiv vD hD (zB _ (by
    have : u ≤ k := Nat.div_le_self _ _; omega))
  have vQK : NLogN.KFV.EV st B NLogN.KFV.eQK ((q * K : ℕ) : ℤ) :=
    (vQ.mul vK (by rw [← Nat.cast_mul]; exact zB _ (by omega))).cast (by push_cast; rfl)
  have vW0 := (NLogN.KFV.EV.lit (st := st) (c := -1) (NLogN.KFV.zsz_le_B (by omega) (by omega))).add vU.neg
    (NLogN.KFV.zsz_le_B (by omega) (by omega))
  have vW : NLogN.KFV.EV st B (.add (.reg NLogN.KFV.gBb) (.add (.lit (-1)) (.neg NLogN.KFV.eU2))) ((w : ℕ) : ℤ) :=
    (vBb.add vW0 (NLogN.KFV.zsz_le_B (by omega) (by omega))).cast (by rw [hw]; omega)
  have vQW : NLogN.KFV.EV st B (.add NLogN.KFV.eQK (.add (.reg NLogN.KFV.gBb) (.add (.lit (-1)) (.neg NLogN.KFV.eU2))))
      ((q * K + w : ℕ) : ℤ) :=
    (vQK.add vW (by rw [← Nat.cast_add]; exact zB _ (by omega))).cast (by push_cast; rfl)
  have vIm : NLogN.KFV.EV st B (.nmod (.reg NLogN.KFV.gI) (.reg NLogN.KFV.gD)) ((i : ℕ) : ℤ) :=
    vI.nmod vD hD (zB _ (by omega))
  have hiq : i * (q * K + w) ≤ n := by rw [hδ'] at hcδ; omega
  have vF : NLogN.KFV.EV st B NLogN.KFV.eF2 ((δ : ℕ) : ℤ) := by
    have := vIm.mul vQW (by rw [← Nat.cast_mul]; exact zB _ (by omega))
    exact (this.add vQK (by rw [← Nat.cast_mul, ← Nat.cast_add]; exact zB _ (by
      rw [hδ'] at hcδ; omega))).cast (by rw [hδ']; push_cast; ring)
  have vC : NLogN.KFV.EV st B (NLogN.KFV.eCm NLogN.KFV.eA2 NLogN.KFV.eF2) ((e : ℤ) + (ℓ : ℤ) + 1) := by
    have h1 := vN.add vA.neg (NLogN.KFV.zsz_le_B (by omega) (by omega))
    have h2 := vF.neg.add vL (NLogN.KFV.zsz_le_B (by omega) (by omega))
    exact (h1.add h2 (NLogN.KFV.zsz_le_B (by omega) (by omega))).cast (by omega)
  -- the move
  have hzs : zs.length = 2 ^ (c + 1 + δ + e) * 2 ^ ℓ := by rw [hx.1, hl, hne]
  have R2 := NLogN.KFV.mvF_run (I := I) (iprog := iprog) (NLogN.KIL.encK s F) zs l (c := c) (δ := δ) (e := e) (ℓ := ℓ)
    (W := W) (B := B) hzs hgb
    (NLogN.KFV.mvSafe_of2 NLogN.KFV.eA2 (by simp [NLogN.KFV.eA2, NLogN.Ex.regs])) (NLogN.KFV.mvSafe_of2 NLogN.KFV.eF2 (by simp [NLogN.KFV.eF2, NLogN.KFV.eU2, NLogN.KFV.eQK, NLogN.Ex.regs]))
    (NLogN.KFV.mvSafe_of2 (NLogN.KFV.eCm NLogN.KFV.eA2 NLogN.KFV.eF2) (by
      simp only [NLogN.KFV.eCm, NLogN.KFV.eA2, NLogN.KFV.eF2, NLogN.KFV.eU2, NLogN.KFV.eQK, NLogN.Ex.regs]; intro r hr; simp at hr ⊢; tauto))
    (by rw [NLogN.KFV.F2_G]; exact vA) (by rw [NLogN.KFV.F2_G]; exact vF) (by rw [NLogN.KFV.F2_G]; exact vC)
    (by omega) (by omega) (by omega)
  rw [hne] at R2
  rw [NLogN.KFV.F2_G, NLogN.KFV.F2_G] at R2
  set zM := NLogN.KFV.zMv n (2 ^ ℓ) (NLogN.KFU.mvIdx c 1 δ) zs with hzM
  set v' := NLogN.KFB.gflat zM ++ l with hv'
  -- records
  have hxs : xs.length = AModel.vol (Synth.binSh n) := by rw [hl]; simp [Synth.binSh, AModel.vol_replicate]
  have hbl : (Synth.binSh n).length = n := by simp [Synth.binSh]
  have hval := NLogN.KFV.valid_mvIdx (c := c) (δ := 1) (g := δ) (n := n) (by omega)
  have hrr := NLogN.KFV.recRep_pull hx (Synth.binSh n) hxs hval
  rw [hbl] at hrr
  have hT : NLogN.KFV.runArrR n 0 [NLogN.KFV.op2 D ℓ K long k] xs = AModel.pull (Synth.binSh n) (Synth.binSh n)
      (AModel.permIdx (NLogN.KFU.mvIdx c 1 δ)) 0 xs := by
    rw [NLogN.KFV.runArrR_cons, NLogN.KFV.runArrR_nil]
    simp only [NLogN.KFV.op2]
    rw [NLogN.KFV.mv_idx]
  beta_reduce
  refine ⟨zM, ?_, NLogN.KFV.gb_pull hgb _ _ _, ?_, ?_, ?_⟩
  · rw [hT]; exact hrr
  · rw [hT]; simp [Synth.binSh, AModel.vol_replicate]
  · rw [hT]; exact NLogN.KFV.disk_pull hd _ _ _
  · have R := R1.seq R2
    rw [← NLogN.KFV.F2_G (b * D) s k v'] at R
    refine R.mono' rfl ?_
    have hE : e + ℓ + 1 = n - (c + δ) + ℓ := by omega
    unfold NLogN.KFV.cBody2R
    rw [← hk_, ← hc, ← hδ, ← hE]
    all_goals omega
end
