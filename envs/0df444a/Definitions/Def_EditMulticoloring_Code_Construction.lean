-- title:
--   The parameterized multicoloring code and full validation decoder
-- statement:
--   Fix $q\ge2,t\ge1$. The public parameters are computed from $n$ as in Eqs. (7)–(13), with $r=r_{2t}(n)$, $K=n\lceil\log_2q\rceil$, $Q=2^{\lceil\log_2(rK+1)\rceil}$, and the specified $B,L,J$. Colors use binary polynomial-basis arithmetic modulo a monic irreducible polynomial of degree $\log_2 Q$. No field operation is treated as an oracle.
--
--   The two color coordinates have widths $h_1=\lceil\log_qL\rceil$ and $h_2=\lceil\log_qp_L\rceil$. Their concatenation has length $h=h_1+h_2$. Define
--
--   $$\rho=\min\{\ell\ge h:q^\ell\ge q^h r_{2t}(\ell)\},\quad m=n-\rho,\quad k=m+\log_qJ.$$
--
--   The short table is the first $q^h$ words selected in lexicographic greedy order at length $\rho$, discarding radius-$2t$ neighbors. The encoder sends a message prefix $x$ and rank $j$ to $xE(\mathrm{ser}(\pi_x(j)))$.
--
--   The decoder first inspects at most $n+t+1$ symbols to reject invalid lengths. It then enumerates positioned scripts, retains length-$n$ candidates, exactly inverts the short table, parses both fixed-width blocks, checks palette membership, goodness, the residue, and rank $j<J$, and returns the first passing message. Failure is an explicit rejection. These are denotational definitions: the goal separately requires finite RAM programs to realize them with the stated costs, including setup. Empty/default branches outside the source domains grant no algorithmic guarantees.
-- source:
--   Huiling Xie, Zitan Chen, Explicit Edit Codes via Multicoloring, STOC 2027 submission #819 (October 2026), Definitions 5, 6 and 8; Construction 3.1 and §3.2, printed pp. 5–12 (PDF pp. 6–13); Appendices C–D, printed pp. 16–21 (PDF pp. 17–22); pinned repository artifact papers/stoc2027-819/source.pdf, SHA256 00172d5da76bf6bc886b8a1f87450befb76480107f54cb367988a065737eb376.

import Definitions.Def_EditMulticoloring_Code_Graph

noncomputable section

namespace EditMulticoloring.Code

/-- A binary polynomial is stored by its coefficient bit mask, low degree first. -/
def binaryPoly (a : ℕ) : Polynomial (ZMod 2) :=
  ∑ i ∈ Finset.range (a.log2 + 1),
    Polynomial.C (((a / 2 ^ i) % 2 : ℕ) : ZMod 2) * Polynomial.X ^ i

def ValidModulus (b p : ℕ) : Prop :=
  1 ≤ b ∧ 2 ^ b ≤ p ∧ p < 2 ^ (b + 1) ∧ Irreducible (binaryPoly p)

/-- Polynomial multiplication over F₂ before reduction. -/
def binaryMul (a b : ℕ) : ℕ :=
  (List.range (b.log2 + 1)).foldl (fun z i =>
    if b.testBit i then Nat.xor z (a * 2 ^ i) else z) 0

/-- Long division in F₂[X], scanning coefficients from high degree to low. -/
def binaryRem (p a : ℕ) : ℕ :=
  (List.range (a.log2 + 1)).reverse.foldl (fun z i =>
    if p ≠ 0 ∧ p.log2 ≤ i ∧ z.testBit i then
      Nat.xor z (p * 2 ^ (i - p.log2)) else z) a

def fieldMul (p a b : ℕ) : ℕ := binaryRem p (binaryMul a b)

def bitEval (Q p K id a : ℕ) : ℕ :=
  (List.range K).reverse.foldl (fun z i =>
    Nat.xor (fieldMul p z a) ((id / Q ^ i) % Q)) 0

/-- The finite simple confusion graph, from the published unit-cost metric.
SimpleGraph.fromRel removes loops and symmetrizes this symmetric metric predicate. -/
def confusionGraph (q t m : ℕ) : SimpleGraph (FixedWord q m) :=
  SimpleGraph.fromRel (fun x y => distance (toWord x) (toWord y) ≤ 2 * t)

/-- The confusion neighborhood is generated by actual edit scripts, with duplicates removed. -/
def confusionNeighbors {q : ℕ} (t : ℕ) (x : Word q) : List (Word q) :=
  (((scripts (2 * t) x).map Prod.snd).filter
    (fun y => y.length = x.length ∧ y ≠ x)).mergeSort (fun a b => value a ≤ value b) |>.eraseDups

structure Parameters where
  r : ℕ
  K : ℕ
  Q : ℕ
  B : ℕ
  L : ℕ
  J : ℕ
  h₁ : ℕ
  h₂ : ℕ
  h : ℕ
  ρ : ℕ
  m : ℕ
  k : ℕ

/-- Natural minimum: the theorem proves nonemptiness and membership, so no empty default is used. -/
def shortLength (q t h : ℕ) : ℕ :=
  sInf {l : ℕ | h ≤ l ∧ q ^ h * radiusBound q (2 * t) l ≤ q ^ l}

def parameters (q t n : ℕ) : Parameters :=
  let r := radiusBound q (2 * t) n
  let K := n * ceilLog 2 q
  let b := ceilLog 2 (r * K + 1)
  let Q := 2 ^ b
  let B := 2 * b
  let L := paletteLength r B
  let J := foldCount q L
  let h₁ := ceilLog q L
  let h₂ := ceilLog q (primeAt (L - 1))
  let h := h₁ + h₂
  let ρ := shortLength q t h
  let m := n - ρ
  ⟨r, K, Q, B, L, J, h₁, h₂, h, ρ, m, m + floorLog q J⟩

/-- The polynomial-basis label used in Appendix D.1; p is not an input oracle to a program. -/
def localColor {q : ℕ} (t : ℕ) (P : Parameters) (p : ℕ) (x : Word q) : ℕ :=
  let N := confusionNeighbors t x
  let α := ((List.range P.Q).find? fun a => N.all fun y =>
    bitEval P.Q p P.K (value x) a ≠ bitEval P.Q p P.K (value y) a).getD 0
  P.Q * α + bitEval P.Q p P.K (value x) α

def localGood {q : ℕ} (t : ℕ) (P : Parameters) (p : ℕ) (x : Word q) (i : ℕ) : Bool :=
  (confusionNeighbors t x).all fun y =>
    localColor t P p x % primeAt i ≠ localColor t P p y % primeAt i

def localGoodIndices {q : ℕ} (t : ℕ) (P : Parameters) (p : ℕ) (x : Word q) : List ℕ :=
  (List.range P.L).filter (localGood t P p x)

def localPair {q : ℕ} (t : ℕ) (P : Parameters) (p : ℕ) (x : Word q) (j : ℕ) : ℕ × ℕ :=
  let i := ((localGoodIndices t P p x)[j]?).getD P.L
  (i, localColor t P p x % primeAt i)

/-- Lexicographic greedy selection; ball deletion is implemented by the equivalent selected-word test.
The efficient implementation in the goal must use marking and may stop after the required prefix. -/
def greedy {q : ℕ} (t : ℕ) (xs : List (Word q)) : List (Word q) :=
  xs.foldl (fun chosen x =>
    if chosen.any (fun z => x ∈ ball (2 * t) z) then chosen else chosen ++ [x]) []

def shortTable (q t h : ℕ) : List (Word q) :=
  (greedy t (words q (shortLength q t h))).take (q ^ h)

def shortEncode {q : ℕ} (t h : ℕ) (s : Word q) : Word q :=
  ((shortTable q t h)[value s]?).getD []

def shortInverse {q : ℕ} (t h : ℕ) (z : Word q) : Option (Word q) :=
  let T := shortTable q t h
  if z ∈ T then some (repr q h (T.idxOf z)) else none

def serialize (q : ℕ) (P : Parameters) (c : ℕ × ℕ) : Word q :=
  repr q P.h₁ c.1 ++ repr q P.h₂ c.2

def encode {q : ℕ} (t n p : ℕ) (u : Word q) : Word q :=
  let P := parameters q t n
  let x := u.take P.m
  let j := value (u.drop P.m)
  x ++ shortEncode t P.h (serialize q P (localPair t P p x j))

def code (q t n p : ℕ) : Finset (Word q) :=
  ((words q (parameters q t n).k).map (encode t n p)).toFinset

def validate {q : ℕ} (t n p : ℕ) (c : Word q) : Option (Word q) := do
  let P := parameters q t n
  if c.length ≠ n then none else do
    let x := c.take P.m
    let z := c.drop P.m
    let s ← shortInverse t P.h z
    let i := value (s.take P.h₁)
    let η := value (s.drop P.h₁)
    if i ≥ P.L ∨ η ≥ primeAt i then none else do
      if !(localGood t P p x i) ∨ η ≠ localColor t P p x % primeAt i then none else do
        let j := ((List.range i).filter (localGood t P p x)).length
        if j ≥ P.J then none else some (x ++ repr q (P.k - P.m) j)

/-- Bounded initial inspection, followed by all positioned scripts in the fixed list order.
Only the first n+t+1 input symbols need inspection before rejecting an overlong input. -/
def decode {q : ℕ} (t n p : ℕ) (y : Word q) : Option (Word q) :=
  let z := y.take (n + t + 1)
  if z.length > n + t ∨ z.length + t < n then none else
    ((scripts t z).map Prod.snd).findSome? (validate t n p)

end EditMulticoloring.Code


