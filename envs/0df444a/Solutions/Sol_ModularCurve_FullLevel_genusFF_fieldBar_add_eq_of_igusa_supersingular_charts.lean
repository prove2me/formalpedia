    :
    ∃ R : RegularProlongation A (fieldBar q M') (xHFunctionFieldC (ResidueField A) (q ^ 2 * M') (levelH q M')), R.integers = OIg (lineInfty q) := by
  obtain ⟨OIg', R, hR, hinf', -, -, -, -⟩ := exists_igusaValuationSubrings q hq M' hqM' A hA ζ
  refine ⟨R, ?_⟩
