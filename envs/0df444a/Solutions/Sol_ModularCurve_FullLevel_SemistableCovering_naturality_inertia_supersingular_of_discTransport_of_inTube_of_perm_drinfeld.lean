variable {L : Type*} [Field L] (A : ValuationSubring L)

def baseRestrict (σ : L ≃+* L) (hA : ∀ x, σ x ∈ A ↔ x ∈ A) : A ≃+* A where
  toFun a := ⟨σ a, (hA a).mpr a.2⟩
  invFun b := ⟨σ.symm b, (hA _).mp (by rw [RingEquiv.apply_symm_apply]; exact b.2)⟩
  left_inv a := Subtype.ext (σ.symm_apply_apply a)
  right_inv b := Subtype.ext (σ.apply_symm_apply b)
  map_mul' a b := Subtype.ext (map_mul σ _ _)
  map_add' a b := Subtype.ext (map_add σ _ _)

@[scoped simp] theorem coe_baseRestrict (σ : L ≃+* L) (hA : ∀ x, σ x ∈ A ↔ x ∈ A) (a : A) :
    (baseRestrict A σ hA a : L) = σ a := rfl

theorem valuation_map_lt_one (σ : L ≃+* L) (hA : ∀ x, σ x ∈ A ↔ x ∈ A) {c : L} (h : A.valuation c < 1) :
    A.valuation (σ c) < 1 := by
  have hcA : c ∈ A := (A.valuation_le_one_iff c).mp h.le
  have hm : (⟨c, hcA⟩ : A) ∈ IsLocalRing.maximalIdeal A := (A.valuation_lt_one_iff ⟨c, hcA⟩).mpr h
  have hm' : baseRestrict A σ hA ⟨c, hcA⟩ ∈ IsLocalRing.maximalIdeal A := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hm ⊢
    exact fun hu => hm ((MulEquiv.isUnit_map (baseRestrict A σ hA).toMulEquiv).mp hu)
  exact (A.valuation_lt_one_iff _).mp hm'

theorem valuation_map_lt_one_iff (σ : L ≃+* L) (hA : ∀ x, σ x ∈ A ↔ x ∈ A) (c : L) :
    A.valuation (σ c) < 1 ↔ A.valuation c < 1 := by
  refine ⟨fun h => ?_, valuation_map_lt_one A σ hA⟩
  have hA' : ∀ x, σ.symm x ∈ A ↔ x ∈ A := fun x => by rw [← hA (σ.symm x), RingEquiv.apply_symm_apply]
  have := valuation_map_lt_one A σ.symm hA' h
  rwa [RingEquiv.symm_apply_apply] at this

theorem valuation_map_eq_of_eq (σ : L ≃+* L) (hA : ∀ x, σ x ∈ A ↔ x ∈ A) {x c : L}
    (h : A.valuation x = A.valuation c) : A.valuation (σ x) = A.valuation (σ c) := by
  obtain ⟨a, ha⟩ := (A.valuation_eq_iff x c).mp h
  refine (A.valuation_eq_iff _ _).mpr ⟨Units.map (baseRestrict A σ hA).toMonoidHom a, ?_⟩
  rw [← ha, map_mul]
  rfl

