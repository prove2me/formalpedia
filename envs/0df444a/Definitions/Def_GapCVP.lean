def delimitedCompare_missingFirstTrace (count : ℕ) :
    EvalsToInTime delimitedPairComparisonMachine.step (delimitedCompareConfiguration 0 .invalid
        (List.replicate count true) [] [] [] [] [] [] [] [] [])
