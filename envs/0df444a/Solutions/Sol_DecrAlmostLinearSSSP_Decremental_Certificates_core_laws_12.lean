    RootRep t (rootStarted s) ∧ (rootStarted s).natReg 408 = 1 := by
  have hfields := rootPrefix_fields s
  have hn : (rootStarted s).natReg 408 = 1 := by
    rw [rootStarted,powered_nat]
    exact hfields.1
  have hu : (rootStarted s).natReg 26 = 1 := by
    rw [rootStarted,powered_nat]
    exact hfields.2.1.trans hunit
  have hp : (rootStarted s).realReg 418 = ((rootStarted s).natReg 408 : ℝ)^12 := by
    simpa only [rootStarted,powered_nat] using powered_result (rootPrefixData s)
  have hl : (rootStarted s).realReg 420 = ((t+1 : ℕ) : ℝ) := by
    have hh := (rootPower_eval (rootPrefixData s)).real_frame (rootPower_real_frame 420 (by decide))
    change (rootStarted s).realReg 420 = (rootPrefixData s).realReg 420 at hh
    rw [hh,hfields.2.2,hheight,hunit]
  exact ⟨⟨by rw [hn];omega,by rw [hn],hp,hl,hu⟩,hn⟩
