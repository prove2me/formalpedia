theorem faceCl_val (hr : 1 ≤ r) {n : ℕ} (i : Fin (m + 2)) (w : CrClosed r (m + 1) n)
    {ω : Ω (m + 1)} (hD : IsDeg n ω) (hC : IsCr r ω) (hK : IsClosedForm ω) (h : jet r ω = w) :
    (faceCl r m n i w : Jet r m × Jet r m) = jet r (pull m i ω) :=
