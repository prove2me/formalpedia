-- title:
--   Cross identity w(β W)e_α(W)=w(α W)e_β(W) on the degeneracy roof
-- statement:
--   Let $M$, $s$, $q'$ be natural numbers with $M\neq 0$ and $s\neq 0$, with $s$ and $q'$ prime, $s\neq q'$, $q'\nmid M$ and $s\nmid M$, and let $k$ be an algebraically closed field of characteristic $q'$. Write $F_M=$ `modularFunctionFieldC k M` and let the roof `charLDegeneracyRoof k M s` be the intermediate field of $k((q))$ over $k$ generated by $j(q)$ and the three functions `jqNModC k M`, `jqNModC k s`, `jqNModC k (M * s)`. Two $k$-algebra maps $F_M\to$ roof are in play: $\alpha=$ `heckeAlphaC k M s`, the inclusion, and $\beta=$ `heckeBetaC k M s`, induced by the substitution `qExpand k s` on Laurent series; both are assumed integral as ring homomorphisms (hypotheses `HeckeAlphaCIntegral` and `HeckeBetaCIntegral`). Let $W$ be a place of the roof over $k$, i.e. a valuation subring of the roof containing the image of $k$, different from the whole field and a principal ideal ring. For $\varphi\in\{\alpha,\beta\}$, $W.\text{restrictAlong}\,\varphi$ is the place of $F_M$ whose valuation subring is the preimage of $W$ under $\varphi$, and $W.\text{ramificationIndexAlong}\,\varphi$ is the least positive integer of the form $\mathrm{ord}_W(\varphi f)$ with $f\in F_M$ nonzero. Finally `placeWidthChar q' M w` is the natural-number quotient of `jWidthChar q'` evaluated at the value $w$ takes on the generator `jGeomGen k M` by `placeRamificationJ M w`. The conclusion is the equality in $\mathbb{Z}$
--   $$\text{placeWidthChar}_{q'}(\beta W)\cdot e_\alpha(W)=\text{placeWidthChar}_{q'}(\alpha W)\cdot e_\beta(W),$$
--   the four natural numbers being cast to $\mathbb{Z}$.
--
--   This is the function-field form of Eichler's weighted symmetry relation $w_j B_{ij}(n)=w_i B_{ji}(n)$ for the two degeneracy maps of level $M$ into the roof of level $Ms$, with the characteristic-$q'$ width of a place playing the role of the weight $w_i$. It is used in the analysis of specialisations of places along the degeneracy maps and in deducing the symmetry, hence commutativity statements, for the corresponding Hecke correspondence at level $M$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_placeWidthChar_restrictAlong_mul_ramificationIndexAlong_heckeAlphaC_heckeBetaC_cross_of_prime.lean

import Definitions.Def_ModularCurve_CharLDegeneracyHecke
import Definitions.Def_ModularCurve_PlaceWidthChar

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
open AlgebraicCurve ModularCurve

theorem
ModularCurve.placeWidthChar_restrictAlong_mul_ramificationIndexAlong_heckeAlphaC_heckeBetaC_cross_of_prime
    (M s q' : ℕ) [NeZero M] [NeZero s] (hs : s.Prime) [Fact q'.Prime]
    (hsq' : s ≠ q') (hq'M : ¬ q' ∣ M) (hsM : ¬ s ∣ M)
    {k : Type*} [Field k] [CharP k q'] [IsAlgClosed k] [DecidableEq k]
    (hα : HeckeAlphaCIntegral k M s) (hβ : HeckeBetaCIntegral k M s)
    (W : Place k ↥(charLDegeneracyRoof k M s)) :
    (placeWidthChar q' M (W.restrictAlong (heckeBetaC k M s) hβ) : ℤ)
        * (W.ramificationIndexAlong (heckeAlphaC k M s) : ℤ)
      = (placeWidthChar q' M (W.restrictAlong (heckeAlphaC k M s) hα) : ℤ)
        * (W.ramificationIndexAlong (heckeBetaC k M s) : ℤ) := by sorry
