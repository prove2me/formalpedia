/-!
# B3 (chunk kernel), part 9: the chunk kernel as a `RowBody6` procedure

`chunk_rowBody6`: if procedure `e` of the table is `chunkI pM`, then it is a `RowBody6` row kernel
for `g q = chunkG2 … (ds q)` with the tables `tabK … (ds q)`, rows of length `λ` with entries
bounded by `X`, under the size conditions on the parameters.  `chunkK_rowBody6` specialises it
to the line's chunk kernel `liftG (chunkK P R s t λ α q)` with the tables `chunkTab6`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

/-- Growth for all blocks. -/
theorem chunkOK_of (P : ℕ) {Kt X : ℤ} {lam pk : ℕ} {di gi gam dd : List ℤ}
    (hKt : 0 ≤ Kt) (hX : 0 ≤ X)
    (tdi : TB (2 ^ P * Kt) di) (tgi : TB (2 ^ P * Kt) gi) (tga : TB (2 ^ P * Kt) gam)
    (tdd : TB (2 ^ P * Kt) dd) (hdi : lam ≤ di.length) (hgi : lam ≤ gi.length)
    (hga : lam ≤ gam.length) (hdd : lam ≤ dd.length)
    (hpk : Xs ((lam + 1) * Kt + 1) X 7 ≤ 2 ^ pk) :
    ∀ (ds : List (ℕ × List ℤ × List ℤ)) (x : List GI),
      (∀ d ∈ ds, d.1 ≤ lam ∧ d.1 ≤ d.2.1.length ∧ d.1 ≤ d.2.2.length ∧ TB (2 ^ P * Kt) d.2.1 ∧
        TB (2 ^ P * Kt) d.2.2) →
      sumN ds ≤ x.length → AB X x → chunkOK P (2 ^ pk) di gi gam dd ds x
  | [], x, _, _, _ => trivial
  | (n, am, ap) :: ds, x, hds, hs, hx => by
    obtain ⟨h1, h2, h3, h4, h5⟩ := hds (n, am, ap) (List.mem_cons_self ..)
    simp only at h1 h2 h3 h4 h5
    simp only [sumN] at hs
    refine ⟨blkOK_of P hKt hX (fun w hw => hx w (List.mem_of_mem_take hw)) (by simp; omega) h1
      tdi tgi tga tdd h4 h5 (by omega) (by omega) (by omega) (by omega) h2 h3 hpk, ?_⟩
    exact chunkOK_of P hKt hX tdi tgi tga tdd hdi hgi hga hdd hpk ds (x.drop n)
      (fun d hd => hds d (List.mem_cons_of_mem _ hd)) (by simp; omega)
      (fun w hw => hx w (List.mem_of_mem_drop hw))

end J6Seg.KR

