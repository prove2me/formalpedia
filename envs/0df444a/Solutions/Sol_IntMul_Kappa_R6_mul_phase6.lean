section
-- Source module: Solutions.KFMHT
/-!
# KFM: parameter registers and the pass wrappers of `bigE`

`bigE` keeps its run-time parameters on its own stacks `6–19`, one value on top of each (the
*registers* below). A uniform pass reads its counts and constants from the fixed stacks
`nX, nX2, pR, pX2, pX3`. The wrapper `withD src dst p` copies the top of `src` onto `dst`, runs
`p` and drops the copy again. So every wrapped pass changes only stack `0`.

* **`withD_runs`**: the frame rule of the wrapper.
* `Hold t r a`: the top of stack `r` is the integer `a`.
* The wrapped passes **`shlW_runs`**, **`roundW_runs`**, **`smulW_runs`**, **`gmulW_runs`**,
  **`conjW_runs`**. Each runs from any state whose registers hold the right values, and its final
  state differs from the initial one only on stack `0` (`gmulW` also pops `pW`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFM

open IntMul KIL KFT KFB

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## Registers of `bigE` -/

theorem Hold.upd {t : IState HS} {r : Fin HS} {a : ℤ} (h : Hold t r a) (j : Fin HS) (hj : j ≠ r)
    (L : List Item) : Hold (t.upd j L) r a := by
  obtain ⟨L', h'⟩ := h
  exact ⟨L', by simp [IState.upd_G, Ne.symm hj, h']⟩

/-! ## The wrapper -/

theorem withD_runs {src dst : Fin HS} (hsd : src ≠ dst) (hd0 : dst ≠ 0) {p : IStmt HS P}
    {t : IState HS} {a : ℤ} (hs : Hold t src a) {X : List Item} {c : ℕ}
    (hp : IRuns I iprog p (t.upd dst (.int a :: t.G dst))
      ((t.upd dst (.int a :: t.G dst)).upd 0 X) c) :
    IRuns I iprog (withD src dst p) t (t.upd 0 X) (c + cW a) := by
  obtain ⟨L, hL⟩ := hs
  have r1 := IRuns.dup (I := I) (iprog := iprog) hsd hL
  have r3 := IRuns.drop (I := I) (iprog := iprog)
    (s := (t.upd dst (.int a :: t.G dst)).upd 0 X) (i := dst) (a := a) (L := t.G dst)
    (by simp [IState.upd_G, hd0])
  refine (r1.seq (hp.seq r3)).mono' ?_ (by unfold cW; omega)
  refine IState.ext' (fun j => ?_) (by simp) (by simp)
  simp only [IState.upd_G]
  split_ifs <;> simp_all

/-- The same with the output also popping a second stack `W` (for `gmulPU`). -/
theorem withD_runs2 {src dst W : Fin HS} (hsd : src ≠ dst) (hd0 : dst ≠ 0) (hdW : dst ≠ W)
    {p : IStmt HS P} {t : IState HS} {a : ℤ} (hs : Hold t src a) {X RW : List Item} {c : ℕ}
    (hp : IRuns I iprog p (t.upd dst (.int a :: t.G dst))
      (((t.upd dst (.int a :: t.G dst)).upd 0 X).upd W RW) c) :
    IRuns I iprog (withD src dst p) t ((t.upd 0 X).upd W RW) (c + cW a) := by
  obtain ⟨L, hL⟩ := hs
  have r1 := IRuns.dup (I := I) (iprog := iprog) hsd hL
  have r3 := IRuns.drop (I := I) (iprog := iprog)
    (s := ((t.upd dst (.int a :: t.G dst)).upd 0 X).upd W RW) (i := dst) (a := a) (L := t.G dst)
    (by simp [IState.upd_G, hd0, hdW])
  refine (r1.seq (hp.seq r3)).mono' ?_ (by unfold cW; omega)
  refine IState.ext' (fun j => ?_) (by simp) (by simp)
  simp only [IState.upd_G]
  split_ifs <;> simp_all

/-! ## Wrapped passes -/

theorem conjW_runs (B : ℕ) (t : IState HS) (zs : List GI) (R0 : List Item)
    (h0 : t.G 0 = ints (gflat zs) ++ R0) (hB : GB B zs) (hT : Hold t rT (zs.length : ℤ))
    (hT2 : Hold t rT2 ((2 * zs.length : ℕ) : ℤ)) :
    IRuns I iprog conjW t (t.upd 0 (ints (gflat (zs.map gconj)) ++ R0))
      (cConj zs.length B + cW ((2 * zs.length : ℕ) : ℤ) + cW (zs.length : ℤ)) := by
  refine withD_runs (by decide) (by decide) hT ?_
  refine withD_runs (by decide) (by decide) (hT2.upd nX (by decide) _) ?_
  exact conjPU_runs (I := I) (iprog := iprog) B _ zs R0 (by simp +decide [IState.upd_G, h0]) hB
    (t.G nX) (t.G nX2) (by simp +decide [IState.upd_G]) (by simp +decide [IState.upd_G])

end NLogN.KFM

end

