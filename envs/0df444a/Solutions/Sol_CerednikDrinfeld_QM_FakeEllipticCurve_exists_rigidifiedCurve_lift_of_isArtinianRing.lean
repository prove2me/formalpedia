        x₀.2.φ ≫ v ≫ uA'' ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ := by
      rw [reassoc_of% (hactv ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩), hactuA'' ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩]
