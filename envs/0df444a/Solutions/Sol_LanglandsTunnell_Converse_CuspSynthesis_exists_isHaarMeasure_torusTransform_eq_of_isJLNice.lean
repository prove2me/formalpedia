variable {K : Type} [Field K] [NumberField K]
variable {S : Finset (HeightOneSpectrum (𝓞 K))} {Pi : HeckeEigensystem K ℂ}
variable {epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ} {ω : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
variable (archR : ∀ w : InfinitePlace K, w.IsReal → RealArchParam)
  (archC : ∀ w : InfinitePlace K, w.IsComplex → ComplexArchParam)
  (dR : ∀ (w : InfinitePlace K) (hw : w.IsReal), ArchDatumR (archR w hw))
  (dC : ∀ (w : InfinitePlace K) (hw : w.IsComplex), ArchDatumC (archC w hw))

private theorem t0602 (x : AdelicGL2 (𝓞 K) K) (y : (AdeleRing (𝓞 K) K)ˣ)
    (g : AdelicGL2 (𝓞 K) K) :
    archW' archR archC dR dC (x * (globalPoints (𝓞 K) K (weylGL2 K) * (diagOne y * g)))
      = d009 archR archC ((y : AdeleRing (𝓞 K) K).1) *
        archW' archR archC dR dC (x * (diagOne y⁻¹ * (globalPoints (𝓞 K) K (weylGL2 K) * g))) := by
  have hz : ∀ w : InfinitePlace K, ((y : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w ≠ 0 := by
    intro w h0
    have h := t0022 y w
    rw [h0, zero_mul] at h
    exact zero_ne_one h
  rw [← mul_assoc (globalPoints (𝓞 K) K (weylGL2 K)) (diagOne y) g, t0471,
    mul_assoc (centralScalar (𝓞 K) K y), ← mul_assoc x, t0067, mul_assoc, mul_assoc (diagOne y⁻¹)]
  exact t0126 archR archC dR dC _ hz
    (fun w hw => t0078 w hw y _)
    (fun w hw => t0079 w hw y _)

private theorem t0603 (hω : IsAdmissibleTwist K ω)
    (hωunr : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S → IsUnramifiedCharAt ω v)
    (hωb : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S →
