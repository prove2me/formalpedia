open NLogN
open NLogN.KFU
open IntMul KFC AModel AModelL12
theorem solution {r : ℕ} {l : List ℕ} (hr : r ≤ l.length) :
    NLogN.KFU.rv r (r / 2) l = (l.take r).reverse ++ l.drop r := by
  apply List.ext_getElem (by simp; omega)
  intro i h1 h2
  simp only [NLogN.KFU.rv, AModel.getElem_permIdx]
  by_cases hi : i < r
  · rw [List.getElem_append_left (by simp; omega), List.getElem_reverse, List.getElem_take]
    unfold NLogN.KFU.rIdx
    rw [List.getD_eq_getElem _ _ (by split_ifs <;> omega)]
    congr 1; simp; split_ifs <;> omega
  · rw [List.getElem_append_right (by simp; omega), List.getElem_drop]
    unfold NLogN.KFU.rIdx
    rw [if_neg (by omega), List.getD_eq_getElem _ _ (by simp at h1; omega)]
    congr 1; simp; omega
end
