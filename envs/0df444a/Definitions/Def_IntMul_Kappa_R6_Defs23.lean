-- Source module: Solutions.R6IL3Top9
/-!
# Round six, item language (I3): the chain of the uniform Proposition 14

From the descriptor registers (`DescR`), `mainCH jZ` runs

* the size loop (`zloopC`, `j = size (32 W' P S r)`), then pushes `Zl = j + K D` on `vG`;
* the field-width loop (`gloopC`, `G = clog₂ (4 (Zl + cz)(Zl + cz + 2))`), then pushes `G` on `vG`;
* the depth loop (`dloopC`, `d = dep m D`, `W^d`);
* the core stage (`coreCH`) and the layer body (`bodyCH`).

**`chainQH`**: the run leaves `gflat zs* ++ l` on stack `0`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul AModel NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

def zIn : List (Fin HS × NE) := [(11, .lit 0), (12, .lit 1)]
def zlNE : NE := .add (.reg 11) (.mul (.reg 1) (.reg 22))
def dIn3 : List (Fin HS × NE) := [(11, .reg 22), (12, .lit 0), (13, .lit 1)]

/-- The entry of the chain. -/
def mainCH {Pp : ℕ} (jZ : Fin Pp) : IStmt HS Pp := withPushI (fr zIn) (.call jZ)

/-- After the size loop. -/
def zcontC {Pp : ℕ} (jG : Fin Pp) : IStmt HS Pp :=
  withPushI (fr [(vG, zlNE)]) (withPushI (fr zIn) (.call jG))

/-- After the field-width loop. -/
def gcontC {Pp : ℕ} (jD : Fin Pp) : IStmt HS Pp :=
  withPushI (fr [(vG, .reg 11)]) (withPushI (fr dIn3) (.call jD))

/-- The field-width constant. -/
abbrev czH : ℕ := 1

/-- The values of the chain. -/
structure ChV where
  za : ℕ
  Zl : ℕ
  G : ℕ
  d : ℕ
  q0 : ℕ
  Bp : ℕ
  H : ℕ
  qB : ℕ

/-- The values of the chain for a configuration and a descriptor. -/
def chV (c : Cfg) (cW P K D S r w : ℕ) : ChV :=
  let za := Nat.size (aV c P S r w D)
  let Zl := za + K * D
  let G := Gv czH Zl
  let d := dep c.m D
  let q0 := q0v c.m cW K D d G
  { za := za, Zl := Zl, G := G, d := d, q0 := q0, Bp := BpV c.W c.m K P D d G q0,
    H := w + EwH c D, qB := qBv c.m K D G q0 }

/-- The register bound of the chain. -/
def MbChain (c : Cfg) (cW P K D S r w : ℕ) : ℕ :=
  let v := chV c cW P K D S r w
  2 * aV c P S r w D + 2 * gBnd czH v.Zl + v.Zl + v.G + c.W ^ (v.d + 1) + c.m * D + 2 * c.m + D +
    (w + EwH c D + c.Aw * (D + 1) ^ c.p + (D + 1) ^ c.p + (cW + 4) * (K * D + K)) +
    MbBody c K P D S v.G v.q0 v.qB + 200

/-- The cost of the chain. -/
noncomputable def cChainH (c : Cfg) (CB : ℕ → ℝ) (cW P K D S r w Z Zr Bz : ℕ) : ℕ :=
  let v := chV c cW P K D S r w
  let cB := cBodyH c CB K S r v.H P D v.q0 v.qB v.Bp Z Zr Bz w
  let cC := cCoreH cB Z Bz (szC c)
  let cDl := cC + (v.d + 1) * cLoop 3 Bz
  let cGc := cFr1 12 Bz (cFrame 3 12 Bz + cDl + (3 * (2 * Bz + 2) + 1))
  let cGl := cGc + (v.G + 1) * cLoopS 15 2 Bz
  let cZc := cFr1 12 Bz (cFrame 2 12 Bz + cGl + (2 * (2 * Bz + 2) + 1))
  let cZl := cZc + (v.za + 1) * cLoopS (szZ c) 2 Bz
  cFrame 2 12 Bz + cZl + (2 * (2 * Bz + 2) + 1)

end IntMul.Kappa.R6.IL3H

end

