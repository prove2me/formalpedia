open OAI OAI.ReflexiveFixedPoints OAI.ReflexiveFixedPoints.OrderedTree
variable (T : OrderedTree) {i j : ℕ}

theorem OAI.ReflexiveFixedPoints.OrderedTree.descendantHi_le_descendantLo_of_lt (h : i ≤ j)
    (v w : T.Node i) (hvw : v < w) :
    T.descendantHi h v ≤ T.descendantLo h w := by sorry
