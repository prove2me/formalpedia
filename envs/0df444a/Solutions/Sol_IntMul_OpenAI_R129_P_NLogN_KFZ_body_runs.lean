theorem truncNum_sq_le (p : ℕ) (x : ℝ) :
    ((Butterfly.truncNum p x : ℝ)) ^ 2 ≤ x ^ 2 * 4 ^ p := by
  have h := (Butterfly.truncR_abs_le p x).1
  have h2 : (0 : ℝ) < 2 ^ p := by positivity
  unfold Butterfly.truncR at h
  rw [abs_div, abs_of_pos h2, div_le_iff₀ h2] at h
  have : |(Butterfly.truncNum p x : ℝ)| ^ 2 ≤ (|x| * 2 ^ p) ^ 2 :=
    pow_le_pow_left₀ (abs_nonneg _) h 2
  rw [sq_abs, mul_pow, sq_abs, ← pow_mul, show (4 : ℝ) ^ p = 2 ^ (p * 2) by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num, ← pow_mul, Nat.mul_comm]] at *
  exact this

/-- **Sharp rounding of a near-unit value.** -/
theorem Qp_unit (p : ℕ) {v X : ℂ} (hX : ‖X‖ ≤ 1) (he : ‖v - X‖ ≤ (2 : ℝ)⁻¹ ^ (2 * p + 2)) :
    ‖Butterfly.Qp p v - X‖ ≤ 2 * hp p ∧ ‖Butterfly.Qp p v‖ ≤ 1 := by
  have hq : (0 : ℝ) < (2 : ℝ)⁻¹ ^ p := by positivity
  have e4 : (2 : ℝ)⁻¹ ^ (2 * p + 2) = (2 : ℝ)⁻¹ ^ p * ((2 : ℝ)⁻¹ ^ p * (1 / 4)) := by
    rw [show 2 * p + 2 = p + p + 2 by ring, pow_add, pow_add]; norm_num; ring
  have hp1 : (2 : ℝ)⁻¹ ^ p ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
  have he2 : (2 : ℝ)⁻¹ ^ (2 * p + 2) ≤ (2 : ℝ)⁻¹ ^ p / 4 := by
    rw [e4]; nlinarith
  constructor
  · have h1 := (Butterfly.norm_Qp_sub_lt p v).le
    calc ‖Butterfly.Qp p v - X‖ = ‖(Butterfly.Qp p v - v) + (v - X)‖ := by ring_nf
      _ ≤ ‖Butterfly.Qp p v - v‖ + ‖v - X‖ := norm_add_le _ _
      _ ≤ Real.sqrt 2 * (2 : ℝ)⁻¹ ^ p + (2 : ℝ)⁻¹ ^ p / 4 := add_le_add h1 (he.trans he2)
      _ ≤ 2 * hp p := by
          have h32 : Real.sqrt 2 ≤ 3 / 2 := Real.sqrt_le_iff.mpr ⟨by norm_num, by norm_num⟩
          unfold hp; nlinarith
  · -- the modulus
    set e := (2 : ℝ)⁻¹ ^ (2 * p + 2)
    have hv : ‖v‖ ≤ 1 + e := by
      have := norm_le_norm_add_norm_sub' v X
      linarith [norm_sub_rev v X]
    have h4 : (4 : ℝ) ^ p * (2 : ℝ)⁻¹ ^ (2 * p) = 1 := by
      rw [pow_mul, show ((2 : ℝ)⁻¹ ^ 2) = (4 : ℝ)⁻¹ by norm_num, ← mul_pow]; norm_num
    have he4 : 4 * e * 4 ^ p = 1 := by
      have : e = (2 : ℝ)⁻¹ ^ (2 * p) * (1 / 4) := by
        simp only [e]; rw [pow_add]; norm_num
      rw [this]; nlinarith
    have he0 : 0 ≤ e := by positivity
    have he1 : e ≤ 1 / 4 := by
      have : (4 : ℝ) ^ p ≥ 1 := one_le_pow₀ (by norm_num)
      nlinarith
    -- integers
    have ha := truncNum_sq_le p v.re
    have hb := truncNum_sq_le p v.im
    have h4p : (0 : ℝ) < 4 ^ p := by positivity
    set a := Butterfly.truncNum p v.re
    set b := Butterfly.truncNum p v.im
    have hn : v.re ^ 2 + v.im ^ 2 = ‖v‖ ^ 2 := by
      rw [← Complex.normSq_add_mul_I, Complex.normSq_eq_norm_sq]; simp
    have hsq : ‖v‖ ^ 2 ≤ (1 + e) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hv 2
    have hab : ((a : ℝ) ^ 2 + (b : ℝ) ^ 2) < 4 ^ p + 1 := by
      have h1 : ((a : ℝ) ^ 2 + (b : ℝ) ^ 2) ≤ (1 + e) ^ 2 * 4 ^ p := by
        have := mul_le_mul_of_nonneg_right hsq h4p.le
        nlinarith
      have hE : e * 4 ^ p = 1 / 4 := by linarith
      have h2 : (1 + e) ^ 2 * 4 ^ p = 4 ^ p + 2 * (e * 4 ^ p) + e * (e * 4 ^ p) := by ring
      rw [h2, hE] at h1
      linarith
    have habZ : a ^ 2 + b ^ 2 ≤ 4 ^ p := by
      have : ((a ^ 2 + b ^ 2 : ℤ) : ℝ) < ((4 ^ p + 1 : ℤ) : ℝ) := by push_cast; exact hab
      exact Int.lt_add_one_iff.mp (Int.cast_lt.1 this)
    have habR : ((a : ℝ) ^ 2 + (b : ℝ) ^ 2) ≤ 4 ^ p := by exact_mod_cast habZ
    have hQ : ‖Butterfly.Qp p v‖ ^ 2 = ((a : ℝ) ^ 2 + (b : ℝ) ^ 2) / 4 ^ p := by
      rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]
      simp only [Butterfly.Qp, Butterfly.truncR]
      rw [show (4 : ℝ) ^ p = 2 ^ p * 2 ^ p by rw [← mul_pow]; norm_num]
      field_simp
      try rfl
    have : ‖Butterfly.Qp p v‖ ^ 2 ≤ 1 := by rw [hQ, div_le_one h4p]; exact habR
    nlinarith [norm_nonneg (Butterfly.Qp p v)]

section Arr

variable {ι : Type*} [Fintype ι]

/-- **Rounded tables are phase tables.** -/
theorem phases_QA (p : ℕ) {θ v : ι → ℂ} (hθ : ∀ i, ‖θ i‖ ≤ 1)
    (hv : ∀ i, ‖v i - θ i‖ ≤ (2 : ℝ)⁻¹ ^ (2 * p + 2)) : Phases p θ (QA p v) :=
  ⟨hθ, fun i => (Qp_unit p (hθ i) (hv i)).1, fun i => (Qp_unit p (hθ i) (hv i)).2⟩

/-- Conjugate phase tables. -/
theorem Phases.cnj' {p : ℕ} {θ θt : ι → ℂ} (h : Phases p θ θt) :
    Phases p (fun i => starRingEnd ℂ (θ i)) (cnj θt) :=
  ⟨fun i => by rw [Complex.norm_conj]; exact h.e i,
   fun i => by
     simp only [cnj]; rw [← map_sub, Complex.norm_conj]; exact h.t i,
   fun i => by simp only [cnj]; rw [Complex.norm_conj]; exact h.t1 i⟩

end Arr

theorem norm_chirp_le {d : ℕ} (s t : Fin d → ℕ) (j : (i : Fin d) → ZMod (t i)) :
    ‖IntMul.OpenAI.RC.chirp s t j‖ ≤ 1 := by
  unfold IntMul.OpenAI.RC.chirp
  rw [norm_prod]
  refine Finset.prod_le_one (fun _ _ => norm_nonneg _) fun i _ => ?_
  exact norm_exp_phase (-(Real.pi * s i * ((j i).val : ℝ) ^ 2 / t i)) _ (by
    push_cast; ring)

theorem norm_zetaR (r : ℕ) : ‖zetaR r‖ = 1 := by
  unfold zetaR
  have : (2 * Real.pi * I * ((1 : ℕ) : ℂ) / ((2 * r : ℕ) : ℂ)) =
      ((2 * Real.pi / (2 * r : ℕ) : ℝ) : ℂ) * I := by push_cast; ring
  rw [this, Complex.norm_exp_ofReal_mul_I]

theorem norm_twX {D : ℕ} (t : Fin (D + 1) → ℕ) (r : ℕ) (K : (i : Fin (D + 1)) → ZMod (t i)) :
    ‖twX t (zetaR r) K‖ ≤ 1 := by
  simp [twX, norm_pow, norm_zetaR]

theorem twX_inv {D : ℕ} (t : Fin (D + 1) → ℕ) (r : ℕ) (K : (i : Fin (D + 1)) → ZMod (t i)) :
    (twX t (zetaR r) K)⁻¹ = starRingEnd ℂ (twX t (zetaR r) K) := by
  have h : ‖twX t (zetaR r) K‖ = 1 := by simp [twX, norm_pow, norm_zetaR]
  have h2 : Complex.normSq (twX t (zetaR r) K) = 1 := by
    rw [Complex.normSq_eq_norm_sq, h]; norm_num
  rw [Complex.inv_def, h2]; simp

end

