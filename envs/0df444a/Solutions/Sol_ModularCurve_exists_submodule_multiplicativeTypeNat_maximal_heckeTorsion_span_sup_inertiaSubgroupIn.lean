open ModularCurve

namespace AlphaDN

theorem exists_realization (q m : ℕ) [hq : Fact q.Prime] :
    ∃ n' : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
      ∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (q ^ m) = 1 → σ ζ = ζ ^ n' σ := by
  haveI : NeZero (q ^ m) := ⟨pow_ne_zero m hq.out.ne_zero⟩
  refine ⟨fun σ => (modularCyclotomicCharacter.toFun (q ^ m)
      (σ : AlgebraicClosure ℚ ≃+* AlgebraicClosure ℚ)).val, fun σ ζ hζ => ?_⟩
  have hζ0 : ζ ≠ 0 := by
    rintro rfl
    rw [zero_pow (NeZero.ne (q ^ m))] at hζ
    exact zero_ne_one hζ
  have hmem : Units.mk0 ζ hζ0 ∈ rootsOfUnity (q ^ m) (AlgebraicClosure ℚ) := by
    rw [mem_rootsOfUnity, Units.ext_iff, Units.val_pow_eq_pow_val, Units.val_mk0, hζ,
      Units.val_one]
  have h := modularCyclotomicCharacter.toFun_spec'
    (σ : AlgebraicClosure ℚ ≃+* AlgebraicClosure ℚ) hmem
  simpa only [Units.val_pow_eq_pow_val, Units.val_mk0, AlgEquiv.coe_ringEquiv] using h

theorem nsmul_eq_nsmul_of_modEq {A : Type*} [AddCommGroup A] {c : ℕ} {d : A}
    (hd : c • d = 0) {a b : ℕ} (h : a ≡ b [MOD c]) : a • d = b • d := by
  have key : ∀ m : ℕ, m • d = (m % c) • d := by
    intro m
    conv_lhs => rw [← Nat.mod_add_div m c]
    rw [add_smul, mul_comm, mul_smul, hd, smul_zero, add_zero]
  rw [key a, key b, (h : a % c = b % c)]

theorem nsmul_eq_of_two_realizations {q k M : ℕ} [hq : Fact q.Prime]
    {n n' : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ}
    (hn : ∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (q ^ k) = 1 → σ ζ = ζ ^ n σ)
    (hn' : ∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (q ^ M) = 1 → σ ζ = ζ ^ n' σ)
    (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    {A : Type*} [AddCommGroup A] {d : A} (hdk : q ^ k • d = 0) (hdM : q ^ M • d = 0) :
    n' τ • d = n τ • d := by
  haveI : NeZero ((q : ℕ) : AlgebraicClosure ℚ) := ⟨Nat.cast_ne_zero.mpr hq.out.ne_zero⟩
  haveI : NeZero ((q : ℕ) : ℚ) := ⟨Nat.cast_ne_zero.mpr hq.out.ne_zero⟩
  obtain ⟨ζ, hζ⟩ :=
    HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure ℚ) (q ^ min k M)
  have hk : ζ ^ (q ^ k) = 1 :=
    (hζ.pow_eq_one_iff_dvd _).mpr (pow_dvd_pow q (min_le_left k M))
  have hM : ζ ^ (q ^ M) = 1 :=
    (hζ.pow_eq_one_iff_dvd _).mpr (pow_dvd_pow q (min_le_right k M))
  have h1 := hn τ ζ hk
  have h2 := hn' τ ζ hM
  have hfin : IsOfFinOrder ζ :=
    isOfFinOrder_iff_pow_eq_one.mpr ⟨q ^ min k M, pow_pos hq.out.pos _, hζ.pow_eq_one⟩
  have hmod : n' τ ≡ n τ [MOD q ^ min k M] := by
    rw [hζ.eq_orderOf]
    exact hfin.pow_eq_pow_iff_modEq.mp (h2.symm.trans h1)
  have hde : q ^ min k M • d = 0 := by
    rcases le_total k M with h | h
    · rw [min_eq_left h]; exact hdk
    · rw [min_eq_right h]; exact hdM
  exact nsmul_eq_nsmul_of_modEq hde hmod

def eigenSubmodule {G : Type*} [Group G] (R : Type*) [CommRing R] {J : Type*} [AddCommGroup J]
    [Module R J] [DistribMulAction G J] [SMulCommClass G R J]
    (I : Subgroup G) (n : G → ℕ) : Submodule R J where
  carrier := {y | ∀ τ ∈ I, τ • y = n τ • y}
  add_mem' := fun {a b : J} (ha : ∀ τ ∈ I, τ • a = n τ • a) (hb : ∀ τ ∈ I, τ • b = n τ • b)
      τ hτ => by
    rw [smul_add, ha τ hτ, hb τ hτ, smul_add]
  zero_mem' := fun τ _ => by rw [smul_zero, smul_zero]
  smul_mem' := fun (t : R) {y : J} (hy : ∀ τ ∈ I, τ • y = n τ • y) τ hτ => by
    show τ • t • y = n τ • t • y
    rw [smul_comm τ t y, hy τ hτ]
    exact (smul_comm (n τ) t y).symm

theorem mem_eigenSubmodule {G : Type*} [Group G] {R : Type*} [CommRing R] {J : Type*}
    [AddCommGroup J] [Module R J] [DistribMulAction G J] [SMulCommClass G R J]
    {I : Subgroup G} {n : G → ℕ} {y : J} :
    y ∈ eigenSubmodule R I n ↔ ∀ τ ∈ I, τ • y = n τ • y :=
  Iff.rfl

end AlphaDN

theorem solution
    (p : ℕ) [Fact p.Prime] (q : ℕ) [Fact q.Prime] (hqp : q ≠ p)
    (Aq : ValuationSubring (AlgebraicClosure ℚ)) (_hAq : Aq.LiesOverPrime q) :
    letI := heckeModuleBar p
    ∀ k M : ℕ, ∀ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
      (∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (q ^ k) = 1 → σ ζ = ζ ^ n σ) →
    ∃ W : Submodule HeckeAlg (JZero p),
      W ≤ heckeTorsion (JZero p)
        (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M) ∧
      MultiplicativeTypeNat (Aq.inertiaSubgroupIn ℚ) n W.toAddSubgroup ∧
      (∀ σ ∈ Aq.inertiaSubgroupIn ℚ,
        ∀ x ∈ heckeTorsion (JZero p)
          (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M),
        σ • (x : JZero p) - x ∈ W) ∧
      (∀ W' : Submodule HeckeAlg (JZero p),
        W' ≤ heckeTorsion (JZero p)
          (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M) →
        MultiplicativeTypeNat (Aq.inertiaSubgroupIn ℚ) n W'.toAddSubgroup → W' ≤ W) := by
  letI := heckeModuleBar p
  haveI := ModularCurve.smulCommClass_JZero_of_heckeOperatorsCommuteBar p
    (ModularCurve.heckeOperatorsCommuteBar p)
  intro k M n hn
  refine ⟨AlphaDN.eigenSubmodule HeckeAlg (Aq.inertiaSubgroupIn ℚ) n ⊓
      heckeTorsion (JZero p)
        (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M),
    inf_le_right, ?_, ?_, ?_⟩
  ·
    intro τ hτ x hx
    exact (AlphaDN.mem_eigenSubmodule.mp (Submodule.mem_inf.mp hx).1) τ hτ
  ·
    intro σ hσ x hx
    have hσx : σ • x ∈ heckeTorsion (JZero p)
        (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M) :=
      smul_mem_heckeTorsion (JZero p) σ hx
    have hd : σ • x - x ∈ heckeTorsion (JZero p)
        (Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M) :=
      sub_mem hσx hx
    have hd' := (mem_heckeTorsion_iff (JZero p) _ _).mp hd

    have hdk : q ^ k • (σ • x - x) = 0 := by
      have h := hd' _ (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton _)))
      have hc : ((q : ℕ) ^ k : HeckeAlg) = ((q ^ k : ℕ) : HeckeAlg) := by norm_cast
      rwa [hc, Nat.cast_smul_eq_nsmul] at h

    have hdM : q ^ M • (σ • x - x) = 0 := by
      have h := hd' _ (Ideal.mem_sup_right
        (Ideal.pow_mem_pow (natCast_mem_eisensteinMaximalIdeal p q) M))
      rwa [← Nat.cast_pow, Nat.cast_smul_eq_nsmul] at h

    have hxM : x ∈ eisensteinTorsionBar p q M :=
      Submodule.torsionBySet_le_torsionBySet_of_subset
        (SetLike.coe_subset_coe.mpr
          (le_sup_right : (eisensteinMaximalIdeal p q) ^ M ≤
            Ideal.span {((q : ℕ) ^ k : HeckeAlg)} ⊔ (eisensteinMaximalIdeal p q) ^ M)) hx
    obtain ⟨n', hn'⟩ := AlphaDN.exists_realization q M
