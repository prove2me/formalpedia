def checkBez (M : Poly1009) (d : ℕ) (Q : Poly1009) (uv : Poly1009 × Poly1009) : Bool :=
  peq (padd (pmul uv.1 M) (pmul uv.2 (pmodRec 80 M d Q))) pone


