-- ===== S4.Def_RP_EtPBC_A_NbExt2 =====
section

/-!
# S4-EtPBC-A, M2 F8a: extending a clopen of `Y_s` to an etale neighbourhood

* `ysj_map`: `ysj j' ≫ (restriction along a : j' ⟶ j) = ysj j`;
* `etale_hV`, `nbR` (the neighbourhood `Spec R' ⟶ V ⟶ S` through `x'`), `nbRHom : nbR ⟶ j`;
* **`exists_clopen_nbhd`**: for an affine noetherian neighbourhood `j` and a clopen `O ⊆ Y_s` there is an affine
  noetherian `j' ⟶ j` and a clopen `C ⊆ Y_{j'}` with `ysj j' ⁻¹' C = O`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtPBC.Z3

universe u

section Map

variable {P S Y : Scheme.{u}} (g : P ⟶ S) (s : GeomPt S) (π : Y ⟶ P)

/-- `ysj` is compatible with restriction along an arrow of neighbourhoods. -/
theorem ysj_map {j j' : Nbhd s} (a : j' ⟶ j) :
    ysj g s π j' ≫ ((etPull π).map ((etPull g).map a.1)).left = ysj g s π j := by
  have y1 : ∀ i : Nbhd s, ysj g s π i ≫ pullback.fst (pullback.snd i.1.hom g) π =
      pullback.snd π (fibι g s) ≫ fibToNbhd g s i := fun i => pullback.lift_fst _ _ _
  have y2 : ∀ i : Nbhd s, ysj g s π i ≫ pullback.snd (pullback.snd i.1.hom g) π = pullback.fst π (fibι g s) :=
    fun i => pullback.lift_snd _ _ _
  apply pullback.hom_ext
  · refine (Category.assoc _ _ _).trans ((congrArg (ysj g s π j' ≫ ·)
      (etPull_map_left_fst π ((etPull g).map a.1))).trans ?_)
    refine (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ ((etPull g).map a.1).left) (y1 j')).trans ?_)
    exact (Category.assoc _ _ _).trans ((congrArg (pullback.snd π (fibι g s) ≫ ·) (fibToNbhd_map g s a)).trans
      (y1 j).symm)
  · exact (Category.assoc _ _ _).trans ((congrArg (ysj g s π j' ≫ ·)
      (etPull_map_left_snd π ((etPull g).map a.1))).trans ((y2 j').trans (y2 j).symm))

end Map

section Nbhd

variable (K : Type u) [Field K] {S : Scheme.{u}} (gK : S ⟶ Spec (CommRingCat.of K)) (s : GeomPt S)
  [IsIso (s.pt ≫ gK)] (j : Nbhd s) [IsAffine j.1.left] (R' : Type u) [CommRing R'] [Algebra Γ(j.1.left, ⊤) R']
  [Algebra.Etale Γ(j.1.left, ⊤) R'] (x' : Spec (CommRingCat.of K) ⟶ Spec (CommRingCat.of R'))

/-- The neighbourhood `(Spec R', (s ≫ g_K) ≫ x')` of `s`. -/
def nbR (hx' : x' ≫ hV j.1.left R' = xV K gK s (nbv s j)) : Nbhd s :=
  s.point.fiber.elementsMk (etR s j R')
    (Over.homMk ((s.pt ≫ gK) ≫ x')
      (hvR s (nbh s j) (nbv s j) R' ((s.pt ≫ gK) ≫ x') (hv'_of K gK s (nbv s j) R' x' _ hx' rfl) (nbv_w s j)) :
      CategoryTheory.Over.mk s.pt ⟶ (Scheme.Etale.forget S).obj (etR s j R'))

/-- The arrow `nbR ⟶ j`. -/
def nbRHom (hx' : x' ≫ hV j.1.left R' = xV K gK s (nbv s j)) : nbR K gK s j R' x' hx' ⟶ j :=
  ⟨MorphismProperty.Over.homMk (hV j.1.left R') rfl trivial,
    fiber_ext s ((liftOf_map_left' s (MorphismProperty.Over.homMk (hV j.1.left R') rfl trivial :
      etR s j R' ⟶ j.1) (nbR K gK s j R' x' hx').2).trans (hv'_of K gK s (nbv s j) R' x' _ hx' rfl))⟩

end Nbhd

end RamanujanPetersson.EtPBC

end

