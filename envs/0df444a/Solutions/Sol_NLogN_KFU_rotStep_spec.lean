theorem pull_rotG {α : Type*} (A C : Shape) (Q : ℕ) (as : ℕ → ℕ) (d : α) (xs : List α) :
    AModel.pull (A ++ Q :: C) (A ++ Q :: C) (NLogN.KFU.rotG A.length Q (fun a => as (encode A a))) d xs =
      AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (KIL.rotAddr Q as) d xs := by
  have hv : AModel.vol (A ++ Q :: C) = AModel.vol [AModel.vol A, Q, AModel.vol C] := by
    rw [vol_append, vol_cons]; simp [AModel.vol]
  apply List.ext_getElem (by rw [length_pull, length_pull, hv])
  intro j h1 h2
  simp only [length_pull] at h1 h2
  rw [getElem_pull, getElem_pull]
  congr 1
  have hval := valid_decode h2
  obtain ⟨p, y, b, hdec, hp, hy, hb⟩ : ∃ p y b, decode [AModel.vol A, Q, AModel.vol C] j = [p, y, b] ∧
      p < AModel.vol A ∧ y < Q ∧ b < AModel.vol C := by
    generalize decode [AModel.vol A, Q, AModel.vol C] j = D at hval
    rcases hval with _ | ⟨hp, _ | ⟨hy, _ | ⟨hb, h⟩⟩⟩
    cases h
    exact ⟨_, _, _, rfl, hp, hy, hb⟩
  have hj : j = (p * Q + y) * AModel.vol C + b := by
    rw [← encode_decode h2, hdec]; simp [encode, AModel.vol]; ring
  have hlA : (decode A p).length = A.length := length_decode _ _
  have hDv : Valid (A ++ Q :: C) (decode A p ++ y :: decode C b) :=
    valid_append (valid_decode hp) (List.Forall₂.cons hy (valid_decode hb))
  have henc : ∀ w, encode (A ++ Q :: C) (decode A p ++ w :: decode C b) = (p * Q + w) * AModel.vol C + b := by
    intro w
    rw [encode_append_len _ _ hlA, encode_decode hp]
    simp only [encode, List.headD_cons, List.tail_cons, encode_decode hb, vol_cons]; ring
  have hdD : decode (A ++ Q :: C) j = decode A p ++ y :: decode C b := by
    rw [← decode_encode hDv, henc, hj]
  rw [hdD, hdec]
  have e1 : (decode A p ++ y :: decode C b).take A.length = decode A p := by
    rw [List.take_append_of_le_length (by omega), List.take_of_length_le (by omega)]
  have e2 : (decode A p ++ y :: decode C b).getD A.length 0 = y := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega), hlA]; simp
  have e3 : (decode A p ++ y :: decode C b).drop (A.length + 1) = decode C b := by
    rw [← hlA, List.drop_append]; simp
  simp only [NLogN.KFU.rotG, e1, e2, e3, encode_decode hp, henc]
  simp [KIL.rotAddr, encode, AModel.vol]; ring

