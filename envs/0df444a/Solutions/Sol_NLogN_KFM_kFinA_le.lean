section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFM
open Finset IntMul KIL KFB KFT KFU RS IntMul.OpenAI.Glue IntMul.OpenAI.RCost
variable {n D : ℕ} (hn : n0 ≤ n) (hD : dP n = D + 1)
include hn hD
set_option maxHeartbeats 2000000
theorem solution : NLogN.KFM.kFinA n D ≤ 10 ^ 9 * (IntMul.OpenAI.Glue.TP n * (IntMul.OpenAI.Glue.pP n + 1 + NLogN.KFM.fmB (8 * IntMul.OpenAI.Glue.pP n)) + IntMul.OpenAI.Glue.pP n + 1) := by
  have hW := NLogN.KFM.wU_le hn hD
  have hR := NLogN.KFM.wFR_le hn hD
  have hb := (NLogN.KFM.setup_facts hn).1
  have hS := NLogN.KFM.sCmp_le_T hn hD
  have hF := NLogN.KFM.fmB_le8 hn hD (m := 2 * NLogN.KFM.wFR n D) (by omega)
  have k1 := NLogN.KFM.kCj_le hn hD (B := NLogN.KFM.wU n D) (by omega)
  unfold NLogN.KFM.kFinA NLogN.KFM.kSm NLogN.KFM.kShF NLogN.KFM.kRd
  have i1 := NLogN.KFM.cItem_le (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) (NLogN.KFM.fmB (2 * NLogN.KFM.wFR n D) + 5000 * (NLogN.KFM.wFR n D + 0 + 3)) (2 * NLogN.KFM.wFR n D)
  have i2 := NLogN.KFM.cItem_le (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) (1000 * (NLogN.KFM.wFR n D + (2 * IntMul.OpenAI.Glue.bP n + 4) + 2))
    (NLogN.KFM.wFR n D + (2 * IntMul.OpenAI.Glue.bP n + 4) + 1)
  have i3 := NLogN.KFM.cItem_le (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) (3000 * (NLogN.KFM.wFR n D + IntMul.OpenAI.Glue.pP n + 3)) (2 * NLogN.KFM.wFR n D + 1)
  have c2 := NLogN.KFM.cCnt_le (2 ^ (IntMul.OpenAI.Glue.LP n + 1))
  have w1 := NLogN.KFM.cW_nat (NLogN.KFM.sCmp n)
  have w2 := NLogN.KFM.cW_pow 0
  have w3 := NLogN.KFM.cW_nat (2 ^ (IntMul.OpenAI.Glue.LP n + 1))
  have w4 := NLogN.KFM.cW_pow (2 * IntMul.OpenAI.Glue.bP n + 4)
  have w5 := NLogN.KFM.cW_pow (IntMul.OpenAI.Glue.pP n - 1)
  have w6 := NLogN.KFM.cW_pow (IntMul.OpenAI.Glue.pP n)
  rw [NLogN.KFM.eT2 hn hD] at i1 i2 i3 c2 w3 ⊢
  set T := IntMul.OpenAI.Glue.TP n
  set F := NLogN.KFM.fmB (8 * IntMul.OpenAI.Glue.pP n)
  set R := NLogN.KFM.wFR n D
  have m1 := Nat.mul_le_mul_left T hF
  have m2 := Nat.mul_le_mul_left T hR
  have hbp : IntMul.OpenAI.Glue.bP n ≤ IntMul.OpenAI.Glue.pP n := by unfold IntMul.OpenAI.Glue.pP; omega
  have m4 := Nat.mul_le_mul_left T hbp
  have hp1 : IntMul.OpenAI.Glue.pP n - 1 ≤ IntMul.OpenAI.Glue.pP n := Nat.sub_le _ _
  clear_value T F R
  generalize NLogN.KFM.kCj n (NLogN.KFM.wU n D) = K at k1 ⊢
  generalize IntMul.OpenAI.Glue.pP n - 1 = q at hp1 w5 ⊢
  generalize NLogN.KFM.fmB (2 * R) = F' at i1 hF m1 ⊢
  set p := IntMul.OpenAI.Glue.pP n
  set b := IntMul.OpenAI.Glue.bP n
  have e1 : 2 * T * (F' + 5000 * (R + 0 + 3)) + 5000 * (2 * T + 1) * (2 * R + 2) =
      2 * (T * F') + 30000 * (T * R) + 50000 * T + 10000 * R + 10000 := by ring
  have e2 : 2 * T * (1000 * (R + (2 * b + 4) + 2)) + 5000 * (2 * T + 1) * (R + (2 * b + 4) + 1 + 2) =
      12000 * (T * R) + 24000 * (T * b) + 82000 * T + 5000 * R + 10000 * b + 35000 := by ring
  have e3 : 2 * T * (3000 * (R + p + 3)) + 5000 * (2 * T + 1) * (2 * R + 1 + 2) =
      26000 * (T * R) + 6000 * (T * p) + 48000 * T + 10000 * R + 15000 := by ring
  have e4 : T * (p + 1) = T * p + T := by ring
  have e5 : T * (3 * p) = 3 * (T * p) := by ring
  have e6 : T * (p + 1 + F) = T * p + T + T * F := by ring
  rw [e1] at i1; rw [e2] at i2; rw [e3] at i3; rw [e4] at k1; rw [e5] at m2; rw [e6]
  omega
end
