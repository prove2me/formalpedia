      (∀ (γ : SL(2, ℤ)), γ ∈ CongruenceSubgroup.Gamma0 M' → ∀ ℓ s,
        ρ₁ q M' lam (SemilinearAut.ofAlgAut (levelAutBar q M' ζ₀ γ⁻¹)) (vc (ℓ, s)) = vc ((redQ q γ) • ℓ, s)) := by
  classical

  obtain ⟨hgenus, hcurve, hess, hdisc, hw, -, hratBar, hpair, hatt, -, hcover⟩ :=
    𝒞.telescope_laws ⟨π, hπP⟩ hWd hG hD hC
  obtain ⟨⟨hπmax, hπ0⟩, hrk, hratF, hS, hSlift, hℓ, hSℓ, hnodes, hFD, hIC, hEFT⟩ :=
    ModularCurve.FullLevel.telescope_frame_of_semistableCovering_of_eq_three q hq3 M' hqM' lam hqlam hLA hGL A hP W hW π hπ hπP ι
      hle R₀ hR₀ 𝒞 hEq hDr hIg hPin hIn hWd hG hD hC hNat
  haveI := hFD; haveI := hIC; haveI := hEFT
  haveI : ∀ i, IsCurveOver (ResidueField A) (𝒞.teleFbar i) := hcurve
  haveI : ∀ i, Algebra.EssFiniteType (ResidueField A) (𝒞.teleFbar i) := hess
  obtain ⟨M₁, D₁, -⟩ := 𝒞.exists_semistableModel_telescope M D

  have hκ : ∀ p : ℕ, p.Prime → CharP (IsLocalRing.ResidueField A) p →
