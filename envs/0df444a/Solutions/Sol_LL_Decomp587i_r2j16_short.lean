  have hmono := setIntegral_mono_on hint_ig hM_int isClosed_D.measurableSet hpt
  have hM_eval : ∫ x in D_set, M_hi_fn x =
      (5 / 6 : ℝ) * (∫ x in D_set, f_smooth BuchstabArithmetic.top x) +
