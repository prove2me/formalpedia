theorem GB.mono {w w' : ℕ} {zs : List GI} (h : GB w zs) (hw : w ≤ w') : GB w' zs :=
  fun z hz => ⟨(h z hz).1.trans hw, (h z hz).2.trans hw⟩

theorem zsz_of_real {p : ℕ} (v : ℤ) (hv : |(v : ℝ)| ≤ 2 ^ p) : zsz v ≤ p + 1 := by
  apply KFL.zsz_le_of_abs
  have h1 : ((|v| : ℤ) : ℝ) ≤ ((2 ^ p : ℤ) : ℝ) := by push_cast; exact hv
  have h2 : |v| ≤ 2 ^ p := by exact_mod_cast h1
  have h3 : (2 : ℤ) ^ p < 2 ^ (p + 1) := pow_lt_pow_right₀ (by norm_num) (by omega)
  omega

/-- **Numerator sizes** of a represented array of norm `≤ 1`. -/
theorem gb_of_rep {d p : ℕ} {s t : Fin d → ℕ} [∀ i, NeZero (s i)] {zs : List GI}
    {u : ((i : Fin d) → ZMod (s i)) → ℂ} (h : RepPad p s t zs u) (hu : ‖u‖ ≤ 1) :
    GB (p + 1) zs := by
  intro z hz
  obtain ⟨x, hx, rfl⟩ := List.getElem_of_mem hz
  have hx' : x < (List.ofFn t).prod := h.1 ▸ hx
  have hg : zs.getD x 0 = zs[x] := List.getD_eq_getElem _ _ hx
  by_cases hs : ∀ i, boxIx t x i < s i
  · have e := (h.2 x hx').1 hs
    rw [hg] at e
    have hn : ‖gC zs[x]‖ ≤ 2 ^ p := by
      rw [e, norm_mul, norm_pow, Complex.norm_ofNat]
      have := (norm_le_pi_norm u (fun i => ((boxIx t x i : ℕ) : ZMod (s i)))).trans hu
      calc (2 : ℝ) ^ p * ‖u _‖ ≤ 2 ^ p * 1 := by gcongr
        _ = 2 ^ p := mul_one _
    have h1 : |((zs[x]).1 : ℝ)| ≤ 2 ^ p := by
      have := (Complex.abs_re_le_norm (gC zs[x])).trans hn
      simpa [gC_eq_toC, toC] using this
    have h2 : |((zs[x]).2 : ℝ)| ≤ 2 ^ p := by
      have := (Complex.abs_im_le_norm (gC zs[x])).trans hn
      simpa [gC_eq_toC, toC] using this
    exact ⟨zsz_of_real _ h1, zsz_of_real _ h2⟩
  · have e := (h.2 x hx').2 hs
