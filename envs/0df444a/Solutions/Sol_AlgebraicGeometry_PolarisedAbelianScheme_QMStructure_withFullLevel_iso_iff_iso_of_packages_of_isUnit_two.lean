def IsPtHom {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (L' : RelativeGroupLaw R f') (φ : A ⟶ A') (hφ : φ ≫ f' = f) : Prop :=
  ∀ (T : Scheme.{u}) (t : T ⟶ Spec (CommRingCat.of R)) (x y : SchemeHomOver t f),
    (L.mul t x y).1 ≫ φ = (L'.mul t (mapPt φ hφ x) (mapPt φ hφ y)).1

theorem IsPtHom.comp {A A' A'' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    {f'' : A'' ⟶ Spec (CommRingCat.of R)}
    {L : RelativeGroupLaw R f} {L' : RelativeGroupLaw R f'} {L'' : RelativeGroupLaw R f''}
    {φ : A ⟶ A'} {hφ : φ ≫ f' = f} {ψ : A' ⟶ A''} {hψ : ψ ≫ f'' = f'}
    (h : IsPtHom L L' φ hφ) (h' : IsPtHom L' L'' ψ hψ) :
    IsPtHom L L'' (φ ≫ ψ) (by rw [Category.assoc, hψ, hφ]) := by
  intro T t x y
  have e1 : mapPt (φ ≫ ψ) (by rw [Category.assoc, hψ, hφ]) x = mapPt ψ hψ (mapPt φ hφ x) :=
    Subtype.ext (Category.assoc _ _ _).symm
  have e2 : mapPt (φ ≫ ψ) (by rw [Category.assoc, hψ, hφ]) y = mapPt ψ hψ (mapPt φ hφ y) :=
    Subtype.ext (Category.assoc _ _ _).symm
  rw [e1, e2, ← Category.assoc, h T t x y, h' T]

theorem IsPtHom.inv {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    {L : RelativeGroupLaw R f} {L' : RelativeGroupLaw R f'} (e : A ≅ A') {he : e.hom ≫ f' = f}
    (h : IsPtHom L L' e.hom he) (hei : e.inv ≫ f = f') : IsPtHom L' L e.inv hei := by
  intro T t x y
  have h1 := h T t (mapPt e.inv hei x) (mapPt e.inv hei y)
  have ex : mapPt e.hom he (mapPt e.inv hei x) = x := Subtype.ext (by simp [mapPt_coe])
  have ey : mapPt e.hom he (mapPt e.inv hei y) = y := Subtype.ext (by simp [mapPt_coe])
  rw [ex, ey] at h1
  rw [← cancel_mono e.hom, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  exact h1.symm

theorem IsPtHom.one_map {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    {L : RelativeGroupLaw R f} {L' : RelativeGroupLaw R f'} {φ : A ⟶ A'} {hφ : φ ≫ f' = f}
    (h : IsPtHom L L' φ hφ) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    (L.one t).1 ≫ φ = (L'.one t).1 := by
  letI := L.pointGroup t
  letI := L'.pointGroup t
  have hΦ : ∀ x y : SchemeHomOver t f, mapPt φ hφ (x * y) = mapPt φ hφ x * mapPt φ hφ y :=
    fun x y => Subtype.ext (h T t x y)
  exact congrArg Subtype.val (MonoidHom.mk' (mapPt φ hφ) hΦ).map_one

theorem IsPtHom.mapPt_one {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    {L : RelativeGroupLaw R f} {L' : RelativeGroupLaw R f'} {φ : A ⟶ A'} {hφ : φ ≫ f' = f}
    (h : IsPtHom L L' φ hφ) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    mapPt φ hφ (L.one t) = L'.one t :=
  Subtype.ext (IsPtHom.one_map h t)

theorem factorsThrough_iff_eq_one {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} (E : FakeEllipticCurve Λ 1 R)
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P : SchemeHomOver t E.f) :
    FactorsThrough E.lev P ↔ P = E.L.one t := by
  constructor
  · intro hP
    have h := E.lev_torsion t P hP
    change E.L.mul t (E.L.one t) P = E.L.one t at h
    rwa [E.L.one_mul] at h
  · rintro rfl
    exact E.lev_one t

end Points

section Modules

variable {S : Type u} [CommRing S]

theorem locIso_of_iso {X : Scheme.{u}} (g : X ⟶ Spec (CommRingCat.of S)) {M M' : X.Modules} (i : M ≅ M') :
    LocIsoOnBase g M M' :=
  fun _ => ⟨⊤, trivial, ⟨(Scheme.Modules.pullback (g ⁻¹ᵁ ⊤).ι).mapIso i⟩⟩

noncomputable def pullbackInvHomIso {A A' : Scheme.{u}} (e : A ≅ A') (P' : A'.Modules) :
    (Scheme.Modules.pullback e.inv).obj ((Scheme.Modules.pullback e.hom).obj P') ≅ P' :=
  (Scheme.Modules.pullbackComp e.inv e.hom).app P' ≪≫ (Scheme.Modules.pullbackCongr e.inv_hom_id).app P' ≪≫
    (Scheme.Modules.pullbackId A').app P'

noncomputable def pullbackCompIso {A B C : Scheme.{u}} (h : A ⟶ B) (g : B ⟶ C) (M : C.Modules) :
    (Scheme.Modules.pullback h).obj ((Scheme.Modules.pullback g).obj M) ≅ (Scheme.Modules.pullback (h ≫ g)).obj M :=
  (Scheme.Modules.pullbackComp h g).app M

end Modules

theorem main
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (β : Fin (2 * 2) → ↥Λ)
    (m : ℕ) (S : Type) [CommRing S] (h2 : IsUnit (2 : S))
    (X X' : PolarisedAbelianScheme 2 36 m S) (s : QMStructure Λ star β X) (s' : QMStructure Λ star β X')
    (u u' : FakeEllipticCurve.WithFullLevel Λ 1 m S) (hu : s.Packages u) (hu' : s'.Packages u') :
    FakeEllipticCurve.WithFullLevel.Iso u u' ↔ QMStructure.Iso s s' := by
  obtain ⟨e, he, hemul, heact, heP⟩ := hu
  obtain ⟨e', he', he'mul, he'act, he'P⟩ := hu'
  have hei : e.inv ≫ u.1.f = X.f := by rw [← he, Iso.inv_hom_id_assoc]
  have hei' : e'.inv ≫ u'.1.f = X'.f := by rw [← he', Iso.inv_hom_id_assoc]
  have H_e : IsPtHom u.1.L X.L e.hom he := fun T t x y => hemul t x y
  have H_e' : IsPtHom u'.1.L X'.L e'.hom he' := fun T t x y => he'mul t x y
  have H_ei : IsPtHom X.L u.1.L e.inv hei := IsPtHom.inv e H_e hei
  have H_ei' : IsPtHom X'.L u'.1.L e'.inv hei' := IsPtHom.inv e' H_e' hei'
  have hia : ∀ x : ↥Λ, s.act x ≫ e.inv = e.inv ≫ u.1.act x := fun x => by
    rw [← cancel_epi e.hom, ← Category.assoc, ← heact x, Category.assoc, Iso.hom_inv_id, Category.comp_id,
      Iso.hom_inv_id_assoc]
  have hia' : ∀ x : ↥Λ, s'.act x ≫ e'.inv = e'.inv ≫ u'.1.act x := fun x => by
    rw [← cancel_epi e'.hom, ← Category.assoc, ← he'act x, Category.assoc, Iso.hom_inv_id, Category.comp_id,
      Iso.hom_inv_id_assoc]
  constructor
  ·
    rintro ⟨ε, hε, hεmul, hεact, hεlev, hεP⟩
    have H_ε : IsPtHom u.1.L u'.1.L ε.hom hε := fun T t x y => congrArg Subtype.val (hεmul t x y)
    have hεi : ε.inv ≫ u.1.f = u'.1.f := by rw [← hε, Iso.inv_hom_id_assoc]
    have H_εi : IsPtHom u'.1.L u.1.L ε.inv hεi := IsPtHom.inv ε H_ε hεi
    have hεP1 : u.2.P.1 ≫ ε.hom = u'.2.P.1 := congrArg Subtype.val hεP
    let E : X.A ≅ X'.A := e.symm ≪≫ ε ≪≫ e'
    have hE : E.hom ≫ X'.f = X.f := by simp [E, he', hε, hei]
    have H_E : IsPtHom X.L X'.L E.hom hE := by
      have h := IsPtHom.comp H_ei (IsPtHom.comp H_ε H_e')
      exact h
    have hEact : ∀ x : ↥Λ, s.act x ≫ E.hom = E.hom ≫ s'.act x := by
      intro x
      show s.act x ≫ e.inv ≫ ε.hom ≫ e'.hom = (e.inv ≫ ε.hom ≫ e'.hom) ≫ s'.act x
      rw [reassoc_of% (hia x), reassoc_of% (hεact x), he'act x]
      simp only [Category.assoc]
    have hEgen : s.P.1 ≫ E.hom = s'.P.1 := by
      show s.P.1 ≫ e.inv ≫ ε.hom ≫ e'.hom = s'.P.1
      rw [← heP, Category.assoc, Iso.hom_inv_id_assoc, reassoc_of% hεP1, he'P]
    have hEP : ∀ i, (X.P i).1 ≫ E.hom = (X'.P i).1 := by
      intro i
      rw [← s.level_match i, ← s'.level_match i]
      show (s.P.1 ≫ s.act (β i)) ≫ E.hom = s'.P.1 ≫ s'.act (β i)
      rw [Category.assoc, hEact (β i), ← Category.assoc, hEgen]

    have hEi : E.inv ≫ X.f = X'.f := by rw [← hE, Iso.inv_hom_id_assoc]
    have hpol : LocIsoOnBase X.f ((Scheme.Modules.pullback E.hom).obj X'.pol) X.pol := by
      obtain ⟨polE, hcan, hcube⟩ := s.pol_canonical
      obtain ⟨polE', hcan', hcube'⟩ := s'.pol_canonical
      have Eq := LocIsoOnBase.equivalence X.f

      have hcanU : IsCanonicalPolData u.1.f u.1.L u.1.act u.1.act_over star
          ((Scheme.Modules.pullback e.hom).obj polE) :=
        IsCanonicalPolData.pullback_inv_of_iso X.L u.1.L s.act s.act_over u.1.act u.1.act_over star
          e.symm hei (fun t x y => H_ei _ t x y) hia polE hcan
      have he2 : (e'.inv ≫ ε.inv) ≫ u.1.f = X'.f := by rw [Category.assoc, hεi, hei']
      have H2 : IsPtHom X'.L u.1.L (e'.inv ≫ ε.inv) he2 := IsPtHom.comp H_ei' H_εi
      have hact2 : ∀ x : ↥Λ, s'.act x ≫ (e'.inv ≫ ε.inv) = (e'.inv ≫ ε.inv) ≫ u.1.act x := by
        intro x
        have hεia : u'.1.act x ≫ ε.inv = ε.inv ≫ u.1.act x := by
          rw [← cancel_epi ε.hom, ← Category.assoc, ← hεact x, Category.assoc, Iso.hom_inv_id, Category.comp_id,
            Iso.hom_inv_id_assoc]
        rw [← Category.assoc, hia' x, Category.assoc, hεia, Category.assoc]
      have hcanU' : IsCanonicalPolData u.1.f u.1.L u.1.act u.1.act_over star
          ((Scheme.Modules.pullback (ε.hom ≫ e'.hom)).obj polE') :=
        IsCanonicalPolData.pullback_inv_of_iso X'.L u.1.L s'.act s'.act_over u.1.act u.1.act_over star
          (ε ≪≫ e').symm he2 (fun t x y => H2 _ t x y) hact2 polE' hcan'

      have hU : LocIsoOnBase u.1.f ((Scheme.Modules.pullback e.hom).obj polE)
          ((Scheme.Modules.pullback (ε.hom ≫ e'.hom)).obj polE') :=
        FakeEllipticCurve.locIsoOnBase_of_isCanonicalPol_of_isUnit_two hqq' hB Λ hΛ μ hμ star hstar 1 S h2 u.1 _ _ hcanU hcanU'

      have hcomm : e.inv ≫ u.1.f = X.f ≫ 𝟙 (Spec (CommRingCat.of S)) := by rw [Category.comp_id, hei]
      have hU' := LocIsoOnBase.pullback_of_comp_eq X.f e.inv (𝟙 _) hcomm hU
      have hpolE : LocIsoOnBase X.f ((Scheme.Modules.pullback E.hom).obj polE') polE :=
        Eq.symm (Eq.trans (Eq.trans (Eq.symm (locIso_of_iso X.f (pullbackInvHomIso e polE))) hU')
          (locIso_of_iso X.f (pullbackCompIso e.inv (ε.hom ≫ e'.hom) polE')))
      have hcubeE := LocIsoOnBase.tensor hpolE (LocIsoOnBase.tensor hpolE hpolE)

      have hPP' : LocIsoOnBase X'.f
          ((Scheme.Modules.pullback E.symm.hom).obj ((Scheme.Modules.pullback E.hom).obj X'.pol)) X'.pol :=
        locIso_of_iso X'.f (pullbackInvHomIso E X'.pol)
      have h7 := LocIsoOnBase.tensor_cube_pullback_inv_of_iso E.symm hEi X'.pol polE'
        ((Scheme.Modules.pullback E.hom).obj X'.pol) hcube' hPP'
      exact Eq.trans h7 (Eq.trans hcubeE (Eq.symm hcube))
    exact ⟨E, hE, fun t x y => H_E _ t x y, hEP, hpol, hEact, hEgen⟩
  ·
    rintro ⟨E, hE, hEmul, hEP, hEpol, hEact, hEgen⟩
    have H_E : IsPtHom X.L X'.L E.hom hE := fun T t x y => hEmul t x y
    let ε : u.1.A ≅ u'.1.A := e ≪≫ E ≪≫ e'.symm
    have hε : ε.hom ≫ u'.1.f = u.1.f := by simp [ε, hei', hE, he]
    have H_ε : IsPtHom u.1.L u'.1.L ε.hom hε := by
      have h := IsPtHom.comp H_e (IsPtHom.comp H_E H_ei')
      exact h
    refine ⟨ε, hε, ?_, ?_, ?_, ?_⟩
    · intro T t P Q
      exact Subtype.ext (H_ε T t P Q)
    · intro x
      show u.1.act x ≫ e.hom ≫ E.hom ≫ e'.inv = (e.hom ≫ E.hom ≫ e'.inv) ≫ u'.1.act x
      rw [reassoc_of% (heact x), reassoc_of% (hEact x), hia' x]
      simp only [Category.assoc]
    · intro T t P
      rw [factorsThrough_iff_eq_one, factorsThrough_iff_eq_one]
      constructor
      · rintro rfl
        exact IsPtHom.mapPt_one H_ε t
      · intro h
        have h1 : P.1 ≫ ε.hom = (u.1.L.one t).1 ≫ ε.hom := by
          rw [IsPtHom.one_map H_ε t]; exact congrArg Subtype.val h
        exact Subtype.ext ((cancel_mono ε.hom).1 h1)
    · apply Subtype.ext
      show u.2.P.1 ≫ e.hom ≫ E.hom ≫ e'.inv = u'.2.P.1
      rw [reassoc_of% heP, reassoc_of% hEgen, ← he'P, Category.assoc, Iso.hom_inv_id, Category.comp_id]

end FBISO

theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (β : Fin (2 * 2) → ↥Λ) (hβ : ∀ x : ↥Λ, ∃! c : Fin (2 * 2) → ℤ, x = ∑ j, c j • β j)
    (m : ℕ) (hm : 3 ≤ m) (S : Type) [CommRing S] (h2 : IsUnit (2 : S)) (hm' : IsUnit ((m : ℕ) : S)) :
    ∀ (X X' : PolarisedAbelianScheme 2 36 m S) (s : QMStructure Λ star β X) (s' : QMStructure Λ star β X')
        (u u' : FakeEllipticCurve.WithFullLevel Λ 1 m S), s.Packages u → s'.Packages u' →
        (FakeEllipticCurve.WithFullLevel.Iso u u' ↔ QMStructure.Iso s s') :=
  fun X X' s s' u u' hu hu' => FBISO.main hqq' hB Λ hΛ μ hμ star hstar β m S h2 X X' s s' u u' hu hu'

