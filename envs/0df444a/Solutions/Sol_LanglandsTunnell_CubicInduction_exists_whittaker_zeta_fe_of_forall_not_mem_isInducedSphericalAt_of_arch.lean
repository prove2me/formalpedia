variable (F : Type) [Field F] [NumberField F]

private theorem asIdeal_mem_primesOver_of_mem_primeFibre (p : HeightOneSpectrum (𝓞 ℚ))
    {𝔓 : HeightOneSpectrum (𝓞 F)} (h : 𝔓 ∈ primeFibre ℚ F p) :
    𝔓.asIdeal ∈ p.asIdeal.primesOver (𝓞 F) := by
  rw [mem_primeFibre] at h
  refine ⟨𝔓.isPrime, ⟨?_⟩⟩
  rw [← h]
  rfl

private theorem image_asIdeal_primeFibre (p : HeightOneSpectrum (𝓞 ℚ)) :
    HeightOneSpectrum.asIdeal '' primeFibre ℚ F p = p.asIdeal.primesOver (𝓞 F) := by
  ext Q
  constructor
  · rintro ⟨𝔓, h𝔓, rfl⟩
    exact asIdeal_mem_primesOver_of_mem_primeFibre F p h𝔓
  · intro hQ
    haveI : Q.IsPrime := hQ.1
    haveI : Q.LiesOver p.asIdeal := hQ.2
    refine ⟨⟨Q, hQ.1, Ideal.ne_bot_of_mem_primesOver p.ne_bot hQ⟩, ?_, rfl⟩
    rw [mem_primeFibre]
    apply HeightOneSpectrum.ext
    exact (Ideal.over_def Q p.asIdeal).symm

private theorem _root_.LanglandsTunnell.CubicInduction.BadPlaceCoefficient.primeFibre_finite (p : HeightOneSpectrum (𝓞 ℚ)) : (primeFibre ℚ F p).Finite := by
  have hfin : (p.asIdeal.primesOver (𝓞 F)).Finite := IsDedekindDomain.primesOver_finite p.asIdeal (𝓞 F)
  rw [← image_asIdeal_primeFibre F p] at hfin
  exact hfin.of_finite_image HeightOneSpectrum.asIdeal_injective.injOn

p2m_export "LanglandsTunnell.CubicInduction.BadPlaceCoefficient" "primeFibre_finite"
private theorem finsum_fibre_ramificationIdx_mul_inertiaDeg (p : HeightOneSpectrum (𝓞 ℚ)) :
    ∑ᶠ 𝔓 ∈ primeFibre ℚ F p, p.asIdeal.ramificationIdx' 𝔓.asIdeal * p.asIdeal.inertiaDeg' 𝔓.asIdeal =
      Module.finrank ℚ F := by
  calc ∑ᶠ 𝔓 ∈ primeFibre ℚ F p, p.asIdeal.ramificationIdx' 𝔓.asIdeal * p.asIdeal.inertiaDeg' 𝔓.asIdeal
      = ∑ᶠ Q ∈ HeightOneSpectrum.asIdeal '' primeFibre ℚ F p,
          p.asIdeal.ramificationIdx' Q * p.asIdeal.inertiaDeg' Q :=
        (finsum_mem_image (f := fun Q : Ideal (𝓞 F) => p.asIdeal.ramificationIdx' Q * p.asIdeal.inertiaDeg' Q)
          HeightOneSpectrum.asIdeal_injective.injOn).symm
    _ = ∑ᶠ Q ∈ p.asIdeal.primesOver (𝓞 F), p.asIdeal.ramificationIdx' Q * p.asIdeal.inertiaDeg' Q := by
        rw [image_asIdeal_primeFibre]
    _ = ∑ Q ∈ IsDedekindDomain.primesOverFinset p.asIdeal (𝓞 F),
          p.asIdeal.ramificationIdx' Q * p.asIdeal.inertiaDeg' Q := by
        rw [← IsDedekindDomain.coe_primesOverFinset p.ne_bot (𝓞 F), finsum_mem_coe_finset]
    _ = Module.finrank ℚ F := Ideal.sum_ramification_inertia (𝓞 F) ℚ F p.ne_bot

private theorem _root_.LanglandsTunnell.CubicInduction.BadPlaceCoefficient.sum_toFinset_ramificationIdx_mul_inertiaDeg (p : HeightOneSpectrum (𝓞 ℚ)) :
    ∑ 𝔓 ∈ (primeFibre_finite F p).toFinset, p.asIdeal.ramificationIdx' 𝔓.asIdeal * p.asIdeal.inertiaDeg' 𝔓.asIdeal =
      Module.finrank ℚ F := by
  rw [← finsum_mem_eq_finite_toFinset_sum _ (primeFibre_finite F p)]
  exact finsum_fibre_ramificationIdx_mul_inertiaDeg F p

p2m_export "LanglandsTunnell.CubicInduction.BadPlaceCoefficient" "sum_toFinset_ramificationIdx_mul_inertiaDeg"
private theorem _root_.LanglandsTunnell.CubicInduction.BadPlaceCoefficient.inertiaDeg_pos_of_mem_primeFibre (p : HeightOneSpectrum (𝓞 ℚ)) (𝔓 : HeightOneSpectrum (𝓞 F))
    (h : 𝔓 ∈ primeFibre ℚ F p) : 0 < p.asIdeal.inertiaDeg' 𝔓.asIdeal := by
  have hu : 𝔓.under (𝓞 ℚ) = p := h
  haveI : 𝔓.asIdeal.LiesOver p.asIdeal := ⟨(congrArg HeightOneSpectrum.asIdeal hu).symm⟩
  haveI : p.asIdeal.IsMaximal := p.isMaximal
  exact Ideal.inertiaDeg'_pos p.asIdeal 𝔓.asIdeal

p2m_export "LanglandsTunnell.CubicInduction.BadPlaceCoefficient" "inertiaDeg_pos_of_mem_primeFibre"
private theorem _root_.LanglandsTunnell.CubicInduction.BadPlaceCoefficient.ramificationIdx_pos_of_mem_primeFibre (p : HeightOneSpectrum (𝓞 ℚ)) (𝔓 : HeightOneSpectrum (𝓞 F))
    (h : 𝔓 ∈ primeFibre ℚ F p) : 0 < p.asIdeal.ramificationIdx' 𝔓.asIdeal := by
  haveI : 𝔓.asIdeal.LiesOver p.asIdeal := (asIdeal_mem_primesOver_of_mem_primeFibre F p h).2
  exact Nat.pos_of_ne_zero (Ideal.IsDedekindDomain.ramificationIdx_ne_zero_of_liesOver 𝔓.asIdeal p.ne_bot)

p2m_export "LanglandsTunnell.CubicInduction.BadPlaceCoefficient" "ramificationIdx_pos_of_mem_primeFibre"
private theorem _root_.LanglandsTunnell.CubicInduction.BadPlaceCoefficient.natDegree_inducedFactor_le {R : Type*} [CommRing R] (c : HeightOneSpectrum (𝓞 F) → R)
    (𝔓 : HeightOneSpectrum (𝓞 F)) :
    (inducedFactor ℚ c 𝔓).natDegree ≤ (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal := by
  rw [inducedFactor]
  exact (natDegree_sub_le _ _).trans (max_le ((natDegree_C _).le.trans (Nat.zero_le _)) (natDegree_C_mul_X_pow_le _ _))

p2m_export "LanglandsTunnell.CubicInduction.BadPlaceCoefficient" "natDegree_inducedFactor_le"
private theorem natDegree_inducedFactor_eq_zero_of_eq_zero {R : Type*} [CommRing R] (c : HeightOneSpectrum (𝓞 F) → R)
    (𝔓 : HeightOneSpectrum (𝓞 F)) (hc : c 𝔓 = 0) : (inducedFactor ℚ c 𝔓).natDegree = 0 := by
  rw [inducedFactor, hc, C_0, zero_mul, sub_zero, natDegree_C]

private theorem natDegree_inducedEulerPoly_add_le {R : Type*} [CommRing R] (c : HeightOneSpectrum (𝓞 F) → R)
    (p : HeightOneSpectrum (𝓞 ℚ)) (𝔓₀ : HeightOneSpectrum (𝓞 F)) (h₀ : 𝔓₀ ∈ primeFibre ℚ F p) :
    (inducedEulerPoly ℚ c p).natDegree + p.asIdeal.ramificationIdx' 𝔓₀.asIdeal * p.asIdeal.inertiaDeg' 𝔓₀.asIdeal ≤
      (inducedFactor ℚ c 𝔓₀).natDegree + Module.finrank ℚ F := by
  classical
  have h₀T : 𝔓₀ ∈ (primeFibre_finite F p).toFinset := (Set.Finite.mem_toFinset _).2 h₀
  have hrest : (∏ 𝔓 ∈ (primeFibre_finite F p).toFinset.erase 𝔓₀, inducedFactor ℚ c 𝔓).natDegree ≤
      ∑ 𝔓 ∈ (primeFibre_finite F p).toFinset.erase 𝔓₀,
        p.asIdeal.ramificationIdx' 𝔓.asIdeal * p.asIdeal.inertiaDeg' 𝔓.asIdeal := by
    refine (natDegree_prod_le _ _).trans (Finset.sum_le_sum fun 𝔓 h𝔓 => ?_)
    have hmem : 𝔓 ∈ primeFibre ℚ F p := (Set.Finite.mem_toFinset _).1 (Finset.mem_of_mem_erase h𝔓)
    have hu : 𝔓.under (𝓞 ℚ) = p := hmem
    refine (natDegree_inducedFactor_le F c 𝔓).trans ?_
    rw [hu]
    exact Nat.le_mul_of_pos_left _ (ramificationIdx_pos_of_mem_primeFibre F p 𝔓 hmem)
  have hsplit : (inducedEulerPoly ℚ c p).natDegree ≤ (inducedFactor ℚ c 𝔓₀).natDegree +
      (∏ 𝔓 ∈ (primeFibre_finite F p).toFinset.erase 𝔓₀, inducedFactor ℚ c 𝔓).natDegree := by
    rw [inducedEulerPoly, finprod_mem_eq_finite_toFinset_prod _ (primeFibre_finite F p),
      ← Finset.mul_prod_erase (primeFibre_finite F p).toFinset (fun 𝔓 => inducedFactor ℚ c 𝔓) h₀T]
    exact natDegree_mul_le
  have hsum : p.asIdeal.ramificationIdx' 𝔓₀.asIdeal * p.asIdeal.inertiaDeg' 𝔓₀.asIdeal +
      ∑ 𝔓 ∈ (primeFibre_finite F p).toFinset.erase 𝔓₀,
        p.asIdeal.ramificationIdx' 𝔓.asIdeal * p.asIdeal.inertiaDeg' 𝔓.asIdeal =
      ∑ 𝔓 ∈ (primeFibre_finite F p).toFinset, p.asIdeal.ramificationIdx' 𝔓.asIdeal * p.asIdeal.inertiaDeg' 𝔓.asIdeal :=
    Finset.add_sum_erase (primeFibre_finite F p).toFinset
      (fun 𝔓 => p.asIdeal.ramificationIdx' 𝔓.asIdeal * p.asIdeal.inertiaDeg' 𝔓.asIdeal) h₀T
  rw [sum_toFinset_ramificationIdx_mul_inertiaDeg F p] at hsum
  rw [← hsum]
  omega

end

private theorem ringHom_ringOfIntegers_rat_ext {S : Type*} [Ring S] (f g : 𝓞 ℚ →+* S) : f = g := by
  have h : f.comp (Rat.ringOfIntegersEquiv.symm : ℤ →+* 𝓞 ℚ) = g.comp (Rat.ringOfIntegersEquiv.symm : ℤ →+* 𝓞 ℚ) :=
    Subsingleton.elim _ _
  ext x
  have hx : x = (Rat.ringOfIntegersEquiv.symm : ℤ →+* 𝓞 ℚ) (Rat.ringOfIntegersEquiv x) :=
    (Rat.ringOfIntegersEquiv.symm_apply_apply x).symm
  rw [hx]
  exact RingHom.congr_fun h _

private theorem algebra_ringOfIntegers_rat_eq (L : Type) [Field L] [NumberField L] (i : Algebra (𝓞 ℚ) (𝓞 L)) :
    i = NumberField.inst_ringOfIntegersAlgebra ℚ L :=
  Algebra.algebra_ext i (NumberField.inst_ringOfIntegersAlgebra ℚ L) fun r =>
    RingHom.congr_fun
      (ringHom_ringOfIntegers_rat_ext (@algebraMap (𝓞 ℚ) (𝓞 L) _ _ i)
        (@algebraMap (𝓞 ℚ) (𝓞 L) _ _ (NumberField.inst_ringOfIntegersAlgebra ℚ L))) r

section

variable (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

private theorem inducedE3_inducedCoeff_eq_zero_of_isBadPlace (hdeg : Module.finrank ℚ K = 3)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ)) (hbad : IsBadPlace K μ v) :
    inducedE3 ℚ (inducedCoeff K μ) v = 0 := by
  obtain rfl := algebra_ringOfIntegers_rat_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  suffices hlt : (inducedEulerPoly ℚ (inducedCoeff K μ) v).natDegree < 3 by
    rw [inducedE3, coeff_eq_zero_of_natDegree_lt hlt, neg_zero]
  rcases hbad with ⟨𝔓, h𝔓, he⟩ | ⟨𝔓, h𝔓, hram⟩
  · have hbound := natDegree_inducedEulerPoly_add_le K (inducedCoeff K μ) v 𝔓 h𝔓
    have hfac := natDegree_inducedFactor_le K (inducedCoeff K μ) 𝔓
    have hu : 𝔓.under (𝓞 ℚ) = v := h𝔓
    rw [hu] at hfac
    have hf := inertiaDeg_pos_of_mem_primeFibre K v 𝔓 h𝔓
    have he2 : 2 ≤ v.asIdeal.ramificationIdx' 𝔓.asIdeal := by
      have := ramificationIdx_pos_of_mem_primeFibre K v 𝔓 h𝔓
      omega
    have hef : 2 * v.asIdeal.inertiaDeg' 𝔓.asIdeal ≤
        v.asIdeal.ramificationIdx' 𝔓.asIdeal * v.asIdeal.inertiaDeg' 𝔓.asIdeal :=
      Nat.mul_le_mul he2 le_rfl
    rw [hdeg] at hbound
    omega
  · have hbound := natDegree_inducedEulerPoly_add_le K (inducedCoeff K μ) v 𝔓 h𝔓
    have hc : inducedCoeff K μ 𝔓 = 0 := by
      rw [inducedCoeff, if_neg hram]
    rw [natDegree_inducedFactor_eq_zero_of_eq_zero K (inducedCoeff K μ) 𝔓 hc, hdeg] at hbound
    have hef : 0 < v.asIdeal.ramificationIdx' 𝔓.asIdeal * v.asIdeal.inertiaDeg' 𝔓.asIdeal :=
      Nat.mul_pos (ramificationIdx_pos_of_mem_primeFibre K v 𝔓 h𝔓) (inertiaDeg_pos_of_mem_primeFibre K v 𝔓 h𝔓)
    omega

private theorem not_isBadPlace_of_isInducedSphericalAt_of_apply_one_eq_one (hdeg : Module.finrank ℚ K = 3)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ)) (U : Subgroup (LocalGL3 v))
    (W : LocalGL3 v → ℂ) (hW : IsInducedSphericalAt (inducedCoeff K μ) v U W) (hone : W 1 = 1) :
    ¬ IsBadPlace K μ v := by
  intro hbad
  have hcentral := hW.2.2.2 (centralGen v)⁻¹
  rw [mul_inv_cancel, inducedE3_inducedCoeff_eq_zero_of_isBadPlace K hdeg μ v hbad, zero_mul, hone] at hcentral
  exact one_ne_zero hcentral

end

end LanglandsTunnell.CubicInduction.BadPlaceCoefficient

