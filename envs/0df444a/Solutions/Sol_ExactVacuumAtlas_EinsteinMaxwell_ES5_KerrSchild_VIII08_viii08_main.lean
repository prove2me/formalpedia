  have hb : ContinuousOn (beta j q) (Icc (0:ℝ) aG) := continuousOn_beta (j := j) hqc hq hAq
  have hr' : ContinuousOn r (Icc (0:ℝ) aG) := hr.mono KG_subset_UG
  have hid : ContinuousOn (fun t : ℝ => t) (Icc (0:ℝ) aG) := continuousOn_id
  unfold Gfun
  refine hid.mul ?_
  refine (continuousOn_const.add (hb.const_mul 6)).sub (hid.mul hr')

/-! ## The derivative of `v` -/

theorem deriv_vfun {j Aq : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG) {R : ℝ} (hR : 3 < R) :
    deriv (vfun j q r) R = -(1 / R ^ 2) * Gfun j q r (1 / R) :=
  (hasDerivAt_vfun (j := j) hqc hq hAq hr hR).deriv

/-! ## Continuity of `v` and the endpoint class `VClass 3` -/

theorem tendsto_vfun_three {j Aq : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG) :
    ∃ L : ℝ, Tendsto (vfun j q r) (𝓝[>] (3:ℝ)) (𝓝 L) := by
  refine ⟨∫ t in (0:ℝ)..aG, Gfun j q r t, ?_⟩
  have hcont : ContinuousOn (Gfun j q r) (Icc (0:ℝ) aG) :=
    continuousOn_Gfun (j := j) hqc hq hAq hr
  have hint : IntegrableOn (Gfun j q r) (Icc (0:ℝ) aG) volume := hcont.integrableOn_Icc
  have hprim := continuousOn_primitive (μ := volume) (E := ℝ) (f := Gfun j q r) (a := (0:ℝ)) (b := aG)
    hint
  have hprim' : ContinuousWithinAt (fun u : ℝ => ∫ t in (0:ℝ)..u, Gfun j q r t) (Icc (0:ℝ) aG) aG := by
    refine (hprim.congr ?_).continuousWithinAt ⟨by have ha : aG = 1 / 3 := rfl; rw [ha]; norm_num, le_rfl⟩
    intro x hx
    exact intervalIntegral.integral_of_le (μ := volume) (f := Gfun j q r) hx.1
  exact hprim'.tendsto.comp tendsto_one_div_Icc_aG

/-! ## The two sharp bounds for `v` -/

/-! ## `v ∈ VClass 3` -/

theorem contDiffOn_one_vfun {j Aq : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG) :
    ContDiffOn ℝ 1 (vfun j q r) (Ioi (3:ℝ)) := by
  have hcont : ContinuousOn (Gfun j q r) (Icc (0:ℝ) aG) :=
    continuousOn_Gfun (j := j) hqc hq hAq hr
  have hG : ContinuousOn (fun R : ℝ => -(1 / R ^ 2) * Gfun j q r (1 / R)) (Ioi (3:ℝ)) := by
    have hinv : ContinuousOn (fun R : ℝ => -(1 / R ^ 2)) (Ioi (3:ℝ)) := by
      refine ContinuousOn.neg ?_
      exact ContinuousOn.div continuousOn_const (continuousOn_id.pow 2)
        (fun x hx => (pow_pos (by linarith [mem_Ioi.mp hx] : (0:ℝ) < x) 2).ne')
    have hcomp : ContinuousOn (fun R : ℝ => Gfun j q r (1 / R)) (Ioi (3:ℝ)) :=
      (hcont.mono Ioo_subset_Icc_self).comp contDiffOn_two_one_div_Ioi.continuousOn
        mapsTo_one_div_Ioi
    exact hinv.mul hcomp
  refine (contDiffOn_succ_iff_deriv_of_isOpen (n := 0) (f := vfun j q r) (s := Ioi (3:ℝ))
    (𝕜 := ℝ) isOpen_Ioi).mpr ⟨?_, fun h => absurd h (by norm_num), ?_⟩
  · intro x hx
    exact (hasDerivAt_vfun (j := j) hqc hq hAq hr (mem_Ioi.mp hx)).differentiableAt
      |>.differentiableWithinAt
  · rw [contDiffOn_zero]
    exact hG.congr (fun x hx => deriv_vfun (j := j) hqc hq hAq hr (mem_Ioi.mp hx))

theorem vClass_vfun {j Aq Ar : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG)
    (hrb : ∀ x ∈ KG, |r x| ≤ Ar) (hAr : 0 ≤ Ar) :
    VClass 3 (vfun j q r) :=
  ⟨contDiffOn_one_vfun (j := j) hqc hq hAq hr,
    tendsto_vfun_three (j := j) hqc hq hAq hr,
    tendsto_vfun_atTop (j := j) hqc hq hAq hr hrb hAr⟩

