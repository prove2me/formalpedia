theorem invT_lt {q : ℕ} (hq : 0 < q) (r : ℕ) : invT q r < q := by
  unfold invT
  rcases h : (List.range q).find? (fun t => (r * t + 1) % q = 0) with _ | t
  · simpa using hq
  · simpa using List.mem_range.1 (List.mem_of_find?_eq_some h)

theorem invT_spec {q r : ℕ} (hq : 0 < q) (hr : Nat.Coprime r q) :
    invT q r < q ∧ q ∣ r * invT q r + 1 := by
  -- existence of an inverse of `r` mod `q`
  have hex : ∃ t ∈ List.range q, (fun t => decide ((r * t + 1) % q = 0)) t = true := by
    by_cases hq1 : q = 1
    · subst hq1; exact ⟨0, by simp, by simp⟩
    have hq2 : 1 < q := by omega
    have : NeZero q := ⟨by omega⟩
    have hu : IsUnit (r : ZMod q) := (ZMod.unitOfCoprime r hr).isUnit
    obtain ⟨u, hu'⟩ := hu
    set t := (-(u⁻¹ : (ZMod q)ˣ) : ZMod q).val
    refine ⟨t, List.mem_range.2 (ZMod.val_lt _), ?_⟩
    simp only [decide_eq_true_eq]
    rw [← Nat.dvd_iff_mod_eq_zero, ← ZMod.natCast_eq_zero_iff]
    push_cast
    simp only [t, ZMod.natCast_val, ZMod.cast_id', id]
    rw [← hu']
    simp
  obtain ⟨t, ht, hpt⟩ := hex
  have hf : ((List.range q).find? (fun t => decide ((r * t + 1) % q = 0))).isSome := by
    rw [List.find?_isSome]; exact ⟨t, ht, hpt⟩
  obtain ⟨t', ht'⟩ := Option.isSome_iff_exists.1 hf
  have h1 := List.find?_some ht'
  have h2 := List.mem_of_find?_eq_some ht'
  simp only [invT, ht', Option.getD_some]
  simp only [decide_eq_true_eq] at h1
  exact ⟨List.mem_range.1 h2, Nat.dvd_of_mod_eq_zero h1⟩

theorem selL_regs (e : Ex HS) : ∀ k vs, ∀ r ∈ (selL e k vs).regs, r ∈ e.regs
  | _, [], r, h => by simp [selL, Ex.regs] at h
  | k, v :: vs, r, h => by
    simp only [selL, Ex.regs, List.mem_append, List.append_nil, List.not_mem_nil, or_false] at h
    rcases h with h | h
    · exact h
    · exact selL_regs e (k + 1) vs r h

/-- Facts on `selL`: if `e` evaluates to `k + j` with `j < |vs|`, the value is `vs[j]`. -/
theorem selL_facts {s : IState HS} {e : Ex HS} {B : ℕ} (hok : e.ok s) (hB : e.Bnd s B) :
    ∀ (k j : ℕ) (vs : List ℤ), (∀ v ∈ vs, zsz v ≤ B) → j < vs.length →
      e.eval s = (k + j : ℕ) → zsz ((k + vs.length + 1 : ℕ) : ℤ) ≤ B →
      (selL e k vs).ok s ∧ (selL e k vs).eval s = vs[j]! ∧ (selL e k vs).Bnd s B
  | _, _, [], _, h, _, _ => by simp at h
  | k, j, v :: vs, hv, hj, he, hz => by
    have hzk : ∀ x : ℕ, x ≤ k + (vs.length + 1) + 1 → zsz (x : ℤ) ≤ B := fun x hx =>
      le_trans (NLogN.KIL.zsz_nat_le (by simpa using hx)) hz
    have hcB : (Ex.add e (.lit (-((k : ℤ) + 1)))).Bnd s B := by
      refine ⟨hB, ?_, ?_⟩
      · simp only [Ex.Bnd, zsz_neg]
        have := hzk (k + 1) (by omega); push_cast at this; exact this
      · simp only [Ex.eval, he]
        have : ((k + j : ℕ) : ℤ) + -((k : ℤ) + 1) = (j : ℤ) - 1 := by push_cast; ring
        rw [this]
        rcases Nat.eq_zero_or_pos j with h0 | h0
        · subst h0; simp only [Nat.cast_zero, zero_sub, zsz_neg]
          have := hzk 1 (by omega); simpa using this
        · have : (j : ℤ) - 1 = ((j - 1 : ℕ) : ℤ) := by push_cast [Nat.cast_sub h0]; ring
          rw [this]; exact hzk _ (by simp at hj; omega)
    have hc : (Ex.add e (.lit (-((k : ℤ) + 1)))).eval s = (j : ℤ) - 1 := by
      simp only [Ex.eval, he]; push_cast; ring
    rcases Nat.eq_zero_or_pos j with h0 | h0
    · subst h0
      have hneg : (Ex.add e (.lit (-((k : ℤ) + 1)))).eval s < 0 := by rw [hc]; norm_num
      refine ⟨⟨⟨hok, trivial⟩, by simp only [hneg, if_true]; trivial⟩, ?_, ⟨hcB, ?_⟩⟩
      · have h' := hneg; simp only [Ex.eval] at h'
        simp only [selL, Ex.eval]; simp only [h', if_true]; rfl
      · simp only [hneg, if_true, Ex.Bnd]; exact hv v List.mem_cons_self
    · have hneg : ¬ (Ex.add e (.lit (-((k : ℤ) + 1)))).eval s < 0 := by rw [hc]; omega
      have IH := selL_facts hok hB (k + 1) (j - 1) vs (fun w hw => hv w (List.mem_cons_of_mem _ hw))
        (by simp at hj; omega) (by rw [he]; congr 1; omega)
        (le_trans (NLogN.KIL.zsz_nat_le (by simp; omega)) hz)
      refine ⟨⟨⟨hok, trivial⟩, by simp only [hneg, if_false]; exact IH.1⟩, ?_, ⟨hcB, ?_⟩⟩
      · have h' := hneg; simp only [Ex.eval] at h'
        simp only [selL, Ex.eval]; simp only [h', if_false, IH.2.1]
        obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
        simp
      · simp only [hneg, if_false]; exact IH.2.2

theorem coprime_mod_of {N q : ℕ} (h : Nat.Coprime N q) : Nat.Coprime (N % q) q := by
  unfold Nat.Coprime; rw [← Nat.gcd_rec, Nat.gcd_comm]; exact h

theorem invE_regs (q : ℕ) : ∀ r ∈ (invE q).regs, r = sQQ := by
  intro r hr
  have key : r = sQQ ∨ r ∈ (selL (.nmod (.reg sQQ) (.lit (q : ℤ))) 0 (tTab q)).regs := by
    simp only [invE, Ex.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
      or_false] at hr
    tauto
  rcases key with h | h
  · exact h
  · have := selL_regs _ 0 _ r h
    simp only [Ex.regs, List.mem_append, List.mem_singleton, List.not_mem_nil, or_false] at this
    exact this

theorem ctrlE_regs (p : ℤ) (q : ℕ) : ∀ r ∈ (ctrlE p q).regs, r = sQQ := by
  intro r hr
  have key : r = sQQ ∨ r ∈ (invE q).regs := by
    simp only [ctrlE, Ex.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
      or_false] at hr
    tauto
  rcases key with h | h
  · exact h
  · exact invE_regs q r h

/-- Facts on the inverse: value `x` with `x·q = N·t + 1`, `x ≤ N`. -/
theorem invE_facts {s : IState HS} {N q Bb : ℕ} {L : List Item} (hN : s.G sQQ = .int N :: L)
    (hN1 : 1 ≤ N) (hq : 1 ≤ q) (hcop : Nat.Coprime N q)
    (hB : zsz (((q + 1) * (N + 1) : ℕ) : ℤ) ≤ Bb) :
    ∃ x : ℕ, (invE q).ok s ∧ (invE q).eval s = x ∧ (invE q).Bnd s Bb ∧ x ≤ N ∧
      (x * q) % N = 1 % N := by
  have eN : s.top sQQ = (N : ℤ) := IState.top_eq hN
  set r := N % q
  have hr : r < q := Nat.mod_lt _ (by omega)
  obtain ⟨ht, hdiv⟩ := invT_spec (q := q) (r := r) (by omega) (coprime_mod_of hcop)
  set t := invT q r
  have hle : ∀ x : ℕ, x ≤ (q + 1) * (N + 1) → zsz (x : ℤ) ≤ Bb := fun x hx =>
    le_trans (NLogN.KIL.zsz_nat_le hx) hB
  have hNq : N ≤ (q + 1) * (N + 1) := by nlinarith
  have hqq : q + 1 ≤ (q + 1) * (N + 1) := by nlinarith
  -- the selection
  have hmod : (Ex.nmod (.reg sQQ) (.lit (q : ℤ))).eval s = ((0 + r : ℕ) : ℤ) := by
    simp only [Ex.eval, eN, zero_add]; push_cast; rfl
  have hmok : (Ex.nmod (.reg sQQ) (.lit (q : ℤ))).ok s :=
    ⟨IState.isInt_of hN, trivial, by simp only [Ex.eval, eN]; positivity, by
      simp only [Ex.eval]; exact_mod_cast hq⟩
  have hmB : (Ex.nmod (.reg sQQ) (.lit (q : ℤ))).Bnd s Bb := by
    refine ⟨by simp only [Ex.Bnd, eN]; exact hle N hNq, hle q (by omega), ?_⟩
    show zsz (Ex.eval s (Ex.nmod (.reg sQQ) (.lit (q : ℤ)))) ≤ Bb
