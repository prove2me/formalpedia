theorem contract2_congr {T T' : Fin 5 → Fin 5 → Pt 5 → ℝ} {x : Pt 5}
    (h : ∀ i j, T i j x = T' i j x) (k : Fin 5 → ℝ) : contract2 T x k = contract2 T' x k := by
  unfold contract2; simp only [h]

end Helpers

/-! ## Transfer to the background -/

section Transfer

variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {gb gbi : Metric 5} {v : Pt 5 → ℝ}
  {K : Pt 5 → Fin 5 → ℝ} {U : Set (Pt 5)}

/-- Actual Einstein–Maxwell equations at a domain point, from the actual `PaperBVP`
(`reducedSystem_of_paperBVP` + `Generic.field_equations_iff`). -/
theorem einstein_of_paperBVP {Q J : ℝ} (hP : PaperData I f m N w p a)
    (hB : PaperBVP I f m N w p a Q J) {x : Pt 5} (hx : x ∈ esDomain I) :
    ∀ i j, einsteinMaxwellD (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
      (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (esFaraday p a) i j x = 0 :=
  ((Generic.field_equations_iff hP.toESData x hx).mpr (reducedSystem_of_paperBVP hP hB (x 1) hx.1)).1

/-- Actual candidate nullity of `K` on `U`, derived from KS nullity and the representation. -/
theorem es_null_of_ks (hD : KSData gb gbi v K U)
    (hrep : ∀ i j, Set.EqOn (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w i j)
      (ksMetric gb v K i j) U) {x : Pt 5} (hx : x ∈ U) :
    contract2 (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) x (K x) = 0 := by
  rw [contract2_congr (fun i j => hrep i j hx)]
  exact hD.ks_null hx

/-- `Ric_gb(K,K) = Ric_gA(K,K)` at a point of `U` where `K` is actually background-pregeodesic. -/
theorem background_ricci_eq_actual (hP : PaperData I f m N w p a) (hUI : U ⊆ esDomain I)
    (hD : KSData gb gbi v K U)
