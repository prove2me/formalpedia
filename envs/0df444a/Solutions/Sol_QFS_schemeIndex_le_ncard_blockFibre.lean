open QFS

variable {d : ℕ}

/-- A block's majority set has at least `a` points. -/
theorem solution {Γ : QFS.Configuration (EuclideanSpace ℝ (Fin d))}
    {Δ L : ℕ} (hL : 0 < L) (hΔ : 1 ≤ Δ)
    (htypes : ∀ B : Set (EuclideanSpace ℝ (Fin d)), (Γ '' B).ncard ≤ L)
    {m : ℕ} {c : EuclideanSpace ℝ (Fin d)} (hc : c ∈ QFS.lattice d)
    {V : QFS.DCone (EuclideanSpace ℝ (Fin d))} (hV : QFS.FavoredIn Γ (QFS.block ((Δ:ℝ) ^ m) c) V) :
    QFS.schemeIndex Δ L d m ≤ (QFS.blockFibre Γ (QFS.block ((Δ:ℝ) ^ m) c) V).ncard := by
  have hΔR : (1:ℝ) ≤ (Δ : ℝ) := by exact_mod_cast hΔ
  have hℓ : (1:ℝ) ≤ (Δ:ℝ) ^ m := one_le_pow₀ hΔR
  have hQfin : (QFS.block ((Δ:ℝ) ^ m) c).Finite := QFS.block_finite (by linarith) c
  have hFfin : (QFS.blockFibre Γ (QFS.block ((Δ:ℝ) ^ m) c) V).Finite := hQfin.subset (fun _ h => h.1)
  -- the majority set is nonempty
  have hFne : 1 ≤ (QFS.blockFibre Γ (QFS.block ((Δ:ℝ) ^ m) c) V).ncard := by
    obtain ⟨p, hp⟩ := QFS.block_nonempty hℓ c
    have h1 : (1 : ℕ∞) ≤ (QFS.blockFibre Γ (QFS.block ((Δ:ℝ) ^ m) c) (Γ p)).encard :=
      Set.one_le_encard_iff_nonempty.mpr ⟨p, hp, rfl⟩
    have h2 : (1 : ℕ∞) ≤ (QFS.blockFibre Γ (QFS.block ((Δ:ℝ) ^ m) c) V).encard :=
      le_trans h1 (hV (Γ p))
    rw [← hFfin.cast_ncard_eq] at h2
    exact_mod_cast h2
  -- and it carries at least a `1/L` share of the block
  have hpig : (QFS.block ((Δ:ℝ) ^ m) c).ncard
      ≤ L * (QFS.blockFibre Γ (QFS.block ((Δ:ℝ) ^ m) c) V).ncard :=
    QFS.ncard_le_mul_ncard_blockFibre hQfin hV (htypes _)
  have hbig : Δ ^ (m * d) ≤ (QFS.block ((Δ:ℝ) ^ m) c).ncard := by
    have hcast : (((Δ ^ m : ℕ)) : ℝ) = (Δ:ℝ) ^ m := by push_cast; ring
    have h1 : (((Δ ^ m) ^ d : ℕ) : ℕ∞) ≤ (QFS.block ((Δ:ℝ) ^ m) c).encard := by
      have := QFS.le_encard_block (d := d) (ℓ := Δ ^ m) hc
      rwa [hcast] at this
    rw [← hQfin.cast_ncard_eq] at h1
    have h2 : (Δ ^ m) ^ d ≤ (QFS.block ((Δ:ℝ) ^ m) c).ncard := by exact_mod_cast h1
    rwa [← pow_mul] at h2
  exact QFS.schemeIndex_le hL hFne (le_trans hbig hpig)
