    (hR : s.G pR = .int (2 ^ Δ) :: LR) (hX : s.G nX = .int (B.length : ℤ) :: LX)
    (hX2 : s.G nX2 = .int ((2 * B.length : ℕ) : ℤ) :: LX2) (hN : s.G rN = .int (A.length : ℤ) :: LN)
