set_option autoImplicit false
variable {I : Set ℝ} {f m N w p a F b A : ℝ → ℝ} {s h ε Q J : ℝ}
theorem solution (hS : FiniteBranch6 I s ε f m a F b A) (h Q : ℝ)
    (hQ : Q ≠ 0) :
    ∃ δ : ℝ, 0 < δ ∧ δ ≤ ε ∧ ∀ x ∈ Set.Ioo (-δ) δ,
      0 < F x ∧ 0 < b x ∧ 0 < 1 - h * x ∧ 0 < alphaCore Q h F b A x := by
  have hnh : Set.Ioo (-ε) ε ∈ 𝓝 (0 : ℝ) := Ioo_mem_nhds (by linarith [hS.eps_pos]) hS.eps_pos
  have cF : ContinuousAt F 0 := (hS.cF.contDiffAt hnh).continuousAt
  have cb : ContinuousAt b 0 := (hS.cb.contDiffAt hnh).continuousAt
  have cA : ContinuousAt (deriv A) 0 :=
    (hS.cA.continuousOn_deriv_of_isOpen isOpen_Ioo (by norm_num)).continuousAt hnh
  have cu : ContinuousAt (fun x : ℝ => 1 - h * x) 0 := by fun_prop
  have cD := continuousAt_alphaCore Q h cF cb cA
  have hQ2 : 0 < Q ^ 2 := lt_of_le_of_ne (sq_nonneg Q) (Ne.symm (pow_ne_zero 2 hQ))
  have ev := (cF.eventually (lt_mem_nhds (show (0 : ℝ) < F 0 by rw [hS.F0]; norm_num))).and
    ((cb.eventually (lt_mem_nhds (show (0 : ℝ) < b 0 by rw [hS.b0]; norm_num))).and
      ((cu.eventually (lt_mem_nhds (show (0 : ℝ) < 1 - h * 0 by norm_num))).and
        (cD.eventually (lt_mem_nhds (show (0 : ℝ) < alphaCore Q h F b A 0 by
          rw [alphaCore_zero Q h b A hS.F0]; exact hQ2)))))
  obtain ⟨δ', hδ', hall⟩ := Metric.eventually_nhds_iff.mp ev
  refine ⟨min δ' ε, lt_min hδ' hS.eps_pos, min_le_right _ _, fun x hx => ?_⟩
  have hd : dist x 0 < δ' := by
    rw [Real.dist_eq, sub_zero, abs_lt]
    constructor <;> linarith [hx.1, hx.2, min_le_left δ' ε]
  obtain ⟨h1, h2, h3, h4⟩ := hall hd
  exact ⟨h1, h2, h3, h4⟩
