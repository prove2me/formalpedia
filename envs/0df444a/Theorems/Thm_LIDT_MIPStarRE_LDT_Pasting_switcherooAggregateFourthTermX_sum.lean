/-! ### Shared switcheroo contraction helper definitions -/

lemma LIDT.MIPStarRE.LDT.Pasting.switcherooAggregateFourthTermX_sum
    {Outcome : Type*} [Fintype Outcome]
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters) [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    (family : _root_.LIDT.MIPStarRE.LDT.IdxPolyFamily params ι)
    (M : _root_.LIDT.MIPStarRE.LDT.IdxProjSubMeas (_root_.LIDT.MIPStarRE.LDT.Fq params) Outcome ι)
    (q : _root_.LIDT.MIPStarRE.LDT.Pasting.SlicePairQuestion params) :
    ∑ g : _root_.LIDT.MIPStarRE.LDT.Polynomial params, _root_.LIDT.MIPStarRE.LDT.Pasting.switcherooAggregateFourthTermX params family M q g =
      ∑ o : Outcome,
        (M q.2).outcome o * (_root_.LIDT.MIPStarRE.LDT.Pasting.completePartSubMeas params family q.1).total * (M q.2).outcome o := by sorry
