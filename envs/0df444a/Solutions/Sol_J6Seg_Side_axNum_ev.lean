section ar
variable (p d s : ℕ)

/-- `2^⌈log₂ m⌉ ≤ 2m + 1`. -/
theorem pow_clog_le (m : ℕ) : 2 ^ Nat.clog 2 m ≤ 2 * m + 1 := by
  rcases Nat.lt_or_ge 1 m with h | h
  · have h1 := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) h
    have hc : 0 < Nat.clog 2 m := Nat.clog_pos (by norm_num) h
    have e : 2 ^ Nat.clog 2 m = 2 * 2 ^ (Nat.clog 2 m).pred := by
      rw [← pow_succ']; congr 1; exact (Nat.succ_pred_eq_of_pos hc).symm
    omega
  · have : Nat.clog 2 m = 0 := Nat.clog_of_right_le_one h 2
    rw [this]; omega

end ar

end J6Seg.Val

