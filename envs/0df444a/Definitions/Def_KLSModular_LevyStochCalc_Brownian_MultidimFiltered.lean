open MeasureTheory ProbabilityTheory
namespace LevyStochCalc
namespace Brownian
universe u
variable {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {d : ℕ}
/-- The σ-algebra generated by all the values of a Brownian motion. -/
noncomputable abbrev sigmaBrownian (W : BrownianMotion P) : MeasurableSpace Ω :=
  ⨆ t, MeasurableSpace.comap (W.W t) inferInstance
namespace Multidim
namespace MultidimBrownianMotion
/-- The joint natural filtration `⨆ i, ℱ^{Wⁱ}` of a multidimensional Brownian motion. -/
noncomputable def naturalFiltration (W : MultidimBrownianMotion P d) :
    Filtration ℝ ‹MeasurableSpace Ω› :=
  ⨆ i, Martingale.naturalFiltration (W.W i)
end MultidimBrownianMotion
end Multidim
end Brownian
end LevyStochCalc


