theorem NLogN.KFM.chirpB_runs {M : MulSpec} {pM : Fin P} (hM : MulOK I iprog pM M)
    (hdom : ∀ x y, M.dom x y) {w φ : ℕ} (hΦ : ∀ x y : ℤ, zsz x ≤ w → zsz y ≤ w → M.Φ x y ≤ φ)
    (Δ : ℕ) (s : IState HS) (h g c : GI) (R0 RH RK LR : List Item)
    (h0 : s.G 0 = .int g.1 :: .int g.2 :: R0) (hH : s.G pH = .int h.1 :: .int h.2 :: RH)
    (hK : s.G pK = .int c.1 :: .int c.2 :: RK) (hR : s.G pR = .int (2 ^ Δ) :: LR)
    (hg : GBnd w g) (hh : GBnd w h) (hc : GBnd w c) (hg' : GBnd w (gmulT Δ g h))
    (hh' : GBnd w (gmulT Δ h c)) :
    IRuns I iprog (chirpB pM) s
      (((s.upd 0 (.int (gmulT Δ g h).1 :: .int (gmulT Δ g h).2 :: R0)).upd pH
        (.int (gmulT Δ h c).1 :: .int (gmulT Δ h c).2 :: RH)).upd pV
        (.int g.1 :: .int g.2 :: s.G pV)) (cChirpB φ w Δ) := by sorry
