theorem QEC.Distillation.HH18Parameterized.endpointWeights_sum {w r m : Nat}
    (h : Admissible w r m) (hdegree : 3 * r < m)
    (inputs : ResourceInput (physicalInputCount m w) QubitSpace) :
    endpointWeight h hdegree inputs .accepted +
      endpointWeight h hdegree inputs .rejected = 1 := by sorry
