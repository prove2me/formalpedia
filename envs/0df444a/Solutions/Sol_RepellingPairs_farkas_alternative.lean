variable {κ : Type*} [Fintype κ] {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The cone generated by finitely many vectors. -/
def coneSet (v : κ → E) : Set E :=
  {w | ∃ x : κ → ℝ, (∀ i, 0 ≤ x i) ∧ w = ∑ i, x i • v i}

/-- The cone generated by the vectors indexed by `S`. -/
def coneOn (v : κ → E) (S : Finset κ) : Set E :=
  {w | ∃ x : κ → ℝ, (∀ i, 0 ≤ x i) ∧ (∀ i, i ∉ S → x i = 0) ∧ w = ∑ i, x i • v i}

theorem coneSet_convex (v : κ → E) : Convex ℝ (coneSet v) := by
  intro w₁ ⟨x₁, hx₁, hw₁⟩ w₂ ⟨x₂, hx₂, hw₂⟩ a b ha hb _
  refine ⟨fun i => a * x₁ i + b * x₂ i, fun i => by have := hx₁ i; have := hx₂ i; positivity, ?_⟩
  subst hw₁ hw₂
  simp [Finset.smul_sum, Finset.sum_add_distrib, add_smul, mul_smul]

theorem coneSet_smul (v : κ → E) {w : E} (hw : w ∈ coneSet v) {c : ℝ} (hc : 0 ≤ c) :
    c • w ∈ coneSet v := by
  obtain ⟨x, hx, rfl⟩ := hw
  refine ⟨fun i => c * x i, fun i => by have := hx i; positivity, ?_⟩
  simp [Finset.smul_sum, mul_smul]

theorem gen_mem [DecidableEq κ] (v : κ → E) (j : κ) : v j ∈ coneSet v :=
  ⟨fun i => if i = j then 1 else 0, fun i => by dsimp only; split_ifs <;> norm_num, by simp [ite_smul]⟩

theorem coneSet_zero (v : κ → E) : (0 : E) ∈ coneSet v :=
  ⟨fun _ => 0, fun _ => le_rfl, by simp⟩

/-- Carathéodory for cones: a minimal-support representation has linearly independent support. -/
theorem exists_indep_rep [DecidableEq κ] (v : κ → E) {w : E} (hw : w ∈ coneSet v) :
    ∃ S : Finset κ, LinearIndependent ℝ (fun i : S => v i) ∧ w ∈ coneOn v S := by
  classical
  have hex : ∃ n, ∃ x : κ → ℝ, (∀ i, 0 ≤ x i) ∧ w = ∑ i, x i • v i ∧
      (Finset.univ.filter (fun i => x i ≠ 0)).card = n := by
    obtain ⟨x, hx, h⟩ := hw
    exact ⟨_, x, hx, h, rfl⟩
  obtain ⟨x, hx, hwx, hcard⟩ := Nat.find_spec hex
  set S := Finset.univ.filter (fun i => x i ≠ 0) with hS
  have hxS : ∀ i, i ∉ S → x i = 0 := by
    intro i hi
    simpa [hS] using hi
  refine ⟨S, ?_, ⟨x, hx, hxS, hwx⟩⟩
  by_contra hdep
  rw [Fintype.not_linearIndependent_iff] at hdep
  obtain ⟨g, hg, i₁, hi₁⟩ := hdep
  -- extend to κ
  let y₀ : κ → ℝ := fun i => if h : i ∈ S then g ⟨i, h⟩ else 0
  have hy₀sum : ∑ i, y₀ i • v i = 0 := by
    rw [← hg]
    rw [← Finset.sum_subset (Finset.subset_univ S)]
    · rw [← Finset.sum_coe_sort S]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp [y₀]
    · intro i _ hi
      simp [y₀, hi]
  have hy₀ne : ∃ i, y₀ i ≠ 0 := ⟨i₁, by simpa [y₀] using hi₁⟩
  -- WLOG some coordinate positive
  obtain ⟨y, hysum, hypos, hyS⟩ : ∃ y : κ → ℝ, ∑ i, y i • v i = 0 ∧ (∃ i, 0 < y i) ∧
      ∀ i, i ∉ S → y i = 0 := by
    obtain ⟨i, hi⟩ := hy₀ne
    have hy₀S : ∀ i, i ∉ S → y₀ i = 0 := fun i hi => by simp [y₀, hi]
    rcases lt_or_gt_of_ne hi with h | h
    · refine ⟨fun i => - y₀ i, ?_, ⟨i, by simpa using h⟩, fun i hi => by simp [hy₀S i hi]⟩
      simp [neg_smul, hy₀sum]
    · exact ⟨y₀, hy₀sum, ⟨i, h⟩, hy₀S⟩
  obtain ⟨i₂, hi₂⟩ := hypos
  let T := Finset.univ.filter (fun i => 0 < y i)
  have hT : T.Nonempty := ⟨i₂, by simp [T, hi₂]⟩
  obtain ⟨i₀, hi₀T, hmin⟩ := Finset.exists_min_image T (fun i => x i / y i) hT
  have hi₀ : 0 < y i₀ := by simpa [T] using hi₀T
  set t := x i₀ / y i₀ with ht
  have ht0 : 0 ≤ t := div_nonneg (hx _) hi₀.le
  have hx' : ∀ i, 0 ≤ x i - t * y i := by
    intro i
    by_cases hyi : 0 < y i
    · have := hmin i (by simp [T, hyi])
      rw [le_div_iff₀ hyi] at this
      simp only [ht] at *
      linarith
    · have : y i ≤ 0 := not_lt.mp hyi
      have := hx i
      nlinarith
  have hi₀S : i₀ ∈ S := by
    by_contra h
    have := hyS i₀ h
    linarith
  have hsum' : w = ∑ i, (x i - t * y i) • v i := by
    have : ∑ i, (x i - t * y i) • v i = ∑ i, x i • v i - t • ∑ i, y i • v i := by
      simp [sub_smul, Finset.sum_sub_distrib, Finset.smul_sum, mul_smul]
    rw [this, hysum, hwx]
    simp
  have hxi₀ : x i₀ - t * y i₀ = 0 := by
    simp only [ht]; field_simp; ring
  have hlt : (Finset.univ.filter (fun i => x i - t * y i ≠ 0)).card < (Finset.univ.filter (fun i => x i ≠ 0)).card := by
    apply Finset.card_lt_card
    rw [Finset.ssubset_iff_of_subset]
    · refine ⟨i₀, ?_, ?_⟩
      · simpa [hS] using hi₀S
      · simp [hxi₀]
    · intro i hi
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hi ⊢
      intro h0
      apply hi
      have : y i = 0 := hyS i (by simpa [hS] using h0)
      simp [h0, this]
  have := Nat.find_min hex (m := (Finset.univ.filter (fun i => x i - t * y i ≠ 0)).card)
    (by rw [← hcard]; exact hlt)
  exact this ⟨fun i => x i - t * y i, hx', hsum', rfl⟩

theorem coneOn_closed [FiniteDimensional ℝ E] [DecidableEq κ] (v : κ → E) (S : Finset κ)
    (hS : LinearIndependent ℝ (fun i : S => v i)) : IsClosed (coneOn v S) := by
  classical
  let f : (S → ℝ) →ₗ[ℝ] E := Fintype.linearCombination ℝ (fun i : S => v i)
  have hf : Function.Injective f := linearIndependent_iff_injective_fintypeLinearCombination.mp hS
  have hemb := f.isClosedEmbedding_of_injective (LinearMap.ker_eq_bot.mpr hf)
  have hclosed : IsClosed {y : S → ℝ | ∀ i, 0 ≤ y i} := by
    simp only [Set.ofPred_forall]
    exact isClosed_iInter fun i => isClosed_le continuous_const (continuous_apply i)
  have : coneOn v S = f '' {y : S → ℝ | ∀ i, 0 ≤ y i} := by
    ext w
    constructor
    · rintro ⟨x, hx, hxS, rfl⟩
      refine ⟨fun i => x i, fun i => hx i, ?_⟩
      simp only [f, Fintype.linearCombination_apply]
      rw [← Finset.sum_subset (Finset.subset_univ S)]
      · exact (Finset.sum_coe_sort S fun i => x i • v i)
      · intro i _ hi
        simp [hxS i hi]
    · rintro ⟨y, hy, rfl⟩
      refine ⟨fun i => if h : i ∈ S then y ⟨i, h⟩ else 0, fun i => ?_, fun i hi => by simp [hi], ?_⟩
      · by_cases h : i ∈ S
        · simpa [h] using hy ⟨i, h⟩
        · simp [h]
      · simp only [f, Fintype.linearCombination_apply]
        rw [← Finset.sum_subset (Finset.subset_univ S)]
        · rw [← Finset.sum_coe_sort S]
          refine Finset.sum_congr rfl fun i _ => ?_
          simp
        · intro i _ hi
          simp [hi]
  rw [this]
  exact hemb.isClosedMap _ hclosed

theorem coneSet_closed [FiniteDimensional ℝ E] (v : κ → E) : IsClosed (coneSet v) := by
  classical
  have : coneSet v = ⋃ S ∈ {S : Finset κ | LinearIndependent ℝ (fun i : S => v i)}, coneOn v S := by
    ext w
    simp only [Set.mem_iUnion, Set.mem_setOf_eq, exists_prop]
    constructor
    · intro hw
      obtain ⟨S, hS, hwS⟩ := exists_indep_rep v hw
      exact ⟨S, hS, hwS⟩
    · rintro ⟨S, _, x, hx, _, rfl⟩
      exact ⟨x, hx, rfl⟩
  rw [this]
  exact (Set.toFinite _).isClosed_biUnion fun S hS => coneOn_closed v S hS

end Cone

/-- A separating functional for a finitely generated cone. -/
theorem separate {κ : Type*} [Fintype κ] {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] (v : κ → E) {b : E} (hb : b ∉ coneSet v) :
    ∃ f : E →L[ℝ] ℝ, (∀ c ∈ coneSet v, 0 ≤ f c) ∧ f b < 0 := by
  obtain ⟨f, u, hbu, hu⟩ := geometric_hahn_banach_point_closed (coneSet_convex v)
    (coneSet_closed v) hb
  have hu0 : u < 0 := by simpa using hu 0 (coneSet_zero v)
  refine ⟨f, fun c hc => ?_, by linarith⟩
  by_contra hneg
  push_neg at hneg
  have hpos : 0 ≤ 2 * u / f c := div_nonneg_of_nonpos (by linarith) hneg.le
  have := hu _ (coneSet_smul v hc hpos)
  rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ hneg.ne] at this
  linarith

/-- **Farkas' lemma** (finite index types): either `A x ≥ b` has a solution `x ≥ 0`,
or there is `y ≥ 0` with `yᵀ A ≤ 0` and `yᵀ b > 0`. -/
theorem farkas {R ι : Type*} [Fintype R] [Fintype ι] [DecidableEq R] (A : R → ι → ℝ) (b : R → ℝ) :
    (∃ x : ι → ℝ, (∀ i, 0 ≤ x i) ∧ ∀ r, b r ≤ ∑ i, A r i * x i) ∨
    (∃ y : R → ℝ, (∀ r, 0 ≤ y r) ∧ (∀ i, ∑ r, y r * A r i ≤ 0) ∧ 0 < ∑ r, y r * b r) := by
  classical
  let v : ι ⊕ R → (R → ℝ) := Sum.elim (fun i r => A r i) (fun r => -Pi.single r 1)
  by_cases hb : b ∈ coneSet v
  · left
    obtain ⟨x, hx, hbx⟩ := hb
    refine ⟨fun i => x (Sum.inl i), fun i => hx _, fun r => ?_⟩
    have := congrFun hbx r
    simp only [Fintype.sum_sum_type, v, Sum.elim_inl, Sum.elim_inr, Finset.sum_apply,
      Pi.smul_apply, smul_eq_mul, Pi.neg_apply] at this
    simp [Pi.single_apply, mul_comm] at this
    have h2 := hx (Sum.inr r)
    linarith
  · right
    obtain ⟨f, hf, hfb⟩ := separate v hb
    let y : R → ℝ := fun r => - f (Pi.single r 1)
    have hlin : ∀ c : R → ℝ, f c = ∑ r, c r * f (Pi.single r 1) := by
      intro c
      have := LinearMap.pi_apply_eq_sum_univ (f : (R → ℝ) →ₗ[ℝ] ℝ) c
      simp only [ContinuousLinearMap.coe_coe] at this
      rw [this]
      refine Finset.sum_congr rfl fun r _ => ?_
      congr 2
      ext j
      simp [Pi.single_apply, eq_comm]
    refine ⟨y, fun r => ?_, fun i => ?_, ?_⟩
    · have := hf (v (Sum.inr r)) (gen_mem v _)
      simp only [v, Sum.elim_inr, map_neg] at this
      simp only [y]; linarith
    · have := hf (v (Sum.inl i)) (gen_mem v _)
      simp only [v, Sum.elim_inl] at this
      rw [hlin] at this
      simp only [y, neg_mul, Finset.sum_neg_distrib]
      have e : ∑ r, A r i * f (Pi.single r 1) = ∑ r, f (Pi.single r 1) * A r i :=
        Finset.sum_congr rfl fun r _ => mul_comm _ _
      linarith
    · rw [hlin] at hfb
      simp only [y, neg_mul, Finset.sum_neg_distrib]
      have e : ∑ r, b r * f (Pi.single r 1) = ∑ r, f (Pi.single r 1) * b r :=
        Finset.sum_congr rfl fun r _ => mul_comm _ _
      linarith

end RepellingPairs.Dev.FarkasLP
