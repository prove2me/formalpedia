theorem Ideal.comap_map_pow_eq_of_flat_of_isMaximal
    {C S : Type*} [CommRing C] [CommRing S] [Algebra C S] [Module.Flat C S]
    (y : Ideal C) (hy : y.IsMaximal)
    (h1 : (y.map (algebraMap C S)).comap (algebraMap C S) ≠ ⊤) (n : ℕ) :
    ((y ^ n).map (algebraMap C S)).comap (algebraMap C S) = y ^ n := by
  classical
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [Ideal.map_top]
  refine le_antisymm ?_ Ideal.le_comap_map
  intro x hx
  rw [Ideal.mem_comap] at hx
  set I : Ideal C := y ^ n with hI
  have hIy : I ≤ y := hI ▸ Ideal.pow_le_self hn.ne'
  let Cn := C ⧸ I
  let M := Cn ⊗[C] S
  let e := Algebra.TensorProduct.quotIdealMapEquivTensorQuot S I
  let κ := Algebra.TensorProduct.comm C S Cn
  let ρ : S →+* M := (κ.toRingHom.comp e.toRingHom).comp (Ideal.Quotient.mk (I.map (algebraMap C S)))
  have hρ : ∀ s : S, ρ s = (1 : Cn) ⊗ₜ[C] s := by
    intro s
    show κ (e (Ideal.Quotient.mk _ s)) = _
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk]
    exact Algebra.TensorProduct.comm_tmul _ _ _
  have hρsurj : Function.Surjective ρ :=
    (κ.surjective.comp e.surjective).comp Ideal.Quotient.mk_surjective
  have hρker : ∀ s : S, ρ s = 0 → s ∈ I.map (algebraMap C S) := by
    intro s hs
    have : Ideal.Quotient.mk (I.map (algebraMap C S)) s = 0 := by
      apply e.injective; apply κ.injective
      rw [map_zero, map_zero]; exact hs
    exact Ideal.Quotient.eq_zero_iff_mem.mp this
  have hcomp : ∀ c : C, algebraMap Cn M (Ideal.Quotient.mk I c) = ρ (algebraMap C S c) := by
    intro c
    rw [hρ, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      Algebra.algebraMap_eq_smul_one c, TensorProduct.tmul_smul, TensorProduct.smul_tmul', Algebra.smul_def, mul_one]
    rfl

  have hff : Module.FaithfullyFlat Cn M := by
    refine (Module.FaithfullyFlat.iff_flat_and_proper_ideal Cn M).mpr ⟨inferInstance, fun I' hI' htop => ?_⟩
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal I' hI'
    have hcm : (m.comap (Ideal.Quotient.mk I)) = y := by
      have hmax : (m.comap (Ideal.Quotient.mk I)).IsMaximal := Ideal.comap_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
      refine (hy.eq_of_le hmax.ne_top ?_).symm
      apply Ideal.IsPrime.le_of_pow_le (n := n)
      intro z hz
      rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr (hI ▸ hz)]
      exact m.zero_mem
    have hmy : m = y.map (Ideal.Quotient.mk I) := by
      rw [← hcm, Ideal.map_comap_of_surjective _ Ideal.Quotient.mk_surjective]
    have hle' : I' ≤ y.map (Ideal.Quotient.mk I) := hmy ▸ hle
    have hmono := Submodule.smul_mono hle' (le_refl (⊤ : Submodule Cn M))
    rw [htop] at hmono
    have htop' : (y.map (Ideal.Quotient.mk I)) • (⊤ : Submodule Cn M) = ⊤ := le_antisymm le_top hmono
    rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_eq_top_iff, Ideal.map_map] at htop'
    have hcomp' : (algebraMap Cn M).comp (Ideal.Quotient.mk I) = ρ.comp (algebraMap C S) := by
      ext c; exact hcomp c
    rw [hcomp', ← Ideal.map_map] at htop'
    have h2 : Ideal.comap ρ (Ideal.map ρ (y.map (algebraMap C S))) = ⊤ := by rw [htop']; exact Ideal.comap_top
    rw [Ideal.comap_map_of_surjective ρ hρsurj] at h2
    have h3 : y.map (algebraMap C S) = ⊤ := by
      refine top_le_iff.mp (h2.symm.le.trans (sup_le le_rfl ?_))
      intro z hz
      exact Ideal.map_mono hIy (hρker z hz)
    exact h1 (by rw [h3]; exact Ideal.comap_top)

  have hinj := FaithfulSMul.algebraMap_injective Cn M
  have hρx : ρ (algebraMap C S x) = 0 := by
    show κ (e (Ideal.Quotient.mk _ (algebraMap C S x))) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero, map_zero]
  have hx0 : algebraMap Cn M (Ideal.Quotient.mk I x) = 0 := (hcomp x).trans hρx
  have : Ideal.Quotient.mk I x = 0 := hinj (by rw [hx0, map_zero])
  exact hI ▸ Ideal.Quotient.eq_zero_iff_mem.mp this

