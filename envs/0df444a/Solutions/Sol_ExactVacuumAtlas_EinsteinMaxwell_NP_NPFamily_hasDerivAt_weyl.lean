open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
open ExactVacuumAtlas.EinsteinMaxwell.NP.NPFamily
variable {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ} {W : Set (ℝ × Pt 4)}
  {h : Metric 4} {f : TwoForm 4} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}
variable (hF : NPFamily g gi F E Θ W) (ht : NPTangent g F E W h f B) {x : Pt 4} (hx : ((0 : ℝ), x) ∈ W)
include hF ht hx
theorem solution (a b c d : Fin 4) :
    HasDerivAt (fun ε => weyl (g ε) (gi ε) a b c d x) (weylVar (g 0) (gi 0) h a b c d x) 0 := by
  have hg := fun i j => ht.tangent.metric x hx i j
  have hR := fun i j => hF.fam.hasDerivAt_ricciOf ht.tangent hx i j
  have hS := hF.fam.hasDerivAt_ricciScalar ht.tangent hx
  have hRL : HasDerivAt (fun ε => riemLow (g ε) (gi ε) a b c d x) (riemLowVar (g 0) (gi 0) h a b c d x) 0 := by
    simp only [riemLow]
    exact (HasDerivAt.fun_sum (u := Finset.univ) fun e _ => (hg a e).mul (hasDerivAt_riem hF ht hx e b c d)).congr_deriv
      (by simp only [riemLowVar])
  have hX := (((((hg a c).mul (hR b d)).sub ((hg a d).mul (hR b c))).sub ((hg b c).mul (hR a d))).add
    ((hg b d).mul (hR a c))).div_const (2 : ℝ)
  have hY := (hS.mul (((hg a c).mul (hg b d)).sub ((hg a d).mul (hg b c)))).div_const (6 : ℝ)
  refine hasDerivAt_of_congr ((hRL.sub hX).add hY) (fun ε => by simp only [weyl]; rfl) ?_
  simp only [weylVar, Pi.mul_apply, Pi.sub_apply, Pi.add_apply]
