theorem solution (L : ℕ → ℝ) (n j : ℕ) (hj : j ≤ n) :
    iteratedDeriv j (taylorPoly L n) 0 = L j := by
  have hfun : taylorPoly L n
      = fun x : ℝ => ∑ k ∈ Finset.range (n + 1), L k / (k.factorial : ℝ) * x ^ k := rfl
  rw [hfun, iteratedDeriv_fun_sum (fun k _ => by fun_prop)]
  have hstep : ∀ k ∈ Finset.range (n + 1),
      iteratedDeriv j (fun x : ℝ => L k / (k.factorial : ℝ) * x ^ k) 0
        = if k = j then L k else 0 := by
    intro k _
    by_cases hk : k = j
    · subst k
      rw [iteratedDeriv_mono_self, if_pos rfl]
      exact div_mul_cancel₀ (L j) (by exact_mod_cast Nat.factorial_ne_zero j)
    · rw [iteratedDeriv_mono_ne _ hk, if_neg hk]
  rw [Finset.sum_congr rfl hstep, Finset.sum_eq_single j]
  · rw [if_pos rfl]
  · intro b _ hb; rw [if_neg hb]
  · intro hmem; exact absurd (Finset.mem_range.mpr (Nat.lt_succ_of_le hj)) hmem
