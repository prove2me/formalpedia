          ψ'.comp ψ = ((N * q) : ℕ) • AddMonoidHom.id _ → ψ.comp ψ' = ((N * q) : ℕ) • AddMonoidHom.id _ →
        θ₁ '' WeierstrassCurve.kernelIdealSet κ X₁ W' (ψ.comp χ) =
