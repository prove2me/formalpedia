open Filter Topology
open scoped ContDiff
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
variable {n : ℕ}
theorem solution {φ : ℝ × Pt n → ℝ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hφ : ContDiffOn ℝ ∞ φ W) {ε₀ : ℝ} {x : Pt n} (hx : (ε₀, x) ∈ W)
    {ψ : Pt n → ℝ} (hψ : ∀ y, (ε₀, y) ∈ W → HasDerivAt (fun ε => φ (ε, y)) (ψ y) ε₀) (i : Fin n) :
    HasDerivAt (fun ε => pd i (fun z => φ (ε, z)) x) (pd i ψ x) ε₀ := by
  have hDs : ContDiffOn ℝ ∞ (fderiv ℝ φ) W := hφ.fderiv_of_isOpen hW (by simp)
  have hDd : DifferentiableAt ℝ (fderiv ℝ φ) (ε₀, x) :=
    (hDs.contDiffAt (hW.mem_nhds hx)).differentiableAt (by simp)
  -- near `ε₀` the function is `ε ↦ Dφ(ε, x)(0, eᵢ)`
  have hev : (fun ε => pd i (fun z => φ (ε, z)) x) =ᶠ[𝓝 ε₀]
      fun ε => fderiv ℝ φ (ε, x) ((0 : ℝ), (Pi.single i 1 : Pt n)) := by
    have hc : ContinuousAt (fun ε : ℝ => (ε, x)) ε₀ :=
      (continuous_id.prodMk continuous_const).continuousAt
    filter_upwards [hc.preimage_mem_nhds (hW.mem_nhds hx)] with ε hε
    exact pd_eq_fderiv_joint hW hφ hε i
  have h1 : HasDerivAt (fun ε : ℝ => (ε, x)) ((1 : ℝ), (0 : Pt n)) ε₀ :=
    (hasDerivAt_id ε₀).prodMk (hasDerivAt_const ε₀ x)
  have h2 : HasDerivAt (fun ε => fderiv ℝ φ (ε, x))
      (fderiv ℝ (fderiv ℝ φ) (ε₀, x) ((1 : ℝ), (0 : Pt n))) ε₀ :=
    HasFDerivAt.comp_hasDerivAt (x := ε₀) (hl := hDd.hasFDerivAt) (hf := h1)
  have h3 : HasDerivAt (fun ε => fderiv ℝ φ (ε, x) ((0 : ℝ), (Pi.single i 1 : Pt n)))
      (fderiv ℝ (fderiv ℝ φ) (ε₀, x) ((1 : ℝ), (0 : Pt n)) ((0 : ℝ), (Pi.single i 1 : Pt n))) ε₀ := by
    have := h2.clm_apply (hasDerivAt_const ε₀ ((0 : ℝ), (Pi.single i 1 : Pt n)))
    simpa only [map_zero, add_zero] using this
  -- `ψ = Dφ(ε₀, ·)(1, 0)` on the open slice
  have hψeq : Set.EqOn ψ (fun y => fderiv ℝ φ (ε₀, y) ((1 : ℝ), (0 : Pt n))) {y | (ε₀, y) ∈ W} :=
    fun y hy => (hψ y hy).unique
      (hasDerivAt_param_joint (p := (ε₀, y)) (differentiableAt_joint hW hφ hy))
  have h5 : HasDerivAt (fun u : ℝ => (ε₀, Function.update x i u))
      ((0 : ℝ), (Pi.single i 1 : Pt n)) (x i) :=
    (hasDerivAt_const _ ε₀).prodMk (hasDerivAt_update x i (x i))
  have h6 : HasFDerivAt (fderiv ℝ φ) (fderiv ℝ (fderiv ℝ φ) (ε₀, x))
      (ε₀, Function.update x i (x i)) := by
    rw [Function.update_eq_self]; exact hDd.hasFDerivAt
  have h7 : HasDerivAt (fun u : ℝ => fderiv ℝ φ (ε₀, Function.update x i u))
      (fderiv ℝ (fderiv ℝ φ) (ε₀, x) ((0 : ℝ), (Pi.single i 1 : Pt n))) (x i) :=
    HasFDerivAt.comp_hasDerivAt (x := x i) (hl := h6) (hf := h5)
  have h8 : HasDerivAt (fun u : ℝ => fderiv ℝ φ (ε₀, Function.update x i u) ((1 : ℝ), (0 : Pt n)))
      (fderiv ℝ (fderiv ℝ φ) (ε₀, x) ((0 : ℝ), (Pi.single i 1 : Pt n)) ((1 : ℝ), (0 : Pt n))) (x i) := by
    have := h7.clm_apply (hasDerivAt_const (x i) ((1 : ℝ), (0 : Pt n)))
    simpa only [map_zero, add_zero] using this
  have h4 : pd i ψ x = fderiv ℝ (fderiv ℝ φ) (ε₀, x) ((0 : ℝ), (Pi.single i 1 : Pt n))
      ((1 : ℝ), (0 : Pt n)) := by
    rw [pd_congr_of_eqOn (isOpen_slice hW ε₀) hx hψeq i]
    exact pd_eq_of_hasDerivAt h8
  have hsymm : IsSymmSndFDerivAt ℝ φ (ε₀, x) :=
    (hφ.contDiffAt (hW.mem_nhds hx)).isSymmSndFDerivAt
      (by simp only [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.mpr le_top)
  rw [h4, hsymm]
  exact h3.congr_of_eventuallyEq hev
