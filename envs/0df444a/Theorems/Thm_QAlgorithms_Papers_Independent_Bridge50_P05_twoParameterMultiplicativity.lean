variable {d : ℕ} [NeZero d]

/-- Section 2, PDF p.9: maximal-degenerate two-parameter multiplicativity.
Neither CP nor TP of the two-parameter map is assumed. -/
theorem twoParameterMultiplicativity (G : AddSubgroup (WeylLabel d))
    (hG : MaximalDegenerate G) (a b : ℂ)
    (hb : ‖b‖ ≤ 1) (hab : ‖a + b‖ ≤ 1) (horder : ‖b‖ ≤ ‖a + b‖) :
    (∀ z, ‖twoSymbol G a b z‖ ≤ 1) ∧
    (G : Set (WeylLabel d)) \ {0} ⊆ optimizers (twoSymbol G a b) ∧
    nu 2 (twoMap G a b) = saturationValue (twoSymbol G a b) ∧
    UniversalMultiplicative 2 (twoMap G a b) := by sorry

end QAlgorithms.Papers.Independent.Bridge50.P05

end
