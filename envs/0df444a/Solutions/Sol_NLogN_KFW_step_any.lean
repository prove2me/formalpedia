theorem Ex.regs_sub (σ : Fin HS → Option ℤ) : ∀ e : Ex HS, ∀ i ∈ e.regs,
    i ∈ (Ex.sub σ e).regs ∨ (σ i).isSome
  | .reg i, j, h => by
    simp only [Ex.regs, List.mem_singleton] at h; subst h
    unfold Ex.sub
    rcases hσ : σ j with _ | v
    · left; simp [Ex.regs]
    · right; simp
  | .lit c, j, h => by simp [Ex.regs] at h
  | .add a b, j, h | .mul a b, j, h | .shl a b, j, h | .quo a b, j, h | .rem a b, j, h
  | .ndiv a b, j, h | .nmod a b, j, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.sub, Ex.regs, List.mem_append]
    rcases h with h | h
    · rcases Ex.regs_sub σ a j h with h' | h'
      · exact Or.inl (Or.inl h')
      · exact Or.inr h'
    · rcases Ex.regs_sub σ b j h with h' | h'
      · exact Or.inl (Or.inr h')
      · exact Or.inr h'
  | .neg a, j, h | .pow2 a, j, h => by
    simp only [Ex.regs] at h
    simp only [Ex.sub, Ex.regs]
    exact Ex.regs_sub σ a j h
  | .sel c x y, j, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.sub, Ex.regs, List.mem_append]
    rcases h with (h | h) | h
    · rcases Ex.regs_sub σ c j h with h' | h'
      · exact Or.inl (Or.inl (Or.inl h'))
      · exact Or.inr h'
    · rcases Ex.regs_sub σ x j h with h' | h'
      · exact Or.inl (Or.inl (Or.inr h'))
      · exact Or.inr h'
    · rcases Ex.regs_sub σ y j h with h' | h'
      · exact Or.inl (Or.inr h')
      · exact Or.inr h'

theorem RS.touch_sub (σ : Fin HS → Option ℤ) : ∀ (p : RS), ∀ i ∈ touch p,
    i ∈ touch (RS.sub σ p) ∨ (σ i).isSome
  | .skip, i, h => by simp [touch] at h
  | .asg j e, i, h | .push j e, i, h => by
    simp only [touch, List.mem_cons] at h
    simp only [RS.sub, touch, List.mem_cons]
    rcases h with h | h
    · exact Or.inl (Or.inl h)
    · rcases Ex.regs_sub σ e i h with h' | h'
      · exact Or.inl (Or.inr h')
      · exact Or.inr h'
  | .pop j, i, h => Or.inl h
  | .seq a b, i, h => by
    simp only [touch, List.mem_append] at h
    simp only [RS.sub, touch, List.mem_append]
    rcases h with h | h
    · rcases RS.touch_sub σ a i h with h' | h'
      · exact Or.inl (Or.inl h')
      · exact Or.inr h'
    · rcases RS.touch_sub σ b i h with h' | h'
      · exact Or.inl (Or.inr h')
      · exact Or.inr h'
  | .ite c a b, i, h => by
    simp only [touch, List.mem_append] at h
    simp only [RS.sub, touch, List.mem_append]
    rcases h with h | h | h
    · rcases Ex.regs_sub σ c i h with h' | h'
      · exact Or.inl (Or.inl h')
      · exact Or.inr h'
    · rcases RS.touch_sub σ a i h with h' | h'
      · exact Or.inl (Or.inr (Or.inl h'))
      · exact Or.inr h'
    · rcases RS.touch_sub σ b i h with h' | h'
      · exact Or.inl (Or.inr (Or.inr h'))
      · exact Or.inr h'
  | .rep j n b, i, h => by
    simp only [touch, List.mem_cons, List.mem_append] at h
    simp only [RS.sub, touch, List.mem_cons, List.mem_append]
    rcases h with h | h | h
    · exact Or.inl (Or.inl h)
    · rcases Ex.regs_sub σ n i h with h' | h'
      · exact Or.inl (Or.inr (Or.inl h'))
      · exact Or.inr h'
    · rcases RS.touch_sub σ b i h with h' | h'
      · exact Or.inl (Or.inr (Or.inr h'))
      · exact Or.inr h'

theorem fok_of_sub (σ : Fin HS → Option ℤ) : ∀ (p : RS), NoW σ p →
    NLogN.KFD.fok (RS.sub σ p) = true → NLogN.KFD.fok p = true
  | .skip, _, _ => rfl
  | .asg _ _, _, _ | .push _ _, _, _ | .pop _, _, _ => rfl
  | .seq a b, hw, h => by
    have ha : NoW σ a := fun i h => hw i (by simp [RS.writes, h])
    have hb : NoW σ b := fun i h => hw i (by simp [RS.writes, h])
    simp only [RS.sub, NLogN.KFD.fok, Bool.and_eq_true] at h ⊢
    exact ⟨fok_of_sub σ a ha h.1, fok_of_sub σ b hb h.2⟩
  | .ite c a b, hw, h => by
    have ha : NoW σ a := fun i h => hw i (by simp [RS.writes, h])
    have hb : NoW σ b := fun i h => hw i (by simp [RS.writes, h])
    simp only [RS.sub, NLogN.KFD.fok, Bool.and_eq_true] at h ⊢
    exact ⟨fok_of_sub σ a ha h.1, fok_of_sub σ b hb h.2⟩
  | .rep i n b, hw, h => by
    have hbw : NoW σ b := fun j h => hw j (by simp [RS.writes, h])
    have hi : σ i = none := hw i (by simp [RS.writes])
    simp only [RS.sub, NLogN.KFD.fok, Bool.and_eq_true, Bool.not_eq_true'] at h ⊢
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    refine ⟨⟨?_, h2⟩, fok_of_sub σ b hbw h3⟩
    rcases hc : (touch b).contains i with _ | _
    · rfl
    · exfalso
      have hm : i ∈ touch b := by simpa using hc
      rcases RS.touch_sub σ b i hm with h' | h'
      · have : (touch (RS.sub σ b)).contains i = true := by simpa using h'
        rw [this] at h1; exact absurd h1 (by simp)
      · rw [hi] at h'; simp at h'

end NLogN.KFW

