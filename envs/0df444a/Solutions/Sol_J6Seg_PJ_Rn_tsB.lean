    (hca : c ≤ a) (hua : a - c < n) (huu : uu < n) (hk : k < n) (hnl : n ≤ lam) (hlN : lam ≤ N)
    (hAP : D SAP = ((List.range n).map (T.ap c)).reverse)
    (hAM : D SAM = ((List.range n).map (T.am c)).reverse)
    (hGM : D SGM = ((List.range lam).map T.gam).reverse)
    (bAP : ∀ i < n, |T.ap c i| ≤ 2 ^ W) (bAM : ∀ i < n, |T.am c i| ≤ 2 ^ W)
    (bGM : ∀ i < lam, |T.gam i| ≤ 2 ^ W)
    (bS : |u 8 + tsT Q T c (tU w n (a - c) uu) (tV w n (a - c) uu) k| ≤ 2 ^ W) :
    Rn (progL PJ.tsB) u D (fun v' =>
      v' 8 = u 8 + tsT Q T c (tU w n (a - c) uu) (tV w n (a - c) uu) k ∧
      (∀ j ∉ ([5, 8, 11, 12, 29] : List (Fin HS)), v' j = u j) ∧ BV W v') D (costL W N PJ.tsB) := by
  set tu := tU w n (a - c) uu with htud
  set tv := tV w n (a - c) uu with htvd
  have htu : tUE.den u = tu := den_tUE h1 h2 h3 h7 h26 hca huu
  have htv : tVE.den u = tv := den_tVE h1 h2 h3 h7 h26 hca hua
  have tun : tu < n := tU_lt hua huu
  have tvn : tv < n := tV_lt hua huu
  have d1 : (ixAE tUE).den u = ((n - 1 - (k - tu) : ℕ) : ℤ) := den_ixAE h2 h4 htu hk
  obtain ⟨w1, hw1⟩ : ∃ w1 : Vr, w1 = update (update u 29 ((n - 1 - (k - tu) : ℕ) : ℤ)) 5
      ((D SAP).getD (n - 1 - (k - tu)) 0) := ⟨_, rfl⟩
  have q1 : ∀ j : Fin HS, j ≠ 29 → j ≠ 5 → w1 j = u j := fun j a b => by
    rw [hw1, update_of_ne b, update_of_ne a]
  have d2 : (ixAE tVE).den w1 = ((n - 1 - (k - tv) : ℕ) : ℤ) :=
    den_ixAE (by rw [q1 2 (by decide) (by decide), h2]) (by rw [q1 4 (by decide) (by decide), h4])
      (den_tVE (by rw [q1 1 (by decide) (by decide), h1]) (by rw [q1 2 (by decide) (by decide), h2])
        (by rw [q1 3 (by decide) (by decide), h3]) (by rw [q1 7 (by decide) (by decide), h7])
        (by rw [q1 26 (by decide) (by decide), h26]) hca hua) hk
  obtain ⟨w2, hw2⟩ : ∃ w2 : Vr, w2 = update (update w1 29 ((n - 1 - (k - tv) : ℕ) : ℤ)) 11
      ((D SAM).getD (n - 1 - (k - tv)) 0) := ⟨_, rfl⟩
  have q2 : ∀ j : Fin HS, j ≠ 29 → j ≠ 5 → j ≠ 11 → w2 j = u j := fun j a b c' => by
    rw [hw2, update_of_ne c', update_of_ne a, q1 j a b]
