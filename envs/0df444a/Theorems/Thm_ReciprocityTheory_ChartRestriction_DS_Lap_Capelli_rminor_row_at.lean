theorem ReciprocityTheory.ChartRestriction.DS.Lap.Capelli.rminor_row_at (hE : GlRelR E) {p : ℕ} (R C : Fin (p + 1) → Fin n) (i : Fin (p + 1)) (x : ℂ) :
