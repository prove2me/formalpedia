open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (s : NLogN.IState NLogN.NS) (N : ℕ) (a b : ℤ) (LA LN : List NLogN.Item) (ha : 0 ≤ a ∧ a ≤ 2 ^ N)
    (hb : 0 ≤ b ∧ b ≤ 2 ^ N) (hA : s.G NLogN.ARG = .int a :: .int b :: LA)
    (hN : s.G NLogN.RN = .int (2 ^ N) :: LN) :
    NLogN.IRuns I iprog NLogN.fmPre s
      (s.upd NLogN.ARG (.int (a % 2 ^ N + -(a / 2 ^ N)) :: .int (b % 2 ^ N + -(b / 2 ^ N)) :: LA))
      (5000 * (N + 2)) := by
  have hp : (0 : ℤ) < 2 ^ N := by positivity
  have hza : NLogN.zsz (a % 2 ^ N) ≤ N + 1 := NLogN.zsz_le_of_abs (by
    have := Int.emod_nonneg a hp.ne'; have := Int.emod_lt_of_pos a hp
    rw [abs_lt, pow_succ]; constructor <;> linarith)
  have hzb : NLogN.zsz (b % 2 ^ N) ≤ N + 1 := NLogN.zsz_le_of_abs (by
    have := Int.emod_nonneg b hp.ne'; have := Int.emod_lt_of_pos b hp
    rw [abs_lt, pow_succ]; constructor <;> linarith)
  have hqa : a / 2 ^ N = 0 ∨ a / 2 ^ N = 1 := by
    have h1 := Int.ediv_nonneg ha.1 hp.le
    have h2 : a / 2 ^ N < 2 := by
      rw [Int.ediv_lt_iff_lt_mul hp]; linarith
    omega
  have hqb : b / 2 ^ N = 0 ∨ b / 2 ^ N = 1 := by
    have h1 := Int.ediv_nonneg hb.1 hp.le
    have h2 : b / 2 ^ N < 2 := by
      rw [Int.ediv_lt_iff_lt_mul hp]; linarith
    omega
  have hz1 : ∀ q : ℤ, (q = 0 ∨ q = 1) → NLogN.zsz q ≤ 1 := by
    intro q hq; rcases hq with rfl | rfl
    · rw [NLogN.zsz_zero]; omega
    · rw [NLogN.zsz_one]
  have hzq1 := hz1 _ hqa; have hzq2 := hz1 _ hqb
  have hzn1 : NLogN.zsz (-(a / 2 ^ N)) ≤ 1 := by rw [NLogN.zsz_neg]; exact hzq1
  have hzn2 : NLogN.zsz (-(b / 2 ^ N)) ≤ 1 := by rw [NLogN.zsz_neg]; exact hzq2
  have hzA : NLogN.zsz (a % 2 ^ N + -(a / 2 ^ N)) ≤ N + 2 :=
    le_trans (NLogN.zsz_add_le _ _) (by rw [NLogN.zsz_neg]; omega)
  apply NLogN.IRuns.of_runsTo 0
  simp +decide [NLogN.fmPre, NLogN.IStmt.run, NLogN.IOp.run, hA, hN, NLogN.sg_nonneg_div ha.1, NLogN.sg_nonneg_mod ha.1,
    NLogN.sg_nonneg_div hb.1, NLogN.sg_nonneg_mod hb.1]
  refine ⟨by clear * -; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
  have := NLogN.splitCost_le N
  have := NLogN.addIntCost_mono (show NLogN.zsz (a % 2 ^ N) + NLogN.zsz (-(a / 2 ^ N)) ≤ N + 2 by omega)
  have := NLogN.addIntCost_mono (show NLogN.zsz (b % 2 ^ N) + NLogN.zsz (-(b / 2 ^ N)) ≤ N + 2 by omega)
  have := NLogN.addIntCost_le (N + 2)
  have := NLogN.moveIntCost_le (NLogN.zsz (a % 2 ^ N + -(a / 2 ^ N)))
  simp only [NLogN.zsz_neg] at *
  omega
end
