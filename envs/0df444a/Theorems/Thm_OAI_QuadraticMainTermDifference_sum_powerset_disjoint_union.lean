theorem OAI.QuadraticMainTermDifference.sum_powerset_disjoint_union {κ V : Type*} [DecidableEq κ] [AddCommMonoid V]
    (T G : Finset κ) (hTG : Disjoint T G) (f : Finset κ → V) :
    (∑ A ∈ (T ∪ G).powerset, f A) =
      ∑ H ∈ T.powerset, ∑ D ∈ G.powerset, f (H ∪ D) := by sorry
