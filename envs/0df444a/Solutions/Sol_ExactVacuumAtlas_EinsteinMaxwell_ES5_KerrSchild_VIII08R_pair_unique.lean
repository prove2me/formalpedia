theorem solution {j : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hr : ContinuousOn r UG) {b0 v0 : ℝ → ℝ}
    (hb : MagClass 3 b0) (hv : VClass 3 v0)
    (hL : ∀ R ∈ Ioi (3:ℝ), Lmag b0 R = sfun j q (1 / R) / R ^ 3)
    (hD : ∀ R ∈ Ioi (3:ℝ), Dell j b0 v0 R = r (1 / R) / R) :
    EqOn b0 (bfun j q) (Ioi (3:ℝ)) ∧ EqOn v0 (vfun j q r) (Ioi (3:ℝ)) := by
  obtain ⟨Aq, hAq0, hq⟩ := exists_bound_witness hqc.continuousOn
  obtain ⟨Ar, hAr0, hr'⟩ := exists_bound_witness hr
  have hbEq : EqOn b0 (bfun j q) (Ioi (3:ℝ)) :=
    mag_eqOn_of_Lmag_eq hb (magClass_bfun (j := j) hqc hq hAq0) (fun R hR => by
      rw [hL R hR, Lmag_bfun hqc.continuousOn hR])
  refine ⟨hbEq, ?_⟩
  have hvfun : VClass 3 (vfun j q r) := vClass_vfun hqc hq hAq0 hr hr' hAr0
  refine v_unique hv hvfun (g := vSource j q r) (fun R hR => ?_) (fun R hR => ?_)
  · -- `v₀` has the same derivative source
    have h := hD R hR
    unfold Dell at h
    unfold vSource
    have hR' : 3 < R := hR
    have hR0 : R ^ 3 ≠ 0 := by
      have : (0:ℝ) < R := by linarith
      positivity
    have hb0 : b0 R = bfun j q R := hbEq hR
    rw [hb0] at h
    rw [eq_div_iff hR0, mul_comm]
    linarith
  · exact deriv_vfun_eq_vSource hqc hq hAq0 hr hR
