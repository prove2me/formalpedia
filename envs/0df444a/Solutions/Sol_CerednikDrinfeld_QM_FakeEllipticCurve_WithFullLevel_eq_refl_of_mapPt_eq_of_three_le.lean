theorem nsmulPt_val_congr {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of k)} (L : RelativeGroupLaw k f)
    {T : Scheme.{u}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of k)} (h : t₁ = t₂) (R : SchemeHomOver t₁ f) (n : ℕ) :
    (nsmulPt L t₂ n ⟨R.1, h ▸ R.2⟩).1 = (nsmulPt L t₁ n R).1 := by
  subst h; rfl

theorem one_val_congr {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of k)} (L : RelativeGroupLaw k f)
    {T : Scheme.{u}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of k)} (h : t₁ = t₂) :
    (L.one t₂).1 = (L.one t₁).1 := by
  subst h; rfl

section Transport

variable (φ : S →+* k) (E : FakeEllipticCurve Λ N S) (E' : FakeEllipticCurve Λ N k)
  (g : E'.A ⟶ E.A) (hg : IsPullback g E'.f E.f (Spec.map (CommRingCat.ofHom φ)))

def gp {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} (R : SchemeHomOver t E'.f) :
    SchemeHomOver (t ≫ Spec.map (CommRingCat.ofHom φ)) E.f :=
  ⟨R.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, R.2]⟩

@[scoped simp] theorem gp_coe {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} (R : SchemeHomOver t E'.f) :
    (gp φ E E' g hg R).1 = R.1 ≫ g := rfl

theorem gp_injective {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of k)} :
    Function.Injective (gp φ E E' g hg (t := t)) := by
  intro R R' h
  have h1 : R.1 ≫ g = R'.1 ≫ g := congrArg Subtype.val h
  exact Subtype.ext (hg.hom_ext h1 (by rw [R.2, R'.2]))

variable (hgmul : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of k)) (P Q : SchemeHomOver t' E'.f),
    (E'.L.mul t' P Q).1 ≫ g =
      (E.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
        ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
        ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1)

include hgmul

theorem gp_mul {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (P Q : SchemeHomOver t E'.f) :
    gp φ E E' g hg (E'.L.mul t P Q) = E.L.mul _ (gp φ E E' g hg P) (gp φ E E' g hg Q) :=
  Subtype.ext (hgmul t P Q)

theorem gp_one {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) :
    gp φ E E' g hg (E'.L.one t) = E.L.one _ := by
  letI := E.L.pointGroup (t ≫ Spec.map (CommRingCat.ofHom φ))
  have h := gp_mul φ E E' g hg hgmul t (E'.L.one t) (E'.L.one t)
  rw [E'.L.one_mul] at h

  exact mul_left_cancel (a := gp φ E E' g hg (E'.L.one t)) (h.symm.trans (mul_one _).symm)

theorem gp_nsmulPt {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of k)) (n : ℕ) (R : SchemeHomOver t E'.f) :
    gp φ E E' g hg (nsmulPt E'.L t n R) = nsmulPt E.L _ n (gp φ E E' g hg R) := by
  induction n with
  | zero => exact gp_one φ E E' g hg hgmul t
  | succ n ih =>
      show gp φ E E' g hg (E'.L.mul t (nsmulPt E'.L t n R) R) = E.L.mul _ (nsmulPt E.L _ n _) _
      rw [gp_mul φ E E' g hg hgmul, ih]

