-- title:
--   Sec. 2.1–2.4, (2.1) — the path spaces $\Omega^t$, $\hat\Omega^t$, the filtrations, $\|\cdot\|_T$, $d_\infty$, concatenation and the Wiener measure
-- statement:
--   Fix a dimension $d$ and a horizon $T \ge 0$; $|\cdot|$ is the Euclidean norm on $\mathbb R^d$. Time runs in $[0,\infty)$, but only $[0,T]$ matters.
--
--   1. For $t \ge 0$, the **shifted continuous canonical space** $\Omega^t$ is the set of continuous paths $\omega : [0,\infty) \to \mathbb R^d$ with $\omega_r = 0$ for $r \le t$ and $\omega_r = \omega_T$ for $r \ge T$. It is the paper's $\{\omega \in C([t,T],\mathbb R^d) : \omega_t = 0\}$, and $\Omega = \Omega^0$ is the space of continuous paths starting at $0$.
--   2. The **shifted càdlàg space** $\hat\Omega^t$ is the set of càdlàg paths (right-continuous with left limits) that are constant on $[0,t]$ and constant after $T$. It is the paper's $D([t,T],\mathbb R^d)$; its value at $t$ is free. Clearly $\Omega^t \subseteq \hat\Omega^t$.
--   3. Both spaces carry the σ-algebra generated by the evaluations $\omega \mapsto \omega_r$, and the raw filtration $\mathbb F^t$ with $\mathcal F^t_s = \sigma(\omega_r : r \le s)$, generated by the canonical process $B^t$ (likewise $\hat{\mathbb F}^t$ on $\hat\Omega^t$).
--   4. For a path $x$, "$\|x\|_T < \eta$" means $\sup_{0 \le r \le T}|x_r| < \eta$, and "$d_\infty((s,x),(s',x')) < \eta$" means
--   $$|s-s'| + \sup_{0\le r\le T}\big|x_{s\wedge r} - x'_{s'\wedge r}\big| < \eta, \qquad (2.1)$$
--   both stated without forming the supremum.
--   5. For $\omega \in \Omega^s$ and $\omega' \in \Omega^t$ with $s \le t$, the **concatenation** is $(\omega \otimes_t \omega')_r = \omega_{r\wedge t} + \omega'_r$, i.e. $\omega_r$ on $[s,t)$ and $\omega_t + \omega'_r$ on $[t,T]$. The **shift** of $\omega \in \Omega^s$ to time $t$ is $(\omega_{r \vee t} - \omega_t)_r \in \Omega^t$.
--   6. $P_0$ is the **Wiener measure** on $\Omega$: a probability measure under which, for every coordinate $i$ and every finite set $I \subseteq [0,T]$ of times, $(\omega^i_s)_{s\in I}$ has the finite-dimensional law of standard Brownian motion, and the $d$ coordinate processes are independent. The shifted Wiener measure $P^t_0$ on $\Omega^t$ is the image of $P_0$ under the shift to time $t$, i.e. the law of $(B_{r\vee t} - B_t)_r$.
--
--   These are the spaces on which every object of the mission lives: test functions are defined on $\Lambda^t = [t,T]\times\Omega^t$, their $C^{1,2}_b$ extensions on $\hat\Lambda^t = [t,T]\times\hat\Omega^t$, and the nonlinear expectations integrate against $P^t_0$.
--
--   **Formalization Note** $\Omega^t$ and $\hat\Omega^t$ are subtypes of $[0,\infty) \to \mathbb R^d$ (`EuclideanSpace ℝ (Fin d)`), with the zero-before-$t$ (resp. constant-before-$t$) convention, so $\Omega = \Omega^0$ and $\hat\Omega = \hat\Omega^0$ are literally the $t=0$ instances. The concatenation is written for all $s,t$ as $\omega_{r\wedge t} + \omega'_r - \omega'_{r\wedge s}$; the last term vanishes when $s \le t$, the only case used. The Wiener measure is a hypothesis `IsWiener P0` on the finite-dimensional laws (Mathlib's `BrownianReal.projectiveFamily`), not a construction; the shift is proved measurable, so $P^t_0$ is not the junk zero measure.
-- source:
--   Ekren, Keller, Touzi, Zhang, On viscosity solutions of path dependent PDEs, arXiv:1109.5971v2, Sec. 2.1–2.2 (2.1), pp. 3–5; Sec. 2.4, pp. 7–8

import Mathlib

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal

namespace ViscosityPPDE.Comparison

/-- `ℝ^d` with the Euclidean norm `|·|`. -/
abbrev Rd (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- The shifted continuous canonical space `Ω^t = {ω ∈ C([t,T], ℝ^d) : ω_t = 0}`, encoded as
continuous paths `ℝ≥0 → ℝ^d` that vanish on `[0, t]` and are constant after `T`. -/
def OmegaSet (d : ℕ) (T t : ℝ≥0) : Set (ℝ≥0 → Rd d) :=
  {ω | Continuous ω ∧ (∀ r, r ≤ t → ω r = 0) ∧ ∀ r, T ≤ r → ω r = ω T}

/-- `Ω^t` as a type; `Ω = Ω^0`. Its σ-algebra is generated by the evaluations `ω ↦ ω_r`. -/
abbrev Omega (d : ℕ) (T t : ℝ≥0) := {ω : ℝ≥0 → Rd d // ω ∈ OmegaSet d T t}

/-- A path is càdlàg: right-continuous with left limits at every time. -/
def IsCadlag {d : ℕ} (ω : ℝ≥0 → Rd d) : Prop :=
  ∀ r, ContinuousWithinAt ω (Set.Ici r) r ∧ ∃ l, Tendsto ω (𝓝[<] r) (𝓝 l)

/-- The shifted càdlàg space `Ω̂^t = D([t,T], ℝ^d)`, encoded as càdlàg paths `ℝ≥0 → ℝ^d` that are
constant on `[0, t]` (equal to their value at `t`, which is free) and constant after `T`.
`Ω̂ = Ω̂^0`, and `Ω^t ⊆ Ω̂^t`. -/
def OmegaHatSet (d : ℕ) (T t : ℝ≥0) : Set (ℝ≥0 → Rd d) :=
  {ω | IsCadlag ω ∧ (∀ r, r ≤ t → ω r = ω t) ∧ ∀ r, T ≤ r → ω r = ω T}

/-- `Ω̂^t` as a type, with the σ-algebra generated by the evaluations. -/
abbrev OmegaHat (d : ℕ) (T t : ℝ≥0) := {ω : ℝ≥0 → Rd d // ω ∈ OmegaHatSet d T t}

/-- The zero path `0 ∈ Ω^t`. -/
def zeroPath (d : ℕ) (T t : ℝ≥0) : Omega d T t :=
  ⟨0, continuous_const, fun _ _ => rfl, fun _ _ => rfl⟩

lemma measurable_eval (d : ℕ) (T t r : ℝ≥0) :
    Measurable (fun ω : Omega d T t => ω.1 r) :=
  (measurable_pi_apply r).comp measurable_subtype_coe

lemma measurable_evalHat (d : ℕ) (T t r : ℝ≥0) :
    Measurable (fun ω : OmegaHat d T t => ω.1 r) :=
  (measurable_pi_apply r).comp measurable_subtype_coe

/-- The raw filtration `𝔽^t` generated by the shifted canonical process `B^t`:
`𝓕^t_s = σ(ω_r : r ≤ s)` on `Ω^t` (not completed, not right-continuous). -/
noncomputable def filt (d : ℕ) (T t : ℝ≥0) : Filtration ℝ≥0 (inferInstance : MeasurableSpace (Omega d T t)) :=
  Filtration.natural (fun r (ω : Omega d T t) => ω.1 r)
    (fun r => (measurable_eval d T t r).stronglyMeasurable)

/-- The raw filtration `𝔽̂^t` generated by the canonical process on `Ω̂^t`. -/
noncomputable def filtHat (d : ℕ) (T t : ℝ≥0) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace (OmegaHat d T t)) :=
  Filtration.natural (fun r (ω : OmegaHat d T t) => ω.1 r)
    (fun r => (measurable_evalHat d T t r).stronglyMeasurable)

/-- `‖x‖_T < η`, i.e. `sup_{0 ≤ r ≤ T} |x_r| < η`, without forming the supremum. -/
def SupNormLt {d : ℕ} (T : ℝ≥0) (x : ℝ≥0 → Rd d) (η : ℝ) : Prop :=
  ∃ c < η, ∀ r, r ≤ T → ‖x r‖ ≤ c

/-- `d_∞((s, x), (s', x')) < η`, where
`d_∞((s, x), (s', x')) = |s − s'| + sup_{0 ≤ r ≤ T} |x_{s ∧ r} − x'_{s' ∧ r}|` (2.1). -/
def DInfLt {d : ℕ} (T : ℝ≥0) (s : ℝ≥0) (x : ℝ≥0 → Rd d) (s' : ℝ≥0) (x' : ℝ≥0 → Rd d)
    (η : ℝ) : Prop :=
  ∃ c : ℝ, |(s : ℝ) - s'| + c < η ∧ ∀ r, r ≤ T → ‖x (min s r) - x' (min s' r)‖ ≤ c

/-- Concatenation `ω ⊗_t ω'` of `ω ∈ Ω^s` and `ω' ∈ Ω^t`:
`(ω ⊗_t ω')(r) = ω_{r ∧ t} + ω'_r − ω'_{r ∧ s}`. For `s ≤ t` (the only case used) the last
term vanishes and this is the paper's `ω_r 1_{[s,t)}(r) + (ω_t + ω'_r) 1_{[t,T]}(r)`. -/
def concat {d : ℕ} {T s : ℝ≥0} (ω : Omega d T s) (t : ℝ≥0) (ω' : Omega d T t) : Omega d T s :=
  ⟨fun r => ω.1 (min r t) + (ω'.1 r - ω'.1 (min r s)), by
    obtain ⟨hc, h0, hT⟩ := ω.2
    obtain ⟨hc', h0', hT'⟩ := ω'.2
    refine ⟨?_, ?_, ?_⟩
    · exact (hc.comp (continuous_id.min continuous_const)).add
        (hc'.sub (hc'.comp (continuous_id.min continuous_const)))
    · intro r hr
      show ω.1 (min r t) + (ω'.1 r - ω'.1 (min r s)) = 0
      have h1 : min r s = r := min_eq_left hr
      rw [h1, h0 _ ((min_le_left r t).trans hr), sub_self, add_zero]
    · intro r hr
      have e1 : ω.1 (min r t) = ω.1 (min T t) := by
        rcases le_total t T with h | h
        · rw [min_eq_right (h.trans hr), min_eq_right h]
        · rw [hT _ (le_min hr h), min_eq_left h]
      have e2 : ω'.1 r - ω'.1 (min r s) = ω'.1 T - ω'.1 (min T s) := by
        rcases le_total s T with h | h
        · rw [min_eq_right (h.trans hr), min_eq_right h, hT' r hr]
        · rw [hT' _ (le_min hr h), min_eq_left h, hT' r hr]
      show ω.1 (min r t) + (ω'.1 r - ω'.1 (min r s)) = ω.1 (min T t) + (ω'.1 T - ω'.1 (min T s))
      rw [e1, e2]⟩

/-- The shift `ω ↦ (ω_{r ∨ t} − ω_t)_r` from `Ω^s` onto `Ω^t`; for `s ≤ t` it is the unique
`ω'' ∈ Ω^t` with `ω = ω ⊗_t ω''` on `[t, T]`. -/
def shiftFrom {d : ℕ} {T s : ℝ≥0} (ω : Omega d T s) (t : ℝ≥0) : Omega d T t :=
  ⟨fun r => ω.1 (max r t) - ω.1 t, by
    obtain ⟨hc, _, hT⟩ := ω.2
    refine ⟨(hc.comp (continuous_id.max continuous_const)).sub continuous_const, ?_, ?_⟩
    · intro r hr
      simp [max_eq_right hr]
    · intro r hr
      show ω.1 (max r t) - ω.1 t = ω.1 (max T t) - ω.1 t
      rcases le_total t T with h | h
      · rw [max_eq_left (h.trans hr), max_eq_left h, hT r hr]
      · rw [hT _ (le_trans hr (le_max_left r t)), hT _ (le_trans h (le_max_right T t)),
          hT t h]⟩

lemma measurable_shiftFrom (d : ℕ) (T s t : ℝ≥0) :
    Measurable (fun ω : Omega d T s => shiftFrom ω t) := by
  refine Measurable.subtype_mk ?_
  exact measurable_pi_lambda _ fun r =>
    (measurable_eval d T s (max r t)).sub (measurable_eval d T s t)

/-- `P_0` is the Wiener measure on `Ω = Ω^0`: a probability measure under which, for every
coordinate `i` and every finite set of times `I ⊆ [0, T]`, `(ω_s^i)_{s ∈ I}` has the Brownian
finite-dimensional law `BrownianReal.projectiveFamily I`, and the `d` coordinate processes are
independent. -/
structure IsWiener {d : ℕ} {T : ℝ≥0} (P0 : Measure (Omega d T 0)) : Prop where
  prob : IsProbabilityMeasure P0
  law : ∀ (i : Fin d) (I : Finset ℝ≥0), (∀ s ∈ I, s ≤ T) →
    HasLaw (fun ω : Omega d T 0 => I.restrict (fun s => ω.1 s i))
      (BrownianReal.projectiveFamily I) P0
  indep : iIndepFun (fun (i : Fin d) (ω : Omega d T 0) (s : ℝ≥0) => ω.1 s i) P0

/-- The shifted Wiener measure `P^t_0 := P_0 ∘ (shift_t)⁻¹` on `Ω^t`, the law of
`(B_{r ∨ t} − B_t)_r`; by the Markov property it is the Wiener measure on `Ω^t`. -/
noncomputable def Pt {d : ℕ} {T : ℝ≥0} (P0 : Measure (Omega d T 0)) (t : ℝ≥0) :
    Measure (Omega d T t) :=
  P0.map (fun ω => shiftFrom ω t)

end ViscosityPPDE.Comparison


