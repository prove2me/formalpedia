  rw [PadicInt.zmod_congr_of_sub_mem_max_ideal x _ _ h1 h2, ZMod.natCast_zmod_val]

theorem toZMod_eq_zero_of_dvd {y : ℤ_[p]} (h : (p : ℤ_[p]) ∣ y) : PadicInt.toZMod y = 0 := by
  obtain ⟨z, rfl⟩ := h
