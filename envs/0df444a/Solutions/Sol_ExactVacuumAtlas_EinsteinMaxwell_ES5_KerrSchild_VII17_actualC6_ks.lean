section Helpers

variable {gb gbi : Metric 5} {v : Pt 5 → ℝ} {K : Pt 5 → Fin 5 → ℝ} {U V : Set (Pt 5)}

/-- Pointwise Einstein-form tensor (`R_ij = Λ g_ij` at `x`) has zero contraction on `g`-null `k`. -/
theorem einstein_form_contract_zero {R g : Fin 5 → Fin 5 → Pt 5 → ℝ} {x : Pt 5} {Λ : ℝ}
    (h : ∀ i j, R i j x = Λ * g i j x) {k : Fin 5 → ℝ} (hk : contract2 g x k = 0) :
    contract2 R x k = 0 := by
  have e : contract2 R x k = Λ * contract2 g x k := by
    unfold contract2
    simp only [h, Finset.mul_sum]
    exact Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by ring
  rw [e, hk, mul_zero]

end Helpers

