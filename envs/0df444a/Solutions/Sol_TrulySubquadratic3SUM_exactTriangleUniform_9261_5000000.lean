                                  linarith) (abs_nonneg _)
  have hC'0 : 0 ≤ C' := le_max_right _ _
  have hA : 0 ≤ C' * a ^ 2 := by positivity
  have hfinal : C' * (a ^ 2 * (X + Y)) + |C₁| * ((n : ℝ) * D + w + 1)
      + |C₃| * ((n : ℝ) * D + w + 1)
      ≤ (C' * a ^ 2 + |C₁| + |C₃|) * (X + Y + (n : ℝ) * D + w + 1) := by
    have e : (C' * a ^ 2 + |C₁| + |C₃|) * (X + Y + (n : ℝ) * D + w + 1)
        = C' * (a ^ 2 * (X + Y)) + |C₁| * ((n : ℝ) * D + w + 1) + |C₃| * ((n : ℝ) * D + w + 1)
          + C' * a ^ 2 * ((n : ℝ) * D + w + 1) + (|C₁| + |C₃|) * (X + Y) := by ring
    rw [e]
    have : 0 ≤ C' * a ^ 2 * ((n : ℝ) * D + w + 1) := mul_nonneg hA hrest
    have : 0 ≤ (|C₁| + |C₃|) * (X + Y) := by positivity
    linarith
  calc T n D w 1 + C₁ * ((n : ℝ) * D + w + 1) + C₃ * ((w : ℝ) + 1)
      ≤ C' * (a ^ 2 * (X + Y)) + |C₁| * ((n : ℝ) * D + w + 1)
          + |C₃| * ((n : ℝ) * D + w + 1) := by linarith
    _ ≤ (C' * a ^ 2 + |C₁| + |C₃|) * (X + Y + (n : ℝ) * D + w + 1) := hfinal
    _ = (C' * a ^ 2 + |C₁| + |C₃|) * ((n : ℝ) ^ 2 * Real.log D ^ 2 / (D : ℝ) ^ (0.07618 : ℝ)
          + (w : ℝ) * (D : ℝ) ^ (0.44274 : ℝ) * Real.log D + (n : ℝ) * D + w + 1) := rfl

end Light.Sec3
