-- Source module: Solutions.KFDBase
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KFC (marks marks_zero isMk NM toUL cUL uK uR uY uB)

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem moveCost_ge (L : ℕ) : 38 * L + 41 ≤ moveCost L := by simp [moveCost]; omega

theorem zsz_toNat_le (z : ℤ) : zsz ((z.toNat : ℕ) : ℤ) ≤ zsz z :=
  zsz_mono (by omega)

theorem fcost_le_cost : ∀ (p : RS) (s : IState HS), fcost p s ≤ 100 * p.cost s
  | .skip, s => by simp [fcost, RS.cost]
  | .asg i e, s => by simp only [fcost, RS.cost]; omega
  | .push i e, s => by simp only [fcost, RS.cost]; omega
  | .pop i, s => by simp only [fcost, RS.cost]; omega
  | .seq a b, s => by
    have := fcost_le_cost a s; have := fcost_le_cost b (a.run s)
    simp only [fcost, RS.cost]; omega
  | .ite c a b, s => by
    have := fcost_le_cost a s; have := fcost_le_cost b s
    simp only [fcost, RS.cost]; split_ifs <;> omega
  | .rep i n b, s => by
    simp only [fcost, RS.cost]
    have hz := zsz_toNat_le (n.eval s)
    have hm := moveCost_ge (zsz (n.eval s))
    generalize (n.eval s).toNat = N at hz ⊢
    have hsum : (∑ k ∈ Finset.range N, (fcost b (repSt i n b s k) + 31)) + 1000 * N ≤
        100 * ∑ k ∈ Finset.range N, (b.cost (repSt i n b s k) +
          asgCost i (decE i) (b.run (repSt i n b s k)) + 30) := by
      have e1 : (∑ k ∈ Finset.range N, (fcost b (repSt i n b s k) + 31)) + 1000 * N =
          ∑ k ∈ Finset.range N, (fcost b (repSt i n b s k) + 1031) := by
        rw [Finset.sum_add_distrib, Finset.sum_add_distrib, Finset.sum_const, Finset.sum_const,
          Finset.card_range, smul_eq_mul, smul_eq_mul]; ring
      rw [e1, Finset.mul_sum]
      refine Finset.sum_le_sum fun k _ => ?_
      have := fcost_le_cost b (repSt i n b s k)
      omega
    simp only [cUL] at *
    omega

theorem FSp.mono {p : RS} {s t : IState HS} {c c' : ℕ} (h : FSp p s t c) (hc : c ≤ c') :
    FSp p s t c' := ⟨h.1, h.2.1, le_trans h.2.2 hc⟩

theorem FSp.seq {a b : RS} {s t u : IState HS} {c1 c2 : ℕ} (ha : FSp a s t c1) (hb : FSp b t u c2) :
    FSp (.seq a b) s u (c1 + c2) := by
  refine ⟨⟨ha.1, ?_⟩, ?_, ?_⟩
  · rw [ha.2.1]; exact hb.1
  · simp only [RS.run, ha.2.1, hb.2.1]
  · simp only [fcost]; rw [ha.2.1]; have := ha.2.2; have := hb.2.2; omega

/-- Every `Sp` transfers with a factor `100`. -/
theorem FSp.of_sp {p : RS} {s t : IState HS} {c : ℕ} (h : KIL.Sp p s t c) : FSp p s t (100 * c) :=
  ⟨h.1, h.2.1, le_trans (fcost_le_cost p s) (Nat.mul_le_mul_left _ h.2.2)⟩

end KFD

end NLogN

end

