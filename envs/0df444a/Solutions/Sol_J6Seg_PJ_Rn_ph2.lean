/-!
# B-line IL, `J` pre-table (B5-J), part 6: the four loops of the parameter phase

Each loop runs on the counter stack `48` and changes one or two registers:
`sqL` (`5 := √d`), `lgL` (`24 := 2^⌊log₂ x⌋`), `szL` (`8 := size x`, `11` scratch),
`pwL` (`x := 2^N`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS E Function

theorem nrg48 : cLC ∉ rg := by decide

section loops
variable {W : ℕ} {c : Cs}

theorem upd_upd_eq {vb : Vr} {i : Fin HS} (a b : ℤ) : update (update vb i a) i b = update vb i b :=
  update_idem _ _ _

/-- `5 := √d` (from `5 = 0`, `6 = d + 1`, `2 = d`). -/
theorem sqL {vb : Vr} {d : ℕ} (hvb : BV W vb) (h5 : vb 5 = 0) (h6 : vb 6 = ((d + 1 : ℕ) : ℤ))
    (h2 : vb 2 = d) (hd : d + 1 < 2 ^ W) (hc : c cLC = []) :
    Rn (.rep cLC (.reg 6) (PJ.asgs [(5, eSq)])) vb c
      (fun v => v = update vb 5 (Nat.sqrt d : ℤ) ∧ BV W v) c (cLoop W (d + 1) (cA W [(5, eSq)])) := by
  have hW : 1 ≤ 2 ^ W := Nat.one_le_two_pow
  have h := Rn.loopA (c := c) (C := cLC) (rN := 6) (l := [(5, eSq)]) nrg48 (by decide) (by decide)
    (by decide) (W := W) (by simp [lbA, eSq, E.lb]; omega) (N := d + 1) hd
    (Iv := fun k v => v = update vb 5 ((min k (Nat.sqrt d) : ℕ) : ℤ))
    (fun k hk v hI hB => by
      subst hI
      have e : eSq.den (update vb 5 ((min k (Nat.sqrt d) : ℕ) : ℤ)) =
          ((min (k + 1) (Nat.sqrt d) : ℕ) : ℤ) := by
        rw [← sqS_step d k]; simp [eSq, E.den, update_apply, h2]
      refine ⟨⟨?_, trivial⟩, ?_⟩
      · rw [e, abs_of_nonneg (by positivity)]
        have : min (k + 1) (Nat.sqrt d) ≤ d := le_trans (min_le_right _ _) (Nat.sqrt_le_self d)
        exact_mod_cast (by omega : min (k + 1) (Nat.sqrt d) ≤ 2 ^ W)
      · simp only [runA]; rw [e, upd_upd_eq])
    hc (by simp [← h5]) hvb (by rw [h6])
  refine h.mono (fun v ⟨hv, hB⟩ => ⟨?_, hB⟩) le_rfl
  rw [hv, min_eq_right (by have := Nat.sqrt_le_self d; omega)]

theorem log_le_self' (x : ℕ) : Nat.log 2 x ≤ x := by
  rcases Nat.eq_zero_or_pos x with rfl | hx
  · simp
  · have h1 := Nat.pow_log_le_self 2 hx.ne'
    have h2 := Nat.lt_two_pow_self (n := Nat.log 2 x)
    omega

/-- `24 := 2^⌊log₂ x⌋` (from `24 = 1`, `6 = x`). -/
theorem lgL {vb : Vr} {x : ℕ} (hvb : BV W vb) (h24 : vb 24 = 1) (h6 : vb 6 = x)
    (hx : 2 * x + 1 < 2 ^ W) (hc : c cLC = []) :
    Rn (.rep cLC (.reg 6) (PJ.asgs [(24, eLg)])) vb c
      (fun v => v = update vb 24 ((2 ^ Nat.log 2 x : ℕ) : ℤ) ∧ BV W v) c
      (cLoop W x (cA W [(24, eLg)])) := by
  have hW : 2 ≤ 2 ^ W := by omega
  have h := Rn.loopA (c := c) (C := cLC) (rN := 6) (l := [(24, eLg)]) nrg48 (by decide) (by decide)
    (by decide) (W := W) (by simp [lbA, eLg, E.lb]; omega) (N := x) (by omega)
    (Iv := fun k v => v = update vb 24 ((2 ^ min k (Nat.log 2 x) : ℕ) : ℤ))
    (fun k hk v hI hB => by
      subst hI
      have e : eLg.den (update vb 24 ((2 ^ min k (Nat.log 2 x) : ℕ) : ℤ)) =
          ((2 ^ min (k + 1) (Nat.log 2 x) : ℕ) : ℤ) := by
        rw [← lgS_step x k]; simp [eLg, E.den, update_apply, h6]
      refine ⟨⟨?_, trivial⟩, ?_⟩
      · rw [e, abs_of_nonneg (by positivity)]
        have : 2 ^ min (k + 1) (Nat.log 2 x) ≤ 2 * x + 1 := by
          rcases Nat.eq_zero_or_pos x with rfl | hx0
          · simp
          · have := Nat.pow_le_pow_right (by norm_num : 0 < 2) (min_le_right (k + 1) (Nat.log 2 x))
            have := Nat.pow_log_le_self 2 hx0.ne'
            omega
        exact_mod_cast (by omega : 2 ^ min (k + 1) (Nat.log 2 x) ≤ 2 ^ W)
      · simp only [runA]; rw [e, upd_upd_eq])
    hc (by simp [← h24]) hvb h6
  refine h.mono (fun v ⟨hv, hB⟩ => ⟨?_, hB⟩) le_rfl
  rw [hv, min_eq_right (log_le_self' x)]

end loops

end J6Seg.PJ

end

