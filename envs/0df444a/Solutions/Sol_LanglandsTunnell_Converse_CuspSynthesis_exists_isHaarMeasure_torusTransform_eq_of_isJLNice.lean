private theorem t0383 {z : (AdeleRing (𝓞 K) K)ˣ}
    (harch : ∀ w : InfinitePlace K, ((z : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 w = 1)
