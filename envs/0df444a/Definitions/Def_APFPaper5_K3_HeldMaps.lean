import Definitions.Def_APFPaper5_K3_ContinuationProfile

set_option autoImplicit false
namespace APFPaper5.K3

/-- Entrywise sum. -/
def add2 (x y : Held2) : Held2 := ⟨x.a1 + y.a1, x.a2 + y.a2, x.b1 + y.b1, x.b2 + y.b2⟩

/-- Entrywise scaling. -/
def smul2 (r : ℝ) (x : Held2) : Held2 := ⟨r * x.a1, r * x.a2, r * x.b1, r * x.b2⟩

/-- Recombination of the two components with real weights. -/
def mix (c s : ℝ) (h : Held2) : Held2 :=
  ⟨c * h.a1 - s * h.b1, c * h.a2 - s * h.b2, s * h.a1 + c * h.b1, s * h.a2 + c * h.b2⟩

/-- A quarter turn in one plane only: the value of A against the value of B. -/
def onePlaneQuarter (h : Held2) : Held2 := ⟨-h.b1, h.a2, h.a1, h.b2⟩

/-- The cost of A plus the cost of B. -/
def totalCost (h : Held2) : ℝ := recA h + recB h

def AdditiveHomogeneous (T : Held2 → Held2) : Prop :=
  (∀ x y : Held2, T (add2 x y) = add2 (T x) (T y)) ∧ ∀ (r : ℝ) (x : Held2), T (smul2 r x) = smul2 r (T x)

def PreservesTotalCost (T : Held2 → Held2) : Prop := ∀ h : Held2, totalCost (T h) = totalCost h

def CommutesWithQuarter (T : Held2 → Held2) : Prop :=
  ∀ h : Held2, T (commonTurn 0 1 h) = commonTurn 0 1 (T h)

def AnticommutesWithQuarter (T : Held2 → Held2) : Prop :=
  ∀ h : Held2, T (commonTurn 0 1 h) = neg2 (commonTurn 0 1 (T h))

/-- A common turn applied before `T` leaves the continuation profile after `T` unchanged. -/
def CommonTurnUnseenAfter (T : Held2 → Held2) : Prop :=
  ∀ c s : ℝ, c * c + s * s = 1 → ∀ h : Held2,
    plainAfterTurn (T (commonTurn c s h)) = plainAfterTurn (T h)

/-- The maps built from common turns, turns of one component and recombinations. -/
inductive BuiltFromTurns : (Held2 → Held2) → Prop
  | common (c s : ℝ) (hcs : c * c + s * s = 1) : BuiltFromTurns (commonTurn c s)
  | relative (c s : ℝ) (hcs : c * c + s * s = 1) : BuiltFromTurns (relativeTurn c s)
  | recombine (c s : ℝ) (hcs : c * c + s * s = 1) : BuiltFromTurns (mix c s)
  | comp {S T : Held2 → Held2} (hS : BuiltFromTurns S) (hT : BuiltFromTurns T) :
      BuiltFromTurns (fun h => S (T h))

end APFPaper5.K3


