variable {R : Type u} [CommRing R]

theorem eq_one_of_mul_self {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f)
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (y : SchemeHomOver t f) (h : L.mul t y y = y) :
    y = L.one t := by
  have := congrArg (L.mul t (L.inv t y)) h
  rw [← L.mul_assoc, L.inv_mul_cancel, L.one_mul] at this
  exact this

theorem map_one_of_hom {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (L' : RelativeGroupLaw R f') (φ : A ⟶ A') (hφ : φ ≫ f' = f)
    (hhom : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
      mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    mapPt φ hφ (L.one t) = L'.one t := by
  apply eq_one_of_mul_self
  rw [← hhom, L.one_mul]

theorem map_nsmulPt_of_hom {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (L' : RelativeGroupLaw R f') (φ : A ⟶ A') (hφ : φ ≫ f' = f)
    (hhom : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
      mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (n : ℕ) (P : SchemeHomOver t f) :
    mapPt φ hφ (nsmulPt L t n P) = nsmulPt L' t n (mapPt φ hφ P) := by
  induction n with
  | zero => exact map_one_of_hom L L' φ hφ hhom t
  | succ n ih => simp only [nsmulPt]; rw [hhom, ih]

theorem mapPt_mapPt {A A' A'' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    {f'' : A'' ⟶ Spec (CommRingCat.of R)} (φ : A ⟶ A') (hφ : φ ≫ f' = f) (ψ : A' ⟶ A'') (hψ : ψ ≫ f'' = f')
    {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f) :
    mapPt ψ hψ (mapPt φ hφ P) = mapPt (φ ≫ ψ) (by rw [Category.assoc, hψ, hφ]) P := by
  apply Subtype.ext; simp [mapPt, Category.assoc]

theorem mapPt_congr {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    {φ φ' : A ⟶ A'} (h : φ = φ') (hφ : φ ≫ f' = f) (hφ' : φ' ≫ f' = f)
    {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f) :
    mapPt φ hφ P = mapPt φ' hφ' P := by
  subst h; rfl

theorem mapPt_injective_of_isIso {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    (φ : A ⟶ A') (hφ : φ ≫ f' = f) [IsIso φ]
    {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} {P Q : SchemeHomOver t f} (h : mapPt φ hφ P = mapPt φ hφ Q) :
    P = Q := by
  apply Subtype.ext
  have := congrArg Subtype.val h
  simp only [mapPt] at this
  exact (cancel_mono φ).1 this

end GLUEaux

namespace GLUEact

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {S : Type u} [CommRing S]

theorem natCast_mem (hΛ : IsOrder Λ) (n : ℕ) : ((n : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
  have : ((n : ℚ) : ℍ[ℚ, a, b]) = (n : ℤ) • (1 : ℍ[ℚ, a, b]) := by
    rw [zsmul_eq_mul, mul_one]; norm_cast
  rw [this]; exact Λ.smul_mem _ hΛ.one_mem

theorem act_zero_apply (E : FakeEllipticCurve Λ N S) (h0 : (0 : ℍ[ℚ, a, b]) ∈ Λ)
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f) :
    pushPt (E.act ⟨0, h0⟩) (E.act_over _) P = E.L.one t := by
  apply GLUEaux.eq_one_of_mul_self
  have := E.act_add ⟨0, h0⟩ ⟨0, h0⟩ t P
  have e : (⟨0, h0⟩ + ⟨0, h0⟩ : ↥Λ) = ⟨0, h0⟩ := by apply Subtype.ext; simp
  rw [e] at this
  exact this.symm

theorem act_natCast_apply (E : FakeEllipticCurve Λ N S) (hΛ : IsOrder Λ) (n : ℕ)
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f) :
    pushPt (E.act ⟨((n : ℚ) : ℍ[ℚ, a, b]), natCast_mem hΛ n⟩) (E.act_over _) P = nsmulPt E.L t n P := by
  induction n with
  | zero =>
    have e : (⟨((0 : ℕ) : ℚ), natCast_mem hΛ 0⟩ : ↥Λ) = ⟨0, by simpa using natCast_mem hΛ 0⟩ := by
      apply Subtype.ext; simp
    rw [show pushPt (E.act ⟨(((0 : ℕ) : ℚ) : ℍ[ℚ, a, b]), natCast_mem hΛ 0⟩) (E.act_over _) P =
        pushPt (E.act ⟨0, by simpa using natCast_mem hΛ 0⟩) (E.act_over _) P from by
          simp only [pushPt]; exact GLUEaux.mapPt_congr (by rw [e]) _ _ P]
    exact act_zero_apply E _ t P
  | succ n ih =>
    have e : (⟨(((n + 1 : ℕ) : ℚ) : ℍ[ℚ, a, b]), natCast_mem hΛ (n + 1)⟩ : ↥Λ) =
        ⟨((n : ℚ) : ℍ[ℚ, a, b]), natCast_mem hΛ n⟩ + ⟨1, hΛ.one_mem⟩ := by
      apply Subtype.ext; push_cast; rfl
    rw [show pushPt (E.act ⟨(((n + 1 : ℕ) : ℚ) : ℍ[ℚ, a, b]), natCast_mem hΛ (n + 1)⟩) (E.act_over _) P =
        pushPt (E.act (⟨((n : ℚ) : ℍ[ℚ, a, b]), natCast_mem hΛ n⟩ + ⟨1, hΛ.one_mem⟩)) (E.act_over _) P from by
          simp only [pushPt]; exact GLUEaux.mapPt_congr (by rw [e]) _ _ P]
    rw [E.act_add, ih]
    simp only [nsmulPt]
    congr 1
    simp only [pushPt]
    rw [GLUEaux.mapPt_congr (E.act_one hΛ.one_mem) _ (by simp) P]
    apply Subtype.ext; simp [mapPt]

end GLUEact

namespace GLUEgrp

variable {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f)
  {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R))

theorem inv_inv (x : SchemeHomOver t f) : L.inv t (L.inv t x) = x := by
  calc L.inv t (L.inv t x) = L.mul t (L.inv t (L.inv t x)) (L.one t) := (L.mul_one t _).symm
    _ = L.mul t (L.inv t (L.inv t x)) (L.mul t (L.inv t x) x) := by rw [L.inv_mul_cancel]
    _ = L.mul t (L.mul t (L.inv t (L.inv t x)) (L.inv t x)) x := by rw [L.mul_assoc]
    _ = x := by rw [L.inv_mul_cancel, L.one_mul]

theorem mul_inv_cancel (x : SchemeHomOver t f) : L.mul t x (L.inv t x) = L.one t := by
  have := L.inv_mul_cancel t (L.inv t x)
  rwa [inv_inv] at this

theorem eq_of_mul_inv_eq_one {x y : SchemeHomOver t f} (h : L.mul t x (L.inv t y) = L.one t) : x = y := by
  have := congrArg (fun z => L.mul t z y) h
  rw [L.mul_assoc, L.inv_mul_cancel, L.mul_one, L.one_mul] at this
  exact this

theorem nsmulPt_add (n m : ℕ) (P : SchemeHomOver t f) :
    nsmulPt L t (n + m) P = L.mul t (nsmulPt L t n P) (nsmulPt L t m P) := by
  induction m with
  | zero => simp [nsmulPt, L.mul_one]
  | succ m ih => rw [Nat.add_succ]; simp only [nsmulPt]; rw [ih, L.mul_assoc]

theorem nsmulPt_one_pt (n : ℕ) : nsmulPt L t n (L.one t) = L.one t := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [nsmulPt]; rw [ih, L.one_mul]

theorem nsmulPt_mul (n m : ℕ) (P : SchemeHomOver t f) :
    nsmulPt L t (n * m) P = nsmulPt L t n (nsmulPt L t m P) := by
  induction n with
  | zero => simp [nsmulPt]
  | succ n ih => rw [Nat.succ_mul, nsmulPt_add, ih]; simp only [nsmulPt]

theorem nsmulPt_mod_eq_one {n m : ℕ} (P : SchemeHomOver t f)
    (hn : nsmulPt L t n P = L.one t) (hm : nsmulPt L t m P = L.one t) : nsmulPt L t (n % m) P = L.one t := by
  have e : n = n / m * m + n % m := (Nat.div_add_mod' n m).symm
  have := hn
  rw [e, nsmulPt_add, nsmulPt_mul, hm, nsmulPt_one_pt, L.one_mul] at this
  exact this

theorem eq_one_of_nsmulPt_eq_one_of_coprime {r N : ℕ} (hc : Nat.Coprime r N) (P : SchemeHomOver t f)
    (hr : nsmulPt L t r P = L.one t) (hN : nsmulPt L t N P = L.one t) : P = L.one t := by
  have key : ∀ a b : ℕ, nsmulPt L t a P = L.one t → nsmulPt L t b P = L.one t → nsmulPt L t (Nat.gcd a b) P = L.one t := by
    intro a b
    refine Nat.gcd.induction a b (fun n _ hn => by simpa using hn) (fun m n _ ih hm hn => ?_)
    rw [Nat.gcd_rec]
    exact ih (nsmulPt_mod_eq_one L t P hn hm) hm
  have := key r N hr hN
  rw [hc] at this
  simpa [nsmulPt, L.one_mul] using this

end GLUEgrp

theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) {N : ℕ} [NeZero N]
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓq : ℓ ≠ q) (hℓq' : ℓ ≠ q') :
    ∃ (n : ℕ) (T : Fin n → FakeEllipticCurve Λ N (AlgebraicClosure ℚ)),
      ∀ (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ)), (∀ i : Fin n, ¬ FakeEllipticCurve.Iso E (T i)) →
        ∀ (K K' : E.ExtraLevel ℓ) (d d' : FakeEllipticCurve Λ N (AlgebraicClosure ℚ)),
          FakeEllipticCurve.IsLevelIsogeny ℓ (⟨E, K⟩ : FakeEllipticCurve.WithExtraLevel Λ N ℓ (AlgebraicClosure ℚ)) d →
          FakeEllipticCurve.IsLevelIsogeny ℓ (⟨E, K'⟩ : FakeEllipticCurve.WithExtraLevel Λ N ℓ (AlgebraicClosure ℚ)) d' →
          FakeEllipticCurve.Iso d d' →
            ∀ {T' : Scheme.{0}} (t : T' ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (P : SchemeHomOver t E.f),
              FactorsThrough K.levK P ↔ FactorsThrough K'.levK P := by
  classical
  have hO : IsOrder Λ := hΛ.1
  have hℓ : ℓ.Prime := Fact.out
  have hℓK : ((ℓ : ℕ) : AlgebraicClosure ℚ) ≠ 0 := by exact_mod_cast hℓ.ne_zero
  have hℓΛ : ((ℓ : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := GLUEact.natCast_mem hO ℓ
  obtain ⟨m, S, hS⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.exists_finset_forall_not_iso_forall_quasiInverse_exists_eq_nsmulPt
    hqq' hB Λ hΛ N (ℓ ^ 2) (pow_pos hℓ.pos 2)
  refine ⟨m, S, ?_⟩
  intro E hE K K' d d' hK hK' hdd' T' t P
  obtain ⟨φ, hφ, ψ, hψ, φ_hom, ψ_hom, φ_act, ψ_act, hℓlaw, hker, φ_lev⟩ := hK
  obtain ⟨φ', hφ', ψ', hψ', φ'_hom, ψ'_hom, φ'_act, ψ'_act, hℓlaw', hker', φ'_lev⟩ := hK'
  obtain ⟨θ, hθ, θ_hom, θ_act, θ_lev⟩ := hdd'

  have hψφ : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q : SchemeHomOver s E.f),
      mapPt ψ hψ (mapPt φ hφ Q) = nsmulPt E.L s ℓ Q := by
    intro T s Q
    rw [GLUEaux.mapPt_mapPt, GLUEaux.mapPt_congr (hℓlaw hℓΛ).1 _ (E.act_over _) Q]
    exact GLUEact.act_natCast_apply E hO ℓ s Q
  have hφψ : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q : SchemeHomOver s d.f),
      mapPt φ hφ (mapPt ψ hψ Q) = nsmulPt d.L s ℓ Q := by
    intro T s Q
    rw [GLUEaux.mapPt_mapPt, GLUEaux.mapPt_congr (hℓlaw hℓΛ).2 _ (d.act_over _) Q]
    exact GLUEact.act_natCast_apply d hO ℓ s Q
  have hψφ' : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q : SchemeHomOver s E.f),
      mapPt ψ' hψ' (mapPt φ' hφ' Q) = nsmulPt E.L s ℓ Q := by
    intro T s Q
    rw [GLUEaux.mapPt_mapPt, GLUEaux.mapPt_congr (hℓlaw' hℓΛ).1 _ (E.act_over _) Q]
    exact GLUEact.act_natCast_apply E hO ℓ s Q
  have hφψ' : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q : SchemeHomOver s d'.f),
      mapPt φ' hφ' (mapPt ψ' hψ' Q) = nsmulPt d'.L s ℓ Q := by
    intro T s Q
    rw [GLUEaux.mapPt_mapPt, GLUEaux.mapPt_congr (hℓlaw' hℓΛ).2 _ (d'.act_over _) Q]
    exact GLUEact.act_natCast_apply d' hO ℓ s Q

  have hθinv : θ.inv ≫ d.f = d'.f := by rw [← hθ, Iso.inv_hom_id_assoc]
  have θinv_hom : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q R : SchemeHomOver s d'.f),
      mapPt θ.inv hθinv (d'.L.mul s Q R) = d.L.mul s (mapPt θ.inv hθinv Q) (mapPt θ.inv hθinv R) := by
    intro T s Q R
    apply GLUEaux.mapPt_injective_of_isIso θ.hom hθ
    rw [θ_hom, GLUEaux.mapPt_mapPt, GLUEaux.mapPt_mapPt, GLUEaux.mapPt_mapPt]
    have e : ∀ X : SchemeHomOver s d'.f, mapPt (θ.inv ≫ θ.hom) (by rw [Category.assoc, hθ, hθinv]) X = X := by
      intro X; apply Subtype.ext; simp [mapPt]
    rw [e, e, e]
  have θinv_act : ∀ x : ↥Λ, d'.act x ≫ θ.inv = θ.inv ≫ d.act x := by
    intro x
    rw [← cancel_mono θ.hom, Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id, θ_act x, Iso.inv_hom_id_assoc]

  have hα : (φ ≫ θ.hom ≫ ψ') ≫ E.f = E.f := by rw [Category.assoc, Category.assoc, hψ', hθ, hφ]
  have hβ : (φ' ≫ θ.inv ≫ ψ) ≫ E.f = E.f := by rw [Category.assoc, Category.assoc, hψ, hθinv, hφ']
  have α_eq : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q : SchemeHomOver s E.f),
      mapPt (φ ≫ θ.hom ≫ ψ') hα Q = mapPt ψ' hψ' (mapPt θ.hom hθ (mapPt φ hφ Q)) := by
    intro T s Q; apply Subtype.ext; simp [mapPt]
  have β_eq : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q : SchemeHomOver s E.f),
      mapPt (φ' ≫ θ.inv ≫ ψ) hβ Q = mapPt ψ hψ (mapPt θ.inv hθinv (mapPt φ' hφ' Q)) := by
    intro T s Q; apply Subtype.ext; simp [mapPt]
  have α_hom : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q R : SchemeHomOver s E.f),
      mapPt (φ ≫ θ.hom ≫ ψ') hα (E.L.mul s Q R) = E.L.mul s (mapPt (φ ≫ θ.hom ≫ ψ') hα Q) (mapPt (φ ≫ θ.hom ≫ ψ') hα R) := by
    intro T s Q R; rw [α_eq, α_eq, α_eq, φ_hom, θ_hom, ψ'_hom]
  have β_hom : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q R : SchemeHomOver s E.f),
      mapPt (φ' ≫ θ.inv ≫ ψ) hβ (E.L.mul s Q R) = E.L.mul s (mapPt (φ' ≫ θ.inv ≫ ψ) hβ Q) (mapPt (φ' ≫ θ.inv ≫ ψ) hβ R) := by
    intro T s Q R; rw [β_eq, β_eq, β_eq, φ'_hom, θinv_hom, ψ_hom]
  have α_act : ∀ x : ↥Λ, E.act x ≫ (φ ≫ θ.hom ≫ ψ') = (φ ≫ θ.hom ≫ ψ') ≫ E.act x := by
    intro x
    rw [← Category.assoc, φ_act, Category.assoc, ← Category.assoc (d.act x), θ_act, Category.assoc, ψ'_act]
    simp only [Category.assoc]
  have β_act : ∀ x : ↥Λ, E.act x ≫ (φ' ≫ θ.inv ≫ ψ) = (φ' ≫ θ.inv ≫ ψ) ≫ E.act x := by
    intro x
    rw [← Category.assoc, φ'_act, Category.assoc, ← Category.assoc (d'.act x), θinv_act, Category.assoc, ψ_act]
    simp only [Category.assoc]

  have hβα : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q : SchemeHomOver s E.f),
      mapPt (φ' ≫ θ.inv ≫ ψ) hβ (mapPt (φ ≫ θ.hom ≫ ψ') hα Q) = nsmulPt E.L s (ℓ ^ 2) Q ∧
      mapPt (φ ≫ θ.hom ≫ ψ') hα (mapPt (φ' ≫ θ.inv ≫ ψ) hβ Q) = nsmulPt E.L s (ℓ ^ 2) Q := by
    intro T s Q
    constructor
    · rw [α_eq, β_eq, hφψ', GLUEaux.map_nsmulPt_of_hom d'.L d.L θ.inv hθinv θinv_hom, GLUEaux.mapPt_mapPt θ.hom hθ θ.inv hθinv]
      have e : mapPt (θ.hom ≫ θ.inv) (by rw [Category.assoc, hθinv, hθ]) (mapPt φ hφ Q) = mapPt φ hφ Q := by
        apply Subtype.ext; simp [mapPt]
      rw [e, GLUEaux.map_nsmulPt_of_hom d.L E.L ψ hψ ψ_hom, hψφ, pow_two, GLUEgrp.nsmulPt_mul]
    · rw [β_eq, α_eq, hφψ, GLUEaux.map_nsmulPt_of_hom d.L d'.L θ.hom hθ θ_hom, GLUEaux.mapPt_mapPt θ.inv hθinv θ.hom hθ]
      have e : mapPt (θ.inv ≫ θ.hom) (by rw [Category.assoc, hθ, hθinv]) (mapPt φ' hφ' Q) = mapPt φ' hφ' Q := by
        apply Subtype.ext; simp [mapPt]
      rw [e, GLUEaux.map_nsmulPt_of_hom d'.L E.L ψ' hψ' ψ'_hom, hψφ', pow_two, GLUEgrp.nsmulPt_mul]
  obtain ⟨kk, hk⟩ := hS E hE (φ ≫ θ.hom ≫ ψ') hα (φ' ≫ θ.inv ≫ ψ) hβ α_hom α_act β_hom β_act hβα

  have conn : ∀ (X : FakeEllipticCurve Λ N (AlgebraicClosure ℚ)), ConnectedSpace X.A := by
    intro X
    rw [connectedSpace_iff_univ]
    obtain ⟨s₀⟩ := (inferInstance : Nonempty ↥(Spec (CommRingCat.of (AlgebraicClosure ℚ))))
    have := X.bundle.connectedFibres s₀
    have huniv : X.f.base ⁻¹' {s₀} = Set.univ := by
      ext x; simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_univ, iff_true]
      exact Subsingleton.elim _ _
    rwa [huniv] at this
  have nsmul_eq : ∀ (X : FakeEllipticCurve Λ N (AlgebraicClosure ℚ)) (n : ℕ)
      (Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) X.f), X.L.nsmul _ n Q = nsmulPt X.L _ n Q := by
    intro X n Q
    induction n with
    | zero => rfl
    | succ n ih => rw [GoodReductionJacobian.RelativeGroupLaw.nsmul_succ, ih]; rfl
  have hsurj : ∀ (X : FakeEllipticCurve Λ N (AlgebraicClosure ℚ)) (Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) X.f),
      ∃ Q₁, nsmulPt X.L _ ℓ Q₁ = Q := by
    intro X Q
    haveI : Smooth X.f := X.bundle.smooth
    haveI := conn X
    obtain ⟨Q₁, h⟩ := GoodReductionJacobian.RelativeGroupLaw.nsmul_surjective_of_isAlgClosed_of_connectedSpace
      X.L (fun t x y => X.comm t x y) ℓ (isUnit_iff_ne_zero.2 hℓK) Q
    exact ⟨Q₁, by rw [← nsmul_eq]; exact h⟩

  have K_nsmul : ∀ (L' : E.ExtraLevel ℓ) {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (n : ℕ) (Q : SchemeHomOver s E.f),
      FactorsThrough L'.levK Q → FactorsThrough L'.levK (nsmulPt E.L s n Q) := by
    intro L' T s n Q hQ
    induction n with
    | zero => exact L'.levK_one s
    | succ n ih => exact (L'.levK_sub s _ _ ih hQ).1

  obtain ⟨eK, -⟩ := K.levK_fibre (AlgebraicClosure ℚ) (RingHom.id _) hℓK
  have hgp : geomPoint (S := AlgebraicClosure ℚ) (AlgebraicClosure ℚ) (RingHom.id (AlgebraicClosure ℚ)) = 𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ))) := by
    simp [geomPoint]
  rw [hgp] at eK
  have hne : ∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f, FactorsThrough K.levK P ∧ P ≠ E.L.one _ := by
    by_contra hcon
    push_neg at hcon
    have hsub : Subsingleton {P : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f // FactorsThrough K.levK P} :=
      ⟨fun x y => Subtype.ext ((hcon x.1 x.2).trans (hcon y.1 y.2).symm)⟩
    have h1 : Nat.card (ZMod ℓ × ZMod ℓ) ≤ 1 := by
      rw [Nat.card_congr eK]
      haveI : Finite {P : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f // FactorsThrough K.levK P} := Finite.of_equiv _ eK
      exact Finite.card_le_one_iff_subsingleton.2 hsub
    rw [Nat.card_prod, Nat.card_zmod] at h1
    nlinarith [hℓ.two_le]

  have α_K : ∀ (Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f), FactorsThrough K.levK Q →
      mapPt (φ ≫ θ.hom ≫ ψ') hα Q = E.L.one _ := by
    intro Q hQ
    rw [α_eq, (hker _ Q).2 hQ, GLUEaux.map_one_of_hom d.L d'.L θ.hom hθ θ_hom,
      GLUEaux.map_one_of_hom d'.L E.L ψ' hψ' ψ'_hom]
  have α_kk : ∀ (Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f), FactorsThrough K.levK Q →
      nsmulPt E.L _ kk Q = E.L.one _ := by
    intro Q hQ
    rcases hk with h | h
    · rw [← h _ Q]; exact α_K Q hQ
    · have := α_K Q hQ
      rw [h _ Q] at this
      rw [← GLUEgrp.inv_inv E.L _ (nsmulPt E.L _ kk Q), this]

      have h1 := GLUEgrp.mul_inv_cancel E.L (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) (E.L.one _)
      rwa [E.L.one_mul] at h1
  have hdvd : ℓ ∣ kk := by
    by_contra hnd
    obtain ⟨P₁, hP₁K, hP₁ne⟩ := hne
    have hcop : Nat.Coprime kk ℓ := (Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd hℓ).2 hnd))
    exact hP₁ne (GLUEgrp.eq_one_of_nsmulPt_eq_one_of_coprime E.L _ hcop P₁ (α_kk P₁ hP₁K) (K.levK_torsion _ P₁ hP₁K))
  obtain ⟨k₁, hk₁⟩ := hdvd

  have stepB : ∀ (Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f),
      mapPt φ' hφ' Q = d'.L.one _ → mapPt φ hφ Q = d.L.one _ := by
    intro Q hQ
    obtain ⟨Q₁, hQ₁⟩ := hsurj E Q
    obtain ⟨R₂, hR₂⟩ := hsurj d (mapPt θ.inv hθinv (mapPt φ' hφ' Q₁))

    have hφP₂ : mapPt φ hφ (mapPt ψ hψ R₂) = mapPt θ.inv hθinv (mapPt φ' hφ' Q₁) := by
      rw [hφψ, hR₂]

    have hQα : Q = mapPt (φ ≫ θ.hom ≫ ψ') hα (mapPt ψ hψ R₂) := by
      rw [α_eq, hφP₂, GLUEaux.mapPt_mapPt θ.inv hθinv θ.hom hθ]
      have e : mapPt (θ.inv ≫ θ.hom) (by rw [Category.assoc, hθ, hθinv]) (mapPt φ' hφ' Q₁) = mapPt φ' hφ' Q₁ := by
        apply Subtype.ext; simp [mapPt]
      rw [e, hψφ', hQ₁]

    have hψR : FactorsThrough K.levK (mapPt ψ hψ (mapPt θ.inv hθinv (mapPt φ' hφ' Q₁))) := by
      rw [← hker, hφψ, ← GLUEaux.map_nsmulPt_of_hom d'.L d.L θ.inv hθinv θinv_hom,
        ← GLUEaux.map_nsmulPt_of_hom E.L d'.L φ' hφ' φ'_hom, hQ₁, hQ]
      exact GLUEaux.map_one_of_hom d'.L d.L θ.inv hθinv θinv_hom _

    have hℓP₂ : nsmulPt E.L _ ℓ (mapPt ψ hψ R₂) = mapPt ψ hψ (mapPt θ.inv hθinv (mapPt φ' hφ' Q₁)) := by
      rw [← hψφ, hφP₂]
    have hmem : FactorsThrough K.levK Q := by
      rcases hk with h | h
      · rw [hQα, h, hk₁, mul_comm, GLUEgrp.nsmulPt_mul, hℓP₂]
        exact K_nsmul K _ k₁ _ hψR
      · rw [hQα, h, hk₁, mul_comm, GLUEgrp.nsmulPt_mul, hℓP₂]
        exact (K.levK_sub _ _ _ (K_nsmul K _ k₁ _ hψR) (K_nsmul K _ k₁ _ hψR)).2
    exact (hker _ Q).2 hmem

  obtain ⟨kk', hk'⟩ := hS E hE (φ' ≫ θ.inv ≫ ψ) hβ (φ ≫ θ.hom ≫ ψ') hα β_hom β_act α_hom α_act
    (fun s Q => ⟨(hβα s Q).2, (hβα s Q).1⟩)
  obtain ⟨eK', -⟩ := K'.levK_fibre (AlgebraicClosure ℚ) (RingHom.id _) hℓK
  rw [hgp] at eK'
  have hne' : ∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f, FactorsThrough K'.levK P ∧ P ≠ E.L.one _ := by
    by_contra hcon
    push_neg at hcon
    have hsub : Subsingleton {P : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f // FactorsThrough K'.levK P} :=
      ⟨fun x y => Subtype.ext ((hcon x.1 x.2).trans (hcon y.1 y.2).symm)⟩
    have h1 : Nat.card (ZMod ℓ × ZMod ℓ) ≤ 1 := by
      rw [Nat.card_congr eK']
      haveI : Finite {P : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f // FactorsThrough K'.levK P} := Finite.of_equiv _ eK'
      exact Finite.card_le_one_iff_subsingleton.2 hsub
    rw [Nat.card_prod, Nat.card_zmod] at h1
    nlinarith [hℓ.two_le]

  have β_K : ∀ (Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f), FactorsThrough K'.levK Q →
      mapPt (φ' ≫ θ.inv ≫ ψ) hβ Q = E.L.one _ := by
    intro Q hQ
    rw [β_eq, (hker' _ Q).2 hQ, GLUEaux.map_one_of_hom d'.L d.L θ.inv hθinv θinv_hom,
      GLUEaux.map_one_of_hom d.L E.L ψ hψ ψ_hom]
  have β_kk : ∀ (Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f), FactorsThrough K'.levK Q →
      nsmulPt E.L _ kk' Q = E.L.one _ := by
    intro Q hQ
    rcases hk' with h | h
    · rw [← h _ Q]; exact β_K Q hQ
    · have := β_K Q hQ
      rw [h _ Q] at this
      rw [← GLUEgrp.inv_inv E.L _ (nsmulPt E.L _ kk' Q), this]

      have h1 := GLUEgrp.mul_inv_cancel E.L (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) (E.L.one _)
      rwa [E.L.one_mul] at h1
  have hdvd' : ℓ ∣ kk' := by
    by_contra hnd
    obtain ⟨P₁, hP₁K, hP₁ne⟩ := hne'
    have hcop : Nat.Coprime kk' ℓ := (Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd hℓ).2 hnd))
    exact hP₁ne (GLUEgrp.eq_one_of_nsmulPt_eq_one_of_coprime E.L _ hcop P₁ (β_kk P₁ hP₁K) (K'.levK_torsion _ P₁ hP₁K))
  obtain ⟨k₁', hk₁'⟩ := hdvd'

  have stepB' : ∀ (Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f),
      mapPt φ hφ Q = d.L.one _ → mapPt φ' hφ' Q = d'.L.one _ := by
    intro Q hQ
    obtain ⟨Q₁, hQ₁⟩ := hsurj E Q
    obtain ⟨R₂, hR₂⟩ := hsurj d' (mapPt θ.hom hθ (mapPt φ hφ Q₁))

    have hφP₂ : mapPt φ' hφ' (mapPt ψ' hψ' R₂) = mapPt θ.hom hθ (mapPt φ hφ Q₁) := by
      rw [hφψ', hR₂]

    have hQα : Q = mapPt (φ' ≫ θ.inv ≫ ψ) hβ (mapPt ψ' hψ' R₂) := by
      rw [β_eq, hφP₂, GLUEaux.mapPt_mapPt θ.hom hθ θ.inv hθinv]
      have e : mapPt (θ.hom ≫ θ.inv) (by rw [Category.assoc, hθinv, hθ]) (mapPt φ hφ Q₁) = mapPt φ hφ Q₁ := by
        apply Subtype.ext; simp [mapPt]
      rw [e, hψφ, hQ₁]

    have hψR : FactorsThrough K'.levK (mapPt ψ' hψ' (mapPt θ.hom hθ (mapPt φ hφ Q₁))) := by
      rw [← hker', hφψ', ← GLUEaux.map_nsmulPt_of_hom d.L d'.L θ.hom hθ θ_hom,
        ← GLUEaux.map_nsmulPt_of_hom E.L d.L φ hφ φ_hom, hQ₁, hQ]
      exact GLUEaux.map_one_of_hom d.L d'.L θ.hom hθ θ_hom _

    have hℓP₂ : nsmulPt E.L _ ℓ (mapPt ψ' hψ' R₂) = mapPt ψ' hψ' (mapPt θ.hom hθ (mapPt φ hφ Q₁)) := by
      rw [← hψφ', hφP₂]
    have hmem : FactorsThrough K'.levK Q := by
      rcases hk' with h | h
      · rw [hQα, h, hk₁', mul_comm, GLUEgrp.nsmulPt_mul, hℓP₂]
        exact K_nsmul K' _ k₁' _ hψR
      · rw [hQα, h, hk₁', mul_comm, GLUEgrp.nsmulPt_mul, hℓP₂]
        exact (K'.levK_sub _ _ _ (K_nsmul K' _ k₁' _ hψR) (K_nsmul K' _ k₁' _ hψR)).2
    exact (hker' _ Q).2 hmem

  have lft : ∀ (L' : E.ExtraLevel ℓ), LocallyOfFiniteType (L'.levK ≫ E.f) := fun L' => by haveI := L'.levK_finite; infer_instance
  have transfer : ∀ (L₁ L₂ : E.ExtraLevel ℓ),
      (∀ Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f, FactorsThrough L₁.levK Q → FactorsThrough L₂.levK Q) →
      ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (Q : SchemeHomOver s E.f),
        FactorsThrough L₁.levK Q → FactorsThrough L₂.levK Q := by
    intro L₁ L₂ h T s Q hQ
    haveI := CerednikDrinfeld.QM.FakeEllipticCurve.ExtraLevel.isReduced_K_of_natCast_ne_zero (AlgebraicClosure ℚ) E L₁ hℓK
    haveI := lft L₁
    haveI := L₂.levK_closed
    obtain ⟨g₀, hg₀⟩ := CerednikDrinfeld.QM.exists_comp_eq_of_forall_factorsThrough_of_isReduced (AlgebraicClosure ℚ)
      (L₁.levK ≫ E.f) E.f L₂.levK L₁.levK rfl (fun z => h _ ⟨z.1, rfl⟩)
    obtain ⟨c, hc⟩ := hQ
    exact ⟨c ≫ g₀, by rw [Category.assoc, hg₀, hc]⟩
  constructor
  · exact transfer K K' (fun Q hQ => (hker' _ Q).1 (stepB' Q ((hker _ Q).2 hQ))) t P
  · exact transfer K' K (fun Q hQ => (hker _ Q).1 (stepB Q ((hker' _ Q).2 hQ))) t P

