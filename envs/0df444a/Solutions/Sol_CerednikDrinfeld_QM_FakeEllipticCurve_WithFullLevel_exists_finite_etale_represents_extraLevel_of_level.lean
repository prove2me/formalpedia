section Pieces

theorem isClosedImmersion_ι_of_isClosed {X : Scheme.{0}} (W : X.Opens) (hW : IsClosed (W : Set ↥X)) :
    IsClosedImmersion W.ι :=
  IsClosedImmersion.of_isPreimmersion _ (by rw [Scheme.Opens.range_ι]; exact hW)

variable {R : Type} [CommRing R] {X : Scheme.{0}} (p : X ⟶ Spec (CommRingCat.of R)) [IsFinite p] [Etale p]
  (W : X.Opens) (hW : IsClosed (W : Set ↥X))

include hW in
theorem isFinite_piece : IsFinite (W.ι ≫ p) := by
  haveI := isClosedImmersion_ι_of_isClosed W hW
  infer_instance

omit hW in
theorem flat_piece : Flat (W.ι ≫ p) := inferInstance
omit hW in
theorem lofp_piece : LocallyOfFinitePresentation (W.ι ≫ p) := inferInstance
omit hW in
theorem etale_piece : Etale (W.ι ≫ p) := inferInstance

def rankLoc (c : ℕ) : Set ↥(Spec (CommRingCat.of R)) := {t | (W.ι ≫ p).finrank t = c}

include hW in
theorem isClopen_rankLoc (c : ℕ) : IsClopen (rankLoc p W c) := by
  haveI := isFinite_piece p W hW
