theorem crtIdx_crtKey {s : List ℕ} (h : CrtOK s) (k : ℕ) (hk : k < s.prod) :
    crtIdx s (unrk s (crtKey s k)) = k :=
  crtKey_inj h (crtIdx_lt h.2 _) hk (crtKey_crtIdx h _ (crtKey_lt h.2 k))

theorem invL_idxOf {s : List ℕ} (h : CrtOK s) (k : ℕ) (hk : k < s.prod) :
    (invL s).idxOf k = crtKey s k := by
  have hl : crtKey s k < (invL s).length := by rw [invL_length]; exact crtKey_lt h.2 k
  have e : (invL s)[crtKey s k] = k := by simp only [invL, List.getElem_map, List.getElem_range]; exact crtIdx_crtKey h k hk
  conv_lhs => rw [← e]
  exact List.Nodup.idxOf_getElem (invL_nodup h) _ hl

/-- Permuting `0, …, S-1` by `keyL` gives the inverse keys. -/
theorem inv_perm {s : List ℕ} (h : CrtOK s) :
    (permL (keyL s) (((List.range s.prod).map (Nat.cast : ℕ → ℤ)).map fun x => [x])).flatten =
      (invL s).map (Nat.cast : ℕ → ℤ) := by
  rw [permL_single, keyL_length, invL, List.map_map]
  · apply List.map_congr_left
    intro q hq
    rw [keyL_idxOf h q (List.mem_range.1 hq)]
    rw [List.getD_eq_getElem _ _ (by simpa using crtIdx_lt h.2 _)]
    simp
  · intro q hq
    rw [keyL_length] at hq
    rw [keyL_idxOf h q hq]; simpa using crtIdx_lt h.2 _

/-- **`crtOut` is a prefix of the permutation of `w` by the inverse keys.** -/
theorem crtOut_perm {s : List ℕ} (h : CrtOK s) (w : List ℤ) (hw : w.length = s.prod) (M : ℕ)
    (hM : M ≤ s.prod) :
    ((permL (invL s) (w.map fun x => [x])).flatten).take M = crtOut s M w := by
  rw [permL_single, invL_length, ← List.map_take, List.take_range, min_eq_left hM, crtOut]
  · apply List.map_congr_left
    intro k hk
    rw [invL_idxOf h k (by have := List.mem_range.1 hk; omega)]
    rfl
  · intro q hq
    rw [invL_length] at hq
    rw [invL_idxOf h q hq, hw]; exact crtKey_lt h.2 q

end NLogN.CR

