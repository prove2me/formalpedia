open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII09
theorem solution (k j : ℝ) : sigma3 (k * j) = k ^ 3 * sigma3 j := by
  have h1 : Tendsto (fun R : ℝ => R * cj (k * j) R) atTop (𝓝 (sigma3 (k * j))) :=
    cj_lim (k * j)
  have h2 : Tendsto (fun R : ℝ => R * cj (k * j) R) atTop (𝓝 (k ^ 3 * sigma3 j)) := by
    have hbase : Tendsto (fun R : ℝ => k ^ 3 * (R * cj j R)) atTop (𝓝 (k ^ 3 * sigma3 j)) :=
      (cj_lim j).const_mul (k ^ 3)
    refine hbase.congr' ?_
    filter_upwards [eventually_gt_atTop (3 : ℝ)] with R hR
    have hEq : cj (k * j) R = k ^ 3 * cj j R := (cj_dj_smul k j).1 (mem_Ioi.mpr hR)
    rw [hEq]
    ring
  exact tendsto_nhds_unique h1 h2
