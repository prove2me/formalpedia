private theorem not_sup_lt_stdLattice {ϖ : R} (hϖ : ϖ ≠ 0) :
    ¬ (stdLattice R K ⊔
        latticeMap (scalarGL (unitOfNeZero (K := K) hϖ)) (stdLattice R K) <
      stdLattice R K) := by
  rw [sup_eq_left.mpr (latticeMap_scalarGL_le_stdLattice hϖ)]
