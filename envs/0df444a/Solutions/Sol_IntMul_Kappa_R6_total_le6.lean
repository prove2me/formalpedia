    exact ⟨this.1, this.2.trans (by exact_mod_cast Nat.one_le_two_pow)⟩
  · exact ⟨by positivity, by exact_mod_cast (a7 j hj).1⟩
  · exact ⟨by positivity, by exact_mod_cast (a7 j hj).2⟩

theorem desc_line6 : ∀ x ∈ Q.dLn, 0 ≤ x ∧ x ≤ 2 ^ Q.b := by
  obtain ⟨a1, a2, a3, a4, a5, a6, a7⟩ := small_facts6 hQ hD
  intro x hx
  simp only [Q6.dLn, descLine6, descLine, List.mem_cons, List.mem_append, List.mem_map,
    List.mem_range] at hx
  rcases hx with rfl | rfl | rfl | rfl | (hx | ⟨j, hj, rfl⟩)
  · exact ⟨by positivity, by exact_mod_cast a6⟩
  · exact ⟨by positivity, by exact_mod_cast a4⟩
  · exact ⟨by positivity, by exact_mod_cast a2⟩
  · exact ⟨by positivity, by exact_mod_cast a3⟩
  · have := bits_mem6 hx
    exact ⟨this.1, this.2.trans (by exact_mod_cast Nat.one_le_two_pow)⟩
  · exact ⟨by positivity, by exact_mod_cast (a7 j hj).1⟩

theorem desc_chirp6 : ∀ x ∈ Q.dCh, 0 ≤ x ∧ x ≤ 2 ^ Q.b := by
  obtain ⟨a1, a2, a3, a4, a5, a6, a7⟩ := small_facts6 hQ hD
  intro x hx
  simp only [Q6.dCh, descChirp6, List.mem_cons] at hx
  rcases hx with rfl | hx
  · exact ⟨by positivity, by exact_mod_cast a5⟩
  · exact desc_line6 hQ hD x hx

omit hQ hD in
theorem dzB_le_of6 {l : List ℤ} (h : ∀ x ∈ l, 0 ≤ x ∧ x ≤ 2 ^ Q.b) : dzB l ≤ Q.b + 1 :=
  dzB_le l _ fun x hx => zsz_small (h x hx).1 (h x hx).2

set_option maxRecDepth 100000 in
/-- **The descriptor part of a call.** -/
theorem kCall_le6 {k c Bd : ℕ} (hk : k ≤ 3) (hc : c ≤ 5) (hBd : Bd ≤ Q.b + 1) (C₀ : ℝ) (A : ℕ) :
    kCall6 Q k c Bd C₀ A ≤ (10 ^ 7 * (Q.b + 1) ^ 2 : ℕ) + C₀ * cU6 Q.P Q.n A := by
  have hb := hQ.hb
  have hdb := hQ.hdb
  have hlen : k * Q.d + c ≤ 3 * Q.b + 5 := by
    have := Nat.mul_le_mul hk (show Q.d ≤ Q.b by omega); omega
  have h1 : kCpy k (k * Q.d + c) (Bd + Q.b) ≤ 10 ^ 6 * (Q.b + 1) ^ 2 := by
    unfold kCpy
    have m1 := Nat.mul_le_mul hlen (show 40000 * (Bd + Q.b + 2) + 30 ≤ 40000 * (2 * Q.b + 3) + 30
      by omega)
    have m2 : 2 * (2 * k + 2) * 2000 * (Bd + Q.b + 2) ≤ 32000 * (2 * Q.b + 3) := by
      have := Nat.mul_le_mul (show 2 * (2 * k + 2) * 2000 ≤ 32000 by omega)
        (show Bd + Q.b + 2 ≤ 2 * Q.b + 3 by omega)
      linarith
    nlinarith
  have h2 : 3 * (k * Q.d + c) * KFM.cMv Bd ≤ 10 ^ 4 * (Q.b + 1) ^ 2 := by
    have : KFM.cMv Bd ≤ 100 * (Q.b + 2) := by unfold KFM.cMv; simp only [moveCost]; omega
    calc 3 * (k * Q.d + c) * KFM.cMv Bd ≤ 3 * (3 * Q.b + 5) * (100 * (Q.b + 2)) :=
          Nat.mul_le_mul (Nat.mul_le_mul_left _ hlen) this
      _ ≤ 10 ^ 4 * (Q.b + 1) ^ 2 := by nlinarith
  unfold kCall6
  have h1' : ((kCpy k (k * Q.d + c) (Bd + Q.b) : ℕ) : ℝ) ≤ 10 ^ 6 * ((Q.b + 1 : ℕ) : ℝ) ^ 2 := by
    exact_mod_cast h1
  have h2' : ((3 * (k * Q.d + c) * KFM.cMv Bd : ℕ) : ℝ) ≤ 10 ^ 4 * ((Q.b + 1 : ℕ) : ℝ) ^ 2 := by
    exact_mod_cast h2
  have hb1 : (1 : ℝ) ≤ ((Q.b + 1 : ℕ) : ℝ) ^ 2 := by
    have : (1 : ℝ) ≤ ((Q.b + 1 : ℕ) : ℝ) := by exact_mod_cast (by omega : 1 ≤ Q.b + 1)
    nlinarith
  push_cast at h1' h2' hb1 ⊢
  nlinarith

end Desc

end

end IntMul.Kappa.R6

