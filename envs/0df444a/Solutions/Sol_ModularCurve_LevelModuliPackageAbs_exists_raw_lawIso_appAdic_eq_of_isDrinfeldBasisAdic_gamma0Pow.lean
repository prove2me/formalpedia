  have hF₀eq : F₀ = (((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).level.2.2.curve.map resR).formalGroup := FormalGroup.ext hF₀W
  have hE₀ : (((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).level.2.2.curve.map resR).formalGroup.IsDrinfeldBasisAdic ⊥ q 0 0 := hF₀eq ▸ hF₀
  have hG' : G.IsBaseChange resT (((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).level.2.2.curve.map resR).formalGroup := hF₀eq ▸ hG

  obtain ⟨E, hE, GT, hGT, ψ, hψ⟩ :=
    WeierstrassCurve.exists_map_eq_and_lawIso_of_isBaseChange_formalGroup_of_isArtinianRing
      q hq2 k _ hE₀ W₀ hW₀ res₀ hres₀ hker₀ T resT hsT hkT hT₀ G hG'

  obtain ⟨ψ', -, hψ'ψ⟩ := FormalGroup.LawIso.exists_symm_subst_eq_X ψ
  have hz₀ : ψ'.toLawHom.appAdic (maximalIdeal T) y₀ ∈ maximalIdeal T := GCPoint.appAdic_mem _ _ hy₀
  have hz₁ : ψ'.toLawHom.appAdic (maximalIdeal T) y₁ ∈ maximalIdeal T := GCPoint.appAdic_mem _ _ hy₁
  have hDz := FormalGroup.IsDrinfeldBasisAdic.map_iso (maximalIdeal T) G GT ψ' q y₀ y₁ hy₀ hy₁ hDy

  obtain ⟨P, χP', hP', hzP⟩ :=
