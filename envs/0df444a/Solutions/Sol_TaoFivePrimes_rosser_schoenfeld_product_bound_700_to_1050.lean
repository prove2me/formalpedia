theorem rs_step_1 : Nat.primesLE 701 = insert 701 (Nat.primesLE 691) :=
  primesLE_insert_next 691 701 (by norm_num) (by norm_num)
    (by intro m hm1 hm2; interval_cases m <;> norm_num)
theorem rs_pnum_1 : ∏ p ∈ Nat.primesLE 701, (p : ℕ) = rsPnum 1 := by
  rw [rs_step_1]
  exact rs_pnum_step_gen (Nat.primesLE 691) 701
    (fun h => absurd ((Nat.mem_primesLE.mp h).1) (by omega)) rs_pnum_0
theorem rs_pden_1 : ∏ p ∈ Nat.primesLE 701, ((p : ℕ) - 1) = rsPden 1 := by
