theorem satE_clean {rv : Fin HS} (hv : rv.val < 56) : (satE rv).Clean := by
  intro j hj
  simp only [satE, Ex.regs, List.mem_append, List.mem_singleton, List.nil_append, List.append_nil,
    List.not_mem_nil, or_false] at hj
