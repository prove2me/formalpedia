    centerALowerYBox.Contains (Y (lower E8TAxisProd0586PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0586PaddedInputs.centerAInput.alpha = ((1424582033573572438591305530993584070055117280 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
