  have hN1 : ((TypeDensity.tangentCount (.single a 2) P1).mul
      (TypeDensity.divisorProbability (.single a 2) P1.d.val)).eval q = (q - 1) / q := by
    simp [TypeDensity.tangentCount, TypeDensity.Tests.divisorCount_spat, P1, f1, TypeDensity.divisorProbability, TypeDensity.tri, TypeDensity.Expr.eval, TypeDensity.Expr.pow,
      TypeDensity.eminusOne, TypeDensity.Expr.sub, TypeDensity.Expr.neg, TypeDensity.falling, TypeDensity.Expr.prod]
    field_simp; ring
  have hN2 : ((TypeDensity.tangentCount (.single a 2) P2).mul
      (TypeDensity.divisorProbability (.single a 2) P2.d.val)).eval q = q * (q - 1) / 2 / q ^ 3 := by
    simp [TypeDensity.tangentCount, TypeDensity.Tests.divisorCount_spat, P2, f2, TypeDensity.divisorProbability, TypeDensity.tri, TypeDensity.Expr.eval, TypeDensity.Expr.pow,
      TypeDensity.Expr.sub, TypeDensity.Expr.neg, TypeDensity.falling, TypeDensity.Expr.prod, TypeDensity.availablePoints, i0, List.range_succ]
    ring
  have hN4 : ((TypeDensity.tangentCount (.single a 2) P4).mul
      (TypeDensity.divisorProbability (.single a 2) P4.d.val)).eval q = (q ^ 2 - q) / 2 / q ^ 3 := by
    simp [TypeDensity.tangentCount, TypeDensity.Tests.divisorCount_spat, P4, f1, f2, TypeDensity.divisorProbability, TypeDensity.tri, TypeDensity.Expr.eval, TypeDensity.Expr.pow,
      TypeDensity.falling, TypeDensity.Expr.prod, TypeDensity.availablePoints, i1, TypeDensity.Tests.pointCount_two, List.range_succ, TypeDensity.Expr.sub, TypeDensity.Expr.neg]
    ring
  have hR : (1 - q / q ^ TypeDensity.tri 2)⁻¹ = q ^ 2 / ((q - 1) * (q + 1)) := by
    rw [show TypeDensity.tri 2 = 3 from rfl, inv_eq_iff_eq_inv, inv_div]; field_simp; ring
  rw [hN1, hN2, hN4, TypeDensity.Tests.returnWeight_eval, hR, ← two_mul]
  simp only [Multiset.insert_eq_cons, TypeDensity.Tests.ite_eq_mul_indicator]
  have : q + 1 ≠ 0 := by linarith
  field_simp
  ring
