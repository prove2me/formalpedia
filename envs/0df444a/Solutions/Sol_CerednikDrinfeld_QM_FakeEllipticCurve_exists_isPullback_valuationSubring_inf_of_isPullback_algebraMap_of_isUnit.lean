theorem forall_isUnit_tensor_padic {q q' : ℕ} [hq : Fact q.Prime] [Fact q'.Prime]
    (hB : IsIndefiniteRamifiedExactlyAt a b q q') :
    ∀ x : ℍ[ℚ, a, b] ⊗[ℚ] ℚ_[q], x ≠ 0 → IsUnit x := by
  classical
  let p : Nat.Primes := ⟨q, hq.out⟩
  let v : HeightOneSpectrum (𝓞 ℚ) := (Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ)).symm p

  have hv : ((q : ℕ) : 𝓞 ℚ) ∈ v.asIdeal := by
    have h1 : Rat.HeightOneSpectrum.natGenerator v ∣ q := by
      have h2 : Rat.HeightOneSpectrum.primesEquiv v = p := Equiv.apply_symm_apply _ _
      have h3 : (Rat.HeightOneSpectrum.primesEquiv v).1 = Rat.HeightOneSpectrum.natGenerator v := rfl
      rw [← h3, h2]
    rw [Rat.HeightOneSpectrum.natGenerator_dvd_iff, ← Ideal.symm_apply_mem_of_equiv_iff] at h1
    simpa using h1
  have hdiv := (hB.2 v).mpr (Or.inl hv)

  let ε : ℍ[ℚ, a, b] ⊗[ℚ] ℚ_[q] ≃ₐ[ℚ] ℍ[ℚ, a, b] ⊗[ℚ] v.adicCompletion ℚ :=
    Algebra.TensorProduct.congr (AlgEquiv.refl : ℍ[ℚ, a, b] ≃ₐ[ℚ] ℍ[ℚ, a, b])
      (Padic.adicCompletionEquiv (𝓞 ℚ) p).toAlgEquiv
  intro x hx
  have hεx : ε x ≠ 0 := fun h => hx (by simpa using congrArg ε.symm h)
  have hu := hdiv (ε x) hεx
  simpa using hu.map ε.symm

end CerednikDrinfeld.QM.FakeEllipticCurve.PotGoodRedNFviaQMSurface

