theorem frobSeries_map {B' : Type} [CommRing B'] (f : B →+* B') (j : ℕ) :
    (Rigidified.frobSeries (p := r) B j).map f = Rigidified.frobSeries (p := r) B' j := by
  funext i
  show MvPowerSeries.map f ((MvPowerSeries.X i : MvPowerSeries (Fin 2) B) ^ (r ^ j)) = _
  rw [map_pow, MvPowerSeries.map_X]; rfl

theorem frobSeries_cc (j : ℕ) (i : Fin 2) :
    MvPowerSeries.constantCoeff (Rigidified.frobSeries (p := r) B j i) = 0 := by
  show MvPowerSeries.constantCoeff ((MvPowerSeries.X i : MvPowerSeries (Fin 2) B) ^ (r ^ j)) = 0
  rw [map_pow, MvPowerSeries.constantCoeff_X, zero_pow (pow_ne_zero _ (Fact.out : r.Prime).ne_zero)]

