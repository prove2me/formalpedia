    Omega g gi E Θ A x K B = ∑ C, etaNull K C * omL g gi E Θ C A B x := by
  simp only [omL, Finset.mul_sum, ← mul_assoc]
  rw [Finset.sum_comm]
  simp only [← Finset.sum_mul, sum_etaNull_mul, Matrix.one_apply, ite_mul, one_mul, zero_mul,
