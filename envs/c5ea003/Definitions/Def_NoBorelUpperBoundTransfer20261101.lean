-- title:
--   Parameterized algebraically generated subgroups and coset relations
-- statement:
--   For any subgroup $H\le G$, let $gE_H^Gg^{\prime}$ mean $g^{-1}g^{\prime}\in H$. For each parameter p, let $H_p$ be the subgroup algebraically generated by the union of the images of the countably many homomorphisms $h_{n,p}:A_n\to G$. For a function $z:P\to G$, set $M=\{p:z(p)\in H_p\}$. Generation allows finite products and inverses and is not a topological closure. No normality, topology, measurability or continuity is built into these definitions; the theorem supplies its own hypotheses.
-- source:
--   No Borel upper bound for the F_sigma equivalence relations, research proof note dated 1 November 2026, supplied manuscript UniversalBorelEquivalence-20261101.tex, Section 1, coset convention; Section 2, Lemma 2.

import Definitions.Def_NoBorelUpperBound20261101
import Mathlib.Topology.Algebra.Group.Basic

set_option autoImplicit false

namespace NoBorelUpperBoundFSigma
universe u v w

def GroupCosetRelation {G : Type u} [Group G] (H : Subgroup G) (g g' : G) : Prop :=
  g⁻¹ * g' ∈ H

def GeneratedSubgroup {P : Type u} {G : Type v} [Group G]
    {A : ℕ → Type w} [∀ n, Group (A n)]
    (h : ∀ n, P → (A n →* G)) (p : P) : Subgroup G :=
  Subgroup.closure (⋃ n, Set.range (h n p))

def MembershipSet {P : Type u} {G : Type v} [Group G]
    {A : ℕ → Type w} [∀ n, Group (A n)]
    (h : ∀ n, P → (A n →* G)) (z : P → G) : Set P :=
  {p | z p ∈ GeneratedSubgroup h p}

end NoBorelUpperBoundFSigma


