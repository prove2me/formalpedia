-- title:
--   Degree of L over K(p(s)) for s transcendental generating L
-- statement:
--   Let $K$ and $L$ be fields with $L$ a $K$-algebra, and let $s \in L$ be transcendental over $K$ (no nonzero polynomial over $K$ annihilates $s$) and such that the intermediate field of $L/K$ generated by $\{s\}$ is all of $L$, i.e. `IntermediateField.adjoin K {s} = ⊤`. Let $p \in K[X]$ be a polynomial whose `natDegree` is positive. The assertion is that the finite rank of $L$ as a module over the intermediate field `IntermediateField.adjoin K {Polynomial.aeval s p}`, the subfield of $L$ generated over $K$ by the value $p(s)$ obtained by evaluating $p$ at $s$, equals `p.natDegree`; that is, $[L : K(p(s))] = \deg p$. Since `Module.finrank` returns $0$ when no finite basis exists, the equality also records finiteness of this degree.
--
--   This is the polynomial case of the degree formula for a rational function field, $[K(X):K(f)] = \max(\deg\,\mathrm{num}\,f, \deg\,\mathrm{den}\,f)$, transported along an isomorphism $K(X) \cong L$. It is used in [`ModularCurve.finrank_adjoin_aeval_jqModC`](thm.html#ModularCurve.finrank_adjoin_aeval_jqModC) for residue-degree counts on a special fibre, where $L$ is a rational function field in a modular invariant and $p$ is an explicit polynomial of degree $q$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_IntermediateField_finrank_adjoin_aeval_of_transcendental.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open Polynomial

theorem IntermediateField.finrank_adjoin_aeval_of_transcendental
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    (s : L) (hs : Transcendental K s) (hgen : IntermediateField.adjoin K ({s} : Set L) = ⊤)
    (p : K[X]) (hp : 0 < p.natDegree) :
    Module.finrank ↥(IntermediateField.adjoin K ({Polynomial.aeval s p} : Set L)) L = p.natDegree := by sorry
