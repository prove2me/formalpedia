theorem divPc_spec (t : IState HS) (xs : List ℤ) (P Q c B Bb : ℕ) (R : List Item)
    (hlen : xs.length = P * Q * B) (hb : Bnd Bb xs) (hc2 : 2 ≤ c) (hc20 : c ≤ 20)
    (hQc : Nat.Coprime Q c) (zB : zsz (B : ℤ) ≤ Bb) (zc : zsz ((2 * c : ℕ) : ℤ) ≤ Bb)
    (zQ : zsz (Q : ℤ) ≤ Bb) (zQB : zsz ((Q * B : ℕ) : ℤ) ≤ Bb) (zP : zsz (P : ℤ) ≤ Bb)
    (zV : zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = ints xs ++ R) :
    Sp (divPc P Q c B) t (t.upd 0 (ints (AModel.pull [P, Q, B] [P, Q, B] (divAddr Q c) 0 xs) ++ R))
      (cDivPc P Q c B Bb) := by
  have H := divPc_sp (r := recR xs Q B) (P := P) (t.upd 0 R) Bb hc2 hc20 hQc
    (fun _ _ => length_recR xs Q B _ _)
    (fun _ _ a ha => by
      simp only [recR, List.mem_map, List.mem_range] at ha
      obtain ⟨b, -, rfl⟩ := ha; exact bnd_getD hb _) zB zc zQ zQB zP zV
  rw [inR_recR hlen, outDiv_recR, encK_x, encK_x] at H
