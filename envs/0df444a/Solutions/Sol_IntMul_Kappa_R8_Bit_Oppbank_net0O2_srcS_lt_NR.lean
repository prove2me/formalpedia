    have hmem : 1750 + (t - 1750) ∈ (List.range 21).map (fun k => 1750 + k) := by
      refine List.mem_map.mpr ⟨t - 1750, List.mem_range.mpr hk, ?_⟩
      omega
    have : (1750 + (t - 1750)) = t := by omega
    rw [this] at hmem
    have := (List.all_eq_true.1 hall) _ hmem
    exact of_decide_eq_true this

theorem solution (t : ℕ) (ht : t < v) : srcS t < NR := by
  have ht' : t < 1771 := by simpa [v] using ht
  simpa [NR] using srcS_of_chunk t ht'

