    have e : tStep To n U + 58 = QOf n * supTo To n U + (QOf n * (tAggr (n * n) (mOf n) + 40) +
        tCert (n * n) (QOf n) + tArgmin (n * n) (QOf n) + copyTime (n * n) + 118) := by
      unfold tStep; ring
