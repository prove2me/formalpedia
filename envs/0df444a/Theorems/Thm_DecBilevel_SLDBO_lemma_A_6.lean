-- title:
--   Lemma A.6, (31), p. 16 — successive differences of v
-- statement:
--   Under Assumptions 2.1 and 2.2, let the sequences be generated by Algorithm 1 from BOX 1 with any $\alpha,\beta,\eta>0$. For every $k\ge0$,
--   $$\sum_{i=1}^n\|v^{k+1}_i-v^k_i\|^2\le8\sum_{i=1}^n\|v^k_i-\bar v^k\|^2+4\eta^2\sum_{i=1}^n\|t^k_{v,i}-\bar t^k_v\|^2+4n\eta^2\|\bar d^k_v\|^2.$$
--
--   Combined with Lemma A.5, this bounds the change of the directions by consensus errors and averaged directions.
-- source:
--   Dong, Ma, Yang, Yin, A Single-Loop Algorithm for Decentralized Bilevel Optimization, arXiv:2311.08945v3, p. 16, Lemma A.6, (31)

import Mathlib
import Definitions.Def_DecBilevel_SLDBO_Setting

namespace DecBilevel.SLDBO

theorem lemma_A_6 {n p q : ℕ} (hn : 0 < n) (W : Matrix (Fin n) (Fin n) ℝ) (ρ : ℝ)
    (F f : Fin n → E p → E q → ℝ) (σ LF0 LF1 Lf1 Lf2 : ℝ) (α β η : ℝ)
    (hα : 0 < α) (hβ : 0 < β) (hη : 0 < η) (x0 : E p) (y0 v0 : E q)
    (hA21 : Assumption21 F f σ LF0 LF1 Lf1 Lf2) (hA22 : Assumption22 W ρ)
    (hv0 : ‖v0‖ ≤ rv σ LF0) (k : ℕ) :
    let s := run W F f α β η (rv σ LF0) x0 y0 v0
    ∑ i, ‖(s (k + 1)).v i - (s k).v i‖ ^ 2 ≤
      8 * ∑ i, ‖(s k).v i - avg (s k).v‖ ^ 2 +
      4 * η ^ 2 * ∑ i, ‖trV s k i - avg (trV s k)‖ ^ 2 +
      4 * n * η ^ 2 * ‖avg (dirV s k)‖ ^ 2 := by sorry

end DecBilevel.SLDBO
