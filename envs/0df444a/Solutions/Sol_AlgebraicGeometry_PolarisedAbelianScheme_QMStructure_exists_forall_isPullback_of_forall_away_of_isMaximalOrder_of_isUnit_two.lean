theorem mul_fst_congr' {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (ht : t₁ = t₂)
    {x₁ y₁ : SchemeHomOver t₁ f} {x₂ y₂ : SchemeHomOver t₂ f} (hx : x₁.1 = x₂.1) (hy : y₁.1 = y₂.1) :
    (L.mul t₁ x₁ y₁).1 = (L.mul t₂ x₂ y₂).1 := by
  subst ht
  rw [Subtype.ext hx, Subtype.ext hy]

open _root_.AlgebraicGeometry.Scheme.Modules in

noncomputable def transportIso {X Y Z : Scheme.{0}} (a : X ⟶ Z) (b : Y ⟶ Z) (ε : X ⟶ Y) (h : ε ≫ b = a)
    {M N : Z.Modules} (φ : (Scheme.Modules.pullback b).obj M ≅ (Scheme.Modules.pullback b).obj N) :
    (Scheme.Modules.pullback a).obj M ≅ (Scheme.Modules.pullback a).obj N :=
  (pullbackCongr h.symm).app M ≪≫ ((pullbackComp ε b).symm).app M ≪≫ (Scheme.Modules.pullback ε).mapIso φ ≪≫
    (pullbackComp ε b).app N ≪≫ (pullbackCongr h).app N

end T3QMUP

open _root_.CategoryTheory.MonoidalCategory in
theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    (β : Fin (2 * 2) → ↥Λ)
    {d m : ℕ} (hm : 3 ≤ m) {S : Type} [CommRing S] (h2 : IsUnit (2 : S)) (hm' : IsUnit ((m : ℕ) : S))
    (X : PolarisedAbelianScheme 2 d m S)
    {k : ℕ} (r : Fin k → S) (hr : Ideal.span (Set.range r) = ⊤)
    (Xl : ∀ i, PolarisedAbelianScheme 2 d m (Localization.Away (r i)))
    (hXl : ∀ i, PolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r i))) X (Xl i))
    (tl : ∀ i, QMStructure Λ star β (Xl i))
    (hagree : ∀ (i j : Fin k)
      (Y : PolarisedAbelianScheme 2 d m (Localization.Away (r i * r j))) (s : QMStructure Λ star β Y)
      (Y' : PolarisedAbelianScheme 2 d m (Localization.Away (r i * r j))) (s' : QMStructure Λ star β Y'),
      QMStructure.IsPullback
        (IsLocalization.Away.awayToAwayRight (r i) (r j) : Localization.Away (r i) →+* Localization.Away (r i * r j)) (tl i) s →
      QMStructure.IsPullback
        (IsLocalization.Away.awayToAwayLeft (r j) (r i) : Localization.Away (r j) →+* Localization.Away (r i * r j)) (tl j) s' →
      QMStructure.Iso s s') :
    ∃ t : QMStructure Λ star β X, ∀ i, QMStructure.IsPullback (algebraMap S (Localization.Away (r i))) t (tl i) := by
  classical
  choose g hg hgmul hgP hgpol using hXl

  have ACT := AlgebraicGeometry.PolarisedAbelianScheme.QMStructure.exists_act_of_forall_away_of_isMaximalOrder hqq' hB Λ hΛ μ hμ star hstar β hm hm' X r hr Xl
    (fun i => ⟨g i, hg i, hgmul i, hgP i, hgpol i⟩) tl hagree g hg hgmul hgP hgpol
  obtain ⟨act, act_over, hact, act_hom, act_one, act_mul, act_add, act_trace⟩ := ACT

  have RSTq := fun (T : Type) [CommRing T] =>
    AlgebraicGeometry.PolarisedAbelianScheme.QMStructure.Iso.refl_symm_trans (Λ := Λ) (star := star) (β := β) (d := d) (m := m) (S := T)
  have hmA : ∀ (T : Type) [CommRing T] [Algebra S T], IsUnit ((m : ℕ) : T) := fun T _ _ => by
    have := hm'.map (algebraMap S T); rwa [map_natCast] at this
  have hχR : ∀ i j, (IsLocalization.Away.awayToAwayRight (r i) (r j) : Localization.Away (r i) →+* Localization.Away (r i * r j)).comp
      (algebraMap S (Localization.Away (r i))) = algebraMap S (Localization.Away (r i * r j)) :=
    fun i j => RingHom.ext fun x => IsLocalization.Away.awayToAwayRight_eq (S := Localization.Away (r i)) (r i) (r j) x
  have hχL : ∀ i j, (IsLocalization.Away.awayToAwayLeft (r j) (r i) : Localization.Away (r j) →+* Localization.Away (r i * r j)).comp
      (algebraMap S (Localization.Away (r j))) = algebraMap S (Localization.Away (r i * r j)) :=
    fun i j => RingHom.ext fun x => IsLocalization.Away.awayToAwayLeft_eq (S := Localization.Away (r j)) (r j) (r i) x

  have RIG : ∀ (i j : Fin k) {S'' : Type} [CommRing S''] [Algebra S S'']
      (χ₁ : Localization.Away (r i) →+* S'') (χ₂ : Localization.Away (r j) →+* S'')
      (hχ₁ : χ₁.comp (algebraMap S _) = algebraMap S S'') (hχ₂ : χ₂.comp (algebraMap S _) = algebraMap S S'')
      (Y Y' : PolarisedAbelianScheme 2 d m S'')
      (q₁ : Y.A ⟶ (Xl i).A) (hq₁ : CategoryTheory.IsPullback q₁ Y.f (Xl i).f (Spec.map (CommRingCat.ofHom χ₁)))
      (q₁mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S'')) (x y : SchemeHomOver t' Y.f),
        (Y.L.mul t' x y).1 ≫ q₁ = ((Xl i).L.mul (t' ≫ Spec.map (CommRingCat.ofHom χ₁))
          ⟨x.1 ≫ q₁, by rw [Category.assoc, hq₁.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ q₁, by rw [Category.assoc, hq₁.w, ← Category.assoc, y.2]⟩).1)
      (q₁P : ∀ l, (Y.P l).1 ≫ q₁ = Spec.map (CommRingCat.ofHom χ₁) ≫ ((Xl i).P l).1)
      (q₁pol : Nonempty ((Scheme.Modules.pullback q₁).obj (Xl i).pol ≅ Y.pol))
      (q₂ : Y'.A ⟶ (Xl j).A) (hq₂ : CategoryTheory.IsPullback q₂ Y'.f (Xl j).f (Spec.map (CommRingCat.ofHom χ₂)))
      (q₂mul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S'')) (x y : SchemeHomOver t' Y'.f),
        (Y'.L.mul t' x y).1 ≫ q₂ = ((Xl j).L.mul (t' ≫ Spec.map (CommRingCat.ofHom χ₂))
          ⟨x.1 ≫ q₂, by rw [Category.assoc, hq₂.w, ← Category.assoc, x.2]⟩
          ⟨y.1 ≫ q₂, by rw [Category.assoc, hq₂.w, ← Category.assoc, y.2]⟩).1)
      (q₂P : ∀ l, (Y'.P l).1 ≫ q₂ = Spec.map (CommRingCat.ofHom χ₂) ≫ ((Xl j).P l).1)
      (q₂pol : Nonempty ((Scheme.Modules.pullback q₂).obj (Xl j).pol ≅ Y'.pol))
      (e : Y.A ≅ Y'.A) (he : e.hom ≫ Y'.f = Y.f)
      (emul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S'')) (x y : SchemeHomOver t Y.f),
        (Y.L.mul t x y).1 ≫ e.hom = (Y'.L.mul t ⟨x.1 ≫ e.hom, by rw [Category.assoc, he]; exact x.2⟩
          ⟨y.1 ≫ e.hom, by rw [Category.assoc, he]; exact y.2⟩).1)
      (eP : ∀ l, (Y.P l).1 ≫ e.hom = (Y'.P l).1)
      (epol : ∀ p : ↥(Spec (CommRingCat.of S'')), ∃ U : (Spec (CommRingCat.of S'')).Opens, p ∈ U ∧
        Nonempty ((Scheme.Modules.pullback (Y.f ⁻¹ᵁ U).ι).obj ((Scheme.Modules.pullback e.hom).obj Y'.pol) ≅
          (Scheme.Modules.pullback (Y.f ⁻¹ᵁ U).ι).obj Y.pol)),
      e.hom ≫ q₂ ≫ g j = q₁ ≫ g i := by
    intro i j S'' _ _ χ₁ χ₂ hχ₁ hχ₂ Y Y' q₁ hq₁ q₁mul q₁P q₁pol q₂ hq₂ q₂mul q₂P q₂pol e he emul eP epol
    obtain ⟨ψ₁⟩ := q₁pol; obtain ⟨ψ₂⟩ := q₂pol; obtain ⟨φ₁⟩ := hgpol i; obtain ⟨φ₂⟩ := hgpol j
    have hb₁ : Spec.map (CommRingCat.ofHom χ₁) ≫ Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r i)))) =
        Spec.map (CommRingCat.ofHom (algebraMap S S'')) := by rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hχ₁]
    have hb₂ : Spec.map (CommRingCat.ofHom χ₂) ≫ Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r j)))) =
        Spec.map (CommRingCat.ofHom (algebraMap S S'')) := by rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hχ₂]
    have sq₁ : IsPullback (q₁ ≫ g i) Y.f X.f (Spec.map (CommRingCat.ofHom (algebraMap S S''))) := by
      have := hq₁.paste_horiz (hg i); rwa [hb₁] at this
    have sq₂ : IsPullback (e.hom ≫ q₂ ≫ g j) Y.f X.f (Spec.map (CommRingCat.ofHom (algebraMap S S''))) := by
      have s0 : IsPullback e.hom Y.f Y'.f (𝟙 _) := IsPullback.of_horiz_isIso ⟨by rw [he, Category.comp_id]⟩
      have := (s0.paste_horiz hq₂).paste_horiz (hg j)
      rw [Category.id_comp, hb₂] at this; exact this
    symm
    refine AlgebraicGeometry.PolarisedAbelianScheme.eq_of_isPullback_of_isPullback_of_three_le_of_locally hm (algebraMap S S'') (hmA S'') X Y (q₁ ≫ g i) (e.hom ≫ q₂ ≫ g j) sq₁ ?_ ?_ ?_ sq₂ ?_ ?_ ?_
    · intro T t' x y
      rw [← Category.assoc, q₁mul, hgmul]
      exact T3QMUP.mul_fst_congr' _ (by rw [Category.assoc, hb₁]) (by simp) (by simp)
    · intro l; rw [← Category.assoc, q₁P l, Category.assoc, hgP i l, ← Category.assoc, hb₁]
    · intro p; refine ⟨⊤, trivial, ⟨(Scheme.Modules.pullback _).mapIso
        (T3QMUP.pbCompObj q₁ (g i) X.pol ≪≫ (Scheme.Modules.pullback q₁).mapIso φ₁ ≪≫ ψ₁)⟩⟩
    · intro T t' x y
      rw [← Category.assoc, emul, ← Category.assoc, q₂mul, hgmul]
      exact T3QMUP.mul_fst_congr' _ (by rw [Category.assoc, hb₂]) (by simp) (by simp)
    · intro l; rw [← Category.assoc, eP l, ← Category.assoc, q₂P l, Category.assoc, hgP j l, ← Category.assoc, hb₂]
    · intro p
      obtain ⟨U, hpU, ⟨ηU⟩⟩ := epol p
      refine ⟨U, hpU, ⟨(Scheme.Modules.pullback _).mapIso
        (T3QMUP.pbCompObj e.hom (q₂ ≫ g j) X.pol ≪≫ (Scheme.Modules.pullback e.hom).mapIso
          (T3QMUP.pbCompObj q₂ (g j) X.pol ≪≫ (Scheme.Modules.pullback q₂).mapIso φ₂ ≪≫ ψ₂)) ≪≫ ηU⟩⟩
  have hcovS : ∀ p : ↥(Spec (CommRingCat.of S)), ∃ i y,
      (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r i))))).base y = p := by
    intro p
    have htop : (⨆ i, PrimeSpectrum.basicOpen (r i)) = ⊤ := PrimeSpectrum.iSup_basicOpen_eq_top_iff.mpr hr
    have hp : p ∈ (⨆ i, PrimeSpectrum.basicOpen (r i) : TopologicalSpace.Opens _) := by rw [htop]; trivial
    obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hp
    have hrg : Set.range (fun y => (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r i))))).base y) =
        ((PrimeSpectrum.basicOpen (r i) : TopologicalSpace.Opens (PrimeSpectrum S)) : Set (PrimeSpectrum S)) := by
      rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away (r i)) (r i)]; rfl
    have hi' : p ∈ Set.range (fun y => (Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r i))))).base y) := by
      rw [hrg]; exact hi
    obtain ⟨y, hy⟩ := hi'
    exact ⟨i, y, hy⟩

  have GEN : ∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of S))) X.f,
      (∀ i, (tl i).P.1 ≫ g i = Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r i)))) ≫ P.1) ∧
      (∀ j : Fin (2 * 2), pushPt (act (β j)) (act_over (β j)) P = X.P j) := by

    have hagreeσ : ∀ i j,
        Spec.map (CommRingCat.ofHom (IsLocalization.Away.awayToAwayRight (r i) (r j) :
          Localization.Away (r i) →+* Localization.Away (r i * r j))) ≫ (tl i).P.1 ≫ g i =
        Spec.map (CommRingCat.ofHom (IsLocalization.Away.awayToAwayLeft (r j) (r i) :
          Localization.Away (r j) →+* Localization.Away (r i * r j))) ≫ (tl j).P.1 ≫ g j := by
      intro i j
      obtain ⟨Y, hY⟩ := AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback (IsLocalization.Away.awayToAwayRight (r i) (r j) :
          Localization.Away (r i) →+* Localization.Away (r i * r j)) (Xl i)
      obtain ⟨sY, hsY⟩ := AlgebraicGeometry.PolarisedAbelianScheme.QMStructure.exists_isPullback _ hY (tl i)
      obtain ⟨Y', hY'⟩ := AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback (IsLocalization.Away.awayToAwayLeft (r j) (r i) :
          Localization.Away (r j) →+* Localization.Away (r i * r j)) (Xl j)
      obtain ⟨sY', hsY'⟩ := AlgebraicGeometry.PolarisedAbelianScheme.QMStructure.exists_isPullback _ hY' (tl j)
      obtain ⟨e, he, emul, eP, epol, eact, egen⟩ := hagree i j Y sY Y' sY' hsY hsY'
      obtain ⟨q₁, hq₁, q₁mul, q₁P, q₁pol, q₁act, q₁gen⟩ := hsY
      obtain ⟨q₂, hq₂, q₂mul, q₂P, q₂pol, q₂act, q₂gen⟩ := hsY'
      have hR := RIG i j _ _ (hχR i j) (hχL i j) Y Y' q₁ hq₁ q₁mul q₁P q₁pol q₂ hq₂ q₂mul q₂P q₂pol e he emul eP epol
      rw [← Category.assoc, ← q₁gen, Category.assoc, ← hR, ← Category.assoc, egen, ← Category.assoc, q₂gen, Category.assoc]
    obtain ⟨σ₀, hσ₀, hσ, -⟩ := AlgebraicGeometry.Scheme.existsUnique_section_of_forall_away r hr (fun i => Localization.Away (r i)) X.f (fun i => (tl i).P.1 ≫ g i)
      (fun i => by rw [Category.assoc, (hg i).w, ← Category.assoc, (tl i).P.2, Category.id_comp]) (by
        intro i j C _ _ _ ρ₁ ρ₂

        have hu : ∀ y : Submonoid.powers (r i * r j), IsUnit (Algebra.ofId S C y) := by
          intro y; obtain ⟨n, hn⟩ := y.2; show IsUnit (algebraMap S C y); rw [← hn, map_pow]
          exact (IsLocalization.Away.algebraMap_isUnit (r i * r j)).pow n
        let τ : Localization.Away (r i * r j) →ₐ[S] C := IsLocalization.liftAlgHom (M := Submonoid.powers (r i * r j))
          (f := Algebra.ofId S C) hu
        have hui : ∀ y : Submonoid.powers (r i), IsUnit (Algebra.ofId S (Localization.Away (r i * r j)) y) := by
          intro y; obtain ⟨n, hn⟩ := y.2; show IsUnit (algebraMap S _ y); rw [← hn, map_pow]
          exact (IsLocalization.Away.isUnit_of_dvd (x := r i * r j) (dvd_mul_right _ _)).pow n
        have huj : ∀ y : Submonoid.powers (r j), IsUnit (Algebra.ofId S (Localization.Away (r i * r j)) y) := by
          intro y; obtain ⟨n, hn⟩ := y.2; show IsUnit (algebraMap S _ y); rw [← hn, map_pow]
          exact (IsLocalization.Away.isUnit_of_dvd (x := r i * r j) (dvd_mul_left _ _)).pow n
        let χ₁a : Localization.Away (r i) →ₐ[S] Localization.Away (r i * r j) :=
          IsLocalization.liftAlgHom (M := Submonoid.powers (r i)) (f := Algebra.ofId S _) hui
        let χ₂a : Localization.Away (r j) →ₐ[S] Localization.Away (r i * r j) :=
          IsLocalization.liftAlgHom (M := Submonoid.powers (r j)) (f := Algebra.ofId S _) huj
        have e₁ : ρ₁ = τ.comp χ₁a :=
          @Subsingleton.elim _ (IsLocalization.algHom_subsingleton (Submonoid.powers (r i)) (S := Localization.Away (r i)) (P := C)) _ _
        have e₂ : ρ₂ = τ.comp χ₂a :=
          @Subsingleton.elim _ (IsLocalization.algHom_subsingleton (Submonoid.powers (r j)) (S := Localization.Away (r j)) (P := C)) _ _
        have c₁ : χ₁a.toRingHom = (IsLocalization.Away.awayToAwayRight (r i) (r j) :
            Localization.Away (r i) →+* Localization.Away (r i * r j)) :=
          IsLocalization.ringHom_ext (Submonoid.powers (r i)) (by rw [hχR]; ext x; exact χ₁a.commutes x)
        have c₂ : χ₂a.toRingHom = (IsLocalization.Away.awayToAwayLeft (r j) (r i) :
            Localization.Away (r j) →+* Localization.Away (r i * r j)) :=
          IsLocalization.ringHom_ext (Submonoid.powers (r j)) (by rw [hχL]; ext x; exact χ₂a.commutes x)
        rw [e₁, e₂]
        show Spec.map (CommRingCat.ofHom (τ.toRingHom.comp χ₁a.toRingHom)) ≫ ((tl i).P.1 ≫ g i) =
          Spec.map (CommRingCat.ofHom (τ.toRingHom.comp χ₂a.toRingHom)) ≫ ((tl j).P.1 ≫ g j)
        rw [c₁, c₂, CommRingCat.ofHom_comp, CommRingCat.ofHom_comp, Spec.map_comp, Spec.map_comp, Category.assoc,
          Category.assoc, hagreeσ i j])
    refine ⟨⟨σ₀, by rw [hσ₀]⟩, fun i => (hσ i).symm, fun j => ?_⟩

    apply Subtype.ext
    show σ₀ ≫ act (β j) = (X.P j).1

    let 𝒱 : (Spec (CommRingCat.of S)).OpenCover := Scheme.Cover.mkOfCovers (Fin k)
      (fun i => Spec (CommRingCat.of (Localization.Away (r i))))
      (fun i => Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r i))))) hcovS
    apply 𝒱.hom_ext
    intro i
    show Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r i)))) ≫ σ₀ ≫ act (β j) =
      Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (r i)))) ≫ (X.P j).1
    have hlm : (tl i).P.1 ≫ (tl i).act (β j) = ((Xl i).P j).1 := congrArg Subtype.val ((tl i).level_match j)
    rw [← Category.assoc, hσ i, Category.assoc, ← hact i (β j), ← Category.assoc, hlm, hgP i j]
  obtain ⟨P, hgen, level_match⟩ := GEN

  have POL : ∃ polE : X.A.Modules, CerednikDrinfeld.QM.IsCanonicalPolData X.f X.L act act_over star polE ∧
      LocIsoOnBase X.f X.pol (polE ⊗ polE ⊗ polE) := by
    choose polE hcan hloc3 using fun i => (tl i).pol_canonical
    have locIso_of_iso : ∀ {T : Type} [CommRing T] {A' : Scheme.{0}} (f'' : A' ⟶ Spec (CommRingCat.of T))
        {M N : A'.Modules}, (M ≅ N) → LocIsoOnBase f'' M N := by
      intro T _ A' f'' M N ψ s
      exact ⟨⊤, trivial, ⟨(Scheme.Modules.pullback _).mapIso ψ⟩⟩

    have hagreeZ : ∀ (i j : Fin k) (Aij : Scheme.{0})
        (fij : Aij ⟶ Spec (CommRingCat.of (Localization.Away (r i * r j))))
        (pi : Aij ⟶ (Xl i).A) (pj : Aij ⟶ (Xl j).A),
        IsPullback pi fij (Xl i).f
          (Spec.map (CommRingCat.ofHom (IsLocalization.Away.awayToAwayRight (r i) (r j) :
            Localization.Away (r i) →+* Localization.Away (r i * r j)))) →
        IsPullback pj fij (Xl j).f
          (Spec.map (CommRingCat.ofHom (IsLocalization.Away.awayToAwayLeft (r j) (r i) :
            Localization.Away (r j) →+* Localization.Away (r i * r j)))) →
        pi ≫ g i = pj ≫ g j →
        LocIsoOnBase fij ((Scheme.Modules.pullback pi).obj (polE i)) ((Scheme.Modules.pullback pj).obj (polE j)) := by
      intro i j Aij fij pi pj hpi hpj hcomm

      obtain ⟨Y, hY⟩ := AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback (IsLocalization.Away.awayToAwayRight (r i) (r j) :
          Localization.Away (r i) →+* Localization.Away (r i * r j)) (Xl i)
      obtain ⟨sY, hsY⟩ := AlgebraicGeometry.PolarisedAbelianScheme.QMStructure.exists_isPullback _ hY (tl i)
      obtain ⟨Y', hY'⟩ := AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback (IsLocalization.Away.awayToAwayLeft (r j) (r i) :
          Localization.Away (r j) →+* Localization.Away (r i * r j)) (Xl j)
      obtain ⟨sY', hsY'⟩ := AlgebraicGeometry.PolarisedAbelianScheme.QMStructure.exists_isPullback _ hY' (tl j)
      obtain ⟨e, he, emul, eP, epol, eact, egen⟩ := hagree i j Y sY Y' sY' hsY hsY'
      obtain ⟨q₁, hq₁, q₁mul, q₁P, q₁pol, q₁act, q₁gen⟩ := hsY
      obtain ⟨q₂, hq₂, q₂mul, q₂P, q₂pol, q₂act, q₂gen⟩ := hsY'
      have hR := RIG i j _ _ (hχR i j) (hχL i j) Y Y' q₁ hq₁ q₁mul q₁P q₁pol q₂ hq₂ q₂mul q₂P q₂pol e he emul eP epol

