theorem isUnit_natCast_of_coprime {A : Type} [CommRing A] [IsLocalRing A] (n q : ℕ) (hcop : Nat.Coprime n q)
    (hq : (q : A) ∈ IsLocalRing.maximalIdeal A) : IsUnit ((n : ℕ) : A) := by
  have hc : IsCoprime ((n : ℤ) : A) ((q : ℤ) : A) :=
    (Nat.isCoprime_iff_coprime.mpr hcop).map (Int.castRingHom A)
  simp only [Int.cast_natCast] at hc
  obtain ⟨u, v, huv⟩ := hc
  by_contra hn
  have hn' : (n : A) ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal _).mpr hn
  have h1 : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
    rw [← huv]; exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hn') (Ideal.mul_mem_left _ _ hq)
  exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h1)

theorem X_mul_coe_X_pow_mul {R : Type} [CommRing R] (u : PowerSeries R) {n : ℕ} (hn : 1 ≤ n) :
    PowerSeries.X * ((Polynomial.X ^ (n - 1) : Polynomial R) : PowerSeries R) * u = u * PowerSeries.X ^ n := by
  rw [Polynomial.coe_pow, Polynomial.coe_X, ← pow_succ', Nat.sub_add_cancel hn, mul_comm]

theorem map_X_pow {R S : Type} [CommRing R] [CommRing S] (f : R →+* S) (n : ℕ) :
    (Polynomial.X ^ n : Polynomial R).map f = Polynomial.X ^ n := by
  rw [Polynomial.map_pow, Polynomial.map_X]

