theorem solution (s t : Fin d → ℕ) [∀ i, NeZero (s i)] [∀ i, NeZero (t i)] (c : ℂ)
    (A : (i : Fin d) → (ZMod (s i) → ℂ) →L[ℂ] (ZMod (t i) → ℂ))
    (B : (i : Fin d) → (ZMod (t i) → ℂ) →L[ℂ] (ZMod (s i) → ℂ))
    (hA : ∀ i, ‖A i‖ ≤ 1) (hB : ∀ i, ‖B i‖ ≤ 1)
    (h : ∀ i u, IntMul.OpenAI.RH.permS (s i) (t i) ((s i : ℂ)⁻¹ • ZMod.dft u) =
      c • B i (IntMul.OpenAI.RH.permT (s i) (t i) ((t i : ℂ)⁻¹ • ZMod.dft (A i u)))) :
    ‖IntMul.OpenAI.RT.tensCLM (NLogN.KFM.kerA A)‖ ≤ 1 ∧ ‖IntMul.OpenAI.RT.tensCLM (NLogN.KFM.kerB B)‖ ≤ 1 ∧
      ∀ u, IntMul.OpenAI.RT.Rperm s t (IntMul.OpenAI.RT.dftM s u) =
        c ^ d • IntMul.OpenAI.RT.tensCLM (NLogN.KFM.kerB B) (IntMul.OpenAI.RT.Qperm s t (IntMul.OpenAI.RT.dftM t (IntMul.OpenAI.RT.tensCLM (NLogN.KFM.kerA A) u))) := by
  set a := NLogN.KFM.kerA A
  set b := NLogN.KFM.kerB B
  set ft : (i : Fin d) → ZMod (t i) → ZMod (t i) → ℂ :=
    fun i k l => (t i : ℂ)⁻¹ * ZMod.stdAddChar (-(l * (-((s i : ZMod (t i)) * k))))
  set fs : (i : Fin d) → ZMod (s i) → ZMod (s i) → ℂ :=
    fun i k j => (s i : ℂ)⁻¹ * ZMod.stdAddChar (-(j * ((t i : ZMod (s i)) * k)))
  have hker : fs = fun i k j => c * ∑ m, b i k m * ∑ l, ft i m l * a i l j := by
    funext i k j
    refine IntMul.OpenAI.RT.kernel_identity' c (A i) (B i) (fs i) (ft i) (fun u => ?_) k j
    have := h i u
    have e1 : (fun k => ∑ j, fs i k j * u j) =
        IntMul.OpenAI.RH.permS (s i) (t i) ((s i : ℂ)⁻¹ • ZMod.dft u) := by
      ext k'
      simp only [fs, IntMul.OpenAI.RH.permS, Pi.smul_apply, ZMod.dft_apply, smul_eq_mul,
        Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_); ring
    have e2 : (fun m => ∑ l, ft i m l * A i u l) =
        IntMul.OpenAI.RH.permT (s i) (t i) ((t i : ℂ)⁻¹ • ZMod.dft (A i u)) := by
      ext m
      simp only [ft, IntMul.OpenAI.RH.permT, Pi.smul_apply, ZMod.dft_apply, smul_eq_mul,
        Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_); ring
    rw [e1, e2, this]
  refine ⟨IntMul.OpenAI.RT.norm_tensCLM_le a (fun i l => (IntMul.OpenAI.RT.kernel_row_le (A i) l).trans (hA i)),
    IntMul.OpenAI.RT.norm_tensCLM_le b (fun i k => (IntMul.OpenAI.RT.kernel_row_le (B i) k).trans (hB i)), fun u => ?_⟩
  rw [IntMul.OpenAI.RT.Rperm_dftM_eq_tens, IntMul.OpenAI.RT.Qperm_dftM_eq_tens]
  change IntMul.OpenAI.RT.tens fs u = _
  rw [IntMul.OpenAI.RT.tensCLM_apply, IntMul.OpenAI.RT.tensCLM_apply, IntMul.OpenAI.RT.tens_comp, IntMul.OpenAI.RT.tens_comp, hker, IntMul.OpenAI.RT.tens_smul]
  congr 2; funext i k j
  simp only [Finset.mul_sum, Finset.sum_mul, mul_assoc]
  rw [Finset.sum_comm]; simp only [ft, mul_assoc]
