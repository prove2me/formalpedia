namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.NullDirections

/-! ## Scalar frame algebra -/

/-- `F♯ K_λ - λ K_λ = (0, α² - λ², 0, 0, 0)`, before choosing `λ`. -/
theorem frameZ_principal_sub {f D A H u : ℝ} (hf : f ≠ 0) (hD : D ≠ 0) (hH : H ≠ 0)
    (e a1 a0 lam : ℝ) :
    frameZ f D A H u e a1 a0 (principalFrame f H e a1 lam) - lam • principalFrame f H e a1 lam =
      ![0, alphaSqFrame f D H e a1 - lam ^ 2, 0, 0, 0] := by
  funext i
  fin_cases i <;> simp [frameZ, principalFrame, alphaSqFrame] <;> field_simp <;> ring

theorem frameZ_principal_of_sq {f D A H u : ℝ} (hf : f ≠ 0) (hD : D ≠ 0) (hH : H ≠ 0)
    (e a1 a0 lam : ℝ) (hl : lam ^ 2 = alphaSqFrame f D H e a1) :
    frameZ f D A H u e a1 a0 (principalFrame f H e a1 lam) =
      lam • principalFrame f H e a1 lam := by
  have h := frameZ_principal_sub (A := A) (u := u) (a0 := a0) hf hD hH e a1 lam
  rw [hl, sub_self] at h
  rw [← sub_eq_zero, h]
  funext i
  fin_cases i <;> simp

/-! ## The actual frame: explicit inverse and bindings to the actual tensors -/

theorem esFrame_mulVec_frameInv (W : ℝ → ℝ) (x : Pt 5) (k : Fin 5 → ℝ) :
    esFrame W x *ᵥ frameInv W x k = k := by
  funext i
  fin_cases i <;> simp [esFrame, frameInv, Matrix.mulVec, dotProduct, Fin.sum_univ_five] <;> ring

theorem frameInv_esFrame_mulVec (W : ℝ → ℝ) (x : Pt 5) (v : Fin 5 → ℝ) :
    frameInv W x (esFrame W x *ᵥ v) = v := by
  funext i
  fin_cases i <;> simp [esFrame, frameInv, Matrix.mulVec, dotProduct, Fin.sum_univ_five] <;> ring

theorem frameInv_eq_zero_iff (W : ℝ → ℝ) (x : Pt 5) (k : Fin 5 → ℝ) :
    frameInv W x k = 0 ↔ k = 0 := by
  constructor
  · intro h
    rw [← esFrame_mulVec_frameInv W x k, h, Matrix.mulVec_zero]
  · rintro rfl
    funext i
    fin_cases i <;> simp [frameInv]

theorem frameInv_smul (W : ℝ → ℝ) (x : Pt 5) (c : ℝ) (k : Fin 5 → ℝ) :
    frameInv W x (c • k) = c • frameInv W x k := by
  funext i
  fin_cases i <;> simp [frameInv] <;> ring

/-- The actual metric contraction is the frame quadratic form of the frame components. -/
theorem contract2_esMetric (B D A H W : ℝ → ℝ) (x : Pt 5) (k : Fin 5 → ℝ) :
    contract2 (esMetric B D A H W) x k =
      frameQ (B (x 1)) (D (x 1)) (A (x 1)) (H (x 1)) (x 2) (frameInv W x k) := by
  simp only [contract2, Fin.sum_univ_five]
  simp [esMetric, frameQ, frameInv]
  ring

variable {R : Set ℝ} {B D A H W Φ Ψ : ℝ → ℝ}

/-- The actual Faraday matrix `F_ij(x)` equals the VI table `FG` on the domain. -/
theorem metricMatrix_esFaraday (hE : ESData R B D A H W Φ Ψ) {x : Pt 5}
    (hx : x ∈ esDomain R) :
    metricMatrix (esFaraday Φ Ψ) x = Matrix.of fun i j => Generic.FG Φ Ψ i j x := by
  ext i j
  exact Generic.bind_F hE i j hx

/-- The VI Faraday table `FG` at `x`, as an explicit matrix (entry by entry definitional). -/
theorem FG_matrix (Φ Ψ : ℝ → ℝ) (x : Pt 5) :
    (Matrix.of fun i j => Generic.FG Φ Ψ i j x) =
      !![0, -1 * deriv Φ (x 1), 0, 0, 0;
         1 * deriv Φ (x 1), 0, 0, 1 * deriv Ψ (x 1) * x 2,
           -1 * deriv Ψ (x 1) * x 2 + 1 * deriv Ψ (x 1);
         0, 0, 0, 1 * Ψ (x 1), -1 * Ψ (x 1);
         0, -1 * deriv Ψ (x 1) * x 2, -1 * Ψ (x 1), 0, 0;
         0, 1 * deriv Ψ (x 1) * x 2 + -1 * deriv Ψ (x 1), 1 * Ψ (x 1), 0, 0] := by
  ext i j
  fin_cases i <;> fin_cases j <;> rfl

/-- **Actual raised vector.** The frame components of the actual mixed vector
`(g⁻¹ F) k` are `frameZ` of the frame components of `k`. -/
theorem frameInv_raise (hE : ESData R B D A H W Φ Ψ) {x : Pt 5} (hx : x ∈ esDomain R)
    (k : Fin 5 → ℝ) :
    frameInv W x ((metricMatrix (esInverse B D A H W) x * metricMatrix (esFaraday Φ Ψ) x) *ᵥ k) =
      frameZ (B (x 1)) (D (x 1)) (A (x 1)) (H (x 1)) (x 2)
        (deriv Φ (x 1) + W (x 1) * deriv Ψ (x 1)) (deriv Ψ (x 1)) (Ψ (x 1)) (frameInv W x k) := by
  obtain ⟨hB, hD, hA, hH, hu, hv⟩ := hE.nz hx
  rw [metricMatrix_esFaraday hE hx, FG_matrix]
  funext i
  fin_cases i <;>
    simp [Matrix.mulVec, dotProduct, Matrix.mul_apply, Fin.sum_univ_five, metricMatrix,
      esInverse, frameInv, frameZ] <;>
    field_simp <;> first | ring1 | (left; ring1)

/-! ## The paper-dictionary discriminant -/

/-- `alphaSq = (e²/f - (a')²/H)/D` with `D = m/(4fN)`, `H = N/m`. -/
theorem alphaSq_eq_frame {f m N : ℝ → ℝ} (w p a : ℝ → ℝ) {r : ℝ} (hf : f r ≠ 0) (hm : m r ≠ 0)
    (hN : N r ≠ 0) :
    alphaSq f m N w p a r =
      alphaSqFrame (f r) (Dfun f m N r) (Hfun m N r) (eFun w p a r) (deriv a r) := by
  simp only [alphaSq, alphaSqFrame, Dfun, Hfun]
  field_simp

