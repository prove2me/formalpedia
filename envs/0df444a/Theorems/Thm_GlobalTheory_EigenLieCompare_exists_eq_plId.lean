theorem GlobalTheory.EigenLieCompare.exists_eq_plId (M : Ideal (PadicOrder p E)) [M.IsPrime] (hp : (p : PadicOrder p E) ∈ M) :
    ∃ w : HeightOneSpectrum (𝓞 E), IsOver p w ∧ w.asIdeal = M.comap (toPadic p E) ∧
      M = plId p w := by sorry
