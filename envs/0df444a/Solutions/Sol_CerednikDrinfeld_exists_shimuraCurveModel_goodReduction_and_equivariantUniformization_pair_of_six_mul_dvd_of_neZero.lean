    {S : Type} [Group S] {scalar : S →* ↥(A.decompositionSubgroup ℚ)}

    (F : Type) [Field F] [Algebra (AlgebraicClosure ℚ) F]
    (FC : Type) [Field FC] [Algebra A.valuation.Completion FC] [Algebra F FC]
    {galT₀ : S →* AddAut (Pic0 A.valuation.Completion FC)}
    {E𝒞 V𝒞 : Type} [Fintype E𝒞] [DecidableEq E𝒞] [Fintype V𝒞] [DecidableEq V𝒞] (𝒞 : DegeneracyData E𝒞 V𝒞)
    {actZ₀ : S →* (↥(ribbonKernel 𝒞) ≃ₗ[ℤ] ↥(ribbonKernel 𝒞))}
    (𝒰₀ : EquivariantUniformization r 𝒞 A hA (Pic0 A.valuation.Completion FC) S scalar actZ₀ galT₀)

    (F' : Type) [Field F'] [Algebra (AlgebraicClosure ℚ) F']
    (FC' : Type) [Field FC'] [Algebra A.valuation.Completion FC'] [Algebra F' FC']
    {galT₁ : S →* AddAut (Pic0 A.valuation.Completion FC')}
    {E𝒞' V𝒞' : Type} [Fintype E𝒞'] [DecidableEq E𝒞'] [Fintype V𝒞'] [DecidableEq V𝒞'] (𝒞' : DegeneracyData E𝒞' V𝒞')
    {actZ₁ : S →* (↥(ribbonKernel 𝒞') ≃ₗ[ℤ] ↥(ribbonKernel 𝒞'))}
    (𝒰₁ : EquivariantUniformization r 𝒞' A hA (Pic0 A.valuation.Completion FC') S scalar actZ₁ galT₁)

    (α β : DegeneracyData.FiniteHom 𝒞' 𝒞)
    [HasPrincipalDivisors A.valuation.Completion FC']
    (φα φβ : FC →ₐ[A.valuation.Completion] FC') (hφα : φα.toRingHom.IsIntegral) (hφβ : φβ.toRingHom.IsIntegral)
    (hFIβ : FundamentalIdentityAlong A.valuation.Completion φβ hφβ)
    (hfinα : FiniteAlong A.valuation.Completion φα) (hNα : NormFormulaAlong A.valuation.Completion φα hfinα)

    (hconorm : ∀ (u : 𝒰₀.P.TorusPoints)
        (D : Divisor.degZero (K := A.valuation.Completion) (F := FC))
        (D' : Divisor.degZero (K := A.valuation.Completion) (F := FC')),
      𝒰₀.eFull u = Pic0.mk D →
      (D' : Divisor A.valuation.Completion FC') = Divisor.pullbackAlong φβ hφβ (D : Divisor A.valuation.Completion FC) →
      𝒰₁.eFull (u.comp β.pushforward) = Pic0.mk D')
    (hnorm : ∀ (u' : 𝒰₁.P.TorusPoints)
        (D' : Divisor.degZero (K := A.valuation.Completion) (F := FC'))
        (D : Divisor.degZero (K := A.valuation.Completion) (F := FC)),
      𝒰₁.eFull u' = Pic0.mk D' →
      (D : Divisor A.valuation.Completion FC) = Divisor.pushforwardAlong φα hφα (D' : Divisor A.valuation.Completion FC') →
      𝒰₀.eFull (u'.comp α.pullback) = Pic0.mk D)

    [HasPrincipalDivisors (AlgebraicClosure ℚ) F']
    (φ'α φ'β : F →ₐ[AlgebraicClosure ℚ] F') (hφ'α : φ'α.toRingHom.IsIntegral) (hφ'β : φ'β.toRingHom.IsIntegral)
    (hFI'β : FundamentalIdentityAlong (AlgebraicClosure ℚ) φ'β hφ'β)
    (hfin'α : FiniteAlong (AlgebraicClosure ℚ) φ'α) (hN'α : NormFormulaAlong (AlgebraicClosure ℚ) φ'α hfin'α)
    (hHBC : ∀ (ι' : Pic0 (AlgebraicClosure ℚ) F →+ Pic0 A.valuation.Completion FC),
      (∀ (D : Divisor.degZero (K := AlgebraicClosure ℚ) (F := F))
          (D' : Divisor.degZero (K := A.valuation.Completion) (F := FC)),
