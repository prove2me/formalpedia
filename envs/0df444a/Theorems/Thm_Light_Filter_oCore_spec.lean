open ThreeSumApsp ThreeSumApsp.Spec Light.Sec3 Light.Sec3.Et17
variable {lim : Limits} {d : ℕ}

theorem Light.Filter.oCore_spec {P₀ R : Program} {ν : ONums} {Tn : List ℕ → ℕ} {need : List ℕ → Light.Need}
    (C : OCoreCtx P₀ R ν Tn need) (x : OracleInst) (μ : ℕ → ℤ) (fr : ℕ) (hpre : x.Pre μ fr)
    (hr : Ready lim d x.toTriInst (oDataOf x) μ fr)
    (hlim : HostLim lim (d + 1) (oDataOf x) x.U (hostAddr x.toTriInst (oDataOf x) fr) need) :
    Ends lim (P₀ ++ R) d (oCoreBody ν) ⟨Light.frame (oCoreArgs x fr), μ⟩
      (et17Addr.blockCost + tCoreRun Tn (oDataOf x) x.U)
      fun σ' => Seg σ'.mem x.cnt (cntList x.n x.s x.p x.AB x.BC x.AC) ∧
        KeptBut μ σ'.mem fr x.cnt x.len := by sorry
