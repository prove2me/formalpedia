theorem exists_perm_char :
    ∃ (σ : Equiv.Perm ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A))) (τ : Equiv.Perm ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A))),
      X.edgeHecke ⟨q', Fact.out⟩ = permMat σ ∧ X.vertexHecke ⟨q', Fact.out⟩ = permMat τ ∧
      ∀ i : Fin 2, degeneracyMatrix (![X.degeneracyData.a, X.degeneracyData.b] i) * permMat σ =
        permMat τ * degeneracyMatrix (![X.degeneracyData.a, X.degeneracyData.b] i) := by
  obtain ⟨n₁, hn₁, n₂, hn₂, padj, hpadj, -, -, h3, -, -, -, -, -, ⟨σ, hσ⟩, ⟨τ, hτ⟩, -⟩ :=
    SSLevelDatum.exists_heckeRowSums_and_adjointPair_laws M s q' hs hq5 hsq' hq'M hsM A X
  have hE : X.edgeHecke ⟨q', Fact.out⟩ = permMat σ := by
    ext i j; rw [hσ i j, permMat_apply]
  have hV : X.vertexHecke ⟨q', Fact.out⟩ = permMat τ := by
    ext i j; rw [hτ i j, permMat_apply]
  refine ⟨σ, τ, hE, hV, fun i => ?_⟩
  rw [← hE, ← hV]
  exact h3 i ⟨q', Fact.out⟩ (fun h => hsq' h.symm)

theorem eqvAdj_of_dvd (ℓ : Nat.Primes) (hℓM : (ℓ : ℕ) ∣ M) (i : Fin 2) (x : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) → ℤ) :
    jointDelta X.degeneracyData i ((adjE M s q' A X ℓ).mulVecLin x) =
      (adjV M s q' A X ℓ).mulVecLin (jointDelta X.degeneracyData i x) := by
  have hℓq' : (ℓ : ℕ) ≠ q' := fun e => hq'M (e ▸ hℓM)
  haveI : NeZero (ℓ : ℕ) := ⟨ℓ.2.ne_zero⟩
  haveI : Fact (ℓ : ℕ).Prime := ⟨ℓ.2⟩
  haveI := hPD (M * s) ℓ (natCast_ne_zero_of_not_dvd q' A (M * s) (not_q'_dvd_Ms M s q' hs hsq' hq'M))
    (natCast_ne_zero_of_prime_ne q' A ℓ hℓq')
  haveI := hPD M ℓ (natCast_ne_zero_of_not_dvd q' A M hq'M) (natCast_ne_zero_of_prime_ne q' A ℓ hℓq')
  refine jointDelta_intertwine_of_mul_eq X.degeneracyData i ?_ x
  have hE : adjE M s q' A X ℓ = Matrix.of (fun y x : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) =>
      Divisor.correspondence (heckeAlphaC (IsLocalRing.ResidueField ↥A) (M * s) ℓ) (heckeBetaC (IsLocalRing.ResidueField ↥A) (M * s) ℓ)
        (X.legsIntegral (M * s) ℓ).1 (X.legsIntegral (M * s) ℓ).2 (Finsupp.single x.1 1) y.1) := by
    ext y x'
