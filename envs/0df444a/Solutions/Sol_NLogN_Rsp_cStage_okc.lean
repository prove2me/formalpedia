  | .lit _, _ => Iff.rfl
  | .add a b, h | .mul a b, h | .shl a b, h | .ndiv a b, h | .nmod a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.Bnd, ex_bnd_congr B a (fun i hi => h i (Or.inl hi)),
      ex_bnd_congr B b (fun i hi => h i (Or.inr hi)), ex_eval_congr a (fun i hi => h i (Or.inl hi)),
      ex_eval_congr b (fun i hi => h i (Or.inr hi))]
  | .quo a b, h | .rem a b, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.Bnd, ex_bnd_congr B a (fun i hi => h i (Or.inl hi)),
      ex_bnd_congr B b (fun i hi => h i (Or.inr hi))]
  | .neg a, h => by simp only [Ex.regs] at h; simp only [Ex.Bnd, ex_bnd_congr B a h]
  | .pow2 a, h => by
    simp only [Ex.regs] at h; simp only [Ex.Bnd, ex_bnd_congr B a h, ex_eval_congr a h]
  | .sel c x y, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.Bnd, ex_bnd_congr B c (fun i hi => h i (Or.inl (Or.inl hi))),
      ex_bnd_congr B x (fun i hi => h i (Or.inl (Or.inr hi))),
      ex_bnd_congr B y (fun i hi => h i (Or.inr hi)),
      ex_eval_congr c (fun i hi => h i (Or.inl (Or.inl hi)))]

theorem good_congr {A : SArgs} (hA : A.Good) {σ σ' : IState HS}
    (h : ∀ i, i ∉ stTg → σ.G i = σ'.G i) (e : Ex HS) (he : e ∈ A.l) :
    e.eval σ = e.eval σ' ∧ (e.ok σ ↔ e.ok σ') ∧ e.cost σ = e.cost σ' ∧
      ∀ B, (e.Bnd σ B ↔ e.Bnd σ' B) := by
  have hr : ∀ i ∈ e.regs, σ.G i = σ'.G i := fun i hi => h i (hA e he i hi).1
  exact ⟨ex_eval_congr e hr, ex_ok_congr e hr, ex_cost_congr e hr, fun B => ex_bnd_congr B e hr⟩

