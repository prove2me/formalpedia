lemma complex_identity (x y : ℝ) :
    (∑ n ∈ Finset.range 40, (c n:ℂ)*((y:ℂ)-Complex.I*x)^n)-
      (CertifiedLocalPolynomial.bivariatePowerValue 8 16 a
        (4*x^2) ((5/7)*(y-(1/10))):ℂ)=Complex.I*(imaginaryValue x y:ℂ) := by
  norm_num [c,TaoFivePrimes_RH114p5RoundedCoefficients,Finset.sum_range_succ,
    CertifiedLocalPolynomial.bivariatePowerValue,
    a,entry,powerMatrix,Fin.sum_univ_succ,imaginaryValue]
  push_cast
  ring_nf
  norm_num [Complex.I_pow_eq_pow_mod]
  try simp only [Complex.I_sq,Complex.I_pow_three,pow_zero,pow_one]
  apply Complex.ext <;>
    simp [←Complex.ofReal_pow,Complex.mul_re,Complex.mul_im] <;> ring

lemma power_identity (s : ℂ) :
    (TaoFivePrimes_RHLocalRoundedPolynomial TaoFivePrimes_RH114p5RoundedCoefficients
      40 (229/2) s).re =
      CertifiedLocalPolynomial.bivariatePowerValue 8 16 a
        (4*(s.re-1/2)^2) ((5/7)*(s.im-(573/5))) := by
  have h := complex_identity (s.re-1/2) (s.im-229/2)
  have hw : -Complex.I*(s-RH1000Analytic.CertifiedLocalXi.center (229/2)) =
      ((s.im-229/2:ℝ):ℂ)-Complex.I*((s.re-1/2:ℝ):ℂ) := by
    apply Complex.ext <;> simp [RH1000Analytic.CertifiedLocalXi.center] <;> ring
  unfold TaoFivePrimes_RHLocalRoundedPolynomial
  simp only [hw]
  have hr := congrArg Complex.re h
  simp only [Complex.sub_re,Complex.neg_re,Complex.ofReal_re,Complex.mul_re,
    Complex.I_re,Complex.I_im,Complex.ofReal_im,zero_mul,mul_zero,sub_zero] at hr
  have he : (5/7:ℝ)*(s.im-229/2-(1/10))=(5/7)*(s.im-(573/5)) := by ring
  rw [he] at hr
  simp only [c,Complex.ofReal_div,Complex.ofReal_intCast] at hr
  simp only [Complex.ofReal_intCast]
  linarith only [hr]

open scoped unitInterval
attribute [local irreducible] a r b
lemma polynomial_negative (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
    (ha : (573/5:ℝ) ≤ s.im) (hb : s.im ≤ (116:ℝ)) :
    5 ≤ (TaoFivePrimes_RHLocalRoundedPolynomial TaoFivePrimes_RH114p5RoundedCoefficients
      40 (229/2) s).re := by
  let x : Set.Icc (0:ℝ) 1 := ⟨4*(s.re-1/2)^2,⟨by positivity,by
    nlinarith [mul_nonneg h0 (show 0≤1-s.re by linarith)]⟩⟩
  let y : Set.Icc (0:ℝ) 1 := ⟨(5/7)*(s.im-(573/5)),⟨by linarith,by linarith⟩⟩
  have hr : ∀ i, r i=TaoZetaNumerics.bernsteinTransform 16 (a i) := by
    intro i
    funext j
    exact bernstein_checked.1 i j
  have hc : ∀ j, (fun i => b i j)=TaoZetaNumerics.bernsteinTransform 8
      (fun i => r i j) := by
    intro j
    funext i
    exact bernstein_checked.2.1 i j
  have hl : ∀ i j, (5:ℝ)≤(b i j:ℝ) := by
    intro i j
    exact_mod_cast bernstein_checked.2.2 i j
  have hh := CertifiedLocalPolynomial.bivariate_bernstein_lower 8 16 a r b hr hc 5 hl x y
  rw [power_identity]
  exact hh
end Negative107

theorem solution (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
    (ha : (573/5:ℝ) ≤ s.im) (hb : s.im ≤ (116:ℝ)) :
    (5:ℝ) ≤ (TaoFivePrimes_RHLocalRoundedPolynomial
      TaoFivePrimes_RH114p5RoundedCoefficients 40 (229/2) s).re :=
  Negative107.polynomial_negative s h0 h1 ha hb
