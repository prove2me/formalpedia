theorem solution (t : NLogN.IState NLogN.HS) (xs : List ℤ) (A Mf C : AModel.Shape) (q Bb : ℕ)
    (R L1 L2 L3 L4 : List NLogN.Item)
    (hlen : xs.length = AModel.vol (A ++ [q] ++ Mf ++ C)) (hb : NLogN.Bnd Bb xs)
    (hC1 : 1 ≤ AModel.vol C) (hM1 : 1 ≤ AModel.vol Mf) (hq1 : 1 ≤ q) (hA1 : 1 ≤ AModel.vol A)
    (hV : NLogN.zsz ((AModel.vol A * (q * (AModel.vol Mf * AModel.vol C)) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = NLogN.ints xs ++ R) (h1 : t.G 1 = .int (AModel.vol A) :: L1) (h2 : t.G 2 = .int q :: L2)
    (h3 : t.G 3 = .int (AModel.vol Mf) :: L3) (h4 : t.G 4 = .int (AModel.vol C) :: L4) :
    NLogN.KIL.fwdP.ok t ∧ NLogN.KIL.fwdP.run t = t.upd 0 (NLogN.ints (AModel.pull (A ++ [q] ++ Mf ++ C) (A ++ Mf ++ [q] ++ C)
        (NLogN.KIL.swapMid A.length 1 Mf.length) 0 xs) ++ R) ∧
      NLogN.KIL.fwdP.cost t ≤ NLogN.KIL.cMove (AModel.vol A) q (AModel.vol Mf) (AModel.vol C) Bb := by
  have hq : AModel.vol [q] = q := by simp [AModel.vol]
  have := NLogN.KIL.swapF_spec t xs A [q] Mf C Bb R L1 L2 L3 L4 hlen hb hC1 hM1 (by rw [hq]; exact hq1) hA1
    (by rw [hq]; exact hV) h0 h1 (by rw [hq]; exact h2) h3 h4
  rw [hq] at this
  exact this
