theorem solution
    (K : Type u) [Field K] [IsAlgClosed K] {A : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of K))
    (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle K f)
    (g : ℕ) [SmoothOfRelativeDimension g f]
    (n : ℕ) (hn : (n : K) ≠ 0)
    (z z' : A) (h : (L.schemeNsmul n).base z = (L.schemeNsmul n).base z') :
    ∃ P ∈ L.torsionSubset (𝟙 (Spec (CommRingCat.of K))) n, (L.translate P).base z = z' := by

  obtain ⟨w, hw₁, hw₂⟩ := Scheme.Pullback.exists_preimage_pullback (f := L.schemeNsmul n) (g := L.schemeNsmul n) z z' h

  obtain ⟨U, hU, hUP⟩ :=
    AbelianSchemePropertyBundle.exists_iSup_eq_top_iota_comp_eq_iota_comp_comp_translate_of_comp_schemeNsmul_eq
      K f L hc hA g n hn (pullback.fst (L.schemeNsmul n) (L.schemeNsmul n))
      (pullback.snd (L.schemeNsmul n) (L.schemeNsmul n)) pullback.condition

  have hw : w ∈ (⨆ P, U P) := by rw [hU]; trivial
  obtain ⟨P, hP⟩ := TopologicalSpace.Opens.mem_iSup.mp hw
  refine ⟨P.1, P.2, ?_⟩
  have e := congrArg (fun φ => φ.base ⟨w, hP⟩) (hUP P)
  simp only [Scheme.Hom.comp_apply] at e

  rw [← hw₁, ← hw₂]
  have hι : (U P).ι.base ⟨w, hP⟩ = w := rfl
  rw [hι] at e
  exact e.symm

