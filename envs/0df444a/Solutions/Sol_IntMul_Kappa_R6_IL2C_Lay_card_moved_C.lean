section
-- Source module: Solutions.R6IL2CRec
/-!
# Round six, compact controls (I2C): the ten rotations as steps of the record index

For a layout `l` with `QC = R^n`, `QL = 2^L`, the table rotations of the program (with the tables
`tabE` of `R6IL2CTab`, offsets of `R6IL2CMath`) are the record pulls `l.stepP F` of the steps of
`Psi` (`rotA_pull`, `rotB_pull`, `rotS_pull`, `rotC_pull`, `rotL_pull`), and the composite of the
ten pulls is `l.stepP Psi` (`psi_pull`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL AModel AModelL12

namespace Lay

variable {l : Lay} {K ρ G n L : ℕ}

/-! ## The composite -/

theorem boxL_iff (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (c : CS) :
    l.BoxL c ↔ Box G n L c := by
  unfold BoxL Box; rw [hQC, hQL]

end Lay

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CCount
/-!
# Round six, compact controls (I2C): the moved records are few

The correction key `κ = stepP (TlS ∘ Psi)` fixes every record whose state is `Good`
(`Psi_good`, `Tl_Tl`). A record is not good only if one of the `n` digits of `T` or `U` is
`2^G - 1`, or one of the `n` guard segments of `Y` is out of range (`2·2^G + 2` values of
`2^K`).

**`card_moved_C`**: `#{m < M : κ m ≠ m} · 2^G · 2^K ≤ n · M · (2 · 2^K + (2 · 2^G + 2) · 2^G)`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL Finset

namespace Lay

variable {l : Lay} {K ρ G n L : ℕ}

/-- The key fixes the good records. -/
theorem key_good (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K)
    (hG : 1 ≤ G) (hL : ρ + n * K ≤ L) {m : ℕ} (hg : Good K ρ G n (l.cs m)) :
    l.stepP (fun x c => TlS K ρ n x (Psi K ρ G n L x c)) m = m := by
  have hb : Box G n L (l.cs m) := (boxL_iff hQC hQL _).1 (box_cs h m)
  unfold stepP
  beta_reduce
  rw [Psi_good hK hG hL _ hb hg]
  have e : TlS K ρ n (l.xv m) (TlS K ρ n (l.xv m) (l.cs m)) = l.cs m := by
    unfold TlS; rw [Tl_Tl hK hL _ hb.2.2]
  rw [e, set_cs h]

theorem div_pow_digit {a S W : ℕ} (s : ℕ) : a / S / W ^ s % W = a / (S * W ^ s) % W := by
  rw [Nat.div_div_eq_div_mul]

/-- One digit of the record index, counted. -/
theorem count_field {M A W C : ℕ} (hA : 0 < A) (hW : 0 < W) (hM : M = A * (W * C))
    (p : ℕ → Prop) [DecidablePred p] :
    ((range M).filter fun m => p (m / A % W)).card = A * ((range W).filter p).card * C := by
  have e : ((range M).filter fun m => p (m / A % W)) =
      (range (A * (W * C))).filter fun m => m / A % W ∈ (range W).filter p := by
    rw [hM]; apply Finset.filter_congr; intro x _
    simp only [Finset.mem_filter, Finset.mem_range]
    exact ⟨fun h => ⟨Nat.mod_lt _ hW, h⟩, fun h => h.2⟩
  rw [e]
  exact Butterfly.count_digit A W C hA hW _ (filter_subset _ _)

theorem card_top (W : ℕ) (hW : 1 ≤ W) : ((range W).filter fun v => W < v + 2).card = 1 := by
  have e : (range W).filter (fun v => W < v + 2) = {W - 1} := by
    ext v; simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_singleton]; omega
  rw [e, card_singleton]

theorem card_guard (K R : ℕ) (hK : 1 ≤ K) :
    ((range (2 ^ K)).filter fun v => ¬ (1 ≤ v / 2 ∧ v / 2 + R + 1 ≤ 2 ^ (K - 1))).card ≤
      2 * R + 2 := by
  have hev : 2 ^ K = 2 * 2 ^ (K - 1) := by rw [← pow_succ']; congr 1; omega
  have hsub : (range (2 ^ K)).filter (fun v => ¬ (1 ≤ v / 2 ∧ v / 2 + R + 1 ≤ 2 ^ (K - 1))) ⊆
      range 2 ∪ Ico (2 ^ K - 2 * R) (2 ^ K) := by
    intro v hv
    simp only [Finset.mem_filter, Finset.mem_range] at hv
    simp only [Finset.mem_union, Finset.mem_range, Finset.mem_Ico]
    omega
  refine (card_le_card hsub).trans ((card_union_le _ _).trans ?_)
  rw [card_range, Nat.card_Ico]; omega

/-- The digit `s` of `T` of record `m`. -/
theorem cdg_t (h : l.OK) (hQC : l.QC = Qc G n) {s : ℕ} (hs : s < n) (m : ℕ) :
    cdg G s (l.cs m).t = m / (l.sT * (2 ^ G) ^ s) % 2 ^ G := by
  simp only [cs, gc, hQC]; rw [cdg_mod hs]; unfold cdg dgt; rw [div_pow_digit]

theorem cdg_u (h : l.OK) (hQC : l.QC = Qc G n) {s : ℕ} (hs : s < n) (m : ℕ) :
    cdg G s (l.cs m).u = m / (l.sU * (2 ^ G) ^ s) % 2 ^ G := by
  simp only [cs, gc, hQC]; rw [cdg_mod hs]; unfold cdg dgt; rw [div_pow_digit]

theorem seg_y (h : l.OK) (hQL : l.QL = 2 ^ L) {s : ℕ} (hs : ρ + (s + 1) * K ≤ L) (m : ℕ) :
    seg K ρ s (l.cs m).y = m / (l.sY * 2 ^ ρ * (2 ^ K) ^ s) % 2 ^ K := by
  simp only [cs, gc, hQL]; rw [seg_mod hs]; unfold seg dgt
  rw [Nat.div_div_eq_div_mul, Nat.div_div_eq_div_mul]; simp only [mul_assoc]

theorem pow_split {W n s : ℕ} (hs : s < n) : W ^ n = W ^ s * (W * W ^ (n - s - 1)) := by
  rw [← pow_succ', ← pow_add]; congr 1; omega

/-- **The moved records are few.** -/
theorem card_moved_C_sol_aux (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K)
    (hG : 1 ≤ G) (hL : ρ + n * K ≤ L) :
    nMv (l.stepP (fun x c => TlS K ρ n x (Psi K ρ G n L x c))) l.M * (2 ^ G * 2 ^ K) ≤
      n * l.M * (2 * 2 ^ K + (2 * 2 ^ G + 2) * 2 ^ G) := by
  obtain ⟨kM, hkM, eM⟩ := h.kMT
  obtain ⟨a, ha, ea⟩ := h.kTU
  obtain ⟨b, hb, eb⟩ := h.kTY
  have hR : 0 < 2 ^ G := by positivity
  have hsub : ((range l.M).filter fun m =>
        l.stepP (fun x c => TlS K ρ n x (Psi K ρ G n L x c)) m ≠ m) ⊆
      (range n).biUnion fun s =>
        ((range l.M).filter fun m => bT l G s m) ∪ ((range l.M).filter fun m => bU l G s m) ∪
        ((range l.M).filter fun m => bY l K ρ G s m) := by
    intro m hm
    obtain ⟨hmM, hκ⟩ := Finset.mem_filter.1 hm
    have hng : ¬ Good K ρ G n (l.cs m) := fun hg => hκ (key_good h hQC hQL hK hG hL hg)
    unfold Good at hng
    push_neg at hng
    obtain ⟨s, hs, hbad⟩ := hng
    refine Finset.mem_biUnion.2 ⟨s, Finset.mem_range.2 hs, ?_⟩
    have hsL : ρ + (s + 1) * K ≤ L := le_trans (by nlinarith) hL
    simp only [Finset.mem_union, Finset.mem_filter]
    by_cases h1 : cdg G s (l.cs m).t + 2 ≤ 2 ^ G
    · by_cases h2 : cdg G s (l.cs m).u + 2 ≤ 2 ^ G
      · right; refine ⟨hmM, ?_⟩
        simp only [bY]; rw [← seg_y h hQL hsL m]
        intro hc; have h3 := hbad h1 h2 hc.1; omega
      · left; right; refine ⟨hmM, ?_⟩
        simp only [bU]; rw [← cdg_u h hQC hs m]; omega
    · left; left; refine ⟨hmM, ?_⟩
      simp only [bT]; rw [← cdg_t h hQC hs m]; omega
  have ct : ∀ s < n, ((range l.M).filter fun m => bT l G s m).card * 2 ^ G = l.M := by
    intro s hs
    have e := count_field (M := l.M) (A := l.sT * (2 ^ G) ^ s) (W := 2 ^ G)
      (C := (2 ^ G) ^ (n - s - 1) * kM)
      (Nat.mul_pos h.pT (by positivity)) hR (by
        rw [eM, hQC]; unfold Qc; rw [pow_split hs]; ring) (fun v => 2 ^ G < v + 2)
    simp only [bT]; rw [e, card_top _ Nat.one_le_two_pow]
    conv_rhs => rw [eM, hQC]
    unfold Qc; rw [pow_split hs]; ring
  have cu : ∀ s < n, ((range l.M).filter fun m => bU l G s m).card * 2 ^ G = l.M := by
    intro s hs
    have e := count_field (M := l.M) (A := l.sU * (2 ^ G) ^ s) (W := 2 ^ G)
      (C := (2 ^ G) ^ (n - s - 1) * (l.QC * a * kM))
      (Nat.mul_pos h.pU (by positivity)) hR (by
        rw [eM, ea, hQC]; unfold Qc; rw [pow_split hs]; ring) (fun v => 2 ^ G < v + 2)
    simp only [bU]; rw [e, card_top _ Nat.one_le_two_pow]
    conv_rhs => rw [eM, ea]
    rw [hQC]; unfold Qc; rw [pow_split hs]; ring
  have cy : ∀ s < n, ((range l.M).filter fun m => bY l K ρ G s m).card * 2 ^ K ≤
      l.M * (2 * 2 ^ G + 2) := by
    intro s hs
    have hsL : ρ + (s + 1) * K ≤ L := le_trans (by nlinarith) hL
    have hLe : 2 ^ L = 2 ^ ρ * (2 ^ K) ^ s * (2 ^ K * 2 ^ (L - ρ - (s + 1) * K)) := by
      rw [← pow_mul, ← pow_add, ← pow_add, ← pow_add]; congr 1
      have : K * s + (K + (L - ρ - (s + 1) * K)) = L - ρ := by
        have : (s + 1) * K = K * s + K := by ring
        omega
      omega
    have hM' : l.M = l.sY * 2 ^ ρ * (2 ^ K) ^ s * (2 ^ K * (2 ^ (L - ρ - (s + 1) * K) *
        (l.QC * b * kM))) := by rw [eM, eb, hQL, hLe]; ring
    have e := count_field (M := l.M) (A := l.sY * 2 ^ ρ * (2 ^ K) ^ s) (W := 2 ^ K)
      (C := 2 ^ (L - ρ - (s + 1) * K) * (l.QC * b * kM))
      (by have := h.pY; positivity) (by positivity) hM'
      (fun v => ¬ (1 ≤ v / 2 ∧ v / 2 + 2 ^ G + 1 ≤ 2 ^ (K - 1)))
    simp only [bY]; rw [e]
    have hc := card_guard K (2 ^ G) hK
    calc l.sY * 2 ^ ρ * (2 ^ K) ^ s *
          ((range (2 ^ K)).filter fun v => ¬ (1 ≤ v / 2 ∧ v / 2 + 2 ^ G + 1 ≤ 2 ^ (K - 1))).card *
          (2 ^ (L - ρ - (s + 1) * K) * (l.QC * b * kM)) * 2 ^ K
        = ((range (2 ^ K)).filter fun v => ¬ (1 ≤ v / 2 ∧ v / 2 + 2 ^ G + 1 ≤ 2 ^ (K - 1))).card *
          (l.sY * 2 ^ ρ * (2 ^ K) ^ s * (2 ^ K * (2 ^ (L - ρ - (s + 1) * K) *
            (l.QC * b * kM)))) := by ring
      _ ≤ (2 * 2 ^ G + 2) * (l.sY * 2 ^ ρ * (2 ^ K) ^ s * (2 ^ K * (2 ^ (L - ρ - (s + 1) * K) *
            (l.QC * b * kM)))) := Nat.mul_le_mul_right _ hc
      _ = l.M * (2 * 2 ^ G + 2) := by rw [← hM']; ring
  rw [nMv_card]
  calc ((range l.M).filter fun m =>
          l.stepP (fun x c => TlS K ρ n x (Psi K ρ G n L x c)) m ≠ m).card * (2 ^ G * 2 ^ K)
      ≤ (∑ s ∈ range n, (((range l.M).filter fun m => bT l G s m).card +
          ((range l.M).filter fun m => bU l G s m).card +
          ((range l.M).filter fun m => bY l K ρ G s m).card)) * (2 ^ G * 2 ^ K) := by
        apply Nat.mul_le_mul_right
        refine (card_le_card hsub).trans (card_biUnion_le.trans ?_)
        exact Finset.sum_le_sum fun s _ =>
          (card_union_le _ _).trans (Nat.add_le_add_right (card_union_le _ _) _)
    _ ≤ ∑ s ∈ range n, l.M * (2 * 2 ^ K + (2 * 2 ^ G + 2) * 2 ^ G) := by
        rw [Finset.sum_mul]
        refine Finset.sum_le_sum fun s hs => ?_
        have hs' := Finset.mem_range.1 hs
        have e1 := ct s hs'
        have e2 := cu s hs'
        have e3 := cy s hs'
        generalize ((range l.M).filter fun m => bT l G s m).card = c1 at e1 ⊢
        generalize ((range l.M).filter fun m => bU l G s m).card = c2 at e2 ⊢
        generalize ((range l.M).filter fun m => bY l K ρ G s m).card = c3 at e3 ⊢
        generalize l.M = M at e1 e2 e3 ⊢
        generalize 2 ^ G = R at e1 e2 e3 hR ⊢
        generalize 2 ^ K = Q at e3 ⊢
        subst e1
        have q2 : c2 = c1 := Nat.eq_of_mul_eq_mul_right hR e2
        subst q2
        nlinarith [Nat.mul_le_mul_right R e3]
    _ = n * l.M * (2 * 2 ^ K + (2 * 2 ^ G + 2) * 2 ^ G) := by
        rw [Finset.sum_const, card_range, smul_eq_mul]; ring

end Lay

end IntMul.Kappa.R6.IL2C

end

theorem solution : type_of% @IntMul.Kappa.R6.IL2C.Lay.card_moved_C_sol_aux := @IntMul.Kappa.R6.IL2C.Lay.card_moved_C_sol_aux
