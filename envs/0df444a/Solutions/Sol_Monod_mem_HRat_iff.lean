theorem solution (f : OnePoint ℝ ≃ₜ OnePoint ℝ) :
    f ∈ HRat ↔ (f ∈ Gpp ∧ IsPiecewiseProjOn ⊥ ratPoints f) ∧ f ∈ fixInf := by
  apply Monod.mem_HRat_iff <;> assumption

