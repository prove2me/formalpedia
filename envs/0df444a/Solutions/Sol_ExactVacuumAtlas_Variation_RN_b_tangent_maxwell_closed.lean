open Real
open scoped ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.RN
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
open ExactVacuumAtlas.Variation.RN
theorem solution (M Q : ℝ) {x : Pt 4} (hx : x ∈ domRN) :
    (∀ b, linMaxwell (gRN M (Q ^ 2)) (giRN M (Q ^ 2)) (faradayRN Q) tanB 0 b x = 0) ∧
    (∀ a b c, linFaraday (0 : TwoForm 4) a b c x = 0) := by
  refine ⟨fun b => ?_, fun a b c => ?_⟩
  · have := linMaxwell_eq_zero_of_onShell (familyData_b M Q) (isTangent_b M Q)
      (fun p hp j => EF.maxwell M (Q ^ 2 + p.1) Q hp j) (mem_domJ hx 0) b
    simpa only [add_zero] using this
  · exact linFaraday_eq_zero_of_onShell (familyData_b M Q) (isTangent_b M Q)
      (fun p hp i j k => EF.closed Q hp i j k) (mem_domJ hx 0) a b c
