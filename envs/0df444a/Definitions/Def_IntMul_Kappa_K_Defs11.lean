-- Source module: Solutions.KIL2Div
/-!
# KIL2: multiplying the target field by `c⁻¹` (Lemma 4, the inverse direction)

The mirror of `KIL2Mul`: the records `y = 0, …, Q − 1` of a block are distributed by residue,
record `y` going to stream `σ(y mod c)` (a residue counter on stack `13` and a `c`-way branch),
and the streams `0, …, c − 1` are then concatenated.  Stream `j` holds the records
`y = c·z − j·Q` for `z ∈ [lo j, lo (j+1))` in increasing order (`filt_eq`), so the output position
`z` receives record `(c·z) mod Q`: the permutation is `y ↦ c⁻¹·y`.

* `filt_eq`, `outD_eq`: the combinatorial identity.
* `divPc_sp`, `divPc_spec`: the program, stack form, linear cost (factor `c ≤ 20`).
* `shiftArr_div_eq`, `shiftArr_negdiv_eq`; `shiftArrDiv_il_spec`, `shiftArrNegDiv_il_spec`:
  `u = k⁻¹` and `u = -k⁻¹`.
* `SmallUnit2`, `scodeU2`, `runCodeU2_spec`: the step runner with coefficients
  `±1, ±k, ±k⁻¹` (`2 ≤ k ≤ 20`, `k` prime to `Q`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

/-! ## The residue classes are the pieces -/

section Arith

variable {Q c : ℕ}

/-- Records of stream `j`, in order. -/
def flatD (rp : ℕ → List ℤ) (Q c j : ℕ) : List ℤ :=
  ((List.range Q).filter (fun y => sig Q c (y % c) = j)).flatMap rp

end Arith

/-! ## Distribution by residue -/

section DistD

variable (rp : ℕ → List ℤ) (Q c B : ℕ)

/-- Stream `j` at time `y`: the records `y' < y` of class `j`, reversed. -/
def accD (y j : ℕ) : List ℤ :=
  (((List.range y).filter (fun y' => sig Q c (y' % c) = j)).flatMap rp).reverse

/-- Branch `v`: move record `y` (residue `v`) from stack `0` to stream `σ(v)`. -/
def brD (v : ℕ) : RS := NLogN.mvK 0 (NLogN.KIL.sI (sig Q c v)) 33 (.lit B)

def bodyD : RS := .seq (NLogN.KIL.sel 13 (brD Q c B) 0 c) (.asg 13 (mAdd c (.reg 13) (.lit 1)))

def distD : RS := .rep 31 (.lit Q) (bodyD Q c B)

/-- State at time `y`. -/
def stD (K : NLogN.KIL.KS) (rest : List ℤ) (y : ℕ) (kk : List ℤ) : Fin HS → List ℤ :=
  strF c (toF {K with x := (List.range' y (Q - y)).flatMap rp ++ rest, qMB := [((y % c : ℕ) : ℤ)], k1 := kk})
    (accD rp Q c y)

variable {rp Q c B}

def cDist (Q c B Bb : ℕ) : ℕ :=
  (1 + 1) * 2000 * (Bb + 2) + Q * (cBodyM c B Bb + 8000 * (Bb + 2) + 30) + 32

end DistD

/-! ## Concatenation of the streams -/

section Cat

variable {rp : ℕ → List ℤ} {Q c B : ℕ}

/-- Number of records of class `j`. -/
def lenD (Q c j : ℕ) : ℕ := ((List.range Q).filter (fun y => sig Q c (y % c) = j)).length

/-- Move streams `k − 1, …, 0` (whole) onto stack `10`. -/
def catD (Q c B : ℕ) : ℕ → RS
  | 0 => .skip
  | k + 1 => .seq (NLogN.mvK (NLogN.KIL.sI k) 10 33 (.lit ((lenD Q c k * B : ℕ) : ℤ))) (catD Q c B k)

end Cat

/-! ## One block and the whole program (multiplication by `c⁻¹`) -/

/-- The output block: position `z` receives record `c·z mod Q`. -/
def outDB (rp : ℕ → List ℤ) (Q c : ℕ) : List ℤ := (List.range Q).flatMap fun z => rp (c * z % Q)

section BlockD

variable (r : ℕ → ℕ → List ℤ) (P Q c B : ℕ)

def blkD : RS :=
  .seq (.push 13 (.lit 0)) (.seq (distD Q c B) (.seq (.pop 13) (.seq (catD Q c B c)
    (NLogN.mvK 10 12 33 (.lit ((Q * B : ℕ) : ℤ))))))

def divPc : RS :=
  .seq (.rep 30 (.lit (P : ℤ)) (blkD Q c B)) (NLogN.mvK 12 0 33 (.lit ((P * (Q * B) : ℕ) : ℤ)))

/-- All output blocks. -/
def outDiv : List ℤ := (List.range P).flatMap fun p => outDB (r p) Q c

/-- State at the start of block `p`. -/
def dSt (p : ℕ) (kk : List ℤ) : KS :=
  { x := (List.range' p (P - p)).flatMap (blk3 r Q),
    o := ((List.range p).flatMap fun p => outDB (r p) Q c).reverse, k0 := kk }

def cBlkD (Q c B Bb : ℕ) : ℕ :=
  (1 + 1) * 2000 * (Bb + 2) + cDist Q c B Bb + (2 * Bb + 2) +
    (c * ((1 + 1) * 2000 * (Bb + 2) + 32) + 1 + c * (Q * B) * (14000 * (Bb + 2))) +
    ((1 + 1) * 2000 * (Bb + 2) + Q * B * (14000 * (Bb + 2)) + 32)

variable {r P Q c B}

def cDivPc (P Q c B Bb : ℕ) : ℕ :=
  (1 + 1) * 2000 * (Bb + 2) + P * (cBlkD Q c B Bb + 8000 * (Bb + 2) + 30) + 32 +
    ((1 + 1) * 2000 * (Bb + 2) + P * (Q * B) * (14000 * (Bb + 2)) + 32)

end BlockD

/-- Output address `(p, z, b)` ↦ input address `(p, c·z mod Q, b)`. -/
def divAddr (Q c : ℕ) (a : List ℕ) : List ℕ := [a.getD 0 0, c * a.getD 1 0 % Q, a.getD 2 0]

/-! ## The shifts with coefficient `±k⁻¹` -/

section ShiftDiv

open AModelL12

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

/-- `u = k⁻¹`: inverse multiplicative permutation, then the self-contained rotation. -/
def shDiv (Q k P B : ℕ) (ac : List (ℕ × ℕ)) : RS := .seq (divPc P Q k B) (shP Q P B ac)

/-- `u = -k⁻¹`: inverse multiplicative permutation, then the self-contained reflection. -/
def shNDiv (Q k P B : ℕ) (ac : List (ℕ × ℕ)) : RS := .seq (divPc P Q k B) (shN Q P B ac)

end ShiftDiv

/-! ## Step runner with coefficients `±1, ±k, ±k⁻¹` -/

section RunU2

open AModelL12

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}

/-- The coefficients handled: `±1`, `±k` and `±k⁻¹` with `2 ≤ k ≤ 20`, `k` prime to `Q`. -/
def SmallUnit2 (Q : ℕ) (u : ZMod Q) : Prop :=
  SmallUnit Q u ∨
    (2 ≤ (u⁻¹).val ∧ (u⁻¹).val ≤ 20 ∧ Nat.Coprime Q (u⁻¹).val ∧ u * u⁻¹ = 1) ∨
    (2 ≤ ((-u)⁻¹).val ∧ ((-u)⁻¹).val ≤ 20 ∧ Nat.Coprime Q ((-u)⁻¹).val ∧ -u * (-u)⁻¹ = 1)

/-- Shift code for coefficients `±1, ±k, ±k⁻¹`. -/
def scodeU2 : Step n Q → IStmt HS Pp
  | .shift i u c =>
    if u = 1 ∨ u = -1 ∨ (2 ≤ u.val ∧ u.val ≤ 20 ∧ Nat.Coprime Q u.val) ∨
        (2 ≤ (-u).val ∧ (-u).val ≤ 20 ∧ Nat.Coprime Q (-u).val) then scodeU Λ (.shift i u c)
    else if 2 ≤ (u⁻¹).val ∧ (u⁻¹).val ≤ 20 ∧ Nat.Coprime Q (u⁻¹).val ∧ u * u⁻¹ = 1 then
      (shDiv Q (u⁻¹).val (AModel.vol (sh.take (Λ.pos i))) (AModel.vol (sh.drop (Λ.pos i + 1)))
        ((sh.take (Λ.pos i)).zip (csOf Λ c (sh.take (Λ.pos i))))).code
    else (shNDiv Q ((-u)⁻¹).val (AModel.vol (sh.take (Λ.pos i))) (AModel.vol (sh.drop (Λ.pos i + 1)))
        ((sh.take (Λ.pos i)).zip (csOf Λ c (sh.take (Λ.pos i))))).code
  | .swap _ _ => .skip

end RunU2

end NLogN.KIL

end

