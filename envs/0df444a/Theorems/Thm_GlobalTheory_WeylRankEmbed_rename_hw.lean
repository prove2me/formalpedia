variable (R : Type) [CommRing R] {a b : ℕ} (hab : a ≤ b)

theorem GlobalTheory.WeylRankEmbed.rename_hw (ν : Fin a → ℕ) (ν' : Fin b → ℕ)
    (h : ∀ j : Fin b, ν' j = if h : (j : ℕ) < a then ν ⟨j, h⟩ else 0) :
    rename (corner hab) (hw R le_rfl ν) = hw R le_rfl ν' := by sorry
