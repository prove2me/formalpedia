theorem NLogN.KFG.swaps_fsp {W L : ℕ} (s : IState HS) (l0 : List ℤ) (w Z : ℕ)
    (hZ : zsz ((2 * (W * L) : ℕ) : ℤ) ≤ Z) :
    ∀ (l : List (ℕ × ℕ)), (∀ p ∈ l, p.1 < p.2 ∧ p.2 < W) →
    ∀ (e : ℕ → ℕ) (f : Fin HS → List ℤ) (zs : List GI) (y : ℕ → ℕ → ℂ),
      Enc W L e zs y → f 0 = gflat zs ++ l0 → ClP f → NLogN.KFB.GB w zs →
      Enc W L (e ∘ NLogN.KFG.swapsF l) (swapsL L l zs) (fun v => y (NLogN.KFG.swapsF l v)) ∧ NLogN.KFB.GB w (swapsL L l zs) ∧
      FSp (swapsP L l) (encK s f) (encK s (Function.update f 0 (gflat (swapsL L l zs) ++ l0)))
        (l.length * cAtom w 0 L W Z + 1) := by sorry
