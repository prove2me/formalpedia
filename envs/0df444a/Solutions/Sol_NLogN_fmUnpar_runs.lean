  simp +decide [NLogN.fmUnpar, NLogN.IStmt.run, NLogN.IOp.run, hN, hF, hP, h2, hH, hE, hRQ, NLogN.zsz_two_pow]
  have := NLogN.zsz_add_le ((2 : ℤ) ^ n) 1; rw [NLogN.zsz_one, NLogN.zsz_two_pow] at this
