/-!
# Chaînes linéaires : cône, subdivision et homotopie (A1, étape 2)

Pour un type `P` (les « points »), les suites `Fin (m+1) → P` forment un ensemble simplicial
`tupleSSet P`, dont les faces sont `v ↦ v ∘ succAbove i`. Son complexe de faces alternées à
coefficients dans `R` est `TChains R P`, avec `(Fin (m+1) → P) →₀ R` en degré `m`.

Pour une fonction « point de cône » `b : ∀ m, (Fin (m+1) → P) → P` quelconque, on définit par
récurrence sur le degré, comme chez Hatcher (§2.1, preuve de 2.21) :
* la subdivision `subd b m`, avec `S v = b(v) · S(∂v)` et `S = id` en degré 0 ;
* l'homotopie `homot b m`, avec `T v = b(v) · (v − T(∂v))` et `T = 0` en degré 0.

Ici `p · c` est le cône `cone p`, qui envoie `v` sur `Fin.cons p v`. Les identités
`∂S = S∂` et `∂T + T∂ = 1 − S` sont purement algébriques : elles ne dépendent pas du choix de `b`.
Elles sont naturelles par rapport aux applications `φ : P → Q` compatibles aux points de cône.
-/

open CategoryTheory Opposite AlgebraicTopology

namespace Hatcher.Singular

/-- L'ensemble simplicial des suites : `m`-simplexes `Fin (m+1) → P`, faces et dégénérescences
par précomposition. -/
def tupleSSet (P : Type) : SSet.{0} where
  obj n := Fin (n.unop.len + 1) → P
  map f := ↾(fun v ↦ v ∘ f.unop.toOrderHom)
  map_id _ := rfl
  map_comp _ _ := rfl

theorem tupleSSet_δ (P : Type) {m : ℕ} (i : Fin (m + 2)) (v : Fin (m + 2) → P) :
    (tupleSSet P).δ i v = v ∘ i.succAbove := rfl

variable (R : Type) [Ring R]

/-- Le complexe des chaînes de suites `C_•(P)` à coefficients dans `R`. -/
noncomputable abbrev TChains (P : Type) : ChainComplex (ModuleCat.{0} R) ℕ :=
  (alternatingFaceMapComplex (ModuleCat.{0} R)).obj (tupleSSet P ⋙ ModuleCat.free R)

namespace Linear

variable {R} {P : Type}

/-- Les `m`-chaînes de suites. -/
abbrev LC (R P : Type) [Ring R] (m : ℕ) : Type := (Fin (m + 1) → P) →₀ R

/-- Le bord `∂ : LC (m+1) → LC m`. -/
noncomputable abbrev bd (m : ℕ) : LC R P (m + 1) →ₗ[R] LC R P m :=
  ((TChains R P).d (m + 1) m).hom

theorem bd_eq (m : ℕ) : bd (R := R) (P := P) m =
    ∑ i : Fin (m + 2), ((-1 : ℤ) ^ (i : ℕ)) •
      Finsupp.lmapDomain R R (fun v : Fin (m + 2) → P ↦ v ∘ i.succAbove) := by
  rw [bd, show (TChains R P).d (m + 1) m = _ from AlternatingFaceMapComplex.obj_d_eq _ m]
  simp only [ModuleCat.hom_sum, ModuleCat.hom_zsmul]
  rfl

theorem bd_single (m : ℕ) (v : Fin (m + 2) → P) (r : R) :
    bd m (Finsupp.single v r) =
      ∑ i : Fin (m + 2), ((-1 : ℤ) ^ (i : ℕ)) • Finsupp.single (v ∘ i.succAbove) r := by
  rw [bd_eq, LinearMap.sum_apply]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [LinearMap.smul_apply, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]

theorem bd_bd (m : ℕ) (c : LC R P (m + 2)) : bd m (bd (m + 1) c) = 0 := by
  have h := (TChains R P).d_comp_d (m + 2) (m + 1) m
  exact congrArg (fun f ↦ f.hom c) h

/-- Le cône de sommet `p` : `v ↦ (p, v)`. -/
noncomputable abbrev cone (p : P) (m : ℕ) : LC R P m →ₗ[R] LC R P (m + 1) :=
  Finsupp.lmapDomain R R (fun v : Fin (m + 1) → P ↦ (Fin.cons p v : Fin (m + 2) → P))

/-- L'augmentation `ε : LC 0 → R`, somme des coefficients. -/
noncomputable abbrev aug : LC R P 0 →ₗ[R] R :=
  Finsupp.linearCombination R (fun _ ↦ (1 : R))

theorem cons_comp_succAbove_zero {m : ℕ} (p : P) (v : Fin (m + 1) → P) :
    (Fin.cons p v : Fin (m + 2) → P) ∘ (0 : Fin (m + 2)).succAbove = v := by
  funext k
  simp

theorem cons_comp_succAbove_succ {m : ℕ} (p : P) (v : Fin (m + 2) → P) (j : Fin (m + 2)) :
    (Fin.cons p v : Fin (m + 3) → P) ∘ j.succ.succAbove = Fin.cons p (v ∘ j.succAbove) := by
  funext k
  refine Fin.cases ?_ (fun k ↦ ?_) k
  · simp
  · simp [Fin.succ_succAbove_succ]

/-- **Bord d'un cône** en degré `≥ 1` : `∂(p·c) = c − p·∂c`. -/
theorem bd_cone (p : P) (m : ℕ) (c : LC R P (m + 1)) :
    bd (m + 1) (cone p (m + 1) c) = c - cone p m (bd m c) := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c d hc hd =>
    rw [map_add, map_add, hc, hd, map_add, map_add]
    abel
  | single v r =>
    rw [cone, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single, bd_single, Fin.sum_univ_succ,
      Fin.val_zero, pow_zero, one_smul, cons_comp_succAbove_zero, bd_single, map_sum,
      sub_eq_add_neg, ← Finset.sum_neg_distrib]
    congr 1
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [cons_comp_succAbove_succ, map_zsmul, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single,
      Fin.val_succ, pow_succ, mul_neg_one, neg_smul]

/-- **Bord d'un cône** en degré 0 : `∂(p·c) = c − ε(c)·p`. -/
theorem bd_cone_zero (p : P) (c : LC R P 0) :
    bd 0 (cone p 0 c) = c - aug c • Finsupp.single (fun _ ↦ p) 1 := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c d hc hd =>
    rw [map_add, map_add, hc, hd, map_add, add_smul]
    abel
  | single v r =>
    rw [cone, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single, bd_single, Fin.sum_univ_two,
      Fin.val_zero, pow_zero, one_smul, cons_comp_succAbove_zero, Fin.val_one, pow_one,
      neg_one_smul, ← sub_eq_add_neg, aug, Finsupp.linearCombination_single, smul_eq_mul,
      mul_one, Finsupp.smul_single, smul_eq_mul, mul_one]
    congr 2
    funext k
    fin_cases k
    rfl

theorem aug_bd (c : LC R P 1) : aug (bd 0 c) = 0 := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c d hc hd => rw [map_add, map_add, hc, hd, add_zero]
  | single v r =>
    rw [bd_single, Fin.sum_univ_two, map_add, map_zsmul, map_zsmul]
    simp

/-! ### Subdivision et homotopie -/

/-- Les points de cône : une fonction `b m : (Fin (m+1) → P) → P` par degré. -/
abbrev ConePoints (P : Type) : Type := ∀ m : ℕ, (Fin (m + 1) → P) → P

variable (b : ConePoints P)

/-- La subdivision `S` : `S = id` en degré 0, et `S v = b(v) · S(∂v)` en degré `m + 1`. -/
noncomputable def subd : (m : ℕ) → (LC R P m →ₗ[R] LC R P m)
  | 0 => LinearMap.id
  | m + 1 => Finsupp.linearCombination R
      (fun v ↦ cone (b (m + 1) v) m (subd m (bd m (Finsupp.single v 1))))

/-- L'homotopie `T` : `T = 0` en degré 0, et `T v = b(v) · (v − T(∂v))` en degré `m + 1`. -/
noncomputable def homot : (m : ℕ) → (LC R P m →ₗ[R] LC R P (m + 1))
  | 0 => 0
  | m + 1 => Finsupp.linearCombination R
      (fun v ↦ cone (b (m + 1) v) (m + 1)
        (Finsupp.single v 1 - homot m (bd m (Finsupp.single v 1))))

theorem subd_zero (c : LC R P 0) : subd b 0 c = c := rfl

theorem homot_zero (c : LC R P 0) : homot b 0 c = 0 := rfl

theorem subd_succ_single (m : ℕ) (v : Fin (m + 2) → P) (r : R) :
    subd b (m + 1) (Finsupp.single v r) =
      r • cone (b (m + 1) v) m (subd b m (bd m (Finsupp.single v 1))) := by
  rw [subd, Finsupp.linearCombination_single]

theorem homot_succ_single (m : ℕ) (v : Fin (m + 2) → P) (r : R) :
    homot b (m + 1) (Finsupp.single v r) =
      r • cone (b (m + 1) v) (m + 1)
        (Finsupp.single v 1 - homot b m (bd m (Finsupp.single v 1))) := by
  rw [homot, Finsupp.linearCombination_single]

theorem single_eq_smul (m : ℕ) (v : Fin (m + 1) → P) (r : R) :
    (Finsupp.single v r : LC R P m) = r • Finsupp.single v 1 := by
  rw [Finsupp.smul_single, smul_eq_mul, mul_one]

theorem subd_succ_single_one (m : ℕ) (v : Fin (m + 2) → P) :
    subd b (m + 1) (Finsupp.single v (1 : R)) =
      cone (b (m + 1) v) m (subd b m (bd m (Finsupp.single v 1))) := by
  rw [subd_succ_single, one_smul]

theorem homot_succ_single_one (m : ℕ) (v : Fin (m + 2) → P) :
    homot b (m + 1) (Finsupp.single v (1 : R)) =
      cone (b (m + 1) v) (m + 1)
        (Finsupp.single v 1 - homot b m (bd m (Finsupp.single v 1))) := by
  rw [homot_succ_single, one_smul]

/-- **`S` est un morphisme de complexes** : `∂S = S∂`. -/
theorem bd_subd (m : ℕ) (c : LC R P (m + 1)) : bd m (subd b (m + 1) c) = subd b m (bd m c) := by
  induction m with
  | zero =>
    induction c using Finsupp.induction_linear with
    | zero => simp
    | add c d hc hd => simp only [map_add, hc, hd]
    | single v r =>
      rw [single_eq_smul 1 v r, map_smul, map_smul, map_smul, subd_succ_single_one, subd_zero,
        bd_cone_zero, aug_bd, zero_smul, sub_zero, subd_zero]
  | succ k ih =>
    induction c using Finsupp.induction_linear with
    | zero => simp
    | add c d hc hd => simp only [map_add, hc, hd]
    | single v r =>
      rw [single_eq_smul (k + 2) v r, map_smul, map_smul, map_smul, subd_succ_single_one,
        bd_cone, ih, bd_bd, map_zero, map_zero, sub_zero, map_smul]

/-- **`T` est une homotopie de `1` à `S`** : `∂T + T∂ = 1 − S`. -/
theorem bd_homot (m : ℕ) (c : LC R P (m + 1)) :
    bd (m + 1) (homot b (m + 1) c) + homot b m (bd m c) = c - subd b (m + 1) c := by
  induction m with
  | zero =>
    induction c using Finsupp.induction_linear with
    | zero => simp
    | add c d hc hd =>
      calc _ = (bd 1 (homot b 1 c) + homot b 0 (bd 0 c)) +
            (bd 1 (homot b 1 d) + homot b 0 (bd 0 d)) := by simp only [map_add]; abel
        _ = (c - subd b 1 c) + (d - subd b 1 d) := by rw [hc, hd]
        _ = _ := by simp only [map_add]; abel
    | single v r =>
      rw [single_eq_smul 1 v r]
      simp only [map_smul]
      rw [← smul_add, ← smul_sub]
      congr 1
      rw [homot_succ_single_one]
      simp only [homot_zero, sub_zero, add_zero]
      rw [bd_cone, subd_succ_single_one, subd_zero]
  | succ k ih =>
    induction c using Finsupp.induction_linear with
    | zero => simp
    | add c d hc hd =>
      calc _ = (bd (k + 2) (homot b (k + 2) c) + homot b (k + 1) (bd (k + 1) c)) +
            (bd (k + 2) (homot b (k + 2) d) + homot b (k + 1) (bd (k + 1) d)) := by
              simp only [map_add]; abel
        _ = (c - subd b (k + 2) c) + (d - subd b (k + 2) d) := by rw [hc, hd]
        _ = _ := by simp only [map_add]; abel
    | single v r =>
      set e : LC R P (k + 2) := Finsupp.single v 1 with he
      have key : bd (k + 1) (homot b (k + 1) (bd (k + 1) e)) =
          bd (k + 1) e - subd b (k + 1) (bd (k + 1) e) := by
        have := ih (bd (k + 1) e)
        rwa [bd_bd, map_zero, add_zero] at this
      rw [single_eq_smul (k + 2) v r, ← he]
      simp only [map_smul]
      rw [← smul_add, ← smul_sub]
      congr 1
      rw [he, homot_succ_single_one, ← he, bd_cone, map_sub, key, sub_sub_cancel, he,
        subd_succ_single_one, ← he]
      abel

/-! ### Naturalité -/

variable {Q : Type} (φ : P → Q)

/-- L'application `φ_* : LC_P → LC_Q` induite par `φ : P → Q`. -/
noncomputable abbrev tmap (m : ℕ) : LC R P m →ₗ[R] LC R Q m :=
  Finsupp.lmapDomain R R (fun v : Fin (m + 1) → P ↦ φ ∘ v)

theorem tmap_single (m : ℕ) (v : Fin (m + 1) → P) (r : R) :
    tmap φ m (Finsupp.single v r) = Finsupp.single (φ ∘ v) r := by
  rw [tmap, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]

theorem tmap_bd (m : ℕ) (c : LC R P (m + 1)) : tmap φ m (bd m c) = bd m (tmap φ (m + 1) c) := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c d hc hd => simp only [map_add, hc, hd]
  | single v r =>
    rw [bd_single, tmap_single, bd_single, map_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [map_zsmul, tmap_single]
    rfl

theorem tmap_cone (p : P) (m : ℕ) (c : LC R P m) :
    tmap φ (m + 1) (cone p m c) = cone (φ p) m (tmap φ m c) := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c d hc hd => simp only [map_add, hc, hd]
  | single v r =>
    simp only [cone, tmap, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
    congr 1
    funext k
    refine Fin.cases ?_ (fun k ↦ ?_) k <;> simp

variable (b' : ConePoints Q)

/-- `φ` est compatible aux points de cône. -/
def ConeCompat : Prop := ∀ (m : ℕ) (v : Fin (m + 1) → P), φ (b m v) = b' m (φ ∘ v)

variable {φ b b'}

theorem tmap_subd (h : ConeCompat b φ b') (m : ℕ) (c : LC R P m) :
    tmap φ m (subd b m c) = subd b' m (tmap φ m c) := by
  induction m with
  | zero => rfl
  | succ k ih =>
    induction c using Finsupp.induction_linear with
    | zero => simp
    | add c d hc hd => simp only [map_add, hc, hd]
    | single v r =>
      rw [subd_succ_single, map_smul, tmap_cone, ih, tmap_bd, tmap_single, tmap_single,
        subd_succ_single, h]

theorem tmap_homot (h : ConeCompat b φ b') (m : ℕ) (c : LC R P m) :
    tmap φ (m + 1) (homot b m c) = homot b' m (tmap φ m c) := by
  induction m with
  | zero => simp [homot_zero]
  | succ k ih =>
    induction c using Finsupp.induction_linear with
    | zero => simp
    | add c d hc hd => simp only [map_add, hc, hd]
    | single v r =>
      rw [homot_succ_single, map_smul, tmap_cone, map_sub, ih, tmap_bd, tmap_single, tmap_single,
        homot_succ_single, h]

end Linear

end Hatcher.Singular

end

/-! ## Recopié de `Bridge/Singular/Affine.lean` -/

section

/-!
# Simplexes affines (A1, étape 3)

* `Smp n` est le simplexe topologique standard `Δⁿ ⊆ ℝ^{n+1}` (`stdSimplex ℝ (Fin (n+1))`).
* `faceMap g : C(Δᵏ, Δˡ)` est l'application affine induite par `g : Fin (k+1) → Fin (l+1)`
  (`stdSimplex.map`).
* `singSSet X` est l'ensemble simplicial singulier dont les `k`-simplexes sont *littéralement* les
  `C(Δᵏ, X)`. Il est isomorphe à `TopCat.toSSet X` (`singIso`), et sa naturalité vaut par `rfl`.
* `aff v : C(Δᵏ, Δⁿ)` est le simplexe affine de sommets `v : Fin (k+1) → Δⁿ`, `x ↦ ∑ x_j v_j`.
  Il définit un morphisme d'ensembles simpliciaux `realize n : tupleSSet (Δⁿ) ⟶ singSSet (Δⁿ)`.
* `IsAff φ` : `φ` commute aux combinaisons convexes. C'est le cas des `faceMap g` et des
  `aff w`. Les applications affines préservent les barycentres (`ConeCompat`).
-/

open CategoryTheory Opposite AlgebraicTopology

namespace Hatcher.Singular

/-- Le simplexe topologique standard `Δⁿ`. -/
abbrev Smp (n : ℕ) : Type := ↥(stdSimplex ℝ (Fin (n + 1)))

/-- L'application affine `Δᵏ → Δˡ` induite par `g : Fin (k+1) → Fin (l+1)`. -/
noncomputable def faceMap {k l : ℕ} (g : Fin (k + 1) → Fin (l + 1)) : C(Smp k, Smp l) :=
  ⟨stdSimplex.map g, stdSimplex.continuous_map g⟩

theorem faceMap_apply {k l : ℕ} (g : Fin (k + 1) → Fin (l + 1)) (x : Smp k) :
    faceMap g x = stdSimplex.map g x := rfl

theorem faceMap_id (k : ℕ) : faceMap (id : Fin (k + 1) → Fin (k + 1)) = ContinuousMap.id _ := by
  ext x : 1
  exact stdSimplex.map_id_apply x

theorem faceMap_comp {k l m : ℕ} (g : Fin (k + 1) → Fin (l + 1)) (h : Fin (l + 1) → Fin (m + 1)) :
    (faceMap h).comp (faceMap g) = faceMap (h ∘ g) := by
  ext x : 1
  exact stdSimplex.map_comp_apply g h x

/-! ### L'ensemble simplicial singulier concret -/

/-- L'ensemble simplicial singulier : `k`-simplexes `C(Δᵏ, X)`, opérateurs par précomposition. -/
noncomputable def singSSet (X : Type) [TopologicalSpace X] : SSet.{0} where
  obj k := C(Smp k.unop.len, X)
  map f := ↾(fun σ ↦ σ.comp (faceMap f.unop.toOrderHom))
  map_id k := by
    refine ConcreteCategory.hom_ext _ _ fun σ ↦ ?_
    change σ.comp (faceMap id) = σ
    rw [faceMap_id]
    rfl
  map_comp f g := by
    refine ConcreteCategory.hom_ext _ _ fun σ ↦ ?_
    change σ.comp (faceMap (g.unop ≫ f.unop).toOrderHom) =
      (σ.comp (faceMap f.unop.toOrderHom)).comp (faceMap g.unop.toOrderHom)
    rw [ContinuousMap.comp_assoc, faceMap_comp]
    rfl

theorem singSSet_δ (X : Type) [TopologicalSpace X] {m : ℕ} (i : Fin (m + 2))
    (σ : C(Smp (m + 1), X)) :
    (singSSet X).δ i σ = σ.comp (faceMap i.succAbove) := rfl

/-- `TopCat.toSSet X ≅ singSSet X`. -/
noncomputable def singIso (X : Type) [TopologicalSpace X] :
    TopCat.toSSet.obj (TopCat.of X) ≅ singSSet X :=
  NatIso.ofComponents (fun k ↦ Equiv.toIso ((TopCat.of X).toSSetObjEquiv k)) (fun _ ↦ rfl)

/-- `f_* : singSSet X ⟶ singSSet Y`. -/
noncomputable def singMap {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y] (f : C(X, Y)) :
    singSSet X ⟶ singSSet Y where
  app _ := ↾(fun σ ↦ f.comp σ)
  naturality _ _ _ := rfl

theorem singIso_naturality {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y] (f : C(X, Y)) :
    TopCat.toSSet.map (TopCat.ofHom f) ≫ (singIso Y).hom = (singIso X).hom ≫ singMap f := rfl

/-! ### Simplexes affines -/

variable {m n : ℕ}

/-- Valeur du simplexe affine de sommets `v` au point `x` : `∑ x_j v_j`. -/
noncomputable def affVal (v : Fin (m + 1) → Smp n) (x : Smp m) : Fin (n + 1) → ℝ :=
  ∑ j, x j • ((v j : Smp n) : Fin (n + 1) → ℝ)

theorem affVal_apply (v : Fin (m + 1) → Smp n) (x : Smp m) (i : Fin (n + 1)) :
    affVal v x i = ∑ j, x j * (v j) i := by
  simp [affVal, Finset.sum_apply]

theorem affVal_mem (v : Fin (m + 1) → Smp n) (x : Smp m) :
    affVal v x ∈ stdSimplex ℝ (Fin (n + 1)) := by
  refine ⟨fun i ↦ ?_, ?_⟩
  · rw [affVal_apply]
    exact Finset.sum_nonneg fun j _ ↦ mul_nonneg (stdSimplex.zero_le x j) (stdSimplex.zero_le _ i)
  · simp_rw [affVal_apply]
    rw [Finset.sum_comm]
    simp_rw [← Finset.mul_sum, stdSimplex.sum_eq_one, mul_one]
    exact stdSimplex.sum_eq_one x

/-- Le simplexe affine `Δᵐ → Δⁿ` de sommets `v`. -/
noncomputable def aff (v : Fin (m + 1) → Smp n) : C(Smp m, Smp n) where
  toFun x := ⟨affVal v x, affVal_mem v x⟩
  continuous_toFun := by
    refine Continuous.subtype_mk ?_ _
    refine continuous_finsetSum _ fun j _ ↦ ?_
    exact Continuous.smul (show Continuous fun a : Smp m ↦ a j from
      (continuous_apply j).comp continuous_subtype_val) continuous_const

theorem aff_apply_coe (v : Fin (m + 1) → Smp n) (x : Smp m) (i : Fin (n + 1)) :
    (aff v x) i = ∑ j, x j * (v j) i :=
  affVal_apply v x i

theorem smp_ext {k : ℕ} {x y : Smp k} (h : ∀ i, x i = y i) : x = y :=
  stdSimplex.ext (funext h)

/-- Le simplexe affine sur les sommets d'un simplexe est l'application affine `stdSimplex.map`. -/
theorem aff_comp_faceMap (v : Fin (n + 1) → Smp m) {k : ℕ} (g : Fin (k + 1) → Fin (n + 1)) :
    aff (v ∘ g) = (aff v).comp (faceMap g) := by
  classical
  ext x : 1
  refine smp_ext fun i ↦ ?_
  rw [ContinuousMap.comp_apply, aff_apply_coe, aff_apply_coe, faceMap_apply]
  simp only [stdSimplex.map_coe, FunOnFinite.linearMap_apply_apply, Finset.sum_mul,
    Function.comp_apply]
  exact (Finset.sum_fiberwise Finset.univ g (fun j ↦ x j * (v (g j)) i)).symm.trans
    (Finset.sum_congr rfl fun y _ ↦ Finset.sum_congr rfl fun j hj ↦ by
      rw [(Finset.mem_filter.mp hj).2])

/-- Le morphisme d'ensembles simpliciaux `tupleSSet Δⁿ ⟶ singSSet Δⁿ`, `v ↦ aff v`. -/
noncomputable def realize (n : ℕ) : tupleSSet (Smp n) ⟶ singSSet (Smp n) where
  app k := ↾(fun v ↦ aff v)
  naturality k k' f := by
    refine ConcreteCategory.hom_ext _ _ fun v ↦ ?_
    exact aff_comp_faceMap v f.unop.toOrderHom

/-! ### Applications affines -/

/-- `φ` commute aux combinaisons convexes. -/
def IsAff {a b : ℕ} (φ : Smp a → Smp b) : Prop :=
  ∀ (k : ℕ) (v : Fin (k + 1) → Smp a) (x : Smp k), φ (aff v x) = aff (φ ∘ v) x

theorem IsAff.comp_aff {a b : ℕ} {φ : C(Smp a, Smp b)} (h : IsAff φ) {k : ℕ}
    (v : Fin (k + 1) → Smp a) : φ.comp (aff v) = aff (φ ∘ v) := by
  ext x : 1
  exact h k v x

theorem isAff_faceMap {k l : ℕ} (g : Fin (k + 1) → Fin (l + 1)) : IsAff (faceMap g) := by
  classical
  intro j v x
  refine smp_ext fun i ↦ ?_
  rw [aff_apply_coe, faceMap_apply]
  simp only [stdSimplex.map_coe, FunOnFinite.linearMap_apply_apply, Function.comp_apply,
    faceMap_apply, aff_apply_coe]
  rw [Finset.sum_comm]
  simp_rw [Finset.mul_sum]

theorem isAff_aff {a b : ℕ} (w : Fin (a + 1) → Smp b) : IsAff (aff w) := by
  intro k v x
  refine smp_ext fun i ↦ ?_
  simp only [aff_apply_coe, Function.comp_apply, Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  simp_rw [mul_assoc]

/-- Les sommets du simplexe standard. -/
noncomputable def vtx (k : ℕ) : Fin (k + 1) → Smp k := fun j ↦ stdSimplex.vertex j

theorem aff_vtx_apply {k : ℕ} (v : Fin (k + 1) → Smp n) (j : Fin (k + 1)) : aff v (vtx k j) = v j := by
  classical
  refine smp_ext fun i ↦ ?_
  rw [aff_apply_coe]
  simp [vtx, Pi.single_apply]

theorem aff_comp_vtx {k : ℕ} (v : Fin (k + 1) → Smp n) : aff v ∘ vtx k = v :=
  funext (aff_vtx_apply v)

theorem aff_vtx (k : ℕ) : aff (vtx k) = ContinuousMap.id _ := by
  classical
  ext x : 1
  refine smp_ext fun i ↦ ?_
  rw [aff_apply_coe]
  simp [vtx, Pi.single_apply]

theorem faceMap_comp_vtx {k l : ℕ} (g : Fin (k + 1) → Fin (l + 1)) :
    faceMap g ∘ vtx k = vtx l ∘ g := by
  classical
  funext j
  exact stdSimplex.map_vertex g j

/-! ### Points de cône : les barycentres -/

/-- Le barycentre du simplexe de sommets `v`. -/
noncomputable def bary (n : ℕ) : Linear.ConePoints (Smp n) :=
  fun _ v ↦ aff v stdSimplex.barycenter

theorem coneCompat_of_isAff {a b : ℕ} {φ : Smp a → Smp b} (h : IsAff φ) :
    Linear.ConeCompat (bary a) φ (bary b) :=
  fun _ v ↦ h _ v _

end Hatcher.Singular

end

/-! ## Recopié de `Bridge/Singular/Subdivision.lean` -/

section

/-!
# Subdivision barycentrique des chaînes singulières (A1, étape 4)

On travaille avec le complexe `GChains R X`, faces alternées de `singSSet X ⋙ free R`, dont les
`k`-chaînes sont `C(Δᵏ, X) →₀ R`. Il est isomorphe au complexe de Mathlib, naturellement en `X`
(`cgIso`).

* `push σ` : `C(Δᵏ, Y) →₀ R → C(Δᵏ, X) →₀ R`, `τ ↦ σ ∘ τ`, pour `σ : C(Y, X)`.
* `real` : `LC(Δⁿ) → C_•(Δⁿ)`, `v ↦ aff v` (réalisation des chaînes linéaires).
* `S σ = σ_*(réal(S_lin ι))` et `T σ = σ_*(réal(T_lin ι))`, où `ι = (e₀, …, e_k)` est la suite des
  sommets de `Δᵏ` (Hatcher, preuve de 2.21).

Lemme clé : `S (σ_* (réal c)) = σ_* (réal (S_lin c))`, et de même pour `T`. Il découle de la
naturalité de `S_lin` et `T_lin` pour les applications affines `aff w`. On en tire :
* `∂S = S∂` ;
* `∂T + T∂ = 1 − S` ;
* `Sʲ σ = σ_*(réal(S_linʲ ι))`.
-/

open CategoryTheory Opposite AlgebraicTopology

namespace Hatcher.Singular

variable (R : Type) [Ring R]

/-- Le complexe singulier concret : `k`-chaînes `C(Δᵏ, X) →₀ R`. -/
noncomputable abbrev GChains (X : Type) [TopologicalSpace X] : ChainComplex (ModuleCat.{0} R) ℕ :=
  (alternatingFaceMapComplex (ModuleCat.{0} R)).obj (singSSet X ⋙ ModuleCat.free R)

/-- Le morphisme de complexes induit par une application continue. -/
noncomputable abbrev gmap {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y] (f : C(X, Y)) :
    GChains R X ⟶ GChains R Y :=
  (alternatingFaceMapComplex (ModuleCat.{0} R)).map
    (Functor.whiskerRight (singMap f) (ModuleCat.free R))

/-- `FChains R X ≅ GChains R X`. -/
noncomputable def fgIso (X : Type) [TopologicalSpace X] : FChains R X ≅ GChains R X :=
  (alternatingFaceMapComplex (ModuleCat.{0} R)).mapIso
    (Functor.isoWhiskerRight (singIso X) (ModuleCat.free R))

variable {R} in
theorem fmap_comp_fgIso {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y] (f : C(X, Y)) :
    fmap R f ≫ (fgIso R Y).hom = (fgIso R X).hom ≫ gmap R f := by
  let F := alternatingFaceMapComplex (ModuleCat.{0} R)
  show F.map (Functor.whiskerRight (TopCat.toSSet.map (TopCat.ofHom f)) (ModuleCat.free R)) ≫
      F.map (Functor.isoWhiskerRight (singIso Y) (ModuleCat.free R)).hom =
    F.map (Functor.isoWhiskerRight (singIso X) (ModuleCat.free R)).hom ≫
      F.map (Functor.whiskerRight (singMap f) (ModuleCat.free R))
  rw [← F.map_comp, ← F.map_comp, Functor.isoWhiskerRight_hom, Functor.isoWhiskerRight_hom,
    ← Functor.whiskerRight_comp, ← Functor.whiskerRight_comp, singIso_naturality]

/-- `C_•(X; R) ≅ GChains R X`. -/
noncomputable def cgIso (X : Type) [TopologicalSpace X] : Chains R X ≅ GChains R X :=
  chainsIso R X ≪≫ fgIso R X

variable {R} in
@[reassoc]
theorem chainsMap_comp_cgIso {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
    (f : C(X, Y)) :
    chainsMap (R := R) f ≫ (cgIso R Y).hom = (cgIso R X).hom ≫ gmap R f := by
  rw [cgIso, cgIso, Iso.trans_hom, Iso.trans_hom, ← Category.assoc, chainsMap_comp_chainsIso,
    Category.assoc, fmap_comp_fgIso, Category.assoc]

namespace Sing

variable {R} {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]

/-- Les `k`-chaînes singulières concrètes. -/
abbrev Ch (R : Type) [Ring R] (k : ℕ) (X : Type) [TopologicalSpace X] : Type :=
  C(Smp k, X) →₀ R

/-- Le bord `∂ : C_{k+1} → C_k`. -/
noncomputable abbrev d (k : ℕ) : Ch R (k + 1) X →ₗ[R] Ch R k X :=
  ((GChains R X).d (k + 1) k).hom

theorem d_eq (k : ℕ) : d (R := R) (X := X) k =
    ∑ i : Fin (k + 2), ((-1 : ℤ) ^ (i : ℕ)) •
      Finsupp.lmapDomain R R (fun σ : C(Smp (k + 1), X) ↦ σ.comp (faceMap i.succAbove)) := by
  rw [d, show (GChains R X).d (k + 1) k = _ from AlternatingFaceMapComplex.obj_d_eq _ k]
  simp only [ModuleCat.hom_sum, ModuleCat.hom_zsmul]
  rfl

theorem d_d (k : ℕ) (c : Ch R (k + 2) X) : d k (d (k + 1) c) = 0 := by
  have h := (GChains R X).d_comp_d (k + 2) (k + 1) k
  exact congrArg (fun f ↦ f.hom c) h

/-- `σ_*` pour `σ : C(Y, X)`. -/
noncomputable abbrev push (σ : C(Y, X)) (k : ℕ) : Ch R k Y →ₗ[R] Ch R k X :=
  Finsupp.lmapDomain R R (fun τ : C(Smp k, Y) ↦ σ.comp τ)

theorem push_single (σ : C(Y, X)) (k : ℕ) (τ : C(Smp k, Y)) (r : R) :
    push σ k (Finsupp.single τ r) = Finsupp.single (σ.comp τ) r := by
  rw [push, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]

theorem push_push {Z : Type} [TopologicalSpace Z] (σ : C(Y, X)) (τ : C(Z, Y)) (k : ℕ)
    (c : Ch R k Z) : push σ k (push τ k c) = push (σ.comp τ) k c := by
  rw [push, push, push, Finsupp.lmapDomain_apply, Finsupp.lmapDomain_apply,
    Finsupp.lmapDomain_apply, ← Finsupp.mapDomain_comp]
  rfl

theorem gmap_f (f : C(Y, X)) (k : ℕ) : ((gmap R f).f k).hom = push f k := rfl

theorem push_d (σ : C(Y, X)) (k : ℕ) (c : Ch R (k + 1) Y) :
    push σ k (d k c) = d k (push σ (k + 1) c) := by
  have h := (gmap R σ).comm (k + 1) k
  exact congrArg (fun f ↦ f.hom c) h.symm

/-- La réalisation `LC(Δⁿ) → C_•(Δⁿ)`. -/
noncomputable abbrev real (n k : ℕ) : Linear.LC R (Smp n) k →ₗ[R] Ch R k (Smp n) :=
  Finsupp.lmapDomain R R (fun v : Fin (k + 1) → Smp n ↦ aff v)

theorem real_single (n k : ℕ) (v : Fin (k + 1) → Smp n) (r : R) :
    real n k (Finsupp.single v r) = Finsupp.single (aff v) r := by
  rw [real, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]

/-- La réalisation est un morphisme de complexes. -/
theorem real_bd (n k : ℕ) (c : Linear.LC R (Smp n) (k + 1)) :
    real n k (Linear.bd k c) = d k (real n (k + 1) c) := by
  have h := ((alternatingFaceMapComplex (ModuleCat.{0} R)).map
    (Functor.whiskerRight (realize n) (ModuleCat.free R))).comm (k + 1) k
  exact congrArg (fun f ↦ f.hom c) h.symm

theorem real_tmap {a b : ℕ} (φ : C(Smp a, Smp b)) (hφ : IsAff φ) (k : ℕ)
    (c : Linear.LC R (Smp a) k) :
    real b k (Linear.tmap φ k c) = push φ k (real a k c) := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c d hc' hd' => simp only [map_add, hc', hd']
  | single v r =>
    rw [Linear.tmap_single, real_single, real_single, push_single, hφ.comp_aff v]

/-! ### Subdivision et homotopie singulières -/

/-- La chaîne linéaire `ι = (e₀, …, e_k)`, le simplexe identité de `Δᵏ`. -/
noncomputable abbrev iota (k : ℕ) : Linear.LC R (Smp k) k := Finsupp.single (vtx k) 1

theorem push_real_iota {k : ℕ} (σ : C(Smp k, X)) :
    push σ k (real k k (iota (R := R) k)) = Finsupp.single σ 1 := by
  rw [real_single, aff_vtx, push_single]
  rfl

variable (R X) in
/-- La subdivision singulière `S σ = σ_*(réal(S_lin ι))`. -/
noncomputable def S (k : ℕ) : Ch R k X →ₗ[R] Ch R k X :=
  Finsupp.linearCombination R
    (fun σ : C(Smp k, X) ↦ push σ k (real k k (Linear.subd (bary k) k (iota k))))

variable (R X) in
/-- L'homotopie singulière `T σ = σ_*(réal(T_lin ι))`. -/
noncomputable def T (k : ℕ) : Ch R k X →ₗ[R] Ch R (k + 1) X :=
  Finsupp.linearCombination R
    (fun σ : C(Smp k, X) ↦ push σ (k + 1) (real k (k + 1) (Linear.homot (bary k) k (iota k))))

theorem S_single (k : ℕ) (σ : C(Smp k, X)) (r : R) :
    S R X k (Finsupp.single σ r) = r • push σ k (real k k (Linear.subd (bary k) k (iota k))) := by
  rw [S, Finsupp.linearCombination_single]

theorem T_single (k : ℕ) (σ : C(Smp k, X)) (r : R) :
    T R X k (Finsupp.single σ r) =
      r • push σ (k + 1) (real k (k + 1) (Linear.homot (bary k) k (iota k))) := by
  rw [T, Finsupp.linearCombination_single]

theorem tmap_aff_iota {m k : ℕ} (w : Fin (k + 1) → Smp m) :
    Linear.tmap (aff w) k (iota (R := R) k) = Finsupp.single w 1 := by
  rw [Linear.tmap_single, aff_comp_vtx]

/-- **Lemme clé** pour `S`. -/
theorem S_push_real {m : ℕ} (σ : C(Smp m, X)) (k : ℕ) (c : Linear.LC R (Smp m) k) :
    S R X k (push σ k (real m k c)) = push σ k (real m k (Linear.subd (bary m) k c)) := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c₁ c₂ hc hd => simp only [map_add, hc, hd]
  | single w r =>
    rw [real_single, push_single, S_single, ← push_push, ← real_tmap (aff w) (isAff_aff w), Linear.tmap_subd (coneCompat_of_isAff (isAff_aff w)),
      tmap_aff_iota, Linear.single_eq_smul k w r, map_smul, map_smul, map_smul]

/-- **Lemme clé** pour `T`. -/
theorem T_push_real {m : ℕ} (σ : C(Smp m, X)) (k : ℕ) (c : Linear.LC R (Smp m) k) :
    T R X k (push σ k (real m k c)) =
      push σ (k + 1) (real m (k + 1) (Linear.homot (bary m) k c)) := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c₁ c₂ hc hd => simp only [map_add, hc, hd]
  | single w r =>
    rw [real_single, push_single, T_single, ← push_push, ← real_tmap (aff w) (isAff_aff w), Linear.tmap_homot (coneCompat_of_isAff (isAff_aff w)),
      tmap_aff_iota, Linear.single_eq_smul k w r, map_smul, map_smul, map_smul]

theorem S_single_one (k : ℕ) (σ : C(Smp k, X)) :
    S R X k (Finsupp.single σ 1) = push σ k (real k k (Linear.subd (bary k) k (iota k))) := by
  rw [S_single, one_smul]

theorem T_single_one (k : ℕ) (σ : C(Smp k, X)) :
    T R X k (Finsupp.single σ 1) =
      push σ (k + 1) (real k (k + 1) (Linear.homot (bary k) k (iota k))) := by
  rw [T_single, one_smul]

theorem ch_single_eq_smul {k : ℕ} (σ : C(Smp k, X)) (r : R) :
    (Finsupp.single σ r : Ch R k X) = r • Finsupp.single σ 1 := by
  rw [Finsupp.smul_single, smul_eq_mul, mul_one]

/-- **`S` est un morphisme de complexes.** -/
theorem d_S (k : ℕ) (c : Ch R (k + 1) X) : d k (S R X (k + 1) c) = S R X k (d k c) := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c₁ c₂ hc hd => simp only [map_add, hc, hd]
  | single σ r =>
    rw [ch_single_eq_smul σ r, map_smul, map_smul, map_smul, S_single_one, ← push_d,
      ← real_bd, Linear.bd_subd, map_smul]
    congr 1
    rw [← push_real_iota σ, ← push_d, ← real_bd, S_push_real]

/-- **`T` est une homotopie de `1` à `S`** en degré `≥ 1`. -/
theorem d_T (k : ℕ) (c : Ch R (k + 1) X) :
    d (k + 1) (T R X (k + 1) c) + T R X k (d k c) = c - S R X (k + 1) c := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c₁ c₂ hc hd =>
    calc _ = (d (k + 1) (T R X (k + 1) c₁) + T R X k (d k c₁)) +
          (d (k + 1) (T R X (k + 1) c₂) + T R X k (d k c₂)) := by simp only [map_add]; abel
      _ = (c₁ - S R X (k + 1) c₁) + (c₂ - S R X (k + 1) c₂) := by rw [hc, hd]
      _ = _ := by simp only [map_add]; abel
  | single σ r =>
    rw [ch_single_eq_smul σ r]
    simp only [map_smul]
    rw [← smul_add, ← smul_sub]
    congr 1
    rw [T_single_one, ← push_d, ← real_bd, ← push_real_iota σ, ← push_d, ← real_bd, T_push_real,
      ← map_add, ← map_add, Linear.bd_homot, map_sub, map_sub, push_real_iota, S_single_one]

/-- En degré 0, `S = id` et `T = 0`. -/
theorem S_zero (c : Ch R 0 X) : S R X 0 c = c := by
  induction c using Finsupp.induction_linear with
  | zero => simp
  | add c₁ c₂ hc hd => simp only [map_add, hc, hd]
  | single σ r =>
    rw [S_single, Linear.subd_zero, push_real_iota, Finsupp.smul_single, smul_eq_mul, mul_one]

end Sing

end Hatcher.Singular

end

/-! ## Recopié de `Bridge/Singular/Small.lean` -/

section

/-!
# Petits simplexes (A1, étape 5 ; Hatcher, Proposition 2.21)

Pour une famille `U : ι → Set X` dont les intérieurs recouvrent `X`, une `k`-chaîne est *petite* si
chacun de ses simplexes a son image dans l'un des `U i`. Les petites chaînes forment le sous-module
`Finsupp.supported R R (small U k)`.

1. **Diamètres.** Si les sommets de `v` sont à distance `≤ ε` deux à deux, ceux de chaque simplexe
   de la subdivision `S_lin v` le sont à distance `≤ k/(k+1) · ε` (degré `k`). Ils restent dans
   l'image de `aff v`. On utilise la distance du sup dans `ℝ^{n+1}`.
2. **Lebesgue.** Pour chaque chaîne `c`, `Sʲ c` est petite pour `j` assez grand.
3. **Homotopie télescopique.** `D_j = ∑_{i<j} T Sⁱ` vérifie `∂D_j + D_j∂ = 1 − Sʲ`. `S`, `T` et `∂`
   préservent les petites chaînes.
4. **Exactitude du quotient.** Si `∂z` est petite, `z − ∂c` est petite pour un certain `c`. En
   degré 0, toute chaîne est petite.
-/

open CategoryTheory

namespace Hatcher.Singular

namespace Sing

variable {R : Type} [Ring R] {X : Type} [TopologicalSpace X]

/-! ### Diamètres -/

/-- Le rapport de contraction `k / (k+1)`. -/
noncomputable abbrev ratio (k : ℕ) : ℝ := (k : ℝ) / ((k : ℝ) + 1)

theorem ratio_nonneg (k : ℕ) : 0 ≤ ratio k := by positivity

theorem ratio_lt_one (k : ℕ) : ratio k < 1 := by
  rw [ratio, div_lt_one (by positivity)]
  linarith

theorem ratio_le_ratio_succ (k : ℕ) : ratio k ≤ ratio (k + 1) := by
  rw [ratio, ratio, div_le_div_iff₀ (by positivity) (by positivity)]
  push_cast
  nlinarith

theorem coord_dist_le {n : ℕ} (x y : Smp n) (i : Fin (n + 1)) : |x i - y i| ≤ dist x y := by
  rw [← Real.dist_eq, Subtype.dist_eq]
  exact dist_le_pi_dist (x : Fin (n + 1) → ℝ) y i

theorem dist_le_of_coord {n : ℕ} {x y : Smp n} {r : ℝ} (hr : 0 ≤ r) (h : ∀ i, |x i - y i| ≤ r) :
    dist x y ≤ r := by
  rw [Subtype.dist_eq, dist_pi_le_iff hr]
  intro i
  rw [Real.dist_eq]
  exact h i

/-- **Combinaisons convexes.** Si tous les sommets sont à distance `≤ r` de `p`, tout point du
simplexe affine aussi. -/
theorem dist_aff_le {k n : ℕ} {v : Fin (k + 1) → Smp n} {p : Smp n} {r : ℝ} (hr : 0 ≤ r)
    (h : ∀ j, dist (v j) p ≤ r) (x : Smp k) : dist (aff v x) p ≤ r := by
  refine dist_le_of_coord hr fun i ↦ ?_
  have hx : ∑ j, x j = 1 := stdSimplex.sum_eq_one x
  have e : (aff v x) i - p i = ∑ j, x j * ((v j) i - p i) := by
    rw [aff_apply_coe]
    simp_rw [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, hx, one_mul]
  rw [e]
  calc |∑ j, x j * ((v j) i - p i)| ≤ ∑ j, |x j * ((v j) i - p i)| := Finset.abs_sum_le_sum_abs _ _
    _ = ∑ j, x j * |(v j) i - p i| := by
        refine Finset.sum_congr rfl fun j _ ↦ ?_
        rw [abs_mul, abs_of_nonneg (stdSimplex.zero_le x j)]
    _ ≤ ∑ j, x j * r := Finset.sum_le_sum fun j _ ↦
        mul_le_mul_of_nonneg_left ((coord_dist_le _ _ i).trans (h j)) (stdSimplex.zero_le x j)
    _ = r := by rw [← Finset.sum_mul, hx, one_mul]

theorem bary_coord {k n : ℕ} (v : Fin (k + 1) → Smp n) (i : Fin (n + 1)) :
    (bary n k v) i = ∑ l, ((k : ℝ) + 1)⁻¹ * (v l) i := by
  rw [bary, aff_apply_coe]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  congr 1
  rw [show (stdSimplex.barycenter : stdSimplex ℝ (Fin (k + 1))) l =
    (Fintype.card (Fin (k + 1)) : ℝ)⁻¹ from stdSimplex.barycenter_apply l]
  simp

/-- **Distance au barycentre** : `dist(v_j, b(v)) ≤ k/(k+1) · ε`. -/
theorem dist_vertex_bary_le {k n : ℕ} {v : Fin (k + 1) → Smp n} {ε : ℝ} (hε : 0 ≤ ε)
    (h : ∀ a b, dist (v a) (v b) ≤ ε) (j : Fin (k + 1)) :
    dist (v j) (bary n k v) ≤ ratio k * ε := by
  have hk : (0 : ℝ) < (k : ℝ) + 1 := by positivity
  refine dist_le_of_coord (mul_nonneg (ratio_nonneg k) hε) fun i ↦ ?_
  have e : (v j) i - (bary n k v) i = ((k : ℝ) + 1)⁻¹ * ∑ l, ((v j) i - (v l) i) := by
    rw [bary_coord, ← Finset.mul_sum, Finset.sum_sub_distrib, Finset.sum_const, Finset.card_univ,
      Fintype.card_fin, nsmul_eq_mul]
    push_cast
    field_simp
  rw [e, abs_mul, abs_of_pos (inv_pos.mpr hk)]
  have hsum : ∑ l, |(v j) i - (v l) i| ≤ k * ε := by
    rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j), sub_self, abs_zero, zero_add]
    calc ∑ l ∈ Finset.univ.erase j, |(v j) i - (v l) i| ≤ ∑ _l ∈ Finset.univ.erase j, ε :=
          Finset.sum_le_sum fun l _ ↦ (coord_dist_le _ _ i).trans (h j l)
      _ = k * ε := by
          rw [Finset.sum_const, Finset.card_erase_of_mem (Finset.mem_univ j), Finset.card_univ,
            Fintype.card_fin, nsmul_eq_mul]
          simp
  calc ((k : ℝ) + 1)⁻¹ * |∑ l, ((v j) i - (v l) i)| ≤ ((k : ℝ) + 1)⁻¹ * ∑ l, |(v j) i - (v l) i| :=
        mul_le_mul_of_nonneg_left (Finset.abs_sum_le_sum_abs _ _) (inv_nonneg.mpr hk.le)
    _ ≤ ((k : ℝ) + 1)⁻¹ * (k * ε) :=
        mul_le_mul_of_nonneg_left hsum (inv_nonneg.mpr hk.le)
    _ = ratio k * ε := by rw [ratio]; field_simp

/-- Les sommets `w` sont à distance `≤ ε'` deux à deux et dans l'image de `aff v`. -/
def Good {k k' n : ℕ} (v : Fin (k + 1) → Smp n) (ε' : ℝ) (w : Fin (k' + 1) → Smp n) : Prop :=
  (∀ a b, dist (w a) (w b) ≤ ε') ∧ ∀ a, w a ∈ Set.range (aff v)

theorem range_aff_comp {k n m : ℕ} (v : Fin (k + 1) → Smp n) (g : Fin (m + 1) → Fin (k + 1)) :
    Set.range (aff (v ∘ g)) ⊆ Set.range (aff v) := by
  rw [aff_comp_faceMap]
  rintro _ ⟨x, rfl⟩
  exact ⟨_, rfl⟩

theorem mem_support_cone {n k : ℕ} {p : Smp n} {c : Linear.LC R (Smp n) k}
    {w : Fin (k + 2) → Smp n} (hw : w ∈ (Linear.cone p k c).support) :
    ∃ v ∈ c.support, w = Fin.cons p v := by
  classical
  rw [Linear.cone, Finsupp.lmapDomain_apply] at hw
  obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hw)
  exact ⟨v, hv, rfl⟩

/-- Support d'une image linéaire : contenu dans la réunion des supports des images des
simplexes. -/
theorem mem_support_linear {α β : Type} (L : (α →₀ R) →ₗ[R] (β →₀ R)) {c : α →₀ R} {b : β}
    (hb : b ∈ (L c).support) : ∃ a ∈ c.support, b ∈ (L (Finsupp.single a 1)).support := by
  classical
  have hsub : (L c).support ⊆ c.support.biUnion (fun a ↦ (L (Finsupp.single a 1)).support) := by
    conv_lhs => rw [← Finsupp.sum_single c]
    rw [Finsupp.sum, map_sum]
    refine Finsupp.support_finsetSum.trans (Finset.biUnion_mono fun a _ ↦ ?_)
    rw [show Finsupp.single a (c a) = c a • Finsupp.single a (1 : R) by
      rw [Finsupp.smul_single, smul_eq_mul, mul_one], map_smul]
    exact Finsupp.support_smul
  exact Finset.mem_biUnion.mp (hsub hb)

theorem mem_support_bd_single {n k : ℕ} {v : Fin (k + 2) → Smp n} {w : Fin (k + 1) → Smp n}
    (hw : w ∈ (Linear.bd k (Finsupp.single v (1 : R))).support) :
    ∃ i : Fin (k + 2), w = v ∘ i.succAbove := by
  classical
  rw [Linear.bd_single] at hw
  obtain ⟨i, -, hi⟩ := Finset.mem_biUnion.mp (Finsupp.support_finsetSum hw)
  have := Finsupp.support_smul (b := ((-1 : ℤ) ^ (i : ℕ)))
    (g := Finsupp.single (v ∘ i.succAbove) (1 : R)) hi
  exact ⟨i, Finset.mem_singleton.mp (Finsupp.support_single_subset this)⟩

/-- **Contraction des diamètres par la subdivision.** -/
theorem good_subd {n : ℕ} : ∀ (k : ℕ) (v : Fin (k + 1) → Smp n) {ε : ℝ}, 0 ≤ ε →
    (∀ a b, dist (v a) (v b) ≤ ε) →
    ∀ w ∈ (Linear.subd (bary n) k (Finsupp.single v (1 : R))).support, Good v (ratio k * ε) w
  | 0, v, ε, _, _, w, hw => by
    rw [Linear.subd_zero] at hw
    have hw' := Finset.mem_singleton.mp (Finsupp.support_single_subset hw)
    subst hw'
    refine ⟨fun a b ↦ ?_, fun a ↦ ⟨vtx 0 a, aff_vtx_apply w a⟩⟩
    fin_cases a; fin_cases b
    simp [ratio]
  | k + 1, v, ε, hε, hv, w, hw => by
    classical
    rw [Linear.subd_succ_single_one] at hw
    obtain ⟨u, hu, rfl⟩ := mem_support_cone hw
    obtain ⟨f, hf, hu''⟩ := mem_support_linear _ hu
    obtain ⟨i, rfl⟩ := mem_support_bd_single hf
    obtain ⟨hdu, hru⟩ := good_subd k (v ∘ i.succAbove) hε (fun a b ↦ hv _ _) u hu''
    have hrange : ∀ a, u a ∈ Set.range (aff v) := fun a ↦ range_aff_comp v i.succAbove (hru a)
    have hb : ∀ a, dist (bary n (k + 1) v) (u a) ≤ ratio (k + 1) * ε := by
      intro a
      obtain ⟨x, hx⟩ := hrange a
      rw [← hx, dist_comm]
      exact dist_aff_le (mul_nonneg (ratio_nonneg _) hε)
        (fun j ↦ dist_vertex_bary_le hε hv j) x
    have huu : ∀ a b, dist (u a) (u b) ≤ ratio (k + 1) * ε := fun a b ↦
      (hdu a b).trans (mul_le_mul_of_nonneg_right (ratio_le_ratio_succ k) hε)
    refine ⟨fun a b ↦ ?_, fun a ↦ ?_⟩
    · refine Fin.cases ?_ (fun a ↦ ?_) a <;> refine Fin.cases ?_ (fun b ↦ ?_) b
      · simp [mul_nonneg (ratio_nonneg _) hε]
      · simpa using hb b
      · simpa [dist_comm] using hb a
      · simpa using huu a b
    · refine Fin.cases ?_ (fun a ↦ ?_) a
      · exact ⟨_, rfl⟩
      · simpa using hrange a

/-- Itération : si les simplexes de `c` ont des sommets à distance `≤ ε`, ceux de `S_lin c`
sont à distance `≤ k/(k+1) · ε`. -/
theorem diam_subd {n k : ℕ} {ε : ℝ} (hε : 0 ≤ ε) (c : Linear.LC R (Smp n) k)
    (hc : ∀ w ∈ c.support, ∀ a b, dist (w a) (w b) ≤ ε) :
    ∀ w ∈ (Linear.subd (bary n) k c).support, ∀ a b, dist (w a) (w b) ≤ ratio k * ε := by
  intro w hw
  obtain ⟨v, hv, hw'⟩ := mem_support_linear _ hw
  exact (good_subd k v hε (hc v hv) w hw').1

theorem diam_subd_iter {n k : ℕ} (j : ℕ) {ε : ℝ} (hε : 0 ≤ ε) (c : Linear.LC R (Smp n) k)
    (hc : ∀ w ∈ c.support, ∀ a b, dist (w a) (w b) ≤ ε) :
    ∀ w ∈ ((Linear.subd (bary n) k)^[j] c).support, ∀ a b,
      dist (w a) (w b) ≤ ratio k ^ j * ε := by
  induction j with
  | zero => simpa using hc
  | succ j ih =>
    rw [Function.iterate_succ_apply']
    intro w hw a b
    have := diam_subd (mul_nonneg (pow_nonneg (ratio_nonneg k) j) hε) _ ih w hw a b
    rwa [← mul_assoc, ← pow_succ'] at this

theorem dist_vtx_le_one (k a b : ℕ) (ha : a < k + 1) (hb : b < k + 1) :
    dist (vtx k ⟨a, ha⟩) (vtx k ⟨b, hb⟩) ≤ 1 := by
  refine dist_le_of_coord zero_le_one fun i ↦ ?_
  have h1 := stdSimplex.zero_le (vtx k ⟨a, ha⟩) i
  have h2 := stdSimplex.le_one (vtx k ⟨a, ha⟩) i
  have h3 := stdSimplex.zero_le (vtx k ⟨b, hb⟩) i
  have h4 := stdSimplex.le_one (vtx k ⟨b, hb⟩) i
  rw [abs_le]
  constructor <;> linarith

theorem diam_iota (k : ℕ) :
    ∀ w ∈ (iota (R := R) k).support, ∀ a b, dist (w a) (w b) ≤ 1 := by
  intro w hw a b
  have hw' := Finset.mem_singleton.mp (Finsupp.support_single_subset hw)
  subst hw'
  exact dist_vtx_le_one k a b a.2 b.2

/-! ### Petites chaînes -/

/-- Les `k`-simplexes petits relativement à `U`. -/
def small {ι : Type} (U : ι → Set X) (k : ℕ) : Set C(Smp k, X) :=
  {σ | ∃ i, Set.range σ ⊆ U i}

/-- Le sous-module des petites chaînes. -/
abbrev smallCh {ι : Type} (U : ι → Set X) (k : ℕ) : Submodule R (Ch R k X) :=
  Finsupp.supported R R (small U k)

/-- Critère : `L` envoie les petites chaînes sur les petites chaînes dès qu'il le fait pour les
simplexes. -/
theorem map_supported {α β : Type} {s : Set α} {t : Set β} (L : (α →₀ R) →ₗ[R] (β →₀ R))
    (h : ∀ a ∈ s, L (Finsupp.single a 1) ∈ Finsupp.supported R R t) {c : α →₀ R}
    (hc : c ∈ Finsupp.supported R R s) : L c ∈ Finsupp.supported R R t := by
  rw [Finsupp.supported_eq_span_single] at hc
  have : Submodule.map L (Submodule.span R ((fun a ↦ Finsupp.single a (1 : R)) '' s)) ≤
      Finsupp.supported R R t := by
    rw [Submodule.map_span_le]
    rintro _ ⟨a, ha, rfl⟩
    exact h a ha
  exact this ⟨c, hc, rfl⟩

theorem push_mem_small {ι : Type} {U : ι → Set X} {m : ℕ} {σ : C(Smp m, X)} (hσ : σ ∈ small U m)
    (k : ℕ) (c : Ch R k (Smp m)) : push σ k c ∈ smallCh (R := R) U k := by
  classical
  obtain ⟨i, hi⟩ := hσ
  rw [push, Finsupp.lmapDomain_apply, Finsupp.mem_supported]
  intro τ hτ
  obtain ⟨τ', -, rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hτ)
  refine ⟨i, ?_⟩
  rintro _ ⟨x, rfl⟩
  exact hi ⟨τ' x, rfl⟩

theorem S_mem_small {ι : Type} {U : ι → Set X} {k : ℕ} {c : Ch R k X}
    (hc : c ∈ smallCh (R := R) U k) : S R X k c ∈ smallCh (R := R) U k :=
  map_supported _ (fun σ hσ ↦ by rw [S_single_one]; exact push_mem_small hσ _ _) hc

theorem T_mem_small {ι : Type} {U : ι → Set X} {k : ℕ} {c : Ch R k X}
    (hc : c ∈ smallCh (R := R) U k) : T R X k c ∈ smallCh (R := R) U (k + 1) :=
  map_supported _ (fun σ hσ ↦ by rw [T_single_one]; exact push_mem_small hσ _ _) hc

theorem d_mem_small {ι : Type} {U : ι → Set X} {k : ℕ} {c : Ch R (k + 1) X}
    (hc : c ∈ smallCh (R := R) U (k + 1)) : d k c ∈ smallCh (R := R) U k := by
  refine map_supported _ (fun σ hσ ↦ ?_) hc
  rw [← push_real_iota σ, ← push_d]
  exact push_mem_small hσ _ _

theorem S_iter_mem_small {ι : Type} {U : ι → Set X} {k : ℕ} (j : ℕ) {c : Ch R k X}
    (hc : c ∈ smallCh (R := R) U k) : (S R X k)^[j] c ∈ smallCh (R := R) U k := by
  induction j with
  | zero => exact hc
  | succ j ih => rw [Function.iterate_succ_apply']; exact S_mem_small ih

theorem S_iter_push_real {m k : ℕ} (σ : C(Smp m, X)) (j : ℕ) (c : Linear.LC R (Smp m) k) :
    (S R X k)^[j] (push σ k (real m k c)) =
      push σ k (real m k ((Linear.subd (bary m) k)^[j] c)) := by
  induction j with
  | zero => rfl
  | succ j ih => rw [Function.iterate_succ_apply', ih, S_push_real, Function.iterate_succ_apply']

/-- **Lebesgue** : `Sʲ σ` est petite pour `j` assez grand. -/
theorem exists_S_iter_single_mem_small {ι : Type} {U : ι → Set X}
    (hU : ∀ x, ∃ i, x ∈ interior (U i)) {k : ℕ} (σ : C(Smp k, X)) :
    ∃ j, (S R X k)^[j] (Finsupp.single σ 1) ∈ smallCh (R := R) U k := by
  classical
  obtain ⟨δ, hδ, hball⟩ := lebesgue_number_lemma_of_metric (isCompact_univ (X := Smp k))
    (c := fun i ↦ σ ⁻¹' interior (U i)) (fun i ↦ isOpen_interior.preimage σ.continuous)
    (fun x _ ↦ Set.mem_iUnion.mpr (hU (σ x)))
  obtain ⟨j, hj⟩ := exists_pow_lt_of_lt_one hδ (ratio_lt_one k)
  refine ⟨j, ?_⟩
  rw [← push_real_iota σ, S_iter_push_real, Finsupp.mem_supported]
  intro τ hτ
  rw [push, Finsupp.lmapDomain_apply] at hτ
  obtain ⟨τ', hτ', rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hτ)
  rw [real, Finsupp.lmapDomain_apply] at hτ'
  obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hτ')
  have hdiam := diam_subd_iter j zero_le_one _ (diam_iota k) w hw
  obtain ⟨i, hi⟩ := hball (w 0) (Set.mem_univ _)
  refine ⟨i, ?_⟩
  rintro _ ⟨x, rfl⟩
  have hx : aff w x ∈ Metric.ball (w 0) δ := by
    rw [Metric.mem_ball]
    refine lt_of_le_of_lt (dist_aff_le (by positivity) (fun a ↦ ?_) x) hj
    simpa using hdiam a 0
  exact interior_subset (hi hx)

theorem exists_S_iter_mem_small {ι : Type} {U : ι → Set X}
    (hU : ∀ x, ∃ i, x ∈ interior (U i)) {k : ℕ} (c : Ch R k X) :
    ∃ j, (S R X k)^[j] c ∈ smallCh (R := R) U k := by
  have mono : ∀ {c : Ch R k X} {j j' : ℕ}, j ≤ j' → (S R X k)^[j] c ∈ smallCh (R := R) U k →
      (S R X k)^[j'] c ∈ smallCh (R := R) U k := by
    intro c j j' hjj' h
    obtain ⟨t, rfl⟩ := Nat.exists_eq_add_of_le' hjj'
    rw [Function.iterate_add_apply]
    exact S_iter_mem_small t h
  induction c using Finsupp.induction_linear with
  | zero => exact ⟨0, Submodule.zero_mem _⟩
  | add c₁ c₂ h₁ h₂ =>
    obtain ⟨j₁, hj₁⟩ := h₁
    obtain ⟨j₂, hj₂⟩ := h₂
    refine ⟨max j₁ j₂, ?_⟩
    rw [iterate_map_add]
    exact Submodule.add_mem _ (mono (le_max_left _ _) hj₁) (mono (le_max_right _ _) hj₂)
  | single σ r =>
    obtain ⟨j, hj⟩ := exists_S_iter_single_mem_small (R := R) hU σ
    refine ⟨j, ?_⟩
    have e : ∀ i : ℕ, (S R X k)^[i] (r • Finsupp.single σ 1) =
        r • (S R X k)^[i] (Finsupp.single σ 1) := by
      intro i
      induction i with
      | zero => rfl
      | succ i ih => rw [Function.iterate_succ_apply', ih, map_smul, Function.iterate_succ_apply']
    rw [ch_single_eq_smul σ r, e]
    exact Submodule.smul_mem _ r hj

/-! ### Homotopie télescopique -/

theorem d_S_iter (k : ℕ) (j : ℕ) (c : Ch R (k + 1) X) :
    d k ((S R X (k + 1))^[j] c) = (S R X k)^[j] (d k c) := by
  induction j with
  | zero => rfl
  | succ j ih => rw [Function.iterate_succ_apply', d_S, ih, Function.iterate_succ_apply']

variable (R X) in
/-- `D_j = ∑_{i<j} T Sⁱ`. -/
noncomputable def D (k j : ℕ) (c : Ch R k X) : Ch R (k + 1) X :=
  ∑ i ∈ Finset.range j, T R X k ((S R X k)^[i] c)

theorem d_D (k j : ℕ) (c : Ch R (k + 1) X) :
    d (k + 1) (D R X (k + 1) j c) + D R X k j (d k c) = c - (S R X (k + 1))^[j] c := by
  rw [D, D, map_sum, ← Finset.sum_add_distrib]
  have : ∀ i ∈ Finset.range j, d (k + 1) (T R X (k + 1) ((S R X (k + 1))^[i] c)) +
      T R X k ((S R X k)^[i] (d k c)) =
      (S R X (k + 1))^[i] c - (S R X (k + 1))^[i + 1] c := by
    intro i _
    rw [← d_S_iter, d_T, Function.iterate_succ_apply']
  rw [Finset.sum_congr rfl this, Finset.sum_range_sub', Function.iterate_zero_apply]

theorem D_mem_small {ι : Type} {U : ι → Set X} {k j : ℕ} {c : Ch R k X}
    (hc : c ∈ smallCh (R := R) U k) : D R X k j c ∈ smallCh (R := R) U (k + 1) :=
  Submodule.sum_mem _ fun i _ ↦ T_mem_small (S_iter_mem_small i hc)

/-! ### Exactitude du quotient par les petites chaînes -/

/-- Si `∂z` est petite, `z − ∂c` est petite pour un certain `c`. -/
theorem exists_sub_d_mem_small {ι : Type} {U : ι → Set X} (hU : ∀ x, ∃ i, x ∈ interior (U i))
    {k : ℕ} (z : Ch R (k + 1) X) (hz : d k z ∈ smallCh (R := R) U k) :
    ∃ c : Ch R (k + 2) X, z - d (k + 1) c ∈ smallCh (R := R) U (k + 1) := by
  obtain ⟨j, hj⟩ := exists_S_iter_mem_small (R := R) hU z
  refine ⟨D R X (k + 1) j z, ?_⟩
  have h := d_D k j z
  have : z - d (k + 1) (D R X (k + 1) j z) = (S R X (k + 1))^[j] z + D R X k j (d k z) := by
    calc z - d (k + 1) (D R X (k + 1) j z) =
          (z - (d (k + 1) (D R X (k + 1) j z) + D R X k j (d k z))) + D R X k j (d k z) := by abel
      _ = (z - (z - (S R X (k + 1))^[j] z)) + D R X k j (d k z) := by rw [h]
      _ = _ := by abel
  rw [this]
  exact Submodule.add_mem _ hj (D_mem_small hz)

theorem S_iter_zero (j : ℕ) (z : Ch R 0 X) : (S R X 0)^[j] z = z := by
  induction j with
  | zero => rfl
  | succ j ih => rw [Function.iterate_succ_apply', ih, S_zero]

/-- En degré 0, toute chaîne est petite. -/
theorem mem_small_zero {ι : Type} {U : ι → Set X} (hU : ∀ x, ∃ i, x ∈ interior (U i))
    (z : Ch R 0 X) : z ∈ smallCh (R := R) U 0 := by
  obtain ⟨j, hj⟩ := exists_S_iter_mem_small (R := R) hU z
  rwa [S_iter_zero] at hj

end Sing

end Hatcher.Singular

end

/-! ## Recopié de `Bridge/Singular/SubComplex.lean` -/

section

/-!
# Sous-complexes, quotients et petites chaînes (A1, étape 6)

* `quasiIso_f_of_acyclic` : dans une suite exacte courte de complexes `0 → X₁ → X₂ → X₃ → 0`
  (indexée par `ℕ`, dans une catégorie abélienne), si `X₃` est acyclique, alors `X₁ → X₂` est un
  quasi-isomorphisme. On le déduit de la suite exacte longue.
* `SubCx R X` : une famille de sous-modules `N k ⊆ C_k(X)` stable par `∂`. Elle définit le
  sous-complexe `sub`, le complexe quotient `quot` (`C_k / N_k`), l'inclusion `incl`, la projection
  `proj`, et la suite exacte courte `ses`.
* `acyclic_quot` : critère élément par élément d'acyclicité du quotient.
* **Petites chaînes** (Hatcher 2.21) : si les intérieurs des `U i` recouvrent `X`, l'inclusion
  `C^𝒰_•(X) → C_•(X)` est un quasi-isomorphisme (`small_quasiIso`).
-/

open CategoryTheory Limits

namespace Hatcher.Singular

/-- **Quotient acyclique ⇒ quasi-isomorphisme.** -/
theorem quasiIso_f_of_acyclic {C : Type*} [Category C] [Abelian C]
    {S : ShortComplex (ChainComplex C ℕ)} (hS : S.ShortExact) (h : S.X₃.Acyclic) :
    QuasiIso S.f := by
  rw [quasiIso_iff]
  intro i
  rw [quasiIsoAt_iff_isIso_homologyMap]
  have hepi : Epi (HomologicalComplex.homologyMap S.f i) :=
    (hS.homology_exact₂ i).epi_f ((h i).isZero_homology.eq_of_tgt _ _)
  have hmono : Mono (HomologicalComplex.homologyMap S.f i) :=
    (hS.homology_exact₁ (i + 1) i rfl).mono_g ((h (i + 1)).isZero_homology.eq_of_src _ _)
  exact isIso_of_mono_of_epi _

variable {R : Type} [Ring R] {X : Type} [TopologicalSpace X]

/-- Une famille de sous-modules des chaînes, stable par le bord. -/
structure SubCx (R X : Type) [Ring R] [TopologicalSpace X] where
  /-- Le sous-module en degré `k`. -/
  N : ∀ k, Submodule R (Sing.Ch R k X)
  d_mem : ∀ k (c : Sing.Ch R (k + 1) X), c ∈ N (k + 1) → Sing.d k c ∈ N k

namespace SubCx

variable (P : SubCx R X)

/-- Le bord du quotient. -/
noncomputable def dQ (k : ℕ) : (Sing.Ch R (k + 1) X ⧸ P.N (k + 1)) →ₗ[R] (Sing.Ch R k X ⧸ P.N k) :=
  (P.N (k + 1)).mapQ (P.N k) (Sing.d k) (fun c hc ↦ P.d_mem k c hc)

theorem dQ_mk (k : ℕ) (c : Sing.Ch R (k + 1) X) :
    P.dQ k (Submodule.Quotient.mk c) = Submodule.Quotient.mk (Sing.d k c) := rfl

/-- Le complexe quotient `C_•(X) / N_•`. -/
noncomputable def quot : ChainComplex (ModuleCat.{0} R) ℕ :=
  ChainComplex.of (fun k ↦ ModuleCat.of R (Sing.Ch R k X ⧸ P.N k)) (fun k ↦ ModuleCat.ofHom (P.dQ k))
    (fun k ↦ by
      refine ModuleCat.hom_ext (Submodule.linearMap_qext _ (LinearMap.ext fun c ↦ ?_))
      change P.dQ k (P.dQ (k + 1) (Submodule.Quotient.mk c)) = 0
      rw [dQ_mk, dQ_mk, Sing.d_d, Submodule.Quotient.mk_zero])

theorem quot_d (k : ℕ) : P.quot.d (k + 1) k = ModuleCat.ofHom (P.dQ k) := by
  simp [quot]

/-- Le sous-complexe `N_•`. -/
noncomputable def sub : ChainComplex (ModuleCat.{0} R) ℕ :=
  ChainComplex.of (fun k ↦ ModuleCat.of R (P.N k))
    (fun k ↦ ModuleCat.ofHom ((Sing.d k).restrict (P.d_mem k)))
    (fun k ↦ by
      refine ModuleCat.hom_ext (LinearMap.ext fun c ↦ Subtype.ext ?_)
      exact Sing.d_d k c.1)

theorem sub_d (k : ℕ) : P.sub.d (k + 1) k = ModuleCat.ofHom ((Sing.d k).restrict (P.d_mem k)) := by
  simp [sub]

/-- L'inclusion `N_• → C_•(X)`. -/
noncomputable def incl : P.sub ⟶ GChains R X :=
  ChainComplex.ofHom (fun k ↦ ModuleCat.ofHom (P.N k).subtype) (fun k ↦ by
    rw [sub_d]
    rfl)

/-- La projection `C_•(X) → C_•(X) / N_•`. -/
noncomputable def proj : GChains R X ⟶ P.quot :=
  ChainComplex.ofHom (fun k ↦ ModuleCat.ofHom (P.N k).mkQ) (fun k ↦ by
    rw [quot_d]
    rfl)

theorem incl_f (k : ℕ) (c : P.N k) : (P.incl.f k).hom c = c.1 := rfl

theorem proj_f (k : ℕ) (c : Sing.Ch R k X) :
    (P.proj.f k).hom c = Submodule.Quotient.mk c := rfl

/-- La suite courte `0 → N_• → C_•(X) → C_•(X)/N_• → 0`. -/
noncomputable def ses : ShortComplex (ChainComplex (ModuleCat.{0} R) ℕ) :=
  ShortComplex.mk P.incl P.proj (by
    ext k c : 3
    exact (Submodule.Quotient.mk_eq_zero _).mpr c.2)

theorem ses_shortExact : P.ses.ShortExact := by
  refine HomologicalComplex.shortExact_of_degreewise_shortExact _ fun k ↦ ?_
  refine { exact := ?_, mono_f := ?_, epi_g := ?_ }
  · rw [ShortComplex.moduleCat_exact_iff]
    intro c hc
    exact ⟨⟨c, (Submodule.Quotient.mk_eq_zero _).mp hc⟩, rfl⟩
  · exact (ModuleCat.mono_iff_injective _).mpr Subtype.val_injective
  · exact (ModuleCat.epi_iff_surjective _).mpr (Submodule.mkQ_surjective _)

/-- **Critère d'acyclicité du quotient.** -/
theorem acyclic_quot
    (h : ∀ k (z : Sing.Ch R (k + 1) X), Sing.d k z ∈ P.N k →
      ∃ c : Sing.Ch R (k + 2) X, z - Sing.d (k + 1) c ∈ P.N (k + 1))
    (h0 : ∀ z : Sing.Ch R 0 X, z ∈ P.N 0) : P.quot.Acyclic := by
  intro j
  cases j with
  | zero =>
    rw [HomologicalComplex.exactAt_iff' _ 1 0 0 (by simp) (by simp),
      ShortComplex.moduleCat_exact_iff]
    intro x _
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    refine ⟨0, ?_⟩
    rw [map_zero]
    exact ((Submodule.Quotient.mk_eq_zero _).mpr (h0 z)).symm
  | succ j =>
    rw [HomologicalComplex.exactAt_iff' _ (j + 1 + 1) (j + 1) j (by simp) (by simp),
      ShortComplex.moduleCat_exact_iff]
    intro x hx
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    change (P.quot.d (j + 1) j).hom (Submodule.Quotient.mk z) = 0 at hx
    rw [quot_d] at hx
    change P.dQ j (Submodule.Quotient.mk z) = 0 at hx
    rw [dQ_mk, Submodule.Quotient.mk_eq_zero] at hx
    obtain ⟨c, hc⟩ := h j z hx
    refine ⟨Submodule.Quotient.mk c, ?_⟩
    change (P.quot.d (j + 1 + 1) (j + 1)).hom (Submodule.Quotient.mk c) = _
    rw [quot_d]
    change P.dQ (j + 1) (Submodule.Quotient.mk c) = _
    rw [dQ_mk, Submodule.Quotient.eq]
    rw [← neg_mem_iff, neg_sub]
    exact hc

end SubCx

/-! ### Petites chaînes -/

/-- Le sous-complexe des petites chaînes. -/
def smallCx {ι : Type} (U : ι → Set X) : SubCx R X where
  N k := Sing.smallCh U k
  d_mem _ _ hc := Sing.d_mem_small hc

/-- **Petites chaînes** (Hatcher 2.21) : l'inclusion `C^𝒰_•(X) → C_•(X)` est un
quasi-isomorphisme. -/
theorem small_quasiIso {ι : Type} {U : ι → Set X} (hU : ∀ x, ∃ i, x ∈ interior (U i)) :
    QuasiIso (smallCx (R := R) U).incl :=
  quasiIso_f_of_acyclic (smallCx U).ses_shortExact
    ((smallCx U).acyclic_quot (fun _ z hz ↦ Sing.exists_sub_d_mem_small hU z hz)
      (fun z ↦ Sing.mem_small_zero hU z))

end Hatcher.Singular

end

/-! ## Recopié de `Bridge/Singular/Pairs.lean` -/

section

/-!
# Paires `(Y, S)` et homologie relative (A1, étape 7)

Pour `S ⊆ Y`, `inCx S` est le sous-complexe de `C_•(Y)` formé des chaînes portées par les simplexes
d'image contenue dans `S`. Il est l'image, injective, de `C_•(S) → C_•(Y)` (`push_incl_*`).

* `relIso Y S : RelChains R Y S ≅ (inCx S).quot`, avec `π ≫ relIso.hom = cgIso.hom ≫ proj`.
  Le complexe relatif de Mathlib (conoyau catégorique) est ainsi identifié au quotient concret
  `C_•(Y) / C_•(S)`.
* `quotMap f` est le morphisme de quotients induit par une application de paires, et
  `relMap_compat` sa compatibilité avec le `cokernel.map` qui définit `relMap`.
-/

open CategoryTheory Limits

namespace Hatcher.Singular

variable {R : Type} [Ring R]

section Push

variable {Y : Type} [TopologicalSpace Y]

/-- Les `k`-simplexes d'image contenue dans `S`. -/
def inSet (S : Set Y) (k : ℕ) : Set C(Smp k, Y) := {σ | Set.range σ ⊆ S}

theorem comp_incl_injective (S : Set Y) (k : ℕ) :
    Function.Injective (fun τ : C(Smp k, S) ↦ (incl S).comp τ) := by
  intro τ τ' h
  ext x : 1
  exact Subtype.ext (congrArg (fun σ : C(Smp k, Y) ↦ σ x) h)

theorem range_comp_incl (S : Set Y) (k : ℕ) :
    Set.range (fun τ : C(Smp k, S) ↦ (incl S).comp τ) = inSet S k := by
  ext σ
  constructor
  · rintro ⟨τ, rfl⟩
    rintro _ ⟨x, rfl⟩
    exact (τ x).2
  · intro hσ
    exact ⟨⟨fun x ↦ ⟨σ x, hσ ⟨x, rfl⟩⟩, σ.continuous.subtype_mk _⟩, rfl⟩

theorem push_incl_injective (S : Set Y) (k : ℕ) :
    Function.Injective (Sing.push (R := R) (incl S) k) :=
  Finsupp.mapDomain_injective (comp_incl_injective S k)

theorem push_incl_mem (S : Set Y) (k : ℕ) (c : Sing.Ch R k S) :
    Sing.push (incl S) k c ∈ Finsupp.supported R R (inSet S k) := by
  classical
  rw [Sing.push, Finsupp.lmapDomain_apply, Finsupp.mem_supported]
  intro σ hσ
  obtain ⟨τ, -, rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hσ)
  rw [← range_comp_incl]
  exact ⟨τ, rfl⟩

theorem exists_push_incl (S : Set Y) (k : ℕ) {c : Sing.Ch R k Y}
    (hc : c ∈ Finsupp.supported R R (inSet S k)) : ∃ c' : Sing.Ch R k S, Sing.push (incl S) k c' = c := by
  refine ⟨Finsupp.comapDomain _ c (comp_incl_injective S k).injOn, ?_⟩
  rw [Sing.push, Finsupp.lmapDomain_apply, Finsupp.mapDomain_comapDomain _
    (comp_incl_injective S k)]
  rw [range_comp_incl]
  exact hc

/-- `push (incl S) c` est portée par `T` si et seulement si les simplexes de `c` composés avec
l'inclusion sont dans `T`. -/
theorem push_incl_mem_supported_iff (S : Set Y) (k : ℕ) (T : Set C(Smp k, Y)) (c : Sing.Ch R k S) :
    Sing.push (incl S) k c ∈ Finsupp.supported R R T ↔ ∀ τ ∈ c.support, (incl S).comp τ ∈ T := by
  classical
  rw [Sing.push, Finsupp.lmapDomain_apply, Finsupp.mem_supported,
    Finsupp.mapDomain_support_of_injective (comp_incl_injective S k), Finset.coe_image]
  exact Set.image_subset_iff

end Push

section InCx

variable {Y : Type} [TopologicalSpace Y]

/-- Le sous-complexe des chaînes portées par `S`. -/
def inCx (S : Set Y) : SubCx R Y where
  N k := Finsupp.supported R R (inSet S k)
  d_mem k c hc := by
    refine Sing.map_supported _ (fun σ hσ ↦ ?_) hc
    rw [← Sing.push_real_iota σ, ← Sing.push_d]
    rw [Finsupp.mem_supported]
    intro τ hτ
    classical
    rw [Sing.push, Finsupp.lmapDomain_apply] at hτ
    obtain ⟨τ', -, rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hτ)
    rintro _ ⟨x, rfl⟩
    exact hσ ⟨τ' x, rfl⟩

/-- La suite exacte courte `0 → C_•(S) → C_•(Y) → C_•(Y)/C_•(S) → 0`. -/
noncomputable def pairSes (S : Set Y) : ShortComplex (ChainComplex (ModuleCat.{0} R) ℕ) :=
  ShortComplex.mk (gmap R (incl S)) (inCx (R := R) S).proj (by
    ext k c : 3
    exact (Submodule.Quotient.mk_eq_zero _).mpr (push_incl_mem S k c))

theorem pairSes_shortExact (S : Set Y) : (pairSes (R := R) S).ShortExact := by
  refine HomologicalComplex.shortExact_of_degreewise_shortExact _ fun k ↦ ?_
  refine { exact := ?_, mono_f := ?_, epi_g := ?_ }
  · rw [ShortComplex.moduleCat_exact_iff]
    intro c hc
    exact exists_push_incl S k ((Submodule.Quotient.mk_eq_zero _).mp hc)
  · exact (ModuleCat.mono_iff_injective _).mpr (push_incl_injective S k)
  · exact (ModuleCat.epi_iff_surjective _).mpr (Submodule.mkQ_surjective _)

/-- `cokernel (gmap (incl S)) ≅ C_•(Y)/C_•(S)`. -/
noncomputable def gcokIso (S : Set Y) :
    cokernel (gmap R (incl S)) ≅ (inCx (R := R) S).quot :=
  have := (pairSes_shortExact (R := R) S).epi_g
  (cokernelIsCokernel _).coconePointUniqueUpToIso
    ((pairSes_shortExact (R := R) S).exact.gIsCokernel)

theorem π_gcokIso (S : Set Y) :
    cokernel.π (gmap R (incl S)) ≫ (gcokIso (R := R) S).hom = (inCx (R := R) S).proj := by
  have := (pairSes_shortExact (R := R) S).epi_g
  exact (cokernelIsCokernel _).comp_coconePointUniqueUpToIso_hom
    ((pairSes_shortExact (R := R) S).exact.gIsCokernel) WalkingParallelPair.one

/-- `RelChains R Y S ≅ C_•(Y)/C_•(S)`. -/
noncomputable def relIso (Y : Type) [TopologicalSpace Y] (S : Set Y) :
    RelChains R Y S ≅ (inCx (R := R) S).quot :=
  cokernel.mapIso _ (gmap R (incl S)) (cgIso R S) (cgIso R Y) (chainsMap_comp_cgIso _) ≪≫
    gcokIso S

@[reassoc]
theorem π_relIso (S : Set Y) :
    cokernel.π (chainsMap (R := R) (incl S)) ≫ (relIso (R := R) Y S).hom =
      (cgIso R Y).hom ≫ (inCx (R := R) S).proj := by
  show cokernel.π (chainsMap (R := R) (incl S)) ≫
      (cokernel.map _ (gmap R (incl S)) (cgIso R S).hom (cgIso R Y).hom
        (chainsMap_comp_cgIso _) ≫ (gcokIso S).hom) = _
  rw [← Category.assoc, cokernel.π_desc, Category.assoc, π_gcokIso]

end InCx

section QuotMap

variable {Y Y' : Type} [TopologicalSpace Y] [TopologicalSpace Y']

theorem push_mem_inSet (f : C(Y, Y')) {S : Set Y} {S' : Set Y'} (h : Set.MapsTo f S S') (k : ℕ)
    {c : Sing.Ch R k Y} (hc : c ∈ Finsupp.supported R R (inSet S k)) :
    Sing.push f k c ∈ Finsupp.supported R R (inSet S' k) := by
  refine Sing.map_supported _ (fun σ hσ ↦ ?_) hc
  rw [Sing.push_single, Finsupp.mem_supported]
  intro τ hτ
  rw [Finset.mem_singleton.mp (Finsupp.support_single_subset (Finset.mem_coe.mp hτ))]
  rintro _ ⟨x, rfl⟩
  exact h (hσ ⟨x, rfl⟩)

/-- Le morphisme de quotients `C_•(Y)/C_•(S) → C_•(Y')/C_•(S')` induit par `f`. -/
noncomputable def quotMap (f : C(Y, Y')) (S : Set Y) (S' : Set Y') (h : Set.MapsTo f S S') :
    (inCx (R := R) S).quot ⟶ (inCx (R := R) S').quot :=
  ChainComplex.ofHom
    (fun k ↦ ModuleCat.ofHom (((inCx (R := R) S).N k).mapQ ((inCx (R := R) S').N k) (Sing.push f k)
      (fun c hc ↦ push_mem_inSet f h k hc)))
    (fun k ↦ by
      rw [SubCx.quot_d, SubCx.quot_d]
      refine ModuleCat.hom_ext (Submodule.linearMap_qext _ (LinearMap.ext fun c ↦ ?_))
      change Submodule.Quotient.mk (Sing.d k (Sing.push f (k + 1) c)) =
        Submodule.Quotient.mk (Sing.push f k (Sing.d k c))
      rw [Sing.push_d])

theorem proj_quotMap (f : C(Y, Y')) (S : Set Y) (S' : Set Y') (h : Set.MapsTo f S S') :
    (inCx (R := R) S).proj ≫ quotMap f S S' h = gmap R f ≫ (inCx (R := R) S').proj := by
  ext k c : 3
  rfl

/-- **Compatibilité** du `cokernel.map` de `relMap` avec `quotMap`. -/
theorem relMap_compat (f : C(Y, Y')) (S : Set Y) (S' : Set Y') (h : Set.MapsTo f S S') :
    cokernel.map _ _ (chainsMap (R := R) (restrictPair f S S' h)) (chainsMap f)
        (incl_comp_restrictPair R f S S' h) ≫ (relIso (R := R) Y' S').hom =
      (relIso (R := R) Y S).hom ≫ quotMap f S S' h := by
  rw [← cancel_epi (cokernel.π (chainsMap (R := R) (incl S))), cokernel.π_desc_assoc, Category.assoc, π_relIso,
    π_relIso_assoc, proj_quotMap, chainsMap_comp_cgIso_assoc]

end QuotMap

end Hatcher.Singular

end

/-! ## Recopié de `Bridge/Singular/Excision.lean` -/

section

/-!
# Théorème d'excision (A1, étape 8 ; Hatcher, Théorème 2.20)

Soient `Z ⊆ A ⊆ X` avec `closure Z ⊆ interior A`, `B = X ∖ Z` et `A' = A ∩ B`. Les intérieurs de `A`
et `B` recouvrent `X`. On note `C^{A,B}` les petites chaînes (simplexes contenus dans `A` ou dans
`B`). La suite de complexes
`0 → C(B)/C(A') --Φ--> C(X)/C(A) --Ψ--> C(X)/C^{A,B} → 0`
est exacte, et son troisième terme est acyclique (Hatcher 2.21). `Φ` est donc un
quasi-isomorphisme. Or `Φ` correspond au `relMap` de l'énoncé (`relMap_compat`), d'où
l'excision, sans recourir au lemme des cinq.
-/

open CategoryTheory Limits

namespace Hatcher.Singular

variable {R : Type} [Ring R] {X : Type} [TopologicalSpace X]

section

variable (A B : Set X)

/-- Le recouvrement `{A, B}`. -/
def pairCover : Bool → Set X := fun b ↦ if b then A else B

theorem inSet_subset_small_left (k : ℕ) : inSet A k ⊆ Sing.small (pairCover A B) k :=
  fun _ hσ ↦ ⟨true, hσ⟩

theorem inSet_subset_small_right (k : ℕ) : inSet B k ⊆ Sing.small (pairCover A B) k :=
  fun _ hσ ↦ ⟨false, hσ⟩

theorem small_pairCover (k : ℕ) :
    Sing.small (pairCover A B) k = inSet A k ∪ inSet B k := by
  ext σ
  constructor
  · rintro ⟨b, hb⟩
    cases b
    · exact Or.inr hb
    · exact Or.inl hb
  · rintro (h | h)
    · exact ⟨true, h⟩
    · exact ⟨false, h⟩

/-- `Ψ : C(X)/C(A) → C(X)/C^{A,B}`. -/
noncomputable def toSmallQuot : (inCx (R := R) A).quot ⟶ (smallCx (R := R) (pairCover A B)).quot :=
  ChainComplex.ofHom
    (fun k ↦ ModuleCat.ofHom (((inCx (R := R) A).N k).mapQ ((smallCx (R := R) (pairCover A B)).N k)
      LinearMap.id (Finsupp.supported_mono (inSet_subset_small_left A B k))))
    (fun k ↦ by
      rw [SubCx.quot_d, SubCx.quot_d]
      refine ModuleCat.hom_ext (Submodule.linearMap_qext _ (LinearMap.ext fun c ↦ ?_))
      rfl)

end

section Excision

variable (A Z : Set X)

/-- `A' = A ∖ Z`, partie de `X ∖ Z`. -/
abbrev A' : Set (Zᶜ : Set X) := Subtype.val ⁻¹' A

/-- `Φ : C(X∖Z)/C(A∖Z) → C(X)/C(A)`. -/
noncomputable abbrev excPhi : (inCx (R := R) (A' A Z)).quot ⟶ (inCx (R := R) A).quot :=
  quotMap (incl Zᶜ) (A' A Z) A (fun _ hx ↦ hx)

/-- La suite courte `0 → C(B)/C(A') → C(X)/C(A) → C(X)/C^{A,B} → 0`. -/
noncomputable def excSes : ShortComplex (ChainComplex (ModuleCat.{0} R) ℕ) :=
  ShortComplex.mk (excPhi (R := R) A Z) (toSmallQuot A Zᶜ) (by
    ext k c : 3
    obtain ⟨c, rfl⟩ := Submodule.Quotient.mk_surjective _ c
    change Submodule.Quotient.mk (Sing.push (incl Zᶜ) k c) = 0
    refine (Submodule.Quotient.mk_eq_zero _).mpr ?_
    exact Finsupp.supported_mono (inSet_subset_small_right A Zᶜ k) (push_incl_mem _ k c))

theorem excSes_shortExact : (excSes (R := R) A Z).ShortExact := by
  refine HomologicalComplex.shortExact_of_degreewise_shortExact _ fun k ↦ ?_
  refine { exact := ?_, mono_f := ?_, epi_g := ?_ }
  · rw [ShortComplex.moduleCat_exact_iff]
    intro x hx
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    have hy : y ∈ Finsupp.supported R R (Sing.small (pairCover A Zᶜ) k) :=
      (Submodule.Quotient.mk_eq_zero _).mp hx
    rw [small_pairCover, Finsupp.supported_union, Submodule.mem_sup] at hy
    obtain ⟨a, ha, b, hb, rfl⟩ := hy
    obtain ⟨b', rfl⟩ := exists_push_incl Zᶜ k hb
    refine ⟨Submodule.Quotient.mk b', ?_⟩
    change Submodule.Quotient.mk (Sing.push (incl Zᶜ) k b') = Submodule.Quotient.mk _
    rw [Submodule.Quotient.eq]
    have e : Sing.push (incl Zᶜ) k b' - (a + Sing.push (incl Zᶜ) k b') = -a := by abel
    rw [e]
    exact neg_mem ha
  · rw [ModuleCat.mono_iff_injective]
    refine (injective_iff_map_eq_zero _).mpr fun x hx ↦ ?_
    obtain ⟨c, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    change Submodule.Quotient.mk (Sing.push (incl Zᶜ) k c) = 0 at hx
    have hc : Sing.push (incl Zᶜ) k c ∈ Finsupp.supported R R (inSet A k) :=
      (Submodule.Quotient.mk_eq_zero _).mp hx
    rw [push_incl_mem_supported_iff] at hc
    refine (Submodule.Quotient.mk_eq_zero _).mpr ?_
    change c ∈ Finsupp.supported R R (inSet (A' A Z) k)
    rw [Finsupp.mem_supported]
    intro τ hτ
    rintro _ ⟨x, rfl⟩
    exact hc τ hτ ⟨x, rfl⟩
  · rw [ModuleCat.epi_iff_surjective]
    intro x
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    exact ⟨Submodule.Quotient.mk y, rfl⟩

theorem pairCover_interior (hZA : closure Z ⊆ interior A) :
    ∀ x, ∃ i, x ∈ interior (pairCover A Zᶜ i) := by
  intro x
  by_cases hx : x ∈ closure Z
  · exact ⟨true, hZA hx⟩
  · refine ⟨false, ?_⟩
    rw [pairCover, if_neg Bool.false_ne_true, interior_compl]
    exact hx

theorem excPhi_quasiIso (hZA : closure Z ⊆ interior A) : QuasiIso (excPhi (R := R) A Z) :=
  quasiIso_f_of_acyclic (S := excSes (R := R) A Z) (excSes_shortExact A Z)
    ((smallCx (pairCover A Zᶜ)).acyclic_quot
      (fun _ z hz ↦ Sing.exists_sub_d_mem_small (pairCover_interior A Z hZA) z hz)
      (fun z ↦ Sing.mem_small_zero (pairCover_interior A Z hZA) z))

end Excision

/-- **Théorème d'excision** (Hatcher 2.20). -/
theorem excision_proof (R : Type) [Ring R] (X : Type) [TopologicalSpace X] (A Z : Set X)
    (hZA : closure Z ⊆ interior A) (n : ℕ) :
    IsIso (relMap R n (incl Zᶜ) (Subtype.val ⁻¹' A : Set (Zᶜ : Set X)) A
      (fun _ hx ↦ hx)) := by
  have hcompat := relMap_compat (R := R) (incl Zᶜ) (A' A Z) A (fun _ hx ↦ hx)
  have hΦ := excPhi_quasiIso (R := R) A Z hZA
  set F := cokernel.map _ _ (chainsMap (R := R) (restrictPair (incl Zᶜ) (A' A Z) A
    (fun _ hx ↦ hx))) (chainsMap (incl Zᶜ)) (incl_comp_restrictPair R (incl Zᶜ) (A' A Z) A
    (fun _ hx ↦ hx)) with hF
  have hF' : F = (relIso (R := R) _ (A' A Z)).hom ≫ excPhi A Z ≫ (relIso (R := R) X A).inv := by
    rw [← Category.assoc, ← hcompat, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have : QuasiIso F := by
    rw [hF']
    infer_instance
  exact (quasiIsoAt_iff_isIso_homologyMap F n).mp inferInstance


end Hatcher.Singular

end

/-! ## Solution (statement copied verbatim) -/

open CategoryTheory

namespace Hatcher.Singular

theorem _root_.solution (R : Type) [Ring R] (X : Type) [TopologicalSpace X] (A Z : Set X)
    (hZA : closure Z ⊆ interior A) (n : ℕ) :
    IsIso (relMap R n (incl Zᶜ) (Subtype.val ⁻¹' A : Set (Zᶜ : Set X)) A
      (fun _ hx ↦ hx)) :=
  excision_proof R X A Z hZA n

end Hatcher.Singular
