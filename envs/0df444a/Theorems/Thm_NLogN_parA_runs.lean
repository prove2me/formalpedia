variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem NLogN.parA_runs (pP : Fin P) (hP : iprog pP = pow2Body pP) (s : IState NS) (N : ℕ)
    (LP : List Item) (hB : fmB N ≤ fmL N / 2) (hPRM : s.G PRM = .int N :: LP) :
    IRuns I iprog (parA pP) s
      (((s.upd ZZ (.int (fmL N) :: s.G ZZ)).upd T1 (.int (fmK N) :: s.G T1)).upd DL
        (.int (2 ^ fmK N) :: s.G DL))
      (1000 * (fmL N + 1) ^ 2 + 1000 * (fmB N + 1) ^ 2 + 30000 * (fmL N + 3)) := by sorry
