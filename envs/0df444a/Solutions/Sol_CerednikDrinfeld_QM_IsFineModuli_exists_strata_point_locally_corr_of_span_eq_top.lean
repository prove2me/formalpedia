      rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      change Spec.map (CommRingCat.ofHom ((algebraMap Abar (Bbar i)).comp (Ideal.Quotient.mk (GPShift.Wrap.I ϖ A)))) ≫ t₀ = _
      rw [GPShift.Wrap.algebraMap_quot_comp_mk ϖ A (B i), CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, ht₀t, hx i]
    rw [hR, ← Category.assoc]
    refine GPShift.Wrap.comp_ξ_eq_of_locCorr 𝒪 π Onr Λ hΛℤ A₀ n M fM C ψ X ξ ptX hM hxM (Bbar i) e (d i) _ _ ?_ (hxC i) (hloc i)
    rw [Category.assoc, hx₀C, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
  refine ⟨e, x₀, hx₀M, fun i τ hτ => ?_⟩

  have hτ' : τ = algebraMap Abar (Bbar i) :=
    Ideal.Quotient.ringHom_ext (hτ.trans (GPShift.Wrap.algebraMap_quot_comp_mk ϖ A (B i)).symm)
  rw [hτ']
  exact hloc i

