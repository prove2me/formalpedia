-- title:
--   Proposition 2.2 — normaliser of the right regular subgroup
-- statement:
--   Let $\Gamma=\operatorname{BiCay}(H,R,L,S)$ be connected. Let $R(H)$ act by right multiplication and let $N$ be its normaliser in $\operatorname{Aut}(\Gamma)$. The permutations $\sigma_{\alpha,g}$ satisfying the paper’s condition $F$, and the permutations $\delta_{\alpha,x,y}$ satisfying condition $I$, are members of $N$. Conversely, every member of $N$ is one of these permutations composed with an element of $R(H)$. For every $\delta_{\alpha,x,y}\in I$, the subgroup generated by it and $R(H)$ is vertex transitive.
--
--   $$
--   N=R(H)\langle F,I\rangle,\qquad \langle R(H),\delta_{\alpha,x,y}\rangle\text{ acts transitively on }V(\Gamma).
--   $$
--
--   This identifies the automorphisms used in the two later propositions.
--
--   **Formalization Note** The statement expresses the normaliser equality elementwise, avoiding an ambiguous order for permutation multiplication. Proposition 2.2(b), the Cayley graph isomorphism, is omitted because this mission does not use it.
-- source:
--   Conder, Zhou, Feng and Zhang, Edge-transitive bi-Cayley graphs, arXiv:1606.04625v1, p. 5, Proposition 2.2, first sentence and (a)

import Mathlib
import Definitions.Def_EdgeTransBiCayley_BiAbelian_Setting
open Pointwise

namespace EdgeTransBiCayley.BiAbelian

/-- Proposition 2.2, p. 5: the normaliser consists of R(H) with the F and I automorphisms.
The Cayley-graph isomorphism in its separate clause (b) is outside this milestone. -/
theorem proposition_2_2 {H : Type*} [Group H] [Fintype H] [DecidableEq H]
    (D : BiCayData H) (hconn : D.graph.Connected) :
    (∀ α : MulAut H, ∀ g : H, IsF D α g →
      ∃ φ : D.graph ≃g D.graph, φ ∈ normRH D ∧
        ∀ v, φ v = sigmaPerm α g v) ∧
    (∀ α : MulAut H, ∀ x y : H, IsI D α x y →
      ∃ φ : D.graph ≃g D.graph, φ ∈ normRH D ∧
        ∀ v, φ v = deltaPerm α x y v) ∧
    (∀ φ : D.graph ≃g D.graph, φ ∈ normRH D →
      (∃ (h g : H) (α : MulAut H), IsF D α g ∧
        ∀ v, φ v = sigmaPerm α g (rightMul D h v)) ∨
      (∃ (h x y : H) (α : MulAut H), IsI D α x y ∧
        ∀ v, φ v = deltaPerm α x y (rightMul D h v))) ∧
    (∀ α : MulAut H, ∀ x y : H, IsI D α x y →
      ∃ δ : D.graph ≃g D.graph,
        (∀ v, δ v = deltaPerm α x y v) ∧
        IsVertexTransitiveOn D.graph
          (Subgroup.closure (Set.insert δ (Set.range (rightMul D))))) := by sorry
end EdgeTransBiCayley.BiAbelian
