section DisjLocus

variable {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
  (L : RelativeGroupLaw R f) (n : ℕ)

theorem isOpenImmersion_oneK [Etale (L.schemeKerStr n)] : IsOpenImmersion (KerOps.oneK L n) := by
  haveI : Mono (KerOps.oneK L n) := by
    haveI : Mono (KerOps.oneK L n ≫ L.schemeKerStr n) := by rw [KerOps.oneK_str]; infer_instance
    exact mono_of_mono (KerOps.oneK L n) (L.schemeKerStr n)
  haveI : Etale (KerOps.oneK L n) := by
    haveI : Etale (KerOps.oneK L n ≫ L.schemeKerStr n) := by rw [KerOps.oneK_str]; infer_instance
    exact Etale.of_comp (KerOps.oneK L n) (L.schemeKerStr n)
  exact IsOpenImmersion.of_flat_of_mono _

theorem isClosedImmersion_oneK [IsFinite (L.schemeKerStr n)] : IsClosedImmersion (KerOps.oneK L n) := by
  haveI : IsClosedImmersion (KerOps.oneK L n ≫ L.schemeKerStr n) := by rw [KerOps.oneK_str]; infer_instance
  exact IsClosedImmersion.of_comp (KerOps.oneK L n) (L.schemeKerStr n)

theorem isClopen_range_oneK [IsFinite (L.schemeKerStr n)] [Etale (L.schemeKerStr n)] :
    IsClopen (Set.range (KerOps.oneK L n).base) :=
  haveI := isOpenImmersion_oneK L n
  haveI := isClosedImmersion_oneK L n
  ⟨(KerOps.oneK L n).isClosedEmbedding.isClosed_range, (KerOps.oneK L n).isOpenEmbedding.isOpen_range⟩

def locDisj (U V : Set ↥(L.schemeKer n)) : Set ↥(Spec (CommRingCat.of R)) :=
  ((L.schemeKerStr n).base '' ((U ∩ V) \ Set.range (KerOps.oneK L n).base))ᶜ

theorem isClopen_locDisj [IsFinite (L.schemeKerStr n)] [Etale (L.schemeKerStr n)] (U V : Set ↥(L.schemeKer n))
    (hU : IsClopen U) (hV : IsClopen V) : IsClopen (locDisj L n U V) := by
  unfold locDisj
  exact (Loci.isClopen_image _ _ ((hU.inter hV).diff (isClopen_range_oneK L n))).compl

theorem eq_oneK_of_locDisj [Etale (L.schemeKerStr n)] (U V : Set ↥(L.schemeKer n))
    (h : ∀ t : ↥(Spec (CommRingCat.of R)), t ∈ locDisj L n U V)
    {T : Scheme.{0}} (x : T ⟶ L.schemeKer n) (hxU : Set.range x.base ⊆ U) (hxV : Set.range x.base ⊆ V) :
    x = (x ≫ L.schemeKerStr n) ≫ KerOps.oneK L n := by
  have hr : Set.range x.base ⊆ Set.range (KerOps.oneK L n).base := by
    rintro _ ⟨τ, rfl⟩
    by_contra hτ
    have h' := h ((L.schemeKerStr n).base (x.base τ))
    rw [locDisj, Set.mem_compl_iff] at h'
    exact h' ⟨x.base τ, ⟨⟨hxU ⟨τ, rfl⟩, hxV ⟨τ, rfl⟩⟩, hτ⟩, rfl⟩
  haveI := isOpenImmersion_oneK L n
  set y := IsOpenImmersion.lift (KerOps.oneK L n) x hr with hy
  have hfac : y ≫ KerOps.oneK L n = x := IsOpenImmersion.lift_fac _ _ _
  have hy' : y = x ≫ L.schemeKerStr n := by
    rw [← hfac, Category.assoc, KerOps.oneK_str, Category.comp_id]
  rw [← hy', hfac]

theorem locDisj_of_forall (U V : Set ↥(L.schemeKer n)) (W : (L.schemeKer n).Opens) (hW : (W : Set ↥(L.schemeKer n)) = U ∩ V)
    (h : W.ι = (W.ι ≫ L.schemeKerStr n) ≫ KerOps.oneK L n) (t : ↥(Spec (CommRingCat.of R))) : t ∈ locDisj L n U V := by
  rw [locDisj, Set.mem_compl_iff]
  rintro ⟨w, ⟨hwS, hwU⟩, _⟩
  rw [← hW, ← Scheme.Opens.range_ι W] at hwS
  obtain ⟨w', rfl⟩ := hwS
  apply hwU
  refine ⟨(W.ι ≫ L.schemeKerStr n).base w', ?_⟩
  conv_rhs => rw [h]
  rfl

theorem locDisj_transfer {R₂ : Type} [CommRing R₂] (ψ : R →+* R₂)
    {A₂ : Scheme.{0}} {f₂ : A₂ ⟶ Spec (CommRingCat.of R₂)} (L₂ : RelativeGroupLaw R₂ f₂)
    (kN : L₂.schemeKer n ⟶ L.schemeKer n)
    (hkN : IsPullback kN (L₂.schemeKerStr n) (L.schemeKerStr n) (Spec.map (CommRingCat.ofHom ψ)))
    (hone : Spec.map (CommRingCat.ofHom ψ) ≫ KerOps.oneK L n = KerOps.oneK L₂ n ≫ kN)
    (U V : Set ↥(L.schemeKer n)) :
    (Spec.map (CommRingCat.ofHom ψ)).base ⁻¹' locDisj L n U V = locDisj L₂ n (kN.base ⁻¹' U) (kN.base ⁻¹' V) := by

  have htop : IsPullback (Spec.map (CommRingCat.ofHom ψ)) (KerOps.oneK L₂ n) (KerOps.oneK L n) kN := by
    refine IsPullback.of_bot ?_ hone hkN
    rw [KerOps.oneK_str, KerOps.oneK_str]
    exact IsPullback.of_vert_isIso ⟨by simp⟩
  have hr : kN.base ⁻¹' Set.range (KerOps.oneK L n).base = Set.range (KerOps.oneK L₂ n).base := by
    have := Transfer.preimage_image_eq htop Set.univ
    simpa only [Set.image_univ, Set.preimage_univ] using this
  simp only [locDisj, Set.preimage_compl, Transfer.preimage_image_eq hkN, Set.preimage_diff, Set.preimage_inter, hr]

end DisjLocus
