section Nil

variable {R : Type} [CommRing R] {C : Type} [CommRing C] [Algebra R C]

theorem isAdicComplete_of_pow_eq_bot (J : Ideal C) {M : ℕ} (hM : J ^ M = ⊥) : IsAdicComplete J C := by
  haveI : IsHausdorff J C := ⟨fun x hx => by
    have := hx M
    rw [hM] at this
    simpa [SModEq.zero] using this⟩
  haveI : IsPrecomplete J C := ⟨fun {f} hf => ⟨f M, fun m => by
    by_cases hm : m ≤ M
    · exact hf hm
    · push Not at hm
      have h1 : f M ≡ f m [SMOD (J ^ M • ⊤ : Submodule C C)] := hf hm.le
      have h2 : (J ^ m • ⊤ : Submodule C C) = ⊥ := by
        rw [show m = M + (m - M) by omega, pow_add, hM, Ideal.bot_mul]; simp
      have h3 : (J ^ M • ⊤ : Submodule C C) = ⊥ := by rw [hM]; simp
      rw [h2]; rw [h3] at h1
      exact h1.symm⟩⟩
  exact ⟨⟩

theorem isNilpotent_of_mem {J : Ideal C} {n : ℕ} (hJ : J ^ (n + 1) = ⊥) {x : C} (hx : x ∈ J) : IsNilpotent x := by
  refine ⟨n + 1, ?_⟩
  have : x ^ (n + 1) ∈ J ^ (n + 1) := Ideal.pow_mem_pow hx _
  rw [hJ] at this
  exact (Submodule.mem_bot C).1 this

theorem nilEval_mem {σ : Type} [Fintype σ] [DecidableEq σ] (J : Ideal C) (n : ℕ)
    (φ : MvPowerSeries σ R) (hφ : constantCoeff φ = 0) (s : σ → C) (hs : ∀ i, s i ∈ J) :
    MvFormalGroup.nilEval n φ s ∈ J := by
  classical
  unfold MvFormalGroup.nilEval
  rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq]
  refine Ideal.sum_mem _ fun d _ => ?_
  by_cases hd : d = 0
  · subst hd
    have : MvPolynomial.coeff 0 (MvPowerSeries.trunc' R (Finsupp.equivFunOnFinite.symm fun _ => n) φ) = 0 := by
      rw [MvPowerSeries.coeff_trunc', if_pos (show (0 : σ →₀ ℕ) ≤ Finsupp.equivFunOnFinite.symm (fun _ => n) from bot_le),
        MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hφ]
    rw [this, map_zero, zero_mul]
    exact Ideal.zero_mem _
  · obtain ⟨i, hi⟩ : ∃ i, d i ≠ 0 := by
      by_contra hcon
      push Not at hcon
      exact hd (Finsupp.ext hcon)
    have hmem : i ∈ d.support := Finsupp.mem_support_iff.mpr hi
    refine Ideal.mul_mem_left _ _ ?_
    rw [← Finset.mul_prod_erase _ _ hmem]
    refine Ideal.mul_mem_right _ _ ?_
    exact Ideal.pow_mem_of_mem J (hs i) _ (Nat.pos_of_ne_zero hi)

theorem nilEval_X {σ : Type} [Fintype σ] [DecidableEq σ] (J : Ideal C) (n : ℕ) (hJ : J ^ (n + 1) = ⊥)
    (s : σ → C) (hs : ∀ i, s i ∈ J) (i : σ) :
    MvFormalGroup.nilEval n (MvPowerSeries.X i : MvPowerSeries σ R) s = s i := by
  rw [MvFormalGroup.nilEval_eq_adicEval_of_pow_succ_eq_bot J n hJ _ s hs, MvFormalGroup.adicEval_X]

theorem nilEval_subst {σ τ : Type} [Fintype σ] [DecidableEq σ] [Fintype τ] [DecidableEq τ]
    (J : Ideal C) (n : ℕ) (hJ : J ^ (n + 1) = ⊥)
    (a : τ → MvPowerSeries σ R) (ha : ∀ j, constantCoeff (a j) = 0)
    (f : MvPowerSeries τ R) (x : σ → C) (hx : ∀ i, x i ∈ J) :
    MvFormalGroup.nilEval n (subst a f) x = MvFormalGroup.nilEval n f (fun j => MvFormalGroup.nilEval n (a j) x) := by
  haveI : IsAdicComplete J C := isAdicComplete_of_pow_eq_bot J hJ
  have hxr : ∀ i, x i ∈ J.radical := fun i => Ideal.le_radical (hx i)
  have hmem : ∀ j, MvFormalGroup.nilEval n (a j) x ∈ J := fun j => nilEval_mem J n (a j) (ha j) x hx
  rw [MvFormalGroup.nilEval_eq_adicEval_of_pow_succ_eq_bot J n hJ _ x hx,
    MvFormalGroup.adicEval_subst J hxr (hasSubst_of_constantCoeff_zero ha) f,
    MvFormalGroup.nilEval_eq_adicEval_of_pow_succ_eq_bot J n hJ f _ hmem]
  congr 1
  funext j
  exact (MvFormalGroup.nilEval_eq_adicEval_of_pow_succ_eq_bot J n hJ (a j) x hx).symm

end Nil

theorem nilEval_map_of_isScalarTower {σ : Type} [Fintype σ] [DecidableEq σ]
    {B B₀ B'' : Type} [CommRing B] [CommRing B₀] [CommRing B''] [Algebra B B₀] [Algebra B B''] [Algebra B₀ B'']
    [IsScalarTower B B₀ B''] (n : ℕ) (ψ : MvPowerSeries σ B) (a : σ → B'') :
    MvFormalGroup.nilEval n (MvPowerSeries.map (algebraMap B B₀) ψ) a = MvFormalGroup.nilEval n ψ a := by
  unfold MvFormalGroup.nilEval
  have htr : ∀ bnd : σ →₀ ℕ, MvPowerSeries.trunc' B₀ bnd (MvPowerSeries.map (algebraMap B B₀) ψ) =
      MvPolynomial.map (algebraMap B B₀) (MvPowerSeries.trunc' B bnd ψ) := by
    intro bnd
    ext m
    rw [MvPowerSeries.coeff_trunc', MvPolynomial.coeff_map, MvPowerSeries.coeff_trunc']
    split_ifs
    · exact MvPowerSeries.coeff_map _ m ψ
    · exact (map_zero _).symm
  rw [htr, MvPolynomial.aeval_map_algebraMap]

section Act

variable {B : Type} [CommRing B] {C : Type} [CommRing C] [Algebra B C]

def ap (n : ℕ) (ψ : Series B) (x : Fin 2 → C) : Fin 2 → C := fun i => MvFormalGroup.nilEval n (ψ i) x

variable (J : Ideal C) (n : ℕ)

theorem ap_mem (ψ : Series B) (hψ : ∀ i, constantCoeff (ψ i) = 0) (x : Fin 2 → C) (hx : ∀ i, x i ∈ J) (i : Fin 2) :
    ap n ψ x i ∈ J :=
  nilEval_mem J n _ (hψ i) x hx

theorem ap_id (hJ : J ^ (n + 1) = ⊥) (x : Fin 2 → C) (hx : ∀ i, x i ∈ J) : ap n (Series.id B) x = x :=
  funext fun i => nilEval_X J n hJ x hx i

theorem ap_comp (hJ : J ^ (n + 1) = ⊥) (ψ φ : Series B) (hφ : ∀ i, constantCoeff (φ i) = 0)
    (x : Fin 2 → C) (hx : ∀ i, x i ∈ J) : ap n (ψ.comp φ) x = ap n ψ (ap n φ x) :=
  funext fun i => nilEval_subst J n hJ φ hφ (ψ i) x hx

theorem ap_addVia (hJ : J ^ (n + 1) = ⊥) (F : MvFormalGroup 2 B) (φ ψ : Series B)
    (hφ : ∀ i, constantCoeff (φ i) = 0) (hψ : ∀ i, constantCoeff (ψ i) = 0)
    (x : Fin 2 → C) (hx : ∀ i, x i ∈ J) : ap n (Series.addVia F φ ψ) x = F.nilMul n (ap n φ x) (ap n ψ x) := by
  funext i
  show MvFormalGroup.nilEval n (subst (Sum.elim φ ψ) (F.toPowerSeries i)) x =
    MvFormalGroup.nilEval n (F.toPowerSeries i) (Sum.elim (ap n φ x) (ap n ψ x))
  have h0 : ∀ c, constantCoeff (Sum.elim φ ψ c) = 0 := by
    rintro (j | j)
    exacts [hφ j, hψ j]
  rw [nilEval_subst J n hJ (Sum.elim φ ψ) h0 (F.toPowerSeries i) x hx]
  congr 1
  funext c
  rcases c with j | j <;> rfl

end Act

section Rho

variable {B : Type} [CommRing B] {q : ℕ} [Fact q.Prime] (X : FormalODModule q B)

def rho (c : Zp2 q × Zp2 q) : MvFormalGroup.End X.F := X.actRingHom c.1 + X.actRingHom c.2 * X.varpiEnd

theorem toPowerSeries_rho (c : Zp2 q × Zp2 q) :
    MvFormalGroup.Hom.toPowerSeries (rho X c) = Series.addVia X.F (X.act c.1) ((X.act c.2).comp X.varpi) := rfl

theorem constantCoeff_rho (c : Zp2 q × Zp2 q) (i : Fin 2) :
    constantCoeff (MvFormalGroup.Hom.toPowerSeries (rho X c) i) = 0 :=
  MvFormalGroup.Hom.constantCoeff_eq_zero _ i

theorem rho_one_zero : rho X ((1 : Zp2 q), (0 : Zp2 q)) = 1 := by
  simp only [rho, map_one, map_zero, zero_mul, add_zero]

theorem rho_add (c d : Zp2 q × Zp2 q) : rho X (c + d) = rho X c + rho X d := by
  simp only [rho, Prod.fst_add, Prod.snd_add, map_add, add_mul]
  abel

theorem rho_mul (c d : Zp2 q × Zp2 q) :
    rho X (c.1 * d.1 + (q : Zp2 q) * (c.2 * WittVector.frobenius d.2), c.1 * d.2 + c.2 * WittVector.frobenius d.1) =
      rho X c * rho X d := by
  have h1 : ∀ a : Zp2 q, X.varpiEnd * X.actRingHom a = X.actRingHom (WittVector.frobenius a) * X.varpiEnd :=
    fun a => X.varpiEnd_mul_actEnd a
  have h2 : X.varpiEnd * X.varpiEnd = X.actRingHom (q : Zp2 q) := X.varpiEnd_mul_varpiEnd
  simp only [rho, map_add, map_mul]
  have key : (X.actRingHom c.1 + X.actRingHom c.2 * X.varpiEnd) * (X.actRingHom d.1 + X.actRingHom d.2 * X.varpiEnd) =
      X.actRingHom c.1 * X.actRingHom d.1 + X.actRingHom c.1 * X.actRingHom d.2 * X.varpiEnd +
        X.actRingHom c.2 * (X.varpiEnd * X.actRingHom d.1) +
        X.actRingHom c.2 * (X.varpiEnd * X.actRingHom d.2) * X.varpiEnd := by
    noncomm_ring
  rw [key, h1, h1, mul_assoc (X.actRingHom c.2) (X.actRingHom (WittVector.frobenius d.2) * X.varpiEnd) X.varpiEnd,
    mul_assoc (X.actRingHom (WittVector.frobenius d.2)) X.varpiEnd X.varpiEnd, h2]
  have hc : X.actRingHom c.2 * (X.actRingHom (WittVector.frobenius d.2) * X.actRingHom (q : Zp2 q)) =
      X.actRingHom (q : Zp2 q) * (X.actRingHom c.2 * X.actRingHom (WittVector.frobenius d.2)) := by
    rw [← map_mul, ← map_mul, ← map_mul, ← map_mul]
    congr 1
    ring
  rw [hc]
  noncomm_ring

end Rho

section Pts

variable {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}

theorem mapPt_id' {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f) (h : 𝟙 A ≫ f = f) :
    mapPt (𝟙 A) h P = P :=
  Subtype.ext (Category.comp_id _)

theorem mapPt_comp' (φ ψ : A ⟶ A) (hφ : φ ≫ f = f) (hψ : ψ ≫ f = f)
    {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f) (hφψ : (φ ≫ ψ) ≫ f = f) :
    mapPt (φ ≫ ψ) hφψ P = mapPt ψ hψ (mapPt φ hφ P) :=
  Subtype.ext (Category.assoc _ _ _).symm

theorem mul_mul_mul_comm' (L : RelativeGroupLaw R f) (hc : L.IsCommutative)
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (a b c d : SchemeHomOver t f) :
    L.mul t (L.mul t a b) (L.mul t c d) = L.mul t (L.mul t a c) (L.mul t b d) := by
  rw [L.mul_assoc, L.mul_assoc, ← L.mul_assoc t b c d, hc t b c, L.mul_assoc]

end Pts

section Main

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {q : ℕ} [Fact q.Prime]

def LiftSpec {B B₀ : Type} [CommRing B] [CommRing B₀] [Algebra B B₀]
    {A₀ : Scheme.{0}} {f₀ : A₀ ⟶ Spec (CommRingCat.of B₀)} {L₀ : RelativeGroupLaw B₀ f₀}
    (D : BareDeformation f₀ L₀ B) (X : FormalODModule q B) (θ : RelativeGroupLaw.FormalCoordinates D.f 2)
    (φ₀ : A₀ ⟶ A₀) (c : Zp2 q × Zp2 q) (φ : D.A ⟶ D.A) : Prop :=
  D.g ≫ φ = φ₀ ≫ D.g ∧
    ∃ hφ : φ ≫ D.f = D.f,
      (∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t D.f),
        mapPt φ hφ (D.L.mul t P Q) = D.L.mul t (mapPt φ hφ P) (mapPt φ hφ Q)) ∧
      (∀ (B'' : Type) [CommRing B''] [Algebra B B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
        ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
          (θ B'' s).1 ≫ φ =
            (θ B'' (fun i => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X c) i) s)).1)

theorem actSeries_map {B B₀ : Type} [CommRing B] [CommRing B₀] (π : B →+* B₀) (X : FormalODModule q B) (α β : Zp2 q) :
    Series.addVia (X.map π).F ((X.map π).act α) (((X.map π).act β).comp (X.map π).varpi) =
      (Series.addVia X.F (X.act α) ((X.act β).comp X.varpi)).map π := by
  rw [Series.map_addVia π X.F _ _ (X.isLawHom_act α).1
      (fun i => Series.constantCoeff_comp (X.isLawHom_act β).1 X.isLawHom_varpi.1 i),
    Series.map_comp π _ _ X.isLawHom_varpi.1]
  rfl

theorem comp_act_comp_g_eq
    (coord : ↥Λ → Zp2 q × Zp2 q)
    (B B₀ : Type) [CommRing B] [CommRing B₀] [Algebra B B₀]
    (E₀ : FakeEllipticCurve Λ N B₀) (X : FormalODModule q B) (θ₀ : RelativeGroupLaw.FormalCoordinates E₀.f 2)
    (h₀ : E₀.IsFormalModuleVia coord (X.map (algebraMap B B₀)) θ₀)
    (D : BareDeformation E₀.f E₀.L B) (θ : RelativeGroupLaw.FormalCoordinates D.f 2)
    (hlift : D.LiftsCoordinates θ₀ θ) (m : ↥Λ)
    (B'' : Type) [CommRing B''] [Algebra B B''] [Algebra B₀ B''] [IsScalarTower B B₀ B'']
    (J : Ideal B'') (n : ℕ) (hJ : J ^ (n + 1) = ⊥) (s : Fin 2 → B'') (hs : ∀ i, s i ∈ J)
    (p₀ : SchemeHomOver (Scheme.specOver (𝒪 := B₀) B'') E₀.f) (hp₀ : p₀.1 ≫ D.g = (θ B'' s).1) :
    p₀.1 ≫ E₀.act m ≫ D.g =
      (θ B'' (fun i => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord m)) i) s)).1 := by
  have hnil : ∀ i, IsNilpotent (s i) := fun i => isNilpotent_of_mem hJ (hs i)

  have hp : p₀.1 = (θ₀ B'' s).1 := by
    apply D.cart.hom_ext
    · rw [hp₀, hlift B'' s hnil]
    · rw [p₀.2, (θ₀ B'' s).2]

  set t : Fin 2 → B'' := fun i => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord m)) i) s
    with ht_def
  set t₀ : Fin 2 → B'' := fun i => MvFormalGroup.nilEval n
      (Series.addVia (X.map (algebraMap B B₀)).F ((X.map (algebraMap B B₀)).act (coord m).1)
        (((X.map (algebraMap B B₀)).act (coord m).2).comp (X.map (algebraMap B B₀)).varpi) i) s with ht₀_def
  have ht₀ : t₀ = t := by
    funext i
    simp only [ht₀_def, ht_def]
    rw [actSeries_map]
    exact nilEval_map_of_isScalarTower n _ s
  have ht_mem : ∀ i, t i ∈ J := fun i => nilEval_mem J n _ (constantCoeff_rho X (coord m) i) s hs
  have ht_nil : ∀ i, IsNilpotent (t₀ i) := fun i => by
    rw [ht₀]; exact isNilpotent_of_mem hJ (ht_mem i)

  have e0 : (θ₀ B'' t₀).1 = (θ₀ B'' s).1 ≫ E₀.act m := congrArg Subtype.val (h₀.2 B'' J n hJ m s hs)
  calc p₀.1 ≫ E₀.act m ≫ D.g = ((θ₀ B'' s).1 ≫ E₀.act m) ≫ D.g := by rw [hp, Category.assoc]
    _ = (θ₀ B'' t₀).1 ≫ D.g := by rw [← e0]
    _ = (θ B'' t₀).1 := hlift B'' t₀ ht_nil
    _ = (θ B'' t).1 := by rw [ht₀]

theorem existsUnique_liftSpec
    (coord : ↥Λ → Zp2 q × Zp2 q) (hcoord : IsOrderCoord Λ q coord)
    (h1 : (1 : ℍ[ℚ, a, b]) ∈ Λ)
    (B B₀ : Type) [CommRing B] [IsLocalRing B] [IsArtinianRing B]
    [CommRing B₀] [Algebra B B₀]
    (hπ : Function.Surjective (algebraMap B B₀)) (hker : IsNilpotent (RingHom.ker (algebraMap B B₀)))
    (hq : IsNilpotent ((q : ℕ) : B))
    (E₀ : FakeEllipticCurve Λ N B₀) (X : FormalODModule q B) (θ₀ : RelativeGroupLaw.FormalCoordinates E₀.f 2)
    (h₀ : E₀.IsFormalModuleVia coord (X.map (algebraMap B B₀)) θ₀)
    (D : BareDeformation E₀.f E₀.L B) (θ : RelativeGroupLaw.FormalCoordinates D.f 2)
    (hθ : D.L.IsFormalCoordinates X.F θ) (hlift : D.LiftsCoordinates θ₀ θ) (m : ↥Λ) :
    ∃! φ : D.A ⟶ D.A, LiftSpec D X θ (E₀.act m) (coord m) φ := by

  have hq₀ : IsNilpotent ((q : ℕ) : B₀) := by
    obtain ⟨k, hk⟩ := hq
    exact ⟨k, by rw [← map_natCast (algebraMap B B₀), ← map_pow, hk, map_zero]⟩
  haveI : IsNoetherianRing B₀ := isNoetherianRing_of_surjective B B₀ (algebraMap B B₀) hπ

  have hinf₀ : ∀ (C : Type) [CommRing C] [Algebra B₀ C] (k : ℕ)
      (P : SchemeHomOver (Scheme.specOver (𝒪 := B₀) C) E₀.f),
      nsmulPt E₀.L (Scheme.specOver (𝒪 := B₀) C) (q ^ k) P = E₀.L.one (Scheme.specOver (𝒪 := B₀) C) →
        ∃ J : Ideal C, IsNilpotent J ∧ E₀.L.IsInfinitesimal J P :=
    fun C _ _ k P hP =>
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_isNilpotent_isInfinitesimal_of_nsmulPt_pow_eq_one_of_one_mem
        coord hcoord h1 B₀ hq₀ E₀ (X.map (algebraMap B B₀)) θ₀ h₀ C k P hP
  have hinfD : ∀ (C : Type) [CommRing C] [Algebra B C] (k : ℕ)
      (P : SchemeHomOver (Scheme.specOver (𝒪 := B) C) D.f),
      nsmulPt D.L (Scheme.specOver (𝒪 := B) C) (q ^ k) P = D.L.one (Scheme.specOver (𝒪 := B) C) →
        ∃ J : Ideal C, IsNilpotent J ∧ D.L.IsInfinitesimal J P :=
    fun C _ _ k P hP =>
      GoodReductionJacobian.RelativeGroupLaw.exists_isNilpotent_isInfinitesimal_of_isPullback_of_isNilpotent_ker
        q B B₀ hπ hker D.f D.L E₀.f E₀.L D.g D.cart (fun t P Q => D.hom t P Q) hinf₀ C k P hP
  unfold LiftSpec
  exact GoodReductionJacobian.RelativeGroupLaw.existsUnique_hom_lift_of_isFormalCoordinates_of_forall_isInfinitesimal
    B B₀ hπ hker hq D.f D.f D.L D.L D.comm D.comm D.bundle D.bundle X.F X.F θ θ hθ hθ hinfD hinfD
    E₀.f E₀.f E₀.L E₀.L D.g D.g D.cart D.cart (fun t P Q => D.hom t P Q) (fun t P Q => D.hom t P Q)
    (E₀.act m) (E₀.act_over m) (fun t P Q => E₀.act_hom m t P Q) (rho X (coord m))
    (fun B'' _ _ _ _ J n hJ s hs p₀ hp₀ => comp_act_comp_g_eq coord B B₀ E₀ X θ₀ h₀ D θ hlift m B'' J n hJ s hs p₀ hp₀)

theorem exists_act_of_bareDeformation_of_isFormalCoordinates
    (coord : ↥Λ → Zp2 q × Zp2 q) (hcoord : IsOrderCoord Λ q coord)
    (h1 : (1 : ℍ[ℚ, a, b]) ∈ Λ)
    (B B₀ : Type) [CommRing B] [IsLocalRing B] [IsArtinianRing B] [IsAlgClosed (ResidueField B)]
    [CommRing B₀] [Algebra B B₀]
    (hπ : Function.Surjective (algebraMap B B₀)) (hker : IsNilpotent (RingHom.ker (algebraMap B B₀)))
    (hq : IsNilpotent ((q : ℕ) : B)) (_hN : IsUnit ((N : ℕ) : B))
    (E₀ : FakeEllipticCurve Λ N B₀) (X : FormalODModule q B) (θ₀ : RelativeGroupLaw.FormalCoordinates E₀.f 2)
    (h₀ : E₀.IsFormalModuleVia coord (X.map (algebraMap B B₀)) θ₀)
    (D : BareDeformation E₀.f E₀.L B) (θ : RelativeGroupLaw.FormalCoordinates D.f 2)
    (hθ : D.L.IsFormalCoordinates X.F θ) (hlift : D.LiftsCoordinates θ₀ θ) :
    ∃ (act : ↥Λ → (D.A ⟶ D.A)) (act_over : ∀ x : ↥Λ, act x ≫ D.f = D.f),
      (∀ (x : ↥Λ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t D.f),
        pushPt (act x) (act_over x) (D.L.mul t P Q) =
          D.L.mul t (pushPt (act x) (act_over x) P) (pushPt (act x) (act_over x) Q)) ∧
      (∀ h : (1 : ℍ[ℚ, a, b]) ∈ Λ, act ⟨1, h⟩ = 𝟙 D.A) ∧
      (∀ (x y : ↥Λ) (h : (x : ℍ[ℚ, a, b]) * (y : ℍ[ℚ, a, b]) ∈ Λ),
        act ⟨(x : ℍ[ℚ, a, b]) * (y : ℍ[ℚ, a, b]), h⟩ = act y ≫ act x) ∧
      (∀ (x y : ↥Λ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P : SchemeHomOver t D.f),
        pushPt (act (x + y)) (act_over (x + y)) P =
          D.L.mul t (pushPt (act x) (act_over x) P) (pushPt (act y) (act_over y) P)) ∧
      (∀ x : ↥Λ, E₀.act x ≫ D.g = D.g ≫ act x) ∧
      (∀ (B' : Type) [CommRing B'] [Algebra B B'] (J : Ideal B') (n : ℕ), J ^ (n + 1) = ⊥ →
        ∀ (m : ↥Λ) (s : Fin 2 → B'), (∀ i, s i ∈ J) →
          θ B' (fun i => MvFormalGroup.nilEval n
              (Series.addVia X.F (X.act (coord m).1) ((X.act (coord m).2).comp X.varpi) i) s) =
            pushPt (act m) (act_over m) (θ B' s)) := by

  have key : ∀ m : ↥Λ, ∃ φ : D.A ⟶ D.A, LiftSpec D X θ (E₀.act m) (coord m) φ ∧
      ∀ ψ : D.A ⟶ D.A, LiftSpec D X θ (E₀.act m) (coord m) ψ → ψ = φ := fun m => by
    obtain ⟨φ, hφ, hu⟩ := existsUnique_liftSpec coord hcoord h1 B B₀ hπ hker hq E₀ X θ₀ h₀ D θ hθ hlift m
    exact ⟨φ, hφ, hu⟩
  choose act hspec huniq using key

  have hg : ∀ x : ↥Λ, D.g ≫ act x = E₀.act x ≫ D.g := fun x => (hspec x).1
  have hover : ∀ x : ↥Λ, act x ≫ D.f = D.f := fun x => (hspec x).2.choose
  have hhom : ∀ (x : ↥Λ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P Q : SchemeHomOver t D.f),
      mapPt (act x) (hover x) (D.L.mul t P Q) = D.L.mul t (mapPt (act x) (hover x) P) (mapPt (act x) (hover x) Q) :=
    fun x => (hspec x).2.choose_spec.1
  have hformal : ∀ (x : ↥Λ) (B'' : Type) [CommRing B''] [Algebra B B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
      ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
        (θ B'' s).1 ≫ act x =
          (θ B'' (fun i => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord x)) i) s)).1 :=
    fun x => (hspec x).2.choose_spec.2

  have hformalPt : ∀ (x : ↥Λ) (B'' : Type) [CommRing B''] [Algebra B B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
      ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
        mapPt (act x) (hover x) (θ B'' s) =
          θ B'' (fun i => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord x)) i) s) :=
    fun x B'' _ _ J n hJ s hs => Subtype.ext (hformal x B'' J n hJ s hs)
  have hρmem : ∀ (x : ↥Λ) {B'' : Type} [CommRing B''] [Algebra B B''] (J : Ideal B'') (n : ℕ)
      (s : Fin 2 → B''), (∀ i, s i ∈ J) →
        ∀ i, MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord x)) i) s ∈ J :=
    fun x B'' _ _ J n s hs i => nilEval_mem J n _ (constantCoeff_rho X (coord x) i) s hs
  refine ⟨act, hover, fun x T t P Q => hhom x t P Q, ?_, ?_, ?_, fun x => (hg x).symm, ?_⟩
  ·
    intro h
    symm
    refine huniq ⟨1, h⟩ (𝟙 D.A) ⟨?_, Category.id_comp _, ?_, ?_⟩
    · rw [Category.comp_id, E₀.act_one h, Category.id_comp]
    · intro T t P Q
      rw [mapPt_id', mapPt_id', mapPt_id']
    · intro B'' _ _ J n hJ s hs
      rw [Category.comp_id]
      have ht : (fun i => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord ⟨1, h⟩)) i) s) = s := by
        funext i
        rw [hcoord.map_one h, rho_one_zero]
        exact nilEval_X J n hJ s hs i
      rw [ht]
  ·
    intro x y h
    symm
    refine huniq ⟨(x : ℍ[ℚ, a, b]) * (y : ℍ[ℚ, a, b]), h⟩ (act y ≫ act x)
      ⟨?_, by rw [Category.assoc, hover x, hover y], ?_, ?_⟩
    · rw [← Category.assoc, hg y, Category.assoc, hg x, ← Category.assoc, ← E₀.act_mul x y h]
    · intro T t P Q
      rw [mapPt_comp' _ _ (hover y) (hover x) (D.L.mul t P Q), mapPt_comp' _ _ (hover y) (hover x) P,
        mapPt_comp' _ _ (hover y) (hover x) Q, hhom y, hhom x]
    · intro B'' _ _ J n hJ s hs
      rw [← Category.assoc, hformal y B'' J n hJ s hs, hformal x B'' J n hJ _ (hρmem y J n s hs)]
      have ht : (fun i => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord x)) i)
            (fun j => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord y)) j) s)) =
          fun i => MvFormalGroup.nilEval n
            (MvFormalGroup.Hom.toPowerSeries (rho X (coord ⟨(x : ℍ[ℚ, a, b]) * (y : ℍ[ℚ, a, b]), h⟩)) i) s := by
        rw [hcoord.map_mul x y h, rho_mul]
        funext i
        exact (nilEval_subst J n hJ _ (constantCoeff_rho X (coord y)) _ s hs).symm
      rw [ht]
  ·

    intro x y T t P

    let ax : SchemeHomOver D.f D.f := ⟨act x, hover x⟩
    let ay : SchemeHomOver D.f D.f := ⟨act y, hover y⟩
    let M : SchemeHomOver D.f D.f := D.L.mul D.f ax ay
    have hpt : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of B)) (P : SchemeHomOver t D.f),
        mapPt M.1 M.2 P = D.L.mul t (mapPt (act x) (hover x) P) (mapPt (act y) (hover y) P) :=
      fun t P => D.L.mul_natural D.f t P.1 P.2 ax ay

    have hM : M.1 = act (x + y) := by
      refine huniq (x + y) M.1 ⟨?_, M.2, ?_, ?_⟩
      ·
        let P₁ : SchemeHomOver E₀.f E₀.f := ⟨𝟙 E₀.A, Category.id_comp _⟩
        let ax₀ : SchemeHomOver E₀.f E₀.f := pushPt (E₀.act x) (E₀.act_over x) P₁
        let ay₀ : SchemeHomOver E₀.f E₀.f := pushPt (E₀.act y) (E₀.act_over y) P₁
        have hadd₀ : E₀.act (x + y) = (E₀.L.mul E₀.f ax₀ ay₀).1 := by
          have := congrArg Subtype.val (E₀.act_add x y E₀.f P₁)
          rw [show (pushPt (E₀.act (x + y)) (E₀.act_over (x + y)) P₁).1 = E₀.act (x + y) from
            Category.id_comp _] at this
          exact this
        have hψ : D.g ≫ D.f = E₀.f ≫ Spec.map (CommRingCat.ofHom (algebraMap B B₀)) := D.cart.w
        have hnat := congrArg Subtype.val (D.L.mul_natural D.f _ D.g hψ ax ay)
        rw [schemeHomOverComp_coe] at hnat
        have ex : schemeHomOverComp D.g hψ ax =
            ⟨ax₀.1 ≫ D.g, by rw [Category.assoc, D.cart.w, ← Category.assoc, ax₀.2]⟩ := by
          apply Subtype.ext
          show D.g ≫ act x = (𝟙 E₀.A ≫ E₀.act x) ≫ D.g
          rw [Category.id_comp, hg x]
        have ey : schemeHomOverComp D.g hψ ay =
            ⟨ay₀.1 ≫ D.g, by rw [Category.assoc, D.cart.w, ← Category.assoc, ay₀.2]⟩ := by
          apply Subtype.ext
          show D.g ≫ act y = (𝟙 E₀.A ≫ E₀.act y) ≫ D.g
          rw [Category.id_comp, hg y]
        rw [ex, ey] at hnat
        rw [hnat, hadd₀]
        exact (D.hom E₀.f ax₀ ay₀).symm
      ·
        intro T t P Q
        rw [hpt, hpt, hpt, hhom x, hhom y]
        exact mul_mul_mul_comm' D.L D.comm t _ _ _ _
      ·
        intro B'' _ _ J n hJ s hs
        obtain ⟨-, -, -, hlaw⟩ := hθ.2 B'' J n hJ
        have h1 : (θ B'' s).1 ≫ M.1 = (mapPt M.1 M.2 (θ B'' s)).1 := rfl
        rw [h1, hpt, hformalPt x B'' J n hJ s hs, hformalPt y B'' J n hJ s hs,
          ← hlaw _ _ (hρmem x J n s hs) (hρmem y J n s hs)]
        have ht : X.F.nilMul n
              (fun i => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord x)) i) s)
              (fun i => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord y)) i) s) =
            fun i => MvFormalGroup.nilEval n (MvFormalGroup.Hom.toPowerSeries (rho X (coord (x + y))) i) s := by
          rw [hcoord.map_add x y, rho_add]
          exact (ap_addVia J n hJ X.F _ _ (constantCoeff_rho X (coord x)) (constantCoeff_rho X (coord y)) s hs).symm
        rw [ht]

    apply Subtype.ext
    show P.1 ≫ act (x + y) = (D.L.mul t (pushPt (act x) (hover x) P) (pushPt (act y) (hover y) P)).1
    rw [← hM]
    exact congrArg Subtype.val (hpt t P)
  ·
    intro B' _ _ J n hJ m s hs
    apply Subtype.ext
