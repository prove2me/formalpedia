section
-- Source module: Solutions.KIL5Tab
/-!
# KIL5: the stream table with run-time stream length

KIL3's table operations (`applyC`, `copyC`, `accC`, `buildC`, `rebuildC`, KIL3Tab) carry the
stream length `v` and the offsets `w · v` as literals.  Here the counts are read from registers:

* `rV` (`42`) holds `v`, `rWV` (`43`) holds `W · v`;
* the offset `w · v` (`w < W` a fixed wire) is computed into the temporary register `rT` (`44`)
  by one multiplication (`push rT (w · rV)`) and popped afterwards.

The element loops `dupK`, `zipK`, `zeroK`, `dropK` with register counts are obtained from the
literal ones by the literal-to-register simulation (`Sp.sim`, KIL4Sim).

`applyCU_runs` is relative to an invariant: the stream code only has to be correct on states
`t` with `Inv G0 t` (every protected stack `r ≥ 22`, `r ≠ 44`, holds `G0 r`).  This is what the
uniform procedure needs: its child calls read the descriptor and the level registers from these
stacks.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

/-! ## Registers and the invariant -/

theorem Inv.upd {G0 : Fin HS → List Item} {t : IState HS} (h : Inv G0 t) {i : Fin HS}
    (hi : ¬ Prot i) (X : List Item) : Inv G0 (t.upd i X) := fun r hr => by
  have : r ≠ i := fun e => hi (e ▸ hr)
  simp [this, h r hr]

theorem Inv.encK {G0 : Fin HS → List Item} {s : IState HS} (h : Inv G0 s) {f : Fin HS → List ℤ}
    (hf : ∀ r, Prot r → f r = []) : Inv G0 (encK s f) := fun r hr => by
  simp [hf r hr, h r hr]

theorem RegS.upd {s : IState HS} {f : Fin HS → List ℤ} {W v : ℕ} (h : RegS s f W v) {i : Fin HS}
    (hi : i.val < 22) (l : List ℤ) : RegS s (Function.update f i l) W v := by
  have h1 : rV ≠ i := fun e => by rw [← e] at hi; exact absurd hi (by decide)
  have h2 : rWV ≠ i := fun e => by rw [← e] at hi; exact absurd hi (by decide)
  have h3 : rT ≠ i := fun e => by rw [← e] at hi; exact absurd hi (by decide)
  exact ⟨by simp [h1, h.fV], by simp [h2, h.fWV], by simp [h3, h.fT], h.sV, h.sWV⟩

