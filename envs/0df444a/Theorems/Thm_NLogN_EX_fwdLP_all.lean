variable {M : MulSpec} {Ctx : IState HS → Prop} {PreW : List (ℤ × ℤ) → List (ℤ × ℤ) → Prop}
  {q : Params} {CW : ℕ}
set_option maxHeartbeats 4000000

theorem NLogN.EX.fwdLP_all (fw : LProg2 M Ctx PreW (fermatW q) CW) (hfw : FwOK fw) {m Φm : ℕ}
    (hMm : MulBnd M m Φm) {kb mm Φ Bacc Qa Bq Bx CS CB Q : ℕ} {BS BB : ℕ → ℕ}
    (hcfg : FwdCfgX M q kb mm Φ Bacc Qa Bq Bx CS CB m Q BS BB) (s : IState HS)
    (hE : FwdEnvX q kb Ctx s) (U : List (ℤ × ℤ)) (R : List Item) (hU : s.G gD = gints U ++ R)
    (hin : FwdInX q PreW BS BB m Q U) :
    (fwdLP fw).run s = s.upd gD (gints (fwdL q U) ++ R) ∧
    (fwdLP fw).ok M s ∧
    (fwdLP fw).cost M s ≤ fwdLCost q CS CB Bx CW Q Φm ∧
    (fwdL q U).length = q.S ∧ GB (BB q.K) (fwdL q U) := by sorry
