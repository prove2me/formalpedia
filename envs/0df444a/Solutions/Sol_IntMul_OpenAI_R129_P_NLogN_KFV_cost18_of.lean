    have h2 : (3 * X) * (500 * (p + ℓ + 3) + 10 ^ 5) = 1500 * Y + 3 * 10 ^ 5 * X := by rw [hY]; ring
    linarith
  have e3 : 2000 * 10 ^ 8 * (2 * X) * (4 * p + 2 * ℓ + 13) ≤ 10 ^ 13 * Y := by
    have t : (4 * p + 2 * ℓ + 13) * X ≤ 5 * Y := by
      rw [hY]; nlinarith
    have h2 : 2000 * 10 ^ 8 * (2 * X) * (4 * p + 2 * ℓ + 13) = 4 * 10 ^ 11 * ((4 * p + 2 * ℓ + 13) * X) := by
      ring
    linarith
  have hBK : 2 * BK + 2 ≤ (BK + 2) ^ 2 := by nlinarith
