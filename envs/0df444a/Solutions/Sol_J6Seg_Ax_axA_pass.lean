section fx
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {stUp stDn : IStmt HS Pp}
  {eF eB : Fin Pp} {dF dA : Fin HS} {desc : List ℤ} {C₀ Cs : ℝ}

/-- **The forward exposure step.** -/
theorem fxF_ok (w f a y : ℕ) (hy : 1 ≤ y) (hFine : FineBody6 Isym tbl eF eB dF C₀)
    (hF0 : dF ≠ 0) (hFA : dF ≠ dA) (hA0 : dA ≠ 0)
    (hSet : SetupS Isym tbl stUp stDn ![dF] dA desc ![descFine w f a y] Cs) :
    PassOK Isym tbl (fxSt stUp stDn eF) dA desc
      (fun L => L.length = a * (2 ^ f * y) ∧ GB w L) (blkT (2 ^ f) y a)
      (2 * Cs + C₀ * cFine w f a y) :=
  fx_frame w f a y hF0 hFA hA0 hSet (fun s F zs l h1 h2 h3 h4 h5 =>
    (hFine w f a y s F zs l h1 h2 h3 hy h4 h5).1)

/-- **The backward exposure step.** -/
theorem fxB_ok (w f a y : ℕ) (hy : 1 ≤ y) (hFine : FineBody6 Isym tbl eF eB dF C₀)
    (hF0 : dF ≠ 0) (hFA : dF ≠ dA) (hA0 : dA ≠ 0)
    (hSet : SetupS Isym tbl stUp stDn ![dF] dA desc ![descFine w f a y] Cs) :
    PassOK Isym tbl (fxSt stUp stDn eB) dA desc
      (fun L => L.length = a * (2 ^ f * y) ∧ GB w L) (blkT y (2 ^ f) a)
      (2 * Cs + C₀ * cFine w f a y) :=
  fx_frame w f a y hF0 hFA hA0 hSet (fun s F zs l h1 h2 h3 h4 h5 =>
    (hFine w f a y s F zs l h1 h2 h3 hy h4 h5).2)

