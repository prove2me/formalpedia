    [MeasureTheory.IsFiniteMeasure mu] (hgen : ‹MeasurableSpace M› = TypeDensity.adicCylinderSpace I M)
    (heq : ∀ j x, mu {y | adicCongr I j y x} = nu {y | adicCongr I j y x}) :
    mu = nu := by
  refine MeasureTheory.ext_of_generate_finite (TypeDensity.adicCylinders I M) hgen
    (TypeDensity.adic_cylinders_intersection R M I) ?_ ?_
  · rintro s (rfl | ⟨j, x, rfl⟩)
    · simp
    · exact heq j x
  · have h : {y : M | adicCongr I 0 y 0} = Set.univ := by ext; simp [TypeDensity.adicCongr]
    exact h ▸ heq 0 0
