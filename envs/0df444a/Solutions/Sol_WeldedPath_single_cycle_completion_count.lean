variable [Fintype α]

def partnerFiber (C : Finset (Equiv.Perm α)) (u v : α) : Finset (Equiv.Perm α) :=
  C.filter fun π => π u = v

@[simp] theorem mem_partnerFiber (C : Finset (Equiv.Perm α)) (u v : α)
    (π : Equiv.Perm α) : π ∈ partnerFiber C u v ↔ π ∈ C ∧ π u = v :=
  Finset.mem_filter

theorem sum_partnerFiber_card (C : Finset (Equiv.Perm α)) (u : α) :
    (∑ v, (partnerFiber C u v).card) = C.card := by
  simpa [partnerFiber] using
    Finset.sum_card_fiberwise_eq_card_filter C Finset.univ (fun π => π u)

/-- The insertion/deletion maps give an explicit bijection between partner fibers.
Only the combinatorial admissibility of the insertion is needed from the graph. -/
theorem partnerFiber_card_eq_of_shift (C : Finset (Equiv.Perm α)) (u w a b : α)
    (ha : a ≠ w) (hb : b ≠ w)
    (hstable : ∀ π ∈ C, ∀ v, v ≠ w → shiftPartner π u w v ∈ C) :
    (partnerFiber C u a).card = (partnerFiber C u b).card := by
  apply Finset.card_bij' (fun π _ => shiftPartner π u w b)
    (fun π _ => shiftPartner π u w a)
  · intro π hπ
    exact (mem_partnerFiber _ _ _ _).2
      ⟨hstable π ((mem_partnerFiber _ _ _ _).1 hπ).1 b hb, shiftPartner_apply _ _ _ _⟩
  · intro π hπ
    exact (mem_partnerFiber _ _ _ _).2
      ⟨hstable π ((mem_partnerFiber _ _ _ _).1 hπ).1 a ha, shiftPartner_apply _ _ _ _⟩
  · intro π hπ
    have hpa := ((mem_partnerFiber _ _ _ _).1 hπ).2
    rw [shiftPartner_shift, ← hpa, shiftPartner_original]
  · intro π hπ
    have hpb := ((mem_partnerFiber _ _ _ _).1 hπ).2
    rw [shiftPartner_shift, ← hpb, shiftPartner_original]

/-- Deleting a distinguished left-to-right fixed path and reinserting it at any
other right endpoint makes every admissible partner fiber have the same size. -/
theorem partnerFiber_exact_of_shift (C : Finset (Equiv.Perm α)) (u w v : α)
    (hv : v ≠ w) (havoid : ∀ π ∈ C, π u ≠ w)
    (hstable : ∀ π ∈ C, ∀ z, z ≠ w → shiftPartner π u w z ∈ C) :
    (Fintype.card α - 1) * (partnerFiber C u v).card = C.card := by
  have hwzero : (partnerFiber C u w).card = 0 := by
    apply Finset.card_eq_zero.mpr
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro π hπ
    exact havoid π ((mem_partnerFiber _ _ _ _).1 hπ).1
      ((mem_partnerFiber _ _ _ _).1 hπ).2
  have hsum : (∑ z ∈ Finset.univ.erase w, (partnerFiber C u z).card) = C.card := by
    have hs := Finset.sum_erase_add Finset.univ (fun z => (partnerFiber C u z).card)
      (Finset.mem_univ w)
    simpa only [hwzero, add_zero, sum_partnerFiber_card] using hs
  calc
    _ = ∑ z ∈ Finset.univ.erase w, (partnerFiber C u v).card := by simp
    _ = ∑ z ∈ Finset.univ.erase w, (partnerFiber C u z).card := by
      apply Finset.sum_congr rfl
      intro z hz
      exact partnerFiber_card_eq_of_shift C u w v z hv (Finset.mem_erase.mp hz).1 hstable
    _ = _ := hsum

/-- The source's final symmetry argument in count form. If each partner fiber is
either known exactly or has the same size as the tested fiber, that tested fiber
cannot exceed the reciprocal-`m-1` cap. -/
theorem partnerFiber_cap_of_exact_or_equal (C : Finset (Equiv.Perm α)) (u v : α)
    (hcases : ∀ z,
      (Fintype.card α - 1) * (partnerFiber C u z).card = C.card ∨
        (partnerFiber C u z).card = (partnerFiber C u v).card) :
    (Fintype.card α - 1) * (partnerFiber C u v).card ≤ C.card := by
  by_contra hbad
  have hlt : C.card < (Fintype.card α - 1) * (partnerFiber C u v).card :=
    Nat.lt_of_not_ge hbad
  have hpos : 0 < C.card := by
    have hf : (partnerFiber C u v).card ≤ C.card :=
      Finset.card_le_card (Finset.filter_subset _ _)
    by_contra hn
    have hz : C.card = 0 := by omega
    have hvz : (partnerFiber C u v).card = 0 := by omega
    simp [hz, hvz] at hlt
  have hs : (∑ _z : α, C.card) ≤
      ∑ z : α, (Fintype.card α - 1) * (partnerFiber C u z).card := by
    apply Finset.sum_le_sum
    intro z _
    rcases hcases z with he | he
    · exact he.ge
    · rw [he]
      exact hlt.le
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    ← Finset.mul_sum, sum_partnerFiber_card] at hs
  have hm : 0 < Fintype.card α := Fintype.card_pos_iff.mpr ⟨u⟩
  have hsucc : Fintype.card α - 1 + 1 = Fintype.card α := by omega
  nlinarith

