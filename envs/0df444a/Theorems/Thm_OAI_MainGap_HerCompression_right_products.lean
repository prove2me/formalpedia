theorem OAI.MainGap.HerCompression.right_products {p q c : A} {κ : ℝ} (hκ : 0 ≤ κ)
    (hp : 0 ≤ p) (hq : 0 ≤ q) (h : HerCompression p q c κ) (w z : A) :
    ‖star (p*w) * c * (q*z)‖ ≤ κ * ‖p*w‖ * ‖q*z‖ := by sorry
