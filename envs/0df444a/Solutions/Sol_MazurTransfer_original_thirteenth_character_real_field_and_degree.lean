theorem realField_finrank : Module.finrank ℚ (realField z) = 6 := by
  have he : (conjugateCharacter.comp (hz.autToPow ℚ)).range = conjugateCharacter.range := by
    rw [MonoidHom.range_comp, MonoidHom.range_eq_top.mpr ((MazurTransfer.thirteenth_root_galois_quotient_certificates).2.2.1 F z hz), ← MonoidHom.range_eq_map]
  rw [IntermediateField.finrank_eq_fixingSubgroup_index, realField_fixingSubgroup_eq_character_kernel z hz,
    Subgroup.index_ker, he, ← Subgroup.index_ker]
  exact conjugateCharacter_kernel_index

