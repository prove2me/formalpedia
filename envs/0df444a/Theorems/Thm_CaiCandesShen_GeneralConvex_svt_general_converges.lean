-- title:
--   Theorem 4.4 — the SVT iteration (3.5) converges to the unique solution of (3.4)
-- statement:
--   Let $\tau>0$, let $f_1,\dots,f_m:\mathbb R^{n_1\times n_2}\to\mathbb R$ be convex, and suppose $\mathcal F = (f_1,\dots,f_m)$ is Lipschitz in the sense of (4.2): for some $L\ge 0$,
--   $$\|\mathcal F(X) - \mathcal F(Y)\| \le L\,\|X - Y\|_F\quad\text{for all } X, Y .$$
--   Consider the problem
--   $$\text{(3.4)}\qquad \text{minimize } f_\tau(X) = \tau\|X\|_* + \tfrac12\|X\|_F^2\quad\text{subject to } f_i(X)\le 0,\ i = 1,\dots,m,$$
--   and assume strong duality: a primal-dual optimal pair $(X^\star, y^\star)$ (a saddle point of $\mathcal L(X,y) = f_\tau(X) + \langle y,\mathcal F(X)\rangle$ over $X$ and $y\ge 0$) exists. Suppose the step sizes obey
--   $$0 < \inf_k\delta_k \le \sup_k\delta_k < 2/L^2 .$$
--   Let $(X^k, y^k)$ be generated by iteration (3.5) starting from $y^0 = 0$:
--   $$X^k = \arg\min_X\{f_\tau(X) + \langle y^{k-1},\mathcal F(X)\rangle\},\qquad y^k = [\,y^{k-1} + \delta_k\mathcal F(X^k)\,]_+ .$$
--   Then (3.4) has exactly one solution $X^\star$, and $X^k\to X^\star$ as $k\to\infty$.
--
--   The theorem extends the convergence of singular value thresholding for matrix completion (Theorem 4.2) to arbitrary convex constraints, and covers linear inequality and equality constraints as special cases.
--
--   **Formalization Note** The step-size condition is stated as: there are $a>0$ and $C$ with $C\,L^2<2$ and $a\le\delta_k\le C$ for all $k\ge 1$. The multiplicative form avoids the division $2/L^2$, which Lean evaluates to $0$ when $L=0$; for $L=0$ the condition reads $0<\inf\delta_k\le\sup\delta_k<\infty$, as in the paper's convention $2/0=\infty$. Strong duality is the hypothesis that a saddle point exists; Slater's condition, which the paper names only as a sufficient condition, is not assumed. The paper's step $k$ is the Lean index `k + 1`; convergence is in the Frobenius (equivalently, entrywise) topology.
-- source:
--   Cai, Candès, Shen, A Singular Value Thresholding Algorithm for Matrix Completion, SIAM J. Optim. 20 (2010), p. 1969, Theorem 4.4; p. 1965, Eqs. (3.4), (3.5); p. 1968, Eq. (4.2)

import Mathlib
import Definitions.Def_CaiCandesShen_GeneralConvex_Problem
open Filter Topology

namespace CaiCandesShen.GeneralConvex

/-- Theorem 4.4, p. 1969: let `f_1, …, f_m` be convex, let `𝓕 = (f_1, …, f_m)` obey the
Lipschitz bound (4.2) with constant `L ≥ 0`, and suppose the step sizes obey
`0 < inf δ_k ≤ sup δ_k < 2 / L²` (stated as `a ≤ δ_k ≤ C` for `k ≥ 1` with `a > 0` and
`C L² < 2`). Assuming strong duality (a primal-dual optimal pair of (3.4) exists), the sequence
`X^k` obtained via (3.5) from `y⁰ = 0` converges to the unique solution of (3.4). -/
theorem svt_general_converges {n₁ n₂ m : ℕ} (τ : ℝ) (hτ : 0 < τ)
    (f : Fin m → Mat n₁ n₂ → ℝ) (hconv : ∀ i, ConvexOn ℝ Set.univ (f i))
    (L : ℝ) (hL0 : 0 ≤ L)
    (hL : ∀ X Y : Mat n₁ n₂, eucNorm (constraintMap f X - constraintMap f Y) ≤ L * frobNorm (X - Y))
    (hdual : ∃ (Xs : Mat n₁ n₂) (ys : Fin m → ℝ), IsPrimalDualOptimal τ f Xs ys)
    (δ : ℕ → ℝ)
    (hδ : ∃ a C : ℝ, 0 < a ∧ C * L ^ 2 < 2 ∧ ∀ k : ℕ, 1 ≤ k → a ≤ δ k ∧ δ k ≤ C)
    (X : ℕ → Mat n₁ n₂) (y : ℕ → Fin m → ℝ) (hseq : IsGeneralSVTSeq τ f δ X y) :
    (∃! Xs : Mat n₁ n₂, IsSol34 τ f Xs) ∧
      ∀ Xs : Mat n₁ n₂, IsSol34 τ f Xs → Tendsto X atTop (𝓝 Xs) := by sorry

end CaiCandesShen.GeneralConvex
