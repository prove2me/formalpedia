-- title:
--   James, Theorem 19.2 — the determinantal form of the irreducible characters of the symmetric group
-- statement:
--   Let `rows` $= (\lambda_0 \ge \lambda_1 \ge \dots \ge \lambda_{\ell-1})$ be a weakly decreasing list of natural numbers with sum $N$ (trailing zeros allowed), and let $\sigma \in \mathbf S_N$. Then the trace of $\sigma$ acting by left multiplication on the representation of $\mathbf S_N$ defined by `rows` (`youngAct N rows σ` on `youngSpace N rows`, the left ideal of $\mathbb C[\mathbf S_N]$ generated by the Young symmetrizer) equals
--   $$\sum_{w \in \mathbf S_\ell} \operatorname{sgn}(w)\, \#\{f : \{0,\dots,N-1\} \to \{0,\dots,\ell-1\} \;:\; f \circ \sigma = f,\ |f^{-1}(i)| = \lambda_i - i + w(i) \text{ for all } i\}.$$
--
--   The count is the value at $\sigma$ of the permutation character of $\mathbf S_N$ on ordered set partitions with block sizes $(\lambda_i - i + w(i))_i$, that is, of the permutation module $M^{(\lambda_i - i + w(i))_i}$ (James's $[\lambda_0 - 0 + w(0)][\lambda_1 - 1 + w(1)]\cdots$). It is $0$ when some block size is negative, which is James's convention $[m] = 0$ for $m < 0$. Expanding the determinant $|[\lambda_i - i + j]|$ over permutations gives exactly this sum, since a product of the characters $[m_i]$ is the permutation character of $M^{(m_i)_i}$.
--
--   James states the theorem for a "proper partition", that is, one with weakly decreasing parts. Indices here run from $0$, while James's run from $1$; only the differences $w(i) - i$ enter.
-- source:
--   James, G. D., The Representation Theory of the Symmetric Groups, Lecture Notes in Mathematics 682, Springer, 1978, https://doi.org/10.1007/BFb0067708, p. 74, Theorem 19.2 (the determinantal form)

import Mathlib
import Definitions.Def_StrongConvG4

open StrongConv

namespace StrongConv

theorem trace_youngAct_eq_sum_sign_mul_card_filter (N : ℕ) (rows : List ℕ) (hsorted : rows.SortedGE)
    (hsum : rows.sum = N) (σ : Equiv.Perm (Fin N)) :
    LinearMap.trace ℂ (youngSpace N rows) (youngAct N rows σ) =
      ∑ w : Equiv.Perm (Fin rows.length), ((Equiv.Perm.sign w : ℤ) : ℂ) *
        ((Finset.univ.filter fun f : Fin N → Fin rows.length =>
          (∀ x, f (σ x) = f x) ∧
            ∀ i, ((Finset.univ.filter fun x => f x = i).card : ℤ) =
              (rows.get i : ℤ) - (i : ℕ) + (w i : ℕ)).card : ℂ) := by
  sorry

end StrongConv
