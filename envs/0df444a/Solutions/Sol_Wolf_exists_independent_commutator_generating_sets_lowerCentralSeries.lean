@[simp] theorem one_u : (1 : CE).u = 0 := rfl
@[simp] theorem one_a13 : (1 : CE).a13 = 0 := rfl
@[simp] theorem one_a14 : (1 : CE).a14 = 0 := rfl
@[simp] theorem one_a23 : (1 : CE).a23 = 0 := rfl
@[simp] theorem one_a24 : (1 : CE).a24 = 0 := rfl
