  have h6 : m ^ k ≤ m ^ k * m := Nat.le_mul_of_pos_right _ (by omega)
  have h5 : p.2.val + m ^ k * p.1.val ≤ m ^ k * m - 1 := by omega
  have := Nat.mul_le_mul_left K h5
  unfold posR; omega

