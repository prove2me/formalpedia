theorem solution (p : ℕ)
    [Fact p.Prime] (hp : p % 8 = 7) (h : ModularForm (CongruenceSubgroup.Gamma0 p) 2) (b : ℕ → ℤ)
    (hb : ∀ n : ℕ, (b n : ℂ) = ModularFormClass.qCoeff h n)
    (hdvd : ∀ n : ℕ, n ≠ 0 → (8 : ℤ) ∣ b n) : (2 : ℤ) ∣ b 0 := by

  have hM : Nat.Coprime 8 p := by
    rw [Nat.Coprime, Nat.gcd_rec, hp]; norm_num

  have hdvd' : ∀ n : ℕ, ¬ p ∣ n → ((8 : ℕ) : ℤ) ∣ b n :=
    fun n hn => hdvd n (by rintro rfl; exact hn (dvd_zero p))
  obtain ⟨h12, -⟩ :=
    ModularForm.dvd_twelve_mul_qCoeff_zero_and_dvd_qCoeff_mul_of_dvd_qCoeff p 8 hM h b hb hdvd'

  have h8 : (8 : ℤ) ∣ 12 * b 0 := by exact_mod_cast h12
  omega

