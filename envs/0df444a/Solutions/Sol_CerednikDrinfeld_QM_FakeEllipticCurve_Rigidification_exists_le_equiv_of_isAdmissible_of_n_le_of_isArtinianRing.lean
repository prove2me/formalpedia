section generic
variable {r : ℕ} [Fact r.Prime] {B : Type} [CommRing B]

theorem act_cc (X : FormalODModule r B) (a : Zp2 r) (i : Fin 2) :
    MvPowerSeries.constantCoeff (X.act a i) = 0 := (X.isLawHom_act a).1 i

theorem cancel_right [IsNoetherianRing B] {φ g₁ g₂ : Series B}
    (hφ0 : ∀ i, MvPowerSeries.constantCoeff (φ i) = 0)
    {d : ℕ} (hφ : FormalODModule.HasKernelOfDegree φ d) (h : g₁.comp φ = g₂.comp φ) : g₁ = g₂ := by
  funext i
  exact FormalODModule.subst_injective_of_hasKernelOfDegree φ hφ0 hφ (g₁ i) (g₂ i) (congrFun h i)

theorem hasHeight_map [IsNoetherianRing B] {B' : Type} [CommRing B'] (f : B →+* B')
    {X : FormalODModule r B} {h : ℕ} (hX : X.HasHeight h) : (X.map f).HasHeight h := by
  unfold FormalODModule.HasHeight at hX ⊢
  rw [FormalODModule.map_act]
  exact FormalODModule.hasKernelOfDegree_map f _ (act_cc X _) hX

theorem hasKernelOfDegree_act_pow_source [IsNoetherianRing B] {Φb X : FormalODModule r B} {ρ : Series B} {n : ℕ}
    (hρ : FormalODModule.IsIsogenyOfHeight Φb X ρ (4 * n)) (hX : X.HasHeight 4) (a : ℕ) :
    FormalODModule.HasKernelOfDegree (Φb.act ((r : Zp2 r) ^ a)) (r ^ (4 * a)) := by
  have h1 : (X.act ((r : Zp2 r) ^ a)).comp ρ = ρ.comp (Φb.act ((r : Zp2 r) ^ a)) := (hρ.1.2.1 _).symm
  have hdeg : FormalODModule.HasKernelOfDegree ((X.act ((r : Zp2 r) ^ a)).comp ρ) (r ^ (4 * n) * r ^ (4 * a)) :=
    FormalODModule.HasKernelOfDegree.comp hρ.1.constantCoeff (act_cc X _) hρ.2 (hX.hasKernelOfDegree_act_pow a)
  rw [h1, mul_comm] at hdeg
  exact FormalODModule.HasKernelOfDegree.of_comp_left (act_cc Φb _) hρ.1.constantCoeff hρ.2 hdeg

end generic

theorem exists_eq_comp_act_pow_of_isIsomorphic
    {r : ℕ} [Fact r.Prime] {O : Type} [CommRing O] {Φ : FormalODModule r (O ⧸ pIdeal r O)}
    {B : Type} [CommRing B] [IsNoetherianRing B] [IsNoetherianRing (B ⧸ pIdeal r B)] [Nontrivial (B ⧸ pIdeal r B)]
    (ι : Zp2 r →+* O) (ψ : O →+* B)
    (t t' : Rigidified r Φ B) (ht : t.IsAdmissible ι ψ)

    (htx4 : t'.X.HasHeight 4)
    (htxiso : FormalODModule.IsIsogenyOfHeight (t'.Φbar ψ) t'.Xbar t'.ρ (4 * t'.n))

    (u : Series B) (m : ℕ) (hu : FormalODModule.IsODHom t.X t'.X u)
    (hexp : (t'.Xbar.act ((r : Zp2 r) ^ (m + t'.n))).comp ((u.map (Ideal.Quotient.mk (pIdeal r B))).comp t.ρ) =
      (t'.Xbar.act ((r : Zp2 r) ^ (m + t.n))).comp t'.ρ)
    (Y : FormalODModule r (B ⧸ pIdeal r B)) (hY4 : Y.HasHeight 4)
    (γ δ σ : Series (B ⧸ pIdeal r B)) (c c' : ℕ)
    (hγ : FormalODModule.IsIsogenyOfHeight (t'.Φbar ψ) Y γ c)
    (hδ : FormalODModule.IsODHom Y (t'.Φbar ψ) δ)
    (hγδ : γ.comp δ = Y.act ((r : Zp2 r) ^ c'))
    (hσ : FormalODModule.IsODHom Y t'.Xbar σ)
    (hfac : t'.ρ = σ.comp γ) :
    ∃ (k h : ℕ) (σ₁ : Series (B ⧸ pIdeal r B)),
      FormalODModule.IsODHom Y t'.Xbar σ₁ ∧
      σ = σ₁.comp (Y.act ((r : Zp2 r) ^ k)) ∧
      σ = (t'.Xbar.act ((r : Zp2 r) ^ k)).comp σ₁ ∧
      FormalODModule.HasKernelOfDegree σ₁ (r ^ h) ∧
      h + c ≤ 4 * t.n + 4 * c' ∧
      h + 4 * k + c = 4 * t'.n := by

  have hρt : FormalODModule.IsIsogenyOfHeight (t'.Φbar ψ) t.Xbar t.ρ (4 * t.n) := ht.2.2
  have hρt' : FormalODModule.IsIsogenyOfHeight (t'.Φbar ψ) t'.Xbar t'.ρ (4 * t'.n) := htxiso
  have hX4 : t'.Xbar.HasHeight 4 := hasHeight_map _ htx4

  have hσγdeg : FormalODModule.HasKernelOfDegree (σ.comp γ) (r ^ (4 * t'.n)) := hfac ▸ hρt'.2
  obtain ⟨hc_le, hσdeg⟩ :=
    FormalODModule.HasKernelOfDegree.le_and_of_comp_pow hγ.1.constantCoeff hσ.constantCoeff hγ.2 hσγdeg

  have pack : ∀ (k : ℕ) (σ₁ : Series (B ⧸ pIdeal r B)), FormalODModule.IsODHom Y t'.Xbar σ₁ →
      σ = σ₁.comp (Y.act ((r : Zp2 r) ^ k)) → 4 * t.n + 4 * c' + 4 * k ≥ 4 * t'.n →
      ∃ (k h : ℕ) (σ₁ : Series (B ⧸ pIdeal r B)),
        FormalODModule.IsODHom Y t'.Xbar σ₁ ∧
        σ = σ₁.comp (Y.act ((r : Zp2 r) ^ k)) ∧
        σ = (t'.Xbar.act ((r : Zp2 r) ^ k)).comp σ₁ ∧
        FormalODModule.HasKernelOfDegree σ₁ (r ^ h) ∧
        h + c ≤ 4 * t.n + 4 * c' ∧
        h + 4 * k + c = 4 * t'.n := by
    intro k σ₁ hσ₁ hright hbd
    have hright' : σ = (t'.Xbar.act ((r : Zp2 r) ^ k)).comp σ₁ := by rw [hright, hσ₁.2.1]
    have hdegk : FormalODModule.HasKernelOfDegree (Y.act ((r : Zp2 r) ^ k)) (r ^ (4 * k)) :=
      hY4.hasKernelOfDegree_act_pow k
    have hσdeg' : FormalODModule.HasKernelOfDegree (σ₁.comp (Y.act ((r : Zp2 r) ^ k))) (r ^ (4 * t'.n - c)) :=
      hright ▸ hσdeg
    obtain ⟨hk_le, hσ₁deg⟩ :=
      FormalODModule.HasKernelOfDegree.le_and_of_comp_pow (act_cc Y _) hσ₁.constantCoeff hdegk hσdeg'
    refine ⟨k, 4 * t'.n - c - 4 * k, σ₁, hσ₁, hright, hright', hσ₁deg, ?_, ?_⟩ <;> omega
  have hEq := hexp
  by_cases hcase : t.n + c' ≤ t'.n
  ·
    have hub : FormalODModule.IsODHom t.Xbar t'.Xbar (u.map (Ideal.Quotient.mk (pIdeal r B))) :=
      hu.map (Ideal.Quotient.mk (pIdeal r B))
    have hA : FormalODModule.IsODHom (t'.Φbar ψ) t'.Xbar ((u.map (Ideal.Quotient.mk (pIdeal r B))).comp t.ρ) :=
      hub.comp hρt.1

    have E1 : t'.ρ.comp ((t'.Φbar ψ).act ((r : Zp2 r) ^ (m + t.n))) =
        ((u.map (Ideal.Quotient.mk (pIdeal r B))).comp t.ρ).comp ((t'.Φbar ψ).act ((r : Zp2 r) ^ (m + t'.n))) := by
      rw [hρt'.1.2.1, hA.2.1]; exact hEq.symm

    have hsplit : m + t'.n = (t'.n - t.n) + (m + t.n) := by omega
    rw [hsplit, FormalODModule.act_pow_add _ (t'.n - t.n) (m + t.n),
      ← Series.comp_assoc _ _ _ (act_cc _ ((r : Zp2 r) ^ (t'.n - t.n))) (act_cc _ ((r : Zp2 r) ^ (m + t.n)))] at E1
    have E2 : t'.ρ = ((u.map (Ideal.Quotient.mk (pIdeal r B))).comp t.ρ).comp
        ((t'.Φbar ψ).act ((r : Zp2 r) ^ (t'.n - t.n))) :=
      cancel_right (act_cc _ _) (hasKernelOfDegree_act_pow_source hρt' hX4 (m + t.n)) E1

    have E3 : σ.comp (Y.act ((r : Zp2 r) ^ c')) =
        ((((u.map (Ideal.Quotient.mk (pIdeal r B))).comp t.ρ).comp δ).comp
            (Y.act ((r : Zp2 r) ^ (t'.n - t.n - c')))).comp (Y.act ((r : Zp2 r) ^ c')) := by
      have this : (σ.comp γ).comp δ =
          (((u.map (Ideal.Quotient.mk (pIdeal r B))).comp t.ρ).comp
            ((t'.Φbar ψ).act ((r : Zp2 r) ^ (t'.n - t.n)))).comp δ := by
        rw [← hfac, ← E2]
      rw [Series.comp_assoc _ _ _ hγ.1.constantCoeff hδ.constantCoeff, hγδ,
        Series.comp_assoc _ _ _ (act_cc _ _) hδ.constantCoeff, ← hδ.2.1,
        ← Series.comp_assoc _ _ _ hδ.constantCoeff (act_cc _ _)] at this
      rw [Series.comp_assoc _ _ _ (act_cc _ ((r : Zp2 r) ^ (t'.n - t.n - c'))) (act_cc _ ((r : Zp2 r) ^ c')),
        ← FormalODModule.act_pow_add, show t'.n - t.n - c' + c' = t'.n - t.n by omega]
      exact this
    have E4 := cancel_right (act_cc _ _) (hY4.hasKernelOfDegree_act_pow c') E3
    exact pack (t'.n - t.n - c') (((u.map (Ideal.Quotient.mk (pIdeal r B))).comp t.ρ).comp δ) (hA.comp hδ) E4
      (by omega)
  ·
    refine pack 0 σ hσ ?_ (by omega)
    rw [pow_zero, Y.act_one, Series.comp_id]

theorem le_and_comp_eq_act_pow_sub_of_eq_comp_act_pow
    {r : ℕ} [Fact r.Prime] {B : Type} [CommRing B] [IsNoetherianRing B] [Nontrivial B]
    (Y X : FormalODModule r B) (hY4 : Y.HasHeight 4) (hX4 : X.HasHeight 4)
    (σ σ₁ τ : Series B) (d k h : ℕ)
    (hσ₁ : FormalODModule.IsODHom Y X σ₁) (hτ : FormalODModule.IsODHom X Y τ)
    (hσ₁deg : FormalODModule.HasKernelOfDegree σ₁ (r ^ h))
    (hright : σ = σ₁.comp (Y.act ((r : Zp2 r) ^ k)))
    (hτσ : τ.comp σ = Y.act ((r : Zp2 r) ^ d)) (hστ : σ.comp τ = X.act ((r : Zp2 r) ^ d)) :
    k ≤ d ∧ τ.comp σ₁ = Y.act ((r : Zp2 r) ^ (d - k)) ∧ σ₁.comp τ = X.act ((r : Zp2 r) ^ (d - k)) := by
  have hdegk : FormalODModule.HasKernelOfDegree (Y.act ((r : Zp2 r) ^ k)) (r ^ (4 * k)) :=
    hY4.hasKernelOfDegree_act_pow k
  have hdegd : FormalODModule.HasKernelOfDegree (Y.act ((r : Zp2 r) ^ d)) (r ^ (4 * d)) :=
    hY4.hasKernelOfDegree_act_pow d

  have h1 : (τ.comp σ₁).comp (Y.act ((r : Zp2 r) ^ k)) = Y.act ((r : Zp2 r) ^ d) := by
    rw [Series.comp_assoc _ _ _ hσ₁.constantCoeff (act_cc _ _), ← hright, hτσ]
  have hdeg1 : FormalODModule.HasKernelOfDegree ((τ.comp σ₁).comp (Y.act ((r : Zp2 r) ^ k))) (r ^ (4 * d)) :=
    h1.symm ▸ hdegd
  obtain ⟨hk4, -⟩ := FormalODModule.HasKernelOfDegree.le_and_of_comp_pow (act_cc Y _)
    (Series.constantCoeff_comp hτ.constantCoeff hσ₁.constantCoeff) hdegk hdeg1
  have hkd : k ≤ d := by omega
  have hsplit : d = (d - k) + k := by omega
  refine ⟨hkd, ?_, ?_⟩
  · apply cancel_right (act_cc Y ((r : Zp2 r) ^ k)) hdegk
    rw [h1]
    conv_lhs => rw [hsplit]
    rw [FormalODModule.act_pow_add]
  · apply cancel_right (act_cc X ((r : Zp2 r) ^ k)) (hX4.hasKernelOfDegree_act_pow k)
    rw [Series.comp_assoc _ _ _ hτ.constantCoeff (act_cc _ _), hτ.2.1,
      ← Series.comp_assoc _ _ _ (act_cc _ _) hτ.constantCoeff, ← hright, hστ]
    conv_lhs => rw [hsplit]
    rw [FormalODModule.act_pow_add]

