open QseriesFormalization QseriesFormalization.PartI QseriesFormalization.PartI.Ch04Franklin in
theorem solution {n r : Nat} (hr : r < n) :
    (staircasePartition n).getD r 0 = n - r := by
  induction n generalizing r with
  | zero =>
      omega
  | succ n ih =>
      cases r with
      | zero =>
          simp [staircasePartition]
      | succ r =>
          have hrn : r < n := by omega
          rw [show (staircasePartition (n + 1)).getD (r + 1) 0 =
              (staircasePartition n).getD r 0 by rfl]
          rw [ih hrn]
          omega
