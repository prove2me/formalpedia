open ModularCurve ModularCurve.IgusaScheme

theorem ModularCurve.IgusaScheme.isReduced_quotient_and_ncard_minimalPrimes_span_natCast_of_not_dvd
    (N p : ℕ) [NeZero N] [Fact p.Prime] (hpN : ¬ p ∣ N) :
    IsReduced (↥(chartAlgFin (N * p) p) ⧸ Ideal.span {((p : ℕ) : ↥(chartAlgFin (N * p) p))}) ∧
    (Ideal.span {((p : ℕ) : ↥(chartAlgFin (N * p) p))}).minimalPrimes.ncard = 2 ∧
    IsReduced (↥(chartAlgInf (N * p) p) ⧸ Ideal.span {((p : ℕ) : ↥(chartAlgInf (N * p) p))}) ∧
    (Ideal.span {((p : ℕ) : ↥(chartAlgInf (N * p) p))}).minimalPrimes.ncard = 2 := by sorry
