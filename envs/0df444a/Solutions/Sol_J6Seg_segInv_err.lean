/-!
# Segmented inverse (S2): exact structure of the resampling system (report L1, L2, L4, L8 tail)

Entries of `N = I + E` are `eEx s t α l h = e^{-πα² X/s²}`, `X = eKz s t l h`.
* `eKz_closed` (L1): `X = sn(sn + 2b_{l+h})` with `n = q_{l+h} - q_l`, and `|n| ≥ |h|`, so
  `eEx_le_cf`: `e_{l,h} ≤ e^{-πα²|h|(|h|-1)}` (cross-wrap / cut entries).
* `eEx_recentre` (L2/L4): inside a wrap-free run starting at `c`,
  `e_{c+u, v-u} = D_u T^{(b_c)}_{uv} D_v⁻¹` with `b_c = bOf c / s`, i.e. `MF` of `J6SegToep`.
* `tail_sum` (truncation): `Σ_{|h| > w} e_{l,h} ≤ 4 e^{-πα² w(w+1)}` for `α ≥ 2`.
* `bOf_periodic`, `eEx_periodic`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf

section geom
variable (s t α : ℕ)

/-- **Closed-form envelope.** `e_{l,h} ≤ e^{-πα²|h|(|h|-1)}`. -/
theorem eEx_le_cf (hs : 0 < s) (hst : s ≤ t) (l h : ℤ) :
    eEx s t α l h ≤ exp (-(π * (α : ℝ) ^ 2 * (|(h : ℝ)| * (|(h : ℝ)| - 1)))) := by
  unfold eEx
  split_ifs with h0
  · exact (exp_pos _).le
  · apply exp_le_exp.2
    have hK := eKz_ge s t hs hst l h
    have hKR : ((s : ℝ)) ^ 2 * (|(h : ℝ)| * (|(h : ℝ)| - 1)) ≤ (eKz s t l h : ℝ) := by
      have := (Int.cast_le (R := ℝ)).2 hK
      push_cast at this; exact this
    have hsR : (0 : ℝ) < (s : ℝ) ^ 2 := by positivity
    have : |(h : ℝ)| * (|(h : ℝ)| - 1) ≤ (eKz s t l h : ℝ) / (s : ℝ) ^ 2 := by
      rw [le_div_iff₀ hsR]; linarith
    have hpa : 0 ≤ π * (α : ℝ) ^ 2 := by positivity
    have := mul_le_mul_of_nonneg_left this hpa
    rw [neg_le_neg_iff]
    calc π * (α : ℝ) ^ 2 * (|(h : ℝ)| * (|(h : ℝ)| - 1)) ≤
        π * (α : ℝ) ^ 2 * ((eKz s t l h : ℝ) / (s : ℝ) ^ 2) := this
      _ = π * (α : ℝ) ^ 2 * (eKz s t l h : ℝ) / (s : ℝ) ^ 2 := by ring

/-- Wrap-free runs: `b_{c+j} = b_c + j(t-s)`. -/
lemma bOf_run (c : ℤ) (m : ℕ) (hwf : ∀ j < m, bOf s t (c + j + 1) = bOf s t (c + j) + (t - s)) :
    ∀ j ≤ m, bOf s t (c + j) = bOf s t c + j * (t - s) := by
  intro j
  induction j with
  | zero => intro _; simp
  | succ j ih =>
    intro hj
    have := hwf j (by omega)
    push_cast
    rw [show c + ((j : ℤ) + 1) = c + j + 1 by ring, this, ih (by omega)]
    ring

/-- **Recentred blocks (L2/L4).** Inside a wrap-free run starting at `c`, the entries of `N` are
those of `D T^{(b_c)} D⁻¹`. -/
theorem eEx_recentre (hs : 0 < s) (c : ℤ) (m : ℕ)
    (hwf : ∀ j < m, bOf s t (c + j + 1) = bOf s t (c + j) + (t - s))
    {u v : ℕ} (hu : u ≤ m) (hv : v ≤ m) (huv : u ≠ v) :
    eEx s t α (c + u) ((v : ℤ) - u) =
      MF (α : ℝ) ((t : ℝ) / s) ((bOf s t c : ℝ) / s) u v := by
  have hr := bOf_run s t c m hwf
  have hbu := hr u hu
  have hbv := hr v hv
  have hne : ((v : ℤ) - u) ≠ 0 := by omega
  unfold eEx MF ddR TF diR
  rw [if_neg hne, ← exp_add, ← exp_add]
  congr 1
  unfold eKz
  rw [show c + (u : ℤ) + ((v : ℤ) - u) = c + v by ring, hbu, hbv]
  have hsR : (s : ℝ) ≠ 0 := by exact_mod_cast hs.ne'
  push_cast
  field_simp
  ring

/-- The diagonal: `D_u T_{uu} D_u⁻¹ = 1`. -/
lemma MF_diag (σ b : ℝ) (u : ℕ) : MF (α : ℝ) σ b u u = 1 := by
  unfold MF TF
  simp only [sub_self, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, mul_zero, add_zero,
    neg_zero, exp_zero, mul_one]
  rw [mul_comm]; exact diR_mul_ddR _ _ u

/-! ### Truncation tail -/

