  set Es : ↥SS → Divisor (AlgebraicClosure ℚ) ↥(xHFunctionFieldBar M H) := fun s => EE.filter (· ∈ (An s).dom) with hEs
  have hEs_apply : ∀ (s : ↥SS), ∀ P ∈ (An s).dom, Es s P = EE P := fun s P hP => by
