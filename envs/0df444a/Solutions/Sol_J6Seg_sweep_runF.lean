-- Source module: Solutions.J6SegILSweep2
/-!
# B-line IL, B6 §2: reading the line descriptor

`hdrA σ dS` (on `dS = descLine6 = p :: α :: h :: d :: (bits ++ svals)`): pop `p, α, h, d` into
`σ 0..3`, move the `d` bits onto `σ 12` while counting the ones in `σ 4`, move them on to `σ 13`
(in order), then `σ 5 := T = 2^{h d + #ones}`, `σ 6 := 1` (`pre`), `σ 8 := 0` (`k`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

theorem bits01 (d : ℕ) (bL : ℕ → Bool) : ∀ b ∈ KFM.bitsZ d bL, b = 0 ∨ b = 1 := by
  intro b hb
  simp only [KFM.bitsZ, List.mem_map, List.mem_range] at hb
  obtain ⟨j, -, rfl⟩ := hb
  split_ifs <;> simp

theorem KFM.bitsZ_sum (P : Prm) (n : ℕ) : ∀ k, (KFM.bitsZ k (bL6 P n)).sum = (cntB P n k : ℤ)
  | 0 => by simp [KFM.bitsZ, cntB]
  | k + 1 => by
      have := KFM.bitsZ_sum P n k
      simp only [KFM.bitsZ, List.range_succ, List.map_append, List.sum_append, List.map_cons,
        List.map_nil, List.sum_cons, List.sum_nil, add_zero, cntB] at this ⊢
      rw [this]; split_ifs <;> push_cast <;> ring

end J6Seg

