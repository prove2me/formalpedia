open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
theorem solution (hN : NullFrameData g gi E Θ U) {F : TwoForm 4} (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    {x : Pt 4} (hx : x ∈ U) (B : Fin 4) :
    Jfr g gi F Θ B x = ∑ P, fdir E P (Fup F E P B) x
      + ∑ P, (∑ K, Omega g gi E Θ K x K P) * Fup F E P B x
      + ∑ P, ∑ R, Omega g gi E Θ P x B R * Fup F E P R x := by
  have hU := hN.isOpen
  have hF := hN.toFrameData
  -- the coordinate vector `J^b` expanded in the frame
  set V : Fin 4 → ℂ := fun K => ∑ P, fdir E P (Fup F E P K) x
      + ∑ P, (∑ L, Omega g gi E Θ L x L P) * Fup F E P K x
      + ∑ P, ∑ R, Omega g gi E Θ P x K R * Fup F E P R x with hV
  have hJ : ∀ b, (maxwellDiv g gi F b x : ℂ) = ∑ K, E K b x * V K := by
    intro b
    have hG : ∀ a, cpdC a (fun z => (raise2 gi F a b z : ℂ)) x
        = ∑ P, ∑ R, (cpdC a (E P a) x * E R b x * Fup F E P R x + E P a x * cpdC a (E R b) x * Fup F E P R x
          + E P a x * E R b x * cpdC a (Fup F E P R) x) := by
      intro a
      rw [cpdC_congr_of_eqOn hU hx (fun z hz => raise2_frame hN F hz a b) a,
        cpdC_sum_of hU hx a Finset.univ fun P _ => ContDiffOn.sum fun R _ =>
          ((hF.smooth_E P a).mul (hF.smooth_E R b)).mul (contDiffOn_Fup hF hFs P R)]
      refine Finset.sum_congr rfl fun P _ => ?_
      rw [cpdC_sum_of hU hx a Finset.univ fun R _ =>
        ((hF.smooth_E P a).mul (hF.smooth_E R b)).mul (contDiffOn_Fup hF hFs P R)]
      refine Finset.sum_congr rfl fun R _ => ?_
      rw [cpdC_mul_of hU hx a ((hF.smooth_E P a).mul (hF.smooth_E R b)) (contDiffOn_Fup hF hFs P R),
        cpdC_mul_of hU hx a (hF.smooth_E P a) (hF.smooth_E R b)]
      ring
    have hmd : (maxwellDiv g gi F b x : ℂ) = ∑ a, (cpdC a (fun z => (raise2 gi F a b z : ℂ)) x
        + ∑ k, ((christoffel g gi a a k x : ℂ) * (raise2 gi F k b x : ℂ)
          + (christoffel g gi b a k x : ℂ) * (raise2 gi F a k x : ℂ))) := by
      simp only [maxwellDiv, cpdC_ofReal]; push_cast; rfl
    have hR : ∑ K, E K b x * V K = ∑ P, ∑ K, E K b x * fdir E P (Fup F E P K) x
        + ∑ P, (∑ L, Omega g gi E Θ L x L P) * ∑ K, E K b x * Fup F E P K x
        + ∑ P, ∑ R, (∑ K, Omega g gi E Θ P x K R * E K b x) * Fup F E P R x := by
      simp only [hV, Fin.sum_univ_four]
      ring
    rw [hmd, hR]
    simp only [omega_trace hF hx, omega_expand hF hx, hG, raise2_frame hN F hx, fdir, Fin.sum_univ_four]
    ring
  clear_value V
  unfold Jfr
  simp only [hJ, Finset.mul_sum]
  rw [Finset.sum_comm]
  have h : ∀ K, ∑ b, Θ B b x * (E K b x * V K) = (1 : Matrix (Fin 4) (Fin 4) ℂ) B K * V K := by
    intro K; rw [← hF.dual_apply hx B K, Finset.sum_mul]; exact Finset.sum_congr rfl fun b _ => by ring
  simp only [h, Matrix.one_apply, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
  rw [hV]
