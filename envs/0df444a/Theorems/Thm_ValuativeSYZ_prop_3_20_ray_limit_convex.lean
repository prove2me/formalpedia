-- title:
--   Proposition 3.20 (2), convexity step: the limits are convex in the direction
-- statement:
--   **Proposition 3.20 (2), convexity step.** The limits produced by the Fekete step are convex as the
--   direction varies: in the paper, $c(x,p;y)$ is convex in $p$ on the interior of the Okounkov body
--   $\Delta_y$. This milestone records the inequality that produces that convexity, at the level of the
--   semigroup: if $g$ and $g'$ are the normalised limits along the rays generated by $(l,q)$ and
--   $(l',q')$, and $h$ is the normalised limit along the ray generated by their sum, then
--   $$(l + l')\,h \;\le\; l\,g + l'\,g'.$$
--   Dividing by $l + l'$ exhibits $h$, attached to the direction $\frac{q+q'}{l+l'}$, as dominated by
--   the convex combination of $g$ and $g'$ with weights $\frac{l}{l+l'}$ and $\frac{l'}{l+l'}$.
-- source:
--   Yang Li, *Valuative independence and metric SYZ conjecture*, arXiv:2605.00516v1 (1 May 2026), https://arxiv.org/abs/2605.00516, pp. 22, Proposition 3.20 item 2

import Mathlib
import Definitions.Def_ValuativeSYZ_cost_transform
import Definitions.Def_ValuativeSYZ_degeneration

set_option autoImplicit false

open MeasureTheory

namespace ValuativeSYZ

/-- **Proposition 3.20 (2), convexity step.** The normalised limits of a subadditive function
along the rays of the semigroup are convex under the semigroup addition: the limit attached to
the sum of two rays is dominated by the corresponding weighted average. -/
theorem prop_3_20_ray_limit_convex {n : ℕ} (F : ℕ → (Fin n → ℤ) → ℝ)
    (hsub : ∀ (l l' : ℕ) (q q' : Fin n → ℤ), F (l + l') (q + q') ≤ F l q + F l' q')
    (l l' : ℕ) (hl : 0 < l) (hl' : 0 < l') (q q' : Fin n → ℤ) (g g' h : ℝ)
    (hg : Filter.Tendsto (fun m : ℕ => F (m * l) (m • q) / (m * l)) Filter.atTop (nhds g))
    (hg' : Filter.Tendsto (fun m : ℕ => F (m * l') (m • q') / (m * l')) Filter.atTop (nhds g'))
    (hh : Filter.Tendsto (fun m : ℕ => F (m * (l + l')) (m • (q + q')) / (m * (l + l')))
      Filter.atTop (nhds h)) :
    ((l : ℝ) + l') * h ≤ l * g + l' * g' := by sorry

/-! ### Milestone: the optimal transport formulation (§4.2) -/

end ValuativeSYZ
