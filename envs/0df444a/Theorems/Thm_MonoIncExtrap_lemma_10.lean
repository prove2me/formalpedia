-- title:
--   Lemma 10, p.21 — $\mathcal S_k\subseteq\mathcal Q$, $\widehat{\mathcal S}_k\subseteq\widehat{\mathcal Q}$
-- statement:
--   Assume the standing assumptions of §3: $\varepsilon>0$, $\gamma_0>0$, $z^0\in\mathrm{dom}\,B$, $0<\delta<1$, $0<\nu\le1/2$, $\eta\in[0,\nu/(1+\nu))$, $\rho_0\ge1$, $0<\tau_0\le1$, $\zeta>1$, $0<\sigma<1/\zeta$, Assumption 1 with $\mu=0$, and let $x^*$ be an arbitrary fixed solution of (1). For a completed outer iteration $k$ of Algorithm 2, let $L_{\mathcal Q},L_{\widehat{\mathcal Q}}$ be as in Lemma 2 and
--   $$
--   \mathcal S_k=\Bigl\{x\in\mathrm{dom}\,B:\|x-z_*^k\|\le\frac{\|z^k-z_*^k\|}{\sqrt{1-2\nu^2}}\Bigr\},\quad\widehat{\mathcal S}_k=\Bigl\{x\in\mathrm{dom}\,B:\|x-z_*^k\|\le\frac{5+9\gamma_0L_{\mathcal Q}}{3\sqrt{1-2\nu^2}}\|z^k-z_*^k\|\Bigr\}.
--   $$
--   Then $\mathcal S_k\subseteq\mathcal Q$ and $\widehat{\mathcal S}_k\subseteq\widehat{\mathcal Q}$. Consequently $F_k$ is $L_{\mathcal Q}$-Lipschitz on $\mathcal S_k$ and $L_{\widehat{\mathcal Q}}$-Lipschitz on $\widehat{\mathcal S}_k$.
--
--   These are the sets of Lemma 1 for the $k$-th subproblem, so the uniform constants of Lemma 2 serve every call of Algorithm 1.
--
--   Differences from the source:
--   - encoding: $F$ is a point-valued operator on $\mathrm{cl}(\mathrm{dom}\,B)$ → a total map on $\mathbb R^n$, constrained only on $\mathrm{cl}(\mathrm{dom}\,B)$; reason: values of $F$ elsewhere never enter $F+B$ or a run, since iterates lie in $\mathrm{dom}\,B$
--   - encoding: Assumption 1(d), the resolvent of $\gamma B$ can be exactly evaluated → a family $J$ with $J_\gamma=(I+\gamma B)^{-1}$ for every $\gamma>0$; reason: the assumption has no mathematical content; the family exists and is unique on $\gamma>0$
--   - encoding: iterates generated by Algorithm 2, $0\le k\in\mathbb K-1$ → the prefix predicate `Alg2.IsPrefix` at index $s$, with $k<s$; reason: $k\in\mathbb K-1$ says exactly that $z^{k+1}$ has been generated
--   - generalization: $L_{\mathcal Q},L_{\widehat{\mathcal Q}}$ are the constants given by Lemma 2, for some choice → every pair valid in the sense of Lemma 2; reason: the proof uses only the two Lipschitz bounds, and Lemma 2 supplies such a pair, so the printed statement is the instance at that pair
--   - encoding: $z_*^k=(I+\rho_k(F+B))^{-1}(z^k)$, (67), in (73) and (74) → any $w$ with $\rho_k^{-1}(z^k-w)\in(F+B)(w)$; reason: (67) is that relation; such a point is unique because $F+B$ is monotone, and it exists by Lemma 8
-- source:
--   Lu & Mei, Primal-dual extrapolation methods for monotone inclusions under local Lipschitz continuity, arXiv:2206.00973v3, Lemma 10, p.21

import Mathlib
import Definitions.Def_ThreeOpSplitting_Convergence_MonotoneOperators
import Definitions.Def_MonoIncExtrap_Setting
import Definitions.Def_MonoIncExtrap_Algorithm1
import Definitions.Def_MonoIncExtrap_Algorithm2

open InnerProductSpace ThreeOpSplitting.Convergence

namespace MonoIncExtrap

/-- **Lemma 10.** arXiv:2206.00973v3, Lemma 10, p.21. For a run of Algorithm 2, a completed outer
iteration `k`, and `w = z∗ᵏ` of (67): `S_k ⊆ Q` and `Ŝ_k ⊆ Q̂`, where `S_k` is (73) and `Ŝ_k` is (74);
consequently `F_k` is `L_Q`-Lipschitz continuous on `S_k` and `L_Q̂`-Lipschitz continuous on `Ŝ_k`.

**Formalization Note.** `S_k = setS B w ‖zᵏ − w‖ ν` and `Ŝ_k = setShat B w ‖zᵏ − w‖ ν γ0 L_Q`. The
pair `L_Q, L_Q̂` is any valid pair of Lemma 2. -/
theorem lemma_10 {n : ℕ}
    {B : EuclideanSpace ℝ (Fin n) → Set (EuclideanSpace ℝ (Fin n))}
    {I : Alg2.Input (EuclideanSpace ℝ (Fin n))} {xstar : EuclideanSpace ℝ (Fin n)}
    (hI : Alg2.Standing B I xstar)
    {z : ℕ → EuclideanSpace ℝ (Fin n)} {c : ℕ → ℕ} {s : ℕ}
    (hz : Alg2.IsPrefix I z c s) {k : ℕ} (hk : k < s)
    {w : EuclideanSpace ℝ (Fin n)} (hw : IsResolventPoint (I.rho k) (sumOp I.F B) (z k) w)
    {LQ LQhat : ℝ} (hv : Alg2.ValidQ B I xstar LQ LQhat) :
    Alg1.setS B w ‖z k - w‖ I.ν ⊆ Alg2.setQ B I xstar ∧
    Alg1.setShat B w ‖z k - w‖ I.ν I.γ0 LQ ⊆ Alg2.setQhat B I xstar LQ ∧
    IsLipschitzOn (perturb I.F (I.rho k) (z k)) (Alg1.setS B w ‖z k - w‖ I.ν) LQ ∧
    IsLipschitzOn (perturb I.F (I.rho k) (z k)) (Alg1.setShat B w ‖z k - w‖ I.ν I.γ0 LQ)
      LQhat := by sorry

end MonoIncExtrap
