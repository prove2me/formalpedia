theorem Inv.encK {G0 : Fin HS → List Item} {s : IState HS} (h : NLogN.KIL.Inv G0 s) {f : Fin HS → List ℤ}
    (hf : ∀ r, Prot r → f r = []) : NLogN.KIL.Inv G0 (encK s f) := fun r hr => by
  simp [hf r hr, h r hr]

theorem not_prot {r : Fin HS} (h : r.val < 22) : ¬ Prot r := fun h' => by
  unfold Prot at h'; omega

theorem not_prot_rT : ¬ Prot rT := fun h => h.2 rfl

theorem RegS.upd {s : IState HS} {f : Fin HS → List ℤ} {W v : ℕ} (h : RegS s f W v) {i : Fin HS}
    (hi : i.val < 22) (l : List ℤ) : RegS s (Function.update f i l) W v := by
  have h1 : NLogN.KIL.rV ≠ i := fun e => by rw [← e] at hi; exact absurd hi (by decide)
  have h2 : rWV ≠ i := fun e => by rw [← e] at hi; exact absurd hi (by decide)
  have h3 : NLogN.KIL.rT ≠ i := fun e => by rw [← e] at hi; exact absurd hi (by decide)
  exact ⟨by simp [h1, h.fV], by simp [h2, h.fWV], by simp [h3, h.fT], h.sV, h.sWV⟩

theorem RegS.gV {s : IState HS} {f : Fin HS → List ℤ} {W v : ℕ} (h : RegS s f W v) :
    ∃ L, (encK s f).G NLogN.KIL.rV = .int (v : ℤ) :: L := by
  obtain ⟨L, hL⟩ := h.sV; exact ⟨L, by simp [h.fV, hL]⟩

theorem rsim_dupK (X Y Z C r : Fin HS) (k : ℕ) :
    RSim (pmOf [(r, (k : ℤ))]) (NLogN.KIL.dupK X Y Z C k) (dupKE X Y Z C (.reg r)) :=
  .rep C (.par (pmOf_cons_self _ _ _)) (RSim.refl _ _)

theorem rsim_dropK (X C r : Fin HS) (k : ℕ) :
    RSim (pmOf [(r, (k : ℤ))]) (NLogN.KIL.dropK X C k) (dropKE X C (.reg r)) :=
  .rep C (.par (pmOf_cons_self _ _ _)) (RSim.refl _ _)

theorem rsim_zeroK (Y C r : Fin HS) (k : ℕ) :
    RSim (pmOf [(r, (k : ℤ))]) (NLogN.KIL.zeroK Y C k) (zeroKE Y C (.reg r)) :=
  .rep C (.par (pmOf_cons_self _ _ _)) (RSim.refl _ _)

theorem rsim_zipK (A Z O C r : Fin HS) (k : ℕ) :
    RSim (pmOf [(r, (k : ℤ))]) (NLogN.KIL.zipK A Z O C k) (zipKE A Z O C (.reg r)) :=
  .rep C (.par (pmOf_cons_self _ _ _)) (RSim.refl _ _)

section Apply

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- A code with a stack-`0` specification under the invariant, run on a managed state. -/
theorem irun_topJ {G0 : Fin HS → List Item} {code : IStmt HS Pp} {ys ys' : List ℤ} {c : ℕ}
    (h : ∀ (t : IState HS) (R : List Item), NLogN.KIL.Inv G0 t → IRuns I iprog code (t.upd 0 (ints ys ++ R))
      (t.upd 0 (ints ys' ++ R)) c)
    (s : IState HS) (hs : NLogN.KIL.Inv G0 s) (f : Fin HS → List ℤ) (hf : ∀ r, Prot r → f r = [])
    (rest : List ℤ) (h0 : f 0 = ys ++ rest) :
    IRuns I iprog code (encK s f) (encK s (Function.update f 0 (ys' ++ rest))) c := by
  have H := h (encK s f) (ints rest ++ s.G 0) (hs.encK hf)
  have e1 : (encK s f).upd 0 (ints ys ++ (ints rest ++ s.G 0)) = encK s f := by
    rw [← List.append_assoc, ← ints_append, ← h0]
    exact IState.upd_self _ _
  rw [e1] at H
  refine H.mono' ?_ le_rfl
  rw [← List.append_assoc, ← ints_append]
  apply IState.ext' <;> intros <;> simp [IState.upd_G, Function.update_apply] <;> split_ifs <;> simp_all

end Apply

theorem encK_rV {s : IState HS} {g : Fin HS → List ℤ} {v : ℤ} {L : List Item}
    (hs : s.G NLogN.KIL.rV = .int v :: L) (hg : g NLogN.KIL.rV = []) : (encK s g).G NLogN.KIL.rV = .int v :: L := by
  simp [hg, hs]

end NLogN.KIL

