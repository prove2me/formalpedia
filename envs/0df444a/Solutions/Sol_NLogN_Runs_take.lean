/-- `machine` driven by an explicit description `F k` of the state after `k` steps. -/
theorem Runs.machine_of {q : Fin S} {w : List (Fin S)} {q0 : Sym}
    {δ : List (Option Sym) → List (Op S)} (B : ℕ) (hB : ∀ os, (δ os).length ≤ B)
    (σ : St S) (F : ℕ → St S) (m : ℕ) (h0 : F 0 = σ.push q q0)
    (hstep : ∀ k < m, mstep I q w δ (F k) = F (k + 1))
    (hrun : ∀ k < m, (F k).top q ≠ some hlt) (hstop : (F m).top q = some hlt) :
    Runs I prog (NLogN.machine q w q0 δ : Stmt S P) σ ((F m).pop q)
      (m * (B + 17 * w.length + 19) + 3) := by
  have hit : ∀ k ≤ m, (mstep I q w δ)^[k] (σ.push q q0) = F k := by
    intro k hk
    induction k with
    | zero => simp [h0]
    | succ k ih => rw [Function.iterate_succ_apply', ih (by omega), hstep k (by omega)]
  rw [← hit m le_rfl]
  exact Runs.machine B hB σ m (fun k hk => by rw [hit k hk.le]; exact hrun k hk)
    (by rw [hit m le_rfl]; exact hstop)

end NLogN

