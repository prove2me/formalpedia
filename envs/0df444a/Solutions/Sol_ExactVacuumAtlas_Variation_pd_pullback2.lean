/-!
# Transport layer II.a: calculus rules for the coordinate derivative `pd` (ATLAS-II)

Generic (dimension `n`) rules for the registered slice derivative `pd i f x = deriv (u ↦ f (x[i := u])) (x i)`
(`Atlas/Core/Basic.lean`, unchanged). Every rule is stated for `C^∞` fields on an **open** set `U`, so
that each `pd` is a genuine derivative (`hasDerivAt_pd`) and no junk value of `deriv` is ever used:

* linearity, product rule, finite sums (`pd_add_of`, `pd_mul_of`, `pd_sum_of`, …);
* **chain rule** `pd i (f ∘ Φ) y = Σ_e (∂_e f)(Φ y) · J y e i` for a map `Φ` with genuine slice
  derivatives `J` (`pd_comp`);
* **symmetry of mixed partials** `pd i (pd j f) = pd j (pd i f)` for `C^∞` `f` (`pd_pd_symm`), from
  Mathlib's `ContDiffAt.isSymmSndFDerivAt`.

No new definitions. Nothing here assumes or mentions a metric.
-/

open Filter Topology
open scoped ContDiff

namespace ExactVacuumAtlas

variable {n : ℕ}

section rules

variable {U : Set (Pt n)} (hU : IsOpen U) {y : Pt n} (hy : y ∈ U) (i : Fin n)
include hU hy

theorem pd_mul_of {f g : Pt n → ℝ} (hf : ContDiffOn ℝ ∞ f U) (hg : ContDiffOn ℝ ∞ g U) :
    pd i (fun z => f z * g z) y = pd i f y * g y + f y * pd i g y := by
  have h := ((hasDerivAt_pd hU hf hy i).mul (hasDerivAt_pd hU hg hy i)).deriv
  simp only [Function.update_eq_self] at h
  exact h

theorem pd_sum_of {ι : Type*} (s : Finset ι) {f : ι → Pt n → ℝ}
    (hf : ∀ e ∈ s, ContDiffOn ℝ ∞ (f e) U) :
    pd i (fun z => ∑ e ∈ s, f e z) y = ∑ e ∈ s, pd i (f e) y :=
  (HasDerivAt.fun_sum fun e he => hasDerivAt_pd hU (hf e he) hy i).deriv

end rules

end ExactVacuumAtlas

