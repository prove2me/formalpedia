noncomputable section
universe u
namespace MazurTransfer.Order13SingleSectionFiniteAlgebra
open CategoryTheory AlgebraicGeometry
open MazurTorsion.XOneThirteenProjectiveCurve
open Order13ActualPositiveInfinityComplement
variable (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]

def candidateToReciprocalPatch (h104 : IsUnit (104 : R)) : candidateAlgebra R →ₐ[R]
    Order13SingleSectionReciprocalPatch.PatchRing R :=
  (recoveredReciprocalPatchEquiv R h104).symm.toAlgHom.comp
    (IsScalarTower.toAlgHom R (candidateAlgebra R) (infinityLocalization R))

theorem candidateToReciprocalPatch_parameter (h104 : IsUnit (104 : R)) :
    candidateToReciprocalPatch R h104 (parameterElement R) =
      Order13SingleSectionReciprocalPatch.tau R := by
  apply (recoveredReciprocalPatchEquiv R h104).injective
  change (recoveredReciprocalPatchEquiv R h104)
    ((recoveredReciprocalPatchEquiv R h104).symm (infinityParameter R)) = _
  rw [AlgEquiv.apply_symm_apply,recoveredReciprocalPatchEquiv_tau]

theorem candidateToReciprocalPatch_p (h104 : IsUnit (104 : R)) :
    candidateToReciprocalPatch R h104 (pElement R) =
      Order13SingleSectionReciprocalPatch.mu R := by
  apply (recoveredReciprocalPatchEquiv R h104).injective
  change (recoveredReciprocalPatchEquiv R h104)
    ((recoveredReciprocalPatchEquiv R h104).symm (infinityP R)) = _
  rw [AlgEquiv.apply_symm_apply,recoveredReciprocalPatchEquiv_mu]

theorem reciprocal_finite_mem_ordinary_range_iff (h104 : IsUnit (104 : R))
    (b : PrimeSpectrum (Order13SingleSectionReciprocalPatch.PatchRing R)) :
    reciprocalToFiniteAffineScheme R h104 b ∈ Set.range (ordinaryToFiniteAffineScheme R) ↔
      Order13SingleSectionReciprocalPatch.z R ∉ b.asIdeal := by
  rw [ordinaryToFiniteAffineScheme_range R (two_isUnit_of_104 R h104)]
  change candidateToReciprocalPatch R h104 (parameterElement R) ∉ b.asIdeal ∨
      candidateToReciprocalPatch R h104 (pElement R + 2) ∉ b.asIdeal ↔ _
  rw [candidateToReciprocalPatch_parameter,map_add,_root_.map_ofNat,candidateToReciprocalPatch_p]
  open Order13SingleSectionReciprocalPatch in
    have ht := tau_eq_z_mul_mu R
  open Order13SingleSectionReciprocalPatch in
    have hq := z_mul_nu R
  have hm : Order13SingleSectionReciprocalPatch.mu R ∉ b.asIdeal := by
    intro h
    exact b.isPrime.ne_top (b.asIdeal.eq_top_of_isUnit_mem h
      (Order13SingleSectionReciprocalPatch.mu_isUnit R (two_isUnit_of_104 R h104)))
  constructor
  · rintro (h | h) hz
    · rw [ht] at h
      exact h (b.asIdeal.mul_mem_right _ hz)
    · rw [← hq] at h
      exact h (b.asIdeal.mul_mem_right _ hz)
  · intro hz
    left
    rw [ht]
    intro h
    exact (b.isPrime.mem_or_mem h).elim hz hm

theorem reciprocal_curve_mem_ordinary_range_iff
    (b : PrimeSpectrum (Order13SingleSectionReciprocalPatch.PatchRing R)) :
    reciprocalPatchChartMap R b ∈ Set.range (ordinaryChartMap R) ↔
      Order13SingleSectionReciprocalPatch.z R ∉ b.asIdeal := by
  have he := Set.ext_iff.mp
    (Order13ActualTwoChartRangeOverlap.reciprocalChartMap_preimage_ordinary_range R)
      (reciprocalPatchInclusion R b)
  exact he

theorem ordinary_reciprocal_points_identified (h104 : IsUnit (104 : R))
    (a : MazurTorsion.XOneThirteenAffineCurve.scheme R)
    (b : PrimeSpectrum (Order13SingleSectionReciprocalPatch.PatchRing R))
    (hab : ordinaryChartMap R a = reciprocalPatchChartMap R b) :
    ordinaryToFiniteAffineScheme R a = reciprocalToFiniteAffineScheme R h104 b := by
  have hb : reciprocalPatchChartMap R b ∈ Set.range (ordinaryChartMap R) := ⟨a,hab⟩
  have hf : reciprocalToFiniteAffineScheme R h104 b ∈ Set.range (ordinaryToFiniteAffineScheme R) :=
    (reciprocal_finite_mem_ordinary_range_iff R h104 b).mpr
      ((reciprocal_curve_mem_ordinary_range_iff R b).mp hb)
  obtain ⟨a',ha'⟩ := hf
  have hv : ordinaryChartMap R a' = reciprocalPatchChartMap R b := by
    have hh := congrArg (finiteModelToCurve R h104) ha'
    change (ordinaryToFiniteAffineScheme R ≫ finiteModelToCurve R h104) a' =
      (reciprocalToFiniteAffineScheme R h104 ≫ finiteModelToCurve R h104) b at hh
    rwa [ordinaryToFiniteAffineScheme_finiteModelToCurve,
      reciprocalToFiniteAffineScheme_finiteModelToCurve] at hh
  have haa' : a = a' := (ordinaryChartMap R).isOpenEmbedding.injective (hab.trans hv.symm)
  rwa [haa']

theorem finiteModelToCurve_injective (h104 : IsUnit (104 : R)) :
    Function.Injective (finiteModelToCurve R h104) := by
  intro p q hpq
  have hp : p ∈ Set.range (ordinaryToFiniteAffineScheme R) ∪
      Set.range (reciprocalToFiniteAffineScheme R h104) := by
    rw [finiteScheme_two_chart_range_cover];trivial
  have hq : q ∈ Set.range (ordinaryToFiniteAffineScheme R) ∪
      Set.range (reciprocalToFiniteAffineScheme R h104) := by
    rw [finiteScheme_two_chart_range_cover];trivial
  rcases hp with ⟨a,rfl⟩ | ⟨b,rfl⟩ <;> rcases hq with ⟨a',rfl⟩ | ⟨b',rfl⟩
  · simp only [← Scheme.Hom.comp_apply,ordinaryToFiniteAffineScheme_finiteModelToCurve] at hpq
    exact congrArg (ordinaryToFiniteAffineScheme R) ((ordinaryChartMap R).isOpenEmbedding.injective hpq)
  · simp only [← Scheme.Hom.comp_apply,ordinaryToFiniteAffineScheme_finiteModelToCurve,
      reciprocalToFiniteAffineScheme_finiteModelToCurve] at hpq
    exact ordinary_reciprocal_points_identified R h104 a b' hpq
  · simp only [← Scheme.Hom.comp_apply,ordinaryToFiniteAffineScheme_finiteModelToCurve,
      reciprocalToFiniteAffineScheme_finiteModelToCurve] at hpq
    exact (ordinary_reciprocal_points_identified R h104 a' b hpq.symm).symm
  · simp only [← Scheme.Hom.comp_apply,reciprocalToFiniteAffineScheme_finiteModelToCurve] at hpq
    exact congrArg (reciprocalToFiniteAffineScheme R h104)
      ((reciprocalPatchChartMap R).isOpenEmbedding.injective hpq)

theorem finiteModelToCurve_isOpenImmersion (h104 : IsUnit (104 : R)) :
    IsOpenImmersion (finiteModelToCurve R h104) := by
  apply IsOpenImmersion.of_openCover_source _ (finiteSchemeOpenCover R h104)
    (finiteModelToCurve_injective R h104)
  intro b
  cases b with
  | true =>
    change IsOpenImmersion (ordinaryToFiniteAffineScheme R ≫ finiteModelToCurve R h104)
    rw [ordinaryToFiniteAffineScheme_finiteModelToCurve]
    infer_instance
  | false =>
    change IsOpenImmersion (reciprocalToFiniteAffineScheme R h104 ≫ finiteModelToCurve R h104)
    rw [reciprocalToFiniteAffineScheme_finiteModelToCurve]
    infer_instance

theorem finiteModelToCurve_opensRange (h104 : IsUnit (104 : R)) :
    letI := finiteModelToCurve_isOpenImmersion R h104
    (finiteModelToCurve R h104).opensRange = sectionComplementOpen R := by
  let := finiteModelToCurve_isOpenImmersion R h104
  apply SetLike.ext'
  exact finiteModelToCurve_range R h104

def finiteModelSectionComplementIso (h104 : IsUnit (104 : R)) :
    finiteAffineScheme R ≅ (sectionComplementOpen R).toScheme := by
  let := finiteModelToCurve_isOpenImmersion R h104
  exact IsOpenImmersion.isoOfRangeEq (finiteModelToCurve R h104)
    (sectionComplementOpen R).ι (by
      rw [Scheme.Opens.range_ι]
      exact finiteModelToCurve_range R h104)

theorem finiteModelSectionComplementIso_hom_ι (h104 : IsUnit (104 : R)) :
    (finiteModelSectionComplementIso R h104).hom ≫ (sectionComplementOpen R).ι =
      finiteModelToCurve R h104 := by
  let := finiteModelToCurve_isOpenImmersion R h104
  exact IsOpenImmersion.isoOfRangeEq_hom_fac _ _ (by
    rw [Scheme.Opens.range_ι]
    exact finiteModelToCurve_range R h104)

theorem finiteModelSectionComplementIso_inv_comp (h104 : IsUnit (104 : R)) :
    (finiteModelSectionComplementIso R h104).inv ≫ finiteModelToCurve R h104 =
      (sectionComplementOpen R).ι := by
  let := finiteModelToCurve_isOpenImmersion R h104
  exact IsOpenImmersion.isoOfRangeEq_inv_fac _ _ (by
    rw [Scheme.Opens.range_ι]
    exact finiteModelToCurve_range R h104)

theorem sectionComplementOpen_isAffineOpen (h104 : IsUnit (104 : R)) :
    IsAffineOpen (sectionComplementOpen R) := by
  letI : IsAffine (finiteAffineScheme R) := by
    unfold finiteAffineScheme
    infer_instance
  exact IsAffine.of_isIso (finiteModelSectionComplementIso R h104).inv

end MazurTransfer.Order13SingleSectionFiniteAlgebra
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.finiteModelToCurve_isOpenImmersion
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.finiteModelSectionComplementIso

