section
-- Source module: Solutions.NetProp7Route
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option synthInstance.maxSize 512

namespace NetProp7

open Matrix Finset AModel NetScalar

section Rev

variable {W : Type*} [Fintype W] [DecidableEq W]

lemma runMat_reverse_cons (g : SGate W) (l : List (SGate W)) :
    NetScalar.runMat (g :: l).reverse = g.1 * NetScalar.runMat l.reverse := by
  rw [List.reverse_cons, NetScalar.runMat_append]
  simp [NetScalar.runMat]

/-- For involutive gates, the reversed list is the inverse. -/
lemma runMat_reverse_mul (l : List (SGate W)) (h : ∀ g ∈ l, g.1 * g.1 = 1) :
    NetScalar.runMat l.reverse * NetScalar.runMat l = 1 := by
  induction l with
  | nil => simp [NetScalar.runMat]
  | cons g l ih =>
    rw [runMat_reverse_cons, NetScalar.runMat_cons]
    have e : g.1 * NetScalar.runMat l.reverse * (NetScalar.runMat l * g.1) =
        g.1 * (NetScalar.runMat l.reverse * NetScalar.runMat l) * g.1 := by simp only [mul_assoc]
    rw [e, ih (fun g' hg' => h g' (List.mem_cons_of_mem _ hg')), mul_one,
      h g List.mem_cons_self]

lemma runMat_reverse_eq (l : List (SGate W)) (h : ∀ g ∈ l, g.1 * g.1 = 1)
    (hl : NetScalar.runMat l * NetScalar.runMat l = 1) : NetScalar.runMat l.reverse = NetScalar.runMat l := by
  calc NetScalar.runMat l.reverse = NetScalar.runMat l.reverse * (NetScalar.runMat l * NetScalar.runMat l) := by rw [hl, mul_one]
    _ = NetScalar.runMat l := by rw [← mul_assoc, runMat_reverse_mul l h, one_mul]

lemma one_add_sq {E : Matrix W W (ZMod 2)} (hE : E * E = 0) : (1 + E) * (1 + E) = 1 := by
  rw [add_mul, mul_add, mul_add, hE, one_mul, mul_one, one_mul, add_zero, add_assoc,
    two_eq_zero_mat, add_zero]

end Rev

section Inv

variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}
variable {W : Type*} [Fintype W] [DecidableEq W]

lemma _root_.NetScalar.Inv.named_invol (I : NetScalar.Inv ind W) (hG : I.Good) : ∀ g ∈ I.named, g.2.1 * g.2.1 = 1 := by
  intro g hg
  simp only [NetScalar.Inv.named, List.mem_append, List.mem_map, Finset.mem_toList, Finset.mem_univ,
    true_and, List.mem_singleton] at hg
  have hs : ∀ S, (I.sideG S).1 * (I.sideG S).1 = 1 := fun S =>
    one_add_sq (NetScalar.egM_mul_zero _ _ _ _ _ _ fun _ _ => (hG.ts _ _).symm)
  have hc : ∀ t, (I.copyG t).1 * (I.copyG t).1 = 1 := fun t =>
    one_add_sq (NetScalar.egM_mul_zero _ _ _ _ _ _ fun _ _ => hG.ss _ _)
  have hsc : I.scatG.1 * I.scatG.1 = 1 :=
    one_add_sq (NetScalar.egM_mul_zero _ _ _ _ _ _ fun _ _ => (hG.tc _ _).symm)
  have hga : I.gathG.1 * I.gathG.1 = 1 :=
    one_add_sq (NetScalar.egM_mul_zero _ _ _ _ _ _ fun _ _ => hG.sc _ _)
  rcases hg with ((((((⟨S, rfl⟩ | rfl) | ⟨t, rfl⟩) | rfl) | rfl) | ⟨S, rfl⟩) | rfl) | ⟨t, rfl⟩
  exacts [hs S, hsc, hc t, hga, hsc, hs S, hga, hc t]

lemma _root_.NetScalar.Inv.runMat_gates_reverse (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind)
    (I : NetScalar.Inv ind W) (hG : I.Good) : NetScalar.runMat I.gates.reverse = 1 + I.Jm := by
  rw [runMat_reverse_eq _ (fun g hg => by
      obtain ⟨g', hg', rfl⟩ := List.mem_map.1 hg
      exact I.named_invol hG g' hg'),
    I.runMat_gates hcard hinj hG]
  rw [I.runMat_gates hcard hinj hG]
  exact one_add_sq (NetScalar.egM_mul_zero _ _ _ _ _ _ fun _ _ => hG.st _ _)

end Inv

section Bit

variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] (ind : T → Finset (Fin h))

variable {ind}

lemma blk_map_snd (j : Fin 3) (p : T × T) :
    (NetProp7.blk ind j p).map Prod.snd =
      if j = 1 then (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).gates.reverse
      else (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).gates := by
  unfold NetProp7.blk NetScalar.Inv.gates
  split_ifs <;> simp [List.map_reverse, List.map_map, Function.comp_def]

lemma runMat_blk (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) (j : Fin 3)
    (p : T × T) : NetScalar.runMat ((NetProp7.blk ind j p).map Prod.snd) = 1 + (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).Jm := by
  rw [blk_map_snd]
  split_ifs
  · exact (NetScalar.inv j p).runMat_gates_reverse hcard hinj (NetScalar.inv_good j p)
  · exact (NetScalar.inv j p).runMat_gates hcard hinj (NetScalar.inv_good j p)

lemma runMat_stage7 (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) (j : Fin 3) :
    NetScalar.runMat ((univ : Finset (T × T)).toList.flatMap fun p => (NetProp7.blk ind j p).map Prod.snd) =
      1 + NetScalar.Kst j := by
  rw [NetScalar.runMat_flatMap _ _ (fun p => (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).Jm)
    (fun p _ => runMat_blk hcard hinj j p)
    (fun _ _ _ _ => NetScalar.egM_mul_zero _ _ _ _ _ _ fun _ _ => NetScalar.srcW_ne_tgtW _ _ _),
    Finset.sum_map_toList]
  congr 1
  unfold NetScalar.Kst NetScalar.Inv.Jm NetScalar.egM
  exact sum_emb j fun a => single (NetScalar.tgtW j a) (NetScalar.srcW j a) (1 : ZMod 2)

lemma runMat_named7 (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind) :
    NetScalar.runMat ((named7 ind).map Prod.snd) = NetScalar.runMat (bitGates ind) := by
  rw [runMat_bitGates hcard hinj]
  have : (named7 ind).map Prod.snd = ([0, 1, 2] : List (Fin 3)).flatMap fun j =>
      (univ : Finset (T × T)).toList.flatMap fun p => (NetProp7.blk ind j p).map Prod.snd := by
    simp only [named7, List.map_flatMap]
  rw [this]
  simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil, NetScalar.runMat_append,
    runMat_stage7 hcard hinj, mul_assoc]

theorem bit_exchange7 (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind)
    (v : NetScalar.Wr ind → ZMod 2) (w : NetScalar.Wr ind) :
    NetScalar.sRun ((named7 ind).map Prod.snd) v (NetScalar.ρ ind w) = v w := by
  rw [NetScalar.sRun_eq, runMat_named7 hcard hinj, ← NetScalar.sRun_eq]
  exact bit_exchange hcard hinj v w

theorem named7_ok : ∀ g ∈ named7 ind, NetScalar.SOK g.2 := by
  intro g hg
  simp only [named7, List.mem_flatMap] at hg
  obtain ⟨j, _, p, _, hg⟩ := hg
  unfold NetProp7.blk at hg
  split_ifs at hg
  · rw [List.mem_reverse] at hg
    obtain ⟨g', hg', rfl⟩ := List.mem_map.1 hg
    exact (NetScalar.inv j p).gates_ok g' hg'
  · obtain ⟨g', hg', rfl⟩ := List.mem_map.1 hg
    exact (NetScalar.inv j p).gates_ok g' hg'

/-- **Route (physical order).** For any labelling of the gates by their names, every gate is OK
and the scalar circuit routes `w` to `ρ w`. -/
theorem bit_exchange7_net {M : Type*} [AddGroup M] (hcard : ∀ t, #(ind t) = 3)
    (hinj : Function.Injective ind) (lab : NetScalar.GName T → M) :
    (∀ g ∈ NetScalar.labelled lab (named7 ind), g.OK) ∧
      ∀ (v : NetScalar.Wr ind → ZMod 2) w, scalarRun (NetScalar.labelled lab (named7 ind)) v (NetScalar.ρ ind w) = v w := by
  refine ⟨NetScalar.ok_labelled lab _ named7_ok, fun v w => ?_⟩
  rw [NetScalar.scalarRun_labelled]
  exact bit_exchange7 hcard hinj v w

end Bit

end NetProp7

end

section
-- Source module: Solutions.NetProp7Names
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option synthInstance.maxSize 512

namespace NetProp7

open Finset NetScalar

section Gen

variable {N N' W : Type*} [DecidableEq W]

lemma namesOn_append (w : W) (l₁ l₂ : List (N × SGate W)) :
    NetProp7.namesOn w (l₁ ++ l₂) = NetProp7.namesOn w l₁ ++ NetProp7.namesOn w l₂ := by
  simp [NetProp7.namesOn, List.filter_append]

lemma namesOn_reverse (w : W) (l : List (N × SGate W)) :
    NetProp7.namesOn w l.reverse = (NetProp7.namesOn w l).reverse := by
  simp [NetProp7.namesOn, List.filter_reverse, List.map_reverse]

lemma namesOn_flatMap {ι : Type*} (w : W) (L : List ι) (F : ι → List (N × SGate W)) :
    NetProp7.namesOn w (L.flatMap F) = L.flatMap fun i => NetProp7.namesOn w (F i) := by
  induction L with
  | nil => simp [NetProp7.namesOn]
  | cons i L ih => simp only [List.flatMap_cons, NetProp7.namesOn_append, ih]

lemma namesOn_rename (w : W) (f : N → N') (l : List (N × SGate W)) :
    NetProp7.namesOn w (l.map fun g => (f g.1, g.2)) = (NetProp7.namesOn w l).map f := by
  simp [NetProp7.namesOn, List.filter_map, List.map_map, Function.comp_def]

lemma namesOn_single (w : W) (n : N) (g : SGate W) :
    NetProp7.namesOn w [(n, g)] = if w ∈ g.2 then [n] else [] := by
  by_cases hw : w ∈ g.2 <;> simp [NetProp7.namesOn, hw]

lemma namesOn_row {T : Type*} [Fintype T] [DecidableEq T] (w : W) (k : Fin 8)
    (g : T → SGate W) (o : Option T) (hP : ∀ S, w ∈ (g S).2 ↔ some S = o) :
    NetProp7.namesOn w ((univ : Finset T).toList.map fun S => (((k, some S) : IName T), g S)) =
      o.toList.map fun S => ((k, some S) : IName T) := by
  unfold NetProp7.namesOn
  rw [List.filter_map, List.map_map]
  have : (fun x : T => decide (w ∈ ((fun S => (((k, some S) : IName T), g S)) x).2.2)) =
      fun x => decide (some x = o) := by
    funext x; simp only [hP]
  simp only [Function.comp_def, this]
  cases o with
  | none => simp
  | some t =>
    simp only [Option.some.injEq]
    rw [show (fun x : T => decide (x = t)) = fun x => decide (x = t) from rfl,
      filter_eq_toList t _ (Finset.nodup_toList _)]
    simp

end Gen

section Invocation

variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}
variable {W : Type*} [Fintype W] [DecidableEq W] (I : Inv ind W)

lemma mem_sideG (w : W) (S : T) :
    w ∈ (I.sideG S).2 ↔ w = I.tgt S ∨ ∃ n : NetScalar.Nb ind, n.1.1 = S ∧ I.side n = w := by
  simp [NetScalar.Inv.sideG]

lemma mem_copyG (w : W) (t : T) :
    w ∈ (I.copyG t).2 ↔ w = I.src t ∨ ∃ n : NetScalar.Nb ind, n.1.2 = t ∧ I.side n = w := by
  simp [NetScalar.Inv.copyG]

lemma mem_scatG (w : W) : w ∈ I.scatG.2 ↔ (∃ t, I.tgt t = w) ∨ ∃ i, I.cen i = w := by
  simp [NetScalar.Inv.scatG]

lemma mem_gathG (w : W) : w ∈ I.gathG.2 ↔ (∃ t, I.src t = w) ∨ ∃ i, I.cen i = w := by
  simp [NetScalar.Inv.gathG]

/-- The names touching `w` in one invocation, from the membership pattern of `w`. -/
lemma namesOn_named (w : W) (oS oC : Option T) (bS bG : Prop) [Decidable bS] [Decidable bG]
    (hS : ∀ S, w ∈ (I.sideG S).2 ↔ some S = oS) (hC : ∀ t, w ∈ (I.copyG t).2 ↔ some t = oC)
    (hsc : w ∈ I.scatG.2 ↔ bS) (hga : w ∈ I.gathG.2 ↔ bG) :
    NetProp7.namesOn w I.named =
      (oS.toList.map fun S => ((0, some S) : IName T)) ++ (if bS then [(1, none)] else []) ++
      (oC.toList.map fun S => ((2, some S) : IName T)) ++ (if bG then [(3, none)] else []) ++
      (if bS then [(4, none)] else []) ++ (oS.toList.map fun S => ((5, some S) : IName T)) ++
      (if bG then [(6, none)] else []) ++ (oC.toList.map fun S => ((7, some S) : IName T)) := by
  unfold NetScalar.Inv.named
  simp only [NetProp7.namesOn_append, NetProp7.namesOn_single, NetProp7.namesOn_row w _ _ _ hS, NetProp7.namesOn_row w _ _ _ hC, hsc,
    hga]

variable {I} (hG : I.Good)
include hG

lemma names_src (t₀ : T) :
    NetProp7.namesOn (I.src t₀) I.named = [(2, some t₀), (3, none), (6, none), (7, some t₀)] := by
  rw [NetProp7.namesOn_named I _ none (some t₀) False True]
  · simp
  · intro S; simp only [NetProp7.mem_sideG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨hG.st _ _, fun n _ e => hG.ss _ _ e.symm⟩
  · intro t; simp only [NetProp7.mem_copyG, Option.some.injEq, hG.src_inj.eq_iff]
    constructor
    · rintro (e | ⟨n, -, e⟩)
      · exact e.symm
      · exact absurd e.symm (hG.ss _ _)
    · rintro rfl; exact Or.inl rfl
  · simp only [NetProp7.mem_scatG, iff_false, not_or, not_exists]
    exact ⟨fun t e => hG.st _ _ e.symm, fun i e => hG.sc _ _ e.symm⟩
  · simp only [NetProp7.mem_gathG, iff_true]; exact Or.inl ⟨t₀, rfl⟩

lemma names_tgt (t₀ : T) :
    NetProp7.namesOn (I.tgt t₀) I.named = [(0, some t₀), (1, none), (4, none), (5, some t₀)] := by
  rw [NetProp7.namesOn_named I _ (some t₀) none True False]
  · simp
  · intro t; simp only [NetProp7.mem_sideG, Option.some.injEq, hG.tgt_inj.eq_iff]
    constructor
    · rintro (e | ⟨n, -, e⟩)
      · exact e.symm
      · exact absurd e.symm (hG.ts _ _)
    · rintro rfl; exact Or.inl rfl
  · intro S; simp only [NetProp7.mem_copyG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨fun e => hG.st _ _ e.symm, fun n _ e => hG.ts _ _ e.symm⟩
  · simp only [NetProp7.mem_scatG, iff_true]; exact Or.inl ⟨t₀, rfl⟩
  · simp only [NetProp7.mem_gathG, iff_false, not_or, not_exists]
    exact ⟨fun t e => hG.st _ _ e, fun i e => hG.tc _ _ e.symm⟩

lemma names_cen (i₀ : Fin h) :
    NetProp7.namesOn (I.cen i₀) I.named = [(1, none), (3, none), (4, none), (6, none)] := by
  rw [NetProp7.namesOn_named I _ none none True True]
  · simp
  · intro S; simp only [NetProp7.mem_sideG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨fun e => hG.tc _ _ e.symm, fun n _ e => hG.sic _ _ e⟩
  · intro S; simp only [NetProp7.mem_copyG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨fun e => hG.sc _ _ e.symm, fun n _ e => hG.sic _ _ e⟩
  · simp only [NetProp7.mem_scatG, iff_true]; exact Or.inr ⟨i₀, rfl⟩
  · simp only [NetProp7.mem_gathG, iff_true]; exact Or.inr ⟨i₀, rfl⟩

lemma names_side (n₀ : NetScalar.Nb ind) :
    NetProp7.namesOn (I.side n₀) I.named =
      [(0, some n₀.1.1), (2, some n₀.1.2), (5, some n₀.1.1), (7, some n₀.1.2)] := by
  rw [NetProp7.namesOn_named I _ (some n₀.1.1) (some n₀.1.2) False False]
  · simp
  · intro S; simp only [NetProp7.mem_sideG, Option.some.injEq]
    constructor
    · rintro (e | ⟨n, hn, e⟩)
      · exact absurd e.symm (hG.ts _ _)
      · rw [hG.side_inj e] at hn; exact hn.symm
    · rintro rfl; exact Or.inr ⟨n₀, rfl, rfl⟩
  · intro t; simp only [NetProp7.mem_copyG, Option.some.injEq]
    constructor
    · rintro (e | ⟨n, hn, e⟩)
      · exact absurd e.symm (hG.ss _ _)
      · rw [hG.side_inj e] at hn; exact hn.symm
    · rintro rfl; exact Or.inr ⟨n₀, rfl, rfl⟩
  · simp only [NetProp7.mem_scatG, iff_false, not_or, not_exists]
    exact ⟨fun t e => hG.ts _ _ e, fun i e => hG.sic _ _ e.symm⟩
  · simp only [NetProp7.mem_gathG, iff_false, not_or, not_exists]
    exact ⟨fun t e => hG.ss _ _ e, fun i e => hG.sic _ _ e.symm⟩

omit hG in
lemma names_none (w : W) (h1 : ∀ t, I.src t ≠ w) (h2 : ∀ t, I.tgt t ≠ w)
    (h3 : ∀ n, I.side n ≠ w) (h4 : ∀ i, I.cen i ≠ w) : NetProp7.namesOn w I.named = [] := by
  rw [NetProp7.namesOn_named I _ none none False False]
  · simp
  · intro S; simp only [NetProp7.mem_sideG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨fun e => h2 _ e.symm, fun n _ e => h3 _ e⟩
  · intro S; simp only [NetProp7.mem_copyG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨fun e => h1 _ e.symm, fun n _ e => h3 _ e⟩
  · simp only [NetProp7.mem_scatG, iff_false, not_or, not_exists]; exact ⟨h2, h4⟩
  · simp only [NetProp7.mem_gathG, iff_false, not_or, not_exists]; exact ⟨h1, h4⟩

end Invocation

section Bit

variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}

lemma emb_eq_iff (j : Fin 3) (p : T × T) (t : T) (a : T × T × T) :
    emb j p t = a ↔ p = NetProp7.pj j a ∧ t = NetProp7.cj j a := by
  rw [show emb j p t = embEquiv j (p, t) from rfl, ← Equiv.eq_symm_apply,
    Prod.ext_iff]
  rfl

lemma emb_pj_cj (j : Fin 3) (a : T × T × T) : emb j (NetProp7.pj j a) (NetProp7.cj j a) = a :=
  (NetProp7.emb_eq_iff j _ _ a).2 ⟨rfl, rfl⟩

variable (ind)

lemma namesOn_blk (w : NetScalar.Wr ind) (j : Fin 3) (p : T × T) :
    NetProp7.namesOn w (NetProp7.blk ind j p) =
      if j = 1 then ((NetProp7.namesOn w (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).named).map fun n => (j, p, n)).reverse
      else (NetProp7.namesOn w (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).named).map fun n => (j, p, n) := by
  unfold NetProp7.blk
  split_ifs
  · rw [NetProp7.namesOn_reverse, NetProp7.namesOn_rename w (fun n => ((j, p, n) : NetScalar.GName T))]
  · rw [NetProp7.namesOn_rename w (fun n => ((j, p, n) : NetScalar.GName T))]

lemma namesOn_named7 (w : NetScalar.Wr ind) :
    NetProp7.namesOn w (named7 ind) = ([0, 1, 2] : List (Fin 3)).flatMap fun j =>
      (univ : Finset (T × T)).toList.flatMap fun p => NetProp7.namesOn w (NetProp7.blk ind j p) := by
  unfold named7
  rw [NetProp7.namesOn_flatMap]
  congr 1
  funext j
  rw [NetProp7.namesOn_flatMap]

variable {ind}

lemma inv_src (j : Fin 3) (p : T × T) (t : T) :
    (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).src t = NetScalar.srcW j (emb j p t) := rfl
lemma inv_tgt (j : Fin 3) (p : T × T) (t : T) :
    (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).tgt t = NetScalar.tgtW j (emb j p t) := rfl
lemma inv_side (j : Fin 3) (p : T × T) (n : NetScalar.Nb ind) :
    (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).side n = NetScalar.wS j p n := rfl
lemma inv_cen (j : Fin 3) (p : T × T) (i : Fin h) :
    (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).cen i = NetScalar.wC j p i := rfl

/-- Gate names of invocation `(j, p)` touching `X a`. -/
lemma namesInv_X (j : Fin 3) (p : T × T) (a : T × T × T) :
    NetProp7.namesOn (NetScalar.wX a) (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).named =
      if p = NetProp7.pj j a then
        (if j = 1 then [(0, some (NetProp7.cj j a)), (1, none), (4, none), (5, some (NetProp7.cj j a))]
          else [(2, some (NetProp7.cj j a)), (3, none), (6, none), (7, some (NetProp7.cj j a))])
      else [] := by
  by_cases hp : p = NetProp7.pj j a
  · subst hp
    by_cases hj : j = 1
    · have : (NetScalar.wX a : NetScalar.Wr ind) = (NetScalar.inv j (NetProp7.pj j a) : NetScalar.Inv ind (NetScalar.Wr ind)).tgt (NetProp7.cj j a) := by
        rw [NetProp7.inv_tgt, NetProp7.emb_pj_cj]; simp [NetScalar.tgtW, hj]
      rw [this, NetProp7.names_tgt (NetScalar.inv_good _ _)]; simp [hj]
    · have : (NetScalar.wX a : NetScalar.Wr ind) = (NetScalar.inv j (NetProp7.pj j a) : NetScalar.Inv ind (NetScalar.Wr ind)).src (NetProp7.cj j a) := by
        rw [NetProp7.inv_src, NetProp7.emb_pj_cj]; simp [NetScalar.srcW, hj]
      rw [this, NetProp7.names_src (NetScalar.inv_good _ _)]; simp [hj]
  · rw [if_neg hp]
    apply NetProp7.names_none
    · intro t e
      rw [NetProp7.inv_src] at e
      unfold NetScalar.srcW at e
      split_ifs at e
      · simp [NetScalar.wX, NetScalar.wY] at e
      · simp only [NetScalar.wX, Sum.inl.injEq] at e
        exact hp ((NetProp7.emb_eq_iff j p t a).1 e).1
    · intro t e
      rw [NetProp7.inv_tgt] at e
      unfold NetScalar.tgtW at e
      split_ifs at e
      · simp only [NetScalar.wX, Sum.inl.injEq] at e
        exact hp ((NetProp7.emb_eq_iff j p t a).1 e).1
      · simp [NetScalar.wX, NetScalar.wY] at e
    · intro n e; simp [NetProp7.inv_side, NetScalar.wS, NetScalar.wX] at e
    · intro i e; simp [NetProp7.inv_cen, NetScalar.wC, NetScalar.wX] at e

/-- Gate names of invocation `(j, p)` touching `Y a`. -/
lemma namesInv_Y (j : Fin 3) (p : T × T) (a : T × T × T) :
    NetProp7.namesOn (NetScalar.wY a) (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).named =
      if p = NetProp7.pj j a then
        (if j = 1 then [(2, some (NetProp7.cj j a)), (3, none), (6, none), (7, some (NetProp7.cj j a))]
          else [(0, some (NetProp7.cj j a)), (1, none), (4, none), (5, some (NetProp7.cj j a))])
      else [] := by
  by_cases hp : p = NetProp7.pj j a
  · subst hp
    by_cases hj : j = 1
    · have : (NetScalar.wY a : NetScalar.Wr ind) = (NetScalar.inv j (NetProp7.pj j a) : NetScalar.Inv ind (NetScalar.Wr ind)).src (NetProp7.cj j a) := by
        rw [NetProp7.inv_src, NetProp7.emb_pj_cj]; simp [NetScalar.srcW, hj]
      rw [this, NetProp7.names_src (NetScalar.inv_good _ _)]; simp [hj]
    · have : (NetScalar.wY a : NetScalar.Wr ind) = (NetScalar.inv j (NetProp7.pj j a) : NetScalar.Inv ind (NetScalar.Wr ind)).tgt (NetProp7.cj j a) := by
        rw [NetProp7.inv_tgt, NetProp7.emb_pj_cj]; simp [NetScalar.tgtW, hj]
      rw [this, NetProp7.names_tgt (NetScalar.inv_good _ _)]; simp [hj]
  · rw [if_neg hp]
    apply NetProp7.names_none
    · intro t e
      rw [NetProp7.inv_src] at e
      unfold NetScalar.srcW at e
      split_ifs at e
      · simp only [NetScalar.wY, Sum.inr.injEq, Sum.inl.injEq] at e
        exact hp ((NetProp7.emb_eq_iff j p t a).1 e).1
      · simp [NetScalar.wX, NetScalar.wY] at e
    · intro t e
      rw [NetProp7.inv_tgt] at e
      unfold NetScalar.tgtW at e
      split_ifs at e
      · simp [NetScalar.wX, NetScalar.wY] at e
      · simp only [NetScalar.wY, Sum.inr.injEq, Sum.inl.injEq] at e
        exact hp ((NetProp7.emb_eq_iff j p t a).1 e).1
    · intro n e; simp [NetProp7.inv_side, NetScalar.wS, NetScalar.wY] at e
    · intro i e; simp [NetProp7.inv_cen, NetScalar.wC, NetScalar.wY] at e

lemma namesInv_S (j j' : Fin 3) (p p' : T × T) (n : NetScalar.Nb ind) :
    NetProp7.namesOn (NetScalar.wS j' p' n) (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).named =
      if j = j' ∧ p = p' then
        [(0, some n.1.1), (2, some n.1.2), (5, some n.1.1), (7, some n.1.2)]
      else [] := by
  by_cases hp : j = j' ∧ p = p'
  · obtain ⟨rfl, rfl⟩ := hp
    rw [if_pos ⟨rfl, rfl⟩, ← NetProp7.inv_side j p n, NetProp7.names_side (NetScalar.inv_good _ _)]
  · rw [if_neg hp]
    apply NetProp7.names_none
    · intro t e; rw [NetProp7.inv_src] at e; unfold NetScalar.srcW at e; split_ifs at e <;> simp [NetScalar.wS, NetScalar.wX, NetScalar.wY] at e
    · intro t e; rw [NetProp7.inv_tgt] at e; unfold NetScalar.tgtW at e; split_ifs at e <;> simp [NetScalar.wS, NetScalar.wX, NetScalar.wY] at e
    · intro n' e; simp only [NetProp7.inv_side, NetScalar.wS, Sum.inr.injEq, Sum.inl.injEq, Prod.mk.injEq] at e
      exact hp ⟨e.1, e.2.1⟩
    · intro i e; simp [NetProp7.inv_cen, NetScalar.wC, NetScalar.wS] at e

lemma namesInv_C (j j' : Fin 3) (p p' : T × T) (i : Fin h) :
    NetProp7.namesOn (NetScalar.wC j' p' i) (NetScalar.inv j p : NetScalar.Inv ind (NetScalar.Wr ind)).named =
      if j = j' ∧ p = p' then [(1, none), (3, none), (4, none), (6, none)] else [] := by
  by_cases hp : j = j' ∧ p = p'
  · obtain ⟨rfl, rfl⟩ := hp
    rw [if_pos ⟨rfl, rfl⟩, ← NetProp7.inv_cen j p i, NetProp7.names_cen (NetScalar.inv_good _ _)]
  · rw [if_neg hp]
    apply NetProp7.names_none
    · intro t e; rw [NetProp7.inv_src] at e; unfold NetScalar.srcW at e; split_ifs at e <;> simp [NetScalar.wC, NetScalar.wX, NetScalar.wY] at e
    · intro t e; rw [NetProp7.inv_tgt] at e; unfold NetScalar.tgtW at e; split_ifs at e <;> simp [NetScalar.wC, NetScalar.wX, NetScalar.wY] at e
    · intro n' e; simp [NetProp7.inv_side, NetScalar.wS, NetScalar.wC] at e
    · intro i' e; simp only [NetProp7.inv_cen, NetScalar.wC, Sum.inr.injEq, Prod.mk.injEq] at e
      exact hp ⟨e.1, e.2.1⟩

/-- Names of the gates touching `X a`, in order: times `2, 3, 6, 7` at each stage. -/
theorem names_X (a : T × T × T) :
    NetProp7.namesOn (NetScalar.wX a) (named7 ind) =
      (([(2, some (NetProp7.cj 0 a)), (3, none), (6, none), (7, some (NetProp7.cj 0 a))] : List (IName T)).map
        fun n => ((0 : Fin 3), NetProp7.pj 0 a, n)) ++
      ((([(0, some (NetProp7.cj 1 a)), (1, none), (4, none), (5, some (NetProp7.cj 1 a))] : List (IName T)).map
        fun n => ((1 : Fin 3), NetProp7.pj 1 a, n)).reverse ++
      ((([(2, some (NetProp7.cj 2 a)), (3, none), (6, none), (7, some (NetProp7.cj 2 a))] : List (IName T)).map
        fun n => ((2 : Fin 3), NetProp7.pj 2 a, n)))) := by
  rw [namesOn_named7]
  simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
  have st : ∀ j : Fin 3, ((univ : Finset (T × T)).toList.flatMap fun p =>
      NetProp7.namesOn (NetScalar.wX a) (NetProp7.blk ind j p)) = NetProp7.namesOn (NetScalar.wX a) (NetProp7.blk ind j (NetProp7.pj j a)) := fun j =>
    flatMap_univ_single _ _ fun p hp => by rw [namesOn_blk, NetProp7.namesInv_X, if_neg hp]; simp
  rw [st, st, st]
  simp only [namesOn_blk, NetProp7.namesInv_X, if_true]
  simp

/-- Names of the gates touching `Y a`, in order: times `0, 1, 4, 5` at each stage. -/
theorem names_Y (a : T × T × T) :
    NetProp7.namesOn (NetScalar.wY a) (named7 ind) =
      (([(0, some (NetProp7.cj 0 a)), (1, none), (4, none), (5, some (NetProp7.cj 0 a))] : List (IName T)).map
        fun n => ((0 : Fin 3), NetProp7.pj 0 a, n)) ++
      ((([(2, some (NetProp7.cj 1 a)), (3, none), (6, none), (7, some (NetProp7.cj 1 a))] : List (IName T)).map
        fun n => ((1 : Fin 3), NetProp7.pj 1 a, n)).reverse ++
      ((([(0, some (NetProp7.cj 2 a)), (1, none), (4, none), (5, some (NetProp7.cj 2 a))] : List (IName T)).map
        fun n => ((2 : Fin 3), NetProp7.pj 2 a, n)))) := by
  rw [namesOn_named7]
  simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
  have st : ∀ j : Fin 3, ((univ : Finset (T × T)).toList.flatMap fun p =>
      NetProp7.namesOn (NetScalar.wY a) (NetProp7.blk ind j p)) = NetProp7.namesOn (NetScalar.wY a) (NetProp7.blk ind j (NetProp7.pj j a)) := fun j =>
    flatMap_univ_single _ _ fun p hp => by rw [namesOn_blk, NetProp7.namesInv_Y, if_neg hp]; simp
  rw [st, st, st]
  simp only [namesOn_blk, NetProp7.namesInv_Y, if_true]
  simp

lemma stages_single (F : Fin 3 → List (NetScalar.GName T)) (j : Fin 3) (hF : ∀ j', j' ≠ j → F j' = []) :
    ([0, 1, 2] : List (Fin 3)).flatMap F = F j :=
  flatMap_single F j _ (by decide) (by fin_cases j <;> simp) (fun p _ hp => hF p hp)

/-- Names of the gates touching a side wire: times `0, 2, 5, 7` of its own invocation. -/
theorem names_S (j : Fin 3) (p : T × T) (n : NetScalar.Nb ind) :
    NetProp7.namesOn (NetScalar.wS j p n) (named7 ind) =
      if j = 1 then
        (([(0, some n.1.1), (2, some n.1.2), (5, some n.1.1), (7, some n.1.2)] :
          List (IName T)).map fun k => (j, p, k)).reverse
      else ([(0, some n.1.1), (2, some n.1.2), (5, some n.1.1), (7, some n.1.2)] :
          List (IName T)).map fun k => (j, p, k) := by
  rw [namesOn_named7, NetProp7.stages_single _ j]
  · rw [flatMap_univ_single _ p]
    · simp only [namesOn_blk, NetProp7.namesInv_S, and_self, if_true]
    · intro p' hp'
      simp [namesOn_blk, NetProp7.namesInv_S, hp']
  · intro j' hj'
    apply flatMap_univ_nil
    intro p'
    simp [namesOn_blk, NetProp7.namesInv_S, hj']

/-- Names of the gates touching a central wire: times `1, 3, 4, 6` of its own invocation. -/
theorem names_C (j : Fin 3) (p : T × T) (i : Fin h) :
    NetProp7.namesOn (NetScalar.wC j p i) (named7 ind) =
      if j = 1 then
        (([(1, none), (3, none), (4, none), (6, none)] : List (IName T)).map
          fun k => (j, p, k)).reverse
      else ([(1, none), (3, none), (4, none), (6, none)] : List (IName T)).map
          fun k => (j, p, k) := by
  rw [namesOn_named7, NetProp7.stages_single _ j]
  · rw [flatMap_univ_single _ p]
    · simp only [namesOn_blk, NetProp7.namesInv_C, and_self, if_true]
    · intro p' hp'
      simp [namesOn_blk, NetProp7.namesInv_C, hp']
  · intro j' hj'
    apply flatMap_univ_nil
    intro p'
    simp [namesOn_blk, NetProp7.namesInv_C, hj']

end Bit

end NetProp7

end

