theorem tw_hu (p h d : ℕ) : (4 * ((2 ^ (h + 1) : ℕ) : ℝ) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ dlV p h d ≤ 1 := by
  have hN : 4 * (2 ^ (h + 1)) ^ 2 + 1 ≤ 2 ^ (2 * h + d + 6) := by
