/-!
# `F₂` linear algebra from packed certificates

Semantics: `vr n X i : Fin n → ZMod 2` is row `i` of the packed number `X` (bit `t` of the
32-bit field `i`). Certificates are lists of rows; all checks are `dotsP` products compared with
target patterns (`R6ChkPack`).

* `dot_of_dotsP`: a `dotsP` equation gives every inner product `vr A j ⬝ᵥ vr B i`.
* `indep_of_dual`: rows with a dual family (`e_j ⬝ v_i = δ`) are independent.
* `mem_iff_of_cert` (label certificate): `B` (`k` rows), `H` (`n-k` rows) with
  `H Bᵀ = 0`, `H Eᵀ = I`, `D Hᵀ = 0`, `D Bᵀ = I` ⟹ `span B = ker H`, `dim = k`, nondegenerate.
* `pair_of_cert` (edge certificate): `U ⊆ V`, a dual of `U`, and an orthonormal basis `R`
  of the residual (`R ⊥ U`, `R ⊆ V`, `|R| = dim V − |U|`) ⟹ `span U` nondegenerate of dim `|U|`,
  and `U = V` or a norm-one `w ∈ V` orthogonal to `U` exists.
-/

namespace R6Chk

open Matrix Module

/-! ## Vectors -/

/-! ## Linear algebra over `F₂` -/

section LA

variable {n : ℕ}

theorem dot_sum {k : ℕ} (a : (Fin n → ZMod 2)) (c : Fin k → ZMod 2) (v : Fin k → (Fin n → ZMod 2)) :
    a ⬝ᵥ (∑ i, c i • v i) = ∑ i, c i * (a ⬝ᵥ v i) := by
  rw [dotProduct_sum]
  simp [dotProduct_smul]

theorem indep_of_dual {k : ℕ} {v e : Fin k → (Fin n → ZMod 2)} (h : ∀ i j, e j ⬝ᵥ v i = if i = j then 1 else 0) :
    LinearIndependent (ZMod 2) v := by
  rw [Fintype.linearIndependent_iff]
  intro g hg j
  have := congrArg (fun z => e j ⬝ᵥ z) hg
  simp only [dot_sum, h, dotProduct_zero] at this
  simpa [Finset.sum_ite_eq'] using this

/-- `span B = ker H` from `H ⊥ B`, both independent, sizes adding to `n`. -/
theorem span_eq_ker {k m : ℕ} {b : Fin k → (Fin n → ZMod 2)} {h : Fin m → (Fin n → ZMod 2)} (hb : LinearIndependent (ZMod 2) b)
    (hh : LinearIndependent (ZMod 2) h) (hmk : m + k = n) (hHB : ∀ i j, h i ⬝ᵥ b j = 0) :
    ∀ x, x ∈ spanF b ↔ ∀ i, h i ⬝ᵥ x = 0 := by
  let Hm : Matrix (Fin m) (Fin n) (ZMod 2) := Matrix.of h
  have hker : ∀ x, x ∈ LinearMap.ker Hm.mulVecLin ↔ ∀ i, h i ⬝ᵥ x = 0 := by
    intro x
    simp only [LinearMap.mem_ker, Matrix.mulVecLin_apply, funext_iff, Pi.zero_apply]
    rfl
  have hrank : Hm.rank = m := by
    rw [Matrix.rank_eq_finrank_span_row]
    have : Set.range Hm.row = Set.range h := rfl
    rw [this, finrank_span_eq_card hh, Fintype.card_fin]
  have hdim : finrank (ZMod 2) (LinearMap.ker Hm.mulVecLin) = k := by
    have := LinearMap.finrank_range_add_finrank_ker Hm.mulVecLin
    rw [← Matrix.rank, hrank, Module.finrank_fin_fun] at this
    omega
  have hle : spanF b ≤ LinearMap.ker Hm.mulVecLin := by
    rw [spanF, Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    exact (hker _).2 fun i => hHB i j
  have heq := Submodule.eq_of_le_of_finrank_eq hle
    (by rw [hdim, spanF, finrank_span_eq_card hb, Fintype.card_fin])
  intro x
  rw [heq, hker]

/-- **Label certificate.** -/
theorem label_of_cert_sol_aux {k m : ℕ} {b d : Fin k → (Fin n → ZMod 2)} {h e : Fin m → (Fin n → ZMod 2)} (hmk : m + k = n)
    (hHB : ∀ i j, h i ⬝ᵥ b j = 0) (hHE : ∀ i j, h i ⬝ᵥ e j = if i = j then 1 else 0)
    (hDH : ∀ j i, d j ⬝ᵥ h i = 0) (hDB : ∀ j i, d j ⬝ᵥ b i = if i = j then 1 else 0) :
    (∀ x, x ∈ spanF b ↔ ∀ i, h i ⬝ᵥ x = 0) ∧ finrank (ZMod 2) (spanF b) = k ∧
      NondegF (spanF b) := by
  have hb : LinearIndependent (ZMod 2) b := indep_of_dual (e := d) (fun i j => hDB j i)
  have hh : LinearIndependent (ZMod 2) h := indep_of_dual (e := e) (fun i j => by
    rw [dotProduct_comm, hHE])
  have hmem := span_eq_ker hb hh hmk hHB
  refine ⟨hmem, ?_, ?_⟩
  · rw [spanF, finrank_span_eq_card hb, Fintype.card_fin]
  · exact nondeg_of_dual (fun j => (hmem _).2 fun i => by rw [dotProduct_comm]; exact hDH j i) hDB

end LA

