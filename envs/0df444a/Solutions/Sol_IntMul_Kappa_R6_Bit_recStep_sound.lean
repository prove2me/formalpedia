/-!
# Round six, bit network: the producer computes the node values (`B A C = I`)

Over a module `M` of characteristic two, for inputs `x : ℕ → M`:

* XOR-run algebra: `xrL` is additive, is inverted by the reversed run, and acts on read/write
  separated gate lists by adding the sources;
* `msum x mask = Σ_{i ∈ mask} x_i`;
* `prod_vals`: after copying `x_t` into the source slots (`Cg`) and running the producer
  (`Ag`), slot `q` holds `msum x (supG (idF IDS3 q))` (the node-id simulation, checked by the
  kernel in `R6BitNBIdB0..2`);
* `reads_eq`: the six slots read for target `T` sum to `x_T` (`R6BitNBIdRd`).
-/

set_option linter.unusedSectionVars false
set_option maxRecDepth 100000

namespace IntMul.Kappa.R6.Bit

open R6Chk R6Chk.Bit R6Chk.Bit.Loc

section XorRun

variable {M : Type*} [AddCommGroup M]

theorem xrL_nil (u : ℕ → M) : xrL [] u = u := rfl

variable (h2 : ∀ a : M, a + a = 0)
include h2

end XorRun

/-! ## Masks -/

section Msum

variable {M : Type*} [AddCommGroup M]

theorem msum_zero (x : ℕ → M) : msum x 0 = 0 := by simp [msum]

theorem msum_xor (h2 : ∀ a : M, a + a = 0) (x : ℕ → M) (a b : ℕ) :
    msum x (a ^^^ b) = msum x a + msum x b := by
  rw [msum, msum, msum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Nat.testBit_xor]
  cases a.testBit i <;> cases b.testBit i <;> simp [h2]

theorem or_eq_xor_of_and {a b : ℕ} (h : a &&& b = 0) : a ||| b = a ^^^ b := by
  apply Nat.eq_of_testBit_eq; intro i
  have := congrArg (fun n => n.testBit i) h
  simp only [Nat.testBit_and, Nat.zero_testBit] at this
  rw [Nat.testBit_or, Nat.testBit_xor]
  cases ha : a.testBit i <;> cases hb : b.testBit i <;> simp_all

end Msum

/-! ## The node-id simulation -/

section IdSim

variable {M : Type*} [AddCommGroup M] (h2 : ∀ a : M, a + a = 0) (x : ℕ → M)

theorem supG_zero : supG 0 = 0 := DagC.leaves_ok.1

theorem ne_of_beq_false {a b : ℕ} (h : Nat.beq a b = false) : a ≠ b := by
  rintro rfl; rw [Nat.beq_refl] at h; cases h

theorem wS_inj {q q' : ℕ} (h : wS q = wS q') : q = q' := by
  simp only [wS, Nat.add_eq] at h; omega

theorem idF_setF (S q q' v : ℕ) (hv : v < 2 ^ 16) :
    idF (setF S q v) q' = if q = q' then v else idF S q' := setF_fieldOf S q q' v hv

theorem exStep_fst (n p : ℕ) (a : Bool × ℕ) (o : ℕ) :
    (exStep n p a o).1 = (a.1 && Nat.blt o NR && Nat.beq (idF a.2 o) 0 && !(Nat.beq o p)) := rfl

theorem foldl_exStep_flag (n p : ℕ) : ∀ (os : List ℕ) (a : Bool × ℕ),
    (os.foldl (exStep n p) a).1 = true → a.1 = true
  | [], _, h => h
  | o :: os, a, h => by
    have := foldl_exStep_flag n p os _ h
    rw [exStep_fst] at this
    simp only [Bool.and_eq_true] at this
    exact this.1.1.1

include h2 in
theorem exSteps_sound (n p : ℕ) (hn : n < 2 ^ 16) (hp : p < NR) :
    ∀ (os : List ℕ) (a : Bool × ℕ) (z : ℕ → M), (os.foldl (exStep n p) a).1 = true →
      IdInv x a.2 z → idF a.2 p = n →
      IdInv x (os.foldl (exStep n p) a).2 (xrL (os.map fun o => (wS o, wS p)) z)
  | [], _, _, _, hz, _ => hz
  | o :: os, a, z, h, hz, hpn => by
    have h1 := foldl_exStep_flag n p os _ h
    rw [exStep_fst] at h1
    simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq, Bool.not_eq_true'] at h1
    obtain ⟨⟨⟨-, ho⟩, hid⟩, hop⟩ := h1
    have hop := ne_of_beq_false hop
    simp only [List.foldl_cons, List.map_cons]
    rw [← xrL_cons]
    apply exSteps_sound n p hn hp os _ _ h
    · intro q hq
      show Function.update z (wS o) (z (wS o) + z (wS p)) (wS q) = msum x (supG (idF (setF a.2 o n) q))
      rw [idF_setF _ _ _ _ hn]
      by_cases hqo : o = q
      · subst hqo
        rw [if_pos rfl, Function.update_self, hz o ho, hz p hp, hid, hpn, supG_zero, msum_zero, zero_add]
      · rw [if_neg hqo, Function.update_of_ne (fun e => hqo (wS_inj e).symm), hz q hq]
    · show idF (setF a.2 o n) p = n
      rw [idF_setF _ _ _ _ hn, if_neg hop, hpn]

theorem recStep_flag (acc : (Bool × ℕ) × List (ℕ × ℕ × ℕ)) (r : Rec) :
    (recStep acc r).1.1 = true → acc.1.1 = true ∧ pivOK acc.1.2 r (acc.2.headD (0, 0, 0)) = true := by
  intro h
  have : (acc.1.1 && pivOK acc.1.2 r (acc.2.headD (0, 0, 0))) = true := foldl_exStep_flag r.1 r.2.1 r.2.2.2 _ h
  exact Bool.and_eq_true_iff.mp this

include h2 in
theorem recStep_sound_sol_aux (r : Rec) (hn : r.1 < 2 ^ 16) (acc : (Bool × ℕ) × List (ℕ × ℕ × ℕ))
    (hg : GateOK supG (acc.2.headD (0, 0, 0))) (h : (recStep acc r).1.1 = true) (z : ℕ → M)
    (hz : IdInv x acc.1.2 z) : IdInv x (recStep acc r).1.2 (xrL (recEl r) z) := by
  obtain ⟨-, hpiv⟩ := recStep_flag acc r h
  set g := acc.2.headD (0, 0, 0)
  set S := acc.1.2
  simp only [pivOK, Bool.and_eq_true, Nat.blt_eq] at hpiv
  obtain ⟨hp, hcase⟩ := hpiv
  -- the pivot gate
  have hS1 : IdInv x (setF S r.2.1 r.1) (xrL (if r.2.2.1 = 0 then [] else [(wS r.2.1, wS (r.2.2.1 - 1))]) z) ∧
      idF (setF S r.2.1 r.1) r.2.1 = r.1 := by
    refine ⟨?_, by rw [idF_setF _ _ _ _ hn, if_pos rfl]⟩
    by_cases hb : r.2.2.1 = 0
    · rw [if_pos hb, xrL_nil]
      rw [show Nat.beq r.2.2.1 0 = true by simp [hb], cond_true, Nat.beq_eq] at hcase
      intro q hq
      rw [idF_setF _ _ _ _ hn, hz q hq]
      by_cases hqp : r.2.1 = q
      · subst hqp; rw [if_pos rfl, hcase]
      · rw [if_neg hqp]
    · rw [if_neg hb]
      rw [show Nat.beq r.2.2.1 0 = false by
        cases h' : Nat.beq r.2.2.1 0
        · rfl
        · exact absurd (Nat.eq_of_beq_eq_true h') hb, cond_false] at hcase
      simp only [Bool.and_eq_true, Nat.blt_eq, Nat.beq_eq, Bool.not_eq_true'] at hcase
      obtain ⟨⟨⟨⟨hb', -⟩, hg1⟩, ha⟩, hbb⟩ := hcase
      have hb'' : r.2.2.1 - 1 < NR := hb'
      have ha' : idF S r.2.1 = g.2.1 := ha
      have hbb' : idF S (r.2.2.1 - 1) = g.2.2 := hbb
      intro q hq
      show Function.update z (wS r.2.1) (z (wS r.2.1) + z (wS (r.2.2.1 - 1))) (wS q) = _
      rw [idF_setF _ _ _ _ hn]
      by_cases hqp : r.2.1 = q
      · subst hqp
        rw [if_pos rfl, Function.update_self, hz _ hp, hz _ hb'', ha', hbb', ← msum_xor h2,
          ← or_eq_xor_of_and hg.1, hg.2, hg1]
      · rw [if_neg hqp, Function.update_of_ne (fun e => hqp (wS_inj e).symm), hz q hq]
  have := exSteps_sound h2 x r.1 r.2.1 hn hp r.2.2.2 _ _ h hS1.1 hS1.2
  rw [recEl, xrL_append]
  exact this

end IdSim

end IntMul.Kappa.R6.Bit

