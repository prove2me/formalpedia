/-- The size facts used by the cost bounds. -/
theorem setup_facts {n : ℕ} (hn : n0 ≤ n) :
    8192 ≤ bP n ∧ 1 ≤ dP n ∧ dP n ≤ bP n ∧ dP n ^ 2 ≤ bP n ∧ n ≤ 2 ^ bP n ∧ LP n < bP n ∧
    ℓP n ≤ LP n ∧ 64 * dP n ^ 2 * (256 * dP n ^ 2).factorial ≤ IntMul.OpenAI.Glue.rP n ∧ IntMul.OpenAI.Glue.rP n ≤ 2 ^ bP n ∧
    12 * dP n ^ 2 * bP n ≤ 2 ^ bP n ∧ 64 ≤ IntMul.OpenAI.Glue.rP n ∧ srcQ (dP n) (IntMul.OpenAI.Glue.rP n) ≤ 3 * 2 ^ bP n := by
  obtain ⟨-, -, hb, hd1, hdb, -, hLb, -, -, -, -, -, hbig, -⟩ := params_ok hn
  have hd2 : dP n ^ 2 ≤ bP n :=
    le_trans (Nat.pow_le_pow_right hd1 (by norm_num : 2 ≤ 2 ^ 75)) (dP_spec n).1
  have hnb : n ≤ 2 ^ bP n :=
    le_trans (Nat.le_pow_clog (by norm_num) n) (Nat.pow_le_pow_right (by norm_num) (le_max_left _ _))
  have hel : ℓP n ≤ LP n := by
    obtain ⟨-, h2⟩ := ell_spec (LP n) (dP n) (by omega)
    unfold ℓP
    by_contra hc
    push Not at hc
    have : dP n * (LP n + 1) ≤ dP n * ell (LP n) (dP n) := Nat.mul_le_mul_left _ hc
    rw [Nat.mul_add, mul_one] at this
    have : LP n ≤ dP n * LP n := Nat.le_mul_of_pos_left _ hd1
    omega
  have hr : IntMul.OpenAI.Glue.rP n ≤ 2 ^ bP n := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hF1 : 1 ≤ (256 * dP n ^ 2).factorial := Nat.one_le_iff_ne_zero.2 (Nat.factorial_ne_zero _)
  have h1d : 1 ≤ dP n ^ 2 := Nat.one_le_pow _ _ hd1
  have hr64 : 64 ≤ IntMul.OpenAI.Glue.rP n := by nlinarith
  have hX : 12 * dP n ^ 2 * bP n ≤ 2 ^ bP n := by
    have := cube_lt_pow (bP n) (by omega)
    have : bP n ≤ bP n ^ 2 := by nlinarith
    nlinarith
  refine ⟨hb, hd1, hdb, hd2, hnb, hLb, hel, hbig, hr, hX, hr64, ?_⟩
  -- Q ≤ r + 2F
  unfold srcQ
  set F := (256 * dP n ^ 2).factorial
  set D := 256 * dP n ^ 2
  have hD1 : 1 ≤ D := by omega
  have h1 : 2 * F * (IntMul.OpenAI.Glue.rP n / (2 * F * D)) ≤ IntMul.OpenAI.Glue.rP n := by
    calc 2 * F * (IntMul.OpenAI.Glue.rP n / (2 * F * D)) ≤ 2 * F * D * (IntMul.OpenAI.Glue.rP n / (2 * F * D)) :=
          Nat.mul_le_mul_right _ (Nat.le_mul_of_pos_right _ hD1)
      _ ≤ IntMul.OpenAI.Glue.rP n := Nat.mul_div_le _ _
  have h2 : 2 * F ≤ IntMul.OpenAI.Glue.rP n := by nlinarith
  rw [Nat.mul_add, mul_one]; omega

/-- `A = 2^{b+2}`, `B = 8b+17`: degree-`k ≤ 8` values fit. -/
theorem AB_ok (b k : ℕ) (hk : k ≤ 8) : (2 ^ (b + 2)) ^ k < 2 ^ (8 * b + 17) := by
  rw [← pow_mul]; exact Nat.pow_lt_pow_right (by norm_num) (by nlinarith)

theorem Bv_le (v : ℕ) : Bv v ≤ 2 * v + 4 := by
  have := zsz_natCast_le_self' (v + 1); unfold Bv; push_cast at this ⊢; omega

theorem rootP_cost' (m : ℕ) (rv rd : Fin HS) (h : RootRegs rv rd) (s : IState HS) (v b : ℕ)
    (LV : List Item) (hV : s.G rv = .int (v : ℤ) :: LV) (hvb : v ≤ b) (hm : m ≤ 75) :
    (rootP m rv rd).cost s ≤ 10 ^ 15 * (b + 1) ^ 4 := by
  have h1 := rootP_cost m rv rd h s v LV hV
  have h2 := Bv_le v
  have h3 : Bv v + m + 2 ≤ 81 * (b + 1) := by omega
  have h4 : (v + 1) * (m + 3) * 10 ^ 9 * (Bv v + m + 2) ^ 2 ≤
      (b + 1) * 78 * 10 ^ 9 * (81 * (b + 1)) ^ 2 := by
    gcongr
    all_goals omega
  have h5 : (b + 1) * 78 * 10 ^ 9 * (81 * (b + 1)) ^ 2 ≤ 10 ^ 15 * (b + 1) ^ 4 := by
    have : (b + 1) ^ 3 ≤ (b + 1) ^ 4 := Nat.pow_le_pow_right (by omega) (by norm_num)
    nlinarith
  omega

theorem cfin (N S b : ℕ) (hN : N + 1 ≤ 300 * (b + 1) ^ 2) (hS : S ≤ 41) :
    (N + 1) * S * 10 ^ 7 * (8 * b + 17 + 2) ^ 2 ≤ 10 ^ 15 * (b + 1) ^ 4 := by
  have h1 : (8 * b + 17 + 2) ^ 2 ≤ 361 * (b + 1) ^ 2 := by
    calc (8 * b + 17 + 2) ^ 2 ≤ (19 * (b + 1)) ^ 2 := Nat.pow_le_pow_left (by omega) 2
      _ = 361 * (b + 1) ^ 2 := by ring
  calc (N + 1) * S * 10 ^ 7 * (8 * b + 17 + 2) ^ 2
      ≤ (300 * (b + 1) ^ 2) * 41 * 10 ^ 7 * (361 * (b + 1) ^ 2) := by gcongr
    _ ≤ 10 ^ 15 * (b + 1) ^ 4 := by ring_nf; nlinarith [Nat.zero_le ((b + 1) ^ 4)]

theorem RS.cost_seq' (a b : RS) (s : IState HS) : (RS.seq a b).cost s = a.cost s + b.cost (a.run s) :=
  rfl

theorem RS.cost_asg' (i : Fin HS) (e : Ex HS) (s : IState HS) : (RS.asg i e).cost s = asgCost i e s :=
  rfl

theorem RS.cost_push' (i : Fin HS) (e : Ex HS) (s : IState HS) :
    (RS.push i e).cost s = e.cost s + (2 * moveCost (zsz (e.eval s)) + 19) := rfl

set_option maxHeartbeats 4000000 in
theorem setupA_cost (n : ℕ) (hn : n0 ≤ n) (s : IState HS) (LB : List Item)
    (hB : s.G zB = .int (bP n : ℤ) :: LB) :
    setupA.cost s ≤ 4 * 10 ^ 15 * (bP n + 1) ^ 4 := by
  obtain ⟨hb, hd1, hdb, hd2, -, -, -, -, -, hX2, -, -⟩ := setup_facts hn
  obtain ⟨A, hA⟩ : ∃ A, A = 2 ^ (bP n + 2) := ⟨_, rfl⟩
  have hbA : 2 ^ bP n * 4 = A := by rw [hA, pow_add]; norm_num
  have hb2 : bP n < 2 ^ bP n := Nat.lt_two_pow_self
  have h2A : 2 ≤ A := by omega
  have hAB : ∀ k ≤ 8, A ^ k < 2 ^ (8 * bP n + 17) := fun k hk => by rw [hA]; exact AB_ok _ k hk
  set Bn := 8 * bP n + 17 with hBn
  have hd1b : 1 ≤ bP n := by omega
  -- d
  obtain ⟨k1, r1⟩ := rootP_run 75 zB NLogN.KFM.zD rootRegs_bd s (bP n) LB hB
  rw [← d_count n hd1b] at r1
  set t1 := s.upd NLogN.KFM.zD (.int (dP n : ℤ) :: s.G NLogN.KFM.zD) with ht1
  have t1D : t1.G NLogN.KFM.zD = .int (dP n : ℤ) :: s.G zD := by simp [ht1]
  have t1B : t1.G zB = .int (bP n : ℤ) :: LB := by
    simp (config := {decide := true}) [ht1, IState.upd_G, hB]
  obtain ⟨k2, r2⟩ := rootP_run 56 NLogN.KFM.zD zK rootRegs_dk t1 (dP n) (s.G NLogN.KFM.zD) t1D
  rw [← K_count n hd1] at r2
  set t2 := t1.upd zK (.int (KP n : ℤ) :: t1.G zK) with ht2
  have t2D : t2.G NLogN.KFM.zD = .int (dP n : ℤ) :: s.G zD := by
    simp (config := {decide := true}) [ht2, IState.upd_G, t1D]
  have t2B : t2.G zB = .int (bP n : ℤ) :: LB := by
    simp (config := {decide := true}) [ht2, IState.upd_G, t1B]
  -- α
  set X := 12 * dP n ^ 2 * bP n with hX
  have hX1 : 1 ≤ X := by
    have : 1 ≤ dP n ^ 2 := Nat.one_le_pow _ _ hd1
    nlinarith
  have hXe : NLogN.KFM.XE.eval t2 = (X : ℤ) := by
    simp only [NLogN.KFM.XE, Ex.eval, IState.top_eq t2D, IState.top_eq t2B, hX]; push_cast; ring
  have htst : ∀ x, 1 ≤ x → x ≤ X → tstA.ok (xSt t2 x) ∧
      (tstA.eval (xSt t2 x) < 0 ↔ (fun x => x ^ 4 < X) x) := by
    intro x hx1 hxX
    have xI : (xSt t2 x).G NLogN.KFM.sI = .int (x : ℤ) :: t2.G sI := by
      simp (config := {decide := true}) [xSt]
    have xD : (xSt t2 x).G NLogN.KFM.zD = .int (dP n : ℤ) :: s.G zD := by
      simp (config := {decide := true}) [xSt, IState.upd_G, t2D]
    have xB : (xSt t2 x).G zB = .int (bP n : ℤ) :: LB := by
      simp (config := {decide := true}) [xSt, IState.upd_G, t2B]
    refine ⟨?_, ?_⟩
    · simp only [tstA, NLogN.KFM.XE, Ex.ok]
      exact ⟨⟨⟨IState.isInt_of xI, IState.isInt_of xI⟩, IState.isInt_of xI, IState.isInt_of xI⟩,
        ⟨trivial, IState.isInt_of xD, IState.isInt_of xD⟩, IState.isInt_of xB⟩
    · simp only [tstA, NLogN.KFM.XE, Ex.eval, IState.top_eq xI, IState.top_eq xD, IState.top_eq xB, hX]
      constructor
      · intro h; have : ((x ^ 4 : ℕ) : ℤ) < ((12 * dP n ^ 2 * bP n : ℕ) : ℤ) := by
          push_cast; linarith
        exact_mod_cast this
      · intro h; have : ((x ^ 4 : ℕ) : ℤ) < ((12 * dP n ^ 2 * bP n : ℕ) : ℤ) := by exact_mod_cast h
        push_cast at this; linarith
  have hXB : NLogN.KFM.XE.Bnd t2 Bn := exSm_bnd A Bn t2 h2A NLogN.KFM.XE (by
    simp only [NLogN.KFM.XE, exSm, IState.top_eq t2D, IState.top_eq t2B]; refine ⟨⟨?_, ?_, ?_⟩, ?_⟩; (all_goals
                                                                                                        first
                                                                                                        | assumption
                                                                                                        | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                                                                                        | ((norm_num); (done))
                                                                                                        | ((norm_num); (omega))
                                                                                                        | omega
                                                                                                        | positivity
                                                                                                        |
                                                                                                          ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                                                                                                first
                                                                                                                | ((norm_num); (done))
                                                                                                                | omega);
                                                                                                            (done))))
    (hAB _ (by decide))
  have htB : ∀ x, 1 ≤ x → x ≤ X → tstA.Bnd (xSt t2 x) Bn := by
    intro x hx1 hxX
    have xI : (xSt t2 x).G NLogN.KFM.sI = .int (x : ℤ) :: t2.G sI := by
      simp (config := {decide := true}) [xSt]
    have xD : (xSt t2 x).G NLogN.KFM.zD = .int (dP n : ℤ) :: s.G zD := by
      simp (config := {decide := true}) [xSt, IState.upd_G, t2D]
    have xB : (xSt t2 x).G zB = .int (bP n : ℤ) :: LB := by
      simp (config := {decide := true}) [xSt, IState.upd_G, t2B]
    exact exSm_bnd A Bn _ h2A tstA (by
      simp only [tstA, NLogN.KFM.XE, exSm, IState.top_eq xI, IState.top_eq xD, IState.top_eq xB]
      refine ⟨⟨⟨?_, ?_⟩, ?_, ?_⟩, ⟨?_, ?_, ?_⟩, ?_⟩; (all_goals
                                                        first
                                                        | assumption
                                                        | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                                        | ((norm_num); (done))
                                                        | ((norm_num); (omega))
                                                        | omega
                                                        | positivity
                                                        |
                                                          ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                                                first
                                                                | ((norm_num); (done))
                                                                | omega);
                                                            (done)))) (hAB _ (by decide))
  have c3 := cntP_cost NLogN.KFM.XE tstA zAl (fun x => x ^ 4 < X) t2 X (by decide) (by decide)
    (clean_of_regs _ (by decide)) (by decide)
    (by simp only [NLogN.KFM.XE, Ex.ok]; exact ⟨⟨trivial, IState.isInt_of t2D, IState.isInt_of t2D⟩,
      IState.isInt_of t2B⟩) hXe (clean_of_regs _ (by decide)) (by decide) htst Bn
    (zsz_of_abs (A := A) (k := 1) (by rw [Nat.abs_cast, pow_one]; exact_mod_cast (by omega)) (hAB 1 (by norm_num)))
    hXB htB
  obtain ⟨k3, r3⟩ := cntP_run NLogN.KFM.XE tstA zAl (fun x => x ^ 4 < X) t2 X (by decide) (by decide)
    (clean_of_regs _ (by decide)) (by decide)
    (by simp only [NLogN.KFM.XE, Ex.ok]; exact ⟨⟨trivial, IState.isInt_of t2D, IState.isInt_of t2D⟩,
      IState.isInt_of t2B⟩) hXe (clean_of_regs _ (by decide)) (by decide) htst
  rw [count_eq_findGreatest (fun x => x ^ 4 < X) X (fun x y hx hxy hy =>
    lt_of_le_of_lt (Nat.pow_le_pow_left hxy 4) hy)] at r3
  set g := Nat.findGreatest (fun x => x ^ 4 < X) X with hg
  have hgX : g ≤ X := Nat.findGreatest_le X
  set t3 := t2.upd zAl (.int (g : ℤ) :: t2.G zAl) with ht3
  have t3A : t3.G zAl = .int (g : ℤ) :: t2.G zAl := by simp [ht3]
  have c4 := asgCost_le zAl (.add (.reg zAl) (.lit 1)) t3 Bn
    (exSm_bnd A Bn t3 h2A _ (by simp only [exSm, IState.top_eq t3A]; refine ⟨?_, ?_⟩; (all_goals
                                                                                         first
                                                                                         | assumption
                                                                                         | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                                                                         | ((norm_num); (done))
                                                                                         | ((norm_num); (omega))
                                                                                         | omega
                                                                                         | positivity
                                                                                         |
                                                                                           ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                                                                                 first
                                                                                                 | ((norm_num); (done))
                                                                                                 | omega);
                                                                                             (done))))
      (hAB _ (by decide)))
    (by
      rw [IState.top_eq t3A]
      exact zsz_of_abs (A := A) (k := 1) (by rw [Nat.abs_cast, pow_one]; exact_mod_cast (by omega))
        (hAB 1 (by norm_num)))
  have c1 := rootP_cost' 75 zB NLogN.KFM.zD rootRegs_bd s (bP n) (bP n) LB hB le_rfl (by norm_num)
  have c2 := rootP_cost' 56 NLogN.KFM.zD zK rootRegs_dk t1 (dP n) (bP n) (s.G NLogN.KFM.zD) t1D hdb (by norm_num)
  have e3 := cfin X 35 (bP n) (by nlinarith) (by norm_num)
  have e4 := cfin 0 4 (bP n) (by nlinarith) (by norm_num)
  have hsz3 : tstA.size + NLogN.KFM.XE.size + 12 = 35 := by decide
  have hsz4 : (Ex.add (.reg zAl) (.lit 1) : Ex HS).size + 1 = 4 := by decide
  rw [hsz3] at c3; rw [hsz4] at c4
  rw [setupA, RS.cost_seq', RS.cost_seq', RS.cost_seq', RS.cost_asg', r1, r2, r3]
  rw [← hBn] at e3 e4
  omega

set_option maxHeartbeats 4000000 in
theorem setupB_cost (n : ℕ) (hn : n0 ≤ n) (s : IState HS) (LN LB LD : List Item)
    (hN : s.G zN = .int (n : ℤ) :: LN) (hB : s.G zB = .int (bP n : ℤ) :: LB)
    (hD : s.G NLogN.KFM.zD = .int (dP n : ℤ) :: LD) :
    setupB.cost s ≤ 4 * 10 ^ 15 * (bP n + 1) ^ 4 := by
  obtain ⟨hb, hd1, hdb, hd2, hnb, hLb, hel', -, hr, -, -, -⟩ := setup_facts hn
  obtain ⟨A, hA⟩ : ∃ A, A = 2 ^ (bP n + 2) := ⟨_, rfl⟩
  have hbA : 2 ^ bP n * 4 = A := by rw [hA, pow_add]; norm_num
  have hb2 : bP n < 2 ^ bP n := Nat.lt_two_pow_self
  have h2A : 2 ≤ A := by omega
  have hAB : ∀ k ≤ 8, A ^ k < 2 ^ (8 * bP n + 17) := fun k hk => by rw [hA]; exact AB_ok _ k hk
  set Bn := 8 * bP n + 17 with hBn
  -- L
  have htst : ∀ x, 1 ≤ x → x ≤ bP n → tstL.ok (xSt s x) ∧
      (tstL.eval (xSt s x) < 0 ↔ (fun x => 2 ^ (x - 1) * bP n < 4 * n) x) := by
    intro x hx1 _
    have xI : (xSt s x).G NLogN.KFM.sI = .int (x : ℤ) :: s.G sI := by simp (config := {decide := true}) [xSt]
    have xN : (xSt s x).G zN = .int (n : ℤ) :: LN := by
      simp (config := {decide := true}) [xSt, IState.upd_G, hN]
    have xB : (xSt s x).G zB = .int (bP n : ℤ) :: LB := by
      simp (config := {decide := true}) [xSt, IState.upd_G, hB]
    have hx : ((x : ℤ) + -1).toNat = x - 1 := by omega
    refine ⟨?_, ?_⟩
    · simp only [tstL, Ex.ok, Ex.eval, IState.top_eq xI]
      exact ⟨⟨⟨⟨IState.isInt_of xI, trivial⟩, by omega⟩, IState.isInt_of xB⟩, trivial,
        IState.isInt_of xN⟩
    · simp only [tstL, Ex.eval, IState.top_eq xI, IState.top_eq xN, IState.top_eq xB, hx]
      rw [show (2 : ℤ) ^ (x - 1) * (bP n : ℤ) + -((4 : ℤ) * n) < 0 ↔
          (((2 ^ (x - 1) * bP n : ℕ) : ℤ) < ((4 * n : ℕ) : ℤ)) by
        push_cast; constructor <;> intro h <;> linarith]
      exact Nat.cast_lt
  have htB : ∀ x, 1 ≤ x → x ≤ bP n → tstL.Bnd (xSt s x) Bn := by
    intro x hx1 hxb
    have xI : (xSt s x).G NLogN.KFM.sI = .int (x : ℤ) :: s.G sI := by simp (config := {decide := true}) [xSt]
    have xN : (xSt s x).G zN = .int (n : ℤ) :: LN := by
      simp (config := {decide := true}) [xSt, IState.upd_G, hN]
    have xB : (xSt s x).G zB = .int (bP n : ℤ) :: LB := by
      simp (config := {decide := true}) [xSt, IState.upd_G, hB]
    have hx : ((x : ℤ) + -1).toNat = x - 1 := by omega
    have hpx : 2 ^ (x - 1) ≤ 2 ^ bP n := Nat.pow_le_pow_right (by norm_num) (by omega)
    exact exSm_bnd A Bn _ h2A tstL (by
      simp only [tstL, exSm, Ex.eval, IState.top_eq xI, IState.top_eq xN, IState.top_eq xB, hx]
      refine ⟨⟨⟨⟨?_, ?_⟩, ?_, ?_⟩, ?_⟩, ?_, ?_⟩; (all_goals
                                                    first
                                                    | assumption
                                                    | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                                    | ((norm_num); (done))
                                                    | ((norm_num); (omega))
                                                    | omega
                                                    | positivity
                                                    |
                                                      ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                                            first
                                                            | ((norm_num); (done))
                                                            | omega);
                                                        (done)))) (hAB _ (by decide))
  have c1 := cntP_cost (.reg zB) tstL zL (fun x => 2 ^ (x - 1) * bP n < 4 * n) s (bP n)
    (by decide) (by decide) (clean_of_regs _ (by decide)) (by decide) (IState.isInt_of hB)
    (by simp [Ex.eval, IState.top_eq hB]) (clean_of_regs _ (by decide)) (by decide) htst Bn
    (zsz_of_abs (A := A) (k := 1) (by rw [Nat.abs_cast, pow_one]; exact_mod_cast (by omega))
      (hAB 1 (by norm_num)))
    (exSm_bnd A Bn s h2A _ (by simp only [exSm, IState.top_eq hB]; (all_goals
                                                                      first
                                                                      | assumption
                                                                      | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                                                      | ((norm_num); (done))
                                                                      | ((norm_num); (omega))
                                                                      | omega
                                                                      | positivity
                                                                      |
                                                                        ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                                                              first
                                                                              | ((norm_num); (done))
                                                                              | omega);
                                                                          (done)))) (hAB _ (by decide))) htB
  obtain ⟨k1, r1⟩ := cntP_run (.reg zB) tstL zL (fun x => 2 ^ (x - 1) * bP n < 4 * n) s (bP n)
    (by decide) (by decide) (clean_of_regs _ (by decide)) (by decide) (IState.isInt_of hB)
    (by simp [Ex.eval, IState.top_eq hB]) (clean_of_regs _ (by decide)) (by decide) htst
  rw [count_eq_findGreatest _ _ (fun x y hx hxy hy => lt_of_le_of_lt
    (Nat.mul_le_mul_right _ (Nat.pow_le_pow_right (by norm_num) (by omega))) hy),
    ← L_count n hn] at r1
  set t1 := s.upd zL (.int (LP n : ℤ) :: s.G zL) with ht1
  have t1L : t1.G zL = .int (LP n : ℤ) :: s.G zL := by simp [ht1]
  have t1D : t1.G NLogN.KFM.zD = .int (dP n : ℤ) :: LD := by
    simp (config := {decide := true}) [ht1, IState.upd_G, hD]
  -- ℓ
  have hel : elE.eval t1 = (ℓP n : ℤ) := by
    simp only [elE, Ex.eval, IState.top_eq t1L, IState.top_eq t1D, ℓP, ell]
    rw [show (LP n : ℤ) + dP n + -1 = ((LP n + dP n - 1 : ℕ) : ℤ) by
      push_cast [Nat.sub_add_cancel (by omega : 1 ≤ LP n + dP n)]; omega]
    norm_cast
  have c2 := pushCost_le elE t1 Bn (exSm_bnd A Bn t1 h2A _ (by
      simp only [elE, exSm, Ex.eval, IState.top_eq t1L, IState.top_eq t1D]
      refine ⟨⟨⟨?_, ?_⟩, ?_⟩, ?_, ?_⟩; (all_goals
                                          first
                                          | assumption
                                          | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                          | ((norm_num); (done))
                                          | ((norm_num); (omega))
                                          | omega
                                          | positivity
                                          |
                                            ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                                  first
                                                  | ((norm_num); (done))
                                                  | omega);
                                              (done)))) (hAB _ (by decide)))
  set t2 := t1.upd zEl (.int (ℓP n : ℤ) :: t1.G zEl) with ht2
  have r2 : (RS.push zEl elE).run t1 = t2 := by simp only [RS.run, hel, ht2]
  have t2E : t2.G zEl = .int (ℓP n : ℤ) :: s.G zEl := by
    simp (config := {decide := true}) [ht2, ht1, IState.upd_G]
  have t2L : t2.G zL = .int (LP n : ℤ) :: s.G zL := by
    simp (config := {decide := true}) [ht2, IState.upd_G, t1L]
  have t2D : t2.G NLogN.KFM.zD = .int (dP n : ℤ) :: LD := by
    simp (config := {decide := true}) [ht2, IState.upd_G, t1D]
  -- r
  have hrl : 2 ^ ℓP n ≤ 2 ^ bP n := hr
  have c3 := pushCost_le (.pow2 (.reg zEl)) t2 Bn (exSm_bnd A Bn t2 h2A _ (by
      simp only [exSm, Ex.eval, IState.top_eq t2E, Int.toNat_natCast]
      refine ⟨?_, ?_, ?_⟩; (all_goals
                              first
                              | assumption
                              | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                              | ((norm_num); (done))
                              | ((norm_num); (omega))
                              | omega
                              | positivity
                              |
                                ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                      first
                                      | ((norm_num); (done))
                                      | omega);
                                  (done)))) (hAB _ (by decide)))
  set t3 := t2.upd zR (.int (IntMul.OpenAI.Glue.rP n : ℤ) :: t2.G zR) with ht3
  have r3 : (RS.push zR (.pow2 (.reg zEl))).run t2 = t3 := by
    simp only [RS.run, Ex.eval, IState.top_eq t2E, ht3, IntMul.OpenAI.Glue.rP]; push_cast; simp
  have t3E : t3.G zEl = .int (ℓP n : ℤ) :: s.G zEl := by
    simp (config := {decide := true}) [ht3, IState.upd_G, t2E]
  have t3L : t3.G zL = .int (LP n : ℤ) :: s.G zL := by
    simp (config := {decide := true}) [ht3, IState.upd_G, t2L]
  have t3D : t3.G NLogN.KFM.zD = .int (dP n : ℤ) :: LD := by
    simp (config := {decide := true}) [ht3, IState.upd_G, t2D]
  -- d'
  have c4 := pushCost_le dpE t3 Bn (exSm_bnd A Bn t3 h2A _ (by
      simp only [dpE, exSm, IState.top_eq t3D, IState.top_eq t3E, IState.top_eq t3L]
      refine ⟨⟨?_, ?_⟩, ?_⟩; (all_goals
                                first
                                | assumption
                                | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                | ((norm_num); (done))
                                | ((norm_num); (omega))
                                | omega
                                | positivity
                                |
                                  ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                        first
                                        | ((norm_num); (done))
                                        | omega);
                                    (done)))) (hAB _ (by decide)))
  have hs1 : tstL.size + (Ex.reg zB : Ex HS).size + 12 = 24 := by decide
  have hs2 : elE.size + 1 = 8 := by decide
  have hs3 : (Ex.pow2 (.reg zEl) : Ex HS).size + 1 = 3 := by decide
  have hs4 : dpE.size + 1 = 7 := by decide
  rw [hs1] at c1; rw [hs2] at c2; rw [hs3] at c3; rw [hs4] at c4
  have e1 := cfin (bP n) 24 (bP n) (by nlinarith) (by norm_num)
  have e2 := cfin 0 8 (bP n) (by nlinarith) (by norm_num)
  have e3 := cfin 0 3 (bP n) (by nlinarith) (by norm_num)
  have e4 := cfin 0 7 (bP n) (by nlinarith) (by norm_num)
  rw [← hBn] at e1 e2 e3 e4
  rw [setupB, RS.cost_seq', RS.cost_seq', RS.cost_seq', RS.cost_push', RS.cost_push',
    RS.cost_push', r1, r2, r3]
  omega

end NLogN.KFM

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFM
open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS
set_option maxHeartbeats 4000000
theorem solution (n : ℕ) (hn : IntMul.OpenAI.Glue.n0 ≤ n) (s : NLogN.IState NLogN.HS) (LN LB : List NLogN.Item)
    (hN : s.G NLogN.KFM.zN = .int (n : ℤ) :: LN) (hB : s.G NLogN.KFM.zB = .int (IntMul.OpenAI.Glue.bP n : ℤ) :: LB) :
    NLogN.KFM.setupS.ok s ∧ NLogN.KFM.setupS.run s = NLogN.KFM.setupSt n s ∧
      NLogN.KFM.setupS.cost s ≤ 12 * 10 ^ 15 * (IntMul.OpenAI.Glue.bP n + 1) ^ 4 := by
  obtain ⟨kA, rA⟩ := NLogN.KFM.setupA_run n hn s LB hB
  have cA := NLogN.KFM.setupA_cost n hn s LB hB
  set sA := NLogN.KFM.setupA.run s with hsA
  have aN : sA.G NLogN.KFM.zN = .int (n : ℤ) :: LN := by
    rw [rA]; simp (config := {decide := true}) [NLogN.IState.upd_G, hN]
  have aB : sA.G NLogN.KFM.zB = .int (IntMul.OpenAI.Glue.bP n : ℤ) :: LB := by
    rw [rA]; simp (config := {decide := true}) [NLogN.IState.upd_G, hB]
  have aD : sA.G NLogN.KFM.zD = .int (IntMul.OpenAI.Glue.dP n : ℤ) :: s.G zD := by
    rw [rA]; simp (config := {decide := true}) [NLogN.IState.upd_G]
  obtain ⟨kB, rB⟩ := NLogN.KFM.setupB_run n hn sA LN LB (s.G NLogN.KFM.zD) aN aB aD
  have cB := NLogN.KFM.setupB_cost n hn sA LN LB (s.G NLogN.KFM.zD) aN aB aD
  set sB := NLogN.KFM.setupB.run sA with hsB
  have bD : sB.G NLogN.KFM.zD = .int (IntMul.OpenAI.Glue.dP n : ℤ) :: s.G zD := by
    rw [rB]; simp (config := {decide := true}) [NLogN.IState.upd_G, aD]
  have bR : sB.G NLogN.KFM.zR = .int (IntMul.OpenAI.Glue.rP n : ℤ) :: sA.G zR := by
    rw [rB]; simp (config := {decide := true}) [NLogN.IState.upd_G]
  obtain ⟨kC, rC⟩ := NLogN.KFM.setupC_run n hn sB (s.G NLogN.KFM.zD) (sA.G NLogN.KFM.zR) bD bR
  have cC := NLogN.KFM.setupC_cost n hn sB (s.G NLogN.KFM.zD) (sA.G NLogN.KFM.zR) bD bR
  refine ⟨⟨kA, kB, kC⟩, ?_, ?_⟩
  · show NLogN.KFM.setupC.run (NLogN.KFM.setupB.run (NLogN.KFM.setupA.run s)) = _
    rw [rC, rB, rA]
    simp (config := {decide := true}) [NLogN.KFM.setupSt, NLogN.IState.upd_G]
  · show NLogN.KFM.setupA.cost s + (NLogN.KFM.setupB.cost sA + NLogN.KFM.setupC.cost sB) ≤ _
    omega
end
