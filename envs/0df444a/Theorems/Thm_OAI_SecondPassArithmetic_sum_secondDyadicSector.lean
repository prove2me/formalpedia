theorem OAI.SecondPassArithmetic.sum_secondDyadicSector {ι κ : Type*} [DecidableEq ι] [DecidableEq κ] [Fintype κ]
    (F : Finset ι) (K : Finset ι → Finset ι → Finset O) (R : Finset ι)
    (label : Finset ι → SecondExpansionData ι → κ) (H : SecondExpansionData ι → ℂ) :
    (∑ j : κ, ∑ x ∈ secondDyadicSector F K R label j, H x) =
      ∑ x ∈ secondExpansionSector F (fun G E => (K G E).erase 0) R, H x := by sorry
