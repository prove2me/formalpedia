theorem checked_segments (p : ℕ → Prop) (start width count : ℕ) (hw : 0 < width)
    (h : ∀ b : Fin count, ∀ k : Fin width, p (start + b.val * width + k.val))
    (q : ℕ) (hq : q < count * width) : p (start + q) := by
  have hd : q / width < count := (Nat.div_lt_iff_lt_mul hw).mpr hq
  have hm : q % width < width := Nat.mod_lt _ hw
  have hb := h ⟨q / width, hd⟩ ⟨q % width, hm⟩
  have he : q / width * width + q % width = q := by
    simpa only [Nat.mul_comm] using Nat.div_add_mod q width
  simpa only [Nat.add_assoc, he] using hb
end HardyCapset20261020.Cert
