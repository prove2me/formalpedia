import Definitions.Def_HurwitzQ_hurwitzIntegersQ
import Definitions.Def_HurwitzQ_omega
import Mathlib.Algebra.Quaternion
import Mathlib.Algebra.QuaternionBasis
import Mathlib.Algebra.Ring.Subring.Basic
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring

/-!
# The standard generators lie in the Hurwitz integers

The three quaternion units `i, j, k` (Mathlib's `QuaternionAlgebra.Basis.self ℚ`) and the
half-integral generator `ω = (1 + i + j + k) / 2` are Hurwitz integers. These are the extra
membership facts beyond `Subring.zero_mem`, `one_mem'`, `add_mem`, `neg_mem`, `mul_mem`,
which hold for every subring; together they exhibit the generating set of
`hurwitzIntegersQ_eq_closure`.
-/

open Quaternion QuaternionAlgebra

open HurwitzQ

/-- The first quaternion unit is a Hurwitz integer (integral branch). -/
theorem basisI_mem_hurwitzIntegersQ : ((Basis.self ℚ).i : ℍ[ℚ]) ∈ hurwitzIntegersQ :=
  .inl ⟨0, 1, 0, 0, by simp, by simp, by simp, by simp⟩

/-- The second quaternion unit is a Hurwitz integer (integral branch). -/
theorem basisJ_mem_hurwitzIntegersQ : ((Basis.self ℚ).j : ℍ[ℚ]) ∈ hurwitzIntegersQ :=
  .inl ⟨0, 0, 1, 0, by simp, by simp, by simp, by simp⟩

/-- The third quaternion unit is a Hurwitz integer (integral branch). -/
theorem basisK_mem_hurwitzIntegersQ : ((Basis.self ℚ).k : ℍ[ℚ]) ∈ hurwitzIntegersQ :=
  .inl ⟨0, 0, 0, 1, by simp, by simp, by simp, by simp⟩

/-- The generator `ω` (`omega`) is a Hurwitz integer (half-integral branch). -/
theorem omega_mem_hurwitzIntegersQ : omega ∈ hurwitzIntegersQ :=
  .inr ⟨0, 0, 0, 0, by simp [omega], by simp [omega], by simp [omega], by simp [omega]⟩



/-!
# The Hurwitz integers are the generator ring `ℤ[i, j, k, ω]`

The second, algebraic characterization of the Hurwitz order: as a subring of `ℍ[ℚ]` it is
generated by the three quaternion units and `ω = (1 + i + j + k) / 2`. The proof has two
halves: the coordinate set is a subring containing the generators (so the closure is
contained in it), and every half-integral element is an integral element plus `ω`, while
the integral elements are integer combinations of `1, i, j, k` (so the coordinate set is
contained in the closure). This exhibits `ℤ[i, j, k, ω]` — the notation under which the
Hurwitz integers are usually written — as a theorem rather than a definition.
-/

open Quaternion QuaternionAlgebra

open HurwitzQ


theorem solution :
    hurwitzIntegersQ =
      Subring.closure {((Basis.self ℚ).i : ℍ[ℚ]), (Basis.self ℚ).j, (Basis.self ℚ).k, omega} := by
  let i : ℍ[ℚ] := (Basis.self ℚ).i
  let j : ℍ[ℚ] := (Basis.self ℚ).j
  let k : ℍ[ℚ] := (Basis.self ℚ).k
  apply le_antisymm
  · -- every Hurwitz element is an integral combination of `1, i, j, k`, plus `ω` on the
    -- half-integral branch.
    intro q hq
    rcases hq with ⟨a, b, c, d, hqa, hqi, hqj, hqk⟩ | ⟨a, b, c, d, hqa, hqi, hqj, hqk⟩
    · have hq' : q = (↑a : ℍ[ℚ]) + (↑b : ℍ[ℚ]) * i + (↑c : ℍ[ℚ]) * j + (↑d : ℍ[ℚ]) * k := by
        ext <;> simp <;> norm_num [i, j, k] <;> assumption
      rw [hq']
      refine add_mem (add_mem (add_mem ?_ ?_) ?_) ?_
      · exact intCast_mem _ a
      · exact mul_mem (intCast_mem _ b) (Subring.subset_closure (Or.inl rfl))
      · exact mul_mem (intCast_mem _ c) (Subring.subset_closure (Or.inr (Or.inl rfl)))
      · exact mul_mem (intCast_mem _ d) (Subring.subset_closure (Or.inr (Or.inr (Or.inl rfl))))
    · have hq' : q = ((↑a : ℍ[ℚ]) + (↑b : ℍ[ℚ]) * i + (↑c : ℍ[ℚ]) * j + (↑d : ℍ[ℚ]) * k) + omega := by
        ext <;> simp <;> norm_num [i, j, k, omega] <;> assumption
      rw [hq']
      refine add_mem ?_ (Subring.subset_closure (Or.inr (Or.inr (Or.inr rfl))))
      refine add_mem (add_mem (add_mem ?_ ?_) ?_) ?_
      · exact intCast_mem _ a
      · exact mul_mem (intCast_mem _ b) (Subring.subset_closure (Or.inl rfl))
      · exact mul_mem (intCast_mem _ c) (Subring.subset_closure (Or.inr (Or.inl rfl)))
      · exact mul_mem (intCast_mem _ d) (Subring.subset_closure (Or.inr (Or.inr (Or.inl rfl))))
  · -- the coordinate set is a subring, so it contains the closure of any set inside it.
    refine Subring.closure_le.mpr ?_
    intro x hx
    simp at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact basisI_mem_hurwitzIntegersQ
    · exact basisJ_mem_hurwitzIntegersQ
    · exact basisK_mem_hurwitzIntegersQ
    · exact omega_mem_hurwitzIntegersQ


