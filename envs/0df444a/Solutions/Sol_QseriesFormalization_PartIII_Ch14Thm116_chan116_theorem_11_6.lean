    ζ⁻¹ = ζ ^ 4 := by
  apply inv_eq_of_mul_eq_one_right
  calc
    ζ * ζ ^ 4 = ζ ^ 5 := by ring
    _ = 1 := hζ.pow_eq_one

theorem zeta_inv_sq_eq_pow_three {ζ : ℂ} (hζ : IsPrimitiveRoot ζ 5) :
    (ζ⁻¹) ^ 2 = ζ ^ 3 := by
