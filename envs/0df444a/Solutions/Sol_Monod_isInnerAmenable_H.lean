section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

variable {A : Subring ℝ}

theorem exists_ne_one_commute_of_subset_secondDerived' (A : Subring ℝ) (S : Finset (H A))
    (hS : ∀ s ∈ S, s ∈ derivedSeries (H A) 2) :
    ∃ h : H A, h ≠ 1 ∧ ∀ s ∈ S, Commute h s :=
  by
  try haveI := A; try haveI := S; try haveI := hS; first
    | exact Monod.exists_ne_one_commute_of_subset_secondDerived A S hS
    | exact Monod.exists_ne_one_commute_of_subset_secondDerived
    | exact Monod.exists_ne_one_commute_of_subset_secondDerived ..
    | (apply Monod.exists_ne_one_commute_of_subset_secondDerived <;> first | assumption | infer_instance)
    | simpa using Monod.exists_ne_one_commute_of_subset_secondDerived


end Monod.Dev.Dyn
end

section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

theorem isInnerAmenable_H' (A : Subring ℝ) : IsInnerAmenable (H A) := by
  classical
  set J := H A
  set N := derivedSeries J 2
  -- `h_F` for each finite set
  have hex : ∀ F : Finset J, ∃ h : J, h ≠ 1 ∧ ∀ s ∈ F.filter (· ∈ N), Commute h s :=
    fun F => exists_ne_one_commute_of_subset_secondDerived' A (F.filter (· ∈ N))
      (fun s hs => (Finset.mem_filter.1 hs).2)
  choose x hx1 hx2 using hex
  let U : Ultrafilter (Finset J) := Ultrafilter.of atTop
  have hU : (U : Filter (Finset J)) ≤ atTop := Ultrafilter.of_le _
  let act : J → J → J := fun g y => g * y * g⁻¹
  have hmul : ∀ a b y, act (a * b) y = act a (act b y) := fun a b y => by
    simp only [act]; group
  have hone : ∀ y, act 1 y = y := fun y => by simp [act]
  have hN : ∀ w ∈ N, ∀ S, pm U x (act w '' S) = pm U x S := by
    intro w hw S
    have hfix : ∀ᶠ F in (U : Filter (Finset J)), act w (x F) = x F := by
      filter_upwards [hU (eventually_ge_atTop {w})] with F hF
      have hwF : w ∈ F.filter (· ∈ N) := Finset.mem_filter.2 ⟨hF (Finset.mem_singleton_self w), hw⟩
      have hc := hx2 F w hwF
      simp only [act]
      rw [← hc.eq, mul_inv_cancel_right]
    apply pm_congr
    filter_upwards [hfix] with F hn
    constructor
    · rintro ⟨s, hs, hse⟩
      have : s = x F := by
        have := congrArg (act w⁻¹) hse
        rwa [← hmul, inv_mul_cancel, hone, ← hn, ← hmul, inv_mul_cancel, hone] at this
      rwa [← this]
    · intro h
      exact ⟨x F, h, hn⟩
  obtain ⟨m, hm, hmu, hminv, hmfix⟩ := average act hmul hone N
    (hasInvariantMean_quot_derived2 J) (pm U x) (pm_fa U x) (pm_univ U x) hN
  refine ⟨m, hm, hmu, ?_, fun g s => hminv g s⟩
  rw [hmfix {1} (fun g => by simp [act])]
  exact pm_eq_zero U x (fun F h => hx1 F h)

end Monod.Dev.Dyn
end

open Monod in
open OnePoint Filter Topology in
theorem solution (A : Subring ℝ) : IsInnerAmenable (H A) := by
  exact Dev.Dyn.isInnerAmenable_H' A
