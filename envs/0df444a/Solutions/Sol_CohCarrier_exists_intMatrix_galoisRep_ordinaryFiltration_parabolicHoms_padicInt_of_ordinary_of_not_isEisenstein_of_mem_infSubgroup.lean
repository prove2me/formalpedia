  toFun a := χ (a : Ap p T)
  map_one' := χ_e₁ T p S₁ i₁ χ hi₁
  map_mul' a b := by rw [← map_mul]; rfl
  map_zero' := by rw [← map_zero χ]; rfl
  map_add' a b := by rw [← map_add]; rfl

