section
open MvPolynomial
noncomputable section
namespace SoSLinAlg.WeakRank.Dev.Leaf.PartM
open SoSLinAlg.WeakRank SoSLinAlg.WeakRank.Dev.Leaf
variable {n r : ℕ} (I J : Finset (Fin n)) (hIJ : I.card + J.card ≤ r)
def YJ : Matrix J (Fin r) (Poly n r) := Matrix.of fun j k => y j.1 k

def Cm : Matrix J (Fin r) (Poly n r) :=
  Matrix.of fun j k => if k = dcol I J hIJ j then 1 else 0

def Mm : Matrix J J (Poly n r) := Cm I J hIJ * (YJ (r := r) J).transpose

theorem Mm_eq : Mm I J hIJ = (Dmat I J hIJ).transpose := by
  ext j' j
  simp [Mm, Cm, YJ, Dmat, Matrix.mul_apply]

def Nm : Matrix J (Fin r) (Poly n r) := (Mm I J hIJ).adjugate * Cm I J hIJ

def Pm : Matrix (Fin r) (Fin r) (Poly n r) :=
  D I J hIJ • (1 : Matrix (Fin r) (Fin r) (Poly n r)) - (YJ (r := r) J).transpose * Nm I J hIJ

theorem Pm_mul : Pm I J hIJ * (YJ (r := r) J).transpose = 0 := by
  have hdet : (Mm I J hIJ).det = D I J hIJ := by
    rw [Mm_eq, Matrix.det_transpose]; rfl
  rw [Pm, Nm, Matrix.sub_mul, Matrix.smul_mul, Matrix.one_mul, Matrix.mul_assoc,
    Matrix.mul_assoc, ← Mm, Matrix.adjugate_mul, hdet, Matrix.mul_smul, Matrix.mul_one, sub_self]

def gimg : Var n r → Poly n r
  | Sum.inl (i, k) => if i ∈ I then ∑ k', x i k' * Pm I J hIJ k' k else x i k
  | Sum.inr v => MvPolynomial.X (Sum.inr v)

def simg : Var n r → Poly n r := fun v => D I J hIJ ^ (wx I r v) * MvPolynomial.X v

theorem gimg_orth (i : Fin n) (hi : i ∈ I) (j : Fin n) (hj : j ∈ J) :
    ∑ k, gimg I J hIJ (Sum.inl (i, k)) * y j k = 0 := by
  have h := fun a b => congrFun (congrFun (Pm_mul I J hIJ) a) b
  simp only [gimg, if_pos hi, Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero fun k' _ => ?_
  have := h k' ⟨j, hj⟩
  simp only [Matrix.mul_apply, Matrix.transpose_apply, YJ, Matrix.of_apply,
    Matrix.zero_apply] at this
  simp_rw [mul_assoc, ← Finset.mul_sum, this, mul_zero]

theorem simg_sub_gimg (v : Var n r) :
    simg I J hIJ v - gimg I J hIJ v ∈ Ideal.span (Set.range (gen (r := r) I J)) := by
  rcases v with ⟨i, k⟩ | ⟨j, k⟩
  · by_cases hi : i ∈ I
    · have key : simg I J hIJ (Sum.inl (i, k)) - gimg I J hIJ (Sum.inl (i, k)) =
          ∑ j : J, xy i j.1 * Nm I J hIJ j k := by
        simp only [simg, gimg, wx, if_pos hi, pow_one, Pm, Matrix.sub_apply, Matrix.smul_apply,
          Matrix.one_apply, Matrix.mul_apply, Matrix.transpose_apply, YJ, Matrix.of_apply, xy,
          Finset.sum_mul, mul_sub, Finset.sum_sub_distrib, Finset.mul_sum, smul_eq_mul]
        rw [Finset.sum_comm (s := (Finset.univ : Finset (Fin r)))]
        simp [x, y, mul_comm, mul_assoc]
      rw [key]
      refine Ideal.sum_mem _ fun j _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ?_)
      exact ⟨⟨(i, j.1), hi, j.2⟩, rfl⟩
    · simp [simg, gimg, wx, hi, x]
  · simp [simg, gimg, wx]

theorem aeval_gimg (G : Poly n r) (hv : Van I J G) : aeval (gimg I J hIJ) G = 0 := by
  apply MvPolynomial.funext
  intro z
  rw [map_zero]
  have h1 : eval z (aeval (gimg I J hIJ) G) = eval (fun v => eval z (gimg I J hIJ v)) G :=
    comp_aeval_apply (gimg I J hIJ) (aeval z) G
  let X' : Matrix (Fin n) (Fin r) ℝ := Matrix.of fun i k => eval z (gimg I J hIJ (Sum.inl (i, k)))
  let Y' : Matrix (Fin n) (Fin r) ℝ := Matrix.of fun j k => z (Sum.inr (j, k))
  have h2 : (fun v => eval z (gimg I J hIJ v)) = assignment X' Y' := by
    funext v
    rcases v with ⟨i, k⟩ | ⟨j, k⟩
    · rfl
    · simp [gimg, assignment, Y']
  rw [h1, h2]
  apply hv
  intro i hi j hj
  have := congrArg (eval z) (gimg_orth I J hIJ i hi j hj)
  simp only [map_sum, map_mul, map_zero] at this
  simpa [Matrix.mul_apply, X', Y', y] using this

end SoSLinAlg.WeakRank.Dev.Leaf.PartM
end
end

section
open MvPolynomial
noncomputable section
namespace SoSLinAlg.WeakRank.Dev.Leaf.PartM
open SoSLinAlg.WeakRank SoSLinAlg.WeakRank.Dev.Leaf
variable {n r : ℕ} (I J : Finset (Fin n))
theorem multiplier (hIJ : I.card + J.card ≤ r) (G : Poly n r) (e : ℕ)
    (hG : IsWeightedHomogeneous (wx I r) G e) (hv : Van I J G) :
    D I J hIJ ^ e * G ∈ Ideal.span (Set.range (gen (r := r) I J)) := by
  set a := Ideal.span (Set.range (gen (r := r) I J))
  have h1 : aeval (simg I J hIJ) G = D I J hIJ ^ e * G := by
    have := aeval_scale (wx I r) (D I J hIJ) MvPolynomial.X G e hG
    rw [aeval_X_left_apply] at this
    exact this
  have h2 : (Ideal.Quotient.mkₐ ℝ a).comp (aeval (simg I J hIJ)) =
      (Ideal.Quotient.mkₐ ℝ a).comp (aeval (gimg I J hIJ)) := by
    apply MvPolynomial.algHom_ext
    intro v
    simp only [AlgHom.comp_apply, aeval_X, Ideal.Quotient.mkₐ_eq_mk]
    exact Ideal.Quotient.eq.2 (simg_sub_gimg I J hIJ v)
  rw [← h1, ← Ideal.Quotient.eq_zero_iff_mem]
  have := AlgHom.congr_fun h2 G
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at this
  rw [this, aeval_gimg I J hIJ G hv, map_zero]

end SoSLinAlg.WeakRank.Dev.Leaf.PartM
end
