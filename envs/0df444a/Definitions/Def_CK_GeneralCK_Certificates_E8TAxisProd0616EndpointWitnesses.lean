    centerALowerYBox.Contains (Y (lower E8TAxisProd0616PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0616PaddedInputs.centerAInput.alpha = ((474860522247948771940036538063380708083726959 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
