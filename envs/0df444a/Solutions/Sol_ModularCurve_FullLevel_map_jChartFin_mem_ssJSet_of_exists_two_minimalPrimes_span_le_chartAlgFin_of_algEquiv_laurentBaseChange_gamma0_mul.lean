theorem mem_chartAlg_map {R : Type u} [CommRing R] {F F' : Type u} [Field F] [Field F'] [Algebra R F] [Algebra R F']
    (φ : F →ₐ[R] F') {S : Set F} {x : F} (hx : x ∈ chartAlg R F S) : φ x ∈ chartAlg R F' (φ '' S) := by
  classical
  have hadj : ∀ z ∈ Algebra.adjoin R S, φ z ∈ Algebra.adjoin R (φ '' S) := by
    intro z hz
    have : (Algebra.adjoin R S).map φ ≤ Algebra.adjoin R (φ '' S) := by rw [AlgHom.map_adjoin]
    exact this ⟨z, hz, rfl⟩
  let ψ : ↥(Algebra.adjoin R S) →+* ↥(Algebra.adjoin R (φ '' S)) :=
    (φ.toRingHom.comp (Algebra.adjoin R S).val.toRingHom).codRestrict
      (Algebra.adjoin R (φ '' S)).toSubring (fun z => hadj z z.2)
  rw [mem_chartAlg_iff] at hx ⊢
  exact hx.map_of_comp_eq ψ φ.toRingHom (by ext y; rfl)

noncomputable def chartEquiv {R : Type u} [CommRing R] {F F' : Type u} [Field F] [Field F'] [Algebra R F] [Algebra R F']
    (e : F ≃ₐ[R] F') (j : F) [Fact (j ≠ 0)] [Fact (e j ≠ 0)] :
    ↥(chartAlgFin R F j) ≃+* ↥(chartAlgFin R F' (e j)) where
  toFun x := ⟨e x, by
    have h := mem_chartAlg_map (e : F →ₐ[R] F') (S := {j}) x.2
    rw [Set.image_singleton] at h
    exact h⟩
  invFun y := ⟨e.symm y, by
    have h := mem_chartAlg_map (e.symm : F' →ₐ[R] F) (S := {e j}) y.2
    have h2 : ((e.symm : F' →ₐ[R] F) '' {e j}) = {j} := by
      rw [Set.image_singleton]; congr 1; exact e.symm_apply_apply j
    rw [h2] at h
    exact h⟩
  left_inv x := Subtype.ext (e.symm_apply_apply (x : F))
  right_inv y := Subtype.ext (e.apply_symm_apply (y : F'))
  map_mul' x y := Subtype.ext (by simp)
  map_add' x y := Subtype.ext (by simp)

theorem coe_chartEquiv {R : Type u} [CommRing R] {F F' : Type u} [Field F] [Field F'] [Algebra R F] [Algebra R F']
    (e : F ≃ₐ[R] F') (j : F) [Fact (j ≠ 0)] [Fact (e j ≠ 0)] (x : ↥(chartAlgFin R F j)) :
    ((chartEquiv e j x : ↥(chartAlgFin R F' (e j))) : F') = e x := rfl

theorem chartEquiv_algebraMap {R : Type u} [CommRing R] {F F' : Type u} [Field F] [Field F'] [Algebra R F]
    [Algebra R F'] (e : F ≃ₐ[R] F') (j : F) [Fact (j ≠ 0)] [Fact (e j ≠ 0)] (a : R) :
    chartEquiv e j (algebraMap R _ a) = algebraMap R _ a :=
  Subtype.ext (by rw [coe_chartEquiv]; exact e.commutes a)

theorem chartEquiv_jChartFin {R : Type u} [CommRing R] {F F' : Type u} [Field F] [Field F'] [Algebra R F]
    [Algebra R F'] (e : F ≃ₐ[R] F') (j : F) [Fact (j ≠ 0)] [Fact (e j ≠ 0)] :
    chartEquiv e j (jChartFin R F j) = jChartFin R F' (e j) :=
  Subtype.ext rfl

