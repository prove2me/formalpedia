def tuples : ℕ→List ℕ→List (List ℕ)
  | 0,_ => [[]]
  | k+1,xs => xs.flatMap (fun head => (tuples k xs).map (fun tail => head::tail))

@[fun_prop] theorem tuples_poly (k : ℕ) : Poly (_root_.Integration9_9.TM2NativeTupleEnumeration.tuples k) := by
  induction k with
  | zero => exact Automatic.Poly.const [[]]
  | succ k ih =>
    change Poly (fun xs : List ℕ => xs.flatMap (fun head => (_root_.Integration9_9.TM2NativeTupleEnumeration.tuples k xs).map (fun tail => head::tail)))
    fun_prop



