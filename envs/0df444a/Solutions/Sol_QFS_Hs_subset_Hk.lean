/-- **Equation (5)**: `H^{α/2}(Ω) ⊆ H_k(Ω)`. -/
theorem solution {Γ : QFS.Configuration (EuclideanSpace ℝ (Fin d))} {α Λ : ℝ}
    {k : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℝ≥0∞}
    (hk : QFS.KernelBounds Γ α Λ k) (Ω : Set (EuclideanSpace ℝ (Fin d))) :
    QFS.Hs Ω α ⊆ QFS.Hk Ω k := by
  rintro f ⟨hmem, hfin⟩
  refine ⟨hmem, ?_⟩
  refine ne_top_of_le_ne_top ?_ (QFS.form_le_formHs hk Ω f)
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hfin
