theorem enF_spec' (sN tN lam st : ℕ) :
    J6Seg.cutP sN tN lam (st + 1 + J6Seg.enF sN tN lam st) ∨ sN ≤ st + 1 + J6Seg.enF sN tN lam st :=
  Nat.find_spec (J6Seg.enF_ex sN tN lam st)

theorem enF_min' {sN tN lam st k : ℕ} (hk : k < J6Seg.enF sN tN lam st) :
    ¬ (J6Seg.cutP sN tN lam (st + 1 + k) ∨ sN ≤ st + 1 + k) :=
  Nat.find_min (J6Seg.enF_ex sN tN lam st) hk

/-- **The block-length scan.** -/
theorem scan_sp_sol_aux (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {Cs : Fin HS}
    (hCs : Cs ∉ rg) (hCs5 : Cs.val < 56) (hcs : c Cs = []) {A sN tN lam st : ℕ} (hA : 2 ≤ A)
    (hv : VB v A) (h1 : v 1 = st) (h22 : v 22 = sN) (h23 : v 23 = tN) (h24 : v 24 = lam)
    (hl : 1 ≤ lam) (hlA : lam ≤ 2 ^ A) :
    Sp (scan Cs) (encK s (RF v c))
      (encK s (RF (Function.update (Function.update v 2 ((1 + J6Seg.enF sN tN lam st : ℕ) : ℤ)) 5 1) c))
      (cScan A lam) := by
  have h1A : (1 : ℤ) ≤ 2 ^ A := one_le_pow₀ (by norm_num)
  set e := J6Seg.enF sN tN lam st with he
  have hel : e < lam := by have := J6Seg.en_le_lam (s := sN) (t := tN) hl st; omega
  -- the two initialisations
  have s0 := spA s v c (i := 2) (by decide) (e := .lit 1) (inRg_of (by decide)) trivial
    (V := fun _ => 2 ^ A) (B := BW A) (by intro j hj; simp [Ex.regs] at hj)
    (hv 2 (by decide)) (mgB hA (by decide) (by decide))
    (Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega))
  simp only [Ex.eval] at s0
  have hv0 : VB (Function.update v 2 1) A := VB_upd hv 2 (by simpa using h1A)
  have s1 := spA s (Function.update v 2 1) c (i := 5) (by decide) (e := .lit 0) (inRg_of (by decide))
    trivial (V := fun _ => 2 ^ A) (B := BW A) (by intro j hj; simp [Ex.regs] at hj)
    (hv0 5 (by decide)) (mgB hA (by decide) (by decide))
    (Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega))
  simp only [Ex.eval] at s1
  have e0 : Function.update (Function.update v 2 1) 5 0 = scS v e 0 := by
    simp [scS]
  rw [e0] at s1
  have hVB : ∀ i ≤ lam, VB (scS v e i) A := by
    intro i hi
    refine VB_upd (VB_upd hv 2 ?_) 5 ?_
    · rw [abs_of_nonneg (by positivity)]
      have : 1 + min i e ≤ 2 ^ A := by omega
      exact_mod_cast this
    · split_ifs <;> simp [h1A]
  have o : ∀ i : ℕ, ∀ j : Fin HS, j ≠ 2 → j ≠ 5 → scS v e i j = v j := by
    intro i j a b; simp [scS, a, b]
  have R := Sp.rep (C := Cs) (n := .reg 24) (b := scB) (s := s)
    (F := fun i => RF (scS v e i) c) (N := lam) (B := BW A) (c := cScB A) hCs5
    (fun k => by simp only [RF_out hCs, hcs])
    (by simp [scB, RS.writes]; exact ⟨by rintro rfl; exact hCs (by decide), by rintro rfl; exact hCs (by decide)⟩)
    (clean_of_inRg (inRg_reg (by decide))) (ok_RF (inRg_reg (by decide)) rfl) trivial
    (bnd_of_mg _ (fun _ => 2 ^ A) (BW A) _ (RF_bnd (inRg_reg (by decide))
      (vb_regs (hVB 0 (by omega)) (inRg_reg (by decide)))) (mgB hA (by decide) (by decide)))
    (by rw [ev_reg (by decide), o 0 24 (by decide) (by decide), h24])
    (fun i hi => by
      simp only [upd_RF_out hCs]
      set cc := Function.update c Cs [(lam : ℤ) - i]
      have hw := hVB i hi.le
      have w5 : scS v e i 5 = if e < i then 1 else 0 := by simp [scS]
      have w2 : scS v e i 2 = ((1 + min i e : ℕ) : ℤ) := by simp [scS]
      have ge : i ≤ e → gE.eval (encK s (RF (scS v e i) cc)) = gV sN tN lam ((st + 1 + i : ℕ) : ℤ) := by
        intro hie
        rw [gE_eval (by rw [o i 22 (by decide) (by decide), h22])
          (by rw [o i 23 (by decide) (by decide), h23]) (by rw [o i 24 (by decide) (by decide), h24]),
          o i 1 (by decide) (by decide), h1, w2]
        congr 1
        rw [Nat.min_eq_left hie]; push_cast; ring
      have ef : fE.eval (encK s (RF (scS v e i) cc)) = (if e < i then 1 else 0) - 1 := by
        simp only [fE, Ex.eval, top_RF (show (5 : Fin HS) ∈ rg by decide), w5]; ring
      have mF := mgB (e := fE) hA (by decide) (by decide)
      have mG := mgB (e := .neg gE) hA (by decide) (by decide)
      have iF : InRg fE := inRg_of (by decide)
      have iG : InRg (.neg gE) := inRg_of (by decide)
      rcases lt_trichotomy i e with h | h | h
      · -- continue: n++
        have hf : ¬ e < i := by omega
        have gpos : 0 < gV sN tN lam ((st + 1 + i : ℕ) : ℤ) := by
          have := gV_spec (s := sN) (t := tN) hl (j := st + 1 + i) (by omega)
          have hm := enF_min' (sN := sN) (tN := tN) (lam := lam) (st := st) h
          rcases this with ⟨h0, h1'⟩
          rcases lt_or_eq_of_le h0 with h2 | h2
          · exact h2
          · exact absurd (h1'.1 h2.symm) hm
        have a2 := spA s (scS v e i) cc (i := 2) (by decide) (e := .add (.reg 2) (.lit 1))
          (inRg_of (by decide)) (ok_RF (inRg_of (by decide)) rfl) (V := fun _ => 2 ^ A) (B := BW A)
          (vb_regs hw (inRg_of (by decide))) (hw 2 (by decide)) (mgB hA (by decide) (by decide))
          (Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega))
        have inner := spIT s (scS v e i) cc iG (show (Ex.neg gE).ok _ from ok_gE) (vb_regs hw iG) mG
          (by simp only [Ex.eval, ge h.le]; linarith) (b := .asg 5 (.lit 1)) a2
        have outer := spIT s (scS v e i) cc iF (ok_RF iF rfl) (vb_regs hw iF) mF
          (by rw [ef, if_neg hf]; norm_num) (b := .skip) inner
        refine (outer.congr ?_).mono ?_
        · congr 2
          simp only [Ex.eval, top_RF (show (2 : Fin HS) ∈ rg by decide), w2]
          funext j
          by_cases a : j = 2
          · subst a; simp [scS, Nat.min_eq_left h.le, Nat.min_eq_left (show i + 1 ≤ e by omega)]; ring
          · by_cases b : j = 5
            · subst b; simp [scS, hf, show ¬ e < i + 1 by omega]
            · simp [scS, a, b]
        · unfold cScB; omega
      · -- stop: flag := 1
        subst h
        have hf : ¬ e < e := lt_irrefl _
        have gz : gV sN tN lam ((st + 1 + e : ℕ) : ℤ) = 0 :=
          ((gV_spec (s := sN) (t := tN) hl (j := st + 1 + e) (by omega)).2).2 (enF_spec' sN tN lam st)
        have a5 := spA s (scS v e e) cc (i := 5) (by decide) (e := .lit 1)
          (inRg_of (by decide)) trivial (V := fun _ => 2 ^ A) (B := BW A)
          (by intro j hj; simp [Ex.regs] at hj) (hw 5 (by decide)) (mgB hA (by decide) (by decide))
          (Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega))
        have inner := spIF s (scS v e e) cc iG (show (Ex.neg gE).ok _ from ok_gE) (vb_regs hw iG) mG
          (by simp only [Ex.eval, ge le_rfl, gz]; norm_num) (a := .asg 2 (.add (.reg 2) (.lit 1))) a5
        have outer := spIT s (scS v e e) cc iF (ok_RF iF rfl) (vb_regs hw iF) mF
          (by rw [ef, if_neg hf]; norm_num) (b := .skip) inner
        refine (outer.congr ?_).mono ?_
        · congr 2
          simp only [Ex.eval]
          funext j
          simp only [scS, Function.update_apply]
          split_ifs <;> first | rfl | (push_cast; omega) | omega
        · unfold cScB; omega
      · -- finished: skip
        have hf : e < i := h
        have outer := spIF s (scS v e i) cc iF (ok_RF iF rfl) (vb_regs hw iF) mF
          (by rw [ef, if_pos hf]; norm_num)
          (a := .ite (.neg gE) (.asg 2 (.add (.reg 2) (.lit 1))) (.asg 5 (.lit 1))) (Sp.skip _)
        refine (outer.congr ?_).mono ?_
        · congr 2
          funext j
          simp only [scS, Function.update_apply]
          split_ifs <;> first | rfl | (push_cast; omega) | omega
        · unfold cScB; omega)
  have ef : scS v e lam = Function.update (Function.update v 2 ((1 + e : ℕ) : ℤ)) 5 1 := by
    simp only [scS, if_pos hel, min_eq_right hel.le]
  rw [ef] at R
  refine (s0.seq (s1.seq R)).mono ?_
  unfold cScan
  simp only [Ex.size]
  omega

end J6Seg.PreT

end

theorem solution : type_of% @J6Seg.PreT.scan_sp_sol_aux := @J6Seg.PreT.scan_sp_sol_aux
