set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

theorem n78_gen {N T B W p : ℕ} (hN : N = T) (hB : B + 2 ≤ (W + 5) * p) (hpT : p ≤ T)
    (hp : 1 ≤ p) :
    cCopy (2 * N) B ≤ 10 ^ 9 * (W + 5) ^ 2 * (T * p) ∧
    cSwap (2 * N) B ≤ 10 ^ 9 * (W + 5) ^ 2 * (T * p) := by
