  | [], s, R, _, hX => by
    refine (IRuns.loopF (notMk_mark s X R (by simpa using hX))).mono' ?_ (by simp)
    refine IState.ext' (fun j => ?_) rfl rfl
    by_cases h1 : j = Y
    · subst h1; simp
    · by_cases h2 : j = X
      · subst h2; simp [h1]; simpa using hX
      · simp [h1, h2]
