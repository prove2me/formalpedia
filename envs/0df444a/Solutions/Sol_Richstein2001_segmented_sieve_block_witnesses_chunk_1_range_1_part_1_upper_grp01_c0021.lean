def fpool (f : ℕ) : ℕ :=
  cond (Nat.blt f 9) (Nat.factorial 2) (cond (Nat.blt f 81) (Nat.factorial 8)
    (cond (Nat.blt f 6561) (Nat.factorial 80) (cond (Nat.blt f 31684) (Nat.factorial 177) PR)))

