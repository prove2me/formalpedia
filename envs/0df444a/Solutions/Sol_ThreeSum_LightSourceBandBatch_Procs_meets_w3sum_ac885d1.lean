set_option maxHeartbeats 2200000
set_option maxRecDepth 16000
variable {lim : Limits} {P : Program} {d : ℕ}
namespace ThreeSum.LightSourceBandBatch
namespace Procs
theorem _root_.solution {pMain : ℕ} (C : Procs P pMain) {μ : ℕ → ℤ} {src n g p m base U D : ℕ} {shift : ℤ} (f : ℕ → ℤ)
    (hw : (lim.space : ℤ) ≤ lim.word) (hd : d + 4 < lim.depth) (hg : 0 < g) (hp : 0 < p) (hm : 0 < m)
    (hsrc : src + n ≤ base) (hspace : LightSourceResidues.space (work base n g m) p U D ≤ lim.space)
    (hshift : |shift| ≤ (D : ℤ)) (hword : (LightSourceBandStep.word n g p m U D : ℤ) ≤ lim.word)
    (hread : ∀ j < n, μ (src + j) = f j) (hvalues : ∀ j < n, |f j| ≤ (U : ℤ)) :
    Meets lim P pMain d [src, n, g, p, m, shift, base, cap n g, size n g, data base n g, stride n g m, work base n g m]
      μ (time n g p m U D) (fun _ ν => (∀ i < size n g, SourceBandData.At ν f base n g p m shift i) ∧ Kept μ ν base) :=
  by
  have hwork : work base n g m ≤ lim.space := by unfold LightSourceResidues.space at hspace; omega
  have hbase : base ≤ work base n g m :=
    by
    have hh := data_le_hist base n g m (size n g)
    unfold data at hh
    exact (by omega : base ≤ hist base n g m (size n g))
  have hcount := size_le n g
  apply Meets.of_body C.main
  unfold body time
  refine
    Ends.for (Inv μ f src n g p m base shift) (size n g) (LightSourceBandStep.time n g p m U D + 172) ?start ?round
      ?done ?bound
  case start =>
    refine ⟨0, μ, ?_, ?_, fun _ _ => rfl⟩
    · exact congrArg (fun loc => (⟨loc, μ⟩ : State)) ((update_frame_setLocal _ _ _).trans (frame_append_zeros _ 1).symm)
    · intro i hi; omega
  case round =>
    rintro i _ hi _ ⟨r, ν, rfl, written, kept⟩
    have hread' : ∀ j < n, ν (src + j) = f j := by
      intro j hj
      exact (kept _ (by omega)).trans (hread j hj)
    have hrun :=
      C.step.meets (d := d + 1) (μ := ν) (src := src) (n := n) (g := g) (p := p) (m := m) (base := base) (U := U) (D :=
        D) (shift := shift) (i := i) f hw (by omega) hg hp hm hi hsrc hspace hshift hword hread' hvalues
    focus
      ((first
          | refine _root_.Light.Ends.seqSelf ?_
          | refine _root_.Light.Ends.skipLast ?_);
        (repeat
            with_unfolding_none
              first
              | refine _root_.Light.Ends.seqAssoc ?_
              | refine _root_.Light.Ends.skipThen ?_))
      first
      | refine _root_.Light.Ends.callToThen (hrun _ (by omega)) ?_ ?_ ?_ ?_
      | refine _root_.Light.Ends.callToThen hrun ?_ ?_ ?_ ?_
      on_goal -1 =>
        first
        | ( simp only [_root_.Light.Stmt.blockCost, _root_.Light.Cond.cost, _root_.Light.Expr.cost,
              _root_.List.map_cons, _root_.List.map_nil, _root_.List.sum_cons, _root_.List.sum_nil, ]
            first
            | omega
            | (ring_nf; omega))
        | omega
        |
          (simp [] <;> first
              | omega
              | (ring_nf; omega))
      on_goal -1 => omega
      on_goal -1 =>
        ( (try have := _root_.Light.Std.space_le (by assumption))
          (try have := _root_.Light.Std.const_le (by assumption))
          simp [_root_.Light.Limits.Addr, _root_.abs_le, -_root_.abs_mul, ] <;> omega)
      on_goal -1 => (rintro s ν' ⟨stored, kept'⟩; try with_unfolding_none refine _root_.Light.Ends.skip ?_)
    refine ⟨by simp, s, ν', by simp [update_frame_setLocal], ?_, ?_⟩
    · intro j hj
      rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | rfl
      · exact (written j hj).of_later kept' hm hj hi
      · exact stored
    · intro x hx
      have hb := data_le_hist base n g m i
      unfold data at hb
      exact (kept' x ⟨by omega, Or.inl (by omega)⟩).trans (kept x hx)
  case done =>
    rintro _ _ ⟨r, ν, rfl, written, kept⟩
    exact ⟨written, kept⟩
  case bound =>
    rintro i _ _ _ ⟨r, ν, rfl, _, _⟩
    simp
end Procs
