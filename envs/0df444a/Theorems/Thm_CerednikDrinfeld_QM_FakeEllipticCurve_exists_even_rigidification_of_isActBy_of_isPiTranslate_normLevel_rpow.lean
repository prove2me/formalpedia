              (Ξ B (frobTwist Onr Fr (- Multiplicative.toAdd (vdet g₀)) ψ) hB ⟨E, ϱ⟩) (Ξ B (frobTwist Onr Fr (- Multiplicative.toAdd (vdet g₀)) ψ) hB ⟨E', ϱ'⟩) →
            ∀ (ψ'' : Onr →ₐ[𝒪] B) (P'' : (Omega K₀ π).obj B),
