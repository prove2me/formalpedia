-- title:
--   Lemma 6.5.5 — a finitely generated cone is a finite union of primitive cones
-- statement:
--   Let $C\subseteq\mathbb{R}^m$ be the convex cone generated by finitely many vectors $a_1,\dots,a_n$, i.e. the set of their nonnegative linear combinations. Then there are finitely many primitive cones $P_1,\dots,P_N$ in $\mathbb{R}^m$ (each generated by at most $m$ linearly independent vectors) with
--
--   $$C=P_1\cup P_2\cup\dots\cup P_N.$$
--
--   Combined with Lemma 6.5.4 and the closedness of finite unions of closed sets, this yields Lemma 6.5.3: every finitely generated convex cone is closed.
--
--   **Formalization Note** The primitive cones are indexed by `Fin N` for some natural number `N`; since $0\in C$, necessarily $N\ge 1$. The generators of the primitive cones are arbitrary vectors of $\mathbb{R}^m$, as in the book's statement.
-- source:
--   Matoušek & Gärtner, Understanding and Using Linear Programming, Springer 2007, p. 97, Lemma 6.5.5

import Mathlib
import Definitions.Def_MatousekLP_Duality_Cones

namespace MatousekLP.Duality

/-- Matoušek & Gärtner, Lemma 6.5.5 (p. 97): the convex cone `C` in `ℝ^m` generated by finitely
many vectors `a₁, …, aₙ` is the union of finitely many primitive cones `P₁, …, P_N`. -/
theorem cone_eq_union_primitive {m n : ℕ} (a : Fin n → EuclideanSpace ℝ (Fin m)) :
    ∃ (N : ℕ) (P : Fin N → Set (EuclideanSpace ℝ (Fin m))),
      (∀ j, IsPrimitiveCone (P j)) ∧ coneGen a = ⋃ j, P j := by sorry

end MatousekLP.Duality
