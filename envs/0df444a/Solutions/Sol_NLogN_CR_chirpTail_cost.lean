  | r :: Z, cur, hZ, h1, h2 => by
    simp only [curF]
    split_ifs
    · exact curF_bnd B Z cur (fun r' hr' => hZ r' (List.mem_cons_of_mem _ hr')) h1 h2
    · apply curF_bnd B Z _ (fun r' hr' => hZ r' (List.mem_cons_of_mem _ hr'))
