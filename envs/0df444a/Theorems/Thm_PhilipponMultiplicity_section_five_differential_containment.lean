-- title:
--   Lemma 5.1, first assertion — differential containment
-- statement:
--   Let $G$ be the embedded product of commutative algebraic groups over one of Philippon's base fields, let $A$ be the analytic subgroup, and take the polynomial, sampling set $\Sigma$, order $T$, ideal chain $I_r$, and selected common maximal component $V$ of Section 5. For every $g\in\Sigma$,
--
--   $$\mathcal D_{g,T}(I_r)\subseteq I(V).$$
--
--   Here the differential ideal is the intrinsic ideal generated by the normalized local derivatives along $A$, and the right side is the selected actual homogeneous prime. The Section 5 construction assumes neither this containment nor Lemma 5.1's other conclusions.
-- source:
--   P. Philippon, Lemmes de zéros dans les groupes algébriques commutatifs, BSMF 114 (1986), pp. 380–383, Lemma 5.1. https://www.numdam.org/item/BSMF_1986__114__355_0/

import Definitions.Def_PhilipponMultiplicity_SectionFive
set_option autoImplicit false
open scoped BigOperators

namespace PhilipponMultiplicity

theorem section_five_differential_containment
    (K : Type*) [NontriviallyNormedField K] (hK : IsPhilipponBaseField K)
    (G : EmbeddedGroupProduct K) (A : AnalyticSubgroup G)
    (C : SectionFiveConstruction G A) :
    ∀ g ∈ C.samplingSet,
      differentialIdeal A g C.contactParameter C.chosenIdeal ≤ C.componentPrime := by sorry

end PhilipponMultiplicity
