      have h2p : 0 < q.2.2 := lt_of_lt_of_le h1p hq.2.2.1
      refine ⟨h0p, h1p, h2p, ?_⟩
      rw [le_div_iff₀ h1p]
      linarith [hq.1.2, hq.2.2.1, hq.2.2.2]
    have harg : ContinuousOn (fun q : ℝ × (ℝ × ℝ) => (φ - q.1 - q.2.1 - q.2.2) / q.2.1) Sprod :=
      (((continuousOn_const.sub continuous_fst.continuousOn).sub
        (continuous_fst.comp continuous_snd).continuousOn).sub
        (continuous_snd.comp continuous_snd).continuousOn).div
        (continuous_fst.comp continuous_snd).continuousOn (fun q hq => ne_of_gt (hq_ok q hq).2.1)
    have hnum : ContinuousOn (fun q : ℝ × (ℝ × ℝ) => ω ((φ - q.1 - q.2.1 - q.2.2) / q.2.1)) Sprod :=
      hω.1.comp harg (fun q hq => (hq_ok q hq).2.2.2)
    have hden : ContinuousOn (fun q : ℝ × (ℝ × ℝ) => q.1 * q.2.1 * q.2.1 * q.2.2) Sprod :=
      (((continuous_fst.mul (continuous_fst.comp continuous_snd)).mul
        (continuous_fst.comp continuous_snd)).mul
        (continuous_snd.comp continuous_snd)).continuousOn
    exact hnum.div hden (fun q hq => by rcases hq_ok q hq with ⟨h0, h1, h2, _⟩; positivity)
  rw [show (volume : Measure (ℝ × (ℝ × ℝ))) = volume.prod volume from rfl,
      setIntegral_prod g3 hint_g3]
  apply setIntegral_congr_fun measurableSet_Icc
  intro x0 _
  dsimp only
  unfold F_fn
  rw [← integral_const_mul]
  congr 1; funext p
  dsimp only [g3]
  ring

private lemma outer_integrableOn {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {φ : ℝ} (hφ : 2 ≤ φ) :
    IntegrableOn (fun x0 : ℝ => (1 / x0) * F_fn ω (φ - x0))
      (Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out)) volume := by
  -- Follows directly from Fubini on the integrable 3D function g3!
  let g3 : ℝ × (ℝ × ℝ) → ℝ := fun q =>
    ω ((φ - q.1 - q.2.1 - q.2.2) / q.2.1) / (q.1 * q.2.1 * q.2.1 * q.2.2)
  set Sprod : Set (ℝ × (ℝ × ℝ)) :=
    Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out) ×ˢ
    tri2 ((A1_num : ℝ) / D_in) ((B1_num : ℝ) / D_in)
  have hint_g3 : IntegrableOn g3 Sprod (volume.prod volume) := by
    apply ContinuousOn.integrableOn_compact (isCompact_Icc.prod (tri2_compact _ _))
    have hA0 : (0 : ℝ) < (A0_num : ℝ) / D_out := by unfold A0_num D_out; norm_num
    have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_in := by unfold A1_num D_in; norm_num
    have hBsum : (B0_num : ℝ) / D_out + 3 * ((B1_num : ℝ) / D_in) ≤ 2 := by
      unfold B0_num D_out B1_num D_in; norm_num
    have hq_ok : ∀ q ∈ Sprod, 0 < q.1 ∧ 0 < q.2.1 ∧ 0 < q.2.2 ∧
        1 ≤ (φ - q.1 - q.2.1 - q.2.2) / q.2.1 := by
      intro q hq
