section Torsion

variable {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}

theorem isHomPt_schemeNsmul (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (d : ℕ) :
    KerOps.IsHomPt L (L.schemeNsmul d) (L.schemeNsmul_over d) := by
  intro T t P Q
  have e : ∀ P : SchemeHomOver t f, CerednikDrinfeld.QM.mapPt (L.schemeNsmul d) (L.schemeNsmul_over d) P = L.nsmul t d P :=
    fun P => Subtype.ext (by rw [RelativeGroupLaw.coe_nsmul_eq_comp_schemeNsmul]; rfl)
  rw [e, e, e, KerOps.nsmul_mul L hc]

abbrev mulBy (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (n d : ℕ) : L.schemeKer n ⟶ L.schemeKer n :=
  KerOps.endK L n (L.schemeNsmul d) (L.schemeNsmul_over d) (isHomPt_schemeNsmul L hc d)

abbrev σd (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (n d : ℕ) :
    L.schemeKer n ⟶ pullback (L.schemeKerStr n) (L.schemeKerStr n) :=
  pullback.lift (𝟙 _) (mulBy L hc n d) (by rw [Category.id_comp, KerOps.endK_str L n _ _ (isHomPt_schemeNsmul L hc d)])
abbrev τ1 (L : RelativeGroupLaw R f) (n : ℕ) : L.schemeKer n ⟶ pullback (L.schemeKerStr n) (L.schemeKerStr n) :=
  pullback.lift (𝟙 _) (L.schemeKerStr n ≫ KerOps.oneK L n)
    (by rw [Category.id_comp, Category.assoc, KerOps.oneK_str, Category.comp_id])

theorem σd_fst (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (n d : ℕ) :
    σd L hc n d ≫ pullback.fst _ _ = 𝟙 _ := pullback.lift_fst _ _ _
theorem τ1_fst (L : RelativeGroupLaw R f) (n : ℕ) : τ1 L n ≫ pullback.fst _ _ = 𝟙 _ := pullback.lift_fst _ _ _

def Td (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (n d : ℕ)
    [IsFinite (L.schemeKerStr n)] [Etale (L.schemeKerStr n)] : (L.schemeKer n).Opens :=
  pullback.lift (σd L hc n d) (τ1 L n) ((σd_fst L hc n d).trans (τ1_fst L n).symm) ⁻¹ᵁ
    (pullback.diagonal (pullback.fst (L.schemeKerStr n) (L.schemeKerStr n))).opensRange

theorem Td_spec (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (n d : ℕ)
    [IsFinite (L.schemeKerStr n)] [Etale (L.schemeKerStr n)] :
    IsClopen ((Td L hc n d : (L.schemeKer n).Opens) : Set ↥(L.schemeKer n)) ∧
    ∀ {T : Scheme.{0}} (g : T ⟶ L.schemeKer n),
      Set.range g ⊆ (Td L hc n d : Set ↥(L.schemeKer n)) ↔ g ≫ σd L hc n d = g ≫ τ1 L n := by
  unfold Td
  exact AlgebraicGeometry.isClopen_preimage_diagonal_of_formallyUnramified_of_isSeparated
    (pullback.fst (L.schemeKerStr n) (L.schemeKerStr n)) (σd L hc n d) (τ1 L n) (σd_fst L hc n d) (τ1_fst L n)

theorem Td_closed (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (n d : ℕ)
    [IsFinite (L.schemeKerStr n)] [Etale (L.schemeKerStr n)] :
    IsClosed (Td L hc n d : Set ↥(L.schemeKer n)) := (Td_spec L hc n d).1.1

theorem range_subset_Td_iff (L : RelativeGroupLaw R f) (hc : L.IsCommutative) (n d : ℕ)
    [IsFinite (L.schemeKerStr n)] [Etale (L.schemeKerStr n)] {T : Scheme.{0}} (g : T ⟶ L.schemeKer n) :
    Set.range g ⊆ (Td L hc n d : Set ↥(L.schemeKer n)) ↔
      g ≫ mulBy L hc n d = g ≫ L.schemeKerStr n ≫ KerOps.oneK L n := by
  rw [(Td_spec L hc n d).2 g]
  constructor
  · intro h
    have := congrArg (· ≫ pullback.snd _ _) h
    simpa only [Category.assoc, pullback.lift_snd] using this
  · intro h
    apply pullback.hom_ext
    · simp only [Category.assoc, pullback.lift_fst]
    · simp only [Category.assoc, pullback.lift_snd, h]

end Torsion
