theorem PermutationDichotomy.equivariant_iff_exists_marked_invariant(act : Γ →* Equiv.Perm ι)
    (F : Seq ι κ → Seq ι κ) :
    ((∀ i a, Continuous fun x => F x i a) ∧ EquivariantUnder act F)
      ↔ ∃ G : κ → C(Seq ι (κ ⊕ Unit), ℝ),
          (∀ a, InvariantUnder act (fun z => G a z)) ∧
            ∀ x i a, F x i a = G a (markAt i x) := by sorry
