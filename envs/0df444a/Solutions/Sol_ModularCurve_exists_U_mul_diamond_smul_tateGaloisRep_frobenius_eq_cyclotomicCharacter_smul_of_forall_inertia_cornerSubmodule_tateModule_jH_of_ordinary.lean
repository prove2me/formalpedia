noncomputable def algEquivOfFixes {K R L : Type} [Field K] [CommRing R] [Field L] [Algebra K L] [Algebra R L]
    (σ : L ≃ₐ[K] L) (hσ : ∀ r : R, σ (algebraMap R L r) = algebraMap R L r) : L ≃ₐ[R] L :=
  { σ.toRingEquiv with
    commutes' := fun r => hσ r }

theorem algEquivOfFixes_apply {K R L : Type} [Field K] [CommRing R] [Field L] [Algebra K L] [Algebra R L]
    (σ : L ≃ₐ[K] L) (hσ : ∀ r : R, σ (algebraMap R L r) = algebraMap R L r) (x : L) :
    algEquivOfFixes σ hσ x = σ x := rfl

theorem exists_algEquiv_apply_eq {K R L : Type} [Field K] [CommRing R] [Field L] [Algebra K L] [Algebra R L]
    (σ : L ≃ₐ[K] L) (hσ : ∀ r : R, σ (algebraMap R L r) = algebraMap R L r) :
    ∃ τ' : L ≃ₐ[R] L, ∀ x : L, τ' x = σ x :=
  ⟨algEquivOfFixes σ hσ, fun _ => rfl⟩

end Lift
end OrdG.A2

