open DrinfeldCurve

theorem DrinfeldCurve.isDedekindDomain_coordRing (q : ℕ) [Fact q.Prime] (k : Type) [Field k]
    [Algebra (GaloisField q 2) k] [IsAlgClosed k] [IsDomain (CoordRing q k)] :
    IsDedekindDomain (CoordRing q k) := by sorry
