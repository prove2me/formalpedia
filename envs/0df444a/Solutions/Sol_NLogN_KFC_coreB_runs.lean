/-! ## Rows of one block -/

theorem sufF_succ (rr : ℕ → ℕ → List ℤ) {q k : ℕ} (hk : k < q) :
    sufF rr q k = fun m => rr k m ++ sufF rr q (k + 1) m := by
  funext m
  obtain ⟨j, hj⟩ : ∃ j, q - k = j + 1 := ⟨q - k - 1, by omega⟩
  simp only [sufF, hj, flF_succ, show q - (k + 1) = j by omega]

theorem sufF_zero (rr : ℕ → ℕ → List ℤ) (q : ℕ) : sufF rr q 0 = grpF rr q := by
  funext m; simp [sufF, grpF, flF, List.range_eq_range']

theorem sufF_self (rr : ℕ → ℕ → List ℤ) (q : ℕ) : sufF rr q q = fun _ => [] := by
  funext m; simp [sufF]

theorem length_sufF_le {rr : ℕ → ℕ → List ℤ} {B : ℕ} (hr : ∀ y m, (rr y m).length = B)
    (q k m : ℕ) : (sufF rr q k m).length ≤ q * B := by
  unfold sufF; rw [length_flF (G := B) (fun y => hr y m)]
  exact Nat.mul_le_mul_right _ (Nat.sub_le _ _)

theorem bnd_sufF {rr : ℕ → ℕ → List ℤ} {w : ℕ} (hb : ∀ y m, Bnd w (rr y m)) (q k m : ℕ) :
    Bnd w (sufF rr q k m) := bnd_flF (fun y => hb y m) _ _

