-- title:
--   Closure of subpowers versus local interpolation
-- statement:
--   $A$ is a set; operations are maps $A^n\to A$ ($n\ge0$). $C=(C_n)_n$ is a clone: it contains all projections and is closed under composition $f(g_0,\dots,g_{n-1})$. An $n$-ary $f$ preserves $R\subseteq A^\iota$ if applying $f$ coordinatewise to any $n$ tuples of $R$ gives a tuple of $R$; $\mathrm{Inv}_k C$ is the set of $k$-ary relations preserved by all members of $C$. Let $n,k\ge1$ and let $f$ be a partial $n$-ary function with domain $D\subseteq A^n$. For an $n\times k$ matrix $M$ (rows in $A^k$, columns in $A^n$), $f(M)\in A^k$ applies $f$ to each column. The following are equivalent: (a) every $R\in\mathrm{Inv}_k C$ is closed under $f$ (for every $M$ with rows in $R$ and columns in $D$, $f(M)\in R$); (b) for every $M$ with columns in $D$, $f(M)$ lies in the row space of $M$ (the intersection of all $R\in\mathrm{Inv}_k C$ containing the rows of $M$); (c) for every $E\subseteq D$ with at most $k$ elements some $p\in C_n$ agrees with $f$ on $E$.
-- source:
--   K. A. Baker, A. F. Pixley, Polynomial interpolation and the Chinese remainder theorem for algebraic systems, Math. Z. 143 (1975) 165-174, https://doi.org/10.1007/BF01187059, Lemma 3.1; D. Lau, Function Algebras on Finite Sets, Springer Monographs in Mathematics, 2006, https://doi.org/10.1007/3-540-36023-9, Part II, proof of Theorem 8.3.1, step I

import Definitions.Def_FunctionAlgebras_defs

universe u

namespace FunctionAlgebras

variable {A : Type u}

/-- Baker–Pixley (1975), Lemma 3.1, for the clone `C` of term operations ("polynomials") of an
algebra on `A` (Lau, proof of Theorem 8.3.1, step I).  Let `n, k > 0` and let `f` be a partial
`n`-ary function with domain `D`.  An `n × k` matrix `M` has rows `M j ∈ A^k` and columns
`(fun j => M j i) ∈ A^n`.  The following are equivalent:
(a) every `k`-ary invariant relation of `C` (subuniverse of `A^k`) is closed under `f` where `f`
    is defined;
(b) for every `n × k` matrix `M` whose columns lie in `D`, the row vector `f(M)` lies in the row
    space of `M` (the subuniverse of `A^k` generated by the rows of `M`);
(c) the restriction of `f` to any `k` or fewer points of its domain is interpolated by a member
    of `C n`. -/
theorem closure_iff_interpolation (C : ∀ n : ℕ, Set ((Fin n → A) → A)) (hC : IsClone C)
    {n k : ℕ} (hn : 0 < n) (hk : 0 < k) (f : (Fin n → A) → A) (D : Set (Fin n → A)) :
    List.TFAE
      [∀ R ∈ Inv C k, ∀ M : Fin n → Fin k → A, (∀ j, M j ∈ R) →
          (∀ i, (fun j => M j i) ∈ D) → (fun i => f (fun j => M j i)) ∈ R,
        ∀ M : Fin n → Fin k → A, (∀ i, (fun j => M j i) ∈ D) →
          (fun i => f (fun j => M j i)) ∈ ⋂₀ {R | R ∈ Inv C k ∧ ∀ j, M j ∈ R},
        ∀ E : Finset (Fin n → A), (↑E : Set (Fin n → A)) ⊆ D → E.card ≤ k →
          Interpolates C f ↑E] := by sorry

end FunctionAlgebras
