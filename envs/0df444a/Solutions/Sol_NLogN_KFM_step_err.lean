open NLogN
open NLogN.KFM
open Complex KFB
theorem solution (P : ℕ) (z w : NLogN.KFB.GI) (Z W : ℂ) (hZ : ‖Z‖ ≤ 1) (hW : ‖W‖ ≤ 1) {a b : ℝ}
    (ha : ‖NLogN.KFM.vP P z - Z‖ ≤ a) (ha1 : a ≤ 1) (hb : ‖NLogN.KFM.vP P w - W‖ ≤ b) :
    ‖NLogN.KFM.vP P (NLogN.KFM.gmulT P z w) - Z * W‖ ≤ a + 2 * b + 2 * (2 : ℝ)⁻¹ ^ P := by
  rw [NLogN.KFM.vP_gmulT]
  have hq := Butterfly.norm_Qp_sub_lt P (NLogN.KFM.vP P z * NLogN.KFM.vP P w)
  have hs2 : Real.sqrt 2 ≤ 2 := by
    rw [Real.sqrt_le_left (by norm_num)]; norm_num
  have hu : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ P := by positivity
  have hx : ‖NLogN.KFM.vP P z‖ ≤ 2 := by
    have := norm_le_insert' (NLogN.KFM.vP P z) Z
    calc ‖NLogN.KFM.vP P z‖ ≤ ‖Z‖ + ‖NLogN.KFM.vP P z - Z‖ := by
          have := norm_add_le Z (NLogN.KFM.vP P z - Z); simpa using this
      _ ≤ 2 := by linarith
  have e : NLogN.KFM.vP P z * NLogN.KFM.vP P w - Z * W = NLogN.KFM.vP P z * (NLogN.KFM.vP P w - W) + (NLogN.KFM.vP P z - Z) * W := by ring
  have h1 : ‖NLogN.KFM.vP P z * NLogN.KFM.vP P w - Z * W‖ ≤ 2 * b + a := by
    rw [e]
    calc _ ≤ ‖NLogN.KFM.vP P z * (NLogN.KFM.vP P w - W)‖ + ‖(NLogN.KFM.vP P z - Z) * W‖ := norm_add_le _ _
      _ = ‖NLogN.KFM.vP P z‖ * ‖NLogN.KFM.vP P w - W‖ + ‖NLogN.KFM.vP P z - Z‖ * ‖W‖ := by rw [norm_mul, norm_mul]
      _ ≤ 2 * b + a * 1 := by
          have hb0 : 0 ≤ b := (norm_nonneg _).trans hb
          have ha0 : 0 ≤ a := (norm_nonneg _).trans ha
          gcongr
      _ = 2 * b + a := by ring
  calc _ = ‖(Butterfly.Qp P (NLogN.KFM.vP P z * NLogN.KFM.vP P w) - NLogN.KFM.vP P z * NLogN.KFM.vP P w) +
        (NLogN.KFM.vP P z * NLogN.KFM.vP P w - Z * W)‖ := by congr 1; ring
    _ ≤ ‖Butterfly.Qp P (NLogN.KFM.vP P z * NLogN.KFM.vP P w) - NLogN.KFM.vP P z * NLogN.KFM.vP P w‖ + ‖NLogN.KFM.vP P z * NLogN.KFM.vP P w - Z * W‖ :=
        norm_add_le _ _
    _ ≤ Real.sqrt 2 * (2 : ℝ)⁻¹ ^ P + (2 * b + a) := by linarith
    _ ≤ 2 * (2 : ℝ)⁻¹ ^ P + (2 * b + a) := by gcongr
    _ = _ := by ring
end
