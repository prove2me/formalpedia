    (by simp [NLogN.KIL.tB, NLogN.KIL.yB, NLogN.KIL.NE.val, w1 NLogN.KIL.kP (by decide), w1 NLogN.KIL.kG (by decide), w1 NLogN.KIL.kS (by decide),
