theorem cPre1_run (pkA pkC bA bC : ℕ) (v : Vr) (c : Cs) :
    runL (cPre1 pkA pkC bA bC) (v, c) = (update (update (update (update (update v
      26 (pkA * v 20 + pkC)) 28 (bA * v 20 + bC)) 29 (v 23 / v 24)) 5 1) 6 0,
      update c sSt (v 7 :: v 4 :: v 3 :: c sSt)) := by
  simp only [cPre1, runL, Ins.run, E.den, update_self, update_idem]
  simp only [update_apply]; simp

theorem cPre1_ok {W : ℕ} (pkA pkC bA bC : ℕ) (v : Vr) (c : Cs) (hv : BV W v)
    (bl : pkA + pkC + bA + bC + 2 ≤ 2 ^ W) (bpk : |pkA * v 20 + pkC| ≤ 2 ^ W)
    (bb : |bA * v 20 + bC| ≤ 2 ^ W) (bn : |v 23 / v 24| ≤ 2 ^ W) :
    OkL W 0 (cPre1 pkA pkC bA bC) (v, c) := by
  have hW1 : (1 : ℤ) ≤ 2 ^ W := one_le_pow₀ (by norm_num)
  simp only [cPre1, OkL, Ins.ok, Ins.run]
  refine ⟨⟨by decide, by decide, rfl, ?_⟩, ⟨by decide, by decide, rfl, ?_⟩, ⟨by decide, by decide,
    rfl, ?_⟩, ⟨by decide, by simp [E.ok]; decide, ?_, ?_⟩, ⟨by decide, by simp [E.ok]; decide, ?_, ?_⟩,
    ⟨by decide, rfl, ?_, ?_⟩, ⟨by decide, rfl, ?_, ?_⟩, ⟨by decide, rfl, ?_, ?_⟩, trivial⟩
  all_goals first
    | (simp only [E.lb]; omega)
    | (simp only [E.den]; simpa [update_apply] using bpk)
    | (simp only [E.den]; simpa [update_apply] using bb)
    | (simp only [E.den]; simpa [update_apply] using bn)
    | (simp [E.den]; exact_mod_cast hW1)
    | simp [E.den]
    | (simp [E.ok]; decide)

theorem cPre2_run (v : Vr) (c : Cs) :
    runL cPre2 (v, c) = (v, update c sSt (v 5 :: v 6 :: c sSt)) := by
