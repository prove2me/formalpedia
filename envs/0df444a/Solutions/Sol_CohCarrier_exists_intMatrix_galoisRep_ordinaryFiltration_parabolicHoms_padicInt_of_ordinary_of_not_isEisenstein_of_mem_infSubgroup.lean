    πk₁ T p S₁ i₁ χ hi₁ (S₁.toCornerRing i₁ y) = χ y := by
  show χ ((S₁.toCornerRing i₁ y : S₁.CornerRing i₁) : Ap p T) = χ y
  rw [S₁.coe_toCornerRing, map_mul, map_mul, χ_e₁ T p S₁ i₁ χ hi₁, one_mul, mul_one]

