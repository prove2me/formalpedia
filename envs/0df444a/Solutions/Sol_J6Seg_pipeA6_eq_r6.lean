-- Source module: Solutions.J6AIL9
/-!
# A lines, IL side 9: the pipeline is the axis step `pipeA6`

**`pipeA6_eq`**: for an array of length `pre · (t_k · post_k)`, the `k`-th `A` axis step
`pipeA6 P n src D k` equals the list pipeline `J6A.pipeAL` (copies, gather slab pass,
regrouping, kernel pass, compress slab pass) at `p = pP6`, `s = s_k`, `t = t_k`, `α = αN6`,
`H = HA6` (`= J6A.PA.HH (pP6 P n) (αN6 P n)`), under the numeric side conditions of
`J6A.pipeAL_rep`.
-/

set_option linter.unusedVariables false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf

/-- **The `k`-th `A` axis step is the list pipeline.** -/
theorem pipeA6_eq (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k pre : ℕ) {M : ℕ} (hM : 0 < M)
    (ht : (List.ofFn (tD6 P n D)).getD k 1 = M * 8 * (2 * HA6 P n))
    (hp : 0 < ((List.ofFn (tD6 P n D)).drop (k + 1)).prod)
    (hWs : J6A.WA (pP6 P n) (αN6 P n) (HA6 P n) ≤ (List.ofFn (sD6 src D)).getD k 1)
    (hst : (List.ofFn (sD6 src D)).getD k 1 ≤ (List.ofFn (tD6 P n D)).getD k 1)
    (hsep : 2 * J6A.WA (pP6 P n) (αN6 P n) (HA6 P n) * (List.ofFn (tD6 P n D)).getD k 1 ≤
      16 * HA6 P n * (List.ofFn (sD6 src D)).getD k 1)
    (hWw : 2 * J6A.WA (pP6 P n) (αN6 P n) (HA6 P n) ≤ 8 * HA6 P n)
    {L : List GI} (hL : L.length = pre * ((List.ofFn (tD6 P n D)).getD k 1 *
      ((List.ofFn (tD6 P n D)).drop (k + 1)).prod)) :
    pipeA6 P n src D k L =
      J6A.pipeAL (pP6 P n) ((List.ofFn (sD6 src D)).getD k 1) ((List.ofFn (tD6 P n D)).getD k 1)
        (αN6 P n) (HA6 P n) pre ((List.ofFn (tD6 P n D)).drop (k + 1)).prod L := by
  have hH : 1 ≤ HA6 P n := Nat.one_le_two_pow
  rw [J6A.pipeAL_eq _ _ _ _ _ _ _ hH hM ht hp hWs hst hsep hWw hL]
  rfl

/-- `2^h ≥ 512 p` for large `n`. -/
theorem t_big (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → 512 * pP6 P n ≤ 2 ^ hN6 P n := by
  obtain ⟨n₂, hE⟩ := ell_big P hP (P.x + 14)
  refine ⟨n₂, fun n hn => ?_⟩
  have E := hE n hn
  set b := bP6 n with hb
  set m := Nat.log 2 b with hm
  have hb1 : 1 ≤ b := bP6_pos n
  have hbm : b < 2 ^ (m + 1) := Nat.lt_pow_succ_log_self (by norm_num) b
  have hp : pP6 P n ≤ 6 * 2 ^ ((m + 1) * (1 + P.x)) := by
    have e : pP6 P n = 6 * b ^ (1 + P.x) := rfl
    rw [e, pow_mul]
    exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hbm.le _)
  have hsq : (m + 1) ≤ (m + 1) ^ 2 := by nlinarith
  have hl : (m + 1) * (1 + P.x) + 13 ≤ ℓP6 P n := by
    have : (P.x + 14) * (m + 1) ≤ (P.x + 14) * (m + 1) ^ 2 := Nat.mul_le_mul_left _ hsq
    nlinarith
  have hh : (m + 1) * (1 + P.x) + 12 ≤ hN6 P n := by unfold hN6; omega
  calc 512 * pP6 P n ≤ 512 * (6 * 2 ^ ((m + 1) * (1 + P.x))) := Nat.mul_le_mul_left _ hp
    _ ≤ 2 ^ 12 * 2 ^ ((m + 1) * (1 + P.x)) := by
        have : 0 < 2 ^ ((m + 1) * (1 + P.x)) := by positivity
        norm_num; omega
    _ = 2 ^ ((m + 1) * (1 + P.x) + 12) := by ring
    _ ≤ 2 ^ hN6 P n := Nat.pow_le_pow_right (by norm_num) hh

theorem pow2_dvd_tF6' (P : Prm) (n j e : ℕ) (he : 2 ^ e ≤ tF6 P n j) : 2 ^ e ∣ tF6 P n j := by
  unfold tF6 at he ⊢
  split_ifs at he ⊢
  · rw [← pow_succ] at he ⊢
    exact Nat.pow_dvd_pow 2 ((Nat.pow_le_pow_iff_right (by norm_num)).1 he)
  · exact Nat.pow_dvd_pow 2 ((Nat.pow_le_pow_iff_right (by norm_num)).1 he)

theorem getD_ofFn_tD6 (P : Prm) (n D k : ℕ) (hk : k ≤ D) :
    (List.ofFn (tD6 P n D)).getD k 1 = tF6 P n k := by
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_ofFn]; rfl

theorem getD_ofFn_sD6 (src : ℕ → ℕ) (D k : ℕ) (hk : k ≤ D) :
    (List.ofFn (sD6 src D)).getD k 1 = src k := by
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_ofFn]; rfl

set_option maxHeartbeats 1000000 in
/-- **The `A` axis step is the list pipeline** (round-six regime). -/
theorem pipeA6_eq_r6_sol_aux (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D, ∀ L : List GI,
    L.length = (List.ofFn (tD6 P n D)).prod →
    pipeA6 P n src D k L = J6A.pipeAL (pP6 P n) (src k) (tF6 P n k) (αN6 P n) (HA6 P n)
      (preT P n D k) (postT P n D k) L := by
  obtain ⟨n₂, hT⟩ := t_big P hP
  obtain ⟨n₃, hN⟩ := r6_axis_nat P hP
  refine ⟨max n₂ n₃, fun n hn src hsrc D hD k hk L hL => ?_⟩
  have T := hT n (le_trans (le_max_left _ _) hn)
  have hkd : k < dP6 P n := by omega
  obtain ⟨hs0, hst, hα2, -, -, -, hαp, -, hb', hd1⟩ := hN n (le_trans (le_max_right _ _) hn) src hsrc k hkd
  have hlo := hsrc.lo k hkd
  have hw := wnd6_le P n k hd1
  set p := pP6 P n with hpdef
  set α := αN6 P n with hαdef
  set t := tF6 P n k with htdef
  set s := src k with hsdef
  set m := sWidth p α with hmdef
  have hp9 : 9 ≤ p := by have : p = 6 * b'P6 P n := rfl; omega
  have hm6 : 6 ≤ m := by
    have h3 : 3 ≤ Nat.sqrt p := Nat.le_sqrt.2 (by omega)
    rw [hmdef, J6A.PA.sWidth_eq]
    have : 3 ≤ (if Nat.sqrt p * Nat.sqrt p < p then Nat.sqrt p + 1 else Nat.sqrt p) := by
      split_ifs <;> omega
    nlinarith
  have hm2p : m ≤ 2 * p := sWidth_le p α (by omega) hαp
  set H := HA6 P n with hHdef
  have hHe : H = 2 ^ Nat.log 2 m := rfl
  have hHm : H ≤ m := by rw [hHe]; exact Nat.pow_log_le_self 2 (by omega)
  have hmH : m < 2 * H := by
    rw [hHe, ← pow_succ']; exact Nat.lt_pow_succ_log_self (by norm_num) m
  have hH1 : 1 ≤ H := by rw [hHe]; exact Nat.one_le_two_pow
  have hWA : J6A.WA p α H = H + m + 3 := rfl
  have hWw : 2 * J6A.WA p α H ≤ 8 * H := by rw [hWA]; omega
  have ht2 : 2 ^ hN6 P n ≤ t := by rw [htdef, tF6_eq]; split_ifs <;> omega
  have h16 : 16 * H ≤ t := by omega
  have hdvd : 16 * H ∣ t := by
    have : 16 * H = 2 ^ (Nat.log 2 m + 4) := by rw [hHe, pow_add]; ring
    rw [this]; rw [this] at h16; exact pow2_dvd_tF6' P n k _ h16
  obtain ⟨M, hMe⟩ := hdvd
  have hM : 0 < M := by
    rcases Nat.eq_zero_or_pos M with h | h
    · rw [h] at hMe; omega
    · exact h
  have ht : t = M * 8 * (2 * H) := by rw [hMe]; ring
  have h4s : 3 * t ≤ 4 * s := by omega
  have hWs : J6A.WA p α H ≤ s := by rw [hWA]; omega
  have hsep : 2 * J6A.WA p α H * t ≤ 16 * H * s := by
    have h1 : 2 * J6A.WA p α H * t ≤ 8 * H * t := Nat.mul_le_mul_right _ hWw
    have h2 : 8 * H * t ≤ 16 * H * s := by
      have : t ≤ 2 * s := by omega
      calc 8 * H * t ≤ 8 * H * (2 * s) := Nat.mul_le_mul_left _ this
        _ = 16 * H * s := by ring
    omega
  have hprod := pre_t_post P n D k hk
  have hpos : 0 < (List.ofFn (tD6 P n D)).prod := by rw [total_eq]; positivity
  have hpost : 0 < postT P n D k := by
    rw [← hprod] at hpos; exact Nat.pos_of_mul_pos_left hpos
  have hgt := getD_ofFn_tD6 P n D k hk
  have hgs := getD_ofFn_sD6 src D k hk
  have e := pipeA6_eq P n src D k (preT P n D k) hM (by rw [hgt]; exact ht) hpost
    (by rw [hgs]; exact hWs) (by rw [hgs, hgt]; exact hst.le) (by rw [hgs, hgt]; exact hsep) hWw
    (L := L) (by rw [hgt, hL, ← hprod]; unfold postT; ring)
  rw [e, hgt, hgs]; rfl

end J6Seg
end

