open Real Set Metric
open RealInnerProductSpace

open QFS

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

theorem QFS.mem_cone_iff_coneGap_pos {v : E} (hv : ‖v‖ = 1) {ϑ : ℝ} (hϑ : 0 < ϑ)
    (hϑ' : ϑ ≤ π / 2) (p : E) : p ∈ cone v ϑ ↔ 0 < coneGap v ϑ p := by sorry
