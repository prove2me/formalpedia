-- Source module: Solutions.J6AILTab12
/-!
# A lines, table set-up, part 12: the entries of the `A` tables are `O(p)` bits

With `P = 2p`: `|aTabA|, |rTabA| ≤ 2^Q (8p + 35) 2^{2p}` and `|cTabA| ≤ (8p + 35) 2^{2p}`
(**`aTabA_bnd`, `rTabA_bnd`, `cTabA_bnd`**), from the unconditional `expNeg`/`expPos` bounds.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.ATab

open IntMul NLogN IntMul.HvdH

theorem aFA_bnd (p s t α H q i : ℕ) : |J6A.aFA p s t α H q i| ≤ (8 * p + 35) * 2 ^ (2 * p) := by
  unfold J6A.aFA J6A.aT
  calc _ ≤ (4 * (2 * p) + 35 : ℤ) * 2 ^ (2 * p) := by exact_mod_cast expNeg_absW _ _ _
    _ = _ := by ring

theorem rFA_bnd (p s t α H q e : ℕ) : |J6A.rFA p s t α H q e| ≤ (8 * p + 35) * 2 ^ (2 * p) := by
  unfold J6A.rFA
  calc _ ≤ (4 * (2 * p) + 35 : ℤ) * 2 ^ (2 * p) := by exact_mod_cast expNeg_absW _ _ _
    _ = _ := by ring

/-- **The input scaling table.** -/
theorem aTabA_bnd (p s t α H q : ℕ) :
    ∀ x ∈ J6A.aTabA p s t α H q, |x| ≤ 2 ^ J6A.QA p * ((8 * p + 35) * 2 ^ (2 * p)) := by
  intro x hx
  simp only [J6A.aTabA, List.mem_map, List.mem_range] at hx
  obtain ⟨i, -, rfl⟩ := hx
  rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℤ) ≤ 2 ^ J6A.QA p)]
  exact mul_le_mul_of_nonneg_left (aFA_bnd p s t α H q i) (by positivity)

/-- **The correlation table.** -/
theorem rTabA_bnd (p s t α H q : ℕ) :
    ∀ x ∈ J6A.rTabA p s t α H q, |x| ≤ 2 ^ J6A.QA p * ((8 * p + 35) * 2 ^ (2 * p)) := by
  intro x hx
  simp only [J6A.rTabA, List.mem_map, List.mem_range] at hx
  obtain ⟨e, -, rfl⟩ := hx
  rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℤ) ≤ 2 ^ J6A.QA p)]
  exact mul_le_mul_of_nonneg_left (rFA_bnd p s t α H q e) (by positivity)

theorem cT_bnd (P σ s t α H k : ℕ) : |J6A.cT P σ s t α H k| ≤ (4 * P + 35) * 2 ^ P := by
  unfold J6A.cT
  have h1 : (expPos P (t ^ 2 * α ^ 2) (J6A.cNum s t H k) σ).natAbs ≤ (4 * P + 35) * 2 ^ P := by
    have := expPos_absW P (t ^ 2 * α ^ 2) (J6A.cNum s t H k) σ
    rw [Int.abs_eq_natAbs] at this; exact_mod_cast this
  have h2 : (betaT P α).natAbs ≤ 2 ^ P := by
    unfold betaT; rw [Int.natAbs_natCast]; exact Nat.div_le_self _ _
  have h3 : (2 ^ P : ℤ).natAbs = 2 ^ P := by
    rw [Int.natAbs_pow]; rfl
  have h4 : ((expPos P (t ^ 2 * α ^ 2) (J6A.cNum s t H k) σ).natAbs *
      (betaT P α).natAbs).div (2 ^ P) ≤ (4 * P + 35) * 2 ^ P :=
    Nat.div_le_of_le_mul (by
      calc _ ≤ (4 * P + 35) * 2 ^ P * 2 ^ P := Nat.mul_le_mul h1 h2
        _ = _ := by ring)
  rw [Int.abs_eq_natAbs, Int.natAbs_tdiv, h3, Int.natAbs_mul]
  exact_mod_cast h4

/-- **The output scaling table.** -/
theorem cTabA_bnd (p s t α H q : ℕ) :
    ∀ x ∈ J6A.cTabA p s t α H q, |x| ≤ (8 * p + 35) * 2 ^ (2 * p) := by
  intro x hx
  simp only [J6A.cTabA, List.mem_map, List.mem_range] at hx
  obtain ⟨κ, -, rfl⟩ := hx
  calc _ ≤ (4 * (2 * p) + 35 : ℤ) * 2 ^ (2 * p) := by exact_mod_cast cT_bnd _ _ _ _ _ _ _
    _ = _ := by ring

end J6Seg.ATab

end

