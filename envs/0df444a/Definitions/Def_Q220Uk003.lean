noncomputable def rowLoss {k : ℕ} (q : Fin k → ℝ)
    (j₀ : Fin k) (B : ℕ) : ℝ :=
  ∑ i ∈ Finset.univ.erase j₀, (q i - (⌊(B : ℝ) * q i⌋₊ : ℝ) / B)


