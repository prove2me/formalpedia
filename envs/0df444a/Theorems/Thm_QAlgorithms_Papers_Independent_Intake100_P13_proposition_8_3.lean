-- title:
--   Proposition 8.3
-- statement:
--   Let $A,B$ be complex C*-algebras, allowing nonunital and zero algebras. Write $M(A),M(B)$ for their double-centralizer multiplier algebras and $j_A:A\to M(A)$ for the canonical inclusion. Let $\alpha:A\to M(B)$ be a complex-linear star homomorphism such that the complex span of $\alpha(A)B$ is norm dense in $B$. There is a unique complex-linear star homomorphism $\widetilde\alpha:M(A)\to M(B)$ extending $\alpha$, and it is strictly continuous. It satisfies
--   $$
--   \widetilde\alpha(j_A(a))=\alpha(a),\qquad
--   \widetilde\alpha(m)\alpha(a)b=\alpha(ma)b
--   \quad(m\in M(A),\ a\in A,\ b\in B).
--   $$
--   The strict topology is generated by all seminorms $m\mapsto\|ma\|+\|am\|$. Uniqueness ranges over every extending star homomorphism, without presupposing its strict continuity.
--
--   The extension transports a nondegenerate multiplier action to all multipliers.
-- source:
--   A complex semigroup approach to group algebras of infinite dimensional Lie groups, arXiv:0709.1062v1, PDF p. 38, Proposition 8.3

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P13

namespace QAlgorithms.Papers.Independent.Intake100.P13

open Set Filter Topology

noncomputable section

universe u v w

section Multipliers

variable (A : Type u) [NonUnitalCStarAlgebra A]

variable {A}

/-- Proposition 8.3, PDF p. 38: unique extension among all complex-linear
star homomorphisms, with strict continuity on the whole multiplier algebra.
The displayed action identity pins the extension canonically. -/
theorem proposition_8_3
    {B : Type v} [NonUnitalCStarAlgebra B]
    (alpha : A →⋆ₙₐ[ℂ] DoubleCentralizer ℂ B)
    (hDense : Dense (Submodule.span ℂ
      {y : B | ∃ a : A, ∃ b : B, (alpha a).fst b = y} : Set B)) :
    ∃ extension : DoubleCentralizer ℂ A →⋆ₙₐ[ℂ] DoubleCentralizer ℂ B,
      (∀ a : A, extension (DoubleCentralizer.coeHom (𝕜 := ℂ) (A := A) a) = alpha a) ∧
      (@Continuous (DoubleCentralizer ℂ A) (DoubleCentralizer ℂ B)
        (strictTopology A) (strictTopology B) extension) ∧
      (∀ (m : DoubleCentralizer ℂ A) (a : A) (b : B),
        (extension m).fst ((alpha a).fst b) = (alpha (m.fst a)).fst b) ∧
      (∀ other : DoubleCentralizer ℂ A →⋆ₙₐ[ℂ] DoubleCentralizer ℂ B,
        (∀ a : A, other (DoubleCentralizer.coeHom (𝕜 := ℂ) (A := A) a) = alpha a) →
          other = extension) := by sorry

end Multipliers

end

end QAlgorithms.Papers.Independent.Intake100.P13
