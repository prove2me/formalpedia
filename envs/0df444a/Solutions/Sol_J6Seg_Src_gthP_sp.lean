theorem gthP_sp_sol_aux (s0 : IState HS) (F : Fin HS → List ℤ) {iN : Fin HS} (fN : Free iN)
    (L : List ℕ) {n' A : ℕ} {L30 L31 LN : List ℤ}
    (h30 : F 30 = zLs L ++ L30) (h31 : F 31 = (L.length : ℤ) :: L31)
    (hGN : F iN = (n' : ℤ) :: LN) (hLn : L.length ≤ n') (hLA : ∀ x ∈ L, x ≤ 2 ^ A)
    (hnA : n' ≤ 2 ^ A) (hA : 2 ≤ A) :
    Sp (gthP iN) (encK s0 F) (encK s0 (update F 44 (srcTab (gSrc L) (fun _ => 0) n' ++ F 44)))
      ((L.length + n' + 2) * (40 * uC A DD)) := by
  rw [enc_base s0 F, enc_base44]
  generalize b43 s0 F = s1
  have hlA : L.length ≤ 2 ^ A := le_trans hLn hnA
  -- the move
  have hB : Bnd (A * DD + 1) (zLs L) := by
    intro x hx
    obtain ⟨y, hy, hyx⟩ := List.mem_map.1 hx
    subst hyx
    exact zsz_le_AD (abs_nat_le (hLA y hy)) (by decide)
  have q31 : bS F (F 13) (F 14) (F 15) (F 30) (F 31) (F 32) (F 33) [] (F 44) 31 =
      (L.length : ℤ) :: L31 := by rw [bS_31, h31]
  have hM := Sp.mvK (X := 30) (Y := 15) (C := 43) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s1 (bS F (F 13) (F 14) (F 15) (F 30) (F 31) (F 32) (F 33) [] (F 44))
    (.reg 31) (clean_reg (by decide)) (isInt_encK q31) (zLs L) L30 (by rw [bS_30, h30])
    (by rw [Ex.eval, topv q31]; simp) (A * DD + 1) hB trivial
    (by show zsz _ ≤ _; rw [topv q31]; exact zsz_le_AD (abs_nat_le hlA) (by decide))
  (simp only [J6Seg.Src.bS_13, J6Seg.Src.bS_14, J6Seg.Src.bS_15, J6Seg.Src.bS_30, J6Seg.Src.bS_31, J6Seg.Src.bS_32, J6Seg.Src.bS_33, J6Seg.Src.bS_43, J6Seg.Src.bS_44, J6Seg.Src.bS_upd_13, J6Seg.Src.bS_upd_14, J6Seg.Src.bS_upd_15, J6Seg.Src.bS_upd_30, J6Seg.Src.bS_upd_31, J6Seg.Src.bS_upd_32, J6Seg.Src.bS_upd_33, J6Seg.Src.bS_upd_43, J6Seg.Src.bS_upd_44] at hM)
  -- the loop
  have hS : ∀ j, g3S F L30 L n' j 43 = [] := fun j => by simp [g3S]
  have hNS : g3S F L30 L n' n' iN = (n' : ℤ) :: LN := by
    rw [g3S, bS_free _ _ _ _ _ _ _ _ _ _ fN, hGN]
  have HL := loopDown s1 (g3S F L30 L n') fN.1 hS hNS hnA (b := g3B) (by simp [g3B, RS.writes])
    (fun j hj => (g3_step s1 F L30 L h31 hLA hlA hA hj (by omega)))
  have e0 : g3S F L30 L n' n' = bS F (F 13) (F 14) ((zLs L).reverse ++ F 15) L30 (F 31) (F 32) (F 33) []
      (F 44) := by
    rw [g3S, min_eq_right hLn, List.take_length, List.drop_length, tlT_end]
    simp only [zLs, List.map_nil, List.nil_append]
  have e1 : g3S F L30 L n' 0 = bS F (F 13) (F 14) (F 15) (F 30) (F 31) (F 32) (F 33) []
      (srcTab (gSrc L) (fun _ => 0) n' ++ F 44) := by
    rw [g3S, tlT_zero, h30]
    simp only [Nat.zero_min, List.take_zero, List.drop_zero, zLs, List.map_nil, List.reverse_nil,
      List.nil_append]
