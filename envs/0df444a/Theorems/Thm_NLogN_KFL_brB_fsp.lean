theorem NLogN.KFL.brB_fsp {B Bb : ℕ} (hB1 : 1 ≤ Bb) (s : IState HS) (G : Fin HS → List ℤ) (L l : List ℤ)
    (h0 : G 0 = L ++ l) (hL : L.length = B) (hLb : NLogN.Bnd 1 L) (zB : zsz (B : ℤ) ≤ Bb)
    {k kv nb : ℕ} {lk lm ln : List ℤ} (hK : G rK = (kv : ℤ) :: lk) (zk : zsz (kv : ℤ) ≤ Bb)
    (hm : G rm = (k : ℤ) :: lm) (zm : zsz (k : ℤ) ≤ Bb)
    (hN : G rNB = (nb : ℤ) :: ln) (zn : zsz (nb : ℤ) ≤ Bb) (zn1 : zsz ((nb : ℤ) + 1) ≤ Bb)
    (zd : zsz ((kv : ℤ) - k) ≤ Bb) :
    FSp (NLogN.KFL.brB B) (encK s G) (encK s (Function.update (Function.update (Function.update
      (Function.update (Function.update (Function.update G 0 l)
      NLogN.KFL.sT ((if decide (kv ≠ k) then [] else L.reverse) ++ G NLogN.KFL.sT))
      sKB ((if decide (kv ≠ k) then L.reverse else []) ++ G sKB))
      sKK ((if decide (kv ≠ k) then [(kv : ℤ)] else []) ++ G sKK))
      sFL ((if kv ≠ k then 1 else 0) :: G sFL))
      rNB (((nb + if kv ≠ k then 1 else 0 : ℕ) : ℤ) :: ln))) (2 * NLogN.KFL.cIte Bb + NLogN.KFL.cBr B Bb) := by sorry
