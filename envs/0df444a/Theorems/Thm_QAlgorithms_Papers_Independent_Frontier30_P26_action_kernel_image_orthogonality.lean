-- title:
--   Lemma 3.1: Kernel-image orthogonality for the l-action
-- statement:
--   All vector spaces and Lie algebras are finite dimensional and real, with their usual Hausdorff topology. An invariant set is invariant under the group generated by $e^{\operatorname{ad}y}$. A closed convex set is pointed when its recession edge is zero. Write $\mathcal O_x=\operatorname{Inn}(\mathfrak g)x$, $\operatorname{co}(x)=\overline{\operatorname{conv}}\mathcal O_x$, and $C_x=\operatorname{cone}(\mathcal O_x)$. Admissibility means existence of a pointed generating invariant closed convex subset.
--
--   In an admissible structural presentation, let $x\in\mathfrak l$, $V_{x,0}=\ker(\operatorname{ad}(x)|_V)$, and $V_x=[x,V]$. If $f\in\mathfrak z^*$ makes $\omega=f\circ\beta$ symplectic, then
--
--   $$V_x^{\perp_\omega}=V_{x,0},\qquad V_{x,0}^{\perp_\omega}=V_x,\qquad V_x^{\perp_\beta}=V_{x,0},\qquad V_{x,0}^{\perp_\beta}=V_x.$$
--
--   All complements are taken inside $V$; beta-orthogonality means $[v,w]=0$ for every $w$ in the indicated subspace. These equalities identify the obstruction to orbit reduction.
-- source:
--   Elements in pointed invariant cones in Lie algebras and corresponding affine pairs, arXiv:2110.07297v1, PDF p. 7, Lemma 3.1: Kernel-image orthogonality for the l-action

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier30_P26

namespace QAlgorithms.Papers.Independent.Frontier30.P26

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Dependency50.P12.Coordinates (expAd)

attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section Presentations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Lemma 3.1, PDF p. 7. Both scalar and both beta orthogonal-complement identities. -/
theorem action_kernel_image_orthogonality (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) (x : P.L) :
    (∀ f : (LieAlgebra.center ℝ G) →ₗ[ℝ] ℝ, ScalarSymplectic P f →
      scalarPerp P f (movingSpace P x) = (fixedSpace P x : Set G) ∧
      scalarPerp P f (fixedSpace P x) = (movingSpace P x : Set G)) ∧
    betaPerp P (movingSpace P x) = (fixedSpace P x : Set G) ∧
    betaPerp P (fixedSpace P x) = (movingSpace P x : Set G) := by sorry

end Presentations

end

end QAlgorithms.Papers.Independent.Frontier30.P26
