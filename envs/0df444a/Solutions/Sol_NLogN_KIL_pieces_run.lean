theorem runPieces_append (step : ℕ → β → List α → List α) (w : β → ℕ) :
    ∀ (l1 l2 : List β) (o : ℕ) (xs : List α),
      runPieces step w o (l1 ++ l2) xs =
        runPieces step w (o + (l1.map w).sum) l2 (runPieces step w o l1 xs)
  | [], l2, o, xs => by simp [runPieces]
  | t :: l1, l2, o, xs => by
    simp only [List.cons_append, runPieces, List.map_cons, List.sum_cons]
    rw [runPieces_append step w l1 l2 (o + w t)]
    congr 1; ring

theorem runPieces_replicate (step : ℕ → β → List α → List α) (w : β → ℕ) (t : β) :
    ∀ (c o : ℕ) (xs : List α),
      runPieces step w o (List.replicate (c + 1) t) xs =
        step (o + c * w t) t (runPieces step w o (List.replicate c t) xs)
  | 0, o, xs => by simp [runPieces]
  | c + 1, o, xs => by
    rw [List.replicate_succ, runPieces, runPieces_replicate step w t c (o + w t), List.replicate_succ,
      runPieces]
    congr 1; ring

/-- Base-`m` digits as quotients and remainders. -/
theorem digit_eq {m : ℕ} (hm : 2 ≤ m) : ∀ (n j : ℕ), AModel.digit m n j = n / m ^ j % m := by
  intro n j
  induction j generalizing n with
  | zero =>
    unfold AModel.digit
    rcases Nat.eq_zero_or_pos n with h | h
    · subst h; simp
    · rw [Nat.digits_def' (by omega) h]; simp
  | succ j ih =>
    unfold AModel.digit at ih ⊢
    rcases Nat.eq_zero_or_pos n with h | h
    · subst h; simp
    · rw [Nat.digits_def' (by omega) h, List.getD_cons_succ, ih, pow_succ', Nat.div_div_eq_div_mul]

