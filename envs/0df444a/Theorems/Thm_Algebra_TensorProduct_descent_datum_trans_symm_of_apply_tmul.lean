-- title:
--   Transition isomorphism of two base changes is a graded descent datum
-- statement:
--   Let $S$ be a commutative ring, $S'$ a commutative $S$-algebra, $A'$ a commutative ring which is both an $S$- and an $S'$-algebra compatibly, and $\mathcal{A}' : \mathbb{N} \to$ (submodules of $A'$ over $S'$) an arbitrary family of $S'$-submodules of $A'$; let $A''$ be a commutative ring which is an algebra over $S' \otimes_S S'$ and over $S$ compatibly, with an arbitrary family $\mathcal{A}'' : \mathbb{N} \to$ (submodules of $A''$ over $S' \otimes_S S'$). Let $\vartheta_1, \vartheta_2 : A' \to A''$ be $S$-algebra maps that are semilinear over the two coface maps, i.e. $\vartheta_1(s \cdot a) = (s \otimes 1)\vartheta_1(a)$ and $\vartheta_2(s \cdot a) = (1 \otimes s)\vartheta_2(a)$ for $s \in S'$, $a \in A'$ (the tensors being read in $A''$ through the structure map), with $\vartheta_1(\mathcal{A}'_n) \subseteq \mathcal{A}''_n$ and $\mathcal{A}''_n$ contained in the $(S' \otimes_S S')$-span of $\vartheta_2(\mathcal{A}'_n)$ for every $n$. Let $\beta_1 : A' \otimes_S S' \cong A''$ and $\beta_2 : S' \otimes_S A' \cong A''$ be $S$-algebra isomorphisms with $\beta_1(a \otimes t) = \vartheta_1(a)\,(1 \otimes t)$ and $\beta_2(s \otimes a) = (s \otimes 1)\,\vartheta_2(a)$. Put $\varphi := \beta_2^{-1} \circ \beta_1 : A' \otimes_S S' \cong S' \otimes_S A'$. Then three things hold: first, the map $S' \otimes_S S' \to A' \otimes_S S'$ induced by the structure map $S' \to A'$ on the left factor, followed by $\varphi$, equals the map $S' \otimes_S S' \to S' \otimes_S A'$ induced by that structure map on the right factor; second, for all $n$, all $a \in \mathcal{A}'_n$ and all $t \in S'$, the element $\varphi(a \otimes t)$ lies in the base change to $S'$ of $\mathcal{A}'_n$ viewed as an $S$-submodule, i.e. in the $S'$-submodule of $S' \otimes_S A'$ generated by $1 \otimes \mathcal{A}'_n$; third, for $a \in A'$, the element $a$ lies in the equaliser of $a \mapsto \varphi(a \otimes 1)$ and $a \mapsto 1 \otimes a$ if and only if $\vartheta_1(a) = \vartheta_2(a)$. No grading axioms on the families $\mathcal{A}'$, $\mathcal{A}''$ are assumed.
--
--   This is the algebraic core of the comparison between a descent datum for a graded algebra along $S \to S'$ and a pair of semilinear maps to a common $(S' \otimes_S S')$-algebra: it produces the transition isomorphism $\varphi$ together with its compatibility with the two structure maps from $S' \otimes_S S'$, its degreewise behaviour, and the identification of its invariants with the equaliser of $\vartheta_1$ and $\vartheta_2$. It is used in the faithfully flat descent step [`AlgebraicGeometry.exists_descent_of_faithfullyFlat_of_cocycle`](thm.html#AlgebraicGeometry.exists_descent_of_faithfullyFlat_of_cocycle), where the three conclusions supply exactly the linearity, degree and equaliser hypotheses required there.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_Algebra_TensorProduct_descent_datum_trans_symm_of_apply_tmul.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open TensorProduct Algebra.TensorProduct

theorem Algebra.TensorProduct.descent_datum_trans_symm_of_apply_tmul
    {S : Type u} [CommRing S] (S' : Type u) [CommRing S'] [Algebra S S']
    (A' : Type u) [CommRing A'] [Algebra S A'] [Algebra S' A'] [IsScalarTower S S' A']
    (𝒜' : ℕ → Submodule S' A')
    (A'' : Type u) [CommRing A''] [Algebra (S' ⊗[S] S') A''] [Algebra S A''] [IsScalarTower S (S' ⊗[S] S') A'']
    (𝒜'' : ℕ → Submodule (S' ⊗[S] S') A'')
    (ϑ₁ ϑ₂ : A' →ₐ[S] A'')
    (hϑ₁lin : ∀ (s : S') (a : A'), ϑ₁ (s • a) = algebraMap (S' ⊗[S] S') A'' (s ⊗ₜ 1) * ϑ₁ a)
    (hϑ₂lin : ∀ (s : S') (a : A'), ϑ₂ (s • a) = algebraMap (S' ⊗[S] S') A'' (1 ⊗ₜ s) * ϑ₂ a)
    (hϑ₁deg : ∀ n, ∀ a ∈ 𝒜' n, ϑ₁ a ∈ 𝒜'' n)
    (hspan₂ : ∀ n, 𝒜'' n ≤ Submodule.span (S' ⊗[S] S') (ϑ₂ '' (𝒜' n : Set A')))
    (β₁ : A' ⊗[S] S' ≃ₐ[S] A'')
    (hβ₁ : ∀ (a : A') (t : S'), β₁ (a ⊗ₜ t) = ϑ₁ a * algebraMap (S' ⊗[S] S') A'' (1 ⊗ₜ t))
    (β₂ : S' ⊗[S] A' ≃ₐ[S] A'')
    (hβ₂ : ∀ (s : S') (a : A'), β₂ (s ⊗ₜ a) = algebraMap (S' ⊗[S] S') A'' (s ⊗ₜ 1) * ϑ₂ a) :
    let φ : A' ⊗[S] S' ≃ₐ[S] S' ⊗[S] A' := β₁.trans β₂.symm
    φ.toAlgHom.comp (Algebra.TensorProduct.map (IsScalarTower.toAlgHom S S' A') (AlgHom.id S S')) =
        Algebra.TensorProduct.map (AlgHom.id S S') (IsScalarTower.toAlgHom S S' A') ∧
      (∀ (n : ℕ) (a : A'), a ∈ 𝒜' n → ∀ t : S', φ (a ⊗ₜ t) ∈ ((𝒜' n).restrictScalars S).baseChange S') ∧
      (∀ a : A',
        a ∈ AlgHom.equalizer (φ.toAlgHom.comp (Algebra.TensorProduct.includeLeft : A' →ₐ[S] A' ⊗[S] S'))
              (Algebra.TensorProduct.includeRight : A' →ₐ[S] S' ⊗[S] A') ↔
          ϑ₁ a = ϑ₂ a) := by sorry
