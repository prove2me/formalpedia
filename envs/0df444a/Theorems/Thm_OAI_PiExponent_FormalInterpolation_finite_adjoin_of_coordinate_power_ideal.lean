-- title:
--   Coordinate powers make the common top algebra finite
-- statement:
--   Positive coordinate weights and coordinate-power containment in the ideal generated by the common-weight components imply that the polynomial ring is finite over the algebra generated by those components. Prove this by showing the quotient by the homogeneous ideal has only finitely many surviving monomials, then use graded induction.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.finite_adjoin_of_coordinate_power_ideal
    {d k : Nat} (w : Fin d → Rat) (hw : ∀ i, 0 < (w i : Real))
    (D : Real) (hD : 0 < D) (f : Fin k → MvPolynomial (Fin d) Complex)
    (htop : ∀ i : Fin d, ∃ e : Nat, 0 < e ∧
      MvPolynomial.X i ^ e ∈
        Ideal.span (Set.range fun j : Fin k =>
          MvPolynomial.weightedHomogeneousComponent
            (fun i => (w i : Real)) D (f j))) :
    Module.Finite
      (Algebra.adjoin Complex
        (Set.range fun j : Fin k =>
          MvPolynomial.weightedHomogeneousComponent
            (fun i => (w i : Real)) D (f j)))
      (MvPolynomial (Fin d) Complex) := by sorry
