private theorem compAt_gaussTrans_of_not_mem {𝔣 : Ideal (𝓞 K)} (u : GaussTwist.GaussIndex K 𝔣)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ GaussTwist.modulusPrimes K 𝔣) :
    compAt v (GaussTwist.gaussTrans K 𝔣 u) = 1 := by
  refine Units.ext ?_
  show componentMatrix v (GaussTwist.gaussTrans K 𝔣 u) = _
  rw [Units.val_one,
    show componentMatrix v (GaussTwist.gaussTrans K 𝔣 u)
        = !![1, adeleOn (GaussTwist.modulusPrimes K 𝔣) (GaussTwist.gaussY K 𝔣 u) v; 0, 1] from
      componentMatrix_finLift_unipotentGL2 _ v,
    adeleOn_apply_of_not_mem' _ _ hv, ← Matrix.one_fin_two]

