theorem valid_permutation {m : ℕ} [NeZero m] (a : (ZMod m × ZMod m) → GridState)
    (ha : Valid a) :
    ∃ σ : Equiv.Perm (Fin m),∀ i j,
      (a (((i.val : ℕ) : ZMod m),((j.val : ℕ) : ZMod m))).1.1.val =
        if σ i = j then 1 else 0 := by
