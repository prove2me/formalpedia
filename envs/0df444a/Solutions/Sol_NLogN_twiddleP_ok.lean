  (octExpP_top s h48 h48' h49 h49' h50 h50').2.1

theorem aE_eval (s : IState HS) : NLogN.aE.eval s =
    ((if s.top 12 < 1 then (s.top 11).toNat else (s.top 29 - s.top 11).toNat : ℕ) : ℤ) := by
  simp only [NLogN.aE, Ex.eval, Ex.max0_eval]; split_ifs <;> omega

theorem sel_ok {s : IState HS} {c a b : Ex HS} (hc : c.ok s) (ha : a.ok s) (hb : b.ok s) :
    (Ex.sel c a b).ok s := by
  simp only [Ex.ok]; exact ⟨hc, by split_ifs <;> assumption⟩

theorem top_push (i : Fin HS) (e : Ex HS) (s : IState HS) : ((push i e).run s).top i = e.eval s := by
  simp [IState.top, RS.run_push_G]

end NLogN

end

section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS IntMul.HvdH
set_option maxHeartbeats 2000000
theorem solution (n k j : ℕ) (s : NLogN.IState NLogN.HS) (L28 L29 L53 : List NLogN.Item)
    (h28 : s.G 28 = .int n :: L28) (h29 : s.G 29 = .int k :: L29)
    (h53 : s.G 53 = .int j :: L53) : NLogN.twiddleP.ok s := by
  simp (config := {decide := true}) only [NLogN.twiddleP, NLogN.twA, NLogN.twB, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.RS.ok]
  rw [NLogN.octExpP_run' _ (by simp (config := {decide := true}) [NLogN.IState.IsInt, NLogN.IState.top, h28])
    (by simp (config := {decide := true}) [NLogN.IState.top, NLogN.Ex.eval, h28])
    (by simp (config := {decide := true}) [NLogN.IState.IsInt, NLogN.IState.top, h29])
    (by simp (config := {decide := true}) [NLogN.IState.top, NLogN.Ex.eval, h29])
    (by simp (config := {decide := true}) [NLogN.IState.IsInt, NLogN.IState.top])
    (by rw [NLogN.top_push, NLogN.aE_eval]; positivity)]
  repeat' (first
    | apply NLogN.octExpP_ok'
    | apply NLogN.Ex.ediv_ok
    | apply NLogN.Ex.emod_ok
    | apply NLogN.Ex.max0_ok
    | apply NLogN.sel_ok
    | apply And.intro)
  all_goals try simp (config := {decide := true}) [NLogN.RS.run_push_G, NLogN.RS.run_pop_G, NLogN.IState.upd_G,
    NLogN.Ex.eval, NLogN.IState.top, NLogN.IState.IsInt, h28, h29, h53, NLogN.Ex.ok, NLogN.Ex.Clean, NLogN.Ex.regs, NLogN.zX_all, NLogN.qE, NLogN.rE,
    NLogN.cE, NLogN.tE, NLogN.jkE, NLogN.aE, NLogN.yE, NLogN.reE, NLogN.imE, NLogN.top_push, NLogN.aE_eval]
  all_goals first
    | positivity
    | (split_ifs <;> simp)
end
