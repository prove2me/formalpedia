open Set StableVotingDistortion StableVotingDistortion.PaperCurve StableVotingDistortion.PaperMiddle
  StableVotingDistortion.PaperBox StableVotingDistortion.PaperBox.Bounds

theorem solution {b c : Bounds} (hb : (let select (val : PaperCurve.Piece → ℚ → ℚ) (last : ℚ) (q : ℚ) := PaperCurve.pieces.foldr (fun (row : PaperCurve.Piece) rest => if q≤row.hi then val row q else rest) last
    let vq (q : ℚ) := if q∈Icc 0 1 then PaperCurve.quickScore q else select PaperCurve.Piece.qvalue PaperCurve.endKnot.y q
    let jq (q : ℚ) := if q∈Icc 0 1 then PaperCurve.quickJ q else select PaperCurve.Piece.qprimitive PaperCurve.endKnot.j q
    let meet01 (i : Bounds) : Bounds := ⟨max i.lo 0,min i.hi 1⟩
    let v (i : Bounds) := PaperBox.decreasingRange (fun z => point (vq z)) (meet01 i)
    let j (i : Bounds) := PaperBox.unimodalRange (fun z => point (jq z)) PaperCurve.lamQ (meet01 i)
    let x := ((point 1).minus b).plus c
    let e : ℚ := 1+1/20000
    let s := (((point e).times ((j x).minus (j c))).minus (((point e).times b).times (v x))).minus (((point PaperCurve.lamQ).minus c).times (v b))
    let t := (((point e).times b).times ((v x).minus (v c))).plus (j b)
    let d := PaperCurve.anchor b s
    let z := PaperCurve.anchor c t
    decide (((16/25:ℚ)≤b.lo ∧ b.hi≤(99/100:ℚ) ∧ 0≤c.lo ∧ c.hi≤PaperCurve.lamQ) ∧
      e*d*(jq (1-d+z)-jq z)-(PaperCurve.lamQ-z)*jq d+PaperCurve.deviation b s+PaperCurve.deviation c t≤0))=true) {p q : ℝ}
    (hp : (b.lo:ℝ)≤p ∧ p≤b.hi) (hq : (c.lo:ℝ)≤q ∧ q≤c.hi) : q+PaperMiddle.canonical PaperCurve.score p*deltaP PaperCurve.score p q ≤ PaperCurve.lam := by
  have hfold (fn : Piece → ℚ → ℚ) (ending x : ℚ) (l : List Piece) :
      l.foldr (fun (k : Piece) rest => if x≤k.hi then fn k x else rest) ending=qselect fn ending l x := by
    induction l with
    | nil => rfl
    | cons r l ih => simp only [List.foldr_cons,qselect,ih]
  simp only [hfold] at hb
  have h : canonicalQuickTest ![b,c]=true := hb
  rw [canonicalQuickTest_eq] at h
  change boxAccept b c=true at h
  have dom : validRectangle b c := (of_decide_eq_true h).1
  have da := (Rat.cast_le (K:=ℝ)).mpr dom.1
  have db := (Rat.cast_le (K:=ℝ)).mpr dom.2.1
  push_cast at da db
  have hm : p∈Icc (16/25:ℝ) (99/100) := ⟨da.trans hp.1,hp.2.trans db⟩
  have hr : q∈Icc (0:ℝ) PaperCurve.lam := ⟨(by exact_mod_cast dom.2.2.1 : (0:ℝ)≤c.lo).trans hq.1,
    hq.2.trans ((Rat.cast_le (K:=ℝ)).mpr dom.2.2.2)⟩
  exact base_canonical hm hr (boxAccept_sound h hp hq)
