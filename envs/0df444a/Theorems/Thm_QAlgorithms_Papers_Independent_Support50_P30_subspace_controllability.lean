-- title:
--   Lemma 3 (Subspace controllability)
-- statement:
--   Let $n\ge2$, let $\mathfrak g$ be the real Lie algebra generated by $-i$ times the three Hermitian generators in Eq. (9), and fix a Schur decomposition independently of circuit parameters. For each sector $\lambda$, projection to its common block satisfies
--
--   $$\mathfrak g_\lambda=\mathfrak{su}(d_\lambda)\quad\text{or}\quad\mathfrak g_\lambda=\mathfrak u(d_\lambda).$$
--
--   Here $\mathfrak u(d)$ consists of skew-Hermitian matrices and $\mathfrak{su}(d)$ additionally imposes trace zero. The trivial sector permits $\mathfrak{su}(1)=\{0\}$. The source attributes this lemma to references [92] and [139]. It asserts controllability after projection and does not assert independent control of all block phases.
-- source:
--   Theoretical Guarantees for Permutation-Equivariant Quantum Neural Networks, arXiv:2210.09974v3, PDF p. 13, Lemma 3 (Subspace controllability)

import Definitions.Def_QAlgorithms_Papers_Independent_Support50_P30

noncomputable section

open MeasureTheory

open scoped BigOperators ComplexConjugate Matrix.Norms.L2Operator NNReal ENNReal

namespace QAlgorithms.Papers.Independent.Support50.P30

attribute [local instance] LieRing.ofAssociativeRing

/-- PDF p.13, Lemma 3, attributed to [92] and [139]. Projection onto each
block is su(d) or u(d); independent controllability is not asserted. -/
theorem subspace_controllability {n : ℕ} (hn : 2 ≤ n) (S : SchurFrame n) (m : Sector n) :
    (commonBlock S m '' (dynamicalLie n : Set (QnnOperator n))) =
      {A | A.conjTranspose = -A ∧ A.trace = 0} ∨
    (commonBlock S m '' (dynamicalLie n : Set (QnnOperator n))) =
      {A | A.conjTranspose = -A} := by sorry

end QAlgorithms.Papers.Independent.Support50.P30

end
