theorem abs_ediv_le_of (x d c : ℤ) (hd : 0 < d) (h : |x| ≤ c * d) : |x / d| ≤ c := by
  have h1 := Int.ediv_mul_le x hd.ne'
  have h2 := Int.lt_ediv_add_one_mul_self x hd
  rw [abs_le] at h ⊢
  constructor
  · by_contra hc
    have : x / d + 1 ≤ -c := by omega
    nlinarith
  · by_contra hc
    have : c + 1 ≤ x / d := by omega
    nlinarith

theorem log2Approx_ge (M : ℕ) (hM : 1 ≤ M) : 2 * (((2 ^ M / 3 : ℕ)) : ℤ) ≤ log2Approx M := by
  simp only [log2Approx, atanhInv_eq, atanSum, one_pow, one_mul]
  have : (((2 ^ M / 3 : ℕ)) : ℤ) ≤ ∑ m ∈ Finset.range M,
      (((2 ^ M / ((2 * m + 1) * 3 ^ (2 * m + 1))) : ℕ) : ℤ) := by
    have := Finset.single_le_sum (s := Finset.range M)
      (f := fun m => (((2 ^ M / ((2 * m + 1) * 3 ^ (2 * m + 1))) : ℕ) : ℤ))
      (fun i _ => by positivity) (Finset.mem_range.2 (by omega : 0 < M))
    simpa using this
  linarith

theorem log2Bits_ge (m : ℕ) : 2 ^ m ≤ 3 * log2Bits m := by
  have hA := log2Approx_ge (2 * m + 9) (by omega)
  simp only [log2Bits]
  have e1 : (2 : ℕ) ^ (2 * m + 9) = 2 ^ m * 2 ^ (m + 9) := by rw [← pow_add]; ring_nf
  have e2 : (2 : ℤ) ^ (m + 9) = 2 ^ (m + 8) * 2 := by rw [pow_succ]
  rw [e1] at hA
  have hd : (256 : ℤ) ≤ 2 ^ (m + 8) := by
    have : (2 : ℤ) ^ 8 ≤ 2 ^ (m + 8) := pow_le_pow_right₀ (by norm_num) (by omega)
    linarith
  have hq : (1 : ℤ) ≤ 2 ^ m := one_le_pow₀ (by norm_num)
  have ht : (2 : ℤ) ^ m * 2 ^ (m + 9) ≤ 3 * (((2 ^ m * 2 ^ (m + 9) / 3 : ℕ)) : ℤ) + 2 := by
    have := Nat.lt_div_mul_add (a := 2 ^ m * 2 ^ (m + 9)) (b := 3) (by norm_num)
    have : (2 ^ m * 2 ^ (m + 9) : ℕ) ≤ 3 * (2 ^ m * 2 ^ (m + 9) / 3) + 2 := by omega
    exact_mod_cast this
  generalize (((2 ^ m * 2 ^ (m + 9) / 3 : ℕ)) : ℤ) = t at *
  rw [e2] at ht ⊢
  generalize (2 : ℤ) ^ m = q at *
  generalize (2 : ℤ) ^ (m + 8) = d at *
  have hc : (q + 2) / 3 ≤ (log2Approx (2 * m + 9) + d) / (d * 2) := by
    rw [Int.le_ediv_iff_mul_le (by positivity)]
    have h3 := Int.ediv_mul_le (q + 2) (by norm_num : (3 : ℤ) ≠ 0)
    nlinarith
  have := Int.lt_ediv_add_one_mul_self (q + 2) (by norm_num : (0 : ℤ) < 3)
  omega

