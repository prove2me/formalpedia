theorem pc_chirp (hP : dlV p h (D + 1) + 3 ≤ P) (hst : ∀ i, sv i ≤ t i) (ht2 : ∀ i, 2 ≤ t i)
    (hT : ∀ i, t i ≤ 2 ^ (h + 1)) (hprod : ∏ i, t i = N) (hdr : (D + 1) * 2 ^ (h + 1) ≤ N) :
