  exact ⟨val.trans qv,(congrFun idx 0).trans wn,(congrFun idx 1).trans wd,(congrFun idx 2).trans sg,
    fun i hi => (congrFun idx _).trans (nb i hi),fun i hi => (congrFun idx _).trans (db i hi)⟩

