open Filter MeasureTheory ProbabilityTheory Topology
open scoped ENNReal NNReal


variable {Ω E : Type*} {mΩ : MeasurableSpace Ω}
  [PseudoEMetricSpace E] [T2Space E] [CompleteSpace E]

open MarkovProcess in

theorem MarkovProcess.IsKolmogorovProcess.ae_existsUnique_tendsto_unitDyadicFloorValue
    {P : Measure Ω} {X : NNRat → Ω → E} {p q γ : ℝ} {M : ℝ≥0}
    (hX : IsKolmogorovProcess X P p q M) (hγ : 0 < γ)
    (hγq : γ < (q - 1) / p) :
    ∀ᵐ ω ∂P, ∀ t : Set.Icc (0 : ℝ) 1,
      ∃! y : E, Tendsto (fun n : ℕ ↦ X (unitDyadicFloorValue n t) ω) atTop (𝓝 y) := by sorry
