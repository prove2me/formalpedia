-- title:
--   Unit-modulus elements are precisely eighth roots of unity
-- statement:
--   Let $z\in R=\mathbb Z[1/\sqrt2,i]$, and let $\omega=e^{i\pi/4}$. Then
--
--   $$
--   |z|=1\quad\Longleftrightarrow\quad\exists k\in\{0,1,\ldots,7\}:\ z=\omega^k.
--   $$
--
--   This classifies elements of ordinary complex modulus one, rather than all algebraic units of $R$. It fixes the determinant and absolute-phase possibilities in exact synthesis; the proof is on PDF page 21.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 4, Appendix A / §3 unnumbered: classification of unit-modulus ring elements

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Section 3 and Appendix A, PDF pp.4,21: unit-modulus elements, rather than
all ring units, are exactly the eight positive-sign omega powers. -/
theorem unit_modulus_classification (z : ℂ) (hz : z ∈ synthesisRing) :
    ‖z‖ = 1 ↔ ∃ k : Fin 8, z = (QAlgorithms.gateT true true) ^ k.val := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
