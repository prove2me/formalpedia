def toGRJ {R : Type u} [CommRing R] {X : Scheme.{u}} {f : X ⟶ Spec (.of R)}
    (G : WeierstrassProjModel.RelativeGroupLaw R f) :
    GoodReductionJacobian.RelativeGroupLaw R f :=
  ⟨G.mul, G.one, G.inv, G.mul_assoc, G.one_mul, G.mul_one, G.inv_mul_cancel, G.mul_natural⟩

theorem toGRJ_nsmul {R : Type u} [CommRing R] {X : Scheme.{u}} {f : X ⟶ Spec (.of R)}
    (G : WeierstrassProjModel.RelativeGroupLaw R f) {T : Scheme.{u}} (t : T ⟶ Spec (.of R))
    (n : ℕ) (x : SchemeHomOver t f) :
    (toGRJ G).nsmul t n x = G.nsmul t n x := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [GoodReductionJacobian.RelativeGroupLaw.nsmul_succ,
        WeierstrassProjModel.RelativeGroupLaw.nsmul_succ, ih]
      rfl

theorem toGRJ_schemeNsmul {R : Type u} [CommRing R] {X : Scheme.{u}} {f : X ⟶ Spec (.of R)}
    (G : WeierstrassProjModel.RelativeGroupLaw R f) (n : ℕ) :
    (toGRJ G).schemeNsmul n = G.schemeNsmul n :=
  congrArg Subtype.val (toGRJ_nsmul G f n _)

section BC

variable {R : Type u} [CommRing R] {R' : Type u} [CommRing R']
variable (ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R))
variable {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}

open GoodReductionJacobian GoodReductionJacobian.RelativeGroupLaw

theorem isPullback_fst_schemeNsmul_baseChange (L : GoodReductionJacobian.RelativeGroupLaw R f)
    (n : ℕ) :
    IsPullback (pullback.fst f ι) ((L.baseChange ι).schemeNsmul n) (L.schemeNsmul n)
      (pullback.fst f ι) := by
  obtain ⟨h1, h2, -⟩ := L.baseChange_schemeNsmul_comp_fst_and_eq_pullback_map ι n
  refine IsPullback.of_bot (h₃₁ := ι) (v₂₁ := pullback.snd f ι) (v₂₂ := f) ?_ h1.symm
    (IsPullback.of_hasPullback f ι)
  rw [h2, L.schemeNsmul_over]
  exact IsPullback.of_hasPullback f ι

end BC

section GeomPoint

variable {R : Type u} [CommRing R] (s : (Spec (CommRingCat.of R) : Scheme.{u}))

abbrev Kbar : Type u := AlgebraicClosure s.asIdeal.ResidueField

noncomputable abbrev geomPt : Spec (CommRingCat.of (Kbar s)) ⟶ Spec (CommRingCat.of R) :=
  Spec.map (CommRingCat.ofHom (algebraMap R (Kbar s)))

theorem geomPt_closedPoint : (geomPt s) (IsLocalRing.closedPoint (Kbar s)) = s := by
  show PrimeSpectrum.comap (algebraMap R (Kbar s)) (IsLocalRing.closedPoint (Kbar s)) = s
  ext1
  show Ideal.comap (algebraMap R (Kbar s)) (IsLocalRing.maximalIdeal (Kbar s)) = s.asIdeal
  rw [IsLocalRing.maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot,
    IsScalarTower.algebraMap_eq R s.asIdeal.ResidueField (Kbar s),
    RingHom.ker_comp_of_injective _ (algebraMap s.asIdeal.ResidueField (Kbar s)).injective,
    Ideal.ker_algebraMap_residueField]

theorem range_geomPt : Set.range (geomPt s) = {s} := by
  ext t
  simp only [Set.mem_range, Set.mem_singleton_iff]
  constructor
  · rintro ⟨x, rfl⟩
    rw [show x = IsLocalRing.closedPoint (Kbar s) from Subsingleton.elim _ _]
    exact geomPt_closedPoint s
  · intro h
    rw [h]
    exact ⟨_, geomPt_closedPoint s⟩

end GeomPoint

