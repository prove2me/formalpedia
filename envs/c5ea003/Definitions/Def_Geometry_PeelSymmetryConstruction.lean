import Mathlib
import Definitions.Def_Geometry_PeelStoppingTime
/-
# The matching family: equal-volume shell peelings of Euclidean balls

`Catalog/Geometry/PeelStoppingTime.lean` establishes the *upper bound* half of
the peeling theory: within any window of `N` peeling steps there is a step
whose layer content is at most the average rate
(`exists_peel_stopping_time`), with the accompanying error control
(`peelEstimate_error`) and rigidity classification (`peel_extremal_tfae`).

This file supplies the missing half — a **matching family of actions**:

* **Cyclic actions on the layers.**  The subgroup generated by `finRotate N`
  inside `Equiv.Perm (Fin N)` acts pretransitively on the `N` peeling steps
  (`zpowers_finRotate_pretransitive`), so a peeling whose layer contents are
  invariant under a single `N`-cycle already saturates the pigeonhole bound
  (`peel_extremal_of_cyclic_action`).

* **A geometric realisation.**  For every dimension `d ≥ 1`, radius `R ≥ 0`
  and every `N ≥ 1`, the concentric shells of radii
  `shellRadius R d N k = R (1 - k/N)^{1/d}` peel the ball `B(0,R) ⊆ ℝ^d` into
  `N` pieces of *equal volume* `vol(B(0,R))/N` (`shellPeel_gap`,
  `shellLayer_volume`).  Every layer is invariant under the whole orthogonal
  group (`shellLayer_isometry_invariant`): the construction is `O(d)`-equivariant.

* **Rigidity in the geometric setting.**  Conversely, *any* nested family of
  balls shrinking `B(0,R)` to a point in `N` steps, all of whose shells have
  volume at most `vol(B(0,R))/N`, must be the equal-volume shell family
  (`ball_peel_rigidity`).  Hence the constant `1` in the stopping-time bound
  is optimal already for ball peelings (`ball_peel_stopping_time_sharp`).

## Lab notes

Dimension check (`d = 2`, `R = 1`, `N = 4`): radii `1, √(3)/2 ≈ .866,
√(2)/2 ≈ .707, 1/2, 0`; shell areas `π/4` each — the radii are *not* in
arithmetic progression, only their `d`-th powers are.  This is the reason the
rigidity statement has to be phrased through the volume profile rather than
the radius profile, and it is what makes `ball_peel_rigidity` a genuinely
`d`-dependent statement.
-/

namespace Catalog.Geometry.Peel

open Finset MeasureTheory Metric
open Fin.NatCast

/-! ## Cyclic actions on the layers of a peeling -/




/-! ## Volumes of Euclidean balls -/

/-- The volume of the ball of radius `r` in `ℝ^d`, as a real number. -/
noncomputable def ballVol (d : ℕ) (r : ℝ) : ℝ :=
  (volume (ball (0 : EuclideanSpace ℝ (Fin d)) r)).toReal

lemma ballVol_nonneg (d : ℕ) (r : ℝ) : 0 ≤ ballVol d r := ENNReal.toReal_nonneg

/-- Scaling law of Lebesgue measure: `vol B(0,r) = r^d · vol B(0,1)`. -/
lemma ballVol_eq (d : ℕ) (hd : 0 < d) {r : ℝ} (hr : 0 ≤ r) :
    ballVol d r = r ^ d * ballVol d 1 := by
  haveI : Nonempty (Fin d) := Fin.pos_iff_nonempty.mp hd
  haveI : Nontrivial (EuclideanSpace ℝ (Fin d)) := by infer_instance
  have h := MeasureTheory.Measure.addHaar_ball
    (μ := (volume : Measure (EuclideanSpace ℝ (Fin d)))) 0 hr
  rw [finrank_euclideanSpace_fin] at h
  unfold ballVol
  rw [h, ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]

lemma ballVol_one_pos (d : ℕ) : 0 < ballVol d 1 := by
  unfold ballVol
  rw [ENNReal.toReal_pos_iff]
  exact ⟨measure_ball_pos _ _ one_pos, measure_ball_lt_top⟩


lemma ballVol_mono (d : ℕ) (hd : 0 < d) {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    ballVol d a ≤ ballVol d b := by
  rw [ballVol_eq d hd ha, ballVol_eq d hd (ha.trans hab)]
  have hpow : a ^ d ≤ b ^ d := pow_le_pow_left₀ ha hab d
  nlinarith [ballVol_one_pos d]


/-! ## The equal-volume shell peeling of a ball -/

/-- Radius of the `k`-th sphere in the equal-volume shell peeling of `B(0,R)`
into `N` pieces: `R (1 - k/N)^{1/d}`. -/
noncomputable def shellRadius (R : ℝ) (d N k : ℕ) : ℝ :=
  R * (max 0 (1 - (k : ℝ) / (N : ℝ))) ^ ((d : ℝ)⁻¹)





/-- The peeling profile of the equal-volume shell family: the equipartition
profile with total content `vol B(0,R)`. -/
noncomputable def shellPeel (d : ℕ) (R : ℝ) (N : ℕ) : PeelProfile :=
  equipartitionProfile (ballVol d R) (ballVol_nonneg d R) N





/-- The `k`-th shell of the peeling, as a subset of `ℝ^d`. -/
noncomputable def shellLayer (d : ℕ) (R : ℝ) (N k : ℕ) : Set (EuclideanSpace ℝ (Fin d)) :=
  ball 0 (shellRadius R d N k) \ ball 0 (shellRadius R d N (k + 1))



/-! ## Rigidity of ball peelings -/

/-- The peeling profile attached to a nested family of balls. -/
noncomputable def radiusProfile (d : ℕ) (hd : 0 < d) (r : ℕ → ℝ)
    (hanti : Antitone r) (hnn : ∀ k, 0 ≤ r k) : PeelProfile where
  size k := ballVol d (r k)
  anti := fun _ b hab => ballVol_mono d hd (hnn b) (hanti hab)
  nonneg := fun _ => ballVol_nonneg d _





end Catalog.Geometry.Peel


