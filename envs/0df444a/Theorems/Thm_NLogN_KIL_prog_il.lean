theorem NLogN.KIL.prog_il (D q : ℕ) (hq : 2 ≤ q) (hm : 1 ≤ m)
    (hfr : ∀ j, FramesOK (FrOK C (q ^ m ^ j) (ShFrac (q ^ m ^ j) D)) C.gates C.Min C.Mout)
    (k P L : ℕ) (A B Cs : Shape) (hP : 1 ≤ P) (hL : W ^ k ∣ L) (hL1 : 1 ≤ L)
    (hA : ∀ a ∈ A, 1 ≤ a) (hB : ∀ a ∈ B, 1 ≤ a) (hC : ∀ a ∈ Cs, 1 ≤ a) (Bb : ℕ)
    (hV : zsz ((vol (P :: L :: swShape A B Cs (q ^ m ^ k)) : ℕ) : ℤ) ≤ Bb)
    (I : List Sym) (t : IState HS) (R : List Item) (xs : List (ZMod 2))
    (hxs : xs.length = vol (P :: L :: swShape A B Cs (q ^ m ^ k))) :
