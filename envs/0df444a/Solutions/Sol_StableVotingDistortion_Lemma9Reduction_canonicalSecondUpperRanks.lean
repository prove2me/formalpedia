section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open PaperBox


def C2 (f : Box 2 → Bool) (p P q Q : ℚ) : Prop :=
  ∃ t : Cover 2, t.verify f ![⟨p,P⟩,⟨q,Q⟩]=true
def C3 (f : Box 3 → Bool) (p P q Q z Z : ℚ) : Prop :=
  ∃ t : Cover 3, t.verify f ![⟨p,P⟩,⟨q,Q⟩,⟨z,Z⟩]=true

private theorem split_rect {d : ℕ} {f : Box d → Bool} {b l r : Box d}
    {s t : Cover d} (i : Fin d) (u : ℚ) (el : lowerBox b i u=l)
    (er : upperBox b i u=r) (h : s.verify f l=true) (k : t.verify f r=true) :
    (Cover.split i u s t).verify f b=true := by
  simp only [Cover.verify,el,er,h,k,Bool.and_self]

theorem cLeaf3 {f : Box 3 → Bool} {p P q Q z Z : ℚ}
    (h : f ![⟨p,P⟩,⟨q,Q⟩,⟨z,Z⟩]=true) : C3 f p P q Q z Z := ⟨.leaf,h⟩

theorem cSplit30 {f : Box 3 → Bool} {p P q Q z Z : ℚ} (cut : ℚ)
    (a : C3 f p cut q Q z Z) (b : C3 f cut P q Q z Z) : C3 f p P q Q z Z := by
  obtain ⟨s,hs⟩ := a
  obtain ⟨t,ht⟩ := b
  refine ⟨.split 0 cut s t,split_rect 0 cut ?_ ?_ hs ht⟩ <;> funext j <;> fin_cases j <;> rfl

theorem cSplit31 {f : Box 3 → Bool} {p P q Q z Z : ℚ} (cut : ℚ)
    (a : C3 f p P q cut z Z) (b : C3 f p P cut Q z Z) : C3 f p P q Q z Z := by
  obtain ⟨s,hs⟩ := a
  obtain ⟨t,ht⟩ := b
  refine ⟨.split 1 cut s t,split_rect 1 cut ?_ ?_ hs ht⟩ <;> funext j <;> fin_cases j <;> rfl

theorem cSplit32 {f : Box 3 → Bool} {p P q Q z Z : ℚ} (cut : ℚ)
    (a : C3 f p P q Q z cut) (b : C3 f p P q Q cut Z) : C3 f p P q Q z Z := by
  obtain ⟨s,hs⟩ := a
  obtain ⟨t,ht⟩ := b
  refine ⟨.split 2 cut s t,split_rect 2 cut ?_ ?_ hs ht⟩ <;> funext j <;> fin_cases j <;> rfl



inductive AxisPartition (d : ℕ) where
  | leaf
  | bisect (j : Fin d) (left right : AxisPartition d)

namespace AxisPartition


def check2 (f : Box 2 → Bool) : AxisPartition 2 → ℚ → ℚ → ℚ → ℚ → Bool
  | .leaf, p, P, q, Q => f ![⟨p,P⟩,⟨q,Q⟩]
  | .bisect j left right, p, P, q, Q =>
    if j=0 then
      let m := (p+P)/2
      check2 f left p m q Q && check2 f right m P q Q
    else
      let m := (q+Q)/2
      check2 f left p P q m && check2 f right p P m Q


def check3 (f : Box 3 → Bool) : AxisPartition 3 → ℚ → ℚ → ℚ → ℚ → ℚ → ℚ → Bool
  | .leaf, p, P, q, Q, z, Z => f ![⟨p,P⟩,⟨q,Q⟩,⟨z,Z⟩]
  | .bisect j left right, p, P, q, Q, z, Z =>
    if j=0 then
      let m := (p+P)/2
      check3 f left p m q Q z Z && check3 f right m P q Q z Z
    else if j=1 then
      let m := (q+Q)/2
      check3 f left p P q m z Z && check3 f right p P m Q z Z
    else
      let m := (z+Z)/2
      check3 f left p P q Q z m && check3 f right p P q Q m Z

theorem covers3 (f : Box 3 → Bool) (t : AxisPartition 3) {p P q Q z Z : ℚ}
    (h : check3 f t p P q Q z Z = true) : C3 f p P q Q z Z := by
  induction t generalizing p P q Q z Z with
  | leaf => exact cLeaf3 h
  | bisect j left right il ir =>
    by_cases hp : j=0
    · simp only [check3,if_pos hp,Bool.and_eq_true] at h
      exact cSplit30 _ (il h.1) (ir h.2)
    by_cases hq : j=1
    · simp only [check3,if_neg hp,if_pos hq,Bool.and_eq_true] at h
      exact cSplit31 _ (il h.1) (ir h.2)
    · simp only [check3,if_neg hp,if_neg hq,Bool.and_eq_true] at h
      exact cSplit32 _ (il h.1) (ir h.2)

end AxisPartition
end StableVotingDistortion.PaperCurve
end

