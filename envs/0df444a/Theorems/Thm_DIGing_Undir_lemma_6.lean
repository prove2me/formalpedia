-- title:
--   Lemma 6, p. 11 — second arrow z → y̌: ‖y̌‖^{λ,K}_F ≤ λ(1−λᴮ)/((λᴮ−δ)(1−λ))‖z‖^{λ,K}_F + λᴮ/(λᴮ−δ)Σ_{t=1}^B λ^{1−t}‖y̌(t−1)‖_F
-- statement:
--   Let the mixing matrices satisfy Assumption 1 with integer $B\ge1$, and let $\delta=\sup_{k\ge B-1}\delta(k)$. Let $\lambda>0$ satisfy $\delta<\lambda^B<1$. Let $(\mathbf x(k),\mathbf y(k))$ be generated by DIGing (Algorithm 1) with any step size $\alpha$, let $\mathbf z(k)$ be the gradient differences ($\mathbf z(0)=0$) and $\check{\mathbf y}(k)=\mathbf y(k)-\mathbf 1\bar y(k)^\top$. Then for every $K=0,1,\dots$,
--   $$\|\check{\mathbf y}\|_F^{\lambda,K}\le\frac{\lambda(1-\lambda^B)}{(\lambda^B-\delta)(1-\lambda)}\|\mathbf z\|_F^{\lambda,K}+\frac{\lambda^B}{\lambda^B-\delta}\sum_{t=1}^B\lambda^{1-t}\|\check{\mathbf y}(t-1)\|_F.$$
--
--   This is the second arrow of the cycle used in the proof of Theorem 10: the gradient-tracking variable stays close to consensus as long as the gradient differences are small.
--
--   **Formalization Note.** $\delta$ is given as the least upper bound of $\{\delta(k):k\ge B-1\}$. The page's "let $\lambda$ be such that $\delta<\lambda^B<1$" does not exclude $\lambda\le0$ for even $B$; the ergodic norm (6) is defined for $\lambda\in(0,1)$ (p. 9), so $\lambda>0$ is stated, and $\lambda<1$ follows. Assumption 1(ii) includes nonnegative entries (see the Setting file); step (14) of the proof bounds $\|W_b(k)\mathbf z\|_{\mathbf L}$ by $\|\mathbf z\|_F$, which fails for signed matrices with unit row and column sums. $\lambda^{1-t}\|\check{\mathbf y}(t-1)\|_F$ is written $\|\check{\mathbf y}(t-1)\|_F/\lambda^{t-1}$.
-- source:
--   Nedić, Olshevsky & Shi, arXiv:1607.03218v3, Lemma 6, display (12), p. 11

import Mathlib
import Definitions.Def_DIGing_Undir_Common
import Definitions.Def_DIGing_Undir_Setting

namespace DIGing.Undir

theorem lemma_6 {n p : ℕ} (f : Fin n → EuclideanSpace ℝ (Fin p) → ℝ)
    (E : ℕ → SimpleGraph (Fin n)) (W : ℕ → Matrix (Fin n) (Fin n) ℝ) (B : ℕ)
    (h1 : Assumption1 E W B)
    (δ : ℝ) (hδ : IsLUB {d | ∃ k, B - 1 ≤ k ∧ d = deltaK W B k} δ)
    (lam : ℝ) (hlam0 : 0 < lam) (hlam : δ < lam ^ B) (hlam1 : lam ^ B < 1)
    (α : ℝ) (x y : ℕ → Stack n p) (hrun : IsDIGingRun f W α x y) :
    ∀ K : ℕ, ergK lam K (fun k => frob (cons (y k))) ≤
      lam * (1 - lam ^ B) / ((lam ^ B - δ) * (1 - lam)) * ergK lam K (fun k => frob (zSeq f x k)) +
        lam ^ B / (lam ^ B - δ) * ∑ t ∈ Finset.Icc 1 B, frob (cons (y (t - 1))) / lam ^ (t - 1) := by sorry

end DIGing.Undir
