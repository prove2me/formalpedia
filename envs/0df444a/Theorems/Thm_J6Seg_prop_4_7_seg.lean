theorem J6Seg.prop_4_7_seg (p P R lam w s t α : ℕ) [NeZero s] [NeZero t] (hst : s < t)
    (hcop : Nat.Coprime s t) (hα : 2 ≤ α) (hαp : α ^ 2 ≤ p) (hx3 : 3 * s ≤ α ^ 2 * (t - s))
    (hl : 1 ≤ lam) (hw : w ≤ s) (hR : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ R)
    (hpP : p + 1 ≤ P) (hP : 1000 * fullG lam w s t α (1 / 2) ≤ 2 ^ P)
    (hE : 200 * segE p P lam w s t α ≤ 2 ^ p) :
    ∃ (A : (ZMod s → ℂ) →L[ℂ] (ZMod t → ℂ)) (B : (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ)),
      ‖A‖ ≤ 1 ∧ ‖B‖ ≤ 1 / 2 ∧
      (∀ u, (s : ℂ)⁻¹ • ZMod.dft u = (2 : ℂ) ^ (2 * α ^ 2) • B ((t : ℂ)⁻¹ • ZMod.dft (A u))) ∧
      (∀ U : ℕ → ℤ × ℤ, (∀ i, ‖toC (U i)‖ ≤ 2 ^ p) → ∀ k : ZMod t,
        ‖toC (Sapprox p s t α U k.val) - 2 ^ p * A (fun j => toC (U j.val) / 2 ^ p) k‖
          ≤ 6 * sWidth p α + 4) ∧
      (∀ V : ℕ → ℤ × ℤ, (∀ i, ‖toC (V i)‖ ≤ 2 ^ p) → ∀ j : ZMod s,
        ‖toC (Bseg p P R lam w s t α V j.val) - 2 ^ p * B (fun k => toC (V k.val) / 2 ^ p) j‖
          ≤ 2 * segE p P lam w s t α + 3) := by sorry
