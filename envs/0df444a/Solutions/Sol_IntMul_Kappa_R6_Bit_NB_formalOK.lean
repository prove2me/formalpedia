    move₁ h.hS h.hSi ho hc hn hb]

/-- **Block one.** -/
theorem blk1_lab {b : ℕ} (hb : b < 1771) (L : Wr → FMat 529 N)
    (hL : ∀ w, w < 43642 → L (ι1 b w) = lab1 ch N b (codeOf SG1_0 w)) :
    LabGates N (blk1 ch b) L ∧ (∀ w, w < 43642 → (blk1 ch b).foldl (labStepH N) L (ι1 b w) = fin1 ch N b w) ∧
      ∀ x, (∀ w, w < 43642 → ι1 b w ≠ x) → (blk1 ch b).foldl (labStepH N) L x = L x := by
  have hι : ∀ w w', w < 43642 → w' < 43642 → ι1 b w = ι1 b w' → w = w' :=
    fun w w' hw hw' e => (ι1_inj hb hb hw hw' e).2
  obtain ⟨c1, c2, c3⟩ := genF_labGates (R := ZMod 2) (ι1 b) (· < 43642) (lab1 ch N b) (ch.e1 b) hι W1F
    (codeOf SG1_0) L (wf_lab stage1_seg.1) (by rw [← cs1_eq]; exact hE1 h hb) hL
  rw [← cs1_eq] at c1 c2 c3
  set L1 := (chunkProg (R := ZMod 2) (ι1 b) (ch.e1 b) cs1).foldl (labStepH N) L with hL1
  have hrng : ∀ w ∈ List.range' 3542 40077, w < 43642 := fun w hw => by
    rw [List.mem_range'_1] at hw; omega
  obtain ⟨d1, d2, d3⟩ := edges_local (R := ZMod 2) (N := N) (ι1 b) (fun _ => ch.ex b) (List.range' 3542 40077)
