-- Source module: NLogN.SSMath
namespace NLogN

open IntMul

theorem length_pcs (M : ℕ) : ∀ K x, (pcs M K x).length = K
  | 0, _ => rfl
  | K + 1, x => by simp [pcs, length_pcs M K]

theorem sg_split' (x : ℤ) (M : ℕ) :
    sg x (x.natAbs % 2 ^ M) + 2 ^ M * sg x (x.natAbs / 2 ^ M) = x := by
  have h := sg_natAbs x
  rw [← Nat.mod_add_div x.natAbs (2 ^ M), sg_add, sg_mul] at h
  push_cast at h
  exact h

theorem pcs_spec (M : ℕ) : ∀ K x, x.natAbs < 2 ^ (K * M) → zev (2 ^ M) (pcs M K x) = x
  | 0, x, h => by simp at h; simp [pcs, zev, h]
  | K + 1, x, h => by
    simp only [pcs, zev]
    rw [pcs_spec M K _ ?_, sg_split']
    rw [natAbs_sg, Nat.div_lt_iff_lt_mul (by positivity), ← pow_add]
    convert h using 2; ring

theorem zev_eq_sum (B : ℤ) : ∀ A : List ℤ,
    zev B A = ∑ i ∈ Finset.range A.length, A.getD i 0 * B ^ i
  | [] => by simp [zev]
  | a :: A => by
    rw [zev, zev_eq_sum B A, List.length_cons, Finset.sum_range_succ', Finset.mul_sum]
    simp only [List.getD_cons_succ, List.getD_cons_zero, pow_zero, mul_one]
    rw [add_comm]; congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    ring

theorem length_ncZ (K : ℕ) (A B : List ℤ) : (ncZ K A B).length = K := by simp [ncZ]

theorem ncZ_getD (K : ℕ) (A B : List ℤ) {m : ℕ} (hm : m < K) :
    (ncZ K A B).getD m 0 = ∑ i ∈ Finset.range K, ∑ l ∈ Finset.range K,
      ((if i + l = m then A.getD i 0 * B.getD l 0 else 0) -
        (if i + l = m + K then A.getD i 0 * B.getD l 0 else 0)) := by
  simp [ncZ, List.getD_eq_getElem?_getD, List.getElem?_range hm]

section ring

variable (n : ℕ)

/-- Recomposition: the negacyclic convolution evaluated at `2^M` is the product mod `2^(KM)+1`. -/
theorem zev_ncZ (K M : ℕ) (hKM : K * M = n) (A B : List ℤ) (hA : A.length = K)
    (hB : B.length = K) :
    ((zev (2 ^ M) (ncZ K A B) : ℤ) : (ZMod (2 ^ n + 1))) = (zev (2 ^ M) A : (ZMod (2 ^ n + 1))) * (zev (2 ^ M) B : (ZMod (2 ^ n + 1))) := by
  have hy : (2 : (ZMod (2 ^ n + 1))) ^ (M * K) = -1 := by rw [mul_comm, hKM, two_pow_eq_neg_one]
  rw [zev_eq_sum, zev_eq_sum, zev_eq_sum, length_ncZ, hA, hB]
  push_cast
  rw [Finset.sum_mul_sum]
  rw [Finset.sum_congr rfl fun m hm => by
    rw [ncZ_getD _ _ _ (Finset.mem_range.mp hm)]]
  push_cast
  simp only [Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i hi => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun l hl => ?_
  have hi' := Finset.mem_range.mp hi
  have hl' := Finset.mem_range.mp hl
  simp only [sub_mul, Finset.sum_sub_distrib, ite_mul, zero_mul]
  rw [Finset.sum_ite_eq]
  have hyK : ((2 : (ZMod (2 ^ n + 1))) ^ M) ^ K = -1 := by rw [← pow_mul, hy]
  rcases lt_or_ge (i + l) K with h | h
  · rw [if_pos (Finset.mem_range.mpr h),
      Finset.sum_eq_zero (fun x _ => if_neg (by omega)), pow_add]
    ring
  · rw [if_neg (by simp; omega), Finset.sum_eq_single_of_mem (i + l - K)
      (Finset.mem_range.mpr (by omega)) (fun x _ hx => if_neg (by omega)), if_pos (by omega)]
    have e : ((2 : (ZMod (2 ^ n + 1))) ^ M) ^ (i + l) = ((2 : (ZMod (2 ^ n + 1))) ^ M) ^ (i + l - K) * ((2 : (ZMod (2 ^ n + 1))) ^ M) ^ K := by
      rw [← pow_add]; congr 1; omega
    rw [hyK] at e
    rw [pow_add] at e
    linear_combination (-((A.getD i 0 : (ZMod (2 ^ n + 1))) * (B.getD l 0 : (ZMod (2 ^ n + 1))))) * e

theorem cast_eq_emod {x y : ℤ} (h : (x : (ZMod (2 ^ n + 1))) = (y : (ZMod (2 ^ n + 1)))) : x % (2 ^ n + 1) = y % (2 ^ n + 1) := by
  rw [ZMod.intCast_eq_intCast_iff'] at h; push_cast at h; exact h

end ring

theorem carZ_spec (M : ℕ) : ∀ E c,
    zev (2 ^ M) E + c = zev (2 ^ M) (carZ M E c).1 + 2 ^ (E.length * M) * (carZ M E c).2
  | [], c => by simp [carZ, zev]
  | e :: E, c => by
    simp only [carZ, zev, List.length_cons]
    have ih := carZ_spec M E ((e + c) / 2 ^ M)
    have hd := Int.emod_add_mul_ediv (e + c) (2 ^ M)
    have : (2 : ℤ) ^ ((E.length + 1) * M) = 2 ^ M * 2 ^ (E.length * M) := by
      rw [← pow_add]; congr 1; ring
    rw [this]
    linear_combination (2 ^ M) * ih - hd

end NLogN

