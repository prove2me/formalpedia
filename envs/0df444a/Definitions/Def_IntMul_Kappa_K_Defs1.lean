section
-- Source module: Solutions.AModelShear
/-!
# Shears and interchanges in the array model (Lemma 10 / end of Prop. 11)

Active fields are indexed by `Fin (m + m)`: the `H` fields are `Fin.castAdd m i` (the first `m`),
the `D` fields are `Fin.natAdd m j` (the last `m`). With a `Layout` (strictly increasing
positions) every `H` field therefore precedes every `D` field.
-/

namespace AModel

open Matrix

section Blocks

variable {m Q : ℕ}

/-- `H` part of an active vector. -/
def hv {R : Type*} (x : Fin (m + m) → R) : Fin m → R := fun i => x (Fin.castAdd m i)

/-- `D` part of an active vector. -/
def dv {R : Type*} (x : Fin (m + m) → R) : Fin m → R := fun j => x (Fin.natAdd m j)

/-- A `2 × 2` block matrix over `Fin m ⊕ Fin m`, reindexed to `Fin (m + m)`. -/
def blk (P B C D : Matrix (Fin m) (Fin m) (ZMod Q)) : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod Q) :=
  reindex finSumFinEquiv finSumFinEquiv (fromBlocks P B C D)

/-- The shear `(H, D) ↦ (H + A D, D)`. -/
def shearMat (A : Matrix (Fin m) (Fin m) (ZMod Q)) : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod Q) :=
  AModel.blk 1 A 0 1

/-- The block interchange `(H, D) ↦ (D, H)`. -/
def swapMat : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod Q) := AModel.blk 0 1 1 0

section AmapShear

variable {sh : Shape} {m Q : ℕ} (Λ : Layout sh (m + m) Q) [NeZero Q]

end AmapShear

end Blocks

/-! ## Inverse steps -/

section Rev

variable {n Q : ℕ}

/-- The explicit inverse of a step, as a step: a shift by `u⁻¹` with controls `-u⁻¹ c`. -/
def Step.rev : Step n Q → Step n Q
  | .shift i u c => .shift i u⁻¹ (fun j => -(u⁻¹ * c j))
  | .swap i j => .swap i j

/-- Is the step a field transposition? -/
def Step.isSwap : Step n Q → Bool
  | .shift _ _ _ => false
  | .swap _ _ => true

/-- Inverse of a step list: inverted steps in reverse order. -/
def revSteps (l : List (Step n Q)) : List (Step n Q) := (l.map Step.rev).reverse

end Rev

/-! ## Lower triangular transforms of one block -/

section Tri

variable {m Q : ℕ}

/-- `H` field indices, descending. -/
def hIdx (m : ℕ) : List (Fin (m + m)) := (List.finRange m).reverse.map (Fin.castAdd m)

/-- `D` field indices, descending. -/
def dIdx (m : ℕ) : List (Fin (m + m)) := (List.finRange m).reverse.map (Fin.natAdd m)

/-- Shifts realizing `H ← E H` (one per `H` field, descending targets). -/
def hSteps (E : Matrix (Fin m) (Fin m) (ZMod Q)) : List (Step (m + m) Q) :=
  (hIdx m).map (shiftStep (AModel.blk E 0 0 1))

/-- Shifts realizing `D ← E D` (one per `D` field, descending targets). -/
def dSteps (E : Matrix (Fin m) (Fin m) (ZMod Q)) : List (Step (m + m) Q) :=
  (dIdx m).map (shiftStep (AModel.blk 1 0 0 E))

end Tri

/-! ## The pivot gadget: `H_i ← H_i + D_j` with one interchange -/

section Pivot

variable {m Q : ℕ}

/-- `D_j ← D_j + H_i`, `(H_i, D_j) ← (D_j, H_i)`, `D_j ← H_i − D_j`. -/
def pivotSteps (i j : Fin m) : List (Step (m + m) Q) :=
  [.shift (Fin.natAdd m j) 1 (Pi.single (Fin.castAdd m i) 1),
   .swap (Fin.castAdd m i) (Fin.natAdd m j),
   .shift (Fin.natAdd m j) (-1) (Pi.single (Fin.castAdd m i) 1)]

/-- One gadget per pivot, in list order. -/
def addSteps (ps : List (Fin m × Fin m)) : List (Step (m + m) Q) :=
  ps.flatMap fun p => pivotSteps p.1 p.2

/-- The pivots (positions of the ones) of `W`, in lexicographic order. -/
def pivots (W : Matrix (Fin m) (Fin m) (ZMod Q)) : List (Fin m × Fin m) :=
  (List.finRange m ×ˢ List.finRange m).filter fun p => W p.1 p.2 = 1

end Pivot

/-! ## Lemma 10: the shear through Bruhat-type factors -/

section Shear

variable {m Q : ℕ}

/-- Steps for the shear by `A = E₁ W E₂`: `D ← E₂ D`, `H ← E₁⁻¹ H` (the inverse shifts of
`H ← E₁ H`), `H ← H + W D` (one pivot gadget per one of `W`), `H ← E₁ H`, `D ← E₂⁻¹ D`. -/
def shearSteps (E₁ W E₂ : Matrix (Fin m) (Fin m) (ZMod Q)) : List (Step (m + m) Q) :=
  dSteps E₂ ++ revSteps (hSteps E₁) ++ addSteps (pivots W) ++ hSteps E₁ ++ revSteps (dSteps E₂)

variable {E₁ W E₂ : Matrix (Fin m) (Fin m) (ZMod Q)}

variable {sh : Shape} (Λ : Layout sh (m + m) Q) [NeZero Q]

end Shear

/-! ## Interchange from a shear (end of Prop. 11) -/

section Interchange

variable {m Q : ℕ}

/-- The shift `D_j ← u D_j + c H_j`. -/
def dhStep (u c : ZMod Q) (j : Fin m) : Step (m + m) Q :=
  .shift (Fin.natAdd m j) u (Pi.single (Fin.castAdd m j) c)

/-- `D ← D − H`, one shift per `D` field. -/
def subSteps (m : ℕ) : List (Step (m + m) Q) := (List.finRange m).map (dhStep 1 (-1))

/-- `D ← H − D`, one shift per `D` field. -/
def flipSteps (m : ℕ) : List (Step (m + m) Q) := (List.finRange m).map (dhStep (-1) 1)

variable {sh : Shape} (Λ : Layout sh (m + m) Q) [NeZero Q]

end Interchange

end AModel

end

section
-- Source module: Solutions.AModelNet
/-!
# Row streams and the gate network (Stage 3 of the interchange procedure)

1. Cyclic row split / merge (primitive (b)) on shapes `P :: (W * L) :: rest`:
   row `r = W * g + w` of the big array becomes row `g` of stream `w`.
2. The abstract network theorem: a circuit of pointwise linear gates, executed physically with
   frame changes `Φ (M_g - label)` on every wire, realizes `Φ I0` on every wire, routed by `ρ`.
3. The combination: split, run the network with `Φ_M = pull` by `π_M` on the `rest` digits, merge
   back with `ρ` undone; this equals the `pull` of the whole array by `π_{I0}` on the `rest` digits.
-/

namespace AModel

open Matrix

/-! ## 1. Cyclic row split and merge -/

section RowSplit

variable {α : Type*}

/-- Stream address `(p, g, x)` ↦ big address `(p, W g + w, x)`. -/
def rowSplitAddr (W w : ℕ) (a : List ℕ) : List ℕ :=
  a.headD 0 :: (W * a.tail.headD 0 + w) :: a.tail.tail

/-- Big address `(p, r, x)` ↦ stream address `(p, r / W, x)`. -/
def rowMergeAddr (W : ℕ) (a : List ℕ) : List ℕ :=
  a.headD 0 :: a.tail.headD 0 / W :: a.tail.tail

/-- The stream (role) of a big address `(p, r, x)`: `r % W`. -/
def rowIdx (W : ℕ) [NeZero W] (a : List ℕ) : Fin W :=
  ⟨a.tail.headD 0 % W, Nat.mod_lt _ (NeZero.pos W)⟩

/-- Lift an address map on the `rest` digits to `(p, r, x) ↦ (p, r, g x)`. -/
def rowLift (g : List ℕ → List ℕ) (a : List ℕ) : List ℕ :=
  a.headD 0 :: a.tail.headD 0 :: g a.tail.tail

/-- Stream `w` of the cyclic row split: rows `r` with `r % W = w`, shape `P :: L :: rest`. -/
def rowSplit (P W L : ℕ) (rest : Shape) (w : Fin W) (d : α) (xs : List α) : List α :=
  pull (P :: W * L :: rest) (P :: L :: rest) (rowSplitAddr W w) d xs

/-- Merge `W` streams of shape `P :: L :: rest` back into shape `P :: (W * L) :: rest`. -/
def rowMerge (P W L : ℕ) [NeZero W] (rest : Shape) (d : α) (s : Fin W → List α) : List α :=
  (List.range (vol (P :: W * L :: rest))).map fun j =>
    (s (rowIdx W (decode (P :: W * L :: rest) j))).getD
      (encode (P :: L :: rest) (rowMergeAddr W (decode (P :: W * L :: rest) j))) d

lemma valid_cons2 {P Q : ℕ} {sh : Shape} {a : List ℕ} (h : Valid (P :: Q :: sh) a) :
    ∃ p q x, a = p :: q :: x ∧ p < P ∧ q < Q ∧ Valid sh x := by
  unfold Valid at h
  rcases h with _ | ⟨hp, h'⟩
  rcases h' with _ | ⟨hq, hx⟩
  exact ⟨_, _, _, rfl, hp, hq, hx⟩

lemma valid_cons2_mk {P Q : ℕ} {sh : Shape} {p q : ℕ} {x : List ℕ} (hp : p < P) (hq : q < Q)
    (hx : Valid sh x) : Valid (P :: Q :: sh) (p :: q :: x) :=
  List.Forall₂.cons hp (List.Forall₂.cons hq hx)

lemma valid_rowLift {P L : ℕ} {rest : Shape} {g : List ℕ → List ℕ}
    (hg : ∀ x, Valid rest x → Valid rest (g x)) {a : List ℕ}
    (ha : Valid (P :: L :: rest) a) : Valid (P :: L :: rest) (rowLift g a) := by
  obtain ⟨p, q, x, rfl, hp, hq, hx⟩ := valid_cons2 ha
  exact valid_cons2_mk hp hq (hg x hx)

end RowSplit

/-! ## 2. The abstract network theorem -/

section Network

variable {Wr Ω R M : Type*} [CommRing R] [Fintype Wr] [DecidableEq Wr] [AddGroup M]

/-- A gate: matrix over `R` on the wires, the set of touched wires, and the gate's label. -/
abbrev NGate (Wr R M : Type*) := Matrix Wr Wr R × Finset Wr × M

/-- A gate acts as the identity off its touched set and touched rows only read touched wires. -/
def NGate.OK (g : NGate Wr R M) : Prop :=
  ∀ w w', (w ∉ g.2.1 → g.1 w w' = if w = w' then 1 else 0) ∧
    (w ∈ g.2.1 → w' ∉ g.2.1 → g.1 w w' = 0)

/-- Physical execution of one gate: on each touched wire apply the frame change
`Φ (M_g - current label)`, then the gate pointwise; touched wires get label `M_g`. -/
def physStep (Φ : M → (Ω → R) →ₗ[R] (Ω → R)) (st : (Wr → M) × (Wr → Ω → R))
    (g : NGate Wr R M) : (Wr → M) × (Wr → Ω → R) :=
  (fun w => if w ∈ g.2.1 then g.2.2 else st.1 w,
   fun w => if w ∈ g.2.1 then ∑ w' ∈ g.2.1, g.1 w w' • Φ (g.2.2 - st.1 w') (st.2 w')
     else st.2 w)

/-- The physical network: start with labels `Min`, run all gates, finish with `Φ (Mout - label)`. -/
def netRun (Φ : M → (Ω → R) →ₗ[R] (Ω → R)) (gates : List (NGate Wr R M)) (Min Mout : Wr → M)
    (f : Wr → Ω → R) : Wr → Ω → R :=
  fun w => Φ (Mout w - (gates.foldl (physStep Φ) (Min, f)).1 w)
    ((gates.foldl (physStep Φ) (Min, f)).2 w)

/-- Logical (frame-free) gate on streams. -/
def logStep (h : Wr → Ω → R) (g : NGate Wr R M) : Wr → Ω → R :=
  fun w => ∑ w', g.1 w w' • h w'

/-- The scalar circuit. -/
def scalarRun (gates : List (NGate Wr R M)) (v : Wr → R) : Wr → R :=
  gates.foldl (fun v g => g.1 *ᵥ v) v

lemma physStep_inv (Φ : M → (Ω → R) →ₗ[R] (Ω → R))
    (hadd : ∀ a b x, Φ (a + b) x = Φ a (Φ b x))
    (st : (Wr → M) × (Wr → Ω → R)) (h : Wr → Ω → R) (hst : ∀ w, st.2 w = Φ (st.1 w) (h w))
    (g : NGate Wr R M) (hg : g.OK) :
    ∀ w, (physStep Φ st g).2 w = Φ ((physStep Φ st g).1 w) (logStep h g w) := by
  intro w
  simp only [physStep, logStep]
  by_cases hw : w ∈ g.2.1
  · simp only [hw, if_true, map_sum, map_smul]
    rw [← Finset.sum_subset (Finset.subset_univ g.2.1)]
    · refine Finset.sum_congr rfl fun w' _ => ?_
      rw [hst w', ← hadd, sub_add_cancel]
    · intro w' _ hw'
      simp [(hg w w').2 hw hw']
  · simp only [hw, if_false]
    rw [Finset.sum_eq_single w, hst w]
    · simp [(hg w w).1 hw]
    · intro b _ hb; simp [(hg w b).1 hw, Ne.symm hb]
    · simp

lemma physRun_inv (Φ : M → (Ω → R) →ₗ[R] (Ω → R))
    (hadd : ∀ a b x, Φ (a + b) x = Φ a (Φ b x))
    (gates : List (NGate Wr R M)) (hg : ∀ g ∈ gates, g.OK) :
    ∀ (st : (Wr → M) × (Wr → Ω → R)) (h : Wr → Ω → R), (∀ w, st.2 w = Φ (st.1 w) (h w)) →
      ∀ w, (gates.foldl (physStep Φ) st).2 w =
        Φ ((gates.foldl (physStep Φ) st).1 w) (gates.foldl logStep h w) := by
  induction gates with
  | nil => intro st h hst; simpa using hst
  | cons g gs ih =>
    intro st h hst
    simp only [List.foldl_cons]
    exact ih (fun g' hg' => hg g' (List.mem_cons_of_mem _ hg')) _ _
      (physStep_inv Φ hadd st h hst g (hg g List.mem_cons_self))

omit [DecidableEq Wr] [AddGroup M] in
lemma logRun_apply (gates : List (NGate Wr R M)) :
    ∀ (h : Wr → Ω → R) (w : Wr) (ω : Ω),
      gates.foldl logStep h w ω = scalarRun gates (fun w => h w ω) w := by
  induction gates with
  | nil => intro h w ω; rfl
  | cons g gs ih =>
    intro h w ω
    simp only [List.foldl_cons, scalarRun] at ih ⊢
    rw [ih]
    have : (fun w => logStep h g w ω) = g.1 *ᵥ fun w => h w ω := by
      funext w'
      simp [logStep, Matrix.mulVec, dotProduct, Finset.sum_apply]
    rw [this]

end Network

/-! ## 3. The full procedure: split, network with pull frames, merge with `ρ` undone -/

section Combine

/-- The address bijection candidate on `Fin (vol sh)` induced by a valid-preserving address map. -/
def addrPerm (sh : Shape) (G : List ℕ → List ℕ) (hG : ∀ a, Valid sh a → Valid sh (G a)) :
    Fin (vol sh) → Fin (vol sh) :=
  fun j => ⟨encode sh (G (decode sh j)), encode_lt (hG _ (valid_decode j.isLt))⟩

/-- The stream frame action: `Φ_m` = pull by `π m` on the `rest` digits, as a linear map on
streams `Fin (vol (P :: L :: rest)) → R`. -/
def streamΦ {R M : Type*} [CommRing R] (P L : ℕ) (rest : Shape) (π : M → List ℕ → List ℕ)
    (hπv : ∀ m x, Valid rest x → Valid rest (π m x)) (m : M) :
    (Fin (vol (P :: L :: rest)) → R) →ₗ[R] (Fin (vol (P :: L :: rest)) → R) :=
  LinearMap.funLeft R R (addrPerm (P :: L :: rest) (rowLift (π m))
    (fun _ ha => valid_rowLift (hπv m) ha))

end Combine

end AModel

end

