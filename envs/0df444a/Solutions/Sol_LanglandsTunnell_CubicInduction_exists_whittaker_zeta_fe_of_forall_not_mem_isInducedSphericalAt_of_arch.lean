variable (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

private theorem isUnramifiedCharAt_comp_idelicNorm (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (𝔓 : HeightOneSpectrum (𝓞 K))
    (hχ : IsUnramifiedCharAt χ (𝔓.under (𝓞 ℚ))) :
    IsUnramifiedCharAt (χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  refine isUnramifiedCharAt_of_hasConductorExponentAt_zero ?_
  have h := localChar_mul_comp_idelicNorm_genuineBaseChange ℚ K 1 χ (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩
  rw [one_mul_hom, localChar_one, one_mul_hom] at h
  rw [show localChar (χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 = _ from h]
  exact hasConductorExponentAt_comp_norm_zero ℚ K (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩ _
    (hasConductorExponentAt_zero_of_isUnramifiedCharAt hχ)

private theorem forall_mem_primeFibre_isUnramifiedCharAt_comp_idelicNorm (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (v : HeightOneSpectrum (𝓞 ℚ)) (hχ : IsUnramifiedCharAt χ v) :
    ∀ 𝔓 ∈ primeFibre ℚ K v, IsUnramifiedCharAt (χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 := by
  intro 𝔓 h𝔓
  refine isUnramifiedCharAt_comp_idelicNorm K χ 𝔓 ?_
  rw [(mem_primeFibre ℚ v 𝔓).mp h𝔓]
  exact hχ

end LanglandsTunnell.CubicInduction.NormUnramified
