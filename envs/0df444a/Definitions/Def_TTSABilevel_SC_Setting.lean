-- title:
--   Problem (1), Algorithm 1 and Assumptions 1–3: the TTSA setting
-- statement:
--   Let $X\subseteq\mathbb R^{d_1}$ be the outer feasible set, $f$ the outer objective, and $g$ the inner objective. For $x\in X$, an inner solution $y^\star(x)$ minimizes $g(x,\cdot)$, and the composite objective is $\ell(x)=f(x,y^\star(x))$. The surrogate gradient is
--
--   $$
--   \bar\nabla_x f(x,y)=\nabla_x f(x,y)-\nabla^2_{xy}g(x,y)[\nabla^2_{yy}g(x,y)]^{-1}\nabla_y f(x,y),\qquad \nabla\ell(x)=\bar\nabla_x f(x,y^\star(x)).
--   $$
--
--   The file also defines the constants $L,L_y$ of (13), the bounded supremum $\widetilde\sigma_f^2$ of (14), the weak convexity inequality (2), the filtrations $\mathcal F_k,\mathcal F'_k$, and Algorithm 1 with Assumptions 1–3. Its two errors are $\Delta_x^k=\mathbb E\|x^k-x^\star\|^2$ and $\Delta_y^k=\mathbb E\|y^k-y^\star(x^{k-1})\|^2$.
--
--   These definitions provide the shared model for the mission’s theorem and milestones.
--
--   **Formalization Note** The spaces are finite Euclidean spaces; partial Hessian blocks are continuous linear maps and the inverse is their operator inverse. The run starts deterministically and assumes measurable, square-integrable stochastic estimates. Conditional expectations use the sigma-algebras generated by the iterates. The convention $x^{-1}=x^0$ is implemented by natural-number subtraction at $k=0$.
-- source:
--   Hong, Wai, Wang & Yang, A Two-Timescale Stochastic Algorithm Framework for Bilevel Optimization: Complexity Analysis and Application to Actor-Critic, arXiv:2007.05170v4, pp. 1, 4–8, 9, 20–21, (1), (2), (4a)–(7c), Assumptions 1–3, (13), (14), (17), (48), (55)

import Mathlib
import Definitions.Def_SpectralProjGrad_Shared_IsProjOnto

open MeasureTheory
open scoped BigOperators

namespace TTSABilevel.SC

noncomputable section

abbrev E1 (d : ℕ) := EuclideanSpace ℝ (Fin d)
abbrev E2 (d : ℕ) := EuclideanSpace ℝ (Fin d)

def gradX {d1 d2 : ℕ} (f : E1 d1 → E2 d2 → ℝ) (x : E1 d1) (y : E2 d2) : E1 d1 :=
  gradient (fun x' => f x' y) x

def gradY {d1 d2 : ℕ} (f : E1 d1 → E2 d2 → ℝ) (x : E1 d1) (y : E2 d2) : E2 d2 :=
  gradient (fun y' => f x y') y

def hessYY {d1 d2 : ℕ} (g : E1 d1 → E2 d2 → ℝ) (x : E1 d1) (y : E2 d2) :
    E2 d2 →L[ℝ] E2 d2 :=
  fderiv ℝ (fun y' => gradY g x y') y

def hessXY {d1 d2 : ℕ} (g : E1 d1 → E2 d2 → ℝ) (x : E1 d1) (y : E2 d2) :
    E2 d2 →L[ℝ] E1 d1 :=
  fderiv ℝ (fun y' => gradX g x y') y

def surr {d1 d2 : ℕ} (f g : E1 d1 → E2 d2 → ℝ) (x : E1 d1) (y : E2 d2) : E1 d1 :=
  gradX f x y - hessXY g x y (Ring.inverse (hessYY g x y) (gradY f x y))

def IsInnerSol {d1 d2 : ℕ} (g : E1 d1 → E2 d2 → ℝ) (X : Set (E1 d1))
    (ystar : E1 d1 → E2 d2) : Prop :=
  ∀ x ∈ X, ∀ y, g x (ystar x) ≤ g x y

def ell {d1 d2 : ℕ} (f : E1 d1 → E2 d2 → ℝ) (ystar : E1 d1 → E2 d2)
    (x : E1 d1) : ℝ := f x (ystar x)

def gradEll {d1 d2 : ℕ} (f g : E1 d1 → E2 d2 → ℝ) (ystar : E1 d1 → E2 d2)
    (x : E1 d1) : E1 d1 := surr f g x (ystar x)

structure Asm1 {d1 d2 : ℕ} (f : E1 d1 → E2 d2 → ℝ) (X : Set (E1 d1))
    (Lfx Lfy Lfybar Cfy : ℝ) : Prop where
  Lfx_nonneg : 0 ≤ Lfx
  Lfy_nonneg : 0 ≤ Lfy
  Lfybar_nonneg : 0 ≤ Lfybar
  Cfy_pos : 0 < Cfy
  gradX_lipschitz_y : ∀ x y y', ‖gradX f x y - gradX f x y'‖ ≤ Lfx * ‖y - y'‖
  gradY_lipschitz_y : ∀ x y y', ‖gradY f x y - gradY f x y'‖ ≤ Lfy * ‖y - y'‖
  gradY_lipschitz_x : ∀ y, ∀ x ∈ X, ∀ x' ∈ X,
    ‖gradY f x y - gradY f x' y‖ ≤ Lfybar * ‖x - x'‖
  gradY_bounded : ∀ x ∈ X, ∀ y, ‖gradY f x y‖ ≤ Cfy

structure Asm2 {d1 d2 : ℕ} (g : E1 d1 → E2 d2 → ℝ) (X : Set (E1 d1))
    (Lg μg Lgxy Lgyy Lgxybar Lgyybar Cgxy : ℝ) : Prop where
  smooth : ContDiff ℝ 2 (Function.uncurry g)
  Lg_nonneg : 0 ≤ Lg
  μg_pos : 0 < μg
  Lgxy_pos : 0 < Lgxy
  Lgyy_pos : 0 < Lgyy
  Lgxybar_pos : 0 < Lgxybar
  Lgyybar_pos : 0 < Lgyybar
  Cgxy_pos : 0 < Cgxy
  gradY_lipschitz_y : ∀ x ∈ X, ∀ y y', ‖gradY g x y - gradY g x y'‖ ≤ Lg * ‖y - y'‖
  strong_convex : ∀ x ∈ X, StrongConvexOn Set.univ μg (g x)
  hessXY_lipschitz_y : ∀ x ∈ X, ∀ y y', ‖hessXY g x y - hessXY g x y'‖ ≤ Lgxy * ‖y - y'‖
  hessYY_lipschitz_y : ∀ x ∈ X, ∀ y y', ‖hessYY g x y - hessYY g x y'‖ ≤ Lgyy * ‖y - y'‖
  hessXY_lipschitz_x : ∀ y, ∀ x ∈ X, ∀ x' ∈ X,
    ‖hessXY g x y - hessXY g x' y‖ ≤ Lgxybar * ‖x - x'‖
  hessYY_lipschitz_x : ∀ y, ∀ x ∈ X, ∀ x' ∈ X,
    ‖hessYY g x y - hessYY g x' y‖ ≤ Lgyybar * ‖x - x'‖
  hessXY_bounded : ∀ x ∈ X, ∀ y, ‖hessXY g x y‖ ≤ Cgxy

def WeaklyConvexWith {d1 : ℕ} (X : Set (E1 d1)) (v : E1 d1 → ℝ)
    (D : E1 d1 → E1 d1) (μ : ℝ) : Prop :=
  ∀ w ∈ X, ∀ z ∈ X, v z + inner ℝ (D z) (w - z) + μ * ‖w - z‖ ^ 2 ≤ v w

def Lconst (Lfx Lfy Cgxy μg Cfy Lgxy Lgyy : ℝ) : ℝ :=
  Lfx + Lfy * Cgxy / μg + Cfy * (Lgxy / μg + Lgyy * Cgxy / μg ^ 2)

def Lyconst (Cgxy μg : ℝ) : ℝ := Cgxy / μg

def sigTilde2 {d1 d2 : ℕ} (σf : ℝ) (X : Set (E1 d1))
    (f g : E1 d1 → E2 d2 → ℝ) (ystar : E1 d1 → E2 d2) : ℝ :=
  σf ^ 2 + 3 * sSup ((fun z : E1 d1 => ‖gradEll f g ystar z‖ ^ 2) '' X)

def Fk {d1 d2 : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (x : ℕ → Ω → E1 d1) (y : ℕ → Ω → E2 d2) (k : ℕ) : MeasurableSpace Ω :=
  ⨆ j ∈ Finset.range (k + 1),
    (MeasurableSpace.comap (x j) inferInstance ⊔ MeasurableSpace.comap (y j) inferInstance)

def Fk' {d1 d2 : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (x : ℕ → Ω → E1 d1) (y : ℕ → Ω → E2 d2) (k : ℕ) : MeasurableSpace Ω :=
  Fk x y k ⊔ MeasurableSpace.comap (y (k + 1)) inferInstance

structure IsTTSARun {d1 d2 : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (X : Set (E1 d1)) (proj : E1 d1 → E1 d1)
    (α β : ℕ → ℝ) (x0 : E1 d1) (y0 : E2 d2)
    (x : ℕ → Ω → E1 d1) (y : ℕ → Ω → E2 d2)
    (hg : ℕ → Ω → E2 d2) (hf : ℕ → Ω → E1 d1) : Prop where
  start_mem : x0 ∈ X
  projection : SpectralProjGrad.Shared.IsProjOnto X proj
  x_start : ∀ ω, x 0 ω = x0
  y_start : ∀ ω, y 0 ω = y0
  y_step : ∀ k ω, y (k + 1) ω = y k ω - β k • hg k ω
  x_step : ∀ k ω, x (k + 1) ω = proj (x k ω - α k • hf k ω)
  hg_measurable : ∀ k, Measurable (hg k)
  hf_measurable : ∀ k, Measurable (hf k)
  hg_sq_integrable : ∀ k, Integrable (fun ω => ‖hg k ω‖ ^ 2) P
  hf_sq_integrable : ∀ k, Integrable (fun ω => ‖hf k ω‖ ^ 2) P

structure Asm3 {d1 d2 : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (f g : E1 d1 → E2 d2 → ℝ) (ystar : E1 d1 → E2 d2)
    (x : ℕ → Ω → E1 d1) (y : ℕ → Ω → E2 d2)
    (hg : ℕ → Ω → E2 d2) (hf B : ℕ → Ω → E1 d1)
    (σg σf : ℝ) (b : ℕ → ℝ) : Prop where
  b_antitone : Antitone b
  B_measurable : ∀ k, Measurable (B k)
  B_bounded : ∀ k, ∀ᵐ ω ∂P, ‖B k ω‖ ≤ b k
  hg_mean : ∀ k, P[hg k|Fk x y k] =ᵐ[P] fun ω => gradY g (x k ω) (y k ω)
  hf_mean : ∀ k, P[hf k|Fk' x y k] =ᵐ[P] fun ω => surr f g (x k ω) (y (k + 1) ω) + B k ω
  hg_variance : ∀ k,
    P[fun ω => ‖hg k ω - gradY g (x k ω) (y k ω)‖ ^ 2|Fk x y k] ≤ᵐ[P]
      fun ω => σg ^ 2 * (1 + ‖gradY g (x k ω) (y k ω)‖ ^ 2)
  hf_variance : ∀ k,
    P[fun ω => ‖hf k ω - B k ω - surr f g (x k ω) (y (k + 1) ω)‖ ^ 2|Fk' x y k] ≤ᵐ[P]
      fun _ => σf ^ 2

def Dx {d1 : ℕ} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (x : ℕ → Ω → E1 d1) (xstar : E1 d1) (k : ℕ) : ℝ :=
  ∫ ω, ‖x k ω - xstar‖ ^ 2 ∂P

def Dy {d1 d2 : ℕ} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (ystar : E1 d1 → E2 d2) (x : ℕ → Ω → E1 d1) (y : ℕ → Ω → E2 d2)
    (k : ℕ) : ℝ :=
  ∫ ω, ‖y k ω - ystar (x (k - 1) ω)‖ ^ 2 ∂P

def G1 (β : ℕ → ℝ) (μg : ℝ) (m n : ℕ) : ℝ :=
  ∏ i ∈ Finset.Icc m n, (1 - β i * μg / 4)

def G2 (α : ℕ → ℝ) (μℓ : ℝ) (m n : ℕ) : ℝ :=
  ∏ i ∈ Finset.Icc m n, (1 - α i * μℓ)

def Cy1 {d1 d2 : ℕ} (μg σg c0 Cgxy σf : ℝ) (b : ℕ → ℝ)
    (X : Set (E1 d1)) (f g : E1 d1 → E2 d2 → ℝ)
    (ystar : E1 d1 → E2 d2) : ℝ :=
  8 / μg * (σg ^ 2 + 4 * c0 ^ 2 * (Lyconst Cgxy μg) ^ 2 / μg *
    (sigTilde2 σf X f g ystar + 3 * b 0 ^ 2))

end
end TTSABilevel.SC


