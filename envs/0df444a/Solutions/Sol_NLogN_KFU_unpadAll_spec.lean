variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem unpadAll_spec_aux (S T : AModel.Shape) (hF : List.Forall₂ (· ≤ ·) S T) (hS : ∀ a ∈ S, 1 ≤ a)
    (w : ℕ) (ys : List ℤ) (hys : ys.length = AModel.vol T) (hb : NLogN.Bnd w ys) (s : NLogN.IState NLogN.HS)
    (R : List NLogN.Item) (h0 : s.G 0 = NLogN.ints ys ++ R) :
    ∀ k ≤ S.length, NLogN.IRuns I iprog (NLogN.KFU.unpadAllC S T k) s
      (s.upd 0 (NLogN.ints (AModelL12.extract (S.take k ++ T.drop k) T 0 ys) ++ R)) (k * NLogN.KFU.cScan (AModel.vol T) w + 1) 
  | 0, _ => by
    simp only [NLogN.KFU.unpadAllC, List.take_zero, List.drop_zero, List.nil_append, AModelL12.extract,
      AModel.pull_id 0 hys]
