  apply Meets.of_body C.main
  unfold body time
  refine
    Ends.for (Inv μ h J cut occ maps candidates histL histR sourceHistL sourceHistR base count (p : ℤ) shift B b A a q)
      count (LightBlockSourceBatchStep.time h J cut + 192) ?start ?round ?done ?bound
  case start =>
    refine ⟨0, μ, ?_, ?_, fun _ _ => rfl⟩
    · exact congrArg (fun loc => (⟨loc, μ⟩ : State)) ((update_frame_setLocal _ _ _).trans (frame_append_zeros _ 1).symm)
