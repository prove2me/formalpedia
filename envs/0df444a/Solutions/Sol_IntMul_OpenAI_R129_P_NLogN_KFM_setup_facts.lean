theorem solution {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) :
    8192 ≤ IntMul.OpenAI.Glue.bP n ∧ 1 ≤ IntMul.OpenAI.R129.dP n ∧ IntMul.OpenAI.R129.dP n ≤ IntMul.OpenAI.Glue.bP n ∧ IntMul.OpenAI.R129.dP n ^ 2 ≤ IntMul.OpenAI.Glue.bP n ∧ n ≤ 2 ^ IntMul.OpenAI.Glue.bP n ∧ IntMul.OpenAI.Glue.LP n < IntMul.OpenAI.Glue.bP n ∧
    IntMul.OpenAI.R129.ℓP n ≤ IntMul.OpenAI.Glue.LP n ∧ 64 * IntMul.OpenAI.R129.dP n ^ 2 * (256 * IntMul.OpenAI.R129.dP n ^ 2).factorial ≤ IntMul.OpenAI.R129.rP n ∧ IntMul.OpenAI.R129.rP n ≤ 2 ^ IntMul.OpenAI.Glue.bP n ∧
    12 * IntMul.OpenAI.R129.dP n ^ 2 * IntMul.OpenAI.Glue.bP n ≤ 2 ^ IntMul.OpenAI.Glue.bP n ∧ 64 ≤ IntMul.OpenAI.R129.rP n ∧ NLogN.KFM.srcQ (IntMul.OpenAI.R129.dP n) (IntMul.OpenAI.R129.rP n) ≤ 3 * 2 ^ IntMul.OpenAI.Glue.bP n := by
  obtain ⟨-, -, hb, hd1, hdb, -, hLb, -, -, -, -, -, hbig, -⟩ := IntMul.OpenAI.R129.P.IntMul.OpenAI.Glue.params_ok hn
  have hd2 : IntMul.OpenAI.R129.dP n ^ 2 ≤ IntMul.OpenAI.Glue.bP n :=
    le_trans (Nat.pow_le_pow_right hd1 (by norm_num : 2 ≤ 2 ^ 43)) (IntMul.OpenAI.R129.P.NLogN.KFM.dP_spec n).1
  have hnb : n ≤ 2 ^ IntMul.OpenAI.Glue.bP n :=
    le_trans (Nat.le_pow_clog (by norm_num) n) (Nat.pow_le_pow_right (by norm_num) (le_max_left _ _))
  have hel : IntMul.OpenAI.R129.ℓP n ≤ IntMul.OpenAI.Glue.LP n := by
    obtain ⟨-, h2⟩ := IntMul.OpenAI.RP.ell_spec (IntMul.OpenAI.Glue.LP n) (IntMul.OpenAI.R129.dP n) (by omega)
    unfold IntMul.OpenAI.R129.ℓP
    by_contra hc
    push Not at hc
    have : IntMul.OpenAI.R129.dP n * (IntMul.OpenAI.Glue.LP n + 1) ≤ IntMul.OpenAI.R129.dP n * IntMul.OpenAI.RP.ell (IntMul.OpenAI.Glue.LP n) (IntMul.OpenAI.R129.dP n) := Nat.mul_le_mul_left _ hc
    rw [Nat.mul_add, mul_one] at this
    have : IntMul.OpenAI.Glue.LP n ≤ IntMul.OpenAI.R129.dP n * IntMul.OpenAI.Glue.LP n := Nat.le_mul_of_pos_left _ hd1
    omega
  have hr : IntMul.OpenAI.R129.rP n ≤ 2 ^ IntMul.OpenAI.Glue.bP n := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hF1 : 1 ≤ (256 * IntMul.OpenAI.R129.dP n ^ 2).factorial := Nat.one_le_iff_ne_zero.2 (Nat.factorial_ne_zero _)
  have h1d : 1 ≤ IntMul.OpenAI.R129.dP n ^ 2 := Nat.one_le_pow _ _ hd1
  have hr64 : 64 ≤ IntMul.OpenAI.R129.rP n := by nlinarith
  have hX : 12 * IntMul.OpenAI.R129.dP n ^ 2 * IntMul.OpenAI.Glue.bP n ≤ 2 ^ IntMul.OpenAI.Glue.bP n := by
    have := IntMul.OpenAI.Glue.cube_lt_pow (IntMul.OpenAI.Glue.bP n) (by omega)
    have : IntMul.OpenAI.Glue.bP n ≤ IntMul.OpenAI.Glue.bP n ^ 2 := by nlinarith
    nlinarith
  refine ⟨hb, hd1, hdb, hd2, hnb, hLb, hel, hbig, hr, hX, hr64, ?_⟩
  -- Q ≤ r + 2F
  unfold NLogN.KFM.srcQ
  set F := (256 * IntMul.OpenAI.R129.dP n ^ 2).factorial
  set D := 256 * IntMul.OpenAI.R129.dP n ^ 2
  have hD1 : 1 ≤ D := by omega
  have h1 : 2 * F * (IntMul.OpenAI.R129.rP n / (2 * F * D)) ≤ IntMul.OpenAI.R129.rP n := by
    calc 2 * F * (IntMul.OpenAI.R129.rP n / (2 * F * D)) ≤ 2 * F * D * (IntMul.OpenAI.R129.rP n / (2 * F * D)) :=
          Nat.mul_le_mul_right _ (Nat.le_mul_of_pos_right _ hD1)
      _ ≤ IntMul.OpenAI.R129.rP n := Nat.mul_div_le _ _
  have h2 : 2 * F ≤ IntMul.OpenAI.R129.rP n := by nlinarith
  rw [Nat.mul_add, mul_one]; omega
end
