theorem exists_pow_mul_eq_coe (p : ℕ) [Fact p.Prime] (q : ℚ_[p]) :
    ∃ c : ℕ, ∃ a : ℤ_[p], (p : ℚ_[p]) ^ c * q = (a : ℚ_[p]) := by
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := ℤ_[p]) q
  have hb0 : (b : ℤ_[p]) ≠ 0 := nonZeroDivisors.ne_zero hb
  set u : ℤ_[p]ˣ := unitCoeff hb0 with hu_def
  refine ⟨b.valuation, a * ↑(u⁻¹), ?_⟩
  have hbspec : (b : ℤ_[p]) = (u : ℤ_[p]) * (p : ℤ_[p]) ^ b.valuation := unitCoeff_spec hb0
  have hbQ : (algebraMap ℤ_[p] ℚ_[p] b) = ((u : ℤ_[p]) : ℚ_[p]) * (p : ℚ_[p]) ^ b.valuation := by
    have h := congrArg ((↑) : ℤ_[p] → ℚ_[p]) hbspec
    push_cast at h
    exact h
  have huQ : ((u : ℤ_[p]) : ℚ_[p]) * (((u⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) = 1 := by
    rw [← PadicInt.coe_mul, Units.mul_inv, PadicInt.coe_one]
  have huinv : (((u⁻¹ : ℤ_[p]ˣ) : ℤ_[p]) : ℚ_[p]) = (((u : ℤ_[p]) : ℚ_[p]))⁻¹ :=
    (eq_inv_of_mul_eq_one_right huQ)
  have hp0 : (p : ℚ_[p]) ^ b.valuation ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero)
  rw [show algebraMap ℤ_[p] ℚ_[p] a = ((a : ℤ_[p]) : ℚ_[p]) from rfl, hbQ, PadicInt.coe_mul, huinv]
  calc (p : ℚ_[p]) ^ b.valuation * (((a : ℤ_[p]) : ℚ_[p]) / (((u : ℤ_[p]) : ℚ_[p]) * (p : ℚ_[p]) ^ b.valuation))
      = ((a : ℤ_[p]) : ℚ_[p]) * (((u : ℤ_[p]) : ℚ_[p]))⁻¹ * ((p : ℚ_[p]) ^ b.valuation * ((p : ℚ_[p]) ^ b.valuation)⁻¹) := by
        rw [div_eq_mul_inv, mul_inv_rev]; ring
    _ = ((a : ℤ_[p]) : ℚ_[p]) * (((u : ℤ_[p]) : ℚ_[p]))⁻¹ := by rw [mul_inv_cancel₀ hp0, mul_one]

end PadicInt

