/-!
# B-line axis budget 3: the size facts of the chunk tables (generic)

* `hdr2_bnd`: the block headers `blkHdr2 m b` (`1 ≤ m ≤ λ < 2^Q`) have entries of size `≤ Q + b + 1`;
* `tabK2_bnd`: every entry of the chunk table has size `≤ BH` once `Q + R + b + pk + 4 ≤ BH` and the
  tables `T` are bounded by `2^(Q+R+2)`;
* `tabK2_len`: the chunk table has length `≤ 8 + 10 λ`;
* `tabsT_len`: `|tabsT tab nc| ≤ nc (L + 1)`;
* `kerC_leN`: `kerC` as a polynomial.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

theorem zN {n N B : ℕ} (h : n ≤ N) (hN : N < 2 ^ B) : zsz (n : ℤ) ≤ B :=
  zsz_le_of_lt (by simp only [Int.natAbs_natCast]; omega)

theorem zA {z : ℤ} {B : ℕ} (h : |z| < 2 ^ B) : zsz z ≤ B := by
  apply zsz_le_of_lt
  have : (z.natAbs : ℤ) < 2 ^ B := by rw [Int.natCast_natAbs]; exact h
  exact_mod_cast this

theorem hdr2_bnd {lam b Q BH : ℕ} (hlQ : lam < 2 ^ Q) (hb : 1 ≤ b) (hBH : Q + b + 1 ≤ BH) :
    ∀ m, 1 ≤ m → m ≤ lam → ∀ v ∈ blkHdr2 m b, zsz v ≤ BH := by
  intro m hm1 hml v hv
  have hbb : b < 2 ^ b := Nat.lt_two_pow_self
  have h2 : 2 * lam * b < 2 ^ (Q + b + 1) := by
    have : 2 * lam < 2 ^ (Q + 1) := by rw [pow_succ]; omega
    calc 2 * lam * b < 2 ^ (Q + 1) * 2 ^ b := Nat.mul_lt_mul'' this hbb
      _ = 2 ^ (Q + b + 1) := by rw [← pow_add]; ring_nf
  have hP : 2 ^ (Q + b + 1) ≤ 2 ^ BH := Nat.pow_le_pow_right (by norm_num) hBH
  have hmb : 2 * m ≤ 2 * m * b := Nat.le_mul_of_pos_right _ hb
  have hmL : 2 * m * b ≤ 2 * lam * b := Nat.mul_le_mul_right _ (by omega)
  have hc : Nat.clog 2 (2 * m) ≤ 2 * m := Nat.clog_le_of_le_pow Nat.lt_two_pow_self.le
  simp only [blkHdr2, List.mem_cons, List.not_mem_nil, or_false] at hv
  rcases hv with rfl | rfl | rfl | rfl
  · exact zN (N := 2 * lam * b) (by omega) (by omega)
  · exact zN (N := 2 * lam * b) (by omega) (by omega)
  · exact zN (N := 2 * lam * b) (by omega) (by omega)
  · exact zN (N := 2 * lam * b) hmL (by omega)

section tab
variable {Q R s t lam α pk b BH : ℕ}

theorem tabK2_bnd_sol_aux (hl : 1 ≤ lam) (hlQ : lam < 2 ^ Q) (hb : 1 ≤ b)
    (hT : ∀ u < lam, |(TT Q R s t α).di u| ≤ 2 ^ (Q + R + 2) ∧
      |(TT Q R s t α).gi u| ≤ 2 ^ (Q + R + 2) ∧ |(TT Q R s t α).gam u| ≤ 2 ^ (Q + R + 2) ∧
      |(TT Q R s t α).dd u| ≤ 2 ^ (Q + R + 2) ∧
      ∀ c, |(TT Q R s t α).am c u| ≤ 2 ^ (Q + R + 2) ∧ |(TT Q R s t α).ap c u| ≤ 2 ^ (Q + R + 2))
    (hBH : Q + R + b + pk + 4 ≤ BH) (q : ℕ) :
    ∀ v ∈ tabK2 Q pk b lam (diL Q R s t lam α) (giL Q R s t lam α) (gamL Q R s t lam α)
      (ddL Q R s t lam α) (descsOf s t lam (TT Q R s t α) q), zsz v ≤ BH := by
  have hds := descsOf_ok (s := s) (t := t) hl (TT Q R s t α) q
  have hE := length_dsEnc2 b (descsOf s t lam (TT Q R s t α) q)
    (fun d hd => ⟨(hds d hd).2.1, (hds d hd).2.2.1⟩)
  have hn := length_le_sumN (descsOf s t lam (TT Q R s t α) q) (fun d hd => (hds d hd).1)
  have hs := sumN_descsOf (s := s) (t := t) hl (TT Q R s t α) q
  have hPw : ∀ {e : ℕ}, e ≤ BH → (2 : ℕ) ^ e ≤ 2 ^ BH := fun h => Nat.pow_le_pow_right (by norm_num) h
  have hQ1 : (2 : ℕ) ^ Q ≤ 2 ^ BH := hPw (by omega)
  have hQ4 : (2 : ℕ) ^ (Q + 4) ≤ 2 ^ BH := hPw (by omega)
  have e4 : (2 : ℕ) ^ (Q + 4) = 16 * 2 ^ Q := by rw [pow_add]; ring
  -- the bound on a table entry
  have hA : ∀ z : ℤ, |z| ≤ 2 ^ (Q + R + 2) → zsz z ≤ BH := by
    intro z hz
    apply zA
    have : (2 : ℤ) ^ (Q + R + 2) < 2 ^ BH :=
      pow_lt_pow_right₀ (by norm_num) (by omega)
    linarith
  have hL : ∀ (f : ℕ → ℤ), (∀ u < lam, |f u| ≤ 2 ^ (Q + R + 2)) →
      ∀ v ∈ ((List.range lam).map f).reverse, zsz v ≤ BH := by
    intro f hf v hv
    rw [List.mem_reverse] at hv
    obtain ⟨u, hu, rfl⟩ := List.mem_map.1 hv
    exact hA _ (hf u (List.mem_range.1 hu))
  intro v hv
  simp only [tabK2, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hv
  rcases hv with ((((((rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl) | hv) | hv) | hv) | hv) | hv)
  · exact zN (N := lam) le_rfl (by omega)
  · rw [zsz_two_pow]; omega
  · rw [zsz_two_pow]; omega
  · exact zN (N := lam) (by omega) (by omega)
  · exact zN (N := 8 + 10 * lam) (by omega) (by omega)
  · rw [zsz_two_pow]; omega
  · rw [zsz_two_pow]; omega
  · exact zN (N := 2 * lam) (by omega) (by omega)
  · exact hL _ (fun u hu => (hT u hu).1) v hv
  · exact hL _ (fun u hu => (hT u hu).2.1) v hv
  · exact hL _ (fun u hu => (hT u hu).2.2.1) v hv
  · exact hL _ (fun u hu => (hT u hu).2.2.2.1) v hv
  · unfold dsEnc2 at hv
    obtain ⟨d, hd, hv⟩ := List.mem_flatMap.1 hv
    obtain ⟨h1, -, -, h4, h5, h6⟩ := hds d hd
    simp only [encD2, List.mem_append] at hv
    rcases hv with (hv | hv) | hv
    · exact hdr2_bnd hlQ hb (by omega) d.1 h1 h4 v hv
    · obtain ⟨h, hh, c', rfl⟩ := h5 v hv
      exact hA _ ((hT h (by omega)).2.2.2.2 c').1
    · obtain ⟨h, hh, c', rfl⟩ := h6 v hv
      exact hA _ ((hT h (by omega)).2.2.2.2 c').2

end tab

end J6Seg.KR

