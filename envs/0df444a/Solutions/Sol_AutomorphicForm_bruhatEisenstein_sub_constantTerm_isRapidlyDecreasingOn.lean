    norm_iteratedFDeriv_clm_clamp_le hh hT Complex.imCLM norm_imCLM_le_one hη ha hb i

private theorem norm_iteratedFDeriv_re_clamp_le {h : ℝ → ℂ} (hh : ContDiff ℝ ∞ h)
    (hT : ∀ (i : ℕ) (t : ℝ), ‖iteratedFDeriv ℝ i h t‖ ≤ hatTower g i) {a b η : ℝ} (hη : 0 < η)
    (ha : a < 0) (hb : 0 < b) (i : ℕ) :
    ‖iteratedFDeriv ℝ i (fun t : ℝ => (h (chartClamp a b η t)).re) 0‖ ≤ hatTower g i := by
  simpa only [Complex.reCLM_apply] using
    norm_iteratedFDeriv_clm_clamp_le hh hT Complex.reCLM norm_reCLM_le_one hη ha hb i

private theorem sqrt_half_add_lt_one {m : ℝ} (hm : 0 < m) (hm' : m < 1 / 2) :
    Real.sqrt (1 / 2 + m) < 1 :=
  calc Real.sqrt (1 / 2 + m) < Real.sqrt 1 := Real.sqrt_lt_sqrt (by positivity) (by linarith)
    _ = 1 := Real.sqrt_one

private theorem contDiffOn_neg_arcsin_margin {m : ℝ} (hm : 0 < m) (hm' : m < 1 / 2) :
    ContDiffOn ℝ ∞ (fun y : ℝ => -Real.arcsin y)
      (Set.Icc (-Real.sqrt (1 / 2 + m)) (Real.sqrt (1 / 2 + m))) := by
  have hc1 := sqrt_half_add_lt_one hm hm'
  refine (Real.contDiffOn_arcsin.mono ?_).neg
  intro y hy
  simp only [Set.mem_compl_iff, Set.mem_insert_iff, Set.mem_singleton_iff, not_or]
  constructor <;> intro hy' <;> subst hy' <;> linarith [hy.1, hy.2]

private theorem exists_arcsin_margin_bound {m : ℝ} (hm : 0 < m) (hm' : m < 1 / 2) (n : ℕ) :
    ∃ Arc : ℝ, 0 ≤ Arc ∧ ∀ i ≤ n, ∀ y ∈ Set.Icc (-Real.sqrt (1 / 2 + m)) (Real.sqrt (1 / 2 + m)),
      ‖iteratedFDerivWithin ℝ i (fun y : ℝ => -Real.arcsin y)
          (Set.Icc (-Real.sqrt (1 / 2 + m)) (Real.sqrt (1 / 2 + m))) y‖ ≤ Arc := by
  have hc : 0 < Real.sqrt (1 / 2 + m) := Real.sqrt_pos.mpr (by positivity)
  exact exists_bound_iteratedFDerivWithin_Icc (neg_lt_self hc) (contDiffOn_neg_arcsin_margin hm hm') n

private theorem norm_iteratedFDeriv_neg_arcsin_comp_le {m : ℝ} (hm : 0 < m) (hm' : m < 1 / 2) {n : ℕ}
    {Arc : ℝ}
    (hArc : ∀ i ≤ n, ∀ y ∈ Set.Icc (-Real.sqrt (1 / 2 + m)) (Real.sqrt (1 / 2 + m)),
      ‖iteratedFDerivWithin ℝ i (fun y : ℝ => -Real.arcsin y)
          (Set.Icc (-Real.sqrt (1 / 2 + m)) (Real.sqrt (1 / 2 + m))) y‖ ≤ Arc)
    {f : ℝ → ℝ} (hf : ContDiff ℝ ∞ f) (hrange : ∀ t : ℝ, |f t| ≤ Real.sqrt (1 / 2 + m))
    (hT : ∀ i : ℕ, ‖iteratedFDeriv ℝ i f 0‖ ≤ hatTower g i) {k : ℕ} (hk : k ≤ n) :
    ‖iteratedFDeriv ℝ k (fun t : ℝ => -Real.arcsin (f t)) 0‖ ≤ k ! * Arc * hatD g n ^ k := by
  have hc : 0 < Real.sqrt (1 / 2 + m) := Real.sqrt_pos.mpr (by positivity)
  have hcomp : (fun t : ℝ => -Real.arcsin (f t)) = (fun y : ℝ => -Real.arcsin y) ∘ f := rfl

  have hmem : ∀ t : ℝ, f t ∈ Set.Icc (-Real.sqrt (1 / 2 + m)) (Real.sqrt (1 / 2 + m)) := fun t =>
    Set.mem_Icc.mpr (abs_le.mp (hrange t))
  have ht : Set.range f ⊆ Set.Icc (-Real.sqrt (1 / 2 + m)) (Real.sqrt (1 / 2 + m)) :=
    Set.range_subset_iff.mpr hmem
  have hC : ∀ i, i ≤ k → ‖iteratedFDerivWithin ℝ i (fun y : ℝ => -Real.arcsin y)
      (Set.Icc (-Real.sqrt (1 / 2 + m)) (Real.sqrt (1 / 2 + m))) (f 0)‖ ≤ Arc :=
    fun i hi => hArc i (hi.trans hk) (f 0) (hmem 0)
  have hD : ∀ i, 1 ≤ i → i ≤ k → ‖iteratedFDeriv ℝ i f 0‖ ≤ hatD g n ^ i :=
    fun i hi1 hik => (hT i).trans (hatTower_le_hatD_pow g hi1 (hik.trans hk))
  rw [hcomp]
  exact norm_iteratedFDeriv_comp_le' ht (uniqueDiffOn_Icc (neg_lt_self hc))
    (contDiffOn_neg_arcsin_margin hm hm') hf (by exact_mod_cast le_top) 0 hC hD

private theorem abs_im_linePhat_clamp_le (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) {m a b η : ℝ} (hη : 0 < η)
    (hab : a ≤ b) (hguard : ∀ u ∈ Set.Icc (a - η) (b + η), 1 / 2 - m ≤ lineQSq g z₀ θ u) (t : ℝ) :
    |(linePhat g z₀ θ (chartClamp a b η t)).im| ≤ Real.sqrt (1 / 2 + m) := by
  have hq := hguard _ (chartClamp_mem hη hab t)
  have hsum := normSq_linePhat_add_lineQSq hg z₀ θ (chartClamp a b η t)
  have him := Complex.im_sq_le_normSq (linePhat g z₀ θ (chartClamp a b η t))
  rw [← Real.sqrt_sq_eq_abs]
  exact Real.sqrt_le_sqrt (by rw [sq]; linarith)

private theorem abs_im_lineQhat_clamp_le (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) {m a b η : ℝ} (hη : 0 < η)
    (hab : a ≤ b)
    (hguard : ∀ u ∈ Set.Icc (a - η) (b + η), 1 / 2 - m ≤ normSq (linePhat g z₀ θ u)) (t : ℝ) :
    |(lineQhat g z₀ θ (chartClamp a b η t)).im| ≤ Real.sqrt (1 / 2 + m) := by
  have hp := hguard _ (chartClamp_mem hη hab t)
  have hsum := normSq_linePhat_add_lineQSq hg z₀ θ (chartClamp a b η t)
  simp only [lineQSq] at hsum
  have him := Complex.im_sq_le_normSq (lineQhat g z₀ θ (chartClamp a b η t))
  rw [← Real.sqrt_sq_eq_abs]
  exact Real.sqrt_le_sqrt (by rw [sq]; linarith)

private theorem exists_deltaQ_tower_bound {m : ℝ} (hm : 0 < m) (hm' : m < 1 / 2) (n : ℕ) :
    ∃ Arc : ℝ, 0 ≤ Arc ∧ ∀ {g : Matrix (Fin 2) (Fin 2) ℂ}, g.det ≠ 0 → ∀ (z₀ : ℂ) (θ : ℝ) {a b η : ℝ},
      0 < η → a < 0 → 0 < b → (∀ u ∈ Set.Icc (a - η) (b + η), 1 / 2 - m ≤ lineQSq g z₀ θ u) →
      ∀ k ≤ n, ‖iteratedFDeriv ℝ k
          (fun t : ℝ => -Real.arcsin ((linePhat g z₀ θ (chartClamp a b η t)).im)) 0‖
        ≤ k ! * Arc * hatD g n ^ k := by
  obtain ⟨Arc, hArc0, hArc⟩ := exists_arcsin_margin_bound hm hm' n
  refine ⟨Arc, hArc0, fun {g} hg z₀ θ {a b η} hη ha hb hguard k hk => ?_⟩
  have hf : ContDiff ℝ ∞ fun t : ℝ => (linePhat g z₀ θ (chartClamp a b η t)).im :=
    Complex.imCLM.contDiff.comp ((contDiff_linePhat hg z₀ θ).comp (contDiff_chartClamp a b η))
  exact norm_iteratedFDeriv_neg_arcsin_comp_le hm hm' hArc hf
    (abs_im_linePhat_clamp_le hg z₀ θ hη (ha.le.trans hb.le) hguard)
    (fun i => norm_iteratedFDeriv_im_clamp_le (contDiff_linePhat hg z₀ θ)
      (fun i t => norm_iteratedFDeriv_linePhat_le hg z₀ θ i t) hη ha hb i) hk

private theorem exists_deltaP_tower_bound {m : ℝ} (hm : 0 < m) (hm' : m < 1 / 2) (n : ℕ) :
    ∃ Arc : ℝ, 0 ≤ Arc ∧ ∀ {g : Matrix (Fin 2) (Fin 2) ℂ}, g.det ≠ 0 → ∀ (z₀ : ℂ) (θ : ℝ) {a b η : ℝ},
      0 < η → a < 0 → 0 < b →
      (∀ u ∈ Set.Icc (a - η) (b + η), 1 / 2 - m ≤ normSq (linePhat g z₀ θ u)) →
      ∀ k ≤ n, ‖iteratedFDeriv ℝ k
          (fun t : ℝ => -Real.arcsin ((lineQhat g z₀ θ (chartClamp a b η t)).im)) 0‖
        ≤ k ! * Arc * hatD g n ^ k := by
  obtain ⟨Arc, hArc0, hArc⟩ := exists_arcsin_margin_bound hm hm' n
  refine ⟨Arc, hArc0, fun {g} hg z₀ θ {a b η} hη ha hb hguard k hk => ?_⟩
  have hf : ContDiff ℝ ∞ fun t : ℝ => (lineQhat g z₀ θ (chartClamp a b η t)).im :=
    Complex.imCLM.contDiff.comp ((contDiff_lineQhat hg z₀ θ).comp (contDiff_chartClamp a b η))
  exact norm_iteratedFDeriv_neg_arcsin_comp_le hm hm' hArc hf
    (abs_im_lineQhat_clamp_le hg z₀ θ hη (ha.le.trans hb.le) hguard)
    (fun i => norm_iteratedFDeriv_im_clamp_le (contDiff_lineQhat hg z₀ θ)
      (fun i t => norm_iteratedFDeriv_lineQhat_le hg z₀ θ i t) hη ha hb i) hk

end DeltaTowers
