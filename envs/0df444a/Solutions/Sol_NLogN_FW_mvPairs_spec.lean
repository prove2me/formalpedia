  have a2 := NLogN.FW.spec_pop M NLogN.KO (t.upd NLogN.FW.TMP (.int Z[k].1 :: t.G NLogN.FW.TMP)) Z[k].1
    (.int Z[k].2 :: (NLogN.gints (Z.drop (k + 1)) ++ RK)) (by decide)
    (by simp (config := {decide := true}) [tK]) W w1
  set t2 := (t.upd NLogN.FW.TMP (.int Z[k].1 :: t.G NLogN.FW.TMP)).upd NLogN.KO
    (.int Z[k].2 :: (NLogN.gints (Z.drop (k + 1)) ++ RK)) with ht2
  have a3 := NLogN.FW.spec_push_reg M NLogN.FW.OUT NLogN.KO t2 Z[k].2 (NLogN.gints (Z.drop (k + 1)) ++ RK) (by decide) (by decide) (by simp [ht2]) W w2
  have a4 := NLogN.FW.spec_pop M NLogN.KO (t2.upd NLogN.FW.OUT (.int Z[k].2 :: t2.G NLogN.FW.OUT)) Z[k].2
    (NLogN.gints (Z.drop (k + 1)) ++ RK) (by decide)
    (by simp (config := {decide := true}) [ht2]) W w2
  set t4 := (t2.upd NLogN.FW.OUT (.int Z[k].2 :: t2.G NLogN.FW.OUT)).upd NLogN.KO (NLogN.gints (Z.drop (k + 1)) ++ RK) with ht4
  have a5 := NLogN.FW.spec_push_reg M NLogN.FW.OUT NLogN.FW.TMP t4 Z[k].1 (t.G NLogN.FW.TMP) (by decide) (by decide)
