-- title:
--   (varpi, X₁,…,Xₙ) is regular on R[[X₁,…,Xₙ]]
-- statement:
--   Let $R$ be a commutative ring, let $n$ be a natural number, and let $\varpi$ be an element of $R$ which lies in the monoid of non-zero-divisors of $R$ and is not a unit. Consider the ring $A = R[[X_0,\dots,X_{n-1}]]$ of formal power series in $n$ variables indexed by `Fin n`, regarded as a module over itself, and the list of elements of $A$ consisting of the constant series $\mathrm{C}(\varpi)$ followed by the $n$ variables $X_0,\dots,X_{n-1}$ in order (the list produced from the family `MvPowerSeries.X` on `Fin n`). The assertion is that this list of length $n+1$ is a regular sequence on $A$ in the sense of `RingTheory.Sequence.IsRegular`: it is weakly regular, that is, $\mathrm{C}(\varpi)$ is a non-zero-divisor on $A$ and, for each $i$, multiplication by $X_i$ is injective on the quotient of $A$ by the submodule generated by $\mathrm{C}(\varpi), X_0, \dots, X_{i-1}$; and moreover the quotient of $A$ by the ideal generated by the whole list is non-zero, equivalently $(\varpi, X_0,\dots,X_{n-1}) \neq A$. No hypothesis on $R$ beyond commutativity is imposed: it need be neither local, nor Noetherian, nor a domain.
--
--   This is the standard fact that a non-zero-divisor non-unit of the coefficient ring together with the variables forms a regular sequence in a formal power series ring; for $R$ a discrete valuation ring with uniformiser $\varpi$ it exhibits $(\varpi, X_1,\dots,X_n)$ as a regular system on the patching power series ring. It is used to verify the regular-sequence hypothesis in [`Algebra.PatchingLevel.free_and_ker_eq_span`](thm.html#Algebra.PatchingLevel.free_and_ker_eq_span) and in [`MvPowerSeries.exists_coords_of_quotient_span_finite_free`](thm.html#MvPowerSeries.exists_coords_of_quotient_span_finite_free).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_MvPowerSeries_isRegular_C_cons_X.lean

import Mathlib.RingTheory.MvPowerSeries.Inverse
import Mathlib.RingTheory.Regular.RegularSequence

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

universe u

theorem MvPowerSeries.isRegular_C_cons_X {R : Type u} [CommRing R] (n : ℕ) {ϖ : R}
    (hϖ : ϖ ∈ nonZeroDivisors R) (hu : ¬IsUnit ϖ) :
    RingTheory.Sequence.IsRegular (MvPowerSeries (Fin n) R)
      (MvPowerSeries.C ϖ :: List.ofFn (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) R)) := by sorry
