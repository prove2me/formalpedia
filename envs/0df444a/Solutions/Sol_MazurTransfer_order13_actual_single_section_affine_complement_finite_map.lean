  letI : IsDomain (CoordinateRing R) := Order13ReciprocalInjectionCurveDomains.coordinateRing_isDomain R h104
  have he : p R * (p R + t R) = xCoordinate R * (xCoordinate R + 1) * t R ^ 2 := by
