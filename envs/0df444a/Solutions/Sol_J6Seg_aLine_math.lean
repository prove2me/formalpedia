    le_trans (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hp2 2)) hbig
  have hWp : 12 * (H + m + 3) ≤ 2 ^ ((pP6 P n) / 2) := by nlinarith
  have hsum : d * (12 * m + 11) ≤ 2 ^ ((pP6 P n) / 2) := by
    have : d * (12 * m + 11) ≤ (pP6 P n) * (24 * (pP6 P n) + 11) := Nat.mul_le_mul hdp (by omega)
    nlinarith
  -- per-axis facts
  have hax : ∀ i : Fin (D + 1), sD6 src D i ≤ tD6 P n D i ∧
      300 * (tD6 P n D i - sD6 src D i) ≤ sD6 src D i := by
    intro i
    have hi : i.val < dP6 P n := by have := i.isLt; omega
    obtain ⟨-, hst, -⟩ := hnat n hn2 src hsrc i.val hi
    obtain ⟨hθ, -⟩ := hfit n hn3 src hsrc i.val hi
    refine ⟨hst.le, le_trans ?_ hθ⟩
    have : 300 ≤ 3 * d ^ 2 := by nlinarith
    exact Nat.mul_le_mul_right _ this
  have hst : ∀ i, sD6 src D i ≤ tD6 P n D i := fun i => (hax i).1
  set Aa : ℕ → (ℕ → ℤ × ℤ) → (ℕ → ℤ × ℤ) := fun i => J6A.chirpC (pP6 P n)
    ((List.ofFn (sD6 src D)).getD i 1) ((List.ofFn (tD6 P n D)).getD i 1) (αN6 P n) H with hAa
  have hAi : ∀ i : Fin (D + 1), Aa i = J6A.chirpC (pP6 P n) (sD6 src D i) (tD6 P n D i) (αN6 P n) H := by
    intro i; simp only [hAa, ofFn_getD]
  have hloc : ∀ i : Fin (D + 1), ∀ U U' : ℕ → ℤ × ℤ, (∀ j < sD6 src D i, U j = U' j) →
      Aa i U = Aa i U' := by
    intro i U U' hU
    rw [hAi]
    exact J6A.chirpA_congr _ _ _ _ _ _ _ U U' (Nat.pos_of_ne_zero (NeZero.ne _)) hU
  have hfp : ∀ i : Fin (D + 1), FPApprox (pP6 P n) (Aa i) (liftL (M.A i)) (12 * m + 11 : ℕ) := by
    intro i
