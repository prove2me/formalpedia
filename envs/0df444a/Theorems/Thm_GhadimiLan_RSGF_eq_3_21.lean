-- name    : GhadimiLan.RSGF.eq_3_21
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-08T14:20:47.290992+00:00
-- url     : https://prove2.me/theorems/f566799b-cc92-4da9-9142-60d15f653b3a
-- title:
--   (3.21), p. 17 — E[‖G_µ(x_k, ζ_k)‖² | ζ_[k−1]] ≤ 2(n+4)[‖∇f(x_k)‖² + σ²] + (µ²/2)L²(n+6)³
-- statement:
--   Assume the standing assumptions of Section 3 with $L > 0$, $\sigma \ge 0$, and the sampling model of the RSGF method. Let $\mu > 0$, let $x_1, x_2, \dots$ be a run of the method, $G_k = G_\mu(x_k,\xi_k,u_k)$, and $G(x_k,\xi_k) = \nabla_x F(x_k,\xi_k)$. Then for every $k \ge 1$ the random variables $\|G_k\|^2$, $\|G(x_k,\xi_k)\|^2$ and $\|\nabla f(x_k)\|^2$ are integrable and, almost surely,
--   $$
--   \begin{aligned}
--   \mathbb E\big[\|G_k\|^2 \,\big|\, \zeta_{[k-1]}\big] &\le 2(n+4)\,\mathbb E\big[\|G(x_k,\xi_k)\|^2 \,\big|\, \zeta_{[k-1]}\big] + \frac{\mu^2}{2}L^2(n+6)^3 \\
--   &\le 2(n+4)\Big[\mathbb E\big[\|\nabla f(x_k)\|^2 \,\big|\, \zeta_{[k-1]}\big] + \sigma^2\Big] + \frac{\mu^2}{2}L^2(n+6)^3 .
--   \end{aligned}
--   $$
--
--   The first inequality is (3.7) applied to $F(\cdot,\xi_k)$; the second uses Assumption A1. Together they bound the last sum of (3.19) in expectation.
--
--   **Formalization Note** The two inequalities are stated as two conjuncts, each with left side $\mathbb E[\|G_k\|^2 \mid \zeta_{[k-1]}]$. Conditioning is with respect to the $\sigma$-algebra generated by $\zeta_1,\dots,\zeta_{k-1}$. The smoothing parameter is `μs`.
-- source:
--   Ghadimi & Lan, arXiv:1309.5549v1, proof of Theorem 3.2, Eq. (3.21), p. 17

import Mathlib
import Definitions.Def_RandomGradFree_Shared_smoothing
import Definitions.Def_GhadimiLan_RSGF_Model
import Definitions.Def_GhadimiLan_RSGF_Method

open MeasureTheory ProbabilityTheory
open scoped InnerProductSpace

namespace GhadimiLan.RSGF

/-- Eq. (3.21), proof of Theorem 3.2 (Ghadimi & Lan, arXiv:1309.5549v1, p. 17). For a run of the
RSGF method under the standing assumptions of §3 and the sampling model, with `μs > 0` (the
paper's `µ`), `G_k = G_µ(x_k, ξ_k, u_k)` and `G(x_k, ξ_k) = ∇_x F(x_k, ξ_k)` (the first-order
oracle of A1), for every `k ≥ 1`: `‖G_k‖²`, `‖G(x_k, ξ_k)‖²` and `‖∇f(x_k)‖²` are integrable and,
almost surely,
`E[‖G_k‖² | ζ_[k−1]] ≤ 2(n+4) E[‖G(x_k, ξ_k)‖² | ζ_[k−1]] + (µ²/2) L² (n+6)³` and
`E[‖G_k‖² | ζ_[k−1]] ≤ 2(n+4)[E[‖∇f(x_k)‖² | ζ_[k−1]] + σ²] + (µ²/2) L² (n+6)³`. -/
theorem eq_3_21 {n : ℕ} {Ω Ξ : Type*} [MeasurableSpace Ω] [MeasurableSpace Ξ]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (P : Measure Ξ) [IsProbabilityMeasure P]
    (F : EuclideanSpace ℝ (Fin n) → Ξ → ℝ) (L σ μs : ℝ) (hL : 0 < L) (hσ : 0 ≤ σ) (hμs : 0 < μs)
    (hF : SZOAssumptions P F L σ) (γ : ℕ → ℝ)
    (ξ : ℕ → Ω → Ξ) (u : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (hs : IsSZOSampling μ P ξ u)
    (x1 : EuclideanSpace ℝ (Fin n)) (x : ℕ → Ω → EuclideanSpace ℝ (Fin n))
    (hx : IsRSGFRun F μs γ x1 ξ u x)
    (k : ℕ) (hk : 1 ≤ k) :
    Integrable (fun ω => ‖szoGrad F μs (x k ω) (ξ k ω) (u k ω)‖ ^ 2) μ ∧
      Integrable (fun ω => ‖gradient (fun y => F y (ξ k ω)) (x k ω)‖ ^ 2) μ ∧
      Integrable (fun ω => ‖gradient (objective P F) (x k ω)‖ ^ 2) μ ∧
      condExp (zetaSigma ξ u (k - 1)) μ
          (fun ω => ‖szoGrad F μs (x k ω) (ξ k ω) (u k ω)‖ ^ 2) ≤ᵐ[μ]
        (fun ω => 2 * ((n : ℝ) + 4) *
            condExp (zetaSigma ξ u (k - 1)) μ
              (fun ω' => ‖gradient (fun y => F y (ξ k ω')) (x k ω')‖ ^ 2) ω
          + μs ^ 2 / 2 * L ^ 2 * ((n : ℝ) + 6) ^ 3) ∧
      condExp (zetaSigma ξ u (k - 1)) μ
          (fun ω => ‖szoGrad F μs (x k ω) (ξ k ω) (u k ω)‖ ^ 2) ≤ᵐ[μ]
        (fun ω => 2 * ((n : ℝ) + 4) *
            (condExp (zetaSigma ξ u (k - 1)) μ
              (fun ω' => ‖gradient (objective P F) (x k ω')‖ ^ 2) ω + σ ^ 2)
          + μs ^ 2 / 2 * L ^ 2 * ((n : ℝ) + 6) ^ 3) := by sorry

end GhadimiLan.RSGF
