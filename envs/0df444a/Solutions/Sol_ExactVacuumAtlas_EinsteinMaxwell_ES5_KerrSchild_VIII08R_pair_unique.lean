  refine ⟨max C 0, le_max_right _ _, fun x hx => ?_⟩
  have := hC x hx
  have hnorm : ‖f x‖ = |f x| := Real.norm_eq_abs _
  rw [hnorm] at this
  exact le_trans this (le_max_left _ _)

/-! ## M2b: full pair uniqueness -/

theorem deriv_vfun_eq_vSource {j Aq : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG) {R : ℝ} (hR : 3 < R) :
    deriv (vfun j q r) R = vSource j q r R := by
  have h := Dell_vfun (j := j) hqc hq hAq hr hR
  unfold Dell at h
  unfold vSource
  have hR0 : R ^ 3 ≠ 0 := by
    have : (0:ℝ) < R := by linarith
    positivity
  rw [eq_div_iff hR0, mul_comm]
  linarith

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08R
