/-
Copyright (c) 2026 Vas and contributors. Released under Apache-2.0.
Design boundary: exact polynomial coefficient coordinates of powers of the
single-section parameter in the actual ordinary coordinate ring.
Named downstream consumer: independence of the three finite-algebra generators.
The canonical x-polynomial module structure is used throughout this file.
-/

noncomputable section
universe u
namespace MazurTransfer.Order13SingleSectionPowerCoordinates
open Polynomial
open MazurTorsion.XOneThirteenAffineCurve
variable (R : Type u) [CommRing R]

def cubic : Polynomial R := X ^ 3 + X ^ 2 + 1

def powerCoordinates : ℕ → Polynomial R × Polynomial R
  | 0 => (1, 0)
  | n + 1 =>
    (cubic R * (powerCoordinates n).1 + sexticPolynomial R * (powerCoordinates n).2,
      (powerCoordinates n).1 + cubic R * (powerCoordinates n).2)

@[simp] theorem powerCoordinates_zero : powerCoordinates R 0 = (1, 0) := rfl
@[simp] theorem powerCoordinates_succ (n : ℕ) :
    powerCoordinates R (n + 1) =
      (cubic R * (powerCoordinates R n).1 + sexticPolynomial R * (powerCoordinates R n).2,
        (powerCoordinates R n).1 + cubic R * (powerCoordinates R n).2) := rfl

theorem of_cubic :
    AdjoinRoot.of (affineEquation R) (cubic R) =
      Order13SingleSectionFiniteMapIdentities.a R := by
  simp [cubic, Order13SingleSectionFiniteMapIdentities.a, xCoordinate]

theorem root_squared :
    yCoordinate R ^ 2 = AdjoinRoot.of (affineEquation R) (sexticPolynomial R) := by
  change AdjoinRoot.mk (affineEquation R) (X ^ 2) =
    AdjoinRoot.mk (affineEquation R) (C (sexticPolynomial R))
  rw [AdjoinRoot.mk_eq_mk]
  exact ⟨1, by simp [affineEquation]⟩

theorem power_expansion (n : ℕ) :
    Order13SingleSectionFiniteMapIdentities.t R ^ n =
      AdjoinRoot.of (affineEquation R) (powerCoordinates R n).1 +
        AdjoinRoot.of (affineEquation R) (powerCoordinates R n).2 * yCoordinate R := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, ih, powerCoordinates_succ]
    simp only [map_add, map_mul]
    rw [of_cubic]
    dsimp [Order13SingleSectionFiniteMapIdentities.t]
    have hy := root_squared R
    linear_combination
      AdjoinRoot.of (affineEquation R) (powerCoordinates R n).2 * hy

variable [Nontrivial R]

def coordinates : CoordinateRing R ≃ₗ[Polynomial R] Polynomial R × Polynomial R :=
  QuadraticCoordinates.coordinates (Polynomial R) (sexticPolynomial R)

theorem power_coordinates (n : ℕ) :
    coordinates R (Order13SingleSectionFiniteMapIdentities.t R ^ n) =
      powerCoordinates R n := by
  rw [power_expansion]
  exact QuadraticCoordinates.coordinates_of_add_of_mul_root
    (Polynomial R) (sexticPolynomial R) _ _

theorem cubic_degree : (cubic R).natDegree = 3 := by
  unfold cubic
  compute_degree!

theorem cubic_monic : (cubic R).Monic := by
  unfold cubic
  monicity!

theorem sextic_degree : (sexticPolynomial R).natDegree = 6 := by
  unfold sexticPolynomial
  compute_degree!

theorem sextic_monic : (sexticPolynomial R).Monic := by
  unfold sexticPolynomial
  monicity!

omit [Nontrivial R] in
private theorem equal_degree_add_profile {P Q : Polynomial R} {d : ℕ} {c : R}
    (hP : P.natDegree = d) (hQ : Q.natDegree = d)
    (hcP : P.leadingCoeff = c) (hcQ : Q.leadingCoeff = c) (hc : c + c ≠ 0) :
    (P + Q).natDegree = d ∧ (P + Q).leadingCoeff = c + c := by
  have hcoeff : (P + Q).coeff d = c + c := by
    rw [coeff_add, ← hP, coeff_natDegree, hP, ← hQ, coeff_natDegree, hcP, hcQ]
  have hd : (P + Q).natDegree = d :=
    natDegree_eq_of_le_of_coeff_ne_zero
      ((natDegree_add_le _ _).trans (by rw [hP, hQ, max_self])) (hcoeff.trans_ne hc)
  exact ⟨hd, by rw [leadingCoeff, hd, hcoeff]⟩

variable [IsDomain R]

omit [Nontrivial R] in
theorem power_coordinates_degree_and_leadingCoeff (h2 : (2 : R) ≠ 0) (n : ℕ) :
    (powerCoordinates R (n + 1)).1.natDegree = 3 * (n + 1) ∧
    (powerCoordinates R (n + 1)).1.leadingCoeff = 2 ^ n ∧
    (powerCoordinates R (n + 1)).2.natDegree = 3 * n ∧
    (powerCoordinates R (n + 1)).2.leadingCoeff = 2 ^ n := by
  induction n with
  | zero => simp [powerCoordinates, cubic_degree, cubic_monic, Monic.leadingCoeff]
  | succ n ih =>
    rcases ih with ⟨hdA, hcA, hdB, hcB⟩
    have hn : (2 : R) ^ n ≠ 0 := pow_ne_zero _ h2
    have hA : (powerCoordinates R (n + 1)).1 ≠ 0 := by
      intro h
      apply hcA.trans_ne hn
      rw [h, leadingCoeff_zero]
    have hB : (powerCoordinates R (n + 1)).2 ≠ 0 := by
      intro h
      apply hcB.trans_ne hn
      rw [h, leadingCoeff_zero]
    have haA : (cubic R * (powerCoordinates R (n + 1)).1).natDegree = 3 * (n + 2) := by
      rw [(cubic_monic R).natDegree_mul' hA, cubic_degree, hdA]
      omega
    have hfB : (sexticPolynomial R * (powerCoordinates R (n + 1)).2).natDegree = 3 * (n + 2) := by
      rw [(sextic_monic R).natDegree_mul' hB, sextic_degree, hdB]
      omega
    have haB : (cubic R * (powerCoordinates R (n + 1)).2).natDegree = 3 * (n + 1) := by
      rw [(cubic_monic R).natDegree_mul' hB, cubic_degree, hdB]
      omega
    have hcaA : (cubic R * (powerCoordinates R (n + 1)).1).leadingCoeff = (2 : R) ^ n := by
      rw [leadingCoeff_mul, (cubic_monic R).leadingCoeff, one_mul, hcA]
    have hcfB : (sexticPolynomial R * (powerCoordinates R (n + 1)).2).leadingCoeff = (2 : R) ^ n := by
      rw [leadingCoeff_mul, (sextic_monic R).leadingCoeff, one_mul, hcB]
    have hcaB : (cubic R * (powerCoordinates R (n + 1)).2).leadingCoeff = (2 : R) ^ n := by
      rw [leadingCoeff_mul, (cubic_monic R).leadingCoeff, one_mul, hcB]
    have hc : (2 : R) ^ n + 2 ^ n = 2 ^ (n + 1) := by rw [pow_succ]; ring
    have hcne : (2 : R) ^ n + 2 ^ n ≠ 0 := hc.trans_ne (pow_ne_zero _ h2)
    have hsA := equal_degree_add_profile R haA hfB hcaA hcfB hcne
    have hsB := equal_degree_add_profile R hdA haB hcA hcaB hcne
    simpa only [powerCoordinates_succ, hc] using
      And.intro hsA.1 (And.intro hsA.2 (And.intro hsB.1 hsB.2))

end MazurTransfer.Order13SingleSectionPowerCoordinates
#print axioms MazurTransfer.Order13SingleSectionPowerCoordinates.power_coordinates
#print axioms MazurTransfer.Order13SingleSectionPowerCoordinates.power_coordinates_degree_and_leadingCoeff

end
end

