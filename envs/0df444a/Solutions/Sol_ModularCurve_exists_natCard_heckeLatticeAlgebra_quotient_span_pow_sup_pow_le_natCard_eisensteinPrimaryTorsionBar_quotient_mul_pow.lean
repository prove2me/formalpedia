theorem solution
    (p : ℕ) [Fact p.Prime] (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (hqp : q ≠ p)
    (Aq : ValuationSubring (AlgebraicClosure ℚ)) (hAq : Aq.LiesOverPrime q) :
    ∃ C : ℕ, ∀ m M₁ : ℕ, ∃ M : ℕ, M₁ ≤ M ∧
      ∀ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
        (∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (q ^ m) = 1 → σ ζ = ζ ^ n σ) →
      ∀ W : AddSubgroup (JZero p),
        W ≤ eisensteinPrimaryTorsionBar p q m →
        MultiplicativeTypeNat (Aq.inertiaSubgroupIn ℚ) n W →
        (∀ σ ∈ Aq.inertiaSubgroupIn ℚ, ∀ x ∈ eisensteinPrimaryTorsionBar p q m,
          σ • (x : JZero p) - x ∈ W) →
        Nat.card (↥(heckeLatticeAlgebra p ∅) ⧸
            (Ideal.span {((q : ℕ) ^ m : ↥(heckeLatticeAlgebra p ∅))} ⊔
              (Ideal.map ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2))
                (eisensteinMaximalIdeal p q)) ^ M)) ≤
          Nat.card (↥(eisensteinPrimaryTorsionBar p q m) ⧸
            W.addSubgroupOf (eisensteinPrimaryTorsionBar p q m)) * q ^ C := by
  classical
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  letI := heckeModuleBar p
  have hqP : q.Prime := Fact.out
  refine ⟨0, fun m M₁ => ?_⟩

  haveI hVfin : Finite ↥(Submodule.torsionBySet HeckeAlg (JZero p)
      (Ideal.span {((q : ℕ) ^ m : HeckeAlg)} : Set HeckeAlg)) :=
    ModularCurve.heckeTorsion_jZero_finite_of_natCast_mem p
      (Ideal.span {((q : ℕ) ^ m : HeckeAlg)}) (q ^ m) (pow_pos hqP.pos m)
      (by rw [Nat.cast_pow]; exact Ideal.mem_span_singleton_self _)
  haveI hRfin : Finite (↥(heckeLatticeAlgebra p ∅) ⧸
      Ideal.span {((q : ℕ) ^ m : ↥(heckeLatticeAlgebra p ∅))}) :=
    finite_quotient_of_natCast_mem _ (q ^ m) (pow_ne_zero m hqP.ne_zero)
      (by rw [Nat.cast_pow]; exact Ideal.mem_span_singleton_self _)
  obtain ⟨M, hM₁, hMJ, hML⟩ := stab_generic (J := JZero p) (eisensteinMaximalIdeal p q)
    ((q : ℕ) ^ m : HeckeAlg) hVfin
    (Ideal.map ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)) (eisensteinMaximalIdeal p q))
    ((q : ℕ) ^ m : ↥(heckeLatticeAlgebra p ∅)) hRfin M₁
  refine ⟨M, hM₁, fun n hn W hWle hWmt hWdisp => ?_⟩

  set 𝔓 : Ideal HeckeAlg := eisensteinMaximalIdeal p q with h𝔓
  set H : Submodule HeckeAlg (JZero p) :=
    heckeTorsion (JZero p) (Ideal.span {((q : ℕ) ^ m : HeckeAlg)} ⊔ 𝔓 ^ M) with hH

  have hHsub : ∀ x : JZero p, x ∈ H → x ∈ eisensteinPrimaryTorsionBar p q m := by
    intro x hx
    rw [hH, mem_heckeTorsion_iff] at hx
    refine ⟨?_, ?_⟩
    · have h1 : (((q : ℕ) ^ m : HeckeAlg)) • x = 0 :=
        hx _ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self _))
      have h2 : (((q ^ m : ℕ) : HeckeAlg)) • x = 0 := by rwa [Nat.cast_pow]
      have h3 : ((q ^ m : ℕ)) • x = 0 := by rwa [Nat.cast_smul_eq_nsmul] at h2
      change ((q : ℤ) ^ m) • x = 0
      calc ((q : ℤ) ^ m) • x = ((q ^ m : ℕ) : ℤ) • x := by norm_cast
        _ = ((q ^ m : ℕ)) • x := natCast_zsmul x (q ^ m)
        _ = 0 := h3
    · refine AddSubgroup.mem_iSup_of_mem M ?_
      change x ∈ Submodule.torsionBySet HeckeAlg (JZero p) (↑(𝔓 ^ M) : Set HeckeAlg)
      rw [Submodule.mem_torsionBySet_iff]
      rintro ⟨a, ha⟩
      exact hx a (Ideal.mem_sup_right ha)

  have hEPsub : ∀ x : JZero p, x ∈ eisensteinPrimaryTorsionBar p q m → x ∈ H := by
    rintro x ⟨hker, hsup⟩
    have hqx : (((q : ℕ) ^ m : HeckeAlg)) • x = 0 := by
      have h0 : ((q : ℤ) ^ m) • x = 0 := hker
      have h3 : ((q ^ m : ℕ)) • x = 0 := by
        rw [← natCast_zsmul]
        push_cast
        exact h0
      have h2 : (((q ^ m : ℕ) : HeckeAlg)) • x = 0 := by
        rw [Nat.cast_smul_eq_nsmul]
        exact h3
      rw [← Nat.cast_pow]
      exact h2

    have hprim : ∃ k : ℕ, x ∈ Submodule.torsionBySet HeckeAlg (JZero p) (↑(𝔓 ^ k) : Set HeckeAlg) := by
