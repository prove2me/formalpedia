-- title:
--   Trees, games $\omega=(T_\omega,\iota_\omega,\gamma_\omega)$, subgames, truncation, the topology of $\Omega$ and $E(i,k,n)$
-- statement:
--   Let $H=\bigcup_{n\in\mathbb N}\mathbb N_+^n$ be the set of finite sequences of positive integers, with empty sequence $\oslash$. A **tree** is a subset of $H$ containing $\oslash$ and all prefixes of its elements. It is **ordered** if for each $h\in T$ there is $\xi(h)\in\mathbb N$ such that, for $j\in\mathbb N_+$, $(h,j)\in T$ if and only if $1\le j\le\xi(h)$.
--
--   A **game** is a triple $\omega=(T_\omega,\iota_\omega,\gamma_\omega)$ with $T_\omega$ an ordered tree and $\iota_\omega$, $\gamma_\omega$ functions on $T_\omega$ with values in $\{\mathrm I,\mathrm{II}\}$ and $[0,\infty)$. The set of games is $\Omega$, and $\xi_\omega(h)$ is the number of children of $h$.
--
--   1. The **subgame** at $h\in T_\omega$ is $\omega(h)=(s^{-1}[T_\omega],\iota_\omega\circ s,\gamma_\omega\circ s)$, where $s(h')=(h,h')$.
--   2. The **truncated game** $\omega_t$ has as tree the nodes of $T_\omega$ of length at most $t$, with $\iota$ and $\gamma$ restricted. Nodes of length $t$ become end nodes and keep their capacities.
--   3. The **topology** of $\Omega$ is generated by the subbase of sets $\{\omega: h\notin T_\omega\}$ and $\{\omega: h\in T_\omega,\ \iota_\omega(h)=i,\ k_0<\gamma_\omega(h)<k_1\}$, with $h\in H$, $i\in\{\mathrm I,\mathrm{II}\}$ and $k_0,k_1$ rational. $\Omega$ carries the Borel $\sigma$-algebra.
--   4. For $(i,k,n)\in S$,
--   $$
--   E(i,k,n)=\{\omega\in\Omega:\iota_\omega(\oslash)=i,\ \gamma_\omega(\oslash)\ge k,\ \xi_\omega(\oslash)=n\}.
--   $$
--
--   This is the space of marked ordered trees on which the random game lives.
--
--   **Formalization Note** Nodes are `List ℕ+`, and $(h,j)$ is `h ++ [j]`. `ι` and `γ` are functions on the subtype `↥T`, so a game is determined by its triple; functions on all of $H$ would give one game many representations that the topology could not separate. `Game.ξ` is chosen from the ordered-tree property and is unique. `Game.child ω ℓ` is $\omega(\ell)$ as a total map: it returns $\omega$ when $(\ell)$ is not a node, a default that no statement depends on. `rootData` is $(\iota(\oslash),\gamma(\oslash),\xi(\oslash))$.
-- source:
--   Flesch, Predtetchinski & Suomala, Random perfect information games, arXiv:2104.10528v1, §2, pp.7–8, (2.3); §4.2, p.14

import Mathlib
import Definitions.Def_RandomPIGame_Primitive

open scoped NNReal

namespace RandomPIGame

noncomputable section

/-- `H = ⋃_{n ∈ ℕ} ℕ₊ⁿ`, the finite sequences of positive natural numbers, including the empty
sequence `⊘ = []`. arXiv:2104.10528v1, §2, p.7.

**Formalization Note.** The sequence `(h, j)` is `h ++ [j]`, and `(h, h')` is `h ++ h'`. -/
abbrev H : Type := List ℕ+

/-- A tree is a subset of `H` containing `⊘` that contains all prefixes of its elements.
arXiv:2104.10528v1, §2, p.7. -/
def IsTree (T : Set H) : Prop :=
  [] ∈ T ∧ ∀ h h' : H, h ++ h' ∈ T → h ∈ T

/-- A tree `T` is ordered if for each `h ∈ T` there is `ξ(h) ∈ ℕ` such that, for `j ∈ ℕ₊`,
`(h, j) ∈ T` if and only if `1 ≤ j ≤ ξ(h)`. arXiv:2104.10528v1, §2, p.7.

**Formalization Note.** `1 ≤ j` is automatic for `j : ℕ+`. -/
def IsOrderedTree (T : Set H) : Prop :=
  IsTree T ∧ ∀ h ∈ T, ∃ n : ℕ, ∀ j : ℕ+, h ++ [j] ∈ T ↔ (j : ℕ) ≤ n

/-- A game `ω = (T_ω, ι_ω, γ_ω)`: an ordered tree with an active player and a capacity at each
node. Only the triple is data. arXiv:2104.10528v1, §2, p.7.

**Formalization Note.** `ι` and `γ` are functions on the subtype `↥T`, as in the paper. Functions on
all of `H` would give one game many representations, which the topology of p.8 could not separate.
Two games with the same `T`, `ι` and `γ` are equal. -/
@[ext]
structure Game : Type where
  /-- The game tree `T_ω`. -/
  T : Set H
  /-- `T_ω` is an ordered tree. -/
  isOrderedTree : IsOrderedTree T
  /-- The active player `ι_ω`. -/
  ι : T → Player
  /-- The capacity `γ_ω`. -/
  γ : T → ℝ≥0

namespace Game

/-- `ξ_ω(h)`, the number of children of the node `h` of `T_ω`. arXiv:2104.10528v1, §2, pp.7–8. -/
def ξ (ω : Game) (h : ω.T) : ℕ :=
  Classical.choose (ω.isOrderedTree.2 h.1 h.2)

/-- For `j ∈ ℕ₊`, `(h, j) ∈ T_ω` if and only if `j ≤ ξ_ω(h)`. -/
theorem snoc_mem_iff (ω : Game) (h : ω.T) (j : ℕ+) : h.1 ++ [j] ∈ ω.T ↔ (j : ℕ) ≤ ω.ξ h :=
  Classical.choose_spec (ω.isOrderedTree.2 h.1 h.2) j

/-- The root `⊘` of `T_ω`. -/
def root (ω : Game) : ω.T :=
  ⟨[], ω.isOrderedTree.1.1⟩

/-- The subgame `ω(h) = (s⁻¹[T_ω], ι_ω ∘ s, γ_ω ∘ s)` of `ω` starting at the node `h`, where
`s(h') = (h, h')`. arXiv:2104.10528v1, §2, p.8. -/
def subgame (ω : Game) (h : H) (hh : h ∈ ω.T) : Game where
  T := {h' | h ++ h' ∈ ω.T}
  isOrderedTree := by
    refine ⟨⟨by simpa using hh, fun a b hab => ?_⟩, fun a ha => ?_⟩
    · exact ω.isOrderedTree.1.2 (h ++ a) b (by simpa [List.append_assoc] using hab)
    · obtain ⟨n, hn⟩ := ω.isOrderedTree.2 (h ++ a) ha
      exact ⟨n, fun j => by simpa [List.append_assoc] using hn j⟩
  ι a := ω.ι ⟨h ++ a.1, a.2⟩
  γ a := ω.γ ⟨h ++ a.1, a.2⟩

open Classical in
/-- The subgame `ω(ℓ)` at the child `(ℓ)` of the root, as a total map on `Ω`.
arXiv:2104.10528v1, §2, p.8.

**Formalization Note.** The paper defines `ω(ℓ)` on `{ξ_ω(⊘) ≥ ℓ}` only. Off that set this map
returns `ω` itself, a default that plays no role: every statement using `child` restricts to
`E(i, k, n)` with `ℓ ≤ n`, or assumes `ℓ ≤ ξ_ω(⊘)`, or conditions on `E(i, k, n)`. -/
def child (ω : Game) (ℓ : ℕ+) : Game :=
  if hℓ : [ℓ] ∈ ω.T then ω.subgame [ℓ] hℓ else ω

/-- The truncated game `ω_t`: its tree is the set of nodes of `T_ω` of length at most `t`, and its
active player and capacity are restrictions. Nodes of length exactly `t` become end nodes and keep
their capacities. arXiv:2104.10528v1, §4.2, p.14. -/
def trunc (ω : Game) (t : ℕ) : Game where
  T := {h | h ∈ ω.T ∧ h.length ≤ t}
  isOrderedTree := by
    refine ⟨⟨⟨ω.isOrderedTree.1.1, by simp⟩, fun a b hab => ?_⟩, fun a ha => ?_⟩
    · refine ⟨ω.isOrderedTree.1.2 a b hab.1, ?_⟩
      have := hab.2
      simp only [List.length_append] at this
      omega
    · by_cases hlt : a.length < t
      · obtain ⟨n, hn⟩ := ω.isOrderedTree.2 a ha.1
        refine ⟨n, fun j => ?_⟩
        rw [← hn j]
        constructor
        · exact fun hj => hj.1
        · exact fun hj => ⟨hj, by simp only [List.length_append, List.length_singleton]; omega⟩
      · refine ⟨0, fun j => ?_⟩
        constructor
        · intro hj
          have := hj.2
          simp only [List.length_append, List.length_singleton] at this
          omega
        · intro hj
          exact absurd hj (by simp)
  ι a := ω.ι ⟨a.1, a.2.1⟩
  γ a := ω.γ ⟨a.1, a.2.1⟩

end Game

/-- The subbase of the topology on `Ω`: the sets `{ω : h ∉ T_ω}` and
`{ω : h ∈ T_ω, ι_ω(h) = i, k₀ < γ_ω(h) < k₁}`, for `h ∈ H`, `i ∈ {I, II}` and rational `k₀, k₁`.
arXiv:2104.10528v1, §2, p.8. -/
def gameSubbase : Set (Set Game) :=
  {U | ∃ h : H, U = {ω | h ∉ ω.T}} ∪
    {U | ∃ (h : H) (i : Player) (k₀ k₁ : ℚ),
      U = {ω | ∃ hh : h ∈ ω.T, ω.ι ⟨h, hh⟩ = i ∧
        (k₀ : ℝ) < (ω.γ ⟨h, hh⟩ : ℝ) ∧ (ω.γ ⟨h, hh⟩ : ℝ) < (k₁ : ℝ)}}

/-- The topology on the set `Ω` of games generated by `gameSubbase`. arXiv:2104.10528v1, §2, p.8. -/
instance : TopologicalSpace Game := TopologicalSpace.generateFrom gameSubbase

/-- The Borel σ-algebra of `Ω`. arXiv:2104.10528v1, §2, p.8. -/
instance : MeasurableSpace Game := borel Game

instance : BorelSpace Game := ⟨rfl⟩

/-- `E(i, k, n) = {ω : ι_ω(⊘) = i, γ_ω(⊘) ≥ k, ξ_ω(⊘) = n}`. arXiv:2104.10528v1, §2, p.8, (2.3). -/
def E (i : Player) (k : ℝ≥0) (n : ℕ) : Set Game :=
  {ω | ω.ι ω.root = i ∧ k ≤ ω.γ ω.root ∧ ω.ξ ω.root = n}

/-- The root data `(ι(⊘), γ(⊘), ξ(⊘)) : Ω → S`. arXiv:2104.10528v1, §2, p.8. -/
def rootData (ω : Game) : S :=
  (ω.ι ω.root, ω.γ ω.root, ω.ξ ω.root)

end

end RandomPIGame


