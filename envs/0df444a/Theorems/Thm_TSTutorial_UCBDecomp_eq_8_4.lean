-- title:
--   (8.4), p. 72 — Thompson sampling and the optimum have equal expected history-based scores
-- statement:
--   Let $\pi$ be Thompson sampling, using the same measurable optimal-action selector $x^*$ as the Bayesian model. At period $t$, let $U_t(x)$ be any real-valued function determined by the preceding history $H_{t-1}$ and the action $x$. Then
--
--   $$
--   \mathbb E_\pi[U_t(x_t)]
--     =\mathbb E_\pi[U_t(x^*)].
--   $$
--
--   Both expectations use the same joint law of the parameter and the actions and outcomes generated by Thompson sampling. The identity lets a history-based score evaluated at the played action be replaced in expectation by the same score evaluated at the optimal action.
--
--   **Formalization Note** The score has type $H_{t-1}\to\mathcal X\to\mathbb R$ and cannot inspect $\theta$. Lean period $s$ is the paper's $t=s+1$. The two expectations are both represented over histories through period $t$.
-- source:
--   Russo, Van Roy, Kazerouni, Osband, Wen, A Tutorial on Thompson Sampling, Found. Trends Mach. Learn. 11(1) (2018), §8.1.2 p. 72, (8.4)

import Mathlib
import Definitions.Def_TSTutorial_UCBDecomp_Setting

open MeasureTheory
open scoped BigOperators

namespace TSTutorial.UCBDecomp

variable {X Y Θ : Type*} [Fintype X] [DecidableEq X] [Nonempty X]
  [Fintype Y] [DecidableEq Y] [MeasurableSpace Θ]

/-- Equation (8.4): history-determined scores have equal expectations at TS's action and x*. -/
theorem eq_8_4 (m : Model X Y Θ) (xStar : Θ → X)
    (hx : IsOptimalSelector m xStar) (π : Policy X Y)
    (hπ : IsThompsonSampling m xStar π) (s : ℕ)
    (U : Hist X Y s → X → ℝ) :
    (∫ θ, ∑ h : Hist X Y (s + 1), lik m π (s + 1) θ h *
      U (init h) (h (Fin.last s)).1 ∂m.prior) =
    (∫ θ, ∑ h : Hist X Y (s + 1), lik m π (s + 1) θ h *
      U (init h) (xStar θ) ∂m.prior) := by sorry

end TSTutorial.UCBDecomp
