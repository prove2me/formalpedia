private theorem t0490 (N : ℕ) (l : ℤ) (s : ℂ) :
    (N : ℂ) ^ ((l : ℂ) * s) = ((((N : ℝ) ^ l : ℝ)) : ℂ) ^ s := by
  have hlog : (Complex.log (N : ℂ) * (l : ℂ)).im = 0 := by
    rw [← Complex.ofReal_natCast, ← Complex.ofReal_log (Nat.cast_nonneg N), ← Complex.ofReal_intCast,
      ← Complex.ofReal_mul, Complex.ofReal_im]
  have h1 : -Real.pi < (Complex.log (N : ℂ) * (l : ℂ)).im := by
    rw [hlog]
    exact neg_lt_zero.2 Real.pi_pos
  have h2 : (Complex.log (N : ℂ) * (l : ℂ)).im ≤ Real.pi := by
    rw [hlog]
    exact Real.pi_pos.le
  rw [Complex.cpow_mul s h1 h2, Complex.cpow_intCast, Complex.ofReal_zpow, Complex.ofReal_natCast]

