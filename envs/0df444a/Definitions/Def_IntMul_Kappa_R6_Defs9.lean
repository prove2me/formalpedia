-- Source module: Solutions.R6ChkPack
/-!
# Packed bit-vector kernels for reflective certificate checking (round six)

Kernel-friendly primitives on `ℕ` (every operation is a single GMP-accelerated kernel step:
`Nat.land`, `Nat.xor`, `Nat.mul`, `Nat.shiftLeft`, `Nat.shiftRight`, ...), with their bit-level
specifications.

* `row X i`: the `i`-th 32-bit field of `X` (a list of `F₂` vectors packed with stride 32).
* `pkf s f k = Σ_{i<k} f i · 2^{s i}`, `testBit_pkf`: bits of packed sums.
* `fold32`: five xor-shifts; bit `p` of `fold32 x` is the parity of bits `p, …, p+31` of `x`.
* `dotsP A B`: **all 24 × 24 inner products over `F₂` in 16 big-number operations**: for
  `A, B < 2^768` (at most 24 rows each), bit `800 j + 32 i` of `dotsP A B` is the parity of
  `row A j &&& row B i` (`dotsP_spec`).
* `tgt o k`: the target pattern with ones exactly at `(j, o + j)`, `j < k` (`testBit_tgt`).

Definitions use the `Nat.*` functions directly (not the `HAnd`/`HMul` notation) because kernel
reduction through the notation instances is about four times slower.
-/

namespace R6Chk

/-! ## Notation bridges (all `rfl`) -/

/-! ## Packed sums -/

/-- `pkf s f k = Σ_{i<k} f i · 2^{s i}`. -/
def pkf (s : ℕ) (f : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | k + 1 => pkf s f k + 2 ^ (s * k) * f k

/-! ## Rows -/

/-- The `i`-th 32-bit field of `X`. -/
def row (X i : ℕ) : ℕ := (X >>> (32 * i)) % 2 ^ 32

/-! ## Parity and the xor-shift fold -/

/-- `parB f k = f 0 xor ⋯ xor f (k-1)`. -/
def parB (f : ℕ → Bool) : ℕ → Bool
  | 0 => false
  | k + 1 => xor (parB f k) (f k)

/-- One xor-shift. -/
def xs (x k : ℕ) : ℕ := Nat.xor x (Nat.shiftRight x k)

/-- Five xor-shifts: windowed parity over 32 bits. -/
def fold32 (x : ℕ) : ℕ := xs (xs (xs (xs (xs x 1) 2) 4) 8) 16

/-! ## All inner products of two 24-row lists -/

/-- `Σ_{j<24} 2^{768 j}`. -/
def R1 : ℕ := pkf 768 (fun _ => 1) 24
/-- `Σ_{j<24} (2^32 - 1) 2^{800 j}`. -/
def M1 : ℕ := pkf 800 (fun _ => 2 ^ 32 - 1) 24
/-- `Σ_{i<25} 2^{32 i}`. -/
def R2 : ℕ := pkf 32 (fun _ => 1) 25
/-- `Σ_{j<24} 2^{800 j}`. -/
def R3 : ℕ := pkf 800 (fun _ => 1) 24
/-- Ones at `800 j + 32 i`, `i, j < 24`. -/
def LOW : ℕ := pkf 800 (fun _ => pkf 32 (fun _ => 1) 24) 24

/-- **All inner products**: bit `800 j + 32 i` is `⟨row A j, row B i⟩` over `F₂`. The constants
are passed as arguments so that the kernel sees literals (see `dotsP_eq`). -/
def dotsK (r1 m1 r2 r3 low A B : ℕ) : ℕ :=
  Nat.land (fold32 (Nat.land (Nat.mul (Nat.land (Nat.mul A r1) m1) r2) (Nat.mul B r3))) low

/-- The specification form. -/
def dotsP (A B : ℕ) : ℕ := dotsK R1 M1 R2 R3 LOW A B

/-! ## Target patterns -/

/-- `2^{832} - 1`. -/
def C832 : ℕ := 2 ^ 832 - 1

/-- Ones at `800 j + 32 (o + j)` for `j < k`. -/
def tgt (o k : ℕ) : ℕ :=
  Nat.shiftLeft (Nat.div (Nat.sub (Nat.shiftLeft 1 (Nat.mul 832 k)) 1) C832) (Nat.mul 32 o)

/-! ## Range check: fields below `2^n` -/

/-- Ones at bits `n … 31` of each of 48 fields. -/
def BADf (n : ℕ) : ℕ := pkf 32 (fun _ => (2 ^ (32 - n) - 1) * 2 ^ n) 48

end R6Chk

end

