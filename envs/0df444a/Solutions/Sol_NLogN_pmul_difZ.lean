variable (n : ℕ)

theorem peval_cycZ (K : ℕ) (A B : List ℤ) (x : (ZMod (2 ^ n + 1))) (hx : x ^ K = 1) :
    peval n (cycZ (2 ^ n + 1) K A B) x K = peval n A x K * peval n B x K := by
  have hK : ∀ a, x ^ a = x ^ (a % K) := by
    intro a
    conv_lhs => rw [← Nat.div_add_mod a K, pow_add, pow_mul, hx, one_pow, one_mul]
  unfold peval
  rw [Finset.sum_mul_sum]
  have e1 : ∀ m ∈ Finset.range K, (((cycZ (2 ^ n + 1) K A B).getD m 0 : ℤ) : (ZMod (2 ^ n + 1))) * x ^ m =
      ∑ i ∈ Finset.range K, ∑ l ∈ Finset.range K,
        if (i + l) % K = m then (A.getD i 0 : (ZMod (2 ^ n + 1))) * (B.getD l 0 : (ZMod (2 ^ n + 1))) * x ^ ((i + l) % K) else 0 := by
    intro m hm
    have hm' : m < K := Finset.mem_range.mp hm
    simp only [cycZ, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hm',
      Option.map_some, Option.getD_some]
    rw [cast_emod]
    push_cast
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl fun l _ => ?_
    split_ifs with h
    · rw [h]
    · simp
  rw [Finset.sum_congr rfl e1, Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [Finset.sum_ite_eq]
  have : (i + l) % K ∈ Finset.range K := by
    rcases Nat.eq_zero_or_pos K with h0 | h0
    · subst h0
      simp only [Finset.range_zero] at *
      simp_all
    · exact Finset.mem_range.mpr (Nat.mod_lt _ h0)
  rw [if_pos this, ← hK, pow_add]
  ring

