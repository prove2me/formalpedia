    (hwdρ : ModularCurve.TwoChart.ιFin A (↥K) j ≫ wd.hom = Spec.map (CommRingCat.ofHom ρd.toRingHom) ≫ ModularCurve.TwoChart.ιFin A (↥K) j)
    (hdM : (d : ZMod M) = 1) (hdp : (d : ZMod p) = (b : ZMod p))

