      exact ⟨⟨trivial, trivial⟩, zb R (by omega), zb T (by omega), by exact_mod_cast zb (R + T) (by omega)⟩)
    simpa [NLogN.CR.lsz, NLogN.Ex.size] using this
  have c2 := NLogN.sortP_cost 3 kb t1 (NLogN.CR.mergeL v κ R T) Rest (NLogN.CR.mergeL_width v κ R T) (by norm_num)
    (t.G 1) L2 (by simp [ht1, h0]) (by simp [ht1, NLogN.CR.mergeL_length]) (by simp [ht1, h2]) B hrec
    (by rw [NLogN.CR.mergeL_length]; exact zb _ (by omega)) hkbB (zb 3 (by omega))
  rw [NLogN.CR.mergeL_length] at c2
  have c3a : (NLogN.RS.push NLogN.CR.hCa (.lit 0)).cost t2 ≤ 2 * 3000 * (B + 2) := by
    have := NLogN.CR.cost_le_linB B (NLogN.RS.push NLogN.CR.hCa (.lit 0)) t2 (by simp [NLogN.CR.LinB, NLogN.Ex.Lin, NLogN.Ex.Bnd, NLogN.zsz_zero])
    simpa [NLogN.CR.lsz, NLogN.Ex.size] using this
  have c3b : (NLogN.RS.push NLogN.CR.hCb (.lit 0)).cost t3a ≤ 2 * 3000 * (B + 2) := by
    have := NLogN.CR.cost_le_linB B (NLogN.RS.push NLogN.CR.hCb (.lit 0)) t3a (by simp [NLogN.CR.LinB, NLogN.Ex.Lin, NLogN.Ex.Bnd, NLogN.zsz_zero])
