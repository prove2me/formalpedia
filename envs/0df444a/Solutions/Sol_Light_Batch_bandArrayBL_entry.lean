theorem subsetIndex_lt (p : Par) {g h : ℕ} (hg : g < p.K0) (hh : h < p.K0) :
    g * p.K0 + h < p.KK ∧ g * p.K0 + h < p.L.choose p.m :=
  ⟨Nat.mul_add_lt_mul hg hh, Spec.tableIndex_lt p.L p.m (⟨g, hg⟩, ⟨h, hh⟩)⟩

