theorem slots3 {m : ℕ} (hm : 3 ≤ m) {i j : Fin m} (hij : i ≠ j) :
    ∃ (σ : Fin 3 → Fin m) (px py : Fin 3), (σ 0 < σ 1 ∧ σ 1 < σ 2) ∧ σ px = i ∧ σ py = j ∧
      px ≠ py := by
  have hv : i.val ≠ j.val := Fin.val_ne_of_ne hij
  obtain ⟨h, hi', hj'⟩ : ∃ h : Fin m, h.val ≠ i.val ∧ h.val ≠ j.val := by
    by_cases a : 0 ≠ i.val ∧ 0 ≠ j.val
    · exact ⟨⟨0, by omega⟩, a⟩
    by_cases b : 1 ≠ i.val ∧ 1 ≠ j.val
    · exact ⟨⟨1, by omega⟩, b⟩
    exact ⟨⟨2, by omega⟩, by simp only; omega, by simp only; omega⟩
  have hS : ({i, j, h} : Finset (Fin m)).card = 3 :=
    Finset.card_eq_three.2 ⟨i, j, h, hij, fun e => hi' (by rw [e]), fun e => hj' (by rw [e]), rfl⟩
  set σ := Finset.orderEmbOfFin _ hS
  have hr := Finset.range_orderEmbOfFin _ hS
  have mi : i ∈ Set.range σ := by rw [hr]; simp
  have mj : j ∈ Set.range σ := by rw [hr]; simp
  obtain ⟨px, hpx⟩ := mi
  obtain ⟨py, hpy⟩ := mj
  refine ⟨σ, px, py, ⟨σ.strictMono (by decide), σ.strictMono (by decide)⟩, hpx, hpy, ?_⟩
  rintro rfl; exact hij (hpx.symm.trans hpy)

end NLogN.KFR

end

