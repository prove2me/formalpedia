-- title:
--   Fifth-order Gaussian derivative majorant for cubic–quintic correlations
-- statement:
--   For the fixed cubic–quintic scheme, the fifth Euler derivative expands into terms indexed by the number of covariance and spatial differentiations. Each term consists of an explicit rational polynomial in the complex parameter and a nonnegative polynomial in the Gaussian standard deviation $\sigma=(1-(\operatorname{Re}\rho)^2)^{-1/2}$. The polynomial coefficients collect upper bounds for the absolute Gaussian moments of the derivatives of the cubic threshold. The function $M$ is their sum after taking the complex polynomial norms.
-- source:
--   Degree-251 fixed-point Hermite certificate for the cubic–quintic scheme of Saha et al., arXiv:2608.11158v2, and Prove2Me fc28e7f8-2588-498a-8ea6-e8d0e220ae2b.

import Mathlib.Analysis.SpecialFunctions.Complex.CircleMap
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Arctan

namespace GrothendieckLB.Supplement.CQPrice

/-- A rational polynomial stored with a common positive denominator. -/
structure RationalPoly where
  denominator : ℕ
  terms : List (ℕ × ℤ)
  deriving Inhabited

noncomputable def eval (p : RationalPoly) (z : ℂ) : ℂ :=
  ((p.terms.map (fun t => (t.2:ℂ)*z^t.1)).sum) / (p.denominator:ℂ)

/-- Coefficients of the covariance polynomial of the fixed cubic–quintic scheme. -/
def rho : RationalPoly := ⟨11190724005347697, [(1, 10000000000000000), (3, -1162886658063376), (5, 27837347284321)]⟩

/-- One term in the fifth Euler derivative after applying the Gaussian covariance identity.
The last field collects the nonnegative Gaussian moment bounds by degree in sigma. -/
structure Term where
  parameterOrder : ℕ
  spatialOrder : ℕ
  polynomial : RationalPoly
  moments : List (ℕ × ℕ)
  deriving Inhabited

