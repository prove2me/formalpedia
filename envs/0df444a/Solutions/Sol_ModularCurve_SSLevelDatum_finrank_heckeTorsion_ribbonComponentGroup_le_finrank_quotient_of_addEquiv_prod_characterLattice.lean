theorem degeneracyMatrix_mulVec_comp_perm {E V : Type} [Fintype E] [DecidableEq V]
    (a b : E → V) (π : E → E) (ha : ∀ e, a (π e) = b e) (hinv : ∀ e, π (π e) = e) (y : E → ℤ) :
    (degeneracyMatrix a).mulVec (y ∘ π) = (degeneracyMatrix b).mulVec y := by
  have hb : Function.Bijective π := Function.Involutive.bijective hinv
  funext v
  simp only [Matrix.mulVec, dotProduct, degeneracyMatrix, Matrix.of_apply, Function.comp]
  rw [← (Equiv.ofBijective π hb).sum_comp (fun e => (if b e = v then (1 : ℤ) else 0) * y e)]
  refine Finset.sum_congr rfl fun e _ => ?_
  have hbe : b (π e) = a e := by rw [← ha, hinv]
  simp only [Equiv.ofBijective_apply, hbe]

theorem padj_comp_perm_of_hadj {E V : Type} [Fintype E] [Fintype V] [DecidableEq E] [DecidableEq V]
    (a b : E → V) (w : E → ℕ+) (wV : V → ℤ) (π : E → E)
    (ha : ∀ e, a (π e) = b e) (hinv : ∀ e, π (π e) = e) (hw : ∀ e, w (π e) = w e)
    (p0 p1 : (V → ℤ) →ₗ[ℤ] (E → ℤ))
    (h0 : ∀ (x : V → ℤ) (y : E → ℤ), (∑ v, wV v * (degeneracyMatrix a).mulVec y v * x v) = ∑ e, (w e : ℤ) * y e * p0 x e)
    (h1 : ∀ (x : V → ℤ) (y : E → ℤ), (∑ v, wV v * (degeneracyMatrix b).mulVec y v * x v) = ∑ e, (w e : ℤ) * y e * p1 x e)
    (x : V → ℤ) (e : E) : p1 x e = p0 x (π e) := by
  suffices h : p1 x = p0 x ∘ π from congrFun h e
  apply EngineDatum.adjoint_unique (fun e => (w e : ℕ)) (fun e => (w e).pos)
  intro y
  rw [widthPairing_apply, widthPairing_apply]
  have hb : Function.Bijective π := Function.Involutive.bijective hinv
  have e1 : ∑ e, (((w e : ℕ) : ℕ) : ℤ) * (y e * p1 x e) = ∑ v, wV v * (degeneracyMatrix b).mulVec y v * x v := by
    rw [h1]
    exact Finset.sum_congr rfl fun e _ => by push_cast; ring
  have e2 : ∑ e, (((w e : ℕ) : ℕ) : ℤ) * (y e * (p0 x ∘ π) e) = ∑ v, wV v * (degeneracyMatrix a).mulVec (y ∘ π) v * x v := by
    rw [h0]
    rw [← (Equiv.ofBijective π hb).sum_comp (fun e => ((w e : ℕ) : ℤ) * (y ∘ π) e * p0 x e)]
    refine Finset.sum_congr rfl fun e _ => ?_
    simp only [Equiv.ofBijective_apply, Function.comp, hw, hinv]
    push_cast
    ring
  rw [e1, e2, degeneracyMatrix_mulVec_comp_perm a b π ha hinv]

